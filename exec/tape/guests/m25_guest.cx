/* Pure zero-syscall tape guest for m25.o (cx/compiler/rtsharedname.cx).
 * Zero unisa-use imports (host mask <= 383). ABI tag in DATA: "M25M1BIN1".
 * Binary argument block at argv[1]: [data_ptr, length].
 * Request format:
 *   data[0] = op:
 *     0: rts_count() -> 2
 *     1: rts_at(i) -> 0 if i in {0,1} else 2
 *     2: rts_symbol_count(i) -> 14 (i=0), 12 (i=1), 255 (else -> -1)
 *     3: rts_covers(i, name) -> data[1]=(signed char)i, data[2]=has_name, data[3..len-1]=name -> 4/2/1/0
 *     4: rts_used_name(i, m) -> data[1]=(signed char)i, data[2]=(signed char)m -> 1..4 or 0 (NULL)
 *     5: rts_used_count(i) -> 2 if i in {0,1} else 255 (else -> -1)
 *     6: rts_used(i, name) -> data[1]=(signed char)i, data[2]=has_name, data[3..len-1]=name -> 4/2/1/0
 * Return domain: [0, 255]. */
static int m25_eq(const unsigned char *s, long sl, const char *lit) {
    long k = 0;
    while (k < sl && lit[k]) {
        if ((char)s[k] != lit[k]) return 0;
        k = k + 1;
    }
    return k == sl && lit[k] == 0;
}

int main(int argc, char **argv) {
    const char *abi = "M25M1BIN1";
    const unsigned long long *ba;
    const unsigned char *data;
    long length;
    int op, idx, sub;
    if (abi[0] != 'M' || argc < 2) return 254;
    ba = (const unsigned long long *)argv[1];
    data = (const unsigned char *)ba[0];
    length = (long)ba[1];
    if (!data || length < 3) return 254;
    op = (int)data[0];
    idx = (int)(signed char)data[1];
    sub = (int)(signed char)data[2];
    if (op == 0) return 2;
    if (op == 1) return (idx == 0 || idx == 1) ? 0 : 2;
    if (op == 2) {
        if (idx == 0) return 14;
        if (idx == 1) return 12;
        return 255;
    }
    if (op == 3) {
        const unsigned char *nm = data + 3;
        long nl = length - 3;
        if (sub == 0) return 4;
        if (idx == 0) {
            if (m25_eq(nm, nl, "_unisa_atexit")) return 1;
            if (m25_eq(nm, nl, "_unisa_natexit")) return 1;
            if (m25_eq(nm, nl, "_u_st_fd")) return 1;
            if (m25_eq(nm, nl, "_u_st_eof")) return 1;
            if (m25_eq(nm, nl, "_u_st_err")) return 1;
            if (m25_eq(nm, nl, "_u_st_serr")) return 1;
            if (m25_eq(nm, nl, "_u_st_ung")) return 1;
            if (m25_eq(nm, nl, "_u_st_buf")) return 1;
            if (m25_eq(nm, nl, "_u_st_bpos")) return 1;
            if (m25_eq(nm, nl, "_u_st_blen")) return 1;
            if (m25_eq(nm, nl, "_u_st_wlen")) return 1;
            if (m25_eq(nm, nl, "_u_st_ro")) return 1;
            if (m25_eq(nm, nl, "_u_st_n")) return 1;
            if (m25_eq(nm, nl, "errno")) return 1;
            return 0;
        }
        if (idx == 1) {
            if (m25_eq(nm, nl, "_unisa_envheap")) return 1;
            if (m25_eq(nm, nl, "_unisa_envcap")) return 1;
            if (m25_eq(nm, nl, "_unisa_seed")) return 1;
            if (m25_eq(nm, nl, "_unisa_tok")) return 1;
            if (m25_eq(nm, nl, "_unisa_asc")) return 1;
            if (m25_eq(nm, nl, "_unisa_tmbuf")) return 1;
            if (m25_eq(nm, nl, "_unisa_tz")) return 1;
            if (m25_eq(nm, nl, "_unisa_tzn")) return 1;
            if (m25_eq(nm, nl, "_unisa_tzstate")) return 1;
            if (m25_eq(nm, nl, "_u_po_fd")) return 1;
            if (m25_eq(nm, nl, "_u_po_pid")) return 1;
            if (m25_eq(nm, nl, "_u_po_n")) return 1;
            return 0;
        }
        return 2;
    }
    if (op == 4) {
        if ((idx == 0 || idx == 1) && (sub == 0 || sub == 1)) return idx * 2 + sub + 1;
        return 0;
    }
    if (op == 5) {
        if (idx == 0 || idx == 1) return 2;
        return 255;
    }
    if (op == 6) {
        const unsigned char *nm = data + 3;
        long nl = length - 3;
        if (sub == 0) return 4;
        if (idx == 0) {
            if (m25_eq(nm, nl, "_u_st_wput")) return 1;
            if (m25_eq(nm, nl, "_u_st_copy")) return 1;
            return 0;
        }
        if (idx == 1) {
            if (m25_eq(nm, nl, "_unisa_envfind")) return 1;
            if (m25_eq(nm, nl, "_unisa_map")) return 1;
            return 0;
        }
        return 2;
    }
    return 254;
}
