#include <cx.h>
#include <stdint.h>
/* Narrow E3 promoted-scalar model witness. No ABI/runtime/P1-P6/V0-V7 claim.  Reference = the frozen expected rc
   and USLCSF1 frame fields of exec/parse2/librarycallsite-cases.tsv, which equalled the Python seed reader reference
   at HEAD e3c4b123 (W1-F); no interpreter runs here. */
static uint64_t word(const unsigned char*p){uint64_t n=0;for(int i=0;i<8;i++)n|=(uint64_t)p[i]<<(8*i);return n;}
static int puthex(const char*p,const char*h){if(!strcmp(h,"-"))return cx_write(p,"",0);size_t n=strlen(h);if(n%2)return 1;unsigned char*b=malloc(n/2+1);if(!b)return 2;for(size_t i=0;i<n;i+=2){unsigned v;if(sscanf(h+i,"%2x",&v)!=1)return 1;b[i/2]=v;}int rc=cx_write(p,b,n/2);free(b);return rc;}
static int same(const char*a,const char*b){size_t n,m;char*x=cx_read(a,&n),*y=cx_read(b,&m);int ok=x&&y&&n==m&&!memcmp(x,y,n);free(x);free(y);return ok;}
int main(int argc,char**argv){if(argc!=2)return 2;size_t n;char*l=cx_read("exec/parse2/librarycallsite-cases.tsv",&n);if(!l)return 2;const char*names[]={"input","contract","selection","attributes","mode","expected","out","err","ref","referr","full","source.c","side"};char path[13][4096],cmd[24000];for(int i=0;i<13;i++)snprintf(path[i],4096,"%s/%s",argv[1],names[i]);int count=0;
 for(char*p=l;*p;){char*e=strchr(p,'\n');if(!e)return 2;*e=0;if(*p!='#'){
  char*f[11];f[0]=p;int k=1;for(char*q=p;*q;q++)if(*q=='\t'){*q=0;if(k==11)return 2;f[k++]=q+1;}if(k!=11)return 2;for(int i=0;i<5;i++)if(puthex(path[i],f[i+1]))return 2;if(puthex(path[5],f[7])||puthex(path[10],f[10])||puthex(path[11],f[9]))return 2;int want=atoi(f[6]);
  if(strcmp(f[6],"0")&&strcmp(f[6],"1"))return 2;size_t en;
  for(int format=0;format<2;format++)for(int provider=0;provider<2;provider++){
   snprintf(cmd,sizeof cmd,"'%s/runner' '%s/model.%s' '%s' '%s' '%s' '%s' '%s' %s >'%s' 2>'%s'",argv[1],argv[1],format?"net":"tbl",path[0],path[1],path[2],path[3],path[4],provider?"B":"A",path[6],path[7]);int rc=cx_run_timeout(cmd,3,0,0);size_t on;unsigned char*out=(unsigned char*)cx_read(path[6],&on);char*err=cx_read(path[7],&en);if(!out||!err)return 2;if(rc!=0&&rc!=1){printf("MECHANISM %s rc%d\n",f[0],rc);return rc==124||rc==142?142:2;}if(rc!=want||(rc&&(on||!strstr(err,f[8])))){printf("CONTRACT_RED %s rc%d %s\n",f[0],rc,err);return 1;}
   if(!rc){if(on<24||memcmp(out,"USCSFLW1",8))return 1;uint64_t cn=word(out+8),sn=word(out+16);if(cn>on-24||sn!=on-24-cn||sn<16||memcmp(out+24+cn,"USLCSF1\n",8))return 1;if(cx_write(path[12],out+24+cn,(size_t)sn)||!same(path[12],path[5])||!same(path[6],path[10])){printf("CONTRACT_RED %s frame/core/provider bytes\n",f[0]);return 1;}}
   free(out);free(err);
  }count++;
 }p=e+1;}free(l);printf("librarycallsite-E3: %d fixtures, tbl/net x providers; promoted-scalar frames/frozen reference exact; named refusal; model only\n",count);return count?0:1;}
