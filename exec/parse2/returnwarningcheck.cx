    {"flags", "int f(void){printf(\"%+-#08.4ld\",1);return 0;}"},
    {"stars", "int f(void){printf(\"%*.*ld\",3,2,1);return 0;}"},
    {"percent", "int f(void){printf(\"%% %ld\",1);return 0;}"},
    {"few", "int f(void){printf(\"%ld %s\",1);return 0;}"},
    {"extra", "int f(void){printf(\"plain\",1);return 0;}"},
    {"trailing", "int f(void){printf(\"%000.\",1);return 0;}"},
    {"unknown", "int f(void){printf(\"%q %ld\",1,1);return 0;}"},
    {"nonliteral", "int f(char *s){printf(s,1);return 0;}"},
    {"call-exempt", "int g(void){return 1;}int f(void){printf(\"%s\",g());return 0;}"},
    {"nested", "int f(void){printf(\"%d\",printf(\"%ld\",1));return 0;}"},
    {"conditional", "int f(int k){printf(\"%ld\",k?1:2);return 0;}"},
    {"conditional-marker", "int f(int k){printf(\"%d\",k>1?k*2:k+1);printf(\"marker\");return 0;}"},
    {"nested-format-order", "int f(void){printf(\"%ld %d\",1,printf(\"%ld\",2));return 0;}"},
    {"struct-temp", "struct S{int x;};struct S g(void){struct S s={3};return s;}int use(struct S s){return s.x;}int f(void){printf(\"%d\",use(g()));return 0;}"},
    {"fnvalue", "int g(void){return 1;}int f(void){printf(\"%s %d\",g,g);return 0;}"},
    {"fnptr", "int f(int (*p)(void)){printf(\"%d\",p);return 0;}"},
    {"struct", "struct S{int x;};int f(void){struct S s;s.x=1;printf(\"%d\",s);return 0;}"},
    {"adjacent", "int f(void){printf(\"%\" \"ld\",1);return 0;}"},
    {"escaped", "int f(void){printf(\"\\x25ld\",1);return 0;}"},
    {"two-calls", "int f(void){printf(\"%ld\",1);printf(\"%s\",3);return 0;}"},
    {"all-four", "int f(void){int unused;int *p=7;printf(\"%ld\",1);}"},
    {"star-assignment", "int f(int *p){printf(\"%*ld\",p=7,1);return p!=0;}"},
    {"many-conversions", "int f(void){printf(\"%i %x %X %o %c\",1L,1L,1L,1L,1L);return 0;}"},
    {"real-conversions", "int f(void){printf(\"%e %g %E %G %F\",1,1,1,1,1);return 0;}"},
    {"header-format", "#include \"quiet.h\"\nint f(void){printf(\"%ld\",1);return 0;}"},
    {"vararg-float", 0},                                  /* exec/parse2/probes/vararg_float.c */
    {0, 0}
};

/* int(str) for an ASCII spelling: surrounding whitespace, one sign, digits with single '_' between digits */
static int pyint(const char *s, const char *e, long long *v) {
    int neg = 0, digits = 0; long long x = 0;
    while (s < e && strchr(" \t\n\r\v\f\x1c\x1d\x1e\x1f", *s) && *s) s++;
    while (e > s && strchr(" \t\n\r\v\f\x1c\x1d\x1e\x1f", e[-1]) && e[-1]) e--;
    if (s < e && (*s == '+' || *s == '-')) { neg = *s == '-'; s++; }
    if (s >= e) return 0;
    for (; s < e; s++) {
        if (*s == '_') { if (!digits || s + 1 >= e || s[1] < '0' || s[1] > '9') return 0; continue; }
        if (*s < '0' || *s > '9') return 0;
        if (x < 100000000000LL) x = x * 10 + (*s - '0');   /* large values only need to stay large */
        digits = 1;
    }
    *v = neg ? -x : x; return 1;
}

static char *PY_SETUP =
    "import sys,pathlib\n"
    "R=pathlib.Path(sys.argv[1]);sys.path[0:1]=[str(R/'tests'),str(R/'exec/c'),str(R/'exec/parse2')]\n"
    "t=pathlib.Path(sys.argv[2]);specs=[('pp',['pp','--locations']),('lex',['lex','--locations']),"
    "('parse',['parse2','--warnings']),('plain',['parse2','--locations'])]\n"
    "if sys.argv[3]=='cached':\n"
    " from warnprep import cached_inputs\n"
    " runner,reference=cached_inputs(t,specs,pathlib.Path(sys.argv[5]) if sys.argv[4]=='1' else None,'return warnings')\n"
    " (t/'.tools').write_text(str(runner)+'\\0'+str(reference))\n"
    "else:\n"
    " from compilerpack import built_model\n"
    " for name,flags in specs:built_model(t,name,R/'exec/build/gen.py',flags)\n";

int main(int argc, char **argv) {
    char here[PATHN], *slash, *runner, *reference, *f, *quiet;
    const char *category = "return-type", *shard = "all", *qtext = "static int in_header(void){}\n", *tmp;
    const Case *cases = RETURN_CASES; int i, total = 0, part = 0, parts = 1, positives = 0, count = 0, has_shard = -1;
    int lit_int = 0, lit_unused = 0, lit_format = 0;

    parse_args(argc, argv);
    for (i = 1; i < argc; i++) {
        if (!strcmp(argv[i], "--int-conversion")) lit_int = 1;
        if (!strcmp(argv[i], "--unused")) lit_unused = 1;
        if (!strcmp(argv[i], "--format")) lit_format = 1;
        if (has_shard < 0 && !strcmp(argv[i], "--shard")) has_shard = i;
    }

    /* R = Path(__file__).resolve().parents[2] */
    snprintf(here, sizeof here, "%s", __FILE__);
    slash = strrchr(here, '/');
    if (slash) *slash = 0; else snprintf(here, sizeof here, ".");
    { char t[PATHN]; snprintf(t, sizeof t, "%s/../..", here); if (!realpath(t, ROOT)) fail("FileNotFoundError", "cannot resolve the repository root", t); }

    /* tempfile.TemporaryDirectory(prefix='return-warnings-') */
    tmp = getenv("TMPDIR");
    if (!tmp || !*tmp || access(tmp, W_OK)) tmp = getenv("TEMP");
    if (!tmp || !*tmp || access(tmp, W_OK)) tmp = getenv("TMP");
    if (!tmp || !*tmp || access(tmp, W_OK)) tmp = "/tmp";
    snprintf(TD, sizeof TD, "%s/return-warnings-XXXXXX", tmp);
    if (!mkdtemp(TD)) { TD[0] = 0; fail("FileNotFoundError", "No usable temporary directory found", 0); }
    signal(SIGINT, SIG_DFL);

    if (REQUIRE_CACHED) {
        char *av[8]; size_t n; char *p, *tools;
        av[0] = "python3"; av[1] = "-c"; av[2] = PY_SETUP; av[3] = ROOT; av[4] = TD; av[5] = "cached";
        av[6] = HAVE_TOOLS ? "1" : "0"; av[7] = 0;
        { char *bv[9]; memcpy(bv, av, sizeof av); bv[7] = HAVE_TOOLS ? (char *)TOOLS : (char *)""; bv[8] = 0;
          int rc = spawn(bv); if (rc) quit(rc); }
        p = path2(TD, ".tools"); tools = cx_read(p, &n);
        if (!tools) fail("FileNotFoundError", "model helper wrote no tool paths", p);
        unlink(p); free(p);
        runner = tools; reference = tools + strlen(tools) + 1;
        if ((size_t)(reference - tools) > n) fail("ValueError", "bad tool paths", 0);
    } else {
        /* refsource.source_text(R): tests/export_ref.sh FLAT (check=True, timeout 30, captured) */
        char *sub = path2(TD, "refsource"), *flat, *sh, *a, *b, *c, *src, *refc, *cc;
        size_t an, bn, cn;
        if (mkdir(sub, 0700)) fail("OSError", "cannot create", sub);
        flat = path2(sub, "ref.c"); sh = path2(ROOT, "tests/export_ref.sh");
        { char *av[] = { sh, flat, 0 }; Res r = run(av);
          if (r.rc) { char m[PATHN * 2]; snprintf(m, sizeof m, "Command '['%s', '%s']' returned non-zero exit status %d.", sh, flat, r.rc);
                      fail("subprocess.CalledProcessError", m, 0); }
          res_free(&r); }
        a = read_text(path2(ROOT, "tests/refshim.h"), &an); b = read_text(flat, &bn); c = read_text(path2(ROOT, "tests/reffoot.h"), &cn);
        src = xmalloc(an + bn + cn + 1); memcpy(src, a, an); memcpy(src + an, b, bn); memcpy(src + an + bn, c, cn);
        rmtree(sub);
        refc = path2(TD, "ref.c"); write_bytes(refc, src, an + bn + cn);
        reference = path2(TD, "ref"); runner = path2(TD, "run");
        { char *av[] = { "cc", "-w", "-O1", "-I", path2(ROOT, "kernel"), "-I", path2(ROOT, "src"), refc, "-o", reference, 0 };
          Res r = call(av); res_free(&r); }
        cc = getenv("EXEC_CC"); if (!cc) cc = "cc";
        { char *av[] = { cc, "-O2", path2(ROOT, "exec/c/run.c"), "-o", runner, 0 }; Res r = call(av); res_free(&r); }
        { char *av[] = { "python3", "-c", PY_SETUP, ROOT, TD, "build", "0", "", 0 }; int rc = spawn(av); if (rc) quit(rc); }
    }

    if (lit_int) { category = "int-conversion"; cases = INT_CASES; qtext = "static int in_header(int *p){p=7;return p!=0;}\n"; }
    if (lit_unused) { category = "unused-variable"; cases = UNUSED_CASES; qtext = "static int in_header(void){int hidden;return 0;}\n"; }
    if (lit_format) { category = "format"; cases = FORMAT_CASES; qtext = "static int header_format(void){printf(\"%ld\",1);return 0;}\n"; }
    quiet = path2(TD, "quiet.h"); write_bytes(quiet, qtext, strlen(qtext));
    while (cases[total].name) total++;

    if (has_shard >= 0) {
        const char *sl; long long p0, p1;
        if (has_shard + 1 >= argc) goto bad;
        shard = argv[has_shard + 1];
        sl = strchr(shard, '/');
        if (!sl || strchr(sl + 1, '/')) goto bad;
        if (!pyint(shard, sl, &p0) || !pyint(sl + 1, sl + strlen(sl), &p1)) goto bad;
        if (!(0 <= p0 && p0 < p1 && p1 <= total)) goto bad;
        part = (int)p0; parts = (int)p1;
        goto good;
      bad:
        fflush(stdout); fputs("bad --shard: use index/count, zero based\n", stderr); quit(1);
      good:;
    }

    f = path2(TD, "source.c");
    {
        char *pp = path2(TD, "pp"), *tokens = path2(TD, "tokens"), *truth = path2(TD, "truth");
        char *ppnet = path2(TD, "pp.net"), *lexnet = path2(TD, "lex.net"), *parsenet = path2(TD, "parse.net"),
             *plainnet = path2(TD, "plain.net"), *inc = path2(ROOT, "include");
        char needle[64]; snprintf(needle, sizeof needle, "[-W%s]", category);
        for (i = part; i < total; i += parts) {
            const char *name = cases[i].name; int probe = !cases[i].body;
            count++;
            if (probe) {
                size_t n; char *b = read_text(path2(ROOT, !strcmp(name, "float-truth") ? "exec/parse2/probes/float_truth.c"
                                                                                       : "exec/parse2/probes/vararg_float.c"), &n);
                const char *expected = !strcmp(name, "float-truth") ? "" : "1.5 2.5\n";
                write_bytes(f, b, n); free(b);
                { char *av[] = { "cc", "-O0", f, "-o", truth, 0 }; Res r = call(av); res_free(&r); }
                { char *av[] = { truth, 0 }; Res r = call(av);
                  if (!same(r.out, r.on, expected, strlen(expected))) fail("AssertionError", "", 0); res_free(&r); }
                { char *av[] = { reference, f, "-run", 0 }; Res r = call(av);
                  if (!same(r.out, r.on, expected, strlen(expected))) fail("AssertionError", "", 0); res_free(&r); }
            } else {
                const char *tail = "\nint main(void){return 0;}\n";
                size_t bl = strlen(cases[i].body), tl = strlen(tail); char *b = xmalloc(bl + tl);
                memcpy(b, cases[i].body, bl); memcpy(b + bl, tail, tl); write_bytes(f, b, bl + tl); free(b);
            }
            {
                Res ref, ppr, tok, got, base, q;
                char m[4096];
                { char *av[] = { reference, f, "-Wall", "-S", "-o", "-", 0 }; ref = run(av); }
                if (ref.rc) { snprintf(m, sizeof m, "('%s', b'%.*s')", name, (int)(ref.en > 2000 ? 2000 : ref.en), ref.err); fail("AssertionError", m, 0); }
                { char *av[] = { runner, ppnet, f, f, inc, 0 }; ppr = call(av); write_bytes(pp, ppr.out, ppr.on); }
                { char *av[] = { runner, lexnet, pp, 0 }; tok = call(av); write_bytes(tokens, tok.out, tok.on); }
                { char *av[] = { runner, parsenet, tokens, f, 0 }; got = run(av); }
                if (got.rc) { snprintf(m, sizeof m, "('%s', b'%.*s')", name, (int)(got.en > 2000 ? 2000 : got.en), got.err); fail("AssertionError", m, 0); }
                { char *av[] = { runner, plainnet, tokens, f, 0 }; base = run(av); }
                { char *av[] = { reference, f, "-S", "-o", "-", 0 }; q = run(av); }
                if (q.rc) { snprintf(m, sizeof m, "('%s', b'%.*s')", name, (int)(q.en > 2000 ? 2000 : q.en), q.err); fail("AssertionError", m, 0); }
                if (!(base.rc == 0 && same(base.out, base.on, q.out, q.on) && base.en == 0)) {
                    snprintf(m, sizeof m, "('%s', 'quiet tape')", name); fail("AssertionError", m, 0); }
                if (!same(got.out, got.on, ref.out, ref.on)) { snprintf(m, sizeof m, "('%s', 'warning tape')", name); fail("AssertionError", m, 0); }
                if (!same(ref.out, ref.on, q.out, q.on)) { snprintf(m, sizeof m, "('%s', '-Wall changed tape')", name); fail("AssertionError", m, 0); }
                if (!same(got.err, got.en, ref.err, ref.en)) {
                    snprintf(m, sizeof m, "('%s', b'%.*s', b'%.*s')", name, (int)(ref.en > 1500 ? 1500 : ref.en), ref.err,
                             (int)(got.en > 1500 ? 1500 : got.en), got.err);
                    fail("AssertionError", m, 0);
                }
                if (contains(ref.err, ref.en, needle)) positives++;
                printf("%s warning %s tape and diagnostics match\n", category, name); fflush(stdout);
                res_free(&ref); res_free(&ppr); res_free(&tok); res_free(&got); res_free(&base); res_free(&q);
            }
        }
    }
    if (!positives) fail("AssertionError", "", 0);
    printf("%s warning: %d cases; %d with warnings; shard %s of %d cases; single-unit rule check\n", category, count, positives, shard, total);
    quit(0);
    return 0;
}
