# UJS: regenerable via `python3 -m ujs web-build`
# Binaries ship on GitHub Release; BUILD.json (fingerprint) may be committed.
ujs/core/*.wasm
!ujs/core/compiler.wasm
!ujs/core/compiler_rt_stub.wasm
!ujs/core/compiler_core.wasm
!ujs/core/compiler_core.meta.json
ujs/core/*.wat
ujs/core/compiler.gen.js
ujs/core/demos.json
ujs/core/full_demos.json
ujs/core/manifest.json
ujs/core/progs/
ujs/web/demos.json
ujs/web/manifest.json
ujs/web/full_demos.json
ujs/web/progs/

# UJS game: vendored Three.js (fetch on demand; see web/game/README.md)
ujs/web/game/three.module.js

