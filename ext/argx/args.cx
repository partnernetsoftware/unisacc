/* argx.args: option-table argv parsing for tools (prefix ax_).
 *
 * A tool describes its command line once as an ax_opt table (rows end with name 0).  A row whose
 * name starts with '-' is an option; any other row is a positional, taken in table order (the
 * last positional row may carry AX_MULTI to take the rest).  One ax_parse call gives typed
 * results; usage and --help text come from the same table (ax_usage), never written by hand.
 *
 * Contract (from the parsing fixes in recent history, now fixed behaviour):
 *  - options and positionals may come in any order; "--opt=value" equals "--opt value";
 *  - everything after a bare "--" is positional and is not parsed;
 *  - an unknown option is refused and named, with the nearest table names suggested;
 *  - every missing required option or positional is named, each with its expected form;
 *  - an integer outside lo..hi is refused with the range; an enum value outside its choices
 *    is refused with the list; a non-repeatable option given twice is refused;
 *  - "--help" (or "-h") makes ax_parse return AX_HELP; ax_main then prints ax_usage on stdout, rc 0.
 *  Refusals return -EINVAL and every reason is kept for ax_why ("; " separated).
 *
 * Ownership: a parse lives in a module-private slot table (AX_SLOTS) addressed by the handle;
 * strings returned by ax_str/ax_multi/ax_rest are the caller's argv entries (or the text after
 * '=' inside one), borrowed, never copied.  ax_close frees the slot.  This is a runtime handle
 * check (a stale or foreign handle is refused), not compile-time ownership.
 * Only L0 sy_ and tx_ interfaces are used: no libc call, no platform #if. */
#pragma unisa module args
#pragma unisa use sys.fs
#pragma unisa use sys.sig
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use text.num

enum { AX_FLAG = 0, AX_STR = 1, AX_INT = 2, AX_ENUM = 3 };
enum { AX_REQ = 1, AX_MULTI = 2 };
enum { AX_HELP = 1 };
enum { AX_SLOTS = 8, AX_MAXV = 256, AX_MAXOPT = 64, AX_WHY = 2048 };

typedef struct {
    const char *name;     /* "--tag" for an option, "ROOT" for a positional; 0 ends the table */
    const char *alias;    /* 0 or a second spelling such as "-t" */
    int kind;             /* AX_FLAG, AX_STR, AX_INT, AX_ENUM (positionals: AX_STR, AX_INT or AX_ENUM) */
    int flags;            /* AX_REQ | AX_MULTI */
    const char *meta;     /* value placeholder in usage, e.g. "FILE"; 0 uses the kind's default */
    const char *help;     /* one line */
    long lo, hi;          /* AX_INT range, inclusive; lo > hi means unbounded */
    const char *choices;  /* AX_ENUM: "a|b|c" */
} ax_opt;

typedef struct {
    int used;
    int gen;
    const ax_opt *spec;
    int nopt;
    int count[AX_MAXOPT];
    int nv;
    int vopt[AX_MAXV];
    const char *vval[AX_MAXV];
    int npos;
    const char *pos[AX_MAXV];
    char why[AX_WHY];
    int whyn;
} ax_state;

static ax_state ax_slot[AX_SLOTS];
static int ax_gen;

static int ax_isopt(const ax_opt *o) { return o->name && o->name[0] == '-'; }
static long ax_n(const char *s) { long n = tx_len(s, 4096); return n < 0 ? 0 : n; }

static ax_state *ax_get(int h) {
    int i = (h & 0xff) - 1;
    if (i < 0 || i >= AX_SLOTS || !ax_slot[i].used || ax_slot[i].gen != (h >> 8)) return 0;
    return &ax_slot[i];
}

static void ax_say(ax_state *s, const char *fmt, const char *a, const char *b, const char *c) {
    int n;
    if (s->whyn > 0 && s->whyn + 3 < AX_WHY) { s->why[s->whyn++] = ';'; s->why[s->whyn++] = ' '; s->why[s->whyn] = 0; }
    n = tx_fmt(s->why + s->whyn, (unsigned long)(AX_WHY - s->whyn), fmt, a ? a : "", b ? b : "", c ? c : "");
    if (n > 0) s->whyn += n; else s->whyn = (int)ax_n(s->why);
}

static const char *ax_meta(const ax_opt *o) {
    if (o->meta) return o->meta;
    if (o->kind == AX_INT) return "N";
    if (o->kind == AX_ENUM) return o->choices ? o->choices : "V";
    return ax_isopt(o) ? "VALUE" : o->name;
}

/* index of option row spelled N[0..NL) (name or alias), or -1 */
static int ax_find(const ax_opt *spec, const char *n, long nl) {
    int i;
    for (i = 0; spec[i].name; i++) {
        if (!ax_isopt(&spec[i])) continue;
        if (tx_same(spec[i].name, ax_n(spec[i].name), n, nl)) return i;
        if (spec[i].alias && tx_same(spec[i].alias, ax_n(spec[i].alias), n, nl)) return i;
    }
    return -1;
}

/* edit distance of two short spans, capped at 3 ("far") */
static int ax_dist(const char *a, long an, const char *b, long bn) {
    int d[40], p[40], i, j;
    if (an > 38 || bn > 38) return 3;
    for (j = 0; j <= bn; j++) p[j] = j;
    for (i = 1; i <= an; i++) {
        d[0] = i;
        for (j = 1; j <= bn; j++) {
            int c = p[j - 1] + (a[i - 1] != b[j - 1]), x = p[j] + 1, y = d[j - 1] + 1;
            if (x < c) c = x;
            if (y < c) c = y;
            d[j] = c;
        }
        for (j = 0; j <= bn; j++) p[j] = d[j];
    }
    return p[bn] > 3 ? 3 : p[bn];
}

static void ax_unknown(ax_state *s, const char *arg, long nl) {
    char near[512], name[256];
    int i, k = 0, nn = 0;
    near[0] = 0;
    for (i = 0; s->spec[i].name; i++) {
        const char *m = s->spec[i].name;
        long ml = ax_n(m);
        if (!ax_isopt(&s->spec[i])) continue;
        if (ax_dist(arg, nl, m, ml) <= 2 || (nl >= 4 && (tx_prefix(m, ml, arg, nl) || tx_prefix(arg, nl, m, ml)))) {
            int w = tx_fmt(near + k, sizeof near - (unsigned long)k, "%s%s", nn ? ", " : "", m);
            if (w > 0) { k += w; nn++; }
        }
    }
    tx_copy(name, sizeof name, arg, nl < 255 ? nl : 255);
    if (nn) ax_say(s, "unknown option %s (did you mean %s?)", name, near, 0);
    else ax_say(s, "unknown option %s", name, 0, 0);
}

/* check VAL against row O; 0, or -1 with the reason recorded */
static int ax_value(ax_state *s, const ax_opt *o, const char *val) {
    if (o->kind == AX_INT) {
        long v; char *e = 0; char r[64];
        if (tx_strtol_r(val, &e, 10, &v) || !e || *e) { ax_say(s, "%s %s is not an integer", o->name, val, 0); return -1; }
        if (o->lo <= o->hi && (v < o->lo || v > o->hi)) {
            tx_fmt(r, sizeof r, "%ld..%ld", o->lo, o->hi);
            ax_say(s, "%s %s out of range %s", o->name, val, r);
            return -1;
        }
    } else if (o->kind == AX_ENUM && o->choices) {
        const char *c = o->choices;
        long vl = ax_n(val);
        while (*c) {
            long n = 0;
            while (c[n] && c[n] != '|') n++;
            if (tx_same(c, n, val, vl)) return 0;
            c += n;
            if (*c) c++;
        }
        ax_say(s, "%s %s not one of %s", o->name, val, o->choices);
        return -1;
    }
    return 0;
}

static void ax_store(ax_state *s, int oi, const char *val) {
    if (s->nv < AX_MAXV) { s->vopt[s->nv] = oi; s->vval[s->nv] = val; s->nv++; }
    else ax_say(s, "too many values (limit %s)", "256", 0, 0);
}

/* Parse ARGV[1..ARGC) against SPEC into a new handle *H.  0, AX_HELP, -EINVAL (see ax_why;
 * the handle is valid in these three cases and goes back with ax_close), -ENOSPC (no free
 * slot), -EFAULT (null arguments or more than AX_MAXOPT rows). */
int ax_parse(int *h, const ax_opt *spec, int argc, char **argv) {
    ax_state *s = 0;
    int i, k, slot = -1, help = 0, dashdash = 0;
    if (!h || !spec || argc < 0 || (argc > 0 && !argv)) return -EFAULT;
    *h = 0;
    for (i = 0; i < AX_SLOTS; i++) if (!ax_slot[i].used) { s = &ax_slot[i]; slot = i; break; }
    if (!s) return -ENOSPC;
    for (k = 0; spec[k].name; k++) if (k >= AX_MAXOPT) return -EFAULT;
    s->used = 1;
    ax_gen = (ax_gen + 1) & 0x7fffff;
    s->gen = ax_gen;
    s->spec = spec;
    s->nopt = k;
    s->nv = 0; s->npos = 0; s->whyn = 0; s->why[0] = 0;
    for (k = 0; k < s->nopt; k++) s->count[k] = 0;
    *h = (slot + 1) | (s->gen << 8);
    for (i = 1; i < argc; i++) {
        const char *a = argv[i];
        const char *val = 0;
        long al, nl;
        int oi;
        if (!a) continue;
        if (dashdash || a[0] != '-' || a[1] == 0) {
            if (s->npos < AX_MAXV) s->pos[s->npos++] = a;
            else ax_say(s, "too many arguments (limit %s)", "256", 0, 0);
            continue;
        }
        if (tx_eqz(a, "--")) { dashdash = 1; continue; }
        if (tx_eqz(a, "--help") || tx_eqz(a, "-h")) { help = 1; continue; }
        al = ax_n(a);
        nl = al;
        if (a[1] == '-') for (k = 2; k < al; k++) if (a[k] == '=') { nl = k; val = a + k + 1; break; }
        oi = ax_find(spec, a, nl);
        if (oi < 0) { ax_unknown(s, a, nl); continue; }
        if (s->count[oi] > 0 && !(spec[oi].flags & AX_MULTI)) ax_say(s, "duplicate %s (not repeatable)", spec[oi].name, 0, 0);
        s->count[oi]++;
        if (spec[oi].kind == AX_FLAG) {
            if (val) ax_say(s, "%s takes no value", spec[oi].name, 0, 0);
            continue;
        }
        if (!val) {
            if (i + 1 >= argc || !argv[i + 1]) {
                ax_say(s, "missing value for %s (expected %s %s)", spec[oi].name, spec[oi].name, ax_meta(&spec[oi]));
                continue;
            }
            val = argv[++i];
        }
        if (ax_value(s, &spec[oi], val) == 0) ax_store(s, oi, val);
    }
    {   /* positionals, in table order */
        int p = 0, r;
        for (r = 0; spec[r].name; r++) {
            int take;
            if (ax_isopt(&spec[r]) || p >= s->npos) continue;
            take = (spec[r].flags & AX_MULTI) ? s->npos - p : 1;
            for (k = 0; k < take; k++, p++) {
                s->count[r]++;
                if (ax_value(s, &spec[r], s->pos[p]) == 0) ax_store(s, r, s->pos[p]);
            }
        }
        if (p < s->npos) ax_say(s, "unexpected argument %s", s->pos[p], 0, 0);
    }
    for (k = 0; spec[k].name; k++) {
        if (!(spec[k].flags & AX_REQ) || s->count[k]) continue;
        if (!ax_isopt(&spec[k])) ax_say(s, "missing required argument %s", ax_meta(&spec[k]), 0, 0);
        else if (spec[k].kind == AX_FLAG) ax_say(s, "missing required %s", spec[k].name, 0, 0);
        else ax_say(s, "missing required %s (expected %s %s)", spec[k].name, spec[k].name, ax_meta(&spec[k]));
    }
    if (help) return AX_HELP;
    return s->whyn ? -EINVAL : 0;
}

static int ax_idx(ax_state *s, const char *name) {
    int k;
    long nl = ax_n(name);
    for (k = 0; k < s->nopt; k++) {
        if (tx_same(s->spec[k].name, ax_n(s->spec[k].name), name, nl)) return k;
        if (s->spec[k].alias && tx_same(s->spec[k].alias, ax_n(s->spec[k].alias), name, nl)) return k;
    }
    return -1;
}

/* times row NAME (option, alias or positional) was given; 0 for an unknown handle or name */
int ax_flag(int h, const char *name) {
    ax_state *s = ax_get(h);
    int k;
    if (!s || !name || (k = ax_idx(s, name)) < 0) return 0;
    return s->count[k];
}

/* I-th stored value of row NAME into *V: 0, -ENOENT (fewer values), -EINVAL (no such row), -EBADF */
int ax_multi(int h, const char *name, int i, const char **v) {
    ax_state *s = ax_get(h);
    int k, j, n = 0;
    if (v) *v = 0;
    if (!s) return -EBADF;
    if (!name || !v || (k = ax_idx(s, name)) < 0) return -EINVAL;
    for (j = 0; j < s->nv; j++) {
        if (s->vopt[j] != k) continue;
        if (n == i) { *v = s->vval[j]; return 0; }
        n++;
    }
    return -ENOENT;
}

/* first value of row NAME, or 0 */
const char *ax_str(int h, const char *name) {
    const char *v = 0;
    ax_multi(h, name, 0, &v);
    return v;
}

/* first value of row NAME as an integer (already range-checked by ax_parse), or DFLT when absent */
long ax_int(int h, const char *name, long dflt) {
    const char *v = ax_str(h, name);
    long x;
    char *e = 0;
    if (!v || tx_strtol_r(v, &e, 10, &x)) return dflt;
    return x;
}

/* every positional in argv order (including all after "--"), borrowed; count, or -EBADF */
int ax_rest(int h, const char ***v) {
    ax_state *s = ax_get(h);
    if (!s) return -EBADF;
    if (v) *v = s->pos;
    return s->npos;
}

/* the reasons recorded by ax_parse ("" when none, "bad handle" for an unknown handle) */
const char *ax_why(int h) {
    ax_state *s = ax_get(h);
    return s ? s->why : "bad handle";
}

int ax_close(int h) {
    ax_state *s = ax_get(h);
    if (!s) return -EBADF;
    s->used = 0;
    return 0;
}

static void ax_put(char *dst, long cap, long *at, int *bad, const char *a, const char *b) {
    int n;
    if (*at >= cap - 1) { *bad = 1; return; }
    n = tx_fmt(dst + *at, (unsigned long)(cap - *at), "%s%s", a ? a : "", b ? b : "");
    if (n < 0) { *bad = 1; *at = ax_n(dst); return; }
    *at += n;
}

static void ax_note(char *x, int *e, const char *a, const char *b) {
    int n = tx_fmt(x + *e, (unsigned long)(256 - *e), "%s%s%s", *e ? "; " : "", a, b ? b : "");
    if (n > 0) *e += n;
}

/* Usage text for TOOL from SPEC into DST: a synopsis line, then one line per row, then --help.
 * Bytes written, -EMSGSIZE (DST holds a truncated prefix) or -EFAULT. */
int ax_usage(const ax_opt *spec, const char *tool, char *dst, long cap) {
    long at = 0;
    int k, bad = 0;
    if (!spec || !tool || !dst || cap <= 0) return -EFAULT;
    dst[0] = 0;
    ax_put(dst, cap, &at, &bad, "usage: ", tool);
    for (k = 0; spec[k].name; k++) {
        const ax_opt *o = &spec[k];
        ax_put(dst, cap, &at, &bad, (o->flags & AX_REQ) ? " " : " [", ax_isopt(o) ? o->name : ax_meta(o));
        if (ax_isopt(o) && o->kind != AX_FLAG) ax_put(dst, cap, &at, &bad, " ", ax_meta(o));
        ax_put(dst, cap, &at, &bad, (o->flags & AX_MULTI) ? "..." : "", (o->flags & AX_REQ) ? "" : "]");
    }
    ax_put(dst, cap, &at, &bad, "\n", 0);
    for (k = 0; spec[k].name; k++) {
        const ax_opt *o = &spec[k];
        char left[160], x[256], r[64];
        int e = 0;
        long ll;
        x[0] = 0;
        if (ax_isopt(o) && o->kind != AX_FLAG) tx_fmt(left, sizeof left, "%s %s", o->name, ax_meta(o));
        else tx_fmt(left, sizeof left, "%s", ax_isopt(o) ? o->name : ax_meta(o));
        if (o->flags & AX_REQ) ax_note(x, &e, "required", 0);
        if (o->kind == AX_INT && o->lo <= o->hi) { tx_fmt(r, sizeof r, "%ld..%ld", o->lo, o->hi); ax_note(x, &e, r, 0); }
        if (o->kind == AX_ENUM && o->choices) ax_note(x, &e, "one of ", o->choices);
        if (o->flags & AX_MULTI) ax_note(x, &e, "repeatable", 0);
        if (o->alias) ax_note(x, &e, "alias ", o->alias);
        ax_put(dst, cap, &at, &bad, "  ", left);
        for (ll = ax_n(left); ll < 24; ll++) ax_put(dst, cap, &at, &bad, " ", 0);
        ax_put(dst, cap, &at, &bad, " ", o->help ? o->help : "");
        if (e) { ax_put(dst, cap, &at, &bad, " (", x); ax_put(dst, cap, &at, &bad, ")", 0); }
        ax_put(dst, cap, &at, &bad, "\n", 0);
    }
    ax_put(dst, cap, &at, &bad, "  --help                   print this text\n", 0);
    return bad ? -EMSGSIZE : (int)at;
}

static void ax_out(int fd, const char *s) { sy_write_all(fd, s, ax_n(s)); }

/* Print "TOOL: MSG" (printf-style) and a newline on stderr, then exit RC. */
void ax_die(const char *tool, int rc, const char *fmt, ...) {
    char b[2048];
    va_list ap;
    int n;
    n = tx_fmt(b, sizeof b, "%s: ", tool ? tool : "tool");
    if (n < 0) n = 0;
    va_start(ap, fmt);
    tx_vfmt(b + n, sizeof b - (unsigned long)n - 2, fmt ? fmt : "", ap);
    va_end(ap);
    n = (int)tx_len(b, sizeof b);
    if (n < 0) n = (int)sizeof b - 2;
    b[n++] = '\n';
    b[n] = 0;
    ax_out(2, b);
    sy_exit(rc);
}

/* The usual tool entry: parse; on --help print the usage on stdout and exit 0; on a refusal
 * print "TOOL: REASONS" then the usage on stderr and exit 2.  Otherwise return the handle. */
int ax_main(const char *tool, const ax_opt *spec, int argc, char **argv) {
    int h = 0, rc = ax_parse(&h, spec, argc, argv);
    char u[8192];
    if (rc == -ENOSPC || rc == -EFAULT) ax_die(tool, 2, "argument table refused (%d)", rc);
    if (ax_usage(spec, tool, u, sizeof u) < 0) u[0] = 0;
    if (rc == AX_HELP) { ax_out(1, u); sy_exit(0); }
    if (rc < 0) {
        char b[AX_WHY + 300];
        tx_fmt(b, sizeof b, "%s: %s\n", tool, ax_why(h));
        ax_out(2, b);
        ax_out(2, u);
        sy_exit(2);
    }
    return h;
}
