#pragma unisa module ct
/* crypto/ct -- constant-time helpers for MAC and tag comparison and for wiping key material.

     cs_ct_eq(a, b, n)     1 when both buffers hold the same N bytes, 0 otherwise.  The loop reads every
                           byte of both buffers and never stops early, so the run time depends only on n.
     cs_ct_wipe(p, n)      overwrite N bytes with zero through a volatile pointer so the store is not
                           dropped when the caller never reads the buffer again.

   mm_same is not a substitute for cs_ct_eq: it returns as soon as it finds a difference, which leaks the
   position of the first mismatching byte to anyone who can time the call.  Comparing a MAC, a tag or a
   finished message uses this module, never mm_same.  No libc call, no allocation. */

int cs_ct_eq(const void *a, const void *b, long n) {
    const unsigned char *x = (const unsigned char *)a;
    const unsigned char *y = (const unsigned char *)b;
    unsigned char acc = 0;
    long i;
    if (n < 0) return 0;
    if (n == 0) return 1;                         /* two empty strings are equal */
    if (!x || !y) return 0;
    for (i = 0; i < n; i++) acc |= (unsigned char)(x[i] ^ y[i]);
    return acc == 0;                              /* a single accumulator: no branch per byte */
}

void cs_ct_wipe(void *p, long n) {
    volatile unsigned char *v = (volatile unsigned char *)p;
    long i;
    if (!v || n < 0) return;
    for (i = 0; i < n; i++) v[i] = 0;
}
