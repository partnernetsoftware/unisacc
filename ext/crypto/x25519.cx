#pragma unisa module x25519
/* crypto/x25519 -- X25519 key agreement (RFC 7748 §5) over Curve25519.
   Pure cx: sixteen 16-bit limbs held in 64-bit words, so every product fits without a 128-bit type.
   No libc, no allocation, no secret-dependent branch.

     cs_x25519(scalar32, u32, out32)         X25519(scalar, u); 0 on success, -EINVAL on a bad argument
                                             or on an all-zero result (a low-order input point, RFC 7748
                                             §6.1: the shared secret would be zero for every peer).
     cs_x25519_base(scalar32, out32)         the same with u = 9, i.e. a public key from a private one.
     cs_x25519_clamp(scalar32)               apply the §5 clamping in place (not needed by cs_x25519,
                                             which clamps a copy; exposed for callers that must store the
                                             private key in its clamped form).

   The ladder runs a fixed 255 iterations with a constant-time conditional swap, so the sequence of
   operations does not depend on the scalar.  A scalar or a point that is 32 bytes of caller memory is
   read in full and never logged; cs_ct_wipe is the intended way to drop them. */

typedef long long cs_gf[16];                      /* one field element: 16 limbs of 16 bits */

static const cs_gf cs_gf_one = {1};
static const cs_gf cs_121665 = {0xDB41, 1};       /* (A - 2) / 4 for Curve25519: 121665 */

static void cs_gf_set(cs_gf r, const cs_gf a) { int i; for (i = 0; i < 16; i++) r[i] = a[i]; }

/* Propagate carries.  The limb at index 0 folds back from limb 15 because 2^256 = 38 mod p. */
static void cs_gf_carry(cs_gf o) {
    long long c;
    int i;
    for (i = 0; i < 16; i++) {
        o[i] += (long long)1 << 16;
        c = o[i] >> 16;
        o[(i + 1) * (i < 15)] += c - 1 + 37 * (c - 1) * (i == 15);
        o[i] -= c << 16;
    }
}

/* Swap P and Q when B is 1, in constant time: the mask is either all ones or all zeros. */
static void cs_gf_cswap(cs_gf p, cs_gf q, int b) {
    long long t, c = ~(long long)(b - 1);
    int i;
    for (i = 0; i < 16; i++) { t = c & (p[i] ^ q[i]); p[i] ^= t; q[i] ^= t; }
}

/* Serialise the canonical residue: subtract p up to twice, selecting only when the value is >= p. */
static void cs_gf_pack(unsigned char *o, const cs_gf n) {
    cs_gf m, t;
    int i, j, b;
    for (i = 0; i < 16; i++) t[i] = n[i];
    cs_gf_carry(t); cs_gf_carry(t); cs_gf_carry(t);
    for (j = 0; j < 2; j++) {
        m[0] = t[0] - 0xffed;
        for (i = 1; i < 15; i++) {
            m[i] = t[i] - 0xffff - ((m[i - 1] >> 16) & 1);
            m[i - 1] &= 0xffff;
        }
        m[15] = t[15] - 0x7fff - ((m[14] >> 16) & 1);
        b = (int)((m[15] >> 16) & 1);
        m[14] &= 0xffff;
        cs_gf_cswap(t, m, 1 - b);
    }
    for (i = 0; i < 16; i++) { o[2 * i] = (unsigned char)t[i]; o[2 * i + 1] = (unsigned char)(t[i] >> 8); }
}

static void cs_gf_unpack(cs_gf o, const unsigned char *n) {
    int i;
    for (i = 0; i < 16; i++) o[i] = n[2 * i] + ((long long)n[2 * i + 1] << 8);
    o[15] &= 0x7fff;                              /* only 255 bits are part of the encoding */
}

static void cs_gf_add(cs_gf o, const cs_gf a, const cs_gf b) { int i; for (i = 0; i < 16; i++) o[i] = a[i] + b[i]; }
static void cs_gf_sub(cs_gf o, const cs_gf a, const cs_gf b) { int i; for (i = 0; i < 16; i++) o[i] = a[i] - b[i]; }

static void cs_gf_mul(cs_gf o, const cs_gf a, const cs_gf b) {
    long long t[31];
    int i, j;
    for (i = 0; i < 31; i++) t[i] = 0;
    for (i = 0; i < 16; i++) for (j = 0; j < 16; j++) t[i + j] += a[i] * b[j];
    for (i = 0; i < 15; i++) t[i] += 38 * t[i + 16];   /* limbs above 2^256 fold back by 38 */
    for (i = 0; i < 16; i++) o[i] = t[i];
    cs_gf_carry(o); cs_gf_carry(o);
}

static void cs_gf_sq(cs_gf o, const cs_gf a) { cs_gf_mul(o, a, a); }

/* o = i^(p-2) = i^-1, by the fixed square-and-multiply chain over bits 253..0 of p-2 besides 2 and 4. */
static void cs_gf_inv(cs_gf o, const cs_gf i) {
    cs_gf c;
    int a;
    for (a = 0; a < 16; a++) c[a] = i[a];
    for (a = 253; a >= 0; a--) {
        cs_gf_sq(c, c);
        if (a != 2 && a != 4) cs_gf_mul(c, c, i);
    }
    for (a = 0; a < 16; a++) o[a] = c[a];
}

void cs_x25519_clamp(unsigned char scalar[32]) {
    if (!scalar) return;
    scalar[0] &= 248;                             /* clear the low 3 bits: no small subgroup */
    scalar[31] &= 127;                            /* clear the top bit: < 2^255 */
    scalar[31] |= 64;                             /* set bit 254: fixed bit length */
}

/* The Montgomery ladder: 255 fixed steps, one conditional swap per step keyed on the scalar bit. */
int cs_x25519(const unsigned char scalar[32], const unsigned char u[32], unsigned char out[32]) {
    unsigned char z[32];
    cs_gf x, a, b, c, d, e, f;
    int i, bit;
    if (!scalar || !u || !out) return -EINVAL;
    for (i = 0; i < 32; i++) z[i] = scalar[i];
    cs_x25519_clamp(z);
    cs_gf_unpack(x, u);
    for (i = 0; i < 16; i++) { b[i] = x[i]; a[i] = 0; c[i] = 0; d[i] = 0; }
    a[0] = 1; d[0] = 1;
    for (i = 254; i >= 0; i--) {
        bit = (z[i >> 3] >> (i & 7)) & 1;
        cs_gf_cswap(a, b, bit);
        cs_gf_cswap(c, d, bit);
        cs_gf_add(e, a, c);
        cs_gf_sub(a, a, c);
        cs_gf_add(c, b, d);
        cs_gf_sub(b, b, d);
        cs_gf_sq(d, e);
        cs_gf_sq(f, a);
        cs_gf_mul(a, c, a);
        cs_gf_mul(c, b, e);
        cs_gf_add(e, a, c);
        cs_gf_sub(a, a, c);
        cs_gf_sq(b, a);
        cs_gf_sub(c, d, f);
        cs_gf_mul(a, c, cs_121665);
        cs_gf_add(a, a, d);
        cs_gf_mul(c, c, a);
        cs_gf_mul(a, d, f);
        cs_gf_mul(d, b, x);
        cs_gf_sq(b, e);
        cs_gf_cswap(a, b, bit);
        cs_gf_cswap(c, d, bit);
    }
    cs_gf_inv(c, c);
    cs_gf_mul(a, a, c);
    cs_gf_pack(out, a);
    {   unsigned char acc = 0;                    /* an all-zero result means a low-order u */
        for (i = 0; i < 32; i++) acc |= out[i];
        if (acc == 0) return -EINVAL;
    }
    return 0;
}

int cs_x25519_base(const unsigned char scalar[32], unsigned char out[32]) {
    unsigned char base[32];
    int i;
    for (i = 0; i < 32; i++) base[i] = 0;
    base[0] = 9;                                  /* the §4.1 base point of Curve25519 */
    return cs_x25519(scalar, base, out);
}
