/* ext.fsx fs: file-system conveniences for tools (prefix fsx_).
 *
 * Paths:   fsx_join (the exact bytes of "%s/%s", one separator, NUL-terminated, -ERANGE when it does
 *          not fit, -EINVAL for an absolute B), fsx_join_under (B must stay below A after lexical
 *          normalisation: ".." escape is -EXDEV), fsx_inside (realpath containment, so a symlink
 *          that leaves ROOT is caught).
 * Files:   fsx_read (whole file, bounded, NUL-terminated, -EFBIG past MAX), fsx_write (atomic:
 *          sibling temporary + fsync + rename; on failure nothing is left behind), fsx_exists
 *          (1 / 0 only for ENOENT / -errno for ENOTDIR, EACCES, ...), fsx_is_dir and fsx_is_file
 *          (links followed: 1 that kind / 0 absent (ENOENT only) or another kind / -errno).
 * Scratch: fsx_scratch makes PREFIXxxxx under sy_tmpdir() (never a hard-coded /tmp); drop removes
 *          the tree only when the path is still the directory it made (dev+ino, not a symlink);
 *          every live scratch is dropped at process exit.
 * Walk:    fsx_walk_open collects, sorts (bytewise) and hands out entries one by one; recursion,
 *          link following, .git skipping and a glob filter are flags; depth is capped (link loops).
 * Glob:    fsx_glob_match: '*' and '?' never cross '/', '**' does ("**" + "/" also matches zero dirs).
 * Hash:    fsx_sha256 (one file), fsx_tree_sha256 (sorted "kind mode path digest" lines where digest
 *          is the file sha256, the symlink target, or "-" for a directory; sha256 of those lines).
 * Lock:    fsx_lock: O_EXCL lock file holding "pid\tms\n"; an owner whose pid is gone, or a lock
 *          older than STALE_MS (when > 0), is reclaimed; -ETIMEDOUT past the deadline.  fsx_unlock
 *          refuses (-ESTALE) when the file is no longer this owner's.
 *
 * Errors are 0 or -errno.  Handles are ints: slot + 1 plus a generation in the high bits, so a
 * stale or doubled close is -EBADF.  Only L0 sy_/tx_/mm_/pt_ calls and the implicit runtime. */
#pragma unisa module fs
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.posix
#pragma unisa use sys.proc
#pragma unisa use sys.sha
#pragma unisa use sys.sig
#pragma unisa use sys.time
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use text.text
#pragma unisa use path.path

enum { FSX_PATH = 4096, FSX_SLOTS = 16, FSX_DEPTH = 24 };   /* depth: each level holds one of L0's 32 directory iterators */
enum { FSX_WALK_RECURSE = 1, FSX_WALK_FOLLOW = 2, FSX_WALK_SKIP_GIT = 4, FSX_WALK_FILES = 8 };

static int fsx_mkh(int slot, int gen) { return (slot + 1) | ((gen & 0x7fff) << 8); }
static int fsx_slot(int h) { return (h & 0xff) - 1; }

/* ---- paths ---- */
long fsx_join(char *dst, long cap, const char *a, const char *b) {
    long an, bn, o = 0;
    if (!dst || cap <= 0 || !a || !b) return -EINVAL;
    if (b[0] == '/') return -EINVAL;
    an = tx_len(a, FSX_PATH * 4);
    bn = tx_len(b, FSX_PATH * 4);
    if (an + 1 + bn + 1 > cap) { dst[0] = 0; return -ERANGE; }
    if (an) { mm_copy(dst, cap, a, an); o = an; }
    if (an && bn && a[an - 1] != '/') dst[o++] = '/';
    if (bn) { mm_copy(dst + o, cap - o, b, bn); o += bn; }
    dst[o] = 0;
    return o;
}

long fsx_join_under(char *dst, long cap, const char *root, const char *rel) {
    char norm[FSX_PATH];
    long n;
    if (!rel || !root) return -EINVAL;
    if (rel[0] == '/') return -EXDEV;
    n = pt_normalize_as(0, norm, sizeof norm, rel, tx_len(rel, FSX_PATH));
    if (n < 0) return n;
    if ((n == 2 && norm[0] == '.' && norm[1] == '.') || (n > 2 && tx_prefixz(norm, "../", 3))) return -EXDEV;
    if (n == 1 && norm[0] == '.') return fsx_join(dst, cap, root, "");
    return fsx_join(dst, cap, root, norm);
}

/* 1 when PATH (resolved) is ROOT or below it, 0 when it is outside, -errno when either cannot be resolved. */
int fsx_inside(const char *root, const char *path) {
    char r[FSX_PATH], p[FSX_PATH];
    long rn;
    int rc = sy_realpath(root, r, sizeof r);
    if (rc < 0) return rc;
    rc = sy_realpath(path, p, sizeof p);
    if (rc < 0) return rc;
    rn = tx_len(r, sizeof r);
    if (rn == 1 && r[0] == '/') return 1;
    if (!tx_prefix(p, tx_len(p, sizeof p), r, rn)) return 0;
    return p[rn] == 0 || p[rn] == '/';
}

/* ---- whole files ---- */
int fsx_exists(const char *path) { return sy_exists(path); }

/* What PATH names after following links: 1 when it is KIND ('d' directory, 'f' regular file), 0 when it
   is absent (ENOENT only; a dangling link is absent) or names another kind, -errno for every other
   failure (ENOTDIR, EACCES, ...): those are not "absent", so callers that want a plain yes test > 0. */
static int fsx_is_kind(const char *path, int kind) {
    sy_stat_t st;
    int rc = sy_stat(path, &st);
    if (rc == -ENOENT) return 0;
    if (rc < 0) return rc;
    return st.kind == kind;
}
int fsx_is_dir(const char *path) { return fsx_is_kind(path, 'd'); }
int fsx_is_file(const char *path) { return fsx_is_kind(path, 'f'); }

/* *OUT is mm_alloc'd, NUL-terminated, N bytes (caller mm_free's it); *OUT is 0 on failure. */
int fsx_read(const char *path, char **out, long *n, long max) {
    unsigned char *buf = 0;
    int64_t got = 0;
    char *z;
    int rc;
    if (!out || !n || max < 0) return -EINVAL;
    *out = 0;
    *n = 0;
    rc = sy_read_file(path, &buf, &got, (int64_t)max + 1);
    if (rc < 0) return rc;
    if (got > max) { mm_free(buf); return -EFBIG; }
    z = (char *)mm_alloc((long)got + 1);
    if (!z) { mm_free(buf); return -ENOMEM; }
    if (got) mm_copy(z, (long)got + 1, buf, (long)got);
    z[got] = 0;
    mm_free(buf);
    *out = z;
    *n = (long)got;
    return 0;
}

int fsx_write(const char *path, const void *p, long n, int mode) { return sy_write_atomic(path, p, n, mode ? mode : 0644); }

/* Remove PATH and everything below it without following symlinks.  Absent is 0. */
static int fsx_rm_at(const char *path, int depth) {
    sy_stat_t st;
    sy_dir_t d;
    char sub[FSX_PATH];
    int rc = sy_lstat(path, &st), r, first = 0;
    if (rc == -ENOENT) return 0;
    if (rc < 0) return rc;
    if (st.kind != 'd') return sy_unlink(path);
    if (depth > FSX_DEPTH) return -ELOOP;
    rc = sy_dir_open(&d, path);
    if (rc < 0) return rc;
    while ((r = sy_dir_next(&d)) == 1) {
        if (fsx_join(sub, sizeof sub, path, d.name) < 0) { first = first ? first : -ENAMETOOLONG; continue; }
        rc = fsx_rm_at(sub, depth + 1);
        if (rc < 0 && !first) first = rc;
    }
    sy_dir_close(&d);
    if (r < 0 && !first) first = r;
    if (first) return first;
    return sy_rmdir(path);
}
int fsx_rmtree(const char *path) {
    if (!path || !path[0] || (path[0] == '/' && path[1] == 0)) return -EINVAL;
    return fsx_rm_at(path, 0);
}

/* ---- scratch directories ---- */
static struct { int used, gen; unsigned long dev; long ino; char path[FSX_PATH]; } fsx_sc[FSX_SLOTS];
static int fsx_sc_hooked;

static int fsx_sc_get(int h) {
    int i = fsx_slot(h);
    if (h <= 0 || i < 0 || i >= FSX_SLOTS || !fsx_sc[i].used || fsx_mkh(i, fsx_sc[i].gen) != h) return -1;
    return i;
}

int fsx_scratch_drop(int h) {
    sy_stat_t st;
    int i = fsx_sc_get(h), rc;
    if (i < 0) return -EBADF;
    rc = sy_lstat(fsx_sc[i].path, &st);
    if (rc == -ENOENT) { fsx_sc[i].used = 0; return 0; }
    if (rc < 0) return rc;
    if (st.kind != 'd' || st.dev != fsx_sc[i].dev || st.ino != fsx_sc[i].ino) return -ESTALE;   /* swapped: not ours */
    rc = fsx_rmtree(fsx_sc[i].path);
    if (rc == 0) fsx_sc[i].used = 0;
    return rc;
}

static void fsx_sc_atexit(void) {
    int i;
    for (i = 0; i < FSX_SLOTS; i++) if (fsx_sc[i].used) fsx_scratch_drop(fsx_mkh(i, fsx_sc[i].gen));
}

int fsx_scratch(int *h, const char *prefix) {
    sy_stat_t st;
    int i, rc;
    if (!h) return -EINVAL;
    *h = 0;
    for (i = 0; i < FSX_SLOTS && fsx_sc[i].used; i++) {}
    if (i == FSX_SLOTS) return -EMFILE;
    rc = sy_mkdtemp(sy_tmpdir(), prefix && prefix[0] ? prefix : "fsx-", fsx_sc[i].path, FSX_PATH);
    if (rc < 0) return rc;
    rc = sy_lstat(fsx_sc[i].path, &st);
    if (rc < 0) { sy_rmdir(fsx_sc[i].path); return rc; }
    if (!fsx_sc_hooked) { fsx_sc_hooked = 1; sy_atexit(fsx_sc_atexit); }
    fsx_sc[i].used = 1;
    fsx_sc[i].gen++;
    fsx_sc[i].dev = st.dev;
    fsx_sc[i].ino = st.ino;
    *h = fsx_mkh(i, fsx_sc[i].gen);
    return 0;
}

const char *fsx_scratch_dir(int h) { int i = fsx_sc_get(h); return i < 0 ? 0 : fsx_sc[i].path; }

/* ---- glob ---- */
static int fsx_gm(const char *p, const char *s) {
    for (;;) {
        if (!*p) return !*s;
        if (p[0] == '*' && p[1] == '*') {
            const char *q = p + 2;
            if (*q == '/') { if (fsx_gm(q + 1, s)) return 1; }
            else if (fsx_gm(q, s)) return 1;
            for (; *s; s++) if (fsx_gm(q, s + 1) || (*q == '/' && s[0] == '/' && fsx_gm(q + 1, s + 1))) return 1;
            return 0;
        }
        if (*p == '*') {
            for (;; s++) { if (fsx_gm(p + 1, s)) return 1; if (!*s || *s == '/') return 0; }
        }
        if (!*s) return 0;
        if (*p == '?') { if (*s == '/') return 0; }
        else if (*p != *s) return 0;
        p++;
        s++;
    }
}
int fsx_glob_match(const char *pat, const char *rel) {
    if (!pat || !rel) return -EINVAL;
    if (rel[0] == '/' || tx_prefixz(rel, "../", 3)) return 0;
    return fsx_gm(pat, rel);
}

/* ---- walk ---- */
typedef struct { char *rel; int kind; } fsx_ent;
static struct { int used, gen, pos, n, cap; fsx_ent *e; } fsx_wk[FSX_SLOTS];

static int fsx_wk_push(int i, const char *rel, int kind) {
    if (fsx_wk[i].n == fsx_wk[i].cap) {
        int c = fsx_wk[i].cap ? fsx_wk[i].cap * 2 : 64;
        fsx_ent *g = (fsx_ent *)mm_grow(fsx_wk[i].e, (long)c * (long)sizeof(fsx_ent));
        if (!g) return -ENOMEM;
        fsx_wk[i].e = g;
        fsx_wk[i].cap = c;
    }
    fsx_wk[i].e[fsx_wk[i].n].rel = mm_strdup(rel);
    if (!fsx_wk[i].e[fsx_wk[i].n].rel) return -ENOMEM;
    fsx_wk[i].e[fsx_wk[i].n].kind = kind;
    fsx_wk[i].n++;
    return 0;
}

static int fsx_wk_scan(int i, const char *root, const char *rel, int flags, const char *glob, int depth) {
    sy_dir_t d;
    char full[FSX_PATH], sub[FSX_PATH];
    int r, rc, first = 0;
    if (depth > FSX_DEPTH) return -ELOOP;
    if (fsx_join(full, sizeof full, root, rel) < 0) return -ENAMETOOLONG;
    rc = sy_dir_open(&d, full);
    if (rc < 0) return rc;
    while ((r = sy_dir_next(&d)) == 1) {
        int kind = d.kind, descend;
        if ((flags & FSX_WALK_SKIP_GIT) && tx_eqz(d.name, ".git")) continue;
        if (fsx_join(sub, sizeof sub, rel, d.name) < 0) { first = -ENAMETOOLONG; break; }
        if (kind == 'l' && (flags & FSX_WALK_FOLLOW)) {
            sy_stat_t st;
            char lp[FSX_PATH];
            if (fsx_join(lp, sizeof lp, root, sub) >= 0 && sy_stat(lp, &st) == 0 && st.kind == 'd') kind = 'D';   /* followed link dir */
        }
        descend = (flags & FSX_WALK_RECURSE) && (kind == 'd' || kind == 'D');
        if ((!glob || fsx_gm(glob, sub)) && (!(flags & FSX_WALK_FILES) || kind == 'f' || kind == 'l')) {
            rc = fsx_wk_push(i, sub, kind == 'D' ? 'l' : kind);
            if (rc < 0) { first = rc; break; }
        }
        if (descend) { rc = fsx_wk_scan(i, root, sub, flags, glob, depth + 1); if (rc < 0) { first = rc; break; } }
    }
    sy_dir_close(&d);
    if (r < 0 && !first) first = r;
    return first;
}

static void fsx_wk_free(int i) {
    int k;
    for (k = 0; k < fsx_wk[i].n; k++) mm_free(fsx_wk[i].e[k].rel);
    mm_free(fsx_wk[i].e);
    fsx_wk[i].e = 0;
    fsx_wk[i].n = fsx_wk[i].cap = fsx_wk[i].pos = 0;
    fsx_wk[i].used = 0;
}

static int fsx_relcmp(const fsx_ent *a, const fsx_ent *b) { return tx_cmp(a->rel, tx_len(a->rel, FSX_PATH), b->rel, tx_len(b->rel, FSX_PATH)); }

static int fsx_sort(fsx_ent *e, int n) {   /* bottom-up merge sort, bytewise on rel: deterministic */
    fsx_ent *t;
    int w, lo;
    if (n < 2) return 0;
    t = (fsx_ent *)mm_alloc((long)n * (long)sizeof(fsx_ent));
    if (!t) return -ENOMEM;
    for (w = 1; w < n; w *= 2) {
        for (lo = 0; lo < n; lo += 2 * w) {
            int mid = lo + w < n ? lo + w : n, hi = lo + 2 * w < n ? lo + 2 * w : n, a = lo, b = mid, k = lo;
            while (a < mid && b < hi) t[k++] = fsx_relcmp(&e[a], &e[b]) <= 0 ? e[a++] : e[b++];
            while (a < mid) t[k++] = e[a++];
            while (b < hi) t[k++] = e[b++];
        }
        mm_copy(e, (long)n * (long)sizeof(fsx_ent), t, (long)n * (long)sizeof(fsx_ent));
    }
    mm_free(t);
    return 0;
}

int fsx_walk_open(int *w, const char *root, int flags, const char *glob) {
    int i, rc;
    if (!w || !root || !root[0]) return -EINVAL;
    *w = 0;
    for (i = 0; i < FSX_SLOTS && fsx_wk[i].used; i++) {}
    if (i == FSX_SLOTS) return -EMFILE;
    fsx_wk[i].used = 1;
    fsx_wk[i].gen++;
    rc = fsx_wk_scan(i, root, "", flags, glob, 0);
    if (rc >= 0) rc = fsx_sort(fsx_wk[i].e, fsx_wk[i].n);
    if (rc < 0) { fsx_wk_free(i); return rc; }
    *w = fsx_mkh(i, fsx_wk[i].gen);
    return 0;
}

static int fsx_wk_get(int h) {
    int i = fsx_slot(h);
    if (h <= 0 || i < 0 || i >= FSX_SLOTS || !fsx_wk[i].used || fsx_mkh(i, fsx_wk[i].gen) != h) return -1;
    return i;
}

/* 1 with *REL (borrowed until close) and *KIND ('f' 'd' 'l' ...), 0 at the end, -EBADF. */
int fsx_walk_next(int w, const char **rel, int *kind) {
    int i = fsx_wk_get(w);
    if (i < 0) return -EBADF;
    if (fsx_wk[i].pos >= fsx_wk[i].n) return 0;
    if (rel) *rel = fsx_wk[i].e[fsx_wk[i].pos].rel;
    if (kind) *kind = fsx_wk[i].e[fsx_wk[i].pos].kind;
    fsx_wk[i].pos++;
    return 1;
}

int fsx_walk_close(int w) {
    int i = fsx_wk_get(w);
    if (i < 0) return -EBADF;
    fsx_wk_free(i);
    return 0;
}

/* ---- hashes ---- */
int fsx_sha256(const char *path, char hex[65]) {
    char *p;
    long n;
    int rc = fsx_read(path, &p, &n, 1L << 30);
    if (rc < 0) return rc;
    rc = sy_sha256_hex(p, n, hex);
    mm_free(p);
    return rc < 0 ? rc : 0;
}

static int fsx_app(char **b, long *n, long *cap, const char *s, long sn) {
    if (*n + sn + 1 > *cap) {
        long c = *cap ? *cap : 4096;
        char *g;
        while (c < *n + sn + 1) c *= 2;
        g = (char *)mm_grow(*b, c);
        if (!g) return -ENOMEM;
        *b = g;
        *cap = c;
    }
    mm_copy(*b + *n, *cap - *n, s, sn);
    *n += sn;
    (*b)[*n] = 0;
    return 0;
}

/* Lines "kind\tmode\trel\tdigest\n" in bytewise rel order; links are not followed.  GLOB may be 0. */
int fsx_tree_sha256(const char *root, const char *glob, char hex[65]) {
    int w, kind, rc, r = 0;
    const char *rel;
    char *b = 0;
    long n = 0, cap = 0;
    rc = fsx_walk_open(&w, root, FSX_WALK_RECURSE, glob);
    if (rc < 0) return rc;
    while ((r = fsx_walk_next(w, &rel, &kind)) == 1) {
        char full[FSX_PATH], dig[FSX_PATH], line[FSX_PATH * 3];
        sy_stat_t st;
        if (fsx_join(full, sizeof full, root, rel) < 0) { rc = -ENAMETOOLONG; break; }
        rc = sy_lstat(full, &st);
        if (rc < 0) break;
        if (st.kind == 'f') rc = fsx_sha256(full, dig);
        else if (st.kind == 'l') { long k = sy_readlink(full, dig, sizeof dig - 1); rc = k < 0 ? (int)k : 0; if (k >= 0) dig[k] = 0; }
        else { dig[0] = '-'; dig[1] = 0; }
        if (rc < 0) break;
        if (cx_fmt(line, sizeof line, "%c\t%o\t%s\t%s\n", st.kind, st.mode, rel, dig)) { rc = -ENAMETOOLONG; break; }
        rc = fsx_app(&b, &n, &cap, line, tx_len(line, sizeof line));
        if (rc < 0) break;
    }
    fsx_walk_close(w);
    if (r < 0 && rc >= 0) rc = r;
    if (rc >= 0) rc = sy_sha256_hex(b ? b : "", n, hex) < 0 ? -EIO : 0;
    mm_free(b);
    return rc;
}

/* ---- lock files ---- */
static struct { int used, gen; char path[FSX_PATH]; char body[64]; } fsx_lk[FSX_SLOTS];

static int fsx_lk_stale(const char *path, long stale_ms) {   /* 1 reclaimable, 0 live, -errno */
    char *p;
    long n, pid = 0, ms = 0;
    int k = 0, rc = fsx_read(path, &p, &n, 63);
    if (rc == -ENOENT) return 1;
    if (rc < 0) return rc;
    while (k < n && p[k] >= '0' && p[k] <= '9') pid = pid * 10 + (p[k++] - '0');
    if (k < n && p[k] == '\t') { k++; while (k < n && p[k] >= '0' && p[k] <= '9') ms = ms * 10 + (p[k++] - '0'); }
    mm_free(p);
    if (pid <= 0) return 1;                                    /* no owner recorded */
    if (sy_signal((int)pid, 0) == -ESRCH) return 1;            /* owner gone */
    if (stale_ms > 0 && sy_wall_s() * 1000 - ms > stale_ms) return 1;
    return 0;
}

int fsx_lock(int *h, const char *path, long deadline_ms, long stale_ms) {
    long end = sy_now_ms() + (deadline_ms > 0 ? deadline_ms : 0);
    int i, fd, rc;
    if (!h || !path || !path[0]) return -EINVAL;
    *h = 0;
    for (i = 0; i < FSX_SLOTS && fsx_lk[i].used; i++) {}
    if (i == FSX_SLOTS) return -EMFILE;
    if (tx_copy(fsx_lk[i].path, FSX_PATH, path, tx_len(path, FSX_PATH))) return -ENAMETOOLONG;
    if (cx_fmt(fsx_lk[i].body, sizeof fsx_lk[i].body, "%d\t%ld\n", sy_pid(), sy_wall_s() * 1000)) return -EIO;
    for (;;) {
        fd = sy_open_new(path, 0644);
        if (fd >= 0) {
            long bn = tx_len(fsx_lk[i].body, sizeof fsx_lk[i].body);
            rc = sy_write_all(fd, fsx_lk[i].body, bn);
            sy_close(fd);
            if (rc < 0) { sy_unlink(path); return rc; }
            fsx_lk[i].used = 1;
            fsx_lk[i].gen++;
            *h = fsx_mkh(i, fsx_lk[i].gen);
            return 0;
        }
        if (fd != -EEXIST) return fd;
        rc = fsx_lk_stale(path, stale_ms);
        if (rc < 0) return rc;
        if (rc == 1) { sy_unlink(path); continue; }
        if (sy_now_ms() >= end) return -ETIMEDOUT;
        sy_sleep_ms(20);
    }
}

int fsx_unlock(int h) {
    char *p;
    long n;
    int i = fsx_slot(h), rc, mine;
    if (h <= 0 || i < 0 || i >= FSX_SLOTS || !fsx_lk[i].used || fsx_mkh(i, fsx_lk[i].gen) != h) return -EBADF;
    fsx_lk[i].used = 0;
    rc = fsx_read(fsx_lk[i].path, &p, &n, 63);
    if (rc < 0) return rc == -ENOENT ? -ESTALE : rc;
    mine = tx_same(p, n, fsx_lk[i].body, tx_len(fsx_lk[i].body, sizeof fsx_lk[i].body));
    mm_free(p);
    if (!mine) return -ESTALE;
    return sy_unlink(fsx_lk[i].path);
}
