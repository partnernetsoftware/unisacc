#pragma unisa module arena
/* L0 memory: arenas (plans/cx-layers.md).  An arena hands out zeroed blocks and frees them all at
   once; there is no per-block free, so a tool or stage never frees a block twice or loses one.
   Up to 16 arenas live at a time; each is a handle (1..16), never a pointer.  Limits are checked
   before any allocation; on failure nothing changes and 0 is returned.  Single-threaded. */
typedef struct ar_chunk { struct ar_chunk *next; long used, cap; } ar_chunk;
static ar_chunk *ar_head[16];
static long ar_limit[16], ar_total[16];
static int ar_live[16];

/* New arena allowed to hold at most limit payload bytes (1 .. 1<<40); returns its handle or 0. */
int ar_new(long limit) {
    int i;
    if (limit < 1 || limit > (1L << 40)) return 0;
    for (i = 0; i < 16; i++) if (!ar_live[i]) { ar_live[i] = 1; ar_head[i] = 0; ar_limit[i] = limit; ar_total[i] = 0; return i + 1; }
    return 0;
}

/* A zeroed block of n bytes (1 .. limit) from arena a, aligned to 16, or 0. */
void *ar_alloc(int a, long n) {
    ar_chunk *c;
    long need;
    char *p;
    if (a < 1 || a > 16 || !ar_live[a - 1] || n < 1 || n > ar_limit[a - 1] - ar_total[a - 1]) return 0;
    need = (n + 15) & ~15L;
    c = ar_head[a - 1];
    if (!c || c->cap - c->used < need) {
        long cap = need > 65536 ? need : 65536;
        c = calloc(1, sizeof(ar_chunk) + 16 + (size_t)cap);
        if (!c) return 0;
        c->cap = cap;
        c->next = ar_head[a - 1];
        ar_head[a - 1] = c;
    }
    p = (char *)(c + 1);
    p += (16 - ((unsigned long)p & 15)) & 15;     /* first 16-aligned byte; the chunk has 16 spare */
    p += c->used;
    c->used += need;
    ar_total[a - 1] += n;
    return p;
}

/* A copy of src[0..n) in arena a, followed by one NUL byte; 0 on failure. */
char *ar_dup(int a, const char *src, long n) {
    char *p;
    long i;
    if (!src || n < 0) return 0;
    p = ar_alloc(a, n + 1);
    if (!p) return 0;
    for (i = 0; i < n; i++) p[i] = src[i];
    return p;
}

/* Frees every block of arena a and retires the handle; returns 0, or 1 for a bad handle. */
int ar_drop(int a) {
    ar_chunk *c, *n;
    if (a < 1 || a > 16 || !ar_live[a - 1]) return 1;
    for (c = ar_head[a - 1]; c; c = n) { n = c->next; free(c); }
    ar_head[a - 1] = 0;
    ar_live[a - 1] = 0;
    return 0;
}
