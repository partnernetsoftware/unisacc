#pragma unisa module net
#pragma unisa dock
#pragma unisa use sys.time
#pragma unisa use sys.fs
#pragma unisa use mem.bytes
/* sysx.net: TCP for local servers, stubs and their clients
   (plans/cx-layers.md). Listening and sy_tcp_connect are 127.0.0.1 only;
   sy_tcp_dial and sy_resolve4 reach any IPv4 host the system resolver knows.
   OS extension docking: <sys/socket.h>, <netinet/in.h>,
   <arpa/inet.h> and <netdb.h> are not in the implicit prelude; the carried headers hold the
   per-target socket code, so they are included in this optional extension. Waiting
   is sys/time's sy_readable. 0 or a value on success, -errno on failure.
   Writes use send(MSG_NOSIGNAL): this runtime's signal() cannot ignore
   SIGPIPE, so a plain write to a peer that has gone would kill the process. */
#include <arpa/inet.h>
#include <netdb.h>
#include <netinet/in.h>
#include <sys/socket.h>
#include <sys/un.h>
#include <netinet/tcp.h>
#include <poll.h>
#include <sys/time.h>

static void sy_loop_addr(struct sockaddr_in *a, int port) {
    memset(a, 0, sizeof *a);
    a->sin_family = AF_INET;
    a->sin_port = htons((unsigned short)port);
    a->sin_addr.s_addr = htonl(0x7f000001);
}

/* Listen on 127.0.0.1:PORT (0: any free port, see sy_tcp_port). The fd, or -errno. */
int sy_tcp_listen(int port, int backlog) {
    struct sockaddr_in a;
    int s, one = 1;
    s = socket(AF_INET, SOCK_STREAM, 0);
    if (s < 0) return -errno;
    setsockopt(s, SOL_SOCKET, SO_REUSEADDR, &one, sizeof one);
    sy_loop_addr(&a, port);
    if (bind(s, (struct sockaddr *)&a, sizeof a) != 0 || listen(s, backlog > 0 ? backlog : 8) != 0) {
        int e = errno;
        close(s);
        return -e;
    }
    return s;
}

/* The port FD is bound to, or -errno. */
int sy_tcp_port(int fd) {
    struct sockaddr_in a;
    socklen_t n = sizeof a;
    if (getsockname(fd, (struct sockaddr *)&a, &n) != 0) return -errno;
    return (int)ntohs(a.sin_port);
}

/* Accept one connection on listening FD, waiting at most MS (negative:
   forever). The new fd, -ETIMEDOUT, or -errno. */
int sy_tcp_accept(int fd, long ms) {
    int r = sy_readable(fd, ms), c;
    if (r < 0) return r;
    if (r == 0) return -ETIMEDOUT;
    c = accept(fd, NULL, NULL);
    return c < 0 ? -errno : c;
}

/* Connect to 127.0.0.1:PORT. The fd, or -errno (-ECONNREFUSED: nothing listens). */
int sy_tcp_connect(int port) {
    struct sockaddr_in a;
    int s = socket(AF_INET, SOCK_STREAM, 0);
    if (s < 0) return -errno;
    sy_loop_addr(&a, port);
    if (connect(s, (struct sockaddr *)&a, sizeof a) != 0) {
        int e = errno;
        close(s);
        return -e;
    }
    return s;
}

/* 0 once 127.0.0.1:PORT accepts a connection, -ETIMEDOUT after MS. The probe
   connection is closed at once without sending anything. */
int sy_wait_port(int port, long ms) {
    long end = sy_now_ms() + ms;
    for (;;) {
        int s = sy_tcp_connect(port);
        if (s >= 0) { close(s); return 0; }
        if (sy_now_ms() >= end) return -ETIMEDOUT;
        sy_sleep_ms(50);
    }
}

/* Send all N bytes of BUF. 0, or -errno (-EPIPE: the peer went away). */
int sy_send_all(int fd, const void *buf, long n) {
    const char *p = buf;
    while (n > 0) {
        ssize_t k = send(fd, p, (size_t)n, MSG_NOSIGNAL);
        if (k < 0 && errno == EINTR) continue;
        if (k <= 0) return k < 0 ? -errno : -EPIPE;
        p += k;
        n -= (long)k;
    }
    return 0;
}

/* Read up to N bytes. The count, 0 at end of stream, or -errno. */
long sy_recv(int fd, void *buf, long n) {
    ssize_t k;
    do k = recv(fd, buf, (size_t)n, 0);
    while (k < 0 && errno == EINTR);
    return k < 0 ? -errno : (long)k;
}

/* Send what one send(MSG_NOSIGNAL) takes of the N bytes at BUF. The count
   (possibly fewer than N), or -errno (-EPIPE: the peer went away). EINTR is
   retried. sy_send_all loops until all are sent. */
long sy_send(int fd, const void *buf, long n) {
    ssize_t k;
    if (n < 0 || (n > 0 && !buf)) return -EINVAL;
    do k = send(fd, buf, (size_t)n, MSG_NOSIGNAL);
    while (k < 0 && errno == EINTR);
    return k < 0 ? -errno : (long)k;
}

/* ---- names: IPv4 TCP to any host the system resolver knows ----
   The resolver's failures are not errno values: they are returned as
   SY_EAI_BASE minus the resolver's own code (sign dropped), always at or
   below SY_EAI_BASE, so they never collide with -errno. sy_net_error gives
   the text for either kind. */
enum { SY_EAI_BASE = -4096 };

static int syn_eai(int g) { return SY_EAI_BASE - (g < 0 ? -g : g); }

/* The resolver's own code back from an SY_EAI_BASE value (negative on glibc, positive elsewhere). */
static int syn_gai_code(int rc) {
    int k = SY_EAI_BASE - rc;
    return EAI_NONAME < 0 ? -k : k;
}

/* getaddrinfo for HOST:PORT, IPv4 stream sockets only. 0 with *RES set, or an sy_net_error code. */
static int syn_lookup(const char *host, int port, struct addrinfo **res) {
    struct addrinfo hints;
    char serv[16];
    int g;
    *res = NULL;
    if (!host || !host[0] || port < 0 || port > 65535) return -EINVAL;
    if (cx_fmt(serv, sizeof serv, "%d", port)) return -EINVAL;
    memset(&hints, 0, sizeof hints);
    hints.ai_family = AF_INET;
    hints.ai_socktype = SOCK_STREAM;
    errno = 0;
    g = getaddrinfo(host, serv, &hints, res);
    if (g != 0) { *res = NULL; return syn_eai(g); }
    return *res ? 0 : syn_eai(EAI_NONAME);
}

/* Try each address of RES in order; the first connected fd, or the last -errno. */
static int syn_dial(struct addrinfo *res) {
#if defined(_WIN32)
    (void)res;
    return -ENOSYS;   /* a Winsock SOCKET is not an fd: not offered here */
#else
    struct addrinfo *p;
    int last = -EHOSTUNREACH;
    for (p = res; p; p = p->ai_next) {
        int s = socket(p->ai_family, p->ai_socktype, p->ai_protocol), e;
        if (s < 0) { last = -errno; continue; }
        if (connect(s, p->ai_addr, (socklen_t)p->ai_addrlen) == 0) return s;
        e = errno;
        close(s);
        last = e ? -e : -EIO;
    }
    return last;
#endif
}

/* Resolve HOST to its first IPv4 address, written dotted ("127.0.0.1") into
   IP (CAP bytes). The number of IPv4 addresses found (1 or more), or an
   sy_net_error code: an SY_EAI_BASE value for a name the resolver does not
   know, -ERANGE when IP is too small, -EINVAL for a bad argument. */
int sy_resolve4(const char *host, char *ip, int cap) {
    struct addrinfo *res, *p;
    const unsigned char *b;
    int r, n = 0;
    if (!ip || cap < 1) return -EINVAL;
    ip[0] = 0;
    r = syn_lookup(host, 0, &res);
    if (r != 0) return r;
    for (p = res; p; p = p->ai_next) if (p->ai_family == AF_INET && p->ai_addr) n++;
    for (p = res; p && !(p->ai_family == AF_INET && p->ai_addr); p = p->ai_next) {}
    if (!p) { freeaddrinfo(res); return syn_eai(EAI_NONAME); }
    b = (const unsigned char *)&((const struct sockaddr_in *)p->ai_addr)->sin_addr;
    r = cx_fmt(ip, (size_t)cap, "%u.%u.%u.%u", b[0], b[1], b[2], b[3]);
    freeaddrinfo(res);
    if (r) { ip[0] = 0; return -ERANGE; }
    return n;
}

/* Connect to HOST:PORT over IPv4 TCP, trying each resolved address in turn.
   The fd (close with sy_close), or an sy_net_error code (-ECONNREFUSED:
   nothing listens; an SY_EAI_BASE value: the name is unknown). No timeout
   beyond the system's own. Windows: -ENOSYS. */
int sy_tcp_dial(const char *host, int port) {
    struct addrinfo *res;
    int r;
    if (port < 1) return -EINVAL;
    r = syn_lookup(host, port, &res);
    if (r != 0) return r;
    r = syn_dial(res);
    freeaddrinfo(res);
    return r;
}

/* The carried strerror knows only the file-system codes (include/stdio.h);
   the socket codes get their (glibc) text here. */
static const char *syn_errtext(int e) {
    if (e == EPIPE) return "Broken pipe";
    if (e == ECONNREFUSED) return "Connection refused";
    if (e == ECONNRESET) return "Connection reset by peer";
    if (e == ECONNABORTED) return "Software caused connection abort";
    if (e == ETIMEDOUT) return "Connection timed out";
    if (e == EHOSTUNREACH) return "No route to host";
    if (e == ENETUNREACH) return "Network is unreachable";
    if (e == EADDRINUSE) return "Address already in use";
    if (e == EADDRNOTAVAIL) return "Cannot assign requested address";
    if (e == ENOTCONN) return "Transport endpoint is not connected";
    if (e == ENOTSOCK) return "Socket operation on non-socket";
    if (e == EINPROGRESS) return "Operation now in progress";
    if (e == EAGAIN) return "Resource temporarily unavailable";
    if (e == EINTR) return "Interrupted system call";
    if (e == ENOSYS) return "Function not implemented";
    return strerror(e);
}

/* The text for a code from any sy_* call: the resolver's message for an
   SY_EAI_BASE value, the errno text for -errno, "ok" for 0 or more. Static text. */
const char *sy_net_error(int rc) {
    if (rc >= 0) return "ok";
    if (rc <= SY_EAI_BASE) return gai_strerror(syn_gai_code(rc));
    return syn_errtext(-rc);
}

/* Closing a socket is sys/fs sy_close (this module uses fs). */

/* ---- W5: addresses, IPv6, UDP, shutdown, socket options, unix sockets ----
   sy_addr_t carries IPv4 (ip[0..3]), IPv6 (ip[0..15], scope) or a unix path.
   Linux is first class; osx shares the BSD code; win: unix sockets need
   Win10 1803 (else -EAFNOSUPPORT) and SY_SO_REUSEPORT is -ENOPROTOOPT.
   Windows paths are not run here: unverified. */
/* The carried socket headers lack these; values per target (linux, bsd/osx, winsock). */
#ifdef __APPLE__
#define SYN_SO_RCVTIMEO 0x1006
#define SYN_SO_SNDTIMEO 0x1005
#define SYN_SO_BROADCAST 0x20
#define SYN_SO_LINGER 0x80
#define SYN_SO_REUSEPORT 0x200
#define SYN_IPV6_V6ONLY 27
#define SYN_MSG_TRUNC 0x10
#elif defined(_WIN32)
#define SYN_SO_RCVTIMEO 0x1006
#define SYN_SO_SNDTIMEO 0x1005
#define SYN_SO_BROADCAST 0x20
#define SYN_SO_LINGER 0x80
#define SYN_SO_REUSEPORT 0
#define SYN_IPV6_V6ONLY 27
#define SYN_MSG_TRUNC 0x100
#else
#define SYN_SO_RCVTIMEO 20
#define SYN_SO_SNDTIMEO 21
#define SYN_SO_BROADCAST 6
#define SYN_SO_LINGER 13
#define SYN_SO_REUSEPORT 15
#define SYN_IPV6_V6ONLY 26
#define SYN_MSG_TRUNC 0x20
#endif
enum { SYN_IPPROTO_IPV6 = 41 };
struct syn_linger { int l_onoff; int l_linger; };
enum { SY_AF_INET4 = 4, SY_AF_INET6 = 6, SY_AF_UNIX = 1 };
enum { SY_LISTEN_REUSEADDR = 1, SY_LISTEN_V6ONLY = 2 };
enum { SY_SHUT_RD = 0, SY_SHUT_WR = 1, SY_SHUT_RDWR = 2 };
enum { SY_SO_REUSEADDR = 1, SY_SO_REUSEPORT, SY_SO_NODELAY, SY_SO_KEEPALIVE, SY_SO_RCVBUF, SY_SO_SNDBUF,
       SY_SO_RCVTIMEO_MS, SY_SO_SNDTIMEO_MS, SY_SO_V6ONLY, SY_SO_BROADCAST, SY_SO_LINGER_S, SY_SO_ERROR };
typedef struct { int family; int port; unsigned char ip[16]; unsigned scope; char path[108]; } sy_addr_t;

/* sy_addr_t -> sockaddr_storage; the length, or -EAFNOSUPPORT/-EINVAL. */
static int syn_tosa(const sy_addr_t *a, struct sockaddr_storage *ss) {
    memset(ss, 0, sizeof *ss);
    if (!a) return -EINVAL;
    if (a->family == SY_AF_INET4) {
        struct sockaddr_in *p = (struct sockaddr_in *)ss;
        p->sin_family = AF_INET;
        p->sin_port = htons((unsigned short)a->port);
        memcpy(&p->sin_addr, a->ip, 4);
        return (int)sizeof *p;
    }
    if (a->family == SY_AF_INET6) {
        struct sockaddr_in6 *p = (struct sockaddr_in6 *)ss;
        p->sin6_family = AF_INET6;
        p->sin6_port = htons((unsigned short)a->port);
        memcpy(&p->sin6_addr, a->ip, 16);
        p->sin6_scope_id = a->scope;
        return (int)sizeof *p;
    }
    if (a->family == SY_AF_UNIX) {
        struct sockaddr_un *p = (struct sockaddr_un *)ss;
        size_t n = 0;
        while (n < sizeof a->path && a->path[n]) n++;
        if (n == 0) return -EINVAL;
        if (n > 107 || n >= sizeof p->sun_path) return -ENAMETOOLONG;
        p->sun_family = AF_UNIX;
        if (mm_copy(p->sun_path, sizeof p->sun_path, a->path, (long)n) != 0) return -ENAMETOOLONG;
        return (int)sizeof *p;
    }
    return -EAFNOSUPPORT;
}

static void syn_fromsa(sy_addr_t *a, const struct sockaddr_storage *ss) {
    memset(a, 0, sizeof *a);
    if (ss->ss_family == AF_INET) {
        const struct sockaddr_in *p = (const struct sockaddr_in *)ss;
        a->family = SY_AF_INET4;
        a->port = (int)ntohs(p->sin_port);
        memcpy(a->ip, &p->sin_addr, 4);
    } else if (ss->ss_family == AF_INET6) {
        const struct sockaddr_in6 *p = (const struct sockaddr_in6 *)ss;
        a->family = SY_AF_INET6;
        a->port = (int)ntohs(p->sin6_port);
        memcpy(a->ip, &p->sin6_addr, 16);
        a->scope = p->sin6_scope_id;
    } else if (ss->ss_family == AF_UNIX) {
        const struct sockaddr_un *p = (const struct sockaddr_un *)ss;
        a->family = SY_AF_UNIX;
        mm_copy(a->path, sizeof a->path - 1, p->sun_path, (long)(sizeof a->path - 1 < sizeof p->sun_path ? sizeof a->path - 1 : sizeof p->sun_path));
    }
}

/* IPv6 text <-> 16 bytes (the carried inet_pton/ntop are IPv4 only). Parse: 1 ok, 0 bad. */
static int syn_p6(const char *s, unsigned char *out) {
    unsigned short g[8];
    int n = 0, gap = -1, i = 0;
    memset(g, 0, sizeof g);
    if (s[0] == ':') { if (s[1] != ':') return 0; gap = 0; s += 2; }
    while (*s) {
        unsigned long v = 0; int d = 0;
        const char *q = s;
        while ((*q >= '0' && *q <= '9') || (*q >= 'a' && *q <= 'f') || (*q >= 'A' && *q <= 'F')) {
            v = v * 16 + (unsigned long)(*q <= '9' ? *q - '0' : (*q | 32) - 'a' + 10); q++; d++;
            if (d > 4) return 0;
        }
        if (*q == '.' && n <= 6) {   /* trailing dotted v4 */
            unsigned char b[4];
            if (inet_pton(AF_INET, s, b) != 1) return 0;
            g[n] = (unsigned short)(b[0] * 256 + b[1]); g[n + 1] = (unsigned short)(b[2] * 256 + b[3]);
            n += 2; s = q + strlen(q);
            break;
        }
        if (d == 0 || n >= 8) return 0;
        g[n++] = (unsigned short)v; s = q;
        if (!*s) break;
        if (*s != ':') return 0;
        s++;
        if (*s == ':') { if (gap >= 0) return 0; gap = n; s++; }
        else if (!*s) return 0;
    }
    if (gap < 0) { if (n != 8) return 0; }
    else {
        int k;
        if (n > 7) return 0;
        for (k = n - 1; k >= gap; k--) g[k + 8 - n] = g[k];
        for (k = gap; k < gap + 8 - n; k++) g[k] = 0;
    }
    for (i = 0; i < 8; i++) { out[2 * i] = (unsigned char)(g[i] >> 8); out[2 * i + 1] = (unsigned char)(g[i] & 255); }
    return 1;
}

/* RFC 5952 text of 16 bytes into DST (>= 46 bytes). */
static void syn_f6(const unsigned char *b, char *dst) {
    static const char hx[] = "0123456789abcdef";
    unsigned g[8];
    int i, bs = -1, bl = 0, cs = -1, cl = 0, n = 0;
    for (i = 0; i < 8; i++) g[i] = (unsigned)b[2 * i] * 256 + b[2 * i + 1];
    for (i = 0; i < 8; i++) {
        if (g[i] == 0) { if (cs < 0) { cs = i; cl = 0; } cl++; if (cl > bl) { bl = cl; bs = cs; } }
        else cs = -1;
    }
    if (bl < 2) bs = -1;
    for (i = 0; i < 8; i++) {
        if (i == bs) { dst[n++] = ':'; dst[n++] = ':'; i += bl - 1; continue; }
        if (i > 0 && i != bs + bl) dst[n++] = ':';
        if (g[i] >> 12) dst[n++] = hx[g[i] >> 12];
        if (g[i] >> 8) dst[n++] = hx[(g[i] >> 8) & 15];
        if (g[i] >> 4) dst[n++] = hx[(g[i] >> 4) & 15];
        dst[n++] = hx[g[i] & 15];
    }
    dst[n] = 0;
}

/* Parse a v4 dotted or v6 colon address (optional %NUMERIC scope) into A. 0, or -EINVAL. No names. */
int sy_addr_parse(sy_addr_t *a, const char *text, int port) {
    char buf[64];
    size_t n = 0;
    const char *pct = NULL;
    if (!a || !text || port < 0 || port > 65535) return -EINVAL;
    memset(a, 0, sizeof *a);
    while (text[n] && n < sizeof buf - 1) { buf[n] = text[n]; n++; }
    if (text[n] || n == 0) return -EINVAL;
    buf[n] = 0;
    for (n = 0; buf[n]; n++) if (buf[n] == '%') { pct = buf + n + 1; buf[n] = 0; break; }
    if (inet_pton(AF_INET, buf, a->ip) == 1 && !pct) { a->family = SY_AF_INET4; a->port = port; return 0; }
    memset(a->ip, 0, 16);
    if (syn_p6(buf, a->ip)) {
        unsigned long sc = 0;
        if (pct) {
            if (!*pct) return -EINVAL;
            for (; *pct; pct++) { if (*pct < '0' || *pct > '9' || sc > 100000000UL) return -EINVAL; sc = sc * 10 + (unsigned long)(*pct - '0'); }
        }
        a->family = SY_AF_INET6; a->port = port; a->scope = (unsigned)sc;
        return 0;
    }
    memset(a, 0, sizeof *a);
    return -EINVAL;
}

/* Text of A into DST (CAP bytes): v4 "1.2.3.4:80", v6 "[::1]:80", unix the path. Length, or -ERANGE/-EINVAL. */
int sy_addr_fmt(const sy_addr_t *a, char *dst, int cap) {
    char ip[64], full[160];
    int n;
    if (!a || !dst || cap < 1) return -EINVAL;
    if (a->family == SY_AF_INET4) {
        if (!inet_ntop(AF_INET, a->ip, ip, sizeof ip)) return -EINVAL;
        if (cx_fmt(full, sizeof full, "%s:%d", ip, a->port)) return -ERANGE;
    } else if (a->family == SY_AF_INET6) {
        syn_f6(a->ip, ip);
        if (a->scope) { if (cx_fmt(full, sizeof full, "[%s%%%u]:%d", ip, a->scope, a->port)) return -ERANGE; }
        else if (cx_fmt(full, sizeof full, "[%s]:%d", ip, a->port)) return -ERANGE;
    } else if (a->family == SY_AF_UNIX) {
        size_t k = 0;
        while (k < sizeof a->path - 1 && a->path[k]) k++;
        mm_copy(full, sizeof full, a->path, (long)k); full[k] = 0;
    } else return -EINVAL;
    n = (int)strlen(full);
    if (n + 1 > cap) { dst[0] = 0; return -ERANGE; }
    mm_copy(dst, cap, full, (long)n + 1);
    return n;
}

int sy_addr_loopback(sy_addr_t *a, int family, int port) {
    if (!a) return -EINVAL;
    if (family != SY_AF_INET4 && family != SY_AF_INET6) return -EAFNOSUPPORT;
    memset(a, 0, sizeof *a);
    a->family = family; a->port = port;
    if (family == SY_AF_INET4) { a->ip[0] = 127; a->ip[3] = 1; } else a->ip[15] = 1;
    return 0;
}

int sy_addr_any(sy_addr_t *a, int family, int port) {
    if (!a) return -EINVAL;
    if (family != SY_AF_INET4 && family != SY_AF_INET6) return -EAFNOSUPPORT;
    memset(a, 0, sizeof *a);
    a->family = family; a->port = port;
    return 0;
}

/* Resolve HOST:PORT (FAMILY 0: v4 and v6, else SY_AF_INET4/6) into OUT (MAX entries). Count, or an sy_net_error code. */
int sy_resolve(const char *host, int port, int family, sy_addr_t *out, int max) {
    struct addrinfo hints, *res, *p;
    char serv[16];
    int g, n = 0;
    if (!host || !host[0] || !out || max < 1 || port < 0 || port > 65535) return -EINVAL;
    if (family != 0 && family != SY_AF_INET4 && family != SY_AF_INET6) return -EAFNOSUPPORT;
    if (cx_fmt(serv, sizeof serv, "%d", port)) return -EINVAL;
    memset(&hints, 0, sizeof hints);
    hints.ai_family = family == 0 ? AF_UNSPEC : family == SY_AF_INET4 ? AF_INET : AF_INET6;
    hints.ai_socktype = SOCK_STREAM;
    g = getaddrinfo(host, serv, &hints, &res);
    if (g != 0) return syn_eai(g);
    for (p = res; p && n < max; p = p->ai_next) {
        if (p->ai_family != AF_INET && p->ai_family != AF_INET6) continue;
        syn_fromsa(&out[n], (const struct sockaddr_storage *)p->ai_addr);
        n++;
    }
    freeaddrinfo(res);
    return n ? n : syn_eai(EAI_NONAME);
}

static int syn_sockfam(const sy_addr_t *a) { return a->family == SY_AF_INET4 ? AF_INET : a->family == SY_AF_INET6 ? AF_INET6 : AF_UNIX; }

/* Create socket of A's family and TYPE; bind to A; the fd or -errno. */
static int syn_bound(const sy_addr_t *a, int type, int flags) {
    struct sockaddr_storage ss;
    int len = syn_tosa(a, &ss), s, one = 1, e;
    if (len < 0) return len;
    s = socket(syn_sockfam(a), type, 0);
    if (s < 0) return -errno;
    if (flags & SY_LISTEN_REUSEADDR) setsockopt(s, SOL_SOCKET, SO_REUSEADDR, &one, sizeof one);
    if (a->family == SY_AF_INET6 && (flags & SY_LISTEN_V6ONLY)) setsockopt(s, SYN_IPPROTO_IPV6, SYN_IPV6_V6ONLY, &one, sizeof one);
    if (bind(s, (struct sockaddr *)&ss, (socklen_t)len) != 0) { e = errno; close(s); return -e; }
    return s;
}

/* Bind A and listen. FLAGS: SY_LISTEN_REUSEADDR, SY_LISTEN_V6ONLY. The fd, or -errno. */
int sy_tcp_listen_at(const sy_addr_t *a, int backlog, int flags) {
    int s;
    if (!a) return -EINVAL;
    s = syn_bound(a, SOCK_STREAM, flags);
    if (s < 0) return s;
    if (listen(s, backlog > 0 ? backlog : 8) != 0) { int e = errno; close(s); return -e; }
    return s;
}

/* Accept like sy_tcp_accept and report the peer into PEER (may be NULL). */
int sy_tcp_accept_from(int fd, long ms, sy_addr_t *peer) {
    struct sockaddr_storage ss;
    socklen_t n = sizeof ss;
    int r = sy_readable(fd, ms), c;
    if (r < 0) return r;
    if (r == 0) return -ETIMEDOUT;
    memset(&ss, 0, sizeof ss);
    c = accept(fd, (struct sockaddr *)&ss, &n);
    if (c < 0) return -errno;
    if (peer) syn_fromsa(peer, &ss);
    return c;
}

/* Connect fd S to SS with a MS limit (negative: none). 0 or -errno/-ETIMEDOUT. */
static int syn_connect_ms(int s, const struct sockaddr_storage *ss, int len, long ms) {
    int fl, r, err = 0;
    socklen_t el = sizeof err;
    struct pollfd pf;
    if (ms < 0) return connect(s, (const struct sockaddr *)ss, (socklen_t)len) == 0 ? 0 : -errno;
    fl = fcntl(s, F_GETFL, 0);
    if (fl < 0 || fcntl(s, F_SETFL, fl | O_NONBLOCK) != 0) return -errno;
    r = connect(s, (const struct sockaddr *)ss, (socklen_t)len);
    if (r != 0 && errno != EINPROGRESS) return -errno;
    if (r != 0) {
        pf.fd = s; pf.events = POLLOUT; pf.revents = 0;
        do r = poll(&pf, 1, ms > 2000000000L ? 2000000000 : (int)ms);
        while (r < 0 && errno == EINTR);
        if (r < 0) return -errno;
        if (r == 0) return -ETIMEDOUT;
        if (getsockopt(s, SOL_SOCKET, SO_ERROR, &err, &el) != 0) return -errno;
        if (err) return -err;
    }
    fcntl(s, F_SETFL, fl);
    return 0;
}

static int syn_dial_ms(const sy_addr_t *a, long ms) {
    struct sockaddr_storage ss;
    int len = syn_tosa(a, &ss), s, r;
    if (len < 0) return len;
    s = socket(syn_sockfam(a), SOCK_STREAM, 0);
    if (s < 0) return -errno;
    r = syn_connect_ms(s, &ss, len, ms);
    if (r < 0) { close(s); return r; }
    return s;
}

/* Connect to A within MS (negative: system default). The fd, -ETIMEDOUT or -errno. */
int sy_tcp_connect_to(const sy_addr_t *a, long ms) {
    if (!a || a->family == SY_AF_UNIX) return a ? -EAFNOSUPPORT : -EINVAL;
    return syn_dial_ms(a, ms);
}

int sy_sock_local(int fd, sy_addr_t *a) {
    struct sockaddr_storage ss;
    socklen_t n = sizeof ss;
    if (!a) return -EINVAL;
    memset(&ss, 0, sizeof ss);
    if (getsockname(fd, (struct sockaddr *)&ss, &n) != 0) return -errno;
    syn_fromsa(a, &ss);
    return 0;
}

int sy_sock_peer(int fd, sy_addr_t *a) {
    struct sockaddr_storage ss;
    socklen_t n = sizeof ss;
    if (!a) return -EINVAL;
    memset(&ss, 0, sizeof ss);
    if (getpeername(fd, (struct sockaddr *)&ss, &n) != 0) return -errno;
    syn_fromsa(a, &ss);
    return 0;
}

/* HOW: SY_SHUT_RD / SY_SHUT_WR / SY_SHUT_RDWR. 0 or -errno (-ENOTCONN). */
int sy_shutdown(int fd, int how) {
    int h = how == SY_SHUT_RD ? SHUT_RD : how == SY_SHUT_WR ? SHUT_WR : how == SY_SHUT_RDWR ? SHUT_RDWR : -1;
    if (h < 0) return -EINVAL;
    return shutdown(fd, h) == 0 ? 0 : -errno;
}

/* Map OPT to level/name; 0 when unknown. KIND: 0 int flag/value, 1 timeval ms, 2 linger seconds. */
static int syn_opt(int opt, int *level, int *name, int *kind) {
    *kind = 0; *level = SOL_SOCKET;
    switch (opt) {
    case SY_SO_REUSEADDR: *name = SO_REUSEADDR; return 1;
    case SY_SO_REUSEPORT: *name = SYN_SO_REUSEPORT; return SYN_SO_REUSEPORT != 0;
    case SY_SO_NODELAY: *level = IPPROTO_TCP; *name = TCP_NODELAY; return 1;
    case SY_SO_KEEPALIVE: *name = SO_KEEPALIVE; return 1;
    case SY_SO_RCVBUF: *name = SO_RCVBUF; return 1;
    case SY_SO_SNDBUF: *name = SO_SNDBUF; return 1;
    case SY_SO_RCVTIMEO_MS: *name = SYN_SO_RCVTIMEO; *kind = 1; return 1;
    case SY_SO_SNDTIMEO_MS: *name = SYN_SO_SNDTIMEO; *kind = 1; return 1;
    case SY_SO_V6ONLY: *level = SYN_IPPROTO_IPV6; *name = SYN_IPV6_V6ONLY; return 1;
    case SY_SO_BROADCAST: *name = SYN_SO_BROADCAST; return 1;
    case SY_SO_LINGER_S: *name = SYN_SO_LINGER; *kind = 2; return 1;
    case SY_SO_ERROR: *name = SO_ERROR; return 1;
    }
    return 0;
}

/* Set a socket option from the closed SY_SO_* set. 0, -errno, or -ENOPROTOOPT. */
int sy_sockopt_set(int fd, int opt, long val) {
    int level, name, kind, v;
    if (!syn_opt(opt, &level, &name, &kind) || opt == SY_SO_ERROR) return -ENOPROTOOPT;
    if (kind == 1) {
        struct timeval tv;
        if (val < 0) return -EINVAL;
        tv.tv_sec = val / 1000; tv.tv_usec = (val % 1000) * 1000;
        return setsockopt(fd, level, name, &tv, sizeof tv) == 0 ? 0 : -errno;
    }
    if (kind == 2) {
        struct syn_linger l;
        l.l_onoff = val >= 0; l.l_linger = val >= 0 ? (int)val : 0;
        return setsockopt(fd, level, name, &l, sizeof l) == 0 ? 0 : -errno;
    }
    v = (int)val;
    return setsockopt(fd, level, name, &v, sizeof v) == 0 ? 0 : -errno;
}

/* Read a socket option (also SY_SO_ERROR). 0 with *VAL, -errno, or -ENOPROTOOPT. Linger: -1 when off. */
int sy_sockopt_get(int fd, int opt, long *val) {
    int level, name, kind, v = 0;
    if (!val) return -EINVAL;
    if (!syn_opt(opt, &level, &name, &kind)) return -ENOPROTOOPT;
    if (kind == 1) {
        struct timeval tv;
        socklen_t n = sizeof tv;
        if (getsockopt(fd, level, name, &tv, &n) != 0) return -errno;
        *val = (long)tv.tv_sec * 1000 + (long)(tv.tv_usec / 1000);
        return 0;
    }
    if (kind == 2) {
        struct syn_linger l;
        socklen_t n = sizeof l;
        if (getsockopt(fd, level, name, &l, &n) != 0) return -errno;
        *val = l.l_onoff ? (long)l.l_linger : -1;
        return 0;
    } else {
        socklen_t n = sizeof v;
        if (getsockopt(fd, level, name, &v, &n) != 0) return -errno;
        *val = (long)v;
    }
    return 0;
}

/* Bind a UDP socket to A. The fd, or -errno. */
int sy_udp_bind(const sy_addr_t *a) {
    if (!a || a->family == SY_AF_UNIX) return a ? -EAFNOSUPPORT : -EINVAL;
    return syn_bound(a, SOCK_DGRAM, 0);
}

/* Send one datagram of N bytes to TO. Bytes sent, or -errno (-EMSGSIZE). */
long sy_udp_send_to(int fd, const void *buf, long n, const sy_addr_t *to) {
    struct sockaddr_storage ss;
    int len;
    ssize_t k;
    if (n < 0 || (n > 0 && !buf)) return -EINVAL;
    len = syn_tosa(to, &ss);
    if (len < 0) return len;
    do k = sendto(fd, buf, (size_t)n, MSG_NOSIGNAL, (struct sockaddr *)&ss, (socklen_t)len);
    while (k < 0 && errno == EINTR);
    return k < 0 ? -errno : (long)k;
}

/* Receive one datagram within MS (negative: forever). Bytes, -ETIMEDOUT, -errno, or -EMSGSIZE when it is longer than N (never silently cut). FROM may be NULL. */
long sy_udp_recv_from(int fd, void *buf, long n, sy_addr_t *from, long ms) {
    struct sockaddr_storage ss;
    socklen_t sl = sizeof ss;
    struct iovec iv;
    struct msghdr mh;
    ssize_t k;
    int r;
    if (n < 0 || (n > 0 && !buf)) return -EINVAL;
    r = sy_readable(fd, ms);
    if (r < 0) return r;
    if (r == 0) return -ETIMEDOUT;
    memset(&ss, 0, sizeof ss); memset(&mh, 0, sizeof mh);
    iv.iov_base = buf; iv.iov_len = (size_t)n;
    mh.msg_name = &ss; mh.msg_namelen = sl; mh.msg_iov = &iv; mh.msg_iovlen = 1;
    do k = recvmsg(fd, &mh, 0);
    while (k < 0 && errno == EINTR);
    if (k < 0) return -errno;
    if (mh.msg_flags & SYN_MSG_TRUNC) return -EMSGSIZE;
    if (from) syn_fromsa(from, &ss);
    return (long)k;
}

/* Listen on a unix socket at PATH (not removed if present). The fd, -ENAMETOOLONG (> 107), or -errno. */
int sy_unix_listen(const char *path, int backlog) {
    sy_addr_t a;
    size_t n = 0;
    int s;
    if (!path || !path[0]) return -EINVAL;
    while (path[n]) n++;
    if (n > 107) return -ENAMETOOLONG;
    memset(&a, 0, sizeof a);
    a.family = SY_AF_UNIX;
    mm_copy(a.path, sizeof a.path - 1, path, (long)n);
    s = syn_bound(&a, SOCK_STREAM, 0);
    if (s < 0) return s;
    if (listen(s, backlog > 0 ? backlog : 8) != 0) { int e = errno; close(s); return -e; }
    return s;
}

/* Connect to the unix socket at PATH within MS (negative: none). The fd, or -errno. */
int sy_unix_connect(const char *path, long ms) {
    sy_addr_t a;
    size_t n = 0;
    if (!path || !path[0]) return -EINVAL;
    while (path[n]) n++;
    if (n > 107) return -ENAMETOOLONG;
    memset(&a, 0, sizeof a);
    a.family = SY_AF_UNIX;
    mm_copy(a.path, sizeof a.path - 1, path, (long)n);
    return syn_dial_ms(&a, ms);
}
