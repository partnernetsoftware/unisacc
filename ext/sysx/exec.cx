/* exec.cx -- np_exec: capture both streams of a child with a byte bound (build/std-surface.tsv ext.procx).
 *
 * Contract (prd_cx.md 10.8, unchanged):
 *   int np_exec(const sy_spawn_t *o, mg_buf *out, mg_buf *err, int64_t cap, sy_exit_t *st);
 *   - out/err are initialized by the caller (mg_init), only appended to, never freed or taken here.
 *   - err == 0: stderr is merged into out. cap is the per-stream bound on newly appended bytes.
 *   - 0 and *st filled; a deadline (o->deadline_ms, own clock) gives 0 with st->timed_out = 1
 *     (SIGTERM, a grace period, then SIGKILL); a stream over cap gives -EMSGSIZE with exactly cap
 *     bytes appended. Every exit after a successful spawn waits before closing the fds.
 *   - Known edge: a grandchild holding the pipe write end keeps an untimed call waiting for EOF.
 *
 * The work is cx/sys/proc.cx's sy_proc_capture (the L0 entity, plans/v0.0.94.md 七).  This unit is a
 * thin wrapper: it adapts the older call shape (mg_buf pointers, int64_t cap, a deadline reported as
 * 0 + st->timed_out) to sy_capture_t and the -ETIMEDOUT return, and nothing else.  Platform
 * differences stay in the sy_* layer; nothing here is conditional. */
#pragma unisa module exec
#pragma unisa use sys.proc
#pragma unisa use mem.grow

int np_exec(const sy_spawn_t *o, mg_buf *out, mg_buf *err, int64_t cap, sy_exit_t *st) {
    sy_capture_t c;
    int r;
    if (!o || !out || !st || cap < 0) return -EINVAL;
    c.out = *out;
    c.err = err ? *err : (mg_buf){0, 0, 0};
    c.split = err != 0;
    r = sy_proc_capture(o, st, &c, (long)cap);
    *out = c.out;
    if (err) *err = c.err;
    if (r == -ETIMEDOUT) { st->timed_out = 1; return 0; }
    return r;
}
