#pragma unisa module process_group_osx
/* Explicit Darwin setpgid provider for independently linked units.
 * XNU bsd/kern/syscalls.master assigns setpgid syscall 82. */
#if !defined(__APPLE__) || (!defined(__x86_64__) && !defined(__aarch64__))
#error process_group_osx_requires_darwin_x86_64_or_arm64
#endif
int setpgid(int pid,int pgid) {
#if defined(__x86_64__)
    long result=__syscall6(0x2000052L,(long)pid,(long)pgid,0,0,0);
#else
    long result=__syscall6(82,(long)pid,(long)pgid,0,0,0);
#endif
    if(result<0){errno=(int)-result;return -1;}
    return (int)result;
}
