/* Compatibility facade. Capture logic and types live only in processcore.
 * Do not import this facade together with cxlib.netpack: module re-export
 * and merging identical public facade symbols are not implemented. */
#pragma unisa module process
#pragma unisa dock
#pragma unisa use sysx.processcore
#pragma unisa use sysx.reaper
void np_free(np_result *r) { pc_free(r); }
int np_run(char *const argv[], const char *cwd, char *const envadd[], int secs, np_result *res, char *why, size_t wl) { return pc_run(argv,cwd,envadd,secs,res,why,wl,0); }

/* Process capture and buffers have one identity; netpack imports this module. */
int sy_kill_tree(int root, int deadline_ms, const int *keep, int nkeep, char *rep, int cap) {
    return rp_kill_tree(root, deadline_ms, keep, nkeep, rep, cap);
}
int sy_child_subreaper(void) { return rp_subreaper(); }

/* Online CPU count for a caller choosing a default parallelism (0 cores make every default job count wrong).
   /sys is the portable-of-Linux source here; -1 elsewhere, so the caller can pick its own fallback. */
static int np_ncpu_os(void) {
#if defined(__linux__)
    DIR *d = opendir("/sys/devices/system/cpu");
    struct dirent *e; int n = 0;
    if (!d) return -1;
    while ((e = readdir(d)) != 0) {
        if (!strncmp(e->d_name, "cpu", 3) && e->d_name[3] >= '0' && e->d_name[3] <= '9') n++;
    }
    closedir(d);
    return n > 0 ? n : -1;
#else
    return -1;
#endif
}
int sy_ncpu(void) { return np_ncpu_os(); }
