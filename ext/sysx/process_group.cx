#pragma unisa module process_group
/* Explicit native provider, no host-library forwarding. Linux x86_64/arm64.
 * Stateless syscall adapter: no retained ownership and no compiler globals. */
#if !defined(__linux__) || (!defined(__x86_64__) && !defined(__aarch64__))
#error process_group_native_provider_requires_linux_x86_64_or_arm64
#endif
int setpgid(int pid,int pgid) {
#if defined(__aarch64__)
    long result=__syscall6(154,(long)pid,(long)pgid,0,0,0);
#else
    long result=__syscall6(109,(long)pid,(long)pgid,0,0,0);
#endif
    if(result<0){errno=(int)-result;return -1;}
    return (int)result;
}
