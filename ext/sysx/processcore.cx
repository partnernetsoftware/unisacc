/* Native process capture module. Extracted from netpack's existing process
 * contract: np_run/np_free are the public capture operations; sy_kill_tree and
 * sy_child_subreaper are the public cleanup operations (see the reaper below).
 * Buffers and error rendering remain module-private; returned output belongs to
 * the caller. */
#pragma unisa module processcore
#pragma unisa dock
#pragma unisa use sysx.reaper
#pragma unisa use sys.time
#pragma unisa use sys.proc
#pragma unisa use sys.posix
#pragma unisa use text.fmt
typedef struct np_buf { char *p; size_t n, cap; } np_buf;
typedef struct np_result { int rc; char *out; size_t outn; char *err; size_t errn; int residue; int timed_out; } np_result;


static void np_put(np_buf *b, const char *s, size_t n) {
    if (b->n + n + 1 > b->cap) {
        size_t c = b->cap ? b->cap : 256; char *g;
        while (c < b->n + n + 1) c *= 2;
        g = realloc(b->p, c);
        if (!g) { fputs("MemoryError\n", stderr); exit(1); }
        b->p = g; b->cap = c;
    }
    if (n) { void *cx_kept = memcpy(b->p + b->n, s, n); (void)cx_kept; }
    b->n += n; b->p[b->n] = 0;
}

static void np_puts(np_buf *b, const char *s) { np_put(b, s, strlen(s)); }

static void np_oserror(int e, const char *name, char *why, size_t wl) {
    const char *cls = "OSError"; const char *msg = strerror(e);
    if (e == ENOENT) cls = "FileNotFoundError";
    else if (e == EACCES || e == EPERM) cls = "PermissionError";
    else if (e == ENOTDIR) cls = "NotADirectoryError";
    else if (e == EISDIR) cls = "IsADirectoryError";
    else if (e == EEXIST) cls = "FileExistsError";
    /* the C library text Python shows (the carried runtime lacks some of it) */
    if (e == ENOENT) msg = "No such file or directory";
    else if (e == EACCES) msg = "Permission denied";
    else if (e == EPERM) msg = "Operation not permitted";
    else if (e == ENOTDIR) msg = "Not a directory";
    else if (e == EISDIR) msg = "Is a directory";
    else if (e == EEXIST) msg = "File exists";
    if (name) snprintf(why, wl, "%s: [Errno %d] %s: '%s'", cls, e, msg, name);
    else snprintf(why, wl, "%s: [Errno %d] %s", cls, e, msg);
}


void pc_free(np_result *r) { free(r->out); free(r->err); r->out = r->err = 0; r->outn = r->errn = 0; r->residue = 0; r->timed_out = 0; }
/* Retain the tool-side residue fault contract when sharing the process primitive. */
static int np_fault(void) {
    const char *v = getenv("UNISACC_NP_FAULT");
    if (!v || !*v) return 0;
    return !strcmp(v,"residue") ? 1 : -1;
}
/* Reap only this child, including after asynchronous SIGKILL. */
static int np_reap_killed(pid_t pid, int *st) {
    for (int i=0;i<2000;i++) {
        int w=waitpid(pid,st,WNOHANG);
        if(w==pid || (w<0 && errno==ECHILD)) return 0;
        if(w<0 && errno!=EINTR) return -1;
        usleep(1000);
    }
    return -1;
}
static int pc_cgroup_dir_for_pid(pid_t pid, char *out, size_t cap) {
    char cp[64], buf[512];
    if (cx_fmt(cp, sizeof cp, "/proc/%d/cgroup", (int)pid)) return -1;
    int fd = open(cp, O_RDONLY);
    if (fd < 0) return -1;
    ssize_t n = read(fd, buf, sizeof buf - 1);
    close(fd);
    if (n <= 0) return -1;
    buf[n] = 0;
    const char *p = strstr(buf, "0::");
    if (!p) return -1;
    p += 3;
    const char *e = p;
    while (*e && *e != '\n' && *e != '\r') e++;
    if (e <= p) return -1;
    return cx_fmt(out, cap, "/sys/fs/cgroup%.*s", (int)(e - p), p) == 0 ? 0 : -1;
}

static long pc_read_pids_events_fd(int fd) {
    char buf[512];
    if (fd < 0) return -1;
    if (lseek(fd, 0, SEEK_SET) < 0) return -1;
    ssize_t n = read(fd, buf, sizeof buf - 1);
    if (n <= 0) return -1;
    buf[n] = 0;
    const char *p = strstr(buf, "max ");
    if (!p) return -1;
    p += 4;
    long v = 0;
    int any = 0;
    while (*p >= '0' && *p <= '9') { v = v * 10 + (*p - '0'); p++; any = 1; }
    return any ? v : -1;
}

static long pc_read_pids_events_max(const char *ev_path) {
    int fd = open(ev_path, O_RDONLY);
    if (fd < 0) return -1;
    long v = pc_read_pids_events_fd(fd);
    close(fd);
    return v;
}

/* Returns >=0 count of live pids in cgroup.procs (0 if ENOENT = scope already gone),
 * or -1 on any read/open error other than ENOENT (never silently treated as 0). */
static int pc_cgroup_procs_count(const char *procs_path) {
    char buf[4096];
    errno = 0;
    int fd = open(procs_path, O_RDONLY);
    if (fd < 0) return (errno == ENOENT) ? 0 : -1;
    ssize_t n = read(fd, buf, sizeof buf - 1);
    int rerr = errno;
    close(fd);
    if (n < 0) return (rerr == ENOENT) ? 0 : -1;
    if (n == 0) return 0;
    int cnt = 0;
    for (ssize_t i = 0; i < n; i++) if (buf[i] == '\n') cnt++;
    return cnt;
}

static const char *pc_find_bin(const char *a, const char *b) {
    if (access(a, X_OK) == 0) return a;
    if (access(b, X_OK) == 0) return b;
    return 0;
}

/* Kill transient scope using absolute systemctl path; returns 0 on helper rc==0, -1 otherwise.
 * Always reaps helper (SIGKILL on timeout so helper never leaks). */
static int pc_kill_scope(const char *unit) {
    if (!unit || !unit[0]) return -1;
    const char *sc = pc_find_bin("/usr/bin/systemctl", "/bin/systemctl");
    if (!sc) return -1;
    pid_t kp = fork();
    if (kp < 0) return -1;
    if (kp == 0) {
        int dn = open("/dev/null", O_WRONLY);
        if (dn >= 0) { dup2(dn, 1); dup2(dn, 2); close(dn); }
        execl(sc, "systemctl", "--user", "kill", "-s", "KILL", unit, (char *)0);
        _exit(127);
    }
    int st = 0, reaped = 0;
    for (int i = 0; i < 100; i++) {
        if (waitpid(kp, &st, WNOHANG) == kp) { reaped = 1; break; }
        usleep(10000);
    }
    if (!reaped) {
        kill(kp, SIGKILL);
        for (int i = 0; i < 50; i++) {
            if (waitpid(kp, &st, WNOHANG) == kp) { reaped = 1; break; }
            usleep(10000);
        }
        return -1;
    }
    return (WIFEXITED(st) && WEXITSTATUS(st) == 0) ? 0 : -1;
}

static int pc_rand_hex16(char out[17]) {
    unsigned char raw[8];
    int fd = open("/dev/urandom", O_RDONLY);
    if (fd < 0) return -1;
    ssize_t n = read(fd, raw, sizeof raw);
    close(fd);
    if (n != (ssize_t)sizeof raw) return -1;
    static const char hx[] = "0123456789abcdef";
    for (int i = 0; i < 8; i++) {
        out[i * 2] = hx[(raw[i] >> 4) & 0xf];
        out[i * 2 + 1] = hx[raw[i] & 0xf];
    }
    out[16] = 0;
    return 0;
}

static const char *pc_systemd_run_path(void) {
    const char *sr = pc_find_bin("/usr/bin/systemd-run", "/bin/systemd-run");
    if (!sr) return 0;
    char bus[128];
    if (cx_fmt(bus, sizeof bus, "/run/user/%u/bus", (unsigned)getuid())) return 0;
    return access(bus, F_OK) == 0 ? sr : 0;
}

int pc_run_capped(char *const argv[], const char *cwd, char *const envadd[], int secs, int max_procs, np_result *res, char *why, size_t wl, int tool_fault) {
    int po[2], pe[2], pf[2], err[2] = { 0, 0 }, st = 0, open_o = 1, open_e = 1, open_f = 1, reaped = 0;
    size_t errn = 0;
    pid_t pid; ssize_t k; long now = sy_now_ms(), deadline, next_cap_check = 0; np_buf o = { 0, 0, 0 }, e = { 0, 0, 0 }; char t[65536];
    int fault=tool_fault?np_fault():0;
    int use_cgroup = 0, scope_observed = 0, ev_fd = -1;
    const char *sr_bin = 0;
    char unit[96], tmax[32], ev_path[256], procs_path[256], rtok[17];
    long seen_events_max = -1;
    unit[0] = 0; tmax[0] = 0; ev_path[0] = 0; procs_path[0] = 0; rtok[0] = 0;
    res->rc = 0; res->out = res->err = 0; res->outn = res->errn = 0; res->residue = 0; res->timed_out = 0;
    if (fault<0) { snprintf(why,wl,"ValueError: UNISACC_NP_FAULT=%s refused (only residue)",getenv("UNISACC_NP_FAULT")); return -1; }
    if (now < 0) { snprintf(why, wl, "OSError: cannot read monotonic clock"); return -1; }
    if (max_procs > 0 && (sr_bin = pc_systemd_run_path()) != 0) {
        if (pc_rand_hex16(rtok) != 0) {
            (void)cx_fmt(why, wl, "cgroup-scope-start-failed: urandom unavailable");
            return -1;
        }
        unsigned uid = (unsigned)getuid();
        if (!cx_fmt(unit, sizeof unit, "unisacc-s1b-%d-%s.scope", (int)getpid(), rtok) &&
            !cx_fmt(tmax, sizeof tmax, "TasksMax=%d", max_procs) &&
            !cx_fmt(ev_path, sizeof ev_path, "/sys/fs/cgroup/user.slice/user-%u.slice/user@%u.service/app.slice/%s/pids.events", uid, uid, unit) &&
            !cx_fmt(procs_path, sizeof procs_path, "/sys/fs/cgroup/user.slice/user-%u.slice/user@%u.service/app.slice/%s/cgroup.procs", uid, uid, unit)) {
            use_cgroup = 1;
        } else {
            (void)cx_fmt(why, wl, "cgroup-scope-start-failed: path format overflow");
            return -1;
        }
    }
    deadline = now + (long)secs * 1000;
    next_cap_check = now + 20;
    if (pipe(po) || pipe(pe) || pipe(pf)) { snprintf(why, wl, "OSError: cannot create pipes"); return -1; }
    fcntl(pf[1], F_SETFD, FD_CLOEXEC);
    pid = fork();
    if (pid < 0) { snprintf(why, wl, "OSError: fork failed"); return -1; }
    if (pid == 0) {
        sy_setpgid(0, 0);   /* own process group: a timeout kills every descendant */
        close(po[0]); close(pe[0]); close(pf[0]);
        dup2(po[1], 1); dup2(pe[1], 2); close(po[1]); close(pe[1]);
        if (envadd && envadd[0]) {
            /* dict(os.environ, K=V): rebuilt in environ itself (the runtime's setenv() does not reach execvp) */
            size_t n = 0, a = 0, x, y; char **ne, **v;
            for (v = environ; *v; v++) n++;
            while (envadd[a]) a++;
            ne = malloc((n + a + 1) * sizeof *ne);
            if (!ne) _exit(255);
            for (x = 0, v = environ; *v; v++) {
                int keep = 1;
                for (y = 0; y < a; y++) {
                    size_t l = strcspn(envadd[y], "=");
                    if (!strncmp(*v, envadd[y], l) && (*v)[l] == '=') keep = 0;
                }
                if (keep) ne[x++] = *v;
            }
            for (y = 0; y < a; y++) ne[x++] = envadd[y];
            ne[x] = 0;
            environ = ne;
        }
        /* Bounded regression seam: only the child waits, with the exec pipe open. */
        { const char *delay = getenv("UNISACC_NP_TEST_PREEXEC_MS"); if (delay) { int ms = atoi(delay); if (ms > 0 && ms <= 5000) usleep((unsigned)ms * 1000); } }
        if (cwd && chdir(cwd) != 0) { err[0] = 1; err[1] = errno; k = write(pf[1], err, sizeof err); _exit(255); }
        if (use_cgroup) {
            /* Preserve exact ENOENT/EACCES target semantics before entering systemd-run. */
            if (argv[0] && strchr(argv[0], '/')) {
                if (access(argv[0], X_OK) != 0) {
                    err[0] = 2; err[1] = errno; k = write(pf[1], err, sizeof err); (void)k;
                    _exit(255);
                }
            }
            size_t argc_in = 0;
            while (argv[argc_in]) argc_in++;
            char **sv = malloc((argc_in + 12) * sizeof *sv);
            char uflag[112];
            if (!sv || cx_fmt(uflag, sizeof uflag, "--unit=%s", unit) != 0) {
                err[0] = 3; err[1] = ENOMEM; k = write(pf[1], err, sizeof err); (void)k;
                _exit(255);
            }
            size_t si = 0;
            sv[si++] = (char *)sr_bin;
            sv[si++] = "--user";
            sv[si++] = "--scope";
            sv[si++] = "--quiet";
            sv[si++] = uflag;
            sv[si++] = "-p";
            sv[si++] = tmax;
            sv[si++] = "-p";
            sv[si++] = "CollectMode=inactive-or-failed";
            sv[si++] = "--";
            for (size_t j = 0; j < argc_in; j++) sv[si++] = argv[j];
            sv[si] = 0;
            /* Use absolute sr_bin (never PATH-dependent) and NEVER fall back to bare execvp on failure. */
            execv(sr_bin, sv);
            err[0] = 3; err[1] = errno; k = write(pf[1], err, sizeof err); (void)k;
            _exit(255);
        }
        execvp(argv[0], argv);
        err[0] = 2; err[1] = errno; k = write(pf[1], err, sizeof err); (void)k;
        _exit(255);
    }
    sy_setpgid(pid, pid);   /* also from the parent, so the group exists before any kill */
    close(po[1]); close(pe[1]); close(pf[1]);
    fcntl(pf[0], F_SETFL, O_NONBLOCK);
    fcntl(po[0], F_SETFL, O_NONBLOCK); fcntl(pe[0], F_SETFL, O_NONBLOCK);
    np_put(&o, "", 0); np_put(&e, "", 0);
    while (open_o || open_e || open_f || !reaped) {
        if (open_f) {
            k = read(pf[0], (char *)err + errn, sizeof err - errn);
            if (k > 0) errn += (size_t)k;
            if (errn == sizeof err || k == 0 || (k < 0 && errno != EAGAIN && errno != EINTR)) {
                close(pf[0]); open_f = 0;
            }
        }
        int got = 0;
        if (open_o) { k = read(po[0], t, sizeof t); if (k > 0) { np_put(&o, t, (size_t)k); got = 1; } else if (k == 0 || (errno != EAGAIN && errno != EINTR)) { open_o = 0; close(po[0]); } }
        if (open_e) { k = read(pe[0], t, sizeof t); if (k > 0) { np_put(&e, t, (size_t)k); got = 1; } else if (k == 0 || (errno != EAGAIN && errno != EINTR)) { open_e = 0; close(pe[0]); } }
        if (!reaped) {
            int w = waitpid(pid, &st, WNOHANG);
            if (w == pid) reaped = 1;
        }
        if (!open_o && !open_e && !open_f && reaped) break;
        /* EOF never changes the waiting path: process exit and pipe draining
           share the same monotonic deadline, including the exec handshake. */
        now = sy_now_ms();
        if (max_procs > 0 && !reaped) {
            if (use_cgroup) {
                char cgdir[256];
                if (!scope_observed && pc_cgroup_dir_for_pid(pid, cgdir, sizeof cgdir) == 0 && strstr(cgdir, unit)) {
                    scope_observed = 1;
                    (void)cx_fmt(ev_path, sizeof ev_path, "%s/pids.events", cgdir);
                    (void)cx_fmt(procs_path, sizeof procs_path, "%s/cgroup.procs", cgdir);
                    if (ev_fd < 0) ev_fd = open(ev_path, O_RDONLY);
                }
            }
            long evm = -1;
            if (use_cgroup && scope_observed) {
                evm = (ev_fd >= 0) ? pc_read_pids_events_fd(ev_fd) : pc_read_pids_events_max(ev_path);
                if (evm > seen_events_max) seen_events_max = evm;
            }
            int nproc = (!use_cgroup && now >= next_cap_check) ? (next_cap_check = now + 10, rp_count_tree((int)pid)) : 0;
            if ((use_cgroup && evm > 0) || (!use_cgroup && nproc > max_procs)) {
                char rep[256];
                rep[0] = 0;
                int krc = 0;
                if (use_cgroup && scope_observed) krc = pc_kill_scope(unit);
                int sv = rp_kill_tree((int)pid, 2000, 0, 0, rep, sizeof rep);
                if (sv < 0) { kill(-pid, SIGKILL); kill(pid, SIGKILL); sv = 0; }
                if (use_cgroup && scope_observed) {
                    int cg_left = pc_cgroup_procs_count(procs_path);
                    if (cg_left != 0) {
                        (void)pc_kill_scope(unit);
                        usleep(50000);
                        cg_left = pc_cgroup_procs_count(procs_path);
                    }
                    if (cg_left < 0) sv = (sv > 0) ? sv : 1;
                    else if (cg_left > sv) sv = cg_left;
                    (void)krc;
                }
                res->residue = sv;
                if (!reaped && np_reap_killed(pid, &st) < 0 && res->residue <= 0) {
                    res->residue = 1;
                    sv = 1;
                }
                if (ev_fd >= 0) { close(ev_fd); ev_fd = -1; }
                if (open_o) close(po[0]);
                if (open_e) close(pe[0]);
                if (open_f) close(pf[0]);
                free(o.p); free(e.p);
                if (use_cgroup)
                    (void)cx_fmt(why, wl, "process-cap-exceeded: mode=cgroup-pids-hard cap=%d events_max=%ld residue=%d", max_procs, evm, res->residue);
                else
                    (void)cx_fmt(why, wl, "process-cap-exceeded: mode=polling-observation cap=%d observed=%d residue=%d", max_procs, nproc, res->residue);
                return -1;
            }
        }
        if (now < 0 || now >= deadline) {
            size_t i; char rep[256];
            if (use_cgroup && scope_observed) (void)pc_kill_scope(unit);
            int sv = rp_kill_tree(pid, 2000, 0, 0, rep, sizeof rep);   /* freeze, kill, re-check; -ENOSYS off /proc */
            if (sv < 0) { kill(-pid, SIGKILL); kill(pid, SIGKILL); }   /* no /proc: the pre-reaper group kill */
            if (use_cgroup && scope_observed) {
                int cg_left = pc_cgroup_procs_count(procs_path);
                if (cg_left != 0) {
                    (void)pc_kill_scope(unit);
                    usleep(50000);
                    cg_left = pc_cgroup_procs_count(procs_path);
                }
                if (cg_left < 0) sv = (sv > 0) ? sv : 1;
                else if (cg_left > sv) sv = cg_left;
            }
            res->residue = sv;
            res->timed_out = now >= deadline;
            if (fault==1) { res->residue=1; fputs("FAULT_INJECTED\tresidue\n",stderr); }
            if (!reaped && np_reap_killed(pid,&st)<0 && res->residue<=0) {
                res->residue=1; sv=1;
                int rendered=snprintf(rep,sizeof rep,"direct child not reaped"); (void)rendered;
            }
            if (ev_fd >= 0) { close(ev_fd); ev_fd = -1; }
            if (open_o) close(po[0]);
            if (open_e) close(pe[0]);
            if (open_f) close(pf[0]);
            free(o.p); free(e.p);
            if (now < 0) { snprintf(why, wl, "OSError: cannot read monotonic clock"); return -1; }
            {   np_buf l = { 0, 0, 0 };
                np_puts(&l, "subprocess.TimeoutExpired: Command '[");
                for (i = 0; argv[i]; i++) { if (i) np_puts(&l, ", "); np_puts(&l, "'"); np_puts(&l, argv[i]); np_puts(&l, "'"); }
                np_puts(&l, "]' timed out after ");
                { int cx_kept = snprintf(t, sizeof t, "%d seconds", secs); (void)cx_kept; } np_puts(&l, t);
                if (res->residue > 0) { np_puts(&l, " ("); np_puts(&l, sv>0?rep:"injected"); np_puts(&l, " survived)"); }
                snprintf(why, wl, "%s", l.p); free(l.p);
            }
            return -1;
        }
        if (!got) {
            long left = deadline - now;
            usleep((unsigned int)(left < 2 ? left : 2) * 1000);
        }
    }
    if (errn == sizeof err) {
        if (ev_fd >= 0) { close(ev_fd); ev_fd = -1; }
        free(o.p); free(e.p);
        if (err[0] == 3) {
            (void)cx_fmt(why, wl, "cgroup-scope-start-failed: errno=%d", err[1]);
        } else {
            np_oserror(err[1], err[0] == 1 ? cwd : argv[0], why, wl);
        }
        return -1;
    }
    if (use_cgroup) {
        if (scope_observed) {
            long evm = (ev_fd >= 0) ? pc_read_pids_events_fd(ev_fd) : pc_read_pids_events_max(ev_path);
            if (evm > seen_events_max) seen_events_max = evm;
            if (ev_fd >= 0) { close(ev_fd); ev_fd = -1; }
            int cg_left = pc_cgroup_procs_count(procs_path);
            if (cg_left != 0) {
                (void)pc_kill_scope(unit);
                usleep(50000);
                cg_left = pc_cgroup_procs_count(procs_path);
            }
            if (seen_events_max > 0) {
                res->residue = (cg_left < 0) ? 1 : cg_left;
                free(o.p); free(e.p);
                (void)cx_fmt(why, wl, "process-cap-exceeded: mode=cgroup-pids-hard cap=%d events_max=%ld residue=%d", max_procs, seen_events_max, res->residue);
                return -1;
            }
            if (cg_left != 0) {
                res->residue = (cg_left < 0) ? 1 : cg_left;
                free(o.p); free(e.p);
                (void)cx_fmt(why, wl, "cgroup-residue-after-exit: residue=%d", res->residue);
                return -1;
            }
        } else {
            if (ev_fd >= 0) { close(ev_fd); ev_fd = -1; }
        }
    }
    res->rc = WIFSIGNALED(st) ? -WTERMSIG(st) : WEXITSTATUS(st);
    res->out = o.p; res->outn = o.n; res->err = e.p; res->errn = e.n;
    return 0;
}
int pc_run(char *const argv[], const char *cwd, char *const envadd[], int secs, np_result *res, char *why, size_t wl, int tool_fault) {
    return pc_run_capped(argv, cwd, envadd, secs, 0, res, why, wl, tool_fault);
}

