/* sysx.run: the one bounded child-process entry for tools (prefix px_).
 *
 * px_run runs ARGV (no shell) with an optional cwd, environment additions, stdin file,
 * separate stdout/stderr caps and a total deadline in milliseconds.  The child gets its own
 * process group; past the deadline the whole tree is killed (sysx.reaper walks /proc, so a
 * grandchild that called setsid is taken too when kill_tree is 1) and reaped; code is 124.
 * Output past a cap is read and dropped (the pipe never stalls), truncated gets the bit of
 * that stream and out_total/err_total keep the full byte counts.  stderr is never swallowed:
 * it comes back in r->err (or merged into r->out with merge_err).
 *
 * px_spawn_spool is the shared form of the spawn_pipe_bounded helper tools used to copy:
 * same contract, 50 s deadline, output drained into unlinked spool files, child not reaped.
 *
 * Ownership: r->out and r->err belong to the caller and go back with px_result_free.  This is a
 * runtime convention only; a forgotten free is not found at compile time.  Only the L0 sy_ and
 * mm_ interfaces are used here: no libc, no platform #if.  Not yet: stdin from memory, wait set. */
#pragma unisa module run
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.proc
#pragma unisa use sys.time
#pragma unisa use sys.posix
#pragma unisa use sysx.poll
#pragma unisa use sysx.reaper
#pragma unisa use os.osx
#pragma unisa use mem.heap

typedef struct {
    char **argv;          /* argv[0] looked up on PATH; no shell */
    const char *cwd;      /* 0: the caller's */
    char **env_add;       /* 0 or NULL-terminated "K=V" entries that replace or extend the environment */
    const char *stdin_path;   /* 0: /dev/null; else this file is the child's stdin */
    long deadline_ms;     /* total wall deadline, > 0 */
    long out_cap, err_cap;    /* bytes kept per stream; the rest is read and dropped */
    int merge_err;        /* 1: stderr goes into out */
    int kill_tree;        /* 1: on timeout kill every descendant (by /proc), not only the group */
} px_opts;

enum { PX_TRUNC_OUT = 1, PX_TRUNC_ERR = 2 };

typedef struct {
    int code;             /* sy_exit_code view: exit code, 128+sig, 124 on timeout */
    int timed_out;
    int sig;
    int truncated;        /* PX_TRUNC_OUT | PX_TRUNC_ERR */
    int residue;          /* processes the tree kill reported as surviving, or -errno */
    long wall_ms;
    char *out; long outn; long out_total;
    char *err; long errn; long err_total;
} px_result;

void px_opts_init(px_opts *o) {
    if (!o) return;
    o->argv = 0; o->cwd = 0; o->env_add = 0; o->stdin_path = 0;
    o->deadline_ms = 55000; o->out_cap = 16L << 20; o->err_cap = 16L << 20;
    o->merge_err = 0; o->kill_tree = 1;
}

void px_result_free(px_result *r) {
    if (!r) return;
    if (r->out) mm_free(r->out);
    if (r->err) mm_free(r->err);
    r->out = r->err = 0; r->outn = r->errn = 0;
}

static int px_keylen(const char *s) { int n = 0; while (s[n] && s[n] != '=') n++; return n; }

static int px_samekey(const char *a, const char *b, int n) {
    int i;
    for (i = 0; i < n; i++) if (a[i] != b[i]) return 0;
    return b[n] == '=';
}

/* environ with ADD applied (later entries win), a fresh pointer vector; the strings are borrowed */
static char **px_env_merge(char **add) {
    char **base = sy_env_vec(), **v;
    long nb = 0, na = 0, x = 0, i, j;
    if (base) while (base[nb]) nb++;
    while (add[na]) na++;
    v = (char **)mm_alloc((nb + na + 1) * (long)sizeof(char *));
    if (!v) return 0;
    for (i = 0; i < nb; i++) {
        int keep = 1;
        for (j = 0; j < na && keep; j++) if (px_samekey(add[j], base[i], px_keylen(add[j]))) keep = 0;
        if (keep) v[x++] = base[i];
    }
    for (j = 0; j < na; j++) v[x++] = add[j];
    v[x] = 0;
    return v;
}

static int px_put(char **p, long *n, long *capb, long cap, const char *s, long k, int *trunc, int bit) {
    long room = cap - *n;
    if (k > room) { *trunc |= bit; k = room < 0 ? 0 : room; }
    if (*n + k + 1 > *capb) {
        long c = *capb ? *capb : 4096;
        char *g;
        while (c < *n + k + 1) c *= 2;
        g = (char *)mm_grow(*p, c);
        if (!g) return -ENOMEM;
        *p = g; *capb = c;
    }
    { long i; for (i = 0; i < k; i++) (*p)[*n + i] = s[i]; }
    *n += k; (*p)[*n] = 0;
    return 0;
}

static void px_kill(sy_child_t *c, int tree, px_result *r) {
    char rep[256];
    int sv = -1;
    if (tree) sv = rp_kill_tree(c->pid, 2000, 0, 0, rep, (int)sizeof rep);
    if (sv < 0) sy_proc_kill(c, 9);
    r->residue = sv;
}

/* 0 when the child ran and was reaped (*R filled, code 124 on timeout), or -errno with nothing
   left running or open: -EINVAL bad options, -ENOENT no such program / cwd / stdin file. */
int px_run(const px_opts *o, px_result *r) {
    sy_spawn_t sp;
    sy_child_t c;
    sy_exit_t st;
    char **env = 0;
    char chunk[16384];
    long t0, deadline, ocap = 0, ecap = 0;
    int infd = -1, rc, open_o, open_e, timed = 0, dummy = 0;
    if (!o || !r || !o->argv || !o->argv[0] || o->deadline_ms <= 0 || o->out_cap < 0 || o->err_cap < 0) return -EINVAL;
    r->code = 0; r->timed_out = 0; r->sig = 0; r->truncated = 0; r->residue = 0; r->wall_ms = 0;
    r->out = r->err = 0; r->outn = r->errn = r->out_total = r->err_total = 0;
    t0 = sy_now_ms();
    if (t0 < 0) return -EIO;
    deadline = t0 + o->deadline_ms;
    if (o->stdin_path) { infd = sy_open_read(o->stdin_path); if (infd < 0) return infd; sy_fd_nonblock(infd, 0); }
    if (o->env_add && o->env_add[0]) {
        env = px_env_merge(o->env_add);
        if (!env) { if (infd >= 0) sy_close(infd); return -ENOMEM; }
    }
    sy_spawn_init(&sp);
    sp.argv = o->argv; sp.env = env; sp.cwd = o->cwd;
    sp.in_fd = infd >= 0 ? infd : SY_STDIO_NULL;
    sp.out_fd = SY_STDIO_PIPE;
    sp.err_fd = SY_STDIO_PIPE;
    if (o->merge_err) sp.flags |= SY_SPAWN_ERR_TO_OUT;
    sp.pgroup = -1;
    rc = sy_proc_spawn(&sp, &c);
    if (env) mm_free(env);
    if (infd >= 0) sy_close(infd);
    if (rc < 0) return rc;
    open_o = c.out_fd >= 0; open_e = c.err_fd >= 0;
    while (open_o || open_e) {
        sy_pollfd_t p[2];
        int n = 0, io = -1, ie = -1, k;
        long left = deadline - sy_now_ms(), g;
        if (left <= 0) { timed = 1; break; }
        if (open_o) { io = n; p[n].fd = c.out_fd; p[n].events = SY_POLLIN; p[n].revents = 0; n++; }
        if (open_e) { ie = n; p[n].fd = c.err_fd; p[n].events = SY_POLLIN; p[n].revents = 0; n++; }
        k = sy_poll(p, n, left > 200 ? 200 : left);
        if (k < 0) continue;
        if (io >= 0 && p[io].revents) {
            g = sy_read(c.out_fd, chunk, (long)sizeof chunk);
            if (g > 0) {
                r->out_total += g;
                if (px_put(&r->out, &r->outn, &ocap, o->out_cap, chunk, g, &r->truncated, PX_TRUNC_OUT)) { timed = -1; break; }
            } else open_o = 0;
        }
        if (ie >= 0 && p[ie].revents) {
            g = sy_read(c.err_fd, chunk, (long)sizeof chunk);
            if (g > 0) {
                r->err_total += g;
                if (px_put(&r->err, &r->errn, &ecap, o->err_cap, chunk, g, &r->truncated, PX_TRUNC_ERR)) { timed = -1; break; }
            } else open_e = 0;
        }
    }
    if (!timed) {
        for (;;) {
            long now = sy_now_ms();
            int w = sy_proc_try_wait(&c, &st);
            if (w == 1) break;
            if (w < 0) { timed = -1; break; }
            if (now >= deadline) { timed = 1; break; }
            sy_sleep_ms(deadline - now < 5 ? deadline - now : 5);
        }
    }
    if (timed) {
        px_kill(&c, o->kill_tree, r);
        while (sy_proc_try_wait(&c, &st) == 0) sy_sleep_ms(2);
        if (timed > 0) st.timed_out = 1;
    }
    sy_proc_close(&c);
    if (timed < 0) { px_result_free(r); return -ENOMEM; }
    r->timed_out = st.timed_out;
    r->sig = st.sig;
    r->code = sy_exit_code(&st);
    if (!r->out && px_put(&r->out, &r->outn, &ocap, 0, "", 0, &dummy, 0)) { px_result_free(r); return -ENOMEM; }
    if (!r->err && px_put(&r->err, &r->errn, &ecap, 0, "", 0, &dummy, 0)) { px_result_free(r); return -ENOMEM; }
    r->wall_ms = sy_now_ms() - t0;
    return 0;
}

/* an unlinked spool file the drained output of a bounded child goes to: the write end comes back,
   *RD is a second descriptor opened for reading (at offset 0) before the unlink */
static int px_spool_open(int *rd) {
    char t[4096];
    int fd = sy_mkstemp(sy_tmpdir(), "r2b-", t, (int)sizeof t);
    *rd = -1;
    if (fd < 0) return fd;
    *rd = sy_open_read(t);
    sy_unlink(t);
    if (*rd < 0) { sy_close(fd); return -EIO; }
    return fd;
}

/* sy_spawn_pipe with a 50 s deadline: the child's stdout (and stderr when EFD is given) is drained here with
   sy_poll into spool files; past the deadline its process group is killed.  OFD/EFD come back as the spool
   files, rewound, and the child is NOT reaped: the caller's sy_wait_status(pid) still reports its real status
   (128+9 when killed).  The pid, or -errno. */
int px_spawn_spool(char **argv, const char *cwd, int flags, int *ofd, int *efd) {
    int po = -1, pe = -1, pid, fo, fe = -1, ro = -1, re = -1, open_o = 1, open_e = efd ? 1 : 0, killed = 0;
    long deadline = sy_now_ms() + 50000;
    char chunk[16384];
    pid = sy_spawn_pipe(argv, cwd, flags, &po, efd ? &pe : 0);
    if (pid < 0) return pid;
    fo = px_spool_open(&ro);
    if (efd) fe = px_spool_open(&re);
    if (fo < 0 || (efd && fe < 0)) {
        sy_killpg(pid, 9); sy_signal(pid, 9); sy_close(po); if (efd) sy_close(pe);
        if (fo >= 0) { sy_close(fo); sy_close(ro); }
        if (fe >= 0) { sy_close(fe); sy_close(re); }
        return -EIO;
    }
    while (open_o || open_e) {
        sy_pollfd_t p[2];
        int n = 0, io = -1, ie = -1, r;
        long left = deadline - sy_now_ms(), g;
        if (left <= 0) {
            if (killed) break;
            sy_killpg(pid, 9); sy_signal(pid, 9); killed = 1; deadline = sy_now_ms() + 2000;
            continue;
        }
        if (open_o) { io = n; p[n].fd = po; p[n].events = SY_POLLIN; p[n].revents = 0; n++; }
        if (open_e) { ie = n; p[n].fd = pe; p[n].events = SY_POLLIN; p[n].revents = 0; n++; }
        r = sy_poll(p, n, left > 200 ? 200 : left);
        if (r < 0) break;
        if (io >= 0 && p[io].revents) {
            g = sy_read(po, chunk, (long)sizeof chunk);
            if (g > 0) { if (sy_write_all(fo, chunk, g)) break; } else open_o = 0;
        }
        if (ie >= 0 && p[ie].revents) {
            g = sy_read(pe, chunk, (long)sizeof chunk);
            if (g > 0) { if (sy_write_all(fe, chunk, g)) break; } else open_e = 0;
        }
    }
    if (open_o || open_e) { sy_killpg(pid, 9); sy_signal(pid, 9); }
    sy_close(po);
    if (efd) sy_close(pe);
    sy_close(fo);
    *ofd = ro;
    if (efd) { sy_close(fe); *efd = re; }
    return pid;
}
