#pragma unisa module tcp
#pragma unisa dock
#pragma unisa use addr
#pragma unisa use sys.netraw
#pragma unisa use sys.netpoll
#pragma unisa use sys.netnb
#pragma unisa use resolve
#pragma unisa use sys.fs
#pragma unisa use sys.time
/* ext.net blocking TCP subset on cx.sys netraw (build/std-surface.tsv ext.net): sy_tcp_listen,
   sy_tcp_listen_at, sy_tcp_port, sy_tcp_connect, sy_send, sy_send_all, sy_recv.  No libc, no #if.
   Deadline connect_to/dial are here (dial resolves numeric or localhost only); DNS is not done.
   A program uses this unit or ext/sysx/net.cx, not both.  Linux x86_64/arm64 only: on osx/win
// ENOSYS: refusal contract documented in this comment
   the netraw calls are -ENOSYS and so are these.
   Descriptors are closed with sy_close. */
enum { SY_LISTEN_REUSEADDR = 1, SY_LISTEN_V6ONLY = 2 };

/* sy_addr_t into a socket-address buffer; the byte length or -errno. */
static int syt_sa(const sy_addr_t *a, unsigned char *sa, int cap) {
    if (!a) return -EINVAL;
    if (a->family == SY_AF_INET4) return sy_sa_inet4(sa, cap, a->ip, a->port);
    if (a->family == SY_AF_INET6) return sy_sa_inet6(sa, cap, a->ip, a->port, a->scope);
    if (a->family == SY_AF_UNIX) return sy_sa_unix(sa, cap, a->path);
    return -EAFNOSUPPORT;
}

static int syt_open(int family) {
    long af = family == SY_AF_INET6 ? sy_sock_num(SY_SN_AF_INET6)
            : family == SY_AF_UNIX ? sy_sock_num(SY_SN_AF_UNIX) : sy_sock_num(SY_SN_AF_INET4);
    long st = sy_sock_num(SY_SN_SOCK_STREAM);
    if (!sy_sock_have() || af <= 0 || st <= 0) return -ENOSYS; /* ENOSYS: refuse, no socket backend on this platform (netraw Linux only) */
    return sy_sock_open((int)af, (int)st);
}

int sy_tcp_listen_at(const sy_addr_t *a, int backlog, int flags) {
    unsigned char sa[SY_SA_MAX];
    int n, fd, r;
    if (!a || backlog < 0 || (flags & ~(SY_LISTEN_REUSEADDR | SY_LISTEN_V6ONLY))) return -EINVAL;
    if ((flags & SY_LISTEN_V6ONLY) && a->family != SY_AF_INET6) return -EINVAL;
    n = syt_sa(a, sa, (int)sizeof sa);
    if (n < 0) return n;
    fd = syt_open(a->family);
    if (fd < 0) return fd;
    if (flags & SY_LISTEN_V6ONLY) {
        long lv = sy_sock_optnum(SY_SP_IPPROTO_IPV6), nm = sy_sock_optnum(SY_SP_IPV6_V6ONLY);
        if (lv <= 0 || nm <= 0) { sy_close(fd); return -ENOPROTOOPT; }
        r = sy_sock_setopt(fd, (int)lv, (int)nm, 1);
        if (r < 0) { sy_close(fd); return r; }
    }
    if (flags & SY_LISTEN_REUSEADDR) {
        r = sy_sock_setopt(fd, (int)sy_sock_num(SY_SN_SOL_SOCKET), (int)sy_sock_num(SY_SN_SO_REUSEADDR), 1);
        if (r < 0) { sy_close(fd); return r; }
    }
    r = sy_sock_bind(fd, sa, n);
    if (r < 0) { sy_close(fd); return r; }
    r = sy_sock_listen(fd, backlog);
    if (r < 0) { sy_close(fd); return r; }
    return fd;
}

int sy_tcp_listen(int port, int backlog) {
    sy_addr_t a;
    int r = sy_addr_loopback(&a, SY_AF_INET4, port);
    if (r < 0) return r;
    return sy_tcp_listen_at(&a, backlog, SY_LISTEN_REUSEADDR);
}

int sy_tcp_port(int fd) {
    unsigned char sa[SY_SA_MAX];
    int len = (int)sizeof sa, r;
    r = sy_sock_name(fd, sa, &len);
    if (r < 0) return r;
    return sy_sa_port(sa, len);
}

int sy_tcp_connect(int port) {
    unsigned char sa[SY_SA_MAX];
    static const unsigned char lo[4] = {127, 0, 0, 1};
    int n, fd, r;
    n = sy_sa_inet4(sa, (int)sizeof sa, lo, port);
    if (n < 0) return n;
    fd = syt_open(SY_AF_INET4);
    if (fd < 0) return fd;
    r = sy_sock_connect(fd, sa, n);
    if (r < 0) { sy_close(fd); return r; }
    return fd;
}

long sy_send(int fd, const void *buf, long n) { return sy_sock_send(fd, buf, n); }

long sy_recv(int fd, void *buf, long n) { return sy_sock_recv(fd, buf, n); }

int sy_send_all(int fd, const void *buf, long n) {
    const unsigned char *p = (const unsigned char *)buf;
    long done = 0, r;
    if (!buf || n < 0) return -EINVAL;
    while (done < n) {
        r = sy_sock_send(fd, p + done, n - done);
        if (r < 0) return (int)r;
        if (r == 0) return -EIO;
        done += r;
    }
    return 0;
}

/* Deadline variants (poll, then one call).  A passed deadline still takes what is already ready. */
static long syt_wait(int fd, int ev, sy_deadline_t d) {
    long r;
    if (fd < 0) return -EBADF;   /* poll ignores a negative fd */
    r = sy_sock_poll(fd, ev, sy_deadline_passed(&d) ? 0 : sy_deadline_left(&d));
    if (r < 0) return r;
    return r == 0 ? -ETIMEDOUT : 0;
}

/* Accept one connection on listener FD, waiting until D; PEER (may be 0) gets the remote address. */
int sy_tcp_accept_from(int fd, sy_deadline_t d, sy_addr_t *peer) {
    unsigned char sa[SY_SA_MAX];
    int len = (int)sizeof sa, c, f, i;
    long r = syt_wait(fd, SY_POLLIN, d);
    if (r < 0) return (int)r;
    c = sy_sock_accept(fd, sa, &len);
    if (c < 0) return c;
    if (peer) {
        f = sy_sa_family(sa, len);
        if (f == sy_sock_num(SY_SN_AF_UNIX)) {   /* same unix branch as sock.cx sys_from_sa (tcp cannot call it: sock uses tcp) */
            peer->family = SY_AF_UNIX; peer->port = 0; peer->scope = 0;
            for (i = 0; i < 16; i++) peer->ip[i] = 0;
            for (i = 0; i < 107 && 2 + i < len && sa[2 + i]; i++) peer->path[i] = (char)sa[2 + i];
            peer->path[i] = 0;
            return c;
        }
        peer->family = f == sy_sock_num(SY_SN_AF_INET6) ? SY_AF_INET6 : SY_AF_INET4;
        peer->port = sy_sa_port(sa, len);
        peer->scope = 0; peer->path[0] = 0;
        for (i = 0; i < 16; i++) peer->ip[i] = 0;
        if (sy_sa_ip(sa, len, peer->ip, 16) < 0) { sy_close(c); return -EAFNOSUPPORT; }
    }
    return c;
}

/* Receive up to N bytes, waiting until D.  Count, 0 for peer close, -ETIMEDOUT, or -errno. */
long sy_recv_until(int fd, void *buf, long n, sy_deadline_t d) {
    long r;
    if (!buf || n < 0) return -EINVAL;
    r = syt_wait(fd, SY_POLLIN, d);
    if (r < 0) return r;
    return sy_sock_recv(fd, buf, n);
}

/* Send all N bytes or fail; each chunk waits for writability until D (chunks are small so a send
   after POLLOUT does not block for long). */
int sy_send_all_until(int fd, const void *buf, long n, sy_deadline_t d) {
    const unsigned char *p = (const unsigned char *)buf;
    long done = 0, r, c;
    if (!buf || n < 0) return -EINVAL;
    while (done < n) {
        r = syt_wait(fd, SY_POLLOUT, d);
        if (r < 0) return (int)r;
        c = n - done > 2048 ? 2048 : n - done;
        r = sy_sock_send(fd, p + done, c);
        if (r < 0) return (int)r;
        if (r == 0) return -EIO;
        done += r;
    }
    return 0;
}

/* Connect to A, giving up at D: non-blocking connect, wait for writability, read SO_ERROR, then
   restore blocking mode.  A connected fd, -ETIMEDOUT at the deadline, or -errno (-ECONNREFUSED...). */
int sy_tcp_connect_to(const sy_addr_t *a, sy_deadline_t d) {
    unsigned char sa[SY_SA_MAX];
    int n, fd, r, e = 0;
    if (!a) return -EINVAL;
    n = syt_sa(a, sa, (int)sizeof sa);
    if (n < 0) return n;
    fd = syt_open(a->family);
    if (fd < 0) return fd;
    r = sy_snb_set_nonblock(fd, 1);
    if (r < 0) { sy_close(fd); return r; }
    r = sy_sock_connect(fd, sa, n);
    if (r == -EINPROGRESS) {
        r = (int)syt_wait(fd, SY_POLLOUT, d);
        if (r == 0) {
            r = sy_sock_getopt(fd, (int)sy_sock_num(SY_SN_SOL_SOCKET), (int)sy_sock_num(SY_SN_SO_ERROR), &e);
            if (r == 0 && e) r = e > 0 ? -e : e;
        }
    }
    if (r == 0) r = sy_snb_set_nonblock(fd, 0);
    if (r < 0) { sy_close(fd); return r; }
    return fd;
}

/* Connect to HOST:PORT (numeric address or localhost via sy_resolve; no DNS) until D.  The first
   address that connects wins; a resolver code (SY_EAI_*) is returned as is. */
int sy_tcp_dial(const char *host, int port, sy_deadline_t d) {
    sy_addr_t as[4];
    int n, i, r = -EHOSTUNREACH;
    if (!host) return -EINVAL;
    n = sy_resolve(host, port, 0, as, 4);
    if (n < 0) return n;
    for (i = 0; i < n; i++) {
        r = sy_tcp_connect_to(&as[i], d);
        if (r >= 0) return r;
    }
    return r;
}
