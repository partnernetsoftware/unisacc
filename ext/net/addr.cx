#pragma unisa module addr
#pragma unisa dock
/* ext.net addresses: pure text <-> sy_addr_t, no socket and no libc call (build/std-surface.tsv ext.net).
   sy_addr_t carries IPv4 (ip[0..3]), IPv6 (ip[0..15], scope) or a unix path.  Same names and layout as the
   socket unit ext/sysx/net.cx (sysx.net); a program uses one of the two units, not both.  Platform
   independent: no #if, no syscall. */
enum { SY_AF_INET4 = 4, SY_AF_INET6 = 6, SY_AF_UNIX = 1 };
enum { SY_EAI_BASE = -4096 };
typedef struct { int family; int port; unsigned char ip[16]; unsigned scope; char path[108]; } sy_addr_t;

static void sya_zero(sy_addr_t *a) {
    unsigned char *p = (unsigned char *)a;
    unsigned long i;
    for (i = 0; i < sizeof *a; i++) p[i] = 0;
}

/* Strict dotted quad into out[4]: four decimals 0..255, no sign, no empty or extra part, no leading zero
   beyond a lone "0". 1 on success, 0 otherwise. */
static int sya_p4(const char *s, unsigned char *out) {
    int part, d;
    for (part = 0; part < 4; part++) {
        unsigned v = 0;
        d = 0;
        if (part > 0) { if (*s != '.') return 0; s++; }
        if (s[0] == '0' && s[1] >= '0' && s[1] <= '9') return 0;
        while (*s >= '0' && *s <= '9') { v = v * 10 + (unsigned)(*s - '0'); s++; d++; if (d > 3 || v > 255) return 0; }
        if (d == 0) return 0;
        out[part] = (unsigned char)v;
    }
    return *s == 0;
}

static int sya_hex(int c) {
    if (c >= '0' && c <= '9') return c - '0';
    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
    return -1;
}

/* IPv6 text (with "::" and an optional trailing dotted quad) into out[16]. 1 or 0. */
static int sya_p6(const char *s, unsigned char *out) {
    unsigned g[8];
    int n = 0, gap = -1, i;
    if (s[0] == ':') { if (s[1] != ':') return 0; gap = 0; s += 2; }
    while (*s) {
        unsigned v = 0;
        int d = 0;
        const char *q = s;
        while (sya_hex(*q) >= 0) { v = v * 16 + (unsigned)sya_hex(*q); q++; d++; if (d > 4) return 0; }
        if (*q == '.') {
            unsigned char b[4];
            if (n > 6 || !sya_p4(s, b)) return 0;
            g[n] = (unsigned)b[0] * 256 + b[1]; g[n + 1] = (unsigned)b[2] * 256 + b[3];
            n += 2;
            break;
        }
        if (d == 0 || n >= 8) return 0;
        g[n++] = v;
        s = q;
        if (!*s) break;
        if (*s != ':') return 0;
        s++;
        if (*s == ':') { if (gap >= 0) return 0; gap = n; s++; }
        else if (!*s) return 0;
    }
    if (gap < 0) { if (n != 8) return 0; }
    else {
        int k;
        if (n > 7) return 0;
        for (k = n - 1; k >= gap; k--) g[k + 8 - n] = g[k];
        for (k = gap; k < gap + 8 - n; k++) g[k] = 0;
    }
    for (i = 0; i < 8; i++) { out[2 * i] = (unsigned char)(g[i] >> 8); out[2 * i + 1] = (unsigned char)(g[i] & 255); }
    return 1;
}

/* Parse a v4 dotted or v6 colon address (optional %NUMERIC scope on v6) into A with PORT (0..65535).
   0, or -EINVAL (names, bad forms, bad port, null argument). A is zeroed on failure. */
int sy_addr_parse(sy_addr_t *a, const char *text, int port) {
    char buf[64];
    int n = 0;
    const char *pct = 0;
    if (!a || !text || port < 0 || port > 65535) return -EINVAL;
    sya_zero(a);
    while (text[n] && n < 63) { buf[n] = text[n]; n++; }
    if (text[n] || n == 0) return -EINVAL;
    buf[n] = 0;
    for (n = 0; buf[n]; n++) if (buf[n] == '%') { pct = buf + n + 1; buf[n] = 0; break; }
    if (!pct && sya_p4(buf, a->ip)) { a->family = SY_AF_INET4; a->port = port; return 0; }
    {
        int i;
        for (i = 0; i < 16; i++) a->ip[i] = 0;
    }
    if (sya_p6(buf, a->ip)) {
        unsigned long sc = 0;
        if (pct) {
            if (!*pct) { sya_zero(a); return -EINVAL; }
            for (; *pct; pct++) {
                if (*pct < '0' || *pct > '9' || sc > 100000000UL) { sya_zero(a); return -EINVAL; }
                sc = sc * 10 + (unsigned long)(*pct - '0');
            }
        }
        a->family = SY_AF_INET6; a->port = port; a->scope = (unsigned)sc;
        return 0;
    }
    sya_zero(a);
    return -EINVAL;
}

/* Text of A: v4 "1.2.3.4:80", v6 "[::1]:80" ("[fe80::1%7]:80" with a scope), unix the path.  Writes into DST
   (CAP bytes, NUL included) and returns the text length; -ERANGE when CAP is below length + 1 (DST then holds
   the empty string, and a retry with CAP = needed length + 1 succeeds); -EINVAL for a null argument, CAP < 1
   or an unknown family. */
static int sya_put(char *t, int n, int tmax, const char *s) {
    while (*s && n < tmax - 1) t[n++] = *s++;
    return n;
}
static int sya_putu(char *t, int n, int tmax, unsigned v) {
    char d[12];
    int k = 0;
    if (v == 0) d[k++] = '0';
    while (v) { d[k++] = (char)('0' + v % 10); v /= 10; }
    while (k && n < tmax - 1) t[n++] = d[--k];
    return n;
}
int sy_addr_fmt(const sy_addr_t *a, char *dst, int cap) {
    char t[200];
    static const char hx[] = "0123456789abcdef";
    int n = 0, i;
    if (!a || !dst || cap < 1) return -EINVAL;
    if (a->family == SY_AF_INET4) {
        for (i = 0; i < 4; i++) { if (i) t[n++] = '.'; n = sya_putu(t, n, 200, a->ip[i]); }
        t[n++] = ':'; n = sya_putu(t, n, 200, (unsigned)a->port);
    } else if (a->family == SY_AF_INET6) {
        unsigned g[8];
        int bs = -1, bl = 0, cs = -1, cl = 0;
        for (i = 0; i < 8; i++) g[i] = (unsigned)a->ip[2 * i] * 256 + a->ip[2 * i + 1];
        for (i = 0; i < 8; i++) {
            if (g[i] == 0) { if (cs < 0) { cs = i; cl = 0; } cl++; if (cl > bl) { bl = cl; bs = cs; } }
            else cs = -1;
        }
        if (bl < 2) bs = -1;
        t[n++] = '[';
        for (i = 0; i < 8; i++) {
            if (i == bs) { t[n++] = ':'; t[n++] = ':'; i += bl - 1; continue; }
            if (i > 0 && i != bs + bl) t[n++] = ':';
            if (g[i] >> 12) t[n++] = hx[g[i] >> 12];
            if (g[i] >> 8) t[n++] = hx[(g[i] >> 8) & 15];
            if (g[i] >> 4) t[n++] = hx[(g[i] >> 4) & 15];
            t[n++] = hx[g[i] & 15];
        }
        if (a->scope) { t[n++] = '%'; n = sya_putu(t, n, 200, a->scope); }
        t[n++] = ']'; t[n++] = ':'; n = sya_putu(t, n, 200, (unsigned)a->port);
    } else if (a->family == SY_AF_UNIX) {
        int k = 0;
        while (k < 107 && a->path[k]) { t[n++] = a->path[k]; k++; }
    } else return -EINVAL;
    t[n] = 0;
    if (n + 1 > cap) { dst[0] = 0; return -ERANGE; }
    for (i = 0; i <= n; i++) dst[i] = t[i];
    return n;
}

/* Loopback (127.0.0.1 or ::1) with PORT into A. 0, -EINVAL (null A), -EAFNOSUPPORT (family not SY_AF_INET4/6). */
int sy_addr_loopback(sy_addr_t *a, int family, int port) {
    if (!a) return -EINVAL;
    if (family != SY_AF_INET4 && family != SY_AF_INET6) return -EAFNOSUPPORT;
    sya_zero(a);
    a->family = family; a->port = port;
    if (family == SY_AF_INET4) { a->ip[0] = 127; a->ip[3] = 1; } else a->ip[15] = 1;
    return 0;
}

/* Unspecified address (0.0.0.0 or ::) with PORT into A. Same errors as sy_addr_loopback. */
int sy_addr_any(sy_addr_t *a, int family, int port) {
    if (!a) return -EINVAL;
    if (family != SY_AF_INET4 && family != SY_AF_INET6) return -EAFNOSUPPORT;
    sya_zero(a);
    a->family = family; a->port = port;
    return 0;
}

/* Static text for a result code of any sy_* call: "ok" for 0 or more, "name resolution failure" for an
   SY_EAI_BASE value or below, "ENAME" for a known -errno (the errno constant's own name), else "error". */
const char *sy_net_error(int rc) {
    if (rc >= 0) return "ok";
    if (rc <= SY_EAI_BASE) return "name resolution failure";
    switch (-rc) {
    case EINVAL: return "EINVAL";
    case ERANGE: return "ERANGE";
    case EAFNOSUPPORT: return "EAFNOSUPPORT";
    case EADDRINUSE: return "EADDRINUSE";
    case EADDRNOTAVAIL: return "EADDRNOTAVAIL";
    case ECONNREFUSED: return "ECONNREFUSED";
    case ECONNRESET: return "ECONNRESET";
    case ECONNABORTED: return "ECONNABORTED";
    case ETIMEDOUT: return "ETIMEDOUT";
    case ENOTCONN: return "ENOTCONN";
    case EISCONN: return "EISCONN";
    case EPIPE: return "EPIPE";
    case EAGAIN: return "EAGAIN";
    case EINTR: return "EINTR";
    case EMSGSIZE: return "EMSGSIZE";
    case ENETUNREACH: return "ENETUNREACH";
    case EHOSTUNREACH: return "EHOSTUNREACH";
    case ENOPROTOOPT: return "ENOPROTOOPT";
    case ENAMETOOLONG: return "ENAMETOOLONG";
    case EBADF: return "EBADF";
    case ENOMEM: return "ENOMEM";
    case ENOSYS: return "ENOSYS"; /* ENOSYS: errno name table entry, not a refusal */
    default: return "error";
    }
}
