#pragma unisa module json
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use text.num
/* ext.textx json: strict RFC 8259 parser to a tree, plus string escaping.
   js_parse(text, len, err, errcap): the root value, or 0 with "offset N: reason" in ERR
   (ERR may be 0). Rejects trailing garbage, bad numbers (leading zeros, "1.", ".5", "+1"),
   control chars in strings, lone surrogates, depth over JS_MAXDEPTH. \uXXXX (with
   surrogate pairs) is decoded to UTF-8; strings are NUL-terminated copies (js_str_len
   gives the byte length, which may include embedded NUL from \u0000).
   Duplicate keys: js_parse folds them like JSON.parse: the later value, the first position
   ({"z":1,"a":2,"z":9} -> z=9, a=2 in that order), at every nesting level, so a parsed tree never holds a
   repeated key (the fold scans the members already read: linear per key). js_parse_keepdup takes the same
   arguments and keeps every repeated member in order, for callers that need a lossless round trip.
   Editing (object members; js_obj_* are below next to the builders):
     js_obj_set   DOM construction: always appends, a repeated key is appended, nothing is replaced
     js_obj_put   JS "o[k] = v": replaces the value of the FIRST member with that key (position kept, old value
                  freed by the container), else appends
     js_obj_del   JS "delete o[k]": removes ALL members with that key (a missing key is not an error); a key put
                  again afterwards goes to the end
   js_parse / js_parse_keepdup / js_obj_set differ only in how they treat a repeated key (fold / keep / keep);
   js_obj_put and js_obj_del are the edit pair and assume a tree without repeated keys (js_parse's result).
   Defence against sharing: nodes carry no parent pointer (parse-dense paths stay lean). Call js_assert_tree(root)
   at critical points (after hand assembly, before js_free of a tree built from several sources): it returns 0 or
   -EEXIST (a node reachable twice) / -ELOOP (a cycle, or nesting over JS_MAXDEPTH); js_free itself is unchecked.
   Ownership: the caller owns the root and frees it once with js_free; children belong to
   the root. Accessors take 0 safely and return 0 / JS_NONE on a miss.
   Tree ownership contract: js_free(root) frees every node reachable from ROOT, including any node another tree
   also points at. A tree must OWN all of its children: never attach a node that belongs to another tree (not
   even a scalar leaf) without copying it. js_mk_str/js_mk_num/js_mk_bool/js_mk_null make cheap copies for this,
   and js_clone(v) deep-copies a whole subtree (below, next to the builders). */
enum { JS_NONE = 0, JS_NULL = 1, JS_BOOL = 2, JS_NUM = 3, JS_STR = 4, JS_ARR = 5, JS_OBJ = 6, JS_MAXDEPTH = 128 };
typedef struct js_val {
    int kind;
    int b;
    double num;
    char *s;
    long slen;
    long n;
    long cap;
    struct js_val **items;
    char **keys;
    long *klens;
} js_val;
typedef struct { const char *p; long n; long i; int depth; char *err; long errcap; int failed; int keepdup; } js_ps;

static void js_seterr(js_ps *ps, long off, const char *msg) {
    char num[24]; int k = 0; long w = 0, v = off; const char *pre = "offset ";
    if (ps->failed) return;
    ps->failed = 1;
    if (!ps->err || ps->errcap <= 0) return;
    if (v < 0) v = 0;
    do { num[k++] = (char)('0' + v % 10); v /= 10; } while (v && k < 23);
    while (*pre && w < ps->errcap - 1) ps->err[w++] = *pre++;
    while (k > 0 && w < ps->errcap - 1) ps->err[w++] = num[--k];
    if (w < ps->errcap - 1) ps->err[w++] = ':';
    if (w < ps->errcap - 1) ps->err[w++] = ' ';
    while (*msg && w < ps->errcap - 1) ps->err[w++] = *msg++;
    ps->err[w] = 0;
}
static void js_ws(js_ps *ps) {
    while (ps->i < ps->n) {
        char c = ps->p[ps->i];
        if (c == ' ' || c == '\t' || c == '\n' || c == '\r') ps->i++; else break;
    }
}
static js_val *js_node(js_ps *ps, int kind) {
    js_val *v = (js_val *)mm_zalloc((long)sizeof(js_val));
    if (!v) { js_seterr(ps, ps->i, "out of memory"); return 0; }
    v->kind = kind;
    return v;
}
void js_free(js_val *v) {
    long i;
    if (!v) return;
    for (i = 0; i < v->n; i++) {
        if (v->items) js_free(v->items[i]);
        if (v->keys) mm_free(v->keys[i]);
    }
    mm_free(v->items); mm_free(v->keys); mm_free(v->klens); mm_free(v->s);
    mm_free(v);
}
static int js_hex4(js_ps *ps, long at, unsigned *out) {
    unsigned u = 0; int k;
    if (at + 4 > ps->n) return -1;
    for (k = 0; k < 4; k++) {
        char c = ps->p[at + k];
        u <<= 4;
        if (c >= '0' && c <= '9') u |= (unsigned)(c - '0');
        else if (c >= 'a' && c <= 'f') u |= (unsigned)(c - 'a' + 10);
        else if (c >= 'A' && c <= 'F') u |= (unsigned)(c - 'A' + 10);
        else return -1;
    }
    *out = u;
    return 0;
}
static long js_put8(char *d, unsigned cp) {
    if (cp < 0x80) { d[0] = (char)cp; return 1; }
    if (cp < 0x800) { d[0] = (char)(0xC0 | (cp >> 6)); d[1] = (char)(0x80 | (cp & 0x3F)); return 2; }
    if (cp < 0x10000) { d[0] = (char)(0xE0 | (cp >> 12)); d[1] = (char)(0x80 | ((cp >> 6) & 0x3F)); d[2] = (char)(0x80 | (cp & 0x3F)); return 3; }
    d[0] = (char)(0xF0 | (cp >> 18)); d[1] = (char)(0x80 | ((cp >> 12) & 0x3F));
    d[2] = (char)(0x80 | ((cp >> 6) & 0x3F)); d[3] = (char)(0x80 | (cp & 0x3F));
    return 4;
}
/* ps->i at the opening quote. Decoded bytes never exceed the raw span, so one
   allocation of (raw length + 1) suffices. */
static char *js_string(js_ps *ps, long *olen) {
    long st = ps->i + 1, e = st, w = 0;
    char *d;
    int esc = 0;
    while (e < ps->n && ps->p[e] != '"') {
        unsigned char c = (unsigned char)ps->p[e];
        if (c < 0x20) { js_seterr(ps, e, "control character in string"); return 0; }
        if (c == '\\') { esc = 1; e += 2; } else e++;
    }
    if (e >= ps->n) { js_seterr(ps, ps->i, "unterminated string"); return 0; }
    d = (char *)mm_alloc(e - st + 1);
    if (!d) { js_seterr(ps, st, "out of memory"); return 0; }
    if (!esc) {
        mm_copy(d, e - st + 1, ps->p + st, e - st);
        w = e - st;
    } else {
        long i = st;
        while (i < e) {
            char c = ps->p[i];
            if (c != '\\') { d[w++] = c; i++; continue; }
            c = ps->p[i + 1];
            if (c == '"' || c == '\\' || c == '/') { d[w++] = c; i += 2; }
            else if (c == 'b') { d[w++] = '\b'; i += 2; }
            else if (c == 'f') { d[w++] = '\f'; i += 2; }
            else if (c == 'n') { d[w++] = '\n'; i += 2; }
            else if (c == 'r') { d[w++] = '\r'; i += 2; }
            else if (c == 't') { d[w++] = '\t'; i += 2; }
            else if (c == 'u') {
                unsigned u, lo;
                if (js_hex4(ps, i + 2, &u) || i + 6 > e) { js_seterr(ps, i, "bad \\u escape"); mm_free(d); return 0; }
                i += 6;
                if (u >= 0xDC00 && u <= 0xDFFF) { js_seterr(ps, i - 6, "lone low surrogate"); mm_free(d); return 0; }
                if (u >= 0xD800 && u <= 0xDBFF) {
                    if (i + 6 > e || ps->p[i] != '\\' || ps->p[i + 1] != 'u' || js_hex4(ps, i + 2, &lo) || lo < 0xDC00 || lo > 0xDFFF) {
                        js_seterr(ps, i - 6, "lone high surrogate"); mm_free(d); return 0;
                    }
                    i += 6;
                    u = 0x10000 + ((u - 0xD800) << 10) + (lo - 0xDC00);
                }
                w += js_put8(d + w, u);
            } else { js_seterr(ps, i, "bad escape"); mm_free(d); return 0; }
        }
    }
    d[w] = 0;
    *olen = w;
    ps->i = e + 1;
    return d;
}
static js_val *js_number(js_ps *ps) {
    long st = ps->i, i = ps->i;
    char buf[64]; char *tmp = buf; js_val *v;
    if (i < ps->n && ps->p[i] == '-') i++;
    if (i >= ps->n) { js_seterr(ps, st, "bad number"); return 0; }
    if (ps->p[i] == '0') { i++; if (i < ps->n && ps->p[i] >= '0' && ps->p[i] <= '9') { js_seterr(ps, st, "leading zero"); return 0; } }
    else if (ps->p[i] >= '1' && ps->p[i] <= '9') { while (i < ps->n && ps->p[i] >= '0' && ps->p[i] <= '9') i++; }
    else { js_seterr(ps, st, "bad number"); return 0; }
    if (i < ps->n && ps->p[i] == '.') {
        i++;
        if (i >= ps->n || ps->p[i] < '0' || ps->p[i] > '9') { js_seterr(ps, st, "bad fraction"); return 0; }
        while (i < ps->n && ps->p[i] >= '0' && ps->p[i] <= '9') i++;
    }
    if (i < ps->n && (ps->p[i] == 'e' || ps->p[i] == 'E')) {
        i++;
        if (i < ps->n && (ps->p[i] == '+' || ps->p[i] == '-')) i++;
        if (i >= ps->n || ps->p[i] < '0' || ps->p[i] > '9') { js_seterr(ps, st, "bad exponent"); return 0; }
        while (i < ps->n && ps->p[i] >= '0' && ps->p[i] <= '9') i++;
    }
    v = js_node(ps, JS_NUM);
    if (!v) return 0;
    if (i - st >= (long)sizeof(buf)) { tmp = (char *)mm_alloc(i - st + 1); if (!tmp) { mm_free(v); js_seterr(ps, st, "out of memory"); return 0; } }
    mm_copy(tmp, i - st + 1, ps->p + st, i - st);
    tmp[i - st] = 0;
    v->num = tx_strtod(tmp, 0);
    if (tmp != buf) mm_free(tmp);
    ps->i = i;
    return v;
}
static int js_push(js_ps *ps, js_val *c, js_val *x, char *key, long klen) {
    if (c->kind == JS_OBJ && !ps->keepdup) {
        /* JSON.parse folding: a repeated key keeps its first position and takes the later value */
        long q;
        for (q = 0; q < c->n; q++)
            if (c->klens[q] == klen && mm_same(c->keys[q], key, klen)) {
                js_free(c->items[q]); c->items[q] = x; mm_free(key);
                return 0;
            }
    }
    if (c->n == c->cap) {
        long nc = c->cap ? c->cap * 2 : 4;
        js_val **ni = (js_val **)mm_grow(c->items, nc * (long)sizeof(js_val *));
        if (!ni) { js_seterr(ps, ps->i, "out of memory"); return -1; }
        c->items = ni;
        if (c->kind == JS_OBJ) {
            char **nk = (char **)mm_grow(c->keys, nc * (long)sizeof(char *));
            long *nl;
            if (!nk) { js_seterr(ps, ps->i, "out of memory"); return -1; }
            c->keys = nk;
            nl = (long *)mm_grow(c->klens, nc * (long)sizeof(long));
            if (!nl) { js_seterr(ps, ps->i, "out of memory"); return -1; }
            c->klens = nl;
        }
        c->cap = nc;
    }
    c->items[c->n] = x;
    if (c->kind == JS_OBJ) { c->keys[c->n] = key; c->klens[c->n] = klen; }
    c->n++;
    return 0;
}
static int js_lit(js_ps *ps, const char *w) {
    long k = 0;
    while (w[k]) { if (ps->i + k >= ps->n || ps->p[ps->i + k] != w[k]) return 0; k++; }
    ps->i += k;
    return 1;
}
static js_val *js_value(js_ps *ps) {
    char c; js_val *v;
    js_ws(ps);
    if (ps->i >= ps->n) { js_seterr(ps, ps->i, "unexpected end"); return 0; }
    c = ps->p[ps->i];
    if (c == '{' || c == '[') {
        int obj = c == '{';
        char close = obj ? '}' : ']';
        if (++ps->depth > JS_MAXDEPTH) { js_seterr(ps, ps->i, "depth limit 128"); return 0; }
        v = js_node(ps, obj ? JS_OBJ : JS_ARR);
        if (!v) return 0;
        ps->i++;
        js_ws(ps);
        if (ps->i < ps->n && ps->p[ps->i] == close) { ps->i++; ps->depth--; return v; }
        for (;;) {
            char *key = 0; long klen = 0; js_val *x;
            js_ws(ps);
            if (obj) {
                if (ps->i >= ps->n || ps->p[ps->i] != '"') { js_seterr(ps, ps->i, "expected key string"); js_free(v); return 0; }
                key = js_string(ps, &klen);
                if (!key) { js_free(v); return 0; }
                js_ws(ps);
                if (ps->i >= ps->n || ps->p[ps->i] != ':') { js_seterr(ps, ps->i, "expected ':'"); mm_free(key); js_free(v); return 0; }
                ps->i++;
            }
            x = js_value(ps);
            if (!x) { mm_free(key); js_free(v); return 0; }
            if (js_push(ps, v, x, key, klen)) { mm_free(key); js_free(x); js_free(v); return 0; }
            js_ws(ps);
            if (ps->i < ps->n && ps->p[ps->i] == ',') { ps->i++; continue; }
            if (ps->i < ps->n && ps->p[ps->i] == close) { ps->i++; break; }
            js_seterr(ps, ps->i, obj ? "expected ',' or '}'" : "expected ',' or ']'");
            js_free(v);
            return 0;
        }
        ps->depth--;
        return v;
    }
    if (c == '"') {
        long l = 0; char *s = js_string(ps, &l);
        if (!s) return 0;
        v = js_node(ps, JS_STR);
        if (!v) { mm_free(s); return 0; }
        v->s = s; v->slen = l;
        return v;
    }
    if (c == '-' || (c >= '0' && c <= '9')) return js_number(ps);
    if (js_lit(ps, "true")) { v = js_node(ps, JS_BOOL); if (v) v->b = 1; return v; }
    if (js_lit(ps, "false")) return js_node(ps, JS_BOOL);
    if (js_lit(ps, "null")) return js_node(ps, JS_NULL);
    js_seterr(ps, ps->i, "unexpected character");
    return 0;
}
static js_val *js_parse_run(const char *text, long len, char *err, long errcap, int keepdup) {
    js_ps ps; js_val *v;
    ps.p = text; ps.n = len; ps.i = 0; ps.depth = 0; ps.err = err; ps.errcap = errcap; ps.failed = 0; ps.keepdup = keepdup;
    if (err && errcap > 0) err[0] = 0;
    if (!text || len < 0) { js_seterr(&ps, 0, "bad arguments"); return 0; }
    v = js_value(&ps);
    if (!v) return 0;
    js_ws(&ps);
    if (ps.i != ps.n) { js_seterr(&ps, ps.i, "trailing garbage"); js_free(v); return 0; }
    return v;
}
js_val *js_parse(const char *text, long len, char *err, long errcap) { return js_parse_run(text, len, err, errcap, 0); }
js_val *js_parse_keepdup(const char *text, long len, char *err, long errcap) { return js_parse_run(text, len, err, errcap, 1); }
int js_kind(const js_val *v) { return v ? v->kind : JS_NONE; }
long js_len(const js_val *v) {
    if (!v) return 0;
    if (v->kind == JS_ARR || v->kind == JS_OBJ) return v->n;
    if (v->kind == JS_STR) return v->slen;
    return 0;
}
js_val *js_at(const js_val *v, long i) {
    if (!v || (v->kind != JS_ARR && v->kind != JS_OBJ) || i < 0 || i >= v->n) return 0;
    return v->items[i];
}
/* Key of member I of an object, or 0. */
const char *js_key(const js_val *v, long i) {
    if (!v || v->kind != JS_OBJ || i < 0 || i >= v->n) return 0;
    return v->keys[i];
}
/* Member KEY (first KN bytes) of object V; the last duplicate wins. */
js_val *js_getn(const js_val *v, const char *key, long kn) {
    long i;
    if (!v || v->kind != JS_OBJ || !key) return 0;
    for (i = v->n - 1; i >= 0; i--)
        if (v->klens[i] == kn && mm_same(v->keys[i], key, kn)) return v->items[i];
    return 0;
}
js_val *js_get(const js_val *v, const char *key) {
    long k = 0;
    if (!key) return 0;
    while (key[k]) k++;
    return js_getn(v, key, k);
}
const char *js_str(const js_val *v) { return v && v->kind == JS_STR ? v->s : 0; }
long js_str_len(const js_val *v) { return v && v->kind == JS_STR ? v->slen : 0; }
double js_num(const js_val *v) { return v && v->kind == JS_NUM ? v->num : 0.0; }
int js_bool(const js_val *v) { return v && v->kind == JS_BOOL ? v->b : 0; }
/* Dotted path: "a.b.0.c". A segment of only digits indexes an array; on an object it is a key. */
js_val *js_path(const js_val *v, const char *path) {
    const js_val *cur = v; long st = 0, i = 0;
    if (!v || !path) return 0;
    for (;;) {
        if (path[i] == '.' || path[i] == 0) {
            long sl = i - st, k, idx = 0; int dig = sl > 0;
            for (k = 0; k < sl; k++) { char c = path[st + k]; if (c < '0' || c > '9') { dig = 0; break; } idx = idx * 10 + (c - '0'); }
            if (!cur) return 0;
            if (cur->kind == JS_ARR) { if (!dig) return 0; cur = js_at(cur, idx); }
            else if (cur->kind == JS_OBJ) cur = js_getn(cur, path + st, sl);
            else return 0;
            if (!cur) return 0;
            if (path[i] == 0) return (js_val *)cur;
            st = i + 1;
        }
        i++;
    }
}
/* Writes S (N bytes) as a JSON string body (no surrounding quotes) to DST, NUL-terminated.
   Returns 1 when everything fit, 0 when truncated (DST holds the longest whole-escape
   prefix), -1 on bad arguments. *OUTLEN (may be 0) gets the bytes written. */
int js_esc(char *dst, long cap, const char *s, long n, long *outlen) {
    static const char hx[] = "0123456789abcdef";
    long i, w = 0; int fit = 1;
    if (outlen) *outlen = 0;
    if (!dst || cap <= 0 || (!s && n)) return -1;
    for (i = 0; i < n; i++) {
        unsigned char c = (unsigned char)s[i];
        char t[6]; int tl = 0, k;
        if (c == '"' || c == '\\') { t[0] = '\\'; t[1] = (char)c; tl = 2; }
        else if (c == '\n') { t[0] = '\\'; t[1] = 'n'; tl = 2; }
        else if (c == '\r') { t[0] = '\\'; t[1] = 'r'; tl = 2; }
        else if (c == '\t') { t[0] = '\\'; t[1] = 't'; tl = 2; }
        else if (c == '\b') { t[0] = '\\'; t[1] = 'b'; tl = 2; }
        else if (c == '\f') { t[0] = '\\'; t[1] = 'f'; tl = 2; }
        else if (c < 0x20) { t[0] = '\\'; t[1] = 'u'; t[2] = '0'; t[3] = '0'; t[4] = hx[c >> 4]; t[5] = hx[c & 15]; tl = 6; }
        else { t[0] = (char)c; tl = 1; }
        if (w + tl > cap - 1) { fit = 0; break; }
        for (k = 0; k < tl; k++) dst[w++] = t[k];
    }
    dst[w] = 0;
    if (outlen) *outlen = w;
    return fit;
}
/* ---- serializer: js_emit (compact, one line) and js_emit_pretty (2-space indent) ----
     long js_emit(const js_val *v, unsigned char *out, long cap)
     long js_emit_pretty(const js_val *v, unsigned char *out, long cap)
   write V as JSON text into OUT[0..cap) and return the byte count (no NUL is written), or a
   negative errno: -ENOSPC the text does not fit (OUT holds a prefix, nothing past cap is
   touched), -EINVAL bad arguments or nesting over JS_MAXDEPTH. The caller owns OUT; no
   allocation; module state: none. The text is meant to equal JavaScript JSON.stringify(v)
   and JSON.stringify(v, null, 2) byte for byte:
   - object members in stored (insertion) order; duplicate keys are all written (a JS
     object could not hold them); a 0 child or JS_NONE is written as null;
   - strings: \" \\ \b \f \n \r \t, other bytes <= 0x1f as \u00xx (lower-case hex), 0x7f and
     every byte >= 0x80 unchanged (UTF-8 passes through; '/' is not escaped). js_parse never
     yields a lone surrogate; a hand-built string that carries one as the three bytes
     ED A0..BF 80..BF is written as \udxxx like JS does. Other malformed UTF-8 is copied as is;
   - numbers follow Number.prototype.toString: the shortest decimal digits that read back to
     the same double (exact big-integer digit generation, no table, no libc), integers
     without a point, -0 as 0, plain decimal while 1e-7 < |x| < 1e21 and d[.ddd]e+N / e-N
     outside it; NaN and the infinities are written as null;
   - pretty: one member per line, ": " after a key, empty containers stay {} and [], no
     trailing newline. */
enum { JS_EXP_HI = 21, JS_EXP_LO = -6, JS_BIGW = 36 };
typedef struct { unsigned char *o; long cap; long w; int over; int bad; } js_wr;
typedef struct { unsigned int d[JS_BIGW]; } js_big;

static void js_wc(js_wr *w, int c) {
    if (w->w < w->cap) w->o[w->w++] = (unsigned char)c; else w->over = 1;
}
static void js_wz(js_wr *w, const char *s) { while (*s) js_wc(w, *s++); }
static void jb_set(js_big *a, unsigned long long v) {
    int i;
    for (i = 0; i < JS_BIGW; i++) a->d[i] = 0;
    a->d[0] = (unsigned int)(v & 0xFFFFFFFFULL); a->d[1] = (unsigned int)(v >> 32);
}
static void jb_shl(js_big *a, int n) {
    int ws = n / 32, bs = n % 32, i;
    for (i = JS_BIGW - 1; i >= 0; i--) {
        unsigned long long x = 0;
        if (i - ws >= 0) x = (unsigned long long)a->d[i - ws] << bs;
        if (bs && i - ws - 1 >= 0) x |= (unsigned long long)a->d[i - ws - 1] >> (32 - bs);
        a->d[i] = (unsigned int)(x & 0xFFFFFFFFULL);
    }
}
static void jb_mul10(js_big *a) {
    unsigned long long c = 0; int i;
    for (i = 0; i < JS_BIGW; i++) { c += (unsigned long long)a->d[i] * 10ULL; a->d[i] = (unsigned int)(c & 0xFFFFFFFFULL); c >>= 32; }
}
static void jb_add(js_big *a, const js_big *b) {
    unsigned long long c = 0; int i;
    for (i = 0; i < JS_BIGW; i++) { c += (unsigned long long)a->d[i] + b->d[i]; a->d[i] = (unsigned int)(c & 0xFFFFFFFFULL); c >>= 32; }
}
/* A -= B, A >= B */
static void jb_sub(js_big *a, const js_big *b) {
    unsigned long long br = 0; int i;
    for (i = 0; i < JS_BIGW; i++) {
        unsigned long long x = (unsigned long long)a->d[i], y = (unsigned long long)b->d[i] + br;
        if (x >= y) { a->d[i] = (unsigned int)(x - y); br = 0; }
        else { a->d[i] = (unsigned int)((x + 0x100000000ULL - y) & 0xFFFFFFFFULL); br = 1; }
    }
}
static int jb_cmp(const js_big *a, const js_big *b) {
    int i;
    for (i = JS_BIGW - 1; i >= 0; i--) if (a->d[i] != b->d[i]) return a->d[i] < b->d[i] ? -1 : 1;
    return 0;
}
/* Shortest digits of the positive finite double with raw BITS (sign cleared, not zero):
   DG gets N digits (N <= 17, returned), *PK the decimal point position, value = 0.DG * 10^*PK.
   Free-format algorithm of Steele-White / Burger-Dybvig on exact integers: value = r/s, the
   half-gaps to the neighbours are mm/s below and mp/s above; the boundaries belong to the
   interval when the significand is even (round-half-even reads them back). */
static int js_shortest(unsigned long long bits, char *dg, int *pk) {
    unsigned long long f = bits & 0xFFFFFFFFFFFFFULL;
    int be = (int)(bits >> 52), e, even, lowb, k = 0, n = 0;
    js_big r, s, mp, mm, t;
    if (be) { f |= 1ULL << 52; e = be - 1075; } else e = -1074;
    even = !(f & 1ULL);
    lowb = be > 1 && f == (1ULL << 52);   /* the gap below a power of two is half the gap above */
    jb_set(&r, f); jb_set(&s, 1); jb_set(&mp, 1); jb_set(&mm, 1);
    if (e >= 0) { jb_shl(&r, e + 1 + lowb); jb_shl(&s, 1 + lowb); jb_shl(&mm, e); jb_shl(&mp, e + lowb); }
    else { jb_shl(&r, 1 + lowb); jb_shl(&s, 1 - e + lowb); jb_shl(&mp, lowb); }
    for (;;) {
        int c;
        t = r; jb_add(&t, &mp); c = jb_cmp(&t, &s);
        if (even ? c >= 0 : c > 0) { jb_mul10(&s); k++; } else break;
    }
    for (;;) {
        int c;
        t = r; jb_add(&t, &mp); jb_mul10(&t); c = jb_cmp(&t, &s);
        if (even ? c < 0 : c <= 0) { jb_mul10(&r); jb_mul10(&mp); jb_mul10(&mm); k--; } else break;
    }
    for (;;) {
        int d = 0, lo, hi, c;
        jb_mul10(&r); jb_mul10(&mp); jb_mul10(&mm);
        while (jb_cmp(&r, &s) >= 0) { jb_sub(&r, &s); d++; }
        c = jb_cmp(&r, &mm); lo = even ? c <= 0 : c < 0;
        t = r; jb_add(&t, &mp); c = jb_cmp(&t, &s); hi = even ? c >= 0 : c > 0;
        if (!lo && !hi && n < 20) { dg[n++] = (char)('0' + d); continue; }
        if (lo && hi) { t = r; jb_shl(&t, 1); c = jb_cmp(&t, &s); if (c > 0 || (c == 0 && (d & 1))) d++; }
        else if (hi) d++;
        dg[n++] = (char)('0' + d);
        break;
    }
    *pk = k;
    return n;
}
static void js_wnum(js_wr *w, double v) {
    unsigned long long bits = 0; char dg[24]; int n, k, i, neg;
    if (mm_copy(&bits, 8, &v, 8)) { w->bad = 1; return; }
    neg = (int)(bits >> 63); bits &= 0x7FFFFFFFFFFFFFFFULL;
    if ((bits >> 52) == 0x7FF) { js_wz(w, "null"); return; }
    if (neg && bits != 0) js_wc(w, '-');
    if (bits == 0) { js_wc(w, '0'); return; }
    n = js_shortest(bits, dg, &k);
    if (n <= k && k <= JS_EXP_HI) {
        for (i = 0; i < n; i++) js_wc(w, dg[i]);
        for (i = n; i < k; i++) js_wc(w, '0');
    } else if (0 < k && k <= JS_EXP_HI) {
        for (i = 0; i < k; i++) js_wc(w, dg[i]);
        js_wc(w, '.');
        for (i = k; i < n; i++) js_wc(w, dg[i]);
    } else if (JS_EXP_LO < k && k <= 0) {
        js_wz(w, "0.");
        for (i = k; i < 0; i++) js_wc(w, '0');
        for (i = 0; i < n; i++) js_wc(w, dg[i]);
    } else {
        int x = k - 1; char eb[8]; int en = 0;
        js_wc(w, dg[0]);
        if (n > 1) { js_wc(w, '.'); for (i = 1; i < n; i++) js_wc(w, dg[i]); }
        js_wc(w, 'e'); js_wc(w, x < 0 ? '-' : '+');
        if (x < 0) x = -x;
        do { eb[en++] = (char)('0' + x % 10); x /= 10; } while (x);
        while (en > 0) js_wc(w, eb[--en]);
    }
}
static void js_wstring(js_wr *w, const char *s, long n) {
    static const char hx[] = "0123456789abcdef";
    long i;
    js_wc(w, '"');
    for (i = 0; i < n; i++) {
        unsigned char c = (unsigned char)s[i];
        if (c == '"' || c == '\\') { js_wc(w, '\\'); js_wc(w, c); }
        else if (c == '\b') js_wz(w, "\\b");
        else if (c == '\f') js_wz(w, "\\f");
        else if (c == '\n') js_wz(w, "\\n");
        else if (c == '\r') js_wz(w, "\\r");
        else if (c == '\t') js_wz(w, "\\t");
        else if (c <= 0x1f) { js_wz(w, "\\u00"); js_wc(w, hx[c >> 4]); js_wc(w, hx[c & 15]); }
        else if (c == 0xED && i + 2 < n && ((unsigned char)s[i + 1] & 0xE0) == 0xA0 && ((unsigned char)s[i + 2] & 0xC0) == 0x80) {
            unsigned u = 0xD000u | (((unsigned)(unsigned char)s[i + 1] & 0x3Fu) << 6) | ((unsigned)(unsigned char)s[i + 2] & 0x3Fu);
            js_wz(w, "\\u"); js_wc(w, hx[(u >> 12) & 15]); js_wc(w, hx[(u >> 8) & 15]); js_wc(w, hx[(u >> 4) & 15]); js_wc(w, hx[u & 15]);
            i += 2;
        } else js_wc(w, c);
    }
    js_wc(w, '"');
}
static void js_wnl(js_wr *w, int ind, int lvl) {
    long k;
    if (!ind) return;
    js_wc(w, '\n');
    for (k = (long)ind * lvl; k > 0; k--) js_wc(w, ' ');
}
static void js_wval(js_wr *w, const js_val *v, int ind, int lvl) {
    long i; int obj;
    if (w->over || w->bad) return;
    if (!v || v->kind == JS_NONE || v->kind == JS_NULL) { js_wz(w, "null"); return; }
    if (v->kind == JS_BOOL) { js_wz(w, v->b ? "true" : "false"); return; }
    if (v->kind == JS_NUM) { js_wnum(w, v->num); return; }
    if (v->kind == JS_STR) { js_wstring(w, v->s, v->s ? v->slen : 0); return; }
    if (v->kind != JS_ARR && v->kind != JS_OBJ) { w->bad = 1; return; }
    obj = v->kind == JS_OBJ;
    if (v->n <= 0) { js_wz(w, obj ? "{}" : "[]"); return; }
    if (lvl >= JS_MAXDEPTH || !v->items || (obj && (!v->keys || !v->klens))) { w->bad = 1; return; }
    js_wc(w, obj ? '{' : '[');
    for (i = 0; i < v->n && !w->over && !w->bad; i++) {
        if (i) js_wc(w, ',');
        js_wnl(w, ind, lvl + 1);
        if (obj) { js_wstring(w, v->keys[i], v->keys[i] ? v->klens[i] : 0); js_wc(w, ':'); if (ind) js_wc(w, ' '); }
        js_wval(w, v->items[i], ind, lvl + 1);
    }
    js_wnl(w, ind, lvl);
    js_wc(w, obj ? '}' : ']');
}
static long js_emit_run(const js_val *v, unsigned char *out, long cap, int ind) {
    js_wr w;
    if (!v || cap < 0 || (cap && !out)) return -EINVAL;
    w.o = out; w.cap = cap; w.w = 0; w.over = 0; w.bad = 0;
    js_wval(&w, v, ind, 0);
    if (w.bad) return -EINVAL;
    if (w.over) return -ENOSPC;
    return w.w;
}
long js_emit(const js_val *v, unsigned char *out, long cap) { return js_emit_run(v, out, cap, 0); }
long js_emit_pretty(const js_val *v, unsigned char *out, long cap) { return js_emit_run(v, out, cap, 2); }

/* ---- builders (phase 2) ----
   Build a tree in the program, then js_emit / js_emit_pretty it. The tree is the same shape js_parse makes,
   so one js_free(root) frees all of it. Names carry mk_/obj_/arr_ because js_str, js_num and js_bool are
   the accessors above.
     js_mk_obj() js_mk_arr()       empty container, or 0 (no memory)
     js_mk_str(s, n)               copy of the first N bytes of S (N < 0: strlen); embedded NUL kept; 0 on failure
     js_mk_num(d) js_mk_bool(b) js_mk_null()   scalar leaf, or 0 (no memory); NaN/Inf are stored and emit as null
     js_obj_set(o, key, child)     append member KEY (NUL-terminated, copied); js_obj_setn gives the key length
     js_arr_push(a, child)         append element
   Ownership: on success the container owns CHILD (free only the root; never free CHILD again, never put it
   in a second container). On failure (-EINVAL: bad container kind, null key or child, child is the container
   itself; -ENOMEM) CHILD stays with the caller and the container is unchanged. Members are kept in insertion
   order and a repeated key is appended, not replaced (DOM construction, as js_parse_keepdup and js_emit treat
   duplicates; use js_obj_put for JS assignment semantics). */
static js_val *js_mk(int kind) {
    js_val *v = (js_val *)mm_zalloc((long)sizeof(js_val));
    if (v) v->kind = kind;
    return v;
}
js_val *js_mk_obj(void) { return js_mk(JS_OBJ); }
js_val *js_mk_arr(void) { return js_mk(JS_ARR); }
js_val *js_mk_num(double d) { js_val *v = js_mk(JS_NUM); if (v) v->num = d; return v; }
js_val *js_mk_bool(int b) { js_val *v = js_mk(JS_BOOL); if (v) v->b = b ? 1 : 0; return v; }
js_val *js_mk_null(void) { return js_mk(JS_NULL); }
js_val *js_mk_str(const char *s, long n) {
    js_val *v; char *d;
    if (!s) return 0;
    if (n < 0) { n = 0; while (s[n]) n++; }
    d = (char *)mm_alloc(n + 1);
    if (!d) return 0;
    if (n > 0 && mm_copy(d, n + 1, s, n)) { mm_free(d); return 0; }
    d[n] = 0;
    v = js_mk(JS_STR);
    if (!v) { mm_free(d); return 0; }
    v->s = d; v->slen = n;
    return v;
}
static int js_room(js_val *c) {
    long nc; js_val **ni; char **nk; long *nl;
    if (c->n < c->cap) return 0;
    nc = c->cap ? c->cap * 2 : 4;
    ni = (js_val **)mm_grow(c->items, nc * (long)sizeof(js_val *));
    if (!ni) return -ENOMEM;
    c->items = ni;
    if (c->kind == JS_OBJ) {
        nk = (char **)mm_grow(c->keys, nc * (long)sizeof(char *));
        if (!nk) return -ENOMEM;
        c->keys = nk;
        nl = (long *)mm_grow(c->klens, nc * (long)sizeof(long));
        if (!nl) return -ENOMEM;
        c->klens = nl;
    }
    c->cap = nc;
    return 0;
}
int js_obj_setn(js_val *o, const char *key, long kn, js_val *child) {
    char *k; int r;
    if (!o || o->kind != JS_OBJ || !key || kn < 0 || !child || child == o) return -EINVAL;
    k = (char *)mm_alloc(kn + 1);
    if (!k) return -ENOMEM;
    if (kn > 0 && mm_copy(k, kn + 1, key, kn)) { mm_free(k); return -EINVAL; }
    k[kn] = 0;
    r = js_room(o);
    if (r) { mm_free(k); return r; }
    o->items[o->n] = child; o->keys[o->n] = k; o->klens[o->n] = kn;
    o->n++;
    return 0;
}
int js_obj_set(js_val *o, const char *key, js_val *child) {
    long kn = 0;
    if (!key) return -EINVAL;
    while (key[kn]) kn++;
    return js_obj_setn(o, key, kn, child);
}
int js_arr_push(js_val *a, js_val *child) {
    int r;
    if (!a || a->kind != JS_ARR || !child || child == a) return -EINVAL;
    r = js_room(a);
    if (r) return r;
    a->items[a->n++] = child;
    return 0;
}
/* js_clone(v): deep copy of the whole tree V, or 0 (V is 0, or out of memory: everything allocated so far is
   freed, nothing leaks). Object member order and repeated keys, array order, strings with embedded NUL (slen
   bytes) and number bit patterns (-0, NaN payload) are kept. The clone shares no node and no byte with V:
   free either tree first, then the other. Pair it with js_free. */
js_val *js_clone(const js_val *v) {
    js_val *r; long i;
    if (!v) return 0;
    r = js_mk(v->kind);
    if (!r) return 0;
    r->b = v->b; r->num = v->num;
    if (v->s) {
        r->s = (char *)mm_alloc(v->slen + 1);
        if (!r->s || (v->slen > 0 && mm_copy(r->s, v->slen + 1, v->s, v->slen))) { js_free(r); return 0; }
        r->s[v->slen] = 0; r->slen = v->slen;
    }
    for (i = 0; i < v->n; i++) {
        js_val *c; int e;
        c = js_clone(v->items[i]);
        if (!c) { js_free(r); return 0; }
        e = v->kind == JS_OBJ ? js_obj_setn(r, v->keys[i], v->klens[i], c) : js_arr_push(r, c);
        if (e) { js_free(c); js_free(r); return 0; }
    }
    return r;
}
/* ---- editing: js_obj_put / js_obj_del, folding parse, tree sanity check ----
     int js_obj_putn(o, key, kn, child) / js_obj_put(o, key, child)   JS "o[k] = v" (see the header)
     int js_obj_deln(o, key, kn) / js_obj_del(o, key)                 JS "delete o[k]"
   put: the key exists -> the FIRST matching member takes CHILD, its old value is freed (key and position
   kept); no such key -> appended like js_obj_set. Errors as js_obj_set: -EINVAL (bad container kind, null key
   or child, child is the container itself), -ENOMEM on the append path; on any failure CHILD stays with the
   caller and the object is unchanged. Putting the very node the first match already holds is a no-op returning 0
   (nothing is freed). del: removes every member with that key, frees their keys and values, keeps the order of
   the rest; returns 0 whether or not the key existed, -EINVAL for a bad container kind or null key. */
static long js_findk(const js_val *o, const char *key, long kn) {
    long i;
    for (i = 0; i < o->n; i++)
        if (o->klens[i] == kn && mm_same(o->keys[i], key, kn)) return i;
    return -1;
}
int js_obj_putn(js_val *o, const char *key, long kn, js_val *child) {
    long at;
    if (!o || o->kind != JS_OBJ || !key || kn < 0 || !child || child == o) return -EINVAL;
    at = js_findk(o, key, kn);
    if (at < 0) return js_obj_setn(o, key, kn, child);
    if (o->items[at] == child) return 0;
    js_free(o->items[at]);
    o->items[at] = child;
    return 0;
}
int js_obj_put(js_val *o, const char *key, js_val *child) {
    long kn = 0;
    if (!key) return -EINVAL;
    while (key[kn]) kn++;
    return js_obj_putn(o, key, kn, child);
}
int js_obj_deln(js_val *o, const char *key, long kn) {
    long i, w = 0;
    if (!o || o->kind != JS_OBJ || !key || kn < 0) return -EINVAL;
    for (i = 0; i < o->n; i++) {
        if (o->klens[i] == kn && mm_same(o->keys[i], key, kn)) { js_free(o->items[i]); mm_free(o->keys[i]); continue; }
        o->items[w] = o->items[i]; o->keys[w] = o->keys[i]; o->klens[w] = o->klens[i];
        w++;
    }
    o->n = w;
    return 0;
}
int js_obj_del(js_val *o, const char *key) {
    long kn = 0;
    if (!key) return -EINVAL;
    while (key[kn]) kn++;
    return js_obj_deln(o, key, kn);
}
/* js_assert_tree(v): debug check of the tree-ownership contract (no allocation inside the tree is touched).
   Walks every node reachable from V and returns 0, -EEXIST when some node is reachable by two paths (a child
   attached to two parents, or twice to one), -ELOOP when a node is its own ancestor or the nesting exceeds
   JS_MAXDEPTH (+1), -ENOMEM when its scratch list cannot grow. V == 0 is fine (0). Cost: O(nodes log nodes) time and
   one pointer per node of scratch memory; use it where a tree is assembled, not on hot paths. */
typedef struct { const js_val **a; long n, cap; const js_val *path[JS_MAXDEPTH + 3]; } js_atree;
static void js_sift(const js_val **a, long i, long n) {
    for (;;) {
        long c = 2 * i + 1;
        const js_val *t;
        if (c >= n) return;
        if (c + 1 < n && (unsigned long)a[c + 1] > (unsigned long)a[c]) c++;
        if ((unsigned long)a[i] >= (unsigned long)a[c]) return;
        t = a[i]; a[i] = a[c]; a[c] = t;
        i = c;
    }
}
/* sorts the list in place (it is a set) and reports -EEXIST when two entries are the same node */
static int js_dupcheck(js_atree *t) {
    long i;
    for (i = t->n / 2 - 1; i >= 0; i--) js_sift(t->a, i, t->n);
    for (i = t->n - 1; i > 0; i--) {
        const js_val *x = t->a[0]; t->a[0] = t->a[i]; t->a[i] = x;
        js_sift(t->a, 0, i);
    }
    for (i = 1; i < t->n; i++) if (t->a[i] == t->a[i - 1]) return -EEXIST;
    return 0;
}
static int js_awalk(js_atree *t, const js_val *v, int depth) {
    long i; int k, r;
    if (!v) return 0;
    if (depth > JS_MAXDEPTH + 1) return -ELOOP;
    for (k = 0; k < depth; k++) if (t->path[k] == v) return -ELOOP;
    t->path[depth] = v;
    if (t->n == t->cap) {
        long nc = t->cap ? t->cap * 2 : 64;
        const js_val **na;
        if (t->n) { r = js_dupcheck(t); if (r) return r; }   /* sharing is caught while the list grows, so a DAG blow-up stops early */
        na = (const js_val **)mm_grow(t->a, nc * (long)sizeof(js_val *));
        if (!na) return -ENOMEM;
        t->a = na; t->cap = nc;
    }
    t->a[t->n++] = v;
    if (v->kind == JS_ARR || v->kind == JS_OBJ)
        for (i = 0; i < v->n; i++) { r = js_awalk(t, v->items ? v->items[i] : 0, depth + 1); if (r) return r; }
    return 0;
}
int js_assert_tree(const js_val *v) {
    js_atree *t; int r;
    if (!v) return 0;
    t = (js_atree *)mm_zalloc((long)sizeof(js_atree));
    if (!t) return -ENOMEM;
    r = js_awalk(t, v, 0);
    if (!r && t->n > 1) r = js_dupcheck(t);
    mm_free(t->a); mm_free(t);
    return r;
}
