/* csih-ape.cx -- build csih.com, one APE file for six targets (apps/csih/docs/csih-com.md).
   From the repo root, one step per call (each slice compiles csih in ~45-50s):
     sh ./unisacc.com tools/csih-ape.cx -- slice lnx/x86_64     (then lnx/arm64, osx/x86_64, osx/arm64, win/x86_64)
     sh ./unisacc.com tools/csih-ape.cx -- pack                 -> apps/csih/csih.com (deflated slices) + out/csih-ape/manifest.tsv
     sh ./unisacc.com tools/csih-ape.cx -- verify               the files, their sha256 and today's sources agree
   Slices: apps/csih/csih.cx with -b TARGET for the four Unix targets; win/x86_64 is
   apps/csih/tools/win-unsupported.cx for now (csih's TUI is POSIX), and win/arm64 runs that PE.
   Each slice records the csih source digest (apps/csih/csih.sh digest) it was built from;
   pack refuses slices from different sources, verify refuses when today's sources differ.
   An L3 tool: no #include, no direct libc call (cx/sys, cx/text, the cx_* prelude). */
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use text.text

#define OUT "out/csih-ape"
#define COM "apps/csih/csih.com"
#define NS 5

static const char *const targets[NS] = { "win/x86_64", "lnx/x86_64", "lnx/arm64", "osx/x86_64", "osx/arm64" };
static const char *const files[NS] = { "csih_win64-x86.exe", "csih_lnx64-x86.bin", "csih_lnx64-arm.bin",
                                       "csih_osx64-x86.bin", "csih_osx64-arm.bin" };

static int eq(const char *a, const char *b) { return tx_eq(a, b, 4096); }

/* sha256 of PATH's bytes into HEX (65), 0 on success. cx_read's buffers are
   not freed: this is a one-shot CLI (a few files of a few MB), the process
   exit returns them, and an L3 tool calls no free() of its own. */
static int sha_file(const char *path, char hex[65]) {
    size_t n = 0;
    char *b = cx_read(path, &n);
    if (!b) return -1;
    cx_sha256_hex(b, n, hex);
    return 0;
}

/* the csih product source digest, as csih.sh prepare stamps it, into OUT (65) */
static int src_digest(char out[65]) {
    char buf[8192];
    char *av[] = { "sh", "apps/csih/csih.sh", "digest", 0 };
    int cut, rc = sy_run(av, buf, sizeof buf, &cut);
    long at = tx_find(buf, tx_len(buf, sizeof buf), "\ndigest ", 8);
    if (rc != 0 || at < 0) return -1;
    if (tx_copy(out, 65, buf + at + 8, 64) != 0) return -1;
    return tx_len(out, 65) == 64 ? 0 : -1;
}

/* the product version, from CSIH_VERSION in apps/csih/tui.cx, into V (32) */
static int csih_version(char v[32]) {
    size_t n = 0;
    char *s = cx_read("apps/csih/tui.cx", &n);
    long at = s ? tx_find(s, (long)n, "#define CSIH_VERSION \"", 22) : -1, e;
    if (at < 0) return -1;
    at += 22;
    e = tx_chr(s + at, (long)n - at, '"');
    if (e <= 0 || e > 31) return -1;
    return tx_copy(v, 32, s + at, e) == 0 ? 0 : -1;
}

static int slice(const char *target) {
    char path[256], side[300], d[65];
    const char *src = "apps/csih/csih.cx";
    int i, k = -1, rc;
    for (i = 0; i < NS; i++) if (eq(targets[i], target)) k = i;
    if (k < 0) { fprintf(stderr, "csih-ape: unknown target %s\n", target); return 2; }
    if (k == 0) src = "apps/csih/tools/win-unsupported.cx";
    if (src_digest(d) != 0) { fprintf(stderr, "csih-ape: cannot read the source digest\n"); return 1; }
    sy_mkdir("out", 0755);
    sy_mkdir(OUT, 0755);
    { if (cx_fmt(path, sizeof path, "%s/%s", OUT, files[k])) { fprintf(stderr, "csih-ape: text too long for path\n"); exit(2); } }
    {
        char *av[] = { "sh", "./unisacc.com", (char *)src, "-b", (char *)target, "-o", path, 0 };
        char *cap = 0;
        size_t n = 0;
        rc = cx_runv_timeout(av, 55, &cap, &n);
        if (rc != 0 && cap && n) fprintf(stderr, "%.*s", (int)(n > 2000 ? 2000 : n), cap);
    }
    if (rc != 0 || sy_exists(path) != 1) { fprintf(stderr, "csih-ape: slice %s failed rc=%d\n", target, rc); return 1; }
    { if (cx_fmt(side, sizeof side, "%s.src", path)) { fprintf(stderr, "csih-ape: text too long for side\n"); exit(2); } }
    if (cx_write(side, d, 64) != 0) { fprintf(stderr, "csih-ape: cannot write %s\n", side); return 1; }
    printf("CSIH_APE\tSLICE\t%s\t%s\tsrc=%s\n", target, path, d);
    return 0;
}

/* the digest recorded next to slice K, into D (65) */
static int slice_digest(int k, char d[65]) {
    char side[300];
    size_t n = 0;
    char *b;
    { if (cx_fmt(side, sizeof side, "%s/%s.src", OUT, files[k])) { fprintf(stderr, "csih-ape: text too long for side\n"); exit(2); } }
    b = cx_read(side, &n);
    if (!b || n != 64) return -1;
    tx_copy(d, 65, b, 64);
    return 0;
}

static int write_manifest(const char *d, const char *ver) {
    static char m[8192];
    char hex[65], path[256];
    int i, at = 0;
    at += snprintf(m + at, sizeof m - at, "# csih.com manifest: tools/csih-ape.cx pack\nsource_digest\t%s\nversion\t%s\n", d, ver);
    if (sha_file("unisacc.com", hex) != 0) return -1;
    at += snprintf(m + at, sizeof m - at, "compiler\tunisacc.com\t%s\n", hex);
    for (i = 0; i < NS; i++) {
        { if (cx_fmt(path, sizeof path, "%s/%s", OUT, files[i])) { fprintf(stderr, "csih-ape: text too long for path\n"); exit(2); } }
        if (sha_file(path, hex) != 0) return -1;
        at += snprintf(m + at, sizeof m - at, "slice\t%s\t%s\t%s\n", targets[i], files[i], hex);
    }
    if (sha_file(COM, hex) != 0) return -1;
    at += snprintf(m + at, sizeof m - at, "ape\t%s\t%s\n", COM, hex);
    { if (cx_fmt(path, sizeof path, "%s/manifest.tsv", OUT)) { fprintf(stderr, "csih-ape: text too long for path\n"); exit(2); } }
    return cx_write(path, m, (size_t)at);
}

static int pack(void) {
    char d[65], di[65], path[NS][256], ver[32], out[8192];
    char *com = COM;
    int i, rc, cut;
    if (src_digest(d) != 0) { fprintf(stderr, "csih-ape: cannot read the source digest\n"); return 1; }
    if (csih_version(ver) != 0) { fprintf(stderr, "csih-ape: no CSIH_VERSION in apps/csih/tui.cx\n"); return 1; }
    for (i = 0; i < NS; i++) {
        { if (cx_fmt(path[i], sizeof path[i], "%s/%s", OUT, files[i])) { fprintf(stderr, "csih-ape: text too long for path[i]\n"); exit(2); } }
        if (sy_exists(path[i]) != 1 || slice_digest(i, di) != 0) { fprintf(stderr, "csih-ape: slice %s missing: run slice %s\n", files[i], targets[i]); return 1; }
        if (!eq(di, d)) { fprintf(stderr, "csih-ape: slice %s was built from other sources (%s, today %s): rebuild it\n", files[i], di, d); return 1; }
    }
    {
        char *av[] = { "sh", "./unisacc.com", "-run", "ujs/product/ape-pack.cx", "--", "--tool", "csih", "--deflate", "--product", "csih", ver,
                       com, path[0], path[1], path[2], path[3], path[4], 0 };
        rc = sy_run(av, out, sizeof out, &cut);
    }
    if (rc != 0 || sy_exists(com) != 1) { fprintf(stderr, "csih-ape: ape-pack failed rc=%d\n%s", rc, out); return 1; }
    sy_chmod(com, 0755);
    if (write_manifest(d, ver) != 0) { fprintf(stderr, "csih-ape: cannot write the manifest\n"); return 1; }
    printf("CSIH_APE\tPACKED\t%s\tversion=%s\tsrc=%s\n", com, ver, d);
    return 0;
}

/* every manifest row against the files, and the source digest against today */
static int verify(void) {
    char path[256], hex[65], d[65];
    size_t n = 0;
    char *m;
    long len, at = 0;
    int rows = 0, bad = 0;
    { if (cx_fmt(path, sizeof path, "%s/manifest.tsv", OUT)) { fprintf(stderr, "csih-ape: text too long for path\n"); exit(2); } }
    m = cx_read(path, &n);
    if (!m) { printf("CSIH_APE\tREFUSED\tno %s: run pack\n", path); return 1; }
    len = (long)n;
    if (src_digest(d) != 0) { printf("CSIH_APE\tREFUSED\tcannot read the source digest\n"); return 1; }
    while (at < len) {
        long e = tx_chr(m + at, len - at, '\n');
        long ln = e < 0 ? len - at : e;
        char row[512], f1[64], f2[256], f3[96], f4[96];
        int nf;
        tx_copy(row, sizeof row, m + at, ln < 511 ? ln : 511);
        at += ln + 1;
        if (!row[0] || row[0] == '#') continue;
        {
            /* split on tabs (this runtime's sscanf has no %[ scanset) */
            char *f[4];
            int caps[4] = { 64, 256, 96, 96 }, j;
            long p = 0, rl = tx_len(row, sizeof row);
            f[0] = f1; f[1] = f2; f[2] = f3; f[3] = f4;
            for (nf = 0, j = 0; j < 4; j++) {
                long t = tx_chr(row + p, rl - p, '\t'), w = t < 0 ? rl - p : t;
                f[j][0] = 0;
                if (p > rl) continue;
                tx_copy(f[j], caps[j], row + p, w < caps[j] - 1 ? w : caps[j] - 1);
                nf++;
                p += w + 1;
            }
        }
        if (eq(f1, "source_digest")) {
            rows++;
            if (!eq(f2, d)) { printf("  FAIL  source digest %s, today %s: the slices are stale\n", f2, d); bad++; }
            else printf("  ok    source digest matches today's csih sources\n");
        } else if (eq(f1, "compiler") && nf >= 3) {
            rows++;
            if (sha_file(f2, hex) != 0 || !eq(hex, f3)) { printf("  FAIL  compiler %s changed since pack\n", f2); bad++; }
            else printf("  ok    compiler %s as packed\n", f2);
        } else if (eq(f1, "slice") && nf == 4) {
            rows++;
            { if (cx_fmt(path, sizeof path, "%s/%s", OUT, f3)) { fprintf(stderr, "csih-ape: text too long for path\n"); exit(2); } }
            if (sha_file(path, hex) != 0 || !eq(hex, f4)) { printf("  FAIL  slice %s (%s) differs from the manifest\n", f2, f3); bad++; }
            else printf("  ok    slice %s %s\n", f2, f3);
        } else if (eq(f1, "version") && nf >= 2) {
            char v[32];
            rows++;
            if (csih_version(v) != 0 || !eq(v, f2)) { printf("  FAIL  packed version %s, CSIH_VERSION in tui.cx differs\n", f2); bad++; }
            else printf("  ok    version %s matches CSIH_VERSION\n", f2);
        } else if (eq(f1, "ape") && nf >= 3) {
            rows++;
            if (!eq(f2, COM) || sha_file(f2, hex) != 0 || !eq(hex, f3)) { printf("  FAIL  %s differs from the manifest\n", f2); bad++; }
            else printf("  ok    %s as packed\n", f2);
        }
    }
    if (rows != NS + 4) { printf("  FAIL  manifest has %d rows, want %d\n", rows, NS + 4); bad++; }
    printf("CSIH_APE\t%s\trows=%d\tfail=%d\tsrc=%s\n", bad ? "REFUSED" : "VERIFIED", rows, bad, d);
    return bad ? 1 : 0;
}

/* little-endian fields of a header */
static unsigned u16(const char *b) { return (unsigned char)b[0] | ((unsigned char)b[1] << 8); }
static unsigned long u32(const char *b) { return (unsigned long)u16(b) | ((unsigned long)u16(b + 2) << 16); }

/* 1 when slice K's header declares its target's format and machine; WHY says what was seen */
static int header_ok(int k, const char *b, size_t n, char *why, int cap) {
    if (k == 0) {
        unsigned long pe;
        if (n < 0x40 || b[0] != 'M' || b[1] != 'Z') { cx_fmt(why, cap, "no MZ header"); return 0; }
        pe = u32(b + 0x3c);
        if (pe + 6 > n || b[pe] != 'P' || b[pe + 1] != 'E' || b[pe + 2] || b[pe + 3]) { cx_fmt(why, cap, "no PE signature"); return 0; }
        if (u16(b + pe + 4) != 0x8664) { cx_fmt(why, cap, "PE machine 0x%x, want 0x8664", u16(b + pe + 4)); return 0; }
        cx_fmt(why, cap, "PE x86-64 (0x8664)");
        return 1;
    }
    if (k <= 2) {
        unsigned want = k == 1 ? 62 : 183;
        if (n < 20 || b[0] != 0x7f || b[1] != 'E' || b[2] != 'L' || b[3] != 'F' || b[4] != 2) { cx_fmt(why, cap, "no ELF64 header"); return 0; }
        if (u16(b + 18) != want) { cx_fmt(why, cap, "ELF machine %u, want %u", u16(b + 18), want); return 0; }
        cx_fmt(why, cap, "ELF64 machine %u (%s)", want, k == 1 ? "x86-64" : "aarch64");
        return 1;
    }
    {
        unsigned long want = k == 3 ? 0x01000007ul : 0x0100000cul;
        if (n < 8 || u32(b) != 0xfeedfacful) { cx_fmt(why, cap, "no Mach-O 64 header"); return 0; }
        if (u32(b + 4) != want) { cx_fmt(why, cap, "Mach-O cputype 0x%lx, want 0x%lx", u32(b + 4), want); return 0; }
        cx_fmt(why, cap, "Mach-O 64 cputype 0x%lx (%s)", want, k == 3 ? "x86_64" : "arm64");
        return 1;
    }
}

/* the decimal after KEY in S[0..n), or -1 */
static long number_after(const char *s, long n, const char *key) {
    long at = tx_find(s, n, key, tx_len(key, 64)), v = 0, d = 0;
    if (at < 0) return -1;
    for (at += tx_len(key, 64); at < n && s[at] >= '0' && s[at] <= '9'; at++, d++) v = v * 10 + (s[at] - '0');
    return d ? v : -1;
}

/* 1 when csih.com carries slice K. The PE slice sits in the file as is (after its rewritten
   headers): 64-byte windows at 1/4, 1/2 and 3/4 of it are found. A Unix slice is the gzip
   member the shell header names (o= n= on its uname line): it is cut out, inflated by the
   system's gzip -dc, the same command the launcher runs, and compared byte for byte. */
static int carries(int k, const char *com, size_t cn, const char *b, size_t n, char *why, int cap) {
    static const char *const line[NS] = { "", "  Linuxx86_64) o=", "  Linuxaarch64|Linuxarm64) o=",
                                          "  Darwinx86_64) o=", "  Darwinarm64) o=" };
    char gzp[256];
    char *av[] = { "gzip", "-dc", gzp, 0 };
    char *back = 0;
    size_t bn = 0;
    long head = cn < 8192 ? (long)cn : 8192, at, o, len;
    int q, rc;
    if (k == 0) {
        if (n < 2048) { cx_fmt(why, cap, "PE slice too short"); return 0; }
        for (q = 1; q <= 3; q++)
            if (tx_find(com, (long)cn, b + n * q / 4, 64) < 0) { cx_fmt(why, cap, "PE body window %d/4 not found", q); return 0; }
        cx_fmt(why, cap, "PE body found as is");
        return 1;
    }
    at = tx_find(com, head, line[k], tx_len(line[k], 64));
    if (at < 0) { cx_fmt(why, cap, "no uname line in the shell header"); return 0; }
    o = number_after(com + at, head - at, " o=");
    len = number_after(com + at, head - at, " n=");
    if (o < 1 || len <= 0 || o - 1 + len > (long)cn) { cx_fmt(why, cap, "bad o=%ld n=%ld", o, len); return 0; }
    if (cx_fmt(gzp, sizeof gzp, "%s/.smoke-%d.gz", OUT, k) || cx_write(gzp, com + o - 1, (size_t)len) != 0) { cx_fmt(why, cap, "cannot write %s", gzp); return 0; }
    rc = cx_runv_timeout(av, 20, &back, &bn);
    if (rc != 0 || bn != n || !tx_same(back, (long)bn, b, (long)n)) { cx_fmt(why, cap, "gzip -dc rc=%d gave %ld bytes, slice %ld", rc, (long)bn, (long)n); return 0; }
    cx_fmt(why, cap, "gzip member %ld -> %ld bytes, identical", len, (long)n);
    return 1;
}

/* run AV for at most SECS: 1 when it exits 0 and its output holds WANT; TAIL gets the output's end */
static int runs(char **av, int secs, const char *want, char *tail, int cap) {
    char *out = 0;
    size_t n = 0;
    int rc = cx_runv_timeout(av, secs, &out, &n);
    long at = out ? tx_find(out, (long)n, want, tx_len(want, 256)) : -1;
    long from = (long)n > 120 ? (long)n - 120 : 0, i;
    tail[0] = 0;
    if (out) tx_copy(tail, cap, out + from, (long)n - from < cap - 1 ? (long)n - from : cap - 1);
    for (i = 0; tail[i]; i++) if (tail[i] == '\n' || tail[i] == '\t') tail[i] = ' ';
    return rc == 0 && at >= 0;
}

/* what this machine can check, slice by slice; what it cannot run is UNMEASURED */
static int smoke(void) {
    char *com = COM, path[256], why[160], tail[160], qemu[512], ver[32], want[48];
    size_t cn = 0;
    char *c;
    const char *home = sy_env("HOME");
    int i, bad = 0, ran = 0, unm = 0;
    c = cx_read(com, &cn);
    if (!c) { printf("CSIH_APE\tREFUSED\tno %s: run pack\n", com); return 1; }
    for (i = 0; i < NS; i++) {
        size_t n = 0;
        char *b;
        { if (cx_fmt(path, sizeof path, "%s/%s", OUT, files[i])) { fprintf(stderr, "csih-ape: text too long for path\n"); exit(2); } }
        b = cx_read(path, &n);
        if (!b) { printf("  FAIL  %s: missing\n", files[i]); bad++; continue; }
        if (!header_ok(i, b, n, why, sizeof why)) { printf("  FAIL  %s header: %s\n", targets[i], why); bad++; }
        else printf("  ok    %s header: %s\n", targets[i], why);
        if (!carries(i, c, cn, b, n, why, sizeof why)) { printf("  FAIL  csih.com does not carry %s: %s\n", files[i], why); bad++; }
        else printf("  ok    csih.com carries %s: %s\n", files[i], why);
    }
    printf("  note  %s is %ld bytes\n", com, (long)cn);
    if (csih_version(ver) != 0 || cx_fmt(want, sizeof want, "csih %s\n", ver)) { printf("  FAIL  no CSIH_VERSION in apps/csih/tui.cx\n"); bad++; }
    else {
        char *v1[] = { "sh", com, "--version", 0 }, *v2[] = { "sh", com, "-v", 0 };
        if (!runs(v1, 20, want, tail, sizeof tail) || !runs(v2, 20, want, tail, sizeof tail)) { printf("  FAIL  csih.com --version / -v: %s\n", tail); bad++; }
        else printf("  ok    csih.com --version and -v print csih %s\n", ver);
    }
    {
        char *av[] = { "sh", com, "selftest", 0 };
        if (!runs(av, 30, "selftest ok", tail, sizeof tail)) { printf("  FAIL  host csih.com selftest: %s\n", tail); bad++; }
        else { printf("  ok    host (lnx/x86_64) runs csih.com selftest\n"); ran++; }
    }
    qemu[0] = 0;
    if (home && cx_fmt(qemu, sizeof qemu, "%s/.local/bin/qemu-aarch64-static", home) == 0 && sy_exists(qemu) != 1) qemu[0] = 0;
    if (!qemu[0] && sy_exists("/usr/bin/qemu-aarch64-static") == 1) tx_copy(qemu, sizeof qemu, "/usr/bin/qemu-aarch64-static", 28);
    if (!qemu[0] || sy_exists("/usr/aarch64-linux-gnu") != 1) { printf("  UNMEASURED  lnx/arm64 run: no qemu-aarch64-static or aarch64 sysroot\n"); unm++; }
    else {
        char *av[] = { qemu, "-L", "/usr/aarch64-linux-gnu", path, "selftest", 0 };
        { if (cx_fmt(path, sizeof path, "%s/%s", OUT, files[2])) { fprintf(stderr, "csih-ape: text too long for path\n"); exit(2); } }
        if (!runs(av, 45, "selftest ok", tail, sizeof tail)) { printf("  FAIL  lnx/arm64 slice selftest under qemu-user: %s\n", tail); bad++; }
        else { printf("  ok    lnx/arm64 slice runs selftest under qemu-user (the slice, not csih.com's pick)\n"); ran++; }
    }
    printf("  UNMEASURED  osx/x86_64, osx/arm64 run: no macOS here, headers only\n");
    printf("  UNMEASURED  win/x86_64 run: no Windows here, header only (the slice is the unsupported stub)\n");
    unm += 3;
    printf("CSIH_APE\t%s\tran=%d\tfail=%d\tunmeasured=%d\n", bad ? "SMOKE_FAIL" : "SMOKE_OK", ran, bad, unm);
    return bad ? 1 : 0;
}

int main(int argc, char **argv) {
    if (sy_exists("./unisacc.com") != 1 || sy_exists("apps/csih/csih.sh") != 1) {
        fprintf(stderr, "csih-ape: run from the repo root\n");
        return 2;
    }
    if (argc == 3 && eq(argv[1], "slice")) return slice(argv[2]);
    if (argc == 2 && eq(argv[1], "pack")) return pack();
    if (argc == 2 && eq(argv[1], "verify")) return verify();
    if (argc == 2 && eq(argv[1], "smoke")) return smoke();
    fprintf(stderr, "usage: csih-ape.cx -- slice TARGET | pack | verify | smoke\n");
    return 2;
}
