#pragma unisa use chrome_dom
/* tools/check-uxe-font.cx -- 82x30 整图 vs 5x7 展开,外框全 0.
 */
static int failed;
static void ck(int ok, const char *lab) {
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", lab);
    if (!ok) failed++;
}
static unsigned char col[4][5] = {
    {126, 9, 9, 9, 126},
    {0, 66, 127, 64, 0},
    {0, 65, 127, 65, 0},
    {62, 65, 65, 65, 62}
};
int main(void) {
    char cwd[512], url[700];
    const char *pre = "file://";
    const char *suf = "/ujs/practice/uxe/test/uxe-font.html";
    char *av[12];
    char *out = 0;
    size_t on = 0;
    int n, i, rc, W = 82, H = 30, s = 4, pad = 1, ng = 0, match = 0, gi, x, y, px, py, k, border = 1, cell;
    int *exp, *got;
    const char *p;
    if (!getcwd(cwd, sizeof cwd)) return 2;
    n = 0;
    while (pre[n]) { url[n] = pre[n]; n++; }
    for (i = 0; cwd[i] && n < 500; i++) url[n++] = cwd[i];
    for (i = 0; suf[i] && n < 640; i++) url[n++] = suf[i];
    url[n] = 0;
    exp = (int *)malloc((size_t)W * H * sizeof(int));
    got = (int *)malloc((size_t)W * H * sizeof(int));
    if (!exp || !got) return 2;
    for (i = 0; i < W * H; i++) exp[i] = 0;
    for (gi = 0; gi < 4; gi++)
        for (x = 0; x < 5; x++)
            for (y = 0; y < 7; y++) {
                if (!((col[gi][x] >> y) & 1)) continue;
                for (py = 0; py < s; py++)
                    for (px = 0; px < s; px++) {
                        k = (pad + y * s + py) * W + (pad + gi * 5 * s + x * s + px);
                        if (k >= 0 && k < W * H) exp[k] = 1;
                    }
            }
    av[0] = "/usr/bin/google-chrome";
    av[1] = "--headless=new";
    av[2] = "--enable-unsafe-swiftshader";
    av[3] = "--allow-file-access-from-files";
    av[4] = "--disable-web-security";
    av[5] = "--no-first-run";
    av[6] = "--user-data-dir=/tmp/uxe-font-chk";
    av[7] = "--virtual-time-budget=20000";
    av[8] = "--dump-dom";
    av[9] = url;
    av[10] = 0;
    rc = cx_runv_timeout(av, 25, &out, &on);
    if (rc == 127) { if (out) free(out); free(exp); free(got); printf("FONT_UNMEASURED\n"); return 2; }
    p = out ? strstr(out, "\"bits\":[") : 0;
    if (p) {
        p += 8;
        while (*p && ng < W * H) {
            if (*p == '0' || *p == '1') got[ng++] = *p - '0';
            if (*p == ']') break;
            p++;
        }
    }
    if (out) free(out);
    ck(ng == W * H, "nbits");
    match = (ng == W * H);
    if (match) for (i = 0; i < W * H; i++) if (got[i] != exp[i]) match = 0;
    ck(match, "bits-eq");
    if (ng == W * H) {
        for (x = 0; x < W; x++) {
            if (got[x] || got[(H - 1) * W + x]) border = 0;
        }
        for (y = 0; y < H; y++) {
            if (got[y * W] || got[y * W + (W - 1)]) border = 0;
        }
    } else border = 0;
    ck(border, "border0");
    cell = 0;
    for (i = 0; i < W * H; i++) if (exp[i]) cell++;
    printf("CHECK_UXE_FONT\tng=%d\tmatch=%d\tcell=%d\tfailed=%d\n", ng, match, cell, failed);
    free(exp); free(got);
    {
        unsigned char c2[5] = {66, 97, 81, 73, 70};
        int W2 = 22, H2 = 30;
        const char *suf2 = "/ujs/practice/uxe/test/uxe-font-2.html";
        n = 0;
        while (pre[n]) { url[n] = pre[n]; n++; }
        for (i = 0; cwd[i] && n < 500; i++) url[n++] = cwd[i];
        for (i = 0; suf2[i] && n < 640; i++) url[n++] = suf2[i];
        url[n] = 0;
        exp = (int *)malloc((size_t)W2 * H2 * sizeof(int));
        got = (int *)malloc((size_t)W2 * H2 * sizeof(int));
        if (!exp || !got) return 2;
        for (i = 0; i < W2 * H2; i++) exp[i] = 0;
        for (x = 0; x < 5; x++)
            for (y = 0; y < 7; y++) {
                if (!((c2[x] >> y) & 1)) continue;
                for (py = 0; py < s; py++)
                    for (px = 0; px < s; px++) {
                        k = (pad + y * s + py) * W2 + (pad + x * s + px);
                        if (k >= 0 && k < W2 * H2) exp[k] = 1;
                    }
            }
        av[6] = "--user-data-dir=/tmp/uxe-font-chk2";
        av[9] = url;
        out = 0; on = 0; ng = 0;
        rc = cx_runv_timeout(av, 25, &out, &on);
        p = out ? strstr(out, "\"bits\":[") : 0;
        if (p) {
            p += 8;
            while (*p && ng < W2 * H2) {
                if (*p == '0' || *p == '1') got[ng++] = *p - '0';
                if (*p == ']') break;
                p++;
            }
        }
        if (out) free(out);
        ck(ng == W2 * H2, "nbits-2");
        match = (ng == W2 * H2);
        if (match) for (i = 0; i < W2 * H2; i++) if (got[i] != exp[i]) match = 0;
        ck(match, "bits-eq-2");
        printf("CHECK_UXE_FONT2\tng=%d\tmatch=%d\n", ng, match);
        free(exp); free(got);
    }
    {
        FILE *tf;
        char line[128], cmap[128][5];
        int have[128], W3 = 282, H3 = 90, per = 14, gap = 2, ri, ci, ch, nv;
        const char *str = "0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ.:-/%";
        const char *suf3 = "/ujs/practice/uxe/test/uxe-font-all.html";
        for (i = 0; i < 128; i++) have[i] = 0;
        tf = fopen("ujs/practice/uxe/test/font5x7.tsv", "r");
        ck(tf != 0, "tsv-open");
        if (tf) {
            if (!fgets(line, sizeof line, tf)) { }
            while (fgets(line, sizeof line, tf)) {
                ch = (unsigned char)line[0];
                if (ch == '\t' || ch == '\n') continue;
                p = line + 1;
                if (*p == '\t') p++;
                for (x = 0; x < 5; x++) {
                    nv = 0;
                    while (*p >= '0' && *p <= '9') { nv = nv * 10 + (*p - '0'); p++; }
                    cmap[ch][x] = (unsigned char)nv;
                    if (*p == '\t') p++;
                }
                have[ch] = 1;
            }
            fclose(tf);
        }
        n = 0;
        while (pre[n]) { url[n] = pre[n]; n++; }
        for (i = 0; cwd[i] && n < 500; i++) url[n++] = cwd[i];
        for (i = 0; suf3[i] && n < 640; i++) url[n++] = suf3[i];
        url[n] = 0;
        exp = (int *)malloc((size_t)W3 * H3 * sizeof(int));
        got = (int *)malloc((size_t)W3 * H3 * sizeof(int));
        if (!exp || !got) return 2;
        for (i = 0; i < W3 * H3; i++) exp[i] = 0;
        for (ci = 0; str[ci]; ci++) {
            ch = (unsigned char)str[ci];
            ri = ci / per;
            x = ci % per;
            if (!have[ch]) continue;
            for (gi = 0; gi < 5; gi++)
                for (y = 0; y < 7; y++) {
                    if (!((cmap[ch][gi] >> y) & 1)) continue;
                    for (py = 0; py < s; py++)
                        for (px = 0; px < s; px++) {
                            k = (pad + ri * (7 * s + gap) + y * s + py) * W3 + (pad + x * 5 * s + gi * s + px);
                            if (k >= 0 && k < W3 * H3) exp[k] = 1;
                        }
                }
        }
        av[6] = "--user-data-dir=/tmp/uxe-font-chka2";

        av[9] = url;
        out = 0; on = 0; ng = 0;
        rc = cx_runv_timeout(av, 25, &out, &on);
        p = out ? strstr(out, "\"bits\":[") : 0;
        if (p) {
            p += 8;
            while (*p && ng < W3 * H3) {
                if (*p == '0' || *p == '1') got[ng++] = *p - '0';
                if (*p == ']') break;
                p++;
            }
        }
        if (out) free(out);
        ck(ng == W3 * H3, "nbits-all");
        match = (ng == W3 * H3);
        if (match) for (i = 0; i < W3 * H3; i++) if (got[i] != exp[i]) match = 0;
        ck(match, "bits-eq-all");
        printf("CHECK_UXE_FONT_ALL\tng=%d\tmatch=%d\n", ng, match);
        free(exp); free(got);
    }
    return failed ? 1 : 0;
}

