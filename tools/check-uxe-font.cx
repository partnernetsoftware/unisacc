#pragma unisa use chrome_dom
/* tools/check-uxe-font.cx -- A1I0 5x7 vs 页 bits.
 */
static int failed;
static void ck(int ok, const char *lab) {
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", lab);
    if (!ok) failed++;
}
static unsigned char col[4][5] = {
    {126, 9, 9, 9, 126},
    {0, 66, 127, 64, 0},
    {0, 65, 127, 65, 0},
    {62, 65, 65, 65, 62}
};
int main(void) {
    char cwd[512], url[700];
    const char *pre = "file://";
    const char *suf = "/ujs/practice/uxe/test/uxe-font.html";
    char *av[12];
    char *out = 0;
    size_t on = 0;
    int n, i, rc, exp[140], got[140], ng = 0, match = 0, gi, x, y, k;
    const char *p;
    if (!getcwd(cwd, sizeof cwd)) return 2;
    n = 0;
    while (pre[n]) { url[n] = pre[n]; n++; }
    for (i = 0; cwd[i] && n < 500; i++) url[n++] = cwd[i];
    for (i = 0; suf[i] && n < 640; i++) url[n++] = suf[i];
    url[n] = 0;
    k = 0;
    for (y = 0; y < 7; y++)
        for (gi = 0; gi < 4; gi++)
            for (x = 0; x < 5; x++)
                exp[k++] = (col[gi][x] >> y) & 1;
    av[0] = "/usr/bin/google-chrome";
    av[1] = "--headless=new";
    av[2] = "--enable-unsafe-swiftshader";
    av[3] = "--allow-file-access-from-files";
    av[4] = "--disable-web-security";
    av[5] = "--no-first-run";
    av[6] = "--user-data-dir=/tmp/uxe-font-chk";
    av[7] = "--virtual-time-budget=20000";
    av[8] = "--dump-dom";
    av[9] = url;
    av[10] = 0;
    rc = cx_runv_timeout(av, 25, &out, &on);
    if (rc == 127) { if (out) free(out); printf("FONT_UNMEASURED\n"); return 2; }
    p = out ? strstr(out, "\"bits\":[") : 0;
    if (p) {
        p += 8;
        while (*p && ng < 140) {
            if (*p == '0' || *p == '1') got[ng++] = *p - '0';
            if (*p == ']') break;
            p++;
        }
    }
    if (out) free(out);
    ck(ng == 140, "nbits");
    match = (ng == 140);
    if (match) for (i = 0; i < 140; i++) if (got[i] != exp[i]) match = 0;
    ck(match, "bits-eq");
    printf("CHECK_UXE_FONT\tng=%d\tmatch=%d\tfailed=%d\n", ng, match, failed);
    return failed ? 1 : 0;
}
