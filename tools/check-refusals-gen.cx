/* tools/check-refusals-gen.cx -- tools/refusals-gen.cx 的检查:夹具表验证生成内容、编号、坏行拒绝、篡改检测,并经 sys.refusals 实调仓内产物、核对仓内表与产物一致。
 *
 *   sh ./unisacc.com tools/check-refusals-gen.cx
 */
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.posix
#pragma unisa use sys.refusals
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.bytes
#pragma unisa use mem.heap

static int failed, nok;
static char dir[320];
static void ck(int ok, const char *name) {
    if (ok) { nok++; sy_printf("PASS\tcheck-refusals-gen.%s\n", name); }
    else { failed++; sy_printf("FAIL\tcheck-refusals-gen.%s\n", name); }
}
static void mk(const char *rel) { char p[500]; cx_fmt(p, sizeof p, "%s/%s", dir, rel); mkdir(p, 0700); }
static void put(const char *rel, const char *body) {
    char p[500];
    cx_fmt(p, sizeof p, "%s/%s", dir, rel);
    cx_write(p, body, tx_len(body, 100000));
}
static int run(const char *root, const char *mode, char *out, long cap) {
    char cmd[900]; char *o = 0; size_t n = 0; int rc;
    cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com tools/refusals-gen.cx -- %s --root %s", mode, root);
    char *v[] = {"sh", "-c", cmd, 0};
    rc = cx_runv_timeout(v, 50, &o, &n);
    out[0] = 0; if (o && (long)n < cap) { mm_copy(out, cap, o, n); out[n] = 0; }
    return rc;
}
static int hasl(const char *h, const char *lit) {
    long hn = tx_len(h, 200000), ln = tx_len(lit, 4096), i;
    if (hn < 0) hn = 200000; /* 超 cap:只查 cap 内,不把 -1 当长度 */
    for (i = 0; i + ln <= hn; i++) if (h[i] == lit[0] && mm_same(h + i, lit, ln)) return 1;
    return 0;
}
static int seq(const char *a, const char *b) {
    long n = tx_len(a, 4096);
    return n == tx_len(b, 4096) && mm_same(a, b, n);
}
#define HDR "# refusals v1\n# id\ttarget\torigin\treason\tsince\ttracking\n"
#define ROW_A "AA_ONE\twin\tcx/sys/a.cx:fa\tfirst reason\t0.0.1\t-\n"
#define ROW_B "BB_TWO\tosx\tcx/sys/a.cx:fa\tsecond reason\t0.0.1\tstd-surface:sy_x\n"
/* 坏表必须 rc 2、打出 why,且不改已有产物 */
static void bad(const char *body, const char *why, const char *name) {
    char out[4096], p[500]; size_t m = 0; char *t; int rc;
    put("exec/facts/refusals.tsv", body);
    rc = run(dir, "--write", out, sizeof out);
    cx_fmt(p, sizeof p, "%s/cx/sys/refusals.cx", dir);
    t = cx_read(p, &m);
    ck(rc == 2 && hasl(out, "REFUSE\texec/facts/refusals.tsv") && hasl(out, why) && t && m == 6 && mm_same(t, "KEEP\n\n", 6), name);
}

int main(void) {
    char out[8192], p[500]; char *t; size_t m = 0;
    int rc, i, good;
    if (cx_fmt(dir, sizeof dir, "%s/refusals-check-XXXXXX", sy_tmpdir()) || !mkdtemp(dir)) { ck(0, "tmpdir"); return 1; }
    mk("exec"); mk("exec/facts"); mk("cx"); mk("cx/sys");
    put("exec/facts/refusals.tsv", HDR ROW_A "\n" ROW_B);
    rc = run(dir, "--write", out, sizeof out);
    ck(rc == 0 && hasl(out, "REFUSALS_GEN\tWROTE\trows=2"), "write-summary");
    rc = run(dir, "--check", out, sizeof out);
    ck(rc == 0 && hasl(out, "REFUSALS_GEN\tok\trows=2"), "check-ok");
    cx_fmt(p, sizeof p, "%s/cx/sys/refusals.cx", dir);
    t = cx_read(p, &m);
    if (!t) { ck(0, "read-output"); return 1; }
    { char *z = mm_alloc((long)m + 1); mm_copy(z, (long)m + 1, t, (long)m); z[m] = 0; t = z; }
    ck(m > 30 && mm_same(t, "#pragma unisa module refusals\n#pragma unisa dock\n", 49), "module-header-first");
    ck(hasl(t, "Generated by tools/refusals-gen.cx --write from exec/facts/refusals.tsv; do not edit by hand."), "generated-banner");
    ck(hasl(t, "    SY_REFUSAL_NONE = 0,\n    SY_REFUSAL_AA_ONE = 1,\n    SY_REFUSAL_BB_TWO = 2,\n    SY_REFUSAL_COUNT = 3\n};"), "ids-are-row-order");
    ck(hasl(t, "sy_refusal_reasons[SY_REFUSAL_COUNT] = {\n    \"\",\n    \"first reason\",\n    \"second reason\",\n};"), "reason-table");
    ck(hasl(t, "sy_refusal_origins[SY_REFUSAL_COUNT] = {\n    \"\",\n    \"cx/sys/a.cx:fa\",\n    \"cx/sys/a.cx:fa\",\n};"), "origin-table-same-origin-two-targets");
    ck(hasl(t, "sy_refusal_targets[SY_REFUSAL_COUNT] = {\n    \"\",\n    \"win\",\n    \"osx\",\n};"), "target-table");
    ck(hasl(t, "const char *sy_refusal_reason(int id) {\n    if (id <= 0 || id >= SY_REFUSAL_COUNT) return \"unknown refusal\";"), "reason-getter-bounds");
    ck(hasl(t, "int sy_refusal_count(void)") && hasl(t, "const char *sy_refusal_name(int id)") && hasl(t, "const char *sy_refusal_target(int id)") && hasl(t, "const char *sy_refusal_origin(int id)"), "all-getters");
    ck(!hasl(t, "#include") && !hasl(t, "#if") && !hasl(t, "ENOSYS") && !hasl(t, "0.0.1") && !hasl(t, "std-surface"), "no-include-no-platform-if-no-bookkeeping-columns");
    /* 追加一行不改既有编号 */
    put("exec/facts/refusals.tsv", HDR ROW_A ROW_B "CC_3\tall\text/x.cx:g\tthird\t0.0.2\t-\n");
    rc = run(dir, "--check", out, sizeof out);
    ck(rc == 1 && hasl(out, "DIFF\tcx/sys/refusals.cx") && hasl(out, "REFUSALS_GEN\tFAIL\trows=3"), "stale-output-detected");
    rc = run(dir, "--write", out, sizeof out);
    t = cx_read(p, &m);
    if (t) { char *z = mm_alloc((long)m + 1); mm_copy(z, (long)m + 1, t, (long)m); z[m] = 0; t = z; }
    ck(rc == 0 && t && hasl(t, "SY_REFUSAL_AA_ONE = 1,\n    SY_REFUSAL_BB_TWO = 2,\n    SY_REFUSAL_CC_3 = 3,\n    SY_REFUSAL_COUNT = 4\n"), "append-keeps-ids");
    put("cx/sys/refusals.cx", "tampered\n");
    rc = run(dir, "--check", out, sizeof out);
    ck(rc == 1 && hasl(out, "DIFF\tcx/sys/refusals.cx\tline=1"), "tamper-detected");
    /* 坏行拒绝 */
    put("cx/sys/refusals.cx", "KEEP\n\n");
    bad(HDR "AA\twin\tcx/a.cx:f\treason\t0.0.1\n", "field-count", "refuse-five-fields");
    bad(HDR "AA\twin\tcx/a.cx:f\treason\t0.0.1\t-\textra\n", "field-count", "refuse-seven-fields");
    bad(HDR "AA\twin\tcx/a.cx:f\t\t0.0.1\t-\n", "empty-field", "refuse-empty-reason");
    bad(HDR "aa\twin\tcx/a.cx:f\treason\t0.0.1\t-\n", "bad-id", "refuse-lowercase-id");
    bad(HDR "1A\twin\tcx/a.cx:f\treason\t0.0.1\t-\n", "bad-id", "refuse-digit-first-id");
    bad(HDR "AA\tbsd\tcx/a.cx:f\treason\t0.0.1\t-\n", "bad-target", "refuse-unknown-target");
    bad(HDR "AA\twin\tcx/a.cx\treason\t0.0.1\t-\n", "bad-origin", "refuse-origin-without-function");
    bad(HDR "AA\twin\tcx/a.cx:f:g\treason\t0.0.1\t-\n", "bad-origin", "refuse-origin-two-colons");
    bad(HDR "AA\twin\tcx/a.cx:f\tsay \"x\"\t0.0.1\t-\n", "bad-reason", "refuse-quote-in-reason");
    bad(HDR "AA\twin\tcx/a.cx:f\tback\\slash\t0.0.1\t-\n", "bad-reason", "refuse-backslash-in-reason");
    bad(HDR "AA\twin\tcx/a.cx:f\t\xe4\xb8\xad\t0.0.1\t-\n", "bad-reason", "refuse-non-ascii-reason");
    bad(HDR ROW_A "AA_ONE\tosx\tcx/sys/b.cx:fb\tother\t0.0.1\t-\n", "duplicate-id", "refuse-duplicate-id");
    bad(HDR ROW_A "ZZ\twin\tcx/sys/a.cx:fa\tother\t0.0.1\t-\n", "duplicate-origin-target", "refuse-duplicate-origin-target");
    bad(HDR ROW_A "ZZ\twin\tcx/sys/b.cx:fb\tother\t0.0.1\t-\n" "\tbad\n", "line=5", "refuse-reports-line-number");
    bad(HDR, "no-rows", "refuse-empty-table");
    rc = run(dir, "--bogus", out, sizeof out);
    ck(rc == 2 && hasl(out, "usage:"), "usage-rc2");
    cx_fmt(p, sizeof p, "%s/exec/facts/refusals.tsv", dir);
    unlink(p);
    rc = run(dir, "--write", out, sizeof out);
    ck(rc == 2 && hasl(out, "unreadable"), "missing-table-refused");
    /* 仓内产物:与表一致,并经 sys.refusals 实调 */
    rc = run(".", "--check", out, sizeof out);
    ck(rc == 0 && hasl(out, "REFUSALS_GEN\tok"), "repo-output-current");
    ck(sy_refusal_count() == SY_REFUSAL_COUNT - 1 && sy_refusal_count() >= 10, "linked-count");
    ck(SY_REFUSAL_NONE == 0 && SY_REFUSAL_FS_FDATASYNC_WIN == 1 && SY_REFUSAL_FS_MKFIFO_OSX == 4 && SY_REFUSAL_MEM_PROT_WIN == 10, "linked-first-ids-pinned");
    ck(seq(sy_refusal_reason(SY_REFUSAL_FS_MKFIFO_WIN), "mkfifo: Windows has no FIFO special file"), "linked-reason-text");
    ck(seq(sy_refusal_name(SY_REFUSAL_FS_MKFIFO_OSX), "FS_MKFIFO_OSX") && seq(sy_refusal_target(SY_REFUSAL_FS_MKFIFO_OSX), "osx") && seq(sy_refusal_origin(SY_REFUSAL_FS_MKFIFO_OSX), "cx/sys/fs.cx:sy_mkfifo_os"), "linked-name-target-origin");
    ck(seq(sy_refusal_reason(0), "unknown refusal") && seq(sy_refusal_reason(-1), "unknown refusal") && seq(sy_refusal_reason(SY_REFUSAL_COUNT), "unknown refusal"), "linked-out-of-range-reason");
    ck(seq(sy_refusal_name(0), "") && seq(sy_refusal_origin(SY_REFUSAL_COUNT), "") && seq(sy_refusal_target(-5), ""), "linked-out-of-range-empty");
    good = 1;
    for (i = 1; i < SY_REFUSAL_COUNT; i++) if (tx_len(sy_refusal_reason(i), 4096) < 8 || tx_len(sy_refusal_name(i), 4096) < 1 || tx_len(sy_refusal_origin(i), 4096) < 3) good = 0;
    ck(good, "linked-every-row-has-reason-name-origin");
    sy_printf("REFUSALS_GEN_CHECK\tok=%d\tfailed=%d\n", nok, failed);
    return failed ? 1 : 0;
}
