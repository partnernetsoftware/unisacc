/* tools/check-mergebranch.cx -- cxlib.mergebranch: the branch patterns of the merge tables.
 *
 *   sh ./unisacc.com tools/check-mergebranch.cx
 *
 * "*", "PREFIX*", "*SUFFIX", exact names, and ">=vA.B.C" (that version line and newer, compared as numbers; a branch name that is not vA.B.C is
 * matched; a malformed threshold matches nothing, so a row can never silently widen). Prints PASS/FAIL per case and CHECK_MERGEBRANCH failed=N. */
#pragma unisa use sys.io
#pragma unisa use cxlib.mergebranch

static int failed;
static void ck(int ok, const char *what) { printf("%s\tcheck-mergebranch.%s\n", ok ? "PASS" : "FAIL", what); if (!ok) failed++; }

int main(void) {
    ck(mbr_match("*", "anything") && mbr_match("*", "v0.0.1"), "star-matches-everything");
    ck(mbr_match("feat*", "feat2") && !mbr_match("feat*", "xfeat2") && mbr_match("*2", "feat2") && !mbr_match("*2", "feat3"), "prefix-and-suffix-globs");
    ck(mbr_match("v0.0.96", "v0.0.96") && !mbr_match("v0.0.96", "v0.0.100") && !mbr_match("v0.0.96", "v0.0.9"), "exact-name-is-exact");
    ck(mbr_match(">=v0.0.96", "v0.0.96"), "since-boundary-is-inclusive");
    ck(mbr_match(">=v0.0.96", "v0.0.97") && mbr_match(">=v0.0.96", "v0.0.100") && mbr_match(">=v0.0.96", "v0.1.0") && mbr_match(">=v0.0.96", "v1.0.0"), "since-matches-newer-by-number-not-by-text");
    ck(!mbr_match(">=v0.0.96", "v0.0.95") && !mbr_match(">=v0.0.96", "v0.0.9") && !mbr_match(">=v0.1.0", "v0.0.100"), "since-skips-older");
    ck(mbr_match(">=v0.0.96", "feat2") && mbr_match(">=v0.0.96", "v0.0.96.1") && mbr_match(">=v0.0.96", "v0.0.x") && mbr_match(">=v0.0.96", ""), "since-matches-a-name-that-is-not-a-version");
    ck(!mbr_match(">=v0.0", "v0.0.100") && !mbr_match(">=0.0.96", "v0.0.100") && !mbr_match(">=", "v0.0.100") && !mbr_match(">=v0.0.96.1", "v0.0.100"), "malformed-threshold-matches-nothing");
    ck(mbr_glob("*", "x") && mbr_glob("a*", "ab") && mbr_glob("*b", "ab") && mbr_glob("ab", "ab") && !mbr_glob("a*", "ba") && !mbr_glob(">=v0.0.1", "v0.0.5"), "mbr-glob-has-no-version-syntax");
    printf("CHECK_MERGEBRANCH\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
