/* tools/facts-gen.cx -- native producers for exec/facts tables, moved out of exec/facts/export.py one
 * table at a time (zero-Python plan, plans/cx-layers.md).  A ported table names this tool as its writer
 * and lists it among its inputs in place of export.py; export.py no longer writes it.
 *
 *   sh ./unisacc.com tools/facts-gen.cx -- --check ROOT [TABLE...]
 *   sh ./unisacc.com tools/facts-gen.cx -- --write ROOT [TABLE...]
 *   sh ./unisacc.com tools/facts-gen.cx -- --compare-body ROOT TABLE   (transition: body equal to the
 *       committed table written by export.py; header lines are not compared)
 *
 * Tables: opt-gen (E4 START data and peep indices).
 * Exit 0 all equal / written, 1 a table differs (named), 2 usage or I/O.
 */
#pragma unisa use text.text
#pragma unisa use mem.arena
#define FG_CAP 65536
#define FG_MAXL 8192

static char fg_root[4096];
static int fg_ar;

typedef struct { char *p; long n, cap; } Ob;
static void fg_die(const char *a, const char *b) { fprintf(stderr, "facts-gen: %s%s%s\n", a, b ? ": " : "", b ? b : ""); exit(2); }
static void ob_put(Ob *o, const char *s, long n) {
    long i;
    if (o->n + n + 1 > o->cap) {
        long c = (o->n + n + 1) * 2 + 4096;
        char *t = ar_alloc(fg_ar, c);
        if (!t) fg_die("out of memory", 0);
        for (i = 0; i < o->n; i++) t[i] = o->p[i];
        o->p = t; o->cap = c;
    }
    for (i = 0; i < n; i++) o->p[o->n + i] = s[i];
    o->n += n;
    o->p[o->n] = 0;
}
static void ob_z(Ob *o, const char *s) { long n = tx_len(s, FG_CAP); if (n < 0) fg_die("string too long", 0); ob_put(o, s, n); }
static void ob_int(Ob *o, long v) { char b[32]; cx_fmt(b, sizeof b, "%ld", v); ob_z(o, b); }
static void ob_str(Ob *o, const char *s) {           /* json.dumps of an ASCII string */
    long i, n = tx_len(s, FG_CAP);
    ob_put(o, "\"", 1);
    for (i = 0; i < n; i++) {
        unsigned char c = (unsigned char)s[i];
        if (c == '"' || c == '\\') { ob_put(o, "\\", 1); ob_put(o, s + i, 1); }
        else if (c == '\n') ob_z(o, "\\n");
        else if (c == '\r') ob_z(o, "\\r");
        else if (c == '\t') ob_z(o, "\\t");
        else if (c == '\b') ob_z(o, "\\b");
        else if (c == '\f') ob_z(o, "\\f");
        else if (c < 0x20 || c > 0x7f) { char b[8]; cx_fmt(b, sizeof b, "\\u%04x", c); ob_z(o, b); }
        else ob_put(o, s + i, 1);
    }
    ob_put(o, "\"", 1);
}
/* Decodes the JSON string literal s[0..n) (quotes included) into a z-string in the arena; BMP \u
   escapes below 0x80 only (the fact tables are ASCII).  0 when s is not such a literal. */
static char *jstr(const char *s, long n) {
    char *out;
    long i, k = 0;
    if (n < 2 || s[0] != '"' || s[n - 1] != '"') return 0;
    out = ar_alloc(fg_ar, n);
    if (!out) return 0;
    for (i = 1; i < n - 1; i++) {
        char c = s[i];
        if (c != '\\') { out[k++] = c; continue; }
        if (++i >= n - 1) return 0;
        c = s[i];
        if (c == 'n') out[k++] = '\n'; else if (c == 't') out[k++] = '\t'; else if (c == 'r') out[k++] = '\r';
        else if (c == 'b') out[k++] = '\b'; else if (c == 'f') out[k++] = '\f';
        else if (c == '"' || c == '\\' || c == '/') out[k++] = c;
        else if (c == 'u' && i + 4 < n - 1) {
            int v = 0, d;
            for (d = 1; d <= 4; d++) { char h = s[i + d]; v = v * 16 + (h >= '0' && h <= '9' ? h - '0' : h >= 'a' && h <= 'f' ? h - 'a' + 10 : h >= 'A' && h <= 'F' ? h - 'A' + 10 : -999); }
            if (v < 1 || v > 0x7f) return 0;
            out[k++] = (char)v; i += 4;
        } else return 0;
    }
    out[k] = 0;
    return out;
}
/* Python's list(s.encode()) as JSON with the default ", " separator. */
static void ob_bytes_list(Ob *o, const char *s) {
    long i, n = tx_len(s, FG_CAP);
    ob_z(o, "[");
    for (i = 0; i < n; i++) { if (i) ob_z(o, ", "); ob_int(o, (unsigned char)s[i]); }
    ob_z(o, "]");
}

/* Lines of a file, split in place; lines[] point into an arena copy. */
typedef struct { char **l; int n; char *raw; long rawn; } Lines;
static Lines fg_lines(const char *rel) {
    char path[4400];
    size_t n;
    char *b, *copy, *p, *end;
    Lines L;
    L.n = 0;
    if (cx_fmt(path, sizeof path, "%s/%s", fg_root, rel)) fg_die("path too long", rel);
    b = cx_read(path, &n);
    if (!b) fg_die("cannot read", path);
    L.raw = b; L.rawn = (long)n;
    copy = ar_dup(fg_ar, b, (long)n);
    L.l = ar_alloc(fg_ar, (long)sizeof(char *) * ((long)n + 2));
    if (!copy || !L.l) fg_die("out of memory", 0);
    for (p = copy, end = copy + n; p < end; ) {
        long off = tx_chr(p, (long)(end - p), '\n');
        if (off < 0) off = (long)(end - p);
        p[off] = 0;
        L.l[L.n++] = p;
        p += off + 1;
    }
    return L;
}
static int fg_split(char *s, char **out, int cap) {
    int n = 0;
    char *p = s;
    for (;;) {
        if (n == cap) return -1;
        out[n++] = p;
        while (*p && *p != '\t') p++;
        if (!*p) return n;
        *p++ = 0;
    }
}
static char *fg_dupz(const char *s) { long n = tx_len(s, FG_CAP); char *p = n < 0 ? 0 : ar_dup(fg_ar, s, n); if (!p) fg_die("out of memory", 0); return p; }

typedef struct { int n; char *v[FG_MAXL]; } List;
static int list_index(const List *l, const char *x) { int i; for (i = 0; i < l->n; i++) if (tx_eq(l->v[i], x, FG_CAP)) return i; return -1; }

/* gold(name) of export.py: rows of weights/gold/NAME.tsv not starting with '#' whose cells do not
   include the cell "=>" (the column line's cells are "=> head", so it is kept, as in Python). */
typedef struct { int n; int nc[FG_MAXL * 4]; char **c[FG_MAXL * 4]; } Rows;
static void fg_gold(const char *name, Rows *R, List *fields, const char *(*want)[2], int nwant) {
    char rel[256];
    Lines L;
    int i, k, w;
    cx_fmt(rel, sizeof rel, "weights/gold/%s.tsv", name);
    L = fg_lines(rel);
    R->n = 0;
    for (i = 0; i < L.n; i++) {
        char *cells[FG_MAXL + 4];
        char *line = fg_dupz(L.l[i]);
        int nc, arrow = 0;
        if (!*L.l[i]) continue;
        nc = fg_split(line, cells, FG_MAXL + 4);
        if (nc < 0) fg_die("too many cells", rel);
        if (L.l[i][0] == '#') {
            if (nc >= 2 && (tx_eq(cells[0], "#field", 8) || tx_eq(cells[0], "#head", 8)))
                for (w = 0; w < nwant; w++) if (tx_eq(cells[1], want[w][0], FG_CAP)) {
                    List *dst = &fields[w];
                    dst->n = 0;
                    for (k = 2; k < nc; k++) dst->v[dst->n++] = cells[k];
                }
            continue;
        }
        for (k = 0; k < nc; k++) if (tx_eq(cells[k], "=>", 4)) arrow = 1;
        if (arrow) continue;
        R->c[R->n] = ar_alloc(fg_ar, (long)sizeof(char *) * nc);
        if (!R->c[R->n]) fg_die("out of memory", 0);
        for (k = 0; k < nc; k++) R->c[R->n][k] = cells[k];
        R->nc[R->n++] = nc;
    }
}

/* facts(stem) for a two-column name/value table of integers, and a single-column value table of
   JSON strings (no escapes), as exec/facts/load.py reads them. */
static long fg_const(const char *stem, const char *name) {
    char rel[256];
    Lines L;
    int i;
    cx_fmt(rel, sizeof rel, "exec/facts/%s.tsv", stem);
    L = fg_lines(rel);
    for (i = 1; i < L.n; i++) {
        char *cells[4], *line = fg_dupz(L.l[i]), *end;
        long v;
        if (!*line || line[0] == '#') continue;
        if (fg_split(line, cells, 4) != 2) continue;
        if (!tx_eq(cells[0], name, FG_CAP)) continue;
        v = strtol(cells[1], &end, 10);
        if (end == cells[1] || *end) fg_die("constant is not an integer", name);
        return v;
    }
    fg_die("constant absent", name);
    return 0;
}
static int fg_values(const char *stem, char **out, int cap) {
    char rel[256];
    Lines L;
    int i, n = 0;
    cx_fmt(rel, sizeof rel, "exec/facts/%s.tsv", stem);
    L = fg_lines(rel);
    for (i = 1; i < L.n; i++) {
        char *s = L.l[i];
        long len = tx_len(s, FG_CAP);
        if (!*s || s[0] == '#') continue;
        if (len < 2 || s[0] != '"' || s[len - 1] != '"' || tx_chr(s, len, '\\') >= 0 || n == cap) fg_die("value is not a plain JSON string", stem);
        out[n++] = ar_dup(fg_ar, s + 1, len - 2);
    }
    return n;
}

static void opt_gen(Ob *o) {
    static List F[4];
    static const char *want[4][2] = {{"a", 0}, {"b", 0}, {"rel", 0}, {"y", 0}};
    static Rows peep, opinfo;
    static List dummy[1];
    static const char *none[1][2] = {{"", 0}};
    List *PA = &F[0], *PB = &F[1], *PR = &F[2], *PY = &F[3];
    char *words[256];
    int nwords, i, npeep = 0, nopinfo = 0, nsimple = 0;
    long PEEPB = fg_const("opt-gen-constants", "PEEPB"), ACLSB = fg_const("opt-gen-constants", "ACLSB"),
         BCLSB = fg_const("opt-gen-constants", "BCLSB"), SIMPLE = fg_const("opt-gen-constants", "SIMPLE");
    fg_gold("peep", &peep, F, want, 4);
    fg_gold("opinfo", &opinfo, dummy, none, 0);
    nwords = fg_values("opt-gen-startwords", words, 256);
    /* =startwords */
    ob_z(o, "=startwords\tjson\t[");
    for (i = 0; i < nwords; i++) {
        long a = 0, b = tx_len(words[i], FG_CAP);
        char reg[512];
        while (a < b && words[i][a] == '.') a++;
        while (b > a && words[i][b - 1] == '.') b--;
        ob_z(o, i ? ", {\"i\": " : "{\"i\": "); ob_int(o, i);
        ob_z(o, ", \"word\": "); ob_str(o, words[i]);
        cx_fmt(reg, sizeof reg, "id_%.*s", (int)(b - a), words[i] + a);
        ob_z(o, ", \"register\": "); ob_str(o, reg); ob_z(o, "}");
    }
    ob_z(o, "]\n");
    /* =peepinit */
    ob_z(o, "=peepinit\tjson\t[");
    for (i = 0; i < peep.n; i++) {
        char **f = peep.c[i];
        int a, b, r, y;
        if (peep.nc[i] != 4) continue;
        a = list_index(PA, f[0]); b = list_index(PB, f[1]); r = list_index(PR, f[2]); y = list_index(PY, f[3]);
        if (a < 0 || b < 0 || r < 0 || y < 0) continue;
        ob_z(o, npeep ? ", {\"i\": " : "{\"i\": "); ob_int(o, npeep);
        ob_z(o, ", \"index\": "); ob_int(o, ((long)a * PB->n + b) * PR->n + r);
        ob_z(o, ", \"value\": "); ob_int(o, y + 1);
        ob_z(o, ", \"bank\": "); ob_int(o, PEEPB); ob_z(o, "}");
        npeep++;
    }
    ob_z(o, "]\n");
    /* =opinfoinit */
    ob_z(o, "=opinfoinit\tjson\t[");
    for (i = 0; i < opinfo.n; i++) {
        char **f = opinfo.c[i];
        int a, b;
        if (opinfo.nc[i] != 4) continue;
        a = list_index(PA, f[2]); b = list_index(PB, f[3]);
        ob_z(o, nopinfo ? ", {\"i\": " : "{\"i\": "); ob_int(o, nopinfo);
        ob_z(o, ", \"word\": "); ob_str(o, f[0]);
        ob_z(o, ", \"has_a\": "); ob_str(o, a >= 0 ? "yes" : "no");
        ob_z(o, ", \"a_value\": "); ob_int(o, a >= 0 ? a + 1 : 0);
        ob_z(o, ", \"a_bank\": "); ob_int(o, ACLSB);
        ob_z(o, ", \"has_b\": "); ob_str(o, b >= 0 ? "yes" : "no");
        ob_z(o, ", \"b_value\": "); ob_int(o, b >= 0 ? b + 1 : 0);
        ob_z(o, ", \"b_bank\": "); ob_int(o, BCLSB); ob_z(o, "}");
        nopinfo++;
    }
    ob_z(o, "]\n");
    /* =simplewords */
    ob_z(o, "=simplewords\tjson\t[");
    for (i = 0; i < opinfo.n; i++) {
        char **f = opinfo.c[i];
        if (opinfo.nc[i] < 2 || !tx_eq(f[1], "1", 4)) continue;
        ob_z(o, nsimple ? ", {\"i\": " : "{\"i\": "); ob_int(o, nsimple);
        ob_z(o, ", \"word\": "); ob_str(o, f[0]);
        ob_z(o, ", \"bank\": "); ob_int(o, SIMPLE); ob_z(o, "}");
        nsimple++;
    }
    ob_z(o, "]\n");
    /* =startplans */
    {
        int plan, first, k;
        ob_z(o, "=startplans\tjson\t[");
        for (plan = 1; plan <= 2; plan++) {
            char ref[64];
            first = 1;
            ob_z(o, plan == 1 ? "{\"name\": \"start1\", \"refs\": [" : ", {\"name\": \"start2\", \"refs\": [");
            for (k = 0; k < nwords; k++) { cx_fmt(ref, sizeof ref, "word_%d", k); if (!first) ob_z(o, ", "); ob_str(o, ref); first = 0; }
            if (plan == 2) {
                for (k = 0; k < npeep; k++) { cx_fmt(ref, sizeof ref, "peep_%d", k); if (!first) ob_z(o, ", "); ob_str(o, ref); first = 0; }
                for (k = 0; k < nopinfo; k++) { cx_fmt(ref, sizeof ref, "opinfo_%d", k); if (!first) ob_z(o, ", "); ob_str(o, ref); first = 0; }
            }
            for (k = 0; k < nsimple; k++) { cx_fmt(ref, sizeof ref, "simple_%d", k); if (!first) ob_z(o, ", "); ob_str(o, ref); first = 0; }
            ob_z(o, "]}");
        }
        ob_z(o, "]\n");
    }
    /* =peepidx */
    {
        const List *L3[3] = {PA, PB, PR};
        const char *pre[3] = {"PA_", "PB_", "PR_"};
        int g, k, first = 1;
        char key[512];
        ob_z(o, "=peepidx\tjson\t{");
        for (g = 0; g < 3; g++)
            for (k = 0; k < L3[g]->n; k++) {
                cx_fmt(key, sizeof key, "%s%s", pre[g], L3[g]->v[k]);
                if (!first) ob_z(o, ", ");
                ob_str(o, key); ob_z(o, ": "); ob_int(o, k); first = 0;
            }
        ob_z(o, ", \"PB_size\": "); ob_int(o, PB->n);
        ob_z(o, ", \"PR_size\": "); ob_int(o, PR->n);
        ob_z(o, "}\n");
    }
    /* =Y: answer-targets name -> template, "*" the default, "{name}" replaced */
    {
        Lines T = fg_lines("exec/opt/answer-targets.tsv");
        char *tn[256], *tv[256];
        int nt = 0, k, star = -1;
        for (k = 0; k < T.n; k++) {
            char *cells[4], *line = fg_dupz(T.l[k]);
            if (!*line || line[0] == '#') continue;
            if (fg_split(line, cells, 4) != 2 || nt == 256) fg_die("bad answer-targets row", T.l[k]);
            tn[nt] = cells[0]; tv[nt] = cells[1];
            if (tx_eq(cells[0], "*", 4)) star = nt;
            nt++;
        }
        if (star < 0) fg_die("answer-targets lacks *", 0);
        ob_z(o, "=Y\tjson\t[");
        for (i = 0; i < PY->n; i++) {
            const char *t = tv[star];
            char out[1024];
            long at = 0, j, tl, hole;
            for (k = 0; k < nt; k++) if (tx_eq(tn[k], PY->v[i], FG_CAP)) { t = tv[k]; break; }
            tl = tx_len(t, FG_CAP);
            hole = tx_find(t, tl, "{name}", 6);
            for (j = 0; j < tl && at < 1000; ) {
                if (j == hole) { long m = tx_len(PY->v[i], 512); if (tx_copy(out + at, 1024 - at, PY->v[i], m)) fg_die("target too long", 0); at += m; j += 6; }
                else out[at++] = t[j++];
            }
            out[at] = 0;
            ob_z(o, i ? ", {\"i\": " : "{\"i\": "); ob_int(o, i);
            ob_z(o, ", \"target\": "); ob_str(o, out); ob_z(o, "}");
        }
        ob_z(o, "]\n");
    }
}

/* Two-column rows (KEY<TAB>VALUE) of a table, header line skipped, '#' lines skipped; values raw. */
static int fg_pairs(const char *rel, char **k, char **v, int cap) {
    Lines L = fg_lines(rel);
    int i, n = 0;
    for (i = 1; i < L.n; i++) {
        char *cells[4], *line = fg_dupz(L.l[i]);
        if (!*line || line[0] == '#') continue;
        if (fg_split(line, cells, 4) != 2 || n == cap) fg_die("not a two-column row", L.l[i]);
        k[n] = cells[0]; v[n] = cells[1]; n++;
    }
    return n;
}
static char *fg_pair(char **k, char **v, int n, const char *key) {
    int i;
    for (i = 0; i < n; i++) if (tx_eq(k[i], key, FG_CAP)) return v[i];
    fg_die("key absent", key);
    return 0;
}

/* parse-tokens: words = words_pre + casops+"=" + sorted(prec operators with a digit level) + words_post;
   TK maps each word to its last 1-based position (first-occurrence order), then "type" = TK["type=int"]. */
typedef struct {
    char *w[1024]; int nw;                   /* WORDS */
    char *tkn[1024]; int tkv[1024]; int ntk; /* TK in insertion order, "type" last */
    char *prec[256]; int plev[256]; int np;  /* gold prec operators with a digit level, byte-sorted */
} Tok;
static Tok pt;
static int pt_ready;
static int pt_tk(const char *name) {
    int i;
    for (i = 0; i < pt.ntk; i++) if (tx_eq(pt.tkn[i], name, FG_CAP)) return pt.tkv[i];
    fg_die("no TK entry", name);
    return 0;
}
static void pt_build(void) {
    static char *k[512], *v[512];
    char **w = pt.w, **prec = pt.prec;
    int n, nw = 0, np = 0, i, j, g, *plev = pt.plev;
    if (pt_ready) return;
    pt_ready = 1;
    n = fg_pairs("exec/facts/parse-words.tsv", k, v, 512);
    static const char *groups[3] = {"words_pre", "casops", "words_post"};
    Rows P;
    static List none[1];
    static const char *nowant[1][2] = {{"", 0}};
    fg_gold("prec", &P, none, nowant, 0);
    for (i = 0; i < P.n; i++) {                   /* the later _gold: drop lines containing "=>" */
        char *lvl;
        long m;
        if (P.nc[i] < 2) continue;
        lvl = P.c[i][1];
        m = tx_len(lvl, 64);
        if (m < 1) continue;
        for (j = 0; j < m; j++) if (lvl[j] < '0' || lvl[j] > '9') break;
        if (j < m) continue;
        for (j = 0; j < np; j++) if (tx_eq(prec[j], P.c[i][0], FG_CAP)) break;
        if (j == np) { prec[np] = P.c[i][0]; plev[np] = (int)strtol(lvl, 0, 10); np++; }
        else plev[j] = (int)strtol(lvl, 0, 10);   /* dict: the last row's level wins */
    }
    for (i = 1; i < np; i++) {                    /* sorted(): byte order, insertion sort */
        char *x = prec[i];
        int xl = plev[i];
        for (j = i - 1; j >= 0; j--) {
            long a = tx_len(prec[j], FG_CAP), b = tx_len(x, FG_CAP), m = a < b ? a : b, q;
            int gt = 0;
            for (q = 0; q < m && prec[j][q] == x[q]; q++) ;
            gt = q < m ? (unsigned char)prec[j][q] > (unsigned char)x[q] : a > b;
            if (!gt) break;
            prec[j + 1] = prec[j]; plev[j + 1] = plev[j];
        }
        prec[j + 1] = x; plev[j + 1] = xl;
    }
    pt.np = np;
    for (g = 0; g < 3; g++) {
        if (g == 2) for (j = 0; j < np; j++) w[nw++] = prec[j];
        for (i = 0; i < n; i++) {
            char *s;
            if (!tx_eq(k[i], groups[g], FG_CAP)) continue;
            s = jstr(v[i], tx_len(v[i], FG_CAP));
            if (!s) fg_die("parse-words value is not a JSON string", v[i]);
            if (g == 1) { char *t = ar_alloc(fg_ar, tx_len(s, FG_CAP) + 2); cx_fmt(t, (size_t)tx_len(s, FG_CAP) + 2, "%s=", s); s = t; }
            w[nw++] = s;
        }
    }
    pt.nw = nw;
    {
        int tint = -1;
        for (i = 0; i < nw; i++) {
            int last = i;
            for (j = 0; j < i; j++) if (tx_eq(w[j], w[i], FG_CAP)) break;
            if (j < i) continue;                  /* not the first occurrence */
            for (j = i + 1; j < nw; j++) if (tx_eq(w[j], w[i], FG_CAP)) last = j;
            if (tx_eq(w[i], "type", 8)) fg_die("a word named type exists; its TK position would be reused", 0);
            pt.tkn[pt.ntk] = w[i]; pt.tkv[pt.ntk++] = last + 1;
            if (tx_eq(w[i], "type=int", 16)) tint = last + 1;
        }
        if (tint < 0) fg_die("no type=int word", 0);
        pt.tkn[pt.ntk] = "type"; pt.tkv[pt.ntk++] = tint;
    }
}
static void parse_tokens(Ob *o) {
    int i;
    pt_build();
    ob_z(o, "=WORDS\tjson\t[");
    for (i = 0; i < pt.nw; i++) { if (i) ob_z(o, ","); ob_str(o, pt.w[i]); }
    ob_z(o, "]\n=TK\tjson\t{");
    for (i = 0; i < pt.ntk; i++) { if (i) ob_z(o, ","); ob_str(o, pt.tkn[i]); ob_z(o, ":"); ob_int(o, pt.tkv[i]); }
    ob_z(o, "}\n");
}

/* structreturnexpr: the struct-return refusal entry (LOC from parse-constants). */
static void struct_return_expr(Ob *o) {
    const char *reason = "not covered: struct return expression outside local lvalue";
    ob_z(o, "=reason\tstr\t"); ob_z(o, reason);
    ob_z(o, "\n@sr\tentry:str\tloc:int\treason:str\n\tLI.original.structreturn\t");
    ob_int(o, fg_const("parse-constants", "LOC")); ob_z(o, "\t"); ob_z(o, reason); ob_z(o, "\n");
}

/* k2-constexpr: integer-expression precedence levels and token classes for the E3 table. */
static void k2_constexpr(Ob *o) {
    static char *opn[256], *opc[256][5];
    static char *cn[64], *ct[64];
    int levels[64], nl = 0, nop = 0, ncl = 0, i, j, l;
    Lines L;
    pt_build();
    for (i = 0; i < pt.np; i++) {                 /* sorted(set(levels)) */
        for (j = 0; j < nl; j++) if (levels[j] == pt.plev[i]) break;
        if (j == nl) levels[nl++] = pt.plev[i];
    }
    for (i = 1; i < nl; i++) { int x = levels[i]; for (j = i - 1; j >= 0 && levels[j] > x; j--) levels[j + 1] = levels[j]; levels[j + 1] = x; }
    L = fg_lines("exec/parse2/constexpr-operators.tsv");
    for (i = 1; i < L.n; i++) {
        char *cells[8], *line = fg_dupz(L.l[i]);
        if (!*line) continue;
        if (fg_split(line, cells, 8) != 6 || nop == 256) fg_die("bad constexpr-operators row", L.l[i]);
        opn[nop] = cells[0];
        for (j = 0; j < 5; j++) opc[nop][j] = cells[j + 1];
        nop++;
    }
    ob_z(o, "=levels\tjson\t[");
    for (l = 0; l < nl; l++) {
        int first = 1;
        if (l) ob_z(o, ",");
        ob_z(o, "{\"level\":"); ob_int(o, levels[l]); ob_z(o, ",\"next\":");
        if (l + 1 < nl) ob_int(o, levels[l + 1]); else ob_str(o, ".atom");
        ob_z(o, ",\"ops\":[");
        for (i = 0; i < pt.np; i++) {             /* pt.prec is already byte-sorted */
            int x;
            char **c;
            if (pt.plev[i] != levels[l]) continue;
            for (x = 0; x < nop; x++) if (tx_eq(opn[x], pt.prec[i], FG_CAP)) break;
            if (x == nop) fg_die("operator missing from constexpr-operators", pt.prec[i]);
            c = opc[x];
            if (!first) ob_z(o, ",");
            first = 0;
            ob_z(o, "{\"k\":"); ob_int(o, pt_tk(pt.prec[i]));
            ob_z(o, ",\"name\":"); ob_str(o, pt.prec[i]);
            ob_z(o, ",\"category\":"); ob_str(o, c[0]);
            ob_z(o, ",\"action\":"); ob_str(o, c[1]);
            ob_z(o, ",\"comparison\":[");
            if (!tx_eq(c[2], "-", 4)) {
                long cl = tx_len(c[2], FG_CAP), q, firstn = 1;
                for (q = 0; q < cl; ) {
                    long e = tx_chr(c[2] + q, cl - q, ',');
                    char num[32];
                    if (e < 0) e = cl - q;
                    if (tx_copy(num, sizeof num, c[2] + q, e)) fg_die("bad comparison", c[2]);
                    if (!firstn) ob_z(o, ",");
                    ob_int(o, strtol(num, 0, 10)); firstn = 0;
                    q += e + 1;
                }
            }
            ob_z(o, "],\"zero\":"); ob_str(o, c[3]);
            ob_z(o, ",\"nonzero\":"); ob_str(o, c[4]); ob_z(o, "}");
        }
        ob_z(o, "]}");
    }
    ob_z(o, "]\n");
    {   /* tokens = TK + identifier/number/string, then type=extern/_Bool after max(TK) */
        static char *tn[1100];
        static int tv[1100];
        int nt = 0, mx = 0, typeword[1100], ntw = 0;
        const char *extra[3][2] = {{"identifier", "TK_ID"}, {"number", "TK_NUM"}, {"string", "TK_STR"}};
        for (i = 0; i < pt.ntk; i++) { tn[nt] = pt.tkn[i]; tv[nt++] = pt.tkv[i]; if (pt.tkv[i] > mx) mx = pt.tkv[i]; }
        for (i = 0; i < 3; i++) {
            long v = fg_const("parse-constants", extra[i][1]);
            for (j = 0; j < nt; j++) if (tx_eq(tn[j], extra[i][0], FG_CAP)) break;
            if (j == nt) { tn[nt] = (char *)extra[i][0]; tv[nt++] = (int)v; } else tv[j] = (int)v;
        }
        tn[nt] = "type=extern"; tv[nt++] = mx + 1;
        tn[nt] = "type=_Bool"; tv[nt++] = mx + 2;
        L = fg_lines("exec/parse2/constexpr-tokens.tsv");
        for (i = 1; i < L.n; i++) {
            char *cells[4], *line = fg_dupz(L.l[i]);
            if (!*line) continue;
            if (fg_split(line, cells, 4) != 2 || ncl == 64) fg_die("bad constexpr-tokens row", L.l[i]);
            cn[ncl] = cells[0]; ct[ncl++] = cells[1];
        }
        ob_z(o, "=classes\tjson\t{");
        for (i = 0; i < ncl; i++) {
            int v = -1;
            for (j = 0; j < nt; j++) if (tx_eq(tn[j], ct[i], FG_CAP)) v = tv[j];
            if (v < 0) fg_die("constexpr token without a code", ct[i]);
            if (i) ob_z(o, ",");
            ob_str(o, cn[i]); ob_z(o, ":["); ob_int(o, v); ob_z(o, "]");
        }
        for (j = 0; j < nt; j++) {
            int keep = tx_prefix(tn[j], tx_len(tn[j], FG_CAP), "type", 4) || tx_eq(tn[j], "struct", 8) || tx_eq(tn[j], "union", 8) || tx_eq(tn[j], "enum", 8), q;
            if (!keep) continue;
            for (q = 0; q < ntw; q++) if (typeword[q] == tv[j]) break;
            if (q == ntw) typeword[ntw++] = tv[j];
        }
        for (i = 1; i < ntw; i++) { int x = typeword[i]; for (j = i - 1; j >= 0 && typeword[j] > x; j--) typeword[j + 1] = typeword[j]; typeword[j + 1] = x; }
        ob_z(o, ncl ? ",\"typeword\":[" : "\"typeword\":[");
        for (i = 0; i < ntw; i++) { if (i) ob_z(o, ","); ob_int(o, typeword[i]); }
        ob_z(o, "]}\n=SKIPS\tint\t");
        ob_int(o, 7L * (1L << 26)); ob_z(o, "\n");
    }
}

/* k2-tokenlocations-map: MAP_FIELDS (a JSON list of plain strings) as [{"i":i,"register":"diag_NAME"}]. */
static void tokenlocations_map(Ob *o) {
    static char *k[64], *v[64];
    int n = fg_pairs("exec/facts/tokenlocations.tsv", k, v, 64), i = 0, first = 1;
    char *s = fg_pair(k, v, n, "MAP_FIELDS");
    long len = tx_len(s, FG_CAP), at = 1;
    if (len < 2 || s[0] != '[' || s[len - 1] != ']') fg_die("MAP_FIELDS is not a list", s);
    ob_z(o, "=mapfields\tjson\t[");
    while (at < len - 1) {
        long q;
        char *name, reg[512];
        while (at < len - 1 && (s[at] == ' ' || s[at] == ',')) at++;
        if (at >= len - 1) break;
        if (s[at] != '"') fg_die("MAP_FIELDS item is not a string", s);
        q = tx_chr(s + at + 1, len - at - 1, '"');
        if (q < 0) fg_die("unterminated MAP_FIELDS string", s);
        name = jstr(s + at, q + 2);
        if (!name) fg_die("bad MAP_FIELDS string", s);
        {   /* names must be distinct */
            static char *seen[256];
            int j;
            for (j = 0; j < i; j++) if (tx_eq(seen[j], name, FG_CAP)) fg_die("MAP_FIELDS repeats", name);
            if (i == 256) fg_die("too many MAP_FIELDS", 0);
            seen[i] = name;
        }
        cx_fmt(reg, sizeof reg, "diag_%s", name);
        ob_z(o, first ? "{\"i\":" : ",{\"i\":"); ob_int(o, i++); ob_z(o, ",\"register\":"); ob_str(o, reg); ob_z(o, "}");
        first = 0;
        at += q + 2;
    }
    if (!i) fg_die("MAP_FIELDS is empty", 0);
    ob_z(o, "]\n");
}

/* top-modelbindings-template: the USBIND magic chain, identifier byte classes and record kinds. */
static void modelbindings_template(Ob *o) {
    static char *k[64], *v[64];
    int n = fg_pairs("exec/facts/top-modelbindings-const.tsv", k, v, 64), i;
    char *magic = jstr(fg_pair(k, v, n, "magic"), tx_len(fg_pair(k, v, n, "magic"), FG_CAP));
    char *letters = jstr(fg_pair(k, v, n, "letters"), tx_len(fg_pair(k, v, n, "letters"), FG_CAP));
    char *digits = jstr(fg_pair(k, v, n, "digits"), tx_len(fg_pair(k, v, n, "digits"), FG_CAP));
    char *kind = fg_pair(k, v, n, "kind"), all[512];
    long m;
    if (!magic || !letters || !digits) fg_die("bad modelbindings constant", 0);
    ob_z(o, "@magic\ti:int\tc:int\tnext:int\n");
    m = tx_len(magic, FG_CAP);
    for (i = 0; i < m; i++) { ob_z(o, "\t"); ob_int(o, i); ob_z(o, "\t"); ob_int(o, (unsigned char)magic[i]); ob_z(o, "\t"); ob_int(o, i + 1); ob_z(o, "\n"); }
    ob_z(o, "@id\tletters:json\tdigits:json\tall:json\n\t");
    ob_bytes_list(o, letters); ob_z(o, "\t"); ob_bytes_list(o, digits); ob_z(o, "\t");
    cx_fmt(all, sizeof all, "%s%s", letters, digits);
    ob_bytes_list(o, all); ob_z(o, "\n");
    {   /* json.dumps of a list of small integers: normalise separators to ", " */
        long kl = tx_len(kind, FG_CAP), j;
        int sep = 0;
        if (kl < 2 || kind[0] != '[' || kind[kl - 1] != ']') fg_die("kind is not a list", kind);
        ob_z(o, "=kind\tjson\t[");
        for (j = 1; j < kl - 1; j++) {
            if (kind[j] == ' ') continue;
            if (kind[j] == ',') { sep = 1; continue; }
            if (kind[j] < '0' || kind[j] > '9') fg_die("kind is not a list of integers", kind);
            if (sep) { ob_z(o, ", "); sep = 0; }
            ob_put(o, kind + j, 1);
        }
        ob_z(o, "]\n");
    }
}

/* k2-unitlocations: the located unit map storage key. */
static void k2_unitlocations(Ob *o) {
    ob_z(o, "# Located unit map storage key; actions live in unitlocations-manifest.tsv.\n=MAPS\tint\t");
    ob_int(o, 49L << 40); ob_z(o, "\n");
}

/* k2-strings: string rejection text and escape data from exec/facts/strings.tsv (dict semantics: first
   position, last value), escapes for 0-7 and x excluded, and TK_STR from parse-constants (raw text). */
static void k2_strings(Ob *o) {
    static char *rn[256], *rv[256], *ek[256];
    static int ev[256];
    int nr = 0, ne = 0, i, j;
    Lines L = fg_lines("exec/facts/strings.tsv");
    for (i = 0; i < L.n; i++) {
        char *cells[4], *line = fg_dupz(L.l[i]);
        int nc;
        if (!*line || line[0] == '#') continue;
        nc = fg_split(line, cells, 3);
        if (nc < 0) { /* a third tab belongs to the value: split(..., 2) */ }
        if (nc != 3) continue;
        if (tx_eq(cells[0], "reject", 8)) {
            char *v = jstr(cells[2], tx_len(cells[2], FG_CAP));
            if (!v) fg_die("reject value is not a JSON string", cells[2]);
            for (j = 0; j < nr; j++) if (tx_eq(rn[j], cells[1], FG_CAP)) break;
            if (j == nr) { if (nr == 256) fg_die("too many rejects", 0); rn[nr++] = cells[1]; }
            rv[j] = v;
        } else if (tx_eq(cells[0], "escape", 8)) {
            char *k = jstr(cells[1], tx_len(cells[1], FG_CAP)), *end;
            long v = strtol(cells[2], &end, 10);
            if (!k || tx_len(k, 4) != 1 || end == cells[2] || *end) fg_die("bad escape row", L.l[i]);
            for (j = 0; j < ne; j++) if (ek[j][0] == k[0]) break;
            if (j == ne) { if (ne == 256) fg_die("too many escapes", 0); ek[ne++] = k; }
            ev[j] = (int)v;
        }
    }
    ob_z(o, "=rej\tjson\t{");
    for (i = 0; i < nr; i++) { if (i) ob_z(o, ","); ob_str(o, rn[i]); ob_z(o, ":"); ob_str(o, rv[i]); }
    ob_z(o, "}\n=escape\tjson\t[");
    {
        int first = 1;
        for (i = 0; i < ne; i++) {
            if (tx_chr("01234567x", 9, ek[i][0]) >= 0) continue;
            if (!first) ob_z(o, ",");
            ob_z(o, "{\"byte\":"); ob_int(o, (unsigned char)ek[i][0]); ob_z(o, ",\"value\":"); ob_int(o, ev[i]); ob_z(o, "}");
            first = 0;
        }
        ob_z(o, "]\n=escbytes\tjson\t[");
        first = 1;
        for (i = 0; i < ne; i++) {
            if (tx_chr("01234567x", 9, ek[i][0]) >= 0) continue;
            if (!first) ob_z(o, ",");
            ob_int(o, (unsigned char)ek[i][0]); first = 0;
        }
        ob_z(o, "]\n");
    }
    {
        static char *k[512], *v[512];
        int n = fg_pairs("exec/facts/parse-constants.tsv", k, v, 512);
        ob_z(o, "=TK_STR\tint\t"); ob_z(o, fg_pair(k, v, n, "TK_STR")); ob_z(o, "\n");
    }
}

/* k2-truth: scalar truth opcodes from the declared output variants (fixed shape asserted). */
static void k2_truth(Ob *o) {
    static const char *want[5][3] = {{"truth", "FT.double", "64"}, {"truth", "FT.float", "32"},
        {"not", "FN.double", "feq64"}, {"not", "FN.float", "feq32"}, {"not", "FN.integer", "eq"}};
    static const char *names[5] = {"TRUTH64_OP", "TRUTH32_OP", "NOT64_OP", "NOT32_OP", "NOTINT_OP"};
    Lines L = fg_lines("exec/parse2/scalar-outputs.tsv");
    int i, nv = 0;
    for (i = 1; i < L.n; i++) {
        char *cells[8], *line = fg_dupz(L.l[i]);
        if (!*line) continue;
        if (fg_split(line, cells, 8) != 5) fg_die("bad scalar-outputs row", L.l[i]);
        if (!tx_eq(cells[0], "truth", 8) && !tx_eq(cells[0], "not", 8)) continue;
        if (nv == 5 || !tx_eq(cells[0], want[nv][0], 8) || !tx_eq(cells[1], want[nv][1], 64) || !tx_eq(cells[3], want[nv][2], 16))
            fg_die("scalar truth variants differ from the declared five", L.l[i]);
        ob_z(o, "="); ob_z(o, names[nv]); ob_z(o, "\tstr\t");
        if (tx_eq(cells[0], "truth", 8)) ob_z(o, "feq");
        ob_z(o, cells[3]); ob_z(o, "\n");
        nv++;
    }
    if (nv != 5) fg_die("scalar truth variants differ from the declared five", 0);
}

/* signature-layout: SIG_RADIX from parse-constants. */
static void signature_layout(Ob *o) {
    ob_z(o, "=SIG_RADIX\tint\t"); ob_int(o, fg_const("parse-constants", "SIG_RADIX")); ob_z(o, "\n");
}

/* k2-librarymodule-map: header keys, bad main keys and the main reason from k2-librarymodule. */
static void k2_librarymodule_map(Ob *o) {
    Lines L = fg_lines("exec/facts/k2-librarymodule.tsv");
    long hd[2] = {-1, -1}, md[2] = {-1, -1}, ok[64], k;
    int nok = 0, i;
    char *reason = 0;
    for (i = 0; i < L.n; i++) {
        char *cells[4], *line = fg_dupz(L.l[i]);
        if (line[0] != '=') continue;
        if (fg_split(line + 1, cells, 3) != 3) fg_die("bad k2-librarymodule row", L.l[i]);
        if (tx_eq(cells[0], "hdomain", 16) || tx_eq(cells[0], "maindomain", 16) || tx_eq(cells[0], "mainok", 16)) {
            long *dst = tx_eq(cells[0], "mainok", 16) ? ok : tx_eq(cells[0], "hdomain", 16) ? hd : md;
            char *p = cells[2], *end;
            int n = 0;
            if (*p != '[') fg_die("expected a JSON list", cells[2]);
            p++;
            while (*p && *p != ']') {
                while (*p == ' ' || *p == ',') p++;
                if (*p == ']') break;
                if (n == 64) fg_die("list too long", cells[2]);
                dst[n++] = strtol(p, &end, 10);
                if (end == p) fg_die("expected integers", cells[2]);
                p = end;
            }
            if (dst == ok) nok = n; else if (n != 2) fg_die("domain must be [lo,hi]", cells[2]);
        } else if (tx_eq(cells[0], "mainreason", 16)) reason = cells[2];
    }
    if (hd[0] < 0 || md[0] < 0 || !reason) fg_die("k2-librarymodule lacks a domain or the reason", 0);
    ob_z(o, "=hkeys\tjson\t[");
    for (k = hd[0]; k < hd[1]; k++) { if (k > hd[0]) ob_z(o, ","); ob_int(o, k); }
    ob_z(o, "]\n=mainbad\tjson\t[");
    {
        int first = 1;
        for (k = md[0]; k < md[1]; k++) {
            int j, good = 0;
            for (j = 0; j < nok; j++) if (ok[j] == k) good = 1;
            if (good) continue;
            if (!first) ob_z(o, ",");
            ob_int(o, k); first = 0;
        }
    }
    ob_z(o, "]\n=mainreason\tstr\t"); ob_z(o, reason); ob_z(o, "\n");
}

/* k2-stack: VS and, for each declared stack, the slot order of every push/pop (a slot with a rank that
   is not itself listed is followed by its rank; vpop reverses). */
static const char *k2_stacks[5][2] = {{"initializers", "exec/parse2/initializers-stack.tsv"},
    {"intwarnings", "exec/parse2/intwarnings-stack.tsv"}, {"returnwarnings", "exec/parse2/returnwarnings-stack.tsv"},
    {"formatwarnings", "exec/parse2/formatwarnings-stack.tsv"}, {"membercontrol", "exec/parse2/membercontrol-stack.tsv"}};
static void k2_stack(Ob *o) {
    static char *rk[256], *rv[256];
    int nr = 0, s, i;
    Lines R = fg_lines("exec/facts/valueranks.tsv");
    for (i = 1; i < R.n; i++) {
        char *cells[4], *line = fg_dupz(R.l[i]);
        int j;
        if (!*line || line[0] == '#') continue;
        if (fg_split(line, cells, 4) != 3) fg_die("bad valueranks row", R.l[i]);
        if (!tx_eq(cells[0], "rank", 8)) continue;
        for (j = 0; j < nr; j++) if (tx_eq(rk[j], cells[1], FG_CAP)) break;
        if (j == nr) { if (nr == 256) fg_die("too many ranks", 0); rk[nr++] = cells[1]; }
        rv[j] = cells[2];
    }
    ob_z(o, "=VS\tint\t"); ob_int(o, fg_const("parse-constants", "VS")); ob_z(o, "\n");
    for (s = 0; s < 5; s++) {
        Lines L = fg_lines(k2_stacks[s][1]);
        for (i = 1; i < L.n; i++) {
            char *cells[4], *line = fg_dupz(L.l[i]), *items[128], *slots[256], *p;
            int ni = 0, ns = 0, pop, j, q;
            if (!*line) continue;
            if (fg_split(line, cells, 4) != 2) fg_die("bad stack row", L.l[i]);
            p = cells[1];
            if (tx_prefix(p, tx_len(p, FG_CAP), "[\"vpush\", [", 11)) pop = 0;
            else if (tx_prefix(p, tx_len(p, FG_CAP), "[\"vpop\", [", 10)) pop = 1;
            else fg_die("stack method is not vpush/vpop", cells[1]);
            p += pop ? 10 : 11;
            while (*p && *p != ']') {
                long q2;
                while (*p == ' ' || *p == ',') p++;
                if (*p == ']') break;
                q2 = tx_chr(p + 1, tx_len(p + 1, FG_CAP), '"');
                if (*p != '"' || q2 < 0 || ni == 128) fg_die("bad stack item", cells[1]);
                items[ni++] = ar_dup(fg_ar, p + 1, q2);
                p += q2 + 2;
            }
            if (tx_eq(p, "]]", 4) == 0) fg_die("bad stack row tail", cells[1]);
            for (j = 0; j < ni; j++) {
                char *rank = 0;
                int listed = 0;
                slots[ns++] = items[j];
                for (q = 0; q < nr; q++) if (tx_eq(rk[q], items[j], FG_CAP)) rank = rv[q];
                if (rank && *rank) for (q = 0; q < ni; q++) if (tx_eq(items[q], rank, FG_CAP)) listed = 1;
                if (rank && *rank && !listed) slots[ns++] = rank;
            }
            ob_z(o, "=stack_"); ob_z(o, k2_stacks[s][0]); ob_z(o, "_"); ob_z(o, cells[0]); ob_z(o, "\tjson\t[");
            for (j = 0; j < ns; j++) {
                if (j) ob_z(o, ", ");
                ob_z(o, "{\"register\": "); ob_str(o, slots[pop ? ns - 1 - j : j]); ob_z(o, "}");
            }
            ob_z(o, "]\n");
        }
    }
}

/* Image header field chains (export.py _fieldchain/_rows): each field has a width, a constant or a
   register name, and the lead = literal-byte ("byteN") and computation names that precede it. */
#define FC_MAX 512
#define FC_LEAD 4096
typedef struct { int w; long v; const char *reg; int lead0, nlead, big; } FcField;
typedef struct { FcField f[FC_MAX]; int nf; const char *lead[FC_LEAD * 4]; int nl, pend; } Fc;
static void fc_init(Fc *c) { c->nf = 0; c->nl = 0; c->pend = 0; }
static void fc_name(Fc *c, const char *s) { if (c->nl == FC_LEAD * 4) fg_die("field chain too long", 0); c->lead[c->nl++] = s; }
static void fc_lit(Fc *c, const unsigned char *b, long n) {
    static char *byten[256];
    long i;
    for (i = 0; i < n; i++) {
        if (!byten[b[i]]) { char t[16]; cx_fmt(t, sizeof t, "byte%d", b[i]); byten[b[i]] = fg_dupz(t); }
        fc_name(c, byten[b[i]]);
    }
}
static int fc_big;                     /* endian of the fields added next */
static void fc_field(Fc *c, int w, long v, const char *reg) {
    FcField *f;
    if (c->nf == FC_MAX) fg_die("too many fields", 0);
    f = &c->f[c->nf++];
    f->w = w; f->v = v; f->reg = reg; f->lead0 = c->pend; f->nlead = c->nl - c->pend; f->big = fc_big;
    c->pend = c->nl;
}
static void fc_lead_json(Ob *o, Fc *c, int at, int n) {
    int i;
    ob_z(o, "[");
    for (i = 0; i < n; i++) { if (i) ob_z(o, ","); ob_str(o, c->lead[at + i]); }
    ob_z(o, "]");
}
static void fc_rows(Ob *o, const char *name, Fc *c) {
    int i;
    ob_z(o, "@"); ob_z(o, name); ob_z(o, "\ti:int\twidth:int\tsrc:str\tvalue:json\tendian:str\tlead:json\n");
    for (i = 0; i < c->nf; i++) {
        FcField *f = &c->f[i];
        ob_z(o, "\t"); ob_int(o, i); ob_z(o, "\t"); ob_int(o, f->w); ob_z(o, f->reg ? "\treg\t" : "\tconst\t");
        if (f->reg) ob_str(o, f->reg); else ob_int(o, f->v);
        ob_z(o, f->big ? "\tbig\t" : "\tlittle\t"); fc_lead_json(o, c, f->lead0, f->nlead); ob_z(o, "\n");
    }
}
static void fc_tail(Ob *o, const char *name, Fc *c) {   /* one zero-width row carrying the trailing lead */
    ob_z(o, "@"); ob_z(o, name); ob_z(o, "\ti:int\twidth:int\tsrc:str\tvalue:json\tendian:str\tlead:json\n\t0\t0\tnone\t0\t-\t");
    fc_lead_json(o, c, c->pend, c->nl - c->pend); ob_z(o, "\n");
}
/* "used": every lead name over the chains, kept for the final @bytes table (sorted as strings). */
static const char *pe_used[1024];
static int pe_nused;
static void fc_collect(Fc *c) {
    int i, j;
    for (i = 0; i < c->nl; i++) {
        for (j = 0; j < pe_nused; j++) if (tx_eq(pe_used[j], c->lead[i], FG_CAP)) break;
        if (j == pe_nused) { if (pe_nused == 1024) fg_die("too many lead names", 0); pe_used[pe_nused++] = c->lead[i]; }
    }
}
static int fg_strcmp(const char *a, const char *b) {
    long i = 0;
    while (a[i] && a[i] == b[i]) i++;
    return (unsigned char)a[i] - (unsigned char)b[i];
}

typedef struct { char *kind, *name, *value; } Krow;
static int fg_krows(const char *rel, Krow *r, int cap) {
    Lines L = fg_lines(rel);
    int i, n = 0;
    for (i = 0; i < L.n; i++) {
        char *cells[4], *line = fg_dupz(L.l[i]);
        if (!*line || line[0] == '#') continue;
        if (fg_split(line, cells, 4) != 3 || n == cap) fg_die("not a kind/name/value row", L.l[i]);
        r[n].kind = cells[0]; r[n].name = cells[1]; r[n].value = cells[2]; n++;
    }
    return n;
}
static long kv_int(Krow *r, int n, const char *kind, const char *name) {
    int i;
    for (i = 0; i < n; i++) if (tx_eq(r[i].kind, kind, 64) && tx_eq(r[i].name, name, 256)) return strtol(r[i].value, 0, 10);
    fg_die("fact absent", name);
    return 0;
}

static void pe_fields(Ob *o, int forward) {
    static Krow k[128];
    static Fc c;
    static const char *imp[64];
    static long noff[64];
    static unsigned char nraw[64][96];
    static long nlen[64];
    int nk = fg_krows("exec/facts/image-pe.tsv", k, 128), n = 0, i, j, a;
    long IMAGEBASE = kv_int(k, nk, "const", "IMAGEBASE"), SA = kv_int(k, nk, "const", "SECT_ALIGN"), FA = kv_int(k, nk, "const", "FILE_ALIGN"),
         TEXT_RVA = kv_int(k, nk, "const", "TEXT_RVA"), HDR_FILE = kv_int(k, nk, "const", "HDR_FILE"),
         LOADCFG = kv_int(k, nk, "const", "LOADCFG"), COOKIE = kv_int(k, nk, "const", "COOKIE_FIELD");
    const char *dll = 0, *arch[4];
    long mach[4], iat, off, dlloff, cfg, idlen, dlln;
    int narch = 0;
    for (i = 0; i < nk; i++) {
        if (tx_eq(k[i].kind, "import", 8) || (forward && tx_eq(k[i].kind, "forward", 8))) imp[n++] = k[i].value;
        if (tx_eq(k[i].kind, "dll", 8)) dll = k[i].value;
        if (tx_eq(k[i].kind, "machine", 8)) { arch[narch] = k[i].name; mach[narch++] = strtol(k[i].value, 0, 10); }
    }
    if (forward) {   /* imports first, then the forward extras, in file order */
        int m = 0;
        for (i = 0; i < nk; i++) if (tx_eq(k[i].kind, "import", 8)) imp[m++] = k[i].value;
        for (i = 0; i < nk; i++) if (tx_eq(k[i].kind, "forward", 8)) imp[m++] = k[i].value;
    }
    for (i = 1; i < narch; i++) for (j = i; j > 0 && fg_strcmp(arch[j - 1], arch[j]) > 0; j--) {   /* sorted(MACHINE) */
        const char *t = arch[j]; long u = mach[j]; arch[j] = arch[j - 1]; mach[j] = mach[j - 1]; arch[j - 1] = t; mach[j - 1] = u;
    }
    if (!dll) fg_die("image-pe lacks DLL", 0);
    dlln = tx_len(dll, 256);
    iat = 40 + 8 * (n + 1); off = iat + 8 * (n + 1);
    for (i = 0; i < n; i++) {
        long m = tx_len(imp[i], 90), q;
        nraw[i][0] = 0; nraw[i][1] = 0;
        for (q = 0; q < m; q++) nraw[i][2 + q] = (unsigned char)imp[i][q];
        nraw[i][2 + m] = 0;
        nlen[i] = m + 3;
        if (nlen[i] % 2) nraw[i][nlen[i]++] = 0;
        noff[i] = off; off += nlen[i];
    }
    dlloff = off; off += dlln + 1; cfg = (off + 7) & -8L; idlen = cfg + LOADCFG;
    {
        const char *cn[16] = {"DATA", "RELOCS", "SORTED", "TEXT_RVA", "IMAGEBASE", "HDR_FILE", "section_minus_one", "section_mask",
                              "file_minus_one", "file_mask", "import_vsize", "import_fsize", "cookie_at", "cfg", "iat", "dlloff"};
        long cv[16];
        cv[0] = 1L << 40; cv[1] = 4L << 40; cv[2] = 5L << 40; cv[3] = TEXT_RVA; cv[4] = IMAGEBASE; cv[5] = HDR_FILE;
        cv[6] = SA - 1; cv[7] = -SA; cv[8] = FA - 1; cv[9] = -FA; cv[10] = (idlen + SA - 1) & -SA; cv[11] = (idlen + FA - 1) & -FA;
        cv[12] = cfg + COOKIE; cv[13] = cfg; cv[14] = iat; cv[15] = dlloff;
        for (i = 0; i < 16; i++) { ob_z(o, "="); ob_z(o, cn[i]); ob_z(o, "\tint\t"); ob_int(o, cv[i]); ob_z(o, "\n"); }
    }
    pe_nused = 0;
    for (a = 0; a < narch; a++) {
        static const unsigned char mz[60] = {'M', 'Z'};
        static const unsigned char pesig[4] = {'P', 'E', 0, 0};
        char hn[64], tn[64];
        int q;
        fc_init(&c);
        fc_lit(&c, mz, 60); fc_field(&c, 4, 64, 0); fc_lit(&c, pesig, 4);
        {   /* COFF file header */
            static const int W[7] = {2, 2, 4, 4, 4, 2, 2};
            long V[7] = {0, 4, 0, 0, 0, 240, 0x22};
            V[0] = mach[a];
            for (q = 0; q < 7; q++) fc_field(&c, W[q], V[q], 0);
        }
        fc_name(&c, "entry-value");
        {   /* optional header PE32+, up to the data directories */
            static const int W[29] = {2, 1, 1, 4, 4, 4, 4, 4, 8, 4, 4, 2, 2, 2, 2, 2, 2, 4, 4, 4, 4, 2, 2, 8, 8, 8, 8, 4, 4};
            long V[29] = {0x20B, 14, 0, 0, 0, 0, 0, 0, 0, 0, 0, 4, 0, 0, 0, 4, 0, 0, 0, 0, 0, 3, 0x8160, 0x100000, 0x1000, 0x100000, 0x1000, 0, 16};
            const char *R[29] = {0};
            R[3] = "pe_tf"; R[6] = "pe_entry"; V[7] = TEXT_RVA; V[8] = IMAGEBASE; V[9] = SA; V[10] = FA; R[18] = "pe_img"; V[19] = HDR_FILE;
            for (q = 0; q < 29; q++) fc_field(&c, W[q], V[q], R[q]);
        }
        fc_name(&c, "directory-values");
        for (q = 0; q < 16; q++) {
            const char *r0 = 0, *r1 = 0;
            long v0 = 0, v1 = 0;
            if (q == 1) { r0 = "pe_rd"; v1 = 40; }
            else if (q == 5) { r0 = "pe_rr"; r1 = "pe_rlsize"; }
            else if (q == 10) { r0 = "pe_cfg"; v1 = LOADCFG; }
            else if (q == 12) { r0 = "pe_iat"; v1 = (n + 1) * 8; }
            fc_field(&c, 4, v0, r0); fc_field(&c, 4, v1, r1);
        }
        {
            static const char *sn[4] = {".text", ".rdata", ".data", ".reloc"};
            for (q = 0; q < 4; q++) {
                unsigned char nm[8] = {0};
                long t;
                for (t = 0; sn[q][t]; t++) nm[t] = (unsigned char)sn[q][t];
                if (q == 3) fc_name(&c, "reloc-align");
                fc_lit(&c, nm, 8);
                if (q == 0) { fc_field(&c, 4, 0, "endo"); fc_field(&c, 4, TEXT_RVA, 0); fc_field(&c, 4, 0, "pe_tf"); fc_field(&c, 4, HDR_FILE, 0); }
                if (q == 1) { fc_field(&c, 4, idlen, 0); fc_field(&c, 4, 0, "pe_rd"); fc_field(&c, 4, (idlen + 511) & -512L, 0); fc_field(&c, 4, 0, "pe_rf"); }
                if (q == 2) { fc_field(&c, 4, 0, "pe_dvs"); fc_field(&c, 4, 0, "pe_dt"); fc_field(&c, 4, 0, "pe_datafile"); fc_field(&c, 4, 0, "pe_df"); }
                if (q == 3) { fc_field(&c, 4, 0, "pe_rlsize"); fc_field(&c, 4, 0, "pe_rr"); fc_field(&c, 4, 0, "pe_rsize"); fc_field(&c, 4, 0, "pe_relf"); }
                fc_field(&c, 4, 0, 0); fc_field(&c, 4, 0, 0); fc_field(&c, 2, 0, 0); fc_field(&c, 2, 0, 0);
                fc_field(&c, 4, q == 0 ? 0x60000020L : q == 1 ? 0x40000040L : q == 2 ? 0xC0000040L : 0x42000040L, 0);
            }
        }
        cx_fmt(hn, sizeof hn, "header_%s", arch[a]); cx_fmt(tn, sizeof tn, "header_tail_%s", arch[a]);
        fc_rows(o, hn, &c); fc_tail(o, tn, &c);
        fc_collect(&c);
    }
    fc_init(&c);
    fc_name(&c, "import-values");
    fc_field(&c, 4, 0, "pe_int"); fc_field(&c, 4, 0, 0); fc_field(&c, 4, 0, 0); fc_field(&c, 4, 0, "pe_dll"); fc_field(&c, 4, 0, "pe_iat");
    { static const unsigned char z[20]; fc_lit(&c, z, 20); }
    for (a = 0; a < 2; a++) {
        for (i = 0; i < n; i++) { char cn[64]; cx_fmt(cn, sizeof cn, "name-value%ld", noff[i]); fc_name(&c, fg_dupz(cn)); fc_field(&c, 8, 0, "pe_name"); }
        fc_field(&c, 8, 0, 0);
    }
    for (i = 0; i < n; i++) fc_lit(&c, nraw[i], nlen[i]);
    {
        static unsigned char buf[4096];
        long m = 0, q;
        for (q = 0; q < dlln; q++) buf[m++] = (unsigned char)dll[q];
        buf[m++] = 0;
        for (q = 0; q < cfg - (dlloff + dlln + 1); q++) buf[m++] = 0;
        fc_lit(&c, buf, m);
        fc_field(&c, 4, LOADCFG, 0);
        for (q = 0; q < COOKIE - 4; q++) buf[q] = 0;
        fc_lit(&c, buf, COOKIE - 4);
        fc_field(&c, 8, 0, "pe_cookie");
        fc_lit(&c, buf, LOADCFG - COOKIE - 8);
    }
    fc_rows(o, "imports", &c); fc_tail(o, "imports_tail", &c);
    fc_collect(&c);
    for (i = 1; i < pe_nused; i++) for (j = i; j > 0 && fg_strcmp(pe_used[j - 1], pe_used[j]) > 0; j--) {
        const char *t = pe_used[j]; pe_used[j] = pe_used[j - 1]; pe_used[j - 1] = t;
    }
    ob_z(o, "@bytes\tv:int\n");
    for (i = 0; i < pe_nused; i++) if (tx_prefix(pe_used[i], tx_len(pe_used[i], 64), "byte", 4)) { ob_z(o, "\t"); ob_z(o, pe_used[i] + 4); ob_z(o, "\n"); }
    ob_z(o, "@names\toffset:int\n");
    for (i = 0; i < n; i++) { ob_z(o, "\t"); ob_int(o, noff[i]); ob_z(o, "\n"); }
}
static long kv_hex(Krow *r, int n, const char *name, unsigned char *out, long cap) {
    int i;
    for (i = 0; i < n; i++) if (tx_eq(r[i].kind, "bytes", 8) && tx_eq(r[i].name, name, 64)) {
        long len = tx_len(r[i].value, FG_CAP), q;
        if (len % 2 || len / 2 > cap) fg_die("bad hex fact", name);
        for (q = 0; q < len / 2; q++) {
            int hi = r[i].value[2 * q], lo = r[i].value[2 * q + 1];
            hi = hi <= '9' ? hi - '0' : hi - 'a' + 10; lo = lo <= '9' ? lo - '0' : lo - 'a' + 10;
            out[q] = (unsigned char)(hi * 16 + lo);
        }
        return len / 2;
    }
    fg_die("hex fact absent", name);
    return 0;
}
static void fc_used_bytes(Ob *o) {
    int i, j;
    for (i = 1; i < pe_nused; i++) for (j = i; j > 0 && fg_strcmp(pe_used[j - 1], pe_used[j]) > 0; j--) {
        const char *t = pe_used[j]; pe_used[j] = pe_used[j - 1]; pe_used[j - 1] = t;
    }
    ob_z(o, "@bytes\tv:int\n");
    for (i = 0; i < pe_nused; i++) if (tx_prefix(pe_used[i], tx_len(pe_used[i], 64), "byte", 4)) { ob_z(o, "\t"); ob_z(o, pe_used[i] + 4); ob_z(o, "\n"); }
}
static void fc_lit_name16(Fc *c, const char *s) {
    unsigned char b[16] = {0};
    long i;
    for (i = 0; s[i] && i < 16; i++) b[i] = (unsigned char)s[i];
    fc_lit(c, b, 16);
}

/* enc-macho: Mach-O load commands and the ad-hoc code-signature field schema. */
static void enc_macho(Ob *o) {
    static Krow k[128];
    static Fc c;
    int nk = fg_krows("exec/facts/image-macho.tsv", k, 128), a, i;
    static unsigned char ident[64], dlbind[256], dyld[64], libsys[96];
    long nident = kv_hex(k, nk, "IDENT", ident, 64), ndlbind = kv_hex(k, nk, "DLBIND", dlbind, 256),
         ndyld = kv_hex(k, nk, "DYLD", dyld, 64), nlibsys = kv_hex(k, nk, "LIBSYS", libsys, 96);
#define MC(n) kv_int(k, nk, "const", n)
    const char *arch[4];
    int narch = 0;
    for (i = 0; i < nk; i++) if (tx_eq(k[i].kind, "cputype", 8)) arch[narch++] = k[i].name;
    for (a = 1; a < narch; a++) for (i = a; i > 0 && fg_strcmp(arch[i - 1], arch[i]) > 0; i--) { const char *t = arch[i]; arch[i] = arch[i - 1]; arch[i - 1] = t; }
    {
        const char *cn[10] = {"DATA", "VMADDR", "STRTAB", "page_minus_one", "page_mask", "page4_minus_one", "PAGE4", "signature_base", "DLPREFIX", "DLBINDLEN"};
        long cv[10];
        cv[0] = 1L << 40; cv[1] = MC("VMADDR"); cv[2] = MC("STRTAB"); cv[3] = MC("PAGE") - 1; cv[4] = -MC("PAGE");
        cv[5] = MC("PAGE4") - 1; cv[6] = MC("PAGE4"); cv[7] = 20 + 88 + nident; cv[8] = MC("DLPREFIX"); cv[9] = ndlbind;
        for (i = 0; i < 10; i++) { ob_z(o, "="); ob_z(o, cn[i]); ob_z(o, "\tint\t"); ob_int(o, cv[i]); ob_z(o, "\n"); }
    }
    pe_nused = 0;
    for (a = 0; a < narch; a++) {
        long hdrs = kv_int(k, nk, "hdrs", arch[a]), VM = MC("VMADDR"), SEG = MC("SEG"), SECT = MC("SECT");
        char nm[64];
        unsigned char lib[128];
        long nlib, q;
        fc_big = 0;
        ob_z(o, "=HDRS_"); ob_z(o, arch[a]); ob_z(o, "\tint\t"); ob_int(o, hdrs); ob_z(o, "\n");
        fc_init(&c);
        fc_field(&c, 4, 0xFEEDFACFL, 0); fc_field(&c, 4, kv_int(k, nk, "cputype", arch[a]), 0); fc_field(&c, 4, kv_int(k, nk, "cpusub", arch[a]), 0);
        fc_field(&c, 4, 2, 0); fc_field(&c, 4, MC("NCMDS"), 0); fc_field(&c, 4, kv_int(k, nk, "cmdsz", arch[a]), 0); fc_field(&c, 4, 0x200085, 0); fc_field(&c, 4, 0, 0);
#define SEGC(N, VA, VAR, VMV, VMR, FO, FOR, FS, FSR, PROT, NS) do { fc_field(&c, 4, MC("LC_SEGMENT_64"), 0); fc_field(&c, 4, SEG + SECT * (NS), 0); fc_lit_name16(&c, N); \
        fc_field(&c, 8, VA, VAR); fc_field(&c, 8, VMV, VMR); fc_field(&c, 8, FO, FOR); fc_field(&c, 8, FS, FSR); fc_field(&c, 4, PROT, 0); fc_field(&c, 4, PROT, 0); fc_field(&c, 4, NS, 0); fc_field(&c, 4, 0, 0); } while (0)
#define SECTC(N, S, VA, VAR, SZ, SZR, OFF, OFFR, FLAGS) do { fc_lit_name16(&c, N); fc_lit_name16(&c, S); fc_field(&c, 8, VA, VAR); fc_field(&c, 8, SZ, SZR); fc_field(&c, 4, OFF, OFFR); \
        fc_field(&c, 4, 2, 0); fc_field(&c, 4, 0, 0); fc_field(&c, 4, 0, 0); fc_field(&c, 4, FLAGS, 0); fc_field(&c, 4, 0, 0); fc_field(&c, 4, 0, 0); fc_field(&c, 4, 0, 0); } while (0)
        SEGC("__PAGEZERO", 0, 0, VM, 0, 0, 0, 0, 0, 0, 0);
        SEGC("__TEXT", VM, 0, 0, "mh_text", 0, 0, 0, "mh_text", 5, 1);
        SECTC("__text", "__TEXT", VM + hdrs, 0, 0, "endo", hdrs, 0, 0x80000400L);
        SEGC("__DATA", 0, "mh_datava", 0, "mh_vm", 0, "mh_text", 0, "mh_data", 3, 2);
        SECTC("__data", "__DATA", 0, "mh_datava", 0, "mh_stored", 0, "mh_text", 0);
        SECTC("__bss", "__DATA", 0, "mh_bssva", 0, "mh_bsslen", 0, 0, 1);
        SEGC("__LINKEDIT", 0, "mh_linkva", 0, "mh_linkvm", 0, "mh_link", 0, "mh_linksz", 1, 0);
        fc_field(&c, 4, MC("LC_LOAD_DYLINKER"), 0); fc_field(&c, 4, 32, 0); fc_field(&c, 4, 12, 0);
        { unsigned char d[20] = {0}; for (q = 0; q < ndyld && q < 20; q++) d[q] = dyld[q]; fc_lit(&c, d, 20); }
        for (q = 0; q < nlibsys; q++) lib[q] = libsys[q];
        lib[nlibsys] = 0; nlib = nlibsys + 1;
        while (nlib % 8) lib[nlib++] = 0;
        fc_field(&c, 4, MC("LC_LOAD_DYLIB"), 0); fc_field(&c, 4, 24 + nlib, 0); fc_field(&c, 4, 24, 0); fc_field(&c, 4, 0, 0); fc_field(&c, 4, 0x10000, 0); fc_field(&c, 4, 0x10000, 0);
        fc_lit(&c, lib, nlib);
        fc_field(&c, 4, MC("LC_MAIN"), 0); fc_field(&c, 4, 24, 0); fc_field(&c, 8, 0, "mh_entry"); fc_field(&c, 8, 0, 0);
        fc_field(&c, 4, MC("LC_BUILD_VERSION"), 0); fc_field(&c, 4, 24, 0); fc_field(&c, 4, 1, 0); fc_field(&c, 4, 13L << 16, 0); fc_field(&c, 4, 13L << 16, 0); fc_field(&c, 4, 0, 0);
        fc_field(&c, 4, MC("LC_DYLD_INFO_ONLY"), 0); fc_field(&c, 4, 48, 0); fc_field(&c, 4, 0, 0); fc_field(&c, 4, 0, 0); fc_field(&c, 4, 0, "mh_bindoff"); fc_field(&c, 4, ndlbind, 0);
        for (q = 0; q < 6; q++) fc_field(&c, 4, 0, 0);
        fc_field(&c, 4, MC("LC_SYMTAB"), 0); fc_field(&c, 4, 24, 0); fc_field(&c, 4, 0, "mh_link"); fc_field(&c, 4, 0, 0); fc_field(&c, 4, 0, "mh_link"); fc_field(&c, 4, MC("STRTAB"), 0);
        fc_field(&c, 4, MC("LC_DYSYMTAB"), 0); fc_field(&c, 4, 80, 0);
        for (q = 0; q < 18; q++) fc_field(&c, 4, 0, 0);
        fc_field(&c, 4, MC("LC_CODE_SIGNATURE"), 0); fc_field(&c, 4, 16, 0); fc_field(&c, 4, 0, "mh_sigoff"); fc_field(&c, 4, 0, "mh_siglen");
        { static unsigned char z[512]; long sl = MC("SLACK"); if (sl > 512) fg_die("SLACK too large", 0); fc_lit(&c, z, sl); }
        cx_fmt(nm, sizeof nm, "header_%s", arch[a]); fc_rows(o, nm, &c);
        cx_fmt(nm, sizeof nm, "header_tail_%s", arch[a]); fc_tail(o, nm, &c);
        fc_collect(&c);
        fc_init(&c);
        fc_big = 1;
        fc_field(&c, 4, MC("CS_MAGIC_EMBEDDED"), 0); fc_field(&c, 4, 0, "mh_siglen"); fc_field(&c, 4, 1, 0); fc_field(&c, 4, 0, 0); fc_field(&c, 4, 20, 0);
        fc_name(&c, "signature-length");
        fc_field(&c, 4, MC("CS_MAGIC_CODEDIRECTORY"), 0); fc_field(&c, 4, 0, "mh_cdlen"); fc_field(&c, 4, 0x20400, 0); fc_field(&c, 4, MC("CS_ADHOC"), 0);
        fc_field(&c, 4, 88 + nident, 0); fc_field(&c, 4, 88, 0); fc_field(&c, 4, 0, 0); fc_field(&c, 4, 0, "mh_slots"); fc_field(&c, 4, 0, "mh_sigoff");
        fc_field(&c, 1, 32, 0); fc_field(&c, 1, 2, 0); fc_field(&c, 1, 0, 0); fc_field(&c, 1, 12, 0); fc_field(&c, 4, 0, 0);
        fc_field(&c, 4, 0, 0); fc_field(&c, 4, 0, 0); fc_field(&c, 4, 0, 0); fc_field(&c, 8, 0, 0); fc_field(&c, 8, 0, 0); fc_field(&c, 8, 0, "mh_text"); fc_field(&c, 8, MC("CS_EXECSEG_MAIN_BINARY"), 0);
        fc_big = 0;
        fc_lit(&c, ident, nident);
        cx_fmt(nm, sizeof nm, "signature_%s", arch[a]); fc_rows(o, nm, &c);
        cx_fmt(nm, sizeof nm, "signature_tail_%s", arch[a]); fc_tail(o, nm, &c);
        fc_collect(&c);
#undef SEGC
#undef SECTC
    }
    {
        static unsigned char z[256];
        long pre = MC("DLPREFIX");
        if (pre > 256) fg_die("DLPREFIX too large", 0);
        fc_init(&c); fc_lit(&c, z, pre); fc_tail(o, "prefix", &c); fc_collect(&c);
        fc_init(&c); fc_lit(&c, dlbind, ndlbind); fc_tail(o, "binddata", &c); fc_collect(&c);
    }
    fc_used_bytes(o);
#undef MC
}

/* enc-elf: ELF program-header / dynamic-section field schema and the import/loader slot tables. */
static void enc_elf(Ob *o) {
    static Krow k[64], kp[128];
    static Fc c;
    int nk = fg_krows("exec/facts/image-elf.tsv", k, 64), np = fg_krows("exec/facts/image-pe.tsv", kp, 128), nimp = 0, a, i;
    long VADDR = kv_int(k, nk, "const", "VADDR"), EHDR = kv_int(k, nk, "const", "EHDR"), PHDR = kv_int(k, nk, "const", "PHDR"), PAGE = kv_int(k, nk, "const", "PAGE");
    const char *arch[4];
    int narch = 0;
    char nm[64];
    for (i = 0; i < np; i++) if (tx_eq(kp[i].kind, "import", 8)) nimp++;
    for (i = 0; i < nk; i++) if (tx_eq(k[i].kind, "machine", 8)) arch[narch++] = k[i].name;
    for (a = 1; a < narch; a++) for (i = a; i > 0 && fg_strcmp(arch[i - 1], arch[i]) > 0; i--) { const char *t = arch[i]; arch[i] = arch[i - 1]; arch[i - 1] = t; }
    {
        const char *cn[8] = {"DATA", "RELOCS", "iat_size", "VADDR", "dyn_doff", "fmt_elf", "fmt_macho", "fmt_pe"};
        long cv[8] = {1L << 40, 4L << 40, 0, 0, 0, 1, 2, 3};
        cv[2] = 8L * nimp; cv[3] = VADDR; cv[4] = VADDR + 32;
        for (i = 0; i < 8; i++) { ob_z(o, "="); ob_z(o, cn[i]); ob_z(o, "\tint\t"); ob_int(o, cv[i]); ob_z(o, "\n"); }
    }
    pe_nused = 0; fc_big = 0;
#define EMIT(N) do { cx_fmt(nm, sizeof nm, "%s", N); fc_rows(o, nm, &c); cx_fmt(nm, sizeof nm, "%s_tail", N); fc_tail(o, nm, &c); fc_collect(&c); } while (0)
    fc_init(&c);
    for (i = 0; i < nimp; i++) { char r[32]; cx_fmt(r, sizeof r, "ml_imp_%d", i); fc_field(&c, 8, 0, fg_dupz(r)); }
    EMIT("iat");
    fc_init(&c);
    for (i = 0; i < 4; i++) { char r[32]; cx_fmt(r, sizeof r, "ml_dl_%d", i); fc_field(&c, 8, 0, fg_dupz(r)); }
    EMIT("dlslots");
    { static const unsigned char z[32]; fc_init(&c); fc_lit(&c, z, 32); EMIT("dynslots"); }
    for (a = 0; a < narch; a++) {
        long mach = kv_int(k, nk, "machine", arch[a]);
        int arm = tx_eq(arch[a], "arm64", 8), dyn;
        ob_z(o, "=HDRS_"); ob_z(o, arch[a]); ob_z(o, "\tint\t"); ob_int(o, kv_int(k, nk, "hdrs", arch[a])); ob_z(o, "\n");
        for (dyn = 0; dyn < 2; dyn++) {
            static const unsigned char id[16] = {0x7f, 'E', 'L', 'F', 2, 1, 1, 0};
            const char *interp = arm ? "/lib/ld-linux-aarch64.so.1" : "/lib64/ld-linux-x86-64.so.2";
            long il = tx_len(interp, 64);
            fc_init(&c);
            fc_name(&c, dyn ? "dyn-init" : "header-init");
            fc_lit(&c, id, 16);
            fc_field(&c, 2, 2, 0); fc_field(&c, 2, mach, 0); fc_field(&c, 4, 1, 0); fc_field(&c, 8, 0, "entryva"); fc_field(&c, 8, EHDR, 0); fc_field(&c, 8, 0, 0);
            fc_field(&c, 4, 0, 0); fc_field(&c, 2, EHDR, 0); fc_field(&c, 2, PHDR, 0); fc_field(&c, 2, dyn ? 4 : 2, 0); fc_field(&c, 2, 0, 0); fc_field(&c, 2, 0, 0); fc_field(&c, 2, 0, 0);
#define PH(T, F, OFF, OFFR, VA, VAR, FS, FSR, MS, MSR, AL) do { fc_field(&c, 4, T, 0); fc_field(&c, 4, F, 0); fc_field(&c, 8, OFF, OFFR); fc_field(&c, 8, VA, VAR); fc_field(&c, 8, VA, VAR); \
            fc_field(&c, 8, FS, FSR); fc_field(&c, 8, MS, MSR); fc_field(&c, 8, AL, 0); } while (0)
            if (!dyn) {
                PH(1, 5, 0, 0, VADDR, 0, 0, "tend", 0, "tend", PAGE);
                PH(1, 6, 0, "doff", 0, "data_va", 0, "stored", 0, "memlen", PAGE);
                cx_fmt(nm, sizeof nm, "static_%s", arch[a]);
            } else {
                static const unsigned char names[] = "\0libc.so.6\0dlopen\0dlsym\0dlclose\0dlerror\0";
                static const unsigned char z[32], st[4] = {0x12, 0, 0, 0};
                unsigned char ib[32] = {0};
                static const long nameoff[4] = {11, 18, 24, 32};
                static const long tags[11][2] = {{1, 1}, {4, 480}, {5, 320}, {6, 360}, {10, 40}, {11, 24}, {7, 512}, {8, 96}, {9, 24}, {30, 8}, {0, 0}};
                long q;
                PH(3, 4, 288, 0, VADDR + 288, 0, il + 1, 0, il + 1, 0, 1);
                PH(1, 5, 0, 0, VADDR, 0, 0, "tend", 0, "tend", PAGE);
                PH(1, 6, 0, "doff", 0, "dyn_slots", 0, "dyn_filesz", 0, "dyn_memsz", PAGE);
                PH(2, 4, 608, 0, VADDR + 608, 0, 176, 0, 176, 0, 8);
                for (q = 0; q < il; q++) ib[q] = (unsigned char)interp[q];
                fc_lit(&c, ib, 32);
                fc_lit(&c, names, (long)sizeof names - 1);
                fc_lit(&c, z, 24);
                for (q = 0; q < 4; q++) { fc_field(&c, 4, nameoff[q], 0); fc_lit(&c, st, 4); fc_field(&c, 8, 0, 0); fc_field(&c, 8, 0, 0); }
                fc_field(&c, 4, 1, 0); fc_field(&c, 4, 5, 0);
                fc_lit(&c, z, 24);
                for (q = 0; q < 4; q++) {
                    char cn[32];
                    cx_fmt(cn, sizeof cn, "dynreloc%ld", 8 * q);
                    fc_name(&c, fg_dupz(cn));
                    fc_field(&c, 8, 0, "dyn_reloc"); fc_field(&c, 8, ((q + 1) << 32) | (arm ? 1025 : 6), 0); fc_field(&c, 8, 0, 0);
                }
                for (q = 0; q < 11; q++) { long v = tags[q][1]; if (tags[q][0] == 4 || tags[q][0] == 5 || tags[q][0] == 6 || tags[q][0] == 7) v += VADDR; fc_field(&c, 8, tags[q][0], 0); fc_field(&c, 8, v, 0); }
                cx_fmt(nm, sizeof nm, "dyn_%s", arch[a]);
            }
#undef PH
            {
                char base[64];
                cx_fmt(base, sizeof base, "%s", nm);
                EMIT(base);
            }
        }
    }
#undef EMIT
    ob_z(o, "@relocs\toff:int\n");
    for (i = 0; i < 4; i++) { ob_z(o, "\t"); ob_int(o, 8 * i); ob_z(o, "\n"); }
    fc_used_bytes(o);
}

/* lower-armfuse: TAPE SHAPE ops eligible for ARM immediate fusion (shape / exclude / read policy). */
static void lower_armfuse(Ob *o) {
    static char *pk[128], *pv[128], *op[512], *sh[512];
    int np = 0, ns = 0, i, j, sel = 0;
    Lines P = fg_lines("exec/lower/armfuse-shapes.tsv"), S = fg_lines("exec/facts/tape-shape.tsv");
    for (i = 0; i < P.n; i++) {
        char *cells[4], *line = fg_dupz(P.l[i]);
        if (!*line || line[0] == '#') continue;
        if (fg_split(line, cells, 4) != 2 || np == 128) fg_die("bad armfuse-shapes row", P.l[i]);
        pk[np] = cells[0]; pv[np++] = cells[1];
    }
    for (i = 0; i < S.n; i++) {
        char *cells[4], *line = fg_dupz(S.l[i]);
        if (!*line || line[0] == '#') continue;
        if (fg_split(line, cells, 4) != 2 || ns == 512) fg_die("bad tape-shape row", S.l[i]);
        op[ns] = cells[0]; sh[ns++] = cells[1];
    }
    ob_z(o, "=none\tjson\t[]\n@shapes\ti:int\top:str\treads:json\tfirst:json\trest:json\n");
    for (i = 0; i < ns; i++) {
        int ok = 0, ex = 0;
        for (j = 0; j < np; j++) {
            if (tx_eq(pk[j], "shape", 8) && tx_eq(pv[j], sh[i], FG_CAP)) ok = 1;
            if (tx_eq(pk[j], "exclude", 8) && tx_eq(pv[j], op[i], FG_CAP)) ex = 1;
        }
        if (!ok || ex) continue;
        ob_z(o, "\t"); ob_int(o, sel); ob_z(o, "\t"); ob_z(o, op[i]); ob_z(o, "\t[");
        {   /* 1-based operand positions after the first whose kind is a read kind */
            char *kinds = fg_dupz(sh[i]), *cell[16], *p = kinds;
            int nk = 0, q, first = 1;
            while (*kinds && nk < 16) {          /* comma-separated operand kinds */
                cell[nk++] = p;
                while (*p && *p != ',') p++;
                if (!*p) break;
                *p++ = 0;
            }
            for (q = 1; q < nk; q++) {
                int rd = 0;
                for (j = 0; j < np; j++) if (tx_eq(pk[j], "read", 8) && tx_eq(pv[j], cell[q], 64)) rd = 1;
                if (!rd) continue;
                if (!first) ob_z(o, ", ");
                ob_int(o, q); first = 0;
            }
        }
        ob_z(o, sel == 0 ? "]\t[1]\t[]\n" : "]\t[]\t[1]\n");
        sel++;
    }
}

/* A JSON list of plain strings ["a","b",...] into the arena; returns the count. */
static int jlist(const char *s, char **out, int cap) {
    long n = tx_len(s, FG_CAP), at = 1;
    int k = 0;
    if (n < 2 || s[0] != '[' || s[n - 1] != ']') fg_die("not a JSON list", s);
    while (at < n - 1) {
        long q;
        while (at < n - 1 && (s[at] == ' ' || s[at] == ',')) at++;
        if (at >= n - 1) break;
        if (s[at] != '"' || k == cap) fg_die("bad JSON list item", s);
        q = tx_chr(s + at + 1, n - at - 1, '"');
        if (q < 0) fg_die("unterminated string", s);
        out[k] = jstr(s + at, q + 2);
        if (!out[k]) fg_die("bad JSON string", s);
        k++;
        at += q + 2;
    }
    return k;
}
static char *fg_eqrow(const char *rel, const char *name) {   /* "=NAME\tKIND\tVALUE" value */
    Lines L = fg_lines(rel);
    int i;
    for (i = 0; i < L.n; i++) {
        char *cells[4], *line = fg_dupz(L.l[i]);
        if (line[0] != '=') continue;
        if (fg_split(line + 1, cells, 3) == 3 && tx_eq(cells[0], name, 256)) return cells[2];
    }
    fg_die("row absent", name);
    return 0;
}
static int byte_less(const char *a, const char *b) { return fg_strcmp(a, b) < 0; }

static void limits_emit(Ob *o);
static void trie_emit(Ob *o, char **w, int nw, char **tkn, int *tkv, int ntk, char **spk, char **spv, int nsp,
                      const char **skip, int nskip, long tk_other);
static int tk_lookup(char **tkn, int *tkv, int ntk, const char *name) {
    int q, t = -1;
    for (q = 0; q < ntk; q++) if (tx_eq(tkn[q], name, FG_CAP)) t = tkv[q];
    if (t < 0) fg_die("no TK for", name);
    return t;
}

/* k2-gen2-tokens: parse2's token-reader trie over the parse words, parse2's extra words (appended after
   max(TK)), the span prefixes and the skipped qualifiers; plus the decimal overflow limits. */
static void k2_gen2_tokens(Ob *o) {
    static char *w[2048], *tkn[2048], *names[8192], *spk[16], *spv[16], *extra[64];
    static int tkv[2048];
    static const char *skip[4] = {"type=const", "type=volatile", "type=restrict", "type=inline"};
    int nw = 0, ntk = 0, nn = 0, nsp = 0, ne, i, j, mx = 0;
    long tk_other;
    Lines S;
    pt_build();
    for (i = 0; i < pt.nw; i++) w[nw++] = pt.w[i];
    for (i = 0; i < pt.ntk; i++) { tkn[ntk] = pt.tkn[i]; tkv[ntk++] = pt.tkv[i]; if (pt.tkv[i] > mx) mx = pt.tkv[i]; }
    ne = jlist(fg_eqrow("exec/facts/parse2-extra.tsv", "words"), extra, 64);
    for (i = 0; i < ne; i++) {
        w[nw++] = extra[i];
        for (j = 0; j < ntk; j++) if (tx_eq(tkn[j], extra[i], FG_CAP)) break;
        tkv[j] = ++mx;
        if (j == ntk) tkn[ntk++] = extra[i];
    }
    S = fg_lines("exec/parse/token-prefixes.tsv");
    for (i = 0; i < S.n; i++) {
        char *cells[4], *line = fg_dupz(S.l[i]);
        if (!*line || line[0] == '#') continue;
        if (fg_split(line, cells, 4) != 2 || nsp == 16) fg_die("bad token-prefixes row", S.l[i]);
        spk[nsp] = cells[0]; spv[nsp++] = cells[1];
    }
    for (i = 0; i < nsp; i++) w[nw++] = spk[i];
    for (i = 0; i < 4; i++) w[nw++] = (char *)skip[i];
    tk_other = fg_const("parse-constants", "TK_OTHER");
    trie_emit(o, w, nw, tkn, tkv, ntk, spk, spv, nsp, skip, 4, tk_other);
    limits_emit(o);
    (void)names; (void)nn;
}

static void limits_emit(Ob *o) {
    int i;
    for (i = 0; i < 10; i++) {
        unsigned long lim = (~0UL - (unsigned long)i) / 10UL;
        char d[32];
        int k = 31;
        d[k] = 0;
        do { d[--k] = (char)('0' + lim % 10UL); lim /= 10UL; } while (lim);
        ob_z(o, "=limit"); ob_int(o, i); ob_z(o, "\tint\t"); ob_z(o, d + k); ob_z(o, "\n");
    }
}

/* finite_rules.prefix_facts + node(): every non-empty prefix of words (byte-sorted), root first. */
static void trie_emit(Ob *o, char **w, int nw, char **tkn, int *tkv, int ntk, char **spk, char **spv, int nsp,
                      const char **skip, int nskip, long tk_other) {
    static char *names[8192];
    int nn = 0, i, j;
    for (i = 0; i < nw; i++) {                    /* every non-empty prefix, once */
        long n = tx_len(w[i], 256), m;
        for (m = 1; m <= n; m++) {
            int seen = 0;
            for (j = 0; j < nn; j++) if (tx_len(names[j], 256) == m && tx_same(names[j], m, w[i], m)) { seen = 1; break; }
            if (!seen) { if (nn == 8192) fg_die("too many prefixes", 0); names[nn++] = ar_dup(fg_ar, w[i], m); }
        }
    }
    for (i = 1; i < nn; i++) { char *x = names[i]; for (j = i - 1; j >= 0 && byte_less(x, names[j]); j--) names[j + 1] = names[j]; names[j + 1] = x; }
    ob_z(o, "=N\tjson\t[");
    for (i = -1; i < nn; i++) {                   /* -1 = the root (empty prefix) */
        const char *p = i < 0 ? "" : names[i];
        long pl = tx_len(p, 256);
        int sp = -1, q, first;
        if (i >= 0) ob_z(o, ", ");
        for (q = 0; q < nsp; q++) if (tx_eq(spk[q], p, 256)) sp = q;
        ob_z(o, "{\"name\": "); ob_str(o, p);
        if (sp >= 0) { ob_z(o, ", \"span\": [{\"reader\": "); ob_str(o, spv[sp]); ob_z(o, "}], \"children\": [], \"q\": [], \"w\": [], \"tail\": []}"); continue; }
        ob_z(o, ", \"span\": [], \"children\": [");
        first = 1;
        for (q = 0; q < nn; q++) {
            long cl = tx_len(names[q], 256);
            if (cl != pl + 1 || !tx_prefix(names[q], cl, p, pl)) continue;
            if (!first) ob_z(o, ", ");
            ob_z(o, "{\"name\": "); ob_str(o, names[q]); ob_z(o, ", \"last\": "); ob_int(o, (unsigned char)names[q][cl - 1]); ob_z(o, "}");
            first = 0;
        }
        {
            int is_skip = 0, t = -1;
            for (q = 0; q < nskip; q++) if (tx_eq(skip[q], p, 256)) is_skip = 1;
            for (q = 0; q < ntk; q++) if (tx_eq(tkn[q], p, 256)) t = tkv[q];
            ob_z(o, is_skip ? "], \"q\": [1], \"w\": [" : "], \"q\": [], \"w\": [");
            if (!is_skip && t >= 0) { ob_z(o, "{\"tok\": "); ob_int(o, t); ob_z(o, "}"); }
            ob_z(o, "], \"tail\": [{\"tok\": "); ob_int(o, tk_other); ob_z(o, "}]}");
        }
    }
    ob_z(o, "]\n");
}

/* Rows of exec/parse2/NAME.tsv after its header line, split on tabs. */
static int p2_rows(const char *name, char ***rows, int *ncol, int cap) {
    char rel[256];
    Lines L;
    int i, n = 0;
    cx_fmt(rel, sizeof rel, "exec/parse2/%s.tsv", name);
    L = fg_lines(rel);
    for (i = 1; i < L.n; i++) {
        char *cells[16], *line = fg_dupz(L.l[i]);
        int k, c;
        if (!*L.l[i]) continue;
        c = fg_split(line, cells, 16);
        if (c < 1 || n == cap) fg_die("bad row", L.l[i]);
        rows[n] = ar_alloc(fg_ar, (long)sizeof(char *) * c);
        for (k = 0; k < c; k++) rows[n][k] = cells[k];
        ncol[n++] = c;
    }
    return n;
}

/* k2-units-tokens: units-manifest tokenizer facts (units qualifiers appended after max(TK)). */
static void k2_units_tokens(Ob *o) {
    static char *w[2048], *tkn[2048], *spk[16], *spv[16];
    static int tkv[2048], nc[256];
    static char **R[256];
    static const char *skip[2] = {"type=const", "type=volatile"};
    int nw = 0, ntk = 0, nsp = 0, nq, i, j, mx = 0, nb = 0, builtin[1024];
    long TK_ID = fg_const("parse-constants", "TK_ID"), tk_other = fg_const("parse-constants", "TK_OTHER");
    char *quals[64];
    Lines S;
    pt_build();
    for (i = 0; i < pt.ntk; i++) { tkn[ntk] = pt.tkn[i]; tkv[ntk++] = pt.tkv[i]; if (pt.tkv[i] > mx) mx = pt.tkv[i]; }
    nq = p2_rows("units-qualifiers", R, nc, 64);
    for (i = 0; i < nq; i++) {
        quals[i] = R[i][0];
        for (j = 0; j < ntk; j++) if (tx_eq(tkn[j], quals[i], FG_CAP)) break;
        tkv[j] = ++mx;
        if (j == ntk) tkn[ntk++] = quals[i];
    }
    for (i = 0; i < pt.nw; i++) w[nw++] = pt.w[i];
    for (i = 0; i < nq; i++) w[nw++] = quals[i];
    S = fg_lines("exec/parse/token-prefixes.tsv");
    for (i = 0; i < S.n; i++) {
        char *cells[4], *line = fg_dupz(S.l[i]);
        if (!*line || line[0] == '#') continue;
        if (fg_split(line, cells, 4) != 2 || nsp == 16) fg_die("bad token-prefixes row", S.l[i]);
        spk[nsp] = cells[0]; spv[nsp++] = cells[1];
    }
    {
        int nws = nw;
        static char *tw[2048];
        for (i = 0; i < nw; i++) tw[i] = w[i];
        for (i = 0; i < nsp; i++) tw[nws++] = spk[i];
        trie_emit(o, tw, nws, tkn, tkv, ntk, spk, spv, nsp, skip, 2, tk_other);
    }
#define TKOF(name) tk_lookup(tkn, tkv, ntk, (name))
    {
        static char **B[64];
        static int bc[64];
        int nbs = p2_rows("units-builtin", B, bc, 64);
        for (i = 0; i < nw; i++) {
            int hit = 0, q;
            for (q = 0; q < nbs; q++)
                if (tx_prefix(w[i], tx_len(w[i], 256), B[q][0], tx_len(B[q][0], 256)) && !tx_eq(w[i], B[q][1], 256)) hit = 1;
            if (hit) builtin[nb++] = TKOF(w[i]);
        }
    }
    ob_z(o, "=builtin\tjson\t[");
    for (i = 0; i < nb; i++) { if (i) ob_z(o, ", "); ob_int(o, builtin[i]); }
    ob_z(o, "]\n@qualifiers\tname:str\ttok:int\n");
    for (i = 0; i < nq; i++) { ob_z(o, "\t"); ob_z(o, quals[i]); ob_z(o, "\t"); ob_int(o, TKOF(quals[i])); ob_z(o, "\n"); }
    {
        static char **T[128];
        static int tc[128];
        int nt = p2_rows("units-tokens", T, tc, 128);
        ob_z(o, "@tokens\tclass:str\ttok:int\n");
        for (i = 0; i < nt; i++) { ob_z(o, "\t"); ob_z(o, T[i][0]); ob_z(o, "\t"); ob_int(o, tx_eq(T[i][1], "identifier", 16) ? TK_ID : TKOF(T[i][1])); ob_z(o, "\n"); }
        limits_emit(o);
        ob_z(o, "=classes\tjson\t{");
        for (i = 0; i < nt; i++) {
            for (j = 0; j < i; j++) if (tx_eq(T[j][0], T[i][0], 256)) break;
            if (j < i) continue;                  /* dict: first position */
            {
                int k, last = i;
                for (k = i + 1; k < nt; k++) if (tx_eq(T[k][0], T[i][0], 256)) last = k;
                if (i) ob_z(o, ", ");
                ob_str(o, T[i][0]); ob_z(o, ": ["); ob_int(o, tx_eq(T[last][1], "identifier", 16) ? TK_ID : TKOF(T[last][1])); ob_z(o, "]");
            }
        }
        ob_z(o, nt ? ", \"builtin\": [" : "\"builtin\": [");
        for (i = 0; i < nb; i++) { if (i) ob_z(o, ", "); ob_int(o, builtin[i]); }
        ob_z(o, "]}\n");
    }
    {
        static char **X[64];
        static int xc[64];
        int n = p2_rows("units-reject", X, xc, 64);
        for (i = 0; i < n; i++) { ob_z(o, "="); ob_z(o, X[i][0]); ob_z(o, "\tstr\t"); ob_z(o, X[i][1]); ob_z(o, "\n"); }
    }
    ob_z(o, "@lengths\tbyte:str\tstep:str\tnext:str\tshift:int\n");
    for (i = 0; i < 4; i++) {
        char b[64];
        cx_fmt(b, sizeof b, "\tL%d\tL%db\t", i, i); ob_z(o, b);
        if (i < 3) { cx_fmt(b, sizeof b, "L%d", i + 1); ob_z(o, b); } else ob_z(o, "EXTENT");
        ob_z(o, "\t"); ob_int(o, 8 * i); ob_z(o, "\n");
    }
    {
        const char *sect[2] = {"units-counters", "units-separators"}, *head[2] = {"@counters\tsection:str\ttoken:str\tslot:str\n", "@separators\tentry:str\tnext:str\n"};
        int s;
        for (s = 0; s < 2; s++) {
            static char **X[128];
            static int xc[128];
            int n = p2_rows(sect[s], X, xc, 128), k;
            ob_z(o, head[s]);
            for (i = 0; i < n; i++) { for (k = 0; k < xc[i]; k++) { ob_z(o, "\t"); ob_z(o, X[i][k]); } ob_z(o, "\n"); }
        }
    }
    ob_z(o, "@trailer\tstate:str\tnext:str\tbyte:int\n");
    {
        static char **X[8];
        static int xc[8];
        char *p;
        int n = p2_rows("units-trailer", X, xc, 8), t = 0;
        if (n < 1) fg_die("units-trailer is empty", 0);
        p = X[0][0];
        if (*p != '[') fg_die("units-trailer is not a list", p);
        p++;
        while (*p && *p != ']') {
            char *end, b[64];
            long v;
            while (*p == ' ' || *p == ',') p++;
            if (*p == ']') break;
            v = strtol(p, &end, 10);
            if (end == p) fg_die("units-trailer item is not an integer", X[0][0]);
            cx_fmt(b, sizeof b, "\tTRAIL%d\tTRAIL%d\t%ld\n", t, t + 1, v); ob_z(o, b);
            t++; p = end;
        }
    }
    ob_z(o, "@keys\tkey:int\n");
    for (i = 0; i < 257; i++) { ob_z(o, "\t"); ob_int(o, i); ob_z(o, "\n"); }
    ob_z(o, "=STATIC\tint\t"); ob_int(o, 1L << 40);
    ob_z(o, "\n=tk_goto\tint\t"); ob_int(o, TKOF("goto"));
    ob_z(o, "\n=tk_colon\tint\t"); ob_int(o, TKOF(":")); ob_z(o, "\n");
#undef TKOF
}

/* finite_rules.prefix_facts as nested JSON: words may contain 0 entries (skipped). */
typedef struct { char *name[4096]; int n; char **w; int nw; } Pf;
static void pf_build(Pf *p, char **w, int nw) {
    int i, j;
    long m;
    p->n = 0; p->w = w; p->nw = nw;
    for (i = 0; i < nw; i++) {
        long n;
        if (!w[i]) continue;
        n = tx_len(w[i], 256);
        for (m = 1; m <= n; m++) {
            int seen = 0;
            for (j = 0; j < p->n; j++) if (tx_len(p->name[j], 256) == m && tx_same(p->name[j], m, w[i], m)) { seen = 1; break; }
            if (!seen) { if (p->n == 4096) fg_die("too many prefixes", 0); p->name[p->n++] = ar_dup(fg_ar, w[i], m); }
        }
    }
    for (i = 1; i < p->n; i++) { char *x = p->name[i]; for (j = i - 1; j >= 0 && byte_less(x, p->name[j]); j--) p->name[j + 1] = p->name[j]; p->name[j + 1] = x; }
}
static void pf_node(Ob *o, Pf *p, int i);
static void pf_children(Ob *o, Pf *p, const char *name) {
    long pl = tx_len(name, 256);
    int q, first = 1;
    ob_z(o, "[");
    for (q = 0; q < p->n; q++) {
        long cl = tx_len(p->name[q], 256);
        if (cl != pl + 1 || !tx_prefix(p->name[q], cl, name, pl)) continue;
        if (!first) ob_z(o, ", ");
        pf_node(o, p, q); first = 0;
    }
    ob_z(o, "]");
}
static void pf_head(Ob *o, Pf *p, int i) {   /* the keys before children */
    const char *nm = p->name[i];
    long nl = tx_len(nm, 256);
    int q, best = -1, word = 0;
    for (q = 0; q < p->nw; q++) {
        long wl;
        if (!p->w[q]) continue;
        wl = tx_len(p->w[q], 256);
        if (tx_eq(p->w[q], nm, 256)) word = 1;
        if (tx_prefix(nm, nl, p->w[q], wl) && (best < 0 || wl > tx_len(p->w[best], 256))) best = q;
    }
    ob_z(o, "{\"name\": "); ob_str(o, nm); ob_z(o, ", \"last\": "); ob_int(o, (unsigned char)nm[nl - 1]);
    ob_z(o, word ? ", \"word\": \"yes\", \"longest\": " : ", \"word\": \"no\", \"longest\": "); ob_int(o, best);
    ob_z(o, ", \"children\": "); pf_children(o, p, nm);
}
static void pf_node(Ob *o, Pf *p, int i) { pf_head(o, p, i); ob_z(o, "}"); }

/* lex-gen: E1 lexer facts (dispatch rows, peek classes, word and punctuator tries, token names). */
static void lex_gen(Ob *o) {
    static char *toks[512], *typekw[64], *lw[64], *lwg[64], *lwc[64], *lws[64], *lt_c[1024], *lt_p[1024], *lt_y[1024];
    static char *cls[257], *classes[64], *head[32], *sp_tok[256], *words[1024];
    static int ws[257], kwkind_v[1024], sp_plain[256], sp_typed[256];
    static char *kwkind_n[1024];
    static Pf ID, OP;
    static char *opw[512];
    int ntok = 0, ntk = 0, nlw = 0, nlt = 0, nws = 0, ncl = 0, nhead = 0, nsp = 0, nkw = 0, nwords = 0, i, j;
    long EOFC = fg_const("lex-consts", "EOF"), KID = fg_const("lex-consts", "KID"), TYPE = fg_const("lex-consts", "TYPE"), CLASSNAMES = fg_const("lex-consts", "CLASSNAMES");
    {   /* token schema */
        Lines L = fg_lines("weights/gold/parse.tsv");
        int found = 0;
        for (i = 0; i < L.n; i++) if (tx_prefix(L.l[i], tx_len(L.l[i], FG_CAP), "#field\ttok\t", 11)) {
            char *cells[1024], *line = fg_dupz(L.l[i]);
            int c = fg_split(line, cells, 1024), k;
            for (k = 2; k < c; k++) toks[ntok++] = cells[k];
            found++;
        }
        if (found != 1 || !ntok) fg_die("missing or repeated token schema", 0);
    }
    {
        Lines L = fg_lines("iterate/kernel/typekw.tsv");
        for (i = 0; i < L.n; i++) {
            char *cells[4], *line = fg_dupz(L.l[i]);
            if (!*line || line[0] == '#') continue;
            if (fg_split(line, cells, 4) != 2 || !tx_eq(cells[0], "kw", 4) || !*cells[1]) fg_die("bad typekw row", L.l[i]);
            typekw[ntk++] = cells[1];
        }
    }
    {   /* lexcls: byte -> class, attws bytes in row order */
        Lines L = fg_lines("weights/gold/lexcls.tsv");
        for (i = 0; i < L.n; i++) {
            char *cells[8], *line = fg_dupz(L.l[i]);
            int b;
            if (!*line || line[0] == '#') continue;
            if (fg_split(line, cells, 8) != 3 || tx_eq(cells[0], "b", 4)) continue;
            b = tx_eq(cells[0], "eof", 4) ? (int)EOFC : (int)strtol(cells[0], 0, 10);
            if (b < 0 || b > 256) fg_die("bad lexcls byte", cells[0]);
            cls[b] = cells[1];
            if (tx_eq(cells[2], "yes", 4)) ws[nws++] = b;
        }
        for (i = 0; i <= 256; i++) if (!cls[i]) fg_die("lexcls lacks a byte", 0);
    }
    {
        Lines L = fg_lines("weights/gold/lexword.tsv");
        for (i = 0; i < L.n; i++) {
            char *cells[8], *line = fg_dupz(L.l[i]);
            if (!*line || line[0] == '#') continue;
            if (fg_split(line, cells, 8) != 4 || tx_eq(cells[0], "w", 4)) continue;
            lw[nlw] = cells[0]; lwg[nlw] = cells[1]; lwc[nlw] = cells[2]; lws[nlw++] = cells[3];
        }
    }
    {
        Lines L = fg_lines("weights/gold/lex.tsv");
        for (i = 0; i < L.n; i++) {
            char *cells[32], *line = fg_dupz(L.l[i]);
            int c = fg_split(line, cells, 32), k;
            if (c >= 1 && tx_eq(cells[0], "#head", 8)) { for (k = 3; k < c; k++) head[nhead++] = cells[k]; continue; }
            if (L.l[i][0] == '#' || c < 3 || tx_eq(cells[0], "c", 4)) continue;
            for (k = 0; k < nlt; k++) if (tx_eq(lt_c[k], cells[0], 64) && tx_eq(lt_p[k], cells[1], 64)) break;
            if (k == nlt) { lt_c[nlt] = cells[0]; lt_p[nlt] = cells[1]; nlt++; }
            lt_y[k] = cells[2];
        }
    }
    for (i = 0; i < nlt; i++) {                   /* CLASSES = sorted(set(c)) */
        for (j = 0; j < ncl; j++) if (tx_eq(classes[j], lt_c[i], 64)) break;
        if (j == ncl) classes[ncl++] = lt_c[i];
    }
    for (i = 1; i < ncl; i++) { char *x = classes[i]; for (j = i - 1; j >= 0 && byte_less(x, classes[j]); j--) classes[j + 1] = classes[j]; classes[j + 1] = x; }
    {
        Lines L = fg_lines("exec/lex/spelling.tsv");
        for (i = 0; i < L.n; i++) {
            char *cells[4], *line = fg_dupz(L.l[i]);
            if (!*line || line[0] == '#') continue;
            if (fg_split(line, cells, 4) != 3) fg_die("bad spelling row", L.l[i]);
            sp_tok[nsp] = cells[0]; sp_plain[nsp] = tx_eq(cells[1], "yes", 4); sp_typed[nsp++] = tx_eq(cells[2], "yes", 4);
        }
    }
#define ISAL(c) ((c) != EOFC && tx_eq(cls[(c)], "A", 4))
#define ISDI(c) ((c) != EOFC && tx_eq(cls[(c)], "d", 4))
    for (i = 0; i < ntok; i++) if (*toks[i] && ISAL((unsigned char)toks[i][0])) {
        for (j = 0; j < nkw; j++) if (tx_eq(kwkind_n[j], toks[i], 256)) break;
        if (j == nkw) kwkind_n[nkw++] = toks[i];
        kwkind_v[j] = i < CLASSNAMES ? (int)KID : i;
    }
    for (i = 0; i < ntk; i++) {
        for (j = 0; j < nkw; j++) if (tx_eq(kwkind_n[j], typekw[i], 256)) break;
        if (j == nkw) kwkind_n[nkw++] = typekw[i];
        kwkind_v[j] = (int)TYPE;
    }
    for (i = 0; i < nkw; i++) words[nwords++] = kwkind_n[i];
    for (i = 0; i < nlw; i++) if (!tx_eq(lwg[i], "none", 8) || tx_eq(lwc[i], "yes", 4) || tx_eq(lws[i], "yes", 4)) words[nwords++] = lw[i];
    {   /* sorted(set(WORDS)) */
        int n2 = 0;
        for (i = 0; i < nwords; i++) { for (j = 0; j < n2; j++) if (tx_eq(words[j], words[i], 256)) break; if (j == n2) words[n2++] = words[i]; }
        nwords = n2;
        for (i = 1; i < nwords; i++) { char *x = words[i]; for (j = i - 1; j >= 0 && byte_less(x, words[j]); j--) words[j + 1] = words[j]; words[j + 1] = x; }
    }
    pf_build(&ID, words, nwords);
    for (i = 0; i < ntok; i++) opw[i] = (*toks[i] && !ISAL((unsigned char)toks[i][0])) ? toks[i] : 0;
    pf_build(&OP, opw, ntok);
    {   /* HANDLE and PEEKCLASS */
        static char *rowc[64];
        int nd = 0;
        char *bfirst[64];
        int bfv[64];
        for (i = 0; i < ncl; i++) {
            char *v = 0;
            int same = 1, k;
            for (k = 0; k < nlt; k++) if (tx_eq(lt_c[k], classes[i], 64)) { if (!v) v = lt_y[k]; else if (!tx_eq(v, lt_y[k], 64)) same = 0; }
            rowc[i] = same ? v : 0;
            bfv[i] = -1;
            for (k = 0; k <= 256; k++) if (tx_eq(cls[k], classes[i], 64)) { bfv[i] = k; break; }
            if (bfv[i] < 0) fg_die("class without a byte", classes[i]);
            bfirst[i] = classes[i];
        }
#define HANDLE_OPEN(STATE, CL, ACT) do { if (nd++) ob_z(o, ", "); ob_z(o, "{\"state\": "); ob_str(o, STATE); ob_z(o, ", \"cls\": "); ob_str(o, CL); ob_z(o, ", \"act\": "); ob_str(o, ACT); } while (0)
        ob_z(o, "=HANDLE\tjson\t[");
        for (i = 0; i < ncl; i++) if (rowc[i]) {
            int h;
            HANDLE_OPEN("DISPATCH", classes[i], rowc[i]);
            ob_z(o, ", \"peek\": [], \"peekstate\": []");
            for (h = 0; h < nhead; h++) { ob_z(o, ", "); ob_str(o, head[h]); ob_z(o, tx_eq(rowc[i], head[h], 64) ? ": [{}]" : ": []"); }
            ob_z(o, "}");
        }
        for (i = 0; i < ncl; i++) if (!rowc[i]) {
            int order[64], k, q, nacts = 0, h;
            char *acts[64];
            for (k = 0; k < ncl; k++) order[k] = k;
            for (k = 1; k < ncl; k++) { int x = order[k]; for (q = k - 1; q >= 0 && bfv[order[q]] > bfv[x]; q--) order[q + 1] = order[q]; order[q + 1] = x; }
            for (k = 0; k < ncl; k++) {
                char *a = 0;
                for (q = 0; q < nlt; q++) if (tx_eq(lt_c[q], classes[i], 64) && tx_eq(lt_p[q], classes[order[k]], 64)) a = lt_y[q];
                if (!a) fg_die("lex table lacks a cell", classes[i]);
                for (q = 0; q < nacts; q++) if (tx_eq(acts[q], a, 64)) break;
                if (q == nacts) acts[nacts++] = a;
            }
            for (q = 0; q < nacts; q++) {
                char st[128];
                cx_fmt(st, sizeof st, "H:%s", acts[q]);
                HANDLE_OPEN(st, classes[i], acts[q]);
                ob_z(o, ", \"peek\": [");
                if (q == 0) for (k = 0; k < ncl; k++) {
                    char *a = 0;
                    int r;
                    for (r = 0; r < nlt; r++) if (tx_eq(lt_c[r], classes[i], 64) && tx_eq(lt_p[r], classes[order[k]], 64)) a = lt_y[r];
                    if (k) ob_z(o, ", ");
                    ob_z(o, "{\"cls\": "); ob_str(o, classes[i]); ob_z(o, ", \"col\": "); ob_str(o, classes[order[k]]); ob_z(o, ", \"act\": "); ob_str(o, a); ob_z(o, "}");
                }
                ob_z(o, q == 0 ? "], \"peekstate\": [{\"name\": " : "], \"peekstate\": [");
                if (q == 0) { ob_str(o, classes[i]); ob_z(o, "}]"); } else ob_z(o, "]");
                for (h = 0; h < nhead; h++) { ob_z(o, ", "); ob_str(o, head[h]); ob_z(o, tx_eq(acts[q], head[h], 64) ? ": [{}]" : ": []"); }
                ob_z(o, "}");
            }
        }
        ob_z(o, "]\n=PEEKCLASS\tjson\t[");
        {
            int first = 1;
            for (i = 0; i < ncl; i++) if (!rowc[i]) { if (!first) ob_z(o, ", "); ob_z(o, "{\"name\": "); ob_str(o, classes[i]); ob_z(o, "}"); first = 0; }
        }
        ob_z(o, "]\n");
#undef HANDLE_OPEN
        (void)bfirst;
    }
    ob_z(o, "=IDROOT\tjson\t"); pf_children(o, &ID, ""); ob_z(o, "\n");
    ob_z(o, "=OPROOT\tjson\t"); pf_children(o, &OP, ""); ob_z(o, "\n");
    ob_z(o, "=IDPFX\tjson\t[");
    for (i = 0; i < ID.n; i++) {
        const char *nm = ID.name[i];
        int kind = (int)KID, k, skipp = 0, drop = 0, pch = 0, pst = 0;
        for (k = 0; k < nkw; k++) if (tx_eq(kwkind_n[k], nm, 256)) kind = kwkind_v[k];
        for (k = 0; k < nlw; k++) if (tx_eq(lw[k], nm, 256)) {
            if (tx_eq(lwg[k], "skipparen", 16)) skipp = 1;
            if (tx_eq(lwg[k], "drop", 16)) drop = 1;
            if (tx_eq(lwc[k], "yes", 4)) pch = 1;
            if (tx_eq(lws[k], "yes", 4)) pst = 1;
        }
        if (i) ob_z(o, ", ");
        pf_head(o, &ID, i);
        ob_z(o, ", \"kind\": "); ob_int(o, kind);
        ob_z(o, skipp ? ", \"ifskip\": [{}]" : ", \"ifskip\": []");
        ob_z(o, drop ? ", \"ifdrop\": [{}]" : ", \"ifdrop\": []");
        ob_z(o, !skipp && !drop ? ", \"iftoken\": [{}]" : ", \"iftoken\": []");
        ob_z(o, pch ? ", \"ifpfxch\": [{}]" : ", \"ifpfxch\": []");
        ob_z(o, pst ? ", \"ifpfxstr\": [{}]}" : ", \"ifpfxstr\": []}");
    }
    ob_z(o, "]\n=OPPFX\tjson\t[");
    for (i = 0; i < OP.n; i++) { if (i) ob_z(o, ", "); pf_node(o, &OP, i); }
    ob_z(o, "]\n=KID\tjson\t["); ob_int(o, KID); ob_z(o, "]\n=classes\tjson\t{");
    for (i = 0; i < ncl; i++) {
        int k, first = 1;
        if (i) ob_z(o, ", ");
        ob_str(o, classes[i]); ob_z(o, ": [");
        for (k = 0; k <= 256; k++) if (tx_eq(cls[k], classes[i], 64)) { if (!first) ob_z(o, ", "); ob_int(o, k); first = 0; }
        ob_z(o, "]");
    }
    ob_z(o, ncl ? ", \"identifier\": [" : "\"identifier\": [");
    {
        int k, first = 1;
        for (k = 0; k <= 256; k++) if (k != EOFC && (ISAL(k) || ISDI(k))) { if (!first) ob_z(o, ", "); ob_int(o, k); first = 0; }
    }
    ob_z(o, "], \"space\": [");
    for (i = 0; i < nws; i++) { if (i) ob_z(o, ", "); ob_int(o, ws[i]); }
    ob_z(o, "]}\n=literalclasses\tjson\t{\"space\": [");
    for (i = 0; i < nws; i++) { if (i) ob_z(o, ", "); ob_int(o, ws[i]); }
    ob_z(o, "]}\n=tok_names\tjson\t[");
    for (i = 0; i < ntok; i++) { if (i) ob_z(o, ", "); ob_str(o, toks[i]); }
    ob_z(o, "]\n=tokens\tjson\t[");
    for (i = 0; i < ntok; i++) {
        int k, pl = 0, ty = 0;
        for (k = 0; k < nsp; k++) if (tx_eq(sp_tok[k], toks[i], 256)) { pl = sp_plain[k]; ty = sp_typed[k]; }
        if (i) ob_z(o, ", ");
        ob_z(o, "{\"kind\": "); ob_int(o, i); ob_z(o, ", \"name\": "); ob_str(o, toks[i]);
        ob_z(o, pl ? ", \"plain_spell\": true" : ", \"plain_spell\": false");
        ob_z(o, ty ? ", \"typed_spell\": true}" : ", \"typed_spell\": false}");
    }
    ob_z(o, "]\n");
#undef ISAL
#undef ISDI
}

/* A facts() cell as JSON: an integer or a JSON string literal is re-dumped, anything else is a string. */
static void ob_cell(Ob *o, const char *s) {
    long n = tx_len(s, FG_CAP), i;
    int digits = n > 0;
    for (i = 0; i < n; i++) if (!((s[i] >= '0' && s[i] <= '9') || (i == 0 && s[i] == '-' && n > 1))) digits = 0;
    if (digits) { ob_z(o, s); return; }
    if (n >= 2 && s[0] == '"' && s[n - 1] == '"') { char *d = jstr(s, n); if (!d) fg_die("bad JSON string cell", s); ob_str(o, d); return; }
    if (tx_eq(s, "true", 8) || tx_eq(s, "false", 8) || tx_eq(s, "null", 8)) fg_die("unsupported JSON literal cell", s);
    ob_str(o, s);
}
static void ob_strn(Ob *o, const char *s, long n) {   /* json.dumps of n bytes that may include NUL */
    long i;
    ob_put(o, "\"", 1);
    for (i = 0; i < n; i++) {
        unsigned char c = (unsigned char)s[i];
        if (c == '"' || c == '\\') { ob_put(o, "\\", 1); ob_put(o, s + i, 1); }
        else if (c < 0x20 || c > 0x7f) { char b[8]; cx_fmt(b, sizeof b, "\\u%04x", c); ob_z(o, b); }
        else ob_put(o, s + i, 1);
    }
    ob_put(o, "\"", 1);
}

static int pp_pdfind(char **kind, char **sel, int n, const char *k, const char *s) {
    int q, r = -1;
    for (q = 0; q < n; q++) if (tx_eq(kind[q], k, 16) && tx_eq(sel[q], s, 64)) r = q;
    return r;
}

/* pp-gen: E2 delta facts (directive ids, pp-init spellings, XE precedences, per-target predefine chains,
   the directive switch keys, directive-action instances, simple escapes, PREC_* layout). */
static void pp_gen(Ob *o) {
    static char *dirv[64], *ppt_d[256], *ppt_y[256], *tg[16], *pdk[32], *pdsel[32], *pdn[32][32];
    static int ppt_b[256], npdn[32];
    static int xcode[300], xprec[300];
    static char *initw[64], *initk[64], *inita[64];
    int ndir = 0, nppt = 0, ntg = 0, npd = 0, nx = 0, ninit = 0, i, j;
    long XPRB = fg_const("pp-layout", "XPRB"), XOB = fg_const("pp-layout", "XOB");
    {
        Lines L = fg_lines("weights/gold/pp.tsv");
        for (i = 0; i < L.n; i++) {
            char *cells[64], *line = fg_dupz(L.l[i]);
            int c = fg_split(line, cells, 64), k;
            if (c > 2 && tx_eq(cells[0], "#field", 8) && tx_eq(cells[1], "dir", 4)) for (k = 2; k < c; k++) dirv[ndir++] = cells[k];
            if (L.l[i][0] == '#' || c != 3 || tx_eq(cells[0], "dir", 4)) continue;
            ppt_d[nppt] = cells[0]; ppt_b[nppt] = (int)strtol(cells[1], 0, 10); ppt_y[nppt++] = cells[2];
        }
    }
    {
        Lines L = fg_lines("exec/facts/pp-targets.tsv");
        for (i = 1; i < L.n; i++) {
            char *cells[4], *line = fg_dupz(L.l[i]), t[64];
            if (!*line || line[0] == '#') continue;
            if (fg_split(line, cells, 4) != 2) fg_die("bad pp-targets row", L.l[i]);
            cx_fmt(t, sizeof t, "%s/%s", cells[0], cells[1]);
            tg[ntg++] = fg_dupz(t);
        }
    }
    {
        Lines L = fg_lines("exec/pp/predefines.tsv");
        for (i = 0; i < L.n; i++) {
            char *cells[40], *line = fg_dupz(L.l[i]);
            int c, k;
            if (!*line || line[0] == '#') continue;
            c = fg_split(line, cells, 40);
            if (c < 3 || npd == 32 || pp_pdfind(pdk, pdsel, npd, cells[0], cells[1]) >= 0) fg_die("invalid or duplicate predefinition row", L.l[i]);
            pdk[npd] = cells[0]; pdsel[npd] = cells[1]; npdn[npd] = c - 2;
            for (k = 2; k < c; k++) {
                char *nm = cells[k];
                long q, nl = tx_len(nm, 256);
                int m;
                for (q = 0; q < nl; q++) {
                    char ch = nm[q];
                    int ok = (ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') || ch == '_' || (q > 0 && ch >= '0' && ch <= '9');
                    if (!ok) fg_die("invalid predefinition name", nm);
                }
                for (m = 2; m < k; m++) if (tx_eq(cells[m], nm, 256)) fg_die("repeated predefinition name", nm);
                if (nl < 1) fg_die("empty predefinition name", L.l[i]);
                pdn[npd][k - 2] = nm;
            }
            npd++;
        }
        {   /* required: os lnx/osx/win, arch x86_64/arm64, common *; optional model per os; nothing else */
            static const char *req[6][2] = {{"os", "lnx"}, {"os", "osx"}, {"os", "win"}, {"arch", "x86_64"}, {"arch", "arm64"}, {"common", "*"}};
            int r;
            for (r = 0; r < 6; r++) if (pp_pdfind(pdk, pdsel, npd, req[r][0], req[r][1]) < 0) fg_die("expected OS, architecture, optional data-model and common declarations", req[r][1]);
            for (r = 0; r < npd; r++) {
                int known = 0, q;
                for (q = 0; q < 6; q++) if (tx_eq(pdk[r], req[q][0], 16) && tx_eq(pdsel[r], req[q][1], 64)) known = 1;
                if (tx_eq(pdk[r], "model", 8) && (tx_eq(pdsel[r], "lnx", 8) || tx_eq(pdsel[r], "osx", 8) || tx_eq(pdsel[r], "win", 8))) known = 1;
                if (!known) fg_die("unexpected predefinition row", pdsel[r]);
            }
        }
    }
    {
        Lines L = fg_lines("exec/pp/operators.tsv");
        for (i = 0; i < L.n; i++) {
            char *cells[6], *line = fg_dupz(L.l[i]);
            if (!*line || line[0] == '#') continue;
            if (fg_split(line, cells, 6) != 4 || nx == 300) fg_die("bad operators row", L.l[i]);
            xcode[nx] = (int)strtol(cells[0], 0, 10); xprec[nx++] = (int)strtol(cells[2], 0, 10);
        }
    }
    {
        Lines L = fg_lines("exec/facts/pp-init.tsv");
        for (i = 1; i < L.n; i++) {
            char *cells[4], *line = fg_dupz(L.l[i]);
            if (!*line || line[0] == '#') continue;
            if (fg_split(line, cells, 4) != 3 || ninit == 64) fg_die("bad pp-init row", L.l[i]);
            initw[ninit] = cells[0]; initk[ninit] = cells[1]; inita[ninit++] = cells[2];
        }
    }
    ob_z(o, "=dirrows\tjson\t[");
    {
        int first = 1;
        for (i = 0; i < ndir; i++) { if (!first) ob_z(o, ", "); ob_z(o, "{\"word\": "); ob_str(o, dirv[i]); ob_z(o, ", \"arg\": "); ob_int(o, i + 1); ob_z(o, "}"); first = 0; }
        for (i = 0; i < ninit; i++) if (tx_eq(initk[i], "dir", 4)) { if (!first) ob_z(o, ", "); ob_z(o, "{\"word\": "); ob_cell(o, initw[i]); ob_z(o, ", \"arg\": "); ob_cell(o, inita[i]); ob_z(o, "}"); first = 0; }
        ob_z(o, "]\n=internrows\tjson\t[");
        first = 1;
        for (i = 0; i < ninit; i++) if (!tx_eq(initk[i], "dir", 4)) { if (!first) ob_z(o, ", "); ob_z(o, "{\"word\": "); ob_cell(o, initw[i]); ob_z(o, ", \"arg\": "); ob_cell(o, inita[i]); ob_z(o, "}"); first = 0; }
    }
    ob_z(o, "]\n=xerows\tjson\t[");
    for (i = 0; i <= nx; i++) {
        if (i) ob_z(o, ", ");
        ob_z(o, "{\"slot\": "); ob_int(o, XPRB + (i < nx ? xcode[i] : 0)); ob_z(o, ", \"precedence\": "); ob_int(o, i < nx ? xprec[i] : -1); ob_z(o, "}");
    }
    ob_z(o, "]\n=predef\tjson\t{");
    for (i = 0; i < ntg; i++) {
        char os[32], arch[32], *names[96];
        int nn = 0, parts[4], np = 0, q, k;
        long sl = tx_chr(tg[i], tx_len(tg[i], 64), '/');
        tx_copy(os, sizeof os, tg[i], sl); tx_copy(arch, sizeof arch, tg[i] + sl + 1, tx_len(tg[i] + sl + 1, 32));
        parts[np++] = pp_pdfind(pdk, pdsel, npd, "os", os); parts[np++] = pp_pdfind(pdk, pdsel, npd, "arch", arch);
        parts[np++] = pp_pdfind(pdk, pdsel, npd, "model", os); parts[np++] = pp_pdfind(pdk, pdsel, npd, "common", "*");
        for (q = 0; q < np; q++) if (parts[q] >= 0) for (k = 0; k < npdn[parts[q]]; k++) names[nn++] = pdn[parts[q]][k];
        if (i) ob_z(o, ", ");
        ob_str(o, tg[i]); ob_z(o, ": [");
        for (k = 0; k < nn; k++) {
            char e[32];
            if (k) ob_z(o, ", ");
            cx_fmt(e, sizeof e, "P3PD%d", k); ob_z(o, "{\"entry\": "); ob_str(o, e);
            cx_fmt(e, sizeof e, "P3PDR%d", k); ob_z(o, ", \"resume\": "); ob_str(o, e);
            if (k + 1 < nn) cx_fmt(e, sizeof e, "P3PD%d", k + 1); else cx_fmt(e, sizeof e, "CLI.D");
            ob_z(o, ", \"next\": "); ob_str(o, e); ob_z(o, ", \"name\": "); ob_str(o, names[k]); ob_z(o, "}");
        }
        ob_z(o, "]");
    }
    ob_z(o, "}\n=cases\tjson\t[");
    for (i = 0; i < ndir; i++) { char t[64]; if (i) ob_z(o, ", "); cx_fmt(t, sizeof t, "D_%s", dirv[i]); ob_z(o, "{\"key\": "); ob_int(o, i + 1); ob_z(o, ", \"target\": "); ob_str(o, t); ob_z(o, "}"); }
    ob_z(o, "]\n=dswkeys\tjson\t[0");
    for (i = 0; i < ndir; i++) { ob_z(o, ", "); ob_int(o, i + 1); }   /* sorted: 0, 1..n, then 100-102 */
    ob_z(o, ", 100, 101, 102]\n=dactions\tjson\t[");
    if (ndir >= 100) fg_die("too many directives for the fixed switch keys", 0);
    for (i = 0; i < ndir; i++) {
        int fl;
        for (fl = 0; fl < 2; fl++) {
            char nm[96], sec[96];
            char *y = 0;
            for (j = 0; j < nppt; j++) if (tx_eq(ppt_d[j], dirv[i], 64) && ppt_b[j] == fl) y = ppt_y[j];
            if (!y) fg_die("pp.tsv lacks a directive answer", dirv[i]);
            cx_fmt(nm, sizeof nm, "D_%s_a%d", dirv[i], fl); cx_fmt(sec, sizeof sec, "%s/%s", dirv[i], y);
            if (i || fl) ob_z(o, ", ");
            ob_z(o, "{\"name\": "); ob_str(o, nm); ob_z(o, ", \"section\": "); ob_str(o, sec); ob_z(o, "}");
        }
    }
    ob_z(o, "]\n=esc\tjson\t[");
    {
        Lines L = fg_lines("exec/facts/pp-escapes.tsv");
        static int ec[64], ev[64];
        int ne = 0, first = 1;
        for (i = 0; i < L.n; i++) {
            char *cells[4], *line = fg_dupz(L.l[i]), *ch;
            if (!*line || line[0] == '#') continue;
            if (fg_split(line, cells, 4) != 2) fg_die("bad pp-escapes row", L.l[i]);
            ch = jstr(cells[0], tx_len(cells[0], 16));
            if (!ch || tx_len(ch, 4) != 1) {
                if (tx_eq(cells[0], "\"0\"", 8)) { static char zero[2] = {'0', 0}; ch = zero; } else fg_die("bad escape char", cells[0]);
            }
            if (tx_chr("01234567x", 9, ch[0]) >= 0) continue;
            ec[ne] = (unsigned char)ch[0]; ev[ne++] = (int)strtol(cells[1], 0, 10);
        }
        for (i = 0; i < ne; i++) { if (!first) ob_z(o, ", "); ob_z(o, "{\"code\": "); ob_int(o, ec[i]); ob_z(o, ", \"value\": "); ob_int(o, ev[i]); ob_z(o, "}"); first = 0; }
        ob_z(o, "]\n=esckeys\tjson\t[");
        for (i = 0; i < ne; i++) { if (i) ob_z(o, ", "); ob_int(o, ec[i]); }
    }
    ob_z(o, "]\n=xelayout\tjson\t{");
    for (i = 0; i < nx; i++) {
        char k[32];
        int dup;
        for (dup = 0, j = 0; j < i; j++) if (xcode[j] == xcode[i]) dup = 1;
        if (dup) fg_die("duplicate operator code", 0);
        if (i) ob_z(o, ", ");
        cx_fmt(k, sizeof k, "PREC_%d", xcode[i]); ob_str(o, k); ob_z(o, ": "); ob_int(o, xprec[i]);
    }
    ob_z(o, nx ? ", \"XOB_PREV\": " : "\"XOB_PREV\": "); ob_int(o, XOB - 1);
    ob_z(o, "}\n=predefres\tjson\t{");
    {
        int order[16], k, q;
        for (k = 0; k < ntg; k++) order[k] = k;
        for (k = 1; k < ntg; k++) { int x = order[k]; for (q = k - 1; q >= 0 && byte_less(tg[x], tg[order[q]]); q--) order[q + 1] = order[q]; order[q + 1] = x; }
        for (k = 0; k < ntg; k++) {
            char os[32], arch[32], buf[2048];
            long at = 0, sl = tx_chr(tg[order[k]], tx_len(tg[order[k]], 64), '/');
            int parts[4], p, m;
            tx_copy(os, sizeof os, tg[order[k]], sl); tx_copy(arch, sizeof arch, tg[order[k]] + sl + 1, tx_len(tg[order[k]] + sl + 1, 32));
            parts[0] = pp_pdfind(pdk, pdsel, npd, "os", os); parts[1] = pp_pdfind(pdk, pdsel, npd, "arch", arch);
            parts[2] = pp_pdfind(pdk, pdsel, npd, "model", os); parts[3] = pp_pdfind(pdk, pdsel, npd, "common", "*");
            for (p = 0; p < 4; p++) if (parts[p] >= 0) for (m = 0; m < npdn[parts[p]]; m++) {
                long nl = tx_len(pdn[parts[p]][m], 256), c;
                for (c = 0; c < nl; c++) buf[at++] = pdn[parts[p]][m][c];
                buf[at++] = 0;
            }
            if (k) ob_z(o, ", ");
            ob_str(o, tg[order[k]]); ob_z(o, ": "); ob_strn(o, buf, at);
        }
    }
    ob_z(o, "}\n");
}

/* Every .h under include/ (recursive), relative to ROOT, byte-sorted (pathlib rglob + sorted). */
static char *ih_path[1024];
static int ih_n;
static int ih_take(const char *path, void *ctx) {
    long n = tx_len(path, 4400), rl = tx_len(fg_root, 4096);
    (void)ctx;
    if (tx_eq(path + rl + 1, "include/cx-flat.h", 32)) return 0;   /* generated by tools/cx-flatten.cx, as in seed/unisa_libneed.c */
    if (n > 2 && path[n - 2] == '.' && path[n - 1] == 'h') {
        if (ih_n == 1024) fg_die("too many headers", 0);
        ih_path[ih_n++] = ar_dup(fg_ar, path + rl + 1, n - rl - 1);
    }
    return 0;
}
static void ih_list(void) {
    char dir[4400];
    int i, j;
    if (ih_n) return;
    cx_fmt(dir, sizeof dir, "%s/include", fg_root);
    if (cx_walk(dir, ih_take, 0)) fg_die("cannot walk", dir);
    for (i = 1; i < ih_n; i++) { char *x = ih_path[i]; for (j = i - 1; j >= 0 && byte_less(x, ih_path[j]); j--) ih_path[j + 1] = ih_path[j]; ih_path[j + 1] = x; }
}

static int bidx(char **names, int nb, const char *nm) {
    int q;
    for (q = 0; q < nb; q++) if (tx_eq(names[q], nm, 256)) return q;
    fg_die("closure name is not a carried body", nm);
    return -1;
}

/* pp-autoinc-gen: autoinc library names, closure slots and header order (the closure from the native
   seed/unisa_libneed.c `table`, header function names by front_pp's line rule). */
static void pp_autoinc(Ob *o) {
    static char *names[2048], *keyn[2048], **keyc[2048], *rootc[256], *hdr[128], *alln[2048];
    static int keync[2048];
    int nb = 0, nk = 0, nr = 0, nh = 0, i, j;
    long NEEDB = fg_const("pp-layout", "NEEDB");
    char *out;
    size_t on;
    {
        char bound[4400], com[4400], src[4400], inc[4400];
        char *argv[9];
        int rc;
        cx_fmt(bound, sizeof bound, "%s/tools/bound", fg_root); cx_fmt(com, sizeof com, "%s/unisacc.com", fg_root);
        cx_fmt(src, sizeof src, "%s/seed/unisa_libneed.c", fg_root); cx_fmt(inc, sizeof inc, "%s/include", fg_root);
        argv[0] = bound; argv[1] = "50"; argv[2] = "sh"; argv[3] = com; argv[4] = src; argv[5] = "--"; argv[6] = "table"; argv[7] = inc; argv[8] = 0;
        rc = cx_runv_timeout(argv, 55, &out, &on);
        if (rc != 0 || !out) fg_die("seed/unisa_libneed.c table failed", 0);
    }
    {
        char *copy = ar_dup(fg_ar, out, (long)on), *p = copy, *end = copy + on;
        while (p < end) {
            long off = tx_chr(p, (long)(end - p), '\n');
            char *cell[2100];
            int c, k;
            if (off < 0) off = (long)(end - p);
            p[off] = 0;
            for (c = 0, k = 0; p[k]; ) {          /* space-separated */
                while (p[k] == ' ') p[k++] = 0;
                if (!p[k]) break;
                if (c == 2100) fg_die("libneed line too long", 0);
                cell[c++] = p + k;
                while (p[k] && p[k] != ' ') k++;
            }
            if (c && tx_eq(cell[0], "NAMES", 8)) for (k = 1; k < c; k++) names[nb++] = cell[k];
            else if (c >= 2 && tx_eq(cell[0], "KEY", 4)) {
                keyn[nk] = cell[1]; keync[nk] = c - 2;
                keyc[nk] = ar_alloc(fg_ar, (long)sizeof(char *) * (c + 1));
                for (k = 2; k < c; k++) keyc[nk][k - 2] = cell[k];
                nk++;
            } else if (c && tx_eq(cell[0], "ROOTS_CLOSURE", 16)) for (k = 1; k < c; k++) rootc[nr++] = cell[k];
            p += off + 1;
        }
    }
    ob_z(o, "=idclass\tjson\t[");
    {   /* sorted(alpha | digit) */
        static char *pk[8], *pv[8];
        int np = fg_pairs("exec/facts/pp-bytes.tsv", pk, pv, 8), mark[256] = {0}, first = 1, c;
        for (i = 0; i < np; i++) if (tx_eq(pk[i], "alpha", 8) || tx_eq(pk[i], "digit", 8)) {
            char *s = pv[i], *e;
            while (*s) {
                long a, b;
                while (*s && (*s < '0' || *s > '9')) s++;
                if (!*s) break;
                a = strtol(s, &e, 10); s = e;
                while (*s && (*s < '0' || *s > '9')) s++;
                b = strtol(s, &e, 10); s = e;
                for (c = (int)a; c <= b && c < 256; c++) mark[c] = 1;
            }
        }
        for (c = 0; c < 256; c++) if (mark[c]) { if (!first) ob_z(o, ", "); ob_int(o, c); first = 0; }
    }
    ob_z(o, "]\n=roots\tjson\t[");
    for (i = 0; i < nr; i++) { if (i) ob_z(o, ", "); ob_z(o, "{\"offset\": "); ob_int(o, NEEDB + bidx(names, nb, rootc[i])); ob_z(o, "}"); }
    ob_z(o, "]\n=keys\tjson\t[");
    for (i = 0; i < nk; i++) {
        if (i) ob_z(o, ", ");
        ob_z(o, "{\"id\": "); ob_int(o, i); ob_z(o, ", \"end\": "); ob_int(o, i + 1);
        ob_z(o, i + 1 == nk ? ", \"terminal\": true, \"name\": " : ", \"terminal\": false, \"name\": "); ob_str(o, keyn[i]);
        ob_z(o, ", \"slots\": [");
        for (j = 0; j < keync[i]; j++) { if (j) ob_z(o, ", "); ob_z(o, "{\"offset\": "); ob_int(o, NEEDB + bidx(names, nb, keyc[i][j])); ob_z(o, "}"); }
        ob_z(o, "]}");
    }
    ob_z(o, "]\n=bodies\tjson\t[");
    for (i = 0; i < nb; i++) {
        char nm[300];
        if (i) ob_z(o, ", ");
        cx_fmt(nm, sizeof nm, "__UN_%s", names[i]);
        ob_z(o, "{\"id\": "); ob_int(o, i); ob_z(o, ", \"end\": "); ob_int(o, i + 1);
        ob_z(o, i + 1 == nb ? ", \"terminal\": true, \"slot\": " : ", \"terminal\": false, \"slot\": "); ob_int(o, NEEDB + i);
        ob_z(o, ", \"name\": "); ob_str(o, nm); ob_z(o, "}");
    }
    ob_z(o, "]\n=lndef\tstr\t__UNISA_FTRIM_LIBC\n=headers\tjson\t[");
    {
        Lines A = fg_lines("exec/facts/pp-autoinc.tsv");
        for (i = 1; i < A.n; i++) if (*A.l[i] && A.l[i][0] != '#') hdr[nh++] = A.l[i];
        for (i = 0; i < nh; i++) {
            char rel[512];
            Lines H;
            int na = 0, k;
            cx_fmt(rel, sizeof rel, "include/%s", hdr[i]);
            H = fg_lines(rel);
            for (k = 0; k < H.n; k++) {           /* static ...NAME(...{  on one line */
                char *ln = H.l[k];
                long n = tx_len(ln, FG_CAP), par, e, s;
                if (n <= 7 || !tx_prefix(ln, n, "static", 6)) continue;
                par = tx_chr(ln, n, '(');
                if (par < 0 || tx_chr(ln + par, n - par, '{') < 0) continue;
                e = par;
                while (e > 0 && (ln[e - 1] == ' ' || ln[e - 1] == '\t' || ln[e - 1] == '\r' || ln[e - 1] == '\f' || ln[e - 1] == '\v')) e--;
                s = e;
                while (s > 0 && ((ln[s - 1] >= 'a' && ln[s - 1] <= 'z') || (ln[s - 1] >= 'A' && ln[s - 1] <= 'Z') || (ln[s - 1] >= '0' && ln[s - 1] <= '9') || ln[s - 1] == '_')) s--;
                if (s == e) continue;
                if (tx_same(ln + s, e - s, "printf", 6)) continue;
                alln[na++] = ar_dup(fg_ar, ln + s, e - s);
            }
            if (i) ob_z(o, ", ");
            ob_z(o, "{\"id\": "); ob_int(o, i); ob_z(o, ", \"end\": "); ob_int(o, i + 1);
            ob_z(o, i + 1 == nh ? ", \"terminal\": true, \"count\": " : ", \"terminal\": false, \"count\": "); ob_int(o, na);
            ob_z(o, ", \"names\": [");
            for (k = 0; k < na; k++) { if (k) ob_z(o, ", "); ob_z(o, "{\"id\": "); ob_int(o, k); ob_z(o, ", \"end\": "); ob_int(o, k + 1); ob_z(o, ", \"name\": "); ob_str(o, alln[k]); ob_z(o, "}"); }
            ob_z(o, "]}");
        }
    }
    ob_z(o, "]\n=emits\tjson\t[{\"special\": true, \"id\": "); ob_int(o, nh); ob_z(o, ", \"end\": "); ob_int(o, nh - 1);
    ob_z(o, ", \"terminal\": false, \"header\": \"stdio.h\"}");
    for (i = nh - 1; i >= 0; i--) {
        ob_z(o, ", {\"special\": false, \"id\": "); ob_int(o, i); ob_z(o, ", \"end\": "); ob_int(o, i - 1);
        ob_z(o, i == 0 ? ", \"terminal\": true, \"header\": " : ", \"terminal\": false, \"header\": "); ob_str(o, hdr[i]); ob_z(o, "}");
    }
    ob_z(o, "]\n");
}

/* nativeabi: FFI carrier facts from exec/nativeabi/rules.tsv.  T = the profile byte trie (states in
   sorted prefix order; the choice order of a state with more than one choice comes from
   exec/nativeabi/trie-order.tsv), A = union16 recipes, extents/alignments, ordseq = the ordered `@`
   field/extra reads of exec/nativeabi/ordered-result.tsv, genfresh/ordfresh, reject. */
#define NA_MAX 128
static int na_cls(const char *s) {
    if (tx_eq(s, "N", 4)) return 0;
    if (tx_eq(s, "S", 4)) return 1;
    if (tx_eq(s, "I", 4)) return 2;
    fg_die("not a carrier class", s);
    return -1;
}
static long na_int(const char *s) {
    char *end;
    long v = strtol(s, &end, 10);
    if (end == s || *end) fg_die("not an integer", s);
    return v;
}
static char *na_name(const char *p) {   /* "NC.profile" + ("." + hex of p) */
    static const char hx[] = "0123456789abcdef";
    long n = tx_len(p, 256), i, k = 10;
    char *out = ar_alloc(fg_ar, 2 * n + 12);
    if (!out) fg_die("out of memory", 0);
    tx_copy(out, 11, "NC.profile", 10);
    if (n) out[k++] = '.';
    for (i = 0; i < n; i++) { out[k++] = hx[(unsigned char)p[i] >> 4]; out[k++] = hx[(unsigned char)p[i] & 15]; }
    out[k] = 0;
    return out;
}
/* facts(stem) of exec/facts/load.py for a header-row table: a JSON list of dicts. */
static void na_facts(Ob *o, const char *stem) {
    char rel[256], *head[16], *hl;
    Lines L;
    int i, k, nh, nr = 0;
    cx_fmt(rel, sizeof rel, "exec/facts/%s.tsv", stem);
    L = fg_lines(rel);
    hl = fg_dupz(L.l[0]);
    while (*hl == '#') hl++;
    while (*hl == ' ') hl++;
    nh = fg_split(hl, head, 16);
    if (nh < 1) fg_die("bad header", stem);
    ob_z(o, "[");
    for (i = 1; i < L.n; i++) {
        char *cells[16], *line = fg_dupz(L.l[i]);
        int nc;
        if (!*line || line[0] == '#') continue;
        nc = fg_split(line, cells, 16);
        if (nc < 0) fg_die("row too wide", stem);
        if (nr++) ob_z(o, ", ");
        ob_z(o, "{");
        for (k = 0; k < nc && k < nh; k++) { if (k) ob_z(o, ", "); ob_str(o, head[k]); ob_z(o, ": "); ob_cell(o, cells[k]); }
        ob_z(o, "}");
    }
    ob_z(o, "]");
}
static void nativeabi(Ob *o) {
    static const char *want[6] = {"osx/arm64", "osx/x86_64", "lnx/arm64", "lnx/x86_64", "win/arm64", "win/x86_64"};
    static const char *rcls[4] = {"II", "IS", "SI", "SS"};
    Lines L = fg_lines("exec/nativeabi/rules.tsv"), R, TO;
    char *prof[6], *rule[6][8], *pre[NA_MAX], *recipe[2][4], *rkey[32], *oname[256], *oc[256][4];
    long ext[64], ali[64];
    int i, k, j, np = 0, leafv[4] = {-1, -1, -1, -1}, join[3][3], nrk = 0, next = 0, nali = 0, nanon = 0, no = 0, nt = 0, used = 0;
    long fields_bank = fg_const("top-modelgraphequality-banks", "FIELDS"), extra_bank = fg_const("top-modelgraphequality-banks", "EXTRA");
    if (L.n < 7 || !tx_eq(L.l[0], "profile\trule\tinteger_min_width\thomogeneous_fp_carrier_kind\tmixed_width\tfamily\tlong_double_format", 256))
        fg_die("unexpected rules.tsv header", L.l[0]);
    for (i = 0; i < 6; i++) {
        char *line = fg_dupz(L.l[1 + i]);
        if (fg_split(line, rule[i], 8) != 7) fg_die("bad profile row", L.l[1 + i]);
        prof[i] = rule[i][0];
        if (!tx_eq(rule[i][1], "natural_scalar_union_v2", 64) || na_int(rule[i][4]) != 8) fg_die("profile rule", prof[i]);
        k = (int)na_int(rule[i][2]); if (k != 1 && k != 8) fg_die("integer_min_width", prof[i]);
        k = (int)na_int(rule[i][3]); if (k != 1 && k != 3) fg_die("homogeneous_fp_carrier_kind", prof[i]);
        k = (int)na_int(rule[i][6]); if (k < 2 || k > 4) fg_die("long_double_format", prof[i]);
    }
    for (i = 0; i < 6; i++) {
        int hit = 0;
        for (k = 0; k < 6; k++) hit += tx_eq(prof[k], want[i], 64);
        if (hit != 1) fg_die("profile set", want[i]);
    }
    for (i = 0; i < 3; i++) for (k = 0; k < 3; k++) join[i][k] = -1;
    for (i = 0; i < 2; i++) for (k = 0; k < 4; k++) recipe[i][k] = 0;
    for (i = 7; i < L.n; i++) {
        char *c[8], *line = fg_dupz(L.l[i]);
        int nc;
        if (line[0] == '#') continue;
        nc = fg_split(line, c, 8);
        if (tx_eq(c[0], "leaf", 8)) { k = (int)na_int(c[1]); if (nc != 3 || k < 1 || k > 3) fg_die("bad leaf", L.l[i]); leafv[k] = na_cls(c[2]); }
        else if (tx_eq(c[0], "merge", 8)) { if (nc != 4) fg_die("bad merge", L.l[i]); join[na_cls(c[1])][na_cls(c[2])] = na_cls(c[3]); }
        else if (tx_eq(c[0], "recipe", 8)) {
            char key[64];
            int al = (int)na_int(c[1]), seen = 0;
            if (nc != 4) fg_die("bad recipe", L.l[i]);
            cx_fmt(key, sizeof key, "%d %s", al, c[2]);
            for (k = 0; k < nrk; k++) seen |= tx_eq(rkey[k], key, 64);
            if (!seen) { if (nrk == 32) fg_die("too many recipes", 0); rkey[nrk++] = fg_dupz(key); }
            for (k = 0; k < 4; k++) if ((al == 4 || al == 8) && tx_eq(c[2], rcls[k], 4)) recipe[al == 8][k] = c[3];
        }
        else if (tx_eq(c[0], "ordered_extent", 32)) { if (next == 64) fg_die("too many extents", 0); ext[next++] = na_int(c[1]); }
        else if (tx_eq(c[0], "ordered_alignment", 32)) { if (nali == 64) fg_die("too many alignments", 0); ali[nali++] = na_int(c[1]); }
        else if (tx_eq(c[0], "ordered_anon_policy", 32)) { if (nc < 2 || !tx_eq(c[1], "invariant_integer_lanes", 64)) fg_die("anon policy", L.l[i]); nanon++; }
    }
    for (i = 0; i < 3; i++) for (k = 0; k < 3; k++) if (join[i][k] != (i > k ? i : k)) fg_die("merge is not the N<S<I join", 0);
    if (nrk != 8 || leafv[1] != 2 || leafv[2] != 2 || leafv[3] != 1) fg_die("recipes or leaf classes", 0);
    for (i = 0; i < 2; i++) for (k = 0; k < 4; k++) if (!recipe[i][k]) fg_die("recipe absent", rcls[k]);
    if (next != 16 || nali != 4 || nanon != 1) fg_die("ordered extents, alignments or anon policy", 0);
    for (i = 0; i < 16; i++) if (ext[i] != i + 1) fg_die("ordered extents", 0);
    for (i = 0; i < 4; i++) if (ali[i] != 1L << i) fg_die("ordered alignments", 0);
    /* T */
    pre[np++] = fg_dupz("");
    for (i = 0; i < 6; i++) {
        long n = tx_len(prof[i], 256), m;
        for (m = 1; m <= n; m++) {
            char *p = ar_dup(fg_ar, prof[i], m);
            int seen = 0;
            for (k = 0; k < np; k++) seen |= tx_eq(pre[k], p, 256);
            if (seen) continue;
            if (np == NA_MAX) fg_die("too many profile prefixes", 0);
            pre[np++] = p;
        }
    }
    for (i = 1; i < np; i++) for (k = i; k > 0 && byte_less(pre[k], pre[k - 1]); k--) { char *t = pre[k]; pre[k] = pre[k - 1]; pre[k - 1] = t; }
    TO = fg_lines("exec/nativeabi/trie-order.tsv");
    for (i = 0; i < TO.n; i++) if (TO.l[i][0] && TO.l[i][0] != '#') nt++;
    ob_z(o, "=T\tjson\t[");
    for (i = 0; i < np; i++) {
        long pn = tx_len(pre[i], 256);
        int leaf = -1, ch[NA_MAX], nch = 0;
        for (k = 0; k < 6; k++) if (tx_eq(prof[k], pre[i], 256)) leaf = k;
        if (i) ob_z(o, ", ");
        ob_z(o, "{\"name\": "); ob_str(o, na_name(pre[i]));
        if (leaf >= 0) {
            ob_z(o, ", \"leaf\": [{\"im\": "); ob_int(o, na_int(rule[leaf][2]));
            ob_z(o, ", \"fp\": "); ob_int(o, na_int(rule[leaf][3]));
            ob_z(o, ", \"ld\": "); ob_int(o, na_int(rule[leaf][6]));
            ob_z(o, ", \"family\": "); ob_int(o, na_int(rule[leaf][5]));
            ob_z(o, "}], \"inner\": []}");
            continue;
        }
        for (k = 0; k < np; k++) if (tx_len(pre[k], 256) == pn + 1 && tx_prefix(pre[k], pn + 1, pre[i], pn)) ch[nch++] = k;
        if (nch > 1) {   /* reorder by the recorded choice bytes */
            int ord[NA_MAX], no2 = 0, found = 0;
            for (k = 0; k < TO.n && !found; k++) {
                char *c[4], *line = fg_dupz(TO.l[k]), *b;
                if (!line[0] || line[0] == '#' || fg_split(line, c, 4) != 2 || !tx_eq(c[0], na_name(pre[i]), 256)) continue;
                found = 1; used++;
                for (b = c[1]; *b; ) {
                    char *e;
                    long v = strtol(b, &e, 10);
                    int at = -1;
                    if (e == b || (*e && *e != ',') || no2 == NA_MAX) fg_die("bad trie-order bytes", TO.l[k]);
                    for (j = 0; j < nch; j++) if ((unsigned char)pre[ch[j]][pn] == v) at = ch[j];
                    if (at < 0) fg_die("trie-order byte is not a choice", TO.l[k]);
                    for (j = 0; j < no2; j++) if (ord[j] == at) fg_die("trie-order byte repeated", TO.l[k]);
                    ord[no2++] = at;
                    b = *e ? e + 1 : e;
                }
                if (no2 != nch) fg_die("trie-order does not list every choice", TO.l[k]);
            }
            if (!found) fg_die("state with several choices absent from trie-order.tsv", na_name(pre[i]));
            for (j = 0; j < nch; j++) ch[j] = ord[j];
        }
        ob_z(o, ", \"leaf\": [], \"inner\": [{\"choices\": [");
        for (j = 0; j < nch; j++) {
            if (j) ob_z(o, ", ");
            ob_z(o, "{\"byte\": "); ob_int(o, (unsigned char)pre[ch[j]][pn]);
            ob_z(o, ", \"target\": "); ob_str(o, na_name(pre[ch[j]])); ob_z(o, "}");
        }
        ob_z(o, "]}]}");
    }
    if (used != nt) fg_die("trie-order.tsv lists a state that is not a several-choice state", 0);
    ob_z(o, "]\n=A\tjson\t[");
    for (i = 0; i < 2; i++) {
        int al = i ? 8 : 4;
        if (i) ob_z(o, ", ");
        ob_z(o, "{\"al\": "); ob_int(o, al); ob_z(o, ", \"recipes\": [");
        for (k = 0; k < 4; k++) {
            const char *r = recipe[i][k];
            long rn = tx_len(r, 64);
            if (k) ob_z(o, ", ");
            ob_z(o, "{\"cls\": "); ob_str(o, rcls[k]);
            ob_z(o, ", \"code\": "); ob_int(o, 3 * na_cls(rcls[k][0] == 'I' ? "I" : "S") + na_cls(rcls[k][1] == 'I' ? "I" : "S"));
            ob_z(o, ", \"n\": "); ob_int(o, rn); ob_z(o, ", \"elems\": [");
            for (j = 0; j < rn; j++) {
                int isi = r[j] == 'I';
                if (j) ob_z(o, ", ");
                ob_z(o, "{\"off\": "); ob_int(o, (long)j * al);
                ob_z(o, ", \"kind\": "); ob_int(o, isi ? 1 : 3);
                ob_z(o, ", \"integer\": "); ob_int(o, isi); ob_z(o, "}");
            }
            ob_z(o, "]}");
        }
        ob_z(o, "]}");
    }
    ob_z(o, "]\n=extents\tjson\t[");
    for (i = 0; i < 16; i++) { if (i) ob_z(o, ", "); ob_int(o, ext[i]); }
    ob_z(o, "]\n=alignments\tjson\t[");
    for (i = 0; i < 4; i++) { if (i) ob_z(o, ", "); ob_int(o, ali[i]); }
    ob_z(o, "]\n");
    /* ordseq: first appearance of each ["@","NAME"] action, in file order */
    R = fg_lines("exec/nativeabi/ordered-result.tsv");
    for (i = 1; i < R.n; i++) {
        char *c[8], *line = fg_dupz(R.l[i]), *a;
        long an, at = 0, heads = 0, ats = 0;
        if (fg_split(line, c, 8) < 5) fg_die("bad ordered-result row", R.l[i]);
        a = c[4]; an = tx_len(a, FG_CAP);
        for (k = 0; k + 3 <= an; k++) if (tx_prefix(a + k, an - k, "\"@\"", 3)) ats++;
        while ((k = (int)tx_find(a + at, an - at, "[\"@\",\"", 6)) >= 0) {
            long s = at + k + 5, q = tx_chr(a + s + 1, an - s - 1, '"');
            char *nm, *w[8];
            int seen = 0;
            heads++;
            if (q < 0) fg_die("unterminated @ name", R.l[i]);
            nm = jstr(a + s, q + 2);
            if (!nm) fg_die("bad @ name", R.l[i]);
            at = s + q + 2;
            for (j = 0; j < no; j++) seen |= tx_eq(oname[j], nm, 256);
            if (seen) continue;
            {
                char *t = fg_dupz(nm), *p = t;
                int nw = 0;
                while (*p) {
                    while (*p == ' ') *p++ = 0;
                    if (!*p) break;
                    if (nw == 8) fg_die("bad @ name", nm);
                    w[nw++] = p;
                    while (*p && *p != ' ') p++;
                }
                if (nw != 4 || (!tx_eq(w[0], "field", 8) && !tx_eq(w[0], "extra", 8))) fg_die("bad @ name", nm);
                if (no == 256) fg_die("too many @ reads", 0);
                oname[no] = nm;
                for (j = 0; j < 4; j++) oc[no][j] = w[j];
                no++;
            }
        }
        if (heads != ats) fg_die("\"@\" outside an action head", R.l[i]);
    }
    ob_z(o, "=ordseq_names\tjson\t[");
    for (i = 0; i < no; i++) { if (i) ob_z(o, ", "); ob_str(o, oname[i]); }
    ob_z(o, "]\n=ordseq_rows\tjson\t[");
    for (i = 0; i < no; i++) {
        int field = tx_eq(oc[i][0], "field", 8);
        if (i) ob_z(o, ", ");
        ob_z(o, "{\"name\": "); ob_str(o, oname[i]);
        ob_z(o, ", \"index\": "); ob_int(o, na_int(oc[i][1]));
        ob_z(o, ", \"reg\": "); ob_str(o, oc[i][2]);
        ob_z(o, ", \"node\": "); ob_str(o, oc[i][3]);
        ob_z(o, ", \"stride\": "); ob_int(o, field ? 16 : 8);
        ob_z(o, ", \"bank\": "); ob_int(o, field ? fields_bank : extra_bank); ob_z(o, "}");
    }
    ob_z(o, "]\n");
    for (j = 0; j < 2; j++) {
        static const char *gk[4] = {"section", "name", "prefix", "kind"}, *ok[3] = {"section", "name", "kind"};
        Lines F = fg_lines(j ? "exec/nativeabi/ordered-fresh.tsv" : "exec/nativeabi/gen-fresh.tsv");
        int want_n = j ? 3 : 4;
        ob_z(o, j ? "=ordfresh\tjson\t[" : "=genfresh\tjson\t[");
        for (i = 1; i < F.n; i++) {
            char *c[8], *line = fg_dupz(F.l[i]);
            if (fg_split(line, c, 8) != want_n) fg_die("bad fresh row", F.l[i]);
            if (i > 1) ob_z(o, ", ");
            ob_z(o, "{");
            for (k = 0; k < want_n; k++) { if (k) ob_z(o, ", "); ob_str(o, j ? ok[k] : gk[k]); ob_z(o, ": "); ob_str(o, c[k]); }
            ob_z(o, "}");
        }
        ob_z(o, "]\n");
    }
    ob_z(o, "=reject\tjson\t"); na_facts(o, "nativeabi-gen-reject"); ob_z(o, "\n");
}

/* ---- an ordered JSON value tree for the parse2 tables (k2-gen2, k2-membercontrol, k2-libraryenv):
   dicts keep insertion order and a put on an existing key keeps its place, as Python dicts do;
   jv_dump writes json.dumps text (default or compact separators, optionally sort_keys). ---- */
enum { JV_INT, JV_STR, JV_LIST, JV_DICT, JV_TRUE, JV_FALSE, JV_NULL };
typedef struct Jv { int t; long long i; char *s; int n, cap; struct Jv **v; char **k; } Jv;
static Jv *jv_new(int t) { Jv *v = ar_alloc(fg_ar, (long)sizeof *v); if (!v) fg_die("out of memory", 0); v->t = t; return v; }
static Jv *jv_i(long long x) { Jv *v = jv_new(JV_INT); v->i = x; return v; }
static Jv *jv_s(const char *s) { Jv *v = jv_new(JV_STR); v->s = fg_dupz(s); return v; }
static Jv *jv_l(void) { return jv_new(JV_LIST); }
static Jv *jv_d(void) { return jv_new(JV_DICT); }
static void jv_grow(Jv *c) {
    int nc, i;
    Jv **nv;
    char **nk;
    if (c->n < c->cap) return;
    nc = c->cap ? c->cap * 2 : 8;
    nv = ar_alloc(fg_ar, (long)sizeof(Jv *) * nc);
    nk = ar_alloc(fg_ar, (long)sizeof(char *) * nc);
    if (!nv || !nk) fg_die("out of memory", 0);
    for (i = 0; i < c->n; i++) { nv[i] = c->v[i]; nk[i] = c->k ? c->k[i] : 0; }
    c->v = nv; c->k = nk; c->cap = nc;
}
static Jv *jl_add(Jv *l, Jv *x) { jv_grow(l); l->v[l->n++] = x; return l; }
static int jd_find(Jv *d, const char *k) { int i; for (i = 0; i < d->n; i++) if (tx_eq(d->k[i], k, FG_CAP)) return i; return -1; }
static Jv *jd_put(Jv *d, const char *k, Jv *x) {
    int i = jd_find(d, k);
    if (i >= 0) { d->v[i] = x; return d; }
    jv_grow(d);
    d->k[d->n] = fg_dupz(k);
    d->v[d->n++] = x;
    return d;
}
static Jv *jd_get(Jv *d, const char *k) { int i = jd_find(d, k); return i < 0 ? 0 : d->v[i]; }
static Jv *jd_must(Jv *d, const char *k) { Jv *v = jd_get(d, k); if (!v) fg_die("key absent", k); return v; }
static long long jv_num(Jv *v, const char *what) { if (!v || v->t != JV_INT) fg_die("not an integer", what); return v->i; }
static const char *jv_str(Jv *v, const char *what) { if (!v || v->t != JV_STR) fg_die("not a string", what); return v->s; }
static Jv *jd_puti(Jv *d, const char *k, long long x) { return jd_put(d, k, jv_i(x)); }
static Jv *jd_puts(Jv *d, const char *k, const char *s) { return jd_put(d, k, jv_s(s)); }
static Jv *jl_one(long long x) { return jl_add(jv_l(), jv_i(x)); }       /* [x] */
static Jv *jl_unit(void) { return jl_add(jv_l(), jv_d()); }              /* [{}] */
static void jv_dump(Ob *o, Jv *v, int compact, int sortk) {
    int i, j;
    if (v->t == JV_INT) { char b[32]; cx_fmt(b, sizeof b, "%lld", v->i); ob_z(o, b); }
    else if (v->t == JV_STR) ob_str(o, v->s);
    else if (v->t == JV_TRUE) ob_z(o, "true");
    else if (v->t == JV_FALSE) ob_z(o, "false");
    else if (v->t == JV_NULL) ob_z(o, "null");
    else if (v->t == JV_LIST) {
        ob_z(o, "[");
        for (i = 0; i < v->n; i++) { if (i) ob_z(o, compact ? "," : ", "); jv_dump(o, v->v[i], compact, sortk); }
        ob_z(o, "]");
    } else {
        int *ord = ar_alloc(fg_ar, (long)sizeof(int) * (v->n + 1));
        if (!ord) fg_die("out of memory", 0);
        for (i = 0; i < v->n; i++) ord[i] = i;
        if (sortk) for (i = 1; i < v->n; i++) { int x = ord[i]; for (j = i - 1; j >= 0 && fg_strcmp(v->k[x], v->k[ord[j]]) < 0; j--) ord[j + 1] = ord[j]; ord[j + 1] = x; }
        ob_z(o, "{");
        for (i = 0; i < v->n; i++) {
            if (i) ob_z(o, compact ? "," : ", ");
            ob_str(o, v->k[ord[i]]);
            ob_z(o, compact ? ":" : ": ");
            jv_dump(o, v->v[ord[i]], compact, sortk);
        }
        ob_z(o, "}");
    }
}
/* JSON text to a tree; 0 when s[0..n) is not one JSON value (integers only, no floats: refused). */
static long jp_ws(const char *s, long n, long at) { while (at < n && (s[at] == ' ' || s[at] == '\t' || s[at] == '\n' || s[at] == '\r')) at++; return at; }
static Jv *jp_val(const char *s, long n, long *at) {
    long p = jp_ws(s, n, *at);
    Jv *v;
    if (p >= n) return 0;
    if (s[p] == '"') {
        long q = p + 1;
        char *t;
        while (q < n && s[q] != '"') { if (s[q] == '\\') q++; q++; }
        if (q >= n) return 0;
        t = jstr(s + p, q - p + 1);
        if (!t) return 0;
        v = jv_new(JV_STR); v->s = t;
        *at = q + 1;
        return v;
    }
    if (s[p] == '[' || s[p] == '{') {
        int dict = s[p] == '{';
        v = dict ? jv_d() : jv_l();
        p = jp_ws(s, n, p + 1);
        if (p < n && s[p] == (dict ? '}' : ']')) { *at = p + 1; return v; }
        for (;;) {
            Jv *x, *key = 0;
            if (dict) {
                key = jp_val(s, n, &p);
                if (!key || key->t != JV_STR) return 0;
                p = jp_ws(s, n, p);
                if (p >= n || s[p] != ':') return 0;
                p++;
            }
            x = jp_val(s, n, &p);
            if (!x) return 0;
            if (dict) jd_put(v, key->s, x); else jl_add(v, x);
            p = jp_ws(s, n, p);
            if (p < n && s[p] == ',') { p++; continue; }
            if (p < n && s[p] == (dict ? '}' : ']')) { *at = p + 1; return v; }
            return 0;
        }
    }
    if (s[p] == '-' || (s[p] >= '0' && s[p] <= '9')) {
        long q = p + (s[p] == '-');
        long long x = 0;
        if (q >= n || s[q] < '0' || s[q] > '9') return 0;
        if (s[q] == '0' && q + 1 < n && s[q + 1] >= '0' && s[q + 1] <= '9') return 0;
        while (q < n && s[q] >= '0' && s[q] <= '9') { x = x * 10 + (s[q] - '0'); q++; }
        if (q < n && (s[q] == '.' || s[q] == 'e' || s[q] == 'E')) fg_die("JSON float in a fact", s);
        *at = q;
        return jv_i(s[p] == '-' ? -x : x);
    }
    if (tx_prefix(s + p, n - p, "true", 4)) { *at = p + 4; return jv_new(JV_TRUE); }
    if (tx_prefix(s + p, n - p, "false", 5)) { *at = p + 5; return jv_new(JV_FALSE); }
    if (tx_prefix(s + p, n - p, "null", 4)) { *at = p + 4; return jv_new(JV_NULL); }
    return 0;
}
static Jv *jv_parse(const char *s) {
    long n = tx_len(s, 1L << 30), at = 0;
    Jv *v = jp_val(s, n, &at);
    if (!v || jp_ws(s, n, at) != n) return 0;
    return v;
}
static Jv *jv_must_parse(const char *s) { Jv *v = jv_parse(s); if (!v) fg_die("bad JSON", s); return v; }
/* facts(stem) of exec/facts/load.py: rows as dicts of decoded cells (a cell that is not JSON stays text). */
static Jv *fj_facts(const char *stem) {
    char rel[256], *head[32], *hl;
    Lines L;
    int i, k, nh;
    Jv *rows = jv_l();
    cx_fmt(rel, sizeof rel, "exec/facts/%s.tsv", stem);
    L = fg_lines(rel);
    hl = fg_dupz(L.l[0]);
    while (*hl == '#') hl++;
    while (*hl == ' ' || *hl == '\t') hl++;
    { long e = tx_len(hl, FG_CAP); while (e > 0 && (hl[e - 1] == ' ' || hl[e - 1] == '\t' || hl[e - 1] == '\r')) hl[--e] = 0; }
    nh = fg_split(hl, head, 32);
    if (nh < 1) fg_die("bad header", stem);
    for (i = 1; i < L.n; i++) {
        char *cells[32], *line = fg_dupz(L.l[i]);
        int nc;
        Jv *r;
        if (!*line || line[0] == '#') continue;
        nc = fg_split(line, cells, 32);
        if (nc < 0) fg_die("row too wide", stem);
        r = jv_d();
        for (k = 0; k < nc && k < nh; k++) { Jv *c = jv_parse(cells[k]); jd_put(r, head[k], c ? c : jv_s(cells[k])); }
        jl_add(rows, r);
    }
    return rows;
}
/* {name: value} of a facts table, rows filtered by column `kind` == want when want is given. */
static Jv *fj_names(const char *stem, const char *want) {
    Jv *rows = fj_facts(stem), *d = jv_d();
    int i;
    for (i = 0; i < rows->n; i++) {
        Jv *r = rows->v[i];
        if (want && !tx_eq(jv_str(jd_must(r, "kind"), stem), want, 256)) continue;
        jd_put(d, jv_str(jd_must(r, "name"), stem), jd_must(r, "value"));
    }
    return d;
}
static Jv *fj_eq(const char *rel, const char *name) { return jv_must_parse(fg_eqrow(rel, name)); }   /* =NAME json row */
/* exec/parse2/NAME rows after the column line, split on tabs (gen2 tape_rows). */
typedef struct { int n; char **c[1024]; int nc[1024]; } Tape;
static void fj_tape(const char *name, Tape *t) {
    char rel[256];
    Lines L;
    int i;
    cx_fmt(rel, sizeof rel, "exec/parse2/%s", name);
    L = fg_lines(rel);
    t->n = 0;
    for (i = 1; i < L.n; i++) {
        char **cells = ar_alloc(fg_ar, (long)sizeof(char *) * 16);
        if (!cells || t->n == 1024) fg_die("tape rows", name);
        t->nc[t->n] = fg_split(fg_dupz(L.l[i]), cells, 16);
        if (t->nc[t->n] < 0) fg_die("tape row too wide", name);
        t->c[t->n++] = cells;
    }
}
static const char *fj_tget(Tape *t, const char *key, const char *dflt) {   /* dict(rows).get(key, dict[dflt]) */
    int i, hit = -1, d = -1;
    for (i = 0; i < t->n; i++) { if (t->nc[i] < 2) fg_die("tape row is not a pair", key); if (tx_eq(t->c[i][0], key, 256)) hit = i; if (dflt && tx_eq(t->c[i][0], dflt, 256)) d = i; }
    if (hit >= 0) return t->c[hit][1];
    if (d < 0) fg_die("tape key absent", key);
    return t->c[d][1];
}
/* gold(name) of export.py (its later definition): non-empty, non-comment rows without "=>". */
static int fj_gold(const char *name, char ***rows, int *nc, int cap) {
    char rel[256];
    Lines L;
    int i, n = 0;
    cx_fmt(rel, sizeof rel, "weights/gold/%s.tsv", name);
    L = fg_lines(rel);
    for (i = 0; i < L.n; i++) {
        char *s = L.l[i];
        if (!*s || s[0] == '#' || tx_find(s, tx_len(s, FG_CAP), "=>", 2) >= 0) continue;
        if (n == cap) fg_die("too many gold rows", name);
        rows[n] = ar_alloc(fg_ar, (long)sizeof(char *) * 16);
        if (!rows[n]) fg_die("out of memory", 0);
        nc[n] = fg_split(fg_dupz(s), rows[n], 16);
        if (nc[n] < 0) fg_die("gold row too wide", name);
        n++;
    }
    return n;
}
static int fj_isdigits(const char *s) { long i, n = tx_len(s, 64); if (n <= 0) return 0; for (i = 0; i < n; i++) if (s[i] < '0' || s[i] > '9') return 0; return 1; }
/* ---- the parse2 namespace (was export.py _parse_e/_gen2ns over exec/build/parsebase.py): E = facts
   parse-constants, G = facts gen2-constants plus the E names gen2 re-bound and the bank/rank facts it
   read, TK = facts parse-tokens, literal maps in facts gen2-literals. ---- */
#define G2_GOLD 8192
typedef struct {
    Jv *E, *G, *TK, *casops, *extra, *twords, *fpu;
    char *ax[32]; int nax;
    long long tsize[32], tuns[32], tnar[32];
    char *tyint[8]; long long tyvb[8], tysz[8], tyun[8], tynar[8];
    char *pop[64]; long long plev[64]; int nprec;
    long long levels[64]; int nlev;
    char *tops[64]; int ntops;
} G2;
static G2 g2;
static int g2_ready;
static long long gi(const char *n) { return jv_num(jd_must(g2.G, n), n); }
static long long ei(const char *n) { return jv_num(jd_must(g2.E, n), n); }
static long long tki(const char *n) { return jv_num(jd_must(g2.TK, n), n); }
static Jv *g2_lit(const char *n) { return fj_eq("exec/facts/gen2-literals.tsv", n); }
static int g2_ax(const char *n) { int i; for (i = 0; i < g2.nax; i++) if (tx_eq(g2.ax[i], n, 64)) return i; fg_die("not a type axis", n); return -1; }
static long long g2_sz(const char *ctype) { return g2.tsize[g2_ax(jv_str(jd_must(jd_must(g2.E, "CTY"), ctype), ctype))]; }
static long long g2_expr(Jv *v) {   /* INT, NAME, NAME+INT, SZ.<ctype> */
    const char *s, *plus;
    char name[128];
    long k;
    if (v->t == JV_INT) return v->i;
    s = jv_str(v, "gen2 expression");
    if (tx_prefix(s, tx_len(s, 128), "SZ.", 3)) return g2_sz(s + 3);
    k = tx_chr(s, tx_len(s, 128), '+');
    if (k < 0) return gi(s);
    if (tx_copy(name, sizeof name, s, k)) fg_die("bad gen2 expression", s);
    plus = s + k + 1;
    { char *end; long long add = strtoll(plus, &end, 10); if (end == plus || *end) fg_die("bad gen2 expression", s); return gi(name) + add; }
}
/* a token map: TK, plus `ident`/`number` entries when given, plus parse2-extra words each max+1 over
   the non-alias values (gen2 build() appends them before any rows install). */
static Jv *g2_tk(int ident, int number) {
    Jv *t = jv_d();
    int i, k;
    for (i = 0; i < g2.TK->n; i++) jd_put(t, g2.TK->k[i], g2.TK->v[i]);
    if (ident) jd_puti(t, "identifier", ei("TK_ID"));
    if (number) jd_puti(t, "number", ei("TK_NUM"));
    for (i = 0; i < g2.extra->n; i++) {
        const char *w = jv_str(g2.extra->v[i], "parse2-extra word");
        long long mx = -1;
        if (jd_get(t, w)) continue;
        for (k = 0; k < t->n; k++) {
            if ((ident && tx_eq(t->k[k], "identifier", 16)) || (number && tx_eq(t->k[k], "number", 16))) continue;
            if (t->v[k]->i > mx) mx = t->v[k]->i;
        }
        jd_puti(t, w, mx + 1);
    }
    return t;
}
static void g2_build(void) {
    static const char *alias[] = {"LOC", "UNS", "SBB", "STAG", "SSZ", "STRUCT_MAX", "SIG_RADIX", "FPB", "DBL", "FLT", 0};
    static const char *ranks[] = {"TYPERANK", "MEMBERRANK", "RETURNRANK", "PARAMRANK", 0};
    char **rows[G2_GOLD];
    int nc[G2_GOLD], n, i, k;
    Jv *vr, *lx, *words, *ty;
    if (g2_ready) return;
    g2_ready = 1;
    g2.E = fj_names("parse-constants", 0);
    g2.G = fj_names("gen2-constants", 0);
    for (i = 0; alias[i]; i++) { if (jd_get(g2.G, alias[i])) fg_die("gen2 constant shadows a parse constant", alias[i]); jd_put(g2.G, alias[i], jd_must(g2.E, alias[i])); }
    vr = fj_names("valueranks", "bank");
    jd_put(g2.G, "REGISTERBANK", jd_must(vr, "REGISTERBANK"));
    jd_put(g2.G, "VALUEBANK", jd_must(vr, "VALUEBANK"));
    lx = fj_names("libraryexports", 0);
    for (i = 0; ranks[i]; i++) jd_put(g2.G, ranks[i], jd_must(lx, ranks[i]));
    g2.TK = fj_eq("exec/facts/parse-tokens.tsv", "TK");
    g2.extra = fj_eq("exec/facts/parse2-extra.tsv", "words");
    if (jd_get(g2.TK, "type=extern")) fg_die("parse-tokens already holds type=extern", 0);
    g2.casops = jv_l();
    words = fj_facts("parse-words");
    for (i = 0; i < words->n; i++) if (tx_eq(jv_str(jd_must(words->v[i], "group"), "parse-words"), "casops", 16)) jl_add(g2.casops, jd_must(words->v[i], "value"));
    n = fj_gold("tyinfo", rows, nc, G2_GOLD);
    for (i = 0; i < n; i++) {
        if (nc[i] < 4 || !fj_isdigits(rows[i][1])) continue;
        if (g2.nax == 32) fg_die("tyinfo axis too long", 0);
        g2.ax[g2.nax] = rows[i][0];
        g2.tsize[g2.nax] = na_int(rows[i][1]); g2.tuns[g2.nax] = na_int(rows[i][2]); g2.tnar[g2.nax] = na_int(rows[i][3]);
        g2.nax++;
    }
    if (g2.nax != 16 || !tx_eq(g2.ax[15], "illegal", 16)) fg_die("tyinfo axis is not 16 names ending in illegal", 0);
    if (g2_sz("char") != 1 || g2_sz("short") != 2 || g2_sz("int") != 4 || g2_sz("long") != 8 || g2.tsize[g2_ax("ptr")] != 8) fg_die("measured widths", 0);
    ty = g2_lit("tyint");
    if (ty->n != 8) fg_die("TYINT is not 8 rows", 0);
    for (i = 0; i < 8; i++) {
        int a = g2_ax(jv_str(ty->v[i], "tyint"));
        g2.tyint[i] = g2.ax[a]; g2.tysz[i] = g2.tsize[a]; g2.tyun[i] = g2.tuns[a]; g2.tynar[i] = g2.tnar[a];
        g2.tyvb[i] = (g2.tuns[a] ? ei("UNS") : 0) + g2.tsize[a];
        if (g2.tysz[i] != 1 && g2.tysz[i] != 2 && g2.tysz[i] != 4 && g2.tysz[i] != 8) fg_die("TYINT width", g2.tyint[i]);
    }
    if (g2.tuns[g2_ax("u32")] != 1) fg_die("u32 is not unsigned", 0);
    jd_puti(g2.G, "U32M", (long long)((1ULL << (8 * g2.tsize[g2_ax("u32")])) - 1));
    n = fj_gold("prec", rows, nc, G2_GOLD);
    for (i = 0; i < n; i++) {
        int seen = -1;
        if (nc[i] < 2 || !fj_isdigits(rows[i][1])) continue;
        for (k = 0; k < g2.nprec; k++) if (tx_eq(g2.pop[k], rows[i][0], 16)) seen = k;
        if (seen < 0) { if (g2.nprec == 64) fg_die("too many operators", 0); seen = g2.nprec++; g2.pop[seen] = rows[i][0]; }
        g2.plev[seen] = na_int(rows[i][1]);
    }
    for (i = 0; i < g2.nprec; i++) {
        int seen = 0;
        for (k = 0; k < g2.nlev; k++) seen |= g2.levels[k] == g2.plev[i];
        if (!seen) g2.levels[g2.nlev++] = g2.plev[i];
    }
    for (i = 1; i < g2.nlev; i++) for (k = i; k > 0 && g2.levels[k] < g2.levels[k - 1]; k--) { long long t = g2.levels[k]; g2.levels[k] = g2.levels[k - 1]; g2.levels[k - 1] = t; }
    for (i = 0; i < g2.nlev; i++) {
        char *ops[64];
        int no = 0, j;
        for (k = 0; k < g2.nprec; k++) if (g2.plev[k] == g2.levels[i]) ops[no++] = g2.pop[k];
        for (k = 1; k < no; k++) for (j = k; j > 0 && byte_less(ops[j], ops[j - 1]); j--) { char *t = ops[j]; ops[j] = ops[j - 1]; ops[j - 1] = t; }
        for (k = 0; k < no; k++) if (!tx_eq(ops[k], "&&", 4) && !tx_eq(ops[k], "||", 4)) g2.tops[g2.ntops++] = ops[k];
    }
    g2.twords = jv_l();
    ty = g2_lit("typew");
    for (i = 0; i < ty->n; i++) jl_add(g2.twords, ty->v[i]->v[0]);
    ty = g2_lit("twords_extra");
    for (i = 0; i < ty->n; i++) jl_add(g2.twords, ty->v[i]);
    g2.fpu = jv_d();
    n = fj_gold("irsel", rows, nc, G2_GOLD);
    for (i = 0; i < n; i++) if (nc[i] >= 3 && tx_eq(rows[i][0], "fpu", 8)) jd_puts(g2.fpu, rows[i][1], rows[i][2]);
    if (!(gi("FPS_FIRST") < gi("SBB") && gi("SBB") + gi("STRUCT_MAX") < gi("SIG_RADIX") && gi("FPV") < gi("SBB"))) fg_die("gen2 code ranges overlap", 0);
    if (!(8 * gi("SIG_RADIX") + gi("SBB") + gi("STRUCT_MAX") < 2147483648LL)) fg_die("parameter depth packing", 0);
    if (!(gi("FPS_PSH") + gi("SBB") * 16 < gi("ENUM_STATE") && gi("ENUM_STATE") < gi("TAG_EPOCH"))) fg_die("enum state banks", 0);
}
/* the operators in prec order of their level (G.OPS[lv]) */
static int g2_ops(long long lv, char **out) {
    int i, j, n = 0;
    for (i = 0; i < g2.nprec; i++) if (g2.plev[i] == lv) out[n++] = g2.pop[i];
    for (i = 1; i < n; i++) for (j = i; j > 0 && byte_less(out[j], out[j - 1]); j--) { char *t = out[j]; out[j] = out[j - 1]; out[j - 1] = t; }
    return n;
}
static char *g2_fmt1(const char *tmpl, long long v) {   /* tmpl % v for a template with one %d */
    Ob o = {0, 0, 0};
    long i, n = tx_len(tmpl, FG_CAP);
    int used = 0;
    char b[32];
    for (i = 0; i < n; i++) {
        if (tmpl[i] == '%' && i + 1 < n && tmpl[i + 1] == 'd' && !used) { cx_fmt(b, sizeof b, "%lld", v); ob_z(&o, b); used = 1; i++; continue; }
        if (tmpl[i] == '%') fg_die("template is not one %d", tmpl);
        ob_put(&o, tmpl + i, 1);
    }
    if (!used) fg_die("template has no %d", tmpl);
    return o.p;
}
static void g2_line(Ob *o, const char *name, Jv *v) { ob_z(o, "="); ob_z(o, name); ob_z(o, "\tjson\t"); jv_dump(o, v, 0, 0); ob_z(o, "\n"); }
static void g2_int(Ob *o, const char *name, long long v) { char b[32]; ob_z(o, "="); ob_z(o, name); ob_z(o, "\tint\t"); cx_fmt(b, sizeof b, "%lld", v); ob_z(o, b); ob_z(o, "\n"); }
static Jv *g2_pick(Jv *d, Jv *src, const char *const *names) { int i; for (i = 0; names[i]; i++) jd_put(d, names[i], jd_must(src, names[i])); return d; }
static Jv *g2_tyint_list(void) {
    Jv *l = jv_l();
    int i;
    for (i = 0; i < 8; i++) {
        Jv *r = jv_l();
        jl_add(r, jv_s(g2.tyint[i])); jl_add(r, jv_i(g2.tyvb[i])); jl_add(r, jv_i(g2.tysz[i])); jl_add(r, jv_i(g2.tyun[i])); jl_add(r, jv_i(g2.tynar[i]));
        jl_add(l, r);
    }
    return l;
}
static Jv *g2_rows_code(int (*keep)(int)) { Jv *l = jv_l(); int i; for (i = 0; i < 8; i++) if (keep(i)) jl_add(l, jd_puti(jv_d(), "code", g2.tyvb[i])); return l; }
static int g2_k_narrow_u(int i) { return g2.tyun[i] && g2.tysz[i] < 8; }
static int g2_k_nar(int i) { return (int)g2.tynar[i]; }
static int g2_k_not8(int i) { return g2.tyvb[i] != 8; }
static int g2_k_all(int i) { (void)i; return 1; }
/* k2-gen2: the parse2/gen2-manifest.tsv constants (was export.py k2gen2). */
static void g2_optail(Jv *out) {   /* =oprows: export.py optail_facts for each ladder operator */
    char **rows[G2_GOLD];
    int nc[G2_GOLD], n, i, k;
    Jv *binsel = jv_d(), *irsel = jv_d(), *fops;
    Tape modes, flt;
    fj_tape("operator-modes.tsv", &modes);
    fj_tape("operator-float.tsv", &flt);
    fops = jv_d();
    for (i = 0; i < flt.n; i++) jd_puts(fops, flt.c[i][0], flt.c[i][1]);
    n = fj_gold("binsel", rows, nc, G2_GOLD);
    for (i = 0; i < n; i++) if (nc[i] >= 3 && (tx_eq(rows[i][1], "s", 4) || tx_eq(rows[i][1], "u", 4))) {
        char key[64]; cx_fmt(key, sizeof key, "%s\t%s", rows[i][0], rows[i][1]); jd_puts(binsel, key, rows[i][2]);
    }
    n = fj_gold("irsel", rows, nc, G2_GOLD);
    for (i = 0; i < n; i++) if (nc[i] >= 3 && tx_eq(rows[i][0], "alu", 8)) jd_puts(irsel, rows[i][1], rows[i][2]);
    for (i = 0; i < g2.ntops; i++) {
        const char *o = g2.tops[i], *pointer = 0;
        int compare = 0, invert = 0, s, m;
        Jv *r = jv_d(), *floats = jv_l();
        char sop[2][64];
        const char *sregs[2];
        for (k = 0, m = -1; k < modes.n; k++) if (tx_eq(modes.c[k][0], o, 16)) m = k;
        if (m < 0) for (k = 0; k < modes.n; k++) if (tx_eq(modes.c[k][0], "*", 4)) m = k;
        if (m < 0 || modes.nc[m] < 4) fg_die("operator-modes", o);
        pointer = modes.c[m][1]; compare = (int)na_int(modes.c[m][2]); invert = (int)na_int(modes.c[m][3]);
        for (s = 0; s < 2; s++) {   /* E.optext(o, u) split into mnemonic and registers */
            char key[64];
            const char *sp;
            long sn;
            int rev;
            cx_fmt(key, sizeof key, "%s\t%s", o, s ? "u" : "s");
            sp = jv_str(jd_must(irsel, jv_str(jd_must(binsel, key), key)), key);
            sn = tx_len(sp, 64);
            rev = sn > 4 && tx_eq(sp + sn - 4, "_rev", 8);
            if (rev) sn -= 4;
            k = 0;
            if ((sn == 3 && (tx_prefix(sp, 3, "div", 3) || tx_prefix(sp, 3, "mod", 3))) || (sn == 4 && (tx_prefix(sp, 4, "udiv", 4) || tx_prefix(sp, 4, "umod", 4)))) sop[s][k++] = '.';
            if (tx_copy(sop[s] + k, 64 - k, sp, sn)) fg_die("mnemonic too long", sp);
            sregs[s] = rev ? "r0, r1" : "r1, r0";
        }
        if (jd_get(fops, o)) {
            static const char *sfx[2] = {"d", "s"}, *base[2] = {"DBL", "FLT"};
            for (s = 0; s < 2; s++) {
                char key[64];
                const char *op;
                long on;
                Jv *f = jv_d();
                cx_fmt(key, sizeof key, "%s%s", sfx[s], jv_str(jd_get(fops, o), o));
                op = jv_str(jd_must(g2.fpu, key), key);
                on = tx_len(op, 64);
                jd_puts(f, "sfx", sfx[s]);
                if (on > 4 && tx_eq(op + on - 4, "_rev", 8)) { char t[64]; tx_copy(t, sizeof t, op, on - 4); jd_puts(f, "fop", t); jd_puts(f, "fregs", "r0, r1"); }
                else { jd_puts(f, "fop", op); jd_puts(f, "fregs", "r1, r0"); }
                jd_puti(f, "result", compare ? 4 : gi(base[s]));
                jl_add(floats, f);
            }
        }
        jd_puts(r, "op", o); jd_puti(r, "offset", (long long)i * 256);
        jd_puts(r, "sop", sop[0]); jd_puts(r, "sregs", sregs[0]); jd_puts(r, "uop", sop[1]); jd_puts(r, "uregs", sregs[1]);
        jd_puts(r, "ptr", pointer);
        jd_put(r, "ptrn", tx_eq(pointer, "add", 8) || tx_eq(pointer, "sub", 8) ? jl_unit() : jv_l());
        jd_put(r, "cmpl", compare ? jl_unit() : jv_l());
        jd_put(r, "invl", invert ? jl_unit() : jv_l());
        jd_put(r, "fl", floats->n ? jl_unit() : jv_l());
        jd_put(r, "nf", floats->n ? jv_l() : jl_unit());
        jd_put(r, "floats", floats);
        jl_add(out, r);
    }
}
static void g2_autonames(Jv *out) {   /* export.py _autonames over parse-constants AUTOINC_HEADERS */
    Jv *hs = jd_must(g2.E, "AUTOINC_HEADERS"), *seen = jv_d();
    int h, i;
    for (h = 0; h < hs->n; h++) {
        char rel[256];
        Lines L;
        cx_fmt(rel, sizeof rel, "include/%s", jv_str(hs->v[h], "AUTOINC_HEADERS"));
        L = fg_lines(rel);
        for (i = 0; i < L.n; i++) {
            const char *ln = L.l[i];
            long n = tx_len(ln, FG_CAP), p, a;
            char name[256];
            if (n <= 7 || !tx_prefix(ln, n, "static", 6) || tx_chr(ln, n, '(') < 0 || tx_chr(ln, n, '{') < 0) continue;
            p = tx_chr(ln, n, '(');
            while (p > 0 && ln[p - 1] == ' ') p--;
            a = p;
            while (a > 0 && ((ln[a - 1] >= 'a' && ln[a - 1] <= 'z') || (ln[a - 1] >= 'A' && ln[a - 1] <= 'Z') || (ln[a - 1] >= '0' && ln[a - 1] <= '9') || ln[a - 1] == '_')) a--;
            if (a >= p || tx_copy(name, sizeof name, ln + a, p - a)) continue;
            if (tx_eq(name, "printf", 16) || jd_get(seen, name)) continue;
            jd_puti(seen, name, 1);
            jl_add(out, jd_puts(jv_d(), "name", name));
        }
    }
}
static void k2_gen2(Ob *o) {
    static const char *fn_e[] = {"FND", "FRD", "FRB", "VAR", 0}, *gl_g[] = {"LOC", "GIBLOB", "GIEND", "GINPS", "GINPE", "GSZ", "GUNIT", "GHL", "GHE", "SINIT", "SKIPS", 0};
    static const char *gl_e[] = {"FND", "GMARK", "BASE", "ARR", "PTR", 0};
    static const char *bc_g[] = {"FPS_FN", "FPS_RD", "FPS_RB", "FPS_RSH", "FPS_COUNT", "FPS_PARAM", "FPS_PSH", "FPS_VAR", "SBB", "FPB", "FPV", "FPS_FIRST", "BOOL", "DBL", "FLT",
        "ENUM_FIRST", "GSZ", "GUNIT", "SSZ", "SAL", "SMN", "SMEM", "MOF", "MSZ", "MPT", "MBS", "MAR", "BFW", "BFO", "BFS", "SHAPE_IDS", "SHAPE", "UNS", "TIX", "REGISTERBANK", "UNDO_SIZE", "ENV", "END_", 0};
    static const char *sh_g[] = {"POSSPAN", "SHAPE", "SHAPE_IDS", "DIM", "TDIM", "MEMBER_STRIDE", "TYPERANK", "MEMBERRANK", "RETURNRANK", "PARAMRANK", 0};
    static const char *up_g[] = {"SBB", "UNS", "DBL", "FLT", "BOOL", "FPB", "FPV", "ENV", "END_", "LOC", "FPS_FN", "FPS_VAR", 0}, *up_e[] = {"FND", "VAR", "PTR", "BASE", "ARR", 0};
    static const char *st_g[] = {"BOOL", "LOC", "SIEND", "SINIT", "SKIPS", "TIX", 0};
    static const char *in_g[] = {"SBB", "LOC", "SSZ", "SMN", "SMEM", "MOF", "MPT", "MBS", "MAR", "SFLAT", "MFLAT", "MEMBER_STRIDE", "SKIPS", "BFW", "BFO", "BFS", "SHAPE", "SHAPE_IDS", "MSZ", "DIM", 0};
    static const char *k2_g[] = {"DBL", "FLT", "BOOL", "VLDEP", "END_", "VLFRAME", "VLSIZE", "UNS", "ENV", "SBB", "MEMBER_STRIDE", "MOF", "MSZ", "MBS", "MAR", 0};
    static const char *sc_e[] = {"UNDO", "PTR", "BASE", "ARR", "TDN", "TDB", "TDD", "FND", "FRD", "FRB", "VAR", 0};
    static const char *sc_g[] = {"VALUEBANK", "TYPERANK", "LOC", "END_", "ENV", "VLSIZE", "UNDO_SIZE", "SHAPE", "TDE", "REGISTERBANK", 0};
    char **rows[G2_GOLD], b[64];
    int nc[G2_GOLD], n, i, k, l, r, w;
    Jv *v, *d, *x, *tk, *lit, *ptrset;
    Tape t, follow, lm;
    long long maxtok = -1, i32;
    g2_build();
    g2_int(o, "VS", ei("VS"));
    g2_int(o, "POSSPAN", gi("POSSPAN"));
    fj_tape("type-follow.tsv", &follow);
    v = jv_l(); lit = g2_lit("typew");
    for (i = 0; i < lit->n; i++) {
        const char *word = jv_str(lit->v[i]->v[0], "typew");
        d = jv_d();
        jd_puts(d, "word", word); jd_puti(d, "value", g2_expr(lit->v[i]->v[1]));
        jd_puti(d, "rank", tx_eq(word, "type=float", 32) ? 1 : tx_eq(word, "type=double", 32) ? 2 : 0);
        jd_puts(d, "follow", fj_tget(&follow, word, "*"));
        jl_add(v, d);
    }
    g2_line(o, "typewords", v);
    {
        Tape tt;
        Jv *tape = jv_d(), *first = jl_unit();
        const char *current = "CKM";
        fj_tape("type-tape.tsv", &tt);
        for (i = 0; i < tt.n; i++) jd_put(tape, tt.c[i][0], jv_must_parse(tt.c[i][1]));
        v = jv_l();
        for (i = 0; i < 8; i++) {
            char nxt[32], hit[32], axn[16];
            if (!g2.tyun[i] || g2.tysz[i] >= 8) continue;
            cx_fmt(nxt, sizeof nxt, "CKM.k%lld", g2.tysz[i]); cx_fmt(hit, sizeof hit, "CKM.m%lld", g2.tysz[i]); cx_fmt(axn, sizeof axn, "u%lld", 8 * g2.tysz[i]);
            d = jv_d();
            jd_puts(d, "current", current); jd_puts(d, "hit", hit); jd_puts(d, "next", nxt); jd_puti(d, "axis", g2_ax(axn));
            jd_put(d, "first", first);
            jd_puts(d, "masktext", g2_fmt1(jv_str(jd_must(tape, "mask_pair"), "mask_pair"), (long long)((1ULL << (8 * g2.tysz[i])) - 1)));
            jl_add(v, d);
            current = fg_dupz(nxt); first = jv_l();
        }
        g2_line(o, "ckmrows", v);
        d = jv_d(); jd_puts(d, "current", current); jd_puti(d, "axis", g2_ax("u64")); jd_put(d, "first", first);
        g2_line(o, "ckmfinal", d);
        v = jv_l(); current = "RESD"; first = jl_unit();
        for (i = 0; i < 8; i++) {
            char hit[32], nxt[32];
            cx_fmt(hit, sizeof hit, "RESD.%s", g2.tyint[i]); cx_fmt(nxt, sizeof nxt, "RESD.n%s", g2.tyint[i]);
            d = jv_d();
            jd_puts(d, "current", current); jd_puts(d, "hit", hit); jd_puts(d, "next", nxt); jd_puti(d, "axis", g2_ax(g2.tyint[i]));
            jd_puti(d, "code", g2.tyvb[i]); jd_put(d, "first", first);
            jd_puts(d, "masktext", g2.tyun[i] && g2.tysz[i] < 8 ? g2_fmt1(jv_str(jd_must(tape, "mask"), "mask"), (long long)((1ULL << (8 * g2.tysz[i])) - 1)) : "");
            jl_add(v, d);
            current = fg_dupz(nxt); first = jv_l();
        }
        g2_line(o, "resdrows", v);
        d = jv_d(); jd_puts(d, "current", current); jd_put(d, "first", first);
        g2_line(o, "resdfinal", d);
        v = jv_l(); g2_optail(v); g2_line(o, "oprows", v);
        g2_int(o, "CKT", gi("CKT")); g2_int(o, "RST", gi("RST")); g2_int(o, "AXILL", g2_ax("illegal"));
        g2_line(o, "INVTEXT", jd_must(tape, "float_invert"));
    }
    fj_tape("ladder-modes.tsv", &lm);
    v = jv_l();
    for (i = 0; i < g2.nlev; i++) {
        char *ops[64];
        int no = g2_ops(g2.levels[i], ops), last = i + 1 >= g2.nlev;
        Jv *ol = jv_l();
        d = jv_d();
        jd_puti(d, "lv", g2.levels[i]);
        jd_put(d, "nxt", last ? jv_new(JV_NULL) : jv_i(g2.levels[i + 1]));
        jd_put(d, "mid", last ? jv_l() : jl_unit()); jd_put(d, "last", last ? jl_unit() : jv_l());
        for (k = 0; k < no; k++) { x = jv_d(); jd_puts(x, "op", ops[k]); jd_puti(x, "key", tki(ops[k])); jd_puts(x, "mode", fj_tget(&lm, ops[k], "*")); jl_add(ol, x); }
        jd_put(d, "ops", ol);
        jl_add(v, d);
    }
    g2_line(o, "ladder", v);
    {   /* export.py _namespace_constants */
        Jv *f = jv_d(), *g = jv_d(), *lo = jv_d();
        jd_puti(f, "PIDS", gi("PIDS")); jd_puti(f, "PDB", gi("PDB")); jd_puti(f, "LOC", gi("LOC"));
        g2_pick(f, g2.E, fn_e);
        for (i = 0; i < 16; i++) { cx_fmt(b, sizeof b, "FN_PDB%d", i); jd_puti(f, b, gi("PDB") + i); }
        g2_pick(g, g2.G, gl_g); g2_pick(g, g2.E, gl_e);
        jd_puti(lo, "SKIPS", gi("SKIPS")); jd_puti(lo, "PTR", ei("PTR")); jd_puti(lo, "BASE", ei("BASE"));
        d = jv_d(); jd_put(d, "function", f); jd_put(d, "globals", g); jd_put(d, "local", lo);
        g2_line(o, "nsconst", d);
    }
    g2_line(o, "truthfpu", g2.fpu);
    d = jv_d();
    jd_puti(d, "UNSIGNED_WIDE", gi("UNS") + 8);
    jd_put(d, "TK", g2_tk(0, 0));
    jd_puti(d, "TK_ID", ei("TK_ID")); jd_puti(d, "TK_NUM", ei("TK_NUM")); jd_puti(d, "TK_FNUM", ei("TK_FNUM")); jd_puti(d, "FND", ei("FND"));
    g2_pick(d, g2.G, bc_g);
    jd_put(d, "TYINT", g2_tyint_list());
    g2_line(o, "buildconst", d);
    d = jv_d(); jd_puti(d, "DBL", gi("DBL")); jd_puti(d, "FLT", gi("FLT")); jd_puti(d, "GMARK", ei("GMARK"));
    cx_fmt(b, sizeof b, "C%lld", g2.levels[0]); jd_puts(d, "bottom", b);
    g2_line(o, "ordconst", d);
    {   /* tyrows: CKT[l*16+r] = type(l "+" r); RST[opi*256+l*16+r] = type(l TYOP(o) r) */
        static short tyr[16][32][16];
        char *opn[32];
        int nop = 0;
        Jv *tyop = g2_lit("tyop");
        Ob *ob = o;
        n = fj_gold("type", rows, nc, G2_GOLD);
        for (l = 0; l < 16; l++) for (k = 0; k < 32; k++) for (r = 0; r < 16; r++) tyr[l][k][r] = -1;
        for (i = 0; i < n; i++) {
            int a, c, op = -1;
            if (nc[i] < 4) continue;
            for (k = 0; k < nop; k++) if (tx_eq(opn[k], rows[i][1], 16)) op = k;
            if (op < 0) { if (nop == 32) fg_die("too many type operators", 0); op = nop++; opn[op] = rows[i][1]; }
            a = g2_ax(rows[i][0]); c = g2_ax(rows[i][2]);
            tyr[a][op][c] = (short)g2_ax(rows[i][3]);
        }
        ob_z(ob, "=tyrows\tjson\t[");
        w = 0;
        for (l = 0; l < 16; l++) for (r = 0; r < 16; r++) {
            int plus = -1, u;
            char line[160];
            for (k = 0; k < nop; k++) if (tx_eq(opn[k], "+", 4)) plus = k;
            u = plus >= 0 && tyr[l][plus][r] >= 0 ? tyr[l][plus][r] : g2_ax("illegal");
            cx_fmt(line, sizeof line, "%s{\"t\": %d, \"u\": %d, \"tab\": %lld}", w++ ? ", " : "", l * 16 + r, u, gi("CKT"));
            ob_z(ob, line);
            for (i = 0; i < g2.ntops; i++) {
                const char *asks = g2.tops[i];
                int op = -1;
                if (jd_get(tyop, asks)) asks = jv_str(jd_get(tyop, asks), "tyop");
                for (k = 0; k < nop; k++) if (tx_eq(opn[k], asks, 16)) op = k;
                u = op >= 0 && tyr[l][op][r] >= 0 ? tyr[l][op][r] : g2_ax("illegal");
                cx_fmt(line, sizeof line, ", {\"t\": %d, \"tab\": %lld, \"u\": %d}", i * 256 + l * 16 + r, gi("RST"), u);
                ob_z(ob, line);
            }
        }
        ob_z(ob, "]\n");
    }
    v = jv_l(); lit = g2_lit("intrinsics");
    for (i = 0; i < lit->n; i++) { d = jv_d(); jd_puti(d, "i", i + 1); jd_put(d, "name", lit->v[i]->v[0]); jl_add(v, d); }
    g2_line(o, "syscalls", v);
    d = g2_pick(jv_d(), g2.G, sh_g); jd_puti(d, "ARR", ei("ARR")); jd_puti(d, "UNSIGNED_CHAR", gi("UNS") + 1);
    g2_line(o, "shapeconst", d);
    fj_tape("shape-tokens.tsv", &t);
    d = jv_d();
    for (i = 0; i < t.n; i++) {
        char *p = fg_dupz(t.c[i][1]), *q;
        Jv *l2 = jv_l();
        for (;;) { q = p; while (*q && *q != ',') q++; { int end = !*q; *q = 0; jl_add(l2, jv_i(tki(p))); if (end) break; p = q + 1; } }
        jd_put(d, t.c[i][0], l2);
    }
    g2_line(o, "shapeclasses", d);
    d = jv_d(); jd_puti(d, "SBB", gi("SBB")); jd_puti(d, "SSZ", gi("SSZ")); jd_puti(d, "CKT", gi("CKT"));
    cx_fmt(b, sizeof b, "E%lld", g2.levels[0]); jd_puts(d, "expr_entry", b); cx_fmt(b, sizeof b, "C%lld", g2.levels[0]); jd_puts(d, "tail_entry", b);
    g2_line(o, "retconst", d);
    tk = g2_tk(1, 1);
    fj_tape("return-tokens.tsv", &t);
    d = jv_d();
    for (i = 0; i < t.n; i++) jd_put(d, t.c[i][0], jl_one(jv_num(jd_must(tk, t.c[i][1]), t.c[i][1])));
    v = jv_l(); for (i = 0; i < g2.twords->n; i++) jl_add(v, jv_i(jv_num(jd_must(tk, g2.twords->v[i]->s), "tword")));
    jd_put(d, "typewords", v);
    v = jv_l(); jl_add(v, jv_i(gi("BOOL"))); jl_add(v, jv_i(gi("DBL"))); jl_add(v, jv_i(gi("FLT"))); jd_put(d, "scalar_types", v);
    v = jv_l(); jl_add(v, jv_i(gi("DBL"))); jl_add(v, jv_i(gi("FLT"))); jd_put(d, "float_types", v);
    jd_put(d, "axis_f64", jl_one(g2_ax("f64"))); jd_put(d, "axis_f32", jl_one(g2_ax("f32")));
    v = jv_l(); jl_add(v, jv_i(tki("="))); jl_add(v, jv_i(tki("++"))); jl_add(v, jv_i(tki("--")));
    for (i = 0; i < g2.casops->n; i++) { cx_fmt(b, sizeof b, "%s=", g2.casops->v[i]->s); jl_add(v, jv_i(tki(b))); }
    jd_put(d, "operators", v);
    g2_line(o, "retclasses", d);
    {   /* retexpr0, retint, retfloat, retcompound; updid0/updcompound share the key set */
        unsigned char used[257] = {0};
        Jv *comp = jv_l(), *comp2 = jv_l();
        for (i = 0; i < g2.casops->n; i++) {
            long long key;
            cx_fmt(b, sizeof b, "%s=", g2.casops->v[i]->s); key = tki(b);
            if (key < 0 || key > 256) fg_die("compound token out of range", b);
            used[key] = 1;
            d = jv_d(); jd_puti(d, "key", key); cx_fmt(b, sizeof b, "LV.c%s", g2.casops->v[i]->s); jd_puts(d, "target", b); jl_add(comp, d);
            d = jv_d(); jd_puti(d, "key", key); cx_fmt(b, sizeof b, "X.c%s", g2.casops->v[i]->s); jd_puts(d, "target", b); jl_add(comp2, d);
        }
        v = jv_l(); for (i = 0; i < 257; i++) if (!used[i]) jl_add(v, jv_i(i));
        g2_line(o, "retexpr0", v);
        g2_line(o, "retint", g2_rows_code(g2_k_all));
        v = jv_l(); lit = g2_lit("retfloat");
        for (i = 0; i < lit->n; i++) { d = jv_d(); jd_put(d, "label", lit->v[i]->v[0]); jd_put(d, "cv", lit->v[i]->v[1]); jd_puti(d, "base", g2_expr(lit->v[i]->v[2])); jl_add(v, d); }
        g2_line(o, "retfloat", v);
        g2_line(o, "retcompound", comp);
        d = g2_pick(jv_d(), g2.G, up_g); g2_pick(d, g2.E, up_e);
        for (k = 1; k <= 8; k *= 2) { cx_fmt(b, sizeof b, "U%d", k); jd_puti(d, b, gi("UNS") + k); }
        cx_fmt(b, sizeof b, "C%lld", g2.levels[0]); jd_puts(d, "tail_entry", b);
        jd_puti(d, "axis_ptr", g2_ax("ptr")); jd_puti(d, "axis_struct", g2_ax("struct"));
        g2_line(o, "updconst", d);
        tk = g2_tk(1, 0);
        fj_tape("update-tokens.tsv", &t);
        d = jv_d();
        for (i = 0; i < t.n; i++) jd_put(d, t.c[i][0], jl_one(jv_num(jd_must(tk, t.c[i][1]), t.c[i][1])));
        jd_put(d, "BOOL", jl_one(gi("BOOL")));
        v = jv_l(); jl_add(v, jv_i(gi("DBL"))); jl_add(v, jv_i(gi("FLT"))); jd_put(d, "float_types", v);
        v = jv_l(); jl_add(v, jv_i(g2_ax("f32"))); jl_add(v, jv_i(g2_ax("f64"))); jd_put(d, "float_axes", v);
        v = jv_l(); for (i = 0; i < 8; i++) if (!g2.tyun[i] && g2.tysz[i] < 8) jl_add(v, jv_i(g2.tyvb[i]));
        jd_put(d, "signed_narrow_codes", v);
        g2_line(o, "updclasses", d);
        v = jv_l(); for (i = 0; i < 257; i++) if (!used[i]) jl_add(v, jv_i(i));
        g2_line(o, "updid0", v);
        g2_line(o, "updcompound", comp2);
    }
    g2_line(o, "ordupd", g2_lit("ordupd"));
    g2_line(o, "staticsenv", g2_pick(jv_d(), g2.G, st_g));
    d = g2_pick(jv_d(), g2.G, in_g);
    jd_puti(d, "UCHAR", ei("UNS") + 1); jd_puti(d, "PTR", ei("PTR")); jd_puti(d, "BASE", ei("BASE")); jd_puti(d, "ARR", ei("ARR"));
    jd_puti(d, "DIM1", gi("DIM") + 1); jd_puti(d, "DIM2", gi("DIM") + 2);
    g2_line(o, "initenv", d);
    g2_line(o, "k2env", g2_pick(jv_d(), g2.G, k2_g));
    {
        Lines L = fg_lines("exec/facts/statics.tsv");
        for (i = 0; i < L.n; i++) if (tx_prefix(L.l[i], tx_len(L.l[i], FG_CAP), "limit\tMAXTOK\t", 13)) { char *c[4], *line = fg_dupz(L.l[i]); if (fg_split(line, c, 4) >= 3) { maxtok = na_int(c[2]); break; } }
        if (maxtok < 0) fg_die("statics.tsv has no limit MAXTOK", 0);
    }
    d = jv_d();
    x = jv_d(); jd_puti(x, "TIX", gi("TIX")); jd_puti(x, "MAXTOK", maxtok); jd_put(d, "ucx", x);
    x = jv_d(); jd_puti(x, "DBL", gi("DBL")); jd_puti(x, "FLT", gi("FLT")); jd_puti(x, "BOOL", gi("BOOL"));
    jd_puti(x, "UNS1", gi("UNS") + 1); jd_puti(x, "UNS3", gi("UNS") + 3); jd_puti(x, "UNS4", gi("UNS") + 4); jd_puti(x, "UNS8", gi("UNS") + 8);
    jd_puti(x, "U32M", gi("U32M")); jd_puti(x, "ENV", gi("ENV")); jd_puti(x, "END_", gi("END_")); jd_puti(x, "FNSTR", gi("FNSTR")); jd_puti(x, "TIX", gi("TIX")); jd_puti(x, "MAXTOK", maxtok);
    jd_put(d, "ufacts", x);
    g2_line(o, "unaryenv", d);
    fj_tape("update-pointer.tsv", &t);
    ptrset = jv_d(); for (i = 0; i < t.n; i++) jd_puti(ptrset, t.c[i][0], 1);
    v = jv_l();
    for (i = 0; i < g2.casops->n; i++) {
        int np = !jd_get(ptrset, g2.casops->v[i]->s);
        d = jv_d(); jd_put(d, "op", g2.casops->v[i]); jd_puti(d, "nptr", np); jd_puts(d, "owner", np ? "X" : "LV"); jl_add(v, d);
    }
    g2_line(o, "updcas", v);
    v = jv_l(); lit = g2_lit("updtype");
    for (i = 0; i < lit->n; i++) { d = jv_d(); jd_puti(d, "code", g2_expr(lit->v[i]->v[0])); jd_puti(d, "axis", g2_ax(jv_str(lit->v[i]->v[1], "updtype"))); jl_add(v, d); }
    g2_line(o, "updtype", v);
    fj_tape("update-modes.tsv", &t);
    v = jv_l();
    for (i = 0; i < t.n; i++) {
        static const char *keys[7] = {"name", "op", "postfix", "prefixname", "prefixfix", "integer", "floating"};
        d = jv_d();
        for (k = 0; k < 7 && k < t.nc[i]; k++) jd_puts(d, keys[k], t.c[i][k]);
        jl_add(v, d);
    }
    g2_line(o, "updmodes", v);
    fj_tape("update-float.tsv", &t);
    v = jv_l();
    for (i = 0; i < t.n; i++) { d = jv_d(); jd_puts(d, "suffix", t.c[i][0]); jd_puti(d, "bits", strtoll(t.c[i][1], 0, 10)); jl_add(v, d); }
    g2_line(o, "updfloat", v);
    d = jv_d();
    jd_put(d, "LOADV", jd_put(jv_d(), "rows", g2_rows_code(g2_k_not8)));
    jd_put(d, "LOADRAW", jd_put(jv_d(), "rows", g2_rows_code(g2_k_not8)));
    jd_put(d, "STOREV0", jd_put(jv_d(), "rows", g2_rows_code(g2_k_not8)));
    g2_line(o, "widthd", d);
    d = jv_d(); jd_puti(d, "DBL", gi("DBL")); jd_puti(d, "FLT", gi("FLT")); jd_puti(d, "BOOL", gi("BOOL")); jd_puti(d, "SBB", gi("SBB"));
    g2_line(o, "widthconst", d);
    {
        Jv *wp = jv_d(), *c;
        c = jv_d(); jd_puti(c, "FLT", gi("FLT")); jd_put(wp, "store", jd_put(jv_d(), "consts", c));
        c = jv_d(); jd_puti(c, "SBB", gi("SBB")); jd_puti(c, "SSZ", gi("SSZ")); jd_puti(c, "DBL", gi("DBL")); jd_puti(c, "FLT", gi("FLT")); jd_puti(c, "BOOL", gi("BOOL")); jd_puti(c, "UNS", gi("UNS"));
        jd_put(wp, "elsz", jd_put(jv_d(), "consts", c));
        c = jv_d(); jd_puti(c, "BOOL", gi("BOOL")); x = jd_put(jv_d(), "consts", c); jd_put(x, "rows", g2_rows_code(g2_k_narrow_u)); jd_put(wp, "naru", x);
        c = jv_d(); jd_puti(c, "BOOL", gi("BOOL")); jd_puti(c, "DBL", gi("DBL")); jd_puti(c, "FLT", gi("FLT")); jd_puti(c, "UNSIGNED_WIDE", gi("UNS") + 8);
        x = jd_put(jv_d(), "consts", c);
        v = jv_l(); lit = g2_lit("conv_suffixes"); for (i = 0; i < lit->n; i++) jl_add(v, jd_put(jv_d(), "s", lit->v[i]));
        jd_put(x, "suffixes", v); jd_put(wp, "conv", x);
        c = jv_d(); jd_puti(c, "UNSIGNED_WIDE", gi("UNS") + 8); jd_puti(c, "DBL", gi("DBL")); jd_puti(c, "BOOL", gi("BOOL")); jd_puti(c, "TDN", ei("TDN"));
        x = jd_put(jv_d(), "consts", c); jd_put(x, "rows", g2_rows_code(g2_k_nar)); jd_put(wp, "narrow", x);
        g2_line(o, "widthparts", wp);
    }
    d = g2_pick(jv_d(), g2.E, sc_e); g2_pick(d, g2.G, sc_g);
    for (i = 0; i < gi("UNDO_SIZE"); i++) { cx_fmt(b, sizeof b, "UNDO_%d", i); jd_puti(d, b, ei("UNDO") + i); }
    for (i = 0; i < 8; i++) { cx_fmt(b, sizeof b, "DIM_%d", i); jd_puti(d, b, gi("DIM") + i); }
    for (i = 0; i < 16; i++) { cx_fmt(b, sizeof b, "PDB_%d", i); jd_puti(d, b, gi("PDB") + i); }
    g2_line(o, "scopeconst", d);
    i32 = g2.tsize[g2_ax("i32")];
    {
        Jv *gp = jv_d(), *c, *cl, *tt, *ops;
        cl = jv_d(); jd_put(cl, "identifier", jl_one(ei("TK_ID"))); jd_put(cl, "paren", jl_one(tki("(")));
        jd_put(gp, "localdecl", jd_put(jv_d(), "classes", cl));
        c = jv_d(); jd_puti(c, "DBL", gi("DBL")); x = jd_put(jv_d(), "consts", c);
        jd_put(x, "classes", jd_put(jv_d(), "double", jl_one(tki("type=double")))); jd_put(gp, "longdouble", x);
        c = jv_d(); jd_puti(c, "INT", i32); x = jd_put(jv_d(), "consts", c);
        cl = jv_d();
        v = jl_one(gi("BOOL")); for (i = 0; i < 8; i++) if (g2.tysz[i] < i32) jl_add(v, jv_i(g2.tyvb[i]));
        jd_put(cl, "promote", v);
        v = jv_l(); jl_add(v, jv_i(gi("DBL"))); jl_add(v, jv_i(gi("FLT"))); for (i = 0; i < 8; i++) if (g2.tysz[i] >= i32) jl_add(v, jv_i(g2.tyvb[i]));
        jd_put(cl, "arithmetic", v);
        jd_put(x, "classes", cl); jd_put(gp, "positive", x);
        c = jv_d(); jd_puti(c, "TENTATIVE", gi("TENTATIVE")); jd_put(gp, "tentative", jd_put(jv_d(), "consts", c));
        tk = g2_tk(0, 0);
        tt = jv_d();   /* typetargets: token code (decimal key) -> target, Python dict order */
        for (i = 0; i < g2.twords->n; i++) { cx_fmt(b, sizeof b, "%lld", jv_num(jd_must(tk, g2.twords->v[i]->s), "tword")); { char tg[64]; cx_fmt(tg, sizeof tg, "TS.%s", g2.twords->v[i]->s); jd_puts(tt, b, tg); } }
        fj_tape("type-entry.tsv", &t);
        for (i = 0; i < t.n; i++) {
            long long key = tx_eq(t.c[i][0], "identifier", 16) ? ei("TK_ID") : jv_num(jd_must(tk, t.c[i][0]), t.c[i][0]);
            cx_fmt(b, sizeof b, "%lld", key); jd_puts(tt, b, t.c[i][1]);
        }
        ops = jv_l();
        for (i = 0; i < tt->n; i++) { x = jv_d(); jd_puti(x, "key", strtoll(tt->k[i], 0, 10)); jd_put(x, "target", tt->v[i]); jl_add(ops, x); }
        jd_put(gp, "typeops", ops);
        ops = jv_l();
        for (i = 0; i < g2.casops->n; i++) { x = jv_d(); cx_fmt(b, sizeof b, "%s=", g2.casops->v[i]->s); jd_puti(x, "key", tki(b)); cx_fmt(b, sizeof b, "LV.c%s", g2.casops->v[i]->s); jd_puts(x, "target", b); jl_add(ops, x); }
        jd_put(gp, "updateops", ops);
        g2_line(o, "gen2parts", gp);
    }
    v = jv_l(); g2_autonames(v); g2_line(o, "autonames", v);
    g2_line(o, "HEADER", jd_must(g2.E, "HEADER"));
    g2_int(o, "AUT", ei("AUT"));
    g2_int(o, "AXF64", g2_ax("f64"));
}

/* k2-membercontrol: member/assignment domain values (was export.py k2membercontrol); compact JSON. */
static void g2_cline(Ob *o, const char *name, Jv *v) { ob_z(o, "="); ob_z(o, name); ob_z(o, "\tjson\t"); jv_dump(o, v, 1, 0); ob_z(o, "\n"); }
static Jv *g2_templ(const char *name) {   /* G.TEMPL[name]: exec/parse2/tape-templates.tsv, bindings to E.PUSH/E.POP1 */
    Tape t;
    int i, hit = -1;
    fj_tape("tape-templates.tsv", &t);
    for (i = 0; i < t.n; i++) {
        if (t.nc[i] != 3) fg_die("tape-templates row", 0);
        if (tx_eq(t.c[i][0], name, 128)) { if (hit >= 0) fg_die("tape template defined twice", name); hit = i; }
    }
    if (hit < 0) fg_die("tape template absent", name);
    if (tx_eq(t.c[hit][1], "binding", 16)) {
        if (!tx_eq(t.c[hit][2], "PUSH", 8) && !tx_eq(t.c[hit][2], "POP1", 8)) fg_die("tape template binding", t.c[hit][2]);
        return jd_must(g2.E, t.c[hit][2]);
    }
    if (!tx_eq(t.c[hit][1], "literal", 16)) fg_die("tape template kind", t.c[hit][1]);
    return jv_must_parse(t.c[hit][2]);
}
static void k2_membercontrol(Ob *o) {
    static const char *cn[] = {"SBB", "MEMBER_STRIDE", "MOF", "MSZ", "MPT", "MBS", "MAR", "BFW", "BFO", "BFS", "SHAPE_IDS", "SHAPE", "SSZ", "DBL", "FLT", "BOOL", 0};
    static const char *seq[3] = {"text", "stack", "template"};
    char b[64];
    Jv *d, *v, *tk, *want, *push = 0, *pop1 = 0;
    Tape t;
    long long sc[16], ss[16], su[16];
    int i, k, ns = 0, after = 0;
    g2_build();
    d = g2_pick(jv_d(), g2.G, cn); jd_puti(d, "ARR", ei("ARR"));
    g2_cline(o, "consts", d);
    tk = jv_d();
    for (i = 0; i < g2.TK->n; i++) jd_put(tk, g2.TK->k[i], g2.TK->v[i]);
    jd_puti(tk, "identifier", ei("TK_ID"));
    fj_tape("membercontrol-tokens.tsv", &t);
    d = jv_d();
    for (i = 0; i < t.n; i++) jd_put(d, t.c[i][0], jl_one(jv_num(jd_must(tk, t.c[i][1]), t.c[i][1])));
    g2_cline(o, "classes", d);
    for (i = 0; i < 8; i++) { sc[ns] = g2.tyvb[i]; ss[ns] = g2.tysz[i]; su[ns++] = g2.tyun[i]; }
    sc[ns] = gi("FLT"); ss[ns] = 4; su[ns++] = 0;
    sc[ns] = gi("DBL"); ss[ns] = 8; su[ns++] = 0;
    sc[ns] = gi("BOOL"); ss[ns] = 1; su[ns++] = 0;
    v = jv_l();
    for (i = 0; i < 8; i++) {
        d = jv_d();
        jd_puts(d, "name", g2.tyint[i]); jd_puti(d, "code", g2.tyvb[i]);
        jd_put(d, "wide", g2.tysz[i] >= 8 ? jl_one(1) : jv_l());
        if (g2.tysz[i] >= 8) jd_put(d, "narrow", jv_l());
        else {
            long long vals[16];
            int nv = 0, j, m;
            Jv *vl = jv_l();
            for (k = 0; k < ns; k++) if (ss[k] <= g2.tysz[i] && su[k] == g2.tyun[i]) {
                int dup = 0;
                for (j = 0; j < nv; j++) dup |= vals[j] == sc[k];
                if (!dup) vals[nv++] = sc[k];
            }
            for (j = 1; j < nv; j++) for (m = j; m > 0 && vals[m] < vals[m - 1]; m--) { long long x = vals[m]; vals[m] = vals[m - 1]; vals[m - 1] = x; }
            for (j = 0; j < nv; j++) jl_add(vl, jv_i(vals[j]));
            jd_put(d, "narrow", jl_add(jv_l(), jd_put(jv_d(), "values", vl)));
        }
        jl_add(v, d);
    }
    g2_cline(o, "types", v);
    fj_tape("membercontrol-operators.tsv", &t);
    want = g2_lit("membercontrol_operators");
    if (t.n != want->n) fg_die("membercontrol-operators is not the two recorded rows", 0);
    for (i = 0; i < t.n; i++) {
        if (t.nc[i] != want->v[i]->n) fg_die("membercontrol-operators row", t.c[i][0]);
        for (k = 0; k < t.nc[i]; k++) if (!tx_eq(t.c[i][k], jv_str(want->v[i]->v[k], "operator"), 256)) fg_die("membercontrol-operators row", t.c[i][k]);
    }
    {   /* membercontrol-manifest-fresh.tsv = membercontrol-fresh.tsv with part2 split into head/choice/tail */
        Lines s = fg_lines("exec/parse2/membercontrol-fresh.tsv"), m = fg_lines("exec/parse2/membercontrol-manifest-fresh.tsv");
        if (s.n != m.n || s.n < 1 || !tx_eq(s.l[0], m.l[0], FG_CAP)) fg_die("membercontrol manifest fresh rows", 0);
        for (i = 1; i < s.n; i++) {
            char *c[16], *line = fg_dupz(s.l[i]);
            int nc = fg_split(line, c, 16);
            Ob e = {0, 0, 0};
            if (nc < 2) fg_die("membercontrol fresh row", s.l[i]);
            if (tx_eq(c[0], "part2", 8)) {
                if (tx_eq(c[1], "plain", 16) || tx_eq(c[1], "warnings", 16)) { after = 1; c[0] = "part2.choice"; }
                else c[0] = after ? "part2.tail" : "part2.head";
            }
            for (k = 0; k < nc; k++) { if (k) ob_z(&e, "\t"); ob_z(&e, c[k]); }
            if (!tx_eq(e.p ? e.p : "", m.l[i], FG_CAP)) fg_die("membercontrol manifest fresh differs", m.l[i]);
        }
    }
    v = jv_l();
    for (i = 0; i < g2.casops->n; i++) {
        d = jv_d(); jd_put(d, "op", g2.casops->v[i]);
        cx_fmt(b, sizeof b, "%s=", g2.casops->v[i]->s); jd_puti(d, "token", jv_num(jd_must(tk, b), b));
        jl_add(v, d);
    }
    g2_cline(o, "casops", v);
    fj_tape("membercontrol-template.tsv", &t);
    for (i = 0; i < t.n; i++) {
        Jv *spec = jv_must_parse(t.c[i][1]);
        Jv *x = g2_templ(jv_str(spec->v[0], "template spec"));
        if (tx_eq(t.c[i][0], "template0", 16)) push = x;
        else if (tx_eq(t.c[i][0], "template1", 16)) pop1 = x;
        else fg_die("membercontrol template name", t.c[i][0]);
    }
    if (!push || !pop1 || t.n != 2) fg_die("membercontrol templates are not template0/template1", 0);
    v = jv_l();
    for (k = 0; k < 3; k++) {
        char nm[64];
        cx_fmt(nm, sizeof nm, "membercontrol-%s.tsv", seq[k]);
        fj_tape(nm, &t);
        for (i = 0; i < t.n; i++) jl_add(v, jv_s(t.c[i][0]));
    }
    g2_cline(o, "seqnames", v);
    g2_cline(o, "push_text", push);
    g2_cline(o, "pop1_text", pop1);
}

/* k2-libraryenv: the parse2 library export chain environment (was export.py k2libraryenv); compact
   sorted JSON.  b = k2-gen2's committed buildconst row. */
static Jv *g2_typed(const char *rel, const char *name) {   /* =NAME KIND VALUE, typed as exec/facts/load.py typed_cell */
    Lines L = fg_lines(rel);
    int i;
    for (i = 0; i < L.n; i++) {
        char *c[4], *line = fg_dupz(L.l[i]);
        if (line[0] != '=' || fg_split(line + 1, c, 3) != 3 || !tx_eq(c[0], name, 256)) continue;
        if (tx_eq(c[1], "int", 8)) return jv_i(strtoll(c[2], 0, 10));
        if (tx_eq(c[1], "json", 8)) return jv_must_parse(c[2]);
        if (tx_eq(c[1], "str", 8)) {
            char *s = c[2], *d = c[2];
            while (*s) { if (*s == '\\' && s[1]) { s++; *d++ = *s == 't' ? '\t' : *s == 'n' ? '\n' : *s; s++; } else *d++ = *s++; }
            *d = 0;
            return jv_s(c[2]);
        }
        fg_die("fact type", c[1]);
    }
    fg_die("row absent", name);
    return 0;
}
static Jv *g2_banks(const char *stem) {   /* {name: value} of a facts table, int values >= 1 << 40 */
    Jv *rows = fj_facts(stem), *d = jv_d();
    int i;
    for (i = 0; i < rows->n; i++) {
        Jv *v = jd_get(rows->v[i], "value");
        if (v && v->t == JV_INT && v->i >= (1LL << 40)) jd_put(d, jv_str(jd_must(rows->v[i], "name"), stem), v);
    }
    return d;
}
static void g2_sline(Ob *o, const char *name, Jv *v) { ob_z(o, "="); ob_z(o, name); ob_z(o, "\tjson\t"); jv_dump(o, v, 1, 1); ob_z(o, "\n"); }
static void k2_libraryenv(Ob *o) {
    static const char *bn[] = {"FPS_FN", "FPS_RD", "FPS_RB", "FPS_RSH", "FPS_COUNT", "FPS_PARAM", "FPS_PSH", "FPS_VAR", "SBB", "FPB", "FPV", "FPS_FIRST", "BOOL", "DBL", "FLT",
        "ENUM_FIRST", "GSZ", "GUNIT", "SSZ", "SAL", "SMN", "SMEM", "MOF", "MSZ", "MPT", "MBS", "MAR", "BFW", "BFO", "BFS", 0};
    static const char *lxb[] = {"FPS_FN", "FPS_COUNT", "FPS_VAR", "FPS_RD", "FPS_RB", "FPS_RSH", 0};
    static const char *lib[] = {"BYNAME", "ADDRESS", "FORMAT", "SUPPORTED", "TYPEDSIG", "PLAN", 0};
    static const char *lcb[] = {"FPS_FN", "FPS_COUNT", "FPS_RB", "FPS_RD", "FPS_RSH", "FPS_VAR", "SSZ", "SBB", 0};
    char b[128];
    Jv *C, *bd, *ints, *lx, *lxd, *vr, *bints, *d, *v, *x, *outs, *orow, *li, *lc, *seqs;
    int i, k;
    long long isize = -1;
    Lines R;
    g2_build();
    C = fj_eq("exec/facts/k2-gen2.tsv", "buildconst");
    bd = g2_pick(jv_d(), C, bn);
    ints = jd_must(C, "TYINT");
    lxd = fj_names("libraryexports", 0);
    vr = fj_names("valueranks", "bank");
    lx = jv_d();
    for (i = 0; i < lxd->n; i++) if (lxd->v[i]->t == JV_INT && lxd->v[i]->i >= (1LL << 40)) jd_put(lx, lxd->k[i], lxd->v[i]);
    bints = jv_d();
    for (i = 0; i < bd->n; i++) if (bd->v[i]->t == JV_INT) { cx_fmt(b, sizeof b, "b_%s", bd->k[i]); jd_put(bints, b, bd->v[i]); }
    outs = g2_lit("libraryenv_out");
    orow = jv_l();
    for (i = 0; i < outs->n; i++) {
        const char *text = jv_str(outs->v[i], "libraryenv_out");
        long n = tx_len(text, 256);
        d = jv_d();
        cx_fmt(b, sizeof b, "out %s", text);
        while (n > 0 && text[n - 1] == '\n') { b[4 + n - 1] = 0; n--; }
        jd_puts(d, "name", b); jd_puts(d, "kind", "out"); jd_puts(d, "text", text);
        jl_add(orow, d);
    }
    d = jv_d(); jd_puts(d, "name", "reject"); jd_puts(d, "kind", "reject"); jd_put(d, "reason", g2_lit("libraryenv_reject")); jl_add(orow, d);
    {
        Jv *cons = jv_d(), *names = jv_l(), *keys = jv_l();
        for (i = 0; i < lx->n; i++) jd_put(cons, lx->k[i], lx->v[i]);
        g2_pick(cons, bd, lxb);
        for (i = 0; i < orow->n; i++) jl_add(names, jd_must(orow->v[i], "name"));
        for (i = 0; i < 257; i++) jl_add(keys, jv_i(i));
        d = jv_d();
        jd_put(d, "constants", cons); jd_put(d, "out_names", names); jd_put(d, "out_rows", orow);
        jd_puti(d, "tk_static", tki("type=static")); jd_put(d, "allkeys", keys);
        g2_sline(o, "lx", d);
    }
    d = jv_d();
    for (i = 0; i < bints->n; i++) jd_put(d, bints->k[i], bints->v[i]);
    for (i = 0; i < ints->n; i++) if (tx_eq(jv_str(ints->v[i]->v[0], "TYINT"), "i32", 8)) { isize = jv_num(ints->v[i]->v[2], "TYINT size"); break; }
    if (isize < 0) fg_die("TYINT has no i32", 0);
    jd_puti(d, "isize", isize);
    v = jv_l();
    for (i = 0; i < ints->n; i++) { x = jv_d(); jd_put(x, "code", ints->v[i]->v[1]); jd_put(x, "size", ints->v[i]->v[2]); jd_put(x, "uns", ints->v[i]->v[3]); jl_add(v, x); }
    jd_put(d, "ints", v);
    jd_puti(d, "E_ARR", ei("ARR")); jd_puti(d, "gen2_DIM", gi("DIM"));
    g2_sline(o, "types", d);
    d = jv_d();
    for (i = 0; i < bints->n; i++) jd_put(d, bints->k[i], bints->v[i]);
    jd_puti(d, "TK_ID", ei("TK_ID")); jd_puti(d, "TK_SEMI", tki(";"));
    v = jv_l(); jl_add(v, jd_must(bd, "FPB")); jl_add(v, jd_must(bd, "FPV")); jd_put(d, "FPB_FPV", v);
    jd_put(d, "BOOL", jl_add(jv_l(), jd_must(bd, "BOOL")));
    v = jv_l();
    for (i = 0; i < ints->n; i++) { x = jv_d(); jd_put(x, "code", ints->v[i]->v[1]); jd_put(x, "width", ints->v[i]->v[2]); jd_put(x, "uns", ints->v[i]->v[3]); jl_add(v, x); }
    jd_put(d, "ints2", v);
    g2_sline(o, "imports", d);
    li = fj_names("libraryimports", 0);
    lc = g2_banks("librarycallables");
    jd_put(lc, "RETURNRANK", jd_must(lxd, "RETURNRANK")); jd_put(lc, "PARAMRANK", jd_must(lxd, "PARAMRANK")); jd_put(lc, "LCSITERANK", jd_must(vr, "LCSITERANK"));
    g2_pick(lc, li, lib);
    jd_put(lc, "REQUESTS", g2_typed("exec/facts/libraryvariadic.tsv", "REQUESTS"));
    jd_put(lc, "DEFINED", jd_must(fj_names("unresolved", 0), "DEFINED"));
    jd_put(lc, "VARIADIC", jd_must(lxd, "VARIADIC"));
    jd_puti(lc, "E_VAR", ei("VAR")); jd_puti(lc, "E_DBL", ei("DBL")); jd_puti(lc, "E_INT", g2_sz("int")); jd_puti(lc, "TK_SEMI", tki(";"));
    for (i = 0; lcb[i]; i++) { cx_fmt(b, sizeof b, "b_%s", lcb[i]); jd_put(lc, b, jd_must(bd, lcb[i])); }
    seqs = jv_d();
    R = fg_lines("exec/parse2/librarycallables-result.tsv");
    for (i = 1; i < R.n; i++) {
        char *c[8], *line;
        Jv *acts;
        if (!R.l[i][0]) continue;
        line = fg_dupz(R.l[i]);
        if (fg_split(line, c, 8) < 5) fg_die("librarycallables-result row", R.l[i]);
        acts = jv_must_parse(c[4]);
        for (k = 0; k < acts->n; k++) {
            Jv *a = acts->v[k];
            const char *nm;
            if (a->t != JV_LIST || a->n < 2 || a->v[0]->t != JV_STR || !tx_eq(a->v[0]->s, "@", 4)) continue;
            nm = jv_str(a->v[1], "@ name");
            if (tx_prefix(nm, tx_len(nm, 1024), "out:", 4)) jd_puts(seqs, nm, nm + 4);
        }
    }
    d = jv_d();
    jd_put(d, "constants", lc);
    x = jv_d();
    jd_put(x, "uns1", jl_one(ei("UNS") + 1)); jd_put(x, "uns2", jl_one(ei("UNS") + 2));
    jd_put(x, "bool", jl_add(jv_l(), jd_must(bd, "BOOL"))); jd_put(x, "float", jl_add(jv_l(), jd_must(bd, "FLT")));
    jd_put(d, "classes", x);
    v = jv_l(); for (i = 0; i < seqs->n; i++) jl_add(v, jv_s(seqs->k[i]));
    jd_put(d, "text_names", v);
    v = jv_l(); for (i = 0; i < seqs->n; i++) { x = jv_d(); jd_puts(x, "name", seqs->k[i]); jd_put(x, "text", seqs->v[i]); jl_add(v, x); }
    jd_put(d, "text_rows", v);
    g2_sline(o, "callables", d);
    g2_sline(o, "lm_header_text", jd_must(g2.E, "HEADER"));
    g2_sline(o, "nomain_reason", g2_typed("exec/facts/k2-librarymodule-map.tsv", "mainreason"));
    g2_sline(o, "ret_text", g2_lit("libraryenv_ret"));
}

