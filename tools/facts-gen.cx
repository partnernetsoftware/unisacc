/* tools/facts-gen.cx -- native producers for exec/facts tables, moved out of exec/facts/export.py one
 * table at a time (zero-Python plan, plans/cx-layers.md).  A ported table names this tool as its writer
 * and lists it among its inputs in place of export.py; export.py no longer writes it.
 *
 *   sh ./unisacc.com tools/facts-gen.cx -- --check ROOT [TABLE...]
 *   sh ./unisacc.com tools/facts-gen.cx -- --write ROOT [TABLE...]
 *   sh ./unisacc.com tools/facts-gen.cx -- --compare-body ROOT TABLE   (transition: body equal to the
 *       committed table written by export.py; header lines are not compared)
 *
 * Tables: opt-gen (E4 START data and peep indices).
 * Exit 0 all equal / written, 1 a table differs (named), 2 usage or I/O.
 */
#pragma unisa use text.text
#pragma unisa use mem.arena
#define FG_CAP 65536
#define FG_MAXL 8192

static char fg_root[4096];
static int fg_ar;

typedef struct { char *p; long n, cap; } Ob;
static void fg_die(const char *a, const char *b) { fprintf(stderr, "facts-gen: %s%s%s\n", a, b ? ": " : "", b ? b : ""); exit(2); }
static void ob_put(Ob *o, const char *s, long n) {
    long i;
    if (o->n + n + 1 > o->cap) {
        long c = (o->n + n + 1) * 2 + 4096;
        char *t = ar_alloc(fg_ar, c);
        if (!t) fg_die("out of memory", 0);
        for (i = 0; i < o->n; i++) t[i] = o->p[i];
        o->p = t; o->cap = c;
    }
    for (i = 0; i < n; i++) o->p[o->n + i] = s[i];
    o->n += n;
    o->p[o->n] = 0;
}
static void ob_z(Ob *o, const char *s) { long n = tx_len(s, FG_CAP); if (n < 0) fg_die("string too long", 0); ob_put(o, s, n); }
static void ob_int(Ob *o, long v) { char b[32]; cx_fmt(b, sizeof b, "%ld", v); ob_z(o, b); }
static void ob_str(Ob *o, const char *s) {           /* json.dumps of an ASCII string */
    long i, n = tx_len(s, FG_CAP);
    ob_put(o, "\"", 1);
    for (i = 0; i < n; i++) {
        unsigned char c = (unsigned char)s[i];
        if (c == '"' || c == '\\') { ob_put(o, "\\", 1); ob_put(o, s + i, 1); }
        else if (c == '\n') ob_z(o, "\\n");
        else if (c == '\r') ob_z(o, "\\r");
        else if (c == '\t') ob_z(o, "\\t");
        else if (c == '\b') ob_z(o, "\\b");
        else if (c == '\f') ob_z(o, "\\f");
        else if (c < 0x20 || c > 0x7f) { char b[8]; cx_fmt(b, sizeof b, "\\u%04x", c); ob_z(o, b); }
        else ob_put(o, s + i, 1);
    }
    ob_put(o, "\"", 1);
}
/* Decodes the JSON string literal s[0..n) (quotes included) into a z-string in the arena; BMP \u
   escapes below 0x80 only (the fact tables are ASCII).  0 when s is not such a literal. */
static char *jstr(const char *s, long n) {
    char *out;
    long i, k = 0;
    if (n < 2 || s[0] != '"' || s[n - 1] != '"') return 0;
    out = ar_alloc(fg_ar, n);
    if (!out) return 0;
    for (i = 1; i < n - 1; i++) {
        char c = s[i];
        if (c != '\\') { out[k++] = c; continue; }
        if (++i >= n - 1) return 0;
        c = s[i];
        if (c == 'n') out[k++] = '\n'; else if (c == 't') out[k++] = '\t'; else if (c == 'r') out[k++] = '\r';
        else if (c == 'b') out[k++] = '\b'; else if (c == 'f') out[k++] = '\f';
        else if (c == '"' || c == '\\' || c == '/') out[k++] = c;
        else if (c == 'u' && i + 4 < n - 1) {
            int v = 0, d;
            for (d = 1; d <= 4; d++) { char h = s[i + d]; v = v * 16 + (h >= '0' && h <= '9' ? h - '0' : h >= 'a' && h <= 'f' ? h - 'a' + 10 : h >= 'A' && h <= 'F' ? h - 'A' + 10 : -999); }
            if (v < 1 || v > 0x7f) return 0;
            out[k++] = (char)v; i += 4;
        } else return 0;
    }
    out[k] = 0;
    return out;
}
/* Python's list(s.encode()) as JSON with the default ", " separator. */
static void ob_bytes_list(Ob *o, const char *s) {
    long i, n = tx_len(s, FG_CAP);
    ob_z(o, "[");
    for (i = 0; i < n; i++) { if (i) ob_z(o, ", "); ob_int(o, (unsigned char)s[i]); }
    ob_z(o, "]");
}

/* Lines of a file, split in place; lines[] point into an arena copy. */
typedef struct { char **l; int n; char *raw; long rawn; } Lines;
static Lines fg_lines(const char *rel) {
    char path[4400];
    size_t n;
    char *b, *copy, *p, *end;
    Lines L;
    L.n = 0;
    if (cx_fmt(path, sizeof path, "%s/%s", fg_root, rel)) fg_die("path too long", rel);
    b = cx_read(path, &n);
    if (!b) fg_die("cannot read", path);
    L.raw = b; L.rawn = (long)n;
    copy = ar_dup(fg_ar, b, (long)n);
    L.l = ar_alloc(fg_ar, (long)sizeof(char *) * ((long)n + 2));
    if (!copy || !L.l) fg_die("out of memory", 0);
    for (p = copy, end = copy + n; p < end; ) {
        long off = tx_chr(p, (long)(end - p), '\n');
        if (off < 0) off = (long)(end - p);
        p[off] = 0;
        L.l[L.n++] = p;
        p += off + 1;
    }
    return L;
}
static int fg_split(char *s, char **out, int cap) {
    int n = 0;
    char *p = s;
    for (;;) {
        if (n == cap) return -1;
        out[n++] = p;
        while (*p && *p != '\t') p++;
        if (!*p) return n;
        *p++ = 0;
    }
}
static char *fg_dupz(const char *s) { long n = tx_len(s, FG_CAP); char *p = n < 0 ? 0 : ar_dup(fg_ar, s, n); if (!p) fg_die("out of memory", 0); return p; }

typedef struct { int n; char *v[FG_MAXL]; } List;
static int list_index(const List *l, const char *x) { int i; for (i = 0; i < l->n; i++) if (tx_eq(l->v[i], x, FG_CAP)) return i; return -1; }

/* gold(name) of export.py: rows of weights/gold/NAME.tsv not starting with '#' whose cells do not
   include the cell "=>" (the column line's cells are "=> head", so it is kept, as in Python). */
typedef struct { int n; int nc[FG_MAXL * 4]; char **c[FG_MAXL * 4]; } Rows;
static void fg_gold(const char *name, Rows *R, List *fields, const char *(*want)[2], int nwant) {
    char rel[256];
    Lines L;
    int i, k, w;
    cx_fmt(rel, sizeof rel, "weights/gold/%s.tsv", name);
    L = fg_lines(rel);
    R->n = 0;
    for (i = 0; i < L.n; i++) {
        char *cells[FG_MAXL + 4];
        char *line = fg_dupz(L.l[i]);
        int nc, arrow = 0;
        if (!*L.l[i]) continue;
        nc = fg_split(line, cells, FG_MAXL + 4);
        if (nc < 0) fg_die("too many cells", rel);
        if (L.l[i][0] == '#') {
            if (nc >= 2 && (tx_eq(cells[0], "#field", 8) || tx_eq(cells[0], "#head", 8)))
                for (w = 0; w < nwant; w++) if (tx_eq(cells[1], want[w][0], FG_CAP)) {
                    List *dst = &fields[w];
                    dst->n = 0;
                    for (k = 2; k < nc; k++) dst->v[dst->n++] = cells[k];
                }
            continue;
        }
        for (k = 0; k < nc; k++) if (tx_eq(cells[k], "=>", 4)) arrow = 1;
        if (arrow) continue;
        R->c[R->n] = ar_alloc(fg_ar, (long)sizeof(char *) * nc);
        if (!R->c[R->n]) fg_die("out of memory", 0);
        for (k = 0; k < nc; k++) R->c[R->n][k] = cells[k];
        R->nc[R->n++] = nc;
    }
}

/* facts(stem) for a two-column name/value table of integers, and a single-column value table of
   JSON strings (no escapes), as exec/facts/load.py reads them. */
static long fg_const(const char *stem, const char *name) {
    char rel[256];
    Lines L;
    int i;
    cx_fmt(rel, sizeof rel, "exec/facts/%s.tsv", stem);
    L = fg_lines(rel);
    for (i = 1; i < L.n; i++) {
        char *cells[4], *line = fg_dupz(L.l[i]), *end;
        long v;
        if (!*line || line[0] == '#') continue;
        if (fg_split(line, cells, 4) != 2) continue;
        if (!tx_eq(cells[0], name, FG_CAP)) continue;
        v = strtol(cells[1], &end, 10);
        if (end == cells[1] || *end) fg_die("constant is not an integer", name);
        return v;
    }
    fg_die("constant absent", name);
    return 0;
}
static int fg_values(const char *stem, char **out, int cap) {
    char rel[256];
    Lines L;
    int i, n = 0;
    cx_fmt(rel, sizeof rel, "exec/facts/%s.tsv", stem);
    L = fg_lines(rel);
    for (i = 1; i < L.n; i++) {
        char *s = L.l[i];
        long len = tx_len(s, FG_CAP);
        if (!*s || s[0] == '#') continue;
        if (len < 2 || s[0] != '"' || s[len - 1] != '"' || tx_chr(s, len, '\\') >= 0 || n == cap) fg_die("value is not a plain JSON string", stem);
        out[n++] = ar_dup(fg_ar, s + 1, len - 2);
    }
    return n;
}

static void opt_gen(Ob *o) {
    static List F[4];
    static const char *want[4][2] = {{"a", 0}, {"b", 0}, {"rel", 0}, {"y", 0}};
    static Rows peep, opinfo;
    static List dummy[1];
    static const char *none[1][2] = {{"", 0}};
    List *PA = &F[0], *PB = &F[1], *PR = &F[2], *PY = &F[3];
    char *words[256];
    int nwords, i, npeep = 0, nopinfo = 0, nsimple = 0;
    long PEEPB = fg_const("opt-gen-constants", "PEEPB"), ACLSB = fg_const("opt-gen-constants", "ACLSB"),
         BCLSB = fg_const("opt-gen-constants", "BCLSB"), SIMPLE = fg_const("opt-gen-constants", "SIMPLE");
    fg_gold("peep", &peep, F, want, 4);
    fg_gold("opinfo", &opinfo, dummy, none, 0);
    nwords = fg_values("opt-gen-startwords", words, 256);
    /* =startwords */
    ob_z(o, "=startwords\tjson\t[");
    for (i = 0; i < nwords; i++) {
        long a = 0, b = tx_len(words[i], FG_CAP);
        char reg[512];
        while (a < b && words[i][a] == '.') a++;
        while (b > a && words[i][b - 1] == '.') b--;
        ob_z(o, i ? ", {\"i\": " : "{\"i\": "); ob_int(o, i);
        ob_z(o, ", \"word\": "); ob_str(o, words[i]);
        cx_fmt(reg, sizeof reg, "id_%.*s", (int)(b - a), words[i] + a);
        ob_z(o, ", \"register\": "); ob_str(o, reg); ob_z(o, "}");
    }
    ob_z(o, "]\n");
    /* =peepinit */
    ob_z(o, "=peepinit\tjson\t[");
    for (i = 0; i < peep.n; i++) {
        char **f = peep.c[i];
        int a, b, r, y;
        if (peep.nc[i] != 4) continue;
        a = list_index(PA, f[0]); b = list_index(PB, f[1]); r = list_index(PR, f[2]); y = list_index(PY, f[3]);
        if (a < 0 || b < 0 || r < 0 || y < 0) continue;
        ob_z(o, npeep ? ", {\"i\": " : "{\"i\": "); ob_int(o, npeep);
        ob_z(o, ", \"index\": "); ob_int(o, ((long)a * PB->n + b) * PR->n + r);
        ob_z(o, ", \"value\": "); ob_int(o, y + 1);
        ob_z(o, ", \"bank\": "); ob_int(o, PEEPB); ob_z(o, "}");
        npeep++;
    }
    ob_z(o, "]\n");
    /* =opinfoinit */
    ob_z(o, "=opinfoinit\tjson\t[");
    for (i = 0; i < opinfo.n; i++) {
        char **f = opinfo.c[i];
        int a, b;
        if (opinfo.nc[i] != 4) continue;
        a = list_index(PA, f[2]); b = list_index(PB, f[3]);
        ob_z(o, nopinfo ? ", {\"i\": " : "{\"i\": "); ob_int(o, nopinfo);
        ob_z(o, ", \"word\": "); ob_str(o, f[0]);
        ob_z(o, ", \"has_a\": "); ob_str(o, a >= 0 ? "yes" : "no");
        ob_z(o, ", \"a_value\": "); ob_int(o, a >= 0 ? a + 1 : 0);
        ob_z(o, ", \"a_bank\": "); ob_int(o, ACLSB);
        ob_z(o, ", \"has_b\": "); ob_str(o, b >= 0 ? "yes" : "no");
        ob_z(o, ", \"b_value\": "); ob_int(o, b >= 0 ? b + 1 : 0);
        ob_z(o, ", \"b_bank\": "); ob_int(o, BCLSB); ob_z(o, "}");
        nopinfo++;
    }
    ob_z(o, "]\n");
    /* =simplewords */
    ob_z(o, "=simplewords\tjson\t[");
    for (i = 0; i < opinfo.n; i++) {
        char **f = opinfo.c[i];
        if (opinfo.nc[i] < 2 || !tx_eq(f[1], "1", 4)) continue;
        ob_z(o, nsimple ? ", {\"i\": " : "{\"i\": "); ob_int(o, nsimple);
        ob_z(o, ", \"word\": "); ob_str(o, f[0]);
        ob_z(o, ", \"bank\": "); ob_int(o, SIMPLE); ob_z(o, "}");
        nsimple++;
    }
    ob_z(o, "]\n");
    /* =startplans */
    {
        int plan, first, k;
        ob_z(o, "=startplans\tjson\t[");
        for (plan = 1; plan <= 2; plan++) {
            char ref[64];
            first = 1;
            ob_z(o, plan == 1 ? "{\"name\": \"start1\", \"refs\": [" : ", {\"name\": \"start2\", \"refs\": [");
            for (k = 0; k < nwords; k++) { cx_fmt(ref, sizeof ref, "word_%d", k); if (!first) ob_z(o, ", "); ob_str(o, ref); first = 0; }
            if (plan == 2) {
                for (k = 0; k < npeep; k++) { cx_fmt(ref, sizeof ref, "peep_%d", k); if (!first) ob_z(o, ", "); ob_str(o, ref); first = 0; }
                for (k = 0; k < nopinfo; k++) { cx_fmt(ref, sizeof ref, "opinfo_%d", k); if (!first) ob_z(o, ", "); ob_str(o, ref); first = 0; }
            }
            for (k = 0; k < nsimple; k++) { cx_fmt(ref, sizeof ref, "simple_%d", k); if (!first) ob_z(o, ", "); ob_str(o, ref); first = 0; }
            ob_z(o, "]}");
        }
        ob_z(o, "]\n");
    }
    /* =peepidx */
    {
        const List *L3[3] = {PA, PB, PR};
        const char *pre[3] = {"PA_", "PB_", "PR_"};
        int g, k, first = 1;
        char key[512];
        ob_z(o, "=peepidx\tjson\t{");
        for (g = 0; g < 3; g++)
            for (k = 0; k < L3[g]->n; k++) {
                cx_fmt(key, sizeof key, "%s%s", pre[g], L3[g]->v[k]);
                if (!first) ob_z(o, ", ");
                ob_str(o, key); ob_z(o, ": "); ob_int(o, k); first = 0;
            }
        ob_z(o, ", \"PB_size\": "); ob_int(o, PB->n);
        ob_z(o, ", \"PR_size\": "); ob_int(o, PR->n);
        ob_z(o, "}\n");
    }
    /* =Y: answer-targets name -> template, "*" the default, "{name}" replaced */
    {
        Lines T = fg_lines("exec/opt/answer-targets.tsv");
        char *tn[256], *tv[256];
        int nt = 0, k, star = -1;
        for (k = 0; k < T.n; k++) {
            char *cells[4], *line = fg_dupz(T.l[k]);
            if (!*line || line[0] == '#') continue;
            if (fg_split(line, cells, 4) != 2 || nt == 256) fg_die("bad answer-targets row", T.l[k]);
            tn[nt] = cells[0]; tv[nt] = cells[1];
            if (tx_eq(cells[0], "*", 4)) star = nt;
            nt++;
        }
        if (star < 0) fg_die("answer-targets lacks *", 0);
        ob_z(o, "=Y\tjson\t[");
        for (i = 0; i < PY->n; i++) {
            const char *t = tv[star];
            char out[1024];
            long at = 0, j, tl, hole;
            for (k = 0; k < nt; k++) if (tx_eq(tn[k], PY->v[i], FG_CAP)) { t = tv[k]; break; }
            tl = tx_len(t, FG_CAP);
            hole = tx_find(t, tl, "{name}", 6);
            for (j = 0; j < tl && at < 1000; ) {
                if (j == hole) { long m = tx_len(PY->v[i], 512); if (tx_copy(out + at, 1024 - at, PY->v[i], m)) fg_die("target too long", 0); at += m; j += 6; }
                else out[at++] = t[j++];
            }
            out[at] = 0;
            ob_z(o, i ? ", {\"i\": " : "{\"i\": "); ob_int(o, i);
            ob_z(o, ", \"target\": "); ob_str(o, out); ob_z(o, "}");
        }
        ob_z(o, "]\n");
    }
}

/* Two-column rows (KEY<TAB>VALUE) of a table, header line skipped, '#' lines skipped; values raw. */
static int fg_pairs(const char *rel, char **k, char **v, int cap) {
    Lines L = fg_lines(rel);
    int i, n = 0;
    for (i = 1; i < L.n; i++) {
        char *cells[4], *line = fg_dupz(L.l[i]);
        if (!*line || line[0] == '#') continue;
        if (fg_split(line, cells, 4) != 2 || n == cap) fg_die("not a two-column row", L.l[i]);
        k[n] = cells[0]; v[n] = cells[1]; n++;
    }
    return n;
}
static char *fg_pair(char **k, char **v, int n, const char *key) {
    int i;
    for (i = 0; i < n; i++) if (tx_eq(k[i], key, FG_CAP)) return v[i];
    fg_die("key absent", key);
    return 0;
}

/* parse-tokens: words = words_pre + casops+"=" + sorted(prec operators with a digit level) + words_post;
   TK maps each word to its last 1-based position (first-occurrence order), then "type" = TK["type=int"]. */
typedef struct {
    char *w[1024]; int nw;                   /* WORDS */
    char *tkn[1024]; int tkv[1024]; int ntk; /* TK in insertion order, "type" last */
    char *prec[256]; int plev[256]; int np;  /* gold prec operators with a digit level, byte-sorted */
} Tok;
static Tok pt;
static int pt_ready;
static int pt_tk(const char *name) {
    int i;
    for (i = 0; i < pt.ntk; i++) if (tx_eq(pt.tkn[i], name, FG_CAP)) return pt.tkv[i];
    fg_die("no TK entry", name);
    return 0;
}
static void pt_build(void) {
    static char *k[512], *v[512];
    char **w = pt.w, **prec = pt.prec;
    int n, nw = 0, np = 0, i, j, g, *plev = pt.plev;
    if (pt_ready) return;
    pt_ready = 1;
    n = fg_pairs("exec/facts/parse-words.tsv", k, v, 512);
    static const char *groups[3] = {"words_pre", "casops", "words_post"};
    Rows P;
    static List none[1];
    static const char *nowant[1][2] = {{"", 0}};
    fg_gold("prec", &P, none, nowant, 0);
    for (i = 0; i < P.n; i++) {                   /* the later _gold: drop lines containing "=>" */
        char *lvl;
        long m;
        if (P.nc[i] < 2) continue;
        lvl = P.c[i][1];
        m = tx_len(lvl, 64);
        if (m < 1) continue;
        for (j = 0; j < m; j++) if (lvl[j] < '0' || lvl[j] > '9') break;
        if (j < m) continue;
        for (j = 0; j < np; j++) if (tx_eq(prec[j], P.c[i][0], FG_CAP)) break;
        if (j == np) { prec[np] = P.c[i][0]; plev[np] = (int)strtol(lvl, 0, 10); np++; }
        else plev[j] = (int)strtol(lvl, 0, 10);   /* dict: the last row's level wins */
    }
    for (i = 1; i < np; i++) {                    /* sorted(): byte order, insertion sort */
        char *x = prec[i];
        int xl = plev[i];
        for (j = i - 1; j >= 0; j--) {
            long a = tx_len(prec[j], FG_CAP), b = tx_len(x, FG_CAP), m = a < b ? a : b, q;
            int gt = 0;
            for (q = 0; q < m && prec[j][q] == x[q]; q++) ;
            gt = q < m ? (unsigned char)prec[j][q] > (unsigned char)x[q] : a > b;
            if (!gt) break;
            prec[j + 1] = prec[j]; plev[j + 1] = plev[j];
        }
        prec[j + 1] = x; plev[j + 1] = xl;
    }
    pt.np = np;
    for (g = 0; g < 3; g++) {
        if (g == 2) for (j = 0; j < np; j++) w[nw++] = prec[j];
        for (i = 0; i < n; i++) {
            char *s;
            if (!tx_eq(k[i], groups[g], FG_CAP)) continue;
            s = jstr(v[i], tx_len(v[i], FG_CAP));
            if (!s) fg_die("parse-words value is not a JSON string", v[i]);
            if (g == 1) { char *t = ar_alloc(fg_ar, tx_len(s, FG_CAP) + 2); cx_fmt(t, (size_t)tx_len(s, FG_CAP) + 2, "%s=", s); s = t; }
            w[nw++] = s;
        }
    }
    pt.nw = nw;
    {
        int tint = -1;
        for (i = 0; i < nw; i++) {
            int last = i;
            for (j = 0; j < i; j++) if (tx_eq(w[j], w[i], FG_CAP)) break;
            if (j < i) continue;                  /* not the first occurrence */
            for (j = i + 1; j < nw; j++) if (tx_eq(w[j], w[i], FG_CAP)) last = j;
            if (tx_eq(w[i], "type", 8)) fg_die("a word named type exists; its TK position would be reused", 0);
            pt.tkn[pt.ntk] = w[i]; pt.tkv[pt.ntk++] = last + 1;
            if (tx_eq(w[i], "type=int", 16)) tint = last + 1;
        }
        if (tint < 0) fg_die("no type=int word", 0);
        pt.tkn[pt.ntk] = "type"; pt.tkv[pt.ntk++] = tint;
    }
}
static void parse_tokens(Ob *o) {
    int i;
    pt_build();
    ob_z(o, "=WORDS\tjson\t[");
    for (i = 0; i < pt.nw; i++) { if (i) ob_z(o, ","); ob_str(o, pt.w[i]); }
    ob_z(o, "]\n=TK\tjson\t{");
    for (i = 0; i < pt.ntk; i++) { if (i) ob_z(o, ","); ob_str(o, pt.tkn[i]); ob_z(o, ":"); ob_int(o, pt.tkv[i]); }
    ob_z(o, "}\n");
}

/* structreturnexpr: the struct-return refusal entry (LOC from parse-constants). */
static void struct_return_expr(Ob *o) {
    const char *reason = "not covered: struct return expression outside local lvalue";
    ob_z(o, "=reason\tstr\t"); ob_z(o, reason);
    ob_z(o, "\n@sr\tentry:str\tloc:int\treason:str\n\tLI.original.structreturn\t");
    ob_int(o, fg_const("parse-constants", "LOC")); ob_z(o, "\t"); ob_z(o, reason); ob_z(o, "\n");
}

/* k2-constexpr: integer-expression precedence levels and token classes for the E3 table. */
static void k2_constexpr(Ob *o) {
    static char *opn[256], *opc[256][5];
    static char *cn[64], *ct[64];
    int levels[64], nl = 0, nop = 0, ncl = 0, i, j, l;
    Lines L;
    pt_build();
    for (i = 0; i < pt.np; i++) {                 /* sorted(set(levels)) */
        for (j = 0; j < nl; j++) if (levels[j] == pt.plev[i]) break;
        if (j == nl) levels[nl++] = pt.plev[i];
    }
    for (i = 1; i < nl; i++) { int x = levels[i]; for (j = i - 1; j >= 0 && levels[j] > x; j--) levels[j + 1] = levels[j]; levels[j + 1] = x; }
    L = fg_lines("exec/parse2/constexpr-operators.tsv");
    for (i = 1; i < L.n; i++) {
        char *cells[8], *line = fg_dupz(L.l[i]);
        if (!*line) continue;
        if (fg_split(line, cells, 8) != 6 || nop == 256) fg_die("bad constexpr-operators row", L.l[i]);
        opn[nop] = cells[0];
        for (j = 0; j < 5; j++) opc[nop][j] = cells[j + 1];
        nop++;
    }
    ob_z(o, "=levels\tjson\t[");
    for (l = 0; l < nl; l++) {
        int first = 1;
        if (l) ob_z(o, ",");
        ob_z(o, "{\"level\":"); ob_int(o, levels[l]); ob_z(o, ",\"next\":");
        if (l + 1 < nl) ob_int(o, levels[l + 1]); else ob_str(o, ".atom");
        ob_z(o, ",\"ops\":[");
        for (i = 0; i < pt.np; i++) {             /* pt.prec is already byte-sorted */
            int x;
            char **c;
            if (pt.plev[i] != levels[l]) continue;
            for (x = 0; x < nop; x++) if (tx_eq(opn[x], pt.prec[i], FG_CAP)) break;
            if (x == nop) fg_die("operator missing from constexpr-operators", pt.prec[i]);
            c = opc[x];
            if (!first) ob_z(o, ",");
            first = 0;
            ob_z(o, "{\"k\":"); ob_int(o, pt_tk(pt.prec[i]));
            ob_z(o, ",\"name\":"); ob_str(o, pt.prec[i]);
            ob_z(o, ",\"category\":"); ob_str(o, c[0]);
            ob_z(o, ",\"action\":"); ob_str(o, c[1]);
            ob_z(o, ",\"comparison\":[");
            if (!tx_eq(c[2], "-", 4)) {
                long cl = tx_len(c[2], FG_CAP), q, firstn = 1;
                for (q = 0; q < cl; ) {
                    long e = tx_chr(c[2] + q, cl - q, ',');
                    char num[32];
                    if (e < 0) e = cl - q;
                    if (tx_copy(num, sizeof num, c[2] + q, e)) fg_die("bad comparison", c[2]);
                    if (!firstn) ob_z(o, ",");
                    ob_int(o, strtol(num, 0, 10)); firstn = 0;
                    q += e + 1;
                }
            }
            ob_z(o, "],\"zero\":"); ob_str(o, c[3]);
            ob_z(o, ",\"nonzero\":"); ob_str(o, c[4]); ob_z(o, "}");
        }
        ob_z(o, "]}");
    }
    ob_z(o, "]\n");
    {   /* tokens = TK + identifier/number/string, then type=extern/_Bool after max(TK) */
        static char *tn[1100];
        static int tv[1100];
        int nt = 0, mx = 0, typeword[1100], ntw = 0;
        const char *extra[3][2] = {{"identifier", "TK_ID"}, {"number", "TK_NUM"}, {"string", "TK_STR"}};
        for (i = 0; i < pt.ntk; i++) { tn[nt] = pt.tkn[i]; tv[nt++] = pt.tkv[i]; if (pt.tkv[i] > mx) mx = pt.tkv[i]; }
        for (i = 0; i < 3; i++) {
            long v = fg_const("parse-constants", extra[i][1]);
            for (j = 0; j < nt; j++) if (tx_eq(tn[j], extra[i][0], FG_CAP)) break;
            if (j == nt) { tn[nt] = (char *)extra[i][0]; tv[nt++] = (int)v; } else tv[j] = (int)v;
        }
        tn[nt] = "type=extern"; tv[nt++] = mx + 1;
        tn[nt] = "type=_Bool"; tv[nt++] = mx + 2;
        L = fg_lines("exec/parse2/constexpr-tokens.tsv");
        for (i = 1; i < L.n; i++) {
            char *cells[4], *line = fg_dupz(L.l[i]);
            if (!*line) continue;
            if (fg_split(line, cells, 4) != 2 || ncl == 64) fg_die("bad constexpr-tokens row", L.l[i]);
            cn[ncl] = cells[0]; ct[ncl++] = cells[1];
        }
        ob_z(o, "=classes\tjson\t{");
        for (i = 0; i < ncl; i++) {
            int v = -1;
            for (j = 0; j < nt; j++) if (tx_eq(tn[j], ct[i], FG_CAP)) v = tv[j];
            if (v < 0) fg_die("constexpr token without a code", ct[i]);
            if (i) ob_z(o, ",");
            ob_str(o, cn[i]); ob_z(o, ":["); ob_int(o, v); ob_z(o, "]");
        }
        for (j = 0; j < nt; j++) {
            int keep = tx_prefix(tn[j], tx_len(tn[j], FG_CAP), "type", 4) || tx_eq(tn[j], "struct", 8) || tx_eq(tn[j], "union", 8) || tx_eq(tn[j], "enum", 8), q;
            if (!keep) continue;
            for (q = 0; q < ntw; q++) if (typeword[q] == tv[j]) break;
            if (q == ntw) typeword[ntw++] = tv[j];
        }
        for (i = 1; i < ntw; i++) { int x = typeword[i]; for (j = i - 1; j >= 0 && typeword[j] > x; j--) typeword[j + 1] = typeword[j]; typeword[j + 1] = x; }
        ob_z(o, ncl ? ",\"typeword\":[" : "\"typeword\":[");
        for (i = 0; i < ntw; i++) { if (i) ob_z(o, ","); ob_int(o, typeword[i]); }
        ob_z(o, "]}\n=SKIPS\tint\t");
        ob_int(o, 7L * (1L << 26)); ob_z(o, "\n");
    }
}

/* k2-tokenlocations-map: MAP_FIELDS (a JSON list of plain strings) as [{"i":i,"register":"diag_NAME"}]. */
static void tokenlocations_map(Ob *o) {
    static char *k[64], *v[64];
    int n = fg_pairs("exec/facts/tokenlocations.tsv", k, v, 64), i = 0, first = 1;
    char *s = fg_pair(k, v, n, "MAP_FIELDS");
    long len = tx_len(s, FG_CAP), at = 1;
    if (len < 2 || s[0] != '[' || s[len - 1] != ']') fg_die("MAP_FIELDS is not a list", s);
    ob_z(o, "=mapfields\tjson\t[");
    while (at < len - 1) {
        long q;
        char *name, reg[512];
        while (at < len - 1 && (s[at] == ' ' || s[at] == ',')) at++;
        if (at >= len - 1) break;
        if (s[at] != '"') fg_die("MAP_FIELDS item is not a string", s);
        q = tx_chr(s + at + 1, len - at - 1, '"');
        if (q < 0) fg_die("unterminated MAP_FIELDS string", s);
        name = jstr(s + at, q + 2);
        if (!name) fg_die("bad MAP_FIELDS string", s);
        {   /* names must be distinct */
            static char *seen[256];
            int j;
            for (j = 0; j < i; j++) if (tx_eq(seen[j], name, FG_CAP)) fg_die("MAP_FIELDS repeats", name);
            if (i == 256) fg_die("too many MAP_FIELDS", 0);
            seen[i] = name;
        }
        cx_fmt(reg, sizeof reg, "diag_%s", name);
        ob_z(o, first ? "{\"i\":" : ",{\"i\":"); ob_int(o, i++); ob_z(o, ",\"register\":"); ob_str(o, reg); ob_z(o, "}");
        first = 0;
        at += q + 2;
    }
    if (!i) fg_die("MAP_FIELDS is empty", 0);
    ob_z(o, "]\n");
}

/* top-modelbindings-template: the USBIND magic chain, identifier byte classes and record kinds. */
static void modelbindings_template(Ob *o) {
    static char *k[64], *v[64];
    int n = fg_pairs("exec/facts/top-modelbindings-const.tsv", k, v, 64), i;
    char *magic = jstr(fg_pair(k, v, n, "magic"), tx_len(fg_pair(k, v, n, "magic"), FG_CAP));
    char *letters = jstr(fg_pair(k, v, n, "letters"), tx_len(fg_pair(k, v, n, "letters"), FG_CAP));
    char *digits = jstr(fg_pair(k, v, n, "digits"), tx_len(fg_pair(k, v, n, "digits"), FG_CAP));
    char *kind = fg_pair(k, v, n, "kind"), all[512];
    long m;
    if (!magic || !letters || !digits) fg_die("bad modelbindings constant", 0);
    ob_z(o, "@magic\ti:int\tc:int\tnext:int\n");
    m = tx_len(magic, FG_CAP);
    for (i = 0; i < m; i++) { ob_z(o, "\t"); ob_int(o, i); ob_z(o, "\t"); ob_int(o, (unsigned char)magic[i]); ob_z(o, "\t"); ob_int(o, i + 1); ob_z(o, "\n"); }
    ob_z(o, "@id\tletters:json\tdigits:json\tall:json\n\t");
    ob_bytes_list(o, letters); ob_z(o, "\t"); ob_bytes_list(o, digits); ob_z(o, "\t");
    cx_fmt(all, sizeof all, "%s%s", letters, digits);
    ob_bytes_list(o, all); ob_z(o, "\n");
    {   /* json.dumps of a list of small integers: normalise separators to ", " */
        long kl = tx_len(kind, FG_CAP), j;
        int sep = 0;
        if (kl < 2 || kind[0] != '[' || kind[kl - 1] != ']') fg_die("kind is not a list", kind);
        ob_z(o, "=kind\tjson\t[");
        for (j = 1; j < kl - 1; j++) {
            if (kind[j] == ' ') continue;
            if (kind[j] == ',') { sep = 1; continue; }
            if (kind[j] < '0' || kind[j] > '9') fg_die("kind is not a list of integers", kind);
            if (sep) { ob_z(o, ", "); sep = 0; }
            ob_put(o, kind + j, 1);
        }
        ob_z(o, "]\n");
    }
}

typedef struct { const char *stem; const char *inputs[8]; void (*produce)(Ob *); } Table;
static const Table fg_tables[] = {
    {"opt-gen", {"weights/gold/peep.tsv", "weights/gold/opinfo.tsv", "exec/facts/opt-gen-constants.tsv",
                 "exec/facts/opt-gen-startwords.tsv", "exec/opt/answer-targets.tsv", "tools/facts-gen.cx", 0}, opt_gen},
    {"parse-tokens", {"exec/facts/parse-words.tsv", "weights/gold/prec.tsv", "tools/facts-gen.cx", 0}, parse_tokens},
    {"top-modelbindings-template", {"exec/facts/top-modelbindings-const.tsv", "tools/facts-gen.cx", 0}, modelbindings_template},
    {"k2-tokenlocations-map", {"exec/facts/tokenlocations.tsv", "tools/facts-gen.cx", 0}, tokenlocations_map},
    {"structreturnexpr", {"exec/facts/parse-constants.tsv", "tools/facts-gen.cx", 0}, struct_return_expr},
    {"k2-constexpr", {"exec/facts/parse-words.tsv", "weights/gold/prec.tsv", "exec/facts/parse-constants.tsv",
                      "exec/parse2/constexpr-operators.tsv", "exec/parse2/constexpr-tokens.tsv", "tools/facts-gen.cx", 0}, k2_constexpr},
    {0, {0}, 0}
};

static void fg_render(const Table *t, Ob *head, Ob *body) {
    int i;
    ob_z(head, "# exec/facts/"); ob_z(head, t->stem); ob_z(head, ".tsv: written by tools/facts-gen.cx, do not edit\n");
    for (i = 0; t->inputs[i]; i++) {
        char path[4400], hex[65];
        size_t n;
        char *b;
        cx_fmt(path, sizeof path, "%s/%s", fg_root, t->inputs[i]);
        b = cx_read(path, &n);
        if (!b) fg_die("cannot read input", path);
        cx_sha256_hex(b, n, hex);
        ob_z(head, "# input "); ob_z(head, t->inputs[i]); ob_z(head, " sha256:"); ob_put(head, hex, 16); ob_z(head, "\n");
    }
    t->produce(body);
}

static long fg_body_start(const char *s, long n) {       /* offset of the first line not starting with '#' */
    long at = 0;
    while (at < n && s[at] == '#') { long off = tx_chr(s + at, n - at, '\n'); if (off < 0) return n; at += off + 1; }
    return at;
}

static int fg_one(const Table *t, int mode) {   /* mode 0 check, 1 write, 2 compare-body */
    Ob head = {0, 0, 0}, body = {0, 0, 0};
    char path[4400];
    size_t n;
    char *cur;
    fg_render(t, &head, &body);
    cx_fmt(path, sizeof path, "%s/exec/facts/%s.tsv", fg_root, t->stem);
    if (mode == 1) {
        Ob all = {0, 0, 0};
        ob_put(&all, head.p, head.n); ob_put(&all, body.p, body.n);
        if (cx_write(path, all.p, (size_t)all.n)) fg_die("cannot write", path);
        printf("WROTE\t%s\n", t->stem);
        return 0;
    }
    cur = cx_read(path, &n);
    if (!cur) fg_die("cannot read", path);
    if (mode == 2) {
        long b = fg_body_start(cur, (long)n);
        int same = tx_same(cur + b, (long)n - b, body.p, body.n);
        printf("%s\t%s\tbody\n", same ? "SAME" : "DIFF", t->stem);
        return !same;
    }
    {
        int same = (long)n == head.n + body.n && tx_same(cur, head.n, head.p, head.n) && tx_same(cur + head.n, body.n, body.p, body.n);
        printf("%s\t%s\n", same ? "SAME" : "DIFF", t->stem);
        return !same;
    }
}

int main(int argc, char **argv) {
    int mode, i, k, bad = 0;
    fg_ar = ar_new(1L << 32);
    if (!fg_ar) fg_die("cannot create the arena", 0);
    if (argc < 3) fg_die("usage", "--check|--write|--compare-body ROOT [TABLE...]");
    if (tx_eq(argv[1], "--check", 16)) mode = 0;
    else if (tx_eq(argv[1], "--write", 16)) mode = 1;
    else if (tx_eq(argv[1], "--compare-body", 16)) mode = 2;
    else fg_die("usage", "--check|--write|--compare-body ROOT [TABLE...]");
    if (!realpath(argv[2], fg_root)) fg_die("bad ROOT", argv[2]);
    for (i = 0; fg_tables[i].stem; i++) {
        int pick = argc == 3;
        for (k = 3; k < argc; k++) if (tx_eq(argv[k], fg_tables[i].stem, 256)) pick = 1;
        if (pick) bad |= fg_one(&fg_tables[i], mode);
    }
    return bad;
}
