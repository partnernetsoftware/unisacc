/* tools/facts-gen.cx -- native producers for exec/facts tables, moved out of exec/facts/export.py one
 * table at a time (zero-Python plan, plans/cx-layers.md).  A ported table names this tool as its writer
 * and lists it among its inputs in place of export.py; export.py no longer writes it.
 *
 *   sh ./unisacc.com tools/facts-gen.cx -- --check ROOT [TABLE...]
 *   sh ./unisacc.com tools/facts-gen.cx -- --write ROOT [TABLE...]
 *   sh ./unisacc.com tools/facts-gen.cx -- --compare-body ROOT TABLE   (transition: body equal to the
 *       committed table written by export.py; header lines are not compared)
 *
 * Tables: opt-gen (E4 START data and peep indices).
 * Exit 0 all equal / written, 1 a table differs (named), 2 usage or I/O.
 */
#pragma unisa use text.text
#pragma unisa use mem.arena
#define FG_CAP 65536
#define FG_MAXL 8192

static char fg_root[4096];
static int fg_ar;

typedef struct { char *p; long n, cap; } Ob;
static void fg_die(const char *a, const char *b) { fprintf(stderr, "facts-gen: %s%s%s\n", a, b ? ": " : "", b ? b : ""); exit(2); }
static void ob_put(Ob *o, const char *s, long n) {
    long i;
    if (o->n + n + 1 > o->cap) {
        long c = (o->n + n + 1) * 2 + 4096;
        char *t = ar_alloc(fg_ar, c);
        if (!t) fg_die("out of memory", 0);
        for (i = 0; i < o->n; i++) t[i] = o->p[i];
        o->p = t; o->cap = c;
    }
    for (i = 0; i < n; i++) o->p[o->n + i] = s[i];
    o->n += n;
    o->p[o->n] = 0;
}
static void ob_z(Ob *o, const char *s) { long n = tx_len(s, FG_CAP); if (n < 0) fg_die("string too long", 0); ob_put(o, s, n); }
static void ob_int(Ob *o, long v) { char b[32]; cx_fmt(b, sizeof b, "%ld", v); ob_z(o, b); }
static void ob_str(Ob *o, const char *s) {           /* json.dumps of an ASCII string */
    long i, n = tx_len(s, FG_CAP);
    ob_put(o, "\"", 1);
    for (i = 0; i < n; i++) {
        unsigned char c = (unsigned char)s[i];
        if (c == '"' || c == '\\') { ob_put(o, "\\", 1); ob_put(o, s + i, 1); }
        else if (c == '\n') ob_z(o, "\\n");
        else if (c == '\r') ob_z(o, "\\r");
        else if (c == '\t') ob_z(o, "\\t");
        else if (c == '\b') ob_z(o, "\\b");
        else if (c == '\f') ob_z(o, "\\f");
        else if (c < 0x20 || c > 0x7f) { char b[8]; cx_fmt(b, sizeof b, "\\u%04x", c); ob_z(o, b); }
        else ob_put(o, s + i, 1);
    }
    ob_put(o, "\"", 1);
}
/* Decodes the JSON string literal s[0..n) (quotes included) into a z-string in the arena; BMP \u
   escapes below 0x80 only (the fact tables are ASCII).  0 when s is not such a literal. */
static char *jstr(const char *s, long n) {
    char *out;
    long i, k = 0;
    if (n < 2 || s[0] != '"' || s[n - 1] != '"') return 0;
    out = ar_alloc(fg_ar, n);
    if (!out) return 0;
    for (i = 1; i < n - 1; i++) {
        char c = s[i];
        if (c != '\\') { out[k++] = c; continue; }
        if (++i >= n - 1) return 0;
        c = s[i];
        if (c == 'n') out[k++] = '\n'; else if (c == 't') out[k++] = '\t'; else if (c == 'r') out[k++] = '\r';
        else if (c == 'b') out[k++] = '\b'; else if (c == 'f') out[k++] = '\f';
        else if (c == '"' || c == '\\' || c == '/') out[k++] = c;
        else if (c == 'u' && i + 4 < n - 1) {
            int v = 0, d;
            for (d = 1; d <= 4; d++) { char h = s[i + d]; v = v * 16 + (h >= '0' && h <= '9' ? h - '0' : h >= 'a' && h <= 'f' ? h - 'a' + 10 : h >= 'A' && h <= 'F' ? h - 'A' + 10 : -999); }
            if (v < 1 || v > 0x7f) return 0;
            out[k++] = (char)v; i += 4;
        } else return 0;
    }
    out[k] = 0;
    return out;
}
/* Python's list(s.encode()) as JSON with the default ", " separator. */
static void ob_bytes_list(Ob *o, const char *s) {
    long i, n = tx_len(s, FG_CAP);
    ob_z(o, "[");
    for (i = 0; i < n; i++) { if (i) ob_z(o, ", "); ob_int(o, (unsigned char)s[i]); }
    ob_z(o, "]");
}

/* Lines of a file, split in place; lines[] point into an arena copy. */
typedef struct { char **l; int n; char *raw; long rawn; } Lines;
static Lines fg_lines(const char *rel) {
    char path[4400];
    size_t n;
    char *b, *copy, *p, *end;
    Lines L;
    L.n = 0;
    if (cx_fmt(path, sizeof path, "%s/%s", fg_root, rel)) fg_die("path too long", rel);
    b = cx_read(path, &n);
    if (!b) fg_die("cannot read", path);
    L.raw = b; L.rawn = (long)n;
    copy = ar_dup(fg_ar, b, (long)n);
    L.l = ar_alloc(fg_ar, (long)sizeof(char *) * ((long)n + 2));
    if (!copy || !L.l) fg_die("out of memory", 0);
    for (p = copy, end = copy + n; p < end; ) {
        long off = tx_chr(p, (long)(end - p), '\n');
        if (off < 0) off = (long)(end - p);
        p[off] = 0;
        L.l[L.n++] = p;
        p += off + 1;
    }
    return L;
}
static int fg_split(char *s, char **out, int cap) {
    int n = 0;
    char *p = s;
    for (;;) {
        if (n == cap) return -1;
        out[n++] = p;
        while (*p && *p != '\t') p++;
        if (!*p) return n;
        *p++ = 0;
    }
}
static char *fg_dupz(const char *s) { long n = tx_len(s, FG_CAP); char *p = n < 0 ? 0 : ar_dup(fg_ar, s, n); if (!p) fg_die("out of memory", 0); return p; }

typedef struct { int n; char *v[FG_MAXL]; } List;
static int list_index(const List *l, const char *x) { int i; for (i = 0; i < l->n; i++) if (tx_eq(l->v[i], x, FG_CAP)) return i; return -1; }

/* gold(name) of export.py: rows of weights/gold/NAME.tsv not starting with '#' whose cells do not
   include the cell "=>" (the column line's cells are "=> head", so it is kept, as in Python). */
typedef struct { int n; int nc[FG_MAXL * 4]; char **c[FG_MAXL * 4]; } Rows;
static void fg_gold(const char *name, Rows *R, List *fields, const char *(*want)[2], int nwant) {
    char rel[256];
    Lines L;
    int i, k, w;
    cx_fmt(rel, sizeof rel, "weights/gold/%s.tsv", name);
    L = fg_lines(rel);
    R->n = 0;
    for (i = 0; i < L.n; i++) {
        char *cells[FG_MAXL + 4];
        char *line = fg_dupz(L.l[i]);
        int nc, arrow = 0;
        if (!*L.l[i]) continue;
        nc = fg_split(line, cells, FG_MAXL + 4);
        if (nc < 0) fg_die("too many cells", rel);
        if (L.l[i][0] == '#') {
            if (nc >= 2 && (tx_eq(cells[0], "#field", 8) || tx_eq(cells[0], "#head", 8)))
                for (w = 0; w < nwant; w++) if (tx_eq(cells[1], want[w][0], FG_CAP)) {
                    List *dst = &fields[w];
                    dst->n = 0;
                    for (k = 2; k < nc; k++) dst->v[dst->n++] = cells[k];
                }
            continue;
        }
        for (k = 0; k < nc; k++) if (tx_eq(cells[k], "=>", 4)) arrow = 1;
        if (arrow) continue;
        R->c[R->n] = ar_alloc(fg_ar, (long)sizeof(char *) * nc);
        if (!R->c[R->n]) fg_die("out of memory", 0);
        for (k = 0; k < nc; k++) R->c[R->n][k] = cells[k];
        R->nc[R->n++] = nc;
    }
}

/* facts(stem) for a two-column name/value table of integers, and a single-column value table of
   JSON strings (no escapes), as exec/facts/load.py reads them. */
static long fg_const(const char *stem, const char *name) {
    char rel[256];
    Lines L;
    int i;
    cx_fmt(rel, sizeof rel, "exec/facts/%s.tsv", stem);
    L = fg_lines(rel);
    for (i = 1; i < L.n; i++) {
        char *cells[4], *line = fg_dupz(L.l[i]), *end;
        long v;
        if (!*line || line[0] == '#') continue;
        if (fg_split(line, cells, 4) != 2) continue;
        if (!tx_eq(cells[0], name, FG_CAP)) continue;
        v = strtol(cells[1], &end, 10);
        if (end == cells[1] || *end) fg_die("constant is not an integer", name);
        return v;
    }
    fg_die("constant absent", name);
    return 0;
}
static int fg_values(const char *stem, char **out, int cap) {
    char rel[256];
    Lines L;
    int i, n = 0;
    cx_fmt(rel, sizeof rel, "exec/facts/%s.tsv", stem);
    L = fg_lines(rel);
    for (i = 1; i < L.n; i++) {
        char *s = L.l[i];
        long len = tx_len(s, FG_CAP);
        if (!*s || s[0] == '#') continue;
        if (len < 2 || s[0] != '"' || s[len - 1] != '"' || tx_chr(s, len, '\\') >= 0 || n == cap) fg_die("value is not a plain JSON string", stem);
        out[n++] = ar_dup(fg_ar, s + 1, len - 2);
    }
    return n;
}

static void opt_gen(Ob *o) {
    static List F[4];
    static const char *want[4][2] = {{"a", 0}, {"b", 0}, {"rel", 0}, {"y", 0}};
    static Rows peep, opinfo;
    static List dummy[1];
    static const char *none[1][2] = {{"", 0}};
    List *PA = &F[0], *PB = &F[1], *PR = &F[2], *PY = &F[3];
    char *words[256];
    int nwords, i, npeep = 0, nopinfo = 0, nsimple = 0;
    long PEEPB = fg_const("opt-gen-constants", "PEEPB"), ACLSB = fg_const("opt-gen-constants", "ACLSB"),
         BCLSB = fg_const("opt-gen-constants", "BCLSB"), SIMPLE = fg_const("opt-gen-constants", "SIMPLE");
    fg_gold("peep", &peep, F, want, 4);
    fg_gold("opinfo", &opinfo, dummy, none, 0);
    nwords = fg_values("opt-gen-startwords", words, 256);
    /* =startwords */
    ob_z(o, "=startwords\tjson\t[");
    for (i = 0; i < nwords; i++) {
        long a = 0, b = tx_len(words[i], FG_CAP);
        char reg[512];
        while (a < b && words[i][a] == '.') a++;
        while (b > a && words[i][b - 1] == '.') b--;
        ob_z(o, i ? ", {\"i\": " : "{\"i\": "); ob_int(o, i);
        ob_z(o, ", \"word\": "); ob_str(o, words[i]);
        cx_fmt(reg, sizeof reg, "id_%.*s", (int)(b - a), words[i] + a);
        ob_z(o, ", \"register\": "); ob_str(o, reg); ob_z(o, "}");
    }
    ob_z(o, "]\n");
    /* =peepinit */
    ob_z(o, "=peepinit\tjson\t[");
    for (i = 0; i < peep.n; i++) {
        char **f = peep.c[i];
        int a, b, r, y;
        if (peep.nc[i] != 4) continue;
        a = list_index(PA, f[0]); b = list_index(PB, f[1]); r = list_index(PR, f[2]); y = list_index(PY, f[3]);
        if (a < 0 || b < 0 || r < 0 || y < 0) continue;
        ob_z(o, npeep ? ", {\"i\": " : "{\"i\": "); ob_int(o, npeep);
        ob_z(o, ", \"index\": "); ob_int(o, ((long)a * PB->n + b) * PR->n + r);
        ob_z(o, ", \"value\": "); ob_int(o, y + 1);
        ob_z(o, ", \"bank\": "); ob_int(o, PEEPB); ob_z(o, "}");
        npeep++;
    }
    ob_z(o, "]\n");
    /* =opinfoinit */
    ob_z(o, "=opinfoinit\tjson\t[");
    for (i = 0; i < opinfo.n; i++) {
        char **f = opinfo.c[i];
        int a, b;
        if (opinfo.nc[i] != 4) continue;
        a = list_index(PA, f[2]); b = list_index(PB, f[3]);
        ob_z(o, nopinfo ? ", {\"i\": " : "{\"i\": "); ob_int(o, nopinfo);
        ob_z(o, ", \"word\": "); ob_str(o, f[0]);
        ob_z(o, ", \"has_a\": "); ob_str(o, a >= 0 ? "yes" : "no");
        ob_z(o, ", \"a_value\": "); ob_int(o, a >= 0 ? a + 1 : 0);
        ob_z(o, ", \"a_bank\": "); ob_int(o, ACLSB);
        ob_z(o, ", \"has_b\": "); ob_str(o, b >= 0 ? "yes" : "no");
        ob_z(o, ", \"b_value\": "); ob_int(o, b >= 0 ? b + 1 : 0);
        ob_z(o, ", \"b_bank\": "); ob_int(o, BCLSB); ob_z(o, "}");
        nopinfo++;
    }
    ob_z(o, "]\n");
    /* =simplewords */
    ob_z(o, "=simplewords\tjson\t[");
    for (i = 0; i < opinfo.n; i++) {
        char **f = opinfo.c[i];
        if (opinfo.nc[i] < 2 || !tx_eq(f[1], "1", 4)) continue;
        ob_z(o, nsimple ? ", {\"i\": " : "{\"i\": "); ob_int(o, nsimple);
        ob_z(o, ", \"word\": "); ob_str(o, f[0]);
        ob_z(o, ", \"bank\": "); ob_int(o, SIMPLE); ob_z(o, "}");
        nsimple++;
    }
    ob_z(o, "]\n");
    /* =startplans */
    {
        int plan, first, k;
        ob_z(o, "=startplans\tjson\t[");
        for (plan = 1; plan <= 2; plan++) {
            char ref[64];
            first = 1;
            ob_z(o, plan == 1 ? "{\"name\": \"start1\", \"refs\": [" : ", {\"name\": \"start2\", \"refs\": [");
            for (k = 0; k < nwords; k++) { cx_fmt(ref, sizeof ref, "word_%d", k); if (!first) ob_z(o, ", "); ob_str(o, ref); first = 0; }
            if (plan == 2) {
                for (k = 0; k < npeep; k++) { cx_fmt(ref, sizeof ref, "peep_%d", k); if (!first) ob_z(o, ", "); ob_str(o, ref); first = 0; }
                for (k = 0; k < nopinfo; k++) { cx_fmt(ref, sizeof ref, "opinfo_%d", k); if (!first) ob_z(o, ", "); ob_str(o, ref); first = 0; }
            }
            for (k = 0; k < nsimple; k++) { cx_fmt(ref, sizeof ref, "simple_%d", k); if (!first) ob_z(o, ", "); ob_str(o, ref); first = 0; }
            ob_z(o, "]}");
        }
        ob_z(o, "]\n");
    }
    /* =peepidx */
    {
        const List *L3[3] = {PA, PB, PR};
        const char *pre[3] = {"PA_", "PB_", "PR_"};
        int g, k, first = 1;
        char key[512];
        ob_z(o, "=peepidx\tjson\t{");
        for (g = 0; g < 3; g++)
            for (k = 0; k < L3[g]->n; k++) {
                cx_fmt(key, sizeof key, "%s%s", pre[g], L3[g]->v[k]);
                if (!first) ob_z(o, ", ");
                ob_str(o, key); ob_z(o, ": "); ob_int(o, k); first = 0;
            }
        ob_z(o, ", \"PB_size\": "); ob_int(o, PB->n);
        ob_z(o, ", \"PR_size\": "); ob_int(o, PR->n);
        ob_z(o, "}\n");
    }
    /* =Y: answer-targets name -> template, "*" the default, "{name}" replaced */
    {
        Lines T = fg_lines("exec/opt/answer-targets.tsv");
        char *tn[256], *tv[256];
        int nt = 0, k, star = -1;
        for (k = 0; k < T.n; k++) {
            char *cells[4], *line = fg_dupz(T.l[k]);
            if (!*line || line[0] == '#') continue;
            if (fg_split(line, cells, 4) != 2 || nt == 256) fg_die("bad answer-targets row", T.l[k]);
            tn[nt] = cells[0]; tv[nt] = cells[1];
            if (tx_eq(cells[0], "*", 4)) star = nt;
            nt++;
        }
        if (star < 0) fg_die("answer-targets lacks *", 0);
        ob_z(o, "=Y\tjson\t[");
        for (i = 0; i < PY->n; i++) {
            const char *t = tv[star];
            char out[1024];
            long at = 0, j, tl, hole;
            for (k = 0; k < nt; k++) if (tx_eq(tn[k], PY->v[i], FG_CAP)) { t = tv[k]; break; }
            tl = tx_len(t, FG_CAP);
            hole = tx_find(t, tl, "{name}", 6);
            for (j = 0; j < tl && at < 1000; ) {
                if (j == hole) { long m = tx_len(PY->v[i], 512); if (tx_copy(out + at, 1024 - at, PY->v[i], m)) fg_die("target too long", 0); at += m; j += 6; }
                else out[at++] = t[j++];
            }
            out[at] = 0;
            ob_z(o, i ? ", {\"i\": " : "{\"i\": "); ob_int(o, i);
            ob_z(o, ", \"target\": "); ob_str(o, out); ob_z(o, "}");
        }
        ob_z(o, "]\n");
    }
}

/* Two-column rows (KEY<TAB>VALUE) of a table, header line skipped, '#' lines skipped; values raw. */
static int fg_pairs(const char *rel, char **k, char **v, int cap) {
    Lines L = fg_lines(rel);
    int i, n = 0;
    for (i = 1; i < L.n; i++) {
        char *cells[4], *line = fg_dupz(L.l[i]);
        if (!*line || line[0] == '#') continue;
        if (fg_split(line, cells, 4) != 2 || n == cap) fg_die("not a two-column row", L.l[i]);
        k[n] = cells[0]; v[n] = cells[1]; n++;
    }
    return n;
}
static char *fg_pair(char **k, char **v, int n, const char *key) {
    int i;
    for (i = 0; i < n; i++) if (tx_eq(k[i], key, FG_CAP)) return v[i];
    fg_die("key absent", key);
    return 0;
}

/* parse-tokens: words = words_pre + casops+"=" + sorted(prec operators with a digit level) + words_post;
   TK maps each word to its last 1-based position (first-occurrence order), then "type" = TK["type=int"]. */
typedef struct {
    char *w[1024]; int nw;                   /* WORDS */
    char *tkn[1024]; int tkv[1024]; int ntk; /* TK in insertion order, "type" last */
    char *prec[256]; int plev[256]; int np;  /* gold prec operators with a digit level, byte-sorted */
} Tok;
static Tok pt;
static int pt_ready;
static int pt_tk(const char *name) {
    int i;
    for (i = 0; i < pt.ntk; i++) if (tx_eq(pt.tkn[i], name, FG_CAP)) return pt.tkv[i];
    fg_die("no TK entry", name);
    return 0;
}
static void pt_build(void) {
    static char *k[512], *v[512];
    char **w = pt.w, **prec = pt.prec;
    int n, nw = 0, np = 0, i, j, g, *plev = pt.plev;
    if (pt_ready) return;
    pt_ready = 1;
    n = fg_pairs("exec/facts/parse-words.tsv", k, v, 512);
    static const char *groups[3] = {"words_pre", "casops", "words_post"};
    Rows P;
    static List none[1];
    static const char *nowant[1][2] = {{"", 0}};
    fg_gold("prec", &P, none, nowant, 0);
    for (i = 0; i < P.n; i++) {                   /* the later _gold: drop lines containing "=>" */
        char *lvl;
        long m;
        if (P.nc[i] < 2) continue;
        lvl = P.c[i][1];
        m = tx_len(lvl, 64);
        if (m < 1) continue;
        for (j = 0; j < m; j++) if (lvl[j] < '0' || lvl[j] > '9') break;
        if (j < m) continue;
        for (j = 0; j < np; j++) if (tx_eq(prec[j], P.c[i][0], FG_CAP)) break;
        if (j == np) { prec[np] = P.c[i][0]; plev[np] = (int)strtol(lvl, 0, 10); np++; }
        else plev[j] = (int)strtol(lvl, 0, 10);   /* dict: the last row's level wins */
    }
    for (i = 1; i < np; i++) {                    /* sorted(): byte order, insertion sort */
        char *x = prec[i];
        int xl = plev[i];
        for (j = i - 1; j >= 0; j--) {
            long a = tx_len(prec[j], FG_CAP), b = tx_len(x, FG_CAP), m = a < b ? a : b, q;
            int gt = 0;
            for (q = 0; q < m && prec[j][q] == x[q]; q++) ;
            gt = q < m ? (unsigned char)prec[j][q] > (unsigned char)x[q] : a > b;
            if (!gt) break;
            prec[j + 1] = prec[j]; plev[j + 1] = plev[j];
        }
        prec[j + 1] = x; plev[j + 1] = xl;
    }
    pt.np = np;
    for (g = 0; g < 3; g++) {
        if (g == 2) for (j = 0; j < np; j++) w[nw++] = prec[j];
        for (i = 0; i < n; i++) {
            char *s;
            if (!tx_eq(k[i], groups[g], FG_CAP)) continue;
            s = jstr(v[i], tx_len(v[i], FG_CAP));
            if (!s) fg_die("parse-words value is not a JSON string", v[i]);
            if (g == 1) { char *t = ar_alloc(fg_ar, tx_len(s, FG_CAP) + 2); cx_fmt(t, (size_t)tx_len(s, FG_CAP) + 2, "%s=", s); s = t; }
            w[nw++] = s;
        }
    }
    pt.nw = nw;
    {
        int tint = -1;
        for (i = 0; i < nw; i++) {
            int last = i;
            for (j = 0; j < i; j++) if (tx_eq(w[j], w[i], FG_CAP)) break;
            if (j < i) continue;                  /* not the first occurrence */
            for (j = i + 1; j < nw; j++) if (tx_eq(w[j], w[i], FG_CAP)) last = j;
            if (tx_eq(w[i], "type", 8)) fg_die("a word named type exists; its TK position would be reused", 0);
            pt.tkn[pt.ntk] = w[i]; pt.tkv[pt.ntk++] = last + 1;
            if (tx_eq(w[i], "type=int", 16)) tint = last + 1;
        }
        if (tint < 0) fg_die("no type=int word", 0);
        pt.tkn[pt.ntk] = "type"; pt.tkv[pt.ntk++] = tint;
    }
}
static void parse_tokens(Ob *o) {
    int i;
    pt_build();
    ob_z(o, "=WORDS\tjson\t[");
    for (i = 0; i < pt.nw; i++) { if (i) ob_z(o, ","); ob_str(o, pt.w[i]); }
    ob_z(o, "]\n=TK\tjson\t{");
    for (i = 0; i < pt.ntk; i++) { if (i) ob_z(o, ","); ob_str(o, pt.tkn[i]); ob_z(o, ":"); ob_int(o, pt.tkv[i]); }
    ob_z(o, "}\n");
}

/* structreturnexpr: the struct-return refusal entry (LOC from parse-constants). */
static void struct_return_expr(Ob *o) {
    const char *reason = "not covered: struct return expression outside local lvalue";
    ob_z(o, "=reason\tstr\t"); ob_z(o, reason);
    ob_z(o, "\n@sr\tentry:str\tloc:int\treason:str\n\tLI.original.structreturn\t");
    ob_int(o, fg_const("parse-constants", "LOC")); ob_z(o, "\t"); ob_z(o, reason); ob_z(o, "\n");
}

/* k2-constexpr: integer-expression precedence levels and token classes for the E3 table. */
static void k2_constexpr(Ob *o) {
    static char *opn[256], *opc[256][5];
    static char *cn[64], *ct[64];
    int levels[64], nl = 0, nop = 0, ncl = 0, i, j, l;
    Lines L;
    pt_build();
    for (i = 0; i < pt.np; i++) {                 /* sorted(set(levels)) */
        for (j = 0; j < nl; j++) if (levels[j] == pt.plev[i]) break;
        if (j == nl) levels[nl++] = pt.plev[i];
    }
    for (i = 1; i < nl; i++) { int x = levels[i]; for (j = i - 1; j >= 0 && levels[j] > x; j--) levels[j + 1] = levels[j]; levels[j + 1] = x; }
    L = fg_lines("exec/parse2/constexpr-operators.tsv");
    for (i = 1; i < L.n; i++) {
        char *cells[8], *line = fg_dupz(L.l[i]);
        if (!*line) continue;
        if (fg_split(line, cells, 8) != 6 || nop == 256) fg_die("bad constexpr-operators row", L.l[i]);
        opn[nop] = cells[0];
        for (j = 0; j < 5; j++) opc[nop][j] = cells[j + 1];
        nop++;
    }
    ob_z(o, "=levels\tjson\t[");
    for (l = 0; l < nl; l++) {
        int first = 1;
        if (l) ob_z(o, ",");
        ob_z(o, "{\"level\":"); ob_int(o, levels[l]); ob_z(o, ",\"next\":");
        if (l + 1 < nl) ob_int(o, levels[l + 1]); else ob_str(o, ".atom");
        ob_z(o, ",\"ops\":[");
        for (i = 0; i < pt.np; i++) {             /* pt.prec is already byte-sorted */
            int x;
            char **c;
            if (pt.plev[i] != levels[l]) continue;
            for (x = 0; x < nop; x++) if (tx_eq(opn[x], pt.prec[i], FG_CAP)) break;
            if (x == nop) fg_die("operator missing from constexpr-operators", pt.prec[i]);
            c = opc[x];
            if (!first) ob_z(o, ",");
            first = 0;
            ob_z(o, "{\"k\":"); ob_int(o, pt_tk(pt.prec[i]));
            ob_z(o, ",\"name\":"); ob_str(o, pt.prec[i]);
            ob_z(o, ",\"category\":"); ob_str(o, c[0]);
            ob_z(o, ",\"action\":"); ob_str(o, c[1]);
            ob_z(o, ",\"comparison\":[");
            if (!tx_eq(c[2], "-", 4)) {
                long cl = tx_len(c[2], FG_CAP), q, firstn = 1;
                for (q = 0; q < cl; ) {
                    long e = tx_chr(c[2] + q, cl - q, ',');
                    char num[32];
                    if (e < 0) e = cl - q;
                    if (tx_copy(num, sizeof num, c[2] + q, e)) fg_die("bad comparison", c[2]);
                    if (!firstn) ob_z(o, ",");
                    ob_int(o, strtol(num, 0, 10)); firstn = 0;
                    q += e + 1;
                }
            }
            ob_z(o, "],\"zero\":"); ob_str(o, c[3]);
            ob_z(o, ",\"nonzero\":"); ob_str(o, c[4]); ob_z(o, "}");
        }
        ob_z(o, "]}");
    }
    ob_z(o, "]\n");
    {   /* tokens = TK + identifier/number/string, then type=extern/_Bool after max(TK) */
        static char *tn[1100];
        static int tv[1100];
        int nt = 0, mx = 0, typeword[1100], ntw = 0;
        const char *extra[3][2] = {{"identifier", "TK_ID"}, {"number", "TK_NUM"}, {"string", "TK_STR"}};
        for (i = 0; i < pt.ntk; i++) { tn[nt] = pt.tkn[i]; tv[nt++] = pt.tkv[i]; if (pt.tkv[i] > mx) mx = pt.tkv[i]; }
        for (i = 0; i < 3; i++) {
            long v = fg_const("parse-constants", extra[i][1]);
            for (j = 0; j < nt; j++) if (tx_eq(tn[j], extra[i][0], FG_CAP)) break;
            if (j == nt) { tn[nt] = (char *)extra[i][0]; tv[nt++] = (int)v; } else tv[j] = (int)v;
        }
        tn[nt] = "type=extern"; tv[nt++] = mx + 1;
        tn[nt] = "type=_Bool"; tv[nt++] = mx + 2;
        L = fg_lines("exec/parse2/constexpr-tokens.tsv");
        for (i = 1; i < L.n; i++) {
            char *cells[4], *line = fg_dupz(L.l[i]);
            if (!*line) continue;
            if (fg_split(line, cells, 4) != 2 || ncl == 64) fg_die("bad constexpr-tokens row", L.l[i]);
            cn[ncl] = cells[0]; ct[ncl++] = cells[1];
        }
        ob_z(o, "=classes\tjson\t{");
        for (i = 0; i < ncl; i++) {
            int v = -1;
            for (j = 0; j < nt; j++) if (tx_eq(tn[j], ct[i], FG_CAP)) v = tv[j];
            if (v < 0) fg_die("constexpr token without a code", ct[i]);
            if (i) ob_z(o, ",");
            ob_str(o, cn[i]); ob_z(o, ":["); ob_int(o, v); ob_z(o, "]");
        }
        for (j = 0; j < nt; j++) {
            int keep = tx_prefix(tn[j], tx_len(tn[j], FG_CAP), "type", 4) || tx_eq(tn[j], "struct", 8) || tx_eq(tn[j], "union", 8) || tx_eq(tn[j], "enum", 8), q;
            if (!keep) continue;
            for (q = 0; q < ntw; q++) if (typeword[q] == tv[j]) break;
            if (q == ntw) typeword[ntw++] = tv[j];
        }
        for (i = 1; i < ntw; i++) { int x = typeword[i]; for (j = i - 1; j >= 0 && typeword[j] > x; j--) typeword[j + 1] = typeword[j]; typeword[j + 1] = x; }
        ob_z(o, ncl ? ",\"typeword\":[" : "\"typeword\":[");
        for (i = 0; i < ntw; i++) { if (i) ob_z(o, ","); ob_int(o, typeword[i]); }
        ob_z(o, "]}\n=SKIPS\tint\t");
        ob_int(o, 7L * (1L << 26)); ob_z(o, "\n");
    }
}

/* k2-tokenlocations-map: MAP_FIELDS (a JSON list of plain strings) as [{"i":i,"register":"diag_NAME"}]. */
static void tokenlocations_map(Ob *o) {
    static char *k[64], *v[64];
    int n = fg_pairs("exec/facts/tokenlocations.tsv", k, v, 64), i = 0, first = 1;
    char *s = fg_pair(k, v, n, "MAP_FIELDS");
    long len = tx_len(s, FG_CAP), at = 1;
    if (len < 2 || s[0] != '[' || s[len - 1] != ']') fg_die("MAP_FIELDS is not a list", s);
    ob_z(o, "=mapfields\tjson\t[");
    while (at < len - 1) {
        long q;
        char *name, reg[512];
        while (at < len - 1 && (s[at] == ' ' || s[at] == ',')) at++;
        if (at >= len - 1) break;
        if (s[at] != '"') fg_die("MAP_FIELDS item is not a string", s);
        q = tx_chr(s + at + 1, len - at - 1, '"');
        if (q < 0) fg_die("unterminated MAP_FIELDS string", s);
        name = jstr(s + at, q + 2);
        if (!name) fg_die("bad MAP_FIELDS string", s);
        {   /* names must be distinct */
            static char *seen[256];
            int j;
            for (j = 0; j < i; j++) if (tx_eq(seen[j], name, FG_CAP)) fg_die("MAP_FIELDS repeats", name);
            if (i == 256) fg_die("too many MAP_FIELDS", 0);
            seen[i] = name;
        }
        cx_fmt(reg, sizeof reg, "diag_%s", name);
        ob_z(o, first ? "{\"i\":" : ",{\"i\":"); ob_int(o, i++); ob_z(o, ",\"register\":"); ob_str(o, reg); ob_z(o, "}");
        first = 0;
        at += q + 2;
    }
    if (!i) fg_die("MAP_FIELDS is empty", 0);
    ob_z(o, "]\n");
}

/* top-modelbindings-template: the USBIND magic chain, identifier byte classes and record kinds. */
static void modelbindings_template(Ob *o) {
    static char *k[64], *v[64];
    int n = fg_pairs("exec/facts/top-modelbindings-const.tsv", k, v, 64), i;
    char *magic = jstr(fg_pair(k, v, n, "magic"), tx_len(fg_pair(k, v, n, "magic"), FG_CAP));
    char *letters = jstr(fg_pair(k, v, n, "letters"), tx_len(fg_pair(k, v, n, "letters"), FG_CAP));
    char *digits = jstr(fg_pair(k, v, n, "digits"), tx_len(fg_pair(k, v, n, "digits"), FG_CAP));
    char *kind = fg_pair(k, v, n, "kind"), all[512];
    long m;
    if (!magic || !letters || !digits) fg_die("bad modelbindings constant", 0);
    ob_z(o, "@magic\ti:int\tc:int\tnext:int\n");
    m = tx_len(magic, FG_CAP);
    for (i = 0; i < m; i++) { ob_z(o, "\t"); ob_int(o, i); ob_z(o, "\t"); ob_int(o, (unsigned char)magic[i]); ob_z(o, "\t"); ob_int(o, i + 1); ob_z(o, "\n"); }
    ob_z(o, "@id\tletters:json\tdigits:json\tall:json\n\t");
    ob_bytes_list(o, letters); ob_z(o, "\t"); ob_bytes_list(o, digits); ob_z(o, "\t");
    cx_fmt(all, sizeof all, "%s%s", letters, digits);
    ob_bytes_list(o, all); ob_z(o, "\n");
    {   /* json.dumps of a list of small integers: normalise separators to ", " */
        long kl = tx_len(kind, FG_CAP), j;
        int sep = 0;
        if (kl < 2 || kind[0] != '[' || kind[kl - 1] != ']') fg_die("kind is not a list", kind);
        ob_z(o, "=kind\tjson\t[");
        for (j = 1; j < kl - 1; j++) {
            if (kind[j] == ' ') continue;
            if (kind[j] == ',') { sep = 1; continue; }
            if (kind[j] < '0' || kind[j] > '9') fg_die("kind is not a list of integers", kind);
            if (sep) { ob_z(o, ", "); sep = 0; }
            ob_put(o, kind + j, 1);
        }
        ob_z(o, "]\n");
    }
}

/* k2-unitlocations: the located unit map storage key. */
static void k2_unitlocations(Ob *o) {
    ob_z(o, "# Located unit map storage key; actions live in unitlocations-manifest.tsv.\n=MAPS\tint\t");
    ob_int(o, 49L << 40); ob_z(o, "\n");
}

/* k2-strings: string rejection text and escape data from exec/facts/strings.tsv (dict semantics: first
   position, last value), escapes for 0-7 and x excluded, and TK_STR from parse-constants (raw text). */
static void k2_strings(Ob *o) {
    static char *rn[256], *rv[256], *ek[256];
    static int ev[256];
    int nr = 0, ne = 0, i, j;
    Lines L = fg_lines("exec/facts/strings.tsv");
    for (i = 0; i < L.n; i++) {
        char *cells[4], *line = fg_dupz(L.l[i]);
        int nc;
        if (!*line || line[0] == '#') continue;
        nc = fg_split(line, cells, 3);
        if (nc < 0) { /* a third tab belongs to the value: split(..., 2) */ }
        if (nc != 3) continue;
        if (tx_eq(cells[0], "reject", 8)) {
            char *v = jstr(cells[2], tx_len(cells[2], FG_CAP));
            if (!v) fg_die("reject value is not a JSON string", cells[2]);
            for (j = 0; j < nr; j++) if (tx_eq(rn[j], cells[1], FG_CAP)) break;
            if (j == nr) { if (nr == 256) fg_die("too many rejects", 0); rn[nr++] = cells[1]; }
            rv[j] = v;
        } else if (tx_eq(cells[0], "escape", 8)) {
            char *k = jstr(cells[1], tx_len(cells[1], FG_CAP)), *end;
            long v = strtol(cells[2], &end, 10);
            if (!k || tx_len(k, 4) != 1 || end == cells[2] || *end) fg_die("bad escape row", L.l[i]);
            for (j = 0; j < ne; j++) if (ek[j][0] == k[0]) break;
            if (j == ne) { if (ne == 256) fg_die("too many escapes", 0); ek[ne++] = k; }
            ev[j] = (int)v;
        }
    }
    ob_z(o, "=rej\tjson\t{");
    for (i = 0; i < nr; i++) { if (i) ob_z(o, ","); ob_str(o, rn[i]); ob_z(o, ":"); ob_str(o, rv[i]); }
    ob_z(o, "}\n=escape\tjson\t[");
    {
        int first = 1;
        for (i = 0; i < ne; i++) {
            if (tx_chr("01234567x", 9, ek[i][0]) >= 0) continue;
            if (!first) ob_z(o, ",");
            ob_z(o, "{\"byte\":"); ob_int(o, (unsigned char)ek[i][0]); ob_z(o, ",\"value\":"); ob_int(o, ev[i]); ob_z(o, "}");
            first = 0;
        }
        ob_z(o, "]\n=escbytes\tjson\t[");
        first = 1;
        for (i = 0; i < ne; i++) {
            if (tx_chr("01234567x", 9, ek[i][0]) >= 0) continue;
            if (!first) ob_z(o, ",");
            ob_int(o, (unsigned char)ek[i][0]); first = 0;
        }
        ob_z(o, "]\n");
    }
    {
        static char *k[512], *v[512];
        int n = fg_pairs("exec/facts/parse-constants.tsv", k, v, 512);
        ob_z(o, "=TK_STR\tint\t"); ob_z(o, fg_pair(k, v, n, "TK_STR")); ob_z(o, "\n");
    }
}

/* k2-truth: scalar truth opcodes from the declared output variants (fixed shape asserted). */
static void k2_truth(Ob *o) {
    static const char *want[5][3] = {{"truth", "FT.double", "64"}, {"truth", "FT.float", "32"},
        {"not", "FN.double", "feq64"}, {"not", "FN.float", "feq32"}, {"not", "FN.integer", "eq"}};
    static const char *names[5] = {"TRUTH64_OP", "TRUTH32_OP", "NOT64_OP", "NOT32_OP", "NOTINT_OP"};
    Lines L = fg_lines("exec/parse2/scalar-outputs.tsv");
    int i, nv = 0;
    for (i = 1; i < L.n; i++) {
        char *cells[8], *line = fg_dupz(L.l[i]);
        if (!*line) continue;
        if (fg_split(line, cells, 8) != 5) fg_die("bad scalar-outputs row", L.l[i]);
        if (!tx_eq(cells[0], "truth", 8) && !tx_eq(cells[0], "not", 8)) continue;
        if (nv == 5 || !tx_eq(cells[0], want[nv][0], 8) || !tx_eq(cells[1], want[nv][1], 64) || !tx_eq(cells[3], want[nv][2], 16))
            fg_die("scalar truth variants differ from the declared five", L.l[i]);
        ob_z(o, "="); ob_z(o, names[nv]); ob_z(o, "\tstr\t");
        if (tx_eq(cells[0], "truth", 8)) ob_z(o, "feq");
        ob_z(o, cells[3]); ob_z(o, "\n");
        nv++;
    }
    if (nv != 5) fg_die("scalar truth variants differ from the declared five", 0);
}

/* signature-layout: SIG_RADIX from parse-constants. */
static void signature_layout(Ob *o) {
    ob_z(o, "=SIG_RADIX\tint\t"); ob_int(o, fg_const("parse-constants", "SIG_RADIX")); ob_z(o, "\n");
}

/* k2-librarymodule-map: header keys, bad main keys and the main reason from k2-librarymodule. */
static void k2_librarymodule_map(Ob *o) {
    Lines L = fg_lines("exec/facts/k2-librarymodule.tsv");
    long hd[2] = {-1, -1}, md[2] = {-1, -1}, ok[64], k;
    int nok = 0, i;
    char *reason = 0;
    for (i = 0; i < L.n; i++) {
        char *cells[4], *line = fg_dupz(L.l[i]);
        if (line[0] != '=') continue;
        if (fg_split(line + 1, cells, 3) != 3) fg_die("bad k2-librarymodule row", L.l[i]);
        if (tx_eq(cells[0], "hdomain", 16) || tx_eq(cells[0], "maindomain", 16) || tx_eq(cells[0], "mainok", 16)) {
            long *dst = tx_eq(cells[0], "mainok", 16) ? ok : tx_eq(cells[0], "hdomain", 16) ? hd : md;
            char *p = cells[2], *end;
            int n = 0;
            if (*p != '[') fg_die("expected a JSON list", cells[2]);
            p++;
            while (*p && *p != ']') {
                while (*p == ' ' || *p == ',') p++;
                if (*p == ']') break;
                if (n == 64) fg_die("list too long", cells[2]);
                dst[n++] = strtol(p, &end, 10);
                if (end == p) fg_die("expected integers", cells[2]);
                p = end;
            }
            if (dst == ok) nok = n; else if (n != 2) fg_die("domain must be [lo,hi]", cells[2]);
        } else if (tx_eq(cells[0], "mainreason", 16)) reason = cells[2];
    }
    if (hd[0] < 0 || md[0] < 0 || !reason) fg_die("k2-librarymodule lacks a domain or the reason", 0);
    ob_z(o, "=hkeys\tjson\t[");
    for (k = hd[0]; k < hd[1]; k++) { if (k > hd[0]) ob_z(o, ","); ob_int(o, k); }
    ob_z(o, "]\n=mainbad\tjson\t[");
    {
        int first = 1;
        for (k = md[0]; k < md[1]; k++) {
            int j, good = 0;
            for (j = 0; j < nok; j++) if (ok[j] == k) good = 1;
            if (good) continue;
            if (!first) ob_z(o, ",");
            ob_int(o, k); first = 0;
        }
    }
    ob_z(o, "]\n=mainreason\tstr\t"); ob_z(o, reason); ob_z(o, "\n");
}

/* k2-stack: VS and, for each declared stack, the slot order of every push/pop (a slot with a rank that
   is not itself listed is followed by its rank; vpop reverses). */
static const char *k2_stacks[5][2] = {{"initializers", "exec/parse2/initializers-stack.tsv"},
    {"intwarnings", "exec/parse2/intwarnings-stack.tsv"}, {"returnwarnings", "exec/parse2/returnwarnings-stack.tsv"},
    {"formatwarnings", "exec/parse2/formatwarnings-stack.tsv"}, {"membercontrol", "exec/parse2/membercontrol-stack.tsv"}};
static void k2_stack(Ob *o) {
    static char *rk[256], *rv[256];
    int nr = 0, s, i;
    Lines R = fg_lines("exec/facts/valueranks.tsv");
    for (i = 1; i < R.n; i++) {
        char *cells[4], *line = fg_dupz(R.l[i]);
        int j;
        if (!*line || line[0] == '#') continue;
        if (fg_split(line, cells, 4) != 3) fg_die("bad valueranks row", R.l[i]);
        if (!tx_eq(cells[0], "rank", 8)) continue;
        for (j = 0; j < nr; j++) if (tx_eq(rk[j], cells[1], FG_CAP)) break;
        if (j == nr) { if (nr == 256) fg_die("too many ranks", 0); rk[nr++] = cells[1]; }
        rv[j] = cells[2];
    }
    ob_z(o, "=VS\tint\t"); ob_int(o, fg_const("parse-constants", "VS")); ob_z(o, "\n");
    for (s = 0; s < 5; s++) {
        Lines L = fg_lines(k2_stacks[s][1]);
        for (i = 1; i < L.n; i++) {
            char *cells[4], *line = fg_dupz(L.l[i]), *items[128], *slots[256], *p;
            int ni = 0, ns = 0, pop, j, q;
            if (!*line) continue;
            if (fg_split(line, cells, 4) != 2) fg_die("bad stack row", L.l[i]);
            p = cells[1];
            if (tx_prefix(p, tx_len(p, FG_CAP), "[\"vpush\", [", 11)) pop = 0;
            else if (tx_prefix(p, tx_len(p, FG_CAP), "[\"vpop\", [", 10)) pop = 1;
            else fg_die("stack method is not vpush/vpop", cells[1]);
            p += pop ? 10 : 11;
            while (*p && *p != ']') {
                long q2;
                while (*p == ' ' || *p == ',') p++;
                if (*p == ']') break;
                q2 = tx_chr(p + 1, tx_len(p + 1, FG_CAP), '"');
                if (*p != '"' || q2 < 0 || ni == 128) fg_die("bad stack item", cells[1]);
                items[ni++] = ar_dup(fg_ar, p + 1, q2);
                p += q2 + 2;
            }
            if (tx_eq(p, "]]", 4) == 0) fg_die("bad stack row tail", cells[1]);
            for (j = 0; j < ni; j++) {
                char *rank = 0;
                int listed = 0;
                slots[ns++] = items[j];
                for (q = 0; q < nr; q++) if (tx_eq(rk[q], items[j], FG_CAP)) rank = rv[q];
                if (rank && *rank) for (q = 0; q < ni; q++) if (tx_eq(items[q], rank, FG_CAP)) listed = 1;
                if (rank && *rank && !listed) slots[ns++] = rank;
            }
            ob_z(o, "=stack_"); ob_z(o, k2_stacks[s][0]); ob_z(o, "_"); ob_z(o, cells[0]); ob_z(o, "\tjson\t[");
            for (j = 0; j < ns; j++) {
                if (j) ob_z(o, ", ");
                ob_z(o, "{\"register\": "); ob_str(o, slots[pop ? ns - 1 - j : j]); ob_z(o, "}");
            }
            ob_z(o, "]\n");
        }
    }
}

/* Image header field chains (export.py _fieldchain/_rows): each field has a width, a constant or a
   register name, and the lead = literal-byte ("byteN") and computation names that precede it. */
#define FC_MAX 512
#define FC_LEAD 4096
typedef struct { int w; long v; const char *reg; int lead0, nlead, big; } FcField;
typedef struct { FcField f[FC_MAX]; int nf; const char *lead[FC_LEAD * 4]; int nl, pend; } Fc;
static void fc_init(Fc *c) { c->nf = 0; c->nl = 0; c->pend = 0; }
static void fc_name(Fc *c, const char *s) { if (c->nl == FC_LEAD * 4) fg_die("field chain too long", 0); c->lead[c->nl++] = s; }
static void fc_lit(Fc *c, const unsigned char *b, long n) {
    static char *byten[256];
    long i;
    for (i = 0; i < n; i++) {
        if (!byten[b[i]]) { char t[16]; cx_fmt(t, sizeof t, "byte%d", b[i]); byten[b[i]] = fg_dupz(t); }
        fc_name(c, byten[b[i]]);
    }
}
static int fc_big;                     /* endian of the fields added next */
static void fc_field(Fc *c, int w, long v, const char *reg) {
    FcField *f;
    if (c->nf == FC_MAX) fg_die("too many fields", 0);
    f = &c->f[c->nf++];
    f->w = w; f->v = v; f->reg = reg; f->lead0 = c->pend; f->nlead = c->nl - c->pend; f->big = fc_big;
    c->pend = c->nl;
}
static void fc_lead_json(Ob *o, Fc *c, int at, int n) {
    int i;
    ob_z(o, "[");
    for (i = 0; i < n; i++) { if (i) ob_z(o, ","); ob_str(o, c->lead[at + i]); }
    ob_z(o, "]");
}
static void fc_rows(Ob *o, const char *name, Fc *c) {
    int i;
    ob_z(o, "@"); ob_z(o, name); ob_z(o, "\ti:int\twidth:int\tsrc:str\tvalue:json\tendian:str\tlead:json\n");
    for (i = 0; i < c->nf; i++) {
        FcField *f = &c->f[i];
        ob_z(o, "\t"); ob_int(o, i); ob_z(o, "\t"); ob_int(o, f->w); ob_z(o, f->reg ? "\treg\t" : "\tconst\t");
        if (f->reg) ob_str(o, f->reg); else ob_int(o, f->v);
        ob_z(o, f->big ? "\tbig\t" : "\tlittle\t"); fc_lead_json(o, c, f->lead0, f->nlead); ob_z(o, "\n");
    }
}
static void fc_tail(Ob *o, const char *name, Fc *c) {   /* one zero-width row carrying the trailing lead */
    ob_z(o, "@"); ob_z(o, name); ob_z(o, "\ti:int\twidth:int\tsrc:str\tvalue:json\tendian:str\tlead:json\n\t0\t0\tnone\t0\t-\t");
    fc_lead_json(o, c, c->pend, c->nl - c->pend); ob_z(o, "\n");
}
/* "used": every lead name over the chains, kept for the final @bytes table (sorted as strings). */
static const char *pe_used[1024];
static int pe_nused;
static void fc_collect(Fc *c) {
    int i, j;
    for (i = 0; i < c->nl; i++) {
        for (j = 0; j < pe_nused; j++) if (tx_eq(pe_used[j], c->lead[i], FG_CAP)) break;
        if (j == pe_nused) { if (pe_nused == 1024) fg_die("too many lead names", 0); pe_used[pe_nused++] = c->lead[i]; }
    }
}
static int fg_strcmp(const char *a, const char *b) {
    long i = 0;
    while (a[i] && a[i] == b[i]) i++;
    return (unsigned char)a[i] - (unsigned char)b[i];
}

typedef struct { char *kind, *name, *value; } Krow;
static int fg_krows(const char *rel, Krow *r, int cap) {
    Lines L = fg_lines(rel);
    int i, n = 0;
    for (i = 0; i < L.n; i++) {
        char *cells[4], *line = fg_dupz(L.l[i]);
        if (!*line || line[0] == '#') continue;
        if (fg_split(line, cells, 4) != 3 || n == cap) fg_die("not a kind/name/value row", L.l[i]);
        r[n].kind = cells[0]; r[n].name = cells[1]; r[n].value = cells[2]; n++;
    }
    return n;
}
static long kv_int(Krow *r, int n, const char *kind, const char *name) {
    int i;
    for (i = 0; i < n; i++) if (tx_eq(r[i].kind, kind, 64) && tx_eq(r[i].name, name, 256)) return strtol(r[i].value, 0, 10);
    fg_die("fact absent", name);
    return 0;
}

static void pe_fields(Ob *o, int forward) {
    static Krow k[128];
    static Fc c;
    static const char *imp[64];
    static long noff[64];
    static unsigned char nraw[64][96];
    static long nlen[64];
    int nk = fg_krows("exec/facts/image-pe.tsv", k, 128), n = 0, i, j, a;
    long IMAGEBASE = kv_int(k, nk, "const", "IMAGEBASE"), SA = kv_int(k, nk, "const", "SECT_ALIGN"), FA = kv_int(k, nk, "const", "FILE_ALIGN"),
         TEXT_RVA = kv_int(k, nk, "const", "TEXT_RVA"), HDR_FILE = kv_int(k, nk, "const", "HDR_FILE"),
         LOADCFG = kv_int(k, nk, "const", "LOADCFG"), COOKIE = kv_int(k, nk, "const", "COOKIE_FIELD");
    const char *dll = 0, *arch[4];
    long mach[4], iat, off, dlloff, cfg, idlen, dlln;
    int narch = 0;
    for (i = 0; i < nk; i++) {
        if (tx_eq(k[i].kind, "import", 8) || (forward && tx_eq(k[i].kind, "forward", 8))) imp[n++] = k[i].value;
        if (tx_eq(k[i].kind, "dll", 8)) dll = k[i].value;
        if (tx_eq(k[i].kind, "machine", 8)) { arch[narch] = k[i].name; mach[narch++] = strtol(k[i].value, 0, 10); }
    }
    if (forward) {   /* imports first, then the forward extras, in file order */
        int m = 0;
        for (i = 0; i < nk; i++) if (tx_eq(k[i].kind, "import", 8)) imp[m++] = k[i].value;
        for (i = 0; i < nk; i++) if (tx_eq(k[i].kind, "forward", 8)) imp[m++] = k[i].value;
    }
    for (i = 1; i < narch; i++) for (j = i; j > 0 && fg_strcmp(arch[j - 1], arch[j]) > 0; j--) {   /* sorted(MACHINE) */
        const char *t = arch[j]; long u = mach[j]; arch[j] = arch[j - 1]; mach[j] = mach[j - 1]; arch[j - 1] = t; mach[j - 1] = u;
    }
    if (!dll) fg_die("image-pe lacks DLL", 0);
    dlln = tx_len(dll, 256);
    iat = 40 + 8 * (n + 1); off = iat + 8 * (n + 1);
    for (i = 0; i < n; i++) {
        long m = tx_len(imp[i], 90), q;
        nraw[i][0] = 0; nraw[i][1] = 0;
        for (q = 0; q < m; q++) nraw[i][2 + q] = (unsigned char)imp[i][q];
        nraw[i][2 + m] = 0;
        nlen[i] = m + 3;
        if (nlen[i] % 2) nraw[i][nlen[i]++] = 0;
        noff[i] = off; off += nlen[i];
    }
    dlloff = off; off += dlln + 1; cfg = (off + 7) & -8L; idlen = cfg + LOADCFG;
    {
        const char *cn[16] = {"DATA", "RELOCS", "SORTED", "TEXT_RVA", "IMAGEBASE", "HDR_FILE", "section_minus_one", "section_mask",
                              "file_minus_one", "file_mask", "import_vsize", "import_fsize", "cookie_at", "cfg", "iat", "dlloff"};
        long cv[16];
        cv[0] = 1L << 40; cv[1] = 4L << 40; cv[2] = 5L << 40; cv[3] = TEXT_RVA; cv[4] = IMAGEBASE; cv[5] = HDR_FILE;
        cv[6] = SA - 1; cv[7] = -SA; cv[8] = FA - 1; cv[9] = -FA; cv[10] = (idlen + SA - 1) & -SA; cv[11] = (idlen + FA - 1) & -FA;
        cv[12] = cfg + COOKIE; cv[13] = cfg; cv[14] = iat; cv[15] = dlloff;
        for (i = 0; i < 16; i++) { ob_z(o, "="); ob_z(o, cn[i]); ob_z(o, "\tint\t"); ob_int(o, cv[i]); ob_z(o, "\n"); }
    }
    pe_nused = 0;
    for (a = 0; a < narch; a++) {
        static const unsigned char mz[60] = {'M', 'Z'};
        static const unsigned char pesig[4] = {'P', 'E', 0, 0};
        char hn[64], tn[64];
        int q;
        fc_init(&c);
        fc_lit(&c, mz, 60); fc_field(&c, 4, 64, 0); fc_lit(&c, pesig, 4);
        {   /* COFF file header */
            static const int W[7] = {2, 2, 4, 4, 4, 2, 2};
            long V[7] = {0, 4, 0, 0, 0, 240, 0x22};
            V[0] = mach[a];
            for (q = 0; q < 7; q++) fc_field(&c, W[q], V[q], 0);
        }
        fc_name(&c, "entry-value");
        {   /* optional header PE32+, up to the data directories */
            static const int W[29] = {2, 1, 1, 4, 4, 4, 4, 4, 8, 4, 4, 2, 2, 2, 2, 2, 2, 4, 4, 4, 4, 2, 2, 8, 8, 8, 8, 4, 4};
            long V[29] = {0x20B, 14, 0, 0, 0, 0, 0, 0, 0, 0, 0, 4, 0, 0, 0, 4, 0, 0, 0, 0, 0, 3, 0x8160, 0x100000, 0x1000, 0x100000, 0x1000, 0, 16};
            const char *R[29] = {0};
            R[3] = "pe_tf"; R[6] = "pe_entry"; V[7] = TEXT_RVA; V[8] = IMAGEBASE; V[9] = SA; V[10] = FA; R[18] = "pe_img"; V[19] = HDR_FILE;
            for (q = 0; q < 29; q++) fc_field(&c, W[q], V[q], R[q]);
        }
        fc_name(&c, "directory-values");
        for (q = 0; q < 16; q++) {
            const char *r0 = 0, *r1 = 0;
            long v0 = 0, v1 = 0;
            if (q == 1) { r0 = "pe_rd"; v1 = 40; }
            else if (q == 5) { r0 = "pe_rr"; r1 = "pe_rlsize"; }
            else if (q == 10) { r0 = "pe_cfg"; v1 = LOADCFG; }
            else if (q == 12) { r0 = "pe_iat"; v1 = (n + 1) * 8; }
            fc_field(&c, 4, v0, r0); fc_field(&c, 4, v1, r1);
        }
        {
            static const char *sn[4] = {".text", ".rdata", ".data", ".reloc"};
            for (q = 0; q < 4; q++) {
                unsigned char nm[8] = {0};
                long t;
                for (t = 0; sn[q][t]; t++) nm[t] = (unsigned char)sn[q][t];
                if (q == 3) fc_name(&c, "reloc-align");
                fc_lit(&c, nm, 8);
                if (q == 0) { fc_field(&c, 4, 0, "endo"); fc_field(&c, 4, TEXT_RVA, 0); fc_field(&c, 4, 0, "pe_tf"); fc_field(&c, 4, HDR_FILE, 0); }
                if (q == 1) { fc_field(&c, 4, idlen, 0); fc_field(&c, 4, 0, "pe_rd"); fc_field(&c, 4, (idlen + 511) & -512L, 0); fc_field(&c, 4, 0, "pe_rf"); }
                if (q == 2) { fc_field(&c, 4, 0, "pe_dvs"); fc_field(&c, 4, 0, "pe_dt"); fc_field(&c, 4, 0, "pe_datafile"); fc_field(&c, 4, 0, "pe_df"); }
                if (q == 3) { fc_field(&c, 4, 0, "pe_rlsize"); fc_field(&c, 4, 0, "pe_rr"); fc_field(&c, 4, 0, "pe_rsize"); fc_field(&c, 4, 0, "pe_relf"); }
                fc_field(&c, 4, 0, 0); fc_field(&c, 4, 0, 0); fc_field(&c, 2, 0, 0); fc_field(&c, 2, 0, 0);
                fc_field(&c, 4, q == 0 ? 0x60000020L : q == 1 ? 0x40000040L : q == 2 ? 0xC0000040L : 0x42000040L, 0);
            }
        }
        cx_fmt(hn, sizeof hn, "header_%s", arch[a]); cx_fmt(tn, sizeof tn, "header_tail_%s", arch[a]);
        fc_rows(o, hn, &c); fc_tail(o, tn, &c);
        fc_collect(&c);
    }
    fc_init(&c);
    fc_name(&c, "import-values");
    fc_field(&c, 4, 0, "pe_int"); fc_field(&c, 4, 0, 0); fc_field(&c, 4, 0, 0); fc_field(&c, 4, 0, "pe_dll"); fc_field(&c, 4, 0, "pe_iat");
    { static const unsigned char z[20]; fc_lit(&c, z, 20); }
    for (a = 0; a < 2; a++) {
        for (i = 0; i < n; i++) { char cn[64]; cx_fmt(cn, sizeof cn, "name-value%ld", noff[i]); fc_name(&c, fg_dupz(cn)); fc_field(&c, 8, 0, "pe_name"); }
        fc_field(&c, 8, 0, 0);
    }
    for (i = 0; i < n; i++) fc_lit(&c, nraw[i], nlen[i]);
    {
        static unsigned char buf[4096];
        long m = 0, q;
        for (q = 0; q < dlln; q++) buf[m++] = (unsigned char)dll[q];
        buf[m++] = 0;
        for (q = 0; q < cfg - (dlloff + dlln + 1); q++) buf[m++] = 0;
        fc_lit(&c, buf, m);
        fc_field(&c, 4, LOADCFG, 0);
        for (q = 0; q < COOKIE - 4; q++) buf[q] = 0;
        fc_lit(&c, buf, COOKIE - 4);
        fc_field(&c, 8, 0, "pe_cookie");
        fc_lit(&c, buf, LOADCFG - COOKIE - 8);
    }
    fc_rows(o, "imports", &c); fc_tail(o, "imports_tail", &c);
    fc_collect(&c);
    for (i = 1; i < pe_nused; i++) for (j = i; j > 0 && fg_strcmp(pe_used[j - 1], pe_used[j]) > 0; j--) {
        const char *t = pe_used[j]; pe_used[j] = pe_used[j - 1]; pe_used[j - 1] = t;
    }
    ob_z(o, "@bytes\tv:int\n");
    for (i = 0; i < pe_nused; i++) if (tx_prefix(pe_used[i], tx_len(pe_used[i], 64), "byte", 4)) { ob_z(o, "\t"); ob_z(o, pe_used[i] + 4); ob_z(o, "\n"); }
    ob_z(o, "@names\toffset:int\n");
    for (i = 0; i < n; i++) { ob_z(o, "\t"); ob_int(o, noff[i]); ob_z(o, "\n"); }
}
static long kv_hex(Krow *r, int n, const char *name, unsigned char *out, long cap) {
    int i;
    for (i = 0; i < n; i++) if (tx_eq(r[i].kind, "bytes", 8) && tx_eq(r[i].name, name, 64)) {
        long len = tx_len(r[i].value, FG_CAP), q;
        if (len % 2 || len / 2 > cap) fg_die("bad hex fact", name);
        for (q = 0; q < len / 2; q++) {
            int hi = r[i].value[2 * q], lo = r[i].value[2 * q + 1];
            hi = hi <= '9' ? hi - '0' : hi - 'a' + 10; lo = lo <= '9' ? lo - '0' : lo - 'a' + 10;
            out[q] = (unsigned char)(hi * 16 + lo);
        }
        return len / 2;
    }
    fg_die("hex fact absent", name);
    return 0;
}
static void fc_used_bytes(Ob *o) {
    int i, j;
    for (i = 1; i < pe_nused; i++) for (j = i; j > 0 && fg_strcmp(pe_used[j - 1], pe_used[j]) > 0; j--) {
        const char *t = pe_used[j]; pe_used[j] = pe_used[j - 1]; pe_used[j - 1] = t;
    }
    ob_z(o, "@bytes\tv:int\n");
    for (i = 0; i < pe_nused; i++) if (tx_prefix(pe_used[i], tx_len(pe_used[i], 64), "byte", 4)) { ob_z(o, "\t"); ob_z(o, pe_used[i] + 4); ob_z(o, "\n"); }
}
static void fc_lit_name16(Fc *c, const char *s) {
    unsigned char b[16] = {0};
    long i;
    for (i = 0; s[i] && i < 16; i++) b[i] = (unsigned char)s[i];
    fc_lit(c, b, 16);
}

/* enc-macho: Mach-O load commands and the ad-hoc code-signature field schema. */
static void enc_macho(Ob *o) {
    static Krow k[128];
    static Fc c;
    int nk = fg_krows("exec/facts/image-macho.tsv", k, 128), a, i;
    static unsigned char ident[64], dlbind[256], dyld[64], libsys[96];
    long nident = kv_hex(k, nk, "IDENT", ident, 64), ndlbind = kv_hex(k, nk, "DLBIND", dlbind, 256),
         ndyld = kv_hex(k, nk, "DYLD", dyld, 64), nlibsys = kv_hex(k, nk, "LIBSYS", libsys, 96);
#define MC(n) kv_int(k, nk, "const", n)
    const char *arch[4];
    int narch = 0;
    for (i = 0; i < nk; i++) if (tx_eq(k[i].kind, "cputype", 8)) arch[narch++] = k[i].name;
    for (a = 1; a < narch; a++) for (i = a; i > 0 && fg_strcmp(arch[i - 1], arch[i]) > 0; i--) { const char *t = arch[i]; arch[i] = arch[i - 1]; arch[i - 1] = t; }
    {
        const char *cn[10] = {"DATA", "VMADDR", "STRTAB", "page_minus_one", "page_mask", "page4_minus_one", "PAGE4", "signature_base", "DLPREFIX", "DLBINDLEN"};
        long cv[10];
        cv[0] = 1L << 40; cv[1] = MC("VMADDR"); cv[2] = MC("STRTAB"); cv[3] = MC("PAGE") - 1; cv[4] = -MC("PAGE");
        cv[5] = MC("PAGE4") - 1; cv[6] = MC("PAGE4"); cv[7] = 20 + 88 + nident; cv[8] = MC("DLPREFIX"); cv[9] = ndlbind;
        for (i = 0; i < 10; i++) { ob_z(o, "="); ob_z(o, cn[i]); ob_z(o, "\tint\t"); ob_int(o, cv[i]); ob_z(o, "\n"); }
    }
    pe_nused = 0;
    for (a = 0; a < narch; a++) {
        long hdrs = kv_int(k, nk, "hdrs", arch[a]), VM = MC("VMADDR"), SEG = MC("SEG"), SECT = MC("SECT");
        char nm[64];
        unsigned char lib[128];
        long nlib, q;
        fc_big = 0;
        ob_z(o, "=HDRS_"); ob_z(o, arch[a]); ob_z(o, "\tint\t"); ob_int(o, hdrs); ob_z(o, "\n");
        fc_init(&c);
        fc_field(&c, 4, 0xFEEDFACFL, 0); fc_field(&c, 4, kv_int(k, nk, "cputype", arch[a]), 0); fc_field(&c, 4, kv_int(k, nk, "cpusub", arch[a]), 0);
        fc_field(&c, 4, 2, 0); fc_field(&c, 4, MC("NCMDS"), 0); fc_field(&c, 4, kv_int(k, nk, "cmdsz", arch[a]), 0); fc_field(&c, 4, 0x200085, 0); fc_field(&c, 4, 0, 0);
#define SEGC(N, VA, VAR, VMV, VMR, FO, FOR, FS, FSR, PROT, NS) do { fc_field(&c, 4, MC("LC_SEGMENT_64"), 0); fc_field(&c, 4, SEG + SECT * (NS), 0); fc_lit_name16(&c, N); \
        fc_field(&c, 8, VA, VAR); fc_field(&c, 8, VMV, VMR); fc_field(&c, 8, FO, FOR); fc_field(&c, 8, FS, FSR); fc_field(&c, 4, PROT, 0); fc_field(&c, 4, PROT, 0); fc_field(&c, 4, NS, 0); fc_field(&c, 4, 0, 0); } while (0)
#define SECTC(N, S, VA, VAR, SZ, SZR, OFF, OFFR, FLAGS) do { fc_lit_name16(&c, N); fc_lit_name16(&c, S); fc_field(&c, 8, VA, VAR); fc_field(&c, 8, SZ, SZR); fc_field(&c, 4, OFF, OFFR); \
        fc_field(&c, 4, 2, 0); fc_field(&c, 4, 0, 0); fc_field(&c, 4, 0, 0); fc_field(&c, 4, FLAGS, 0); fc_field(&c, 4, 0, 0); fc_field(&c, 4, 0, 0); fc_field(&c, 4, 0, 0); } while (0)
        SEGC("__PAGEZERO", 0, 0, VM, 0, 0, 0, 0, 0, 0, 0);
        SEGC("__TEXT", VM, 0, 0, "mh_text", 0, 0, 0, "mh_text", 5, 1);
        SECTC("__text", "__TEXT", VM + hdrs, 0, 0, "endo", hdrs, 0, 0x80000400L);
        SEGC("__DATA", 0, "mh_datava", 0, "mh_vm", 0, "mh_text", 0, "mh_data", 3, 2);
        SECTC("__data", "__DATA", 0, "mh_datava", 0, "mh_stored", 0, "mh_text", 0);
        SECTC("__bss", "__DATA", 0, "mh_bssva", 0, "mh_bsslen", 0, 0, 1);
        SEGC("__LINKEDIT", 0, "mh_linkva", 0, "mh_linkvm", 0, "mh_link", 0, "mh_linksz", 1, 0);
        fc_field(&c, 4, MC("LC_LOAD_DYLINKER"), 0); fc_field(&c, 4, 32, 0); fc_field(&c, 4, 12, 0);
        { unsigned char d[20] = {0}; for (q = 0; q < ndyld && q < 20; q++) d[q] = dyld[q]; fc_lit(&c, d, 20); }
        for (q = 0; q < nlibsys; q++) lib[q] = libsys[q];
        lib[nlibsys] = 0; nlib = nlibsys + 1;
        while (nlib % 8) lib[nlib++] = 0;
        fc_field(&c, 4, MC("LC_LOAD_DYLIB"), 0); fc_field(&c, 4, 24 + nlib, 0); fc_field(&c, 4, 24, 0); fc_field(&c, 4, 0, 0); fc_field(&c, 4, 0x10000, 0); fc_field(&c, 4, 0x10000, 0);
        fc_lit(&c, lib, nlib);
        fc_field(&c, 4, MC("LC_MAIN"), 0); fc_field(&c, 4, 24, 0); fc_field(&c, 8, 0, "mh_entry"); fc_field(&c, 8, 0, 0);
        fc_field(&c, 4, MC("LC_BUILD_VERSION"), 0); fc_field(&c, 4, 24, 0); fc_field(&c, 4, 1, 0); fc_field(&c, 4, 13L << 16, 0); fc_field(&c, 4, 13L << 16, 0); fc_field(&c, 4, 0, 0);
        fc_field(&c, 4, MC("LC_DYLD_INFO_ONLY"), 0); fc_field(&c, 4, 48, 0); fc_field(&c, 4, 0, 0); fc_field(&c, 4, 0, 0); fc_field(&c, 4, 0, "mh_bindoff"); fc_field(&c, 4, ndlbind, 0);
        for (q = 0; q < 6; q++) fc_field(&c, 4, 0, 0);
        fc_field(&c, 4, MC("LC_SYMTAB"), 0); fc_field(&c, 4, 24, 0); fc_field(&c, 4, 0, "mh_link"); fc_field(&c, 4, 0, 0); fc_field(&c, 4, 0, "mh_link"); fc_field(&c, 4, MC("STRTAB"), 0);
        fc_field(&c, 4, MC("LC_DYSYMTAB"), 0); fc_field(&c, 4, 80, 0);
        for (q = 0; q < 18; q++) fc_field(&c, 4, 0, 0);
        fc_field(&c, 4, MC("LC_CODE_SIGNATURE"), 0); fc_field(&c, 4, 16, 0); fc_field(&c, 4, 0, "mh_sigoff"); fc_field(&c, 4, 0, "mh_siglen");
        { static unsigned char z[512]; long sl = MC("SLACK"); if (sl > 512) fg_die("SLACK too large", 0); fc_lit(&c, z, sl); }
        cx_fmt(nm, sizeof nm, "header_%s", arch[a]); fc_rows(o, nm, &c);
        cx_fmt(nm, sizeof nm, "header_tail_%s", arch[a]); fc_tail(o, nm, &c);
        fc_collect(&c);
        fc_init(&c);
        fc_big = 1;
        fc_field(&c, 4, MC("CS_MAGIC_EMBEDDED"), 0); fc_field(&c, 4, 0, "mh_siglen"); fc_field(&c, 4, 1, 0); fc_field(&c, 4, 0, 0); fc_field(&c, 4, 20, 0);
        fc_name(&c, "signature-length");
        fc_field(&c, 4, MC("CS_MAGIC_CODEDIRECTORY"), 0); fc_field(&c, 4, 0, "mh_cdlen"); fc_field(&c, 4, 0x20400, 0); fc_field(&c, 4, MC("CS_ADHOC"), 0);
        fc_field(&c, 4, 88 + nident, 0); fc_field(&c, 4, 88, 0); fc_field(&c, 4, 0, 0); fc_field(&c, 4, 0, "mh_slots"); fc_field(&c, 4, 0, "mh_sigoff");
        fc_field(&c, 1, 32, 0); fc_field(&c, 1, 2, 0); fc_field(&c, 1, 0, 0); fc_field(&c, 1, 12, 0); fc_field(&c, 4, 0, 0);
        fc_field(&c, 4, 0, 0); fc_field(&c, 4, 0, 0); fc_field(&c, 4, 0, 0); fc_field(&c, 8, 0, 0); fc_field(&c, 8, 0, 0); fc_field(&c, 8, 0, "mh_text"); fc_field(&c, 8, MC("CS_EXECSEG_MAIN_BINARY"), 0);
        fc_big = 0;
        fc_lit(&c, ident, nident);
        cx_fmt(nm, sizeof nm, "signature_%s", arch[a]); fc_rows(o, nm, &c);
        cx_fmt(nm, sizeof nm, "signature_tail_%s", arch[a]); fc_tail(o, nm, &c);
        fc_collect(&c);
#undef SEGC
#undef SECTC
    }
    {
        static unsigned char z[256];
        long pre = MC("DLPREFIX");
        if (pre > 256) fg_die("DLPREFIX too large", 0);
        fc_init(&c); fc_lit(&c, z, pre); fc_tail(o, "prefix", &c); fc_collect(&c);
        fc_init(&c); fc_lit(&c, dlbind, ndlbind); fc_tail(o, "binddata", &c); fc_collect(&c);
    }
    fc_used_bytes(o);
#undef MC
}

/* enc-elf: ELF program-header / dynamic-section field schema and the import/loader slot tables. */
static void enc_elf(Ob *o) {
    static Krow k[64], kp[128];
    static Fc c;
    int nk = fg_krows("exec/facts/image-elf.tsv", k, 64), np = fg_krows("exec/facts/image-pe.tsv", kp, 128), nimp = 0, a, i;
    long VADDR = kv_int(k, nk, "const", "VADDR"), EHDR = kv_int(k, nk, "const", "EHDR"), PHDR = kv_int(k, nk, "const", "PHDR"), PAGE = kv_int(k, nk, "const", "PAGE");
    const char *arch[4];
    int narch = 0;
    char nm[64];
    for (i = 0; i < np; i++) if (tx_eq(kp[i].kind, "import", 8)) nimp++;
    for (i = 0; i < nk; i++) if (tx_eq(k[i].kind, "machine", 8)) arch[narch++] = k[i].name;
    for (a = 1; a < narch; a++) for (i = a; i > 0 && fg_strcmp(arch[i - 1], arch[i]) > 0; i--) { const char *t = arch[i]; arch[i] = arch[i - 1]; arch[i - 1] = t; }
    {
        const char *cn[8] = {"DATA", "RELOCS", "iat_size", "VADDR", "dyn_doff", "fmt_elf", "fmt_macho", "fmt_pe"};
        long cv[8] = {1L << 40, 4L << 40, 0, 0, 0, 1, 2, 3};
        cv[2] = 8L * nimp; cv[3] = VADDR; cv[4] = VADDR + 32;
        for (i = 0; i < 8; i++) { ob_z(o, "="); ob_z(o, cn[i]); ob_z(o, "\tint\t"); ob_int(o, cv[i]); ob_z(o, "\n"); }
    }
    pe_nused = 0; fc_big = 0;
#define EMIT(N) do { cx_fmt(nm, sizeof nm, "%s", N); fc_rows(o, nm, &c); cx_fmt(nm, sizeof nm, "%s_tail", N); fc_tail(o, nm, &c); fc_collect(&c); } while (0)
    fc_init(&c);
    for (i = 0; i < nimp; i++) { char r[32]; cx_fmt(r, sizeof r, "ml_imp_%d", i); fc_field(&c, 8, 0, fg_dupz(r)); }
    EMIT("iat");
    fc_init(&c);
    for (i = 0; i < 4; i++) { char r[32]; cx_fmt(r, sizeof r, "ml_dl_%d", i); fc_field(&c, 8, 0, fg_dupz(r)); }
    EMIT("dlslots");
    { static const unsigned char z[32]; fc_init(&c); fc_lit(&c, z, 32); EMIT("dynslots"); }
    for (a = 0; a < narch; a++) {
        long mach = kv_int(k, nk, "machine", arch[a]);
        int arm = tx_eq(arch[a], "arm64", 8), dyn;
        ob_z(o, "=HDRS_"); ob_z(o, arch[a]); ob_z(o, "\tint\t"); ob_int(o, kv_int(k, nk, "hdrs", arch[a])); ob_z(o, "\n");
        for (dyn = 0; dyn < 2; dyn++) {
            static const unsigned char id[16] = {0x7f, 'E', 'L', 'F', 2, 1, 1, 0};
            const char *interp = arm ? "/lib/ld-linux-aarch64.so.1" : "/lib64/ld-linux-x86-64.so.2";
            long il = tx_len(interp, 64);
            fc_init(&c);
            fc_name(&c, dyn ? "dyn-init" : "header-init");
            fc_lit(&c, id, 16);
            fc_field(&c, 2, 2, 0); fc_field(&c, 2, mach, 0); fc_field(&c, 4, 1, 0); fc_field(&c, 8, 0, "entryva"); fc_field(&c, 8, EHDR, 0); fc_field(&c, 8, 0, 0);
            fc_field(&c, 4, 0, 0); fc_field(&c, 2, EHDR, 0); fc_field(&c, 2, PHDR, 0); fc_field(&c, 2, dyn ? 4 : 2, 0); fc_field(&c, 2, 0, 0); fc_field(&c, 2, 0, 0); fc_field(&c, 2, 0, 0);
#define PH(T, F, OFF, OFFR, VA, VAR, FS, FSR, MS, MSR, AL) do { fc_field(&c, 4, T, 0); fc_field(&c, 4, F, 0); fc_field(&c, 8, OFF, OFFR); fc_field(&c, 8, VA, VAR); fc_field(&c, 8, VA, VAR); \
            fc_field(&c, 8, FS, FSR); fc_field(&c, 8, MS, MSR); fc_field(&c, 8, AL, 0); } while (0)
            if (!dyn) {
                PH(1, 5, 0, 0, VADDR, 0, 0, "tend", 0, "tend", PAGE);
                PH(1, 6, 0, "doff", 0, "data_va", 0, "stored", 0, "memlen", PAGE);
                cx_fmt(nm, sizeof nm, "static_%s", arch[a]);
            } else {
                static const unsigned char names[] = "\0libc.so.6\0dlopen\0dlsym\0dlclose\0dlerror\0";
                static const unsigned char z[32], st[4] = {0x12, 0, 0, 0};
                unsigned char ib[32] = {0};
                static const long nameoff[4] = {11, 18, 24, 32};
                static const long tags[11][2] = {{1, 1}, {4, 480}, {5, 320}, {6, 360}, {10, 40}, {11, 24}, {7, 512}, {8, 96}, {9, 24}, {30, 8}, {0, 0}};
                long q;
                PH(3, 4, 288, 0, VADDR + 288, 0, il + 1, 0, il + 1, 0, 1);
                PH(1, 5, 0, 0, VADDR, 0, 0, "tend", 0, "tend", PAGE);
                PH(1, 6, 0, "doff", 0, "dyn_slots", 0, "dyn_filesz", 0, "dyn_memsz", PAGE);
                PH(2, 4, 608, 0, VADDR + 608, 0, 176, 0, 176, 0, 8);
                for (q = 0; q < il; q++) ib[q] = (unsigned char)interp[q];
                fc_lit(&c, ib, 32);
                fc_lit(&c, names, (long)sizeof names - 1);
                fc_lit(&c, z, 24);
                for (q = 0; q < 4; q++) { fc_field(&c, 4, nameoff[q], 0); fc_lit(&c, st, 4); fc_field(&c, 8, 0, 0); fc_field(&c, 8, 0, 0); }
                fc_field(&c, 4, 1, 0); fc_field(&c, 4, 5, 0);
                fc_lit(&c, z, 24);
                for (q = 0; q < 4; q++) {
                    char cn[32];
                    cx_fmt(cn, sizeof cn, "dynreloc%ld", 8 * q);
                    fc_name(&c, fg_dupz(cn));
                    fc_field(&c, 8, 0, "dyn_reloc"); fc_field(&c, 8, ((q + 1) << 32) | (arm ? 1025 : 6), 0); fc_field(&c, 8, 0, 0);
                }
                for (q = 0; q < 11; q++) { long v = tags[q][1]; if (tags[q][0] == 4 || tags[q][0] == 5 || tags[q][0] == 6 || tags[q][0] == 7) v += VADDR; fc_field(&c, 8, tags[q][0], 0); fc_field(&c, 8, v, 0); }
                cx_fmt(nm, sizeof nm, "dyn_%s", arch[a]);
            }
#undef PH
            {
                char base[64];
                cx_fmt(base, sizeof base, "%s", nm);
                EMIT(base);
            }
        }
    }
#undef EMIT
    ob_z(o, "@relocs\toff:int\n");
    for (i = 0; i < 4; i++) { ob_z(o, "\t"); ob_int(o, 8 * i); ob_z(o, "\n"); }
    fc_used_bytes(o);
}

static void enc_pe(Ob *o) { pe_fields(o, 0); }
static void enc_pe_forward(Ob *o) { pe_fields(o, 1); }

typedef struct { const char *stem; const char *inputs[12]; void (*produce)(Ob *); } Table;   /* inputs 0-terminated */
static const Table fg_tables[] = {
    {"opt-gen", {"weights/gold/peep.tsv", "weights/gold/opinfo.tsv", "exec/facts/opt-gen-constants.tsv",
                 "exec/facts/opt-gen-startwords.tsv", "exec/opt/answer-targets.tsv", "tools/facts-gen.cx", 0}, opt_gen},
    {"parse-tokens", {"exec/facts/parse-words.tsv", "weights/gold/prec.tsv", "tools/facts-gen.cx", 0}, parse_tokens},
    {"top-modelbindings-template", {"exec/facts/top-modelbindings-const.tsv", "tools/facts-gen.cx", 0}, modelbindings_template},
    {"k2-tokenlocations-map", {"exec/facts/tokenlocations.tsv", "tools/facts-gen.cx", 0}, tokenlocations_map},
    {"structreturnexpr", {"exec/facts/parse-constants.tsv", "tools/facts-gen.cx", 0}, struct_return_expr},
    {"k2-constexpr", {"exec/facts/parse-words.tsv", "weights/gold/prec.tsv", "exec/facts/parse-constants.tsv",
                      "exec/parse2/constexpr-operators.tsv", "exec/parse2/constexpr-tokens.tsv", "tools/facts-gen.cx", 0}, k2_constexpr},
    {"k2-unitlocations", {"tools/facts-gen.cx", 0}, k2_unitlocations},
    {"k2-strings", {"exec/facts/strings.tsv", "exec/facts/parse-constants.tsv", "tools/facts-gen.cx", 0}, k2_strings},
    {"k2-truth", {"exec/parse2/scalar-outputs.tsv", "tools/facts-gen.cx", 0}, k2_truth},
    {"signature-layout", {"exec/facts/parse-constants.tsv", "tools/facts-gen.cx", 0}, signature_layout},
    {"k2-librarymodule-map", {"exec/facts/k2-librarymodule.tsv", "tools/facts-gen.cx", 0}, k2_librarymodule_map},
    {"k2-stack", {"exec/facts/parse-constants.tsv", "exec/facts/valueranks.tsv", "exec/parse2/initializers-stack.tsv",
                  "exec/parse2/intwarnings-stack.tsv", "exec/parse2/returnwarnings-stack.tsv",
                  "exec/parse2/formatwarnings-stack.tsv", "exec/parse2/membercontrol-stack.tsv", "tools/facts-gen.cx"}, k2_stack},
    {"enc-pe", {"exec/facts/image-pe.tsv", "tools/facts-gen.cx", 0}, enc_pe},
    {"enc-pe-forward", {"exec/facts/image-pe.tsv", "tools/facts-gen.cx", 0}, enc_pe_forward},
    {"enc-macho", {"exec/facts/image-macho.tsv", "tools/facts-gen.cx", 0}, enc_macho},
    {"enc-elf", {"exec/facts/image-elf.tsv", "exec/facts/image-pe.tsv", "tools/facts-gen.cx", 0}, enc_elf},
    {0, {0}, 0}
};

static void fg_render(const Table *t, Ob *head, Ob *body) {
    int i;
    ob_z(head, "# exec/facts/"); ob_z(head, t->stem); ob_z(head, ".tsv: written by tools/facts-gen.cx, do not edit\n");
    for (i = 0; t->inputs[i]; i++) {
        char path[4400], hex[65];
        size_t n;
        char *b;
        cx_fmt(path, sizeof path, "%s/%s", fg_root, t->inputs[i]);
        b = cx_read(path, &n);
        if (!b) fg_die("cannot read input", path);
        cx_sha256_hex(b, n, hex);
        ob_z(head, "# input "); ob_z(head, t->inputs[i]); ob_z(head, " sha256:"); ob_put(head, hex, 16); ob_z(head, "\n");
    }
    t->produce(body);
}

static long fg_body_start(const char *s, long n) {       /* offset of the first line not starting with '#' */
    long at = 0;                         /* header = the writer line and the "# input " lines */
    while (at < n && (tx_prefix(s + at, n - at, "# exec/facts/", 13) || tx_prefix(s + at, n - at, "# input ", 8))) {
        long off = tx_chr(s + at, n - at, '\n');
        if (off < 0) return n;
        at += off + 1;
    }
    return at;
}

static int fg_one(const Table *t, int mode) {   /* mode 0 check, 1 write, 2 compare-body */
    Ob head = {0, 0, 0}, body = {0, 0, 0};
    char path[4400];
    size_t n;
    char *cur;
    fg_render(t, &head, &body);
    cx_fmt(path, sizeof path, "%s/exec/facts/%s.tsv", fg_root, t->stem);
    if (mode == 1) {
        Ob all = {0, 0, 0};
        ob_put(&all, head.p, head.n); ob_put(&all, body.p, body.n);
        if (cx_write(path, all.p, (size_t)all.n)) fg_die("cannot write", path);
        printf("WROTE\t%s\n", t->stem);
        return 0;
    }
    cur = cx_read(path, &n);
    if (!cur) fg_die("cannot read", path);
    if (mode == 2) {
        long b = fg_body_start(cur, (long)n);
        int same = tx_same(cur + b, (long)n - b, body.p, body.n);
        printf("%s\t%s\tbody\n", same ? "SAME" : "DIFF", t->stem);
        return !same;
    }
    {
        int same = (long)n == head.n + body.n && tx_same(cur, head.n, head.p, head.n) && tx_same(cur + head.n, body.n, body.p, body.n);
        printf("%s\t%s\n", same ? "SAME" : "DIFF", t->stem);
        return !same;
    }
}

int main(int argc, char **argv) {
    int mode, i, k, bad = 0;
    fg_ar = ar_new(1L << 32);
    if (!fg_ar) fg_die("cannot create the arena", 0);
    if (argc < 3) fg_die("usage", "--check|--write|--compare-body ROOT [TABLE...]");
    if (tx_eq(argv[1], "--check", 16)) mode = 0;
    else if (tx_eq(argv[1], "--write", 16)) mode = 1;
    else if (tx_eq(argv[1], "--compare-body", 16)) mode = 2;
    else fg_die("usage", "--check|--write|--compare-body ROOT [TABLE...]");
    if (!realpath(argv[2], fg_root)) fg_die("bad ROOT", argv[2]);
    for (i = 0; fg_tables[i].stem; i++) {
        int pick = argc == 3;
        for (k = 3; k < argc; k++) if (tx_eq(argv[k], fg_tables[i].stem, 256)) pick = 1;
        if (pick) bad |= fg_one(&fg_tables[i], mode);
    }
    return bad;
}
