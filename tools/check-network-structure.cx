/* Borrowed UNINETB1 N spans. No inflation, text model, T/R table, or execution. */
#pragma unisa use runtime.network_structure
static int failed;
static unsigned char acc[96];
static int an;
static const unsigned char MAG[8] = {'U','N','I','N','E','T','B','1'};
static const unsigned char H0[8] = {'H', 0, 0, 0x80, 0x04, 0, 0, 0};
static const unsigned char W5[5] = {0x80, 0x80, 0x80, 0x80, 0x10};
static void ck(int ok, const char *name) {
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", name);
    if (!ok) failed++;
}
static void audit(const unsigned char *p, long n, int want, const char *name) {
    int rc = cxns_audit(p, n);
    ck(rc == want, name);
    if (rc != want) printf("got\t%s\t%d\n", name, rc);
}
static void begin(void) {
    int i;
    an = 0;
    for (i = 0; i < 8; i++) acc[an++] = MAG[i];
}
static void b(int c) {
    if (an < 96) acc[an++] = (unsigned char)c;
    else an = 1000;
}
static void raw(const unsigned char *p, int n) {
    int i;
    for (i = 0; i < n; i++) b(p[i]);
}
static void h0(void) { raw(H0, 8); }
static void run(int want, const char *name) { audit(acc, an, want, name); }
static void head(int ns, int nq, int nrg, int nstr, int start, int top) {
    begin();
    b('N'); b(ns); b(nq); b(nrg); b(nstr); b(start); b(top);
}
int main(void) {
    unsigned char bad[8] = {'U','N','I','N','E','T','B','2'};
    unsigned char tagt[9] = {'U','N','I','N','E','T','B','1','T'};
    head(2, 2, 0, 0, 0, 0); b('Q'); b(0); h0(); run(0, "minimal");
    ck(cxns_audit(0, 1) == 1, "null-data");
    ck(cxns_audit(acc, -1) == 1, "negative-length");
    ck(cxns_audit(0, 0) == 2, "empty-span");
    audit(MAG, 7, 2, "short-magic");
    audit(bad, 8, 2, "bad-magic");
    audit(tagt, 9, 3, "tag-t");
    head(0, 2, 0, 0, 0, 0); run(3, "zero-ns");
    head(2, 2, 0, 0, 2, 0); run(3, "start-range");
    head(4, 2, 0, 0, 2, 2); b('Q'); b(0); h0(); h0(); run(0, "start-in-range");
    head(2, 2, 1, 0, 0, 0); run(3, "negative-nrg");
    head(4, 2, 0, 0, 0, 0); run(3, "topmax-low");
    begin(); b('N'); b(2); b(2); b(0); b(0); b(0); b(0xfe); b(0xff); b(0xff); b(0xff); b(0x0f);
    run(3, "topmax-max");
    begin(); b('N'); raw(W5, 5); b(0); b(0); b(0); b(0); b(0); run(3, "header-i32");
    head(4, 2, 0, 0, 0, 2); b('Q'); b(0); h0(); h0(); run(0, "two-states");
    begin(); b('N'); b(2); b(2); b(0x80); b(0x00); run(4, "noncanonical");
    begin(); b('N'); b(2); b(2); b(0x80); run(4, "truncated-varint");
    head(2, 2, 0, 2, 0, 0); b('S'); b(0); b('Q'); b(0); h0(); run(0, "empty-string");
    head(2, 2, 0, 2, 0, 0); b('S'); b(2); b(0x80); b('Q'); b(0); h0(); run(0, "string-bytes");
    head(2, 2, 0, 2, 0, 0); b('S'); b(10); run(5, "string-overrun");
    head(2, 2, 0, 2, 0, 0); b('Q'); run(5, "string-tag");
    head(2, 2, 0, 0, 0, 0); b('Q'); b(2); b(0x70); run(7, "bad-opcode");
    head(2, 2, 0, 0, 0, 0); b('Q'); b(2); raw(W5, 5); run(7, "opcode-wide");
    head(2, 2, 0, 0, 0, 0); b('Q'); b(2); b(2); run(4, "missing-operand");
    head(2, 2, 0, 0, 0, 0); b('Q'); b(2); b(2); b(0x80); b(0x00); run(4, "noncanonical-operand");
    head(2, 2, 0, 0, 0, 0); b('Q'); b(2); b(2); b(0xce); b(0x0f); h0(); run(0, "wide-operand");
    head(2, 2, 0, 0, 0, 0); b('Q'); b(2); b(2); raw(W5, 5); h0(); run(0, "wide-i64-operand");
    head(2, 2, 0, 0, 0, 0); b('Q'); b(2); b(0x0a); b(0); b(0); b(0); b(0); h0(); run(0, "alu-arity");
    head(2, 2, 0, 0, 0, 0); b('Q'); b(2); b(0x0a); b(0); b(0); b(0); run(4, "alu-short");
    head(2, 2, 0, 0, 0, 0); b('Q'); b(1); run(6, "negative-actions");
    head(2, 2, 0, 0, 0, 0); b('Q'); b(2); run(6, "hostile-count");
    head(2, 2, 0, 0, 0, 0); b('X'); run(6, "sequence-tag");
    head(2, 4, 0, 0, 0, 0); b('Q'); b(2); b(2); b(0); b('C'); b(0); b(2); b(0); h0(); run(0, "copy-sequence");
    head(2, 4, 0, 0, 0, 0); b('Q'); b(2); b(2); b(0); b('C'); b(0); b(2); b(2); b(0); h0(); run(0, "copy-extend");
    head(2, 4, 0, 0, 0, 0); b('Q'); b(2); b(2); b(0); b('C'); b(0); b(4); b(0); run(6, "copy-prefix");
    head(2, 4, 0, 0, 0, 0); b('C'); b(0); b(2); b(0); run(6, "copy-forward");
    head(2, 2, 0, 0, 0, 0); b('Q'); b(0); run(8, "missing-h");
    head(2, 2, 0, 0, 0, 0); b('Q'); b(0); b('H'); b(0x80); run(4, "h-truncated");
    head(2, 2, 0, 0, 0, 0); b('Q'); b(0); b('H'); b(0); b(1); b(0x80); b(0x04); b(0); b(0); b(0); run(8, "bad-lo");
    head(2, 2, 0, 0, 0, 0); b('Q'); b(0); b('H'); raw(W5, 5); b(0); b(0); b(0); b(0); b(0); run(8, "h-i32");
    head(2, 2, 0, 0, 0, 0); b('Q'); b(0); b('H'); b(6); b(1); b(0); b(0); b(0); b(0); b(0); b(2); b(0); run(0, "return-bank");
    head(2, 2, 0, 0, 0, 0); b('Q'); b(0); b('H'); b(6); b(1); b(0); b(0); b(0); b(0); b(0); b(0); run(8, "return-count");
    head(2, 2, 0, 0, 0, 0); b('Q'); b(0); b('H'); b(6); b(0); b(0); b(0); b(0); b(0); raw(W5, 5); run(8, "return-i32");
    head(2, 2, 0, 0, 0, 0); b('Q'); b(0); b('H'); b(0); b(0); b(0x80); b(0x04); b(2); b(0); b(0); b(0); b(0); b(0); run(8, "row-order");
    head(2, 2, 0, 0, 0, 0); b('Q'); b(0); b('H'); b(0); b(0); b(0x80); b(0x04); b(2); b(0); b(0); b(0x80); b(0x04); b(0); b(0); run(0, "row-at-hi");
    head(2, 2, 0, 0, 0, 0); b('Q'); b(0); b('H'); b(0); b(0); b(0x80); b(0x04); b(2); b(0); b(0); raw(W5, 5); run(8, "row-i32");
    head(2, 2, 0, 0, 0, 0); b('Q'); b(0); b('H'); b(0); b(0); b(0x80); b(0x04); b(2); b(0); b(0); b(2); b(0xce); b(0x0f); b(1); run(0, "row-values");
    head(2, 2, 0, 0, 0, 0); b('Q'); b(0); b('H'); b(0); b(0); b(0x80); b(0x04); b(0); b(1); b(0); run(0, "bn-negative");
    head(2, 2, 0, 0, 0, 0); b('Q'); b(0); h0(); b(0); run(9, "trailing");
    printf("NOT_RUN\tinflate-crc-package-framing-text-model-table-T\n");
    printf("NOT_RUN\topcode-kinds-alu-string-meaning-bn-bq-transition-flat-capacity-malloc\n");
    printf("CXNETWORK_STRUCT\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
