#pragma unisa use sys.io
#pragma unisa use text.text
/* tools/arity-gen.cx -- the arity table weights/arity/arity.tsv, and its rule form.
 *
 *   sh ./unisacc.com tools/arity-gen.cx -- --check ROOT
 *   sh ./unisacc.com tools/arity-gen.cx -- --write ROOT
 *   sh ./unisacc.com tools/arity-gen.cx -- call PROTO NPAR NARGS
 *
 * The arity key is what the parse (E3) stage knows when a call closes: which prototype form is in
 * view (none / fixed / variadic), how many parameters the prototype names, and how many arguments
 * the call site wrote.  The labels are accept, too-few-arguments and too-many-arguments.  The rule
 * form seed/gold_arity_label.c states the rule; this table is its projection, and --check refuses
 * when the two disagree or when the table is not the exact cartesian product of its #field lines.
 *
 * --check: the six header lines must be the ones below byte for byte, the rows must be exactly the
 *   cartesian product proto x npar x nargs (proto slowest, 3 x 9 x 9 = 243), every label must be
 *   one of the #head classes, and the rule form's `table` output must equal the rows byte for byte.
 * --write: write the header and the rule form's `table` output after the same checks.
 * call: one line for one key, so a batch can ask a boundary case without reading the table.
 * Exit 0 good, 1 a difference (named), 2 usage or I/O.
 *
 * This table is NOT one of the eighteen gold nets.  tools/net-gen.cx (NNET 18), tools/rule-gen.cx
 * (NRULE 11) and tools/gold-table.cx keep their counts; this tool owns its own path and its own
 * rule form.  The parse stage that consults the table is the next change; until it lands, nothing
 * outside this tool, seed/gold_arity_label.c and tests/arity-controls.cx reads this file.
 *
 * No libc and no include. */
#define AG_TABLE "weights/arity/arity.tsv"
#define AG_RULE "seed/gold_arity_label.c"
#define AG_NPROTO 3
#define AG_NCOUNT 9
#define AG_KEYS 243
#define AG_PATH 4400
#define AG_LINE 256
#define AG_STAGE "# stage arity: 243 keys, generated by `tools/arity-gen.cx --write` from seed/gold_arity_label.c -- do not edit\n"
#define AG_F1 "#field\tproto\tnone\tfixed\tvariadic\n"
#define AG_F2 "#field\tnpar\t0\t1\t2\t3\t4\t5\t6\t7\t8\n"
#define AG_F3 "#field\tnargs\t0\t1\t2\t3\t4\t5\t6\t7\t8\n"
#define AG_FH "#head\ty\t-\taccept\ttoo-few-arguments\ttoo-many-arguments\n"
#define AG_COL "proto\tnpar\tnargs\t=> y\n"

static const char *ag_proto[AG_NPROTO] = {"none", "fixed", "variadic"};
static const char *ag_head[4] = {"-", "accept", "too-few-arguments", "too-many-arguments"};
static char ag_root[AG_PATH];
static int ag_bad;

static int ag_fail(const char *w) {
    sy_eprintf("arity-gen\tFAIL\t%s\n", w);
    ag_bad = 1;
    return 1;
}

static size_t ag_len(const char *s) {
    size_t n = 0;
    while (s[n]) n++;
    return n;
}

static int ag_same(const char *a, size_t an, const char *b, size_t bn) {
    size_t i;
    if (an != bn) return 0;
    for (i = 0; i < an; i++) if (a[i] != b[i]) return 0;
    return 1;
}

static int ag_eqz(const char *a, size_t an, const char *b) {
    return ag_same(a, an, b, ag_len(b));
}

static int ag_app(char *dst, size_t cap, size_t *n, const char *s) {
    size_t i = 0;
    while (s[i]) {
        if (*n + 1 >= cap) return -1;
        dst[*n] = s[i];
        *n += 1;
        i++;
    }
    dst[*n] = 0;
    return 0;
}

/* one line without its newline; 0 when the buffer is exhausted */
static int ag_row(const char *b, size_t n, size_t *at, const char **s, size_t *len) {
    size_t i = *at;
    if (i >= n) return 0;
    {
        size_t e = i;
        while (e < n && b[e] != '\n') e++;
        *s = b + i;
        *len = e - i;
        *at = (e < n) ? e + 1 : n;
    }
    return 1;
}

/* the rule form's output: words[0] is "table" or "call" plus its arguments */
static char *ag_rule(int nwords, char **words, size_t *n) {
    char bound[AG_PATH], com[AG_PATH], src[AG_PATH];
    char *argv[16];
    char *out = 0;
    int rc, i;
    if (cx_fmt(bound, sizeof bound, "%s/tools/bound", ag_root)
        || cx_fmt(com, sizeof com, "%s/unisacc.com", ag_root)
        || cx_fmt(src, sizeof src, "%s/%s", ag_root, AG_RULE))
        return 0;
    argv[0] = bound;
    argv[1] = "50";
    argv[2] = "sh";
    argv[3] = com;
    argv[4] = src;
    argv[5] = "--";
    for (i = 0; i < nwords; i++) argv[6 + i] = words[i];
    argv[6 + nwords] = 0;
    rc = cx_runv_timeout(argv, 55, &out, n);
    if (rc != 0 || !out) return 0;
    return out;
}

static int ag_head_line(const char *b, size_t n, size_t *at, const char *want, const char *what) {
    const char *line;
    size_t ln, wn;
    if (!ag_row(b, n, at, &line, &ln)) return ag_fail("header-short");
    wn = ag_len(want);
    if (wn > 0 && want[wn - 1] == '\n') wn--;      /* the macro carries the newline; the row does not */
    if (!ag_same(line, ln, want, wn)) return ag_fail(what);
    return 0;
}

static int ag_header(const char *b, size_t n, size_t *at) {
    if (ag_head_line(b, n, at, AG_STAGE, "header-stage")) return 1;
    if (ag_head_line(b, n, at, AG_F1, "header-field-proto")) return 1;
    if (ag_head_line(b, n, at, AG_F2, "header-field-npar")) return 1;
    if (ag_head_line(b, n, at, AG_F3, "header-field-nargs")) return 1;
    if (ag_head_line(b, n, at, AG_FH, "header-head")) return 1;
    if (ag_head_line(b, n, at, AG_COL, "header-column")) return 1;
    return 0;
}

static int ag_is_head(const char *s, size_t n) {
    int i;
    for (i = 0; i < 4; i++) if (ag_eqz(s, n, ag_head[i])) return 1;
    return 0;
}

/* the rows of one source must be the cartesian product with a head class label, in key order */
static int ag_rows(const char *b, size_t n, size_t *at, const char *what) {
    const char *line;
    size_t ln;
    char exp[AG_LINE];
    int j, k, m;
    for (j = 0; j < AG_NPROTO; j++) {
        for (k = 0; k < AG_NCOUNT; k++) {
            for (m = 0; m < AG_NCOUNT; m++) {
                size_t en;
                if (!ag_row(b, n, at, &line, &ln)) return ag_fail(what);
                if (cx_fmt(exp, sizeof exp, "%s\t%d\t%d\t", ag_proto[j], k, m)) return ag_fail("key-fmt");
                en = ag_len(exp);
                if (ln <= en) return ag_fail("row-short");
                if (!ag_same(line, en, exp, en)) return ag_fail("key-order");
                if (!ag_is_head(line + en, ln - en)) return ag_fail("label");
            }
        }
    }
    return 0;
}

static int ag_no_extra(const char *b, size_t n, size_t *at, const char *what) {
    const char *line;
    size_t ln;
    if (ag_row(b, n, at, &line, &ln)) return ag_fail(what);
    return 0;
}

static int ag_check(void) {
    char path[AG_PATH];
    char *buf, *rule;
    size_t n = 0, rn = 0, at = 0, rat = 0, rows_at;
    char *words[1];
    if (cx_fmt(path, sizeof path, "%s/%s", ag_root, AG_TABLE)) return ag_fail("path");
    buf = cx_read(path, &n);
    if (!buf) return ag_fail("cannot read table");
    if (ag_header(buf, n, &at)) return 1;
    rows_at = at;
    if (ag_rows(buf, n, &at, "row-count")) return 1;
    if (ag_no_extra(buf, n, &at, "row-count-extra")) return 1;
    words[0] = "table";
    rule = ag_rule(1, words, &rn);
    if (!rule) return ag_fail("rule-run");
    if (ag_rows(rule, rn, &rat, "rule-row-count")) return 1;
    if (ag_no_extra(rule, rn, &rat, "rule-row-count-extra")) return 1;
    if (n - rows_at != rn) return ag_fail("rule-len");
    if (!ag_same(buf + rows_at, n - rows_at, rule, rn)) return ag_fail("rule-diff");
    if (!ag_bad) sy_eprintf("arity-gen\tCHECK\tkeys=%d\n", AG_KEYS);
    return ag_bad;
}

static int ag_write(void) {
    char path[AG_PATH];
    static char whole[65536];
    size_t on = 0;
    char *rule, *words[1];
    size_t rn = 0, rat = 0;
    size_t i;
    words[0] = "table";
    rule = ag_rule(1, words, &rn);
    if (!rule) return ag_fail("rule-run");
    if (ag_rows(rule, rn, &rat, "rule-row-count")) return 1;
    if (ag_no_extra(rule, rn, &rat, "rule-row-count-extra")) return 1;
    if (ag_app(whole, sizeof whole, &on, AG_STAGE)
        || ag_app(whole, sizeof whole, &on, AG_F1)
        || ag_app(whole, sizeof whole, &on, AG_F2)
        || ag_app(whole, sizeof whole, &on, AG_F3)
        || ag_app(whole, sizeof whole, &on, AG_FH)
        || ag_app(whole, sizeof whole, &on, AG_COL))
        return ag_fail("header-long");
    for (i = 0; i < rn; i++) {
        if (on + 1 >= sizeof whole) return ag_fail("table-long");
        whole[on++] = rule[i];
    }
    whole[on] = 0;
    if (cx_fmt(path, sizeof path, "%s/%s", ag_root, AG_TABLE)) return ag_fail("path");
    if (cx_write(path, whole, on)) return ag_fail("cannot write table");
    if (!ag_bad) sy_eprintf("arity-gen\tWRITE\tkeys=%d\n", AG_KEYS);
    return ag_bad;
}

static int ag_call(char **words) {
    char *out;
    size_t n = 0;
    out = ag_rule(4, words, &n);
    if (!out) return ag_fail("rule-run");
    sy_printf("%s", out);
    return 0;
}

int main(int argc, char **argv) {
    if (argc >= 3 && tx_eqz(argv[1], "--check")) {
        if (cx_fmt(ag_root, sizeof ag_root, "%s", argv[2])) return 2;
        return ag_check();
    }
    if (argc >= 3 && tx_eqz(argv[1], "--write")) {
        if (cx_fmt(ag_root, sizeof ag_root, "%s", argv[2])) return 2;
        return ag_write();
    }
    if (argc == 5 && tx_eqz(argv[1], "call")) {
        char *words[4];
        if (cx_fmt(ag_root, sizeof ag_root, ".")) return 2;
        words[0] = "call";
        words[1] = argv[2];
        words[2] = argv[3];
        words[3] = argv[4];
        return ag_call(words);
    }
    sy_eprintf("usage: arity-gen --check ROOT | --write ROOT | call PROTO NPAR NARGS\n");
    return 2;
}
