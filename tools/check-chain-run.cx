/* Fake-chain only: no product construction. Optional ROOT OUT RUNNER executable.
 * The checker reexecutes itself as a fake candidate/watch; retains all evidence. */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.posix
#pragma unisa use sys.io
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use sys.sha
static int bad;
static void ck(int yes,const char *s) { sy_printf("%s\tchain-run.%s\n",yes?"PASS":"FAIL",s); if(!yes) bad++; }
static void put(const char *p,const char *s) { if(cx_write(p,s,strlen(s)))exit(2); }
/* Callers explicitly choose the phase-table grammar; paths never select behavior. */
static void put_plan(const char *p,const char *s) {
        FILE *f=fopen(p,"wb");if(!f)exit(2);char prev[256]="-";
        while(*s){const char *e=strchr(s,'\n');if(!e)exit(2);char line[14000];size_t n=e-s;if(tx_copy(line,sizeof line,s,n))exit(2);
            int order,bound;char id[256],domain[4400];
            if(*line=='#')fprintf(f,"%s\n",line);
            else { int tabs=0;for(char *q=line;*q;q++)if(*q=='\t')tabs++;
                if(tabs==3&&sscanf(line,"%d %255s %4399s %d",&order,id,domain,&bound)==4){fprintf(f,"%d\t%s\t%s\t%d\t%s\t-\t1\n",order,id,domain,bound,prev);if(!strstr(id,"-obj-")&&tx_copy(prev,sizeof prev,id,strlen(id)))exit(2);}
                else fprintf(f,"%s\n",line);
            }s=e+1;
        }if(fclose(f))exit(2);
}
static void join(char *p,const char *a,const char *b) { if(cx_fmt(p,4400,"%s/%s",a,b)) exit(2); }
static int protocol_word(int c) { return (c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='_'; }
/* These files are line/field evidence, not arbitrary text. Accept only the wire alphabet
   and match complete identifier components while retaining every requested separator. */
static int has(const char *p,const char *s) {
    size_t n=0,q=strlen(s);char *b=cx_read(p,&n);int yes=0;
    if(!b||!q){free(b);return 0;}
    long rows=tx_fields(b,(long)n,'\n');
    for(long row=0;row<rows;row++) {
        long ro,rn;if(tx_field(b,(long)n,'\n',row,&ro,&rn)){free(b);return 0;}
        long fields=tx_fields(b+ro,rn,'\t');
        for(long field=0;field<fields;field++) {
            long fo,fn;if(tx_field(b+ro,rn,'\t',field,&fo,&fn)){free(b);return 0;}
            for(long i=0;i<fn;i++){int c=(unsigned char)b[ro+fo+i];
                if(!protocol_word(c)&&c!='-'&&c!='/'&&c!='.'&&c!=':'&&c!='='&&c!='+'&&c!=','&&c!=' '){free(b);return 0;}
            }
        }
    }
    for(size_t at=0;at<n;) {
        size_t end=at+1;int word=protocol_word((unsigned char)b[at]);
        while(word&&end<n&&protocol_word((unsigned char)b[end]))end++;
        if(q<=n-at&&!memcmp(b+at,s,q)&&(!protocol_word((unsigned char)s[q-1])||at+q==n||!protocol_word((unsigned char)b[at+q]))){yes=1;break;}
        at=end;
    }
    free(b);return yes;
}
static int fake(int argc,char **argv) {
    const char *out=0,*phase=0,*mode="ok"; int i;
    for(i=1;i<argc;i++) { if(!strcmp(argv[i],"--out")&&i+1<argc) out=argv[++i]; else if(!strcmp(argv[i],"--until")&&i+1<argc) phase=argv[++i]; else if(!strcmp(argv[i],"--fixture-case")&&i+1<argc) mode=argv[++i]; }
    if(!out||!phase) return 0; /* watch */
    for(i=1;i<argc;i++) if(!strcmp(argv[i],"--recheck-only")) {
        /* the runner's full re-check attempt before compare/pack: no checkpoint, no phase work */
        char rp[4400];const char *m=getenv("UNISACC_CHAIN_SHAMEMO"),*id=getenv("UNISACC_CHAIN_RECHECK_ID");
        { const char *dv=getenv("UNISACC_CHAIN_SHAMEMO_DERIVED");join(rp,out,"derived-env");FILE *df=fopen(rp,"ab");fprintf(df,"%s-recheck\t%s\n",phase,dv?dv:"0");fclose(df); }
        join(rp,out,"memo-env");FILE *rf=fopen(rp,"ab");fprintf(rf,"%s-recheck\t%s\t%s\t%s\n",phase,m?"on":"off",m?m:"-",id?id:"-");fclose(rf);
        return !strcmp(mode,"recheck-fail")?9:0;
    }
    if(!strncmp(mode,"parallel",8)||!strcmp(mode,"siblings")) {
        char trace[4400],row[600];join(trace,out,"events");int fd=sy_open(trace,O_WRONLY|O_CREAT|O_APPEND,0644);
        cx_fmt(row,sizeof row,"START\t%s\t%ld\n",phase,sy_now_ms());sy_write_all(fd,row,strlen(row));
        if(!strcmp(mode,"siblings")) {
            char mark[4400],leaf[300];cx_fmt(leaf,sizeof leaf,"ready-%s",phase);join(mark,out,leaf);put(mark,"ready\n");
            if(!strcmp(phase,"a")) {
                int ready=0;for(int n=0;n<1000;n++){ready=1;const char *ids[]={"b","c","d"};for(int j=0;j<3;j++){cx_fmt(leaf,sizeof leaf,"ready-%s",ids[j]);join(mark,out,leaf);if(!sy_exists(mark))ready=0;}if(ready)break;sy_sleep_ms(2);}
                sy_close(fd);return ready?7:9;
            }
            if(!strcmp(phase,"b")||!strcmp(phase,"c")||!strcmp(phase,"d")) {
                join(mark,out,"chain-run.tsv");int observed=0;for(int n=0;n<1000;n++){if(has(mark,"reason=first-failure")){observed=1;break;}sy_sleep_ms(2);}if(!observed){sy_close(fd);return 9;}
            }
        }
        if(!strcmp(mode,"parallel-timeout")&&!strcmp(phase,"a")){char once[4400];join(once,out,"timeout-once");if(!sy_exists(once)){put(once,"1");sy_sleep_ms(4000);sy_close(fd);return 124;}}
        sy_sleep_ms(150);cx_fmt(row,sizeof row,"END\t%s\t%ld\n",phase,sy_now_ms());sy_write_all(fd,row,strlen(row));sy_close(fd);
    }
    char p[4400]; join(p,out,"calls"); FILE *f=fopen(p,"ab"); fprintf(f,"%s\n",phase); fclose(f);
    { /* what the runner handed this phase: memo path and identity, or nothing */
        const char *m=getenv("UNISACC_CHAIN_SHAMEMO"),*id=getenv("UNISACC_CHAIN_SHAMEMO_ID");
        join(p,out,"memo-env"); f=fopen(p,"ab"); fprintf(f,"%s\t%s\t%s\t%s\n",phase,m?"on":"off",m?m:"-",id?id:"-"); fclose(f);
        const char *dv=getenv("UNISACC_CHAIN_SHAMEMO_DERIVED"); join(p,out,"derived-env"); f=fopen(p,"ab"); fprintf(f,"%s\t%s\n",phase,dv?dv:"0"); fclose(f);
    }
    if(!strcmp(mode,"compare-retry")&&!strcmp(phase,"compare")){char once[4400];join(once,out,"compare-once");if(!sy_exists(once)){put(once,"1");return 137;}}
    if(!strcmp(mode,"seg")) sy_sleep_ms(1100); /* longer than segment minus bound (5 s - 4 s): the next phase cannot fit */
    if(!strcmp(mode,"fail")) { fprintf(stderr,"FIRST_REAL_FAILURE\n"); return 7; }
    if(!strcmp(mode,"exhaust")) return 124;
    if(!strcmp(mode,"slow")) { sy_sleep_ms(2200); return 124; }
    join(p,out,"once");
    if(!strcmp(mode,"resume")&&!sy_exists(p)) { put(p,"timeout\n"); return 137; }
    if((!strcmp(mode,"tree")||!strcmp(mode,"dirty"))&&!sy_exists(p)) {
        put(p,"started\n");int child=fork();if(child<0)return 2;
        if(!child){sy_setpgid(0,0);int grand=fork();if(grand<0)_exit(2);if(grand)_exit(0);
            char leaf[4400],id[100];join(leaf,out,"residual-pid");cx_fmt(id,sizeof id,"%d\n",getpid());put(leaf,id);
            for(int t=0;t<3000;t++){sy_sleep_ms(10);join(leaf,out,"residual-alive");put(leaf,"live\n");}_exit(0);
        }
        sy_sleep_ms(10000);return 124;
    }
    if(!strcmp(mode,"missing")) return 0;
    if(!strncmp(mode,"jobs-",5)&&!strcmp(phase,"jobs-tool")) {
        join(p,out,"checkpoint.tsv");f=fopen(p,"ab");fprintf(f,"DONE\tjobs-tool-0-start\tx\n");fclose(f);
        if(!strcmp(mode,"jobs-forged"))return 75;
        if(!strcmp(mode,"jobs-internal"))return 76;
        char once[4400];join(once,out,"jobs-once");
        if(!strcmp(mode,"jobs-expire")&&!sy_exists(once)) {
            put(once,"1");size_t n=0;char *cp=cx_read(p,&n),hash[65];if(!cp||sy_sha256_hex(cp,(long)n,hash))return 2;free(cp);
            printf("CANDIDATE_SEGMENT\t%s\t%s\n",getenv("UNISACC_CHAIN_SEGMENT_TOKEN"),hash);return 75;
        }
        f=fopen(p,"ab");fprintf(f,"DONE\tjobs-tool-0-finish\tx\n");fclose(f);
    }
    join(p,out,"checkpoint.tsv"); f=fopen(p,"ab");fprintf(f,"DONE\t%s\twall_ms=1\tsha=-\n",phase);fclose(f);
    if(!strcmp(mode,"receipt-race")&&!strcmp(phase,"snap")) return 137;
    if(!strcmp(phase,"pack")) {
        char dir[4400],file[4400],hash[65],body[5000];join(dir,out,"ape-final");sy_mkdir(dir,0755);join(file,dir,"unisacc-next.com");put(file,"fake");
        if(sy_sha256_hex("fake",4,hash)) return 2;
        cx_fmt(body,sizeof body,"unisacc-next.com\t%s\tsha=%s\tbytes=4\n",file,hash);join(p,dir,"ape-receipt.txt");put(p,body);
    }
    return 0;
}
static char root[4400],base[4400],self[4400],runner[4400];
static int call(const char *name,const char *mode,const char *deadline,const char *maxr,const char *extra) {
    char dir[4400];join(dir,base,name);sy_mkdir(dir,0755);
    char *v[28]={runner,"--rev","aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","--out",dir,"--candidate",self,"--watch",self,"--deadline-s",(char*)deadline,"--max-resumes",(char*)maxr,0};
    int k=13;if(extra) v[k++]=(char*)extra;
    if(!strcmp(mode,"parallel-one")){v[k++]="--parallel";v[k++]="1";}
    v[k++]="--";v[k++]="--fixture-case";v[k++]=(char*)mode;v[k]=0;
    char *o=0;size_t n=0;int rc;
    if(!strcmp(mode,"dirty")){char *ev[28]={"env","UNISACC_CHAINRUN_FAULT=unconfirmed",0};for(int j=0;j<=k;j++)ev[j+2]=v[j];rc=cx_runv_timeout(ev,12,&o,&n);}
    else rc=cx_runv_timeout(v,12,&o,&n);
    char p[4400];join(p,dir,"check.stdout"); if(o) { if(cx_write(p,o,n)) exit(2);free(o); } return rc;
}
static int events(const char *name,int serial,int retry) {
    char p[4400],dir[4400],line[600],kind[20],id[256];join(dir,base,name);join(p,dir,"events");FILE *f=fopen(p,"rb");if(!f)return 0;
    int live=0,peak=0,valid=1,starts[7]={0},ended[7]={0};const char *ids[]={"snap","a","b","c","d","e","pack"};
    while(fgets(line,sizeof line,f)) {
        long when;if(sscanf(line,"%19s %255s %ld",kind,id,&when)!=3){valid=0;break;}int k=-1;for(int i=0;i<7;i++)if(!strcmp(ids[i],id))k=i;if(k<0){valid=0;break;}
        if(!strcmp(kind,"START")) {
            if(k>0&&!ended[0])valid=0;
            if(k==6)for(int i=1;i<6;i++)if(!ended[i])valid=0;
            if(k==5&&starts[1]-(retry?1:0)>ended[1])valid=0;
            /* A real timeout has no END event; its next attempt follows owner cleanup. */
            if(retry&&k==1&&starts[k]==1)live--;
            starts[k]++;live++;if(live>peak)peak=live;
        } else if(!strcmp(kind,"END")){ended[k]++;live--;}
        else valid=0;
        if(live<0||live>4)valid=0;
    }
    fclose(f);for(int i=0;i<7;i++)if(ended[i]!=1||starts[i]!=(retry&&i==1?2:1))valid=0;
    return valid&&!live&&(serial?peak==1:peak==4);
}
/* T11 segment/supervisor/memo-routing cases: `--segments ROOT OUT [RUNNER]` (batch chain-run-segments). */
static int runv(const char *name,const char *mode,const char *deadline,const char **opts,const char **env,int secs) {
    char dir[4400];join(dir,base,name);sy_mkdir(dir,0755);
    char *v[48];int k=0;
    if(env){v[k++]="env";for(int i=0;env[i];i++)v[k++]=(char*)env[i];}
    v[k++]=runner;v[k++]="--rev";v[k++]="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";v[k++]="--out";v[k++]=dir;v[k++]="--candidate";v[k++]=self;v[k++]="--watch";v[k++]=self;
    v[k++]="--deadline-s";v[k++]=(char*)deadline;v[k++]="--max-resumes";v[k++]="3";
    for(int i=0;opts&&opts[i];i++)v[k++]=(char*)opts[i];
    v[k++]="--";v[k++]="--fixture-case";v[k++]=(char*)mode;v[k]=0;
    char *o=0;size_t n=0;int rc=cx_runv_timeout(v,secs,&o,&n);
    static int serial;char p[4400],leaf[80];cx_fmt(leaf,sizeof leaf,"check-%d.stdout",++serial);char d2[4400];join(d2,base,name);join(p,d2,leaf);
    if(o){if(cx_write(p,o,n))exit(2);free(o);}return rc;
}
static int count(const char *file,const char *needle) {
    size_t n=0;char *b=cx_read(file,&n);int k=0;if(!b)return -1;
    for(char *s=b;(s=strstr(s,needle));s+=strlen(needle))k++;free(b);return k;
}
typedef struct { long end; int attempts,resumes,ma,mr,width,segments,mseg,owed,fields; } budget_row;
static budget_row budget_of(const char *name) {
    char p[4400],d[4400];join(d,base,name);join(p,d,"chain-run.budget");size_t n=0;char *b=cx_read(p,&n);budget_row r;memset(&r,0,sizeof r);
    if(b)r.fields=sscanf(b,"%ld %d %d %d %d %d %d %d %d",&r.end,&r.attempts,&r.resumes,&r.ma,&r.mr,&r.width,&r.segments,&r.mseg,&r.owed);free(b);return r;
}
static void file_of(char *p,const char *name,const char *leaf) { char d[4400];join(d,base,name);join(p,d,leaf); }
static int segment_cases(const char *plan) {
    char p[4400],q[4400];budget_row b1,b2;
    const char *seg[]={"--segment-s","5","--max-segments","9",0};
    /* four serial phases, bound 4, each fake phase takes 1.1 s: exactly one phase fits a 5 s segment */
    put_plan(plan,"0\tsnap\t-\t4\n1\ta\t-\t4\n2\tb\t-\t4\n3\tpack\t-\t4\n");
    int rc=runv("seg","seg","60",seg,0,12);
    ck(rc==75,"segment-expiry-rc75");
    file_of(p,"seg","chain-run.tsv");file_of(q,"seg","calls");
    ck(has(p,"\tn=1\tstart\tsegment-s=5\tmax=9\n")&&has(p,"\tn=1\texpired\tnext=a\t"),"segment-expiry-row-names-next");
    ck(!has(p,"BLOCKER")&&count(p,"\trc=0\tresidue=0\t")==1&&count(p,"ATTEMPT\t")==1&&has(p,"cleanup=0 residue=0"),"segment-expiry-clean-no-child-killed");
    ck(count(q,"\n")==1&&has(q,"snap\n"),"segment-ran-only-what-fit");
    b1=budget_of("seg");ck(b1.fields==9&&b1.segments==1&&b1.mseg==9&&b1.attempts==1&&!b1.owed,"segment-budget-persisted");
    rc=runv("seg","seg","60",seg,0,12);b2=budget_of("seg");
    ck(rc==75&&count(q,"\n")==2&&count(q,"snap\n")==1&&has(q,"a\n"),"continued-segment-skips-completed-phase");
    ck(b2.end==b1.end&&b1.end>0,"total-deadline-not-reset-across-segments");
    ck(b2.segments==2&&b2.attempts==2,"segment-and-attempt-counts-continue");
    rc=runv("seg","seg","60",seg,0,12);ck(rc==75,"third-segment-continues");
    rc=runv("seg","seg","60",seg,0,12);
    ck(rc==0&&has(p,"PREPARED\tpack"),"final-segment-prepared");
    ck(count(q,"\n")==4&&count(q,"snap\n")==1&&count(q,"a\n")==1&&count(q,"b\n")==1&&count(q,"pack\n")==1,"every-phase-exactly-once-across-segments");
    ck(count(p,"\texpired\t")==3&&count(p,"\tstart\tsegment-s=5")==4&&budget_of("seg").end==b1.end,"segment-rows-and-deadline-stable");
    /* the persisted total deadline governs a later segment: a segment is not a fresh deadline */
    rc=runv("segdl","seg","60",seg,0,12);b1=budget_of("segdl");
    {
        char row[200],bp[4400];file_of(bp,"segdl","chain-run.budget");
        cx_fmt(row,sizeof row,"%ld %d %d %d %d %d %d %d %d\n",sy_now_ms()-1,b1.attempts,b1.resumes,b1.ma,b1.mr,b1.width,b1.segments,b1.mseg,b1.owed);put(bp,row);
    }
    int rc2=runv("segdl","seg","60",seg,0,12);file_of(p,"segdl","chain-run.tsv");file_of(q,"segdl","calls");
    ck(rc==75&&rc2==3&&has(p,"reason=deadline")&&count(q,"\n")==1,"passed-total-deadline-stops-next-segment");
    ck(runv("segdl","seg","60",seg,0,12)==3&&count(q,"\n")==1,"deadline-stop-is-not-reset-by-reinvocation");
    /* segment cap */
    const char *cap[]={"--segment-s","5","--max-segments","2",0},*raised[]={"--segment-s","5","--max-segments","5",0};
    rc=runv("segcap","seg","60",cap,0,12);rc2=runv("segcap","seg","60",cap,0,12);
    int rc3=runv("segcap","seg","60",cap,0,12);file_of(p,"segcap","chain-run.tsv");file_of(q,"segcap","calls");
    ck(rc==75&&rc2==75&&rc3==3&&has(p,"reason=segments-exhausted"),"segment-cap-stops-rc3");
    ck(count(q,"\n")==2&&budget_of("segcap").segments==2,"segment-cap-no-phase-after-cap");
    ck(runv("segcap","seg","60",raised,0,12)==2&&count(q,"\n")==2,"segment-cap-cannot-be-raised");
    /* the attempt cap is shared by all segments */
    const char *att[]={"--segment-s","5","--max-segments","9","--max-attempts","2",0};
    rc=runv("segatt","seg","60",att,0,12);rc2=runv("segatt","seg","60",att,0,12);rc3=runv("segatt","seg","60",att,0,12);
    file_of(p,"segatt","chain-run.tsv");file_of(q,"segatt","calls");
    /* attempt 1 in segment 1, attempt 2 in segment 2; the cap then stops segment 2 itself with work left */
    ck(rc==75&&rc2==3&&rc3==3&&count(p,"reason=attempts-exhausted")==2&&count(q,"\n")==2&&budget_of("segatt").attempts==2,"attempt-cap-shared-across-segments");
    /* a segment no phase could ever fit is refused before any child or state */
    const char *tiny[]={"--segment-s","3",0};
    ck(runv("segtiny","seg","60",tiny,0,12)==2,"segment-shorter-than-bound-refused");
    file_of(q,"segtiny","calls");file_of(p,"segtiny","chain-run.budget");ck(!sy_exists(q)&&!sy_exists(p),"segment-refusal-before-child-and-budget");
    const char *huge[]={"--segment-s","271",0};
    ck(runv("seghuge","seg","60",huge,0,12)==2,"segment-over-270-refused");
    /* an owed resume (segment ended between a retryable failure and its observation) is settled first */
    rc=runv("segowed","seg","60",seg,0,12);b1=budget_of("segowed");
    {
        char row[200],bp[4400];file_of(bp,"segowed","chain-run.budget");
        cx_fmt(row,sizeof row,"%ld %d %d %d %d %d %d %d 1\n",b1.end,b1.attempts,b1.resumes,b1.ma,b1.mr,b1.width,b1.segments,b1.mseg);put(bp,row);
    }
    rc2=runv("segowed","seg","60",seg,0,12);b2=budget_of("segowed");file_of(p,"segowed","chain-run.tsv");
    ck(rc==75&&rc2==75&&has(p,"\towed=settled\n")&&b2.resumes==b1.resumes+1&&!b2.owed&&b2.width==b1.width-1,"owed-resume-settled-before-new-work");
    sy_printf("CHECK_CHAIN_RUN_SEGMENTS\tfailed=%d\tevidence=%s\n",bad,base);return bad?1:0;
}
/* `--supervise ROOT OUT [RUNNER]` (batch chain-run-supervise): the supervisor, and the full re-check
   attempt the runner places before compare and before pack. */
static int supervise_cases(const char *plan) {
    char p[4400],q[4400];int rc;
    put_plan(plan,"0\tsnap\t-\t4\n1\ta\t-\t4\n2\tb\t-\t4\n3\tpack\t-\t4\n");
    /* supervisor: segments continue without a caller, each phase once, caps still stop it */
    const char *sup[]={"--supervise","--runner",runner,"--segment-s","5","--max-segments","9",0};
    rc=runv("sup","seg","60",sup,0,25);file_of(p,"sup","chain-run.tsv");file_of(q,"sup","calls");
    ck(rc==0&&has(p,"PREPARED\tpack"),"supervisor-continues-to-prepared");
    ck(count(q,"\n")==4&&count(q,"snap\n")==1&&count(q,"a\n")==1&&count(q,"b\n")==1&&count(q,"pack\n")==1,"supervisor-no-phase-repeated");
    ck(count(p,"SUPERVISE\t")==4&&count(p,"\trc=75\tresidue=0\n")==3&&count(p,"\texpired\t")==3&&budget_of("sup").segments==4,"supervisor-one-row-per-segment");
    const char *supcap[]={"--supervise","--runner",runner,"--segment-s","5","--max-segments","2",0};
    rc=runv("supcap","seg","60",supcap,0,25);file_of(p,"supcap","chain-run.tsv");file_of(q,"supcap","calls");
    ck(rc==3&&has(p,"reason=segments-exhausted")&&count(q,"\n")==2,"supervisor-stops-at-segment-cap");
    const char *supbare[]={"--supervise","--runner",runner,0};
    ck(runv("supbare","seg","60",supbare,0,12)==2,"supervisor-requires-segment-and-cap");
    file_of(q,"supbare","calls");ck(!sy_exists(q),"supervisor-refusal-before-child");
    /* a failing phase is a stop, never a continue */
    rc=runv("supfail","fail","60",sup,0,25);file_of(p,"supfail","chain-run.tsv");
    ck(rc==7&&has(p,"reason=first-failure")&&count(p,"SUPERVISE\t")==1,"supervisor-stops-on-first-failure");
    /* memo routing and the full re-check before compare and pack */
    put_plan(plan,"0\tsnap\t-\t4\n1\tcompare\t-\t4\n2\tpack\t-\t4\n");
    rc=runv("memo","ok","60",0,0,12);file_of(p,"memo","chain-run.tsv");file_of(q,"memo","memo-env");
    {
        char idp[4400],hex[65],want[9000],mp[4400];size_t n=0;file_of(idp,"memo","chain-run.identity");file_of(mp,"memo","chain-sha.memo");
        char *id=cx_read(idp,&n);if(!id||sy_sha256_hex(id,(long)n,hex))return 2;free(id);
        cx_fmt(want,sizeof want,"snap\ton\t%s\t%s\n",mp,hex);
        ck(rc==0&&has(q,want),"memo-bound-to-output-identity");
        /* order is the contract: recheck (memo removed) immediately before each of the two phases */
        cx_fmt(want,sizeof want,"compare-recheck\toff\t-\t%s\ncompare\ton\t%s\t%s\npack-recheck\toff\t-\t%s\npack\ton\t%s\t%s\n",hex,mp,hex,hex,mp,hex);
        ck(has(q,want)&&count(q,"-recheck\t")==2,"full-recheck-without-memo-runs-before-compare-and-before-pack");
    }
    ck(has(p,"phase=snap\trc=0\tresidue=0\tbound=4\tmemo=on\n")&&has(p,"phase=compare-recheck\trc=0\tresidue=0\tbound=4\tmemo=off\n")&&has(p,"phase=pack-recheck\trc=0\tresidue=0\tbound=4\tmemo=off\n")&&count(p,"ATTEMPT\t")==5,"recheck-is-its-own-bounded-attempt");
    file_of(q,"memo","derived-env");ck(!has(q,"\t1\n")&&has(q,"snap\t0\n"),"derived-memo-off-by-default");
    const char *derived[]={"--memo-derived",0};
    rc=runv("memoderived","ok","60",derived,0,12);file_of(q,"memoderived","derived-env");
    ck(rc==0&&has(q,"snap\t1\n")&&has(q,"compare-recheck\t0\n")&&has(q,"compare\t1\n")&&has(q,"pack-recheck\t0\n")&&has(q,"pack\t1\n"),"derived-memo-only-with-flag-and-never-in-recheck");
    const char *forged[]={"UNISACC_CHAIN_SHAMEMO=/forged/memo","UNISACC_CHAIN_SHAMEMO_ID=forged","UNISACC_CHAIN_RECHECK_ID=forged","UNISACC_CHAIN_SHAMEMO_DERIVED=1",0};
    rc=runv("memoenv","ok","60",0,forged,12);file_of(q,"memoenv","memo-env");
    ck(rc==0&&has(q,"compare-recheck\toff\t-\t")&&has(q,"pack-recheck\toff\t-\t")&&!has(q,"forged"),"inherited-memo-environment-never-reaches-a-phase");
    file_of(q,"memoenv","derived-env");ck(!has(q,"\t1\n"),"inherited-derived-opt-in-never-reaches-a-phase");
    const char *nomemo[]={"--no-sha-memo",0};
    rc=runv("memooff","ok","60",nomemo,forged,12);file_of(q,"memooff","memo-env");
    ck(rc==0&&has(q,"snap\toff\t-\t-\n")&&has(q,"compare\toff\t-\t-\n")&&has(q,"pack\toff\t-\t-\n")&&!has(q,"-recheck"),"no-sha-memo-phase-call-is-the-full-walk");
    rc=runv("recheckfail","recheck-fail","60",0,0,12);file_of(p,"recheckfail","chain-run.tsv");file_of(q,"recheckfail","calls");
    ck(rc==9&&has(p,"BLOCKER\tphase=compare-recheck\treason=recheck-failed")&&!has(q,"compare\n")&&!has(q,"pack\n"),"failed-recheck-blocks-the-phase");
    rc=runv("compareretry","compare-retry","60",0,0,12);file_of(p,"compareretry","chain-run.tsv");file_of(q,"compareretry","memo-env");
    ck(rc==0&&has(p,"RESUME\t")&&count(q,"compare-recheck\t")==2&&count(q,"compare\ton\t")==2&&count(q,"pack-recheck\t")==1,"retried-phase-needs-a-new-recheck");
    sy_printf("CHECK_CHAIN_RUN_SUPERVISE\tfailed=%d\tevidence=%s\n",bad,base);return bad?1:0;
}
int main(int argc,char **argv) {
    if(argc>1&&!strcmp(argv[1],"--rev")) return fake(argc,argv);
    if(argc==2&&argv[1][0]=='/') return 0; /* fake watch */
    int segment_mode=argc>1&&!strcmp(argv[1],"--segments")?1:argc>1&&!strcmp(argv[1],"--supervise")?2:0;
    if(segment_mode){argv[1]=argv[0];argv++;argc--;}
    if(sy_realpath(".",root,sizeof root)<0||sy_realpath(argv[0],self,sizeof self)<0) return 2;
    char temp[4400];
    if(argc<3||sy_realpath(argv[1],root,sizeof root)<0||argv[2][0]!='/'||cx_fmt(temp,sizeof temp,"%s/chain-run-%ld",argv[2],sy_now_ms()))return 2;
    sy_mkdir(argv[2],0755);sy_mkdir(temp,0755);if(sy_realpath(temp,base,sizeof base)<0)return 2;
    { /* default -run passes the source path as argv[0]; the fake candidate/watch must be a native image */
        size_t sn=strlen(self);
        if(sn>3&&!strcmp(self+sn-3,".cx")) { char com[4400],nat[4400];join(com,root,"unisacc.com");join(nat,base,"self");char *v[]={"sh",com,self,"-o",nat,0};if(cx_runv_timeout(v,40,0,0)||sy_realpath(nat,self,sizeof self)<0)return 2; }
    }
    if(argc>3) { if(sy_realpath(argv[3],runner,sizeof runner)<0)return 2; }
    else { join(runner,base,"runner");char com[4400],src[4400];join(com,root,"unisacc.com");join(src,root,"tools/chain-run.cx");char *v[]={"sh",com,src,"-o",runner,0};if(cx_runv_timeout(v,40,0,0))return 2; }
    char p[4400];join(p,base,"build");sy_mkdir(p,0755);join(p,base,"build/chain-phases.tsv");put_plan(p,"# fake phases\n0\tsnap\t-\t55\n1\tctx\t-\t55\n2\tg2-lnx-x86_64-obj-0\t-\t55\n3\tg2-lnx-x86_64-obj-1\t-\t55\n4\tg2-lnx-x86_64-closure-prepare\t-\t55\n5\tg2-lnx-x86_64-closure\t-\t55\n6\tg2-lnx-x86_64-objects\t-\t55\n7\tg2-lnx-x86_64\t-\t55\n8\tg2-lnx-arm64-obj-0\t-\t55\n9\tg2-lnx-arm64-objects\t-\t55\n10\tpack\t-\t55\n");
    if(sy_chdir(base))return 2;
    join(p,base,"out");sy_mkdir(p,0755);if(sy_realpath(p,base,sizeof base)<0)return 2;
    if(segment_mode){char plan[4400];join(plan,base,"../build/chain-phases.tsv");return segment_mode==1?segment_cases(plan):supervise_cases(plan);}
    char protocol[4400];join(protocol,base,"protocol-evidence");
    put(protocol,"ATTEMPT\tphase=snapshot\trc=0\n");
    ck(!has(protocol,"phase=snap")&&has(protocol,"phase=snapshot"),"protocol-field-component-boundaries");
    put(protocol,"ATTEMPT\tphase=snap\trc=0\001\n");
    ck(!has(protocol,"rc=0"),"protocol-unknown-wire-byte-refused");
    ck(call("resume","resume","30","3",0)==0,"killed-resume");
    join(p,base,"resume/chain-run.tsv");ck(has(p,"RESUME\t")&&has(p,"PREPARED\tpack"),"persisted-evidence");
    ck(call("exhaust","exhaust","30","2",0)==3,"exhausted-rc3");
    join(p,base,"exhaust/chain-run.tsv");ck(has(p,"resumes-exhausted")&&!has(p,"phase=ctx"),"bounded-retries");
    ck(call("fail","fail","30","3",0)==7,"first-failure-rc");
    join(p,base,"fail/chain-run.tsv");ck(has(p,"BLOCKER\tphase=snap\treason=first-failure")&&!has(p,"RESUME\t")&&!has(p,"phase=ctx"),"first-failure-stops");
    ck(call("deadline","slow","2","3",0)==3,"deadline-rc3");
    join(p,base,"deadline/chain-run.tsv");ck(has(p,"reason=deadline"),"deadline-evidence");
    join(p,base,"reuse");sy_mkdir(p,0755);join(p,base,"reuse/checkpoint.tsv");put(p,"DONE\tsnap\twall_ms=8\tsha=-\n");
    ck(call("reuse","ok","30","3",0)==0,"checkpoint-reuse");
    join(p,base,"reuse/calls");ck(!has(p,"snap\n")&&has(p,"ctx\n"),"checkpoint-not-reexecuted");
    ck(!has(p,"-obj-")&&has(p,"g2-lnx-x86_64-closure\n")&&has(p,"g2-lnx-x86_64-objects\n")&&has(p,"g2-lnx-arm64-objects\n"),"batch-targets-not-legacy-object-boundaries");
    join(p,base,"reuse/ape-final/unisacc-next.com");put(p,"evil");
    ck(call("reuse","ok","30","3",0)==2,"owned-corrupt-pack-refused");
    join(p,base,"reuse/ape-final/unisacc-next.com");put(p,"fake");
    ck(call("reuse","ok","30","3",0)==0,"owned-valid-pack-reused");
    join(p,base,"stale");sy_mkdir(p,0755);join(p,base,"stale/checkpoint.tsv");put(p,"DONE\tpack\twall_ms=1\tsha=-\n");
    ck(call("stale","ok","30","3",0)==2,"unowned-pack-refused");
    ck(call("missing","missing","30","3",0)==2,"success-without-checkpoint-refused");
    ck(call("rehearse","ok","30","3","--rehearse")==2,"rehearse-missing-materials-refused");
    ck(call("exhaust","exhaust","30","2",0)==3,"resume-budget-not-reset");
    ck(call("race","receipt-race","30","3",0)==0,"kill-after-receipt-no-reexecution");
    join(p,base,"live");sy_mkdir(p,0755);join(p,base,"live/heartbeat.tsv");
    char hb[300];cx_fmt(hb,sizeof hb,"%ld\tsnap\t%d\t%ld\tstart\n",sy_wall_s(),sy_pid(),sy_getpgid(0));put(p,hb);
    ck(call("live","ok","30","3",0)==2,"live-heartbeat-refused");
    char plan[4400];join(plan,base,"../build/chain-phases.tsv");
    put_plan(plan,"0\tsnap\t-\t3\n1\tctx\t-\t4\n2\tpack\t-\t5\n");
    ck(call("budget","ok","30","3",0)==0,"phase-budget-accepted");
    join(p,base,"budget/chain-run.tsv");ck(has(p,"bound=3")&&has(p,"bound=4")&&has(p,"bound=5"),"phase-budget-read-not-fixed-55");
    ck(call("tree","tree","30","3",0)==0,"real-residue-tree-cleaned-resumed");
    join(p,base,"tree/chain-run.tsv");ck(has(p,"cleanup=1 residue=0")&&has(p,"RESUME\t"),"cleanup-terminal-proof-before-resume");
    join(p,base,"tree/residual-pid");size_t pn=0;char *pb=cx_read(p,&pn);int residual=pb?atoi(pb):0;free(pb);
    ck(residual>1&&sy_getpgid(residual)<0,"escaped-grandchild-gone");
    ck(call("dirty","dirty","30","3",0)==2,"cleanup-unconfirmed-refused");
    join(p,base,"dirty/chain-run.tsv");ck(has(p,"reason=surviving-processes")&&!has(p,"RESUME\t"),"unclean-never-resumed");
    put_plan(plan,"0\tsnap\t-\t56\n1\tpack\t-\t55\n");
    ck(call("overbound","ok","30","3",0)==2,"over-55-refused-before-child");
    join(p,base,"overbound/calls");ck(!sy_exists(p),"overbound-no-child-executed");
    put_plan(plan,"0\tsnap\t-\t0\n1\tpack\t-\t55\n");
    ck(call("zerobound","ok","30","3",0)==2,"zero-bound-refused");
    put_plan(plan,"0\tsnap\troot\t3\t-\t-\t4\n1\ta\ta\t3\tsnap\ta\t4\n2\tb\tb\t3\tsnap\tb\t4\n3\tc\tc\t3\tsnap\tc\t4\n4\td\td\t3\tsnap\td\t4\n5\te\ta\t3\tsnap\te\t4\n6\tpack\tfinal\t3\ta,b,c,d,e\t-\t4\n");
    ck(call("parallel","parallel","30","3",0)==0,"dependency-parallel-four");
    ck(events("parallel",0,0),"dependency-order-domain-exclusion-four-cap");
    ck(call("parallel-one","parallel-one","30","3",0)==0,"parallel-one-equivalent-coverage");
    ck(events("parallel-one",1,0),"serial-same-phase-set-once");
    ck(call("parallel-timeout","parallel-timeout","30","3",0)==0,"parallel-timeout-retry");
    ck(events("parallel-timeout",0,1),"completed-siblings-never-repeated");
    join(p,base,"parallel-timeout/chain-run.tsv");ck(has(p,"parallel=3")&&has(p,"bound=3")&&!has(p,"bound=55"),"timeout-reduces-width-not-bound");
    ck(has(p,"cleanup=1 residue=0"),"parallel-real-timeout-cleanup-proved");
    ck(call("siblings","siblings","30","3",0)==7,"failure-preserves-running-siblings");
    join(p,base,"siblings/checkpoint.tsv");ck(has(p,"DONE\tb\t")&&has(p,"DONE\tc\t")&&has(p,"DONE\td\t")&&!has(p,"DONE\tpack\t")&&!has(p,"DONE\te\t"),"siblings-finish-no-new-dispatch");
    ck(call("parallel-timeout","parallel-timeout","30","3",0)==0,"restart-keeps-completed-work");
    ck(events("parallel-timeout",0,1),"restart-no-phase-reexecution");
    join(p,base,"parallel-timeout/chain-run.budget");size_t bn=0;char *budget=cx_read(p,&bn);long deadline;int attempt,resume,ma,mr,width;
    ck(budget&&sscanf(budget,"%ld %d %d %d %d %d",&deadline,&attempt,&resume,&ma,&mr,&width)==6&&width==3&&resume==1,"restart-load-cannot-rise");free(budget);
    put_plan(plan,"0\tsnap\t-\t3\tunknown\t-\t4\n1\tpack\t-\t3\tsnap\t-\t4\n");
    ck(call("unknown-dep","ok","30","3",0)==2,"unknown-dependency-rejected");join(p,base,"unknown-dep/calls");ck(!sy_exists(p),"unknown-dependency-before-child");
    put_plan(plan,"0\tsnap\t-\t3\tpack\t-\t4\n1\tpack\t-\t3\tsnap\t-\t4\n");
    ck(call("cycle","ok","30","3",0)==2,"cycle-dependency-rejected");join(p,base,"cycle/calls");ck(!sy_exists(p),"cycle-before-child");
    put_plan(plan,"0\tsnap\t-\t55\n1\tjobs-tool-0-start\t-\t55\n2\tjobs-tool-0-finish\t-\t55\n3\tjobs-tool\t-\t55\n4\tpack\t-\t55\n");
    const char *jseg[]={"--segment-s","120","--max-segments","9",0};
    ck(runv("jobs","jobs-ok","600",jseg,0,12)==0,"jobs-group-multiple-phases-one-process");
    file_of(p,"jobs","calls");ck(count(p,"jobs-tool\n")==1&&!has(p,"jobs-tool-0-"),"jobs-no-per-phase-prefix-reentry");
    ck(runv("jobsexpire","jobs-expire","600",jseg,0,12)==75,"jobs-clean-boundary-continues");
    budget_row jb=budget_of("jobsexpire");ck(jb.resumes==0,"jobs-clean-boundary-not-retry");
    ck(runv("jobsexpire","jobs-expire","600",jseg,0,12)==0,"jobs-next-segment-finishes-group");
    ck(runv("jobsforged","jobs-forged","600",jseg,0,12)==2,"jobs-unproven-75-blocks");
    ck(runv("jobsinternal","jobs-internal","600",jseg,0,12)==2,"jobs-internal-code-not-forgeable");
    sy_printf("CHECK_CHAIN_RUN\tfailed=%d\tevidence=%s\n",bad,base);return bad?1:0;
}
