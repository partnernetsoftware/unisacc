/* tools/uxe-points-proj.cx -- 点精灵径向期望(整数).
 * a=(1-t*t)^2, t=d/R; R=(scale/2 / cam_d)/tan(fov/2)*W/2
 * sh ./unisacc.com tools/uxe-points-proj.cx --
 */
int main(void) {
    double scale = 1.6, cam_d = 8.0, W = 64.0;
    double half = 0.5463024898437905;
    double R = ((scale * 0.5) / cam_d) / half * (W * 0.5);
    double src_r = 220.0, src_g = 10.0, src_b = 30.0;
    double ts[4];
    int i;
    ts[0] = 0.0; ts[1] = 0.5; ts[2] = 0.9; ts[3] = 1.2;
    printf("R\t%.6f\n", R);
    for (i = 0; i < 4; i++) {
        double t = ts[i], a, r2;
        int er, eg, eb;
        r2 = t * t;
        a = 1.0 - r2;
        if (a < 0.0) a = 0.0;
        a = a * a;
        er = (int)(src_r * a + 0.5);
        eg = (int)(src_g * a + 0.5);
        eb = (int)(src_b * a + 0.5);
        printf("EXP\t%d\t%.1f\t%d\t%d\t%d\n", i, t, er, eg, eb);
    }
    return 0;
}
