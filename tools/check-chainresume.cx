static const char *OD="out";
static int count_trace_line(const char *b, size_t n, const char *want) {
 size_t wl = strlen(want), at = 0; int c = 0;
 while (b && at < n) {
  size_t e = at;
  while (e < n && b[e] != '\n') e++;
  if (e - at == wl && !memcmp(b + at, want, wl)) c++;
  at = e < n ? e + 1 : e;
 }
 return c;
}
static int run(char **v){return cx_runv_timeout(v,12,0,0);}
