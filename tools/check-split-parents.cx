/* tools/check-split-parents.cx -- 校验 tests/split-parents.tsv 旁表、dvqualify 防绕过与 G1 门合同 (r4).
 *   sh ./unisacc.com tools/check-split-parents.cx
 * Builds private mini repos under $TMPDIR (with real tools/check-slow-split.cx & tests/batches.tsv) and verifies 16 contracts:
 *   1. no-table-byte-identical              without split-parents.tsv, dvqualify --list keeps 15 batches & omits split_parents_excluded=
 *   2. default-excludes-parents             with 5-col split-parents.tsv, default --list excludes 3 parents & prints split_parents_excluded=3
 *   3. include-flag-restores-parents        --include-split-parents restores all 15 batches
 *   4. explicit-ids-keeps-parent            explicit --ids signal-targets keeps parent
 *   5. dvqualify-rejects-bad-tables         real dvqualify refuses ghost/1-shard/chained/dup/CRLF/bad-cols
 *   6. dvqualify-rejects-unproven-parent    registering c-negative with fake shards in split-parents.tsv refused (rc=2)
 *   7. g1-missing-shard-refused             G1 refuses STRICT_SPLIT_INCOMPLETE when 1 shard missing
 *   8. g1-all-shards-missing-refused        G1 refuses STRICT_SPLIT_INCOMPLETE when parent+all shards absent
 *   9. g1-check-absent-refused              G1 refuses STRICT_SPLIT_INCOMPLETE when slow-split absent
 *  10. g1-shard-fail-expected-fail-refused  shard FAIL + expected-fail.tsv with parent absent -> REFUSE STRICT_SPLIT_INCOMPLETE
 *  11. g1-shard-unknown-unmeasured-refused  shard UNKNOWN + RAW + expected-unmeasured.tsv with parent absent -> REFUSE STRICT_SPLIT_INCOMPLETE
 *  12. g1-shard-superseded-pass-allowed     shard FAIL then PASS (SUPERSEDED) + all other shards & slow-split PASS -> GATE 1 STRICT PASS
 *  13. g1-parent-present-passes             all 3 parents witnessed PASS + real check-slow-split --table-only -> GATE 1 STRICT PASS
 *  14. g1-table-mismatch-refused            split-parents.tsv differing from check-slow-split.cx -> REFUSE STRICT_SPLIT_TABLE_MISMATCH
 *  15. g1-missing-checker-refused           missing tools/check-slow-split.cx -> REFUSE STRICT_SPLIT_TABLE_MISMATCH (no silent skip)
 *  16. g1-before-since-passes               v0.0.81 (< since 0.0.82) passes G1 STRICT without split shards
 * Last line: CHECK_SPLIT_PARENTS<TAB>ok=N<TAB>failed=M<TAB>ms=T (rc 0 only when failed=0). */
#pragma unisa use cxlib.ckassert
#pragma unisa use cxlib.ckrun
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sys.time
#pragma unisa use sys.env
#pragma unisa use text.text

#define CSP_PW 4400
#define CSP_OUT 16384

static void csp_abort(const char *why) {
    fprintf(stderr, "check-split-parents: REFUSE %s\n", why);
    exit(2);
}

static void csp_mk(const char *p) {
    if (mkdir(p, 0700) != 0 && errno != EEXIST) csp_abort("mkdir");
}

static void csp_w(const char *dir, const char *rel, const char *body) {
    char p[CSP_PW];
    if (cx_fmt(p, sizeof p, "%s/%s", dir, rel)) csp_abort("fmt-w");
    if (cx_write(p, body, strlen(body))) csp_abort("write");
}

static void csp_sha(const char *s, char hex[65]) {
    if (sy_sha256_hex((const unsigned char *)s, (long)strlen(s), hex)) csp_abort("sha");
}

static void csp_wire_checker(const char *cwd, const char *dst_repo) {
    char cmd[8192], out[CSP_OUT];
    if (cx_fmt(cmd, sizeof cmd,
        "rm -f '%s/unisacc.com' '%s/cx' '%s/cxroot.tsv' && "
        "ln -sfn '%s/unisacc.com' '%s/unisacc.com' && ln -sfn '%s/cx' '%s/cx' && ln -sfn '%s/cxroot.tsv' '%s/cxroot.tsv' && "
        "cp '%s/tools/check-slow-split.cx' '%s/tools/check-slow-split.cx'",
        dst_repo, dst_repo, dst_repo,
        cwd, dst_repo, cwd, dst_repo, cwd, dst_repo, cwd, dst_repo)) csp_abort("wire-cmd");
    if (ckk_sh("check-split-parents", cmd, out, sizeof out) != 0) csp_abort("wire-run");
}

int main(void) {
    long t0 = sy_now_ms();
    char out[CSP_OUT], cwd[CSP_PW], work[CSP_PW], repo[CSP_PW], dvqbin[CSP_PW], p[CSP_PW], cmd[8192];
    const char *td = sy_tmpdir();
    const char *base_td = (td && td[0] == '/') ? td : "/tmp";

    if (!getcwd(cwd, sizeof cwd)) csp_abort("cwd");
    if (cx_fmt(work, sizeof work, "%s/check-split-parents-%d", base_td, (int)getpid())) csp_abort("work");
    csp_mk(work);
    if (cx_fmt(dvqbin, sizeof dvqbin, "%s/dvqualify.bin", work)) csp_abort("dvqbin");
    if (cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/dvqualify.cx' -o '%s'", cwd, cwd, dvqbin)) csp_abort("build-dvq");
    if (ckk_sh("check-split-parents", cmd, out, sizeof out) != 0) csp_abort("compile-dvq");
    if (cx_fmt(repo, sizeof repo, "%s/repo", work)) csp_abort("repo");
    csp_mk(repo);
    if (cx_fmt(p, sizeof p, "%s/tests", repo)) csp_abort("p1"); csp_mk(p);
    if (cx_fmt(p, sizeof p, "%s/tools", repo)) csp_abort("p2"); csp_mk(p);
    csp_wire_checker(cwd, repo);

    const char *idx =
        "# batch-domain-index-v3\n"
        "id\tdomain\torigin\tbasis\n"
        "signal-targets\tproduct-qualification\tauto\ttest\n"
        "signal-targets-gen\tproduct-qualification\tauto\ttest\n"
        "signal-targets-posix\tproduct-qualification\tauto\ttest\n"
        "signal-targets-win\tproduct-qualification\tauto\ttest\n"
        "win-argv\tproduct-qualification\tauto\ttest\n"
        "win-argv-facts\tproduct-qualification\tauto\ttest\n"
        "win-argv-x86_64\tproduct-qualification\tauto\ttest\n"
        "win-argv-arm64\tproduct-qualification\tauto\ttest\n"
        "snapshots-cx\tproduct-qualification\tauto\ttest\n"
        "snapshots-cx-core\tproduct-qualification\tauto\ttest\n"
        "snapshots-cx-alloc\tproduct-qualification\tauto\ttest\n"
        "slow-split\tproduct-qualification\tauto\ttest\n"
        "c-negative\tproduct-qualification\tauto\ttest\n"
        "c99-whitespace\tproduct-qualification\tauto\ttest\n"
        "pp-negative\tproduct-qualification\tauto\ttest\n";
    const char *batches_tsv =
        "# id\tstate\n"
        "signal-targets\tIMPLEMENTED\n"
        "signal-targets-gen\tIMPLEMENTED\n"
        "signal-targets-posix\tIMPLEMENTED\n"
        "signal-targets-win\tIMPLEMENTED\n"
        "win-argv\tIMPLEMENTED\n"
        "win-argv-facts\tIMPLEMENTED\n"
        "win-argv-x86_64\tIMPLEMENTED\n"
        "win-argv-arm64\tIMPLEMENTED\n"
        "snapshots-cx\tIMPLEMENTED\n"
        "snapshots-cx-core\tIMPLEMENTED\n"
        "snapshots-cx-alloc\tIMPLEMENTED\n"
        "slow-split\tIMPLEMENTED\n"
        "c-negative\tIMPLEMENTED\n"
        "c99-whitespace\tIMPLEMENTED\n"
        "pp-negative\tIMPLEMENTED\n";
    csp_w(repo, "tests/batch-domain-index.tsv", idx);
    csp_w(repo, "tests/batches.tsv", batches_tsv);

    /* 1. Without tests/split-parents.tsv */
    if (cx_fmt(cmd, sizeof cmd,
        "'%s' '%s' --set product-qualification --list", dvqbin, repo)) csp_abort("c1");
    {
        int rc = ckk_sh("check-split-parents", cmd, out, sizeof out);
        ck(rc == 0 && ckk_has(out, CSP_OUT, "QUALIFY_LIST\tsignal-targets\t") &&
           ckk_has(out, CSP_OUT, "QUALIFY_LIST_SUMMARY\tset=product-qualification\tbatches=15\t") &&
           !ckk_has(out, CSP_OUT, "split_parents_excluded="),
           "no-table-byte-identical: without split-parents.tsv keeps 15 batches and omits excluded field");
    }

    const char *spt =
        "# parent\tshards\tcheck\tsince\treason\n"
        "signal-targets\tsignal-targets-gen,signal-targets-posix,signal-targets-win\tslow-split\t0.0.82\tsplit\n"
        "win-argv\twin-argv-facts,win-argv-x86_64,win-argv-arm64\tslow-split\t0.0.82\tsplit\n"
        "snapshots-cx\tsnapshots-cx-core,snapshots-cx-alloc\tslow-split\t0.0.82\tsplit\n";
    csp_w(repo, "tests/split-parents.tsv", spt);

    /* 2. Default --list excludes 3 parents */
    {
        int rc = ckk_sh("check-split-parents", cmd, out, sizeof out);
        ck(rc == 0 && !ckk_has(out, CSP_OUT, "QUALIFY_LIST\tsignal-targets\t") &&
           !ckk_has(out, CSP_OUT, "QUALIFY_LIST\twin-argv\t") &&
           !ckk_has(out, CSP_OUT, "QUALIFY_LIST\tsnapshots-cx\t") &&
           ckk_has(out, CSP_OUT, "QUALIFY_LIST\tsignal-targets-gen\t") &&
           ckk_has(out, CSP_OUT, "QUALIFY_LIST\tslow-split\t") &&
           ckk_has(out, CSP_OUT, "batches=12\t") &&
           ckk_has(out, CSP_OUT, "split_parents_excluded=3"),
           "default-excludes-parents: excludes 3 parents, keeps shards+slow-split, prints split_parents_excluded=3");
    }

    /* 3. --include-split-parents restores all 15 batches */
    if (cx_fmt(cmd, sizeof cmd,
        "'%s' '%s' --set product-qualification --include-split-parents --list", dvqbin, repo)) csp_abort("c3");
    {
        int rc = ckk_sh("check-split-parents", cmd, out, sizeof out);
        ck(rc == 0 && ckk_has(out, CSP_OUT, "QUALIFY_LIST\tsignal-targets\t") &&
           ckk_has(out, CSP_OUT, "batches=15\t") &&
           !ckk_has(out, CSP_OUT, "split_parents_excluded="),
           "include-flag-restores-parents: --include-split-parents restores all 15 batches");
    }

    /* 4. Explicit --ids keeps parent */
    if (cx_fmt(cmd, sizeof cmd,
        "'%s' '%s' --ids signal-targets --list", dvqbin, repo)) csp_abort("c4");
    {
        int rc = ckk_sh("check-split-parents", cmd, out, sizeof out);
        ck(rc == 0 && ckk_has(out, CSP_OUT, "QUALIFY_LIST\tsignal-targets\t") &&
           ckk_has(out, CSP_OUT, "batches=1\t"),
           "explicit-ids-keeps-parent: --ids signal-targets still runs parent");
    }

    /* 5. Real dvqualify rejects 6 malformed split-parents.tsv variants */
    {
        const char *bad_tables[6] = {
            "signal-targets\tsignal-targets-gen,signal-targets-ghost\tslow-split\t0.0.82\tghost\n",
            "signal-targets\tsignal-targets-gen\tslow-split\t0.0.82\tonly-one-shard\n",
            "signal-targets\tsignal-targets-gen,win-argv\tslow-split\t0.0.82\tchain\nwin-argv\twin-argv-facts,win-argv-x86_64\tslow-split\t0.0.82\tchain\n",
            "signal-targets\tsignal-targets-gen,signal-targets-posix\tslow-split\t0.0.82\td1\nsignal-targets\tsignal-targets-gen,signal-targets-win\tslow-split\t0.0.82\td2\n",
            "signal-targets\tsignal-targets-gen,signal-targets-posix\tslow-split\t0.0.82\tcrlf\r\n",
            "signal-targets\tsignal-targets-gen,signal-targets-posix\tslow-split\tmissing-col\n"
        };
        int rejected = 0;
        if (cx_fmt(cmd, sizeof cmd,
            "'%s' '%s' --set product-qualification --list", dvqbin, repo)) csp_abort("c5");
        for (int k = 0; k < 6; k++) {
            csp_w(repo, "tests/split-parents.tsv", bad_tables[k]);
            int rc = ckk_sh("check-split-parents", cmd, out, sizeof out);
            if (rc == 2 && ckk_has(out, CSP_OUT, "QUALIFY_FAIL\tsplit-parents:")) rejected++;
        }
        ck(rejected == 6, "dvqualify-rejects-bad-tables: real dvqualify refuses ghost/1-shard/chained/dup/CRLF/bad-cols");
    }

    /* 6. Anti-bypass: registering non-split parent c-negative with fake shards refused */
    {
        const char *bypass =
            "# parent\tshards\tcheck\tsince\treason\n"
            "signal-targets\tsignal-targets-gen,signal-targets-posix,signal-targets-win\tslow-split\t0.0.82\tsplit\n"
            "win-argv\twin-argv-facts,win-argv-x86_64,win-argv-arm64\tslow-split\t0.0.82\tsplit\n"
            "snapshots-cx\tsnapshots-cx-core,snapshots-cx-alloc\tslow-split\t0.0.82\tsplit\n"
            "c-negative\tc99-whitespace,pp-negative\tslow-split\t0.0.82\tfake-bypass\n";
        csp_w(repo, "tests/split-parents.tsv", bypass);
        if (cx_fmt(cmd, sizeof cmd,
            "'%s' '%s' --set product-qualification --list", dvqbin, repo)) csp_abort("c6");
        int rc = ckk_sh("check-split-parents", cmd, out, sizeof out);
        ck(rc == 2 && ckk_has(out, CSP_OUT, "QUALIFY_FAIL\tsplit-parents: unproven or mismatched"),
           "dvqualify-rejects-unproven-parent: c-negative with fake shards refused rc=2");
    }

    /* 7-16. Real release-exec.cx --dry G1 tests (10 scenarios with real check-slow-split.cx) */
    {
        char g1[CSP_PW], lay[CSP_PW], evdir[CSP_PW], rxbin[CSP_PW], sha_ape[65], sha_f[65], cand[2048], ev[16384];
        const char *fake_ape = "#!/bin/sh\nif [ \"$1\" = \"--version\" ]; then echo 'unisacc 0.0.82'; exit 0; fi\nexit 0\n";
        const char *fake_ape81 = "#!/bin/sh\nif [ \"$1\" = \"--version\" ]; then echo 'unisacc 0.0.81'; exit 0; fi\nexit 0\n";
        const char *blob = "fixture-payload\n";
        csp_sha(fake_ape, sha_ape);
        csp_sha(blob, sha_f);

        if (cx_fmt(rxbin, sizeof rxbin, "%s/release-exec.bin", work)) csp_abort("rxbin");
        if (cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/release-exec.cx' -o '%s'", cwd, cwd, rxbin)) csp_abort("build-rx");
        if (ckk_sh("check-split-parents", cmd, out, sizeof out) != 0) csp_abort("compile-rx");

        if (cx_fmt(g1, sizeof g1, "%s/g1repo", work)) csp_abort("g1"); csp_mk(g1);
        if (cx_fmt(p, sizeof p, "%s/release", g1)) csp_abort("g1r"); csp_mk(p);
        if (cx_fmt(p, sizeof p, "%s/release/evidence", g1)) csp_abort("g1e"); csp_mk(p);
        if (cx_fmt(evdir, sizeof evdir, "%s/release/evidence/0.0.82", g1)) csp_abort("g1e82"); csp_mk(evdir);
        if (cx_fmt(p, sizeof p, "%s/release/evidence/0.0.81", g1)) csp_abort("g1e81"); csp_mk(p);
        if (cx_fmt(p, sizeof p, "%s/tests", g1)) csp_abort("g1t"); csp_mk(p);
        if (cx_fmt(p, sizeof p, "%s/tools", g1)) csp_abort("g1to"); csp_mk(p);
        if (cx_fmt(lay, sizeof lay, "%s/layout", work)) csp_abort("lay"); csp_mk(lay);
        csp_wire_checker(cwd, g1);
        csp_w(g1, "tools/devsvc-repo.tsv", "product\tunisacc.com\t-\n");
        csp_w(g1, "tests/batches.tsv", batches_tsv);
        csp_w(g1, "tests/split-parents.tsv", spt);

        csp_w(lay, "unisacc.com", fake_ape);
        if (cx_fmt(p, sizeof p, "%s/unisacc.com", lay)) csp_abort("chm"); (void)chmod(p, 0755);
        csp_w(lay, "pkg.bin", blob); csp_w(lay, "slice-win-arm64", blob);
        csp_w(lay, "unisacc.com.build.json", blob); csp_w(lay, "build.json", blob); csp_w(lay, "SHA256SUMS", blob);

        csp_w(g1, "release/evidence/0.0.82/ratchets.txt", "RATCHETS\tok=15\tfail=0\telapsed_ms=1\n");
        csp_w(g1, "release/evidence/0.0.82/INDEX.tsv", "item\ttime\tverdict\tpath_or_ref\tnote\n");
        csp_w(g1, "release/evidence/0.0.81/ratchets.txt", "RATCHETS\tok=15\tfail=0\telapsed_ms=1\n");
        csp_w(g1, "release/evidence/0.0.81/INDEX.tsv", "item\ttime\tverdict\tpath_or_ref\tnote\n");
        csp_w(g1, "release/evidence.tsv", "1\tPASS\tx\n");
        csp_w(g1, "release/decision.txt", "RELEASE_DECIDE\tfx\n");
        csp_w(g1, "release/rollback.txt", "# rb\n");
        const char *cand_hdr = "repo\ttag\tcommit\tversion\tworkflow\tworkflow_ref\tci_run_id\tape\tape_sha256\tpackage\tpackage_sha256\twin_arm64\twin_arm64_sha256\trecord\trecord_sha256\tbuild_alias\tbuild_alias_sha256\tzip\tzip_sha256\tchecksums\tchecksums_sha256\n";
        if (cx_fmt(cand, sizeof cand,
            "%sexample/fx\tv0.0.82\t1111111111111111111111111111111111111111\t0.0.82\tci.yml\tv0.0.82\t0\tunisacc.com\t%s\tpkg.bin\t%s\tslice-win-arm64\t%s\tunisacc.com.build.json\t%s\tbuild.json\t%s\t-\t-\tSHA256SUMS\t%s\n",
            cand_hdr, sha_ape, sha_f, sha_f, sha_f, sha_f, sha_f)) csp_abort("cand");
        csp_w(g1, "release/candidate.tsv", cand);
        if (cx_fmt(cmd, sizeof cmd,
            "cd '%s' && git init -q && git add release/candidate.tsv && git -c user.name=t -c user.email=t@t commit -q -m init", g1)) csp_abort("g1git");
        if (ckk_sh("check-split-parents", cmd, out, sizeof out) != 0) csp_abort("g1git-run");

        /* Helper body for signal-targets + win-argv parents PASS (so scenarios isolate snapshots-cx) */
        char two_par[2048];
        cx_fmt(two_par, sizeof two_par,
            "signal-targets\tproduct-qualification\tPASS\t0\t%s\t10\t0.5\t0\tcount=10/0\n"
            "RAW\tBATCH_RUN\tid=signal-targets\tstatus=PASS\trc=0\tcandidate=%s\n"
            "win-argv\tproduct-qualification\tPASS\t0\t%s\t10\t0.5\t0\tcount=10/0\n"
            "RAW\tBATCH_RUN\tid=win-argv\tstatus=PASS\trc=0\tcandidate=%s\n",
            sha_ape, sha_ape, sha_ape, sha_ape);

        /* 7. Missing 1 shard -> REFUSE STRICT_SPLIT_INCOMPLETE */
        cx_fmt(ev, sizeof ev,
            "batch\tdomain\tstatus\trc\tcandidate\tms\tload1\tretries\tnote\n%s"
            "snapshots-cx-core\tproduct-qualification\tPASS\t0\t%s\t10\t0.5\t0\tcount=86/0\n"
            "RAW\tBATCH_RUN\tid=snapshots-cx-core\tstatus=PASS\trc=0\tcandidate=%s\n"
            "slow-split\tproduct-qualification\tPASS\t0\t%s\t10\t0.5\t0\tcount=3/0\n"
            "RAW\tBATCH_RUN\tid=slow-split\tstatus=PASS\trc=0\tcandidate=%s\n"
            "SUMMARY\tbatches=4\tPASS=4\tFAIL=0\tUNKNOWN=0\tINVALID=0\ttotal_ms=40\tape_sha256=%s\tversion=unisacc 0.0.82\n",
            two_par, sha_ape, sha_ape, sha_ape, sha_ape, sha_ape);
        csp_w(g1, "release/evidence/v0.0.82-strict-2026-01-01.tsv", ev);
        cx_fmt(cmd, sizeof cmd, "cd '%s' && RELEASE_EXEC_NO_EVENTS=1 '%s' --execute release/candidate.tsv --layout '%s' --dry --out '%s/g1o7' --baseline /nonexistent", g1, rxbin, lay, work);
        {
            int rc = ckk_sh("check-split-parents", cmd, out, sizeof out);
            ck(rc == 2 && ckk_has(out, CSP_OUT, "RELEASE_EXEC_GATE_STRICT_SPLIT_INCOMPLETE"),
               "g1-missing-shard-refused: missing snapshots-cx-alloc refused by G1");
        }

        /* 8. All shards missing -> REFUSE STRICT_SPLIT_INCOMPLETE */
        cx_fmt(ev, sizeof ev,
            "batch\tdomain\tstatus\trc\tcandidate\tms\tload1\tretries\tnote\n"
            "c99-whitespace\tproduct-qualification\tPASS\t0\t%s\t10\t0.5\t0\tcount=12/0\n"
            "RAW\tBATCH_RUN\tid=c99-whitespace\tstatus=PASS\trc=0\tcandidate=%s\n"
            "SUMMARY\tbatches=1\tPASS=1\tFAIL=0\tUNKNOWN=0\tINVALID=0\ttotal_ms=10\tape_sha256=%s\tversion=unisacc 0.0.82\n",
            sha_ape, sha_ape, sha_ape);
        csp_w(g1, "release/evidence/v0.0.82-strict-2026-01-01.tsv", ev);
        cx_fmt(cmd, sizeof cmd, "cd '%s' && RELEASE_EXEC_NO_EVENTS=1 '%s' --execute release/candidate.tsv --layout '%s' --dry --out '%s/g1o8' --baseline /nonexistent", g1, rxbin, lay, work);
        {
            int rc = ckk_sh("check-split-parents", cmd, out, sizeof out);
            ck(rc == 2 && ckk_has(out, CSP_OUT, "RELEASE_EXEC_GATE_STRICT_SPLIT_INCOMPLETE"),
               "g1-all-shards-missing-refused: parent+all shards absent refused by G1");
        }

        /* 9. Both shards PASS but slow-split missing -> REFUSE STRICT_SPLIT_INCOMPLETE */
        cx_fmt(ev, sizeof ev,
            "batch\tdomain\tstatus\trc\tcandidate\tms\tload1\tretries\tnote\n%s"
            "snapshots-cx-core\tproduct-qualification\tPASS\t0\t%s\t10\t0.5\t0\tcount=86/0\n"
            "RAW\tBATCH_RUN\tid=snapshots-cx-core\tstatus=PASS\trc=0\tcandidate=%s\n"
            "snapshots-cx-alloc\tproduct-qualification\tPASS\t0\t%s\t10\t0.5\t0\tcount=179/0\n"
            "RAW\tBATCH_RUN\tid=snapshots-cx-alloc\tstatus=PASS\trc=0\tcandidate=%s\n"
            "SUMMARY\tbatches=4\tPASS=4\tFAIL=0\tUNKNOWN=0\tINVALID=0\ttotal_ms=40\tape_sha256=%s\tversion=unisacc 0.0.82\n",
            two_par, sha_ape, sha_ape, sha_ape, sha_ape, sha_ape);
        csp_w(g1, "release/evidence/v0.0.82-strict-2026-01-01.tsv", ev);
        cx_fmt(cmd, sizeof cmd, "cd '%s' && RELEASE_EXEC_NO_EVENTS=1 '%s' --execute release/candidate.tsv --layout '%s' --dry --out '%s/g1o9' --baseline /nonexistent", g1, rxbin, lay, work);
        {
            int rc = ckk_sh("check-split-parents", cmd, out, sizeof out);
            ck(rc == 2 && ckk_has(out, CSP_OUT, "RELEASE_EXEC_GATE_STRICT_SPLIT_INCOMPLETE"),
               "g1-check-absent-refused: slow-split absent refused by G1");
        }

        /* 10. Shard FAIL + expected-fail.tsv registered, parent absent -> REFUSE STRICT_SPLIT_INCOMPLETE */
        csp_w(g1, "release/evidence/0.0.82/expected-fail.tsv",
            "batch\texpected\treason\n"
            "snapshots-cx-alloc\t178/1\texpected-fail-fixture\n");
        cx_fmt(ev, sizeof ev,
            "batch\tdomain\tstatus\trc\tcandidate\tms\tload1\tretries\tnote\n%s"
            "snapshots-cx-core\tproduct-qualification\tPASS\t0\t%s\t10\t0.5\t0\tcount=86/0\n"
            "RAW\tBATCH_RUN\tid=snapshots-cx-core\tstatus=PASS\trc=0\tcandidate=%s\n"
            "snapshots-cx-alloc\tproduct-qualification\tFAIL\t1\t%s\t10\t0.5\t0\tcount=178/1\n"
            "RAW\tBATCH_RUN\tid=snapshots-cx-alloc\tstatus=FAIL\trc=1\tcandidate=%s\n"
            "slow-split\tproduct-qualification\tPASS\t0\t%s\t10\t0.5\t0\tcount=3/0\n"
            "RAW\tBATCH_RUN\tid=slow-split\tstatus=PASS\trc=0\tcandidate=%s\n"
            "SUMMARY\tbatches=5\tPASS=4\tFAIL=1\tUNKNOWN=0\tINVALID=0\ttotal_ms=50\tape_sha256=%s\tversion=unisacc 0.0.82\n",
            two_par, sha_ape, sha_ape, sha_ape, sha_ape, sha_ape, sha_ape, sha_ape);
        csp_w(g1, "release/evidence/v0.0.82-strict-2026-01-01.tsv", ev);
        cx_fmt(cmd, sizeof cmd, "cd '%s' && RELEASE_EXEC_NO_EVENTS=1 '%s' --execute release/candidate.tsv --layout '%s' --dry --out '%s/g1o10' --baseline /nonexistent", g1, rxbin, lay, work);
        {
            int rc = ckk_sh("check-split-parents", cmd, out, sizeof out);
            ck(rc == 2 && ckk_has(out, CSP_OUT, "RELEASE_EXEC_GATE_STRICT_SPLIT_INCOMPLETE"),
               "g1-shard-fail-expected-fail-refused: FAIL shard with expected-fail cannot substitute absent parent");
        }
        if (cx_fmt(p, sizeof p, "%s/release/evidence/0.0.82/expected-fail.tsv", g1)) csp_abort("rm-ef");
        (void)unlink(p);

        /* 11. Shard UNKNOWN + RAW receipt + expected-unmeasured.tsv, parent absent -> REFUSE STRICT_SPLIT_INCOMPLETE */
        csp_w(g1, "release/evidence/0.0.82/alloc-deferred.tsv",
            "DEFERRED\tsnapshots-cx-alloc\tprepare-failed=no-producer=fixture-mat\n");
        csp_w(g1, "release/evidence/0.0.82/expected-unmeasured.tsv",
            "batch\treason\tevidence\n"
            "snapshots-cx-alloc\tno-producer\talloc-deferred.tsv\n");
        cx_fmt(ev, sizeof ev,
            "batch\tdomain\tstatus\trc\tcandidate\tms\tload1\tretries\tnote\n%s"
            "snapshots-cx-core\tproduct-qualification\tPASS\t0\t%s\t10\t0.5\t0\tcount=86/0\n"
            "RAW\tBATCH_RUN\tid=snapshots-cx-core\tstatus=PASS\trc=0\tcandidate=%s\n"
            "snapshots-cx-alloc\tproduct-qualification\tUNKNOWN\t3\t%s\t10\t0.5\t0\tno-BATCH_RUN rc=3\n"
            "RAW\tBATCH_RUN\tid=snapshots-cx-alloc\tstatus=UNKNOWN\trc=3\tcandidate=%s\n"
            "slow-split\tproduct-qualification\tPASS\t0\t%s\t10\t0.5\t0\tcount=3/0\n"
            "RAW\tBATCH_RUN\tid=slow-split\tstatus=PASS\trc=0\tcandidate=%s\n"
            "SUMMARY\tbatches=5\tPASS=4\tFAIL=0\tUNKNOWN=1\tINVALID=0\ttotal_ms=50\tape_sha256=%s\tversion=unisacc 0.0.82\n",
            two_par, sha_ape, sha_ape, sha_ape, sha_ape, sha_ape, sha_ape, sha_ape);
        csp_w(g1, "release/evidence/v0.0.82-strict-2026-01-01.tsv", ev);
        cx_fmt(cmd, sizeof cmd, "cd '%s' && RELEASE_EXEC_NO_EVENTS=1 '%s' --execute release/candidate.tsv --layout '%s' --dry --out '%s/g1o11' --baseline /nonexistent", g1, rxbin, lay, work);
        {
            int rc = ckk_sh("check-split-parents", cmd, out, sizeof out);
            ck(rc == 2 && ckk_has(out, CSP_OUT, "RELEASE_EXEC_GATE_STRICT_SPLIT_INCOMPLETE"),
               "g1-shard-unknown-unmeasured-refused: UNKNOWN shard with expected-unmeasured cannot substitute absent parent");
        }
        if (cx_fmt(p, sizeof p, "%s/release/evidence/0.0.82/expected-unmeasured.tsv", g1)) csp_abort("rm-eu");
        (void)unlink(p);

        /* 12. Shard FAIL then PASS (SUPERSEDED / later_pass) + all other shards & slow-split PASS -> GATE 1 STRICT PASS */
        cx_fmt(ev, sizeof ev,
            "batch\tdomain\tstatus\trc\tcandidate\tms\tload1\tretries\tnote\n%s"
            "snapshots-cx-core\tproduct-qualification\tPASS\t0\t%s\t10\t0.5\t0\tcount=86/0\n"
            "RAW\tBATCH_RUN\tid=snapshots-cx-core\tstatus=PASS\trc=0\ttransport=0\tcandidate=%s\n"
            "snapshots-cx-alloc\tproduct-qualification\tFAIL\t1\t%s\t10\t0.5\t0\tcount=178/1\n"
            "RAW\tBATCH_RUN\tid=snapshots-cx-alloc\tstatus=FAIL\trc=1\ttransport=0\tcandidate=%s\n"
            "snapshots-cx-alloc\tproduct-qualification\tPASS\t0\t%s\t10\t0.5\t1\tcount=179/0\n"
            "RAW\tBATCH_RUN\tid=snapshots-cx-alloc\tstatus=PASS\trc=0\ttransport=0\tcandidate=%s\n"
            "slow-split\tproduct-qualification\tPASS\t0\t%s\t10\t0.5\t0\tcount=3/0\n"
            "RAW\tBATCH_RUN\tid=slow-split\tstatus=PASS\trc=0\ttransport=0\tcandidate=%s\n"
            "SUMMARY\tbatches=5\tPASS=5\tFAIL=0\tUNKNOWN=0\tINVALID=0\ttotal_ms=50\tape_sha256=%s\tversion=unisacc 0.0.82\n",
            two_par, sha_ape, sha_ape, sha_ape, sha_ape, sha_ape, sha_ape, sha_ape, sha_ape, sha_ape);
        csp_w(g1, "release/evidence/v0.0.82-strict-2026-01-01.tsv", ev);
        cx_fmt(cmd, sizeof cmd, "cd '%s' && RELEASE_EXEC_NO_EVENTS=1 '%s' --execute release/candidate.tsv --layout '%s' --dry --out '%s/g1o12' --baseline /nonexistent", g1, rxbin, lay, work);
        {
            int rc = ckk_sh("check-split-parents", cmd, out, sizeof out);
            ck(ckk_has(out, CSP_OUT, "SUPERSEDED") && ckk_has(out, CSP_OUT, "GATE\t1\tSTRICT\tPASS"),
               "g1-shard-superseded-pass-allowed: shard FAIL superseded by later PASS satisfies split gate");
            (void)rc;
        }

        /* 13. All 3 parents witnessed PASS + real check-slow-split --table-only -> GATE 1 STRICT PASS */
        cx_fmt(ev, sizeof ev,
            "batch\tdomain\tstatus\trc\tcandidate\tms\tload1\tretries\tnote\n%s"
            "snapshots-cx\tproduct-qualification\tPASS\t0\t%s\t10\t0.5\t0\tcount=265/0\n"
            "RAW\tBATCH_RUN\tid=snapshots-cx\tstatus=PASS\trc=0\tcandidate=%s\n"
            "SUMMARY\tbatches=3\tPASS=3\tFAIL=0\tUNKNOWN=0\tINVALID=0\ttotal_ms=30\tape_sha256=%s\tversion=unisacc 0.0.82\n",
            two_par, sha_ape, sha_ape, sha_ape);
        csp_w(g1, "release/evidence/v0.0.82-strict-2026-01-01.tsv", ev);
        cx_fmt(cmd, sizeof cmd, "cd '%s' && RELEASE_EXEC_NO_EVENTS=1 '%s' --execute release/candidate.tsv --layout '%s' --dry --out '%s/g1o13' --baseline /nonexistent", g1, rxbin, lay, work);
        {
            int rc = ckk_sh("check-split-parents", cmd, out, sizeof out);
            ck(ckk_has(out, CSP_OUT, "GATE\t1\tSTRICT\tPASS"),
               "g1-parent-present-passes: all 3 parents witnessed PASS with real check-slow-split passes G1 STRICT");
            (void)rc;
        }

        /* 14. split-parents.tsv mismatch with check-slow-split.cx -> REFUSE STRICT_SPLIT_TABLE_MISMATCH */
        csp_w(g1, "tests/split-parents.tsv",
            "# parent\tshards\tcheck\tsince\treason\n"
            "snapshots-cx\tsnapshots-cx-core,snapshots-cx-bad\tslow-split\t0.0.82\tbad-shard\n");
        cx_fmt(cmd, sizeof cmd, "cd '%s' && RELEASE_EXEC_NO_EVENTS=1 '%s' --execute release/candidate.tsv --layout '%s' --dry --out '%s/g1o14' --baseline /nonexistent", g1, rxbin, lay, work);
        {
            int rc = ckk_sh("check-split-parents", cmd, out, sizeof out);
            ck(rc == 2 && ckk_has(out, CSP_OUT, "RELEASE_EXEC_GATE_STRICT_SPLIT_TABLE_MISMATCH"),
               "g1-table-mismatch-refused: mismatched split-parents.tsv refused with STRICT_SPLIT_TABLE_MISMATCH");
        }
        csp_w(g1, "tests/split-parents.tsv", spt);

        /* 15. Missing tools/check-slow-split.cx -> REFUSE STRICT_SPLIT_TABLE_MISMATCH (no silent skip) */
        if (cx_fmt(p, sizeof p, "%s/tools/check-slow-split.cx", g1)) csp_abort("rm-css");
        (void)unlink(p);
        cx_fmt(cmd, sizeof cmd, "cd '%s' && RELEASE_EXEC_NO_EVENTS=1 '%s' --execute release/candidate.tsv --layout '%s' --dry --out '%s/g1o15' --baseline /nonexistent", g1, rxbin, lay, work);
        {
            int rc = ckk_sh("check-split-parents", cmd, out, sizeof out);
            ck(rc == 2 && ckk_has(out, CSP_OUT, "RELEASE_EXEC_GATE_STRICT_SPLIT_TABLE_MISMATCH"),
               "g1-missing-checker-refused: absent tools/check-slow-split.cx refused (never silently skipped)");
        }
        if (cx_fmt(cmd, sizeof cmd, "cp '%s/tools/check-slow-split.cx' '%s/tools/check-slow-split.cx'", cwd, g1) ||
            ckk_sh("check-split-parents", cmd, out, sizeof out) != 0) csp_abort("restore-css");

        /* 16. Evidence version 0.0.81 < since 0.0.82 -> G1 STRICT PASS even with parent+shards absent */
        {
            char sha81[65];
            csp_sha(fake_ape81, sha81);
            csp_w(lay, "unisacc.com", fake_ape81);
            if (cx_fmt(p, sizeof p, "%s/unisacc.com", lay)) csp_abort("chm81"); (void)chmod(p, 0755);
            cx_fmt(cand, sizeof cand,
                "%sexample/fx\tv0.0.81\t1111111111111111111111111111111111111111\t0.0.81\tci.yml\tv0.0.81\t0\tunisacc.com\t%s\tpkg.bin\t%s\tslice-win-arm64\t%s\tunisacc.com.build.json\t%s\tbuild.json\t%s\t-\t-\tSHA256SUMS\t%s\n",
                cand_hdr, sha81, sha_f, sha_f, sha_f, sha_f, sha_f);
            csp_w(g1, "release/candidate.tsv", cand);
            cx_fmt(ev, sizeof ev,
                "batch\tdomain\tstatus\trc\tcandidate\tms\tload1\tretries\tnote\n"
                "c99-whitespace\tproduct-qualification\tPASS\t0\t%s\t10\t0.5\t0\tcount=12/0\n"
                "RAW\tBATCH_RUN\tid=c99-whitespace\tstatus=PASS\trc=0\tcandidate=%s\n"
                "SUMMARY\tbatches=1\tPASS=1\tFAIL=0\tUNKNOWN=0\tINVALID=0\ttotal_ms=10\tape_sha256=%s\tversion=unisacc 0.0.81\n",
                sha81, sha81, sha81);
            csp_w(g1, "release/evidence/v0.0.81-strict-2026-01-01.tsv", ev);
            cx_fmt(cmd, sizeof cmd, "cd '%s' && RELEASE_EXEC_NO_EVENTS=1 '%s' --execute release/candidate.tsv --layout '%s' --dry --out '%s/g1o16' --baseline /nonexistent", g1, rxbin, lay, work);
            int rc = ckk_sh("check-split-parents", cmd, out, sizeof out);
            ck(ckk_has(out, CSP_OUT, "GATE\t1\tSTRICT\tPASS"),
               "g1-before-since-passes: v0.0.81 (< since 0.0.82) passes G1 STRICT without split shards");
            (void)rc;
        }

        /* 17. Evidence has split_parents_excluded=3 but tests/split-parents.tsv deleted -> REFUSE STRICT_SPLIT_TABLE_MISSING */
        {
            csp_w(lay, "unisacc.com", fake_ape);
            if (cx_fmt(p, sizeof p, "%s/unisacc.com", lay)) csp_abort("chm17"); (void)chmod(p, 0755);
            cx_fmt(cand, sizeof cand,
                "%sexample/fx\tv0.0.82\t1111111111111111111111111111111111111111\t0.0.82\tci.yml\tv0.0.82\t0\tunisacc.com\t%s\tpkg.bin\t%s\tslice-win-arm64\t%s\tunisacc.com.build.json\t%s\tbuild.json\t%s\t-\t-\tSHA256SUMS\t%s\n",
                cand_hdr, sha_ape, sha_f, sha_f, sha_f, sha_f, sha_f);
            csp_w(g1, "release/candidate.tsv", cand);
            cx_fmt(ev, sizeof ev,
                "batch\tdomain\tstatus\trc\tcandidate\tms\tload1\tretries\tnote\n"
                "c99-whitespace\tproduct-qualification\tPASS\t0\t%s\t10\t0.5\t0\tcount=12/0\n"
                "RAW\tBATCH_RUN\tid=c99-whitespace\tstatus=PASS\trc=0\tcandidate=%s\n"
                "SUMMARY\tbatches=1\tPASS=1\tFAIL=0\tUNKNOWN=0\tINVALID=0\ttotal_ms=10\tape_sha256=%s\tversion=unisacc 0.0.82\tsplit_parents_excluded=3\n",
                sha_ape, sha_ape, sha_ape);
            csp_w(g1, "release/evidence/v0.0.82-strict-2026-01-01.tsv", ev);
            if (cx_fmt(p, sizeof p, "%s/tests/split-parents.tsv", g1)) csp_abort("rm-spt");
            (void)unlink(p);
            cx_fmt(cmd, sizeof cmd, "cd '%s' && RELEASE_EXEC_NO_EVENTS=1 '%s' --execute release/candidate.tsv --layout '%s' --dry --out '%s/g1o17' --baseline /nonexistent", g1, rxbin, lay, work);
            int rc = ckk_sh("check-split-parents", cmd, out, sizeof out);
            ck(rc == 2 && ckk_has(out, CSP_OUT, "RELEASE_EXEC_GATE_STRICT_SPLIT_TABLE_MISSING"),
               "g1-excluded-table-missing-refused: split_parents_excluded>0 with deleted split-parents.tsv refused");
        }

        /* 18. Evidence has split_parents_excluded=3 but all split-parents rows have future since -> REFUSE STRICT_SPLIT_INCOMPLETE */
        {
            csp_w(g1, "tests/split-parents.tsv",
                "# parent\tshards\tcheck\tsince\treason\n"
                "snapshots-cx\tsnapshots-cx-core,snapshots-cx-alloc\tslow-split\t0.0.99\tfuture\n");
            cx_fmt(cmd, sizeof cmd, "cd '%s' && RELEASE_EXEC_NO_EVENTS=1 '%s' --execute release/candidate.tsv --layout '%s' --dry --out '%s/g1o18' --baseline /nonexistent", g1, rxbin, lay, work);
            int rc = ckk_sh("check-split-parents", cmd, out, sizeof out);
            ck(rc == 2 && ckk_has(out, CSP_OUT, "RELEASE_EXEC_GATE_STRICT_SPLIT_INCOMPLETE"),
               "g1-excluded-since-future-refused: split_parents_excluded>0 with no applicable rows refused");
        }

        /* 19. check-slow-split single-source: 1-row valid table accepted (no hardcoded 3-row list), missing registered shard refused */
        {
            csp_w(g1, "tests/split-parents.tsv",
                "# parent\tshards\tcheck\tsince\treason\n"
                "snapshots-cx\tsnapshots-cx-core,snapshots-cx-alloc\tslow-split\t0.0.83\tsingle-row\n");
            cx_fmt(cmd, sizeof cmd, "cd '%s' && sh ./unisacc.com tools/check-slow-split.cx -- --table-only --parents tests/split-parents.tsv", g1);
            int rc1 = ckk_sh("check-split-parents", cmd, out, sizeof out);
            int ok1 = (rc1 == 0 && ckk_has(out, CSP_OUT, "PASS\tslow-split.split-parents-table\tparents=1\tbad=0"));
            csp_w(g1, "tests/split-parents.tsv",
                "# parent\tshards\tcheck\tsince\treason\n"
                "signal-targets\tsignal-targets-gen,signal-targets-posix\tslow-split\t0.0.83\tmissing-win\n");
            int rc2 = ckk_sh("check-split-parents", cmd, out, sizeof out);
            int ok2 = (rc2 == 1 && ckk_has(out, CSP_OUT, "FAIL\tslow-split.split-parents-table"));
            ck(ok1 && ok2,
               "slow-split-single-source-table: 1-row table passes dynamically, omitting registered shard fails");
        }
    }

    {
        char *rmv[] = {"rm", "-rf", work, 0};
        (void)ck_run(rmv, out, sizeof out);
    }

    printf("CHECK_SPLIT_PARENTS\tok=%d\tfailed=%d\tms=%ld\n", ck_assertions() - ck_failures(), ck_failures(), sy_now_ms() - t0);
    return ck_failures() ? 1 : 0;
}
