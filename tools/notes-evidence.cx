/* tools/notes-evidence.cx -- extract and verify release notes evidence lines from chain/release receipts.
 *
 *   sh ./unisacc.com tools/notes-evidence.cx -- --evidence-dir DIR [--chain-dir DIR] [--check-notes FILE]
 *
 * Reads DIR/ape-receipt.txt and DIR/fixedpoint-6targets.tsv (required, strict validation) and
 * optionally CH_DIR/owner.tsv + CH_DIR/exit.tsv (required when --chain-dir is given or either file
 * exists in DIR).  With --check-notes FILE, proves that the extracted APE_SUMMARY line and all six
 * fixedpoint lines appear verbatim in FILE.
 *
 * Exit codes: 0 ok, 1 missing/invalid/mismatched evidence, 2 usage error.
 * Check: tools/check-notes-evidence.cx. */
#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use sys.time
#pragma unisa use text.fmt
#pragma unisa use mem.heap

#define NE_MAX_LINE 1024
#define NE_MAX_TARGETS 6

static int ne_streq_n(const char *a, const char *b, long n) {
    long i;
    for (i = 0; i < n; i++) if (a[i] != b[i]) return 0;
    return 1;
}

static long ne_cstr_len(const char *s) {
    long n = 0;
    if (!s) return 0;
    while (s[n]) n++;
    return n;
}

static int ne_streq_cstr(const char *a, const char *b) {
    long la = ne_cstr_len(a), lb = ne_cstr_len(b);
    return la == lb && ne_streq_n(a, b, la);
}

static int ne_is_hex64(const char *s, long n) {
    long i;
    if (n != 64) return 0;
    for (i = 0; i < 64; i++) {
        char c = s[i];
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return 0;
    }
    return 1;
}

static int ne_parse_pos_long(const char *s, long n, long *out) {
    long i, v = 0;
    if (n <= 0 || n > 18) return 1;
    for (i = 0; i < n; i++) {
        if (s[i] < '0' || s[i] > '9') return 1;
        v = v * 10 + (s[i] - '0');
    }
    if (v <= 0) return 1;
    *out = v;
    return 0;
}

static long ne_find_line_end(const char *buf, long len, long pos) {
    long i = pos;
    while (i < len && buf[i] != '\n' && buf[i] != '\r') i++;
    return i;
}

static long ne_next_line(const char *buf, long len, long eol) {
    long p = eol;
    if (p < len && buf[p] == '\r') p++;
    if (p < len && buf[p] == '\n') p++;
    return p;
}

static int ne_get_field(const char *line, long llen, int col, const char **out_p, long *out_n) {
    long i = 0, start = 0;
    int c = 0;
    while (i <= llen) {
        if (i == llen || line[i] == '\t') {
            if (c == col) {
                *out_p = line + start;
                *out_n = i - start;
                return 0;
            }
            c++;
            start = i + 1;
        }
        i++;
    }
    return 1;
}

static int ne_mem_contains(const char *hay, long hlen, const char *needle, long nlen) {
    long i, j;
    if (nlen == 0) return 1;
    if (nlen > hlen) return 0;
    for (i = 0; i + nlen <= hlen; i++) {
        int ok = 1;
        for (j = 0; j < nlen; j++) {
            if (hay[i + j] != needle[j]) { ok = 0; break; }
        }
        if (ok) return 1;
    }
    return 0;
}

static int ne_extract_ape(const char *dir, char *out_line, size_t out_cap) {
    char path[1024];
    int64_t sz = 0;
    unsigned char *ubuf = 0;
    const char *buf;
    long pos = 0, len;
    int found = 0;
    out_line[0] = 0;
    if (cx_fmt(path, sizeof path, "%s/ape-receipt.txt", dir)) {
        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=ape-receipt-invalid\tdetail=path-too-long\n");
        return 1;
    }
    if (sy_read_file(path, &ubuf, &sz, 16 << 20) != 0 || !ubuf || sz <= 0) {
        if (ubuf) mm_free(ubuf);
        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=ape-receipt-invalid\tpath=%s\n", path);
        return 1;
    }
    buf = (const char *)ubuf;
    len = (long)sz;
    while (pos < len) {
        long eol = ne_find_line_end(buf, len, pos);
        long llen = eol - pos;
        const char *f0, *f2, *f3;
        long n0, n2, n3, bytes_v = 0;
        if (ne_get_field(buf + pos, llen, 0, &f0, &n0) == 0 &&
            n0 == 16 && ne_streq_n(f0, "unisacc-next.com", 16)) {
            if (ne_get_field(buf + pos, llen, 2, &f2, &n2) == 0 &&
                ne_get_field(buf + pos, llen, 3, &f3, &n3) == 0 &&
                n2 == 68 && ne_streq_n(f2, "sha=", 4) && ne_is_hex64(f2 + 4, 64) &&
                n3 > 6 && ne_streq_n(f3, "bytes=", 6) && ne_parse_pos_long(f3 + 6, n3 - 6, &bytes_v) == 0) {
                if (cx_fmt(out_line, out_cap, "APE_SUMMARY\t%.*s\t%.*s", (int)n2, f2, (int)n3, f3)) {
                    mm_free(ubuf);
                    sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=ape-receipt-invalid\tdetail=line-overflow\n");
                    return 1;
                }
                found++;
            } else {
                mm_free(ubuf);
                sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=ape-receipt-invalid\tpath=%s\tdetail=malformed-fields\n", path);
                return 1;
            }
        }
        pos = ne_next_line(buf, len, eol);
    }
    mm_free(ubuf);
    if (found != 1) {
        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=ape-receipt-invalid\tpath=%s\tfound=%d\n", path, found);
        return 1;
    }
    return 0;
}

static int ne_extract_fixedpoint(const char *dir, char out_lines[NE_MAX_TARGETS][NE_MAX_LINE], int *out_cnt) {
    char path[1024];
    char seen_tgts[NE_MAX_TARGETS][64];
    int64_t sz = 0;
    unsigned char *ubuf = 0;
    const char *buf;
    long pos = 0, len;
    int cnt = 0;
    *out_cnt = 0;
    if (cx_fmt(path, sizeof path, "%s/fixedpoint-6targets.tsv", dir)) {
        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=fixedpoint-invalid\tdetail=path-too-long\n");
        return 1;
    }
    if (sy_read_file(path, &ubuf, &sz, 16 << 20) != 0 || !ubuf || sz <= 0) {
        if (ubuf) mm_free(ubuf);
        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=fixedpoint-invalid\tpath=%s\n", path);
        return 1;
    }
    buf = (const char *)ubuf;
    len = (long)sz;
    while (pos < len) {
        long eol = ne_find_line_end(buf, len, pos);
        long llen = eol - pos;
        if (llen > 0 && buf[pos] != '#') {
            const char *tgt, *g2p, *g2s, *g3s, *bytes, *ver;
            long nt, np, ns, n3s, nb, nv, bytes_v = 0;
            if (ne_get_field(buf + pos, llen, 0, &tgt, &nt) == 0 &&
                nt == 6 && ne_streq_n(tgt, "target", 6)) {
                pos = ne_next_line(buf, len, eol);
                continue;
            }
            if (cnt >= NE_MAX_TARGETS ||
                ne_get_field(buf + pos, llen, 0, &tgt, &nt) != 0 || nt <= 0 || nt >= 64 ||
                ne_get_field(buf + pos, llen, 1, &g2p, &np) != 0 || np <= 0 ||
                ne_get_field(buf + pos, llen, 2, &g2s, &ns) != 0 || !ne_is_hex64(g2s, ns) ||
                ne_get_field(buf + pos, llen, 4, &g3s, &n3s) != 0 || !ne_is_hex64(g3s, n3s) ||
                !ne_streq_n(g2s, g3s, 64) ||
                ne_get_field(buf + pos, llen, 5, &bytes, &nb) != 0 || ne_parse_pos_long(bytes, nb, &bytes_v) != 0 ||
                ne_get_field(buf + pos, llen, 6, &ver, &nv) != 0 || nv != 4 || !ne_streq_n(ver, "SAME", 4)) {
                mm_free(ubuf);
                sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=fixedpoint-invalid\tpath=%s\trow=%d\n", path, cnt + 1);
                return 1;
            }
            {   int j;
                for (j = 0; j < cnt; j++) {
                    if (ne_cstr_len(seen_tgts[j]) == nt && ne_streq_n(seen_tgts[j], tgt, nt)) {
                        mm_free(ubuf);
                        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=fixedpoint-invalid\tpath=%s\tdetail=duplicate-target\n", path);
                        return 1;
                    }
                }
                if (cx_fmt(seen_tgts[cnt], sizeof seen_tgts[cnt], "%.*s", (int)nt, tgt) ||
                    cx_fmt(out_lines[cnt], NE_MAX_LINE, "  - `%.*s` (`%.*s`): `%.*s` (`%.*s` bytes, `%.*s`)",
                           (int)nt, tgt, (int)np, g2p, (int)ns, g2s, (int)nb, bytes, (int)nv, ver)) {
                    mm_free(ubuf);
                    sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=fixedpoint-invalid\tdetail=line-overflow\n");
                    return 1;
                }
                cnt++;
            }
        }
        pos = ne_next_line(buf, len, eol);
    }
    mm_free(ubuf);
    if (cnt != NE_MAX_TARGETS) {
        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=fixedpoint-invalid\tpath=%s\tcount=%d\n", path, cnt);
        return 1;
    }
    *out_cnt = cnt;
    return 0;
}

static int ne_read_epoch_from(const char *path, const char *prefix, long plen, long *out_epoch) {
    int64_t sz = 0;
    unsigned char *ubuf = 0;
    const char *buf;
    long pos = 0, len;
    int found = 0;
    if (sy_read_file(path, &ubuf, &sz, 16 << 20) != 0 || !ubuf || sz <= 0) {
        if (ubuf) mm_free(ubuf);
        return 1;
    }
    buf = (const char *)ubuf;
    len = (long)sz;
    while (pos < len) {
        long eol = ne_find_line_end(buf, len, pos);
        long llen = eol - pos;
        const char *f0, *f1;
        long n0, n1, ep = 0;
        if (ne_get_field(buf + pos, llen, 0, &f0, &n0) == 0 &&
            n0 == plen && ne_streq_n(f0, prefix, plen)) {
            if (ne_get_field(buf + pos, llen, 1, &f1, &n1) == 0 &&
                ne_parse_pos_long(f1, n1, &ep) == 0) {
                *out_epoch = ep;
                found = 1;
                break;
            }
            mm_free(ubuf);
            return 1;
        }
        pos = ne_next_line(buf, len, eol);
    }
    mm_free(ubuf);
    return found ? 0 : 1;
}

static int ne_extract_times(const char *dir, int required, char *out_line, size_t out_cap) {
    char p_own[1024], p_exit[1024], t1s[64], t2s[64];
    int has_own, has_exit;
    long t1 = -1, t2 = -1, ds, dmin10;
    out_line[0] = 0;
    if (cx_fmt(p_own, sizeof p_own, "%s/owner.tsv", dir) ||
        cx_fmt(p_exit, sizeof p_exit, "%s/exit.tsv", dir)) {
        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=chain-times-invalid\tdetail=path-too-long\n");
        return 1;
    }
    has_own = sy_exists(p_own) == 1;
    has_exit = sy_exists(p_exit) == 1;
    if (!required && !has_own && !has_exit) return 0;
    if (!has_own || !has_exit ||
        ne_read_epoch_from(p_own, "OWNER", 5, &t1) != 0 ||
        ne_read_epoch_from(p_exit, "EXIT", 4, &t2) != 0 ||
        t2 < t1) {
        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=chain-times-invalid\tdir=%s\tt1=%ld\tt2=%ld\n", dir, t1, t2);
        return 1;
    }
    if (sy_local_fmt(t1s, sizeof t1s, "%Y-%m-%d %H:%M:%S %z", t1) <= 0 ||
        sy_local_fmt(t2s, sizeof t2s, "%Y-%m-%d %H:%M:%S %z", t2) <= 0) {
        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=chain-times-invalid\tdetail=time-format\n");
        return 1;
    }
    ds = t2 - t1;
    dmin10 = (ds * 10 + 30) / 60;
    if (cx_fmt(out_line, out_cap, "CHAIN_TIMES\tT1=%s (%ld)\tT2=%s (%ld)\tdelta_s=%ld\tdelta_min=%ld.%ld",
               t1s, t1, t2s, t2, ds, dmin10 / 10, dmin10 % 10)) {
        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=chain-times-invalid\tdetail=line-overflow\n");
        return 1;
    }
    return 0;
}

static int ne_verify_notes(const char *notes_path, const char *ape_line,
                           char fp_lines[NE_MAX_TARGETS][NE_MAX_LINE], int fp_cnt) {
    int64_t sz = 0;
    unsigned char *ubuf = 0;
    const char *buf;
    int i, matched = 0;
    if (sy_read_file(notes_path, &ubuf, &sz, 16 << 20) != 0 || !ubuf || sz <= 0) {
        if (ubuf) mm_free(ubuf);
        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=notes-unreadable\tfile=%s\n", notes_path);
        return 1;
    }
    buf = (const char *)ubuf;
    if (!ne_mem_contains(buf, (long)sz, ape_line, ne_cstr_len(ape_line))) {
        mm_free(ubuf);
        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=notes-mismatch\titem=APE_SUMMARY\tfile=%s\n", notes_path);
        return 1;
    }
    matched++;
    for (i = 0; i < fp_cnt; i++) {
        if (!ne_mem_contains(buf, (long)sz, fp_lines[i], ne_cstr_len(fp_lines[i]))) {
            mm_free(ubuf);
            sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=notes-mismatch\titem=fixedpoint-%d\tfile=%s\n", i + 1, notes_path);
            return 1;
        }
        matched++;
    }
    mm_free(ubuf);
    sy_printf("NOTES_CHECK\tOK\tmatched=%d\tfile=%s\n", matched, notes_path);
    return 0;
}

int main(int argc, char **argv) {
    const char *ev_dir = 0, *ch_dir = 0, *notes_path = 0;
    char ape_line[NE_MAX_LINE], times_line[NE_MAX_LINE];
    char fp_lines[NE_MAX_TARGETS][NE_MAX_LINE];
    int i, fp_cnt = 0;
    for (i = 1; i < argc; i++) {
        if (ne_streq_cstr(argv[i], "--evidence-dir") && i + 1 < argc) {
            if (ev_dir) { sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=usage\tdetail=duplicate-evidence-dir\n"); return 2; }
            ev_dir = argv[++i];
        } else if (ne_streq_cstr(argv[i], "--chain-dir") && i + 1 < argc) {
            if (ch_dir) { sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=usage\tdetail=duplicate-chain-dir\n"); return 2; }
            ch_dir = argv[++i];
        } else if (ne_streq_cstr(argv[i], "--check-notes") && i + 1 < argc) {
            if (notes_path) { sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=usage\tdetail=duplicate-check-notes\n"); return 2; }
            notes_path = argv[++i];
        } else {
            sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=usage\targ=%s\n", argv[i]);
            return 2;
        }
    }
    if (!ev_dir || !ev_dir[0]) {
        sy_eprintf("NOTES_EVIDENCE\tREFUSE\treason=usage\tneed=--evidence-dir\n");
        return 2;
    }
    if (ne_extract_ape(ev_dir, ape_line, sizeof ape_line) != 0) return 1;
    if (ne_extract_fixedpoint(ev_dir, fp_lines, &fp_cnt) != 0) return 1;
    if (ne_extract_times(ch_dir ? ch_dir : ev_dir, ch_dir != 0, times_line, sizeof times_line) != 0) return 1;
    sy_printf("%s\n", ape_line);
    for (i = 0; i < fp_cnt; i++) sy_printf("%s\n", fp_lines[i]);
    if (times_line[0]) sy_printf("%s\n", times_line);
    if (notes_path && ne_verify_notes(notes_path, ape_line, fp_lines, fp_cnt) != 0) return 1;
    return 0;
}
