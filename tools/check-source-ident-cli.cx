/* S(1) prepare-context identity-helper refusals. A declared native material
 * separates tool construction from the original 40-second execution bound.
 * Modes: relative-path | missing-path; optional second argument is the image.
 * Each invocation owns its fixture directory and captures child streams. */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use cxlib.netpack

static int failed;
static void ck(int ok,const char *name){
    if(!ok)failed++;
    printf("%s\tcheck-source-ident-helper.%s\n",ok?"PASS":"FAIL",name);
}
static void check_case(const char *root,const char *product,const char *source,const char *native,const char *work,int relative){
    char context[4400],missing[4400],why[1200];char *v[16];int k=0;
    if(cx_fmt(context,sizeof context,"%s/%s",work,relative?"relative-context":"missing-context")||
       cx_fmt(missing,sizeof missing,"%s/absent-helper",work)){ck(0,"path");return;}
    if(native)v[k++]=(char *)native;
    else{v[k++]="sh";v[k++]=(char *)product;v[k++]=(char *)source;v[k++]="--";}
    v[k++]="prepare-context";v[k++]=(char *)root;v[k++]=(char *)product;
    v[k++]="/usr/bin/x86_64-linux-gnu-gcc-11";v[k++]=context;
    v[k++]="--identity-helper";v[k++]=relative?"rel/helper":missing;v[k]=0;
    np_result r={0};int transport=np_run(v,root,0,40,&r,why,sizeof why);
    int diagnostic=tx_contains(r.err,r.errn,"identity-helper-absolute-path-required",tx_len("identity-helper-absolute-path-required",120))||
        (!relative&&tx_contains(r.err,r.errn,"identity-helper-not-executable",tx_len("identity-helper-not-executable",120)));
    ck(!transport&&!r.residue&&r.rc==2&&diagnostic,relative?"relative-path":"missing-path");
    if(transport||r.rc!=2||!diagnostic){
        fprintf(stderr,"source-ident-child transport=%d rc=%d residue=%d reason=%s\n",transport,r.rc,r.residue,transport?why:"unexpected-exit-or-diagnostic");
        if(r.errn)fwrite(r.err,1,r.errn,stderr);
    }
    sy_stat_t st;ck(sy_lstat(context,&st)==-ENOENT,relative?"relative-path-no-context":"missing-path-no-context");
    np_free(&r);
}
int main(int argc,char **argv){
    const char *mode=argc>=2?argv[1]:"";
    int relative=!*mode||tx_eqz(mode,"relative-path"),missing=!*mode||tx_eqz(mode,"missing-path");
    if(argc>3||(!relative&&!missing)){ck(0,"usage");return 2;}
    char root[4096],product[4400],source[4400],work[4400];
    const char *native=argc==3?argv[2]:0;
    if(native){sy_stat_t st;if(native[0]!='/'||sy_lstat(native,&st)||st.kind!='f'||sy_access(native,X_OK)){ck(0,"native-material");return 2;}}
    if(sy_realpath(".",root,sizeof root)<0||cx_fmt(product,sizeof product,"%s/unisacc.com",root)||
       cx_fmt(source,sizeof source,"%s/tools/source-package.cx",root)||
       sy_mkdtemp(sy_tmpdir(),"source-ident-cli-",work,sizeof work)<0){ck(0,"fixture");return 2;}
    if(relative)check_case(root,product,source,native,work,1);
    if(missing)check_case(root,product,source,native,work,0);
    if(!failed&&cx_rmtree(work)){ck(0,"fixture-cleanup");}
    if(failed)fprintf(stderr,"source-ident-cli retained=%s\n",work);
    printf("CHECK_SOURCE_IDENT_HELPER\tfailed=%d\n",failed);return failed?1:0;
}
