#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.posix
#pragma unisa use sys.time
#pragma unisa use text.text
/* tools/check-procguard.cx -- checks tools/procguard.cx for real.
     sh ./unisacc.com tools/check-procguard.cx
   Two throwaway symlinks pgA.cx/pgB.cx -> sleep; 6 A, 2 B, 4 plain (max 5).
   dry-run must name A (pgA.cx:6) and signal nothing; under load /proc top can
   be another .cx group so the same needle is retried ≤5, never relaxed.
   enforce kills the 6 A (SIGKILL) and leaves B/plain/self. residue then 2 then 0.
   Pure observation fixtures cover strict age/CPU and signal eligibility edges.
   Real deleted-cwd probes use default dry then explicit enforce; young sleep,
   busy and existing directory suffix lookalikes survive. --probe runs only
   those real probes. Every enforce is restricted to this check's children.
   Prints PASS/FAIL then CX_PROCGUARD<TAB>failed=N. L3: no #include, no libc. */

static int n_ok, n_bad;
static void ok(int c, const char *name) { printf("%s %s\n", c ? "PASS" : "FAIL", name); if (c) n_ok++; else n_bad++; }

static int read_file(const char *path, char *buf, int cap) {
    int fd = sy_open_read(path), n;
    if (cap < 1) return -EINVAL;
    if (fd < 0) return fd;
    n = (int)sy_read(fd, buf, cap - 1);
    sy_close(fd);
    if (n < 0) return n;
    buf[n] = 0;
    return n;
}

/* 'Z' for a zombie or gone pid, its /proc stat state otherwise, '?' on error */
static char proc_state(int pid) {
    char path[64], buf[512];
    int n = cx_fmt(path, sizeof path, "/proc/%d/stat", pid);
    if (n) return '?';
    n = read_file(path, buf, sizeof buf);
    if (n <= 0) return 'Z';
    {   int i; for (i = n - 1; i > 0; i--) if (buf[i] == ')') return i + 2 < n ? buf[i + 2] : '?'; }
    return '?';
}

static int alive(int pid) { char s = proc_state(pid); return s != 'Z' && s != '?'; }

static const char *sleep_bin(void) {
    sy_stat_t st;
    if (sy_stat("/bin/sleep", &st) == 0 && st.kind == 'f') return "/bin/sleep";
    if (sy_stat("/usr/bin/sleep", &st) == 0 && st.kind == 'f') return "/usr/bin/sleep";
    return 0;
}

/* run procguard through the product, capture stdout */
static int run_pg(const char *verb, int max, const char *log, char *out, int cap) {
    char cmd[2048];
    char *av[4];
    int cut = 0;
    av[0] = "sh"; av[1] = "-c"; av[2] = cmd; av[3] = 0;
    if (cx_fmt(cmd, sizeof cmd, "PG_LOG='%s' sh %s tools/procguard.cx --once --%s --max %d --only-parent %d",
               log, sy_env_or("UNISACC", "./unisacc.com"), verb, max, sy_pid())) return -EINVAL;
    return sy_run(av, out, cap, &cut);
}

/* Exercise observable decisions; every signalled pid is our direct child. */
static void runaway_probe(const char *dir, const char *log) {
    char cmd[4096], out[8192], cwd[1200], link[1200], busy[1200], sleeper[1200], named[1200], namedlink[1200], spaced[1200], spacedlink[1200];
    int p[5], i, rc, cut = 0, clean = 1;
    const char *sb = sleep_bin();
    char *av[] = {"sh", "-c", cmd, 0};
    cx_fmt(cwd, sizeof cwd, "%s/deleted", dir);
    cx_fmt(link, sizeof link, "%s/deleted.cx", dir);
    cx_fmt(busy, sizeof busy, "%s/busy.cx", dir);
    cx_fmt(sleeper, sizeof sleeper, "%s/sleeper.cx", dir); sy_symlink(sb, sleeper);
    sy_mkdir(cwd, 0700); sy_symlink(sb, link); sy_symlink("/bin/sh", busy);
    cx_fmt(cmd, sizeof cmd, "cd '%s' && exec '%s' 55", cwd, link);
    p[0] = sy_spawn(av);
    { char *a[] = {sleeper, "55", 0}; p[1] = sy_spawn(a); }
    cx_fmt(cmd, sizeof cmd, "exec '%s' -c 'while :; do :; done'", busy);
    p[2] = sy_spawn(av);
    cx_fmt(named, sizeof named, "%s/foo(deleted)", dir); sy_mkdir(named, 0700);
    cx_fmt(namedlink, sizeof namedlink, "%s/named.cx", dir); sy_symlink(sb, namedlink);
    cx_fmt(cmd, sizeof cmd, "cd '%s' && exec '%s' 55", named, namedlink); p[3] = sy_spawn(av);
    cx_fmt(spaced, sizeof spaced, "%s/foo (deleted)", dir); sy_mkdir(spaced, 0700);
    cx_fmt(spacedlink, sizeof spacedlink, "%s/spaced.cx", dir); sy_symlink(sb, spacedlink);
    cx_fmt(cmd, sizeof cmd, "cd '%s' && exec '%s' 55", spaced, spacedlink); p[4] = sy_spawn(av);
    sy_sleep_ms(300); sy_rmdir(cwd);
    cx_fmt(cmd, sizeof cmd, "sh %s tools/procguard.cx --once --max 100000 --only-parent %d --log '%s'", sy_env_or("UNISACC", "./unisacc.com"), sy_pid(), log);
    rc = sy_run(av, out, sizeof out, &cut);
    printf("PROBE_DEFAULT %s", out);
    ok(rc == 0 && tx_contains(out, tx_len(out, sizeof out), "deleted-cwd=1", 13), "deleted cwd is an actual default-dry candidate");
    ok(alive(p[0]) && alive(p[1]) && alive(p[2]), "default dry preserves deleted target and sleep/busy controls");
    ok(!tx_contains(out, tx_len(out, sizeof out), "busy.cx", 7), "young real busy process is not a runaway");
    ok(!tx_contains(out, tx_len(out, sizeof out), "sleeper.cx", 10), "young real cx sleep process is not a runaway");
    ok(alive(p[3]) && !tx_contains(out, tx_len(out, sizeof out), "named.cx", 8), "existing foo(deleted) directory is not a deleted cwd candidate");
    ok(alive(p[4]) && !tx_contains(out, tx_len(out, sizeof out), "spaced.cx", 9), "existing foo (deleted) directory is not a deleted cwd candidate");
    rc = run_pg("enforce", 100000, log, out, sizeof out);
    printf("PROBE_ENFORCE %s", out);
    { int ex = 0, code = 0, sig = 0, w = 0, tries;
      for (tries = 0; tries < 20 && w == 0; tries++) { w = sy_wait_status(p[0], 1, &ex, &code, &sig); if (!w) sy_sleep_ms(50); }
      ok(rc == 0 && w == p[0] && ex == 0 && sig == 9, "explicit enforce kills the deleted cwd target by SIGKILL"); }
    ok(alive(p[1]) && alive(p[2]), "explicit enforce preserves real sleep and busy negative controls");
    ok(alive(p[3]), "enforce preserves existing foo(deleted) directory negative control");
    ok(alive(p[4]), "enforce preserves existing foo (deleted) directory negative control");
    for (i = 0; i < 5; i++) if (p[i] > 0) { sy_signal(p[i], 9); sy_wait_status(p[i], 0, 0, 0, 0); if (alive(p[i])) clean = 0; }
    ok(clean, "real probe children are reaped without residue");
}

static void fixtures(const char *args, const char *prefix, const char *expected, const char **names, int count) {
    char cmd[4096], out[4096]; int cut = 0, rc, i, pos = 0, n;
    char *av[] = {"sh", "-c", cmd, 0};
    cx_fmt(cmd, sizeof cmd, "sh %s tools/procguard.cx %s", sy_env_or("UNISACC", "./unisacc.com"), args);
    rc = sy_run(av, out, sizeof out, &cut); n = tx_len(out, sizeof out);
    for (i = 0; i < count; i++) {
        int end = pos; char want[64];
        while (end < n && out[end] != '\n') end++;
        if (tx_eqz(prefix, "stopped")) cx_fmt(want, sizeof want, "kill=%c cont=%c", expected[i * 2], expected[i * 2 + 1]);
        else cx_fmt(want, sizeof want, "%s%c", prefix, expected[i]);
        ok(rc == 0 && !cut && tx_contains(out + pos, end - pos, want, tx_len(want, sizeof want)), names[i]);
        pos = end < n ? end + 1 : end;
    }
    ok(pos == n, "observation fixture emits exactly the requested rows");
}

static void boundaries(void) {
    const char *reasons[] = {
        "CPU age exactly ten minutes is excluded", "CPU below ninety percent is excluded",
        "CPU exactly ninety percent above ten minutes qualifies", "CPU above ninety percent qualifies",
        "orphan exactly thirty minutes is excluded", "orphan above thirty minutes qualifies",
        "non-init parent excludes orphan reason", "tmux tree excludes orphan reason",
        "deleted cwd qualifies independently of age", "overlapping reasons retain all OR branches" };
    const char *identities[] = { "unchanged eligible identity is safe", "changed PID identity cannot be signalled",
        "different uid cannot be signalled", "protected process cannot be signalled", "non cx process cannot be signalled" };
    const char *stops[] = { "CPU reason drift after owned STOP does not strand target",
        "changed identity after STOP rejects KILL and CONT", "unowned STOP cannot be killed or resumed",
        "originally stopped protected process is not resumed", "failed KILL restores only our own STOP despite protection change",
        "changed uid after STOP rejects KILL and CONT", "failed KILL does not resume an already running target" };
    fixtures("--classify 60000 60000 100 0 2 0 60010 54008 100 0 2 0 60010 54009 100 0 2 0 60010 54010 100 0 2 0 180000 0 100 0 1 0 180001 0 100 0 1 0 180001 0 100 0 2 0 180001 0 100 0 1 1 1 0 100 1 2 0 180010 180010 100 1 1 0", "reason=", "0011040027", reasons, 10);
    fixtures("--identity 100 100 1 0 1 100 101 1 0 1 100 100 0 0 1 100 100 1 1 1 100 100 1 0 0", "safe=", "10000", identities, 5);
    fixtures("--stopped 10 10 1 0 1 1 0 1 0 10 11 1 0 1 1 1 1 0 10 10 1 0 1 0 1 1 0 10 10 1 1 1 2 1 1 0 10 10 1 1 1 1 1 1 0 10 10 0 0 1 1 1 1 0 10 10 1 1 1 1 1 0 0", "stopped", "10000000010000", stops, 7);
}

int main(int argc, char **argv) {
    char dir[1024], pa[1100], pb[1100], log[1100];
    int pids[24], np = 0, i, rc;
    char out[8192];
    const char *sb = sleep_bin();
    (void)argv;
    if (!sb) { printf("FAIL sleep binary\nCX_PROCGUARD\tfailed=1\n"); return 1; }
    if (cx_fmt(dir, sizeof dir, "/tmp/cdx-procguard-check-XXXXXX") || !mkdtemp(dir)) return 2;
    if (cx_fmt(pa, sizeof pa, "%s/pgA.cx", dir) || cx_fmt(pb, sizeof pb, "%s/pgB.cx", dir) || cx_fmt(log, sizeof log, "%s/log", dir))
        return 2;
    if (argc > 1 && tx_eqz(argv[1], "--probe")) { runaway_probe(dir, log); cx_rmtree(dir); printf("CX_PROCGUARD\tfailed=%d\n", n_bad); return n_bad ? 1 : 0; }
    boundaries();
    runaway_probe(dir, log);
    sy_unlink(pa); sy_unlink(pb);
    if (sy_symlink(sb, pa) < 0 || sy_symlink(sb, pb) < 0) { printf("FAIL cannot link the fixtures\nCX_PROCGUARD\tfailed=1\n"); return 1; }

    /* 6 A, 2 B (same fixture family), 4 plain sleeps that carry no .cx */
    for (i = 0; i < 6; i++) { char *av[] = {pa, "60", 0}; int p = sy_spawn(av); if (p > 0) pids[np++] = p; }
    for (i = 0; i < 2; i++) { char *av[] = {pb, "60", 0}; int p = sy_spawn(av); if (p > 0) pids[np++] = p; }
    for (i = 0; i < 4; i++) { char *av[] = {"sleep", "60", 0}; int p = sy_spawn(av); if (p > 0) pids[np++] = p; }
    ok(np == 12, "spawn: 6 A + 2 B + 4 plain run");
    sy_sleep_ms(300);

    {   int tries, hit = 0; char lg[8192]; int n;
        const char *needle = "pgA.cx:6";
        for (tries = 0; tries < 5 && !hit; tries++) {
            rc = run_pg("dry-run", 5, log, out, sizeof out);
            n = read_file(log, lg, sizeof lg);
            if (rc == 0 && n > 0 && tx_contains(lg, n, "top=", 4) && tx_contains(lg, n, needle, tx_len(needle, 16))) hit = 1;
            else if (tries < 4) sy_sleep_ms(400);
        }
        ok(rc == 0, "dry-run exits 0");
        ok(tx_contains(out, tx_len(out, sizeof out), "DRY key=", 8), "dry-run reports the A group");
        ok(tx_contains(out, tx_len(out, sizeof out), "count=6", 7), "dry-run counts 6 A members");
        ok(hit, "scan log names the largest group");
    }
    {   int all = 1; for (i = 0; i < np; i++) if (!alive(pids[i])) all = 0; ok(all, "dry-run signals nothing"); }

    rc = run_pg("enforce", 5, log, out, sizeof out);
    ok(rc == 0, "enforce exits 0");
    ok(tx_contains(out, tx_len(out, sizeof out), "ENFORCE key=", 12), "enforce acts on the A group");
    ok(tx_contains(out, tx_len(out, sizeof out), "killed=6", 8), "enforce kills 6 A members");
    {   int a_ok = 1, rest = 1;
        for (i = 0; i < np; i++) {
            int ex = 0, code = 0, sig = 0, w;
            if (i < 6) {
                w = sy_wait_status(pids[i], 0, &ex, &code, &sig);
                if (w != pids[i] || ex != 0 || sig != 9) a_ok = 0;
            } else if (!alive(pids[i])) rest = 0;
        }
        ok(a_ok, "every A member died by SIGKILL");
        ok(rest, "B and the plain sleeps are untouched");
    }
    {   char lg[8192]; int n = read_file(log, lg, sizeof lg);
        ok(n > 0 && tx_contains(lg, n, "ENFORCE key=", 12), "log records the ENFORCE decision");
        ok(n > 0 && !tx_contains(lg, n, "pgB.cx", 6), "log has nothing about the B group");
    }

    /* residue: the next scan counts what the ENFORCE left behind, not what it signalled */
    for (i = 0; i < 2; i++) { char *av[] = {pa, "60", 0}; int p = sy_spawn(av); if (p > 0) pids[np++] = p; }
    sy_sleep_ms(200);
    rc = run_pg("dry-run", 5, log, out, sizeof out);
    ok(rc == 0, "residue scan exits 0");
    ok(tx_contains(out, tx_len(out, sizeof out), "residue=", 8), "next scan carries a residue field");
    ok(tx_contains(out, tx_len(out, sizeof out), "pgA.cx:2", 8), "residue counts the two late survivors");
    {   char lg[8192]; int n = read_file(log, lg, sizeof lg);
        ok(n > 0 && tx_contains(lg, n, "residue=", 8) && tx_contains(lg, n, "pgA.cx:2", 8), "log scan line carries the residue");
    }
    for (i = 12; i < np; i++) { sy_signal(pids[i], 9); sy_wait_status(pids[i], 0, 0, 0, 0); }
    np = 12;
    /* a clean kill reads back as 0, not as the number of signals sent */
    for (i = 0; i < 6; i++) { char *av[] = {pa, "60", 0}; int p = sy_spawn(av); if (p > 0) pids[np++] = p; }
    sy_sleep_ms(300);
    rc = run_pg("enforce", 5, log, out, sizeof out);
    ok(rc == 0 && tx_contains(out, tx_len(out, sizeof out), "killed=6", 8), "second enforce kills the fresh six");
    rc = run_pg("dry-run", 5, log, out, sizeof out);
    ok(rc == 0 && tx_contains(out, tx_len(out, sizeof out), "pgA.cx:0", 8), "residue reads back 0 when nothing survived");

    {   /* an oversized log is rotated to .1 and started fresh */
        char big[1100], bak[1100], cmd[1200], o[2048];
        int fd;
        sy_stat_t st;
        if (cx_fmt(big, sizeof big, "%s/big.log", dir) || cx_fmt(bak, sizeof bak, "%s/big.log.1", dir)) return 2;
        sy_unlink(big); sy_unlink(bak);
        fd = sy_open(big, 1 | 0100 | 02000, 0644);
        ok(fd >= 0 && sy_truncate(fd, 9L * 1024 * 1024) == 0, "oversized log prepared");
        if (fd >= 0) sy_close(fd);
        if (cx_fmt(cmd, sizeof cmd, "sh %s tools/procguard.cx --once --dry-run --log '%s'", sy_env_or("UNISACC", "./unisacc.com"), big)) return 2;
        {   char *av[] = {"sh", "-c", cmd, 0}; int cut = 0; rc = sy_run(av, o, sizeof o, &cut); }
        ok(rc == 0, "run with an oversized log exits 0");
        ok(sy_stat(bak, &st) == 0 && st.size == 9L * 1024 * 1024, "oversized log moved to .1");
        ok(sy_stat(big, &st) == 0 && st.size > 0 && st.size < 4096, "a fresh log was started");
    }

    for (i = 6; i < np; i++) { sy_signal(pids[i], 9); sy_wait_status(pids[i], 0, 0, 0, 0); }
    { int clean = 1; for (i = 0; i < np; i++) if (alive(pids[i])) clean = 0; ok(clean, "all fork-contract children are gone after cleanup"); }
    cx_rmtree(dir);
    printf("CX_PROCGUARD\tfailed=%d\n", n_bad);
    return n_bad ? 1 : 0;
}
