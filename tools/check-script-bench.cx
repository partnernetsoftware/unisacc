/* tools/check-script-bench.cx checks tools/script-bench.cx. Tool selfcheck.
   Tests nanoseconds to milliseconds, sorting, incomplete samples, absent and failing interpreters. */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
#pragma unisa use sys.env
static int assertions,failures;
static void expect(int ok,const char *label){assertions++;if(!ok)failures++;printf("%s\tscript-bench.%s\n",ok?"PASS":"FAIL",label);}
static int invoke(char **argv,char **env,const char *wanted,int status){
    np_result r={0};char why[256];int err=np_run(argv,0,env,15,&r,why,sizeof why);
    int ok=!err&&r.rc==status&&(!*wanted||(r.out&&strstr(r.out,wanted)));if(!ok)fprintf(stderr,"%s",err?why:r.err?r.err:"");np_free(&r);return ok;
}
int main(void){
    char dir[4096],envpath[4200],fake[4096];if(cx_fmt(dir,sizeof dir,"%s/check-script-bench-XXXXXX",sy_tmpdir())||!mkdtemp(dir))return 2;
    if(cx_fmt(envpath,sizeof envpath,"PATH=%s",dir)||cx_fmt(fake,sizeof fake,"%s/node",dir))return 2;
    char *env[]={envpath,0};
    /* Only the measured child gets this PATH. The tool launcher needs its normal environment. */
    if(symlink("/bin/false",fake))return 2;
    char binary[4096];if(cx_fmt(binary,sizeof binary,"%s/bench",dir))return 2;
    char product[4096];if(!realpath("unisacc.com",product))return 2;
    char *build[]={"/bin/sh",product,"-o",binary,"tools/script-bench.cx",0};char why[256];np_result r={0};
    if(np_run(build,0,0,30,&r,why,sizeof why)||r.rc)return 2;np_free(&r);
    char *stats[]={binary,"stats","7000000","1000000","5000000","3000000","6000000","2000000","4000000",0};
    expect(invoke(stats,0,"min_ms=1.000 median_ms=4.000 max_ms=7.000\n",0),"units-and-unsorted-median");
    stats[4]=(char*)"bad";expect(invoke(stats,0,"",1),"invalid-sample-rejected");
    char *direct[]={binary,"cell",dir,"hello-hot","bun",0};
    expect(invoke(direct,env,"UNMEASURED:missing-interpreter",0),"missing-interpreter");
    direct[4]=(char*)"node";expect(invoke(direct,env,"FAILED:n=0",1),"failed-command-excluded");
    char *report[]={binary,"report",dir,0};
    expect(invoke(report,0,"SUMMARY\tmeasured=0\tmissing_interpreter=1\tincomplete_or_failed=31",1),"summary-counts-valid-only");
    char *clean[]={"/bin/rm","-rf","--",dir,0};if(np_run(clean,0,0,5,&r,why,sizeof why)||r.rc)return 2;np_free(&r);
    printf("CHECK_SCRIPT_BENCH\tassertions=%d failed=%d\n",assertions,failures);return !!failures;
}
