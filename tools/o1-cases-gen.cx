/* tools/o1-cases-gen.cx -- stream-e4 cells e4.in.o1-model (O1 network isolated as a stream and exercised) and
 * e4.pos.o1-save-restore-to-mov (software-stack save/restore replaced by mov). Material: an O1 single-stream container
 * packed by tools/stream-pack.cx with LEVEL O1 (out/c43-streams-cc-o1-01, receipt selected_route lnx/x86_64/image/O1,
 * e4 model index 6), first measured 2026-10-28.
 *   sh ./unisacc.com tools/o1-cases-gen.cx -- ROOT STREAM4_O1_COM ABS_OUT [REF]
 * Per fixture (C programs whose -O0 tape carries `.frame 8 / store64 [r7+0], rN ... load64 rN, [r7+0] / .frame -8`
 * save/restore pairs): the stream's output on the product's -O0 E3 tape must equal the product's own `-S -O1` tape byte
 * for byte (the O1 pass isolated == the O1 pass in the pipeline), and with REF also the classic reference's `-S -O1`
 * tape; it must differ from the -O0 tape (non-vacuous); the save/restore pattern must be present in the input and absent
 * in the output while a `mov` took its place; and `-run` of the O1 tape exits with the hand literal. */
#pragma unisa use cxlib.netpack
#pragma unisa use text.text

static char root[4096], stream[4096], outdir[4096], ref[4096], inc[4400], bound[4400], product[4400]; static int npass, nfail, nvac; static FILE *res;
static void die(const char *s) { fprintf(stderr, "o1-cases: REFUSE %s errno=%d\n", s, errno); exit(2); }
static void path(char *p, size_t cap, const char *a, const char *b) { int n = snprintf(p, cap, "%s/%s", a, b); if (n < 0 || (size_t)n >= cap) die("path"); }
static void saved(const char *p, const char *s, size_t n) { int f = open(p, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600); if (f < 0) die("exclusive create"); while (n) { ssize_t k = write(f, s, n); if (k <= 0) die("write"); s += k; n -= (size_t)k; } if (close(f)) die("close"); }
static void row(const char *st, const char *fx, const char *label, const char *detail) { fprintf(res, "%s\t%s\t%s\t%s\n", st, fx, label, detail); printf("%s\t%s.%s\n", st, fx, label); if (tx_eq(st, "PASS", 1L << 20)) npass++; else if (tx_eq(st, "FAIL", 1L << 20)) nfail++; else nvac++; }
static void check(int ok, const char *fx, const char *label, const char *detail) { row(ok ? "PASS" : "FAIL", fx, label, detail); }
static int prod(char *const extra[], np_result *r) { char *v[16]; int n = 0; v[n++] = bound; v[n++] = "20"; v[n++] = "sh"; v[n++] = product; for (int i = 0; extra[i]; i++) { if (n >= 15) die("argv"); v[n++] = extra[i]; } v[n] = 0; char *env[] = { 0 }; char why[1024]; return np_run(v, root, env, 22, r, why, sizeof why); }
static int tool(const char *bin, char *const extra[], np_result *r) { char *v[16]; int n = 0; v[n++] = bound; v[n++] = "20"; v[n++] = (char *)bin; for (int i = 0; extra[i]; i++) { if (n >= 15) die("argv"); v[n++] = extra[i]; } v[n] = 0; char *env[] = { 0 }; char why[1024]; return np_run(v, root, env, 22, r, why, sizeof why); }
static int same(const char *a, const char *b) { size_t na, nb; char *x = cx_read(a, &na), *y = cx_read(b, &nb); int ok = x && y && na == nb && !memcmp(x, y, na); free(x); free(y); return ok; }
static int count(const char *p, const char *needle) { size_t n; char *b = cx_read(p, &n); if (!b) die(p); int c = 0; for (char *q = b; (q = strstr(q, needle)); q += strlen(needle)) c++; free(b); return c; }

int main(int argc, char **argv) {
    if ((argc != 4 && argc != 5) || !realpath(argv[1], root) || !realpath(argv[2], stream) || argv[3][0] != '/' || (argc == 5 && !realpath(argv[4], ref))) { fputs("usage: ROOT STREAM4_O1_COM ABS_OUT [REF]\n", stderr); return 2; }
    { if (cx_fmt(outdir, sizeof outdir, "%s", argv[3])) { fprintf(stderr, "o1-cases-gen: text too long for outdir\n"); exit(2); } } if (mkdir(outdir, 0700)) die("new out dir must be absent"); path(inc, sizeof inc, root, "include"); path(bound, sizeof bound, root, "tools/bound"); path(product, sizeof product, root, "unisacc.com");
    char rp[4400]; path(rp, sizeof rp, outdir, "results.tsv"); res = fopen(rp, "wbx"); if (!res) die("results");
    { size_t n; char *b = cx_read(stream, &n); if (!b) die("stream"); char h[65]; cx_sha256_hex(b, n, h); free(b); b = cx_read(product, &n); if (!b) die("product"); char hp[65]; cx_sha256_hex(b, n, hp); free(b); fprintf(res, "IDENTITY\tstream=%s\tproduct=%s\tref=%s\n", h, hp, argc == 5 ? ref : "-"); }
    struct { const char *name, *src; int want; } fx[4] = {
        { "loop-call", "static int sq(int x){return x*x;}\nint main(void){int i,s=0;for(i=0;i<5;i++)s+=sq(i);return s;}\n", 30 },
        { "two-args", "int f(int a,int b){int c=a+b;int d=c*2;return d-a;}\nint main(void){return f(3,4);}\n", 11 },
        { "nested-calls", "static int inc(int v){return v+1;}static int dbl(int v){return v*2;}\nint main(void){return dbl(inc(dbl(inc(1))));}\n", 10 },
        { "array-sum", "static int sum(const int *p,int n){int i,s=0;for(i=0;i<n;i++)s+=p[i];return s;}\nint main(void){int a[4]={1,2,3,4};return sum(a,4)+sum(a+1,2);}\n", 15 } };
    for (int i = 0; i < 4; i++) { const char *fxn = fx[i].name; char c[4400], t0[4400], t1[4400], so[4400], tr[4400]; char leaf[80];
        { if (cx_fmt(leaf, sizeof leaf, "%s.c", fxn)) { fprintf(stderr, "o1-cases-gen: text too long for leaf\n"); exit(2); } } path(c, sizeof c, outdir, leaf); saved(c, fx[i].src, strlen(fx[i].src));
        { if (cx_fmt(leaf, sizeof leaf, "%s.O0.tape", fxn)) { fprintf(stderr, "o1-cases-gen: text too long for leaf\n"); exit(2); } } path(t0, sizeof t0, outdir, leaf); { if (cx_fmt(leaf, sizeof leaf, "%s.O1.tape", fxn)) { fprintf(stderr, "o1-cases-gen: text too long for leaf\n"); exit(2); } } path(t1, sizeof t1, outdir, leaf); { if (cx_fmt(leaf, sizeof leaf, "%s.stream-o1.tape", fxn)) { fprintf(stderr, "o1-cases-gen: text too long for leaf\n"); exit(2); } } path(so, sizeof so, outdir, leaf); { if (cx_fmt(leaf, sizeof leaf, "%s.ref-O1.tape", fxn)) { fprintf(stderr, "o1-cases-gen: text too long for leaf\n"); exit(2); } } path(tr, sizeof tr, outdir, leaf);
        np_result r; char *v0[] = { "-S", "-O0", "-o", t0, c, 0 }, *v1[] = { "-S", "-O1", "-o", t1, c, 0 }; if (prod(v0, &r) || r.rc) { row("NOT_RUN", fxn, "product-O0", "compile failed"); np_free(&r); continue; } np_free(&r); if (prod(v1, &r) || r.rc) { row("NOT_RUN", fxn, "product-O1", "compile failed"); np_free(&r); continue; } np_free(&r);
        { char *sv[] = { "12", stream, t0, t0, inc, 0 }; char *v[16]; int n = 0; v[n++] = bound; for (int k = 0; sv[k]; k++) v[n++] = sv[k]; v[n] = 0; char *env[] = { "UNISA_ATTRIBUTES=", "UNISA_MAXSTEPS=200000000", 0 }; char why[1024]; if (np_run(v, root, env, 14, &r, why, sizeof why) || r.rc) { char d[200]; { if (cx_fmt(d, sizeof d, "rc=%d stderr=%.*s", r.rc, (int)(r.errn > 100 ? 100 : r.errn), r.err)) { fprintf(stderr, "o1-cases-gen: text too long for d\n"); exit(2); } } row("NOT_RUN", fxn, "stream-o1", d); np_free(&r); continue; } saved(so, r.out, r.outn); np_free(&r); }
        if (same(t0, so)) { row("VACUOUS", fxn, "guard", "O1 stream left the O0 tape unchanged"); continue; }
        check(same(so, t1), fxn, "o1-model.stream-equals-product-O1-tape", "byte equality");
        int in_sr = count(t0, "  .frame 8\n  store64 [r7+0], r"), out_sr = count(so, "  .frame 8\n  store64 [r7+0], r"), in_mov = count(t0, "\n  mov r"), out_mov = count(so, "\n  mov r"); char d[200]; { if (cx_fmt(d, sizeof d, "save/restore pairs in=%d out=%d; mov lines in=%d out=%d", in_sr, out_sr, in_mov, out_mov)) { fprintf(stderr, "o1-cases-gen: text too long for d\n"); exit(2); } }
        check(in_sr > 0 && out_sr < in_sr && out_mov > in_mov, fxn, "save-restore-to-mov", d);   /* O1 rewrites the pairs it can prove on bounded straight lines (prd S3.7: at most four rounds), not every pair */
        if (argc == 5) { char *rv[] = { "-S", "-O1", "-o", tr, c, 0 }; if (tool(ref, rv, &r) || r.rc) check(0, fxn, "reference-O1-tape", "REF compile failed"); else check(same(so, tr), fxn, "reference-O1-tape", "stream output == classic REF -O1 tape"); np_free(&r); }
        else fprintf(res, "UNVERIFIED\t%s\treference-O1-tape\tno REF given\n", fxn);
        { char *rv[] = { "-run", so, 0 }; if (prod(rv, &r)) check(0, fxn, "o1-tape.executes", "transport"); else { { if (cx_fmt(d, sizeof d, "rc=%d want=%d stdout=%zu", r.rc, fx[i].want, r.outn)) { fprintf(stderr, "o1-cases-gen: text too long for d\n"); exit(2); } } check(r.rc == fx[i].want && !r.outn, fxn, "o1-tape.executes", d); np_free(&r); } } }
    fprintf(res, "SUMMARY\tpass=%d\tfail=%d\tvacuous=%d\n", npass, nfail, nvac); fclose(res); printf("O1_CASES\tpass=%d\tfail=%d\tvacuous=%d\n", npass, nfail, nvac); return nfail || nvac ? 1 : 0;
}
