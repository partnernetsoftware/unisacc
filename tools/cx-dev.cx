    }
    for (k = 0; k < nrec; k++) if (recs[k].affected) { if (recs[k].native) naff++; else if (report) fprintf(stderr, "CXDEV_RECIPE\t%s\t%s\n", recs[k].id, recs[k].absent ? "NOT_DEPLOYED" : "NOT_CLAIMED"); }
    pj(p, sess, "pkg.installed"); if (!(ib = cx_read(p, &ibn))) refuse("session-package-missing", p);
    pkg_parse(&inst, ib, ibn);
    e = getenv("CXDEV_PAR"); if (e && atoi(e) >= 1 && atoi(e) <= 6) par = atoi(e);
    if (naff) {
        why[0] = 0;
        if (ensure_ctor(wt, wctor, wkey, why, sizeof why)) { for (k = 0; k < nrec; k++) if (recs[k].affected && recs[k].native) { { if (cx_fmt(recs[k].why, 96, "%s", why)) refuse("text-too-long", 0); } } naff = -1; }
        else if (!seedch) { cpy(bctor, PW, wctor, PW); cpy(bkey, 65, wkey, 65); }
        else if (ensure_ctor(base, bctor, bkey, why, sizeof why)) { for (k = 0; k < nrec; k++) if (recs[k].affected && recs[k].native) { if (cx_fmt(recs[k].why, 96, "baseline-%s", why)) refuse("text-too-long", 0); } naff = -1; }
    }
    {   FILE *f;
        if (cx_fmt(rel, PW, "idx-%.16s.tsv", A.sha)) refuse("path-too-long", 0);
        pj(idxp, cdir, rel);
        f = fopen(idxp, "w");
        for (k = 0; k < nrec; k++) {
            recs[k].idx = pkg_route_idx(&inst, recs[k].id);
            if (f && recs[k].idx >= 0) {
                char line[96];
                if (!cx_fmt(line, sizeof line, "%s\t%d\n", recs[k].id, recs[k].idx)) fputs(line, f);
            }
        }
        if (f) fclose(f);
    }
    jobs = calloc((size_t)(2 * MAXR), sizeof(Job)); if (!jobs) refuse("allocation", 0);
    pj(p, cdir, "m"); mkp(p);
    {   const char *hm = getenv("HOME"), *cc = getenv("CXDEV_CACHE");
        shm[0] = 0;
        if (cc && cc[0]) { if (cc[0] != 47 || cx_fmt(shm, PW, "%s/m", cc)) shm[0] = 0; }
        else if (!hm || hm[0] != 47 || cx_fmt(shm, PW, "%s/.cache/unisacc/cx-dev/m", hm)) shm[0] = 0;
        if (shm[0] && mkq(shm)) shm[0] = 0;
    }
