/* tools/observe-agents.cx -- supervisor observation of agent tmux panes.
 *   sh ./unisacc.com tools/observe-agents.cx -- [--root DIR] [--panes a,b,c] [--no-git] [--ratchets] [--fixture FILE]
 * A pane is "session:window" or a bare window name matched exactly against tmux list-windows' window_name (no index
 * guessing); no match is one FAILED line and never stops the other panes. --fixture FILE reads panels from a text
 * file instead of tmux ("=== PANE NAME ===" starts one), which is what tests/check-observe-agents.cx drives.
 * Busy comes from the pane's own relative duration (`12m`), never a state file. STALE = a plan/task line names an
 * item whose agentwork/items.tsv status is DONE, CLOSED... or SUPERSEDED; DONE-PARTIAL / DONE-EVIDENCE /
 * DONE-IN-CLONE-NOT-MERGED print PARTIAL instead. Status line = the last line shaped "<glyph> [<dur>] > ..." (a
 * duration means busy, none means idle); plan/topic/task = the last line containing "计划:", "话题:", "任务 ".
 * Output is TSV, at most 30 lines. */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use mem.bytes
#pragma unisa use text.text
#pragma unisa use cxlib.awpath
#define OA_MAXP 16
#define OA_ID 600
#define OA_LINE 1400
#define OA_PANEL (1 << 16)
typedef struct { char name[80], text[OA_PANEL]; } Pane;
static Pane panes[OA_MAXP]; static int npane;
static char ids[OA_ID][80], ids_status[OA_ID][40]; static int nids;
static char root[4096];
static int emitted, truncated, failed, stales;
static void die(const char *a) { fprintf(stderr, "observe-agents: %s\n", a); exit(2); }
static int eqz(const char *a, const char *b) { return a && b && !strcmp(a, b); }
/* copy at most N bytes, never cutting a UTF-8 sequence in half */
static void clip(char *d, size_t cap, const char *s, size_t n) {
    size_t i = 0; if (!cap) return;
    while (i + 1 < cap && i < n && s[i]) { d[i] = s[i]; i++; }
    if (i < n && s[i]) while (i && ((d[i] & 0xC0) == 0x80)) i--;
    d[i] = 0;
}
/* one child, its stdout kept; rc, or -1 when it could not be spawned (WHY in OUT) */
static int run(char **v, char *out, size_t cap) {
    np_result r; char why[512]; int rc;
    if (np_run(v, 0, 0, 20, &r, why, sizeof why)) { clip(out, cap, why, strlen(why)); return -1; }
    clip(out, cap, r.out ? r.out : "", r.outn); rc = r.rc; np_free(&r); return rc;
}
/* one line of P at a time: trailing CR and spaces dropped */
static int next_line(const char **p, char *d, size_t cap) {
    const char *e; size_t n;
    if (!**p) return 0;
    e = strchr(*p, '\n'); n = e ? (size_t)(e - *p) : strlen(*p);
    while (n && ((*p)[n - 1] == '\r' || (*p)[n - 1] == ' ')) n--;
    clip(d, cap, *p, n); *p = e ? e + 1 : *p + n; return 1;
}
static void add_pane(const char *name, const char *text, size_t n) {
    if (npane == OA_MAXP) return;
    clip(panes[npane].name, sizeof panes[0].name, name, strlen(name));
    if (n >= OA_PANEL) n = OA_PANEL - 1;
    if (mm_copy(panes[npane].text, OA_PANEL, text, (long)n)) die("pane text");
    panes[npane].text[n] = 0; npane++;
}
/* the last line containing MK, text after it, box border cut; 0 when absent */
static int last_marked(const char *text, const char *mk, char *out, size_t cap) {
    const char *p = text, *hit = 0; size_t ml = strlen(mk), n = 0;
    while (*p) { const char *e = strchr(p, '\n'); size_t ln = e ? (size_t)(e - p) : strlen(p), i;
        for (i = 0; i + ml <= ln; i++) if (!memcmp(p + i, mk, ml)) { hit = p + i + ml; break; }
        p = e ? e + 1 : p + ln; if (!e) break; }
    if (!hit) return 0;
    while (hit[n] && hit[n] != '\n' && hit[n] != '|' && (unsigned char)hit[n] != 0xC2 && (unsigned char)hit[n] != 0xE2) n++;
    while (n && hit[n - 1] == ' ') n--;
    clip(out, cap, hit, n); return out[0] != 0;
}
/* 1 when LINE is a status line; sets BUSY and DUR ("12m" or "") */
static int status_line(const char *line, int *busy, char *dur) {
    const char *p = line, *q; size_t dl, i; int digits = 1;
    while (*p == ' ') p++;
    if (!*p) return 0;
    while (*p && *p != ' ') p++;
    while (*p == ' ') p++;
    q = p; while (*p && *p != ' ') p++; dl = (size_t)(p - q);
    if (dl == 1 && *q == '>') { *busy = 0; dur[0] = 0; return 1; }
    if (dl < 2 || (q[dl - 1] != 's' && q[dl - 1] != 'm' && q[dl - 1] != 'h')) return 0;
    for (i = 0; i + 1 < dl; i++) if (q[i] < '0' || q[i] > '9') digits = 0;
    if (!digits) return 0;
    while (*p == ' ') p++;
    if (*p != '>') return 0;
    *busy = 1; clip(dur, 12, q, dl); return 1;
}
/* field WANT (1-based) of the TAB-separated LINE; 0 when the line has fewer fields */
static int field(const char *line, size_t ln, int want, const char **val, size_t *vn) {
    size_t k, f = 1, fs = 0;
    for (k = 0; k <= ln; k++) {
        if (k != ln && line[k] != '\t') continue;
        if (f == want) { *val = line + fs; *vn = k - fs; return 1; }
        f++; fs = k + 1;
    }
    return 0;
}
/* agentwork/items.tsv field 1 (id) and field 9 (status), one row per line */
static void load_items(void) {
    char p[4400]; size_t n = 0; char *b; const char *at, *end;
    if (awp_path(root, "items", p, (long)sizeof p)) die("path");
    b = cx_read(p, &n);
    if (!b) {   /* 分片布局:agentwork/items/<ID>.tsv(cc 2026-11-09) */
        char cmd[4600]; char *v[] = {"sh", "-c", cmd, 0}; char *o = 0; size_t on = 0;
        if (!cx_fmt(cmd, sizeof cmd, "cat '%s/agentwork/items/'*.tsv 2>/dev/null", root) && cx_runv_timeout(v, 20, &o, &on) == 0 && o && on) { b = o; n = on; }
    }
    if (!b) { fprintf(stderr, "observe-agents: no items table, STALE disabled\n"); return; }
    for (at = b, end = b + n; at < end && nids < OA_ID;) {
        const char *e = memchr(at, '\n', (size_t)(end - at)), *v1, *v9;
        size_t ln = e ? (size_t)(e - at) : (size_t)(end - at), n1 = 0, n9 = 0;
        if (ln && at[0] != '#' && field(at, ln, 1, &v1, &n1) && field(at, ln, 9, &v9, &n9) &&
            n1 && n1 < sizeof ids[0] && n9 < sizeof ids_status[0]) {
            if (mm_copy(ids[nids], (long)sizeof ids[0], v1, (long)n1) ||
                mm_copy(ids_status[nids], (long)sizeof ids_status[0], v9, (long)n9)) die("items field");
            ids[nids][n1] = 0; ids_status[nids][n9] = 0; nids++;
        }
        at = e ? e + 1 : end;
    }
    free(b);
}
/* 1 = STALE (DONE, CLOSED..., SUPERSEDED), 2 = PARTIAL (tail pending), 0 = live */
static int staleness(const char *tok) {
    int i;
    for (i = 0; i < nids; i++) {
        const char *st;
        if (!eqz(ids[i], tok)) continue;
        st = ids_status[i];
        if (eqz(st, "DONE") || eqz(st, "SUPERSEDED") || !strncmp(st, "CLOSED", 6)) return 1;
        if (!strncmp(st, "DONE-", 5)) return 2;
        return 0;
    }
    return 0;
}
static void emit(const char *a, const char *b, const char *c) {
    if (emitted >= 28) { truncated = 1; return; }
    printf("%s", a); if (b) printf("\t%s", b); if (c) printf("\t%s", c); putchar('\n'); emitted++;
}
/* report every items.tsv id named in one plan/task text */
static void scan_refs(const char *pname, const char *text) {
    const char *p = text;
    while (*p) {
        char tok[80]; size_t n = 0; int s;
        if (!((*p >= 'A' && *p <= 'Z') || (*p >= '0' && *p <= '9'))) { p++; continue; }
        while (*p && ((*p >= 'A' && *p <= 'Z') || (*p >= '0' && *p <= '9') || *p == '-') && n + 1 < sizeof tok) tok[n++] = *p++;
        tok[n] = 0;
        if (n < 2) continue;
        s = staleness(tok);
        if (s == 1) { stales++; emit("STALE", pname, tok); }
        else if (s == 2) emit("PARTIAL", pname, tok);
    }
}
/* TMUX target for SPEC: as given, or the window whose name is SPEC */
static int resolve(const char *spec, char *target, size_t cap, char *why, size_t wcap) {
    char list[1 << 16]; const char *at = list;
    if (strchr(spec, ':')) { clip(target, cap, spec, strlen(spec)); return 0; }
    if (run((char *[]){(char *)"tmux", (char *)"list-windows", (char *)"-a", (char *)"-F",
                       (char *)"#{session_name}:#{window_index}:#{window_name}", 0}, list, sizeof list) < 0) return -1;
    while (*at) {
        char one[400]; const char *c1, *c2;
        next_line(&at, one, sizeof one);
        c1 = strchr(one, ':'); if (!c1) continue;
        c2 = strchr(c1 + 1, ':'); if (!c2) continue;
        if (eqz(c2 + 1, spec)) { clip(target, cap, one, (size_t)(c2 - one)); return 0; }
    }
    { char tmp[400];
      if (cx_fmt(tmp, sizeof tmp, "no-such-pane %s", spec)) die("why");
      if (tx_copy(why, (long)wcap, tmp, (long)strlen(tmp))) die("why-copy");
      return -2; }
}
static void capture_fixture(const char *fixture) {
    size_t n = 0; char p[4400], *b; const char *at;
    if (fixture[0] == '/') clip(p, sizeof p, fixture, strlen(fixture));
    else if (cx_fmt(p, sizeof p, "%s/%s", root, fixture)) die("path");
    b = cx_read(p, &n); if (!b) die("cannot read the fixture");
    for (at = b; at;) {
        const char *nl = strstr(at, "=== PANE "), *m, *nx; char nm[80]; size_t nn;
        if (!nl || !(m = strstr(nl + 9, " ===\n"))) break;
        nn = (size_t)(m - (nl + 9)); if (nn >= sizeof nm) nn = sizeof nm - 1;
        if (mm_copy(nm, (long)sizeof nm, nl + 9, (long)nn)) die("pane name"); nm[nn] = 0;
        nx = strstr(m + 5, "=== PANE ");
        add_pane(nm, m + 5, nx ? (size_t)(nx - (m + 5)) : strlen(m + 5));
        at = nx;
    }
    free(b);
}
static void capture_tmux(const char *names) {
    const char *p = names; char buf[OA_PANEL];
    while (*p) {
        char spec[80], target[200]; size_t n = 0; int rc;
        while (*p && *p != ',' && n + 1 < sizeof spec) spec[n++] = *p++;
        spec[n] = 0; if (*p == ',') p++;
        if (!spec[0]) continue;
        rc = resolve(spec, target, sizeof target, buf, sizeof buf);
        if (rc == 0) rc = run((char *[]){(char *)"tmux", (char *)"capture-pane", (char *)"-p",
                                         (char *)"-t", target, 0}, buf, sizeof buf);
        if (rc) { failed++; printf("FAILED\t%s\t%s\n", spec, rc == -2 ? buf : "tmux capture failed"); }
        else add_pane(spec, buf, strlen(buf));
    }
}
/* Busy/idle from the mind block's first line: a boxed line whose content starts
   with ▶ is busy (a command is running), ○ is idle. -1 when no such line exists.
   The bottom status bar's duration is NOT the busy signal: it is the elapsed time
   of the current round, so an idle agent can still show "30m". */
static int mind_state(const char *text) {
    char line[OA_LINE]; const char *p = text; int st = -1;
    while (next_line(&p, line, sizeof line)) {
        const char *q = line;
        while (*q == ' ') q++;
        if ((unsigned char)q[0] != 0xE2 || (unsigned char)q[1] != 0x94 || (unsigned char)q[2] != 0x82) continue;
        q += 3; while (*q == ' ') q++;
        if ((unsigned char)q[0] == 0xE2 && (unsigned char)q[1] == 0x96 && (unsigned char)q[2] == 0xB6) st = 1;
        else if ((unsigned char)q[0] == 0xE2 && (unsigned char)q[1] == 0x97 && (unsigned char)q[2] == 0x8B) st = 0;
    }
    return st;
}
static void pane_block(const char *what) {
    int i;
    for (i = 0; i < npane; i++) {
        char plan[OA_LINE], topic[OA_LINE], task[OA_LINE], dur[16], line[OA_LINE];
        int busy = 0, have = 0, st; const char *p = panes[i].text;
        while (next_line(&p, line, sizeof line)) if (status_line(line, &busy, dur)) have = 1;
        st = mind_state(panes[i].text);
        { char head[400];
          if (cx_fmt(head, sizeof head, "PANE\t%s\tstate=%s\tbusy_for=%s\tsource=%s",
                     panes[i].name, st == 1 ? "busy" : st == 0 ? "idle" : "unknown",
                     (have && dur[0]) ? dur : "-", what)) die("pane line");
          emit(head, 0, 0); }
        if (!last_marked(panes[i].text, "计划:", plan, sizeof plan)) plan[0] = 0;
        if (!last_marked(panes[i].text, "话题:", topic, sizeof topic)) topic[0] = 0;
        if (!last_marked(panes[i].text, "任务 ", task, sizeof task)) task[0] = 0;
        emit("PLAN", panes[i].name, plan[0] ? plan : "-");
        emit("TOPIC", panes[i].name, topic[0] ? topic : "-");
        emit("TASK", panes[i].name, task[0] ? task : "-");
        scan_refs(panes[i].name, plan); scan_refs(panes[i].name, task);
    }
}
static void git_block(void) {
    char out[4096], one[220]; const char *p = out;
    char *v[] = {(char *)"git", (char *)"-C", root, (char *)"log", (char *)"-3", (char *)"--oneline", 0};
    if (run(v, out, sizeof out)) { emit("GIT", "FAILED", out); return; }
    while (next_line(&p, one, sizeof one)) emit("GIT", "line", one);
}
static void disk_block(void) {
    char out[4096], one[400], use[16] = "-"; int line = 0; const char *p;
    char *v[] = {(char *)"df", (char *)"-h", (char *)"/", 0};
    if (run(v, out, sizeof out)) { emit("DISK", "FAILED", out); return; }
    for (p = out; next_line(&p, one, sizeof one);) {
        int f = 0; size_t at = 0, n;
        if (line++ != 1) continue;
        for (n = strlen(one); at < n;) {
            size_t s = at, z;
            while (s < n && (one[s] == ' ' || one[s] == '\t')) s++;
            z = s; while (z < n && one[z] != ' ' && one[z] != '\t') z++;
            if (z > s && ++f == 5) clip(use, sizeof use, one + s, z - s);
            at = z > s ? z : s + 1;
        }
    }
    emit("DISK", "mount=/", use);
}
static void ratchet_block(void) {
    char out[8192], tool[4400], com[4400], one[200], last[200] = ""; const char *p;
    char *v[] = {(char *)"sh", 0, 0, 0};
    if (cx_fmt(tool, sizeof tool, "%s/tools/ratchets.cx", root) ||
        cx_fmt(com, sizeof com, "%s/unisacc.com", root)) die("path");
    v[1] = com; v[2] = tool;
    if (run(v, out, sizeof out) && !out[0]) { emit("RATCHETS", "FAILED", "-"); return; }
    p = out;
    while (next_line(&p, one, sizeof one)) if (!strncmp(one, "RATCHETS", 8)) clip(last, sizeof last, one, strlen(one));
    emit("RATCHETS", "-", last[0] ? last : "no-summary");
}
int main(int argc, char **argv) {
    const char *names = "omp-cc-opus,omp-go2,omp-go", *fixture = 0; int i, dogit = 1, dorat = 0;
    if (sy_realpath(".", root, (int)sizeof root) < 0 || !root[0]) die("cannot resolve cwd");
    for (i = 1; i < argc; i++) {
        if (eqz(argv[i], "--")) continue;
        else if (eqz(argv[i], "--root") && i + 1 < argc) { if (sy_realpath(argv[++i], root, (int)sizeof root) < 0) die("root"); }
        else if (eqz(argv[i], "--panes") && i + 1 < argc) names = argv[++i];
        else if (eqz(argv[i], "--fixture") && i + 1 < argc) fixture = argv[++i];
        else if (eqz(argv[i], "--no-git")) dogit = 0;
        else if (eqz(argv[i], "--ratchets")) dorat = 1;
        else die("bad argument");
    }
    load_items();
    if (fixture) capture_fixture(fixture); else capture_tmux(names);
    pane_block(fixture ? "fixture" : "tmux");
    if (dogit) git_block();
    disk_block();
    if (dorat) ratchet_block();
    if (truncated) puts("TRUNCATED\toutput capped at 30 lines");
    printf("OBSERVE_AGENTS\tpanes=%d\tstale=%d\tfailed=%d\tlines=%d\n", npane, stales, failed, emitted + (truncated ? 1 : 0));
    return failed ? 1 : 0;
}
