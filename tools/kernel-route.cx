/* Kernel construction route, spec §4.8 [AS-1][AS-8][AS-9]. The candidate product alone turns
 * the canonical kernel assembly into UNIKERN1 on any host that can run unisacc.com:
 *   ROOT/exec/c/asm/<unit>_<ISA>.S --product -E + tools/asm-source.cx--> <unit>.s
 *   <unit>.s --`unisacc.com as -b lnx/<ISA>`--> <unit>.o --tools/kernel-link.cx--> <ISA>.kernel
 * No host assembler, linker, C compiler or Python is invoked by this route itself. tools/bound,
 * the per-child watchdog, is a POSIX sh script that builds tools/bound.c with the host cc once
 * (declared in AS-11); it bounds children and is not part of the produced bytes.
 *
 * Usage: ROOT NEW_ABS_OUT [--constructor ABS_EXEC] [--constructor-sha SHA256] [--package ABS_P4] [--isa x86_64|arm64]... [--units u1,...,u11] [--asm-dir DIR]
 *   --units  must equal the AS-1 canonical order exactly; any other order or set is refused
 *            by name before anything is created (the linker itself would accept it).
 *   --asm-dir reads <unit>_<ISA>.S, layout.h, actions.h and DIR/../core.h from DIR instead of
 *            ROOT/exec/c/asm; the receipt then says canonical=NO (negative tests only).
 * Explicit constructors use ELF directly or APE via sh; other formats are refused.
 * Their package is embedded unless --package explicitly supplies P4; inherited containers are ignored.
 * With no constructor, historical ROOT/unisacc.com and its environment remain unchanged.
 * Output: OUT/<ISA>/<unit>.s, OUT/<ISA>/<unit>.o, OUT/<ISA>.kernel, OUT/route.tsv.
 * This is construction (PREPARED), never a test verdict; tests/kernel-route.cx judges it.
 * Phase times are UNMEASURED here: the prelude has no portable clock. */
#pragma unisa use cxlib.netpack
#pragma unisa use text.text
static const char *canonical_units[11]={"transition","arith","buffer","memory","intern","bytes","format","stack","action","run","bridge"};
static char root[4096],out[4096],asmdir[4096],product[4400],bound[4400];
static int product_shell,explicit_constructor;static char constructor_sha[65];
static char package[4096];
/* ELF runs natively; only the APE shell envelope is accepted otherwise. */
static int command(char **v,const char *seconds){int n=0;v[n++]=bound;v[n++]=(char *)seconds;if(product_shell)v[n++]="sh";v[n++]=product;return n;}
static void die(const char *s){fprintf(stderr,"kernel-route: REFUSE %s\n",s);exit(2);}
static void die2(const char *s,const char *t){fprintf(stderr,"kernel-route: REFUSE %s %s\n",s,t);exit(2);}
static void path(char *p,size_t cap,const char *a,const char *b){int n=snprintf(p,cap,"%s/%s",a,b);if(n<0||(size_t)n>=cap)die("path length");}
static void append_fit(char *dst,size_t cap,const char *src){size_t n=strlen(dst),m=strlen(src),i;if(n>=cap||m>=cap-n)die("unit list");for(i=0;i<m+1;i++)dst[n+i]=src[i];}
static char *load(const char *p,size_t *n){struct stat st;errno=0;if(lstat(p,&st)){fprintf(stderr,"kernel-route: input %s errno=%d\n",p,errno);die("input lstat (only ENOENT means absent; every errno is refused here)");}if(!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>67108864)die2("bounded regular input required:",p);char *s=cx_read(p,n);if(!s||*n!=(size_t)st.st_size)die2("input read:",p);return s;}
static void digest(const char *p,char h[65]){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,h);free(s);}
static void save(const char *p,const char *s,size_t n){int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);size_t at=0;if(fd<0)die2("exclusive output create:",p);while(at<n){ssize_t k=write(fd,s+at,n-at);if(k<0&&errno==EINTR)continue;if(k<=0)die("output write; partial retained");at+=(size_t)k;}if(fsync(fd)||close(fd))die("output close");}
static void child(char **v,const char *what){np_result r;char why[1024];if(np_run(v,root,0,50,&r,why,sizeof why)){if(r.timed_out){fprintf(stderr,"kernel-route: TIMEOUT %s %s\n",what,why);exit(124);}die2(what,why);}if(r.outn)fwrite(r.out,1,r.outn,stderr);if(r.errn)fwrite(r.err,1,r.errn,stderr);int rc=r.rc;np_free(&r);if(rc==142){fprintf(stderr,"kernel-route: TIMEOUT %s watchdog\n",what);exit(124);}if(rc){fprintf(stderr,"kernel-route: %s rc=%d\n",what,rc);die2("child refused:",what);}}
typedef struct {char rel[256];char abs[4400];char sha[65];} input_id;
static input_id inputs[64];static int ninputs;
static void add_input(const char *label,const char *abs){if(ninputs==64)die("input capacity");input_id *d=&inputs[ninputs];{int z=snprintf(d->rel,sizeof(d->rel),"%s",label);if(z<0||(size_t)z>=sizeof(d->rel)){fprintf(stderr,"bound-format\n");exit(2);}};{int z=snprintf(d->abs,sizeof(d->abs),"%s",abs);if(z<0||(size_t)z>=sizeof(d->abs)){fprintf(stderr,"bound-format\n");exit(2);}};digest(abs,d->sha);ninputs++;}
static void recheck_inputs(void){int i;char h[65];for(i=0;i<ninputs;i++){digest(inputs[i].abs,h);if(!tx_eqz(h, inputs[i].sha))die2("input changed during the route:",inputs[i].rel);}}
int main(int argc,char **argv){
 const char *isas[2];int nisa=0,i,a,custom_dir=0,have_units=0;char units_arg[512]="";
 if(argc<3)die("usage ROOT NEW_ABS_OUT [--isa x86_64|arm64]... [--units u1,...,u11] [--asm-dir DIR]");
 if(!realpath(argv[1],root))die("root resolution");if(argv[2][0]!='/'||strlen(argv[2])>=sizeof out)die("NEW_ABS_OUT must be absolute");{int z=snprintf(out,sizeof out,"%s",argv[2]);if(z<0||(size_t)z>=sizeof out){fprintf(stderr,"bound-format\n");exit(2);}};
 path(asmdir,sizeof asmdir,root,"exec/c/asm");
 for(i=3;i<argc;i++){
  if(tx_eqz(argv[i], "--isa")&&i+1<argc){const char *t=argv[++i];if(!tx_eqz(t, "x86_64")&&!tx_eqz(t, "arm64"))die("ISA is x86_64 or arm64");if(nisa==2||(nisa&&tx_eqz(isas[0], t)))die("each ISA at most once");isas[nisa++]=t;}
  else if(tx_eqz(argv[i], "--units")&&i+1<argc){
   if(have_units++)die("--units supplied more than once");
   int z=snprintf(units_arg,sizeof units_arg,"%s",argv[++i]);if(z<0||(size_t)z>=sizeof units_arg)die("unit list length");
  }
  else if(tx_eqz(argv[i], "--asm-dir")&&i+1<argc){if(!realpath(argv[++i],asmdir))die("--asm-dir resolution");custom_dir=1;}
  else if(tx_eqz(argv[i], "--constructor")&&i+1<argc){if(explicit_constructor++||argv[i+1][0]!='/')die("--constructor requires one absolute executable");if(!realpath(argv[++i],product))die("constructor resolution");}
  else if(tx_eqz(argv[i], "--constructor-sha")&&i+1<argc){if(constructor_sha[0]||strlen(argv[i+1])!=64)die("constructor SHA declaration");memcpy(constructor_sha,argv[++i],65);}
  else if(tx_eqz(argv[i], "--package")&&i+1<argc){if(package[0]||argv[i+1][0]!='/'||!realpath(argv[++i],package))die("--package absolute file resolution");}
  else die2("unknown argument",argv[i]);
 }
 if(!nisa){isas[0]="x86_64";isas[1]="arm64";nisa=2;}
 if(have_units){
  /* AS-1: the link order is part of the kernel's identity; refuse before any output exists. */
  char expect[512]="";for(i=0;i<11;i++){if(i)append_fit(expect,sizeof expect,",");append_fit(expect,sizeof expect,canonical_units[i]);}
  if(!tx_eqz(units_arg, expect)){fprintf(stderr,"kernel-route: expected=%s\nkernel-route: given=%s\n",expect,units_arg);die("unit order differs from AS-1 canonical order");}
 }
 if(!explicit_constructor)path(product,sizeof product,root,"unisacc.com");path(bound,sizeof bound,root,"tools/bound");
 if(!explicit_constructor&&(constructor_sha[0]||package[0]))die("constructor declaration/package requires --constructor");
 {size_t z;char *b=load(product,&z),h[65];struct stat st;if(stat(product,&st)||!(st.st_mode&0111))die("constructor executable required");if(z>=4&&!memcmp(b,"\177ELF",4))product_shell=0;else if(z>=8&&!memcmp(b,"MZqFpD='",8))product_shell=1;else die("unknown constructor format (ELF or APE required)");cx_sha256_hex(b,z,h);free(b);if(constructor_sha[0]&&strcmp(constructor_sha,h))die("declared constructor SHA differs from actual file");memcpy(constructor_sha,h,65);}
 if(explicit_constructor){if(package[0]){if(setenv("UNISA_CONTAINER",package,1))die("package environment");}else if(unsetenv("UNISA_CONTAINER"))die("embedded package environment");}
 {struct stat st;errno=0;if(!lstat(out,&st))die("NEW_ABS_OUT must not exist");if(errno!=ENOENT){fprintf(stderr,"kernel-route: output errno=%d\n",errno);die("NEW_ABS_OUT lstat failed with an errno other than ENOENT");}}
 {char p[4400];
  add_input("unisacc.com",product);
  if(package[0])add_input("constructor-package",package);
  const char *tools[]={"tools/kernel-route.cx","tools/asm-source.cx","tools/kernel-link.cx","tools/cxlib/elfkernel.cx","tools/cxlib/netpack.cx","tools/bound","tools/bound.c"};
  for(i=0;i<7;i++){path(p,sizeof p,root,tools[i]);add_input(tools[i],p);}
  path(p,sizeof p,asmdir,"layout.h");add_input("asm/layout.h",p);path(p,sizeof p,asmdir,"actions.h");add_input("asm/actions.h",p);path(p,sizeof p,asmdir,"../core.h");add_input("asm/../core.h",p);
  for(a=0;a<nisa;a++)for(i=0;i<11;i++){char rel[200],name[200];{int z=snprintf(name,sizeof name,"%s_%s.S",canonical_units[i],isas[a]);if(z<0||(size_t)z>=sizeof name){fprintf(stderr,"bound-format\n");exit(2);}};{int z=snprintf(rel,sizeof rel,"asm/%s",name);if(z<0||(size_t)z>=sizeof rel){fprintf(stderr,"bound-format\n");exit(2);}};path(p,sizeof p,asmdir,name);add_input(rel,p);}
 }
 if(mkdir(out,0700))die("NEW_ABS_OUT create");
 np_buf receipt={0};np_puts(&receipt,"unisacc-kernel-route-v1\nstatus\tPREPARED\nspec\tAS-1,AS-8,AS-9\ncanonical\t");np_puts(&receipt,custom_dir?"NO":"YES");np_puts(&receipt,"\nunits\t");for(i=0;i<11;i++){if(i)np_puts(&receipt,",");np_puts(&receipt,canonical_units[i]);}np_puts(&receipt,"\n");
 np_puts(&receipt,"constructor\t");np_puts(&receipt,explicit_constructor?product:"ROOT-default");np_puts(&receipt,"\nconstructor_path\t");np_puts(&receipt,product);np_puts(&receipt,"\nconstructor_sha\t");np_puts(&receipt,constructor_sha);np_puts(&receipt,"\n");
 if(explicit_constructor){np_puts(&receipt,"package\t");np_puts(&receipt,package[0]?package:"constructor-embedded");np_puts(&receipt,"\n");}
 for(i=0;i<ninputs;i++){np_puts(&receipt,"input\t");np_puts(&receipt,inputs[i].rel);np_puts(&receipt,"\t");np_puts(&receipt,inputs[i].sha);np_puts(&receipt,"\n");}
 for(a=0;a<nisa;a++){
  const char *isa=isas[a];char dir[4400],src[11][4400],dst[11][4400],obj[11][4400],kernel[4400],target[32],tool[4400],h[65];char *v[64];int n=0;
  path(dir,sizeof dir,out,isa);if(mkdir(dir,0700))die("ISA output directory");
  {const char *pin=getenv("UNISACC_ASM_SOURCE_SRC");if(pin&&*pin){int z=snprintf(tool,sizeof tool,"%s",pin);if(z<0||(size_t)z>=sizeof tool)die("path length");}else path(tool,sizeof tool,root,"tools/asm-source.cx");}n=command(v,"45");v[n++]=tool;v[n++]="--";v[n++]=root;v[n++]=(char *)isa;if(explicit_constructor){v[n++]="--constructor";v[n++]=product;}
  if(package[0]){v[n++]="--package";v[n++]=package;}
  for(i=0;i<11;i++){char name[200];{int z=snprintf(name,sizeof name,"%s_%s.S",canonical_units[i],isa);if(z<0||(size_t)z>=sizeof name){fprintf(stderr,"bound-format\n");exit(2);}};path(src[i],sizeof src[i],asmdir,name);{int z=snprintf(name,sizeof name,"%s.s",canonical_units[i]);if(z<0||(size_t)z>=sizeof name){fprintf(stderr,"bound-format\n");exit(2);}};path(dst[i],sizeof dst[i],dir,name);v[n++]=src[i];v[n++]=dst[i];}
  v[n]=0;child(v,"asm-source (product -E and AS-2 macro subset)");
  {int z=snprintf(target,sizeof target,"lnx/%s",isa);if(z<0||(size_t)z>=sizeof target){fprintf(stderr,"bound-format\n");exit(2);}};
  for(i=0;i<11;i++){char name[200];{int z=snprintf(name,sizeof name,"%s.o",canonical_units[i]);if(z<0||(size_t)z>=sizeof name){fprintf(stderr,"bound-format\n");exit(2);}};path(obj[i],sizeof obj[i],dir,name);
   char *w[16];int wn=command(w,"20");w[wn++]="as";w[wn++]="-b";w[wn++]=target;w[wn++]=dst[i];w[wn++]="-o";w[wn++]=obj[i];w[wn]=0;char what[300];{int z=snprintf(what,sizeof what,"product as %s %s",isa,canonical_units[i]);if(z<0||(size_t)z>=sizeof what){fprintf(stderr,"bound-format\n");exit(2);}};child(w,what);
   struct stat st;if(lstat(obj[i],&st)||!S_ISREG(st.st_mode))die2("product as wrote no object:",canonical_units[i]);}
  {char name[64];{int z=snprintf(name,sizeof name,"%s.kernel",isa);if(z<0||(size_t)z>=sizeof name){fprintf(stderr,"bound-format\n");exit(2);}};path(kernel,sizeof kernel,out,name);}
  path(tool,sizeof tool,root,"tools/kernel-link.cx");n=command(v,"45");v[n++]=tool;v[n++]="--";v[n++]=(char *)isa;v[n++]=kernel;for(i=0;i<11;i++)v[n++]=obj[i];v[n]=0;child(v,"kernel-link (AS-8)");
  for(i=0;i<11;i++){char rel[200];digest(dst[i],h);{int z=snprintf(rel,sizeof rel,"%s/%s.s",isa,canonical_units[i]);if(z<0||(size_t)z>=sizeof rel){fprintf(stderr,"bound-format\n");exit(2);}};np_puts(&receipt,"source\t");np_puts(&receipt,rel);np_puts(&receipt,"\t");np_puts(&receipt,h);np_puts(&receipt,"\n");
   digest(obj[i],h);{int z=snprintf(rel,sizeof rel,"%s/%s.o",isa,canonical_units[i]);if(z<0||(size_t)z>=sizeof rel){fprintf(stderr,"bound-format\n");exit(2);}};np_puts(&receipt,"object\t");np_puts(&receipt,rel);np_puts(&receipt,"\t");np_puts(&receipt,h);np_puts(&receipt,"\n");}
  digest(kernel,h);np_puts(&receipt,"kernel\t");np_puts(&receipt,isa);np_puts(&receipt,".kernel\t");np_puts(&receipt,h);np_puts(&receipt,"\n");
  printf("PREPARED\tkernel-route\t%s\tkernel_sha256=%s\tcanonical=%s\n",isa,h,custom_dir?"NO":"YES");
 }
 recheck_inputs();
 np_puts(&receipt,"timing\tpreprocess,assemble,link=UNMEASURED(no portable clock in the prelude)\n");
 {char p[4400];path(p,sizeof p,out,"route.tsv");save(p,receipt.p,receipt.n);}free(receipt.p);
 puts("PREPARED\tkernel-route\treceipt=route.tsv\tno-test-result");return 0;
}
