/* release-layout: package caller-supplied CI-verified c46-3 assets; does not grant CI qualification.
 * tools/release-layout.cx -- SOURCE NEW_OUT | --check OUT; requires sha256sum, never modifies SOURCE.
 * Stored ZIP is reconstructed byte-for-byte on check: fixed names, bytes, CRC and metadata, no extra entries.
 * build.json retains the paired product record; SHA256SUMS covers all six published files, not itself. */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use cxlib.netpack
#pragma unisa use text.deflate
static const char *asset[]={"unisacc.com","pkg.bin","slice-win-arm64","unisacc.com.build.json","build.json","unisacc-0.0.46-win-arm64.zip"};
static const char *member[]={"slice-win-arm64","pkg.bin","run.cmd","README-win-arm64.txt"};
static const char *launcher="@echo off\r\nsetlocal\r\nset \"UNISA_CONTAINER=%~dp0pkg.bin\"\r\ncopy /y /b \"%~dp0slice-win-arm64\" \"%~dp0slice-win-arm64.exe\" >nul || exit /b 1\r\n\"%~dp0slice-win-arm64.exe\" %*\r\nexit /b %errorlevel%\r\n";
static const char *readme="Windows ARM64: keep all four files together. From cmd, run run.cmd --version or run.cmd hello.c.\r\nThe launcher copies the CI-verified slice to .exe and sets UNISA_CONTAINER to this directory's pkg.bin.\r\nThe packaging check verifies layout and checksums, not Windows execution or CI qualification.\r\n";
static char scratch[4096];
static void cleanup(void){int i;char p[4400];if(!*scratch)return;for(i=0;i<4;i++){if(!cx_fmt(p,sizeof p,"%s/%s",scratch,member[i]))unlink(p);}if(!cx_fmt(p,sizeof p,"%s/expected.zip",scratch))unlink(p);if(!cx_fmt(p,sizeof p,"%s/expected.sha",scratch))unlink(p);rmdir(scratch);*scratch=0;}
static void fail(const char *s){cleanup();fprintf(stderr,"RELEASE_LAYOUT REFUSE %s\n",s);exit(2);}
static void path(char *p,const char *root,const char *name){if(cx_fmt(p,4400,"%s/%s",root,name))fail("path bound");}
static FILE *openfile(const char *p,const char *mode){FILE *f=fopen(p,mode);if(!f)fail(p);return f;}
static void closefile(FILE *f){if(fclose(f))fail("close");}
static void copyfile(const char *src,const char *dst){char b[32768];size_t n;FILE *a=openfile(src,"rb"),*o=openfile(dst,"wb");while((n=fread(b,1,sizeof b,a)))if(fwrite(b,1,n,o)!=n)fail("write");if(ferror(a))fail("read");closefile(a);closefile(o);}
static int equal(const char *a,const char *b){char x[4096],y[4096];size_t n,m;int same=1;FILE *f=openfile(a,"rb"),*g=openfile(b,"rb");do{n=fread(x,1,sizeof x,f);m=fread(y,1,sizeof y,g);if(n!=m||memcmp(x,y,n))same=0;}while(same&&n);if(ferror(f)||ferror(g))fail("read");closefile(f);closefile(g);return same;}
static void put(FILE *f,unsigned long v,int n){while(n--){if(fputc(v&255,f)==EOF)fail("zip write");v>>=8;}}
static void bytes(FILE *f,const char *s,size_t n){if(fwrite(s,1,n,f)!=n)fail("zip write");}
static unsigned long crc(const char *p,unsigned long *len){unsigned long c=0;unsigned char b[32768];size_t n;FILE *f=openfile(p,"rb");*len=0;while((n=fread(b,1,sizeof b,f))){*len+=n;if(*len>0x7fffffffUL)fail("zip size");c=dz_crc32(c,b,(long)n);}if(ferror(f))fail("crc read");closefile(f);return c;}
static void zip(const char *root,const char *out){unsigned long sum[4],len[4],off[4],start,end;int i;char p[4400],b[32768];size_t n;FILE *z=openfile(out,"wb");
    for(i=0;i<4;i++){FILE *f;const char *s=member[i];path(p,root,s);sum[i]=crc(p,&len[i]);off[i]=(unsigned long)ftell(z);put(z,0x04034b50,4);put(z,20,2);put(z,0,2);put(z,0,2);put(z,0,2);put(z,33,2);put(z,sum[i],4);put(z,len[i],4);put(z,len[i],4);put(z,strlen(s),2);put(z,0,2);bytes(z,s,strlen(s));f=openfile(p,"rb");while((n=fread(b,1,sizeof b,f)))bytes(z,b,n);if(ferror(f))fail("zip source");closefile(f);}
    start=(unsigned long)ftell(z);for(i=0;i<4;i++){const char *s=member[i];put(z,0x02014b50,4);put(z,20,2);put(z,20,2);put(z,0,2);put(z,0,2);put(z,0,2);put(z,33,2);put(z,sum[i],4);put(z,len[i],4);put(z,len[i],4);put(z,strlen(s),2);put(z,0,2);put(z,0,2);put(z,0,2);put(z,0,2);put(z,0,4);put(z,off[i],4);bytes(z,s,strlen(s));}
    end=(unsigned long)ftell(z);put(z,0x06054b50,4);put(z,0,2);put(z,0,2);put(z,4,2);put(z,4,2);put(z,end-start,4);put(z,start,4);put(z,0,2);closefile(z);
}
static void hash(const char *root,const char *name,char *digest){char *v[]={"sha256sum","--",(char *)name,0};np_result r={0};char why[512]={0};int i;if(np_run(v,root,0,10,&r,why,sizeof why)||r.rc||r.outn<65)fail("sha256sum");for(i=0;i<64;i++){char c=r.out[i];if(!((c>='0'&&c<='9')||(c>='a'&&c<='f')))fail("digest");digest[i]=c;}digest[64]=0;np_free(&r);}
static void manifest(const char *root,const char *dest){int i;char h[65];FILE *f=openfile(dest,"wb");for(i=0;i<6;i++){hash(root,asset[i],h);if(fprintf(f,"%s  %s\n",h,asset[i])<0)fail("manifest write");}closefile(f);}
static void literal(const char *root,const char *name,const char *text){char p[4400];FILE *f;path(p,root,name);f=openfile(p,"wb");bytes(f,text,strlen(text));closefile(f);}
static void paired(const char *root){char p[4400],q[4400],h[65],key[128];size_t n;char *record;hash(root,asset[0],h);path(p,root,asset[3]);record=cx_read(p,&n);if(!record)fail("build record");if(cx_fmt(key,sizeof key,"\"product_digest\": \"%s\"",h)||!strstr(record,key))fail("unpaired product digest");free(record);path(q,root,"build.json");if(!equal(p,q))fail("build.json differs from paired record");}
static void check(const char *root){
    char temp[]="/tmp/release-layout-check-XXXXXX",p[4400],q[4400];
    if(!mkdtemp(temp))fail("check temporary directory");
    if(cx_fmt(scratch,sizeof scratch,"%s",temp))fail("scratch path");
    paired(root);literal(temp,member[2],launcher);literal(temp,member[3],readme);
    path(p,root,member[0]);path(q,temp,member[0]);copyfile(p,q);
    path(p,root,member[1]);path(q,temp,member[1]);copyfile(p,q);
    path(q,temp,"expected.zip");zip(temp,q);path(p,root,asset[5]);
    if(!equal(p,q))fail("zip fixed contents");
    path(q,temp,"expected.sha");manifest(root,q);path(p,root,"SHA256SUMS");
    if(!equal(p,q))fail("checksum manifest");
    cleanup();printf("RELEASE_LAYOUT\tstatus=PASS\n");
}
int main(int argc,char **argv){
    char src[4096],out[4096],p[4400],q[4400];int i;
    if(argc!=3)fail("usage: SOURCE NEW_OUT | --check OUT");
    if(!strcmp(argv[1],"--check")){if(!realpath(argv[2],out))fail("output path");check(out);return 0;}
    if(!realpath(argv[1],src))fail("source path");
    if(mkdir(argv[2],0700))fail("NEW_OUT must not exist");
    if(!realpath(argv[2],out))fail("output path");
    for(i=0;i<4;i++){path(p,src,asset[i]);path(q,out,asset[i]);copyfile(p,q);}
    path(p,out,asset[3]);path(q,out,"build.json");copyfile(p,q);
    literal(out,member[2],launcher);literal(out,member[3],readme);
    path(p,out,asset[5]);zip(out,p);
    path(p,out,member[2]);unlink(p);path(p,out,member[3]);unlink(p);
    path(p,out,"SHA256SUMS");manifest(out,p);check(out);return 0;
}
