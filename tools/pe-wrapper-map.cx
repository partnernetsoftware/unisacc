/* Content-preserving PE wrapper certificate; arbitrary DOS script is synthetic.
 * The appended version-resource grammar is restricted to ape-pack's schema. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
static void die(const char *s){fprintf(stderr,"PE_WRAPPER_MAP REFUSE %s\n",s);exit(2);}
static unsigned long u32(const unsigned char *p){return p[0]|(unsigned long)p[1]<<8|(unsigned long)p[2]<<16|(unsigned long)p[3]<<24;}
static unsigned u16(const unsigned char *p){return p[0]|p[1]<<8;}
static long align(long n,long a){if(a<=0||n>2147483647L-a)die("alignment range");return (n+a-1)/a*a;}
static void zero(const unsigned char *p,long n){for(long i=0;i<n;i++)if(p[i])die("nonzero padding");}
static void eq(long a,long b,const char *s){if(a!=b)die(s);}
static void sha(const unsigned char *p,long n,char out[65]){if(sy_sha256_hex(p,n,out)&&cx_sha256_hex(p,n,out))die("hash");}
typedef struct {long start,end,value,vn,child;} Block;
static Block block(const unsigned char *r,long cap,long at,const char *key,int type,long valuebytes){
 if(at<0||at+6>cap)die("resource block bounds");Block b={0};b.start=at;b.end=at+u16(r+at);long units=u16(r+at+2);if(b.end>cap||b.end<at+6||u16(r+at+4)!=type)die("resource block extent/type");long p=at+6;for(const char *k=key;*k;k++){if(p+2>b.end||r[p]!=(unsigned char)*k||r[p+1])die("resource key");p+=2;}if(p+2>b.end||u16(r+p))die("resource key terminator");p+=2;b.value=align(p,4);if(b.value>b.end)die("resource key padding");zero(r+p,b.value-p);b.vn=type?units*2:units;if(valuebytes>=0&&b.vn!=valuebytes)die("resource value length");if(b.value+b.vn>b.end)die("resource value extent");b.child=align(b.value+b.vn,4);if(b.child>b.end){if(b.value+b.vn!=b.end)die("resource tail padding");b.child=b.end;}zero(r+b.value+b.vn,b.child-b.value-b.vn);return b;
}
static void text(const unsigned char *r,Block b,char out[2048]){if(b.vn<2||b.vn>2048||u16(r+b.value+b.vn-2))die("resource text extent");long n=b.vn/2-1;for(long i=0;i<n;i++){unsigned c=u16(r+b.value+2*i);if(c<32||c>126)die("resource text ASCII");out[i]=c;}out[n]=0;if(b.child!=b.end)die("resource text children");}
static long nextblock(const unsigned char *r,long end,long limit){long n=align(end,4);if(n>limit)die("child alignment");zero(r+end,n-end);return n;}
static void resource(const unsigned char *r,long n,long rva){
 if(n<88)die("resource size");unsigned char expect[88]={0};expect[14]=1;expect[16]=16;expect[20]=24;expect[23]=128;expect[38]=1;expect[40]=1;expect[44]=48;expect[47]=128;expect[62]=1;expect[64]=9;expect[65]=4;expect[68]=72;
 for(int i=0;i<72;i++)if(r[i]!=expect[i])die("resource directory tree");eq(u32(r+72),rva+88,"resource data RVA");eq(u32(r+76),n-88,"resource data length");eq(u32(r+80),1200,"resource codepage");eq(u32(r+84),0,"resource reserved");
 Block top=block(r,n,88,"VS_VERSION_INFO",0,52);eq(top.end,n,"version extent");const unsigned char *fixed=r+top.value;unsigned long vals[13]={0xfeef04bdUL,0x10000,0,0,0,0,63,0,0x40004,1,0,0,0};
 Block sf=block(r,top.end,top.child,"StringFileInfo",1,0),table=block(r,sf.end,sf.child,"040904B0",1,0);char name[2048],ver[2048],desc[2048],fv[2048];const char *keys[]={"ProductName","ProductVersion","FileDescription","FileVersion"};char *strings[]={name,ver,desc,fv};long p=table.child;for(int i=0;i<4;i++){Block t=block(r,table.end,p,keys[i],1,-1);text(r,t,strings[i]);p=i==3?t.end:nextblock(r,t.end,table.end);}eq(p,table.end,"string table tail");eq(table.end,sf.end,"string info tail");if(!*name||strlen(name)>1024||strcmp(name,desc)||strcmp(ver,fv))die("version repeated fields");
 unsigned long parts[4]={0};int np=0;const char *s=ver;for(;;){if(np==4)die("version count");int digits=0;unsigned long v=0;while(*s>='0'&&*s<='9'){v=v*10+*s++-'0';if(++digits>5||v>65535)die("version number");}if(!digits)die("version number");parts[np++]=v;if(!*s)break;if(*s++!='.')die("version separator");}if(np<3)die("version count");vals[2]=vals[4]=parts[0]<<16|parts[1];vals[3]=vals[5]=parts[2]<<16|parts[3];for(int i=0;i<13;i++)eq(u32(fixed+i*4),vals[i],"fixed version fields");
 Block vf=block(r,top.end,nextblock(r,sf.end,top.end),"VarFileInfo",1,0),tr=block(r,vf.end,vf.child,"Translation",0,4);eq(tr.end,vf.end,"translation tail");eq(vf.end,top.end,"version children tail");eq(u32(r+tr.value),0x04b00409,"translation value");
}
static long number(const char *s){if(!*s||(s[0]=='0'&&s[1]))die("map number");long n=0;for(;*s;s++){if(*s<'0'||*s>'9'||n>(9223372036854775807L-(*s-'0'))/10)die("map number range");n=n*10+*s-'0';}return n;}
static char *field(char *s,const char *key){size_t n=strlen(key);if(strncmp(s,key,n)||s[n]!='=')die("map key order");return s+n+1;}
static int fields(char *s,char **v){int n=1;v[0]=s;for(;*s;s++)if(*s=='\t'){*s=0;if(n==16)die("map field count");v[n++]=s+1;}return n;}
static char *line(char **p){char *s=*p,*e=strchr(s,'\n');if(!e)die("map line framing");*e=0;*p=e+1;return s;}
static void hashsyntax(const char *s){if(strlen(s)!=64)die("map SHA length");for(int i=0;i<64;i++)if(!((s[i]>='a'&&s[i]<='f')||(s[i]>='0'&&s[i]<='9')))die("map SHA syntax");}
static void modulemap(const char *path,const char *bh,const char *oh,const char *ph,const char *th,long bn,long nh,long extent,const unsigned char *first){
 size_t mn;char *m=cx_read(path,&mn);if(!m||!mn||mn>67108864||m[mn-1]!='\n'||memchr(m,0,mn)||memchr(m,'\r',mn))die("map text");char mh[65];sha((unsigned char *)m,mn,mh);char *p=m,*v[16],*h[8];int n=fields(line(&p),v);if(n!=8||strcmp(v[0],"MODULE_BYTE_ID"))die("map header");const char *keys[]={"origin_sha","merged_sha","rows_sha","episodes_sha","records_sha","image_sha"};for(int i=0;i<6;i++){h[i]=field(v[i+1],keys[i]);hashsyntax(h[i]);}if(strcmp(h[5],bh))die("map image SHA");if(strcmp(v[7],"claim=emitter-context-not-exclusive-ownership"))die("map claim");
 char *body=p;long count=0,code=0,recs=0;while(!strncmp(p,"MODULE\t",7)){n=fields(line(&p),v);if(n!=5||!*v[1]||number(field(v[4],"unit"))!=count)die("map module order");long bytes=number(field(v[2],"bytes")),r=number(field(v[3],"records"));if(bytes>bn-code||r>1000000-recs)die("map module bounds");code+=bytes;recs+=r;count++;}
 const char *tags[]={"UNKNOWN","SHARED","SYNTHETIC"};for(int i=0;i<3;i++){n=fields(line(&p),v);if(n!=3||strcmp(v[0],tags[i]))die("map category order");long bytes=number(field(v[1],"bytes")),r=number(field(v[2],"records"));if(bytes>bn-code||r>1000000-recs)die("map category bounds");code+=bytes;recs+=r;}
 char *bodyend=p;n=fields(line(&p),v);if(n!=3||strcmp(v[0],"OTHER")||strcmp(v[1],"HEADER")||number(field(v[2],"bytes"))!=1024)die("map HEADER");n=fields(line(&p),v);if(n!=3||strcmp(v[0],"OTHER")||strcmp(v[1],"DATA_OR_ALIGN"))die("map DATA");long data=number(field(v[2],"bytes"));if(data>bn||code+1024+data!=bn)die("map conservation");n=fields(line(&p),v);if(n!=6||strcmp(v[0],"MODULE_BYTE_MAP")||number(field(v[1],"image_bytes"))!=bn||number(field(v[2],"accounted_bytes"))!=bn||number(field(v[3],"records"))!=recs||strcmp(v[4],"zero_records=INCLUDED")||strcmp(v[5],"state=CONSERVED")||*p)die("map complete");
 /* Aggregate format has no per-record positions. Its complete code partition
  * must coincide with this PE's actual contiguous .text, entirely in BODY. */
 if(memcmp(first,".text\0\0\0",8)||u32(first+20)!=1024||u32(first+8)!=(unsigned long)code||code>(long)u32(first+16)||1024+code>bn)die("map code outside BODY/text");
 printf("MODULE_BYTE_ID\torigin_sha=%s\tmerged_sha=%s\trows_sha=%s\tepisodes_sha=%s\trecords_sha=%s\timage_sha=%s\tclaim=emitter-context-not-exclusive-ownership\tbare_map_sha=%s\tbare_image_sha=%s\tproduct_sha=%s\ttransform_sha=%s\timage_scope=outer-pe-prefix\n",h[0],h[1],h[2],h[3],h[4],ph,mh,bh,oh,th);
 /* Restore only field separators/newlines in the preserved category region. */
 for(char *q=body;q<bodyend;q++)if(!*q)*q='\t';
 /* Parsing removed both tabs and line ends; reconstruct with schema, keeping
  * contributions and record counts unchanged rather than copying totals. */
 char *q=body;for(long i=0;i<count;i++){char *f[5];for(int j=0;j<5;j++){f[j]=q;char *e=strchr(q,'\t');if(!e)die("map internal split");*e=0;q=e+1;}printf("MODULE\t%s\t%s\t%s\t%s\n",f[1],f[2],f[3],f[4]);}
 for(int i=0;i<3;i++){char *f[3];for(int j=0;j<3;j++){f[j]=q;char *e=strchr(q,'\t');if(!e)die("map internal split");*e=0;q=e+1;}printf("%s\t%s\t%s\n",f[0],f[1],f[2]);}
 printf("OTHER\tHEADER\tbytes=%ld\nOTHER\tDATA_OR_ALIGN\tbytes=%ld\nOTHER\tRESOURCE\tbytes=%ld\nMODULE_BYTE_MAP\timage_bytes=%ld\taccounted_bytes=%ld\trecords=%ld\tzero_records=INCLUDED\tstate=CONSERVED\n",nh,data,extent-(bn+nh-1024),extent,code+nh+data+extent-(bn+nh-1024),recs);free(m);
}

int main(int argc,char **argv){
 int mapped=argc==5&&!strcmp(argv[3],"--module-map");if(argc!=3&&!mapped)die("usage BARE_PE APE_PRODUCT [--module-map BARE_MAP]");size_t bn,on;unsigned char *b=(unsigned char *)cx_read(argv[1],&bn),*o=(unsigned char *)cx_read(argv[2],&on);if(!b||!o||bn<1024||on<1024||bn>67108864||on>134217728)die("input bounds");if(b[0]!='M'||b[1]!='Z'||o[0]!='M'||o[1]!='Z'||u32(b+60)!=64)die("DOS identity");long pe=u32(o+60);if(pe<64||pe+24>(long)on||memcmp(b+64,"PE\0\0",4)||memcmp(o+pe,"PE\0\0",4))die("PE identity");long ns=u16(b+70),opt=u16(b+84),bo=88,oo=pe+24,bs=bo+opt,os=oo+opt;if(ns<1||ns>=96||opt<152||bs+(ns+1)*40>1024||os+(ns+1)*40>(long)on||u16(b+bo)!=0x20b||u16(b+68)!=0x8664)die("PE64 bounds/machine");long fa=u32(b+bo+36),sa=u32(b+bo+32);if(fa<512||fa>65536||(fa&(fa-1))||sa<fa||sa>0x10000000||(sa&(sa-1)))die("alignment");eq(u32(b+bo+60),1024,"bare headers");long nh=u32(o+oo+60),delta=nh-1024;eq(nh,align(pe+486,512)<1024?1024:align(pe+486,512),"stub header geometry");if(delta<0||nh>(long)on||os+(ns+1)*40>nh)die("outer headers");eq(u16(o+pe+6),ns+1,"section count");eq(u16(o+pe+20),opt,"optional size");if(u32(b+bo+108)<5||u32(b+bo+128)||u32(b+bo+132)||u32(b+bo+144)||u32(b+bo+148))die("bare resource/certificate");zero(b+bs+40*ns,1024-bs-40*ns);zero(o+os+40*(ns+1),nh-os-40*(ns+1));
 long maxraw=1024,maxv=align(nh,sa);for(long i=0;i<ns;i++){unsigned char *x=b+bs+40*i,*y=o+os+40*i;long vs=u32(x+8),va=u32(x+12),rs=u32(x+16),ro=u32(x+20);if(!memcmp(x,".rsrc",5)||va%sa||va<align(nh,sa))die("old section RVA/name");if(rs&&(ro<1024||ro%fa||rs%fa||ro+rs>(long)bn))die("old raw range");for(long j=0;j<i;j++){unsigned char *prev=b+bs+40*j;long pr=u32(prev+20),sz=u32(prev+16);if(rs&&sz&&ro<pr+sz&&pr<ro+rs)die("raw overlap");}if(ro+rs>maxraw&&rs)maxraw=ro+rs;if(va+(vs>rs?vs:rs)>maxv)maxv=va+(vs>rs?vs:rs);eq(u32(y+20),ro?ro+delta:0,"section raw delta");for(int j=0;j<40;j++)if((j<20||j>=24)&&x[j]!=y[j])die("section metadata");}
 eq(maxraw,bn,"bare overlay");long image=u32(b+bo+56);if(image%sa||image<align(maxv,sa))die("old image extent");long raw=align(bn+delta,fa),rva=align(image>maxv?image:maxv,sa);unsigned char *rh=o+os+40*ns;long rn=u32(rh+8),rr=u32(rh+16),extent=raw+rr;unsigned char want[40]={'.','r','s','r','c',0,0,0};for(int i=0;i<8;i++)if(rh[i]!=want[i])die("resource section name");eq(u32(rh+12),rva,"resource section RVA");eq(u32(rh+20),raw,"resource raw pointer");eq(rr,align(rn,fa),"resource raw size");eq(u32(rh+36),0x40000040,"resource flags");zero(rh+24,12);if(rn<88||extent>(long)on||raw<(long)bn+delta)die("resource extent");zero(o+bn+delta,raw-bn-delta);zero(o+raw+rn,rr-rn);resource(o+raw,rn,rva);
 eq(u32(o+oo+8),u32(b+bo+8)+rr,"initialized size");eq(u32(o+oo+56),align(rva+rn,sa),"new image size");eq(u32(o+oo+64),0,"checksum");eq(u32(o+oo+128),rva,"resource directory RVA");eq(u32(o+oo+132),rn,"resource directory size");
 for(long i=0;i<24+opt;i++){int skip=(i==6||i==7)||(i>=24+8&&i<24+12)||(i>=24+56&&i<24+68)||(i>=24+128&&i<24+136);if(!skip&&b[64+i]!=o[pe+i])die("unexplained PE header change");}
 if(memcmp(b+1024,o+nh,bn-1024))die("body content");char bh[65],oh[65],ph[65];sha(b,bn,bh);sha(o,on,oh);sha(o,extent,ph);char cert[65536];size_t cn=0;
#define CERT(...) do {int z=snprintf(cert+cn,sizeof cert-cn,__VA_ARGS__);if(z<0||(size_t)z>=sizeof cert-cn)die("certificate buffer");cn+=z;} while(0)
CERT("PE_WRAPPER_ID\tversion=1\tbare_sha=%s\tproduct_sha=%s\tpe_prefix_sha=%s\tbare_bytes=%ld\tproduct_bytes=%ld\tpe_extent=%ld\tdelta=%ld\tclaim=content-preserving-wrapper\n",bh,oh,ph,(long)bn,(long)on,extent,delta);CERT("BODY\told_lo=1024\told_hi=%ld\tnew_lo=%ld\tnew_hi=%ld\tdelta=%ld\n",(long)bn,nh,(long)bn+delta,delta);for(long i=0;i<ns;i++){unsigned char *x=b+bs+40*i;long ro=u32(x+20),rs=u32(x+16);CERT("SECTION\t%ld\tvirtual_size=%lu\trva=%lu\told_lo=%ld\told_hi=%ld\tnew_lo=%ld\tnew_hi=%ld\n",i,u32(x+8),u32(x+12),ro,ro+rs,ro?ro+delta:0,ro?ro+delta+rs:0);}CERT("OTHER\tHEADER\tlo=0\thi=%ld\nOTHER\tRESOURCE\tlo=%ld\thi=%ld\nOTHER\tAPE_PAYLOAD\tlo=%ld\thi=%ld\nCOMPLETE\tpreserved_body_bytes=%ld\tother_bytes=%ld\tproduct_bytes=%ld\n",nh,(long)bn+delta,extent,extent,(long)on,(long)bn-1024,(long)on-bn+1024,(long)on);
#undef CERT
char th[65];sha((unsigned char *)cert,cn,th);if(mapped)modulemap(argv[4],bh,oh,ph,th,bn,nh,extent,b+bs);else if(sy_write_all(1,cert,cn))die("certificate output");free(b);free(o);return 0;
}
