/* Local-only release planning. No network, release mutation, upload or workflow dispatch.
 * --dry-run CANDIDATE_TSV ASSET_DIRECTORY; every planned asset must match the table first. */
#pragma unisa use cxlib.releasecandidate
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use text.text
int main(int argc,char **argv){
    RcCandidate c;char why[1024],dir[4096];
    if(argc!=4||!tx_eqz(argv[1],"--dry-run")){sy_eprintf("usage: --dry-run CANDIDATE_TSV ASSET_DIRECTORY\n");return 2;}
    if(rcand_load(argv[2],&c,why,sizeof why)){sy_eprintf("RELEASE_DISPATCH REFUSED %s\n",why);return 1;}
    int rc=sy_realpath(argv[3],dir,sizeof dir);
    if(rc<0){sy_eprintf("RELEASE_DISPATCH REFUSED asset directory: %s\n",sy_strerror(rc));return 1;}
    if(rcand_verify(&c,dir,7,why,sizeof why)){sy_eprintf("RELEASE_DISPATCH REFUSED %s\n",why);return 1;}
    sy_printf("RELEASE_DISPATCH\tmode=DRY_RUN\texternal_operations=0\n");
    sy_printf("PLAN_DRAFT\trepo=%s\ttag=%s\tcommit=%s\tdraft=true\n",c.repo,c.tag,c.commit);
    for(int i=0;i<7;i++)if(!rcand_skip(&c,i))sy_printf("PLAN_UPLOAD\tname=%s\tpath=%s/%s\tsha256=%s\n",c.name[i],dir,c.name[i],c.sha[i]);
    sy_printf("PLAN_WORKFLOW\trepo=%s\tworkflow=%s\tref=%s\n",c.repo,c.workflow,c.workflow_ref);
    sy_printf("INPUT\tape_sha256\t%s\n",c.sha[0]);
    sy_printf("INPUT\tcommit\t%s\n",c.commit);
    sy_printf("INPUT\trelease_tag\t%s\n",c.tag);
    sy_printf("INPUT\tape_url\thttps://github.com/%s/releases/download/%s/%s\n",c.repo,c.tag,c.name[0]);
    sy_printf("CI_EVIDENCE\trun_id=%s\tscope=recorded-not-rechecked\n",c.ci_run_id);
    return 0;
}
