/* Checks tools/a12-cycle.cx (repo root): --dry-run with a scratch BUILD holding tools/{gen,tbl,net,net-binary.cx}
   plus --src/--neg43 prints the fixed PLAN order gen..neg43, the reuse-scope ENV line and steps=12 failed=0;
   negatives: an empty BUILD stops at "STEP gen MISSING" with the build-first hint, and --only neg43 without
   --neg43 stops at "STEP neg43 MISSING"; both exit 1.  Prints CHECK_A12_CYCLE<TAB>failed=N. */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use text.text
static int failed;
static void ck(int ok, const char *n) { if (!ok) failed++; printf("%s\ta12-cycle.%s\n", ok ? "PASS" : "FAIL", n); }
static int run(char **x, np_result *r) {
    char *v[16] = { "sh", "./unisacc.com", "tools/a12-cycle.cx", "--", "--dry-run" }; int i = 5; char why[512];
    while (*x && i < 15) v[i++] = *x++;
    v[i] = 0; return np_run(v, 0, 0, 55, r, why, sizeof why) ? -1 : r->rc;
}
int main(void) {
    char d[4096], e[4096], p[4400]; np_result r = { 0 };
    const char *steps[] = { "gen", "tbl", "net", "bin", "e2", "e1", "sim", "decide", "decide-rtc", "check-decide", "ratchets", "neg43", 0 };
    if (cx_fmt(d, sizeof d, "%s/check-a12-cycle-%d", sy_tmpdir(), (int)getpid()) || cx_fmt(e, sizeof e, "%s-empty", d)) return 2;
    sy_mkdir(d, 0700); sy_mkdir(e, 0700); if (cx_fmt(p, sizeof p, "%s/tools", d)) return 2; sy_mkdir(p, 0700);
    const char *t[] = { "gen", "tbl", "net", "net-binary.cx", 0 };
    for (int i = 0; t[i]; i++) { if (cx_fmt(p, sizeof p, "%s/tools/%s", d, t[i])) return 2; int fd = sy_open_new(p, 0600); if (fd >= 0) sy_close(fd); }
    char *a1[] = { "--build", d, "--src", "tools/a12-cycle.cx", "--neg43", "tools/bound", 0 };
    int rc = run(a1, &r), ok = rc == 0; const char *at = r.out ? r.out : "";
    for (int i = 0; ok && steps[i]; i++) { char w[64]; if (cx_fmt(w, sizeof w, "PLAN\t%s\t", steps[i])) return 2; at = strstr(at, w); ok = at != 0; if (at) at++; }
    ck(ok, "dry-run-sequence");
    ck(r.out && strstr(r.out, "ENV\tUNISACC_WAVE_REUSE=1\t") && strstr(r.out, "release chain default off") && strstr(r.out, "steps=12 failed=0 dry_run=1"), "summary");
    np_free(&r);
    char *a2[] = { "--build", e, 0 }; rc = run(a2, &r);
    ck(rc == 1 && r.out && strstr(r.out, "STEP\tgen\tMISSING\t") && strstr(r.out, "build G with main first") && !strstr(r.out, "PLAN"), "missing-gen-named");
    np_free(&r);
    char *a3[] = { "--only", "neg43", 0 }; rc = run(a3, &r);
    ck(rc == 1 && r.out && strstr(r.out, "STEP\tneg43\tMISSING\t"), "missing-neg43-named");
    np_free(&r);
    printf("CHECK_A12_CYCLE\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
