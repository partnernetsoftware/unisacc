/* tools/flow-gen.cx -- derive manifest -> flow node table that tools/flowrun.cx runs as is.
 *
 *   sh ./unisacc.com tools/flow-gen.cx -- --mode check|write --out FILE.tsv [--derive FILE]
 *
 * Input: exec/facts/derive.tsv (8 columns: name generator check_argv write_argv outputs inputs_glob
 * order bound_s; --derive names another manifest, for fixtures).  Output: one exec node per row,
 *   id <TAB> exec <TAB> deps <TAB> a0=..;a1=..;...;timeout_ms=N[;lock=NAME]
 * in (order, manifest line) sequence, so the file order is itself a topological order.
 *   argv        check_argv (mode check) or write_argv (mode write), split on spaces, one aN per word,
 *               bytes ';' '%' and anything <= 0x20 written as %XX.  No tools/bound wrapper: the
 *               engine bounds the node (timeout_ms = bound_s * 1000, bound_s "-" is 30).
 *   lock        rows whose outputs intersect (same path, or one is a directory "d/" holding the
 *               other; transitively) carry the same lock=derive-out-<first row of the group>;
 *               a row that shares no output has no lock.  Both modes.
 *   deps        mode check: none.  A check only reads, and the engine skips the dependants of a node
 *               that did not end ok, so an edge would turn one DRIFT into skipped checks downstream
 *               and lose their verdicts; derive --check also runs every row whatever the others say.
 *               mode write: B depends on A when order(A) < order(B) and an output of A matches an
 *               inputs_glob word of B ('*' matches any run of bytes including '/'; a directory
 *               output also matches a glob that lies under it).  A row with write_argv "-" runs its
 *               check_argv instead (derive: NEEDS_BUMP), writes nothing, and so gets no dependants.
 * Not carried over from derive --write: the snapshot of outputs and the restore on failure.  A write
 * table is generated only; nothing here runs it.
 * Prints FLOW_GEN<TAB>mode=M<TAB>nodes=N<TAB>edges=E<TAB>locked=L<TAB>out=FILE, rc 0.
 * rc 2: usage, unreadable or malformed manifest (REFUSE<TAB>file<TAB>line=N<TAB>reason), write failure.
 * Verdict mapping when a check table is run: node ok -> OK, fail rc=1 -> DRIFT, timeout -> TIMEOUT,
 * any other fail -> REFUSED (derive's classify()).
 * Check: tools/check-flow-gen.cx. */
#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.bytes
#pragma unisa use mem.heap

#define MAXR 64
#define OUTCAP (1 << 20)
typedef struct { const char *f[8]; long n[8]; int order, bound, line, grp; } Row;
static Row rows[MAXR]; static int nr, ord[MAXR];
static char *ob; static long on;

static int seqn(const char *a, long an, const char *b) { long n = tx_len(b, 4096); return an == n && mm_same(a, b, n); }
static int put(const char *s, long n) {
    if (on + n + 1 >= OUTCAP) return 1;
    mm_copy(ob + on, OUTCAP - on, s, n); on += n;
    return 0;
}
static int puts_(const char *s) { return put(s, tx_len(s, 4096)); }
static int putnum(long v) { char b[32]; if (cx_fmt(b, sizeof b, "%ld", v)) return 1; return puts_(b); }
static int putenc(const char *s, long n) {
    static const char hx[] = "0123456789ABCDEF"; long i;
    for (i = 0; i < n; i++) {
        unsigned char c = (unsigned char)s[i]; char e[3];
        if (c <= 0x20 || c == ';' || c == '%') { e[0] = '%'; e[1] = hx[c >> 4]; e[2] = hx[c & 15]; if (put(e, 3)) return 1; }
        else if (put(s + i, 1)) return 1;
    }
    return 0;
}
static int refuse(const char *f, int line, const char *why) { printf("REFUSE\t%s\tline=%d\t%s\n", f, line, why); return 2; }
static int to_int(const char *s, long n, int *v) {
    long k; int x = 0;
    if (n <= 0 || n > 6) return 1;
    for (k = 0; k < n; k++) { if (s[k] < '0' || s[k] > '9') return 1; x = x * 10 + (s[k] - '0'); }
    *v = x; return 0;
}
static int glob(const char *g, long gn, const char *s, long sn) {
    while (gn > 0) {
        if (g[0] == '*') { long k; for (k = 0; k <= sn; k++) if (glob(g + 1, gn - 1, s + k, sn - k)) return 1; return 0; }
        if (sn <= 0 || g[0] != s[0]) return 0;
        g++; gn--; s++; sn--;
    }
    return sn == 0;
}
/* next space separated word of S[0..N) from *AT; 0 when none */
static int word(const char *s, long n, long *at, const char **w, long *wn) {
    long i = *at, b;
    while (i < n && s[i] == ' ') i++;
    b = i;
    while (i < n && s[i] != ' ') i++;
    *at = i; *w = s + b; *wn = i - b;
    return i > b;
}
static int is_dir(const char *p, long n) { return n > 0 && p[n - 1] == '/'; }
static int under(const char *d, long dn, const char *p, long pn) { return is_dir(d, dn) && pn >= dn && mm_same(d, p, dn); }
static int paths_meet(const char *a, long an, const char *b, long bn) {
    return (an == bn && mm_same(a, b, an)) || under(a, an, b, bn) || under(b, bn, a, an);
}
static int outs_meet(const Row *a, const Row *b) {
    long i = 0, j; const char *x, *y; long xn, yn;
    while (word(a->f[4], a->n[4], &i, &x, &xn)) { j = 0; while (word(b->f[4], b->n[4], &j, &y, &yn)) if (paths_meet(x, xn, y, yn)) return 1; }
    return 0;
}
static int feeds(const Row *a, const Row *b) {   /* an output of A is an input of B */
    long i = 0, j; const char *x, *g; long xn, gn;
    while (word(a->f[4], a->n[4], &i, &x, &xn)) { j = 0; while (word(b->f[5], b->n[5], &j, &g, &gn)) if (glob(g, gn, x, xn) || under(x, xn, g, gn)) return 1; }
    return 0;
}
static int load(const char *path) {
    size_t n = 0; char *b = cx_read(path, &n); long at = 0; int line = 0, i, j;
    if (!b) return refuse(path, 0, "unreadable");
    while (at < (long)n) {
        long e = tx_chr(b + at, (long)n - at, '\n'), ln = e < 0 ? (long)n - at : e, k, s = 0; int nf = 0;
        const char *l = b + at; Row *r;
        at += ln + 1; line++;
        if (ln == 0 || l[0] == '#') continue;
        if (nr >= MAXR) return refuse(path, line, "too-many-rows");
        r = &rows[nr];
        for (k = 0; k <= ln; k++) if (k == ln || l[k] == '\t') { if (nf >= 8) return refuse(path, line, "field-count"); r->f[nf] = l + s; r->n[nf] = k - s; nf++; s = k + 1; }
        if (nf != 8) return refuse(path, line, "field-count");
        for (k = 0; k < 7; k++) if (r->n[k] <= 0) return refuse(path, line, "empty-field");
        for (k = 0; k < r->n[0]; k++) { char c = r->f[0][k]; if (c <= 0x20 || c == ',' || c == ';' || c == '%') return refuse(path, line, "bad-name"); }
        if (seqn(r->f[2], r->n[2], "-")) return refuse(path, line, "no-check-argv");
        if (to_int(r->f[6], r->n[6], &r->order)) return refuse(path, line, "bad-order");
        if (seqn(r->f[7], r->n[7], "-")) r->bound = 30;
        else if (to_int(r->f[7], r->n[7], &r->bound) || r->bound < 1 || r->bound > 300) return refuse(path, line, "bad-bound");
        for (i = 0; i < nr; i++) if (rows[i].n[0] == r->n[0] && mm_same(rows[i].f[0], r->f[0], r->n[0])) return refuse(path, line, "duplicate-name");
        r->line = line; r->grp = nr; nr++;
    }
    if (!nr) return refuse(path, 0, "no-rows");
    for (i = 0; i < nr; i++) ord[i] = i;
    for (i = 1; i < nr; i++) { int v = ord[i]; for (j = i; j > 0 && rows[ord[j - 1]].order > rows[v].order; j--) ord[j] = ord[j - 1]; ord[j] = v; }
    return 0;
}

int main(int argc, char **argv) {
    const char *mode = 0, *outp = 0, *src = "exec/facts/derive.tsv";
    int a, wr, i, j, rc, edges = 0, locked = 0, changed = 1, gsize[MAXR];
    for (a = 1; a < argc; a++) {
        if (tx_eqz(argv[a], "--mode") && a + 1 < argc) mode = argv[++a];
        else if (tx_eqz(argv[a], "--out") && a + 1 < argc) outp = argv[++a];
        else if (tx_eqz(argv[a], "--derive") && a + 1 < argc) src = argv[++a];
        else { mode = 0; break; }
    }
    if (!mode || !outp || (!tx_eqz(mode, "check") && !tx_eqz(mode, "write"))) {
        printf("REFUSE\tusage: flow-gen.cx -- --mode check|write --out FILE.tsv [--derive FILE]\n");
        return 2;
    }
    wr = tx_eqz(mode, "write");
    if ((rc = load(src)) != 0) return rc;
    /* lock groups: smallest row index of each set of rows connected by intersecting outputs */
    while (changed) {
        changed = 0;
        for (i = 0; i < nr; i++) for (j = 0; j < nr; j++)
            if (i != j && rows[j].grp < rows[i].grp && outs_meet(&rows[i], &rows[j])) { rows[i].grp = rows[j].grp; changed = 1; }
    }
    for (i = 0; i < nr; i++) gsize[i] = 0;
    for (i = 0; i < nr; i++) gsize[rows[i].grp]++;
    ob = mm_alloc(OUTCAP);
    if (!ob) return 2;
    rc = puts_("# flow v1 (id op deps args) mode=") || puts_(mode) || puts_(" -- generated by tools/flow-gen.cx from ") || puts_(src) || puts_("; do not edit. Run: tools/flowrun.cx run FILE\n");
    for (i = 0; i < nr && !rc; i++) {
        Row *r = &rows[ord[i]]; int nd = 0, k = 0, use_wr = wr && !seqn(r->f[3], r->n[3], "-");
        const char *av = use_wr ? r->f[3] : r->f[2], *w; long an = use_wr ? r->n[3] : r->n[2], at = 0, wn;
        rc = put(r->f[0], r->n[0]) || puts_("\texec\t");
        if (wr) for (j = 0; j < nr && !rc; j++) {
            Row *d = &rows[ord[j]];
            if (d == r || d->order >= r->order || seqn(d->f[3], d->n[3], "-") || !feeds(d, r)) continue;
            rc = (nd ? puts_(",") : 0) || put(d->f[0], d->n[0]); nd++; edges++;
        }
        if (!nd && !rc) rc = puts_("-");
        if (!rc) rc = puts_("\t");
        while (!rc && word(av, an, &at, &w, &wn)) { rc = puts_("a") || putnum(k++) || puts_("=") || putenc(w, wn) || puts_(";"); }
        if (!rc && !k) return refuse(src, r->line, "empty-argv");
        if (!rc) rc = puts_("timeout_ms=") || putnum((long)r->bound * 1000);
        if (!rc && gsize[r->grp] > 1) { Row *g = &rows[r->grp]; rc = puts_(";lock=derive-out-") || put(g->f[0], g->n[0]); locked++; }
        if (!rc) rc = puts_("\n");
    }
    if (rc) { printf("REFUSE\t%s\toutput-too-large\n", src); return 2; }
    if (cx_write(outp, ob, on)) { printf("REFUSE\t%s\twrite-failed\n", outp); return 2; }
    printf("FLOW_GEN\tmode=%s\tnodes=%d\tedges=%d\tlocked=%d\tout=%s\n", mode, nr, edges, locked, outp);
    return 0;
}
