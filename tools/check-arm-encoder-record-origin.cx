/* Independent hand-built consistency fixture, not sim. Metadata/label/blank gaps,
 * pass0 discarded output, pass1 zero byte row and 3-word row are all explicit. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sysx.process
static char home[4400],dir[4400],com[4400],tool[4400],target[4400],config[4400],watch[4400],image[4400];static int checks,bad;
static const char *source="@target lnx/arm64\nzero x\nlabel:\n\nmulti x\n";
static const char *profile="START\tpass,lnum\nOP.end\tpass,lnum,lstart,end\nREWIND\tpass,lnum\nREWIND.r362\tpass,lnum\nIMAGE.ready\tpass,endo,has_data\nLIB.imagebegin\tendo,target_os,lib_present\nEH.r814\ttext_blob,endo,host_dyn\nEI.pad\tendo\n";
static void die(void){fprintf(stderr,"arm encoder fixture IO\n");exit(2);}
static void put(unsigned char *p,int at,unsigned long long v,int n){for(int i=0;i<n;i++){p[at+i]=v&255;v>>=8;}}
static void fixture(int mode){if(strlen(source)!=41||cx_write(target,source,strlen(source))||cx_write(config,profile,strlen(profile)))die();unsigned char b[188]={0};memcpy(b,"\177ELF\2\1\1",7);put(b,16,2,2);put(b,18,183,2);put(b,20,1,4);put(b,24,4194304+176,8);put(b,32,64,8);put(b,52,64,2);put(b,54,56,2);put(b,56,2,2);put(b,64,1,4);put(b,68,5,4);put(b,80,4194304,8);put(b,96,188,8);put(b,104,188,8);put(b,120,1,4);put(b,124,6,4);put(b,128,188,8);if(cx_write(image,b,sizeof b))die();char th[65],ch[65],ih[65];cx_sha256_hex(source,strlen(source),th);cx_sha256_hex(profile,strlen(profile),ch);cx_sha256_hex(b,sizeof b,ih);FILE *f=fopen(watch,"wb");if(!f)die();fprintf(f,"WRITE_EVENTS\tversion=1\tdelta_sha=8d56c3089e1b46d459d35f577bc8bf2f683f30b198bf0305099f48dffe6e1e3d\tinput_sha=%s\toutput_sha=%s\toutput_bytes=188\tclaim=STATE_OBSERVATION_ONLY\tconfig_sha=%s\twatch_format=compact-v1\n",th,ih,ch);long seq=0;fprintf(f,"FRAME\t%ld\t1\t%s\t41\n",++seq,th);
 int slots[11]={0,1,1,2,3,1,1,4,5,6,7};long cur[11]={0,22,38,41,41,22,38,41,41,41,41};long out[11]={0,0,4,24,24,0,0,12,12,176,188};long a[11][4]={{0,0},{0,0,18,22},{0,1,33,38},{0,2},{0,2},{1,2,18,22},{1,3,33,38},{1,12,1},{12,1,0},{1,12,0},{12}};int arity[8]={2,4,2,2,3,3,3,1};
 if(mode==1)a[5][0]=0;if(mode==2)a[6][2]=18;if(mode==3)out[9]=175;if(mode==4)a[7][1]=13;if(mode==5)a[9][2]=1;if(mode==10)a[5][1]=0;
 for(int i=0;i<11;i++){if(mode==6&&i==4)continue;fprintf(f,"WATCHC\t%ld\t%d\t%ld\t%ld\t0\t%ld\t0\t0",++seq,slots[i],mode==7?2L:1L,cur[i],out[i]);for(int j=0;j<arity[slots[i]];j++)fprintf(f,"\t%ld",a[i][j]);fputc('\n',f);}
 if(mode!=8)fprintf(f,"COMPLETE\tevents=%ld\n",seq);if(fclose(f))die();if(mode==9&&cx_write(target,"changed\n",8))die();}
static void check(int mode,int expected,const char *label){fixture(mode);char *v[]={"sh",com,tool,"--",target,config,watch,image,0};np_result r={0};char why[512]={0};int tr=np_run(v,home,0,8,&r,why,sizeof why);int ok=!tr&&!r.residue&&r.rc==expected;if(!expected)ok=ok&&strstr(r.out,"RECORD\t0\ttarget_lo=18\ttarget_hi=25\ttext_lo=0\ttext_hi=0\tfile_lo=176\tfile_hi=176")&&strstr(r.out,"RECORD\t1\ttarget_lo=33\ttarget_hi=41\ttext_lo=0\ttext_hi=12\tfile_lo=176\tfile_hi=188");else ok=ok&&!r.outn;checks++;bad+=!ok;printf("%s\t%s\n",ok?"PASS":"FAIL",label);if(!ok)fprintf(stderr,"tr=%d rc=%d %s %s\n",tr,r.rc,why,r.err?r.err:"");np_free(&r);}
static void format_fixture(int mac,int bad){
 unsigned char b[4108]={0};long n=mac?4108:2048;
 if(mac){
  put(b,0,4277009103ULL,4);put(b,4,16777228,4);put(b,8,0,4);put(b,12,2,4);put(b,16,12,4);put(b,20,832,4);
  put(b,32,25,4);put(b,36,152,4);memcpy(b+40,"__TEXT",6);put(b,56,4294967296ULL,8);put(b,64,4096,8);put(b,80,4096,8);put(b,88,7,4);put(b,92,5,4);put(b,96,1,4);
  memcpy(b+104,"__text",6);memcpy(b+120,"__TEXT",6);put(b,136,4294968316ULL,8);put(b,144,bad?13:12,8);put(b,152,1020,4);
  put(b,184,2147483688ULL,4);put(b,188,24,4);put(b,192,1020,8);put(b,208,29,4);put(b,212,16,4);put(b,216,4096,4);put(b,220,12,4);
  long a=224;for(int i=0;i<9;i++){long z=i==8?64:72;put(b,a,12,4);put(b,a+4,z,4);put(b,a+8,24,4);memcpy(b+a+24,"/lib/fixture.dylib",18);a+=z;}for(int i=0;i<3;i++)put(b,1020+i*4,3596551104ULL,4);b[4096]=250;b[4097]=222;b[4098]=12;b[4099]=192;b[4103]=12;
 }else{
  memcpy(b,"MZ",2);put(b,60,128,4);put(b,128,17744,4);put(b,132,43620,2);put(b,134,3,2);put(b,148,240,2);put(b,150,34,2);put(b,152,523,2);put(b,168,4096,4);put(b,176,5368709120ULL,8);put(b,184,4096,4);put(b,188,512,4);put(b,208,16384,4);put(b,212,1024,4);put(b,220,3,2);put(b,260,16,4);
  long a=392;memcpy(b+a,".text",5);put(b,a+8,bad?13:12,4);put(b,a+12,4096,4);put(b,a+16,512,4);put(b,a+20,1024,4);put(b,a+36,1610612768,4);a+=40;memcpy(b+a,".data",5);put(b,a+8,8,4);put(b,a+12,8192,4);put(b,a+20,1536,4);a+=40;memcpy(b+a,".reloc",6);put(b,a+8,12,4);put(b,a+12,12288,4);put(b,a+16,512,4);put(b,a+20,1536,4);for(int i=0;i<3;i++)put(b,1024+i*4,3596551104ULL,4);put(b,1536,8192,4);put(b,1540,12,4);
 }if(cx_write(image,b,n))die();
}
/* Independently assembled format/transcript consistency fixture, not sim evidence. */
static void forward_fixture(int badfield){
 format_fixture(0,badfield==1);size_t n;char *old=cx_read(image,&n);unsigned char b[4608]={0};if(!old||n!=2048)die();memcpy(b,old,1536);free(old);
 long o=152,rd=8192,rf=1536,df=3072,dt=12288;unsigned long long cookie=5368709120ULL+dt+128;
 put(b,134,4,2);put(b,o+4,512,4);put(b,o+56,20480,4);put(b,o+70,33088,2);put(b,o+120,badfield==2?rd+1:rd,4);put(b,o+124,40,4);put(b,o+152,16384,4);put(b,o+156,12,4);put(b,o+192,rd+936,4);put(b,o+196,320,4);put(b,o+208,rd+256,4);put(b,o+212,216,4);
 memset(b+432,0,120);long a=432;memcpy(b+a,".rdata",6);put(b,a+8,1256,4);put(b,a+12,rd,4);put(b,a+16,1536,4);put(b,a+20,rf,4);put(b,a+36,1073741888,4);
 a+=40;memcpy(b+a,".data",5);put(b,a+8,128,4);put(b,a+12,dt,4);put(b,a+16,1024,4);put(b,a+20,df,4);put(b,a+36,3221225536ULL,4);
 a+=40;memcpy(b+a,".reloc",6);put(b,a+8,12,4);put(b,a+12,16384,4);put(b,a+16,512,4);put(b,a+20,4096,4);put(b,a+36,1107296320,4);
 put(b,rf,rd+40,4);put(b,rf+12,rd+916,4);put(b,rf+16,rd+256,4);memcpy(b+rf+916,"KERNEL32.dll",13);put(b,rf+936,320,4);put(b,rf+1024,cookie,8);
 const int names[26]={472,488,500,512,526,540,554,572,588,606,620,644,662,676,690,708,730,752,772,788,808,830,852,868,886,900};for(int i=0;i<26;i++){put(b,rf+40+i*8,rd+names[i],8);put(b,rf+256+i*8,rd+names[i],8);}if(badfield==3)b[rf+256]++;
 put(b,4096,16384,4);put(b,4100,12,4);if(cx_write(image,b,sizeof b))die();
}


static const char *chosen;
static const char *foreign_cfg(int mac){return mac?"START\tpass,lnum\nOP.end\tpass,lnum,lstart,end\nREWIND\tpass,lnum\nREWIND.r362\tpass,lnum\nIMAGE.ready\tpass,endo,has_data\nLIB.imagebegin\tendo,target_os,lib_present,memory_mode,host_dyn\nMH.text\ttext_blob,endo\nMH.copy\tendo\tframe-edges\nMH.r938\tmh_sigoff\nMH.r939\tmh_sigoff\n":"START\tpass,lnum\nOP.end\tpass,lnum,lstart,end\nREWIND\tpass,lnum\nREWIND.r362\tpass,lnum\nIMAGE.ready\tpass,endo,has_data\nLIB.imagebegin\tendo,target_os,lib_present,memory_mode,host_dyn\nPE.r1016\ttext_blob,endo\nPE.copy\tendo\tframe-edges\nPE.r1136\tpe_rlsize\nPE.r1137\tpe_rlsize\nPE.header.forward\tpe_rd,pe_rf,pe_df,pe_dt,pe_cookie,pe_relf,pe_rlsize,pe_cookie_shift\nPE.imports.forward\tpe_rd,pe_rf,pe_df,pe_cookie\n";}

static void foreign_fixture(int mode){
 int mac=!strcmp(chosen,"osx/arm64");if(!mac&&strcmp(chosen,"win/arm64-forward"))die();if(mac)format_fixture(1,mode==2);else forward_fixture(mode==2?1:mode==4?2:0);
 const char *cfg=foreign_cfg(mac);if(cx_write(target,source,41)||cx_write(config,cfg,strlen(cfg)))die();size_t n;char *im=cx_read(image,&n),th[65],ch[65],ih[65],a[65],b[65];if(!im)die();long H=mac?1020:1024,P=4096,L=mac?4096:12;cx_sha256_hex(source,41,th);cx_sha256_hex(cfg,strlen(cfg),ch);cx_sha256_hex(im,n,ih);cx_sha256_hex(im+H,12,a);cx_sha256_hex(im+(mac?0:P),L,b);free(im);
 FILE *f=fopen(watch,"wb");if(!f)die();fprintf(f,"WRITE_EVENTS\tversion=1\tdelta_sha=%s\tinput_sha=%s\toutput_sha=%s\toutput_bytes=%ld\tclaim=STATE_OBSERVATION_ONLY\tconfig_sha=%s\twatch_format=compact-v1\n",mac?"971f05fec53cd072ab37ff82091f8ed7b3fc02dcd1f2e7dd6890b54e6e033a87":"1da47860e59f52a4bbd2cc5ae076e57a4df7b6d55020b52149b40cab473b16ce",th,ih,(long)n,ch);
 long seq=1;fprintf(f,"FRAME\t1\t1\t%s\t41\n",th);
 int slots[8]={0,1,1,2,3,1,1,4};long cur[8]={0,22,38,41,41,22,38,41},out[8]={0,0,4,24,24,0,0,12};long vals[8][4]={{0,0},{0,0,18,22},{0,1,33,38},{0,2},{0,2},{1,2,18,22},{1,3,33,38},{1,12,1}};int ar[8]={2,4,2,2,3,5,2,1};
 for(int i=0;i<8;i++){fprintf(f,"WATCHC\t%ld\t%d\t1\t%ld\t0\t%ld\t0\t0",++seq,slots[i],cur[i],out[i]);for(int j=0;j<ar[slots[i]];j++)fprintf(f,"\t%ld",vals[i][j]);fputc('\n',f);}
 fprintf(f,"WATCHC\t%ld\t5\t1\t41\t0\t12\t0\t0\t12\t%d\t0\t0\t%d\n",++seq,mac?2:3,mac?0:1);
 if(!mac)fprintf(f,"WATCHC\t%ld\t10\t1\t41\t0\t0\t0\t0\t8192\t1536\t3072\t12288\t5368721536\t4096\t12\t128\n",++seq);
 fprintf(f,"WATCHC\t%ld\t6\t1\t41\t0\t%ld\t0\t0\t1\t12\n",++seq,H+(mode==1));fprintf(f,"FRAME\t%ld\t2\t%s\t12\n",++seq,a);for(int i=0;i<2;i++)fprintf(f,"WATCHC\t%ld\t7\t2\t%d\t0\t%ld\t0\t0\t12\n",++seq,i*12,H+i*12);
 if(!mac)fprintf(f,"WATCHC\t%ld\t11\t1\t41\t0\t1536\t0\t0\t8192\t1536\t3072\t5368721536\n",++seq);
 fprintf(f,"WATCHC\t%ld\t8\t1\t41\t0\t%ld\t0\t0\t%ld\n",++seq,P,L);fprintf(f,"FRAME\t%ld\t3\t%s\t%ld\n",++seq,b,L);for(int i=0;i<2;i++)fprintf(f,"WATCHC\t%ld\t7\t%d\t%ld\t0\t%ld\t0\t0\t12\n",++seq,mode==3?2:3,i*L,(mac?0:P)+i*L);
 fprintf(f,"WATCHC\t%ld\t9\t1\t41\t0\t%ld\t0\t0\t%ld\n",++seq,(mac?0:P)+L,L);fprintf(f,"COMPLETE\tevents=%ld\n",seq);if(fclose(f))die();
}
static void foreign_check(int mode,int rc,const char *label){foreign_fixture(mode);char *v[]={"sh",com,tool,"--","--profile",(char *)chosen,target,config,watch,image,0};np_result r={0};char why[512]={0};int tr=np_run(v,home,0,8,&r,why,sizeof why);int ok=!tr&&!r.residue&&r.rc==rc;if(!rc)ok=ok&&r.out&&strstr(r.out,"records=2\ttext_bytes=12")&&strstr(r.out,"text_lo=0\ttext_hi=0");else ok=ok&&!r.outn;checks++;bad+=!ok;printf("%s\t%s\n",ok?"PASS":"FAIL",label);if(!ok)fprintf(stderr,"tr%d rc%d %s %s\n",tr,r.rc,why,r.err?r.err:"");np_free(&r);}

int main(int argc,char **argv){if(argc==3&&!strcmp(argv[1],"--profile-checks"))chosen=argv[2];else if(argc!=1)die();if(!realpath(".",home))die();snprintf(dir,sizeof dir,"%s/out/arm-encoder-check-XXXXXX",home);if(!mkdtemp(dir))die();snprintf(com,sizeof com,"%s/unisacc.com",home);snprintf(tool,sizeof tool,"%s/tools/arm-encoder-record-origin.cx",home);snprintf(target,sizeof target,"%s/target",dir);snprintf(config,sizeof config,"%s/config",dir);snprintf(watch,sizeof watch,"%s/watch",dir);snprintf(image,sizeof image,"%s/image",dir);if(chosen){foreign_check(0,0,"independent ARM foreign format/transcript consistency, not sim");foreign_check(1,2,"foreign H mismatch");foreign_check(2,2,"foreign text section mismatch");foreign_check(3,2,"foreign crossed copy frame");if(!strcmp(chosen,"win/arm64-forward"))foreign_check(4,2,"forward import directory mismatch");printf("ARM_FOREIGN_CHECK\tprofile=%s\tchecks=%d\tfailed=%d\n",chosen,checks,bad);return bad?1:0;}check(0,0,"metadata-label-blank-zero-multiword-two-pass");const char *labels[]={"wrong-pass","duplicate-row","wrong-H","wrong-T","nonstatic","missing-OCUT-boundary","wrong-root-frame","missing-completion","changed-target-identity","lnum-must-not-reset"};for(int i=1;i<=10;i++)check(i,2,labels[i-1]);printf("ARM_ENCODER_RECORD_CHECK\tchecks=%d\tfailed=%d\tfixture=consistency-only\n",checks,bad);return bad?1:0;}
