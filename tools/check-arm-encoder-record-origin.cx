/* Independent hand-built consistency fixture, not sim. Metadata/label/blank gaps,
 * pass0 discarded output, pass1 zero byte row and 3-word row are all explicit. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sysx.process
static char home[4400],dir[4400],com[4400],tool[4400],target[4400],config[4400],watch[4400],image[4400];static int checks,bad;
static const char *source="@target lnx/arm64\nzero x\nlabel:\n\nmulti x\n";
static const char *profile="START\tpass,lnum\nOP.end\tpass,lnum,lstart,end\nREWIND\tpass,lnum\nREWIND.r362\tpass,lnum\nIMAGE.ready\tpass,endo,has_data\nLIB.imagebegin\tendo,target_os,lib_present\nEH.r814\ttext_blob,endo,host_dyn\nEI.pad\tendo\n";
static void die(void){fprintf(stderr,"arm encoder fixture IO\n");exit(2);}
static void put(unsigned char *p,int at,unsigned long long v,int n){for(int i=0;i<n;i++){p[at+i]=v&255;v>>=8;}}
static void fixture(int mode){if(strlen(source)!=41||cx_write(target,source,strlen(source))||cx_write(config,profile,strlen(profile)))die();unsigned char b[188]={0};memcpy(b,"\177ELF\2\1\1",7);put(b,16,2,2);put(b,18,183,2);put(b,20,1,4);put(b,24,4194304+176,8);put(b,32,64,8);put(b,52,64,2);put(b,54,56,2);put(b,56,2,2);put(b,64,1,4);put(b,68,5,4);put(b,80,4194304,8);put(b,96,188,8);put(b,104,188,8);put(b,120,1,4);put(b,124,6,4);put(b,128,188,8);if(cx_write(image,b,sizeof b))die();char th[65],ch[65],ih[65];cx_sha256_hex(source,strlen(source),th);cx_sha256_hex(profile,strlen(profile),ch);cx_sha256_hex(b,sizeof b,ih);FILE *f=fopen(watch,"wb");if(!f)die();fprintf(f,"WRITE_EVENTS\tversion=1\tdelta_sha=8d56c3089e1b46d459d35f577bc8bf2f683f30b198bf0305099f48dffe6e1e3d\tinput_sha=%s\toutput_sha=%s\toutput_bytes=188\tclaim=STATE_OBSERVATION_ONLY\tconfig_sha=%s\twatch_format=compact-v1\n",th,ih,ch);long seq=0;fprintf(f,"FRAME\t%ld\t1\t%s\t41\n",++seq,th);
 int slots[11]={0,1,1,2,3,1,1,4,5,6,7};long cur[11]={0,22,38,41,41,22,38,41,41,41,41};long out[11]={0,0,4,24,24,0,0,12,12,176,188};long a[11][4]={{0,0},{0,0,18,22},{0,1,33,38},{0,2},{0,2},{1,2,18,22},{1,3,33,38},{1,12,1},{12,1,0},{1,12,0},{12}};int arity[8]={2,4,2,2,3,3,3,1};
 if(mode==1)a[5][0]=0;if(mode==2)a[6][2]=18;if(mode==3)out[9]=175;if(mode==4)a[7][1]=13;if(mode==5)a[9][2]=1;if(mode==10)a[5][1]=0;
 for(int i=0;i<11;i++){if(mode==6&&i==4)continue;fprintf(f,"WATCHC\t%ld\t%d\t%ld\t%ld\t0\t%ld\t0\t0",++seq,slots[i],mode==7?2L:1L,cur[i],out[i]);for(int j=0;j<arity[slots[i]];j++)fprintf(f,"\t%ld",a[i][j]);fputc('\n',f);}
 if(mode!=8)fprintf(f,"COMPLETE\tevents=%ld\n",seq);if(fclose(f))die();if(mode==9&&cx_write(target,"changed\n",8))die();}
static void check(int mode,int expected,const char *label){fixture(mode);char *v[]={"sh",com,tool,"--",target,config,watch,image,0};np_result r={0};char why[512]={0};int tr=np_run(v,home,0,8,&r,why,sizeof why);int ok=!tr&&!r.residue&&r.rc==expected;if(!expected)ok=ok&&strstr(r.out,"RECORD\t0\ttarget_lo=18\ttarget_hi=25\ttext_lo=0\ttext_hi=0\tfile_lo=176\tfile_hi=176")&&strstr(r.out,"RECORD\t1\ttarget_lo=33\ttarget_hi=41\ttext_lo=0\ttext_hi=12\tfile_lo=176\tfile_hi=188");else ok=ok&&!r.outn;checks++;bad+=!ok;printf("%s\t%s\n",ok?"PASS":"FAIL",label);if(!ok)fprintf(stderr,"tr=%d rc=%d %s %s\n",tr,r.rc,why,r.err?r.err:"");np_free(&r);}
int main(void){if(!realpath(".",home))die();snprintf(dir,sizeof dir,"%s/out/arm-encoder-check-XXXXXX",home);if(!mkdtemp(dir))die();snprintf(com,sizeof com,"%s/unisacc.com",home);snprintf(tool,sizeof tool,"%s/tools/arm-encoder-record-origin.cx",home);snprintf(target,sizeof target,"%s/target",dir);snprintf(config,sizeof config,"%s/config",dir);snprintf(watch,sizeof watch,"%s/watch",dir);snprintf(image,sizeof image,"%s/image",dir);check(0,0,"metadata-label-blank-zero-multiword-two-pass");const char *labels[]={"wrong-pass","duplicate-row","wrong-H","wrong-T","nonstatic","missing-OCUT-boundary","wrong-root-frame","missing-completion","changed-target-identity","lnum-must-not-reset"};for(int i=1;i<=10;i++)check(i,2,labels[i-1]);printf("ARM_ENCODER_RECORD_CHECK\tchecks=%d\tfailed=%d\tfixture=consistency-only\n",checks,bad);return bad?1:0;}
