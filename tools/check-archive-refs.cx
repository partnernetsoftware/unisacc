/* check-archive-refs: every path in archive/ARCHIVE.tsv must be gone from the
 * live tree and must not be referenced by a live file.
 * Manifest: original repo-relative paths, '#' comments, directory records D,
 * and L<TAB>archive-target<TAB>live-entry<TAB>contract for an explicit live reference.
 * L verifies both regular files and the entry's literal reference to the target;
 * it does not exempt any ordinary archived-path disappearance/reference check.
 * A row fails when the path is still tracked at its old location (git ls-files)
 * or when git grep finds it in tools/ tests/ src/ cx/ prd.md AGENTS.md
 * agentwork/WORKFLOW.md agentwork/ agentwork/roles/. Only reads; the answer comes from git itself so the
 * tool cannot drift from the index.
 *   sh ./unisacc.com tools/check-archive-refs.cx
 */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use sys.time
#pragma unisa use sysx.poll
#pragma unisa use sys.posix
#pragma unisa use sys.env

/* an unlinked spool file the drained output of a bounded child goes to */
static int spool_open(void) {
    char t[4096];
    int fd;
    if (cx_fmt(t, sizeof t, "%s/r2b-XXXXXX", sy_tmpdir())) return -1;
    fd = mkstemp(t);
    if (fd >= 0) sy_unlink(t);
    return fd;
}

/* sy_spawn_pipe with a 50 s deadline: the child's stdout (and stderr when EFD is given) is drained here with sy_poll
   into spool files; past the deadline its process group is killed.  OFD/EFD come back as the spool files, rewound,
   and the child is NOT reaped: the caller's sy_wait_status(pid) still reports its real status (128+9 when killed). */
static int spawn_pipe_bounded(char **argv, const char *cwd, int flags, int *ofd, int *efd) {
    int po = -1, pe = -1, pid, fo, fe = -1, open_o = 1, open_e = efd ? 1 : 0, killed = 0;
    long deadline = sy_now_ms() + 50000;
    char chunk[16384];
    pid = sy_spawn_pipe(argv, cwd, flags, &po, efd ? &pe : 0);
    if (pid < 0) return pid;
    fo = spool_open();
    if (efd) fe = spool_open();
    if (fo < 0 || (efd && fe < 0)) { sy_killpg(pid, 9); sy_signal(pid, 9); sy_close(po); if (efd) sy_close(pe); return -EIO; }
    while (open_o || open_e) {
        sy_pollfd_t p[2];
        int n = 0, io = -1, ie = -1, r;
        long left = deadline - sy_now_ms(), g;
        if (left <= 0) {
            if (killed) break;
            sy_killpg(pid, 9); sy_signal(pid, 9); killed = 1; deadline = sy_now_ms() + 2000;
            continue;
        }
        if (open_o) { io = n; p[n].fd = po; p[n].events = SY_POLLIN; p[n].revents = 0; n++; }
        if (open_e) { ie = n; p[n].fd = pe; p[n].events = SY_POLLIN; p[n].revents = 0; n++; }
        r = sy_poll(p, n, left > 200 ? 200 : left);
        if (r < 0) break;
        if (io >= 0 && p[io].revents) {
            g = sy_read(po, chunk, sizeof chunk);
            if (g > 0) { if (sy_write_all(fo, chunk, g)) break; } else open_o = 0;
        }
        if (ie >= 0 && p[ie].revents) {
            g = sy_read(pe, chunk, sizeof chunk);
            if (g > 0) { if (sy_write_all(fe, chunk, g)) break; } else open_e = 0;
        }
    }
    if (open_o || open_e) { sy_killpg(pid, 9); sy_signal(pid, 9); }
    sy_close(po);
    if (efd) sy_close(pe);
    sy_lseek(fo, 0, 0);
    *ofd = fo;
    if (efd) { sy_lseek(fe, 0, 0); *efd = fe; }
    return pid;
}

#define CAP (1L << 16)
static char out[CAP];
static int failed, rows, live_rows;

/* A match at C is the archived home when the text just before it is
   "archive/<one-level-dir>/" and that directory exists in the tree. The
   manifest records original paths only, so the target cannot be compared
   line by line; "the reference points at something inside archive/" is the
   rule, and it covers every archive directory without naming them. */
static int archived_at(long c) {
    long d1, d0, k;
    char dir[512];
    sy_stat_t st;
    if (c < 1 || out[c - 1] != '/') return 0;      /* no "dir/" right before the path */
    d1 = c - 1;                                     /* the slash after the one-level directory */
    d0 = d1;
    while (d0 > 0 && out[d0 - 1] != '/') d0--;
    if (d0 == d1 || d1 - d0 > 500) return 0;        /* empty or oversize directory name */
    if (d0 < 8 || memcmp(out + d0 - 8, "archive/", 8)) return 0;
    for (k = 0; k < d1 - d0; k++) dir[k] = out[d0 + k];
    dir[d1 - d0] = 0;
    { char full[520]; if (cx_fmt(full, sizeof full, "archive/%s", dir)) return 0;
      return sy_stat(full, &st) == 0 && st.kind == 'd'; }
}
static int git(char **av) {
    char *argv[12]; int i = 0, ofd, efd, pid, ex = 0, code = 0, sig = 0; long n = 0, r; char junk[4096];
    argv[i++] = "git";
    for (int k = 0; av[k] && i < 11; k++) argv[i++] = av[k];
    argv[i] = 0;
    pid = spawn_pipe_bounded(argv, 0, SY_SPAWN_STDERR_SPLIT, &ofd, &efd);
    if (pid < 0) return -1;
    while (n < CAP - 1 && (r = sy_read(ofd, out + n, CAP - 1 - n)) > 0) n += r;
    out[n] = 0;
    while (sy_read(ofd, junk, sizeof junk) > 0) {}
    while (sy_read(efd, junk, sizeof junk) > 0) {}
    sy_close(ofd); sy_close(efd);
    if (sy_wait_status(pid, 0, &ex, &code, &sig) != pid || !ex) return -1;
    return code;
}

static int relative_path(const char *p) {
    long i = 0, begin = 0;
    if (!p[0] || p[0] == '/') return 0;
    while (p[i]) {
        unsigned c = (unsigned char)p[i];
        if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
              (c >= '0' && c <= '9') || c == '/' || c == '.' || c == '-' || c == '_')) return 0;
        if (c == '/') {
            if (i == begin || (i - begin == 1 && p[begin] == '.') ||
                (i - begin == 2 && p[begin] == '.' && p[begin + 1] == '.')) return 0;
            begin = i + 1;
        }
        i++;
    }
    return i != begin && !(i - begin == 1 && p[begin] == '.') &&
           !(i - begin == 2 && p[begin] == '.' && p[begin + 1] == '.');
}
static int live_reference(const char *m, long at, long end) {
    char target[512], entry[512], contract[128];
    char *fields[3] = {target, entry, contract};
    long caps[3] = {sizeof target, sizeof entry, sizeof contract}, pos = at + 2;
    sy_stat_t st;
    for (int f = 0; f < 3; f++) {
        long first = pos, n;
        while (pos < end && m[pos] != '\t') pos++;
        n = pos - first;
        if (!n || n >= caps[f] || (f < 2 && pos == end) || (f == 2 && pos != end)) {
            printf("FAIL\tarchive-refs.live-record-malformed\n"); return 1;
        }
        if (tx_copy(fields[f], caps[f], m + first, n)) {
            printf("FAIL\tarchive-refs.live-record-malformed\n"); return 1;
        }
        pos++;
    }
    live_rows++;
    if (!relative_path(target) || !relative_path(entry) ||
        !tx_prefix(target, tx_len(target, 512), "archive/", 8) ||
        tx_prefix(entry, tx_len(entry, 512), "archive/", 8)) {
        printf("FAIL\tarchive-refs.live-record-path\t%s\t%s\n", target, entry); return 1;
    }
    if (sy_stat(target, &st) != 0 || st.kind != 'f' || sy_stat(entry, &st) != 0 || st.kind != 'f') {
        printf("FAIL\tarchive-refs.live-record-file\t%s\t%s\n", target, entry); return 1;
    }
    long n = 0, length = tx_len(target, 512), i;
    char *body = cx_read(entry, &n); int found = 0;
    if (body) for (i = 0; i + length <= n; i++) if (!memcmp(body + i, target, (size_t)length)) { found = 1; break; }
    free(body);
    if (!found) { printf("FAIL\tarchive-refs.live-record-no-entry-reference\t%s\t%s\n", target, entry); return 1; }
    printf("LIVE_REFERENCE\t%s\t%s\t%s\n", target, entry, contract);
    return 0;
}

int main(void) {
    long mn = 0;
    char *m = cx_read("archive/ARCHIVE.tsv", &mn);
    if (!m) { printf("FAIL\tarchive-refs.manifest-missing\nARCHIVE_REFS\tfailed=1\n"); return 1; }
    long at = 0;
    while (at < mn) {
        long e = at; while (e < mn && m[e] != '\n') e++;
        /* 'D<TAB>path...' rows are directory-level records: recorded, not re-grepped */
        if (e - at > 2 && m[at] == 'L' && m[at + 1] == '\t') {
            failed += live_reference(m, at, e);
        } else if (e > at && m[at] != '#' && !(e - at > 2 && m[at] == 'D' && m[at + 1] == '\t')) {
            char p[512]; long pl = e - at < 511 ? e - at : 511, i;
            for (i = 0; i < pl; i++) p[i] = m[at + i];
            p[pl] = 0;
            rows++;
            char *a1b[4]; a1b[0] = "ls-files"; a1b[1] = "--"; a1b[2] = p; a1b[3] = 0;
            git(a1b);
            int still = out[0] != 0;
            /* -n: every matching line, so an archive/<path> mention (the new home) is told apart from
               a live reference, and every file is judged, not only the first git lists. */
            /* ujs/ is the paper-B lane's own tree (AGENTS.md lane ownership); its notes are not live unisacc files */
            char *a2[12]; a2[0] = "grep"; a2[1] = "-n"; a2[2] = "-F"; a2[3] = p;
            a2[4] = "--"; a2[5] = "."; a2[6] = ":!archive"; a2[7] = ":!out"; a2[8] = ":!work"; a2[9] = ":!ujs"; a2[10] = 0;
            git(a2);
            char who[512]; who[0] = 0;
            int refd = 0; long q = 0, pn = tx_len(p, 512);
            while (out[q] && !refd) {
                long ls = q, le = q; while (out[le] && out[le] != '\n') le++;
                long fe = ls; while (fe < le && out[fe] != ':') fe++;
                long fl = fe - ls < 511 ? fe - ls : 511, k;
                char f[512]; for (k = 0; k < fl; k++) f[k] = out[ls + k]; f[fl] = 0;
                /* ignore audit artifacts and dated notes that name every path by design */
                int exempt = tx_prefix(f, fl, "agentwork/", 10) || tx_prefix(f, fl, "archive/", 8) || tx_prefix(f, fl, "out/", 4) ||
                             tx_prefix(f, fl, "plans/tools-inventory-", 22) || tx_prefix(f, fl, "ujs/archive/", 12) ||
                             tx_eqz(f, "plans/lab-loader-archive-2026-11-05.md") ||
                             tx_eqz(f, "plans/materials-rebuild-2026-11-02.md") ||
                             tx_eqz(f, "plans/release-0.0.43.md") ||
                             tx_eqz(f, "tests/waivers-0.0.43.tsv") ||   /* 0.0.43 已发布版的豁免记录 */
                             tx_eqz(f, "plans/defects-c43.md") || tx_eqz(f, "plans/identity-inventory-2026-11-02.md") ||
                             tx_eqz(f, "plans/materials-inventory-2026-11-02.md") || tx_eqz(f, "plans/product-identity-2026-11-02.md") ||
                             tx_eqz(f, "plans/tools-pins-audit-2026-11-02.md") ||
                             /* release plans and dated notes that predate an archive move keep the path as history */
                             tx_eqz(f, "plans/v0.0.44.md") || tx_eqz(f, "plans/cxlibc-2026-10-30.md") ||
                             tx_eqz(f, "plans/layout-assumptions-2026-11-02.md") || tx_prefix(f, fl, "plans/w5-patches/", 17) ||
                             tx_eqz(f, "plans/kernel-context-narrow-2026-11-02.md") || tx_eqz(f, "plans/p4-frow-arity-2026-11-02.md");
                if (!exempt) {   /* a live hit unless every occurrence on the line is the archive/<dir>/ form */
                    long c;
                    for (c = fe; c + pn <= le; c++) {
                        if (memcmp(out + c, p, (size_t)pn)) continue;
                        if (archived_at(c)) continue;
                        refd = 1; break;
                    }
                    if (refd) { for (k = 0; k < fl; k++) who[k] = f[k]; who[fl] = 0; }
                }
                q = out[le] ? le + 1 : le;
            }
            if (still || refd) {
                failed++;
                printf("FAIL\tarchive-refs.%s\t%s%s%s\n", p, still ? "still-tracked " : "", refd ? "referenced-by:" : "", who);
            }
        }
        at = e + 1;
    }
    free(m);
    printf("ARCHIVE_REFS\trows=%d\tlive_references=%d\tfailed=%d\n", rows, live_rows, failed);
    return failed ? 1 : 0;
}
