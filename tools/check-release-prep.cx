/* Tool self-check for tools/release-prep.cx (release-run --prepare, B4 drafts).
 * Upstream inputs are the real committed v0.0.74 products: release/evidence/v0.0.74-strict-2026-11-18.tsv
 * (devsvc qualify format with RAW BATCH_RUN lines and SUMMARY), release/evidence/0.0.73/expected-fail.tsv,
 * release/evidence/0.0.74/{expected-fail.tsv,ratchets.txt,chain-promote.txt,pack-run.out},
 * release/notes-0.0.74.md, release/notes-0.0.73.md and the frozen commit 0dae4d3024 itself; the committed
 * v0.0.74 rollback (Y2 642c44488a) is kept as tests/release-prep/rollback-0.0.74.txt because
 * release/rollback.txt moves on every release. Only the layout (SHA256SUMS + build.json naming the real
 * candidate sha and commit) is synthesized, since the published assets are not in the repository.
 * Positive: replaying 0.0.74 gives drafts structurally equal to the committed ones (columns, required
 * fields, version substitution, NOT_QUALIFIED fixed wording, ratchets from the frozen commit).
 * Negative: an UNKNOWN batch is never counted PASS and is listed uncovered; a ratchets file whose source is
 * not the frozen commit is refused; a new FAIL (or a changed fail count) is never auto-admitted to
 * expected-fail.tsv; a layout sha that differs from the strict SUMMARY is refused.
 * Optional first argument selects a prebuilt release-prep binary for red/green comparison.
 * Check: CHECK_RELEASE_PREP. */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.toolprep
#pragma unisa use mem.bytes

#define T_COMMIT "0dae4d30246052a436e7c0c6a9cee94a12ca31bd"
#define T_APE "63334e185bb906d5352ff9f8b2c5dfa2c26b8fef1a35f965994ba8c7907cca39"
#define T_STRICT "release/evidence/v0.0.74-strict-2026-11-18.tsv"
static char tmp[4096], bin[4200], root[4096], lay[4300], badlay[4300], tmpenv[4200];
static char out[65536];
/* The frozen commit the replay names: T_COMMIT when this checkout holds its history; otherwise (the
 * devsvc qualify layout is a git archive plus one private commit) the layout's own HEAD stands in as the
 * frozen commit, since release-prep must run tools/ratchets.cx on a git archive of a real commit.
 * Every other replayed input is a committed static evidence file, not a history object. */
static char fc[48], bjson[160], bjbad[120], ratfc[200], rathead[160], fft[60];
static int passed, failed, part;
static char archive_path[4400];
static void check(const char *label, int yes) { if (yes) passed++; else failed++; printf("%s\t%s\trelease-prep\n", yes ? "PASS" : "FAIL", label); }
static int has(const char *hay, const char *s) {
    if (!hay || !s) return 0;
    size_t hn = strlen(hay), sn = strlen(s);
    if (sn == 0) return 1;
    if (sn > hn) return 0;
    for (size_t i = 0; i + sn <= hn; i++) {
        if (hay[i] == s[0] && mm_same(hay + i, s, sn)) return 1;
    }
    return 0;
}
static int runv(char **v, int secs, int *rc) {
    np_result r = {0}; char why[300]; char *env[] = {tmpenv, 0};
    *rc = -1; out[0] = 0;
    if (np_run(v, root, env, secs, &r, why, sizeof why)) { fprintf(stderr, "exec %s: %s\n", v[0], why); return 0; }
    *rc = r.rc; long k = (long)r.outn < (long)sizeof out - 1 ? (long)r.outn : (long)sizeof out - 1;
    if (k > 0) mm_copy(out, sizeof out, r.out, k); out[k > 0 ? k : 0] = 0;
    if (r.errn) { long e = (long)r.errn < (long)sizeof out - 1 - k ? (long)r.errn : (long)sizeof out - 1 - k; if (e > 0) { mm_copy(out + k, sizeof out - k, r.err, e); out[k + e] = 0; } }
    np_free(&r); return 1;
}
static int frozen_pick(void) {
    np_result r = {0}; char why[300]; char *v1[] = {"git", "cat-file", "-e", T_COMMIT "^{commit}", 0}; char *v2[] = {"git", "rev-parse", "HEAD", 0}; long k;
    if (!np_run(v1, root, 0, 20, &r, why, sizeof why) && r.rc == 0) {
        np_free(&r);
        /* 0.0.86+ Root (D2 implicit-function refusal) rejects historical 0.0.74 tests/cxraw.cx; probe compatibility before picking T_COMMIT. */
        char probe[512];
        if (!cx_fmt(probe, sizeof probe, "git show " T_COMMIT ":tests/cxraw.cx > %s/probe-cxraw.cx && sh ./unisacc.com -c %s/probe-cxraw.cx -o %s/probe-cxraw.o >/dev/null 2>&1", tmp, tmp, tmp)) {
            char *vp[] = {"sh", "-c", probe, 0};
            if (!np_run(vp, root, 0, 20, &r, why, sizeof why) && r.rc == 0) { np_free(&r); return cx_fmt(fc, sizeof fc, "%s", T_COMMIT); }
            np_free(&r);
        }
    } else np_free(&r);
    if (np_run(v2, root, 0, 20, &r, why, sizeof why) || r.rc || r.outn < 40) { np_free(&r); return 1; }
    for (k = 0; k < 40; k++) fc[k] = r.out[k];
    fc[40] = 0; np_free(&r);
    printf("NOTE\tfrozen-commit\t%s\t%s unavailable or incompatible with current Root: layout HEAD stands in\n", fc, T_COMMIT);
    return 0;
}
static char *rd(const char *dir, const char *rel) { char p[4500]; size_t n; if (cx_fmt(p, sizeof p, "%s/%s", dir, rel)) return 0; return cx_read(p, &n); }
static int wr(const char *dir, const char *rel, const char *text) { char p[4500]; if (cx_fmt(p, sizeof p, "%s/%s", dir, rel)) return 1; return sy_write_file(p, text, strlen(text), 0644); }
/* drafts of one run in DIR; argv tail after VERSION */
static int prep(const char *dir, const char *strict, const char *ratin, const char *layout, int *rc) {
    char *v[16]; int k = 0; v[k++] = bin; v[k++] = "0.0.74"; v[k++] = "--layout"; v[k++] = (char *)layout; v[k++] = "--out"; v[k++] = (char *)dir; /* lint:allow R1-version replay of the committed v0.0.74 evidence */
    if (strict) { v[k++] = "--strict"; v[k++] = (char *)strict; }
    if (ratin) { v[k++] = "--ratchets"; v[k++] = (char *)ratin; }
    if (part == 4 && archive_path[0]) { v[k++] = "--ratchets-in"; v[k++] = archive_path; }
    v[k] = 0; return runv(v, 58, rc);
}
/* lines of TEXT not starting with '#', joined */
static void nocomment(const char *t, char *o, long cap) {
    long k = 0; const char *p = t;
    while (p && *p) { const char *e = strchr(p, '\n'); long n = e ? e - p + 1 : (long)strlen(p);
        if (*p != '#' && k + n < cap) { mm_copy(o + k, cap - k, p, n); k += n; } p += n; }
    o[k] = 0;
}
static int count_lines(const char *t, const char *prefix) { int n = 0; long pl = (long)strlen(prefix); const char *p = t;
    while (p && *p) { if (!strncmp(p, prefix, (size_t)pl)) n++; p = strchr(p, '\n'); if (p) p++; } return n; }
static int tabs_on_line(const char *t, const char *prefix) { const char *p = t; long pl = (long)strlen(prefix);
    while (p && *p) { if (!strncmp(p, prefix, (size_t)pl)) { int n = 0; for (; *p && *p != '\n'; p++) if (*p == '\t') n++; return n; } p = strchr(p, '\n'); if (p) p++; } return -1; }
/* every QUALIFIED is the tail of NOT_QUALIFIED or UNQUALIFIED (e.g. build/pkg-gaps.tsv UNQUALIFIED gap ids) */
static int only_not_qualified(const char *t) {
    const char *p = t;
    while ((p = strstr(p, "QUALIFIED"))) {
        int is_not = (p - t >= 4 && !strncmp(p - 4, "NOT_", 4));
        int is_un = (p - t >= 2 && !strncmp(p - 2, "UN", 2));
        if (!is_not && !is_un) return 0;
        p++;
    }
    return 1;
}
/* copy of the real strict evidence with one replacement */
static int variant(const char *name, const char *from, const char *to, char *path, long cap) {
    char *s = rd(root, T_STRICT), *at; np_buf b = {0}; int bad;
    if (!s || !(at = strstr(s, from))) { free(s); return 1; }
    np_put(&b, s, (size_t)(at - s)); np_puts(&b, to); np_puts(&b, at + strlen(from));
    bad = cx_fmt(path, cap, "%s/%s", tmp, name) || sy_write_file(path, b.p, b.n, 0644);
    free(s); free(b.p); return bad;
}

static int rb_audit(const char *ver, const char *prev, const char *candp, const char *rbp, const char *decp, const char *notesp, int allow_pass, int emit) {
    char *cand = 0, *rb = 0, *dc = 0, *nt = 0;
    size_t cn = 0, rn = 0, dn = 0, nn = 0;
    int loc_fail = 0;
    char vbuf[64], pbuf[64], nbuf[320];
    cand = cx_read(candp, &cn); rb = cx_read(rbp, &rn); dc = cx_read(decp, &dn);
    if (!ver || !*ver) {
        if (rb && rn > 4 && rb[0] == '#' && rb[1] == ' ') {
            size_t k = 2, j = 0;
            while (k < rn && rb[k] != ' ' && rb[k] != '\t' && rb[k] != '\n' && j + 1 < sizeof vbuf) vbuf[j++] = rb[k++];
            vbuf[j] = 0; ver = vbuf;
        }
    }
    if (!prev || !*prev) {
        if (cand && cn > 0) {
            const char *nl = strchr(cand, '\n');
            if (nl && nl[1]) {
                const char *p = nl + 1; int col = 0;
                while (*p && *p != '\n') {
                    const char *s = p; while (*p && *p != '\t' && *p != '\n') p++;
                    if (col == 3 && (size_t)(p - s) < sizeof pbuf) { mm_copy(pbuf, sizeof pbuf, s, (size_t)(p - s)); pbuf[p - s] = 0; prev = pbuf; break; }
                    if (*p == '\t') p++; col++;
                }
            }
        }
    }
    if (!notesp || !*notesp) {
        if (ver && *ver && !cx_fmt(nbuf, sizeof nbuf, "release/notes-%s.md", ver)) notesp = nbuf;
    }
    if (notesp && *notesp) nt = cx_read(notesp, &nn);
    if (emit) check("rb-files-readable", cand && rb && dc && nt && ver && *ver && prev && *prev);
    if (!cand || !rb || !dc || !nt || !ver || !*ver || !prev || !*prev) { loc_fail++; goto out; }
    {
        char tagtok[96]; const char *row = 0;
        if (!cx_fmt(tagtok, sizeof tagtok, "\tv%s\t", prev)) {
            const char *p = strchr(cand, '\n');
            while (p && p[1]) {
                p++;
                const char *e = strchr(p, '\n'); size_t rl = e ? (size_t)(e - p) : strlen(p);
                if (rl < 4096) {
                    char line[4096]; mm_copy(line, sizeof line, p, rl); line[rl] = 0;
                    if (strstr(line, tagtok)) { row = p; break; }
                }
                p = e;
            }
        }
        int row_ok = (row != 0);
        if (emit) check("rb-cand-prev-row", row_ok);
        if (!row_ok) loc_fail++;
        if (row) {
            const char *fp[24]; size_t fl[24]; int nf = 0; const char *q = row;
            while (*q && *q != '\n' && nf < 24) {
                const char *s = q; while (*q && *q != '\t' && *q != '\n') q++;
                fp[nf] = s; fl[nf] = (size_t)(q - s); nf++;
                if (*q == '\t') q++;
            }
            if (emit) check("rb-cand-cols-21", nf == 21);
            if (nf != 21) loc_fail++;
            else {
                static const int idx[8] = {2, 6, 8, 10, 12, 14, 16, 20};
                static const char *nm[8] = {"rb-prev-commit", "rb-prev-ci-run", "rb-prev-ape", "rb-prev-pkg", "rb-prev-win-arm64", "rb-prev-record", "rb-prev-build-alias", "rb-prev-checksums"};
                for (int i = 0; i < 8; i++) {
                    char tok[128]; size_t l = fl[idx[i]] < 127 ? fl[idx[i]] : 127;
                    mm_copy(tok, sizeof tok, fp[idx[i]], l); tok[l] = 0;
                    int ok = has(rb, tok);
                    if (emit) check(nm[i], ok);
                    if (!ok) loc_fail++;
                }
            }
        }
    }
    {
        char a[160], b[160], c[160], d[160], e[160], f[160], g[160];
        int ok1 = !cx_fmt(a, sizeof a, "# %s ", ver) && has(rb, a);
        int ok2 = !cx_fmt(b, sizeof b, "release edit v%s --draft=true", ver) && has(rb, b);
        int ok3 = !cx_fmt(c, sizeof c, "release edit v%s --latest", prev) && has(rb, c);
        int ok4 = !cx_fmt(d, sizeof d, "--version=unisacc %s", prev) && has(rb, d);
        int ok5 = !cx_fmt(e, sizeof e, "release/evidence/%s/", ver) && has(dc, e);
        int ok6 = !cx_fmt(f, sizeof f, "release/evidence/%s/", prev) && !has(dc, f);
        int ok7 = has(dc, "QUALIFIED\tNOT_QUALIFIED\t");
        int ok8 = allow_pass || (!has(dc, "\tPASS\t") && !has(dc, "| PASS |"));
        int ok9 = !cx_fmt(g, sizeof g, "# unisacc %s ", ver) && has(nt, g);
        int ok10 = only_not_qualified(nt);
        int ok11 = has(nt, "## \xe5\xb7\xb2\xe7\x9f\xa5\xe7\xbc\xba\xe5\x8f\xa3");
        int ok12 = has(nt, "release/rollback.txt");
        if (emit) {
            check("rb-header-ver", ok1); check("rb-draft-ver", ok2); check("rb-latest-prev", ok3); check("rb-install-prev", ok4);
            check("dec-ver-paths", ok5); check("dec-no-prev-path", ok6); check("dec-not-qualified", ok7); check("dec-no-pass", ok8);
            check("notes-title-ver", ok9); check("notes-only-not-qualified", ok10); check("notes-has-gaps-section", ok11); check("notes-has-rollback-ref", ok12);
        }
        if (!(ok1 && ok2 && ok3 && ok4 && ok5 && ok6 && ok7 && ok8 && ok9 && ok10 && ok11 && ok12)) loc_fail++;
    }
out:
    free(cand); free(rb); free(dc); free(nt);
    return loc_fail;
}

static const char *find_sub(const char *hay, size_t hn, const char *s) {
    if (!hay || !s) return 0;
    size_t sn = strlen(s);
    if (sn == 0) return hay;
    if (sn > hn) return 0;
    for (size_t i = 0; i + sn <= hn; i++) {
        if (hay[i] == s[0] && mm_same(hay + i, s, sn)) return hay + i;
    }
    return 0;
}

static int claim_is_negated(const char *line, size_t len, size_t pos, size_t clen) {
    static const char *neg_pre[] = {
        "\xe6\x9c\xaa",                 /* wei (not yet) */
        "\xe4\xb8\x8d\xe5\xbe\x97",     /* bu-de (must not) */
        "\xe4\xb8\x8d\xe5\x8f\xaf",     /* bu-ke (cannot) */
        "\xe4\xb8\x8d\xe5\xa3\xb0\xe7\xa7\xb0", /* bu-sheng-cheng (do not claim) */
        "\xe4\xb8\x8d\xe8\x83\xbd",     /* bu-neng (cannot) */
        "\xe5\xb0\x9a\xe6\x9c\xaa",     /* shang-wei (not yet) */
        "\xe9\x9d\x9e",                 /* fei (non-) */
        0
    };
    size_t win_start = pos > 24 ? pos - 24 : 0;
    size_t win_len = pos - win_start;
    for (int i = 0; neg_pre[i]; i++) {
        if (find_sub(line + win_start, win_len, neg_pre[i])) return 1;
    }
    if (pos + clen + 3 <= len) {
        if (mm_same(line + pos + clen, "\xe5\x89\x8d", 3) || /* qian (before) */
            mm_same(line + pos + clen, "\xe5\x90\x8e", 3))   /* hou (after) */
            return 1;
    }
    return 0;
}

static int line_has_evidence(const char *line, size_t len) {
    static const char *ev[] = {
        "release/evidence/", "~/.cache/", "build/", "tools/", "tests/", "plans/",
        "run_id=", "sha256=", "PRERUN_MERGE", "SUMMARY", "RATCHETS",
        "DERIVE_SUMMARY", "READY ", "rc=0", "git rev-parse", "sh ./unisacc.com",
        "PASS",
        0
    };
    if (find_sub(line, len, "TBD") || find_sub(line, len, "<CI_RUN_ID>")) return 0;
    for (int i = 0; ev[i]; i++) {
        if (find_sub(line, len, ev[i])) return 1;
    }
    return 0;
}

static int notes_audit(const char *notesp, int emit) {
    char *nt = 0, *rb = 0;
    size_t nn = 0, rn = 0;
    char vbuf[64], nbuf[320];
    int loc_fail = 0, bad_claims = 0;
    if (!notesp || !*notesp) {
        rb = cx_read("release/rollback.txt", &rn);
        if (rb && rn > 4 && rb[0] == '#' && rb[1] == ' ') {
            size_t k = 2, j = 0;
            while (k < rn && rb[k] != ' ' && rb[k] != '\t' && rb[k] != '\n' && j + 1 < sizeof vbuf) vbuf[j++] = rb[k++];
            vbuf[j] = 0;
            if (vbuf[0] && !cx_fmt(nbuf, sizeof nbuf, "release/notes-%s.md", vbuf)) notesp = nbuf;
        }
        free(rb);
    }
    if (notesp && *notesp) nt = cx_read(notesp, &nn);
    if (emit) check("notes-readable", nt && nn > 0);
    if (!nt || nn == 0) { loc_fail++; goto out; }
    {
        int ok1 = only_not_qualified(nt);
        int ok2 = has(nt, "## \xe5\xb7\xb2\xe7\x9f\xa5\xe7\xbc\xba\xe5\x8f\xa3");
        int ok3 = has(nt, "release/rollback.txt");
        if (emit) {
            check("notes-only-not-qualified", ok1);
            check("notes-has-gaps-section", ok2);
            check("notes-has-rollback-ref", ok3);
        }
        if (!(ok1 && ok2 && ok3)) loc_fail++;
    }
    {
        static const char *claims[] = {
            "\xe5\xb7\xb2\xe9\xaa\x8c\xe8\xaf\x81",                         /* yi-yan-zheng */
            "\xe5\xae\x9e\xe6\xb5\x8b\xe9\x80\x9a\xe8\xbf\x87",             /* shi-ce-tong-guo */
            "\xe7\xbb\x8f\xe5\xae\x9e\xe6\x9c\xba\xe8\xbf\x90\xe8\xa1\x8c\xe9\xaa\x8c\xe8\xaf\x81", /* jing-shi-ji-yun-xing-yan-zheng */
            "\xe7\xbb\x8f\xe5\xae\x9e\xe6\x9c\xba\xe9\xaa\x8c\xe8\xaf\x81", /* jing-shi-ji-yan-zheng */
            "\xe5\xb7\xb2\xe5\xae\x9e\xe8\xb7\x91",                         /* yi-shi-pao */
            "\xe5\xb7\xb2\xe9\x80\x9a\xe8\xbf\x87",                         /* yi-tong-guo */
            0
        };
        static const char *tags[] = {
            "verified", "tested-pass", "host-run-verified", "host-verified", "ran", "passed"
        };
        const char *p = nt;
        int lineno = 1;
        while (*p) {
            const char *e = strchr(p, '\n');
            size_t ll = e ? (size_t)(e - p) : strlen(p);
            int line_bad = 0;
            const char *bad_tag = 0;
            for (int c = 0; claims[c] && !line_bad; c++) {
                size_t clen = strlen(claims[c]);
                size_t off = 0;
                while (off + clen <= ll) {
                    const char *m = find_sub(p + off, ll - off, claims[c]);
                    if (!m) break;
                    size_t pos = (size_t)(m - p);
                    if (!claim_is_negated(p, ll, pos, clen)) {
                        if (!line_has_evidence(p, ll)) {
                            line_bad = 1;
                            bad_tag = tags[c];
                            break;
                        }
                    }
                    off = pos + clen;
                }
            }
            if (line_bad) {
                bad_claims++;
                if (emit) printf("NOTES_UNVERIFIED_CLAIM\tline=%d\tclaim=%s\n", lineno, bad_tag);
            }
            if (!e) break;
            p = e + 1;
            lineno++;
        }
        if (emit) check("notes-claims-evidenced", bad_claims == 0);
        if (bad_claims > 0) loc_fail++;
    }
out:
    free(nt);
    return loc_fail;
}

int main(int argc, char **argv) {
    char why[512], d1[4400], d2[4400], d3[4400], d4[4400], d5[4400], d6[4400], rat1[4500], s_unk[4400], s_new[4400], s_cnt[4400]; int rc = -1;
    if (sy_cwd(root, sizeof root) < 0 || sy_mkdtemp("/tmp", "release-prep-check", tmp, sizeof tmp)) return 2;
    /* --part pos|neg|structure|ratchets|rollback|notes splits into separate checks */
    if (argc >= 3 && !strcmp(argv[1], "--part")) {
        const char *name = argv[2];
        if (!strcmp(name, "pos")) part = 1;
        else if (!strcmp(name, "neg")) part = 2;
        else if (!strcmp(name, "structure")) part = 3;
        else if (!strcmp(name, "ratchets")) part = 4;
        else if (!strcmp(name, "rollback")) {
            const char *ver = 0, *prev = 0, *candp = "release/candidate.tsv", *rbp = "release/rollback.txt", *decp = "release/decision.txt", *notesp = 0;
            int allow_pass = 0;
            for (int a = 3; a < argc; a++) {
                if (!strcmp(argv[a], "--ver") && a + 1 < argc) ver = argv[++a];
                else if (!strcmp(argv[a], "--prev") && a + 1 < argc) prev = argv[++a];
                else if (!strcmp(argv[a], "--cand") && a + 1 < argc) candp = argv[++a];
                else if (!strcmp(argv[a], "--rollback") && a + 1 < argc) rbp = argv[++a];
                else if (!strcmp(argv[a], "--decision") && a + 1 < argc) decp = argv[++a];
                else if (!strcmp(argv[a], "--notes") && a + 1 < argc) notesp = argv[++a];
                else if (!strcmp(argv[a], "--allow-pass")) allow_pass = 1;
                else { fprintf(stderr, "check-release-prep: unknown rollback arg %s\n", argv[a]); return 2; }
            }
            rb_audit(ver, prev, candp, rbp, decp, notesp, allow_pass, 1);
            goto done;
        }
        else if (!strcmp(name, "notes")) {
            const char *notesp = 0;
            for (int a = 3; a < argc; a++) {
                if (!strcmp(argv[a], "--notes") && a + 1 < argc) notesp = argv[++a];
                else { fprintf(stderr, "check-release-prep: unknown notes arg %s\n", argv[a]); return 2; }
            }
            notes_audit(notesp, 1);
            goto done;
        }
        else return 2;
        argv += 2; argc -= 2;
    }
    if (argc == 2) { if (sy_realpath(argv[1], bin, sizeof bin) < 0) return 2; }
    else { char s[4200]; if (argc != 1 || cx_fmt(bin, sizeof bin, "%s/release-prep", tmp) || cx_fmt(s, sizeof s, "%s/tools/release-prep.cx", root) || tq_native(root, s, bin, why, sizeof why)) { fprintf(stderr, "build release-prep: %s\n", why); return 2; } }
    if (frozen_pick() || cx_fmt(fft, sizeof fft, "F=T=%s", fc) || cx_fmt(bjson, sizeof bjson, "{\"commit\":\"%s\",\"version\":\"0.0.74\"}\n", fc) || cx_fmt(bjbad, sizeof bjbad, "{\"commit\":\"%s\"}\n", fc) || /* lint:allow R1-version replay of the committed v0.0.74 evidence */
        cx_fmt(ratfc, sizeof ratfc, "SOURCE\tfrozen-commit\tcommit=%s\ttree=git-archive\n", fc) || cx_fmt(rathead, sizeof rathead, "SOURCE\tshared-head\tcommit=%s\nRATCHETS\tok=15\tfail=0\n", fc)) return 2;
    if (cx_fmt(tmpenv, sizeof tmpenv, "TMPDIR=%s", tmp) || cx_fmt(lay, sizeof lay, "%s/layout", tmp) || cx_fmt(badlay, sizeof badlay, "%s/badlayout", tmp) ||
        sy_mkdir(lay, 0700) || sy_mkdir(badlay, 0700) ||
        wr(lay, "SHA256SUMS", T_APE "  unisacc.com\n") || wr(lay, "build.json", bjson) ||
        wr(badlay, "SHA256SUMS", "1111111111111111111111111111111111111111111111111111111111111111  unisacc.com\n") || wr(badlay, "build.json", bjbad)) return 2;
    cx_fmt(d1, sizeof d1, "%s/p1", tmp); cx_fmt(d2, sizeof d2, "%s/n-unknown", tmp); cx_fmt(d3, sizeof d3, "%s/n-ratsrc", tmp);
    cx_fmt(d4, sizeof d4, "%s/n-newfail", tmp); cx_fmt(d5, sizeof d5, "%s/n-count", tmp); cx_fmt(d6, sizeof d6, "%s/n-sha", tmp);
    cx_fmt(rat1, sizeof rat1, "%s/ratchets.txt", d1);
    if (part == 2) { /* negatives only: a ratchets file that names the frozen commit (the positive half proves the real run) */
        char t[260]; if (cx_fmt(t, sizeof t, "%sRATCHETS\tok=15\tfail=0\n", ratfc)) return 2;
        if (sy_mkdir(d1, 0700) || sy_write_file(rat1, t, strlen(t), 0644)) return 2; goto negatives; }

    /* (1) positive: replay 0.0.74 with the real ratchets run on the frozen commit */
    if (part == 3) {
        /* Stage A has written the evidence in the checkout, before git add. */
        char work[4400], evidence[4500], strict[4600], result[4500], oid[48];
        if(cx_fmt(work,sizeof work,"%s/discovery",tmp) || cx_fmt(evidence,sizeof evidence,"%s/release/evidence",work) ||
           cx_fmt(strict,sizeof strict,"%s/v0.0.74-strict-local.tsv",evidence) || cx_fmt(result,sizeof result,"%s/drafts",work) ||
           sy_mkdir_all(evidence,0700))return 2;
        char *init[]={"git","-C",work,"init","-q",0};
        char *ci[]={"git","-C",work,"-c","user.name=fixture","-c","user.email=f@localhost","-c","commit.gpgsign=false","commit","--allow-empty","-qm","freeze",0};
        char *rev[]={"git","-C",work,"rev-parse","HEAD",0};
        if(!runv(init,10,&rc)||rc||!runv(ci,10,&rc)||rc||!runv(rev,10,&rc)||rc||strlen(out)!=41)return 2;
        out[40]=0;if(cx_fmt(oid,sizeof oid,"%s",out))return 2;
        char rats[4400],source[180];
        if(cx_fmt(rats,sizeof rats,"%s/rats",work) || cx_fmt(source,sizeof source,"SOURCE\tfrozen-commit\tcommit=%s\n",oid) ||
           wr(work,"rats",source))return 2;
        char *discover[]={"env","-C",work,bin,"0.0.74","--layout",lay,"--commit",oid,"--out",result,"--ratchets",rats,0};
        if(wr(evidence,"v0.0.75-strict-wrong.tsv","other version\n"))return 2;
        check("missing-strict-names-version-and-override",runv(discover,10,&rc)&&rc==2&&has(out,"v0.0.74-strict-*.tsv")&&has(out,"--strict"));
        if(wr(evidence,"v0.0.74-strict-local.tsv","incomplete evidence\n"))return 2;
        check("untracked-strict-reaches-content-validation",runv(discover,10,&rc)&&rc==2&&has(out,"no batch rows"));
        check("unique-untracked-selection-reported",has(out,"selected=release/evidence/v0.0.74-strict-local.tsv\ttracked=no")&&!has(out,"STRICT_MULTIPLE"));
        if(wr(evidence,"v0.0.74-strict-first.tsv","older draft\n"))return 2;
        char *add[]={"git","-C",work,"add","--","release/evidence/v0.0.74-strict-local.tsv",0};
        if(!runv(add,10,&rc)||rc)return 2;
        check("multiple-same-version-warns-reports-tracked-choice",runv(discover,10,&rc)&&rc==2&&has(out,"WARN\tSTRICT_MULTIPLE\tmatches=2")&&has(out,"selected=release/evidence/v0.0.74-strict-local.tsv\ttracked=yes"));
        const char *valid="batch\tdomain\tstatus\trc\tcandidate\tms\tload1\tretries\tnote\n"
            "probe\tproduct-qualification\tPASS\t0\t" T_APE "\t1\t0\t0\t-\n"
            "RAW\tBATCH_RUN\tid=probe\tstatus=PASS\trc=0\tcandidate=" T_APE "\n"
            "SUMMARY\tape_sha256=" T_APE "\n";
        char *unstage[]={"git","-C",work,"rm","--cached","--","release/evidence/v0.0.74-strict-local.tsv",0};
        if(!runv(unstage,10,&rc)||rc||sy_write_file(strict,valid,strlen(valid),0644))return 2;
        check("untracked-strict-produces-verified-drafts",runv(discover,10,&rc)&&rc==0&&has(out,"batches=1\tpass=1\tfail=0\tuncovered=0"));
        /* Only draft structure is observed in this invocation. Supply the fixture
           input separately; the ratchets batch verifies the real frozen-tree run. */
        char supplied[4500];
        if (cx_fmt(supplied, sizeof supplied, "%s/structure-ratchets.tsv", tmp) ||
            wr(tmp, "structure-ratchets.tsv", ratfc) ||
            !prep(d1, 0, supplied, lay, &rc) || rc) return 2;
    } else {
        if (part == 4) {
            char *av[] = {bin, "0.0.74", "--layout", lay, "--archive-only", archive_path, 0}; /* lint:allow R1-version replay of the committed v0.0.74 evidence */
            if (cx_fmt(archive_path, sizeof archive_path, "%s/material", tmp) ||
                !runv(av, 55, &rc) || rc || !has(out, "PREPARED\tgit-archive\t")) return 2;
        }
        check("replay-0.0.74-rc0", prep(d1, 0, 0, lay, &rc) && rc == 0 && has(out, "verdict=NOT_QUALIFIED") && has(out, "batches=30\tpass=29\tfail=1\tuncovered=0\tnew_fail=0"));
        if (part == 4) goto ratchets;
    }
    { char *g = rd(d1, "expected-fail.tsv"), *w = rd(root, "release/evidence/0.0.74/expected-fail.tsv");
      check("expected-fail-header-and-columns", g && w && !strncmp(g, "batch\texpected\treason\n", 22) && !strncmp(w, "batch\texpected\treason\n", 22) && tabs_on_line(g, "c-negative\t") == 2 && tabs_on_line(w, "c-negative\t") == 2);
      check("expected-fail-same-batch-and-count", has(g, "\nc-negative\t53/9\t") && has(w, "\nc-negative\t53/9\t") && count_lines(g, "c-negative\t") == 1);
      check("expected-fail-reason-carried", has(g, "\t上一版同批同数:失败 9 项与 v0.0.73 同(上一版 50/9,本版 53/9)") && !has(g, "# NEW"));
      free(g); free(w); }
    { char *g = rd(d1, "rollback.txt"), *w = rd(root, "tests/release-prep/rollback-0.0.74.txt"); static char a[16384], b[16384];
      if (g && w) { nocomment(g, a, sizeof a); nocomment(w, b, sizeof b); }
      check("rollback-commands-equal-committed", g && w && a[0] && !strcmp(a, b));
      check("rollback-identity", has(g, "# 0.0.74 回滚方案") && has(g, fft) && has(g, "SHA256=" T_APE) && has(g, "82d0926e9bed988091dac4ed43e07ab3c199652b0dc470e1cb5e445564e3f3a3") && has(g, "--version=unisacc 0.0.73"));
      free(g); free(w); }
    { char *g = rd(d1, "notes-0.0.74.md"), *w = rd(root, "release/notes-0.0.74.md");
      const char *hd[] = {"# unisacc 0.0.74 发布说明\n", "\n## 真实身份\n", "\n## 产品改动\n", "\n## 严格证据\n", "\n## 已知缺口与未验证范围\n", "\n## 证据入口\n", 0}; int ok = g && w, i;
      for (i = 0; hd[i]; i++) ok = ok && has(g, hd[i]) && has(w, hd[i]);
      check("notes-headings-match-committed", ok);
      check("notes-identity", has(g, fc) && has(g, T_APE) && has(w, T_APE) && has(g, T_STRICT) && has(g, "<CI_RUN_ID>"));
      check("notes-not-qualified-fixed", has(g, "整体裁决 NOT_QUALIFIED") && has(w, "整体裁决 NOT_QUALIFIED") && only_not_qualified(g));
      check("notes-gaps-listed", has(g, "s9 全套本版未跑") && has(g, "(build/pkg-gaps.tsv,OPEN") && has(g, "30 批,PASS 29,FAIL 1,未覆盖 0"));
      free(g); free(w); }
ratchets:
    if (part != 3) { char *g = rd(d1, "ratchets.txt"), *w = rd(root, "release/evidence/0.0.74/ratchets.txt");
      int gn = g ? count_lines(g, "RATCHET\t") : 0, wn = w ? count_lines(w, "RATCHET\t") : 0;
      char want_ok[64]; cx_fmt(want_ok, sizeof want_ok, "\nRATCHETS\tok=%d\tfail=0\t", gn);
      check("ratchets-source-frozen-commit", g && !strncmp(g, ratfc, 86) && strlen(ratfc) == 86);
      check("ratchets-same-rows-as-committed", g && w && gn >= 15 && has(g, want_ok) && has(w, "RATCHETS\tok=15\tfail=0") && (!strcmp(fc, T_COMMIT) ? gn == wn : gn >= wn));
      free(g); free(w); }
    if (part == 4) goto done;
    { char *g = rd(d1, "evidence-rows.tsv"); int ok = g != 0, i;
      const char *rows[] = {"\n1\tPASS\trelease/evidence/0.0.74/chain-promote.txt\n", "\n2\tPASS\trelease/evidence/0.0.74/chain-promote.txt\n", "\n3\tPASS\trelease/evidence/0.0.74/pack-run.out\n",
                            "\n4\tUNKNOWN\t" T_STRICT "\n", "\n5\tPASS\trelease/evidence/0.0.74/pack-run.out\n", "\n6\tPENDING\t", "\n7\tPENDING\t", "\n8\tPENDING\t", 0};
      for (i = 0; rows[i]; i++) ok = ok && has(g, rows[i]);
      check("evidence-rows-8-steps-as-committed", ok && count_lines(g, "#") == 1);
      free(g); }

    if (part != 0) goto done;
negatives:
    /* (2) negative: UNKNOWN batch never becomes PASS, it is listed uncovered */
    if (variant("strict-unknown.tsv", "pp-negative\tproduct-qualification\tPASS", "pp-negative\tproduct-qualification\tUNKNOWN", s_unk, sizeof s_unk)) return 2;
    { char *g; check("unknown-batch-rc1-uncovered", prep(d2, s_unk, rat1, lay, &rc) && rc == 1 && has(out, "PREP\tUNCOVERED\tpp-negative\tUNKNOWN") && has(out, "pass=28\tfail=1\tuncovered=1"));
      g = rd(d2, "notes-0.0.74.md"); check("unknown-batch-in-gaps-not-pass", has(g, "严格证据批次 pp-negative 状态 UNKNOWN") && has(g, "30 批,PASS 28,FAIL 1,未覆盖 1") && only_not_qualified(g)); free(g); }
    /* (3) negative: ratchets not from the frozen commit */
    { char p[4500]; cx_fmt(p, sizeof p, "%s/rat-head.txt", tmp);
      { if (sy_write_file(p, rathead, strlen(rathead), 0644)) return 2; }
      check("ratchets-shared-head-refused", prep(d3, 0, p, lay, &rc) && rc == 2 && has(out, "REFUSE PREP_RATCHETS_SOURCE"));
      cx_fmt(p, sizeof p, "%s/rat-other.txt", tmp);
      { const char *t = "SOURCE\tfrozen-commit\tcommit=b546f23546aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\nRATCHETS\tok=15\tfail=0\n"; if (sy_write_file(p, t, strlen(t), 0644)) return 2; }
      check("ratchets-other-commit-refused", prep(d3, 0, p, lay, &rc) && rc == 2 && has(out, "REFUSE PREP_RATCHETS_SOURCE")); }
    /* (4) negative: new FAIL and changed fail count are not auto-admitted */
    if (variant("strict-newfail.tsv", "pp-negative\tproduct-qualification\tPASS\t0", "pp-negative\tproduct-qualification\tFAIL\t1", s_new, sizeof s_new)) return 2;
    { char *g; check("new-fail-rc1", prep(d4, s_new, rat1, lay, &rc) && rc == 1 && has(out, "PREP\tNEW_FAIL\tpp-negative\t10/0") && has(out, "new_fail=1"));
      g = rd(d4, "expected-fail.tsv"); check("new-fail-not-admitted", has(g, "\n# NEW\tpp-negative\t") && !has(g, "\npp-negative\t") && has(g, "\nc-negative\t53/9\t")); free(g); }
    /* (4b) window-concatenated evidence: a later window reruns pp-negative to PASS; folded by batch */
    { char *base = rd(root, T_STRICT), *fl = rd(tmp, "strict-newfail.tsv"), *row, *raw, *re, *rr, p[4500]; np_buf b = {0}; int bad = 1;
      if (base && fl && (row = strstr(base, "\npp-negative\t")) && (raw = strstr(base, "\nRAW\tBATCH_RUN\tid=pp-negative\t")) && (re = strchr(row + 1, '\n')) && (rr = strchr(raw + 1, '\n'))) {
          np_puts(&b, fl); np_put(&b, row + 1, (size_t)(re - row)); np_put(&b, raw + 1, (size_t)(rr - raw));
          bad = cx_fmt(p, sizeof p, "%s/strict-rerun.tsv", tmp) || sy_write_file(p, b.p, b.n, 0644);
      }
      if (bad) return 2;
      { char d7[4400]; cx_fmt(d7, sizeof d7, "%s/n-rerun", tmp);
        check("rerun-window-folded-by-batch", prep(d7, p, rat1, lay, &rc) && rc == 0 && has(out, "batches=30\tpass=29\tfail=1\tuncovered=0\tnew_fail=0") && !has(out, "PREP\tNEW_FAIL\tpp-negative")); }
      free(base); free(fl); free(b.p); }
    if (variant("strict-count.tsv", "count=53/9", "count=52/10", s_cnt, sizeof s_cnt)) return 2;
    { char *g; check("changed-fail-count-rc1", prep(d5, s_cnt, rat1, lay, &rc) && rc == 1 && has(out, "PREP\tNEW_FAIL\tc-negative\t52/10"));
      g = rd(d5, "expected-fail.tsv"); check("changed-fail-count-not-admitted", has(g, "\n# NEW\tc-negative\t52/10\t") && !has(g, "\nc-negative\t")); free(g); }
    /* (5) negative: layout candidate differs from strict SUMMARY */
    check("layout-sha-mismatch-refused", prep(d6, 0, rat1, badlay, &rc) && rc == 2 && has(out, "REFUSE PREP_STRICT_CANDIDATE"));
    /* (6) chain-tail reaction draft prints five keyed steps and starts nothing; bad key refused */
    { char *v[] = {bin, "--tail-plan", T_COMMIT, T_APE, "0.0.74", 0}; /* lint:allow R1-version replay of the committed v0.0.74 evidence */
      check("tail-plan-keyed-steps", runv(v, 20, &rc) && rc == 0 && count_lines(out, "TAIL\t") == 6 && has(out, "TAIL\t4\texecute-dry\tkey=" T_APE ":" T_COMMIT) && has(out, "--dry\tgate=") && has(out, "TAIL\tPLAN_ONLY\t")); }
    { char *v[] = {bin, "--tail-plan", "HEAD", T_APE, "0.0.74", 0}; /* lint:allow R1-version replay of the committed v0.0.74 evidence */
      check("tail-plan-bad-key-refused", runv(v, 20, &rc) && rc == 2 && has(out, "REFUSE PREP_USAGE")); }
    /* (7) rollback template audit self-test: positive and 3 negative mutations */
    { char rdir[4400], fcand[4500], frb[4500], fdec[4500], fnt[4500], fbad[4500];
      if (cx_fmt(rdir, sizeof rdir, "%s/rb-fx", tmp) || sy_mkdir(rdir, 0700) ||
          cx_fmt(fcand, sizeof fcand, "%s/cand.tsv", rdir) || cx_fmt(frb, sizeof frb, "%s/rb.txt", rdir) ||
          cx_fmt(fdec, sizeof fdec, "%s/dec.txt", rdir) || cx_fmt(fnt, sizeof fnt, "%s/notes.md", rdir) ||
          cx_fmt(fbad, sizeof fbad, "%s/bad.txt", rdir)) return 2;
      const char *c_ok = "repo\ttag\tcommit\tversion\tworkflow\tworkflow_ref\tci_run_id\tape\tape_sha256\tpackage\tpackage_sha256\twin_arm64\twin_arm64_sha256\trecord\trecord_sha256\tbuild_alias\tbuild_alias_sha256\tzip\tzip_sha256\tchecksums\tchecksums_sha256\n"
          "r/u\tv0.0.98\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\t0.0.98\tw.yml\tv0.0.98\t123456\tu.com\t1111111111111111111111111111111111111111111111111111111111111111\tpkg\t2222222222222222222222222222222222222222222222222222222222222222\tsw\t3333333333333333333333333333333333333333333333333333333333333333\trec\t4444444444444444444444444444444444444444444444444444444444444444\tbal\t4444444444444444444444444444444444444444444444444444444444444444\t-\t-\tSUMS\t5555555555555555555555555555555555555555555555555555555555555555\n";
      const char *rb_ok = "# 0.0.99 rb\n# aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa 123456\n# 1111111111111111111111111111111111111111111111111111111111111111\n# 2222222222222222222222222222222222222222222222222222222222222222\n# 3333333333333333333333333333333333333333333333333333333333333333\n# 4444444444444444444444444444444444444444444444444444444444444444\n# 5555555555555555555555555555555555555555555555555555555555555555\ngh -R r/u release edit v0.0.99 --draft=true\ngh -R r/u release edit v0.0.98 --latest\n# --version=unisacc 0.0.98\n";
      const char *rb_bad = "# 0.0.99 rb\n# aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa 123456\n# 1111111111111111111111111111111111111111111111111111111111111110\n# 2222222222222222222222222222222222222222222222222222222222222222\n# 3333333333333333333333333333333333333333333333333333333333333333\n# 4444444444444444444444444444444444444444444444444444444444444444\n# 5555555555555555555555555555555555555555555555555555555555555555\ngh -R r/u release edit v0.0.99 --draft=true\ngh -R r/u release edit v0.0.98 --latest\n# --version=unisacc 0.0.98\n";
      const char *dc_ok = "STEP\t1\tfreeze\tPENDING\trelease/evidence/0.0.99/a\nQUALIFIED\tNOT_QUALIFIED\tunknown=1\tfail=0\n";
      const char *dc_pass = "STEP\t1\tfreeze\tPASS\trelease/evidence/0.0.99/a\nQUALIFIED\tNOT_QUALIFIED\tunknown=1\tfail=0\n";
      const char *nt_ok = "# unisacc 0.0.99 notes\nNOT_QUALIFIED\n## \xe5\xb7\xb2\xe7\x9f\xa5\xe7\xbc\xba\xe5\x8f\xa3\nrelease/rollback.txt\n";
      const char *nt_qual = "# unisacc 0.0.99 notes\nQUALIFIED\n## \xe5\xb7\xb2\xe7\x9f\xa5\xe7\xbc\xba\xe5\x8f\xa3\nrelease/rollback.txt\n";
      if (wr(rdir, "cand.tsv", c_ok) || wr(rdir, "rb.txt", rb_ok) || wr(rdir, "dec.txt", dc_ok) || wr(rdir, "notes.md", nt_ok)) return 2;
      check("rollback-audit-pos", rb_audit("0.0.99", "0.0.98", fcand, frb, fdec, fnt, 0, 0) == 0);
      if (wr(rdir, "bad.txt", rb_bad)) return 2;
      check("rollback-audit-neg-sha-flip", rb_audit("0.0.99", "0.0.98", fcand, fbad, fdec, fnt, 0, 0) > 0);
      if (wr(rdir, "bad.txt", dc_pass)) return 2;
      check("rollback-audit-neg-pre-pass", rb_audit("0.0.99", "0.0.98", fcand, frb, fbad, fnt, 0, 0) > 0);
      if (wr(rdir, "bad.txt", nt_qual)) return 2;
      check("rollback-audit-neg-bare-qualified", rb_audit("0.0.99", "0.0.98", fcand, frb, fdec, fbad, 0, 0) > 0);
    }
    /* (8) notes honesty audit self-test: evidenced claim passes, bare/TBD verified claims fail, negated wording passes */
    { char ndir[4400], f1[4500], f2[4500], f3[4500], f4[4500];
      if (cx_fmt(ndir, sizeof ndir, "%s/notes-fx", tmp) || sy_mkdir(ndir, 0700) ||
          cx_fmt(f1, sizeof f1, "%s/ok.md", ndir) || cx_fmt(f2, sizeof f2, "%s/bare.md", ndir) ||
          cx_fmt(f3, sizeof f3, "%s/tbd.md", ndir) || cx_fmt(f4, sizeof f4, "%s/neg.md", ndir)) return 2;
      const char *n_ok = "# unisacc 0.0.99 notes\nNOT_QUALIFIED\n- osx probe \xe5\xb7\xb2\xe9\xaa\x8c\xe8\xaf\x81 (release/evidence/0.0.99/ci-12345.log)\n## \xe5\xb7\xb2\xe7\x9f\xa5\xe7\xbc\xba\xe5\x8f\xa3\nrelease/rollback.txt\n";
      const char *n_bare = "# unisacc 0.0.99 notes\nNOT_QUALIFIED\n- osx probe \xe5\xb7\xb2\xe9\xaa\x8c\xe8\xaf\x81\n## \xe5\xb7\xb2\xe7\x9f\xa5\xe7\xbc\xba\xe5\x8f\xa3\nrelease/rollback.txt\n";
      const char *n_tbd = "# unisacc 0.0.99 notes\nNOT_QUALIFIED\n- osx probe \xe5\xb7\xb2\xe9\xaa\x8c\xe8\xaf\x81 (release/evidence/0.0.99/ci-TBD.log)\n## \xe5\xb7\xb2\xe7\x9f\xa5\xe7\xbc\xba\xe5\x8f\xa3\nrelease/rollback.txt\n";
      const char *n_neg = "# unisacc 0.0.99 notes\nNOT_QUALIFIED\n- \xe4\xb8\x8d\xe5\xbe\x97\xe5\xa3\xb0\xe7\xa7\xb0\xe7\xbb\x8f\xe5\xae\x9e\xe6\x9c\xba\xe8\xbf\x90\xe8\xa1\x8c\xe9\xaa\x8c\xe8\xaf\x81\n## \xe5\xb7\xb2\xe7\x9f\xa5\xe7\xbc\xba\xe5\x8f\xa3\nrelease/rollback.txt\n";
      if (wr(ndir, "ok.md", n_ok) || wr(ndir, "bare.md", n_bare) || wr(ndir, "tbd.md", n_tbd) || wr(ndir, "neg.md", n_neg)) return 2;
      check("notes-audit-pos-evidenced", notes_audit(f1, 0) == 0);
      check("notes-audit-neg-bare-verified", notes_audit(f2, 0) > 0);
      check("notes-audit-neg-tbd-verified", notes_audit(f3, 0) > 0);
      check("notes-audit-pos-negated-wording", notes_audit(f4, 0) == 0);
    }
done:
    { char *v[] = {"rm", "-rf", tmp, 0}; runv(v, 30, &rc); }
    printf("CHECK_RELEASE_PREP\tpass=%d\tfail=%d\n", passed, failed);
    return failed ? 1 : 0;
}
