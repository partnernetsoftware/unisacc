        ck(!strcmp(out, out2) && strstr(out2, "arg1=a b\narg2=c\n"), "run-output-same-as-direct");
        rs = fx1("run", "echo.cx", "a b", "c", 0, 0);
        ck(rs == 7 && strstr(runline(), "via=service") && strstr(runline(), "cache=hit"), "run-second-cache-hit");
        rs = fx1("run", "--local", "echo.cx", "z", 0, 0);
        ck(rs == 7 && has("arg1=z\n") && strstr(runline(), "via=local") && strstr(runline(), "cache=hit"), "run-local-shares-cache");
        rs = fx1("run", "--par", "8", "echo.cx", "p", 0);
        ck(rs == 7 && has("arg1=p\n") && !has("arg1=--par") && strstr(runline(), "cache=hit"), "run-par-accepted-ignored");
        rs = fx1("run", "--quiet", "echo.cx", "q", 0, 0);
        ck(rs == 7 && has("arg1=q\n") && !has("DEVSVC_RUN\t"), "run-quiet-suppresses-result-line");
        /* 产品语义(R2):键 = 产品字节 sha + 工具 use 闭包内容;闭包外的未跟踪/脏文件不影响命中(准备耗时小于 1 s) */
        F(stray, sizeof stray, "%s/%s/stray-untracked.cx", fx, c_lib[2]);
        ck(sy_write_atomic(stray, "/* stray */\n", 12, 0644) == 0, "run-untracked-fixture-written");
        rs = fx1("run", "echo.cx", "u", 0, 0, 0);
        ck(rs == 7 && has("arg1=u\n") && strstr(runline(), "via=service") && strstr(runline(), "cache=hit") && strstr(runline(), "prep_ms=") && atol(strstr(runline(), "prep_ms=") + 8) < 1000, "run-untracked-outside-closure-still-hit");
        rs = fx1("run", "echo.cx", "u", 0, 0, 0);
        ck(rs == 7 && has("arg1=u\n") && strstr(runline(), "cache=hit"), "run-untracked-outside-closure-second-hit");
        rs = fx1("run", "--local", "echo.cx", "u", 0, 0);
        ck(rs == 7 && strstr(runline(), "via=local") && strstr(runline(), "cache=hit"), "run-untracked-outside-closure-local-hit");
        ck(sy_unlink(stray) == 0, "run-untracked-fixture-removed");
        rs = fx1("run", "echo.cx", "a b", "c", 0, 0);
        ck(rs == 7 && strstr(runline(), "cache=hit"), "run-clean-again-cache-hit");
        /* 闭包内改动(工具源本身,未提交)即失效重建,输出跟随新内容;再跑恢复命中 */
        {   char ep[400]; const char *src2 = "int main(int argc, char **argv) { (void)argv; printf(\"v2 n=%d\\n\", argc); return 7; }\n";
            F(ep, sizeof ep, "%s/echo.cx", fx);
            ck(sy_write_atomic(ep, src2, strlen(src2), 0644) == 0, "run-closure-edit-written");
            rs = fx1("run", "echo.cx", "q", 0, 0, 0);
            ck(rs == 7 && has("v2 n=2\n") && strstr(runline(), "cache=miss"), "run-closure-edit-rebuilds");
            rs = fx1("run", "echo.cx", "q", 0, 0, 0);
            ck(rs == 7 && has("v2 n=2\n") && strstr(runline(), "cache=hit"), "run-closure-edit-then-hit"); }
        /* 构造失败:回包带编译错误文本与完整日志路径(经服务与 --local 都要) */
        {   char bad[400]; F(bad, sizeof bad, "%s/bad.cx", fx);
            ck(sy_write_atomic(bad, "int main(void) { return undeclared_symbol_xyz; }\n", 49, 0644) == 0, "run-bad-fixture-written");
            ck(fx1("run", "bad.cx", 0, 0, 0, 0) == 1 && has("ERR\tnative\tbad.cx\trc=-1") && has("\tlog=/") && has(".build.log\n") && has("\nBUILD\t") && has("undeclared_symbol_xyz"), "run-build-failure-returns-compiler-stderr");
            ck(fx1("run", "--local", "bad.cx", 0, 0, 0) == 1 && has("devsvc: cannot build bad.cx rc=-1") && has("log=/") && has("\nBUILD\t") && has("undeclared_symbol_xyz"), "run-local-build-failure-returns-compiler-stderr");
            ck(sy_unlink(bad) == 0, "run-bad-fixture-removed"); }
        ck(fx1("run", "../etc/x.cx", 0, 0, 0, 0) == 1, "run-path-escape-refused"); }
    }
    if (B1 || B2 || B3) ck(dv1("stop", 0, 0, 0, 0, 0) == 0 && has("OK\tstopping"), "run-group-stop");
    if (A3) {
    ck(dv1("start", "--ttl", "120", "--idle", "100", 0) == 0 && has("OK\tstarted"), "a3-start");

    /* 内容键:两个不同路径的克隆共用同内容构造(键不含根);改闭包内文件即失效;用 __FILE__ 的工具键里保留根,输出路径跟随各自克隆 */
    {   char c1[200], c2[200], p[300], *q; const char *ks = "int main(int argc, char **argv) { (void)argv; printf(\"ckey n=%d\\n\", argc); return 7; }\n";
        const char *ks2 = "int main(int argc, char **argv) { (void)argv; printf(\"ckey2 n=%d\\n\", argc); return 7; }\n";
        const char *fs = "int main(void) { printf(\"file=%s\\n\", __FILE__); return 7; }\n"; int i, rs; long pm;
        F(c1, sizeof c1, "/tmp/devsvc-check-%d-ckey1", sy_pid()); F(c2, sizeof c2, "/tmp/devsvc-check-%d-ckey2", sy_pid());
        for (i = 0; i < 2; i++) {
            char *d = i ? c2 : c1; char *v[] = {"git", "clone", "-q", fx, d, 0};
            ck(cap2(v, 0, out2, sizeof out2) == 0, i ? "ckey-clone2" : "ckey-clone1");
            F(p, sizeof p, "%s/%s", d, c_product); { char *l[] = {"ln", "-sf", prod, p, 0}; (void)cap2(l, 0, out2, sizeof out2); }
            F(p, sizeof p, "%s/ckey.cx", d); ck(sy_write_atomic(p, ks, strlen(ks), 0644) == 0, "ckey-tool-written");
            F(p, sizeof p, "%s/fref.cx", d); ck(sy_write_atomic(p, fs, strlen(fs), 0644) == 0, "ckey-fref-written"); }
        { char *v[] = {"run", "--local", "ckey.cx", "x", 0}; rs = dvat(c1, out, sizeof out, v); }
        ck(rs == 7 && has("ckey n=2\n") && strstr(runline(), "cache=miss"), "ckey-clone1-first-builds");
        { char *v[] = {"run", "--local", "ckey.cx", "x", 0}; rs = dvat(c2, out, sizeof out, v); }
        q = strstr(runline(), "prep_ms="); pm = q ? atol(q + 8) : 99999;
        ck(rs == 7 && has("ckey n=2\n") && strstr(runline(), "cache=hit") && pm < 1000, "ckey-clone2-first-hit-under-1s");
        F(p, sizeof p, "%s/ckey.cx", c2); ck(sy_write_atomic(p, ks2, strlen(ks2), 0644) == 0, "ckey-closure-edit-written");
        { char *v[] = {"run", "--local", "ckey.cx", "x", 0}; rs = dvat(c2, out, sizeof out, v); }
        ck(rs == 7 && has("ckey2 n=2\n") && strstr(runline(), "cache=miss"), "ckey-closure-edit-misses");
        { char *v[] = {"run", "--local", "fref.cx", 0}; rs = dvat(c1, out, sizeof out, v); }
        F(p, sizeof p, "file=%s/fref.cx\n", c1); ck(rs == 7 && has(p), "ckey-fileref-clone1-own-path");
        { char *v[] = {"run", "--local", "fref.cx", 0}; rs = dvat(c2, out, sizeof out, v); }
        F(p, sizeof p, "file=%s/fref.cx\n", c2); ck(rs == 7 && has(p) && !strstr(out, c1) && strstr(runline(), "cache=miss"), "ckey-fileref-clone2-rebuilds-own-path");
        { char *rm[] = {"rm", "-rf", c1, c2, 0}; ck(cap2(rm, 0, out2, sizeof out2) == 0, "ckey-clones-cleanup"); } }

    ck(dv1("stop", 0, 0, 0, 0, 0) == 0 && has("OK\tstopping"), "a3-stop");
    }

    {   char *rm[] = {"rm", "-rf", inst, fx, 0}; ck(cap2(rm, 0, out2, sizeof out2) == 0, "fixture-cleanup"); }
    ck(ovf == 0, "no-path-overflow");
    printf("CHECK_DEVSVC\tok=%d\tfailed=%d\n", nok, nfail);
    return nfail ? 1 : 0;
}
