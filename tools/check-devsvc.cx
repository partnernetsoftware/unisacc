/* tools/check-devsvc.cx -- 检查 tools/devsvc.cx(仓开发服务基础版)。批次 devsvc。
 *
 *   sh ./unisacc.com tools/check-devsvc.cx        (在仓根或版本工作目录根跑)
 *
 * 确定性:不依赖本检出的工作区状态。产品名、服务源、库源目录、实例目录环境变量名都从配置表 tools/devsvc-repo.tsv 读。
 * 夹具:实例目录 /tmp/devsvc-check-<pid>(经配置表 inst_env 所名环境变量),不碰真实实例;
 *   run 的缓存断言在私有 git 仓 /tmp/devsvc-check-<pid>-repo 里做(三个库源目录各一个已提交文件、echo.cx、指向本检出产品的符号链接),
 *   所以他人在本检出库源目录里的未跟踪文件不影响结论;"有未跟踪文件不缓存"的产品语义由夹具仓里主动造未跟踪文件来断言。
 * 所起实例 ttl 均不超过 120 s,结束时 stop 并清理;即使本检查被杀,实例也会到点自退。
 * 断言:config 读表、表缺失 rc 3;起实例与重复 start;锁互斥、非属主不能放、续期、过期后可被他人拿到并产生 lock.expire 事件;
 *   两客户端并发拿同名锁恰一个成功;锁落盘跨实例重启仍在;stop 后 sock 消失;ttl 到点自退;idle 到点自退;status 末行;
 *   run 经服务与直接运行的输出和退出码一致,首次 miss、第二次 hit、--local 共用缓存;库源目录有未跟踪文件时连续两次都是 bypass,
 *   去掉后恢复 hit;events since 增量;b3 组:f write 落到 exec/、seed/ 且夹具 bundle 已构造时拉起一个 cx-dev --watch(替身脚本),
 *   带 CXDEV_EVENTS,在跑时不重复拉起,写其它路径或 bundle 未构造或开关关闭时不拉起,进程没了之后重新拉起。
 * 输出 PASS/FAIL 行,末行 CHECK_DEVSVC<TAB>ok=N<TAB>failed=N;有 FAIL 则 rc 1。 */
#pragma unisa use sys.time
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sysx.process
#pragma unisa use mem.bytes

#define CFG_TABLE "tools/devsvc-repo.tsv"
static int nok, nfail, ovf;
#define F(dst, cap, ...) do { int f_ = snprintf(dst, cap, __VA_ARGS__); if (f_ < 0 || f_ >= (int)(cap)) ovf++; } while (0)
static char root[1024], table[1100], prod[1200], self[1200], inst[128], sock[160], fx[160], out[1 << 16], out2[1 << 16];
static char c_product[128], c_self[128], c_env[64], c_lib[3][128];
static void ck(int c, const char *name) {
    printf("%s\tdevsvc.%s\n", c ? "PASS" : "FAIL", name);
    if (!c) printf("NOTE\tlast-output\t%.300s\n", out);
    if (c) nok++; else nfail++;
}
/* 配置表里第 nth(从 0 起)个 key 的 value;找不到返回 0 */
static int cfgval(const char *tb, long n, const char *key, int nth, char *dst, int cap) {
    const char *s = tb, *end = tb + n, *e, *t, *t2; long kl = strlen(key);
    for (; s < end; s = e + 1) {
        e = memchr(s, '\n', end - s); if (!e) break;
        if (e - s <= kl || memcmp(s, key, kl) || s[kl] != '\t') continue;
        if (nth-- > 0) continue;
        t = s + kl + 1; t2 = memchr(t, '\t', e - t); if (!t2) t2 = e;
        if (t2 - t <= 0 || t2 - t >= cap) return 0;
        if (mm_copy(dst, cap, t, t2 - t)) return 0;
        dst[t2 - t] = 0; return 1;
    }
    return 0;
}
/* 有界跑一条命令(55 秒上限,cwd 为 0 即当前目录):stdout 后接 stderr 收进 buf,返回退出码;起不来或装不下返回 -1 */
static int cap2(char **v, const char *cwd, char *buf, int cap) {
    np_result r; char why[200]; int rc; long a, b;
    memset(buf, 0, cap);
    if (np_run(v, cwd, 0, 55, &r, why, sizeof why)) return -1;
    a = (long)r.outn; b = (long)r.errn; rc = r.rc;
    if (a + b > cap - 1 || (a > 0 && mm_copy(buf, cap, r.out, a)) || (b > 0 && mm_copy(buf + a, cap - a, r.err, b))) rc = -1;
    np_free(&r);
    return rc;
}
/* 在 cwd 下跑 devsvc 子命令,返回退出码 */
/* x 与 flow 必须显式 --par:用例未给 --par/--jobs 时,x 在子命令后、flow 在末尾补 --par 8 */
static int dvat(const char *cwd, char *buf, int cap, char **args) {
    char *v[28]; int n = 0, i, given = 0, isx = args[0] && !strcmp(args[0], "x"), isf = args[0] && !strcmp(args[0], "flow");
    for (i = 0; args[i]; i++) if (!strcmp(args[i], "--par") || !strcmp(args[i], "--jobs")) given = 1;
    v[n++] = "sh"; v[n++] = prod; v[n++] = self; v[n++] = "--";
    for (i = 0; args[i] && n < 25; i++) { v[n++] = args[i]; if (i == 0 && isx && !given) { v[n++] = "--par"; v[n++] = "8"; } }
    if (isf && !given) { v[n++] = "--par"; v[n++] = "8"; }
    v[n] = 0;
    return cap2(v, cwd, buf, cap);
}
static int dv(char *buf, int cap, char **args) { return dvat(0, buf, cap, args); }
static int dv1(char *a, char *b, char *c, char *d, char *e, char *f) { char *v[] = {a, b, c, d, e, f, 0}; return dv(out, sizeof out, v); }
/* 在夹具仓里跑 devsvc 子命令 */
static int fx1(char *a, char *b, char *c, char *d, char *e, char *f) { char *v[] = {a, b, c, d, e, f, 0}; return dvat(fx, out, sizeof out, v); }
static int has(const char *s) { return strstr(out, s) != 0; }
static const char *runline(void) { const char *q = strstr(out, "DEVSVC_RUN\t"); return q ? q : ""; }
static int bg(sy_child_t *ch, char *owner) {
    static char *v[2][12]; static int k; char **a = v[k++ & 1]; sy_spawn_t o;
    a[0] = "sh"; a[1] = prod; a[2] = self; a[3] = "--"; a[4] = "lock"; a[5] = "acquire"; a[6] = "race"; a[7] = "--owner"; a[8] = owner; a[9] = 0;
    sy_spawn_init(&o); o.argv = a; o.deadline_ms = 30000; o.out_fd = SY_STDIO_NULL; o.err_fd = SY_STDIO_NULL;
    return sy_proc_spawn(&o, ch);
}
/* 私有夹具仓:三个库源目录各一个已提交文件、echo.cx、产品符号链接;全部已提交,库源目录无未跟踪文件 */
static int fixture_repo(const char *src) {
    char p[400], d[300]; int i;
    for (i = 0; i < 3; i++) {
        F(d, sizeof d, "%s/%s", fx, c_lib[i]); F(p, sizeof p, "%s/keep.txt", d);
        if (sy_mkdir_all(d, 0755) || sy_write_atomic(p, "keep\n", 5, 0644)) return -1;
    }
    F(p, sizeof p, "%s/echo.cx", fx);
    if (sy_write_atomic(p, src, strlen(src), 0644)) return -1;
    F(p, sizeof p, "%s/%s", fx, c_product);
    {   char *v[] = {"ln", "-s", prod, p, 0}; if (cap2(v, 0, out2, sizeof out2) != 0) return -2; }
    {   char *v[] = {"git", "init", "-q", 0}; if (cap2(v, fx, out2, sizeof out2) != 0) return -3; }
    {   char *v[] = {"git", "add", "-A", 0}; if (cap2(v, fx, out2, sizeof out2) != 0) return -4; }
    {   char *v[] = {"git", "-c", "user.name=devsvc-check", "-c", "user.email=devsvc-check@invalid", "-c", "commit.gpgsign=false",
                     "-c", "core.hooksPath=/dev/null", "commit", "-q", "-m", "fixture", 0};
        if (cap2(v, fx, out2, sizeof out2) != 0) return -5; }
    return 0;
}

int main(int argc, char **argv) {
    char stray[400];
    /* --cases a:配置/锁/事件/git/status/重启/ttl/idle;--cases b:run 缓存(夹具仓);缺省两组都跑。批次 devsvc 跑 a,devsvc-run 跑 b */
    /* b 拆两组(各自起停实例):b1 事件落盘与只读 git;b2 run 原生缓存。--cases b 等于 b1+b2 */
    int A1 = 1, A2 = 1, A3 = 1, B1 = 1, B2 = 1, B3 = 1, A;   /* b3:cx-dev 事件预建的自动拉起(批次 devsvc-cxdev-kick) */
    if (argc >= 3 && !strcmp(argv[1], "--cases")) { const char *cs = argv[2]; int dg = strstr(cs, "a1") || strstr(cs, "a2") || strstr(cs, "a3"), ha = strchr(cs, 'a') != 0;
        int db = strstr(cs, "b1") || strstr(cs, "b2") || strstr(cs, "b3"), hb = strchr(cs, 'b') != 0;
        A1 = ha && (!dg || strstr(cs, "a1")); A2 = ha && (!dg || strstr(cs, "a2")); A3 = ha && (!dg || strstr(cs, "a3"));
        B1 = hb && (!db || strstr(cs, "b1")); B2 = hb && (!db || strstr(cs, "b2")); B3 = hb && (!db || strstr(cs, "b3")); }
    else if (argc > 1) { fprintf(stderr, "usage: check-devsvc.cx [--cases a|a1|a2|a3|b|b1|b2|b3|ab]\n"); return 2; } int r, r2; sy_child_t c1, c2; sy_exit_t e1, e2; long t0;
    static const char *src = "int main(int argc, char **argv) { int i; for (i = 1; i < argc; i++) printf(\"arg%d=%s\\n\", i, argv[i]); return 7; }\n";
    A = A1 || A2 || A3;
    if (sy_cwd(root, sizeof root) < 0) return 2;
    (void)unsetenv("DEVSVC_SELF_BIN");   /* 在 devsvc x 内跑时不继承固定版本执行体:本检查测的是 self 所指的工作副本 */
    (void)unsetenv("UNISACC_FLOW_ROOT"); /* 同理不继承 devsvc x 注入的写根:否则夹具仓里的 f write 会按该写根落到真实检出 */
    F(table, sizeof table, "%s/%s", root, CFG_TABLE);
    {   unsigned char *b = 0; int64_t n = 0; int okc;
        if (sy_read_file(table, &b, &n, 1 << 16) || !b) { printf("FAIL\tdevsvc.config-table-readable\t%s\n", table); return 1; }
        okc = cfgval((char *)b, n, "product", 0, c_product, sizeof c_product) && cfgval((char *)b, n, "self", 0, c_self, sizeof c_self)
           && cfgval((char *)b, n, "inst_env", 0, c_env, sizeof c_env) && cfgval((char *)b, n, "lib", 0, c_lib[0], 128)
           && cfgval((char *)b, n, "lib", 1, c_lib[1], 128) && cfgval((char *)b, n, "lib", 2, c_lib[2], 128);
        free(b);
        if (!okc) { printf("FAIL\tdevsvc.config-table-keys\t%s\n", table); return 1; } }
    F(prod, sizeof prod, "%s/%s", root, c_product); F(self, sizeof self, "%s/%s", root, c_self);
    F(inst, sizeof inst, "/tmp/devsvc-check-%d", sy_pid()); F(sock, sizeof sock, "%s/sock", inst);
    F(fx, sizeof fx, "/tmp/devsvc-check-%d-repo", sy_pid());
    /* 夹具仓里没有配置表:经 DEVSVC_REPO_TABLE 让所有子进程(含实例)读本检出的表 */
    if (setenv(c_env, inst, 1) || setenv("DEVSVC_REPO_TABLE", table, 1)) return 2;
    r = fixture_repo(src);
    if (r) { printf("FAIL\tdevsvc.fixture\trc=%d\t%.200s\n", r, out2); return 1; }

    if (A) {
    /* 配置表 */
    if (A1) {   char want[200]; F(want, sizeof want, "CFG\tproduct\t%s\n", c_product);
        ck(dv1("config", 0, 0, 0, 0, 0) == 0 && has(want) && has("CFG\tlock\tregistry\n") && has("CFG\tlock\tderive\n") && has("\nDEVSVC_CONFIG\ttable="), "config-reads-table");
        if (setenv("DEVSVC_REPO_TABLE", "/tmp/devsvc-check-no-such-table.tsv", 1)) return 2;
        ck(dv1("config", 0, 0, 0, 0, 0) == 3 && has("unreadable"), "config-missing-table-rc3");
        if (setenv("DEVSVC_REPO_TABLE", table, 1)) return 2;
        /* derive 路径选择:缺省(--check)用并发版 derive-flow,--write 仍串行 derive 并持锁;并发版缺失回退串行 */
        if (setenv("DEVSVC_DERIVE_DRY", "1", 1)) return 2;
        ck(dv1("derive", "--check", "--only", "layer-api", 0, 0) == 0 && has("DEVSVC_DERIVE\tplan=tools/derive-flow.cx\tfallback=tools/derive.cx\n"), "derive-check-default-flow");
        ck(dv1("derive", "--write", "--only", "layer-api", 0, 0) == 0 && has("DEVSVC_DERIVE\tplan=tools/derive.cx\tlock=derive\n") && !has("derive-flow"), "derive-write-stays-serial");
        if (unsetenv("DEVSVC_DERIVE_DRY") || setenv("DEVSVC_DERIVE_FLOW", "tools/devsvc-check-no-such-flow.cx", 1)) return 2;
        ck(dv1("derive", "--check", "--only", "devsvc-check-no-such-item", 0, 0) != 0 && has("DEVSVC_DERIVE\tvia=serial-fallback\tflow=tools/devsvc-check-no-such-flow.cx\n") && !has("via=flow"), "derive-missing-flow-falls-back-serial");
        if (unsetenv("DEVSVC_DERIVE_FLOW")) return 2; }

    if (setenv("DEVSVC_EV_ROTATE", "1500", 1) || setenv("DEVSVC_OWNER", "chk-owner", 1)) return 2;   /* 事件落盘轮转阈值调小;命令完成事件的 owner */
    if (A1) {
        /* git commit 参数严格解析(夹具仓,不进共享检出):--help/未知选项/缺 -m/缺路径来源/空首行/署名首行一律 rc 2,HEAD 与索引不变;合法参数过解析 */
        {   char h0[128], h1[128], i0[2048], i1[2048]; char *sv[] = {"git", "rev-parse", "HEAD", 0}; char *st[] = {"git", "add", "-A", 0}; char *dd[] = {"git", "diff", "--cached", "--stat", 0};
            char p2[600]; int okc;
            F(p2, sizeof p2, "%s/staged.txt", fx);
            okc = sy_write_atomic(p2, "staged\n", 7, 0644) == 0 && cap2(st, fx, out2, sizeof out2) == 0;
            okc = okc && cap2(sv, fx, h0, sizeof h0) == 0 && cap2(dd, fx, i0, sizeof i0) == 0 && strstr(i0, "staged.txt");
            ck(okc, "gitargs-fixture-has-staged-entry");
            { char *a1[] = {"git", "commit", "--help", 0}, *a2[] = {"git", "commit", "-m", "x", "--whole", "a", "--bogus", 0}, *a3[] = {"git", "commit", "--whole", "staged.txt", 0},
                   *a4[] = {"git", "commit", "-m", "x", 0}, *a5[] = {"git", "commit", "-m", "", "--whole", "staged.txt", 0}, *a6[] = {"git", "commit", "-m", "Co-Authored-By: A <a@b>", "--whole", "staged.txt", 0},
                   *a7[] = {"git", "commit", "-m", "  \n\nbody", "--whole", "staged.txt", 0}, *a8[] = {"git", "commit", "-h", 0};
              char **all[] = {a1, a2, a3, a4, a5, a6, a7, a8}; int k, allrc = 1;
              for (k = 0; k < 8; k++) if (dvat(fx, out, sizeof out, all[k]) != 2) { allrc = 0; printf("INFO\tgitargs case %d rc mismatch\n", k + 1); }
              ck(allrc, "gitargs-help-unknown-missing-empty-signature-all-rc2");
              (void)dvat(fx, out, sizeof out, a6); ck(has("说明首行必须是正文,署名放最后空行后"), "gitargs-signature-first-line-named-hint"); }
            okc = cap2(sv, fx, h1, sizeof h1) == 0 && cap2(dd, fx, i1, sizeof i1) == 0 && !strcmp(h0, h1) && !strcmp(i0, i1);
            ck(okc, "gitargs-rejected-leave-head-and-index-unchanged");
            if (setenv("DEVSVC_GIT_PARSE_ONLY", "1", 1)) return 2;
            { char *g1[] = {"git", "commit", "-m", "正文首行\n\nCo-Authored-By: C <c@d>", "--whole", "staged.txt", "--push", 0}, *g2[] = {"git", "commit", "-m", "body", "--keyed", "p", "k1,k2", 0};
              ck(dvat(fx, out, sizeof out, g1) == 0 && has("GIT_ARGS_OK") && dvat(fx, out, sizeof out, g2) == 0 && has("GIT_ARGS_OK"), "gitargs-legal-args-pass-parse"); }
            (void)unsetenv("DEVSVC_GIT_PARSE_ONLY"); }
    ck(dv1("ping", 0, 0, 0, 0, 0) == 3, "ping-without-instance-rc3");
    /* 作业目录清理夹具:旧的已结束(rc 回拨 25 小时)、新的已结束、无 rc 的在途,另放一个非作业名目录 */
    {   const char *names[4] = {"100-1", "200-2", "300-3", "not-a-job"}; int i;
        for (i = 0; i < 4; i++) {
            char d[300], p[340]; F(d, sizeof d, "%s/jobs/%s", inst, names[i]); F(p, sizeof p, "%s/rc", d);
            if (sy_mkdir_all(d, 0700) || (i != 2 && sy_write_atomic(p, "0\t1\n", 4, 0644))) printf("NOTE\tgc-fixture\t%s\n", d);
            if (i == 0 || i == 3) (void)sy_set_mtime(p, sy_wall_s() - 90000);
        } }
    /* flow 运行目录回收夹具:老目录(无进程引用)、老目录(有进程在命令行引用)、新目录、老的非目录同名文件;年龄阈值调到 7100 s */
    char fo[300], fr[300], fn[300], ff[300], ptmp[260]; sy_child_t refc; int refup = 0;
    F(ptmp, sizeof ptmp, "/tmp/devsvc-check-%d-tmp", sy_pid()); (void)sy_mkdir_all(ptmp, 0700);   /* 私有 TMPDIR:真实 /tmp 里旧目录多,每次 200 个的上限会先耗尽 */
    F(fo, sizeof fo, "%s/devsvc-flow-chk-old", ptmp); F(fr, sizeof fr, "%s/devsvc-flow-chk-ref", ptmp);
    F(fn, sizeof fn, "%s/devsvc-flow-chk-new", ptmp); F(ff, sizeof ff, "%s/devsvc-flow-chk-file", ptmp);
    {   char sc[400]; static char *rv[4]; sy_spawn_t o;
        if (sy_mkdir_all(fo, 0700) || sy_mkdir_all(fr, 0700) || sy_mkdir_all(fn, 0700) || sy_write_atomic(ff, "x\n", 2, 0644)) printf("NOTE\tflowdir-fixture\n");
        (void)sy_set_mtime(fo, sy_wall_s() - 8000); (void)sy_set_mtime(fr, sy_wall_s() - 8000); (void)sy_set_mtime(ff, sy_wall_s() - 8000);
        F(sc, sizeof sc, "sleep 25 # %s", fr);
        rv[0] = "sh"; rv[1] = "-c"; rv[2] = sc; rv[3] = 0;
        sy_spawn_init(&o); o.argv = rv; o.deadline_ms = 25000; o.out_fd = SY_STDIO_NULL; o.err_fd = SY_STDIO_NULL;
        refup = sy_proc_spawn(&o, &refc) == 0; sy_sleep_ms(200);
        if (setenv("DEVSVC_FLOWDIR_GC_AGE_S", "7100", 1) || setenv("DEVSVC_FLOWDIR_GC_DIR", ptmp, 1)) return 2; }
    ck(dv1("start", "--ttl", "120", "--idle", "100", 0) == 0 && has("OK\tstarted"), "start");
    (void)unsetenv("DEVSVC_FLOWDIR_GC_DIR"); (void)unsetenv("DEVSVC_FLOWDIR_GC_AGE_S");
    sy_sleep_ms(400);
    {   char d0[300], d1[300], d2[300], d3[300];
        F(d0, sizeof d0, "%s/jobs/100-1", inst); F(d1, sizeof d1, "%s/jobs/200-2", inst); F(d2, sizeof d2, "%s/jobs/300-3", inst); F(d3, sizeof d3, "%s/jobs/not-a-job", inst);
        ck(sy_exists(d0) == 0, "jobs-gc-removes-done-over-24h");
        ck(sy_exists(d1) == 1 && sy_exists(d2) == 1, "jobs-gc-keeps-recent-and-running");
        ck(sy_exists(d3) == 1, "jobs-gc-ignores-non-job-dirs");
        ck(dv1("events", "--since", "0", 0, 0, 0) == 0 && has("jobs.gc\tdeleted=1"), "jobs-gc-event"); }
    ck(sy_exists(fo) == 0, "flowdir-gc-removes-old-unreferenced");
    ck(sy_exists(fr) == 1, "flowdir-gc-keeps-process-referenced");
    ck(sy_exists(fn) == 1 && sy_exists(ff) == 1, "flowdir-gc-keeps-new-and-non-dir");
    ck(dv1("events", "--since", "0", 0, 0, 0) == 0 && has("flowdir.gc\tdeleted="), "flowdir-gc-event");
    if (refup) { (void)sy_proc_kill(&refc, 9); (void)sy_proc_close(&refc); }
    { char *rm[] = {"rm", "-rf", "--", ptmp, 0}; (void)cap2(rm, 0, out2, sizeof out2); }
    /* doc create:新建、已存在拒绝、路径不在 doc 行拒绝(夹具仓无配置表,走 DEVSVC_REPO_TABLE 读本检出的 doc 行;写到夹具仓根下) */
    {   char dp[300];
        F(dp, sizeof dp, "%s/plans/dvchk.md", fx);

        {   char pd[300]; F(pd, sizeof pd, "%s/plans", fx); (void)sy_mkdir_all(pd, 0755); }
        {   char *v[] = {"doc", "create", "plans/dvchk.md", "标题 一", 0}; int rr = dvat(fx, out, sizeof out, v);
            unsigned char *b = 0; int64_t n = 0; int okb = !sy_read_file(dp, &b, &n, 1 << 12) && b && n == (int64_t)strlen("# 标题 一\n") && !memcmp(b, "# 标题 一\n", n);
            if (b) free(b);
            ck(rr == 0 && has("DOC\tcreate\tok") && okb, "doc-create-ok"); }
        {   char *v[] = {"doc", "create", "plans/dvchk.md", "另一个", 0}; int rr = dvat(fx, out, sizeof out, v);
            ck(rr == 1 && has("refused") && has("EEXIST"), "doc-create-existing-refused"); }
        {   char *v[] = {"doc", "create", "notdoc/x.txt", "T", 0}; int rr = dvat(fx, out, sizeof out, v); char np[300];
            F(np, sizeof np, "%s/notdoc/x.txt", fx);
            ck(rr == 1 && has("EDOC") && sy_exists(np) == 0, "doc-create-non-doc-path-refused"); } }
    /* x 完成事件取工具名:kind=x.<工具名>,跳过 sh、产品、目录与 .cx 后缀 */
    {   char *v[] = {"x", "--", "sh", prod, "tools/no-such-tool-xyz.cx", 0}; (void)dv(out, sizeof out, v);
        char *w[] = {"x", "--", "true", 0}; (void)dv(out, sizeof out, w);
        ck(dv1("events", "--since", "0", 0, 0, 0) == 0 && has("\tx.no-such-tool-xyz\t") && has("\tx.true\t") && !has("\tx.--\t"), "x-event-kind-is-tool-name"); }
    /* 子命令非零退出只透传其 rc 与输出,不报 bad x arguments;devsvc 自己的参数错仍报 */
    {   char *v[] = {"x", "--par", "1", "--", "sh", "-c", "echo child-err >&2; exit 2", 0}; int rx = dv(out, sizeof out, v);
        ck(rx == 2 && has("child-err") && has("rc=2") && !has("bad x arguments"), "x-child-rc2-passthrough-no-bad-args");
        char *w[] = {"x", "--par", "99", "--", "true", 0}; rx = dv(out, sizeof out, w);
        ck(rx == 2 && has("bad x arguments"), "x-real-arg-error-still-bad-args"); }
    ck(dv1("start", 0, 0, 0, 0, 0) == 0 && has("OK\talready"), "start-twice-already");
    ck(dv1("ping", 0, 0, 0, 0, 0) == 0 && has("OK\tpong"), "ping");
    ck(dv1("stop", 0, 0, 0, 0, 0) == 0 && has("OK\tstopping"), "a1-stop");
    }
    if (A2) {
    ck(dv1("start", "--ttl", "120", "--idle", "100", 0) == 0 && has("OK\tstarted"), "a2-start");

    /* 锁:互斥、属主、续期、过期 */
    ck(dv1("lock", "acquire", "registry", "--owner", "A", 0) == 0 && has("OK\tacquired\tregistry"), "lock-acquire");
    ck(dv1("lock", "acquire", "registry", "--owner", "B", 0) == 1 && has("ERR\theld\tregistry\towner=A"), "lock-second-owner-refused");
    ck(dv1("lock", "acquire", "registry", "--owner", "A", 0) == 0 && has("OK\trenewed"), "lock-same-owner-renews");
    ck(dv1("lock", "release", "registry", "--owner", "B", 0) == 1 && has("ERR\tnot-owner"), "lock-release-not-owner");
    ck(dv1("lock", "list", 0, 0, 0, 0) == 0 && has("LOCK\tregistry\towner=A"), "lock-list");
    ck(dv1("lock", "release", "registry", "--owner", "A", 0) == 0 && has("OK\treleased"), "lock-release");
    ck(dv1("lock", "release", "registry", "--owner", "A", 0) == 1 && has("ERR\tnot-held"), "lock-release-twice-not-held");
    ck(dv1("lock", "acquire", "registry", "--owner", "B", 0) == 0, "lock-free-after-release");
