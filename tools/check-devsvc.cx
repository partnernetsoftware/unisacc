    }
    }
    if (B3) {
    /* cx-dev 事件预建的自动拉起(cxdev_kick):夹具 bundle 里的 cx-dev 是个替身脚本(写 watch.lock、把参数与 CXDEV_EVENTS 记进 launches、
       exec sleep 25 后自然结束),所以这里断言的是 devsvc 一侧:何时拉起、带什么、不重复拉起;真 cx-dev 的事件过滤在 check-cx-dev 里。 */
    {   char bd[200], p[300], src[300], want[300]; unsigned char *b = 0; int64_t n = 0; int i, lines; long wpid = 0;
        static const char *fake = "#!/bin/sh\nd=$(dirname \"$0\")\necho $$ > \"$d/watch.lock\"\necho \"launch $* ev=$CXDEV_EVENTS\" >> \"$d/launches\"\nexec sleep 25\n";
        F(bd, sizeof bd, "/tmp/devsvc-check-%d-bundle", sy_pid()); F(src, sizeof src, "%s/src.txt", bd);
        F(p, sizeof p, "%s/cx-dev", bd);
        ck(sy_mkdir_all(bd, 0700) == 0 && sy_write_atomic(p, fake, strlen(fake), 0700) == 0 && sy_write_atomic(src, "k\tv\n", 4, 0600) == 0, "cxdev-kick-fixture-bundle");
        if (setenv("CXDEV_HOME", bd, 1)) return 2;
        F(p, sizeof p, "%s/launches", bd);
        /* bundle 没构造完(缺 ape.id):写 exec 表不拉起 */
        ck(fx1("f", "write", "exec/t0.tsv", "--from", src, "--mkdir") == 0 && has("F\twrite\tok"), "cxdev-kick-exec-write-ok-without-bundle");
        sy_sleep_ms(400);
        ck(sy_exists(p) == 0, "cxdev-kick-not-started-without-built-bundle");
        {   char ap[300]; F(ap, sizeof ap, "%s/ape.id", bd); ck(sy_write_atomic(ap, "x\n", 2, 0600) == 0, "cxdev-kick-fixture-ape-id"); }
        /* 写非表输入:不拉起 */
        ck(fx1("f", "write", "notes/a.txt", "--from", src, "--mkdir") == 0 && has("F\twrite\tok"), "cxdev-kick-other-write-ok");
        sy_sleep_ms(400);
        ck(sy_exists(p) == 0, "cxdev-kick-not-started-by-non-input-write");
        /* 写 exec 表:拉起一个,参数 --watch,CXDEV_EVENTS 指向本实例 events.tsv */
        ck(fx1("f", "write", "exec/t.tsv", "--from", src, "--mkdir") == 0 && has("F\twrite\tok"), "cxdev-kick-exec-write-ok");
        for (i = 0; i < 60 && sy_exists(p) != 1; i++) sy_sleep_ms(50);
        F(want, sizeof want, "launch --watch ev=%s/events.tsv\n", inst);
        lines = 0; if (sy_read_file(p, &b, &n, 1 << 16) == 0 && b) { F(out, sizeof out, "%.*s", (int)n, (char *)b); for (i = 0; i < n; i++) lines += b[i] == '\n'; free(b); b = 0; } else out[0] = 0;
        ck(lines == 1 && !strcmp(out, want), "cxdev-kick-started-once-with-watch-and-events");
        {   char lp[300]; F(lp, sizeof lp, "%s/watch.lock", bd); if (sy_read_file(lp, &b, &n, 64) == 0 && b) { wpid = atol((char *)b); free(b); b = 0; } }
        ck(dv1("events", 0, 0, 0, 0, 0) == 0 && has("\tcxdev.watch\tstarted\tpid=") && has("\ttrigger=exec/t.tsv\t"), "cxdev-kick-event-recorded");
        /* 已有在跑的:再写两次(write 与 edits 路径同一出口)不重复拉起 */
        ck(fx1("f", "write", "exec/t.tsv", "--from", src, 0) == 0 && fx1("f", "write", "seed/s.tsv", "--from", src, "--mkdir") == 0, "cxdev-kick-second-writes-ok");
        sy_sleep_ms(400);
        lines = 0; if (sy_read_file(p, &b, &n, 1 << 16) == 0 && b) { for (i = 0; i < n; i++) lines += b[i] == '\n'; free(b); b = 0; }
        ck(wpid > 1 && lines == 1, "cxdev-kick-not-started-twice-while-running");
        /* 关闭开关生效;那个进程没了之后,下一次表写入重新拉起 */
        if (wpid > 1) { char ks[32]; F(ks, sizeof ks, "%ld", wpid); char *kv[] = {"kill", "-9", ks, 0}; (void)cap2(kv, 0, out2, sizeof out2); }
        {   char pp[64]; F(pp, sizeof pp, "/proc/%ld", wpid); for (i = 0; i < 60 && sy_exists(pp) == 1; i++) sy_sleep_ms(50); }
        if (setenv("DEVSVC_CXDEV_WATCH", "0", 1)) return 2;
        ck(fx1("f", "write", "exec/t.tsv", "--from", src, 0) == 0, "cxdev-kick-switch-off-write-ok");
        sy_sleep_ms(400);
        lines = 0; if (sy_read_file(p, &b, &n, 1 << 16) == 0 && b) { for (i = 0; i < n; i++) lines += b[i] == '\n'; free(b); b = 0; }
        ck(lines == 1, "cxdev-kick-switch-off-not-started");
        if (unsetenv("DEVSVC_CXDEV_WATCH")) return 2;
        ck(fx1("f", "write", "exec/t.tsv", "--from", src, 0) == 0, "cxdev-kick-after-exit-write-ok");
        for (i = 0; i < 60; i++) { lines = 0; if (sy_read_file(p, &b, &n, 1 << 16) == 0 && b) { int j; for (j = 0; j < n; j++) lines += b[j] == '\n'; free(b); b = 0; } if (lines >= 2) break; sy_sleep_ms(50); }
        ck(lines == 2, "cxdev-kick-restarted-after-watcher-gone");
        {   char lp[300]; long np = 0; F(lp, sizeof lp, "%s/watch.lock", bd); if (sy_read_file(lp, &b, &n, 64) == 0 && b) { np = atol((char *)b); free(b); b = 0; }
            if (np > 1 && np != wpid) { char ks[32]; F(ks, sizeof ks, "%ld", np); char *kv[] = {"kill", "-9", ks, 0}; (void)cap2(kv, 0, out2, sizeof out2); } }
        if (unsetenv("CXDEV_HOME")) return 2;
        { char *rm[] = {"rm", "-rf", bd, 0}; ck(cap2(rm, 0, out2, sizeof out2) == 0, "cxdev-kick-fixture-cleanup"); }
    }

    }
    if (B2) {
    /* run(在私有夹具仓里):经服务与直接运行一致;首次构造,第二次命中缓存,--local 共用缓存 */
    {   char *d[] = {"sh", prod, "echo.cx", "--", "a b", "c", 0}; int rd, rs; char *q;
        rd = cap2(d, fx, out2, sizeof out2);
        rs = fx1("run", "echo.cx", "a b", "c", 0, 0);
        q = strstr(out, "DEVSVC_RUN\t");
        ck(q && strstr(q, "via=service") && strstr(q, "cache=miss"), "run-first-builds");
        if (q) *q = 0;
