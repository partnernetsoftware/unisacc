    /* idle 到点自退 */
    ck(dv1("start", "--ttl", "100", "--idle", "2", 0) == 0 && has("OK\tstarted"), "restart-idle2");
    sy_sleep_ms(2800);
    ck(dv1("ping", 0, 0, 0, 0, 0) == 3 && sy_exists(sock) == 0, "idle-self-exit");
    {   char *v[] = {"start", "--ttl", "99999", 0};
        ck(dv(out, sizeof out, v) == 2, "ttl-over-cap-refused"); }
    (void)t0;
    }
    }
    if (B1 || B2 || B3) {
        if (setenv("DEVSVC_EV_ROTATE", "1500", 1) || setenv("DEVSVC_OWNER", "chk-owner", 1)) return 2;
        ck(dv1("start", "--ttl", "120", "--idle", "100", 0) == 0 && has("OK\tstarted"), "run-group-start"); }
    if (B1) {
    /* 事件落盘(实例目录 events.tsv,带 owner,超阈值轮转)与只读 git 透传(不取锁)(b 组) */
    {   char ep[200], ep1[200]; unsigned char *b = 0; int64_t n = 0, sz = 0; int i, got;
        F(ep, sizeof ep, "%s/events.tsv", inst); F(ep1, sizeof ep1, "%s/events.tsv.1", inst);
        ck(dv1("git", "log", "-1", "--oneline", 0, 0) == 0 && strlen(out) > 8 && !has("REFUSE"), "git-log-readonly");
        ck(dv1("git", "diff", "--stat", "HEAD", 0, 0) == 0 && !has("REFUSE"), "git-diff-stat-readonly");
        ck(dv1("lock", "list", 0, 0, 0, 0) == 0 && has("OK\tlocks") && !has("owner=chk-owner"), "git-readonly-takes-no-lock");
