/* Generated by tools/code-gen.cx. Narrow check of stage codes. */
int main(void) {
    const char *name;
    const char *other;
    const char *official;
    const char *code;
    const char *end;
    const char *rest;
    const char **missing;
    int i, j, hit_end, hit_rest, seen, differ;
    missing = 0;
    if (scn_count() != 7) return 1;
    if (scn_at(0, &name) || !tx_eqz(name, "e2")) return 1;
    if (scn_at(1, &name) || !tx_eqz(name, "e1")) return 1;
    if (scn_at(2, &name) || !tx_eqz(name, "e3")) return 1;
    if (scn_at(3, &name) || !tx_eqz(name, "e4")) return 1;
    if (scn_at(4, &name) || !tx_eqz(name, "prune")) return 1;
    if (scn_at(5, &name) || !tx_eqz(name, "lower")) return 1;
    if (scn_at(6, &name) || !tx_eqz(name, "elf")) return 1;
    if (scn_at(0, missing) != 4) return 1;
    if (scn_at(-1, &name) != 2) return 1;
    if (scn_at(7, &name) != 2) return 1;
    if (rsc_count() != 7) return 1;
    if (rsc_at(0, &name) || !tx_eqz(name, "e2")) return 1;
    if (rsc_at(1, &name) || !tx_eqz(name, "e1")) return 1;
    if (rsc_at(2, &name) || !tx_eqz(name, "e3")) return 1;
    if (rsc_at(3, &name) || !tx_eqz(name, "e4")) return 1;
    if (rsc_at(4, &name) || !tx_eqz(name, "prune")) return 1;
    if (rsc_at(5, &name) || !tx_eqz(name, "lower")) return 1;
    if (rsc_at(6, &name) || !tx_eqz(name, "elf")) return 1;
    if (rsc_at(0, missing) != 4) return 1;
    if (rsc_at(-1, &name) != 2) return 1;
    if (rsc_at(7, &name) != 2) return 1;
    if (sn_count() != 7) return 1;
    differ = 0;
    for (i = 0; i < scn_count(); i++) {
        if (scn_at(i, &name)) return 1;
        if (rsc_at(i, &other)) return 1;
        if (!tx_eqz(name, other)) return 1;
        if (sn_at(i, &official, &code)) return 1;
        if (!tx_eqz(name, code)) return 1;
        if (!tx_eqz(name, official)) differ = 1;
    }
    if (!differ) return 1;
    if (lsn_count() + nst_count() != scn_count()) return 1;
    for (i = 0; i < scn_count(); i++) {
        hit_end = 0;
        hit_rest = 0;
        if (scn_at(i, &name)) return 1;
        for (j = 0; j < lsn_count(); j++) {
            if (lsn_at(j, &end)) return 1;
            if (tx_eqz(end, name)) hit_end = 1;
        }
        for (j = 0; j < nst_count(); j++) {
            if (nst_at(j, &rest)) return 1;
            if (tx_eqz(rest, name)) hit_rest = 1;
        }
        if (hit_end == hit_rest) return 1;
    }
    for (j = 0; j < lsn_count(); j++) {
        seen = 0;
        if (lsn_at(j, &end)) return 1;
        for (i = 0; i < scn_count(); i++) {
            if (scn_at(i, &name)) return 1;
            if (tx_eqz(name, end)) seen = 1;
        }
        if (!seen) return 1;
    }
    for (j = 0; j < nst_count(); j++) {
        seen = 0;
        if (nst_at(j, &rest)) return 1;
        for (i = 0; i < scn_count(); i++) {
            if (scn_at(i, &name)) return 1;
            if (tx_eqz(name, rest)) seen = 1;
        }
        if (!seen) return 1;
    }
    sy_printf("CX_CODE\tok=7\tfailed=0\n");
    return 0;
}
