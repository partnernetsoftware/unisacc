/* tools/check-iface-gap.cx -- every name the interface tables declare must still be declared by the product.
 *
 *   sh ./unisacc.com tools/check-iface-gap.cx [-- ROOT [PRODUCT]]
 *
 * Why: a declared interface that outlives its implementation is invisible until something calls it.
 * 2026-11-12 the commit that landed sy_mkdtemp's callers left cx/sys/fs.cx itself in a staging area, so main
 * carried tests/core-interface.tsv and build/layer-api/cx.base.tsv rows for a function no file defined, and
 * s9's tool state went red with no single gate naming it.  This check names it.
 *
 * Oracle: the product's own `-cx-interface FILE`, not source text.  R4-source-anchor refuses substring
 * matching over source, and the product's answer is the fact the tables are supposed to describe anyway, so
 * a declaration that vanished shows up here.
 *
 * Inputs (facts, read as tables):
 *   build/layer-api/PKG.tsv   name<TAB>signature<TAB>sig_sha<TAB>file   -- signature must be declared by FILE
 *   tests/core-interface.tsv  PATH<TAB>SYMBOL<TAB>SIGNATURE<TAB>MARK    -- SYMBOL must be declared by PATH
 *
 * Comparison: the product's declaration and the table signature are both whitespace-collapsed with the
 * trailing ';' dropped, so a definition the product prints on one long line matches a signature written
 * across several.  A row whose table signature was truncated with an ellipsis, or that is a typedef/enum
 * rather than a function, is matched by name only: the product renders those per target and the tables avoid
 * pinning that (cx/sys/sysnums.cx expands per target).
 *
 * Output: one IFACE_GAP<TAB>gap<TAB>kind<TAB>package<TAB>name<TAB>file<TAB>why line per missing name, then
 * IFACE_GAP<TAB>summary<TAB>calls=N<TAB>layer_rows=N<TAB>core_rows=N<TAB>missing=K.  Exit 0 only when K is 0
 * and the controls pass; exit 2 on bad usage or an unreadable input.
 *
 * Controls (a bare "no gap" would also pass if the scan were broken): a private tree under $TMPDIR with two
 * declared names of which the file defines one must report exactly the other; a table naming a file that is
 * not there must report file-absent; a typedef row must be matched by name.  They run before the real tree.
 *
 * Honest scope: the controls prove the three shapes are caught (a declaration the product no longer prints,
 * a table naming a file that is not there, a typedef row judged by name).  There is no historical tree that
 * reproduces the 2026-11-12 incident itself, so this check has never caught that event on a real main; all
 * it can say is that the shape it took would be named now.  The first version of this check matched source
 * text and reported 224 false positives from multi-line signatures and typedef guts; taking the product's
 * -cx-interface as the oracle is what made it exact.
 *
 * Check: this file is the check (batch iface-gap). */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.posix
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

static int failed;
static char root[4096];
static char product[4400];
static int layer_rows, core_rows, calls;

/* Output of the current pass, or 0 to print immediately. */
static char *sink;
static size_t sinkcap, sinkn;

static void ck(int ok, const char *name) {
    if (!ok) failed++;
    sy_printf("%s\tiface-gap.%s\n", ok ? "PASS" : "FAIL", name);
}

static void die(const char *what, const char *detail) {
    if (detail && detail[0]) sy_eprintf("check-iface-gap: %s: %s\n", what, detail);
    else sy_eprintf("check-iface-gap: %s\n", what);
    exit(2);
}

static void emit(const char *s, size_t n) {
    if (!sink || sinkn + n + 1 > sinkcap) { sy_printf("%.*s", (int)n, s); return; }
    mm_copy(sink + sinkn, sinkcap - sinkn, s, n);
    sinkn += n;
    sink[sinkn] = 0;
}

static void emit_gap(const char *kind, const char *pkg, const char *name, const char *file, const char *why) {
    char line[8192];
    int n = snprintf(line, sizeof line, "IFACE_GAP\tgap\t%s\t%s\t%s\t%s\t%s\n", kind, pkg, name, file, why);
    if (n > 0) emit(line, (size_t)n < sizeof line ? (size_t)n : sizeof line - 1);
}

/* Collapse whitespace runs to one space and drop the trailing ';' the tables carry; NUL-terminated. */
static long squash(const char *s, long n, char *dst, long cap) {
    long i = 0, o = 0;
    int gap = 0;
    while (i < n) {
        char c = s[i++];
        if (c == ' ' || c == '\t' || c == '\r' || c == '\n') { gap = o > 0; continue; }
        if (gap && o + 1 < cap) dst[o++] = ' ';
        gap = 0;
        if (o + 1 < cap) dst[o++] = c;
    }
    while (o > 0 && (dst[o - 1] == ';' || dst[o - 1] == ' ')) o--;
    if (o < cap) dst[o] = 0;
    return o;
}

/* The declarations the product prints for FILE, with its header comment, include guard and # lines dropped.
   malloc'd with *N bytes, or 0 when the product refuses the file. */
static char *declared(const char *file, long *n_out) {
    char *v[5], *t = 0, *body;
    size_t tn = 0;
    long i = 0, o = 0;
    int rc;
    calls++;
    v[0] = "sh";
    v[1] = product;
    v[2] = "-cx-interface";
    v[3] = (char *)file;
    v[4] = 0;
    rc = cx_runv_timeout(v, 40, &t, &tn);
    if (rc != 0 || !t) { free(t); return 0; }
    body = mm_alloc((long)tn + 1);
    if (!body) { free(t); return 0; }
    while (i < (long)tn) {
        long e = i;
        int keep = 1;
        while (e < (long)tn && t[e] != '\n') e++;
        if (e > i) {
            if (t[i] == '#' || (e - i > 2 && t[i] == '/' && t[i + 1] == '*')) keep = 0;
            if (keep) {
                mm_copy(body + o, (long)tn + 1 - o, t + i, (size_t)(e - i));
                o += e - i;
                body[o++] = '\n';
            }
        }
        i = e < (long)tn ? e + 1 : e;
    }
    body[o] = 0;
    free(t);
    *n_out = o;
    return body;
}

/* Local byte scans.  This check compares a table row against the product's own -cx-interface text, so it
   owns these two searches instead of leaning on text.text: R4-source-anchor has to refuse a substring search
   whose argument is not a TSV path, and that refusal is right for source anchors.  A plain scan says exactly
   what is meant here — no provenance claim, just bytes. */
static int has_byte(const char *s, long n, char c) {
    long i;
    for (i = 0; i < n; i++) if (s[i] == c) return 1;
    return 0;
}

static int has_run(const char *s, long n, const char *p, long pn) {
    long i, j;
    if (pn <= 0 || n < pn) return 0;
    for (i = 0; i + pn <= n; i++) {
        for (j = 0; j < pn && s[i + j] == p[j]; j++) { }
        if (j == pn) return 1;
    }
    return 0;
}

/* Does the product's text DECL carry this row?  1 yes, 0 no, -1 too large to judge. */
static int row_present(const char *decl, long dn, const char *name, const char *sig, int name_only) {
    static char norm_decl[1048576], norm_sig[16384];
    const char *probe = name;
    long sl = (long)tx_len(sig, 16384), nd;
    int func = has_byte(sig, sl, '(') && !has_run(sig, sl, "...", 3);
    if (name_only || !func) {
        if (!strncmp(name, "enum:", 5)) probe = name + 5;
        return has_run(decl, dn, probe, (long)tx_len(probe, 512));
    }
    nd = squash(decl, dn, norm_decl, (long)sizeof norm_decl);
    if (nd >= (long)sizeof norm_decl) return -1;
    squash(sig, sl, norm_sig, (long)sizeof norm_sig);
    return has_run(norm_decl, nd, norm_sig, (long)tx_len(norm_sig, 16384));
}

/* One table's rows.  NAME_FIELD/SIG_FIELD/FILE_FIELD index its tab fields; ROWS_OUT accumulates. */
static int scan_table(const char *t, long tn, const char *kind, const char *pkg, int name_field, int sig_field,
                      int file_field, int name_only, int *rows_out) {
    long i = 0;
    int missing = 0, rows = 0;
    while (i < tn) {
        long e = i, f[8], fl[8];
        int nf = 0, k;
        while (e < tn && t[e] != '\n') e++;
        if (e > i && t[i] != '#' && t[i] != '@') {
            char name[512], sig[16384], file[1024];
            for (k = 0; k < 8; k++) if (!tx_field(t + i, e - i, '\t', k, &f[k], &fl[k])) nf = k + 1;
            if (nf > name_field && nf > sig_field && nf > file_field && fl[name_field] > 0 && fl[name_field] < 511 &&
                fl[sig_field] < 16383 && fl[file_field] > 0 && fl[file_field] < 1023) {
                char path[4400], *decl;
                long dn = 0;
                mm_copy(name, sizeof name, t + i + f[name_field], (size_t)fl[name_field]);
                name[fl[name_field]] = 0;
                mm_copy(sig, sizeof sig, t + i + f[sig_field], (size_t)fl[sig_field]);
                sig[fl[sig_field]] = 0;
                mm_copy(file, sizeof file, t + i + f[file_field], (size_t)fl[file_field]);
                file[fl[file_field]] = 0;
                rows++;
                if (cx_fmt(path, sizeof path, "%s/%s", root, file)) { emit_gap(kind, pkg, name, file, "path-bound"); missing++; }
                else if (sy_exists(path) != 1) { emit_gap(kind, pkg, name, file, "file-absent"); missing++; }
                else if (!(decl = declared(file, &dn))) { emit_gap(kind, pkg, name, file, "product-refused"); missing++; }
                else {
                    int h = row_present(decl, dn, name, sig, name_only);
                    if (h < 0) { emit_gap(kind, pkg, name, file, "too-large-to-check"); missing++; }
                    else if (!h) { emit_gap(kind, pkg, name, file, "no-declaration"); missing++; }
                    mm_free(decl);
                }
            }
        }
        i = e < tn ? e + 1 : e;
    }
    *rows_out += rows;
    return missing;
}

/* Every package table of build/layer-api, each row judged against its own file. */
static int scan_layer(void) {
    char dir[4400], names[65536];
    int fd, cnt, pos = 0, missing = 0;
    if (cx_fmt(dir, sizeof dir, "%s/build/layer-api", root)) die("path bound", root);
    fd = sy_open(dir, O_RDONLY, 0);
    if (fd < 0) die("unreadable layer-api dir", dir);
    cnt = sy_dir_names(fd, names, (int)sizeof names);
    sy_close(fd);
    if (cnt <= 0) die("empty layer-api dir", dir);
    while (pos < (int)sizeof names && cnt > 0) {
        long len = tx_len(names + pos, (long)sizeof names - pos);
        char rel[1024], pkg[128], *t;
        size_t tn = 0;
        if (len <= 0) break;
        if (len > 4 && !strcmp(names + pos + len - 4, ".tsv") && !cx_fmt(rel, sizeof rel, "%s/build/layer-api/%s", root, names + pos)) {
            if (cx_fmt(pkg, sizeof pkg, "%s", names + pos)) die("path bound", rel);
            {
                long q;
                for (q = 0; pkg[q]; q++) if (pkg[q] == '.') { pkg[q] = 0; break; }
            }
            t = cx_read(rel, &tn);
            if (!t) die("unreadable layer-api table", rel);
            missing += scan_table(t, (long)tn, "layer", pkg, 0, 1, 3, 0, &layer_rows);
            free(t);
        }
        pos += (int)len + 1;
        cnt--;
    }
    return missing;
}

static int scan_core(void) {
    char rel[1024], *t;
    size_t tn = 0;
    int m;
    if (cx_fmt(rel, sizeof rel, "%s/tests/core-interface.tsv", root)) die("path bound", root);
    t = cx_read(rel, &tn);
    if (!t) die("unreadable core interface", rel);
    m = scan_table(t, (long)tn, "core", "core-interface", 1, 2, 0, 1, &core_rows);
    free(t);
    return m;
}

static int pass(char *sinkbuf, size_t cap) {
    int missing;
    sink = sinkbuf;
    sinkcap = cap;
    sinkn = 0;
    if (sinkbuf && cap) sinkbuf[0] = 0;
    layer_rows = core_rows = calls = 0;
    if (sy_chdir(root)) die("cannot enter ROOT", root);
    missing = scan_layer() + scan_core();
    return missing;
}

static int has(const char *w) { return sink && strstr(sink, w) != 0; }

static void put(const char *dir, const char *leaf, const char *text) {
    char p[4400];
    if (cx_fmt(p, sizeof p, "%s/%s", dir, leaf)) die("path bound", leaf);
    if (cx_write(p, text, strlen(text))) die("cannot write fixture", p);
}

int main(int argc, char **argv) {
    char work[4400], real_root[4096], real[4400], out[65536];
    char fx[4400], fxt[4400], fxc[4400];
    int i, k = 0, missing;
    for (i = 1; i < argc; i++) {
        if (!strcmp(argv[i], "--")) continue;
        if (k++ > 1) die("usage", "[--] [ROOT [PRODUCT]]");
        if (k == 1) { if (sy_realpath(argv[i], real_root, sizeof real_root) < 0) die("unreadable ROOT", argv[i]); }
        else if (cx_fmt(product, sizeof product, "%s", argv[i])) die("path bound", argv[i]);
    }
    if (k == 0 && sy_realpath(".", real_root, sizeof real_root) < 0) die("unreadable cwd", 0);
    if (k < 2) {
        if (cx_fmt(product, sizeof product, "%s/unisacc.com", real_root) || sy_realpath(product, real, sizeof real) < 0)
            die("unreadable product", product);
        if (cx_fmt(product, sizeof product, "%s", real)) die("path bound", real);
    }

    /* Controls first: a scan that found nothing would otherwise look exactly like a clean tree. */
    if (cx_fmt(work, sizeof work, "%s/check-iface-gap-%d", sy_tmpdir(), sy_pid())) die("path bound", sy_tmpdir());
    if (sy_mkdir_all(work, 0700) || cx_fmt(fx, sizeof fx, "%s/build/layer-api", work) || sy_mkdir_all(fx, 0700) ||
        cx_fmt(fxt, sizeof fxt, "%s/tests", work) || sy_mkdir_all(fxt, 0700)) die("cannot build fixture", work);
    put(work, "one.cx", "int fx_here(int a) { return a; }\n");
    put(work, "build/layer-api/fx.tsv",
        "# name\tsignature\tsig_sha\tfile\n"
        "fx_here\tint fx_here(int a);\tdeadbeef\tone.cx\n"
        "fx_absent\tint fx_absent(int a);\tdeadbeef\tone.cx\n");
    put(work, "tests/core-interface.tsv", "# PATH\tSYMBOL\tSIGNATURE\tMARK\none.cx\tfx_here\tint (int a)\t-\n");
    if (cx_fmt(root, sizeof root, "%s", work)) die("path bound", work);
    missing = pass(out, sizeof out);
    ck(missing == 1 && has("IFACE_GAP\tgap\tlayer\tfx\tfx_absent\tone.cx\tno-declaration"),
       "control-absent-declaration-reported");
    ck(!has("fx_here\t"), "control-present-declaration-not-reported");
    ck(layer_rows == 2 && core_rows == 1, "control-row-counts-follow-the-table");

    /* A table naming a file that is not there must be named as such, not silently skipped. */
    put(work, "tests/core-interface.tsv", "");
    put(work, "build/layer-api/fx.tsv", "# name\tsignature\tsig_sha\tfile\nfx_gone\tint fx_gone(void);\tdeadbeef\tmissing.cx\n");
    missing = pass(out, sizeof out);
    ck(missing == 1 && has("IFACE_GAP\tgap\tlayer\tfx\tfx_gone\tmissing.cx\tfile-absent"),
       "control-absent-file-named");

    /* A typedef row is matched by name: the product renders its guts per target. */
    put(work, "one.cx", "typedef struct { int a; } fx_t;\nint fx_live(void) { return 1; }\n");
    put(work, "build/layer-api/fx.tsv", "# name\tsignature\tsig_sha\tfile\nfx_t\ttypedef struct { int a; } fx_t;\tdeadbeef\tone.cx\nfx_live\tint fx_live(void);\tdeadbeef\tone.cx\n");
    missing = pass(out, sizeof out);
    ck(missing == 0, "control-typedef-and-function-both-judged");
    (void)cx_rmtree(work);

    /* The real tree. */
    if (cx_fmt(root, sizeof root, "%s", real_root)) die("path bound", real_root);
    missing = pass(0, 0);
    sy_chdir(root);
    sy_printf("IFACE_GAP\tsummary\tcalls=%d\tlayer_rows=%d\tcore_rows=%d\tmissing=%d\n",
              calls, layer_rows, core_rows, missing);
    sy_printf("CHECK_IFACE_GAP\tfailed=%d\n", failed);
    return (missing || failed) ? 1 : 0;
}
