/* tools/check-proc-own-sat.cx -- S1b-3: 64-slot saturation, end-timeout, and TSV row check. */
#pragma unisa use sys.proc
#pragma unisa use sys.posix

static int failed;

static void ck_sat(int ok, const char *name) {
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", name);
    if (!ok) failed++;
}

int main(void) {
    sy_spawn_t sp;
    sy_child_t kids[64], extra, c;
    sy_exit_t st;
    char *av_sleep[3];
    char *av_true[2];
    char pidbuf[32];
    int i, rc, ok64 = 1, live = 0, ab = 0, lost = 0;

    av_true[0] = "true"; av_true[1] = 0;
    sy_spawn_init(&sp);
    sp.argv = av_true;
    setenv("UNISACC_PROC_INJECT_WAIT_ERR", "1", 1);
    rc = sy_proc_spawn(&sp, &c);
    rc = (rc == 0) ? sy_proc_wait(&c, &st) : rc;
    unsetenv("UNISACC_PROC_INJECT_WAIT_ERR");
    sy_proc_close(&c);
    ck_sat(rc == 0, "S1e-b4-unarmed-env-ignored");
    ck_sat(sy_proc_test_events_count() == 0, "S1e-unarmed-zero-events");

    av_sleep[0] = "sleep"; av_sleep[1] = "5"; av_sleep[2] = 0;
    sy_proc_test_reset();
    unsetenv("UNISACC_PROC_INJECT_PID");
    setenv("UNISACC_PROC_INJECT_WAIT_ERR", "1", 1);
    rc = sy_proc_spawn(&sp, &c);
    rc = (rc == 0) ? sy_proc_wait(&c, &st) : rc;
    unsetenv("UNISACC_PROC_INJECT_WAIT_ERR");
    sy_proc_close(&c);
    ck_sat(rc == 0, "S1e-b4-armed-no-pid-ignored");

    rc = sy_proc_spawn(&sp, &c);
    cx_fmt(pidbuf, sizeof pidbuf, "%d", c.pid);
    setenv("UNISACC_PROC_INJECT_PID", pidbuf, 1);
    setenv("UNISACC_PROC_INJECT_WAIT_ERR", "1", 1);
    rc = (rc == 0) ? sy_proc_wait(&c, &st) : rc;
    unsetenv("UNISACC_PROC_INJECT_WAIT_ERR");
    unsetenv("UNISACC_PROC_INJECT_PID");
    sy_proc_wait(&c, &st);
    sy_proc_close(&c);
    ck_sat(rc == -EINTR, "S1e-b4-armed-exact-pid-hits");

    sy_spawn_init(&sp);
    sp.argv = av_sleep;

    for (i = 0; i < 64; i++) {
        rc = sy_proc_spawn(&sp, &kids[i]);
        if (rc != 0) ok64 = 0;
    }
    sy_proc_own_stats(&live, &ab, &lost);
    ck_sat(ok64 && live == 64, "I1-fill-64-slots");

    rc = sy_proc_spawn(&sp, &extra);
    ck_sat(rc == -EAGAIN, "I1-65th-refused-eagain");

    rc = sy_proc_end(&kids[0], 20, &st);
    sy_proc_close(&kids[0]);
    sy_proc_own_stats(&live, &ab, &lost);
    ck_sat(rc == 0 && live == 63, "I1-reap-one-frees-slot");

    rc = sy_proc_spawn(&sp, &kids[0]);
    sy_proc_own_stats(&live, &ab, &lost);
    ck_sat(rc == 0 && live == 64, "I1-respawn-takes-freed-slot");

    for (i = 0; i < 64; i++) sy_proc_kill(&kids[i], SIGKILL);
    for (i = 0; i < 64; i++) { sy_proc_wait(&kids[i], &st); sy_proc_close(&kids[i]); }
    sy_proc_own_stats(&live, &ab, &lost);
    ck_sat(live == 0 && ab == 0 && lost == 0, "I1-cleanup-all-zero");

    av_sleep[1] = "0.5";
    rc = sy_proc_spawn(&sp, &c);
    ck_sat(rc == 0, "I2-end-timeout-spawn");

    sy_proc_test_inject_syscall(1, c.pid, 45, 0);
    rc = sy_proc_end(&c, 20, &st);
    sy_proc_own_stats(&live, &ab, &lost);
    ck_sat(rc == -ETIMEDOUT && live == 1, "I2-end-timeout-keeps-slot");

    sy_proc_test_reset();
    sy_proc_close(&c);
    rc = sy_proc_own_drain(200);
    sy_proc_own_stats(&live, &ab, &lost);
    ck_sat(rc == 0 && live == 0 && ab == 0 && lost == 0, "I2-end-timeout-abandoned-drained");

    printf("CHECK_PROC_OWN_SAT\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
