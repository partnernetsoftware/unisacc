/* tools/decide-gen.cx -- compile a finite decision table into net rows.
 *
 *   sh ./unisacc.com tools/decide-gen.cx -- --write|--check [--each FIELD=v1,v2,...]... [--select REG] [--sections] TABLE PREFIX STATE OUT-result.tsv
 *
 * TABLE is a weights-style table: "#field NAME v0 v1 ..." lines, then one row per
 * key, fields first and label last.  The key is the mixed-radix number of the field
 * indexes, slowest field first.  The product of the domains must fit one r-mode
 * state (at most 257).  The mechanism computes the same number into a register and
 * does RLD; this tool writes STATE KEY PREFIX.LABEL rows, one per key, so T1 checks
 * every key against the table.  A row missing or repeated, or a key out of domain,
 * refuses.  --check compares the file byte for byte.
 *
 * --each FIELD=v1,v2,... is the two-level form for tables whose product exceeds one
 * state: FIELD is chosen statically (one state STATE.v per listed value, so the net
 * names the level-1 value in the state it enters), and the key is the mixed-radix
 * number of the remaining fields.  Every listed value must be in FIELD's domain and
 * every key of every listed state must have exactly one row; values not listed are
 * left out of the net (reported on stdout), not silently covered.  --each may be
 * given up to three times (one state STATE.v1.v2 per listed combination).
 *
 * --select REG (with one --each) is the dynamic level-1 form: the mechanism holds FIELD's
 * domain index in the register it RLDs into STATE and the level-2 key in REG; this tool
 * also writes STATE <index> STATE.<value> [["RLD","REG"]] for every listed value and
 * STATE * PREFIX.out-of-domain [], so both levels are rows T1 checks, not a pool.
 *
 * --sections (with --each) names each state's section after its level-1 values
 * (v1.v2 instead of main), so a manifest row can install one section per static
 * choice (lower: one target's rows per net) from the same generated file. */
#pragma unisa use sys.io
#pragma unisa use text.text
#define DG_MAXF 8
#define DG_MAXV 128
#define DG_MAXE 3
static char *field[DG_MAXF][DG_MAXV]; static int nvals[DG_MAXF], nfield;
static void die(const char *a, const char *b) { fprintf(stderr, "decide-gen: %s %s\n", a, b); exit(2); }
static char *slurp(const char *p) {
    FILE *f = fopen(p, "rb"); size_t cap = 1 << 24, n; char *b;
    if (!f) return 0;
    b = malloc(cap); if (!b) die("memory", p);
    n = fread(b, 1, cap - 1, f); fclose(f); b[n] = 0; return b;
}
static int sprintf_n(char *b, long c, const char *f, ...) { va_list a; int n; va_start(a, f); n = vsnprintf(b, (size_t)c, f, a); va_end(a); if (n < 0 || n >= c) die("output bound", f); return n; }
static int split(char *s, char **v, int cap) {
    int n = 0; v[n++] = s;
    while (*s) { if (*s == '\t') { *s = 0; if (n == cap) die("too many fields", v[0]); v[n++] = s + 1; } s++; }
    return n;
}
/* STATE suffix ".v1.v2" and the section name "v1.v2" of listed combination c (slowest --each first). */
static int neach, nsel[DG_MAXE], each[DG_MAXE]; static char *selname[DG_MAXE], *sel[DG_MAXE][DG_MAXV];
static void combo(long c, char *suffix, char *section, long cap) {
    long i, d, part[DG_MAXE]; long s = 0, t = 0;
    for (i = neach - 1; i >= 0; i--) { part[i] = c % nsel[i]; c /= nsel[i]; }
    for (i = 0; i < neach; i++) {
        d = sprintf_n(suffix + s, cap - s, ".%s", sel[i][part[i]]); s += d;
        d = sprintf_n(section + t, cap - t, "%s%s", i ? "." : "", sel[i][part[i]]); t += d;
    }
    if (!neach) { suffix[0] = 0; sprintf_n(section, cap, "main"); }
}
int main(int argc, char **argv) {
    int a = 2; char *selreg = 0; int sections = 0; long ncombo = 1;
    if (argc < 2 || (strcmp(argv[1], "--write") && strcmp(argv[1], "--check"))) die("usage:", "--write|--check [--each FIELD=v,...]... [--select REG] [--sections] TABLE PREFIX STATE OUT");
    while (a < argc && !strncmp(argv[a], "--", 2) && argv[a][2]) {
        if (!strcmp(argv[a], "--each") && a + 1 < argc) {
            char *eq = strchr(argv[a + 1], '=');
            if (!eq) die("--each wants FIELD=v1,v2,...", argv[a + 1]);
            if (neach == DG_MAXE) die("too many --each", argv[a + 1]);
            *eq = 0; selname[neach] = argv[a + 1]; each[neach] = -1;
            for (eq++; *eq; ) { char *c = strchr(eq, ','); if (nsel[neach] == DG_MAXV) die("too many --each values", selname[neach]); sel[neach][nsel[neach]++] = eq; if (!c) break; *c = 0; eq = c + 1; }
            ncombo *= nsel[neach]; neach++; a += 2;
        } else if (!strcmp(argv[a], "--select") && a + 1 < argc) { selreg = argv[a + 1]; a += 2; }
        else if (!strcmp(argv[a], "--sections")) { sections = 1; a++; }
        else die("unknown option", argv[a]);
    }
    if (argc != a + 4) die("usage:", "--write|--check [--each FIELD=v,...]... [--select REG] [--sections] TABLE PREFIX STATE OUT");
    if ((selreg || sections) && !neach) die("--select and --sections want --each", "");
    if (selreg && neach != 1) die("--select wants exactly one --each", "");
    if (ncombo > DG_MAXV) die("too many --each combinations", "");
    char *table = argv[a], *prefix = argv[a + 1], *state = argv[a + 2], *outpath = argv[a + 3];
    char *t = slurp(table), *line; long size = 1, rows = 0, cap = 1 << 22, at = 0, listed = 0, skipped = 0;
    if (!t) die("cannot read", table);
    char *out = malloc(cap), *seen = calloc(258 * (DG_MAXV + 1), 1); if (!out || !seen) die("memory", "");
    at += sprintf_n(out + at, cap - at, "# generated by tools/decide-gen.cx from %s; do not edit\n", table);
    at += sprintf_n(out + at, cap - at, "# section\tstate\tobservation\ttarget\tactions\n");
    for (line = t; line && *line; ) {
        char *nl = strchr(line, '\n'), *v[DG_MAXV + 2]; int n, i, k = 0, e; long s = 0; char suffix[256], section[256];
        if (nl) *nl = 0;
        if (!strncmp(line, "#field\t", 7)) {
            n = split(line, v, DG_MAXV + 2);
            if (nfield == DG_MAXF || n < 3) die("bad field", line);
            for (i = 2; i < n; i++) field[nfield][i - 2] = v[i];
            nvals[nfield] = n - 2;
            for (e = 0; e < neach; e++) if (!strcmp(v[1], selname[e])) break;
            if (e < neach) each[e] = nfield; else size *= n - 2;
            nfield++;
            if (size > 257) die("domain exceeds one r-mode state", table);
        } else if (*line && *line != '#' && nfield) {
            n = split(line, v, DG_MAXV + 2);
            if (n != nfield + 1 || !strncmp(v[nfield], "=>", 2)) { line = nl ? nl + 1 : 0; continue; }
            for (i = 0; i < nfield; i++) {
                int x = -1, j, se = -1;
                for (j = 0; j < nvals[i]; j++) if (!strcmp(field[i][j], v[i])) x = j;
                if (x < 0) die("value out of domain", v[i]);
                for (e = 0; e < neach; e++) if (each[e] == i) break;
                if (e < neach) { for (j = 0; j < nsel[e]; j++) if (!strcmp(sel[e][j], v[i])) se = j; if (se < 0) s = -1; else if (s >= 0) s = s * nsel[e] + se; }
                else k = k * nvals[i] + x;
            }
            if (s < 0) { skipped++; line = nl ? nl + 1 : 0; continue; }
            if (seen[s * 258 + k]) die("repeated key", v[0]);
            seen[s * 258 + k] = 1; rows++;
            combo(s, suffix, section, sizeof suffix);
            at += sprintf_n(out + at, cap - at, "%s\t%s%s\t%d\t%s.%s\t[]\n", sections ? section : "main", state, suffix, k, prefix, v[nfield]);
        }
        line = nl ? nl + 1 : 0;
    }
    for (int e = 0; e < neach; e++) {
        if (each[e] < 0) die("--each field not in table", selname[e]);
        for (int j = 0; j < nsel[e]; j++) {
            int x = -1, q; for (q = 0; q < nvals[each[e]]; q++) if (!strcmp(field[each[e]][q], sel[e][j])) x = q; if (x < 0) die("--each value out of domain", sel[e][j]);
            if (selreg) at += sprintf_n(out + at, cap - at, "main\t%s\t%d\t%s.%s\t[[\"RLD\",\"%s\"]]\n", state, x, state, sel[e][j], selreg);
        }
    }
    if (selreg) at += sprintf_n(out + at, cap - at, "main\t%s\t*\t%s.out-of-domain\t[]\n", state, prefix);
    if (neach) { for (long c = 0; c < ncombo; c++) { char suffix[256], section[256]; combo(c, suffix, section, sizeof suffix); at += sprintf_n(out + at, cap - at, "%s\t%s%s\t*\t%s.out-of-domain\t[]\n", sections ? section : "main", state, suffix, prefix); } listed = ncombo; }
    else { at += sprintf_n(out + at, cap - at, "main\t%s\t*\t%s.out-of-domain\t[]\n", state, prefix); listed = 1; }
    if (rows != size * listed) { fprintf(stderr, "decide-gen: %ld rows for %ld keys\n", rows, size * listed); return 2; }
    if (!strcmp(argv[1], "--write")) { FILE *o = fopen(outpath, "wb"); if (!o || fwrite(out, 1, (size_t)at, o) != (size_t)at || fclose(o)) die("cannot write", outpath); }
    else { char *old = slurp(outpath); if (!old || strlen(old) != (size_t)at || memcmp(old, out, (size_t)at)) { fprintf(stderr, "decide-gen: %s differs\n", outpath); return 1; } }
    printf("DECIDE\tkeys=%ld\tstates=%ld\tskipped=%ld\tstatus=PASS\n", rows, listed, skipped); return 0;
}
