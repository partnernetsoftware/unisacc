/* Inspect the borrowed process environment through the actual CX interface. */
#pragma unisa use driver.environment
int main(int argc,char **argv){
    int n=0,seen=0,failed=0;char *entry;
    while((entry=cxe_environment(argc,argv,n))!=0){
        if(n>=65536){fputs("environment vector bound\n",stderr);return 2;}
        if(!strncmp(entry,"CXE_TEST=",9)){seen++;if(strcmp(entry,"CXE_TEST=explicit-value"))failed++;}
        n++;
    }
    if(seen!=1)failed++;
    printf("CXE\tentries=%d\tmarker=%d\tfailed=%d\n",n,seen,failed);return failed?1:0;
}
