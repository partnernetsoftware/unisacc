/* tools/guard-hook.cx -- PreToolUse 钩子(Bash|Edit|Write|Read),取代 .claude/hooks/guard-edit.ts,行为逐条等价。
 *
 *   cd "$CLAUDE_PROJECT_DIR" && ./tools/bound 9 sh ./unisacc.com tools/guard-hook.cx     (stdin 收钩子 JSON)
 *
 * 规则:
 *   DEVSVC-ONLY  原生 Read/Edit/Write 的 file_path 先规范化(. 与 .. 加逐段符号链接展开,悬空链接也跟)。
 *                落在仓内(GUARD_REPO 含 .claude/worktrees,原始或规范路径任一命中)一律拒绝(rc 2);
 *                仓外放行区(/tmp、$CLAUDE_JOB_DIR、$HOME/.cache、$HOME/.claude/、/tmp/claude-*)放行;
 *                其余仓外路径(/etc、~/.ssh 等)与相对路径仍拒绝。
 *                $HOME/.cache/unisacc/devsvc/native-fallback 的 mtime 在 30 分钟内则放行(mtime 精度为秒)。
 *   写域占用     Edit/Write 且设 UNISACC_AGENT 时,查 $UNISACC_DOMAINS(缺省 $HOME/.cache/unisacc/domains.tsv,
 *                列 agent 前缀 到期秒 ...),仓内路径被他人未过期前缀占用则拒绝。
 *   SEND-GATE-MIN 纯无状态 PreToolUse 发信内容闸(零租约/限流写盘、零 CLI 子命令、零子进程、零跨仓依赖,仅审 Bash 中 mux/bin/envelope):
 *                - BROADCAST-IDLE: 拦 mux broadcast/@all 含待命状态词、单次逗号收件人 >2(TARGET-CAP)或同命令串接 >2 次发信;
 *                - PAUSE-FORM: 拦无交付物路径/无 7+ 位 hex SHA/无结构化表/无 [暂停-需裁决] 标签的裸待命/裸状态汇报;
 *                - EMPTY-BODY: 拦空或全空白正文及缺失/不可读 --body-file/@file(跳过 --help/-h/--dry-run);
 *                - BRANCH-NAME: 拦正文/标题中显式建切的不规范分支名(允许 main/v0.N.M/devsvc*);
 *                - 逃生口: 环境变量 MUX_URGENT=<非空理由> 放行 BROADCAST-IDLE 与 PAUSE-FORM。
 *   GUARD-EDIT-V1 Bash 命令:写仓库根 out/、git clone/worktree add(版本工作树除外)、mkdir 工作目录、
 *                git stash/clean/reset --hard/checkout --/restore ./--no-verify/--autostash、python/bun/node/perl/ruby 作命令、
 *                sed -i、perl -i、awk -i inplace、ex/ed/vi/vim/nvim、tee、重定向写仓内,sh -c 正文递归一层,python -c open 写。
 *   DEVSVC-WARN  未拒绝时五类告警(git-write direct-cx git-read sleep-poll pipe-trim):stderr 一行加追加
 *                $HOME/.cache/unisacc/devsvc/hook-warn.tsv(ISO 时间 会话 类 命令前 120 个 UTF-16 单元),rc 0。
 * 环境:HOME(缺省 /home/devali 用于仓根与安全前缀)、GUARD_REPO(缺省 $HOME/repos/unisacc)、CLAUDE_JOB_DIR。
 * fail-open:JSON 解析失败或字段类型不符一律 rc 0。正则按原 .ts 的 JS 语义手写匹配(ASCII 空白)。
 * Check: tools/check-guard-hook.cx. */
#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use text.json
#pragma unisa use cxlib.releaseseq

static const char *HOMEV;   /* process.env.HOME ?? "" */
static char *HOMED;         /* process.env.HOME ?? "/home/devali" */
static char *REPO;
static const char *JOB;
static char *SAFE3, *SAFE4;

static long sl(const char *s) { long n = 0; while (s[n]) n++; return n; }
static int eq(const char *a, const char *b) { while (*a && *a == *b) { a++; b++; } return *a == *b; }
static int sw(const char *s, const char *p) { while (*p) { if (*s != *p) return 0; s++; p++; } return 1; }
static int has(const char *s, const char *p) { for (; *s; s++) if (sw(s, p)) return 1; return sw(s, p); }
static int hasc(const char *s, char c) { for (; *s; s++) if (*s == c) return 1; return 0; }
static int isws(char c) { return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v' || c == '\f'; }
static int isal(char c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'); }
static int isdg(char c) { return c >= '0' && c <= '9'; }
static int iswd(char c) { return isal(c) || isdg(c) || c == '_'; }
static char *dupn(const char *s, long n) { char *d = (char *)mm_alloc(n + 1); if (n > 0) mm_copy(d, n + 1, s, n); d[n] = 0; return d; }
static char *sdup(const char *s) { return dupn(s, sl(s)); }
static char *cat2(const char *a, const char *b) {
    long x = sl(a), y = sl(b); char *d = (char *)mm_alloc(x + y + 1);
    if (x) mm_copy(d, x + y + 1, a, x); if (y) mm_copy(d + x, y + 1, b, y); d[x + y] = 0; return d;
}
static const char *envs(const char *k) { const char *v = sy_env(k); return v ? v : 0; }

/* /^["']|["']$/g */
static char *strip_q(const char *s) {
    long n = sl(s), a = 0, b = n;
    if (n > 0 && (s[0] == '"' || s[0] == '\'')) a = 1;
    if (b - 1 >= a && (s[b - 1] == '"' || s[b - 1] == '\'')) b--;
    return dupn(s + a, b - a);
}
/* /^\$\{?NAME\}?/ -> VAL */
static char *repl_var(char *s, const char *name, const char *val) {
    long j = 1, m = sl(name);
    if (s[0] != '$') return s;
    if (s[j] == '{') j++;
    if (!sw(s + j, name)) return s;
    j += m;
    if (s[j] == '}') j++;
    return cat2(val, s + j);
}
static char *repl_home(char *s) {
    if (s[0] == '~' && (s[1] == '/' || s[1] == 0)) s = cat2(HOMED, s + 1);
    return repl_var(s, "HOME", HOMED);
}
/* path.resolve(base, p) for absolute base or absolute p */
static char *resolve(const char *base, const char *p) {
    char *t = p[0] == '/' ? sdup(p) : cat2(cat2(base, "/"), p);
    long n = sl(t), i = 0, o = 0; char *r = (char *)mm_alloc(n + 2);
    while (i < n) {
        long s, e;
        while (i < n && t[i] == '/') i++;
        s = i; while (i < n && t[i] != '/') i++; e = i;
        if (e == s) continue;
        if (e - s == 1 && t[s] == '.') continue;
        if (e - s == 2 && t[s] == '.' && t[s + 1] == '.') { while (o > 0 && r[o - 1] != '/') o--; if (o > 0) o--; continue; }
        r[o++] = '/'; mm_copy(r + o, n + 2 - o, t + s, e - s); o += e - s;
    }
    if (o == 0) r[o++] = '/';
    r[o] = 0;
    return r;
}
static int safe(const char *p) {
    return sw(p, "/tmp/") || sw(p, "/dev/") || sw(p, SAFE3) || (SAFE4 && sw(p, SAFE4));
}
/* inRepo(p, cur, false) when out=0; isRepoOut(p, cur) when out=1 */
static int repo_path(const char *a, const char *cur, int out) {
    char *p = repl_home(strip_q(a));
    if (*JOB) p = repl_var(p, "CLAUDE_JOB_DIR", JOB);
    if (hasc(p, '$') || hasc(p, '`') || !*p) return 0;
    if (p[0] != '/') { if (!*cur) return 0; p = resolve(cur, p); } else p = resolve("", p);
    if (safe(p)) return 0;
    if (out) { char *o = cat2(REPO, "/out"); return eq(p, o) || sw(p, cat2(o, "/")); }
    return eq(p, REPO) || sw(p, cat2(REPO, "/"));
}

/* 引号体只含 [A-Za-z0-9._/@+-] 的普通名(分支名、路径):原样保留,不剥空,使 'junk' 与 "junk" 仍能按名判定;其余体照旧剥空。
 * 波及面:strip_bodies 是所有 Bash 规则共用的前置,保留普通引号体后,带引号路径的写文件规则同时生效:
 * 重定向、sed -i、tee、cp、mkdir 写仓内或 out/ 的带引号写法(如 echo x > '/r/repo/a.c')由放行变为拒绝。 */
static int plain_body(const char *b, long n) {
    long k;
    if (n <= 0) return 0;
    for (k = 0; k < n; k++) { char c = b[k]; if (!(isal(c) || isdg(c) || c == '.' || c == '_' || c == '/' || c == '@' || c == '+' || c == '-')) return 0; }
    return 1;
}

static char *strip_bodies(const char *cmd) {
    long n = sl(cmd), i = 0, o = 0, ls; char *end = 0; char *s = (char *)mm_alloc(n + 2), *r;
    while (i <= n) {
        long e = i, j, a, b, q;
        while (e < n && cmd[e] != '\n') e++;
        if (end) {
            a = i; b = e;
            while (a < b && isws(cmd[a])) a++;
            while (b > a && isws(cmd[b - 1])) b--;
            if (b - a == sl(end) && sw(cmd + a, end) ) end = 0;
            i = e + 1; continue;
        }
        if (o > 0) s[o++] = '\n';
        mm_copy(s + o, n + 2 - o, cmd + i, e - i); o += e - i;
        for (j = i; j + 1 < e; j++) {
            long k = j + 2, st;
            char qc = 0;
            if (cmd[j] != '<' || cmd[j + 1] != '<') continue;
            if (k < e && cmd[k] == '-') k++;
            while (k < e && isws(cmd[k])) k++;
            q = k;
            if (k < e && (cmd[k] == '\'' || cmd[k] == '"')) { qc = cmd[k]; k++; }
            st = k;
            if (!(k < e && (isal(cmd[k]) || cmd[k] == '_'))) continue;
            while (k < e && iswd(cmd[k])) k++;
            if (qc && !(k < e && cmd[k] == qc)) continue;
            (void)q;
            end = dupn(cmd + st, k - st);
            break;
        }
        i = e + 1;
    }
    s[o] = 0;
    ls = o; r = (char *)mm_alloc(ls * 2 + 4); o = 0;
    for (i = 0; i < ls; i++) {
        char c = s[i];
        if (c == '\\') { r[o++] = c; if (i + 1 < ls) r[o++] = s[i + 1]; i++; continue; }
        if (c == '\'') { long j = i + 1; while (j < ls && s[j] != '\'') j++; if (j >= ls) { r[o] = 0; return r; } if (plain_body(s + i + 1, j - i - 1)) { mm_copy(r + o, ls * 2 + 4 - o, s + i, j - i + 1); o += j - i + 1; } else { r[o++] = '\''; r[o++] = '\''; } i = j; continue; }
        if (c == '"') { long j = i + 1; while (j < ls && s[j] != '"') j += s[j] == '\\' ? 2 : 1; if (j < ls && plain_body(s + i + 1, j - i - 1)) { mm_copy(r + o, ls * 2 + 4 - o, s + i, j - i + 1); o += j - i + 1; } else { r[o++] = '"'; r[o++] = '"'; } i = j; continue; }
        r[o++] = c;
    }
    r[o] = 0;
    return r;
}

static int inlist(char **a, long from, long n, const char *x) { long m; for (m = from; m < n; m++) if (eq(a[m], x)) return 1; return 0; }
/* 分支纪律(只在命令作用于本仓时判定):新建/改名/复制出的分支名必须是规范三段版本。
 *   main 只作 branch -m/-M/-c/-C 与 checkout -B/switch -C 的目标放行;ujs 别仓靠作用域放行(cwd 或 -C 目标不在 GUARD_REPO 下)。
 *   名含 $/反引号无法静态判定,放行。引号体只含普通名字符时 strip_bodies 原样保留,所以 'junk'、"junk" 按名判定;含空白或元字符的引号体仍剥空放行。删除与列出不拦。
 * 已知缺口(不修):子壳 (git ...)、花括号 { git ...; }、if/then 体、env/command/eval/xargs 前缀、update-ref、fetch/push 的 refspec 建分支;
 *   --color/--sort/--abbrev 后跟 junk(实际 --color 无值时 junk 是新分支名,这里按吞值放行);checkout --track origin/junk(建本地分支 junk);
 *   branch -d x -m a junk 与 branch --list -m(只列出与改名混用时按只列出放行);cd 到仓外后用 --git-dir 指向本仓(作用域只看 cwd 与 -C,不看 --git-dir/--work-tree)。
 *   带引号的选项或子命令('-b'、'checkout'、'git')仍放行;元字符引号名('junk;x'、'junk!'、'junk=1'、'a&b'、'junk(1)')剥空后放行,
 *   实际可建出该分支名(下一轮考虑:引号体剥空后的名字一律拒绝,合规名不需要元字符)。
 *   devsvc-core.cx 的合并工作树(merge-NAME 路径与 merge/NAME 分支)是内部 git 调用,不经本钩子,但不合规。 */
static int ver_branch_ok(const char *nm0, int allow_main) {
    char *nm = strip_q(nm0);
    if (!*nm || hasc(nm, '$') || hasc(nm, '`')) return 1;
    if (allow_main && eq(nm, "main")) return 1;
    return nm[0] == 'v' && rs_version(nm + 1);
}
static char GB[512];
static const char *branch_bad(const char *nm, int allow_main) {
    if (ver_branch_ok(nm, allow_main)) return 0;
    tx_snprintf(GB, sizeof GB, "git 创建分支 %s:只允许 vX.Y.Z 版本分支,补丁放 ~/.local/share/unisacc/research/", strip_q(nm));
    return GB;
}
static int in_repo_dir(const char *d) { long rl = sl(REPO); return !*d || eq(d, REPO) || (sw(d, REPO) && d[rl] == '/'); }
/* x 是 --NAME 或 --NAME=V:返回 1;有 =V 时 *val 指向 V,否则 *val 为 0 */
static int longopt(const char *x, const char *name, const char **val) {
    long nl = sl(name);
    *val = 0;
    if (!sw(x, name)) return 0;
    if (x[nl] == 0) return 1;
    if (x[nl] == '=') { *val = x + nl + 1; return 1; }
    return 0;
}
/* 短选项簇 x(-qb、-bNAME):LETTERS 中的第一个字母命中则返回该字母,*val 指向簇内粘连值(无则 0) */
static int shortcluster(const char *x, const char *letters, const char **val) {
    long m;
    *val = 0;
    if (x[0] != '-' || x[1] == '-' || !x[1]) return 0;
    for (m = 1; x[m]; m++) if (hasc(letters, x[m])) { if (x[m + 1]) *val = x + m + 1; return x[m]; }
    return 0;
}
static const char *const WT_REFUSE = "git clone/worktree add:不得另建克隆或工作树,直接在 ~/repos/unisacc 里工作";

static int wtree_leaf_ok(const char *leaf) {
    const char *q = leaf + 2;
    if (leaf[0] != 'w' || leaf[1] != '-' || !*q) return 0;
    for (; *q; q++) if (!(isdg(*q) || isal(*q) || *q == '.' || *q == '_' || *q == '-')) return 0;
    return 1;
}
static const char *worktree_leaf(const char *cur, const char *path) {
    char *target = strip_q(path);
    if (!*target || hasc(target, '$') || hasc(target, '`')) return 0;
    char *abs = target[0] == '/' ? resolve("", target) : (*cur ? resolve(cur, target) : sdup(""));
    char *prefix = cat2(REPO, "/.claude/worktrees/");
    if (!sw(abs, prefix)) return 0;
    const char *leaf = abs + sl(prefix);
    if (sw(leaf, "merge-")) {
        const char *q = leaf + 6;
        if (!*q) return 0;
        for (; *q; q++) if (!(isdg(*q) || isal(*q) || *q == '.' || *q == '_' || *q == '-')) return 0;
        return leaf;
    }
    if (wtree_leaf_ok(leaf)) return leaf;
    return leaf[0] == 'v' && rs_version(leaf + 1) ? leaf : 0;
}
static char *canon(const char *p);
static int under(const char *p, const char *d);
/* the w- tree the current cwd sits in, or 0; every window is confined to its own leaf */
static char *own_wtree_root(const char *cur) {
    char *prefix = cat2(REPO, "/.claude/worktrees/");
    if (!cur || !sw(cur, prefix)) return 0;
    const char *leaf = cur + sl(prefix);
    const char *q = leaf + 2;
    if (leaf[0] != 'w' || leaf[1] != '-' || !*q) return 0;
    for (; *q && *q != '/'; q++) if (!(isdg(*q) || isal(*q) || *q == '.' || *q == '_' || *q == '-')) return 0;
    return cat2(prefix, dupn(leaf, q - leaf));
}
/* cwd is inside one of our own w- trees (never the shared checkout) */
static int in_own_wtree(const char *cur) { return own_wtree_root(cur) != 0; }
/* 破坏性 git 操作的目标必须落在当前窗口自己的 w- 树内;canon 展开符号链接,防软链逃到共享检出 */
static int target_own_wtree(const char *tgt, const char *cur) {
    char *root = own_wtree_root(cur);
    if (!root || !tgt || !*tgt) return 0;
    return under(canon(tgt), canon(root));
}
static int in_repo_fp(const char *fp, const char *cp);
static char *fmt(const char *f, const char *a, const char *b);
static char *norm_ow_str(const char *raw) {
    long a = 0, b, i, o = 0; char *d;
    if (!raw) return sdup("");
    raw = strip_q(raw);
    b = sl(raw);
    while (a < b && isws(raw[a])) a++;
    while (b > a && isws(raw[b - 1])) b--;
    if (b <= a || b - a >= 64) return sdup("");
    d = (char *)mm_alloc(b - a + 1);
    for (i = a; i < b; i++) {
        unsigned char c = (unsigned char)raw[i];
        if (c < 0x21 || c == 0x7f) return sdup("");
        if (c >= 'A' && c <= 'Z') c = (unsigned char)(c + 32);
        d[o++] = (char)c;
    }
    d[o] = 0;
    return d;
}
static const char *drop_pane_pfx(const char *ow) {
    const char *p = ow, *last = 0;
    for (; *p; p++) if (*p == ':') last = p;
    return (last && last[1]) ? last + 1 : ow;
}
static int owner_is_cc(const char *ow_raw) {
    char *n = norm_ow_str(ow_raw);
    const char *s = drop_pane_pfx(n);
    return eq(s, "cc");
}
static char *resolve_window_wtree(const char *ow_raw, const char *cur, char **hint_out) {
    char *n = norm_ow_str(ow_raw);
    const char *s = drop_pane_pfx(n);
    char *prefix = cat2(REPO, "/.claude/worktrees/");
    if (*s && !eq(s, "cc")) {
        char *leaf = sw(s, "w-") ? sdup(s) : cat2("w-", s);
        if (wtree_leaf_ok(leaf)) {
            char *wt = cat2(prefix, leaf);
            if (hint_out) *hint_out = wt;
            return wt;
        }
    }
    {
        char *cwt = own_wtree_root(cur);
        if (cwt) {
            if (hint_out) *hint_out = cwt;
            return cwt;
        }
    }
    if (hint_out) {
        const char *ag = envs("UNISACC_AGENT");
        char *an = norm_ow_str(ag ? ag : "");
        const char *as = drop_pane_pfx(an);
        if (*as && !eq(as, "cc")) {
            char *leaf = sw(as, "w-") ? sdup(as) : cat2("w-", as);
            *hint_out = cat2(prefix, leaf);
        } else {
            *hint_out = cat2(prefix, "w-<DEVSVC_OWNER>");
        }
    }
    return 0;
}
static char *shared_checkout_write_bad(const char *raw_path, const char *cur, const char *flow_root, const char *ow_raw) {
    char *p, *base, *abs_p, *can_p, *own_wt, *hint_wt = 0, *ow_n;
    if (!raw_path || !*raw_path) return 0;
    if (owner_is_cc(ow_raw)) return 0;
    p = repl_home(strip_q(raw_path));
    if (*JOB) p = repl_var(p, "CLAUDE_JOB_DIR", JOB);
    if (!*p || hasc(p, '$') || hasc(p, '`')) return 0;
    base = (flow_root && *flow_root) ? repl_home(strip_q(flow_root)) : sdup(cur && *cur ? cur : REPO);
    abs_p = p[0] == '/' ? resolve("", p) : (*base ? resolve(base, p) : resolve(REPO, p));
    can_p = canon(abs_p);
    if (!in_repo_fp(abs_p, can_p)) return 0;
    own_wt = resolve_window_wtree(ow_raw, cur, &hint_wt);
    if (own_wt && under(abs_p, own_wt) && under(can_p, canon(own_wt)) && !eq(abs_p, own_wt)) return 0;
    ow_n = norm_ow_str(ow_raw);
    return fmt("共享检出写保护:非集成者(DEVSVC_OWNER=%s)不得写共享检出或非本窗口工作树,请在本窗口工作树 %s 内修改",
               *ow_n ? ow_n : "unset", hint_wt);
}
/* a path containing a ".." component before normalization is refused outright */
static int has_dotdot(const char *p) {
    while (p && *p) {
        long n = 0;
        while (*p == '/') p++;
        while (p[n] && p[n] != '/') n++;
        if (n == 2 && p[0] == '.' && p[1] == '.') return 1;
        p += n;
    }
    return 0;
}
/* -C/--work-tree 目标与 GIT_WORK_TREE 环境值(若有)都必须落在当前窗口自己的 w- 树内 */
static int tgt_ok(const char *tgt, const char *envtgt, const char *cur) {
    return target_own_wtree(tgt, cur) && (!envtgt || target_own_wtree(envtgt, cur));
}
/* a[i] 是子命令;只拦创建/改名/复制出的新分支名 */
static const char *branch_violation(char **a, long i, long n, const char *cur, int local) {
    const char *sub = i < n ? a[i] : ""; long j;
    if (eq(sub, "branch")) {
        int noncreate = 0, mv = 0; const char *first = 0, *last = 0;
        for (j = i + 1; j < n; j++) {
            const char *x = a[j], *v;
            if (eq(x, "--")) continue;
            if (x[0] == '-' && x[1] == '-') {
                if (longopt(x, "--points-at", &v) || longopt(x, "--format", &v) || longopt(x, "--sort", &v) || longopt(x, "--color", &v) ||
                    longopt(x, "--contains", &v) || longopt(x, "--no-contains", &v) || longopt(x, "--merged", &v) || longopt(x, "--no-merged", &v) ||
                    longopt(x, "--set-upstream-to", &v) || longopt(x, "--abbrev", &v) || longopt(x, "--column", &v)) { noncreate = 1; if (!v && j + 1 < n) j++; }
                else if (eq(x, "--delete") || eq(x, "--list") || eq(x, "--show-current") || eq(x, "--unset-upstream") || eq(x, "--edit-description") || eq(x, "--all") || eq(x, "--remotes") || eq(x, "--no-column")) noncreate = 1;
                else if (eq(x, "--move") || eq(x, "--copy")) mv = 1;
            } else if (x[0] == '-' && x[1]) {
                long m;
                for (m = 1; x[m]; m++) {
                    char c = x[m];
                    if (c == 'd' || c == 'D' || c == 'l' || c == 'a' || c == 'r') noncreate = 1;
                    if (c == 'u') { noncreate = 1; if (!x[m + 1] && j + 1 < n) j++; }
                    if (c == 'm' || c == 'M' || c == 'c' || c == 'C') mv = 1;
                }
            } else { if (!first) first = x; last = x; }
        }
        if (mv) return last && !noncreate ? branch_bad(last, 1) : 0;
        if (noncreate) return 0;
        return first ? branch_bad(first, 0) : 0;
    }
    if (eq(sub, "checkout") || eq(sub, "switch") || (eq(sub, "worktree") && i + 1 < n && eq(a[i + 1], "add"))) {
        int wt = eq(sub, "worktree"), detach = 0, positional = 0, force_branch = 0;
        const char *pos0 = 0, *pos1 = 0, *created = 0;
        const char *letters = eq(sub, "checkout") ? "bB" : eq(sub, "switch") ? "cC" : "bB";
        for (j = i + (wt ? 2 : 1); j < n; j++) {
            const char *x = a[j], *v = 0; int L = 0, forcelong = 0, hitlong = 0;
            if (!positional && eq(x, "--")) { if (!wt) break; positional = 1; continue; }
            if (!positional && x[0] == '-' && x[1] == '-') {
                if (!wt && longopt(x, "--orphan", &v)) hitlong = 1;
                else if (eq(sub, "switch") && longopt(x, "--create", &v)) hitlong = 1;
                else if (eq(sub, "switch") && longopt(x, "--force-create", &v)) { hitlong = 1; forcelong = 1; }
                else if (wt && eq(x, "--detach")) detach = 1;
                else if (wt && eq(x, "--reason") && j + 1 < n) j++;
                if (hitlong) {
                    if (!v) { if (j + 1 >= n) continue; v = a[++j]; }
                    { const char *bv = branch_bad(v, forcelong); if (bv) return bv; }
                }
                continue;
            }
            if (!positional && x[0] == '-' && x[1]) {
                L = shortcluster(x, letters, &v);
                if (wt && eq(x, "-d")) detach = 1;
                if (L) {
                    if (!v) { if (j + 1 >= n) continue; v = a[++j]; }
                    if (wt) {
                        if (created) return WT_REFUSE;
                        created = v; force_branch = L == 'B';
                    } else { const char *bv = branch_bad(v, L == 'B' || L == 'C'); if (bv) return bv; }
                }
                continue;
            }
            if (wt) { if (!pos0) pos0 = x; else if (!pos1) pos1 = x; else return WT_REFUSE; }
        }
        if (wt) {
            const char *leaf = pos0 ? worktree_leaf(cur, pos0) : 0;
            if (!leaf) return WT_REFUSE;
            if (wtree_leaf_ok(leaf)) {
                if (!detach || created) return WT_REFUSE;
                return 0;
            }
            if (local && created) { const char *bv = branch_bad(created, force_branch); if (bv) return bv; }
            const char *branch = created ? created : (!detach ? pos1 : 0);
            if (branch && leaf[0] == 'v' && !eq(strip_q(branch), leaf)) return WT_REFUSE;
            if (local && !branch && !detach) return branch_bad(leaf, 0);
        }
    }
    return 0;
}

static const char *git_violation(char **a, long n, const char *cur, const char *wte) {
    long i = 0, j; const char *sub; char *tgt = sdup(cur ? cur : ""); char *envtgt = 0;
#define OWN_WT_REFUSE "git 破坏性操作:目标必须是当前窗口自己的 .claude/worktrees/w-* 树,共享检出、其他窗口、软链逃逸一律拒"
    for (j = 0; j < n; j++) if (eq(a[j], "--autostash")) return "git --autostash 含 stash:共享 main 上不得 stash";
    while (i < n && a[i][0] == '-') {
        const char *d = 0; long step = 1;
        if ((eq(a[i], "-C") || eq(a[i], "--work-tree")) && i + 1 < n) { d = a[i + 1]; step = 2; }
        else if (sw(a[i], "--work-tree=")) d = a[i] + 12;
        if (d) {
            char *p = strip_q(d);
            if (has_dotdot(p)) return "git -C/--work-tree:路径含 .. 段,不得穿越";
            if (*p && !hasc(p, '$') && !hasc(p, '`')) tgt = p[0] == '/' ? resolve("", p) : (*tgt ? resolve(tgt, p) : sdup(""));
            else tgt = sdup("");
        }
        i += (step == 2 || eq(a[i], "-c") || eq(a[i], "--git-dir") || eq(a[i], "--namespace")) ? 2 : 1;
    }
    if (wte && *wte) {
        char *e = strip_q(wte);
        if (has_dotdot(e)) return "git -C/--work-tree:路径含 .. 段,不得穿越";
        if (*e && !hasc(e, '$') && !hasc(e, '`')) envtgt = e[0] == '/' ? resolve("", e) : (*tgt ? resolve(tgt, e) : sdup(""));
        else envtgt = sdup("");
    }
    sub = i < n ? a[i] : "";
#define REST(x) inlist(a, i + 1, n, x)
    if (eq(sub, "stash")) return "git stash:共享 main 上不得 stash/pop,需干净输入用 git archive 解到 $CLAUDE_JOB_DIR/tmp";
    if (eq(sub, "clean")) return tgt_ok(tgt, envtgt, cur) ? 0 : (in_own_wtree(cur) ? OWN_WT_REFUSE : "git clean:共享 main 上不得 clean");
    if (eq(sub, "merge")) return "git merge:共享工作树不得裸 merge,请用 devsvc git merge 或在独立隔离根解冲突";
    if (eq(sub, "rebase")) return "git rebase:共享工作树不得裸 rebase,避免破坏他人工作区与索引";
    if (eq(sub, "pull")) return "git pull:共享工作树不得裸 pull,请用 devsvc git pull";
    if (eq(sub, "reset") && REST("--hard")) return tgt_ok(tgt, envtgt, cur) ? 0 : (in_own_wtree(cur) ? OWN_WT_REFUSE : "git reset --hard:共享 main 上不得 reset");
    if (eq(sub, "checkout") && (REST("--") || REST("."))) return tgt_ok(tgt, envtgt, cur) ? 0 : (in_own_wtree(cur) ? OWN_WT_REFUSE : "git checkout -- / .:不得还原他人路径");
    if (eq(sub, "restore") && REST(".")) return tgt_ok(tgt, envtgt, cur) ? 0 : (in_own_wtree(cur) ? OWN_WT_REFUSE : "git restore .:不得还原他人路径");
    if (eq(sub, "commit") && REST("--no-verify")) return "git commit --no-verify:不得绕过 precommit";
    if (eq(sub, "push") && REST("--no-verify")) return "git push --no-verify:不得绕过 precommit";
    int local = in_repo_dir(tgt);
    if (local || (eq(sub, "worktree") && i + 1 < n && eq(a[i + 1], "add"))) {
        const char *bv = branch_violation(a, i, n, tgt, local); if (bv) return bv;
    }
#undef REST
    return 0;
}

static char *fmt(const char *f, const char *a, const char *b) {
    long n = sl(f) + sl(a) + (b ? sl(b) : 0) + 16; char *d = (char *)mm_alloc(n);
    tx_snprintf(d, n, f, a, b ? b : "");
    return d;
}
static int is_opt_letters_with(const char *a, int anyi, const char *set) {
    /* anyi: /^-[A-Za-z]*i/ ; else /^-[A-Za-z]*[set]$/ */
    long i = 1;
    if (a[0] != '-') return 0;
    if (anyi) { for (; isal(a[i]); i++) if (a[i] == 'i') return 1; return 0; }
    while (isal(a[i])) i++;
    return a[i] == 0 && i >= 2 && hasc(set, a[i - 1]);
}

static char *check(const char *cmd, const char *cwd, int depth);

static char *check_seg(char *t, char **curp) {
    long n = sl(t), nw = 0, i, k = 0; char **w = (char **)mm_alloc(sizeof(char *) * (n + 2));
    const char *first; char *cur = *curp;
    char **oa; long noa = 0;
    i = 0;
    if (n == 0) w[nw++] = sdup("");
    while (i < n) { long s = i; while (i < n && !isws(t[i])) i++; w[nw++] = dupn(t + s, i - s); while (i < n && isws(t[i])) i++; }
    while (k < nw) {
        const char *x = w[k]; long j = 1;
        if (!(isal(x[0]) || x[0] == '_')) break;
        while (iswd(x[j])) j++;
        if (x[j] != '=') break;
        k++;
    }
    first = k < nw ? w[k] : "";
    { const char *p = first, *q; for (q = first; *q; q++) if (*q == '/') p = q + 1; first = p; }
    if (eq(first, "env")) {
        long m = k + 1;
        while (m < nw) {
            const char *y = w[m]; long q = 1;
            if (eq(y, "-i") || eq(y, "--ignore-environment") || eq(y, "-0") || eq(y, "--null")) { m++; continue; }
            if ((eq(y, "-u") || eq(y, "--unset")) && m + 1 < nw) { m += 2; continue; }
            if (isal(y[0]) || y[0] == '_') { while (iswd(y[q])) q++; if (y[q] == '=') { m++; continue; } }
            break;
        }
        k = m;
        first = k < nw ? w[k] : "";
        { const char *p = first, *q; for (q = first; *q; q++) if (*q == '/') p = q + 1; first = p; }
    }
    if (eq(first, "cd") || eq(first, "pushd")) {
        char *d = repl_home(strip_q(k + 1 < nw ? w[k + 1] : ""));
        if (*d && !hasc(d, '$') && !hasc(d, '`')) *curp = d[0] == '/' ? resolve("", d) : (*cur ? resolve(cur, d) : sdup(""));
        else *curp = sdup("");
        return 0;
    }
    {
        const char *seg_ow = envs("DEVSVC_OWNER"), *seg_fr = envs("UNISACC_FLOW_ROOT");
        long di;
        for (di = 0; di < k; di++) {
            if (sw(w[di], "DEVSVC_OWNER=")) seg_ow = w[di] + 13;
            else if (sw(w[di], "UNISACC_FLOW_ROOT=")) seg_fr = w[di] + 18;
        }
        for (di = k; di < nw; di++) {
            char *tok = strip_q(w[di]);
            const char *tb = tok, *tq;
            for (tq = tok; *tq; tq++) if (*tq == '/') tb = tq + 1;
            if (eq(tb, "devsvc.cx") || eq(tb, "devsvc-core.cx")) {
                long si = di + 1, oi;
                const char *eff_ow = seg_ow;
                while (si < nw && (eq(w[si], "--") || eq(w[si], "--dev"))) si++;
                for (oi = si; oi + 1 < nw; oi++) {
                    if (eq(w[oi], "--owner")) {
                        if (!owner_is_cc(w[oi + 1])) eff_ow = w[oi + 1];
                        break;
                    }
                }
                if (si + 2 < nw && eq(w[si], "f")) {
                    const char *fop = w[si + 1], *tp = w[si + 2];
                    if ((eq(fop, "write") || eq(fop, "edit") || eq(fop, "edits") || eq(fop, "append")) && tp[0] != '-') {
                        char *sc = shared_checkout_write_bad(tp, cur, seg_fr, eff_ow);
                        if (sc) return sc;
                    }
                } else if (si + 2 < nw && eq(w[si], "doc")) {
                    const char *dop = w[si + 1], *tp = w[si + 2];
                    if ((eq(dop, "create") || eq(dop, "set") || eq(dop, "append") || eq(dop, "remove") || eq(dop, "repair")) && tp[0] != '-') {
                        char *sc = shared_checkout_write_bad(tp, cur, seg_fr, eff_ow);
                        if (sc) return sc;
                    }
                }
            } else if (eq(tb, "edit-span.cx")) {
                long si = di + 1;
                if (si < nw && eq(w[si], "--")) si++;
                if (si < nw && w[si][0] != '-') {
                    char *sc = shared_checkout_write_bad(w[si], cur, seg_fr, seg_ow);
                    if (sc) return sc;
                }
            }
        }
    }
    oa = (char **)mm_alloc(sizeof(char *) * (nw + 1));
    for (i = k + 1; i < nw; i++) if (w[i][0] != '-' && w[i][0]) oa[noa++] = w[i];
    {
        const char *hit = 0;
        if (eq(first, "mkdir") || eq(first, "touch")) { for (i = 0; i < noa; i++) if (repo_path(oa[i], cur, 1)) { hit = oa[i]; break; } }
        else if ((eq(first, "cp") || eq(first, "mv") || eq(first, "install") || eq(first, "ln") || eq(first, "rsync")) && noa > 1 && repo_path(oa[noa - 1], cur, 1)) hit = oa[noa - 1];
        if (hit && *hit) return fmt("%s 写仓库根 out/ (%s):不得往仓库 out/ 放任何东西,改用 $CLAUDE_JOB_DIR/tmp 或 /tmp", first, hit);
    }
    if (eq(first, "git") && k + 1 < nw && eq(w[k + 1], "clone")) return sdup(WT_REFUSE);
    if (eq(first, "mkdir")) {
        for (i = k + 1; i < nw; i++) {
            const char *a = w[i]; long j, m = sl(a); int hitm = sw(a, "~/work") || has(a, "cc-work");
            for (j = 0; j < m && !hitm; j++) {
                if ((j == 0 || a[j - 1] == '/') && sw(a + j, "out/") && a[j + 4]) hitm = 1;
                if (sw(a + j, "/work") && (a[j + 5] == '/' || a[j + 5] == 0)) hitm = 1;
            }
            if (hitm) return sdup("mkdir 在 out/ 或 ~/work 下建工作目录:不得另建工作目录");
        }
    }
    if (eq(first, "git")) {
        const char *wte = 0;
        for (i = 0; i < k; i++) if (sw(w[i], "GIT_WORK_TREE=")) wte = w[i] + 14;
        { const char *g = git_violation(w + k + 1, nw - k - 1, cur, wte); if (g) return sdup(g); }
    }
    {
        int ip = 0;
        if (sw(first, "python")) { const char *q = first + 6; ip = 1; for (; *q; q++) if (!isdg(*q) && *q != '.') ip = 0; }
        if (ip || eq(first, "bun") || eq(first, "node") || eq(first, "perl") || eq(first, "ruby")) {
            const char *a0 = k + 1 < nw ? w[k + 1] : ""; int hook = 0;
            if (eq(first, "bun")) {
                long j, m = sl(a0);
                if (eq(a0, "\"\"") || sw(a0, "$CLAUDE_PROJECT_DIR") || sw(a0, "${CLAUDE_PROJECT_DIR")) hook = 1;
                for (j = 0; j < m && !hook; j++) if ((j == 0 || a0[j - 1] == '/') && sw(a0 + j, ".claude/hooks/")) hook = 1;
            }
            if (!hook) return fmt("%s 作命令:不得用 python/bun/node/perl/ruby 写脚本,请用 sh ./unisacc.com FILE.cx -- ARGS 写 .cx", first, 0);
        }
    }
    if (eq(first, "git") || eq(first, "gh")) return 0;
    {
        char **args = w + k + 1; long na = nw - k - 1; int any = 0;
        if (na < 0) na = 0;
        if (eq(first, "sed")) {
            for (i = 0; i < na; i++) if (is_opt_letters_with(args[i], 1, 0) || sw(args[i], "--in-place")) any = 1;
            if (any) {
                char **ef = (char **)mm_alloc(sizeof(char *) * (na + 1)); long ne = 0, nf = 0, skip1 = 1;
                for (i = 0; i < na; i++) if (is_opt_letters_with(args[i], 0, "ef")) ef[ne++] = i + 1 < na ? args[i + 1] : 0;
                if (ne) skip1 = 0;
                for (i = 0; i < noa; i++) {
                    long j; int inef = 0;
                    for (j = 0; j < ne; j++) if (ef[j] && eq(ef[j], oa[i])) inef = 1;
                    if (ne && inef) continue;
                    if (!ne && nf++ < skip1) continue;
                    if (repo_path(oa[i], cur, 0)) return sdup("sed -i 改仓内文件");
                }
            }
        }
        if (eq(first, "perl")) {
            any = 0; for (i = 0; i < na; i++) if (is_opt_letters_with(args[i], 1, 0)) any = 1;
            if (any) for (i = 0; i < noa; i++) if (repo_path(oa[i], cur, 0)) return sdup("perl -i 改仓内文件");
        }
        if (eq(first, "awk") || eq(first, "gawk")) {
            char *j = sdup(""); long q, m; int f = 0;
            for (i = 0; i < na; i++) j = i ? cat2(cat2(j, " "), args[i]) : sdup(args[i]);
            m = sl(j);
            for (q = 0; q + 1 < m && !f; q++) if (j[q] == '-' && j[q + 1] == 'i') { long z = q + 2; if (z < m && isws(j[z])) { while (z < m && isws(j[z])) z++; if (sw(j + z, "inplace")) f = 1; } }
            if (f) for (i = 0; i < noa; i++) if (repo_path(oa[i], cur, 0)) return sdup("awk -i inplace 改仓内文件");
        }
        if (eq(first, "ex") || eq(first, "ed") || eq(first, "vi") || eq(first, "vim") || eq(first, "nvim"))
            for (i = 0; i < noa; i++) if (repo_path(oa[i], cur, 0)) return fmt("%s 改仓内文件", first, 0);
        if (eq(first, "tee")) for (i = 0; i < noa; i++) if (repo_path(oa[i], cur, 0)) return sdup("tee 写仓内文件");
    }
    /* /(?:^|[^<>&0-9])(?:\d?>>?|&>>?)\s*([^\s;&|<>()]+)/g */
    {
        long p = 0;
        while (p <= n) {
            int alt, matched = 0; long me = 0, cs = 0, ce = 0;
            for (alt = 0; alt < 2 && !matched; alt++) {
                long q = p, q0, c2;
                if (alt == 0) { if (p != 0) continue; }
                else { if (p >= n) continue; { char c = t[p]; if (c == '<' || c == '>' || c == '&' || isdg(c)) continue; } q++; }
                q0 = q;
                /* operator alternatives with backtracking */
                {
                    long cand[4]; int nc = 0, ci;
                    if (q0 < n && isdg(t[q0]) && q0 + 1 < n && t[q0 + 1] == '>') { if (q0 + 2 < n && t[q0 + 2] == '>') cand[nc++] = q0 + 3; cand[nc++] = q0 + 2; }
                    if (q0 < n && t[q0] == '>') { if (q0 + 1 < n && t[q0 + 1] == '>') cand[nc++] = q0 + 2; cand[nc++] = q0 + 1; }
                    if (q0 < n && t[q0] == '&' && q0 + 1 < n && t[q0 + 1] == '>') { if (q0 + 2 < n && t[q0 + 2] == '>') cand[nc++] = q0 + 3; cand[nc++] = q0 + 2; }
                    for (ci = 0; ci < nc && !matched; ci++) {
                        c2 = cand[ci];
                        while (c2 < n && isws(t[c2])) c2++;
                        cs = c2;
                        while (c2 < n && !isws(t[c2]) && !hasc(";&|<>()", t[c2])) c2++;
                        if (c2 > cs) { matched = 1; ce = c2; me = c2; }
                    }
                }
            }
            if (matched) {
                char *m1 = dupn(t + cs, ce - cs);
                if (repo_path(m1, cur, 0) || repo_path(m1, cur, 1)) return fmt("重定向写仓内文件 %s", m1, 0);
                p = me;
            } else p++;
        }
    }
    return 0;
}

/* /\b(?:ba|z|da)?sh\s+-[a-z]*c\s+(?:'([^']*)'|"((?:[^"\\]|\\.)*)")/g */
static char *shc(const char *cmd, const char *cur) {
    long n = sl(cmd), p = 0;
    while (p < n) {
        long q, pre, bs = -1, be = -1, me = -1; int pi;
        static const char *pres[4] = {"ba", "z", "da", ""};
        if (p > 0 && iswd(cmd[p - 1])) { p++; continue; }
        for (pi = 0; pi < 4 && me < 0; pi++) {
            long ls, le;
            q = p; pre = sl(pres[pi]);
            if (pre && !sw(cmd + q, pres[pi])) continue;
            q += pre;
            if (!sw(cmd + q, "sh")) continue;
            q += 2;
            if (!(q < n && isws(cmd[q]))) continue;
            while (q < n && isws(cmd[q])) q++;
            if (cmd[q] != '-') continue;
            q++; ls = q; while (q < n && cmd[q] >= 'a' && cmd[q] <= 'z') q++; le = q;
            if (!(le > ls && cmd[le - 1] == 'c')) continue;
            if (!(q < n && isws(cmd[q]))) continue;
            while (q < n && isws(cmd[q])) q++;
            if (cmd[q] == '\'') { long j = q + 1; while (j < n && cmd[j] != '\'') j++; if (j < n) { bs = q + 1; be = j; me = j + 1; } }
            else if (cmd[q] == '"') { long j = q + 1; while (j < n && cmd[j] != '"') { if (cmd[j] == '\\') { if (j + 1 >= n) { j = n; break; } j += 2; } else j++; } if (j < n) { bs = q + 1; be = j; me = j + 1; } }
        }
        if (me >= 0) {
            char *r = check(dupn(cmd + bs, be - bs), cur, 1);
            if (r) return cat2("sh -c 内 ", r);
            p = me;
        } else p++;
    }
    return 0;
}

static int wb_at(const char *s, long p) { return p == 0 || !iswd(s[p - 1]); }

static int py_c(const char *cmd) {
    long n = sl(cmd), p;
    for (p = 0; p < n; p++) {
        long q = p;
        if (!wb_at(cmd, p) || !sw(cmd + p, "python")) continue;
        q += 6;
        {
            long opts[2]; int no = 0, oi;
            if (cmd[q] == '3') opts[no++] = q + 1;
            opts[no++] = q;
            for (oi = 0; oi < no; oi++) {
                long r = opts[oi], r2;
                if (!(r < n && isws(cmd[r]))) continue;
                while (r < n && isws(cmd[r])) r++;
                r2 = r;
                if (sw(cmd + r, "-I") && r + 2 < n && isws(cmd[r + 2])) { long z = r + 2; while (z < n && isws(cmd[z])) z++; if (sw(cmd + z, "-c") && !iswd(cmd[z + 2])) return 1; }
                if (sw(cmd + r2, "-c") && !iswd(cmd[r2 + 2])) return 1;
            }
        }
    }
    return 0;
}
static int open_w(const char *cmd) {
    long n = sl(cmd), p;
    for (p = 0; p + 5 <= n; p++) {
        long e, j;
        if (!sw(cmd + p, "open(")) continue;
        e = p + 5; while (e < n && cmd[e] != ')') e++;
        for (j = p + 5; j < e; j++) {
            long q = j + 1;
            if (!(cmd[j] == '\'' || cmd[j] == '"')) continue;
            if (!(q < e && (cmd[q] == 'w' || cmd[q] == 'a'))) continue;
            q++;
            {
                int b, pl;
                for (b = 1; b >= 0; b--) for (pl = 1; pl >= 0; pl--) {
                    long z = q;
                    if (b) { if (z < e && cmd[z] == 'b') z++; else continue; }
                    if (pl) { if (z < e && cmd[z] == '+') z++; else continue; }
                    if (z < e && (cmd[z] == '\'' || cmd[z] == '"')) return 1;
                }
            }
        }
    }
    return 0;
}
static int bout(const char *cmd) {
    long n = sl(cmd), p;
    for (p = 0; p < n; p++) if (sw(cmd + p, "out/") && wb_at(cmd, p)) return 1;
    return 0;
}

static char *sgm_check_mux_cmd(const char *cmd, const char *cwd);

static char *check(const char *cmd, const char *cwd, int depth) {
    char *s = strip_bodies(cmd), *cur = sdup(*cwd ? cwd : REPO);
    long n = sl(s), i = 0, st = 0;
    while (1) {
        long sep = 0;
        if (i >= n) sep = -1;
        else if (s[i] == ';' || s[i] == '\n' || s[i] == '`') sep = 1;
        else if ((s[i] == '&' && s[i + 1] == '&') || (s[i] == '|' && s[i + 1] == '|') || (s[i] == '$' && s[i + 1] == '(')) sep = 2;
        else if (s[i] == '|') sep = 1;
        if (sep) {
            long a = st, b = i; char *r;
            while (a < b && isws(s[a])) a++;
            while (b > a && isws(s[b - 1])) b--;
            r = check_seg(dupn(s + a, b - a), &cur);
            if (r) return r;
            if (sep < 0) break;
            i += sep; st = i;
        } else i++;
    }
    if (depth < 1) { char *r = shc(cmd, cur); if (r) return r; }
    if (py_c(cmd) && open_w(cmd) && !has(cmd, "/tmp/") && !bout(cmd) && !has(cmd, "cc-work") && !has(cmd, "CLAUDE_JOB_DIR"))
        return sdup("python -c open(...,'w') 写文件");
    if (depth == 0) {
        char *sg = sgm_check_mux_cmd(cmd, *cwd ? cwd : REPO);
        if (sg) return sg;
    }
    return 0;
}

/* ===== SEND-GATE-MIN: pure stateless PreToolUse content & target-cap gates (zero state files, zero child procs) ===== */
static const char *sgm_base(const char *p) {
    const char *r = p;
    for (; *p; p++) if (*p == '/') r = p + 1;
    return r;
}
static int sgm_is_mux_cmd(const char *b) { return eq(b, "mux") || eq(b, "mux-bun") || eq(b, "mux-rust"); }
static int sgm_is_sh_cmd(const char *b) { return eq(b, "sh") || eq(b, "bash") || eq(b, "zsh") || eq(b, "dash"); }
static int sgm_is_sh_c_flag(const char *a) {
    long i = 1;
    if (!a || a[0] != '-') return 0;
    while (a[i] >= 'a' && a[i] <= 'z') i++;
    return i > 1 && a[i] == 0 && a[i - 1] == 'c';
}
static int sgm_is_env_assign(const char *x) {
    long i = 0;
    if (!x || !(isal(x[0]) || x[0] == '_')) return 0;
    while (x[i] && (iswd(x[i]))) i++;
    return x[i] == '=';
}
static char *sgm_fold_line_cont(const char *cmd) {
    long n = sl(cmd), i = 0, o = 0;
    char *s = (char *)mm_alloc(n + 2);
    while (i < n) {
        if (cmd[i] == '\\' && i + 1 < n && cmd[i + 1] == '\n') { i += 2; continue; }
        if (cmd[i] == '\\' && i + 2 < n && cmd[i + 1] == '\r' && cmd[i + 2] == '\n') { i += 3; continue; }
        s[o++] = cmd[i++];
    }
    s[o] = 0;
    return s;
}
static char *sgm_strip_heredocs(const char *cmd0) {
    const char *cmd = sgm_fold_line_cont(cmd0);
    long n = sl(cmd), i = 0, o = 0;
    char *end = 0, *s = (char *)mm_alloc(n + 2);
    while (i <= n) {
        long e = i, j, a, b;
        while (e < n && cmd[e] != '\n') e++;
        if (end) {
            a = i; b = e;
            while (a < b && isws(cmd[a])) a++;
            while (b > a && isws(cmd[b - 1])) b--;
            if (b - a == sl(end) && sw(cmd + a, end)) end = 0;
            i = e + 1;
            continue;
        }
        if (o > 0) s[o++] = '\n';
        mm_copy(s + o, n + 2 - o, cmd + i, e - i);
        o += e - i;
        for (j = i; j + 1 < e; j++) {
            long k = j + 2, st;
            char qc = 0;
            if (cmd[j] != '<' || cmd[j + 1] != '<') continue;
            if (k < e && cmd[k] == '-') k++;
            while (k < e && isws(cmd[k])) k++;
            if (k < e && (cmd[k] == '\'' || cmd[k] == '"')) { qc = cmd[k]; k++; }
            st = k;
            if (!(k < e && (isal(cmd[k]) || cmd[k] == '_'))) continue;
            while (k < e && iswd(cmd[k])) k++;
            if (qc && !(k < e && cmd[k] == qc)) continue;
            end = dupn(cmd + st, k - st);
            break;
        }
        i = e + 1;
    }
    s[o] = 0;
    return s;
}
static void sgm_split_segs(const char *cmd0, char ***out_segs, long *out_n) {
    const char *cmd = sgm_strip_heredocs(cmd0);
    long n = sl(cmd), i = 0, st = 0, cap = 16, ns = 0;
    char **segs = (char **)mm_alloc(sizeof(char *) * cap);
    int in_sq = 0, in_dq = 0;
    while (i <= n) {
        int sep = 0;
        if (i == n) sep = -1;
        else if (!in_sq && !in_dq) {
            if (cmd[i] == '\'' ) { in_sq = 1; i++; continue; }
            if (cmd[i] == '"') { in_dq = 1; i++; continue; }
            if (cmd[i] == '\\' && i + 1 < n) { i += 2; continue; }
            if (cmd[i] == ';' || cmd[i] == '\n' || cmd[i] == '(' || cmd[i] == ')' || cmd[i] == '`') sep = 1;
            else if ((cmd[i] == '&' && cmd[i + 1] == '&') || (cmd[i] == '|' && cmd[i + 1] == '|') || (cmd[i] == '$' && cmd[i + 1] == '(')) sep = 2;
            else if (cmd[i] == '|') sep = 1;
            else if (cmd[i] == '&' && !(i > 0 && (cmd[i - 1] == '>' || cmd[i - 1] == '<')) && cmd[i + 1] != '>') sep = 1;
        } else if (in_sq) {
            if (cmd[i] == '\'') in_sq = 0;
            i++; continue;
        } else {
            if (cmd[i] == '\\' && i + 1 < n) { i += 2; continue; }
            if (cmd[i] == '"') in_dq = 0;
            i++; continue;
        }
        if (sep) {
            long a = st, b = i;
            while (a < b && isws(cmd[a])) a++;
            while (b > a && isws(cmd[b - 1])) b--;
            if (ns == cap) { cap *= 2; char **ns2 = (char **)mm_alloc(sizeof(char *) * cap); mm_copy(ns2, sizeof(char *) * cap, segs, sizeof(char *) * ns); segs = ns2; }
            segs[ns++] = dupn(cmd + a, b - a);
            if (sep < 0) break;
            i += sep; st = i;
        } else i++;
    }
    *out_segs = segs; *out_n = ns;
}
static void sgm_tokenize(const char *seg, char ***out_w, long *out_n) {
    long n = sl(seg), i = 0, cap = 16, nw = 0;
    char **w = (char **)mm_alloc(sizeof(char *) * cap);
    while (i < n) {
        while (i < n && isws(seg[i])) i++;
        if (i >= n) break;
        char *buf = (char *)mm_alloc(n - i + 4);
        long o = 0;
        while (i < n && !isws(seg[i])) {
            if (seg[i] == '\'') {
                i++;
                while (i < n && seg[i] != '\'') buf[o++] = seg[i++];
                if (i < n) i++;
            } else if (seg[i] == '"') {
                i++;
                while (i < n && seg[i] != '"') {
                    if (seg[i] == '\\' && i + 1 < n && (seg[i + 1] == '"' || seg[i + 1] == '\\' || seg[i + 1] == '$' || seg[i + 1] == '`')) i++;
                    buf[o++] = seg[i++];
                }
                if (i < n) i++;
            } else if (seg[i] == '\\' && i + 1 < n) {
                i++; buf[o++] = seg[i++];
            } else {
                buf[o++] = seg[i++];
            }
        }
        buf[o] = 0;
        if (nw == cap) { cap *= 2; char **w2 = (char **)mm_alloc(sizeof(char *) * cap); mm_copy(w2, sizeof(char *) * cap, w, sizeof(char *) * nw); w = w2; }
        w[nw++] = buf;
    }
    *out_w = w; *out_n = nw;
}
static long sgm_unwrap_cmd(char **w, long nw, const char **env_urg_out) {
    long k = 0;
    *env_urg_out = 0;
    while (k < nw) {
        if (eq(w[k], "{")) { k++; continue; }
        if (sgm_is_env_assign(w[k])) {
            if (sw(w[k], "MUX_URGENT=")) *env_urg_out = w[k] + 11;
            k++; continue;
        }
        const char *b = sgm_base(w[k]);
        if (eq(b, "env")) {
            k++;
            while (k < nw && w[k][0] == '-') {
                if (eq(w[k], "--")) { k++; break; }
                if (eq(w[k], "-u") && k + 1 < nw) k += 2;
                else k++;
            }
            continue;
        }
        if (eq(b, "timeout")) {
            k++;
            while (k < nw && w[k][0] == '-') {
                if (eq(w[k], "--")) { k++; break; }
                if ((eq(w[k], "-k") || eq(w[k], "-s")) && k + 1 < nw) k += 2;
                else k++;
            }
            if (k < nw) k++;
            continue;
        }
        if (eq(b, "command")) {
            long ck = k + 1; int lookup = 0;
            while (ck < nw && w[ck][0] == '-') {
                if (eq(w[ck], "--")) { ck++; break; }
                if (has(w[ck], "v") || has(w[ck], "V")) { lookup = 1; break; }
                ck++;
            }
            if (lookup) break;
            k = ck;
            continue;
        }
        if (eq(b, "exec") || eq(b, "nohup") || eq(b, "nice") || eq(b, "stdbuf") || eq(b, "time")) {
            k++;
            while (k < nw && w[k][0] == '-') {
                if (eq(w[k], "--")) { k++; break; }
                if ((eq(w[k], "-a") || eq(w[k], "-n") || eq(w[k], "-i") || eq(w[k], "-o") || eq(w[k], "-e")) && k + 1 < nw) k += 2;
                else k++;
            }
            continue;
        }
        break;
    }
    return k;
}
static int sgm_urgent_active(const char *env_urg) {
    const char *u = env_urg ? env_urg : envs("MUX_URGENT");
    if (!u) return 0;
    long i, nonws = 0;
    for (i = 0; u[i]; i++) if (!isws(u[i])) nonws++;
    return nonws > 0;
}
static int sgm_has_idle_phrase(const char *s) {
    static const char *ps[] = {"待命", "等待新指令", "已就绪", "无后续动作", "按兵不动", "挂机", "静止", 0};
    int i;
    if (!s || !*s) return 0;
    for (i = 0; ps[i]; i++) if (has(s, ps[i])) return 1;
    return 0;
}
static int sgm_has_hex7(const char *s) {
    long i, run = 0;
    if (!s) return 0;
    for (i = 0; ; i++) {
        char c = s[i];
        int hx = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
        if (hx) run++;
        else {
            if (run >= 7 && !iswd(c)) {
                long st = i - run;
                if (st == 0 || !iswd(s[st - 1])) return 1;
            }
            run = 0;
            if (!c) break;
        }
    }
    return 0;
}
static int sgm_has_deliverable_evidence(const char *text) {
    static const char *markers[] = {
        "~/.local/share/", "tools/", "tests/", "plans/", "src/", "cx/", "release/", "build/",
        ".patch", ".tsv", ".md", ".cx", "|---|", "| --- |", "\t",
        "派工", "队列", "裁定", "复核", "子集", "暂停", "(1)", "(2)", "UNCOVERED", "rc0", "rc=0",
        "收到", "预演", "清单", "起链", "状态询问", "请回", 0
    };
    int i;
    if (!text) return 0;
    for (i = 0; markers[i]; i++) if (has(text, markers[i])) return 1;
    if (sgm_has_hex7(text)) return 1;
    return 0;
}
static long sgm_count_targets(const char *tgt) {
    if (!tgt || !*tgt) return 0;
    long c = 1, i;
    for (i = 0; tgt[i]; i++) if (tgt[i] == ',') c++;
    return c;
}
static int sgm_is_all_target(const char *tgt) {
    if (!tgt) return 0;
    return eq(tgt, "@all") || eq(tgt, "all") || has(tgt, ":all") || has(tgt, ":@all") || has(tgt, ",@all");
}
static int sgm_valid_branch(const char *nm) {
    if (!nm || !*nm) return 1;
    if (eq(nm, "main") || sw(nm, "devsvc")) return 1;
    if (nm[0] == 'v' && rs_version(nm + 1)) return 1;
    return 0;
}
static int sgm_is_branch_ch(char c) {
    return isal(c) || isdg(c) || c == '.' || c == '-' || c == '_' || c == '/';
}
static char *sgm_check_branch_name(const char *text) {
    static const char *pats[] = {
        "git checkout -b ", "git checkout -B ", "git switch -c ", "git switch -C ",
        "git worktree add -b ", "git worktree add -B ", "新建分支 ", "切分支 ", 0
    };
    int pi;
    if (!text) return 0;
    for (pi = 0; pats[pi]; pi++) {
        long pl = sl(pats[pi]), n = sl(text), p = 0;
        while (p + pl < n) {
            if (sw(text + p, pats[pi])) {
                long q = p + pl;
                while (q < n && (isws(text[q]) || text[q] == '\'' || text[q] == '"' || text[q] == '`' ||
                       (text[q] == '\\' && q + 1 < n && (text[q + 1] == '\'' || text[q + 1] == '"' || text[q + 1] == '`')))) {
                    if (text[q] == '\\') q += 2; else q++;
                }
                long e = q;
                while (e < n && sgm_is_branch_ch(text[e])) e++;
                if (e > q) {
                    char *br = dupn(text + q, e - q);
                    if (!sgm_valid_branch(br))
                        return fmt("SEND-GATE[BRANCH-NAME] 拒绝:不规范分支名 '%s'(仅允许 main / v0.N.M / devsvc*)", br, 0);
                }
                p = e > q ? e : p + pl;
            } else p++;
        }
    }
    return 0;
}
static int sgm_seg_creates_empty(const char *cmd, long redir_idx) {
    long s = redir_idx;
    while (s > 0 && cmd[s - 1] != ';' && cmd[s - 1] != '\n' && cmd[s - 1] != '&' && cmd[s - 1] != '|') s--;
    while (s < redir_idx && isws(cmd[s])) s++;
    long e = redir_idx;
    while (e > s && isws(cmd[e - 1])) e--;
    if (e == s) return 1;
    char *pre = dupn(cmd + s, e - s);
    if (eq(pre, ":") || eq(pre, "true") || eq(pre, "echo") || sw(pre, "cat /dev/null")) return 1;
    char **w = 0; long nw = 0;
    sgm_tokenize(pre, &w, &nw);
    if (nw <= 0) return 1;
    const char *b = sgm_base(w[0]);
    if (eq(b, "echo") || eq(b, "printf")) {
        long start = 1;
        if (eq(b, "echo")) {
            while (start < nw && (eq(w[start], "-n") || eq(w[start], "-e") || eq(w[start], "-E"))) start++;
        } else {
            if (start < nw && has(w[start], "%")) start++;
        }
        if (start >= nw) return 1;
        long wi, nonws = 0;
        for (wi = start; wi < nw; wi++) {
            long ci;
            for (ci = 0; w[wi][ci]; ci++) if (!isws(w[wi][ci])) { nonws = 1; break; }
        }
        if (!nonws) return 1;
    }
    return 0;
}
static int sgm_same_cmd_creates(const char *cmd, const char *raw_bf, const char *expanded_bf, const char *abs_bf, int *out_empty) {
    if (out_empty) *out_empty = 0;
    if (!cmd || !raw_bf || !*raw_bf) return 0;
    const char *leaf = sgm_base(raw_bf);
    long n = sl(cmd), i, ll = sl(leaf), rl = sl(raw_bf), el = expanded_bf ? sl(expanded_bf) : 0, al = abs_bf ? sl(abs_bf) : 0;
    for (i = 0; i < n; i++) {
        int is_redir = 0;
        long rpos = i;
        if (cmd[i] == '>') {
            is_redir = 1;
            if (i + 1 < n && cmd[i + 1] == '>') i++;
        } else if ((i == 0 || isws(cmd[i - 1]) || cmd[i - 1] == '|' || cmd[i - 1] == ';') && sw(cmd + i, "tee") && isws(cmd[i + 3])) {
            is_redir = 1;
            i += 3;
            while (i < n && isws(cmd[i])) i++;
            if (i + 2 < n && cmd[i] == '-' && cmd[i + 1] == 'a' && isws(cmd[i + 2])) i += 2;
        }
        if (!is_redir) continue;
        long p = i + 1;
        while (p < n && isws(cmd[p])) p++;
        if (p < n && (cmd[p] == '\'' || cmd[p] == '"')) p++;
        long e = p;
        while (e < n && !isws(cmd[e]) && cmd[e] != '\'' && cmd[e] != '"' && cmd[e] != ';' && cmd[e] != '&' && cmd[e] != '|') e++;
        long tl = e - p;
        if (tl <= 0) continue;
        int hit = 0;
        if (tl == rl && sw(cmd + p, raw_bf)) hit = 1;
        else if (el > 0 && tl == el && sw(cmd + p, expanded_bf)) hit = 1;
        else if (al > 0 && tl == al && sw(cmd + p, abs_bf)) hit = 1;
        else if (ll > 0 && tl > ll && cmd[e - ll - 1] == '/' && sw(cmd + e - ll, leaf)) hit = 1;
        if (hit) {
            if (cmd[rpos] == '>' && out_empty && sgm_seg_creates_empty(cmd, rpos)) *out_empty = 1;
            return 1;
        }
    }
    return 0;
}
static int sgm_is_tmp_body_path(const char *raw_bf, const char *expanded_bf, const char *abs_bf) {
    if (raw_bf && (sw(raw_bf, "/tmp/") || sw(raw_bf, "$CLAUDE_JOB_DIR/tmp/") || sw(raw_bf, "${CLAUDE_JOB_DIR}/tmp/") ||
                   sw(raw_bf, "$TMPDIR/") || sw(raw_bf, "${TMPDIR}/"))) return 1;
    if (expanded_bf && (sw(expanded_bf, "/tmp/") || (JOB[0] && sw(expanded_bf, cat2(JOB, "/tmp/"))))) return 1;
    if (abs_bf && (sw(abs_bf, "/tmp/") || (JOB[0] && sw(abs_bf, cat2(JOB, "/tmp/"))))) return 1;
    return 0;
}
static char *sgm_check_mux_cmd_depth(const char *cmd, const char *cwd, int depth, long *send_count_io, const char *inh_urg) {
    if (!has(cmd, "mux") && !has(cmd, "envelope")) return 0;
    char **segs = 0; long ns = 0, si;
    const char *seen_bf[32]; long n_seen_bf = 0;
    sgm_split_segs(cmd, &segs, &ns);
    for (si = 0; si < ns; si++) {
        char **w = 0; long nw = 0, k = 0;
        const char *env_urg = 0;
        sgm_tokenize(segs[si], &w, &nw);
        k = sgm_unwrap_cmd(w, nw, &env_urg);
        if (k >= nw) continue;
        const char *eff_urg = env_urg ? env_urg : inh_urg;
        int urg = sgm_urgent_active(eff_urg);
        const char *base = sgm_base(w[k]);
        if (depth < 1 && sgm_is_sh_cmd(base)) {
            long sk = k + 1;
            while (sk < nw && w[sk][0] == '-') {
                if (sgm_is_sh_c_flag(w[sk]) && sk + 1 < nw) {
                    char *sr = sgm_check_mux_cmd_depth(w[sk + 1], cwd, depth + 1, send_count_io, eff_urg);
                    if (sr) return sr;
                    break;
                }
                sk++;
            }
            continue;
        }
        int is_bcast = 0, is_env = 0;
        long arg_start = -1;
        if (sgm_is_mux_cmd(base)) {
            long mk = k + 1;
            while (mk < nw && w[mk][0] == '-') {
                if ((eq(w[mk], "--session") || eq(w[mk], "-s")) && mk + 1 < nw) { mk += 2; continue; }
                if (sw(w[mk], "--session=")) { mk++; continue; }
                break;
            }
            if (mk < nw && eq(w[mk], "broadcast")) { is_bcast = 1; arg_start = mk + 1; }
            else if (mk < nw && eq(w[mk], "envelope")) { is_env = 1; arg_start = mk + 1; }
        } else if (eq(base, "envelope")) {
            is_env = 1; arg_start = k + 1;
        }
        if (!is_bcast && !is_env) continue;
        if (is_bcast) {
            (*send_count_io)++;
            if (*send_count_io > 2 && !urg) {
                return sdup("SEND-GATE[BROADCAST-IDLE] 拒绝:单条命令串接发信超过上限(最多 2 次),请合并或设 MUX_URGENT='理由'");
            }
            char *btxt = sdup(""); long bi, nonws = 0;
            for (bi = arg_start; bi < nw; bi++) {
                if (bi == arg_start && eq(w[bi], "--")) continue;
                btxt = !*btxt ? sdup(w[bi]) : cat2(cat2(btxt, " "), w[bi]);
            }
            for (bi = 0; btxt[bi]; bi++) if (!isws(btxt[bi])) { nonws = 1; break; }
            if (!nonws)
                return sdup("SEND-GATE[EMPTY-BODY] 拒绝:信封正文不得为空或全空白");
            if (sgm_has_idle_phrase(btxt) && !urg)
                return sdup("SEND-GATE[BROADCAST-IDLE] 拒绝:禁止向广播通道发送裸待命/状态播报;紧急情况请设 MUX_URGENT='理由'");
            {
                char *bwhy = sgm_check_branch_name(btxt);
                if (bwhy) return bwhy;
            }
            continue;
        }
        /* Parse envelope options (read-only; --from confers zero exemption). */
        long i; int dry = 0, help = 0, literal = 0, use_stdin = 0;
        const char *body_file = 0;
        for (i = arg_start; i < nw && (sw(w[i], "--") || eq(w[i], "-h")); i++) {
            const char *a = w[i], *val = 0;
            if (eq(a, "--")) { i++; break; }
            if (eq(a, "--dry-run")) { dry = 1; continue; }
            if (eq(a, "--help") || eq(a, "-h")) { help = 1; continue; }
            if (eq(a, "--literal")) { literal = 1; continue; }
            if (eq(a, "--stdin")) { use_stdin = 1; continue; }
            if (longopt(a, "--body-file", &val)) { body_file = val ? val : (i + 1 < nw ? w[++i] : 0); continue; }
            if (longopt(a, "--from", &val) || longopt(a, "--session", &val) || longopt(a, "--caller-pane", &val)) {
                if (!val && i + 1 < nw) i++;
                continue;
            }
            break;
        }
        if (help || dry || i + 1 >= nw) continue;
        const char *target = w[i], *title = w[i + 1];
        if (sgm_count_targets(target) > 2 && !urg)
            return fmt("SEND-GATE[BROADCAST-IDLE] 拒绝:单次发信逗号分隔收件人超过 2 个(TARGET-CAP > 2): %s", target, 0);
        char *body = sdup("");
        int deferred_body = 0, same_create = 0, same_empty = 0, dup_bf = 0;
        if (!body_file && !use_stdin) {
            long pi;
            for (pi = i + 2; pi < nw; pi++) body = pi == i + 2 ? sdup(w[pi]) : cat2(cat2(body, " "), w[pi]);
            if (!literal && body[0] == '@' && body[1]) body_file = body + 1;
            else if (!literal && eq(body, "-")) use_stdin = 1;
        }
        if (body_file && *body_file) {
            long bi;
            for (bi = 0; bi < n_seen_bf; bi++) if (eq(seen_bf[bi], body_file)) dup_bf = 1;
            if (n_seen_bf < 32) seen_bf[n_seen_bf++] = body_file;
            char *bf = repl_var(repl_home(sdup(body_file)), "CLAUDE_JOB_DIR", JOB);
            char *abs = bf[0] == '/' ? resolve("", bf) : resolve(cwd, bf);
            same_create = sgm_same_cmd_creates(cmd, body_file, bf, abs, &same_empty);
            int is_tmp = sgm_is_tmp_body_path(body_file, bf, abs);
            int has_unexp_var = has(bf, "$");
            sy_stat_t st;
            if (same_create) {
                if (same_empty)
                    return sdup("SEND-GATE[EMPTY-BODY] 拒绝:信封正文不得为空或全空白");
                deferred_body = 1;
            } else if (has_unexp_var) {
                deferred_body = 1;
            } else if (sy_lstat(abs, &st) == 0) {
                unsigned char *fb = 0; int64_t fn = 0;
                if (st.kind == 'f' && sy_read_file(abs, &fb, &fn, 4 << 20) == 0 && fb) {
                    body = dupn((const char *)fb, (long)fn);
                    mm_free(fb);
                } else {
                    return fmt("SEND-GATE[EMPTY-BODY] 拒绝:无法读取信封正文文件 %s(非常规文件/无权限/超 4MiB)", body_file, 0);
                }
            } else if (is_tmp) {
                deferred_body = 1;
            } else {
                return fmt("SEND-GATE[EMPTY-BODY] 拒绝:无法读取信封正文文件 %s(缺失/无权限/超 4MiB)", body_file, 0);
            }
        }
        if (!use_stdin && !deferred_body) {
            long bi, nonws = 0;
            for (bi = 0; body[bi]; bi++) if (!isws(body[bi])) { nonws = 1; break; }
            if (!nonws) return sdup("SEND-GATE[EMPTY-BODY] 拒绝:信封正文不得为空或全空白");
        }
        char *full = deferred_body ? sdup(title) : cat2(cat2(title, "\n"), body);
        const char *ev_src = same_create ? cmd : full;
        int distinct_task = !sgm_is_all_target(target) &&
            ((same_create && !dup_bf && sgm_has_deliverable_evidence(cmd)) ||
             (!deferred_body && sl(body) >= 120 && sgm_has_deliverable_evidence(full)));
        if (!distinct_task) {
            (*send_count_io)++;
            if (*send_count_io > 2 && !urg) {
                return sdup("SEND-GATE[BROADCAST-IDLE] 拒绝:单条命令串接发信超过上限(最多 2 次),请合并或设 MUX_URGENT='理由'");
            }
        }
        if (sgm_is_all_target(target) && sgm_has_idle_phrase(ev_src) && !urg)
            return sdup("SEND-GATE[BROADCAST-IDLE] 拒绝:禁止向 @all 广播待命/闲置状态;紧急情况请设 MUX_URGENT='理由'");
        if ((!deferred_body || same_create) && sgm_has_idle_phrase(ev_src) && !has(ev_src, "[暂停-需裁决]") && !sgm_has_deliverable_evidence(ev_src) && !urg)
            return sdup("SEND-GATE[PAUSE-FORM] 拒绝:无交付物路径/SHA/结构化表且未带 [暂停-需裁决] 的裸待命汇报;紧急情况请设 MUX_URGENT='理由'");
        {
            char *bwhy = sgm_check_branch_name(ev_src);
            if (bwhy) return bwhy;
        }
    }
    return 0;
}
static char *sgm_check_mux_cmd(const char *cmd, const char *cwd) {
    long send_count = 0;
    return sgm_check_mux_cmd_depth(cmd, cwd, 0, &send_count, 0);
}

static double wall_s(void) { sy_ts_t t; if (sy_wall(&t) != 0) return 0; return (double)t.sec + (double)t.nsec / 1e9; }

/* JS Number(str) for the domain table; NaN -> -1e308 sentinel via ok=0 */
static double jsnum(const char *s, int *ok) {
    long a = 0, b = sl(s), i, nd = 0; double v = 0, sg = 1, fr = 0.1; int ex = 0, es = 1;
    *ok = 1;
    while (a < b && isws(s[a])) a++;
    while (b > a && isws(s[b - 1])) b--;
    if (a == b) return 0;
    i = a;
    if (s[i] == '+' || s[i] == '-') { if (s[i] == '-') sg = -1; i++; }
    while (i < b && isdg(s[i])) { v = v * 10 + (s[i] - '0'); i++; nd++; }
    if (i < b && s[i] == '.') { i++; while (i < b && isdg(s[i])) { v += (s[i] - '0') * fr; fr /= 10; i++; nd++; } }
    if (!nd) { *ok = 0; return 0; }
    if (i < b && (s[i] == 'e' || s[i] == 'E')) {
        long d0; i++;
        if (i < b && (s[i] == '+' || s[i] == '-')) { if (s[i] == '-') es = -1; i++; }
        d0 = i; while (i < b && isdg(s[i])) { if (ex < 400) ex = ex * 10 + (s[i] - '0'); i++; }
        if (i == d0) { *ok = 0; return 0; }
        while (ex-- > 0) v = es > 0 ? v * 10 : v / 10;
    }
    if (i != b) { *ok = 0; return 0; }
    return v * sg;
}

static char *domain_owner(const char *path, const char *agent) {
    const char *tab = envs("UNISACC_DOMAINS"); unsigned char *txt = 0; int64_t tn = 0;
    char cw[4096], *p, *other = 0; long i, ls; double now;
    if (!tab) tab = cat2(HOMED, "/.cache/unisacc/domains.tsv");
    if (sy_read_file(tab, &txt, &tn, 1 << 26) != 0) return 0;
    if (path[0] == '/') p = resolve("", path);
    else { if (sy_cwd(cw, sizeof cw) < 0) return 0; p = resolve(cw, path); }
    if (!(eq(p, REPO) || sw(p, cat2(REPO, "/")))) return 0;
    p = p + sl(REPO) + 1;
    now = wall_s();
    for (i = 0, ls = 0; i <= (long)tn; i++) {
        if (i == (long)tn || txt[i] == '\n') {
            char *line = dupn((char *)txt + ls, i - ls), *f[64]; long nf = 0, j, fs = 0, m = i - ls; int ok; double ex;
            ls = i + 1;
            for (j = 0; j <= m && nf < 64; j++) if (j == m || line[j] == '\t') { f[nf++] = dupn(line + fs, j - fs); fs = j + 1; }
            if (nf < 4) continue;
            ex = jsnum(f[2], &ok);
            if (!ok || !(ex > now) || !f[1][0] || !sw(p, f[1])) continue;
            if (eq(f[0], agent)) return 0;
            if (!other) { other = fmt("%s (前缀 %s)", f[0], f[1]); }
        }
    }
    return other;
}

static int fallback_ok(void) {
    sy_stat_t st; sy_ts_t t; long now;
    char *fb = cat2(HOMEV, "/.cache/unisacc/devsvc/native-fallback");
    if (sy_stat(fb, &st) != 0) return 0;
    if (sy_wall(&t) != 0) return 0;
    now = t.sec * 1000 + t.nsec / 1000000;
    return now - st.mtime * 1000 < 30L * 60 * 1000;
}
static int host_own(const char *fp) {
    return sw(fp, cat2(HOMEV, "/.claude/")) || sw(fp, cat2(HOMEV, "/.agents/")) ||
           sw(fp, cat2(HOMEV, "/.cursor/")) || sw(fp, "/tmp/claude-");
}

/* Canonical absolute path: lexical . and .. plus symlink expansion per component (sy_lstat/sy_readlink,
 * at most 40 hops); missing components stay lexical, so a dangling link into the repo still resolves. */
static char *canon(const char *p) {
    char *rest = resolve("", p), *done = sdup(""); int hops = 0;
    while (*rest) {
        long i = 0, s, e; char *cand, buf[4096]; sy_stat_t st;
        while (rest[i] == '/') i++;
        s = i; while (rest[i] && rest[i] != '/') i++; e = i;
        if (e == s) break;
        cand = cat2(cat2(done, "/"), dupn(rest + s, e - s));
        rest = sdup(rest + e);
        if (sy_lstat(cand, &st) == 0 && st.kind == 'l' && hops < 40) {
            long n = sy_readlink(cand, buf, sizeof buf - 1);
            if (n > 0) {
                buf[n] = 0; hops++;
                rest = buf[0] == '/' ? resolve("", cat2(buf, rest)) : resolve(*done ? done : "/", cat2(buf, rest));
                done = sdup("");
                continue;
            }
        }
        done = cand;
    }
    return *done ? done : sdup("/");
}
static int under(const char *p, const char *d) { return eq(p, d) || sw(p, cat2(d, "/")); }
/* 1 when FP (raw or canonical) lands in the repo (incl. .claude/worktrees) */
static int in_repo_fp(const char *fp, const char *cp) {
    return under(resolve("", fp), REPO) || under(cp, REPO) || under(cp, canon(REPO));
}
/* out-of-repo scratch areas a native Read/Edit/Write may use: /tmp, $CLAUDE_JOB_DIR, ~/.cache, ~/.agents, ~/.cursor */
static int scratch_fp(const char *cp) {
    return sw(cp, "/tmp/") || (*JOB && (under(cp, JOB) || under(cp, canon(JOB)))) ||
           sw(cp, cat2(HOMED, "/.cache/")) || sw(cp, cat2(HOMED, "/.agents/")) || sw(cp, cat2(HOMED, "/.cursor/"));
}

static void iso_now(char *d, long cap) {
    sy_ts_t t; long z, era, doe, yoe, y, doy, mp, dd, mm, sec;
    sy_wall(&t);
    sec = t.sec % 86400; z = t.sec / 86400 + 719468;
    era = (z >= 0 ? z : z - 146096) / 146097; doe = z - era * 146097;
    yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365; y = yoe + era * 400;
    doy = doe - (365 * yoe + yoe / 4 - yoe / 100); mp = (5 * doy + 2) / 153;
    dd = doy - (153 * mp + 2) / 5 + 1; mm = mp < 10 ? mp + 3 : mp - 9; if (mm <= 2) y++;
    tx_snprintf(d, cap, "%04ld-%02ld-%02ldT%02ld:%02ld:%02ld.%03ldZ", y, mm, dd, sec / 3600, sec / 60 % 60, sec % 60, t.nsec / 1000000);
}

/* cmd.slice(0,120) in UTF-16 units, \t\r\n -> space; a split surrogate pair becomes U+FFFD */
static char *c120(const char *s) {
    long n = sl(s), i = 0, u = 0, o = 0; char *d = (char *)mm_alloc(n + 4);
    while (i < n && u < 120) {
        unsigned char c = (unsigned char)s[i]; long l = c < 0x80 ? 1 : c < 0xE0 ? 2 : c < 0xF0 ? 3 : 4;
        if (l == 4) { if (u + 2 > 120) { d[o++] = (char)0xEF; d[o++] = (char)0xBF; d[o++] = (char)0xBD; u++; break; } u += 2; } else u++;
        for (; l > 0 && i < n; l--) { char ch = s[i++]; d[o++] = (ch == '\t' || ch == '\r' || ch == '\n') ? ' ' : ch; }
    }
    d[o] = 0;
    return d;
}

static int rx_word_cmd(const char *cmd, const char *w1, const char **subs) {
    /* /\bW1\s+(SUB1|SUB2..)\b/ */
    long n = sl(cmd), p, m = sl(w1);
    for (p = 0; p < n; p++) {
        long q; int si;
        if (!wb_at(cmd, p) || !sw(cmd + p, w1)) continue;
        q = p + m;
        if (!(q < n && isws(cmd[q]))) continue;
        while (q < n && isws(cmd[q])) q++;
        for (si = 0; subs[si]; si++) { long l = sl(subs[si]); if (sw(cmd + q, subs[si]) && !iswd(cmd[q + l])) return 1; }
    }
    return 0;
}
static int rx_direct_cx(const char *cmd) {
    long n = sl(cmd), p;
    for (p = 0; p < n; p++) {
        long q, e, j;
        if (!sw(cmd + p, "unisacc.com")) continue;
        q = p + 11;
        if (!(q < n && isws(cmd[q]))) continue;
        while (q < n && isws(cmd[q])) q++;
        if (!sw(cmd + q, "tools/")) continue;
        q += 6;
        if (sw(cmd + q, "devsvc.cx")) continue;
        e = q; while (e < n && (iswd(cmd[e]) || cmd[e] == '.' || cmd[e] == '-')) e++;
        for (j = q + 1; j + 3 <= e; j++) if (sw(cmd + j, ".cx")) return 1;
    }
    return 0;
}
static int rx_sleep(const char *cmd) {
    long n = sl(cmd), p;
    for (p = 0; p < n; p++) {
        long q;
        if (!wb_at(cmd, p) || !sw(cmd + p, "sleep")) continue;
        q = p + 5;
        if (!(q < n && isws(cmd[q]))) continue;
        while (q < n && isws(cmd[q])) q++;
        if (isdg(cmd[q])) return 1;
    }
    return 0;
}
static int rx_pipe(const char *cmd) {
    long n = sl(cmd), p; static const char *ws[4] = {"head", "tail", "grep", 0};
    for (p = 0; p < n; p++) {
        long q = p + 1; int i;
        if (cmd[p] != '|') continue;
        while (q < n && isws(cmd[q])) q++;
        for (i = 0; ws[i]; i++) if (sw(cmd + q, ws[i]) && !iswd(cmd[q + 4])) return 1;
    }
    return 0;
}

static void warn(const char *cmd, const js_val *root) {
    int viaDev = has(cmd, "tools/devsvc.cx"), nh = 0, i;
    const char *r[5], *tip[5];
    static const char *cp[3] = {"commit", "push", 0};
    static const char *rd[5] = {"status", "log", "diff", "show", 0};
    if (rx_word_cmd(cmd, "git", cp) && !viaDev) { r[nh] = "git-write"; tip[nh++] = "用 devsvc git commit/merge/add:sh ./unisacc.com tools/devsvc.cx -- git commit -m '说明' --whole 路径 --push"; }
    if (rx_direct_cx(cmd) && !viaDev) { r[nh] = "direct-cx"; tip[nh++] = "sh ./unisacc.com tools/devsvc.cx -- x --par 1 --bg -- ... 加 wait,或 x --par 1 --tail N"; }
    if (rx_word_cmd(cmd, "git", rd) && !viaDev) { r[nh] = "git-read"; tip[nh++] = "sh ./unisacc.com tools/devsvc.cx -- git log(status/diff/show 同)"; }
    if (rx_sleep(cmd)) { r[nh] = "sleep-poll"; tip[nh++] = "用 devsvc x --par 1 --bg 加 wait,不用 sleep 轮询"; }
    if (rx_pipe(cmd)) { r[nh] = "pipe-trim"; tip[nh++] = "用 devsvc x --par 1 --tail N 截短输出,不用管道 head/tail/grep"; }
    if (!nh) return;
    {
        char *dir = cat2(HOMEV, "/.cache/unisacc/devsvc"), *path = cat2(dir, "/hook-warn.tsv"), *c = c120(cmd), ts[64];
        const js_val *sv = js_get(root, "session_id"); const char *sid = "-"; char nb[64];
        if (js_kind(sv) == JS_STR) sid = js_str(sv);
        else if (js_kind(sv) == JS_BOOL) sid = js_bool(sv) ? "true" : "false";
        else if (js_kind(sv) == JS_NUM) { double d = js_num(sv); if (d == (double)(long)d) tx_snprintf(nb, sizeof nb, "%ld", (long)d); else tx_snprintf(nb, sizeof nb, "%.17g", d); sid = nb; }
        else if (js_kind(sv) == JS_ARR || js_kind(sv) == JS_OBJ) sid = js_kind(sv) == JS_ARR ? "" : "[object Object]";
        if (sy_mkdir_all(dir, 0755) != 0) return;
        for (i = 0; i < nh; i++) {
            long cap = sl(sid) + sl(c) + 128; char *line = (char *)mm_alloc(cap);
            sy_eprintf("DEVSVC-WARN(%s):建议 %s\n", r[i], tip[i]);
            iso_now(ts, sizeof ts);
            tx_snprintf(line, cap, "%s\t%s\t%s\t%s\n", ts, sid, r[i], c);
            if (sy_append_file(path, line, sl(line), 0644) != 0) return;
        }
    }
}

static long read_all(char **out) {
    long cap = 1 << 16, n = 0, g; char *b = (char *)mm_alloc(cap + 1);
    while ((g = sy_read_once(0, b + n, cap - n)) > 0) {
        n += g;
        if (n == cap) { char *nb2 = (char *)mm_alloc(cap * 2 + 1); mm_copy(nb2, cap * 2 + 1, b, n); mm_free(b); b = nb2; cap *= 2; }
    }
    b[n] = 0; *out = b; return n;
}

int main(void) {
    char *in, err[128]; long n = read_all(&in); js_val *root; const js_val *tn, *ti, *v;
    const char *h = envs("HOME"), *gr = envs("GUARD_REPO"), *tname;
    HOMEV = h ? h : ""; HOMED = sdup(h ? h : "/home/devali");
    REPO = gr ? sdup(gr) : cat2(HOMED, "/repos/unisacc");
    JOB = envs("CLAUDE_JOB_DIR"); if (!JOB) JOB = "";
    SAFE3 = cat2(HOMED, "/cc-work/"); SAFE4 = *JOB ? cat2(JOB, "/") : 0;
    root = js_parse(in, n, err, sizeof err);
    if (!root) return 0;
    tn = js_get(root, "tool_name"); ti = js_get(root, "tool_input");
    tname = js_kind(tn) == JS_STR ? js_str(tn) : 0;
    if (tname && (eq(tname, "Read") || eq(tname, "Edit") || eq(tname, "Write"))) {
        const char *fp; int rd = eq(tname, "Read");
        v = js_get(ti, "file_path");
        if (js_kind(v) == JS_STR) fp = js_str(v);
        else if (js_kind(v) == JS_NONE || js_kind(v) == JS_NULL) fp = "";
        else return 0;
        if (*fp && fp[0] == '/' && !in_repo_fp(fp, canon(fp)) && (host_own(fp) || scratch_fp(canon(fp)))) {
            /* out-of-repo scratch: allowed */
        } else if (*fp && fp[0] == '/' && !in_repo_fp(fp, canon(fp)) && !fallback_ok()) {
            sy_eprintf("DEVSVC-ONLY 拒绝:%s 不在仓内也不在仓外放行区(/tmp、$CLAUDE_JOB_DIR、~/.cache、~/.claude)。仓外放行区内的临时文件可直接 Read/Edit/Write;其余路径不经原生工具改。\n", fp);
            return 2;
        } else if (*fp && !rd && !fallback_ok()) {
            sy_eprintf("DEVSVC-ONLY 拒绝:仓内文件 %s 须经 devsvc 修改:sh ./unisacc.com tools/devsvc.cx -- f edit PATH --old-file A --new-file B 或 f write PATH --from SRC(或 flow - --par N 的 file.edit/file.write 节点),用法见 plans/devsvc.md 5a。devsvc 确实不可用时才 touch %s/.cache/unisacc/devsvc/native-fallback(30 分钟有效)并把原因报主调度。\n", fp, HOMEV);
            return 2;
        }
        if (!rd && *fp) {
            const char *dow = envs("DEVSVC_OWNER");
            const js_val *cv = js_get(root, "cwd");
            const char *ecwd = js_kind(cv) == JS_STR ? js_str(cv) : "";
            if ((dow && *dow) || (*ecwd && own_wtree_root(ecwd))) {
                char *sc = shared_checkout_write_bad(fp, ecwd, envs("UNISACC_FLOW_ROOT"), dow);
                if (sc) {
                    sy_eprintf("GUARD-EDIT-V1 拒绝:%s (target=%s)\n", sc, fp);
                    return 2;
                }
            }
        }
        if (!rd) {
            const char *agent = envs("UNISACC_AGENT");
            if (agent && *agent && *fp) {
                char *o = domain_owner(fp, agent);
                if (o) { sy_eprintf("GUARD-EDIT-V1 拒绝:%s 的写域被 %s 占用,当前代理 %s。先 sh ./unisacc.com tools/domain.cx -- check PATH 查看,或等对方 release/到期。\n", fp, o, agent); return 2; }
            }
        }
        return 0;
    }
    {
        int k = js_kind(tn), truthy = (k == JS_STR && *js_str(tn)) || (k == JS_NUM && js_num(tn) != 0) || (k == JS_BOOL && js_bool(tn)) || k == JS_ARR || k == JS_OBJ;
        const char *cmd, *cwd = "";
        if (truthy && !(tname && eq(tname, "Bash"))) return 0;
        v = js_get(ti, "command");
        if (js_kind(v) != JS_STR || !*js_str(v)) return 0;
        cmd = js_str(v);
        v = js_get(root, "cwd");
        if (js_kind(v) == JS_STR) cwd = js_str(v);
        {
            char *why = check(cmd, cwd, 0);
            if (!why) { warn(cmd, root); return 0; }
            if (sw(why, "SEND-GATE[")) { sy_eprintf("%s\n", why); return 2; }
            sy_eprintf("GUARD-EDIT-V1 拒绝:%s。仓内文件只用 Edit/Write 工具或 .cx 工具(tools/edit-span.cx、tools/refactor.cx)修改;临时产物写 $CLAUDE_JOB_DIR/tmp 或 /tmp,不要建克隆或 out/ 子目录。协同决定写入 prd_mempalace.md,不追加过程账本\n", why);
            return 2;
        }
    }
}
