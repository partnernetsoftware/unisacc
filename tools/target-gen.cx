#pragma unisa use sys.io
#pragma unisa use text.text
/* Project exec/facts/pp-targets.tsv onto the compiler and runtime target tables.
   sh ./unisacc.com tools/target-gen.cx -- --check
   sh ./unisacc.com tools/target-gen.cx -- --write
   The fact table is the only name list. A row is os, arch, run_launch, then tape_default.
   _self/_self_launch pick this slice's row by the first os/arch macro of
   exec/pp/predefines.tsv.
   Exactly six data rows. A null out-pointer returns 4.
   An index outside 0..count-1 returns 2.
   No libc and no include. */
#define TSV "exec/facts/pp-targets.tsv"
#define PRE "exec/pp/predefines.tsv"
#define NTARGET 6
#define NAMEMAX 32
#define FILECAP 4096
#define CHECKCAP 8192

#define SYSTSV "exec/facts/sys-syscalls.tsv"
#define SYSCAP 65536
#define NSYS 57
#define NSYSCOL 7

typedef struct { char name[NAMEMAX]; long long value[NSYSCOL]; } SysRow;
static SysRow sysrows[NSYS];
static int nsysrows;
typedef struct {
    char os[NAMEMAX];
    char arch[NAMEMAX];
    char launch[NAMEMAX];
    char tape_default[NAMEMAX];
} Row;

typedef struct { char name[NAMEMAX]; char mac[NAMEMAX]; } Mac;
static Mac macs[8];
static int nmacs;

static Row rows[NTARGET];
static int nrows;

static int fail(const char *why) {
    sy_eprintf("target-gen\tFAIL\t%s\n", why);
    return 1;
}

static int ident(const char *s, int n) {
    int i;
    if (n < 1 || n >= NAMEMAX) return 0;
    if (!((s[0] >= 'a' && s[0] <= 'z') || s[0] == '_')) return 0;
    for (i = 1; i < n; i++) {
        char c = s[i];
        if (c >= 'a' && c <= 'z') continue;
        if (c >= '0' && c <= '9') continue;
        if (c == '_') continue;
        return 0;
    }
    return 1;
}

static void copy_field(char *dst, const char *s, int n) {
    int i;
    for (i = 0; i < n; i++) dst[i] = s[i];
    dst[n] = 0;
}

static int take_row(const char *line, int n) {
    const char *f[4];
    int len[4];
    int i, k, start;
    if (nrows >= NTARGET) return fail("target-count");
    k = 0;
    start = 0;
    for (i = 0; i <= n; i++) {
        if (i == n || line[i] == '\t') {
            if (k >= 4) return fail("row-fields");
            f[k] = line + start;
            len[k] = i - start;
            k++;
            start = i + 1;
        }
    }
    if (k != 4) return fail("row-fields");
    if (!ident(f[0], len[0]) || !ident(f[1], len[1]) || !ident(f[2], len[2])) return fail("row-charset");
    copy_field(rows[nrows].os, f[0], len[0]);
    copy_field(rows[nrows].arch, f[1], len[1]);
    copy_field(rows[nrows].launch, f[2], len[2]);
    if (len[3] <= 0 || len[3] >= NAMEMAX) return fail("tape-default-bound");
    copy_field(rows[nrows].tape_default, f[3], len[3]);
    if (!tx_eqz(rows[nrows].tape_default, "lnx/x86_64") &&
        !tx_eqz(rows[nrows].tape_default, "osx/x86_64") &&
        !tx_eqz(rows[nrows].tape_default, "osx/arm64")) return fail("tape-default-target");
    nrows++;
    return 0;
}

static int parse_tsv(char *b, size_t n) {
    size_t i = 0;
    int saw = 0;
    if (n == 0 || b[n - 1] != '\n') return fail("tsv-newline");
    while (i < n) {
        size_t e = i;
        while (e < n && b[e] != '\n') e++;
        b[e] = 0;
        if (e == i) return fail("tsv-blank");
        if (!saw) {
            if (!tx_eqz(b + i, "# os\tarch\trun_launch\ttape_default")) return fail("tsv-header");
            saw = 1;
        } else if (b[i] == '#') {
            return fail("tsv-comment");
        } else if (take_row(b + i, (int)(e - i))) {
            return 1;
        }
        i = e + 1;
    }
    if (nrows != NTARGET) return fail("target-count");
    return 0;
}

/* os and arch rows of predefines.tsv: kind, name, first macro. */
static int parse_pre(char *b, size_t n) {
    size_t i = 0;
    while (i < n) {
        size_t e = i, t1, t2;
        while (e < n && b[e] != '\n') e++;
        b[e] = 0;
        if (tx_prefix(b + i, (int)(e - i), "os\t", 3) || tx_prefix(b + i, (int)(e - i), "arch\t", 5)) {
            t1 = i; while (b[t1] != '\t') t1++;
            t2 = t1 + 1; while (t2 < e && b[t2] != '\t') t2++;
            i = t2 + 1; while (i < e && b[i] != '\t') i++;
            if (nmacs >= 8 || t2 - t1 - 1 >= NAMEMAX || i - t2 - 1 >= NAMEMAX || i - t2 < 2) return fail("pre-row");
            copy_field(macs[nmacs].name, b + t1 + 1, (int)(t2 - t1 - 1));
            copy_field(macs[nmacs].mac, b + t2 + 1, (int)(i - t2 - 1));
            nmacs++;
        }
        i = e + 1;
    }
    return 0;
}

static const char *mac_of(const char *name) {
    int i;
    for (i = 0; i < nmacs; i++) if (tx_eqz(macs[i].name, name)) return macs[i].mac;
    return 0;
}

static int unique_pairs(void) {
    int i, j;
    for (i = 0; i < nrows; i++) {
        for (j = i + 1; j < nrows; j++) {
            if (tx_eqz(rows[i].os, rows[j].os) && tx_eqz(rows[i].arch, rows[j].arch))
                return fail("pair-dup");
        }
    }
    return 0;
}

static int app(char *dst, int cap, int *n, const char *s) {
    int i = 0;
    while (s[i]) {
        if (*n + 1 >= cap) return -1;
        dst[*n] = s[i];
        *n += 1;
        i++;
    }
    dst[*n] = 0;
    return 0;
}

static int app_digit(char *dst, int cap, int *n, int d) {
    char s[2];
    if (d < 0 || d > 9) return -1;
    s[0] = (char)('0' + d);
    s[1] = 0;
    return app(dst, cap, n, s);
}
/* All exported enums are unconditional. Signed high halves preserve negative
   sentinels; consumers multiply by 65536L to preserve the original long type. */
static int parse_sys(char *b, size_t nb) {
    size_t i = 0;
    int header = 0;
    if (!nb || b[nb - 1] != '\n') return fail("sys-newline");
    while (i < nb) {
        size_t e = i, p;
        int col = 0, start = (int)i, j;
        while (e < nb && b[e] != '\n') e++;
        b[e] = 0;
        if (!header) {
            char expected[512];
            int hn = 0;
            expected[0] = 0;
            if (app(expected, 512, &hn, "# name")) return fail("sys-header");
            for (j = 0; j < nrows; j++) {
                if (app(expected, 512, &hn, "\t") || app(expected, 512, &hn, rows[j].os) ||
                    app(expected, 512, &hn, "_") || app(expected, 512, &hn, rows[j].arch)) return fail("sys-header");
            }
            if (app(expected, 512, &hn, "\tfallback") || !tx_eqz(b + i, expected)) return fail("sys-header");
            header = 1;
            i = e + 1;
            continue;
        }
        if (nsysrows >= NSYS) return fail("sys-count");
        for (p = i; p <= e; p++) {
            if (p == e || b[p] == '\t') {
                if (col == 0) {
                    if (!ident(b + start, (int)p - start)) return fail("sys-name");
                    copy_field(sysrows[nsysrows].name, b + start, (int)p - start);
                    for (j = 0; j < nsysrows; j++)
                        if (tx_eqz(sysrows[j].name, sysrows[nsysrows].name)) return fail("sys-dup");
                } else {
                    long long v = 0;
                    int k = start, neg = 0;
                    if (col > NSYSCOL) return fail("sys-fields");
                    if (k < (int)p && b[k] == '-') { neg = 1; k++; }
                    if (k == (int)p) return fail("sys-number");
                    for (; k < (int)p; k++) {
                        if (b[k] < '0' || b[k] > '9') return fail("sys-number");
                        if (v > 429496729LL) return fail("sys-range");
                        v = v * 10 + b[k] - '0';
                        if (v > 4294967295LL) return fail("sys-range");
                    }
                    sysrows[nsysrows].value[col - 1] = neg ? -v : v;
                }
                col++;
                start = (int)p + 1;
            }
        }
        if (col != NSYSCOL + 1) return fail("sys-fields");
        nsysrows++;
        i = e + 1;
    }
    return nsysrows == NSYS ? 0 : fail("sys-count");
}

static int app_number(char *dst, int cap, int *n, long v) {
    char s[16];
    int k = 0;
    if (v < 0) { if (app(dst, cap, n, "-")) return -1; v = -v; }
    do { s[k++] = (char)('0' + v % 10); v /= 10; } while (v);
    while (k) { char digit[2]; digit[0] = s[--k]; digit[1] = 0; if (app(dst, cap, n, digit)) return -1; }
    return 0;
}

static int emit_sys(char *dst, int cap) {
    int n = 0, i, j;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa module sysnums\n/* Generated by tools/target-gen.cx from exec/facts/sys-syscalls.tsv.\n   Do not edit by hand. Unconditional 16-bit halves; combine as hi * 65536L + lo. */\nenum {\n")) return -1;
    for (i = 0; i < nsysrows; i++) {
        for (j = 0; j < NSYSCOL; j++) {
            long long v = sysrows[i].value[j];
            long hi = (long)(v / 65536LL), lo = (long)(v % 65536LL);
            if (lo < 0) { hi--; lo += 65536L; }
            if (app(dst, cap, &n, "    sn_")) return -1;
            if (j < nrows) {
                if (app(dst, cap, &n, rows[j].os) || app(dst, cap, &n, "_") || app(dst, cap, &n, rows[j].arch)) return -1;
            } else if (app(dst, cap, &n, "fallback")) return -1;
            if (app(dst, cap, &n, "_") || app(dst, cap, &n, sysrows[i].name) || app(dst, cap, &n, "_hi = ") || app_number(dst, cap, &n, hi) || app(dst, cap, &n, ", sn_")) return -1;
            if (j < nrows) {
                if (app(dst, cap, &n, rows[j].os) || app(dst, cap, &n, "_") || app(dst, cap, &n, rows[j].arch)) return -1;
            } else if (app(dst, cap, &n, "fallback")) return -1;
            if (app(dst, cap, &n, "_") || app(dst, cap, &n, sysrows[i].name) || app(dst, cap, &n, "_lo = ") || app_number(dst, cap, &n, lo) || app(dst, cap, &n, ",\n")) return -1;
        }
    }
    if (app(dst, cap, &n, "};\n")) return -1;
    return n;
}

static int emit_mod(char *dst, int cap, const char *prefix) {
    int n = 0, i;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa module targetname\n")) return -1;
    if (app(dst, cap, &n, "/* Generated by tools/target-gen.cx from exec/facts/pp-targets.tsv.\n")) return -1;
    if (app(dst, cap, &n, "   Do not edit by hand. os is the os column. arch is the arch column.\n")) return -1;
    if (app(dst, cap, &n, "   A null out-pointer returns 4. An index outside 0..count-1 returns 2.\n")) return -1;
    if (app(dst, cap, &n, "   No libc and no include. */\n")) return -1;
    if (app(dst, cap, &n, "int ")) return -1;
    if (app(dst, cap, &n, prefix)) return -1;
    if (app(dst, cap, &n, "_count(void) {\n    return ")) return -1;
    if (app_digit(dst, cap, &n, nrows)) return -1;
    if (app(dst, cap, &n, ";\n}\n")) return -1;
    if (app(dst, cap, &n, "int ")) return -1;
    if (app(dst, cap, &n, prefix)) return -1;
    if (app(dst, cap, &n, "_at(int index, const char **os, const char **arch) {\n")) return -1;
    if (app(dst, cap, &n, "    if (!os || !arch) return 4;\n")) return -1;
    for (i = 0; i < nrows; i++) {
        if (app(dst, cap, &n, "    if (index == ")) return -1;
        if (app_digit(dst, cap, &n, i)) return -1;
        if (app(dst, cap, &n, ") { *os = \"")) return -1;
        if (app(dst, cap, &n, rows[i].os)) return -1;
        if (app(dst, cap, &n, "\"; *arch = \"")) return -1;
        if (app(dst, cap, &n, rows[i].arch)) return -1;
        if (app(dst, cap, &n, "\"; return 0; }\n")) return -1;
    }
    if (app(dst, cap, &n, "    return 2;\n}\n")) return -1;
    return n;
}

/* cx/sys/hostid.cx: this slice's row, chosen by predefines.tsv macros. */
static int emit_host(char *dst, int cap) {
    int n = 0, i;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa module hostid\n/* Generated by tools/target-gen.cx from exec/facts/pp-targets.tsv and\n")) return -1;
    if (app(dst, cap, &n, "   exec/pp/predefines.tsv. Do not edit by hand. One branch per row, in\n   file order: the target this slice was built for and its run_launch. */\n")) return -1;
    for (i = 0; i < nrows; i++) {
        const char *mo = mac_of(rows[i].os), *ma = mac_of(rows[i].arch);
        if (!mo || !ma) return -1;
        if (app(dst, cap, &n, i ? "#elif defined(" : "#if defined(") || app(dst, cap, &n, mo)) return -1;
        if (app(dst, cap, &n, ") && defined(") || app(dst, cap, &n, ma) || app(dst, cap, &n, ")\n#define SELF_TARGET \"")) return -1;
        if (app(dst, cap, &n, rows[i].os) || app(dst, cap, &n, "/") || app(dst, cap, &n, rows[i].arch)) return -1;
        if (app(dst, cap, &n, "\"\n#define SELF_LAUNCH \"") || app(dst, cap, &n, rows[i].launch) || app(dst, cap, &n, "\"\n#define SELF_TAPE_DEFAULT \"") || app(dst, cap, &n, rows[i].tape_default) || app(dst, cap, &n, "\"\n")) return -1;
    }
    if (app(dst, cap, &n, "#else\n#define SELF_TARGET 0\n#define SELF_LAUNCH 0\n#define SELF_TAPE_DEFAULT 0\n#endif\n")) return -1;
    if (app(dst, cap, &n, "const char *tn_self(void) {\n    return SELF_TARGET;\n}\nconst char *tn_self_launch(void) {\n    return SELF_LAUNCH;\n}\nconst char *tn_self_tape_default(void) {\n    return SELF_TAPE_DEFAULT;\n}\n")) return -1;
    return n;
}

static int emit_check(char *dst, int cap) {
    int n = 0, i;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa use compiler.targetname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use runtime.targetname\n#pragma unisa use sys.hostid\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use sys.io\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use text.text\n")) return -1;
    if (app(dst, cap, &n, "/* Generated by tools/target-gen.cx. Narrow check of the six target rows. */\n")) return -1;
    if (app(dst, cap, &n, "int main(void) {\n")) return -1;
    if (app(dst, cap, &n, "    const char *os; const char *arch; const char **missing;\n")) return -1;
    if (app(dst, cap, &n, "    missing = 0;\n")) return -1;
    if (app(dst, cap, &n, "    if (tn_count() != 6) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rtt_count() != 6) return 1;\n")) return -1;
    for (i = 0; i < nrows; i++) {
        if (app(dst, cap, &n, "    if (tn_at(")) return -1;
        if (app_digit(dst, cap, &n, i)) return -1;
        if (app(dst, cap, &n, ", &os, &arch) || !tx_eqz(os, \"")) return -1;
        if (app(dst, cap, &n, rows[i].os)) return -1;
        if (app(dst, cap, &n, "\") || !tx_eqz(arch, \"")) return -1;
        if (app(dst, cap, &n, rows[i].arch)) return -1;
        if (app(dst, cap, &n, "\")) return 1;\n")) return -1;
        if (app(dst, cap, &n, "    if (rtt_at(")) return -1;
        if (app_digit(dst, cap, &n, i)) return -1;
        if (app(dst, cap, &n, ", &os, &arch) || !tx_eqz(os, \"")) return -1;
        if (app(dst, cap, &n, rows[i].os)) return -1;
        if (app(dst, cap, &n, "\") || !tx_eqz(arch, \"")) return -1;
        if (app(dst, cap, &n, rows[i].arch)) return -1;
        if (app(dst, cap, &n, "\")) return 1;\n")) return -1;
        if (app(dst, cap, &n, "    if (tx_eqz(tn_self(), \"") || app(dst, cap, &n, rows[i].os) || app(dst, cap, &n, "/")) return -1;
        if (app(dst, cap, &n, rows[i].arch) || app(dst, cap, &n, "\") && !tx_eqz(tn_self_launch(), \"")) return -1;
        if (app(dst, cap, &n, rows[i].launch) || app(dst, cap, &n, "\")) return 1;\n")) return -1;
        if (app(dst, cap, &n, "    if (tx_eqz(tn_self(), \"") || app(dst, cap, &n, rows[i].os) || app(dst, cap, &n, "/") || app(dst, cap, &n, rows[i].arch) || app(dst, cap, &n, "\") && !tx_eqz(tn_self_tape_default(), \"") || app(dst, cap, &n, rows[i].tape_default) || app(dst, cap, &n, "\")) return 1;\n")) return -1;
    }
    if (app(dst, cap, &n, "    if (!tn_self() || !tn_self_launch() || !tn_self_tape_default()) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (tn_at(0, missing, &arch) != 4) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (tn_at(0, &os, missing) != 4) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rtt_at(0, missing, &arch) != 4) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rtt_at(0, &os, missing) != 4) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (tn_at(-1, &os, &arch) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (tn_at(6, &os, &arch) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rtt_at(-1, &os, &arch) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rtt_at(6, &os, &arch) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    sy_printf(\"CX_TARGET\\tok=6\\tfailed=0\\n\");\n")) return -1;
    if (app(dst, cap, &n, "    return 0;\n}\n")) return -1;
    return n;
}

static int same_bytes(const char *a, size_t an, const char *b, int bn) {
    int i;
    if (an != (size_t)bn) return 0;
    for (i = 0; i < bn; i++) if (a[i] != b[i]) return 0;
    return 1;
}

static int one_file(int dowrite, const char *path, const char *body, int n) {
    size_t on = 0;
    char *cur;
    if (dowrite) {
        if (cx_write(path, body, (size_t)n)) return fail("write");
        return 0;
    }
    cur = cx_read(path, &on);
    if (!cur) return fail(path);
    if (!same_bytes(cur, on, body, n)) return fail(path);
    return 0;
}

int main(int argc, char **argv) {
    size_t nb = 0;
    char *b;
    char file[FILECAP], check[CHECKCAP];
    char sysfile[SYSCAP];
    int dowrite, fn, cn;
    if (argc != 2 || (!tx_eqz(argv[1], "--check") && !tx_eqz(argv[1], "--write"))) {
        sy_eprintf("target-gen\tusage\t--check|--write\n");
        return 2;
    }
    dowrite = tx_eqz(argv[1], "--write");
    b = cx_read(TSV, &nb);
    if (!b) return fail("tsv-read");
    if (parse_tsv(b, nb)) return 1;
    if (unique_pairs()) return 1;
    b = cx_read(PRE, &nb);
    if (!b) return fail("pre-read");
    if (parse_pre(b, nb)) return 1;
    b = cx_read(SYSTSV, &nb);
    if (!b) return fail("sys-read");
    if (parse_sys(b, nb)) return 1;
    fn = emit_sys(sysfile, SYSCAP);
    if (fn < 0) return fail("emit-sysnums");
    if (one_file(dowrite, "cx/sys/sysnums.cx", sysfile, fn)) return 1;
    cn = emit_check(check, CHECKCAP);
    if (cn < 0) return fail("emit-check");
    fn = emit_mod(file, FILECAP, "tn");
    if (fn < 0) return fail("emit-compiler");
    if (one_file(dowrite, "cx/compiler/targetname.cx", file, fn)) return 1;
    fn = emit_mod(file, FILECAP, "rtt");
    if (fn < 0) return fail("emit-runtime");
    if (one_file(dowrite, "cx/runtime/targetname.cx", file, fn)) return 1;
    fn = emit_host(file, FILECAP);
    if (fn < 0) return fail("emit-hostid");
    if (one_file(dowrite, "cx/sys/hostid.cx", file, fn)) return 1;
    if (one_file(dowrite, "tools/check-cx-target.cx", check, cn)) return 1;
    if (dowrite) sy_printf("TARGET_GEN\tWROTE\trows=%d\n", nrows);
    else sy_printf("TARGET_GEN\tCHECK\trows=%d\n", nrows);
    return 0;
}
