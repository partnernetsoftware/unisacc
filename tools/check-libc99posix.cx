#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use text.text
#pragma unisa use compiler.libc99bind
/* Fact drift is refused; both Windows targets compile the public P0 header
   surface, including the four cx-own bodies (not CRT aliases), with -c -funit. */
static int bad;

static int fail(const char *w) {
    sy_eprintf("check-libc99posix\tFAIL\t%s\n", w);
    bad = 1;
    return 1;
}

/* Preserve the original contracts without pinning the total table size. */
static int bindings(void) {
    const char *targets[] = {"lnx/x86_64", "lnx/arm64", "osx/x86_64", "osx/arm64", "win/x86_64", "win/arm64"};
    const char *host[] = {"open", "read", "close", "lseek", "fdopen", "getpid", "fsync", "chdir", "unlink", "access", "dup", "rmdir", "isatty"};
    const char *win[] = {"_open", "_read", "_close", "_lseek", "_fdopen", "_getpid", "_commit", "_chdir", "_unlink", "_access", "_dup", "_rmdir", "_isatty"};
    const char *own[] = {"strdup", "pread", "pwrite", "write", "pipe", "getcwd", "ftruncate"};
    int c, i;
    for (c = 0; c < (int)(sizeof targets / sizeof targets[0]); c++) {
        const char *sym;
        for (i = 0; i < (int)(sizeof host / sizeof host[0]); i++) {
            sym = l99_fwdsym(host[i], tx_len(host[i], 32), targets[c]);
            if (!sym || !tx_eqz(sym, c >= 4 ? win[i] : host[i])) return fail("legacy-host-binding");
        }
        for (i = 0; i < (int)(sizeof own / sizeof own[0]); i++)
            if (l99_fwdsym(own[i], tx_len(own[i], 32), targets[c])) return fail("legacy-own-binding");
        sym = l99_fwdsym("clock_gettime", 13, targets[c]);
        if (c == 2 || c == 3) {
            if (!sym || !tx_eqz(sym, "clock_gettime")) return fail("darwin-clock-binding");
        } else if (sym) return fail("clock-shim-not-host-export");
    }
    if (l99_fwdsym("clock_gettime", 13, "osx/arm64-extra")
        || l99_fwdsym("open", 4, "unknown") || l99_fwdsym("fcntl", 5, "lnx/x86_64"))
        return fail("binding-domain");
    return 0;
}

static int public_surface(void) {
    char work[] = "/tmp/libc99posix-XXXXXX";
    char src[256], obj[256];
    const char *targets[2] = {"win/x86_64", "win/arm64"};
    const char *body =
        "#include <unistd.h>\n"
        "int p0_surface(int fd,char *p,size_t n,off_t off){\n"
        "int fds[2]; ssize_t w=write(fd,p,n); char *cwd=getcwd(p,n);\n"
        "int r=pipe(fds); r+=ftruncate(fd,off); r+=getpid(); r+=fsync(fd);\n"
        "r+=chdir(p); r+=unlink(p); r+=access(p,0); r+=dup(fd);\n"
        "r+=rmdir(p); r+=isatty(fd); return r+(w!=0)+(cwd!=0);}\n";
    int i, rc, failed = 0;
    size_t n;
    char *out;
    if (!mkdtemp(work)) return fail("surface-temp");
    if (cx_fmt(src, sizeof src, "%s/p0.c", work)
        || cx_fmt(obj, sizeof obj, "%s/p0.o", work)
        || cx_write(src, body, (size_t)tx_len(body, 1024))) {
        cx_rmtree(work);
        return fail("surface-write");
    }
    for (i = 0; i < 2; i++) {
        char *args[] = {"./tools/bound", "50", "sh", "./unisacc.com",
            "-b", (char *)targets[i], "-c", "-funit", src, "-o", obj, 0};
        rc = cx_runv_timeout(args, 55, &out, &n);
        if (rc != 0 || sy_exists(obj) != 1) {
            sy_eprintf("check-libc99posix\tTARGET\t%s\n", targets[i]);
            fail("public-p0-compile");
            failed = 1;
        }
        if (sy_exists(obj) == 1) sy_unlink(obj);
    }
    if (cx_rmtree(work)) return fail("surface-cleanup");
    return failed;
}

int main(void) {
    char *out;
    size_t n = 0;
    char *argv[8];
    int rc;
    argv[0] = "./tools/bound";
    argv[1] = "50";
    argv[2] = "sh";
    argv[3] = "./unisacc.com";
    argv[4] = "tools/libc99posix-gen.cx";
    argv[5] = "--";
    argv[6] = "--check";
    argv[7] = 0;
    rc = cx_runv_timeout(argv, 55, &out, &n);
    if (rc != 0) return fail("gen-check");
    if (bindings()) return 1;
    if (public_surface()) return 1;
    if (!bad) sy_printf("LIBC99POSIX\tok=1\tfailed=0\n");
    return bad;
}
