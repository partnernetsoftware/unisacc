#pragma unisa use sys.io
#pragma unisa use text.text
/* Narrow check of libc99posix fact table, generator, and fwdstub lookup. */
static int bad;

static int fail(const char *w) {
    sy_eprintf("check-libc99posix\tFAIL\t%s\n", w);
    bad = 1;
    return 1;
}

static int has_lit(const char *path, const char *s) {
    size_t n = 0, i, sl = 0;
    char *b = cx_read(path, &n);
    if (!b) return 0;
    while (s[sl]) sl++;
    if (sl == 0 || n < sl) return 0;
    for (i = 0; i + sl <= n; i++) {
        size_t k = 0;
        while (k < sl && b[i + k] == s[k]) k++;
        if (k == sl) return 1;
    }
    return 0;
}

int main(void) {
    char *out;
    size_t n = 0;
    char *argv[8];
    int rc;
    argv[0] = "./tools/bound";
    argv[1] = "50";
    argv[2] = "sh";
    argv[3] = "./unisacc.com";
    argv[4] = "tools/libc99posix-gen.cx";
    argv[5] = "--";
    argv[6] = "--check";
    argv[7] = 0;
    rc = cx_runv_timeout(argv, 55, &out, &n);
    if (rc != 0) return fail("gen-check");
    if (has_lit("cx/compiler/fwdstub.cx", "_WIN32")) return fail("fwd-win32");
    if (has_lit("cx/compiler/fwdstub.cx", "win/")) return fail("fwd-win-slash");
    if (has_lit("cx/compiler/fwdstub.cx", "_open")) return fail("fwd-open");
    if (has_lit("cx/compiler/fwdstub.cx", "_read")) return fail("fwd-read");
    if (has_lit("cx/compiler/fwdstub.cx", "_close")) return fail("fwd-close");
    if (has_lit("cx/compiler/fwdstub.cx", "_lseek")) return fail("fwd-lseek");
    if (!bad) sy_printf("LIBC99POSIX\tok=1\tfailed=0\n");
    return bad;
}
