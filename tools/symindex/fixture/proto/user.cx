/* symindex fixture: uses mid only, then calls lib's functions. */
#pragma unisa module user
#pragma unisa use mid
long lib_len(const char *s);
int user_all(char *b) {
    double d = lib_num("1");
    float *v = lib_vec();
    return lib_fmt(b, 8, "%d", 1) + (int)lib_count(b) + (int)lib_len(b) + (int)d + mid_x() + lib_hidden() + (v != 0);
}
