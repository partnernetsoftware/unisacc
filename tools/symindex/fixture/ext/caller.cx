/* symindex fixture for external (never compiled): printf( in a comment does not count.
   libc: printf, snprintf, signal x2 (the prelude's function-returning-function-pointer form), setpgid (its own
   prototype does not make it local), WIFEXITED (a prelude macro).  host: curl_easy_init (nowhere declared),
   ext_forward (a prototype only).  runtime: cx_read.  lang: va_start, va_end.  Not external: ext_helper (lib.cx),
   own_write and late_fn (defined here; late_fn after an #if that unbalances the parentheses), EXT_LOCAL (a macro
   here), o->puts (a member call of a prelude name) and fn (a function-pointer parameter). */
#pragma unisa use lib
#define EXT_LOCAL(x) ((x) + 1)
typedef struct { int (*puts)(int); } Ops;
int setpgid(int pid, int pgid);
int ext_forward(int v);
static int own_write(int fd) { return fd; }
static int confuse(int a, int b) {
#ifdef EXT_ONE
    if (a &&
#else
    if (b &&
#endif
        a) return 1;
    return 0;
}
static int late_fn(void) { return 0; }
static int run(Ops *o, int (*fn)(int), ...) {
    va_list ap;
    char buf[64];
    va_start(ap, fn);
    printf("%d\n", ext_helper(1));
    snprintf(buf, sizeof buf, "printf(");
    signal(2, 0);
    signal(15, 0);
    setpgid(0, 0);
    if (WIFEXITED(0)) curl_easy_init();
    o->puts(1);
    fn(2);
    cx_read("x", 0);
    va_end(ap);
    return EXT_LOCAL(own_write(1)) + ext_forward(late_fn()) + confuse(1, 2);
}
