/* symindex fixture (tools/check-symindex.cx asserts its exact rows; never compiled).
   A call-looking malloc(4) in this comment must not count. */
#pragma unisa module facts
#pragma unisa use text.text
#define FX_LIMIT 64
#define FX_TWICE(x) ((x) * 2)
typedef struct fx_pair { int a, b; } fx_pair_t;
typedef int (*fx_cb)(int);
static int fx_hidden(int v) { return FX_TWICE(v); }
int fx_log(const char *fmt, ...);
double fx_ratio(long a,
                long b);
int fx_apply(int (*fn)(int), int v) { return fn(v) + fx_hidden(v); }
double fx_ratio(long a, long b) {
    const char *s = "fx_fake(1) in a string";   // fx_fake2(2) in a line comment
    return (double)a / (double)(b ? b : 1) + fx_scale('(') + (s != 0);
}
int fx_log(const char *fmt, ...) { (void)fmt; return fx_count(FX_LIMIT, /* fx_fake3() */ 0); }
static const int fx_table = 3;
int fx_multi(int a, /* why */ int b) { return a + b; }
FX_REGISTER(fx_apply);
static int fx_init = fx_seed(1);
