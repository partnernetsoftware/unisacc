#pragma unisa use chrome_dom
#pragma unisa use text.fmt

static int publish(const char *path, const char *bytes, size_t n, int check) {
    if(check) {
        size_t size=0;
        char *old=cx_read(path,&size);
        int mismatch=!old || size!=n || memcmp(old,bytes,n);
        free(old);
        if(mismatch) printf("GEN_D1_AIRFRAME mismatch=%s\n",path);
        return mismatch;
    }
    FILE *file=fopen(path,"wb");
    if(!file) return 2;
    size_t written=fwrite(bytes,1,n,file);
    return fclose(file) || written!=n ? 2 : 0;
}

static int audio(int check) {
    static const char *names[]={"engine","gun","missile","explosion","lock"};
    char output[1024],*facts,*line;
    size_t size=0;
    int row=0,at,rc;
    facts=cx_read("ujs/practice/uxe/test/d1-audio.tsv",&size);
    if(!facts || !size) return 2;
    at=tx_snprintf(output,sizeof output,"// Generated from d1-audio.tsv.\nexport const sound={\n");
    for(line=strtok(facts,"\n");line;line=strtok(0,"\n")) {
        char name[16],wave[16];
        int from,to,gain,attack,duration,used=0;
        if(row>=5 || sscanf(line,"%15s %15s %d %d %d %d %d%n",name,wave,&from,&to,&gain,&attack,&duration,&used)!=7 ||
           line[used] || strcmp(name,names[row]) ||
           (strcmp(wave,"sine") && strcmp(wave,"triangle") && strcmp(wave,"square") && strcmp(wave,"sawtooth")) ||
           from<20 || from>4000 || to<1 || to>4000 || gain<1 || gain>300 ||
           attack<1 || attack>=duration || duration>1000) { free(facts); return 2; }
        at+=tx_snprintf(output+at,sizeof output-at,"  %s:[\"%s\",%d,%d,%d,%d,%d],\n",name,wave,from,to,gain,attack,duration);
        row++;
    }
    free(facts);
    if(row!=5) return 2;
    at+=tx_snprintf(output+at,sizeof output-at,"};\n");
    rc=publish("ujs/practice/uxe/test/d1-audio-data.js",output,(size_t)at,check);
    printf("GEN_D1_AUDIO rows=%d failed=%d\n",row,rc);
    return rc;
}

int main(int argc, char **argv) {
    char output[4096], wasm[128], *facts, *line, *compiled, *log=0;
    size_t size=0, n=0;
    int layers=0, paints=0, parts=0, at=0, rc, check;
    char *args[]={"sh","./ujs/ujs2wasm.com","ujs/tests/d1-flight.ujs","-o",wasm,0};
    if((argc!=2 && argc!=3) || (strcmp(argv[1],"--check") && strcmp(argv[1],"--write"))) return 2;
    check=!strcmp(argv[1],"--check");
    if(argc==3) return strcmp(argv[2],"--audio")?2:audio(check);
    facts=cx_read("ujs/practice/uxe/test/d1-airframe.tsv",&size);
    if(!facts || !size) return 2;
    at=tx_snprintf(output,sizeof output,"// Generated from d1-airframe.tsv.\nexport const layers=[\n");
    for(line=strtok(facts,"\n");line;line=strtok(0,"\n")) {
        int a,b,c,d,e,f,g,h,used=0;
        if(line[0]=='#') continue;
        if(!paints && sscanf(line,"layer %d %d %d%n",&a,&b,&c,&used)==3 &&
           !line[used] && a==layers && a<13 && abs(b)<=8 && abs(c)<=8) {
            at+=tx_snprintf(output+at,sizeof output-at,"  [%d,%d],\n",b,c);
            layers++;
        } else if(layers==13 && !parts && sscanf(line,"paint %d %d %d %d%n",&a,&b,&c,&d,&used)==4 &&
            !line[used] && a==paints+1 && a<=16 && b>=1 && b<=255 && c>=1 && c<=255 && d>=1 && d<=255) {
            if(!paints) at+=tx_snprintf(output+at,sizeof output-at,"];\nexport const paints=[null,\n");
            at+=tx_snprintf(output+at,sizeof output-at,"  [%d,%d,%d],\n",b,c,d);
            paints++;
        } else if(paints && parts<64 && sscanf(line,"part %d %d %d %d %d %d %d %d%n",&a,&b,&c,&d,&e,&f,&g,&h,&used)==8 &&
            !line[used] && a>=0 && b>=a && b<13 && c>=0 && d>=c && d<46 &&
            e>=0 && e<=34 && f>=1 && f<=17 && abs(g)<=17 && h>=1 && h<=paints) {
            int end=f+(d-c)*g, bound=f>end?f:end;
            if(end<1 || e-bound<0 || e+bound>34) { free(facts); return 2; }
            if(!parts) at+=tx_snprintf(output+at,sizeof output-at,"];\nexport const parts=[\n");
            at+=tx_snprintf(output+at,sizeof output-at,"  [%d,%d,%d,%d,%d,%d,%d,%d],\n",a,b,c,d,e,f,g,h);
            parts++;
        } else { free(facts); return 2; }
    }
    free(facts);
    if(!parts || layers!=13) return 2;
    at+=tx_snprintf(output+at,sizeof output-at,"];\n");
    tx_snprintf(wasm,sizeof wasm,"/tmp/d1-flight-%d.wasm",(int)getpid());
    rc=cx_runv_timeout(args,30,&log,&n);
    if(log) { if(rc) fwrite(log,1,n,stderr); free(log); }
    compiled=rc?0:cx_read(wasm,&n);
    remove(wasm);
    if(!compiled || !n) return 2;
    rc=publish("ujs/practice/uxe/test/d1-airframe-data.js",output,(size_t)at,check);
    if(!rc) rc=publish("ujs/practice/uxe/test/d1-flight.wasm",compiled,n,check);
    free(compiled);
    printf("GEN_D1_AIRFRAME failed=%d\n",rc);
    return rc;
}
