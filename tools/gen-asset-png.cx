/* tools/gen-asset-png.cx -- 程序生成 4x4 RGBA PNG(stored deflate).
 * sh ./unisacc.com tools/gen-asset-png.cx -- --write
 */
static unsigned char pix[16][4] = {
    {200,100,50,0},{200,100,50,64},{200,100,50,128},{200,100,50,255},
    {255,0,255,255},{0,255,255,255},{128,0,0,255},{0,128,0,255},
    {0,0,128,255},{128,128,0,255},{128,0,128,255},{0,128,128,255},
    {64,64,64,255},{192,192,192,255},{255,128,0,255},{0,255,128,255}
};

static unsigned crc_tab[256];
static void crc_init(void) {
    unsigned i, j, c;
    for (i = 0; i < 256; i++) {
        c = i;
        for (j = 0; j < 8; j++) c = (c & 1) ? (0xedb88320u ^ (c >> 1)) : (c >> 1);
        crc_tab[i] = c;
    }
}
static unsigned crc32(const unsigned char *p, int n) {
    unsigned c = 0xffffffffu;
    int i;
    for (i = 0; i < n; i++) c = crc_tab[(c ^ p[i]) & 255] ^ (c >> 8);
    return c ^ 0xffffffffu;
}
static unsigned adler(const unsigned char *p, int n) {
    unsigned a = 1, b = 0;
    int i;
    for (i = 0; i < n; i++) { a = (a + p[i]) % 65521; b = (b + a) % 65521; }
    return (b << 16) | a;
}
static void be32(unsigned char *o, unsigned v) {
    o[0] = (unsigned char)(v >> 24); o[1] = (unsigned char)(v >> 16);
    o[2] = (unsigned char)(v >> 8); o[3] = (unsigned char)v;
}
int main(int argc, char **argv) {
    unsigned char raw[4 * (1 + 16)];
    unsigned char z[8 + 4 * (1 + 16) + 4];
    unsigned char chunk[128];
    unsigned char out[512];
    int oi = 0, i, j, k, write = 0, check = 0;
    unsigned c, ad;
    FILE *f;
    static const unsigned char sig[8] = {137,80,78,71,13,10,26,10};
    crc_init();
    for (i = 1; i < argc; i++) {
        if (argv[i][0] == '-' && argv[i][2] == 'w') write = 1;
        if (argv[i][0] == '-' && argv[i][2] == 'c') check = 1;
    }

    k = 0;
    for (j = 0; j < 4; j++) {
        raw[k++] = 0;
        for (i = 0; i < 4; i++) {
            raw[k++] = pix[j * 4 + i][0];
            raw[k++] = pix[j * 4 + i][1];
            raw[k++] = pix[j * 4 + i][2];
            raw[k++] = pix[j * 4 + i][3];
        }
    }
    z[0] = 0x78; z[1] = 0x01;
    z[2] = 0x01;
    z[3] = (unsigned char)(k & 255); z[4] = (unsigned char)(k >> 8);
    z[5] = (unsigned char)((~k) & 255); z[6] = (unsigned char)((~k >> 8) & 255);
    for (i = 0; i < k; i++) z[7 + i] = raw[i];
    ad = adler(raw, k);
    be32(z + 7 + k, ad);
    for (i = 0; i < 8; i++) out[oi++] = sig[i];
    be32(chunk, 13);
    chunk[4] = 'I'; chunk[5] = 'H'; chunk[6] = 'D'; chunk[7] = 'R';
    be32(chunk + 8, 4); be32(chunk + 12, 4);
    chunk[16] = 8; chunk[17] = 6; chunk[18] = 0; chunk[19] = 0; chunk[20] = 0;
    c = crc32(chunk + 4, 17);
    be32(chunk + 21, c);
    for (i = 0; i < 25; i++) out[oi++] = chunk[i];
    {
        int zlen = 7 + k + 4;
        be32(chunk, (unsigned)zlen);
        chunk[4] = 'I'; chunk[5] = 'D'; chunk[6] = 'A'; chunk[7] = 'T';
        for (i = 0; i < zlen; i++) chunk[8 + i] = z[i];
        c = crc32(chunk + 4, 4 + zlen);
        be32(chunk + 8 + zlen, c);
        for (i = 0; i < 12 + zlen; i++) out[oi++] = chunk[i];
    }
    be32(chunk, 0);
    chunk[4] = 'I'; chunk[5] = 'E'; chunk[6] = 'N'; chunk[7] = 'D';
    c = crc32(chunk + 4, 4);
    be32(chunk + 8, c);
    for (i = 0; i < 12; i++) out[oi++] = chunk[i];
    printf("GEN_ASSET_PNG\tbytes=%d\twrite=%d\n", oi, write);
    if (check) {
        unsigned char disk[512];
        int n;
        f = fopen("ujs/practice/uxe/test/tex16.png", "rb");
        if (!f) { printf("DIFF\ttex16.png\n"); return 1; }
        n = (int)fread(disk, 1, sizeof disk, f);
        fclose(f);
        if (n != oi) { printf("DIFF\ttex16.png\n"); return 1; }
        for (i = 0; i < oi; i++) if (disk[i] != out[i]) { printf("DIFF\ttex16.png\n"); return 1; }
        printf("MATCH\ttex16.png\n");
        if (!write) return 0;
    }
    if (!write) return 0;

    f = fopen("ujs/practice/uxe/test/tex16.png", "wb");
    if (!f) return 2;
    fwrite(out, 1, (size_t)oi, f);
    fclose(f);
    f = fopen("ujs/practice/uxe/test/tex16.expected.rgba", "wb");
    if (!f) return 2;
    for (i = 0; i < 16; i++) fwrite(pix[i], 1, 4, f);
    fclose(f);
    return 0;
}
