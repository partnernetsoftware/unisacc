#pragma unisa use cxlib.elfkernel
#pragma unisa use text.text

int main(int argc, char **argv) {
    unsigned arch; ek_result r; char why[256];
    if (argc < 4 || (strcmp(argv[1], "arm64") && !tx_eqz(argv[1], "x86_64"))) {
        fputs("usage: kernel-link.cx arm64|x86_64 OUTPUT OBJECT...\n", stderr); return 2;
    }
    arch = tx_eqz(argv[1], "arm64") ? 1 : 2;
    r = ek_link(arch, argv[2], (const char *const *)(argv + 3), argc - 3, why, sizeof why);
    if (r.status != EK_OK) { fprintf(stderr, "kernel-link: %s\n", why); return (int)r.status; }
    printf("UNIKERN1 arch=%u bytes=%llu entry=%llu slot=%llu\n", arch, r.length, r.entry, r.slot);
    return 0;
}
