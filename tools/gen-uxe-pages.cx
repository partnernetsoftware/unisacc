#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.sha
#pragma unisa use mem.heap
#pragma unisa use text.text
#pragma unisa use text.fmt
/* tools/gen-uxe-pages.cx -- pages.tsv -> docs/uxe/<id>/
 * sh ./unisacc.com tools/gen-uxe-pages.cx -- --check|--write [--only ID]
 * --pins --only ID 输出 live 页的文件哈希，用于核定发布字节。
 * frozen 的 files 列为 文件名=SHA-256，校验目录与内容且不写入。
 * 不复制 md。legacy 跳过。不改 docs/index.html。
 */
static int failed, wrote;
static int ext_ok(const char *name, int pinned) {
    int n = 0, d = -1, i;
    while (name[n]) { if (name[n] == '.') d = n; n++; }
    if (d < 0) return 0;
    if (pinned && (tx_eqz(name+d,".tsv") || tx_eqz(name+d,".rgba"))) return 1;
    if (name[d + 1] == 'h' && name[d + 2] == 't' && name[d + 3] == 'm') return 1;
    if (name[d + 1] == 'j' && name[d + 2] == 's' && name[d + 3] == 0) return 1;
    if (name[d + 1] == 'w' && name[d + 2] == 'a' && name[d + 3] == 's' && name[d + 4] == 'm') return 1;
    return 0;
}
static void base_name(const char *p, char *out, int cap) {
    int n = 0, last = 0, i;
    while (p[n]) n++;
    for (i = 0; i < n; i++) if (p[i] == '/') last = i + 1;
    i = 0;
    while (p[last] && i < cap - 1) out[i++] = p[last++];
    out[i] = 0;
}
static int same1(const char *a, const char *b) {
    unsigned char *ba = 0, *bb = 0;
    int64_t na = 0, nb = 0;
    int i;
    if (sy_read_file(a, &ba, &na, 4000000) || sy_read_file(b, &bb, &nb, 4000000)) {
        if (ba) mm_free(ba);
        if (bb) mm_free(bb);
        return 0;
    }
    if (na != nb) { mm_free(ba); mm_free(bb); return 0; }
    for (i = 0; i < (int)na; i++) if (ba[i] != bb[i]) { mm_free(ba); mm_free(bb); return 0; }
    mm_free(ba); mm_free(bb);
    return 1;
}
static int rewrite_mem(const unsigned char *b, int64_t n, unsigned char **outp, int64_t *op) {
    unsigned char *out;
    int64_t i, o;
    out = (unsigned char *)mm_alloc((int)n + 8);
    if (!out) return 1;
    o = 0;
    i = 0;
    while (i < n) {
        if (i>0 && i+2<n && (b[i-1]=='\"' || b[i-1]=='\'') &&
            b[i]=='.' && b[i+1]=='.' && b[i+2]=='/') {
            int64_t end=i+3, basename=end;
            while(end<n && b[end]!=b[i-1] && b[end]!='\n' && b[end]!='?' && b[end]!='#') {
                if(b[end]=='/') basename=end+1;
                end++;
            }
            if(end<n && basename<end) {
                out[o++]='.';
                out[o++]='/';
                i=basename;
                continue;
            }
        }
        out[o++] = b[i++];
    }
    *outp = out;
    *op = o;
    return 0;
}
static void rewrite_dots(const char *path) {
    unsigned char *b = 0, *out = 0;
    int64_t n = 0, o = 0;
    if (sy_read_file(path, &b, &n, 4000000) || !b) return;
    if (rewrite_mem(b, n, &out, &o)) { mm_free(b); return; }
    sy_write_file(path, out, o, 0644);
    mm_free(out);
    mm_free(b);
}
static int same_rewritten(const char *src, const char *dst) {
    unsigned char *bs = 0, *bd = 0, *exp = 0;
    int64_t ns = 0, nd = 0, ne = 0, i;
    if (sy_read_file(src, &bs, &ns, 4000000) || sy_read_file(dst, &bd, &nd, 4000000)) {
        if (bs) mm_free(bs);
        if (bd) mm_free(bd);
        return 0;
    }
    if (rewrite_mem(bs, ns, &exp, &ne)) { mm_free(bs); mm_free(bd); return 0; }
    mm_free(bs);
    if (ne != nd) { mm_free(bd); mm_free(exp); return 0; }
    for (i = 0; i < ne; i++) if (exp[i] != bd[i]) { mm_free(bd); mm_free(exp); return 0; }
    mm_free(bd);
    mm_free(exp);
    return 1;
}

static void check_frozen(const char *dir, const char *files) {
    char names[4096];
    unsigned char seen[64] = {0};
    int fd=sy_open_read(dir),n,q=0,i,at;
    if(fd<0) { printf("FAIL\tfrozen-dir\t%s\n",dir); failed++; return; }
    n=sy_dir_names(fd,names,sizeof names);
    sy_close(fd);
    if(n<1 || n>64) { printf("FAIL\tfrozen-list\t%s\n",dir); failed++; return; }
    while(files[q]) {
        char leaf[128],want[65],path[512],got[65];
        unsigned char *bytes=0;
        int64_t size=0;
        int k=0,h=0,ok=1;
        while(files[q]==' ') q++;
        if(!files[q]) break;
        while(files[q] && files[q]!=' ' && files[q]!='=' && k<127) leaf[k++]=files[q++];
        leaf[k]=0;
        if(!k || files[q]!='=') {
            printf("FAIL\tfrozen-pin\t%s\n",dir); failed++; return;
        }
        q++;
        while(files[q] && files[q]!=' ' && h<64) {
            char c=files[q++];
            want[h++]=c;
            ok=ok && ((c>='0' && c<='9') || (c>='a' && c<='f'));
        }
        want[h]=0;
        if(!ok || h!=64 || (files[q] && files[q]!=' ')) {
            printf("FAIL\tfrozen-pin\t%s/%s\n",dir,leaf); failed++; return;
        }
        for(i=0,at=0;i<n && !tx_eqz(leaf,names+at);i++) at+=(int)tx_len(names+at,4096-at)+1;
        if(i==n) { printf("MISS\t%s/%s\n",dir,leaf); failed++; continue; }
        if(seen[i]) { printf("FAIL\tfrozen-duplicate\t%s/%s\n",dir,leaf); failed++; continue; }
        seen[i]=1;
        tx_snprintf(path,sizeof path,"%s/%s",dir,leaf);
        if(sy_read_file(path,&bytes,&size,4000000) || sy_sha256_any_hex(bytes,size,got) || !tx_eqz(want,got)) {
            printf("DIFF\t%s\n",path); failed++;
        } else printf("FROZEN\t%s\n",path);
        if(bytes) mm_free(bytes);
    }
    for(i=0,at=0;i<n;i++) {
        if(!seen[i]) { printf("EXTRA\t%s/%s\n",dir,names+at); failed++; }
        at+=(int)tx_len(names+at,4096-at)+1;
    }
}

int main(int argc, char **argv) {
    unsigned char *tb = 0;
    int64_t tn = 0;
    int write = 0, show_pins = 0, i, p, q, selected = 0;
    const char *only = 0;
    char *t;
    for (i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--write")) write = 1;
        else if (tx_eqz(argv[i], "--check")) write = 0;
        else if (tx_eqz(argv[i], "--pins")) show_pins = 1;
        else if (tx_eqz(argv[i], "--only") && i+1<argc && !only) only=argv[++i];
        else { printf("GEN_UXE_PAGES invalid argument=%s\n",argv[i]); return 2; }
    }
    if(show_pins && (write || !only)) return 2;
    if (sy_read_file("ujs/practice/uxe/pages.tsv", &tb, &tn, 200000) || !tb) return 2;
    t = (char *)tb;
    p = 0;
    while (p < (int)tn) {
        char id[64], src[256], entry[256], dest[256], status[16], files[1024], pins[4096];
        int ni = 0, ns = 0, ne = 0, nd = 0, nt = 0, nf = 0, np = 0, col, pinned;
        if (t[p] == '#' || t[p] == '\n') {
            while (p < (int)tn && t[p] != '\n') p++;
            if (p < (int)tn) p++;
            continue;
        }
        col = 0;
        id[0] = src[0] = entry[0] = dest[0] = files[0] = 0;
        while (p < (int)tn && t[p] != '\n') {
            if (t[p] == '\t') { col++; p++; continue; }
            if (col == 0 && ni < 63) id[ni++] = t[p];
            else if (col == 1 && ns < 255) src[ns++] = t[p];
            else if (col == 2 && ne < 255) entry[ne++] = t[p];
            else if (col == 3 && nd < 255) dest[nd++] = t[p];
            else if (col == 5 && nt < 15) status[nt++] = t[p];
            else if (col == 6 && nf < 1023) files[nf++] = t[p];
            else if (col == 7 && np < 4095) pins[np++] = t[p];
            p++;
        }
        id[ni] = src[ns] = entry[ne] = dest[nd] = status[nt] = files[nf] = 0;
        pins[np]=0;
        if (p < (int)tn) p++;
        if (only && !tx_eqz(only,id)) continue;
        pinned=tx_eqz(status,"live") && np>0;
        if(show_pins && !pinned) { failed++; continue; }
        if (tx_eqz(status,"frozen")) {
            selected++;
            check_frozen(dest,files);
            continue;
        }
        if (src[0] == '-' || files[0] == '-' || !files[0]) {
            printf("SKIP\t%s\tlegacy\n", id);
            continue;
        }
        selected++;
        if (write) {
            sy_mkdir("docs", 0755);
            sy_mkdir("docs/uxe", 0755);
            sy_mkdir_all(dest, 0755);
        }
        q = 0;
        while (files[q]) {
            char rel[256], srcp[512], dstp[512], base[128];
            int r = 0, k, is_entry, rewrite;
            while (files[q] == ' ') q++;
            while (files[q] && files[q] != ' ' && r < 255) rel[r++] = files[q++];
            rel[r] = 0;
            if (!rel[0]) break;
            if (!ext_ok(rel,pinned)) continue;
            k = 0;
            while (src[k]) { srcp[k] = src[k]; k++; }
            srcp[k++] = '/';
            r = 0;
            while (rel[r]) srcp[k++] = rel[r++];
            srcp[k] = 0;
            is_entry=tx_eqz(rel,entry);
            rewrite=is_entry || (pinned && r>=3 && tx_eqz(rel+r-3,".js"));
            base_name(is_entry?"index.html":rel, base, 128);
            k = 0;
            while (dest[k]) { dstp[k] = dest[k]; k++; }
            dstp[k++] = '/';
            r = 0;
            while (base[r]) dstp[k++] = base[r++];
            dstp[k] = 0;
            if (sy_exists(srcp) != 1) { printf("FAIL\tmissing-src\t%s\n", srcp); failed++; continue; }
            if (!write) {
                if (sy_exists(dstp) != 1) { printf("MISS\t%s\n", dstp); failed++; }
                else if (rewrite) {
                    if (!same_rewritten(srcp, dstp)) { printf("DIFF\t%s\n", dstp); failed++; }
                    else printf("HAVE\t%s\n", dstp);
                }
                else if (!same1(srcp, dstp)) { printf("DIFF\t%s\n", dstp); failed++; }
                else printf("HAVE\t%s\n", dstp);
                if(show_pins) {
                    unsigned char *bytes=0;
                    int64_t size=0;
                    char hash[65];
                    if(sy_read_file(dstp,&bytes,&size,4000000) || sy_sha256_any_hex(bytes,size,hash)) failed++;
                    else printf("PIN\t%s=%s\n",base,hash);
                    if(bytes) mm_free(bytes);
                }
            } else {
                if (sy_copy(srcp, dstp, 0644)) { printf("FAIL\tcopy\t%s\n", dstp); failed++; }
                else {
                    wrote++;
                    if (rewrite) rewrite_dots(dstp);
                    printf("WRITE\t%s\n", dstp);
                }
            }
        }
        if(pinned && !write && !show_pins) check_frozen(dest,pins);
    }
    mm_free(tb);
    if (only && !selected) { printf("GEN_UXE_PAGES unknown page=%s\n",only); return 2; }
    printf("GEN_UXE_PAGES\twrite=%d\twrote=%d\tfailed=%d\n", write, wrote, failed);
    return failed ? 1 : 0;
}
