#pragma unisa use chrome_dom
#pragma unisa use sys.fs
#pragma unisa use text.fmt
/* tools/check-gen-uxe-pages.cx -- 全量逐字节、隔离篡改、活跃导出页面 AUTO.
 *
 * sh ./unisacc.com tools/check-gen-uxe-pages.cx --
 */
static int failed, asserts;
static void ck(int ok, const char *lab) {
    asserts++;
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", lab);
    if (!ok) failed++;
}
static int runv(char **av, int secs) {
    char *o = 0;
    size_t n = 0;
    int rc = cx_runv_timeout(av, secs, &o, &n);
    if (o && n) fwrite(o, 1, n, stdout);
    if (o) free(o);
    return rc;
}
static int replace_head(const char *path,int byte,int *previous) {
    FILE *f=fopen(path,"r+b");
    int old,ok;
    if(!f) return 0;
    old=fgetc(f);
    ok=old!=EOF && fseek(f,0,SEEK_SET)==0 && fputc(byte<0?old^1:byte,f)!=EOF;
    if(fclose(f)) ok=0;
    if(previous) *previous=old;
    return ok;
}

static void tamper(const char *page,const char *asset,int expected) {
    char path[190],diff[205],summary[60],*out=0;
    char *av[]={"sh","./unisacc.com","tools/gen-uxe-pages.cx","--","--check","--only",(char *)page,0};
    size_t bytes=0;
    int previous,rc,matched,restored;
    tx_snprintf(path,sizeof path,"docs/uxe/%s/%s",page,asset);
    tx_snprintf(diff,sizeof diff,"DIFF\t%s\n",path);
    tx_snprintf(summary,sizeof summary,"failed=%d\n",expected);
    if(!replace_head(path,-1,&previous)) { ck(0,path); return; }
    rc=cx_runv_timeout(av,12,&out,&bytes);
    matched=out && strstr(out,diff) && strstr(out,summary);
    free(out);
    restored=replace_head(path,previous,0);
    ck(rc==1 && matched && restored,path);
}

static int fixture(const char *cwd,const char *root) {
    const char *links[]={"unisacc.com","ujs","tools","cx","ext","cxroot.tsv"};
    char from[700],to[750],docs[220];
    char *copy[]={"cp","-a","docs/uxe",docs,0};
    int i;
    tx_snprintf(docs,sizeof docs,"%s/docs",root);
    if(sy_mkdir_all(docs,0700) || runv(copy,8)) return 0;
    for(i=0;i<(int)(sizeof links/sizeof links[0]);i++) {
        tx_snprintf(from,sizeof from,"%s/%s",cwd,links[i]);
        tx_snprintf(to,sizeof to,"%s/%s",root,links[i]);
        if(sy_symlink(from,to)) return 0;
    }
    return sy_chdir(root)==0;
}

static void unexpected_walk_script(void) {
    const char *file="docs/uxe/ink-walk/legacy.js";
    char *out=0;
    size_t bytes=0;
    char *check[]={"sh","./unisacc.com","tools/gen-uxe-pages.cx","--","--check","--only","ink-walk",0};
    if(sy_write_file(file,"0;\n",3,0600)) { ck(0,"D3 unexpected script"); return; }
    int rc=cx_runv_timeout(check,12,&out,&bytes);
    int rejected=rc==1 && out && strstr(out,"EXTRA\tdocs/uxe/ink-walk/legacy.js\n");
    free(out);
    ck(sy_unlink(file)==0 && rejected,"D3 unexpected script");
}

int main(void) {
    const char *pages[]={"fly","oneshot"};
    const char *assets[]={"index.html","renderer-webgl.js","scene.js","meshes.js","math.js"};
    const char *specific[][2]={{"host1-runtime.js","fly-b64.js"},{"d4-gait.js","d4-dense-town.tsv"}};
    const char *examples[][5]={{"fly","fly-host1","FLY_OK","FLY_ERR","FLY_GL_OK"},
        {"water-keeps","water-keeps-host1","WATER_OK","WATER_ERR","WATER_FAIL"}};
    char cwd[512],root[100],url[800];
    char *town[]={"sh","./unisacc.com","tools/check-uxe-d1-flight.cx","--","town-pages-input",0};
    char *native[]={"sh","./unisacc.com","tools/check-uxe-d1-flight.cx","--","wasm-page-input",url,0};
    char *host[]={"sh","./unisacc.com","ujs/tests/uxe-host-budget.cx","--","docs/uxe/fly-next/index.html",0};
    char *check[]={"sh","./unisacc.com","tools/gen-uxe-pages.cx","--","--check",0};
    char *write_frozen[]={"sh","./unisacc.com","tools/gen-uxe-pages.cx","--","--write","--only","fly",0};
    int i,j;
    if(!getcwd(cwd,sizeof cwd)) return 2;
    ck(runv(check,20)==0,"gen-check");
    tx_snprintf(root,sizeof root,"/tmp/chrome-dom-uxe-pages-%d",(int)getpid());
    if(!fixture(cwd,root)) {
        chd_wipe(root);
        return 2;
    }
    ck(runv(write_frozen,20)==0,"write-frozen-keeps-published-bytes");
    write_frozen[6]="ink-walk";
    ck(runv(write_frozen,20)==0,"write-frozen-keeps-D3-package");
    for(i=0;i<2;i++) {
        for(j=0;j<5;j++) tamper(pages[i],assets[j],i?2:1);
        for(j=0;j<2;j++) tamper(pages[i],specific[i][j],i?2:1);
    }
    const char *native_files[]={"index.html","host-abi.js","base.wasm","product.wasm","d1-sprites.rgba"};
    for(i=0;i<5;i++) tamper("fly-next",native_files[i],1);
    const char *walk_files[]={"index.html","host-abi.js","base.wasm","product.wasm","route.bin"};
    for(i=0;i<5;i++) tamper("ink-walk",walk_files[i],1);
    unexpected_walk_script();
    const char *water_files[]={"index.html","host-abi.js","base.wasm","product.wasm","d2-type.rgba","font-license.txt"};
    for(i=0;i<6;i++) tamper("water-keeps",water_files[i],1);
    ck(runv(check,20)==0,"tamper-restored-full-check");
    if(sy_chdir(cwd)) return 2;
    chd_wipe(root);
    for(i=0;i<2;i++) {
        const char **entry=examples[i];
        int retries=0,rc;
        tx_snprintf(url,sizeof url,"file://%s/%s?auto=1",cwd,
            i?"ujs/practice/uxe/demo/water-keeps/reflection-audit.html":"docs/uxe/fly/index.html");
        rc=chd_dump_expect("/usr/bin/google-chrome",url,entry[2],entry+2,3,entry[1],3,25,&retries);
        ck(rc==0,entry[2]);
    }
    ck(runv(town,18)==0,"D4_OK CDP");
    host[4]="docs/uxe/ink-walk/index.html";
    ck(runv(host,10)==0,"D3 Wasm host ABI");
    native[4]="wasm-walk-input";
    tx_snprintf(url,sizeof url,"file://%s/docs/uxe/ink-walk/index.html",cwd);
    ck(runv(native,22)==0,"D3 Wasm CDP");
    host[4]="docs/uxe/fly-next/index.html";
    native[4]="wasm-page-input";
    ck(runv(host,10)==0,"D1 Wasm host ABI");
    tx_snprintf(url,sizeof url,"file://%s/docs/uxe/fly-next/index.html",cwd);
    ck(runv(native,20)==0,"D1 Wasm CDP");
    host[4]="docs/uxe/water-keeps/index.html";
    ck(runv(host,10)==0,"D2 Wasm host ABI");
    native[4]="wasm-water-input";
    tx_snprintf(url,sizeof url,"file://%s/docs/uxe/water-keeps/index.html",cwd);
    ck(runv(native,22)==0,"D2 Wasm CDP");
    printf("CHECK_GEN_UXE_PAGES\tasserts=%d\tfailed=%d\n", asserts, failed);
    return failed ? 1 : 0;
}
