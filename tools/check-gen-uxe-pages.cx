#pragma unisa use chrome_dom
#pragma unisa use sys.fs
#pragma unisa use text.fmt
/* tools/check-gen-uxe-pages.cx -- 全量逐字节、隔离篡改、活跃导出页面 AUTO.
 *
 * sh ./unisacc.com tools/check-gen-uxe-pages.cx --
 */
static int failed, asserts;
static void ck(int ok, const char *lab) {
    asserts++;
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", lab);
    if (!ok) failed++;
}
static int runv(char **av, int secs) {
    char *o = 0;
    size_t n = 0;
    int rc = cx_runv_timeout(av, secs, &o, &n);
    if (o && n) fwrite(o, 1, n, stdout);
    if (o) free(o);
    return rc;
}
static int replace_head(const char *path,int byte,int *previous) {
    FILE *f=fopen(path,"r+b");
    int old,ok;
    if(!f) return 0;
    old=fgetc(f);
    ok=old!=EOF && fseek(f,0,SEEK_SET)==0 && fputc(byte<0?old^1:byte,f)!=EOF;
    if(fclose(f)) ok=0;
    if(previous) *previous=old;
    return ok;
}

static void tamper(const char *page,const char *asset) {
    char path[190],diff[205],*out=0;
    char *av[]={"sh","./unisacc.com","tools/gen-uxe-pages.cx","--","--check","--only",(char *)page,0};
    size_t bytes=0;
    int previous,rc,matched,restored;
    tx_snprintf(path,sizeof path,"docs/uxe/%s/%s",page,asset);
    tx_snprintf(diff,sizeof diff,"DIFF\t%s\n",path);
    if(!replace_head(path,-1,&previous)) { ck(0,path); return; }
    rc=cx_runv_timeout(av,12,&out,&bytes);
    matched=out && strstr(out,diff) && strstr(out,"failed=1\n");
    free(out);
    restored=replace_head(path,previous,0);
    ck(rc==1 && matched && restored,path);
}

static int fixture(const char *cwd,const char *root) {
    const char *links[]={"unisacc.com","ujs","tools","cx","ext","cxroot.tsv"};
    char from[700],to[750],docs[220];
    char *copy[]={"cp","-a","docs/uxe",docs,0};
    int i;
    tx_snprintf(docs,sizeof docs,"%s/docs",root);
    if(sy_mkdir_all(docs,0700) || runv(copy,8)) return 0;
    for(i=0;i<(int)(sizeof links/sizeof links[0]);i++) {
        tx_snprintf(from,sizeof from,"%s/%s",cwd,links[i]);
        tx_snprintf(to,sizeof to,"%s/%s",root,links[i]);
        if(sy_symlink(from,to)) return 0;
    }
    return sy_chdir(root)==0;
}

int main(void) {
    const char *pages[]={"fly","ink-walk","oneshot"};
    const char *assets[]={"renderer-webgl.js","scene.js","meshes.js","font5x7.js"};
    const char *examples[][5]={{"fly","fly-host1","FLY_OK","FLY_ERR","FLY_GL_OK"},
        {"ink-walk","ink-walk-host1","INK_OK","INK_ERR","INK_FAIL"},
        {"oneshot","oneshot-host1","ONESHOT_OK","ONESHOT_ERR","ONESHOT_FAIL"},
        {"water-keeps","water-keeps-host1","WATER_OK","WATER_ERR","WATER_FAIL"}};
    char *check[]={"sh","./unisacc.com","tools/gen-uxe-pages.cx","--","--check",0};
    char cwd[512],root[100],url[800];
    int i,j;
    if(!getcwd(cwd,sizeof cwd)) return 2;
    ck(runv(check,20)==0,"gen-check");
    tx_snprintf(root,sizeof root,"/tmp/chrome-dom-uxe-pages-%d",(int)getpid());
    if(!fixture(cwd,root)) {
        chd_wipe(root);
        return 2;
    }
    tamper("fly","index.html");
    tamper("fly","fly-b64.js");
    tamper("fly","host1-runtime.js");
    for(i=0;i<3;i++) for(j=0;j<4;j++) tamper(pages[i],assets[j]);
    ck(runv(check,20)==0,"tamper-restored-full-check");
    if(sy_chdir(cwd)) return 2;
    chd_wipe(root);
    for(i=0;i<4;i++) {
        const char **entry=examples[i];
        int retries=0,rc;
        tx_snprintf(url,sizeof url,"file://%s/docs/uxe/%s/index.html?auto=1",cwd,entry[0]);
        rc=chd_dump_expect("/usr/bin/google-chrome",url,entry[2],entry+2,3,entry[1],3,25,&retries);
        ck(rc==0,entry[2]);
    }
    printf("CHECK_GEN_UXE_PAGES\tasserts=%d\tfailed=%d\n", asserts, failed);
    return failed ? 1 : 0;
}
