#pragma unisa use chrome_dom
/* tools/check-gen-uxe-pages.cx -- gen --check; 篡改必红; AUTO FLY_OK WATER_OK.
 *
 * sh ./unisacc.com tools/check-gen-uxe-pages.cx --
 */
static int failed, asserts;
static void ck(int ok, const char *lab) {
    asserts++;
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", lab);
    if (!ok) failed++;
}
static int runv(char **av, int secs) {
    char *o = 0;
    size_t n = 0;
    int rc = cx_runv_timeout(av, secs, &o, &n);
    if (o && n) fwrite(o, 1, n, stdout);
    if (o) free(o);
    return rc;
}
int main(void) {
    char *av[8];
    int rc, retries, n, i;
    const char *fin_fly[3];
    const char *fin_w[3];
    char *shav[4];
    char *out = 0;
    size_t on = 0;
    char cwd[512];
    char url[640];
    const char *pre = "file://";
    av[0] = "sh"; av[1] = "./unisacc.com"; av[2] = "tools/gen-uxe-pages.cx";
    av[3] = "--"; av[4] = "--check"; av[5] = 0;
    rc = runv(av, 20);
    ck(rc == 0, "gen-check");
    shav[0] = "sh";
    shav[1] = "-c";
    shav[2] = "D=/tmp/uxe-chk-$$; mkdir -p \"$D/tools\" && cp -a docs ujs \"$D/\" && cp tools/gen-uxe-pages.cx \"$D/tools/\" && ln -s \"$PWD/unisacc.com\" \"$D/unisacc.com\" && printf x >> \"$D/docs/uxe/fly/index.html\" && (cd \"$D\" && sh ./unisacc.com tools/gen-uxe-pages.cx -- --check); r=$?; printf y >> \"$D/docs/uxe/fly/fly-b64.js\"; (cd \"$D\" && sh ./unisacc.com tools/gen-uxe-pages.cx -- --check >/dev/null); r2=$?; printf z >> \"$D/docs/uxe/fly/host1-runtime.js\"; (cd \"$D\" && sh ./unisacc.com tools/gen-uxe-pages.cx -- --check >/dev/null); r3=$?; rm -rf \"$D\"; test \"$r\" != 0 && test \"$r2\" != 0 && test \"$r3\" != 0";
    shav[3] = 0;
    rc = cx_runv_timeout(shav, 40, &out, &on);
    if (out) free(out);
    ck(rc == 0, "tamper-index-b64-runtime-red");
    if (!getcwd(cwd, sizeof cwd)) return 2;
    n = 0;
    while (pre[n]) { url[n] = pre[n]; n++; }
    for (i = 0; cwd[i] && n < 500; i++) url[n++] = cwd[i];
    {
        const char *s = "/docs/uxe/fly/index.html?auto=1";
        int j = 0;
        while (s[j] && n < 630) url[n++] = s[j++];
        url[n] = 0;
    }
    fin_fly[0] = "FLY_OK"; fin_fly[1] = "FLY_ERR"; fin_fly[2] = "FLY_GL_OK";
    retries = 0;
    rc = chd_dump_expect("/usr/bin/google-chrome", url, "FLY_OK", fin_fly, 3, "fly-host1", 3, 25, &retries);
    ck(rc == 0, "fly-AUTO-FLY_OK");
    n = 0;
    while (pre[n]) { url[n] = pre[n]; n++; }
    for (i = 0; cwd[i] && n < 500; i++) url[n++] = cwd[i];
    {
        const char *s = "/docs/uxe/water-keeps/index.html?auto=1";
        int j = 0;
        while (s[j] && n < 630) url[n++] = s[j++];
        url[n] = 0;
    }
    fin_w[0] = "WATER_OK"; fin_w[1] = "WATER_ERR"; fin_w[2] = "WATER_FAIL";
    retries = 0;
    rc = chd_dump_expect("/usr/bin/google-chrome", url, "WATER_OK", fin_w, 3, "water-keeps-host1", 3, 25, &retries);
    ck(rc == 0, "water-AUTO-WATER_OK");
    printf("CHECK_GEN_UXE_PAGES\tasserts=%d\tfailed=%d\n", asserts, failed);
    return failed ? 1 : 0;
}
