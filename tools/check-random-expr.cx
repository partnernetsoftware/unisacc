/* ROOT OUT GCC TCC [BATCHES=1..100]; no args: cwd, private temporary output, HOST_CC/gcc and TCC/tcc. */
#pragma unisa use cxlib.netpack
static int launch(char **v,const char *root,const char *prefix,int expected){np_result r={0};char why[800]={0},p[8192],s[100];int e=np_run(v,root,0,55,&r,why,sizeof why);if(cx_fmt(p,sizeof p,"%s.stdout",prefix))exit(2);int bad=np_writefile(p,r.out?r.out:"",r.outn);if(cx_fmt(p,sizeof p,"%s.stderr",prefix))exit(2);bad|=np_writefile(p,r.err?r.err:"",r.errn);if(cx_fmt(p,sizeof p,"%s.status",prefix))exit(2);if(cx_fmt(s,sizeof s,"transport=%d rc=%d residue=%d\n",e,r.rc,r.residue))exit(2);bad|=np_writefile(p,s,strlen(s));if(e){if(cx_fmt(p,sizeof p,"%s.error",prefix))exit(2);bad|=np_writefile(p,why,strlen(why));}bad|=e||r.rc!=expected||r.residue;np_free(&r);return bad;}
static int same(const char *a,const char *b,const char *file){char p[8192];np_buf x={0},y={0};if(cx_fmt(p,sizeof p,"%s/%s",a,file))exit(2);int bad=np_readfile(p,&x);if(cx_fmt(p,sizeof p,"%s/%s",b,file))exit(2);bad|=np_readfile(p,&y);bad|=x.n!=y.n||(x.n&&memcmp(x.p,y.p,x.n));free(x.p);free(y.p);return !bad;}
static int check_main(int argc,char **argv){
    char *end,tool[8192],product[8192],dst[8192],first[8192],replay[8192],seed[32];long batches=1;int fail=0;
    if(argc<5||argc>6||argv[1][0]!='/'||argv[2][0]!='/')return 2;
    if(argc==6){batches=strtol(argv[5],&end,10);if(!*argv[5]||*end||batches<1||batches>100)return 2;}if(strlen(argv[2])>4000||mkdir(argv[2],0700)){perror("check output");return 2;}
    if(cx_fmt(tool,sizeof tool,"%s/tools/random-expr.cx",argv[1]))exit(2);if(cx_fmt(product,sizeof product,"%s/unisacc.com",argv[1]))exit(2);char *v[]={"sh",product,tool,"--",argv[1],dst,argv[3],argv[4],seed,0};
    for(int i=0;i<batches+3;i++){if(cx_fmt(seed,sizeof seed,"%llu",i<2?0ULL:i==2?4294967295ULL:(unsigned long long)i))exit(2);if(cx_fmt(dst,sizeof dst,"%s/batch-%d",argv[2],i))exit(2);fail|=launch(v,argv[1],dst,0);if(i==0)if(cx_fmt(first,sizeof first,"%s",dst))exit(2);if(i==1)if(cx_fmt(replay,sizeof replay,"%s",dst))exit(2);}
    fail|=!same(first,replay,"input.c")||!same(first,replay,"gcc.run.stdout")||!same(first,replay,"tcc.run.stdout");
    if(cx_fmt(dst,sizeof dst,"%s/invalid-seed",argv[2]))exit(2);if(cx_fmt(seed,sizeof seed,"%s","4294967296"))exit(2);fail|=launch(v,argv[1],dst,2);
    if(cx_fmt(dst,sizeof dst,"%s/missing-compiler",argv[2]))exit(2);if(cx_fmt(seed,sizeof seed,"%s","47"))exit(2);v[6]="/nonexistent/random-expr-compiler";fail|=launch(v,argv[1],dst,1);char evidence[8192];np_buf status={0};if(cx_fmt(evidence,sizeof evidence,"%s/result.txt",dst))exit(2);fail|=np_readfile(evidence,&status)||!strstr(status.p?status.p:"","status=FAIL");free(status.p);
    v[6]=argv[3];if(cx_fmt(dst,sizeof dst,"%s",first))exit(2);if(cx_fmt(evidence,sizeof evidence,"%s/existing-output",argv[2]))exit(2);fail|=launch(v,argv[1],evidence,2);printf("CHECK_RANDOM_EXPR\tbatches=%ld\tboundary=0,4294967295\tdeterministic=2\tstatus=%s\n",batches+3,fail?"FAIL":"PASS");return fail?1:0;
}
int main(int argc,char **argv){
    if(argc!=1)return check_main(argc,argv);char root[4096],out[4096],tmp[]="/tmp/check-random-expr-XXXXXX",why[800];char *gcc=getenv("HOST_CC"),*tcc=getenv("TCC");if(!getcwd(root,sizeof root)||!mkdtemp(tmp))return 2;
    int rc=2;if(!cx_fmt(out,sizeof out,"%s/run",tmp)){char *v[]={argv[0],root,out,gcc&&*gcc?gcc:"gcc",tcc&&*tcc?tcc:"tcc",0};rc=check_main(5,v);}char *rm[]={"rm","-rf","--",tmp,0};np_result r={0};int e=np_run(rm,root,0,5,&r,why,sizeof why);if(e||r.rc||r.residue)rc=2;np_free(&r);return rc;
}
