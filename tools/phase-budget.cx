/* tools/phase-budget.cx -- 分治时限铁律的度量:单次操作 >300s 或整体 >7200s 必须有整改任务(waiver)且未过期。
 *
 *   sh ./unisacc.com tools/phase-budget.cx -- [FILE] [--today YYYY-MM-DD]
 *
 * FILE 默认 agentwork/phase-times.tsv;列:phase scope budget_s measured_s source waiver_task waiver_until。
 * 判定:measured_s 为数字且 > budget_s → OVER;OVER 且 waiver_task!='-' 且 waiver_until>=today → WAIVED;
 * OVER 且无 waiver → FAIL;waiver 已过期 → EXPIRED(失败);measured_s 非数字 → UNMEASURED(只报告,不失败)。
 * 末行 PHASE_BUDGET<TAB>over=N waived=N expired=N unmeasured=N failed=N;failed>0 时退出 1。 */
#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use mem.bytes

static int split(char *line, char *f[], int max) {
    int n = 0; f[n++] = line;
    for (char *p = line; *p && n < max; p++) if (*p == '\t') { *p = 0; f[n++] = p + 1; }
    return n;
}
static int number(const char *s, long *v) {
    long a = 0; int i = 0;
    if (!s[0]) return 0;
    for (; s[i]; i++) { if (s[i] < '0' || s[i] > '9') return 0; a = a * 10 + (s[i] - '0'); }
    *v = a; return 1;
}
static int date_ok(const char *s) {
    if (tx_len(s, 11) != 10) return 0;
    for (int i = 0; i < 10; i++) {
        if (i == 4 || i == 7) { if (s[i] != '-') return 0; }
        else if (s[i] < '0' || s[i] > '9') return 0;
    }
    return 1;
}

int main(int argc, char **argv) {
    const char *file = "agentwork/phase-times.tsv", *today = 0;
    int i, over = 0, waived = 0, expired = 0, unmeasured = 0, failed = 0;
    char tbuf[16] = {0};
    for (i = 1; i < argc; i++) {
        if (!tx_eqz(argv[i], "--")) {
            if (tx_eqz(argv[i], "--today") && i + 1 < argc) today = argv[++i];
            else file = argv[i];
        }
    }
    if (!today) {
        char *v[] = {"date", "-u", "+%F", 0}; char *o = 0; size_t n = 0;
        if (cx_runv_timeout(v, 10, &o, &n) != 0 || n < 10) { sy_eprintf("phase-budget: cannot get date\n"); return 2; }
        mm_copy(tbuf, sizeof tbuf, o, 10); tbuf[10] = 0; today = tbuf;
    }
    if (!date_ok(today)) { sy_eprintf("phase-budget: bad --today\n"); return 2; }
    size_t sz = 0; char *buf = cx_read(file, &sz);
    if (!buf) { sy_eprintf("phase-budget: cannot read %s\n", file); return 2; }
    char *at = buf; int lineno = 0;
    while (*at) {
        char *e = at; while (*e && *e != '\n') e++;
        char save = *e; *e = 0; lineno++;
        if (at[0] && at[0] != '#') {
            char *f[8]; int n = split(at, f, 8);
            if (n != 7) { sy_printf("FAIL\tline %d: %d columns (need 7)\n", lineno, n); failed++; }
            else {
                long b = 0, m = 0; int bn = number(f[2], &b), mn = number(f[3], &m);
                int isop = tx_eqz(f[1], "op"), iswh = tx_eqz(f[1], "whole");
                if (!bn || (!isop && !iswh)) { sy_printf("FAIL\tline %d: bad scope/budget\n", lineno); failed++; }
                else if (!mn) { sy_printf("UNMEASURED\t%s\n", f[0]); unmeasured++; }
                else if (m <= b) sy_printf("OK\t%s\t%ld/%ld\n", f[0], m, b);
                else {
                    over++;
                    int has = !tx_eqz(f[5], "-") && date_ok(f[6]);
                    if (!has) { sy_printf("FAIL\t%s\t%ld>%ld no waiver\n", f[0], m, b); failed++; }
                    else if (tx_cmp(f[6], 10, today, 10) < 0) { sy_printf("EXPIRED\t%s\t%ld>%ld waiver %s until %s\n", f[0], m, b, f[5], f[6]); expired++; failed++; }
                    else { sy_printf("WAIVED\t%s\t%ld>%ld %s until %s\n", f[0], m, b, f[5], f[6]); waived++; }
                }
            }
        }
        *e = save; at = save ? e + 1 : e;
    }
    sy_printf("PHASE_BUDGET\tover=%d waived=%d expired=%d unmeasured=%d failed=%d\n", over, waived, expired, unmeasured, failed);
    return failed ? 1 : 0;
}
