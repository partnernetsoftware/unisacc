/* Content-linked function emitter contexts, never exclusive module ownership. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sys.time
#define WF_CAP 536870912
static const char *model="a985b1706b96659bd3951a44495e774d4eb3c969163845c7a63d9c225e6b1811";
static const char *profile="CT.afterfn\tunit_epoch,hl_pos,fns,fne\toutput-mark\nFN.nx\tunit_epoch,infunc\toutput-span\n";
static long began;
static void die(const char *s){fprintf(stderr,"WHOLE_FUNCTION_ORIGIN REFUSE %s\n",s);exit(2);}
static void tick(void){if(sy_now_ms()-began>48000)die("48 second deadline");}
static void sha(const void *p,long n,char h[65]){if(sy_sha256_hex(p,n,h))cx_sha256_hex(p,n,h);}
static char *load(const char *path,long cap,size_t *n,char h[65]){tick();struct stat st;if(lstat(path,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>cap)die("regular file/extent");char *b=cx_read(path,n);if(!b||*n!=(size_t)st.st_size)die("read extent");sha(b,*n,h);return b;}
static void path(char p[8192],const char *d,const char *f){if(cx_fmt(p,8192,"%s/%s",d,f))die("path bound");}
static long word(const char *b,long n,long *p){if(*p<0||*p>n-4)die("word extent");long x=0;for(int i=0;i<4;i++)x|=(long)(unsigned char)b[(*p)++]<<(8*i);if(x>2147483647)die("signed word");return x;}
static char *line(char **p){if(!**p)return 0;char *s=*p,*e=strchr(s,'\n');if(!e)die("missing LF");*e=0;*p=e+1;return s;}
static int split(char *s,char **f){int n=1;f[0]=s;for(;*s;s++)if(*s=='\t'){if(n==32)die("columns");*s=0;f[n++]=s+1;}return n;}
static const char *field(char **f,int n,const char *k){long z=strlen(k);const char *v=0;for(int i=1;i<n;i++)if(!strncmp(f[i],k,z)&&f[i][z]=='='){if(v)die("duplicate field");v=f[i]+z+1;}if(!v)die("missing field");return v;}
static long num(const char *s){char *e;errno=0;long n=strtol(s,&e,10);if(!*s||*e||errno||n<0)die("number");return n;}
static long val(char **f,int n,const char *k){return num(field(f,n,k));}
static void eq(char **f,int n,const char *k,const char *h){if(strcmp(field(f,n,k),h))die("SHA/profile binding");}
static void text(char *p,long n){if(memchr(p,0,n)||memchr(p,'\r',n))die("text NUL/CR");}
static void save(const char *d,const char *name,const void *p,long n){char file[8192];path(file,d,name);int fd=sy_open_new(file,0600);if(fd<0)die("exclusive output file");int a=sy_write_all(fd,p,n),b=sy_close(fd);if(a||b)die("output write");}
typedef struct {char *name,*pp;long pn,nl,source;int synthetic;} Unit;
static Unit units[128];static long nu;
typedef struct {long at,unit,epoch,text,end;} Token;
typedef struct {long id,n,nt;char *b,hash[65];Token *tokens;int declared;} Frame;
static Frame frames[64];static long nf;
static Frame *frame(long id){for(int i=0;i<nf;i++)if(frames[i].id==id)return &frames[i];die("unknown exported frame");return 0;}
static long pp_source(const char *b,long n){long p=7;if(n<27||memcmp(b,"UNIPP1\0",7))die("UNIPP magic");long size=word(b,n,&p);word(b,n,&p);word(b,n,&p);long ns=word(b,n,&p),ni=word(b,n,&p);if(ns>67108864||ni>67108864)die("UNIPP maps bound");for(long i=0;i<ns;i++)if(word(b,n,&p)>size)die("UNIPP splice");for(long i=0;i<ni;i++){word(b,n,&p);word(b,n,&p);long z=word(b,n,&p);if(!z||z>62||z>n-p)die("UNIPP include");p+=z;}if(size!=n-p)die("UNIPP source extent");return size;}
static void tokens(Frame *fr){
 long p=8;if(fr->n<12||memcmp(fr->b,"UNITOK2\0",8)||word(fr->b,fr->n,&p)!=nu)die("normalized UNITOK2 count");
 for(long i=0;i<nu;i++){long z=word(fr->b,fr->n,&p);if(z!=units[i].nl||z>fr->n-p||memcmp(fr->b+p,units[i].name,z))die("normalized path map");p+=z;z=word(fr->b,fr->n,&p);if(z!=units[i].pn||z>fr->n-p||memcmp(fr->b+p,units[i].pp,z))die("normalized UNIPP map");p+=z;}
 fr->tokens=malloc(1000000*sizeof(Token));if(!fr->tokens)die("token index allocation");long epoch=-1,markers=0,eof=0;
 while(p<fr->n){tick();long at=p;if(fr->b[p++]!='@')die("token prefix");long u=word(fr->b,fr->n,&p),pos=word(fr->b,fr->n,&p);if(u>=nu||pos>units[u].source||p==fr->n||fr->b[p++]!='\n')die("token prefix range");long start=p;while(p<fr->n){if(fr->b[p++]=='\n'&&(p==fr->n||fr->b[p]=='@'))break;}if(p==start||fr->b[p-1]!='\n')die("token text boundary");long z=p-start;
 if(z==7&&!memcmp(fr->b+start,"@unit0\n",7)){if(markers||u||pos)die("initial marker");epoch=0;markers++;}else if(z==7&&!memcmp(fr->b+start,"@unit+\n",7)){epoch++;if(u!=epoch||pos||epoch!=markers)die("increment marker");markers++;}else{if(epoch<0||u!=epoch)die("token epoch");if(z==4&&!memcmp(fr->b+start,"eof\n",4)){if(p!=fr->n||u!=nu-1||pos!=units[u].source)die("eof range");eof++;}}
 if(fr->nt==1000000)die("token record bound");fr->tokens[fr->nt++]=(Token){at,u,epoch,start,p};
 }
 if(markers!=nu||epoch!=nu-1||eof!=1)die("marker closure");
}
static Token *anchor(Frame *fr,long at){if(!fr->tokens)tokens(fr);long l=0,r=fr->nt;while(l<r){long m=(l+r)/2;if(fr->tokens[m].at<at)l=m+1;else r=m;}if(l==fr->nt||fr->tokens[l].at!=at)die("hl_pos is not normalized prefix boundary");return &fr->tokens[l];}
typedef struct {long unit,lo,hi;int survived;char hash[65];} Context;
static Context contexts[100000];static long nc;
int main(int argc,char **argv){
 began=sy_now_ms();int sidecar=argc==9&&!strcmp(argv[8],"--sidecar");if(argc!=8&&!sidecar)die("usage MATERIAL_DIR ORIGINAL_UNITS_PAYLOAD FRAME_DIR CONFIG WATCH OUTPUT NEW_OUTDIR [--sidecar]");
 char p[8192],mh[65],fh[65],ah[65],uh[65],gh[65],wh[65],oh[65],xh[65],th[65];size_t mn,fn,an,un,gn,wn,on,xn;
 path(p,argv[1],"material.tsv");char *material=load(p,1048576,&mn,mh);text(material,mn);path(p,argv[1],"frames.bin");char *original=load(p,WF_CAP,&fn,fh);path(p,argv[1],"attrs.bin");char *attrs=load(p,16777216,&an,ah);
 char *ub=load(argv[2],134217728,&un,uh),*cfg=load(argv[4],65536,&gn,gh),*watch=load(argv[5],67108864,&wn,wh),*out=load(argv[6],134217728,&on,oh);text(cfg,gn);text(watch,wn);if(gn!=strlen(profile)||memcmp(cfg,profile,gn))die("fixed function watch config");
 char *mp=material,*s=line(&mp),*f[32];int n=s?split(s,f):0;if(!n||strcmp(f[0],"WHOLE_STAGE_MATERIAL"))die("material header");eq(f,n,"frames_sha",fh);eq(f,n,"attrs_sha",ah);if(val(f,n,"frames_bytes")!=fn||val(f,n,"attrs_bytes")!=an)die("material extents");char carrier_sha[65];snprintf(carrier_sha,sizeof carrier_sha,"%s",field(f,n,"carrier_sha"));long ac=val(f,n,"attributes"),complete=0,fp=0,splice=0;
 while((s=line(&mp))){n=split(s,f);if(complete)die("material trailing row");if(!strcmp(f[0],"SPLICE")){if(nu||splice||val(f,n,"inserted_unit")!=1)die("material splice");splice=1;continue;}if(!strcmp(f[0],"COMPLETE")){if(val(f,n,"frames")!=nu||val(f,n,"attributes")!=ac)die("material tail count");eq(f,n,"carrier_sha",carrier_sha);complete=1;continue;}if(strcmp(f[0],"FRAME")||nu==128||num(f[1])!=nu)die("material frame order");long start=fp,z=word(original,fn,&fp),end=fp+z,nl=word(original,fn,&fp);if(z<4||end>fn||nl<1||nl>=4096||nl>end-fp||original[fp]!='/')die("material frame range/path");Unit *u=&units[nu];u->name=malloc(nl+1);if(u->name){memcpy(u->name,original+fp,nl);u->name[nl]=0;}u->nl=nl;if(!u->name||memchr(original+fp,0,nl)||strpbrk(u->name,"\r\n\t")||strcmp(u->name,field(f,n,"path")))die("material exact path");for(long j=0;j<nu;j++)if(!strcmp(u->name,units[j].name))die("duplicate original path");fp+=nl;long payload=fp;if(end-fp<12||memcmp(original+fp,"UNITOK1\0",8))die("UNITOK1 payload");char hash[65];sha(original+fp,end-fp,hash);eq(f,n,"payload_sha",hash);if(val(f,n,"frame_lo")!=start||val(f,n,"frame_hi")!=end||val(f,n,"payload_lo")!=payload||val(f,n,"payload_bytes")!=end-payload)die("material recorded ranges");fp+=8;u->pn=word(original,end,&fp);if(u->pn>end-fp)die("UNITOK1 PP extent");u->pp=original+fp;u->source=pp_source(u->pp,u->pn);u->synthetic=splice&&nu==1;nu++;fp=end;}
 if(!complete||!nu||fp!=fn)die("material incomplete");long ap=0;if(word(attrs,an,&ap)!=ac||an!=4+9*ac)die("attributes extent");for(long i=0;i<ac;i++){if(word(attrs,an,&ap)>=nu)die("attribute unit");word(attrs,an,&ap);ap++;}path(p,argv[1],"units-input.carrier");size_t cn;char ch[65];char *carrier=load(p,WF_CAP,&cn,ch);if(strcmp(ch,carrier_sha)||cn!=12+an+fn||memcmp(carrier,"USLATTRT",8))die("material carrier hash/size");long cp=8;if(word(carrier,cn,&cp)!=an||memcmp(carrier+12,attrs,an)||memcmp(carrier+12+an,original,fn))die("carrier exact content");free(carrier);
 Frame raw={0};raw.b=ub;raw.n=un;tokens(&raw);free(raw.tokens);
 path(p,argv[3],"manifest.tsv");char *manifest=load(p,65536,&xn,xh);text(manifest,xn);char *xp=manifest;s=line(&xp);n=s?split(s,f):0;if(!n||strcmp(f[0],"WATCH_FRAME_EXPORT"))die("export manifest header");eq(f,n,"delta_sha",model);eq(f,n,"input_sha",uh);eq(f,n,"config_sha",gh);eq(f,n,"output_sha",oh);if(val(f,n,"output_bytes")!=on)die("manifest output extent");complete=0;long framebytes=0;
 while((s=line(&xp))){n=split(s,f);if(complete)die("manifest trailing row");if(!strcmp(f[0],"COMPLETE")){if(val(f,n,"frames")!=nf||val(f,n,"bytes")!=framebytes)die("export tail count");complete=1;continue;}if(strcmp(f[0],"FRAME")||nf==64)die("export frame row");long id=num(f[1]);for(long j=0;j<nf;j++)if(frames[j].id==id)die("duplicate export id");if(!id)die("zero export id");char name[80];snprintf(name,sizeof name,"frame-%ld.bin",id);eq(f,n,"file",name);Frame *fr=&frames[nf++];fr->id=id;path(p,argv[3],name);size_t z;fr->b=load(p,134217728,&z,fr->hash);fr->n=z;eq(f,n,"sha",fr->hash);if(val(f,n,"end")!=z||z>WF_CAP-framebytes)die("export length/total");framebytes+=z;}
 if(!complete)die("export missing COMPLETE");
 char *tape=out;long tn=on;if(sidecar){if(on<31||memcmp(out,"USLFW1\n",7))die("USLFW1 magic");unsigned long long q[3]={0};for(int j=0;j<3;j++)for(int k=0;k<8;k++)q[j]|=(unsigned long long)(unsigned char)out[7+j*8+k]<<(k*8);if(q[1]||q[2]>1000000||q[0]!=on-31)die("sidecar hostslots/tail");tape=out+31;tn=q[0];}sha(tape,tn,th);
 char *wp=watch;s=line(&wp);n=s?split(s,f):0;if(!n||strcmp(f[0],"WRITE_EVENTS"))die("watch header");eq(f,n,"delta_sha",model);eq(f,n,"input_sha",uh);eq(f,n,"config_sha",gh);eq(f,n,"output_sha",oh);eq(f,n,"frame_manifest_sha",xh);eq(f,n,"watch_format","compact-v1");eq(f,n,"snapshot_policy","single-active-output-v1");eq(f,n,"claim","STATE_OBSERVATION_ONLY");if(val(f,n,"output_bytes")!=on)die("watch output extent");
 long seq=0,active=0,phase=0,unit=0,lo=0,gen=0,fid=0,markseq=0,prevhi=0,close_hi=0;complete=0;
 while((s=line(&wp))){tick();n=split(s,f);if(complete)die("watch trailing row");if(!strcmp(f[0],"COMPLETE")){if(val(f,n,"events")!=seq||active||phase)die("watch final count/unclosed");complete=1;continue;}if(n<2||num(f[1])!=++seq||seq>1000000)die("watch sequence");
 if(!strcmp(f[0],"FRAME")){if(n!=5)die("FRAME schema");Frame *fr=frame(num(f[2]));if(fr->declared||strcmp(f[3],fr->hash)||num(f[4])!=fr->n)die("FRAME export mismatch");fr->declared=1;continue;}
 if(!strcmp(f[0],"WATCHC")){if(n<9)die("WATCHC schema");long slot=num(f[2]);if(slot>1||n!=(slot?11:13))die("fixed WATCHC slot/values");Frame *fr=frame(num(f[3]));if(!fr->declared||num(f[4])>fr->n)die("WATCH frame/cursor");long g=num(f[5]),len=num(f[6]);num(f[7]);num(f[8]);if(slot==0){if(active||phase||nc==100000)die("nested function/budget");long epoch=num(f[9]),hl=num(f[10]),ns=num(f[11]),ne=num(f[12]);Token *tok=anchor(fr,hl);if(tok->unit!=epoch||tok->epoch!=epoch||ns<tok->text||ne<=ns||ne>tok->end||epoch>=nu||len<prevhi)die("entry normalized source anchor/range");unit=epoch;lo=len;gen=g;fid=fr->id;phase=1;}else{if(!active||phase||num(f[9])!=unit||num(f[10])!=1||fr->id!=fid||g!=gen||len<lo)die("span entry context");close_hi=len;phase=2;}continue;}
 if(!strcmp(f[0],"OUTPUT_MARK")){if(n!=8||phase!=1||active||val(f,n,"mark_seq")!=seq||val(f,n,"frame_instance")!=fid||val(f,n,"output_generation")!=gen||val(f,n,"output_lo")!=lo)die("mark pairing");Frame *fr=frame(fid);eq(f,n,"frame_sha",fr->hash);if(val(f,n,"frame_end")!=fr->n)die("mark frame end");markseq=seq;active=1;phase=0;continue;}
 if(!strcmp(f[0],"OUTPUT_SPAN")){if(n!=10||!active||phase!=2||val(f,n,"mark_seq")!=markseq||val(f,n,"frame_instance")!=fid||val(f,n,"output_generation")!=gen||val(f,n,"output_lo")!=lo)die("span pairing");Frame *fr=frame(fid);eq(f,n,"frame_sha",fr->hash);if(val(f,n,"frame_end")!=fr->n)die("span frame end");long hi=val(f,n,"output_hi");if(hi<lo||hi>tn||hi!=close_hi)die("snapshot final range/observed close");Context *c=&contexts[nc++];c->unit=unit;c->lo=lo;c->hi=hi;snprintf(c->hash,sizeof c->hash,"%s",field(f,n,"span_sha"));if(strlen(field(f,n,"span_sha"))!=64)die("span SHA shape");char hash[65];sha(tape+lo,hi-lo,hash);c->survived=!strcmp(hash,c->hash);if(c->survived&&((lo&&tape[lo-1]!='\n')||(hi&&tape[hi-1]!='\n')))die("survived snapshot full line boundary");prevhi=hi;active=0;phase=0;continue;}die("unknown watch record");}
 if(!complete)die("watch missing COMPLETE");for(long i=0;i<nf;i++)if(!frames[i].declared)die("unobserved export frame");
 struct stat st;if(!lstat(argv[7],&st)||errno!=ENOENT)die("fresh output directory required");if(mkdir(argv[7],0700))die("output mkdir");save(argv[7],"tape",tape,tn);char *ledger=malloc(33554432);if(!ledger)die("origin allocation");long used=snprintf(ledger,33554432,"WHOLE_FUNCTION_ORIGIN\tversion=1\tmaterial_sha=%s\tframes_sha=%s\tattrs_sha=%s\toriginal_units_sha=%s\tframe_manifest_sha=%s\tconfig_sha=%s\twatch_sha=%s\toutput_sha=%s\ttape_sha=%s\tdelta_sha=%s\tclaim=emitter-context-not-exclusive-ownership\n",mh,fh,ah,uh,xh,gh,wh,oh,th,model);
 for(long i=0;i<nu;i++){int z=snprintf(ledger+used,33554432-used,"UNIT\t%ld\tplanned_source=%s\tkind=%s\n",i,units[i].name,units[i].synthetic?"SYNTHETIC":"SOURCE");if(z<0||z>=33554432-used)die("ledger bound");used+=z;}
 long at=0;for(long i=0;i<nc;i++){Context *c=&contexts[i];if(c->lo>at)used+=snprintf(ledger+used,33554432-used,"UNKNOWN\tlo=%ld\thi=%ld\n",at,c->lo);int z=snprintf(ledger+used,33554432-used,"CONTEXT\t%ld\tunit=%ld\tlo=%ld\thi=%ld\tsurvived=%d\tsha=%s\n",i,c->unit,c->lo,c->hi,c->survived,c->hash);if(z<0||z>=33554432-used)die("ledger bound");used+=z;at=c->hi;}if(at<tn)used+=snprintf(ledger+used,33554432-used,"UNKNOWN\tlo=%ld\thi=%ld\n",at,tn);int z=snprintf(ledger+used,33554432-used,"COMPLETE\tunits=%ld\tcontexts=%ld\ttape_bytes=%ld\ttape_sha=%s\n",nu,nc,tn,th);if(z<0||z>=33554432-used)die("ledger tail");used+=z;save(argv[7],"origin.tsv",ledger,used);printf("WHOLE_FUNCTION_ORIGIN\tcontexts=%ld\tunits=%ld\ttape_sha=%s\n",nc,nu,th);return 0;
}
