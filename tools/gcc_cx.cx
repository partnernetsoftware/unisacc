#pragma unisa use cxcc
/* Compile one or more .cx files with gcc from PATH.
   Linux and OSX: sh ./gcc_cx.com FILE.cx -o OUT [gcc arguments]
   Windows: gcc_cx.com FILE.cx -o OUT [gcc arguments]
   tools/build-cxcc-host.cx writes the entry on that machine.
   It links src/cxmod.c and does not run unisacc.com. -o is this step.
   Blanks a leading #! and forces -std=c99 -x c -include include/cx.h.
   Expands `#pragma unisa use` inside the driver.
   Stock gcc ignores #pragma unisa. Module lines are expanded here, then compiled by gcc.
   The binary is ordinary C, not a checked .cx build.
   The driver names tools/cxproc.cx. On Linux a null environment is an empty
   list. On Windows a null environment is inherit. This tree ran the Linux
   entry. Windows and OSX were not executed.
*/
int cxcc_drive(int argc, char **argv, const char *compiler, const char *cmd);

int main(int argc, char **argv) {
    return cxcc_drive(argc, argv, "gcc", "gcc_cx");
}
