#pragma unisa use cxcc
/* Compile one or more .cx files with the system gcc.
   sh ./gcc_cx.com FILE.cx -o OUT [gcc arguments]
   The .com is the Linux host driver from tools/build-cxcc-host.cx.
   It links src/cxmod.c and does not run unisacc.com. -o is this step; -run is later.
   Blanks a leading #! and forces -std=c99 -x c -include include/cx.h.
   Expands `#pragma unisa use` inside the driver.
   Stock gcc ignores #pragma unisa. Module lines are expanded here, then compiled by gcc.
   The binary is ordinary C, not a checked .cx build.
   The Windows slice spawns gcc with posix_spawnp. It was not executed on Windows.
*/
int cxcc_drive(int argc, char **argv, const char *compiler, const char *cmd);

int main(int argc, char **argv) {
    return cxcc_drive(argc, argv, "gcc", "gcc_cx");
}
