/* tools/check-batch-cost.cx -- tools/batch-cost.cx 的夹具检查: 自造小日志目录.
 * 冷批(PREPARED fresh + elapsed_ms + PREBUILD)、热批(identity-hit + tlib=fallback)、无 PREPARED(UNMEASURED)、
 * 空目录、坏行容错. sh ./unisacc.com tools/check-batch-cost.cx [-- ROOT OUT] */
#pragma unisa use cxlib.toolprep
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.proc
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

static int failed;
static char root[4096], work[4400], bin[4400], fx[4400];
static char *last;
static size_t lastn;

static int has(const char *needle) {
    long nl = tx_len(needle, 512);
    for (long i = 0; last && i + nl <= (long)lastn; i++) if (mm_same(last + i, needle, nl)) return 1;
    return 0;
}

static void ck(int ok, const char *name) {
    if (!ok) { failed++; if (last) sy_printf("%s", last); }
    sy_printf("%s\tbatch-cost.%s\n", ok ? "PASS" : "FAIL", name);
}

static int run(const char *dir, const char *extra) {
    char *v[10];
    int k = 0;
    mm_free(last); last = 0; lastn = 0;
    v[k++] = bin; v[k++] = "--dir"; v[k++] = (char *)dir;
    if (extra) v[k++] = (char *)extra;
    v[k] = 0;
    return cx_runv_timeout(v, 20, &last, &lastn);
}

static int put(const char *dir, const char *name, const char *text) {
    char p[4800];
    if (cx_fmt(p, sizeof p, "%s/%s", dir, name)) return -1;
    return cx_write(p, text, (size_t)tx_len(text, TX_ZCAP));
}

int main(int argc, char **argv) {
    char src[4400], d1[4400], d2[4400], d3[4400], dot[4400], e1[4400];
    int rc;
    if (sy_realpath(argc >= 2 && argv[1][0] ? argv[1] : ".", root, sizeof root) < 0) return 2;
    if (argc >= 3 && argv[2][0]) { (void)sy_mkdir(argv[2], 0755); if (cx_fmt(work, sizeof work, "%s/batch-cost-%d-%ld", argv[2], sy_pid(), sy_now_ms())) return 2; }
    else {
        if (cx_fmt(dot, sizeof dot, "%s/out", root) || cx_fmt(work, sizeof work, "%s/check-batch-cost-%d-%ld", dot, sy_pid(), sy_now_ms())) return 2;
        (void)sy_mkdir(dot, 0755);
    }
    if (sy_mkdir(work, 0700)) return 2;
    if (cx_fmt(src, sizeof src, "%s/tools/batch-cost.cx", root) || cx_fmt(bin, sizeof bin, "%s/batch-cost.native", work) ||
        cx_fmt(fx, sizeof fx, "%s/fx", work) || cx_fmt(d1, sizeof d1, "%s/affected-1", fx) || cx_fmt(d2, sizeof d2, "%s/affected-2", fx) ||
        cx_fmt(d3, sizeof d3, "%s/empty", work) || cx_fmt(e1, sizeof e1, "%s/other-3", fx)) return 2;
    if (sy_mkdir(fx, 0755) || sy_mkdir(d1, 0755) || sy_mkdir(d2, 0755) || sy_mkdir(d3, 0755) || sy_mkdir(e1, 0755)) return 2;
    { char why[256]; if (tq_native(root, src, bin, why, sizeof why)) { sy_printf("FAIL\tbatch-cost.build-native\t%s\n", why); return 1; } }
    put(d1, "cold.log", "PREPARED\trunner-native\tidentity=ab\tunits=10\treused=0\treason=fresh\tno-test-result\tx.cx\nPREBUILD\tkit\nelapsed_ms=42500\nBATCH_RUN\tid=cold\tstatus=PASS\n");
    put(d1, "hot.log", "PREPARED\trunner-native\tidentity=ab\tunits=10\treused=10\treason=identity-hit\tno-test-result\tx.cx\ntlib=fallback\nelapsed_ms=8000\n");
    put(d2, "nop.log", "PASS\tfoo\nBATCH_RUN\tid=nop\tstatus=PASS\n");
    put(d2, "bad.log", "PREPARED\tunits=zz\treused=\nelapsed_ms=\n\n\t\tPREPAREDX units=3\n");
    put(d2, "note.txt", "PREPARED units=1 reused=1 elapsed_ms=99999\n");
    put(e1, "ignored.log", "elapsed_ms=1\n");
    rc = run(fx, "--top");
    ck(rc == 2, "top-needs-value-rc2");
    rc = run(fx, 0);
    ck(rc == 0, "run-rc0");
    ck(has("BATCH_COST\tcold\t42.500\t0\t10\tUNMEASURED\tprebuilt\tcold\t"), "cold-row");
    ck(has("BATCH_COST\thot\t8.000\t10\t0\tUNMEASURED\tfallback\thot\t"), "hot-row");
    ck(has("BATCH_COST\tnop\tUNMEASURED\tUNMEASURED\tUNMEASURED\tUNMEASURED\tUNMEASURED\tUNMEASURED\t"), "no-prepared-unmeasured");
    ck(has("BATCH_COST\tbad\tUNMEASURED\tUNMEASURED\tUNMEASURED\tUNMEASURED\tUNMEASURED\tUNMEASURED\t"), "bad-lines-tolerated");
    ck(!has("ignored") && !has("note"), "non-matching-skipped");
    ck(has("BATCH_COST_SUMMARY\tlogs=4\tmedian_s=42.500\tover30s=1\twall_measured=2/4\tmaterials_measured=2/4\tkit_measured=2/4\twarm_measured=2/4"), "summary");
    rc = run(d3, 0);
    ck(rc == 0 && has("BATCH_COST_SUMMARY\tlogs=0\tmedian_s=UNMEASURED\tover30s=0\twall_measured=0/0"), "empty-dir");
    rc = run(fx, 0);
    {
        char *v[10]; int k = 0;
        mm_free(last); last = 0; lastn = 0;
        v[k++] = bin; v[k++] = "--dir"; v[k++] = fx; v[k++] = "--top"; v[k++] = "1"; v[k] = 0;
        rc = cx_runv_timeout(v, 20, &last, &lastn);
    }
    ck(rc == 0 && has("TOP\t1\tcold\t42.500"), "top-1");
    sy_printf("CHECK_BATCH_COST\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
