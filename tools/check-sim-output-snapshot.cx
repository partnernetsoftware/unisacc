/* Independent output snapshot fixtures; no source ownership claim. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sysx.process
static char work[4400],sim[4400],com[4400],delta[4400],input[4400],config[4400],side[4400];static int checks,bad;
static const char *good="M\tx\toutput-mark\nE\tx\toutput-span\n";
static void die(const char *s){fprintf(stderr,"snapshot-check %s\n",s);exit(2);}
static void ck(int v,const char *s){checks++;bad+=!v;printf("%s\t%s\n",v?"PASS":"FAIL",s);}
static int exists(void){struct stat st;if(!lstat(side,&st))return 1;if(errno==ENOENT)return 0;die("stat");return 1;}
static void put(const char *p,const char *s){if(cx_write(p,s,strlen(s)))die("write");}
static char *run(int on,int expected,const char *limit){char *v[20];int n=0;v[n++]="sh";v[n++]=com;v[n++]=sim;v[n++]="--";v[n++]=delta;v[n++]=input;if(on){v[n++]="--write-events";v[n++]=side;v[n++]="--watch-states";v[n++]=config;v[n++]="--watch-compact";}if(limit){v[n++]="--event-limit";v[n++]=(char *)limit;}v[n]=0;np_result r={0};char why[256]={0};int tr=np_run(v,0,0,8,&r,why,sizeof why);char *out=0;if(!tr&&!r.residue&&r.rc==expected){out=malloc(r.outn+1);memcpy(out,r.out,r.outn);out[r.outn]=0;}else fprintf(stderr,"transport=%d rc=%d expected=%d %s\n%s\n",tr,r.rc,expected,why,r.err?r.err:"");np_free(&r);return out;}
static void fixture(int mode){
 const char *start=mode==9?"S":mode==3?"E":"M",*next=mode==2?"M":mode==6?"Z":"E";
 const char *emit=mode==9?"[[\"OUT\",97],[\"OUT\",10],[\"LDI\",\"at\",1],[\"LDI\",\"x\",8],[\"OFILL\",\"at\",\"x\",1]]":mode==4?"[[\"OUT\",97],[\"OUT\",10],[\"SWAP\"]]":mode==5?"[[\"OUT\",97]]":mode==7?"[[\"LDI\",\"lo\",0],[\"LDI\",\"hi\",1],[\"BLOBSAVE\",\"blob\",\"lo\",\"hi\"],[\"INPUSH\",\"blob\"],[\"OUT\",97],[\"OUT\",10]]":mode==1?"[[\"OUT\",97],[\"OUT\",10],[\"LDI\",\"at\",0],[\"OCUT\",\"cut\",\"at\"],[\"OUT\",98],[\"OUT\",10]]":"[[\"OUT\",97],[\"OUT\",98],[\"OUT\",99],[\"OUT\",10],[\"LDI\",\"at\",1],[\"LDI\",\"x\",9],[\"OFILL\",\"at\",\"x\",1]]";
 const char *finish=mode==8?"[[\"LDI\",\"at\",0],[\"LDI\",\"x\",8],[\"OFILL\",\"at\",\"x\",1],[\"ACCEPT\"]]":"[[\"ACCEPT\"]]";
 char text[4096];snprintf(text,sizeof text,"{\"start\":\"%s\",\"states\":{\"S\":[\"r\",{\"0\":[\"M\",3]}],\"M\":[\"r\",{\"0\":[\"%s\",0]}],\"E\":[\"r\",{\"0\":[\"Z\",1]}],\"Z\":[\"r\",{\"0\":[\"Z\",1]}]},\"seqs\":[%s,%s,[[\"LDI\",\"x\",0]],[[\"OUT\",113],[\"OUT\",10]]]}",start,next,emit,finish);put(delta,text);put(input,"A");put(config,good);
}
static void failure(int mode,const char *label){fixture(mode);char *s=run(1,2,0);ck(s&&!exists(),label);free(s);}
int main(int argc,char **argv){char root[4400],temp[]="/tmp/check-output-snapshot-XXXXXX";if(!realpath(".",root)||!mkdtemp(temp))die("root/tmp");strcpy(work,temp);cx_fmt(com,sizeof com,"%s/unisacc.com",root);if(argc==2)strcpy(sim,argv[1]);else if(argc==1)cx_fmt(sim,sizeof sim,"%s/tools/sim.cx",root);else return 2;cx_fmt(delta,sizeof delta,"%s/delta",work);cx_fmt(input,sizeof input,"%s/input",work);cx_fmt(config,sizeof config,"%s/config",work);cx_fmt(side,sizeof side,"%s/side",work);
 fixture(0);char *off=run(0,0,0),*on=run(1,0,"5");ck(off&&on&&!strcmp(on,"a9c\n")&&!strcmp(off,on),"OFILL snapshot/default exact output and budget5");size_t n;char *log=cx_read(side,&n),h[65],needle[160];cx_sha256_hex("a9c\n",4,h);snprintf(needle,sizeof needle,"output_lo=0\toutput_hi=4\tspan_sha=%s",h);ck(log&&strstr(log,"snapshot_policy=single-active-output-v1")&&strstr(log,"OUTPUT_MARK\t3\tmark_seq=3")&&strstr(log,"OUTPUT_SPAN\t5\tmark_seq=3")&&strstr(log,needle)&&strstr(log,"COMPLETE\tevents=5"),"paired records bind actual OFILL slice SHA and shared sequence");free(log);free(off);free(on);unlink(side);
 fixture(1);on=run(1,0,0);log=cx_read(side,&n);cx_sha256_hex("b\n",2,h);snprintf(needle,sizeof needle,"span_sha=%s",h);ck(on&&!strcmp(on,"b\n")&&log&&strstr(log,needle),"same-generation cut and restore captures actual slice");free(on);free(log);unlink(side);
 fixture(8);on=run(1,0,0);log=cx_read(side,&n);cx_sha256_hex("a9c\n",4,h);snprintf(needle,sizeof needle,"span_sha=%s",h);char final[65];if(on)cx_sha256_hex(on,strlen(on),final);ck(on&&!strcmp(on,"89c\n")&&log&&strstr(log,needle)&&strcmp(final,h),"later overwrite makes final same-range hash differ from frozen snapshot");free(on);free(log);unlink(side);
 failure(2,"nested mark refuses without publication");failure(3,"span without active mark refuses");failure(4,"cross-generation refuses");failure(5,"partial output line refuses");failure(6,"ACCEPT with unclosed mark refuses");failure(7,"different input frame refuses");failure(9,"later overwrite of start line boundary refuses");
 fixture(0);put(config,"M\tx\toutput-mark\n");on=run(1,2,0);ck(on&&!exists(),"unpaired policy config refuses");free(on);
 fixture(0);put(config,"M\tx\toutput-mark,frame-edges\nE\tx\toutput-span\n");on=run(1,2,0);ck(on&&!exists(),"combined policy literal refuses");free(on);
 fixture(0);on=run(1,2,"4");ck(on&&!exists(),"extra snapshot records obey original event budget");free(on);
 unlink(delta);unlink(input);unlink(config);rmdir(work);printf("SIM_OUTPUT_SNAPSHOT_CHECK\tchecks=%d\tfailed=%d\n",checks,bad);return bad?1:0;}
