/* Mixed P3 two-generation fixed point. Four admission observations are
 * separate <=55s commands; compare consumes their fresh run evidence. */
#pragma unisa use cxlib.rebuildcontext
#pragma unisa use text.text
static int checks,failed;
static void die(const char *s){fprintf(stderr,"selfhost-mixed: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void check(int ok,const char *s){checks++;if(!ok)failed++;printf("%s\tselfhost-mixed.%s\n",ok?"PASS":"FAIL",s);}
static void path(char p[4400],const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path-bound");}
static char *read_regular(const char *p,size_t *n){struct stat st;if(lstat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>67108864)die("bounded-regular-input");char *s=cx_read(p,n);if(!s||*n!=(size_t)st.st_size)die("read-extent");return s;}
static void same(const char *a,const char *b,const char *label){size_t an,bn;char *av=read_regular(a,&an),*bv=read_regular(b,&bn);check(an==bn&&!memcmp(av,bv,an),label);free(av);free(bv);}
static void field(const char *s,const char *key,char *out,size_t cap){char pat[120];int pn=snprintf(pat,sizeof pat,"\n%s\t",key);if(pn<0||(size_t)pn>=sizeof pat)die("field-key");const char *v=strstr(s,pat);if(!v||strstr(v+1,pat))die("field-missing-or-duplicate");v+=pn;const char *end=strchr(v,'\n');if(!end||(end==v&&!tx_eqz(key, "native"))||(size_t)(end-v)>=cap)die("field-shape");{size_t i=0,n=(size_t)(end-v);while(i<n){out[i]=v[i];i++;}out[n]=0;}}
typedef struct {char run[100],role[30],root[4400],gen[4400],pkg[4400],source[65],product[65],package[65],witness[65],root_product[65],root_native[65],native[65];} Report;
static void report(const char *p,Report *r){size_t n;char *s=read_regular(p,&n);const char *schema="selfhost-mixed-endpoint-v1\n";if(n<strlen(schema)||memcmp(s,schema,strlen(schema)))die("report-schema");char end[30];field(s,"ENDPOINT",end,sizeof end);if(!tx_eqz(end, "VERIFIED"))die("endpoint-status");field(s,"run",r->run,sizeof r->run);field(s,"role",r->role,sizeof r->role);field(s,"root",r->root,sizeof r->root);field(s,"generation",r->gen,sizeof r->gen);field(s,"package-dir",r->pkg,sizeof r->pkg);field(s,"source",r->source,sizeof r->source);field(s,"product",r->product,sizeof r->product);field(s,"package",r->package,sizeof r->package);field(s,"witness",r->witness,sizeof r->witness);field(s,"root-product",r->root_product,sizeof r->root_product);field(s,"root-native",r->root_native,sizeof r->root_native);field(s,"native",r->native,sizeof r->native);free(s);}
static int endpoint(int argc,char **argv){if(argc!=7)die("endpoint-usage");const char *role=argv[2],*run=argv[3],*root=argv[4],*gen=argv[5],*pkg=argv[6];if(!tx_eqz(role, "prior")&&!tx_eqz(role, "fresh")&&!tx_eqz(role, "after-prior")&&!tx_eqz(role, "after-fresh"))die("role");if(!*run||strlen(run)>90||strpbrk(run,"\t\r\n"))die("run-id");char boot[4400],why[2048];path(boot,root,"unisacc.com");rb_result r;if(rb_verify_mixed_candidate(root,gen,pkg,boot,&r,why,sizeof why)){fprintf(stderr,"selfhost-mixed: REFUSE %s\n",why);return 2;}if(r.package_kind!=4||r.source_jobs!=156||r.source_models!=34)die("mixed-completeness");printf("selfhost-mixed-endpoint-v1\nrun\t%s\nrole\t%s\nroot\t%s\ngeneration\t%s\npackage-dir\t%s\nsource\t%s\nproduct\t%s\npackage\t%s\nwitness\t%s\nroot-product\t%s\nroot-native\t%s\nnative\t%s\nsource-jobs\t%d\nsource-models\t%d\nphysical-reads\t%d\nENDPOINT\tVERIFIED\n",run,role,root,gen,pkg,r.source,r.product,r.package,r.witness,r.root_product,r.root_native,r.native_receipt,r.source_jobs,r.source_models,r.physical_reads);return 0;}
static int compare(int argc,char **argv){if(argc!=12)die("compare-usage");const char *run=argv[2],*root=argv[3],*g1=argv[4],*p1=argv[5],*g2=argv[6],*p2=argv[7];Report r[4];for(int i=0;i<4;i++)report(argv[8+i],&r[i]);const char *roles[]={"prior","fresh","after-prior","after-fresh"};for(int i=0;i<4;i++){char label[60];{int zn=snprintf(label,sizeof label,"endpoint-%d-run-role-paths",i);if(zn<0||(size_t)zn>=sizeof label)die("label");}check(tx_eqz(r[i].run, run)&&tx_eqz(r[i].role, roles[i])&&tx_eqz(r[i].root, root)&&tx_eqz(r[i].gen, i%2?g2:g1)&&tx_eqz(r[i].pkg, i%2?p2:p1),label);}
 check(tx_eqz(r[0].witness, r[2].witness)&&tx_eqz(r[0].source, r[2].source),"prior-before-after-stable");check(tx_eqz(r[1].witness, r[3].witness)&&tx_eqz(r[1].source, r[3].source),"fresh-before-after-stable");check(tx_eqz(r[0].source, r[1].source),"same-current-source");check(tx_eqz(r[0].product, r[1].product)&&tx_eqz(r[0].product, r[1].root_product),"same-product-and-root");check(tx_eqz(r[0].package, r[1].package),"same-package");check(tx_eqz(r[0].native, r[1].root_native),"root-native-from-prior");
 const char *arch[]={"x86_64","arm64"},*units[]={"transition","arith","buffer","memory","intern","bytes","format","stack","action","run","bridge"},*ext[]={"s","o"};char rel[160],a[4400],b[4400],label[220];for(int i=0;i<2;i++){for(int j=0;j<11;j++)for(int k=0;k<2;k++){{int zn=snprintf(rel,sizeof rel,"%s/%s.%s",arch[i],units[j],ext[k]);if(zn<0||(size_t)zn>=sizeof rel)die("label");}path(a,g1,rel);path(b,g2,rel);{int zn=snprintf(label,sizeof label,"rebuild.%s",rel);if(zn<0||(size_t)zn>=sizeof label)die("label");}same(a,b,label);}{int zn=snprintf(rel,sizeof rel,"%s.kernel",arch[i]);if(zn<0||(size_t)zn>=sizeof rel)die("label");}path(a,g1,rel);path(b,g2,rel);same(a,b,rel);}
 const char *slices[]={"slice-win-x86_64","slice-lnx-x86_64","slice-lnx-arm64","slice-osx-x86_64","slice-osx-arm64"};for(int i=0;i<5;i++){path(a,g1,slices[i]);path(b,g2,slices[i]);same(a,b,slices[i]);}path(a,g1,"unisacc-next.com");path(b,g2,"unisacc-next.com");same(a,b,"complete-product-fixed-point");path(a,root,"unisacc.com");same(a,b,"fresh-product-equals-root");path(a,p1,"compiler.pkg");path(b,p2,"compiler.pkg");same(a,b,"prepared-package-bytes");printf("SELFHOST_MIXED\tassertions=%d\tfailed=%d\tfour-fresh-endpoints=required\tno-N22-or-foreign-host-claim\n",checks,failed);return failed?1:0;}
int main(int argc,char **argv){if(argc>1&&tx_eqz(argv[1], "endpoint"))return endpoint(argc,argv);if(argc>1&&tx_eqz(argv[1], "compare"))return compare(argc,argv);die("usage endpoint ROLE RUN ROOT GEN PKG | compare RUN ROOT GEN1 PKG1 GEN2 PKG2 LOG1 LOG2 LOG3 LOG4");return 2;}
