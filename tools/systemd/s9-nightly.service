[Unit]
Description=unisacc s9 nightly (commit tier)

[Service]
Type=oneshot
WorkingDirectory=%h/s9-nightly-clone
ExecStart=/bin/sh ./unisacc.com tools/s9-nightly-run.cx -- --clone %h/s9-nightly-clone --evidence %h/s9-nightly-evidence --tier commit --max-steps 8 --load-max 12
TimeoutStartSec=1800
KillMode=control-group
Nice=10
