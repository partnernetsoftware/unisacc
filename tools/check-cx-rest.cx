#pragma unisa use compiler.restname
#pragma unisa use runtime.restname
#pragma unisa use compiler.endname
#pragma unisa use compiler.streamname
#pragma unisa use sys.io
#pragma unisa use text.text
/* Generated by tools/rest-gen.cx. Narrow check of non-endpoint stage codes. */
int main(void) {
    const char *name;
    const char *end;
    const char *official;
    const char *code;
    const char **missing;
    int i, j, seen, hit_end, hit_rest, outside;
    missing = 0;
    if (nst_count() != 2) return 1;
    if (nst_at(0, &name) || !tx_eqz(name, "e1")) return 1;
    if (nst_at(1, &name) || !tx_eqz(name, "prune")) return 1;
    if (nst_at(0, missing) != 4) return 1;
    if (nst_at(-1, &name) != 2) return 1;
    if (nst_at(2, &name) != 2) return 1;
    if (rns_count() != 2) return 1;
    if (rns_at(0, &name) || !tx_eqz(name, "e1")) return 1;
    if (rns_at(1, &name) || !tx_eqz(name, "prune")) return 1;
    if (rns_at(0, missing) != 4) return 1;
    if (rns_at(-1, &name) != 2) return 1;
    if (rns_at(2, &name) != 2) return 1;
    if (sn_count() != 7) return 1;
    if (lsn_count() != 5) return 1;
    for (i = 0; i < nst_count(); i++) {
        seen = 0;
        if (nst_at(i, &name)) return 1;
        for (j = 0; j < sn_count(); j++) {
            if (sn_at(j, &official, &code)) return 1;
            if (tx_eqz(code, name)) seen = 1;
        }
        if (!seen) return 1;
        for (j = 0; j < lsn_count(); j++) {
            if (lsn_at(j, &end)) return 1;
            if (tx_eqz(end, name)) return 1;
        }
    }
    outside = 0;
    for (j = 0; j < sn_count(); j++) {
        hit_end = 0;
        hit_rest = 0;
        if (sn_at(j, &official, &code)) return 1;
        for (i = 0; i < lsn_count(); i++) {
            if (lsn_at(i, &end)) return 1;
            if (tx_eqz(end, code)) hit_end = 1;
        }
        for (i = 0; i < nst_count(); i++) {
            if (nst_at(i, &name)) return 1;
            if (tx_eqz(name, code)) hit_rest = 1;
        }
        if (!hit_end) {
            outside = outside + 1;
            if (!hit_rest) return 1;
        } else if (hit_rest) return 1;
    }
    if (outside != nst_count()) return 1;
    sy_printf("CX_REST\tok=2\tfailed=0\n");
    return 0;
}
