/* tools/check-devsvc-core.cx -- 检查 tools/devsvc.cx 的固定版本启动器(按 git HEAD 构造执行体,不受工作副本影响)。批次 devsvc-core。
 *
 *   sh ./unisacc.com tools/check-devsvc-core.cx        (在仓根跑)
 *
 * 夹具:`git clone --local` 本仓到 /tmp/dvcore-<pid>,把工作副本的 devsvc.cx、devsvc-core.cx、devsvc-repo.tsv 提交进夹具的 HEAD,
 *   产品用符号链接指向本检出的产品;固定版本缓存目录与实例目录都在 /tmp/dvcore-<pid>-* 下,不碰真实缓存与实例。
 * 断言:(1)首次调用(冷构造)成功且 stderr 没有"using the working copy";(2)第二次调用命中缓存(远快于冷构造);
 *   (3)把夹具工作副本的核心改成语法错后,普通调用仍成功(用的是 HEAD 版本);(4)--dev 走工作副本,在语法错下失败。
 * 分组:--cases a(冷构造、缓存、取消、后台作业)|b(配置表、锁租约、坏工作副本)|c(版本工作树、第二克隆)|d(内容键退回);无参数四组顺序全跑。
 * 输出 PASS/FAIL 行,末行 CHECK_DEVSVC_CORE<TAB>ok=N<TAB>failed=N;有 FAIL 则 rc 1。 */
#pragma unisa use sys.time
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sys.posix
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sysx.process
#pragma unisa use mem.bytes
#pragma unisa use mem.heap

static int nok, nfail, ovf;
#define F(dst, cap, ...) do { int f_ = snprintf(dst, cap, __VA_ARGS__); if (f_ < 0 || f_ >= (int)(cap)) ovf++; } while (0)
static char root[1024], dbase[500], fx[540], pin[540], inst[540], prod[1300], out[1 << 15];
static void ck(int c, const char *name) {
    printf("%s\tdevsvc-core.%s\n", c ? "PASS" : "FAIL", name);
    if (!c) printf("NOTE\tlast-output\t%.600s\n", out);
    if (c) nok++; else nfail++;
}
/* 有界跑一条命令(55 秒上限):stdout 后接 stderr 收进 out,返回退出码;起不来或装不下返回 -1 */
static int run(char **v, const char *cwd, char *const *env) {
    np_result r; char why[200]; int rc; long a, b;
    memset(out, 0, sizeof out);
    if (np_run(v, cwd, env, 55, &r, why, sizeof why)) return -1;
    a = (long)r.outn; b = (long)r.errn; rc = r.rc;
    if (a + b > (long)sizeof out - 1 || (a > 0 && mm_copy(out, sizeof out, r.out, a)) || (b > 0 && mm_copy(out + a, sizeof out - a, r.err, b))) rc = -1;
    np_free(&r);
    return rc;
}
static int has(const char *s) { return strstr(out, s) != 0; }

static void check_lock_budget(const char *cwd, const char *product, char *const *env, int prefix) {
    char canonical[600], repo_sha[65], tag[16] = "";
    if (sy_realpath(cwd, canonical, sizeof canonical) < 0 ||
        sy_sha256_hex(canonical, strlen(canonical), repo_sha)) { ck(0, "lock-budget-root"); return; }
    if (prefix && cx_fmt(tag, sizeof tag, "w%.8s:", repo_sha)) { ck(0, "lock-budget-prefix"); return; }
    const int lengths[] = {63 - prefix, 64 - prefix, 65 - prefix, 60};
    for (int i = 0; i < (prefix ? 4 : 3); i++) {
        char name[70], file[740], table[740], row[1500], hash[65], event[110], label[80];
        int n = lengths[i];
        memset(name, 'a' + i, n); name[n] = 0;
        if (cx_fmt(file, sizeof file, "%s/%s", canonical, name) ||
            cx_fmt(table, sizeof table, "%s/lock-budget.tsv", canonical) ||
            cx_fmt(row, sizeof row, "probe\tfile.write\t-\troot=%s;path=%s;content=isolated%%0A;expect_sha=absent\n", canonical, name) ||
            cx_fmt(label, sizeof label, "lock-budget-prefix-%d-final-%d", prefix, prefix + n) ||
            sy_sha256_hex(name, n, hash)) { ck(0, "lock-budget-setup"); return; }
        if (prefix + n < 64) F(event, sizeof event, "\tlock.acquire\t%s%s\towner=", tag, name);
        else F(event, sizeof event, "\tlock.acquire\t%ssha:%.16s\towner=", tag, hash);
        char *v[] = {"sh", (char *)product, "tools/devsvc.cx", "--", "flow", table, "--txn", "--par", "1", "--owner", "lock-budget", 0};
        int ok = !ovf && !sy_write_atomic(table, row, strlen(row), 0600) && run(v, cwd, env) == 0;
        unsigned char *data = 0; int64_t size = 0;
        ok = ok && !sy_read_file(file, &data, &size, 16) && size == 9 && !memcmp(data, "isolated\n", 9);
        free(data);
        if (ok) {
            char *ev[] = {"sh", (char *)product, "tools/devsvc.cx", "--", "events", 0};
            ok = run(ev, cwd, env) == 0 && has(event);
        }
        ck(ok, label);
        sy_unlink(table);
        if (sy_is_reg(file) == 1) sy_unlink(file);
    }
}

/* 分组:a 冷构造与缓存、取消与后台作业;b 配置表、锁租约、坏工作副本;c 版本工作树、第二克隆、内容键退回。各组独立夹具、固定版本缓存与实例目录 */
static int group(int g) {
    char *envv[4]; char e1[220], e2[220]; long t0, ms_cold = 0, ms_hot = 0; int rc;
    if (sy_cwd(root, sizeof root) < 0) return 2;
    {   /* 固定私有副本 ~/.cache/unisacc/check-devsvc-core/<仓根 FNV-1a 64>/:跨次复用夹具与产品 -run 编译缓存;flock 防并跑 */
        const char *home = sy_env("HOME"); unsigned long long hh = 1469598103934665603ULL; long q; char lkp[400]; int lfd;
        if (!home) return 2;
        for (q = 0; root[q]; q++) { hh ^= (unsigned char)root[q]; hh *= 1099511628211ULL; }
        F(dbase, sizeof dbase, "%s/.cache/unisacc/check-devsvc-core/%016llx-%c", home, hh, g);
        F(fx, sizeof fx, "%s/fx", dbase);
        if (g == 'a' || g == 'b' || g == 'c' || g == 'e')
            F(pin, sizeof pin, "%s/.cache/unisacc/check-devsvc-core/%016llx-pin", home, hh);
        else
            F(pin, sizeof pin, "%s/pin", dbase);
        F(inst, sizeof inst, "%s/inst", dbase);
        F(lkp, sizeof lkp, "%s/.lock", dbase);
        if (ovf) return 2;
        {   char *mv[] = {"mkdir", "-p", dbase, pin, 0}; if (run(mv, 0, 0) != 0) return 2; }
        lfd = open(lkp, O_RDWR | O_CREAT, 0600);
        if (lfd < 0 || sy_flock(lfd, 2 | 4)) { printf("REFUSE\tcheck-devsvc-core\tlocked\t%s\n", lkp); return 2; }
        /* a 组与 d/f 组清空 pin 保证真冷构造; b/c/e 组复用 a 组在共享 pin 中已构造的固定版本执行体 */
        {   char c[900]; char *sv[] = {"sh", "-c", c, 0};
            if (g == 'a' || g == 'd' || g == 'f')
                F(c, sizeof c, "rm -rf %s %s %s-wt %s-c2; git -C %s worktree prune 2>/dev/null; true", pin, inst, fx, fx, fx);
            else
                F(c, sizeof c, "rm -rf %s %s-wt %s-c2; git -C %s worktree prune 2>/dev/null; true", inst, fx, fx, fx);
            if (ovf || run(sv, 0, 0) != 0) return 2; } }
    char rel_product[260], product_name[240], record[2048]; int found = 0;
    FILE *config = fopen("tools/devsvc-repo.tsv", "r");
    if (!config) return 2;
    while (fgets(record, sizeof record, config))
        if (!strncmp(record, "product\t", 8) && sscanf(record + 8, "%239[^\t\r\n]", product_name) == 1) found++;
    int bad_config = ferror(config); fclose(config);
    if (bad_config || found != 1) return 2;
    F(prod, sizeof prod, "%s/%s", root, product_name);
    F(rel_product, sizeof rel_product, "./%s", product_name);
    F(e1, sizeof e1, "DV_PIN_DIR=%s", pin); F(e2, sizeof e2, "UNISACC_DEVSVC_DIR=%s", inst);
    envv[0] = e1; envv[1] = e2; envv[2] = 0;
    if (ovf) return 2;
    /* 夹具:克隆、放入工作副本三件、提交、链接产品 */
    {   char gd[600]; F(gd, sizeof gd, "%s/.git", fx);
        if (access(gd, F_OK) != 0) { char *v[] = {"git", "clone", "-q", "--local", root, fx, 0}; if (run(v, 0, 0) != 0) { printf("FAIL\tdevsvc-core.fixture-clone\n"); return 1; } }
        /* 复用的夹具克隆每次先对齐仓根当前 HEAD:否则新增的 use 依赖(如 cxlib/trailer.cx)不在旧克隆里,整组编译失败。
           reset --hard 只许作用于夹具私有克隆:fx 必须在 ~/.cache/unisacc/check-devsvc-core/ 下、不等于仓根,
           且 git 认定的顶层恰为 fx 本身;git 命令显式带 --git-dir/--work-tree,不向上找仓 */
        {   char wt[620], gdo[620], top[600]; long n;
            F(wt, sizeof wt, "--work-tree=%s", fx); F(gdo, sizeof gdo, "--git-dir=%s", gd);
            if (ovf || !strstr(fx, "/.cache/unisacc/check-devsvc-core/") || !strcmp(fx, root)) { printf("REFUSE\tdevsvc-core.fixture-path\t%s\n", fx); return 2; }
            {   char *v[] = {"git", "rev-parse", "--show-toplevel", 0}; if (run(v, fx, 0) != 0) { printf("FAIL\tdevsvc-core.fixture-toplevel\n"); return 1; } }
            n = (long)strlen(out); while (n > 0 && (out[n - 1] == '\n' || out[n - 1] == '\r')) out[--n] = 0;
            F(top, sizeof top, "%s", out);
            if (ovf || strcmp(top, fx) != 0) { printf("REFUSE\tdevsvc-core.fixture-toplevel\tgot=%s\twant=%s\n", top, fx); return 2; }
            {   char *v[] = {"git", gdo, wt, "fetch", "-q", root, "HEAD", 0}; if (run(v, fx, 0) != 0) { printf("FAIL\tdevsvc-core.fixture-fetch\n"); return 1; } }
            {   char *v[] = {"git", gdo, wt, "reset", "-q", "--hard", "FETCH_HEAD", 0}; if (run(v, fx, 0) != 0) { printf("FAIL\tdevsvc-core.fixture-sync\n"); return 1; } } } }
    {   /* 末项可选:flowexec 引到的 flowadmit 在工作副本里有就一并放入(只把 ENOENT 当没有) */
        char dv[640]; F(dv, sizeof dv, "%s/tools/dv", fx);
        if (ovf || sy_mkdir_all(dv, 0755)) return 2;
        const char *names[10] = {"tools/devsvc.cx", "tools/devsvc-core.cx", "tools/devsvc-repo.tsv", "tools/cxlib/flowexec.cx", "tools/cxlib/flowfile.cx", "tools/dv/timing.cx", "tools/dv/nativestat.cx", "tools/dv/relmem.cx", "tools/dv/procid.cx", "tools/cxlib/flowadmit.cx"}; int i;
        for (i = 0; i < 10; i++) {
            char src[1200], dst[400]; unsigned char *b = 0; int64_t n = 0;
            F(src, sizeof src, "%s/%s", root, names[i]); F(dst, sizeof dst, "%s/%s", fx, names[i]);
            if (i == 9 && !ovf && sy_exists(src) == 0) break;
            if (ovf || sy_read_file(src, &b, &n, 1 << 22) || !b || sy_write_atomic(dst, (char *)b, (size_t)n, 0644)) { printf("FAIL\tdevsvc-core.fixture-copy\t%s\n", names[i]); if (b) free(b); return 1; }
            free(b);
            if (i == 9) { char *v[] = {"git", "add", "tools/cxlib/flowadmit.cx", 0}; if (run(v, fx, 0) != 0) { printf("FAIL\tdevsvc-core.fixture-add-admit\n"); return 1; } }
        } }
    {   char *v[] = {"git", "add", "tools/devsvc.cx", "tools/devsvc-core.cx", "tools/devsvc-repo.tsv", "tools/cxlib/flowexec.cx", "tools/cxlib/flowfile.cx", "tools/dv/timing.cx", "tools/dv/nativestat.cx", "tools/dv/relmem.cx", "tools/dv/procid.cx", 0}; if (run(v, fx, 0) != 0) { printf("FAIL\tdevsvc-core.fixture-add\n"); return 1; } }
    {   char *v[] = {"git", "-c", "user.name=dvcheck", "-c", "user.email=dvcheck@example.invalid", "commit", "-q", "--allow-empty", "-m", "fixture", 0}; if (run(v, fx, 0) != 0) { printf("FAIL\tdevsvc-core.fixture-commit\n"); return 1; } }
    {   char lk[400]; F(lk, sizeof lk, "%s/unisacc.com", fx); unlink(lk); if (ovf || symlink(prod, lk)) { printf("FAIL\tdevsvc-core.fixture-product\n"); return 1; } }
    if (g == 'a') {
    /* 先暖 fx 下启动器自身的产品 -run 编译缓存(无子命令 rc 2,不触碰 pin),避免启动器编译耗时叠入核心冷构造 55 s 窗口 */
    {   char *vw[] = {"sh", rel_product, "tools/devsvc.cx", "--", 0}; (void)run(vw, fx, envv); }
    /* (1) 冷构造 */
    t0 = sy_now_ms();
    {   char *v[] = {"sh", rel_product, "tools/devsvc.cx", "--", "x", "--par", "1", "--", "echo", "pinned-ok", 0}; rc = run(v, fx, envv); }
    ms_cold = sy_now_ms() - t0;
    ck(rc == 0 && has("pinned-ok"), "cold-build-runs");
    ck(!has("using the working copy"), "cold-build-uses-head");
    /* (2) 热调用 */
    t0 = sy_now_ms();
    {   char *v[] = {"sh", rel_product, "tools/devsvc.cx", "--", "x", "--par", "1", "--", "echo", "pinned-ok", 0}; rc = run(v, fx, envv); }
    ms_hot = sy_now_ms() - t0;
    ck(rc == 0 && has("pinned-ok") && ms_hot < 6000 && ms_hot * 2 < ms_cold + 1000, "hot-call-hits-cache");
    {   char *v[] = {"sh", prod, "tools/devsvc.cx", "--", "prebuild-self", 0};
        rc = run(v, fx, envv);
        ck(rc == 0 && has("PREPARED\tkey=") && has("\tcommit="), "prepare-pinned-receipt");
    }
    /* (2a) 命中路免 git:按 HEAD 提交号记身份备忘与产品 sha 备忘;两者在 DV_PIN_DIR/memo 下 */
    {   char mp[800]; int okm = 0, okp = 0; char *hv[] = {"git", "rev-parse", "HEAD", 0}; char *ls[] = {"ls", "-1", mp, 0};
        F(mp, sizeof mp, "%s/memo", pin);
        if (run(hv, fx, 0) == 0 && strlen(out) >= 40) { char hp[900]; out[40] = 0; F(hp, sizeof hp, "%s/head-%s", mp, out); okm = !ovf && sy_exists(hp) == 1; }
        if (run(ls, 0, 0) == 0) okp = strstr(out, "prod-") != 0;
        ck(okm, "memo-written-for-head-commit");
        ck(okp, "product-sha-memo-written"); }
    /* (2b0) 格式坏的身份备忘不被采信:写入垃圾后调用仍成功,备忘按 git 重算并重写为合法格式 */
    {   char hp[900]; char *hv[] = {"git", "rev-parse", "HEAD", 0}; unsigned char *b = 0; int64_t n = 0; int okw = 0;
        if (run(hv, fx, 0) == 0 && strlen(out) >= 40) { out[40] = 0; F(hp, sizeof hp, "%s/memo/head-%s", pin, out); okw = !ovf && !sy_write_atomic(hp, "garbage\n", 8, 0600); }
        {   char *v[] = {"sh", rel_product, "tools/devsvc.cx", "--", "x", "--par", "1", "--", "echo", "memo-bad-ok", 0}; rc = run(v, fx, envv); }
        ck(okw && rc == 0 && has("memo-bad-ok") && !has("using the working copy"), "bad-memo-ignored");
        ck(okw && !sy_read_file(hp, &b, &n, 1 << 20) && b && n > 8 && !memcmp(b, "dvmemo1\t", 8), "bad-memo-rewritten");
        if (b) free(b); }
    /* (2b) 客户端被 INT:1 s 后杀客户端,2 s 内节点进程组清空,事件含 x.cancelled */
    {   const char *sc = "sh ./unisacc.com tools/devsvc.cx -- start >/dev/null 2>&1; sh ./unisacc.com tools/devsvc.cx -- x --par 1 -- sleep 47 2>cancel.err & C=$!; i=0; K=; S=;"
            " while [ $i -lt 50 ] && [ -z \"$S\" ]; do sleep 0.1; i=$((i+1)); K=$(pgrep -P $C | head -1); [ -n \"$K\" ] && S=$(pgrep -P $K -x sleep | head -1); done;"
            " sleep 1; kill -INT $K; sleep 2; if [ -n \"$S\" ] && ! pgrep -g $S >/dev/null; then echo GROUP_GONE; else echo GROUP_LEFT $S; [ -n \"$S\" ] && kill -9 -$S; fi; wait $C; echo CLIENT_RC=$?; cat cancel.err";
        char *v[] = {"sh", "-c", (char *)sc, 0}; rc = run(v, fx, envv);
        ck(rc == 0 && has("GROUP_GONE") && has("CLIENT_RC=130") && has("CANCELLED"), "client-int-kills-node-group");
        {   char *ev[] = {"sh", rel_product, "tools/devsvc.cx", "--", "events", 0}; rc = run(ev, fx, envv); }
        ck(has("x.cancelled"), "cancel-event-recorded"); }
    /* (2c) 后台作业:x --bg 立即返回;wait 短超时 rc 124 且作业仍在;jobs 列出;wait 得 rc 0;events --wait job.done 收到;--bg 作业的锁结束后释放 */
    {   const char *sc = "D='sh ./unisacc.com tools/devsvc.cx --'; $D start >/dev/null 2>&1; t0=$(date +%s%N); J=$($D x --par 1 --bg -- sleep 3); echo \"BGMS=$((($(date +%s%N)-t0)/1000000))\"; I=$(echo \"$J\" | cut -f2);"
            " echo \"$J\" | grep -q '^JOB\t' && echo JOBLINE; $D wait $I --timeout-ms 500; echo SHORT_RC=$?; $D jobs | grep -q \"^JOB\t$I\trunning\" && echo LISTED_RUNNING;"
            " $D wait $I >/dev/null; echo WAIT_RC=$?; $D events --wait job.done --since 0 --timeout-ms 5000 | grep -q \"id=$I\" && echo EVENT_GOT;"
            " K=$(printf 'n1\\texec\\t-\\tlock=bgtest;a0=sleep;a1=2\\n' | $D flow - --par 1 --bg | cut -f2); sleep 1; $D lock list | grep -q bgtest && echo LOCK_HELD; $D wait $K >/dev/null; echo FLOW_RC=$?; $D lock list | grep -q bgtest || echo LOCK_FREED";
        char *v[] = {"sh", "-c", (char *)sc, 0}; char *q; rc = run(v, fx, envv);
        q = strstr(out, "BGMS="); ck(rc == 0 && has("JOBLINE") && q && atol(q + 5) < 2500, "bg-returns-immediately");
        ck(has("SHORT_RC=124") && has("LISTED_RUNNING"), "wait-timeout-124-job-alive");
        ck(has("WAIT_RC=0"), "wait-gets-rc");
        ck(has("EVENT_GOT"), "events-wait-job-done");
        ck(has("LOCK_HELD") && has("FLOW_RC=0") && has("LOCK_FREED"), "bg-lock-released"); }
    }
    if (g == 'e') {
    /* (2d) <bin>.stat O(1) 缓存与篡改失败/重编负控(racy-2s 封存、坏 .stat 回退重写、修改二进制强制失效重建) */
    {   char sc[1600]; int ok1;
        F(sc, sizeof sc,
          "D='sh ./unisacc.com tools/devsvc.cx'; "
          "$D -- x --par 1 -- echo stat-warm; "
          "B=$(ls %s/*/devsvc 2>/dev/null | head -1); "
          "[ -n \"$B\" ] && [ -f \"$B.stat\" ] || { sleep 2; $D -- x --par 1 -- echo stat-seal; }; "
          "grep -q '^dvbin1\t[0-9]' \"$B.stat\" && echo STAT_SEALED; "
          "printf 'dvbin1\\tbad\\n' > \"$B.stat\"; "
          "$D -- x --par 1 -- echo stat-bad-ok; "
          "grep -q '^dvbin1\t[0-9]' \"$B.stat\" && echo STAT_REWRITTEN", pin);
        { char *v[] = {"sh", "-c", sc, 0}; rc = run(v, fx, envv); }
        ok1 = !ovf && rc == 0 && has("STAT_SEALED") && has("STAT_REWRITTEN");
        F(sc, sizeof sc,
          "D='sh ./unisacc.com tools/devsvc.cx'; "
          "B=$(ls %s/*/devsvc 2>/dev/null | head -1); "
          "cp \"$B\" \"$B.tamper\" && chmod u+w \"$B.tamper\" && printf X >> \"$B.tamper\" && mv -f \"$B.tamper\" \"$B\"; "
          "$D -- x --par 1 -- echo bin-tamper-rebuilt 2>&1; $D -- stop >/dev/null 2>&1 || true", pin);
        { char *v[] = {"sh", "-c", sc, 0}; rc = run(v, fx, envv); }
        ck(ok1 && !ovf && rc == 0 && has("does not match its sha, rebuilding") && has("bin-tamper-rebuilt"), "stat-cache-hit-and-tamper-rebuilds"); }
    }
    if (g == 'b') {
    /* (5) 工作区配置表加未知行与坏行(删掉必需键):普通调用用 HEAD 版表不受影响,--dev 才读到并拒绝 */
    {   char p[400]; const char *bad = "# broken by check\nzzz-unknown\tfoo\tbar\nlib\tonly-one\n"; unsigned char *b = 0; int64_t n = 0;
        F(p, sizeof p, "%s/tools/devsvc-repo.tsv", fx);
        if (ovf || sy_read_file(p, &b, &n, 1 << 20) || !b) { printf("FAIL\tdevsvc-core.fixture-read-table\n"); return 1; }
        if (sy_write_atomic(p, bad, strlen(bad), 0644)) { printf("FAIL\tdevsvc-core.fixture-break-table\n"); free(b); return 1; }
        {   char *v[] = {"sh", rel_product, "tools/devsvc.cx", "--", "x", "--par", "1", "--", "echo", "table-ok", 0}; rc = run(v, fx, envv); }
        ck(rc == 0 && has("table-ok"), "broken-working-table-does-not-block");
        {   char *v[] = {"sh", rel_product, "tools/devsvc.cx", "--", "--dev", "x", "--par", "1", "--", "echo", "table-dev", 0}; rc = run(v, fx, envv); }
        ck(rc != 0 && !has("table-dev") && has("repo table"), "dev-flag-reads-working-table");
        if (sy_write_atomic(p, (char *)b, (size_t)n, 0644)) { printf("FAIL\tdevsvc-core.fixture-restore-table\n"); free(b); return 1; }
        free(b); }
