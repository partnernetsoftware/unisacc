            char *v[] = {"sh", rel_product, "tools/devsvc.cx", "--", "x", "--par", "1", "--", "echo", "c2-warm", 0}; char *ls[] = {"ls", "-1", pin, 0}; int n0 = -1, n1 = -1; char *q;
            if (run(ls, 0, 0) == 0) for (n0 = 0, q = out; *q; q++) n0 += *q == '\n';
