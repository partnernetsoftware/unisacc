int main(int argc, char **argv) {
    const char *sel = "abcdef"; const char *p; int rc = 0;
    {   /* 剥掉调用方环境里的 DEVSVC_*(如 flow 或 shell 里的 DEVSVC_OWNER 与服务句柄),夹具子进程不继承 */
        extern char **environ; char **e; char nm[80]; int i;
        for (e = environ; e && *e; ) {
            if (strncmp(*e, "DEVSVC_", 7) == 0) {
                for (i = 0; (*e)[i] && (*e)[i] != '=' && i < 78; i++) nm[i] = (*e)[i];
                nm[i] = 0; unsetenv(nm); e = environ;
            } else e++;
        } }
    if (argc >= 3 && !strcmp(argv[1], "--cases")) {
        if (!strcmp(argv[2], "d1")) sel = "d";
        else if (!strcmp(argv[2], "d2")) sel = "f";
        else sel = argv[2];
    }
    else if (argc > 1) { fprintf(stderr, "usage: check-devsvc-core.cx [--cases a|b|c|d|d1|d2|e|f]\n"); return 2; }
    for (p = sel; *p; p++) {
        if (*p != 'a' && *p != 'b' && *p != 'c' && *p != 'd' && *p != 'e' && *p != 'f') { fprintf(stderr, "usage: check-devsvc-core.cx [--cases a|b|c|d|d1|d2|e|f]\n"); return 2; }
        { int r = group(*p); if (r > rc) rc = r; }
    }
    printf("CHECK_DEVSVC_CORE\tok=%d\tfailed=%d\n", nok, nfail);
    return nfail ? 1 : rc;
}
