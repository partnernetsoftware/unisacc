/* tools/check-devsvc-core.cx -- 检查 tools/devsvc.cx 的固定版本启动器(按 git HEAD 构造执行体,不受工作副本影响)。批次 devsvc-core。
 *
 *   sh ./unisacc.com tools/check-devsvc-core.cx        (在仓根跑)
 *
 * 夹具:`git clone --local` 本仓到 /tmp/dvcore-<pid>,把工作副本的 devsvc.cx、devsvc-core.cx、devsvc-repo.tsv 提交进夹具的 HEAD,
 *   产品用符号链接指向本检出的产品;固定版本缓存目录与实例目录都在 /tmp/dvcore-<pid>-* 下,不碰真实缓存与实例。
 * 断言:(1)首次调用(冷构造)成功且 stderr 没有"using the working copy";(2)第二次调用命中缓存(远快于冷构造);
 *   (3)把夹具工作副本的核心改成语法错后,普通调用仍成功(用的是 HEAD 版本);(4)--dev 走工作副本,在语法错下失败。
 * 输出 PASS/FAIL 行,末行 CHECK_DEVSVC_CORE<TAB>ok=N<TAB>failed=N;有 FAIL 则 rc 1。 */
#pragma unisa use sys.time
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sysx.process
#pragma unisa use mem.bytes
#pragma unisa use mem.heap

static int nok, nfail, ovf;
#define F(dst, cap, ...) do { int f_ = snprintf(dst, cap, __VA_ARGS__); if (f_ < 0 || f_ >= (int)(cap)) ovf++; } while (0)
static char root[1024], dbase[500], fx[540], pin[540], inst[540], prod[1300], out[1 << 15];
static void ck(int c, const char *name) {
    printf("%s\tdevsvc-core.%s\n", c ? "PASS" : "FAIL", name);
    if (!c) printf("NOTE\tlast-output\t%.600s\n", out);
    if (c) nok++; else nfail++;
}
/* 有界跑一条命令(55 秒上限):stdout 后接 stderr 收进 out,返回退出码;起不来或装不下返回 -1 */
static int run(char **v, const char *cwd, char *const *env) {
    np_result r; char why[200]; int rc; long a, b;
    memset(out, 0, sizeof out);
    if (np_run(v, cwd, env, 55, &r, why, sizeof why)) return -1;
    a = (long)r.outn; b = (long)r.errn; rc = r.rc;
    if (a + b > (long)sizeof out - 1 || (a > 0 && mm_copy(out, sizeof out, r.out, a)) || (b > 0 && mm_copy(out + a, sizeof out - a, r.err, b))) rc = -1;
    np_free(&r);
    return rc;
}
static int has(const char *s) { return strstr(out, s) != 0; }

int main(void) {
    char *envv[4]; char e1[220], e2[220]; long t0, ms_cold, ms_hot; int rc;
    if (sy_cwd(root, sizeof root) < 0) return 2;
    {   /* 固定私有副本 ~/.cache/unisacc/check-devsvc-core/<仓根 FNV-1a 64>/:跨次复用夹具与产品 -run 编译缓存;flock 防并跑 */
        const char *home = sy_env("HOME"); unsigned long long hh = 1469598103934665603ULL; long q; char lkp[400]; int lfd;
        if (!home) return 2;
        for (q = 0; root[q]; q++) { hh ^= (unsigned char)root[q]; hh *= 1099511628211ULL; }
        F(dbase, sizeof dbase, "%s/.cache/unisacc/check-devsvc-core/%016llx", home, hh);
        F(fx, sizeof fx, "%s/fx", dbase); F(pin, sizeof pin, "%s/pin", dbase); F(inst, sizeof inst, "%s/inst", dbase);
        F(lkp, sizeof lkp, "%s/.lock", dbase);
        if (ovf) return 2;
        {   char *mv[] = {"mkdir", "-p", dbase, 0}; if (run(mv, 0, 0) != 0) return 2; }
        lfd = open(lkp, O_RDWR | O_CREAT, 0600);
        if (lfd < 0 || sy_flock(lfd, 2 | 4)) { printf("REFUSE\tcheck-devsvc-core\tlocked\t%s\n", lkp); return 2; }
        /* 每次清空独立 pin 与实例目录,保证真冷构造 */
        {   char c[900]; char *sv[] = {"sh", "-c", c, 0}; F(c, sizeof c, "rm -rf %s %s %s-wt %s-c2; git -C %s worktree prune 2>/dev/null; true", pin, inst, fx, fx, fx);
            if (ovf || run(sv, 0, 0) != 0) return 2; } }
    F(prod, sizeof prod, "%s/unisacc.com", root);
    F(e1, sizeof e1, "DV_PIN_DIR=%s", pin); F(e2, sizeof e2, "UNISACC_DEVSVC_DIR=%s", inst);
    envv[0] = e1; envv[1] = e2; envv[2] = 0;
    if (ovf) return 2;
    /* 夹具:克隆、放入工作副本三件、提交、链接产品 */
    {   char gd[600]; F(gd, sizeof gd, "%s/.git", fx);
        if (access(gd, F_OK) != 0) { char *v[] = {"git", "clone", "-q", "--local", root, fx, 0}; if (run(v, 0, 0) != 0) { printf("FAIL\tdevsvc-core.fixture-clone\n"); return 1; } } }
    {   const char *names[5] = {"tools/devsvc.cx", "tools/devsvc-core.cx", "tools/devsvc-repo.tsv", "tools/cxlib/flowexec.cx", "tools/cxlib/flowfile.cx"}; int i;
        for (i = 0; i < 5; i++) {
            char src[1200], dst[400]; unsigned char *b = 0; int64_t n = 0;
            F(src, sizeof src, "%s/%s", root, names[i]); F(dst, sizeof dst, "%s/%s", fx, names[i]);
            if (ovf || sy_read_file(src, &b, &n, 1 << 22) || !b || sy_write_atomic(dst, (char *)b, (size_t)n, 0644)) { printf("FAIL\tdevsvc-core.fixture-copy\t%s\n", names[i]); if (b) free(b); return 1; }
            free(b);
        } }
    {   char *v[] = {"git", "add", "tools/devsvc.cx", "tools/devsvc-core.cx", "tools/devsvc-repo.tsv", "tools/cxlib/flowexec.cx", "tools/cxlib/flowfile.cx", 0}; if (run(v, fx, 0) != 0) { printf("FAIL\tdevsvc-core.fixture-add\n"); return 1; } }
    {   char *v[] = {"git", "-c", "user.name=dvcheck", "-c", "user.email=dvcheck@example.invalid", "commit", "-q", "--allow-empty", "-m", "fixture", 0}; if (run(v, fx, 0) != 0) { printf("FAIL\tdevsvc-core.fixture-commit\n"); return 1; } }
    {   char lk[400]; F(lk, sizeof lk, "%s/unisacc.com", fx); unlink(lk); if (ovf || symlink(prod, lk)) { printf("FAIL\tdevsvc-core.fixture-product\n"); return 1; } }
    /* (1) 冷构造 */
    t0 = sy_now_ms();
    {   char *v[] = {"sh", "./unisacc.com", "tools/devsvc.cx", "--", "x", "--par", "1", "--", "echo", "pinned-ok", 0}; rc = run(v, fx, envv); }
    ms_cold = sy_now_ms() - t0;
    ck(rc == 0 && has("pinned-ok"), "cold-build-runs");
    ck(!has("using the working copy"), "cold-build-uses-head");
    /* (2) 热调用 */
    t0 = sy_now_ms();
    {   char *v[] = {"sh", "./unisacc.com", "tools/devsvc.cx", "--", "x", "--par", "1", "--", "echo", "pinned-ok", 0}; rc = run(v, fx, envv); }
    ms_hot = sy_now_ms() - t0;
    ck(rc == 0 && has("pinned-ok") && ms_hot < 6000 && ms_hot * 2 < ms_cold + 1000, "hot-call-hits-cache");
    /* (2b) 客户端被 INT:1 s 后杀客户端,2 s 内节点进程组清空,事件含 x.cancelled */
    {   const char *sc = "sh ./unisacc.com tools/devsvc.cx -- start >/dev/null 2>&1; sh ./unisacc.com tools/devsvc.cx -- x --par 1 -- sleep 47 2>cancel.err & C=$!; i=0; K=; S=;"
            " while [ $i -lt 50 ] && [ -z \"$S\" ]; do sleep 0.1; i=$((i+1)); K=$(pgrep -P $C | head -1); [ -n \"$K\" ] && S=$(pgrep -P $K -x sleep | head -1); done;"
            " sleep 1; kill -INT $K; sleep 2; if [ -n \"$S\" ] && ! pgrep -g $S >/dev/null; then echo GROUP_GONE; else echo GROUP_LEFT $S; [ -n \"$S\" ] && kill -9 -$S; fi; wait $C; echo CLIENT_RC=$?; cat cancel.err";
        char *v[] = {"sh", "-c", (char *)sc, 0}; rc = run(v, fx, envv);
        ck(rc == 0 && has("GROUP_GONE") && has("CLIENT_RC=130") && has("CANCELLED"), "client-int-kills-node-group");
        {   char *ev[] = {"sh", "./unisacc.com", "tools/devsvc.cx", "--", "events", 0}; rc = run(ev, fx, envv); }
        ck(has("x.cancelled"), "cancel-event-recorded"); }
    /* (2c) 后台作业:x --bg 立即返回;wait 短超时 rc 124 且作业仍在;jobs 列出;wait 得 rc 0;events --wait job.done 收到;--bg 作业的锁结束后释放 */
    {   const char *sc = "D='sh ./unisacc.com tools/devsvc.cx --'; $D start >/dev/null 2>&1; t0=$(date +%s%N); J=$($D x --par 1 --bg -- sleep 3); echo \"BGMS=$((($(date +%s%N)-t0)/1000000))\"; I=$(echo \"$J\" | cut -f2);"
            " echo \"$J\" | grep -q '^JOB\t' && echo JOBLINE; $D wait $I --timeout-ms 500; echo SHORT_RC=$?; $D jobs | grep -q \"^JOB\t$I\trunning\" && echo LISTED_RUNNING;"
            " $D wait $I >/dev/null; echo WAIT_RC=$?; $D events --wait job.done --since 0 --timeout-ms 5000 | grep -q \"id=$I\" && echo EVENT_GOT;"
            " K=$(printf 'n1\\texec\\t-\\tlock=bgtest;a0=sleep;a1=2\\n' | $D flow - --par 1 --bg | cut -f2); sleep 1; $D lock list | grep -q bgtest && echo LOCK_HELD; $D wait $K >/dev/null; echo FLOW_RC=$?; $D lock list | grep -q bgtest || echo LOCK_FREED";
        char *v[] = {"sh", "-c", (char *)sc, 0}; char *q; rc = run(v, fx, envv);
        q = strstr(out, "BGMS="); ck(rc == 0 && has("JOBLINE") && q && atol(q + 5) < 2500, "bg-returns-immediately");
        ck(has("SHORT_RC=124") && has("LISTED_RUNNING"), "wait-timeout-124-job-alive");
        ck(has("WAIT_RC=0"), "wait-gets-rc");
        ck(has("EVENT_GOT"), "events-wait-job-done");
        ck(has("LOCK_HELD") && has("FLOW_RC=0") && has("LOCK_FREED"), "bg-lock-released"); }
    /* (5) 工作区配置表加未知行与坏行(删掉必需键):普通调用用 HEAD 版表不受影响,--dev 才读到并拒绝 */
    {   char p[400]; const char *bad = "# broken by check\nzzz-unknown\tfoo\tbar\nlib\tonly-one\n"; unsigned char *b = 0; int64_t n = 0;
        F(p, sizeof p, "%s/tools/devsvc-repo.tsv", fx);
        if (ovf || sy_read_file(p, &b, &n, 1 << 20) || !b) { printf("FAIL\tdevsvc-core.fixture-read-table\n"); return 1; }
        if (sy_write_atomic(p, bad, strlen(bad), 0644)) { printf("FAIL\tdevsvc-core.fixture-break-table\n"); free(b); return 1; }
        {   char *v[] = {"sh", "./unisacc.com", "tools/devsvc.cx", "--", "x", "--par", "1", "--", "echo", "table-ok", 0}; rc = run(v, fx, envv); }
        ck(rc == 0 && has("table-ok"), "broken-working-table-does-not-block");
        {   char *v[] = {"sh", "./unisacc.com", "tools/devsvc.cx", "--", "--dev", "x", "--par", "1", "--", "echo", "table-dev", 0}; rc = run(v, fx, envv); }
        ck(rc != 0 && !has("table-dev") && has("repo table"), "dev-flag-reads-working-table");
        if (sy_write_atomic(p, (char *)b, (size_t)n, 0644)) { printf("FAIL\tdevsvc-core.fixture-restore-table\n"); free(b); return 1; }
        free(b); }
    /* (6) 锁租约:租约内 release 必 OK;过期后 release 报 expired 而非 not-held;短 ttl 续期不截短长租约 */
    {   char *a1[] = {"sh", "./unisacc.com", "tools/devsvc.cx", "--", "lock", "acquire", "ck-a", "--owner", "ck", "--ttl", "30", 0};
        char *r1[] = {"sh", "./unisacc.com", "tools/devsvc.cx", "--", "lock", "release", "ck-a", "--owner", "ck", 0};
        char *a2[] = {"sh", "./unisacc.com", "tools/devsvc.cx", "--", "lock", "acquire", "ck-b", "--owner", "ck", "--ttl", "1", 0};
        char *r2[] = {"sh", "./unisacc.com", "tools/devsvc.cx", "--", "lock", "release", "ck-b", "--owner", "ck", 0};
        char *a3[] = {"sh", "./unisacc.com", "tools/devsvc.cx", "--", "lock", "acquire", "ck-c", "--owner", "ck", "--ttl", "600", 0};
        char *a4[] = {"sh", "./unisacc.com", "tools/devsvc.cx", "--", "lock", "acquire", "ck-c", "--owner", "ck", "--ttl", "5", 0};
        char *r3[] = {"sh", "./unisacc.com", "tools/devsvc.cx", "--", "lock", "release", "ck-c", "--owner", "ck", 0};
        char *st[] = {"sh", "./unisacc.com", "tools/devsvc.cx", "--", "stop", 0};
        rc = run(a1, fx, envv); ck(rc == 0 && has("acquired"), "lock-acquire");
        rc = run(r1, fx, envv); ck(rc == 0 && has("OK\treleased\tck-a"), "lock-release-within-lease-ok");
        rc = run(a2, fx, envv); ck(rc == 0 && has("acquired"), "lock-acquire-short");
        sy_sleep_ms(2300);
        rc = run(r2, fx, envv); ck(rc != 0 && has("ERR\texpired\tck-b") && !has("not-held"), "lock-release-after-expiry-says-expired");
        (void)run(a3, fx, envv);
        rc = run(a4, fx, envv); ck(rc == 0 && has("renewed") && !has("expires_in_s=5\n"), "lock-renew-does-not-shorten");
        rc = run(r3, fx, envv); ck(rc == 0 && has("released"), "lock-release-after-renew-ok");
        (void)run(st, fx, envv); }
    /* (7) 版本工作树:git worktree 内只有指向产品的符号链接,普通调用可用(按工作树顶层取 HEAD 配置表) */
    {   char wt[200], lk[300]; F(wt, sizeof wt, "%s-wt", fx); F(lk, sizeof lk, "%s/unisacc.com", wt);
        {   char *v[] = {"git", "worktree", "add", "-q", "--detach", wt, 0}; rc = run(v, fx, 0); }
        if (rc != 0 || ovf || symlink(prod, lk)) { printf("FAIL\tdevsvc-core.fixture-worktree\n"); return 1; }
        {   char *v[] = {"sh", "./unisacc.com", "tools/devsvc.cx", "--", "x", "--par", "1", "--", "echo", "wt-ok", 0}; rc = run(v, wt, envv); }
        ck(rc == 0 && has("wt-ok") && !has("repo table") && !has("using the working copy"), "worktree-call-works");
        {   char *v[] = {"rm", "-rf", wt, 0}; (void)run(v, 0, 0); } }
    /* (8) 内容相同的第二个克隆共享固定版本缓存:首次调用即命中(小于 3 s) */
    {   char fx2[200], lk[300]; long t1, ms2; F(fx2, sizeof fx2, "%s-c2", fx); F(lk, sizeof lk, "%s/unisacc.com", fx2);
        {   char *v[] = {"git", "clone", "-q", "--local", fx, fx2, 0}; rc = run(v, 0, 0); }
        if (rc != 0 || ovf || symlink(prod, lk)) { printf("FAIL\tdevsvc-core.fixture-clone2\n"); return 1; }
        {   /* 先在 fx2 暖启动器自身的 -run 编译缓存(按路径,属产品侧),再计时;另断言固定版本缓存目录没有新增键 */
            char *v[] = {"sh", "./unisacc.com", "tools/devsvc.cx", "--", "x", "--par", "1", "--", "echo", "c2-warm", 0}; char *ls[] = {"ls", "-1", pin, 0}; int n0 = -1, n1 = -1; char *q;
            if (run(ls, 0, 0) == 0) for (n0 = 0, q = out; *q; q++) n0 += *q == '\n';
            t1 = sy_now_ms(); rc = run(v, fx2, envv); ms2 = sy_now_ms() - t1;
            ck(rc == 0 && has("c2-warm") && !has("using the working copy"), "second-clone-first-call-runs");
            if (run(ls, 0, 0) == 0) for (n1 = 0, q = out; *q; q++) n1 += *q == '\n';
            ck(n0 > 0 && n0 == n1, "second-clone-reuses-pinned-key");
            printf("NOTE\tsecond-clone-first-call-ms\t%ld\n", ms2); }
        t1 = sy_now_ms();
        {   char *v[] = {"sh", "./unisacc.com", "tools/devsvc.cx", "--", "x", "--par", "1", "--", "echo", "c2-ok", 0}; rc = run(v, fx2, envv); }
        ms2 = sy_now_ms() - t1;
        ck(rc == 0 && has("c2-ok") && ms2 < 3000, "second-clone-hits-cache");
        if (ms2 >= 3000) printf("NOTE\tsecond-clone-ms\t%ld\n", ms2);
        {   char *v[] = {"rm", "-rf", fx2, 0}; (void)run(v, 0, 0); } }
    /* (3) 夹具工作副本的核心改成语法错,普通调用仍成功 */
    {   char p[400]; const char *junk = "\n@@ this is not valid cx @@\n"; unsigned char *b = 0; int64_t n = 0; unsigned char *nb;
        F(p, sizeof p, "%s/tools/devsvc-core.cx", fx);
        if (ovf || sy_read_file(p, &b, &n, 1 << 22) || !b) { printf("FAIL\tdevsvc-core.fixture-read-core\n"); return 1; }
        nb = (unsigned char *)malloc((size_t)n + strlen(junk) + 1);
        if (!nb || mm_copy(nb, (size_t)n + strlen(junk) + 1, b, n) || mm_copy(nb + n, strlen(junk) + 1, junk, strlen(junk))) { printf("FAIL\tdevsvc-core.fixture-break-core\n"); return 1; }
        if (sy_write_atomic(p, (char *)nb, (size_t)n + strlen(junk), 0644)) { printf("FAIL\tdevsvc-core.fixture-write-core\n"); return 1; }
        free(b); free(nb); }
    {   char *v[] = {"sh", "./unisacc.com", "tools/devsvc.cx", "--", "x", "--par", "1", "--", "echo", "still-ok", 0}; rc = run(v, fx, envv); }
    ck(rc == 0 && has("still-ok"), "broken-working-copy-does-not-block");
    /* (4) --dev 走工作副本,语法错下失败 */
    {   char *v[] = {"sh", "./unisacc.com", "tools/devsvc.cx", "--", "--dev", "x", "--par", "1", "--", "echo", "dev-ok", 0}; rc = run(v, fx, envv); }
    ck(rc != 0 && !has("dev-ok"), "dev-flag-uses-working-copy");
    /* 清理 */
    {   char *v2[] = {"rm", "-rf", pin, 0}; char *v3[] = {"rm", "-rf", inst, 0};   /* 夹具 fx 保留供下次复用 */
        (void)run(v2, 0, 0); (void)run(v3, 0, 0); }
    printf("CHECK_DEVSVC_CORE\tok=%d\tfailed=%d\n", nok, nfail);
    return nfail ? 1 : 0;
}
