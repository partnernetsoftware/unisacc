/* tools/check-chain-preflight.cx -- verify tools/flows/chain-preflight.tsv schema (structure only on live table:
 * columns, unique node names, timeout_s<=55, valid patterns, M2/M3/M4 node presence; never executes live heavy nodes)
 * and tools/chain-preflight.cx root-types, snap-cache-types (M2) and parse2-bind (M3) checks on fixture tables.
 * Marker: CHECK_CHAIN_PREFLIGHT<TAB>failed=N
 *
 * Also verifies default strict (mandatory) mode, --shadow mode, and all 7 failure shape fixtures from 0.0.86 chains 1..7. */
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use mem.bytes
#pragma unisa use text.text
#pragma unisa use cxlib.ckrun

static int failed = 0, assertions = 0;
static char fx[1024], pf_bin[1200];

static void pf_ck(int ok, const char *name, const char *detail) {
    assertions++;
    if (!ok) {
        failed++;
        printf("FAIL\t%s\t%s\n", name, detail ? detail : "none");
    } else {
        printf("PASS\t%s\n", name);
    }
}

#define ck pf_ck
#define has(o, s) ckk_has((o), 4096, (s))

static void pf_mkdir(const char *p) {
    char tmp[1024];
    size_t n = strlen(p);
    if (n >= sizeof tmp || mm_copy(tmp, sizeof tmp, p, n + 1)) return;
    for (size_t i = 1; i < n; i++) {
        if (tmp[i] == '/') {
            tmp[i] = 0;
            sy_mkdir(tmp, 0700);
            tmp[i] = '/';
        }
    }
    sy_mkdir(tmp, 0700);
}

#define mk_dir pf_mkdir

static void pf_write(const char *dir, const char *rel, const char *content) {
    char p[1200];
    if (cx_fmt(p, sizeof p, "%s/%s", dir, rel)) return;
    sy_write_file(p, content, (int64_t)strlen(content), 0600);
}

#define wr_file pf_write

static int run_pf(const char *args, char *out, int cap) {
    char cmd[2048];
    if (cx_fmt(cmd, sizeof cmd, "'%s' -- %s", pf_bin, args)) return -1;
    return ckk_sh("CHECK_CHAIN_PREFLIGHT", cmd, out, cap);
}

int main(void) {
    char out[4096], arg[1800], root_ok[1200], root_dir[1200], root_dangling[1200], root_sym[1200], root_nojson[1200];
    char snap_base[1200], snap_entry[1200], p2repo[1200], t_fx[1200], t_ext[1200], t_bad1[1200], t_bad2[1200], t_bad3[1200];
    char evf[1200], rmcmd[1400], bcmd[1600];
    char bad_sha[64] = {0}, ok_sha[64] = {0};
    const char *rev = "3224e3518ed8f49b362b784972525d303d2073c2";
    long t0 = sy_now_ms();

    cx_fmt(fx, sizeof fx, "%s/check-chain-preflight-%d", sy_tmpdir(), (int)sy_pid());
    mk_dir(fx);
    cx_fmt(pf_bin, sizeof pf_bin, "%s/chain-preflight-bin", fx);
    cx_fmt(bcmd, sizeof bcmd, "sh ./unisacc.com tools/chain-preflight.cx -o '%s'", pf_bin);
    if (ckk_sh("CHECK_CHAIN_PREFLIGHT", bcmd, out, sizeof out) != 0) {
        printf("FAIL\tcompile-chain-preflight\t%s\n", out);
        return 1;
    }

    /* Fixture table for M2/M3 node execution tests (never executes heavy M4 commands from live table) */
    cx_fmt(t_fx, sizeof t_fx, "%s/chain-preflight-fx.tsv", fx);
    wr_file(fx, "chain-preflight-fx.tsv",
        "# fixture table for M2 and M3 node behavior tests\n"
        "name\tpatterns\tcmd\ttimeout_s\n"
        "root-types\t*,unisacc.com,unisacc.com.build.json\tsh ./unisacc.com tools/chain-preflight.cx -- --item root-types\t10\n"
        "snap-cache-types\t*,unisacc.com,unisacc.com.build.json\tsh ./unisacc.com tools/chain-preflight.cx -- --item snap-cache-types\t10\n"
        "parse2-bind\texec/parse2/*,exec/facts/*,seed/gen.c\tsh ./unisacc.com tools/chain-preflight.cx -- --item parse2-bind\t30\n");

    /* Build self-contained git fixture repo for parse2-bind (independent of release history for cold shard layout) */
    cx_fmt(p2repo, sizeof p2repo, "%s/p2repo", fx);
    mk_dir(p2repo);
    {
        char sub[1300], gcmd[2400];
        cx_fmt(sub, sizeof sub, "%s/build", p2repo); mk_dir(sub);
        cx_fmt(sub, sizeof sub, "%s/seed", p2repo); mk_dir(sub);
        cx_fmt(sub, sizeof sub, "%s/exec/parse2", p2repo); mk_dir(sub);
        cx_fmt(sub, sizeof sub, "%s/exec/facts", p2repo); mk_dir(sub);
        wr_file(p2repo, "build/version-seq.tsv", "slot\tversion\tclass\tstate\tnote\n1\t0.0.1\ttest\t已公开\tfixture\n");
        wr_file(p2repo, "seed/gen.c",
            "#include <stdio.h>\n#include <string.h>\n"
            "int main(int n,char **a){"
            "if(n!=4||strcmp(a[1],\"parse2\")||strcmp(a[3],\"--locations\"))return 2;"
            "FILE *f=fopen(\"exec/parse2/parenfold-template.tsv\",\"r\");if(!f)return 3;"
            "int bad=fgetc(f)=='B';fclose(f);"
            "f=fopen(a[2],\"w\");if(!f)return 4;fputs(\"{}\\n\",f);fclose(f);"
            "if(bad)fputs(\"seed-gen: exec/parse2/parenfold-template.tsv:3: clone-push target mismatch\\n\",stderr);"
            "return bad;}\n");
        wr_file(p2repo, "exec/parse2/parenfold-template.tsv", "GOOD_BINDING\n");
        cx_fmt(gcmd, sizeof gcmd,
            "cd '%s' && git init -q && git add --all && "
            "git -c user.name=fx -c user.email=fx@local -c core.hooksPath=/dev/null -c commit.gpgsign=false commit -qm base && "
            "git tag v0.0.1", p2repo);
        ckk_sh("CHECK_CHAIN_PREFLIGHT", gcmd, out, sizeof out);

        wr_file(p2repo, "exec/parse2/parenfold-template.tsv", "BAD_CLONE_PUSH\n");
        cx_fmt(gcmd, sizeof gcmd,
            "cd '%s' && git add --all && "
            "git -c user.name=fx -c user.email=fx@local -c core.hooksPath=/dev/null -c commit.gpgsign=false commit -qm bad && "
            "git rev-parse HEAD", p2repo);
        ckk_sh("CHECK_CHAIN_PREFLIGHT", gcmd, out, sizeof out);
        if (strlen(out) >= 40) { mm_copy(bad_sha, sizeof bad_sha, out, 40); bad_sha[40] = 0; }

        wr_file(p2repo, "exec/parse2/parenfold-template.tsv", "GOOD_BINDING\n");
        cx_fmt(gcmd, sizeof gcmd,
            "cd '%s' && git add --all && "
            "git -c user.name=fx -c user.email=fx@local -c core.hooksPath=/dev/null -c commit.gpgsign=false commit -qm good && "
            "git rev-parse HEAD", p2repo);
        ckk_sh("CHECK_CHAIN_PREFLIGHT", gcmd, out, sizeof out);
        if (strlen(out) >= 40) { mm_copy(ok_sha, sizeof ok_sha, out, 40); ok_sha[40] = 0; }
    }

    /* 1. Live tools/flows/chain-preflight.tsv structure check only (columns, unique names, timeout<=55, valid patterns, M2/M3/M4 node presence) */
    ck(run_pf("--check-table --table tools/flows/chain-preflight.tsv", out, sizeof out) == 0 &&
       has(out, "PREFLIGHT_NODE\tname=root-types\t") &&
       has(out, "PREFLIGHT_NODE\tname=snap-cache-types\t") &&
       has(out, "PREFLIGHT_NODE\tname=parse2-bind\t") &&
       has(out, "PREFLIGHT_NODE\tname=template-compile\t") &&
       has(out, "PREFLIGHT_NODE\tname=sys-six-target-0\t") &&
       has(out, "PREFLIGHT_NODE\tname=sys-six-target-1\t") &&
       has(out, "PREFLIGHT_NODE\tname=sixtarget-headers\t") &&
       has(out, "PREFLIGHT_NODE\tname=chain-to-snap\t") &&
       has(out, "PREFLIGHT_TABLE\tstatus=OK\trows=8"),
       "table-schema-live-ok", out);

    /* 2. Valid root, valid snap cache (plus ignored .partial.lock), unchanged parse2 on fixture table -> verdict=PASS in default strict mode */
    cx_fmt(root_ok, sizeof root_ok, "%s/root-ok", fx);
    cx_fmt(snap_base, sizeof snap_base, "%s/snap-ok", fx);
    cx_fmt(snap_entry, sizeof snap_entry, "%s/%.10s-8cc2381c", snap_base, ok_sha[0] ? ok_sha : rev);
    mk_dir(root_ok);
    mk_dir(snap_entry);
    wr_file(root_ok, "unisacc.com", "APE_BYTES");
    wr_file(root_ok, "unisacc.com.build.json", "{\"commit\":\"3224e3518e\"}");
    wr_file(snap_entry, "unisacc.com", "APE_BYTES");
    wr_file(snap_entry, "unisacc.com.build.json", "{\"commit\":\"3224e3518e\"}");
    wr_file(snap_base, "3224e3518e-8cc2381c.partial.lock", "lock");
    cx_fmt(evf, sizeof evf, "%s/events.tsv", fx);
    cx_fmt(arg, sizeof arg, "--table %s --root %s --repo %s --snap-base %s --rev %s --events-file %s", t_fx, root_ok, p2repo, snap_base, ok_sha, evf);
    ck(run_pf(arg, out, sizeof out) == 0 &&
       has(out, "PREFLIGHT_ITEM\troot-types\tPASS\t") &&
       has(out, "PREFLIGHT_ITEM\tsnap-cache-types\tPASS\t") &&
       has(out, "PREFLIGHT_ITEM\tparse2-bind\tPASS\t") &&
       has(out, "verdict=PASS\tfailed=-\tnodes=3\t") &&
       has(out, "\tmode=strict"),
       "all-regular-verdict-pass", out);

    /* 3. Root file replaced with a directory -> FAIL naming path and expected=regular (shadow mode rc=0) */
    cx_fmt(root_dir, sizeof root_dir, "%s/root-dir", fx);
    mk_dir(root_dir);
    wr_file(root_dir, "unisacc.com", "APE_BYTES");
    {
        char bj_dir[1200];
        cx_fmt(bj_dir, sizeof bj_dir, "%s/unisacc.com.build.json", root_dir);
        mk_dir(bj_dir);
    }
    cx_fmt(arg, sizeof arg, "--shadow --table %s --root %s --repo %s --snap-base %s --rev %s", t_fx, root_dir, p2repo, snap_base, ok_sha);
    ck(run_pf(arg, out, sizeof out) == 0 &&
       has(out, "PREFLIGHT_ITEM\troot-types\tFAIL\t") &&
       has(out, "unisacc.com.build.json\texpected=regular\tactual=directory") &&
       has(out, "verdict=FAIL\tfailed=root-types\t") &&
       has(out, "\tmode=shadow"),
       "root-build-json-directory-fails-with-path-and-expected-type", out);

    /* 4. Root file replaced with a dangling symlink -> FAIL naming path and expected=regular */
    cx_fmt(root_dangling, sizeof root_dangling, "%s/root-dangling", fx);
    mk_dir(root_dangling);
    {
        char p_ape[1200];
        cx_fmt(p_ape, sizeof p_ape, "%s/unisacc.com", root_dangling);
        sy_symlink("/nonexistent-dangling-target-preflight", p_ape);
    }
    wr_file(root_dangling, "unisacc.com.build.json", "{\"commit\":\"3224e3518e\"}");
    cx_fmt(arg, sizeof arg, "--shadow --table %s --root %s --repo %s --snap-base %s --rev %s", t_fx, root_dangling, p2repo, snap_base, ok_sha);
    ck(run_pf(arg, out, sizeof out) == 0 &&
       has(out, "PREFLIGHT_ITEM\troot-types\tFAIL\t") &&
       has(out, "unisacc.com\texpected=regular\tactual=dangling-symlink") &&
       has(out, "verdict=FAIL\tfailed=root-types\t"),
       "root-ape-dangling-symlink-fails-with-path-and-expected-type", out);

    /* 5. Root file replaced with a valid symlink -> FAIL naming path and expected=regular */
    cx_fmt(root_sym, sizeof root_sym, "%s/root-sym", fx);
    mk_dir(root_sym);
    wr_file(root_sym, "real-ape", "APE_BYTES");
    {
        char p_real[1200], p_ape[1200];
        cx_fmt(p_real, sizeof p_real, "%s/real-ape", root_sym);
        cx_fmt(p_ape, sizeof p_ape, "%s/unisacc.com", root_sym);
        sy_symlink(p_real, p_ape);
    }
    wr_file(root_sym, "unisacc.com.build.json", "{\"commit\":\"3224e3518e\"}");
    cx_fmt(arg, sizeof arg, "--item root-types --root %s", root_sym);
    ck(run_pf(arg, out, sizeof out) == 1 &&
       has(out, "PREFLIGHT_ITEM\troot-types\tFAIL\t") &&
       has(out, "unisacc.com\texpected=regular\tactual=symlink"),
       "root-ape-live-symlink-fails", out);

    /* 6. Snap cache file replaced with a symlink or directory -> FAIL naming snap path and expected=regular */
    {
        char sb_bad[1200], se_bad[1200], sp_bj[1200];
        cx_fmt(sb_bad, sizeof sb_bad, "%s/snap-bad", fx);
        cx_fmt(se_bad, sizeof se_bad, "%s/%.10s-deadbeef", sb_bad, ok_sha);
        mk_dir(se_bad);
        wr_file(se_bad, "unisacc.com", "APE_BYTES");
        cx_fmt(sp_bj, sizeof sp_bj, "%s/unisacc.com.build.json", se_bad);
        sy_symlink("/nonexistent-snap-build-json", sp_bj);
        cx_fmt(arg, sizeof arg, "--shadow --table %s --root %s --repo %s --snap-base %s --rev %s", t_fx, root_ok, p2repo, sb_bad, ok_sha);
        ck(run_pf(arg, out, sizeof out) == 0 &&
           has(out, "PREFLIGHT_ITEM\tsnap-cache-types\tFAIL\t") &&
           has(out, "unisacc.com.build.json\texpected=regular\tactual=dangling-symlink") &&
           has(out, "verdict=FAIL\tfailed=snap-cache-types\t"),
           "snap-cache-dangling-symlink-fails-with-path-and-expected-type", out);

        sy_unlink(sp_bj);
        mk_dir(sp_bj);
        cx_fmt(arg, sizeof arg, "--item snap-cache-types --root %s --snap-base %s --rev %s", root_ok, sb_bad, ok_sha);
        ck(run_pf(arg, out, sizeof out) == 1 &&
           has(out, "unisacc.com.build.json\texpected=regular\tactual=directory"),
           "snap-cache-directory-fails-with-path-and-expected-type", out);
    }

    /* 7. Table extensibility for M3 (parse2-bind) and M4 (template-compile, sys-six-target) with fake commands in fixture */
    cx_fmt(t_ext, sizeof t_ext, "%s/chain-preflight-ext.tsv", fx);
    wr_file(fx, "chain-preflight-ext.tsv",
        "# extended table with M3 and M4 rows\n"
        "name\tpatterns\tcmd\ttimeout_s\n"
        "root-types\t*,unisacc.com,unisacc.com.build.json\tsh ./unisacc.com tools/chain-preflight.cx -- --item root-types\t10\n"
        "snap-cache-types\t*,unisacc.com,unisacc.com.build.json\tsh ./unisacc.com tools/chain-preflight.cx -- --item snap-cache-types\t10\n"
        "parse2-bind\texec/parse2/*,exec/facts/*,seed/gen.c\tsh ./unisacc.com tools/chain-preflight.cx -- --item parse2-bind\t30\n"
        "template-compile\ttools/templates/*,cx/compiler/*\ttrue\t45\n"
        "sys-six-target\tcx/sys/*,ext/sysx/*,include/*\ttrue\t55\n");
    cx_fmt(arg, sizeof arg, "--check-table --table %s", t_ext);
    ck(run_pf(arg, out, sizeof out) == 0 &&
       has(out, "PREFLIGHT_TABLE\tstatus=OK\trows=5"),
       "table-extensible-m3-m4-rows-accepted", out);
    cx_fmt(arg, sizeof arg, "--table %s --root %s --repo %s --snap-base %s --rev %s", t_ext, root_ok, p2repo, snap_base, ok_sha);
    ck(run_pf(arg, out, sizeof out) == 0 &&
       has(out, "verdict=PASS\tfailed=-\tnodes=5\t"),
       "table-extensible-m3-m4-runs-5-nodes", out);

    /* 8. Malformed table rows (timeout > 55, duplicate node name, or invalid patterns) refused with rc 2 */
    cx_fmt(t_bad1, sizeof t_bad1, "%s/bad-timeout.tsv", fx);
    wr_file(fx, "bad-timeout.tsv",
        "name\tpatterns\tcmd\ttimeout_s\n"
        "root-types\t*\ttrue\t60\n"
        "snap-cache-types\t*\ttrue\t10\n"
        "parse2-bind\t*\ttrue\t30\n");
    cx_fmt(arg, sizeof arg, "--check-table --table %s", t_bad1);
    ck(run_pf(arg, out, sizeof out) == 2 && has(out, "PREFLIGHT_TABLE\tstatus=FAIL"),
       "table-timeout-over-55-refused", out);

    cx_fmt(t_bad2, sizeof t_bad2, "%s/bad-dup.tsv", fx);
    wr_file(fx, "bad-dup.tsv",
        "name\tpatterns\tcmd\ttimeout_s\n"
        "root-types\t*\ttrue\t10\n"
        "root-types\t*\ttrue\t10\n"
        "parse2-bind\t*\ttrue\t30\n");
    cx_fmt(arg, sizeof arg, "--check-table --table %s", t_bad2);
    ck(run_pf(arg, out, sizeof out) == 2 && has(out, "PREFLIGHT_TABLE\tstatus=FAIL"),
       "table-duplicate-node-refused", out);

    cx_fmt(t_bad3, sizeof t_bad3, "%s/bad-patterns.tsv", fx);
    wr_file(fx, "bad-patterns.tsv",
        "name\tpatterns\tcmd\ttimeout_s\n"
        "root-types\texec/parse2/*,,seed/gen.c\ttrue\t10\n"
        "snap-cache-types\t*\ttrue\t10\n"
        "parse2-bind\t*\ttrue\t30\n");
    cx_fmt(arg, sizeof arg, "--check-table --table %s", t_bad3);
    ck(run_pf(arg, out, sizeof out) == 2 && has(out, "PREFLIGHT_TABLE\tstatus=FAIL\treason=bad-patterns"),
       "table-bad-patterns-refused", out);

    /* 9. M3 parse2-bind: fixture clone-push mismatch fails naming file and line */
    cx_fmt(arg, sizeof arg, "--shadow --table %s --root %s --repo %s --snap-base %s --rev %s", t_fx, root_ok, p2repo, snap_base, bad_sha);
    ck(run_pf(arg, out, sizeof out) == 0 &&
       has(out, "PREFLIGHT_ITEM\tparse2-bind\tFAIL\t") &&
       has(out, "file=exec/parse2/parenfold-template.tsv\tline=3\tlocation=exec/parse2/parenfold-template.tsv:3\treason=clone-push target mismatch") &&
       has(out, "verdict=FAIL\tfailed=parse2-bind\t"),
       "parse2-fixture-mismatch-fails-with-file-and-line", out);

    /* 10. M3 parse2-bind: unchanged parse2 inputs skip seed-gen recipe */
    cx_fmt(arg, sizeof arg, "--item parse2-bind --repo %s --rev %s", p2repo, ok_sha);
    ck(run_pf(arg, out, sizeof out) == 0 &&
       has(out, "PREFLIGHT_ITEM\tparse2-bind\tPASS\t") &&
       has(out, "status=parse2-inputs-unchanged"),
       "parse2-fixture-unchanged-skips-recipe", out);

    /* 11. M3 parse2-bind: changed seed/gen.c runs cold then warm parse2 --locations recipe */
    {
        char gcmd[2400], chg_sha[64] = {0};
        wr_file(p2repo, "seed/gen.c",
            "/* updated generator */\n#include <stdio.h>\n#include <string.h>\n"
            "int main(int n,char **a){"
            "if(n!=4||strcmp(a[1],\"parse2\")||strcmp(a[3],\"--locations\"))return 2;"
            "FILE *f=fopen(\"exec/parse2/parenfold-template.tsv\",\"r\");if(!f)return 3;"
            "int bad=fgetc(f)=='B';fclose(f);"
            "f=fopen(a[2],\"w\");if(!f)return 4;fputs(\"{}\\n\",f);fclose(f);"
            "if(bad)fputs(\"seed-gen: exec/parse2/parenfold-template.tsv:3: clone-push target mismatch\\n\",stderr);"
            "return bad;}\n");
        cx_fmt(gcmd, sizeof gcmd,
            "cd '%s' && git add --all && "
            "git -c user.name=fx -c user.email=fx@local -c core.hooksPath=/dev/null -c commit.gpgsign=false commit -qm chg && "
            "git rev-parse HEAD", p2repo);
        ckk_sh("CHECK_CHAIN_PREFLIGHT", gcmd, out, sizeof out);
        if (strlen(out) >= 40) { mm_copy(chg_sha, sizeof chg_sha, out, 40); chg_sha[40] = 0; }
        cx_fmt(arg, sizeof arg, "--item parse2-bind --repo %s --rev %s --cold", p2repo, chg_sha);
        ck(run_pf(arg, out, sizeof out) == 0 &&
           has(out, "PREFLIGHT_ITEM\tparse2-bind\tPASS\t") &&
           has(out, "status=gen-shared-e3\tseed_gen=cold\t"),
           "parse2-fixture-changed-seed-runs-cold", out);
        cx_fmt(arg, sizeof arg, "--item parse2-bind --repo %s --rev %s", p2repo, chg_sha);
        ck(run_pf(arg, out, sizeof out) == 0 &&
           has(out, "PREFLIGHT_ITEM\tparse2-bind\tPASS\t") &&
           has(out, "status=gen-shared-e3\tseed_gen=warm\tcompile_ms=0\t"),
           "parse2-fixture-changed-seed-runs-warm", out);
    }

    /* 12. M3 parse2-bind on real ce76ca096d tree when present in git history (else verified against p2repo bad_sha) */
    {
        const char *ce_rev = "ce76ca096de8069650010e74962a8cc8ab4d637b";
        if (ckk_sh("CHECK_CHAIN_PREFLIGHT", "git rev-parse --verify ce76ca096de8069650010e74962a8cc8ab4d637b^{commit}", out, sizeof out) == 0) {
            cx_fmt(arg, sizeof arg, "--item parse2-bind --repo . --rev %s", ce_rev);
        } else {
            cx_fmt(arg, sizeof arg, "--item parse2-bind --repo %s --rev %s", p2repo, bad_sha);
        }
        ck(run_pf(arg, out, sizeof out) == 1 &&
           has(out, "PREFLIGHT_ITEM\tparse2-bind\tFAIL\t") &&
           has(out, "file=exec/parse2/parenfold-template.tsv\tline=3\tlocation=exec/parse2/parenfold-template.tsv:3\treason=clone-push target mismatch"),
           "parse2-ce76ca096d-clone-push-mismatch-fails-with-file-and-line", out);
    }

    /* 13. Mandatory enforcement (mode=strict default) blocks all 7 failure shapes from 0.0.86 chains 1..7 (7/7 >= 5/7) */
    {
        int blocked = 0;
        char sb_c3[1200], se_c3[1200], sp_c3[1200], t_c5[1200], t_c6[1200], t_c7[1200], tdir[1300];
        /* Shape 1 (chain1): Root missing unisacc.com.build.json */
        cx_fmt(root_nojson, sizeof root_nojson, "%s/root-nojson", fx);
        mk_dir(root_nojson);
        wr_file(root_nojson, "unisacc.com", "APE_BYTES");
        cx_fmt(arg, sizeof arg, "--table %s --root %s --repo %s --snap-base %s --rev %s", t_fx, root_nojson, p2repo, snap_base, ok_sha);
        if (run_pf(arg, out, sizeof out) == 1 && has(out, "verdict=FAIL\tfailed=root-types\t") && has(out, "\tmode=strict")) blocked++;

        /* Shape 2 (chain2): Root unisacc.com is a symlink */
        cx_fmt(arg, sizeof arg, "--table %s --root %s --repo %s --snap-base %s --rev %s", t_fx, root_sym, p2repo, snap_base, ok_sha);
        if (run_pf(arg, out, sizeof out) == 1 && has(out, "verdict=FAIL\tfailed=root-types\t") && has(out, "\tmode=strict")) blocked++;

        /* Shape 3 (chain3): Snapshot cache entry has non-regular file */
        cx_fmt(sb_c3, sizeof sb_c3, "%s/snap-c3", fx);
        cx_fmt(se_c3, sizeof se_c3, "%s/%.10s-c3bad", sb_c3, ok_sha);
        mk_dir(se_c3);
        wr_file(se_c3, "unisacc.com", "APE_BYTES");
        cx_fmt(sp_c3, sizeof sp_c3, "%s/unisacc.com.build.json", se_c3);
        sy_symlink("/nonexistent-c3-build-json", sp_c3);
        cx_fmt(arg, sizeof arg, "--table %s --root %s --repo %s --snap-base %s --rev %s", t_fx, root_ok, p2repo, sb_c3, ok_sha);
        if (run_pf(arg, out, sizeof out) == 1 && has(out, "verdict=FAIL\tfailed=snap-cache-types\t") && has(out, "\tmode=strict")) blocked++;

        /* Shape 4 (chain4): parse2 clone-push target mismatch */
        cx_fmt(arg, sizeof arg, "--table %s --root %s --repo %s --snap-base %s --rev %s", t_fx, root_ok, p2repo, snap_base, bad_sha);
        if (run_pf(arg, out, sizeof out) == 1 && has(out, "verdict=FAIL\tfailed=parse2-bind\t") && has(out, "\tmode=strict")) blocked++;

        /* Shape 5 (chain5): template-compile C99 conflicting parameter types failure */
        cx_fmt(t_c5, sizeof t_c5, "%s/table-c5.tsv", fx);
        wr_file(fx, "table-c5.tsv",
            "name\tpatterns\tcmd\ttimeout_s\n"
            "root-types\t*\tsh ./unisacc.com tools/chain-preflight.cx -- --item root-types\t10\n"
            "snap-cache-types\t*\tsh ./unisacc.com tools/chain-preflight.cx -- --item snap-cache-types\t10\n"
            "parse2-bind\t*\tsh ./unisacc.com tools/chain-preflight.cx -- --item parse2-bind\t30\n"
            "template-compile\ttools/templates/\tfalse\t30\n");
        cx_fmt(arg, sizeof arg, "--table %s --root %s --repo %s --snap-base %s --rev %s", t_c5, root_ok, p2repo, snap_base, ok_sha);
        if (run_pf(arg, out, sizeof out) == 1 && has(out, "verdict=FAIL\tfailed=template-compile\t") && has(out, "\tmode=strict")) blocked++;

        /* Shape 6 (chain6): template SHA mismatch between tools/templates/whole-front.cx.in and tools/candidate-chain.cx */
        cx_fmt(tdir, sizeof tdir, "%s/tools/templates", p2repo);
        mk_dir(tdir);
        wr_file(p2repo, "tools/candidate-chain.cx",
            "static void check_whole_front_template(const char *tmpl) {\n"
            "    const char *want = \"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\";\n"
            "}\n");
        wr_file(p2repo, "tools/templates/whole-front.cx.in", "/* modified template without updating pin */\n");
        cx_fmt(t_c6, sizeof t_c6, "%s/table-c6.tsv", fx);
        wr_file(fx, "table-c6.tsv",
            "name\tpatterns\tcmd\ttimeout_s\n"
            "root-types\t*\tsh ./unisacc.com tools/chain-preflight.cx -- --item root-types\t10\n"
            "snap-cache-types\t*\tsh ./unisacc.com tools/chain-preflight.cx -- --item snap-cache-types\t10\n"
            "parse2-bind\t*\tsh ./unisacc.com tools/chain-preflight.cx -- --item parse2-bind\t30\n"
            "template-compile\ttools/templates/\ttrue\t30\n");
        cx_fmt(arg, sizeof arg, "--table %s --root %s --repo %s --snap-base %s --rev %s", t_c6, root_ok, p2repo, snap_base, ok_sha);
        if (run_pf(arg, out, sizeof out) == 1 && has(out, "reason=template-sha-mismatch") && has(out, "verdict=FAIL\tfailed=template-compile\t")) blocked++;

        /* Shape 7 (chain7): sys-six-target-0 C99 undeclared function failure */
        cx_fmt(t_c7, sizeof t_c7, "%s/table-c7.tsv", fx);
        wr_file(fx, "table-c7.tsv",
            "name\tpatterns\tcmd\ttimeout_s\n"
            "root-types\t*\tsh ./unisacc.com tools/chain-preflight.cx -- --item root-types\t10\n"
            "snap-cache-types\t*\tsh ./unisacc.com tools/chain-preflight.cx -- --item snap-cache-types\t10\n"
            "parse2-bind\t*\tsh ./unisacc.com tools/chain-preflight.cx -- --item parse2-bind\t30\n"
            "sys-six-target-0\tcx/sys/\tfalse\t30\n");
        cx_fmt(arg, sizeof arg, "--table %s --root %s --repo %s --snap-base %s --rev %s", t_c7, root_ok, p2repo, snap_base, ok_sha);
        if (run_pf(arg, out, sizeof out) == 1 && has(out, "verdict=FAIL\tfailed=sys-six-target-0\t") && has(out, "\tmode=strict")) blocked++;

        ck(blocked == 7, "strict-mode-blocks-all-7-failure-shapes", out);
    }

    /* 14. chain-to-snap: red with UNISACC_INTEGRATOR=1 naming UNISACC_INTEGRATOR, green in clean environment */
    {
        const char *snap_rev = "de7bd89ab5d19a68c22db78087ec6dabc79aa9f4";
        char scmd[2400];
        if (ckk_sh("CHECK_CHAIN_PREFLIGHT", "git rev-parse --verify de7bd89ab5d19a68c22db78087ec6dabc79aa9f4^{commit}", out, sizeof out) == 0) {
            cx_fmt(scmd, sizeof scmd, "UNISACC_INTEGRATOR=1 '%s' -- --item chain-to-snap --repo . --rev %s", pf_bin, snap_rev);
            ck(ckk_sh("CHECK_CHAIN_PREFLIGHT", scmd, out, sizeof out) == 1 &&
               has(out, "PREFLIGHT_ITEM\tchain-to-snap\tFAIL\t") &&
               has(out, "REFUSE chain-env UNISACC_INTEGRATOR"),
               "chain-to-snap-integrator-env-red-names-var", out);

            cx_fmt(scmd, sizeof scmd, "env -u UNISACC_INTEGRATOR '%s' -- --item chain-to-snap --repo . --rev %s", pf_bin, snap_rev);
            ck(ckk_sh("CHECK_CHAIN_PREFLIGHT", scmd, out, sizeof out) == 0 &&
               has(out, "PREFLIGHT_ITEM\tchain-to-snap\tPASS\t") &&
               has(out, "\tstatus=until-snap\t"),
               "chain-to-snap-clean-env-green", out);
        }
    }

    /* 15. version-seq-tag-drift: unpublished row in build/version-seq.tsv after last public row with existing git tag is refused */
    {
        char gcmd[2400];
        wr_file(p2repo, "build/version-seq.tsv",
            "slot\tversion\tclass\tstate\tnote\n"
            "1\t0.0.1\ttest\t已公开\tfixture\n"
            "2\t0.0.2\ttest\t进行中\tdrift\n");
        cx_fmt(gcmd, sizeof gcmd,
            "cd '%s' && git add build/version-seq.tsv && "
            "git -c user.name=fx -c user.email=fx@local -c core.hooksPath=/dev/null -c commit.gpgsign=false commit -qm drift && "
            "git tag v0.0.2", p2repo);
        ckk_sh("CHECK_CHAIN_PREFLIGHT", gcmd, out, sizeof out);
        cx_fmt(arg, sizeof arg, "--item parse2-bind --repo %s --rev HEAD", p2repo);
        ck(run_pf(arg, out, sizeof out) == 1 &&
           has(out, "PREFLIGHT_ITEM\tparse2-bind\tFAIL\t") &&
           has(out, "reason=version-seq-tag-drift:v0.0.2\t"),
           "parse2-version-seq-tag-drift-refused", out);
    }

    cx_fmt(rmcmd, sizeof rmcmd, "rm -rf '%s'", fx);
    ckk_sh("CHECK_CHAIN_PREFLIGHT", rmcmd, out, sizeof out);

    printf("CHECK_CHAIN_PREFLIGHT\tfailed=%d\tassertions=%d\tms=%ld\n", failed, assertions, sy_now_ms() - t0);
    return failed ? 1 : 0;
}
