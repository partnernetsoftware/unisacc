/* Independent format fixtures, never signed release evidence. */
#pragma unisa use sysx.process
#pragma unisa use sys.time
#pragma unisa use mem.bytes
static int checks,failed;static long deadline;static char root[4400],base[4400],exe[4400],manifest[4400],badfile[4400];
static void die(const char*s){fprintf(stderr,"check-release-members: %s\n",s);exit(2);}
static void ck(int yes,const char*s){checks++;failed+=!yes;printf("%s\t%s\n",yes?"PASS":"FAIL",s);}
static void path(char*p,size_t cap,const char*a,const char*b){if(cx_fmt(p,cap,"%s/%s",a,b))die("path");}
static void put(const char*p,const void*b,size_t n){if(cx_write(p,b,n))die("fixture write");}
static np_result call(char**v,int cap){if(deadline-sy_now_ms()<(cap+1)*1000)die("overall deadline");np_result r={0};char why[1000]={0};if(np_run(v,root,0,cap,&r,why,sizeof why)||r.residue)die(why);return r;}
static void expect(char**v,int rc,const char*label){np_result r=call(v,5);ck(r.rc==rc,label);if(r.rc!=rc)fprintf(stderr,"rc=%d\n%s%s",r.rc,r.out?r.out:"",r.err?r.err:"");np_free(&r);}
static void p32(unsigned char*p,unsigned long v){for(int i=0;i<4;i++){p[i]=v&255;v>>=8;}}
static void fixture(const char*dir){char p[4400];const char*pack="P 4 1 1 0\nD r s in out 0\nM 1 1 1 0\nA";size_t pn=strlen(pack),n=296+pn+16;unsigned char*b=calloc(1,n);if(!b)die("fixture alloc");b[0]='M';b[1]='Z';p32(b+60,64);b[64]='P';b[65]='E';b[70]=1;b[84]=160;b[88]=11;b[89]=2;p32(b+148,288);p32(b+196,5);p32(b+264,8);p32(b+268,288);if(mm_copy(b+296,n-296,pack,pn))die("pack fixture bound");memcpy(b+296+pn,"UNIPKG1\n",8);p32(b+304+pn,pn);path(p,sizeof p,dir,"ape.com");put(p,b,n);free(b);const char*names[]={"osx-arm","osx-x64","cache-arm","cache-x64"};for(int i=0;i<4;i++){unsigned char m[56]={0};p32(m,0xfeedfacfUL);p32(m+4,i%2?0x1000007UL:0x100000cUL);p32(m+12,2);p32(m+16,1);p32(m+20,24);p32(m+32,0x1b);p32(m+36,24);path(p,sizeof p,dir,names[i]);put(p,m,sizeof m);}}
static char*text(size_t*n){char*b=cx_read(manifest,n);if(!b)die("manifest read");return b;}
static void badtext(char*b,size_t n,const char*label){put(badfile,b,n);char*v[]={exe,"--check",base,badfile,0};expect(v,2,label);free(b);}
int main(int argc,char**argv){if(argc>2||!realpath(argc==2?argv[1]:".",root))return 2;deadline=sy_now_ms()+52000;char temp[]="/tmp/release-members-check-XXXXXX";if(!mkdtemp(temp)||!realpath(temp,base))die("fresh fixture");char com[4400],source[4400],p[4400],q[4400];path(com,sizeof com,root,"unisacc.com");path(source,sizeof source,root,"tools/release-members.cx");path(exe,sizeof exe,base,"release-members");char*build[]={"sh",com,source,"-o",exe,0};np_result r=call(build,35);ck(!r.rc,"compile current members tool");if(r.errn)fwrite(r.err,1,r.errn,stderr);if(r.rc)die("compile");np_free(&r);fixture(base);path(manifest,sizeof manifest,base,"members.tsv");path(badfile,sizeof badfile,base,"bad.tsv");char*create[]={exe,base,manifest,"ape.com","osx-arm","osx-x64","cache-arm","cache-x64",0};expect(create,0,"independent tiny PE/P4 and four thin MachO create and strictcheck");char*check[]={exe,"--check",base,manifest,0};expect(check,0,"strict five-row handoff verifies");size_t n;char*b=text(&n);int lines=0;for(size_t i=0;i<n;i++)lines+=b[i]=='\n';ck(lines==5&&!strncmp(b,"ape\tape.com\t",12),"five lines canonical roles and no header");free(b);expect(create,2,"exclusive create refuses overwrite");b=text(&n);char*t=strchr(strchr(b,'\t')+1,'\t')+1;t[0]=t[0]=='0'?'1':'0';badtext(b,n,"wrong SHA rejected");b=text(&n);b[0]='x';badtext(b,n,"unknown role rejected");b=text(&n);char*row=strchr(b,'\n')+1;row[0]='a';badtext(b,n,"wrong canonical role order rejected");b=text(&n);char*extra=malloc(n+2);if(!extra)die("extra alloc");if(mm_copy(extra,n+2,b,n))die("extra fixture bound");extra[n]='\n';extra[n+1]=0;free(b);badtext(extra,n+1,"extra line rejected");b=text(&n);badtext(b,n-1,"missing final newline rejected");
create[5]="osx-arm";char newmanifest[4400];path(newmanifest,sizeof newmanifest,base,"duplicate.tsv");create[2]=newmanifest;expect(create,2,"duplicate basenames rejected");create[5]="osx-x64";create[3]="../ape.com";expect(create,2,"path traversal rejected");create[3]="ape.com";
path(p,sizeof p,base,"osx-arm");path(q,sizeof q,base,"saved-arm");if(rename(p,q))die("hide fixture");expect(check,2,"missing member rejected");if(symlink(q,p))die("symlink fixture");expect(check,2,"symlink member rejected");if(unlink(p)||rename(q,p))die("restore fixture");
size_t z;char*m=cx_read(p,&z);if(!m)die("MachO read");m[4]=7;put(p,m,z);expect(check,2,"wrong CPU rejected");m[4]=12;m[36]=7;put(p,m,z);expect(check,2,"invalid command boundary rejected");m[36]=24;m[12]=1;put(p,m,z);expect(check,2,"non-executable MachO rejected");m[12]=2;put(p,m,z);free(m);
path(p,sizeof p,base,"ape.com");m=cx_read(p,&z);if(!m)die("PE read");m[z-16]='X';put(p,m,z);expect(check,2,"bad package footer rejected");m[z-16]='U';m[298]='3';put(p,m,z);expect(check,2,"non-P4 package rejected");m[298]='4';put(p,m,z);free(m);expect(check,0,"restored fixture verifies all original member hashes");
char*none[]={exe,0};expect(none,2,"missing arguments rejected");printf("RELEASE_MEMBERS_CHECK\tchecks=%d\tfailed=%d\tscope=independent-unsigned-format-fixtures\tretained=%s\n",checks,failed,base);return failed?1:0;}
