/* tools/check-surf-probe.cx -- verify tools/surf-probe.cx emits 6 SURF receipts on host target. */
#pragma unisa use sys.proc
#pragma unisa use sys.fs

static int sp_pass, sp_fail;
static void sp_ck(int ok, const char *name) {
    printf("%s\tsurf-probe.%s\n", ok ? "PASS" : "FAIL", name);
    if (ok) sp_pass++; else sp_fail++;
}

int main(void) {
    char *av[] = { "timeout", "30", "sh", "unisacc.com", "tools/surf-probe.cx", "--", "lnx/x86_64", 0 };
    static char out[8192];
    int cut = 0;
    int rc = sy_run(av, out, (int)sizeof(out) - 1, &cut);
    sp_ck(rc == 0 && !cut, "run-exit-0");
    sp_ck(strstr(out, "SURF\tcx.sys\tsy_write_all\tlnx/x86_64\tok") != 0, "emit-write-all-ok");
    sp_ck(strstr(out, "SURF\tcx.sys\tsy_pread\tlnx/x86_64\tok") != 0, "emit-pread-ok");
    sp_ck(strstr(out, "SURF\tcx.sys\tsy_pwrite\tlnx/x86_64\tok") != 0, "emit-pwrite-ok");
    sp_ck(strstr(out, "SURF\tcx.os\tsy_fsync\tlnx/x86_64\tok") != 0, "emit-fsync-ok");
    sp_ck(strstr(out, "SURF\tcx.os\tsy_utimes\tlnx/x86_64\tok") != 0, "emit-utimes-ok");
    sp_ck(strstr(out, "SURF\tcx.os\tsy_rlimit_as\tlnx/x86_64\tok") != 0, "emit-rlimit-as-ok");
    sp_ck(strstr(out, "SURF_PROBE\ttarget=lnx/x86_64\temitted=6") != 0, "emit-summary-6");
    printf("CHECK_SURF_PROBE\tpassed=%d\tfailed=%d\n", sp_pass, sp_fail);
    return sp_fail ? 1 : 0;
}
