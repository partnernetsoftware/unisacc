/* tools/check-devsvc-compile-context.cx -- devsvc 非独立 .cx 编译上下文表 build/devsvc-compile-context.tsv 的校验与断言。
 *   sh ./unisacc.com tools/check-devsvc-compile-context.cx -- --check   只校验仓根(当前目录)的表
 *   sh ./unisacc.com tools/check-devsvc-compile-context.cx              校验表 + 坏表拒绝 + devsvc f write 实跑断言
 * 表校验:7 列;path 存在;kind 为 embedded-in 或 fragment;reason 非空非 -;command 非空;path 不重复。
 * 实跑断言在临时根(符号链接到本树)里以 DEVSVC_LOCAL_WRITES=1 单次进程执行,不碰常驻服务。
 * 末行:CHECK_DEVSVC_COMPILE_CONTEXT<TAB>failed=N */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use sys.posix
#pragma unisa use sys.io
#pragma unisa use os.osx
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use text.text
#pragma unisa use cxlib.flowfile

static int fails, asserts;
static void ok(int c, const char *what) { asserts++; if (!c) { fails++; printf("FAIL\t%s\n", what); } else printf("ok\t%s\n", what); }

static int feq(const unsigned char *b, long s, long e, const char *z) {
    long n = tx_len(z, 4096), k;
    if (e - s != n) return 0;
    for (k = 0; k < n; k++) if (b[s + k] != (unsigned char)z[k]) return 0;
    return 1;
}

/* 0 good; >0 number of bad rows (reasons printed) */
static int validate(const char *root, const char *table) {
    unsigned char *b = 0; int64_t bn = 0; long i = 0, ls, le, f[9], nf, j, seen[256][2]; int ns = 0, bad = 0, q;
    char p[4096], tp[4096];
    if (cx_fmt(tp, sizeof tp, "%s/%s", root, table) < 0 || sy_read_file(tp, &b, &bn, 1 << 20) != 0 || !b) { printf("BAD\tno-table\t%s\n", table); return 1; }
    while (i < (long)bn) {
        ls = i; while (i < (long)bn && b[i] != '\n') i++; le = i; i++;
        if (le == ls || b[ls] == '#') continue;
        nf = 0; f[nf++] = ls;
        for (j = ls; j < le && nf < 9; j++) if (b[j] == '\t') f[nf++] = j + 1;
        f[nf] = le + 1;
        if (nf != 7) { printf("BAD\tcolumns=%ld\n", nf); bad++; continue; }
        {   long pl = f[1] - 1 - f[0];
            sy_stat_t st;
            if (pl <= 0 || pl > 3000) { printf("BAD\tpath\n"); bad++; continue; }
            if (cx_fmt(p, sizeof p, "%s/%.*s", root, (int)pl, (const char *)b + f[0]) < 0 || sy_stat(p, &st) != 0) { printf("BAD\tmissing-path\t%.*s\n", (int)pl, (const char *)b + f[0]); bad++; }
            for (q = 0; q < ns; q++) if (seen[q][1] - seen[q][0] == pl && !mm_cmp(b + seen[q][0], b + f[0], (size_t)pl)) { printf("BAD\tduplicate\t%.*s\n", (int)pl, (const char *)b + f[0]); bad++; }
            if (ns < 256) { seen[ns][0] = f[0]; seen[ns][1] = f[0] + pl; ns++; }
        }
        if (!feq(b, f[1], f[2] - 1, "embedded-in") && !feq(b, f[1], f[2] - 1, "fragment")) { printf("BAD\tunknown-kind\n"); bad++; }
        if (f[3] - 1 == f[2]) { printf("BAD\tempty-host\n"); bad++; }
        else if (!feq(b, f[2], f[3] - 1, "-")) {
            long hs = f[2], he = f[3] - 1;
            while (hs < he) {
                long ts = hs, te, colon = -1, hl;
                sy_stat_t hst;
                while (hs < he && b[hs] != ',') {
                    if (b[hs] == ':' && colon < 0) colon = hs;
                    hs++;
                }
                te = colon >= 0 ? colon : hs;
                hl = te - ts;
                if (hs < he && b[hs] == ',') hs++;
                if (hl <= 0 || hl > 1000 || cx_fmt(p, sizeof p, "%s/%.*s", root, (int)hl, (const char *)b + ts) < 0 || sy_stat(p, &hst) != 0) {
                    printf("BAD\tmissing-host\t%.*s\n", (int)(hl > 0 ? hl : 0), (const char *)b + ts);
                    bad++;
                }
            }
        }
        if (f[4] - 1 == f[3]) { printf("BAD\tempty-command\n"); bad++; }
        if (f[5] - 1 == f[4] || feq(b, f[4], f[5] - 1, "-")) { printf("BAD\tno-reason\n"); bad++; }
    }
    mm_free(b);
    return bad;
}

static void put(const char *path, const char *s) { int fd = sy_open_new(path, 0644); if (fd >= 0) { sy_write_all(fd, s, tx_len(s, 1 << 20)); sy_close(fd); } }

static int badtable(const char *dir, const char *rows) {
    char p[4096];
    cx_fmt(p, sizeof p, "%s/build/devsvc-compile-context.tsv", dir); sy_unlink(p); put(p, rows);
    return validate(dir, "build/devsvc-compile-context.tsv");
}

/* run devsvc in DIR; output to LOG; returns exit code (-1 spawn failure) */
static char g_outer[4096];   /* the real repo root: plays the outer devsvc job's exported root */
static int g_nomark;         /* 1: export UNISACC_FLOW_ROOT without the job marker */
static int run_dv(const char *dir, const char *inst, char **args, const char *log) {
    char *argv[40], e1[4200], e2[4200], e3[4200], e4[4300], e5[4400]; sy_spawn_t sp; sy_exit_t st; int fd, i, n = 0, r;
    cx_fmt(e1, sizeof e1, "UNISACC_DEVSVC_DIR=%s", inst);
    /* no scrubbing: every nested call gets exactly what an outer devsvc job exports (root, its marker, a repo-table pin of the outer root);
       devsvc's nested-inheritance rule (plans/devsvc.md section 3) must drop them because DIR is not under the marked root */
    cx_fmt(e2, sizeof e2, "UNISACC_FLOW_ROOT=%s", g_outer); cx_fmt(e3, sizeof e3, "UNISACC_FLOW_ROOT_JOB=%s", g_outer);
    cx_fmt(e4, sizeof e4, "DEVSVC_REPO_TABLE=%s/tools/devsvc-repo.tsv", g_outer); cx_fmt(e5, sizeof e5, "DEVSVC_REPO_TABLE_PIN=outer:%s/tools/devsvc-repo.tsv", g_outer);
    if (g_nomark) cx_fmt(e3, sizeof e3, "UNISACC_FLOW_ROOT_JOB=");   /* unmarked: UNISACC_FLOW_ROOT counts as explicitly given and is kept */
    argv[n++] = "env"; argv[n++] = e2; argv[n++] = e3; argv[n++] = e4; argv[n++] = e5; argv[n++] = e1; argv[n++] = "DEVSVC_LOCAL_WRITES=1"; argv[n++] = "sh"; argv[n++] = "./unisacc.com"; argv[n++] = "tools/devsvc.cx"; argv[n++] = "--";
    for (i = 0; args[i] && n < 38; i++) argv[n++] = args[i];
    argv[n] = 0;
    sy_unlink(log); fd = sy_open_new(log, 0644); if (fd < 0) return -1;
    sy_spawn_init(&sp); sp.argv = argv; sp.cwd = dir; sp.in_fd = SY_STDIO_NULL; sp.out_fd = fd; sp.err_fd = fd; sp.pgroup = -1; sp.deadline_ms = 50000;
    r = sy_proc_run(&sp, &st); sy_close(fd);
    r = (r < 0 || st.timed_out || !st.exited) ? -1 : st.code;
    if (r != 0 && !(args[0] && tx_eqz(args[0], "f") && args[2] && tx_eqz(args[2], "x/bad.cx"))) {   /* diagnostics only on an unexpected rc */
        unsigned char *b = 0; int64_t bn = 0; long i, ln = 0;
        printf("DIAG\trun_dv\t%s\t%s\trc=%d\n", args[0] ? args[0] : "-", args[2] ? args[2] : "-", r);
        if (sy_read_file(log, &b, &bn, 1 << 22) == 0 && b) {
            for (i = 0; i < (long)bn && ln < 5; i++) { if (i == 0 || b[i - 1] == '\n') printf("DIAG\t| "); putchar(b[i]); if (b[i] == '\n') ln++; }
            if (bn > 0 && b[bn - 1] != '\n' && ln < 5) putchar('\n');
            mm_free(b);
        }
    }
    return r;
}

/* LOG has a line starting with PFX */
static int has_line(const char *log, const char *pfx) {
    unsigned char *b = 0; int64_t bn = 0; long i = 0, ls, n = tx_len(pfx, 4096); int hit = 0;
    if (sy_read_file(log, &b, &bn, 1 << 22) != 0 || !b) return 0;
    while (i <= (long)bn && !hit) { ls = i; while (i < (long)bn && b[i] != '\n') i++; if (i - ls >= n && !mm_cmp(b + ls, pfx, (size_t)n)) hit = 1; i++; }
    mm_free(b);
    return hit;
}

int main(int argc, char **argv) {
    char root[4096], d[4096], p[4096], q[4096], inst[4096], log[4096];
    int r;
    if (sy_cwd(root, sizeof root) < 0) return 2;
    cx_fmt(g_outer, sizeof g_outer, "%s", root);
    r = validate(root, "build/devsvc-compile-context.tsv");
    ok(r == 0, "repo-table-valid");
    {
        char ckind[32], ccmd[1024], creason[400];
        int lk = ff_ctx_lookup(root, "ujs/seed/stage0/compiler_min.cx", ckind, ccmd, sizeof ccmd, creason, sizeof creason);
        ok(lk == 1 && tx_eqz(ckind, "embedded-in") &&
           tx_find(ccmd, tx_len(ccmd, sizeof ccmd), "-DUJS_HOST", 10) >= 0 &&
           tx_find(ccmd, tx_len(ccmd, sizeof ccmd), "ujs/product/ujs_main.cx", 23) >= 0 &&
           tx_find(ccmd, tx_len(ccmd, sizeof ccmd), "ujs/product/host1_vm.cx", 23) >= 0 &&
           tx_find(ccmd, tx_len(ccmd, sizeof ccmd), "ujs/seed/stage0/compiler_min.cx", 31) >= 0 &&
           tx_find(creason, tx_len(creason, sizeof creason), "ujs/product/build-ape.cx:emit_slice", 35) >= 0,
           "stage0-compiler-min-registered-in-repo-table");
    }
    if (argc > 1 && tx_eqz(argv[1], "--check")) { printf("CHECK_DEVSVC_COMPILE_CONTEXT\tfailed=%d\n", fails); return fails ? 1 : 0; }
    if (sy_mkdtemp(sy_tmpdir(), "ctxchk-", d, sizeof d) != 0) return 2;
    {   sy_dir_t dd; int k;
        if (sy_dir_open(&dd, root) == 0) {
            while ((k = sy_dir_next(&dd)) == 1) {
                if (tx_eqz(dd.name, "build") || tx_eqz(dd.name, "x") || tx_eqz(dd.name, "unisacc.com")) continue;
                cx_fmt(p, sizeof p, "%s/%s", root, dd.name); cx_fmt(q, sizeof q, "%s/%s", d, dd.name); sy_symlink(p, q);
            }
            sy_dir_close(&dd);
        }
        cx_fmt(p, sizeof p, "%s/unisacc.com", root); cx_fmt(q, sizeof q, "%s/unisacc.com", d);
        sy_symlink(p, q);
        cx_fmt(p, sizeof p, "%s/build", d); sy_mkdir(p, 0755);
        cx_fmt(p, sizeof p, "%s/x", d); sy_mkdir(p, 0755);
        cx_fmt(inst, sizeof inst, "%s/inst", d); sy_mkdir(inst, 0700);
        cx_fmt(p, sizeof p, "%s/x/frag.cx", d); put(p, "int old;\n");
    }
    ok(badtable(d, "x/frag.cx\tfragment\t-\t-\tpiece\tme\t2026-11-17\n") == 0, "good-table-accepted");
    ok(badtable(d, "x/nothere.cx\tfragment\t-\t-\tpiece\tme\t2026-11-17\n") > 0, "missing-path-refused");
    ok(badtable(d, "x/frag.cx\tbogus\t-\t-\tpiece\tme\t2026-11-17\n") > 0, "unknown-kind-refused");
    ok(badtable(d, "x/frag.cx\tfragment\t-\t-\t-\tme\t2026-11-17\n") > 0, "missing-reason-refused");
    ok(badtable(d, "x/frag.cx\tfragment\t-\t-\tpiece\tme\t2026-11-17\nx/frag.cx\tfragment\t-\t-\tpiece\tme\t2026-11-17\n") > 0, "duplicate-path-refused");
    ok(badtable(d, "x/frag.cx\tfragment\t-\t-\tpiece\tme\n") > 0, "short-row-refused");
    badtable(d, "x/frag.cx\tfragment\t-\t-\tpiece\tme\t2026-11-17\nx/ctx.cx\tembedded-in\t-\ttest -s x/ctx.cx\tcmd\tme\t2026-11-17\n");
    cx_fmt(p, sizeof p, "%s/in.txt", d); put(p, "int f(void){ return undefined_sym; }\n");
    cx_fmt(log, sizeof log, "%s/log", d);
    {   char *a1[] = { "f", "write", "x/frag.cx", "--from", "in.txt", 0 };
        r = run_dv(d, inst, a1, log);
        ok(r == 0, "fragment-write-rc0");
        ok(has_line(log, "SKIPPED-compile\tx/frag.cx\tfragment\tpiece"), "fragment-skipped-line");
        ok(!has_line(log, "F\twrite\trefused-compile"), "fragment-not-refused-compile");
    }
    {   char *a2[] = { "f", "write", "x/ctx.cx", "--from", "in.txt", 0 };
        r = run_dv(d, inst, a2, log);
        ok(r == 0, "embedded-command-write-rc0");
        ok(has_line(log, "COMPILE-CONTEXT\tok\tx/ctx.cx\tembedded-in"), "embedded-command-ok-line");
    }
    {   char *a3[] = { "f", "write", "x/bad.cx", "--from", "in.txt", 0 };
        r = run_dv(d, inst, a3, log);
        ok(r != 0, "unlisted-bad-cx-rc-nonzero");
        ok(has_line(log, "F\twrite\trefused-compile"), "unlisted-bad-cx-refused-compile");
    }
    {   char *a4[] = { "config", 0 };
        r = run_dv(d, inst, a4, log);
        ok(r == 0 && has_line(log, "CFG\tcompilectx\tx/frag.cx\tfragment"), "config-shows-table");
        ok(has_line(log, "CFG\tcompilectx_table\tbuild/devsvc-compile-context.tsv\trows=2"), "config-row-count");
    }
    {   /* Multi-file compile context gate for file.edit:
         * (1) co-compiled file without context row is refused on standalone compile;
         * (2) with multi-file compile context row (-DTEST_CO_HOST + x/host_main.cx + x/co_part.cx), file.edit passes;
         * (3) when a partner file in host column is missing on disk, table validation and file.edit refuse with named ECTX. */
        char edit_args[4600];
        ff_out fo;
        cx_fmt(p, sizeof p, "%s/x/host_main.cx", d);
        put(p, "#ifdef TEST_CO_HOST\nint host_helper(int v) { return v + 7; }\n#endif\nint main(void) { return 0; }\n");
        cx_fmt(p, sizeof p, "%s/x/co_part.cx", d); sy_unlink(p);
        put(p, "int host_helper(int v);\n#ifndef TEST_CO_HOST\nint broken = missing_host_macro;\n#endif\nint co_entry(int a) { return host_helper(a); }\n");
        badtable(d, "x/frag.cx\tfragment\t-\t-\tpiece\tme\t2026-11-17\n");
        cx_fmt(edit_args, sizeof edit_args, "root=%s;path=x/co_part.cx;old=return host_helper(a)%%3B;new=return host_helper(a + 1)%%3B", d);
        r = ff_run("file.edit", edit_args, &fo);
        ok(r != 0 && tx_eqz(fo.err, "ECOMPILE"), "unlisted-cocompile-file-edit-refused");
        ff_out_free(&fo);
        ok(badtable(d, "x/co_part.cx\tembedded-in\tx/host_main.cx\tsh ./unisacc.com -DTEST_CO_HOST x/host_main.cx x/co_part.cx -o \"$1/co.bin\"\tcocompile\tme\t2026-11-21\n") == 0,
           "cocompile-table-valid");
        r = ff_run("file.edit", edit_args, &fo);
        ok(r == 0 && fo.ccnote == 4 && tx_find(fo.ccmsg, tx_len(fo.ccmsg, sizeof fo.ccmsg), "COMPILE-CONTEXT\tok\tx/co_part.cx\tembedded-in", 43) >= 0,
           "listed-cocompile-file-edit-passes");
        ff_out_free(&fo);
        cx_fmt(p, sizeof p, "%s/x/co_part.cx", d); sy_unlink(p);
        put(p, "int host_helper(int v);\n#ifndef TEST_CO_HOST\nint broken = missing_host_macro;\n#endif\nint co_entry(int a) { return host_helper(a); }\n");
        ok(badtable(d, "x/co_part.cx\tembedded-in\tx/host_main.cx,x/missing_partner.cx\tsh ./unisacc.com -DTEST_CO_HOST x/host_main.cx x/co_part.cx -o \"$1/co.bin\"\tcocompile\tme\t2026-11-21\n") > 0,
           "missing-context-partner-table-refused");
        r = ff_run("file.edit", edit_args, &fo);
        ok(r != 0 && tx_eqz(fo.err, "ECTX") &&
           tx_find(fo.why, tx_len(fo.why, sizeof fo.why), "x/missing_partner.cx", 20) >= 0,
           "missing-context-partner-file-edit-named-refusal");
        ff_out_free(&fo);
    }
    {   /* nested-inheritance rule, both directions: marked outer root is dropped in the scratch root; same repo keeps it; unmarked root is kept */
        char t1[4400], t2[4400];
        cx_fmt(t1, sizeof t1, "test \"$UNISACC_FLOW_ROOT\" = '%s' && test \"$UNISACC_FLOW_ROOT_JOB\" = '%s'", d, d);
        cx_fmt(t2, sizeof t2, "test \"$UNISACC_FLOW_ROOT\" = '%s'", g_outer);
        {   char *a5[] = { "x", "--par", "1", "--timeout-ms", "20000", "--", "sh", "-c", t1, 0 };
            r = run_dv(d, inst, a5, log); ok(r == 0, "nested-scratch-root-drops-marked-outer-root"); }
        {   char *a6[] = { "x", "--par", "1", "--timeout-ms", "20000", "--", "sh", "-c", t2, 0 };
            r = run_dv(g_outer, inst, a6, log); ok(r == 0, "nested-same-repo-inherits-outer-root"); }
        g_nomark = 1;
        {   char *a7[] = { "x", "--par", "1", "--timeout-ms", "20000", "--", "sh", "-c", t2, 0 };
            r = run_dv(d, inst, a7, log); ok(r == 0, "unmarked-explicit-root-kept"); }
        g_nomark = 0;
    }
    printf("NOTE\tscratch-root-left\t%s\n", d);   /* not removed: it holds symlinks into the repo */
    printf("CHECK_DEVSVC_COMPILE_CONTEXT\tfailed=%d\tasserts=%d\n", fails, asserts);
    return fails ? 1 : 0;
}
