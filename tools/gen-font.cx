/* tools/gen-font.cx -- 5x7 点阵权威源. 生成 font5x7.tsv 与 font5x7.js.
 * sh ./unisacc.com tools/gen-font.cx -- [--write] [--check]
 */
static unsigned char col[64][5];
static char chs[64];
static int nch;
static void add(char c, int a, int b, int d, int e, int f) {
    chs[nch] = c;
    col[nch][0] = (unsigned char)a;
    col[nch][1] = (unsigned char)b;
    col[nch][2] = (unsigned char)d;
    col[nch][3] = (unsigned char)e;
    col[nch][4] = (unsigned char)f;
    nch++;
}
static void load(void) {
    add(' ', 0x00, 0x00, 0x00, 0x00, 0x00);
    add('.', 0x00, 0x60, 0x60, 0x00, 0x00);
    add(':', 0x00, 0x36, 0x36, 0x00, 0x00);
    add('-', 0x08, 0x08, 0x08, 0x08, 0x08);
    add('/', 0x20, 0x10, 0x08, 0x04, 0x02);
    add('%', 0x23, 0x13, 0x08, 0x64, 0x62);
    add('0', 0x3E, 0x41, 0x41, 0x41, 0x3E);
    add('1', 0x00, 0x42, 0x7F, 0x40, 0x00);
    add('2', 0x42, 0x61, 0x51, 0x49, 0x46);
    add('3', 0x21, 0x41, 0x45, 0x4B, 0x31);
    add('4', 0x18, 0x14, 0x12, 0x7F, 0x10);
    add('5', 0x27, 0x45, 0x45, 0x45, 0x39);
    add('6', 0x3C, 0x4A, 0x49, 0x49, 0x30);
    add('7', 0x01, 0x71, 0x09, 0x05, 0x03);
    add('8', 0x36, 0x49, 0x49, 0x49, 0x36);
    add('9', 0x06, 0x49, 0x49, 0x29, 0x1E);
    add('A', 0x7E, 0x09, 0x09, 0x09, 0x7E);
    add('B', 0x7F, 0x49, 0x49, 0x49, 0x36);
    add('C', 0x3E, 0x41, 0x41, 0x41, 0x22);
    add('D', 0x7F, 0x41, 0x41, 0x22, 0x1C);
    add('E', 0x7F, 0x49, 0x49, 0x49, 0x41);
    add('F', 0x7F, 0x09, 0x09, 0x09, 0x01);
    add('G', 0x3E, 0x41, 0x49, 0x49, 0x7A);
    add('H', 0x7F, 0x08, 0x08, 0x08, 0x7F);
    add('I', 0x00, 0x41, 0x7F, 0x41, 0x00);
    add('J', 0x20, 0x40, 0x41, 0x3F, 0x01);
    add('K', 0x7F, 0x08, 0x14, 0x22, 0x41);
    add('L', 0x7F, 0x40, 0x40, 0x40, 0x40);
    add('M', 0x7F, 0x02, 0x0C, 0x02, 0x7F);
    add('N', 0x7F, 0x04, 0x08, 0x10, 0x7F);
    add('O', 0x3E, 0x41, 0x41, 0x41, 0x3E);
    add('P', 0x7F, 0x09, 0x09, 0x09, 0x06);
    add('Q', 0x3E, 0x41, 0x51, 0x21, 0x5E);
    add('R', 0x7F, 0x09, 0x19, 0x29, 0x46);
    add('S', 0x46, 0x49, 0x49, 0x49, 0x31);
    add('T', 0x01, 0x01, 0x7F, 0x01, 0x01);
    add('U', 0x3F, 0x40, 0x40, 0x40, 0x3F);
    add('V', 0x1F, 0x20, 0x40, 0x20, 0x1F);
    add('W', 0x7F, 0x20, 0x18, 0x20, 0x7F);
    add('X', 0x63, 0x14, 0x08, 0x14, 0x63);
    add('Y', 0x07, 0x08, 0x70, 0x08, 0x07);
    add('Z', 0x61, 0x51, 0x49, 0x45, 0x43);
}

static void putn(char *buf, int *k, int v) {
    char rev[8]; int rn = 0, t;
    if (v == 0) { buf[(*k)++] = '0'; return; }
    while (v) { rev[rn++] = (char)('0' + v % 10); v /= 10; }
    while (rn) buf[(*k)++] = rev[--rn];
}
static void emit_tsv(char *buf, int *n) {
    int i, j, k = 0;
    const char *h = "ch\tc0\tc1\tc2\tc3\tc4\n";
    while (h[k]) { buf[k] = h[k]; k++; }
    for (i = 0; i < nch; i++) {
        buf[k++] = chs[i];
        buf[k++] = '\t';
        for (j = 0; j < 5; j++) {
            putn(buf, &k, col[i][j]);
            buf[k++] = (j == 4) ? '\n' : '\t';
        }
    }
    buf[k] = 0;
    *n = k;
}
static void emit_js(char *buf, int *n) {
    int i, j, k = 0;
    const char *h = "/* GENERATED by tools/gen-font.cx. Do not edit. */\nexport const FONT_W = 5;\nexport const FONT_H = 7;\nexport const FONT = {\n";
    while (h[k]) { buf[k] = h[k]; k++; }
    for (i = 0; i < nch; i++) {
        buf[k++] = ' ';
        buf[k++] = ' ';
        if (chs[i] >= 'A' && chs[i] <= 'Z') buf[k++] = chs[i];
        else { buf[k++] = '"'; buf[k++] = chs[i]; buf[k++] = '"'; }
        buf[k++] = ':';
        buf[k++] = ' ';
        buf[k++] = '[';
        for (j = 0; j < 5; j++) {
            putn(buf, &k, col[i][j]);
            if (j < 4) { buf[k++] = ','; buf[k++] = ' '; }
        }
        buf[k++] = ']';
        buf[k++] = ',';
        buf[k++] = '\n';
    }
    buf[k++] = '}';
    buf[k++] = ';';
    buf[k++] = '\n';
    buf[k] = 0;
    *n = k;
}
static int same_file(const char *path, const char *gen, int gn) {
    char disk[4096];
    int dn;
    FILE *f = fopen(path, "rb");
    if (!f) return 0;
    dn = (int)fread(disk, 1, sizeof disk - 1, f);
    fclose(f);
    return dn == gn && memcmp(disk, gen, gn) == 0;
}
int main(int argc, char **argv) {
    int write = 0, check = 0, i, j, tn = 0, jn = 0;
    char tsv[2048], js[4096];
    FILE *f;
    load();
    for (i = 1; i < argc; i++) {
        if (argv[i][0] == '-' && argv[i][1] == '-' && argv[i][2] == 'w') write = 1;
        if (argv[i][0] == '-' && argv[i][1] == '-' && argv[i][2] == 'c') check = 1;
    }
    emit_tsv(tsv, &tn);
    emit_js(js, &jn);
    printf("FONT\tn=%d\tw=5\th=7\n", nch);
    for (i = 0; i < nch; i++) {
        printf("GLYPH\t%c", chs[i]);
        for (j = 0; j < 5; j++) printf("\t%d", col[i][j]);
        printf("\n");
    }
    if (write) {
        f = fopen("ujs/practice/uxe/test/font5x7.tsv", "wb");
        if (!f) return 2;
        fwrite(tsv, 1, tn, f);
        fclose(f);
        f = fopen("ujs/practice/uxe/font5x7.js", "wb");
        if (!f) return 2;
        fwrite(js, 1, jn, f);
        fclose(f);
    }
    if (check) {
        if (!same_file("ujs/practice/uxe/test/font5x7.tsv", tsv, tn)) {
            printf("FONT_CHECK\tDIFF\ttsv\n");
            return 1;
        }
        if (!same_file("ujs/practice/uxe/font5x7.js", js, jn)) {
            printf("FONT_CHECK\tDIFF\tjs\n");
            return 1;
        }
        printf("FONT_CHECK\tok\n");
    }
    return 0;
}
