/* tools/gen-font.cx -- 5x7 点阵(自绘,无外部字体许可).
 * sh ./unisacc.com tools/gen-font.cx -- [--write] [--check]
 */
static unsigned char col[64][5];
static char chs[64];
static int nch;
static void add(char c, int a, int b, int d, int e, int f) {
    chs[nch] = c;
    col[nch][0] = (unsigned char)a;
    col[nch][1] = (unsigned char)b;
    col[nch][2] = (unsigned char)d;
    col[nch][3] = (unsigned char)e;
    col[nch][4] = (unsigned char)f;
    nch++;
}
static void load(void) {
    add('0', 0x3E, 0x41, 0x41, 0x41, 0x3E);
    add('1', 0x00, 0x42, 0x7F, 0x40, 0x00);
    add('A', 0x7E, 0x09, 0x09, 0x09, 0x7E);
    add('I', 0x00, 0x41, 0x7F, 0x41, 0x00);
}
static void emit(char *buf, int *n) {
    int i, j, k = 0;
    const char *h = "ch\tc0\tc1\tc2\tc3\tc4\n";
    while (h[k]) { buf[k] = h[k]; k++; }
    for (i = 0; i < nch; i++) {
        buf[k++] = chs[i];
        buf[k++] = '\t';
        for (j = 0; j < 5; j++) {
            int v = col[i][j];
            char tmp[8];
            int t = 0, r;
            if (v == 0) tmp[t++] = '0';
            else {
                char rev[8]; int rn = 0;
                while (v) { rev[rn++] = (char)('0' + v % 10); v /= 10; }
                while (rn) tmp[t++] = rev[--rn];
            }
            for (r = 0; r < t; r++) buf[k++] = tmp[r];
            buf[k++] = (j == 4) ? '\n' : '\t';
        }
    }
    buf[k] = 0;
    *n = k;
}
int main(int argc, char **argv) {
    int write = 0, check = 0, i, j, gn = 0, dn = 0;
    char gen[2048], disk[2048];
    FILE *f;
    load();
    for (i = 1; i < argc; i++) {
        if (argv[i][0] == '-' && argv[i][1] == '-' && argv[i][2] == 'w') write = 1;
        if (argv[i][0] == '-' && argv[i][1] == '-' && argv[i][2] == 'c') check = 1;
    }
    emit(gen, &gn);
    printf("FONT\tn=%d\tw=5\th=7\n", nch);
    for (i = 0; i < nch; i++) {
        printf("GLYPH\t%c", chs[i]);
        for (j = 0; j < 5; j++) printf("\t%d", col[i][j]);
        printf("\n");
    }
    if (write) {
        f = fopen("ujs/practice/uxe/test/font5x7.tsv", "wb");
        if (!f) return 2;
        fwrite(gen, 1, gn, f);
        fclose(f);
    }
    if (check) {
        f = fopen("ujs/practice/uxe/test/font5x7.tsv", "rb");
        if (!f) { printf("FONT_CHECK\tmissing\n"); return 1; }
        dn = (int)fread(disk, 1, sizeof disk - 1, f);
        fclose(f);
        disk[dn] = 0;
        if (dn != gn || memcmp(disk, gen, gn) != 0) {
            printf("FONT_CHECK\tDIFF\n");
            return 1;
        }
        printf("FONT_CHECK\tok\n");
    }
    return 0;
}
