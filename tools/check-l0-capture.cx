/* tools/check-l0-capture.cx -- cx/sys/proc.cx sy_proc_capture (plans/v0.0.94.md 七、八).
     sh ./unisacc.com tools/check-l0-capture.cx
   Linux with real children and /proc.  C1 both streams complete; C2 over cap gives
   -EMSGSIZE with exactly CAP bytes kept and no child left; C2b exactly CAP succeeds and
   CAP+1 is -EMSGSIZE (the boundary a `>` -> `>=` mutation moves); C3 a deadline gives
   -ETIMEDOUT with st.timed_out and no child left; C4 a stream far past the 64 KiB pipe
   capacity does not deadlock; C5 no descriptor leaks (before/after /proc/self/fd count).
   C6-C8 the read order (wait on stdout, then zero-wait stderr) under one-sided and
   alternating writes past the pipe capacity; C9 the deadline stays accurate while one
   stream is silent (allowed window 250..2000 ms for a 300 ms deadline).
   Prints PASS/FAIL lines and CHECK_L0_CAPTURE<TAB>ok=N<TAB>failed=M; exit 1 on any FAIL.
   Mutation self-proof (measured, one edit each to cx/sys/proc.cx, rerun): deleting the cap
   clamp -> c2-rc, c2-err-exact-cap, c2b-over-by-one-rc, c2b-over-by-one-len red; `>` -> `>=`
   -> c2b-exact-cap-rc red; removing the deadline branch -> c3-rc, c3-timed-out-flag,
   c3-wall-under-2s red; commenting out the stderr zero-wait read -> the whole run hangs and
   the 20 s outer bound fires (rc 124), i.e. C6 never finishes.  Unmodified: all 45 pass. */
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.time
#pragma unisa use mem.grow
#pragma unisa use text.text

static int nok, nfail;
static void ck(int c, const char *name) {
    printf("%s\tcapture.%s\n", c ? "PASS" : "FAIL", name);
    if (c) nok++; else nfail++;
}
static void ckv(long got, long want, const char *name) {
    if (got != want) printf("NOTE\tcapture.%s\tgot=%ld\twant=%ld\n", name, got, want);
    ck(got == want, name);
}

/* Open descriptors of this process; -1 when /proc is not there. */
static int open_fd_count(void) {
    sy_dir_t d; int n = 0;
    if (sy_dir_open(&d, "/proc/self/fd") != 0) return -1;
    while (sy_dir_next(&d) == 1) n++;
    sy_dir_close(&d);
    return n;
}
/* 1 when PID still has a /proc entry (live or zombie), 0 when it is gone. */
static int proc_alive(int pid) {
    char p[64];
    unsigned char *d = 0;
    int64_t n = 0;
    if (pid <= 0) return 0;
    if (snprintf(p, sizeof p, "/proc/%d/stat", pid) <= 0) return 0;
    return sy_read_file(p, &d, &n, 4096) == 0 && n > 0;
}


/* No live or zombie child left: /proc/PID/task/PID/children is empty. */
static int nochild(void) {
    char p[64], dg[16];
    unsigned char *d = 0;
    int64_t n = 0;
    int pid = sy_pid(), k = 0, i, nd = 0;
    const char *a = "/proc/", *b = "/task/", *c = "/children";
    while (pid > 0) { dg[nd++] = (char)('0' + pid % 10); pid /= 10; }
    for (i = 0; a[i]; i++) p[k++] = a[i];
    for (i = nd; i > 0; i--) p[k++] = dg[i - 1];
    for (i = 0; b[i]; i++) p[k++] = b[i];
    for (i = nd; i > 0; i--) p[k++] = dg[i - 1];
    for (i = 0; c[i]; i++) p[k++] = c[i];
    p[k] = 0;
    if (sy_read_file(p, &d, &n, 4096) != 0) return 0;
    return n == 0 || (n == 1 && d[0] == ' ');
}

static int run1(const char *script, long cap_bytes, long dl, int split,
                sy_capture_t *cap, sy_exit_t *st) {
    char *a[4];
    sy_spawn_t o;
    a[0] = "sh"; a[1] = "-c"; a[2] = (char *)script; a[3] = 0;
    sy_spawn_init(&o);
    o.argv = a;
    o.deadline_ms = dl;
    mg_init(&cap->out); mg_init(&cap->err); cap->split = split;
    return sy_proc_capture(&o, st, cap, cap_bytes);
}

int main(int argc, char **argv) {
    int f0 = open_fd_count();
    (void)argc; (void)argv;

    /* C1: 256 KiB on stderr, "out\n" on stdout, both complete and byte-correct. */
    {
        sy_capture_t cap; sy_exit_t st;
        int r = run1("head -c 262144 /dev/zero >&2; printf 'out\\n'", 1 << 20, 0, 1, &cap, &st);
        long j, nz = 0;
        for (j = 0; j < cap.err.len; j++) if (cap.err.data[j]) nz++;
        ckv(r, 0, "c1-rc");
        ck(st.exited && st.code == 0 && !st.timed_out, "c1-status");
        ckv(cap.out.len, 4, "c1-out-len");
        ck(cap.out.len == 4 && !memcmp(cap.out.data, "out\n", 4), "c1-out-bytes");
        ckv(cap.err.len, 262144, "c1-err-len");
        ckv(nz, 0, "c1-err-all-zero");
        mg_free(&cap.out); mg_free(&cap.err);
        ck(nochild(), "c1-no-child");
    }

    /* C2b: exactly CAP bytes succeeds; one byte over is -EMSGSIZE.  This is the boundary a
       `>` -> `>=` mutation moves, which the far-over-cap case above cannot see. */
    {
        sy_capture_t cap; sy_exit_t st;
        int r = run1("head -c 4096 /dev/zero >&2", 4096, 0, 1, &cap, &st);
        ckv(r, 0, "c2b-exact-cap-rc");
        ckv(cap.err.len, 4096, "c2b-exact-cap-len");
        mg_free(&cap.out); mg_free(&cap.err);
        ck(nochild(), "c2b-no-child");
    }
    {
        sy_capture_t cap; sy_exit_t st;
        int r = run1("head -c 4097 /dev/zero >&2", 4096, 0, 1, &cap, &st);
        ckv(r, -EMSGSIZE, "c2b-over-by-one-rc");
        ckv(cap.err.len, 4096, "c2b-over-by-one-len");
        mg_free(&cap.out); mg_free(&cap.err);
        ck(nochild(), "c2b-over-no-child");
    }


    {
        sy_capture_t cap; sy_exit_t st;
        int r = run1("head -c 100000 /dev/zero >&2; printf 'xxxxxxxxxx'", 1000, 0, 1, &cap, &st);
        ckv(r, -EMSGSIZE, "c2-rc");
        ckv(cap.err.len, 1000, "c2-err-exact-cap");
        ck(cap.out.len <= 10, "c2-out-under-cap");
        mg_free(&cap.out); mg_free(&cap.err);
        ck(nochild(), "c2-no-child");
    }

    /* C3: a deadline gives -ETIMEDOUT with the flag, soon after the deadline. */
    {
        sy_capture_t cap; sy_exit_t st;
        long t0 = sy_now_ms();
        int r = run1("sleep 5", 1 << 20, 300, 1, &cap, &st);
        long ms = sy_now_ms() - t0;
        ckv(r, -ETIMEDOUT, "c3-rc");
        ckv(st.timed_out, 1, "c3-timed-out-flag");
        ck(ms < 2000, "c3-wall-under-2s");
        mg_free(&cap.out); mg_free(&cap.err);
        ck(nochild(), "c3-no-child");
    }

    /* C4: 200 KiB on one stream with no deadline -- far past a 64 KiB pipe -- must not hang. */
    {
        sy_capture_t cap; sy_exit_t st;
        int r = run1("head -c 200000 /dev/zero >&2; printf 'ok'", 1 << 20, 0, 1, &cap, &st);
        ckv(r, 0, "c4-rc");
        ckv(cap.out.len, 2, "c4-out-len");
        ckv(cap.err.len, 200000, "c4-err-len");
        mg_free(&cap.out); mg_free(&cap.err);
        ck(nochild(), "c4-no-child");
    }

    /* C6: only stderr writes, 256 KiB, stdout silent.  The read loop waits on stdout first
       and only then zero-waits stderr, so this is the case that would deadlock if the
       stderr read were dropped or made blocking. */
    {
        sy_capture_t cap; sy_exit_t st;
        long t0 = sy_now_ms();
        int r = run1("head -c 262144 /dev/zero >&2", 1 << 20, 5000, 1, &cap, &st);
        long ms = sy_now_ms() - t0;
        ckv(r, 0, "c6-rc");
        ckv(cap.out.len, 0, "c6-out-len");
        ckv(cap.err.len, 262144, "c6-err-len");
        ck(ms < 4000, "c6-no-deadlock");
        mg_free(&cap.out); mg_free(&cap.err);
        ck(nochild(), "c6-no-child");
    }
    /* C7: the reverse -- only stdout writes 256 KiB, stderr silent. */
    {
        sy_capture_t cap; sy_exit_t st;
        long t0 = sy_now_ms();
        int r = run1("head -c 262144 /dev/zero", 1 << 20, 5000, 1, &cap, &st);
        long ms = sy_now_ms() - t0;
        ckv(r, 0, "c7-rc");
        ckv(cap.out.len, 262144, "c7-out-len");
        ckv(cap.err.len, 0, "c7-err-len");
        ck(ms < 4000, "c7-no-deadlock");
        mg_free(&cap.out); mg_free(&cap.err);
        ck(nochild(), "c7-no-child");
    }
    /* C8: both streams alternate and each writes past the 64 KiB pipe capacity. */
    {
        sy_capture_t cap; sy_exit_t st;
        long t0 = sy_now_ms();
        int r = run1("i=0; while [ $i -lt 64 ]; do head -c 4096 /dev/zero; head -c 4096 /dev/zero >&2; i=$((i+1)); done", 1 << 20, 5000, 1, &cap, &st);
        long ms = sy_now_ms() - t0;
        ckv(r, 0, "c8-rc");
        ckv(cap.out.len, 262144, "c8-out-len");
        ckv(cap.err.len, 262144, "c8-err-len");
        ck(ms < 4000, "c8-no-deadlock");
        mg_free(&cap.out); mg_free(&cap.err);
        ck(nochild(), "c8-no-child");
    }
    /* C9: the deadline stays accurate while one stream is silent: stderr-only writer with a
       deadline it outlives returns -ETIMEDOUT close to the deadline, not later. */
    {
        sy_capture_t cap; sy_exit_t st;
        long t0 = sy_now_ms();
        int r = run1("head -c 4096 /dev/zero >&2; sleep 5", 1 << 20, 300, 1, &cap, &st);
        long ms = sy_now_ms() - t0;
        ckv(r, -ETIMEDOUT, "c9-rc");
        ckv(st.timed_out, 1, "c9-timed-out-flag");
        ck(ms >= 250 && ms < 2000, "c9-deadline-on-time");
        mg_free(&cap.out); mg_free(&cap.err);
        ck(nochild(), "c9-no-child");
    }

    {
        int f1 = open_fd_count();
        if (f0 < 0 || f1 < 0) printf("NOTE\tcapture.c5\tfds-unknown\tf0=%d\tf1=%d\n", f0, f1);
        else ckv(f1, f0, "c5-fd-count");
    }

    /* C10 (Z3 复核 1): a leader that exits while a same-group descendant holds the pipes.
       At the deadline the descendant must be gone -- the group kill uses the saved pgid, and
       the leader is not reaped before the group work is done. */
    {
        sy_capture_t cap; sy_exit_t st;
        int r, pid = 0; long i;
        r = run1("sleep 43 & echo $!", 1 << 20, 500, 1, &cap, &st);
        for (i = 0; i < cap.out.len; i++) { unsigned char ch = cap.out.data[i]; if (ch >= '0' && ch <= '9') pid = pid * 10 + (ch - '0'); }
        ckv(r, -ETIMEDOUT, "c10-rc");
        ck(pid > 0, "c10-descendant-pid-read");
        sy_sleep_ms(300);
        ck(pid > 0 && !proc_alive(pid), "c10-descendant-killed");
        mg_free(&cap.out); mg_free(&cap.err);
    }
    /* C11 (Z3 复核 2): stderr alone at 4 MiB must not be rate-limited by a silent stdout.
       The bound is generous for slow hosts but far below the 12.7 s the sequential loop took. */
    {
        sy_capture_t cap; sy_exit_t st;
        long t0 = sy_now_ms();
        int r = run1("head -c 4194304 /dev/zero >&2", 8 << 20, 0, 1, &cap, &st);
        long ms = sy_now_ms() - t0;
        ckv(r, 0, "c11-rc");
        ckv(cap.err.len, 4194304, "c11-err-len");
        ck(ms < 2000, "c11-under-2s");
        mg_free(&cap.out); mg_free(&cap.err);
    }
    /* C12 (Z3 复核 3): the child must not inherit the capture pipe ends.  Proved from inside
       the child: it lists its own /proc/self/fd and the output must show no descriptor above 2
       pointing at a pipe besides the listing's own /proc fd.  A cursor leak would appear here
       as extra pipe fds. */
    {
        sy_capture_t cap; sy_exit_t st, st2;
        int r = run1("ls -l /proc/self/fd", 1 << 20, 0, 1, &cap, &st);
        long i, pipes = 0;
        ckv(r, 0, "c12-rc");
        /* count "-> pipe:[" occurrences beyond the expected 1 and 2 */
        for (i = 0; i + 6 < cap.out.len; i++)
            if (!memcmp(cap.out.data + i, "-> pipe:", 8)) pipes++;
        ckv(pipes, 2, "c12-only-stdout-and-stderr-are-pipes");
        mg_free(&cap.out); mg_free(&cap.err);
        (void)st2;
    }
    /* C13 (Z3 复核 4): streams closed early must not busy-wait nor lose the deadline: the
       call returns at the deadline, not after the child's own long sleep. */
    {
        sy_capture_t cap; sy_exit_t st;
        long t0 = sy_now_ms();
        int r = run1("exec 1>&- 2>&-; sleep 5", 1 << 20, 300, 1, &cap, &st);
        long ms = sy_now_ms() - t0;
        ckv(r, -ETIMEDOUT, "c13-rc");
        ck(st.timed_out == 1, "c13-timed-out-flag");
        ck(ms >= 250 && ms < 1500, "c13-deadline-kept-on-closed-streams");
        mg_free(&cap.out); mg_free(&cap.err);
        ck(nochild(), "c13-no-child");
    }

    /* C14 (Z5 blocking item, cc review 2026-11-22): the leader exits at once while a same-group
       descendant holds the pipes, and the deadline expires.  A REAPED leader must not make the
       group kill a no-op: the descendant has to be gone.  Pre-fix the tree gave desc_alive=1. */
    {
        sy_capture_t cap; sy_exit_t st;
        int r, pid = 0; long i;
        r = run1("sleep 43 & echo $!; exit 0", 1 << 20, 400, 1, &cap, &st);
        for (i = 0; i < cap.out.len; i++) { unsigned char dg2 = cap.out.data[i]; if (dg2 >= 48 && dg2 <= 57) pid = pid * 10 + (dg2 - 48); }
        ckv(r, -ETIMEDOUT, "c14-rc");
        ck(pid > 0, "c14-descendant-pid-read");
        sy_sleep_ms(300);
        ck(pid > 0 && !proc_alive(pid), "c14-descendant-killed-after-leader-reaped");
        if (pid > 0 && proc_alive(pid)) sy_kill(pid);
        mg_free(&cap.out); mg_free(&cap.err);
    }
    /* C15 (Z5 timeout flag): a timed-out wait must keep timed_out in the handle, so a second
       wait (which answers from the kept status) reports it too. */
    {
        char *v[4]; sy_spawn_t o; sy_child_t c; sy_exit_t st1, st2;
        v[0] = "sh"; v[1] = "-c"; v[2] = "sleep 5"; v[3] = 0;
        sy_spawn_init(&o); o.argv = v; o.deadline_ms = 200;
        ck(sy_proc_spawn(&o, &c) == 0, "c15-spawn");
        ck(sy_proc_wait(&c, &st1) == 0 && st1.timed_out == 1, "c15-first-timed-out");
        st2 = st1; st2.timed_out = 0;
        ck(sy_proc_wait(&c, &st2) == 0 && st2.timed_out == 1, "c15-second-keeps-timed-out");
        sy_proc_close(&c);
    }

    printf("CHECK_L0_CAPTURE\tok=%d\tfailed=%d\n", nok, nfail);
    return nfail ? 1 : 0;
}
