/* tools/tapeslice-gen.cx -- T0.1 generator for tools/tape/facts/tapeslice-container.tsv + hoststub-slots.tsv -> tools/tape/tapeslice_contract.cx.
 * Usage:
 *   sh ./unisacc.com tools/tapeslice-gen.cx -- --check
 *   sh ./unisacc.com tools/tapeslice-gen.cx -- --write
 */
#pragma unisa use sys.io
#pragma unisa use text.text
#pragma unisa use mem.bytes

#define TSV_PATH "tools/tape/facts/tapeslice-container.tsv"
#define HOST_TSV_PATH "tools/tape/facts/hoststub-slots.tsv"
#define OUT_PATH "tools/tape/tapeslice_contract.cx"
#define MAX_ROWS 48
#define HOST_SLOTS 37
#define GENCAP 65536

typedef struct {
    char field[32];
    int off;
    int size;
    char kind[16];
    char value[48];
    char check[256];
} TsRow;

static TsRow g_rows[MAX_ROWS];
static int g_nrows = 0;
static int g_total_bytes = 0;
static char g_host_ops[HOST_SLOTS][32];
static int g_host_seen[HOST_SLOTS];
static unsigned long long g_m1_mask = 0;

static int fail(const char *why) {
    sy_eprintf("tapeslice-gen\tFAIL\t%s\n", why);
    return 1;
}

static int parse_nonneg(const char *s, int n, int *out) {
    int i = 0, v = 0;
    if (n <= 0 || n > 9) return -1;
    for (i = 0; i < n; i++) {
        if (s[i] < '0' || s[i] > '9') return -1;
        v = v * 10 + (s[i] - '0');
    }
    *out = v;
    return 0;
}

static int valid_kind(const char *k) {
    return tx_eqz(k, "magic") || tx_eqz(k, "u16") || tx_eqz(k, "u32") ||
           tx_eqz(k, "u64") || tx_eqz(k, "sha256") || tx_eqz(k, "tag");
}

static int copy_slice(char *dst, int cap, const char *src, int n) {
    int i;
    if (n <= 0 || n >= cap) return -1;
    for (i = 0; i < n; i++) dst[i] = src[i];
    dst[n] = 0;
    return 0;
}

static int take_row(const char *line, int n) {
    int t[5], nt = 0, i;
    if (g_nrows >= MAX_ROWS) return fail("too-many-rows");
    for (i = 0; i < n; i++) {
        if (line[i] == '\t') {
            if (nt >= 5) return fail("too-many-cols");
            t[nt++] = i;
        }
    }
    if (nt != 5) return fail("need-6-cols");
    TsRow *r = &g_rows[g_nrows];
    if (copy_slice(r->field, (int)sizeof r->field, line, t[0])) return fail("bad-field");
    if (parse_nonneg(line + t[0] + 1, t[1] - t[0] - 1, &r->off)) return fail("bad-off");
    if (parse_nonneg(line + t[1] + 1, t[2] - t[1] - 1, &r->size) || r->size <= 0) return fail("bad-size");
    if (copy_slice(r->kind, (int)sizeof r->kind, line + t[2] + 1, t[3] - t[2] - 1)) return fail("bad-kind");
    if (!valid_kind(r->kind)) return fail("unknown-kind");
    if (copy_slice(r->value, (int)sizeof r->value, line + t[3] + 1, t[4] - t[3] - 1)) return fail("bad-value");
    if (copy_slice(r->check, (int)sizeof r->check, line + t[4] + 1, n - t[4] - 1)) return fail("bad-check");
    g_nrows++;
    return 0;
}

static int check_row_val(int idx, const char *field, int off, int size, const char *val) {
    const TsRow *r;
    if (idx < 0 || idx >= g_nrows) return -1;
    r = &g_rows[idx];
    if (!tx_eqz(r->field, field)) return -1;
    if (off >= 0 && r->off != off) return -1;
    if (size > 0 && r->size != size) return -1;
    if (val && !tx_eqz(r->value, val)) return -1;
    return 0;
}

static int parse_tsv(char *b, size_t n) {
    static const char *sect_fields[6] = {
        "sect_code_tag", "sect_data_tag", "sect_bssz_tag",
        "sect_syms_tag", "sect_relo_tag", "sect_host_tag"
    };
    static const char *sect_vals[6] = {
        "CODE", "DATA", "BSSZ", "SYMS", "RELO", "HOST"
    };
    size_t i = 0;
    int saw_hdr = 0, expect_off = 0, r;
    if (n == 0 || b[n - 1] != '\n') return fail("tsv-newline");
    while (i < n) {
        size_t e = i;
        while (e < n && b[e] != '\n') e++;
        b[e] = 0;
        if (e == i) return fail("blank-line");
        if (b[i] == '#') {
            i = e + 1;
            continue;
        }
        if (!saw_hdr) {
            if (!tx_eqz(b + i, "field\toff\tsize\tkind\tvalue\tcheck")) return fail("bad-header");
            saw_hdr = 1;
        } else {
            if (take_row(b + i, (int)(e - i))) return 1;
        }
        i = e + 1;
    }
    if (g_nrows != 34) return fail("expected-34-rows");
    for (r = 0; r < g_nrows; r++) {
        if (g_rows[r].off != expect_off) return fail("non-contiguous-offset");
        expect_off += g_rows[r].size;
    }
    if (expect_off != 208) return fail("expected-208-byte-header-and-dir");
    g_total_bytes = expect_off;
    if (check_row_val(0, "magic", 0, 8, "UTAPEBIN")) return fail("bad-magic-row");
    if (check_row_val(1, "major", 8, 2, "1")) return fail("bad-major-row");
    if (check_row_val(2, "minor", 10, 2, "3")) return fail("bad-minor-row");
    if (check_row_val(3, "endian", 12, 2, "1")) return fail("bad-endian-row");
    if (check_row_val(6, "nsect", 20, 4, "6")) return fail("bad-nsect-row");
    if (check_row_val(7, "dir_off", 24, 4, "64")) return fail("bad-dir-off-row");
    if (check_row_val(8, "ident", 28, 32, 0)) return fail("bad-ident-row");
    if (check_row_val(9, "origin", 60, 4, 0)) return fail("bad-origin-row");
    for (r = 0; r < 6; r++) {
        if (check_row_val(10 + r * 4, sect_fields[r], 64 + r * 24, 4, sect_vals[r]))
            return fail("bad-sect-tag-row");
    }
    return 0;
}

static int parse_host_tsv(char *b, size_t n) {
    size_t i = 0;
    int saw_hdr = 0, count = 0, k;
    g_m1_mask = 0;
    for (k = 0; k < HOST_SLOTS; k++) {
        g_host_seen[k] = 0;
        g_host_ops[k][0] = 0;
    }
    if (n == 0 || b[n - 1] != '\n') return fail("host-tsv-newline");
    while (i < n) {
        size_t e = i;
        while (e < n && b[e] != '\n') e++;
        b[e] = 0;
        if (e == i) return fail("host-tsv-blank-line");
        if (b[i] == '#') {
            i = e + 1;
            continue;
        }
        if (!saw_hdr) {
            if (!tx_prefix(b + i, (long)(e - i), "slot\top\ttier\tstatus\t", 20))
                return fail("host-tsv-bad-header");
            saw_hdr = 1;
        } else {
            int t[4], nt = 0, slot = -1;
            int len = (int)(e - i);
            char tier[32], status[32];
            for (k = 0; k < len && nt < 4; k++) {
                if (b[i + k] == '\t') t[nt++] = k;
            }
            if (nt < 4) return fail("host-tsv-short-row");
            if (parse_nonneg(b + i, t[0], &slot)) return fail("host-tsv-bad-slot");
            if (slot < 0 || slot >= HOST_SLOTS) return fail("host-tsv-slot-range");
            if (g_host_seen[slot] || slot != count) return fail("host-tsv-slot-sequence");
            if (copy_slice(g_host_ops[slot], (int)sizeof g_host_ops[slot], b + i + t[0] + 1, t[1] - t[0] - 1))
                return fail("host-tsv-bad-op");
            if (copy_slice(tier, (int)sizeof tier, b + i + t[1] + 1, t[2] - t[1] - 1))
                return fail("host-tsv-bad-tier");
            if (copy_slice(status, (int)sizeof status, b + i + t[2] + 1, t[3] - t[2] - 1))
                return fail("host-tsv-bad-status");
            if (tx_eqz(tier, "m1_core") && tx_eqz(status, "frozen")) {
                g_m1_mask |= (1ull << slot);
            }
            g_host_seen[slot] = 1;
            count++;
        }
        i = e + 1;
    }
    if (count != HOST_SLOTS) return fail("host-tsv-expected-37-slots");
    if (g_m1_mask != 383ull) return fail("host-tsv-unexpected-m1-mask");
    return 0;
}

static int app(char *dst, int cap, int *n, const char *s) {
    int i = 0;
    while (s[i]) {
        if (*n + 1 >= cap) return -1;
        dst[*n] = s[i];
        *n += 1;
        i++;
    }
    dst[*n] = 0;
    return 0;
}

static int app_int(char *dst, int cap, int *n, int v) {
    char tmp[16];
    int i = 0, j;
    if (v < 0) return -1;
    if (v == 0) return app(dst, cap, n, "0");
    while (v > 0 && i < 15) {
        tmp[i++] = (char)('0' + (v % 10));
        v /= 10;
    }
    for (j = i - 1; j >= 0; j--) {
        char c[2];
        c[0] = tmp[j];
        c[1] = 0;
        if (app(dst, cap, n, c)) return -1;
    }
    return 0;
}

static int emit_contract(char *dst, int cap, int *n) {
    int i;
    *n = 0;
    dst[0] = 0;
    if (app(dst, cap, n, "#pragma unisa module tapeslice_contract\n")) return -1;
    if (app(dst, cap, n, "/* Generated by tools/tapeslice-gen.cx from tools/tape/facts/tapeslice-container.tsv and hoststub-slots.tsv -- do not edit. */\n")) return -1;
    if (app(dst, cap, n, "#pragma unisa use text.text\n#pragma unisa use mem.bytes\n#pragma unisa use mem.heap\n#pragma unisa use crypto.sha256\n\n")) return -1;
    if (app(dst, cap, n, "#define TS_MAGIC \"") || app(dst, cap, n, g_rows[0].value) || app(dst, cap, n, "\"\n")) return -1;
    if (app(dst, cap, n, "#define TS_MAJOR ") || app(dst, cap, n, g_rows[1].value) || app(dst, cap, n, "\n")) return -1;
    if (app(dst, cap, n, "#define TS_MINOR ") || app(dst, cap, n, g_rows[2].value) || app(dst, cap, n, "\n")) return -1;
    if (app(dst, cap, n, "#define TS_ENDIAN ") || app(dst, cap, n, g_rows[3].value) || app(dst, cap, n, "\n")) return -1;
    if (app(dst, cap, n, "#define TS_NSECT ") || app(dst, cap, n, g_rows[6].value) || app(dst, cap, n, "\n")) return -1;
    if (app(dst, cap, n, "#define TS_DIR_OFF ") || app(dst, cap, n, g_rows[7].value) || app(dst, cap, n, "\n")) return -1;
    if (app(dst, cap, n, "#define TS_IDENT_OFF ") || app_int(dst, cap, n, g_rows[8].off) || app(dst, cap, n, "\n")) return -1;
    if (app(dst, cap, n, "#define TS_IDENT_LEN ") || app_int(dst, cap, n, g_rows[8].size) || app(dst, cap, n, "\n")) return -1;
    if (app(dst, cap, n, "#define TS_ORIGIN_OFF ") || app_int(dst, cap, n, g_rows[9].off) || app(dst, cap, n, "\n")) return -1;
    if (app(dst, cap, n, "#define TS_HEADER_TOTAL ") || app_int(dst, cap, n, g_total_bytes) || app(dst, cap, n, "\n")) return -1;
    if (app(dst, cap, n, "#define TS_HOST_SLOTS ") || app_int(dst, cap, n, HOST_SLOTS) || app(dst, cap, n, "\n")) return -1;
    if (app(dst, cap, n, "#define TS_M1_HOST_MASK ") || app_int(dst, cap, n, (int)g_m1_mask) || app(dst, cap, n, "ull\n")) return -1;
    if (app(dst, cap, n, "#define TS_ROW_COUNT ")) return -1;
    if (app_int(dst, cap, n, g_nrows)) return -1;
    if (app(dst, cap, n, "\n\ntypedef struct {\n    const char *field;\n    int off;\n    int size;\n    const char *kind;\n    const char *value;\n} ts_contract_row_t;\n\n")) return -1;
    if (app(dst, cap, n, "static const ts_contract_row_t ts_contract_rows[TS_ROW_COUNT] = {\n")) return -1;
    for (i = 0; i < g_nrows; i++) {
        if (app(dst, cap, n, "    {\"")) return -1;
        if (app(dst, cap, n, g_rows[i].field)) return -1;
        if (app(dst, cap, n, "\", ")) return -1;
        if (app_int(dst, cap, n, g_rows[i].off)) return -1;
        if (app(dst, cap, n, ", ")) return -1;
        if (app_int(dst, cap, n, g_rows[i].size)) return -1;
        if (app(dst, cap, n, ", \"")) return -1;
        if (app(dst, cap, n, g_rows[i].kind)) return -1;
        if (app(dst, cap, n, "\", \"")) return -1;
        if (app(dst, cap, n, g_rows[i].value)) return -1;
        if (app(dst, cap, n, "\"}")) return -1;
        if (i + 1 < g_nrows) { if (app(dst, cap, n, ",")) return -1; }
        if (app(dst, cap, n, "\n")) return -1;
    }
    if (app(dst, cap, n, "};\n\nstatic const char *ts_sect_tags[TS_NSECT] = {")) return -1;
    for (i = 0; i < 6; i++) {
        if (i > 0 && app(dst, cap, n, ", ")) return -1;
        if (app(dst, cap, n, "\"") || app(dst, cap, n, g_rows[10 + i * 4].value) || app(dst, cap, n, "\"")) return -1;
    }
    if (app(dst, cap, n, "};\n\nstatic const char *ts_hoststub_names[TS_HOST_SLOTS] = {\n")) return -1;
    for (i = 0; i < HOST_SLOTS; i++) {
        if ((i & 7) == 0 && app(dst, cap, n, "    ")) return -1;
        if (app(dst, cap, n, "\"") || app(dst, cap, n, g_host_ops[i]) || app(dst, cap, n, "\"")) return -1;
        if (i + 1 < HOST_SLOTS) {
            if ((i & 7) == 7) {
                if (app(dst, cap, n, ",\n")) return -1;
            } else {
                if (app(dst, cap, n, ", ")) return -1;
            }
        } else {
            if (app(dst, cap, n, "\n")) return -1;
        }
    }
    if (app(dst, cap, n, "};\n\n")) return -1;
    if (app(dst, cap, n,
        "unsigned long long ts_rd_u(const unsigned char *p, int k) {\n"
        "    unsigned long long v = 0;\n"
        "    int i = k - 1;\n"
        "    while (i >= 0) { v = (v << 8) | (unsigned long long)(p[i] & 255); i--; }\n"
        "    return v;\n"
        "}\n\n"
        "void ts_wr_u(unsigned char *p, int k, unsigned long long v) {\n"
        "    int i = 0;\n"
        "    while (i < k) { p[i] = (unsigned char)(v & 255ull); v >>= 8; i++; }\n"
        "}\n\n"
        "int ts_contract_row_count(void) { return TS_ROW_COUNT; }\n\n"
        "const ts_contract_row_t *ts_contract_row(int idx) {\n"
        "    if (idx < 0 || idx >= TS_ROW_COUNT) return 0;\n"
        "    return &ts_contract_rows[idx];\n"
        "}\n\n"
        "/* Compute sha256 over full container with header bytes 28..59 (ident) zeroed. */\n"
        "void ts_compute_ident(const unsigned char *buf, long len, unsigned char out_dig[32]) {\n"
        "    unsigned char *tmp;\n"
        "    int i;\n"
        "    for (i = 0; i < 32; i++) out_dig[i] = 0;\n"
        "    if (!buf || len <= 0) return;\n"
        "    tmp = (unsigned char *)mm_alloc(len);\n"
        "    if (!tmp) return;\n"
        "    mm_copy(tmp, len, buf, len);\n"
        "    if (len >= TS_IDENT_OFF + TS_IDENT_LEN) {\n"
        "        for (i = 0; i < TS_IDENT_LEN; i++) tmp[TS_IDENT_OFF + i] = 0;\n"
        "    }\n"
        "    cx_sha256(tmp, (size_t)len, out_dig);\n"
        "    mm_free(tmp);\n"
        "}\n\n"
        "void ts_seal_ident(unsigned char *buf, long len) {\n"
        "    unsigned char dig[32];\n"
        "    int i;\n"
        "    if (!buf || len < TS_HEADER_TOTAL) return;\n"
        "    ts_compute_ident(buf, len, dig);\n"
        "    for (i = 0; i < 32; i++) buf[TS_IDENT_OFF + i] = dig[i];\n"
        "}\n\n"
        "static int ts_fail(char *why, long wcap, const char *msg) {\n"
        "    long i = 0;\n"
        "    if (why && wcap > 0) {\n"
        "        while (msg[i] && i + 1 < wcap) { why[i] = msg[i]; i++; }\n"
        "        why[i] = 0;\n"
        "    }\n"
        "    return 1;\n"
        "}\n\n")) return -1;
    if (app(dst, cap, n,
        "/* Validate a UTAPEBIN minor==3 tapeslice container buffer of length len. Returns 0 on success. */\n"
        "int ts_validate_container(const unsigned char *b, long len, char *why, long wcap) {\n"
        "    int i, j;\n"
        "    unsigned long long entry_off, nsect, dir_off, origin, prev_end;\n"
        "    unsigned long long code_len = 0, data_off = 0, data_len = 0;\n"
        "    unsigned char dig[32];\n"
        "    if (!b) return ts_fail(why, wcap, \"null-buffer\");\n"
        "    if (len < TS_HEADER_TOTAL + 8) return ts_fail(why, wcap, \"short-header\");\n"
        "    for (i = 0; i < 8; i++) {\n"
        "        if (b[i] != (unsigned char)TS_MAGIC[i]) return ts_fail(why, wcap, \"bad-magic\");\n"
        "    }\n"
        "    if (ts_rd_u(b + 8, 2) != TS_MAJOR) return ts_fail(why, wcap, \"bad-major\");\n"
        "    if (ts_rd_u(b + 10, 2) != TS_MINOR) return ts_fail(why, wcap, \"bad-minor\");\n"
        "    if (ts_rd_u(b + 12, 2) != TS_ENDIAN) return ts_fail(why, wcap, \"bad-endian\");\n"
        "    if (ts_rd_u(b + 14, 2) != 0) return ts_fail(why, wcap, \"bad-flags\");\n"
        "    entry_off = ts_rd_u(b + 16, 4);\n"
        "    nsect = ts_rd_u(b + 20, 4);\n"
        "    if (nsect != TS_NSECT) return ts_fail(why, wcap, \"bad-nsect\");\n"
        "    dir_off = ts_rd_u(b + 24, 4);\n"
        "    if (dir_off != TS_DIR_OFF) return ts_fail(why, wcap, \"bad-dir-off\");\n"
        "    origin = ts_rd_u(b + TS_ORIGIN_OFF, 4);\n"
        "    if (origin > 6) return ts_fail(why, wcap, \"bad-origin\");\n"
        "    prev_end = TS_HEADER_TOTAL;\n"
        "    for (i = 0; i < TS_NSECT; i++) {\n"
        "        int d = TS_DIR_OFF + 24 * i;\n"
        "        const char *want_tag = ts_sect_tags[i];\n"
        "        unsigned long long aligned, soff, slen, scnt;\n"
        "        for (j = 0; j < 4; j++) {\n"
        "            if (b[d + j] != (unsigned char)want_tag[j]) return ts_fail(why, wcap, \"unknown-or-misordered-tag\");\n"
        "        }\n"
        "        soff = ts_rd_u(b + d + 4, 8);\n"
        "        slen = ts_rd_u(b + d + 12, 8);\n"
        "        scnt = ts_rd_u(b + d + 20, 4);\n"
        "        aligned = prev_end + ((8ull - (prev_end & 7ull)) & 7ull);\n"
        "        if (soff != aligned) return ts_fail(why, wcap, \"unaligned-or-gap-section-off\");\n"
        "        if (soff > (unsigned long long)len || slen > (unsigned long long)len - soff) return ts_fail(why, wcap, \"section-out-of-bounds\");\n"
        "        while (prev_end < soff) {\n"
        "            if (b[prev_end] != 0) return ts_fail(why, wcap, \"nonzero-padding\");\n"
        "            prev_end++;\n"
        "        }\n"
        "        if (i == 0) code_len = slen;\n"
        "        if (i == 1) { data_off = soff; data_len = slen; }\n"
        "        if (i == 2 && (slen != 8 || scnt != 1)) return ts_fail(why, wcap, \"bad-bssz-shape\");\n"
        "        if (i == 3) {\n"
        "            unsigned long long r;\n"
        "            if ((slen & 15ull) != 0 || scnt != (slen >> 4)) return ts_fail(why, wcap, \"bad-table-section-shape\");\n"
        "            for (r = 0; r < scnt; r++) {\n"
        "                const unsigned char *row = b + soff + (r << 4);\n"
        "                unsigned long long noff = ts_rd_u(row, 4);\n"
        "                unsigned int ssect = (unsigned int)row[4];\n"
        "                unsigned int skind = (unsigned int)row[5];\n"
        "                unsigned long long srsv = ts_rd_u(row + 6, 2);\n"
        "                unsigned long long k;\n"
        "                int nul_ok = 0;\n"
        "                if (ssect > 3 || skind > 3 || srsv != 0) return ts_fail(why, wcap, \"bad-syms-record\");\n"
        "                if (noff >= data_len || b[data_off + noff] == 0) return ts_fail(why, wcap, \"bad-syms-record\");\n"
        "                for (k = noff; k < data_len; k++) {\n"
        "                    if (b[data_off + k] == 0) { nul_ok = 1; break; }\n"
        "                }\n"
        "                if (!nul_ok) return ts_fail(why, wcap, \"bad-syms-record\");\n"
        "            }\n"
        "        }\n"
        "        if (i == 4) {\n"
        "            unsigned long long r;\n"
        "            if ((slen & 15ull) != 0 || scnt != (slen >> 4)) return ts_fail(why, wcap, \"bad-table-section-shape\");\n"
        "            for (r = 0; r < scnt; r++) {\n"
        "                const unsigned char *row = b + soff + (r << 4);\n"
        "                unsigned long long rpos = ts_rd_u(row, 8);\n"
        "                unsigned int rkind = (unsigned int)row[8];\n"
        "                unsigned int rwidth = (unsigned int)row[9];\n"
        "                unsigned long long rrsv = ts_rd_u(row + 10, 2);\n"
        "                if (rkind > 3 || rwidth < 1 || rwidth > 10 || rrsv != 0) return ts_fail(why, wcap, \"bad-relo-record\");\n"
        "                if (rpos == 0 || rpos >= code_len || (unsigned long long)rwidth > code_len - rpos) return ts_fail(why, wcap, \"bad-relo-record\");\n"
        "            }\n"
        "        }\n"
        "        if (i == 5) {\n"
        "            unsigned char seen[TS_HOST_SLOTS];\n"
        "            unsigned long long hpos = 0, r;\n"
        "            for (j = 0; j < TS_HOST_SLOTS; j++) seen[j] = 0;\n"
        "            for (r = 0; r < scnt; r++) {\n"
        "                unsigned long long slot, nlen, wlen = 0, k;\n"
        "                const char *want;\n"
        "                if (slen - hpos < 4) return ts_fail(why, wcap, \"bad-host-record\");\n"
        "                slot = ts_rd_u(b + soff + hpos, 2);\n"
        "                nlen = ts_rd_u(b + soff + hpos + 2, 2);\n"
        "                hpos += 4;\n"
        "                if (slot >= TS_HOST_SLOTS) return ts_fail(why, wcap, \"unknown-host-slot\");\n"
        "                if (seen[slot]) return ts_fail(why, wcap, \"bad-host-record\");\n"
        "                seen[slot] = 1;\n"
        "                if (nlen > slen - hpos) return ts_fail(why, wcap, \"bad-host-record\");\n"
        "                want = ts_hoststub_names[slot];\n"
        "                while (want[wlen]) wlen++;\n"
        "                if (nlen != wlen) return ts_fail(why, wcap, \"bad-host-record\");\n"
        "                for (k = 0; k < nlen; k++) {\n"
        "                    if (b[soff + hpos + k] != (unsigned char)want[k]) return ts_fail(why, wcap, \"bad-host-record\");\n"
        "                }\n"
        "                hpos += nlen;\n"
        "            }\n"
        "            if (hpos != slen) return ts_fail(why, wcap, \"bad-host-record\");\n"
        "        }\n"
        "        prev_end = soff + slen;\n"
        "    }\n"
        "    if (prev_end != (unsigned long long)len) return ts_fail(why, wcap, \"truncated-or-trailing-bytes\");\n"
        "    if (code_len == 0 && entry_off != 0) return ts_fail(why, wcap, \"bad-entry-off\");\n"
        "    if (code_len > 0 && entry_off >= code_len) return ts_fail(why, wcap, \"bad-entry-off\");\n"
        "    ts_compute_ident(b, len, dig);\n"
        "    for (i = 0; i < 32; i++) {\n"
        "        if (b[TS_IDENT_OFF + i] != dig[i]) return ts_fail(why, wcap, \"bad-ident\");\n"
        "    }\n"
        "    if (why && wcap > 0) why[0] = 0;\n"
        "    return 0;\n"
        "}\n\n")) return -1;
    if (app(dst, cap, n,
        "int ts_validate_entry_ibitmap(const unsigned char *b, long len, const unsigned char *ibitmap, long ibitmap_cap, char *why, long wcap) {\n"
        "    unsigned long long entry_off, code_len, byte_idx;\n"
        "    if (ts_validate_container(b, len, why, wcap) != 0) return 1;\n"
        "    entry_off = ts_rd_u(b + 16, 4);\n"
        "    code_len = ts_rd_u(b + TS_DIR_OFF + 12, 8);\n"
        "    if (code_len > 0) {\n"
        "        byte_idx = entry_off >> 3;\n"
        "        if (!ibitmap || ibitmap_cap <= 0 || byte_idx >= (unsigned long long)ibitmap_cap) {\n"
        "            return ts_fail(why, wcap, \"entry-not-on-insn-boundary\");\n"
        "        }\n"
        "        if ((((unsigned int)ibitmap[byte_idx] >> (entry_off & 7ull)) & 1u) == 0u) {\n"
        "            return ts_fail(why, wcap, \"entry-not-on-insn-boundary\");\n"
        "        }\n"
        "        {\n"
        "            int rd = TS_DIR_OFF + 24 * 4;\n"
        "            unsigned long long rsoff = ts_rd_u(b + rd + 4, 8);\n"
        "            unsigned long long rscnt = ts_rd_u(b + rd + 20, 4);\n"
        "            unsigned long long rr;\n"
        "            for (rr = 0; rr < rscnt; rr++) {\n"
        "                const unsigned char *row = b + rsoff + (rr << 4);\n"
        "                unsigned long long rpos = ts_rd_u(row, 8);\n"
        "                unsigned int rwidth = (unsigned int)row[9], k;\n"
        "                for (k = 0; k < rwidth; k++) {\n"
        "                    unsigned long long p = rpos + (unsigned long long)k;\n"
        "                    unsigned long long pb = p >> 3;\n"
        "                    if (pb >= (unsigned long long)ibitmap_cap || (((unsigned int)ibitmap[pb] >> (p & 7ull)) & 1u) != 0u) {\n"
        "                        return ts_fail(why, wcap, \"relo-crosses-insn-boundary\");\n"
        "                    }\n"
        "                }\n"
        "            }\n"
        "        }\n"
        "    }\n"
        "    if (why && wcap > 0) why[0] = 0;\n"
        "    return 0;\n"
        "}\n\n"
        "/* Overflow-safe subtraction check for 8-byte aligned DATA + BSS inside memlimit. */\n"
        "int ts_check_linear_bounds(unsigned long long data_len, unsigned long long bss_size,\n"
        "                           unsigned long long memlimit, unsigned long long *out_data_aligned,\n"
        "                           char *why, long wcap) {\n"
        "    unsigned long long aligned;\n"
        "    if (data_len > 0xffffffffffffffffull - 7ull) return ts_fail(why, wcap, \"data-align-overflow\");\n"
        "    aligned = (data_len + 7ull) & ~7ull;\n"
        "    if (bss_size > memlimit || aligned > memlimit - bss_size) {\n"
        "        return ts_fail(why, wcap, \"linear-mem-oob\");\n"
        "    }\n"
        "    if (out_data_aligned) *out_data_aligned = aligned;\n"
        "    if (why && wcap > 0) why[0] = 0;\n"
        "    return 0;\n"
        "}\n\n"
        "/* Strictly verify hoststub-slots.tsv slot/op columns against generated ts_hoststub_names[0..36]. */\n"
        "int ts_validate_host_table(const char *tsv_buf, long tsv_len, char *why, long wcap) {\n"
        "    unsigned char seen[TS_HOST_SLOTS];\n"
        "    long pos = 0;\n"
        "    int saw_hdr = 0, row_idx = 0, i;\n"
        "    if (!tsv_buf || tsv_len <= 0) return ts_fail(why, wcap, \"host-table-slot-mismatch\");\n"
        "    for (i = 0; i < TS_HOST_SLOTS; i++) seen[i] = 0;\n"
        "    while (pos < tsv_len) {\n"
        "        long e = pos, t0 = -1, t1 = -1, k;\n"
        "        while (e < tsv_len && tsv_buf[e] != '\\n') e++;\n"
        "        if (e == pos) return ts_fail(why, wcap, \"host-table-slot-mismatch\");\n"
        "        if (tsv_buf[pos] == '#') {\n"
        "            pos = (e < tsv_len) ? (e + 1) : e;\n"
        "            continue;\n"
        "        }\n"
        "        if (!saw_hdr) {\n"
        "            if (e - pos < 8 || !tx_prefix(tsv_buf + pos, e - pos, \"slot\\top\\t\", 8)) {\n"
        "                return ts_fail(why, wcap, \"host-table-slot-mismatch\");\n"
        "            }\n"
        "            saw_hdr = 1;\n"
        "        } else {\n"
        "            long slot = 0, op_len, wlen = 0;\n"
        "            const char *want;\n"
        "            for (k = pos; k < e; k++) {\n"
        "                if (tsv_buf[k] == '\\t') {\n"
        "                    if (t0 < 0) t0 = k;\n"
        "                    else { t1 = k; break; }\n"
        "                }\n"
        "            }\n"
        "            if (t0 <= pos) return ts_fail(why, wcap, \"host-table-slot-mismatch\");\n"
        "            if (t1 < 0) t1 = e;\n"
        "            for (k = pos; k < t0; k++) {\n"
        "                if (tsv_buf[k] < '0' || tsv_buf[k] > '9') return ts_fail(why, wcap, \"host-table-slot-mismatch\");\n"
        "                slot = slot * 10 + (long)(tsv_buf[k] - '0');\n"
        "                if (slot >= TS_HOST_SLOTS) return ts_fail(why, wcap, \"host-table-slot-mismatch\");\n"
        "            }\n"
        "            if (seen[slot] || slot != (long)row_idx) return ts_fail(why, wcap, \"host-table-slot-mismatch\");\n"
        "            seen[slot] = 1;\n"
        "            row_idx++;\n"
        "            op_len = t1 - (t0 + 1);\n"
        "            want = ts_hoststub_names[slot];\n"
        "            while (want[wlen]) wlen++;\n"
        "            if (op_len != wlen) return ts_fail(why, wcap, \"host-table-op-mismatch\");\n"
        "            for (k = 0; k < op_len; k++) {\n"
        "                if (tsv_buf[t0 + 1 + k] != want[k]) return ts_fail(why, wcap, \"host-table-op-mismatch\");\n"
        "            }\n"
        "        }\n"
        "        pos = (e < tsv_len) ? (e + 1) : e;\n"
        "    }\n"
        "    if (!saw_hdr || row_idx != TS_HOST_SLOTS) return ts_fail(why, wcap, \"host-table-slot-mismatch\");\n"
        "    if (why && wcap > 0) why[0] = 0;\n"
        "    return 0;\n"
        "}\n\n"
        "/* Verify all HOST slots referenced by container belong to M1 frozen 8-slot core (0,1,2,3,4,5,6,8). */\n"
        "int ts_validate_m1_host_support(const unsigned char *b, long len, char *why, long wcap) {\n"
        "    int d = TS_DIR_OFF + 24 * 5;\n"
        "    unsigned long long soff, scnt, hpos = 0, r;\n"
        "    if (ts_validate_container(b, len, why, wcap) != 0) return 1;\n"
        "    soff = ts_rd_u(b + d + 4, 8);\n"
        "    scnt = ts_rd_u(b + d + 20, 4);\n"
        "    for (r = 0; r < scnt; r++) {\n"
        "        unsigned long long slot = ts_rd_u(b + soff + hpos, 2);\n"
        "        unsigned long long nlen = ts_rd_u(b + soff + hpos + 2, 2);\n"
        "        if (slot >= 64 || ((TS_M1_HOST_MASK >> slot) & 1ull) == 0ull) {\n"
        "            return ts_fail(why, wcap, \"m1-unsupported-host-slot\");\n"
        "        }\n"
        "        hpos += 4 + nlen;\n"
        "    }\n"
        "    if (why && wcap > 0) why[0] = 0;\n"
        "    return 0;\n"
        "}\n\n"
        "/* Verify a hostcall slot invoked from CODE is valid, M1-supported (when m1_only), and declared in HOST section. */\n"
        "int ts_validate_hostcall_slot(const unsigned char *b, long len, unsigned int slot, int m1_only, char *why, long wcap) {\n"
        "    int d = TS_DIR_OFF + 24 * 5;\n"
        "    unsigned long long soff, scnt, hpos = 0, r;\n"
        "    if (ts_validate_container(b, len, why, wcap) != 0) return 1;\n"
        "    if (slot >= TS_HOST_SLOTS) return ts_fail(why, wcap, \"unknown-host-slot\");\n"
        "    if (m1_only && ((TS_M1_HOST_MASK >> slot) & 1ull) == 0ull) {\n"
        "        return ts_fail(why, wcap, \"m1-unsupported-host-slot\");\n"
        "    }\n"
        "    soff = ts_rd_u(b + d + 4, 8);\n"
        "    scnt = ts_rd_u(b + d + 20, 4);\n"
        "    for (r = 0; r < scnt; r++) {\n"
        "        unsigned long long rslot = ts_rd_u(b + soff + hpos, 2);\n"
        "        unsigned long long nlen = ts_rd_u(b + soff + hpos + 2, 2);\n"
        "        if (rslot == (unsigned long long)slot) {\n"
        "            if (why && wcap > 0) why[0] = 0;\n"
        "            return 0;\n"
        "        }\n"
        "        hpos += 4 + nlen;\n"
        "    }\n"
        "    return ts_fail(why, wcap, \"undeclared-host-slot-in-code\");\n"
        "}\n")) return -1;
    return 0;
}

int main(int argc, char **argv) {
    size_t n = 0, hn = 0, on = 0;
    char *b, *hb, *cur;
    char gen[GENCAP];
    int gn = 0, dowrite = 0;
    if (argc != 2 || (!tx_eqz(argv[1], "--check") && !tx_eqz(argv[1], "--write"))) {
        sy_eprintf("tapeslice-gen\tusage\t--check|--write\n");
        return 2;
    }
    dowrite = tx_eqz(argv[1], "--write");
    b = cx_read(TSV_PATH, &n);
    if (!b) return fail("tsv-read");
    if (parse_tsv(b, n)) return 1;
    hb = cx_read(HOST_TSV_PATH, &hn);
    if (!hb) return fail("host-tsv-read");
    if (parse_host_tsv(hb, hn)) return 1;
    if (emit_contract(gen, GENCAP, &gn)) return fail("emit");
    if (dowrite) {
        if (cx_write(OUT_PATH, gen, (size_t)gn)) return fail("write");
        sy_printf("TAPESLICE_GEN\tWROTE\t%s\trows=%d\thost_slots=%d\tbytes=%d\n", OUT_PATH, g_nrows, HOST_SLOTS, gn);
        return 0;
    }
    cur = cx_read(OUT_PATH, &on);
    if (!cur) return fail("out-read");
    if (on != (size_t)gn || !mm_same(cur, gen, (long)gn)) return fail("check-difference");
    sy_printf("TAPESLICE_GEN\tCHECK\trows=%d\thost_slots=%d\tbytes=%d\n", g_nrows, HOST_SLOTS, gn);
    return 0;
}
