/* Check the module-unit cap: 95 chained modules plan rc0, 96 are refused with
   the named "more than 96 units in one program" sentence. The chain (m0 uses
   m1, ...) keeps each unit under the 48-use limit and makes the closure grow
   one unit per file. C44-MAXU-01 (module units 64 -> 96).
   Needs a product with the 96-unit cap: the installed 0.0.43 FAILs
   (95-modules-plan-rc0, 96-modules-refused-named), expected until M4 is
   installed. */
#pragma unisa use sysx.process
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.sig
#pragma unisa use text.text
#pragma unisa use mem.heap

static int g_fail;
static void ck(int ok, const char *name) {
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", name);
    if (!ok) g_fail = g_fail + 1;
}
static int has(const char *s, const char *w) {
    if (!s) return 0;
    return tx_find(s, tx_len(s, 1 << 20), w, tx_len(w, 128)) >= 0;
}
static int write_module(const char *path, int k, int next) {
    int fd;
    long bn;
    sy_unlink(path);   /* open_new is O_EXCL; a rewrite must drop the old file first */
    fd = sy_open_new(path, 0644);
    if (fd < 0) return 1;
    if (next < 0) {
        char b[48];
        if (cx_fmt(b, sizeof b, "#pragma unisa module m%d\n", k)) { sy_close(fd); return 1; }
        bn = tx_len(b, sizeof b);
        if (bn < 0 || sy_write_all(fd, b, bn)) { sy_close(fd); return 1; }
    } else {
        char b[80];
        if (cx_fmt(b, sizeof b, "#pragma unisa module m%d\n#pragma unisa use m%d\n", k, next)) { sy_close(fd); return 1; }
        bn = tx_len(b, sizeof b);
        if (bn < 0 || sy_write_all(fd, b, bn)) { sy_close(fd); return 1; }
    }
    return sy_close(fd);
}

int main(int argc, char **argv) {
    char root[4096], com[4400], bound[4400], work[4400], mainc[4400], mc[4400];
    char *v[8];
    char why[512];
    np_result r;
    int fd, k;
    root[0] = 0;
    if (argc >= 2 && argv[1][0] == '/') { if (tx_copy(com, 4400, argv[1], tx_len(argv[1], 4400))) return 2; }
    else {
        if (sy_cwd(root, 4096) < 0) return 2;
        if (cx_fmt(com, sizeof com, "%s/unisacc.com", root)) return 2;
    }
    if (root[0] == 0 && sy_cwd(root, 4096) < 0) return 2;
    if (cx_fmt(bound, sizeof bound, "%s/tools/bound", root)) return 2;
    if (cx_fmt(work, sizeof work, "/tmp/maxu-%d", sy_pid())) return 2;
    if (sy_mkdir(work, 0700)) return 2;
    /* 95 modules m0 -> m1 -> ... -> m94 (no m95 yet): closure 96 units, rc0. */
    for (k = 0; k < 95; k++) {
        if (cx_fmt(mc, sizeof mc, "%s/m%d.cx", work, k)) return 2;
        if (write_module(mc, k, k < 94 ? k + 1 : -1)) return 2;
    }
    if (cx_fmt(mainc, sizeof mainc, "%s/main.cx", work)) return 2;
    fd = sy_open_new(mainc, 0644);
    if (fd < 0) return 2;
    if (sy_write_all(fd, "#pragma unisa use m0\n", 22) || sy_close(fd)) return 2;
    v[0] = bound; v[1] = "50"; v[2] = com; v[3] = "-cx-plan"; v[4] = mainc; v[5] = 0;
    if (np_run(v, root, 0, 50, &r, why, sizeof why)) { printf("FAIL\t95-run\n"); return 2; }
    ck(r.rc == 0, "95-modules-plan-rc0");
    np_free(&r);
    /* add m95 and point m94 at it: 96 modules, closure 97 units, refuse. */
    if (cx_fmt(mc, sizeof mc, "%s/m95.cx", work)) return 2;
    if (write_module(mc, 95, -1)) return 2;
    if (cx_fmt(mc, sizeof mc, "%s/m94.cx", work)) return 2;
    if (write_module(mc, 94, 95)) return 2;
    v[0] = bound; v[1] = "50"; v[2] = com; v[3] = "-cx-plan"; v[4] = mainc; v[5] = 0;
    if (np_run(v, root, 0, 50, &r, why, sizeof why)) { printf("FAIL\t96-run\n"); return 2; }
    ck(r.rc == 1 && has(r.err, "more than 96 units"), "96-modules-refused-named");
    np_free(&r);
    printf("CHECK_MAXU\tfailed=%d\n", g_fail);
    return g_fail ? 1 : 0;
}
