/* tools/check-tlib-prep.cx -- the tlib kit and the prepare path that links listed tools from it.
 *
 *   sh ./unisacc.com tools/check-tlib-prep.cx [-- ROOT NEW_DIR]
 *
 * Real product, real packages of ROOT, a private kit directory (NEW_DIR/kit); the package cache is
 * the default one, whose entries the build verifies by structure and input sha before use.
 *  (1) `tlib kit` leaves the tlibs, the prep image and kit.tsv, and says PREPARED once;
 *  (2) the kit image links the first tool listed in ROOT/build/tlib-prep.tsv: rc 0, one PREPARED
 *      line, an image, no work directory left behind;
 *  (3) that image and the product's `-o` image of the same source give the same output and exit
 *      code without arguments and with an option neither knows;
 *  (4) a source that is not listed is NOT_APPLICABLE (rc 7): nothing printed, nothing written;
 *  (5) under each release-chain marker variable and under the opt-out the image refuses (rc 7) and
 *      writes nothing; cxlib.tlibpkg names the variable while it is set and nothing once it is gone;
 *  (6) a kit whose kit.tsv was edited (rc 3), that names another product (rc 4), whose record of
 *      the tlib tool's sources differs from ROOT (rc 4), whose image is not the recorded one (rc 3)
 *      or whose tlib has a changed byte (rc 3) links nothing;
 *  (7) no listed tool is a release-chain tool, every listed tool exists, and the compiler's own
 *      plan for each release-chain tool does not contain the tlibpkg module.
 * Prints PASS/FAIL per case and CHECK_TLIB_PREP<TAB>failed=N; exit 0 only when 0.
 * The kit build and the two images are preparation: MEASURED lines are measurements, not results. */
#pragma unisa use cxlib.tlibpkg
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use mem.heap

static int failed;
static char root[4096], work[4400], product[4400], kitdir[4500], image[4600];
static char *last;
static size_t lastn;

static void ck(int ok, const char *name) {
    if (!ok) failed++;
    sy_printf("%s\ttlib-prep.%s\n", ok ? "PASS" : "FAIL", name);
}

static void fatal(const char *what) {
    sy_printf("check-tlib-prep: %s\nCHECK_TLIB_PREP\tfailed=%d\n", what, failed + 1);
    exit(1);
}

/* ARGV with stderr folded into the captured output; the exit code. */
static int run(char *const args[], int secs) {
    char *v[40];
    int k = 0, i;
    mm_free(last);
    last = 0;
    lastn = 0;
    v[k++] = "sh"; v[k++] = "-c"; v[k++] = "exec \"$@\" 2>&1"; v[k++] = "sh";
    for (i = 0; args[i] && k < 39; i++) v[k++] = args[i];
    v[k] = 0;
    return cx_runv_timeout(v, secs, &last, &lastn);
}

static int has(const char *w) { return last && tx_find(last, (long)lastn, w, tx_len(w, 256)) >= 0; }

static int count(const char *w) {
    long wl = tx_len(w, 256), at = 0, n = 0, k;
    while (last && at < (long)lastn && (k = tx_find(last + at, (long)lastn - at, w, wl)) >= 0) { n++; at += k + wl; }
    return (int)n;
}

/* The image run on TOOL with the kit in KIT, output to OUT; ENVSET ("NAME=value") or 0. */
static int prep(const char *envset, const char *kit, const char *tool, const char *out) {
    char *v[16];
    int k = 0;
    if (envset) { v[k++] = "env"; v[k++] = (char *)envset; }
    v[k++] = image; v[k++] = "prep"; v[k++] = (char *)tool; v[k++] = "-o"; v[k++] = (char *)out;
    v[k++] = "--kit"; v[k++] = (char *)kit; v[k++] = "--root"; v[k++] = root; v[k] = 0;
    return run(v, 40);
}

static void at(char *dst, const char *dir, const char *leaf) {
    if (cx_fmt(dst, 4700, "%s/%s", dir, leaf)) fatal("path bound");
}

/* Field 0 of data row NTH of TABLE (text of N bytes): 0 with DST, 1 when there is no such row. */
static int row_key(const char *t, long n, int nth, char *dst, long cap) {
    long i = 0, e, off, len;
    int seen = 0;
    while (i < n) {
        e = i;
        while (e < n && t[e] != '\n') e++;
        if (e > i && t[i] != '#' && !tx_field(t + i, e - i, '\t', 0, &off, &len) && len > 0) {
            if (seen == nth) return tx_copy(dst, cap, t + i + off, len) ? 1 : 0;
            seen++;
        }
        i = e + 1;
    }
    return 1;
}

/* Write DIR/kit.tsv from the good kit text K with the 64 hex digits after "KEY<TAB>" (occurrence
   NTH; for "self" the last field) changed in one digit; RESEAL recomputes kit_sha. */
static int forge(const char *dir, const char *k, long kn, const char *key, int reseal) {
    char path[4700], hex[65];
    char *b = mm_alloc((size_t)kn + 1);
    long i = 0, e, kl = tx_len(key, 64), body;
    int done = 0;
    if (!b || mm_copy(b, (size_t)kn + 1, k, (size_t)kn)) return 1;
    while (i < kn && !done) {
        e = i;
        while (e < kn && b[e] != '\n') e++;
        if (e - i > kl + 64 && tx_same(b + i, kl, key, kl) && b[i + kl] == '\t') {
            b[e - 1] = b[e - 1] == '0' ? '1' : '0';
            done = 1;
        }
        i = e + 1;
    }
    body = tx_rfind(b, kn, "kit_sha\t", 8);
    if (!done || body < 0) { mm_free(b); return 1; }
    if (reseal) {
        cx_sha256_hex(b, (size_t)body, hex);
        if (mm_copy(b + body + 8, 64, hex, 64)) { mm_free(b); return 1; }
    }
    at(path, dir, "kit.tsv");
    i = cx_write(path, b, (size_t)kn);
    mm_free(b);
    return i ? 1 : 0;
}

int main(int argc, char **argv) {
    static const char *const chain_tools[] = {"tools/chain-run.cx", "tools/release-build.cx", "tools/candidate-chain.cx", "tools/selfhost.cx",
                                              "tools/kernel-build.cx", "tools/product-build.cx", "tools/source-job-wave.cx", "tools/pc-wave.cx", 0};
    static const char *const markers[] = {"UNISACC_CHAIN_SEGMENT_TOKEN=t", "UNISACC_CHAIN_RECHECK_ID=r", "UNISACC_IDENTITY_HELPER=/nonexistent", "UNISACC_CTOR=c",
                                          "UNISACC_TLIB_PREP=0", 0};
    char table[4400], tool[512], self[512], linked[4700], plain[4700], other[4700], path[4700], k2[4700], src[4700], dst[4700], lib[512], note[200];
    char *t, *kit, *keep = 0;
    size_t tn = 0, kn = 0, keepn = 0;
    long t0;
    int rc, rc2, i, ok, seen;
    if (argc >= 3) { if (sy_realpath(argv[1], root, sizeof root) < 0 || cx_fmt(work, sizeof work, "%s", argv[2])) return 2; }
    else if (sy_realpath(".", root, sizeof root) < 0 || cx_fmt(work, sizeof work, "%s/check-tlib-prep-%d", sy_tmpdir(), sy_pid())) return 2;
    if (sy_mkdir(work, 0700)) { sy_printf("check-tlib-prep: NEW_DIR must not exist\n"); return 2; }
    if (cx_fmt(product, sizeof product, "%s/unisacc.com", root) || cx_fmt(table, sizeof table, "%s/build/tlib-prep.tsv", root)) return 2;
    at(kitdir, work, "kit"); at(image, kitdir, "tlib-prep"); at(k2, work, "kit2");
    at(linked, work, "tool.linked"); at(plain, work, "tool.plain"); at(other, work, "not-written");
    if (sy_chdir(root)) return 2;
    t = cx_read(table, &tn);
    if (!t || row_key(t, (long)tn, 0, tool, sizeof tool)) fatal("no tool listed in build/tlib-prep.tsv");

    /* (7) first: it needs no kit */
    ok = 1;
    for (i = 0; !row_key(t, (long)tn, i, self, sizeof self); i++) {
        int c;
        if (sy_exists(self) != 1) ok = 0;
        for (c = 0; chain_tools[c]; c++) if (tx_eqz(self, chain_tools[c])) ok = 0;
    }
    ck(ok && i > 0, "listed-tools-exist-and-none-is-a-release-chain-tool");
    ok = 1; seen = 0;
    for (i = 0; chain_tools[i]; i++) {
        char *v[] = {"sh", product, "-cx-plan", (char *)chain_tools[i], 0};
        if (sy_exists(chain_tools[i]) != 1) continue;
        seen++;
        if (run(v, 20) != 0 || !has(chain_tools[i]) || has("tlibpkg")) ok = 0;
    }
    ck(ok && seen >= 3, "release-chain-tool-plans-do-not-reach-the-tlib-path");

    /* (1) */
    t0 = sy_now_ms();
    {   char *v[] = {"sh", product, "tools/tlib.cx", "--", "kit", "--out", kitdir, "--root", root, 0};
        rc = run(v, 45);
    }
    at(path, kitdir, "kit.tsv");
    kit = cx_read(path, &kn);
    ck(rc == 0 && count("PREPARED\ttlib-kit\t") == 1 && kit && sy_exists(image) == 1, "kit-built-and-prepared-once");
    sy_printf("MEASURED\ttlib-prep\tkit_ms=%ld\n", sy_now_ms() - t0);
    if (rc || !kit) { if (last) (void)sy_write_all(1, last, (long)lastn); fatal("no kit: the remaining cases cannot run"); }

    /* (4) (5): refusals, nothing written */
    if (cx_fmt(self, sizeof self, "%s/tools/check-tlib-prep.cx", root)) return 2;
    rc = prep(0, kitdir, self, other);
    ck(rc == 7 && lastn == 0 && sy_exists(other) != 1, "unlisted-source-does-not-apply-silently");
    ok = 1;
    for (i = 0; markers[i]; i++) {
        rc = prep(markers[i], kitdir, tool, other);
        if (rc != 7 || !has("REFUSED") || sy_exists(other) == 1) ok = 0;
    }
    ck(ok, "chain-markers-and-opt-out-refuse-and-write-nothing");
    {
        const char *before = tp_prep_forbidden(), *named, *opted;
        (void)sy_setenv("UNISACC_CHAIN_SEGMENT_TOKEN", "t", 1);
        named = tp_prep_forbidden();
        (void)sy_unsetenv("UNISACC_CHAIN_SEGMENT_TOKEN");
        (void)sy_setenv("UNISACC_TLIB_PREP", "0", 1);
        opted = tp_prep_forbidden();
        (void)sy_setenv("UNISACC_TLIB_PREP", "1", 1);
        ok = !before && named && opted && !tp_prep_forbidden();
        (void)sy_unsetenv("UNISACC_TLIB_PREP");
        if (cx_fmt(note, sizeof note, "%s", named ? named : "")) note[0] = 0;
        ck(ok && !tp_prep_forbidden() && tx_find(note, tx_len(note, sizeof note), "SEGMENT", 7) >= 0, "guard-names-the-marker-and-clears-with-it");
    }

    /* a second kit directory with the same members: (2) links from it, (6) then breaks it */
    ok = sy_mkdir(k2, 0700) == 0;
    at(src, kitdir, "tlib-prep"); at(dst, k2, "tlib-prep");
    if (ok && sy_copy(src, dst, 0700)) ok = 0;
    lib[0] = 0;
    for (i = 0; ok; i++) {
        char cur[512];
        long j = 0, e, off, len, n = 0;
        int hit = 0;
        while (j < (long)kn && !hit) {
            e = j;
            while (e < (long)kn && kit[e] != '\n') e++;
            if (e - j > 4 && tx_same(kit + j, 4, "lib\t", 4)) {
                if (n == i) { hit = 1; if (tx_field(kit + j, e - j, '\t', 1, &off, &len) || tx_copy(cur, sizeof cur, kit + j + off, len)) ok = 0; }
                n++;
            }
            j = e + 1;
        }
        if (!hit || !ok) break;
        at(src, kitdir, cur); at(dst, k2, cur);
        if (sy_copy(src, dst, 0600) || cx_fmt(lib, sizeof lib, "%s", cur)) ok = 0;
    }
    at(path, k2, "kit.tsv");
    if (ok && cx_write(path, kit, kn)) ok = 0;
    ck(ok && i > 0 && lib[0], "second-kit-directory-copied");

    /* (2) (3) */
    t0 = sy_now_ms();
    rc = prep(0, k2, tool, linked);
    if (cx_fmt(path, sizeof path, "%s.tlibwork", linked)) return 2;
    ck(rc == 0 && count("PREPARED\ttlib-prep\t") == 1 && sy_exists(linked) == 1 && sy_exists(path) != 1, "listed-tool-linked-from-the-kit");
    sy_printf("MEASURED\ttlib-prep\tlink_ms=%ld\t%s\n", sy_now_ms() - t0, tool);
    if (rc && last) (void)sy_write_all(1, last, (long)lastn);
    t0 = sy_now_ms();
    {   char *v[] = {"sh", product, tool, "-o", plain, 0};
        rc = run(v, 40);
    }
    sy_printf("MEASURED\ttlib-prep\tsource_build_ms=%ld\t%s\n", sy_now_ms() - t0, tool);
    ok = rc == 0 && sy_exists(plain) == 1 && sy_exists(linked) == 1;
    for (i = 0; ok && i < 2; i++) {
        char *a[] = {plain, i ? "--no-such-option-for-any-tool" : 0, 0};
        char *b[] = {linked, i ? "--no-such-option-for-any-tool" : 0, 0};
        rc = run(a, 15);
        mm_free(keep);
        keepn = lastn;
        keep = mm_alloc(keepn + 1);
        if (!keep || (keepn && mm_copy(keep, keepn + 1, last, keepn))) fatal("memory");
        rc2 = run(b, 15);
        if (rc != rc2 || keepn != lastn || (keepn && !mm_same(keep, last, (long)keepn))) ok = 0;
    }
    ck(ok, "linked-image-behaves-as-the-source-build");

    /* (6): one fault at a time in the directory that just linked */
    if (lib[0] && sy_exists(linked) == 1) {
        size_t ln = 0;
        char *lb;
        at(path, k2, "kit.tsv");
        ck(!forge(k2, kit, (long)kn, "product_sha", 0) && prep(0, k2, tool, other) == 3 && sy_exists(other) != 1, "edited-kit-file-is-tampered");
        ck(!forge(k2, kit, (long)kn, "product_sha", 1) && prep(0, k2, tool, other) == 4 && sy_exists(other) != 1, "kit-of-another-product-is-stale");
        ck(!forge(k2, kit, (long)kn, "self", 1) && prep(0, k2, tool, other) == 4 && sy_exists(other) != 1, "kit-of-other-tlib-tool-sources-is-stale");
        ck(!forge(k2, kit, (long)kn, "image_sha", 1) && prep(0, k2, tool, other) == 3 && sy_exists(other) != 1, "image-that-is-not-the-kits-is-tampered");
        at(dst, k2, lib);
        lb = cx_read(dst, &ln);
        if (lb && ln > 64) lb[ln - 9] ^= 1;
        ck(lb && ln > 64 && !cx_write(path, kit, kn) && !cx_write(dst, lb, ln) && prep(0, k2, tool, other) == 3 && sy_exists(other) != 1,
           "tlib-with-a-changed-byte-is-tampered");
        mm_free(lb);
    }
    sy_printf("CHECK_TLIB_PREP\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
