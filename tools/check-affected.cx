/* Checks tools/affected.cx: sh ./unisacc.com tools/check-affected.cx   (from the repo root)
   --part materials runs material mapping/filter checks without constructing materials.
   AFFECTED_NATIVE=/absolute/path/to/affected uses an already-built affected executable for child calls;
   otherwise calls retain the source-run path. All parts use the same assertions and child deadlines.
   Expected values come from reading the sources (2026-10-30):
   - cx/sys/time.cx: tools/check-cx-sys-spawn.cx uses sysx.net and ext/sysx/net.cx uses time, so
     cx-l0-sys-spawn is affected via use; tools/check-batch-split.cx names "tools/batch-split.cx", which uses
     sys.time, so batch-split is affected via literal-use; tools/check-cxroot.cx reaches no time.cx.
   - tools/tape-gap.cx is named by tools/check-tape-gap.cx, tools/check-unit-frontcache.cx (11 batches),
     and this file: tape-gap-tool via literal plus the 11 unit-frontcache batches (others == 12).
   - tools/refactor/strcmp-truth.tsv likewise: refactor-tool via literal, no other batch but affected-tool.
   - cx/text/text.cx: tools/check-cx-fmt.cx uses text.text directly (cx-l0-fmt via use), and most
     batches do (at least 100); tools/text/text.cx is the same file through the tools/text link, so it
     gives the same summary and reports why=cx/text/text.cx.
   - prd.md and a path that does not exist are named by no batch: batches=0, rc 0.
   - --users cx/mem/heap.cx lists tools/check-cx-sys-spawn.cx (it uses mem.heap) and not
     tools/check-core-alu.cx (core.alu only).
   - --ids with --start-deadline-ms 0 --run starts nothing: both DEFERRED, rc 3; an unknown id and no
     selection are rc 2.
   - --run -j 2 --ids tape-gap-tool runs the real batch through tests/run-batch.cx: one BATCH_RUN line
     with status=PASS, AFFECTED_RUN pass=1 fail=0 deferred=0, rc 0.
   Prints PASS/FAIL lines and CHECK_AFFECTED<TAB>failed=N. */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use sys.time
#pragma unisa use sysx.poll
#pragma unisa use sys.posix
#pragma unisa use sys.env
#pragma unisa use mem.bytes
#pragma unisa use cxlib.toolprep

/* an unlinked spool file the drained output of a bounded child goes to */
static int spool_open(void) {
    char t[4096];
    int fd;
    if (cx_fmt(t, sizeof t, "%s/r2b-XXXXXX", sy_tmpdir())) return -1;
    fd = mkstemp(t);
    if (fd >= 0) sy_unlink(t);
    return fd;
}

/* sy_spawn_pipe with a 50 s deadline: the child's stdout (and stderr when EFD is given) is drained here with sy_poll
   into spool files; past the deadline its process group is killed.  OFD/EFD come back as the spool files, rewound,
   and the child is NOT reaped: the caller's sy_wait_status(pid) still reports its real status (128+9 when killed). */
static int spawn_pipe_bounded(char **argv, const char *cwd, int flags, int *ofd, int *efd) {
    int po = -1, pe = -1, pid, fo, fe = -1, open_o = 1, open_e = efd ? 1 : 0, killed = 0;
    long deadline = sy_now_ms() + 50000;
    char chunk[16384];
    pid = sy_spawn_pipe(argv, cwd, flags, &po, efd ? &pe : 0);
    if (pid < 0) return pid;
    fo = spool_open();
    if (efd) fe = spool_open();
    if (fo < 0 || (efd && fe < 0)) { sy_killpg(pid, 9); sy_signal(pid, 9); sy_close(po); if (efd) sy_close(pe); return -EIO; }
    while (open_o || open_e) {
        sy_pollfd_t p[2];
        int n = 0, io = -1, ie = -1, r;
        long left = deadline - sy_now_ms(), g;
        if (left <= 0) {
            if (killed) break;
            sy_killpg(pid, 9); sy_signal(pid, 9); killed = 1; deadline = sy_now_ms() + 2000;
            continue;
        }
        if (open_o) { io = n; p[n].fd = po; p[n].events = SY_POLLIN; p[n].revents = 0; n++; }
        if (open_e) { ie = n; p[n].fd = pe; p[n].events = SY_POLLIN; p[n].revents = 0; n++; }
        r = sy_poll(p, n, left > 200 ? 200 : left);
        if (r < 0) break;
        if (io >= 0 && p[io].revents) {
            g = sy_read(po, chunk, sizeof chunk);
            if (g > 0) { if (sy_write_all(fo, chunk, g)) break; } else open_o = 0;
        }
        if (ie >= 0 && p[ie].revents) {
            g = sy_read(pe, chunk, sizeof chunk);
            if (g > 0) { if (sy_write_all(fe, chunk, g)) break; } else open_e = 0;
        }
    }
    if (open_o || open_e) { sy_killpg(pid, 9); sy_signal(pid, 9); }
    sy_close(po);
    if (efd) sy_close(pe);
    sy_lseek(fo, 0, 0);
    *ofd = fo;
    if (efd) { sy_lseek(fe, 0, 0); *efd = fe; }
    return pid;
}

#define OUTCAP (1L << 20)
static int failed;
static void ck(int ok, const char *name) { if (!ok) failed++; printf("%s\taffected.%s\n", ok ? "PASS" : "FAIL", name); }

/* ROOT's product and this tool by absolute path, so a fixture cwd can still run them. */
static char root_abs[4096], tool_abs[4400], prod_abs[4400];
static const char *part_wanted = "all";
static int want(const char *part) { return tx_eqz(part_wanted, "all") || tx_eqz(part_wanted, part); }
/* sh ./unisacc.com tools/affected.cx -- ARGS...; stdout into OUT; the exit code, or -1 */
static int tool(char **args, char *out, long cap) {
    char *argv[16]; int i = 0, k, ofd, efd, pid, ex = 0, code = 0, sig = 0; long n = 0, r; char junk[4096];
    { const char *native = getenv("AFFECTED_NATIVE");
      if (native && *native) argv[i++] = (char *)native;
      else {
          argv[i++] = "sh";
          argv[i++] = prod_abs;
          argv[i++] = tool_abs;
          argv[i++] = "--";
      }
    }
    for (k = 0; args[k] && i < 15; k++) argv[i++] = args[k];
    argv[i] = 0;
    pid = spawn_pipe_bounded(argv, 0, SY_SPAWN_STDERR_SPLIT, &ofd, &efd);
    if (pid < 0) return -1;
    while (n < cap - 1 && (r = sy_read(ofd, out + n, cap - 1 - n)) > 0) n += r;
    out[n] = 0;
    while (sy_read(ofd, junk, sizeof junk) > 0) {}
    while (sy_read(efd, junk, sizeof junk) > 0) {}
    sy_close(ofd); sy_close(efd);
    if (sy_wait_status(pid, 0, &ex, &code, &sig) != pid || !ex) return -1;
    return code;
}
static int assembler_verify(const char *dir) {
    char tool[4500],buf[4096];int ofd,efd,ex=0,code=0,sig=0;
    if(cx_fmt(tool,sizeof tool,"%s/tools/asm-material.cx",root_abs))return -1;
    char *v[]={"sh",prod_abs,tool,"--","--verify",root_abs,(char*)dir,0};
    int pid=spawn_pipe_bounded(v,root_abs,SY_SPAWN_STDERR_SPLIT,&ofd,&efd);if(pid<0)return -1;
    while(sy_read(ofd,buf,sizeof buf)>0){}while(sy_read(efd,buf,sizeof buf)>0){}sy_close(ofd);sy_close(efd);
    if(sy_wait_status(pid,0,&ex,&code,&sig)!=pid||!ex)return -1;return code;
}
static int has(const char *out, const char *s) {
    long n=tx_len(out,OUTCAP),m=tx_len(s,512);
    for(long i=0;i+m<=n;i++) if(tx_prefix(out+i,n-i,s,m)) return 1;
    return 0;
}
/* Fact TSV rows have exactly two columns: model and repository-relative input.
   Ignore comments; prose is not part of the fact contract. A null model matches any model. */
static int fact_row(const char *data, const char *model, const char *path) {
    long at = 0, n = tx_len(data, OUTCAP), pn = tx_len(path, 4096), mn = model ? tx_len(model, 128) : 0;
    while (at < n) {
        long e = at, tab, end;
        while (e < n && data[e] != '\n') e++;
        if (data[at] != '#') {
            tab = at; while (tab < e && data[tab] != '\t') tab++;
            end = tab + 1; while (end < e && data[end] != '\t') end++;
            if (tab > at && tab < e && end == e && e - tab - 1 == pn
                && (!model || (tab - at == mn && tx_same(data + at, mn, model, mn)))
                && tx_same(data + tab + 1, pn, path, pn)) return 1;
        }
        at = e + 1;
    }
    return 0;
}
/* the number after KEY in OUT, or -1 */
static long num(const char *out, const char *key) {
    long n = tx_len(out, OUTCAP), kl = tx_len(key, 64), at = 0, v = 0;
    while (at + kl <= n && !tx_prefix(out + at, n - at, key, kl)) at++;
    if (at + kl > n) return -1;
    at += tx_len(key, 64);
    if (out[at] < '0' || out[at] > '9') return -1;
    while (out[at] >= '0' && out[at] <= '9') v = v * 10 + (out[at++] - '0');
    return v;
}
/* AFFECTED lines other than this check's own batches.  The check file names the paths it probes, so
   affected-tool, and now its split batches affected-tiers/list/run, are its own rows and not evidence that
   some other batch writes that path. */
/* the KEY= field (up to CAP-1 chars, tab-terminated) of the `PREPARED<TAB>NAME<TAB>` line; 1 when found */
static int prep_field(const char *out, const char *name, const char *key, char *val, int cap) {
    long i = 0, on = tx_len(out, OUTCAP), kl = tx_len(key, 32), nl = tx_len(name, 128);
    while (i < on) {   /* TSV rows: field 0 PREPARED, field 1 NAME, then KEY=VALUE fields */
        long e = i, f, fe, col = 0, hit = 0;
        while (e < on && out[e] != '\n') e++;
        for (f = i; f <= e; f = fe + 1) {
            for (fe = f; fe < e && out[fe] != '\t'; fe++) {}
            if (col == 0 && !(fe - f == 8 && tx_prefix(out + f, fe - f, "PREPARED", 8))) break;
            if (col == 1) { if (fe - f != nl || !tx_prefix(out + f, fe - f, name, nl)) break; hit = 1; }
            if (col >= 2 && hit && tx_prefix(out + f, fe - f, key, kl)) {
                long m = fe - f - kl; if (m < 1 || m >= cap) return 0;
                return tx_copy(val, cap, out + f + kl, m) == 0;
            }
            col++;
            if (fe >= e) break;
        }
        i = e + 1;
    }
    return 0;
}
static int own(const char *line, long n) {
    static const char *mine[] = {"affected-tool", "affected-tiers", "affected-list", "affected-list2", "affected-run", "affected-iface", "affected-iface2", "affected-hosttcc", "affected-assembler", 0};
    int k; char pre[64];
    for (k = 0; mine[k]; k++) {
        int pl = (int)strlen(mine[k]);
        if (9 + pl + 1 >= (int)sizeof pre) continue;
        if (cx_fmt(pre, sizeof pre, "AFFECTED\t%s\t", mine[k])) continue;
        if (tx_prefix(line, n, pre, 9 + pl + 1)) return 1;
    }
    return 0;
}
/* lines of OUT that start with PRE (PL bytes) */
static long lines(const char *out, const char *pre, long pl) {
    long at = 0, n = tx_len(out, OUTCAP), c = 0;
    while (at < n) {
        long e = at;
        while (e < n && out[e] != '\n') e++;
        if (tx_prefix(out + at, e - at, pre, pl)) c++;
        at = e + 1;
    }
    return c;
}
/* lines of OUT that start with PRE and end with SUF */
static long tails(const char *out, const char *pre, long pl, const char *suf, long sl) {
    long at = 0, n = tx_len(out, OUTCAP), c = 0;
    while (at < n) {
        long e = at;
        while (e < n && out[e] != '\n') e++;
        if (e - at >= pl + sl && tx_prefix(out + at, e - at, pre, pl) && tx_prefix(out + e - sl, sl, suf, sl)) c++;
        at = e + 1;
    }
    return c;
}
/* Count deferred records that carry a platform field, using the output's TSV contract. */
static long deferred_platform_rows(const char *out) {
    long at = 0, n = tx_len(out, OUTCAP), c = 0;
    while (at < n) {
        long e = at, f;
        while (e < n && out[e] != '\n') e++;
        if (tx_prefix(out + at, e - at, "DEFERRED_BY_IFACE\t", 18)) {
            f = at + 18;
            while (f < e) {
                long end = f; while (end < e && out[end] != '\t') end++;
                if (tx_prefix(out + f, end - f, "platform=", 9)) { c++; break; }
                f = end + 1;
            }
        }
        at = e + 1;
    }
    return c;
}
static int others(const char *out) {
    long at = 0, n = tx_len(out, OUTCAP); int c = 0;
    while (at < n) {
        long e = at;
        while (e < n && out[e] != '\n') e++;
        if (tx_prefix(out + at, e - at, "AFFECTED\t", 9) && !own(out + at, e - at)) c++;
        at = e + 1;
    }
    return c;
}


/* Index the independent full-dump oracle once. Each family keeps row offsets in original order;
   queries copy those exact bytes, while the actual CLI --family output is still tested for every key. */
typedef struct { char name[128]; int head, tail; } MaterialFamily;
typedef struct { long at, len; int next; } MaterialRow;
static MaterialFamily mat_family[512];
static MaterialRow mat_row[8192];
static int mat_slots[1024], mat_count, mat_rows;
static int material_index(const char *full, long n) {
    long at = 0; int k;
    mat_count = mat_rows = 0;
    for (k = 0; k < 1024; k++) mat_slots[k] = -1;
    while (at < n) {
        long e = at, f = at, g; int tabs = 0, slot, family; unsigned hash = 2166136261u;
        while (e < n && full[e] != '\n') e++;
        while (f < e && tabs < 2) if (full[f++] == '\t') tabs++;
        g = f; while (g < e && full[g] != '\t') { hash = (hash ^ (unsigned char)full[g]) * 16777619u; g++; }
        if (tabs != 2 || g - f < 1 || g - f >= 128 || e == n || mat_rows == 8192) return -1;
        slot = (int)(hash & 1023u);
        while ((family = mat_slots[slot]) >= 0) {
            if (tx_len(mat_family[family].name, 128) == g - f && tx_prefix(full + f, g - f, mat_family[family].name, g - f)) break;
            slot = (slot + 1) & 1023;
        }
        if (family < 0) {
            if (mat_count == 512 || tx_copy(mat_family[mat_count].name, 128, full + f, g - f)) return -1;
            family = mat_count++; mat_slots[slot] = family;
            mat_family[family].head = mat_family[family].tail = -1;
        }
        mat_row[mat_rows].at = at; mat_row[mat_rows].len = e + 1 - at; mat_row[mat_rows].next = -1;
        if (mat_family[family].tail < 0) mat_family[family].head = mat_rows;
        else mat_row[mat_family[family].tail].next = mat_rows;
        mat_family[family].tail = mat_rows++;
        at = e + 1;
    }
    return mat_count;
}
static long material_projection(int family, const char *full, char *out, long cap) {
    long n = 0; int r;
    for (r = mat_family[family].head; r >= 0; r = mat_row[r].next) {
        long len = mat_row[r].len;
        if (len >= cap - n) return -1;
        if (mm_copy(out + n, cap - n, full + mat_row[r].at, len)) return -1;
        n += len;
    }
    out[n] = 0; return n;
}

int main(int argc, char **argv) {
    static char o[OUTCAP], p[OUTCAP], q[OUTCAP], q2[OUTCAP];
    int rc, rc2;
    {   int k;
        for (k = 1; k < argc; k++) {
            if (tx_eqz(argv[k], "--part") && k + 1 < argc) { part_wanted = argv[++k]; continue; }
            if(tx_eqz(argv[k],"--native")&&k+1<argc){if(argv[k+1][0]!='/'||setenv("AFFECTED_NATIVE",argv[++k],1))return 2;continue;}
            /* a batch row passes its args as space-free tokens, so a bare part name is the same request */
            if (tx_eqz(argv[k], "all") || tx_eqz(argv[k], "tiers") || tx_eqz(argv[k], "list") || tx_eqz(argv[k], "list2") || tx_eqz(argv[k], "run") || tx_eqz(argv[k], "depth") || tx_eqz(argv[k], "iface") || tx_eqz(argv[k], "iface2") || tx_eqz(argv[k], "sym") || tx_eqz(argv[k], "materials") || tx_eqz(argv[k], "hosttcc") || tx_eqz(argv[k], "assembler")) { part_wanted = argv[k]; continue; }
            if (tx_eqz(argv[k], "--")) continue;
            printf("usage: check-affected.cx [--part all|tiers|list|list2|run|materials|hosttcc|depth]\n");
            return 2;
        }
    }
    if (sy_realpath(".", root_abs, sizeof root_abs) < 0) { printf("FAIL\taffected.root\nCHECK_AFFECTED\tfailed=1\n"); return 2; }
    if (cx_fmt(prod_abs, sizeof prod_abs, "%s/unisacc.com", root_abs) || cx_fmt(tool_abs, sizeof tool_abs, "%s/tools/affected.cx", root_abs)) return 2;
    if (!want("tiers") && !want("list") && !want("list2") && !want("run") && !want("iface") && !want("iface2") && !want("sym") && !want("materials") && !want("hosttcc") && !want("assembler")) { printf("FAIL\taffected.part-name\nCHECK_AFFECTED\tfailed=1\n"); return 2; }
    if(want("assembler")) {
        char native_dir[]="/tmp/check-assembler-native-XXXXXX",native[4500],reason[512];
        if(!getenv("AFFECTED_NATIVE")){
            if(!mkdtemp(native_dir)||cx_fmt(native,sizeof native,"%s/affected",native_dir)||tq_native(root_abs,tool_abs,native,reason,sizeof reason)||setenv("AFFECTED_NATIVE",native,1))return 2;
        }
        char *resolve[]={"--materials-dump","--ids","assembler",0};
        rc=tool(resolve,o,OUTCAP);
        ck(rc==0&&tx_eqz(o,"MATERIAL\tassembler\tassembler\ttools/asm-material.cx\n"),"assembler-prepared-row-has-directory-producer");
        char *prepared[]={"--materials-dump","--ids","assembler","--prepare-materials",0};
        rc=tool(prepared,o,OUTCAP);const char *prefix="MATERIAL\tassembler\tassembler\t";size_t pn=strlen(prefix);
        int ready=rc==0&&!strncmp(o,prefix,pn)&&o[pn]=='/'&&!has(o,"REFUSED=")&&lines(o,"MATERIAL\t",9)==1;
        ck(ready,"assembler-prepared-map-is-absolute-and-not-refused");
        if(ready) {
            char material[4400];const char *end=strchr(o+pn,'\n');size_t n=end?(size_t)(end-o-pn):0;
            if(!n||n>=sizeof material||cx_fmt(material,sizeof material,"%.*s",(int)n,o+pn))return 2;
            const char *leaves[]={"assembler.cx","contracts.cx","material.tsv"};char dir[]="/tmp/affected-assembler-XXXXXX";int copied=mkdtemp(dir)!=0;char source[4500],target[4500];
            for(int j=0;j<3;j++){size_t size=0;struct stat st;char *s=0;
                if(cx_fmt(source,sizeof source,"%s/%s",material,leaves[j])||lstat(source,&st)||!S_ISREG(st.st_mode)||!(s=cx_read(source,&size))||!size)copied=0;
                if(s){if(j==2)ck(has(s,"\nstatus\tPREPARED\n"),"assembler-receipt-is-prepared-not-compiled");if(copied&&(cx_fmt(target,sizeof target,"%s/%s",dir,leaves[j])||cx_write(target,s,size)))copied=0;free(s);}
            }
            ck(copied,"assembler-three-real-artifacts-copied-for-negative-control");
            if(copied){ck(assembler_verify(dir)==0,"assembler-private-copy-producer-verifies");
                if(cx_fmt(target,sizeof target,"%s/contracts.cx",dir)||cx_write(target,"tampered\n",9))return 2;
                ck(assembler_verify(dir)==2,"assembler-tampered-contracts-refused");
                for(int j=0;j<3;j++){if(cx_fmt(target,sizeof target,"%s/%s",dir,leaves[j])||unlink(target))return 2;}if(rmdir(dir))return 2;
            }
            rc=tool(prepared,p,OUTCAP);ck(rc==0&&tx_eqz(o,p),"assembler-cache-hit-preserves-exact-material-map");
        }
    }
    if (want("hosttcc")) {
        /* A version-only fixture tests material discovery, never the gcc/tcc differential. */
        char dir[] = "/tmp/affected-hosttcc-XXXXXX", stub[4400], path[16384];
        char *keep_tcc = getenv("TCC") ? strdup(getenv("TCC")) : 0;
        char *keep_path = getenv("PATH") ? strdup(getenv("PATH")) : 0;
        const char *body = "#!/bin/sh\nprintf 'tcc material fixture 1\\n'\n";
        int setup = mkdtemp(dir) != 0 && !cx_fmt(stub, sizeof stub, "%s/tcc", dir)
            && !cx_write(stub, body, strlen(body)) && !chmod(stub, 0700);
        ck(setup, "hosttcc-fixture");
        if (setup) {
            char *prep_args[] = {"--prep-only", "--ids", "random-expr", 0};
            char *run_args[] = {"--ids", "random-expr", "--prepare-materials", "--run", 0};
            setenv("TCC", stub, 1);
            rc = tool(prep_args, o, OUTCAP);
            ck(rc == 0 && has(o, "PREPARED\thosttcc\t") && has(o, stub)
                && has(o, "version=tcc material fixture 1") && has(o, "AFFECTED_PREP\t")
                && !has(o, "BATCH_RUN") && !has(o, "status=PASS"), "hosttcc-env-prepared-only");
            unsetenv("TCC");
            if (cx_fmt(path, sizeof path, "%s:%s", dir, keep_path ? keep_path : "/usr/bin:/bin")) return 2;
            setenv("PATH", path, 1);
            rc = tool(prep_args, o, OUTCAP);
            ck(rc == 0 && has(o, "PREPARED\thosttcc\t") && has(o, stub)
                && !has(o, "BATCH_RUN"), "hosttcc-path-prepared");
            setenv("TCC", "/nonexistent/affected-hosttcc", 1);
            rc = tool(run_args, o, OUTCAP);
            ck(rc == 3 && has(o, "DEFERRED\trandom-expr\tprepare-failed=HOST_TOOL_MISSING:hosttcc:")
                && has(o, "AFFECTED_RUN\tpass=0\tfail=0\tdeferred=1\t")
                && !has(o, "BATCH_RUN") && !has(o, "PREPARED\thosttcc\t"), "hosttcc-missing-deferred-no-fallback");
            sy_unlink(stub); rmdir(dir);
        }
        if (keep_tcc) { setenv("TCC", keep_tcc, 1); free(keep_tcc); } else unsetenv("TCC");
        if (keep_path) { setenv("PATH", keep_path, 1); free(keep_path); } else unsetenv("PATH");
    }
    if (want("tiers")) {
    { char *a[]={"--files","tools/tape-gap.cx","--tier","commit",0};rc=tool(a,o,OUTCAP);ck(rc==0&&has(o,"AFFECTED\ttape-gap-tool\t"),"tier-commit-retains-source"); }
    { char *a[]={"--ids","tape-gap-tool","--tier","daily",0};rc=tool(a,o,OUTCAP);ck(rc==0&&has(o,"SELECTED\ttape-gap-tool\n"),"tier-daily-includes-commit-id"); }
    { char *a[]={"--ids","tape-gap-tool","--tier","release",0};rc=tool(a,o,OUTCAP);ck(rc==0&&has(o,"SELECTED\ttape-gap-tool\n"),"tier-release-includes-commit-id"); }
    { char *a[]={"--files","tools/tape-gap.cx","--tier","unknown",0};rc=tool(a,o,OUTCAP);ck(rc==2,"unknown-tier-refused"); }
    { char *a[]={"--ids","tape-gap-tool","--tier","commit","--run","--hard-deadline-ms","0",0};rc=tool(a,o,OUTCAP);ck(rc==3&&!has(o,"BATCH_RUN"),"tier-run-hard-deadline"); }
    }
    if (want("run")) {
    {   char *a[] = {"--ids", "tape-gap-tool", "refactor-tool", "--run", "--start-deadline-ms", "0", 0};
