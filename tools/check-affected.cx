        ck(rc == 0 && has(o, "MATERIAL\tidentity\tidentity-helper\tseed/ident.c\n"), "identity-helper-has-producer");
        ck(rc == 0 && has(o, "MATERIAL\torigin-package\tsource-origin\t-\tREFUSED=no-producer=source-origin\n"), "unknown-material-still-no-producer");
        ck(rc == 0 && has(o, "MATERIAL\tcx0-bundle\te2model\tunisacc.com\n") && has(o, "MATERIAL\toptimization-ccdiff\thostcc\t/usr/bin/cc\n")
           && has(o, "MATERIAL\tnet-controls\tnets\ttools/net-material.cx\n") && has(o, "MATERIAL\tobjects-link\tobjects\ttools/object-material.cx\n")
           && has(o, "MATERIAL\tstream-lower-independent\tstream-lower-sha\tstreams/streams.json:lower\n")
           && has(o, "MATERIAL\tadopted-package\tcurrent-source-id\tidentity-helper:ROOT\n"), "f4a-producers-resolve");
        {   /* No builds: byte-for-byte repeated default dump, then partition every full row by exact
               material name. Each unique family must equal its ordered full-dump projection; together
               those disjoint projections contain every full row exactly once. */
            int nn = 0, good = 1, j; long total = 0, fulln = tx_len(o, OUTCAP);
            rc = tool(a, p, OUTCAP);
            ck(rc == 0 && tx_eqz(o, p), "materials-default-byte-stable");
            {   /* Explicitly enumerate every batch represented in the legacy unfiltered row stream.
                   Selection must not reorder or duplicate any byte, even with repeated IDs. */
                long pos = 0, nids = 0;
                while (pos < fulln) {
                    long e = pos, f = pos, g, h;
                    while (e < fulln && o[e] != '\n') e++;
                    while (f < e && o[f] != '\t') f++;
                    g = ++f; while (g < e && o[g] != '\t') g++;
                    if (nids) q2[nids++] = ',';
                    for (h = f; h < g && nids < OUTCAP - 1; h++) q2[nids++] = o[h];
                    pos = e + 1;
                }
                q2[nids] = 0;
                { char *allids[] = {"--materials-dump", "--ids", q2, 0};
                  rc = tool(allids, p, OUTCAP);
                  ck(rc == 0 && tx_eqz(o, p), "materials-default-equals-explicit-all-ids-bytes"); }
            }
            nn = material_index(o, fulln);
            if (nn < 0) good = 0;
            {   char *fa[] = {"--materials-dump", "--family-index", 0}; long pos = 0, actual_n;
                rc = tool(fa, p, OUTCAP); actual_n = tx_len(p, OUTCAP);
                if (rc) good = 0;
