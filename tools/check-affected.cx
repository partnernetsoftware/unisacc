              ck(tool(empty, p, OUTCAP) == 0 && !p[0], "materials-known-empty-intersection"); }
        }
    }
    }
    if (want("run")) {
    {   /* F4a: each new producer class PREPARED with the right identity.  Product = the root's own unisacc.com
           sha; host oracle = file sha + a version line; material dirs built by their tool; stream-STAGE-sha =
           streams.json com_sha256 of that stage (from the PREPARED streams material, not the object under test);
           current-source-id = 64 hex from the PREPARED identity-helper. */
        char *a[] = {"--prep-only", "--ids", "cx0-bundle,unit-frontcache-equiv0,optimization-ccdiff,net-controls,objects-link,stream-lower-independent,adopted-package", 0};
        char h[65], want_h[65], sid[17], leaf[4400]; size_t n; char *s;
        rc = tool(a, o, OUTCAP);
        s = cx_read("unisacc.com", &n); if (s) { cx_sha256_hex(s, n, want_h); free(s); } else want_h[0] = 0;
        ck(rc == 0 && prep_field(o, "unitcache-product", "sha256=", h, 65) && want_h[0] && tx_eqz(h, want_h)
           && prep_field(o, "e2model", "sha256=", h, 65) && tx_eqz(h, want_h), "f4a-product-identity");
        s = cx_read("/usr/bin/cc", &n); if (s) { cx_sha256_hex(s, n, want_h); free(s); } else want_h[0] = 0;
        ck(prep_field(o, "hostcc", "sha256=", h, 65) && want_h[0] && tx_eqz(h, want_h) && has(o, "\tpath=/usr/bin/cc\tversion=") && !has(o, "version=\n"), "f4a-host-identity");
        ck(prep_field(o, "nets", "sha256=", h, 65) && prep_field(o, "objects", "sha256=", h, 65), "f4a-material-dirs-prepared");
        ck(prep_field(o, "streams", "id=", sid, 17) && prep_field(o, "stream-lower-sha", "sha256=", h, 65)
