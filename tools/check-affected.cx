                    if (n > actual_n - pos || memcmp(p + pos, q, (size_t)n)) { good = 0; break; } pos += n;
                    if (cx_fmt(tag, sizeof tag, "INDEX_END\t%s\n", mat_family[j].name)) { good = 0; break; }
                    tn = tx_len(tag, sizeof tag);
                    if (tn > actual_n - pos || memcmp(p + pos, tag, (size_t)tn)) { good = 0; break; } pos += tn;
                    total += n;
