#pragma unisa use core.output
#pragma unisa use text.text
void core_host_panic(const char *s){fprintf(stderr,"unexpected panic: %s\n",s);exit(2);}
int main(void){
 CxCoreBuffer b={0};int failed=0;for(int i=0;i<257;i++)core_buffer_put(&b,i,i*3);
 if(b.n!=257||b.cap!=512||b.b[0]!=0||b.b[256]!=0||b.at[256]!=768)failed++;
 if(core_field_fill(&b,10,5,-12)||!tx_same((const char *)b.b+10,5,"  -12",5))failed++;
 if(core_field_fill(&b,10,1,12)!=1||!tx_same((const char *)b.b+10,5,"  -12",5))failed++;
 char text[32];int n=core_decimal(text,INT64_MIN);if(n!=20||!tx_same(text,20,"-9223372036854775808",20))failed++;
 free(b.b);free(b.at);printf("CXCORE_OUTPUT failed=%d\n",failed);return failed?1:0;
}
