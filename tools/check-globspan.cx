/* tools/check-globspan.cx -- tool self-check of cxlib.globspan.
 * Batch globspan. Byte-span matching, including nonterminated input,
 * optional '?' semantics and large adjacent-star runs. */
#pragma unisa use cxlib.globspan
#pragma unisa use sys.io

int main(void) {
    char stars[4096], bytes[3] = {'a', 0, 'b'}; long i; int failures = 0;
    for (i = 0; i < (long)sizeof stars; i++) stars[i] = '*';
    failures += !glob_span(stars, sizeof stars, "x/y", 3);
    failures += !glob_span(0, 0, 0, 0);
    failures += glob_span("?", 1, "a", 1);
    failures += !glob_span("?", 1, "?", 1);
    failures += !glob_span_mode("?", 1, "a", 1, 1);
    failures += glob_span_mode("?", 1, "", 0, 1);
    failures += !glob_span("a*b*c", 5, "ab/b/bc", 7);
    failures += glob_span("a*b*c", 5, "ab/b/bx", 7);
    failures += !glob_span(bytes, 3, bytes, 3);
    failures += glob_span(bytes, 2, bytes, 3);
    sy_printf("CHECK_GLOBSPAN\tchecks=10\tfailed=%d\n", failures);
    return failures != 0;
}
