/* Static NN preparation and read-only verification; neither is a test PASS. */
#pragma unisa use cxlib.richain
#pragma unisa use text.text
int main(int argc,char **argv){int verify=argc==4&&tx_eq(argv[1], "--verify", 1L << 20);if(verify){argc--;argv++;}if(argc!=3){fputs("usage: ROOT NEW_ABS_OUT | --verify ROOT ABS_OUT\n",stderr);return 2;}char why[1400];int rc=verify?rcm_verify(argv[1],argv[2],why,sizeof why):rcm_prepare(argv[1],argv[2],why,sizeof why);if(rc){fprintf(stderr,"ri-chain-material: REFUSE %s\n",why);return 2;}puts(verify?"VERIFIED\tri-chain-material\tno-test-result":"PREPARED\tri-chain-material\tno-test-result");return 0;}
