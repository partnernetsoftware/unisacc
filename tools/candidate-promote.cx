/* Transfer an installed or independently verified staged frozen candidate.
 * The original record is copied byte-for-byte; target sources are not claimed
 * to match the frozen source. No construction, signing or publication. */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.kernelsha
#pragma unisa use cxlib.mixedprofiles
#pragma unisa use text.text
static char origin[4096],generation[4096],packages[4096],target[4096],evidence[4096];
static const char *old_product,*old_record,*new_product,*new_source,*new_record,*new_native,*new_package,*install_stdout,*install_sha;
static int mixed_v2,staged_v2;
static const char *origin_product_leaf(void){return staged_v2?".unisacc-c43-native.next":"unisacc.com";}
static const char *origin_record_leaf(void){return staged_v2?".unisacc-c43-native.next.build.json":"unisacc.com.build.json";}
static const char *transfer_scope(void){return staged_v2?"byte-transfer-of-verified-staged-candidate;frozen-bootstrap-preserved;prior-admission-not-reexecuted;target-live-source-not-qualified;no-functional-PASS":"byte-transfer-of-installed-frozen-candidate;prior-admission-not-reexecuted;target-live-source-not-qualified;no-functional-PASS";}
static char tool_root[4096];
static const char *prepared_sha,*package_receipt_sha;
static mp_profile material_role;
typedef struct {char witness[65],package_context[65],helper_sha[65];} Endpoint;
static void die(const char *s){fprintf(stderr,"candidate-promote: REFUSE %s errno=%d; backups and partial outputs retained\n",s,errno);exit(2);}
static void path(char p[4400],const char *base,const char *leaf){if(cx_path_join(p,4400,base,leaf))die("path-bound");}
static int hex(const char *s){if(strlen(s)!=64)return 0;for(int i=0;i<64;i++)if(!((s[i]>='0'&&s[i]<='9')||(s[i]>='a'&&s[i]<='f')))return 0;return 1;}
static int clean(const char *s){return s[0]=='/'&&!strpbrk(s,"\r\n\t");}
static void digest(const char *p,size_t n,char h[65]){if(n<65536){cx_sha256_hex(p,n,h);return;}static int ready;if(!ready){char test[65];if(ks_sha256_hex("",0,test)||!tx_eq(test, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", 1L << 20)||ks_sha256_hex("abc",3,test)||!tx_eq(test, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", 1L << 20))die("kernel-sha256-selfcheck");ready=1;}if(ks_sha256_hex(p,n,h))die("kernel-sha256-buffer");}
static char *readexact(const char *file,size_t *n,const char *expected){
 struct stat a,b;int fd=open(file,O_RDONLY|O_NONBLOCK|O_NOFOLLOW|O_CLOEXEC);if(fd<0)die("input-open");
 if(fstat(fd,&a)||!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>268435456){close(fd);die("bounded-regular-input");}*n=(size_t)a.st_size;char *p=malloc(*n+1);if(!p){close(fd);die("allocation");}
 size_t at=0;int bad=0;while(at<*n){ssize_t z=read(fd,p+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0){bad=1;break;}at+=(size_t)z;}
 char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);if(z||fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size)bad=1;if(close(fd))bad=1;if(bad){free(p);die("input-extent-or-close");}p[*n]=0;
 if(expected){char h[65];digest(p,*n,h);if(!tx_eq(h, expected, 1L << 20)){fprintf(stderr,"candidate-promote: path=%s expected=%s actual=%s\n",file,expected,h);free(p);die("endpoint-digest-mismatch");}}return p;
}
static void check(const char *base,const char *leaf,const char *expected){char p[4400];size_t n;path(p,base,leaf);char *s=readexact(p,&n,expected);free(s);}
static void save(const char *file,const char *p,size_t n,int mode){int fd=open(file,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,mode);if(fd<0)die("exclusive-output");size_t at=0;while(at<n){ssize_t z=write(fd,p+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0){close(fd);die("output-write");}at+=(size_t)z;}int sync=fsync(fd),closed=close(fd);if(sync||closed)die("output-sync-or-close");}
static void saved(const char *leaf,const char *p,size_t n,int mode){char file[4400];path(file,evidence,leaf);save(file,p,n,mode);}
static void syncdir(const char *dir){int fd=open(dir,O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW);if(fd<0)die("directory-open");int sync=fsync(fd),closed=close(fd);if(sync||closed)die("directory-sync-or-close");}
static void origin_bytes(void){check(origin,origin_product_leaf(),new_product);check(origin,origin_record_leaf(),new_record);if(staged_v2){check(origin,"unisacc.com",old_product);check(origin,"unisacc.com.build.json",old_record);}}
static void endpoints(void){origin_bytes();check(generation,"unisacc-next.com",new_product);check(generation,"unisacc-next.com.native.tsv",new_native);check(generation,"bootstrap-before-install.com",old_product);check(generation,"bootstrap-before-install.com.build.json",old_record);check(packages,"compiler.pkg",new_package);size_t n;char *s=readexact(install_stdout,&n,install_sha);free(s);check(target,"unisacc.com",old_product);check(target,"unisacc.com.build.json",old_record);}
/* These metadata inputs are externally pinned before this consumer runs.
 * Extract unique complete TSV fields, never substrings or observed expectations. */
static void field(const char *s,size_t n,const char *schema,const char *key,char out[4400]){
 size_t sn=strlen(schema),kn=strlen(key);if(n<sn||n>65536||memcmp(s,schema,sn)||s[n-1]!='\n'||memchr(s,0,n)||memchr(s,'\r',n))die("mixed-v2-metadata-wire");int found=0;size_t at=sn;
 while(at<n){const char *end=memchr(s+at,'\n',n-at),*tab=end?memchr(s+at,'\t',(size_t)(end-s-at)):0;if(!end||!tab||tab==s+at||tab+1==end||memchr(tab+1,'\t',(size_t)(end-tab-1)))die("mixed-v2-metadata-row");if((size_t)(tab-s-at)==kn&&!memcmp(s+at,key,kn)){size_t z=(size_t)(end-tab-1);if(++found!=1||z>=4400)die("mixed-v2-metadata-unique-field");{ void *cx_kept = memcpy(out,tab+1,z); (void)cx_kept; }out[z]=0;}at=(size_t)(end-s)+1;}if(found!=1)die("mixed-v2-metadata-missing-field");
}
static void bound_field(const char *s,size_t n,const char *schema,const char *key,const char *expected){char actual[4400];field(s,n,schema,key,actual);if(!tx_eq(actual, expected, 1L << 20))die("mixed-v2-metadata-binding");}
static void mixed_install_receipt(const char *log,size_t in,Endpoint *out,np_buf *proof){
 const char *ps="source-package-mixed-v2\n",*cs="source-package-mixed-context-v2\n",*ns="native-development-construction-v2\n";char p[4400],kernel[4400],context[4400],manifest[4400],build[4400],h[65],wire[1200];size_t n;
 path(p,packages,"package.tsv");char *pkg=readexact(p,&n,package_receipt_sha);bound_field(pkg,n,ps,"material-profile",material_role.id);bound_field(pkg,n,ps,"root",origin);bound_field(pkg,n,ps,"pack-context",packages);bound_field(pkg,n,ps,"source",new_source);bound_field(pkg,n,ps,"origin-source",material_role.origin_source);bound_field(pkg,n,ps,"origin-spec",material_role.origin_spec);bound_field(pkg,n,ps,"kernel-generation",generation);bound_field(pkg,n,ps,"compiler.pkg",new_package);bound_field(pkg,n,ps,"bootstrap-sha",old_product);bound_field(pkg,n,ps,"bootstrap-record-sha",old_record);field(pkg,n,ps,"mixed-context",context);field(pkg,n,ps,"kernel-context",kernel);field(pkg,n,ps,"model-inputs.tsv",manifest);if(!hex(context)||!hex(kernel)||!hex(manifest))die("mixed-v2-package-hash-field");free(pkg);memcpy(out->package_context,context,65);
 path(p,packages,"context.tsv");char *ctx=readexact(p,&n,context);bound_field(ctx,n,cs,"material-profile",material_role.id);bound_field(ctx,n,cs,"source-root",origin);bound_field(ctx,n,cs,"tool-root",tool_root);bound_field(ctx,n,cs,"root",origin);bound_field(ctx,n,cs,"source",new_source);bound_field(ctx,n,cs,"origin-source",material_role.origin_source);bound_field(ctx,n,cs,"origin-spec",material_role.origin_spec);bound_field(ctx,n,cs,"pack-context",packages);bound_field(ctx,n,cs,"kernel-generation",generation);path(p,generation,"identity-helper");bound_field(ctx,n,cs,"identity-helper-path",p);char helper_pin[4400];field(ctx,n,cs,"identity-helper-sha",helper_pin);if(!hex(helper_pin))die("mixed-v2-identity-helper-pin-shape");memcpy(out->helper_sha,helper_pin,65);free(ctx);check(packages,"model-inputs.tsv",manifest);
 path(p,generation,"unisacc-next.com.native.tsv");char *native=readexact(p,&n,new_native);bound_field(native,n,ns,"source",new_source);bound_field(native,n,ns,"artifact",new_product);bound_field(native,n,ns,"material-profile",material_role.id);bound_field(native,n,ns,"source-root",origin);bound_field(native,n,ns,"tool-root",tool_root);bound_field(native,n,ns,"package",new_package);free(native);
 path(p,generation,"candidate-install-prepared.tsv");char *prepared=readexact(p,&n,prepared_sha);field(prepared,n,"candidate-install-prepared-v1\n","context",build);if(!hex(build))die("mixed-v2-prepared-context");int z=snprintf(wire,sizeof wire,"candidate-install-prepared-v1\nsource\t%s\nproduct\t%s\npackage\t%s\ncontext\t%s\nkernel\t%s\nbootstrap\t%s\nbuilder-record\t%s\nroot-record\t%s\nnext-record\t%s\n",new_source,new_product,new_package,build,kernel,old_product,old_record,old_record,new_record);if(z<0||(size_t)z>=sizeof wire||n!=(size_t)z||memcmp(prepared,wire,n))die("mixed-v2-prepared-receipt-content");free(prepared);
 path(p,generation,"unisacc-next.com.native-build.tsv");char *receipt=readexact(p,&n,0);z=snprintf(wire,sizeof wire,"PREPARED\tnative-product\tno-test-result\ncontext\t%s\nartifact\t%s\n",build,new_product);if(z<0||(size_t)z>=sizeof wire||n!=(size_t)z||memcmp(receipt,wire,n))die("mixed-v2-product-receipt-content");digest(receipt,n,h);free(receipt);np_puts(proof,h);np_puts(proof,"\n");
 path(p,generation,"context.sha256");char *kc=readexact(p,&n,0);if(n!=65||memcmp(kc,kernel,64)||kc[64]!='\n')die("mixed-v2-kernel-context-content");free(kc);
 np_buf expected={0};np_puts(&expected,"MATERIAL_OBSERVATION\tsource-package-mixed-v2\tmaterial-profile=");np_puts(&expected,material_role.id);np_puts(&expected,"\tsource-root=");np_puts(&expected,origin);np_puts(&expected,"\ttool-root=");np_puts(&expected,tool_root);np_puts(&expected,"\texecutable-provenance=UNVERIFIED\tno-test-result\n");np_puts(&expected,staged_v2?"VERIFIED\tstaged-development-candidate\tno-release-qualification\nartifact\t":"INSTALLED\tdevelopment-only\tno-release-qualification\nartifact\t");np_puts(&expected,new_product);np_puts(&expected,"\nsource\t");np_puts(&expected,new_source);np_puts(&expected,"\nprevious\t");np_puts(&expected,old_product);np_puts(&expected,"\n");if(in!=expected.n||memcmp(log,expected.p,in))die("mixed-v2-install-receipt-content");free(expected.p);
 np_puts(proof,"mixed-v2\n");np_puts(proof,material_role.id);np_puts(proof,"\n");np_puts(proof,tool_root);np_puts(proof,"\n");np_puts(proof,prepared_sha);np_puts(proof,"\n");np_puts(proof,package_receipt_sha);np_puts(proof,"\n");np_puts(proof,context);np_puts(proof,"\n");np_puts(proof,manifest);np_puts(proof,"\n");
}
static Endpoint installed(void){char helper[4400],p[4400],why[2048],h[65];size_t n,pn,rn;Endpoint result={0};np_buf mixed_proof={0};if(mixed_v2){size_t in;char *log=readexact(install_stdout,&in,install_sha);mixed_install_receipt(log,in,&result,&mixed_proof);free(log);}path(p,generation,"identity-helper.sha256");char *hs=readexact(p,&n,0);if(n!=64||!hex(hs))die("identity-helper-recorded-sha256");if(mixed_v2&&!tx_eq(hs, result.helper_sha, 1L << 20))die("mixed-v2-identity-helper-record-binding");path(helper,generation,"identity-helper");char *s=readexact(helper,&n,mixed_v2?result.helper_sha:hs);free(s);memcpy(h,hs,65);free(hs);
 char *v[]={helper,origin,0};np_result r={0};if(np_run(v,origin,0,15,&r,why,sizeof why)||r.rc||r.errn||r.outn!=65||r.out[64]!='\n'||memcmp(r.out,new_source,64))die("fresh-frozen-source-identity");np_free(&r);
 path(p,origin,origin_product_leaf());char *product=readexact(p,&pn,new_product);char *verify[]={helper,origin,"check",p,0};if(np_run(verify,origin,0,15,&r,why,sizeof why)||r.rc||r.errn)die("installed-product-record-check");char expected[256];int z=snprintf(expected,sizeof expected,"product freshness: verified %s\n",new_product);if(z<0||(size_t)z!=r.outn||memcmp(expected,r.out,r.outn))die("installed-product-record-check-output");np_free(&r);
 path(p,origin,origin_record_leaf());char *record=readexact(p,&rn,new_record);z=snprintf(expected,sizeof expected,"\n  \"native_construction_sha256\": \"%s\"\n",new_native);if(z<0||(size_t)z>=sizeof expected||np_count(record,rn,"\"native_construction_sha256\"",strlen("\"native_construction_sha256\""))!=1||!strstr(record,expected))die("installed-native-record-binding");free(record);
 path(p,packages,"compiler.pkg");char *pkg=readexact(p,&n,new_package);unsigned long long embedded=0;if(pn<16||memcmp(product+pn-16,"UNIPKG1\n",8))die("installed-package-footer");for(int i=7;i>=0;i--)embedded=(embedded<<8)|(unsigned char)product[pn-8+i];if(embedded!=n||n>pn-16||memcmp(product+pn-16-n,pkg,n))die("installed-package-identity");free(pkg);free(product);
 if(!mixed_v2){size_t in;char *log=readexact(install_stdout,&in,install_sha);char wire[1024];z=snprintf(wire,sizeof wire,"INSTALLED\tdevelopment-only\tno-release-qualification\nartifact\t%s\nsource\t%s\nprevious\t%s\nbytes\t%lu\n",new_product,new_source,old_product,(unsigned long)pn);if(z<0||(size_t)z>=sizeof wire||in!=(size_t)z||memcmp(log,wire,in))die("regular-install-receipt-content");free(log);}
 path(p,generation,"identity-helper");s=readexact(p,&n,h);free(s);np_buf proof={0};np_puts(&proof,mixed_v2?"installed-candidate-transfer-endpoint-v2\n":"installed-candidate-transfer-endpoint-v1\n");const char *values[]={new_product,new_source,new_record,new_native,new_package,install_sha,h,old_product,old_record};for(int i=0;i<9;i++){np_puts(&proof,values[i]);np_puts(&proof,"\n");}if(mixed_v2)np_put(&proof,mixed_proof.p,mixed_proof.n);free(mixed_proof.p);digest(proof.p,proof.n,result.witness);free(proof.p);return result;
}
int main(int argc,char **argv){
 if((argc==19||argc==21)&&(tx_eq(argv[1], "--mixed-v2", 1L << 20)||tx_eq(argv[1], "--staged-v2", 1L << 20))){
  staged_v2=!strcmp(argv[1],"--staged-v2");
  int at=2;const char *id="f9-ace3-v1";if(argc==21){if(!tx_eq(argv[2], "--material-profile", 1L << 20))die("mixed-v2-material-profile-option");id=argv[3];at=4;}
  if(!mp_get(id,&material_role)||material_role.origin_context_version!=2||!material_role.current_source||!hex(material_role.current_source)||!material_role.origin_source||!hex(material_role.origin_source)||!material_role.origin_spec||!hex(material_role.origin_spec))die("mixed-v2-registered-material-profile-required");
  if(!clean(argv[at])||!realpath(argv[at],tool_root)||!tx_eq(argv[at], tool_root, 1L << 20)||!hex(argv[at+1])||!hex(argv[at+2]))die("mixed-v2-explicit-expected-inputs");mixed_v2=1;prepared_sha=argv[at+1];package_receipt_sha=argv[at+2];argc-=at+2;argv+=at+2;
 }
 if(argc!=15){fputs("usage: [--mixed-v2|--staged-v2 [--material-profile PROFILE] TOOL_ROOT PREPARED_SHA PACKAGE_RECEIPT_SHA] ORIGIN_ROOT GEN PACKAGE_DIR TARGET_ROOT NEW_ABS_EVIDENCE OLD_PRODUCT_SHA OLD_RECORD_SHA NEW_PRODUCT_SHA NEW_SOURCE_SID NEW_RECORD_SHA NATIVE_RECEIPT_SHA PACKAGE_SHA ADMISSION_STDOUT ADMISSION_STDOUT_SHA\n",stderr);return 2;}
 for(int i=1;i<=5;i++)if(!clean(argv[i]))die("absolute-clean-path-required");if(!clean(argv[13]))die("absolute-install-receipt-required");for(int i=6;i<=12;i++)if(!hex(argv[i]))die("expected-sha256-required");if(!hex(argv[14]))die("expected-install-receipt-sha256-required");
 if(!realpath(argv[1],origin)||!realpath(argv[2],generation)||!realpath(argv[3],packages)||!realpath(argv[4],target))die("existing-root-paths");if(tx_eq(origin, target, 1L << 20))die("distinct-origin-and-target-required");
 old_product=argv[6];old_record=argv[7];new_product=argv[8];new_source=argv[9];new_record=argv[10];new_native=argv[11];new_package=argv[12];install_stdout=argv[13];install_sha=argv[14];
 if(mixed_v2&&!tx_eq(new_source, material_role.current_source, 1L << 20))die("mixed-v2-material-profile-source");
 if(strlen(argv[5])>=sizeof evidence)die("evidence-path-bound");{ if (cx_fmt(evidence, sizeof evidence, "%s", argv[5])) { fprintf(stderr, "candidate-promote: text too long for evidence\n"); exit(2); } }endpoints();Endpoint before=installed();endpoints();
 if(mkdir(evidence,0700))die("new-evidence-directory-required");char canonical[4096];if(!realpath(evidence,canonical)||!tx_eq(canonical, evidence, 1L << 20))die("canonical-evidence-path-required");
 char p[4400];size_t pn,rn,on;path(p,origin,origin_product_leaf());char *product=readexact(p,&pn,new_product);path(p,origin,origin_record_leaf());char *record=readexact(p,&rn,new_record);path(p,target,"unisacc.com");char *old=readexact(p,&on,old_product);saved("previous.com",old,on,0700);free(old);path(p,target,"unisacc.com.build.json");old=readexact(p,&on,old_record);saved("previous.com.build.json",old,on,0600);free(old);
 saved("promoted.com",product,pn,0700);saved("promoted.com.build.json",record,rn,0600);path(p,generation,"unisacc-next.com.native.tsv");old=readexact(p,&on,new_native);saved("promoted.com.native.tsv",old,on,0600);free(old);old=readexact(install_stdout,&on,install_sha);saved("origin-install.stdout",old,on,0600);free(old);
 if(mixed_v2){path(p,generation,"candidate-install-prepared.tsv");old=readexact(p,&on,prepared_sha);saved("origin-install-prepared.tsv",old,on,0600);free(old);path(p,packages,"package.tsv");old=readexact(p,&on,package_receipt_sha);saved("origin-package.tsv",old,on,0600);free(old);path(p,packages,"context.tsv");old=readexact(p,&on,before.package_context);saved("origin-context.tsv",old,on,0600);free(old);}
 char stage[4400],stage_record[4400],dest[4400],dest_record[4400];path(stage,target,".unisacc-candidate-promote.next");path(stage_record,target,".unisacc-candidate-promote.next.build.json");save(stage,product,pn,0700);save(stage_record,record,rn,0600);free(product);free(record);
 np_buf receipt={0};np_puts(&receipt,mixed_v2?"candidate-promotion-v2\norigin-root\t":"candidate-promotion-v1\norigin-root\t");np_puts(&receipt,origin);np_puts(&receipt,"\ngeneration\t");np_puts(&receipt,generation);np_puts(&receipt,"\npackage-dir\t");np_puts(&receipt,packages);np_puts(&receipt,"\ntarget-root\t");np_puts(&receipt,target);np_puts(&receipt,"\nprevious-product\t");np_puts(&receipt,old_product);np_puts(&receipt,"\nprevious-record\t");np_puts(&receipt,old_record);np_puts(&receipt,"\nproduct\t");np_puts(&receipt,new_product);np_puts(&receipt,"\nrecord\t");np_puts(&receipt,new_record);np_puts(&receipt,"\nfrozen-source\t");np_puts(&receipt,new_source);np_puts(&receipt,"\nnative-receipt\t");np_puts(&receipt,new_native);
 np_puts(&receipt,"\npackage\t");np_puts(&receipt,new_package);np_puts(&receipt,"\norigin-install-stdout\t");np_puts(&receipt,install_stdout);np_puts(&receipt,"\norigin-install-stdout-sha\t");np_puts(&receipt,install_sha);if(mixed_v2){np_puts(&receipt,staged_v2?"\ninstall-protocol\tstaged-v2\nmaterial-profile\t":"\ninstall-protocol\tmixed-v2\nmaterial-profile\t");np_puts(&receipt,material_role.id);np_puts(&receipt,"\ntool-root\t");np_puts(&receipt,tool_root);np_puts(&receipt,"\norigin-install-prepared-sha\t");np_puts(&receipt,prepared_sha);np_puts(&receipt,"\norigin-package-receipt-sha\t");np_puts(&receipt,package_receipt_sha);np_puts(&receipt,"\norigin-package-context-sha\t");np_puts(&receipt,before.package_context);}np_puts(&receipt,"\nendpoint-before\t");np_puts(&receipt,before.witness);np_puts(&receipt,"\nscope\t");np_puts(&receipt,transfer_scope());np_puts(&receipt,"\n");saved("prepared.tsv",receipt.p,receipt.n,0600);syncdir(evidence);syncdir(target);
 Endpoint final=installed();if(!tx_eq(before.witness, final.witness, 1L << 20))die("frozen-installed-endpoints-changed");check(evidence,"previous.com",old_product);check(evidence,"previous.com.build.json",old_record);check(evidence,"promoted.com",new_product);check(evidence,"promoted.com.build.json",new_record);check(evidence,"promoted.com.native.tsv",new_native);check(evidence,"origin-install.stdout",install_sha);check(target,".unisacc-candidate-promote.next",new_product);check(target,".unisacc-candidate-promote.next.build.json",new_record);endpoints();
 if(mixed_v2){check(evidence,"origin-install-prepared.tsv",prepared_sha);check(evidence,"origin-package.tsv",package_receipt_sha);check(evidence,"origin-context.tsv",before.package_context);}
 path(dest,target,"unisacc.com");path(dest_record,target,"unisacc.com.build.json");if(rename(stage,dest))die("product-rename-failed");if(rename(stage_record,dest_record))die("product-promoted-record-rename-failed");syncdir(target);
 check(target,"unisacc.com",new_product);check(target,"unisacc.com.build.json",new_record);origin_bytes();check(generation,"unisacc-next.com.native.tsv",new_native);
 np_puts(&receipt,"endpoint-final\t");np_puts(&receipt,final.witness);np_puts(&receipt,"\nstatus\tPROMOTED-development-only-no-test-result\n");saved("receipt.tsv",receipt.p,receipt.n,0600);free(receipt.p);syncdir(evidence);printf("PROMOTED\tdevelopment-only\tproduct=%s\tfrozen-source=%s\trecord=%s\n",new_product,new_source,new_record);return 0;
}
