/* Transfer an already installed, previously admitted frozen candidate.
 * The original record is copied byte-for-byte; target sources are not claimed
 * to match the frozen source. No construction, signing or publication. */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.kernelsha
static char origin[4096],generation[4096],packages[4096],target[4096],evidence[4096];
static const char *old_product,*old_record,*new_product,*new_source,*new_record,*new_native,*new_package,*install_stdout,*install_sha;
typedef struct {char witness[65];} Endpoint;
static void die(const char *s){fprintf(stderr,"candidate-promote: REFUSE %s errno=%d; backups and partial outputs retained\n",s,errno);exit(2);}
static void path(char p[4400],const char *base,const char *leaf){if(cx_path_join(p,4400,base,leaf))die("path-bound");}
static int hex(const char *s){if(strlen(s)!=64)return 0;for(int i=0;i<64;i++)if(!((s[i]>='0'&&s[i]<='9')||(s[i]>='a'&&s[i]<='f')))return 0;return 1;}
static int clean(const char *s){return s[0]=='/'&&!strpbrk(s,"\r\n\t");}
static void digest(const char *p,size_t n,char h[65]){if(n<65536){cx_sha256_hex(p,n,h);return;}static int ready;if(!ready){char test[65];if(ks_sha256_hex("",0,test)||strcmp(test,"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")||ks_sha256_hex("abc",3,test)||strcmp(test,"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"))die("kernel-sha256-selfcheck");ready=1;}if(ks_sha256_hex(p,n,h))die("kernel-sha256-buffer");}
static char *readexact(const char *file,size_t *n,const char *expected){
 struct stat a,b;int fd=open(file,O_RDONLY|O_NONBLOCK|O_NOFOLLOW|O_CLOEXEC);if(fd<0)die("input-open");
 if(fstat(fd,&a)||!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>268435456){close(fd);die("bounded-regular-input");}*n=(size_t)a.st_size;char *p=malloc(*n+1);if(!p){close(fd);die("allocation");}
 size_t at=0;int bad=0;while(at<*n){ssize_t z=read(fd,p+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0){bad=1;break;}at+=(size_t)z;}
 char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);if(z||fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size)bad=1;if(close(fd))bad=1;if(bad){free(p);die("input-extent-or-close");}p[*n]=0;
 if(expected){char h[65];digest(p,*n,h);if(strcmp(h,expected)){fprintf(stderr,"candidate-promote: path=%s expected=%s actual=%s\n",file,expected,h);free(p);die("endpoint-digest-mismatch");}}return p;
}
static void check(const char *base,const char *leaf,const char *expected){char p[4400];size_t n;path(p,base,leaf);char *s=readexact(p,&n,expected);free(s);}
static void save(const char *file,const char *p,size_t n,int mode){int fd=open(file,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,mode);if(fd<0)die("exclusive-output");size_t at=0;while(at<n){ssize_t z=write(fd,p+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0){close(fd);die("output-write");}at+=(size_t)z;}int sync=fsync(fd),closed=close(fd);if(sync||closed)die("output-sync-or-close");}
static void saved(const char *leaf,const char *p,size_t n,int mode){char file[4400];path(file,evidence,leaf);save(file,p,n,mode);}
static void syncdir(const char *dir){int fd=open(dir,O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW);if(fd<0)die("directory-open");int sync=fsync(fd),closed=close(fd);if(sync||closed)die("directory-sync-or-close");}
static void endpoints(void){check(origin,"unisacc.com",new_product);check(origin,"unisacc.com.build.json",new_record);check(generation,"unisacc-next.com",new_product);check(generation,"unisacc-next.com.native.tsv",new_native);check(generation,"bootstrap-before-install.com",old_product);check(generation,"bootstrap-before-install.com.build.json",old_record);check(packages,"compiler.pkg",new_package);size_t n;char *s=readexact(install_stdout,&n,install_sha);free(s);check(target,"unisacc.com",old_product);check(target,"unisacc.com.build.json",old_record);}
static Endpoint installed(void){char helper[4400],p[4400],why[2048],h[65];size_t n,pn,rn;path(p,generation,"identity-helper.sha256");char *hs=readexact(p,&n,0);if(n!=64||!hex(hs))die("identity-helper-recorded-sha256");path(helper,generation,"identity-helper");char *s=readexact(helper,&n,hs);free(s);memcpy(h,hs,65);free(hs);
 char *v[]={helper,origin,0};np_result r={0};if(np_run(v,origin,0,15,&r,why,sizeof why)||r.rc||r.errn||r.outn!=65||r.out[64]!='\n'||memcmp(r.out,new_source,64))die("fresh-frozen-source-identity");np_free(&r);
 path(p,origin,"unisacc.com");char *product=readexact(p,&pn,new_product);char *verify[]={helper,origin,"check",p,0};if(np_run(verify,origin,0,15,&r,why,sizeof why)||r.rc||r.errn)die("installed-product-record-check");char expected[256];int z=snprintf(expected,sizeof expected,"product freshness: verified %s\n",new_product);if(z<0||(size_t)z!=r.outn||memcmp(expected,r.out,r.outn))die("installed-product-record-check-output");np_free(&r);
 path(p,origin,"unisacc.com.build.json");char *record=readexact(p,&rn,new_record);z=snprintf(expected,sizeof expected,"\n  \"native_construction_sha256\": \"%s\"\n",new_native);if(z<0||(size_t)z>=sizeof expected||np_count(record,rn,"\"native_construction_sha256\"",strlen("\"native_construction_sha256\""))!=1||!strstr(record,expected))die("installed-native-record-binding");free(record);
 path(p,packages,"compiler.pkg");char *pkg=readexact(p,&n,new_package);unsigned long long embedded=0;if(pn<16||memcmp(product+pn-16,"UNIPKG1\n",8))die("installed-package-footer");for(int i=7;i>=0;i--)embedded=(embedded<<8)|(unsigned char)product[pn-8+i];if(embedded!=n||n>pn-16||memcmp(product+pn-16-n,pkg,n))die("installed-package-identity");free(pkg);free(product);
 size_t in;char *log=readexact(install_stdout,&in,install_sha);char wire[1024];z=snprintf(wire,sizeof wire,"INSTALLED\tdevelopment-only\tno-release-qualification\nartifact\t%s\nsource\t%s\nprevious\t%s\nbytes\t%lu\n",new_product,new_source,old_product,(unsigned long)pn);if(z<0||(size_t)z>=sizeof wire||in!=(size_t)z||memcmp(log,wire,in))die("regular-install-receipt-content");free(log);
 path(p,generation,"identity-helper");s=readexact(p,&n,h);free(s);Endpoint result={0};np_buf proof={0};np_puts(&proof,"installed-candidate-transfer-endpoint-v1\n");const char *values[]={new_product,new_source,new_record,new_native,new_package,install_sha,h,old_product,old_record};for(int i=0;i<9;i++){np_puts(&proof,values[i]);np_puts(&proof,"\n");}digest(proof.p,proof.n,result.witness);free(proof.p);return result;
}
int main(int argc,char **argv){
 if(argc!=15){fputs("usage: ORIGIN_ROOT GEN PACKAGE_DIR TARGET_ROOT NEW_ABS_EVIDENCE OLD_PRODUCT_SHA OLD_RECORD_SHA NEW_PRODUCT_SHA NEW_SOURCE_SID NEW_RECORD_SHA NATIVE_RECEIPT_SHA PACKAGE_SHA INSTALL_STDOUT INSTALL_STDOUT_SHA\n",stderr);return 2;}
 for(int i=1;i<=5;i++)if(!clean(argv[i]))die("absolute-clean-path-required");if(!clean(argv[13]))die("absolute-install-receipt-required");for(int i=6;i<=12;i++)if(!hex(argv[i]))die("expected-sha256-required");if(!hex(argv[14]))die("expected-install-receipt-sha256-required");
 if(!realpath(argv[1],origin)||!realpath(argv[2],generation)||!realpath(argv[3],packages)||!realpath(argv[4],target))die("existing-root-paths");if(!strcmp(origin,target))die("distinct-origin-and-target-required");
 old_product=argv[6];old_record=argv[7];new_product=argv[8];new_source=argv[9];new_record=argv[10];new_native=argv[11];new_package=argv[12];install_stdout=argv[13];install_sha=argv[14];
 if(strlen(argv[5])>=sizeof evidence)die("evidence-path-bound");strcpy(evidence,argv[5]);endpoints();Endpoint before=installed();endpoints();
 if(mkdir(evidence,0700))die("new-evidence-directory-required");char canonical[4096];if(!realpath(evidence,canonical)||strcmp(canonical,evidence))die("canonical-evidence-path-required");
 char p[4400];size_t pn,rn,on;path(p,origin,"unisacc.com");char *product=readexact(p,&pn,new_product);path(p,origin,"unisacc.com.build.json");char *record=readexact(p,&rn,new_record);path(p,target,"unisacc.com");char *old=readexact(p,&on,old_product);saved("previous.com",old,on,0700);free(old);path(p,target,"unisacc.com.build.json");old=readexact(p,&on,old_record);saved("previous.com.build.json",old,on,0600);free(old);
 saved("promoted.com",product,pn,0700);saved("promoted.com.build.json",record,rn,0600);path(p,generation,"unisacc-next.com.native.tsv");old=readexact(p,&on,new_native);saved("promoted.com.native.tsv",old,on,0600);free(old);old=readexact(install_stdout,&on,install_sha);saved("origin-install.stdout",old,on,0600);free(old);
 char stage[4400],stage_record[4400],dest[4400],dest_record[4400];path(stage,target,".unisacc-candidate-promote.next");path(stage_record,target,".unisacc-candidate-promote.next.build.json");save(stage,product,pn,0700);save(stage_record,record,rn,0600);free(product);free(record);
 np_buf receipt={0};np_puts(&receipt,"candidate-promotion-v1\norigin-root\t");np_puts(&receipt,origin);np_puts(&receipt,"\ngeneration\t");np_puts(&receipt,generation);np_puts(&receipt,"\npackage-dir\t");np_puts(&receipt,packages);np_puts(&receipt,"\ntarget-root\t");np_puts(&receipt,target);np_puts(&receipt,"\nprevious-product\t");np_puts(&receipt,old_product);np_puts(&receipt,"\nprevious-record\t");np_puts(&receipt,old_record);np_puts(&receipt,"\nproduct\t");np_puts(&receipt,new_product);np_puts(&receipt,"\nrecord\t");np_puts(&receipt,new_record);np_puts(&receipt,"\nfrozen-source\t");np_puts(&receipt,new_source);np_puts(&receipt,"\nnative-receipt\t");np_puts(&receipt,new_native);
 np_puts(&receipt,"\npackage\t");np_puts(&receipt,new_package);np_puts(&receipt,"\norigin-install-stdout\t");np_puts(&receipt,install_stdout);np_puts(&receipt,"\norigin-install-stdout-sha\t");np_puts(&receipt,install_sha);np_puts(&receipt,"\nendpoint-before\t");np_puts(&receipt,before.witness);np_puts(&receipt,"\nscope\tbyte-transfer-of-installed-frozen-candidate;prior-admission-not-reexecuted;target-live-source-not-qualified;no-functional-PASS\n");saved("prepared.tsv",receipt.p,receipt.n,0600);syncdir(evidence);syncdir(target);
 Endpoint final=installed();if(strcmp(before.witness,final.witness))die("frozen-installed-endpoints-changed");check(evidence,"previous.com",old_product);check(evidence,"previous.com.build.json",old_record);check(evidence,"promoted.com",new_product);check(evidence,"promoted.com.build.json",new_record);check(evidence,"promoted.com.native.tsv",new_native);check(evidence,"origin-install.stdout",install_sha);check(target,".unisacc-candidate-promote.next",new_product);check(target,".unisacc-candidate-promote.next.build.json",new_record);endpoints();
 path(dest,target,"unisacc.com");path(dest_record,target,"unisacc.com.build.json");if(rename(stage,dest))die("product-rename-failed");if(rename(stage_record,dest_record))die("product-promoted-record-rename-failed");syncdir(target);
 check(target,"unisacc.com",new_product);check(target,"unisacc.com.build.json",new_record);check(origin,"unisacc.com",new_product);check(origin,"unisacc.com.build.json",new_record);check(generation,"unisacc-next.com.native.tsv",new_native);
 np_puts(&receipt,"endpoint-final\t");np_puts(&receipt,final.witness);np_puts(&receipt,"\nstatus\tPROMOTED-development-only-no-test-result\n");saved("receipt.tsv",receipt.p,receipt.n,0600);free(receipt.p);syncdir(evidence);printf("PROMOTED\tdevelopment-only\tproduct=%s\tfrozen-source=%s\trecord=%s\n",new_product,new_source,new_record);return 0;
}
