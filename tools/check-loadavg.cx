/* Check for tools/cxlib/loadavg.cx: tool_load1_at parses the first column of a loadavg file,
 * returns 99 for a missing file, and tool_load1 reads the real /proc/loadavg (0 <= v < 99).
 * Check: CHECK_LOADAVG. */
#pragma unisa use sys.fs
#pragma unisa use cxlib.loadavg

static int passed, failed;
static void check(const char *label, int yes) { if (yes) passed++; else failed++; printf("%s\t%s\tloadavg\n", yes ? "PASS" : "FAIL", label); }

int main(void) {
    char tmp[4096], p[4200];
    if (sy_mkdtemp("/tmp", "loadavg-check", tmp, sizeof tmp) || cx_fmt(p, sizeof p, "%s/loadavg", tmp)) return 2;
    if (sy_write_file(p, "2.75 1.50 0.25 3/900 12345\n", 27, 0644)) return 2;
    double v = tool_load1_at(p);
    check("first-column", v > 2.749 && v < 2.751);
    check("missing-file-99", tool_load1_at("/nonexistent/loadavg") == 99.0);
    double r = tool_load1();
    check("real-proc-loadavg", r >= 0 && r < 99);
    sy_unlink(p); sy_rmdir(tmp);
    printf("CHECK_LOADAVG\tpassed=%d\tfailed=%d\n", passed, failed);
    return failed ? 1 : 0;
}
