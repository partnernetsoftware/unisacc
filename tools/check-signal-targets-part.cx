/* tools/check-signal-targets-part.cx -- signal-targets 慢批分片检查(--part gen|posix|win),断言并集与原批多重集相等。
 *   sh ./unisacc.com tools/check-signal-targets-part.cx -- --part gen|posix|win [ROOT]
 * Product compile assertions, never host-compiler simulation. */
#pragma unisa use sysx.process
#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.sig
#pragma unisa use text.text

static void die(const char *s) { sy_eprintf("signal-targets-part: %s\n", s); sy_exit(2); }
static int stp_write(const char *path, const char *s) {
    int fd = sy_open(path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (fd < 0) return 1;
    int bad = sy_write_all(fd, s, tx_len(s, 8192));
    sy_close(fd);
    return bad;
}
static np_result stp_run(char **v, const char *root) {
    np_result r; char why[512];
    if (np_run(v, root, 0, 55, &r, why, sizeof why)) die(why);
    return r;
}
static int stp_ck(int ok, const char *name) {
    sy_printf("%s\t%s\n", ok ? "PASS" : "FAIL", name);
    return ok ? 0 : 1;
}

int main(int argc, char **argv) {
    char root[4096], com[4400], gen[4400], src[512], obj[512], drift[512], text[8192];
    char tmp[] = "/tmp/cx-signal-targets-part-XXXXXX";
    const char *os[6] = {"lnx","lnx","osx","osx","win","win"};
    const char *arch[6] = {"x86_64","arm64","x86_64","arm64","x86_64","arm64"};
    const char *part = 0, *root_arg = ".";
    int failed = 0, lo = 0, hi = 0;

    if (argc < 3 || argc > 4 || !tx_eqz(argv[1], "--part")) die("usage: --part gen|posix|win [ROOT]");
    part = argv[2];
    if (argc == 4) root_arg = argv[3];
    if (tx_eqz(part, "gen")) { lo = 0; hi = 0; }
    else if (tx_eqz(part, "posix")) { lo = 0; hi = 4; }
    else if (tx_eqz(part, "win")) { lo = 4; hi = 6; }
    else die("unknown part (want gen|posix|win)");

    if (!realpath(root_arg, root) || !mkdtemp(tmp)) die("setup");
    if (cx_fmt(com, sizeof com, "%s/unisacc.com", root) ||
        cx_fmt(gen, sizeof gen, "%s/tools/signal-targets-gen.cx", root) ||
        cx_fmt(src, sizeof src, "%s/probe.c", tmp) ||
        cx_fmt(obj, sizeof obj, "%s/probe.o", tmp) ||
        cx_fmt(drift, sizeof drift, "%s/drift.h", tmp)) die("paths");

    if (tx_eqz(part, "gen")) {
        { char *v[] = {"sh", com, gen, "--", "--check", 0};
          np_result r = stp_run(v, root); failed += stp_ck(r.rc == 0, "generated-header-current"); np_free(&r); }
        if (stp_write(drift, "/* BEGIN generated signal targets */\n#define SIGPIPE 14\n/* END generated signal targets */\n")) die("drift-write");
        { char *v[] = {"sh", com, gen, "--", "--check", drift, 0};
          np_result r = stp_run(v, root); failed += stp_ck(r.rc != 0, "generator-rejects-drift"); np_free(&r); }
    } else {
        for (int i = lo; i < hi; i++) {
            int apple = i == 2 || i == 3;
            const char *guard = apple ? "#ifndef __APPLE__\n#error expected_apple\n#endif\n" :
                                i >= 4 ? "#ifndef _WIN32\n#error expected_windows\n#endif\n" :
                                         "#if defined(__APPLE__) || defined(_WIN32)\n#error expected_linux\n#endif\n";
            if (cx_fmt(text, sizeof text,
                "#include <signal.h>\n%s"
                "#if SIGHUP != 1 || SIGINT != 2 || SIGQUIT != 3 || SIGILL != 4 || SIGABRT != 6 || SIGFPE != 8 || SIGKILL != 9 || SIGSEGV != 11 || SIGPIPE != 13 || SIGTERM != 15 || SIGWINCH != 28\n#error signal_common_values\n#endif\n"
                "#if SIGUSR1 != %d || SIGUSR2 != %d\n#error signal_target_values\n#endif\n"
                "#if SIGUSR1 == SIGSEGV || SIGUSR2 == SIGSEGV || SIGUSR1 == SIGUSR2\n#error signal_target_collision\n#endif\n"
                "int main(void) { return SIGPIPE == 13 ? 0 : 1; }\n",
                guard, apple ? 30 : 10, apple ? 31 : 12)) die("source-capacity");
            if (stp_write(src, text)) die("source-write");
            char target[64], inc[4400], label[128];
            if (cx_fmt(target, sizeof target, "%s/%s", os[i], arch[i]) ||
                cx_fmt(obj, sizeof obj, "%s/probe-%d.o", tmp, i) ||
                cx_fmt(inc, sizeof inc, "%s/include", root) ||
                cx_fmt(label, sizeof label, "signal-values-%s-%s", os[i], arch[i])) die("target-path");
            char *v[] = {"sh", com, "-b", target, "-I", inc, "-c", "-funit", src, "-o", obj, 0};
            np_result r = stp_run(v, root);
            struct stat st;
            failed += stp_ck(r.rc == 0 && sy_stat(obj, &st) == 0 && st.st_size > 0 && (!r.err || !strstr(r.err, "error:")), label);
            if (r.rc) sy_eprintf("%.*s\n%.*s\n", (int)(r.outn > 1000 ? 1000 : r.outn), r.out ? r.out : "", (int)(r.errn > 1000 ? 1000 : r.errn), r.err ? r.err : "");
            np_free(&r);
        }
    }
    if (cx_rmtree(tmp)) die("cleanup");
    sy_printf("CHECK_SIGNAL_TARGETS_PART\tpart=%s\tfailed=%d\n", part, failed);
    return failed ? 1 : 0;
}
