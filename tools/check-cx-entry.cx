#pragma unisa use cxlib.netpack
/* Entry matrix. sh ./unisacc.com tools/check-cx-entry.cx -- ENTRY OUTDIR
   Compares ENTRY with ROOT/unisacc.com. Corpus and the expected row list
   are this file. Each compiler runs under ROOT/tools/bound, cwd
   /tmp/notrepo, UNISA_CONTAINER unset. One invocation stops before the
   slice budget and leaves OUTDIR/cx-entry-matrix.progress. Re-invoke the
   same command until stdout says LEFT:0. The table is
   OUTDIR/cx-entry-matrix-2026-10-30.tsv. A missing progress file starts
   over and truncates that table.

   Expected rows, in order (100). For each corpus except dup.c:
     -E, -S, -run on lnx/x86_64, then -o on
     lnx/x86_64, lnx/arm64, osx/x86_64, osx/arm64, win/x86_64, win/arm64.
   Last row: dup.c -run on lnx/x86_64. dup.c is the text below, written
   to OUTDIR/dup.c. Its row is measured. It is not given a canned verdict. */
static const char *const cxe_name[] = {
    "do.c", "fact.c", "fib.c", "hello.c", "host.c", "indirect6.c",
    "ptr.c", "struct.c", "switch.c", "cxstd_main.cx", "dev-run.cx"
};
static const char *const cxe_rel[] = {
    "examples/do.c", "examples/fact.c", "examples/fib.c", "examples/hello.c",
    "examples/host.c", "examples/indirect6.c", "examples/ptr.c",
    "examples/struct.c", "examples/switch.c", "tests/cxstd_main.cx",
    "tools/dev-run.cx"
};
static const char *const cxe_mode[] = {
    "-E", "-S", "-run", "-o", "-o", "-o", "-o", "-o", "-o"
};
static const char *const cxe_tgt[] = {
    "lnx/x86_64", "lnx/x86_64", "lnx/x86_64",
    "lnx/x86_64", "lnx/arm64", "osx/x86_64", "osx/arm64", "win/x86_64", "win/arm64"
};
static const char cxe_dup[] =
    "#include <string.h>\n"
    "int main(void) { char *s = strdup(\"ab\"); return s && s[0]=='a' ? 3 : 1; }\n";
enum { CXE_FILES = 11, CXE_PHASES = 9, CXE_N = 100 };
/* Stop starting a normal cell after this much of main. A dev-run.cx cell
   starts only in the first second, so one of those cells is the invocation. */
static const long long CXE_SLICE_NS = 18000000000LL;

struct cxe_ts { long sec; long nsec; };

static void cxe_die(const char *s) {
    fprintf(stderr, "check-cx-entry: %s\n", s);
    exit(2);
}

static long long cxe_ns(void) {
    struct cxe_ts ts;
    int clock_gettime(int, struct cxe_ts *);
    if (clock_gettime(1, &ts)) return -1;
    return (long long)ts.sec * 1000000000LL + (long long)ts.nsec;
}

static void cxe_join(char *dst, int cap, const char *a, const char *b) {
    int n;
    n = snprintf(dst, (size_t)cap, "%s/%s", a, b);
    if (n < 0 || n >= cap) cxe_die("path");
}

static int cxe_lines(const char *path) {
    FILE *f;
    int c, n = 0;
    f = fopen(path, "rb");
    if (!f) return -1;
    while ((c = fgetc(f)) != EOF) if (c == '\n') n++;
    if (fclose(f) != 0) return -1;
    return n;
}

static int cxe_has(const char *s, size_t n, const char *lit) {
    size_t m, i;
    if (!s) return 0;
    m = strlen(lit);
    if (n < m) return 0;
    for (i = 0; i + m <= n; i++) if (!memcmp(s + i, lit, m)) return 1;
    return 0;
}

static int cxe_bytes_eq(const char *a, const char *b) {
    FILE *fa, *fb;
    char ba[8192], bb[8192];
    size_t na, nb;
    fa = fopen(a, "rb");
    fb = fopen(b, "rb");
    if (!fa || !fb) {
        if (fa) fclose(fa);
        if (fb) fclose(fb);
        return 0;
    }
    for (;;) {
        na = fread(ba, 1, sizeof ba, fa);
        nb = fread(bb, 1, sizeof bb, fb);
        if (na != nb || memcmp(ba, bb, na) != 0) {
            fclose(fa);
            fclose(fb);
            return 0;
        }
        if (na == 0) break;
    }
    if (fclose(fa) != 0 || fclose(fb) != 0) return 0;
    return 1;
}

static void cxe_perm(const char *path, long long *n, char *perm, int cap) {
    struct stat st;
    *n = 0;
    snprintf(perm, (size_t)cap, "-");
    if (stat(path, &st) != 0 || !S_ISREG(st.st_mode)) return;
    *n = (long long)st.st_size;
    snprintf(perm, (size_t)cap, "%o", (unsigned)(st.st_mode & 0777));
}

struct cxe_side {
    int rc;
    long long wall;
    char *out;
    size_t outn;
    char *err;
    size_t errn;
    long long image_n;
    char perm[16];
};

static void cxe_side_clear(struct cxe_side *s) {
    s->rc = 0;
    s->wall = -1;
    s->out = 0;
    s->outn = 0;
    s->err = 0;
    s->errn = 0;
    s->image_n = 0;
    snprintf(s->perm, sizeof s->perm, "-");
}

static void cxe_side_free(struct cxe_side *s) {
    free(s->out);
    free(s->err);
    s->out = 0;
    s->err = 0;
}

static void cxe_run(const char *bound, int secs, const char *bin, const char *mode,
                    const char *target, const char *img, const char *src, struct cxe_side *s) {
    char sec[16];
    char *av[10];
    char why[1024];
    np_result r;
    long long t0, t1;
    int n = 0;
    int pr;
    cxe_side_clear(s);
    snprintf(sec, sizeof sec, "%d", secs);
    av[n++] = (char *)bound;
    av[n++] = sec;
    av[n++] = (char *)bin;
    if (!strcmp(mode, "-o")) {
        av[n++] = "-b";
        av[n++] = (char *)target;
        av[n++] = "-o";
        av[n++] = (char *)img;
    } else {
        av[n++] = (char *)mode;
    }
    av[n++] = (char *)src;
    av[n] = 0;
    unlink(img);
    memset(&r, 0, sizeof r);
    t0 = cxe_ns();
    pr = np_run(av, "/tmp/notrepo", 0, secs + 8, &r, why, sizeof why);
    t1 = cxe_ns();
    if (t0 >= 0 && t1 >= 0) s->wall = t1 - t0;
    if (pr != 0) {
        s->rc = strstr(why, "timed out") ? 142 : 127;
        s->err = malloc(strlen(why) + 1);
        if (!s->err) cxe_die("memory");
        memcpy(s->err, why, strlen(why) + 1);
        s->errn = strlen(why);
        np_free(&r);
    } else {
        s->rc = r.rc;
        s->out = r.out;
        s->outn = r.outn;
        s->err = r.err;
        s->errn = r.errn;
    }
    if (!strcmp(mode, "-o")) cxe_perm(img, &s->image_n, s->perm, (int)sizeof s->perm);
}

static int cxe_near(long long wall, int secs) {
    if (wall < 0) return 0;
    return wall > ((long long)secs - 2) * 1000000000LL;
}

static void cxe_judge(const struct cxe_side *p, const struct cxe_side *n, const char *mode,
                      const char *pimg, const char *nimg, int secs, const char **verdict, const char **note) {
    int text;
    *note = "-";
    if (cxe_has(p->err, p->errn, "NOT_IMPLEMENTED") || cxe_has(n->err, n->errn, "NOT_IMPLEMENTED")) {
        *verdict = "NOT_IMPLEMENTED";
        return;
    }
    if (p->rc >= 128 || n->rc >= 128) {
        if (p->rc == 142 || n->rc == 142 || cxe_near(p->wall, secs) || cxe_near(n->wall, secs))
            *verdict = "TIMEOUT";
        else
            *verdict = "CRASH";
        *note = "rc";
        return;
    }
    text = p->rc == n->rc && p->outn == n->outn && p->errn == n->errn
        && (p->outn == 0 || memcmp(p->out, n->out, p->outn) == 0)
        && (p->errn == 0 || memcmp(p->err, n->err, p->errn) == 0);
    if (!text) {
        *verdict = "DIFF";
        *note = "text";
        return;
    }
    if (strcmp(mode, "-o") != 0) {
        *verdict = "SAME";
        return;
    }
    if (p->image_n == 0 && n->image_n == 0 && !strcmp(p->perm, "-") && !strcmp(n->perm, "-")) {
        *verdict = "SAME";
        return;
    }
    if (p->image_n == n->image_n && !strcmp(p->perm, n->perm) && cxe_bytes_eq(pimg, nimg)) {
        *verdict = "SAME";
        return;
    }
    *verdict = "DIFF";
    *note = "image";
}

static int cxe_load_at(const char *path, int *at) {
    FILE *f;
    int c, n = 0, saw = 0;
    f = fopen(path, "r");
    if (!f) {
        if (errno == ENOENT) { *at = 0; return 0; }
        return 1;
    }
    while ((c = fgetc(f)) != EOF && c >= '0' && c <= '9') {
        saw = 1;
        n = n * 10 + (c - '0');
        if (n > CXE_N) { fclose(f); return 1; }
    }
    if (fclose(f) != 0 || !saw) return 1;
    *at = n;
    return 0;
}

static void cxe_save_at(const char *path, int at) {
    FILE *f;
    char tmp[4096];
    int n;
    n = snprintf(tmp, sizeof tmp, "%s.tmp", path);
    if (n < 0 || (size_t)n >= sizeof tmp) cxe_die("progress path");
    f = fopen(tmp, "w");
    if (!f) cxe_die("progress");
    fprintf(f, "%d\n", at);
    if (fflush(f) != 0 || fclose(f) != 0) cxe_die("progress");
    if (rename(tmp, path) != 0) cxe_die("progress rename");
}

static int cxe_repo(char *root, int cap) {
    char self[4096];
    char *slash;
    size_t n;
    if (!realpath(__FILE__, self)) return 1;
    slash = strrchr(self, '/');
    if (!slash) return 1;
    *slash = 0;
    n = strlen(self);
    if (n < 6 || strcmp(self + n - 6, "/tools") != 0) return 1;
    slash = strrchr(self, '/');
    if (!slash) return 1;
    *slash = 0;
    if ((int)strlen(self) + 1 > cap) return 1;
    memcpy(root, self, strlen(self) + 1);
    return 0;
}

int main(int argc, char **argv) {
    char root[4096], entry[4096], outdir[4096];
    char product[4096], bound[4096], tsvpath[4096], progpath[4096], dups[4096];
    char src[4096], pimg[4096], nimg[4096];
    char row[1024];
    const char *name, *mode, *target, *rel;
    FILE *tsv;
    struct stat st;
    long long t0, bytes;
    int at, lines, file, phase, secs;
    int mkdir(const char *, unsigned);
    if (argc == 4 && !strcmp(argv[1], "--")) { argv++; argc--; }
    if (argc != 3) {
        fprintf(stderr, "usage: ENTRY OUTDIR\n");
        return 2;
    }
    if ((int)(sizeof cxe_name / sizeof cxe_name[0]) != CXE_FILES) cxe_die("corpus");
    if ((int)(sizeof cxe_mode / sizeof cxe_mode[0]) != CXE_PHASES) cxe_die("phases");
    if (CXE_FILES * CXE_PHASES + 1 != CXE_N) cxe_die("count");
    if (cxe_repo(root, (int)sizeof root)) cxe_die("repo root");
    if (!realpath(argv[1], entry)) cxe_die("ENTRY");
    if (!realpath(argv[2], outdir)) cxe_die("OUTDIR");
    if (stat(entry, &st) != 0 || !S_ISREG(st.st_mode)) cxe_die("ENTRY is not a regular file");
    bytes = (long long)st.st_size;
    cxe_join(product, (int)sizeof product, root, "unisacc.com");
    cxe_join(bound, (int)sizeof bound, root, "tools/bound");
    if (stat(product, &st) != 0 || !S_ISREG(st.st_mode)) cxe_die("product missing");
    if (stat(bound, &st) != 0 || !S_ISREG(st.st_mode)) cxe_die("bound missing");
    if (mkdir("/tmp/notrepo", 0755) != 0 && errno != EEXIST) cxe_die("notrepo");
    unsetenv("UNISA_CONTAINER");
    cxe_join(dups, (int)sizeof dups, outdir, "dup.c");
    if (np_writefile(dups, cxe_dup, sizeof cxe_dup - 1)) cxe_die("dup.c");
    cxe_join(tsvpath, (int)sizeof tsvpath, outdir, "cx-entry-matrix-2026-10-30.tsv");
    cxe_join(progpath, (int)sizeof progpath, outdir, "cx-entry-matrix.progress");
    cxe_join(pimg, (int)sizeof pimg, outdir, "cxe-p.img");
    cxe_join(nimg, (int)sizeof nimg, outdir, "cxe-n.img");
    if (cxe_load_at(progpath, &at)) cxe_die("progress unreadable");
    if (at >= CXE_N) {
        printf("LEFT:0\n");
        return 0;
    }
    lines = cxe_lines(tsvpath);
    if (at == 0) {
        tsv = fopen(tsvpath, "wb");
        if (!tsv) cxe_die("tsv");
        fputs("corpus\tmode\ttarget\tprod_rc\tnew_rc\tprod_stdout_n\tnew_stdout_n\tprod_stderr_n\tnew_stderr_n\tprod_image_n\tnew_image_n\tprod_perm\tnew_perm\tverdict\tnote\tprod_wall_ns\tnew_wall_ns\n", tsv);
        if (fflush(tsv) != 0) cxe_die("tsv");
    } else {
        if (lines < 0) cxe_die("tsv missing");
        if (lines == at + 2) at = lines - 1;
        else if (lines != at + 1) cxe_die("progress does not match the table");
        if (at >= CXE_N) {
            cxe_save_at(progpath, at);
            printf("LEFT:0\n");
            return 0;
        }
        tsv = fopen(tsvpath, "ab");
        if (!tsv) cxe_die("tsv");
    }
    fprintf(stderr, "check-cx-entry entry=%s bytes=%lld at=%d\n", entry, bytes, at);
    t0 = cxe_ns();
    while (at < CXE_N) {
        long long el = cxe_ns() - t0;
        struct cxe_side ps, ns;
        const char *verdict, *note;
        if (at == CXE_FILES * CXE_PHASES) {
            name = "dup.c";
            mode = "-run";
            target = "lnx/x86_64";
            snprintf(src, sizeof src, "%s", dups);
        } else {
            file = at / CXE_PHASES;
            phase = at % CXE_PHASES;
            name = cxe_name[file];
            rel = cxe_rel[file];
            mode = cxe_mode[phase];
            target = cxe_tgt[phase];
            cxe_join(src, (int)sizeof src, root, rel);
        }
        if (stat(src, &st) != 0 || !S_ISREG(st.st_mode)) cxe_die("corpus missing");
        secs = !strcmp(name, "dev-run.cx") ? 18 : 12;
        if (!strcmp(name, "dev-run.cx")) {
            if (el > 1000000000LL) break;
        } else if (el > CXE_SLICE_NS) {
            break;
        }
        cxe_run(bound, secs, product, mode, target, pimg, src, &ps);
        cxe_run(bound, secs, entry, mode, target, nimg, src, &ns);
        cxe_judge(&ps, &ns, mode, pimg, nimg, secs, &verdict, &note);
        snprintf(row, sizeof row,
                 "%s\t%s\t%s\t%d\t%d\t%llu\t%llu\t%llu\t%llu\t%lld\t%lld\t%s\t%s\t%s\t%s\t%lld\t%lld\n",
                 name, mode, target, ps.rc, ns.rc,
                 (unsigned long long)ps.outn, (unsigned long long)ns.outn,
                 (unsigned long long)ps.errn, (unsigned long long)ns.errn,
                 ps.image_n, ns.image_n, ps.perm, ns.perm, verdict, note, ps.wall, ns.wall);
        if (fwrite(row, 1, strlen(row), tsv) != strlen(row) || fflush(tsv) != 0) cxe_die("tsv write");
        cxe_side_free(&ps);
        cxe_side_free(&ns);
        unlink(pimg);
        unlink(nimg);
        at++;
        cxe_save_at(progpath, at);
        printf("%s %s %s %s\n", verdict, name, mode, target);
        fflush(stdout);
    }
    if (fclose(tsv) != 0) cxe_die("tsv close");
    printf("LEFT:%d\n", CXE_N - at);
    return at >= CXE_N ? 0 : 2;
}
