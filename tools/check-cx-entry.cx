/* Stop starting a normal cell after this much of main. A dev-run.cx cell
   starts only in the first second, so one of those cells is the invocation. */
static const long long CXE_SLICE_NS = 18000000000LL;

struct cxe_ts { long sec; long nsec; };

static void cxe_die(const char *s) {
    fprintf(stderr, "check-cx-entry: %s\n", s);
    exit(2);
}

static long long cxe_ns(void) {
    struct cxe_ts ts;
    int clock_gettime(int, struct cxe_ts *);
    if (clock_gettime(1, &ts)) return -1;
    return (long long)ts.sec * 1000000000LL + (long long)ts.nsec;
}

static void cxe_join(char *dst, int cap, const char *a, const char *b) {
    int n;
    n = snprintf(dst, (size_t)cap, "%s/%s", a, b);
    if (n < 0 || n >= cap) cxe_die("path");
}

static int cxe_lines(const char *path) {
    FILE *f;
    int c, n = 0;
    f = fopen(path, "rb");
    if (!f) return -1;
    while ((c = fgetc(f)) != EOF) if (c == '\n') n++;
    if (fclose(f) != 0) return -1;
    return n;
}

static int cxe_has(const char *s, size_t n, const char *lit) {
    size_t m, i;
    if (!s) return 0;
    m = strlen(lit);
    if (n < m) return 0;
    for (i = 0; i + m <= n; i++) if (!memcmp(s + i, lit, m)) return 1;
    return 0;
}

static int cxe_bytes_eq(const char *a, const char *b) {
    FILE *fa, *fb;
    char ba[8192], bb[8192];
    size_t na, nb;
    fa = fopen(a, "rb");
    fb = fopen(b, "rb");
    if (!fa || !fb) {
        if (fa) fclose(fa);
        if (fb) fclose(fb);
        return 0;
    }
    for (;;) {
        na = fread(ba, 1, sizeof ba, fa);
        nb = fread(bb, 1, sizeof bb, fb);
        if (na != nb || memcmp(ba, bb, na) != 0) {
            fclose(fa);
            fclose(fb);
            return 0;
        }
        if (na == 0) break;
    }
    if (fclose(fa) != 0 || fclose(fb) != 0) return 0;
    return 1;
}

static void cxe_perm(const char *path, long long *n, char *perm, int cap) {
    struct stat st;
    *n = 0;
    snprintf(perm, (size_t)cap, "-");
    if (stat(path, &st) != 0 || !S_ISREG(st.st_mode)) return;
    *n = (long long)st.st_size;
    snprintf(perm, (size_t)cap, "%o", (unsigned)(st.st_mode & 0777));
}

struct cxe_side {
    int rc;
    long long wall;
    char *out;
    size_t outn;
    char *err;
    size_t errn;
    long long image_n;
    char perm[16];
};

static void cxe_side_clear(struct cxe_side *s) {
    s->rc = 0;
    s->wall = -1;
    s->out = 0;
    s->outn = 0;
    s->err = 0;
    s->errn = 0;
    s->image_n = 0;
    snprintf(s->perm, sizeof s->perm, "-");
}

static void cxe_side_free(struct cxe_side *s) {
    free(s->out);
    free(s->err);
    s->out = 0;
    s->err = 0;
}

static void cxe_exec(char **av, int secs, const char *img, int image, struct cxe_side *s) {
    char why[1024];
    np_result r;
    long long t0, t1;
    int pr;
    cxe_side_clear(s);
    if (image) unlink(img);
    memset(&r, 0, sizeof r);
    t0 = cxe_ns();
    pr = np_run(av, "/tmp/notrepo", 0, secs + 8, &r, why, sizeof why);
    t1 = cxe_ns();
    if (t0 >= 0 && t1 >= 0) s->wall = t1 - t0;
    if (pr != 0) {
        s->rc = strstr(why, "timed out") ? 142 : 127;
        s->err = malloc(strlen(why) + 1);
        if (!s->err) cxe_die("memory");
        memcpy(s->err, why, strlen(why) + 1);
        s->errn = strlen(why);
        np_free(&r);
    } else {
        s->rc = r.rc;
        s->out = r.out;
        s->outn = r.outn;
        s->err = r.err;
        s->errn = r.errn;
    }
    if (image) cxe_perm(img, &s->image_n, s->perm, (int)sizeof s->perm);
}

static void cxe_run(const char *bound, int secs, const char *bin, const char *mode,
                    const char *target, const char *img, const char *src, struct cxe_side *s) {
    char sec[16];
    char *av[10];
    int n = 0;
    snprintf(sec, sizeof sec, "%d", secs);
    av[n++] = (char *)bound;
    av[n++] = sec;
    av[n++] = (char *)bin;
    if (!strcmp(mode, "-o")) {
        av[n++] = "-b";
        av[n++] = (char *)target;
        av[n++] = "-o";
        av[n++] = (char *)img;
    } else {
        av[n++] = (char *)mode;
    }
    av[n++] = (char *)src;
    av[n] = 0;
    cxe_exec(av, secs, img, !strcmp(mode, "-o"), s);
}

static int cxe_near(long long wall, int secs) {
    if (wall < 0) return 0;
    return wall > ((long long)secs - 2) * 1000000000LL;
}

static void cxe_judge(const struct cxe_side *p, const struct cxe_side *n, const char *mode,
                      const char *pimg, const char *nimg, int secs, const char **verdict, const char **note) {
    int text;
    *note = "-";
    if (cxe_has(p->err, p->errn, "NOT_IMPLEMENTED") || cxe_has(n->err, n->errn, "NOT_IMPLEMENTED")) {
        *verdict = "NOT_IMPLEMENTED";
        return;
    }
    if (p->rc >= 128 || n->rc >= 128) {
        if (p->rc == 142 || n->rc == 142 || cxe_near(p->wall, secs) || cxe_near(n->wall, secs))
            *verdict = "TIMEOUT";
        else
            *verdict = "CRASH";
        *note = "rc";
        return;
    }
    text = p->rc == n->rc && p->outn == n->outn && p->errn == n->errn
        && (p->outn == 0 || memcmp(p->out, n->out, p->outn) == 0)
        && (p->errn == 0 || memcmp(p->err, n->err, p->errn) == 0);
    if (!text) {
        *verdict = "DIFF";
        *note = "text";
        return;
    }
    if (strcmp(mode, "-o") != 0) {
        *verdict = "SAME";
        return;
    }
    if (p->image_n == 0 && n->image_n == 0 && !strcmp(p->perm, "-") && !strcmp(n->perm, "-")) {
        *verdict = "SAME";
        return;
    }
    if (p->image_n == n->image_n && !strcmp(p->perm, n->perm) && cxe_bytes_eq(pimg, nimg)) {
        *verdict = "SAME";
        return;
    }
    *verdict = "DIFF";
    *note = "image";
}

static int cxe_load_at(const char *path, int *at) {
    FILE *f;
    int c, n = 0, saw = 0;
    f = fopen(path, "r");
    if (!f) {
        if (errno == ENOENT) { *at = 0; return 0; }
        return 1;
    }
    while ((c = fgetc(f)) != EOF && c >= '0' && c <= '9') {
        saw = 1;
        n = n * 10 + (c - '0');
        if (n > CXE_N) { fclose(f); return 1; }
    }
    if (fclose(f) != 0 || !saw) return 1;
    *at = n;
    return 0;
}

static void cxe_save_at(const char *path, int at) {
    FILE *f;
    char tmp[4096];
    int n;
    n = snprintf(tmp, sizeof tmp, "%s.tmp", path);
    if (n < 0 || (size_t)n >= sizeof tmp) cxe_die("progress path");
    f = fopen(tmp, "w");
    if (!f) cxe_die("progress");
    fprintf(f, "%d\n", at);
    if (fflush(f) != 0 || fclose(f) != 0) cxe_die("progress");
    if (rename(tmp, path) != 0) cxe_die("progress rename");
}

static int cxe_repo(char *root, int cap) {
    char self[4096];
    char *slash;
    size_t n;
    if (!realpath(__FILE__, self)) return 1;
    slash = strrchr(self, '/');
    if (!slash) return 1;
    *slash = 0;
    n = strlen(self);
    if (n < 6 || strcmp(self + n - 6, "/tools") != 0) return 1;
    slash = strrchr(self, '/');
    if (!slash) return 1;
    *slash = 0;
    if ((int)strlen(self) + 1 > cap) return 1;
    memcpy(root, self, strlen(self) + 1);
    return 0;
}

struct cxe_fx {
    char inc[4096], xc[4096], dc[4096], qc[4096], ac[4096], ec[4096], mc[4096];
    char tcx[4096], idcx[4096], extra[4096], zh[4096], abs[4096];
    char ones[4096], rets[4096], bad[4096], btape[4096], otape[4096];
    char bbin[4096], hbin[4096], atxt[4096], btxt[4096], oneo[4096];
    char nopes[4096], nopecx[4096], nosuch[4096], missa[4096];
};

static void cxe_put(const char *path, const char *s) {
    if (np_writefile(path, s, strlen(s))) cxe_die("fixture");
}

static void cxe_headbin(const char *path) {
    FILE *f;
    char z[128];
    memset(z, 0, sizeof z);
    f = fopen(path, "wb");
    if (!f) cxe_die("head.tapebin");
    if (fwrite("UTAPEBIN", 1, 8, f) != 8 || fwrite(z, 1, 128, f) != 128 || fclose(f) != 0)
        cxe_die("head.tapebin");
}

static void cxe_once(const char *bound, const char *bin, const char *a, const char *b,
                     const char *c, const char *d) {
    char *av[8];
    char why[1024];
    np_result r;
    int n = 0;
    int pr;
    av[n++] = (char *)bound;
    av[n++] = "12";
    av[n++] = (char *)bin;
    av[n++] = (char *)a;
    av[n++] = (char *)b;
    av[n++] = (char *)c;
    av[n++] = (char *)d;
    av[n] = 0;
    memset(&r, 0, sizeof r);
    pr = np_run(av, "/tmp/notrepo", 0, 20, &r, why, sizeof why);
    if (pr || r.rc) {
        if (r.err && r.errn) fwrite(r.err, 1, r.errn, stderr);
        if (pr) fprintf(stderr, "check-cx-entry: %s\n", why);
        np_free(&r);
        cxe_die("fixture object");
    }
    np_free(&r);
}

static void cxe_prep(const char *outdir, const char *bound, const char *product, struct cxe_fx *fx) {
    int mkdir(const char *, unsigned);
    cxe_join(fx->inc, (int)sizeof fx->inc, outdir, "inc");
    if (mkdir(fx->inc, 0755) != 0 && errno != EEXIST) cxe_die("inc");
    cxe_join(fx->zh, (int)sizeof fx->zh, fx->inc, "z.h");
    cxe_join(fx->xc, (int)sizeof fx->xc, outdir, "x.c");
    cxe_join(fx->dc, (int)sizeof fx->dc, outdir, "d.c");
    cxe_join(fx->qc, (int)sizeof fx->qc, outdir, "q.c");
    cxe_join(fx->ac, (int)sizeof fx->ac, outdir, "a.c");
    cxe_join(fx->ec, (int)sizeof fx->ec, outdir, "e.c");
    cxe_join(fx->mc, (int)sizeof fx->mc, outdir, "m.c");
    cxe_join(fx->tcx, (int)sizeof fx->tcx, outdir, "t.cx");
    cxe_join(fx->idcx, (int)sizeof fx->idcx, outdir, "id.cx");
    cxe_join(fx->extra, (int)sizeof fx->extra, outdir, "extra.h");
    cxe_join(fx->abs, (int)sizeof fx->abs, outdir, "abs.c");
    cxe_join(fx->ones, (int)sizeof fx->ones, outdir, "one.s");
    cxe_join(fx->rets, (int)sizeof fx->rets, outdir, "ret.s");
    cxe_join(fx->bad, (int)sizeof fx->bad, outdir, "bad.bin");
    cxe_join(fx->btape, (int)sizeof fx->btape, outdir, "bad.tape");
    cxe_join(fx->otape, (int)sizeof fx->otape, outdir, "one.tape");
    cxe_join(fx->bbin, (int)sizeof fx->bbin, outdir, "bad.tapebin");
    cxe_join(fx->hbin, (int)sizeof fx->hbin, outdir, "head.tapebin");
    cxe_join(fx->atxt, (int)sizeof fx->atxt, outdir, "a.txt");
    cxe_join(fx->btxt, (int)sizeof fx->btxt, outdir, "b.txt");
    cxe_join(fx->oneo, (int)sizeof fx->oneo, outdir, "one.o");
    cxe_join(fx->nopes, (int)sizeof fx->nopes, outdir, "nope.s");
    cxe_join(fx->nopecx, (int)sizeof fx->nopecx, outdir, "nope.cx");
    cxe_join(fx->nosuch, (int)sizeof fx->nosuch, outdir, "nosuch");
    cxe_join(fx->missa, (int)sizeof fx->missa, outdir, "miss.a");
    cxe_put(fx->zh, "int z;\n");
    cxe_put(fx->xc, "int x;\n");
    cxe_put(fx->dc, "#ifdef FOO\nint a;\n#else\nint b;\n#endif\n");
    cxe_put(fx->qc, "#include \"z.h\"\n");
    cxe_put(fx->ac, "#include <z.h>\n");
    cxe_put(fx->ec, "int e;\n");
    cxe_put(fx->mc, "int main(void) { return 0; }\n");
    cxe_put(fx->tcx, "int x;\n");
    cxe_put(fx->idcx, "int id_n(int n) { return n; }\n");
    cxe_put(fx->extra, "int extra;\n");
    cxe_put(fx->abs, "int abs(int);\nint main(void){return abs(-3);}\n");
    cxe_put(fx->ones, "# unisacc -S lnx/x86_64\n");
    cxe_put(fx->rets, "# unisacc -S lnx/x86_64\n  ret\n");
    cxe_put(fx->bad, "not-an-object\n");
    cxe_put(fx->btape, "?\n");
    cxe_put(fx->otape, "_start:\n  imm r0, 7\n  ret\n");
    cxe_put(fx->bbin, "XXXX");
    cxe_put(fx->atxt, "hello\n");
    cxe_put(fx->btxt, "world-wide\n");
    cxe_headbin(fx->hbin);
    unlink(fx->oneo);
    cxe_once(bound, product, "as", fx->ones, "-o", fx->oneo);
}

static void cxe_push(char **av, int *n, char *s) {
    if (*n >= 15) cxe_die("argv");
    av[(*n)++] = s;
    av[*n] = 0;
}

static int cxe_face(int id, char **av, const char *bound, const char *sec, const char *bin,
                    const char *img, const struct cxe_fx *fx,
                    const char **name, const char **mode, const char **target) {
    int n = 0;
    if (id < 0 || id >= CXE_FACE_N) cxe_die("face");
    *name = cxe_face_name[id];
    *mode = cxe_face_mode[id];
    *target = cxe_face_tgt[id];
    cxe_push(av, &n, (char *)bound);
    cxe_push(av, &n, (char *)sec);
    cxe_push(av, &n, (char *)bin);
    switch (id) {
    case 0: cxe_push(av, &n, "ar"); break;
    case 1:
        cxe_push(av, &n, "ar"); cxe_push(av, &n, "z"); cxe_push(av, &n, (char *)fx->nosuch); break;
    case 2:
        cxe_push(av, &n, "ar"); cxe_push(av, &n, "r");
        cxe_push(av, &n, (char *)fx->missa); cxe_push(av, &n, (char *)fx->nosuch); break;
    case 3:
        cxe_push(av, &n, "ar"); cxe_push(av, &n, "r"); cxe_push(av, &n, (char *)img); break;
    case 4:
        cxe_push(av, &n, "ar"); cxe_push(av, &n, "r"); cxe_push(av, &n, (char *)img);
        cxe_push(av, &n, (char *)fx->atxt); cxe_push(av, &n, (char *)fx->btxt); break;
    case 5: cxe_push(av, &n, "as"); break;
    case 6:
        cxe_push(av, &n, "as"); cxe_push(av, &n, "-z"); cxe_push(av, &n, (char *)fx->ones); break;
    case 7:
        cxe_push(av, &n, "as"); cxe_push(av, &n, "-b"); cxe_push(av, &n, "nope");
        cxe_push(av, &n, (char *)fx->ones); break;
    case 8:
        cxe_push(av, &n, "as"); cxe_push(av, &n, (char *)fx->ones);
        cxe_push(av, &n, "-b"); cxe_push(av, &n, "lnx/arm64");
        cxe_push(av, &n, "-o"); cxe_push(av, &n, (char *)img); break;
    case 9:
        cxe_push(av, &n, "as"); cxe_push(av, &n, (char *)fx->ones);
        cxe_push(av, &n, "-o"); cxe_push(av, &n, (char *)img); break;
    case 10:
        cxe_push(av, &n, "as"); cxe_push(av, &n, (char *)fx->rets);
        cxe_push(av, &n, "-o"); cxe_push(av, &n, (char *)img); break;
    case 11:
        cxe_push(av, &n, "as"); cxe_push(av, &n, (char *)fx->nopes); break;
    case 12: cxe_push(av, &n, "nm"); break;
    case 13:
        cxe_push(av, &n, "nm"); cxe_push(av, &n, (char *)fx->bad); break;
    case 14:
        cxe_push(av, &n, "nm"); cxe_push(av, &n, (char *)fx->oneo); break;
    case 15: cxe_push(av, &n, "objdump"); break;
    case 16:
        cxe_push(av, &n, "objdump"); cxe_push(av, &n, (char *)fx->ones); break;
    case 17:
        cxe_push(av, &n, "objdump"); cxe_push(av, &n, "-d"); cxe_push(av, &n, (char *)fx->bad); break;
    case 18:
        cxe_push(av, &n, "objdump"); cxe_push(av, &n, "-d"); cxe_push(av, &n, (char *)fx->oneo); break;
    case 19:
        cxe_push(av, &n, "-c"); cxe_push(av, &n, "-b"); cxe_push(av, &n, "lnx/x86_64");
        cxe_push(av, &n, (char *)fx->xc); break;
    case 20:
        cxe_push(av, &n, "-c"); cxe_push(av, &n, "-b"); cxe_push(av, &n, "lnx/x86_64");
        cxe_push(av, &n, "-o"); cxe_push(av, &n, (char *)img); cxe_push(av, &n, (char *)fx->mc); break;
    case 21:
        cxe_push(av, &n, "-b"); cxe_push(av, &n, "lnx/x86_64");
        cxe_push(av, &n, (char *)fx->otape); cxe_push(av, &n, "-o"); cxe_push(av, &n, (char *)img); break;
    case 22:
        cxe_push(av, &n, "-b"); cxe_push(av, &n, "lnx/x86_64");
        cxe_push(av, &n, (char *)fx->btape); cxe_push(av, &n, "-o"); cxe_push(av, &n, (char *)img); break;
    case 23:
        cxe_push(av, &n, "-b"); cxe_push(av, &n, "lnx/x86_64");
        cxe_push(av, &n, (char *)fx->bbin); cxe_push(av, &n, "-o"); cxe_push(av, &n, (char *)img); break;
    case 24:
        cxe_push(av, &n, "-b"); cxe_push(av, &n, "lnx/x86_64");
        cxe_push(av, &n, (char *)fx->hbin); cxe_push(av, &n, "-o"); cxe_push(av, &n, (char *)img); break;
    case 25: cxe_push(av, &n, "-cx-plan"); cxe_push(av, &n, (char *)fx->tcx); break;
    case 26: cxe_push(av, &n, "-cx-interface"); cxe_push(av, &n, (char *)fx->tcx); break;
    case 27: cxe_push(av, &n, "-cx-plan"); cxe_push(av, &n, (char *)fx->idcx); break;
    case 28: cxe_push(av, &n, "-cx-interface"); cxe_push(av, &n, (char *)fx->idcx); break;
    case 29:
        cxe_push(av, &n, "-cx-plan"); cxe_push(av, &n, "-cx-interface");
        cxe_push(av, &n, (char *)fx->idcx); break;
    case 30: cxe_push(av, &n, "-cx-plan"); cxe_push(av, &n, (char *)fx->nopecx); break;
    case 31: cxe_push(av, &n, "-cx-plan"); break;
    case 32:
        cxe_push(av, &n, "-include"); cxe_push(av, &n, (char *)fx->extra);
        cxe_push(av, &n, "-cx-plan"); cxe_push(av, &n, (char *)fx->tcx); break;
    case 33: cxe_push(av, &n, "-dump-tokens"); cxe_push(av, &n, (char *)fx->xc); break;
    case 34:
        cxe_push(av, &n, "--emit-host-symbols"); cxe_push(av, &n, (char *)img);
        cxe_push(av, &n, "-c"); cxe_push(av, &n, "-b"); cxe_push(av, &n, "lnx/x86_64");
        cxe_push(av, &n, (char *)fx->xc); break;
    case 35:
        cxe_push(av, &n, "--emit-host-symbols"); cxe_push(av, &n, (char *)img);
        cxe_push(av, &n, "-S"); cxe_push(av, &n, "-b"); cxe_push(av, &n, "lnx/x86_64");
        cxe_push(av, &n, (char *)fx->xc); break;
    case 36:
        cxe_push(av, &n, "-O1"); cxe_push(av, &n, "-E"); cxe_push(av, &n, (char *)fx->xc); break;
    case 37:
        cxe_push(av, &n, "-O2"); cxe_push(av, &n, "-E"); cxe_push(av, &n, (char *)fx->xc); break;
    case 38:
        cxe_push(av, &n, "-O1"); cxe_push(av, &n, "-c"); cxe_push(av, &n, "-b");
        cxe_push(av, &n, "lnx/x86_64"); cxe_push(av, &n, "-o"); cxe_push(av, &n, (char *)img);
        cxe_push(av, &n, (char *)fx->mc); break;
    case 39:
        cxe_push(av, &n, "-O2"); cxe_push(av, &n, "-c"); cxe_push(av, &n, "-b");
        cxe_push(av, &n, "lnx/x86_64"); cxe_push(av, &n, "-o"); cxe_push(av, &n, (char *)img);
        cxe_push(av, &n, (char *)fx->mc); break;
    case 40:
        cxe_push(av, &n, "-DFOO"); cxe_push(av, &n, "-E"); cxe_push(av, &n, (char *)fx->dc); break;
    case 41:
        cxe_push(av, &n, "-UFOO"); cxe_push(av, &n, "-E"); cxe_push(av, &n, (char *)fx->dc); break;
    case 42:
        cxe_push(av, &n, "-DFOO"); cxe_push(av, &n, "-UFOO"); cxe_push(av, &n, "-E");
        cxe_push(av, &n, (char *)fx->dc); break;
    case 43:
        cxe_push(av, &n, "-I"); cxe_push(av, &n, (char *)fx->inc);
        cxe_push(av, &n, "-E"); cxe_push(av, &n, (char *)fx->qc); break;
    case 44:
        cxe_push(av, &n, "-I"); cxe_push(av, &n, (char *)fx->inc);
        cxe_push(av, &n, "-E"); cxe_push(av, &n, (char *)fx->ac); break;
    case 45:
        cxe_push(av, &n, "-include"); cxe_push(av, &n, (char *)fx->zh);
        cxe_push(av, &n, "-E"); cxe_push(av, &n, (char *)fx->ec); break;
    case 46:
        cxe_push(av, &n, "-iquote"); cxe_push(av, &n, (char *)fx->inc);
        cxe_push(av, &n, "-E"); cxe_push(av, &n, (char *)fx->qc); break;
    case 47:
        cxe_push(av, &n, (char *)fx->abs); break;
    default: cxe_die("face id");
    }
    return cxe_face_img[id];
}

int main(int argc, char **argv) {
    char root[4096], entry[4096], outdir[4096];
    char product[4096], bound[4096], tsvpath[4096], progpath[4096], dups[4096];
    char src[4096], pimg[4096], nimg[4096];
    char row[1024];
    const char *name, *mode, *target, *rel;
    struct cxe_fx *fx;
    FILE *tsv;
    struct stat st;
    long long t0, bytes;
    int at, lines, file, phase, secs;
    int mkdir(const char *, unsigned);
    if (argc == 4 && !strcmp(argv[1], "--")) { argv++; argc--; }
    if (argc != 3) {
        fprintf(stderr, "usage: ENTRY OUTDIR\n");
        return 2;
    }
    if ((int)(sizeof cxe_name / sizeof cxe_name[0]) != CXE_FILES) cxe_die("corpus");
    if ((int)(sizeof cxe_mode / sizeof cxe_mode[0]) != CXE_PHASES) cxe_die("phases");
    if ((int)(sizeof cxe_face_name / sizeof cxe_face_name[0]) != CXE_FACE_N) cxe_die("faces");
    if ((int)(sizeof cxe_face_mode / sizeof cxe_face_mode[0]) != CXE_FACE_N) cxe_die("face modes");
    if ((int)(sizeof cxe_face_tgt / sizeof cxe_face_tgt[0]) != CXE_FACE_N) cxe_die("face targets");
    if ((int)sizeof cxe_face_img != CXE_FACE_N) cxe_die("face image");
    if (CXE_FILES * CXE_PHASES + 1 != CXE_CORPUS) cxe_die("count");
    if (CXE_CORPUS + CXE_FACE_N != CXE_N) cxe_die("count");
    if (cxe_repo(root, (int)sizeof root)) cxe_die("repo root");
    if (!realpath(argv[1], entry)) cxe_die("ENTRY");
    if (!realpath(argv[2], outdir)) cxe_die("OUTDIR");
    if (stat(entry, &st) != 0 || !S_ISREG(st.st_mode)) cxe_die("ENTRY is not a regular file");
    bytes = (long long)st.st_size;
    cxe_join(product, (int)sizeof product, root, "unisacc.com");
    cxe_join(bound, (int)sizeof bound, root, "tools/bound");
    if (stat(product, &st) != 0 || !S_ISREG(st.st_mode)) cxe_die("product missing");
    if (stat(bound, &st) != 0 || !S_ISREG(st.st_mode)) cxe_die("bound missing");
    if (mkdir("/tmp/notrepo", 0755) != 0 && errno != EEXIST) cxe_die("notrepo");
    unsetenv("UNISA_CONTAINER");
    cxe_join(dups, (int)sizeof dups, outdir, "dup.c");
    if (np_writefile(dups, cxe_dup, sizeof cxe_dup - 1)) cxe_die("dup.c");
    cxe_join(tsvpath, (int)sizeof tsvpath, outdir, "cx-entry-matrix-2026-10-30.tsv");
    cxe_join(progpath, (int)sizeof progpath, outdir, "cx-entry-matrix.progress");
    cxe_join(pimg, (int)sizeof pimg, outdir, "cxe-p.img");
    cxe_join(nimg, (int)sizeof nimg, outdir, "cxe-n.img");
    if (cxe_load_at(progpath, &at)) cxe_die("progress unreadable");
    if (at >= CXE_N) {
        printf("LEFT:0\n");
        return 0;
    }
    fx = calloc(1, sizeof *fx);
    if (!fx) cxe_die("memory");
    cxe_prep(outdir, bound, product, fx);
    lines = cxe_lines(tsvpath);
    if (at == 0) {
        tsv = fopen(tsvpath, "wb");
        if (!tsv) cxe_die("tsv");
        fputs("corpus\tmode\ttarget\tprod_rc\tnew_rc\tprod_stdout_n\tnew_stdout_n\tprod_stderr_n\tnew_stderr_n\tprod_image_n\tnew_image_n\tprod_perm\tnew_perm\tverdict\tnote\tprod_wall_ns\tnew_wall_ns\n", tsv);
        if (fflush(tsv) != 0) cxe_die("tsv");
    } else {
        if (lines < 0) cxe_die("tsv missing");
        if (lines == at + 2) at = lines - 1;
        else if (lines != at + 1) cxe_die("progress does not match the table");
        if (at >= CXE_N) {
            cxe_save_at(progpath, at);
            printf("LEFT:0\n");
            return 0;
        }
        tsv = fopen(tsvpath, "ab");
        if (!tsv) cxe_die("tsv");
    }
    fprintf(stderr, "check-cx-entry entry=%s bytes=%lld at=%d\n", entry, bytes, at);
    t0 = cxe_ns();
    while (at < CXE_N) {
        long long el = cxe_ns() - t0;
        struct cxe_side ps, ns;
        const char *verdict, *note;
        const char *jmode;
        if (at >= CXE_CORPUS) {
            char secb[16];
            char *av[16];
            int fid;
            int image;
            if (el > CXE_SLICE_NS) break;
            fid = at - CXE_CORPUS;
            secs = 12;
            snprintf(secb, sizeof secb, "%d", secs);
            image = cxe_face(fid, av, bound, secb, product, pimg, fx, &name, &mode, &target);
            cxe_exec(av, secs, pimg, image, &ps);
            image = cxe_face(fid, av, bound, secb, entry, nimg, fx, &name, &mode, &target);
            cxe_exec(av, secs, nimg, image, &ns);
            jmode = image ? "-o" : "-E";
        } else {
            if (at == CXE_FILES * CXE_PHASES) {
                name = "dup.c";
                mode = "-run";
                target = "lnx/x86_64";
                snprintf(src, sizeof src, "%s", dups);
            } else {
                file = at / CXE_PHASES;
                phase = at % CXE_PHASES;
                name = cxe_name[file];
                rel = cxe_rel[file];
                mode = cxe_mode[phase];
                target = cxe_tgt[phase];
                cxe_join(src, (int)sizeof src, root, rel);
            }
            if (stat(src, &st) != 0 || !S_ISREG(st.st_mode)) cxe_die("corpus missing");
            secs = !strcmp(name, "dev-run.cx") ? 18 : 12;
            if (!strcmp(name, "dev-run.cx")) {
                if (el > 1000000000LL) break;
            } else if (el > CXE_SLICE_NS) {
                break;
            }
            cxe_run(bound, secs, product, mode, target, pimg, src, &ps);
            cxe_run(bound, secs, entry, mode, target, nimg, src, &ns);
            jmode = mode;
        }
        cxe_judge(&ps, &ns, jmode, pimg, nimg, secs, &verdict, &note);
        snprintf(row, sizeof row,
                 "%s\t%s\t%s\t%d\t%d\t%llu\t%llu\t%llu\t%llu\t%lld\t%lld\t%s\t%s\t%s\t%s\t%lld\t%lld\n",
                 name, mode, target, ps.rc, ns.rc,
                 (unsigned long long)ps.outn, (unsigned long long)ns.outn,
                 (unsigned long long)ps.errn, (unsigned long long)ns.errn,
                 ps.image_n, ns.image_n, ps.perm, ns.perm, verdict, note, ps.wall, ns.wall);
        if (fwrite(row, 1, strlen(row), tsv) != strlen(row) || fflush(tsv) != 0) cxe_die("tsv write");
        cxe_side_free(&ps);
        cxe_side_free(&ns);
        unlink(pimg);
        unlink(nimg);
        at++;
        cxe_save_at(progpath, at);
        printf("%s %s %s %s\n", verdict, name, mode, target);
        fflush(stdout);
    }
    if (fclose(tsv) != 0) cxe_die("tsv close");
    printf("LEFT:%d\n", CXE_N - at);
    return at >= CXE_N ? 0 : 2;
}
