/* check-lower-fnreuse.cx -- executable contract for the cross-function dependence of the lower/elf stages.
 *   sh ./unisacc.com tools/check-lower-fnreuse.cx
 * Fixtures are written at run time into a private directory under sy_tmpdir() (never into the repo):
 *   a  = printf("a\n"), return 0          b  = printf("hello %d\n", 7), return 7
 *   c  = b plus strlen                     a2 = a with the string grown into b's data bucket
 *   p/a = a copied under another path
 * Staged path: unisacc.com -S F.cx -o F.tape ; stream lower < tape > F.low ; stream elf < low > F.elf
 * (checked: the staged elf has the same sha256 as `unisacc.com F.cx -o F.o`).
 * Lower tapes are split at top-level "NAME:" label lines and compared per segment:
 *   raw = identical bytes, nou = identical after dropping ".unit " lines,
 *   norm = nou and every decimal run of >= 5 digits replaced by N (absolute data addresses).
 * Expected numbers: measured 2026-11-15 on branch v0.0.68 with the installed unisacc.com
 * (job 2798e440 tmp/v68 lowcmp.*.txt). When the product changes these numbers, adjust them to the
 * new facts and record the new source here; do not drop an assertion.
 *   (1) a2 vs b: common=400, nou=399, the only differing segment is main:
 *       elf library region [0x400,0x8000) has 0 differing bytes (measured diffs: header/_start
 *       bytes 97..302 and from 35925 on = main + data)
 *   (2) a vs b: norm=399, only main differs after address normalisation
 *   (3) b vs c: common - norm = 9 differing segments, listed as DIFF lines
 *   (4) a vs p/a: raw tapes differ only in ".unit " lines (nou of the whole file is identical)
 * Last line: LOWER_FNREUSE<TAB>pairs=3<TAB>failed=N (TAB-separated: run-batch's rc0 marker rule) */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sys.sha
#pragma unisa use text.text

typedef struct { const char *name; int nlen; const char *p; long n; } Seg;

static char U[4096], D[4096];
static int failed = 0;

static void fail(const char *what) { printf("FAIL\t%s\n", what); failed++; }

static int sh(const char *cmd) {
    char *argv[4]; sy_spawn_t o; sy_exit_t st;
    argv[0] = "sh"; argv[1] = "-c"; argv[2] = (char *)cmd; argv[3] = 0;
    sy_spawn_init(&o); o.argv = argv; o.cwd = D; o.pgroup = -1; o.deadline_ms = 55000;
    if (sy_proc_run(&o, &st)) return -1;
    if (st.timed_out) return 124;
    return sy_exit_code(&st);
}

static int put(const char *name, const char *text) {
    char p[4200];
    if (cx_fmt(p, sizeof p, "%s/%s", D, name)) return -1;
    return sy_write_file(p, text, (int64_t)strlen(text), 0644);
}

static unsigned char *slurp(const char *name, long *n) {
    char p[4200]; unsigned char *b = 0; int64_t m = 0;
    if (cx_fmt(p, sizeof p, "%s/%s", D, name) || sy_read_file(p, &b, &m, 1 << 26)) { printf("ERROR\tcannot read %s\n", name); exit(2); }
    *n = (long)m; return b;
}

/* F without extension: F.cx -> F.tape -> F.low -> F.elf */
static void stage(const char *f) {
    char c[16384];
    cx_fmt(c, sizeof c, "sh '%s' -S %s.cx -o %s.tape && sh '%s' stream lower < %s.tape > %s.low && sh '%s' stream elf < %s.low > %s.elf",
           U, f, f, U, f, f, U, f, f);
    if (sh(c)) { printf("ERROR\tstaging %s failed\n", f); exit(2); }
}

static int is_label(const char *s, long n) {
    long i;
    if (n < 2 || s[n - 1] != ':' || s[0] == '.' || s[0] == '@') return 0;
    for (i = 0; i < n - 1; i++) if (s[i] == ' ' || s[i] == '\t') return 0;
    return 1;
}

static int split(const char *b, long n, Seg *sg, int cap) {
    long i = 0; int k = 0;
    while (i < n) {
        long j = i; while (j < n && b[j] != '\n') j++;
        if (is_label(b + i, j - i)) {
            if (k) sg[k - 1].n = (b + i) - sg[k - 1].p;
            if (k >= cap) { printf("ERROR\ttoo many labels\n"); exit(2); }
            sg[k].name = b + i; sg[k].nlen = (int)(j - i); sg[k].p = b + i; k++;
        }
        i = j + 1;
    }
    if (k) sg[k - 1].n = (b + n) - sg[k - 1].p;
    return k;
}

static long norm(const char *p, long n, char *o, int mode) {
    long i = 0, w = 0;
    while (i < n) {
        long j = i; while (j < n && p[j] != '\n') j++;
        if (!(j - i >= 6 && !memcmp(p + i, ".unit ", 6))) {
            long a = i;
            while (a < j) {
                if (mode == 2 && p[a] >= '0' && p[a] <= '9') {
                    long e = a; while (e < j && p[e] >= '0' && p[e] <= '9') e++;
                    if (e - a >= 5) { o[w++] = 'N'; a = e; } else while (a < e) o[w++] = p[a++];
                } else o[w++] = p[a++];
            }
            o[w++] = '\n';
        }
        i = j + 1;
    }
    return w;
}

typedef struct { int ka, kb, common, raw, nou, norm, ndiff; char diff[4096]; } Cmp;

/* LEVEL: 1 = a segment differs if not nou-equal, 2 = if not norm-equal; names of differing segments go to diff */
static void lowcmp(const char *fa, const char *fb, int level, Cmp *r) {
    static Seg sa[4096], sb[4096];
    long na, nb, i, j; const char *a = (const char *)slurp(fa, &na), *b = (const char *)slurp(fb, &nb);
    char *oa = malloc(na + 16), *ob = malloc(nb + 16);
    memset(r, 0, sizeof *r);
    r->ka = split(a, na, sa, 4096); r->kb = split(b, nb, sb, 4096);
    for (i = 0; i < r->ka; i++) {
        int hit = -1, eqn = 0, eqm = 0;
        for (j = 0; j < r->kb; j++) if (sb[j].nlen == sa[i].nlen && !memcmp(sb[j].name, sa[i].name, sa[i].nlen)) { hit = (int)j; break; }
        if (hit < 0) continue;
        r->common++;
        if (sa[i].n == sb[hit].n && !memcmp(sa[i].p, sb[hit].p, sa[i].n)) { r->raw++; eqn = eqm = 1; }
        else {
            long wa = norm(sa[i].p, sa[i].n, oa, 1), wb = norm(sb[hit].p, sb[hit].n, ob, 1);
            if (wa == wb && !memcmp(oa, ob, wa)) eqn = eqm = 1;
            else { wa = norm(sa[i].p, sa[i].n, oa, 2); wb = norm(sb[hit].p, sb[hit].n, ob, 2); eqm = wa == wb && !memcmp(oa, ob, wa); }
        }
        r->nou += eqn; r->norm += eqm;
        if (!(level == 1 ? eqn : eqm)) {
            long l = (long)strlen(r->diff);
            r->ndiff++;
            printf("DIFF\t%s|%s\t%.*s\n", fa, fb, sa[i].nlen, sa[i].name);
            if (l + sa[i].nlen + 2 < (long)sizeof r->diff) { int q; for (q = 0; q < sa[i].nlen; q++) r->diff[l + q] = sa[i].name[q]; r->diff[l + sa[i].nlen] = ' '; r->diff[l + sa[i].nlen + 1] = 0; }
        }
    }
    printf("LOWCMP\t%s|%s\tlabelsA=%d labelsB=%d common=%d raw=%d nou=%d norm=%d\n", fa, fb, r->ka, r->kb, r->common, r->raw, r->nou, r->norm);
    free(oa); free(ob); free((void *)a); free((void *)b);
}

int main(void) {
    Cmp r; long n1, n2, i, nd; unsigned char *e1, *e2; char h1[65], h2[65];
    const char *t = sy_tmpdir();
    {   /* the product at the checkout root this check runs from */
        char cwd[4000]; int bad = !getcwd(cwd, sizeof cwd) || cx_fmt(U, sizeof U, "%s/unisacc.com", cwd);   /* a missing product fails at staging */
        if (bad) { printf("ERROR\tno ./unisacc.com at the working directory\n"); return 2; }
    }
    if (cx_fmt(D, sizeof D, "%s/lower-fnreuse-XXXXXX", t ? t : "/tmp") || !mkdtemp(D)) { printf("ERROR\tmkdtemp\n"); return 2; }
    if (put("a.cx", "#include <stdio.h>\nint main(void){ printf(\"a\\n\"); return 0; }\n")
        || put("b.cx", "#include <stdio.h>\nint main(void){ printf(\"hello %d\\n\", 7); return 7; }\n")
        || put("c.cx", "#include <stdio.h>\n#include <string.h>\nint main(void){ printf(\"hello %d\\n\", (int)strlen(\"abcdefg\")); return 7; }\n")
        || put("a2.cx", "#include <stdio.h>\nint main(void){ printf(\"aaaaaaaaa\\n\"); return 0; }\n")
        || sh("mkdir -p p && cp a.cx p/a.cx")) { printf("ERROR\twriting fixtures\n"); return 2; }
    stage("a"); stage("b"); stage("c"); stage("a2"); stage("p/a");

    /* staged path equals the one-shot -o product */
    { char c[8400]; cx_fmt(c, sizeof c, "sh '%s' b.cx -o b.o", U); if (sh(c)) fail("b.cx -o b.o"); }
    e1 = slurp("b.elf", &n1); e2 = slurp("b.o", &n2);
    sy_sha256_hex(e1, n1, h1); sy_sha256_hex(e2, n2, h2);
    printf("SHA\tstaged=%.16s oneshot=%.16s\n", h1, h2);
    if (strcmp(h1, h2)) fail("staged -S|lower|elf sha != -o sha");
    free(e1); free(e2);

    /* (1) a2 vs b */
    lowcmp("a2.low", "b.low", 1, &r);
    if (r.common != 400) fail("a2/b common != 400");
    if (r.nou != 399) fail("a2/b nou != 399");
    if (r.ndiff != 1 || strcmp(r.diff, "main: ")) fail("a2/b differing segments != {main}");
    e1 = slurp("a2.elf", &n1); e2 = slurp("b.elf", &n2); nd = 0;
    for (i = 0x400; i < 0x8000 && i < n1 && i < n2; i++) nd += e1[i] != e2[i];
    printf("ELF\ta2.elf|b.elf\tlibregion=[0x400,0x8000) diffbytes=%ld sizes=%ld/%ld\n", nd, n1, n2);
    if (nd != 0 || n1 < 0x8000 || n2 < 0x8000) fail("a2/b elf library region differs");
    free(e1); free(e2);

    /* (2) a vs b */
    lowcmp("a.low", "b.low", 2, &r);
    if (r.norm != 399) fail("a/b norm != 399");
    if (r.ndiff != 1 || strcmp(r.diff, "main: ")) fail("a/b differing segments after normalisation != {main}");

    /* (3) b vs c */
    lowcmp("b.low", "c.low", 2, &r);
    printf("RENUM\tb.low|c.low\tlabelsB=%d labelsC=%d common=%d differing=%d\n", r.ka, r.kb, r.common, r.common - r.norm);
    if (r.common - r.norm != 9 || r.ndiff != 9) fail("b/c differing segments != 9");

    /* (4) path copy: only .unit lines differ */
    {
        long w1, w2; char *o1, *o2;
        e1 = slurp("a.low", &n1); e2 = slurp("p/a.low", &n2);
        o1 = malloc(n1 + 16); o2 = malloc(n2 + 16);
        w1 = norm((char *)e1, n1, o1, 1); w2 = norm((char *)e2, n2, o2, 1);
        printf("PATH\ta.low|p/a.low\traw_equal=%d nounit_equal=%d\n", n1 == n2 && !memcmp(e1, e2, n1), w1 == w2 && !memcmp(o1, o2, w1));
        if (n1 == n2 && !memcmp(e1, e2, n1)) fail("path copy: raw tapes identical (no .unit difference observed)");
        if (!(w1 == w2 && !memcmp(o1, o2, w1))) fail("path copy differs beyond .unit lines");
        free(o1); free(o2); free(e1); free(e2);
    }

    { char c[8400]; cx_fmt(c, sizeof c, "rm -rf '%s'", D); sh(c); }
    printf("LOWER_FNREUSE\tpairs=3\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
