/* tools/check-verseq-gen.cx -- tools/verseq-gen.cx 的检查:夹具目录里逐条验证 R1/R2/R3/R4/R5 的绿与红(负控)。
 *
 *   sh ./unisacc.com tools/check-verseq-gen.cx
 *
 * 夹具在系统临时目录,不碰仓库。每条红都必须点名规则且给原行;改动一处只红一处。
 * R5 只查紧跟「顺延至」「置入」的号,以及回滚行 plans/v0.0.NN.md。同行原号不查。豁免:整行含「本页正文搬自」。
 * --reorder 夹具:dry-run 不写、--write 只改 slot、计划正文字节不变、之后 --check 绿、缺/重/未知/域外 rc 2 不写、规则红 rc 1 不写。
 * 末行 CHECK_VERSEQ_GEN<TAB>checks=N<TAB>failed=F,rc 0 全绿。 */
#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.time
#pragma unisa use sys.env
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.bytes
#pragma unisa use mem.heap

static int failed, checks;
static char dir[400];

static void ck(int ok, const char *name) {
    checks++;
    if (ok) sy_printf("PASS\tcheck-verseq-gen.%s\n", name);
    else { failed++; sy_printf("FAIL\tcheck-verseq-gen.%s\n", name); }
}
static int has(const char *h, long hn, const char *lit) {
    long ln = tx_len(lit, 4096);
    for (long i = 0; i + ln <= hn; i++) if (h[i] == lit[0] && mm_same(h + i, lit, ln)) return 1;
    return 0;
}
static void put(const char *rel, const char *body) {
    char p[700];
    if (cx_fmt(p, sizeof p, "%s/%s", dir, rel)) return;
    cx_write(p, body, tx_len(body, 20000));
}
/* 跑一次 --check,输出复制到 out;返回 rc */
static int run(char *out, long cap) {
    char cmd[900]; char *o = 0; size_t n = 0; int rc;
    if (cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com tools/verseq-gen.cx -- --check --root %s", dir)) return -1;
    char *v[] = {"sh", "-c", cmd, 0};
    rc = cx_runv_timeout(v, 50, &o, &n);
    out[0] = 0;
    if (o && (long)n < cap) { mm_copy(out, cap, o, n); out[n] = 0; }
    return rc;
}
static int fail_text_len(const char *h, long hn, const char *mark, int *out) {
    long i = 0, ml = tx_len(mark, 80);
    while (i < hn) {
        long e = i; int tabs = 0; long p;
        while (e < hn && h[e] != '\n') e++;
        if (e - i >= ml) {
            long j; int hit = 0;
            for (j = i; j + ml <= e; j++) if (h[j] == mark[0] && mm_same(h + j, mark, ml)) { hit = 1; break; }
            if (hit) {
                for (p = i; p < e && tabs < 4; p++) if (h[p] == '\t') tabs++;
                if (tabs == 4) { *out = (int)(e - p); return 1; }
            }
        }
        i = e + 1;
    }
    return 0;
}
static int run_abs(const char *cwd, const char *root, char *out, long cap) {
    char here[500], cmd[1400]; char *o = 0; size_t n = 0; int rc;
    char *pv[] = {"pwd", 0};
    if (cx_runv_timeout(pv, 10, &o, &n) != 0 || n < 2 || n >= sizeof here) return -1;
    mm_copy(here, sizeof here, o, n); here[n] = 0;
    for (n = 0; here[n]; n++) if (here[n] == '\n') here[n] = 0;
    if (cx_fmt(cmd, sizeof cmd, "cd %s && env -u HOME sh %s/unisacc.com %s/tools/verseq-gen.cx -- --check --root %s", cwd, here, here, root)) return -1;
    {   char *v[] = {"sh", "-c", cmd, 0};
        o = 0; n = 0;
        rc = cx_runv_timeout(v, 50, &o, &n);
        out[0] = 0;
        if (o && (long)n < cap) { mm_copy(out, cap, o, n); out[n] = 0; }
    }
    return rc;
}

#define SEQ "slot\tversion\tclass\tstate\tnote\n" \
    "1\t0.0.92\t事实表整理\t已公开\t冻结 F aaa\n" \
    "2\t0.0.93\t执行器内核产品化\t已公开\t冻结 F bbb\n" \
    "3\t0.0.94\t冷跑缓存类\t建议\t计划 plans/v0.0.94.md\n"

/* 干净夹具:四类全对 */
static void fixture(int r1, int r2, int r3, int r4) {
    put("build/version-seq.tsv", SEQ);
    /* R1 红:文件名 0.0.93 但标题写 0.0.94 */
    put("plans/v0.0.93.md", r1 ? "# 0.0.94 计划:执行器内核产品化(执行器内核)\n" : "# 0.0.93 计划:执行器内核产品化(执行器内核)\n");
    /* R2 红:标题主题与表 class 不交叉 */
    put("plans/v0.0.94.md", r2 ? "# 0.0.94 计划:前端诊断三期(前端)\n" : "# 0.0.94 计划:冷跑缓存类(驱动)\n");
    /* R3 红:同行版本 0.0.92 指向 plans/v0.0.94.md */
    put("prd_mempalace.md", r3 ? "- 当前 0.0.92 已公开,下一版入口 plans/v0.0.94.md\n" : "- 当前 0.0.94 为下一版,入口 plans/v0.0.94.md\n");
    put(".claude/worktrees/v0.0.93/build/version-seq.tsv",
        r4 ? "slot\tversion\tclass\tstate\tnote\n2\t0.0.93\t别的主题\t已公开\t冻结\n"
           : "slot\tversion\tclass\tstate\tnote\n2\t0.0.93\t执行器内核产品化\t已公开\t冻结\n");
}

static char out[200000];
static int rrun(const char *cmd, char *out, long cap) {
    char *o = 0; size_t n = 0; int rc;
    char *v[] = {"sh", "-c", (char *)cmd, 0};
    rc = cx_runv_timeout(v, 50, &o, &n);
    out[0] = 0;
    if (o && (long)n < cap) { mm_copy(out, cap, o, n); out[n] = 0; }
    return rc;
}
static void rput(const char *d, const char *rel, const char *body) {
    char p[700];
    if (!cx_fmt(p, sizeof p, "%s/%s", d, rel)) cx_write(p, body, tx_len(body, 20000));
}
static int rreorder(const char *d, const char *order, const char *extra) {
    char op[700], cmd[1400];
    rput(d, "order.txt", order);
    if (cx_fmt(op, sizeof op, "%s/order.txt", d)) return -1;
    if (cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com tools/verseq-gen.cx -- --reorder %s %s --root %s", op, extra, d)) return -1;
    return rrun(cmd, out, sizeof out);
}
static int rfile_is(const char *d, const char *rel, const char *want) {
    char p[700]; unsigned char *b = 0; int64_t m = 0;
    if (cx_fmt(p, sizeof p, "%s/%s", d, rel)) return 0;
    if (sy_read_file(p, &b, &m, 1 << 20) < 0) return 0;
    long wl = tx_len(want, 20000);
    return m == wl && mm_same(b, want, wl);
}

int main(int argc, char **argv) {
    (void)argc; (void)argv;
    char tmpl[400];
    if (sy_mkdtemp(sy_tmpdir(), "check-verseq-", dir, sizeof dir) != 0) return 2;
    (void)tmpl;
    {   char p[700];
        if (!cx_fmt(p, sizeof p, "%s/plans", dir)) sy_mkdir_all(p, 0700);
        if (!cx_fmt(p, sizeof p, "%s/build", dir)) sy_mkdir_all(p, 0700);
        if (!cx_fmt(p, sizeof p, "%s/.claude/worktrees/v0.0.93/build", dir)) sy_mkdir_all(p, 0700);
    }
    int rc;
    fixture(0, 0, 0, 0);
    rc = run(out, sizeof out);
    ck(rc == 0 && !has(out, tx_len(out, 200000), "FAIL"), "clean-all-four-green");
    ck(has(out, tx_len(out, 200000), "VERSEQ_SUMMARY"), "summary-line-present");
    {   char p[700];
        if (cx_fmt(p, sizeof p, "%s/.claude/worktrees/v0.1.4/build", dir) || sy_mkdir_all(p, 0700)) return 2;
        put("build/version-seq.tsv", SEQ "4\t0.1.0\t封存\t已公开\t-\n");
        put("plans/v0.1.0.md", "# 0.1.0 计划:封存\n顺延至 0.1.0\n");
        put("prd_mempalace.md", "0.1.0 见 plans/v0.1.0.md\n");
        put(".claude/worktrees/v0.1.4/build/version-seq.tsv", "4\t0.1.0\t错误\t已公开\t-\n");
        rc = run(out, sizeof out);
        ck(rc == 1 && has(out, tx_len(out, 200000), "FAIL\tR4\t") &&
           has(out, tx_len(out, 200000), "worktrees/v0.1.4/build/version-seq.tsv"), "minor-worktree-published-drift");
        put(".claude/worktrees/v0.1.4/build/version-seq.tsv", "4\t0.1.0\t封存\t已公开\t-\n");
        put("plans/v0.1.0.md", "# 0.1.0 计划:封存\n顺延至 0.1.4\n");
        rc = run(out, sizeof out);
        ck(rc == 1 && has(out, tx_len(out, 200000), "wrong=0.1.4 ") &&
           !has(out, tx_len(out, 200000), "FAIL\tR4\t"), "minor-plan-self-reference-drift");
        if (cx_fmt(p, sizeof p, "%s/.claude/worktrees/v0.1.4/build/version-seq.tsv", dir) || sy_unlink(p)) return 2;
        if (cx_fmt(p, sizeof p, "%s/plans/v0.1.0.md", dir) || sy_unlink(p)) return 2;
    }
    fixture(1, 0, 0, 0);
    rc = run(out, sizeof out);
    ck(rc == 1 && has(out, tx_len(out, 200000), "FAIL\tR1\t") && has(out, tx_len(out, 200000), "plans/v0.0.93.md"), "neg-r1-filename-vs-title");
    ck(!has(out, tx_len(out, 200000), "FAIL\tR2\t") && !has(out, tx_len(out, 200000), "FAIL\tR3\t") && !has(out, tx_len(out, 200000), "FAIL\tR4\t"), "neg-r1-only-r1");

    fixture(0, 1, 0, 0);
    rc = run(out, sizeof out);
    ck(rc == 1 && has(out, tx_len(out, 200000), "FAIL\tR2\t") && has(out, tx_len(out, 200000), "plans/v0.0.94.md"), "neg-r2-title-topic");

    fixture(0, 0, 1, 0);
    rc = run(out, sizeof out);
    ck(rc == 1 && has(out, tx_len(out, 200000), "FAIL\tR3\t") && has(out, tx_len(out, 200000), "prd_mempalace.md"), "neg-r3-palace-pair");

    fixture(0, 0, 0, 1);
    rc = run(out, sizeof out);
    ck(rc == 1 && has(out, tx_len(out, 200000), "FAIL\tR4\t") && has(out, tx_len(out, 200000), "version-seq.tsv"), "neg-r4-worktree-seq");

    /* 未公开行不参与 R4:工作树里 0.0.94 建议行不同不算红 */
    put(".claude/worktrees/v0.0.93/build/version-seq.tsv",
        "slot\tversion\tclass\tstate\tnote\n2\t0.0.93\t执行器内核产品化\t已公开\t冻结\n3\t0.0.94\t别的主题\t建议\t未公开\n");
    rc = run(out, sizeof out);
    ck(rc == 0 && !has(out, tx_len(out, 200000), "FAIL\tR4\t"), "unpublished-row-not-checked");

    /* R5 绿:自指号等于文件名;非自指行的别号(前置)不误报 */
    fixture(0, 0, 0, 0);
    put("plans/v0.0.93.md",
        "# 0.0.93 计划:执行器内核产品化(执行器内核)\n"
        "定稿(重排顺延至 0.0.93,置入 0.0.93):\n"
        "- 回滚:按提交回退 plans/v0.0.93.md\n"
        "前置 0.0.91 已满足\n");
    rc = run(out, sizeof out);
    ck(rc == 0 && !has(out, tx_len(out, 200000), "FAIL\tR5\t"), "r5-self-ref-pass");

    /* R5 红:错号点名文件、行号、wrong=错号;只红 R5 */
    put("plans/v0.0.93.md",
        "# 0.0.93 计划:执行器内核产品化(执行器内核)\n"
        "定稿(重排顺延至 0.0.99):\n"
        "- 回滚:按提交回退 plans/v0.0.91.md\n");
    rc = run(out, sizeof out);
    ck(rc == 1 && has(out, tx_len(out, 200000), "FAIL\tR5\t") && has(out, tx_len(out, 200000), "plans/v0.0.93.md") && has(out, tx_len(out, 200000), "wrong=99 ") && has(out, tx_len(out, 200000), "wrong=91 "), "r5-wrong-number-names-file-line");
    ck(!has(out, tx_len(out, 200000), "FAIL\tR1\t") && !has(out, tx_len(out, 200000), "FAIL\tR2\t") && !has(out, tx_len(out, 200000), "FAIL\tR3\t") && !has(out, tx_len(out, 200000), "FAIL\tR4\t"), "r5-wrong-only-r5");

    /* 豁免:「本页正文搬自 v0.0.NN」整行不误报,同文件正确自指仍绿 */
    put("plans/v0.0.93.md",
        "# 0.0.93 计划:执行器内核产品化(执行器内核)\n"
        "本页正文搬自 v0.0.80,顺延至 0.0.70,回滚 plans/v0.0.70.md\n"
        "定稿(重排顺延至 0.0.93):\n"
        "- 回滚:按提交回退 plans/v0.0.93.md\n");
    rc = run(out, sizeof out);
    ck(rc == 0 && !has(out, tx_len(out, 200000), "FAIL\tR5\t") && !has(out, tx_len(out, 200000), "wrong=70") && !has(out, tx_len(out, 200000), "wrong=80"), "r5-exempt-moved-from-line");
    /* 原号说明不误报:顺延至后的号对,同行原号与从号不查 */
    put("plans/v0.0.93.md",
        "# 0.0.93 计划:执行器内核产品化(执行器内核)\n"
        "定稿(重排顺延至 0.0.93(原 0.0.91),从 0.0.88 顺延至 0.0.93):\n"
        "- 回滚:按提交回退 plans/v0.0.93.md\n");
    rc = run(out, sizeof out);
    ck(rc == 0 && !has(out, tx_len(out, 200000), "FAIL\tR5\t") && !has(out, tx_len(out, 200000), "wrong=91") && !has(out, tx_len(out, 200000), "wrong=88"), "r5-defer-with-origin-pass");
    put("plans/v0.0.93.md",
        "# 0.0.93 计划:执行器内核产品化(执行器内核)\n"
        "定稿(重排置入 0.0.88):\n");
    rc = run(out, sizeof out);
    ck(rc == 1 && has(out, tx_len(out, 200000), "FAIL\tR5\t") && has(out, tx_len(out, 200000), "wrong=88 "), "r5-place-follow-only");
    /* 短行:拷贝长度必须等于 wrong= 前缀加该行,不得带入下一行 */
    put("plans/v0.0.93.md",
        "# 0.0.93 计划:执行器内核产品化(执行器内核)\n"
        "顺延至 0.0.99\n"
        "NOTCOPIED\n");
    rc = run(out, sizeof out);
    {   int fl = 0;
        ck(rc == 1 && fail_text_len(out, tx_len(out, 200000), "wrong=99 ", &fl) && fl == 9 + (int)tx_len("顺延至 0.0.99", 40) && !has(out, tx_len(out, 200000), "NOTCOPIED"), "r5-short-copy-len");
    }
    /* 长行:自指行超过截断阈值,wrong= 前缀在,文本字段长 399,行尾标记不得出现 */
    {   char body[900]; long n = 0; int k;
        const char *head = "# 0.0.93 计划:执行器内核产品化(执行器内核)\n顺延至 0.0.99 ";
        long hl = tx_len(head, 200);
        mm_copy(body, sizeof body, head, hl); n = hl;
        for (k = 0; k < 420 && n < (long)sizeof body - 16; k++) body[n++] = 'A';
        mm_copy(body + n, sizeof body - (size_t)n, "ZZLATE\n", 7); n += 7;
        {   char p[700];
            if (!cx_fmt(p, sizeof p, "%s/plans/v0.0.93.md", dir)) cx_write(p, body, n);
        }
        rc = run(out, sizeof out);
        {   int fl = 0;
            ck(rc == 1 && has(out, tx_len(out, 200000), "wrong=99 ") && fail_text_len(out, tx_len(out, 200000), "wrong=99 ", &fl) && fl == 399 && !has(out, tx_len(out, 200000), "ZZLATE"), "r5-long-line-trunc");
        }
    }
    /* 环境与 cwd 反例:外目录加去掉 HOME,缺 version-seq 必须拒绝,不得回落到共享仓 */
    {   char empty[400], foreign[400];
        if (sy_mkdtemp(sy_tmpdir(), "verseq-empty-", empty, sizeof empty) != 0) return 2;
        if (sy_mkdtemp(sy_tmpdir(), "verseq-cwd-", foreign, sizeof foreign) != 0) return 2;
        rc = run_abs(foreign, empty, out, sizeof out);
        ck(rc == 2 && has(out, tx_len(out, 200000), "VERSEQ\tREFUSE") && !has(out, tx_len(out, 200000), "plans/v0.0."), "env-missing-seq-refuses");
        fixture(0, 0, 0, 0);
        put("plans/v0.0.93.md",
            "# 0.0.93 计划:执行器内核产品化(执行器内核)\n"
            "定稿(重排顺延至 0.0.93):\n"
            "- 回滚:按提交回退 plans/v0.0.93.md\n");
        rc = run_abs(foreign, dir, out, sizeof out);
        ck(rc == 0 && has(out, tx_len(out, 200000), "VERSEQ_SUMMARY") && !has(out, tx_len(out, 200000), "FAIL"), "cwd-foreign-honors-root");
    }

    /* --reorder:只改 slot 列,计划正文字节不变,非法列表 rc 2,规则红拒写 */
    {   char rd[400], p[700], cmd[1400];
        const char *seq = "slot\tversion\tclass\tstate\tnote\n"
            "1\t0.0.92\t事实表整理\t已公开\t冻结\n"
            "2\t0.0.93\t执行器内核产品化\t建议\t号跳过\n"
            "3\t0.0.94\t冷跑缓存类\t已公开\t冻结\n"
            "4\t0.0.95\t甲类\t建议\t计划 plans/v0.0.95.md\n"
            "5\t0.0.96\t乙类\t建议\t计划 plans/v0.0.96.md\n"
            "6\t0.0.97\t丙类\t建议\t计划 plans/v0.0.97.md\n";
        const char *p95 = "# 0.0.95 计划:甲类(产品车道)\n正文 A 重排置入 0.0.95\n- 回滚:按提交回退 plans/v0.0.95.md\n";
        const char *p96 = "# 0.0.96 计划:乙类(产品车道)\n正文 B\n";
        const char *p97 = "# 0.0.97 计划:丙类(产品车道)\n正文 C\n";
        if (sy_mkdtemp(sy_tmpdir(), "verseq-reorder-", rd, sizeof rd) != 0) return 2;
        if (!cx_fmt(p, sizeof p, "%s/plans", rd)) sy_mkdir_all(p, 0700);
        if (!cx_fmt(p, sizeof p, "%s/build", rd)) sy_mkdir_all(p, 0700);
        rput(rd, "build/version-seq.tsv", seq);
        rput(rd, "plans/v0.0.95.md", p95); rput(rd, "plans/v0.0.96.md", p96); rput(rd, "plans/v0.0.97.md", p97);
        rput(rd, "prd_mempalace.md", "- 下一版 0.0.95 入口 plans/v0.0.95.md\n");
        rc = rreorder(rd, "0.0.97\n0.0.95\n0.0.96\n", "");
        ck(rc == 0 && has(out, tx_len(out, 200000), "MOVE\t0.0.97\tslot 6 -> 4") && has(out, tx_len(out, 200000), "write=0"), "reorder-dryrun-diff");
        ck(rfile_is(rd, "build/version-seq.tsv", seq), "reorder-dryrun-no-write");
        rc = rreorder(rd, "0.0.97\n0.0.95\n0.0.96\n", "--write");
        ck(rc == 0 && has(out, tx_len(out, 200000), "write=1") && rfile_is(rd, "build/version-seq.tsv",
            "slot\tversion\tclass\tstate\tnote\n1\t0.0.92\t事实表整理\t已公开\t冻结\n2\t0.0.93\t执行器内核产品化\t建议\t号跳过\n3\t0.0.94\t冷跑缓存类\t已公开\t冻结\n"
            "4\t0.0.97\t丙类\t建议\t计划 plans/v0.0.97.md\n5\t0.0.95\t甲类\t建议\t计划 plans/v0.0.95.md\n6\t0.0.96\t乙类\t建议\t计划 plans/v0.0.96.md\n"), "reorder-write-slots-only");
        ck(rfile_is(rd, "plans/v0.0.95.md", p95) && rfile_is(rd, "plans/v0.0.96.md", p96) && rfile_is(rd, "plans/v0.0.97.md", p97), "reorder-plans-bytes-unchanged");
        cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com tools/verseq-gen.cx -- --check --root %s", rd);
        rc = rrun(cmd, out, sizeof out);
        ck(rc == 0 && !has(out, tx_len(out, 200000), "FAIL"), "reorder-then-check-green");
        rput(rd, "build/version-seq.tsv", seq);
        rc = rreorder(rd, "0.0.97\n0.0.95\n", "--write");
        ck(rc == 2 && has(out, tx_len(out, 200000), "REFUSE\tmissing-version\t0.0.96") && rfile_is(rd, "build/version-seq.tsv", seq), "reorder-missing-rc2");
        rc = rreorder(rd, "0.0.97\n0.0.97\n0.0.95\n0.0.96\n", "--write");
        ck(rc == 2 && has(out, tx_len(out, 200000), "REFUSE\tduplicate") && rfile_is(rd, "build/version-seq.tsv", seq), "reorder-duplicate-rc2");
        rc = rreorder(rd, "0.0.97\n0.0.95\n0.0.96\n0.0.199\n", "--write");
        ck(rc == 2 && has(out, tx_len(out, 200000), "REFUSE\tunknown-version") && rfile_is(rd, "build/version-seq.tsv", seq), "reorder-unknown-rc2");
        rc = rreorder(rd, "0.0.94\n0.0.97\n0.0.95\n0.0.96\n", "--write");
        ck(rc == 2 && has(out, tx_len(out, 200000), "REFUSE\toutside-domain") && rfile_is(rd, "build/version-seq.tsv", seq), "reorder-published-rc2");
        rc = rreorder(rd, "0.0.93\n0.0.97\n0.0.95\n0.0.96\n", "--write");
        ck(rc == 2 && has(out, tx_len(out, 200000), "REFUSE\toutside-domain") && rfile_is(rd, "build/version-seq.tsv", seq), "reorder-skipped-old-row-rc2");
        rc = rreorder(rd, "0.0.97\n...rest\n", "");
        ck(rc == 0 && has(out, tx_len(out, 200000), "MOVE\t0.0.95\tslot 4 -> 5") && has(out, tx_len(out, 200000), "MOVE\t0.0.96\tslot 5 -> 6"), "reorder-rest-keeps-order");
        rput(rd, "plans/v0.0.96.md", "# 0.0.99 计划:乙类(产品车道)\n正文 B\n");
        rc = rreorder(rd, "0.0.97\n0.0.95\n0.0.96\n", "--write");
        ck(rc == 1 && has(out, tx_len(out, 200000), "FAIL\tR1\t") && has(out, tx_len(out, 200000), "rules=red") && rfile_is(rd, "build/version-seq.tsv", seq), "reorder-red-rules-refuse-write");
    }
    /* 公开后重排:后排版本(0.0.98,slot 7)已公开,其前 0.0.95-0.0.97(slot 4-6)未公开;重排后它们整体落到已定行之后,下一版 = 列表第一项 */
    {   char rd[400], p[700];
        const char *seq = "slot\tversion\tclass\tstate\tnote\n"
            "1\t0.0.92\t事实表整理\t已公开\t冻结\n"
            "2\t0.0.93\t执行器内核产品化\t建议\t号跳过,不占号\n"
            "3\t0.0.94\t冷跑缓存类\t已公开\t冻结\n"
            "4\t0.0.95\t甲类\t建议\t计划 plans/v0.0.95.md\n"
            "5\t0.0.96\t乙类\t建议\t计划 plans/v0.0.96.md\n"
            "6\t0.0.97\t丙类\t建议\t计划 plans/v0.0.97.md\n"
            "7\t0.0.98\t丁类\t已公开\t冻结\n"
            "8\t0.0.99\t戊类\t建议\t计划\n";
        if (sy_mkdtemp(sy_tmpdir(), "verseq-postpub-", rd, sizeof rd) != 0) return 2;
        if (!cx_fmt(p, sizeof p, "%s/build", rd)) sy_mkdir_all(p, 0700);
        rput(rd, "build/version-seq.tsv", seq);
        rc = rreorder(rd, "0.0.96\n0.0.95\n0.0.99\n...rest\n", "--write");
        ck(rc == 0 && has(out, tx_len(out, 200000), "REORDER_NEXT\t0.0.96\tdomain-first") && has(out, tx_len(out, 200000), "REORDER_NOTE") && rfile_is(rd, "build/version-seq.tsv",
            "slot\tversion\tclass\tstate\tnote\n1\t0.0.92\t事实表整理\t已公开\t冻结\n2\t0.0.93\t执行器内核产品化\t建议\t号跳过,不占号\n3\t0.0.94\t冷跑缓存类\t已公开\t冻结\n"
            "7\t0.0.98\t丁类\t已公开\t冻结\n8\t0.0.96\t乙类\t建议\t计划 plans/v0.0.96.md\n9\t0.0.95\t甲类\t建议\t计划 plans/v0.0.95.md\n"
            "10\t0.0.99\t戊类\t建议\t计划\n11\t0.0.97\t丙类\t建议\t计划 plans/v0.0.97.md\n"), "reorder-postpublish-next-is-first");
        rput(rd, "build/version-seq.tsv", seq);
        rc = rreorder(rd, "0.0.98\n...rest\n", "--write");
        ck(rc == 2 && has(out, tx_len(out, 200000), "REFUSE\toutside-domain\t0.0.98") && rfile_is(rd, "build/version-seq.tsv", seq), "reorder-postpublish-published-rc2");
        rc = rreorder(rd, "0.0.96\n0.0.95\n0.0.99\n0.0.97\n", "--write");
        ck(rc == 0 && has(out, tx_len(out, 200000), "write=1"), "reorder-postpublish-no-rest-all-listed");
        /* 中间状态:发布中算已定行,不可移动,域内行排在它之后 */
        const char *seqm = "slot\tversion\tclass\tstate\tnote\n"
            "1\t0.0.92\t事实表整理\t已公开\t冻结\n"
            "4\t0.0.95\t甲类\t建议\t计划\n"
            "5\t0.0.96\t乙类\t发布中\t起链\n"
            "6\t0.0.97\t丙类\t建议\t计划\n";
        rput(rd, "build/version-seq.tsv", seqm);
        rc = rreorder(rd, "0.0.96\n...rest\n", "--write");
        ck(rc == 2 && has(out, tx_len(out, 200000), "REFUSE\toutside-domain\t0.0.96") && rfile_is(rd, "build/version-seq.tsv", seqm), "reorder-intermediate-state-rc2");
        rc = rreorder(rd, "0.0.97\n...rest\n", "--write");
        ck(rc == 0 && has(out, tx_len(out, 200000), "REORDER_NEXT\t0.0.96\tsettled-in-between") && rfile_is(rd, "build/version-seq.tsv",
            "slot\tversion\tclass\tstate\tnote\n1\t0.0.92\t事实表整理\t已公开\t冻结\n5\t0.0.96\t乙类\t发布中\t起链\n6\t0.0.97\t丙类\t建议\t计划\n7\t0.0.95\t甲类\t建议\t计划\n"), "reorder-intermediate-state-stays");
        /* 并发:读后有人改表,写前重读比对不同则拒绝,不覆盖对方 */
        rput(rd, "build/version-seq.tsv", seq);
        rc = rreorder(rd, "0.0.96\n...rest\n", "--write --test-race");
        {   char want[2000]; cx_fmt(want, sizeof want, "%s#race\n", seq);
            ck(rc == 2 && has(out, tx_len(out, 200000), "REFUSE\tchanged-under-us") && rfile_is(rd, "build/version-seq.tsv", want), "reorder-concurrent-change-refused");
        }
    }

    sy_printf("CHECK_VERSEQ_GEN\tchecks=%d\tfailed=%d\n", checks, failed);
    return failed ? 1 : 0;
}
