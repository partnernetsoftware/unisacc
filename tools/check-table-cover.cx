/* tools/check-table-cover.cx -- tools/table-cover.cx against a synthetic exec/ fixture (never the real tree).
 *
 *   sh ./unisacc.com tools/check-table-cover.cx
 *
 * Fixture root in sy_tmpdir(): exec/facts/gen.tsv names tools/fx-gen.cx (which mentions --check) in its header;
 * exec/x/foo-result.tsv is named by tests/check-decide.cx; exec/y/bare.tsv has neither; the declaration table
 * holds one id row on the bare exec/ prefix; the list also names notexec/odd.txt (not an exec table).
 * Asserts: gen.tsv is facts with gen=fx-gen.cx gen_check=yes; foo-result.tsv is result with decide=yes and cover
 * direct; bare.tsv is other, no generator, no decide, cover coarse-only; odd.txt is UNMEASURED and the run
 * exits 0; summary total=4 unmeasured=1 empty=0 coarse_only=2.  Negative control, in the same run
 * (--alt-decls, one compile): an empty declaration table -> empty rises to 2 (gen.tsv and bare.tsv: no batch
 * can select them).
 * Prints PASS/FAIL per assertion and CHECK_TABLE_COVER pass=N fail=M; rc 0 only when fail=0. */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use text.text
#pragma unisa use text.fmt

static char out[1 << 16];
static char fx[1024];
static int pass_n, fail_n;

static void ok(int c, const char *what) { printf("%s\t%s\n", c ? "PASS" : "FAIL", what); if (c) pass_n++; else fail_n++; }
static int put(const char *rel, const char *s) {
    char p[2048], d[2048]; long n = tx_len(rel, 1024), k = n;
    tx_snprintf(p, sizeof p, "%s/%s", fx, rel);
    while (k > 0 && rel[k - 1] != '/') k--;
    if (k > 0) { tx_snprintf(d, sizeof d, "%s/%.*s", fx, (int)k, rel); sy_mkdir_all(d, 0755); }
    return sy_write_atomic(p, s, tx_len(s, 1 << 16), 0644);
}
static int run(const char *decls) {
    char *a[] = {"timeout", "55", "sh", "-c", "exec sh ./unisacc.com tools/table-cover.cx -- --root \"$1\" --list list.txt --decls \"$2\" --alt-decls empty.tsv",
                 "check-table-cover", fx, (char *)decls, 0};
    int cut = 0;
    out[0] = 0;
    return sy_run(a, out, sizeof out, &cut);
}
static int has(const char *want) { const char *at = strstr(out, want); return at ? 1 : 0; }

int main(void) {
    int rc;
    tx_snprintf(fx, sizeof fx, "%s/check-table-cover-%d", sy_tmpdir(), (int)getpid());
    if (put("exec/facts/gen.tsv", "# writer: tools/fx-gen.cx (inputs fx 0000)\nk\tv\na\t1\n")
        || put("tools/fx-gen.cx", "/* fx-gen -- --check ROOT | --write ROOT */\n")
        || put("exec/x/foo-result.tsv", "k\tv\n")
        || put("tests/check-decide.cx", "static char *r = \"exec/x/foo-result.tsv\";\n")
        || put("exec/y/bare.tsv", "k\tv\n")
        || put("decls.tsv", "kind\tkey\tinputs\tbasis\nid\tb1\texec/\tcoarse\n")
        || put("empty.tsv", "kind\tkey\tinputs\tbasis\n")
        || put("list.txt", "exec/facts/gen.tsv\nexec/x/foo-result.tsv\nexec/y/bare.tsv\nnotexec/odd.txt\n")) {
        fprintf(stderr, "check-table-cover: cannot write fixture under %s\n", fx); return 2;
    }
    rc = run("decls.tsv");
    ok(rc == 0, "run exits 0 with an UNMEASURED entry");
    ok(has("exec/facts/gen.tsv\tfacts\t0\tfx-gen.cx\tyes\t-\t"), "generated facts table: gen=fx-gen.cx gen_check=yes");
    ok(has("exec/x/foo-result.tsv\tresult\t0\t-\t-\tyes\t1\t1\t0\t1\tUNMEASURED\t-\tdirect\n"), "result table with decide rule: decide=yes cover=direct");
    ok(has("exec/y/bare.tsv\tother\t0\t-\t-\t-\t0\t0\t0\t1\tUNMEASURED\t-\tcoarse-only\n"), "uncovered table: coarse-only under bare exec/");
    ok(has("notexec/odd.txt\tUNMEASURED\t"), "unknown category reported UNMEASURED");
    ok(has("TABLE_COVER\ttotal=4\tfacts=1\tresult=1\tmanifest=0\tother=1\tunmeasured=1\t"), "summary counts per category");
    ok(has("\tempty=0\tcoarse_only=2\t"), "with declarations: empty=0 coarse_only=2");
    ok(has("TABLE_COVER_ALT\tdecls=empty.tsv\tempty=2\tcoarse_only=0\n"), "negative control: emptied declarations raise empty 0 -> 2");
    ok(has("EMPTY_ALT\texec/y/bare.tsv\n") && !has("EMPTY\texec/y/bare.tsv\n"), "negative control: bare.tsv EMPTY only without declarations");
    { char *rm[] = {"timeout", "20", "rm", "-rf", fx, 0}; sy_run(rm, out, sizeof out, 0); }   /* the fixture is this run's own */
    printf("CHECK_TABLE_COVER\tpass=%d\tfail=%d\n", pass_n, fail_n);
    return fail_n ? 1 : 0;
}
