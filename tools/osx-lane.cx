static int olq_emit(int status,const char *phase){printf("OSX_LANE_STEP\tstatus=%s\tphase=%s\texecuted=%d\tselected=%d\tstate=%s\n",status==0?"LOCAL_PASS":status==1?"FAIL":status==2?"UNKNOWN":"PENDING",phase,olq.cursor,nj,out);return status;}
static void olq_profiles(int phase){int idx=-1;for(int i=0;i<nm;i++)if(!strcmp(mats[i].name,"objects_osx"))idx=i;if(idx<0)return;int arch=(phase-2)/2,verify=(phase-2)%2;const char *names[]={"arm64","x86_64"},*profiles[]={"osx/arm64","osx/x86_64"};if(!verify&&!olq.auto_objects)return;char leaf[4400],tool[4400],label[100];ol_path(leaf,sizeof leaf,mats[idx].value,names[arch]);ol_path(tool,sizeof tool,root,"tools/object-material.cx");if(cx_fmt(label,sizeof label,"queue-%s-%s",verify?"verify":"prepare",names[arch]))ol_die("queue profile label");char *v[]={bound,"55","sh",product,tool,"--",verify?"--verify":"prepare",root,leaf,"--profile",(char *)profiles[arch],0};ol_required(label,v,57,1);}
static int olq_step(int argc,char **argv){if(argc!=4&&argc!=5)ol_die("usage --step ROOT STATE [MAP|-]");if(argv[2][0]!='/'||!realpath(argv[2],root)||strcmp(root,argv[2]))ol_die("canonical queue ROOT");ol_load();if(strncmp(tn_self(),"osx/",4))return olq_readonly?olq_verified(2):olq_emit(2,"host-requires-Darwin");if(!realpath(argv[0],selfexe))ol_die("queue executable path");if(unsetenv("UNISACC_TABLES"))ol_die("queue tables");deadline=sy_now_ms()+59000;ol_reserve=0;char parent[4400],physical[4096],leaf[4096],p[4400];if(argv[3][0]!='/'||cx_fmt(parent,sizeof parent,"%s",argv[3]))ol_die("queue absolute STATE");char *slash=strrchr(parent,'/');if(!slash||!slash[1]||!strcmp(slash+1,".")||!strcmp(slash+1,"..")||cx_fmt(leaf,sizeof leaf,"%s",slash+1))ol_die("queue state leaf");*slash=0;if(!realpath(parent,physical)||cx_fmt(out,sizeof out,"%s/%s",physical,leaf))ol_die("queue state parent");ol_path(p,sizeof p,root,"out");if(!realpath(p,physical)||!ol_within(out,physical))ol_die("queue state below ROOT/out");int fresh=!olq_exists(out);if(fresh&&olq_readonly)return olq_verified(2);if(fresh&&mkdir(out,0700))ol_die("queue create");int dirfd=open(out,O_RDONLY|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC);struct stat st;if(dirfd<0||fstat(dirfd,&st)||st.st_uid!=getuid()||(st.st_mode&0077)||sy_flock(dirfd,2|4))ol_die("queue private lock busy");ol_path(product,sizeof product,root,"unisacc.com");ol_path(bound,sizeof bound,root,"tools/bound");ol_path(runner,sizeof runner,root,"tests/run-batch.cx");ol_path(p,sizeof p,out,"bound-cache");if(setenv("BOUND_CACHE",p,1))ol_die("queue bound cache");char mapsha[65];if(argc==5&&strcmp(argv[4],"-"))olq_hash(argv[4],mapsha);else cx_sha256_hex("-",1,mapsha);
