/* Dynamic local macOS lane. inventory never executes; run is fresh, bounded, and never reuses verdicts. */
#pragma unisa use cxlib.allsession
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.testplan
#pragma unisa use sys.hostid
#pragma unisa use sys.time
#pragma unisa use mem.bytes
#pragma unisa use sys.fs
#define OL_MAX 2048
typedef struct {char *id,*impl,*platform,*materials,*expect,*tier;int present,completed;} OlJob;
typedef struct {char name[128],value[4096],before[65];int kind,supplied;} OlMaterial;
static OlJob *jobs;static int nj,nosx;static OlMaterial mats[128];static int nm;
static char root[4096],out[4096],product[4400],bound[4400],runner[4400],selfexe[4400],why[1700];static long deadline;static int ol_reserve=30;
static void (*ol_abort_cleanup)(void);
static void ol_die(const char *s){if(ol_abort_cleanup)ol_abort_cleanup();fprintf(stderr,"osx-lane: REFUSE %s\n",s);exit(2);}
static char *ol_dup(const char *s){size_t n=strlen(s);if(n>1048576)ol_die("field extent");char *p=malloc(n+1);if(!p||mm_copy(p,(long)n+1,s,(long)n+1))ol_die("field allocation/copy");return p;}
static int ol_hex(const char *s){if(!s||strlen(s)!=64)return 0;for(int i=0;i<64;i++)if(!((s[i]>='0'&&s[i]<='9')||(s[i]>='a'&&s[i]<='f')))return 0;return 1;}
static void ol_path(char *p,size_t cap,const char *a,const char *b){if(cx_fmt(p,cap,"%s/%s",a,b))ol_die("path bound");}
static int ol_within(const char *p,const char *base){size_t n=strlen(base);return !strncmp(p,base,n)&&p[n]=='/';}
static void ol_put(const char *name,const void *bytes,size_t n){char p[4400];ol_path(p,sizeof p,out,name);int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)ol_die("exclusive evidence file");int bad=sy_write_all(fd,bytes,(long)n);int closed=close(fd);if(bad||closed)ol_die("evidence write");}
static void ol_text(const char *name,const char *s){ol_put(name,s,strlen(s));}
static void ol_batch(const tp_batch_view *v,void *x){(void)x;int mac=!strncmp(v->platform,"osx/",4);if(!mac&&strcmp(v->id,"smoke"))return;if(nj==OL_MAX)ol_die("job capacity");OlJob *j=jobs+nj++;j->id=ol_dup(v->id);j->impl=ol_dup(v->implementation);j->platform=ol_dup(v->platform);j->materials=ol_dup(v->materials);j->expect=ol_dup(v->expect);j->tier=ol_dup(v->tier);j->present=v->source_present;nosx+=mac;}
static void ol_cov(const tp_coverage_view *v,void *x){(void)v;(void)x;}
static void ol_load(void){char p[4400];size_t rn,cn;ol_path(p,sizeof p,root,"tests/batches.tsv");char *r=as_read(p,0,&rn,why,sizeof why);if(!r)ol_die(why);ol_path(p,sizeof p,root,"tests/coverage.tsv");char *c=as_read(p,0,&cn,why,sizeof why);if(!c)ol_die(why);jobs=calloc(OL_MAX,sizeof *jobs);if(!jobs)ol_die("allocation");tp_summary s;tp_observer ob={ol_batch,ol_cov,0};int rc=tp_visit(root,r,rn,c,cn,&ob,&s,why,sizeof why);free(r);free(c);if(rc)ol_die(why);if(!nosx)ol_die("no osx platform rows");printf("OSX_INVENTORY\tmetadata_valid=1\tosx_rows=%d\tselected=%d\texecuted=0\tqualification=NOT_EXECUTED\n",nosx,nj);for(int i=0;i<nj;i++)printf("SELECT\t%s\timplementation=%s\tplatform=%s\tmaterials=%s\ttier=%s\n",jobs[i].id,jobs[i].impl,jobs[i].platform,jobs[i].materials,jobs[i].tier);}
typedef struct {np_result r;int tr;long ms;} OlExec;
static void ol_pending(const char *s){char result[800];if(cx_fmt(result,sizeof result,"OSX_LANE\tstatus=PENDING\treason=%s\tselected=%d\tqualification=NOT_QUALIFIED\n",s,nj))ol_die("pending bound");np_buf b={0};np_puts(&b,"id\tstatus\treason\n");for(int i=0;i<nj;i++)if(!jobs[i].completed){np_puts(&b,jobs[i].id);np_puts(&b,"\tPENDING\t");np_puts(&b,s);np_puts(&b,"\n");}ol_put("pending.tsv",b.p,b.n);free(b.p);ol_text("result.tsv",result);printf("%s",result);exit(3);}
static OlExec ol_exec(const char *label,char **v,int seconds){if(deadline-sy_now_ms()<(long)(seconds+ol_reserve)*1000)ol_pending("phase-budget-no-complete-child-window-and-final-measurement");OlExec e={0};why[0]=0;long t=sy_now_ms();e.tr=np_run(v,root,0,seconds,&e.r,why,sizeof why);e.ms=sy_now_ms()-t;char name[180],status[2400];if(cx_fmt(name,sizeof name,"%s.stdout",label))ol_die("log name");ol_put(name,e.r.out?e.r.out:"",e.r.outn);if(cx_fmt(name,sizeof name,"%s.stderr",label))ol_die("error name");ol_put(name,e.r.err?e.r.err:"",e.r.errn);if(cx_fmt(status,sizeof status,"elapsed_ms\t%ld\ntransport\t%d\nrc\t%d\nresidue\t%d\nreason\t%s\n",e.ms,e.tr,e.r.rc,e.r.residue,e.tr?why:"-"))ol_die("status bound");if(cx_fmt(name,sizeof name,"%s.status.tsv",label))ol_die("status name");ol_text(name,status);return e;}
static int ol_good(OlExec *e){return !e->tr&&!e->r.rc&&!e->r.residue;}
static void ol_required(const char *label,char **v,int seconds,int quiet){OlExec e=ol_exec(label,v,seconds);int ok=ol_good(&e)&&(!quiet||!e.r.errn);np_free(&e.r);if(!ok)ol_die("preparation/verification refused; transcript retained");}
static void ol_materials(void){for(int i=0;i<nj;i++){const char *p=jobs[i].materials;tp_material_decl d;int rc;while((rc=tp_material_next(&p,&d))>0){int k;for(k=0;k<nm;k++)if(!strcmp(mats[k].name,d.name))break;if(k==nm){if(nm==128)ol_die("material capacity");if(cx_fmt(mats[k].name,sizeof mats[k].name,"%s",d.name))ol_die("material name");mats[k].kind=d.kind;nm++;}else if(mats[k].kind!=d.kind)ol_die("material type conflict");}if(rc<0)ol_die("material declarations");}}
static void ol_map(const char *file){if(!file||!strcmp(file,"-"))return;size_t n;char *b=as_read(file,0,&n,why,sizeof why);if(!b)ol_die(why);if(n>1048576||!n||b[n-1]!='\n'||memchr(b,0,n)||memchr(b,'\r',n))ol_die("MAP wire");char *p=b;while(*p){char *e=strchr(p,'\n');if(!e)ol_die("MAP tail");*e=0;if(*p&&*p!='#'){char *tab=strchr(p,'\t');if(!tab||strchr(tab+1,'\t'))ol_die("MAP two fields");*tab++=0;int k;for(k=0;k<nm;k++)if(!strcmp(mats[k].name,p))break;if(k==nm||mats[k].supplied)ol_die("MAP unknown/duplicate name");if(!tp_material_value(mats[k].kind,tab)||cx_fmt(mats[k].value,sizeof mats[k].value,"%s",tab))ol_die("MAP typed value");if(mats[k].kind==1&&as_material_path(tab,why,sizeof why))ol_die(why);mats[k].supplied=1;}p=e+1;}free(b);}
static void ol_objects(OlMaterial *m){char base[4400],leaf[4400],tool[4400],label[100];int create=!m->supplied;if(create){ol_path(base,sizeof base,out,"materials");if(mkdir(base,0700))ol_die("materials directory");ol_path(m->value,sizeof m->value,base,"objects_osx");if(mkdir(m->value,0700))ol_die("objects parent");}ol_path(tool,sizeof tool,root,"tools/object-material.cx");const char *arch[]={"arm64","x86_64"},*profile[]={"osx/arm64","osx/x86_64"};for(int i=0;i<2;i++){ol_path(leaf,sizeof leaf,m->value,arch[i]);if(create){if(cx_fmt(label,sizeof label,"prepare-%s",arch[i]))ol_die("label");char *v[]={bound,"55","sh",product,tool,"--","prepare",root,leaf,"--profile",(char *)profile[i],0};ol_required(label,v,57,1);}if(cx_fmt(label,sizeof label,"verify-%s",arch[i]))ol_die("label");char *v[]={bound,"55","sh",product,tool,"--","--verify",root,leaf,"--profile",(char *)profile[i],0};ol_required(label,v,57,1);}m->supplied=1;}
static void ol_snapshot(const char *label,as_ident *id){char *v[]={bound,"25",selfexe,"--snapshot",root,0};OlExec e=ol_exec(label,v,27);int ok=ol_good(&e)&&!e.r.errn&&e.r.outn==sizeof *id;if(ok&&mm_copy(id,sizeof *id,e.r.out,(long)e.r.outn))ok=0;np_free(&e.r);if(!ok)ol_die("bounded complete identity measurement");}
static void ol_measure(const char *label,OlMaterial *m,char hash[65]){char kind[12];if(cx_fmt(kind,sizeof kind,"%d",m->kind))ol_die("kind");char *v[]={bound,"20",selfexe,"--material",kind,m->value,0};OlExec e=ol_exec(label,v,22);int ok=ol_good(&e)&&!e.r.errn&&e.r.outn==65&&e.r.out[64]=='\n';if(ok){if(mm_copy(hash,65,e.r.out,64))ok=0;hash[64]=0;if(!ol_hex(hash))ok=0;}np_free(&e.r);if(!ok)ol_die("bounded material content identity");}
static int ol_measure_child(const char *map){size_t n;char *b=as_read(map,0,&n,why,sizeof why);if(!b||!n||n>1048576||b[n-1]!='\n'||memchr(b,0,n)||memchr(b,'\r',n))ol_die("measurement map wire");for(char *p=b;*p;){char *e=strchr(p,'\n'),*t=strchr(p,'\t');if(!e||!t||t>=e)ol_die("measurement name");*t++=0;char *v=strchr(t,'\t');if(!v||v>=e||strchr(v+1,'\t')&&strchr(v+1,'\t')<e)ol_die("measurement fields");*v++=0;*e=0;int kind=!strcmp(t,"1")?1:!strcmp(t,"2")?2:0;char h[65];if(!kind||as_material_measure(kind,v,1,h,0,why,sizeof why))ol_die(why);printf("%s\t%s\n",p,h);p=e+1;}free(b);return 0;}
static void ol_guard(const char *label,int before){if(!nm)return;char map[4400];ol_path(map,sizeof map,out,"measurement-map.tsv");char *v[]={bound,"20",selfexe,"--materials",map,0};OlExec e=ol_exec(label,v,22);if(!ol_good(&e)||e.r.errn||!e.r.out)ol_die("group material measurement");char *p=e.r.out;for(int i=0;i<nm;i++){char *end=strchr(p,'\n'),*t=strchr(p,'\t');if(!end||!t||t>=end||end-t!=65)ol_die("material measurement row");*t++=0;*end=0;if(strcmp(p,mats[i].name)||!ol_hex(t))ol_die("material measurement identity");if(before){if(mm_copy(mats[i].before,65,t,65))ol_die("material hash copy");}else if(strcmp(mats[i].before,t))ol_die("material changed");p=end+1;}if(*p)ol_die("extra material measurement");np_free(&e.r);}
static int ol_job_pass(OlExec *e,OlJob *j,const char *candidate){if(!ol_good(e)||!e->r.out)return 0;char *p=strstr(e->r.out,"BATCH_RUN\tid=");char id[128],status[20],marker[100],sha[65];int rc,tr;if(!p||strstr(p+1,"BATCH_RUN\tid=")||sscanf(p,"BATCH_RUN\tid=%127s\tstatus=%19s\trc=%d\ttransport=%d\tmarker=%99s\tcandidate=%64s",id,status,&rc,&tr,marker,sha)!=6)return 0;return !strcmp(id,j->id)&&!strcmp(status,"PASS")&&!rc&&!tr&&!strncmp(j->expect,"rc0:",4)&&!strcmp(marker,j->expect+4)&&!strcmp(sha,candidate);}
typedef struct {pid_t pid;int ix,done,code,signal,residue,reaped;long began,ms;} OlChild;
static void ol_childenv(const char *tmp){size_t n=0;while(environ[n])n++;char **env=calloc(n+3,sizeof *env);if(!env)_exit(125);size_t z=0;for(size_t k=0;k<n;k++)if(strncmp(environ[k],"TMPDIR=",7)&&strncmp(environ[k],"BOUND_CACHE=",12)&&strncmp(environ[k],"UNISACC_TABLES=",15))env[z++]=environ[k];char a[4500],b[4500];if(cx_fmt(a,sizeof a,"TMPDIR=%s",tmp)||cx_fmt(b,sizeof b,"BOUND_CACHE=%s/bound-cache",out))_exit(125);env[z++]=ol_dup(a);env[z++]=ol_dup(b);env[z]=0;environ=env;}
static void ol_start(OlChild *c,int ix,const char *base){OlJob *j=jobs+ix;char tmp[4400],name[180],log[4400],err[4400];if(cx_fmt(name,sizeof name,"tmp-%s",j->id))ol_die("tmp label");ol_path(tmp,sizeof tmp,out,name);if(mkdir(tmp,0700))ol_die("job TMPDIR");if(cx_fmt(name,sizeof name,"job-%s.stdout",j->id))ol_die("log label");ol_path(log,sizeof log,out,name);if(cx_fmt(name,sizeof name,"job-%s.stderr",j->id))ol_die("error label");ol_path(err,sizeof err,out,name);int fo=open(log,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600),fe=open(err,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fo<0||fe<0)ol_die("exclusive worker logs");char *av[150],*bindings[128];int na=0,nb=0;av[na++]=bound;av[na++]="55";av[na++]="sh";av[na++]=product;av[na++]=runner;av[na++]="--";av[na++]=root;av[na++]=(char *)base;av[na++]=j->id;const char *cursor=j->materials;tp_material_decl d;while(tp_material_next(&cursor,&d)>0){int k;for(k=0;k<nm;k++)if(!strcmp(d.name,mats[k].name))break;if(k==nm||na>=148)ol_die("material binding capacity");char value[4400];if(cx_fmt(value,sizeof value,"%s=%s",d.name,mats[k].value))ol_die("binding bound");bindings[nb]=ol_dup(value);av[na++]=bindings[nb++];}av[na]=0;c->ix=ix;c->began=sy_now_ms();fflush(stdout);c->pid=fork();if(c->pid==0){ol_abort_cleanup=0;if(dup2(fo,1)<0||dup2(fe,2)<0||close(fo)||close(fe)||chdir(root))_exit(125);ol_childenv(tmp);execv(bound,av);_exit(127);}close(fo);close(fe);for(int k=0;k<nb;k++)free(bindings[k]);if(c->pid<0){c->done=1;c->code=125;c->residue=1;}}
static int ol_poll(OlChild *c){if(c->done)return 1;int st=0;pid_t got=waitpid(c->pid,&st,WNOHANG);if(got==0)return 0;if(got<0){if(errno==EINTR)return 0;c->done=1;c->code=125;c->residue=1;return 1;}c->done=1;c->reaped=1;c->ms=sy_now_ms()-c->began;if(WIFEXITED(st))c->code=WEXITSTATUS(st);else{c->code=128+WTERMSIG(st);c->signal=WTERMSIG(st);}return 1;}
static void ol_wave_wait(OlChild *children,int count){long until=sy_now_ms()+57000;int left=count;for(int tick=0;left&&tick<5700&&sy_now_ms()<until;tick++){left=0;for(int k=0;k<count;k++)if(!ol_poll(children+k))left++;if(left)usleep(10000);}if(left){for(int k=0;k<count;k++)if(!children[k].done){children[k].residue=1;kill(children[k].pid,SIGTERM);}long cleanup=sy_now_ms()+2000;for(int tick=0;left&&tick<200&&sy_now_ms()<cleanup;tick++){left=0;for(int k=0;k<count;k++)if(!ol_poll(children+k))left++;if(left)usleep(10000);}for(int k=0;k<count;k++)if(!children[k].done){kill(children[k].pid,SIGKILL);for(int attempt=0;attempt<100&&!children[k].done;attempt++){ol_poll(children+k);if(!children[k].done)usleep(1000);}children[k].done=1;children[k].code=137;children[k].ms=sy_now_ms()-children[k].began;children[k].residue=1;}}}
static OlChild *ol_active;static int ol_active_n;
static void ol_cancel_active(void){ol_abort_cleanup=0;for(int k=0;k<ol_active_n;k++)if(ol_active[k].pid>0&&!ol_active[k].done){ol_active[k].residue=1;kill(ol_active[k].pid,SIGTERM);}long end=sy_now_ms()+2000;for(int tick=0;tick<200&&sy_now_ms()<end;tick++){int left=0;for(int k=0;k<ol_active_n;k++)if(ol_active[k].pid>0&&!ol_poll(ol_active+k))left++;if(!left)return;usleep(10000);}for(int k=0;k<ol_active_n;k++)if(ol_active[k].pid>0&&!ol_active[k].done)kill(ol_active[k].pid,SIGKILL);for(int tick=0;tick<100;tick++){int left=0;for(int k=0;k<ol_active_n;k++)if(ol_active[k].pid>0&&!ol_poll(ol_active+k))left++;if(!left)return;usleep(1000);}}
static int ol_finish(OlChild *c,const char *candidate,np_buf *summary){OlJob *j=jobs+c->ix;OlExec e={0};e.r.rc=c->code;e.r.residue=c->residue;e.tr=c->signal?-1:0;e.ms=c->ms;char name[180],path[4400];size_t n=0;if(cx_fmt(name,sizeof name,"job-%s.stdout",j->id))ol_die("worker label");ol_path(path,sizeof path,out,name);e.r.out=cx_read(path,&n);e.r.outn=n;if(cx_fmt(name,sizeof name,"job-%s.stderr",j->id))ol_die("worker label");ol_path(path,sizeof path,out,name);e.r.err=cx_read(path,&n);e.r.errn=n;int ok=e.r.out&&e.r.err&&ol_job_pass(&e,j,candidate);const char *state=ok?"LOCAL_PASS":c->residue||c->signal||c->code==142||c->code==3?"UNKNOWN":"FAIL";char row[600],status[500];if(cx_fmt(row,sizeof row,"%s\t%s\t%d\t%d\t%d\t%ld\n",j->id,state,e.r.rc,e.tr,e.r.residue,e.ms))ol_die("worker verdict");if(cx_fmt(name,sizeof name,"job-%s.verdict.tsv",j->id))ol_die("worker verdict label");ol_text(name,row);if(cx_fmt(status,sizeof status,"pid\t%d\nreaped\t%d\nelapsed_ms\t%ld\ntransport\t%d\nrc\t%d\nresidue\t%d\n",(int)c->pid,c->reaped,e.ms,e.tr,e.r.rc,e.r.residue))ol_die("worker status");if(cx_fmt(name,sizeof name,"job-%s.status.tsv",j->id))ol_die("worker status label");ol_text(name,status);np_puts(summary,row);printf("JOB\t%s",row);j->completed=1;np_free(&e.r);return !ok;}
int main(int argc,char **argv){if(argc==3&&!strcmp(argv[1],"--materials"))return ol_measure_child(argv[2]);if(argc==3&&!strcmp(argv[1],"--snapshot")){as_ident id;if(!realpath(argv[2],root)||as_identity(root,1,&id,why,sizeof why))ol_die(why);return fwrite(&id,1,sizeof id,stdout)==sizeof id?0:2;}if(argc==4&&!strcmp(argv[1],"--material")){int kind=!strcmp(argv[2],"1")?1:!strcmp(argv[2],"2")?2:0;char hash[65];if(!kind||as_material_measure(kind,argv[3],1,hash,0,why,sizeof why))ol_die(why);puts(hash);return 0;}
if(argc<3||((strcmp(argv[1],"inventory")&&strcmp(argv[1],"--inventory"))&&strcmp(argv[1],"run")))ol_die("usage inventory ROOT | run ROOT NEW_ABS_OUT [MAP|-]");int running=!strcmp(argv[1],"run");if((!running&&argc!=3)||(running&&(argc<4||argc>5)))ol_die("argument count");if(argv[2][0]!='/'||!realpath(argv[2],root)||strcmp(root,argv[2]))ol_die("canonical ROOT");ol_load();if(!running)return 0;const char *host=tn_self();if(!host||strncmp(host,"osx/",4)){puts("OSX_LANE\tstatus=NOT_RUN\treason=requires-real-macOS-host");return 3;}if(!realpath(argv[0],selfexe))ol_die("live native executable identity");if(unsetenv("UNISACC_TABLES"))ol_die("fixed ROOT/tests registry");deadline=sy_now_ms()+290000;char parent[4400],canonical[4096],base[4400];if(argv[3][0]!='/'||cx_fmt(parent,sizeof parent,"%s",argv[3]))ol_die("absolute new OUT");char *slash=strrchr(parent,'/');if(!slash||!slash[1]||!strcmp(slash+1,".")||!strcmp(slash+1,".."))ol_die("OUT leaf");char leaf[4400];if(cx_fmt(leaf,sizeof leaf,"%s",slash+1))ol_die("leaf");*slash=0;if(!realpath(parent,canonical)||cx_fmt(out,sizeof out,"%s/%s",canonical,leaf))ol_die("OUT parent");ol_path(base,sizeof base,root,"out");if(!realpath(base,canonical)||!ol_within(out,canonical))ol_die("OUT below ROOT/out");if(mkdir(out,0700))ol_die("fresh exclusive OUT");np_buf selection={0};np_puts(&selection,"id\timplementation\tplatform\tmaterials\ttier\n");for(int i=0;i<nj;i++){char row[6000];if(cx_fmt(row,sizeof row,"%s\t%s\t%s\t%s\t%s\n",jobs[i].id,jobs[i].impl,jobs[i].platform,jobs[i].materials,jobs[i].tier))ol_die("selection bound");np_puts(&selection,row);}ol_put("selection.tsv",selection.p,selection.n);free(selection.p);ol_path(product,sizeof product,root,"unisacc.com");ol_path(bound,sizeof bound,root,"tools/bound");ol_path(runner,sizeof runner,root,"tests/run-batch.cx");ol_path(base,sizeof base,out,"bound-cache");if(setenv("BOUND_CACHE",base,1))ol_die("cache environment");char *helper[]={bound,"--helper",0};ol_required("bound-helper-PREPARED",helper,30,0);as_ident before,after;ol_snapshot("identity-before",&before);ol_materials();ol_map(argc==5?argv[4]:"-");for(int i=0;i<nm;i++){if(!strcmp(mats[i].name,"objects_osx")){if(mats[i].kind!=1)ol_die("objects_osx path type required");ol_objects(mats+i);}else if(!mats[i].supplied){printf("MATERIAL\t%s\tstatus=PENDING\treason=missing-explicit-binding\n",mats[i].name);ol_pending("missing-material");}}np_buf measurement={0};for(int i=0;i<nm;i++){char row[4400];if(cx_fmt(row,sizeof row,"%s\t%d\t%s\n",mats[i].name,mats[i].kind,mats[i].value))ol_die("measurement map bound");np_puts(&measurement,row);}ol_put("measurement-map.tsv",measurement.p,measurement.n);free(measurement.p);ol_guard("materials-before",1);
