olq_load();if(strcmp(olq.root,root)||strcmp(olq.map_sha,mapsha))ol_die("queue root or MAP changed");nm=olq.nmat;memcpy(mats,olq.material,sizeof mats);char exesha[65];olq_hash(selfexe,exesha);if(strcmp(exesha,olq.exe_sha))ol_die("queue controller changed");if(olq.failed<0||olq.failed>2||(olq.phase<7&&olq.cursor)||(olq.phase==9&&!olq.failed&&olq.cursor!=nj))ol_die("queue phase completeness");if(olq_readonly&&olq.phase!=9){close(dirfd);return olq_verified(2);}if(olq.phase>=2)olq_frozen();if(olq.phase==1){ol_snapshot("queue-identity-before",&olq.before);olq.phase=2;}
