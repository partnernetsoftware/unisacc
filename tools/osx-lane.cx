static np_buf olq_result(void){np_buf receipt={0};char row[600];np_puts(&receipt,"OSX_LANE_QUEUE\t1\n");if(cx_fmt(row,sizeof row,"status\t%s\nselected\t%d\nexecuted\t%d\nidentity_stable\t1\ncandidate\t%s\nsource_sid\t%s\nharness\t%s\nregistry\t%s\n",olq.failed==1?"FAIL":olq.failed?"UNKNOWN":"LOCAL_PASS",nj,olq.cursor,olq.before.candidate,olq.before.sid,olq.before.harness,olq.before.registry))ol_die("queue result bounds");np_puts(&receipt,row);for(int i=0;i<olq.cursor;i++){np_puts(&receipt,jobs[i].id);np_puts(&receipt,"\t");np_puts(&receipt,olq.receipt[i]);np_puts(&receipt,"\n");}if(olq.failed){if(olq.cursor<1)ol_die("queue failure without job");np_puts(&receipt,"fail_id\t");np_puts(&receipt,jobs[olq.cursor-1].id);np_puts(&receipt,"\n");}return receipt;}
static int olq_verified(int status){printf("OSX_LANE_QUEUE_VERIFY\tstatus=%s\treceipt_sha=%s\tcandidate=%s\tsource_sid=%s\tregistry=%s\tharness=%s\tselected=%d\texecuted=%d\n",status==0?"LOCAL_PASS":status==1?"FAIL":"UNKNOWN",ol_hex(olq.final_sha)?olq.final_sha:"-",ol_hex(olq.before.candidate)?olq.before.candidate:"-",ol_hex(olq.before.sid)?olq.before.sid:"-",ol_hex(olq.before.registry)?olq.before.registry:"-",ol_hex(olq.before.harness)?olq.before.harness:"-",nj,olq.cursor);return status;}
