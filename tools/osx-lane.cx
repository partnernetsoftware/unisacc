int main(int argc,char **argv){if(argc>=2&&!strcmp(argv[1],"--verify-queue")){olq_readonly=1;return olq_step(argc,argv);}if(argc>=2&&!strcmp(argv[1],"--step"))return olq_step(argc,argv);if(argc==3&&!strcmp(argv[1],"--materials"))return ol_measure_child(argv[2]);if(argc==3&&!strcmp(argv[1],"--snapshot")){as_ident id;if(!realpath(argv[2],root)||as_identity(root,1,&id,why,sizeof why))ol_die(why);return fwrite(&id,1,sizeof id,stdout)==sizeof id?0:2;}if(argc==4&&!strcmp(argv[1],"--material")){int kind=!strcmp(argv[2],"1")?1:!strcmp(argv[2],"2")?2:0;char hash[65];if(!kind||as_material_measure(kind,argv[3],1,hash,0,why,sizeof why))ol_die(why);puts(hash);return 0;}
if(argc<3||((strcmp(argv[1],"inventory")&&strcmp(argv[1],"--inventory"))&&strcmp(argv[1],"run")))ol_die("usage inventory ROOT | run ROOT NEW_ABS_OUT [MAP|-]");int running=!strcmp(argv[1],"run");if((!running&&argc!=3)||(running&&(argc<4||argc>5)))ol_die("argument count");if(argv[2][0]!='/'||!realpath(argv[2],root)||strcmp(root,argv[2]))ol_die("canonical ROOT");ol_load();if(!running)return 0;const char *host=tn_self();if(!host||strncmp(host,"osx/",4)){puts("OSX_LANE\tstatus=NOT_RUN\treason=requires-real-macOS-host");return 3;}if(!realpath(argv[0],selfexe))ol_die("live native executable identity");if(unsetenv("UNISACC_TABLES"))ol_die("fixed ROOT/tests registry");deadline=sy_now_ms()+290000;char parent[4400],canonical[4096],base[4400];if(argv[3][0]!='/'||cx_fmt(parent,sizeof parent,"%s",argv[3]))ol_die("absolute new OUT");char *slash=strrchr(parent,'/');if(!slash||!slash[1]||!strcmp(slash+1,".")||!strcmp(slash+1,".."))ol_die("OUT leaf");char leaf[4400];if(cx_fmt(leaf,sizeof leaf,"%s",slash+1))ol_die("leaf");*slash=0;if(!realpath(parent,canonical)||cx_fmt(out,sizeof out,"%s/%s",canonical,leaf))ol_die("OUT parent");ol_path(base,sizeof base,root,"out");if(!realpath(base,canonical)||!ol_within(out,canonical))ol_die("OUT below ROOT/out");if(mkdir(out,0700))ol_die("fresh exclusive OUT");np_buf selection={0};np_puts(&selection,"id\timplementation\tplatform\tmaterials\ttier\n");for(int i=0;i<nj;i++){char row[6000];if(cx_fmt(row,sizeof row,"%s\t%s\t%s\t%s\t%s\n",jobs[i].id,jobs[i].impl,jobs[i].platform,jobs[i].materials,jobs[i].tier))ol_die("selection bound");np_puts(&selection,row);}ol_put("selection.tsv",selection.p,selection.n);free(selection.p);ol_path(product,sizeof product,root,"unisacc.com");ol_path(bound,sizeof bound,root,"tools/bound");ol_path(runner,sizeof runner,root,"tests/run-batch.cx");ol_path(base,sizeof base,out,"bound-cache");if(setenv("BOUND_CACHE",base,1))ol_die("cache environment");char *helper[]={bound,"--helper",0};ol_required("bound-helper-PREPARED",helper,30,0);as_ident before,after;ol_snapshot("identity-before",&before);ol_materials();ol_map(argc==5?argv[4]:"-");for(int i=0;i<nm;i++){if(!strcmp(mats[i].name,"objects_osx")){if(mats[i].kind!=1)ol_die("objects_osx path type required");ol_objects(mats+i);}else if(!mats[i].supplied){printf("MATERIAL\t%s\tstatus=PENDING\treason=missing-explicit-binding\n",mats[i].name);ol_pending("missing-material");}}np_buf measurement={0};for(int i=0;i<nm;i++){char row[4400];if(cx_fmt(row,sizeof row,"%s\t%d\t%s\n",mats[i].name,mats[i].kind,mats[i].value))ol_die("measurement map bound");np_puts(&measurement,row);}ol_put("measurement-map.tsv",measurement.p,measurement.n);free(measurement.p);ol_guard("materials-before",1);
ol_path(base,sizeof base,out,"batches");if(mkdir(base,0700))ol_die("batch parent");np_buf summary={0};np_puts(&summary,"id\tstatus\trc\ttransport\tresidue\telapsed_ms\n");int failed=0,executed=0;ol_reserve=55;for(int at=0;at<nj;){if(deadline-sy_now_ms()<(long)(60+ol_reserve)*1000)ol_pending("phase-budget-no-complete-four-child-window-and-final-measurement");OlChild wave[4]={0};int count=0;ol_active=wave;ol_active_n=4;ol_abort_cleanup=ol_cancel_active;while(at<nj&&count<4){OlJob *j=jobs+at;if(strcmp(j->impl,"IMPLEMENTED")||!j->present){char line[300];if(cx_fmt(line,sizeof line,"%s\tPENDING\t-\t-\t-\t0\n",j->id))ol_die("row bound");np_puts(&summary,line);failed++;at++;continue;}ol_start(wave+count,at,base);count++;at++;}if(count){ol_wave_wait(wave,count);ol_abort_cleanup=0;for(int k=0;k<count;k++){executed++;failed+=ol_finish(wave+k,before.candidate,&summary);}}}ol_text("jobs.tsv",summary.p);free(summary.p);ol_reserve=5;ol_snapshot("identity-after",&after);const char *diff=as_ident_diff(&before,&after);if(diff){printf("IDENTITY\tstatus=CHANGED\tfield=%s\n",diff);failed++;}ol_guard("materials-after",0);if(sy_now_ms()>=deadline)ol_pending("phase-deadline");char final[600];if(cx_fmt(final,sizeof final,"OSX_LANE\tstatus=%s\tselected=%d\texecuted=%d\tfailed=%d\tcandidate=%s\tsource_sid=%s\tidentity_stable=%d\tqualification=LOCAL_ONLY\n",failed?"FAIL":"LOCAL_PASS",nj,executed,failed,before.candidate,before.sid,!diff))ol_die("final bound");ol_text("result.tsv",final);printf("%s",final);return failed?1:0;}
