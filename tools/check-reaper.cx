#pragma unisa use sysx.process
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.time
#pragma unisa use sys.env
#pragma unisa use text.text
#pragma unisa use text.fmt
/* Checks sysx.process: tree cleanup and np_run's monotonic bounded wait,
   including children that close both capture pipes before they exit.

     sh ./unisacc.com tools/check-reaper.cx

   The fixtures are real processes of this file, each a child of this process
   running in its own session:
     tree     root + two grandchildren, all sleeping;
     escape   root -> middle (exits at once) -> detached sleeper: after the
              middle is gone the sleeper is nobody's descendant, which is the
              case a process-group kill cannot see.
   Every fixture writes its pid into out/check-reaper-<pid>/ before it sleeps,
   so a FAIL can name what was left behind, and cleanup() kills everything it
   started on the success and the failure path alike.

   The run is capped with RLIMIT_NPROC at (this user's thread count + 1000)
   through prlimit, so a runaway fixture chain stops instead of filling the
   machine. Prints PASS/FAIL lines and CX_REAPER<TAB>ok=N<TAB>failed=N; exit 1
   on any FAIL. */

#define FX_MAX 16

static int nok, nfail;
static int all[FX_MAX], nall;
static char fxdir[256];

static void ok(int c, const char *name) {
    printf("%s\treaper.%s\n", c ? "PASS" : "FAIL", name);
    if (c) nok++; else nfail++;
}

static void remember(int pid) {
    if (pid > 0 && nall < FX_MAX) all[nall++] = pid;
}

static int alive(int pid) {
    return pid > 0 && sy_signal(pid, 0) == 0;
}

/* "<fxdir>/<name>.pid" into B; its length, or -1. */
static int pid_path(char *b, int cap, const char *name) {
    int n = tx_snprintf(b, cap, "%s/%s.pid", fxdir, name);
    return n > 0 && n < cap ? n : -1;
}

/* The first decimal in FILE, or -1 (missing, empty, not a number). */
static int read_pid(const char *path) {
    char b[64];
    sy_stat_t st;
    int fd, n, v = 0, any = 0, i;
    if (sy_stat(path, &st) != 0) return -1;
    fd = sy_open_read(path);
    if (fd < 0) return -1;
    n = (int)sy_read(fd, b, sizeof b);
    sy_close(fd);
    if (n <= 0) return -1;
    for (i = 0; i < n; i++) {
        if (b[i] >= '0' && b[i] <= '9') { v = v * 10 + (b[i] - '0'); any = 1; }
        else if (any) break;
    }
    return any ? v : -1;
}

static int write_pid(const char *name) {
    char p[512], b[32];
    int fd, n;
    if (pid_path(p, sizeof p, name) < 0) return 1;
    fd = sy_open_new(p, 0644);
    if (fd < 0) return 2;
    n = tx_snprintf(b, sizeof b, "%d\n", sy_pid());
    if (n <= 0 || sy_write_all(fd, b, n) != 0) { sy_close(fd); return 3; }
    return sy_close(fd) == 0 ? 0 : 4;
}

/* Wait until NAME's pid file holds a pid (bounded), that pid, or -1. */
static int await_pid(const char *name) {
    char p[512];
    int i, pid;
    if (pid_path(p, sizeof p, name) < 0) return -1;
    for (i = 0; i < 500; i++) {
        pid = read_pid(p);
        if (pid > 0) return pid;
        sy_sleep_ms(2);
    }
    return -1;
}

/* ---- fixture bodies (run in the child, after fork_session) --------------- */

static int sleeper(void *ud) {
    if (write_pid(ud) != 0) return 1;
    sy_sleep_ms(3000);
    return 0;
}

/* Writes its pid only after the middle of the escape chain has exited, so the
   file appearing means the reparenting already happened. */
static int late_sleeper(void *ud) {
    sy_sleep_ms(300);
    if (write_pid(ud) != 0) return 1;
    sy_sleep_ms(3000);
    return 0;
}

static int nest_root(void *ud) {
    int fds[2];
    (void)ud;
    if (sy_fork_session(sleeper, "g1", fds) <= 0) return 1;
    sy_close(fds[0]); sy_close(fds[1]);
    if (sy_fork_session(sleeper, "g2", fds) <= 0) return 2;
    sy_close(fds[0]); sy_close(fds[1]);
    if (write_pid("root") != 0) return 3;
    sy_sleep_ms(3000);
    return 0;
}

/* The middle of the escape chain: starts the detached sleeper and returns at
   once, so the sleeper loses its parent while it is still running. */
static int escape_mid(void *ud) {
    int fds[2];
    (void)ud;
    if (sy_fork_session(late_sleeper, "d", fds) <= 0) return 1;
    sy_close(fds[0]); sy_close(fds[1]);
    return 0;
}

static int escape_root(void *ud) {
    int fds[2];
    (void)ud;
    if (sy_fork_session(escape_mid, 0, fds) <= 0) return 1;
    sy_close(fds[0]); sy_close(fds[1]);
    if (write_pid("eroot") != 0) return 2;
    sy_sleep_ms(3000);
    return 0;
}

/* ---- the cap and the cleanup -------------------------------------------- */

/* RLIMIT_NPROC at this user's thread count + 1000 through prlimit: a fixture
   that spawned without a bound stops at ~1000 extra processes instead of
   filling the machine. The limit is per user, not per process: other work of
   the same user (parallel s9 batches, other windows) shares it, and a margin
   of 200 was consumed by that work during s9 waves (np_run pid=-1, 14 of 20
   assertions failed, 2026-11-13). Advisory: a host without prlimit prints NOTE. */
static void cap_nproc(void) {
    char cmd[512];
    char *av[] = { "sh", "-c", cmd, 0 };
    int fd, pid, n, i, done = 0;
    const int wait_bound_polls = 250;   /* x 20 ms: the prlimit helper gets 5 s, then it is killed */
    /* The kernel counts threads against RLIMIT_NPROC, so the budget is the
       user's thread count + 1000, not its process count. The status files
       are read through cat: a process that exits between the glob and the
       read made gawk stop fatally, the count came out empty and the cap
       became an absolute 1000, below the user's live thread count, so every
       spawn failed (np_run pid=-1) whenever other work churned processes.
       An empty count now skips the cap instead of applying a wrong one. */
    tx_snprintf(cmd, sizeof cmd,
                "n=$(cat /proc/[0-9]*/status 2>/dev/null | awk '/^Uid:/{u=$2} "
                "/^Threads:/{if(u=='$(id -u)')s+=$2} END{print s+0}'); "
                "[ \"$n\" -gt 0 ] && prlimit --pid %d --nproc=$((n + 1000)) && echo $((n + 1000))",
                sy_pid());
    pid = sy_spawn_pipe(av, 0, 0, &fd, 0);
    if (pid <= 0) { printf("NOTE\treaper\tprlimit unavailable\n"); return; }
    for (i = 0; i < wait_bound_polls; i++) {
        n = sy_wait(pid, 1);
        if (n != -EAGAIN) { done = 1; break; }
        sy_sleep_ms(20);
    }
    if (!done) { sy_close(fd); sy_kill(pid); printf("NOTE\treaper\tprlimit did not finish\n"); return; }
    {
        /* the helper has exited, so this read sees the whole output or EOF */
        char cap[32];
        long got = sy_read(fd, cap, (long)sizeof cap - 1);
        sy_close(fd);
        if (got <= 0) { printf("NOTE\treaper\tnproc not capped (no thread count)\n"); return; }
        cap[got] = 0;
        if (got > 0 && cap[got - 1] == '\n') cap[got - 1] = 0;
        printf("NOTE\treaper\tnproc capped at uid count + 1000 = %s\n", cap);
    }
}

/* Kill everything this check started, whichever path reached it. */
static void cleanup(void) {
    int i;
    for (i = 0; i < nall; i++) if (alive(all[i])) sy_kill(all[i]);
    nall = 0;
}

/* Same-ELF fixtures: no compiler, shell program or recursive check startup.
   Every sleeper exits after eight seconds even if timeout cleanup regresses. */
static int capture_sleeper(void *ud) {
    if (write_pid(ud) != 0) return 1;
    sy_sleep_ms(8000);
    return 0;
}

static int capture_child(const char *mode) {
    int fds[2], d;
    if (!strcmp(mode, "normal")) {
        sy_write_all(1, "capture-out\n", 12);
        sy_write_all(2, "capture-err\n", 12);
        return 0;
    }
    if (!strcmp(mode, "nonzero")) return 7;
    if (strcmp(mode, "closed")) return 2;
    if (write_pid("capture-root") != 0) return 3;
    if (sy_getpgid(0) != sy_pid()) return 4;
    if (write_pid("capture-group") != 0) return 5;
    d = sy_fork_session(capture_sleeper, "capture-detached", fds);
    if (d <= 0) return 6;
    sy_close(fds[0]); sy_close(fds[1]);
    if (await_pid("capture-detached") != d) return 8;
    sy_close(1); sy_close(2);
    sy_sleep_ms(8000);
    return 0;
}

static void check_capture(void) {
    char why[1024], p[512];
    char *av[] = { "/proc/self/exe", "--np-child", fxdir, "normal", 0 };
    np_result r;
    long start, elapsed;
    int rc, root, group, d;
    why[0] = 0;
    rc = np_run(av, 0, 0, 2, &r, why, sizeof why);
    ok(rc == 0 && r.rc == 0 && r.outn == 12 && r.errn == 12 &&
       !strcmp(r.out, "capture-out\n") && !strcmp(r.err, "capture-err\n") &&
       r.residue == 0, "np_run: captures stdout and stderr normally");
    np_free(&r);
    ok(!r.out && !r.err && !r.outn && !r.errn && !r.residue,
       "np_run: caller owns output and np_free clears it");
    av[3] = "nonzero";
    rc = np_run(av, 0, 0, 2, &r, why, sizeof why);
    ok(rc == 0 && r.rc == 7 && !r.outn && !r.errn,
       "np_run: nonzero child exit is a captured result, not a launch error");
    np_free(&r);
    av[3] = "closed";
    start = sy_now_ms();
    rc = np_run(av, 0, 0, 1, &r, why, sizeof why);
    elapsed = sy_now_ms() - start;
    pid_path(p, sizeof p, "capture-root"); root = read_pid(p); remember(root);
    pid_path(p, sizeof p, "capture-group"); group = read_pid(p);
    pid_path(p, sizeof p, "capture-detached"); d = read_pid(p); remember(d);
    printf("NOTE\treaper\tnp_run pid=%d pgid=%d detached=%d elapsed_ms=%ld budget_ms=3500\n",
           root, group, d, elapsed);
    ok(start >= 0 && elapsed >= 1000 && elapsed < 3500,
       "np_run: closed stdout/stderr still returns within the explicit timeout budget");
    ok(rc == -1 && strstr(why, "subprocess.TimeoutExpired:") == why &&
       r.residue == 0 &&
       !r.out && !r.err && !r.outn && !r.errn,
       "np_run: timeout preserves error text, residue and empty-output ownership");
    ok(root > 0 && group == root && d > 0 && !alive(root) && !alive(d) &&
       sy_killpg(group, 0) == -ESRCH && sy_killpg(d, 0) == -ESRCH,
       "np_run: real root PID, PGID and detached descendant leave no residue");
    np_free(&r);
    pid_path(p, sizeof p, "no-such-executable"); av[0] = p;
    rc = np_run(av, 0, 0, 2, &r, why, sizeof why);
    ok(rc == -1 && strstr(why, "FileNotFoundError:") == why && !r.out && !r.err,
       "np_run: exec failure remains a launch error");
    np_free(&r);
    av[0] = "/proc/self/exe";
    pid_path(p, sizeof p, "no-such-directory"); rc = np_run(av, p, 0, 2, &r, why, sizeof why);
    ok(rc == -1 && strstr(why, "FileNotFoundError:") == why && !r.out && !r.err,
       "np_run: cwd failure remains a launch error");
    np_free(&r);
}

int main(int argc, char **argv) {
    char rep[256];
    int root, g1, g2, keep_pid, eroot, d, res, dead, fds[2];
    if (argc == 4 && !strcmp(argv[1], "--np-child")) {
        tx_snprintf(fxdir, sizeof fxdir, "%s", argv[2]);
        return capture_child(argv[3]);
    }
    tx_snprintf(fxdir, sizeof fxdir, "%s/check-reaper-%d", sy_tmpdir(), sy_pid());
    {
        int mk = sy_mkdir(fxdir, 0755);
        if (mk != 0 && mk != -EEXIST) { printf("CX_REAPER\tok=0\tfailed=1\n"); return 1; }
    }
    cap_nproc();
    ok(sy_child_subreaper() == 0, "child_subreaper: this process adopts the orphans of a job");
    ok(sy_kill_tree(1, 500, 0, 0, rep, sizeof rep) == -EINVAL, "kill_tree: pid 1 is not a job root");

    /* A pid that already exited has no tree and nothing to prove. */
    {
        char *av[] = { "sh", "-c", "exit 0", 0 };
        const int reap_bound_polls = 250;   /* x 20 ms: an exit-0 child is reaped within 5 s or the fixture fails below */
        int w;
        dead = sy_spawn(av);
        for (w = 0; dead > 0 && w < reap_bound_polls; w++) {
            if (sy_wait(dead, 1) != -EAGAIN) break;
            sy_sleep_ms(20);
        }
    }
    ok(dead > 0 && sy_kill_tree(dead, 500, 0, 0, rep, sizeof rep) == 0, "kill_tree: a reaped root is 0 residue");

    /* tree: root, two grandchildren, plus an unrelated child the caller keeps */
    root = sy_fork_session(nest_root, 0, fds);
    remember(root);
    if (root > 0) { sy_close(fds[0]); sy_close(fds[1]); }
    g1 = await_pid("g1");
    g2 = await_pid("g2");
    {
        int rr = await_pid("root");
        if (root <= 0) root = rr;
    }
    ok(root > 0 && g1 > 0 && g2 > 0 && alive(root) && alive(g1) && alive(g2),
       "tree: root and two grandchildren are running");
    {
        const int keep_sleep_bound_s = 30;   /* the child lives at most this long even if cleanup() never ran */
        char secs[16];
        char *av[] = { "sleep", secs, 0 };
        tx_snprintf(secs, sizeof secs, "%d", keep_sleep_bound_s);
        keep_pid = sy_spawn(av);
    }
    remember(keep_pid);
    ok(alive(keep_pid), "tree: the unrelated child is running");
    rep[0] = 0;
    res = sy_kill_tree(root, 1500, &keep_pid, 1, rep, sizeof rep);
    ok(res == 0 && rep[0] == 0, "tree: kill_tree reports no residue");
    ok(!alive(root) && !alive(g1) && !alive(g2), "tree: root and both grandchildren are gone");
    ok(alive(keep_pid), "tree: the kept child survived the kill");

    /* escape: a sleeper that lost its parent before the kill */
    eroot = sy_fork_session(escape_root, 0, fds);
    remember(eroot);
    if (eroot > 0) { sy_close(fds[0]); sy_close(fds[1]); }
    {
        int rr = await_pid("eroot");
        if (eroot <= 0) eroot = rr;
    }
    d = await_pid("d");
    ok(eroot > 0 && d > 0 && alive(eroot) && alive(d), "escape: root and the detached sleeper are running");
    rep[0] = 0;
    res = sy_kill_tree(eroot, 1500, 0, 0, rep, sizeof rep);
    ok(!alive(eroot), "escape: the root is gone");
    ok(!alive(d), "escape: the detached sleeper is gone");
    ok(res == 0 && rep[0] == 0, "escape: kill_tree reports no residue");
    check_capture();
    cleanup();
    printf("CX_REAPER\tok=%d\tfailed=%d\n", nok, nfail);
    return nfail ? 1 : 0;
}
