#pragma unisa use sysx.process
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.time
#pragma unisa use sys.env
#pragma unisa use sysx.reaper
#pragma unisa use text.text
#pragma unisa use text.fmt
/* Checks sysx.process: tree cleanup and np_run's monotonic bounded wait,
   including children that close both capture pipes before they exit.

     sh ./unisacc.com tools/check-reaper.cx

   The fixtures are real processes of this file, each a child of this process
   running in its own session:
     tree     root + two grandchildren, all sleeping;
     escape   root -> middle (exits at once) -> detached sleeper: after the
              middle is gone the sleeper is nobody's descendant, which is the
              case a process-group kill cannot see.
   Every fixture writes its pid into sy_tmpdir()/check-reaper-<pid>/ before it sleeps,
   so a FAIL can name what was left behind, and cleanup() kills everything it
   started on the success and the failure path alike.

   The run is capped with RLIMIT_NPROC at (this user's thread count + 1000)
   through prlimit, so a runaway fixture chain stops instead of filling the
   machine. Prints PASS/FAIL lines and CX_REAPER<TAB>ok=N<TAB>failed=N; exit 1
   on any FAIL. */

#define FX_MAX 16

static int nok, nfail;
static int all[FX_MAX], nall;
static char fxdir[256];

static void ok(int c, const char *name) {
    printf("%s\treaper.%s\n", c ? "PASS" : "FAIL", name);
    if (c) nok++; else nfail++;
}

static void remember(int pid) {
    if (pid > 0 && nall < FX_MAX) all[nall++] = pid;
}

static int alive(int pid) {
    return pid > 0 && sy_signal(pid, 0) == 0;
}

/* alive and not a zombie: a killed process that its parent has not waited for yet is gone as a
   running thing (sy_signal(pid, 0) still succeeds on it).  Reaping a root belongs to the handle
   owner, never to the sweep (plans/proc-lifecycle.md rule 5), so "gone" means "not running". */
static int running(int pid) {
    char p[64], buf[256];
    FILE *f;
    char *rp;
    if (!alive(pid)) return 0;
    tx_snprintf(p, sizeof p, "/proc/%d/stat", pid);
    f = fopen(p, "r");
    if (!f) return 0;
    rp = fgets(buf, sizeof buf, f) ? strrchr(buf, ')') : 0;
    fclose(f);
    return rp && rp[1] == ' ' && rp[2] != 'Z' && rp[2] != 'X';
}

/* "<fxdir>/<name>.pid" into B; its length, or -1. */
static int pid_path(char *b, int cap, const char *name) {
    int n = tx_snprintf(b, cap, "%s/%s.pid", fxdir, name);
    return n > 0 && n < cap ? n : -1;
}

/* The first decimal in FILE, or -1 (missing, empty, not a number). */
static int read_pid(const char *path) {
    char b[64];
    sy_stat_t st;
    int fd, n, v = 0, any = 0, i;
    if (sy_stat(path, &st) != 0) return -1;
    fd = sy_open_read(path);
    if (fd < 0) return -1;
    n = (int)sy_read(fd, b, sizeof b);
    sy_close(fd);
    if (n <= 0) return -1;
    for (i = 0; i < n; i++) {
        if (b[i] >= '0' && b[i] <= '9') { v = v * 10 + (b[i] - '0'); any = 1; }
        else if (any) break;
    }
    return any ? v : -1;
}

static int write_pid(const char *name) {
    char p[512], b[32];
    int fd, n;
    if (pid_path(p, sizeof p, name) < 0) return 1;
    fd = sy_open_new(p, 0644);
    if (fd < 0) return 2;
    n = tx_snprintf(b, sizeof b, "%d\n", sy_pid());
    if (n <= 0 || sy_write_all(fd, b, n) != 0) { sy_close(fd); return 3; }
    return sy_close(fd) == 0 ? 0 : 4;
}

/* Wait until NAME's pid file holds a pid (bounded), that pid, or -1. */
static int await_pid(const char *name) {
    char p[512];
    int i, pid;
    if (pid_path(p, sizeof p, name) < 0) return -1;
    for (i = 0; i < 500; i++) {
        pid = read_pid(p);
        if (pid > 0) return pid;
        sy_sleep_ms(2);
    }
    return -1;
}

/* ---- fixture bodies (run in the child, after fork_session) --------------- */

static int sleeper(void *ud) {
    if (write_pid(ud) != 0) return 1;
    sy_sleep_ms(3000);
    return 0;
}

/* Writes its pid only after the middle of the escape chain has exited, so the
   file appearing means the reparenting already happened. */
static int late_sleeper(void *ud) {
    sy_sleep_ms(300);
    if (write_pid(ud) != 0) return 1;
    sy_sleep_ms(3000);
    return 0;
}

static int nest_root(void *ud) {
    int fds[2];
    (void)ud;
    if (sy_fork_session(sleeper, "g1", fds) <= 0) return 1;
    sy_close(fds[0]); sy_close(fds[1]);
    if (sy_fork_session(sleeper, "g2", fds) <= 0) return 2;
    sy_close(fds[0]); sy_close(fds[1]);
    if (write_pid("root") != 0) return 3;
    sy_sleep_ms(3000);
    return 0;
}

/* Orphan shape: the middle returns at once, so the sleeper loses its parent while running. */
static int orphan_mid(void *ud) {
    int fds[2];
    (void)ud;
    if (sy_fork_session(late_sleeper, "o", fds) <= 0) return 1;
    sy_close(fds[0]); sy_close(fds[1]);
    return 0;
}

static int orphan_root(void *ud) {
    int fds[2];
    (void)ud;
    if (sy_fork_session(orphan_mid, 0, fds) <= 0) return 1;
    sy_close(fds[0]); sy_close(fds[1]);
    if (write_pid("oroot") != 0) return 2;
    sy_sleep_ms(3000);
    return 0;
}

/* The middle of the escape chain: starts the sleeper in its own session (it left the process group),
   announces itself, and exits 150 ms later, so the sleeper loses its parent while it is still running.
   The fixture snapshots the tree while the middle is still alive; the sleeper writes its pid file only
   after the middle is gone (late_sleeper waits 300 ms). */
static int escape_mid(void *ud) {
    int fds[2];
    (void)ud;
    if (sy_fork_session(late_sleeper, "d", fds) <= 0) return 1;
    sy_close(fds[0]); sy_close(fds[1]);
    if (write_pid("mid") != 0) return 2;
    sy_sleep_ms(150);
    return 0;
}

static int escape_root(void *ud) {
    int fds[2];
    (void)ud;
    if (sy_fork_session(escape_mid, 0, fds) <= 0) return 1;
    sy_close(fds[0]); sy_close(fds[1]);
    if (write_pid("eroot") != 0) return 2;
    sy_sleep_ms(3000);
    return 0;
}

/* ---- the cap and the cleanup -------------------------------------------- */

/* RLIMIT_NPROC at this user's thread count + 1000 through prlimit: a fixture
   that spawned without a bound stops at ~1000 extra processes instead of
   filling the machine. The limit is per user, not per process: other work of
   the same user (parallel s9 batches, other windows) shares it, and a margin
   of 200 was consumed by that work during s9 waves (np_run pid=-1, 14 of 20
   assertions failed, 2026-11-13). Advisory: a host without prlimit prints NOTE. */
static void cap_nproc(void) {
    char cmd[512];
    char *av[] = { "sh", "-c", cmd, 0 };
    int fd, pid, n, i, done = 0;
    const int wait_bound_polls = 250;   /* x 20 ms: the prlimit helper gets 5 s, then it is killed */
    /* The kernel counts threads against RLIMIT_NPROC, so the budget is the
       user's thread count + 1000, not its process count. The status files
       are read through cat: a process that exits between the glob and the
       read made gawk stop fatally, the count came out empty and the cap
       became an absolute 1000, below the user's live thread count, so every
       spawn failed (np_run pid=-1) whenever other work churned processes.
       An empty count now skips the cap instead of applying a wrong one. */
    tx_snprintf(cmd, sizeof cmd,
                "n=$(cat /proc/[0-9]*/status 2>/dev/null | awk '/^Uid:/{u=$2} "
                "/^Threads:/{if(u=='$(id -u)')s+=$2} END{print s+0}'); "
                "[ \"$n\" -gt 0 ] && prlimit --pid %d --nproc=$((n + 1000)) && echo $((n + 1000))",
                sy_pid());
    pid = sy_spawn_pipe(av, 0, 0, &fd, 0);
    if (pid <= 0) { printf("NOTE\treaper\tprlimit unavailable\n"); return; }
    for (i = 0; i < wait_bound_polls; i++) {
        n = sy_wait(pid, 1);
        if (n != -EAGAIN) { done = 1; break; }
        sy_sleep_ms(20);
    }
    if (!done) { sy_close(fd); sy_kill(pid); printf("NOTE\treaper\tprlimit did not finish\n"); return; }
    {
        /* the helper has exited, so this read sees the whole output or EOF */
        char cap[32];
        long got = sy_read(fd, cap, (long)sizeof cap - 1);
        sy_close(fd);
        if (got <= 0) { printf("NOTE\treaper\tnproc not capped (no thread count)\n"); return; }
        cap[got] = 0;
        if (got > 0 && cap[got - 1] == '\n') cap[got - 1] = 0;
        printf("NOTE\treaper\tnproc capped at uid count + 1000 = %s\n", cap);
    }
}

/* Kill everything this check started, whichever path reached it. */
static void cleanup(void) {
    int i;
    for (i = 0; i < nall; i++) if (alive(all[i])) sy_kill(all[i]);
    nall = 0;
}

/* Same-ELF fixtures: no compiler, shell program or recursive check startup.
   Every sleeper exits after eight seconds even if timeout cleanup regresses. */
static int capture_sleeper(void *ud) {
    if (write_pid(ud) != 0) return 1;
    sy_sleep_ms(8000);
    return 0;
}

static int capture_child(const char *mode) {
    int fds[2], d;
    if (!strcmp(mode, "normal")) {
        sy_write_all(1, "capture-out\n", 12);
        sy_write_all(2, "capture-err\n", 12);
        return 0;
    }
    if (!strcmp(mode, "nonzero")) return 7;
    if (!strcmp(mode, "reaped-pipe")) {
        d = fork();
        if (d < 0) return 6;
        if (d == 0) _exit(capture_sleeper("capture-reaped-orphan"));
        return 0;
    }
    if (strcmp(mode, "closed")) return 2;
    if (write_pid("capture-root") != 0) return 3;
    if (sy_getpgid(0) != sy_pid()) return 4;
    if (write_pid("capture-group") != 0) return 5;
    d = sy_fork_session(capture_sleeper, "capture-detached", fds);
    if (d <= 0) return 6;
    sy_close(fds[0]); sy_close(fds[1]);
    if (await_pid("capture-detached") != d) return 8;
    sy_close(1); sy_close(2);
    sy_sleep_ms(8000);
    return 0;
}

static void check_capture(void) {
    char why[1024], p[512];
    char *av[] = { "/proc/self/exe", "--np-child", fxdir, "normal", 0 };
    np_result r;
    long start, elapsed;
    int rc, root, group, d;
    why[0] = 0;
    rc = np_run(av, 0, 0, 2, &r, why, sizeof why);
    ok(rc == 0 && r.rc == 0 && r.outn == 12 && r.errn == 12 &&
       !strcmp(r.out, "capture-out\n") && !strcmp(r.err, "capture-err\n") &&
       r.residue == 0, "np_run: captures stdout and stderr normally");
    np_free(&r);
    ok(!r.out && !r.err && !r.outn && !r.errn && !r.residue,
       "np_run: caller owns output and np_free clears it");
    av[3] = "nonzero";
    rc = np_run(av, 0, 0, 2, &r, why, sizeof why);
    ok(rc == 0 && r.rc == 7 && !r.outn && !r.errn,
       "np_run: nonzero child exit is a captured result, not a launch error");
    np_free(&r);
    av[3] = "closed";
    start = sy_now_ms();
    rc = np_run(av, 0, 0, 1, &r, why, sizeof why);
    elapsed = sy_now_ms() - start;
    pid_path(p, sizeof p, "capture-root"); root = read_pid(p); remember(root);
    pid_path(p, sizeof p, "capture-group"); group = read_pid(p);
    pid_path(p, sizeof p, "capture-detached"); d = read_pid(p); remember(d);
    printf("NOTE\treaper\tnp_run pid=%d pgid=%d detached=%d elapsed_ms=%ld budget_ms=3500\n",
           root, group, d, elapsed);
    ok(start >= 0 && elapsed >= 1000 && elapsed < 3500,
       "np_run: closed stdout/stderr still returns within the explicit timeout budget");
    ok(rc == -1 && strstr(why, "subprocess.TimeoutExpired:") == why &&
       r.residue == 0 &&
       !r.out && !r.err && !r.outn && !r.errn,
       "np_run: timeout preserves error text, residue and empty-output ownership");
    ok(root > 0 && group == root && d > 0 && !alive(root) && !alive(d) &&
       sy_killpg(group, 0) == -ESRCH && sy_killpg(d, 0) == -ESRCH,
       "np_run: real root PID, PGID and detached descendant leave no residue");
    np_free(&r);
    av[3] = "reaped-pipe";
    rc = np_run(av, 0, 0, 1, &r, why, sizeof why);
    pid_path(p, sizeof p, "capture-reaped-orphan");
    d = read_pid(p);
    /* old: the orphan was cleaned (residue 0, orphan gone).  new (0.0.96 commit 3): a reaped root signals
       nothing, so the orphan lives on and np_run reports cleanup unconfirmed. */
    ok(rc == -1 && r.timed_out && r.residue < 0 && d > 0 && alive(d),
       "np_run: an orphan holding stdout after wait reaps the root is not signalled and residue is negative");
    ok(strstr(why, "cleanup unconfirmed") != 0 && strstr(why, " survived)") == 0,
       "np_run: a reaped root reports cleanup unconfirmed, not a survivor list and not clean");
    if (alive(d)) remember(d);
    np_free(&r);
    pid_path(p, sizeof p, "no-such-executable"); av[0] = p;
    rc = np_run(av, 0, 0, 2, &r, why, sizeof why);
    ok(rc == -1 && strstr(why, "FileNotFoundError:") == why && !r.out && !r.err,
       "np_run: exec failure remains a launch error");
    np_free(&r);
    av[0] = "/proc/self/exe";
    pid_path(p, sizeof p, "no-such-directory"); rc = np_run(av, p, 0, 2, &r, why, sizeof why);
    ok(rc == -1 && strstr(why, "FileNotFoundError:") == why && !r.out && !r.err,
       "np_run: cwd failure remains a launch error");
    np_free(&r);
}

/* The orphan holds the output pipe after its root exits. The tree is snapshotted while the root is
   still unreaped (the root lives 100 ms after it forked the orphan), then the root is reaped and
   the reaped-root answer only reports (no signal at all).  In a private PID namespace, make the next child reuse the
   exact pid of the reaped root: the sentinel is not in the snapshot, so it is never touched.
   The ordinary batch supplies the sentinel's live pid at the same boundary. */
static int check_reaped_root(int exact) {
    int fds[2], root, orphan = 0, sentinel, st, w, res;
    char report[256];
    rp_snap_t snap;
    if (exact && sy_pid() != 1) return 2;
    if (rp_subreaper() || pipe(fds)) return 2;
    root = fork();
    if (root < 0) return 2;
    if (root == 0) {
        close(fds[0]);
        int child = fork();
        if (child == 0) {
            sy_sleep_ms(3000);
            _exit(0);
        }
        long wrote = write(fds[1], &child, sizeof child);
        sy_sleep_ms(100);
        _exit(wrote == sizeof child && child > 0 ? 0 : 1);
    }
    close(fds[1]);
    long got = read(fds[0], &orphan, sizeof orphan);
    if (got != sizeof orphan || orphan <= 1 || rp_snapshot(root, 0, 0, &snap) != 0) return 2;
    ok(snap.n == 1 && snap.e[0].pid == orphan, "reaped-root: the snapshot taken before the reap holds the orphan");
    if (waitpid(root, &st, 0) != root || st) return 2;
    if (exact) {
        char pid_text[32];
        int n = tx_snprintf(pid_text, sizeof pid_text, "%d\n", root - 1);
        int fd = sy_open("/proc/sys/kernel/ns_last_pid", O_WRONLY, 0);
        if (fd < 0) return 2;
        int rc = sy_write_all(fd, pid_text, n);
        sy_close(fd);
        if (rc) return 2;
    }
    sentinel = fork();
    if (sentinel < 0) return 2;
    if (sentinel == 0) {
        sy_setpgid(0, 0);
        sy_sleep_ms(3000);
        _exit(0);
    }
    sy_setpgid(sentinel, sentinel);
    if (exact) ok(sentinel == root, "reaped-root: replacement owns the reused pid");
    res = rp_kill_tree_snap(root, 1, &snap, 1000, 0, 0, report, sizeof report);
    sy_sleep_ms(100);   /* signals land asynchronously: observe after they would have */
    w = waitpid(sentinel, &st, WNOHANG | WUNTRACED);
    ok(w == 0, "reaped-root: replacement neither stopped nor killed");
    if (w == 0 || (w == sentinel && WIFSTOPPED(st))) {
        sy_kill(sentinel);
        (void)waitpid(sentinel, &st, 0);
    }
    w = waitpid(orphan, &st, WNOHANG);
    /* old: orphan gone and res == 0.  new: nothing is signalled after the reap, so the answer is
       negative and the snapshotted orphan is still running. */
    ok(res < 0 && w == 0, "reaped-root: the snapshotted orphan is not signalled and the answer is negative");
    ok(res != 0 && res != -ENOSYS, "reaped-root: never reported as clean");
    if (w == 0) {
        sy_kill(orphan);
        (void)waitpid(orphan, &st, 0);
    }
    sy_close(fds[0]);
    return 0;
}

/* Snapshot identity, no pid namespace needed.  After the reap NOTHING is signalled: a member whose
   starttime no longer matches (the shape of a reused pid; here the recorded value is shifted, the
   processes are real) and a member with its true starttime are both left running and both give a
   negative answer.  Before 0.0.96 commit 3 the second round killed the member and answered 0. */
static int check_snapshot_identity(void) {
    int round;
    for (round = 0; round < 2; round++) {
        int fds[2], root, member = 0, st, res, w;
        char report[256];
        rp_snap_t snap;
        if (pipe(fds)) return 2;
        root = fork();
        if (root < 0) return 2;
        if (root == 0) {
            close(fds[0]);
            sy_setpgid(0, 0);
            int c = fork();
            if (c == 0) { sy_sleep_ms(3000); _exit(0); }
            long wrote = write(fds[1], &c, sizeof c);
            sy_sleep_ms(100);
            _exit(wrote == sizeof c ? 0 : 1);
        }
        close(fds[1]);
        sy_setpgid(root, root);
        if (read(fds[0], &member, sizeof member) != sizeof member) return 2;
        close(fds[0]);
        if (rp_snapshot(root, 0, 0, &snap) != 0 || snap.n != 1) return 2;
        if (round == 0) snap.e[0].start += 1000;   /* the recorded identity is no longer the member's */
        if (waitpid(root, &st, 0) != root) return 2;
        res = rp_kill_tree_snap(root, 1, &snap, 1000, 0, 0, report, sizeof report);
        sy_sleep_ms(100);
        w = waitpid(member, &st, WNOHANG | WUNTRACED);
        if (round == 0)
            ok(w == 0 && res < 0, "snapshot-identity: a member whose starttime changed is not signalled and the answer is negative");
        else   /* old: true starttime -> killed and 0.  new: reaped root, no signal at all */
            ok(w == 0 && res < 0, "snapshot-identity: even a member with its true starttime is not signalled after the reap (answer negative)");
        if (w == 0) { sy_kill(member); (void)waitpid(member, &st, 0); }
    }
    return 0;
}

/* Gatekeeper a1, in a private PID namespace.  Root R (group leader) is snapshotted, exits and is
   reaped; its pid is then reused by an unrelated sibling X, which makes group R and forks a
   bystander Y into it, and exits.  The group number R names a live group again, but Y is not in the
   snapshot: it must be neither stopped nor killed, by the snapshot entry and by entry B alike. */
static int check_reaped_group_reuse(void) {
    int pf[2], Y = 0, X, R, st, w, res;
    char report[256], pid_text[32];
    rp_snap_t snap;
    int fd, n;
    if (sy_pid() != 1) return 2;
    if (rp_subreaper() || pipe(pf)) return 2;
    R = fork();
    if (R < 0) return 2;
    if (R == 0) { sy_setpgid(0, 0); sy_sleep_ms(100); _exit(0); }
    sy_setpgid(R, R);
    if (rp_snapshot(R, 0, 0, &snap) != 0) return 2;
    if (waitpid(R, &st, 0) != R) return 2;
    sy_sleep_ms(30);
    n = tx_snprintf(pid_text, sizeof pid_text, "%d\n", R - 1);
    fd = sy_open("/proc/sys/kernel/ns_last_pid", O_WRONLY, 0);
    if (fd < 0) return 2;
    if (sy_write_all(fd, pid_text, n) != 0) { sy_close(fd); return 2; }
    sy_close(fd);
    X = fork();
    if (X < 0) return 2;
    if (X == 0) {
        sy_setpgid(0, 0);
        int y = fork();
        if (y == 0) { close(pf[0]); close(pf[1]); sy_sleep_ms(3000); _exit(0); }
        write(pf[1], &y, sizeof y);
        _exit(0);
    }
    close(pf[1]);
    if (read(pf[0], &Y, sizeof Y) != sizeof Y) return 2;
    close(pf[0]);
    if (waitpid(X, &st, 0) != X) return 2;
    sy_sleep_ms(30);
    ok(X == R && Y > 1, "reaped-group-reuse: an unrelated sibling took the root pid and put a bystander into group R");
    res = rp_kill_tree_snap(R, 1, &snap, 1000, 0, 0, report, sizeof report);
    sy_sleep_ms(100);
    w = waitpid(Y, &st, WNOHANG | WUNTRACED);
    ok(w == 0, "reaped-group-reuse: snapshot entry leaves the bystander neither stopped nor killed");
    if (w == 0 || (w == Y && WIFSTOPPED(st))) { sy_kill(Y); (void)waitpid(Y, &st, 0); }
    ok(res < 0, "reaped-group-reuse: a reaped root answers negative (nothing signalled)");
    return 0;
}

/* Mutation (b) fixture: an orphan whose pid is reused by an unrelated process with a DIFFERENT
   starttime must not be signalled.  In a private PID namespace (unshare -U -r -p -f) the pid is
   reused deterministically via ns_last_pid.  Steps: fork orphan X (record baseline starttime),
   let it exit and reap it, point ns_last_pid at X-1, fork Y (same pid, later starttime), then call
   entry B with X's baseline: Y must stay alive (positive answer, never a clean 0).  With the
   starttime check removed (mutation b) Y is killed and this assertion turns red. */
static int check_pid_reuse_starttime(void) {
    int X, Y, st, w, res;
    long long base;
    char report[256], pid_text[32];
    int fd, n;
    if (sy_pid() != 1) return 2;
    if (rp_subreaper()) return 2;
    X = fork();
    if (X < 0) return 2;
    if (X == 0) { sy_setpgid(0, 0); _exit(0); }
    base = rp_root_start(X);
    if (waitpid(X, &st, 0) != X) return 2;
    if (base < 0) return 2;
    sy_sleep_ms(30);   /* past a jiffy so the reused pid gets a different starttime */
    n = tx_snprintf(pid_text, sizeof pid_text, "%d\n", X - 1);
    fd = sy_open("/proc/sys/kernel/ns_last_pid", O_WRONLY, 0);
    if (fd < 0) return 2;
    if (sy_write_all(fd, pid_text, n) != 0) { sy_close(fd); return 2; }
    sy_close(fd);
    Y = fork();
    if (Y < 0) return 2;
    if (Y == 0) { sy_setpgid(0, 0); sy_sleep_ms(3000); _exit(0); }
    sy_setpgid(Y, Y);
    ok(Y == X, "pid-reuse: the unrelated process reused the orphan's pid");
    ok(rp_root_start(Y) != base, "pid-reuse: the reused pid has a different starttime");
    /* entry B without a snapshot never signals anything once the root is reaped (the old baseline-only
       sweep matched any later child of ours, this one included) */
    res = rp_kill_tree_pid_after_wait(Y, 1, base, 500, 0, 0, report, sizeof report);
    sy_sleep_ms(100);
    w = waitpid(Y, &st, WNOHANG | WUNTRACED);
    ok(w == 0, "pid-reuse: the reused pid is neither stopped nor killed");
    if (w == 0 || (w == Y && WIFSTOPPED(st))) { sy_kill(Y); (void)waitpid(Y, &st, 0); }
    return 0;
}

/* Mutation (b) fixture: pid reuse at the identity check.  A real, live process Y is handed to the
   disposal half (rp_dispose_list is product code) with a starttime that is NOT Y's -- exactly the
   shape of a pid reused after the root was reaped.  Disposal counts survivors and mismatches:
   - wrong baseline: Y must be counted as a MISMATCH (packed >> 16 == 1) and NOT a survivor
     (packed & 0xffff == 0), because a pid whose starttime changed is not the process we saw;
   - correct baseline (control): the same Y with its OWN starttime must be counted as a SURVIVOR
     (packed & 0xffff == 1), proving the check looks at the real starttime.
   Mutation (b) deletes the starttime comparison: the wrong-baseline case then counts Y as a
   survivor and the first assertion turns red.  No mock: the only artificial part is the baseline. */
static int check_identity_mismatch(void) {
    int Y, st, w, packed;
    sy_kt_ent e[1];
    char rep[256];
    long long real_start;
    Y = fork();
    if (Y < 0) return 2;
    if (Y == 0) { sy_setpgid(0, 0); sy_sleep_ms(2500); _exit(0); }
    sy_setpgid(Y, Y);
    real_start = rp_root_start(Y);
    if (real_start < 0) { sy_kill(Y); (void)waitpid(Y, &st, 0); return 2; }
    e[0].pid = Y;
    e[0].start = real_start + 1000;              /* reused-pid shape: wrong baseline */
    packed = rp_dispose_list(e, 1, rep, sizeof rep, 0);
    ok((packed & 0xffff) == 0, "identity-mismatch: a reused-pid shape is not a survivor");
    ok((packed >> 16) == 1, "identity-mismatch: counted as a mismatch");
    e[0].start = real_start;                     /* control: the true baseline sees a survivor */
    packed = rp_dispose_list(e, 1, rep, sizeof rep, 0);
    ok((packed & 0xffff) == 1, "identity-mismatch: the true starttime counts as a survivor (control)");
    /* The packed seam (survivors low 16 bits, mismatches above) must compose: two entries, one a
       real live process with its true starttime (a survivor) and one with a wrong baseline (a
       mismatch), give BOTH axes non-zero at once.  This is what proves the packing does not
       confuse the two, before the outward three-state folds mismatches to a negative. */
    {
        int A2, B2, st2, w2, packed2;
        sy_kt_ent pair[2];
        char rep2[256];
        long long sa, sb;
        A2 = fork(); if (A2 == 0) { sy_setpgid(0, 0); sy_sleep_ms(2000); _exit(0); }
        B2 = fork(); if (B2 == 0) { sy_setpgid(0, 0); sy_sleep_ms(2000); _exit(0); }
        if (A2 > 0) sy_setpgid(A2, A2);
        if (B2 > 0) sy_setpgid(B2, B2);
        sa = rp_root_start(A2); sb = rp_root_start(B2);
        pair[0].pid = A2; pair[0].start = sa;          /* survivor */
        pair[1].pid = B2; pair[1].start = sb + 1000;   /* mismatch */
        packed2 = rp_dispose_list(pair, 2, rep2, sizeof rep2, 0);
        ok((packed2 & 0xffff) == 1, "pack-seam: low axis counts the one survivor");
        ok((packed2 >> 16) == 1, "pack-seam: high axis counts the one mismatch");
        w2 = waitpid(A2, &st2, WNOHANG);
        ok(w2 == 0, "pack-seam: the survivor is still alive");
        if (w2 == 0) { sy_kill(A2); (void)waitpid(A2, &st2, 0); }
        w2 = waitpid(B2, &st2, WNOHANG);
        ok(w2 == 0, "pack-seam: the mismatch is not signalled either");
        if (w2 == 0) { sy_kill(B2); (void)waitpid(B2, &st2, 0); }
    }
    w = waitpid(Y, &st, WNOHANG);
    ok(w == 0, "identity-mismatch: disposal never signals the process");
    if (w == 0 || w == Y) { sy_kill(Y); (void)waitpid(Y, &st, 0); }
    return 0;
}
int main(int argc, char **argv) {
    char rep[256];
    int root, g1, g2, keep_pid, eroot, d, res, dead, fds[2];
    if (argc == 2 && !strcmp(argv[1], "--identity-mismatch")) {
        int rc = check_identity_mismatch();
        printf("CX_REAPER_IDMISMATCH\tok=%d\tfailed=%d\trc=%d\n", nok, nfail, rc);
        return rc ? rc : nfail != 0;
    }
    if (argc == 2 && !strcmp(argv[1], "--pid-reuse")) {
        int rc = check_pid_reuse_starttime();
        printf("CX_REAPER_PIDREUSE\tok=%d\tfailed=%d\trc=%d\n", nok, nfail, rc);
        return rc ? rc : nfail != 0;
    }
    /* Not redundant: this mode needs a private PID namespace (unshare -U -r -p -f --mount-proc) so the
       replacement child gets the EXACT pid of the reaped root. It guards the "no signal by pid number"
       property. It does NOT guard the starttime recheck: with that recheck removed it stays green; that
       property is held by the snapshot-identity fixture in the ordinary batch. */
    if (argc == 2 && !strcmp(argv[1], "--reaped-root-pidns")) {
        int rc = check_reaped_root(1);
        if (!rc) rc = check_reaped_group_reuse();
        printf("CX_REAPER_PIDNS\tok=%d\tfailed=%d\trc=%d\n", nok, nfail, rc);
        return rc ? rc : nfail != 0;
    }
    if (argc == 4 && !strcmp(argv[1], "--np-child")) {
        tx_snprintf(fxdir, sizeof fxdir, "%s", argv[2]);
        return capture_child(argv[3]);
    }
    tx_snprintf(fxdir, sizeof fxdir, "%s/check-reaper-%d", sy_tmpdir(), sy_pid());
    {
        int mk = sy_mkdir(fxdir, 0755);
        if (mk != 0 && mk != -EEXIST) { printf("CX_REAPER\tok=0\tfailed=1\n"); return 1; }
    }
    cap_nproc();
    ok(sy_child_subreaper() == 0, "child_subreaper: this process adopts the orphans of a job");
    ok(check_reaped_root(0) == 0, "reaped-root: fixture completed");
    ok(check_snapshot_identity() == 0, "snapshot-identity: fixture completed");
    ok(sy_kill_tree(1, 500, 0, 0, rep, sizeof rep) == -EINVAL, "kill_tree: pid 1 is not a job root");

    /* A pid that already exited has no tree and nothing to prove. */
    {
        char *av[] = { "sh", "-c", "exit 0", 0 };
        const int reap_bound_polls = 250;   /* x 20 ms: an exit-0 child is reaped within 5 s or the fixture fails below */
        int w;
        dead = sy_spawn(av);
        for (w = 0; dead > 0 && w < reap_bound_polls; w++) {
            if (sy_wait(dead, 1) != -EAGAIN) break;
            sy_sleep_ms(20);
        }
    }
    /* B (was: == 0).  A bare pid entry (C) that is already reaped carries no pre-reap starttime, so it
       cannot tell this root's orphans from anything else: the answer is -EIO, never a clean 0.  The old
       0 was a false clean (gatekeeper fixture f1: orphan alive, answer 0). */
    ok(dead > 0 && sy_kill_tree(dead, 500, 0, 0, rep, sizeof rep) == -EIO, "kill_tree: a reaped root without a baseline is -EIO, never clean");

    /* tree: root, two grandchildren, plus an unrelated child the caller keeps */
    root = sy_fork_session(nest_root, 0, fds);
    remember(root);
    if (root > 0) { sy_close(fds[0]); sy_close(fds[1]); }
    g1 = await_pid("g1");
    g2 = await_pid("g2");
    {
        int rr = await_pid("root");
        if (root <= 0) root = rr;
    }
    ok(root > 0 && g1 > 0 && g2 > 0 && alive(root) && alive(g1) && alive(g2),
       "tree: root and two grandchildren are running");
    {
        const int keep_sleep_bound_s = 30;   /* the child lives at most this long even if cleanup() never ran */
        char secs[16];
        char *av[] = { "sleep", secs, 0 };
        tx_snprintf(secs, sizeof secs, "%d", keep_sleep_bound_s);
        keep_pid = sy_spawn(av);
    }
    remember(keep_pid);
    ok(alive(keep_pid), "tree: the unrelated child is running");
    rep[0] = 0;
    res = sy_kill_tree(root, 1500, &keep_pid, 1, rep, sizeof rep);
    ok(res == 0 && rep[0] == 0, "tree: kill_tree reports no residue");
    ok(!running(root) && !running(g1) && !running(g2), "tree: root and both grandchildren are gone");
    ok(alive(keep_pid), "tree: the kept child survived the kill");

    /* escape: a sleeper that lost its parent before the kill (snapshot taken while its parent lived) */
    eroot = sy_fork_session(escape_root, 0, fds);
    remember(eroot);
    if (eroot > 0) { sy_close(fds[0]); sy_close(fds[1]); }
    {
        int rr = await_pid("eroot");
        if (eroot <= 0) eroot = rr;
    }
    {
        rp_snap_t esnap;
        int mid = await_pid("mid");
        ok(mid > 0 && rp_snapshot(eroot, 0, 0, &esnap) == 0 && esnap.n >= 2, "escape: the snapshot, taken while the middle lives, holds the middle and the sleeper");
        d = await_pid("d");
        ok(eroot > 0 && d > 0 && alive(eroot) && alive(d), "escape: root and the detached sleeper are running");
        rep[0] = 0;
        res = rp_kill_tree_snap(eroot, 0, &esnap, 1500, 0, 0, rep, sizeof rep);
    }
    ok(!running(eroot), "escape: the root is gone");
    ok(!running(d), "escape: the detached sleeper is gone");
    ok(res == 0 && rep[0] == 0, "escape: kill_tree reports no residue");
    /* C (new): the orphan shape -- the sleeper's parent exits before the kill.  The sleeper is a child
       of ours that started after the root, exactly like an unrelated sibling forked later, so it is not
       provably the root's: it is never signalled and the answer is negative, not 0 (gkfx f3/f3b). */
    {   int oroot, o, ores, ofds[2];
        oroot = sy_fork_session(orphan_root, 0, ofds);
        remember(oroot);
        if (oroot > 0) { sy_close(ofds[0]); sy_close(ofds[1]); }
        { int rr = await_pid("oroot"); if (oroot <= 0) oroot = rr; }
        o = await_pid("o");
        remember(o);
        ok(oroot > 0 && o > 0 && running(oroot) && running(o), "orphan: root and the orphaned sleeper are running");
        rep[0] = 0;
        ores = sy_kill_tree(oroot, 1500, 0, 0, rep, sizeof rep);
        ok(!running(oroot), "orphan: the root is gone");
        ok(ores < 0, "orphan: an orphan that is not provably the root's makes the answer negative, never 0");
        ok(running(o), "orphan: the unprovable sleeper was not signalled");
    }
    /* Three-state answers (plans/proc-lifecycle.md rule 7), one assertion per negative class that
       is reachable on Linux without root:
       - EIO: entry B with REAPED=1 and no pre-reap starttime baseline (-1) cannot tell a reused
         pid from the real orphan, so it must be a negative, never 0;
       - EINVAL: pid 1 is not a job root (already asserted above for sy_kill_tree; repeated for
         the two new entries so each is covered);
       the -ENOSYS (off Linux / no /proc) branch is not reachable on this host and stays
       UNMEASURED here, named in the tool's header notes. */
    {
        int r1 = rp_kill_tree_pid_after_wait(sy_pid(), 1, -1, 200, 0, 0, rep, sizeof rep);
        ok(r1 == -EIO, "three-state: entry B without a starttime baseline is -EIO, not 0");
        ok(rp_kill_tree_pid_after_wait(1, 1, 0, 200, 0, 0, rep, sizeof rep) == -EINVAL,
           "three-state: entry B rejects pid 1");
        ok(rp_kill_tree_pid(1, 200, 0, 0, rep, sizeof rep) == -EINVAL,
           "three-state: entry C rejects pid 1");
    }
    check_capture();
    cleanup();
    printf("CX_REAPER\tok=%d\tfailed=%d\n", nok, nfail);
    return nfail ? 1 : 0;
}
