#pragma unisa use sys.io
#pragma unisa use text.text
/* Project exec/pipeline/image-stages.tsv (stage + input format) and
   exec/tapecheck/shape.tsv (tape opcodes) onto one generated module,
   cx/compiler/streamshape.cx.
   sh ./unisacc.com tools/streamshape-gen.cx -- --check
   sh ./unisacc.com tools/streamshape-gen.cx -- --write
   The fact tables are the only sources. image-stages.tsv names each stage's
   input format; shape.tsv names every tape.text opcode (a '#' header or
   comment line and a '=' record line are not opcodes; the tab-separated
   operand-kind column is not part of the name).
   The generated module only names values; accept/reject stays in src/streamshape.cx.
   No libc and no include. */
#define STAGES "exec/pipeline/image-stages.tsv"
#define SHAPE "exec/tapecheck/shape.tsv"
#define OUT "cx/compiler/streamshape.cx"
#define NSTAGE 7
#define NOP 128
#define NAMEMAX 32
#define BODY 32768

static char stages[NSTAGE][NAMEMAX];
static char formats[NSTAGE][NAMEMAX];
static char ops[NOP][NAMEMAX];
static int nstages;
static int nops;

static int fail(const char *why) {
    sy_eprintf("streamshape-gen\tFAIL\t%s\n", why);
    return 1;
}

static int app(char *dst, int cap, int *n, const char *s) {
    int i;
    if (!s) return -1;
    i = 0;
    while (s[i]) {
        if (*n + 1 >= cap) return -1;
        dst[*n] = s[i];
        *n = *n + 1;
        i = i + 1;
    }
    dst[*n] = 0;
    return 0;
}

static int appn(char *dst, int cap, int *n, int v) {
    char t[24];
    int k;
    int i;
    k = 0;
    if (v == 0) t[k++] = '0';
    while (v > 0 && k < 22) { t[k] = (char)('0' + v % 10); k = k + 1; v = v / 10; }
    for (i = k - 1; i >= 0; i--) {
        if (*n + 1 >= cap) return -1;
        dst[*n] = t[i];
        *n = *n + 1;
    }
    dst[*n] = 0;
    return 0;
}

static int copy_name(char *dst, const char *s, int n) {
    int i;
    if (n <= 0 || n >= NAMEMAX) return -1;
    for (i = 0; i < n; i++) {
        if (s[i] == '\t' || s[i] == '\n' || s[i] == '\r' || s[i] == ' ') return -1;
        dst[i] = s[i];
    }
    dst[n] = 0;
    return 0;
}

static int same_bytes(const char *a, size_t an, const char *b, int bn) {
    int i;
    if (an != (size_t)bn) return 0;
    for (i = 0; i < bn; i++) if (a[i] != b[i]) return 0;
    return 1;
}

/* image-stages.tsv: "# stage\tinput format\t..." header, then seven rows. */
static int parse_stages(const char *b, size_t nb) {
    size_t i;
    int saw;
    i = 0;
    saw = 0;
    while (i < nb) {
        size_t e;
        size_t t;
        e = i;
        while (e < nb && b[e] != '\n') e++;
        if (e > i) {
            if (!saw) {
                if (e - i < 7 || !tx_prefixz(b + i, "# stage", 7)) return fail("stages-header");
                saw = 1;
            } else if (b[i] != '#') {
                size_t f;
                t = i;
                while (t < e && b[t] != '\t') t++;
                if (t >= e) return fail("stages-row");
                if (nstages >= NSTAGE) return fail("stages-count");
                if (copy_name(stages[nstages], b + i, (int)(t - i))) return fail("stages-name");
                f = t + 1;
                t = f;
                while (t < e && b[t] != '\t') t++;
                if (t >= e) return fail("stages-format");
                if (copy_name(formats[nstages], b + f, (int)(t - f))) return fail("stages-format");
                nstages = nstages + 1;
            }
        }
        i = e + 1;
    }
    if (!saw) return fail("stages-header");
    if (nstages != NSTAGE) return fail("stages-count");
    return 0;
}

/* shape.tsv: "# opcode\toperand kinds ..." then "opcode\tkinds" rows. */
static int parse_shape(const char *b, size_t nb) {
    size_t i;
    int saw;
    i = 0;
    saw = 0;
    while (i < nb) {
        size_t e;
        size_t t;
        e = i;
        while (e < nb && b[e] != '\n') e++;
        if (e > i) {
            if (!saw) {
                if (e - i < 8 || !tx_prefixz(b + i, "# opcode", 8)) return fail("shape-header");
                saw = 1;
            } else if (b[i] != '#' && b[i] != '=') {
                t = i;
                while (t < e && b[t] != '\t') t++;
                if (t >= e) return fail("shape-row");
                if (nops >= NOP) return fail("shape-count");
                if (copy_name(ops[nops], b + i, (int)(t - i))) return fail("shape-op");
                nops = nops + 1;
            }
        }
        i = e + 1;
    }
    if (!saw) return fail("shape-header");
    if (nops <= 0) return fail("shape-count");
    return 0;
}

static int emit(char *dst, int cap) {
    int n;
    int i;
    n = 0;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa module streamshape\n")) return -1;
    if (app(dst, cap, &n, "/* Generated by tools/streamshape-gen.cx from exec/pipeline/image-stages.tsv\n")) return -1;
    if (app(dst, cap, &n, "   and exec/tapecheck/shape.tsv. Do not edit by hand.\n")) return -1;
    if (app(dst, cap, &n, "   The tables name stages, their input formats, and tape opcodes;\n")) return -1;
    if (app(dst, cap, &n, "   accept/reject lives in src/streamshape.cx.\n")) return -1;
    if (app(dst, cap, &n, "   A null out-pointer returns 4. An index outside 0..count-1 returns 2. */\n")) return -1;
    if (app(dst, cap, &n, "int sfs_stage_count(void) {\n    return ")) return -1;
    if (appn(dst, cap, &n, nstages)) return -1;
    if (app(dst, cap, &n, ";\n}\nint sfs_stage_at(int index, const char **stage, const char **format) {\n")) return -1;
    if (app(dst, cap, &n, "    if (!stage || !format) return 4;\n")) return -1;
    for (i = 0; i < nstages; i++) {
        if (app(dst, cap, &n, "    if (index == ")) return -1;
        if (appn(dst, cap, &n, i)) return -1;
        if (app(dst, cap, &n, ") { *stage = \"")) return -1;
        if (app(dst, cap, &n, stages[i])) return -1;
        if (app(dst, cap, &n, "\"; *format = \"")) return -1;
        if (app(dst, cap, &n, formats[i])) return -1;
        if (app(dst, cap, &n, "\"; return 0; }\n")) return -1;
    }
    if (app(dst, cap, &n, "    return 2;\n}\n")) return -1;
    if (app(dst, cap, &n, "int sfs_op_count(void) {\n    return ")) return -1;
    if (appn(dst, cap, &n, nops)) return -1;
    if (app(dst, cap, &n, ";\n}\nint sfs_op_at(int index, const char **op) {\n")) return -1;
    if (app(dst, cap, &n, "    if (!op) return 4;\n")) return -1;
    for (i = 0; i < nops; i++) {
        if (app(dst, cap, &n, "    if (index == ")) return -1;
        if (appn(dst, cap, &n, i)) return -1;
        if (app(dst, cap, &n, ") { *op = \"")) return -1;
        if (app(dst, cap, &n, ops[i])) return -1;
        if (app(dst, cap, &n, "\"; return 0; }\n")) return -1;
    }
    if (app(dst, cap, &n, "    return 2;\n}\n")) return -1;
    return n;
}

int main(int argc, char **argv) {
    char body[BODY];
    size_t sn;
    size_t pn;
    char *b;
    char *s;
    size_t on;
    char *cur;
    int bn;
    int dowrite;
    if (argc != 2 || (!tx_eqz(argv[1], "--check") && !tx_eqz(argv[1], "--write"))) {
        sy_eprintf("streamshape-gen\tusage\t--check|--write\n");
        return 2;
    }
    dowrite = tx_eqz(argv[1], "--write");
    b = cx_read(STAGES, &sn);
    if (!b) return fail("stages-read");
    if (parse_stages(b, sn)) return 1;
    s = cx_read(SHAPE, &pn);
    if (!s) return fail("shape-read");
    if (parse_shape(s, pn)) return 1;
    bn = emit(body, BODY);
    if (bn < 0) return fail("emit");
    if (dowrite) {
        if (cx_write(OUT, body, (size_t)bn)) return fail("write");
    } else {
        cur = cx_read(OUT, &on);
        if (!cur) return fail(OUT);
        if (!same_bytes(cur, on, body, bn)) return fail(OUT);
    }
    if (dowrite) sy_printf("STREAMSHAPE_GEN\tWROTE\tstages=%d\tops=%d\n", nstages, nops);
    else sy_printf("STREAMSHAPE_GEN\tCHECK\tstages=%d\tops=%d\n", nstages, nops);
    return 0;
}
