/* Checks the owner normalization shared by the freeze gate and devsvc. */
#pragma unisa use dv.ownernorm
#pragma unisa use cxlib.ckassert

int main(void) {
    char out[64], limit[65];
    ck(norm_owner("Cc", out, sizeof out) && !strcmp(out, "cc"), "owner-lowercase");
    ck(norm_owner(" \t\r\n Cdx \n\t", out, sizeof out) && !strcmp(out, "cdx"), "owner-trim");
    ck(!norm_owner(0, out, sizeof out) && !norm_owner(" \t\r\n", out, sizeof out), "owner-missing");
    ck(!norm_owner("cc ops", out, sizeof out), "owner-inner-space-refused");
    ck(!norm_owner("c\001c", out, sizeof out) && !norm_owner("c\177c", out, sizeof out), "owner-control-refused");
    ck(norm_owner("CC-42.OPS", out, sizeof out) && !strcmp(out, "cc-42.ops"), "owner-punctuation-kept");
    memset(limit, 'A', 64);
    limit[63] = 0;
    ck(norm_owner(limit, out, sizeof out) && strlen(out) == 63 && out[62] == 'a', "owner-63-accepted");
    limit[63] = 'A';
    limit[64] = 0;
    ck(!norm_owner(limit, out, sizeof out) && !norm_owner("cc", out, 2), "owner-length-refused");
    printf("CHECK_OWNERNORM\tpassed=%d\tfailed=%d\n", ck_assertions() - ck_failures(), ck_failures());
    return ck_failures() != 0;
}
