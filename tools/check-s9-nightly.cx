/* tools/check-s9-nightly.cx -- 假 s9 验证编排顺序、超时与失败停止。 */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.die
#pragma unisa use cxlib.s9map
#pragma unisa use cxlib.testplan
#pragma unisa use cxlib.toolprep
static int has(const char *s, const char *p) {
    size_t n, pl, i;
    if (!s) return 0;
    n = strlen(s); pl = strlen(p);
    for (i = 0; pl && i + pl <= n; i++) if (!memcmp(s + i, p, pl)) return 1;
    return 0;
}

static int has_line(const char *s,const char *want){
 if(!s)return 0;size_t wn=strlen(want);while(*s){const char *e=strchr(s,'\n');if(!e)return 0;if((size_t)(e-s)==wn&&!memcmp(s,want,wn))return 1;s=e+1;}return 0;
}

static int failed;
static char root[4096], why[512], report_path[4400];
static void die(const char *s) { tool_die("check-s9-nightly", s, 0, 2); }
static void ck(int ok, const char *n) {
    printf("%s\tcheck-s9-nightly.%s\n", ok ? "PASS" : "FAIL", n);
    if (!ok) failed++;
}
static void run_result(char **v,const char *cwd,int sec,np_result *r) {
    char *native[64],**call=v;
    const char *image=sy_env("S9_NIGHTLY_NATIVE"),*source=sy_env("UNISACC_S9_NIGHTLY_SOURCE");
    if(image&&*image&&source&&v[0]&&v[1]&&v[2]&&v[3]&&!strcmp(v[0],"sh")&&!strcmp(v[2],source)&&!strcmp(v[3],"--")) {
        int k=1;native[0]=(char *)image;
        for(int i=4;v[i];i++){if(k==63)die("native-argv");native[k++]=v[i];}
        native[k]=0;call=native;
    }
    if(np_run(call,cwd,0,sec,r,why,sizeof why))die(why);
}
static int runv(char **v, const char *cwd, int sec, char *out, int cap, int *rc) {
    np_result r = {0};run_result(v,cwd,sec,&r);
    *rc = r.rc;
    if (out && cap > 0) {
        size_t n = r.outn < (size_t)(cap - 1) ? r.outn : (size_t)(cap - 1);
        if (r.out && n && mm_copy(out, cap, r.out, (long)n)) die("copy");
        out[n] = 0;
    }
    np_free(&r);
    return 0;
}
/* Check the actual executable against both same-RUN producer seals. The
 * consumer additionally verifies the full current input identity before SKIP. */
static int material_native_sha(const char *run,const char *leaf,char hash[65]){
    char p[5000],prefix[4800];struct stat a,b;size_t n,rn,dn;char *image,*receipt,*done;int ok;
    if(cx_fmt(p,sizeof p,"%s.nightly-init/%s.bin",run,leaf)||lstat(p,&a)||!S_ISREG(a.st_mode)||!(a.st_mode&0111)||a.st_size<=0||a.st_size>16777216)return 0;
    image=cx_read(p,&n);if(!image)return 0;
    ok=n==(size_t)a.st_size&&!lstat(p,&b)&&S_ISREG(b.st_mode)&&a.st_dev==b.st_dev&&a.st_ino==b.st_ino&&a.st_size==b.st_size;
    if(!ok){free(image);return 0;}cx_sha256_hex(image,n,hash);free(image);
    if(cx_fmt(p,sizeof p,"%s.nightly-init/%s.native",run,leaf)||lstat(p,&a)||!S_ISREG(a.st_mode)||a.st_size<=0||a.st_size>16384)return 0;
    receipt=cx_read(p,&rn);if(!receipt)return 0;
    if(cx_fmt(p,sizeof p,"%s.nightly-init/%s.done",run,leaf)||lstat(p,&a)||!S_ISREG(a.st_mode)||a.st_size<=0||a.st_size>16384){free(receipt);return 0;}
    done=cx_read(p,&dn);if(!done){free(receipt);return 0;}
    if(cx_fmt(prefix,sizeof prefix,"S9NATIVE-v2\t%s\t",run)){free(receipt);free(done);return 0;}
    size_t k=strlen(prefix);ok=rn==k+130&&dn==rn&&!memcmp(receipt,done,rn)&&!memcmp(receipt,prefix,k)&&receipt[k+64]=='\t'&&receipt[rn-1]=='\n'&&!memcmp(receipt+k+65,hash,64);
    if(ok)for(int i=0;i<64;i++){char c=receipt[k+(size_t)i];if(!((c>='0'&&c<='9')||(c>='a'&&c<='f')))ok=0;}
    free(receipt);free(done);return ok;
}

/* 模式: core(顺序/失败停止/档位) | tiers(daily/release 档透传) | limits(max-steps/日期/截断/出口/UNKNOWN) | resume | resume(--resume 4 项);无参两者都跑。各自一个批次,合并在 affected 冷编下超 55s。 */
static tp_material_decl map_kinds[256];static int map_nk;
static void map_kind_batch(const tp_batch_view *v,void *context){
    (void)context;const char *at=v->materials;tp_material_decl d;int rc;
    while((rc=tp_material_next(&at,&d))>0){int found=0;for(int i=0;i<map_nk;i++)if(!strcmp(map_kinds[i].name,d.name)){if(map_kinds[i].kind!=d.kind)die("map-kind-conflict");found=1;break;}if(!found){if(map_nk==256)die("map-kind-capacity");map_kinds[map_nk++]=d;}}
    if(rc<0)die("map-kind-declaration");
}
static void map_kind_coverage(const tp_coverage_view *v,void *context){(void)v;(void)context;}
static void map_kind_load(void){
    char p[4400];size_t rn,cn;if(cx_fmt(p,sizeof p,"%s/tests/batches.tsv",root))die("map-kind-path");char *registry=cx_read(p,&rn);if(cx_fmt(p,sizeof p,"%s/tests/coverage.tsv",root))die("map-kind-path");char *coverage=cx_read(p,&cn);
    if(!registry||!coverage)die("map-kind-read");tp_summary sum;tp_observer observer={map_kind_batch,map_kind_coverage,0};map_nk=0;int rc=tp_visit(root,registry,rn,coverage,cn,&observer,&sum,why,sizeof why);free(registry);free(coverage);if(rc)die(why);
}
/* Transport shape alone cannot turn a declared path into a SHA256 literal. */
static int map_declared_row(const char *s,long n){
    long tab=-1;for(long i=0;i<n;i++){if(s[i]=='\t'){if(tab>=0)return 0;tab=i;}else if(s[i]=='\r'||s[i]=='\n'||!s[i])return 0;}if(tab<=0||tab+1>=n)return 0;
    int kind=0;for(int i=0;i<map_nk;i++)if(strlen(map_kinds[i].name)==(size_t)tab&&!memcmp(s,map_kinds[i].name,(size_t)tab)){kind=map_kinds[i].kind;break;}
    if(kind==1)return s[tab+1]=='/'?1:0;if(kind!=2||n-tab-1!=64)return 0;
    for(long i=tab+1;i<n;i++)if(!((s[i]>='0'&&s[i]<='9')||(s[i]>='a'&&s[i]<='f')))return 0;return 2;
}
static void map_kind_controls(void){
    const char *path_name=0,*sha_name=0;for(int i=0;i<map_nk;i++){if(map_kinds[i].kind==1&&!path_name)path_name=map_kinds[i].name;if(map_kinds[i].kind==2&&!sha_name)sha_name=map_kinds[i].name;}if(!path_name||!sha_name)die("map-kind-control-requires-both-types");
    char row[512],h[65];cx_sha256_hex("map-kind-control",16,h);
    cx_fmt(row,sizeof row,"%s\t/tmp/map-kind-control",path_name);ck(map_declared_row(row,(long)strlen(row))==1,"map-declared-path-absolute-accepted");
    cx_fmt(row,sizeof row,"%s\trelative",path_name);ck(!map_declared_row(row,(long)strlen(row)),"map-declared-path-relative-refused");
    cx_fmt(row,sizeof row,"%s\t%s",path_name,h);ck(!map_declared_row(row,(long)strlen(row)),"map-declared-path-sha-substitution-refused");
    cx_fmt(row,sizeof row,"%s\t%s",sha_name,h);ck(map_declared_row(row,(long)strlen(row))==2,"map-declared-sha-lowercase64-accepted");
    row[strlen(sha_name)+1]='A';ck(!map_declared_row(row,(long)strlen(row)),"map-declared-sha-uppercase-refused");
    cx_fmt(row,sizeof row,"%s\t%s",sha_name,h);row[strlen(row)-1]=0;ck(!map_declared_row(row,(long)strlen(row)),"map-declared-sha-truncation-refused");
    cx_fmt(row,sizeof row,"%s\t/tmp/map-kind-control",sha_name);ck(!map_declared_row(row,(long)strlen(row)),"map-declared-sha-path-substitution-refused");
    const char *unknown="unregistered-map-kind-control\t/tmp/value";ck(!map_declared_row(unknown,(long)strlen(unknown)),"map-undeclared-name-refused");
}
static const char *material_cases="all",*given_nightly,*given_shards,*given_waves,*given_dir,*given_affected;
static int material_want(const char *name){return !strcmp(material_cases,"all")||!strcmp(material_cases,name);}
static int material_file_sha(const char *p,char h[65]){struct stat st;size_t n;if(lstat(p,&st)||!S_ISREG(st.st_mode)||!(st.st_mode&0111)||st.st_size<=0||st.st_size>16777216)return 0;char *s=cx_read(p,&n);if(!s)return 0;int ok=n==(size_t)st.st_size;if(ok)cx_sha256_hex(s,n,h);free(s);return ok;}
static const char *phase_cases="all";
static int phase_want(const char *name){return !strcmp(phase_cases,"all")||!strcmp(phase_cases,name);}
int main(int argc, char **argv) {
    {int w=1;for(int r=1;r<argc;r++){const char **slot=0;if(!strcmp(argv[r],"--nightly"))slot=&given_nightly;else if(!strcmp(argv[r],"--shards"))slot=&given_shards;else if(!strcmp(argv[r],"--waves"))slot=&given_waves;else if(!strcmp(argv[r],"--material-dir"))slot=&given_dir;else if(!strcmp(argv[r],"--affected"))slot=&given_affected;if(slot){if(r+1==argc||argv[r+1][0]!='/')die("REFUSED material argument requires absolute path");*slot=argv[++r];}else argv[w++]=argv[r];}argc=w;argv[w]=0;}
    if(argc==2&&!strcmp(argv[1],"ri")){
        char cwd[4096],tool[4400],image[4400],dir[]="/tmp/s9-ri-check-XXXXXX";np_result r={0};
        if(!realpath(".",cwd)||!mkdtemp(dir)||cx_fmt(tool,sizeof tool,"%s/tools/s9-nightly.cx",cwd)||cx_fmt(image,sizeof image,"%s/nightly",dir)||tq_native(cwd,tool,image,why,sizeof why))die(why);
        char *v[]={image,"--ri-controls",0};if(np_run(v,cwd,0,15,&r,why,sizeof why))die(why);
        if(r.outn)fwrite(r.out,1,r.outn,stdout);if(r.errn)fwrite(r.err,1,r.errn,stderr);
        ck(r.rc==0&&!r.residue&&has(r.out,"RI_CONTROLS\tfailed=0"),"ri-multiphase-controls");const char *blocked_names[]={"blocked-no-declaration-requires-data-stage","blocked-explicit-declaration-keeps-runtime-seal-required","blocked-canonical-refusal-dump-not-material","blocked-dump-matches-declaration","blocked-declaration-with-actual-map-refused","blocked-seal-excludes-data-map-keeps-real-family","blocked-refusal-without-declaration-refused","blocked-removing-declaration-restores-map-REFUSE","blocked-with-produced-material-refused","blocked-missing-runtime-seal-still-refused","blocked-NUL-cannot-hide-undeclared-refusal","blocked-CR-wire-refused"};
 for(int i=0;i<12;i++){char line[256];if(cx_fmt(line,sizeof line,"MAP_CONTROL\t%s\tchecked=1",blocked_names[i]))die("blocked-label-bound");ck(has_line(r.out,line),blocked_names[i]);}
 np_free(&r);
        printf("CHECK_S9_NIGHTLY\tfailed=%d\n",failed);return failed?1:0;
    }
    char *defaults[]={argv[0],"phases",0};
    if(argc==3&&!strcmp(argv[1],"--cases")){phase_cases=argv[2];argv=defaults;argc=2;}
    else if(argc==4&&!strcmp(argv[2],"--cases")){if(!strcmp(argv[1],"materials"))material_cases=argv[3];else if(!strcmp(argv[1],"phases"))phase_cases=argv[3];else die("--cases requires phases|materials");argc=2;}
    if(strcmp(material_cases,"all")&&strcmp(material_cases,"map")&&strcmp(material_cases,"prepare")&&strcmp(material_cases,"negative"))die("materials --cases all|map|prepare|negative");
    if(strcmp(material_cases,"all")&&strcmp(material_cases,"map")&&(!given_nightly||!given_shards||!given_waves))die("REFUSED prepared nightly/shards/waves materials required");
    if(strcmp(phase_cases,"all")&&strcmp(phase_cases,"init")&&strcmp(phase_cases,"steps")&&strcmp(phase_cases,"aggregate")&&strcmp(phase_cases,"aggout")&&strcmp(phase_cases,"failures")&&strcmp(phase_cases,"candidate"))die("phases --cases all|init|steps|aggregate|aggout|failures|candidate");
    const char *am = argc == 2 ? argv[1] : "";
    int core = !*am || !strcmp(am, "core"), tiers = !*am || !strcmp(am, "tiers"), lim = !*am || !strcmp(am, "limits"), res = !*am || !strcmp(am, "resume"), ph = !*am || !strcmp(am, "phases"), mat = !*am || !strcmp(am, "materials");
    int split = !*am || !strcmp(am,"split");
    int recovery = !strcmp(am,"recovery");
    int mapcheck = !*am || !strcmp(am,"map");
    if (argc > 2 || (argc == 2 && !core && !tiers && !lim && !res && !ph && !mat && !split && !recovery && !mapcheck)) { fprintf(stderr, "usage: [core|materials|tiers|limits|resume|phases|split|recovery|map]\n"); return 2; }
    char dir[4400], fake[4400], runp[4400], outd[4400], tool[4400], com[4400], logp[4400], src[4400], buf[4000];
    char *v[16];
    int rc;
    if (sy_realpath(".", root, sizeof root) < 0) die("cwd");
    if (cx_fmt(dir, sizeof dir, "%s/s9n-XXXXXX", sy_tmpdir()) || !mkdtemp(dir)) die("tmpdir");
    if (cx_fmt(fake, sizeof fake, "%s/fake.bin", dir) ||
        cx_fmt(runp, sizeof runp, "%s/run", dir) ||
        cx_fmt(outd, sizeof outd, "%s/out", dir) ||
        cx_fmt(logp, sizeof logp, "%s/fake.log", dir) ||
        cx_fmt(src, sizeof src, "%s/tests/fixtures/s9-nightly-fake.cx", root) ||
        cx_fmt(com, sizeof com, "%s/%s", root, "unisacc" ".com") ||
        cx_fmt(tool, sizeof tool, "%s/tools/s9-nightly.cx", root)) die("fmt");
    if(!mat||material_want("map")){
        char *b[] = {"sh", com, src, "-o", fake, 0};
        runv(b, root, 20, buf, sizeof buf, &rc);
        ck(rc == 0, "fake-compile");
    }
    {
        char *mk[] = {"mkdir", "-p", outd, runp, 0};
        runv(mk, dir, 5, buf, sizeof buf, &rc);
    }
    setenv("S9_FAKE_LOG", logp, 1);
    setenv("UNISACC_S9_NIGHTLY_SOURCE", tool, 1);
    if(given_nightly&&setenv("S9_NIGHTLY_NATIVE",given_nightly,1))die("native-env");
    if((!mat||!strcmp(material_cases,"all")||!material_want("map"))&&!sy_env("S9_NIGHTLY_NATIVE")) {
        char prepared[4400];
        if(cx_fmt(prepared,sizeof prepared,"%s/nightly.native",dir)||tq_native(root,tool,prepared,why,sizeof why))die(why);
        if(setenv("S9_NIGHTLY_NATIVE",prepared,1))die("native-env");
    }
    v[0] = "sh"; v[1] = com; v[2] = tool; v[3] = "--"; v[4] = dir; v[5] = runp;
    v[6] = "--tier"; v[7] = "commit"; v[8] = "--date"; v[9] = "2026-11-10"; v[10] = "--fake"; v[11] = fake; v[12] = 0;
    if(mapcheck) {
        char *command[]={(char *)sy_env("S9_NIGHTLY_NATIVE"),"--map-controls",0};np_result r={0};
        if(np_run(command,root,0,15,&r,why,sizeof why))die("map-controls-transport");
        ck(r.rc==0&&!r.residue&&has(r.out,"MAP_CONTROLS\tfailed=0"),"map-controls-real-helper");
        ck(has(r.err,"map-families-unready count=3 families=hosttcc,all-waves-tool,assembler"),"map-preflight-lists-all-missing-families-together");
        const char *names[]={"prepared-assembler-explicitly-admitted-other-prepared-still-excluded","implemented-source-family-set-deduplicated-all-tiers","all-missing-refused-before-map-intent","remaining-family-refused-without-poisoning-run","same-run-ready-after-filling-all-families","ready-families-form-complete-map","family-dump-sha-tamper-refused","family-input-identity-change-refused","family-other-run-receipts-refused","family-intent-tamper-refused","family-receipt-absent-refused","interrupted-map-missing-product-requires-new-run","existing-map-continues-to-original-sha-verification","map-product-directory-refused"};
        for(int i=0;i<14;i++){char expected[240];if(cx_fmt(expected,sizeof expected,"MAP_CONTROL\t%s\tchecked=1",names[i]))die("map-control-label");ck(has(r.out,expected),names[i]);}
        np_free(&r);
    }
    if (core) {
    runv(v, dir, 20, buf, sizeof buf, &rc);
    ck(rc == 0 && strstr(buf, "S9_NIGHTLY\tstatus=PASS"), "order-pass");
    {
        const char *r = strstr(buf, "\treport=");
        size_t k = 0;
        if (r) { r += 8; while (r[k] && r[k] != '\n' && k + 1 < sizeof report_path) { report_path[k] = r[k]; k++; } }
        report_path[k] = 0;
        ck(k > 0, "report-path");
    }
    {
        size_t n; char *s = cx_read(logp, &n);
        ck(s && strstr(s, "build") && strstr(s, "init") && strstr(s, "prepare") && strstr(s, "step") && strstr(s, "aggregate"), "order-log");
        free(s);
    }
    setenv("S9_FAKE_FAIL", "driver", 1);
    {
        char *rm[] = {"rm", "-f", logp, 0};
        runv(rm, dir, 5, buf, sizeof buf, &rc);
    }
    runv(v, dir, 20, buf, sizeof buf, &rc);
    ck(rc == 1 && strstr(buf, "prepare-driver"), "fail-stop");
    {
        /* 并行 prepare 的失败合同(不弱于原「后面不再起」):报告里 driver 是失败的那条,后面被杀的 prepare 逐条
           记 NOT_RUN,不出现 PASS,并且没有进入 step/aggregate。 */
        /* 断言对象是运行产物(report/log),不是源码文本:用 has() 的字节比较,不用 strstr 把报告当源码锚。 */
        size_t n; char *s = cx_read(report_path, &n);
        ck(s && has(s, "\ndriver\t") && !has(s, "\ndriver\t0\tNOT_RUN"), "fail-stop-named");   /* driver 自己那行带真实耗时,不是 NOT_RUN */
        ck(s && has(s, "selection\t0\tNOT_RUN"), "fail-others-not-run");
        /* 「不记 PASS」由上一行保证:报告里 selection 只有 NOT_RUN 这一种形态,没有它的耗时行。 */
        free(s);
        s = cx_read(logp, &n);
        ck(s && !has(s, "\nstep") && !has(s, "\naggregate"), "fail-no-later-phase");
        free(s);
    }
    unsetenv("S9_FAKE_FAIL");
    /* commit 档: init 带 --tier commit,每步耗时列存在 */
    {
        char *rm[] = {"rm", "-f", logp, 0};
        runv(rm, dir, 5, buf, sizeof buf, &rc);
    }
    runv(v, dir, 20, buf, sizeof buf, &rc);
    ck(rc == 0, "tier-commit-pass");
    {
        size_t n; char *s = cx_read(logp, &n);
        ck(s && strstr(s, "init - --tier commit"), "tier-commit-passthrough");
        free(s);
    }
    {
        char rp[4400]; size_t n; char *s;
        cx_fmt(rp, sizeof rp, "%s", report_path);
        s = cx_read(rp, &n);
        ck(has(s, "wall_ms") && has(s, "step ") && has(s, "\t") && has(s, "truncated\t0"), "wall-ms-column");
        free(s);
    }
    }
    if (tiers) {
    /* daily 档: init 不带 --tier */
    {
        char *rm[] = {"rm", "-f", logp, 0};
        runv(rm, dir, 5, buf, sizeof buf, &rc);
    }
    v[7] = "daily";
    runv(v, dir, 20, buf, sizeof buf, &rc);
    {
        size_t n; char *s = cx_read(logp, &n);
        ck(rc == 0 && s && strstr(s, "init -\n") && !strstr(s, "--tier"), "tier-daily-no-flag");
        free(s);
    }
    /* release 档: init 带 --tier release */
    {
        char *rm[] = {"rm", "-f", logp, 0};
        runv(rm, dir, 5, buf, sizeof buf, &rc);
    }
    v[7] = "release";
    runv(v, dir, 20, buf, sizeof buf, &rc);
    {
        size_t n; char *s = cx_read(logp, &n);
        ck(rc == 0 && s && strstr(s, "init - --tier release"), "tier-release-passthrough");
        free(s);
    }
    v[7] = "daily";
    }
    if (lim) {
    v[7] = "daily";
    v[7] = "commit";
    setenv("S9_FAKE_SLEEP", "3", 1);
    {
        char *rm[] = {"rm", "-f", logp, 0};
        runv(rm, dir, 5, buf, sizeof buf, &rc);
    }
    v[12] = "--step-s"; v[13] = "1"; v[14] = 0;
    runv(v, dir, 20, buf, sizeof buf, &rc);
    ck(rc == 1 && strstr(buf, "step"), "timeout-stop");
    v[12] = 0;
    setenv("S9_FAKE_SLEEP", "0", 1);
    v[7] = "daily";
    /* max-steps: 假 s9 需 2 步才完成, --max-steps 1 必须 FAIL(step-pending) */
    {
        char *rm[] = {"rm", "-f", logp, 0};
        runv(rm, dir, 5, buf, sizeof buf, &rc);
    }
    v[12] = "--max-steps"; v[13] = "1"; v[14] = 0;
    runv(v, dir, 20, buf, sizeof buf, &rc);
    ck(rc == 1 && strstr(buf, "step-pending"), "max-steps-reached-fail");
    {
        char *rm[] = {"rm", "-f", logp, 0};
        runv(rm, dir, 5, buf, sizeof buf, &rc);
    }
    v[13] = "0";
    runv(v, dir, 20, buf, sizeof buf, &rc);
    ck(rc == 2, "max-steps-zero-rejected");
    /* 缺 --date: 取当日, 绝不是 1970-01-01 */
    {
        char *rm[] = {"rm", "-f", logp, 0};
        char *w[16];
        runv(rm, dir, 5, buf, sizeof buf, &rc);
        w[0] = "sh"; w[1] = com; w[2] = tool; w[3] = "--"; w[4] = dir; w[5] = runp;
        w[6] = "--tier"; w[7] = "commit"; w[8] = "--fake"; w[9] = fake; w[10] = 0;
        runv(w, dir, 20, buf, sizeof buf, &rc);
        ck(rc == 0 && strstr(buf, "report=") && !strstr(buf, "1970-01-01"), "date-default-today");
    }
    /* 日志截断: S9_FAKE_LONG 令假 s9 连续 PENDING 1500 步, 每步一行日志, 总量超 8000 字节 */
    {
        char *rm[] = {"rm", "-f", logp, 0};
        char *w[16];
        runv(rm, dir, 5, buf, sizeof buf, &rc);
        setenv("S9_FAKE_LONG", "80", 1);
        w[0] = "sh"; w[1] = com; w[2] = tool; w[3] = "--"; w[4] = dir; w[5] = runp;
        w[6] = "--tier"; w[7] = "commit"; w[8] = "--date"; w[9] = "2026-11-11"; w[10] = "--fake"; w[11] = fake;
        w[12] = "--max-steps"; w[13] = "200"; w[14] = 0;
        runv(w, dir, 20, buf, sizeof buf, &rc);
        ck(rc == 0 && strstr(buf, "S9_NIGHTLY\tstatus=PASS"), "truncate-exit-contract");
        {
            const char *r = strstr(buf, "\treport=");
            char rp[4400]; size_t k = 0, n; char *s;
            rp[0] = 0;
            if (r) { r += 8; while (r[k] && r[k] != '\n' && k + 1 < sizeof rp) { rp[k] = r[k]; k++; } rp[k] = 0; }
            s = k ? cx_read(rp, &n) : 0;
            ck(has(s, "truncated\t1") && has(s, "TRUNCATED"), "truncate-marked");
            free(s);
        }
        unsetenv("S9_FAKE_LONG");
    }
    /* 出口与 deadline: 假 s9 要求 step 带 UNISACC_BOUND_DEADLINE_MONO(缺则 rc=2, 编排 FAIL step=step) */
    {
        char *w[16];
        char *rmx[] = {"rm", "-f", logp, 0, 0, 0};
        char pa[4400], pb[4400], pc[4400];
        cx_fmt(pa, sizeof pa, "%s/a.start", runp); cx_fmt(pb, sizeof pb, "%s/a.done", runp); cx_fmt(pc, sizeof pc, "%s/b.start", runp);
        w[0] = "sh"; w[1] = com; w[2] = tool; w[3] = "--"; w[4] = dir; w[5] = runp;
        w[6] = "--tier"; w[7] = "commit"; w[8] = "--date"; w[9] = "2026-11-12"; w[10] = "--fake"; w[11] = fake; w[12] = 0;
        unsetenv("S9_FAKE_LONG");
        setenv("S9_FAKE_SLEEP", "0", 1);
        /* 无 S9_WT 行即转 aggregate(一步即出口, 状态 PASS) */
        runv(rmx, dir, 5, buf, sizeof buf, &rc);
        setenv("S9_FAKE_MODE", "nowt", 1);
        runv(w, dir, 20, buf, sizeof buf, &rc);
        {
            size_t n; char *s = cx_read(logp, &n); int steps = 0; const char *q = s;
            while (q && (q = strstr(q, "step\n"))) { steps++; q += 5; }
            ck(rc == 0 && has(buf, "status=PASS") && s && steps == 1 && has(s, "aggregate"), "no-wt-goes-aggregate");
            free(s);
        }
        /* 有 S9_WT 且 start==done: 不转 aggregate, 继续 step(第 2 步无 S9_WT 才结束) */
        runv(rmx, dir, 5, buf, sizeof buf, &rc);
        { char *r2[] = {"rm", "-f", pa, pb, pc, 0}; runv(r2, dir, 5, buf, sizeof buf, &rc); }
        setenv("S9_FAKE_MODE", "alldone", 1);
        runv(w, dir, 20, buf, sizeof buf, &rc);
        {
            size_t n; char *s = cx_read(logp, &n); int steps = 0; const char *q = s;
            while (q && (q = strstr(q, "step\n"))) { steps++; q += 5; }
            ck(rc == 0 && strstr(buf, "status=PASS") && steps == 2, "start-eq-done-with-wt-continues");
            free(s);
        }
        /* UNKNOWN: b 有 start 无 done, 对 b 调 retry 一次再 aggregate */
        runv(rmx, dir, 5, buf, sizeof buf, &rc);
        { char *r2[] = {"rm", "-f", pa, pb, pc, 0}; runv(r2, dir, 5, buf, sizeof buf, &rc); }
        setenv("S9_FAKE_MODE", "unk", 1);
        runv(w, dir, 20, buf, sizeof buf, &rc);
        {
            size_t n; char *s = cx_read(logp, &n);
            const char *r1 = s ? strstr(s, "retry") : 0;
            ck(rc == 0 && has(r1, " b") && !has(r1 + 5, "retry") && has(s, "aggregate"), "unknown-retry-once-then-aggregate");
            free(s);
        }
        { char *r2[] = {"rm", "-f", pa, pb, pc, 0}; runv(r2, dir, 5, buf, sizeof buf, &rc); }
        /* 0.0.68 完成口径:缺 S9_WT 行不等于完成。假 s9 每步无 S9_WT、无 STEP_FINISHED:走满缺省 4 步后 FAIL(step-pending),不进 aggregate。 */
        runv(rmx, dir, 5, buf, sizeof buf, &rc);
        setenv("S9_FAKE_MODE", "quiet", 1);
        runv(w, dir, 20, buf, sizeof buf, &rc);
        {
            size_t n; char *s = cx_read(logp, &n); int steps = 0; const char *q = s;
            while (q && (q = strstr(q, "step\n"))) { steps++; q += 5; }
            ck(rc == 1 && has(buf, "step-pending") && !has(buf, "status=PASS") && s && steps == 4 && !has(s, "aggregate"), "no-wt-without-finished-signal-not-done");
            free(s);
        }
        /* 有待跑片而本步未发片(STEP_NO_PROGRESS, rc 4):一步即停,状态 NO_PROGRESS、退出码 4,不进 aggregate,不记 PASS。 */
        runv(rmx, dir, 5, buf, sizeof buf, &rc);
        setenv("S9_FAKE_MODE", "noprog", 1);
        runv(w, dir, 20, buf, sizeof buf, &rc);
        {
            size_t n; char *s = cx_read(logp, &n); int steps = 0; const char *q = s;
            while (q && (q = strstr(q, "step\n"))) { steps++; q += 5; }
            ck(rc == 4 && has(buf, "status=NO_PROGRESS") && !has(buf, "status=PASS") && s && steps == 1 && !has(s, "aggregate"), "no-progress-signal-stops-rc4-not-done");
            free(s);
        }
        /* 子阶段 steps 同口径:NO_PROGRESS 不得报 STEPS_DONE;无完成信号的一步报 PENDING(3) 而非 STEPS_DONE。 */
        {
            char *ps[20]; char sess2[4400]; int k = 0;
            ps[k++] = "sh"; ps[k++] = com; ps[k++] = tool; ps[k++] = "--"; ps[k++] = dir; ps[k++] = "--resume"; ps[k++] = runp;
            ps[k++] = "--tier"; ps[k++] = "commit"; ps[k++] = "--date"; ps[k++] = "2026-11-12"; ps[k++] = "--phase"; ps[k++] = "steps"; ps[k++] = "--fake"; ps[k++] = fake; ps[k] = 0;
            if (cx_fmt(sess2, sizeof sess2, "%s/session.tsv", runp) || cx_write(sess2, "resume\n", 7)) die("session-write");
            runv(ps, dir, 20, buf, sizeof buf, &rc);
            ck(rc == 4 && has(buf, "status=NO_PROGRESS") && !has(buf, "STEPS_DONE"), "phase-steps-no-progress-not-steps-done");
            setenv("S9_FAKE_MODE", "quiet", 1);
            runv(ps, dir, 20, buf, sizeof buf, &rc);
            ck(rc == 3 && has(buf, "status=PENDING") && !has(buf, "STEPS_DONE"), "phase-steps-no-wt-without-finished-stays-pending");
            { char *r3[] = {"rm", "-f", sess2, 0}; runv(r3, dir, 5, buf, sizeof buf, &rc); }
        }
        unsetenv("S9_FAKE_MODE");
    }
    }
    /* --resume RUN: 沿用同一 RUN,跳过 build/init/prepare,只 step/aggregate;step 仍带自动 deadline */
    if (res) {
        char *w[16];
        char *rmx[] = {"rm", "-f", logp, 0};
        char sess[4400], rep[4400];
        size_t n; char *s;
        cx_fmt(sess, sizeof sess, "%s/session.tsv", runp);
        cx_fmt(rep, sizeof rep, "%s/s9-nightly-2026-11-13-commit-resume.md", dir);
        w[0] = "sh"; w[1] = com; w[2] = tool; w[3] = "--"; w[4] = dir; w[5] = "--resume"; w[6] = runp;
        w[7] = "--tier"; w[8] = "commit"; w[9] = "--date"; w[10] = "2026-11-13"; w[11] = "--fake"; w[12] = fake; w[13] = 0;
        { char *r2[] = {"rm", "-f", sess, 0}; runv(r2, dir, 5, buf, sizeof buf, &rc); }
        runv(rmx, dir, 5, buf, sizeof buf, &rc);
        runv(w, dir, 20, buf, sizeof buf, &rc);
        s = cx_read(logp, &n);
        ck(rc == 2 && !s, "resume-without-session-refused-no-step");
        free(s);
        if (cx_write(sess, "resume\n", 7)) die("session-write");
        runv(rmx, dir, 5, buf, sizeof buf, &rc);
        runv(w, dir, 20, buf, sizeof buf, &rc);
        s = cx_read(logp, &n);
        ck(rc == 0 && strstr(buf, "S9_NIGHTLY\tstatus=PASS") && s && strstr(s, "step") && strstr(s, "aggregate"), "resume-steps-then-aggregate");
        ck(s && !strstr(s, "build") && !strstr(s, "init") && !strstr(s, "prepare"), "resume-skips-build-init-prepare");
        free(s);
        s = cx_read(rep, &n);
        ck(s && strstr(s, "status\tPASS") && strstr(s, "resume\t"), "resume-report-separate-file-marked");
        free(s);
    }
    /* 子阶段 init|steps|aggregate(0.0.57):每次调用独立有界、可重复;steps 默认单步,PENDING=3;aggregate 分 4 片再 merge,已有片记录跳过 */
    if (ph) {
        char *w[20];
        char *rmx[] = {"rm", "-f", logp, 0};
        char sess[4400], part1[4400], rep[4400];
        size_t n; char *s;
        cx_fmt(sess, sizeof sess, "%s/session.tsv", runp);
        cx_fmt(part1, sizeof part1, "%s/agg-part-1-4", runp);
        cx_fmt(rep, sizeof rep, "%s/s9-nightly-2026-11-14-commit-steps.md", dir);
        /* init: RUN 位置参数,只 build/init/prepare */
        runv(rmx, dir, 5, buf, sizeof buf, &rc);
        w[0] = "sh"; w[1] = com; w[2] = tool; w[3] = "--"; w[4] = dir; w[5] = runp; w[6] = "--tier"; w[7] = "commit";
        w[8] = "--date"; w[9] = "2026-11-14"; w[10] = "--phase"; w[11] = "init"; w[12] = "--fake"; w[13] = fake; w[14] = 0;
        if(phase_want("init")){
        runv(w, dir, 20, buf, sizeof buf, &rc);
        s = cx_read(logp, &n);
        ck(rc == 0 && strstr(buf, "status=PREPARED"), "phase-init-prepared");
        ck(s && strstr(s, "build") && strstr(s, "init") && strstr(s, "prepare") && !strstr(s, "step") && !strstr(s, "aggregate"), "phase-init-only-prepares");
        free(s);
        /* 拒绝:steps 不带 --resume;init 带 --resume */
        w[11] = "steps";
        runv(w, dir, 20, buf, sizeof buf, &rc);
        ck(rc == 2, "phase-steps-needs-resume");
        }
        if (cx_write(sess, "resume\n", 7)) die("session-write");
        /* steps:第 1 次 PENDING(3),第 2 次 STEPS_DONE(0);各只走一步;都不碰 aggregate */
        w[5] = "--resume"; w[4] = dir; w[6] = runp; w[7] = "--tier"; w[8] = "commit"; w[9] = "--date"; w[10] = "2026-11-14";
        w[11] = "--phase"; w[12] = "steps"; w[13] = "--fake"; w[14] = fake; w[15] = 0;
        if(phase_want("steps")){
        runv(rmx, dir, 5, buf, sizeof buf, &rc);
        runv(w, dir, 20, buf, sizeof buf, &rc);
        ck(rc == 3 && strstr(buf, "status=PENDING"), "phase-steps-first-pending");
        s = cx_read(logp, &n);
        { int c = 0; if (s) for (size_t q = 0; q + 4 < n; q++) if (!strncmp(s + q, "step", 4)) c++;
          ck(c == 1 && !strstr(s, "aggregate"), "phase-steps-one-step-per-call"); }
        free(s);
        runv(w, dir, 20, buf, sizeof buf, &rc);
        ck(rc == 0 && strstr(buf, "status=STEPS_DONE"), "phase-steps-done");
        s = cx_read(rep, &n);
        ck(s && strstr(s, "status\tSTEPS_DONE"), "phase-steps-report-own-file");
        free(s);
        }
        /* aggregate: 4 片 + merge;预先放好 1 号片记录则跳过它 */
        w[12] = "aggregate";
        if(phase_want("aggregate")){
        if (cx_write(part1, "x\n", 2)) die("part-write");
        runv(rmx, dir, 5, buf, sizeof buf, &rc);
        runv(w, dir, 20, buf, sizeof buf, &rc);
        s = cx_read(logp, &n);
        ck(rc == 0 && strstr(buf, "status=PASS"), "phase-aggregate-pass");
        ck(s && strstr(s, "aggregate --part 0 4") && strstr(s, "aggregate --part 2 4") && strstr(s, "aggregate --part 3 4") && strstr(s, "aggregate --merge 4"), "phase-aggregate-parts-then-merge");
        ck(s && !strstr(s, "--part 1 4") && !strstr(s, "step"), "phase-aggregate-reuses-existing-part");
        free(s);
        }
        /* aggregate.out 落盘:merge 的完整 stdout(超 4000 字节缓冲)逐字节写入 RUN/aggregate.out,s9-verdict 读它判定 */
        if(phase_want("aggout")){
            char aggf[4400], aggo[4400], tierf[4400], btf[4400], big[9000], *got, *vv[8];
            size_t gn, w2 = 0, k;
            cx_fmt(aggf, sizeof aggf, "%s/agg.fake", dir);
            cx_fmt(aggo, sizeof aggo, "%s/aggregate.out", runp);
            cx_fmt(tierf, sizeof tierf, "%s/tier", runp);
            cx_fmt(btf, sizeof btf, "%s/batches.tsv", dir);
            w2 = (size_t)snprintf(big, sizeof big, "BATCH\ta\tPASS\treason=");
            for (k = 0; k < 5000; k++) big[w2++] = 'x';
            w2 += (size_t)snprintf(big + w2, sizeof big - w2, "\nBATCH\tb\tPASS\treason=ok\nAGGREGATE\tQUALIFIED\timplemented_batches=2\tpass=2\tfail=0\tunknown=0\tmissing=0\trefused=0\n");
            if (cx_write(aggf, big, w2) || cx_write(tierf, "all\n", 4)) die("agg-write");
            { const char *bt = "id\timplementation\tlayer\tsource\tmode\tplatform\tbudget\tmaterials\tentry\targs\tcoverage\texpect\theaders\ttier\n"
                               "a\tIMPLEMENTED\tc\ts\tSOURCE\tl\t55\t-\te\t-\tx\tr\tp\tdaily\nb\tIMPLEMENTED\tc\ts\tSOURCE\tl\t55\t-\te\t-\tx\tr\tp\trelease\n";
              if (cx_write(btf, bt, strlen(bt))) die("bt-write"); }
            setenv("S9_FAKE_AGG_FILE", aggf, 1);
            runv(rmx, dir, 5, buf, sizeof buf, &rc);
            { char *rm2[] = {"rm", "-f", aggo, 0}; runv(rm2, dir, 5, buf, sizeof buf, &rc); }
            runv(w, dir, 20, buf, sizeof buf, &rc);
            ck(rc == 0 && strstr(buf, "status=PASS"), "aggout-phase-exit0-stdout-kept");
            got = cx_read(aggo, &gn);
            ck(got != 0, "aggout-file-exists");
            ck(got && gn == w2 && !memcmp(got, big, w2), "aggout-bytes-identical-beyond-4000");
            free(got);
            vv[0] = "sh"; vv[1] = com; vv[2] = "tools/s9-verdict.cx"; vv[3] = "--"; vv[4] = runp; vv[5] = "--batches"; vv[6] = btf; vv[7] = 0;
            runv(vv, root, 30, buf, sizeof buf, &rc);
            ck(rc == 0 && strstr(buf, "4\tPASS\t") && strstr(buf, "aggregate.out"), "aggout-verdict-reads-it-pass");
            /* 无 AGGREGATE 行的输出同样原样落盘,verdict 给 UNKNOWN */
            { const char *two = "BATCH\ta\tPASS\treason=ok\nBATCH\tb\tPASS\treason=ok\n";
              cx_write(aggf, two, strlen(two));
              runv(w, dir, 20, buf, sizeof buf, &rc);
              got = cx_read(aggo, &gn);
              ck(got && gn == strlen(two) && !memcmp(got, two, gn), "aggout-overwritten-second-run");
              free(got);
              runv(vv, root, 30, buf, sizeof buf, &rc);
              ck(strstr(buf, "4\tUNKNOWN\t") != 0, "aggout-verdict-unknown-without-aggregate-line"); }
            unsetenv("S9_FAKE_AGG_FILE");
        }
        /* 收据校验 refused 的 reason 具名输出与失败时落盘:片失败、merge 失败两条路径 aggregate.out 都在且含 reason */
        if(phase_want("failures")){
            char aggf[4400], aggo[4400], rm2[4400], *got;
            const char *line = "S9_RECEIPT\tREFUSE\tbatch=x\tslice=slice-0-0\treason=receipt-sha-mismatch\n";
            size_t gn;
            char *rmv[] = {"rm", "-rf", "--", 0, 0, 0, 0, 0, 0};
            char *wv[20];
            cx_fmt(aggf, sizeof aggf, "%s/agg-refuse.fake", dir);
            cx_fmt(aggo, sizeof aggo, "%s/aggregate.out", runp);
            if (cx_write(aggf, line, strlen(line))) die("agg-refuse-write");
            for (int q = 0; q < 15; q++) wv[q] = w[q];
            wv[15] = 0;
            setenv("S9_FAKE_AGG_FILE", aggf, 1);
            /* 片 0 失败 */
            for (int k = 0; k < 4; k++) {
                cx_fmt(rm2, sizeof rm2, "%s/agg-part-%d-4", runp, k);
                rmv[3] = rm2; rmv[4] = 0;
                runv(rmv, dir, 5, buf, sizeof buf, &rc);
            }
            cx_fmt(rm2, sizeof rm2, "%s", aggo);
            rmv[3] = rm2; rmv[4] = 0;
            runv(rmv, dir, 5, buf, sizeof buf, &rc);
            setenv("S9_FAKE_PART_RC", "2", 1);
            runv(wv, dir, 20, buf, sizeof buf, &rc);
            ck(rc == 1 && strstr(buf, "status=FAIL") && strstr(buf, "step=aggregate-part-0"), "agg-part-fail-status");
            got = cx_read(aggo, &gn);
            ck(got != 0, "agg-part-fail-aggout-exists");
            ck(got && strstr(got, "S9_RECEIPT\tREFUSE") && strstr(got, "reason=receipt-sha-mismatch"), "agg-part-fail-aggout-has-reason");
            free(got);
            unsetenv("S9_FAKE_PART_RC");
            /* merge 失败:先清片与旧 aggregate.out */
            for (int k = 0; k < 4; k++) {
                cx_fmt(rm2, sizeof rm2, "%s/agg-part-%d-4", runp, k);
                rmv[3] = rm2; rmv[4] = 0;
                runv(rmv, dir, 5, buf, sizeof buf, &rc);
            }
            cx_fmt(rm2, sizeof rm2, "%s", aggo);
            rmv[3] = rm2; rmv[4] = 0;
            runv(rmv, dir, 5, buf, sizeof buf, &rc);
            setenv("S9_FAKE_MERGE_RC", "2", 1);
            runv(wv, dir, 20, buf, sizeof buf, &rc);
            ck(rc == 1 && strstr(buf, "status=FAIL") && strstr(buf, "step=aggregate"), "agg-merge-fail-status");
            got = cx_read(aggo, &gn);
            ck(got && strstr(got, "reason=receipt-sha-mismatch"), "agg-merge-fail-aggout-has-reason");
            free(got);
            unsetenv("S9_FAKE_MERGE_RC");
            unsetenv("S9_FAKE_AGG_FILE");
            /* merge 失败时仍是 4 片都跑完后才 merge;失败不改变 rc 判定(仍为 1) */
            {
                size_t ln; char *lg = cx_read(logp, &ln);
                ck(lg && strstr(lg, "aggregate --part 3 4") && strstr(lg, "aggregate --merge 4"), "agg-merge-fail-after-all-parts");
                free(lg);
            }
        }
    }
    if (ph&&phase_want("candidate")) {   /* 候选可执行位前置门: 0600 被拒并点名, 0711 通过 */
        char cand[4400], *cv[16];
        int i;
        if (cx_fmt(cand, sizeof cand, "%s/%s", dir, "unisacc" ".com")) die("fmt");
        { char *cp[] = {"cp", fake, cand, 0}; runv(cp, dir, 5, buf, sizeof buf, &rc); }
        chmod(cand, 0600);
        for (i = 0; i < 12; i++) cv[i] = v[i];
        cv[12] = 0;
        {   /* die 文案走 stderr: 用 sh -c 合并到 stdout */
            char cmd[4400 * 3];
            char *sv[] = {"sh", "-c", cmd, 0};
            if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- '%s' '%s' --tier commit --date 2026-11-10 --fake '%s' 2>&1", com, tool, dir, runp, fake)) die("fmt");
            runv(sv, dir, 20, buf, sizeof buf, &rc);
        }
        ck(rc == 2 && strstr(buf, "REFUSE candidate not executable") && strstr(buf, cand) && strstr(buf, "0600"), "candidate-0600-refused");
        chmod(cand, 0711);
        runv(cv, dir, 20, buf, sizeof buf, &rc);
        ck(rc == 0 && strstr(buf, "S9_NIGHTLY\tstatus=PASS"), "candidate-0711-passes");
    }
    if (mat&&material_want("map")) {   /* 材料映射必须吃真实 affected --materials-dump 的四列输出:0.0.67 的解析按三列写,四列行全被当
                      REFUSED 跳过,map 到 init 时是 0 行而编排仍报 PASS。这里不手造行,直接跑本仓的 dump,
                      走与 s9-nightly 同一个解析器(tools/cxlib/s9map.cx),断言行数非零,path行绝对路径,sha256行按登记严格校验。 */
        char *dv[] = {"sh", com, "tools/affected.cx", "--", "--materials-dump", "--prepare-materials", 0};
        if(given_affected){dv[0]=(char *)given_affected;dv[1]="--materials-dump";dv[2]="--prepare-materials";dv[3]=0;}
        char *du = 0; size_t dn = 0; char map[16384], mwhy[300];
        np_result r = {0};
        (void)buf; (void)rc;
        if (np_run(dv, root, 0, 50, &r, why, sizeof why)) die(why);
        du = r.out; dn = (size_t)r.outn;
        ck(du && dn > 0 && memchr(du, '\n', dn) != 0, "map-real-dump-nonempty");
        mwhy[0] = 0;
        ck(s9_map_from_dump(du ? du : "", (long)dn, map, (long)sizeof map, mwhy, (int)sizeof mwhy) == 0, "map-real-dump-parsed");
        ck(s9_map_rows() > 0, "map-real-dump-rows-nonzero");
        map_kind_load();map_kind_controls();
        {   long a2=0,bad=0,lines=0,paths=0,hashes=0;
            while(map[a2]){
                long e2=a2;while(map[e2]&&map[e2]!='\n')e2++;int kind=map_declared_row(map+a2,e2-a2);
                lines++;if(!map[e2]||!kind)bad++;if(kind==1)paths++;if(kind==2)hashes++;
                if(!map[e2])break;a2=e2+1;
            }
            /* Preserve absolute-path admission for every declared path. */
            ck(lines==s9_map_rows()&&bad==0&&paths>0,"map-real-dump-every-row-name-and-abs-path");
            ck(paths+hashes==lines&&bad==0,"map-real-dump-all-values-match-declared-kind");
            printf("MATERIAL_MAP\tpaths=%ld\tsha256=%ld\tbad=%ld\n",paths,hashes,bad);
        }
        np_free(&r);
    }
    if(mat&&(material_want("prepare")||material_want("negative"))){
        /* Real empty-dump rejection: build each actual executor in its own
         * bounded preparation phase, then keep the original 30s negative bound.
         * This private RUN cannot inherit another group's fake receipts. */
        {   char seam[4400],seam_src[4400],emptyrun[4400],bound[4400],before[2][65],after[65];char *neg[16];int q2=0;
            const char *stages[]={"build-shards","build-waves"};
            if(cx_fmt(seam_src,sizeof seam_src,"%s/tests/fixtures/s9-materials-dump-empty.cx",root)||cx_fmt(seam,sizeof seam,"%s/seam.bin",dir)||cx_fmt(emptyrun,sizeof emptyrun,"%s/map-empty-run",dir)||cx_fmt(bound,sizeof bound,"%s/tools/bound",root))die("fmt");
            if(material_want("negative")){char *cc2[]={"sh",com,seam_src,"-o",seam,0};np_result compiled={0};run_result(cc2,root,40,&compiled);ck(compiled.rc==0&&!compiled.residue,"map-empty-dump-seam-compiled");np_free(&compiled);}
            neg[q2++]="sh";neg[q2++]=com;neg[q2++]=tool;neg[q2++]="--";
            neg[q2++]=root;neg[q2++]=emptyrun;neg[q2++]="--tier";neg[q2++]="commit";
            neg[q2++]="--date";neg[q2++]="2026-11-14";neg[q2++]="--phase";neg[q2++]="init";neg[q2]=0;
            if(material_want("negative")&&setenv("UNISACC_S9_MATERIALS_DUMP_SEAM",seam,1))die("seam-env");
            char bundle[4400];int use_material=given_shards&&given_waves;
            if(use_material){
                const char *shared=given_dir?given_dir:sy_env("S9_NIGHTLY_MATERIAL_DIR");
                if(cx_fmt(bundle,sizeof bundle,shared?"%s":"%s/native-materials",shared?shared:dir))die("material-dir-path");
                struct stat st;errno=0;int present=!lstat(bundle,&st);if(!present&&errno!=ENOENT)die("REFUSED material directory stat");if(present&&!S_ISDIR(st.st_mode))die("REFUSED real material directory required");
                if(!present){
                    if(shared&&!material_want("prepare"))die("REFUSED prepared material directory missing");
                    char *seal[]={bound,"50",(char *)sy_env("S9_NIGHTLY_NATIVE"),root,emptyrun,"--tier","commit","--native-material-dir",bundle,"--seal-native-materials",(char *)given_shards,(char *)given_waves,0};np_result sealed={0};run_result(seal,dir,55,&sealed);int ok=!sealed.rc&&!sealed.residue&&has(sealed.out,"PREPARED\tnative-material-dir");if(!ok&&sealed.errn)fwrite(sealed.err,1,sealed.errn,stderr);np_free(&sealed);if(!ok)die("REFUSED material directory preparation");
                }
                const char *raw[]={given_shards,given_waves},*names[]={"shards","waves"};for(int i=0;i<2;i++){char p[4800],a[65],b[65];if(cx_fmt(p,sizeof p,"%s/%s.bin",bundle,names[i])||!material_file_sha(raw[i],a)||!material_file_sha(p,b)||strcmp(a,b))die("REFUSED native material SHA mismatch");}
                printf("MATERIAL_DIRECTORY\tpath=%s\tverified=SHA256\tno-test-result\n",bundle);
                neg[q2++]="--native-material-dir";neg[q2++]=bundle;neg[q2]=0;
            }
            for(int i=0;i<2;i++){
                char *prep[16]={bound,"50",(char *)sy_env("S9_NIGHTLY_NATIVE"),root,emptyrun,"--tier","commit","--date","2026-11-14","--phase",(char *)stages[i],0};if(use_material){prep[11]="--native-material-dir";prep[12]=bundle;prep[13]=0;}
                np_result built={0};long t0=sy_now_ms();run_result(prep,dir,55,&built);
                int prepared=built.rc==0&&!built.residue&&has(built.out,"status=INIT_PHASE_DONE")&&has(built.out,stages[i]);
                if(material_want("prepare"))ck(prepared,i?"map-empty-waves-prepared":"map-empty-shards-prepared");
                printf("MATERIAL_PREP\tphase=%s\tstatus=%s\tbound_s=50\twall_ms=%ld\tno-test-result\n",stages[i],prepared?"PREPARED":"REFUSED",sy_now_ms()-t0);
                if(!prepared&&built.errn)fwrite(built.err,1,built.errn,stderr);np_free(&built);if(!prepared)die("map-empty-executor-preparation");
                before[i][0]=0;int valid=material_native_sha(emptyrun,stages[i],before[i]);if(material_want("prepare"))ck(valid,i?"map-empty-waves-prepared-sha":"map-empty-shards-prepared-sha");else if(!valid)die("REFUSED prepared executor SHA");
            }
            if(material_want("negative")){
            np_result rejected={0};long t0=sy_now_ms();run_result(neg,dir,30,&rejected);
            if(unsetenv("UNISACC_S9_MATERIALS_DUMP_SEAM"))die("seam-unset");
            int named=rejected.rc==1&&has(rejected.out,"S9_NIGHTLY\tstatus=FAIL\tstep=map\trc=1\t")&&has(rejected.err,"materials-map-empty refused=2\n");
            ck(named,"map-empty-dump-refused-by-name");
            ck(rejected.rc==1&&!has(rejected.out,"status=PASS")&&!has(rejected.err,"status=PASS"),"map-empty-dump-not-a-pass");
            ck(!rejected.residue&&!rejected.timed_out,"map-empty-dump-clean-children");
            ck(!has(rejected.out,"PASS")&&!has(rejected.err,"PASS"),"map-empty-dump-no-pass-in-either-stream");
            ck(has(rejected.out,"S9_INIT\tphase=build-shards\tstatus=SKIP\n")&&has(rejected.out,"S9_INIT\tphase=build-waves\tstatus=SKIP\n"),"map-empty-dump-consumes-prepared-executors");
            for(int i=0;i<2;i++)ck(material_native_sha(emptyrun,stages[i],after)&&!strcmp(before[i],after),i?"map-empty-waves-sha-unchanged":"map-empty-shards-sha-unchanged");
            printf("MATERIAL_NEGATIVE\tbound_s=30\trc=%d\twall_ms=%ld\n",rejected.rc,sy_now_ms()-t0);
            if(!named){if(rejected.outn)fwrite(rejected.out,1,rejected.outn,stderr);if(rejected.errn)fwrite(rejected.err,1,rejected.errn,stderr);}np_free(&rejected);
            }
        }
    }
    if (split || recovery) {
        { char map[256],why2[128];
          const char *good="MATERIAL\tb\tmodel-sha\t0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\n";
          const char *bad="MATERIAL\tb\tmodel-sha\t0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdeg\n";
          ck(!s9_map_from_dump(good,strlen(good),map,sizeof map,why2,sizeof why2)&&s9_map_rows()==1,"map-sha256-value-preserved");
          ck(s9_map_from_dump(bad,strlen(bad),map,sizeof map,why2,sizeof why2)!=0,"map-malformed-sha256-refused");
        }
        char splitrun[4400], *w[17]; size_t n; char *s;
        const char *parts[] = {"build", "map", "init-session", "prepare-1", "prepare-2", "prepare-3", "prepare-4", "prepare-5", "prepare-6"};
        if (cx_fmt(splitrun, sizeof splitrun, "%s/split-run", dir)) die("split-path");
        w[0]="sh"; w[1]=com; w[2]=tool; w[3]="--"; w[4]=dir; w[5]=splitrun;
        w[6]="--tier"; w[7]="commit"; w[8]="--date"; w[9]="2026-11-15";
        w[10]="--fake"; w[11]=fake; w[12]="--phase"; w[14]=0;
        /* 两叶不互为前置：先 waves，再 shards；每叶独立恢复并核二进制/收据篡改。 */
        for(int leaf=0;split&&leaf<2;leaf++) {
            const char *name=leaf?"build-shards":"build-waves";
            char image[4800],receipt[4800];
            w[13]=(char *)name;
            runv(w,root,20,buf,sizeof buf,&rc);
            ck(rc==0&&has(buf,"status=DONE"),leaf?"build-shards-independent":"build-waves-independent");
            {char *rm[]={"rm","-f",logp,0};runv(rm,dir,5,buf,sizeof buf,&rc);}
            runv(w,root,20,buf,sizeof buf,&rc);
            s=cx_read(logp,&n);
            ck(rc==0&&has(buf,"status=SKIP")&&!s,leaf?"build-shards-resume-no-child":"build-waves-resume-no-child");free(s);
            w[7]="daily";
            runv(w,root,20,buf,sizeof buf,&rc);
            s=cx_read(logp,&n);
            ck(rc!=0&&!s,leaf?"build-shards-input-change-refused":"build-waves-input-change-refused");free(s);
            w[7]="commit";
            if(cx_fmt(image,sizeof image,"%s.nightly-init/%s.bin",splitrun,name)||
               cx_fmt(receipt,sizeof receipt,"%s.nightly-init/%s.native",splitrun,name))die("native-path");
            size_t iz,rz;char *original=cx_read(image,&iz),*record=cx_read(receipt,&rz);
            if(!original||!record)die("native-read");
            if(cx_write(image,"tampered",8))die("native-tamper");
            runv(w,root,20,buf,sizeof buf,&rc);
            s=cx_read(logp,&n);
            ck(rc!=0&&!s,leaf?"build-shards-binary-tamper-refused":"build-waves-binary-tamper-refused");free(s);
            if(cx_write(image,original,iz)||chmod(image,0700)||cx_write(receipt,"tampered",8))die("native-restore");
            runv(w,root,20,buf,sizeof buf,&rc);
            s=cx_read(logp,&n);
            ck(rc!=0&&!s,leaf?"build-shards-receipt-tamper-refused":"build-waves-receipt-tamper-refused");free(s);
            if(cx_write(receipt,record,rz))die("receipt-restore");
            free(original);free(record);
        }
        for (int k=0;k<9;k++) {
            w[13]=(char *)parts[k];
            if(recovery&&k==3) {
                const char *files[]={"checker","checker.sha256","checker.identity","checker.identity.sha256"};char p[4800];
                for(int q=0;q<4;q++){if(cx_fmt(p,sizeof p,"%s/%s",splitrun,files[q])||cx_write(p,"fixture",7))die("checker-fixture");}
            }
            runv(w,root,20,buf,sizeof buf,&rc);
            ck(rc==0 && has(buf,"status=DONE"),parts[k]);
            if(recovery) {
            /* 子相已成功并持久化 outputs，但最后的外层 .done 丢失。 */
            char done[4800],evidence[4800],image[4800];size_t ez,iz;
            if(cx_fmt(done,sizeof done,k<2?"%s.nightly-init/%s.done":"%s/.nightly-init/%s.done",splitrun,parts[k])||
               cx_fmt(evidence,sizeof evidence,k<2?"%s.nightly-init/%s.outputs":"%s/.nightly-init/%s.outputs",splitrun,parts[k])||
               cx_fmt(image,sizeof image,k<2?"%s.nightly-init/build-waves.bin":"%s/.nightly-init/build-waves.bin",splitrun))die("recover-path");
            if(k==3&&cx_fmt(image,sizeof image,"%s/checker",splitrun))die("checker-path");
            char *record=cx_read(evidence,&ez),*original=cx_read(image,&iz);
            if(!record||!original||unlink(done))die("recover-fixture");
            runv(w,root,20,buf,sizeof buf,&rc);
            ck(rc==0&&has(buf,"status=RECOVERED"),"split-lost-done-recovered");
            if(unlink(done)||cx_write(image,"tampered",8))die("recover-tamper");
            runv(w,root,20,buf,sizeof buf,&rc);
            ck(rc!=0&&!has(buf,"status=RECOVERED"),"split-output-tamper-refused");
            if(cx_write(image,original,iz)||chmod(image,0700))die("recover-restore");
            w[7]="daily";runv(w,root,20,buf,sizeof buf,&rc);
            ck(rc!=0&&!has(buf,"status=RECOVERED"),"split-recovery-input-change-refused");w[7]="commit";
            if(cx_write(evidence,"tampered",8))die("recover-evidence-tamper");
            runv(w,root,20,buf,sizeof buf,&rc);
            ck(rc!=0&&!has(buf,"status=RECOVERED"),"split-success-evidence-tamper-refused");
            if(cx_write(evidence,record,ez))die("recover-evidence-restore");
            runv(w,root,20,buf,sizeof buf,&rc);
            ck(rc==0&&has(buf,"status=RECOVERED"),"split-restored-evidence-recovers");
            if(k==3) {
                char identity[4800];size_t size;
                if(cx_fmt(identity,sizeof identity,"%s/checker.identity",splitrun))die("checker-identity-path");
                char *saved=cx_read(identity,&size);if(!saved||unlink(done)||cx_write(identity,"tampered",8))die("checker-identity-tamper");
                runv(w,root,20,buf,sizeof buf,&rc);
                ck(rc!=0&&!has(buf,"status=RECOVERED"),"checker-identity-tamper-refused");
                if(cx_write(identity,saved,size))die("checker-identity-restore");free(saved);
                runv(w,root,20,buf,sizeof buf,&rc);ck(rc==0&&has(buf,"status=RECOVERED"),"checker-identity-restored-recovers");
            }
            if(k==1) {
                char map[4800],intent[4800];size_t mn,in;
                if(cx_fmt(map,sizeof map,"%s.materials.tsv",splitrun)||cx_fmt(intent,sizeof intent,"%s.nightly-init/map.intent",splitrun))die("map-recovery-path");
                char *saved_map=cx_read(map,&mn),*saved_intent=cx_read(intent,&in);
                if(!saved_map||!saved_intent||unlink(map))die("map-recovery-fixture");
                char *actual[]={(char *)sy_env("S9_NIGHTLY_NATIVE"),dir,splitrun,"--tier","commit","--date","2026-11-15","--fake",fake,"--phase","map",0};np_result mr={0};
                if(np_run(actual,root,0,20,&mr,why,sizeof why))die("map-recovery-transport");
                ck(mr.rc!=0&&!mr.residue&&has(mr.err,"map-recovery-materials-missing")&&has(mr.err,"NEW_RUN_REQUIRED")&&!has(mr.err,"file-absent"),"map-intent-with-missing-product-named-refusal");
                size_t after_n;char *after=cx_read(intent,&after_n);
                ck(sy_exists(map)==0&&after&&after_n==in&&!memcmp(after,saved_intent,in)&&!has(mr.out,"status=RECOVERED"),"map-missing-product-does-not-reseal-or-alter-intent");
                free(after);np_free(&mr);
                if(cx_write(map,saved_map,mn))die("map-product-restore");free(saved_map);free(saved_intent);
                runv(w,root,20,buf,sizeof buf,&rc);
                ck(rc==0&&has(buf,"status=SKIP"),"map-original-product-and-proofs-still-resume");
            }
            if(k==0) {
                /* 只有底层 native 成功封印和 intent，包装 outputs/done 都没有。 */
                if(unlink(done)||unlink(evidence))die("recover-native-window");
                runv(w,root,20,buf,sizeof buf,&rc);
                ck(rc==0&&has(buf,"status=RECOVERED"),"split-native-lost-outputs-and-done-recovers");
                if(unlink(done)||unlink(evidence)||cx_write(image,"tampered",8))die("recover-native-window-tamper");
                runv(w,root,20,buf,sizeof buf,&rc);
                ck(rc!=0&&!has(buf,"status=RECOVERED")&&sy_exists(evidence)!=1&&sy_exists(done)!=1,"split-native-window-sha-tamper-refused-no-seal");
                if(cx_write(image,original,iz)||chmod(image,0700))die("recover-native-window-restore");
                runv(w,root,20,buf,sizeof buf,&rc);
                ck(rc==0&&has(buf,"status=RECOVERED"),"split-native-window-restored-recovers");
            }
            free(record);free(original);
            }
        }
        { char *rm[] = {"rm","-f",logp,0}; runv(rm,dir,5,buf,sizeof buf,&rc); }
        w[13]="prepare-6";
        runv(w,root,20,buf,sizeof buf,&rc);
        s=cx_read(logp,&n);
        ck(rc==0 && has(buf,"status=SKIP") && !s,"split-completed-phase-no-child");
        free(s);
        w[7]="daily";
        runv(w,root,20,buf,sizeof buf,&rc);
        s=cx_read(logp,&n);
        ck(rc!=0 && !s,"split-tier-change-refused-before-child");
        free(s);
    }
    printf("INFO\tcheck-s9-nightly.truncation 已单测(S9_FAKE_LONG)\n");
    printf("CHECK_S9_NIGHTLY\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
