/* tools/check-s9-nightly.cx -- 假 s9 验证编排顺序、超时与失败停止。 */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.die

static int failed;
static char root[4096], why[512], report_path[4400];
static void die(const char *s) { tool_die("check-s9-nightly", s, 0, 2); }
static void ck(int ok, const char *n) {
    printf("%s\tcheck-s9-nightly.%s\n", ok ? "PASS" : "FAIL", n);
    if (!ok) failed++;
}
static int runv(char **v, const char *cwd, int sec, char *out, int cap, int *rc) {
    np_result r = {0};
    if (np_run(v, cwd, 0, sec, &r, why, sizeof why)) die(why);
    *rc = r.rc;
    if (out && cap > 0) {
        size_t n = r.outn < (size_t)(cap - 1) ? r.outn : (size_t)(cap - 1);
        if (r.out && n && mm_copy(out, cap, r.out, (long)n)) die("copy");
        out[n] = 0;
    }
    np_free(&r);
    return 0;
}

int main(void) {
    char dir[4400], fake[4400], runp[4400], outd[4400], tool[4400], com[4400], logp[4400], src[4400], buf[4000];
    char *v[16];
    int rc;
    if (sy_realpath(".", root, sizeof root) < 0) die("cwd");
    if (cx_fmt(dir, sizeof dir, "%s/s9n-XXXXXX", sy_tmpdir()) || !mkdtemp(dir)) die("tmpdir");
    if (cx_fmt(fake, sizeof fake, "%s/fake.bin", dir) ||
        cx_fmt(runp, sizeof runp, "%s/run", dir) ||
        cx_fmt(outd, sizeof outd, "%s/out", dir) ||
        cx_fmt(logp, sizeof logp, "%s/fake.log", dir) ||
        cx_fmt(src, sizeof src, "%s/tests/fixtures/s9-nightly-fake.cx", root) ||
        cx_fmt(com, sizeof com, "%s/%s", root, "unisacc" ".com") ||
        cx_fmt(tool, sizeof tool, "%s/tools/s9-nightly.cx", root)) die("fmt");
    {
        char *b[] = {"sh", com, src, "-o", fake, 0};
        runv(b, root, 20, buf, sizeof buf, &rc);
        ck(rc == 0, "fake-compile");
    }
    {
        char *mk[] = {"mkdir", "-p", outd, runp, 0};
        runv(mk, dir, 5, buf, sizeof buf, &rc);
    }
    setenv("S9_FAKE_LOG", logp, 1);
    v[0] = "sh"; v[1] = com; v[2] = tool; v[3] = "--"; v[4] = dir; v[5] = runp;
    v[6] = "--tier"; v[7] = "commit"; v[8] = "--date"; v[9] = "2026-11-10"; v[10] = "--fake"; v[11] = fake; v[12] = 0;
    runv(v, dir, 20, buf, sizeof buf, &rc);
    ck(rc == 0 && strstr(buf, "S9_NIGHTLY\tstatus=PASS"), "order-pass");
    {
        const char *r = strstr(buf, "\treport=");
        size_t k = 0;
        if (r) { r += 8; while (r[k] && r[k] != '\n' && k + 1 < sizeof report_path) { report_path[k] = r[k]; k++; } }
        report_path[k] = 0;
        ck(k > 0, "report-path");
    }
    {
        size_t n; char *s = cx_read(logp, &n);
        ck(s && strstr(s, "build") && strstr(s, "init") && strstr(s, "prepare") && strstr(s, "step") && strstr(s, "aggregate"), "order-log");
        free(s);
    }
    setenv("S9_FAKE_FAIL", "driver", 1);
    {
        char *rm[] = {"rm", "-f", logp, 0};
        runv(rm, dir, 5, buf, sizeof buf, &rc);
    }
    runv(v, dir, 20, buf, sizeof buf, &rc);
    ck(rc == 1 && strstr(buf, "prepare-driver"), "fail-stop");
    {
        size_t n; char *s = cx_read(logp, &n);
        ck(s && !strstr(s, "selection"), "fail-no-later-prep");
        free(s);
    }
    unsetenv("S9_FAKE_FAIL");
    setenv("S9_FAKE_SLEEP", "3", 1);
    {
        char *rm[] = {"rm", "-f", logp, 0};
        runv(rm, dir, 5, buf, sizeof buf, &rc);
    }
    v[12] = "--step-s"; v[13] = "1"; v[14] = 0;
    runv(v, dir, 20, buf, sizeof buf, &rc);
    ck(rc == 1 && strstr(buf, "step"), "timeout-stop");
    v[12] = 0;
    setenv("S9_FAKE_SLEEP", "0", 1);
    /* commit 档: init 带 --tier commit,每步耗时列存在 */
    {
        char *rm[] = {"rm", "-f", logp, 0};
        runv(rm, dir, 5, buf, sizeof buf, &rc);
    }
    runv(v, dir, 20, buf, sizeof buf, &rc);
    ck(rc == 0, "tier-commit-pass");
    {
        size_t n; char *s = cx_read(logp, &n);
        ck(s && strstr(s, "init - --tier commit"), "tier-commit-passthrough");
        free(s);
    }
    {
        char rp[4400]; size_t n; char *s;
        cx_fmt(rp, sizeof rp, "%s", report_path);
        s = cx_read(rp, &n);
        ck(s && strstr(s, "wall_ms") && strstr(s, "step ") && strstr(s, "\t") && strstr(s, "truncated\t0"), "wall-ms-column");
        free(s);
    }
    /* daily 档: init 不带 --tier */
    {
        char *rm[] = {"rm", "-f", logp, 0};
        runv(rm, dir, 5, buf, sizeof buf, &rc);
    }
    v[7] = "daily";
    runv(v, dir, 20, buf, sizeof buf, &rc);
    {
        size_t n; char *s = cx_read(logp, &n);
        ck(rc == 0 && s && strstr(s, "init -\n") && !strstr(s, "--tier"), "tier-daily-no-flag");
        free(s);
    }
    /* max-steps: 假 s9 需 2 步才完成, --max-steps 1 必须 FAIL(step-pending) */
    {
        char *rm[] = {"rm", "-f", logp, 0};
        runv(rm, dir, 5, buf, sizeof buf, &rc);
    }
    v[12] = "--max-steps"; v[13] = "1"; v[14] = 0;
    runv(v, dir, 20, buf, sizeof buf, &rc);
    ck(rc == 1 && strstr(buf, "step-pending"), "max-steps-reached-fail");
    {
        char *rm[] = {"rm", "-f", logp, 0};
        runv(rm, dir, 5, buf, sizeof buf, &rc);
    }
    v[13] = "0";
    runv(v, dir, 20, buf, sizeof buf, &rc);
    ck(rc == 2, "max-steps-zero-rejected");
    /* 缺 --date: 取当日, 绝不是 1970-01-01 */
    {
        char *rm[] = {"rm", "-f", logp, 0};
        char *w[16];
        runv(rm, dir, 5, buf, sizeof buf, &rc);
        w[0] = "sh"; w[1] = com; w[2] = tool; w[3] = "--"; w[4] = dir; w[5] = runp;
        w[6] = "--tier"; w[7] = "commit"; w[8] = "--fake"; w[9] = fake; w[10] = 0;
        runv(w, dir, 20, buf, sizeof buf, &rc);
        ck(rc == 0 && strstr(buf, "report=") && !strstr(buf, "1970-01-01"), "date-default-today");
    }
    /* 日志截断: S9_FAKE_LONG 令假 s9 连续 PENDING 1500 步, 每步一行日志, 总量超 8000 字节 */
    {
        char *rm[] = {"rm", "-f", logp, 0};
        char *w[16];
        runv(rm, dir, 5, buf, sizeof buf, &rc);
        setenv("S9_FAKE_LONG", "80", 1);
        w[0] = "sh"; w[1] = com; w[2] = tool; w[3] = "--"; w[4] = dir; w[5] = runp;
        w[6] = "--tier"; w[7] = "commit"; w[8] = "--date"; w[9] = "2026-11-11"; w[10] = "--fake"; w[11] = fake;
        w[12] = "--max-steps"; w[13] = "200"; w[14] = 0;
        runv(w, dir, 20, buf, sizeof buf, &rc);
        ck(rc == 0 && strstr(buf, "S9_NIGHTLY\tstatus=PASS"), "truncate-exit-contract");
        {
            const char *r = strstr(buf, "\treport=");
            char rp[4400]; size_t k = 0, n; char *s;
            rp[0] = 0;
            if (r) { r += 8; while (r[k] && r[k] != '\n' && k + 1 < sizeof rp) { rp[k] = r[k]; k++; } rp[k] = 0; }
            s = k ? cx_read(rp, &n) : 0;
            ck(s && strstr(s, "truncated\t1") && strstr(s, "TRUNCATED"), "truncate-marked");
            free(s);
        }
        unsetenv("S9_FAKE_LONG");
    }
    /* 出口与 deadline: 假 s9 要求 step 带 UNISACC_BOUND_DEADLINE_MONO(缺则 rc=2, 编排 FAIL step=step) */
    {
        char *w[16];
        char *rmx[] = {"rm", "-f", logp, 0, 0, 0};
        char pa[4400], pb[4400], pc[4400];
        cx_fmt(pa, sizeof pa, "%s/a.start", runp); cx_fmt(pb, sizeof pb, "%s/a.done", runp); cx_fmt(pc, sizeof pc, "%s/b.start", runp);
        w[0] = "sh"; w[1] = com; w[2] = tool; w[3] = "--"; w[4] = dir; w[5] = runp;
        w[6] = "--tier"; w[7] = "commit"; w[8] = "--date"; w[9] = "2026-11-12"; w[10] = "--fake"; w[11] = fake; w[12] = 0;
        unsetenv("S9_FAKE_LONG");
        setenv("S9_FAKE_SLEEP", "0", 1);
        /* 无 S9_WT 行即转 aggregate(一步即出口, 状态 PASS) */
        runv(rmx, dir, 5, buf, sizeof buf, &rc);
        setenv("S9_FAKE_MODE", "nowt", 1);
        runv(w, dir, 20, buf, sizeof buf, &rc);
        {
            size_t n; char *s = cx_read(logp, &n); int steps = 0; const char *q = s;
            while (q && (q = strstr(q, "step\n"))) { steps++; q += 5; }
            ck(rc == 0 && strstr(buf, "status=PASS") && s && steps == 1 && strstr(s, "aggregate"), "no-wt-goes-aggregate");
            free(s);
        }
        /* 有 S9_WT 且 start==done: 不转 aggregate, 继续 step(第 2 步无 S9_WT 才结束) */
        runv(rmx, dir, 5, buf, sizeof buf, &rc);
        { char *r2[] = {"rm", "-f", pa, pb, pc, 0}; runv(r2, dir, 5, buf, sizeof buf, &rc); }
        setenv("S9_FAKE_MODE", "alldone", 1);
        runv(w, dir, 20, buf, sizeof buf, &rc);
        {
            size_t n; char *s = cx_read(logp, &n); int steps = 0; const char *q = s;
            while (q && (q = strstr(q, "step\n"))) { steps++; q += 5; }
            ck(rc == 0 && strstr(buf, "status=PASS") && steps == 2, "start-eq-done-with-wt-continues");
            free(s);
        }
        /* UNKNOWN: b 有 start 无 done, 对 b 调 retry 一次再 aggregate */
        runv(rmx, dir, 5, buf, sizeof buf, &rc);
        { char *r2[] = {"rm", "-f", pa, pb, pc, 0}; runv(r2, dir, 5, buf, sizeof buf, &rc); }
        setenv("S9_FAKE_MODE", "unk", 1);
        runv(w, dir, 20, buf, sizeof buf, &rc);
        {
            size_t n; char *s = cx_read(logp, &n);
            const char *r1 = s ? strstr(s, "retry") : 0;
            ck(rc == 0 && r1 && strstr(r1, " b") && !strstr(r1 + 5, "retry") && strstr(s, "aggregate"), "unknown-retry-once-then-aggregate");
            free(s);
        }
        { char *r2[] = {"rm", "-f", pa, pb, pc, 0}; runv(r2, dir, 5, buf, sizeof buf, &rc); }
        unsetenv("S9_FAKE_MODE");
    }
    printf("INFO\tcheck-s9-nightly.truncation 已单测(S9_FAKE_LONG)\n");
    printf("CHECK_S9_NIGHTLY\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
