/* tools/check-s9-nightly.cx -- 假 s9 验证编排顺序、超时与失败停止。 */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.die
static int has(const char *s, const char *p) {
    size_t n, pl, i;
    if (!s) return 0;
    n = strlen(s); pl = strlen(p);
    for (i = 0; pl && i + pl <= n; i++) if (!memcmp(s + i, p, pl)) return 1;
    return 0;
}

static int failed;
static char root[4096], why[512], report_path[4400];
static void die(const char *s) { tool_die("check-s9-nightly", s, 0, 2); }
static void ck(int ok, const char *n) {
    printf("%s\tcheck-s9-nightly.%s\n", ok ? "PASS" : "FAIL", n);
    if (!ok) failed++;
}
static int runv(char **v, const char *cwd, int sec, char *out, int cap, int *rc) {
    np_result r = {0};
    if (np_run(v, cwd, 0, sec, &r, why, sizeof why)) die(why);
    *rc = r.rc;
    if (out && cap > 0) {
        size_t n = r.outn < (size_t)(cap - 1) ? r.outn : (size_t)(cap - 1);
        if (r.out && n && mm_copy(out, cap, r.out, (long)n)) die("copy");
        out[n] = 0;
    }
    np_free(&r);
    return 0;
}

/* 模式: core(顺序/失败停止/档位) | tiers(daily/release 档透传) | limits(max-steps/日期/截断/出口/UNKNOWN) | resume | resume(--resume 4 项);无参两者都跑。各自一个批次,合并在 affected 冷编下超 55s。 */
int main(int argc, char **argv) {
    const char *am = argc == 2 ? argv[1] : "";
    int core = !*am || !strcmp(am, "core"), tiers = !*am || !strcmp(am, "tiers"), lim = !*am || !strcmp(am, "limits"), res = !*am || !strcmp(am, "resume"), ph = !*am || !strcmp(am, "phases");
    if (argc > 2 || (argc == 2 && !core && !tiers && !lim && !res && !ph)) { fprintf(stderr, "usage: [core|resume]\n"); return 2; }
    char dir[4400], fake[4400], runp[4400], outd[4400], tool[4400], com[4400], logp[4400], src[4400], buf[4000];
    char *v[16];
    int rc;
    if (sy_realpath(".", root, sizeof root) < 0) die("cwd");
    if (cx_fmt(dir, sizeof dir, "%s/s9n-XXXXXX", sy_tmpdir()) || !mkdtemp(dir)) die("tmpdir");
    if (cx_fmt(fake, sizeof fake, "%s/fake.bin", dir) ||
        cx_fmt(runp, sizeof runp, "%s/run", dir) ||
        cx_fmt(outd, sizeof outd, "%s/out", dir) ||
        cx_fmt(logp, sizeof logp, "%s/fake.log", dir) ||
        cx_fmt(src, sizeof src, "%s/tests/fixtures/s9-nightly-fake.cx", root) ||
        cx_fmt(com, sizeof com, "%s/%s", root, "unisacc" ".com") ||
        cx_fmt(tool, sizeof tool, "%s/tools/s9-nightly.cx", root)) die("fmt");
    {
        char *b[] = {"sh", com, src, "-o", fake, 0};
        runv(b, root, 20, buf, sizeof buf, &rc);
        ck(rc == 0, "fake-compile");
    }
    {
        char *mk[] = {"mkdir", "-p", outd, runp, 0};
        runv(mk, dir, 5, buf, sizeof buf, &rc);
    }
    setenv("S9_FAKE_LOG", logp, 1);
    v[0] = "sh"; v[1] = com; v[2] = tool; v[3] = "--"; v[4] = dir; v[5] = runp;
    v[6] = "--tier"; v[7] = "commit"; v[8] = "--date"; v[9] = "2026-11-10"; v[10] = "--fake"; v[11] = fake; v[12] = 0;
    if (core) {
    runv(v, dir, 20, buf, sizeof buf, &rc);
    ck(rc == 0 && strstr(buf, "S9_NIGHTLY\tstatus=PASS"), "order-pass");
    {
        const char *r = strstr(buf, "\treport=");
        size_t k = 0;
        if (r) { r += 8; while (r[k] && r[k] != '\n' && k + 1 < sizeof report_path) { report_path[k] = r[k]; k++; } }
        report_path[k] = 0;
        ck(k > 0, "report-path");
    }
    {
        size_t n; char *s = cx_read(logp, &n);
        ck(s && strstr(s, "build") && strstr(s, "init") && strstr(s, "prepare") && strstr(s, "step") && strstr(s, "aggregate"), "order-log");
        free(s);
    }
    setenv("S9_FAKE_FAIL", "driver", 1);
    {
        char *rm[] = {"rm", "-f", logp, 0};
        runv(rm, dir, 5, buf, sizeof buf, &rc);
    }
    runv(v, dir, 20, buf, sizeof buf, &rc);
    ck(rc == 1 && strstr(buf, "prepare-driver"), "fail-stop");
    {
        size_t n; char *s = cx_read(logp, &n);
        ck(s && !strstr(s, "selection"), "fail-no-later-prep");
        free(s);
    }
    unsetenv("S9_FAKE_FAIL");
    /* commit 档: init 带 --tier commit,每步耗时列存在 */
    {
        char *rm[] = {"rm", "-f", logp, 0};
        runv(rm, dir, 5, buf, sizeof buf, &rc);
    }
    runv(v, dir, 20, buf, sizeof buf, &rc);
    ck(rc == 0, "tier-commit-pass");
    {
        size_t n; char *s = cx_read(logp, &n);
        ck(s && strstr(s, "init - --tier commit"), "tier-commit-passthrough");
        free(s);
    }
    {
        char rp[4400]; size_t n; char *s;
        cx_fmt(rp, sizeof rp, "%s", report_path);
        s = cx_read(rp, &n);
        ck(has(s, "wall_ms") && has(s, "step ") && has(s, "\t") && has(s, "truncated\t0"), "wall-ms-column");
        free(s);
    }
    }
    if (tiers) {
    /* daily 档: init 不带 --tier */
    {
        char *rm[] = {"rm", "-f", logp, 0};
        runv(rm, dir, 5, buf, sizeof buf, &rc);
    }
    v[7] = "daily";
    runv(v, dir, 20, buf, sizeof buf, &rc);
    {
        size_t n; char *s = cx_read(logp, &n);
        ck(rc == 0 && s && strstr(s, "init -\n") && !strstr(s, "--tier"), "tier-daily-no-flag");
        free(s);
    }
    /* release 档: init 带 --tier release */
    {
        char *rm[] = {"rm", "-f", logp, 0};
        runv(rm, dir, 5, buf, sizeof buf, &rc);
    }
    v[7] = "release";
    runv(v, dir, 20, buf, sizeof buf, &rc);
    {
        size_t n; char *s = cx_read(logp, &n);
        ck(rc == 0 && s && strstr(s, "init - --tier release"), "tier-release-passthrough");
        free(s);
    }
    v[7] = "daily";
    }
    if (lim) {
    v[7] = "daily";
    v[7] = "commit";
    setenv("S9_FAKE_SLEEP", "3", 1);
    {
        char *rm[] = {"rm", "-f", logp, 0};
        runv(rm, dir, 5, buf, sizeof buf, &rc);
    }
    v[12] = "--step-s"; v[13] = "1"; v[14] = 0;
    runv(v, dir, 20, buf, sizeof buf, &rc);
    ck(rc == 1 && strstr(buf, "step"), "timeout-stop");
    v[12] = 0;
    setenv("S9_FAKE_SLEEP", "0", 1);
    v[7] = "daily";
    /* max-steps: 假 s9 需 2 步才完成, --max-steps 1 必须 FAIL(step-pending) */
    {
        char *rm[] = {"rm", "-f", logp, 0};
        runv(rm, dir, 5, buf, sizeof buf, &rc);
    }
    v[12] = "--max-steps"; v[13] = "1"; v[14] = 0;
    runv(v, dir, 20, buf, sizeof buf, &rc);
    ck(rc == 1 && strstr(buf, "step-pending"), "max-steps-reached-fail");
    {
        char *rm[] = {"rm", "-f", logp, 0};
        runv(rm, dir, 5, buf, sizeof buf, &rc);
    }
    v[13] = "0";
    runv(v, dir, 20, buf, sizeof buf, &rc);
    ck(rc == 2, "max-steps-zero-rejected");
    /* 缺 --date: 取当日, 绝不是 1970-01-01 */
    {
        char *rm[] = {"rm", "-f", logp, 0};
        char *w[16];
        runv(rm, dir, 5, buf, sizeof buf, &rc);
        w[0] = "sh"; w[1] = com; w[2] = tool; w[3] = "--"; w[4] = dir; w[5] = runp;
        w[6] = "--tier"; w[7] = "commit"; w[8] = "--fake"; w[9] = fake; w[10] = 0;
        runv(w, dir, 20, buf, sizeof buf, &rc);
        ck(rc == 0 && strstr(buf, "report=") && !strstr(buf, "1970-01-01"), "date-default-today");
    }
    /* 日志截断: S9_FAKE_LONG 令假 s9 连续 PENDING 1500 步, 每步一行日志, 总量超 8000 字节 */
    {
        char *rm[] = {"rm", "-f", logp, 0};
        char *w[16];
        runv(rm, dir, 5, buf, sizeof buf, &rc);
        setenv("S9_FAKE_LONG", "80", 1);
        w[0] = "sh"; w[1] = com; w[2] = tool; w[3] = "--"; w[4] = dir; w[5] = runp;
        w[6] = "--tier"; w[7] = "commit"; w[8] = "--date"; w[9] = "2026-11-11"; w[10] = "--fake"; w[11] = fake;
        w[12] = "--max-steps"; w[13] = "200"; w[14] = 0;
        runv(w, dir, 20, buf, sizeof buf, &rc);
        ck(rc == 0 && strstr(buf, "S9_NIGHTLY\tstatus=PASS"), "truncate-exit-contract");
        {
            const char *r = strstr(buf, "\treport=");
            char rp[4400]; size_t k = 0, n; char *s;
            rp[0] = 0;
            if (r) { r += 8; while (r[k] && r[k] != '\n' && k + 1 < sizeof rp) { rp[k] = r[k]; k++; } rp[k] = 0; }
            s = k ? cx_read(rp, &n) : 0;
            ck(has(s, "truncated\t1") && has(s, "TRUNCATED"), "truncate-marked");
            free(s);
        }
        unsetenv("S9_FAKE_LONG");
    }
    /* 出口与 deadline: 假 s9 要求 step 带 UNISACC_BOUND_DEADLINE_MONO(缺则 rc=2, 编排 FAIL step=step) */
    {
        char *w[16];
        char *rmx[] = {"rm", "-f", logp, 0, 0, 0};
        char pa[4400], pb[4400], pc[4400];
        cx_fmt(pa, sizeof pa, "%s/a.start", runp); cx_fmt(pb, sizeof pb, "%s/a.done", runp); cx_fmt(pc, sizeof pc, "%s/b.start", runp);
        w[0] = "sh"; w[1] = com; w[2] = tool; w[3] = "--"; w[4] = dir; w[5] = runp;
        w[6] = "--tier"; w[7] = "commit"; w[8] = "--date"; w[9] = "2026-11-12"; w[10] = "--fake"; w[11] = fake; w[12] = 0;
        unsetenv("S9_FAKE_LONG");
        setenv("S9_FAKE_SLEEP", "0", 1);
        /* 无 S9_WT 行即转 aggregate(一步即出口, 状态 PASS) */
        runv(rmx, dir, 5, buf, sizeof buf, &rc);
        setenv("S9_FAKE_MODE", "nowt", 1);
        runv(w, dir, 20, buf, sizeof buf, &rc);
        {
            size_t n; char *s = cx_read(logp, &n); int steps = 0; const char *q = s;
            while (q && (q = strstr(q, "step\n"))) { steps++; q += 5; }
            ck(rc == 0 && has(buf, "status=PASS") && s && steps == 1 && has(s, "aggregate"), "no-wt-goes-aggregate");
            free(s);
        }
        /* 有 S9_WT 且 start==done: 不转 aggregate, 继续 step(第 2 步无 S9_WT 才结束) */
        runv(rmx, dir, 5, buf, sizeof buf, &rc);
        { char *r2[] = {"rm", "-f", pa, pb, pc, 0}; runv(r2, dir, 5, buf, sizeof buf, &rc); }
        setenv("S9_FAKE_MODE", "alldone", 1);
        runv(w, dir, 20, buf, sizeof buf, &rc);
        {
            size_t n; char *s = cx_read(logp, &n); int steps = 0; const char *q = s;
            while (q && (q = strstr(q, "step\n"))) { steps++; q += 5; }
            ck(rc == 0 && strstr(buf, "status=PASS") && steps == 2, "start-eq-done-with-wt-continues");
            free(s);
        }
        /* UNKNOWN: b 有 start 无 done, 对 b 调 retry 一次再 aggregate */
        runv(rmx, dir, 5, buf, sizeof buf, &rc);
        { char *r2[] = {"rm", "-f", pa, pb, pc, 0}; runv(r2, dir, 5, buf, sizeof buf, &rc); }
        setenv("S9_FAKE_MODE", "unk", 1);
        runv(w, dir, 20, buf, sizeof buf, &rc);
        {
            size_t n; char *s = cx_read(logp, &n);
            const char *r1 = s ? strstr(s, "retry") : 0;
            ck(rc == 0 && has(r1, " b") && !has(r1 + 5, "retry") && has(s, "aggregate"), "unknown-retry-once-then-aggregate");
            free(s);
        }
        { char *r2[] = {"rm", "-f", pa, pb, pc, 0}; runv(r2, dir, 5, buf, sizeof buf, &rc); }
        unsetenv("S9_FAKE_MODE");
    }
    }
    /* --resume RUN: 沿用同一 RUN,跳过 build/init/prepare,只 step/aggregate;step 仍带自动 deadline */
    if (res) {
        char *w[16];
        char *rmx[] = {"rm", "-f", logp, 0};
        char sess[4400], rep[4400];
        size_t n; char *s;
        cx_fmt(sess, sizeof sess, "%s/session.tsv", runp);
        cx_fmt(rep, sizeof rep, "%s/s9-nightly-2026-11-13-commit-resume.md", dir);
        w[0] = "sh"; w[1] = com; w[2] = tool; w[3] = "--"; w[4] = dir; w[5] = "--resume"; w[6] = runp;
        w[7] = "--tier"; w[8] = "commit"; w[9] = "--date"; w[10] = "2026-11-13"; w[11] = "--fake"; w[12] = fake; w[13] = 0;
        { char *r2[] = {"rm", "-f", sess, 0}; runv(r2, dir, 5, buf, sizeof buf, &rc); }
        runv(rmx, dir, 5, buf, sizeof buf, &rc);
        runv(w, dir, 20, buf, sizeof buf, &rc);
        s = cx_read(logp, &n);
        ck(rc == 2 && !s, "resume-without-session-refused-no-step");
        free(s);
        if (cx_write(sess, "resume\n", 7)) die("session-write");
        runv(rmx, dir, 5, buf, sizeof buf, &rc);
        runv(w, dir, 20, buf, sizeof buf, &rc);
        s = cx_read(logp, &n);
        ck(rc == 0 && strstr(buf, "S9_NIGHTLY\tstatus=PASS") && s && strstr(s, "step") && strstr(s, "aggregate"), "resume-steps-then-aggregate");
        ck(s && !strstr(s, "build") && !strstr(s, "init") && !strstr(s, "prepare"), "resume-skips-build-init-prepare");
        free(s);
        s = cx_read(rep, &n);
        ck(s && strstr(s, "status\tPASS") && strstr(s, "resume\t"), "resume-report-separate-file-marked");
        free(s);
    }
    /* 子阶段 init|steps|aggregate(0.0.57):每次调用独立有界、可重复;steps 默认单步,PENDING=3;aggregate 分 4 片再 merge,已有片记录跳过 */
    if (ph) {
        char *w[20];
        char *rmx[] = {"rm", "-f", logp, 0};
        char sess[4400], part1[4400], rep[4400];
        size_t n; char *s;
        cx_fmt(sess, sizeof sess, "%s/session.tsv", runp);
        cx_fmt(part1, sizeof part1, "%s/agg-part-1-4", runp);
        cx_fmt(rep, sizeof rep, "%s/s9-nightly-2026-11-14-commit-steps.md", dir);
        /* init: RUN 位置参数,只 build/init/prepare */
        runv(rmx, dir, 5, buf, sizeof buf, &rc);
        w[0] = "sh"; w[1] = com; w[2] = tool; w[3] = "--"; w[4] = dir; w[5] = runp; w[6] = "--tier"; w[7] = "commit";
        w[8] = "--date"; w[9] = "2026-11-14"; w[10] = "--phase"; w[11] = "init"; w[12] = "--fake"; w[13] = fake; w[14] = 0;
        runv(w, dir, 20, buf, sizeof buf, &rc);
        s = cx_read(logp, &n);
        ck(rc == 0 && strstr(buf, "status=PREPARED"), "phase-init-prepared");
        ck(s && strstr(s, "build") && strstr(s, "init") && strstr(s, "prepare") && !strstr(s, "step") && !strstr(s, "aggregate"), "phase-init-only-prepares");
        free(s);
        /* 拒绝:steps 不带 --resume;init 带 --resume */
        w[11] = "steps";
        runv(w, dir, 20, buf, sizeof buf, &rc);
        ck(rc == 2, "phase-steps-needs-resume");
        if (cx_write(sess, "resume\n", 7)) die("session-write");
        /* steps:第 1 次 PENDING(3),第 2 次 STEPS_DONE(0);各只走一步;都不碰 aggregate */
        w[5] = "--resume"; w[4] = dir; w[6] = runp; w[7] = "--tier"; w[8] = "commit"; w[9] = "--date"; w[10] = "2026-11-14";
        w[11] = "--phase"; w[12] = "steps"; w[13] = "--fake"; w[14] = fake; w[15] = 0;
        runv(rmx, dir, 5, buf, sizeof buf, &rc);
        runv(w, dir, 20, buf, sizeof buf, &rc);
        ck(rc == 3 && strstr(buf, "status=PENDING"), "phase-steps-first-pending");
        s = cx_read(logp, &n);
        { int c = 0; if (s) for (size_t q = 0; q + 4 < n; q++) if (!strncmp(s + q, "step", 4)) c++;
          ck(c == 1 && !strstr(s, "aggregate"), "phase-steps-one-step-per-call"); }
        free(s);
        runv(w, dir, 20, buf, sizeof buf, &rc);
        ck(rc == 0 && strstr(buf, "status=STEPS_DONE"), "phase-steps-done");
        s = cx_read(rep, &n);
        ck(s && strstr(s, "status\tSTEPS_DONE"), "phase-steps-report-own-file");
        free(s);
        /* aggregate: 4 片 + merge;预先放好 1 号片记录则跳过它 */
        if (cx_write(part1, "x\n", 2)) die("part-write");
        w[12] = "aggregate";
        runv(rmx, dir, 5, buf, sizeof buf, &rc);
        runv(w, dir, 20, buf, sizeof buf, &rc);
        s = cx_read(logp, &n);
        ck(rc == 0 && strstr(buf, "status=PASS"), "phase-aggregate-pass");
        ck(s && strstr(s, "aggregate --part 0 4") && strstr(s, "aggregate --part 2 4") && strstr(s, "aggregate --part 3 4") && strstr(s, "aggregate --merge 4"), "phase-aggregate-parts-then-merge");
        ck(s && !strstr(s, "--part 1 4") && !strstr(s, "step"), "phase-aggregate-reuses-existing-part");
        free(s);
        /* aggregate.out 落盘:merge 的完整 stdout(超 4000 字节缓冲)逐字节写入 RUN/aggregate.out,s9-verdict 读它判定 */
        {
            char aggf[4400], aggo[4400], tierf[4400], btf[4400], big[9000], *got, *vv[8];
            size_t gn, w2 = 0, k;
            cx_fmt(aggf, sizeof aggf, "%s/agg.fake", dir);
            cx_fmt(aggo, sizeof aggo, "%s/aggregate.out", runp);
            cx_fmt(tierf, sizeof tierf, "%s/tier", runp);
            cx_fmt(btf, sizeof btf, "%s/batches.tsv", dir);
            w2 = (size_t)snprintf(big, sizeof big, "BATCH\ta\tPASS\treason=");
            for (k = 0; k < 5000; k++) big[w2++] = 'x';
            w2 += (size_t)snprintf(big + w2, sizeof big - w2, "\nBATCH\tb\tPASS\treason=ok\nAGGREGATE\tQUALIFIED\timplemented_batches=2\tpass=2\tfail=0\tunknown=0\tmissing=0\trefused=0\n");
            if (cx_write(aggf, big, w2) || cx_write(tierf, "all\n", 4)) die("agg-write");
            { const char *bt = "id\timplementation\tlayer\tsource\tmode\tplatform\tbudget\tmaterials\tentry\targs\tcoverage\texpect\theaders\ttier\n"
                               "a\tIMPLEMENTED\tc\ts\tSOURCE\tl\t55\t-\te\t-\tx\tr\tp\tdaily\nb\tIMPLEMENTED\tc\ts\tSOURCE\tl\t55\t-\te\t-\tx\tr\tp\trelease\n";
              if (cx_write(btf, bt, strlen(bt))) die("bt-write"); }
            setenv("S9_FAKE_AGG_FILE", aggf, 1);
            runv(rmx, dir, 5, buf, sizeof buf, &rc);
            { char *rm2[] = {"rm", "-f", aggo, 0}; runv(rm2, dir, 5, buf, sizeof buf, &rc); }
            runv(w, dir, 20, buf, sizeof buf, &rc);
            ck(rc == 0 && strstr(buf, "status=PASS"), "aggout-phase-exit0-stdout-kept");
            got = cx_read(aggo, &gn);
            ck(got != 0, "aggout-file-exists");
            ck(got && gn == w2 && !memcmp(got, big, w2), "aggout-bytes-identical-beyond-4000");
            free(got);
            vv[0] = "sh"; vv[1] = com; vv[2] = "tools/s9-verdict.cx"; vv[3] = "--"; vv[4] = runp; vv[5] = "--batches"; vv[6] = btf; vv[7] = 0;
            runv(vv, root, 30, buf, sizeof buf, &rc);
            ck(rc == 0 && strstr(buf, "4\tPASS\t") && strstr(buf, "aggregate.out"), "aggout-verdict-reads-it-pass");
            /* 无 AGGREGATE 行的输出同样原样落盘,verdict 给 UNKNOWN */
            { const char *two = "BATCH\ta\tPASS\treason=ok\nBATCH\tb\tPASS\treason=ok\n";
              cx_write(aggf, two, strlen(two));
              runv(w, dir, 20, buf, sizeof buf, &rc);
              got = cx_read(aggo, &gn);
              ck(got && gn == strlen(two) && !memcmp(got, two, gn), "aggout-overwritten-second-run");
              free(got);
              runv(vv, root, 30, buf, sizeof buf, &rc);
              ck(strstr(buf, "4\tUNKNOWN\t") != 0, "aggout-verdict-unknown-without-aggregate-line"); }
            unsetenv("S9_FAKE_AGG_FILE");
        }
    }
    printf("INFO\tcheck-s9-nightly.truncation 已单测(S9_FAKE_LONG)\n");
    printf("CHECK_S9_NIGHTLY\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
