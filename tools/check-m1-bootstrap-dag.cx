/* tools/check-m1-bootstrap-dag.cx -- G2 bootstrap embed & Q-07 identity red-first check.
 *
 *   sh ./unisacc.com tools/check-m1-bootstrap-dag.cx --
 *
 * Verifies:
 *   (1) release-build p3 --embed-tape DIR injects the 3 deterministic tape/lnx-x86_64/* F records
 *       (codec=0, rawlen==len, real IEEE CRC32) into the single sealed P4 package without touching
 *       coexisting non-tape resources;
 *   (2) Fail-closed refusals: missing one tape file, manifest SHA mismatch, and P3 downgrade
 *       (--no-compress-resources on P3 source) are all refused non-zero;
 *   (3) Q-07 release-packcheck ape passes PACK_APE SAME when release-pack replays the identical
 *       chain-sealed package/APE and refuses PACK_APE_CHANGED if 1 byte is mutated at the tail.
 * Marker: CHECK_M1_BOOTSTRAP_DAG. */
#pragma unisa use runtime.packagefooter
#pragma unisa use runtime.package_decode
#pragma unisa use runtime.package_lifetime
#pragma unisa use runtime.model_number
#pragma unisa use compiler.bindstage
#pragma unisa use runtime.routestep
#pragma unisa use runtime.codec
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.posix
#pragma unisa use sys.proc
#pragma unisa use sys.sha
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use cxlib.netpack

static int failed;
static void ck(int ok, const char *name) {
    if (!ok) { sy_eprintf("FAIL\tm1-g2.%s\n", name); failed++; }
    else sy_printf("PASS\tm1-g2.%s\n", name);
}
static void *pk_alloc(void *prev, size_t n) { (void)prev; return mm_alloc((long)(n ? n : 1)); }
static void pk_free(void *p) { if (p) mm_free(p); }
static unsigned crc32_of(const char *p, int n) {
    CxCodecCrc c; uint32_t out = 0;
    if (cxcodec_crc_init(&c) || cxcodec_crc(&c, p, n, &out)) return 0;
    return out;
}
static int run_cmd(char **v, char *out, long cap) {
    np_result r = {0}; char why[128] = {0};
    int tr = np_run(v, 0, 0, 40, &r, why, sizeof why);
    long n = 0;
    if (r.out && r.outn > 0) {
        long m = (long)r.outn < cap - 1 ? (long)r.outn : cap - 1;
        for (long i = 0; i < m; i++) out[n++] = r.out[i];
    }
    if (r.err && r.errn > 0 && n < cap - 1) {
        long m = (long)r.errn < (cap - 1 - n) ? (long)r.errn : (cap - 1 - n);
        for (long i = 0; i < m; i++) out[n++] = r.err[i];
    }
    out[n] = 0;
    int rc = (tr || r.residue) ? -1 : r.rc;
    np_free(&r);
    return rc;
}

int main(void) {
    char tmp[512], fxroot[600], inc[640], tdir[640], tbad[640], p[700];
    char src_p3[640], out_p4[640], out_bad[640], ape_a[640], ape_b[640], out[16384];
    char so_sha[65], sl_sha[65], mf[512];
    const char *so_body = "ELF-fake-tapemode-body-g2";
    const char *sl_body = "UTAPEBIN-fake-m53-body-g2";
    const char *flat_body = "/* fixture cx-flat.h */\n";
    const char *bare_p3 = "P 3 1 1 1\nD r s in out 0\nM 1 1 1 0\nAF 4 5\nkeephello";
    if (sy_mkdtemp(sy_tmpdir(), "m1-g2-", tmp, sizeof tmp) != 0) return 2;
    if (cx_fmt(fxroot, sizeof fxroot, "%s/root", tmp) ||
        cx_fmt(inc, sizeof inc, "%s/include", fxroot) ||
        cx_fmt(tdir, sizeof tdir, "%s/tape-ok", tmp) ||
        cx_fmt(tbad, sizeof tbad, "%s/tape-bad", tmp) ||
        cx_fmt(src_p3, sizeof src_p3, "%s/src.p3", tmp) ||
        cx_fmt(out_p4, sizeof out_p4, "%s/out.p4", tmp) ||
        cx_fmt(out_bad, sizeof out_bad, "%s/out.bad", tmp) ||
        cx_fmt(ape_a, sizeof ape_a, "%s/chain.ape", tmp) ||
        cx_fmt(ape_b, sizeof ape_b, "%s/packed.ape", tmp)) return 2;
    if (sy_mkdir_all(inc, 0755) || sy_mkdir_all(tdir, 0755) || sy_mkdir_all(tbad, 0755)) return 2;
    if (cx_fmt(p, sizeof p, "%s/cx-flat.h", inc) || cx_write(p, flat_body, (size_t)tx_len(flat_body, 128))) return 2;
    if (cx_write(src_p3, bare_p3, (size_t)tx_len(bare_p3, 256))) return 2;

    (void)sy_sha256_hex(so_body, tx_len(so_body, 128), so_sha);
    (void)sy_sha256_hex(sl_body, tx_len(sl_body, 128), sl_sha);
    if (cx_fmt(mf, sizeof mf, "tapemode.so\t%s\t%ld\nm53.tapeslice\t%s\t%ld\n",
               so_sha, tx_len(so_body, 128), sl_sha, tx_len(sl_body, 128))) return 2;
    if (cx_fmt(p, sizeof p, "%s/manifest.tsv", tdir) || cx_write(p, mf, (size_t)tx_len(mf, sizeof mf))) return 2;
    if (cx_fmt(p, sizeof p, "%s/tapemode.so", tdir) || cx_write(p, so_body, (size_t)tx_len(so_body, 128))) return 2;
    if (cx_fmt(p, sizeof p, "%s/m53.tapeslice", tdir) || cx_write(p, sl_body, (size_t)tx_len(sl_body, 128))) return 2;

    /* (1) Positive: release-build p3 --embed-tape injects all 3 records with codec=0 and real IEEE CRC32 */
    {
        char *v[] = {"sh", "./unisacc.com", "tools/release-build.cx", "--",
                     "p3", fxroot, src_p3, out_p4, "--embed-tape", tdir, 0};
        int rc = run_cmd(v, out, sizeof out);
        size_t zn = 0; char *blob = cx_read(out_p4, &zn);
        PackageFooter pf; CxPackageDecode dec; int ok = 0;
        if (rc == 0 && blob && packagefooter_locate_bytes((const unsigned char *)blob, (long)zn, &pf)) {
            mm_fill(&dec, (long)sizeof dec, 0, (long)sizeof dec);
            dec.allocate = pk_alloc; dec.release = pk_free;
            if (cxpk_decode(&dec, (const unsigned char *)blob + pf.package_offset, pf.package_length) == 0 &&
                dec.package.ver == 4) {
                static const char *keys[3] = {
                    "tape/lnx-x86_64/manifest.tsv",
                    "tape/lnx-x86_64/tapemode.so",
                    "tape/lnx-x86_64/m53.tapeslice"
                };
                int hits = 0, keep_ok = 0;
                const unsigned char *pb = (const unsigned char *)blob + pf.package_offset;
                for (int i = 0; i < dec.package.nr; i++) {
                    const CxPackageResource *r = &dec.package.res[i];
                    if (r->n == 4 && tx_same((const char *)(pb + r->name), 4, "keep", 4)) keep_ok = 1;
                    for (int k = 0; k < 3; k++) {
                        long kl = tx_len(keys[k], 64);
                        if (r->n == (int)kl && tx_same((const char *)(pb + r->name), r->n, keys[k], kl)) {
                            unsigned want = crc32_of((const char *)(pb + r->data), r->len);
                            if (r->codec == 0 && r->rawlen == r->len && r->len > 0 && r->crc == want) hits++;
                        }
                    }
                }
                ok = (hits == 3 && keep_ok == 1);
                cxpl_release(&dec.package, pk_free);
            }
        }
        if (blob) mm_free(blob);
        ck(ok, "T2-p3-embed-tape-3-records-crc32-and-keep");
    }

    /* (2a) Fail-closed: missing m53.tapeslice in --embed-tape dir refused */
    if (cx_fmt(p, sizeof p, "%s/manifest.tsv", tbad) || cx_write(p, mf, (size_t)tx_len(mf, sizeof mf))) return 2;
    if (cx_fmt(p, sizeof p, "%s/tapemode.so", tbad) || cx_write(p, so_body, (size_t)tx_len(so_body, 128))) return 2;
    {
        char *v[] = {"sh", "./unisacc.com", "tools/release-build.cx", "--",
                     "p3", fxroot, src_p3, out_bad, "--embed-tape", tbad, 0};
        int rc = run_cmd(v, out, sizeof out);
        ck(rc != 0 && strstr(out, "embed-tape") != 0, "T2-refuse-incomplete-embed-dir");
    }

    /* (2b) Fail-closed: manifest sha mismatch refused */
    if (cx_fmt(p, sizeof p, "%s/m53.tapeslice", tbad) || cx_write(p, "tampered-slice", 14)) return 2;
    {
        char *v[] = {"sh", "./unisacc.com", "tools/release-build.cx", "--",
                     "p3", fxroot, src_p3, out_bad, "--embed-tape", tbad, 0};
        int rc = run_cmd(v, out, sizeof out);
        ck(rc != 0 && strstr(out, "manifest sha/size mismatch") != 0, "T2-refuse-manifest-mismatch");
    }

    /* (2c) Fail-closed: --no-compress-resources (P3 output) with --embed-tape refused */
    {
        char *v[] = {"sh", "./unisacc.com", "tools/release-build.cx", "--",
                     "p3", fxroot, src_p3, out_bad, "--no-compress-resources", "--embed-tape", tdir, 0};
        int rc = run_cmd(v, out, sizeof out);
        ck(rc != 0 && strstr(out, "embed-tape requires P4") != 0, "T2-refuse-p3-downgrade");
    }

    /* (3) Q-07: release-packcheck ape SAME on identical replay, REFUSE PACK_APE_CHANGED on 1-byte mutation */
    {
        size_t zn = 0; char *b = cx_read(out_p4, &zn);
        int ok1 = 0, ok2 = 0;
        if (b && zn > 16 && cx_write(ape_a, b, zn) == 0 && cx_write(ape_b, b, zn) == 0) {
            char *v1[] = {"sh", "./unisacc.com", "tools/release-packcheck.cx", "--", "ape", ape_a, ape_b, 0};
            int rc1 = run_cmd(v1, out, sizeof out);
            ok1 = (rc1 == 0 && strstr(out, "PACK_APE\tSAME\t") != 0);
            b[0] ^= 1;
            if (cx_write(ape_b, b, zn) == 0) {
                int rc2 = run_cmd(v1, out, sizeof out);
                ok2 = (rc2 != 0 && strstr(out, "PACK_APE_CHANGED") != 0);
            }
        }
        if (b) mm_free(b);
        ck(ok1, "T2b-q07-identical-replay-same");
        ck(ok2, "T2b-M2b-mutated-tail-pack-refused");
    }

    (void)sy_remove_all(tmp);
    sy_printf("CHECK_M1_BOOTSTRAP_DAG\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
