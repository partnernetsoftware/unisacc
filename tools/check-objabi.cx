/* tools/check-objabi.cx -- object ABI contract of `-c -funit` units linked by gcc (0.0.80 F1a, 0.0.81 arm64).
 *
 *   sh ./unisacc.com tools/check-objabi.cx -- --product CANDIDATE.com
 *
 * Each case writes a unit and a gcc main into a private session directory (sr_default under
 * sy_tmpdir), compiles the unit with `sh CANDIDATE -c -funit unit.c -o unit.o`, compiles the main with
 * gcc -c, links with gcc -no-pie and runs the program; every child is bounded (compile and link 30 s,
 * run 10 s).  Cases and expectations (lnx/x86_64):
 *   p03     int x=5; const int k=32; main returns getx()*10+(getk()==32): rc 51 (F1 .init_array).
 *   multi   two -funit units (p03 and q: int y=3) in one link: no multiple definition of __init_u;
 *           main returns getx()*10+(getk()==32)+gety()-3: rc 51.
 *   p02c    add_one(0) with add_one(v)=v+11: rc 11 (F2 SysV entry).
 *   p2arg   add2(30,12) with add2(a,b)=a+b: rc 42; p3arg mix3(1,2,3)-100 with a*100+b*10+c: rc 23 (F2).
 *   p07     weak weak_hook (returns 1) linked with a strong one (returns 7): rc 7.  Known gap until
 *           F3 (STB_WEAK): EXPECT-FAIL.
 *   symtype the unit.o of p03 holds __init_u as a FUNC symbol (readelf -sW; 0.0.81, was NOTYPE).
 * The lnx/arm64 cases (0.0.81) compile the unit with --target=lnx/arm64, the main with
 * aarch64-linux-gnu-gcc, link -static and run under qemu-aarch64-static (PATH or ~/.local/bin):
 *   a-p03 a-multi a-p02c a-p2arg a-p3arg as above, a-initonly (main does nothing, only .init_array runs:
 *   rc 9), a-plain int f7(void): rc 7, a-hsub3 unit calls a gcc function with three arguments: rc 82,
 *   a-stack the gcc callee works on sp-relative locals (sp must be 16-byte aligned, AAPCS64): rc 43,
 *   a-symtype __init_u FUNC in the arm64 unit.o.
 *   a-sigalrm (OBJABI-ARM64-X7-STACK-BELOW-SP-SIGNAL): the unit keeps return addresses and locals on its x7
 *   stack while a 1 ms SIGALRM with a handler interrupts it; five runs must equal the quiet run: rc 0
 *   (0.0.81: SIGSEGV rc 139, the signal frame landed on the x7 stack below sp).
 *   a-sigovf: a unit recursion deeper than the reserved x7 block must stop with the fixed refusal
 *   brk #0xf7 (SIGTRAP, reported rc=-5), never SIGSEGV (0.0.81: rc=-11).
 *   a-icall: a static, a global and a 100-deep recursive unit-internal call, all guarded, return normally: rc 111.
 *   a-deep: 5000-deep static and global small-frame recursion and 20 frames of 8 KB fit the 1 MB block: rc 7.
 *   a-branchsense: same objdump; before every brk #0xf7 sits cmp x16, x7 and the word 54000043 (b.lo +8).
 *   a-calleesaved: objdump -d of the a-sigalrm unit.o, operand column only (address and code columns
 *   dropped, so "d8:" is not a hit): no x19-x28, w19-w28, d8-d15, s8-s15.
 *   a-x16free: same objdump; at least one ustk guard, and after every brk #0xf7 the first x16/w16 mention within
 *   64 instructions (or before ret) is a write, so the guard's add x16 clobbers no live value.
 *   a-bigframe EXPECT-FAIL (OBJABI-ARM64-X7-LARGE-FRAME-SKIPS-GUARD): a 2 MB frame (single frame larger than the 1 MB block) skips the 4 KB margin check
 *   and runs past the block instead of the fixed refusal (rc is whatever the overrun leaves, observed 3 or 7; want -5).
 * An arm64 tool missing prints CHECK_OBJABI_ARM64 UNMEASURED and the check exits 3 (never PASS) unless
 * something failed (exit 1).
 * An EXPECT-FAIL case that passes is reported as XPASS and counted as failed, so the expectation
 * list must be updated when F2 or F3 lands.  Prints one line per case
 *   CASE name PASS|FAIL|EXPECT-FAIL|XPASS rc=got/want [stage=...]
 * and the last line CHECK_OBJABI failed=N expect_fail=M; exit 0 only when failed=0.
 * No gcc on PATH: prints CHECK_OBJABI UNMEASURED no-gcc and exits 3, so a batch never records PASS
 * without running. */
#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use text.text
#pragma unisa use cxlib.procrun
#pragma unisa use cxlib.sessionroot

typedef struct oa_case {
    const char *name;
    const char *unit;
    const char *unit2;
    const char *strong;
    const char *main;
    int want;
    int expect_fail;
} oa_case;

#define OA_P03 "int x=5;\nconst int k=32;\nint getx(void){return x;}\nint getk(void){return k;}\n"
#define OA_P03M "int getx(void);int getk(void);int main(void){return getx()*10+(getk()==32);}\n"
#define OA_Q "int y=3;\nint gety(void){return y;}\n"
#define OA_QM "int getx(void);int getk(void);int gety(void);int main(void){return getx()*10+(getk()==32)+gety()-3;}\n"
#define OA_HSUB "int hsub(int a,int b,int c);\nint call3(void){return hsub(50,7,2)+1;}\n"
#define OA_HSUBS "int hsub(int a,int b,int c){return a*6+b*5+c;}\n"
#define OA_HSUBM "int call3(void);int main(void){return call3();}\n"
#define OA_SIGU "static long mixr(long a,long b,long c,long d){long v[8];v[0]=a;v[1]=b;v[2]=c;v[3]=d;v[4]=a^b;v[5]=c+d;v[6]=a-c;v[7]=b*3;return v[0]+v[1]*2+v[2]*3+v[3]*5+v[4]+v[5]+v[6]+v[7];}\n" \
    "long work(long n){long s=0;long i=0;while(i<n){long t[16];int k=0;while(k<16){t[k]=i+k;k=k+1;}k=0;while(k<16){s=s+mixr(t[k],i,k,s&255)%1000;k=k+1;}i=i+1;}return s;}\n"
#define OA_SIGM "#include <signal.h>\n#include <string.h>\n#include <sys/time.h>\nlong work(long);\nvolatile long hits;\n" \
    "static void h(int s){(void)s;hits++;}\n" \
    "int main(void){long n=60000;long r0=work(n);struct sigaction sa;memset(&sa,0,sizeof sa);sa.sa_handler=h;sigaction(SIGALRM,&sa,0);\n" \
    "struct itimerval it={{0,1000},{0,1000}};setitimer(ITIMER_REAL,&it,0);int bad=0;int k;for(k=0;k<5;k++){if(work(n)!=r0)bad++;}\n" \
    "struct itimerval z;memset(&z,0,sizeof z);setitimer(ITIMER_REAL,&z,0);return bad?1:(hits>0?0:2);}\n"
#define OA_OVFU "long rec(long n){volatile long pad[32];pad[0]=n;pad[31]=n&7;if(n<=0)return 0;return rec(n-1)+pad[0]%3+pad[31];}\n" \
    "long deep(void){return rec(200000);}\n"
#define OA_OVFM "long deep(void);int main(void){return deep()==7?3:4;}\n"

static const oa_case oa_cases[11] = {
    {"p03", OA_P03, 0, 0, OA_P03M, 51, 0},
    {"multi", OA_P03, OA_Q, 0, OA_QM, 51, 0},
    {"p02c", "int add_one(int v){return v+11;}\n", 0, 0,
     "int add_one(int);int main(void){return add_one(0);}\n", 11, 0},
    {"p2arg", "int add2(int a,int b){return a+b;}\n", 0, 0,
     "int add2(int,int);int main(void){return add2(30,12);}\n", 42, 0},
    {"p3arg", "int mix3(int a,int b,int c){return a*100+b*10+c;}\n", 0, 0,
     "int mix3(int,int,int);int main(void){return mix3(1,2,3)-100;}\n", 23, 0},
    {"p07", "__attribute__((weak)) int weak_hook(void){return 1;}\n", 0,
     "int weak_hook(void){return 7;}\n",
     "int weak_hook(void);int main(void){return weak_hook();}\n", 7, 1},
    {"ext0sse", "int ext0(void);\nint call0(void){return ext0()+1;}\n", 0,
     "typedef float v4 __attribute__((vector_size(16)));\nint ext0(void){volatile v4 x={1,2,3,4};return (int)x[3]+38;}\n",
     "int call0(void);int main(void){return call0();}\n", 43, 0},
    {"hsub3", OA_HSUB, 0, OA_HSUBS, OA_HSUBM, 82, 0},
    {"XL-args7", "int s7(int,int,int,int,int,int,int);\nint call7(void){return s7(1,2,3,4,5,6,7);}\n", 0,
     "int s7(int a,int b,int c,int d,int e,int f,int g){return a+b+c+d+e+f+g;}\n",
     "int call7(void);int main(void){return call7();}\n", 28, 1},
    {"XL-float", "double fd(double);\nint callf(void){return (int)fd(1.5);}\n", 0,
     "double fd(double x){return x*2;}\n",
     "int callf(void);int main(void){return callf();}\n", 3, 1},
    {"XL-qsortcb", "void qsort(void*,unsigned long,unsigned long,int(*)(const void*,const void*));\nint cmpi(const void*a,const void*b){return *(const int*)a-*(const int*)b;}\nint sortit(void){int v[3]={3,1,2};qsort(v,3,4,cmpi);return v[0]*100+v[1]*10+v[2];}\n", 0, 0,
     "int sortit(void);int main(void){return sortit();}\n", 123, 1},
};

/* lnx/arm64: a-stack's callee keeps its locals at [sp, #..]; the callee asserts frame_address(0)&15==0 (qemu-user does not raise SIGBUS on a misaligned sp) */
static const oa_case oa_arm_cases[14] = {
    {"a-p03", OA_P03, 0, 0, OA_P03M, 51, 0},
    {"a-multi", OA_P03, OA_Q, 0, OA_QM, 51, 0},
    {"a-initonly", "int z=9;\nint getz(void){return z;}\n", 0, 0,
     "int getz(void);int main(void){return 9;}\n", 9, 0},
    {"a-plain", "int f7(void){return 7;}\n", 0, 0,
     "int f7(void);int main(void){return f7();}\n", 7, 0},
    {"a-p02c", "int add_one(int v){return v+11;}\n", 0, 0,
     "int add_one(int);int main(void){return add_one(0);}\n", 11, 0},
    {"a-p2arg", "int add2(int a,int b){return a+b;}\n", 0, 0,
     "int add2(int,int);int main(void){return add2(30,12);}\n", 42, 0},
    {"a-p3arg", "int mix3(int a,int b,int c){return a*100+b*10+c;}\n", 0, 0,
     "int mix3(int,int,int);int main(void){return mix3(1,2,3)-100;}\n", 23, 0},
    {"a-hsub3", OA_HSUB, 0, OA_HSUBS, OA_HSUBM, 82, 0},
    {"a-stack", "int ext0(int a);\nint call0(void){return ext0(5)+1;}\n", 0,
     "int ext0(int a){volatile long double d=2;volatile long v[4]={a,1,2,3};long *p=(long*)__builtin_frame_address(0);return (((long)p&15)==0)*30+(int)v[0]+(int)d+(int)v[3]+2;}\n",
     "int call0(void);int main(void){return call0();}\n", 43, 0},
    {"a-sigalrm", OA_SIGU, 0, 0, OA_SIGM, 0, 0},
    {"a-sigovf", OA_OVFU, 0, 0, OA_OVFM, -5, 0},
    /* a-icall: guarded unit-internal calls inside the block must not trap (a static, a global and a 100-deep
       recursion): rc 7+4+100 = 111.  Red on a guard whose branch sense is inverted (every call hit brk, rc -5). */
    {"a-icall", "static long s4(long n){return n+4;}\nlong g7(void){return 7;}\nlong r(long n){if(n<=0)return 0;return r(n-1)+1;}\nlong ic(void){return s4(g7())+r(100);}\n", 0, 0,
     "long ic(void);int main(void){return (int)ic();}\n", 111, 0},
    /* a-deep: capacity of the 1 MB block (RES_4K 256): 5000-deep small-frame recursion through a static and through a
       global function, and a 20-deep recursion of 8 KB frames, all return normally: rc 1+2+4 = 7 (gcc and 0.0.81 give
       7; red with the first 64 KB block, rc -5) */
    {"a-deep", "static long sr(long n){if(n<=0)return 0;return sr(n-1)+1;}\nlong gr(long n){if(n<=0)return 0;return gr(n-1)+1;}\n"
     "long fr(long n){volatile long b[1024];b[0]=n;b[1023]=n;if(n<=0)return 0;return fr(n-1)+b[0]-b[1023]+1;}\n"
     "long deep3(void){return (sr(5000)==5000)+(gr(5000)==5000)*2+(fr(20)==20)*4;}\n", 0, 0,
     "long deep3(void);int main(void){return (int)deep3();}\n", 7, 0},
    /* OBJABI-ARM64-X7-LARGE-FRAME-SKIPS-GUARD (known limit, 0.0.83): one 2 MB frame (larger than the whole 1 MB block)
       passes the fixed 4 KB margin check at the block top and writes past the block; the wanted fixed refusal (-5) does not happen */
    {"a-bigframe", "long big(long n){volatile long a[262144];a[0]=n;a[262143]=n+1;return a[0]+a[16383];}\nlong callbig(void){return big(3);}\n", 0, 0,
     "long callbig(void);int main(void){return (int)callbig();}\n", -5, 1},
};

static char oa_dir[2048];
static int oa_arm;                 /* 1 while the arm64 cases run */
static char oa_qemu[2300];

static int oa_put(const char *name, const char *text) {
    char path[2300];
    if (cx_fmt(path, sizeof path, "%s/%s", oa_dir, name)) return -1;
    return sy_write_file(path, text, (int64_t)strlen(text), 0644) ? -1 : 0;
}

static int oa_run_out(const char *label, char *const argv[], int secs, int *rc, char *why, int wcap,
                      char *out, int ocap) {
    pr_result r;
    int t = pr_run(label, argv, oa_dir[0] ? oa_dir : 0, 0, secs, &r);
    if (t) { if (cx_fmt(why, wcap, "%s", r.why)) why[0] = 0; pr_free(&r); return -1; }
    *rc = r.rc;
    why[0] = 0;
    if (r.rc && r.errn) { if (cx_fmt(why, wcap, "%.200s", r.err)) why[0] = 0; }
    if (out) {
        int n = r.out ? (int)r.outn : 0;
        if (n > ocap - 1) n = ocap - 1;
        { int k; for (k = 0; k < n; k++) out[k] = r.out[k]; }
        out[n > 0 ? n : 0] = 0;
    }
    pr_free(&r);
    {
        int i;
        for (i = 0; why[i]; i++) if (why[i] == '\n' || why[i] == '\t') why[i] = ' ';
    }
    return 0;
}

static int oa_run(const char *label, char *const argv[], int secs, int *rc, char *why, int wcap) {
    return oa_run_out(label, argv, secs, rc, why, wcap, 0, 0);
}

static int oa_stage(char *stage, const char *s) {
    if (cx_fmt(stage, 64, "%s", s)) stage[0] = 0;
    return -1;
}

static const char *oa_gcc(void) { return oa_arm ? "aarch64-linux-gnu-gcc" : "gcc"; }

static int oa_unit(const char *product, const char *src, const char *obj, char *stage, char *why) {
    int rc = 0;
    char *av[] = {"sh", (char *)product, "-c", "-funit", (char *)src, "-o", (char *)obj, 0};
    char *aa[] = {"sh", (char *)product, "--target=lnx/arm64", "-c", "-funit", (char *)src, "-o", (char *)obj, 0};
    if (oa_run("unisacc-c", oa_arm ? aa : av, 30, &rc, why, 512) || rc) return oa_stage(stage, "unisacc-c");
    return 0;
}

/* -1 when a stage failed (stage named), else 0 and the program exit code in *got. */
static int oa_case_run(const char *product, const oa_case *c, int *got, char *stage, char *why) {
    int rc = 0;
    stage[0] = 0; why[0] = 0;
    if (oa_put("unit.c", c->unit) || oa_put("main.c", c->main)) return oa_stage(stage, "write");
    if (oa_unit(product, "unit.c", "unit.o", stage, why)) return -1;
    if (c->unit2) {
        if (oa_put("unit2.c", c->unit2)) return oa_stage(stage, "write");
        if (oa_unit(product, "unit2.c", "unit2.o", stage, why)) return -1;
    }
    if (c->strong) {
        char *av[] = {(char *)oa_gcc(), "-c", "strong.c", "-o", "strong.o", 0};
        if (oa_put("strong.c", c->strong)) return oa_stage(stage, "write");
        if (oa_run("gcc-strong", av, 30, &rc, why, 512) || rc) return oa_stage(stage, "gcc-strong");
    }
    {
        char *av[] = {(char *)oa_gcc(), "-c", "main.c", "-o", "main.o", 0};
        if (oa_run("gcc-main", av, 30, &rc, why, 512) || rc) return oa_stage(stage, "gcc-main");
    }
    {
        char *av[8];
        int n = 0;
        av[n++] = (char *)oa_gcc(); av[n++] = oa_arm ? "-static" : "-no-pie"; av[n++] = "-o"; av[n++] = "prog";
        av[n++] = "main.o"; av[n++] = "unit.o";
        if (c->unit2) av[n++] = "unit2.o";
        else if (c->strong) av[n++] = "strong.o";
        av[n] = 0;
        if (oa_run("gcc-link", av, 30, &rc, why, 512) || rc) return oa_stage(stage, "link");
    }
    {
        char *av[] = {"./prog", 0};
        char *aq[] = {oa_qemu, "./prog", 0};
        if (oa_run("run", oa_arm ? aq : av, 10, &rc, why, 512)) return oa_stage(stage, "run");
        *got = rc;
    }
    return 0;
}

/* 1 when readelf -sW unit.o shows __init_u as FUNC, 0 when it shows another type, -1 when it could not tell */
static int oa_symtype(char *why) {
    static char out[65536];
    char *av[] = {"readelf", "-sW", "unit.o", 0};
    int rc = 0;
    char *p, *e;
    if (oa_run_out("readelf", av, 10, &rc, why, 512, out, sizeof out) || rc) return -1;
    for (p = out; *p; p = e) {
        e = p;
        while (*e && *e != '\n') e++;
        {
            char line[512];
            int n = (int)(e - p);
            if (n > 511) n = 511;
            { int k; for (k = 0; k < n; k++) line[k] = p[k]; }
            line[n] = 0;
            if (strstr(line, " __init_u") && !strstr(line, "__init_u.")) {
                if (cx_fmt(why, 512, "%.200s", line)) why[0] = 0;
                return strstr(line, " FUNC ") ? 1 : 0;
            }
        }
        if (*e) e++;
    }
    if (cx_fmt(why, 512, "no __init_u symbol")) why[0] = 0;
    return -1;
}

static int oa_one(const char *abs, const oa_case *c, int *failed, int *xfail) {
    char why[600], stage[64];
    int got = -1000;
    int t = oa_case_run(abs, c, &got, stage, why);
    int pass = !t && got == c->want;
    const char *verdict = pass ? (c->expect_fail ? "XPASS" : "PASS") : (c->expect_fail ? "EXPECT-FAIL" : "FAIL");
    if (t) printf("CASE %s %s rc=-/%d stage=%s %s\n", c->name, verdict, c->want, stage, why);
    else printf("CASE %s %s rc=%d/%d\n", c->name, verdict, got, c->want);
    if (pass ? c->expect_fail : !c->expect_fail) (*failed)++;
    else if (!pass) (*xfail)++;
    return 0;
}

static int oa_isword(char ch) {
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_';
}

/* 1 when the operand text holds a callee-saved register token x19-x28 w19-w28 d8-d15 s8-s15 (copied into hit) */
static int oa_csreg(const char *ops, char *hit, int hcap) {
    int i;
    for (i = 0; ops[i]; i++) {
        char c = ops[i];
        int n = 0, j = i + 1, lo, hi;
        if ((c != 'x' && c != 'w' && c != 'd' && c != 's') || (i > 0 && oa_isword(ops[i - 1]))) continue;
        if (ops[j] < '0' || ops[j] > '9') continue;
        while (ops[j] >= '0' && ops[j] <= '9' && n < 1000) { n = n * 10 + (ops[j] - '0'); j++; }
        if (oa_isword(ops[j])) continue;
        lo = (c == 'x' || c == 'w') ? 19 : 8;
        hi = (c == 'x' || c == 'w') ? 28 : 15;
        if (n >= lo && n <= hi) {
            if (cx_fmt(hit, hcap, "%c%d", c, n)) hit[0] = 0;
            return 1;
        }
    }
    return 0;
}

/* x16 liveness at each ustk guard (add x16,sp,..; cmp x16,x7; b.lo; brk #0xf7): x16 holds no live value across
   the guard when, scanning from the instruction before the guard backwards nothing matters, and forwards from the
   brk the first x16 mention is a write (destination operand of a non-store, non-compare instruction).  ops[i] is
   the text after the second tab of instruction i. */
static int oa_x16_reads_first(char ops[][96], int n, int from) {
    int i;
    for (i = from; i < n && i < from + 64; i++) {
        const char *o = ops[i];
        const char *p = o;
        int w = 0;
        while (*p && *p != '\t' && *p != ' ') p++;
        while (*p == '\t' || *p == ' ') p++;
        if (!strstr(o, "x16") && !strstr(o, "w16")) { if (tx_eqz(o, "ret")) return 0; continue; }
        if ((p[0] == 'x' || p[0] == 'w') && p[1] == '1' && p[2] == '6' && !oa_isword(p[3]) &&
            strncmp(o, "str", 3) && strncmp(o, "stp", 3) && strncmp(o, "cmp", 3) && strncmp(o, "cmn", 3) &&
            strncmp(o, "tst", 3) && strncmp(o, "cb", 2) && strncmp(o, "tb", 2) && strncmp(o, "br", 2) &&
            strncmp(o, "blr", 3)) w = 1;
        {   /* a write that also reads x16 (add x16, x16, ..) counts as a read */
            const char *q = p + 3;
            if (w && (strstr(q, "x16") || strstr(q, "w16"))) w = 0;
        }
        return w ? 0 : 1;
    }
    return 0;
}

/* objdump -d unit.o; each instruction line is ADDR:<TAB>CODE<TAB>MNEMONIC<TAB>OPERANDS; only the part after the
   second tab is scanned */
static char oa_ops[8192][96];
static char oa_code[8192][12];     /* the code column (instruction word as objdump prints it) of the same line */
static int oa_calleesaved(const char *abs, int *failed) {
    static char out[1 << 20];
    char why[600], stage[64], hit[16], line[512];
    char *av[] = {"aarch64-linux-gnu-objdump", "-d", "unit.o", 0};
    int rc = 0, lines = 0, bad = 0;
    char *p, *e;
    if (oa_put("unit.c", OA_SIGU) || oa_unit(abs, "unit.c", "unit.o", stage, why)) {
        printf("CASE a-calleesaved FAIL stage=unisacc-c %s\n", why); (*failed)++; return 0;
    }
    if (oa_run_out("objdump", av, 10, &rc, why, 512, out, sizeof out) || rc) {
        printf("CASE a-calleesaved FAIL stage=objdump %s\n", why); (*failed)++; return 0;
    }
    hit[0] = 0;
    for (p = out; *p && !bad; p = e) {
        int n, k, tabs = 0;
        e = p;
        while (*e && *e != '\n') e++;
        n = (int)(e - p);
        if (n > 511) n = 511;
        for (k = 0; k < n; k++) line[k] = p[k];
        line[n] = 0;
        for (k = 0; line[k] && tabs < 2; k++) if (line[k] == '\t') tabs++;
        if (tabs == 2) {
            if (lines < 8192) {
                int m = 0, c = 0, j = 0;
                while (line[k + m] && m < 95) { oa_ops[lines][m] = line[k + m]; m++; } oa_ops[lines][m] = 0;
                while (line[j] && line[j] != '\t') j++;
                if (line[j]) j++;
                while (line[j] && line[j] != ' ' && line[j] != '\t' && c < 11) oa_code[lines][c++] = line[j++];
                oa_code[lines][c] = 0;
            }
            lines++;
            if (oa_csreg(line + k, hit, sizeof hit)) bad = 1;
        }
        if (*e) e++;
    }
    printf("CASE a-calleesaved %s insns=%d%s%s\n", (!bad && lines > 0) ? "PASS" : "FAIL", lines,
           bad ? " hit=" : "", bad ? hit : "");
    if (bad || lines == 0) (*failed)++;
    {   /* a-x16free: every guard found, and after each brk #0xf7 x16 is written before it is read */
        int i, guards = 0, live = 0, sense = 0, n = lines < 8192 ? lines : 8192;
        for (i = 0; i < n; i++) {
            if (strncmp(oa_ops[i], "brk", 3) || !strstr(oa_ops[i], "0xf7")) continue;
            guards++;
            if (oa_x16_reads_first(oa_ops, n, i + 1)) live++;
            /* a-branchsense: cmp x16, x7 then b.lo over the brk, word 54000043 (b.lo +8: trap only when sp+MARGIN
               reaches x7).  The inverted b.hs (54000042) trapped on every healthy call in the first 0.0.82 draft. */
            if (i < 2 || strncmp(oa_ops[i - 2], "cmp", 3) || !strstr(oa_ops[i - 2], "x16, x7") ||
                !tx_eqz(oa_code[i - 1], "54000043")) sense++;
        }
        printf("CASE a-x16free %s guards=%d live=%d\n", (guards > 0 && !live) ? "PASS" : "FAIL", guards, live);
        if (!guards || live) (*failed)++;
        printf("CASE a-branchsense %s guards=%d wrong=%d\n", (guards > 0 && !sense) ? "PASS" : "FAIL", guards, sense);
        if (!guards || sense) (*failed)++;
    }
    return 0;
}

/* p03's unit.o is still in oa_dir when this runs */
static int oa_symcase(const char *abs, const char *name, int *failed) {
    char why[600], stage[64];
    int s;
    if (oa_unit(abs, "unit.c", "unit.o", stage, why)) { printf("CASE %s FAIL stage=%s %s\n", name, stage, why); (*failed)++; return 0; }
    s = oa_symtype(why);
    printf("CASE %s %s want=FUNC %s\n", name, s == 1 ? "PASS" : "FAIL", why);
    if (s != 1) (*failed)++;
    return 0;
}

static int oa_have(const char *label, char *const argv[]) {
    int rc = 0;
    char w[600];
    return !oa_run(label, argv, 10, &rc, w, sizeof w) && rc == 0;
}

int main(int argc, char **argv) {
    const char *product = 0;
    char abs[4096], id[64];
    int i, failed = 0, xfail = 0, rc = 0, armun = 0;
    for (i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--product") && i + 1 < argc) product = argv[++i];
        else { fprintf(stderr, "check-objabi: usage: --product CANDIDATE.com\n"); return 2; }
    }
    if (!product) { fprintf(stderr, "check-objabi: usage: --product CANDIDATE.com\n"); return 2; }
    if (sy_realpath(product, abs, sizeof abs) < 0) { fprintf(stderr, "check-objabi: no such product: %s\n", product); return 2; }
    oa_dir[0] = 0;
    {
        char *av[] = {"gcc", "--version", 0};
        char w[600];
        if (oa_run("gcc-probe", av, 10, &rc, w, sizeof w) || rc) {
            printf("CHECK_OBJABI UNMEASURED no-gcc\n");
            return 3;
        }
    }
    if (cx_fmt(id, sizeof id, "objabi-%d", (int)getpid()) || sr_default(id, oa_dir, sizeof oa_dir) ||
        sy_mkdir_all(oa_dir, 0755)) { fprintf(stderr, "check-objabi: cannot make session directory\n"); return 2; }
    for (i = 0; i < 11; i++) {
        oa_one(abs, &oa_cases[i], &failed, &xfail);
        if (i == 0) {
            if (oa_put("unit.c", oa_cases[0].unit)) failed++;
            else oa_symcase(abs, "symtype", &failed);
        }
    }
    {
        char *ag[] = {"aarch64-linux-gnu-gcc", "--version", 0};
        const char *home = sy_env("HOME");
        char *aq[] = {oa_qemu, "--version", 0};
        int haveq = 0;
        if (cx_fmt(oa_qemu, sizeof oa_qemu, "qemu-aarch64-static")) oa_qemu[0] = 0;
        haveq = oa_have("qemu-probe", aq);
        if (!haveq && home && !cx_fmt(oa_qemu, sizeof oa_qemu, "%s/.local/bin/qemu-aarch64-static", home))
            haveq = oa_have("qemu-probe", aq);
        if (!oa_have("agcc-probe", ag) || !haveq) {
            printf("CHECK_OBJABI_ARM64 UNMEASURED %s\n", haveq ? "no-aarch64-linux-gnu-gcc" : "no-qemu-aarch64-static");
            armun = 1;
        } else {
            oa_arm = 1;
            for (i = 0; i < 14; i++) {
                oa_one(abs, &oa_arm_cases[i], &failed, &xfail);
                if (i == 0) {
                    if (oa_put("unit.c", oa_arm_cases[0].unit)) failed++;
                    else oa_symcase(abs, "a-symtype", &failed);
                }
            }
            oa_calleesaved(abs, &failed);
            oa_arm = 0;
        }
    }
    {
        char *av[] = {"rm", "-rf", oa_dir, 0};
        pr_result r;
        if (!pr_run("cleanup", av, 0, 0, 10, &r)) pr_free(&r);
    }
    printf("CHECK_OBJABI failed=%d expect_fail=%d%s\n", failed, xfail, armun ? " arm64=UNMEASURED" : "");
    return failed ? 1 : (armun ? 3 : 0);
}
