/* tools/cx-phase.cx -- 相位测量:跑 1/2/6/12 单元用例,读 UNISACC_RR_TIME,按 stage 汇总冷/半冷/热。
 *
 *   sh ./unisacc.com tools/cx-phase.cx -- OUTDIR [--case u1|u2|u6|u12 ...] [--parse FILE]
 *
 * 模式:
 *   cold  UNISACC_RUN_CACHE=0(运行缓存与模型缓存都关)
 *   first 缓存开但目录全空的首跑(模型缓存与单元前端缓存的写入都计入);--product CMD 换被测产品命令
 *   half  运行缓存未命中(源码带新随机注释)而模型缓存命中(UNISACC_E3CACHE 指向 OUTDIR/mc,先用另一份源码预热)
 *   hot   同一份源码再跑一次(运行缓存命中)
 * 输出 TSV 到 stdout(同时写 OUTDIR/cxphase.tsv):
 *   case units mode wall_ms rc stage n model_ms infer_ms mc_hit mc_miss
 * 每个 (case,mode) 一行 stage=ALL 的合计行;未出现的相位不输出,热模式无相位行(运行缓存直接命中),标 stage=UNMEASURED。
 * --parse FILE 只解析一个 RR_TIME 日志文件并输出各 stage 行(供检查夹具用,不跑程序)。 */
#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

static void tx_cat(char *d, int cap, const char *s) {
    int n = tx_len(d, cap), i = 0;
    while (s[i] && n + 1 < cap) d[n++] = s[i++];
    d[n] = 0;
}
#define MAXST 24
typedef struct { char name[24]; long n; long long model_ns, infer_ns; } stg;
typedef struct { stg s[MAXST]; int ns; long mc_hit, mc_miss; } agg;

static stg *get_stage(agg *a, const char *nm, int len) {
    int i;
    for (i = 0; i < a->ns; i++) if (tx_same(a->s[i].name, len, nm, len) && a->s[i].name[len] == 0) return &a->s[i];
    if (a->ns >= MAXST || len >= 24) return 0;
    mm_fill(&a->s[a->ns], sizeof(stg), 0, sizeof(stg));
    mm_copy(a->s[a->ns].name, 24, nm, len);
    return &a->s[a->ns++];
}
static long long num_after(const char *l, int n, const char *key) {
    int p = tx_find(l, n, key, tx_len(key, 16));
    long long v = 0;
    if (p < 0) return -1;
    p += tx_len(key, 16);
    while (p < n && l[p] >= '0' && l[p] <= '9') v = v * 10 + (l[p++] - '0');
    return v;
}
static void line(agg *a, const char *l, int n) {
    int p, q;
    if (n < 8 || !tx_same(l, 8, "RR_TIME\t", 8)) return;
    if (tx_find(l, n, "\tmodelcache\t", 12) >= 0) {
        if (tx_find(l, n, "result=hit", 10) >= 0) a->mc_hit++;
        else a->mc_miss++;
        return;
    }
    p = tx_find(l, n, "stage=", 6);
    if (p < 0) return;
    p += 6; q = p;
    while (q < n && l[q] != '\t') q++;
    stg *s = get_stage(a, l + p, q - p);
    if (!s) return;
    long long ns = num_after(l, n, "\tns=");
    if (ns < 0) return;
    if (tx_find(l, n, "RR_TIME\tmodel\t", 14) == 0) s->model_ns += ns;
    else if (tx_find(l, n, "RR_TIME\tinference\t", 18) == 0) { s->infer_ns += ns; s->n++; }
}
static void parse(agg *a, const char *buf, long len) {
    long i = 0, st = 0;
    mm_fill(a, sizeof(agg), 0, sizeof(agg));
    for (i = 0; i <= len; i++) if (i == len || buf[i] == '\n') { line(a, buf + st, (int)(i - st)); st = i + 1; }
}
static void emit(const char *c, int units, const char *mode, long wall, int rc, agg *a, char *tsv, int cap) {
    char row[400]; int i; long long tm = 0, ti = 0; long tn = 0;
    for (i = 0; i < a->ns; i++) {
        stg *s = &a->s[i];
        cx_fmt(row, sizeof row, "%s\t%d\t%s\t%ld\t%d\t%s\t%ld\t%lld\t%lld\t%ld\t%ld\n", c, units, mode, wall, rc, s->name, s->n, s->model_ns / 1000000, s->infer_ns / 1000000, a->mc_hit, a->mc_miss);
        tx_cat(tsv, cap, row);
        tm += s->model_ns; ti += s->infer_ns; tn += s->n;
    }
    if (a->ns == 0) cx_fmt(row, sizeof row, "%s\t%d\t%s\t%ld\t%d\tUNMEASURED\t0\t0\t0\t%ld\t%ld\n", c, units, mode, wall, rc, a->mc_hit, a->mc_miss);
    else cx_fmt(row, sizeof row, "%s\t%d\t%s\t%ld\t%d\tALL\t%ld\t%lld\t%lld\t%ld\t%ld\n", c, units, mode, wall, rc, tn, tm / 1000000, ti / 1000000, a->mc_hit, a->mc_miss);
    tx_cat(tsv, cap, row);
}
static const char *USES[] = {"sys.io", "sys.fs", "sys.env", "text.text", "mem.heap", "sys.proc", "sys.time", "mem.bytes", "sys.sha", "sys.sig", "text.fmt"};

static int write_src(const char *path, int nuse, long nonce) {
    char b[1024]; int i; b[0] = 0;
    for (i = 0; i < nuse; i++) { tx_cat(b, sizeof b, "#pragma unisa use "); tx_cat(b, sizeof b, USES[i]); tx_cat(b, sizeof b, "\n"); }
    tx_cat(b, sizeof b, "int main(void) { return 0; }\n");
    char t[64]; cx_fmt(t, sizeof t, "/* nonce %ld */\n", nonce); tx_cat(b, sizeof b, t);
    return cx_write(path, b, tx_len(b, sizeof b));
}
static const char *PRODUCT = "sh ./unisacc.com";   /* --product CMD:换成候选产品命令 */
static long run_one(const char *src, const char *env, char *out, int cap, int *rc) {
    char cmd[1000]; long t0 = sy_now_ms();
    cx_fmt(cmd, sizeof cmd, "%s UNISACC_RR_TIME=1 %s '%s' 2>&1", env, PRODUCT, src);
    char *v[] = {"sh", "-c", cmd, 0};
    char *o = 0; size_t on = 0;
    *rc = cx_runv_timeout(v, 55, &o, &on);
    out[0] = 0;
    if (o && on < (size_t)cap) { mm_copy(out, cap, o, (long)on); out[on] = 0; }
    return sy_now_ms() - t0;
}
static int do_case(const char *dir, const char *cs, char *tsv, int cap) {
    int nuse, units; char src[400], src2[400], env[500], mc[400]; char *out = mm_alloc(262144); int rc; long w; agg *a = mm_alloc(sizeof(agg));
    if (tx_eq(cs, "u1", 8)) nuse = 0; else if (tx_eq(cs, "u2", 8)) nuse = 1; else if (tx_eq(cs, "u6", 8)) nuse = 5; else if (tx_eq(cs, "u12", 8)) nuse = 11; else return 1;
    units = nuse + 1;
    if (nuse == 11) units = 12;
    long nonce = sy_now_ms();
    cx_fmt(mc, sizeof mc, "%s/mc", dir);
    cx_fmt(src, sizeof src, "%s/%s-a.cx", dir, cs);
    cx_fmt(src2, sizeof src2, "%s/%s-b.cx", dir, cs);
    /* 冷 */
    write_src(src, nuse, nonce);
    w = run_one(src, "UNISACC_RUN_CACHE=0", out, 262144, &rc);
    parse(a, out, tx_len(out, 262144)); emit(cs, units, "cold", w, rc, a, tsv, cap);
    /* 预热模型缓存(丢弃),再用新源码跑半冷 */
    cx_fmt(env, sizeof env, "UNISACC_E3CACHE=%s", mc);
    write_src(src2, nuse, nonce + 1);
    w = run_one(src2, env, out, 262144, &rc);
    parse(a, out, tx_len(out, 262144)); emit(cs, units, "first", w, rc, a, tsv, cap);   /* 缓存开但全空:含模型缓存与单元缓存的写入 */
    write_src(src, nuse, nonce + 2);
    w = run_one(src, env, out, 262144, &rc);
    parse(a, out, tx_len(out, 262144)); emit(cs, units, "half", w, rc, a, tsv, cap);
    /* 热 */
    w = run_one(src, env, out, 262144, &rc);
    parse(a, out, tx_len(out, 262144)); emit(cs, units, "hot", w, rc, a, tsv, cap);
    mm_free(out); mm_free(a);
    return 0;
}
int main(int argc, char **argv) {
    char *tsv = mm_alloc(65536); char path[400]; int i, ncase = 0; const char *cases[8]; const char *dir = 0, *pf = 0;
    tsv[0] = 0;
    for (i = 1; i < argc; i++) {
        if (tx_eq(argv[i], "--case", 8) && i + 1 < argc) { if (ncase < 8) cases[ncase++] = argv[++i]; }
        else if (tx_eq(argv[i], "--parse", 8) && i + 1 < argc) pf = argv[++i];
        else if (tx_eq(argv[i], "--product", 10) && i + 1 < argc) PRODUCT = argv[++i];
        else dir = argv[i];
    }
    if (pf) {
        size_t n = 0; agg *a = mm_alloc(sizeof(agg)); char *b = cx_read(pf, &n);
        if (!b) { sy_printf("REFUSE\tcannot read %s\n", pf); return 2; }
        parse(a, b, (long)n); emit("parse", 0, "log", 0, 0, a, tsv, 65536);
        sy_printf("%s", tsv); return 0;
    }
    if (!dir) { sy_printf("usage: cx-phase.cx -- OUTDIR [--case uN ...] | --parse FILE\n"); return 2; }
    sy_mkdir(dir, 0755);
    if (!ncase) { cases[0] = "u1"; cases[1] = "u2"; cases[2] = "u6"; cases[3] = "u12"; ncase = 4; }
    tx_cat(tsv, 65536, "case\tunits\tmode\twall_ms\trc\tstage\tn\tmodel_ms\tinfer_ms\tmc_hit\tmc_miss\n");
    for (i = 0; i < ncase; i++) if (do_case(dir, cases[i], tsv, 65536)) { sy_printf("REFUSE\tbad case %s\n", cases[i]); return 2; }
    cx_fmt(path, sizeof path, "%s/cxphase.tsv", dir);
    cx_write(path, tsv, tx_len(tsv, 65536));
    sy_printf("%s", tsv);
    return 0;
}
