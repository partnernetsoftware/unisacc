                mm_copy(out_buf, sizeof out_buf, rr.out, cn); out_buf[cn] = 0;
                while (cn > 0 && (out_buf[cn - 1] == '\n' || out_buf[cn - 1] == '\r')) out_buf[--cn] = 0;
            }
            int rrc = rr.rc;
            np_free(&rr);
            long olen = tx_len(out_buf, sizeof out_buf);
            int has_nl = (tx_chr(out_buf, olen, '\n') >= 0);
            if (fail || rrc != 0 || has_nl ||
                !tx_prefix(out_buf, olen, "ROOT_CURRENT\tPASS\t", 18) ||
                tx_find(out_buf, olen, "\texpect=", 8) < 0 ||
                tx_find(out_buf, olen, "\texpect_sha=", 12) < 0 ||
                tx_find(out_buf, olen, "\tactual_sha=", 12) < 0) {
                cx_fmt(ev, sizeof ev, "%.580s", out_buf[0] ? out_buf : (rwhy[0] ? rwhy : "root-current invalid/empty output"));
                row_judged(g24_nm, 0, ev, sy_now_ms() - t0);
            } else {
                cx_fmt(ev, sizeof ev, "%.580s", out_buf);
                row_judged(g24_nm, 1, ev, sy_now_ms() - t0);
            }
        }
    }
    {
        int w12 = WANT("12-root-files"), w12p = WANT("12p-preflight-entry");
        int w13 = WANT("13-snap-cache"), w14 = WANT("14-root-record");
        if (w12 || w12p || w13 || w14) root_items(repo, rootarg ? rootarg : repo, revarg, only);
    }
    if (WANT("18-parse2-gen")) {
        char private_tree[4400], ev[640];
        long t0 = sy_now_ms();
        int made = !sr_scratch("chain-ready-parse2-", private_tree, sizeof private_tree);
        int ok = parse2_preflight(repo, revarg, made ? private_tree : 0, ev);
        if (made) (void)sy_remove_all(private_tree);
        row_judged("18-parse2-gen", ok, ev, sy_now_ms() - t0);
    }
    {
        int w19_full = WANT("19-chain-preflight");
        int w19_a_raw = WANT("19a-preflight-sixtarget");
        int w19_b_raw = WANT("19b-preflight-snap");
        int w19_a = (only != 0) && w19_a_raw;
        int w19_b = (only != 0) && w19_b_raw;
        int need_a = w19_full || w19_a;
        int need_b = w19_full || w19_b;
        char ev_a[640] = {0}, ev_b[640] = {0};
        long ms_a = 0, ms_b = 0;
        int ok_a = 1, ok_b = 1;
        if (need_a) {
            long t0 = sy_now_ms();
            ok_a = run_19_preflight(repo, rootarg ? rootarg : repo, revarg, since, tver, pftable, "sixtarget", pf_bound_s, ev_a, sizeof ev_a);
            ms_a = sy_now_ms() - t0;
        }
        if (need_b) {
            long t0 = sy_now_ms();
            ok_b = run_19_preflight(repo, rootarg ? rootarg : repo, revarg, since, tver, pftable, "snap", pf_bound_s, ev_b, sizeof ev_b);
            ms_b = sy_now_ms() - t0;
        }
        if (w19_a) row_judged("19a-preflight-sixtarget", ok_a, ev_a, ms_a);
        if (w19_b) row_judged("19b-preflight-snap", ok_b, ev_b, ms_b);
        if (w19_full) row_judged("19-chain-preflight", ok_a && ok_b, !ok_a ? ev_a : ev_b, ms_a + ms_b);
    }
    /* 17-root-public (0.0.87 S4): a Root installed from an unpublished candidate is fine for a chain and for
       development, but not for a release step; listed here, never counted as a failure. */
    if (WANT("17-root-public")) {
        char mk[4400], ev[640], rev[48]; size_t mn = 0; char *mb; long at;
        cx_fmt(mk, sizeof mk, "%s/unisacc.com.candidate.tsv", rootarg ? rootarg : repo);
        if (sy_exists(mk) != 1) row("17-root-public", "PASS", "Root is not a candidate install (no unisacc.com.candidate.tsv): release steps may use it as the baseline", 0);
        else {
            rev[0] = 0;
            if ((mb = cx_read(mk, &mn)) != 0) { at = tx_find(mb, (long)mn, "rev=", 4); if (at >= 0 && at + 44 <= (long)mn) { mm_copy(rev, (long)sizeof rev, mb + at + 4, 40); rev[40] = 0; } mm_free(mb); }
            cx_fmt(ev, sizeof ev, "WARN root-candidate rev=%s chain=allowed RELEASE_BLOCKED (release-exec, release-run --pack refuse) fix: tools/install-ape.cx -- ROOT --rollback --write or install the public APE", rev[0] ? rev : "?");
            row("17-root-public", "PASS", ev, 0);
        }
    }
    if (WANT("4-p1")) {
        if (fast) row("4-p1", "SKIPPED", "--fast: cx0_plan scan of every .cx with a use pragma not run", 0);
        else { char ev[640]; long ms; run_p1(&ms, ev, sizeof ev); row_judged("4-p1", ms >= 0, ev, ms < 0 ? -ms : ms); }
    }
    if (WANT("16-disk-free")) {
        /* Safe subset (cc 2026-11-24 裁定 (b)): the MULTIPLIER is NOT here yet -- the thresholds stay 8G/20G.
           What changes is where the number comes from: sy_disk_avail_mb (f_bavail*frsize/2^20) on the disk that
           will hold the chain directory -- not on the checkout, which may be another filesystem -- with a
           bounded `df -Pk` fallback, and when both fail the row is FAIL, not UNMEASURED: an unmeasured disk is
           not a passed gate.  --disk-free-gb N still injects the available space (fixtures and hand runs). */
        long t0 = sy_now_ms(), avail_gb = disk_override_gb, avail_mb;
        char ev[420], dpath[4400];
        int located = disk_target(rootarg ? rootarg : repo, dpath, sizeof dpath) == 0;
        if (!located && cx_fmt(dpath, sizeof dpath, "%s", "?")) return 2;
        if (avail_gb < 0 && located) {
            avail_mb = sy_disk_avail_mb(dpath);
            if (avail_mb >= 0) avail_gb = avail_mb / 1024;
        }
        if (avail_gb < 0 && located) {
            /* bounded: tools/bound gives the child its own 10 s deadline and the read stops at the buffer,
               so a hung df cannot hold chain-ready open past that. */
            char *dv[] = {"./tools/bound", "10", "df", "-Pk", dpath, 0};
            int dfd = -1; int dpid = sy_spawn_pipe(dv, 0, 0, &dfd, 0);
            if (dpid >= 0 && dfd >= 0) {
                char db[2048]; long dn = 0, r;
                while (dn < (long)sizeof db - 1 && (r = sy_read(dfd, db + dn, (size_t)(sizeof db - 1 - (size_t)dn))) > 0) dn += r;
                db[dn] = 0; sy_close(dfd);
                int ex = 0, code = 0, sig = 0;
                sy_wait_status(dpid, 0, &ex, &code, &sig);
                if (ex && code == 0) {
                    long nl = tx_chr(db, dn, '\n');
                    if (nl >= 0 && nl + 1 < dn) {
                        const char *p = db + nl + 1;
                        int col = 0;
                        while (*p && *p != '\n') {
                            while (*p == ' ' || *p == '\t') p++;
                            const char *s = p;
                            while (*p && *p != ' ' && *p != '\t' && *p != '\n') p++;
                            if (col == 3 && p > s) {
                                int64_t kb = 0;
                                if (!tx_to_i64(s, (long)(p - s), 10, &kb)) avail_gb = (long)(kb / (1024L * 1024L));
                                break;
                            }
                            col++;
                        }
                    }
                }
            }
        }
        /* The measured path is part of the evidence: a reader must be able to see WHICH filesystem the
           verdict is about, so a gate that answered about the checkout instead of the chain base is visible
           in the row rather than in a code review. */
        /* An injected figure (--disk-free-gb N) is the answer even when the base cannot be located -- fixtures
           and hand runs use it precisely when there is no real chain disk to measure.  With no figure and no
           base there is nothing to measure, and both reasons are spelled out.  These rows pass an explicit
           FAIL rather than row_judged's UNMEASURED: row() counts FAIL and SKIPPED but not UNMEASURED, and
           making it count would change every item's verdict -- that is the 6-affected item (S1 2026-11-24),
           not this one.  An unreadable disk must still leave READY=no. */
        if (avail_gb < 0 && !located) {
            row("16-disk-free", "FAIL", "DISK_UNMEASURED the chain base could not be resolved (UNISACC_CHAIN_BASE is relative, or HOME is unusable): no disk of the right name could be measured, and measuring the checkout would answer about the wrong one; pass an absolute chain base or --disk-free-gb N", sy_now_ms() - t0);
        } else if (avail_gb < 0) {
            row("16-disk-free", "FAIL", "DISK_UNMEASURED sy_disk_avail_mb and the bounded df -Pk both failed on the chain disk: an unmeasured disk is not a passed gate; free space or pass --disk-free-gb N", sy_now_ms() - t0);
        } else if (avail_gb < 8) {
            cx_fmt(ev, sizeof ev, "DISK_BLOCKED avail_gb=%ld (<8G); free disk space before starting chain; disk=%s", avail_gb, dpath);
            row_judged("16-disk-free", 0, ev, sy_now_ms() - t0);
        } else if (avail_gb < 20) {
            cx_fmt(ev, sizeof ev, "DISK_LOW avail_gb=%ld (<20G warning, >=8G allowed); disk=%s", avail_gb, dpath);
            row_judged("16-disk-free", 1, ev, sy_now_ms() - t0);
        } else {
            cx_fmt(ev, sizeof ev, "avail_gb=%ld (>=20G); disk=%s", avail_gb, dpath);
            row_judged("16-disk-free", 1, ev, sy_now_ms() - t0);
        }
    }
    if (WANT("7-recipe")) row("7-recipe", "UNMEASURED", "manual: recipe steps 1-5 (private root checkout of REV, commit-tree, UNISACC_IDENT_HELPER, fresh --out, 5400 s)", 0);
    if (WANT("9-ledger")) row("9-ledger", "UNMEASURED", "manual: one ledger line in prd_mempalace.md (REV, PID/PGID, deadline, output dir) before the chain", 0);
    {
        int gi;
        const char *unpolled = 0;
        for (gi = 0; cr_gate_names[gi]; gi++) {
            if (gi >= 64 || !cr_polled_seen[gi]) { unpolled = cr_gate_names[gi]; break; }
        }
        if (cr_drift_name || unpolled || nrows_emitted <= 0) {
            printf("REFUSE\tCHAIN_READY_ROSTER_DRIFT\tdrift=%s\tunpolled=%s\trows=%d\n",
                   cr_drift_name ? cr_drift_name : "-", unpolled ? unpolled : "-", nrows_emitted);
            if (have_tmp && sy_remove_all(tmpd)) fprintf(stderr, "chain-ready: scratch cleanup failed %s\n", tmpd);
            return 2;
        }
    }
    printf("READY\t%s\t%s%s\t%ld\n", nfail ? "no" : "yes", nfail ? "failed=" : "failed=none", failed_names, sy_now_ms() - T0);
    if (have_tmp && sy_remove_all(tmpd)) fprintf(stderr, "chain-ready: scratch cleanup failed %s\n", tmpd);
    return nfail ? 1 : 0;
}
