            if (pg[1].out) mm_free(pg[1].out);
        }
        while (done < nj) {
            for (i = 0; i < nj && running < max_running && !running_solo; i++) {
                int idx = ord[i], is_d, is_s;
                if (J[idx].state != 0) continue;
                is_s = is_solo_job(items[idx]);
                if (is_s && running > 0) continue;
                is_d = tx_prefix(items[idx], (long)tx_len(items[idx], 256), "derive:", 7);
                if (is_d && running_der >= 4) continue;
                if (start(&J[idx]) == 0) {
                    running++;
                    if (is_d) running_der++;
                    if (is_s) { running_solo = 1; break; }
