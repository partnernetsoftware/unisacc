        g_premerge1[10] = "--branch"; g_premerge1[11] = pm_branch; g_premerge1[12] = 0;
        g_premerge2[10] = "--branch"; g_premerge2[11] = pm_branch; g_premerge2[12] = 0;
        g_premerge3[10] = "--branch"; g_premerge3[11] = pm_branch; g_premerge3[12] = 0;
        g_premerge4[10] = "--branch"; g_premerge4[11] = pm_branch; g_premerge4[12] = 0;
    }
    int tri_core = WANT("3a-cxmod-tri"), tri_exports = WANT("3a-cxmod-tri-exports");
    int tri_scratch = have_tmp &&
        !cx_fmt(tri_image, sizeof tri_image, "%s/check-cxmod-tri", tmpd) &&
        !cx_fmt(tri_extract, sizeof tri_extract, "%s/cx0-extract", tmpd);
    if ((tri_core || tri_exports) && !tri_scratch)
        row("3a-cxmod-tri", "FAIL", "no private material directory", 0);
    g_tri[2] = g_tri_exports[2] = tri_image; g_tri[4] = tri_extract;
    for (k = 0; k < (int)(sizeof tab / sizeof tab[0]); k++) {
        int c, is_der = (k >= 2 && k <= 8), is_ch = (k >= 12 && k <= 16), is_pm = (k >= 21 && k <= 25);
        int wk = WANT(nm[k]);
        if (!wk && !(k == 1 && WANT("1-rev")) && !(is_der && WANT("2a-derive")) && !(is_ch && WANT("5-candidate-chain")) && !(is_pm && WANT("22-premerge-union"))) continue;
        if (is_ch && !have_tmp) continue;
        if (tx_eqz(kd[k], "tri") && !tri_scratch) continue;
        for (c = 0; tab[k][c]; c++) J[nj].argv[c] = tab[k][c];
        J[nj].argv[c] = 0; J[nj].name = nm[k]; items[nj] = (char *)kd[k]; prios[nj] = pr[k];
        nj++;
    }
    /* item 6: changed .cx files (dirty, and --since REV..HEAD), each handed to affected --files */
    {   int want6 = WANT("6-affected");
        if (want6) {
            char *gv[9]; Job g[2]; int gi, ng = 0, npath = 0; char *paths[200]; char *tb[2] = {0, 0}; long tl[2] = {0, 0};
            gv[0] = "./tools/bound"; gv[1] = "20"; gv[2] = "git"; gv[3] = "--no-optional-locks"; gv[4] = "-C"; gv[5] = (char *)repo; gv[6] = "status"; gv[7] = "--short"; gv[8] = 0;
            { int x; for (x = 0; x < 9; x++) g[0].argv[x] = gv[x]; start(&g[0]); finish(&g[0]); tb[0] = g[0].out; tl[0] = g[0].n; ng = 1; }
            if (since) {
                char *dv[] = {"./tools/bound", "20", "git", "-C", (char *)repo, "diff", "--name-only", 0, 0};
                char rng[200]; int x; cx_fmt(rng, sizeof rng, "%s..HEAD", since); dv[7] = rng;
                for (x = 0; x < 9; x++) g[1].argv[x] = dv[x];
                start(&g[1]); finish(&g[1]); tb[1] = g[1].out; tl[1] = g[1].n; ng = 2;
            }
            for (gi = 0; gi < ng; gi++) {
                long at = 0;
                while (tb[gi] && at < tl[gi] && npath < 200) {
                    long e = tx_chr(tb[gi] + at, tl[gi] - at, '\n'), ln = e < 0 ? tl[gi] - at : e;
                    char *p = tb[gi] + at; long pl = ln;
                    if (gi == 0 && pl > 3) { p += 3; pl -= 3; }   /* "XY path" */
                    if (pl > 3 && p[pl - 3] == '.' && p[pl - 2] == 'c' && p[pl - 1] == 'x' && !(gi == 0 && tb[gi][at] == 'D')) {
                        p[pl] = 0;   /* in place; the line ends here */
                        { int dup = 0, y; for (y = 0; y < npath; y++) if (tx_eqz(paths[y], p)) dup = 1; if (!dup) paths[npath++] = p; }
                    }
                    at += ln + 1;
                }
            }
            if (npath > 0) {
                /* List affected batch IDs first, then shard into <=4 batches per 60s job (never relax bound). */
                Job lg; int c = 0, y;
                static char aff_ids[128][128]; int naff = 0;
                lg.argv[c++] = "./tools/bound"; lg.argv[c++] = "30"; lg.argv[c++] = "sh"; lg.argv[c++] = UC;
                lg.argv[c++] = "tools/affected.cx"; lg.argv[c++] = "--"; lg.argv[c++] = "--files";
                for (y = 0; y < npath && c < 20; y++) lg.argv[c++] = paths[y];
                lg.argv[c++] = "--list-only"; lg.argv[c] = 0; lg.name = "6-affected-list";
                start(&lg); finish(&lg);
                if (lg.state == 3 || lg.rc != 0) {
                    char ev[320];
                    cx_fmt(ev, sizeof ev, "rc=%d affected --list-only failed", lg.state == 3 ? -1 : lg.rc);
                    row("6-affected", "FAIL", ev, lg.ms);
                } else {
                    long at = 0;
                    while (lg.out && at < lg.n && naff < 128) {
                        long e = tx_chr(lg.out + at, lg.n - at, '\n'), ln = e < 0 ? lg.n - at : e;
                        if (ln > 9 && tx_prefix(lg.out + at, ln, "AFFECTED\t", 9)) {
                            const char *p = lg.out + at + 9;
                            long rem = ln - 9;
                            long tab = tx_chr(p, rem, '\t');
                            long idl = tab >= 0 ? tab : rem;
                            if (idl > 0 && idl < 127) {
                                mm_copy(aff_ids[naff], 128, p, (size_t)idl);
                                aff_ids[naff][idl] = 0;
                                naff++;
                            }
                        }
                        at += ln + 1;
                    }
                    if (naff == 0) {
                        row("6-affected", "PASS", "0 affected batches for changed .cx files", lg.ms);
                    } else {
                        int s = 0, per = 4;
                        while (s < naff && nj < MAXJ) {
                            int end = s + per < naff ? s + per : naff;
                            int ac = 0, j;
                            J[nj].argv[ac++] = "./tools/bound"; J[nj].argv[ac++] = "60"; J[nj].argv[ac++] = "sh"; J[nj].argv[ac++] = UC;
                            J[nj].argv[ac++] = "tools/affected.cx"; J[nj].argv[ac++] = "--"; J[nj].argv[ac++] = "--ids";
                            for (j = s; j < end && ac < 20; j++) J[nj].argv[ac++] = aff_ids[j];
                            J[nj].argv[ac++] = "--run"; J[nj].argv[ac] = 0;
                            J[nj].name = "6-affected"; items[nj] = "affected:shard"; prios[nj] = 5; nj++;
                            s = end;
