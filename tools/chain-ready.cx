                            jb->state = 2;
                            running--;
                            if (tx_prefix(items[pl[i]], (long)tx_len(items[pl[i]], 256), "derive:", 7)) running_der--;
                            if (is_solo_job(items[pl[i]])) running_solo = 0;
                            done++;
                        }
                    }
                }
            }
        }
    }
    {   char ev[640], rev_ev[640], der_pass_ev[640], der_fail_ev[640], aff_pass_ev[640], aff_fail_ev[640], pm_pass_ev[640], pm_fail_ev[640];
        int ok, rev_ok = -1, der_ok = 1, der_cnt = 0, aff_ok = 1, aff_cnt = 0, pm_ok = 1, pm_cnt = 0;
        long rev_ms = 0, der_ms = 0, dfn = 0, aff_ms = 0, afn = 0, pm_ms = 0, pfn = 0;
        const char *ch_names[8], *ch_outs[8]; long ch_lens[8], ch_ms = 0; int ch_rcs[8], ch_cnt = 0;
        der_pass_ev[0] = 0; der_fail_ev[0] = 0; aff_pass_ev[0] = 0; aff_fail_ev[0] = 0; pm_pass_ev[0] = 0; pm_fail_ev[0] = 0;
        for (k = 0; k < nj; k++) {
            long il = (long)tx_len(items[k], 256);
            if (il > 6 && tx_prefix(items[k], il, "chain:", 6)) {
                if (ch_cnt < 8) {
                    ch_names[ch_cnt] = items[k] + 6;
                    ch_outs[ch_cnt] = J[k].out ? J[k].out : "";
                    ch_lens[ch_cnt] = J[k].n;
                    ch_rcs[ch_cnt] = J[k].state == 3 ? -1 : J[k].rc;
                    if (J[k].ms > ch_ms) ch_ms = J[k].ms;
                    ch_cnt++;
