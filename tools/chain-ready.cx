        for (i = 0; i < nj; i++) {
            if (J[i].state == 0 && (tx_eqz(items[i], "inflight") || tx_eqz(items[i], "premerge:prep"))) {
                start(&J[i]);
                finish(&J[i]);
                done++;
            }
        }
        if (tri_scratch && (tri_core || tri_exports)) {
            char *compile[][8] = {
                {"./tools/bound", "50", "sh", UC, "tools/check-cxmod-tri.cx", "-o", tri_image, 0},
                {"./tools/bound", "50", "sh", UC, "tools/cx0-extract.cx", "-o", tri_extract, 0}
            };
            int ok[2] = {0, !tri_core};
            for (int m = 0; m < 1 + tri_core; m++) {
                Job p = {0};
                for (int a = 0; compile[m][a]; a++) p.argv[a] = compile[m][a];
                if (!start(&p)) { finish(&p); ok[m] = p.state != 3 && !p.rc; }
                if (ok[m]) printf("PREPARED\t%s\tms=%ld\n", compile[m][4], p.ms);
                else {
                    row("3a-material", "FAIL", compile[m][4], p.ms);
                    if (p.out && p.out[0]) fputs(p.out, stderr);
                }
                mm_free(p.out);
            }
            for (i = 0; i < nj; i++) if (tx_eqz(items[i], "tri") &&
                (!ok[0] || (tx_eqz(J[i].name, "3a-cxmod-tri") && !ok[1]))) {
                J[i].state = 2; J[i].rc = 2; J[i].out = 0; J[i].n = J[i].ms = 0; done++;
            }
        }
        /* Pre-start up to 4 non-chain shards (e.g. 2a-derive) while preparing candidate-chain & chain-phases-gen materials
         * under independent bounds, so the 5 candidate-chain test shards never pay cold compile time inside their 60s window. */
        if (WANT("5-candidate-chain") && have_tmp) {
            Job pg[2]; int pi;
            char *pv0[] = {"./tools/bound", "45", "sh", UC, "tools/check-candidate-chain.cx", "--", "--prepare", cached, "tool", 0};
            char *pv1[] = {"./tools/bound", "45", "sh", UC, "tools/check-candidate-chain.cx", "--", "--prepare", cached, "generator", 0};
            for (i = 0; i < nj && running + 2 < max_running; i++) {
                int idx = ord[i];
                if (J[idx].state != 0 || prios[idx] >= 2) continue;
                if (is_solo_job(items[idx])) continue;
                if (tx_prefix(items[idx], (long)tx_len(items[idx], 256), "derive:", 7) && running_der >= 4) continue;
                if (start(&J[idx]) == 0) {
                    running++;
                    if (tx_prefix(items[idx], (long)tx_len(items[idx], 256), "derive:", 7)) running_der++;
                } else { J[idx].ms = 0; J[idx].out = 0; J[idx].n = 0; J[idx].rc = -1; done++; }
            }
            (void)sy_mkdir(cached, 0700);
            for (pi = 0; pv0[pi]; pi++) pg[0].argv[pi] = pv0[pi];
            pg[0].argv[pi] = 0;
            for (pi = 0; pv1[pi]; pi++) pg[1].argv[pi] = pv1[pi];
            pg[1].argv[pi] = 0;
            start(&pg[0]); start(&pg[1]);
            finish(&pg[0]); finish(&pg[1]);
