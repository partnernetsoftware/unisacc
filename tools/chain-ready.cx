/* tools/chain-ready.cx -- the nine pre-chain conditions of prd_mempalace.md "0.0.62 候选整链就绪判断" in one command.
 *
 *   sh ./unisacc.com tools/chain-ready.cx [-- [--fast] [--repo DIR] [--since REV] [--pgrep-pat PAT] [--only NAME] [--version V]]
 *   sh ./unisacc.com tools/chain-ready.cx -- --judge KIND FILE RC     (the pure judge on a saved output; fixtures)
 *
 * One TSV row per item: ITEM  PASS|FAIL|UNMEASURED|SKIPPED  evidence  ms.  Last row:
 *   READY  yes|no  failed=<names>  ms
 * READY=yes needs every row PASS or UNMEASURED-by-design (the two manual items: recipe steps (7), ledger line (9));
 * a SKIPPED P1 (--fast) or a FAIL makes it no.  Items:
 *   1-rev          git status --short on src cx ext exec/facts is empty and the branch is main
 *   2a-derive      tools/derive.cx -- --check: DERIVE_SUMMARY drift=0 refused=0
 *   2b-ratchets    tools/ratchets.cx last line ok=13 fail=0
 *   3a-cxmod-tri   tools/check-cxmod-tri.cx CXMOD_TRI failed=0 (GAP rows are named by the tool)
 *   3b-cx0-extract tools/cx0-extract.cx -- --check prints CX0_EXTRACT EXACT
 *   4-p1           every .cx with a `#pragma unisa use` goes through cx0_plan (check-cxmod-tri.cx --cx0-batch, 16 files
 *                  per child, bound 40 per child, 16 lanes, each file judged on its own segment; no file-count cap); a new rejection is one whose diagnostic has "bad symbol name", "does not export" or
 *                  "undeclared function"; must be 0.  --fast: SKIPPED.  Other rejections are reported as a count only.
 *   5-candidate-chain  tools/check-candidate-chain.cx -- TMP/out TMP/cache: rc 0 and no FAIL row
 *   6-affected     tools/affected.cx --files <changed .cx> --run (dirty files, plus --since REV..HEAD); none changed: PASS
 *   7-recipe       manual (private root checkout, commit-tree, UNISACC_IDENT_HELPER, fresh --out, 5400 s): UNMEASURED
 *   8-inflight     pgrep -af candidate-chain: no process other than this tool, pgrep and shell wrappers
 *   9-ledger       manual (one ledger line before the chain): UNMEASURED
 *  10-envhygiene   settings that would change what the chain measures: an UNISACC_RUN_CACHE or
 *                  UNISACC_CACHE_DIR forces the build the chain reads, and an UNISACC_BOUND_DEADLINE_MONO that is
 *                  past or not a number is the residue of an earlier bounded command.  Either is a FAIL naming
 *                  the variable; a usable future instant is a normal chain inside a bound window and passes.
 *  11-version-slot tools/release-packcheck.cx -- slot REPO [--version V]: release/candidate.tsv has exactly one
 *                  data row whose version equals the target (--version V, else branch vX.Y.Z; on main --version
 *                  is required), so the chain APE self-reports that version and release-run --pack reproduces its
 *                  bytes.  Otherwise FAIL with REFUSE CHAIN_READY_VERSION_SLOT <why>.
 *  12-root-files   ROOT (--root DIR, else --repo) unisacc.com and unisacc.com.build.json are regular files (lstat,
 *                  no symbolic link): else READY=no worktree-root-file-not-regular path=... fix: cp the real file.
 *  12p-preflight-entry  ROOT/unisacc.com.build.json exists and is a regular file: the chain-run preflight entry
 *                  reads it first (0.0.86 start 1 refused there).  Else READY=no preflight-entry-build-json
 *                  kind=missing|symlink|not-regular with the cp --remove-destination -L fix.  Kept apart from 12 so
 *                  the missing record is named on its own; tools/bg-candidate.cx start runs --only 12 (both).
 *  13-snap-cache   if the chain snapshot of this rev (cxlib.chainroot cr_snap; --rev REV, else git rev-parse HEAD)
 *                  exists, its unisacc.com and build.json are regular and sha256-equal to ROOT's, else
 *                  READY=no snap-cache-file-not-regular|snap-cache-stale with a mv command (never removed here).
 *  14-root-record  build.json product_digest and bytes match the APE (else root-record-digest-mismatch); the
 *                  commit equals the release/candidate.tsv row of the APE's --version (else
 *                  root-record-commit-mismatch); no row, or sources_sha256: WARN root-record-stale-fields, PASS.
 *  15-gen-all      tools/gen-all-check.cx -- --root REPO: GEN_ALL_SUMMARY diff=0 error=0 (rc 0); any product
 *                  table generator DIFF or ERROR blocks the chain with its --write fix.
 *  17-root-public  ROOT has no unisacc.com.candidate.tsv (tools/install-ape.cx --candidate).  With one the row is
 *                  PASS with WARN root-candidate ... RELEASE_BLOCKED: the chain may start, release-exec and
 *                  release-run --pack refuse that Root as a baseline.
 *  18-parse2-gen   compare candidate --rev (or HEAD) with the last published tag.
 *                  Changed exec/parse2 or seed/gen.c requires a successful host seed-gen parse2 --locations.
 *  19-chain-preflight  run tools/chain-preflight.cx --strict on all nodes in tools/flows/chain-preflight.tsv
 *                  (or --preflight-table FILE), plus three version-scope mechanical checks on plans/v<V>.md:
 *                  planned_units is a positive integer, a_class is a single unique label, and hand-modified
 *                  lane-A files (build/lane-inputs.tsv lane A, excluding exec/ and kernel/) <= a_files_cap.
 *  20-ident-helper UNISACC_IDENT_HELPER must be set and point to an executable regular file (default:
 *                  ~/.cache/unisacc/ident-helper/identity-helper-real5, built from seed/ident.c).
 * Items 1-3 and 5-6 run at most four at a time; 4 follows with its own 8 lanes.  Every child runs under
 * tools/bound.  Read only: temporary files go to the system temp dir, never into the repo. */
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use text.conv
#pragma unisa use sys.env
#pragma unisa use cxlib.boundenv
#pragma unisa use sys.poll
#pragma unisa use sys.sha
#pragma unisa use cxlib.chainroot
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.releaseversion
#pragma unisa use sys.posix

#define UC "./unisacc.com" /* lint:allow R1 tool runs sibling tools under the installed product, like tools/ratchets.cx */
#define MAXJ 64
#define NEWMSG_N 3
#define CHAIN_PASS_BASELINE 137

typedef struct { const char *name; char *argv[24]; int pid, ofd; char *out; long n, cap; int rc; long t0, ms; int state; } Job;

static const char *newmsg[NEWMSG_N] = {"bad symbol name", "does not export", "undeclared function"};

static int has(const char *h, long n, const char *w) { return tx_find(h, n, w, (long)tx_len(w, 4096)) >= 0; }

/* the first line of H (len n) holding W, copied into DST (sanitised), or "" */
static void line_with(const char *h, long n, const char *w, char *dst, int cap) {
    long at = 0; dst[0] = 0;
    while (at < n) {
        long e = tx_chr(h + at, n - at, '\n'), ln = e < 0 ? n - at : e;
        if (has(h + at, ln, w)) {
            long i, k = 0;
            for (i = 0; i < ln && k < cap - 1 && k < 150; i++) { char c = h[at + i]; dst[k++] = (c == '\t' || c == '\r') ? ' ' : c; }
            dst[k] = 0; return;
        }
        at += ln + 1;
    }
}
static void put_ev(char *ev, int cap, const char *s) { cx_fmt(ev, (size_t)cap, "%s", s); }

/* ---- pure judges: 1 PASS, 0 FAIL; ev gets the evidence sentence ---- */
static int j_rev(const char *o, long n, int rc, char *ev, int cap) {
    long at = 0, dirty = 0; char first[160]; first[0] = 0;
    if (rc != 0) { cx_fmt(ev, (size_t)cap, "git status rc=%d", rc); return 0; }
    while (at < n) {
        long e = tx_chr(o + at, n - at, '\n'), ln = e < 0 ? n - at : e;
        if (ln > 0) { if (!dirty) { long k = ln < 100 ? ln : 100; mm_copy(first, sizeof first, o + at, (size_t)k); first[k] = 0; } dirty++; }
        at += ln + 1;
    }
    if (dirty) { cx_fmt(ev, (size_t)cap, "%ld uncommitted or untracked paths under src cx ext exec/facts, first: %s", dirty, first); return 0; }
    put_ev(ev, cap, "no uncommitted or untracked paths under src cx ext exec/facts"); return 1;
}
static int j_branch(const char *o, long n, char *ev, int cap) {
    long l = n;
    while (l > 0 && (o[l - 1] == '\n' || o[l - 1] == '\r')) l--;
    if (l == 4 && tx_prefix(o, l, "main", 4)) { put_ev(ev, cap, "branch main"); return 1; }
    if (l > 5 && tx_prefix(o, l, "v0.0.", 5)) {
        long i = 5;
        while (i < l && o[i] >= '0' && o[i] <= '9') i++;
        if (i == l) { cx_fmt(ev, (size_t)cap, "branch %.*s", (int)l, o); return 1; }
    }
    cx_fmt(ev, (size_t)cap, "branch is not main or v0.0.NN: %.40s", n > 0 ? o : "(none)"); return 0;
}
static int j_derive_shard(const char *o, long n, int rc, const char *shard_gens, char *ev, int cap) {
    char l[160], failed_gens[256]; long fgn = 0, at = 0;
    failed_gens[0] = 0;
    while (at < n) {
        long e = tx_chr(o + at, n - at, '\n'), ln = e < 0 ? n - at : e;
        if (ln > 7 && tx_prefix(o + at, ln, "DERIVE\t", 7)) {
            const char *gn = o + at + 7;
            long rem = ln - 7, t1 = tx_chr(gn, rem, '\t');
            if (t1 > 0 && t1 < 64) {
                const char *st = gn + t1 + 1;
                long srem = rem - t1 - 1, t2 = tx_chr(st, srem, '\t');
                long sl = t2 < 0 ? srem : t2;
                if (sl > 0 && sl < 32 && !(sl == 2 && tx_prefix(st, sl, "OK", 2)) && !(sl == 7 && tx_prefix(st, sl, "SKIPPED", 7))) {
                    char one[120]; long ol;
                    cx_fmt(one, sizeof one, "%s%.*s(%.*s)", fgn ? "," : "", (int)t1, gn, (int)sl, st);
                    ol = (long)tx_len(one, sizeof one);
                    if (fgn + ol < (long)sizeof failed_gens - 1) {
                        mm_copy(failed_gens + fgn, sizeof failed_gens - (size_t)fgn, one, (size_t)ol + 1);
                        fgn += ol;
                    }
                }
            }
        }
        at += (e < 0 ? n - at : e + 1);
    }
    line_with(o, n, "DERIVE_SUMMARY", l, sizeof l);
    if (!l[0]) {
        if (!fgn && shard_gens && shard_gens[0]) {
            long slen = (long)tx_len(shard_gens, 512), p = 0;
            while (p < slen) {
                long c = tx_chr(shard_gens + p, slen - p, ','), gl = c < 0 ? slen - p : c;
                if (gl > 0 && gl < 64) {
                    char pat[96];
                    cx_fmt(pat, sizeof pat, "DERIVE\t%.*s\tOK\t", (int)gl, shard_gens + p);
                    if (!has(o, n, pat)) {
                        char one[120]; long ol;
                        cx_fmt(one, sizeof one, "%s%.*s(%s)", fgn ? "," : "", (int)gl, shard_gens + p, rc == 142 ? "TIMEOUT" : "INCOMPLETE");
                        ol = (long)tx_len(one, sizeof one);
                        if (fgn + ol < (long)sizeof failed_gens - 1) {
                            mm_copy(failed_gens + fgn, sizeof failed_gens - (size_t)fgn, one, (size_t)ol + 1);
                            fgn += ol;
                        }
                    }
                }
                p += (c < 0 ? slen - p : c + 1);
            }
        }
        if (failed_gens[0]) cx_fmt(ev, (size_t)cap, "no DERIVE_SUMMARY line, rc=%d failed_generator=%s", rc, failed_gens);
        else cx_fmt(ev, (size_t)cap, "no DERIVE_SUMMARY line, rc=%d", rc);
        return 0;
    }
    if (rc == 0 && !fgn && has(l, (long)tx_len(l, 200), "drift=0") && has(l, (long)tx_len(l, 200), "refused=0")) {
        cx_fmt(ev, (size_t)cap, "%s", l);
        return 1;
    }
    {   char d[160];
        line_with(o, n, "\tDRIFT\t", d, sizeof d);
        if (!d[0]) line_with(o, n, "\tREFUSED\t", d, sizeof d);
        if (!d[0]) line_with(o, n, "\tTIMEOUT\t", d, sizeof d);
        if (!d[0]) line_with(o, n, "\tNEEDS_BUMP\t", d, sizeof d);
        if (failed_gens[0]) cx_fmt(ev, (size_t)cap, "failed_generator=%s %.60s; first: %.90s", failed_gens, l, d);
        else cx_fmt(ev, (size_t)cap, "%.60s; first: %.90s", l, d);
    }
    return 0;
}
static int j_derive(const char *o, long n, int rc, char *ev, int cap) {
    return j_derive_shard(o, n, rc, 0, ev, cap);
}
static int parse_ratchet_below(const char *o, long n, const char *tag) {
    char l[240]; const char *p;
    line_with(o, n, tag, l, sizeof l);
    if (!l[0]) return 0;
    p = strstr(l, "above baseline, ");
    if (!p) return 0;
    return atoi(p + 16);
}
static int j_ratchets(const char *o, long n, int rc, char *ev, int cap) {
    char l[160]; line_with(o, n, "RATCHETS\t", l, sizeof l);
    if (rc == 0 && (has(l, (long)tx_len(l, 200), "ok=16") || has(l, (long)tx_len(l, 200), "ok=13")) && has(l, (long)tx_len(l, 200), "fail=0")) {
        int raw_b = parse_ratchet_below(o, n, "cxraw: ok:");
        int libc_b = parse_ratchet_below(o, n, "cxlibc: ok:");
        if (raw_b > 5 || libc_b > 5)
            cx_fmt(ev, (size_t)cap, "%s WARN ratchet-slack cxraw_below=%d cxlibc_below=%d (run: sh ./unisacc.com tests/cxraw.cx -- --write && sh ./unisacc.com tests/cxlibc.cx -- --write)", l, raw_b, libc_b);
        else
            cx_fmt(ev, (size_t)cap, "%s", l);
        return 1;
    }
    {   char d[160]; line_with(o, n, "\tFAIL\t", d, sizeof d);
        if (d[0]) cx_fmt(ev, (size_t)cap, "rc=%d %s; first: %.120s", rc, l[0] ? l : "no RATCHETS line", d);
        else cx_fmt(ev, (size_t)cap, "rc=%d %s", rc, l[0] ? l : "no RATCHETS line"); }
    return 0;
}
static int j_tri(const char *o, long n, int rc, char *ev, int cap) {
    char l[160]; line_with(o, n, "CXMOD_TRI\t", l, sizeof l);
    if (rc == 0 && l[0] && has(l, (long)tx_len(l, 200), "failed=0")) { cx_fmt(ev, (size_t)cap, "%s", l); return 1; }
    cx_fmt(ev, (size_t)cap, "rc=%d %s", rc, l[0] ? l : "no CXMOD_TRI line"); return 0;
}
static int j_extract(const char *o, long n, int rc, char *ev, int cap) {
    char l[160]; line_with(o, n, "CX0_EXTRACT\tEXACT", l, sizeof l);
    if (rc == 0 && l[0]) { cx_fmt(ev, (size_t)cap, "%.140s", l); return 1; }
    line_with(o, n, "CX0_EXTRACT", l, sizeof l);
    cx_fmt(ev, (size_t)cap, "rc=%d %s", rc, l[0] ? l : "no CX0_EXTRACT line"); return 0;
}
static void j_chain_count(const char *o, long n, long *npass_out, long *nfail_out, char *first_fail, int fcap) {
    long at = 0, nfail = 0, npass = 0;
    while (at < n) {
        long e = tx_chr(o + at, n - at, '\n'), ln = e < 0 ? n - at : e;
        if (tx_prefix(o + at, ln, "FAIL\t", 5)) {
            if (!nfail && first_fail && !first_fail[0]) {
                long k = ln < fcap - 1 ? ln : fcap - 1;
                mm_copy(first_fail, (size_t)fcap, o + at, (size_t)k); first_fail[k] = 0;
            }
            nfail++;
        } else if (tx_prefix(o + at, ln, "PASS\t", 5)) npass++;
        at += (e < 0 ? n - at : e + 1);
    }
    *npass_out = npass; *nfail_out = nfail;
}
static int j_chain(const char *o, long n, int rc, char *ev, int cap) {
    char l[160]; long nfail = 0, npass = 0;
    l[0] = 0;
    j_chain_count(o, n, &npass, &nfail, l, sizeof l);
    if (rc == 0 && nfail == 0 && npass > 0) { cx_fmt(ev, (size_t)cap, "rc=0 pass=%ld fail=0", npass); return 1; }
    if (nfail) cx_fmt(ev, (size_t)cap, "rc=%d pass=%ld fail=%ld first: %s", rc, npass, nfail, l);
    else cx_fmt(ev, (size_t)cap, "rc=%d pass=%ld, no FAIL row", rc, npass);
    return 0;
}
static int j_chain_agg(int nshards, const char **snames, const char **outs, const long *lens, const int *rcs, char *ev, int cap) {
    long tot_pass = 0, tot_fail = 0; int i, bad = 0, bad_rc = 0;
    char bad_desc[320], shard_desc[240], first_fail[160];
    long bdn = 0, sdn = 0;
    bad_desc[0] = 0; shard_desc[0] = 0; first_fail[0] = 0;
    for (i = 0; i < nshards; i++) {
        long spass = 0, sfail = 0, ol;
        char one[120];
        j_chain_count(outs[i] ? outs[i] : "", lens[i], &spass, &sfail, first_fail, sizeof first_fail);
        tot_pass += spass; tot_fail += sfail;
        cx_fmt(one, sizeof one, "%s%s=%ld", sdn ? "," : "", snames[i], spass);
        ol = (long)tx_len(one, sizeof one);
        if (sdn + ol < (long)sizeof shard_desc - 1) { mm_copy(shard_desc + sdn, sizeof shard_desc - (size_t)sdn, one, (size_t)ol + 1); sdn += ol; }
        if (rcs[i] != 0 || sfail > 0 || spass == 0) {
            bad++;
            if (!bad_rc && rcs[i]) bad_rc = rcs[i];
            cx_fmt(one, sizeof one, "%s%s(rc=%d%s,pass=%ld,fail=%ld)", bdn ? "," : "", snames[i], rcs[i], rcs[i] == 142 ? ",timeout" : "", spass, sfail);
            ol = (long)tx_len(one, sizeof one);
            if (bdn + ol < (long)sizeof bad_desc - 1) { mm_copy(bad_desc + bdn, sizeof bad_desc - (size_t)bdn, one, (size_t)ol + 1); bdn += ol; }
        }
    }
    if (bad == 0 && tot_fail == 0) {
        if (tot_pass < CHAIN_PASS_BASELINE) {
            cx_fmt(ev, (size_t)cap, "rc=0 pass=%ld fail=0 (<%d baseline: assertion count regressed; %s)", tot_pass, CHAIN_PASS_BASELINE, shard_desc);
            return 0;
        }
        cx_fmt(ev, (size_t)cap, "rc=0 pass=%ld fail=0 (baseline=%d shards=%d: %s)", tot_pass, CHAIN_PASS_BASELINE, nshards, shard_desc);
        return 1;
    }
    cx_fmt(ev, (size_t)cap, "rc=%d pass=%ld fail=%ld failed_shard=%s%s%s", bad_rc ? bad_rc : 1, tot_pass, tot_fail, bad_desc, first_fail[0] ? " first: " : "", first_fail);
    return 0;
}
static int j_chain_shards_text(const char *o, long n, int rc, char *ev, int cap) {
    char names_buf[8][32]; const char *snames[8], *outs[8]; long lens[8]; int rcs[8], ns = 0;
    long at = 0, cur_start = -1;
    while (at < n) {
        long e = tx_chr(o + at, n - at, '\n'), ln = e < 0 ? n - at : e;
        if (ln > 6 && tx_prefix(o + at, ln, "SHARD\t", 6) && ns < 8) {
            const char *p = o + at + 6; long rem = ln - 6, t1 = tx_chr(p, rem, '\t');
            if (cur_start >= 0 && ns > 0) lens[ns - 1] = (at - cur_start);
            if (t1 > 0 && t1 < 31) {
                int64_t rv = rc;
                mm_copy(names_buf[ns], sizeof names_buf[ns], p, (size_t)t1); names_buf[ns][t1] = 0;
                if (rem - t1 - 1 > 3 && tx_prefix(p + t1 + 1, rem - t1 - 1, "rc=", 3)) {
                    tx_to_i64(p + t1 + 4, rem - t1 - 4, 10, &rv);
                }
                snames[ns] = names_buf[ns]; rcs[ns] = (int)rv;
                cur_start = at + (e < 0 ? n - at : e + 1);
                outs[ns] = o + cur_start; lens[ns] = 0;
                ns++;
            }
        }
        at += (e < 0 ? n - at : e + 1);
    }
    if (cur_start >= 0 && ns > 0) lens[ns - 1] = n - cur_start;
    if (ns == 0) { snames[0] = "all"; outs[0] = o; lens[0] = n; rcs[0] = rc; ns = 1; }
    return j_chain_agg(ns, snames, outs, lens, rcs, ev, cap);
}
static int j_affected(const char *o, long n, int rc, char *ev, int cap) {
    char l[160]; line_with(o, n, "FAIL", l, sizeof l);
    if (rc == 0) { cx_fmt(ev, (size_t)cap, "rc=0 %ld bytes of output, no failure", n); return 1; }
    if (rc == 3) {   /* affected.cx: return fail ? 1 : deferred ? 3 : 0 -- deferred batches, no FAIL: not measured */
        char s[160]; line_with(o, n, "AFFECTED_RUN", s, sizeof s);
        if (!l[0] && s[0]) { cx_fmt(ev, (size_t)cap, "rc=3 deferred, no FAIL: %s", s); return 2; }
    }
    cx_fmt(ev, (size_t)cap, "rc=%d %s", rc, l[0] ? l : "affected --run nonzero"); return 0;
}
/* a pgrep -af listing: 1 when no chain process besides this tool, pgrep and shell wrappers */
static int j_inflight(const char *o, long n, char *ev, int cap) {
    long at = 0, hits = 0; char first[160]; first[0] = 0;
    while (at < n) {
        long e = tx_chr(o + at, n - at, '\n'), ln = e < 0 ? n - at : e;
        if (ln > 0 && !has(o + at, ln, "chain-ready") && !has(o + at, ln, "pgrep") && !has(o + at, ln, "bash -c") && !has(o + at, ln, "sh -c")
            && !has(o + at, ln, "tools/bound")) {
            if (!hits) { long k = ln < 120 ? ln : 120; mm_copy(first, sizeof first, o + at, (size_t)k); first[k] = 0; }
            hits++;
        }
        at += ln + 1;
    }
    if (hits) { cx_fmt(ev, (size_t)cap, "%ld chain process(es) running, first: %s", hits, first); return 0; }
    put_ev(ev, cap, "no candidate-chain process"); return 1;
}
static int j_slot(const char *o, long n, int rc, char *ev, int cap) {
    char l[200];
    line_with(o, n, "VERSION_SLOT\tOK", l, sizeof l);
    if (rc == 0 && l[0]) { put_ev(ev, cap, l); return 1; }
    line_with(o, n, "CHAIN_READY_VERSION_SLOT", l, sizeof l);
    cx_fmt(ev, (size_t)cap, "rc=%d %s", rc, l[0] ? l : "REFUSE CHAIN_READY_VERSION_SLOT no verdict line"); return 0;
}
static int j_genall(const char *o, long n, int rc, char *ev, int cap) {
    char l[200];
    line_with(o, n, "GEN_ALL_SUMMARY\t", l, sizeof l);
    if (rc == 0 && l[0] && has(l, (long)tx_len(l, 200), "diff=0") && has(l, (long)tx_len(l, 200), "error=0")) {
        put_ev(ev, cap, l); return 1;
    }
    {
        char d[200];
        line_with(o, n, "\tDIFF\t", d, sizeof d);
        if (!d[0]) line_with(o, n, "\tERROR\t", d, sizeof d);
        cx_fmt(ev, (size_t)cap, "rc=%d %s; first: %s", rc, l[0] ? l : "no GEN_ALL_SUMMARY", d[0] ? d : "none");
    }
    return 0;
}
/* one P1 child output: 1 when the file was planned or rejected with an old message, 0 on a new rejection */
static int j_p1file(const char *o, long n) {
    int i;
    for (i = 0; i < NEWMSG_N; i++) if (has(o, n, newmsg[i])) return 0;
    return 1;
}

static int judge_kind(const char *kind, const char *o, long n, int rc, char *ev, int cap) {
    long kl = (long)tx_len(kind, 256);
    if (tx_eqz(kind, "rev")) return j_rev(o, n, rc, ev, cap);
    if (tx_eqz(kind, "branch")) return j_branch(o, n, ev, cap);
    if (tx_eqz(kind, "derive") || tx_eqz(kind, "derive2")) return j_derive(o, n, rc, ev, cap);
    if (kl > 7 && tx_prefix(kind, kl, "derive:", 7)) return j_derive_shard(o, n, rc, kind + 7, ev, cap);
    if (tx_eqz(kind, "ratchets")) return j_ratchets(o, n, rc, ev, cap);
    if (tx_eqz(kind, "tri")) return j_tri(o, n, rc, ev, cap);
    if (tx_eqz(kind, "extract")) return j_extract(o, n, rc, ev, cap);
    if (tx_eqz(kind, "chain")) return j_chain(o, n, rc, ev, cap);
    if (tx_eqz(kind, "chain-shards")) return j_chain_shards_text(o, n, rc, ev, cap);
    if (tx_eqz(kind, "affected") || tx_prefix(kind, (long)tx_len(kind, 64), "affected:", 9)) return j_affected(o, n, rc, ev, cap);
    if (tx_eqz(kind, "inflight")) return j_inflight(o, n, ev, cap);
    if (tx_eqz(kind, "slot")) return j_slot(o, n, rc, ev, cap);
    if (tx_eqz(kind, "genall")) return j_genall(o, n, rc, ev, cap);
    if (tx_eqz(kind, "p1file")) { put_ev(ev, cap, "p1file"); return j_p1file(o, n); }
    put_ev(ev, cap, "unknown judge kind"); return -1;
}

/* ---- processes ---- */
static void slurp(int fd, char **buf, long *n) {
    long cap = 1 << 16, r; char *b = mm_alloc(cap);
    *n = 0;
    while (b && (r = sy_read(fd, b + *n, cap - 1 - *n)) > 0) {
        *n += r;
        if (*n + 1 >= cap) { char *g = mm_grow(b, cap * 2); if (!g) break; b = g; cap *= 2; }
    }
    if (b) b[*n] = 0;
    *buf = b;
}
static int start(Job *j) {
    long deadline_ms = 0; (void)deadline_ms;   /* the deadline lives in the ./tools/bound argv prefix */
    j->t0 = sy_now_ms();
    j->out = 0; j->n = 0; j->cap = 0; j->rc = -1;
    /* every argv here starts with ./tools/bound SECONDS: the child is bound-limited */
    j->pid = sy_spawn_pipe(j->argv, 0, 0, &j->ofd, 0);   /* stderr merged into the pipe */
    if (j->pid > 0) {
        j->cap = 1 << 16;
        j->out = mm_alloc(j->cap);
        if (j->out) j->out[0] = 0;
        j->state = 1;
        return 0;
    }
    j->state = 3;
    return -1;
}
static void finish(Job *j) {
    int ex = 0, code = 0, sig = 0;
    if (j->state == 1) {
        long r;
        if (!j->out) { j->cap = 1 << 16; j->out = mm_alloc(j->cap); j->n = 0; }
        while (j->out && (r = sy_read(j->ofd, j->out + j->n, j->cap - 1 - j->n)) > 0) {
            j->n += r;
            if (j->n + 1 >= j->cap) { char *g = mm_grow(j->out, j->cap * 2); if (!g) break; j->out = g; j->cap *= 2; }
        }
        if (j->out) j->out[j->n] = 0;
        sy_close(j->ofd);
        j->rc = sy_wait_status(j->pid, 0, &ex, &code, &sig) == j->pid && ex ? code : -1;
    } else { j->out = 0; j->n = 0; j->rc = -1; }
    j->ms = sy_now_ms() - j->t0; j->state = 2;
}
static int calc_max_running(int *ncores_out, int *load1_out) {
    size_t n = 0; char *b; long at = 0; int ncores = 0, load1 = 0, max_r;
    const char *env = getenv("UNISACC_CHAIN_READY_JOBS");
    b = cx_read("/proc/cpuinfo", &n);
    while (b && at < (long)n) {
        long e = tx_chr(b + at, (long)n - at, '\n'), ln = e < 0 ? (long)n - at : e;
        if (ln > 9 && tx_prefix(b + at, ln, "processor", 9) && (b[at + 9] == '\t' || b[at + 9] == ' ' || b[at + 9] == ':')) ncores++;
        at += (e < 0 ? (long)n - at : e + 1);
    }
    if (b) mm_free(b);
    if (ncores < 1) ncores = 8;
    b = cx_read("/proc/loadavg", &n);
    if (b && n > 0) {
        long i = 0; int v = 0;
        while (i < (long)n && b[i] >= '0' && b[i] <= '9') { v = v * 10 + (b[i] - '0'); i++; }
        load1 = v;
    }
    if (b) mm_free(b);
    if (ncores_out) *ncores_out = ncores;
    if (load1_out) *load1_out = load1;
    if (env && env[0]) {
        int64_t ev = 0;
        if (!tx_to_i64(env, (long)tx_len(env, 16), 10, &ev) && ev >= 1 && ev <= MAXJ) return (int)ev;
    }
    if (load1 >= ncores) max_r = 4;
    else if (load1 >= ncores / 2) max_r = 5;
    else max_r = 6;
    return max_r;
}
static void argv_set(Job *j, const char *name, int bound, ...) {
    (void)bound; j->name = name;
}

static char failed_names[1024]; static int nfail;
static void row(const char *item, const char *st, const char *ev, long ms) {
    printf("%s\t%s\t%s\t%ld\n", item, st, ev, ms);
    if (tx_eqz(st, "FAIL") || tx_eqz(st, "SKIPPED")) {
        size_t l = tx_len(failed_names, sizeof failed_names);
        cx_fmt(failed_names + l, sizeof failed_names - l, "%s%s", l ? "," : "", item); nfail++;
    }
}
static void row_judged(const char *item, int ok, const char *ev, long ms) { row(item, ok == 2 ? "UNMEASURED" : ok ? "PASS" : "FAIL", ev, ms); }

/* The last published slot in the tracked ledger names the comparison tag. */
static int parse2_release_tag(const char *repo, char tag[64]) {
    char *av[] = {"git","show","HEAD:build/version-seq.tsv",0};
    char why[160];
    np_result r = {0};
    int ok = !np_run(av, repo, 0, 4, &r, why, sizeof why) && !r.rc && !r.residue;
    if (ok) for (char *p = r.out; p && *p;) {
        char *end = strchr(p, '\n');
        if (!end) { ok = 0; break; }
        *end++ = 0;
        char *version = strchr(p, '\t');
        char *class_name = version ? strchr(version + 1, '\t') : 0;
        char *state = class_name ? strchr(class_name + 1, '\t') : 0;
        char *note = state ? strchr(state + 1, '\t') : 0;
        if (note) {
            *class_name = 0;
            *note = 0;
            if (!strcmp(state + 1, "已公开") &&
                (!rv_valid(version + 1) || cx_fmt(tag, 64, "refs/tags/v%s", version + 1))) {
                ok = 0;
                break;
            }
        }
        p = end;
    }
    np_free(&r);
    return ok && tag[0];
}

static int parse2_commit(const char *repo, const char *ref, char sha[41]) {
    char object[256], why[160];
    if (cx_fmt(object, sizeof object, "%s^{commit}", ref)) return 0;
    char *av[] = {"git","rev-parse","--verify","--end-of-options",object,0};
    np_result r = {0};
    int ok = !np_run(av, repo, 0, 4, &r, why, sizeof why) && !r.rc && !r.residue &&
        r.out && r.outn == 41 && r.out[40] == '\n' && strspn(r.out, "0123456789abcdef") == 40;
    if (ok) ok = !tx_copy(sha, 41, r.out, 40);
    np_free(&r);
    return ok;
}

static int parse2_preflight(const char *repo, const char *rev, const char *tmp, char ev[640]) {
    char tag[64] = "", base[41], tip[41], why[200], archive[4400], gen[4400], json[4400];
    const char *fix = "fix: 修复指名事实并提交后重跑 sh ./unisacc.com tools/chain-ready.cx -- --only 18 --rev HEAD";
    if (!parse2_release_tag(repo, tag) || !parse2_commit(repo, tag, base) ||
        !parse2_commit(repo, rev ? rev : "HEAD", tip)) {
        cx_fmt(ev, 640, "READY=no parse2-gen-identity base=%s %s", tag, fix);
        return 0;
    }
    char *diff[] = {"git","diff","--no-ext-diff","--quiet",base,tip,"--","exec/parse2","seed/gen.c",0};
    np_result r = {0};
    int ran = !np_run(diff, repo, 0, 5, &r, why, sizeof why) && !r.residue;
    int changed = r.rc;
    np_free(&r);
    if (ran && changed == 0) {
        cx_fmt(ev, 640, "base=%s rev=%s parse2-inputs-unchanged", base, tip);
        return 1;
    }
    const char *stage = "snapshot";
    if (!ran || changed != 1 || !tmp ||
        cx_fmt(archive,sizeof archive,"%s/tree.tar",tmp) ||
        cx_fmt(gen,sizeof gen,"%s/seed-gen",tmp) || cx_fmt(json,sizeof json,"%s/parse2.json",tmp)) {
        cx_fmt(ev, 640, "READY=no parse2-gen-diff-or-layout rc=%d %s", changed, fix);
        return 0;
    }
    char *pack[] = {"git","archive","-o",archive,tip,"exec","seed",0};
    char *extract[] = {"tar","-xf",archive,"-C",(char *)tmp,0};
    char *build[] = {"gcc","-std=c99","-O2","-w","-I","seed","seed/gen.c","-o",gen,0};
    char *recipe[] = {gen,"parse2",json,"--locations",0};
    char **steps[] = {pack,extract,build,recipe};
    const char *names[] = {"snapshot","extract","build","gen-shared-e3"};
    int limits[] = {6,5,16,10};
    int ok = 1;
    for (int i = 0; i < 4; i++) {
        stage = names[i];
        ok = !np_run(steps[i], i == 0 ? repo : tmp, 0, limits[i], &r, why, sizeof why) &&
            !r.rc && !r.residue;
        if (!ok) break;
        np_free(&r);
    }
    sy_stat_t st;
    if (ok && !sy_lstat(json,&st) && st.kind == 'f' && st.size > 0)
        cx_fmt(ev,640,"base=%s rev=%s gen-shared-e3 rc=0",base,tip);
    else {
        char detail[180];
        line_with(r.err ? r.err : "", (long)r.errn, "seed-gen:", detail, sizeof detail);
        cx_fmt(ev,640,"READY=no %s rc=%d rev=%s %s %s",stage,r.rc,tip,detail,fix);
        ok = 0;
    }
    np_free(&r);
    return ok;
}

/* P1: all .cx files holding "#pragma unisa use", LANES lanes of cx0_plan children, BATCH files per child
 * (check-cxmod-tri --cx0-batch: one "@@FILE\t<path>" segment per file, judged per file exactly as the old single --cx0 child) */
#define LANES 16
#define BATCH 16
/* negative fixtures refused on purpose (check-install-fixes iproto; cxclash "must still be refused"; symindex proto) */
static int is_negfix(const char *nm) {
    long n = (long)tx_len(nm, 512);
    /* exact files only: helpers in those directories (cxclash left/ right/, iproto mid.cx, symindex proto libs) are ordinary inputs */
    return tx_eqz(nm, "tests/cxclash/main.cx") || tx_eqz(nm, "tools/install-fixes/iproto/main.cx") || tx_eqz(nm, "tools/install-fixes/iproto/user.cx") || tx_eqz(nm, "tools/symindex/fixture/proto/user.cx") || tx_eqz(nm, "tests/cxpack/bad-call/main.cx") || tx_eqz(nm, "tests/export/x10-use-unexported/main.cx") || tx_eqz(nm, "tests/export/x11-call-private/main.cx") || tx_eqz(nm, "tests/diagfx/q_sym.cx");
}
static void run_p1(long *ms_out, char *ev, int cap) {
    long negok = 0, t0 = sy_now_ms(), nfiles = 0, rejected = 0, newrej = 0, failed_start = 0, at = 0;
    char *lb; long ln; int fd, pid, ex = 0, code = 0, sig = 0; char *gv[] = {"./tools/bound", "30", "git", "ls-files", "-z", "--", "*.cx", ":!archive", 0};   /* archive/ is retired legacy, never in a chain build */
    char **names = 0; long ncap = 0, cnt = 0, next = 0; char first[160]; first[0] = 0;
    Job lane[LANES]; long lfrom[LANES], lnum[LANES]; int ready[LANES], i, active = 0;
    /* gv is ./tools/bound 30 git ls-files: bound-limited */
    pid = sy_spawn_pipe(gv, 0, 0, &fd, 0);
    if (pid <= 0) { put_ev(ev, cap, "cannot start git ls-files"); *ms_out = sy_now_ms() - t0; return; }
    slurp(fd, &lb, &ln); sy_close(fd); sy_wait_status(pid, 0, &ex, &code, &sig);
    while (lb && at < ln) {   /* NUL-separated; keep the ones that hold a use pragma; no cap (an old 1400 cap truncated silently) */
        long e = tx_chr(lb + at, ln - at, 0), len = e < 0 ? ln - at : e;
        if (len > 0) {
            size_t sz; char *src; lb[at + len] = 0; src = cx_read(lb + at, &sz);
            if (src) {
                if (has(src, (long)sz, "#pragma unisa use")) {
                    if (cnt == ncap) {
                        long nc = ncap ? ncap * 2 : 2048; char **g = names ? mm_grow(names, nc * (long)sizeof *names) : mm_alloc(nc * (long)sizeof *names);
                        if (!g) { mm_free(src); put_ev(ev, cap, "cannot grow file list"); *ms_out = -(sy_now_ms() - t0); return; }
                        names = g; ncap = nc;
                    }
                    names[cnt++] = lb + at;
                }
                mm_free(src);
            }
        }
        at += len + 1;
    }
    for (i = 0; i < LANES; i++) lane[i].state = 0;
    while (next < cnt || active > 0) {
        for (i = 0; i < LANES; i++) {
            if (lane[i].state == 0 && next < cnt) {
                static const char *fixed[] = {"./tools/bound", "40", "sh", UC, "tools/check-cxmod-tri.cx", "--", "--cx0-batch"};
                int k; for (k = 0; k < 7; k++) lane[i].argv[k] = (char *)fixed[k];
                lfrom[i] = next;
                for (k = 0; k < BATCH && next < cnt; k++) lane[i].argv[7 + k] = names[next++];
                lane[i].argv[7 + k] = 0; lnum[i] = k; lane[i].name = lane[i].argv[7];
                if (start(&lane[i]) == 0) active++; else { failed_start += lnum[i]; nfiles += lnum[i]; lane[i].state = 0; }
            }
        }
        {   /* collect a lane whose child closed its pipe (POLLHUP), not lane order: a slow batch must not idle the others */
            sy_pollfd_t pf[LANES]; int pl[LANES], np = 0, pr;
            for (i = 0; i < LANES; i++) { ready[i] = 0; if (lane[i].state == 1) { pf[np].fd = lane[i].ofd; pf[np].events = 0; pf[np].revents = 0; pl[np++] = i; } }
            pr = np ? sy_poll(pf, np, 1000) : 0;
            if (pr < 0) { for (i = 0; i < np; i++) ready[pl[i]] = 1; }   /* poll failed: fall back to blocking collect */
            else for (i = 0; i < np; i++) if (pf[i].revents & (SY_POLLHUP | SY_POLLERR | SY_POLLNVAL)) ready[pl[i]] = 1;
        }
        for (i = 0; i < LANES; i++) {
            if (lane[i].state == 1 && ready[i]) {
                long f, pos = 0;
                finish(&lane[i]);
                for (f = 0; f < lnum[i]; f++) {   /* every file of the batch gets its own segment and verdict */
                    const char *nm = names[lfrom[i] + f]; char hd[600]; long hs, so, se, sl;
                    nfiles++;
                    cx_fmt(hd, sizeof hd, "@@FILE\t%s\n", nm);
                    hs = lane[i].out ? tx_find(lane[i].out + pos, lane[i].n - pos, hd, (long)tx_len(hd, sizeof hd)) : -1;
                    if (lane[i].rc != 0 || hs != 0) {   /* child failed or segment missing / out of order: this file failed */
                        failed_start++; if (!first[0]) cx_fmt(first, sizeof first, "child-failed %.100s", nm);
                        if (hs < 0) { pos = lane[i].n; continue; }
                    }
                    so = pos + hs + (long)tx_len(hd, sizeof hd);
                    se = tx_find(lane[i].out + so, lane[i].n - so, "@@", 2);
                    sl = se < 0 ? lane[i].n - so : se; pos = so + sl;
                    if (lane[i].rc != 0) continue;
                    if (!has(lane[i].out + so, sl, "RC=0")) rejected++;
                    /* deliberate negative fixtures must stay refused with a new-text diagnostic; one that is accepted is a failure */
                    if (is_negfix(nm)) { if (j_p1file(lane[i].out + so, sl)) { newrej++; if (!first[0]) cx_fmt(first, sizeof first, "negfix-accepted %.100s", nm); } else negok++; }
                    else if (!j_p1file(lane[i].out + so, sl)) { newrej++; if (!first[0]) cx_fmt(first, sizeof first, "%.120s", nm); }
                }
                if (lane[i].rc == 0 && (!lane[i].out || !has(lane[i].out + pos, lane[i].n - pos, "@@END\t"))) { failed_start++; if (!first[0]) cx_fmt(first, sizeof first, "batch-no-end %.100s", lane[i].name); }
                if (lane[i].out) mm_free(lane[i].out);
                lane[i].state = 0; active--;
            }
        }
    }
    cx_fmt(ev, (size_t)cap, "%ld files planned by cx0_plan, rejected(any text)=%ld, new-text rejections=%ld, negative fixtures still refused=%ld%s%s, child failures=%ld",
           nfiles, rejected, newrej, negok, first[0] ? " first=" : "", first, failed_start);
    *ms_out = sy_now_ms() - t0;
    if (newrej || failed_start) { *ms_out = -*ms_out; }
}

/* ---- 12-14: the product files the chain starts from (0.0.81: four failed starts, 33 minutes) ---- */
/* 1 regular file (lstat, no symbolic link), 0 otherwise; KIND gets a word */
static int rf_regular(const char *p, const char **kind) {
    sy_stat_t st;
    if (sy_lstat(p, &st) != 0) { *kind = "missing"; return 0; }
    if (st.kind == 'l') { *kind = "symlink"; return 0; }
    if (st.kind != 'f') { *kind = "not-regular"; return 0; }
    *kind = "regular"; return 1;
}
/* sha256 of file P into HEX[65]; 0, or -1 */
static int rf_sha(const char *p, char *hex) {
    size_t n; char *b = cx_read(p, &n); int r;
    hex[0] = 0;
    if (!b) return -1;
    r = sy_sha256_hex(b, (long)n, hex); mm_free(b);
    return r ? -1 : 0;
}
/* JSON string or number field KEY of J (flat record) into DST; 1 found */
static int rf_field(const char *j, long n, const char *key, char *dst, int cap) {
    char pat[80]; long at, i, k = 0;
    dst[0] = 0;
    cx_fmt(pat, sizeof pat, "\"%s\"", key);
    at = tx_find(j, n, pat, (long)tx_len(pat, sizeof pat));
    if (at < 0) return 0;
    i = at + (long)tx_len(pat, sizeof pat);
    while (i < n && (j[i] == ' ' || j[i] == ':' || j[i] == '\t')) i++;
    if (i < n && j[i] == '"') i++;
    while (i < n && j[i] != '"' && j[i] != ',' && j[i] != '\n' && j[i] != '}' && k < cap - 1) dst[k++] = j[i++];
    while (k > 0 && dst[k - 1] == ' ') k--;
    dst[k] = 0; return k > 0;
}
/* commit column of release/candidate.tsv row whose version column is VER; 1 found */
static int rf_cand_commit(const char *repo, const char *ver, char *dst, int cap) {
    char p[4400]; size_t n; char *b; long at = 0; int found = 0;
    dst[0] = 0;
    cx_fmt(p, sizeof p, "%s/release/candidate.tsv", repo);
    b = cx_read(p, &n);
    if (!b) return 0;
    while (at < (long)n && !found) {
        long e = tx_chr(b + at, (long)n - at, '\n'), ln = e < 0 ? (long)n - at : e;
        char *f[5]; long fl[5]; int c = 0; long s = at, x;
        for (x = at; x <= at + ln && c < 5; x++) if (x == at + ln || b[x] == '\t') { f[c] = b + s; fl[c] = x - s; c++; s = x + 1; }
        if (c >= 4 && fl[3] == (long)tx_len(ver, 64) && !memcmp(f[3], ver, (size_t)fl[3]) && fl[2] > 0 && fl[2] < cap) {
            mm_copy(dst, (size_t)cap, f[2], (size_t)fl[2]); dst[fl[2]] = 0; found = 1;
        }
        at += ln + 1;
    }
    mm_free(b); return found;
}
static void root_items(const char *repo, const char *root, const char *revarg, const char *only) {
    static const char *names[2] = {"unisacc.com", "unisacc.com.build.json"};
    char p[4400], ev[1200], rsha[2][65]; int i, ok; long t0 = sy_now_ms();
    int rok[2]; const char *kind;
    /* 12: ROOT files must be regular (source-package lstat REFUSE root-epoch-product-stat, epoch-canonical no record) */
    ok = 1; ev[0] = 0;
    for (i = 0; i < 2; i++) {
        cx_fmt(p, sizeof p, "%s/%s", root, names[i]);
        rok[i] = rf_regular(p, &kind); rsha[i][0] = 0;
        if (rok[i]) rf_sha(p, rsha[i]);
        else if (ok) { ok = 0; cx_fmt(ev, sizeof ev, "READY=no worktree-root-file-not-regular path=%s kind=%s fix: cp --remove-destination the real file (cp -L) into ROOT", p, kind); }
    }
    if (ok) cx_fmt(ev, sizeof ev, "unisacc.com and unisacc.com.build.json under %s are regular files", root);
    if (!only || tx_prefix("12-root-files", 13, only, (long)tx_len(only, 64))) row_judged("12-root-files", ok, ev, sy_now_ms() - t0);
    /* 12p: the preflight entry of chain-run reads ROOT/unisacc.com.build.json before anything else */
    if (!only || tx_prefix("12p-preflight-entry", 19, only, (long)tx_len(only, 64))) {
        cx_fmt(p, sizeof p, "%s/unisacc.com.build.json", root);
        if (rf_regular(p, &kind)) cx_fmt(ev, sizeof ev, "preflight entry record %s is a regular file", p);
        else cx_fmt(ev, sizeof ev, "READY=no preflight-entry-build-json path=%s kind=%s fix: cp --remove-destination -L REAL_REPO/unisacc.com.build.json %s/", p, kind, root);
        row_judged("12p-preflight-entry", rf_regular(p, &kind), ev, sy_now_ms() - t0);
    }
    /* 13: a snapshot of the same revision is reused by chain-step snap without a file-type check */
    if (!only || tx_prefix("13-snap-cache", 13, only, (long)tx_len(only, 64))) {
        char rev[64], snap[4600]; t0 = sy_now_ms(); rev[0] = 0;
        if (revarg) cx_fmt(rev, sizeof rev, "%s", revarg);
        else {
            Job g; char *gv[] = {"./tools/bound", "20", "git", "-C", (char *)root, "rev-parse", "HEAD", 0}; int x;
            for (x = 0; gv[x]; x++) g.argv[x] = gv[x]; g.argv[x] = 0;
            start(&g); finish(&g);
            if (g.rc == 0 && g.out && g.n >= 40) { mm_copy(rev, sizeof rev, g.out, 40); rev[40] = 0; }
            if (g.out) mm_free(g.out);
        }
        if (!rev[0] || cr_snap(root, rev, 0, snap, sizeof snap)) {
            cx_fmt(ev, sizeof ev, "READY=no snap-cache-path-unknown root=%s rev=%.40s fix: run inside a git checkout or pass --rev", root, rev[0] ? rev : "(none)");
            row_judged("13-snap-cache", 0, ev, sy_now_ms() - t0);
        } else if (!sy_exists(snap)) {
            cx_fmt(ev, sizeof ev, "no snapshot cache for rev %.10s at %s: the chain builds a fresh one", rev, snap);
            row_judged("13-snap-cache", 1, ev, sy_now_ms() - t0);
        } else {
            ok = 1;
            for (i = 0; i < 2 && ok; i++) {
                char sh[65];
                cx_fmt(p, sizeof p, "%s/%s", snap, names[i]);
                if (!rf_regular(p, &kind)) { ok = 0; cx_fmt(ev, sizeof ev, "READY=no snap-cache-file-not-regular path=%s kind=%s fix: mv %s %s.stale-$(date +%%s) (not removed automatically)", p, kind, snap, snap); }
                else if (rf_sha(p, sh) || !rsha[i][0] || !tx_eqz(sh, rsha[i])) { ok = 0; cx_fmt(ev, sizeof ev, "READY=no snap-cache-stale path=%s snap-sha=%.16s root-sha=%.16s fix: mv %s %s.stale-$(date +%%s) (not removed automatically)", p, sh, rsha[i][0] ? rsha[i] : "(none)", snap, snap); }
            }
            if (ok) cx_fmt(ev, sizeof ev, "snapshot %s holds regular unisacc.com and build.json equal to ROOT", snap);
            row_judged("13-snap-cache", ok, ev, sy_now_ms() - t0);
        }
    }
    /* 14: the build record describes the APE beside it; commit agrees with release/candidate.tsv for its version */
    if (!only || tx_prefix("14-root-record", 14, only, (long)tx_len(only, 64))) {
        char rp[4400], dig[80], bytes[40], commit[80], src[80], ver[64], cc[80]; size_t rn; char *rec;
        t0 = sy_now_ms();
        cx_fmt(rp, sizeof rp, "%s/unisacc.com.build.json", root);
        rec = (rok[0] && rok[1]) ? cx_read(rp, &rn) : 0;
        if (!rec) { row_judged("14-root-record", 0, "READY=no root-record-unreadable fix: repair 12-root-files first", sy_now_ms() - t0); return; }
        rf_field(rec, (long)rn, "product_digest", dig, sizeof dig); rf_field(rec, (long)rn, "bytes", bytes, sizeof bytes);
        rf_field(rec, (long)rn, "commit", commit, sizeof commit); rf_field(rec, (long)rn, "sources_sha256", src, sizeof src);
        mm_free(rec);
        {   sy_stat_t st; char want[40]; cx_fmt(p, sizeof p, "%s/unisacc.com", root); sy_lstat(p, &st); cx_fmt(want, sizeof want, "%ld", (long)st.size);
            if (!tx_eqz(dig, rsha[0]) || !tx_eqz(bytes, want)) {
                cx_fmt(ev, sizeof ev, "READY=no root-record-digest-mismatch product_digest=%.16s sha=%.16s bytes=%s size=%s fix: reinstall the Root (tools/install-ape) so the record matches the APE", dig, rsha[0], bytes, want);
                row_judged("14-root-record", 0, ev, sy_now_ms() - t0); return;
            }
        }
        ver[0] = 0;
        {   Job g; char *gv[] = {"./tools/bound", "20", "sh", p, "--version", 0}; int x; long q;
            for (x = 0; gv[x]; x++) g.argv[x] = gv[x]; g.argv[x] = 0;
            start(&g); finish(&g);
            if (g.rc == 0 && g.out) {   /* "unisacc 0.0.80" */
                long sp = tx_chr(g.out, g.n, ' '); long k = 0;
                for (q = sp + 1; sp >= 0 && q < g.n && g.out[q] != '\n' && g.out[q] != ' ' && k < 63; q++) ver[k++] = g.out[q];
                ver[k] = 0;
            }
            if (g.out) mm_free(g.out);
        }
        if (ver[0] && rf_cand_commit(repo, ver, cc, sizeof cc)) {
            if (!tx_eqz(commit, cc)) {
                cx_fmt(ev, sizeof ev, "READY=no root-record-commit-mismatch version=%s record-commit=%.40s candidate-commit=%.40s fix: rewrite the record from release/candidate.tsv or reinstall the Root", ver, commit[0] ? commit : "(none)", cc);
                row_judged("14-root-record", 0, ev, sy_now_ms() - t0); return;
            }
            cx_fmt(ev, sizeof ev, "product_digest and bytes match the APE; commit %.12s equals release/candidate.tsv %s; WARN root-record-stale-fields sources_sha256 not verifiable from the APE", commit, ver);
        } else
            cx_fmt(ev, sizeof ev, "product_digest and bytes match the APE; WARN root-record-stale-fields version=%s has no release/candidate.tsv row: commit and sources_sha256 not verified", ver[0] ? ver : "(unknown)");
        row_judged("14-root-record", 1, ev, sy_now_ms() - t0);
    }
}

static int is_pos_int_str(const char *s, long n, long *val) {
    long i, v = 0;
    if (n <= 0 || n > 9) return 0;
    for (i = 0; i < n; i++) {
        if (s[i] < '0' || s[i] > '9') return 0;
        v = v * 10 + (s[i] - '0');
    }
    if (v <= 0) return 0;
    *val = v;
    return 1;
}

static int lane_a_file(const char *lbuf, long llen, const char *path, long plen) {
    long at = 0;
    if (!lbuf || llen <= 0 || plen <= 0) return 0;
    if (tx_prefix(path, plen, "exec/", 5) || tx_prefix(path, plen, "kernel/", 7)) return 0;
    while (at < llen) {
        long e = tx_chr(lbuf + at, llen - at, '\n'), ln = e < 0 ? llen - at : e;
        if (ln > 0 && lbuf[at + ln - 1] == '\r') ln--;
        if (ln > plen + 2 && lbuf[at] != '#' &&
            tx_same(lbuf + at, plen, path, plen) &&
            lbuf[at + plen] == '\t' && lbuf[at + plen + 1] == 'A' &&
            (ln == plen + 2 || lbuf[at + plen + 2] == '\t')) {
            return 1;
        }
        at += (e < 0 ? llen - at : e + 1);
    }
    return 0;
}

static int check_version_scope(const char *repo, const char *revarg, const char *since, const char *tver, char *scope_ev, int cap) {
    char ver[64], planp[4400], lanep[4400], aclass[128], why[160], tag[64], base[64], tip[64];
    size_t pn = 0, ln = 0;
    char *pb = 0, *lb = 0;
    long at = 0, punits = -1, afcap = -1;
    int seen_pu = 0, seen_ac = 0, seen_cap = 0, a_count = 0;
    ver[0] = 0; aclass[0] = 0; scope_ev[0] = 0;
    if (tver && tver[0]) {
        const char *v = (tver[0] == 'v') ? tver + 1 : tver;
        cx_fmt(ver, sizeof ver, "%s", v);
    } else {
        char *bv[] = {"git", "rev-parse", "--abbrev-ref", "HEAD", 0};
        np_result r = {0};
        if (!np_run(bv, repo, 0, 5, &r, why, sizeof why) && !r.rc && r.out && r.outn > 5) {
            long l = (long)r.outn;
            while (l > 0 && (r.out[l - 1] == '\n' || r.out[l - 1] == '\r')) l--;
            if (l > 5 && tx_prefix(r.out, l, "v0.0.", 5)) {
                long k = 0, i;
                for (i = 1; i < l && (r.out[i] == '.' || (r.out[i] >= '0' && r.out[i] <= '9')) && k < 63; i++) ver[k++] = r.out[i];
                ver[k] = 0;
            }
        }
        np_free(&r);
    }
    if (!ver[0]) return 1;
    cx_fmt(planp, sizeof planp, "%s/plans/v%s.md", repo, ver);
    if (sy_exists(planp) != 1) {
        if (tver && tver[0]) {
            cx_fmt(scope_ev, (size_t)cap, "READY=no version-plan-missing version=%s path=%s", ver, planp);
            return 0;
        }
        return 1;
    }
    pb = cx_read(planp, &pn);
    if (!pb) {
        cx_fmt(scope_ev, (size_t)cap, "READY=no version-plan-unreadable path=%s", planp);
        return 0;
    }
    while (at < (long)pn) {
        long e = tx_chr(pb + at, (long)pn - at, '\n'), l = e < 0 ? (long)pn - at : e;
        const char *line = pb + at;
        if (l > 0 && line[l - 1] == '\r') l--;
        if (tx_prefix(line, l, "planned_units=", 14)) {
            const char *v = line + 14; long vl = l - 14;
            seen_pu++;
            if (!is_pos_int_str(v, vl, &punits)) {
                cx_fmt(scope_ev, (size_t)cap, "READY=no planned-units-not-number version=%s planned_units=%.*s", ver, (int)vl, v);
                mm_free(pb); return 0;
            }
        } else if (tx_prefix(line, l, "a_class=", 8)) {
            const char *v = line + 8; long vl = l - 8, i;
            while (vl > 0 && (*v == ' ' || *v == '\t')) { v++; vl--; }
            while (vl > 0 && (v[vl - 1] == ' ' || v[vl - 1] == '\t')) vl--;
            seen_ac++;
            if (vl <= 0 || vl >= (long)sizeof aclass || seen_ac > 1) {
                cx_fmt(scope_ev, (size_t)cap, "READY=no a-class-not-unique version=%s a_class=%.*s count=%d", ver, (int)vl, v, seen_ac);
                mm_free(pb); return 0;
            }
            for (i = 0; i < vl; i++) {
                if (v[i] == ',' || v[i] == ';' || v[i] == '/' || v[i] == '+') {
                    cx_fmt(scope_ev, (size_t)cap, "READY=no a-class-not-unique version=%s a_class=%.*s", ver, (int)vl, v);
                    mm_free(pb); return 0;
                }
            }
            mm_copy(aclass, sizeof aclass, v, (size_t)vl); aclass[vl] = 0;
        } else if (tx_prefix(line, l, "a_files_cap=", 12)) {
            const char *v = line + 12; long vl = l - 12;
            seen_cap++;
            if (!is_pos_int_str(v, vl, &afcap)) {
                cx_fmt(scope_ev, (size_t)cap, "READY=no a-files-cap-invalid version=%s a_files_cap=%.*s", ver, (int)vl, v);
                mm_free(pb); return 0;
            }
        }
        at += (e < 0 ? (long)pn - at : e + 1);
    }
    mm_free(pb);
    if (!seen_pu || punits <= 0) {
        cx_fmt(scope_ev, (size_t)cap, "READY=no planned-units-not-number version=%s planned_units=missing", ver);
        return 0;
    }
    if (!seen_ac || !aclass[0]) {
        cx_fmt(scope_ev, (size_t)cap, "READY=no a-class-not-unique version=%s a_class=missing", ver);
        return 0;
    }
    if (!seen_cap || afcap <= 0) {
        cx_fmt(scope_ev, (size_t)cap, "READY=no a-files-cap-invalid version=%s a_files_cap=missing", ver);
        return 0;
    }
    cx_fmt(lanep, sizeof lanep, "%s/build/lane-inputs.tsv", repo);
    lb = cx_read(lanep, &ln);
    if (lb && ln > 0) {
        base[0] = 0; tag[0] = 0;
        if (since && since[0]) cx_fmt(base, sizeof base, "%s", since);
        else if (parse2_release_tag(repo, tag) && parse2_commit(repo, tag, base)) { /* use last public tag */ }
        else cx_fmt(base, sizeof base, "HEAD~1");
        cx_fmt(tip, sizeof tip, "%s", revarg && revarg[0] ? revarg : "HEAD");
        {
            char *dv[] = {"git", "diff", "--name-only", base, tip, 0};
            np_result r = {0};
            if (!np_run(dv, repo, 0, 10, &r, why, sizeof why) && !r.rc && r.out) {
                long p = 0, rn = (long)r.outn;
                while (p < rn) {
                    long e = tx_chr(r.out + p, rn - p, '\n'), l = e < 0 ? rn - p : e;
                    if (l > 0 && r.out[p + l - 1] == '\r') l--;
                    if (l > 0 && lane_a_file(lb, (long)ln, r.out + p, l)) a_count++;
                    p += (e < 0 ? rn - p : e + 1);
                }
            }
            np_free(&r);
        }
        mm_free(lb);
    }
    if (a_count > afcap) {
        cx_fmt(scope_ev, (size_t)cap, "READY=no a-files-over-cap version=%s a_files=%d cap=%ld a_class=%s", ver, a_count, afcap, aclass);
        return 0;
    }
    cx_fmt(scope_ev, (size_t)cap, "scope version=%s planned_units=%ld a_class=%s a_files=%d/%ld", ver, punits, aclass, a_count, afcap);
    return 1;
}

/* chain-preflight.cx bounds each node to its table timeout_s (<=55s) via tools/bound; total gate <=180s */
static int run_19_preflight(const char *repo, const char *root, const char *revarg, const char *since, const char *tver, const char *pftable, char *ev, int cap) {
    char *v[18]; int k = 0, fd = -1, pid, ex = 0, code = 0, sig = 0, pass = 0, node_timeout_bounded = 1;
    char *out = 0; long n = 0, at = 0;
    char fail_item[240], sum_line[240], scope_ev[320];
    (void)node_timeout_bounded;
    fail_item[0] = 0; sum_line[0] = 0; scope_ev[0] = 0;
    v[k++] = "sh"; v[k++] = UC; v[k++] = "tools/chain-preflight.cx"; v[k++] = "--";
    v[k++] = "--strict"; v[k++] = "--root"; v[k++] = (char *)root; v[k++] = "--repo"; v[k++] = (char *)repo;
    v[k++] = "--rev"; v[k++] = (char *)(revarg && revarg[0] ? revarg : "HEAD");
    if (pftable && pftable[0]) { v[k++] = "--table"; v[k++] = (char *)pftable; }
    v[k] = 0;
    pid = sy_spawn_pipe(v, 0, 0, &fd, 0);
    if (pid <= 0 || fd < 0) {
        cx_fmt(ev, (size_t)cap, "READY=no chain-preflight-not-started");
        return 0;
    }
    slurp(fd, &out, &n); sy_close(fd);
    sy_wait_status(pid, 0, &ex, &code, &sig);
    while (out && at < n) {
        long e = tx_chr(out + at, n - at, '\n'), ln = e < 0 ? n - at : e;
        if (tx_prefix(out + at, ln, "CHAIN_PREFLIGHT\t", 16)) {
            if (tx_find(out + at, ln, "\tverdict=PASS\t", 14) >= 0) pass = 1;
            line_with(out + at, ln, "CHAIN_PREFLIGHT", sum_line, sizeof sum_line);
        }
        if (!fail_item[0] && tx_prefix(out + at, ln, "PREFLIGHT_ITEM\t", 15) && tx_find(out + at, ln, "\tFAIL\t", 6) >= 0) {
            line_with(out + at, ln, "PREFLIGHT_ITEM", fail_item, sizeof fail_item);
        }
        at += (e < 0 ? n - at : e + 1);
    }
    if (out) mm_free(out);
    if (!pass || !ex || code != 0) {
        cx_fmt(ev, (size_t)cap, "READY=no chain-preflight rc=%d %s%s%s",
               ex ? code : -1, sum_line[0] ? sum_line : "no CHAIN_PREFLIGHT line",
               fail_item[0] ? "; first: " : "", fail_item);
        return 0;
    }
    if (!check_version_scope(repo, revarg, since, tver, scope_ev, sizeof scope_ev)) {
        cx_fmt(ev, (size_t)cap, "%s", scope_ev);
        return 0;
    }
    cx_fmt(ev, (size_t)cap, "%s%s%s", sum_line[0] ? sum_line : "CHAIN_PREFLIGHT verdict=PASS",
           scope_ev[0] ? "; " : "", scope_ev);
    return 1;
}

int main(int argc, char **argv) {
    int fast = 0, a; const char *repo = ".", *since = 0, *pat = "candidate-chain", *only = 0, *tver = 0, *rootarg = 0, *revarg = 0, *pftable = 0;
    long disk_override_gb = -1;
    long T0 = sy_now_ms();
    if (argc == 5 && tx_eqz(argv[1], "--judge")) {   /* --judge KIND FILE RC */
        size_t n; char *b = cx_read(argv[3], &n); char ev[512]; int ok;
        if (!b) { fprintf(stderr, "chain-ready: cannot read %s\n", argv[3]); return 2; }
        { int64_t rv = 0; tx_to_i64(argv[4], (long)tx_len(argv[4], 16), 10, &rv); ok = judge_kind(argv[2], b, (long)n, (int)rv, ev, sizeof ev); }
        if (ok < 0) { fprintf(stderr, "chain-ready: %s\n", ev); return 2; }
        printf("%s\t%s\n", ok == 2 ? "UNMEASURED" : ok ? "PASS" : "FAIL", ev);
        return 0;
    }
    for (a = 1; a < argc; a++) {
        if (tx_eqz(argv[a], "--fast")) fast = 1;
        else if (tx_eqz(argv[a], "--repo") && a + 1 < argc) repo = argv[++a];
        else if (tx_eqz(argv[a], "--since") && a + 1 < argc) since = argv[++a];
        else if (tx_eqz(argv[a], "--pgrep-pat") && a + 1 < argc) pat = argv[++a];
        else if (tx_eqz(argv[a], "--only") && a + 1 < argc) only = argv[++a];
        else if (tx_eqz(argv[a], "--version") && a + 1 < argc) tver = argv[++a];
        else if (tx_eqz(argv[a], "--root") && a + 1 < argc) rootarg = argv[++a];
        else if (tx_eqz(argv[a], "--rev") && a + 1 < argc) revarg = argv[++a];
        else if (tx_eqz(argv[a], "--preflight-table") && a + 1 < argc) pftable = argv[++a];
        else if (tx_eqz(argv[a], "--disk-free-gb") && a + 1 < argc) { int64_t dv = -1; tx_to_i64(argv[a + 1], (long)tx_len(argv[a + 1], 16), 10, &dv); disk_override_gb = (long)dv; a++; }
        else { fprintf(stderr, "usage: tools/chain-ready.cx [-- [--fast] [--repo DIR] [--root DIR] [--rev REV] [--since REV] [--pgrep-pat PAT] [--only ITEM-PREFIX] [--version V] [--preflight-table FILE] [--disk-free-gb N] | --judge KIND FILE RC]\n"); return 2; }
    }
    static Job J[MAXJ]; static char *items[MAXJ]; static int prios[MAXJ]; int nj = 0, k;
    char tmpd[300], outd[5][340], cached[340], chfiles[8192], changed[8192]; int have_tmp = 0;
    tmpd[0] = 0; chfiles[0] = 0; changed[0] = 0;
    if (sy_mkdtemp(sy_tmpdir(), "chain-ready-", tmpd, sizeof tmpd) == 0) have_tmp = 1;
    for (k = 0; k < 5; k++) cx_fmt(outd[k], sizeof outd[k], "%s/out%d", tmpd, k + 1);
    cx_fmt(cached, sizeof cached, "%s/unisacc-cr-prep-cache", sy_tmpdir());
    {
        char tp[380], gp[380];
        cx_fmt(tp, sizeof tp, "%s/.native_tool.path", cached);
        cx_fmt(gp, sizeof gp, "%s/.native_gen.path", cached);
        (void)sy_unlink(tp); (void)sy_unlink(gp);
    }
    (void)argv_set; (void)changed;

#define WANT(nm) (!only || tx_prefix(nm, (long)tx_len(nm, 64), only, (long)tx_len(only, 64)))
    /* job table: slot order is the report order; prios[] orders launch so heavy shards start first */
    static char *g_status[] = {"./tools/bound", "20", "git", "--no-optional-locks", "-C", 0, "status", "--short", "--", "src", "cx", "ext", "exec/facts", 0};
    static char *g_branch[] = {"./tools/bound", "20", "git", "--no-optional-locks", "-C", 0, "rev-parse", "--abbrev-ref", "HEAD", 0};
    static char *g_derive1[] = {"./tools/bound", "45", "sh", UC, "tools/derive.cx", "--", "--check", "--only", "tables-gen,layer-api,iface-hash,st-gap", 0};
    static char *g_derive2[] = {"./tools/bound", "45", "sh", UC, "tools/derive.cx", "--", "--check", "--only", "chain-phases", 0};
    static char *g_derive3[] = {"./tools/bound", "45", "sh", UC, "tools/derive.cx", "--", "--check", "--only", "batch-packages-gen", 0};
    static char *g_derive4[] = {"./tools/bound", "45", "sh", UC, "tools/derive.cx", "--", "--check", "--only", "batch-domains,links,libc-decls,cx0-three-source", 0};
    static char *g_derive5[] = {"./tools/bound", "45", "sh", UC, "tools/derive.cx", "--", "--check", "--only", "product-map", 0};
    static char *g_derive6[] = {"./tools/bound", "45", "sh", UC, "tools/derive.cx", "--", "--check", "--only", "doc-links,tool-index,table-index", 0};
    static char *g_rat[] = {"./tools/bound", "60", "sh", UC, "tools/ratchets.cx", 0};
    static char *g_tri[] = {"./tools/bound", "60", "sh", UC, "tools/check-cxmod-tri.cx", 0};
    static char *g_ext[] = {"./tools/bound", "55", "sh", UC, "tools/cx0-extract.cx", "--", "--check", 0};
    static char *g_chain1[] = {"./tools/bound", "60", "sh", UC, "tools/check-candidate-chain.cx", "--", 0, 0, "--cases", "core-a", 0};
    static char *g_chain2[] = {"./tools/bound", "60", "sh", UC, "tools/check-candidate-chain.cx", "--", 0, 0, "--cases", "core-b", 0};
    static char *g_chain3[] = {"./tools/bound", "60", "sh", UC, "tools/check-candidate-chain.cx", "--", 0, 0, "--cases", "core-c", 0};
    static char *g_chain4[] = {"./tools/bound", "60", "sh", UC, "tools/check-candidate-chain.cx", "--", 0, 0, "--cases", "objects", 0};
    static char *g_chain5[] = {"./tools/bound", "60", "sh", UC, "tools/check-candidate-chain.cx", "--", 0, 0, "--cases", "watch", 0};
    static char *g_pg[] = {"./tools/bound", "20", "pgrep", "-af", 0, 0};
    static char *g_slot[] = {"./tools/bound", "40", "sh", UC, "tools/release-packcheck.cx", "--", "slot", 0, 0, 0, 0};
    static char *g_genall[] = {"./tools/bound", "60", "sh", UC, "tools/gen-all-check.cx", "--", "--root", 0, 0};
    static char **tab[] = {
        g_status, g_branch,
        g_derive1, g_derive2, g_derive3, g_derive4, g_derive5, g_derive6,
        g_rat, g_tri, g_ext,
        g_chain1, g_chain2, g_chain3, g_chain4, g_chain5,
        g_pg, g_slot, g_genall
    };
    static const char *nm[] = {
        "1-rev", "1-branch",
        "2a-derive", "2a-derive2", "2a-derive3", "2a-derive4", "2a-derive5", "2a-derive6",
        "2b-ratchets", "3a-cxmod-tri", "3b-cx0-extract",
        "5-candidate-chain", "5-candidate-chain2", "5-candidate-chain3", "5-candidate-chain4", "5-candidate-chain5",
        "8-inflight", "11-version-slot", "15-gen-all"
    };
    static const char *kd[] = {
        "rev", "branch",
        "derive:tables-gen,layer-api,iface-hash,st-gap",
        "derive:chain-phases",
        "derive:batch-packages-gen",
        "derive:batch-domains,links,libc-decls,cx0-three-source",
        "derive:product-map",
        "derive:doc-links,tool-index,table-index",
        "ratchets", "tri", "extract",
        "chain:core-a", "chain:core-b", "chain:core-c", "chain:objects", "chain:watch",
        "inflight", "slot", "genall"
    };
    static const int pr[] = {
        9, 9,
        2, 1, 2, 1, 0, 2,
        5, 4, 6,
        3, 3, 3, 3, 2,
        8, 7, 4
    };
    g_status[5] = (char *)repo; g_branch[5] = (char *)repo; g_pg[4] = (char *)pat;
    g_chain1[6] = outd[0]; g_chain1[7] = cached;
    g_chain2[6] = outd[1]; g_chain2[7] = cached;
    g_chain3[6] = outd[2]; g_chain3[7] = cached;
    g_chain4[6] = outd[3]; g_chain4[7] = cached;
    g_chain5[6] = outd[4]; g_chain5[7] = cached;
    g_slot[7] = (char *)repo; if (tver) { g_slot[8] = "--version"; g_slot[9] = (char *)tver; }
    g_genall[7] = (char *)repo;
    for (k = 0; k < 19; k++) {
        int c, is_der = (k >= 2 && k <= 7), is_ch = (k >= 11 && k <= 15);
        if (!WANT(nm[k]) && !(k == 1 && WANT("1-rev")) && !(is_der && WANT("2a-derive")) && !(is_ch && WANT("5-candidate-chain"))) continue;
        if (is_ch && !have_tmp) continue;
        for (c = 0; tab[k][c]; c++) J[nj].argv[c] = tab[k][c];
        J[nj].argv[c] = 0; J[nj].name = nm[k]; items[nj] = (char *)kd[k]; prios[nj] = pr[k];
        nj++;
    }
    /* item 6: changed .cx files (dirty, and --since REV..HEAD), each handed to affected --files */
    {   int want6 = WANT("6-affected");
        if (want6) {
            char *gv[9]; Job g[2]; int gi, ng = 0, npath = 0; char *paths[200]; char *tb[2] = {0, 0}; long tl[2] = {0, 0};
            gv[0] = "./tools/bound"; gv[1] = "20"; gv[2] = "git"; gv[3] = "--no-optional-locks"; gv[4] = "-C"; gv[5] = (char *)repo; gv[6] = "status"; gv[7] = "--short"; gv[8] = 0;
            { int x; for (x = 0; x < 9; x++) g[0].argv[x] = gv[x]; start(&g[0]); finish(&g[0]); tb[0] = g[0].out; tl[0] = g[0].n; ng = 1; }
            if (since) {
                char *dv[] = {"./tools/bound", "20", "git", "-C", (char *)repo, "diff", "--name-only", 0, 0};
                char rng[200]; int x; cx_fmt(rng, sizeof rng, "%s..HEAD", since); dv[7] = rng;
                for (x = 0; x < 9; x++) g[1].argv[x] = dv[x];
                start(&g[1]); finish(&g[1]); tb[1] = g[1].out; tl[1] = g[1].n; ng = 2;
            }
            for (gi = 0; gi < ng; gi++) {
                long at = 0;
                while (tb[gi] && at < tl[gi] && npath < 200) {
                    long e = tx_chr(tb[gi] + at, tl[gi] - at, '\n'), ln = e < 0 ? tl[gi] - at : e;
                    char *p = tb[gi] + at; long pl = ln;
                    if (gi == 0 && pl > 3) { p += 3; pl -= 3; }   /* "XY path" */
                    if (pl > 3 && p[pl - 3] == '.' && p[pl - 2] == 'c' && p[pl - 1] == 'x' && !(gi == 0 && tb[gi][at] == 'D')) {
                        p[pl] = 0;   /* in place; the line ends here */
                        { int dup = 0, y; for (y = 0; y < npath; y++) if (tx_eqz(paths[y], p)) dup = 1; if (!dup) paths[npath++] = p; }
                    }
                    at += ln + 1;
                }
            }
            if (npath > 0) {
                /* List affected batch IDs first, then shard into <=4 batches per 60s job (never relax bound). */
                Job lg; int c = 0, y;
                static char aff_ids[128][128]; int naff = 0;
                lg.argv[c++] = "./tools/bound"; lg.argv[c++] = "30"; lg.argv[c++] = "sh"; lg.argv[c++] = UC;
                lg.argv[c++] = "tools/affected.cx"; lg.argv[c++] = "--"; lg.argv[c++] = "--files";
                for (y = 0; y < npath && c < 20; y++) lg.argv[c++] = paths[y];
                lg.argv[c++] = "--list-only"; lg.argv[c] = 0; lg.name = "6-affected-list";
                start(&lg); finish(&lg);
                if (lg.state == 3 || lg.rc != 0) {
                    char ev[320];
                    cx_fmt(ev, sizeof ev, "rc=%d affected --list-only failed", lg.state == 3 ? -1 : lg.rc);
                    row("6-affected", "FAIL", ev, lg.ms);
                } else {
                    long at = 0;
                    while (lg.out && at < lg.n && naff < 128) {
                        long e = tx_chr(lg.out + at, lg.n - at, '\n'), ln = e < 0 ? lg.n - at : e;
                        if (ln > 9 && tx_prefix(lg.out + at, ln, "AFFECTED\t", 9)) {
                            const char *p = lg.out + at + 9;
                            long rem = ln - 9;
                            long tab = tx_chr(p, rem, '\t');
                            long idl = tab >= 0 ? tab : rem;
                            if (idl > 0 && idl < 127) {
                                mm_copy(aff_ids[naff], 128, p, (size_t)idl);
                                aff_ids[naff][idl] = 0;
                                naff++;
                            }
                        }
                        at += ln + 1;
                    }
                    if (naff == 0) {
                        row("6-affected", "PASS", "0 affected batches for changed .cx files", lg.ms);
                    } else {
                        int s = 0, per = 4;
                        while (s < naff && nj < MAXJ) {
                            int end = s + per < naff ? s + per : naff;
                            int ac = 0, j;
                            J[nj].argv[ac++] = "./tools/bound"; J[nj].argv[ac++] = "60"; J[nj].argv[ac++] = "sh"; J[nj].argv[ac++] = UC;
                            J[nj].argv[ac++] = "tools/affected.cx"; J[nj].argv[ac++] = "--"; J[nj].argv[ac++] = "--ids";
                            for (j = s; j < end && ac < 20; j++) J[nj].argv[ac++] = aff_ids[j];
                            J[nj].argv[ac++] = "--run"; J[nj].argv[ac] = 0;
                            J[nj].name = "6-affected"; items[nj] = "affected:shard"; prios[nj] = 5; nj++;
                            s = end;
                        }
                    }
                }
                if (lg.out) free(lg.out);
            } else { row("6-affected", "PASS", "no changed .cx files (dirty tree and --since range)", 0); }
        }
    }
    /* run: concurrency scaled by CPU cores and degraded under high load; sy_poll event-driven completion */
    {   int done = 0, running = 0, running_der = 0, ncores = 0, load1 = 0;
        int max_running = calc_max_running(&ncores, &load1);
        int ord[MAXJ], i, j;
        for (k = 0; k < nj; k++) { J[k].state = 0; ord[k] = k; }
        for (i = 1; i < nj; i++) {
            int cur = ord[i];
            for (j = i - 1; j >= 0 && prios[ord[j]] > prios[cur]; j--) ord[j + 1] = ord[j];
            ord[j + 1] = cur;
        }
        /* Pre-start up to 4 non-chain shards (e.g. 2a-derive) while preparing candidate-chain & chain-phases-gen materials
         * under independent bounds, so the 5 candidate-chain test shards never pay cold compile time inside their 60s window. */
        if (WANT("5-candidate-chain") && have_tmp) {
            Job pg[2]; int pi;
            char *pv0[] = {"./tools/bound", "45", "sh", UC, "tools/check-candidate-chain.cx", "--", "--prepare", cached, "tool", 0};
            char *pv1[] = {"./tools/bound", "45", "sh", UC, "tools/check-candidate-chain.cx", "--", "--prepare", cached, "generator", 0};
            for (i = 0; i < nj && running + 2 < max_running; i++) {
                int idx = ord[i];
                if (J[idx].state != 0 || prios[idx] >= 2) continue;
                if (tx_prefix(items[idx], (long)tx_len(items[idx], 256), "derive:", 7) && running_der >= 4) continue;
                if (start(&J[idx]) == 0) {
                    running++;
                    if (tx_prefix(items[idx], (long)tx_len(items[idx], 256), "derive:", 7)) running_der++;
                } else { J[idx].ms = 0; J[idx].out = 0; J[idx].n = 0; J[idx].rc = -1; done++; }
            }
            (void)sy_mkdir(cached, 0700);
            for (pi = 0; pv0[pi]; pi++) pg[0].argv[pi] = pv0[pi];
            pg[0].argv[pi] = 0;
            for (pi = 0; pv1[pi]; pi++) pg[1].argv[pi] = pv1[pi];
            pg[1].argv[pi] = 0;
            start(&pg[0]); start(&pg[1]);
            finish(&pg[0]); finish(&pg[1]);
            if (pg[0].out) mm_free(pg[0].out);
            if (pg[1].out) mm_free(pg[1].out);
        }
        while (done < nj) {
            for (i = 0; i < nj && running < max_running; i++) {
                int idx = ord[i], is_d;
                if (J[idx].state != 0) continue;
                is_d = tx_prefix(items[idx], (long)tx_len(items[idx], 256), "derive:", 7);
                if (is_d && running_der >= 4) continue;
                if (start(&J[idx]) == 0) {
                    running++;
                    if (is_d) running_der++;
                } else { J[idx].ms = 0; J[idx].out = 0; J[idx].n = 0; J[idx].rc = -1; done++; }
            }
            if (running > 0) {
                sy_pollfd_t pf[MAXJ]; int pl[MAXJ], np = 0, pr;
                for (k = 0; k < nj; k++) {
                    if (J[k].state == 1) {
                        pf[np].fd = J[k].ofd; pf[np].events = SY_POLLIN; pf[np].revents = 0;
                        pl[np++] = k;
                    }
                }
                pr = np ? sy_poll(pf, np, 500) : 0;
                for (i = 0; i < np; i++) {
                    if (pr < 0 || (pf[i].revents & (SY_POLLIN | SY_POLLHUP | SY_POLLERR | SY_POLLNVAL))) {
                        Job *jb = &J[pl[i]];
                        long r = 0;
                        if (jb->out && jb->n + 1 >= jb->cap) {
                            char *g = mm_grow(jb->out, jb->cap * 2);
                            if (g) { jb->out = g; jb->cap *= 2; }
                        }
                        if (jb->out && jb->n + 1 < jb->cap) r = sy_read(jb->ofd, jb->out + jb->n, jb->cap - 1 - jb->n);
                        if (r > 0) {
                            jb->n += r;
                            jb->out[jb->n] = 0;
                        } else {
                            int ex = 0, code = 0, sig = 0;
                            if (jb->out) jb->out[jb->n] = 0;
                            sy_close(jb->ofd);
                            jb->rc = sy_wait_status(jb->pid, 0, &ex, &code, &sig) == jb->pid && ex ? code : -1;
                            jb->ms = sy_now_ms() - jb->t0;
                            jb->state = 2;
                            running--;
                            if (tx_prefix(items[pl[i]], (long)tx_len(items[pl[i]], 256), "derive:", 7)) running_der--;
                            done++;
                        }
                    }
                }
            }
        }
    }
    {   char ev[640], rev_ev[640], der_pass_ev[640], der_fail_ev[640], aff_pass_ev[640], aff_fail_ev[640];
        int ok, rev_ok = -1, der_ok = 1, der_cnt = 0, aff_ok = 1, aff_cnt = 0;
        long rev_ms = 0, der_ms = 0, dfn = 0, aff_ms = 0, afn = 0;
        const char *ch_names[8], *ch_outs[8]; long ch_lens[8], ch_ms = 0; int ch_rcs[8], ch_cnt = 0;
        der_pass_ev[0] = 0; der_fail_ev[0] = 0; aff_pass_ev[0] = 0; aff_fail_ev[0] = 0;
        for (k = 0; k < nj; k++) {
            long il = (long)tx_len(items[k], 256);
            if (il > 6 && tx_prefix(items[k], il, "chain:", 6)) {
                if (ch_cnt < 8) {
                    ch_names[ch_cnt] = items[k] + 6;
                    ch_outs[ch_cnt] = J[k].out ? J[k].out : "";
                    ch_lens[ch_cnt] = J[k].n;
                    ch_rcs[ch_cnt] = J[k].state == 3 ? -1 : J[k].rc;
                    if (J[k].ms > ch_ms) ch_ms = J[k].ms;
                    ch_cnt++;
                }
                if (k + 1 >= nj || tx_len(items[k + 1], 256) <= 6 || !tx_prefix(items[k + 1], (long)tx_len(items[k + 1], 256), "chain:", 6)) {
                    ok = j_chain_agg(ch_cnt, ch_names, ch_outs, ch_lens, ch_rcs, ev, sizeof ev);
                    row_judged("5-candidate-chain", ok, ev, ch_ms);
                    ch_cnt = 0; ch_ms = 0;
                }
                continue;
            }
            ok = judge_kind(items[k], J[k].out ? J[k].out : "", J[k].n, J[k].rc, ev, sizeof ev);
            if (J[k].state == 3) { ok = 0; cx_fmt(ev, sizeof ev, "cannot start child"); }
            if (tx_eqz(items[k], "rev")) { rev_ok = ok; put_ev(rev_ev, sizeof rev_ev, ev); rev_ms = J[k].ms; continue; }
            if (tx_eqz(items[k], "branch")) {
                int bok = ok;   /* merged row 1-rev: status and branch */
                if (rev_ok >= 0) { char both[700]; cx_fmt(both, sizeof both, "%s; %s", rev_ev, ev); row_judged("1-rev", rev_ok && bok, both, rev_ms + J[k].ms); }
                continue;
            }
            if (il > 7 && tx_prefix(items[k], il, "derive:", 7)) {
                der_cnt++;
                if (J[k].ms > der_ms) der_ms = J[k].ms;
                if (!ok) {
                    char one[320]; long ol;
                    der_ok = 0;
                    cx_fmt(one, sizeof one, "%s[shard%d] %s", dfn ? "; " : "", der_cnt, ev);
                    ol = (long)tx_len(one, sizeof one);
                    if (dfn + ol < (long)sizeof der_fail_ev - 1) {
                        mm_copy(der_fail_ev + dfn, sizeof der_fail_ev - (size_t)dfn, one, (size_t)ol + 1);
                        dfn += ol;
                    }
                } else if (!der_pass_ev[0]) {
                    put_ev(der_pass_ev, sizeof der_pass_ev, ev);
                }
                if (k + 1 >= nj || tx_len(items[k + 1], 256) <= 7 || !tx_prefix(items[k + 1], (long)tx_len(items[k + 1], 256), "derive:", 7)) {
                    char merged[700];
                    if (der_ok) cx_fmt(merged, sizeof merged, "shards=%d/%d drift=0 refused=0 (%s)", der_cnt, der_cnt, der_pass_ev);
                    else cx_fmt(merged, sizeof merged, "shards=%d %s", der_cnt, der_fail_ev);
                    row_judged("2a-derive", der_ok, merged, der_ms);
                    der_cnt = 0; der_ok = 1; der_ms = 0; dfn = 0;
                }
                continue;
            }
            if (il > 9 && tx_prefix(items[k], il, "affected:", 9)) {
                aff_cnt++;
                if (J[k].ms > aff_ms) aff_ms = J[k].ms;
                if (!ok) {
                    char one[320]; long ol;
                    aff_ok = 0;
                    cx_fmt(one, sizeof one, "%s[shard%d] %s", afn ? "; " : "", aff_cnt, ev);
                    ol = (long)tx_len(one, sizeof one);
                    if (afn + ol < (long)sizeof aff_fail_ev - 1) {
                        mm_copy(aff_fail_ev + afn, sizeof aff_fail_ev - (size_t)afn, one, (size_t)ol + 1);
                        afn += ol;
                    }
                } else if (!aff_pass_ev[0]) {
                    put_ev(aff_pass_ev, sizeof aff_pass_ev, ev);
                }
                if (k + 1 >= nj || tx_len(items[k + 1], 256) <= 9 || !tx_prefix(items[k + 1], (long)tx_len(items[k + 1], 256), "affected:", 9)) {
                    char merged[700];
                    if (aff_ok) cx_fmt(merged, sizeof merged, "shards=%d/%d (%s)", aff_cnt, aff_cnt, aff_pass_ev);
                    else cx_fmt(merged, sizeof merged, "shards=%d %s", aff_cnt, aff_fail_ev);
                    row_judged("6-affected", aff_ok, merged, aff_ms);
                    aff_cnt = 0; aff_ok = 1; aff_ms = 0; afn = 0;
                }
                continue;
            }
            row_judged(J[k].name, ok, ev, J[k].ms);
        }
    }
    /* 10-envhygiene: the shell starting the chain must not carry settings that change what the chain measures.
       One inherited deadline is not a leak by itself: tools/bound hands its own children a usable future
       instant, and a chain started that way is a normal chain.  What is a leak is a deadline that is already
       past or not a number -- the value left behind by an earlier bounded command, which is exactly what made
       whole runs answer FAIL for no reason.  A forced cache directory is a leak either way: it changes which
       build the chain reads.  The variable name comes from the helper so it is spelled in one place. */
    if (WANT("10-envhygiene")) {
        char ev[640]; char bad[400] = {0}; long n2 = 0; double at = 0.0; const char *why = 0; int st = be_deadline(&at, &why);
        if (st < 0) {
            char one[200];
            cx_fmt(one, sizeof one, "%s (%s)", be_name(), why);
            tx_copy(bad, sizeof bad, one, tx_len(one, sizeof one)); n2 = (long)tx_len(bad, sizeof bad);
        }
        {   const char *leak[2]; int li;
            leak[0] = "UNISACC_RUN_CACHE"; leak[1] = "UNISACC_CACHE_DIR";
            for (li = 0; li < 2; li++) {
                const char *v = getenv(leak[li]);
                if (v && *v) { char one[140]; long l; cx_fmt(one, sizeof one, "%s%s", n2 ? ", " : "", leak[li]); l = (long)tx_len(one, sizeof one); if (n2 + l < (long)sizeof bad) { tx_copy(bad + n2, sizeof bad - (size_t)n2, one, l); n2 += l; } }
            }
        }
        if (n2) {
            cx_fmt(ev, sizeof ev, "environment leak: %s set before the chain (unset it, or start the chain through tools/bound)", bad);
            row_judged("10-envhygiene", 0, ev, 0);
        } else if (st == 1) {
            cx_fmt(ev, sizeof ev, "inherited deadline is a usable future instant (%.3f s left): this chain runs inside a bound window", be_left(at));
            row_judged("10-envhygiene", 1, ev, 0);
        } else {
            row_judged("10-envhygiene", 1, "no inherited deadline and no forced cache variable in this environment", 0);
        }
    }
    if (WANT("20-ident-helper")) {
        char ev[640];
        const char *ih = getenv("UNISACC_IDENT_HELPER");
        if (!ih || !ih[0]) {
            row_judged("20-ident-helper", 0, "UNISACC_IDENT_HELPER unset (default: ~/.cache/unisacc/ident-helper/identity-helper-real5; built from seed/ident.c)", 0);
        } else {
            struct stat st;
            if (stat(ih, &st) != 0 || !S_ISREG(st.st_mode)) {
                cx_fmt(ev, sizeof ev, "UNISACC_IDENT_HELPER missing-or-not-regular path=%s (default: ~/.cache/unisacc/ident-helper/identity-helper-real5)", ih);
                row_judged("20-ident-helper", 0, ev, 0);
            } else if (access(ih, X_OK) != 0) {
                cx_fmt(ev, sizeof ev, "UNISACC_IDENT_HELPER not-executable path=%s (fix: chmod +x or rebuild from seed/ident.c)", ih);
                row_judged("20-ident-helper", 0, ev, 0);
            } else {
                cx_fmt(ev, sizeof ev, "UNISACC_IDENT_HELPER=%s executable", ih);
                row_judged("20-ident-helper", 1, ev, 0);
            }
        }
    }
    if (WANT("12-root-files") || WANT("12p-preflight-entry") || WANT("13-snap-cache") || WANT("14-root-record")) root_items(repo, rootarg ? rootarg : repo, revarg, only);
    if (WANT("18-parse2-gen")) {
        char private_tree[4400], ev[640];
        long t0 = sy_now_ms();
        int made = !sy_mkdtemp(sy_tmpdir(), "chain-ready-parse2-", private_tree, sizeof private_tree);
        int ok = parse2_preflight(repo, revarg, made ? private_tree : 0, ev);
        if (made) (void)sy_remove_all(private_tree);
        row_judged("18-parse2-gen", ok, ev, sy_now_ms() - t0);
    }
    if (WANT("19-chain-preflight")) {
        char ev[640];
        long t0 = sy_now_ms();
        int ok = run_19_preflight(repo, rootarg ? rootarg : repo, revarg, since, tver, pftable, ev, sizeof ev);
        row_judged("19-chain-preflight", ok, ev, sy_now_ms() - t0);
    }
    /* 17-root-public (0.0.87 S4): a Root installed from an unpublished candidate is fine for a chain and for
       development, but not for a release step; listed here, never counted as a failure. */
    if (WANT("17-root-public")) {
        char mk[4400], ev[640], rev[48]; size_t mn = 0; char *mb; long at;
        cx_fmt(mk, sizeof mk, "%s/unisacc.com.candidate.tsv", rootarg ? rootarg : repo);
        if (sy_exists(mk) != 1) row("17-root-public", "PASS", "Root is not a candidate install (no unisacc.com.candidate.tsv): release steps may use it as the baseline", 0);
        else {
            rev[0] = 0;
            if ((mb = cx_read(mk, &mn)) != 0) { at = tx_find(mb, (long)mn, "rev=", 4); if (at >= 0 && at + 44 <= (long)mn) { mm_copy(rev, (long)sizeof rev, mb + at + 4, 40); rev[40] = 0; } mm_free(mb); }
            cx_fmt(ev, sizeof ev, "WARN root-candidate rev=%s chain=allowed RELEASE_BLOCKED (release-exec, release-run --pack refuse) fix: tools/install-ape.cx -- ROOT --rollback --write or install the public APE", rev[0] ? rev : "?");
            row("17-root-public", "PASS", ev, 0);
        }
    }
    if (WANT("4-p1")) {
        if (fast) row("4-p1", "SKIPPED", "--fast: cx0_plan scan of every .cx with a use pragma not run", 0);
        else { char ev[640]; long ms; run_p1(&ms, ev, sizeof ev); row_judged("4-p1", ms >= 0, ev, ms < 0 ? -ms : ms); }
    }
    if (WANT("16-disk-free")) {
        long t0 = sy_now_ms(), avail_gb = disk_override_gb;
        char ev[320];
        if (avail_gb < 0) {
            char *dv[4]; dv[0] = "df"; dv[1] = "-Pk"; dv[2] = (char *)repo; dv[3] = 0;
            int dfd = -1; int dpid = sy_spawn_pipe(dv, 0, 0, &dfd, 0);
            if (dpid >= 0 && dfd >= 0) {
                char db[2048]; long dn = 0, r;
                while (dn < (long)sizeof db - 1 && (r = sy_read(dfd, db + dn, (size_t)(sizeof db - 1 - (size_t)dn))) > 0) dn += r;
                db[dn] = 0; sy_close(dfd);
                int ex = 0, code = 0, sig = 0;
                sy_wait_status(dpid, 0, &ex, &code, &sig);
                if (ex && code == 0) {
                    long nl = tx_chr(db, dn, '\n');
                    if (nl >= 0 && nl + 1 < dn) {
                        const char *p = db + nl + 1;
                        int col = 0;
                        while (*p && *p != '\n') {
                            while (*p == ' ' || *p == '\t') p++;
                            const char *s = p;
                            while (*p && *p != ' ' && *p != '\t' && *p != '\n') p++;
                            if (col == 3 && p > s) {
                                int64_t kb = 0;
                                if (!tx_to_i64(s, (long)(p - s), 10, &kb)) avail_gb = (long)(kb / (1024L * 1024L));
                                break;
                            }
                            col++;
                        }
                    }
                }
            }
        }
        if (avail_gb < 0) {
            row("16-disk-free", "UNMEASURED", "df -Pk unavailable", sy_now_ms() - t0);
        } else if (avail_gb < 8) {
            cx_fmt(ev, sizeof ev, "DISK_BLOCKED avail_gb=%ld (<8G); free disk space before starting chain", avail_gb);
            row_judged("16-disk-free", 0, ev, sy_now_ms() - t0);
        } else if (avail_gb < 20) {
            cx_fmt(ev, sizeof ev, "DISK_LOW avail_gb=%ld (<20G warning, >=8G allowed)", avail_gb);
            row_judged("16-disk-free", 1, ev, sy_now_ms() - t0);
        } else {
            cx_fmt(ev, sizeof ev, "avail_gb=%ld (>=20G)", avail_gb);
            row_judged("16-disk-free", 1, ev, sy_now_ms() - t0);
        }
    }
    if (WANT("7-recipe")) row("7-recipe", "UNMEASURED", "manual: recipe steps 1-5 (private root checkout of REV, commit-tree, UNISACC_IDENT_HELPER, fresh --out, 5400 s)", 0);
    if (WANT("9-ledger")) row("9-ledger", "UNMEASURED", "manual: one ledger line in prd_mempalace.md (REV, PID/PGID, deadline, output dir) before the chain", 0);
    printf("READY\t%s\t%s%s\t%ld\n", nfail ? "no" : "yes", nfail ? "failed=" : "failed=none", failed_names, sy_now_ms() - T0);
    if (have_tmp) { /* the tool only wrote below its own temp dir; leave contents to the system temp cleaner */ }
    return nfail ? 1 : 0;
}
