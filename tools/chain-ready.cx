                    char one[320]; long ol;
                    pm_ok = 0;
                    cx_fmt(one, sizeof one, "%s[shard%d] %s", pfn ? "; " : "", pm_cnt, ev);
                    ol = (long)tx_len(one, sizeof one);
                    if (pfn + ol < (long)sizeof pm_fail_ev - 1) {
                        mm_copy(pm_fail_ev + pfn, sizeof pm_fail_ev - (size_t)pfn, one, (size_t)ol + 1);
                        pfn += ol;
                    }
                } else if (!pm_pass_ev[0]) {
                    put_ev(pm_pass_ev, sizeof pm_pass_ev, ev);
                }
                if (k + 1 >= nj || tx_len(items[k + 1], 256) <= 9 || !tx_prefix(items[k + 1], (long)tx_len(items[k + 1], 256), "premerge:", 9)) {
                    char merged[700];
                    if (pm_ok) cx_fmt(merged, sizeof merged, "shards=%d/%d (%s)", pm_cnt, pm_cnt, pm_pass_ev);
                    else cx_fmt(merged, sizeof merged, "shards=%d %s", pm_cnt, pm_fail_ev);
