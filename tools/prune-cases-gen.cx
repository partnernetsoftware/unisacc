/* tools/prune-cases-gen.cx -- prune positive cells (tests/stream-prune-domain-matrix.tsv prune.pos.*) as executable
 * cases with a three-way oracle.
 *   sh ./unisacc.com tools/prune-cases-gen.cx -- ROOT STREAM5_COM ABS_OUT [oracle-only]
 * Oracle 1 (classic): ROOT/src/tapeprune.c + src/tapescan.h, verbatim, with a 12-line main, compiled and run by the
 * product itself (`sh ROOT/unisacc.com ABS_OUT/tp-ref.c -- INPUT`): no host C compiler, classic source unchanged;
 * its identity (sha256 of the two sources) is written to results.tsv. This is literally the matrix's "classic
 * src/tapeprune.c" reference, so the corpus also serves prune.pos.reference-differential.
 * Oracle 2 (declared graph): each case declares its units (label + text), its edges (call/jump/fall-through) and
 * its address-taken names; the generator computes the root closure itself (roots _start/main/__init/__main_ret
 * and .lea targets, as the prune contract states) and keeps alive units plus every data statement. A case flagged
 * `whole` expects the input byte for byte (indirect call, host ABI, unsupported structure).
 * PASS requires generator-expected == classic output == stream5 output. Classic != generator is ORACLE_SPLIT
 * (never PASS); a closure case whose output equals its input is VACUOUS. `oracle-only` runs only the classic
 * driver on the stream-prune.cx dead-function fixture and checks it against that fixture's hand-derived bytes.
 * Container runs bounded 12 s, classic runs 20 s; the whole tool stays under the 60 s rule. */
#pragma unisa use cxlib.netpack
#pragma unisa use text.text

static char root[4096], stream5[4096], outdir[4096], inc[4400], bound[4400], product[4400], refc[4400];
static void die(const char *s) { fprintf(stderr, "prune-cases: REFUSE %s errno=%d\n", s, errno); exit(2); }
static void path(char *p, size_t cap, const char *a, const char *b) { int n = snprintf(p, cap, "%s/%s", a, b); if (n < 0 || (size_t)n >= cap) die("path"); }
static void saved(const char *p, const char *s, size_t n) { int f = open(p, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600); if (f < 0) die("exclusive create"); while (n) { ssize_t k = write(f, s, n); if (k <= 0) die("write"); s += k; n -= (size_t)k; } if (close(f)) die("close"); }
#define APP(dst, ...) do { size_t _l = strlen(dst); int _n = snprintf(dst + _l, sizeof dst - _l, __VA_ARGS__); if (_n < 0 || (size_t)_n >= sizeof dst - _l) die("text bound"); } while (0)

/* --- the classic driver, built from the sources verbatim --- */
static void strip_includes(char *dst, size_t cap, const char *src, size_t n) {
    size_t i = 0; dst[0] = 0;
    while (i < n) { size_t e = i; while (e < n && src[e] != '\n') e++; size_t len = e - i + (e < n);
        if (strncmp(src + i, "#include \"", 10)) { size_t l = strlen(dst); if (l + len + 1 > cap) die("driver bound"); { void *cx_kept = memcpy(dst + l, src + i, len); (void)cx_kept; } dst[l + len] = 0; }
        i = e + 1; }
}
static char ref_identity[160];
static void build_driver(void) {
    char ps[4400], ph[4400]; path(ps, sizeof ps, root, "src/tapeprune.c"); path(ph, sizeof ph, root, "src/tapescan.h");
    size_t ns, nh; char *s = cx_read(ps, &ns), *h = cx_read(ph, &nh); if (!s || !h) die("classic sources");
    char hs[65], hh[65]; cx_sha256_hex(s, ns, hs); cx_sha256_hex(h, nh, hh); { if (cx_fmt(ref_identity, sizeof ref_identity, "tapeprune.c=%s tapescan.h=%s", hs, hh)) { fprintf(stderr, "prune-cases-gen: text too long for ref_identity\n"); exit(2); } }
    static char body[65536], part[32768];
    snprintf(body, sizeof body, "/* generated by tools/prune-cases-gen.cx: classic src/tapeprune.c driver */\n#include <stdio.h>\n#include <stdlib.h>\ntypedef unsigned long long us_u64; typedef long long us_i64;\n");
    strip_includes(part, sizeof part, h, nh); APP(body, "%s\n", part);
    strip_includes(part, sizeof part, s, ns); APP(body, "%s\n", part);
    APP(body, "static char tpd_buf[%d + 1];\nint main(int argc, char **argv) {\n  if (argc != 2) return 2;\n  FILE *f = fopen(argv[1], \"rb\"); if (!f) return 3;\n  int n = (int)fread(tpd_buf, 1, sizeof tpd_buf, f); fclose(f);\n  char *o = tp_prune(tpd_buf, n);\n  fwrite(o, 1, (size_t)tp_prune_length, stdout);\n  return 0;\n}\n", 4194304);   /* twice tp_SRCMAX so an over-limit input is read whole and refused as such */
    path(refc, sizeof refc, outdir, "tp-ref.c");
    { size_t on; char *old = cx_read(refc, &on);                     /* a smoke run may have written it already */
      if (old) { if (on != strlen(body) || memcmp(old, body, on)) die("tp-ref.c differs from the sources"); free(old); }
      else if (errno != ENOENT) die("tp-ref.c stat"); else saved(refc, body, strlen(body)); }
    free(s); free(h);
}
static int run_classic(const char *input, np_result *r, char *why, size_t wl) {
    char *v[] = { bound, "20", "sh", product, refc, "--", (char *)input, 0 }; char *env[] = { "UNISA_ATTRIBUTES=", 0 };
    return np_run(v, root, env, 22, r, why, wl);
}
static int run_stream(const char *input, np_result *r, char *why, size_t wl) {
    char *v[] = { bound, "12", stream5, (char *)input, (char *)input, inc, 0 }; char *env[] = { "UNISA_ATTRIBUTES=", "UNISA_MAXSTEPS=200000000", 0 };
    return np_run(v, root, env, 14, r, why, wl);
}

/* --- declared cases --- */
#define PRO "  .frame 8\n  store64 [r7+0], r6\n  mov r6, r7\n  .frame 0\n"
enum { UMAX = 12 };
typedef struct { const char *name, *text; int data; } Unit;          /* data=1: a data statement line (always kept) */
typedef struct { const char *from, *to; } Edge;
typedef struct { const char *cell, *name; int whole; Unit u[UMAX]; Edge e[UMAX]; const char *lea[4]; } Case;
static const Case cases[] = {
    { "entry-roots", "init-only-reachable", 0,
      { { "_start", "_start:\n  call main\n  ret\n" }, { "main", "main:\n" PRO "  imm r0, 1\n  ret\n" }, { "__init", "__init:\n" PRO "  call initonly\n  ret\n" },
        { "initonly", "initonly:\n" PRO "  imm r0, 2\n  ret\n" }, { "dead", "dead:\n" PRO "  imm r0, 99\n  ret\n" } },
      { { "_start", "main" }, { "__init", "initonly" } }, { 0 } },
    { "entry-roots", "main-ret-root", 0,
      { { "_start", "_start:\n  call main\n  ret\n" }, { "main", "main:\n" PRO "  ret\n" }, { "__main_ret", "__main_ret:\n" PRO "  imm r0, 3\n  ret\n" }, { "dead", "dead:\n" PRO "  ret\n" } },
      { { "_start", "main" } }, { 0 } },
    { "entry-roots", "no-start-first-unit-root", 0,
      { { "first", "first:\n" PRO "  call helper\n  ret\n" }, { "helper", "helper:\n" PRO "  ret\n" }, { "dead", "dead:\n" PRO "  ret\n" } },
      { { "first", "helper" } }, { 0 } },
    { "jump-fallthrough", "jump-edge", 0,
      { { "_start", "_start:\n  call main\n  ret\n" }, { "main", "main:\n" PRO "  jump target\n" }, { "target", "target:\n" PRO "  ret\n" }, { "dead", "dead:\n" PRO "  ret\n" } },
      { { "_start", "main" }, { "main", "target" } }, { 0 } },
    { "jump-fallthrough", "fallthrough-edge", 0,
      { { "_start", "_start:\n  call main\n  ret\n" }, { "main", "main:\n" PRO "  imm r0, 1\n" }, { "next", "next:\n" PRO "  ret\n" }, { "dead", "dead:\n" PRO "  ret\n" } },
      { { "_start", "main" }, { "main", "next" } }, { 0 } },
    { "jump-fallthrough", "jumpz-edge", 0,
      { { "_start", "_start:\n  call main\n  ret\n" }, { "main", "main:\n" PRO "  jumpz r1, target\n  ret\n" }, { "target", "target:\n" PRO "  ret\n" }, { "dead", "dead:\n" PRO "  ret\n" } },
      { { "_start", "main" }, { "main", "target" } }, { 0 } },
    { "data-address-root", "data-kept-inside-dead", 0,
      { { "_start", "_start:\n  call main\n  ret\n" }, { "main", "main:\n" PRO "  .lea r1, g\n  ret\n" }, { "dead", "dead:\n" PRO "  ret\n" }, { "g", "  .bss g 8\n", 1 }, { "dead2", "dead2:\n" PRO "  imm r0, 5\n  ret\n" }, { "s", "  .str s \"x\"\n", 1 } },
      { { "_start", "main" } }, { 0 } },
    { "data-address-root", "address-taken-function-root", 0,
      { { "_start", "_start:\n  call main\n  ret\n" }, { "main", "main:\n" PRO "  .lea r1, fn\n  ret\n" }, { "dead", "dead:\n" PRO "  ret\n" }, { "fn", "fn:\n" PRO "  imm r0, 4\n  ret\n" } },
      { { "_start", "main" } }, { "fn", 0 } },
    { "data-address-root", "address-taken-from-dead-still-root", 0,
      { { "_start", "_start:\n  call main\n  ret\n" }, { "main", "main:\n" PRO "  ret\n" }, { "dead", "dead:\n" PRO "  .lea r1, fn\n  ret\n" }, { "fn", "fn:\n" PRO "  ret\n" } },
      { { "_start", "main" } }, { "fn", 0 } },
    { "unreachable-cycle", "mutual-recursion-dead", 0,
      { { "_start", "_start:\n  call main\n  ret\n" }, { "main", "main:\n" PRO "  ret\n" }, { "a", "a:\n" PRO "  call b\n  ret\n" }, { "b", "b:\n" PRO "  call a\n  ret\n" } },
      { { "_start", "main" }, { "a", "b" }, { "b", "a" } }, { 0 } },
    { "unreachable-cycle", "self-recursion-dead", 0,
      { { "_start", "_start:\n  call main\n  ret\n" }, { "main", "main:\n" PRO "  ret\n" }, { "r", "r:\n" PRO "  call r\n  ret\n" } },
      { { "_start", "main" }, { "r", "r" } }, { 0 } },
    { "unreachable-cycle", "reachable-recursion-kept", 0,
      { { "_start", "_start:\n  call main\n  ret\n" }, { "main", "main:\n" PRO "  call r\n  ret\n" }, { "r", "r:\n" PRO "  call r\n  ret\n" }, { "dead", "dead:\n" PRO "  call dead\n  ret\n" } },
      { { "_start", "main" }, { "main", "r" }, { "r", "r" }, { "dead", "dead" } }, { 0 } },
    { "transitive-closure", "three-level-chain-interleaved", 0,
      { { "_start", "_start:\n  call main\n  ret\n" }, { "d1", "d1:\n" PRO "  ret\n" }, { "main", "main:\n" PRO "  call a\n  ret\n" }, { "d2", "d2:\n" PRO "  call d1\n  ret\n" },
        { "a", "a:\n" PRO "  call b\n  ret\n" }, { "d3", "d3:\n" PRO "  ret\n" }, { "b", "b:\n" PRO "  call c\n  ret\n" }, { "c", "c:\n" PRO "  call a\n  ret\n" } },
      { { "_start", "main" }, { "main", "a" }, { "a", "b" }, { "b", "c" }, { "c", "a" }, { "d2", "d1" } }, { 0 } },
    { "transitive-closure", "chain-through-jump", 0,
      { { "_start", "_start:\n  call main\n  ret\n" }, { "main", "main:\n" PRO "  call a\n  ret\n" }, { "a", "a:\n" PRO "  jump b\n" }, { "dead", "dead:\n" PRO "  ret\n" }, { "b", "b:\n" PRO "  call c\n  ret\n" }, { "c", "c:\n" PRO "  ret\n" } },
      { { "_start", "main" }, { "main", "a" }, { "a", "b" }, { "b", "c" } }, { 0 } },
    { "transitive-closure", "dead-calls-live", 0,
      { { "_start", "_start:\n  call main\n  ret\n" }, { "main", "main:\n" PRO "  call a\n  ret\n" }, { "a", "a:\n" PRO "  ret\n" }, { "dead", "dead:\n" PRO "  call a\n  ret\n" } },
      { { "_start", "main" }, { "main", "a" }, { "dead", "a" } }, { 0 } },
    { "indirect-call-preserved", "callr-in-main", 1,
      { { "_start", "_start:\n  call main\n  ret\n" }, { "main", "main:\n" PRO "  callr r5\n  ret\n" }, { "dead", "dead:\n" PRO "  ret\n" } }, { { "_start", "main" } }, { 0 } },
    { "indirect-call-preserved", "callm-in-main", 1,
      { { "_start", "_start:\n  call main\n  ret\n" }, { "main", "main:\n" PRO "  callm r5, 8\n  ret\n" }, { "dead", "dead:\n" PRO "  ret\n" } }, { { "_start", "main" } }, { 0 } },
    { "indirect-call-preserved", "callr-in-reachable-callee", 1,
      { { "_start", "_start:\n  call main\n  ret\n" }, { "main", "main:\n" PRO "  call f\n  ret\n" }, { "f", "f:\n" PRO "  callr r1\n  ret\n" }, { "dead", "dead:\n" PRO "  ret\n" } }, { { "_start", "main" }, { "main", "f" } }, { 0 } },
    { "host-abi-preserved", "hostcall", 1,
      { { "_start", "_start:\n  call main\n  ret\n" }, { "main", "main:\n" PRO "  .hostcall r0, r1\n  ret\n" }, { "dead", "dead:\n" PRO "  ret\n" } }, { { "_start", "main" } }, { 0 } },
    { "host-abi-preserved", "hostaddr", 1,
      { { "_start", "_start:\n  call main\n  ret\n" }, { "main", "main:\n" PRO "  .hostaddr r0, 0\n  ret\n" }, { "dead", "dead:\n" PRO "  ret\n" } }, { { "_start", "main" } }, { 0 } },
    { "host-abi-preserved", "librarycall", 1,
      { { "_start", "_start:\n  call main\n  ret\n" }, { "main", "main:\n" PRO "  .librarycall r1, r0\n  ret\n" }, { "dead", "dead:\n" PRO "  ret\n" } }, { { "_start", "main" } }, { 0 } },
    { "unknown-prologue-preserved", "global-directive", 1,
      { { "g", "  .global main\n" }, { "_start", "_start:\n  call main\n  ret\n" }, { "main", "main:\n" PRO "  ret\n" }, { "dead", "dead:\n" PRO "  ret\n" } }, { { "_start", "main" } }, { 0 } },
    { "unknown-prologue-preserved", "call-to-missing-label", 1,
      { { "_start", "_start:\n  call main\n  ret\n" }, { "main", "main:\n" PRO "  call nowhere\n  ret\n" }, { "dead", "dead:\n" PRO "  ret\n" } }, { { "_start", "main" } }, { 0 } },
    { "unknown-prologue-preserved", "duplicate-label", 1,
      { { "_start", "_start:\n  call main\n  ret\n" }, { "main", "main:\n" PRO "  ret\n" }, { "dead", "dead:\n" PRO "  ret\n" }, { "dead", "dead:\n  ret\n" } }, { { "_start", "main" } }, { 0 } },
};

static int uidx(const Case *c, const char *name) { for (int i = 0; i < UMAX && c->u[i].name; i++) if (tx_eq(c->u[i].name, name, 1L << 20)) return i; die("edge names unknown unit"); return -1; }
static void build(const Case *c, char *in, size_t incap, char *want, size_t wcap) {
    int alive[UMAX] = { 0 }, n = 0; in[0] = want[0] = 0;
    while (n < UMAX && c->u[n].name) n++;
    /* roots: named entries, .lea targets; a tape without _start roots its first code unit */
    int any = 0;
    for (int i = 0; i < n; i++) if (!c->u[i].data && (tx_eq(c->u[i].name, "_start", 1L << 20) || tx_eq(c->u[i].name, "main", 1L << 20) || tx_eq(c->u[i].name, "__init", 1L << 20) || tx_eq(c->u[i].name, "__main_ret", 1L << 20))) { alive[i] = 1; if (tx_eq(c->u[i].name, "_start", 1L << 20)) any = 1; }
    if (!any) for (int i = 0; i < n; i++) if (!c->u[i].data) { alive[i] = 1; break; }
    for (int k = 0; k < 4 && c->lea[k]; k++) alive[uidx(c, c->lea[k])] = 1;
    for (int changed = 1; changed;) { changed = 0; for (int k = 0; k < UMAX && c->e[k].from; k++) { int f = uidx(c, c->e[k].from), t = uidx(c, c->e[k].to); if (alive[f] && !alive[t]) { alive[t] = 1; changed = 1; } } }
    for (int i = 0; i < n; i++) { size_t l = strlen(in); if (l + strlen(c->u[i].text) + 1 > incap) die("input bound"); if (cx_fmt(in + l, incap - l, "%s", c->u[i].text)) die("input bound"); }
    if (c->whole) { if (strlen(in) + 1 > wcap) die("want bound"); if (cx_fmt(want, wcap, "%s", in)) die("want bound"); return; }
    for (int i = 0; i < n; i++) if (c->u[i].data || alive[i]) { { size_t wl = strlen(want); if (cx_fmt(want + wl, wcap - wl, "%s", c->u[i].text)) die("want bound"); } }
}

static int npass, nfail, nsplit, nvac, nnotrun;
static void judge(FILE *res, const char *key, const char *in, size_t inn, const char *want, size_t wantn, int whole) {
    np_result rc, rs; char why[1024]; char tp[4600], cp[4600], sp[4600], wp[4600];
    { if (cx_fmt(tp, sizeof tp, "%s/%s.tape", outdir, key)) { fprintf(stderr, "prune-cases-gen: text too long for tp\n"); exit(2); } } { if (cx_fmt(cp, sizeof cp, "%s/%s.classic", outdir, key)) { fprintf(stderr, "prune-cases-gen: text too long for cp\n"); exit(2); } } { if (cx_fmt(sp, sizeof sp, "%s/%s.stream", outdir, key)) { fprintf(stderr, "prune-cases-gen: text too long for sp\n"); exit(2); } } { if (cx_fmt(wp, sizeof wp, "%s/%s.want", outdir, key)) { fprintf(stderr, "prune-cases-gen: text too long for wp\n"); exit(2); } }
    saved(tp, in, inn); saved(wp, want, wantn);
    if (!whole && wantn == inn && !memcmp(want, in, inn)) { nvac++; fprintf(res, "VACUOUS\t%s\tclosure case prunes nothing\n", key); return; }
    if (run_classic(tp, &rc, why, sizeof why) || rc.rc) { nnotrun++; fprintf(res, "NOT_RUN\t%s\tclassic rc=%d %s\n", key, rc.rc, why); np_free(&rc); return; }
    saved(cp, rc.out, rc.outn);
    int classic_ok = rc.outn == wantn && !memcmp(rc.out, want, rc.outn);
    if (!classic_ok) { nsplit++; fprintf(res, "ORACLE_SPLIT\t%s\tclassic=%zu want=%zu bytes\n", key, rc.outn, wantn); np_free(&rc); return; }
    if (run_stream(tp, &rs, why, sizeof why)) { nnotrun++; fprintf(res, "NOT_RUN\t%s\tstream %s\n", key, why); np_free(&rc); return; }
    saved(sp, rs.out, rs.outn);
    int ok = !rs.rc && !rs.errn && rs.outn == rc.outn && !memcmp(rs.out, rc.out, rs.outn);
    if (ok) npass++; else nfail++;
    fprintf(res, "%s\t%s\tin=%zu out=%zu rc=%d err=%zu %s\n", ok ? "PASS" : "FAIL", key, inn, rs.outn, rs.rc, rs.errn, whole ? "whole-preserved" : "pruned");
    np_free(&rc); np_free(&rs);
}

int main(int argc, char **argv) {
    if ((argc != 4 && argc != 5) || !realpath(argv[1], root) || !realpath(argv[2], stream5) || argv[3][0] != '/' || (argc == 5 && strcmp(argv[4], "oracle-only"))) { fputs("usage: ROOT STREAM5_COM ABS_OUT [oracle-only]\n", stderr); return 2; }
    int oracle_only = argc == 5; { if (cx_fmt(outdir, sizeof outdir, "%s", argv[3])) { fprintf(stderr, "prune-cases-gen: text too long for outdir\n"); exit(2); } }
    path(inc, sizeof inc, root, "include"); path(bound, sizeof bound, root, "tools/bound"); path(product, sizeof product, root, "unisacc.com");
    if (mkdir(outdir, 0700) && errno != EEXIST) die("out dir");
    build_driver();
    char respath[4400]; path(respath, sizeof respath, outdir, oracle_only ? "oracle-only.tsv" : "results.tsv"); FILE *res = fopen(respath, "wbx"); if (!res) die("results exclusive");
    char s5[65]; { size_t n; char *b = cx_read(stream5, &n); if (!b) die("stream5"); cx_sha256_hex(b, n, s5); free(b); }
    fprintf(res, "IDENTITY\tclassic %s\tstream5=%s\n", ref_identity, s5);
    np_result rc; char why[1024]; static char in[8192], want[8192];
    if (oracle_only) {
        snprintf(in, sizeof in, "_start:\n  call main\n  ret\nmain:\n" PRO "  imm r0, 7\n  ret\ndead:\n" PRO "  imm r0, 99\n  ret\n");
        snprintf(want, sizeof want, "_start:\n  call main\n  ret\nmain:\n" PRO "  imm r0, 7\n  ret\n");
        char tp[4600]; path(tp, sizeof tp, outdir, "fixture-dead.tape"); saved(tp, in, strlen(in));
        if (run_classic(tp, &rc, why, sizeof why)) die(why);
        int ok = !rc.rc && rc.outn == strlen(want) && !memcmp(rc.out, want, rc.outn);
        fprintf(res, "%s\tfixture-dead\tclassic rc=%d out=%zu err=%zu\n", ok ? "PASS" : "FAIL", rc.rc, rc.outn, rc.errn);
        if (!ok) fwrite(rc.err, 1, rc.errn, stderr);
        fclose(res); printf("PRUNE_ORACLE\t%s\t%s\n", ok ? "PASS" : "FAIL", ref_identity); return !ok;
    }
    int ncases = (int)(sizeof cases / sizeof *cases);
    for (int i = 0; i < ncases; i++) {
        const Case *c = &cases[i]; char key[128]; { if (cx_fmt(key, sizeof key, "%02d.%s.%s", i, c->cell, c->name)) { fprintf(stderr, "prune-cases-gen: text too long for key\n"); exit(2); } }
        build(c, in, sizeof in, want, sizeof want);
        judge(res, key, in, strlen(in), want, strlen(want), c->whole);
    }
    /* capacity boundary (prune.pos.capacity-preserved): the classic contract preserves the whole tape when it is
     * over tp_SRCMAX (2 MiB) bytes or reaches tp_ROWMAX (32768) rows; a tape just under both is still pruned.
     * Bulk comes from a dead function whose lines carry long `;` comments (bytes) or many short lines (rows). */
    {
        static const char *hd = "_start:\n  call main\n  ret\nmain:\n" PRO "  ret\n", *dd = "dead:\n" PRO;
        size_t cap = 4u << 20; char *big = malloc(cap); if (!big) die("alloc");
        for (int v = 0; v < 3; v++) {
            size_t n = 0; const char *name = v == 0 ? "over-2mib-whole" : v == 1 ? "over-rowmax-whole" : "just-under-pruned"; int whole = v != 2;
            { void *cx_kept = memcpy(big + n, hd, strlen(hd)); (void)cx_kept; } n += strlen(hd); size_t keep = n; { void *cx_kept = memcpy(big + n, dd, strlen(dd)); (void)cx_kept; } n += strlen(dd);
            if (v == 1) { for (int r = 0; r < 32760; r++) { memcpy(big + n, "  imm r0, 1\n", 12); n += 12; } }
            else { size_t target = v == 0 ? 2097153 : 2097152 - 80000; while (n < target) {   /* over: first line past 2 MiB; under: stays below it */ memcpy(big + n, "  imm r0, 1 ; ", 14); n += 14; memset(big + n, 'x', 69000); n += 69000; big[n++] = '\n'; } }
            memcpy(big + n, "  ret\n", 6); n += 6; if (n >= cap) die("big bound");
            char key[128]; { if (cx_fmt(key, sizeof key, "%02d.capacity-preserved.%s", ncases + v, name)) { fprintf(stderr, "prune-cases-gen: text too long for key\n"); exit(2); } }
            judge(res, key, big, n, whole ? big : (char *)hd, whole ? n : keep, whole);
        }
        free(big); ncases += 3;
    }
    fprintf(res, "SUMMARY\tcases=%d\tpass=%d\tfail=%d\toracle_split=%d\tvacuous=%d\tnot_run=%d\n", ncases, npass, nfail, nsplit, nvac, nnotrun); fclose(res);
    printf("PRUNE_CASES\tcases=%d\tpass=%d\tfail=%d\toracle_split=%d\tvacuous=%d\tnot_run=%d\n", ncases, npass, nfail, nsplit, nvac, nnotrun);
    return nfail || nsplit || nvac || nnotrun ? 1 : 0;
}
