/* tools/check-productpkg.cx -- the installed product's layout is read, not sniffed.
 *
 *   sh ./unisacc.com tools/check-productpkg.cx        (from the repo root)
 *
 * Under the dev-lnx layout `unisacc.com` is a thin launcher and the package lives in
 * unisacc.com.dev/. Eight checks and one product copier assumed the single-file APE and broke
 * when it changed. cxlib.productpkg answers "which file holds the package" and "what does it
 * take to copy this product", so those checks can ask instead of reading bytes.
 *
 * Cases
 *   installed-layout        pp_layout(root) is PP_SPLIT for this install (launcher + dev dir)
 *   package-has-footer      the file it names carries a locatable UNIPKG1 footer and starts with 'P'
 *   copy-runs               pp_copy_product into a scratch root, then `sh COPY/unisacc.com
 *                           --version` exits 0 and names 0.0.43 -- the copy is a working product
 *   copy-has-entry          COPY/unisacc.com.dev/entry.elf exists: the copier took the side dir,
 *                           which is exactly what the old "cx_read the product, write one file"
 *                           copier did not
 *   ape-layout              a real single-file APE still reads as PP_APE (SKIP when no archive
 *                           copy is around to test against)
 *
 * Prints PASS/FAIL/SKIP per case and PRODUCTPKG<TAB>assertions=N<TAB>failed=M;
 * exit 0 only when nothing failed. */
#pragma unisa use cxlib.productpkg
#pragma unisa use cxlib.packagefooter
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use text.text

static char root[4400], com[4400], work[4400];
static int assertions, failed;

static void ok(int cond, const char *name) {
    assertions++;
    if (!cond) failed++;
    printf("%s\t%s\n", cond ? "PASS" : "FAIL", name);
}

static void skip(const char *name, const char *why) {
    printf("SKIP\t%s\t%s\n", name, why);
}

/* The "candidate unchanged" guard the suite uses today hashes one path. Under the split layout
   that path is the 624-byte launcher, so a batch can rewrite the megabyte package and still look
   unchanged. This case states that as an assertion on purpose: it must FAIL until the identity is
   the whole member set, and it is the proof that the hole was real. */
static void file_digest(const char *p, char h[65]) {
    size_t n = 0;
    char *s = cx_read(p, &n);
    h[0] = 0;
    if (!s) return;
    cx_sha256_hex(s, n, h);
    free(s);
}

static void die(const char *what) {
    fprintf(stderr, "check-productpkg: %s\n", what);
    exit(2);
}

/* A split2 scratch root that does not copy the live install. Live ROOT may be APE. */
static int make_split_root(const char *dst) {
    char p[4400], dev[4400], src[4400];
    size_t n = 0;
    char *b;
    if (sy_mkdir(dst, 0700)) return -1;
    if (cx_fmt(src, sizeof src, "%s/unisacc-dev", root)) return -1;
    b = cx_read(src, &n);
    if (!b || n < 8) { if (b) free(b); return -1; }
    if (cx_fmt(p, sizeof p, "%s/unisacc.com", dst)) { free(b); return -1; }
    if (cx_write(p, b, n)) { free(b); return -1; }
    free(b);
    if (cx_fmt(dev, sizeof dev, "%s/unisacc.com.dev", dst)) return -1;
    if (sy_mkdir(dev, 0700)) return -1;
    if (cx_fmt(p, sizeof p, "%s/entry.elf", dev) || cx_write(p, "entry\n", 6)) return -1;
    if (cx_fmt(p, sizeof p, "%s/p3-package.bin", dev) || cx_write(p, "P 1\n", 4)) return -1;
    return 0;
}

/* argv: child identity-fail  -- build a product copy with a member missing, then ask the guard
   wrapper for its identity. It must refuse (exit 2), not return an empty string: two empty
   strings compare equal and the unchanged-guard would pass without measuring anything. */
static int main_identity_fail(void) {
    char g[4400], ge[4400];
    if (cx_fmt(g, sizeof g, "%s/guard-fail", work)) die("fail dir");
    if (make_split_root(g)) die("fail split");
    if (!tx_eqz(pp_identity_kind(g), "split2")) die("fail not split2");
    if (cx_fmt(ge, sizeof ge, "%s/unisacc.com.dev/entry.elf", g)) die("fail entry");
    if (sy_unlink(ge)) die("fail unlink");
    {   char h[65];
        pp_digest_or_die(g, h);
    }
    return 0;
}

int main(int argc, char **argv) {
    char pkg[4400], entry[4400], out[600];
    size_t n = 0;
    unsigned char *b;
    PackageFooter f;
    int l, rc;

    if (sy_cwd(root, sizeof root) < 0) die("cwd");
    if (cx_fmt(work, sizeof work, "%s/out/productpkg-batch", root)) die("work");
    if (argc >= 3 && tx_eqz(argv[1], "child") && tx_eqz(argv[2], "identity-fail")) {
        if (sy_exists(work) == 1 && cx_rmtree(work)) die("child old work");
        if (sy_mkdir(work, 0700)) die("child work");
        return main_identity_fail();
    }
    if (cx_fmt(com, sizeof com, "%s/unisacc.com", root)) die("product");
    if (sy_exists(work) == 1 && cx_rmtree(work)) die("old work");
    if (sy_mkdir(work, 0700)) die("work dir");

    l = pp_layout(root);
    /* Both layouts are legal. Asserting "the installed product is split" would be a claim about
       today's build, not about the code: when a complete APE comes back this check must keep
       working, so it states what holds for whichever layout it finds. */
    ok(tx_eqz(pp_layout_name(l), "split") || tx_eqz(pp_layout_name(l), "ape"), "installed-layout-is-known");

    ok(pp_package_path(root, pkg, (int)sizeof pkg) == 0 && sy_exists(pkg) == 1, "package-has-path");
    b = pp_read_package(root, &n);
    ok(b && n > 0 && n <= 2147483647UL && packagefooter_locate_bytes(b, (long)n, &f) &&
       f.package_offset >= 0 && b[f.package_offset] == 'P', "package-has-footer");
    free(b);

    {   char dst[4400];
        char *av[] = { "sh", NULL, "--version", 0 };
        if (cx_fmt(dst, sizeof dst, "%s/copy", work)) die("copy dir");
        ok(pp_copy_product(root, dst) == 0, "copy-ok");
        if (cx_fmt(entry, sizeof entry, "%s/unisacc.com", dst)) die("copy launcher");
        av[1] = entry;
        out[0] = 0;
        rc = sy_run(av, out, (int)sizeof out, 0);
        ok(rc == 0 && tx_find(out, (long)strlen(out), "0.0.48", 6) >= 0, "copy-runs");
        if (tx_eqz(pp_identity_kind(dst), "split2")) {
            if (cx_fmt(entry, sizeof entry, "%s/unisacc.com.dev/entry.elf", dst)) die("entry path");
            ok(sy_exists(entry) == 1, "copy-has-entry");
        } else ok(sy_exists(entry) != 2, "copy-has-entry");
    }

    {   /* plans/product-identity-2026-11-02.md: identity is the member set, and the guard must
           see a rewritten package. Before the identity change this case failed: the old guard
           hashed only the launcher, so flipping a byte in the megabyte package left it unchanged. */
        char g[4400], gp[4400], h1[65], h2[65];
        size_t n = 0;
        char *b;
        int copied;
        if (cx_fmt(g, sizeof g, "%s/guard", work)) die("guard dir");
        copied = pp_copy_product(root, g) == 0;
        ok(copied, "guard-copy-ok");
        if (cx_fmt(gp, sizeof gp, "%s/unisacc.com.dev/p3-package.bin", g)) die("guard package");
        ok(pp_product_digest(g, h1) == 0 && h1[0], "identity-computable");
        ok(pp_product_digest(g, h2) == 0 && tx_eqz(h1, h2), "identity-stable");
        if (tx_eqz(pp_identity_kind(g), "split2")) {
            b = cx_read(gp, &n);
            if (b && n > 1) { b[n / 2] = (char)(b[n / 2] ^ 1); cx_write(gp, b, n); }
            free(b);
            ok(pp_product_digest(g, h2) == 0 && !tx_eqz(h1, h2), "identity-sees-a-rewritten-package");
            /* B5b: the identity must BE sha256 of the six-field manifest text, not the old
               sorted "name<TAB>sha<TAB>bytes" form. Both are computed here and compared. */
            {   char lg[65], canon[4096];
                long on = 0;
                int okc = pp_manifest_text(g, canon, (long)sizeof canon, &on) == 0;
                if(okc) cx_sha256_hex(canon,(size_t)on,lg);
                ok(okc && lg[0], "identity-is-manifest-text-sha");
                ok(okc && pp_product_digest(g, h2) == 0 && tx_eqz(h2, lg),
                   "identity-equals-manifest-sha");
                ok(pp_legacy_digest(g, lg) == 0 && !tx_eqz(h1, lg),
                   "identity-differs-from-legacy-form");
            }
        }
    }

    {   /* ENOTDIR must not read as "absent": a file where the dev directory belongs is a broken
           install, and calling it "no layout" hides it. */
        char en[4400], ef[4400];
        char *b = "not a directory\n";
        if (cx_fmt(en, sizeof en, "%s/notdir", work)) die("notdir dir");
        if (sy_mkdir(en, 0700)) die("notdir mkdir");
        if (cx_fmt(ef, sizeof ef, "%s/unisacc.com.dev", en)) die("notdir file");
        ok(cx_write(ef, b, tx_len(b, 32)) == 0, "notdir-fixture");
        ok(tx_eqz(pp_layout_name(pp_layout(en)), "error"), "notdir-is-not-absent");
    }

    {   /* a member that is missing must be a refusal, not a shorter set */
        char g[4400], ge[4400];
        char h[65];
        int copied;
        if (cx_fmt(g, sizeof g, "%s/guard-missing", work)) die("missing dir");
        copied = make_split_root(g) == 0;
        if (copied && tx_eqz(pp_identity_kind(g), "split2")) {
            if (cx_fmt(ge, sizeof ge, "%s/unisacc.com.dev/entry.elf", g)) die("missing entry");
            if (sy_unlink(ge)) die("unlink entry");
            ok(pp_product_digest(g, h) != 0 && !h[0], "identity-refuses-a-missing-member");
        }
    }

    /* ---- split2 regressions: each of these passed silently under split1 ---------------- */

    {   /* more members than the table holds must be refused, not truncated */
        char m[4400], rec[4400], body[4096], f[4400];
        long at = 0;
        int i, n = 0, built = 1;
        if (cx_fmt(m, sizeof m, "%s/many", work)) die("many dir");
        if (make_split_root(m)) built = 0;
        if (built) {
            for (i = 0; i < 18 && built; i++) {
                if (cx_fmt(f, sizeof f, "%s/unisacc.com.dev/m%02d", m, i)) die("many member");
                if (cx_write(f, "x", 1)) built = 0;
            }
            body[0] = 0; at = 0;
            {   int z = cx_fmt(body, sizeof body, "NOT_RELEASE\tdev-lnx-only\n");
                if (z) built = 0; else at = tx_len(body, sizeof body);
            }
            for (i = 0; i < 18 && built; i++) {
                int z = cx_fmt(body + at, (size_t)((long)sizeof body - at), "m%02d\t/tmp/m%02d\tbytes=1\n", i, i);
                if (z) built = 0; else at += tx_len(body + at, (long)sizeof body - at);
            }
            if (cx_fmt(rec, sizeof rec, "%s/ape-receipt.txt", m)) die("many receipt");
            if (cx_write(rec, body, (size_t)at)) built = 0;
        }
        {   char h[65];
            ok(built && pp_product_digest(m, h) != 0 && !h[0], "too-many-members-refused");
        }
        (void)n;
    }

    {   /* a receipt that names no member is a broken receipt, not "fall back to two names" */
        char r[4400], rec[4400], f[4400];
        char *only = "NOT_RELEASE\tdev-lnx-only\n";
        int built;
        if (cx_fmt(r, sizeof r, "%s/empty-receipt", work)) die("empty dir");
        built = make_split_root(r) == 0;
        if (built) {
            if (cx_fmt(rec, sizeof rec, "%s/ape-receipt.txt", r)) die("empty receipt");
            if (cx_write(rec, only, tx_len(only, 64))) built = 0;
        }
        {   char h[65];
            ok(built && pp_product_digest(r, h) != 0 && !h[0], "empty-receipt-refused");
        }
        (void)f;
    }

    {   /* a member that is a symbolic link: identity must be these bytes, not whatever it points to */
        char sl[4400], entry2[4400], target[4400];
        int built, linked = 0;
        if (cx_fmt(sl, sizeof sl, "%s/symlink-member", work)) die("symlink dir");
        built = make_split_root(sl) == 0;
        if (built && tx_eqz(pp_identity_kind(sl), "split2")) {
            if (cx_fmt(entry2, sizeof entry2, "%s/unisacc.com.dev/entry.elf", sl)) die("symlink entry");
            if (cx_fmt(target, sizeof target, "%s/entry-target", sl)) die("symlink target");
            linked = sy_rename(entry2, target) == 0 && symlink("entry-target", entry2) == 0;
            if (!linked) { if (sy_rename(target, entry2)) die("symlink restore"); }
        }
        {   char h[65];
            ok(!built || !linked || (pp_product_digest(sl, h) != 0 && !h[0]), "symlink-member-refused");
        }
    }

    {   /* A product that ships its receipt must be copied from the receipt, not from the
           fallback names. The first version of pp_receipt_line matched NOT_RELEASE by length
           (eleven characters, not seven), so the sentinel line was taken for a member and the
           whole copy failed -- invisible while the repo had no receipt next to the product. */
        char wr[4400], wr2[4400], rec[4400], m1[4400], m2[4400], body[4400];
        int okc = 0;
        if (!cx_fmt(wr, sizeof wr, "%s/withreceipt", work) && !cx_fmt(wr2, sizeof wr2, "%s/withreceipt-copy", work) &&
            !cx_fmt(rec, sizeof rec, "%s/ape-receipt.txt", wr) &&
            !cx_fmt(m1, sizeof m1, "%s/unisacc.com.dev/entry.elf", wr) &&
            !cx_fmt(m2, sizeof m2, "%s/unisacc.com.dev/p3-package.bin", wr) &&
            make_split_root(wr) == 0 &&
            !cx_fmt(body, sizeof body, "NOT_RELEASE\tdev-lnx-only\nentry.elf\t%s\tsha=x\tbytes=1\np3-package\t%s\tsha=x\tbytes=1\n", m1, m2) &&
            cx_write(rec, body, tx_len(body, sizeof body)) == 0)
            okc = pp_copy_product(wr, wr2) == 0;
        ok(okc, "receipt-copy-ok");
        if (okc) {
            if (cx_fmt(m1, sizeof m1, "%s/unisacc.com.dev/entry.elf", wr2)) die("rc entry");
            if (cx_fmt(m2, sizeof m2, "%s/unisacc.com.dev/p3-package.bin", wr2)) die("rc package");
            ok(sy_exists(m1) == 1 && sy_exists(m2) == 1, "receipt-copy-has-members");
        }
    }

    {   if (tx_eqz(pp_layout_name(pp_layout(root)), "ape"))
            ok(tx_eqz(pp_layout_name(pp_layout_of_file(com)), "ape"), "ape-layout");
        else skip("ape-layout", "live install is not ape");
    }

    {   /* the wrapper must refuse a broken product instead of returning two equal empty strings */
        char *av[] = { "sh", "unisacc.com", "tools/check-productpkg.cx", "--", "child", "identity-fail", 0 };
        char out[256];
        int rc;
        out[0] = 0;
        rc = sy_run(av, out, (int)sizeof out, 0);
        ok(rc == 2, "identity-failure-refuses-not-empty");
    }
    printf("PRODUCTPKG\tassertions=%d\tfailed=%d\n", assertions, failed);
    return failed ? 1 : 0;
}
