/* Read-derived CX code material for the measured native libneed lookup hot
 * path. prepare ROOT NEW_MAT SAVED_BOOTSTRAP | --verify ROOT MAT; caller55.
 * No compiler, Python, header mutation, NN construction or test verdict.
 * Base C is retained verbatim. Exactly five system include lines are removed;
 * only sorted-node lookup receives a guarded binary-search implementation.
 * The original unsorted construction lookup and every scanner, closure,
 * output and existing refusal remain. An impossible add-after-sort refuses.
 * CURRENT_ROOT/include is the explicit compiler include input, independent
 * of the saved P53 bootstrap's ORIGINAL artifact/build-record source role.
 * System/host dependencies remain nonhermetic trust inputs. PREPARED material
 * is not an actual native compile, matching executable or NN qualification.
 * Runtime producer-source hashes do not prove a compiled caller's lineage;
 * actual compiler role/flags/module/ELF profiles remain the caller's duty.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.kernelsha
#pragma unisa use text.text
typedef struct {char *name;size_t n;unsigned mode;int directory;char sha[65];} LmEntry;
typedef struct {np_buf base,source,bootstrap,record,inputs,receipt;char builder[4400],builder_source[65],producer[65],bootstrap_sha[65],record_sha[65];} LmMaterial;
static char root[4096],mat[4400],self[4096];static LmEntry entries[8192];static int count,hash_ready;
static const char *base_sha="5f0469bcb6268bf979d8bb872424ae238c8f991b51543337b6f4b2750b2fdbb1";
static const char *p53="53e2cd1f669c92fda2c16dd93a9021cd4db97f05c57ab2d1acf9a835cbac9857";
static void die(const char *s){fprintf(stderr,"libneed-material: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void path(char p[4400],const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path-bound");}
static void hash(const void *s,size_t n,char h[65]){if(n<1024){cx_sha256_hex(s,n,h);return;}if(!hash_ready){char t[65];int rc=ks_sha256_hex("",0,t);if(rc||strcmp(t,"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"))die("kernel-sha-empty-selfcheck");rc=ks_sha256_hex("abc",3,t);if(rc||strcmp(t,"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"))die("kernel-sha-abc-selfcheck");hash_ready=1;}int rc=ks_sha256_hex(s,n,h);if(rc){char why[100];snprintf(why,sizeof why,"kernel-sha-rc=%d",rc);die(why);}}
static char *load(const char *p,size_t *n,unsigned *mode){struct stat a,b;if(lstat(p,&a))die(errno==ENOENT?"input-ENOENT":"input-stat-error");if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>268435456)die("bounded-regular-input");int fd=open(p,O_RDONLY|O_NOFOLLOW|O_CLOEXEC|O_NONBLOCK);if(fd<0)die("input-open");if(fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size||a.st_mode!=b.st_mode)die("input-descriptor-identity");*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s)die("allocation");size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("input-extent");at+=(size_t)z;}char x;ssize_t z;do{z=read(fd,&x,1);}while(z<0&&errno==EINTR);int changed=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size||a.st_mode!=b.st_mode;int closed=close(fd);if(z||changed||closed)die("input-changed-or-close");s[*n]=0;if(mode)*mode=(unsigned)a.st_mode&07777;return s;}
static void digest(const char *p,char h[65]){size_t n;char *s=load(p,&n,0);hash(s,n,h);free(s);}
static np_buf bytes(const char *p){size_t n;char *s=load(p,&n,0);np_buf b={0};np_put(&b,s,n);free(s);return b;}
static void row(np_buf *b,const char *k,const char *v){np_puts(b,k);np_puts(b,"\t");np_puts(b,v);np_puts(b,"\n");}
static int safe(const char *s){if(!*s||*s=='/'||strpbrk(s,"\r\n\t\\"))return 0;const char *p=s;while(*p){const char *q=strchr(p,'/');size_t n=q?(size_t)(q-p):strlen(p);if(!n||(n==1&&p[0]=='.')||(n==2&&p[0]=='.'&&p[1]=='.'))return 0;for(size_t i=0;i<n;i++)if(!((p[i]>='a'&&p[i]<='z')||(p[i]>='A'&&p[i]<='Z')||(p[i]>='0'&&p[i]<='9')||p[i]=='_'||p[i]=='-'||p[i]=='.'))return 0;if(!q)break;p=q+1;}return 1;}
static void add(const char *rel,const struct stat *st,int directory){if(count==8192||!safe(rel))die("header-entry-name-or-capacity");LmEntry *e=&entries[count++];e->name=strdup(rel);if(!e->name)die("allocation");e->directory=directory;e->mode=(unsigned)st->st_mode&07777;e->n=0;e->sha[0]=0;if(!directory){char p[4400];path(p,root,rel);unsigned mode;char *s=load(p,&e->n,&mode);e->mode=mode;hash(s,e->n,e->sha);free(s);}}
static void walk(const char *rel,int depth){if(depth>48)die("header-tree-depth");char p[4400];path(p,root,rel);struct stat st;if(lstat(p,&st))die(errno==ENOENT?"header-ENOENT":"header-stat-error");if(S_ISREG(st.st_mode)){add(rel,&st,0);return;}if(!S_ISDIR(st.st_mode))die("header-symlink-or-special-input");add(rel,&st,1);DIR *d=opendir(p);if(!d)die("header-directory-open");for(;;){errno=0;struct dirent *e=readdir(d);if(!e){int saved=errno,closed=closedir(d);if(saved||closed)die("header-directory-read-or-close");break;}if(tx_eq(e->d_name, ".", 1L << 20)||tx_eq(e->d_name, "..", 1L << 20))continue;char next[4400];path(next,rel,e->d_name);walk(next,depth+1);}}
static int cmp(const void *a,const void *b){return strcmp(((const LmEntry *)a)->name,((const LmEntry *)b)->name);}
static void file_row(np_buf *b,const char *role,const char *name,const char *file){size_t n;unsigned mode;char *s=load(file,&n,&mode),h[65];hash(s,n,h);free(s);np_puts(b,role);np_puts(b,"\t");np_puts(b,name);np_puts(b,"\t");np_putll(b,mode);np_puts(b,"\t");np_putll(b,(long long)n);np_puts(b,"\t");np_puts(b,h);np_puts(b,"\n");}
static np_buf snapshot(const LmMaterial *m){for(int i=0;i<count;i++)free(entries[i].name);count=0;walk("include",0);qsort(entries,(size_t)count,sizeof *entries,cmp);np_buf b={0};np_puts(&b,"libneed-material-applicable-inputs-v1\nscope\tcomplete-current-include-tree-all-modes-plus-fixed-producer-support-and-original-saved-bootstrap\n");for(int i=0;i<count;i++){LmEntry *e=&entries[i];if(i&&tx_eq(e[-1].name, e->name, 1L << 20))die("duplicate-header-entry");np_puts(&b,e->directory?"directory\t":"header-input\t");np_puts(&b,e->name);np_puts(&b,"\t");np_putll(&b,e->mode);if(!e->directory){np_puts(&b,"\t");np_putll(&b,(long long)e->n);np_puts(&b,"\t");np_puts(&b,e->sha);}np_puts(&b,"\n");}const char *support[]={"seed/unisa_libneed.c","tools/libneed-material.cx","tools/cxlib/netpack.cx","tools/cxlib/kernelsha.cx"};for(int i=0;i<4;i++){char p[4400];path(p,root,support[i]);file_row(&b,"producer-input",support[i],p);}file_row(&b,"compiler-input","saved-original-bootstrap-artifact",m->builder);char rp[4400];int n=snprintf(rp,sizeof rp,"%s.build.json",m->builder);if(n<0||n>=sizeof rp)die("bootstrap-record-path");file_row(&b,"compiler-input","saved-original-bootstrap-record",rp);return b;}
static char *unique(char *s,const char *fragment){char *p=strstr(s,fragment);if(!p||strstr(p+1,fragment))die("unique-transform-fragment");return p;}
static char *replace(char *s,const char *old,const char *next){char *p=unique(s,old);size_t a=(size_t)(p-s),n=strlen(s),o=strlen(old),k=strlen(next);char *r=malloc(n-o+k+1);if(!r)die("allocation");memcpy(r,s,a);memcpy(r+a,next,k);memcpy(r+a+k,p+o,n-a-o+1);free(s);return r;}
static np_buf derive(LmMaterial *m){
 char h[65];hash(m->base.p,m->base.n,h);if(strcmp(h,base_sha)||memchr(m->base.p,0,m->base.n)||memchr(m->base.p,'\r',m->base.n))die("fixed-base-C-source-required");char *s=strdup(m->base.p);if(!s)die("allocation");
 const char *includes[]={"#include <dirent.h>\n","#include <stdio.h>\n","#include <stdlib.h>\n","#include <string.h>\n","#include <sys/stat.h>\n"};for(int i=0;i<5;i++)s=replace(s,includes[i],"");if(strstr(s,"#include"))die("unexpected-base-include-after-five-exact-strips");
 s=replace(s,"static Node *nodes; static size_t nn, ncap;\n","static Node *nodes; static size_t nn, ncap;\nstatic int lm_nodes_sorted;\n");
 const char *old_find="static Node *find_node(const char *s) {\n    size_t i; for (i = 0; i < nn; i++) if (!strcmp(nodes[i].name, s)) return &nodes[i];\n    return NULL;\n}\n";
 const char *new_find="static Node *find_node(const char *s) {\n    if (lm_nodes_sorted) {\n        size_t lo = 0, hi = nn;\n        while (lo < hi) {\n            size_t mid = lo + (hi - lo) / 2;\n            int order = strcmp(nodes[mid].name, s);\n            if (order < 0) lo = mid + 1;\n            else if (order > 0) hi = mid;\n            else return &nodes[mid];\n        }\n        return NULL;\n    }\n    size_t i; for (i = 0; i < nn; i++) if (!strcmp(nodes[i].name, s)) return &nodes[i];\n    return NULL;\n}\n";
 s=replace(s,old_find,new_find);
 s=replace(s,"static Node *add_node(const char *s, int body) {\n    Node *x;\n","static Node *add_node(const char *s, int body) {\n    Node *x;\n    if (lm_nodes_sorted) die(\"add node after sorted lookup begins\", s);\n");
 s=replace(s,"    qsort(nodes, nn, sizeof *nodes, cmp_nodes);\n","    qsort(nodes, nn, sizeof *nodes, cmp_nodes);\n    lm_nodes_sorted = 1;\n");
 s=replace(s,"    free(nodes); nodes = NULL; nn = ncap = 0;\n","    free(nodes); nodes = NULL; nn = ncap = 0; lm_nodes_sorted = 0;\n");
 unique(s,new_find);unique(s,"    lm_nodes_sorted = 1;\n");unique(s,"nn = ncap = 0; lm_nodes_sorted = 0;\n");
 np_buf b={0};np_puts(&b,"/* GENERATED source material by tools/libneed-material.cx.\n * Original C retained as base-unisa_libneed.c; base sha256=");np_puts(&b,base_sha);np_puts(&b,"\n * Producer sha256=");np_puts(&b,m->producer);np_puts(&b,"\n * Exactly five system include lines stripped for implicit CX runtime.\n * Only sorted find_node uses binary search; unsorted construction stays linear.\n * This is not native-build, NN, functional PASS or historical producer evidence.\n */\n");np_puts(&b,s);free(s);return b;
}
static int hex64(const char *s){if(strlen(s)!=64)return 0;for(int i=0;i<64;i++)if(!((s[i]>='a'&&s[i]<='f')||(s[i]>='0'&&s[i]<='9')))return 0;return 1;}
static void json_hash(char *record,const char *key,char h[65]){char tag[120];int n=snprintf(tag,sizeof tag,"\n  \"%s\": \"",key);if(n<0||n>=sizeof tag)die("record-key-bound");char *p=unique(record,tag)+strlen(tag);if(strlen(p)<67||p[64]!='\"'||p[65]!=','||p[66]!='\n')die("bootstrap-hash-field-shape");memcpy(h,p,64);h[64]=0;if(!hex64(h))die("bootstrap-hash-field-hex");}
static void record_ok(LmMaterial *m){hash(m->bootstrap.p,m->bootstrap.n,m->bootstrap_sha);hash(m->record.p,m->record.n,m->record_sha);if(strcmp(m->bootstrap_sha,p53)||m->bootstrap.n!=4911193)die("explicit-saved-P53-bootstrap-required");if(m->record.n<4||m->record.n>16384||memcmp(m->record.p,"{\n",2)||memcmp(m->record.p+m->record.n-3,"\n}\n",3)||memchr(m->record.p,0,m->record.n)||memchr(m->record.p,'\r',m->record.n))die("original-bootstrap-record-wire");char h[65];json_hash(m->record.p,"artifact_sha256",h);if(strcmp(h,m->bootstrap_sha))die("original-record-artifact-mismatch");json_hash(m->record.p,"sources_sha256",m->builder_source);char bytes_field[120];snprintf(bytes_field,sizeof bytes_field,"\n  \"bytes\": %lu,\n",(unsigned long)m->bootstrap.n);unique(m->record.p,bytes_field);unique(m->record.p,"\n  \"schema\": 1,\n");}
static np_buf receipt(LmMaterial *m){np_buf b={0};np_puts(&b,"libneed-CX-code-material-v1\nstatus\tPREPARED\nscope\tfive-include-strip-and-sorted-node-binary-lookup-only-no-NN-or-PASS\n");row(&b,"root",root);row(&b,"saved-bootstrap-path",m->builder);row(&b,"saved-bootstrap-artifact",m->bootstrap_sha);row(&b,"saved-bootstrap-original-record",m->record_sha);row(&b,"saved-bootstrap-recorded-source",m->builder_source);row(&b,"producer",m->producer);row(&b,"base-C",base_sha);row(&b,"transform-contract","5-unique-include-strips;1-flag-declaration;1-find_node-block;1-add_node-guard;1-qsort-flag-set;1-free-flag-reset");row(&b,"sha-provider","libneed-material-hybrid-provider-v1-threshold1024-AF_ALG-selfchecked-no-fallback");row(&b,"planned-native-flags","-I CURRENT_ROOT/include -O2 -b lnx/x86_64");char include[4400];path(include,root,"include");row(&b,"planned-native-include",include);row(&b,"planned-native-input","libneed.cx");row(&b,"native-build-evidence","NOT_RECORDED;actual-native-artifact-and-compiler-code-profile-require-separate-evidence");row(&b,"trust","saved-bootstrap-original-role-and-current-carried-headers-distinct;HOSTCC-system-dependencies-remain-nonhermetic");row(&b,"observations","fresh-complete-input-endpoints-not-atomic-or-historical-proof");const char *names[]={"base-unisa_libneed.c","libneed.cx","bootstrap-input.com","bootstrap-input.com.build.json","inputs.tsv"};const np_buf *bufs[]={&m->base,&m->source,&m->bootstrap,&m->record,&m->inputs};for(int i=0;i<5;i++){char h[65];hash(bufs[i]->p,bufs[i]->n,h);row(&b,names[i],h);}return b;}
static void write_new(const char *p,const np_buf *b,int mode){int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC|O_NOFOLLOW,mode);if(fd<0)die("exclusive-material-output");size_t at=0;while(at<b->n){ssize_t n=write(fd,b->p+at,b->n-at);if(n<0&&errno==EINTR)continue;if(n<=0)die("material-write");at+=(size_t)n;}int bad=fsync(fd),closed=close(fd);if(bad||closed)die("material-sync-or-close");}
static void save(const char *name,const np_buf *b,int mode){char p[4400];path(p,mat,name);write_new(p,b,mode);}
static void equal(const char *name,const np_buf *b){char p[4400];path(p,mat,name);np_buf a=bytes(p);int ok=a.n==b->n&&!memcmp(a.p,b->p,a.n);free(a.p);if(!ok)die("material-bytes-or-receipt-mismatch");}
static void material_equal(LmMaterial *m){equal("base-unisa_libneed.c",&m->base);equal("libneed.cx",&m->source);equal("bootstrap-input.com",&m->bootstrap);equal("bootstrap-input.com.build.json",&m->record);equal("inputs.tsv",&m->inputs);equal("material.tsv",&m->receipt);}
static void free_material(LmMaterial *m){free(m->base.p);free(m->source.p);free(m->bootstrap.p);free(m->record.p);free(m->inputs.p);free(m->receipt.p);}
static LmMaterial observe(const char *builder){LmMaterial m={0};if(!realpath(builder,m.builder)||strpbrk(m.builder,"\r\n\t"))die("saved-bootstrap-realpath");char p[4400],h[65];path(p,root,"tools/libneed-material.cx");digest(p,m.producer);digest(self,h);if(strcmp(h,m.producer))die("producer-must-be-current-root-tool");path(p,root,"seed/unisa_libneed.c");m.base=bytes(p);m.bootstrap=bytes(m.builder);int n=snprintf(p,sizeof p,"%s.build.json",m.builder);if(n<0||n>=sizeof p)die("bootstrap-record-path");m.record=bytes(p);record_ok(&m);m.source=derive(&m);m.inputs=snapshot(&m);m.receipt=receipt(&m);return m;}
static void stable(LmMaterial *before){LmMaterial after=observe(before->builder);const np_buf *a[]={&before->base,&before->source,&before->bootstrap,&before->record,&before->inputs,&before->receipt};const np_buf *b[]={&after.base,&after.source,&after.bootstrap,&after.record,&after.inputs,&after.receipt};for(int i=0;i<6;i++)if(a[i]->n!=b[i]->n||memcmp(a[i]->p,b[i]->p,a[i]->n))die("applicable-input-or-derived-material-changed");free_material(&after);}
static void bootstrap_field(char out[4400]){char p[4400];path(p,mat,"material.tsv");np_buf b=bytes(p);if(!b.n||b.p[b.n-1]!='\n'||memchr(b.p,0,b.n)||memchr(b.p,'\r',b.n))die("material-receipt-wire");const char *tag="\nsaved-bootstrap-path\t";char *s=unique(b.p,tag)+strlen(tag),*e=strchr(s,'\n');if(!e||e==s||e-s>=4400||s[0]!='/'||memchr(s,'\t',(size_t)(e-s)))die("saved-bootstrap-field");memcpy(out,s,(size_t)(e-s));out[e-s]=0;free(b.p);}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN libneed-material requires Linux/x86_64 LP64\n",stderr);return 3;
#endif
 int prep=argc>=2&&tx_eq(argv[1], "prepare", 1L << 20);if((prep?argc!=5:argc!=4)||(!prep&&strcmp(argv[1],"--verify"))||sizeof(long)!=8||!realpath(argv[2],root)||argv[3][0]!='/'||strlen(argv[3])>=sizeof mat||strpbrk(argv[3],"\r\n\t")||!realpath(__FILE__,self))die("usage-prepare-ROOT-NEW_MAT-SAVED_BOOTSTRAP-or-verify-ROOT-MAT");strcpy(mat,argv[3]);char builder[4400];if(prep){if(argv[4][0]!='/'||!realpath(argv[4],builder))die("absolute-saved-bootstrap-required");if(mkdir(mat,0700))die(errno==EEXIST?"fresh-material-directory-required":"material-mkdir-error");}else{struct stat st;if(lstat(mat,&st))die(errno==ENOENT?"material-ENOENT":"material-stat-error");if(!S_ISDIR(st.st_mode))die("normal-material-directory-required");bootstrap_field(builder);}LmMaterial m=observe(builder);if(prep){save("base-unisa_libneed.c",&m.base,0600);save("libneed.cx",&m.source,0600);save("bootstrap-input.com",&m.bootstrap,0700);save("bootstrap-input.com.build.json",&m.record,0600);save("inputs.tsv",&m.inputs,0600);save("material.tsv",&m.receipt,0600);}material_equal(&m);stable(&m);material_equal(&m);free_material(&m);puts(prep?"PREPARED\tlibneed-CX-code-material\tnative-build-NOT_RECORDED\tno-NN-or-test-result":"VERIFIED\tlibneed-CX-code-material\tnative-build-NOT_RECORDED\tno-NN-or-test-result");return 0;
}
