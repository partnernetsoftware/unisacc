#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.sig
#pragma unisa use text.text
#pragma unisa use mem.heap
/* Does an allocation failure set errno to ENOMEM? (C44-ALLOC-ERRNO-01)
 *
 *   sh ./unisacc.com tools/check-errno.cx -- ROOT
 *
 * The in-C allocator returned NULL without touching errno, so a legal program
 * that reports a failed allocation printed "malloc: Success" and a program
 * branching on errno == ENOMEM took the wrong arm:
 *   errno = 0; p = malloc(1 << 46);   -> p NULL, errno still 0 (glibc: 12)
 * fopen and strerror already agreed with glibc, so they are the control group
 * here: they must be green before and after the fix, or this tool is measuring
 * the wrong thing.
 *
 * Three observables, each a small program run through the product: an
 * allocation failure sets ENOMEM and a success leaves errno alone, a missing
 * file leaves ENOENT on an unsuccessful fopen and nothing on a successful one,
 * and strerror(2)/strerror(12) carry the glibc text.
 */
static int g_fail;
static void die(const char *s) { sy_eprintf("errno: REFUSE %s\n", s); sy_exit(2); }
static void ck(int ok, const char *name) {
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", name);
    if (!ok) g_fail = g_fail + 1;
}
static int has(const char *h, long n, const char *needle) {
    long i, k, m;
    m = tx_len(needle, 4096);
    if (!h || m == 0) return 0;
    i = 0;
    while (i + m <= n) {
        k = 0;
        while (k < m && h[i + k] == needle[k]) k = k + 1;
        if (k == m) return 1;
        i = i + 1;
    }
    return 0;
}

/* Each source prints OK <name> only when every assertion inside it held.
   A success path must not reset errno: ISO C says no library function does. */
static const char *src_alloc =
    "int main(void){void *p; char *q; int e;\n"
    "  errno = 0; p = malloc((size_t)1 << 46);\n"
    "  if (p != 0 || errno != 12) { printf(\"BAD huge p=%p errno=%d\\n\", p, errno); return 1; }\n"
    "  errno = 0; q = (char *)malloc(64);\n"
    "  if (q == 0 || errno != 0) { printf(\"BAD small errno=%d\\n\", errno); return 1; }\n"
    "  errno = 7; p = realloc(q, (size_t)1 << 46);\n"
    "  if (p != 0 || errno != 12) { printf(\"BAD realloc errno=%d\\n\", errno); return 1; }\n"
    "  errno = 0; p = calloc((size_t)1 << 40, (size_t)1 << 40);\n"
    "  if (p != 0 || errno != 12) { printf(\"BAD calloc errno=%d\\n\", errno); return 1; }\n"
    "  errno = 7; p = malloc(128);\n"
    "  if (p == 0 || errno != 7) { printf(\"BAD success-keeps errno=%d\\n\", errno); return 1; }\n"
    "  e = errno; (void)e;\n"
    "  printf(\"OK alloc-failure-errno\\n\"); return 0; }\n";

static const char *src_fopen =
    "int main(int argc, char **argv){FILE *f;\n"
    "  if (argc < 2) { printf(\"BAD argv\\n\"); return 1; }\n"
    "  errno = 7; f = fopen(argv[1], \"r\");\n"
    "  if (!f || errno != 7) { printf(\"BAD open-ok errno=%d\\n\", errno); return 1; }\n"
    "  fclose(f);\n"
    "  errno = 0; f = fopen(\"/definitely/not/here\", \"r\");\n"
    "  if (f || errno != 2) { printf(\"BAD open-miss errno=%d\\n\", errno); return 1; }\n"
    "  printf(\"OK fopen-errno\\n\"); return 0; }\n";

static const char *src_strerror =
    "int main(void){const char *a = strerror(2), *b = strerror(12);\n"
    "  if (strcmp(a, \"No such file or directory\") != 0) { printf(\"BAD s2 [%s]\\n\", a); return 1; }\n"
    "  if (strcmp(b, \"Cannot allocate memory\") != 0) { printf(\"BAD s12 [%s]\\n\", b); return 1; }\n"
    "  printf(\"OK strerror-text\\n\"); return 0; }\n";

static const char *src_data = "errno probe\n";

static int wr(const char *path, const char *s) {
    int fd;
    fd = sy_open(path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (fd < 0) return 1;
    if (sy_write_all(fd, s, tx_len(s, 4096))) { sy_close(fd); return 1; }
    sy_close(fd);
    return 0;
}

int main(int argc, char **argv) {
    char root[4096], com[4400], work[4400], sa[4400], sf[4400], ss[4400], df[4400];
    char *v[8];
    char *e[2];
    char why[512];
    np_result r;
    int i;
    if (argc >= 2 && argv[1][0]) { if (cx_fmt(root, sizeof root, "%s", argv[1])) die("root"); }
    else if (sy_cwd(root, sizeof root) < 0) die("cwd");
    if (cx_fmt(com, sizeof com, "%s/unisacc.com", root)) die("com");
    if (sy_mkdtemp(sy_tmpdir(), "cer-", work, (int)sizeof work)) die("work");
    if (cx_fmt(sa, sizeof sa, "%s/alloc.cx", work)) die("src");
    if (cx_fmt(sf, sizeof sf, "%s/fopen.cx", work)) die("src");
    if (cx_fmt(ss, sizeof ss, "%s/strerror.cx", work)) die("src");
    if (cx_fmt(df, sizeof df, "%s/data.txt", work)) die("data");
    if (wr(sa, src_alloc) || wr(sf, src_fopen) || wr(ss, src_strerror) || wr(df, src_data)) die("write src");

    /* the allocator must name ENOMEM, and a success must leave errno alone */
    i = 0; v[i++] = "sh"; v[i++] = com; v[i++] = sa; v[i] = 0;
    e[0] = "UNISACC_RUN_CACHE=0"; e[1] = 0;
    if (np_run(v, root, e, 60, &r, why, sizeof why)) die(why);
    ck(r.rc == 0 && has(r.out, (long)r.outn, "OK alloc-failure-errno"), "alloc-failure-errno");
    if (r.rc != 0) sy_printf("NOTE\talloc\texit\t%d\t%.*s", r.rc, (int)(r.outn > 200 ? 200 : r.outn), r.out ? r.out : "");
    np_free(&r);

    /* control: fopen already agreed with glibc before the fix */
    i = 0; v[i++] = "sh"; v[i++] = com; v[i++] = sf; v[i++] = "--"; v[i++] = df; v[i] = 0;
    if (np_run(v, root, e, 60, &r, why, sizeof why)) die(why);
    ck(r.rc == 0 && has(r.out, (long)r.outn, "OK fopen-errno"), "fopen-errno");
    np_free(&r);

    /* control: strerror text */
    i = 0; v[i++] = "sh"; v[i++] = com; v[i++] = ss; v[i] = 0;
    if (np_run(v, root, e, 60, &r, why, sizeof why)) die(why);
    ck(r.rc == 0 && has(r.out, (long)r.outn, "OK strerror-text"), "strerror-text");
    np_free(&r);

    printf("CHECK_ERRNO\tfailed=%d\n", g_fail);
    return g_fail ? 1 : 0;
}
