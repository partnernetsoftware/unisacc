/* tools/check-relstore.cx -- the relation cache must be reproducible, invalidatable and incrementally exact.
 *
 *   sh ./unisacc.com tools/check-relstore.cx [TABLE_ROOT]
 *
 * TABLE_ROOT defaults to "."; the edges are extracted by tools/cxlib/relload.cx from that root's published
 * relation tables, which is the real input a caller has, not a hand-written fixture.  Everything the store
 * writes lives under a fresh /tmp directory per case.  Ends with CHECK_RELSTORE\tfailed=N; exit 0 only when N is 0.
 *
 * Cases
 *   rebuild-is-byte-stable        two rebuilds of the same edges produce byte-identical files.tsv and edges.tsv
 *   rebuild-ignores-input-order   the same edges collected in reverse order produce the same bytes
 *   meta-records-extractor       meta names the format and the extractor sha
 *   status-fresh-then-stale       fresh for the same sha, stale (1) after the extractor sha changes
 *   stale-store-refuses-update    an incremental update on a stale store is refused, not mixed in
 *   incremental-equals-rebuild    edges of one src dropped + new edges added == a full rebuild of the result
 *   refuse-malformed-edge         a 4-field edge is refused by name (rebuild and incremental)
 *   refuse-empty-src              an edge with an empty src is refused by name
 *   files-sorted-by-path          files.tsv is sorted by path regardless of the order they were passed
 *   update-file-*                 G9 rs_update_file: one changed file, an added file, a dropped file (sha 0):
 *                                 edges.tsv and files.tsv each byte-identical to a full rebuild; stale refused
 */
#pragma unisa use cxlib.relstore
#pragma unisa use cxlib.relload
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.die
#pragma unisa use sys.fs
#pragma unisa use text.text

static int failed;
static void die(const char *s) { tool_die("check-relstore", s, 0, 2); }
static void ck(int ok, const char *n) {
    printf("%s\trelstore.%s\n", ok ? "PASS" : "FAIL", n);
    if (!ok) failed++;
}

/* byte search without strstr: the needle is run-time text, not source */
static int has(const char *s, long n, const char *p) {
    long pl = (long)strlen(p), i;
    if (!s) return 0;
    for (i = 0; pl && i + pl <= n; i++) if (!memcmp(s + i, p, (size_t)pl)) return 1;
    return 0;
}

/* a fresh empty directory under /tmp */
static int fresh(char *out, long cap) {
    char t[] = "/tmp/chk-relstore-XXXXXX";
    if (!mkdtemp(t)) return -1;
    return cx_fmt(out, (size_t)cap, "%s", t);
}

/* read a whole store file; NULL when absent */
static char *slurp(const char *dir, const char *name, size_t *n) {
    char p[4400];
    if (cx_fmt(p, sizeof p, "%s/%s", dir, name)) return 0;
    if (sy_exists(p) != 1) return 0;
    return cx_read(p, n);
}
static int same_file(const char *a, const char *b, const char *name) {
    size_t an = 0, bn = 0;
    char *x = slurp(a, name, &an), *y = slurp(b, name, &bn);
    int same = x && y && an == bn && (an == 0 || !memcmp(x, y, an));
    free(x); free(y);
    return same;
}

/* the extractor shas used as identities: two different 64-hex strings */
static const char *SEEN_X1 = "1111111111111111111111111111111111111111111111111111111111111111";
static const char *SEEN_X2 = "2222222222222222222222222222222222222222222222222222222222222222";

int main(int argc, char **argv) {
    const char *root = argc > 1 ? argv[1] : ".";
    char path[4400], s1[1200], s2[1200], s3[1200], why[300];
    np_buf edges = {0}, e1 = {0}, e2 = {0};
    rs_file files[3];
    int i;

    /* the real extraction: relload over the published relation tables */
    if (cx_fmt(path, sizeof path, "%s/build/links.tsv", root)) die("path");
    if (rl_load(&edges, path, rl_fmt_links(), why, (int)sizeof why)) die("links");
    if (cx_fmt(path, sizeof path, "%s/build/table-index.tsv", root)) die("path");
    if (rl_load(&edges, path, rl_fmt_table_index(), why, (int)sizeof why)) die("table-index");
    if (!edges.p || edges.n == 0) die("no-edges");

    files[0].path = "build/links.tsv"; files[0].sha = SEEN_X1; files[0].size = (long long)edges.n;
    files[1].path = "build/table-index.tsv"; files[1].sha = SEEN_X1; files[1].size = 1;
    files[2].path = "alpha.tsv"; files[2].sha = SEEN_X1; files[2].size = 2;

    /* two rebuilds into separate stores must agree byte for byte */
    if (fresh(s1, (long)sizeof s1) || fresh(s2, (long)sizeof s2) || fresh(s3, (long)sizeof s3)) die("temp");
    why[0] = 0;
    if (rs_rebuild(s1, SEEN_X1, files, 3, edges.p, (long)edges.n, why, (int)sizeof why)) die("rebuild-1");
    if (rs_rebuild(s2, SEEN_X1, files, 3, edges.p, (long)edges.n, why, (int)sizeof why)) die("rebuild-2");
    ck(same_file(s1, s2, "edges.tsv") && same_file(s1, s2, "files.tsv"), "rebuild-is-byte-stable");

    /* the same edges, collected in a different order, must land identically: the store clusters by src */
    {   long at = 0, total = (long)edges.n, nlines = 0, k;
        long starts[8192];
        while (at < total && nlines < 8192) { starts[nlines++] = at; while (at < total && edges.p[at] != '\n') at++; at++; }
        for (k = nlines - 1; k >= 0; k--) {
            long b = starts[k], e = b;
            while (e < total && edges.p[e] != '\n') e++;
            np_put(&e1, edges.p + b, (size_t)(e - b));
            np_put(&e1, "\n", 1);
        }
        if (nlines == 0) die("no-lines");
        if (rs_rebuild(s3, SEEN_X1, files, 3, e1.p, (long)e1.n, why, (int)sizeof why)) die("rebuild-3");
        ck(same_file(s1, s3, "edges.tsv"), "rebuild-ignores-input-order");
    }

    /* meta names the format and the extractor */
    {   size_t n = 0;
        char *m = slurp(s1, "meta", &n);
        ck(m && has(m, (long)n, "format\trel-v1") && has(m, (long)n, SEEN_X1), "meta-records-extractor");
        free(m);
    }

    /* fresh for its own sha, stale as soon as the extractor changes */
    why[0] = 0;
    ck(rs_status(s1, SEEN_X1, why, (int)sizeof why) == 0, "status-fresh-same-extractor");
    why[0] = 0;
    ck(rs_status(s1, SEEN_X2, why, (int)sizeof why) == 1, "status-stale-after-extractor-change");

    /* an update of a stale store is refused: mixing two extractors into one table is not an update */
    why[0] = 0;
    ck(rs_incremental(s1, SEEN_X2, "build/links.tsv\n", 17, "", 0, why, (int)sizeof why) < 0, "stale-store-refuses-update");

    /* Negative control for the package-root rule: same extractor, different cxroot.tsv content -> a different
       identity -> the store is stale as a whole.  This is the case a source-file sha alone cannot see: no source
       changed, yet every use edge may now point elsewhere. */
    {   char cfgA[65], cfgB[65], s6[1200];
        why[0] = 0;
        if (rs_identity(SEEN_X1, "cxroot.tsv\tA\n", 13, cfgA) || rs_identity(SEEN_X1, "cxroot.tsv\tB\n", 13, cfgB)) die("identity");
        ck(strcmp(cfgA, cfgB) != 0, "rootcfg-changes-identity");
        if (fresh(s6, (long)sizeof s6)) die("temp");
        if (rs_rebuild(s6, cfgA, files, 3, edges.p, (long)edges.n, why, (int)sizeof why)) die("rebuild-cfg");
        why[0] = 0;
        ck(rs_status(s6, cfgA, why, (int)sizeof why) == 0, "rootcfg-same-identity-fresh");
        why[0] = 0;
        ck(rs_status(s6, cfgB, why, (int)sizeof why) == 1, "rootcfg-changed-store-stale");
    }

    /* incremental == rebuild: drop every edge whose src is one changed path, add new edges, compare with a
       full rebuild of exactly that resulting edge set */
    {   const char *changed = "build/links.tsv\n";
        const char *newe = "derive\tbuild/links.tsv\tbuild/new-target.tsv\tlinks-gen\tbound=1;write=0\n";
        long at = 0, total = (long)edges.n;
        /* the expectation: every edge not from that src, plus the new ones */
        while (at < total) {
            long b = at, e = at, f1 = 0, f2 = 0;
            while (e < total && edges.p[e] != '\n') e++;
            for (f1 = b; edges.p[f1] != '\t'; f1++) { }
            f2 = f1 + 1;
            {   long srcb = f2, srce = srcb;
                while (edges.p[srce] != '\t') srce++;
                if (!(srce - srcb == 15 && !memcmp(edges.p + srcb, "build/links.tsv", 15))) {
                    np_put(&e2, edges.p + b, (size_t)(e - b));
                    np_put(&e2, "\n", 1);
                }
            }
            at = e + 1;
        }
        np_puts(&e2, newe);
        why[0] = 0;
        if (rs_incremental(s1, SEEN_X1, changed, 16, newe, (long)strlen(newe), why, (int)sizeof why)) die("incremental");
        {   char s4[1200];
            if (fresh(s4, (long)sizeof s4)) die("temp");
            if (rs_rebuild(s4, SEEN_X1, files, 3, e2.p, (long)e2.n, why, (int)sizeof why)) die("rebuild-expect");
            ck(same_file(s1, s4, "edges.tsv"), "incremental-equals-rebuild");
        }
    }

    /* G9: one file changed (new sha, size, out-edges) -> rs_update_file == a full rebuild of the updated list and
       edge set, byte for byte in BOTH tables; then a new file added, then a file dropped (sha 0) */
    {   char s7[1200], s8[1200];
        const char *newe = "derive\tbuild/links.tsv\tbuild/new-target.tsv\tlinks-gen\tbound=1;write=0\n";
        rs_file up = {"build/links.tsv", SEEN_X2, 99}, add = {"zeta.tsv", SEEN_X2, 7}, gone = {"alpha.tsv", 0, 0};
        rs_file f2[4];
        const char *adde = "derive\tzeta.tsv\tbuild/z.tsv\tlinks-gen\tx=1\n";
        np_buf e3 = {0};
        if (fresh(s7, (long)sizeof s7) || fresh(s8, (long)sizeof s8)) die("temp");
        if (rs_rebuild(s7, SEEN_X1, files, 3, edges.p, (long)edges.n, why, (int)sizeof why)) die("rebuild-g9");
        f2[0] = up; f2[1] = files[1]; f2[2] = files[2];
        ck(rs_update_file(s7, SEEN_X1, &up, newe, (long)strlen(newe), why, (int)sizeof why) == 0, "update-file-ok");
        if (rs_rebuild(s8, SEEN_X1, f2, 3, e2.p, (long)e2.n, why, (int)sizeof why)) die("rebuild-g9-expect");
        ck(same_file(s7, s8, "edges.tsv") && same_file(s7, s8, "files.tsv"), "update-file-equals-rebuild");
        np_put(&e3, e2.p, (size_t)e2.n); np_puts(&e3, adde);
        f2[3] = add;
        ck(rs_update_file(s7, SEEN_X1, &add, adde, (long)strlen(adde), why, (int)sizeof why) == 0, "update-file-add-ok");
        if (rs_rebuild(s8, SEEN_X1, f2, 4, e3.p, (long)e3.n, why, (int)sizeof why)) die("rebuild-g9-add");
        ck(same_file(s7, s8, "edges.tsv") && same_file(s7, s8, "files.tsv"), "update-file-add-equals-rebuild");
        f2[2] = f2[3];
        ck(rs_update_file(s7, SEEN_X1, &gone, "", 0, why, (int)sizeof why) == 0, "update-file-drop-ok");
        if (rs_rebuild(s8, SEEN_X1, f2, 3, e3.p, (long)e3.n, why, (int)sizeof why)) die("rebuild-g9-drop");
        ck(same_file(s7, s8, "edges.tsv") && same_file(s7, s8, "files.tsv"), "update-file-drop-equals-rebuild");
        ck(rs_update_file(s7, SEEN_X2, &up, newe, (long)strlen(newe), why, (int)sizeof why) < 0, "update-file-stale-refused");
        free(e3.p);
    }

    /* a 4-field edge is refused by name in both entry points */
    {   char s5[1200];
        const char *bad = "derive\tbuild/x\tbuild/y\n";
        if (fresh(s5, (long)sizeof s5)) die("temp");
        why[0] = 0;
        ck(rs_rebuild(s5, SEEN_X1, files, 3, bad, (long)strlen(bad), why, (int)sizeof why) < 0
           && has(rs_last_why(), (long)strlen(rs_last_why()), "edges-fields"), "refuse-malformed-edge");
        why[0] = 0;
        ck(rs_incremental(s1, SEEN_X1, "none\n", 5, bad, (long)strlen(bad), why, (int)sizeof why) < 0
           && has(rs_last_why(), (long)strlen(rs_last_why()), "edges-fields"), "refuse-malformed-edge-incremental");
    }

    /* an empty src is refused by name */
    {   const char *bad = "derive\t\tbuild/y\tlinks-gen\tx=1\n";
        why[0] = 0;
        ck(rs_rebuild(s2, SEEN_X1, files, 3, bad, (long)strlen(bad), why, (int)sizeof why) < 0
           && has(rs_last_why(), (long)strlen(rs_last_why()), "edges-src"), "refuse-empty-src");
    }

    /* files.tsv is sorted by path: alpha.tsv comes first although it was passed last */
    {   size_t n = 0;
        char *f = slurp(s1, "files.tsv", &n);
        long first = 0;
        while (f && first < (long)n && f[first] != '\t') first++;
        ck(f && first == 9 && !memcmp(f, "alpha.tsv", 9), "files-sorted-by-path");
        free(f);
    }

    for (i = 0; i < 1; i++) { }
    free(edges.p);
    free(e1.p);
    free(e2.p);
    printf("CHECK_RELSTORE\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
