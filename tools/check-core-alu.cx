#pragma unisa use core.alu
void core_host_panic(const char *s){fprintf(stderr,"unexpected panic: %s\n",s);exit(2);}
int main(void){
 int failed=0,z=9;
 if(core_alu32(0,2147483647,1)!=(-2147483647-1))failed++;
 if(core_alu32(3,(-2147483647-1),-1)!=(-2147483647-1))failed++;
 if(core_alu32(4,(-2147483647-1),-1)!=0)failed++;
 if(core_alu32(8,1,32)!=1)failed++;
 if(core_alu32(9,-8,1)!=-4)failed++;
 if(core_alu64(10,INT64_MIN,-1,&z)!=INT64_MIN||z)failed++;
 if(core_alu64(11,INT64_MIN,-1,&z)!=0||z)failed++;
 if(core_alu64(12,1,0,&z)!=0||z!=1)failed++;
 if(core_alu64(13,-1,2,&z)!=1||z)failed++;
 if(core_alu64(15,-1,1,&z)!=INT64_MAX||z)failed++;
 printf("CXCORE_ALU failed=%d\n",failed);return failed?1:0;
}
