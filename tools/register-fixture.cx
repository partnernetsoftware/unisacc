/* tools/register-fixture.cx -- the batch tools/check-register.cx registers to test the registry lock.
 * A batch must be a real SOURCE row (tools/ or tests/ entry, rc0:MARKER), so the lock test needs an entry
 * that prints its marker and exits 0 without touching anything.  Not registered as a batch itself. */
int main(int argc,char **argv) {
    if(argc!=1){if(argc==3&&!strcmp(argv[1],"alpha")&&!strcmp(argv[2],"beta")){printf("REGISTER_FIXTURE_ARGS_OK\n");return 0;}return 2;}
    printf("REGISTER_FIXTURE_OK\n");
    return 0;
}
