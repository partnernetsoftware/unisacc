/* tools/flowsh.cx -- shorthand -> flow node table (absorbed from moltbaby omp-flow sh/read/map).
 *
 *   sh ./unisacc.com tools/flowsh.cx -- sh   [OPTS] 'CMD'...            one exec node (sh -c CMD) per argument
 *   sh ./unisacc.com tools/flowsh.cx -- read [OPTS] PATH[:A[-B]]...     one file.read node per argument
 *   sh ./unisacc.com tools/flowsh.cx -- map  [OPTS] VALUE... -- ARGV... one exec node per VALUE; every {} in
 *                                                                      ARGV is replaced by the VALUE (no shell)
 *
 * It only writes the node table (format: tools/cxlib/flowexec.cx header) to stdout, with every value
 * escaped (';' '%' and bytes <= 0x20 as %XX), so the caller never hand-escapes TAB, ';' or newlines:
 *   sh ./unisacc.com tools/flowsh.cx -- sh 'git log -3' 'ls tools | wc -l' | sh ./unisacc.com tools/devsvc.cx -- flow - --par 8 --cat
 * (devsvc flow, devsvc x and flowrun run refuse a run without an explicit --par N, 1..32, one node too.)
 * Nothing is executed here; running, locks, bounds and events stay in devsvc flow.
 *   OPTS (before the first item):
 *   --timeout-ms N   timeout_ms=N on every node (1..300000; engine default otherwise)
 *   --after ID[,ID]  every node (with --chain: the first) depends on these ids (for appending to a
 *                    larger table that defines them)
 *   --chain          node i depends on node i-1 (serial; a failure skips the rest)
 *   --prefix P       node ids are P1, P2, ... (default s, r, m; [A-Za-z0-9_.-], at most 32 bytes)
 *   --cwd D          cwd=D on every exec node (sh, map)
 *   --               ends the options (sh, read); for map it separates the values from ARGV
 * read: PATH:A-B is lines A..B (1 based, offset_line=A;limit_line=B-A+1), PATH:A is line A only;
 *   a suffix that is not :digits[-digits] belongs to the path.  B < A or A < 1 is refused.
 * map: ARGV must contain {} at least once; at most 60 ARGV words.
 * stdout: node lines only.  stderr last line: FLOWSH<TAB>kind=K<TAB>nodes=N.  rc 0.
 * rc 2: usage or refused input, `flowsh: REFUSE reason` on stderr, nothing on stdout.
 * At most 1024 nodes (the engine's bound).
 * Check: tools/check-flowsh.cx. */
#pragma unisa use sys.io
#pragma unisa use text.text

static int die(const char *why) { fprintf(stderr, "flowsh: REFUSE %s\n", why); return 2; }

static void enc(const char *s, long n) {
    static const char hx[] = "0123456789ABCDEF"; long i;
    for (i = 0; i < n; i++) {
        unsigned char c = (unsigned char)s[i];
        if (c <= 0x20 || c == ';' || c == '%') { fputc('%', stdout); fputc(hx[c >> 4], stdout); fputc(hx[c & 15], stdout); }
        else fputc(c, stdout);
    }
}

/* T with every {} replaced by V, escaped */
static void encsub(const char *t, const char *v) {
    const char *p = t;
    while (*p) {
        if (p[0] == '{' && p[1] == '}') { enc(v, (long)strlen(v)); p += 2; }
        else { enc(p, 1); p++; }
    }
}

static long num(const char *s, long n) {
    long v = 0, i;
    if (n < 1 || n > 9) return -1;
    for (i = 0; i < n; i++) { if (s[i] < '0' || s[i] > '9') return -1; v = v * 10 + (s[i] - '0'); }
    return v;
}

/* PATH[:A[-B]]: *PN is the path length, *A and *B the span (0 0 when none). 0, or 1 for a bad span. */
static int span(const char *p, long *pn, long *a, long *b) {
    long n = (long)strlen(p), c = n, d, i;
    *pn = n; *a = 0; *b = 0;
    while (c > 0 && p[c - 1] != ':') c--;
    if (c < 2 || c == n) return 0;          /* no ':' after a non-empty path, or nothing behind it */
    for (i = c; i < n; i++) if (!((p[i] >= '0' && p[i] <= '9') || p[i] == '-')) return 0;
    d = c; while (d < n && p[d] != '-') d++;
    *a = num(p + c, d - c);
    *b = d < n ? num(p + d + 1, n - d - 1) : *a;
    if (*a < 1 || *b < *a) return 1;
    *pn = c - 1;
    return 0;
}

static int okid(const char *s, long max) {
    long i, n = (long)strlen(s);
    if (n < 1 || n > max) return 0;
    for (i = 0; i < n; i++) {
        char c = s[i];
        if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '.' || c == '-' || c == ',')) return 0;
    }
    return 1;
}

int main(int argc, char **argv) {
    const char *after = "-", *prefix = 0, *cwd = 0; long tmo = 0; int kind, chain = 0, a, i, n, sep = -1, t0 = 0, tn = 0, j, any = 0;
    if (argc < 2) return die("usage: sh|read|map [--timeout-ms N] [--after ID,..] [--chain] [--prefix P] [--cwd D] ITEM... (map: VALUE... -- ARGV...); run: | devsvc.cx -- flow - --par N");
    if (tx_eqz(argv[1], "sh")) kind = 0; else if (tx_eqz(argv[1], "read")) kind = 1; else if (tx_eqz(argv[1], "map")) kind = 2;
    else return die("unknown kind (want sh, read or map)");
    for (a = 2; a < argc; a++) {
        if (tx_eqz(argv[a], "--chain")) chain = 1;
        else if (tx_eqz(argv[a], "--timeout-ms")) {
            if (a + 1 >= argc) return die("--timeout-ms wants a value");
            a++; tmo = num(argv[a], (long)strlen(argv[a]));
            if (tmo < 1 || tmo > 300000) return die("--timeout-ms outside 1..300000");
        }
        else if (tx_eqz(argv[a], "--after")) { if (a + 1 >= argc || !okid(argv[a + 1], 400)) return die("--after wants ID[,ID] of [A-Za-z0-9_.-]"); after = argv[++a]; }
        else if (tx_eqz(argv[a], "--prefix")) { if (a + 1 >= argc || !okid(argv[a + 1], 32) || strchr(argv[a + 1], ',')) return die("--prefix wants 1..32 bytes of [A-Za-z0-9_.-]"); prefix = argv[++a]; }
        else if (tx_eqz(argv[a], "--cwd")) { if (a + 1 >= argc || !argv[a + 1][0]) return die("--cwd wants a directory"); cwd = argv[++a]; }
        else if (tx_eqz(argv[a], "--")) { if (kind != 2) a++; break; }
        else if (argv[a][0] == '-' && argv[a][1] == '-') return die("unknown option");
        else break;
    }
    if (cwd && kind == 1) return die("--cwd applies to sh and map only");
    n = argc - a;
    if (kind == 2) {
        for (i = a; i < argc; i++) if (tx_eqz(argv[i], "--")) { sep = i; break; }
        if (sep < 0) return die("map wants VALUE... -- ARGV...");
        n = sep - a; t0 = sep + 1; tn = argc - t0;
        if (tn < 1) return die("map wants ARGV after --");
        if (tn > 60) return die("map ARGV has more than 60 words");
        for (j = 0; j < tn; j++) if (strstr(argv[t0 + j], "{}")) any = 1;
        if (!any) return die("map ARGV has no {} (every node would be the same command)");
    }
    if (n < 1) return die("no items");
    if (n > 1024) return die("more than 1024 nodes");
    if (!prefix) prefix = kind == 0 ? "s" : kind == 1 ? "r" : "m";
    if (kind == 1) for (i = 0; i < n; i++) {   /* refuse before anything is printed */
        long pn, sa, sb;
        if (span(argv[a + i], &pn, &sa, &sb)) return die("read span must be :A or :A-B with 1 <= A <= B");
    }
    for (i = 0; i < n; i++) {
        const char *it = argv[a + i];
        printf("%s%d\t%s\t", prefix, i + 1, kind == 1 ? "file.read" : "exec");
        if (chain && i > 0) printf("%s%d\t", prefix, i); else printf("%s\t", after);
        if (kind == 0) { fputs("a0=sh;a1=-c;a2=", stdout); enc(it, (long)strlen(it)); }
        else if (kind == 1) {
            long pn, sa, sb;
            span(it, &pn, &sa, &sb);
            fputs("path=", stdout); enc(it, pn);
            if (sa) printf(";offset_line=%ld;limit_line=%ld", sa, sb - sa + 1);
        } else for (j = 0; j < tn; j++) { printf("%sa%d=", j ? ";" : "", j); encsub(argv[t0 + j], it); }
        if (cwd) { fputs(";cwd=", stdout); enc(cwd, (long)strlen(cwd)); }
        if (tmo) printf(";timeout_ms=%ld", tmo);
        fputc('\n', stdout);
    }
    fflush(stdout);
    fprintf(stderr, "FLOWSH\tkind=%s\tnodes=%d\n", argv[1], n);
    return 0;
}
