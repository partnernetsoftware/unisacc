#pragma unisa module cxproc
/* Optional process module. A program that does not name cxproc does not
   depend on this file. Linux: a null envp is an empty environment, not the
   caller's. Windows: a null envp is inherit. The libc prototype stays inside
   a static function. The export has no file-scope declaration and no #if.
   The result is an ordinary C call. It is not a checked build. */
#ifdef _WIN32
static int cxproc_spawn(char **argv, char **envp, pid_t *pid) {
    return posix_spawnp(pid, argv[0], 0, 0, argv, envp);
}
#else
static int cxproc_spawn(char **argv, char **envp, pid_t *pid) {
    char *empty[1];
    extern int posix_spawnp(pid_t *pid, const char *file, const void *fa, const void *at,
                            char *const argv[], char *const envp[]);
    empty[0] = 0;
    return posix_spawnp(pid, argv[0], 0, 0, argv, envp ? envp : empty);
}
#endif

int cxproc_run(char **argv, char **envp, int *status) {
    pid_t pid = 0;
    int st = 0;
    int spr;
    spr = cxproc_spawn(argv, envp, &pid);
    if (spr != 0) return 127;
    if (waitpid(pid, &st, 0) < 0) return 2;
    if (!status) return 2;
    if (WIFEXITED(st)) *status = WEXITSTATUS(st);
    else if (WIFSIGNALED(st)) *status = 128 + WTERMSIG(st);
    else *status = 2;
    return 0;
}
