/* tools/chain-step.cx -- 构造链的一个相位一条命令。
 *
 * 用法（全部在主树仓根跑；ROOT 一律是冻结快照 S，不是主树）：
 *   sh ./unisacc.com tools/chain-step.cx -- label   REV S PKG OUT          打印将做的事，不执行
 *   sh ./unisacc.com tools/chain-step.cx -- snap    REV OUT                生成/复用 S=out/release-snap-<rev10>
 *   sh ./unisacc.com tools/chain-step.cx -- build   REV S B                现编 controller 到 B
 *   sh ./unisacc.com tools/chain-step.cx -- ctx     REV S B CTX CC          prepare-context
 *   sh ./unisacc.com tools/chain-step.cx -- host    S CTX B                 source-job-wave host
 *   sh ./unisacc.com tools/chain-step.cx -- list    S CTX B                 source-job-wave list（核 131）
 *   sh ./unisacc.com tools/chain-step.cx -- wave    S CTX B PHASE FIRST N   start-job 再 finish-job
 *   sh ./unisacc.com tools/chain-step.cx -- final   S CTX B                 source-job-wave final
 *   sh ./unisacc.com tools/chain-step.cx -- p3      REV S SRC_PKG OUT --nets CTX/jobs --routes R
 *   sh ./unisacc.com tools/chain-step.cx -- slice   REV S PKG OUT --target T [--ctor CAND]
 *   sh ./unisacc.com tools/chain-step.cx -- pack    ABS_ROOT OUT P3 WIN LNX LNXARM OSX OSXARM
 *        (lnx 两片传 <slice>/entry.elf: APE 尾部只放一份包, 片内带 UNIPKG1 会被 ape-pack 拒绝)
 *   sh ./unisacc.com tools/chain-step.cx -- smoke   APE
 *   sh ./unisacc.com tools/chain-step.cx -- check   APE                     check-install-fixes
 *
 * 每步只做一件事，跑完打印该步的身份行（sha/字节/rc/秒数或作业计数），失败即以子命令的
 * 非零码退出，不留半成品。工具本身不重写 release-build / source-package / source-job-wave /
 * release-ape / check-install-fixes，只按固定次序调用它们并把 argv 与验收条件固化下来。
 *
 * 为什么 ROOT 是快照：source-package 的 check_context 会把 ctx/context.tsv 里记的 root
 * 与现测比对；拿主树当 ROOT 必然 context-record-changed。快照由 release-build --rev 生成，
 * 自带 unisacc.com / unisacc.com.build.json / unisacc.com.dev/ 三件套。
 *
 * 为什么 p3 必须带 --nets：p3 沿用 SRC_PKG 的模型字节，不带 --nets 出的包与旧包逐字节相同
 * （sha 9f1ec852），五片拿它编译会被 e3 拒。这里缺 --nets 直接报错。
 *
 * 为什么 slice 的构造器不能用 out/install44/candidate：那份早于 140e8a9af8（DV_MAXU 64→128），
 * 43 源展开 75 单元 + 1 桩 = 76 会命中 drive.cx:758 的 nsrc >= DV_MAXU，报 forwarding stub。
 * 默认取 OUT 同级的 lnx/x86_64 候选；osx/arm64 按 release-build 原设计用 OUT/slice-lnx-x86_64。
 */
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.sig
#pragma unisa use sys.env
#pragma unisa use sys.sha
#pragma unisa use text.text
#pragma unisa use sys.time
#pragma unisa use mem.heap

static const char *g_self;
static int cs_fp_active;
static const char *cs_fp_helper;
static char cs_fp_source[65];
static const char *cs_span_driver, *cs_span_prepared;
static const char *cs_span_dirs[3];
static int cs_span_count, cs_span_index;
static const char *cs_receipt_producer, *cs_kernel_result;
static char *cs_span_value(const char *text, const char *key);
static void cs_span_absolute(const char *p);

static void cs_die(const char *a, const char *b) {
    sy_eprintf("chain-step: %s%s%s\n", a, b ? ": " : "", b ? b : "");
    sy_exit(2);
}

/* argv: 在 cwd 里跑一个程序，返回退出码；子进程 stdout+stderr 都转回本进程。 */
static int cs_run(char **argv, const char *cwd) {
    int ofd = -1, pid, ex = 0, code = 0, sig = 0;
    if (cs_fp_active) {
        char *out = 0; size_t n = 0;
        int rc = cx_runv_timeout(argv, 270, &out, &n);
        if (out && sy_write_all(1, out, n)) cs_die("child output", argv[0]);
        free(out); return rc;
    }
    pid = sy_spawn_pipe(argv, cwd, 0, &ofd, 0);
    if (pid < 0) cs_die("spawn", argv[0]);
    if (ofd >= 0) {
        char chunk[8192];
        long r;
        while ((r = sy_read(ofd, chunk, sizeof chunk)) > 0) {
            if (sy_write_all(1, chunk, r)) break;
        }
        sy_close(ofd);
    }
    if (sy_wait_status(pid, 0, &ex, &code, &sig) < 0) cs_die("wait", argv[0]);
    return ex ? code : 128 + sig;
}

/* 统一的 "sh <root>/unisacc.com <tool> -- <args...>" 调用。 */
static int cs_tool(const char *root, const char *tool, char **args) {
    char com[4400], sh[8] = "sh";
    char *v[64];
    int n = 0, i = 0;
    if (cx_fmt(com, sizeof com, "%s/unisacc.com", root)) cs_die("path", root);
    v[n++] = sh;
    v[n++] = com;
    v[n++] = (char *)tool;
    v[n++] = "--";
    while (args[i] && n + 1 < 64) v[n++] = args[i++];
    v[n] = 0;
    return cs_run(v, root);
}

static long cs_file_size(const char *p) {
    sy_stat_t st;
    if (sy_stat(p, &st)) return -1;
    return st.size;
}

static void cs_expect_file(const char *p, const char *what) {
    long n = cs_file_size(p);
    if (n < 0) cs_die(what, p);
    sy_printf("CHAIN\t%s\tfile=%s\tbytes=%ld\n", what, p, n);
}

static void cs_sha(const char *p, char out[65]) {
    long n = cs_file_size(p), at = 0;
    int fd;
    char *b;
    if (n < 0) cs_die("sha256 read", p);
    b = n > 0 ? malloc((size_t)n) : 0;
    if (n > 0) {
        fd = sy_open(p, O_RDONLY, 0);
        if (fd < 0 || sy_read_full(fd, b, n) || sy_close(fd)) { free(b); cs_die("sha256 read", p); }
    }
    if (sy_sha256_hex(b, n, out)) { free(b); cs_die("sha256", p); }
    free(b);
    (void)at;
}

/* ---------- CHAIN-ROUTES: p3 的两个非源码输入从树内事实与 ctx 作业再生成 ----------
   p3 原来吃 out/install44/pkg9 下的 compiler.pkg 与 declaration/routes.tsv：后者 1823 行、第 5 列是
   绝对路径 models/X.net，两件都只能由 source-package-pack 的 route/declare/pack 相位产出，全新克隆
   不可复现。这里全部重建，绝对路径不进任何产物：models/ 从 ctx 的 net-<id>/tbl-<id> 作业取（目录即
   清单）；routes/ 是 6 份 7 行 manifest，阶段次序取 exec/pipeline/image-stages.tsv；declaration/ 跑 ctx
   现成的 tool-compilerpack 并把第 5 列剥成 basename（读者只取 basename，实测三种写法出的包 sha 全等）；
   kernels/ 用 tools/kernel-route.cx 现编两 ISA，顺带让包内基座与 asm 现编相等成为构造事实；
   compiler.pkg 用 ctx 现成的 tool-pack，mount 与包本身一致。收据写本 rev、两 ISA kernel 的 sha 与
   kernel-route 自己的输入表，换机器可复现。 */
static const char *cs_target[6] = {"lnx-arm64", "lnx-x86_64", "osx-arm64", "osx-x86_64", "win-arm64", "win-x86_64"};
static const char *cs_slash[6] = {"lnx/arm64", "lnx/x86_64", "osx/arm64", "osx/x86_64", "win/arm64", "win/x86_64"};
static const char *cs_stage[7] = {"e2", "e1", "e3", "e4", "prune", "lower", "elf"};
static const char *cs_sin[7] = {"src.c", "pp.text", "tokens.typed", "tape.text", "tape.text", "tape.text", "target.text"};
static const char *cs_sout[7] = {"pp.text", "tokens.typed", "tape.text", "tape.text", "tape.text", "target.text", "image.bytes"};
static int cs_failed;
static void cs_fail(const char *w, const char *a, const char *b) { sy_printf("FAIL\t%s\t%s\t%s\n", w, a ? a : "-", b ? b : "-"); cs_failed++; }
static char *cs_load(const char *p, long *n) {
    long sz = cs_file_size(p), at = 0; int fd; char *b;
    if (sz < 0) return 0;
    b = malloc((size_t)sz + 1); if (!b) cs_die("alloc", p);
    if (sz > 0) { fd = sy_open(p, O_RDONLY, 0); if (fd < 0 || sy_read_full(fd, b, sz) || sy_close(fd)) { free(b); cs_die("read", p); } }
    b[sz] = 0; if (n) *n = sz; (void)at; return b;
}
static void cs_save(const char *p, const char *b, long n) { int fd = sy_open(p, O_WRONLY | O_CREAT | O_TRUNC, 0644); if (fd < 0 || sy_write_all(fd, b, n) || sy_close(fd)) cs_die("write", p); }
static void cs_copy(const char *from, const char *to) { long n = 0; char *b = cs_load(from, &n); if (!b) cs_die("missing input", from); cs_save(to, b, n); free(b); }
/* 有界追加：dst[*at..] 写入 n 字节，越界即失败。用它取代 strcat/strcpy/memcpy，
   两处棘轮（cxapis 的 strcat/strcpy、cxtrunc 的丢弃拷贝）因此都是 0。 */
static void cs_put(char *dst, long cap, long *at, const char *src, long n) {
    long i;
    if (*at < 0 || n < 0 || *at + n + 1 > cap) cs_die("append overflow", "bounded-buffer");
    for (i = 0; i < n; i++) dst[*at + i] = src[i];
    *at += n;
    dst[*at] = 0;
}
static void cs_puts(char *dst, long cap, long *at, const char *s) {
    long n = 0;
    while (s[n]) n++;
    cs_put(dst, cap, at, s, n);
}
/* models/: ctx 的净清单；net-<id> 与 tbl-<id> 成对，缺一半就是作业不完整。 */
static int cs_routes_models(const char *ctx, const char *models) {
    DIR *dp; struct dirent *e; int pairs = 0; char net[4400], tbl[4400], to[4400];
    if (sy_mkdir(models, 0755) && cs_file_size(models) < 0) cs_die("mkdir", models);
    if (!(dp = opendir(ctx))) cs_die("opendir", ctx);
    while ((e = readdir(dp))) {
        const char *id;
        if (strncmp(e->d_name, "net-", 4)) continue;
        id = e->d_name + 4;
        if (cx_fmt(net, sizeof net, "%s/net-%s/result.net", ctx, id)) cs_die("path", ctx);
        if (cx_fmt(tbl, sizeof tbl, "%s/tbl-%s/result.tbl", ctx, id)) cs_die("path", ctx);
        if (cs_file_size(net) < 0) { cs_fail("routes-no-net", id, net); continue; }
        if (cs_file_size(tbl) < 0) { cs_fail("routes-no-table", id, tbl); continue; }
        if (cx_fmt(to, sizeof to, "%s/%s.net", models, id)) cs_die("path", models); cs_copy(net, to);
        if (cx_fmt(to, sizeof to, "%s/%s.tbl", models, id)) cs_die("path", models); cs_copy(tbl, to);
        pairs++;
    }
    closedir(dp);
    if (pairs < 40) cs_fail("routes-few-models", "pairs", "want at least 40");
    sy_printf("PREPARED\tchain-models\t%s\tpairs=%d\n", models, pairs);
    return 0;
}
/* routes/: 6 份 7 行 manifest，第 5 列取 ../models/<id>.net（读者只取 basename）。 */
static int cs_routes_manifests(const char *dir) {
    int t, s; char p[4400];
    if (sy_mkdir(dir, 0755) && cs_file_size(dir) < 0) cs_die("mkdir", dir);
    for (t = 0; t < 6; t++) {
        char text[4096]; long at = 0; text[0] = 0;
        for (s = 0; s < 7; s++) {
            char id[160], seg[560];
            if (s < 5) { if (cx_fmt(id, sizeof id, "shared-%s", cs_stage[s])) cs_die("format", cs_stage[s]); }
            else if (cx_fmt(id, sizeof id, "%s-%s", cs_target[t], cs_stage[s])) cs_die("format", cs_target[t]);
            if (cx_fmt(seg, sizeof seg, "%s\t%s\t%s\t%s\t../models/%s.net\n", cs_slash[t], cs_stage[s], cs_sin[s], cs_sout[s], id)) cs_die("format", id);
            cs_puts(text, (long)sizeof text, &at, seg);
        }
        if (cx_fmt(p, sizeof p, "%s/%s.tsv", dir, cs_target[t])) cs_die("path", dir);
        cs_save(p, text, at);
        sy_printf("PREPARED\tchain-routes-manifest\t%s\trows=7\n", p);
    }
    return 0;
}
/* declaration/: 跑 ctx 现成的 compilerpack，再把第 5 列剥成 basename。 */
static int cs_routes_declare(const char *ctx, const char *models, const char *dir, const char *out) {
    char exe[4400], o1[4400], e2[4400], abi[4400], mdir[4400], rp[4400], manifests[6][4400];
    char *v[26]; int n = 0, t; long n2 = 0, at = 0, rows = 0, i; char *text, *flat;
    if (cx_fmt(exe, sizeof exe, "%s/tool-compilerpack/result.exe", ctx)) cs_die("path", ctx);
    if (cs_file_size(exe) < 0) cs_die("ctx has no tool-compilerpack/result.exe", exe);
    if (cx_fmt(o1, sizeof o1, "%s/shared-o1.net", models)) cs_die("path", models);
    if (cx_fmt(e2, sizeof e2, "%s/shared-e2.net", models)) cs_die("path", models);
    if (cx_fmt(abi, sizeof abi, "%s/shared-nativeabi.net", models)) cs_die("path", models);
    if (cx_fmt(mdir, sizeof mdir, "%s", models)) cs_die("path", models);
    v[n++] = exe; v[n++] = (char *)out;
    v[n++] = (char *)"--o1"; v[n++] = o1; v[n++] = (char *)"--e2"; v[n++] = e2;
    v[n++] = (char *)"--nativeabi"; v[n++] = abi; v[n++] = (char *)"--models"; v[n++] = mdir;
    for (t = 0; t < 6; t++) { if (cx_fmt(manifests[t], sizeof manifests[t], "%s/%s.tsv", dir, cs_target[t])) cs_die("path", dir); v[n++] = manifests[t]; }
    v[n] = 0;
    if (cs_run(v, ".")) cs_die("compilerpack", out);
    if (cx_fmt(rp, sizeof rp, "%s/routes.tsv", out)) cs_die("path", out);
    text = cs_load(rp, &n2); if (!text) cs_die("compilerpack wrote no routes.tsv", rp);
    flat = malloc((size_t)n2 + 1); if (!flat) cs_die("alloc", "routes");
    for (i = 0; i < n2; ) {
        long start = i, end, col = 0, f4 = -1, base, j;
        while (i < n2 && text[i] != '\n') i++;
        end = i;
        for (j = start; j < end; j++) if (text[j] == '\t' && ++col == 4) f4 = j + 1;
        if (f4 >= 0) {
            for (base = f4, j = f4; j < end; j++) if (text[j] == '/') base = j + 1;
            /* 相对路径：pack 以 manifest 所在目录解析第 5 列，declaration 的邻居就是 models/；
               release-build 只取 basename。绝对路径因此完全不进产物。 */
            for (j = start; j < f4; j++) flat[at++] = text[j];
            {
                static const char rel[] = "../models/";
                long q;
                for (q = 0; rel[q]; q++) flat[at++] = rel[q];
            }
            for (j = base; j < end; j++) flat[at++] = text[j];
            rows++;
        } else for (j = start; j < end; j++) flat[at++] = text[j];
        if (i < n2) flat[at++] = '\n';
        i = end + 1;
    }
    cs_save(rp, flat, at); free(flat); free(text);
    /* 1823 行是这个声明的实际规模；行数一变说明 compiler-routes/image-stages 事实改了。 */
    if (rows != 1823) { char w[32]; cx_fmt(w, sizeof w, "%ld", rows); cs_fail("declare-rows", rp, w); }
    sy_printf("PREPARED\tchain-declaration\t%s\trows=%ld\n", rp, rows);
    return 0;
}
/* kernels/: kernel-route 现编两 ISA。 */
static int cs_routes_kernels(const char *s, const char *out) {
    char kdir[4400], iso[4400], launcher[4400], tool[4400], p[4400], h[65], to[4400];
    char *v[8]; int n = 0, a;
    if (cx_fmt(kdir, sizeof kdir, "%s/kernel-route", out)) cs_die("path", out);
    if (cx_fmt(launcher, sizeof launcher, "%s/unisacc.com", s)) cs_die("path", s);
    if (cx_fmt(tool, sizeof tool, "%s/tools/kernel-route.cx", s)) cs_die("path", s);
    v[n++] = (char *)"sh"; v[n++] = launcher; v[n++] = tool; v[n++] = (char *)"--";
    v[n++] = (char *)s; v[n++] = kdir; v[n] = 0;
    if (cs_run(v, ".")) cs_die("kernel-route", kdir);
    if (cx_fmt(p, sizeof p, "%s/kernels", out)) cs_die("path", out);
    if (sy_mkdir(p, 0755) && cs_file_size(p) < 0) cs_die("mkdir", p);
    for (a = 0; a < 2; a++) {
        if (cx_fmt(iso, sizeof iso, "%s/%s.kernel", kdir, a ? "arm64" : "x86_64")) cs_die("path", kdir);
        if (cs_file_size(iso) < 0) cs_die("kernel-route wrote no kernel", iso);
        cs_sha(iso, h);
        if (cx_fmt(to, sizeof to, "%s/%s", p, a ? "arm64" : "x86_64")) cs_die("path", p);
        cs_copy(iso, to);
        sy_printf("PREPARED\tchain-kernel\t%s\tsha=%.16s\tbytes=%ld\n", to, h, cs_file_size(to));
    }
    return 0;
}
/* compiler.pkg: ctx 现成的 pack job；routes.tsv 是位置参数（manifest）不是 mount。 */
static int cs_routes_srcpkg(const char *s, const char *ctx, const char *out) {
    char exe[4400], inc[4400], decl[4400], kdir[4400], outpkg[4400], pre[4400], rts[4400], h[65];
    char *v[16]; int n = 0;
    if (cx_fmt(exe, sizeof exe, "%s/tool-pack/result.exe", ctx)) cs_die("path", ctx);
    if (cs_file_size(exe) < 0) cs_die("ctx has no tool-pack/result.exe", exe);
    if (cx_fmt(decl, sizeof decl, "%s/declaration", out)) cs_die("path", out);
    if (cx_fmt(kdir, sizeof kdir, "%s/kernels", out)) cs_die("path", out);
    if (cx_fmt(outpkg, sizeof outpkg, "%s/compiler.pkg", out)) cs_die("path", out);
    if (cx_fmt(inc, sizeof inc, "%s/include", s)) cs_die("path", s);
    if (cx_fmt(pre, sizeof pre, "%s/predefines", decl)) cs_die("path", decl);
    if (cx_fmt(rts, sizeof rts, "%s/routes.tsv", decl)) cs_die("path", decl);
    v[n++] = exe; v[n++] = (char *)"-o"; v[n++] = outpkg; v[n++] = (char *)"--compressed";
    v[n++] = (char *)"--mount"; v[n++] = (char *)"006864722f"; v[n++] = inc;
    v[n++] = (char *)"--mount"; v[n++] = (char *)"006b65726e656c2f"; v[n++] = kdir;
    v[n++] = (char *)"--mount"; v[n++] = (char *)"00707265646566696e65732f"; v[n++] = pre;
    v[n++] = rts; v[n] = 0;
    if (cs_run(v, ".")) cs_die("pack", outpkg);
    cs_sha(outpkg, h);
    sy_printf("PREPARED\tchain-srcpkg\t%s\tsha=%.16s\tbytes=%ld\n", outpkg, h, cs_file_size(outpkg));
    return 0;
}
/* 收据: 本 rev、两 ISA kernel 身份、kernel-route 的输入表，以及所用 C 编译器与 cc.version。 */
static int cs_routes_receipt(const char *rev, const char *s, const char *ctx, const char *out) {
    char p[4400], text[8192], line[400], h[65];
    long at; int a;
    if (cx_fmt(text, sizeof text, "chain-routes-v1\nrevision\t%s\n", rev)) cs_die("format", rev);
    at = (long)strlen(text);
    /* 工具链：编译器取 ctx 记录的 cc（prepare-context 写的同一路径），版本串取 cc.version。
       调用方给的是 <CTX>/jobs，context.tsv 与 cc.version 在上一级目录。 */
    {
        char root[4400], ccp[4400], ver[4400], vsha[65];
        long n = 0, i, start = 0;
        char *k;
        ccp[0] = 0;
        if (cx_fmt(root, sizeof root, "%s/..", ctx)) cs_die("path", ctx);
        if (cx_fmt(p, sizeof p, "%s/context.tsv", root)) cs_die("path", root);
        k = cs_load(p, &n);
        if (k) {
            for (i = 0; i <= n; i++) {
                if (i == n || k[i] == '\n') {
                    long len = i - start;
                    if (len > 3 && !memcmp(k + start, "cc\t", 3)) {
                        long cat = 0;
                        cs_put(ccp, (long)sizeof ccp, &cat, k + start + 3, len - 3);
                    }
                    start = i + 1;
                }
            }
            free(k);
        }
        if (ccp[0] && cs_file_size(ccp) >= 0) {
            cs_sha(ccp, h);
            if (cx_fmt(line, sizeof line, "toolchain\tcc\t%s\t%s\n", ccp, h)) cs_die("format", "cc");
            cs_puts(text, (long)sizeof text, &at, line);
        } else cs_fail("receipt-no-cc", root, ccp);
        if (cx_fmt(ver, sizeof ver, "%s/cc.version", root)) cs_die("path", root);
        if (cs_file_size(ver) >= 0) {
            cs_sha(ver, vsha);
            if (cx_fmt(line, sizeof line, "toolchain\tcc-version\t%s\t%s\n", ver, vsha)) cs_die("format", "cc-version");
            cs_puts(text, (long)sizeof text, &at, line);
        } else cs_fail("receipt-no-cc-version", root, ver);
    }
    for (a = 0; a < 2; a++) {
        if (cx_fmt(p, sizeof p, "%s/kernels/%s", out, a ? "arm64" : "x86_64")) cs_die("path", out);
        if (cs_file_size(p) < 0) { cs_fail("receipt-no-kernel", p, 0); continue; }
        cs_sha(p, h);
        if (cx_fmt(line, sizeof line, "kernel\t%s\t%s\t%ld\n", a ? "arm64" : "x86_64", h, cs_file_size(p))) cs_die("format", "kernel");
        cs_puts(text, (long)sizeof text, &at, line);
    }
    if (cx_fmt(p, sizeof p, "%s/kernel-route/route.tsv", out)) cs_die("path", out);
    {
        long n = 0, i = 0, start = 0;
        char *k = cs_load(p, &n);
        if (!k) cs_fail("receipt-no-route-receipt", p, 0);
        else {
            while (i <= n) {
                if (i == n || k[i] == '\n') {
                    long len = i - start;
                    if (len > 6 && !memcmp(k + start, "input\t", 6)) {
                        cs_puts(text, (long)sizeof text, &at, "kernel-route-");
                        cs_put(text, (long)sizeof text, &at, k + start, len);
                        cs_put(text, (long)sizeof text, &at, "\n", 1);
                    }
                    start = i + 1;
                }
                i++;
            }
            free(k);
        }
    }
    if (cx_fmt(p, sizeof p, "%s/receipt.tsv", out)) cs_die("path", out);
    cs_save(p, text, at);
    sy_printf("PREPARED\tchain-routes-receipt\t%s\n", p);
    return cs_failed ? 1 : 0;
}
/* 一条命令把 p3 的两个非源码输入全做出来。 */
static int cs_routes(const char *rev, const char *s, const char *ctx, const char *out) {
    char models[4400], rdir[4400], decl[4400];
    if (cx_fmt(models, sizeof models, "%s/models", out)) cs_die("path", out);
    if (cx_fmt(rdir, sizeof rdir, "%s/routes", out)) cs_die("path", out);
    if (cx_fmt(decl, sizeof decl, "%s/declaration", out)) cs_die("path", out);
    if (sy_mkdir(out, 0755) && cs_file_size(out) < 0) cs_die("mkdir", out);
    cs_routes_models(ctx, models);
    cs_routes_manifests(rdir);
    cs_routes_declare(ctx, models, rdir, decl);
    cs_routes_kernels(s, out);
    cs_routes_srcpkg(s, ctx, out);
    cs_routes_receipt(rev, s, ctx, out);
    if (cs_failed) { sy_printf("CHAIN\troutes\tfailed=%d\n", cs_failed); return 1; }
    sy_printf("CHAIN\troutes\tsrcpkg=%s/compiler.pkg\troutes=%s/routes.tsv\tmodels=%s\n", out, decl, models);
    return 0;
}

/* ---------- 各相位 ---------- */

static int cs_snap(const char *rev, const char *out) {
    /* release-build --rev 的快照就是 git archive 加仓根三件套与 .release-rev 标记
       （tools/release-build.cx:639 rb_freeze 的同一配方）；这里按同一配方做，省掉一次
       p3 构建。已存在同 rev 标记的快照直接复用，不重打。 */
    char spec[128], full[80], brief[11], dir[4400], mark[4400], cmd[9000];
    char *sh[4];
    long n = 0;
    int i;
    if (cx_fmt(spec, sizeof spec, "%s^{commit}", rev)) cs_die("rev", rev);
    if (cx_fmt(cmd, sizeof cmd, "git rev-parse --verify %s", spec)) cs_die("rev", rev);
    {
        char got[128];
        int ofd = -1, pid, ex = 0, code = 0, sig = 0;
        char *v[5];
        long timeout_deadline_ms = sy_now_ms() + 10000; /* bound: git rev-parse is fast; refuse hangs */
        v[0] = "/bin/sh"; v[1] = "-c"; v[2] = cmd; v[3] = 0;
        pid = sy_spawn_pipe(v, ".", SY_SPAWN_NO_PATH, &ofd, 0);
        if (pid < 0) cs_die("spawn", "git");
        n = 0;
        if (ofd >= 0) {
            long r = sy_read(ofd, got, sizeof got - 1);
            if (r > 0) n = r;
            sy_close(ofd);
        }
        if (sy_wait_status(pid, 0, &ex, &code, &sig) < 0 || sy_now_ms() > timeout_deadline_ms || (ex ? code : 128 + sig)) {
            sy_kill(pid);
            sy_eprintf("chain-step: rev-parse ex=%d code=%d sig=%d got=%.80s\n", ex, code, sig, got);
            cs_die("rev", rev);
        }
        got[n] = 0;
        while (n > 0 && (got[n - 1] == '\n' || got[n - 1] == '\r')) got[--n] = 0;
        if (n != 40) cs_die("rev not 40 hex", rev);
        for (i = 0; i < 40; i++) full[i] = got[i];
        full[40] = 0;
    }
    for (i = 0; i < 10; i++) brief[i] = full[i];
    brief[10] = 0;
    if (cx_fmt(dir, sizeof dir, "%s/release-snap-%s", out, brief)) cs_die("path", out);
    if (cx_fmt(mark, sizeof mark, "%s/.release-rev", dir)) cs_die("path", dir);
    if (sy_exists(mark)) {
        sy_printf("CHAIN\tsnap\treused=%s\trev=%.10s\n", dir, full);
        return 0;
    }
    if (sy_exists(dir)) cs_die("snapshot exists without a matching rev marker", dir);
    {
        char *v[9];
        v[0] = "sh"; v[1] = "./unisacc.com"; v[2] = "tools/release-build.cx"; v[3] = "--";
        v[4] = "--rev"; v[5] = full; v[6] = "freeze"; v[7] = "."; v[8] = 0;
        if (cs_run(v, ".")) cs_die("release-build freeze", dir);
    }
    sy_printf("CHAIN\tsnap\tfile=%s\trev=%.10s\n", dir, full);
    return 0;
}

/* gen2 = gen1 当构造器出的一片；gen3 = gen2 当构造器出的同目标片；cmp 两份必须全等。
   这是"两代不动点"的可执行口径：外部构造器只算 bootstrapping，不算一代。 */
/* 一个文件对：只回 true/false，why 里带文件名与首差异偏移（0-based）。
   打行由调用者按 item 汇总，这样一个 MISMATCH 行就能看出是哪一片、差在哪。 */
static int cs_fp_eq(const char *a, const char *b, const char *name, char *why, long cap) {
    long na = cs_file_size(a), nb = cs_file_size(b), k;
    int fd;
    char *x, *y;
    if (na < 0) { cx_fmt(why, cap, "%s: missing in gen2", name); return 0; }
    if (nb < 0) { cx_fmt(why, cap, "%s: missing in gen3", name); return 0; }
    if (na != nb) { cx_fmt(why, cap, "%s: size %ld vs %ld", name, na, nb); return 0; }
    if (na == 0) return 1;
    x = malloc((size_t)na); y = malloc((size_t)nb);
    if (!x || !y) cs_die("alloc", "compare");
    fd = sy_open(a, O_RDONLY, 0);
    if (fd < 0 || sy_read_full(fd, x, na) || sy_close(fd)) cs_die("read", a);
    fd = sy_open(b, O_RDONLY, 0);
    if (fd < 0 || sy_read_full(fd, y, nb) || sy_close(fd)) cs_die("read", b);
    for (k = 0; k < na; k++)
        if (x[k] != y[k]) { cx_fmt(why, cap, "%s: first diff offset %ld", name, k); free(x); free(y); return 0; }
    free(x); free(y);
    return 1;
}
/* 把一条 "文件名: 首差异偏移" 追加到汇总串（多片都坏时只留前两条，避免一行过长）。
   逐字符拷贝而不是 memcpy(dst, src, 输入相关长度)：后者会被 cxtrunc 记一次丢弃调用，
   而这里的长度本来就由参数决定，用带容量的循环更直白（也避免越界）。
   分隔用字符串 "; " 而不是字符常量：.cx 里没有单引号字符字面量。 */
static void cs_fp_note(char *why, long cap, const char *one) {
    long l = (long)strlen(why), m = (long)strlen(one), i;
    if (l > 0) {
        if (l + 2 >= cap) return;
        why[l] = 59; why[l + 1] = 32;
        l += 2;
        why[l] = 0;
    }
    if (l + m + 1 >= cap) return;
    for (i = 0; i <= m; i++) why[l + i] = one[i];
}
/* 一组固定名字的文件：每个都逐字节相等才算该项 same；只打一行，
   MISMATCH 时 why 里是"文件名: 首差异偏移"（多片都坏时取前两片）。 */
static int cs_fp_set(const char *d2, const char *d3, const char *item,
                     const char *const *names, int cnt) {
    int i, ok = 0, bad = 0;
    char p[4400], q[4400], why[512], one[256];
    why[0] = 0;
    for (i = 0; i < cnt; i++) {
        if (cx_fmt(p, sizeof p, "%s/%s", d2, names[i]) || cx_fmt(q, sizeof q, "%s/%s", d3, names[i]))
            cs_die("path", item);
        if (cs_fp_eq(p, q, names[i], one, sizeof one)) { ok++; continue; }
        bad++;
        if (bad <= 2) cs_fp_note(why, sizeof why, one);
    }
    if (ok == cnt) sy_printf("CHAIN\tfixedpoint\t%s=same\tcount=%d\n", item, cnt);
    else sy_printf("CHAIN\tfixedpoint\t%s=MISMATCH\tok=%d/%d\t%s\n", item, ok, cnt, why);
    return ok == cnt ? 0 : 1;
}
/* objects：g2 里每个 .o 都要在 g3 有同名同字节的副本，且两个目录的 .o 数量相同。 */
static int cs_fp_objects(const char *d2, const char *d3) {
    DIR *dp; struct dirent *e; int n2 = 0, n3 = 0, ok = 0, bad = 0;
    char p[4400], q[4400], why[512], one[256];
    why[0] = 0;
    if (!(dp = opendir(d2))) cs_die("opendir", d2);
    while ((e = readdir(dp))) {
        size_t l = strlen(e->d_name);
        if (l < 3 || strcmp(e->d_name + l - 2, ".o")) continue;
        n2++;
        if (cx_fmt(p, sizeof p, "%s/%s", d2, e->d_name) || cx_fmt(q, sizeof q, "%s/%s", d3, e->d_name))
            cs_die("path", "objects");
        if (cs_fp_eq(p, q, e->d_name, one, sizeof one)) { ok++; continue; }
        bad++;
        if (bad <= 2) cs_fp_note(why, sizeof why, one);
    }
    closedir(dp);
    if (!(dp = opendir(d3))) cs_die("opendir", d3);
    while ((e = readdir(dp))) {
        size_t l = strlen(e->d_name);
        if (l < 3 || strcmp(e->d_name + l - 2, ".o")) continue;
        n3++;
    }
    closedir(dp);
    if (n2 != n3) { sy_printf("CHAIN\tfixedpoint\tobjects=MISMATCH\tcount %d vs %d\n", n2, n3); return 1; }
    if (n2 == 0) { sy_printf("CHAIN\tfixedpoint\tobjects=MISSING\n"); return 1; }
    if (ok != n2) { sy_printf("CHAIN\tfixedpoint\tobjects=MISMATCH\tok=%d/%d\t%s\n", ok, n2, why); return 1; }
    sy_printf("CHAIN\tfixedpoint\tobjects=same\tcount=%d\n", n2);
    return 0;
}
/* 六片位于各代目标目录；objects 路由名 candidate，whole-o 名 slice-<target>。 */
static const char *cs_fp_slices[6] = {"lnx-x86_64/candidate", "lnx-arm64/candidate",
                                      "osx-x86_64/slice-osx-x86_64", "osx-arm64/slice-osx-arm64",
                                      "win-x86_64/slice-win-x86_64", "win-arm64/slice-win-arm64"};
/* 五项：objects / kernels / slices / product / package。每项恰好一行，任一不一致返回 1。
   objects 比 lnx/x86_64 子目录里的 .o（product 就由它们链接而成）。 */
static int cs_fp_five(const char *g2, const char *g3, const char *pkg) {
    static const char *kernels[2] = {"kernel-route/x86_64.kernel", "kernel-route/arm64.kernel"};
    char a[4400], b[4400], why[512];
    int bad = 0;
    if (cx_fmt(a, sizeof a, "%s/lnx-x86_64", g2) || cx_fmt(b, sizeof b, "%s/lnx-x86_64", g3)) cs_die("path", "objects");
    if (cs_fp_objects(a, b)) bad = 1;
    if (cs_fp_set(g2, g3, "kernels", kernels, 2)) bad = 1;
    if (cs_fp_set(g2, g3, "slices", cs_fp_slices, 6)) bad = 1;
    if (cx_fmt(a, sizeof a, "%s/%s", g2, cs_fp_slices[0]) || cx_fmt(b, sizeof b, "%s/%s", g3, cs_fp_slices[0]))
        cs_die("path", "product");
    if (cs_fp_eq(a, b, "candidate", why, sizeof why)) sy_printf("CHAIN\tfixedpoint\tproduct=same\n");
    else { sy_printf("CHAIN\tfixedpoint\tproduct=MISMATCH\t%s\n", why); bad = 1; }
    if (cs_file_size(pkg) < 0) { sy_printf("CHAIN\tfixedpoint\tpackage=MISSING\n"); bad = 1; }
    else { char h[65]; cs_sha(pkg, h); sy_printf("CHAIN\tfixedpoint\tpackage=present\tsha=%s\n", h); }
    return bad;
}
static int cs_fp_compare(const char *d2, const char *d3, const char *pkg) {
    return cs_fp_five(d2, d3, pkg) ? 1 : 0;
}
/* 两个 objects 目标绑定上一代 product；四个 whole-o 目标绑定本代 product。 */
static const char *cs_fp_targets[6] = {"lnx/x86_64", "lnx/arm64", "osx/x86_64", "osx/arm64", "win/x86_64", "win/arm64"};
/* Canonical recursive content identity. Unknown file types and symlinks refuse;
   only source-root .git/out are excluded, never artifact descendants. */
static int cs_namecmp(const void *a, const void *b) { return strcmp(*(char *const *)a, *(char *const *)b); }
static void cs_tree(const char *dir, int source, char out[65]) {
    DIR *dp = opendir(dir); struct dirent *e; char **names = 0; long count = 0, cap = 0, at = 0, i;
    char *text;
    if (!dp) cs_die("identity directory", dir);
    while ((e = readdir(dp))) {
        long n = strlen(e->d_name), k;
        if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
        if (source && (!strcmp(e->d_name, ".git") || !strcmp(e->d_name, "out"))) continue;
        for (k = 0; k < n; k++) if ((unsigned char)e->d_name[k] < 32) cs_die("identity name", dir);
        if (count == cap) { cap = cap ? cap * 2 : 32; names = realloc(names, cap * sizeof *names); if (!names) cs_die("alloc", dir); }
        names[count] = malloc(n + 1); if (!names[count]) cs_die("alloc", dir);
        long pos = 0; cs_put(names[count++], n + 1, &pos, e->d_name, n);
    }
    closedir(dp); qsort(names, count, sizeof *names, cs_namecmp);
    cap = 1;
    for (i = 0; i < count; i++) cap += strlen(names[i]) + 70;
    text = malloc(cap); if (!text) cs_die("alloc", dir); text[0] = 0;
    for (i = 0; i < count; i++) {
        char p[4400], h[65]; struct stat st;
        if (cx_fmt(p, sizeof p, "%s/%s", dir, names[i]) || lstat(p, &st)) cs_die("identity stat", dir);
        if (S_ISDIR(st.st_mode)) { cs_tree(p, 0, h); cs_puts(text, cap, &at, "D\t"); }
        else if (S_ISREG(st.st_mode)) { cs_sha(p, h); cs_puts(text, cap, &at, "F\t"); }
        else cs_die("identity unknown file type", p);
        cs_puts(text, cap, &at, names[i]); cs_puts(text, cap, &at, "\t");
        cs_puts(text, cap, &at, h); cs_puts(text, cap, &at, "\n"); free(names[i]);
    }
    if (sy_sha256_hex(text, at, out)) cs_die("identity hash", dir);
    free(text); free(names);
}
/* The existing F-v2 helper owns physical source bytes and alias topology. */
static void cs_source(const char *s, char out[65]) {
    char *text = 0, before[65], after[65]; size_t n = 0; int k;
    if (!cs_fp_helper) cs_die("REFUSE --identity-helper required", s);
    cs_sha(cs_fp_helper, before);
    char *v[] = {(char *)cs_fp_helper, (char *)s, 0};
    int rc = cx_runv_timeout(v, 8, &text, &n);
    cs_sha(cs_fp_helper, after);
    if (rc || strcmp(before, after) || !text || n != 65 || text[64] != '\n') cs_die("REFUSE F-v2 source identity", s);
    for (k = 0; k < 64; k++) { if (!((text[k] >= '0' && text[k] <= '9') || (text[k] >= 'a' && text[k] <= 'f'))) cs_die("REFUSE source SID wire", s); out[k] = text[k]; }
    out[64] = 0; free(text);
}
static void cs_fp_record(const char *s, const char *rev, const char *pkg, const char *ctor,
                         const char *artifact, const char *receipt, int reuse, long wall) {
    char source[65], ph[65], ch[65], ah[65], hh[65], self[65], tool[4400], th[65], text[16384]; long n;
    /* Old records retain their real native producer identity. Never substitute
     * its SHA into a new record; only that verified executable may revalidate. */
    if(reuse){
        long rn=0;char *r=cs_load(receipt,&rn);if(!r)cs_die("REFUSE missing receipt",receipt);
        char *producer=cs_span_value(r,"chain_sha"),current[65];cs_sha("/proc/self/exe",current);
        if(strcmp(producer,current)){
            if(!cs_receipt_producer)cs_die("REFUSE explicit receipt producer required",receipt);
            cs_span_absolute(cs_receipt_producer);char before[65],after[65],hdr[4];int fd=sy_open(cs_receipt_producer,O_RDONLY,0);
            if(fd<0||sy_read_full(fd,hdr,4)||sy_close(fd)||memcmp(hdr,"\177ELF",4)||access(cs_receipt_producer,X_OK))cs_die("REFUSE native receipt producer",cs_receipt_producer);
            cs_sha(cs_receipt_producer,before);if(strcmp(before,producer))cs_die("REFUSE receipt producer SHA mismatch",receipt);
            char *v[]={(char *)cs_receipt_producer,"fp-identity",(char *)s,(char *)rev,(char *)pkg,(char *)ctor,(char *)artifact,(char *)receipt,(char *)cs_fp_helper,0};
            char *output=0;size_t bytes=0;int rc=cx_runv_timeout(v,45,&output,&bytes);
            if(output&&sy_write_all(1,output,bytes))cs_die("producer output",receipt);free(output);cs_sha(cs_receipt_producer,after);
            if(rc||strcmp(before,after))cs_die("REFUSE producer revalidation",receipt);
            free(producer);free(r);return;
        }
        free(producer);free(r);
    }
    if (cx_fmt(source, sizeof source, "%s", cs_fp_source)) cs_die("source identity", s);
    cs_sha(pkg, ph); cs_sha(ctor, ch); cs_tree(artifact, 0, ah);
    if (cx_fmt(tool, sizeof tool, "%s/tools/release-build.cx", s)) cs_die("path", s); cs_sha(tool, th);
    cs_sha(cs_fp_helper, hh); cs_sha("/proc/self/exe", self);
    if (cx_fmt(text, sizeof text, "chain-fixedpoint-v3\nroot\t%s\nrev\t%s\nsource_sha\t%s\np3_sha\t%s\nconstructor\t%s\nconstructor_sha\t%s\nrelease_sha\t%s\nartifact\t%s\nartifact_sha\t%s\nhelper_sha\t%s\nchain_sha\t%s\n", s, rev, source, ph, ctor, ch, th, artifact, ah, hh, self)) cs_die("identity overflow", artifact);
    n = strlen(text);
    if (reuse) {
        long size = 0; char *old = cs_load(receipt, &size);
        if (!old || size < n + 10 || memcmp(old, text, n) || strncmp(old + n, "wall_ms\t", 8)) cs_die("REFUSE resume identity", receipt);
        long k = n + 8; wall = 0;
        while (k < size - 1 && old[k] >= '0' && old[k] <= '9') { if (wall > 300000) cs_die("REFUSE wall evidence", receipt); wall = wall * 10 + old[k++] - '0'; }
        if (k != size - 1 || old[k] != '\n' || wall > 300000) cs_die("REFUSE wall evidence", receipt);
        free(old);
    } else {
        char tail[80]; long at = n;
        if (cx_fmt(tail, sizeof tail, "wall_ms\t%ld\n", wall)) cs_die("wall", receipt);
        cs_puts(text, sizeof text, &at, tail); cs_save(receipt, text, at);
    }
    sy_printf("PREPARED\tfixedpoint\tartifact=%s\tsha=%s\tconstructor_sha=%s\tsource_sha=%s\twall_ms=%ld\treused=%d\n", artifact, ah, ch, source, wall, reuse);
}
/* 两 ISA 使用当代已验证 phase-0/link 的 native candidate；源码与工具仍取冻结 S。
 * 显式传 P4 与实际构造器 SHA，route 收据不匹配即拒绝，不接受 ROOT launcher 身份。 */
static int cs_fp_kernels(const char *s, const char *dir, const char *ctor, const char *pkg) {
    char kdir[4400], tool[4400], iso[4400], dst[4400], declared[65], receipt[4400], needle[100], actual_ctor[4400], selector[8900];
    char *v[14]; int n = 0, a;
    if (!ctor || ctor[0] != '/') cs_die("REFUSE explicit kernel constructor required", ctor);
    if (sy_realpath(ctor, actual_ctor, sizeof actual_ctor) < 0) cs_die("REFUSE kernel constructor resolution", ctor);
    {int fd;char hdr[4];fd=sy_open(ctor,O_RDONLY,0);if(fd<0||sy_read_full(fd,hdr,4)||sy_close(fd)||memcmp(hdr,"\177ELF",4))cs_die("REFUSE kernel phase requires native ELF constructor",ctor);}
    if (cx_fmt(kdir, sizeof kdir, "%s/kernel-route", dir)) cs_die("path", dir);
    if (cx_fmt(tool, sizeof tool, "%s/tools/kernel-route.cx", s)) cs_die("path", s);
    cs_sha(ctor, declared);
    if (sy_setenv("UNISA_CONTAINER", pkg, 1)) cs_die("kernel package", pkg);
    v[n++] = (char *)ctor; v[n++] = tool; v[n++] = (char *)"--";
    v[n++] = (char *)s; v[n++] = kdir; v[n++] = "--constructor"; v[n++] = (char *)ctor;
    v[n++] = "--constructor-sha"; v[n++] = declared; v[n++] = "--package"; v[n++] = (char *)pkg; v[n] = 0;
    if (cs_run(v, ".")) cs_die("kernel-route", kdir);
    if (cx_fmt(receipt, sizeof receipt, "%s/route.tsv", kdir) || cx_fmt(needle, sizeof needle, "\nconstructor_sha\t%s\n", declared)) cs_die("receipt path", kdir);
    /* Equal bytes do not imply equal generation roles: require the explicit selector too. */
    if (cx_fmt(selector, sizeof selector, "\nconstructor\t%s\nconstructor_path\t%s\n", actual_ctor, actual_ctor)) cs_die("receipt constructor path", ctor);
    {long rn=0;char *r=cs_load(receipt,&rn);if(!r||!strstr(r,needle)||!strstr(r,selector))cs_die("REFUSE kernel constructor receipt mismatch",receipt);free(r);}
    for (a = 0; a < 2; a++) {
        if (cx_fmt(iso, sizeof iso, "%s/%s.kernel", kdir, a ? "arm64" : "x86_64")) cs_die("path", kdir);
        if (cs_file_size(iso) < 0) cs_die("kernel-route wrote no kernel", iso);
        if (cx_fmt(dst, sizeof dst, "%s/%s.kernel", dir, a ? "arm64" : "x86_64")) cs_die("path", dir);
        cs_copy(iso, dst);
    }
    return 0;
}
static int cs_fp_step(const char *sub, const char *step, long wall, int save) {
    char path[4400], needle[256], line[320]; long n = 0; char *old;
    if (cx_fmt(path, sizeof path, "%s/.chain-steps", sub) || cx_fmt(needle, sizeof needle, "\n%s\t", step)) cs_die("step path", sub);
    old = cs_load(path, &n);
    if (!save) { int found = old && strstr(old, needle); free(old); return found; }
    if (cx_fmt(line, sizeof line, "\n%s\t%ld\n", step, wall)) cs_die("step wall", sub);
    long len = strlen(line), at = 0; char *text = malloc(n + len + 1);
    if (!text) cs_die("alloc", sub); text[0] = 0;
    if (old) cs_put(text, n + len + 1, &at, old, n);
    cs_puts(text, n + len + 1, &at, line); cs_save(path, text, at); free(old); free(text); return 0;
}
/* X bridge: one fresh native --resume per invocation, ordered durable evidence.
 * Repeat --span in construction order; --span-index is 1-based. Failed attempts
 * are retained and never overwritten. No constructor history is synthesized. */
/* fixedpoint REV S P4 GEN1 OUT --phase g2|g3 --target T
 * --identity-helper /ABS/F-v2 --span-driver /ABS/whole-front-native
 * --span-prepared /ABS/PREPARED --span /ABS/UNITS_E3
 * --span /ABS/PRUNE_ELF --span-index 1; repeat full list with index 2 (Mac).
 * Mac forward-stub path/SHA must agree in both top-level ready prefixes;
 * the real stub is passed through to native --resume, never synthesized here.
 * Win: UNITS_UNITS, E3_E3, PRUNE_ELF, indexes 1,2,3 (no forward stub).
 * Every invocation performs a real --resume; cursors bind material and order.
 * Failed attempts require a new OUT and remain untouched. */
static char *cs_span_value(const char *text, const char *key) {
    char needle[128]; const char *p,*e; long at=0; char *v;
    if(cx_fmt(needle,sizeof needle,"\n%s\t",key))cs_die("span key",key);
    p=strstr(text,needle);if(!p||strstr(p+1,needle))cs_die("REFUSE missing/duplicate span field",key);
    p+=strlen(needle);e=strchr(p,'\n');if(!e)cs_die("span wire",key);
    v=malloc(e-p+1);if(!v)cs_die("alloc",key);cs_put(v,e-p+1,&at,p,e-p);return v;
}
static void cs_span_match(const char *text,const char *key,const char *want){char *v=cs_span_value(text,key);if(strcmp(v,want))cs_die("REFUSE span generation binding",key);free(v);}
/* --kernel-result ABS accepts completed real AS material. Rehash all 34
 * inputs, 22 sources, 22 objects, 2 kernels; record adoption, not construction. */
/* fixedpoint ... --phase kernels-g2|kernels-g3 --kernel-result /ABS/ROUTE
 * --identity-helper /ABS/F-v2 [--receipt-producer /ABS/OLD_CHAIN_NATIVE].
 * --receipt-producer also applies to normal g2/g3 and compare dependency
 * validation only when a receipt names that executable's actual SHA. New
 * records always name /proc/self/exe, never the supplied old producer. */
static void cs_kernel_copy_tree(const char *from,const char *to){
    if(sy_mkdir(to,0755))cs_die("exclusive kernel destination",to);
    DIR *dp=opendir(from);struct dirent *e;if(!dp)cs_die("kernel directory",from);
    while((e=readdir(dp))){if(!strcmp(e->d_name,".")||!strcmp(e->d_name,".."))continue;
        char a[4400],b[4400];struct stat st;if(cx_fmt(a,sizeof a,"%s/%s",from,e->d_name)||cx_fmt(b,sizeof b,"%s/%s",to,e->d_name)||lstat(a,&st))cs_die("kernel copy path",from);
        if(S_ISDIR(st.st_mode))cs_kernel_copy_tree(a,b);else if(S_ISREG(st.st_mode))cs_copy(a,b);else cs_die("REFUSE nonregular kernel material",a);
    }closedir(dp);
}
static void cs_fp_accept_kernels(const char *s,const char *pkg,const char *ctor,const char *dir,const char *sub){
    const char *units[]={"transition","arith","buffer","memory","intern","bytes","format","stack","action","run","bridge"};const char *arch[]={"x86_64","arm64"};
    const char *base[]={"unisacc.com","constructor-package","tools/kernel-route.cx","tools/asm-source.cx","tools/kernel-link.cx","tools/cxlib/elfkernel.cx","tools/cxlib/netpack.cx","tools/bound","tools/bound.c","asm/layout.h","asm/actions.h","asm/../core.h"};
    char expected[34][160],sources[22][160],objects[22][160],p[4400],actual[4400],h[65],before[65],after[65];int seen[80];int i,a,u;long n=0;
    memset(seen,0,sizeof seen);cs_span_absolute(cs_kernel_result);cs_tree(cs_kernel_result,0,before);
    for(i=0;i<12;i++)if(cx_fmt(expected[i],sizeof expected[i],"%s",base[i]))cs_die("kernel key",base[i]);
    for(a=0;a<2;a++)for(u=0;u<11;u++){i=a*11+u;if(cx_fmt(expected[12+i],sizeof expected[12+i],"asm/%s_%s.S",units[u],arch[a])||cx_fmt(sources[i],sizeof sources[i],"%s/%s.s",arch[a],units[u])||cx_fmt(objects[i],sizeof objects[i],"%s/%s.o",arch[a],units[u]))cs_die("kernel key",sub);}
    if(cx_fmt(p,sizeof p,"%s/route.tsv",cs_kernel_result))cs_die("kernel route",sub);
    char *receipt=cs_load(p,&n);if(!receipt||n<1||receipt[n-1]!='\n'||memchr(receipt,0,n)||strncmp(receipt,"unisacc-kernel-route-v1\n",24))cs_die("REFUSE kernel receipt",p);
    cs_span_match(receipt,"status","PREPARED");cs_span_match(receipt,"canonical","YES");cs_span_match(receipt,"spec","AS-1,AS-8,AS-9");cs_span_match(receipt,"units","transition,arith,buffer,memory,intern,bytes,format,stack,action,run,bridge");
    if(sy_realpath(ctor,actual,sizeof actual)<0)cs_die("kernel constructor",ctor);cs_span_match(receipt,"constructor",actual);cs_span_match(receipt,"constructor_path",actual);cs_sha(ctor,h);cs_span_match(receipt,"constructor_sha",h);
    if(sy_realpath(pkg,actual,sizeof actual)<0)cs_die("kernel package",pkg);cs_span_match(receipt,"package",actual);cs_span_match(receipt,"timing","preprocess,assemble,link=UNMEASURED(no portable clock in the prelude)");
    char *row=strchr(receipt,'\n')+1;
    while(*row){char *end=strchr(row,'\n');if(!end)cs_die("kernel row",sub);*end=0;char *key=strchr(row,'\t');if(!key)cs_die("kernel columns",sub);*key++=0;int offset=-1,count=0;
        if(!strcmp(row,"input")){offset=0;count=34;}else if(!strcmp(row,"source")){offset=34;count=22;}else if(!strcmp(row,"object")){offset=56;count=22;}else if(!strcmp(row,"kernel")){offset=78;count=2;}
        if(offset>=0){char *sha=strchr(key,'\t');if(!sha)cs_die("kernel digest column",sub);*sha++=0;int found=-1;
            for(i=0;i<count;i++){const char *want=offset==0?expected[i]:offset==34?sources[i]:offset==56?objects[i]:i?"arm64.kernel":"x86_64.kernel";if(!strcmp(key,want))found=i;}
            if(found<0||seen[offset+found]++)cs_die("REFUSE unknown/duplicate kernel material",key);
            if(offset==0){if(!found){if(cx_fmt(actual,sizeof actual,"%s",ctor))cs_die("path",ctor);}else if(found==1){if(cx_fmt(actual,sizeof actual,"%s",pkg))cs_die("path",pkg);}else if(!strncmp(key,"asm/",4)){if(cx_fmt(actual,sizeof actual,"%s/exec/c/%s",s,key))cs_die("path",key);}else if(cx_fmt(actual,sizeof actual,"%s/%s",s,key))cs_die("path",key);}
            else if(cx_fmt(actual,sizeof actual,"%s/%s",cs_kernel_result,key))cs_die("path",key);
            cs_sha(actual,h);if(strcmp(h,sha))cs_die("REFUSE kernel material SHA mismatch",actual);
        }else if(strcmp(row,"status")&&strcmp(row,"canonical")&&strcmp(row,"spec")&&strcmp(row,"units")&&strcmp(row,"constructor")&&strcmp(row,"constructor_path")&&strcmp(row,"constructor_sha")&&strcmp(row,"package")&&strcmp(row,"timing"))cs_die("REFUSE unknown kernel metadata",row);
        row=end+1;
    }
    for(i=0;i<80;i++)if(seen[i]!=1)cs_die("REFUSE incomplete 34/22/22/2 kernel material set",sub);
    free(receipt);cs_tree(cs_kernel_result,0,after);if(strcmp(before,after))cs_die("REFUSE kernel result changed",sub);
    cs_kernel_copy_tree(cs_kernel_result,sub);cs_tree(sub,0,after);if(strcmp(before,after))cs_die("REFUSE kernel copy identity",sub);
    for(a=0;a<2;a++){if(cx_fmt(p,sizeof p,"%s/%s.kernel",sub,arch[a])||cx_fmt(actual,sizeof actual,"%s/%s.kernel",dir,arch[a]))cs_die("kernel output",sub);if(sy_exists(actual))cs_die("REFUSE existing canonical kernel",actual);cs_copy(p,actual);}
}
static void cs_span_absolute(const char *p){char r[4400];if(!p||p[0]!='/'||sy_realpath(p,r,sizeof r)<0||strcmp(p,r)||strpbrk(p,"\t\r\n"))cs_die("REFUSE canonical absolute path",p);}
static int cs_fp_accept_span(const char *s,const char *pkg,const char *ctor,const char *dir,const char *sub,int target){
    char p[4400],r[4400],cursor[4400],binding[32768],h[65],line[128];long n=0,at=0,start=sy_now_ms();int i;
    char *ready[3],*input[3],*first[3],*last[3];
    char *stub=0,*roots_text,*roots[44];int nr=0;
    if(cs_span_count!=(target<4?2:3)||cs_span_index<1||cs_span_index>cs_span_count)cs_die("REFUSE Mac 2/Win 3 spans, 1-based index required",sub);
    cs_span_absolute(cs_span_driver);cs_span_absolute(cs_span_prepared);
    {char hdr[4];int fd=sy_open(cs_span_driver,O_RDONLY,0);if(fd<0||sy_read_full(fd,hdr,4)||sy_close(fd)||memcmp(hdr,"\177ELF",4)||access(cs_span_driver,X_OK))cs_die("REFUSE native span driver",cs_span_driver);}
    if(cx_fmt(p,sizeof p,"%s/receipt.txt",cs_span_prepared))cs_die("path",sub);
    char *prep=cs_load(p,&n);if(!prep||strncmp(prep,"whole-front-prepare-v1\n",23))cs_die("REFUSE prepared receipt",p);
    const char *files[]={s,pkg,ctor};const char *keys[]={"root","pkg","ctor"};
    for(i=0;i<3;i++){if(sy_realpath(files[i],r,sizeof r)<0)cs_die("realpath",files[i]);cs_span_match(prep,keys[i],r);}
    cs_sha(pkg,h);cs_span_match(prep,"pkg_sha",h);cs_sha(ctor,h);cs_span_match(prep,"ctor_sha",h);cs_span_match(prep,"source_sid",cs_fp_source);
    if(cx_fmt(p,sizeof p,"%s/lnx-x86_64",dir)||sy_realpath(p,r,sizeof r)<0)cs_die("objects",dir);cs_span_match(prep,"objects",r);free(prep);
    binding[0]=0;cs_puts(binding,sizeof binding,&at,"chain-span-adoption-v1\n");cs_puts(binding,sizeof binding,&at,cs_fp_source);
    const char *bound[]={cs_span_driver,cs_span_prepared,pkg,ctor,r,sub};
    for(i=0;i<6;i++){cs_puts(binding,sizeof binding,&at,"\n");cs_puts(binding,sizeof binding,&at,bound[i]);}
    char driver_before[65];cs_sha(cs_span_driver,driver_before);cs_puts(binding,sizeof binding,&at,driver_before);
    if(cx_fmt(p,sizeof p,"%s/receipt.txt",cs_span_prepared))cs_die("path",sub);cs_sha(p,h);cs_puts(binding,sizeof binding,&at,h);
    for(i=0;i<cs_span_count;i++){
        cs_span_absolute(cs_span_dirs[i]);if(cx_fmt(p,sizeof p,"%s.control/ready.tsv",cs_span_dirs[i]))cs_die("path",sub);
        ready[i]=cs_load(p,&n);if(!ready[i]||strncmp(ready[i],"whole-front-span-v1\n",20))cs_die("REFUSE span receipt",p);
        cs_sha(p,h);cs_puts(binding,sizeof binding,&at,cs_span_dirs[i]);cs_puts(binding,sizeof binding,&at,h);
        char *top_end=strstr(ready[i],"\nctx_before_bytes\t");if(!top_end)cs_die("REFUSE missing span context boundary",p);*top_end=0;
        cs_span_match(ready[i],"prepared",cs_span_prepared);cs_span_match(ready[i],"target",cs_fp_targets[target]);cs_span_match(ready[i],"output",cs_span_dirs[i]);
        input[i]=cs_span_value(ready[i],"input");first[i]=cs_span_value(ready[i],"first");last[i]=cs_span_value(ready[i],"last");
        if(i&&strcmp(input[i],cs_span_dirs[i-1]))cs_die("REFUSE disconnected spans",sub);
        if(target<4){
            char *actual=cs_span_value(ready[i],"forward_stub");cs_span_absolute(actual);cs_sha(actual,h);cs_span_match(ready[i],"forward_stub_sha",h);
            if(i&&strcmp(stub,actual))cs_die("REFUSE Mac span stub changed",sub);
            if(!i)stub=actual;else free(actual);
            cs_puts(binding,sizeof binding,&at,stub);cs_puts(binding,sizeof binding,&at,h);
        }else if(strstr(ready[i],"\nforward_stub\t"))cs_die("REFUSE Win forward stub",sub);
        cs_tree(cs_span_dirs[i],0,h);cs_puts(binding,sizeof binding,&at,h);
        if(!i){cs_sha(input[i],h);cs_puts(binding,sizeof binding,&at,h);}
    }
    if(target<4){if(strcmp(first[0],"units")||strcmp(last[0],"e3")||strcmp(first[1],"prune")||strcmp(last[1],"elf"))cs_die("REFUSE Mac span boundaries",sub);}
    else if(strcmp(first[0],"units")||strcmp(last[0],"units")||strcmp(first[1],"e3")||strcmp(last[1],"e3")||strcmp(first[2],"prune")||strcmp(last[2],"elf"))cs_die("REFUSE Win span boundaries",sub);
    if(cx_fmt(p,sizeof p,"%s/roots.txt",cs_span_prepared))cs_die("roots path",sub);
    cs_sha(p,h);cs_puts(binding,sizeof binding,&at,h);roots_text=cs_load(p,&n);
    if(!roots_text||n<1||roots_text[n-1]!='\n'||memchr(roots_text,0,n)||memchr(roots_text,'\r',n))cs_die("REFUSE roots wire",p);
    /* A frames bind logical aliases (src/runtime -> cx/runtime) byte-for-byte.
     * Resolve only for containment/type validation; pass the original argv. */
    char source_root[4400];if(sy_realpath(s,source_root,sizeof source_root)<0)cs_die("REFUSE frozen source root",s);long source_len=strlen(source_root);
    char *next=roots_text;while(*next){
        char *end=strchr(next,'\n');if(!end||end==next||nr==44)cs_die("REFUSE 44 source roots required",p);*end=0;
        if(next[0]!='/')cs_die("REFUSE absolute logical source root required",next);
        long j;for(j=0;next[j];j++)if((unsigned char)next[j]<32||(unsigned char)next[j]==127)cs_die("REFUSE source root text",next);
        char resolved[4400];struct stat st;
        if(sy_realpath(next,resolved,sizeof resolved)<0||strncmp(resolved,source_root,source_len)||resolved[source_len]!='/'||stat(next,&st)||!S_ISREG(st.st_mode))cs_die("REFUSE source root outside frozen S/nonregular",next);
        roots[nr++]=next;next=end+1;
    }
    if(nr!=44)cs_die("REFUSE exactly 44 source roots required",p);
    cs_puts(binding,sizeof binding,&at,"\n");
    if(cx_fmt(cursor,sizeof cursor,"%s/.span-%d-%d",dir,target,cs_span_index))cs_die("cursor",sub);
    if(sy_exists(cursor)||sy_exists(sub))cs_die("REFUSE existing adoption attempt/destination",cursor);
    if(cs_span_index>1){if(cx_fmt(p,sizeof p,"%s/.span-%d-%d.ok",dir,target,cs_span_index-1))cs_die("cursor",sub);char *old=cs_load(p,&n);if(!old||n<at||memcmp(old,binding,at))cs_die("REFUSE changed adoption sequence",p);free(old);}
    { int fd=sy_open(cursor,O_WRONLY|O_CREAT|O_EXCL,0644);if(fd<0||sy_write_all(fd,binding,at)||sy_close(fd))cs_die("exclusive adoption attempt",cursor); }
    int k=cs_span_index-1,ac=0;char *v[64];v[ac++]=(char *)cs_span_driver;v[ac++]="span";v[ac++]=(char *)cs_span_prepared;v[ac++]=(char *)cs_fp_targets[target];v[ac++]=input[k];v[ac++]=(char *)cs_span_dirs[k];v[ac++]=first[k];v[ac++]=last[k];
    for(i=0;i<nr;i++)v[ac++]=roots[i];
    if(stub){v[ac++]="--forward-stub";v[ac++]=stub;}
    v[ac++]="--resume";v[ac]=0;
    char *output=0;size_t bytes=0;int rc=cx_runv_timeout(v,45,&output,&bytes);if(output&&sy_write_all(1,output,bytes))cs_die("span output",sub);free(output);
    if(rc||sy_now_ms()-start>60000)cs_die("REFUSE revalidation failed/deadline",cursor);
    if(cx_fmt(line,sizeof line,"revalidation_ms\t%ld\n",sy_now_ms()-start))cs_die("wall",sub);cs_puts(binding,sizeof binding,&at,line);
    char driver_after[65];cs_sha(cs_span_driver,driver_after);if(strcmp(driver_before,driver_after))cs_die("REFUSE driver changed",cursor);
    if(cx_fmt(p,sizeof p,"%s.ok",cursor))cs_die("cursor",sub);cs_save(p,binding,at);
    if(cs_span_index!=cs_span_count)return 0;
    if(sy_mkdir(sub,0755))cs_die("exclusive adoption destination",sub);
    char from[4400],to[4400],leaf[128];if(cx_fmt(leaf,sizeof leaf,"slice-%s",cs_fp_targets[target]))cs_die("slice",sub);for(i=0;leaf[i];i++)if(leaf[i]=='/')leaf[i]='-';
    if(cx_fmt(from,sizeof from,"%s/image",cs_span_dirs[k])||cx_fmt(to,sizeof to,"%s/%s",sub,leaf))cs_die("image",sub);cs_copy(from,to);
    for(i=0;i<cs_span_count;i++){if(cx_fmt(from,sizeof from,"%s/.span-%d-%d.ok",dir,target,i+1)||cx_fmt(to,sizeof to,"%s/adopt-%d.tsv",sub,i+1))cs_die("evidence",sub);cs_copy(from,to);if(cx_fmt(from,sizeof from,"%s.control/ready.tsv",cs_span_dirs[i])||cx_fmt(to,sizeof to,"%s/span-%d.tsv",sub,i+1))cs_die("evidence",sub);cs_copy(from,to);}
    return 1;
}
/* Resume receipts are material provenance, never a cached comparison/PASS. */
static int cs_fixedpoint(const char *rev, const char *s, const char *pkg, const char *gen1, const char *out,
                         const char *target, const char *phase, int resume, const char *object, int link) {
    char dir[4400], sub[4400], ctor[4400], rec[4400], g2[4400], g3[4400];
    int g, i, selected = -1, compare = tx_eqz(phase, "compare");
    cs_fp_active = 1;
    if (cx_fmt(g2, sizeof g2, "%s/g2", out) || cx_fmt(g3, sizeof g3, "%s/g3", out)) cs_die("path", out);
    for (i = 0; i < 6; i++) if (target && tx_eqz(target, cs_fp_targets[i])) selected = i;
    if (!compare && selected < 0 && !tx_eqz(phase, "kernels-g2") && !tx_eqz(phase, "kernels-g3")) cs_die("REFUSE unknown target", target);
    if (!compare && !tx_eqz(phase, "g2") && !tx_eqz(phase, "g3") && !tx_eqz(phase, "kernels-g2") && !tx_eqz(phase, "kernels-g3")) cs_die("REFUSE unknown phase", phase);
    if (target && selected < 0) cs_die("REFUSE unknown target", target);
    if (compare && (object || link)) cs_die("REFUSE compare object options", phase);
    if (!compare && selected < 2 && selected >= 0 && !object && !link) cs_die("REFUSE objects needs --object KEY or --link-only", target);
    if ((object || link) && (selected < 0 || selected >= 2 || (object && link))) cs_die("REFUSE object options", target);
    if (object) { long k; for (k = 0; object[k]; k++) if (!(object[k] == '.' || object[k] == '_' || (object[k] >= 'a' && object[k] <= 'z') || (object[k] >= '0' && object[k] <= '9'))) cs_die("REFUSE object key", object); }
    if (strlen(rev) != 40) cs_die("REFUSE full revision required", rev);
    for (i = 0; i < 40; i++) if (!((rev[i] >= '0' && rev[i] <= '9') || (rev[i] >= 'a' && rev[i] <= 'f'))) cs_die("REFUSE revision", rev);
    {
        char cwd[4400], expected[4400], actual[4400], marker[4400]; long n = 0; char *m;
        if (sy_realpath(".", cwd, sizeof cwd) < 0 || sy_realpath(s, actual, sizeof actual) < 0 || cx_fmt(expected, sizeof expected, "%s/out/release-snap-%.10s", cwd, rev) || strcmp(expected, actual)) cs_die("REFUSE release snapshot path", s);
        if (cx_fmt(marker, sizeof marker, "%s/.release-rev", s)) cs_die("path", s);
        m = cs_load(marker, &n); if (!m || n != 40 || memcmp(m, rev, 40)) cs_die("REFUSE snapshot revision", s); free(m);
    }
    if (sy_mkdir(out, 0755) && cs_file_size(out) < 0) cs_die("mkdir", out);
    cs_source(s, cs_fp_source);
    for (g = 2; g <= 3; g++) {
        if (!compare && ((g == 2) != (tx_eqz(phase, "g2") || tx_eqz(phase, "kernels-g2")))) continue;
        if (cx_fmt(dir, sizeof dir, "%s/g%d", out, g)) cs_die("path", out);
        if (sy_mkdir(dir, 0755) && cs_file_size(dir) < 0) cs_die("mkdir", dir);
        for (i = 0; i < 7; i++) {
            int kernel = i == 6; long start;
            if (!compare && (kernel ? !tx_eqz(phase, g == 2 ? "kernels-g2" : "kernels-g3") : (i != selected || !tx_eqz(phase, g == 2 ? "g2" : "g3")))) continue;
            if (cx_fmt(sub, sizeof sub, "%s/%s", dir, kernel ? "kernel-route" : i == 0 ? "lnx-x86_64" : i == 1 ? "lnx-arm64" : i == 2 ? "osx-x86_64" : i == 3 ? "osx-arm64" : i == 4 ? "win-x86_64" : "win-arm64")) cs_die("path", dir);
            if (cx_fmt(rec, sizeof rec, "%s/phase-%d.tsv", dir, i)) cs_die("path", dir);
            if (kernel || i >= 2) { if (cx_fmt(ctor, sizeof ctor, "%s/lnx-x86_64/candidate", dir)) cs_die("path", dir); }
            else if (g == 2) { if (cx_fmt(ctor, sizeof ctor, "%s", gen1)) cs_die("path", gen1); }
            else if (cx_fmt(ctor, sizeof ctor, "%s/lnx-x86_64/candidate", g2)) cs_die("path", g2);
            /* Validate the constructor's provenance, not merely its current bytes. */
            if (kernel || g == 3 || i >= 2) {
                char dep[4400], dr[4400], dc[4400];
                const char *base = (kernel || i >= 2) ? dir : g2;
                if (cx_fmt(dep, sizeof dep, "%s/lnx-x86_64", base) || cx_fmt(dr, sizeof dr, "%s/phase-0.tsv", base)) cs_die("path", base);
                if ((kernel || i >= 2) && g == 3) { if (cx_fmt(dc, sizeof dc, "%s/lnx-x86_64/candidate", g2)) cs_die("path", g2); }
                else if (cx_fmt(dc, sizeof dc, "%s", gen1)) cs_die("path", gen1);
                cs_fp_record(s, rev, pkg, dc, dep, dr, 1, 0);
                if (!cs_fp_step(dep, "link", 0, 0)) cs_die("REFUSE incomplete constructor", dep);
            }
            const char *step = kernel ? "kernels" : i < 2 ? (object ? object : "link") : "whole-o";
            if (compare || (resume && sy_exists(rec))) {
                cs_fp_record(s, rev, pkg, ctor, sub, rec, 1, 0);
                if (compare) { if (!cs_fp_step(sub, kernel ? "kernels" : i < 2 ? "link" : "whole-o", 0, 0)) cs_die("REFUSE incomplete phase", sub); continue; }
                if (cs_fp_step(sub, step, 0, 0)) continue;
                if (cs_fp_step(sub, "link", 0, 0)) cs_die("REFUSE modifying linked slice", sub);
            } else if (sy_exists(sub) || sy_exists(rec)) cs_die("REFUSE unrecorded/existing phase", sub);
            start = sy_now_ms();
            char before_source[65], before_pkg[65], before_ctor[65];
            if (cx_fmt(before_source, sizeof before_source, "%s", cs_fp_source)) cs_die("identity", s);
            cs_sha(pkg, before_pkg); cs_sha(ctor, before_ctor);
            if (cs_span_driver) { if (!cs_fp_accept_span(s, pkg, ctor, dir, sub, i)) return 0; }
            else if (kernel) { if(cs_kernel_result)cs_fp_accept_kernels(s,pkg,ctor,dir,sub);else if (cs_fp_kernels(s, dir, ctor, pkg)) return 2; }
            else {
                char *a[8] = {(char *)pkg, sub, "--target", (char *)cs_fp_targets[i], 0}; int an = 4;
                if (object) { a[an++] = "--only"; a[an++] = (char *)object; }
                if (link) a[an++] = "--link-only";
                a[an] = 0;
                if (sy_setenv("UNISACC_CTOR", ctor, 1)) cs_die("env", ctor);
                if (cs_slice(rev, s, an, a)) return 2;
            }
            char after_pkg[65], after_ctor[65];
            cs_source(s, cs_fp_source); cs_sha(pkg, after_pkg); cs_sha(ctor, after_ctor);
            if (strcmp(before_source, cs_fp_source) || strcmp(before_pkg, after_pkg) || strcmp(before_ctor, after_ctor)) cs_die("REFUSE phase inputs changed", sub);
            cs_fp_step(sub, step, sy_now_ms() - start, 1);
            cs_fp_record(s, rev, pkg, ctor, sub, rec, 0, sy_now_ms() - start);
        }
    }
    if (!compare) return 0;
    return cs_fp_five(g2, g3, pkg);
}

static int cs_build(const char *rev, const char *s, const char *b) {
    (void)rev;
    char boot[4400], cc_src[4400], cc_out[4400], bound[4400];
    char *v[10];
    int n = 0;
    if (cx_fmt(bound, sizeof bound, "%s/tools/bound", s)) cs_die("path", s);
    if (cx_fmt(boot, sizeof boot, "%s/Root41-bootstrap.com", b)) cs_die("path", b);
    if (cs_file_size(boot) < 0) cs_die("bootstrap missing", boot);
    if (cx_fmt(cc_src, sizeof cc_src, "%s/tools/source-package.cx", s)) cs_die("path", s);
    if (cx_fmt(cc_out, sizeof cc_out, "%s/source-package-O2.elf", b)) cs_die("path", b);
    v[n++] = bound;
    v[n++] = (char *)"55";
    v[n++] = (char *)"sh";
    v[n++] = boot;
    v[n++] = (char *)"-O2";
    v[n++] = cc_src;
    v[n++] = (char *)"-o";
    v[n++] = cc_out;
    v[n] = 0;
    if (cs_run(v, b)) cs_die("controller build", cc_out);
    cs_expect_file(cc_out, "controller");
    return 0;
}

static int cs_ctx(const char *rev, const char *s, const char *b, const char *ctx, const char *cc) {
    (void)rev;
    char boot[4400];
    char *a[10];
    int n = 0;
    if (cx_fmt(boot, sizeof boot, "%s/Root41-bootstrap.com", b)) cs_die("path", b);
    a[n++] = (char *)"prepare-context"; a[n++] = (char *)s; a[n++] = boot;
    a[n++] = (char *)cc; a[n++] = (char *)ctx; a[n] = 0;
    if (cs_tool(s, "tools/source-package.cx", a)) cs_die("prepare-context", ctx);
    return 0;
}

static int cs_wave(const char *s, const char *ctx, const char *b, const char *phase,
                   const char *first, const char *count) {
    char *a[12];
    int n = 0;
    a[n++] = (char *)s; a[n++] = (char *)ctx; a[n++] = (char *)b;
    a[n++] = (char *)"wave"; a[n++] = (char *)phase; a[n++] = (char *)first;
    a[n++] = (char *)count; a[n++] = (char *)"start-job"; a[n] = 0;
    if (cs_tool(s, "tools/source-job-wave.cx", a)) cs_die("wave start-job", phase);
    n = 0;
    a[n++] = (char *)s; a[n++] = (char *)ctx; a[n++] = (char *)b;
    a[n++] = (char *)"wave"; a[n++] = (char *)phase; a[n++] = (char *)first;
    a[n++] = (char *)count; a[n++] = (char *)"finish-job"; a[n] = 0;
    if (cs_tool(s, "tools/source-job-wave.cx", a)) cs_die("wave finish-job", phase);
    return 0;
}

static int cs_simple_wave(const char *s, const char *ctx, const char *b, const char *what) {
    char *a[8];
    int n = 0;
    a[n++] = (char *)s; a[n++] = (char *)ctx; a[n++] = (char *)b; a[n++] = (char *)what; a[n] = 0;
    return cs_tool(s, "tools/source-job-wave.cx", a);
}

/* release-build.cx 的两个动作都要先经过它自己的 --rev 前缀；argv[0] 是启动器
   （sh <S>/unisacc.com <S>/tools/release-build.cx），不是 "--rev"。ROOT 用主树 "."：
   rb_freeze 会把 ROOT 换成 out/release-snap-<rev10> 再取源，传已冻结的 S 会让它去找
   snap 里的 snap。启动器与工具仍取 S 里的那份，避免用主树被改过的脚本。 */
static int cs_release(const char *rev, const char *s, int argc, char **argv, const char *what) {
    char com[4400], tool[4400];
    char *a[32];
    int n = 0, i;
    if (cx_fmt(com, sizeof com, "%s/unisacc.com", s)) cs_die("path", s);
    if (cx_fmt(tool, sizeof tool, "%s/tools/release-build.cx", s)) cs_die("path", s);
    a[n++] = (char *)"sh";
    a[n++] = com;
    a[n++] = tool;
    a[n++] = (char *)"--";
    a[n++] = (char *)"--rev"; a[n++] = (char *)rev;
    for (i = 0; i < argc && n + 1 < 32; i++) a[n++] = argv[i];
    a[n] = 0;
    if (cs_run(a, ".")) cs_die(what, "see release-build output above");
    return 0;
}

static int cs_p3(const char *rev, const char *s, int argc, char **argv) {
    char *a[24];
    int n = 0, i;
    int have_nets = 0, have_routes = 0;
    (void)s;
    for (i = 0; i < argc; i++) {
        if (tx_eqz(argv[i], "--nets")) have_nets = 1;
        if (tx_eqz(argv[i], "--routes")) have_routes = 1;
    }
    if (!have_nets || !have_routes)
        cs_die("p3 needs --nets CTX/jobs and --routes ROUTES", "a package without them is byte-identical to the stale 9f1ec852");
    /* ROOT 交给 release-build 自己冻结：它把 ROOT 换成 snap 后从 snap 取工具与源。
       传 S（已经是 snap）会让它去找 snap 里的 snap。 */
    a[n++] = (char *)"p3"; a[n++] = (char *)".";
    for (i = 0; i < argc && n + 1 < 24; i++) a[n++] = argv[i];
    a[n] = 0;
    return cs_release(rev, s, n, a, "p3");
}

static int cs_slice(const char *rev, const char *s, int argc, char **argv) {
    char *a[24];
    int n = 0, i;
    (void)s;
    a[n++] = (char *)"slice"; a[n++] = (char *)".";
    for (i = 0; i < argc && n + 1 < 24; i++) a[n++] = argv[i];
    a[n] = 0;
    return cs_release(rev, s, n, a, "slice");
}

static int cs_pack(int argc, char **argv) {
    char *a[16]; char root[4096];
    int n = 0, i;
    if (argc < 1 || argc > (int)(sizeof(a) / sizeof(*a)) - 3) cs_die("REFUSE pack argument capacity", 0);
    if (argv[0][0] != '/' || sy_realpath(argv[0], root, sizeof root) < 0)
        cs_die("pack needs ABSOLUTE ROOT first (0.0.50 D-5: no implicit cwd)", argv[0]);
    a[n++] = (char *)"pack";
    for (i = 1; i < argc; i++) a[n++] = argv[i];
    a[n] = 0;
    return cs_tool(root, "tools/release-ape.cx", a);
}

static int cs_ape_smoke(const char *ape) {
    char *a[4];
    a[0] = (char *)"smoke"; a[1] = (char *)ape; a[2] = 0;
    return cs_tool(".", "tools/release-ape.cx", a);
}

static int cs_check(const char *ape) {
    char *a[4];
    a[0] = (char *)"--"; a[1] = (char *)ape; a[2] = 0;
    return cs_tool(".", "tools/check-install-fixes.cx", a);
}

int main(int argc, char **argv) {
    g_self = "chain-step";
    if (argc < 3) {
        sy_eprintf("usage: chain-step snap|build|ctx|host|list|wave|final|p3|slice|pack|smoke|check ...\n");
        return 2;
    }
    if (tx_eqz(argv[1], "build")) {
        if (argc < 5) cs_die("build needs REV S B", 0);
        return cs_build(argv[2], argv[3], argv[4]);
    }
    if (tx_eqz(argv[1], "ctx")) {
        if (argc < 7) cs_die("ctx needs REV S B CTX CC", 0);
        return cs_ctx(argv[2], argv[3], argv[4], argv[5], argv[6]);
    }
    if (tx_eqz(argv[1], "host")) {
        if (argc < 5) cs_die("host needs S CTX B", 0);
        return cs_simple_wave(argv[2], argv[3], argv[4], "host");
    }
    if (tx_eqz(argv[1], "list")) {
        if (argc < 5) cs_die("list needs S CTX B", 0);
        return cs_simple_wave(argv[2], argv[3], argv[4], "list");
    }
    if (tx_eqz(argv[1], "final")) {
        if (argc < 5) cs_die("final needs S CTX B", 0);
        return cs_simple_wave(argv[2], argv[3], argv[4], "final");
    }
    if (tx_eqz(argv[1], "wave")) {
        if (argc < 8) cs_die("wave needs S CTX B PHASE FIRST COUNT", 0);
        return cs_wave(argv[2], argv[3], argv[4], argv[5], argv[6], argv[7]);
    }
    if (tx_eqz(argv[1], "p3")) {
        if (argc < 6) cs_die("p3 needs REV S SRC_PKG OUT --nets CTX/jobs --routes R", 0);
        return cs_p3(argv[2], argv[3], argc - 4, argv + 4);
    }
    if (tx_eqz(argv[1], "slice")) {
        if (argc < 6) cs_die("slice needs REV S PKG OUT --target T", 0);
        return cs_slice(argv[2], argv[3], argc - 4, argv + 4);
    }
    if (tx_eqz(argv[1], "pack")) {
        if (argc < 10) cs_die("pack needs ABS_ROOT OUT P3 WIN LNX LNXARM OSX OSXARM", 0);
        return cs_pack(argc - 2, argv + 2);
    }
    if (tx_eqz(argv[1], "smoke")) {
        if (argc < 3) cs_die("smoke needs APE", 0);
        return cs_ape_smoke(argv[2]);
    }
    if (tx_eqz(argv[1], "check")) {
        if (argc < 3) cs_die("check needs APE", 0);
        return cs_check(argv[2]);
    }
    if (tx_eqz(argv[1], "snap")) {
        if (argc < 3) cs_die("snap needs REV [OUT]", 0);
        return cs_snap(argv[2], argc > 3 ? argv[3] : "out");
    }
    if (tx_eqz(argv[1], "routes")) {
        /* routes REV S CTX OUT：p3 的两个非源码输入（compiler.pkg 与 declaration/routes.tsv）
           从树内事实与 ctx 作业再生成，全新克隆也能出包。 */
        if (argc < 6) cs_die("routes needs REV S CTX OUT", 0);
        return cs_routes(argv[2], argv[3], argv[4], argv[5]);
    }
    if (tx_eqz(argv[1], "fp-identity")) {
        if (argc != 9) cs_die("fp-identity needs S REV PKG CTOR ARTIFACT RECEIPT IDENTITY_HELPER", 0);
        cs_fp_helper = argv[8]; cs_source(argv[2], cs_fp_source);
        cs_fp_record(argv[2], argv[3], argv[4], argv[5], argv[6], argv[7], 1, 0);
        return 0;
    }
    /* 回放用：fp-compare DIR2 DIR3 PKG —— 不跑链，只对已有两代产物做五项比较。 */
    if (tx_eqz(argv[1], "fp-compare")) {
        if (argc < 5) cs_die("fp-compare needs DIR2 DIR3 PKG", 0);
        return cs_fp_compare(argv[2], argv[3], argv[4]) ? 1 : 0;
    }
    if (tx_eqz(argv[1], "fixedpoint")) {
        /* fixedpoint REV S PKG GEN1 OUT --phase g2|g3|kernels-g2|kernels-g3|compare
           --target T selects exactly one of six slices; no implicit long chain. */
        if (argc < 9) cs_die("fixedpoint needs REV S PKG GEN1 OUT --phase PHASE", 0);
        {
            const char *target = 0, *phase = 0, *object = 0; int i, sample = 0, nonrel = 0, resume = 0, link = 0;
            for (i = 7; i < argc; i++) {
                if (tx_eqz(argv[i], "--target") && i + 1 < argc && !target) { target = argv[++i]; continue; }
                if (tx_eqz(argv[i], "--phase") && i + 1 < argc && !phase) { phase = argv[++i]; continue; }
                if (tx_eqz(argv[i], "--resume") && !resume) { resume = 1; continue; }
                if (tx_eqz(argv[i], "--identity-helper") && i + 1 < argc && !cs_fp_helper) { cs_fp_helper = argv[++i]; continue; }
                if (tx_eqz(argv[i], "--object") && i + 1 < argc && !object) { object = argv[++i]; continue; }
                if (tx_eqz(argv[i], "--link-only") && !link) { link = 1; continue; }
                if (tx_eqz(argv[i], "--receipt-producer") && i + 1 < argc && !cs_receipt_producer) { cs_receipt_producer=argv[++i]; continue; }
                if (tx_eqz(argv[i], "--kernel-result") && i + 1 < argc && !cs_kernel_result) { cs_kernel_result=argv[++i]; continue; }
                if (tx_eqz(argv[i], "--span-driver") && i + 1 < argc && !cs_span_driver) { cs_span_driver = argv[++i]; continue; }
                if (tx_eqz(argv[i], "--span-prepared") && i + 1 < argc && !cs_span_prepared) { cs_span_prepared = argv[++i]; continue; }
                if (tx_eqz(argv[i], "--span") && i + 1 < argc && cs_span_count < 3) { cs_span_dirs[cs_span_count++] = argv[++i]; continue; }
                if (tx_eqz(argv[i], "--span-index") && i + 1 < argc && !cs_span_index) { const char *v=argv[++i]; if(strlen(v)!=1||v[0]<'1'||v[0]>'3')cs_die("REFUSE span index",v);cs_span_index=v[0]-'0';continue; }
                if (tx_eqz(argv[i], "--sample")) { sample = 1; continue; }
                if (tx_eqz(argv[i], "--non-release")) { nonrel = 1; continue; }
                cs_die("REFUSE unknown/duplicate option", argv[i]);
            }
            if (sample && !nonrel) cs_die("REFUSE sample on release-candidate fixedpoint (default FULL)", 0);
            if (sample || nonrel) cs_die("REFUSE sampled fixedpoint", 0);
            if (!phase) cs_die("REFUSE fixedpoint needs --phase", 0);
            if(cs_kernel_result&&(cs_span_driver||object||link||resume||target||(strcmp(phase,"kernels-g2")&&strcmp(phase,"kernels-g3"))))cs_die("REFUSE incompatible kernel result options",phase);
            if (cs_span_driver || cs_span_prepared || cs_span_count || cs_span_index) {
                if (!cs_span_driver || !cs_span_prepared || !cs_span_count || !cs_span_index || object || link || resume || !target || (strcmp(phase,"g2") && strcmp(phase,"g3")) || (strncmp(target,"osx/",4) && strncmp(target,"win/",4))) cs_die("REFUSE incomplete/incompatible span options", phase);
            }
            return cs_fixedpoint(argv[2], argv[3], argv[4], argv[5], argv[6], target, phase, resume, object, link);
        }
    }
    sy_eprintf("chain-step: unknown step %s\n", argv[1]);
    return 2;
}
