/* tools/chain-step.cx -- 构造链的一个相位一条命令。
 *
 * 用法（全部在主树仓根跑；ROOT 一律是冻结快照 S，不是主树）：
 *   sh ./unisacc.com tools/chain-step.cx -- label   REV S PKG OUT          打印将做的事，不执行
 *   sh ./unisacc.com tools/chain-step.cx -- snap    REV OUT                生成/复用 S=out/release-snap-<rev10>
 *   sh ./unisacc.com tools/chain-step.cx -- build   REV S B                现编 controller 到 B
 *   sh ./unisacc.com tools/chain-step.cx -- ctx     REV S B CTX CC          prepare-context
 *   sh ./unisacc.com tools/chain-step.cx -- host    S CTX B                 source-job-wave host
 *   sh ./unisacc.com tools/chain-step.cx -- list    S CTX B                 source-job-wave list（核 131）
 *   sh ./unisacc.com tools/chain-step.cx -- wave    S CTX B PHASE FIRST N   start-job 再 finish-job
 *   sh ./unisacc.com tools/chain-step.cx -- final   S CTX B                 source-job-wave final
 *   sh ./unisacc.com tools/chain-step.cx -- p3      REV S SRC_PKG OUT --nets CTX/jobs --routes R
 *   sh ./unisacc.com tools/chain-step.cx -- slice   REV S PKG OUT --target T [--ctor CAND]
 *   sh ./unisacc.com tools/chain-step.cx -- pack    OUT P3 WIN LNX LNXARM OSX OSXARM
 *   sh ./unisacc.com tools/chain-step.cx -- smoke   APE
 *   sh ./unisacc.com tools/chain-step.cx -- check   APE                     check-install-fixes
 *
 * 每步只做一件事，跑完打印该步的身份行（sha/字节/rc/秒数或作业计数），失败即以子命令的
 * 非零码退出，不留半成品。工具本身不重写 release-build / source-package / source-job-wave /
 * release-ape / check-install-fixes，只按固定次序调用它们并把 argv 与验收条件固化下来。
 *
 * 为什么 ROOT 是快照：source-package 的 check_context 会把 ctx/context.tsv 里记的 root
 * 与现测比对；拿主树当 ROOT 必然 context-record-changed。快照由 release-build --rev 生成，
 * 自带 unisacc.com / unisacc.com.build.json / unisacc.com.dev/ 三件套。
 *
 * 为什么 p3 必须带 --nets：p3 沿用 SRC_PKG 的模型字节，不带 --nets 出的包与旧包逐字节相同
 * （sha 9f1ec852），五片拿它编译会被 e3 拒。这里缺 --nets 直接报错。
 *
 * 为什么 slice 的构造器不能用 out/install44/candidate：那份早于 140e8a9af8（DV_MAXU 64→128），
 * 43 源展开 75 单元 + 1 桩 = 76 会命中 drive.cx:758 的 nsrc >= DV_MAXU，报 forwarding stub。
 * 默认取 OUT 同级的 lnx/x86_64 候选；osx/arm64 按 release-build 原设计用 OUT/slice-lnx-x86_64。
 */
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.sig
#pragma unisa use sys.env
#pragma unisa use sys.sha
#pragma unisa use text.text
#pragma unisa use mem.heap

static const char *g_self;

static void cs_die(const char *a, const char *b) {
    sy_eprintf("chain-step: %s%s%s\n", a, b ? ": " : "", b ? b : "");
    sy_exit(2);
}

/* argv: 在 cwd 里跑一个程序，返回退出码；子进程 stdout+stderr 都转回本进程。 */
static int cs_run(char **argv, const char *cwd) {
    int ofd = -1, pid, ex = 0, code = 0, sig = 0;
    pid = sy_spawn_pipe(argv, cwd, 0, &ofd, 0);
    if (pid < 0) cs_die("spawn", argv[0]);
    if (ofd >= 0) {
        char chunk[8192];
        long r;
        while ((r = sy_read(ofd, chunk, sizeof chunk)) > 0) {
            if (sy_write_all(1, chunk, r)) break;
        }
        sy_close(ofd);
    }
    if (sy_wait_status(pid, 0, &ex, &code, &sig) < 0) cs_die("wait", argv[0]);
    return ex ? code : 128 + sig;
}

/* 统一的 "sh <root>/unisacc.com <tool> -- <args...>" 调用。 */
static int cs_tool(const char *root, const char *tool, char **args) {
    char com[4400], sh[8] = "sh";
    char *v[64];
    int n = 0, i = 0;
    if (cx_fmt(com, sizeof com, "%s/unisacc.com", root)) cs_die("path", root);
    v[n++] = sh;
    v[n++] = com;
    v[n++] = (char *)tool;
    v[n++] = "--";
    while (args[i] && n + 1 < 64) v[n++] = args[i++];
    v[n] = 0;
    return cs_run(v, root);
}

static long cs_file_size(const char *p) {
    sy_stat_t st;
    if (sy_stat(p, &st)) return -1;
    return st.size;
}

static void cs_expect_file(const char *p, const char *what) {
    long n = cs_file_size(p);
    if (n < 0) cs_die(what, p);
    sy_printf("CHAIN\t%s\tfile=%s\tbytes=%ld\n", what, p, n);
}

static void cs_sha(const char *p, char out[65]) {
    long n = cs_file_size(p), at = 0;
    int fd;
    char *b;
    if (n < 0) cs_die("sha256 read", p);
    b = n > 0 ? malloc((size_t)n) : 0;
    if (n > 0) {
        fd = sy_open(p, O_RDONLY, 0);
        if (fd < 0 || sy_read_full(fd, b, n) || sy_close(fd)) { free(b); cs_die("sha256 read", p); }
    }
    if (sy_sha256_hex(b, n, out)) { free(b); cs_die("sha256", p); }
    free(b);
    (void)at;
}

/* ---------- 各相位 ---------- */

static int cs_snap(const char *rev, const char *out) {
    /* release-build --rev 的快照就是 git archive 加仓根三件套与 .release-rev 标记
       （tools/release-build.cx:639 rb_freeze 的同一配方）；这里按同一配方做，省掉一次
       p3 构建。已存在同 rev 标记的快照直接复用，不重打。 */
    char spec[128], full[80], brief[11], dir[4400], mark[4400], cmd[9000];
    char *sh[4];
    long n = 0;
    int i;
    if (cx_fmt(spec, sizeof spec, "%s^{commit}", rev)) cs_die("rev", rev);
    if (cx_fmt(cmd, sizeof cmd, "git rev-parse --verify %s", spec)) cs_die("rev", rev);
    {
        char got[128];
        int ofd = -1, pid, ex = 0, code = 0, sig = 0;
        char *v[5];
        v[0] = "/bin/sh"; v[1] = "-c"; v[2] = cmd; v[3] = 0;
        pid = sy_spawn_pipe(v, ".", SY_SPAWN_NO_PATH, &ofd, 0);
        if (pid < 0) cs_die("spawn", "git");
        n = 0;
        if (ofd >= 0) {
            long r = sy_read(ofd, got, sizeof got - 1);
            if (r > 0) n = r;
            sy_close(ofd);
        }
        if (sy_wait_status(pid, 0, &ex, &code, &sig) < 0 || (ex ? code : 128 + sig)) {
            sy_eprintf("chain-step: rev-parse ex=%d code=%d sig=%d got=%.80s\n", ex, code, sig, got);
            cs_die("rev", rev);
        }
        got[n] = 0;
        while (n > 0 && (got[n - 1] == '\n' || got[n - 1] == '\r')) got[--n] = 0;
        if (n != 40) cs_die("rev not 40 hex", rev);
        for (i = 0; i < 40; i++) full[i] = got[i];
        full[40] = 0;
    }
    for (i = 0; i < 10; i++) brief[i] = full[i];
    brief[10] = 0;
    if (cx_fmt(dir, sizeof dir, "%s/release-snap-%s", out, brief)) cs_die("path", out);
    if (cx_fmt(mark, sizeof mark, "%s/.release-rev", dir)) cs_die("path", dir);
    if (sy_exists(mark)) {
        sy_printf("CHAIN\tsnap\treused=%s\trev=%.10s\n", dir, full);
        return 0;
    }
    if (sy_exists(dir)) cs_die("snapshot exists without a matching rev marker", dir);
    if (sy_mkdir(dir, 0755)) cs_die("snapshot mkdir", dir);
    if (cx_fmt(cmd, sizeof cmd, "git archive %s | tar -x -C %s", full, dir)) cs_die("path", dir);
    sh[0] = "sh"; sh[1] = "-c"; sh[2] = cmd; sh[3] = 0;
    if (cs_run(sh, ".")) cs_die("git archive", dir);
    /* 冻结 ROOT 的启动器、根纪元记录与 dev 分体是一件东西：prepare-context 会核
       root-epoch-product-digest，少一件就拒。git archive 不带这三件（构建产物）。 */
    if (cx_fmt(cmd, sizeof cmd,
               "cp unisacc.com %s/unisacc.com && cp unisacc.com.build.json %s/unisacc.com.build.json"
               " && cp -a unisacc.com.dev %s/unisacc.com.dev", dir, dir, dir)) cs_die("path", dir);
    sh[0] = "sh"; sh[1] = "-c"; sh[2] = cmd; sh[3] = 0;
    if (cs_run(sh, ".")) cs_die("copy launcher", dir);
    {
        int fd = sy_open(mark, O_WRONLY | O_CREAT | O_TRUNC, 0644);
        if (fd < 0 || sy_write_all(fd, full, 40) || sy_close(fd)) cs_die("snapshot marker", mark);
    }
    sy_printf("CHAIN\tsnap\tfile=%s\trev=%.10s\n", dir, full);
    return 0;
}

/* gen2 = gen1 当构造器出的一片；gen3 = gen2 当构造器出的同目标片；cmp 两份必须全等。
   这是"两代不动点"的可执行口径：外部构造器只算 bootstrapping，不算一代。 */
static int cs_fixedpoint(const char *rev, const char *s, const char *pkg, const char *gen1, const char *out,
                         const char *target) {
    char g2[4400], g3[4400], c2[4400], c3[4400], t2[4400], t3[4400];
    char *a[10];
    int n = 0;
    if (cs_file_size(gen1) < 0) cs_die("gen1 candidate missing", gen1);
    if (cx_fmt(g2, sizeof g2, "%s/g2", out)) cs_die("path", out);
    if (cx_fmt(g3, sizeof g3, "%s/g3", out)) cs_die("path", out);
    if (sy_setenv("UNISACC_CTOR", gen1, 1)) cs_die("env", "UNISACC_CTOR");
    a[n++] = (char *)pkg; a[n++] = g2;
    a[n++] = (char *)"--target"; a[n++] = (char *)target; a[n] = 0;
    if (cs_slice(rev, s, n, a)) return 2;
    if (cx_fmt(c2, sizeof c2, "%s/%s", g2, tx_eqz(target, "lnx/x86_64") ? "candidate" : "slice-lnx-x86_64")) cs_die("path", g2);
    if (cs_file_size(c2) < 0) cs_die("gen2 candidate missing", c2);
    if (sy_setenv("UNISACC_CTOR", c2, 1)) cs_die("env", "UNISACC_CTOR");
    n = 0;
    a[n++] = (char *)pkg; a[n++] = g3;
    a[n++] = (char *)"--target"; a[n++] = (char *)target; a[n] = 0;
    if (cs_slice(rev, s, n, a)) return 2;
    if (cx_fmt(c3, sizeof c3, "%s/%s", g3, tx_eqz(target, "lnx/x86_64") ? "candidate" : "slice-lnx-x86_64")) cs_die("path", g3);
    if (cs_file_size(c3) < 0) cs_die("gen3 candidate missing", c3);
    /* 逐字节比较：两份都用 sy_open/sy_read 读全，长度不同直接判红。 */
    {
        long n2 = cs_file_size(c2), n3 = cs_file_size(c3), k;
        int same = 1, fd;
        if (n2 != n3) same = 0;
        else if (n2 > 0) {
            char *b2 = malloc((size_t)n2), *b3 = malloc((size_t)n3);
            if (!b2 || !b3) cs_die("alloc", "candidate buffers");
            fd = sy_open(c2, O_RDONLY, 0);
            if (fd < 0 || sy_read_full(fd, b2, n2) || sy_close(fd)) cs_die("read candidate", c2);
            fd = sy_open(c3, O_RDONLY, 0);
            if (fd < 0 || sy_read_full(fd, b3, n3) || sy_close(fd)) cs_die("read candidate", c3);
            for (k = 0; same && k < n2; k++) if (b2[k] != b3[k]) same = 0;
            free(b2);
            free(b3);
        }
        if (!same) { sy_printf("CHAIN\tfixedpoint\tMISMATCH\tgen2=%s\tgen3=%s\n", c2, c3); return 1; }
    }
    if (cx_fmt(t2, sizeof t2, "%s/candidate", g2)) cs_die("path", g2);
    if (cx_fmt(t3, sizeof t3, "%s/candidate", g3)) cs_die("path", g3);
    {
        char h2[65], h3[65];
        cs_sha(t2, h2);
        cs_sha(t3, h3);
        sy_printf("CHAIN\tfixedpoint\tgen2=%.16s\tgen3=%.16s\tbytes=%ld\tsame=1\n", h2, h3, cs_file_size(t2));
    }
    return 0;
}

static int cs_build(const char *rev, const char *s, const char *b) {
    (void)rev;
    char boot[4400], cc_src[4400], cc_out[4400], bound[4400];
    char *v[10];
    int n = 0;
    if (cx_fmt(bound, sizeof bound, "%s/tools/bound", s)) cs_die("path", s);
    if (cx_fmt(boot, sizeof boot, "%s/Root41-bootstrap.com", b)) cs_die("path", b);
    if (cs_file_size(boot) < 0) cs_die("bootstrap missing", boot);
    if (cx_fmt(cc_src, sizeof cc_src, "%s/tools/source-package.cx", s)) cs_die("path", s);
    if (cx_fmt(cc_out, sizeof cc_out, "%s/source-package-O2.elf", b)) cs_die("path", b);
    v[n++] = bound;
    v[n++] = (char *)"55";
    v[n++] = (char *)"sh";
    v[n++] = boot;
    v[n++] = (char *)"-O2";
    v[n++] = cc_src;
    v[n++] = (char *)"-o";
    v[n++] = cc_out;
    v[n] = 0;
    if (cs_run(v, b)) cs_die("controller build", cc_out);
    cs_expect_file(cc_out, "controller");
    return 0;
}

static int cs_ctx(const char *rev, const char *s, const char *b, const char *ctx, const char *cc) {
    (void)rev;
    char boot[4400];
    char *a[10];
    int n = 0;
    if (cx_fmt(boot, sizeof boot, "%s/Root41-bootstrap.com", b)) cs_die("path", b);
    a[n++] = (char *)"prepare-context"; a[n++] = (char *)s; a[n++] = boot;
    a[n++] = (char *)cc; a[n++] = (char *)ctx; a[n] = 0;
    if (cs_tool(s, "tools/source-package.cx", a)) cs_die("prepare-context", ctx);
    return 0;
}

static int cs_wave(const char *s, const char *ctx, const char *b, const char *phase,
                   const char *first, const char *count) {
    char *a[12];
    int n = 0;
    a[n++] = (char *)s; a[n++] = (char *)ctx; a[n++] = (char *)b;
    a[n++] = (char *)"wave"; a[n++] = (char *)phase; a[n++] = (char *)first;
    a[n++] = (char *)count; a[n++] = (char *)"start-job"; a[n] = 0;
    if (cs_tool(s, "tools/source-job-wave.cx", a)) cs_die("wave start-job", phase);
    n = 0;
    a[n++] = (char *)s; a[n++] = (char *)ctx; a[n++] = (char *)b;
    a[n++] = (char *)"wave"; a[n++] = (char *)phase; a[n++] = (char *)first;
    a[n++] = (char *)count; a[n++] = (char *)"finish-job"; a[n] = 0;
    if (cs_tool(s, "tools/source-job-wave.cx", a)) cs_die("wave finish-job", phase);
    return 0;
}

static int cs_simple_wave(const char *s, const char *ctx, const char *b, const char *what) {
    char *a[8];
    int n = 0;
    a[n++] = (char *)s; a[n++] = (char *)ctx; a[n++] = (char *)b; a[n++] = (char *)what; a[n] = 0;
    return cs_tool(s, "tools/source-job-wave.cx", a);
}

/* release-build.cx 的两个动作都要先经过它自己的 --rev 前缀；argv[0] 是启动器
   （sh <S>/unisacc.com <S>/tools/release-build.cx），不是 "--rev"。ROOT 用主树 "."：
   rb_freeze 会把 ROOT 换成 out/release-snap-<rev10> 再取源，传已冻结的 S 会让它去找
   snap 里的 snap。启动器与工具仍取 S 里的那份，避免用主树被改过的脚本。 */
static int cs_release(const char *rev, const char *s, int argc, char **argv, const char *what) {
    char com[4400], tool[4400];
    char *a[32];
    int n = 0, i;
    if (cx_fmt(com, sizeof com, "%s/unisacc.com", s)) cs_die("path", s);
    if (cx_fmt(tool, sizeof tool, "%s/tools/release-build.cx", s)) cs_die("path", s);
    a[n++] = (char *)"sh";
    a[n++] = com;
    a[n++] = tool;
    a[n++] = (char *)"--rev"; a[n++] = (char *)rev;
    for (i = 0; i < argc && n + 1 < 32; i++) a[n++] = argv[i];
    a[n] = 0;
    if (cs_run(a, ".")) cs_die(what, "see release-build output above");
    return 0;
}

static int cs_p3(const char *rev, const char *s, int argc, char **argv) {
    char *a[24];
    int n = 0, i;
    int have_nets = 0, have_routes = 0;
    (void)s;
    for (i = 0; i < argc; i++) {
        if (tx_eqz(argv[i], "--nets")) have_nets = 1;
        if (tx_eqz(argv[i], "--routes")) have_routes = 1;
    }
    if (!have_nets || !have_routes)
        cs_die("p3 needs --nets CTX/jobs and --routes ROUTES", "a package without them is byte-identical to the stale 9f1ec852");
    /* ROOT 交给 release-build 自己冻结：它把 ROOT 换成 snap 后从 snap 取工具与源。
       传 S（已经是 snap）会让它去找 snap 里的 snap。 */
    a[n++] = (char *)"p3"; a[n++] = (char *)".";
    for (i = 0; i < argc && n + 1 < 24; i++) a[n++] = argv[i];
    a[n] = 0;
    return cs_release(rev, s, n, a, "p3");
}

static int cs_slice(const char *rev, const char *s, int argc, char **argv) {
    char *a[24];
    int n = 0, i;
    (void)s;
    a[n++] = (char *)"slice"; a[n++] = (char *)".";
    for (i = 0; i < argc && n + 1 < 24; i++) a[n++] = argv[i];
    a[n] = 0;
    return cs_release(rev, s, n, a, "slice");
}

static int cs_pack(int argc, char **argv) {
    char *a[12];
    int n = 0, i;
    a[n++] = (char *)"pack";
    for (i = 0; i < argc && n + 1 < 12; i++) a[n++] = argv[i];
    a[n] = 0;
    return cs_tool(".", "tools/release-ape.cx", a);
}

static int cs_ape_smoke(const char *ape) {
    char *a[4];
    a[0] = (char *)"smoke"; a[1] = (char *)ape; a[2] = 0;
    return cs_tool(".", "tools/release-ape.cx", a);
}

static int cs_check(const char *ape) {
    char *a[4];
    a[0] = (char *)"--"; a[1] = (char *)ape; a[2] = 0;
    return cs_tool(".", "tools/check-install-fixes.cx", a);
}

int main(int argc, char **argv) {
    g_self = "chain-step";
    if (argc < 3) {
        sy_eprintf("usage: chain-step snap|build|ctx|host|list|wave|final|p3|slice|pack|smoke|check ...\n");
        return 2;
    }
    if (tx_eqz(argv[1], "build")) {
        if (argc < 5) cs_die("build needs REV S B", 0);
        return cs_build(argv[2], argv[3], argv[4]);
    }
    if (tx_eqz(argv[1], "ctx")) {
        if (argc < 7) cs_die("ctx needs REV S B CTX CC", 0);
        return cs_ctx(argv[2], argv[3], argv[4], argv[5], argv[6]);
    }
    if (tx_eqz(argv[1], "host")) {
        if (argc < 5) cs_die("host needs S CTX B", 0);
        return cs_simple_wave(argv[2], argv[3], argv[4], "host");
    }
    if (tx_eqz(argv[1], "list")) {
        if (argc < 5) cs_die("list needs S CTX B", 0);
        return cs_simple_wave(argv[2], argv[3], argv[4], "list");
    }
    if (tx_eqz(argv[1], "final")) {
        if (argc < 5) cs_die("final needs S CTX B", 0);
        return cs_simple_wave(argv[2], argv[3], argv[4], "final");
    }
    if (tx_eqz(argv[1], "wave")) {
        if (argc < 8) cs_die("wave needs S CTX B PHASE FIRST COUNT", 0);
        return cs_wave(argv[2], argv[3], argv[4], argv[5], argv[6], argv[7]);
    }
    if (tx_eqz(argv[1], "p3")) {
        if (argc < 6) cs_die("p3 needs REV S SRC_PKG OUT --nets CTX/jobs --routes R", 0);
        return cs_p3(argv[2], argv[3], argc - 4, argv + 4);
    }
    if (tx_eqz(argv[1], "slice")) {
        if (argc < 6) cs_die("slice needs REV S PKG OUT --target T", 0);
        return cs_slice(argv[2], argv[3], argc - 4, argv + 4);
    }
    if (tx_eqz(argv[1], "pack")) {
        if (argc < 9) cs_die("pack needs OUT P3 WIN LNX LNXARM OSX OSXARM", 0);
        return cs_pack(argc - 2, argv + 2);
    }
    if (tx_eqz(argv[1], "smoke")) {
        if (argc < 3) cs_die("smoke needs APE", 0);
        return cs_ape_smoke(argv[2]);
    }
    if (tx_eqz(argv[1], "check")) {
        if (argc < 3) cs_die("check needs APE", 0);
        return cs_check(argv[2]);
    }
    if (tx_eqz(argv[1], "snap")) {
        if (argc < 3) cs_die("snap needs REV [OUT]", 0);
        return cs_snap(argv[2], argc > 3 ? argv[3] : "out");
    }
    if (tx_eqz(argv[1], "fixedpoint")) {
        /* fixedpoint REV S PKG GEN1 OUT --target T */
        if (argc < 7) cs_die("fixedpoint needs REV S PKG GEN1 OUT --target T", 0);
        {
            const char *target = 0;
            int i;
            for (i = 6; i + 1 < argc; i++) if (tx_eqz(argv[i], "--target")) target = argv[i + 1];
            if (!target) cs_die("fixedpoint needs --target T", 0);
            return cs_fixedpoint(argv[2], argv[3], argv[4], argv[5], argv[6], target);
        }
    }
    sy_eprintf("chain-step: unknown step %s\n", argv[1]);
    return 2;
}
