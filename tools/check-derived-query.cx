/* tools/check-derived-query.cx -- tools/derived-query.cx 的检查:夹具根里验证现算与 tool-index --write 字节一致、命中、源树改动后失效且旧缓存不被误用、缓存损坏回退现算且不留脏数据。
 *
 *   sh ./unisacc.com tools/check-derived-query.cx
 */
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use mem.bytes

static int failed;
static void ck(int ok, const char *name) {
    if (ok) sy_printf("PASS\tcheck-derived-query.%s\n", name);
    else { failed++; sy_printf("FAIL\tcheck-derived-query.%s\n", name); }
}
static int has(const char *h, const char *lit) { return h && strstr(h, lit) != 0; }

int main(void) {
    char dir[320], cmd[6000]; char *o = 0; size_t n = 0; int rc;
    if (cx_fmt(dir, sizeof dir, "%s/derived-query-check-XXXXXX", sy_tmpdir()) || !mkdtemp(dir)) { ck(0, "tmpdir"); return 1; }
    cx_fmt(cmd, sizeof cmd,
        "T=%s/root; C=%s/cache; mkdir -p $T/tools/cxlib $T/tests $T/build/layer-api || exit 9; "
        "printf '/* tools/alpha.cx -- does alpha. */\\nint main(void){return 0;}\\n' > $T/tools/alpha.cx; "
        "printf '/* tools/check-alpha.cx -- alpha check */\\nint main(void){return 0;}\\n' > $T/tools/check-alpha.cx; "
        "printf 'id\\timplementation\\tlayer\\tsource\\tmode\\tplatform\\tbudget_seconds\\tmaterials\\tentry\\nb-alpha\\tIMPLEMENTED\\tx\\ttools/check-alpha.cx\\tSOURCE\\tlnx\\t5\\t-\\ttools/check-alpha.cx\\n' > $T/tests/batches.tsv; "
        "Q=\"sh ./unisacc.com tools/derived-query.cx -- tool-index --root $T --cache $C\"; "
        "$Q > $T/q1 2> $T/e1; echo Q1RC=$?; echo S1=$(cut -f3 $T/e1); "
        "sh ./unisacc.com tools/tool-index.cx -- --write --root $T > /dev/null 2>&1; echo WRC=$?; "
        "cmp -s $T/q1 $T/build/tool-index.tsv && echo SAME_AS_WRITE; "
        "$Q > $T/q2 2> $T/e2; echo S2=$(cut -f3 $T/e2); cmp -s $T/q1 $T/q2 && echo HIT_SAME; "
        "$Q --check > $T/verified 2> $T/verify.err; echo VERIFY_RC=$?; grep '^DQ_CHECK' $T/verified; "
        "K1=$($Q --key); echo ZETA_BEFORE=$(grep -c '^zeta.cx' $T/q2); "
        "printf '/* tools/zeta.cx -- does zeta. */\\nint main(void){return 0;}\\n' > $T/tools/zeta.cx; "
        "$Q > $T/q3 2> $T/e3; echo Q3RC=$?; echo S3=$(cut -f3 $T/e3); K2=$($Q --key); [ \"$K1\" != \"$K2\" ] && echo KEY_MOVED; "
        "echo ZETA_AFTER=$(grep -c '^zeta.cx' $T/q3); "
        "rm $T/tools/zeta.cx; $Q > $T/q4 2> $T/e4; echo S4=$(cut -f3 $T/e4); cmp -s $T/q4 $T/q1 && echo BACK_SAME; "
        "printf 'junk\\n' > $C/tool-index/$K1.tsv; $Q > $T/q5 2> $T/e5; echo Q5RC=$?; echo S5=$(cut -f3 $T/e5); "
        "cmp -s $T/q5 $T/q1 && echo CORR_OUT_SAME; cmp -s $C/tool-index/$K1.tsv $T/q1 && echo CORR_CACHE_CLEAN; "
        "rm $C/tool-index/$K1.sha; $Q > $T/q6 2> $T/e6; echo S6=$(cut -f3 $T/e6); cmp -s $T/q6 $T/q1 && echo NOSHA_SAME; "
        "echo TMPLEFT=$(ls -a $C/tool-index | grep -c '^\\.tmp'); "
        "$Q --timeout-ms 99999 > /dev/null 2>&1; echo BADTMO=$?",
        dir, dir);
    {
        char *v[] = {"sh", "-c", cmd, 0};
        rc = cx_runv_timeout(v, 58, &o, &n);
    }
    if (o) sy_printf("%s", o);
    ck(rc == 0 && has(o, "Q1RC=0") && has(o, "S1=miss\n"), "first-query-computes");
    ck(has(o, "WRC=0") && has(o, "SAME_AS_WRITE"), "bytes-equal-tool-index-write");
    ck(has(o, "S2=hit\n") && has(o, "HIT_SAME"), "second-query-hits-same-bytes");
    ck(has(o, "ZETA_BEFORE=0") && has(o, "ZETA_AFTER=1") && has(o, "KEY_MOVED") && has(o, "S3=miss\n") && has(o, "Q3RC=0"), "source-change-invalidates-old-cache");
    ck(has(o, "S4=hit\n") && has(o, "BACK_SAME"), "revert-reuses-identity");
    ck(has(o, "Q5RC=0") && has(o, "S5=recovered\n") && has(o, "CORR_OUT_SAME") && has(o, "CORR_CACHE_CLEAN"), "corrupt-cache-recomputed-and-replaced");
    ck(has(o, "S6=recovered\n") && has(o, "NOSHA_SAME"), "missing-sidecar-recomputed");
    ck(has(o, "TMPLEFT=0"), "no-temp-left");
    ck(has(o, "BADTMO=2"), "timeout-above-cap-refused");
    ck(has(o, "VERIFY_RC=0")&&has(o, "DQ_CHECK\ttool-index\tOK"),"query-check-independently-recomputes");
    if (o) { free(o); o = 0; }

    /* U2: links + doc-links + batch-domains R1 byte-identical & 6 invalidation negative controls */
    cx_fmt(cmd, sizeof cmd,
        "D=%s/u2; C=%s/u2c; mkdir -p $D/exec/facts $D/tests $D/tools $D/cx; "
        "sh ./unisacc.com -o %s/dq.bin tools/derived-query.cx || exit 9; "
        "DQ=%s/dq.bin; "
        /* 1. links fixture */
        "printf 'name\\tgen\\tcheck\\twrite\\tout\\tinputs\\tphase\\tbound\\nlinks\\ttools/links-gen.cx\\t-\\t-\\tbuild/links.tsv\\t-\\t1\\t20\\n' > $D/exec/facts/derive.tsv; "
        "printf 'id\\timplementation\\tlayer\\tsource\\tmode\\tplatform\\tbudget_seconds\\tmaterials\\tentry\\nb-one\\tIMPLEMENTED\\tx\\ttools/a.cx\\tSOURCE\\tlnx\\t5\\t-\\ttools/a.cx\\n' > $D/tests/batches.tsv; "
        "$DQ links --root $D --cache $C > $D/l1 2> $D/le1; echo L1RC=$?; echo LS1=$(cut -f3 $D/le1); "
        "sh ./unisacc.com tools/links-gen.cx -- --root $D --emit $D/lref; cmp -s $D/l1 $D/lref && echo L_SAME_AS_GEN; "
        "$DQ links --root $D --cache $C > $D/l2 2> $D/le2; echo LS2=$(cut -f3 $D/le2); "
        "$DQ links --root $D --cache $C --check > $D/lc 2> $D/lce; echo LCRC=$?; grep '^DQ_CHECK' $D/lc; "
        "LP=$($DQ links --root $D --cache $C --path 2>/dev/null); [ -s \"$LP\" ] && cmp -s \"$LP\" $D/lref && echo L_PATH_OK; "
        "LK1=$($DQ links --root $D --cache $C --key); "
        "printf 'unrelated\\n' > $D/unrelated.txt; "
        "LK_UNREL=$($DQ links --root $D --cache $C --key); [ \"$LK1\" = \"$LK_UNREL\" ] && echo L_UNREL_HIT; "
        "printf 'b-two\\tIMPLEMENTED\\tx\\ttools/b.cx\\tSOURCE\\tlnx\\t5\\t-\\ttools/b.cx\\n' >> $D/tests/batches.tsv; "
        "LK2=$($DQ links --root $D --cache $C --key); [ \"$LK1\" != \"$LK2\" ] && echo L_INPUT_INVALIDATES; "
        "$DQ links --root $D --cache $C > $D/l3 2> $D/le3; echo LS3=$(cut -f3 $D/le3); "
        "printf 'corrupt\\n' > $C/links/$LK2.tsv; $DQ links --root $D --cache $C > $D/l4 2> $D/le4; echo LS4=$(cut -f3 $D/le4); cmp -s $D/l4 $D/l3 && echo L_CORR_OK; "
        "$DQ bad-table --root $D --cache $C >/dev/null 2>&1; echo BAD_TBL_RC=$?; "
        /* 2. doc-links fixture in isolated git repo */
        "G=%s/u2g; mkdir -p $G/tools $G/build; git -C $G init -q; git -C $G config user.email t@t; git -C $G config user.name t; "
        "printf 'src\\tline\\tdst\\treason\\n' > $G/tools/doc-links-baseline.tsv; "
        "printf '# Doc\\nSee [b](b.md)\\n' > $G/a.md; printf '# B\\nSee [a](a.md)\\n' > $G/b.md; "
        "git -C $G add a.md b.md tools/doc-links-baseline.tsv; git -C $G commit -q -m init; "
        "$DQ doc-links --root $G --cache $C > $D/d1 2> $D/de1; echo D1RC=$?; echo DS1=$(cut -f3 $D/de1 | tail -n 1); "
        "sh ./unisacc.com tools/doc-links-gen.cx -- --write --root $G --table $D/dref >/dev/null 2>&1; cmp -s $D/d1 $D/dref && echo D_SAME_AS_GEN; "
        "$DQ doc-links --root $G --cache $C --check > $D/dc 2> $D/dce; echo DCRC=$?; grep '^DQ_CHECK' $D/dc; "
        "DK1=$($DQ doc-links --root $G --cache $C --key); "
        "printf '# C\\n' > $G/c.md; git -C $G add c.md; "
        "DK2=$($DQ doc-links --root $G --cache $C --key); [ \"$DK1\" != \"$DK2\" ] && echo D_ADD_INVALIDATES; "
        "git -C $G rm -qf c.md; DK3=$($DQ doc-links --root $G --cache $C --key); [ \"$DK1\" = \"$DK3\" ] && echo D_DEL_REVERTS; "
        "printf '# Doc\\nSee [missing](no-such-file.md)\\n' > $G/a.md; "
        "$DQ doc-links --root $G --cache $C >/dev/null 2>&1; echo D_BROKEN_RC=$?; "
        /* 3. batch-domains live check + cache hit */
        "$DQ batch-domains --root . --cache $C --check > $D/bc1 2> $D/be1; echo B1RC=$?; grep '^DQ_CHECK' $D/bc1; "
        "$DQ batch-domains --root . --cache $C > /dev/null 2> $D/be2; echo BS2=$(cut -f3 $D/be2 | tail -n 1); "
        "rm -rf %s",
        dir, dir, dir, dir, dir, dir);
    {
        char *v[] = {"sh", "-c", cmd, 0};
        rc = cx_runv_timeout(v, 58, &o, &n);
    }
    if (o) sy_printf("%s", o);
    ck(rc == 0 && has(o, "L1RC=0") && has(o, "LS1=miss\n") && has(o, "L_SAME_AS_GEN"), "links-r1-byte-identical");
    ck(has(o, "LS2=hit\n") && has(o, "LCRC=0") && has(o, "DQ_CHECK\tlinks\tOK") && has(o, "L_PATH_OK"), "links-hit-path-and-deterministic-check");
    ck(has(o, "L_UNREL_HIT") && has(o, "L_INPUT_INVALIDATES") && has(o, "LS3=miss\n") && has(o, "LS4=recovered\n") && has(o, "L_CORR_OK"), "links-invalidation-and-corrupt-recovery");
    ck(has(o, "BAD_TBL_RC=2"), "unknown-table-refused");
    ck(has(o, "D1RC=0") && has(o, "D_SAME_AS_GEN") && has(o, "DCRC=0") && has(o, "DQ_CHECK\tdoc-links\tOK"), "doc-links-r1-byte-identical-and-check");
    ck(has(o, "D_ADD_INVALIDATES") && has(o, "D_DEL_REVERTS") && has(o, "D_BROKEN_RC=4"), "doc-links-add-del-and-broken-refused");
    ck(has(o, "B1RC=0") && has(o, "DQ_CHECK\tbatch-domains\tOK") && has(o, "BS2=hit\n"), "batch-domains-check-and-hit");

    sy_printf("CHECK_DERIVED_QUERY\t%s\tfailed=%d\n", failed ? "FAIL" : "PASS", failed);
    return failed ? 1 : 0;
}
