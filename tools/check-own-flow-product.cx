/* tools/check-own-flow-product.cx -- product side of OWN-E2 (plans/v0.0.77.md P5): the compiler's
 * `#pragma unisa safe` check against the own-flow oracle table, row by row.
 *
 *   sh ./unisacc.com tools/check-own-flow-product.cx -- --product CC --work W [--dir D]
 *
 * D (default tests/cases/own-flow) holds the fixtures and expected.tsv (file, function, expect).  For every row
 * a private copy of its fixture is written under W (a private directory, created) with two lines in front:
 *   #pragma unisa safe
 *   #pragma unisa unsafe G...      every other function of that file named in the table (and the row's own
 *                                  function for an UNSAFE row), so each row sees exactly one function checked
 * and compiled once with `CC -c COPY -o COPY.o` (bound 50 s).  Verdicts, from the compiler output:
 *   E2 / E2b  refused with "unisa safe: use after free of NAME in FN" / "unisa safe: double free of NAME in FN"
 *             for the row's function; the refusal set is compared, not the kind: the compiler names only the
 *             first finding of a unit and the oracle names all of them (r1-r06 g: E2 then E2b), so a first
 *             finding of the other kind passes and is listed on a KIND line and counted as kind_other
 *   OK        no "unisa safe" refusal and no pragma refusal (other compile errors of the fixture snippet, such
 *             as an undeclared helper, are not the plan's verdict and are only counted as cc_rc_nonzero)
 *   UNSAFE    as OK; the exempt count unsafe= is the number of UNSAFE rows
 *   KNOWN-LIMIT  compiled and listed, not counted
 * A product without the pragma (0.0.76 and older) refuses every copy with "unknown unisa pragma": all counted
 * rows fail, the negative control.
 * Last line  CHECK_OWN_FLOW_PRODUCT<TAB>passed=P/N<TAB>failed=F<TAB>known_limit=K<TAB>unsafe=U<TAB>cc_rc_nonzero=R
 * rc 1 when F > 0, rc 2 on a usage or I/O error. */
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

#define MAXROW 256

static char rfile[MAXROW][128], rfn[MAXROW][64], rexp[MAXROW][16];
static int nrow;

/* copy the cell [S, E) into DST, stopping at '@' (E2@5: the line is the oracle's business); -1 when empty or long */
static int field(const char *s, const char *e, char *dst, int cap) {
    int n = 0;
    while (s + n < e && s[n] != '@') { if (n + 1 >= cap) return -1; dst[n] = s[n]; n++; }
    dst[n] = 0;
    return n ? 0 : -1;
}
static int load_table(const char *path) {
    size_t n; char *s = cx_read(path, &n), *p, *end;
    if (!s) return -1;
    p = s; end = s + n;
    while (p < end) {
        char *nl = p, *t1, *t2;
        while (nl < end && *nl != '\n') nl++;
        t1 = p; while (t1 < nl && *t1 != '\t') t1++;
        t2 = t1 < nl ? t1 + 1 : nl; while (t2 < nl && *t2 != '\t') t2++;
        if (t1 < nl && t2 < nl && strncmp(p, "file\t", 5) != 0 && nrow < MAXROW &&
            !field(p, t1, rfile[nrow], 128) && !field(t1 + 1, t2, rfn[nrow], 64) && !field(t2 + 1, nl, rexp[nrow], 16))
            nrow++;
        p = nl + 1;
    }
    mm_free(s);
    return 0;
}
/* FN is a function the table lists with expect K in FILE */
static int table_has(const char *file, const char *fn, const char *k) {
    int i;
    for (i = 0; i < nrow; i++) if (!strcmp(rfile[i], file) && !strcmp(rfn[i], fn) && !strcmp(rexp[i], k)) return 1;
    return 0;
}

int main(int argc, char **argv) {
    const char *dir = "tests/cases/own-flow", *cc = 0, *work = 0;
    char wbuf[512], path[1024], copy[1200], cmd[4096], fn[128];
    int a = 1, i, passed = 0, failed = 0, counted = 0, known = 0, unsafe_n = 0, ccnz = 0, kindother = 0;
    while (a < argc) {
        if (tx_eqz(argv[a], "--dir") && a + 1 < argc) { dir = argv[a + 1]; a += 2; }
        else if (tx_eqz(argv[a], "--product") && a + 1 < argc) { cc = argv[a + 1]; a += 2; }
        else if (tx_eqz(argv[a], "--work") && a + 1 < argc) { work = argv[a + 1]; a += 2; }
        else { fprintf(stderr, "usage: check-own-flow-product.cx -- --product CC [--dir D] [--work W]\n"); return 2; }
    }
    if (!cc) { fprintf(stderr, "check-own-flow-product: --product CC is required\n"); return 2; }
    if (!work) { fprintf(stderr, "check-own-flow-product: --work W (a private directory) is required\n"); return 2; }
    (void)wbuf;
    /* the copies resolve `#pragma unisa use mem.heap` beside themselves: link the library roots of this checkout */
    if (cx_fmt(cmd, sizeof cmd, "mkdir -p '%s' && for m in mem sys text; do ln -sfn \"$(pwd)/cx/$m\" '%s'/$m; done", work, work)) return 2;
    { char *o = 0; size_t on = 0; cx_run_timeout(cmd, 10, &o, &on); if (o) mm_free(o); }
    if (cx_fmt(path, sizeof path, "%s/expected.tsv", dir) || load_table(path)) { fprintf(stderr, "check-own-flow-product: cannot read %s\n", path); return 2; }
    for (i = 0; i < nrow; i++) {
        size_t n, hn; char *s, *buf, *out = 0; size_t outn = 0;
        int j, kl = !strcmp(rexp[i], "KNOWN-LIMIT"), uns = !strcmp(rexp[i], "UNSAFE"), ok = 0, refused, pragmabad, rc;
        char head[2048];
        if (cx_fmt(path, sizeof path, "%s/%s", dir, rfile[i])) return 2;
        s = cx_read(path, &n);
        if (!s) { printf("FAIL\t%s\t%s\tfixture missing\n", rfile[i], rfn[i]); failed++; counted++; continue; }
        /* the head: safe, and unsafe for every other function of the file (and this one for UNSAFE) */
        if (cx_fmt(head, sizeof head, "#pragma unisa safe\n")) return 2;
        {
            char names[1500]; int any = 0;
            names[0] = 0;
            for (j = 0; j < nrow; j++) {
                int dup = 0, q;
                if (strcmp(rfile[j], rfile[i])) continue;
                if (!strcmp(rfn[j], rfn[i]) && !uns) continue;
                for (q = 0; q < j; q++) if (!strcmp(rfile[q], rfile[i]) && !strcmp(rfn[q], rfn[j])) dup = 1;
                if (dup || strstr(names, rfn[j]) != 0) {
                    /* guard against a name that is a prefix of another: compare word by word */
                    char *w = names; int seen = 0;
                    while (*w) { char *e = w; while (*e && *e != ' ') e++; if ((size_t)(e - w) == strlen(rfn[j]) && !strncmp(w, rfn[j], (size_t)(e - w))) seen = 1; w = *e ? e + 1 : e; }
                    if (seen) continue;
                }
                if (cx_fmt(names + strlen(names), sizeof names - strlen(names), "%s%s", any ? " " : "", rfn[j])) return 2;
                any = 1;
            }
            if (any && cx_fmt(head + strlen(head), sizeof head - strlen(head), "#pragma unisa unsafe %s\n", names)) return 2;
        }
        hn = strlen(head);
        buf = mm_alloc(hn + n + 1);
        if (!buf) { mm_free(s); return 2; }
        mm_copy(buf, hn + n + 1, head, hn); mm_copy(buf + hn, n + 1, s, n); buf[hn + n] = 0;
        mm_free(s);
        if (cx_fmt(copy, sizeof copy, "%s/row%03d-%s", work, i, rfile[i])) { mm_free(buf); return 2; }
        if (cx_write(copy, buf, hn + n)) { mm_free(buf); fprintf(stderr, "check-own-flow-product: cannot write %s\n", copy); return 2; }
        mm_free(buf);
        if (cx_fmt(cmd, sizeof cmd, "%s -c '%s' -o '%s.o' 2>&1; echo CCRC=$?", cc, copy, copy)) return 2;
        cx_run_timeout(cmd, 50, &out, &outn);
        if (!out) { out = mm_alloc(1); if (out) out[0] = 0; }
        if (!out) return 2;
        { char *r = strstr(out, "CCRC="); rc = r ? atoi(r + 5) : -1; }
        refused = 0; fn[0] = 0;
        {
            char *m = strstr(out, "unisa safe: ");
            if (m) {
                char *in = strstr(m, " in "), *e;
                refused = strncmp(m + 12, "double free of ", 15) == 0 ? 2 : (strncmp(m + 12, "use after free of ", 18) == 0 ? 1 : 3);
                if (in) { in += 4; e = in; while (*e && *e != '\n' && *e != ' ') e++; if (e - in < (long)sizeof fn) { mm_copy(fn, sizeof fn, in, (size_t)(e - in)); fn[e - in] = 0; } }
            }
        }
        pragmabad = strstr(out, "unknown unisa pragma") != 0 || strstr(out, "unisa unsafe ") != 0 || strstr(out, "unisa safe takes") != 0;
        if (kl) {
            known++;
            printf("KNOWN-LIMIT\t%s\t%s\trefused=%d\trc=%d\n", rfile[i], rfn[i], refused, rc);
            mm_free(out); continue;
        }
        counted++;
        if (!strcmp(rexp[i], "E2") || !strcmp(rexp[i], "E2b"))
        {
            ok = !pragmabad && (refused == 1 || refused == 2) && !strcmp(fn, rfn[i]) && (table_has(rfile[i], fn, "E2") || table_has(rfile[i], fn, "E2b"));
            if (ok && !table_has(rfile[i], fn, refused == 2 ? "E2b" : "E2")) { kindother++; printf("KIND\t%s\t%s\texpect=%s\tfirst=%s\n", rfile[i], rfn[i], rexp[i], refused == 2 ? "E2b" : "E2"); }
        }
        else {
            ok = !pragmabad && !refused;
            if (ok && rc != 0) ccnz++;
            if (ok && uns) unsafe_n++;
        }
        if (ok) passed++;
        else {
            char *nl = out; while (*nl && *nl != '\n') nl++;
            failed++;
            printf("FAIL\t%s\t%s\texpect=%s\trefused=%d\tfn=%s\trc=%d\t%.*s\n", rfile[i], rfn[i], rexp[i], refused, fn, rc, (int)(nl - out), out);
        }
        mm_free(out);
    }
    printf("CHECK_OWN_FLOW_PRODUCT\tpassed=%d/%d\tfailed=%d\tknown_limit=%d\tunsafe=%d\tcc_rc_nonzero=%d\tkind_other=%d\n", passed, counted, failed, known, unsafe_n, ccnz, kindother);
    return failed ? 1 : 0;
}
