#pragma unisa use runtime.model_number
static int failures;
static void ck(int ok,const char *name){printf("%s\t%s\n",ok?"PASS":"FAIL",name);if(!ok)failures++;}
static void textcase(const char *s,int want,long long expected,const char *name){long p=0;long long v=42;int rc=cxmn_number((const unsigned char *)s,strlen(s),&p,0,&v);ck(rc==want&&(rc?v==42:v==expected),name);}
int main(void){
 textcase(" -9223372036854775808 ",0,(-9223372036854775807LL-1),"decimal-min");
 textcase("9223372036854775807",0,9223372036854775807LL,"decimal-max");
 textcase("9223372036854775808",6,0,"decimal-positive-overflow");
 textcase("-9223372036854775809",6,0,"decimal-negative-overflow");
 textcase("- ",7,0,"decimal-missing");textcase("1x",5,0,"decimal-bad-byte");
 unsigned char nums[]={0,1,2,0xac,2,0x80,0};long p=0;long long v=0;
 ck(cxmn_number(nums,7,&p,1,&v)==0&&v==0&&p==1,"binary-zero");
 ck(cxmn_number(nums,7,&p,1,&v)==0&&v==-1&&p==2,"binary-negative");
 ck(cxmn_number(nums,7,&p,1,&v)==0&&v==1&&p==3,"binary-positive");
 ck(cxmn_number(nums,7,&p,1,&v)==0&&v==150&&p==5,"binary-multibyte");
 v=42;ck(cxmn_number(nums,7,&p,1,&v)==3&&p==7&&v==42,"binary-noncanonical");
 p=0;unsigned char over[]={255,255,255,255,255,255,255,255,255,2};
 ck(cxmn_number(over,10,&p,1,&v)==2&&p==10&&v==42,"binary-overflow");
 p=0;unsigned char cut[]={128};ck(cxmn_number(cut,1,&p,1,&v)==1&&p==1&&v==42,"binary-truncated");
 p=2;ck(cxmn_number(cut,1,&p,1,&v)==8&&p==2&&v==42,"bad-cursor");
 printf("CXMODEL_NUMBER\tfailed=%d\n",failures);return failures?1:0;
}
