#pragma unisa use sys.io
#pragma unisa use text.text
/* Project the eighteen gold net names onto the runtime side.
   sh ./unisacc.com tools/netrt-gen.cx -- --check
   sh ./unisacc.com tools/netrt-gen.cx -- --write
   Names come from exec/pipeline/gold-stages.tsv, in file order.
   The compiler index stays on netname as nn_count / nn_at.
   lexcls and lexword are not rows of this table.
   The net modules already exist, so this is one index, not eighteen files.
   This is not st_gap.
   A null out-pointer returns 4. An index outside 0..count-1 returns 2.
   No libc and no include. */
#define STAGES "exec/pipeline/gold-stages.tsv"
#define NROW 18
#define NAMEMAX 32
#define FILECAP 4096
#define CHECKCAP 8192

static char names[NROW][NAMEMAX];
static int nname;

static int fail(const char *why) {
    sy_eprintf("netrt-gen\tFAIL\t%s\n", why);
    return 1;
}

static int name_ok(const char *s, int n) {
    int i;
    if (n < 1 || n >= NAMEMAX) return 0;
    for (i = 0; i < n; i++) if (s[i] < 'a' || s[i] > 'z') return 0;
    return 1;
}

static void copy_field(char *dst, const char *s, int n) {
    int i;
    for (i = 0; i < n; i++) dst[i] = s[i];
    dst[n] = 0;
}

static int in_set(const char *s) {
    int i;
    for (i = 0; i < nname; i++) if (tx_eqz(names[i], s)) return 1;
    return 0;
}

static int take_row(const char *line, int n) {
    char name[NAMEMAX];
    int i;
    for (i = 0; i < n; i++) if (line[i] == '\t') return fail("row-fields");
    if (!name_ok(line, n)) return fail("row-charset");
    copy_field(name, line, n);
    if (in_set(name)) return fail("name-dup");
    if (nname >= NROW) return fail("net-count");
    for (i = 0; name[i]; i++) names[nname][i] = name[i];
    names[nname][i] = 0;
    nname++;
    return 0;
}

static int parse_stages(void) {
    size_t nb = 0, i = 0;
    char *b;
    int saw = 0;
    b = cx_read(STAGES, &nb);
    if (!b) return fail(STAGES);
    if (nb == 0 || b[nb - 1] != '\n') return fail("tsv-newline");
    while (i < nb) {
        size_t e = i;
        while (e < nb && b[e] != '\n') e++;
        b[e] = 0;
        if (e == i) return fail("tsv-blank");
        if (!saw) {
            if (!tx_eqz(b + i, "# stage")) return fail("tsv-header");
            saw = 1;
        } else if (b[i] == '#') {
            return fail("tsv-comment");
        } else if (take_row(b + i, (int)(e - i))) {
            return 1;
        }
        i = e + 1;
    }
    if (nname != NROW) return fail("net-count");
    return 0;
}

static int app(char *dst, int cap, int *n, const char *s) {
    int i = 0;
    while (s[i]) {
        if (*n + 1 >= cap) return -1;
        dst[*n] = s[i];
        *n += 1;
        i++;
    }
    dst[*n] = 0;
    return 0;
}

static int app_n(char *dst, int cap, int *n, int d) {
    char s[4];
    int k = 0;
    if (d < 0 || d > 99) return -1;
    if (d >= 10) s[k++] = (char)('0' + d / 10);
    s[k++] = (char)('0' + d % 10);
    s[k] = 0;
    return app(dst, cap, n, s);
}

static int emit_mod(char *dst, int cap) {
    int n = 0, i;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa module netname\n")) return -1;
    if (app(dst, cap, &n, "/* Generated by tools/netrt-gen.cx.\n")) return -1;
    if (app(dst, cap, &n, "   Do not edit by hand. Names are exec/pipeline/gold-stages.tsv, in file order.\n")) return -1;
    if (app(dst, cap, &n, "   The compiler index stays nn_count / nn_at. lexcls and lexword are not here.\n")) return -1;
    if (app(dst, cap, &n, "   A null out-pointer returns 4. An index outside 0..count-1 returns 2.\n")) return -1;
    if (app(dst, cap, &n, "   No libc and no include. */\n")) return -1;
    if (app(dst, cap, &n, "int rnn_count(void) {\n    return ")) return -1;
    if (app_n(dst, cap, &n, nname)) return -1;
    if (app(dst, cap, &n, ";\n}\n")) return -1;
    if (app(dst, cap, &n, "int rnn_at(int index, const char **name) {\n")) return -1;
    if (app(dst, cap, &n, "    if (!name) return 4;\n")) return -1;
    for (i = 0; i < nname; i++) {
        if (app(dst, cap, &n, "    if (index == ")) return -1;
        if (app_n(dst, cap, &n, i)) return -1;
        if (app(dst, cap, &n, ") { *name = \"")) return -1;
        if (app(dst, cap, &n, names[i])) return -1;
        if (app(dst, cap, &n, "\"; return 0; }\n")) return -1;
    }
    if (app(dst, cap, &n, "    return 2;\n}\n")) return -1;
    return n;
}

static int emit_rows(char *dst, int cap, int *n) {
    int i;
    if (app(dst, cap, n, "    if (rnn_count() != ")) return -1;
    if (app_n(dst, cap, n, nname)) return -1;
    if (app(dst, cap, n, ") return 1;\n")) return -1;
    for (i = 0; i < nname; i++) {
        if (app(dst, cap, n, "    if (rnn_at(")) return -1;
        if (app_n(dst, cap, n, i)) return -1;
        if (app(dst, cap, n, ", &name) || !tx_eqz(name, \"")) return -1;
        if (app(dst, cap, n, names[i])) return -1;
        if (app(dst, cap, n, "\")) return 1;\n")) return -1;
    }
    if (app(dst, cap, n, "    if (rnn_at(0, missing) != 4) return 1;\n")) return -1;
    if (app(dst, cap, n, "    if (rnn_at(-1, &name) != 2) return 1;\n")) return -1;
    if (app(dst, cap, n, "    if (rnn_at(")) return -1;
    if (app_n(dst, cap, n, nname)) return -1;
    if (app(dst, cap, n, ", &name) != 2) return 1;\n")) return -1;
    return 0;
}

static int emit_check(char *dst, int cap) {
    int n = 0;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa use compiler.netname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use runtime.netname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use sys.io\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use text.text\n")) return -1;
    if (app(dst, cap, &n, "/* Generated by tools/netrt-gen.cx. Narrow check of runtime net names. */\n")) return -1;
    if (app(dst, cap, &n, "int main(void) {\n")) return -1;
    if (app(dst, cap, &n, "    const char *name;\n")) return -1;
    if (app(dst, cap, &n, "    const char *other;\n")) return -1;
    if (app(dst, cap, &n, "    const char **missing;\n")) return -1;
    if (app(dst, cap, &n, "    int i;\n")) return -1;
    if (app(dst, cap, &n, "    missing = 0;\n")) return -1;
    if (emit_rows(dst, cap, &n)) return -1;
    if (app(dst, cap, &n, "    if (nn_count() != ")) return -1;
    if (app_n(dst, cap, &n, nname)) return -1;
    if (app(dst, cap, &n, ") return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (nn_at(0, missing) != 4) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (nn_at(-1, &name) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (nn_at(")) return -1;
    if (app_n(dst, cap, &n, nname)) return -1;
    if (app(dst, cap, &n, ", &name) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    for (i = 0; i < rnn_count(); i++) {\n")) return -1;
    if (app(dst, cap, &n, "        if (rnn_at(i, &name)) return 1;\n")) return -1;
    if (app(dst, cap, &n, "        if (nn_at(i, &other)) return 1;\n")) return -1;
    if (app(dst, cap, &n, "        if (!tx_eqz(name, other)) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    }\n")) return -1;
    if (app(dst, cap, &n, "    sy_printf(\"CX_NETRT\\tok=")) return -1;
    if (app_n(dst, cap, &n, nname)) return -1;
    if (app(dst, cap, &n, "\\tfailed=0\\n\");\n")) return -1;
    if (app(dst, cap, &n, "    return 0;\n}\n")) return -1;
    return n;
}

static int same_bytes(const char *a, size_t an, const char *b, int bn) {
    int i;
    if (an != (size_t)bn) return 0;
    for (i = 0; i < bn; i++) if (a[i] != b[i]) return 0;
    return 1;
}

static int one_file(int dowrite, const char *path, const char *body, int n) {
    size_t on = 0;
    char *cur;
    if (dowrite) {
        if (cx_write(path, body, (size_t)n)) return fail("write");
        return 0;
    }
    cur = cx_read(path, &on);
    if (!cur) return fail(path);
    if (!same_bytes(cur, on, body, n)) return fail(path);
    return 0;
}

int main(int argc, char **argv) {
    char file[FILECAP], check[CHECKCAP];
    int dowrite, fn, cn;
    if (argc != 2 || (!tx_eqz(argv[1], "--check") && !tx_eqz(argv[1], "--write"))) {
        sy_eprintf("netrt-gen\tusage\t--check|--write\n");
        return 2;
    }
    dowrite = tx_eqz(argv[1], "--write");
    if (parse_stages()) return 1;
    cn = emit_check(check, CHECKCAP);
    if (cn < 0) return fail("emit-check");
    fn = emit_mod(file, FILECAP);
    if (fn < 0) return fail("emit-runtime");
    if (one_file(dowrite, "cx/runtime/netname.cx", file, fn)) return 1;
    if (one_file(dowrite, "tools/check-cx-netrt.cx", check, cn)) return 1;
    if (dowrite) sy_printf("NETRT_GEN\tWROTE\trows=%d\n", nname);
    else sy_printf("NETRT_GEN\tCHECK\trows=%d\n", nname);
    return 0;
}
