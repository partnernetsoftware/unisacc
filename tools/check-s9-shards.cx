  {char *rmv[]={"rm","-rf","--",par,ch,0};run(rmv,root);}
  if(cx_fmt(dl,sizeof dl,"%.9f",(double)as_now()/1e9+50)||setenv("UNISACC_BOUND_DEADLINE_MONO",dl,1))die("deadline-env");unsetenv("UNISACC_IDENTITY_PARENT");
  {char *v[]={aw,"init",root,par,cand,"-",0};np_result ir={0};if(np_run(v,root,0,25,&ir,why,sizeof why)||ir.rc)die("wtshare-parent-init");np_free(&ir);}
