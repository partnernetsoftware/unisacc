  join(p,fixture,"agentwork/ledgerish.tsv");put(p,"neighbor\n");b=snapshot(binary,fixture,&bn);ck(!equal(a,an,b,bn),"ledgerish-file-not-excluded");free(a);a=b;an=bn;join(p,fixture,"agentwork/ledgerish");if(mkdir(p,0700))die("ledgerish-dir");join(p,fixture,"agentwork/ledgerish/fixture.tsv");put(p,"neighbor-shard\n");b=snapshot(binary,fixture,&bn);ck(!equal(a,an,b,bn),"ledgerish-directory-not-excluded");free(a);a=b;an=bn;
  join(p,fixture,"agentwork/items.tsv");put(p,"items-changed\n");b=snapshot(binary,fixture,&bn);ck(!equal(a,an,b,bn),"not-whole-agentwork-excluded");free(a);a=b;an=bn;
  join(p,fixture,"src/input.cx");put(p,"dirty-one\n");b=snapshot(binary,fixture,&bn);ck(!equal(a,an,b,bn),"product-input-change");free(a);a=b;an=bn;
  put(p,"dirty-two\n");b=snapshot(binary,fixture,&bn);ck(!equal(a,an,b,bn),"already-dirty-second-change");diff_check(a,b,"WT_CHANGED\tpaths=1\n?? src/input.cx\n","dirty-second-change-path-once");free(a);a=b;an=bn;
  join(q,fixture,"src/renamed.cx");if(rename(p,q))die("rename");b=snapshot(binary,fixture,&bn);ck(!equal(a,an,b,bn),"rename-detected");
  /* Oracle above checks legacy order byte-for-byte. This checks the path set,
     independent of Git listing untracked paths before tracked ABSENT entries. */
  {size_t n;char *s=difference(a,an,b,bn,&n);const char *header="WT_CHANGED\tpaths=2\n";
   int old_path=0,new_path=0,other=0;size_t at=strlen(header);
   int valid=n>=at&&!memcmp(s,header,at);
   while(valid&&at<n){size_t end=at;while(end<n&&s[end]!='\n')end++;
    if(end==n){valid=0;break;}
    if(end-at==strlen("?? src/input.cx")&&!memcmp(s+at,"?? src/input.cx",end-at))old_path++;
    else if(end-at==strlen("?? src/renamed.cx")&&!memcmp(s+at,"?? src/renamed.cx",end-at))new_path++;
    else other++;at=end+1;
   }
   ck(valid&&old_path==1&&new_path==1&&!other,"real-rename-path-set");free(s);}
  free(a);a=b;an=bn;
  if(unlink(q))die("delete");b=snapshot(binary,fixture,&bn);ck(!equal(a,an,b,bn),"delete-detected");diff_check(a,b,"WT_CHANGED\tpaths=1\n?? src/renamed.cx\n","real-delete-path-once");free(a);a=b;an=bn;
  join(target,tmp,"external-input");put(target,"target-one\n");join(p,fixture,"src/link.cx");if(symlink(target,p))die("symlink");free(a);a=snapshot(binary,fixture,&an);put(target,"target-two\n");b=snapshot(binary,fixture,&bn);ck(!equal(a,an,b,bn),"external-link-target-change");free(a);free(b);
  if(unlink(target))die("link-target-remove");a=snapshot(binary,fixture,&an);ck(strstr(a,"\tDANGLING\n")!=0,"dangling-link-recorded");
  put(target,"target-restored\n");b=snapshot(binary,fixture,&bn);ck(!equal(a,an,b,bn),"dangling-target-appears");free(b);
  if(unlink(target))die("link-target-remove");b=snapshot(binary,fixture,&bn);ck(equal(a,an,b,bn),"link-target-disappears-restores-dangling");free(a);free(b);
  /* S9 wave-level gate (wt-close): one snapshot before the wave, one fresh scan after it. */
  {char before[4400],rec[4400];join(before,tmp,"epoch.before");a=snapshot(binary,fixture,&an);{int fd=open(before,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC,0600);if(fd<0||write(fd,a,an)!=(ssize_t)an||close(fd))die("epoch-before-write");}free(a);
   join(rec,tmp,"wt-epoch-stable");{char *v[]={binary,"wt-close",fixture,before,rec,"slice-0-0","slice-1-1",0};np_result r={0};if(np_run(v,fixture,0,10,&r,why,sizeof why))die("wt-close-transport");size_t n=0;char *s=cx_read(rec,&n);
    ck(r.rc==0&&contains(r.out,r.outn,"WT_EPOCH\tSTABLE\tmoved=0\tscans=1\t")&&s&&contains(s,n,"\nmoved\t0\n")&&contains(s,n,"\nslice\tslice-1-1\n"),"wt-close-unchanged-wave-stable");free(s);np_free(&r);}
   /* A concurrent wave worker edits a tracked file while the wave runs. */
   join(p,fixture,"agentwork/items.tsv");pid_t w=fork();if(w<0)die("wave-worker-fork");if(!w){int fd=open(p,O_WRONLY|O_APPEND|O_CLOEXEC);_exit(fd<0||write(fd,"mid-wave\n",9)!=9||close(fd)?1:0);}{int st;if(waitpid(w,&st,0)!=w||!WIFEXITED(st)||WEXITSTATUS(st))die("wave-worker");}
   join(rec,tmp,"wt-epoch-moved");{char *v[]={binary,"wt-close",fixture,before,rec,"slice-0-0",0};np_result r={0};if(np_run(v,fixture,0,10,&r,why,sizeof why))die("wt-close-transport");size_t n=0;char *s=cx_read(rec,&n);
    ck(r.rc==2&&contains(r.out,r.outn,"WT_EPOCH\tCHANGED\tmoved=1\t")&&s&&contains(s,n,"\nmoved\t1\n")&&contains(s,n,"\npath\t?? agentwork/items.tsv\n"),"wt-close-tracked-edit-during-wave-refuses");free(s);np_free(&r);}
   {char *v[]={binary,"wt-close",fixture,before,rec,"slice-0-0",0};np_result r={0};if(np_run(v,fixture,0,10,&r,why,sizeof why))die("wt-close-transport");ck(r.rc==2&&contains(r.out,r.outn,"REFUSE\texclusive-write"),"wt-close-record-never-reused");np_free(&r);}}
 }
 if(!failures){char *clean[]={"rm","-rf","--",tmp,0};if(run(clean,root))die("private-fixture-clean");}else fprintf(stderr,"fixture retained: %s\n",tmp);
 printf("CHECK_S9_SHARDS\tphase=%s\tfailed=%d\n",argv[2],failures);return failures?1:0;
}
