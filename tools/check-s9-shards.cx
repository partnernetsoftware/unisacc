/* Separate original-budget control phases:
 * check-s9-shards.cx ROOT inputs|schedule
 * inputs compiles and exercises the real all-waves scan and diff input gate on
 * a private Git fixture, plus saved-snapshot set controls through inputs-diff.
 * inputs also drives the S9 wave-level gate (all-waves wt-close): unchanged -> STABLE, a tracked
 * edit made by a concurrent worker during the wave -> rc 2 CHANGED, records are exclusive.
 * schedule compiles and invokes the real driver's planning/liveness controls, the epoch-record
 * consumer controls, and a real child wave in --shared-wt mode that must take zero scans.
 * Neither fixture supplies a product PASS or qualification receipt.
 * Standalone evidence (outside the unchanged batch budget):
 * check-s9-shards.cx ROOT equivalence BEFORE AFTER NATIVE_ALL_WAVES
 * reads raw saved snapshots and compares the legacy oracle with the native gate.
 */
#pragma unisa use cxlib.allsession
#pragma unisa use cxlib.netpack
#pragma unisa use mem.bytes
static char root[4096],why[1700],diff_binary[4400],diff_a[4400],diff_b[4400];static int failures;
static void die(const char *s){fprintf(stderr,"check-s9: %s %s\n",s,why);exit(2);}
static void join(char *p,const char *a,const char *b){if(as_join(p,4400,a,b))die("path");}
static void ck(int yes,const char *name){printf("S9_CHECK\t%s\t%s\n",name,yes?"PASS":"FAIL");if(!yes)failures++;}
static int run(char **v,const char *cwd){np_result r={0};if(np_run(v,cwd,0,30,&r,why,sizeof why))die("transport");if(r.errn)fwrite(r.err,1,r.errn,stderr);int rc=r.rc;np_free(&r);return rc;}
static void put(const char *p,const char *s){int fd=open(p,O_WRONLY|O_CREAT|O_TRUNC|O_CLOEXEC,0600);if(fd<0||write(fd,s,strlen(s))!=(ssize_t)strlen(s)||close(fd))die("fixture-write");}
static char *snapshot(const char *binary,const char *fixture,size_t *n){char *v[]={(char *)binary,"inputs",(char *)fixture,0};np_result r={0};if(np_run(v,fixture,0,10,&r,why,sizeof why)||r.rc)die("snapshot");char *s=malloc(r.outn+1);if(!s)die("allocation");if(mm_copy(s,r.outn+1,r.out,r.outn))die("copy-bound");s[r.outn]=0;*n=r.outn;np_free(&r);return s;}
/* Frozen legacy oracle: deliberately quadratic, used only by this check. */
static int oracle_has(const char *s,size_t n,const char *line,size_t len){
 size_t at=0;while(at<n){size_t e=at;while(e<n&&s[e]!='\n')e++;
  if(e-at==len&&!memcmp(s+at,line,len))return 1;at=e+1;}return 0;
}
static int oracle_diff(const char *a,size_t an,const char *b,size_t bn,np_buf *out){
 int moved=0;for(int pass=0;pass<2;pass++){
  const char *s=pass?a:b,*other=pass?b:a;size_t n=pass?an:bn,on=pass?bn:an,at=0;
  while(at<n){size_t e=at,p=at;while(e<n&&s[e]!='\n')e++;
   if(!oracle_has(other,on,s+at,e-at)){while(p<e&&s[p]!='\t')p++;
    int already=0;size_t q=0;while(q<out->n){size_t t=q;while(t<out->n&&out->p[t]!='\n')t++;
     if(t-q==p-at&&!memcmp(out->p+q,s+at,p-at))already=1;q=t+1;}
    if(!already){np_put(out,s+at,p-at);np_puts(out,"\n");moved++;}}
   at=e+1;}}
 return moved;
}
/* Every fixture comparison invokes the native wave gate, not a second diff. */
static char *difference_seed(const char *a,size_t an,const char *b,size_t bn,const char *seed,size_t *n){
 const char *paths[]={diff_a,diff_b};const char *data[]={a,b};size_t sizes[]={an,bn};
 for(int i=0;i<2;i++){int fd=open(paths[i],O_WRONLY|O_CREAT|O_TRUNC|O_CLOEXEC,0600);
  if(fd<0||write(fd,data[i],sizes[i])!=(ssize_t)sizes[i]||close(fd))die("diff-fixture-write");}
 char *v[]={diff_binary,"inputs-diff",diff_a,diff_b,(char *)seed,0};np_result r={0};
 long long native_start=as_now();if(np_run(v,root,0,10,&r,why,sizeof why)||r.rc)die("diff-consumer");long long native_ns=as_now()-native_start;
 np_buf old={0},expected={0};if(seed)np_puts(&old,seed);long long oracle_start=as_now();int moved=oracle_diff(a,an,b,bn,&old);long long oracle_ns=as_now()-oracle_start;
 np_puts(&expected,"WT_CHANGED\tpaths=");np_putll(&expected,moved);np_puts(&expected,"\n");if(old.n)np_put(&expected,old.p,old.n);
 int identical=r.outn==expected.n&&!memcmp(r.out,expected.p,expected.n);char oldsha[65],newsha[65];
 cx_sha256_hex(expected.p,expected.n,oldsha);cx_sha256_hex(r.out,r.outn,newsha);
 printf("WT_EQUIVALENCE\tbefore_bytes=%zu\tafter_bytes=%zu\told_moved=%d\tbyte_identical=%d\told_sha256=%s\tnew_sha256=%s\n",an,bn,moved,identical,oldsha,newsha);
 printf("WT_EQUIVALENCE_TIME\tnative_process_ns=%lld\tlegacy_diff_ns=%lld\n",native_ns,oracle_ns);
 ck(identical,"legacy-oracle-byte-identical");free(old.p);free(expected.p);
 if(r.outn==(size_t)-1)die("diff-output-size");char *s=malloc(r.outn+1);if(!s)die("allocation");
 if(mm_copy(s,r.outn+1,r.out,r.outn))die("copy-bound");s[r.outn]=0;*n=r.outn;np_free(&r);return s;
}
static char *difference(const char *a,size_t an,const char *b,size_t bn,size_t *n){return difference_seed(a,an,b,bn,0,n);}
static int equal(const char *a,size_t an,const char *b,size_t bn){
 size_t n;char *s=difference(a,an,b,bn,&n);const char *zero="WT_CHANGED\tpaths=0\n";
 int same=n==strlen(zero)&&!memcmp(s,zero,n);free(s);return same;
}
static void diff_check(const char *a,const char *b,const char *expected,const char *name){
 size_t n;char *s=difference(a,strlen(a),b,strlen(b),&n);
 ck(n==strlen(expected)&&!memcmp(s,expected,n),name);free(s);
}
static int contains(const char *s,size_t n,const char *needle){size_t k=strlen(needle);for(size_t i=0;i+k<=n;i++)if(!memcmp(s+i,needle,k))return 1;return 0;}
int main(int argc,char **argv){
 if((argc!=3&&argc!=6)||!realpath(argv[1],root)||strcmp(root,argv[1])||(strcmp(argv[2],"inputs")&&strcmp(argv[2],"identity")&&strcmp(argv[2],"identity-sid")&&strcmp(argv[2],"schedule")&&strcmp(argv[2],"equivalence"))||(!strcmp(argv[2],"equivalence")?argc!=6:argc!=3))die("usage: ROOT inputs|schedule|equivalence BEFORE AFTER EXECUTOR");
 char tmp[]="/tmp/check-s9-XXXXXX";if(!mkdtemp(tmp))die("temp");char product[4400],source[4400],binary[4400];
 if(!strcmp(argv[2],"equivalence")){if(mm_copy(binary,sizeof binary,argv[5],strlen(argv[5])+1))die("executor-path");}
 else{join(product,root,"unisacc.com");join(source,root,!strcmp(argv[2],"schedule")?"tools/s9-shards.cx":"tools/all-waves.cx");join(binary,tmp,"native");char *compile[]={"sh",product,source,"-o",binary,0};
  /* schedule also needs the real wave executor for the shared-worktree control; compile it alongside. */
  pid_t aw=-1;if(!strcmp(argv[2],"schedule")){char aws[4400],awb[4400];join(aws,root,"tools/all-waves.cx");join(awb,tmp,"all-waves");aw=fork();if(aw<0)die("compile-fork");if(!aw){char *c[]={"sh",product,aws,"-o",awb,0};_exit(run(c,root)?1:0);}}
  if(run(compile,root))die("compile");if(aw>0){int st;if(waitpid(aw,&st,0)!=aw||!WIFEXITED(st)||WEXITSTATUS(st))die("compile-all-waves");}}
 /* inputs keeps the same per-process deadline the combined phase used; the identity-parent controls are their own phase (own 55s budget). */
 if(!strcmp(argv[2],"inputs")){char dl[80];long long t=as_now();if(t<0||cx_fmt(dl,sizeof dl,"%.9f",(double)t/1e9+50))die("deadline");if(setenv("UNISACC_BOUND_DEADLINE_MONO",dl,1))die("deadline-env");}
 int sidm=!strcmp(argv[2],"identity-sid");   /* identity: missing/corrupt parent refusals; identity-sid: live-parent SID-change refusal (init x2 + wave) */
 if(!strcmp(argv[2],"identity")||sidm){
  char dl[80],sess[4400],miss[4400],bad[4400],empty[4400],cand[4400],wire[4400];
  /* All identity-parent controls (incl. the src/runcache.cx touch) run in a private fixture clone of ROOT, never in ROOT itself. */
  char saved_root[4096],fxr[4400],fxc[4400],fxo[4400],fxp[4400];
  join(fxr,tmp,"fxroot");join(fxc,root,"unisacc.com");join(fxp,fxr,"unisacc.com");join(fxo,fxr,"out");
  {char *g[]={"git","clone","-q","--shared",root,fxr,0};if(run(g,tmp))die("fixture-clone");}
  {char *c[]={"cp",fxc,fxp,0};if(run(c,tmp))die("fixture-product");}
  if(mkdir(fxo,0700)&&errno!=EEXIST)die("fixture-out");
  if(mm_copy(saved_root,sizeof saved_root,root,strlen(root)+1)||mm_copy(root,sizeof root,fxr,strlen(fxr)+1))die("fixture-root");
  long long t=as_now();if(t<0||cx_fmt(dl,sizeof dl,"%.9f",(double)t/1e9+50))die("deadline");
  if(setenv("UNISACC_BOUND_DEADLINE_MONO",dl,1))die("deadline-env");
  join(cand,root,"unisacc.com");join(sess,root,"out");
  join(miss,sess,"check-s9-ident-miss");join(bad,sess,"check-s9-ident-bad");join(empty,sess,"check-s9-ident-empty");
  if(!sidm){
  if(setenv("UNISACC_IDENTITY_PARENT","/no/such/session",1))die("parent-env");
  {char *v[]={binary,"init",root,miss,cand,"-",0};np_result r={0};if(np_run(v,root,0,20,&r,why,sizeof why))die("miss-transport");ck(r.rc==2&&contains(r.err,r.errn,"identity-parent"),"identity-parent-missing-refuse");np_free(&r);}
  if(mkdir(empty,0700)&&errno!=EEXIST)die("empty-dir");join(wire,empty,"session.tsv");put(wire,"not-a-manifest\n");
  if(setenv("UNISACC_IDENTITY_PARENT",empty,1))die("parent-env");
  {char *v[]={binary,"init",root,bad,cand,"-",0};np_result r={0};if(np_run(v,root,0,20,&r,why,sizeof why))die("bad-transport");ck(r.rc==2&&contains(r.err,r.errn,"identity-parent"),"identity-parent-corrupt-refuse");np_free(&r);}
  unsetenv("UNISACC_IDENTITY_PARENT");
  }
  if(sidm){char par[4400],ch[4400],srcf[4400];join(par,sess,"check-s9-ident-live-parent");join(ch,sess,"ident-sid-child");join(srcf,root,"src/runcache.cx");
   {char *rmv[]={"rm","-rf","--",par,ch,0};run(rmv,root);}
   unsetenv("UNISACC_IDENTITY_PARENT");
   {char *v[]={binary,"init",root,par,cand,"-",0};np_result r={0};int pok=!np_run(v,root,0,25,&r,why,sizeof why)&&r.rc==0;np_free(&r);
    if(!pok)ck(0,"identity-parent-sid-changed-refuse");
    else if(setenv("UNISACC_IDENTITY_PARENT",par,1))die("parent-env");
    else{
     char *c[]={binary,"init",root,ch,cand,"-",0};np_result cr={0};int cok=!np_run(c,root,0,20,&cr,why,sizeof why)&&cr.rc==0;np_free(&cr);
     unsetenv("UNISACC_IDENTITY_PARENT");
     if(!cok)ck(0,"identity-parent-sid-changed-refuse");
     else{int fd=open(srcf,O_WRONLY|O_APPEND|O_CLOEXEC);if(fd<0||write(fd,"\n",1)!=1||close(fd))die("sid-touch");
      {char *w[]={binary,"wave",root,ch,"--heavy","smoke",0};np_result wr={0};if(np_run(w,root,0,20,&wr,why,sizeof why))die("wave-transport");ck(wr.rc==2&&(contains(wr.err,wr.errn,"session-sid-changed")||contains(wr.out,wr.outn,"session-sid-changed")),"identity-parent-sid-changed-refuse");np_free(&wr);}
      {char *g[]={"git","-C",root,"checkout","--","src/runcache.cx",0};run(g,root);}
     }
    }
   }
  }
  if(mm_copy(root,sizeof root,saved_root,strlen(saved_root)+1))die("fixture-restore");
  if(!failures){char *clean[]={"rm","-rf","--",tmp,0};if(run(clean,root))die("private-fixture-clean");}else fprintf(stderr,"fixture retained: %s\n",tmp);
  printf("CHECK_S9_SHARDS\tphase=%s\tfailed=%d\n",argv[2],failures);return failures?1:0;
 }
 if(mm_copy(diff_binary,sizeof diff_binary,binary,strlen(binary)+1))die("copy-bound");join(diff_a,tmp,"before.snapshot");join(diff_b,tmp,"after.snapshot");
 if(!strcmp(argv[2],"equivalence")){size_t an,bn,n;char *a=cx_read(argv[3],&an),*b=cx_read(argv[4],&bn);if(!a||!b)die("saved-snapshot-read");char *s=difference(a,an,b,bn,&n);if(n)fwrite(s,1,n,stdout);free(s);free(a);free(b);}
 else if(!strcmp(argv[2],"schedule")){char *v[]={binary,"controls",0};np_result r={0};if(np_run(v,root,0,30,&r,why,sizeof why))die("controls-transport");if(r.outn)fwrite(r.out,1,r.outn,stdout);if(r.errn)fwrite(r.err,1,r.errn,stderr);ck(r.rc==0,"real-planner-global-writer-resume-pid-identity");ck(r.rc==0&&contains(r.out,r.outn,"bounded-backfill-fixed-quota-drain-reserved-writer-first"),"real-planner-bounded-reservation-drain");ck(r.rc==0&&contains(r.out,r.outn,"backfill-cross-tier-fences-global-exclusive-no-duplicates-no-loss"),"real-planner-backfill-global-contract");ck(r.rc==0&&contains(r.out,r.outn,"completed-receipt-after-55s-retains-pass"),"completed-receipt-after-original-wave-window");ck(r.rc==0&&contains(r.out,r.outn,"timeout-unsealed-missing-failed-receipts-never-pass"),"timeout-and-incomplete-receipt-consumer-refusal");ck(r.rc==0&&contains(r.out,r.outn,"wt-epoch-consumer-stable-moved-unlisted-tampered-foreign-missing\tchecked=1"),"wt-epoch-consumer-refuses-moved-missing-unlisted");
  /* Sharded aggregate merge with retry slices: original and retry slice in different parts. */
  ck(r.rc==0&&contains(r.out,r.outn,"agg-merge-retry-cross-part-accepted-retry-state-effective\tchecked=1"),"agg-merge-retry-cross-part-accepted-uses-retry-state");
  ck(r.rc==0&&contains(r.out,r.outn,"agg-merge-retry-of-fail-stays-fail\tchecked=1"),"agg-merge-retry-never-hides-original-fail");
  ck(r.rc==0&&contains(r.out,r.outn,"agg-merge-forged-state-from-non-owner-part-refused\tchecked=1"),"agg-merge-forged-state-wrong-part-refused");
  ck(r.rc==0&&contains(r.out,r.outn,"agg-merge-duplicate-state-refused\tchecked=1"),"agg-merge-duplicate-state-refused");
  ck(r.rc==0&&contains(r.out,r.outn,"agg-merge-missing-retry-state-refused\tchecked=1"),"agg-merge-missing-state-refused");
  ck(r.rc==0&&contains(r.out,r.outn,"agg-merge-uncovered-retry-slice-refused\tchecked=1"),"agg-merge-uncovered-slice-refused");
  ck(r.rc==0&&contains(r.out,r.outn,"agg-merge-nonce-mismatch-refused\tchecked=1"),"agg-merge-nonce-mismatch-refused");np_free(&r);
