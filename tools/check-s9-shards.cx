  {char *v[]={aw,"wave",root,ch,"--s9-supervised","--shared-wt",epoch,"--heavy","s9-shards-schedule",0};np_result wr={0};if(np_run(v,root,0,25,&wr,why,sizeof why))die("wave-transport");if(wr.outn)fwrite(wr.out,1,wr.outn,stdout);
