/* tools/s9-nightly-run.cx -- s9 夜跑薄入口(给 systemd timer 用):负载检查、专用克隆同步、调 s9-nightly、留证据。
 *
 *   sh ./unisacc.com tools/s9-nightly-run.cx -- --clone DIR --evidence DIR --tier commit|daily [--max-steps N] [--load-max L] [--fake BIN]
 *
 * 退出码: 0 通过; 1 s9-nightly 失败; 2 拒绝/用法; 4 负载超阈值(SKIPPED_LOAD)。
 * DIR 必须是专用仓外克隆(拒绝共享检出),并自带 unisacc.com。--fake 只给检查用。 */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.die

static char why[512];
static void die(const char *a, const char *b) { tool_die("s9-nightly-run", a, b, 2); }
static int run(char **v, const char *cwd, int sec, char *out, int cap) {
    np_result r = {0};
    int rc;
    if (np_run(v, cwd, 0, sec, &r, why, sizeof why)) { np_free(&r); return 99; }
    rc = r.rc;
    if (out && cap > 0) {
        size_t n = r.outn < (size_t)(cap - 1) ? r.outn : (size_t)(cap - 1);
        if (r.out && n && mm_copy(out, cap, r.out, (long)n)) die("copy", 0);
        out[n] = 0;
    }
    np_free(&r);
    return rc;
}
static void trim(char *s) { size_t n = strlen(s); while (n && (s[n - 1] == '\n' || s[n - 1] == '\r' || s[n - 1] == ' ')) s[--n] = 0; }

int main(int argc, char **argv) {
    const char *clone = 0, *evid = 0, *tier = 0, *fake = 0;
    int max_steps = 8, i;
    double load_max = 12.0, load = 0;
    char dir[4096], ev[4096], com[4400], tool[4400], runp[4400], sha[128], buf[8000], status[64] = "UNKNOWN";
    char report[4400] = "-", copy[4400], idx[4400], date[32], steps[16], datebuf[32];
    char *v[24];
    long t0 = sy_now_ms(), ws;
    size_t n;
    char *la;
    int rc, k = 0;
    for (i = 1; i < argc; i++) {
        if (!strcmp(argv[i], "--clone") && i + 1 < argc) clone = argv[++i];
        else if (!strcmp(argv[i], "--evidence") && i + 1 < argc) evid = argv[++i];
        else if (!strcmp(argv[i], "--tier") && i + 1 < argc) tier = argv[++i];
        else if (!strcmp(argv[i], "--max-steps") && i + 1 < argc) max_steps = atoi(argv[++i]);
        else if (!strcmp(argv[i], "--load-max") && i + 1 < argc) load_max = atof(argv[++i]);
        else if (!strcmp(argv[i], "--fake") && i + 1 < argc) fake = argv[++i];
        else die("unknown", argv[i]);
    }
    if (!clone || !evid || !tier) die("usage", "--clone DIR --evidence DIR --tier commit|daily");
    if (strcmp(tier, "commit") && strcmp(tier, "daily")) die("tier", tier);
    if (max_steps < 1 || max_steps > 64) die("max-steps", 0);
    /* (1) 负载 */
    la = cx_read("/proc/loadavg", &n);
    if (!la || sscanf(la, "%lf", &load) != 1) die("loadavg", 0);
    free(la);
    if (load > load_max) { printf("S9_NIGHTLY_RUN status=SKIPPED_LOAD load=%.2f max=%.2f\n", load, load_max); return 4; }
    /* (2) 克隆校验与同步 */
    if (sy_realpath(clone, dir, sizeof dir) < 0) die("clone-missing", clone);
    {
        /* 只在显式标记为夜跑专用的克隆里 fetch/reset;共享检出没有此标记 */
        char mark[4400];
        if (cx_fmt(mark, sizeof mark, "%s/.s9-nightly-clone", dir)) die("path", 0);
        if (!sy_exists(mark)) die("REFUSED not-nightly-clone (missing .s9-nightly-clone)", dir);
    }
    if (cx_fmt(com, sizeof com, "%s/unisacc" ".com", dir)) die("path", 0);
    if (!sy_exists(com)) { printf("S9_NIGHTLY_RUN status=REFUSED reason=no-root\n"); return 2; }
    if (cx_fmt(tool, sizeof tool, "%s/tools/s9-nightly.cx", dir)) die("path", 0);
    {
        char *f[] = {"git", "-C", dir, "fetch", "-q", "origin", 0};
        char *r[] = {"git", "-C", dir, "reset", "-q", "--hard", "origin/main", 0};
        char *h[] = {"git", "-C", dir, "rev-parse", "HEAD", 0};
        if (run(f, dir, 120, buf, sizeof buf)) die("git-fetch", why);
        if (run(r, dir, 60, buf, sizeof buf)) die("git-reset", buf);
        if (run(h, dir, 10, sha, sizeof sha)) die("git-rev-parse", 0);
        trim(sha);
    }
    if (!sy_exists(tool)) { printf("S9_NIGHTLY_RUN status=REFUSED reason=no-tool commit=%s\n", sha); return 2; }
    /* (3) 调 s9-nightly */
    ws = sy_wall_s();
    if (ws <= 86400 || sy_local_fmt(date, sizeof date, "%Y-%m-%d", ws) != 10) die("date", "wall clock unusable");
    /* s9 init requires a fresh, absent run directory (session-must-be-absent): one per invocation, never pre-created */
    if (cx_fmt(runp, sizeof runp, "%s/out/s9-nightly-run-%s-%ld", dir, date, ws)) die("path", 0);
    { char o[4400]; if (cx_fmt(o, sizeof o, "%s/out", dir)) die("path", 0); sy_mkdir(o, 0755); }
    if (sy_exists(runp)) die("run-dir-exists", runp);
    (void)datebuf;
    cx_fmt(steps, sizeof steps, "%d", max_steps);
    v[k++] = "sh"; v[k++] = com; v[k++] = tool; v[k++] = "--"; v[k++] = dir; v[k++] = runp;
    v[k++] = "--tier"; v[k++] = (char *)tier; v[k++] = "--date"; v[k++] = date;
    v[k++] = "--max-steps"; v[k++] = steps;
    if (fake) { v[k++] = "--fake"; v[k++] = (char *)fake; }
    v[k] = 0;
    rc = run(v, dir, 1700, buf, sizeof buf);
    printf("%s", buf);
    {
        const char *s = strstr(buf, "status=");
        if (s) { size_t j = 0; s += 7; while (s[j] && s[j] != '\t' && s[j] != '\n' && j + 1 < sizeof status) { status[j] = s[j]; j++; } status[j] = 0; }
        else if (rc == 99) cx_fmt(status, sizeof status, "TIMEOUT");
        s = strstr(buf, "report=");
        if (s) { size_t j = 0; s += 7; while (s[j] && s[j] != '\t' && s[j] != '\n' && j + 1 < sizeof report) { report[j] = s[j]; j++; } report[j] = 0; }
    }
    /* (4) 证据 */
    if (cx_fmt(ev, sizeof ev, "%s", evid)) die("path", 0);
    sy_mkdir(ev, 0755);
    if (strcmp(report, "-") && sy_exists(report)) {
        if (cx_fmt(copy, sizeof copy, "%s/s9-nightly-%s-%s-%.12s.md", ev, date, tier, sha)) die("path", 0);
        if (sy_copy(report, copy, 0644) < 0) die("copy-report", report);
    } else cx_fmt(copy, sizeof copy, "-");
    if (cx_fmt(idx, sizeof idx, "%s/index.tsv", ev)) die("path", 0);
    {
        FILE *fp = fopen(idx, "a");
        if (!fp) die("open-index", idx);
        fprintf(fp, "%s\t%s\t%s\t%s\t%s\t%ld\n", date, sha, tier, status, copy, sy_now_ms() - t0);
        fclose(fp);
    }
    printf("S9_NIGHTLY_RUN status=%s commit=%s index=%s\n", status, sha, idx);
    return rc == 0 ? 0 : 1;
}
