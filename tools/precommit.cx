/* tools/precommit.cx -- the commit gate: a commit may not take a .cx file over any ratchet.
 *
 *   sh ./unisacc.com tools/precommit.cx            (run by .git/hooks/pre-commit, a three-line sh entry: exec sh ./unisacc.com tools/precommit.cx)
 *
 * Lists the .cx paths staged in the index being committed (git diff --cached, which follows GIT_INDEX_FILE,
 * so tools/commit-own.cx's private index is gated too), runs tools/ratchets.cx once, and refuses the commit
 * (exit 1) when any offending ratchet row names one of those paths: a new #include, a new direct libc/POSIX
 * call, a new platform #if or raw syscall outside L0, a new unbounded call -- the drift back to traditional C.
 * Rows about files not in this commit (other agents' work) do not block it.  No staged .cx: exit 0 at once.
 * Prints PRECOMMIT<TAB>staged_cx=N<TAB>blocked=B. */
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use sys.env
#pragma unisa use sys.time

static int slurp_okrc = 0;   /* 允许的最大退出码:0=仅成功;ratchets.cx 用 1 表示「跑完了但有红行」 */
static char *slurp(char **argv, long *n) {
    int ofd, pid; long cap = 1 << 16, r; char *b = mm_alloc(cap);
    *n = 0;
    if (!b) return 0;
    pid = sy_spawn_pipe(argv, 0, 0, &ofd, 0);
    if (pid < 0) return 0;
    while ((r = sy_read(ofd, b + *n, cap - 1 - *n)) > 0) {
        *n += r;
        if (*n + 1 >= cap) { char *g = mm_grow(b, cap * 2); if (!g) return 0; b = g; cap *= 2; }
    }
    { int ex = 0, code = 0, sig = 0;
      sy_close(ofd);
      if (sy_wait_status(pid, 0, &ex, &code, &sig) != pid || !ex || code < 0 || code > slurp_okrc) { mm_free(b); *n = 0; return 0; }
    }
    b[*n] = 0;
    return b;
}

static int registered(const char *b, long n, const char *check) {
    long at = 0, cl = tx_len(check, 4600);
    while (b && at < n) {
        long e = tx_chr(b + at, n - at, '\n'), l = e < 0 ? n - at : e, pos = 0, field = 0;
        int implemented = 0, found = 0;
        if (l > 0 && b[at] != '#') while (pos <= l) {
            long t = tx_chr(b + at + pos, l - pos, '\t'), len = t < 0 ? l - pos : t;
            if (field == 1) implemented = tx_same(b + at + pos, len, "IMPLEMENTED", 11);
            if (field == 3 || field == 8) found |= tx_same(b + at + pos, len, check, cl);
            field++; if (t < 0) break; pos += len + 1;
        }
        if (implemented && found && (field == 13 || field == 14)) return 1;
        at += l + 1;
    }
    return 0;
}

/* Gate actual support for newly indexed tools. Check tools are leaves;
 * modules can use a root tools/check-NAME.cx or adjacent check. */
static int new_tools(void) {
    char *av[] = {"git", "diff", "--cached", "--name-only", "--diff-filter=A", "-z", "--", "tools", 0};
    char *bv[] = {"git", "show", ":tests/batches.tsv", 0};
    long n, bn, at = 0; int blocked = 0;
    char *names = slurp(av, &n), *batches = slurp(bv, &bn);
    if (!names) return 1;
    while (at < n) {
        const char *p = names + at; long l = tx_len(p, n - at), slash = 0, j, cn;
        char check[4600], spec[4600]; char *blob; char *v[] = {"git", "show", spec, 0};
        at += l + 1;
        if (!tx_suffix(p, l, ".cx", 3)) continue;
        for (j = 0; j < l; j++) if (p[j] == '/') slash = j + 1;
        if (tx_prefix(p + slash, l - slash, "check-", 6)) { if(!registered(batches,bn,p)){sy_eprintf("precommit: new check missing batch registration: %s\n",p);blocked++;} continue; }
        { char *lv[] = {"git", "ls-files", "-s", "--", (char *)p, 0}; long ln; char *ls = slurp(lv, &ln);
          if (ls && tx_prefix(ls, ln, "120000", 6)) { if(!registered(batches,bn,p)){sy_eprintf("precommit: new symlink alias requires batch registration: %s\n",p);blocked++;} mm_free(ls); continue; } mm_free(ls); }
        if (cx_fmt(check, sizeof check, "tools/check-%s", p + slash) || cx_fmt(spec, sizeof spec, ":%s", check)) return 1;
        blob = slurp(v, &cn);
        if (!blob || cn == 0) {
            mm_free(blob);
            if (cx_fmt(check, sizeof check, "%.*scheck-%s", (int)slash, p, p + slash) || cx_fmt(spec, sizeof spec, ":%s", check)) return 1;
            blob = slurp(v, &cn);
        }
        if (!blob || cn == 0) { sy_eprintf("precommit: new tool %s missing check-*.cx\n", p); blocked++; }
        else if (!registered(batches, bn, check)) {
            sy_eprintf("precommit: new tool %s check missing batch registration: %s\n", p, check); blocked++;
        }
        mm_free(blob);
    }
    mm_free(names); mm_free(batches); return blocked;
}


/* 冻结窗口闸(fable 咨询 2026-11-08):agentwork/freeze.tsv 存在且未过期时,staged 路径命中冻结前缀、
 * 且 UNISACC_INTEGRATOR 不等于 owner 的提交被拒。列:candidate_sid base_commit owner deadline_epoch_s paths(空格分隔)。
 * 冻结是有界事件:deadline 过期即不拦;tools/ tests/ plans/ agentwork/ 不在 paths 内,永不受影响。 */
static int freeze_gate(void) {
    size_t zn = 0; char *z = (char *)cx_read("agentwork/freeze.tsv", &zn), *f[6]; long fn = 0, now, dl = 0, i;
    char *dv[] = {"git", "diff", "--cached", "--name-only", "--diff-filter=ACMRD", "-z", 0};
    char *names, line[1200], *p; int blocked = 0, nf = 0; const char *who;
    if (!z) return 0;                                   /* 无标记文件=无冻结(ENOENT) */
    for (p = z; *p; ) {                                  /* 取第一条非注释行 */
        char *e = p; while (*e && *e != '\n') e++;
        if (*p != '#' && e > p && (size_t)(e - p) < sizeof line) { mm_copy(line, sizeof line, p, (size_t)(e - p)); line[e - p] = 0; break; }
        p = *e ? e + 1 : e; line[0] = 0;
    }
    if (!line[0]) return 0;
    f[nf++] = line;
    for (p = line; *p && nf < 6; p++) if (*p == '\t') { *p = 0; f[nf++] = p + 1; }
    if (nf != 5) { sy_eprintf("precommit: freeze.tsv malformed (need 5 columns)\n"); return 1; }
    for (i = 0; f[3][i] >= '0' && f[3][i] <= '9'; i++) dl = dl * 10 + (f[3][i] - '0');
    now = sy_wall_s();   /* 墙钟秒;sy_now_ms 是单调钟,不能与 epoch 截止时间比 */
    if (i == 0 || now >= dl) return 0;                   /* 过期即失效,不死锁 */
    who = sy_env("UNISACC_INTEGRATOR");
    if (who && tx_eqz(who, f[2])) return 0;
    names = slurp(dv, &fn); if (!names) return 0;
    for (long at = 0; at < fn; ) {
        long nl = tx_len(names + at, fn - at); char *q;
        if (nl <= 0) break;
        for (q = f[4]; *q; ) {
            char *s = q, *t; long pl;
            while (*q && *q != ' ') q++;
            pl = q - s; t = s; (void)t;
            if (pl > 0 && nl > pl && names[at + pl] == '/' && tx_prefix(names + at, nl, s, pl)) {
                sy_eprintf("precommit: 冻结中(candidate %s,至 epoch %s):产品输入 %.*s 经集成者 patch 提交\n", f[0], f[3], (int)nl, names + at);
                blocked++; break;
            }
            while (*q == ' ') q++;
        }
        at += nl + 1;
    }
    mm_free(names);
    return blocked;
}

int main(void) {
    long sn, rn, at; int staged = 0, blocked = 0;
    char *gv[] = {"git", "diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z", "--", "*.cx", 0};
    char *rv[] = {"sh", "./unisacc.com", "tools/ratchets.cx", 0};
    char *fv[] = {"git", "diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z", "--", "include", "exec/facts", 0};
    char *fgv[] = {"sh", "./unisacc.com", "tools/facts-gen.cx", "--", "--check", ".", "pp-autoinc-gen", 0};
    char *mv[] = {"git", "diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z", "--", "tests/coverage.tsv", "tests/batches.tsv", 0};
    char *lv[] = {"sh", "./unisacc.com", "tests/run.cx", "--", "--list", 0};
    char *names = slurp(gv, &sn), *rows;
    if (!names) { sy_eprintf("precommit: git diff --cached failed\n"); return 1; }
    for (at = 0; at < sn; ) { long l = tx_len(names + at, sn - at); if (l <= 0) break; staged++; at += l + 1; }
    { long a2;
      for (a2 = 0; a2 < sn; ) {
          long nl = tx_len(names + a2, sn - a2); if (nl <= 0) break;
          if (nl >= 3 && tx_same(names + a2 + nl - 3, 3, ".cx", 3)) {
              char spec[4410]; long j, bn, e; char *blob; char *sv[4];
              if (nl < 4398) {
                  spec[0] = ':'; for (j = 0; j < nl; j++) spec[j + 1] = names[a2 + j]; spec[nl + 1] = 0;
                  sv[0] = "git"; sv[1] = "show"; sv[2] = spec; sv[3] = 0;
                  blob = slurp(sv, &bn);
                  if (blob && bn >= 2 && blob[0] == '#' && blob[1] == '!') {
                      e = 0; while (e < bn && blob[e] != '\n') e++;
                      if (tx_find(blob, e, "bash", 4) >= 0 || tx_find(blob, e, "/sh", 3) >= 0 ||
                          tx_find(blob, e, "zsh", 3) >= 0 || tx_find(blob, e, "python", 6) >= 0 ||
                          tx_find(blob, e, "perl", 4) >= 0 || tx_find(blob, e, "node", 4) >= 0 ||
                          tx_find(blob, e, "bun", 3) >= 0) {
                          sy_eprintf("precommit: %.*s: .cx 只放 cx 源码,shell 薄入口用 .sh\n", (int)nl, names + a2);
                          blocked++;
                      }
                  }
              }
          }
          a2 += nl + 1;
      }
    }
    { long msn; char *mnames = slurp(mv, &msn);
      if (!mnames) { sy_eprintf("precommit: git diff --cached (metadata) failed\n"); return 1; }
      if (msn > 0) {
          char *lout; long ln;
          lout = slurp(lv, &ln);
          if (!lout) { sy_eprintf("precommit: tests/run.cx --list did not run\n"); return 1; }
          if (tx_find(lout, ln, "metadata_valid=1", 16) < 0) {
              long at2 = 0;
              sy_eprintf("precommit: tests/run.cx --list metadata_valid!=1\n");
              while (at2 < ln) {
                  long e = tx_chr(lout + at2, ln - at2, '\n'), l = e < 0 ? ln - at2 : e;
                  if (tx_find(lout + at2, l, "REFUSE", 6) >= 0 || tx_find(lout + at2, l, "row=", 4) >= 0)
                      sy_eprintf("precommit: %.*s\n", (int)l, lout + at2);
                  at2 += l + 1;
              }
              blocked++;
          }
      }
    }
    /* facts gate: a commit touching include/ or exec/facts/ must leave the generated pp-autoinc-gen table
       in sync. The FTRIM/libc anchors are baked into that table from every .h's raw #if lines, so an out-of-
       sync table silently breaks dead-code elimination (see items.tsv FTRIM-ANCHOR). Run facts-gen --check
       and refuse a DIFF; this is what catches a stale facts table before it rides into main. */
    { long fsn; char *fnames = slurp(fv, &fsn);
      if (!fnames) { sy_eprintf("precommit: git diff --cached (facts) failed\n"); return 1; }
      if (fsn > 0) {
          char *frows = slurp(fgv, &rn);
          if (!frows) { sy_eprintf("precommit: tools/facts-gen.cx did not run\n"); return 1; }
          if (tx_prefix(frows, rn, "DIFF", 4)) {
              sy_eprintf("precommit: facts-gen --check pp-autoinc-gen DIFF; run tools/facts-gen.cx -- --write ROOT pp-autoinc-gen\n");
              blocked++;
          }
      }
    }
    blocked += freeze_gate();
    if (!staged) { sy_printf("PRECOMMIT\tstaged_cx=0\tblocked=%d\n", blocked); return blocked ? 1 : 0; }
    blocked += new_tools();
    /* 不再因「只改 tools/tests」而短路:cxtrunc/cxapis/outdep 本来就面向 tools/tests(fable 咨询 2026-11-08)。 */
    { char rp[1200]; const char *wt = sy_env("GIT_WORK_TREE"); int ex;   /* 工作树里有没有棘轮:夹具仓(GIT_WORK_TREE)无则跳过 */
      if (cx_fmt(rp, sizeof rp, "%s%stools/ratchets.cx", wt ? wt : "", wt ? "/" : "")) { sy_eprintf("precommit: path too long\n"); return 1; }
      ex = sy_exists(rp);   /* 1 存在;0 仅 ENOENT;负数=其他错误,必须报告 */
      if (ex < 0) { sy_eprintf("precommit: tools/ratchets.cx unreadable (%d)\n", ex); return 1; }
      if (ex == 0) { sy_printf("PRECOMMIT\tstaged_cx=%d\tblocked=%d\tratchets=absent\n", staged, blocked); return blocked ? 1 : 0; } }
    slurp_okrc = 1; rows = slurp(rv, &rn); slurp_okrc = 0;   /* ratchets 退出码 1=有红行(输出仍要读),>=2 或信号=没跑 */
    if (!rows) { sy_eprintf("precommit: tools/ratchets.cx did not run\n"); return 1; }
    for (at = 0; at < rn; ) {   /* offending rows are indented by two spaces: "  NAME: PATH has ..." */
        long e = tx_chr(rows + at, rn - at, '\n'), l = e < 0 ? rn - at : e, s;
        const char *r = rows + at;
        if (l > 2 && r[0] == ' ' && r[1] == ' ' && (s = tx_chr(r, l, ':')) > 0 && s + 2 < l) {
            long p = s + 2, q, a2;
            int soft = tx_prefix(r + 2, l - 2, "cxlibc:", 7) || tx_prefix(r + 2, l - 2, "cxraw:", 6);   /* printf 类对 tools/tests 仍豁免 */
            int byfile = tx_prefix(r + 2, l - 2, "outdep:", 7);   /* outdep 行以批次名开头,路径在 "in PATH" 里 */
            if (tx_prefix(r + p, l - p, "module ", 7)) p += 7;
            q = p; while (q < l && r[q] != ' ') q++;
            for (a2 = 0; a2 < sn; ) {
                long nl = tx_len(names + a2, sn - a2);
                if (nl <= 0) break;
                if (tx_same(names + a2, nl, r + p, q - p) || (byfile && tx_find(r, l, names + a2, nl) >= 0)) {
                    int toolish = tx_prefix(names + a2, nl, "tools/", 6) || tx_prefix(names + a2, nl, "tests/", 6);
                    if (!toolish || !soft) {
                        sy_eprintf("precommit: blocked:%.*s\n", (int)(l - 1), r + 1); blocked++;
                    }
                    break;
                }
                a2 += nl + 1;
            }
        }
        at += l + 1;
    }
    sy_printf("PRECOMMIT\tstaged_cx=%d\tblocked=%d\n", staged, blocked);
    if (blocked) sy_eprintf("precommit: this commit takes cx files over a ratchet (traditional C back in). Use cx/sys, cx/mem, cx/text\n"
                            "  (sy_*/mm_*/tx_*), put platform differences in L0 or tables, and see prd.md 能力速查; run tools/ratchets.cx.\n");
    return blocked ? 1 : 0;
}
