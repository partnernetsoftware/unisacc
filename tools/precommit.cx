/* tools/precommit.cx -- the commit gate: a commit may not take a .cx file over any ratchet.
 *
 *   sh ./unisacc.com tools/precommit.cx            (run by .git/hooks/pre-commit, a three-line sh entry: exec sh ./unisacc.com tools/precommit.cx)
 *
 * Lists the .cx paths staged in the index being committed (git diff --cached, which follows GIT_INDEX_FILE,
 * so tools/commit-own.cx's private index is gated too), runs tools/ratchets.cx once, and refuses the commit
 * (exit 1) when any offending ratchet row names one of those paths: a new #include, a new direct libc/POSIX
 * call, a new platform #if or raw syscall outside L0, a new unbounded call -- the drift back to traditional C.
 * Rows about files not in this commit (other agents' work) do not block it.  No staged .cx: exit 0 at once.
 * Also runs tools/cx-lint.cx over the staged .cx index blobs: R2/R3/R4 findings
 * block (R4-source-anchor cannot be allowed); R1 findings are report-only.
 * Prints PRECOMMIT<TAB>staged_cx=N<TAB>blocked=B.
 * -- --plan DIR / -- --from-run DIR: used by tools/precommit-flow.cx to run the gate subprocesses as one
 * concurrent flow (see gate_slurp).  With no argument (the hook's call) a commit that stages a registry table is
 * handed to tools/precommit-flow.cx, everything else is judged serially here (see flow_route);
 * UNISACC_PRECOMMIT_SERIAL=1 forces the serial path.  Both paths run the same gates and print the same verdict. */
#pragma unisa use cxlib.globspan
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use sys.poll
#pragma unisa use sys.posix

static int slurp_okrc = 0;   /* 允许的最大退出码:0=仅成功;ratchets.cx 用 1 表示「跑完了但有红行」 */
#define SLURP_DEADLINE_MS 58000   /* 每个子进程(含 ratchets/cx-lint)最多 58 s:超时杀进程组,按「没跑」处理 */
/* --plan DIR / --from-run DIR (tools/precommit-flow.cx): the gate subprocesses become flow nodes.
 * cur_gate names the gate about to call slurp (manifest, tables, runlist, facts, tlibfrozen, lint, lintr1,
 * ratchets).  --plan: print PLAN<TAB>id<TAB>argv... and act as if the gate ran with empty output.
 * --from-run: read DIR/out/<id>.out and the node's rc from DIR/events.tsv instead of spawning; a node that
 * is missing, timed out or skipped counts as "did not run".  The judgement code stays only here. */
static const char *cur_gate = 0, *plan_dir = 0, *from_run = 0;
static char *gate_slurp(char **argv, long *n) {
    char p[1200], *ev, *b; size_t en = 0, bn = 0; long i = 0; int rc = -1, k; long il = tx_len(cur_gate, 64);
    *n = 0;
    if (plan_dir) {
        sy_printf("PLAN\t%s", cur_gate);
        for (k = 0; argv[k]; k++) sy_printf("\t%s", argv[k]);
        sy_printf("\n");
        b = mm_alloc(1); if (b) b[0] = 0; return b;
    }
    if (cx_fmt(p, sizeof p, "%s/events.tsv", from_run)) return 0;
    ev = (char *)cx_read(p, &en);
    if (!ev) return 0;
    while (i < (long)en) {   /* EVT seq id state ms rc summary: the last ok/fail row of this id wins */
        long e = i, so, sl, io, ilen, ro, rl; while (e < (long)en && ev[e] != '\n') e++;
        if (!tx_field(ev + i, e - i, '\t', 2, &io, &ilen) && ilen == il && tx_same(ev + i + io, ilen, cur_gate, il) &&
            !tx_field(ev + i, e - i, '\t', 3, &so, &sl) && !tx_field(ev + i, e - i, '\t', 5, &ro, &rl)) {
            if ((sl == 2 && tx_same(ev + i + so, 2, "ok", 2)) || (sl == 4 && tx_same(ev + i + so, 4, "fail", 4))) {
                long v = 0, j; int neg = 0;
                for (j = 0; j < rl; j++) { if (ev[i + ro + j] == '-') neg = 1; else v = v * 10 + (ev[i + ro + j] - '0'); }
                rc = neg ? -1 : (int)v;
            } else if (sl != 5 || !tx_same(ev + i + so, 5, "start", 5)) rc = -1;
        }
        i = e + 1;
    }
    mm_free(ev);
    if (rc < 0 || rc > slurp_okrc) { sy_eprintf("precommit: from-run node %s rc=%d\n", cur_gate, rc); return 0; }
    if (cx_fmt(p, sizeof p, "%s/out/%s.out", from_run, cur_gate)) return 0;
    b = (char *)cx_read(p, &bn);
    if (!b) return 0;
    { char *g = mm_grow(b, bn + 1); if (!g) { mm_free(b); return 0; } b = g; }
    b[bn] = 0; *n = (long)bn;
    return b;
}

/* COMMIT_PHASE lines of each named gate (cur_gate) into UNISACC_COMMIT_PHASE_LOG, set by tools/commit-own.cx to
   its own stdout (/proc/PID/fd/1): a job tail shows the gate in flight, a timeout leaves its begin without an end.
   Unset (a plain git commit): nothing is written, the hook's own output is unchanged. */
static void gate_phase(const char *name, int begin, long ms) {
    const char *lp = sy_env("UNISACC_COMMIT_PHASE_LOG"); char ln[160]; int bad;
    if (!lp || !lp[0] || !name) return;
    bad = begin ? cx_fmt(ln, sizeof ln, "COMMIT_PHASE\tname=%s\tstate=begin\n", name)
                : cx_fmt(ln, sizeof ln, "COMMIT_PHASE\tname=%s\tstate=end\tms=%ld\n", name, ms);
    if (!bad) (void)sy_append_file(lp, ln, tx_len(ln, sizeof ln), 0600);
}
static char *slurp_run(char **argv, long *n);
static char *slurp(char **argv, long *n) {
    const char *g = (plan_dir || from_run) ? 0 : cur_gate; long t = sy_now_ms(); char *r;
    gate_phase(g, 1, 0);
    r = slurp_run(argv, n);
    gate_phase(g, 0, sy_now_ms() - t);
    return r;
}
static char *slurp_run(char **argv, long *n) {
    int ofd, pid; long cap = 1 << 16, r, deadline; char *b;
    if (cur_gate && (plan_dir || from_run)) return gate_slurp(argv, n);
    b = mm_alloc(cap);
    *n = 0;
    if (!b) return 0;
    pid = sy_spawn_pipe(argv, 0, 0, &ofd, 0);
    if (pid < 0) return 0;
    deadline = sy_now_ms() + SLURP_DEADLINE_MS;
    for (;;) {
        sy_pollfd_t pf; long left = deadline - sy_now_ms();
        pf.fd = ofd; pf.events = SY_POLLIN; pf.revents = 0;
        if (left <= 0 || sy_poll(&pf, 1, left) <= 0) {
            sy_eprintf("precommit: %s timed out after %d ms\n", argv[0], SLURP_DEADLINE_MS);
            sy_close(ofd); sy_kill(pid); mm_free(b); return 0;
        }
        r = sy_read(ofd, b + *n, cap - 1 - *n);
        if (r <= 0) break;
        *n += r;
        if (*n + 1 >= cap) { char *g = mm_grow(b, cap * 2); if (!g) return 0; b = g; cap *= 2; }
    }
    { int ex = 0, code = 0, sig = 0;
      sy_close(ofd);
      if (sy_wait_status(pid, 0, &ex, &code, &sig) != pid || !ex || code < 0 || code > slurp_okrc) { mm_free(b); *n = 0; return 0; }
    }
    b[*n] = 0;
    return b;
}

/* 退出码 1 有两种来源:子工具跑完且有红行,或子工具自身编译失败/崩溃(unisacc.com 编译错同样 rc 1)。
 * 只有看到子工具自己的完成标记行(行首 MARK)才算跑完;否则判 BLOCK,具名原因并附合并输出(含 stderr)的末行。 */
static int incomplete(const char *rows, long rn, const char *mark, const char *tool) {
    long at = 0, ml = tx_len(mark, 64), ls = -1, ll = 0;
    while (at < rn) {
        long e = tx_chr(rows + at, rn - at, '\n'), l = e < 0 ? rn - at : e;
        if (tx_prefix(rows + at, l, mark, ml)) return 0;
        if (l > 0) { ls = at; ll = l; }
        at += l + 1;
    }
    sy_eprintf("precommit: blocked:incomplete:%s: no completion line '%.*s' (sub-tool not finished or failed to compile); last output: %.*s\n",
               tool, (int)(ml > 0 && mark[ml - 1] == '\t' ? ml - 1 : ml), mark, (int)(ls < 0 ? 7 : (ll > 300 ? 300 : ll)), ls < 0 ? "<empty>" : rows + ls);
    return 1;
}

/* 门读集(plans/devsvc.md 6 S2):每道按暂存路径触发的门在 tests/precommit-gates.tsv 声明它读的路径集合
 * (列:gate、diff-filter、空格分隔的 pathspec、说明)。暂存路径与读集不相交的门记 NOT_AFFECTED:不跑、不算 PASS,
 * 只在 PRECOMMIT_GATES 行计数(not_affected=N 与名单);blocked 判定不变。表不在(仅 ENOENT:夹具仓与旧归档)时用
 * gt_builtin(与表逐行相同,check-precommit-gates 用 --gates 对拍);表在但缺某门的行,该门按失败处理,不放行。 */
static const char gt_builtin[] =
    "manifest\tACMRD\ttests/manifests tests/batches.tsv tests/coverage.tsv tools/batch-packages-gen.cx\n"
    "tables\tACMRD\ttests/manifests tests/batches.tsv tests/coverage.tsv tests/tools-compile-sources.tsv\n"
    "toolsreg\tADRT\ttools/*.cx\n"
    "runlist\tACMR\ttests/coverage.tsv tests/batches.tsv\n"
    "facts\tACMR\tinclude exec/facts\n"
    "ledger\tACMR\tarchive/agentwork-retire-2026-11/ledger.tsv\n"
    "cx\tACMR\t*.cx\n";
static const char *gt_tab = 0; static long gt_n = 0; static int gt_src = 0, gt_na = 0; static char gt_nal[160];
static int gt_load(void) {
    char p[1200]; const char *wt = sy_env("GIT_WORK_TREE"); int ex; size_t n = 0;
    if (gt_tab) return 0;
    if (cx_fmt(p, sizeof p, "%s%stests/precommit-gates.tsv", wt ? wt : "", wt ? "/" : "")) return 1;
    ex = sy_exists(p);   /* 1 存在;0 仅 ENOENT;负数=其他错误,必须报告 */
    if (ex < 0) { sy_eprintf("precommit: tests/precommit-gates.tsv unreadable (%d)\n", ex); return 1; }
    if (ex == 0) { gt_tab = gt_builtin; gt_n = (long)sizeof gt_builtin - 1; gt_src = 0; return 0; }
    gt_tab = (const char *)cx_read(p, &n); gt_n = (long)n; gt_src = 1;
    if (!gt_tab) { sy_eprintf("precommit: cannot read tests/precommit-gates.tsv\n"); return 1; }
    return 0;
}
static void gt_mark_na(const char *gate) {
    long l = tx_len(gt_nal, sizeof gt_nal), g = tx_len(gate, 64);
    gt_na++;
    if (l + g + 2 < (long)sizeof gt_nal) { if (l) gt_nal[l++] = ','; mm_copy(gt_nal + l, sizeof gt_nal - l, gate, (size_t)g); gt_nal[l + g] = 0; }
}
/* the staged paths (NUL separated) inside GATE's declared read set; 0 = could not tell (callers fail closed) */
static char *gate_diff(const char *gate, long *n) {
    static char filt[40], specs[1024]; char *av[48], *out; long at = 0, gl = tx_len(gate, 64); int k = 0;
    *n = 0;
    if (gt_load()) return 0;
    while (at < gt_n && !k) {
        long e = tx_chr(gt_tab + at, gt_n - at, '\n'), l = e < 0 ? gt_n - at : e, o, fl, so, sl, i;
        if (l > 0 && gt_tab[at] != '#' && !tx_field(gt_tab + at, l, '\t', 0, &o, &fl) && fl == gl && tx_same(gt_tab + at + o, fl, gate, gl) &&
            !tx_field(gt_tab + at, l, '\t', 1, &o, &fl) && fl > 0 && fl < 20 &&
            !tx_field(gt_tab + at, l, '\t', 2, &so, &sl) && sl > 0 && sl < (long)sizeof specs) {
            if (cx_fmt(filt, sizeof filt, "--diff-filter=%.*s", (int)fl, gt_tab + at + o)) return 0;
            mm_copy(specs, sizeof specs, gt_tab + at + so, (size_t)sl); specs[sl] = 0;
            av[k++] = "git"; av[k++] = "diff"; av[k++] = "--cached"; av[k++] = "--name-only"; av[k++] = filt; av[k++] = "-z"; av[k++] = "--";
            for (i = 0; i < sl && k < 46; ) {
                while (i < sl && specs[i] == ' ') specs[i++] = 0;
                if (i < sl) { av[k++] = specs + i; while (i < sl && specs[i] != ' ') i++; }
            }
        }
        at += l + 1;
    }
    if (k < 8) { sy_eprintf("precommit: gate %s has no read-set row in tests/precommit-gates.tsv\n", gate); return 0; }
    av[k] = 0;
    out = slurp(av, n);
    if (out && *n <= 0) gt_mark_na(gate);
    return out;
}
/* take GATE back out of the NOT_AFFECTED count when it was the last one marked and runs after all (toolsreg
   also runs when the tables gate is hit: a registry or batches edit alone can break the tools inventory too) */
static void gt_unmark(const char *gate) {
    long l = tx_len(gt_nal, sizeof gt_nal), g = tx_len(gate, 64);
    if (gt_na <= 0 || l < g || !tx_same(gt_nal + l - g, g, gate, g) || (l > g && gt_nal[l - g - 1] != ',')) return;
    gt_na--; gt_nal[l > g ? l - g - 1 : 0] = 0;
}
static void gt_line(void) {
    if (gt_load()) return;
    sy_printf("PRECOMMIT_GATES\tnot_affected=%d\tna=%s\tsource=%s\n", gt_na, gt_nal[0] ? gt_nal : "-", gt_src ? "table" : "builtin");
}
static int gt_print(void) {   /* -- --gates: the effective read sets, one GATE row each */
    long at = 0;
    if (gt_load()) return 1;
    while (at < gt_n) {
        long e = tx_chr(gt_tab + at, gt_n - at, '\n'), l = e < 0 ? gt_n - at : e, o, fl, so, sl;
        if (l > 0 && gt_tab[at] != '#' && !tx_field(gt_tab + at, l, '\t', 1, &o, &fl) && !tx_field(gt_tab + at, l, '\t', 2, &so, &sl))
            sy_printf("GATE\t%.*s\n", (int)(so + sl), gt_tab + at);
        at += l + 1;
    }
    sy_printf("GATES\tsource=%s\n", gt_src ? "table" : "builtin");
    return 0;
}

/* 同一提交内复用(S2):tools/commit-own.cx 在提交前已对同一份私有索引跑过的门,把退出码与输出连同键写进
 * UNISACC_GATE_REUSE 指的文件;键 = 暂存树 sha(git write-tree)、门名、工具源 blob sha、完整 argv。这里重算键,
 * 逐字相同才用那份输出,否则照常重跑。文件属于那一次 commit-own 进程,提交结束即删,不跨提交。 */
static char *gate_reuse(const char *gate, char **argv, long *n) {
    const char *f = sy_env("UNISACC_GATE_REUSE"), *sv = cur_gate;
    char key[2048], *b, *o, *t, *h; size_t bn = 0; long kl, tn, hn, e2; int k, rc = 1;
    char *wv[] = {"git", "write-tree", 0}, *hv[] = {"git", "hash-object", "--", argv[2], 0};
    *n = 0;
    if (!f || !f[0]) return 0;
    cur_gate = 0; t = slurp(wv, &tn); h = slurp(hv, &hn); cur_gate = sv;
    if (t && h && tn >= 40 && hn >= 40) {
        rc = cx_fmt(key, sizeof key, "KEY\ttree=%.*s\tgate=%s\ttool=%.*s\targv=", 40, t, gate, 40, h);
        for (k = 0; !rc && argv[k]; k++) { kl = tx_len(key, sizeof key); rc = cx_fmt(key + kl, sizeof key - (size_t)kl, "%s%s", k ? " " : "", argv[k]); }
    }
    mm_free(t); mm_free(h);
    if (rc) { sy_eprintf("precommit: gate %s reuse: key not computable, rerun\n", gate); return 0; }
    kl = tx_len(key, sizeof key);
    b = (char *)cx_read(f, &bn);
    if (!b || (long)bn < kl + 6 || !tx_same(b, kl, key, kl) || b[kl] != '\n' || !tx_same(b + kl + 1, 3, "RC\t", 3) ||
        b[kl + 4] < '0' || b[kl + 4] > '0' + slurp_okrc || b[kl + 5] != '\n') {
        sy_eprintf("precommit: gate %s reuse: key mismatch, rerun\n", gate); mm_free(b); return 0;
    }
    e2 = kl + 6;
    o = mm_alloc((size_t)((long)bn - e2 + 1));
    if (!o) { mm_free(b); return 0; }
    if ((long)bn > e2) mm_copy(o, (size_t)((long)bn - e2 + 1), b + e2, (size_t)((long)bn - e2));
    o[(long)bn - e2] = 0; *n = (long)bn - e2;
    mm_free(b);
    sy_eprintf("precommit: gate %s reused (same staged tree, tool and argv; it ran once in this commit)\n", gate);
    return o;
}

static int registered(const char *b, long n, const char *check) {
    long at = 0, cl = tx_len(check, 4600);
    while (b && at < n) {
        long e = tx_chr(b + at, n - at, '\n'), l = e < 0 ? n - at : e, pos = 0, field = 0;
        int implemented = 0, found = 0;
        if (l > 0 && b[at] != '#') while (pos <= l) {
            long t = tx_chr(b + at + pos, l - pos, '\t'), len = t < 0 ? l - pos : t;
            if (field == 1) implemented = tx_same(b + at + pos, len, "IMPLEMENTED", 11);
            if (field == 3 || field == 8) found |= tx_same(b + at + pos, len, check, cl);
            field++; if (t < 0) break; pos += len + 1;
        }
        if (implemented && found && (field == 13 || field == 14)) return 1;
        at += l + 1;
    }
    return 0;
}

/* Gate actual support for newly indexed tools. Check tools are leaves;
 * modules can use a root tools/check-NAME.cx or adjacent check. */
static int new_tools(void) {
    char *av[] = {"git", "diff", "--cached", "--name-only", "--diff-filter=A", "-z", "--", "tools", 0};
    char *bv[] = {"git", "show", ":tests/batches.tsv", 0};
    long n, bn, at = 0; int blocked = 0;
    char *names = slurp(av, &n), *batches = slurp(bv, &bn);
    if (!names) return 1;
    while (at < n) {
        const char *p = names + at; long l = tx_len(p, n - at), slash = 0, j, cn;
        char check[4600], spec[4600]; char *blob; char *v[] = {"git", "show", spec, 0};
        at += l + 1;
        if (!tx_suffix(p, l, ".cx", 3)) continue;
        for (j = 0; j < l; j++) if (p[j] == '/') slash = j + 1;
        if (tx_prefix(p + slash, l - slash, "check-", 6)) { if(!registered(batches,bn,p)){sy_eprintf("precommit: new check missing batch registration: %s\n",p);blocked++;} continue; }
        { char *lv[] = {"git", "ls-files", "-s", "--", (char *)p, 0}; long ln; char *ls = slurp(lv, &ln);
          if (ls && tx_prefix(ls, ln, "120000", 6)) { if(!registered(batches,bn,p)){sy_eprintf("precommit: new symlink alias requires batch registration: %s\n",p);blocked++;} mm_free(ls); continue; } mm_free(ls); }
        if (cx_fmt(check, sizeof check, "tools/check-%s", p + slash) || cx_fmt(spec, sizeof spec, ":%s", check)) return 1;
        blob = slurp(v, &cn);
        if (!blob || cn == 0) {
            mm_free(blob);
            if (cx_fmt(check, sizeof check, "%.*scheck-%s", (int)slash, p, p + slash) || cx_fmt(spec, sizeof spec, ":%s", check)) return 1;
            blob = slurp(v, &cn);
        }
        if (!blob || cn == 0) { sy_eprintf("precommit: new tool %s missing check-*.cx\n", p); blocked++; }
        else if (!registered(batches, bn, check)) {
            sy_eprintf("precommit: new tool %s check missing batch registration: %s\n", p, check); blocked++;
        }
        mm_free(blob);
    }
    mm_free(names); mm_free(batches); return blocked;
}


/* 冻结窗口闸(fable 咨询 2026-11-08):build/freeze.tsv 存在且未过期时,staged 路径命中冻结前缀、
 * 且 UNISACC_INTEGRATOR 不等于 owner 的提交被拒。列:candidate_sid base_commit owner deadline_epoch_s paths(空格分隔)。
 * 冻结是有界事件:deadline 过期即不拦;tools/ tests/ plans/ archive/ 不在 paths 内,永不受影响。 */
static int freeze_gate(void) {
    size_t zn = 0; char *z = (char *)cx_read("build/freeze.tsv", &zn), *f[6]; long fn = 0, now, dl = 0, i;
    char *dv[] = {"git", "diff", "--cached", "--name-only", "--diff-filter=ACMRD", "-z", 0};
    char *names, line[1200], *p; int blocked = 0, nf = 0; const char *who;
    if (!z) return 0;                                   /* 无标记文件=无冻结(ENOENT) */
    for (p = z; *p; ) {                                  /* 取第一条非注释行 */
        char *e = p; while (*e && *e != '\n') e++;
        if (*p != '#' && e > p && (size_t)(e - p) < sizeof line) { mm_copy(line, sizeof line, p, (size_t)(e - p)); line[e - p] = 0; break; }
        p = *e ? e + 1 : e; line[0] = 0;
    }
    if (!line[0]) return 0;
    f[nf++] = line;
    for (p = line; *p && nf < 6; p++) if (*p == '\t') { *p = 0; f[nf++] = p + 1; }
    if (nf != 5) { sy_eprintf("precommit: freeze.tsv malformed (need 5 columns)\n"); return 1; }
    for (i = 0; f[3][i] >= '0' && f[3][i] <= '9'; i++) dl = dl * 10 + (f[3][i] - '0');
    now = sy_wall_s();   /* 墙钟秒;sy_now_ms 是单调钟,不能与 epoch 截止时间比 */
    if (i == 0 || now >= dl) return 0;                   /* 过期即失效,不死锁 */
    who = sy_env("UNISACC_INTEGRATOR");
    if (who && tx_eqz(who, f[2])) return 0;
    names = slurp(dv, &fn); if (!names) return 0;
    for (long at = 0; at < fn; ) {
        long nl = tx_len(names + at, fn - at); char *q;
        if (nl <= 0) break;
        for (q = f[4]; *q; ) {
            char *s = q, *t; long pl;
            while (*q && *q != ' ') q++;
            pl = q - s; t = s; (void)t;
            if (pl > 0 && nl > pl && names[at + pl] == '/' && tx_prefix(names + at, nl, s, pl)) {
                sy_eprintf("precommit: 冻结中(candidate %s,至 epoch %s):产品输入 %.*s 经集成者 patch 提交\n", f[0], f[3], (int)nl, names + at);
                blocked++; break;
            }
            while (*q == ' ') q++;
        }
        at += nl + 1;
    }
    mm_free(names);
    return blocked;
}

/* 子进程闸(0.0.50 L):对本次 staged 的 .cx 索引内容跑 tools/cx-lint.cx。R2(R2-timeout/R2-sep,缺 -- 分隔或无界的
 * 子进程调用)有发现即 blocked;R1(第二真相源)只打印不拦。索引 blob 写到 sy_tmpdir()/precommit-lint-PID/<原路径>,
 * 保留目录结构让 cx-lint 的 tests/ 判定仍成立。cwd 下没有 ./unisacc.com 或 tools/cx-lint.cx(夹具仓)时跳过,打印 lint=absent。 */
/* tlib 版本化门(0.0.58 A2):暂存区若含 build/tlib-packages.tsv 任一包 roots 下的 .cx,调用
 * tools/check-tlib-frozen.cx -- --fast ROOT PKG... 只算受影响包的 content sha。当前分级为
 * report-only 一个提交周期:不匹配时输出 TLIB_BUMP_NEEDED<TAB>PKG 与 layer-api --bump PKG 提示,
 * 不增加 blocked。 */
static int tlib_item(const char *s, long n, long idx, const char **o, long *l) {
    long off = 0, len = 0;
    if (n == 1 && s[0] == '-') return 1;
    if (n <= 0 || idx >= tx_fields(s, n, ';')) return 1;
    if (tx_field(s, n, ';', idx, &off, &len) || len <= 0) return 1;
    *o = s + off; *l = len;
    return 0;
}
static int in_root(const char *path, long pl, const char *rt, long rl) {
    if (rl <= 0) return 0;
    if (pl == rl && tx_same(path, pl, rt, rl)) return 1;
    if (pl > rl && path[rl] == '/' && tx_prefix(path, pl, rt, rl)) {
        long j;
        for (j = rl + 1; j < pl; j++) if (path[j] == '/') return 0;
        return 1;
    }
    return 0;
}
/* tlibapi: a touched tlib package whose source now gives another public-interface sha than the api_sha of
   build/tlib-packages.tsv blocks the commit (the commit changed a public interface and did not carry the derived
   layer-api/tlib-packages rows: cb95b01649 ff_ctx_lookup).  Cheap probe: tools/layer-api.cx --sha-only (one
   -cx-interface per unit, no manifest, no closure check; about 1 s hot for tools.cxlib).  A body-only change
   keeps the sha and passes.  Skipped in --plan/--from-run (no flow node yet) and when the tool is absent. */
static int tlib_api_gate(const char *root, const char *cp, char pkgs[][64], int npkg) {
    char lp[1200], *av[16], *rows; long rn, at; int i, k, blocked = 0;
    if (plan_dir || from_run || npkg <= 0) return 0;
    if (cx_fmt(lp, sizeof lp, "%s/tools/layer-api.cx", root)) return 0;
    if (sy_exists(lp) != 1) {   /* a fixture work tree without tools: the checkout's own, as tlib_frozen_gate does */
        if (sy_exists("./tools/layer-api.cx") != 1) return 0;
        tx_copy(lp, sizeof lp, "tools/layer-api.cx", 18);
    }
    for (i = 0; i < npkg; i++) {
        k = 0;
        av[k++] = "sh"; av[k++] = (char *)cp; av[k++] = lp; av[k++] = "--"; av[k++] = "--sha-only";
        av[k++] = "--pkg"; av[k++] = pkgs[i]; av[k++] = "--root"; av[k++] = (char *)root; av[k++] = "--product"; av[k++] = (char *)cp;
        av[k] = 0;
        cur_gate = "tlibapi"; slurp_okrc = 1; rows = slurp(av, &rn); slurp_okrc = 0; cur_gate = 0;
        if (!rows) { sy_eprintf("precommit: tools/layer-api.cx --sha-only %s did not run\n", pkgs[i]); blocked++; continue; }
        if (incomplete(rows, rn, "API_SHA\t", "layer-api --sha-only")) { mm_free(rows); blocked++; continue; }
        for (at = 0; at < rn; ) {
            long le = tx_chr(rows + at, rn - at, '\n'), l = le < 0 ? rn - at : le, so, sl;
            if (tx_prefix(rows + at, l, "API_SHA\t", 8) && !tx_field(rows + at, l, '\t', 2, &so, &sl) &&
                sl == 7 && tx_same(rows + at + so, sl, "differs", 7)) {
                sy_printf("TLIB_API_STALE\t%s\tthe commit changes a public interface of %s but build/tlib-packages.tsv api_sha (and build/layer-api/%s.tsv) still name the old one: %.*s\n",
                          pkgs[i], pkgs[i], pkgs[i], (int)l, rows + at);
                sy_eprintf("precommit: TLIB_API_STALE %s: recommit with --derive (sh ./unisacc.com tools/commit-own.cx -- --derive ...), or first run sh ./unisacc.com tools/derive.cx -- --write --only layer-api and take the derived tables into the commit\n", pkgs[i]);
                blocked++;
            }
            at += l + 1;
        }
        mm_free(rows);
    }
    return blocked;
}

/* K4 reservation hint (WARN, never blocks): for each touched package ask tools/bump.cx --query PKG (version taken from
   the index row of build/tlib-packages.tsv); VERDICT=unreserved -- bumped, but neither the next patch of HEAD nor any
   live devsvc reservation -- prints TLIB_BUMP_UNRESERVED. head/next/reserved/reserved-other are silent. Any failure
   of the query (no HEAD table, no instance directory) is silent too: this is a hint, the blocking gates stay as they are. */
static void tlib_reserve_hint(const char *root, const char *cp, char pkgs[][64], int npkg) {
    char bp[1200], *av[12], *o, f[3][40];
    const char *key[3] = {"VERSION=", "NEXT=", "VERDICT="};
    size_t n; long i, j; int p, k, q;
    if (plan_dir || from_run || npkg <= 0) return;
    if (cx_fmt(bp, sizeof bp, "%s/tools/bump.cx", root)) return;
    if (sy_exists(bp) != 1) {
        if (sy_exists("./tools/bump.cx") != 1) return;
        tx_copy(bp, sizeof bp, "tools/bump.cx", 13);
    }
    for (p = 0; p < npkg; p++) {
        k = 0; o = 0; n = 0;
        av[k++] = "sh"; av[k++] = (char *)cp; av[k++] = bp; av[k++] = "--"; av[k++] = "--query"; av[k++] = pkgs[p];
        av[k++] = "--root"; av[k++] = (char *)root; av[k] = 0;
        if (cx_runv_timeout(av, 20, &o, &n) != 0 || !o) { mm_free(o); continue; }
        for (q = 0; q < 3; q++) {   /* byte scan for each KEY= field of the BUMP_QUERY line */
            long kl = tx_len(key[q], 16);
            f[q][0] = 0;
            for (i = 0; i + kl <= (long)n; i++) {
                if ((i == 0 || o[i - 1] == '\t') && mm_same(o + i, key[q], kl)) {
                    for (j = 0; i + kl + j < (long)n && o[i + kl + j] != '\t' && o[i + kl + j] != '\n' && j < 39; j++) f[q][j] = o[i + kl + j];
                    f[q][j] = 0;
                    break;
                }
            }
        }
        mm_free(o);
        if (tx_eqz(f[2], "unreserved")) {
            sy_printf("TLIB_BUMP_UNRESERVED\tpkg=%s\tversion=%s\texpected=%s\tWARN (not blocking): reserve first: sh ./unisacc.com tools/devsvc.cx -- bump %s, then sh ./unisacc.com tools/layer-api.cx -- --bump %s --version VERSION\n",
                      pkgs[p], f[0], f[1], pkgs[p], pkgs[p]);
            sy_eprintf("precommit: TLIB_BUMP_UNRESERVED %s version=%s expected=%s (WARN): sh ./unisacc.com tools/devsvc.cx -- bump %s\n", pkgs[p], f[0], f[1], pkgs[p]);
        }
    }
}

static int tlib_frozen_gate(const char *names, long sn) {
    const char *wt = sy_env("GIT_WORK_TREE"), *root = (wt && wt[0]) ? wt : ".";
    char tp[1200], fp[1200], cp[1200], pkgs[32][64], *av[40], *t, *rows;
    size_t tn = 0; long i = 0, e, at, rn = 0; int npkg = 0, k, blocked = 0;
    if (cx_fmt(tp, sizeof tp, "%s/build/tlib-packages.tsv", root) ||
        cx_fmt(fp, sizeof fp, "%s/tools/check-tlib-frozen.cx", root) ||
        cx_fmt(cp, sizeof cp, "%s/unisacc.com", root)) return 0;
    if (sy_exists(tp) != 1) return 0;
    if (sy_exists(fp) != 1) {
        if (sy_exists("./tools/check-tlib-frozen.cx") != 1) return 0;
        tx_copy(fp, sizeof fp, "tools/check-tlib-frozen.cx", 26);
    }
    if (sy_exists(cp) != 1) {
        if (sy_exists("./unisacc.com") != 1) return 0;
        tx_copy(cp, sizeof cp, "./unisacc.com", 13);
    }
    t = (char *)cx_read(tp, &tn);
    if (!t) return 0;
    while (i < (long)tn && npkg < 32) {
        long po, pl, ro, rl, z_o, zl;
        e = i; while (e < (long)tn && t[e] != '\n') e++;
        if (e > i && t[i] != '#' &&
            !tx_field(t + i, e - i, '\t', 0, &po, &pl) &&
            !tx_field(t + i, e - i, '\t', 3, &ro, &rl) &&
            !tx_field(t + i, e - i, '\t', 8, &z_o, &zl) &&
            zl == 64 && pl > 0 && pl < 64) {
            int hit = 0; long idx;
            for (idx = 0; !hit; idx++) {
                const char *rt; long rtl;
                if (tlib_item(t + i + ro, rl, idx, &rt, &rtl)) break;
                for (at = 0; at < sn; ) {
                    long nl = tx_len(names + at, sn - at);
                    if (nl <= 0) break;
                    if (in_root(names + at, nl, rt, rtl)) { hit = 1; break; }
                    at += nl + 1;
                }
            }
            if (hit && !tx_copy(pkgs[npkg], 64, t + i + po, pl)) npkg++;
        }
        i = e + 1;
    }
    mm_free(t);
    if (!npkg) return 0;
    k = 0;
    av[k++] = "sh"; av[k++] = cp; av[k++] = fp; av[k++] = "--"; av[k++] = "--fast"; av[k++] = (char *)root;
    for (i = 0; i < npkg; i++) av[k++] = pkgs[i];
    av[k] = 0;
    cur_gate = "tlibfrozen"; slurp_okrc = 1; rows = slurp(av, &rn); slurp_okrc = 0; cur_gate = 0;
    if (!rows) { sy_eprintf("precommit: tools/check-tlib-frozen.cx --fast did not run\n"); return 0; }
    if (incomplete(rows, rn, "TLIB_FAST\t", "check-tlib-frozen")) { mm_free(rows); return 1; }
    for (at = 0; at < rn; ) {
        long le = tx_chr(rows + at, rn - at, '\n'), l = le < 0 ? rn - at : le, po, pl;
        if (tx_prefix(rows + at, l, "FROZEN\t", 7) && tx_find(rows + at, l, "\tMISMATCH", 9) >= 0 &&
            !tx_field(rows + at, l, '\t', 1, &po, &pl)) {
            sy_printf("TLIB_BUMP_NEEDED\t%.*s\trun: sh ./unisacc.com tools/layer-api.cx -- --bump %.*s (先 git add 该包源路径:bump 按暂存区内容计算,包源路径有未暂存改动会被拒)\n",
                      (int)pl, rows + at + po, (int)pl, rows + at + po);
            sy_eprintf("precommit: TLIB_BUMP_NEEDED %.*s (report-only): sh ./unisacc.com tools/layer-api.cx -- --bump %.*s (先 git add 该包源路径,bump 按暂存区内容计算)\n",
                       (int)pl, rows + at + po, (int)pl, rows + at + po);
        }
        at += l + 1;
    }
    mm_free(rows);
    tlib_reserve_hint(root, cp, pkgs, npkg);
    blocked += tlib_api_gate(root, cp, pkgs, npkg);
    return blocked;
}

static int mkdirs(char *path) {   /* 逐级建目录;已存在视为成功 */
    long i;
    for (i = 1; path[i]; i++) if (path[i] == '/') { path[i] = 0; if (sy_mkdir(path, 0700) && sy_exists(path) != 1) { path[i] = '/'; return -1; } path[i] = '/'; }
    return 0;
}
static int lint_gate(const char *names, long sn, int *absent) {
    char dir[1200], **paths; long at, np = 0, i; int blocked = 0;
    *absent = 0;
    if (sy_exists("./unisacc.com") != 1 || sy_exists("tools/cx-lint.cx") != 1) { *absent = 1; return 0; }
    if (plan_dir || from_run) {   /* plan stages the blobs into DIR/lintdir; from-run reuses the same paths */
        if (cx_fmt(dir, sizeof dir, "%s/lintdir", plan_dir ? plan_dir : from_run) || (sy_mkdir(dir, 0700) && sy_exists(dir) != 1)) { sy_eprintf("precommit: lint scratch dir\n"); return 1; }
    } else if (cx_fmt(dir, sizeof dir, "%s/precommit-lint-%d", sy_tmpdir(), sy_pid()) || sy_mkdir(dir, 0700)) { sy_eprintf("precommit: lint scratch dir\n"); return 1; }
    paths = mm_alloc((size_t)(sn + 8) * sizeof *paths);
    if (!paths) return 1;
    for (at = 0; at < sn; ) {
        long nl = tx_len(names + at, sn - at), bn; char spec[4410], *blob, *p; char *sv[] = {"git", "show", spec, 0}; int fd;
        if (nl <= 0) break;
        if (nl < 4398 && nl >= 3 && tx_same(names + at + nl - 3, 3, ".cx", 3)) {
            spec[0] = ':'; mm_copy(spec + 1, sizeof spec - 1, names + at, (size_t)nl); spec[nl + 1] = 0;
            blob = slurp(sv, &bn);
            p = mm_alloc((size_t)(tx_len(dir, 1200) + nl + 2));
            if (blob && p && !cx_fmt(p, (size_t)(tx_len(dir, 1200) + nl + 2), "%s/%.*s", dir, (int)nl, names + at) && !mkdirs(p) &&
                ((plan_dir || from_run) && sy_exists(p) == 1 ? sy_unlink(p) : 0, (fd = sy_open_new(p, 0600)) >= 0)) {
                if (sy_write_all(fd, blob, bn) == 0) paths[np++] = p; else mm_free(p);
                sy_close(fd);
            } else { sy_eprintf("precommit: lint: cannot stage %.*s for cx-lint\n", (int)nl, names + at); mm_free(p); blocked++; }
            mm_free(blob);
        }
        at += nl + 1;
    }
    if (np) {
        char **lv = mm_alloc((size_t)(np + 8) * sizeof *lv); long rn, k; char *rows; int j;
        if (!lv) return 1;
        for (j = 0; j < 2; j++) {   /* 第一遍 R2+R3+R4 --strict(拦),第二遍 R1(只报告) */
            k = 0; lv[k++] = "sh"; lv[k++] = "./unisacc.com"; lv[k++] = "tools/cx-lint.cx"; lv[k++] = "--";
            lv[k++] = "--rules"; lv[k++] = j ? "R1" : "R2,R3,R4"; if (!j) lv[k++] = "--strict";
            for (i = 0; i < np; i++) lv[k++] = paths[i];
            lv[k] = 0;
            cur_gate = j ? "lintr1" : "lint"; slurp_okrc = 1; rows = slurp(lv, &rn); slurp_okrc = 0; cur_gate = 0;
            if (!rows) { sy_eprintf("precommit: tools/cx-lint.cx did not run\n"); blocked++; continue; }
            if (incomplete(rows, rn, "CX_LINT\t", "cx-lint")) { blocked++; mm_free(rows); continue; }
            for (at = 0; at < rn; ) {
                long e = tx_chr(rows + at, rn - at, '\n'), l = e < 0 ? rn - at : e, d = tx_find(rows + at, l, dir, tx_len(dir, 1200));
                if (tx_prefix(rows + at, l, "LINT\t", 5)) {
                    long dl = tx_len(dir, 1200);   /* 去掉临时目录前缀,打印原路径 */
                    if (d >= 0) sy_eprintf("precommit: %s%.*s%.*s\n", j ? "lint(report-only):" : "blocked:lint:", (int)d, rows + at, (int)(l - d - dl - 1), rows + at + d + dl + 1);
                    else sy_eprintf("precommit: %s%.*s\n", j ? "lint(report-only):" : "blocked:lint:", (int)l, rows + at);
                    if (!j) blocked++;
                }
                at += l + 1;
            }
            mm_free(rows);
        }
        mm_free(lv);
    }
    for (i = 0; i < np; i++) { if (!plan_dir) sy_unlink(paths[i]); mm_free(paths[i]); }   /* 文件清掉;空目录留给 tmp 清理(不递归删) */
    mm_free(paths);
    return blocked;
}

/* 登记配对闸(REG-CLOSED-GATE):暂存区改了 tests/batches.tsv 或 tests/coverage.tsv 时,按索引内容(不是工作树)
 * 重新求值注册表规则,只拦「本次提交新引入或遗留」的 unknown-coverage 批次。求值直接调用 tests/run.cx --list
 * (即 s9 init 用的同一解析器 tp_analyze):在临时根下放索引版两张表和 run.cx 副本,其余顶层条目与 tests/ 其余条目
 * 软链回工作树。HEAD 版同法求值,同一 id 在 HEAD 已未覆盖则不归咎。run.cx 不在 cwd(夹具仓)时跳过。 */
static int cov_blob(const char *rev, const char *path, char **out, long *n) {
    char spec[160]; char *v[] = {"git", "show", spec, 0};
    if (cx_fmt(spec, sizeof spec, "%s:%s", rev, path)) return 1;
    *out = slurp(v, n);
    return *out ? 0 : 1;
}
static int cov_link_dir(const char *src, const char *dst, const char *skip1, const char *skip2, const char *skip3, int regs) {
    sy_dir_t d; int rc = sy_dir_open(&d, src);
    if (rc) return rc;
    while (sy_dir_next(&d) == 1) {
        char s[1500], t[1500];
        if (tx_eqz(d.name, skip1) || tx_eqz(d.name, skip2) || tx_eqz(d.name, skip3) || tx_eqz(d.name, ".git")) continue;
        if (cx_fmt(s, sizeof s, "%s/%s", src, d.name) || cx_fmt(t, sizeof t, "%s/%s", dst, d.name)) continue;
        if (regs) {   /* tests/ 下的普通文件(批次源)须以普通文件出现:tp_visit 用 lstat 拒软链(source-not-regular) */
            sy_stat_t st;
            if (!sy_lstat(s, &st) && st.kind == 'f') {
                if (sy_link(s, t)) { size_t sz = 0; char *c = (char *)cx_read(s, &sz); if (c) { cx_write(t, c, sz); mm_free(c); } }
                continue;
            }
        }
        sy_symlink(s, t);
    }
    sy_dir_close(&d);
    return 0;
}
/* the scratch root of one evaluation.  Flow passes (--plan / --from-run) keep the index-side root in the run
 * dir (DIR/cov-idx) so that the plan pass can build it, the flow node run in it and the judge pass clean it;
 * everything else (serial path, the HEAD-side evaluation) uses a per-process root under sy_tmpdir. */
static int cov_flow(const char *tag) { return (plan_dir || from_run) && tx_eqz(tag, "idx"); }
static int cov_dir(const char *tag, char *dir, size_t cap) {
    if (cov_flow(tag)) return cx_fmt(dir, cap, "%s/cov-%s", plan_dir ? plan_dir : from_run, tag);
    return cx_fmt(dir, cap, "%s/precommit-cov-%d-%s", sy_tmpdir(), sy_pid(), tag);
}
static void cov_clean(const char *tag) {
    sy_dir_t d; char dir[1200], t[1500], u[1500];
    if (plan_dir && cov_flow(tag)) return;   /* the coveval flow node still has to run in it */
    if (cov_dir(tag, dir, sizeof dir) || cx_fmt(t, sizeof t, "%s/tests", dir)) return;
    if (!sy_dir_open(&d, t)) { while (sy_dir_next(&d) == 1) if (!cx_fmt(u, sizeof u, "%s/%s", t, d.name)) sy_unlink(u); sy_dir_close(&d); }
    sy_rmdir(t);
    if (!sy_dir_open(&d, dir)) { while (sy_dir_next(&d) == 1) if (!cx_fmt(u, sizeof u, "%s/%s", dir, d.name)) sy_unlink(u); sy_dir_close(&d); }
    sy_rmdir(dir);
}
/* 求值一版:返回 0=解析通过;1=unknown-coverage,*idv 放首个 id;2=其他行首 REFUSE(环境类如 source-not-regular),*idv 放原因;-1=没跑.
 * cov_gate 对 2 与 -1 一律具名拦截,不静默放行;只有夹具仓(工作树根无 tests/run.cx)跳过并打印 COVGATE skipped=1.
 * Flow passes: the index-side run.cx --list is the flow node "coveval" (30 s bound set by precommit-flow.cx):
 * --plan builds the root and prints the PLAN row, --from-run reads the node's output; the parsing below is
 * shared with the serial path, and the rare HEAD-side evaluation stays in line in the judge pass. */
/* 工作树根(git rev-parse --show-toplevel,随 GIT_DIR/GIT_WORK_TREE)是否有 tests/run.cx:夹具仓判定以工作树根为准,
 * 不以当前目录为准(夹具在真实仓目录下跑钩子时,当前目录的 run.cx 是真实仓的)。git 失败时退回当前目录。结果缓存。 */
static char wt_top[1100];
static int wt_state = -2;
static int wt_runcx(void) {
    char *gv[] = {"git", "rev-parse", "--show-toplevel", 0}; char *o, *sg = cur_gate; long n = 0, k = 0; char p[1300];
    if (wt_state != -2) return wt_state;
    cur_gate = 0; o = slurp(gv, &n); cur_gate = sg;
    if (o) { while (k < n && o[k] != '\n' && k < (long)sizeof wt_top - 1) { wt_top[k] = o[k]; k++; } wt_top[k] = 0; mm_free(o); }
    if (!k && sy_cwd(wt_top, sizeof wt_top)) { wt_top[0] = 0; wt_state = 0; return 0; }
    if (cx_fmt(p, sizeof p, "%s/tests/run.cx", wt_top)) { wt_state = 0; return 0; }
    wt_state = sy_exists(p) == 1;
    return wt_state;
}
/* the toolsreg gate applies when the work-tree root (wt_runcx's wt_top, not the cwd) has tests/tools-compile.cx */
static int toolsreg_here(void) {
    char p[1300];
    wt_runcx();
    if (!wt_top[0] || cx_fmt(p, sizeof p, "%s/tests/tools-compile.cx", wt_top)) return 0;
    return sy_exists(p) == 1;
}
static int cov_eval(const char *tag, const char *reg, long rn, const char *cov, long cn, char *idv, int idcap) {
    char dir[1200], tdir[1300], p[1500], cwd[1100]; long a, total = 0; char *b = 0;
    if (wt_runcx() != 1 || cx_fmt(cwd, sizeof cwd, "%s", wt_top) || cov_dir(tag, dir, sizeof dir)) return -1;
    if (from_run && cov_flow(tag)) {
        cur_gate = "coveval"; slurp_okrc = 255; b = gate_slurp(0, &total); slurp_okrc = 0; cur_gate = 0;
        if (!b) return -1;
    } else {
    if (cx_fmt(tdir, sizeof tdir, "%s/tests", dir) || sy_mkdir(dir, 0700) || sy_mkdir(tdir, 0700)) return -1;
    cov_link_dir(cwd, dir, "tests", "", "", 0);
    { char s[1300]; if (cx_fmt(s, sizeof s, "%s/tests", cwd)) return -1; cov_link_dir(s, tdir, "batches.tsv", "coverage.tsv", "run.cx", 1); }
    { size_t sz = 0; char *src; if (cx_fmt(p, sizeof p, "%s/tests/run.cx", cwd)) return -1;
      src = (char *)cx_read(p, &sz); if (!src) return -1;
      if (cx_fmt(p, sizeof p, "%s/tests/run.cx", dir) || cx_write(p, src, sz)) return -1; }
    if (cx_fmt(p, sizeof p, "%s/tests/batches.tsv", dir) || cx_write(p, reg, (size_t)rn)) return -1;
    if (cx_fmt(p, sizeof p, "%s/tests/coverage.tsv", dir) || cx_write(p, cov, (size_t)cn)) return -1;
    if (cx_fmt(p, sizeof p, "%s/tests/run.cx", dir)) return -1;
    if (plan_dir && cov_flow(tag)) {
        char *gv[] = {"sh", "./unisacc.com", p, "--", "--list", 0}; long gn;
        cur_gate = "coveval"; mm_free(gate_slurp(gv, &gn)); cur_gate = 0;
        idv[0] = 0; return 0;
    }
    { int ofd, pid, ex = 0, code = 0, sig = 0; long r;
      char *ev[] = {"sh", "-c", "exec sh ./unisacc.com \"$0\" -- --list 2>&1", p, 0};
      b = mm_alloc(1 << 20);
      if (!b) return -1;
      pid = sy_spawn_pipe(ev, 0, 0, &ofd, 0);
      if (pid < 0) { mm_free(b); return -1; }
      { long deadline = sy_now_ms() + 30000;
        for (;;) { sy_pollfd_t pf; long left = deadline - sy_now_ms(); pf.fd = ofd; pf.events = SY_POLLIN; pf.revents = 0;
          if (left <= 0 || sy_poll(&pf, 1, left) <= 0) { sy_close(ofd); sy_kill(pid); mm_free(b); return -1; }
          r = sy_read(ofd, b + total, (1 << 20) - 1 - total); if (r <= 0) break; total += r; if (total >= (1 << 20) - 2) break; } }
      sy_close(ofd); sy_wait_status(pid, 0, &ex, &code, &sig); b[total] = 0; }
    }
    { a = tx_find(b, total, "unknown-coverage row=", 21);
      idv[0] = 0;
      if (a >= 0) { long q = tx_find(b + a, total - a, " id=", 4), k = 0;
        if (q >= 0) { q += a + 4; while (q + k < total && b[q + k] != '\n' && k < idcap - 1) { idv[k] = b[q + k]; k++; } idv[k] = 0; }
        mm_free(b); return 1; }
      { long r = tx_find(b, total, "\nREFUSE\t", 8), k = 0;   /* 其他拒绝(环境类或别的注册表缺陷,行首 REFUSE):返回 2,*idv 放具名原因 */
        if (r >= 0) r++; else if (total >= 7 && tx_same(b, 7, "REFUSE\t", 7)) r = 0;
        if (r >= 0) { r += 7; while (r + k < total && b[r + k] != '\n' && k < idcap - 1) { idv[k] = b[r + k] == '\t' ? ' ' : b[r + k]; k++; } idv[k] = 0;
          mm_free(b); return 2; } }
      if (tx_find(b, total, "PLAN\tmetadata_valid=", 20) < 0) { mm_free(b); return -1; }
      mm_free(b); return 0; }
}
static int cov_gate(void) {
    char *ir, *ic, *hr = 0, *hc = 0; long irn, icn, hrn = 0, hcn = 0; char id[160], hid[160]; int ri, rh = 0;
    if (wt_runcx() != 1) { if (!plan_dir) sy_eprintf("precommit: COVGATE skipped=1 reason=no-tests/run.cx (fixture repo)\n"); return 0; }
    if (cov_blob("", "tests/batches.tsv", &ir, &irn) || cov_blob("", "tests/coverage.tsv", &ic, &icn)) {
        if (plan_dir) return 0;
        sy_eprintf("precommit: BLOCKED registry gate: cannot read staged tests/batches.tsv or tests/coverage.tsv\n"); return 1; }
    ri = cov_eval("idx", ir, irn, ic, icn, id, sizeof id);
    cov_clean("idx");
    if (plan_dir) return 0;
    if (ri == 2) { sy_eprintf("precommit: BLOCKED registry REFUSE: run.cx --list on the staged tables refused: %s\n", id); return 1; }
    if (ri < 0) { sy_eprintf("precommit: BLOCKED registry gate did not run: run.cx --list on the staged tables gave no verdict (timeout or no output)\n"); return 1; }
    if (ri != 1) return 0;
    if (!cov_blob("HEAD", "tests/batches.tsv", &hr, &hrn) && !cov_blob("HEAD", "tests/coverage.tsv", &hc, &hcn)) {
        rh = cov_eval("head", hr, hrn, hc, hcn, hid, sizeof hid);
        cov_clean("head");
    }
    if (rh == 1 && tx_eqz(hid, id)) return 0;   /* HEAD 已未覆盖:既存,不归咎 */
    { char key[160]; long at = 0, kn = 0; key[0] = 0;   /* 取该批次覆盖列里第一个索引 coverage.tsv 没有的键 */
      while (at < irn) { long e = tx_chr(ir + at, irn - at, '\n'), l = e < 0 ? irn - at : e, fo, fl;
        if (l > 0 && ir[at] != '#' && !tx_field(ir + at, l, '\t', 0, &fo, &fl) && tx_same(ir + at + fo, fl, id, tx_len(id, 160)) &&
            !tx_field(ir + at, l, '\t', 10, &fo, &fl)) {
            long ki, nk = tx_fields(ir + at + fo, fl, ',');
            for (ki = 0; ki < nk; ki++) { long ko, kl; char kk[160];
              if (tx_field(ir + at + fo, fl, ',', ki, &ko, &kl) || kl <= 0 || kl >= 150) continue;
              mm_copy(kk, sizeof kk, ir + at + fo + ko, (size_t)kl); kk[kl] = 0;
              { long cat = 0; int has = 0; while (cat < icn) { long ce = tx_chr(ic + cat, icn - cat, '\n'), cl = ce < 0 ? icn - cat : ce, co, cfl;
                  if (cl > 0 && ic[cat] != '#' && !tx_field(ic + cat, cl, '\t', 0, &co, &cfl) && tx_same(ic + cat + co, cfl, kk, kl)) { has = 1; break; }
                  cat += cl + 1; }
                if (!has) { mm_copy(key, sizeof key, kk, (size_t)kl + 1); kn = kl; break; } } } break; }
        at += l + 1; }
      (void)kn;
      sy_eprintf("precommit: BLOCKED registry unknown-coverage: batch id=%s in the staged tests/batches.tsv has no coverage row %s in the staged tests/coverage.tsv (missing row is in tests/coverage.tsv)\n", id, key[0] ? key : "?");
      sy_eprintf("precommit: commit batches.tsv and coverage.tsv rows together: sh ./unisacc.com tools/commit-own.cx -- -m MSG --keyed tests/batches.tsv %s --keyed tests/coverage.tsv %s\n", id, key[0] ? key : "KEY");
    }
    return 1;
}

/* Explicit historical artifact format gate. The read set is declared in
 * tests/precommit-gates.tsv; no retired directory is required or read. The
 * immutable HEAD baseline remains the oracle, never the staged baseline. */
static int ledger_file_gate(const char *source,const char *baseline,long bn) {
    char lp[1200],bp[1200],*lb=0,*ro;long ln=0,rn2,at=0;int blocked=0;
    char *cv[]={"sh","./unisacc.com","tools/ledger-add.cx","--","--check","--ledger",lp,"--baseline",bp,0};
    if(cov_blob("",source,&lb,&ln)){sy_eprintf("precommit: BLOCKED ledger: cannot read staged %s\n",source);return 1;}
    if(cx_fmt(lp,sizeof lp,"%s/precommit-ledger-%d.tsv",sy_tmpdir(),sy_pid())||cx_fmt(bp,sizeof bp,"%s/precommit-ledger-%d.base",sy_tmpdir(),sy_pid())||cx_write(lp,lb,(size_t)ln)||cx_write(bp,baseline,(size_t)bn)){
        sy_eprintf("precommit: BLOCKED ledger: scratch files\n");mm_free(lb);return 1;}
    mm_free(lb);slurp_okrc=1;ro=slurp(cv,&rn2);slurp_okrc=0;sy_unlink(lp);sy_unlink(bp);
    if(!ro){sy_eprintf("precommit: BLOCKED ledger: explicit format check did not run or hard error\n");return 1;}
    while(at<rn2){long e=tx_chr(ro+at,rn2-at,'\n'),l=e<0?rn2-at:e;
        if(tx_prefix(ro+at,l,"LEDGER_COLS\t",12)&&tx_find(ro+at,l,"\tOVER",5)>=0){long c=12;while(c<l&&ro[at+c]!='\t')c++;
            sy_eprintf("precommit: BLOCKED ledger: staged %s has new rows with cols=%.*s (need 6) over the HEAD baseline: %.*s\n",source,(int)(c-12),ro+at+12,(int)l,ro+at);blocked++;}
        at+=l+1;}
    mm_free(ro);if(blocked)sy_eprintf("precommit: historical artifact; inspect with tools/ledger-add.cx -- --check --ledger FILE --baseline build/ledger-format-baseline.tsv\n");return blocked;
}
/* Derived-table precommit gate: when staged paths hit a derived table's inputs_glob in exec/facts/derive.tsv,
   run `tools/derive.cx -- --check --only ...` on those tables only (no cached verdict). Block on DRIFT/REFUSED,
   and also block if a table was recomputed in the worktree (OK) but its output was not staged. */
static void dg_today_ymd(char out[12]) {
    long long z = (long long)(sy_wall_s() / 86400) + 719468;
    long long era = (z >= 0 ? z : z - 146096) / 146097;
    long long doe = z - era * 146097;
    long long yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    long long y = yoe + era * 400;
    long long doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    long long mp = (5 * doy + 2) / 153;
    long long d = doy - (153 * mp + 2) / 5 + 1;
    long long m = mp + (mp < 10 ? 3 : -9);
    if (m <= 2) y++;
    (void)cx_fmt(out, 12, "%04lld-%02lld-%02lld", y, m, d);
}

static int dg_waived(const char *wt, const char *name) {
    char wp[1200], today[12];
    size_t wn = 0;
    char *wb;
    long at = 0, nl = tx_len(name, 64);
    int hit = 0;
    if (cx_fmt(wp, sizeof wp, "%s%stests/derive-gate-waivers.tsv", wt ? wt : "", wt ? "/" : "")) return 0;
    if (sy_exists(wp) != 1) return 0;
    wb = (char *)cx_read(wp, &wn);
    if (!wb) return 0;
    dg_today_ymd(today);
    while (at < (long)wn) {
        long e = tx_chr(wb + at, (long)wn - at, '\n'), l = e < 0 ? (long)wn - at : e;
        long o0, l0, o1, l1;
        if (l > 0 && wb[at] != '#' &&
            !tx_field(wb + at, l, '\t', 0, &o0, &l0) && l0 == nl && tx_same(wb + at + o0, l0, name, nl) &&
            !tx_field(wb + at, l, '\t', 1, &o1, &l1) && l1 == 10) {
            char exp[12];
            mm_copy(exp, sizeof exp, wb + at + o1, 10);
            exp[10] = 0;
            if (strcmp(today, exp) <= 0) { hit = 1; break; }
        }
        at += l + 1;
    }
    mm_free(wb);
    return hit;
}

static int dg_in_list(const char *list, const char *path, long pl) {
    long i = 0, n = tx_len(list, 1024);
    while (i < n) {
        long s;
        while (i < n && list[i] == ' ') i++;
        s = i;
        while (i < n && list[i] != ' ') i++;
        if (i > s && i - s == pl && tx_same(list + s, i - s, path, pl)) return 1;
    }
    return 0;
}

static int dg_path_in_z(const char *zbuf, long zn, const char *p, long pl) {
    long a = 0;
    while (a < zn) {
        long l = tx_len(zbuf + a, zn - a);
        if (l <= 0) break;
        if (l == pl && tx_same(zbuf + a, l, p, pl)) return 1;
        a += l + 1;
    }
    return 0;
}

static int dg_matches_globs(const char *globs, long gl, const char *path, long pl) {
    long i = 0;
    while (i < gl) {
        long s;
        while (i < gl && globs[i] == ' ') i++;
        s = i;
        while (i < gl && globs[i] != ' ') i++;
        if (i > s && glob_span(globs + s, (size_t)(i - s), path, (size_t)pl)) return 1;
    }
    return 0;
}

static int derive_gate(void) {
    const char *wt = sy_env("GIT_WORK_TREE");
    char dp[1200], tp[1200];
    size_t dn = 0;
    char *db = 0, *allz = 0, *adz = 0, *dout = 0;
    long alln = 0, adn = 0, don = 0, at = 0;
    char names[16][64], outs[16][512], only[1024];
    int nsel = 0, blocked = 0;

    if (cx_fmt(dp, sizeof dp, "%s%sexec/facts/derive.tsv", wt ? wt : "", wt ? "/" : "") ||
        cx_fmt(tp, sizeof tp, "%s%stools/derive.cx", wt ? wt : "", wt ? "/" : "")) return 0;
    if (sy_exists(dp) != 1 || sy_exists(tp) != 1) return 0;

    {
        char *av1[] = {"git", "diff", "--cached", "--name-only", "-z", 0};
        char *av2[] = {"git", "diff", "--cached", "--name-only", "--diff-filter=AD", "-z", 0};
        allz = slurp(av1, &alln);
        if (!allz || alln <= 0) { if (allz) mm_free(allz); return 0; }
        adz = slurp(av2, &adn);
    }

    db = (char *)cx_read(dp, &dn);
    if (!db) { mm_free(allz); if (adz) mm_free(adz); return 0; }

    while (at < (long)dn && nsel < 16) {
        long e = tx_chr(db + at, (long)dn - at, '\n'), l = e < 0 ? (long)dn - at : e;
        long o0, l0, o3, l3, o4, l4, o5, l5;
        if (l > 0 && db[at] != '#' &&
            !tx_field(db + at, l, '\t', 0, &o0, &l0) && l0 > 0 && l0 < 64 &&
            !tx_field(db + at, l, '\t', 3, &o3, &l3) &&
            !tx_field(db + at, l, '\t', 4, &o4, &l4) && l4 > 0 && l4 < 512 &&
            !tx_field(db + at, l, '\t', 5, &o5, &l5) && l5 > 0) {
            char nm[64], outl[512];
            int skip = (l3 == 1 && db[at + o3] == '-') || (l3 >= 11 && tx_same(db + at + o3, 11, "query-only ", 11));
            mm_copy(nm, sizeof nm, db + at + o0, (size_t)l0); nm[l0] = 0;
            mm_copy(outl, sizeof outl, db + at + o4, (size_t)l4); outl[l4] = 0;
            if (!skip && !tx_eqz(nm, "tables-gen") && !dg_waived(wt, nm)) {
                int ad_only = tx_eqz(nm, "table-index");
                const char *srcz = ad_only ? adz : allz;
                long srcn = ad_only ? adn : alln;
                long pa = 0;
                int hit = 0;
                while (srcz && pa < srcn) {
                    long pl = tx_len(srcz + pa, srcn - pa);
                    if (pl <= 0) break;
                    if (!dg_in_list(outl, srcz + pa, pl) && dg_matches_globs(db + at + o5, l5, srcz + pa, pl)) {
                        hit = 1;
                        break;
                    }
                    pa += pl + 1;
                }
                if (hit) {
                    mm_copy(names[nsel], sizeof names[nsel], nm, (size_t)l0 + 1);
                    mm_copy(outs[nsel], sizeof outs[nsel], outl, (size_t)l4 + 1);
                    nsel++;
                }
            }
        }
        at += l + 1;
    }
    mm_free(db);
    if (adz) mm_free(adz);
    if (nsel == 0) { mm_free(allz); return 0; }

    only[0] = 0;
    for (int i = 0; i < nsel; i++) {
        long cur = tx_len(only, sizeof only);
        long nl = tx_len(names[i], 64);
        if (cur + nl + 2 < (long)sizeof only) {
            if (cur) only[cur++] = ',';
            mm_copy(only + cur, sizeof only - cur, names[i], (size_t)nl);
            only[cur + nl] = 0;
        }
    }

    {
        char *dv[] = {"sh", "./unisacc.com", "tools/derive.cx", "--", "--check", "--only", only, 0}; /* lint:allow R1-product precommit runs tools/derive.cx via checkout product */
        cur_gate = "derive";
        slurp_okrc = 2;
        dout = slurp(dv, &don);
        slurp_okrc = 0;
        cur_gate = 0;
    }
    if (plan_dir) {
        if (dout) mm_free(dout);
        mm_free(allz);
        return 0;
    }
    if (!dout || tx_find(dout, don, "DERIVE_SUMMARY\t", 15) < 0) {
        sy_eprintf("precommit: DERIVE_GATE_UNAVAILABLE only=%s (tools/derive.cx did not run; allowing commit)\n", only);
        if (dout) mm_free(dout);
        mm_free(allz);
        return 0;
    }

    for (int i = 0; i < nsel; i++) {
        long nl = tx_len(names[i], 64), da = 0;
        int saw = 0, ok = 0;
        char st[32];
        st[0] = 0;
        while (da < don) {
            long e = tx_chr(dout + da, don - da, '\n'), l = e < 0 ? don - da : e;
            long o1, l1, o2, l2;
            if (tx_prefix(dout + da, l, "DERIVE\t", 7) &&
                !tx_field(dout + da, l, '\t', 1, &o1, &l1) && l1 == nl && tx_same(dout + da + o1, l1, names[i], nl) &&
                !tx_field(dout + da, l, '\t', 2, &o2, &l2) && l2 > 0 && l2 < (long)sizeof st) {
                saw = 1;
                mm_copy(st, sizeof st, dout + da + o2, (size_t)l2);
                st[l2] = 0;
                ok = tx_eqz(st, "OK");
                break;
            }
            da += l + 1;
        }
        if (!saw || !ok) {
            int staged_any = 0;
            long oi = 0, ol = tx_len(outs[i], 512);
            while (oi < ol) {
                long os;
                while (oi < ol && outs[i][oi] == ' ') oi++;
                os = oi;
                while (oi < ol && outs[i][oi] != ' ') oi++;
                if (oi > os && dg_path_in_z(allz, alln, outs[i] + os, oi - os)) staged_any = 1;
            }
            if (saw && tx_eqz(st, "DRIFT")) {
                sy_eprintf("precommit: BLOCKED derived-table-drift name=%s outputs=%s (%s; run: sh ./unisacc.com tools/derive.cx -- --write --only %s)\n",
                    names[i], outs[i], staged_any ? "staged output still drifts" : "missing from staged paths", names[i]);
            } else {
                sy_eprintf("precommit: BLOCKED derived-table-check-failed name=%s status=%s (run: sh ./unisacc.com tools/derive.cx -- --write --only %s)\n",
                    names[i], saw ? st : "MISSING", names[i]);
            }
            blocked++;
        } else {
            /* OK in worktree: also verify no output has unstaged modifications relative to the index */
            long oi = 0, ol = tx_len(outs[i], 512);
            while (oi < ol) {
                long os;
                while (oi < ol && outs[i][oi] == ' ') oi++;
                os = oi;
                while (oi < ol && outs[i][oi] != ' ') oi++;
                if (oi > os && outs[i][oi - 1] != '/') {
                    char op[512];
                    char *uv[] = {"git", "diff", "--name-only", "--", op, 0};
                    long un = 0;
                    char *uo;
                    mm_copy(op, sizeof op, outs[i] + os, (size_t)(oi - os));
                    op[oi - os] = 0;
                    uo = slurp(uv, &un);
                    if (uo && un > 0) {
                        sy_eprintf("precommit: BLOCKED derived-table-unstaged name=%s output=%s (recomputed in worktree but not staged in this commit; stage it with this commit)\n",
                            names[i], op);
                        blocked++;
                    }
                    if (uo) mm_free(uo);
                }
            }
        }
    }
    mm_free(dout);
    mm_free(allz);
    return blocked;
}

static int ledger_gate(void) {
    char *names,*baseline=0;long dn,bn=0,at=0;int blocked=0;
    names=gate_diff("ledger",&dn);if(!names){sy_eprintf("precommit: git diff --cached (ledger) failed\n");return 1;}
    if(dn<=0||sy_exists("./unisacc.com")!=1||sy_exists("tools/ledger-add.cx")!=1){mm_free(names);return 0;}
    if(cov_blob("HEAD","build/ledger-format-baseline.tsv",&baseline,&bn)){mm_free(names);return 0;}
    while(at<dn){const char *source=names+at;long len=tx_len(source,dn-at);if(len<0){blocked++;break;}if(len)blocked+=ledger_file_gate(source,baseline,bn);at+=len+1;}
    mm_free(baseline);mm_free(names);return blocked;
}

/* 提交主路径走 flow(plans/devsvc.md 6 S3 第一阶段):无参数调用(.git/hooks/pre-commit 与 commit-own 的 --dry-run 都是)
 * 且暂存路径命中登记类门(manifest、tables、runlist 任一读集)时,转交 tools/precommit-flow.cx:各门成为同一 flow 的
 * 并发节点,判定仍只在本文件的 --from-run 一遍里做,输出与退出码即判定那一遍的。只动 .cx 或文档的提交留在串行路径
 * (实测 flow 对它们没有收益:ratchets 本身已并发,关键路径是 coreapi 单门)。返回 -1 = 走串行;否则是退出码。
 * UNISACC_PRECOMMIT_SERIAL=1 强制串行(对拍基准用);flow 基础设施不可用(rc 2、信号、起不来)时打一行并回退串行,
 * 两条路径跑的是同一批门,不存在少跑的出口。 */
#define FLOW_ROUTE_MS 120000   /* the whole flow pass (plan, nodes at 60 s each, judge); past it the flow is killed and the gates run serially */
static int flow_route(void) {
    static const char *g[3] = {"manifest", "tables", "runlist"};
    const char *ser = sy_env("UNISACC_PRECOMMIT_SERIAL");
    char vf[1200], want[40], *vb; size_t vn = 0;
    char *fv[] = {"/bin/sh", "./unisacc.com", "tools/precommit-flow.cx", "--", "--verdict", vf, 0};
    int i, hit = 0, pid, ex = 0, code = 0, sig = 0, judged;
    if (ser && ser[0] && ser[0] != '0') return -1;
    if (sy_exists("./unisacc.com") != 1 || sy_exists("tools/precommit-flow.cx") != 1 || sy_exists("tools/cxlib/flowexec.cx") != 1 ||
        sy_exists("ext/sysx/process.cx") != 1) return -1;   /* the flow engine's package roots: a fixture without them stays serial at once */
    for (i = 0; i < 3; i++) {
        long n; char *d = gate_diff(g[i], &n);
        if (!d) { hit = -1; break; }   /* the serial path reports the failure itself */
        if (n > 0) hit = 1;
        mm_free(d);
    }
    gt_na = 0; gt_nal[0] = 0;   /* probing only: the real pass counts NOT_AFFECTED again */
    if (hit <= 0) return -1;
    if (cx_fmt(vf, sizeof vf, "%s/precommit-route-%d.rc", sy_tmpdir(), sy_pid())) return -1;
    sy_unlink(vf);
    pid = sy_spawn_inherit(fv, -1);   /* bounded: FLOW_ROUTE_MS deadline below, then killed and counted as no verdict */
    if (pid < 0) { ex = 0; code = -1; }
    else {
        long deadline = sy_now_ms() + FLOW_ROUTE_MS; int w = 0;
        while ((w = sy_wait_status(pid, 1, &ex, &code, &sig)) == 0 && sy_now_ms() < deadline) sy_sleep_ms(20);
        if (w == 0) { sy_eprintf("precommit: tools/precommit-flow.cx timed out after %d ms\n", FLOW_ROUTE_MS); sy_kill(pid); sy_wait_status(pid, 0, 0, 0, 0); }
        if (w != pid) { ex = 0; code = -1; }
    }
    /* a verdict counts only when the judge pass ran: precommit-flow.cx then leaves RC<TAB>code in vf, equal to its exit code.
       Anything else (it did not compile, the flow engine failed, it was killed) is no verdict: run the same gates serially. */
    vb = (char *)cx_read(vf, &vn); sy_unlink(vf);
    judged = ex && (code == 0 || code == 1) && vb && !cx_fmt(want, sizeof want, "RC\t%d\n", code) && (long)vn == tx_len(want, 40) && tx_same(vb, (long)vn, want, (long)vn);
    mm_free(vb);
    if (!judged) {
        sy_eprintf("precommit: flow path unusable (tools/precommit-flow.cx rc=%d, no verdict), running the gates serially\n", ex ? code : -1);
        return -1;
    }
    return code;
}

/* -- --precheck PATH...(plans/devsvc.md 6 P6):把给定工作树路径放进一份私有临时索引(HEAD 树加这些路径),
 * 以 UNISACC_PRECOMMIT_SERIAL=1 重新跑本文件的无参门(同一份判定代码,不另抄),门的 COMMIT_PHASE 与 stderr
 * 追加进同一份日志,按出现顺序把 BLOCKED/REFUSE 行归到最近一道门。真索引不读不写;不缓存:每次实跑。
 * 总 deadline 55 秒(timeout -k 2 55),超时输出 PRECHECK_TIMEOUT 与已评估/未评估的门。 */
#define PRECHECK_DEADLINE_S "55"
static int precheck(int argc, char **argv) {
    char idx[512], log[512], sc[1600], *av[300]; size_t n = 0; long at = 0, total = 0, slow_ms = -1, rn0 = 0;
    const char *jd = sy_env("CLAUDE_JOB_DIR"); char *b; int k = 0, i, rc = -1, blocked = 0, timed = 0;
    char gname[16][32]; long gms[16]; int gblk[16], gend[16], ng = 0, cur = -1; char greason[16][200];
    char slow[32] = "none";
    if (argc < 3) { sy_eprintf("precommit: usage: precommit.cx -- --precheck PATH...\n"); return 2; }
    if (cx_fmt(idx, sizeof idx, "%s/precheck-%d.idx", (jd && jd[0]) ? jd : sy_tmpdir(), sy_pid()) ||
        cx_fmt(log, sizeof log, "%s/precheck-%d.log", (jd && jd[0]) ? jd : sy_tmpdir(), sy_pid())) return 2;
    if (idx[0] != '/') { sy_eprintf("precommit: precheck temp dir not absolute: %s\n", idx); return 2; }
    (void)sy_unlink(log);
    if (cx_fmt(sc, sizeof sc,
        "I=\"$1\"; L=\"$2\"; shift 2; export GIT_INDEX_FILE=\"$I\"; "
        "git read-tree HEAD >>\"$L\" 2>&1 && git add -A -- \"$@\" >>\"$L\" 2>&1 || { echo PRECHECK_RC=3 >>\"$L\"; rm -f \"$I\"; exit 0; }; "
        "UNISACC_PRECOMMIT_SERIAL=1 UNISACC_COMMIT_PHASE_LOG=\"$L\" timeout -k 2 " PRECHECK_DEADLINE_S
        " sh ./unisacc.com tools/precommit.cx >>\"$L\" 2>&1; echo PRECHECK_RC=$? >>\"$L\"; rm -f \"$I\"")) return 2;
    av[k++] = "sh"; av[k++] = "-c"; av[k++] = sc; av[k++] = "precheck"; av[k++] = idx; av[k++] = log;
    for (i = 2; i < argc && k < 298; i++) av[k++] = argv[i];
    av[k] = 0;
    {   long t0 = sy_now_ms(); char *o = slurp_run(av, &rn0); total = sy_now_ms() - t0; if (o) mm_free(o); }
    b = (char *)cx_read(log, &n);
    if (!b) { sy_printf("PRECHECK_SUMMARY blocked=1 total_ms=%ld slowest=none reason=no-log\n", total); return 1; }
    while (at < (long)n) {
        long e = at, l; while (e < (long)n && b[e] != '\n') e++; l = e - at;
        if (l > 25 && tx_same(b + at, 18, "COMMIT_PHASE\tname=", 18)) {
            long ns = at + 18, ne = ns; int g = -1;
            while (ne < e && b[ne] != '\t') ne++;
            for (i = 0; i < ng; i++) if (tx_len(gname[i], 32) == ne - ns && tx_same(gname[i], ne - ns, b + ns, ne - ns)) g = i;
            if (g < 0 && ng < 16 && ne - ns < 31) { g = ng++; mm_copy(gname[g], 32, b + ns, (size_t)(ne - ns)); gname[g][ne - ns] = 0; gms[g] = 0; gblk[g] = 0; gend[g] = 0; greason[g][0] = 0; }
            if (g >= 0) { long m = tx_find(b + ne, e - ne, "ms=", 3); cur = g;
                if (tx_find(b + ne, e - ne, "state=end", 9) >= 0) { gend[g] = 1; gms[g] = 0;
                    if (m >= 0) for (m += ne + 3; m < e && b[m] >= '0' && b[m] <= '9'; m++) gms[g] = gms[g] * 10 + (b[m] - '0'); } }
        } else if (l > 12 && tx_same(b + at, 12, "PRECHECK_RC=", 12)) {
            rc = 0; for (i = 12; i < l && b[at + i] >= '0' && b[at + i] <= '9'; i++) rc = rc * 10 + (b[at + i] - '0');
        } else if (tx_find(b + at, l, "BLOCKED", 7) >= 0 || tx_find(b + at, l, "REFUSE", 6) >= 0 || tx_find(b + at, l, "OVER", 4) >= 0 || tx_find(b + at, l, "precommit: blocked", 18) >= 0) {
            int g = cur;
            if (g < 0 && ng < 16) { g = ng++; mm_copy(gname[g], 32, "pre", 4); gms[g] = 0; gblk[g] = 0; gend[g] = 1; greason[g][0] = 0; }
            if (g >= 0 && !gblk[g]) { long cl = l < 190 ? l : 190; gblk[g] = 1; mm_copy(greason[g], 200, b + at, (size_t)cl); greason[g][cl] = 0;
                for (i = 0; i < cl; i++) if (greason[g][i] == '\t' || greason[g][i] == ' ') greason[g][i] = '_'; }
        }
        at = e + 1;
    }
    timed = (rc == 124 || rc == 137 || rc < 0);
    for (i = 0; i < ng; i++) {
        int bl = gblk[i] || !gend[i];
        sy_printf("PRECHECK gate=%s verdict=%s ms=%ld reason=%s\n", gname[i], bl ? "BLOCKED" : "PASS", gms[i],
                  gblk[i] ? greason[i] : (!gend[i] ? "not-finished" : "-"));
        blocked += bl; if (gms[i] > slow_ms) { slow_ms = gms[i]; mm_copy(slow, sizeof slow, gname[i], 32); }
    }
    if (rc > 0 && !timed && !blocked) { sy_printf("PRECHECK gate=other verdict=BLOCKED ms=0 reason=precommit_rc=%d_see_%s\n", rc, log); blocked++; }
    if (timed) {
        sy_printf("PRECHECK_TIMEOUT deadline_s=" PRECHECK_DEADLINE_S " evaluated=");
        for (i = 0; i < ng; i++) if (gend[i]) sy_printf("%s,", gname[i]);
        sy_printf(" unevaluated=");
        for (i = 0; i < ng; i++) if (!gend[i]) sy_printf("%s,", gname[i]);
        sy_printf("rest-of-gate-list log=%s\n", log); blocked++;
    }
    sy_printf("PRECHECK_SUMMARY blocked=%d total_ms=%ld slowest=%s rc=%d\n", blocked, total, slow, rc);
    mm_free(b);
    if (!blocked) (void)sy_unlink(log);
    return blocked ? 1 : 0;
}

int main(int argc, char **argv) {
    long sn, rn, at; int staged = 0, blocked = 0, lint_absent = 0;
    if (argc >= 2 && tx_eqz(argv[1], "--precheck")) return precheck(argc, argv);
    if (argc == 3 && tx_eqz(argv[1], "--plan")) plan_dir = argv[2];
    else if (argc == 3 && tx_eqz(argv[1], "--from-run")) from_run = argv[2];
    else if (argc == 2 && tx_eqz(argv[1], "--gates")) return gt_print();
    else if (argc != 1) { sy_eprintf("precommit: usage: precommit.cx [-- --plan DIR | --from-run DIR | --gates]\n"); return 2; }
    if (argc == 1) { int fr = flow_route(); if (fr >= 0) return fr; }
    char *rv[] = {"sh", "./unisacc.com", "tools/ratchets.cx", 0};
    char *fgv[] = {"sh", "./unisacc.com", "tools/facts-gen.cx", "--", "--check", ".", "pp-autoinc-gen", 0};
    char *lv[] = {"sh", "./unisacc.com", "tests/run.cx", "--", "--list", 0};
    char *names = gate_diff("cx", &sn), *rows;
    if (!names) { sy_eprintf("precommit: git diff --cached failed\n"); return 1; }
    for (at = 0; at < sn; ) { long l = tx_len(names + at, sn - at); if (l <= 0) break; staged++; at += l + 1; }
    { long a2;
      for (a2 = 0; a2 < sn; ) {
          long nl = tx_len(names + a2, sn - a2); if (nl <= 0) break;
          if (nl >= 3 && tx_same(names + a2 + nl - 3, 3, ".cx", 3)) {
              char spec[4410]; long j, bn, e; char *blob; char *sv[4];
              if (nl < 4398) {
                  spec[0] = ':'; for (j = 0; j < nl; j++) spec[j + 1] = names[a2 + j]; spec[nl + 1] = 0;
                  sv[0] = "git"; sv[1] = "show"; sv[2] = spec; sv[3] = 0;
                  blob = slurp(sv, &bn);
                  if (blob && bn >= 2 && blob[0] == '#' && blob[1] == '!') {
                      e = 0; while (e < bn && blob[e] != '\n') e++;
                      if (tx_find(blob, e, "bash", 4) >= 0 || tx_find(blob, e, "/sh", 3) >= 0 ||
                          tx_find(blob, e, "zsh", 3) >= 0 || tx_find(blob, e, "python", 6) >= 0 ||
                          tx_find(blob, e, "perl", 4) >= 0 || tx_find(blob, e, "node", 4) >= 0 ||
                          tx_find(blob, e, "bun", 3) >= 0) {
                          sy_eprintf("precommit: %.*s: .cx 只放 cx 源码,shell 薄入口用 .sh\n", (int)nl, names + a2);
                          blocked++;
                      }
                  }
              }
          }
          a2 += nl + 1;
      }
    }
    { /* 清单闸(DSG-REG1):暂存区动了 tests/manifests、三表之一时,按索引核对每份清单的三行俱在(reg-manifest --index) */
      long qn; char *qn_names = gate_diff("manifest", &qn);
      if (!qn_names) { sy_eprintf("precommit: BLOCKED git diff --cached (manifest read set) failed\n"); blocked++; }
      if (qn_names && qn > 0 && sy_exists("tools/reg-manifest.cx") == 1) {
          const char *tool = sy_env("UNISACC_REGM_TOOL"); char *rm[] = {"sh", "./unisacc.com", 0, "--", "--check", "--index", 0}; long rn2; char *ro;
          rm[2] = (char *)((tool && tool[0]) ? tool : "tools/reg-manifest.cx");
          cur_gate = "manifest"; slurp_okrc = 1; ro = gate_reuse("manifest", rm, &rn2); if (!ro) ro = slurp(rm, &rn2); slurp_okrc = 0; cur_gate = 0;
          if (!ro) { sy_eprintf("precommit: BLOCKED reg-manifest --check --index did not run or hard error\n"); blocked++; }
          else {
              long at3 = 0;
              while (at3 < rn2) { long e = tx_chr(ro + at3, rn2 - at3, '\n'), l = e < 0 ? rn2 - at3 : e;
                  if (tx_prefix(ro + at3, l, "MISSING\t", 8) || tx_prefix(ro + at3, l, "MISMATCH\t", 9)) {
                      sy_eprintf("precommit: BLOCKED registration manifest %.*s (commit the manifest's batch, coverage and packages rows together)\n", (int)l, ro + at3); blocked++; }
                  at3 += l + 1; }
              mm_free(ro);
          }
      }
      mm_free(qn_names);
    }
    { /* 生成闸(S7):暂存区动了 tests/manifests 或三张登记表之一时,按索引核对清单行与表逐字一致(tables-gen --check --index) */
      long gn; char *gn_names = gate_diff("tables", &gn);
      if (!gn_names) { sy_eprintf("precommit: BLOCKED git diff --cached (tables read set) failed\n"); blocked++; }
      if (gn_names && gn > 0 && sy_exists("tools/tables-gen.cx") == 1) {
          char *tg[] = {"sh", "./unisacc.com", "tools/tables-gen.cx", "--", "--check", "--index", 0}; long tn2; char *to;
          cur_gate = "tables"; slurp_okrc = 1; to = slurp(tg, &tn2); slurp_okrc = 0; cur_gate = 0;
          if (!to) { sy_eprintf("precommit: BLOCKED tables-gen --check --index did not run or hard error\n"); blocked++; }
          else {
              long at4 = 0;
              while (at4 < tn2) { long e = tx_chr(to + at4, tn2 - at4, '\n'), l = e < 0 ? tn2 - at4 : e;
                  if (tx_prefix(to + at4, l, "MISSING\t", 8) || tx_prefix(to + at4, l, "STALE\t", 6) || tx_prefix(to + at4, l, "MALFORMED\t", 10)) {
                      sy_eprintf("precommit: BLOCKED generated registration table %.*s (run tools/tables-gen.cx -- --write and stage the tables with the manifest)\n", (int)l, to + at4); blocked++; }
                  at4 += l + 1; }
              mm_free(to);
          }
      }
      { /* 工具清单闸(toolsreg):暂存区新增、删除、改名或改类型 tools/**.cx(读集 toolsreg),或 tables 门命中
           (登记表或批次表被改)时,tests/tools-compile.cx --shards 按索引清单对拍 tests/tools-compile-sources.tsv 与
           tools-compile 分片批次;任何 REFUSE(漏登记的新工具、删了未除名的工具、片数与批次不符)即拒并逐行具名。
           夹具仓没有 tests/tools-compile.cx 时不跑。实测 0.2 s(热编译缓存)。 */
        long tn; char *tnames = gate_diff("toolsreg", &tn);
        if (!tnames) { sy_eprintf("precommit: BLOCKED git diff --cached (toolsreg read set) failed\n"); blocked++; }
        else if ((tn > 0 || (gn_names && gn > 0)) && !toolsreg_here()) {
            /* fixture repo (the work-tree root, not the cwd, has no tests/tools-compile.cx): not applicable */
            if (!plan_dir) sy_eprintf("precommit: TOOLSREG skipped=1 reason=no-tests/tools-compile.cx (fixture repo)\n");
        }
        else if (tn > 0 || (gn_names && gn > 0)) {
            /* index-exact: the inventory is the index (GIT_DIR, GIT_INDEX_FILE made absolute), and the registry and
               batches tables are their staged blobs in a scratch root, so unstaged edits of either never sway the verdict */
            char *tv[] = {"sh", "-c",
                "g=$(git rev-parse --absolute-git-dir) || exit 3; t=$(pwd -P)/tests/tools-compile.cx;"
                " if [ -n \"$GIT_INDEX_FILE\" ]; then GIT_INDEX_FILE=$(cd \"$(dirname \"$GIT_INDEX_FILE\")\" && pwd -P)/$(basename \"$GIT_INDEX_FILE\") || exit 3; export GIT_INDEX_FILE; fi;"
                " d=$(mktemp -d) || exit 3; mkdir \"$d/tests\" && git show :tests/tools-compile-sources.tsv > \"$d/tests/tools-compile-sources.tsv\""
                " && git show :tests/batches.tsv > \"$d/tests/batches.tsv\" || { rm -rf \"$d\"; exit 3; };"
                " GIT_DIR=$g GIT_WORK_TREE=$d sh ./unisacc.com \"$t\" -- --shards \"$d\" 2>&1; r=$?; rm -rf \"$d\"; exit $r", 0}; long rn3; char *ro;
            if (tn <= 0) gt_unmark("toolsreg");
            cur_gate = "toolsreg"; slurp_okrc = 2; ro = slurp(tv, &rn3); slurp_okrc = 0; cur_gate = 0;
            if (!ro) { sy_eprintf("precommit: BLOCKED tools-compile --shards did not run or hard error\n"); blocked++; }
            else if (!plan_dir) {
                long at5 = 0; int refused = 0, shards = 0;
                while (at5 < rn3) { long e = tx_chr(ro + at5, rn3 - at5, '\n'), l = e < 0 ? rn3 - at5 : e, d = 0;
                    if (tx_find(ro + at5, l, "REFUSE", 6) >= 0) {
                        sy_eprintf("precommit: BLOCKED tools-compile registry %.*s (register the new tool with sh ./unisacc.com tools/register.cx -- --tool tools/NAME.cx, which adds the tests/tools-compile-sources.tsv row and the tools-compile-NNN batches; stage them with the tool. Never pass an existing source as the output of tests/tools-compile.cx --register)\n", (int)l, ro + at5);
                        refused = 1; }
                    while (d < l && ro[at5 + d] >= '0' && ro[at5 + d] <= '9') d++;
                    if (l > 0 && d == l) shards = 1;
                    at5 += l + 1; }
                if (!refused && !shards) { sy_eprintf("precommit: BLOCKED tools-compile --shards gave no shard count: %.*s\n", (int)(rn3 > 300 ? 300 : rn3), ro); refused = 1; }
                blocked += refused;
            }
            mm_free(ro);
        }
        mm_free(tnames);
      }
      mm_free(gn_names);
    }
    { long msn; char *mnames = gate_diff("runlist", &msn);
      if (!mnames) { sy_eprintf("precommit: git diff --cached (metadata) failed\n"); return 1; }
      if (msn > 0 && wt_runcx() != 1) {
          if (!plan_dir) sy_eprintf("precommit: RUNLIST skipped=1 reason=no-tests/run.cx at work tree root (fixture repo)\n");
      } else if (msn > 0) {
          char *lout; long ln;
          blocked += cov_gate();
          cur_gate = "runlist"; lout = slurp(lv, &ln); cur_gate = 0;          if (!lout) { sy_eprintf("precommit: tests/run.cx --list did not run\n"); return 1; }
          if (tx_find(lout, ln, "metadata_valid=1", 16) < 0) {
              long at2 = 0;
              sy_eprintf("precommit: tests/run.cx --list metadata_valid!=1\n");
              while (at2 < ln) {
                  long e = tx_chr(lout + at2, ln - at2, '\n'), l = e < 0 ? ln - at2 : e;
                  if (tx_find(lout + at2, l, "REFUSE", 6) >= 0 || tx_find(lout + at2, l, "row=", 4) >= 0)
                      sy_eprintf("precommit: %.*s\n", (int)l, lout + at2);
                  at2 += l + 1;
              }
              blocked++;
          }
      }
    }
    /* facts gate: a commit touching include/ or exec/facts/ must leave the generated pp-autoinc-gen table
       in sync. The FTRIM/libc anchors are baked into that table from every .h's raw #if lines, so an out-of-
       sync table silently breaks dead-code elimination (see items.tsv FTRIM-ANCHOR). Run facts-gen --check
       and refuse a DIFF; this is what catches a stale facts table before it rides into main. */
    { long fsn; char *fnames = gate_diff("facts", &fsn);
      if (!fnames) { sy_eprintf("precommit: git diff --cached (facts) failed\n"); return 1; }
      if (fsn > 0) {
          char *frows; cur_gate = "facts"; frows = slurp(fgv, &rn); cur_gate = 0;
          if (!frows) { sy_eprintf("precommit: tools/facts-gen.cx did not run\n"); return 1; }
          if (tx_prefix(frows, rn, "DIFF", 4)) {
              sy_eprintf("precommit: facts-gen --check pp-autoinc-gen DIFF; run tools/facts-gen.cx -- --write ROOT pp-autoinc-gen\n");
              blocked++;
          }
      }
    }
    blocked += freeze_gate();
    blocked += ledger_gate();
    blocked += derive_gate();
    if (!plan_dir) gt_line();
    if (!staged) { sy_printf("PRECOMMIT\tstaged_cx=0\tblocked=%d\n", blocked); return blocked ? 1 : 0; }
    blocked += new_tools();
    blocked += tlib_frozen_gate(names, sn);
    blocked += lint_gate(names, sn, &lint_absent);
    if (lint_absent) sy_eprintf("precommit: lint=absent (no ./unisacc.com or tools/cx-lint.cx in cwd)\n");
    /* 不再因「只改 tools/tests」而短路:cxtrunc/cxapis/outdep 本来就面向 tools/tests(fable 咨询 2026-11-08)。 */
    { char rp[1200]; const char *wt = sy_env("GIT_WORK_TREE"); int ex;   /* 工作树里有没有棘轮:夹具仓(GIT_WORK_TREE)无则跳过 */
      if (cx_fmt(rp, sizeof rp, "%s%stools/ratchets.cx", wt ? wt : "", wt ? "/" : "")) { sy_eprintf("precommit: path too long\n"); return 1; }
      ex = sy_exists(rp);   /* 1 存在;0 仅 ENOENT;负数=其他错误,必须报告 */
      if (ex < 0) { sy_eprintf("precommit: tools/ratchets.cx unreadable (%d)\n", ex); return 1; }
      if (ex == 0) { sy_printf("PRECOMMIT\tstaged_cx=%d\tblocked=%d\tratchets=absent\n", staged, blocked); return blocked ? 1 : 0; } }
    cur_gate = "ratchets"; slurp_okrc = 1; rows = slurp(rv, &rn); slurp_okrc = 0; cur_gate = 0;   /* ratchets 退出码 1=有红行(输出仍要读),>=2 或信号=没跑 */
    if (!rows) { sy_eprintf("precommit: tools/ratchets.cx did not run\n"); return 1; }
    blocked += incomplete(rows, rn, "RATCHETS\tok=", "ratchets");
    for (at = 0; at < rn; ) {   /* offending rows are indented by two spaces: "  NAME: PATH has ..." */
        long e = tx_chr(rows + at, rn - at, '\n'), l = e < 0 ? rn - at : e, s;
        const char *r = rows + at;
        if (l > 2 && r[0] == ' ' && r[1] == ' ' && (s = tx_chr(r, l, ':')) > 0 && s + 2 < l) {
            long p = s + 2, q, a2;
            int soft = tx_prefix(r + 2, l - 2, "cxlibc:", 7) || tx_prefix(r + 2, l - 2, "cxraw:", 6);   /* printf 类对 tools/tests 仍豁免 */
            int byfile = tx_prefix(r + 2, l - 2, "outdep:", 7);   /* outdep 行以批次名开头,路径在 "in PATH" 里 */
            if (tx_prefix(r + p, l - p, "module ", 7)) p += 7;
            q = p; while (q < l && r[q] != ' ') q++;
            for (a2 = 0; a2 < sn; ) {
                long nl = tx_len(names + a2, sn - a2);
                if (nl <= 0) break;
                if (tx_same(names + a2, nl, r + p, q - p) || (byfile && tx_find(r, l, names + a2, nl) >= 0)) {
                    int toolish = tx_prefix(names + a2, nl, "tools/", 6) || tx_prefix(names + a2, nl, "tests/", 6);
                    if (!toolish || !soft) {
                        sy_eprintf("precommit: blocked:%.*s\n", (int)(l - 1), r + 1); blocked++;
                    }
                    break;
                }
                a2 += nl + 1;
            }
        }
        at += l + 1;
    }
    sy_printf("PRECOMMIT\tstaged_cx=%d\tblocked=%d\n", staged, blocked);
    if (blocked) sy_eprintf("precommit: this commit takes cx files over a ratchet (traditional C back in). Use cx/sys, cx/mem, cx/text\n"
                            "  (sy_*/mm_*/tx_*), put platform differences in L0 or tables, and see prd.md 能力速查; run tools/ratchets.cx.\n");
    return blocked ? 1 : 0;
}
