/* check-slow-dryrun: the work-directory guard refuses anything outside out/ or tmp/.
 * Two refusals (repo-root relative, absolute /tmp) plus the default path, all
 * without starting a construction step.
 *   sh ./unisacc.com tools/check-slow-dryrun.cx
 */
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use text.text

#define CAP (1L << 14)
static char out[CAP];
static int failed;
static void ck(int ok, const char *n) { if (!ok) failed++; printf("%s\tslow-dryrun.%s\n", ok ? "PASS" : "FAIL", n); }

static char argbuf[64][256];

static int run(char **av) {
    char *argv[12]; int i = 0, ofd, efd, pid, ex = 0, code = 0, sig = 0; long n = 0, r; char junk[2048];
    argv[i++] = "sh"; argv[i++] = "./unisacc.com"; argv[i++] = "tools/slow-dryrun.cx"; argv[i++] = "--";
    /* copy each value: a synthetic system cannot reorder args safely */
    for (int k = 0; av[k] && i < 10; k++) { long j = 0; while (av[k][j] && j < 255) { argbuf[k][j] = av[k][j]; j++; } argbuf[k][j] = 0; argv[i++] = argbuf[k]; }
    argv[i] = 0;
    pid = sy_spawn_pipe(argv, 0, SY_SPAWN_STDERR_SPLIT, &ofd, &efd);
    if (pid < 0) return -1;
    while (n < CAP - 1 && (r = sy_read(ofd, out + n, CAP - 1 - n)) > 0) n += r;
    out[n] = 0;
    while (sy_read(ofd, junk, sizeof junk) > 0) {}
    while (sy_read(efd, junk, sizeof junk) > 0) {}
    sy_close(ofd); sy_close(efd);
    if (sy_wait_status(pid, 0, &ex, &code, &sig) != pid || !ex) return -1;
    return code;
}
static int has(const char *s) { return tx_find(out, tx_len(out, CAP), s, tx_len(s, 256)) >= 0; }

int main(void) {
    { char *a1[] = { "--steps", "7-7", "--work", "7-7", 0 };
      int rc1 = run(a1); ck(rc1 == 4 && has("SLOW_DRYRUN_REFUSE"), "refuse-repo-root"); }
    { char *a2[] = { "--work", "/tmp/x", "--steps", "7-7", 0 };
      int rc2 = run(a2); ck(rc2 == 4 && has("SLOW_DRYRUN_REFUSE"), "refuse-absolute-tmp"); }
    { char *a3[] = { "--steps", "7-7", "--work", "out/slow-dryrun-work", 0 };
      int rc3 = run(a3); ck(rc3 == 0 && has("SLOW_DRYRUN_TIMING_ONLY"), "accepts-out"); }
    /* The pack stage takes target ids with hyphens (lnx-arm64); a slash form
       (lnx/arm64) makes source-package-pack die with unknown-target, which cost
       one full gate run before it was noticed. */
    {
        size_t sz = 0; char *src = cx_read("tools/slow-dryrun.cx", &sz); int bad = 0;
        if (src) {
            static const char *want[] = { "\"lnx-arm64\"", "\"lnx-x86_64\"", "\"osx-arm64\"",
                                          "\"osx-x86_64\"", "\"win-arm64\"", "\"win-x86_64\"", 0 };
            int i;
            for (i = 0; want[i]; i++)
                if (tx_find(src, sz, want[i], tx_len(want[i], 32)) < 0) bad = 1;
            if (tx_find(src, sz, "\"lnx/arm64\"", 12) >= 0) bad = 1;
            free(src);
        } else bad = 1;
        ck(!bad, "route-ids-use-hyphens");
    }
    /* The pack stage verifies every model-* phase before any route, so the
       recipe list must cover all 37 recipes; a short list fails much later with
       an unrelated-looking canonical-input-path-required. */
    {
        size_t sz = 0; char *src = cx_read("tools/slow-dryrun.cx", &sz); int bad = 0, cnt = 0;
        if (src) {
            static const char *must[] = { "\"shared-e3\"", "\"shared-o1\"", "\"shared-nativeabi\"",
                                          "\"lnx-x86_64-elf\"", "\"win-x86_64-elf\"", "\"tokenlex\"",
                                          "\"hostsymbols\"", 0 };
            int i;
            for (i = 0; must[i]; i++)
                if (tx_find(src, sz, must[i], tx_len(must[i], 32)) < 0) bad = 1;
            /* count the quoted ids between the recipes[] brace pair */
            {
                long a = tx_find(src, sz, "static const char *recipes[]", 27);
                if (a < 0) bad = 1;
                else {
                    long e = a;
                    while (e < (long)sz && src[e] != '}') e++;
                    { long k; for (k = a; k < e; k++) if (src[k] == '"') cnt++; }
                    if (cnt / 2 < 37) bad = 1;
                }
            }
            free(src);
        } else bad = 1;
        ck(!bad, "recipes-cover-all-models");
    }
    printf("SLOW_DRYRUN_CHECKS\tassertions=5\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
