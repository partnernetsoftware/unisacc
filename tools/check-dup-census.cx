/* tools/check-dup-census.cx -- checks tools/dup-census.cx (the 15th ratchet).
 *
 *   sh ./unisacc.com tools/check-dup-census.cx [-- --group a|b|c|d|e]     (no group: all)
 *
 * a counts: a fixture root (tools/a.cx, tools/b.cx, tools/cxlib/c.cx) with foo byte-identical in 3 files, bar
 *   with the same name but different bodies in 2, a brace inside a string literal and one "%s/%s"; --print
 *   gives GROUP foo 3 3 9 6, no bar group, the exact DUP_SUMMARY and FRAG path.fmt-join 1 1.
 * b baseline: after --write --check is ok; one more copy of foo fails "foo has 4 verbatim copies, baseline 3"
 *   (grown=1, rc 1); a new verbatim pair fails new=1; removing copies passes (only go down); a missing baseline
 *   and an unknown option exit 2.
 * c verbatim: a copy differing by one space or by name is not in the group; a comment line before the function
 *   does not split it; on this checkout --check is ok and --print ends with DUP_SUMMARY.
 * d whitelist: build/dup-census-whitelist.tsv (name<TAB>reason<TAB>verified_date) marks matched functions
 *   whitelisted=N and excludes them from ratchet failure without masking other duplicates; missing reason or
 *   verified_date exits 2; source mutations disabling whitelist lookup or date validation are killed.
 * Ends with CHECK_DUP_CENSUS<TAB>failed=N. */
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.posix
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

static int dc_failed;
static char dc_out[1 << 16];
static char dc_root[600];
static void dc_ck(int ok, const char *name) { if (!ok) dc_failed++; printf("%s\tdup-census.%s\n", ok ? "PASS" : "FAIL", name); }
static int dc_has(const char *s) { long n = tx_len(dc_out, sizeof dc_out), sn = tx_len(s, 400), i; for (i = 0; i + sn <= n; i++) if (mm_same(dc_out + i, s, sn)) return 1; return 0; }
static int dc_run_tool4(const char *tool, char *a1, char *a2, char *a3, char *a4) {
    char *v[] = {"./tools/bound", "50", "sh", "./unisacc.com", (char *)tool, "--", a1, a2, a3, a4, 0};
    int fd, pid, ex = 0, code = 0, sig = 0; long n = 0, r;
    pid = sy_spawn_pipe(v, 0, 0, &fd, 0);
    if (pid < 0) return -1;
    while ((r = sy_read(fd, dc_out + n, (long)sizeof dc_out - 1 - n)) > 0) n += r;
    dc_out[n] = 0; sy_close(fd);
    if (sy_wait_status(pid, 0, &ex, &code, &sig) != pid || !ex) return -1;
    return code;
}
static int dc_run_tool(const char *tool, char *a1, char *a2, char *a3) {
    return dc_run_tool4(tool, a1, a2, a3, 0);
}
static int dc_run(char *a1, char *a2, char *a3) {
    return dc_run_tool("tools/dup-census.cx", a1, a2, a3);
}
static void dc_put(const char *rel, const char *s) { char p[700]; if (!cx_fmt(p, sizeof p, "%s/%s", dc_root, rel)) cx_write(p, s, tx_len(s, 1 << 16)); }
static void dc_rm(const char *rel) { char p[700]; if (!cx_fmt(p, sizeof p, "%s/%s", dc_root, rel)) sy_unlink(p); }

#define FOO "static int foo(int x) {\n    return x;\n}\n"
#define FITS "static int fits(int n) {\n    return n < 8;\n}\n"
#define PUT_FN "static void put(const char *p) {\n    (void)p;\n}\n"

static void dc_fixture(void) {
    char p[700];
    cx_fmt(dc_root, sizeof dc_root, "%s/dupcensus-%d", sy_tmpdir(), (int)sy_pid());
    sy_mkdir(dc_root, 0700);
    cx_fmt(p, sizeof p, "%s/tools", dc_root); sy_mkdir(p, 0700);
    cx_fmt(p, sizeof p, "%s/tools/cxlib", dc_root); sy_mkdir(p, 0700);
    cx_fmt(p, sizeof p, "%s/build", dc_root); sy_mkdir(p, 0700);
    dc_put("tools/a.cx", "/* a */\n" FOO "static int bar(void) { return 1; }\nstatic void s(void) {\n    puts(\"}\");\n    puts(\"%s/%s\");\n}\n");
    dc_put("tools/b.cx", FOO "static int bar(void) { return 2; }\n");
    dc_put("tools/cxlib/c.cx", "/* c */\n" FOO);
}
static void dc_cleanup(void) {
    char p[700];
    dc_rm("tools/a.cx"); dc_rm("tools/b.cx"); dc_rm("tools/d.cx"); dc_rm("tools/e.cx"); dc_rm("tools/f.cx"); dc_rm("tools/cxlib/c.cx");
    dc_rm("build/dup-census-baseline.tsv");
    dc_rm("build/dup-census-whitelist.tsv");
    dc_rm("mut1.cx"); dc_rm("mut2.cx"); dc_rm("mut3.cx"); dc_rm("mut4.cx"); dc_rm("cxroot.tsv"); dc_rm("r");
    cx_fmt(p, sizeof p, "%s/tools/cxlib", dc_root); sy_rmdir(p);
    cx_fmt(p, sizeof p, "%s/tools", dc_root); sy_rmdir(p);
    cx_fmt(p, sizeof p, "%s/build", dc_root); sy_rmdir(p);
    sy_rmdir(dc_root);
}

static int dc_write_mutant(const char *rel, const char *needle, const char *repl, char *out_path, long cap) {
    size_t n = 0;
    char *src = cx_read("tools/dup-census.cx", &n);
    long sn, nn, rn, pos = -1, i;
    char *mut;
    if (!src) return -1;
    sn = (long)n;
    nn = tx_len(needle, 512);
    rn = tx_len(repl, 512);
    for (i = 0; i + nn <= sn; i++) {
        if (mm_same(src + i, needle, nn)) { pos = i; break; }
    }
    if (pos < 0) { mm_free(src); return -1; }
    mut = mm_alloc((size_t)(sn - nn + rn + 1));
    if (!mut) { mm_free(src); return -1; }
    mm_copy(mut, (size_t)(sn - nn + rn + 1), src, pos);
    mm_copy(mut + pos, (size_t)(sn - nn + rn + 1 - pos), repl, rn);
    mm_copy(mut + pos + rn, (size_t)(sn - pos - nn + 1), src + pos + nn, sn - pos - nn);
    mut[sn - nn + rn] = 0;
    mm_free(src);
    if (cx_fmt(out_path, (size_t)cap, "%s/%s", dc_root, rel)) { mm_free(mut); return -1; }
    if (cx_write(out_path, mut, (size_t)(sn - nn + rn))) { mm_free(mut); return -1; }
    mm_free(mut);
    return 0;
}

static void dc_prep_mut_root(void) {
    char cwd[1024], rlink[700];
    if (sy_realpath(".", cwd, sizeof cwd) >= 0 && !cx_fmt(rlink, sizeof rlink, "%s/r", dc_root)) {
        sy_unlink(rlink);
        sy_symlink(cwd, rlink);
    }
    dc_put("cxroot.tsv",
        "CXROOT1\n"
        "R\tsys\tr/cx/sys\n"
        "R\tmem\tr/cx/mem\n"
        "R\ttext\tr/cx/text\n"
        "R\tcore\tr/cx/core\n"
        "R\truntime\tr/cx/runtime\n"
        "R\tdriver\tr/cx/driver\n"
        "R\tcompiler\tr/cx/compiler\n"
        "R\tworkspace\tr/cx/workspace\n"
        "R\tcx0\tr/cx/cx0\n"
        "R\tstream\tr/cx/stream\n"
        "R\tpath\tr/cx/path\n"
        "R\tos\tr/cx/os\n"
        "R\tsysx\tr/ext/sysx\n"
        "R\tcrypto\tr/ext/crypto\n"
        "R\tcxlib\tr/tools/cxlib\n"
        "R\ttsvx\tr/ext/tsvx\n"
        "R\ttestx\tr/ext/testx\n"
        "R\ttextx\tr/ext/textx\n"
        "R\tsqlite\tr/ext/sqlite\n"
        "R\tnet\tr/ext/net\n");
}

static void group_a(void) {
    int rc;
    dc_fixture();
    rc = dc_run("--print", "--root", dc_root);
    dc_ck(rc == 0 && dc_has("GROUP\tfoo\t3\t3\t9\t6\n") && !dc_has("GROUP\tbar\t"), "fixture-verbatim-group-counted");
    dc_ck(dc_has("DUP_SUMMARY files=3 static_fn=6 dup_names=2 dup_defs=5 excess_lines=") && dc_has(" verbatim_groups=1 verbatim_defs=3 verbatim_lines=9 verbatim_redundant=6\n"), "fixture-summary");
    dc_ck(dc_has("FRAG\tpath.fmt-join\t1\t1\n") && dc_has("FRAG\ttmp.literal\t0\t0\n"), "fixture-fragments");
    dc_cleanup();
}
static void group_b(void) {
    int rc;
    dc_fixture();
    rc = dc_run("--check", "--root", dc_root);
    dc_ck(rc == 2, "missing-baseline-exit-2");
    rc = dc_run("--write", "--root", dc_root);
    dc_ck(rc == 0 && dc_has("DUP_CENSUS_WRITE\tgroups=1\tredundant=6\n"), "write-baseline");
    rc = dc_run("--check", "--root", dc_root);
    dc_ck(rc == 0 && dc_has("dup-census: ok: verbatim_groups=1 (baseline 1) verbatim_redundant=6 (baseline 6)"), "check-ok-after-write");
    dc_put("tools/d.cx", FOO);
    rc = dc_run("--check", "--root", dc_root);
    dc_ck(rc == 1 && dc_has("dup-census: foo has 4 verbatim copies, baseline 3\n") && dc_has("dup-census: tools total lines verbatim_redundant 9, baseline 6\n") && dc_has("FAIL: new=0 grown=1"), "more-copies-fails-grown");
    dc_put("tools/d.cx", "static int qux(void) {\n    return 7;\n}\n");
    dc_put("tools/e.cx", "static int qux(void) {\n    return 7;\n}\n");
    rc = dc_run("--check", "--root", dc_root);
    dc_ck(rc == 1 && dc_has("dup-census: qux has 2 verbatim copies, baseline 0\n") && dc_has("FAIL: new=1 grown=0 groups=2 baseline=1"), "new-group-fails-new");
    dc_rm("tools/d.cx"); dc_rm("tools/e.cx"); dc_put("tools/b.cx", "static int bar(void) { return 2; }\n");
    rc = dc_run("--check", "--root", dc_root);
    dc_ck(rc == 0 && dc_has("dup-census: ok: verbatim_groups=1 (baseline 1) verbatim_redundant=3 (baseline 6)"), "fewer-copies-pass-only-down");
    rc = dc_run("--bogus", 0, 0);
    dc_ck(rc == 2, "unknown-option-exit-2");
    dc_cleanup();
}
static void group_d(void) {
    int rc;
    char mut1[750], mut2[750];
    dc_fixture();
    rc = dc_run("--write", "--root", dc_root);
    dc_ck(rc == 0, "whitelist-setup-baseline");

    dc_put("tools/d.cx", FOO FITS PUT_FN);
    dc_put("tools/e.cx", FITS PUT_FN);
    rc = dc_run("--check", "--root", dc_root);
    dc_ck(rc == 1 && dc_has("FAIL: new=2 grown=1"), "unwhitelisted-fits-put-foo-fails");

    dc_put("build/dup-census-whitelist.tsv",
        "# surface duplicates and net-loss merges\n"
        "name\treason\tverified_date\n"
        "foo\tfixture growth exempted for net-loss merge test\t2026-11-22\n"
        "fits\t31 份一行一致合并净亏\t2026-11-22\n"
        "put\t三种契约有的建父目录有的不建不可合并\t2026-11-22\n");
    rc = dc_run("--check", "--root", dc_root);
    dc_ck(rc == 0 &&
          dc_has("dup-census: fits whitelisted=1 (copies=2)\n") &&
          dc_has("dup-census: foo whitelisted=1 (copies=4)\n") &&
          dc_has("dup-census: put whitelisted=1 (copies=2)\n") &&
          dc_has("dup-census: ok: verbatim_groups=0 (baseline 0) verbatim_redundant=0 (baseline 0) whitelisted=3\n"),
          "whitelist-exempts-fits-put-foo");

    rc = dc_run("--print", "--root", dc_root);
    dc_ck(rc == 0 &&
          dc_has("WHITELIST\tfits\twhitelisted=1\tcopies=2\tredundant=3\n") &&
          dc_has("WHITELIST\tput\twhitelisted=1\tcopies=2\tredundant=3\n") &&
          dc_has(" whitelisted=3\n"),
          "whitelist-print-marks-whitelisted");

    // Non-whitelisted duplicate must still fail ratchet
    dc_put("tools/f.cx", "static int rogue_dup(void) {\n    return 9;\n}\n");
    dc_put("tools/e.cx", FITS PUT_FN "static int rogue_dup(void) {\n    return 9;\n}\n");
    rc = dc_run("--check", "--root", dc_root);
    dc_ck(rc == 1 && dc_has("dup-census: rogue_dup has 2 verbatim copies, baseline 0\n") && dc_has("FAIL: new=1 grown=0") && dc_has("whitelisted=3\n"),
          "whitelist-does-not-mask-other-duplicates");
    dc_rm("tools/f.cx");
    dc_put("tools/e.cx", FITS PUT_FN);

    // Mutation 1: disable whitelist check in --check -> must fail on whitelisted fixture (mutant killed)
    dc_prep_mut_root();
    if (!dc_write_mutant("mut1.cx", "if (dc_wl_has(s, l)) { wl_groups += h - g; wl_red += wred;", "if (0 && dc_wl_has(s, l)) { wl_groups += h - g; wl_red += wred;", mut1, sizeof mut1)) {
        rc = dc_run_tool(mut1, "--check", "--root", dc_root);
        dc_ck(rc == 1 && dc_has("FAIL: new=2 grown=1"), "mutant-disable-whitelist-killed");
    } else {
        dc_ck(0, "mutant-disable-whitelist-killed");
    }

    // Missing reason / missing verified_date / malformed verified_date refusals (rc 2)
    dc_put("build/dup-census-whitelist.tsv", "name\treason\tverified_date\nfits\t\t2026-11-22\n");
    rc = dc_run("--check", "--root", dc_root);
    dc_ck(rc == 2, "whitelist-empty-reason-refused");

    dc_put("build/dup-census-whitelist.tsv", "name\treason\tverified_date\nfits\t-\t2026-11-22\n");
    rc = dc_run("--check", "--root", dc_root);
    dc_ck(rc == 2, "whitelist-dash-reason-refused");

    dc_put("build/dup-census-whitelist.tsv", "name\treason\tverified_date\nfits\tmerge net loss\t\n");
    rc = dc_run("--check", "--root", dc_root);
    dc_ck(rc == 2, "whitelist-empty-date-refused");

    dc_put("build/dup-census-whitelist.tsv", "name\treason\tverified_date\nfits\tmerge net loss\t20261122\n");
    rc = dc_run("--check", "--root", dc_root);
    dc_ck(rc == 2, "whitelist-malformed-date-refused");

    dc_put("build/dup-census-whitelist.tsv", "name\treason\tverified_date\nfits\tmerge net loss\n");
    rc = dc_run("--check", "--root", dc_root);
    dc_ck(rc == 2, "whitelist-missing-column-refused");

    // Mutation 2: disable verified_date check -> accepts malformed date instead of rc 2 (mutant killed)
    dc_put("build/dup-census-whitelist.tsv",
        "name\treason\tverified_date\n"
        "foo\tnet loss\tbad-date\n"
        "fits\tnet loss\tbad-date\n"
        "put\tdistinct contracts\tbad-date\n");
    if (!dc_write_mutant("mut2.cx", "if (!dc_wl_date(t + at + o2, l2)) {", "if (0 && !dc_wl_date(t + at + o2, l2)) {", mut2, sizeof mut2)) {
        rc = dc_run_tool(mut2, "--check", "--root", dc_root);
        dc_ck(rc == 0, "mutant-disable-date-check-killed");
    } else {
        dc_ck(0, "mutant-disable-date-check-killed");
    }

    dc_cleanup();
}
static void group_c(void) {
    int rc;
    dc_fixture();
    dc_put("tools/d.cx", "static int foo(int x) {\n    return  x;\n}\n");
    dc_put("tools/e.cx", "static int fox(int x) {\n    return x;\n}\n");
    dc_put("tools/f.cx", "/* other comment */\n" FOO);
    rc = dc_run("--print", "--root", dc_root);
    dc_ck(rc == 0 && dc_has("GROUP\tfoo\t4\t3\t12\t9\n") && !dc_has("GROUP\tfox\t") && dc_has(" verbatim_groups=1 "), "verbatim-byte-identical-only");
    dc_cleanup();
    rc = dc_run("--check", 0, 0);
    dc_ck(rc == 0 && dc_has("dup-census: ok: verbatim_groups="), "repo-check-ok");
    rc = dc_run("--print", 0, 0);
    dc_ck(rc == 0 && dc_has("\nDUP_SUMMARY files="), "repo-print-summary");
}

static int dc_rg_symbol_exists(const char *sym) {
    char pat[256];
    char *v[] = {"./tools/bound", "15", "rg", "-q", "--glob", "*.cx", pat, "tools/cxlib", "ext", 0};
    int fd, pid, ex = 0, code = 0, sig = 0; char junk[64];
    if (cx_fmt(pat, sizeof pat, "^[a-zA-Z_][a-zA-Z0-9_ *]*\\b%s\\s*\\(", sym)) return 0;
    pid = sy_spawn_pipe(v, 0, 0, &fd, 0);
    if (pid < 0) return 0;
    while (sy_read(fd, junk, sizeof junk) > 0) {}
    sy_close(fd);
    if (sy_wait_status(pid, 0, &ex, &code, &sig) != pid || !ex) return 0;
    return code == 0;
}

static int dc_verify_hints_tool(const char *tool) {
    char seen[32][64]; int nseen = 0, count = 0;
    long n, at = 0;
    if (dc_run_tool(tool, "--list-hints", 0, 0) != 0) return 1;
    n = tx_len(dc_out, sizeof dc_out);
    while (at < n) {
        long e = tx_chr(dc_out + at, n - at, '\n'), ln = e < 0 ? n - at : e;
        long o0, l0, o2, l2;
        if (ln > 11 && mm_same(dc_out + at, "HINT_ENTRY\t", 11) &&
            !tx_field(dc_out + at, ln, '\t', 0, &o0, &l0) &&
            !tx_field(dc_out + at, ln, '\t', 2, &o2, &l2) && l2 > 0 && l2 < 64) {
            char sym[64]; int i, dup = 0;
            mm_copy(sym, sizeof sym, dc_out + at + o2, l2);
            sym[l2] = 0;
            count++;
            for (i = 0; i < nseen; i++) if (tx_eqz(seen[i], sym)) { dup = 1; break; }
            if (!dup) {
                if (!dc_rg_symbol_exists(sym)) return 1;
                if (nseen < 32) { mm_copy(seen[nseen], sizeof seen[0], sym, l2 + 1); nseen++; }
            }
        }
        at += ln + 1;
    }
    return count > 0 ? 0 : 1;
}

static void group_e(void) {
    int rc;
    char epath[750], mut3[750], mut4[750];
    dc_fixture();
    rc = dc_run("--write", "--root", dc_root);
    dc_ck(rc == 0, "anon-setup-baseline");

    // 1. Same body, different names: old --check stays green; new DUP_ANON count is non-zero
    dc_put("tools/d.cx", "static int nfds_alpha(int x) {\n    return x + 42;\n}\n");
    dc_put("tools/e.cx", "static int nfds_beta(int x) {\n    return x + 42;\n}\n");
    rc = dc_run("--check", "--root", dc_root);
    dc_ck(rc == 0 && dc_has("dup-census: ok: verbatim_groups=1 (baseline 1)") &&
          dc_has("dup-census: info: anon_groups=1 anon_defs=2 anon_redundant=3\n"),
          "anon-renamed-old-check-green-info-printed");
    rc = dc_run("--print", "--root", dc_root);
    dc_ck(rc == 0 && dc_has("ANON_GROUP\tnfds_alpha,nfds_beta\t2\t3\t3\n") &&
          dc_has("DUP_ANON\tgroups=1\tdefs=2\tredundant=3\n"),
          "anon-renamed-counted-nonzero");

    // 2. Failure message prints cxlib/ext alternative hint for known pattern
    dc_put("tools/d.cx", "static int nfds_alpha(int x) {\n    return x + 42;\n}\nstatic int run_cmd(int x) {\n    return x;\n}\n");
    dc_put("tools/e.cx", "static int nfds_beta(int x) {\n    return x + 42;\n}\nstatic int run_cmd(int x) {\n    return x;\n}\n");
    rc = dc_run("--check", "--root", dc_root);
    dc_ck(rc == 1 && dc_has("dup-census: run_cmd has 2 verbatim copies, baseline 0\n") &&
          dc_has("dup-census: hint: run_cmd -> pr_run ("),
          "fail-prints-alternative-hint");

    // 3. --hint-file incremental read-only hint mode (always rc 0, reports both alt and anon dup)
    cx_fmt(epath, sizeof epath, "%s/tools/e.cx", dc_root);
    rc = dc_run_tool4("tools/dup-census.cx", "--hint-file", epath, "--root", dc_root);
    dc_ck(rc == 0 && dc_has("DUP_HINT\talt\trun_cmd\tpr_run\t") &&
          dc_has("DUP_HINT\tdup\tnfds_beta\ttools/d.cx\tnfds_alpha\n"),
          "hint-file-reports-alt-and-anon-dup");

    // 4. Mutation: removing name placeholder in dc_hash_anon loses anon detection (mutant killed)
    dc_prep_mut_root();
    if (!dc_write_mutant("mut3.cx",
            "for (t = 0; t < 4; t++) { nh ^= (unsigned char)ph[t]; nh *= 1099511628211ul; }",
            "for (t = q; t < qe; t++) { nh ^= (unsigned char)b[t]; nh *= 1099511628211ul; }",
            mut3, sizeof mut3)) {
        rc = dc_run_tool(mut3, "--print", "--root", dc_root);
        dc_ck(rc == 0 && dc_has("DUP_ANON\tgroups=0\tdefs=0\tredundant=0\n"), "mutant-drop-anon-placeholder-killed");
    } else {
        dc_ck(0, "mutant-drop-anon-placeholder-killed");
    }

    // 5. Anti-rot check: every hint target symbol must exist in tools/cxlib/ or ext/ (rg check)
    dc_ck(dc_verify_hints_tool("tools/dup-census.cx") == 0, "hints-symbols-exist-in-cxlib-or-ext");

    // 6. Mutation: renaming a hint target to a nonexistent symbol must fail anti-rot check (mutant killed)
    if (!dc_write_mutant("mut4.cx", "\"pr_run\"", "\"pr_run_deleted_sym\"", mut4, sizeof mut4)) {
        dc_ck(dc_verify_hints_tool(mut4) != 0, "mutant-stale-hint-symbol-killed");
    } else {
        dc_ck(0, "mutant-stale-hint-symbol-killed");
    }

    dc_cleanup();
}

int main(int argc, char **argv) {
    const char *g = argc == 3 && tx_eqz(argv[1], "--group") ? argv[2] : 0;
    if (argc != 1 && !g) { fprintf(stderr, "usage: tools/check-dup-census.cx [--group a|b|c|d|e]\n"); return 2; }
    if (!sy_env("CC")) sy_setenv("CC", "/usr/bin/cc", 1);
    if (!g || tx_eqz(g, "a")) group_a();
    if (!g || tx_eqz(g, "b")) group_b();
    if (!g || tx_eqz(g, "c")) group_c();
    if (!g || tx_eqz(g, "c") || tx_eqz(g, "d")) group_d();
    if (!g || tx_eqz(g, "e")) group_e();
    printf("CHECK_DUP_CENSUS\tfailed=%d\n", dc_failed);
    return dc_failed ? 1 : 0;
}
