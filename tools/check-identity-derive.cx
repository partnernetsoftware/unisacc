/* tools/check-identity-derive.cx -- usage + --check prints DIFF when derived block disagrees. */
#pragma unisa use cxlib.netpack
static int npass,nfail;
static void ck(int ok,const char *n){printf("%s\t%s\n",ok?"PASS":"FAIL",n);if(ok)npass++;else nfail++;}
int main(void){
    np_result r;char why[800],cwd[4096];
    char *u[]={"sh","./unisacc.com","tools/identity-derive.cx",0};
    if(np_run(u,".",0,15,&r,why,sizeof why)) return 2;
    ck(r.rc==2,"usage-rc2");np_free(&r);
    if(!getcwd(cwd,sizeof cwd)) return 2;
    {char *w[]={"sh","./unisacc.com","tools/identity-derive.cx","--",cwd,"--check",0};
     if(np_run(w,".",0,40,&r,why,sizeof why)) return 2;
     ck(r.rc==0||r.rc==1,"check-runs");
     if(r.rc==1) ck(r.outn&&strstr(r.out,"DIFF"),"check-fail-prints-DIFF");
     else ck(1,"check-ok-no-DIFF");
     np_free(&r);}
    printf("IDENTITY_DERIVE\tpass=%d\tfail=%d\n",npass,nfail);
    return nfail?1:0;
}
