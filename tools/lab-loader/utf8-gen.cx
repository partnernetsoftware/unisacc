/* utf8-gen.cx -- UTF-8 校验表的生成器与 --check（L5 的 B）。
 *
 *   sh ./unisacc.com tools/lab-loader/utf8-gen.cx -- --check   ROOT
 *   sh ./unisacc.com tools/lab-loader/utf8-gen.cx -- --write   ROOT
 *
 * 事实表：tools/lab-loader/utf8-validate.tsv
 *   每行 "<first> <last> <status> <name>"（十进制字节区间，闭区间）：
 *     first..last 是「一个 UTF-8 序列的首字节」区间，status 是：
 *       ok      合法首字节，后接 (len-1) 个 0x80..0xBF 续字节
 *       bad     必须拒绝（过长编码、代理区、超过 U+10FFFF、非法首字节）
 *   这一张表是唯一事实源；生成器据此写出
 *     tools/lab-loader/utf8-table.tsv（现有表 DSL 的四列格式）
 *   并由 --check 逐行核对生成结果与事实表一致。
 *
 * 事实表本身的正确性由 check-utf8.cx 的独立 oracle 核对（手写规则，不读这张表）。
 * 本生成器不做「语义判断」以外的事：它把区间展开成表 DSL 的 bytes 列。
 *
 * 表 DSL 目标状态：
 *   START     首字节
 *   CONT1     2 字节序列的第 2 个续字节（期望 0x80..0xBF）
 *   CONT2/CONT2B  3 字节序列的第 2/3 个续字节
 *   CONT3/CONT3B/CONT3C  4 字节序列的第 2/3/4 个续字节
 *   每个状态在 256（EOF）上：序列中途 → 拒绝（truncated），START→START（接受）。
 */
#pragma unisa use sys.fs

static void ug_die(const char *s) { fprintf(stderr, "utf8-gen: REFUSE %s\n", s); exit(2); }

static char ug_root[4096], ug_facts[4400], ug_out[4400];

/* 事实行："first<TAB>last<TAB>status<TAB>name"，允许 # 注释与空行。 */
typedef struct { int first, last, bad; } UgRange;
static UgRange ug_r[256];
static int ug_n;

static long ug_num(const char *s, long n) {
    long v = 0, i;
    if (n <= 0) return -1;
    for (i = 0; i < n; i++) {
        if (s[i] < '0' || s[i] > '9') return -1;
        v = v * 10 + (s[i] - '0');
    }
    return v;
}

static void ug_load(void) {
    size_t n;
    char *text = cx_read(ug_facts, &n), *p;
    if (!text) ug_die("cannot read fact table");
    p = text;
    while (p < text + n) {
        char *e = p, *tab1, *tab2, *tab3, *end;
        long a, b;
        while (e < text + n && *e != '\n') e++;
        if (e == p || *p < '0' || *p > '9') { p = e + 1; continue; }
        tab1 = memchr(p, '\t', (size_t)(e - p));
        if (!tab1) ug_die("fact row needs four columns");
        tab2 = memchr(tab1 + 1, '\t', (size_t)(e - tab1 - 1));
        if (!tab2) ug_die("fact row needs four columns");
        tab3 = memchr(tab2 + 1, '\t', (size_t)(e - tab2 - 1));
        a = ug_num(p, (long)(tab1 - p));
        b = ug_num(tab1 + 1, (long)(tab2 - tab1 - 1));
        end = tab3 ? tab3 : e;
        if (a < 0 || b < a || b > 256) ug_die("fact range invalid");
        if (ug_n == 256) ug_die("too many fact ranges");
        ug_r[ug_n].first = (int)a;
        ug_r[ug_n].last = (int)b;
        {   long sl = (long)(end - tab2 - 1);
            if (sl == 2 && !memcmp(tab2 + 1, "ok", 2)) ug_r[ug_n].bad = 0;
            else if (sl == 3 && !memcmp(tab2 + 1, "bad", 3)) ug_r[ug_n].bad = 1;
            else ug_die("status must be ok or bad");
        }
        ug_n++;
        p = e + 1;
    }
    free(text);
    if (!ug_n) ug_die("empty fact table");
}

/* 覆盖检查：0..256 每一点必须被恰好一个区间覆盖（256 = EOF 哨兵）。 */
static void ug_cover(void) {
    int seen[257], i, k;
    for (k = 0; k <= 256; k++) seen[k] = 0;
    for (i = 0; i < ug_n; i++)
        for (k = ug_r[i].first; k <= ug_r[i].last; k++) {
            if (seen[k]) ug_die("overlapping fact ranges");
            seen[k] = 1;
        }
    for (k = 0; k <= 256; k++) if (!seen[k]) ug_die("fact ranges do not cover 0..256");
}

/* 由区间生成表 DSL 的 bytes 列文本（"a-b" / "a"）。 */
static void ug_span(char *dst, size_t cap, int lo, int hi) {
    int n;
    if (lo == hi) n = snprintf(dst, cap, "%d", lo);
    else n = snprintf(dst, cap, "%d-%d", lo, hi);
    if (n < 0 || (size_t)n >= cap) ug_die("span capacity");
}

int main(int argc, char **argv) {
    char p[4400];
    int check;

    if (argc != 3) ug_die("usage --check|--write ROOT");
    if (!strcmp(argv[1], "--check")) check = 1;
    else if (!strcmp(argv[1], "--write")) check = 0;
    else ug_die("usage --check|--write ROOT");
    if (!realpath(argv[2], ug_root)) ug_die("root");
    if (cx_path_join(ug_facts, sizeof ug_facts, ug_root, "tools/lab-loader/utf8-validate.tsv")) ug_die("path");
    if (cx_path_join(ug_out, sizeof ug_out, ug_root, "tools/lab-loader/utf8-table.tsv")) ug_die("path");
    ug_load();
    ug_cover();

    /* 生成表：START 段按事实表；续字节状态按 UTF-8 的固定规则补全。 */
    {
        char *buf = malloc(131072);
        size_t at = 0;
        int i;
        if (!buf) ug_die("allocation");
        if (cx_fmt(buf + at, 131072 - at,
            "# Generated by tools/lab-loader/utf8-gen.cx from tools/lab-loader/utf8-validate.tsv; do not edit.\n"
            "# state\tbytes (0..256; * = remaining)\tnext\tactions\n") < 0) ug_die("buffer");
        at = strlen(buf);
        for (i = 0; i < ug_n; i++) {
            char span[32], line[320];
            const char *next;
            const char *act;
            int len;
            ug_span(span, sizeof span, ug_r[i].first, ug_r[i].last);
            if (ug_r[i].bad) { next = "HALT"; act = "[[\"REJECT\",\"invalid UTF-8 lead\"]]"; }
            else if (ug_r[i].first == 256) { next = "ACCEPT"; act = "[[\"ACCEPT\"]]"; }
            else {
                len = ug_r[i].first <= 0x7f ? 1 : ug_r[i].first <= 0xdf ? 2 : ug_r[i].first <= 0xef ? 3 : 4;
                next = len == 1 ? "START" : len == 2 ? "CONT1" : len == 3 ? "CONT2" : "CONT3";
                if (ug_r[i].first == 0xe0) next = "CONT1E0";
                else if (ug_r[i].first == 0xed) next = "CONT2ED";
                else if (ug_r[i].first == 0xf0) next = "CONT3F0";
                else if (ug_r[i].first == 0xf4) next = "CONT3F4";
                act = "[[\"ADV\"]]";
            }
            if (cx_fmt(line, sizeof line, "START\t%s\t%s\t%s\n", span, next, act) < 0) ug_die("line capacity");
            if (cx_fmt(buf + at, 131072 - at, "%s", line) < 0) ug_die("buffer");
            at = strlen(buf);
        }
        /* 兜底：事实表已覆盖 256（EOF），这里只补 '*' */
        if (cx_fmt(buf + at, 131072 - at,
            "START\t*\tHALT\t[[\"REJECT\",\"unexpected byte\"]]\n") < 0) ug_die("buffer");
        at = strlen(buf);
        if (cx_fmt(buf + at, 131072 - at,
            "ACCEPT\t*\tDEAD\t[[\"ACCEPT\"]]\n"
            "DEAD\t*\tDEAD\t[]\n") < 0) ug_die("buffer");
        at = strlen(buf);
        /* 2 字节续 */
        if (cx_fmt(buf + at, 131072 - at,
            "CONT1\t128-191\tSTART\t[[\"ADV\"]]\n"
            "CONT1\t256\tHALT\t[[\"REJECT\",\"truncated sequence\"]]\n"
            "CONT1\t*\tHALT\t[[\"REJECT\",\"invalid continuation\"]]\n") < 0) ug_die("buffer");
        at = strlen(buf);
        /* 3 字节：E0 需要 A0..BF；ED 上限 9F；其余 80..BF */
        if (cx_fmt(buf + at, 131072 - at,
            "CONT2\t128-191\tCONT2B\t[[\"ADV\"]]\n"
            "CONT2\t256\tHALT\t[[\"REJECT\",\"truncated sequence\"]]\n"
            "CONT2\t*\tHALT\t[[\"REJECT\",\"invalid continuation\"]]\n"
            "CONT2B\t128-191\tSTART\t[[\"ADV\"]]\n"
            "CONT2B\t256\tHALT\t[[\"REJECT\",\"truncated sequence\"]]\n"
            "CONT2B\t*\tHALT\t[[\"REJECT\",\"invalid continuation\"]]\n") < 0) ug_die("buffer");
        at = strlen(buf);
        /* 4 字节：F0 需要 90..BF；F4 上限 8F；其余 80..BF */
        if (cx_fmt(buf + at, 131072 - at,
            "CONT3\t128-191\tCONT3B\t[[\"ADV\"]]\n"
            "CONT3\t256\tHALT\t[[\"REJECT\",\"truncated sequence\"]]\n"
            "CONT3\t*\tHALT\t[[\"REJECT\",\"invalid continuation\"]]\n"
            "CONT3B\t128-191\tCONT3C\t[[\"ADV\"]]\n"
            "CONT3B\t256\tHALT\t[[\"REJECT\",\"truncated sequence\"]]\n"
            "CONT3B\t*\tHALT\t[[\"REJECT\",\"invalid continuation\"]]\n"
            "CONT3C\t128-191\tSTART\t[[\"ADV\"]]\n"
            "CONT3C\t256\tHALT\t[[\"REJECT\",\"truncated sequence\"]]\n"
            "CONT3C\t*\tHALT\t[[\"REJECT\",\"invalid continuation\"]]\n") < 0) ug_die("buffer");
        at = strlen(buf);
        /* 受限的首续字节状态：由事实表里 E0/ED/F0/F4 各自指向 */
        if (cx_fmt(buf + at, 131072 - at,
            "CONT1E0\t160-191\tCONT2B\t[[\"ADV\"]]\n"
            "CONT1E0\t256\tHALT\t[[\"REJECT\",\"truncated sequence\"]]\n"
            "CONT1E0\t*\tHALT\t[[\"REJECT\",\"overlong 3-byte\"]]\n"
            "CONT2ED\t128-159\tCONT2B\t[[\"ADV\"]]\n"
            "CONT2ED\t160-191\tHALT\t[[\"REJECT\",\"surrogate\"]]\n"
            "CONT2ED\t256\tHALT\t[[\"REJECT\",\"truncated sequence\"]]\n"
            "CONT2ED\t*\tHALT\t[[\"REJECT\",\"invalid continuation\"]]\n"
            "CONT3F0\t144-191\tCONT3B\t[[\"ADV\"]]\n"
            "CONT3F0\t256\tHALT\t[[\"REJECT\",\"truncated sequence\"]]\n"
            "CONT3F0\t*\tHALT\t[[\"REJECT\",\"overlong 4-byte\"]]\n"
            "CONT3F4\t128-143\tCONT3B\t[[\"ADV\"]]\n"
            "CONT3F4\t256\tHALT\t[[\"REJECT\",\"truncated sequence\"]]\n"
            "CONT3F4\t*\tHALT\t[[\"REJECT\",\"above U+10FFFF\"]]\n") < 0) ug_die("buffer");
        at = strlen(buf);
        if (check) {
            size_t on;
            char *old = cx_read(ug_out, &on);
            if (!old) ug_die("cannot read generated table for --check");
            if (on != at || memcmp(old, buf, at)) {
                free(old); free(buf);
                ug_die("generated table differs; run --write");
            }
            free(old);
        } else {
            int fd = open(ug_out, O_WRONLY | O_CREAT | O_TRUNC, 0644);
            if (fd < 0 || write(fd, buf, at) != (ssize_t)at || close(fd)) ug_die("write generated table");
        }
        printf("UTF8_GEN\tranges=%d\tbytes=%lu\tmode=%s\n", ug_n, (unsigned long)at, check ? "check" : "write");
        free(buf);
    }
    return 0;
}
