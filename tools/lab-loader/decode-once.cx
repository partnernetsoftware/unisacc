/* decode-once.cx -- 用一个二进制网验证它能否被产品的模型解码器接受。
   sh ./unisacc.com tools/lab-loader/decode-once.cx -- NET.bin */
#pragma unisa use mem.bytes
#pragma unisa use runtime.model_decode
#pragma unisa use runtime.model_lifetime
#pragma unisa use runtime.model_number

static void *dd_al(void *p, size_t n) { return realloc(p, n ? n : 1); }
static void dd_fr(void *p) { free(p); }

int main(int argc, char **argv) {
    CxDecode d;
    size_t n;
    char *b;
    int rc;
    if (argc != 2) { fprintf(stderr, "usage NET.bin\n"); return 2; }
    b = cx_read(argv[1], &n);
    if (!b) { fprintf(stderr, "decode-once: cannot read %s\n", argv[1]); return 2; }
    memset(&d, 0, sizeof d);
    d.allocate = dd_al;
    d.release = dd_fr;
    rc = cxmd_decode(&d, (const unsigned char *)b, (long)n);
    if (rc) {
        fprintf(stderr, "decode-once: REFUSE rc=%d why=%s\n", rc, d.why ? d.why : "-");
        return 1;
    }
    printf("DECODED\tns=%d\tnq=%d\tnrg=%d\tnstr=%d\tstart=%d\tisnet=%d\n",
           d.model.ns, d.model.nq, d.model.nrg, d.model.nstr, d.model.start, d.model.isnet);
    cxml_release(&d.model, dd_fr);
    free(b);
    return 0;
}
