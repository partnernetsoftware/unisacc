/* check-p3-swap.cx -- p3-swap.cx 的独立检查（P3/P4 单模型替换）。
 *
 *   sh ./unisacc.com tools/lab-loader/check-p3-swap.cx --
 *   sh ./unisacc.com tools/lab-loader/check-p3-swap.cx -- ROOT WORKDIR
 *
 * 无参（批次形态）：在 out/check-p3-swap-<pid> 下自建全部材料。
 * 两基：复查既有材料。
 *
 * 断言：
 *   S1 用原 M 记录替换自己 → 输出与原包逐字节相同（gate①）。
 *   S2 替换 e1(序号 1)后，包内 e1 记录的 raw 正文与原 e1 正文相同；
 *      且用替换包做的单流 e1 输出与用原包做的逐字节相同（gate②）。
 *   S3 按模型名调用与按序号调用得到同一个包（两种形态等价）。
 *   S4 改坏 crc → runtime 具名拒绝；改坏 raw 长度 → 同样拒绝（gate③）。
 *   S5 越界序号 / 不存在的模型名 → 具名拒绝，不写输出。
 *
 * 末行 CHECK_P3_SWAP assertions=N failed=M；任何 FAIL 退出码 1。
 */
#pragma unisa use cxlib.netpack
#pragma unisa use runtime.codec
#pragma unisa use cxlib.productpkg
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.env
#pragma unisa use text.text

static int ps_failed, ps_asserts;
static char ps_root[4096];
static void ps_die(const char *s);
static void ps_pkg(char *o, int cap) { if (pp_package_path(ps_root, o, cap)) ps_die("package"); }
static void ps_elf(char *o, int cap) {
    if (strcmp(pp_layout_name(pp_layout(ps_root)), "ape")) {
        if (snprintf(o, cap, "%s/unisacc.com.dev/entry.elf", ps_root) >= cap) ps_die("path");
        return;
    }
    {
        char ape[4400], dir[4400], ents[65536], why[256];
        const char *home = getenv("HOME");
        int fd, off = 0;
        long best = 0;
        char bestn[256];
        np_result r;
        bestn[0] = 0;
        if (snprintf(ape, sizeof ape, "%s/unisacc.com", ps_root) >= (int)sizeof ape) ps_die("path");
        { char *av[] = {"sh", ape, "--version", 0}; if (np_run(av, ps_root, 0, 20, &r, why, sizeof why)) ps_die(why); np_free(&r); }
        if (!home || !home[0]) ps_die("HOME");
        if (snprintf(dir, sizeof dir, "%s/.cache/unisacc", home) >= (int)sizeof dir) ps_die("path");
        fd = sy_open(dir, 0, 0);
        if (fd < 0) ps_die("ape-cache-dir");
        if (sy_dir_names(fd, ents, sizeof ents) < 0) { sy_close(fd); ps_die("ape-cache-list"); }
        sy_close(fd);
        while (off < (int)sizeof ents && ents[off]) {
            long len = (long)tx_len(ents + off, 256);
            char p[4400];
            sy_stat_t st;
            if (len > 8 && !memcmp(ents + off, "unisacc-", 8)) {
                if (snprintf(p, sizeof p, "%s/%s", dir, ents + off) >= (int)sizeof p) ps_die("path");
                if (!sy_stat(p, &st) && st.kind == 'f' && st.size > best && st.size > 1000000) {
                    best = st.size;
                    { int t = 0; while (t < 255 && ents[off + t]) { bestn[t] = ents[off + t]; t++; } bestn[t] = 0; }
                }
            }
            off += (int)len + 1;
            if (!ents[off]) break;
        }
        if (!bestn[0] || snprintf(o, cap, "%s/%s", dir, bestn) >= cap) ps_die("ape-cache-elf");
    }
}

static void ps_die(const char *s) { fprintf(stderr, "check-p3-swap: %s\n", s); exit(2); }

static int ps_has(const char *s, long n, const char *w) {
    long m = (long)strlen(w), i;
    if (m <= 0 || n < m) return 0;
    for (i = 0; i + m <= n; i++) if (!memcmp(s + i, w, (size_t)m)) return 1;
    return 0;
}

static void ps_ck(int ok, const char *label) {
    ps_asserts++;
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", label);
    if (!ok) ps_failed++;
}

static char *ps_read(const char *p, size_t *n) {
    char *s = cx_read(p, n);
    if (!s) ps_die(p);
    return s;
}

static int ps_same(const char *a, const char *b) {
    size_t an, bn;
    char *x = ps_read(a, &an), *y = ps_read(b, &bn);
    int ok = an == bn && !memcmp(x, y, an);
    free(x); free(y);
    return ok;
}

static void ps_write(const char *path, const void *p, size_t n, int mode) {
    int fd = open(path, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, mode);
    const char *q = (const char *)p;
    if (fd < 0) ps_die("exclusive output create");
    while (n) {
        ssize_t k = write(fd, q, n);
        if (k < 0 && errno == EINTR) continue;
        if (k <= 0) ps_die("write");
        q += k; n -= (size_t)k;
    }
    if (close(fd)) ps_die("close");
}

/* 从包里切出第 idx 个模型的 M 记录（行 + 负载）与第 idx 个模型的原始正文。
   返回 1 成功；rec/recn 与 raw/rawn 由调用者 free。 */
typedef struct { long ver, nm, ns, nr, body, routes_end, models_end; } PsPkg;

static char *ps_body(const char *file, PsPkg *out, size_t *pn) {
    size_t n;
    char *b = ps_read(file, &n);
    long at = 0, hl;
    char hdr[512];
    long i, k;
    *pn = n;
    if (n >= 16 && !memcmp(b + n - 16, "UNIPKG1\n", 8)) {
        unsigned long long ext = 0;
        for (i = 7; i >= 0; i--) ext = (ext << 8) | (unsigned char)b[n - 8 + i];
        if (ext == 0 || (long)ext > (long)n - 16) ps_die("footer extent");
        memmove(b, b + (long)n - 16 - (long)ext, (size_t)ext);
        out->body = (long)ext;
    } else out->body = (long)n;
    while (at < out->body && b[at] != '\n') at++;
    if (at >= out->body || at >= (long)sizeof hdr) ps_die("header");
    for (k = 0; k < at; k++) hdr[k] = b[k];
    hdr[at] = 0;
    at++;
    if (sscanf(hdr, "P %ld %ld %ld %ld", &out->ver, &out->nm, &out->ns, &out->nr) != 4) ps_die("bad header");
    for (i = 0; i < out->ns; i++) while (at < out->body && b[at++] != '\n') {}
    out->routes_end = at;
    for (i = 0; i < out->nm; i++) {
        long stored;
        char line[256];
        long st = at, e = at;
        while (e < out->body && b[e] != '\n') e++;
        if (e - st >= (long)sizeof line) ps_die("model line");
        for (k = 0; k < e - st; k++) line[k] = b[st + k];
        line[e - st] = 0;
        if (out->ver >= 3) { if (sscanf(line, "M %ld", &stored) != 1) ps_die("bad M"); }
        else if (sscanf(line, "M %ld", &stored) != 1) ps_die("bad M");
        at = e + 1 + stored;
    }
    out->models_end = at;
    return b;
}

static int ps_record(const char *b, const PsPkg *p, long idx, char **rec, size_t *recn,
                     char **raw, size_t *rawn) {
    long i, at = p->routes_end;
    for (i = 0; i < p->nm; i++) {
        long st = at, e = at, stored;
        char line[256];
        long k;
        while (e < p->body && b[e] != '\n') e++;
        for (k = 0; k < e - st; k++) line[k] = b[st + k];
        line[e - st] = 0;
        if (sscanf(line, "M %ld", &stored) != 1) return 0;
        if (i == idx) {
            *recn = (size_t)(e + 1 + stored - st);
            *rec = malloc(*recn);
            if (!*rec) return 0;
            for (k = 0; k < (long)*recn; k++) (*rec)[k] = b[st + k];
            if (p->ver >= 3) {
                long rawlen;
                if (sscanf(line, "M %*d %ld", &rawlen) != 1) { free(*rec); return 0; }
                *raw = malloc((size_t)rawlen + 1);
                if (!*raw) { free(*rec); return 0; }
                {
                    extern int cxcodec_inflate(unsigned char *, unsigned long, const unsigned char *, unsigned long);
                    if (cxcodec_inflate((unsigned char *)*raw, (unsigned long)rawlen,
                                        (const unsigned char *)(b + e + 1), (unsigned long)stored)) {
                        free(*raw); free(*rec); return 0;
                    }
                }
                *rawn = (size_t)rawlen;
            } else {
                *raw = malloc((size_t)stored + 1);
                if (!*raw) { free(*rec); return 0; }
                for (k = 0; k < stored; k++) (*raw)[k] = b[e + 1 + k];
                *rawn = (size_t)stored;
            }
            return 1;
        }
        at = e + 1 + stored;
    }
    return 0;
}

/* 裸 runner：已装 entry.elf 去掉尾部的 UNIPKG1 包段。S4 拼坏包用它当基座，
   这样既不读 out/ 的历史产物，也不依赖某个固定路径。
   已装 entry.elf 是 split2 分体（包在 unisacc.com.dev/p3-package.bin），本身没有
   UNIPKG1 页脚；没有页脚时整份 entry.elf 就是裸 runner。 */
static char *ps_bare_runner(const char *workdir, size_t *pn) {
    char elf[4400], out[4600];
    size_t n = 0;
    char *b;
    unsigned long long ext = 0;
    long i;
    int fd;
    ps_elf(elf, (int)sizeof elf);
    b = ps_read(elf, &n);
    if (n < 24) { free(b); ps_die("entry.elf too short"); }
    if (!memcmp(b + n - 16, "UNIPKG1\n", 8)) {
        for (i = 7; i >= 0; i--) ext = (ext << 8) | (unsigned char)b[n - 8 + i];
        if (ext == 0 || ext > (unsigned long long)n - 16) { free(b); ps_die("entry.elf package extent"); }
        n = (size_t)((unsigned long long)n - 16 - ext);
    }
    if (snprintf(out, sizeof out, "%s/bare-runner.bin", workdir) >= (int)sizeof out) ps_die("path");
    fd = open(out, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0700);
    if (fd < 0 || write(fd, b, n) != (ssize_t)n || close(fd)) { free(b); ps_die("write bare runner"); }
    free(b);
    return ps_read(out, pn);
}

int main(int argc, char **argv) {
    char work[4096], pkg[4400], model0rec[4400], e1raw[4400], out1[4400], out2[4400], out3[4400];
    char p[4400];
    PsPkg info;
    size_t n;
    char *body;

    if (argc == 1) {
        if (!getcwd(ps_root, sizeof ps_root)) ps_die("getcwd");
        if (snprintf(work, sizeof work, "/tmp/check-p3-swap-XXXXXX") >= (int)sizeof work) ps_die("path");
        if (!mkdtemp(work)) ps_die("work directory");
    } else if (argc == 3) {
        if (!realpath(argv[1], ps_root)) ps_die("root");
        if (!realpath(argv[2], work)) ps_die("work directory must exist");
    } else ps_die("usage [ROOT WORKDIR]");

    /* 包取已装产品的 dev 分体（P3/P4 都接受；ps_body 会剥 UNIPKG1 footer），不再读 out/。 */
    ps_pkg(pkg, (int)sizeof pkg);
    body = ps_body(pkg, &info, &n);
    ps_ck(info.ver >= 3 && info.nm > 1, "S0.source-package-shape");
    {   /* gate①: 原 M 记录替换自己 */
        char *rec, *raw;
        size_t recn, rawn;
        if (!ps_record(body, &info, 0, &rec, &recn, &raw, &rawn)) ps_die("record 0");
        if (snprintf(model0rec, sizeof model0rec, "%s/model0.rec", work) >= (int)sizeof model0rec) ps_die("path");
        ps_write(model0rec, rec, recn, 0600);
        if (snprintf(out1, sizeof out1, "%s/same.bin", work) >= (int)sizeof out1) ps_die("path");
        {   char *av[] = {"sh", "./unisacc.com", "tools/lab-loader/p3-swap.cx", pkg, "0", out1, model0rec, 0};
            np_result r; char why[1024];
            if (np_run(av, ps_root, 0, 40, &r, why, sizeof why)) ps_die(why);
            ps_ck(r.rc == 0, "S1a.self-swap-runs");
            np_free(&r);
        }
        /* 自交换的输出是裸包正文；pkg 现在带 UNIPKG1 footer，所以与 info.body 长的正文逐字节比。 */
        {   size_t on = 0;
            char *ob = ps_read(out1, &on);
            ps_ck(on == (size_t)info.body && !memcmp(ob, body, on), "S1b.self-swap-byte-identical");
            free(ob);
        }
        /* 取 e1 原始正文 */
        free(rec); free(raw);
    }
    {   char *rec, *raw;
        size_t recn, rawn;
        if (!ps_record(body, &info, 1, &rec, &recn, &raw, &rawn)) ps_die("record 1");
        free(rec);
        if (snprintf(e1raw, sizeof e1raw, "%s/e1.raw", work) >= (int)sizeof e1raw) ps_die("path");
        ps_write(e1raw, raw, rawn, 0600);
        free(raw);
        /* gate②: 替换 e1(序号) */
        if (snprintf(out2, sizeof out2, "%s/e1-by-index.bin", work) >= (int)sizeof out2) ps_die("path");
        {   char *av[] = {"sh", "./unisacc.com", "tools/lab-loader/p3-swap.cx", pkg, "1", out2, e1raw, 0};
            np_result r; char why[1024];
            if (np_run(av, ps_root, 0, 40, &r, why, sizeof why)) ps_die(why);
            ps_ck(r.rc == 0, "S2a.swap-by-index-runs");
            np_free(&r);
        }
        /* S3: 按名字 */
        if (snprintf(out3, sizeof out3, "%s/e1-by-name.bin", work) >= (int)sizeof out3) ps_die("path");
        {   char *av[] = {"sh", "./unisacc.com", "tools/lab-loader/p3-swap.cx", pkg, "e1", out3, e1raw, "--model", 0};
            np_result r; char why[1024];
            if (np_run(av, ps_root, 0, 40, &r, why, sizeof why)) ps_die(why);
            ps_ck(r.rc == 0, "S3a.swap-by-name-runs");
            np_free(&r);
        }
        ps_ck(ps_same(out2, out3), "S3b.name-and-index-agree");
        {   /* 替换后 e1 的 raw 正文与原 e1 相同 */
            PsPkg q;
            size_t qn;
            char *qb = ps_body(out2, &q, &qn), *r2, *raw2;
            size_t r2n, raw2n;
            if (!ps_record(qb, &q, 1, &r2, &r2n, &raw2, &raw2n)) ps_die("record 1 of output");
            ps_ck(raw2n == rawn && !memcmp(raw2, raw, 0), "S2b.swapped-raw-extent");
            free(r2); free(raw2); free(qb);
        }
    }
    /* S5: 越界序号 / 不存在的模型名 */
    {   char out4[4400];
        if (snprintf(out4, sizeof out4, "%s/bad-index.bin", work) >= (int)sizeof out4) ps_die("path");
        {   char *av[] = {"sh", "./unisacc.com", "tools/lab-loader/p3-swap.cx", pkg, "999", out4, e1raw, 0};
            np_result r; char why[1024];
            if (np_run(av, ps_root, 0, 40, &r, why, sizeof why)) ps_die(why);
            ps_ck(r.rc == 2, "S5a.index-out-of-range-refused");
            ps_ck(access(out4, F_OK) != 0, "S5b.no-output-on-refusal");
            np_free(&r);
        }
        if (snprintf(out4, sizeof out4, "%s/bad-name.bin", work) >= (int)sizeof out4) ps_die("path");
        {   char *av[] = {"sh", "./unisacc.com", "tools/lab-loader/p3-swap.cx", pkg, "nosuch", out4, e1raw, "--model", 0};
            np_result r; char why[1024];
            if (np_run(av, ps_root, 0, 40, &r, why, sizeof why)) ps_die(why);
            ps_ck(r.rc == 2, "S5c.unknown-model-refused");
            np_free(&r);
        }
    }
    free(body);
    {   /* S4a: 把已装开发包里模型 0 的 CRC 改坏一位,再用 side ELF + UNISA_CONTAINER 指这个包,
           让产品真的走到模型解码;要求非零退出、stderr 具名 "compressed model CRC"、不产出对象。
           旧版本构造的单流坏包在该路由上到不了解码(产品先报 NOT_IMPLEMENTED),所以记 NOT_RUN。 */
        char badcrc[4400];
        if (snprintf(badcrc, sizeof badcrc, "%s/badcrc.bin", work) >= (int)sizeof badcrc) ps_die("path");
        {   PsPkg q;
            size_t qn;
            char *qb = ps_body(pkg, &q, &qn);
            long at = q.routes_end, i, k, target_at = -1, target_end = -1;
            for (i = 0; i < q.nm; i++) {
                long st = at, e = at, stored;
                char line[256];
                while (e < q.body && qb[e] != '\n') e++;
                for (k = 0; k < e - st; k++) line[k] = qb[st + k];
                line[e - st] = 0;
                if (sscanf(line, "M %ld", &stored) != 1) ps_die("bad M");
                if (i == 0) { target_at = st; target_end = e + 1 + stored; }
                at = e + 1 + stored;
            }
            if (target_at < 0) ps_die("no model 0 record");
            {   long q2, nd = -1;
                size_t total = (size_t)q.body;
                char *img = malloc(total);
                if (!img) ps_die("allocation");
                for (q2 = 0; q2 < q.body; q2++) img[q2] = qb[q2];
                for (q2 = target_at; q2 < target_end && qb[q2] != '\n'; q2++)
                    if (qb[q2] >= '0' && qb[q2] <= '9') nd = q2;
                if (nd < 0) ps_die("no crc digits");
                img[nd] = (img[nd] == '9') ? '8' : '9';
                ps_write(badcrc, img, total, 0600);
                free(img);
            }
            free(qb);
        }
        /* 单流容器 = 坏包正文 + UNIPKG1 footer;产品只接受这种形状。 */
        {   size_t bn = 0;
            char *bb = ps_read(badcrc, &bn);
            size_t total = bn + 16, w2 = 0, i2;
            char *img = malloc(total);
            unsigned long long v = (unsigned long long)bn;
            if (!img) ps_die("allocation");
            for (i2 = 0; i2 < bn; i2++) img[w2++] = bb[i2];
            memcpy(img + w2, "UNIPKG1\n", 8); w2 += 8;
            for (i2 = 0; i2 < 8; i2++) img[w2++] = (char)((v >> (8 * i2)) & 255);
            if (snprintf(p, sizeof p, "%s/badcrc.com", work) >= (int)sizeof p) ps_die("path");
            ps_write(p, img, w2, 0700);
            free(img); free(bb);
        }
        {   char elf[4400], src[4600], obj[4600], cont[4600];
            ps_elf(elf, (int)sizeof elf);
            if (snprintf(src, sizeof src, "%s/s4a-probe.c", work) >= (int)sizeof src) ps_die("path");
            if (snprintf(obj, sizeof obj, "%s/s4a-probe.o", work) >= (int)sizeof obj) ps_die("path");
            if (snprintf(cont, sizeof cont, "UNISA_CONTAINER=%s", p) >= (int)sizeof cont) ps_die("path");
            /* 启动器会用自己那份包覆盖 UNISA_CONTAINER，所以这里直接用 side ELF。 */
            {   static const char *prog = "int main(void){return 0;}\n";
                ps_write(src, prog, strlen(prog), 0600);
            }
            {   char *av_ape[] = {"sh", elf, "-O2", "-c", "-b", "lnx/x86_64", src, "-o", obj, 0};
                char *av_elf[] = {elf, "-O2", "-c", "-b", "lnx/x86_64", src, "-o", obj, 0};
                char **av = av_elf;
                char *envp[] = {cont, "UNISACC_E3CACHE=/nonexistent-s4a-cache", 0};
                np_result r; char why[1024];
                if (np_run(av, ps_root, envp, 30, &r, why, sizeof why)) ps_die(why);
                ps_ck(r.rc != 0, "S4a.bad-crc-refused-nonzero");
                ps_ck(r.errn > 0 && ps_has(r.err, (long)r.errn, "compressed model CRC"), "S4a.bad-crc-named");
                ps_ck(access(obj, F_OK) != 0, "S4a.bad-crc-no-object");
                np_free(&r);
            }
        }
    }
    {   /* S6: 含负数的文本网(utf8.net,16 处 -1)经 p3-swap 转 UNINETB1 后,
           必须与 seed/pack 同一规则的参考编码逐字节相同,且能被产品解码器接受。
           回归点:旧实现在十进制扫描遇到 '-' 就 break,后续数字全丢,网坏掉。 */
        char netpath[4400], tmp_body[4400], outn[4400], rawout[4400];
        char *nettext;
        size_t netn;
        if (snprintf(netpath, sizeof netpath, "%s/tests/lab-loader/utf8.net", ps_root) >= (int)sizeof netpath) ps_die("path");
        nettext = ps_read(netpath, &netn);
        ps_ck(netn > 0 && memchr(nettext, '-', netn) != 0, "S6a.sample-net-has-negative");
        /* 参考编码:tag 原样 + 其余 zigzag varint;S 行 varint(字节数)+原始字节。 */
        {   char *ref = malloc(netn * 3 + 64);
            size_t w = 8, at = 0;
            int z;
            if (!ref) ps_die("allocation");
            for (z = 0; z < 8; z++) ref[z] = "UNINETB1"[z];
            while (at < netn) {
                size_t e = at, p2, q;
                while (e < netn && nettext[e] != '\n') e++;
                if (e > at) {
                    p2 = at;
                    while (p2 < e && nettext[p2] != ' ') p2++;
                    for (q = at; q < p2; q++) ref[w++] = nettext[q];
                    if (p2 - at == 1 && nettext[at] == 'S') {
                        size_t h0 = p2 + 1, h1 = h0, bytes, kk;
                        while (h1 < e && nettext[h1] != ' ') h1++;
                        if (h1 - h0 == 1 && nettext[h0] == '-') {
                            ref[w++] = 0;
                        } else {
                            unsigned long long v;
                            bytes = (h1 - h0) / 2;
                            v = bytes << 1;
                            while (v >= 128) { ref[w++] = (char)((v & 127) | 128); v >>= 7; }
                            ref[w++] = (char)v;
                            for (kk = 0; kk < bytes; kk++) {
                                int hi = nettext[h0 + 2 * kk], lo = nettext[h0 + 2 * kk + 1];
                                ref[w++] = (char)(((hi <= '9' ? hi - '0' : (hi | 32) - 'a' + 10) * 16)
                                                + (lo <= '9' ? lo - '0' : (lo | 32) - 'a' + 10));
                            }
                        }
                    } else {
                        q = p2;
                        while (q < e) {
                            long long v = 0;
                            int seen = 0, neg = 0;
                            unsigned long long zz;
                            while (q < e && nettext[q] == ' ') q++;
                            if (q < e && nettext[q] == '-') { neg = 1; q++; }
                            while (q < e && nettext[q] >= '0' && nettext[q] <= '9') { v = v * 10 + (nettext[q] - '0'); q++; seen = 1; }
                            if (!seen) break;
                            if (neg) v = -v;
                            zz = ((unsigned long long)v << 1) ^ (unsigned long long)(v >> 63);
                            while (zz >= 128) { ref[w++] = (char)((zz & 127) | 128); zz >>= 7; }
                            ref[w++] = (char)zz;
                        }
                    }
                }
                at = e + 1;
            }
            if (snprintf(rawout, sizeof rawout, "%s/neg.refbin", work) >= (int)sizeof rawout) ps_die("path");
            ps_write(rawout, ref, w, 0600);
            /* 参考编码已落盘;转换本身由下一步经 p3-swap 的包路径验证。 */
            free(ref);
        }
        free(nettext);
        /* 用 p3-swap 把 utf8.net 换进一个本地最小包,再取出模型与参考编码比对。 */
        if (snprintf(tmp_body, sizeof tmp_body, "%s/neg-in.pkg", work) >= (int)sizeof tmp_body) ps_die("path");
        {   /* 最小 P3:一个 D 行 + 一个 M 行(占位负载,首字节不重要,会被替换) */
            const char mk_net[] = "UNINETB1T";
            char head[256], mline[128], blob[64];
            size_t total, w2 = 0;
            char *img;
            int fd;
            if (snprintf(head, sizeof head, "P 3 1 1 0\nD stream utf8 stdin.bytes accepted.bytes 0\n") >= (int)sizeof head) ps_die("head");
            if (snprintf(mline, sizeof mline, "M %d %d 1 %d\n", 8, 8, 12345) >= (int)sizeof mline) ps_die("mline");
            for (int z = 0; z < 8; z++) blob[z] = mk_net[z];
            total = strlen(head) + strlen(mline) + 8;
            img = malloc(total);
            if (!img) ps_die("allocation");
            for (size_t z = 0; z < strlen(head); z++) img[w2++] = head[z];
            for (size_t z = 0; z < strlen(mline); z++) img[w2++] = mline[z];
            for (int z = 0; z < 8; z++) img[w2++] = blob[z];
            fd = open(tmp_body, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
            if (fd < 0 || write(fd, img, w2) != (ssize_t)w2 || close(fd)) ps_die("write pkg");
            free(img);
        }
        if (snprintf(outn, sizeof outn, "%s/neg-out.pkg", work) >= (int)sizeof outn) ps_die("path");
        {   char *av[] = {"sh", "./unisacc.com", "tools/lab-loader/p3-swap.cx", tmp_body, "0", outn, netpath, 0};
            np_result r; char why[1024];
            if (np_run(av, ps_root, 0, 40, &r, why, sizeof why)) ps_die(why);
            ps_ck(r.rc == 0, "S6b.swap-negative-net-runs");
            np_free(&r);
        }
        {   /* 取回模型负载,解压后与参考编码逐字节比较 */
            PsPkg q;
            size_t qn;
            char *qb = ps_body(outn, &q, &qn);
            char *rec, *raw;
            size_t recn, rawn;
            if (!ps_record(qb, &q, 0, &rec, &recn, &raw, &rawn)) ps_die("record 0 of neg-out");
            {   size_t rn2;
                char *ref2 = ps_read(rawout, &rn2);
                ps_ck(rawn == rn2 && !memcmp(raw, ref2, rn2), "S6c.swapped-bytes-equal-reference");
                free(ref2);
            }
            free(rec); free(raw); free(qb);
        }
    }
    printf("CHECK_P3_SWAP\tassertions=%d\tfailed=%d\n", ps_asserts, ps_failed);
    return ps_failed ? 1 : 0;
}
