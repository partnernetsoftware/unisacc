/* check-utf8.cx -- L5-B 的独立 oracle 检查：UTF-8 校验表的语义对不对。
 *
 *   sh ./unisacc.com tools/lab-loader/check-utf8.cx --
 *   sh ./unisacc.com tools/lab-loader/check-utf8.cx -- ROOT WORKDIR
 *
 * 无参（批次形态）：在 out/check-utf8-<pid> 下自建材料。
 * 两参：复查既有材料。
 *
 * 分两层，各自独立：
 *   A 表本身对不对：本文件里手写一份 RFC 3629 的**规则函数**（逐字节判定，
 *     不读 tools/lab-loader/utf8-table.tsv，也不读事实表），对一组样例序列给出
 *     接受/拒绝；同一样例再交给生成的网（用产品同一解码器 + core_transition 逐字节走）
 *     判定，两者必须一致。
 *   B 网的构造是否守规矩：用现有链 seed-gen → seed-tbl → seed-net 从 utf8-table.tsv
 *     生成网，再用 net-check 做全键穷举（网 == 表）。
 *
 * 样例覆盖（覆盖度按 omp-cc-opus 2026-11-03 的要求）：ASCII、2/3/4 字节合法序列、
 * 过长编码（C0/C1、E0 80..9F、F0 80..8F）、代理区（ED A0..BF）、超过 U+10FFFF
 * （F4 90..BF、F5..FF）、截断序列、孤立续字节。
 *
 * 末行 CHECK_UTF8 cases=N failed=M；任何 FAIL 退出码 1。
 */
#pragma unisa use sys.env
#pragma unisa use cxlib.netpack
#pragma unisa use mem.bytes
#pragma unisa use runtime.model_decode
#pragma unisa use runtime.model_lifetime
#pragma unisa use runtime.model_number
#pragma unisa use core.transition

static int cu_failed, cu_cases;
static char cu_root[4096];

static void cu_die(const char *s) { fprintf(stderr, "check-utf8: %s\n", s); exit(2); }

static void cu_ck(int ok, const char *label) {
    cu_cases++;
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", label);
    if (!ok) cu_failed++;
}

static int cu_contains(const char *hay, size_t n, const char *needle) {
    size_t m = strlen(needle), i;
    if (!m || n < m) return 0;
    for (i = 0; i + m <= n; i++) if (!memcmp(hay + i, needle, m)) return 1;
    return 0;
}

static void *cu_alloc(void *p, size_t n) { return realloc(p, n ? n : 1); }
static void cu_release(void *p) { free(p); }

/* ---- A 层：手写规则 oracle（RFC 3629，逐字节） --------------------------------- */

/* 返回 1 接受,0 拒绝。规则按 RFC 3629 §4 的次字节约束写成,不看任何表。 */
static int cu_oracle(const unsigned char *s, long n) {
    long i = 0;
    while (i < n) {
        unsigned b = s[i];
        if (b < 0x80) { i++; continue; }
        if (b >= 0x80 && b <= 0xBF) return 0;              /* 孤立续字节 */
        if (b == 0xC0 || b == 0xC1) return 0;              /* 过长 2 字节 */
        if (b >= 0xC2 && b <= 0xDF) {
            if (i + 1 >= n) return 0;
            if (s[i + 1] < 0x80 || s[i + 1] > 0xBF) return 0;
            i += 2; continue;
        }
        if (b >= 0xE0 && b <= 0xEF) {
            unsigned lo = 0x80, hi = 0xBF;
            if (b == 0xE0) lo = 0xA0;                       /* 过长 3 字节 */
            if (b == 0xED) hi = 0x9F;                       /* 代理区 */
            if (i + 2 >= n) return 0;
            if (s[i + 1] < lo || s[i + 1] > hi) return 0;
            if (s[i + 2] < 0x80 || s[i + 2] > 0xBF) return 0;
            i += 3; continue;
        }
        if (b >= 0xF0 && b <= 0xF4) {
            unsigned lo = 0x80, hi = 0xBF;
            if (b == 0xF0) lo = 0x90;                       /* 过长 4 字节 */
            if (b == 0xF4) hi = 0x8F;                       /* 超过 U+10FFFF */
            if (i + 3 >= n) return 0;
            if (s[i + 1] < lo || s[i + 1] > hi) return 0;
            if (s[i + 2] < 0x80 || s[i + 2] > 0xBF) return 0;
            if (s[i + 3] < 0x80 || s[i + 3] > 0xBF) return 0;
            i += 4; continue;
        }
        return 0;                                            /* F5..FF 等 */
    }
    return 1;
}

/* ---- 用生成的网判同样的输入 ---------------------------------------------------- */

/* 走网：从 START 起每字节一次 core_transition，末尾给 EOF 键 256（与执行器
 * core_run_key 的 mode 0 同一规则）。判定：走到 ACCEPT 状态即接受；任何一步
 * 走到 REJECT 类状态（表里名字以 ACCEPT/DEAD 之外的终态）即拒绝。 */
static int cu_net_accept(const CxTransitionModel *m, int accept, const unsigned char *s, long n) {
    int q = m->start, i;
    for (i = 0; i <= n; i++) {
        int nx = -1, sq = 0;
        int key = i < n ? (int)s[i] : 256;
        if (core_transition(m, q, key, &nx, &sq)) return 0;
        if (nx < 0) return 0;
        q = nx;
        if (q == accept) return 1;
    }
    return 0;
}

int main(int argc, char **argv) {
    char work[4096], tbl[4400], net[4400], p[4400];
    size_t tn, nn;
    char *tbltext, *nettext;
    CxDecode dt, dn;
    CxTransitionModel mt;

    if (argc == 1) {
        if (!getcwd(cu_root, sizeof cu_root)) cu_die("getcwd");
        if (cx_fmt(work, sizeof work, "%s/check-utf8-XXXXXX", sy_env_or("TMPDIR", "/tmp")) || !mkdtemp(work)) cu_die("path");
    } else if (argc == 3) {
        if (!realpath(argv[1], cu_root)) cu_die("root");
        if (!realpath(argv[2], work)) cu_die("work directory must exist");
    } else cu_die("usage [ROOT WORKDIR]");

    /* 表由生成器写出（--check 会核对它与事实表一致）。 */
    {   char *av[] = {"sh", "./unisacc.com", "tools/lab-loader/utf8-gen.cx", "--", "--write", cu_root, 0};
        np_result r; char why[1024];
        if (np_run(av, cu_root, 0, 40, &r, why, sizeof why)) cu_die(why);
        cu_ck(r.rc == 0, "A1.generate-table");
        np_free(&r);
    }
    {   char *av[] = {"sh", "./unisacc.com", "tools/lab-loader/utf8-gen.cx", "--", "--check", cu_root, 0};
        np_result r; char why[1024];
        if (np_run(av, cu_root, 0, 40, &r, why, sizeof why)) cu_die(why);
        cu_ck(r.rc == 0, "A2.generator-check-passes");
        np_free(&r);
    }

    /* 构造链：seed-gen / seed-tbl / seed-net 由产品编译,再跑本表。 */
    if (snprintf(p, sizeof p, "%s/seed-gen", work) >= (int)sizeof p) cu_die("path");
    {   char *av[] = {"sh", "./unisacc.com", "-O0", "seed/gen.c", "-o", p, 0};
        np_result r; char why[1024];
        if (np_run(av, cu_root, 0, 55, &r, why, sizeof why)) cu_die(why);
        cu_ck(r.rc == 0, "A3.build-seed-gen");
        np_free(&r);
    }
    {   char g[4400], t[4400], n2[4400], man[4400], tab[4400];
        if (snprintf(g, sizeof g, "%s/seed-tbl", work) >= (int)sizeof g) cu_die("path");
        {   char *av[] = {"sh", "./unisacc.com", "-O1", "seed/tbl.c", "-o", g, 0};
            np_result r; char why[1024];
            if (np_run(av, cu_root, 0, 55, &r, why, sizeof why)) cu_die(why);
            cu_ck(r.rc == 0, "A4.build-seed-tbl");
            np_free(&r);
        }
        if (snprintf(n2, sizeof n2, "%s/seed-net", work) >= (int)sizeof n2) cu_die("path");
        {   char *av[] = {"sh", "./unisacc.com", "-O1", "seed/net.c", "-o", n2, 0};
            np_result r; char why[1024];
            if (np_run(av, cu_root, 0, 55, &r, why, sizeof why)) cu_die(why);
            cu_ck(r.rc == 0, "A5.build-seed-net");
            np_free(&r);
        }
        /* seed-gen 需要一个 <stem>/<name>-manifest.tsv 入口；本表放在 lab-utf8 下。 */
        if (snprintf(man, sizeof man, "%s/exec/lab-utf8/gen-manifest.tsv", work) >= (int)sizeof man) cu_die("path");
        {   char mk[4400], src[4400];
            if (snprintf(mk, sizeof mk, "%s/exec", work) >= (int)sizeof mk) cu_die("path");
            if (mkdir(mk, 0700) && errno != EEXIST) cu_die("exec dir");
            if (snprintf(mk, sizeof mk, "%s/exec/lab-utf8", work) >= (int)sizeof mk) cu_die("path");
            if (mkdir(mk, 0700)) cu_die("lab-utf8 dir");
            if (snprintf(src, sizeof src, "%s/tools/lab-loader/utf8-table.tsv", cu_root) >= (int)sizeof src) cu_die("path");
            if (snprintf(tab, sizeof tab, "%s/exec/lab-utf8/utf8-table.tsv", work) >= (int)sizeof tab) cu_die("path");
            {   size_t b, w;
                char *x = cx_read(src, &b);
                int fd;
                if (!x) cu_die("read utf8-table.tsv");
                fd = open(tab, O_WRONLY | O_CREAT | O_EXCL, 0644);
                if (fd < 0) { free(x); cu_die("copy table"); }
                w = 0;
                while (w < b) { ssize_t k = write(fd, x + w, b - w); if (k <= 0) { free(x); cu_die("write table"); } w += (size_t)k; }
                close(fd);
                free(x);
            }
            {   const char *m = "# op\tstem\tsection\twhen\tfacts\tfresh\tseq\tbind\topts\n"
                                "#! start $START\n"
                                "#! flags validate\n"
                                "let\t-\t-\t-\t-\t-\t-\tSTART=@str:START\t-\n"
                                "table\tutf8-table.tsv\t-\t-\t-\t-\t-\t-\t{\"mode\": \"b\", \"domain\": [0, 257], \"skip\": [\"HALT\"]}\n";
                int fd = open(man, O_WRONLY | O_CREAT | O_EXCL, 0644);
                if (fd < 0 || write(fd, m, strlen(m)) != (ssize_t)strlen(m) || close(fd)) cu_die("write manifest");
            }
        }
        if (snprintf(t, sizeof t, "%s/utf8.json", work) >= (int)sizeof t) cu_die("path");
        {   char *av[] = {p, "lab-utf8", t, 0};
            np_result r; char why[1024];
            if (np_run(av, work, 0, 40, &r, why, sizeof why)) cu_die(why);
            cu_ck(r.rc == 0, "A6.seed-gen-utf8");
            np_free(&r);
        }
        if (snprintf(tbl, sizeof tbl, "%s/utf8.tbl", work) >= (int)sizeof tbl) cu_die("path");
        {   char *av[] = {g, t, tbl, 0};
            np_result r; char why[1024];
            if (np_run(av, work, 0, 40, &r, why, sizeof why)) cu_die(why);
            cu_ck(r.rc == 0, "A7.seed-tbl");
            np_free(&r);
        }
        if (snprintf(net, sizeof net, "%s/utf8.net", work) >= (int)sizeof net) cu_die("path");
        {   char *av[] = {n2, tbl, net, 0};
            np_result r; char why[1024];
            if (np_run(av, work, 0, 40, &r, why, sizeof why)) cu_die(why);
            cu_ck(r.rc == 0, "A8.seed-net");
            np_free(&r);
        }
    }

    /* B 层：网 == 表 全键穷举。 */
    {   char *av[] = {"sh", "./unisacc.com", "tools/lab-loader/net-check.cx", tbl, net, 0};
        np_result r; char why[1024];
        if (np_run(av, cu_root, 0, 55, &r, why, sizeof why)) cu_die(why);
        cu_ck(r.rc == 0 && cu_contains(r.out, r.outn, "mode=table-equals-network"), "B1.net-equals-table-exhaustive");
        np_free(&r);
    }

    /* A 层：独立 oracle 逐样例判,并与网的判定比对。 */
    tbltext = cx_read(tbl, &tn);
    nettext = cx_read(net, &nn);
    if (!tbltext || !nettext) cu_die("read generated model");
    memset(&dt, 0, sizeof dt);
    dt.allocate = cu_alloc; dt.release = cu_release;
    if (cxmd_decode(&dt, (const unsigned char *)tbltext, (long)tn)) cu_die("table decode");
    memset(&dn, 0, sizeof dn);
    dn.allocate = cu_alloc; dn.release = cu_release;
    if (cxmd_decode(&dn, (const unsigned char *)nettext, (long)nn)) cu_die("net decode");
    free(tbltext); free(nettext);
    memset(&mt, 0, sizeof mt);
    mt.ns = dt.model.ns; mt.nq = dt.model.nq; mt.nrg = dt.model.nrg;
    mt.start = dt.model.start; mt.isnet = (char)dt.model.isnet;
    mt.str = dt.model.str; mt.strl = dt.model.strl;
    mt.qoff = dt.model.qoff; mt.qlen = dt.model.qlen; mt.qa = dt.model.qa;
    mt.mode = dt.model.smode; mt.count = dt.model.rowc; mt.keys = dt.model.rowk;
    mt.next = dt.model.rown; mt.seq = dt.model.rowq;
    mt.lo = dt.model.nlo; mt.hi = dt.model.nhi; mt.base_next = dt.model.bn; mt.base_seq = dt.model.bq;
    mt.ret_seq = dt.model.rets; mt.ret_ok = dt.model.retok;
    {   /* 终态：表里 EOF 走 ACCEPT 动作。tbl 的 S 表只存被动作引用的字符串，
           状态名不在其中，因此按“START 状态在键 256 上的 next”取 ACCEPT 状态号。 */
        int accept = -1, nx = -1, sq = 0;
        if (core_transition(&mt, mt.start, 256, &nx, &sq) || nx < 0) cu_die("no EOF transition from START");
        accept = nx;
        {
            static const struct { const char *name; const unsigned char b[6]; int n; } cases[] = {
                {"ascii", {'h','i',0,0,0,0}, 2},
                {"two-byte-c2", {0xc2,0xa2,0,0,0,0}, 2},
                {"two-byte-df", {0xdf,0xbf,0,0,0,0}, 2},
                {"three-byte-e0a0", {0xe0,0xa0,0x80,0,0,0}, 3},
                {"three-byte-efbf", {0xef,0xbf,0xbf,0,0,0}, 3},
                {"four-byte-f090", {0xf0,0x90,0x80,0x80,0,0}, 4},
                {"four-byte-f48f", {0xf4,0x8f,0xbf,0xbf,0,0}, 4},
                {"overlong-c0", {0xc0,0xaf,0,0,0,0}, 2},
                {"overlong-c1", {0xc1,0xbf,0,0,0,0}, 2},
                {"overlong-e080", {0xe0,0x80,0xaf,0,0,0}, 3},
                {"overlong-f080", {0xf0,0x80,0x80,0xaf,0,0}, 4},
                {"surrogate-eda0", {0xed,0xa0,0x80,0,0,0}, 3},
                {"surrogate-edbf", {0xed,0xbf,0xbf,0,0,0}, 3},
                {"above-10ffff-f490", {0xf4,0x90,0x80,0x80,0,0}, 4},
                {"invalid-f5", {0xf5,0x80,0x80,0x80,0,0}, 4},
                {"invalid-ff", {0xff,0,0,0,0,0}, 1},
                {"isolated-cont", {0x80,0,0,0,0,0}, 1},
                {"truncated-two", {0xc2,0,0,0,0,0}, 1},
                {"truncated-three", {0xe0,0xa0,0,0,0,0}, 2},
                {"truncated-four", {0xf0,0x90,0x80,0,0,0}, 3},
                {"bad-cont-after-ok", {0xc2,0x41,0,0,0,0}, 2},
                {"mixed-valid", {'a',0xc2,0xa2,0xe0,0xa0,0x80}, 6},
            };
            int i, same = 1;
            for (i = 0; i < (int)(sizeof cases / sizeof cases[0]); i++) {
                int want = cu_oracle(cases[i].b, cases[i].n);
                int got = cu_net_accept(&mt, accept, cases[i].b, cases[i].n);
                if (want != got) same = 0;
                {   char label[96];
                    if (snprintf(label, sizeof label, "A9.%s.%s", cases[i].name, want ? "accept" : "reject") >= (int)sizeof label) cu_die("label");
                    cu_ck(want == got, label);
                }
            }
            cu_ck(same, "A10.oracle-and-net-agree-on-all-samples");
        }
    }
    cxml_release(&dt.model, cu_release);
    cxml_release(&dn.model, cu_release);
    if (argc == 1) cx_rmtree(work);
    printf("CHECK_UTF8\tcases=%d\tfailed=%d\n", cu_cases, cu_failed);
    return cu_failed ? 1 : 0;
}
