/* check-net-check.cx -- net-check.cx 的独立检查（通用「网 == 表」核对器）。
 *
 *   sh ./unisacc.com tools/lab-loader/check-net-check.cx --
 *   sh ./unisacc.com tools/lab-loader/check-net-check.cx -- ROOT WORKDIR
 *
 * 无参（批次形态）：在 out/check-net-check-<pid> 下自建全部材料。
 * 两参：复查既有材料。
 *
 * 造料走现有构造链（不造权重格式）：
 *   ./unisacc.com -O0 seed/gen.c -o seed-gen     ; seed-gen prune OUT.json
 *   ./unisacc.com -O1 seed/tbl.c -o seed-tbl     ; seed-tbl IN.json OUT.tbl
 *   ./unisacc.com -O1 seed/net.c -o seed-net     ; seed-net IN.tbl OUT.net
 * 断言：
 *   N1 真实表的网与表穷举一致（prune,994 状态 = 888 旧状态 + 106 新增;新增全部来自 4f2c7e557 T1:
 *      PR.meta.* 5 个状态(prune-result.tsv) + tapeframe 表与 gen.c 生成的 TF./TD. 101 个状态）。
 *   N2 把网里一个 next 值改坏（仍能解码）→ 核对器必须非零退出,并给出
 *      首个不一致的 state/key 与两侧取值。
 *   N3 表与网形状不符（ns 不同）→ 必须具名拒绝。
 *   N4 同一材料跑两次输出逐字节相同（确定性）。
 *
 * 末行 CHECK_NET_CHECK assertions=N failed=M；任何 FAIL 退出码 1。
 */
#pragma unisa use cxlib.netpack

static int ck_failed, ck_asserts;
static char ck_root[4096];

static void ck_die(const char *s) { fprintf(stderr, "check-net-check: %s\n", s); exit(2); }

static void ck_ck(int ok, const char *label) {
    ck_asserts++;
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", label);
    if (!ok) ck_failed++;
}

static char *ck_read(const char *p, size_t *n) {
    char *s = cx_read(p, n);
    if (!s) ck_die(p);
    return s;
}

static int ck_contains(const char *hay, size_t n, const char *needle) {
    size_t m = strlen(needle), i;
    if (!m || n < m) return 0;
    for (i = 0; i + m <= n; i++) if (!memcmp(hay + i, needle, m)) return 1;
    return 0;
}

static void ck_sh(const char *root, char **av, const char *label, int want, char **out, size_t *outn) {
    np_result r;
    char why[1024];
    if (np_run(av, root, 0, 55, &r, why, sizeof why)) ck_die(why);
    if (want == 0 && r.rc != 0) {
        fprintf(stderr, "--- %s rc=%d ---\n%.*s", label, r.rc, (int)r.errn, r.err ? r.err : "");
        ck_ck(0, label);
    } else ck_ck(r.rc == want, label);
    if (out) { *out = r.out; *outn = r.outn; r.out = 0; r.outn = 0; }
    else if (r.errn) { fprintf(stderr, "%.*s", (int)r.errn, r.err); }
    np_free(&r);
}

int main(int argc, char **argv) {
    char work[4096], p[4400], q[4400], r2[4400], json[4400], tbl[4400], net[4400], bad[4400], badtbl[4400];
    char *o1, *o2;
    size_t n1, n2;

    if (argc == 1) {
        if (!getcwd(ck_root, sizeof ck_root)) ck_die("getcwd");
        if (snprintf(work, sizeof work, "%s/out/check-net-check-%d", ck_root, (int)getpid()) >= (int)sizeof work) ck_die("path");
        if (mkdir(work, 0700)) ck_die("work directory must be new");
    } else if (argc == 3) {
        if (!realpath(argv[1], ck_root)) ck_die("root");
        if (!realpath(argv[2], work)) ck_die("work directory must exist");
    } else ck_die("usage [ROOT WORKDIR]");

    /* 造料：产品编译三个构造器，再跑 prune 全链。 */
    if (snprintf(p, sizeof p, "%s/seed-gen", work) >= (int)sizeof p) ck_die("path");
    {   char *av[] = {"sh", "./unisacc.com", "-O0", "seed/gen.c", "-o", p, 0};
        ck_sh(ck_root, av, "N0a.build-seed-gen", 0, 0, 0);
    }
    if (snprintf(q, sizeof q, "%s/seed-tbl", work) >= (int)sizeof q) ck_die("path");
    {   char *av[] = {"sh", "./unisacc.com", "-O1", "seed/tbl.c", "-o", q, 0};
        ck_sh(ck_root, av, "N0b.build-seed-tbl", 0, 0, 0);
    }
    if (snprintf(r2, sizeof r2, "%s/seed-net", work) >= (int)sizeof r2) ck_die("path");
    {   char *av[] = {"sh", "./unisacc.com", "-O1", "seed/net.c", "-o", r2, 0};
        ck_sh(ck_root, av, "N0c.build-seed-net", 0, 0, 0);
    }
    if (snprintf(json, sizeof json, "%s/prune.json", work) >= (int)sizeof json) ck_die("path");
    {   char *av[] = {p, "prune", json, 0};
        ck_sh(ck_root, av, "N0d.seed-gen-prune", 0, 0, 0);
    }
    if (snprintf(tbl, sizeof tbl, "%s/prune.tbl", work) >= (int)sizeof tbl) ck_die("path");
    {   char *av[] = {q, json, tbl, 0};
        ck_sh(ck_root, av, "N0e.seed-tbl", 0, 0, 0);
    }
    if (snprintf(net, sizeof net, "%s/prune.net", work) >= (int)sizeof net) ck_die("path");
    {   char *av[] = {r2, tbl, net, 0};
        ck_sh(ck_root, av, "N0f.seed-net", 0, 0, 0);
    }

    /* N1：真实表的穷举一致。 */
    {   char *av[] = {"sh", "./unisacc.com", "tools/lab-loader/net-check.cx", tbl, net, 0};
        ck_sh(ck_root, av, "N1a.table-equals-network", 0, &o1, &n1);
        ck_ck(ck_contains(o1, n1, "mode=table-equals-network"), "N1b.reports-agreement");
        ck_ck(ck_contains(o1, n1, "states=994"), "N1c.all-states-covered");
        free(o1);
    }

    /* N4：同一材料两次输出逐字节相同。 */
    {   char *av[] = {"sh", "./unisacc.com", "tools/lab-loader/net-check.cx", tbl, net, 0};
        ck_sh(ck_root, av, "N4a.rerun", 0, &o2, &n2);
        {   char *av2[] = {"sh", "./unisacc.com", "tools/lab-loader/net-check.cx", tbl, net, 0};
            ck_sh(ck_root, av2, "N4b.rerun-again", 0, &o1, &n1);
        }
        ck_ck(n1 == n2 && !memcmp(o1, o2, n1), "N4c.output-deterministic");
        free(o1); free(o2);
    }

    /* N2：改坏网里一个 next 值（仍可解码）→ 必须首个不一致键报红。
       做法：按行复制整个网,只把第一条 H 行里的第一个 next 数字 +1。 */
    if (snprintf(bad, sizeof bad, "%s/prune-bad.net", work) >= (int)sizeof bad) ck_die("path");
    {   size_t tn;
        char *text = ck_read(net, &tn);
        char *out = malloc(tn + 64);
        size_t at = 0, w = 0;
        int patched = 0;
        if (!out) ck_die("allocation");
        while (at < tn) {
            size_t e = at;
            while (e < tn && text[e] != '\n') e++;
            if (!patched && e - at > 2 && text[at] == 'H' && text[at + 1] == ' ') {
                /* 逐个数字扫描,第 9 个数字是第一个 next;替换后原样接上剩余部分。 */
                size_t pos = at;
                int nth = 0, s0 = -1;
                while (pos < e) {
                    if (text[pos] >= '0' && text[pos] <= '9') {
                        size_t q = pos;
                        long v = 0;
                        while (q < e && text[q] >= '0' && text[q] <= '9') v = v * 10 + (text[q++] - '0');
                        nth++;
                        if (nth == 9) {
                            s0 = (int)pos;
                            for (size_t z = 0; z < (size_t)(pos - at); z++) out[w + z] = text[at + z];
                            w += (size_t)(pos - at);
                            { char num[32]; size_t numn; if (cx_fmt(num, sizeof num, "%ld", v + 1)) ck_die("format"); numn = strlen(num); for (size_t z = 0; z < numn; z++) out[w + z] = num[z]; w += numn; }
                            for (size_t z = 0; z < (size_t)(e - q + 1); z++) out[w + z] = text[q + z];
                            w += e - q + 1;
                            patched = 1;
                            break;
                        }
                        pos = q;
                        continue;
                    }
                    pos++;
                }
                if (!patched) { for (size_t z = 0; z < (size_t)(e - at + 1); z++) out[w + z] = text[at + z]; w += e - at + 1; }
            } else {
                for (size_t z = 0; z < (size_t)(e - at + 1); z++) out[w + z] = text[at + z];
                w += e - at + 1;
            }
            at = e + 1;
        }
        free(text);
        if (!patched) { free(out); ck_die("no H row to patch"); }
        {   int fd = open(bad, O_WRONLY | O_CREAT | O_EXCL, 0600);
            if (fd < 0 || write(fd, out, w) != (ssize_t)w || close(fd)) ck_die("write bad net");
        }
        free(out);
    }
    {   char *av[] = {"sh", "./unisacc.com", "tools/lab-loader/net-check.cx", tbl, bad, 0};
        ck_sh(ck_root, av, "N2a.corrupt-net-fails", 1, &o1, &n1);
        ck_ck(ck_contains(o1, n1, "FIRST_DIFFERENCE"), "N2b.names-first-difference");
        ck_ck(ck_contains(o1, n1, "state=") && ck_contains(o1, n1, "key="), "N2c.names-state-and-key");
        free(o1);
    }

    /* N3：形状不符（表换成另一份 ns 不同的表）→ 具名拒绝。 */
    if (snprintf(badtbl, sizeof badtbl, "%s/short.tbl", work) >= (int)sizeof badtbl) ck_die("path");
    {   const char *t = "T 2 1 1 0 0\nQ 1 0\nR 0 0 -1 0\nR 0 0 -1 0\n";
        int fd = open(badtbl, O_WRONLY | O_CREAT | O_EXCL, 0600);
        if (fd < 0 || write(fd, t, strlen(t)) != (ssize_t)strlen(t) || close(fd)) ck_die("write short table");
    }
    {   char *av[] = {"sh", "./unisacc.com", "tools/lab-loader/net-check.cx", badtbl, net, 0};
        ck_sh(ck_root, av, "N3a.shape-mismatch-refused", 2, &o1, &n1);
        free(o1);
    }

    printf("CHECK_NET_CHECK\tassertions=%d\tfailed=%d\n", ck_asserts, ck_failed);
    return ck_failed ? 1 : 0;
}
