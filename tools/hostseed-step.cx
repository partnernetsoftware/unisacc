int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN hostseed-step draft supports Linux/x86_64 host only\n",stderr);return 3;
#endif
 if(argc==5&&!strcmp(argv[1],"--bootstrap-ident")){setup(argv[2],argv[3]);bootstrap_ident(argv[4]);boundary();return 0;}if(argc==4&&!strcmp(argv[1],"--bootstrap-host")){setup(argv[2],argv[3]);bootstrap_host();boundary();return 0;}
 if(argc==9&&!strcmp(argv[1],"--verify-chain")){setup(argv[2],argv[3]);clean(argv[4]);clean(argv[5]);if(argv[4][0]!='/'||argv[5][0]!='/')die("absolute-models-and-payload-required");check_context();check_host();char before[65];strcpy(before,source_sha);const char *builder=host,*kind="native";char parent[4400];for(int i=6;i<9;i++){clean(argv[i]);if(argv[i][0]!='/')die("absolute-stage-required");stage(kind,builder,argv[4],argv[5],argv[i],"",1);path(parent,argv[i],"unisacc-seed.com");builder=parent;kind="ape";}check_context();check_host();if(strcmp(before,source_sha))die("source-changed-during-chain-verification");puts("VERIFIED\thostseed-fixed-P3-chain\tstages=3\tno-N22-no-test-result");boundary();return 0;}
 if(argc!=9)die("usage bootstrap-ident|bootstrap-host or ROOT CONTEXT KIND BUILDER MODELS PAYLOAD STAGE STEP");setup(argv[1],argv[2]);for(int i=4;i<=7;i++){clean(argv[i]);if(argv[i][0]!='/')die("absolute-input-and-stage-required");}check_context();check_host();stage(argv[3],argv[4],argv[5],argv[6],argv[7],argv[8],0);boundary();return 0;
}
