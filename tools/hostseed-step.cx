/* Explicit fixed-P3 driver lineage, NOT complete host-seed/N22.
 * --bootstrap-ident ROOT NEW_CONTEXT CC
 * --bootstrap-host ROOT CONTEXT
 * ROOT CONTEXT native|ape BUILDER MODELS PAYLOAD STAGE slice-OS/ARCH|wrap
 * --verify-chain ROOT CONTEXT MODELS PAYLOAD STAGE1 STAGE2 STAGE3
 * One mutation step per caller-owned tools/bound 55 command. NN and packaged
 * ASM kernels remain declared binary trust inputs, never claimed rebuilt.
 */
#pragma unisa use cxlib.netpack
static char root[4096],ctx[4096],ccpath[4096],bound[4400],helper[4400],host[4400],self[4400];
static char source_sha[65],cc_sha[65],cc_version_sha[65],helper_sha[65],helper_source_sha[65],bootstrap_sha[65],tool_sha[65],context_sha[65],host_sha[65],host_record_sha[65];
static const char *ident_flags="-std=c99 -D_POSIX_C_SOURCE=200809L -O2 -w";
static const char *host_flags="-O2 -Wall -Wextra";
static const char *targets[]={"win/x86_64","lnx/x86_64","lnx/arm64","osx/x86_64","osx/arm64"};
static const char *files[]={"slice-win-x86_64","slice-lnx-x86_64","slice-lnx-arm64","slice-osx-x86_64","slice-osx-arm64"};
static void boundary(void){puts("NOT_CLAIMED\tindependent-initial-source-measurement-hermetic-host-build-NN-or-ASM-kernel-source-rebuild-complete-N22-or-foreign-hosts");}
typedef struct {char *s;size_t n;char hash[65];char *schema,*key[32],*value[32];int count;} HsRecord;
static void die(const char *reason){fprintf(stderr,"hostseed-step: REFUSE %s errno=%d\n",reason,errno);exit(2);}
static void path(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path-bound");}
static void clean(const char *p){if(!p[0]||strpbrk(p,"\r\n\t"))die("unclean-path");}
static char *load(const char *p,size_t *n){struct stat a,b;errno=0;if(lstat(p,&a))die(errno==ENOENT?"input-absent":"input-stat");if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>134217728)die("bounded-regular-input");int fd=open(p,O_RDONLY|O_CLOEXEC|O_NOFOLLOW|O_NONBLOCK);if(fd<0||fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size)die("input-descriptor");*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s)die("allocation");size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("read-extent");at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int bad=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(z||bad||closed)die("input-changed");s[*n]=0;return s;}
static void hash(const char *p,char h[65]){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,h);free(s);}
static void absent(const char *p){struct stat st;errno=0;if(!lstat(p,&st)||errno!=ENOENT)die("exclusive-output-required");}
static void save(const char *p,const char *s,size_t n){int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive-record");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("record-write");at+=(size_t)z;}int synced=fsync(fd),closed=close(fd);if(synced||closed)die("record-close");}
static void equal_record(const char *p,const np_buf *expected){size_t n;char *s=load(p,&n);int ok=n==expected->n&&!memcmp(s,expected->p,n);free(s);if(!ok)die("receipt-bytes-mismatch");}
static HsRecord read_record(const char *p,const char *schema){HsRecord r={0};r.s=load(p,&r.n);cx_sha256_hex(r.s,r.n,r.hash);if(!r.n||r.s[r.n-1]!='\n'||memchr(r.s,0,r.n)||memchr(r.s,'\r',r.n))die("receipt-wire");char *line=r.s,*end=strchr(line,'\n');*end=0;r.schema=line;if(strcmp(line,schema))die("receipt-schema");line=end+1;while(*line){end=strchr(line,'\n');if(!end||r.count==32)die("receipt-row");*end=0;char *tab=strchr(line,'\t');if(!tab||strchr(tab+1,'\t')||tab==line||!tab[1])die("receipt-field");*tab=0;for(int i=0;i<r.count;i++)if(!strcmp(r.key[i],line))die("receipt-duplicate");r.key[r.count]=line;r.value[r.count++]=tab+1;line=end+1;}return r;}
static const char *field(const HsRecord *r,const char *key){for(int i=0;i<r->count;i++)if(!strcmp(r->key[i],key))return r->value[i];die("receipt-missing-field");return "";}
static void row(np_buf *b,const char *k,const char *v){np_puts(b,k);np_puts(b,"\t");np_puts(b,v);np_puts(b,"\n");}
static np_result call(char **v,int seconds){char why[1024];if(unsetenv("UNISACC_RF_CAPTURE")||unsetenv("UNISA_ATTRIBUTES"))die("clear-ambient-resource-state");np_result r;if(np_run(v,root,0,seconds+2,&r,why,sizeof why))die(why);return r;}
static void command(char **v,int seconds,const char *evidence){char p[4600];np_buf command_identity={0};for(int i=0;v[i];i++){clean(v[i]);char index[40];snprintf(index,sizeof index,"arg-%d",i);row(&command_identity,index,v[i]);}int az=snprintf(p,sizeof p,"%s.argv.tsv",evidence);if(az<0||(size_t)az>=sizeof p)die("evidence-path");save(p,command_identity.p,command_identity.n);free(command_identity.p);np_result r=call(v,seconds);int n=snprintf(p,sizeof p,"%s.stdout",evidence);if(n<0||(size_t)n>=sizeof p)die("evidence-path");save(p,r.out,r.outn);n=snprintf(p,sizeof p,"%s.stderr",evidence);if(n<0||(size_t)n>=sizeof p)die("evidence-path");save(p,r.err,r.errn);char status[40];n=snprintf(status,sizeof status,"rc\t%d\n",r.rc);snprintf(p,sizeof p,"%s.status",evidence);save(p,status,(size_t)n);if(r.errn)fwrite(r.err,1,r.errn,stderr);int rc=r.rc;np_free(&r);if(rc)die("child-step-failed");}
static void measure(char h[65],int installed){char product[4400],ident[4400];path(product,root,"unisacc.com");path(ident,root,"seed/ident.c");char *v[10];int n=0;v[n++]=bound;v[n++]=installed?"12":"6";if(installed){v[n++]="sh";v[n++]=product;v[n++]=ident;v[n++]="--";}else v[n++]=helper;v[n++]=root;v[n]=0;np_result r=call(v,installed?12:6);int ok=!r.rc&&!r.errn&&r.outn==65&&r.out[64]=='\n';if(ok){memcpy(h,r.out,64);h[64]=0;for(int i=0;i<64;i++)if(!((h[i]>='0'&&h[i]<='9')||(h[i]>='a'&&h[i]<='f')))ok=0;}np_free(&r);if(!ok)die("source-identity-measurement");}
static np_result version(void){char *v[]={bound,"2",ccpath,"--version",0};np_result r=call(v,2);if(r.rc||r.errn||!r.outn||r.outn>65536)die("host-CC-version");return r;}
static void resolve_cc(const char *arg){clean(arg);if(arg[0]!='/'||!realpath(arg,ccpath))die("explicit-absolute-CC-realpath-required");clean(ccpath);if(access(ccpath,X_OK))die("CC-not-executable");hash(ccpath,cc_sha);np_result r=version();cx_sha256_hex(r.out,r.outn,cc_version_sha);np_free(&r);}
static void setup(const char *r,const char *c){if(!realpath(r,root))die("root-realpath");clean(root);clean(c);if(c[0]!='/'||strlen(c)>=sizeof ctx)die("absolute-context-required");strcpy(ctx,c);path(bound,root,"tools/bound");path(helper,ctx,"identity-helper");path(host,ctx,"HOST");path(self,root,"tools/hostseed-step.cx");hash(self,tool_sha);}
static np_buf ident_record(void){np_buf b={0};np_puts(&b,"hostseed-ident-v1\n");row(&b,"source",source_sha);row(&b,"cc",ccpath);row(&b,"cc-sha",cc_sha);row(&b,"cc-version-sha",cc_version_sha);row(&b,"helper",helper_sha);row(&b,"helper-source",helper_source_sha);row(&b,"flags",ident_flags);row(&b,"measurement-bootstrap",bootstrap_sha);row(&b,"measurement-bootstrap-kind","installed-APE-source-measurement-only");row(&b,"tool",tool_sha);row(&b,"CC-subtools-and-system-libraries","DECLARED-HOST-DEPENDENCIES-NOT-INDEPENDENTLY-HASHED");return b;}
static void bootstrap_ident(const char *cc){char before[65],after[65],p[4400],evidence[4400];resolve_cc(cc);path(p,root,"seed/ident.c");hash(p,helper_source_sha);measure(before,1);strcpy(source_sha,before);path(p,root,"unisacc.com");hash(p,bootstrap_sha);if(mkdir(ctx,0700))die("new-context-required");np_result ver=version();cx_sha256_hex(ver.out,ver.outn,after);if(strcmp(after,cc_version_sha))die("CC-version-changed-before-ident-build");path(p,ctx,"cc.version");save(p,ver.out,ver.outn);np_free(&ver);path(p,root,"seed/ident.c");path(evidence,ctx,"bootstrap-ident");char *v[]={bound,"15",ccpath,"-std=c99","-D_POSIX_C_SOURCE=200809L","-O2","-w",p,"-o",helper,0};absent(helper);command(v,15,evidence);hash(helper,helper_sha);measure(after,0);if(strcmp(before,after))die("source-changed-during-ident-build");path(p,root,"seed/ident.c");hash(p,after);if(strcmp(after,helper_source_sha))die("identity-helper-source-changed");hash(ccpath,after);if(strcmp(after,cc_sha))die("CC-changed");ver=version();cx_sha256_hex(ver.out,ver.outn,after);np_free(&ver);if(strcmp(after,cc_version_sha))die("CC-version-changed");hash(self,after);if(strcmp(after,tool_sha))die("tool-changed");path(p,root,"unisacc.com");hash(p,after);if(strcmp(after,bootstrap_sha))die("measurement-bootstrap-changed");np_buf b=ident_record();path(p,ctx,"context.tsv");save(p,b.p,b.n);free(b.p);puts("PREPARED\thostseed-ident\troot-assisted-source-measurement\tno-test-result");}
static void check_context(void){char p[4400],now[65];path(p,ctx,"context.tsv");HsRecord r=read_record(p,"hostseed-ident-v1");if(r.count!=11)die("context-shape");const char *s=field(&r,"cc");if(strlen(s)>=sizeof ccpath||s[0]!='/')die("context-CC-path");strcpy(ccpath,s);strcpy(context_sha,r.hash);hash(ccpath,cc_sha);hash(helper,helper_sha);path(p,root,"seed/ident.c");hash(p,helper_source_sha);path(p,ctx,"cc.version");hash(p,cc_version_sha);path(p,root,"unisacc.com");hash(p,bootstrap_sha);measure(source_sha,0);np_buf expected=ident_record();path(p,ctx,"context.tsv");equal_record(p,&expected);free(expected.p);free(r.s);hash(self,now);if(strcmp(now,tool_sha))die("tool-changed");}
static np_buf host_record(void){np_buf b={0};np_puts(&b,"hostseed-host-v1\n");row(&b,"source",source_sha);row(&b,"context",context_sha);row(&b,"cc",cc_sha);row(&b,"cc-version",cc_version_sha);row(&b,"flags",host_flags);row(&b,"artifact",host_sha);row(&b,"core","C-core-no-UNISA_CORE_BLOB-no-ASM-defines");return b;}
static void check_host(void){hash(host,host_sha);np_buf b=host_record();char p[4400];path(p,ctx,"host.tsv");equal_record(p,&b);hash(p,host_record_sha);free(b.p);}
static void bootstrap_host(void){check_context();char before[65],after[65],oldcc[65],p[4400],evidence[4400];strcpy(before,source_sha);strcpy(oldcc,cc_sha);np_result ver=version();cx_sha256_hex(ver.out,ver.outn,after);np_free(&ver);if(strcmp(after,cc_version_sha))die("CC-version-changed");absent(host);path(p,root,"exec/c/compiler.c");path(evidence,ctx,"bootstrap-host");char *v[]={bound,"35",ccpath,"-O2","-Wall","-Wextra",p,"-o",host,0};command(v,35,evidence);hash(host,host_sha);check_context();if(strcmp(before,source_sha)||strcmp(oldcc,cc_sha))die("source-or-CC-changed-during-host-build");ver=version();cx_sha256_hex(ver.out,ver.outn,after);np_free(&ver);if(strcmp(after,cc_version_sha))die("CC-version-changed");np_buf b=host_record();path(p,ctx,"host.tsv");save(p,b.p,b.n);free(b.p);puts("PREPARED\thostseed-C-HOST\tdeclared-fixed-P3-input-required\tno-test-result");}
static void fixed_payload(const char *models,const char *payload,char mh[65],char ph[65]){size_t mn,pn;char *m=load(models,&mn),*p=load(payload,&pn);cx_sha256_hex(m,mn,mh);cx_sha256_hex(p,pn,ph);unsigned long long extent=0;if(mn<16||memcmp(m+mn-16,"UNIPKG1\n",8))die("models-must-be-complete-terminal-P3-product");for(int i=7;i>=0;i--)extent=(extent<<8)|(unsigned char)m[mn-8+i];if(strcmp(mh,bootstrap_sha)||extent!=pn||extent>mn-16||pn<4||memcmp(p,"P 3 ",4)||memcmp(m+mn-16-pn,p,pn))die("fixed-P3-payload-not-current-declared-input");free(m);free(p);}
static np_buf stage_record(const char *kind,const char *builder,const char *models,const char *payload,const char *mh,const char *ph,const char *bh,const char *parent,const char *parent_sha){np_buf b={0};np_puts(&b,"hostseed-stage-v1\n");row(&b,"source",source_sha);row(&b,"context",context_sha);row(&b,"host-receipt",host_record_sha);row(&b,"builder-kind",kind);row(&b,"builder",builder);row(&b,"builder-sha",bh);row(&b,"parent-receipt",parent);row(&b,"parent-receipt-sha",parent_sha);row(&b,"models",models);row(&b,"models-sha",mh);row(&b,"payload",payload);row(&b,"payload-sha",ph);row(&b,"payload-trust","NN-and-ASM-kernel-binary-inputs-NOT-source-rebuilt");row(&b,"slice-flags","-O2");row(&b,"wrap-flags","default-run-seed/ape.c-no-APE_ZLIB");return b;}
static np_buf artifact_record(const char *file,const char *stage_sha,const char *step,const char *builder_sha,const char *parent_sha,char actual_sha[65]){size_t n;char *s=load(file,&n),h[65],num[40];cx_sha256_hex(s,n,h);free(s);snprintf(num,sizeof num,"%lu",(unsigned long)n);np_buf b={0};np_puts(&b,"hostseed-artifact-v1\n");row(&b,"stage-context",stage_sha);row(&b,"step",step);row(&b,"artifact",h);row(&b,"bytes",num);row(&b,"builder",builder_sha);row(&b,"parent-receipt",parent_sha);row(&b,"source",source_sha);if(actual_sha)strcpy(actual_sha,h);return b;}
static void artifact(const char *file,const char *stage_sha,const char *step,const char *bh,const char *ps,int verify){np_buf b=artifact_record(file,stage_sha,step,bh,ps,0);char p[4600];int n=snprintf(p,sizeof p,"%s.hostseed.tsv",file);if(n<0||(size_t)n>=sizeof p)die("artifact-receipt-path");if(verify)equal_record(p,&b);else save(p,b.p,b.n);free(b.p);}
/* Parsed ancestor fields are traversal hints only. Nothing read from them is an
 * authority for flags, hashes, parentage, models, or payload. Rebuild from the
 * actual context HOST towards the proposed builder, then compare every byte.
 * This is bounded, read-only admission, not evidence of historical execution.
 * Each call physically rereads all ancestor artifacts and full receipts; no
 * verdict, mtime, or cross-call bytes cache. Canonical paths detect aliases and
 * cycles. At most 64 completed APE generations may precede a new step.
 */
typedef struct {char dir[4400],builder[4400];int native;} HsAncestor;
static void canonical_path(const char *p){char actual[4400];clean(p);if(p[0]!='/'||!realpath(p,actual)||strcmp(p,actual))die("parent-canonical-path-required");}
static void parent_anchor(char out[65]){np_buf b=ident_record(),h=host_record();np_put(&b,h.p,h.n);row(&b,"context-receipt-sha",context_sha);row(&b,"host-receipt-sha",host_record_sha);cx_sha256_hex(b.p,b.n,out);free(h.p);free(b.p);}
static void witness_record(np_buf *w,const char *p,const np_buf *expected){char h[65];cx_sha256_hex(expected->p,expected->n,h);row(w,p,h);}
static void canonical_artifact(np_buf *w,const char *p,const char *stage_sha,const char *step,const char *bh,const char *ps,char receipt_sha[65],char artifact_sha[65]){char actual[65];np_buf a=artifact_record(p,stage_sha,step,bh,ps,actual);char r[4600];int n=snprintf(r,sizeof r,"%s.hostseed.tsv",p);if(n<0||(size_t)n>=sizeof r)die("artifact-receipt-path");equal_record(r,&a);/* Expected bytes include the freshly read artifact's full SHA and extent. */witness_record(w,p,&a);witness_record(w,r,&a);if(receipt_sha)cx_sha256_hex(a.p,a.n,receipt_sha);if(artifact_sha)strcpy(artifact_sha,actual);free(a.p);}
static void parent_receipt(const char *kind,const char *builder,const char *models,const char *payload,const char *mh,const char *ph,char bh[65],char parent_sha[65],char parent_path[4400],char observation[65]){
 HsAncestor *nodes=calloc(64,sizeof *nodes);if(!nodes)die("allocation");int count=0;char cursor[4400],next_kind[16],p[4400],current_sha[65],current_parent_sha[65],current_parent[4400];np_buf witness={0};
 if(strlen(builder)>=sizeof cursor||strlen(kind)>=sizeof next_kind)die("parent-path-or-kind-bound");strcpy(cursor,builder);strcpy(next_kind,kind);canonical_path(host);
 for(;;){
  canonical_path(cursor);
  if(!strcmp(next_kind,"native")){if(strcmp(cursor,host))die("native-builder-must-be-context-HOST");break;}
  if(strcmp(next_kind,"ape"))die("builder-kind-must-be-native-or-ape");
  char directory[4400];strcpy(directory,cursor);char *slash=strrchr(directory,'/');if(!slash||strcmp(slash+1,"unisacc-seed.com"))die("APE-builder-basename");*slash=0;canonical_path(directory);
  struct stat st;if(lstat(directory,&st)||!S_ISDIR(st.st_mode))die("parent-stage-directory-not-real");
  for(int i=0;i<count;i++)if(!strcmp(nodes[i].dir,directory))die("parent-ancestry-cycle");if(count==64)die("parent-ancestry-depth-bound");
  HsAncestor *node=&nodes[count++];strcpy(node->dir,directory);path(p,directory,"stage.tsv");HsRecord r=read_record(p,"hostseed-stage-v1");if(r.count!=15)die("parent-stage-shape");
  const char *k=field(&r,"builder-kind"),*b=field(&r,"builder");if(strcmp(k,"native")&&strcmp(k,"ape"))die("builder-kind-must-be-native-or-ape");if(strlen(b)>=sizeof node->builder)die("parent-path-or-kind-bound");node->native=!strcmp(k,"native");strcpy(node->builder,b);strcpy(cursor,b);strcpy(next_kind,k);free(r.s);
 }
 hash(host,current_sha);if(strcmp(current_sha,host_sha))die("native-builder-must-be-context-HOST");path(current_parent,ctx,"host.tsv");np_buf host_expected=host_record();equal_record(current_parent,&host_expected);witness_record(&witness,current_parent,&host_expected);cx_sha256_hex(host_expected.p,host_expected.n,current_parent_sha);free(host_expected.p);if(strcmp(current_parent_sha,host_record_sha))die("parent-HOST-receipt-changed");row(&witness,host,current_sha);
 for(int i=count-1;i>=0;i--){
  HsAncestor *node=&nodes[i];const char *expected_kind=i==count-1?"native":"ape";char expected_builder[4400];if(i==count-1)strcpy(expected_builder,host);else path(expected_builder,nodes[i+1].dir,"unisacc-seed.com");
  if(node->native!=(!strcmp(expected_kind,"native"))||strcmp(node->builder,expected_builder))die("parent-canonical-ancestor-link");
  np_buf expected=stage_record(expected_kind,expected_builder,models,payload,mh,ph,current_sha,current_parent,current_parent_sha);char stage_sha[65];path(p,node->dir,"stage.tsv");equal_record(p,&expected);witness_record(&witness,p,&expected);cx_sha256_hex(expected.p,expected.n,stage_sha);free(expected.p);
  for(int j=0;j<5;j++){char step[80];snprintf(step,sizeof step,"slice-%s",targets[j]);path(p,node->dir,files[j]);canonical_artifact(&witness,p,stage_sha,step,current_sha,current_parent_sha,0,0);}
  path(p,node->dir,"unisacc-seed.com");char wrap_sha[65];canonical_artifact(&witness,p,stage_sha,"wrap",current_sha,current_parent_sha,wrap_sha,current_sha);int n=snprintf(current_parent,sizeof current_parent,"%s.hostseed.tsv",p);if(n<0||(size_t)n>=sizeof current_parent)die("parent-receipt-path");strcpy(current_parent_sha,wrap_sha);
 }
 strcpy(bh,current_sha);strcpy(parent_sha,current_parent_sha);strcpy(parent_path,current_parent);cx_sha256_hex(witness.p,witness.n,observation);free(witness.p);free(nodes);
}
static void admit_parent(const char *kind,const char *builder,const char *models,const char *payload,const char *mh,const char *ph,char bh[65],char ps[65],char parent[4400],char observation[65]){
 char anchor[65],after_anchor[65],again_b[65],again_ps[65],again_parent[4400],again_observation[65],again_m[65],again_p[65];parent_anchor(anchor);
 parent_receipt(kind,builder,models,payload,mh,ph,bh,ps,parent,observation);
 parent_receipt(kind,builder,models,payload,mh,ph,again_b,again_ps,again_parent,again_observation);
 if(strcmp(bh,again_b)||strcmp(ps,again_ps)||strcmp(parent,again_parent)||strcmp(observation,again_observation))die("parent-ancestry-changed-during-admission");
 /* The caller's fresh initial context/source measurement precedes both reads.
  * Repeat the full source/context/HOST and model/payload observations before
  * permitting any stage mkdir/write. All subprocess bounds and outer 55 stay.
  * These are endpoint observations, not an atomic snapshot/ABA guarantee. */
 check_context();check_host();parent_anchor(after_anchor);if(strcmp(anchor,after_anchor))die("parent-anchor-changed-during-admission");fixed_payload(models,payload,again_m,again_p);if(strcmp(mh,again_m)||strcmp(ph,again_p))die("parent-models-or-payload-changed-during-admission");
}
static int prefix(char **v,const char *kind,const char *builder,const char *models){int n=0;v[n++]=bound;v[n++]="40";if(!strcmp(kind,"ape"))v[n++]="sh";v[n++]=(char *)builder;v[n++]="--models";v[n++]=(char *)models;return n;}
static void stage(const char *kind,const char *builder,const char *models,const char *payload,const char *dir,const char *step,int verify){char before[65],anchor[65],mh[65],ph[65],bh[65],ps[65],parent[4400],p[4400],stsha[65],observation[65];strcpy(before,source_sha);parent_anchor(anchor);fixed_payload(models,payload,mh,ph);if(verify)parent_receipt(kind,builder,models,payload,mh,ph,bh,ps,parent,observation);else admit_parent(kind,builder,models,payload,mh,ph,bh,ps,parent,observation);np_buf expected=stage_record(kind,builder,models,payload,mh,ph,bh,parent,ps);path(p,dir,"stage.tsv");struct stat st;errno=0;if(lstat(dir,&st)){if(errno!=ENOENT||verify)die("stage-directory-absent-or-io");if(mkdir(dir,0700))die("new-stage-directory");save(p,expected.p,expected.n);}else{if(!S_ISDIR(st.st_mode))die("stage-directory-not-real");equal_record(p,&expected);}cx_sha256_hex(expected.p,expected.n,stsha);free(expected.p);
 if(verify){for(int i=0;i<5;i++){char s[80];snprintf(s,sizeof s,"slice-%s",targets[i]);path(p,dir,files[i]);artifact(p,stsha,s,bh,ps,1);}path(p,dir,"unisacc-seed.com");artifact(p,stsha,"wrap",bh,ps,1);return;}
 int selected=-1;for(int i=0;i<5;i++){char s[80];snprintf(s,sizeof s,"slice-%s",targets[i]);if(!strcmp(step,s))selected=i;}char output[4400],src[4400],evidence[4400],label[100];char *v[24];int n=prefix(v,kind,builder,models);if(selected>=0){path(output,dir,files[selected]);absent(output);path(src,root,"exec/c/asmcompiler.c");v[n++]="-O2";v[n++]="-b";v[n++]=(char *)targets[selected];v[n++]=src;v[n++]="-o";v[n++]=output;v[n]=0;strcpy(label,files[selected]);}
 else if(!strcmp(step,"wrap")){char slices[5][4400];for(int i=0;i<5;i++){char s[80];snprintf(s,sizeof s,"slice-%s",targets[i]);path(slices[i],dir,files[i]);artifact(slices[i],stsha,s,bh,ps,1);}path(output,dir,"unisacc-seed.com");absent(output);path(src,root,"seed/ape.c");char version_path[4400];path(version_path,root,"src/version.h");size_t vn;char *text=load(version_path,&vn);const char *needle="#define UNISACC_VERSION \"";char *at=strstr(text,needle);if(!at||strstr(at+1,needle))die("version-definition");at+=strlen(needle);static char release[40];size_t j=0;while(at[j]&&at[j]!='\"'){if(j>=sizeof release-1||!((at[j]>='0'&&at[j]<='9')||at[j]=='.'))die("version-value");release[j]=at[j];j++;}if(!j||at[j]!='\"')die("version-extent");release[j]=0;free(text);v[n++]=src;v[n++]="--";v[n++]="--payload";v[n++]=(char *)payload;v[n++]="--product";v[n++]="Unisacc";v[n++]=release;v[n++]=output;for(int i=0;i<5;i++)v[n++]=slices[i];v[n]=0;path(evidence,dir,"wrap");command(v,40,evidence);goto completed;}
 else die("unknown-step");path(evidence,dir,label);command(v,40,evidence);
completed:;
 char after_m[65],after_p[65],after_b[65],after_ps[65],after_parent[4400],after_observation[65],after_anchor[65];check_context();check_host();if(strcmp(before,source_sha))die("source-changed-during-stage");parent_anchor(after_anchor);if(strcmp(anchor,after_anchor))die("stage-anchor-changed");fixed_payload(models,payload,after_m,after_p);parent_receipt(kind,builder,models,payload,after_m,after_p,after_b,after_ps,after_parent,after_observation);if(strcmp(mh,after_m)||strcmp(ph,after_p)||strcmp(bh,after_b)||strcmp(ps,after_ps)||strcmp(parent,after_parent)||strcmp(observation,after_observation))die("stage-input-changed");np_buf final=stage_record(kind,builder,models,payload,mh,ph,bh,parent,ps);path(p,dir,"stage.tsv");equal_record(p,&final);free(final.p);if(!strcmp(step,"wrap")){for(int i=0;i<5;i++){char s[80];snprintf(s,sizeof s,"slice-%s",targets[i]);path(p,dir,files[i]);artifact(p,stsha,s,bh,ps,1);}}artifact(output,stsha,step,bh,ps,0);printf("PREPARED\thostseed-step\t%s\tfixed-P3-declared-kernel-input\tno-test-result\n",step);
}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN hostseed-step draft supports Linux/x86_64 host only\n",stderr);return 3;
#endif
 if(argc==5&&!strcmp(argv[1],"--bootstrap-ident")){setup(argv[2],argv[3]);bootstrap_ident(argv[4]);boundary();return 0;}if(argc==4&&!strcmp(argv[1],"--bootstrap-host")){setup(argv[2],argv[3]);bootstrap_host();boundary();return 0;}
 if(argc==9&&!strcmp(argv[1],"--verify-chain")){setup(argv[2],argv[3]);clean(argv[4]);clean(argv[5]);if(argv[4][0]!='/'||argv[5][0]!='/')die("absolute-models-and-payload-required");check_context();check_host();char before[65];strcpy(before,source_sha);const char *builder=host,*kind="native";char parent[4400];for(int i=6;i<9;i++){clean(argv[i]);if(argv[i][0]!='/')die("absolute-stage-required");stage(kind,builder,argv[4],argv[5],argv[i],"",1);path(parent,argv[i],"unisacc-seed.com");builder=parent;kind="ape";}check_context();check_host();if(strcmp(before,source_sha))die("source-changed-during-chain-verification");puts("VERIFIED\thostseed-fixed-P3-chain\tstages=3\tno-N22-no-test-result");boundary();return 0;}
 if(argc!=9)die("usage bootstrap-ident|bootstrap-host or ROOT CONTEXT KIND BUILDER MODELS PAYLOAD STAGE STEP");setup(argv[1],argv[2]);for(int i=4;i<=7;i++){clean(argv[i]);if(argv[i][0]!='/')die("absolute-input-and-stage-required");}check_context();check_host();stage(argv[3],argv[4],argv[5],argv[6],argv[7],argv[8],0);boundary();return 0;
}
