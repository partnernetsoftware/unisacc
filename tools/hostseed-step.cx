dence[4400];path(pmsrc,root,"cx/compiler/parsemore.cx");path(pmobj,ctx,"parsemore-host.o");path(pm_evidence,ctx,"bootstrap-parsemore");absent(pmobj);char *pmv[]={bound,"35",ccpath,"-O2","-x","c","-include",prelude,"-c",pmsrc,"-o",pmobj,0};command(pmv,35,pm_evidence);char fgsrc[4400],fgobj[4400],fg_evidence[4400];path(fgsrc,root,"cx/compiler/floatgate.cx");path(fgobj,ctx,"floatgate-host.o");path(fg_evidence,ctx,"bootstrap-floatgate");absent(fgobj);char *fgv[]={bound,"35",ccpath,"-O2","-x","c","-include",prelude,"-c",fgsrc,"-o",fgobj,0};command(fgv,35,fg_evidence);char tqsrc[4400],tqobj[4400],tq_evidence[4400];path(tqsrc,root,"cx/compiler/bindtemp.cx");path(tqobj,ctx,"bindtemp-host.o");path(tq_evidence,ctx,"bootstrap-bindtemp");absent(tqobj);char *tqv[]={bound,"35",ccpath,"-O2","-x","c","-include",prelude,"-c",tqsrc,"-o",tqobj,0};command(tqv,35,tq_evidence);char kqsrc[4400],kqobj[4400],kq_evidence[4400];path(kqsrc,root,"cx/compiler/bindkey.cx");path(kqobj,ctx,"bindkey-host.o");path(kq_evidence,ctx,"bootstrap-bindkey");absent(kqobj);char *kqv[]={bound,"35",ccpath,"-O2","-x","c","-include",prelude,"-c",kqsrc,"-o",kqobj,0};command(kqv,35,kq_evidence);char sqsrc[4400],sqobj[4400],sq_evidence[4400];path(sqsrc,root,"cx/compiler/bindsplit.cx");path(sqobj,ctx,"bindsplit-host.o");path(sq_evidence,ctx,"bootstrap-bindsplit");absent(sqobj);char *sqv[]={bound,"35",ccpath,"-O2","-x","c","-include",prelude,"-c",sqsrc,"-o",sqobj,0};command(sqv,35,sq_evidence);char gqsrc[4400],gqobj[4400],gq_evidence[4400];path(gqsrc,root,"cx/compiler/bindstage.cx");path(gqobj,ctx,"bindstage-host.o");path(gq_evidence,ctx,"bootstrap-bindstage");absent(gqobj);char *gqv[]={bound,"35",ccpath,"-O2","-x","c","-include",prelude,"-c",gqsrc,"-o",gqobj,0};command(gqv,35,gq_evidence);char fqsrc[4400],fqobj[4400],fq_evidence[4400];path(fqsrc,root,"cx/compiler/bindfilter.cx");path(fqobj,ctx,"bindfilter-host.o");path(fq_evidence,ctx,"bootstrap-bindfilter");absent(fqobj);char *fqv[]={bound,"35",ccpath,"-O2","-x","c","-include",prelude,"-c",fqsrc,"-o",fqobj,0};command(fqv,35,fq_evidence);path(p,root,"exec/c/compiler.c");path(evidence,ctx,"bootstrap-host");char *v[]={bound,"35",ccpath,"-O2","-Wall","-Wextra",p,obj,depobj,inputobj,pathobj,argsobj,cliobj,compatobj,envobj,arcobj,rtobj,cdobj,fobj,aobj,mobj,lobj,dobj,pobj,pdobj,tobj,xobj,alobj,sobj,oobj,mmobj,byobj,sfobj,tlobj,atobj,fsobj,cmobj,fmobj,mlobj,sgobj,fiobj,piobj,hbobj,rsobj,rtobj,tmobj,mlobj,reobj,shobj,bdobj,boobj,bgobj,btobj,brobj,biobj,bnobj,beobj,baobj,bcobj,syobj,hhobj,tqobj,kqobj,sqobj,gqobj,fqobj,"-o",host,0};command(v,35,evidence);hash(host,host_sha);check_context();if(strcmp(before,source_sha)||strcmp(oldcc,cc_sha))die("source-or-CC-changed-during-host-build");ver=version();cx_sha256_hex(ver.out,ver.outn,after);np_free(&ver);if(strcmp(after,cc_version_sha))die("CC-version-changed");np_buf b=host_record();path(p,ctx,"host.tsv");save(p,b.p,b.n);free(b.p);puts("PREPARED\thostseed-C-HOST\tdeclared-fixed-P3-input-required\tno-test-result");}
static void fixed_payload(const char *models,const char *payload,char mh[65],char ph[65]){size_t mn,pn;char *m=load(models,&mn),*p=load(payload,&pn);cx_sha256_hex(m,mn,mh);cx_sha256_hex(p,pn,ph);unsigned long long extent=0;if(mn<16||memcmp(m+mn-16,"UNIPKG1\n",8))die("models-must-be-complete-terminal-P3-product");for(int i=7;i>=0;i--)extent=(extent<<8)|(unsigned char)m[mn-8+i];if(strcmp(mh,bootstrap_sha)||extent!=pn||extent>mn-16||pn<4||memcmp(p,"P 3 ",4)||memcmp(m+mn-16-pn,p,pn))die("fixed-P3-payload-not-current-declared-input");free(m);free(p);}
static np_buf stage_record(const char *kind,const char *builder,const char *models,const char *payload,const char *mh,const char *ph,const char *bh,const char *parent,const char *parent_sha){np_buf b={0};np_puts(&b,"hostseed-stage-v1\n");row(&b,"source",source_sha);row(&b,"context",context_sha);row(&b,"host-receipt",host_record_sha);row(&b,"builder-kind",kind);row(&b,"builder",builder);row(&b,"builder-sha",bh);row(&b,"parent-receipt",parent);row(&b,"parent-receipt-sha",parent_sha);row(&b,"models",models);row(&b,"models-sha",mh);row(&b,"payload",payload);row(&b,"payload-sha",ph);row(&b,"payload-trust","NN-and-ASM-kernel-binary-inputs-NOT-source-rebuilt");row(&b,"slice-flags","-O2");row(&b,"wrap-flags","builder-run-DAPE_ZLIB-I/usr/include/node-lz-seed/ape.c;fixed-zlib-content-pins-in-tool");return b;}
static np_buf artifact_record(const char *file,const char *stage_sha,const char *step,const char *builder_sha,const char *parent_sha,char actual_sha[65]){size_t n;char *s=load(file,&n),h[65],num[40];cx_sha256_hex(s,n,h);free(s);snprintf(num,sizeof num,"%lu",(unsigned long)n);np_buf b={0};np_puts(&b,"hostseed-artifact-v1\n");row(&b,"stage-context",stage_sha);row(&b,"step",step);row(&b,"artifact",h);row(&b,"bytes",num);row(&b,"builder",builder_sha);row(&b,"parent-receipt",parent_sha);row(&b,"source",source_sha);if(actual_sha)strcpy(actual_sha,h);return b;}
static void artifact(const char *file,const char *stage_sha,const char *step,const char *bh,const char *ps,int verify){np_buf b=artifact_record(file,stage_sha,step,bh,ps,0);char p[4600];int n=snprintf(p,sizeof p,"%s.hostseed.tsv",file);if(n<0||(size_t)n>=sizeof p)die("artifact-receipt-path");if(verify)equal_record(p,&b);else save(p,b.p,b.n);free(b.p);}
/* Parsed ancestor fields are traversal hints only. Nothing read from them is an
 * authority for flags, hashes, parentage, models, or payload. Rebuild from the
 * actual context HOST towards the proposed builder, then compare every byte.
 * This is bounded, read-only admission, not evidence of historical execution.
 * Each call physically rereads all ancestor artifacts and full receipts; no
 * verdict, mtime, or cross-call bytes cache. Canonical paths detect aliases and
 * cycles. At most 64 completed APE generations may precede a new step.
 */
typedef struct {char dir[4400],builder[4400];int native;} HsAncestor;
static void canonical_path(const char *p){char actual[4400];clean(p);if(p[0]!='/'||!realpath(p,actual)||strcmp(p,actual))die("parent-canonical-path-required");}
static void parent_anchor(char out[65]){np_buf b=ident_record(),h=host_record();np_put(&b,h.p,h.n);row(&b,"context-receipt-sha",context_sha);row(&b,"host-receipt-sha",host_record_sha);cx_sha256_hex(b.p,b.n,out);free(h.p);free(b.p);}
static void witness_record(np_buf *w,const char *p,const np_buf *expected){char h[65];cx_sha256_hex(expected->p,expected->n,h);row(w,p,h);}
static void canonical_artifact(np_buf *w,const char *p,const char *stage_sha,const char *step,const char *bh,const char *ps,char receipt_sha[65],char artifact_sha[65]){char actual[65];np_buf a=artifact_record(p,stage_sha,step,bh,ps,actual);char r[4600];int n=snprintf(r,sizeof r,"%s.hostseed.tsv",p);if(n<0||(size_t)n>=sizeof r)die("artifact-receipt-path");equal_record(r,&a);/* Expected bytes include the freshly read artifact's full SHA and extent. */witness_record(w,p,&a);witness_record(w,r,&a);if(receipt_sha)cx_sha256_hex(a.p,a.n,receipt_sha);if(artifact_sha)strcpy(artifact_sha,actual);free(a.p);}
static void parent_receipt(const char *kind,const char *builder,const char *models,const char *payload,const char *mh,const char *ph,char bh[65],char parent_sha[65],char parent_path[4400],char observation[65]){
 HsAncestor *nodes=calloc(64,sizeof *nodes);if(!nodes)die("allocation");int count=0;char cursor[4400],next_kind[16],p[4400],current_sha[65],current_parent_sha[65],current_parent[4400];np_buf witness={0};
 if(strlen(builder)>=sizeof cursor||strlen(kind)>=sizeof next_kind)die("parent-path-or-kind-bound");strcpy(cursor,builder);strcpy(next_kind,kind);canonical_path(host);
 for(;;){
  canonical_path(cursor);
  if(!strcmp(next_kind,"native")){if(strcmp(cursor,host))die("native-builder-must-be-context-HOST");break;}
  if(strcmp(next_kind,"ape"))die("builder-kind-must-be-native-or-ape");
  char directory[4400];strcpy(directory,cursor);char *slash=strrchr(directory,'/');if(!slash||strcmp(slash+1,"unisacc-seed.com"))die("APE-builder-basename");*slash=0;canonical_path(directory);
  struct stat st;if(lstat(directory,&st)||!S_ISDIR(st.st_mode))die("parent-stage-directory-not-real");
  for(int i=0;i<count;i++)if(!strcmp(nodes[i].dir,directory))die("parent-ancestry-cycle");if(count==64)die("parent-ancestry-depth-bound");
  HsAncestor *node=&nodes[count++];strcpy(node->dir,directory);path(p,directory,"stage.tsv");HsRecord r=read_record(p,"hostseed-stage-v1");if(r.count!=15)die("parent-stage-shape");
  const char *k=field(&r,"builder-kind"),*b=field(&r,"builder");if(strcmp(k,"native")&&strcmp(k,"ape"))die("builder-kind-must-be-native-or-ape");if(strlen(b)>=sizeof node->builder)die("parent-path-or-kind-bound");node->native=!strcmp(k,"native");strcpy(node->builder,b);strcpy(cursor,b);strcpy(next_kind,k);free(r.s);
 }
 hash(host,current_sha);if(strcmp(current_sha,host_sha))die("native-builder-must-be-context-HOST");path(current_parent,ctx,"host.tsv");np_buf host_expected=host_record();equal_record(current_parent,&host_expected);witness_record(&witness,current_parent,&host_expected);cx_sha256_hex(host_expected.p,host_expected.n,current_parent_sha);free(host_expected.p);if(strcmp(current_parent_sha,host_record_sha))die("parent-HOST-receipt-changed");row(&witness,host,current_sha);
 for(int i=count-1;i>=0;i--){
  HsAncestor *node=&nodes[i];const char *expected_kind=i==count-1?"native":"ape";char expected_builder[4400];if(i==count-1)strcpy(expected_builder,host);else path(expected_builder,nodes[i+1].dir,"unisacc-seed.com");
  if(node->native!=(!strcmp(expected_kind,"native"))||strcmp(node->builder,expected_builder))die("parent-canonical-ancestor-link");
  np_buf expected=stage_record(expected_kind,expected_builder,models,payload,mh,ph,current_sha,current_parent,current_parent_sha);char stage_sha[65];path(p,node->dir,"stage.tsv");equal_record(p,&expected);witness_record(&witness,p,&expected);cx_sha256_hex(expected.p,expected.n,stage_sha);free(expected.p);
  for(int j=0;j<5;j++){char step[80];snprintf(step,sizeof step,"slice-%s",targets[j]);path(p,node->dir,files[j]);canonical_artifact(&witness,p,stage_sha,step,current_sha,current_parent_sha,0,0);}
  path(p,node->dir,"unisacc-seed.com");char wrap_sha[65];canonical_artifact(&witness,p,stage_sha,"wrap",current_sha,current_parent_sha,wrap_sha,current_sha);int n=snprintf(current_parent,sizeof current_parent,"%s.hostseed.tsv",p);if(n<0||(size_t)n>=sizeof current_parent)die("parent-receipt-path");strcpy(current_parent_sha,wrap_sha);
 }
 strcpy(bh,current_sha);strcpy(parent_sha,current_parent_sha);strcpy(parent_path,current_parent);cx_sha256_hex(witness.p,witness.n,observation);free(witness.p);free(nodes);
}
static void admit_parent(const char *kind,const char *builder,const char *models,const char *payload,const char *mh,const char *ph,char bh[65],char ps[65],char parent[4400],char observation[65]){
 char anchor[65],after_anchor[65],again_b[65],again_ps[65],again_parent[4400],again_observation[65],again_m[65],again_p[65];parent_anchor(anchor);
 parent_receipt(kind,builder,models,payload,mh,ph,bh,ps,parent,observation);
 parent_receipt(kind,builder,models,payload,mh,ph,again_b,again_ps,again_parent,again_observation);
 if(strcmp(bh,again_b)||strcmp(ps,again_ps)||strcmp(parent,again_parent)||strcmp(observation,again_observation))die("parent-ancestry-changed-during-admission");
 /* The caller's fresh initial context/source measurement precedes both reads.
  * Repeat the full source/context/HOST and model/payload observations before
  * permitting any stage mkdir/write. All subprocess bounds and outer 55 stay.
  * These are endpoint observations, not an atomic snapshot/ABA guarantee. */
 check_context();check_host();parent_anchor(after_anchor);if(strcmp(anchor,after_anchor))die("parent-anchor-changed-during-admission");fixed_payload(models,payload,again_m,again_p);if(strcmp(mh,again_m)||strcmp(ph,again_p))die("parent-models-or-payload-changed-during-admission");
}
static int prefix(char **v,const char *kind,const char *builder,const char *models){int n=0;v[n++]=bound;v[n++]="40";if(!strcmp(kind,"ape"))v[n++]="sh";v[n++]=(char *)builder;v[n++]="--models";v[n++]=(char *)models;return n;}
static void stage(const char *kind,const char *builder,const char *models,const char *payload,const char *dir,const char *step,int verify){char before[65],anchor[65],mh[65],ph[65],bh[65],ps[65],parent[4400],p[4400],stsha[65],observation[65];strcpy(before,source_sha);parent_anchor(anchor);fixed_payload(models,payload,mh,ph);if(verify)parent_receipt(kind,builder,models,payload,mh,ph,bh,ps,parent,observation);else admit_parent(kind,builder,models,payload,mh,ph,bh,ps,parent,observation);np_buf expected=stage_record(kind,builder,models,payload,mh,ph,bh,parent,ps);path(p,dir,"stage.tsv");struct stat st;errno=0;if(lstat(dir,&st)){if(errno!=ENOENT||verify)die("stage-directory-absent-or-io");if(mkdir(dir,0700))die("new-stage-directory");save(p,expected.p,expected.n);}else{if(!S_ISDIR(st.st_mode))die("stage-directory-not-real");equal_record(p,&expected);}cx_sha256_hex(expected.p,expected.n,stsha);free(expected.p);
