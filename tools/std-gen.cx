#pragma unisa use sys.io
#pragma unisa use text.text
/* Project exec/facts/pp-standard.tsv onto the compiler and runtime standard tables.
   sh ./unisacc.com tools/std-gen.cx -- --check
   sh ./unisacc.com tools/std-gen.cx -- --write
   Three rows, file order. A row is the name column and the value column.
   The value keeps the quotes from the fact file.
   A null out-pointer returns 4. An index outside 0..count-1 returns 2.
   These names are not target predefines.
   No libc and no include. */
#define TSV "exec/facts/pp-standard.tsv"
#define NROW 3
#define NAMEMAX 32
#define FILECAP 4096
#define CHECKCAP 8192
#define HEAD1 "# name\tvalue"

typedef struct {
    char name[NAMEMAX];
    char value[NAMEMAX];
} Row;

static Row rows[NROW];
static int nrows;

static int fail(const char *why) {
    sy_eprintf("std-gen\tFAIL\t%s\n", why);
    return 1;
}

static int name_ok(const char *s, int n) {
    int i;
    char c;
    if (n < 1 || n >= NAMEMAX) return 0;
    c = s[0];
    if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '_')) return 0;
    for (i = 1; i < n; i++) {
        c = s[i];
        if (c >= 'A' && c <= 'Z') continue;
        if (c >= 'a' && c <= 'z') continue;
        if (c >= '0' && c <= '9') continue;
        if (c == '_') continue;
        return 0;
    }
    return 1;
}

static int value_ok(const char *s, int n) {
    int i;
    if (n < 3 || n >= NAMEMAX) return 0;
    if (s[0] != '"' || s[n - 1] != '"') return 0;
    for (i = 1; i < n - 1; i++) {
        char c = s[i];
        if (c >= '0' && c <= '9') continue;
        if (c >= 'A' && c <= 'Z') continue;
        if (c >= 'a' && c <= 'z') continue;
        return 0;
    }
    return 1;
}

static void copy_field(char *dst, const char *s, int n) {
    int i;
    for (i = 0; i < n; i++) dst[i] = s[i];
    dst[n] = 0;
}

static int take_row(const char *line, int n) {
    const char *f[2];
    int len[2];
    int i, k, start;
    if (nrows >= NROW) return fail("std-count");
    k = 0;
    start = 0;
    for (i = 0; i <= n; i++) {
        if (i == n || line[i] == '\t') {
            if (k >= 2) return fail("row-fields");
            f[k] = line + start;
            len[k] = i - start;
            k++;
            start = i + 1;
        }
    }
    if (k != 2) return fail("row-fields");
    if (!name_ok(f[0], len[0])) return fail("name-charset");
    if (!value_ok(f[1], len[1])) return fail("value-charset");
    copy_field(rows[nrows].name, f[0], len[0]);
    copy_field(rows[nrows].value, f[1], len[1]);
    nrows++;
    return 0;
}

static int parse_tsv(char *b, size_t n) {
    size_t i = 0;
    int saw = 0;
    if (n == 0 || b[n - 1] != '\n') return fail("tsv-newline");
    while (i < n) {
        size_t e = i;
        while (e < n && b[e] != '\n') e++;
        b[e] = 0;
        if (e == i) return fail("tsv-blank");
        if (!saw) {
            if (!tx_eqz(b + i, HEAD1)) return fail("tsv-header");
            saw = 1;
        } else if (b[i] == '#') {
            return fail("tsv-comment");
        } else if (take_row(b + i, (int)(e - i))) {
            return 1;
        }
        i = e + 1;
    }
    if (nrows != NROW) return fail("std-count");
    return 0;
}

static int unique_rows(void) {
    int i, j;
    for (i = 0; i < nrows; i++) {
        for (j = i + 1; j < nrows; j++) {
            if (tx_eqz(rows[i].name, rows[j].name)) return fail("name-dup");
        }
    }
    return 0;
}

static int app(char *dst, int cap, int *n, const char *s) {
    int i = 0;
    while (s[i]) {
        if (*n + 1 >= cap) return -1;
        dst[*n] = s[i];
        *n += 1;
        i++;
    }
    dst[*n] = 0;
    return 0;
}

static int app_digit(char *dst, int cap, int *n, int d) {
    char s[2];
    if (d < 0 || d > 9) return -1;
    s[0] = (char)('0' + d);
    s[1] = 0;
    return app(dst, cap, n, s);
}

static int app_cstr(char *dst, int cap, int *n, const char *s) {
    int i;
    char one[2];
    if (app(dst, cap, n, "\"")) return -1;
    one[1] = 0;
    for (i = 0; s[i]; i++) {
        if (s[i] == '\\' || s[i] == '"') {
            if (app(dst, cap, n, "\\")) return -1;
        }
        one[0] = s[i];
        if (app(dst, cap, n, one)) return -1;
    }
    return app(dst, cap, n, "\"");
}

static int emit_mod(char *dst, int cap, const char *prefix) {
    int n = 0, i;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa module stdname\n")) return -1;
    if (app(dst, cap, &n, "/* Generated by tools/std-gen.cx from exec/facts/pp-standard.tsv.\n")) return -1;
    if (app(dst, cap, &n, "   Do not edit by hand. value keeps the fact-file quotes.\n")) return -1;
    if (app(dst, cap, &n, "   A null out-pointer returns 4. An index outside 0..count-1 returns 2.\n")) return -1;
    if (app(dst, cap, &n, "   No libc and no include. */\n")) return -1;
    if (app(dst, cap, &n, "int ")) return -1;
    if (app(dst, cap, &n, prefix)) return -1;
    if (app(dst, cap, &n, "_count(void) {\n    return ")) return -1;
    if (app_digit(dst, cap, &n, nrows)) return -1;
    if (app(dst, cap, &n, ";\n}\n")) return -1;
    if (app(dst, cap, &n, "int ")) return -1;
    if (app(dst, cap, &n, prefix)) return -1;
    if (app(dst, cap, &n, "_at(int index, const char **name, const char **value) {\n")) return -1;
    if (app(dst, cap, &n, "    if (!name || !value) return 4;\n")) return -1;
    for (i = 0; i < nrows; i++) {
        if (app(dst, cap, &n, "    if (index == ")) return -1;
        if (app_digit(dst, cap, &n, i)) return -1;
        if (app(dst, cap, &n, ") { *name = ")) return -1;
        if (app_cstr(dst, cap, &n, rows[i].name)) return -1;
        if (app(dst, cap, &n, "; *value = ")) return -1;
        if (app_cstr(dst, cap, &n, rows[i].value)) return -1;
        if (app(dst, cap, &n, "; return 0; }\n")) return -1;
    }
    if (app(dst, cap, &n, "    return 2;\n}\n")) return -1;
    return n;
}

static int emit_check(char *dst, int cap) {
    int n = 0, i;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa use compiler.stdname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use runtime.stdname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use compiler.predefname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use runtime.predefname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use sys.io\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use text.text\n")) return -1;
    if (app(dst, cap, &n, "/* Generated by tools/std-gen.cx. Narrow check of the three standard macros. */\n")) return -1;
    if (app(dst, cap, &n, "int main(void) {\n")) return -1;
    if (app(dst, cap, &n, "    const char *name; const char *value; const char *on; const char *ov;\n")) return -1;
    if (app(dst, cap, &n, "    const char *k; const char *s; const char *a; const char *b; const char *c;\n")) return -1;
    if (app(dst, cap, &n, "    const char **missing; int i; int j;\n")) return -1;
    if (app(dst, cap, &n, "    missing = 0;\n")) return -1;
    if (app(dst, cap, &n, "    if (sdn_count() != 3 || rsd_count() != 3) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (pdn_count() != 8 || rpd_count() != 8) return 1;\n")) return -1;
    for (i = 0; i < nrows; i++) {
        if (app(dst, cap, &n, "    if (sdn_at(")) return -1;
        if (app_digit(dst, cap, &n, i)) return -1;
        if (app(dst, cap, &n, ", &name, &value) || !tx_eqz(name, ")) return -1;
        if (app_cstr(dst, cap, &n, rows[i].name)) return -1;
        if (app(dst, cap, &n, ") || !tx_eqz(value, ")) return -1;
        if (app_cstr(dst, cap, &n, rows[i].value)) return -1;
        if (app(dst, cap, &n, ")) return 1;\n")) return -1;
        if (app(dst, cap, &n, "    if (rsd_at(")) return -1;
        if (app_digit(dst, cap, &n, i)) return -1;
        if (app(dst, cap, &n, ", &on, &ov) || !tx_eqz(on, name) || !tx_eqz(ov, value)) return 1;\n")) return -1;
    }
    if (app(dst, cap, &n, "    for (i = 0; i < sdn_count(); i++) {\n")) return -1;
    if (app(dst, cap, &n, "        if (sdn_at(i, &name, &value)) return 1;\n")) return -1;
    if (app(dst, cap, &n, "        for (j = 0; j < pdn_count(); j++) {\n")) return -1;
    if (app(dst, cap, &n, "            if (pdn_at(j, &k, &s, &a, &b, &c)) return 1;\n")) return -1;
    if (app(dst, cap, &n, "            if (tx_eqz(name, a) || tx_eqz(name, b) || tx_eqz(name, c)) return 1;\n")) return -1;
    if (app(dst, cap, &n, "            if (rpd_at(j, &k, &s, &a, &b, &c)) return 1;\n")) return -1;
    if (app(dst, cap, &n, "            if (tx_eqz(name, a) || tx_eqz(name, b) || tx_eqz(name, c)) return 1;\n")) return -1;
    if (app(dst, cap, &n, "        }\n")) return -1;
    if (app(dst, cap, &n, "    }\n")) return -1;
    if (app(dst, cap, &n, "    if (sdn_at(0, missing, &value) != 4) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (sdn_at(0, &name, missing) != 4) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rsd_at(0, missing, &value) != 4) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (sdn_at(-1, &name, &value) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (sdn_at(3, &name, &value) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rsd_at(-1, &name, &value) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rsd_at(3, &name, &value) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    sy_printf(\"CX_STD\\tok=3\\tpredef=8\\tfailed=0\\n\");\n")) return -1;
    if (app(dst, cap, &n, "    return 0;\n}\n")) return -1;
    return n;
}

static int same_bytes(const char *a, size_t an, const char *b, int bn) {
    int i;
    if (an != (size_t)bn) return 0;
    for (i = 0; i < bn; i++) if (a[i] != b[i]) return 0;
    return 1;
}

static int one_file(int dowrite, const char *path, const char *body, int n) {
    size_t on = 0;
    char *cur;
    if (dowrite) {
        if (cx_write(path, body, (size_t)n)) return fail("write");
        return 0;
    }
    cur = cx_read(path, &on);
    if (!cur) return fail(path);
    if (!same_bytes(cur, on, body, n)) return fail(path);
    return 0;
}

int main(int argc, char **argv) {
    size_t nb = 0;
    char *b;
    char file[FILECAP], check[CHECKCAP];
    int dowrite, fn, cn;
    if (argc != 2 || (!tx_eqz(argv[1], "--check") && !tx_eqz(argv[1], "--write"))) {
        sy_eprintf("std-gen\tusage\t--check|--write\n");
        return 2;
    }
    dowrite = tx_eqz(argv[1], "--write");
    b = cx_read(TSV, &nb);
    if (!b) return fail("tsv-read");
    if (parse_tsv(b, nb)) return 1;
    if (unique_rows()) return 1;
    cn = emit_check(check, CHECKCAP);
    if (cn < 0) return fail("emit-check");
    fn = emit_mod(file, FILECAP, "sdn");
    if (fn < 0) return fail("emit-compiler");
    if (one_file(dowrite, "cx/compiler/stdname.cx", file, fn)) return 1;
    fn = emit_mod(file, FILECAP, "rsd");
    if (fn < 0) return fail("emit-runtime");
    if (one_file(dowrite, "cx/runtime/stdname.cx", file, fn)) return 1;
    if (one_file(dowrite, "tools/check-cx-std.cx", check, cn)) return 1;
    if (dowrite) sy_printf("STD_GEN\tWROTE\trows=%d\n", nrows);
    else sy_printf("STD_GEN\tCHECK\trows=%d\n", nrows);
    return 0;
}
