#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use text.text
/* Project the encoder image flags onto compiler and runtime skeletons.
   sh ./unisacc.com tools/image-gen.cx -- --check
   sh ./unisacc.com tools/image-gen.cx -- --write
   Six encoder manifests carry the same "#! flags" line.
   The names on that line are the image kinds. The step returns 0.
   No libc and no include. */
#define NSRC 6
#define NIMAGE 4
#define NAMEMAX 32
#define FILECAP 1024
#define CHECKCAP 4096

static const char *srcs[NSRC] = {
    "exec/enc/gen-manifest.tsv",
    "exec/enc/arm-manifest.tsv",
    "exec/enc/unitcontainer-osx-x86_64-manifest.tsv",
    "exec/enc/unitcontainer-osx-arm64-manifest.tsv",
    "exec/enc/unitcontainer-win-x86_64-manifest.tsv",
    "exec/enc/unitcontainer-win-arm64-manifest.tsv"
};

typedef struct { char name[NAMEMAX]; } Row;

static Row rows[NIMAGE];
static int nrows;

static int fail(const char *why) {
    sy_eprintf("image-gen\tFAIL\t%s\n", why);
    return 1;
}

static int ident(const char *s, int n) {
    int i;
    if (n < 1 || n >= NAMEMAX) return 0;
    if (s[0] < 'a' || s[0] > 'z') return 0;
    for (i = 1; i < n; i++) {
        char c = s[i];
        if (c >= 'a' && c <= 'z') continue;
        if (c >= '0' && c <= '9') continue;
        if (c == '_') continue;
        return 0;
    }
    return 1;
}

static void copy_field(char *dst, const char *s, int n) {
    int i;
    for (i = 0; i < n; i++) dst[i] = s[i];
    dst[n] = 0;
}

static int take_flags(const char *line, int n, int first) {
    const char *mark = "#! flags ";
    int i = 0, start, count = 0;
    char name[NAMEMAX];
    while (mark[i]) {
        if (i >= n || line[i] != mark[i]) return fail("flags-mark");
        i++;
    }
    while (i < n) {
        if (line[i] == ' ') return fail("flags-space");
        start = i;
        while (i < n && line[i] != ' ') i++;
        if (!ident(line + start, i - start)) return fail("flags-name");
        copy_field(name, line + start, i - start);
        if (count >= NIMAGE) return fail("image-count");
        if (first) copy_field(rows[count].name, name, i - start);
        else if (!tx_eqz(rows[count].name, name)) return fail("flags-differ");
        count++;
        if (i < n && line[i] == ' ') i++;
    }
    if (count != NIMAGE) return fail("image-count");
    if (first) nrows = count;
    return 0;
}

static int parse_src(const char *path, int first) {
    size_t n = 0, i = 0;
    char *b = cx_read(path, &n);
    int saw = 0;
    if (!b) return fail(path);
    if (n == 0 || b[n - 1] != '\n') return fail("tsv-newline");
    while (i < n) {
        size_t e = i;
        int isflag;
        while (e < n && b[e] != '\n') e++;
        b[e] = 0;
        isflag = 0;
        if ((int)(e - i) >= 9) {
            const char *mark = "#! flags ";
            int k = 0;
            isflag = 1;
            while (mark[k]) {
                if (b[i + k] != mark[k]) isflag = 0;
                k++;
            }
        }
        if (isflag) {
            if (saw) return fail("flags-twice");
            if (take_flags(b + i, (int)(e - i), first)) return 1;
            saw = 1;
        }
        i = e + 1;
    }
    if (!saw) return fail("flags-missing");
    return 0;
}

static int unique_names(void) {
    int i, j;
    for (i = 0; i < nrows; i++) {
        for (j = i + 1; j < nrows; j++) {
            if (tx_eqz(rows[i].name, rows[j].name)) return fail("name-dup");
        }
    }
    return 0;
}

static int app(char *dst, int cap, int *n, const char *s) {
    int i = 0;
    while (s[i]) {
        if (*n + 1 >= cap) return -1;
        dst[*n] = s[i];
        *n += 1;
        i++;
    }
    dst[*n] = 0;
    return 0;
}

static int emit_mod(char *dst, int cap, const char *name, const char *prefix) {
    int n = 0;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa module ")) return -1;
    if (app(dst, cap, &n, name)) return -1;
    if (app(dst, cap, &n, "\n/* Generated by tools/image-gen.cx. Image kind skeleton.\n")) return -1;
    if (app(dst, cap, &n, "   The name is the encoder flags line. The step returns 0.\n")) return -1;
    if (app(dst, cap, &n, "   Do not edit by hand. No libc and no include. */\n")) return -1;
    if (app(dst, cap, &n, "int ")) return -1;
    if (app(dst, cap, &n, prefix)) return -1;
    if (app(dst, cap, &n, "_")) return -1;
    if (app(dst, cap, &n, name)) return -1;
    if (app(dst, cap, &n, "(void) {\n    return 0;\n}\n")) return -1;
    if (app(dst, cap, &n, "const char *")) return -1;
    if (app(dst, cap, &n, prefix)) return -1;
    if (app(dst, cap, &n, "_")) return -1;
    if (app(dst, cap, &n, name)) return -1;
    if (app(dst, cap, &n, "_kind(void) {\n    return \"")) return -1;
    if (app(dst, cap, &n, name)) return -1;
    if (app(dst, cap, &n, "\";\n}\n")) return -1;
    return n;
}

static int emit_check(char *dst, int cap) {
    int n = 0, i;
    dst[0] = 0;
    for (i = 0; i < nrows; i++) {
        if (app(dst, cap, &n, "#pragma unisa use compiler.image.")) return -1;
        if (app(dst, cap, &n, rows[i].name)) return -1;
        if (app(dst, cap, &n, "\n")) return -1;
        if (app(dst, cap, &n, "#pragma unisa use runtime.image.")) return -1;
        if (app(dst, cap, &n, rows[i].name)) return -1;
        if (app(dst, cap, &n, "\n")) return -1;
    }
    if (app(dst, cap, &n, "#pragma unisa use sys.io\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use text.text\n")) return -1;
    if (app(dst, cap, &n, "/* Generated by tools/image-gen.cx. Narrow check of the image kinds. */\n")) return -1;
    if (app(dst, cap, &n, "int main(void) {\n")) return -1;
    for (i = 0; i < nrows; i++) {
        if (app(dst, cap, &n, "    if (img_")) return -1;
        if (app(dst, cap, &n, rows[i].name)) return -1;
        if (app(dst, cap, &n, "()) return 1;\n")) return -1;
        if (app(dst, cap, &n, "    if (!tx_eqz(img_")) return -1;
        if (app(dst, cap, &n, rows[i].name)) return -1;
        if (app(dst, cap, &n, "_kind(), \"")) return -1;
        if (app(dst, cap, &n, rows[i].name)) return -1;
        if (app(dst, cap, &n, "\")) return 1;\n")) return -1;
        if (app(dst, cap, &n, "    if (rim_")) return -1;
        if (app(dst, cap, &n, rows[i].name)) return -1;
        if (app(dst, cap, &n, "()) return 1;\n")) return -1;
        if (app(dst, cap, &n, "    if (!tx_eqz(rim_")) return -1;
        if (app(dst, cap, &n, rows[i].name)) return -1;
        if (app(dst, cap, &n, "_kind(), \"")) return -1;
        if (app(dst, cap, &n, rows[i].name)) return -1;
        if (app(dst, cap, &n, "\")) return 1;\n")) return -1;
    }
    if (app(dst, cap, &n, "    sy_printf(\"CX_IMAGE\\tok=4\\tfailed=0\\n\");\n")) return -1;
    if (app(dst, cap, &n, "    return 0;\n}\n")) return -1;
    return n;
}

static int same_bytes(const char *a, size_t an, const char *b, int bn) {
    int i;
    if (an != (size_t)bn) return 0;
    for (i = 0; i < bn; i++) if (a[i] != b[i]) return 0;
    return 1;
}

static int one_file(int dowrite, const char *path, const char *body, int n) {
    size_t on = 0;
    char *cur;
    if (dowrite) {
        if (cx_write(path, body, (size_t)n)) return fail("write");
        return 0;
    }
    cur = cx_read(path, &on);
    if (!cur) return fail(path);
    if (!same_bytes(cur, on, body, n)) return fail(path);
    return 0;
}

static int ensure_dir(const char *path) {
    if (sy_mkdir(path, 0755) && sy_exists(path) != 1) return fail(path);
    return 0;
}

int main(int argc, char **argv) {
    char file[FILECAP], check[CHECKCAP], path[160];
    int dowrite, i, fn, cn;
    if (argc != 2 || (!tx_eqz(argv[1], "--check") && !tx_eqz(argv[1], "--write"))) {
        sy_eprintf("image-gen\tusage\t--check|--write\n");
        return 2;
    }
    dowrite = tx_eqz(argv[1], "--write");
    for (i = 0; i < NSRC; i++) if (parse_src(srcs[i], i == 0)) return 1;
    if (nrows != NIMAGE) return fail("image-count");
    if (unique_names()) return 1;
    cn = emit_check(check, CHECKCAP);
    if (cn < 0) return fail("emit-check");
    if (dowrite) {
        if (ensure_dir("cx/compiler/image") || ensure_dir("cx/runtime/image")) return 1;
    }
    for (i = 0; i < nrows; i++) {
        fn = emit_mod(file, FILECAP, rows[i].name, "img");
        if (fn < 0) return fail("emit-compiler");
        if (cx_fmt(path, sizeof path, "cx/compiler/image/%s.cx", rows[i].name)) return fail("path");
        if (one_file(dowrite, path, file, fn)) return 1;
        fn = emit_mod(file, FILECAP, rows[i].name, "rim");
        if (fn < 0) return fail("emit-runtime");
        if (cx_fmt(path, sizeof path, "cx/runtime/image/%s.cx", rows[i].name)) return fail("path");
        if (one_file(dowrite, path, file, fn)) return 1;
    }
    if (one_file(dowrite, "tools/check-cx-image.cx", check, cn)) return 1;
    if (dowrite) sy_printf("IMAGE_GEN\tWROTE\tkinds=%d\n", nrows);
    else sy_printf("IMAGE_GEN\tCHECK\tkinds=%d\n", nrows);
    return 0;
}
