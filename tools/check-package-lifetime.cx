#pragma unisa use runtime.package_lifetime
static void *owned[32]; static int n,freed,bad;
static void *make(void){void *p=malloc(8);if(!p)exit(2);owned[n++]=p;return p;}
static void release(void *p){if(!p)return;for(int i=0;i<n;i++)if(owned[i]==p){owned[i]=0;freed++;free(p);return;}bad++;}
int main(void){
 CxPackage p={0};p.path=make();p.file=make();p.b=p.file+1;p.off=make();p.len=make();p.raw=make();p.crc=make();p.res=make();
 p.stages=calloc(2,sizeof *p.stages);if(!p.stages)return 2;owned[n++]=p.stages;p.s=2;
 p.stages[0].route=make();p.stages[0].name=make();p.stages[0].in=make();p.stages[0].out=make();
 p.stages[1].route=make();p.stages[1].in=make();p.complete=1;
 cxpl_release(&p,release);CxPackage zero={0};
 if(bad||freed!=n||memcmp(&p,&zero,sizeof p)){fprintf(stderr,"release failed freed=%d expected=%d bad=%d\n",freed,n,bad);return 1;}
 cxpl_release(&p,release);cxpl_release(0,release);if(bad||freed!=n)return 1;
 puts("CXPACKAGE_LIFETIME failed=0");return 0;
}
