#pragma unisa use cxlib.ckassert
#pragma unisa use chrome_dom
/* tools/check-uxe-tex4.cx -- 4x4 nearest 像素等于源 texel0 RGB 255,0,0.
 *
 * sh ./unisacc.com tools/check-uxe-tex4.cx --
 */
static int failed;
int main(void) {
    int exp_r = 255, exp_g = 0, exp_b = 0;
    char cwd[512], url[640];
    const char *pre = "file://";
    const char *suf = "/ujs/practice/uxe/test/tex4.html";
    const char *fin[3];
    int retries = 0, rc, n, i;
    if (!getcwd(cwd, sizeof cwd)) return 2;
    n = 0;
    while (pre[n]) { url[n] = pre[n]; n++; }
    for (i = 0; cwd[i] && n < 500; i++) url[n++] = cwd[i];
    for (i = 0; suf[i] && n < 630; i++) url[n++] = suf[i];
    url[n] = 0;
    fin[0] = "TEX4_OK";
    fin[1] = "TEX4_FAIL";
    fin[2] = "TEX4_ERR";
    rc = chd_dump_expect("/usr/bin/google-chrome", url, "TEX4_OK", fin, 3, "tex4", 3, 25, &retries);
    if (rc == 3) { printf("TEX4_UNMEASURED\tno-chrome\n"); return 2; }
    ck_record(&failed, rc == 0, "tex4-pixel");
    printf("EXPECT\t%d,%d,%d\n", exp_r, exp_g, exp_b);
    printf("CHECK_UXE_TEX4\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
