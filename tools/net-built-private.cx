/* Construct a private built.json entry from a verified partition material,
 * then run the native kernel emitter (tools/kernel-emit.cx --built) into that private root.
 * ROOT NAME MATERIAL NEW_ABS_OUT. No live source or kernel file is changed. */
#pragma unisa use cxlib.netpack
#pragma unisa use text.text
static char root[4096],mat[4096],out[4096],name[100],selected[18][100],materials[18][4096];static int nselected;
static void die(const char *s){fprintf(stderr,"net-built-private: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void copy_fit(char *dst, size_t cap, const char *src){size_t i=0;if(cap==0)die("copy-bound");while(src[i]&&i+1<cap){dst[i]=src[i];i++;}if(src[i])die("copy-bound");dst[i]=0;}
static void path(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path-bound");}
static char *load(const char *p,size_t *n){struct stat a,b;errno=0;if(lstat(p,&a))die(errno==ENOENT?"input-absent":"input-stat");if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>16777216)die("bounded-regular-input");int fd=open(p,O_RDONLY|O_CLOEXEC|O_NONBLOCK|O_NOFOLLOW);if(fd<0)die("input-open");if(fstat(fd,&b)||!S_ISREG(b.st_mode)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size){close(fd);die("input-descriptor");}*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s){close(fd);die("allocation");}size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0){close(fd);die("input-extent");}at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int changed=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(z||changed||closed){free(s);die("input-changed-or-close");}s[*n]=0;return s;}
static void save(const char *p,const char *s,size_t n){int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive-output");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0){close(fd);die("output-write");}at+=(size_t)z;}int synced=fsync(fd),closed=close(fd);if(synced||closed)die("output-close");}
static void verify_material(void){char product[4400],bound[4400],tool[4400],why[1400];path(product,root,"unisacc.com");path(bound,root,"tools/bound");path(tool,root,"tools/gold-partition-material.cx");char *v[]={bound,"20","sh",product,tool,"--","--verify",root,name,mat,0};np_result r;if(np_run(v,root,0,23,&r,why,sizeof why))die(why);char want[200];int n=snprintf(want,sizeof want,"VERIFIED\tgold-partition-material\tstage=%s\t",name);int good=!r.rc&&!r.errn&&n>0&&n<(int)sizeof want&&r.outn>(size_t)n&&r.out[r.outn-1]=='\n'&&!memcmp(r.out,want,(size_t)n);if(!good&&r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);if(!good)die("partition-material-current-verification");}
static void digest_file(const char *p,char h[65]){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,h);free(s);}
static void require_field(const char *s,const char *key,const char *value){char needle[300];int n=snprintf(needle,sizeof needle,"\n%s\t%s\n",key,value);if(n<0||n>=(int)sizeof needle||!strstr(s,needle)||strstr(strstr(s,needle)+1,needle))die("material-receipt-field");}
static void verify_receipted_material(void){char p[4400],gold[4400],tool[4400],product[4400],h[65];path(p,mat,"material.tsv");size_t n;char *receipt=load(p,&n);if(n<40||strncmp(receipt,"gold-partition-material-v1\n",27)||receipt[n-1]!='\n'||memchr(receipt,0,n))die("material-receipt-wire");require_field(receipt,"status","PREPARED");require_field(receipt,"stage",name);char rel[200];int z=snprintf(rel,sizeof rel,"weights/gold/%s.tsv",name);if(z<0||z>=(int)sizeof rel)die("gold-path");path(gold,root,rel);path(tool,root,"tools/gold-partition-material.cx");path(product,root,"unisacc.com");digest_file(gold,h);require_field(receipt,"gold-sha256",h);digest_file(tool,h);require_field(receipt,"tool-sha256",h);digest_file(product,h);require_field(receipt,"product-sha256",h);path(p,mat,"weights.bin");digest_file(p,h);require_field(receipt,"weights-sha256",h);path(p,mat,"model.json");digest_file(p,h);require_field(receipt,"model-json-sha256",h);free(receipt);}
static char *stage_start(char *s){char tag[120];int n=snprintf(tag,sizeof tag,"\"%s\":",name);if(n<0||n>=(int)sizeof tag)die("stage-tag");char *p=strstr(s,tag);if(!p||strstr(p+1,tag)||p[n]!='{')die("unique-stage-json-member");return p+n;}
static char *object_end(char *s,size_t n){int depth=0,string=0,escape=0;for(size_t i=0;i<n;i++){char c=s[i];if(string){if(escape)escape=0;else if(c=='\\')escape=1;else if(c=='\"')string=0;continue;}if(c=='\"'){string=1;continue;}if(c=='{')depth++;else if(c=='}'&&--depth==0)return s+i+1;else if(c=='}'&&depth<0)die("json-object-depth");}die("json-object-end");return 0;}
static int nybble(char c){if(c>='0'&&c<='9')return c-'0';if(c>='a'&&c<='f')return c-'a'+10;return -1;}
static np_buf literal(const char *file){size_t n;char *s=load(file,&n),*p=strstr(s,"*/");if(!p)die("generated-literal-comment");p+=2;np_buf b={0};while(*p){while(*p==' '||*p=='\t'||*p=='\n'||*p=='\r')p++;if(!*p)break;if(*p!='\"')die("generated-literal-quote");p++;while(*p&&*p!='\"'){if(!p[1]||!p[2]||!p[3]||p[0]!='\\'||p[1]!='x'||nybble(p[2])<0||nybble(p[3])<0)die("generated-literal-hex");char c=(char)((nybble(p[2])<<4)|nybble(p[3]));np_put(&b,&c,1);p+=4;}if(*p!='\"')die("generated-literal-close");p++;}free(s);return b;}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN net-built-private requires Linux/x86_64 LP64\n",stderr);return 3;
#endif
 int quick=argc>=6&&tx_eq(argv[1], "--combine-receipted", 1L << 20),combined=quick||(argc>=6&&tx_eq(argv[1], "--combine", 1L << 20));if(sizeof(long)!=8)die("LP64-required");if(combined){if(argc<6||(argc-4)%2||!realpath(argv[2],root)||argv[3][0]!='/'||strlen(argv[3])>=sizeof out||strpbrk(argv[3],"\r\n\t"))die("usage---combine-ROOT-NEW-ABS-OUT-NAME-MAT-pairs");copy_fit(out,sizeof out,argv[3]);nselected=(argc-4)/2;if(nselected>18)die("stage-count");for(int i=0;i<nselected;i++){const char *nm=argv[4+i*2],*ma=argv[5+i*2];if(strlen(nm)>=sizeof name||strpbrk(nm,"/\\\r\n\t")||!realpath(ma,materials[i]))die("stage-or-material-path");for(int j=0;j<i;j++)if(tx_eq(selected[j], nm, 1L << 20))die("duplicate-stage");copy_fit(selected[i],sizeof selected[i],nm);}}else{if(argc!=5||!realpath(argv[1],root)||strlen(argv[2])>=sizeof name||strpbrk(argv[2],"/\\\r\n\t")||!realpath(argv[3],materials[0])||argv[4][0]!='/'||strlen(argv[4])>=sizeof out||strpbrk(argv[4],"\r\n\t"))die("usage-ROOT-NAME-MATERIAL-NEW-ABS-OUT");copy_fit(selected[0],sizeof selected[0],argv[2]);copy_fit(out,sizeof out,argv[4]);nselected=1;}for(int i=0;i<nselected;i++){copy_fit(name,sizeof name,selected[i]);copy_fit(mat,sizeof mat,materials[i]);if(quick)verify_receipted_material();else verify_material();}
 char src[4400],dst[4400],oldh[65],newh[65];path(src,root,"weights/built.json");size_t bn;char *old=load(src,&bn);if(memchr(old,0,bn)||!bn||old[0]!='{'||old[bn-1]!='}')die("built-json-wire");cx_sha256_hex(old,bn,oldh);np_buf built={0};np_put(&built,old,bn);free(old);for(int i=0;i<nselected;i++){copy_fit(name,sizeof name,selected[i]);copy_fit(mat,sizeof mat,materials[i]);path(src,mat,"model.json");size_t pn;char *model=load(src,&pn);if(!pn||model[0]!='{'||model[pn-1]!='}')die("model-json-wire");char *a=stage_start(built.p),*z=object_end(a,built.n-(size_t)(a-built.p));np_buf next={0};np_put(&next,built.p,(size_t)(a-built.p));np_put(&next,model,pn);np_puts(&next,z);free(model);free(built.p);built=next;}cx_sha256_hex(built.p,built.n,newh);
 if(mkdir(out,0700))die("fresh-output-required");path(dst,out,"weights");if(mkdir(dst,0700))die("private-weights-directory");path(dst,out,"kernel");if(mkdir(dst,0700))die("private-kernel-directory");path(src,root,"include");path(dst,out,"include");if(symlink(src,dst))die("private-include-link");path(dst,out,"weights/built.json");save(dst,built.p,built.n);free(built.p);
 /* the native emitter (tools/kernel-emit.cx, byte-equal to the retired python3 -m unisa emit-kernel) over the private built.json */
 char bound[4400],why[1400],com[4400],tool[4400],kdir[4400],bjson[4400];path(bound,root,"tools/bound");path(com,root,"unisacc.com");path(tool,root,"tools/kernel-emit.cx");path(kdir,out,"kernel");path(bjson,out,"weights/built.json");
 char *v[]={bound,"35","sh",com,tool,"--","--write",root,kdir,"--built",bjson,0};char *env[]={0};np_result r;if(np_run(v,root,env,38,&r,why,sizeof why))die(why);if(r.rc||r.errn){if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);die("private-kernel-emitter");}np_free(&r);
 char rel[120];np_buf receipt={0};np_puts(&receipt,"net-built-private-v2\nstatus\tPREPARED\nscope\tprivate-built-json-and-native-emitter-no-live-product-change\nold-built.json\t");np_puts(&receipt,oldh);np_puts(&receipt,"\nprivate-built.json\t");np_puts(&receipt,newh);np_puts(&receipt,"\n");const char *stages[]={"pp","lex","parse","type","scope","irsel","enc","reloc","regmap","tyinfo","pfconv","peep","opinfo","prec","binsel","isel","abi","combo"};int matched=0;for(int s=0;s<18;s++){int chosen=-1;for(int i=0;i<nselected;i++)if(tx_eq(stages[s], selected[i], 1L << 20))chosen=i;if(chosen>=0){matched++;copy_fit(name,sizeof name,selected[chosen]);copy_fit(mat,sizeof mat,materials[chosen]);path(src,mat,"weights.bin");size_t wn;char *w=load(src,&wn);char wh[65];cx_sha256_hex(w,wn,wh);int q=snprintf(rel,sizeof rel,"kernel/weight.%s.inc",name);if(q<0||q>=(int)sizeof rel)die("weight-path");path(src,out,rel);np_buf actual=literal(src);if(actual.n!=wn||memcmp(actual.p,w,wn))die("emitted-net-not-material");free(actual.p);free(w);q=snprintf(rel,sizeof rel,"kernel/dense.%s.inc",name);if(q<0||q>=(int)sizeof rel)die("dense-path");path(src,out,rel);path(dst,root,rel);np_buf dense=literal(src),baseline=literal(dst);if(dense.n!=baseline.n||memcmp(dense.p,baseline.p,dense.n))die("dense-net-changed");char dh[65];cx_sha256_hex(dense.p,dense.n,dh);free(dense.p);free(baseline.p);np_puts(&receipt,"stage\t");np_puts(&receipt,name);np_puts(&receipt,"\t");np_puts(&receipt,wh);np_puts(&receipt,"\t");np_puts(&receipt,dh);np_puts(&receipt,"\n");}else for(int kind=0;kind<2;kind++){int q=snprintf(rel,sizeof rel,"kernel/%s.%s.inc",kind?"dense":"weight",stages[s]);if(q<0||q>=(int)sizeof rel)die("stage-path");path(src,out,rel);path(dst,root,rel);np_buf now=literal(src),was=literal(dst);int same=now.n==was.n&&!memcmp(now.p,was.p,now.n);free(now.p);free(was.p);if(!same)die("unselected-model-bytes-changed");}}if(matched!=nselected)die("classic-stage-required");np_puts(&receipt,"unselected\tweight-and-dense-bytes-unchanged\nemitter\ttools/kernel-emit.cx --write ROOT kernel --built weights/built.json\n");path(dst,out,"receipt.tsv");save(dst,receipt.p,receipt.n);free(receipt.p);printf("PREPARED\tnet-built-private\tstages=%d\tbuilt=%s\tunselected=%d-unchanged\n",nselected,newh,18-nselected);return 0;
}
