/* Construct a private built.json entry from a verified partition material,
 * then run the existing legacy emit-kernel only in that private root.
 * ROOT NAME MATERIAL NEW_ABS_OUT. No live source or kernel file is changed. */
#pragma unisa use cxlib.netpack
static char root[4096],mat[4096],out[4096],name[100];
static void die(const char *s){fprintf(stderr,"net-built-private: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void path(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path-bound");}
static char *load(const char *p,size_t *n){struct stat a,b;errno=0;if(lstat(p,&a))die(errno==ENOENT?"input-absent":"input-stat");if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>16777216)die("bounded-regular-input");int fd=open(p,O_RDONLY|O_CLOEXEC|O_NONBLOCK|O_NOFOLLOW);if(fd<0)die("input-open");if(fstat(fd,&b)||!S_ISREG(b.st_mode)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size){close(fd);die("input-descriptor");}*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s){close(fd);die("allocation");}size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0){close(fd);die("input-extent");}at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int changed=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(z||changed||closed){free(s);die("input-changed-or-close");}s[*n]=0;return s;}
static void save(const char *p,const char *s,size_t n){int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive-output");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0){close(fd);die("output-write");}at+=(size_t)z;}int synced=fsync(fd),closed=close(fd);if(synced||closed)die("output-close");}
static void verify_material(void){char product[4400],bound[4400],tool[4400],why[1400];path(product,root,"unisacc.com");path(bound,root,"tools/bound");path(tool,root,"tools/gold-partition-material.cx");char *v[]={bound,"20","sh",product,tool,"--","--verify",root,name,mat,0};np_result r;if(np_run(v,root,0,23,&r,why,sizeof why))die(why);char want[200];int n=snprintf(want,sizeof want,"VERIFIED\tgold-partition-material\tstage=%s\t",name);int good=!r.rc&&!r.errn&&n>0&&n<(int)sizeof want&&r.outn>(size_t)n&&r.out[r.outn-1]=='\n'&&!memcmp(r.out,want,(size_t)n);if(!good&&r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);if(!good)die("partition-material-current-verification");}
static char *stage_start(char *s){char tag[120];int n=snprintf(tag,sizeof tag,"\"%s\":",name);if(n<0||n>=(int)sizeof tag)die("stage-tag");char *p=strstr(s,tag);if(!p||strstr(p+1,tag)||p[n]!='{')die("unique-stage-json-member");return p+n;}
static char *object_end(char *s,size_t n){int depth=0,string=0,escape=0;for(size_t i=0;i<n;i++){char c=s[i];if(string){if(escape)escape=0;else if(c=='\\')escape=1;else if(c=='\"')string=0;continue;}if(c=='\"'){string=1;continue;}if(c=='{')depth++;else if(c=='}'&&--depth==0)return s+i+1;else if(c=='}'&&depth<0)die("json-object-depth");}die("json-object-end");return 0;}
static int nybble(char c){if(c>='0'&&c<='9')return c-'0';if(c>='a'&&c<='f')return c-'a'+10;return -1;}
static np_buf literal(const char *file){size_t n;char *s=load(file,&n),*p=strstr(s,"*/");if(!p)die("generated-literal-comment");p+=2;np_buf b={0};while(*p){while(*p==' '||*p=='\t'||*p=='\n'||*p=='\r')p++;if(!*p)break;if(*p!='\"')die("generated-literal-quote");p++;while(*p&&*p!='\"'){if(!p[1]||!p[2]||!p[3]||p[0]!='\\'||p[1]!='x'||nybble(p[2])<0||nybble(p[3])<0)die("generated-literal-hex");char c=(char)((nybble(p[2])<<4)|nybble(p[3]));np_put(&b,&c,1);p+=4;}if(*p!='\"')die("generated-literal-close");p++;}free(s);return b;}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN net-built-private requires Linux/x86_64 LP64\n",stderr);return 3;
#endif
 if(argc!=5||sizeof(long)!=8||!realpath(argv[1],root)||strlen(argv[2])>=sizeof name||strpbrk(argv[2],"/\\\r\n\t")||!realpath(argv[3],mat)||argv[4][0]!='/'||strlen(argv[4])>=sizeof out||strpbrk(argv[4],"\r\n\t"))die("usage-ROOT-NAME-MATERIAL-NEW-ABS-OUT");strcpy(name,argv[2]);strcpy(out,argv[4]);verify_material();
 char src[4400],dst[4400],h[65],oldh[65],newh[65];path(src,mat,"weights.bin");size_t wn;char *w=load(src,&wn);cx_sha256_hex(w,wn,h);path(src,mat,"model.json");size_t pn;char *p=load(src,&pn);if(!pn||p[0]!='{'||p[pn-1]!='}')die("model-json-wire");
 path(src,root,"weights/built.json");size_t bn;char *old=load(src,&bn);if(memchr(old,0,bn)||!bn||old[0]!='{'||old[bn-1]!='}')die("built-json-wire");cx_sha256_hex(old,bn,oldh);char *a=stage_start(old),*z=object_end(a,bn-(size_t)(a-old));np_buf built={0};np_put(&built,old,(size_t)(a-old));np_put(&built,p,pn);np_puts(&built,z);free(p);free(old);cx_sha256_hex(built.p,built.n,newh);
 if(mkdir(out,0700))die("fresh-output-required");path(dst,out,"weights");if(mkdir(dst,0700))die("private-weights-directory");path(dst,out,"kernel");if(mkdir(dst,0700))die("private-kernel-directory");path(src,root,"unisa");path(dst,out,"unisa");if(symlink(src,dst))die("private-unisa-link");path(src,root,"include");path(dst,out,"include");if(symlink(src,dst))die("private-include-link");path(dst,out,"weights/built.json");save(dst,built.p,built.n);free(built.p);
 char bound[4400],why[1400];path(bound,root,"tools/bound");char *v[]={bound,"35","python3","-m","unisa","emit-kernel","--out","kernel",0};char *env[]={"PYTHONPATH=",0};np_result r;if(np_run(v,out,env,38,&r,why,sizeof why))die(why);if(r.rc||r.errn){if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);die("legacy-private-emitter");}np_free(&r);
 char rel[120];int q=snprintf(rel,sizeof rel,"kernel/weight.%s.inc",name);if(q<0||q>=(int)sizeof rel)die("weight-path");path(src,out,rel);np_buf actual=literal(src);if(actual.n!=wn||memcmp(actual.p,w,wn))die("emitted-net-not-material");free(actual.p);free(w);q=snprintf(rel,sizeof rel,"kernel/dense.%s.inc",name);if(q<0||q>=(int)sizeof rel)die("dense-path");path(src,out,rel);np_buf dense=literal(src);path(dst,root,rel);np_buf baseline=literal(dst);if(dense.n!=baseline.n||memcmp(dense.p,baseline.p,dense.n))die("dense-net-changed");char dh[65];cx_sha256_hex(dense.p,dense.n,dh);free(dense.p);free(baseline.p);
 const char *stages[]={"pp","lex","parse","type","scope","irsel","enc","reloc","regmap","tyinfo","pfconv","peep","opinfo","prec","binsel","isel","abi","combo"};int matched=0;for(int i=0;i<18;i++){if(!strcmp(stages[i],name)){matched++;continue;}for(int kind=0;kind<2;kind++){q=snprintf(rel,sizeof rel,"kernel/%s.%s.inc",kind?"dense":"weight",stages[i]);if(q<0||q>=(int)sizeof rel)die("stage-path");path(src,out,rel);path(dst,root,rel);np_buf now=literal(src),was=literal(dst);int same=now.n==was.n&&!memcmp(now.p,was.p,now.n);free(now.p);free(was.p);if(!same)die("other-seventeen-model-bytes-changed");}}if(matched!=1)die("classic-stage-required");
 np_buf receipt={0};np_puts(&receipt,"net-built-private-v1\nstatus\tPREPARED\nscope\tprivate-built-json-and-legacy-emitter-no-live-product-change\nstage\t");np_puts(&receipt,name);np_puts(&receipt,"\nweights\t");np_puts(&receipt,h);np_puts(&receipt,"\nold-built.json\t");np_puts(&receipt,oldh);np_puts(&receipt,"\nprivate-built.json\t");np_puts(&receipt,newh);np_puts(&receipt,"\ndense\t");np_puts(&receipt,dh);np_puts(&receipt,"\nother-seventeen\tweight-and-dense-bytes-unchanged\nlegacy-emitter\tpython3 -m unisa emit-kernel --out kernel\n");path(dst,out,"receipt.tsv");save(dst,receipt.p,receipt.n);free(receipt.p);printf("PREPARED\tnet-built-private\tstage=%s\tweights=%s\tbuilt=%s\tdense=%s\tother-stages=17-unchanged\n",name,h,newh,dh);return 0;
}
