/* tools/rel.cx -- relation DAG queries (devsvc candidate T, first version): who uses a file, what a change hits.
 *
 *   sh ./unisacc.com tools/rel.cx -- who-uses FILE [--root DIR] [--tracked LIST] [--timing]
 *   sh ./unisacc.com tools/rel.cx -- impact FILE... [--root DIR] [--closure DUMP] [--batches TABLE] [--timing]
 *
 * who-uses  every tracked .cx (archive/ and symlinks skipped) whose transitive `#pragma unisa use` /
 *           `#include "..."` closure holds FILE:  USES<TAB>path  then  USES_SUMMARY<TAB>file=..<TAB>users=N<TAB>scanned=K.
 *           LIST is the saved output of `git ls-files -s -- '*.cx'` (one "MODE SHA STAGE<TAB>PATH" per line);
 *           default ROOT/out/rel/tracked.txt.  The use extraction here is a minimal one of its own (a use
 *           resolves with cxlib.cxroot cxr_path, an include beside the including file); it is to be replaced
 *           by cxlib.relscan (G1) once that module is in the tree.
 * impact    IMPACT<TAB>batch<TAB>id<TAB>why=FILE<TAB>via=KIND per batch whose closure holds a FILE (strongest via,
 *           first FILE on a tie; why/via take the values of affected's AFFECTED line).  A hit batch whose
 *           platform is not this host's (cxlib.platformscope) prints affected's line instead:
 *           NOT_APPLICABLE<TAB>id<TAB>platform=..<TAB>host_scope=..  Then
 *           IMPACT_SUMMARY<TAB>changed=N<TAB>batches=M<TAB>scanned=K<TAB>not_applicable=A.
 *           DUMP is the saved output of `tools/affected.cx -- --closure-dump` (B/C/D lines); default
 *           ROOT/out/rel/closure.tsv.  TABLE is the batch registry (id in column 1, platform in column 6);
 *           default ROOT/tests/batches.tsv.  A dump batch the registry does not hold is refused: the dump
 *           is then older than the registry.
 * --timing  one REL_TIMING line on stderr (read_ms, scan_ms); it changes no result.
 *
 *   sh ./unisacc.com tools/rel.cx -- path A B [--root DIR]
 *           one shortest use/include chain A -> B: PATH<TAB>step<TAB>file per file then PATH_SUMMARY; NO_PATH rc 1 (G8).
 *
 *   sh ./unisacc.com tools/rel.cx -- who-calls SYM [--root DIR] [--tracked LIST] [--cache DIR] [--timing]
 *           CALL<TAB>path:line per word hit of SYM (git grep -n -w rule) in the who-uses file set, then CALLS_SUMMARY;
 *           per-file identifier index cached by content hash in DIR (default ROOT/.devsvc/relsym, local only),
 *           only changed files rescanned (relation DAG G2 first step; check tools/check-relsym.cx).
 * impact --links PATH   (G6) after the batch rows: IMPACT<TAB>table<TAB>dst<TAB>why=..<TAB>via=NODE and IMPACT<TAB>node<TAB>NODE<TAB>why=..
 *           for every links-v1 derive row whose src pattern matches a changed file, then IMPACT_TABLES_SUMMARY;
 *           default ROOT/build/links.tsv (absent -> links=absent).
 * Not in this version (named, not silently narrowed): definition/call told apart from comment/string hits, --depth.
 * LIST and DUMP are snapshots: beyond the registry cross-check above this tool does not check that they still
 * describe the tree (cxlib.relstore, G2, is to own that).
 * rc 0 rows printed, 1 no rows, 2 usage or I/O error.  No repository path is fixed here.  Check: tools/check-rel.cx. */
#pragma unisa use cxlib.cxroot
#pragma unisa use cxlib.platformscope
#pragma unisa use net.unix
#pragma unisa use net.tcp
#pragma unisa use sys.sha
#pragma unisa use sys.posix
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use text.text

enum { HCAP = 1 << 15, MAXN = 20000, MAXCH = 256, MAXB = 8192 };
typedef struct { char *rel; int *dep; int nd, cd; int *rev; int nr, cr; int parsed, tracked, seen; } RNode;
static RNode nd[MAXN]; static int nn, htab[HCAP];
static char root[4096]; static long rootn;
static int timing;

static void die(const char *s, const char *t) { fprintf(stderr, "rel: %s%s%s\n", s, t ? " " : "", t ? t : ""); exit(2); }
static void usage(void) { die("usage: who-uses FILE [--root DIR] [--tracked LIST] [--timing] | impact FILE... [--root DIR] [--closure DUMP] [--batches TABLE] [--timing]", 0); }
static unsigned long hs(const char *s) { unsigned long h = 1469598103934665603UL; while (*s) { h ^= (unsigned char)*s++; h *= 1099511628211UL; } return h; }
static int node_of(const char *rel) {
    unsigned long h = hs(rel) & (HCAP - 1);
    while (htab[h]) { if (!strcmp(nd[htab[h] - 1].rel, rel)) return htab[h] - 1; h = (h + 1) & (HCAP - 1); }
    if (nn >= MAXN) die("too many files", 0);
    nd[nn].rel = strdup(rel); if (!nd[nn].rel) die("out of memory", 0);
    htab[h] = ++nn; return nn - 1;
}
static void push(int **v, int *n, int *c, int x) {
    if (*n == *c) { *c = *c ? *c * 2 : 8; *v = realloc(*v, (size_t)*c * sizeof(int)); if (!*v) die("out of memory", 0); }
    (*v)[(*n)++] = x;
}
/* absolute spelling -> node of the real file below root; -1 when it is not below root */
static int file_node(const char *abs) {
    char real[8192];
    if (sy_realpath(abs, real, sizeof real) < 0) return -1;
    if (memcmp(real, root, (size_t)rootn) || real[rootn] != '/') return -1;
    return node_of(real + rootn + 1);
}
static int isname(int c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '.'; }
static int at(const char *s, size_t p, size_t e, const char *w) { size_t n = strlen(w); return e - p > n && !memcmp(s + p, w, n); }
static void parse(int ni) {
    char abs[8192], out[8192]; size_t sz, i = 0; char *s; int d;
    nd[ni].parsed = 1;
    if (cx_fmt(abs, sizeof abs, "%s/%s", root, nd[ni].rel)) die("path too long", nd[ni].rel);
    s = cx_read(abs, &sz); if (!s) return;
    while (i < sz) {
        size_t e = i, b; while (e < sz && s[e] != '\n') e++;
        b = i; while (b < e && (s[b] == ' ' || s[b] == '\t')) b++;
        if (b < e && s[b] == '#') {
            size_t p = b + 1, q; int isuse = 0, isinc = 0;
            while (p < e && (s[p] == ' ' || s[p] == '\t')) p++;
            if (at(s, p, e, "pragma")) {
                p += 6; while (p < e && (s[p] == ' ' || s[p] == '\t')) p++;
                if (at(s, p, e, "unisa")) {
                    p += 5; while (p < e && (s[p] == ' ' || s[p] == '\t')) p++;
                    if (at(s, p, e, "use") && (s[p + 3] == ' ' || s[p + 3] == '\t')) { p += 3; isuse = 1; }
                }
            } else if (at(s, p, e, "include")) { p += 7; isinc = 1; }
            while (p < e && (s[p] == ' ' || s[p] == '\t')) p++;
            if (isuse) {
                q = p; while (q < e && isname((unsigned char)s[q])) q++;
                if (q > p && cxr_path(abs, s + p, (long)(q - p), out, (long)sizeof out) == 0 && (d = file_node(out)) >= 0) push(&nd[ni].dep, &nd[ni].nd, &nd[ni].cd, d);
            } else if (isinc && p < e && s[p] == '"') {
                long dl = (long)strlen(abs); q = ++p; while (q < e && s[q] != '"') q++;
                while (dl > 0 && abs[dl - 1] != '/') dl--;
                if (q < e && q > p && dl + (long)(q - p) + 1 < (long)sizeof out) {
                    if (mm_copy(out, (long)sizeof out, abs, dl) || mm_copy(out + dl, (long)sizeof out - dl, s + p, (long)(q - p))) die("path too long", nd[ni].rel); out[dl + (long)(q - p)] = 0;
                    if (sy_exists(out) == 1 && (d = file_node(out)) >= 0) push(&nd[ni].dep, &nd[ni].nd, &nd[ni].cd, d);
                }
            }
        }
        i = e + 1;
    }
    free(s);
}

static int who_uses(const char *file, const char *list) {
    char abs[8192]; size_t sz, i = 0; char *s; int target, k, found = 0, scanned = 0, *order = 0, no = 0, co = 0, *q = 0, nq = 0, cq = 0, h;
    long t0 = sy_now_ms(), t1;
    if (file[0] == '/') { if (cx_fmt(abs, sizeof abs, "%s", file)) die("path too long", 0); }
    else if (cx_fmt(abs, sizeof abs, "%s/%s", root, file)) die("path too long", 0);
    if (sy_exists(abs) != 1) die("who-uses: no file", file);
    if ((target = file_node(abs)) < 0) die("who-uses: not below root:", file);
    s = cx_read(list, &sz); if (!s) die("cannot read tracked list (git ls-files -s -- '*.cx' > LIST):", list);
    while (i < sz) {
        size_t e = i, t; while (e < sz && s[e] != '\n') e++;
        t = i; while (t < e && s[t] != '\t') t++;
        if (t < e && e - t > 1 && !(t - i >= 6 && !memcmp(s + i, "120000", 6)) && !(e - t - 1 >= 8 && !memcmp(s + t + 1, "archive/", 8))) {
            char rel[4096]; int ni;
            if (e - t - 1 >= sizeof rel) die("path too long in", list);
            if (mm_copy(rel, (long)sizeof rel, s + t + 1, (long)(e - t - 1))) die("path too long in", list); rel[e - t - 1] = 0;
            if (cx_fmt(abs, sizeof abs, "%s/%s", root, rel)) die("path too long", rel);
            ni = file_node(abs); if (ni < 0) ni = node_of(rel);
            nd[ni].tracked = 1; push(&order, &no, &co, ni); push(&order, &no, &co, node_of(rel)); scanned++;
        }
        i = e + 1;
    }
    t1 = sy_now_ms();
    for (k = 0; k < nn; k++) {   /* nn grows while new files are discovered */
        int j; if (!nd[k].parsed) parse(k);
        for (j = 0; j < nd[k].nd; j++) push(&nd[nd[k].dep[j]].rev, &nd[nd[k].dep[j]].nr, &nd[nd[k].dep[j]].cr, k);
    }
    nd[target].seen = 1; push(&q, &nq, &cq, target);
    for (h = 0; h < nq; h++) { int j, x = q[h]; for (j = 0; j < nd[x].nr; j++) if (!nd[nd[x].rev[j]].seen) { nd[nd[x].rev[j]].seen = 1; push(&q, &nq, &cq, nd[x].rev[j]); } }
    for (k = 0; k < no; k += 2) if (order[k] != target && nd[order[k]].seen) { printf("USES\t%s\n", nd[order[k + 1]].rel); found++; }
    printf("USES_SUMMARY\tfile=%s\tusers=%d\tscanned=%d\n", nd[target].rel, found, scanned);
    if (timing) fprintf(stderr, "REL_TIMING\tread_ms=%ld\tscan_ms=%ld\n", t1 - t0, sy_now_ms() - t1);
    return found ? 0 : 1;
}

static const char *via_name[] = {"-", "source", "use", "literal", "literal-use", "arg", "arg-use", "guard", "table"};
static size_t via_len[9];
static int via_of(const char *s, size_t n) { int v; size_t j; if (!via_len[1]) for (v = 1; v < 9; v++) via_len[v] = strlen(via_name[v]); for (v = 1; v < 9; v++) if (via_len[v] == n) { for (j = 0; j < n && via_name[v][j] == s[j]; j++) {} if (j == n) return v; } return 0; }

/* the registry: id (column 1) and platform (column 6) of every row */
static const char *bt_id[MAXB], *bt_pf[MAXB]; static size_t bt_idn[MAXB], bt_pfn[MAXB]; static int bt_n, bt_h[HCAP];
static unsigned long hsn(const char *s, size_t n) { unsigned long h = 1469598103934665603UL; while (n--) { h ^= (unsigned char)*s++; h *= 1099511628211UL; } return h; }
static int bt_find(const char *id, size_t n, int add) {
    unsigned long h = hsn(id, n) & (HCAP - 1);
    while (bt_h[h]) { int k = bt_h[h] - 1; if (bt_idn[k] == n && !memcmp(bt_id[k], id, n)) return k; h = (h + 1) & (HCAP - 1); }
    if (!add) return -1;
    if (bt_n >= MAXB) die("too many registry rows", 0);
    bt_id[bt_n] = id; bt_idn[bt_n] = n; bt_h[h] = ++bt_n; return bt_n - 1;
}
static void bt_load(const char *path) {
    size_t sz, i = 0; char *s = cx_read(path, &sz); long line = 0;
    if (!s) die("cannot read batch registry:", path);
    while (i < sz) {
        size_t e = i, f[7]; int nf = 0, k; while (e < sz && s[e] != '\n') e++;
        line++;
        if (e > i && s[i] != '#') {
            size_t p = i; f[nf++] = i;
            for (; p < e && nf < 7; p++) if (s[p] == '\t') f[nf++] = p + 1;
            if (nf < 7) { char w[64]; cx_fmt(w, sizeof w, "line %ld", line); die("batch registry row without a platform column:", w); }
            if (!(line == 1 && f[1] - 1 - f[0] == 2 && !memcmp(s + i, "id", 2))) {
                k = bt_find(s + f[0], f[1] - 1 - f[0], 1);
                bt_pf[k] = s + f[5]; bt_pfn[k] = f[6] - 1 - f[5];
            }
        }
        i = e + 1;
    }
}

/* G6: tables and flow nodes.  Every `derive` row of the links table (build/links.tsv, links v1: kind src dst via
 * attr) whose src pattern matches a changed file ('*' matches any run of characters, '/' included) names a table
 * the change regenerates (dst) and the flow node that does it (via, the exec/facts/derive.tsv generator).
 *   IMPACT<TAB>table<TAB>dst<TAB>why=FILE<TAB>via=NODE   once per dst, links order, first FILE on a tie
 *   IMPACT<TAB>node<TAB>NODE<TAB>why=FILE                once per node
 *   IMPACT_TABLES_SUMMARY<TAB>tables=T<TAB>nodes=N<TAB>links=PATH|absent
 * An explicit --links that cannot be read is refused; the default one absent (a root without build/) is named
 * links=absent, not silently an empty result. */
static const char *links_arg; static char links_def[8192];
static int glob_m(const char *p, size_t pn, const char *s, size_t sn) {
    size_t i = 0, j = 0, star = (size_t)-1, mark = 0;
    while (j < sn) {
        if (i < pn && p[i] == '*') { star = i++; mark = j; }
        else if (i < pn && p[i] == s[j]) { i++; j++; }
        else if (star != (size_t)-1) { i = star + 1; j = ++mark; }
        else return 0;
    }
    while (i < pn && p[i] == '*') i++;
    return i == pn;
}
static int impact_tables(const char **ch, const size_t *cl, int nf) {
    const char *lp = links_arg ? links_arg : links_def; size_t sz, i = 0; char *s = cx_read(lp, &sz);
    char tb[256][512], nb[256][128]; int nt = 0, nn2 = 0, k;
    if (!s) { if (links_arg) die("cannot read links table:", lp); printf("IMPACT_TABLES_SUMMARY\ttables=0\tnodes=0\tlinks=absent\n"); return 0; }
    while (i < sz) {
        size_t e = i, f[6]; int n = 0; while (e < sz && s[e] != '\n') e++;
        if (e - i > 7 && !memcmp(s + i, "derive\t", 7)) {
            size_t p; f[n++] = i;
            for (p = i; p < e && n < 6; p++) if (s[p] == '\t') f[n++] = p + 1;
            if (n < 5) die("malformed links row in", lp);
            for (k = 0; k < nf; k++) if (glob_m(s + f[1], f[2] - 1 - f[1], ch[k], cl[k])) break;
            if (k < nf) {   /* copied out first: printf %.*s on a pointer into a large buffer scans past the precision */
                char dst[512], via[128]; size_t dn = f[3] - 1 - f[2], vn = f[4] - 1 - f[3]; int j;
                if (dn >= sizeof dst || vn >= sizeof via || mm_copy(dst, (long)sizeof dst, s + f[2], (long)dn) || mm_copy(via, (long)sizeof via, s + f[3], (long)vn)) die("links field too long in", lp);
                dst[dn] = 0; via[vn] = 0;
                for (j = 0; j < nt && strcmp(tb[j], dst); j++) {}
                if (j == nt) { if (nt >= 256) die("too many table hits", 0); cx_fmt(tb[nt++], 512, "%s", dst); printf("IMPACT\ttable\t%s\twhy=%s\tvia=%s\n", dst, ch[k], via); }
                for (j = 0; j < nn2 && strcmp(nb[j], via); j++) {}
                if (j == nn2) { if (nn2 >= 256) die("too many node hits", 0); cx_fmt(nb[nn2++], 128, "%s", via); printf("IMPACT\tnode\t%s\twhy=%s\n", via, ch[k]); }
            }
        }
        i = e + 1;
    }
    printf("IMPACT_TABLES_SUMMARY\ttables=%d\tnodes=%d\tlinks=%s\n", nt, nn2, lp);
    free(s);
    return nt + nn2;
}

static int tier_rank(const char *s, size_t n) { return n == 6 && !memcmp(s, "commit", 6) ? 1 : n == 5 && !memcmp(s, "daily", 5) ? 2 : n == 7 && !memcmp(s, "release", 7) ? 3 : 0; }
/* tier: 0 = every batch (affected without --tier); else only batches whose registry tier ranks at most it
 * (cxlib.testplan tp_tier_includes rule: commit < daily < release, an unknown tier never included). */
static int impact(char **files, int nf, const char *dump, const char *table, int tier) {
    char abs[8192], pf[64], idz[512]; const char *ch[MAXCH]; size_t cl[MAXCH], sz, i = 0; char *s; int k, nb = 0, hit = 0, nna = 0, bv = 0, bw = -1, bskip = 0; const char *bid = 0; size_t bn = 0;
    long t0 = sy_now_ms(), t1;
    if (nf > MAXCH) die("too many files", 0);
    for (k = 0; k < nf; k++) {   /* a file that no longer exists still matches by its spelling */
        int ni = -1; const char *f = files[k];
        if (f[0] == '/') { if (cx_fmt(abs, sizeof abs, "%s", f)) die("path too long", 0); }
        else if (cx_fmt(abs, sizeof abs, "%s/%s", root, f)) die("path too long", 0);
        if (sy_exists(abs) == 1) ni = file_node(abs);
        if (ni >= 0) ch[k] = nd[ni].rel;
        else ch[k] = (f[0] == '/' && strlen(f) > (size_t)rootn && !memcmp(f, root, (size_t)rootn) && f[rootn] == '/') ? f + rootn + 1 : f;
        cl[k] = strlen(ch[k]);
    }
    bt_load(table);
    s = cx_read(dump, &sz); if (!s) die("cannot read closure dump (tools/affected.cx -- --closure-dump > DUMP):", dump);
    t1 = sy_now_ms();
    for (;;) {
        size_t e = i, f1, f2, f3; int end = i >= sz;
        if (!end) { while (e < sz && s[e] != '\n') e++; }
        if (end || (e - i > 2 && s[i] == 'B' && s[i + 1] == '\t')) {   /* a new batch (or the end) closes the previous one */
            if (bid && bv && !bskip) {
                int r = bt_find(bid, bn, 0);
                if (bt_pfn[r] >= sizeof pf) die("platform too long in", table);
                if (bn >= sizeof idz) die("batch id too long in", dump);
                if (mm_copy(idz, (long)sizeof idz, bid, (long)bn)) die("batch id too long in", dump); idz[bn] = 0;   /* printf %.*s on a pointer into the 9 MB dump scans far past the precision (measured: 20 s for 1014 rows) */
                (void)0;
                if (mm_copy(pf, (long)sizeof pf, bt_pf[r], (long)bt_pfn[r])) die("platform too long in", table); pf[bt_pfn[r]] = 0;
                if (psc_platform_allowed(pf)) { printf("IMPACT\tbatch\t%s\twhy=%s\tvia=%s\n", idz, ch[bw], via_name[bv]); hit++; }
                else { printf("NOT_APPLICABLE\t%s\tplatform=%s\thost_scope=%s\n", idz, pf, psc_host_scope()); nna++; }
            }
            if (end) break;
            f1 = i + 2; f2 = f1; while (f2 < e && s[f2] != '\t') f2++;
            bid = s + f1; bn = f2 - f1; bv = 0; bw = -1; nb++; bskip = 0;
            if (tier) { size_t t1 = f2 + 1, t2 = t1; int r; while (t2 < e && s[t2] != '\t') t2++; r = t1 < e ? tier_rank(s + t1, t2 - t1) : 0; bskip = !r || r > tier; }
            if (bt_find(bid, bn, 0) < 0) { char w[300]; cx_fmt(w, sizeof w, "%.*s", bn > 200 ? 200 : (int)bn, bid); die("closure dump names a batch the registry does not hold (dump is stale):", w); }
        } else if (e - i > 2 && (s[i] == 'C' || s[i] == 'D') && s[i + 1] == '\t') {
            int v; size_t pn; f1 = i + 2; while (f1 < e && s[f1] != '\t') f1++;
            f2 = f1 + 1; while (f2 < e && s[f2] != '\t') f2++;
            if (f2 >= e || !bid) die("malformed closure dump line in", dump);
            f3 = f2 + 1; pn = e - f3;
            for (k = 0; k < nf; k++) {
                int m = s[i] == 'C' ? (cl[k] == pn && !memcmp(ch[k], s + f3, pn))
                                    : (cl[k] > pn && ch[k][pn] == '/' && !memcmp(ch[k], s + f3, pn));
                if (!m) continue;
                v = via_of(s + f1 + 1, f2 - f1 - 1); if (!v) die("unknown via in", dump);
                if (!bv || v < bv || (v == bv && k < bw)) { bv = v; bw = k; }
            }
            if (!nf || (pn && !via_of(s + f1 + 1, f2 - f1 - 1))) die("unknown via in", dump);
        }
        i = e + 1;
    }
    printf("IMPACT_SUMMARY\tchanged=%d\tbatches=%d\tscanned=%d\tnot_applicable=%d\n", nf, hit, nb, nna);
    if (timing) fprintf(stderr, "REL_TIMING\tread_ms=%ld\tscan_ms=%ld\n", t1 - t0, sy_now_ms() - t1);
    hit += impact_tables(ch, cl, nf);
    return hit || nna ? 0 : 1;
}

/* who-calls SYM: symbol-grain sites (G2 first step).  Every tracked .cx (same set as who-uses) is read, hashed
 * (FNV-1a 64 of its working-tree bytes) and its identifier index -- one "IDENT<TAB>LINE" per distinct (ident,line),
 * idents being maximal [A-Za-z0-9_] runs, the git grep -w word rule -- is kept in CACHE/<hash>.idx (local, not
 * tracked).  Only files whose content hash has no index are rescanned.  Comments and strings are not told apart
 * from code: a site is a textual word hit, the set `git grep -n -w -F SYM` gives on the same files. */
static unsigned long long fnv(const char *s, size_t n) { unsigned long long h = 1469598103934665603ULL; size_t i; for (i = 0; i < n; i++) { h ^= (unsigned char)s[i]; h *= 1099511628211ULL; } return h; }
static int wch(int c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'; }
static int idx_build(const char *s, size_t n, const char *out) {
    size_t cap = n * 2 + 64, z = 0, i = 0, li = 0; long line = 1; char *b = malloc(cap); int r;
    if (!b) return -1;
    while (i < n) {
        size_t a, q; int dup = 0;
        if (s[i] == '\n') { line++; li = z; i++; continue; }
        if (!wch((unsigned char)s[i])) { i++; continue; }
        a = i; while (i < n && wch((unsigned char)s[i])) i++;
        q = li; while (q < z) { size_t e = q; while (b[e] != '\n') e++;   /* same ident already on this line */
            if (e - q > i - a && b[q + (i - a)] == '\t' && !memcmp(b + q, s + a, i - a)) { dup = 1; break; } q = e + 1; }
        if (dup) continue;
        if (z + (i - a) + 32 > cap) { cap = cap * 2 + (i - a) + 64; b = realloc(b, cap); if (!b) return -1; }
        if (mm_copy(b + z, (long)(cap - z), s + a, (long)(i - a))) { free(b); return -1; } z += i - a;
        if (cx_fmt(b + z, (long)(cap - z), "\t%ld\n", line)) { free(b); return -1; } z += strlen(b + z);
    }
    r = cx_write(out, b, z); free(b); return r;
}
static int who_calls(const char *sym, const char *list, const char *cache) {
    size_t sz, i, sl = strlen(sym); char *s; int found = 0, scanned = 0, rescanned = 0;
    long t0 = sy_now_ms();
    if (!sl || sl > 255) die("who-calls: bad symbol", sym);
    for (i = 0; i < sl; i++) if (!wch((unsigned char)sym[i])) die("who-calls: symbol is not one word:", sym);
    if (sy_mkdir_all(cache, 0755) < 0) die("who-calls: cannot create cache", cache);
    s = cx_read(list, &sz); if (!s) die("cannot read tracked list (git ls-files -s -- '*.cx' > LIST):", list);
    i = 0;
    while (i < sz) {
        size_t e = i, t; while (e < sz && s[e] != '\n') e++;
        t = i; while (t < e && s[t] != '\t') t++;
        if (t < e && e - t > 1 && !(t - i >= 6 && !memcmp(s + i, "120000", 6)) && !(e - t - 1 >= 8 && !memcmp(s + t + 1, "archive/", 8))) {
            char rel[4096], abs[8192], ip[8192], ln[64]; size_t fn, xn, p = 0; char *f, *x;
            if (e - t - 1 >= sizeof rel) die("path too long in", list);
            if (mm_copy(rel, (long)sizeof rel, s + t + 1, (long)(e - t - 1))) die("path too long in", list); rel[e - t - 1] = 0;
            if (cx_fmt(abs, sizeof abs, "%s/%s", root, rel)) die("path too long", rel);
            f = cx_read(abs, &fn);
            if (f) {
                scanned++;
                if (cx_fmt(ip, sizeof ip, "%s/%016llx.idx", cache, fnv(f, fn))) die("path too long", cache);
                if (sy_exists(ip) != 1) { if (idx_build(f, fn, ip)) die("who-calls: cannot write index", ip); rescanned++; }
                free(f);
                x = cx_read(ip, &xn); if (!x) die("who-calls: cannot read index", ip);
                while (p < xn) { size_t q = p; while (q < xn && x[q] != '\n') q++;
                    if (q - p > sl && q - p - sl - 1 < sizeof ln && x[p + sl] == '\t' && !memcmp(x + p, sym, sl)) {
                        if (mm_copy(ln, (long)sizeof ln, x + p + sl + 1, (long)(q - p - sl - 1))) die("who-calls: bad index row", ip); ln[q - p - sl - 1] = 0; printf("CALL\t%s:%s\n", rel, ln); found++; }
                    p = q + 1; }
                free(x);
            }
        }
        i = e + 1;
    }
    printf("CALLS_SUMMARY\tsym=%s\tsites=%d\tscanned=%d\trescanned=%d\n", sym, found, scanned, rescanned);
    if (timing) fprintf(stderr, "REL_TIMING\ttotal_ms=%ld\trescanned=%d\n", sy_now_ms() - t0, rescanned);
    return found ? 0 : 1;
}

/* path A B: one shortest use/include chain from A to B (G8).  Breadth first from A over the edges parse()
 * finds, files parsed as they are reached (no tracked list needed); the first parent found wins, edges taken in
 * file order, so the answer is deterministic.  PATH<TAB>step<TAB>file per file, A first, B last, then
 * PATH_SUMMARY<TAB>from=A<TAB>to=B<TAB>hops=H.  Unreachable: NO_PATH<TAB>from=A<TAB>to=B, rc 1. */
static int path_of(const char *a, const char *b) {
    char abs[8192]; int na, nb, *q = 0, nq = 0, cq = 0, h, *par, k, *chain, nc = 0;
    if ((a[0] == '/' ? cx_fmt(abs, sizeof abs, "%s", a) : cx_fmt(abs, sizeof abs, "%s/%s", root, a))) die("path too long", 0);
    if (sy_exists(abs) != 1) die("path: no file", a);
    if ((na = file_node(abs)) < 0) die("path: not below root:", a);
    if ((b[0] == '/' ? cx_fmt(abs, sizeof abs, "%s", b) : cx_fmt(abs, sizeof abs, "%s/%s", root, b))) die("path too long", 0);
    if (sy_exists(abs) != 1) die("path: no file", b);
    if ((nb = file_node(abs)) < 0) die("path: not below root:", b);
    par = malloc(sizeof(int) * MAXN); chain = malloc(sizeof(int) * MAXN); if (!par || !chain) die("out of memory", 0);
    for (k = 0; k < MAXN; k++) par[k] = -1;
    nd[na].seen = 1; push(&q, &nq, &cq, na);
    for (h = 0; h < nq && !nd[nb].seen; h++) {
        int j, x = q[h]; if (!nd[x].parsed) parse(x);
        for (j = 0; j < nd[x].nd; j++) { int y = nd[x].dep[j]; if (!nd[y].seen) { nd[y].seen = 1; par[y] = x; push(&q, &nq, &cq, y); } }
    }
    if (!nd[nb].seen) { printf("NO_PATH\tfrom=%s\tto=%s\n", nd[na].rel, nd[nb].rel); return 1; }
    for (k = nb; k >= 0; k = par[k]) chain[nc++] = k;
    for (k = nc - 1; k >= 0; k--) printf("PATH\t%d\t%s\n", nc - 1 - k, nd[chain[k]].rel);
    printf("PATH_SUMMARY\tfrom=%s\tto=%s\thops=%d\n", nd[na].rel, nd[nb].rel, nc - 1);
    return 0;
}

/* default inputs live in ROOT/.devsvc/rel (ignored, local only) and are generated there when missing:
 * tracked.txt from `git ls-files -s -- '*.cx'`, closure[-TIER].tsv from `tools/affected.cx -- --closure-dump
 * [--tier TIER]`.  A present file is used as is (a snapshot; delete it to refresh). */
static void ensure_default(char *out, size_t cap, const char *name, const char *cmd) {
    char dir[8192], full[12000]; char *o = 0; size_t on = 0;
    const char *env = sy_env("UNISACC_DEVMETA_DIR");
    if ((env && *env ? cx_fmt(dir, sizeof dir, "%s/rel", env) : cx_fmt(dir, sizeof dir, "%s/.devsvc/rel", root)) || cx_fmt(out, (long)cap, "%s/%s", dir, name)) die("path too long", 0);
    if (sy_exists(out) == 1) return;
    if (sy_mkdir_all(dir, 0755) < 0) die("cannot create", dir);
    /* redirected to a file, not captured: the full dump is about 9 MB */
    if (cx_fmt(full, sizeof full, "cd '%s' && %s > '%s.part' 2> '%s.err' && mv '%s.part' '%s'", root, cmd, out, out, out, out)) die("path too long", 0);
    if (cx_run_timeout(full, 55, &o, &on) || sy_exists(out) != 1) { free(o); fprintf(stderr, "rel: generator stderr kept in %s.err\n", out); die("cannot generate default input:", cmd); }
    free(o);
}

static int svc_sock(char *sock, size_t cap) {
    const char *env = getenv("UNISACC_DEVSVC_DIR"), *home = getenv("HOME"), *nosvc = getenv("UNISACC_REL_NOSVC");
    char gp[8192], real[8192], cmd[8400], hex[65]; char *o = 0; size_t on = 0;
    if (nosvc && !strcmp(nosvc, "1")) return -1;
    if (env && *env) return cx_fmt(sock, cap, "%s/sock", env) ? -1 : (sy_exists(sock) == 1 ? 0 : -1);
    if (!home || !*home) return -1;
    if (cx_fmt(gp, sizeof gp, "%s/.git", root)) return -1;
    if (sy_exists(gp) != 1) return -1;
    {   sy_stat_t st;
        if (sy_stat(gp, &st) == 0 && st.kind == 'd' && sy_realpath(gp, real, (int)sizeof real) >= 0) {
            if (sy_sha256_hex(real, (long)strlen(real), hex)) return -1;
            hex[16] = 0;
            if (cx_fmt(sock, cap, "%s/.cache/unisacc/devsvc/%s/sock", home, hex)) return -1;
            return sy_exists(sock) == 1 ? 0 : -1;
        }
    }
    if (cx_fmt(cmd, sizeof cmd, "git -C '%s' rev-parse --path-format=absolute --git-common-dir 2>/dev/null", root)) return -1;
    if (cx_run_timeout(cmd, 5, &o, &on) != 0 || !o || on == 0) { free(o); return -1; }
    while (on > 0 && (o[on - 1] == '\n' || o[on - 1] == '\r')) o[--on] = 0;
    if (on == 0 || sy_sha256_hex(o, (long)on, hex)) { free(o); return -1; }
    free(o);
    hex[16] = 0;
    if (cx_fmt(sock, cap, "%s/.cache/unisacc/devsvc/%s/sock", home, hex)) return -1;
    return sy_exists(sock) == 1 ? 0 : -1;
}

static long svc_hdr_num(const char *hdr, long hl, const char *key) {
    long kl = (long)strlen(key), p = tx_find(hdr, hl, key, kl);
    return p >= 0 ? atol(hdr + p + kl) : -1;
}

/* Query resident devsvc relation graph; returns 0/1 when answered by service, -1 to fall back locally. */
static int try_svc(const char *req) {
    char sock[8192], chunk[16384]; int fd; sy_deadline_t d;
    char *buf = 0; size_t cap = 0, n = 0; long r;
    if (svc_sock(sock, sizeof sock) != 0) return -1;
    fd = sy_unix_connect(sock, sy_deadline_in(300));
    if (fd < 0) return -1;
    d = sy_deadline_in(30000);
    if (sy_send_all_until(fd, req, (long)strlen(req), d) || sy_send_all_until(fd, "\n", 1, d)) { sy_close(fd); return -1; }
    while ((r = sy_recv_until(fd, chunk, sizeof chunk, d)) > 0) {
        if (n + (size_t)r + 1 > cap) {
            size_t nc = cap ? cap * 2 : 32768; char *nb;
            while (nc < n + (size_t)r + 1) nc *= 2;
            nb = realloc(buf, nc);
            if (!nb) { free(buf); sy_close(fd); return -1; }
            buf = nb; cap = nc;
        }
        if (mm_copy(buf + n, (long)(cap - n), chunk, r)) { free(buf); sy_close(fd); return -1; }
        n += (size_t)r; buf[n] = 0;
    }
    sy_close(fd);
    if (!buf || n < 7 || memcmp(buf, "OK\trel\t", 7)) { free(buf); return -1; }
    {   long nl = tx_chr(buf, (long)n, '\n'), hl = nl >= 0 ? nl : (long)n;
        long rc = svc_hdr_num(buf, hl, "\trc="), rms = svc_hdr_num(buf, hl, "\tread_ms="), sms = svc_hdr_num(buf, hl, "\tscan_ms=");
        if (rc != 0 && rc != 1) { free(buf); return -1; }
        if (nl >= 0 && (size_t)(nl + 1) < n) { size_t wn = fwrite(buf + nl + 1, 1, n - (size_t)(nl + 1), stdout); (void)wn; }
        if (timing) fprintf(stderr, "REL_TIMING\tread_ms=%ld\tscan_ms=%ld\n", rms, sms);
        free(buf);
        return (int)rc;
    }
}

int main(int argc, char **argv) {
    const char *rootarg = ".", *tracked = 0, *closure = 0, *table = 0, *cache = 0, *tiers = 0; char *files[MAXCH], def[8192], def2[8192], cmd[256], nm[64]; int nf = 0, a, tier = 0;
    if (argc < 3) usage();
    for (a = 2; a < argc; a++) {
        if (!strcmp(argv[a], "--root") && a + 1 < argc) rootarg = argv[++a];
        else if (!strcmp(argv[a], "--tracked") && a + 1 < argc) tracked = argv[++a];
        else if (!strcmp(argv[a], "--closure") && a + 1 < argc) closure = argv[++a];
        else if (!strcmp(argv[a], "--batches") && a + 1 < argc) table = argv[++a];
        else if (!strcmp(argv[a], "--cache") && a + 1 < argc) cache = argv[++a];
        else if (!strcmp(argv[a], "--links") && a + 1 < argc) links_arg = argv[++a];
        else if (!strcmp(argv[a], "--timing")) timing = 1;
        else if (!strcmp(argv[a], "--tier") && a + 1 < argc) { tiers = argv[++a]; if (!(tier = tier_rank(tiers, strlen(tiers)))) usage(); }
        else if (argv[a][0] == '-' && argv[a][1] == '-') usage();
        else if (nf < MAXCH) files[nf++] = argv[a];
        else die("too many files", 0);
    }
    if (!nf) usage();
    if (sy_realpath(rootarg, root, sizeof root) < 0) die("no root", rootarg);
    rootn = (long)strlen(root);
    if (!strcmp(argv[1], "who-uses")) {
        int def_tr = !tracked;
        if (nf != 1 || closure || table || tier) usage();
        if (!tracked) { ensure_default(def, sizeof def, "tracked.txt", "git ls-files -s -- '*.cx'"); tracked = def; }
        if (def_tr) {
            char req[16384];
            if (!cx_fmt(req, sizeof req, "rel-who-uses\t%s\t%s\t%s\t%d", root, tracked, files[0], timing)) {
                int sr = try_svc(req);
                if (sr >= 0) return sr;
            }
        }
        return who_uses(files[0], tracked);
    }
    if (!strcmp(argv[1], "path")) {
        if (nf != 2 || tracked || closure || table || tier || cache) usage();
        return path_of(files[0], files[1]);
    }
    if (!strcmp(argv[1], "who-calls")) {
        if (nf != 1 || closure || table || tier) usage();
        if (!tracked) { ensure_default(def, sizeof def, "tracked.txt", "git ls-files -s -- '*.cx'"); tracked = def; }
        if (!cache) { if (cx_fmt(def2, sizeof def2, "%s/.devsvc/relsym", root)) die("path too long", 0); cache = def2; }
        return who_calls(files[0], tracked, cache);
    }
    if (!strcmp(argv[1], "impact")) {
        int def_im = !closure && !table && !links_arg;
        if (tracked) usage();
        if (!closure) {   /* the commit tier's dump has its own (one literal hop) closure, so its own file */
            if (cx_fmt(nm, sizeof nm, tier ? "closure-%s.tsv" : "closure.tsv", tiers) || cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com tools/affected.cx -- --closure-dump%s%s", tier ? " --tier " : "", tier ? tiers : "")) die("path too long", 0);
            ensure_default(def, sizeof def, nm, cmd); closure = def;
        }
        if (!table) { if (cx_fmt(def2, sizeof def2, "%s/tests/batches.tsv", root)) die("path too long", 0); table = def2; }
        if (cx_fmt(links_def, sizeof links_def, "%s/build/links.tsv", root)) die("path too long", 0);
        if (def_im) {
            char req[16384]; long rk = 0; int okr = 1;
            if (cx_fmt(req, sizeof req, "rel-impact\t%s\t%d\t%s\t%s\t%s\t0\t%d", root, tier, closure, table, links_def, timing)) okr = 0;
            else rk = (long)strlen(req);
            for (a = 0; okr && a < nf; a++) {
                if (cx_fmt(req + rk, sizeof req - (size_t)rk, "\t%s", files[a])) okr = 0;
                else rk += (long)strlen(req + rk);
            }
            if (okr) {
                int sr = try_svc(req);
                if (sr >= 0) return sr;
            }
        }
        return impact(files, nf, closure, table, tier);
    }
    usage();
    return 2;
}
