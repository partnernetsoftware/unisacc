/* tools/check-nn-external.cx -- external-first nn loader CLI, L0 self-path/regular guards, beside bypass, formal-chain builtin. */
#pragma unisa use driver.cli
#pragma unisa use driver.nnext
#pragma unisa use driver.runsplit
#pragma unisa use text.text
#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use sys.posix
#pragma unisa use mem.bytes
#pragma unisa use runtime.packagefooter
#pragma unisa use runtime.package_decode
#pragma unisa use runtime.package_lifetime
#pragma unisa use runtime.model_number
#pragma unisa use compiler.bindstage
#pragma unisa use runtime.routestep
#pragma unisa use cxlib.codec
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.ckassert

static int g_fail;
static int g_unmeasured;

static void ck_nn(int ok, const char *name) {
    ck(ok, name);
    if (!ok) g_fail = g_fail + 1;
}

static void check_ape_owner_policy(void) {
    sy_stat_t st = {0};
    st.uid = 2102;
    st.mode = 0700;
    ck_nn(!sy_stat_trusted_owner(&st, 2101), "ape-owner-policy-foreign-refused");
    ck_nn(sy_stat_trusted_owner(&st, 2102), "ape-owner-policy-euid-allowed");
    st.uid = 0;
    ck_nn(sy_stat_trusted_owner(&st, 2101), "ape-owner-policy-root-allowed");
    st.mode = 0770;
    ck_nn(!sy_stat_trusted_owner(&st, 2101), "ape-owner-policy-writable-root-refused");
}

static void *pk_alloc_fn(void *p, size_t n) { return realloc(p, n ? n : 1); }
static void pk_free_fn(void *p) { free(p); }

static int has_bytes(const char *hay, size_t hn, const char *ndl) {
    long nl = tx_len(ndl, 512);
    if (!hay || nl <= 0 || hn < (size_t)nl) return 0;
    for (size_t i = 0; i + (size_t)nl <= hn; i++) {
        long j = 0;
        while (j < nl && hay[i + (size_t)j] == ndl[j]) j++;
        if (j == nl) return 1;
    }
    return 0;
}

static int run_sh(const char *cwd, const char *cmd, int secs, np_result *r) {
    char *av[4]; char why[200];
    av[0] = "sh"; av[1] = "-c"; av[2] = (char *)cmd; av[3] = 0;
    mm_fill(r, sizeof *r, 0, sizeof *r);
    if (np_run(av, cwd, 0, secs, r, why, sizeof why) != 0) return -1;
    return r->rc;
}

static int write_file_bytes(const char *path, const unsigned char *data, long n) {
    FILE *f = fopen(path, "wb");
    if (!f) return 1;
    if (n > 0 && fwrite(data, 1, (size_t)n, f) != (size_t)n) { fclose(f); return 1; }
    fclose(f);
    return 0;
}

/* Extracts real UNINETB1N stage bytes from ./unisacc.com P4 container (fail-closed if missing/corrupt). */
static int extract_real_stage(const char *pkg_path, const char *want_stage, unsigned char **out_b, long *out_n) {
    size_t fn = 0;
    char *fb = cx_read(pkg_path, &fn);
    PackageFooter foot;
    CxPackageDecode dec;
    CxCodecCrc crc;
    int rc = 1;
    *out_b = 0; *out_n = 0;
    if (!fb || !packagefooter_locate_bytes((const unsigned char *)fb, (long)fn, &foot)) {
        if (fb) free(fb);
        return 1;
    }
    mm_fill(&dec, sizeof dec, 0, sizeof dec);
    dec.allocate = pk_alloc_fn;
    dec.release = pk_free_fn;
    if (cxcodec_crc_init(&crc) ||
        cxpk_decode(&dec, (const unsigned char *)fb + foot.package_offset, foot.package_length)) {
        free(fb);
        return 1;
    }
    CxPackage *p = &dec.package;
    for (int i = 0; i < p->s; i++) {
        if (tx_eqz(p->stages[i].name, want_stage)) {
            int mi = p->stages[i].model;
            if (mi >= 0 && mi < p->m) {
                const unsigned char *comp = p->b + p->off[mi];
                long clen = p->len[mi];
                int rawlen = p->raw[mi];
                unsigned exp_crc = p->crc[mi];
                int codec = p->ver < 3 ? 0 : (p->model_codec[mi] ? 1 : 2);
                unsigned char *raw = (unsigned char *)malloc((size_t)(rawlen > 0 ? rawlen : 1));
                if (raw) {
                    int ok = 0;
                    if (codec == 2 && clen == rawlen) {
                        mm_copy(raw, rawlen, comp, rawlen);
                        ok = 1;
                    } else if (codec == 1 && !cxcodec_inflate(raw, (unsigned long)rawlen, comp, (unsigned long)clen)) {
                        ok = 1;
                    }
                    unsigned act_crc = 0;
                    if (ok && !cxcodec_crc(&crc, (const char *)raw, rawlen, &act_crc) &&
                        act_crc == exp_crc && rawlen >= 9 && !memcmp(raw, "UNINETB1N", 9)) {
                        *out_b = raw; *out_n = (long)rawlen; rc = 0;
                    } else {
                        free(raw);
                    }
                }
            }
            break;
        }
    }
    cxpl_release(&dec.package, pk_free_fn);
    free(fb);
    return rc;
}

static unsigned ex_crc32_test(char *p, int n) {
    unsigned crc = 0xffffffffU;
    for (int i = 0; i < n; i++) {
        crc = crc ^ (unsigned char)p[i];
        for (int j = 0; j < 8; j++)
            crc = (crc >> 1) ^ (0xedb88320U & (unsigned)(-(int)(crc & 1U)));
    }
    return ~crc;
}

static int route_along_two(const char *route, int idx, const char **out_stage) {
    (void)route;
    if (idx == 0) { *out_stage = "e2"; return 0; }
    if (idx == 1) { *out_stage = "e1"; return 0; }
    return 1;
}

static int mock_open_enosys(const char *p) { (void)p; return -ENOSYS; }
static int mock_self_enosys(char *b, int c) { (void)b; (void)c; return -ENOSYS; }

static void stub_rspl_reset(void) {}
static int stub_rspl_span(const char *a, const char *b, const char *c, int d, unsigned e, const char *f, const char *g,
                          const unsigned char *h, long i, unsigned char **j, long *k, char *l, int m) {
    (void)a; (void)b; (void)c; (void)d; (void)e; (void)f; (void)g; (void)h; (void)i; (void)j; (void)k; (void)l; (void)m;
    return 1;
}
static int stub_rspl_put(const char *a, int b, const unsigned char *c, int d) { (void)a; (void)b; (void)c; (void)d; return 0; }
static int stub_rspl_pop(void) { return 0; }
static int stub_rspl_inc(const char *src, const unsigned char **ib, int *il) { (void)src; *ib = 0; *il = 0; return 0; }
static int stub_rspl_obj(unsigned char *a, long b, const char *c, unsigned char **d, long *e, char *f, int g) {
    (void)a; (void)b; (void)c; (void)d; (void)e; (void)f; (void)g; return 1;
}
static int stub_rspl_compile_fail(const char *a, int b, const char *c, unsigned char *d, long e, unsigned char **f, long *g) {
    (void)a; (void)b; (void)c; (void)d; (void)e; (void)f; (void)g; return 1;
}
static int stub_rspl_compile_clo(const char *a, int b, const char *c, unsigned char *d, long e, unsigned char **f, long *g) {
    (void)a; (void)b; (void)e;
    if (tx_eqz(c, "RT_UNIT")) {
        unsigned char *buf = (unsigned char *)malloc(8);
        if (!buf) return 1;
        mm_copy(buf, 8, "RTUNIT0", 8);
        *f = buf; *g = 8;
        return 0;
    }
    return 1;
}

static int is_launch_ape(const char *path) {
    char magic[8];
    int fd = sy_open_read(path);
    if (fd < 0) return 0;
    int rc = sy_reg_size(fd) >= (long)sizeof magic ? sy_read_full(fd, magic, sizeof magic) : -1;
    sy_close(fd);
    return !rc && tx_same(magic, sizeof magic, "MZqFpD='", 8);
}

static void check_ape_leg(const char *ape, const char *cwd, const char *src, const char *cache,
                          const char *dir, const char *path_dir, int outcome, const char *name) {
    char ecache[4400], ep[4400], why[200];
    np_result r = {0};
    if (cx_fmt(ecache, sizeof ecache, "UNISACC_CACHE_DIR=%s", cache)) { ck_nn(0, name); return; }
    /* Poison both inputs before entering the actual APE shell. The wrapper
     * must replace them, not depend on the test removing inherited values. */
    char *v[16] = {"env", "UNISA_CONTAINER=/not-an-ape.pkg", "UNISACC_APE_SELF=/not-the-launcher.com",
        ecache, outcome >= 6 ? "UNISACC_RUN_CACHE=0" : "UNISACC_RUN_CACHE=1", "UNISACC_RR_TIME=1"};
    int at = 6;
    if (outcome == 3) v[at++] = "UNISACC_PHASE=build";
    if (path_dir) {
        if (cx_fmt(ep, sizeof ep, "PATH=%s:/usr/bin:/bin", path_dir)) { ck_nn(0, name); return; }
        v[at++] = ep;
    } else v[at++] = "sh";
    v[at++] = (char *)ape;
    if (dir) { v[at++] = "--nn-dir"; v[at++] = (char *)dir; }
    v[at++] = "-run"; v[at++] = (char *)src; v[at] = 0;
    int spawned = np_run(v, cwd, 0, 6, &r, why, sizeof why) == 0, good = 0;
    if (spawned && outcome == 1) {
        good = r.rc == 1 && has_bytes(r.err, r.errn, "external nn") &&
            (has_bytes(r.err, r.errn, "-ELOOP") || has_bytes(r.err, r.errn, "-ENOTDIR"));
    } else if (spawned && outcome == 2) {
        good = r.rc == 1 && has_bytes(r.err, r.errn, "bad UNINETB1N magic");
    } else if (spawned && (outcome == 3 || outcome == 7)) {
        good = r.rc == 42 && (has_bytes(r.err, r.errn, "RR_TIME\tmodel\tstage=e2\tsource=raw\t") ||
            has_bytes(r.err, r.errn, "RR_TIME\tmodel\tstage=e2\tsource=inflate\t")) &&
            !has_bytes(r.err, r.errn, "external nn");
    } else if (spawned && outcome == 4) {
        good = r.rc == 1 && has_bytes(r.err, r.errn, "external nn APE beside directory owner or write permissions refused");
    } else if (spawned && outcome == 5) {
        good = r.rc == 1 && has_bytes(r.err, r.errn, "external nn APE beside file owner, write permissions or link count refused");
    } else if (spawned && outcome == 6) {
        good = r.rc == 42 && has_bytes(r.err, r.errn, "external nn APE beside disabled: untrusted parent") &&
            (has_bytes(r.err, r.errn, "RR_TIME\tmodel\tstage=e2\tsource=raw\t") ||
             has_bytes(r.err, r.errn, "RR_TIME\tmodel\tstage=e2\tsource=inflate\t"));
    } else if (spawned) {
        good = r.rc == 42 && has_bytes(r.err, r.errn, "RR_TIME\tinference\tstage=e2") &&
            !has_bytes(r.err, r.errn, "RR_TIME\tlookup_hit=");
    }
    if (!good) printf("APE_E2E_LEG\tcase=%s\trc=%d\terr=%.*s\n", name, spawned ? r.rc : -1,
        (int)(r.errn < 400 ? r.errn : 400), r.err ? r.err : "");
    ck_nn(good, name);
    np_free(&r);
}

static void check_ape_name_matrix(const char *product, const char *base, const char *cwd,
                                   const char *src, const char *cache, const unsigned char *e2, long e2n) {
    static const char *const cases[] = {"original", "renamed", "unisacc-com"};
    const char *original = product;
    for (const char *p = product; *p; p++) if (*p == '/') original = p+1;
    const char *names[] = {original, "renamed-candidate", "unisacc.com"};
    char override[4160], ov_nb[4200], link[4200], aliases[4160], wrong[4200], wrong_nb[4240];
    int ready = !cx_fmt(override, sizeof override, "%s/ape-explicit-nn", base) &&
        !cx_fmt(ov_nb, sizeof ov_nb, "%s/e2.nb", override) &&
        !cx_fmt(link, sizeof link, "%s/ape-linked-nn", base) && !sy_mkdir(override, 0700) &&
        !write_file_bytes(ov_nb, e2, e2n) && !sy_symlink(override, link) &&
        !cx_fmt(aliases, sizeof aliases, "%s/ape-aliases", base) && !sy_mkdir(aliases, 0700) &&
        !cx_fmt(wrong, sizeof wrong, "%s/nn", aliases) && !sy_mkdir(wrong, 0700) &&
        !cx_fmt(wrong_nb, sizeof wrong_nb, "%s/e2.nb", wrong) &&
        !write_file_bytes(wrong_nb, (const unsigned char *)"BADMAGIC!", 9);
    ck_nn(ready, "e2e-ape-matrix-setup");
    if (!ready) return;
    for (int i = 0; i < 3; i++) {
        char folder[4160], ape[4400], alias[4300], side[4200], nb[4240], label[96], why[200];
        int ok = !cx_fmt(folder, sizeof folder, "%s/ape-name-%s", base, cases[i]) &&
            !cx_fmt(ape, sizeof ape, "%s/%s", folder, names[i]) &&
            !cx_fmt(alias, sizeof alias, "%s/%s", aliases, cases[i]) &&
            !cx_fmt(side, sizeof side, "%s/nn", folder) && !cx_fmt(nb, sizeof nb, "%s/e2.nb", side) &&
            !sy_mkdir(folder, 0700) && !sy_mkdir(side, 0700) && !write_file_bytes(nb, e2, e2n);
        np_result r = {0};
        char *cp[] = {"cp", "--", (char *)product, ape, 0};
        if (ok) ok = !np_run(cp, ".", 0, 5, &r, why, sizeof why) && r.rc == 0;
        np_free(&r);
        char *cmp[] = {"cmp", "--", (char *)product, ape, 0};
        if (ok) ok = !np_run(cmp, ".", 0, 5, &r, why, sizeof why) && r.rc == 0;
        np_free(&r);
        if (ok) ok = !sy_chmod(ape, 0700) && !sy_symlink(ape, alias);
        cx_fmt(label, sizeof label, "e2e-ape-%s-copy", cases[i]);
        ck_nn(ok, label);
        if (!ok) continue;
        cx_fmt(label, sizeof label, "e2e-ape-%s-beside", cases[i]);
        check_ape_leg(ape, cwd, src, cache, 0, 0, 0, label);
        cx_fmt(label, sizeof label, "e2e-ape-%s-relative-launch", cases[i]);
        check_ape_leg(names[i], folder, src, cache, 0, 0, 0, label);
        cx_fmt(label, sizeof label, "e2e-ape-%s-cross-directory-link", cases[i]);
        check_ape_leg(alias, cwd, src, cache, 0, 0, 0, label);
        cx_fmt(label, sizeof label, "e2e-ape-%s-path-search", cases[i]);
        check_ape_leg(names[i], cwd, src, cache, 0, folder, 0, label);
        if (i == 0) {
            ok = !sy_chmod(folder, 0777);
            ck_nn(ok, "e2e-ape-writable-parent-fixture");
            if (ok) {
                check_ape_leg(ape, cwd, src, cache, 0, 0, 6, "e2e-ape-writable-parent-disabled");
                check_ape_leg(ape, cwd, src, cache, side, 0, 0, "e2e-ape-explicit-accepts-writable-parent");
            }
            ok = !sy_chmod(folder, 0700) && !sy_chmod(side, 0770);
            ck_nn(ok, "e2e-ape-writable-nn-fixture");
            if (ok) check_ape_leg(ape, cwd, src, cache, 0, 0, 4, "e2e-ape-writable-nn-refused");
            ck_nn(!sy_chmod(side, 0700), "e2e-ape-writable-nn-restore");
            ok = !sy_chmod(nb, 0660);
            ck_nn(ok, "e2e-ape-writable-stage-fixture");
            if (ok) {
                check_ape_leg(ape, cwd, src, cache, 0, 0, 5, "e2e-ape-writable-stage-refused");
                check_ape_leg(ape, cwd, src, cache, side, 0, 0, "e2e-ape-explicit-accepts-writable-stage");
            }
            ck_nn(!sy_chmod(nb, 0600), "e2e-ape-writable-stage-restore");
            char extra[1200], why[128];
            cx_fmt(extra, sizeof extra, "%s/extra.nb", side);
            char *hard[] = {"ln", "--", nb, extra, 0};
            np_result lr = {0};
            ok = np_run(hard, cwd, 0, 4, &lr, why, sizeof why) == 0 && lr.rc == 0;
            np_free(&lr);
            ck_nn(ok, "e2e-ape-hardlinked-stage-fixture");
            if (ok) {
                check_ape_leg(ape, cwd, src, cache, 0, 0, 5, "e2e-ape-hardlinked-stage-refused");
                check_ape_leg(ape, cwd, src, cache, side, 0, 0, "e2e-ape-explicit-accepts-hardlinked-stage");
                ck_nn(!sy_unlink(extra), "e2e-ape-hardlinked-stage-restore");
            }
            char saved[4240];
            ok = !cx_fmt(saved, sizeof saved, "%s/nn.saved", folder) && !sy_rename(side, saved);
            ck_nn(ok, "e2e-ape-default-nn-move-fixture");
            if (ok) {
                int prepared = !sy_symlink(saved, side);
                ck_nn(prepared, "e2e-ape-default-nn-symlink-fixture");
                if (prepared) {
                    check_ape_leg(ape, cwd, src, cache, 0, 0, 1, "e2e-ape-default-nn-symlink-refused");
                    ck_nn(!sy_unlink(side), "e2e-ape-default-nn-symlink-remove");
                }
                prepared = !write_file_bytes(side, (const unsigned char *)"file", 4);
                ck_nn(prepared, "e2e-ape-default-nn-nondirectory-fixture");
                if (prepared) {
                    check_ape_leg(ape, cwd, src, cache, 0, 0, 1, "e2e-ape-default-nn-nondirectory-refused");
                    ck_nn(!sy_unlink(side), "e2e-ape-default-nn-nondirectory-remove");
                }
                prepared = !sy_chmod(folder, 0777);
                ck_nn(prepared, "e2e-ape-writable-parent-absent-nn-fixture");
                if (prepared) check_ape_leg(ape, cwd, src, cache, 0, 0, 7, "e2e-ape-writable-parent-absent-nn-silent");
                ck_nn(!sy_chmod(folder, 0700) && !sy_rename(saved, side), "e2e-ape-default-nn-restore");
            }
        }
        cx_fmt(label, sizeof label, "e2e-ape-%s-corrupt-setup", cases[i]);
        ok = !write_file_bytes(nb, (const unsigned char *)"BADMAGIC!", 9);
        ck_nn(ok, label);
        if (!ok) continue;
        cx_fmt(label, sizeof label, "e2e-ape-%s-explicit", cases[i]);
        check_ape_leg(ape, cwd, src, cache, override, 0, 0, label);
        cx_fmt(label, sizeof label, "e2e-ape-%s-nofollow", cases[i]);
        check_ape_leg(ape, cwd, src, cache, link, 0, 1, label);
        cx_fmt(label, sizeof label, "e2e-ape-%s-corrupt", cases[i]);
        check_ape_leg(ape, cwd, src, cache, 0, 0, 2, label);
        cx_fmt(label, sizeof label, "e2e-ape-%s-chain-skips-corrupt-beside", cases[i]);
        check_ape_leg(ape, cwd, src, cache, 0, 0, 3, label);
        cx_fmt(label, sizeof label, "e2e-ape-%s-chain-skips-forbidden-explicit", cases[i]);
        check_ape_leg(ape, cwd, src, cache, link, 0, 3, label);
    }
}

static void run_e2e(const char *cand_path, const char *base_dir, const unsigned char *real_e2, long real_e2_n) {
    char cmd[8192], cand_bin[4200], nn_dir[4200], e2_nb[4400], cache_dir[4200];
    char work_dir[4200], link_dir[4200], link_cand[4400], h_cx[4400];
    char long560[4400], long560_nb[4600], long4200[4600];
    np_result r;

    cx_fmt(cand_bin, sizeof cand_bin, "%s/e2e_bin/cand", base_dir);
    cx_fmt(nn_dir, sizeof nn_dir, "%s/e2e_bin/nn", base_dir);
    cx_fmt(e2_nb, sizeof e2_nb, "%s/e2.nb", nn_dir);
    cx_fmt(cache_dir, sizeof cache_dir, "%s/e2e_cache", base_dir);
    cx_fmt(work_dir, sizeof work_dir, "%s/e2e_work", base_dir);
    cx_fmt(link_dir, sizeof link_dir, "%s/e2e_links", base_dir);
    cx_fmt(link_cand, sizeof link_cand, "%s/cand_link", link_dir);
    cx_fmt(h_cx, sizeof h_cx, "%s/h.cx", work_dir);

    cx_fmt(cmd, sizeof cmd,
        "set -e; mkdir -p '%s/e2e_bin' '%s' '%s' '%s'; "
        "cp '%s' '%s'; chmod +x '%s'; "
        "ln -sf '%s' '%s'; "
        "printf 'int main(void) { return 42; }\\n' > '%s'",
        base_dir, cache_dir, work_dir, link_dir,
        cand_path, cand_bin, cand_bin, cand_bin, link_cand, h_cx);
    run_sh(".", cmd, 20, &r);
    ck_nn(r.rc == 0, "e2e-setup");
    np_free(&r);

    /* (E1) Same candidate: warm up builtin run-cache (cold -> warm hit) */
    cx_fmt(cmd, sizeof cmd,
        "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
        "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
        "UNISACC_CACHE_DIR='%s' UNISACC_RUN_CACHE=1 UNISACC_RR_TIME=1 "
        "'%s' -run '%s'", cache_dir, cand_bin, h_cx);
    run_sh(work_dir, cmd, 30, &r);
    ck_nn(r.rc == 42, "e2e-builtin-cold-rc42");
    np_free(&r);

    run_sh(work_dir, cmd, 30, &r);
    ck_nn(r.rc == 42 && has_bytes(r.err, r.errn, "RR_TIME\tlookup_hit=2") &&
          !has_bytes(r.err, r.errn, "RR_TIME\tinference"), "e2e-builtin-warm-cache-hit");
    np_free(&r);

    check_ape_name_matrix(cand_path, base_dir, work_dir, h_cx, cache_dir, real_e2, real_e2_n);

    /* (E2) Beside nn/ with REAL extracted UNINETB1N model bypasses warm builtin cache */
    cx_fmt(cmd, sizeof cmd, "mkdir -p '%s'", nn_dir);
    run_sh(".", cmd, 10, &r); np_free(&r);
    ck_nn(write_file_bytes(e2_nb, real_e2, real_e2_n) == 0, "e2e-write-real-e2");

    cx_fmt(cmd, sizeof cmd,
        "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
        "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
        "UNISACC_CACHE_DIR='%s' UNISACC_RUN_CACHE=1 UNISACC_RR_TIME=1 "
        "'%s' -run '%s'", cache_dir, cand_bin, h_cx);
    run_sh(work_dir, cmd, 30, &r);
    ck_nn(r.rc == 42 && !has_bytes(r.err, r.errn, "RR_TIME\tlookup_hit=") &&
          has_bytes(r.err, r.errn, "RR_TIME\tinference\tstage=e2"), "e2e-beside-real-nn-bypasses-warm-cache");
    np_free(&r);

    /* (E3) Symlink and PATH lookup resolve beside REAL executable nn/, ignoring corrupt CWD ./nn trap */
    cx_fmt(cmd, sizeof cmd,
        "mkdir -p '%s/nn' && printf 'BADMAGIC!' > '%s/nn/e2.nb' && "
        "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
        "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
        "UNISACC_CACHE_DIR='%s' UNISACC_RUN_CACHE=1 '%s' -run '%s'",
        work_dir, work_dir, cache_dir, link_cand, h_cx);
    run_sh(work_dir, cmd, 30, &r);
    ck_nn(r.rc == 42, "e2e-symlink-resolves-exe-beside-ignores-cwd-nn");
    np_free(&r);

    cx_fmt(cmd, sizeof cmd,
        "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
        "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
        "PATH='%s/e2e_bin:/usr/bin:/bin' UNISACC_CACHE_DIR='%s' UNISACC_RUN_CACHE=1 "
        "cand -run '%s'", base_dir, cache_dir, h_cx);
    run_sh(work_dir, cmd, 30, &r);
    ck_nn(r.rc == 42, "e2e-path-invocation-resolves-exe-beside");
    np_free(&r);

    /* (E4) Internally corrupted UNINETB1N (magic intact, interior payload corrupted) refuses despite warm cache */
    {
        unsigned char *bad_int = (unsigned char *)malloc((size_t)real_e2_n);
        int ok_w = 0;
        if (bad_int) {
            mm_copy(bad_int, real_e2_n, real_e2, real_e2_n);
            for (long k = 9; k < real_e2_n && k < 64; k++) bad_int[k] = (unsigned char)(bad_int[k] ^ 0xffu);
            ok_w = (write_file_bytes(e2_nb, bad_int, real_e2_n > 24 ? 24 : real_e2_n) == 0);
            free(bad_int);
        }
        ck_nn(ok_w, "e2e-write-internal-corrupt-e2");
    }
    cx_fmt(cmd, sizeof cmd,
        "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
        "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
        "UNISACC_CACHE_DIR='%s' UNISACC_RUN_CACHE=1 '%s' -run '%s'", cache_dir, cand_bin, h_cx);
    run_sh(work_dir, cmd, 30, &r);
    ck_nn(r.rc != 0 && r.rc != 42, "e2e-beside-internal-corrupt-refused-not-cached");
    np_free(&r);

    /* (E5) Symlink stage (O_NOFOLLOW -> -ELOOP), symlink dir (-ELOOP), and FIFO (O_NONBLOCK) all refuse cleanly */
    {
        char sym_dir[4400], sym_target[4400], sym_nb_real[4500];
        cx_fmt(sym_target, sizeof sym_target, "%s/e2e_sym_tgt", base_dir);
        cx_fmt(sym_dir, sizeof sym_dir, "%s/e2e_sym_dir", base_dir);
        cx_fmt(sym_nb_real, sizeof sym_nb_real, "%s/e2.nb", sym_target);
        cx_fmt(cmd, sizeof cmd, "mkdir -p '%s' && ln -sfn '%s' '%s'", sym_target, sym_target, sym_dir);
        run_sh(".", cmd, 10, &r); np_free(&r);
        ck_nn(write_file_bytes(sym_nb_real, real_e2, real_e2_n) == 0, "e2e-sym-tgt-write");
        cx_fmt(cmd, sizeof cmd, "'%s' --nn-dir '%s' -run '%s'", cand_bin, sym_dir, h_cx);
        run_sh(work_dir, cmd, 15, &r);
        ck_nn(r.rc != 0 && r.rc != 42 && (has_bytes(r.err, r.errn, "-ELOOP") || has_bytes(r.err, r.errn, "-ENOTDIR")), "e2e-dir-symlink-nofollow-refused");
        np_free(&r);

        cx_fmt(cmd, sizeof cmd, "'%s' --nn-dir '%s/' -run '%s'", cand_bin, sym_dir, h_cx);
        run_sh(work_dir, cmd, 15, &r);
        ck_nn(r.rc != 0 && r.rc != 42 && (has_bytes(r.err, r.errn, "-ELOOP") || has_bytes(r.err, r.errn, "-ENOTDIR")), "e2e-dir-symlink-trailing-slash-nofollow-refused");
        np_free(&r);

        cx_fmt(cmd, sizeof cmd, "rm -f '%s' && ln -sf '%s' '%s'", e2_nb, sym_nb_real, e2_nb);
        run_sh(".", cmd, 10, &r); np_free(&r);
        cx_fmt(cmd, sizeof cmd,
            "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
            "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
            "UNISACC_CACHE_DIR='%s' '%s' -run '%s'", cache_dir, cand_bin, h_cx);
        run_sh(work_dir, cmd, 15, &r);
        ck_nn(r.rc != 0 && r.rc != 42 && has_bytes(r.err, r.errn, "-ELOOP"), "e2e-stage-symlink-eloop-refused");
        np_free(&r);
    }

    cx_fmt(cmd, sizeof cmd, "rm -f '%s' && mkfifo '%s'", e2_nb, e2_nb);
    run_sh(".", cmd, 10, &r); np_free(&r);
    cx_fmt(cmd, sizeof cmd,
        "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
        "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
        "UNISACC_CACHE_DIR='%s' '%s' -run '%s'", cache_dir, cand_bin, h_cx);
    run_sh(work_dir, cmd, 10, &r);
    ck_nn(r.rc != 0 && r.rc != 42, "e2e-fifo-nonregular-refused-no-hang");
    np_free(&r);

    /* (E6) >550 char explicit --nn-dir works without truncation; >=4096 char explicit dir explicitly refused */
    {
        char seg[64];
        cx_fmt(seg, sizeof seg, "d012345678901234567890123456789012345678901234567890");
        cx_fmt(long560, sizeof long560, "%s", work_dir);
        for (int s = 0; s < 12; s++) {
            size_t cur = strlen(long560);
            cx_fmt(long560 + cur, sizeof long560 - cur, "/%s", seg);
        }
        ck_nn(strlen(long560) > 550, "e2e-long560-len");
        cx_fmt(cmd, sizeof cmd, "mkdir -p '%s'", long560);
        run_sh(".", cmd, 10, &r); np_free(&r);
        cx_fmt(long560_nb, sizeof long560_nb, "%s/e2.nb", long560);
        ck_nn(write_file_bytes(long560_nb, real_e2, real_e2_n) == 0, "e2e-long560-write");
        cx_fmt(cmd, sizeof cmd, "rm -f '%s'", e2_nb);
        run_sh(".", cmd, 10, &r); np_free(&r);
        cx_fmt(cmd, sizeof cmd,
            "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
            "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
            "'%s' --nn-dir '%s' -run '%s'", cand_bin, long560, h_cx);
        run_sh(work_dir, cmd, 30, &r);
        ck_nn(r.rc == 42, "e2e-explicit-560plus-dir-not-truncated");
        np_free(&r);

        memset(long4200, 'x', 4200);
        long4200[0] = '/'; long4200[4200] = 0;
        {
            char *ovv[] = {cand_bin, "--nn-dir", long4200, "-run", h_cx, 0};
            char owhy[200];
            mm_fill(&r, sizeof r, 0, sizeof r);
            int orc = (np_run(ovv, work_dir, 0, 15, &r, owhy, sizeof owhy) == 0) ? r.rc : -1;
            ck_nn(orc != 0 && orc != 42, "e2e-overlong-4200-dir-refused");
            np_free(&r);
        }
    }

    /* (E7) Fallback on empty beside nn/, byte-identical to --no-external-nn, and formal-chain isolation */
    cx_fmt(cmd, sizeof cmd,
        "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
        "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
        "'%s' -b lnx/x86_64 '%s' -o '%s/a.elf' && "
        "'%s' --no-external-nn -b lnx/x86_64 '%s' -o '%s/b.elf' && cmp '%s/a.elf' '%s/b.elf'",
        cand_bin, h_cx, work_dir, cand_bin, h_cx, work_dir, work_dir, work_dir);
    run_sh(work_dir, cmd, 30, &r);
    ck_nn(r.rc == 0, "e2e-empty-beside-fallback-byte-identical");
    np_free(&r);

    ck_nn(write_file_bytes(e2_nb, (const unsigned char *)"BADMAGIC!", 9) == 0, "e2e-replant-bad-beside");
    cx_fmt(cmd, sizeof cmd, "UNISACC_NN_MODE=builtin '%s' -run '%s'", cand_bin, h_cx);
    run_sh(work_dir, cmd, 30, &r);
    ck_nn(r.rc == 42, "e2e-nn-mode-builtin-ignores-corrupt");
    np_free(&r);

    cx_fmt(cmd, sizeof cmd, "UNISACC_CHAIN_PHASE_BOUND_S=60 '%s' -run '%s'", cand_bin, h_cx);
    run_sh(work_dir, cmd, 30, &r);
    ck_nn(r.rc == 42, "e2e-formal-chain-env-forces-builtin");
    np_free(&r);

    cx_fmt(cmd, sizeof cmd, "'%s' --no-external-nn -run '%s'", cand_bin, h_cx);
    run_sh(work_dir, cmd, 30, &r);
    ck_nn(r.rc == 42, "e2e-no-external-nn-ignores-corrupt");
    np_free(&r);

    /* (E8) Armed cache + atomic model drop race */
    {
        char rbin[4300], rnn[4400], rcand[4400], rcache[4300], rnb[4500], rtmp[4500];
        cx_fmt(rbin, sizeof rbin, "%s/e2e_race_bin", base_dir);
        cx_fmt(rnn, sizeof rnn, "%s/nn", rbin);
        cx_fmt(rcand, sizeof rcand, "%s/cand", rbin);
        cx_fmt(rcache, sizeof rcache, "%s/e2e_race_cache", base_dir);
        cx_fmt(rnb, sizeof rnb, "%s/e2.nb", rnn);
        cx_fmt(rtmp, sizeof rtmp, "%s/e2.tmp", base_dir);
        int race_ok = 1;
        for (int pass = 0; pass < 3 && race_ok; pass++) {
            cx_fmt(cmd, sizeof cmd,
                "mkdir -p '%s' '%s' && cp '%s' '%s' && chmod +x '%s' && "
                "rm -f '%s' '%s' && rm -rf '%s' && mkdir -p '%s' && "
                "printf 'BADMAGIC!' > '%s' && "
                "(sleep 0.0%d; mv -f '%s' '%s') & "
                "WP=$!; "
                "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
                "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
                "UNISACC_CACHE_DIR='%s' UNISACC_RUN_CACHE=1 '%s' -run '%s' >/dev/null 2>&1; RC1=$?; "
                "wait $WP 2>/dev/null || true; "
                "rm -f '%s'; "
                "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
                "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
                "UNISACC_CACHE_DIR='%s' UNISACC_RUN_CACHE=1 '%s' -run '%s' >/dev/null 2>&1; RC2=$?; "
                "[ $RC2 -eq 42 ] && ([ $RC1 -eq 42 ] || [ $RC1 -ne 0 ])",
                rbin, rnn, cand_bin, rcand, rcand,
                rnb, rtmp, rcache, rcache, rtmp, pass + 1, rtmp, rnb,
                rcache, rcand, h_cx, rnb, rcache, rcand, h_cx);
            run_sh(work_dir, cmd, 30, &r);
            if (r.rc != 0) race_ok = 0;
            np_free(&r);
        }
        ck_nn(race_ok, "e2e-armed-atomic-drop-race-not-poisoned");
    }

    /* (E9) pm_close() -> dv_finish(rc_store_elf) write guard: external -b lnx/x86_64 -o NEVER poisons builtin run-cache! */
    {
        char oc_dir[4200], same_elf[4400];
        cx_fmt(oc_dir, sizeof oc_dir, "%s/e2e_pm_close_cache", base_dir);
        cx_fmt(same_elf, sizeof same_elf, "%s/same_out.elf", work_dir);
        ck_nn(write_file_bytes(e2_nb, real_e2, real_e2_n) == 0, "e2e-pm-close-write-real-e2");
        cx_fmt(cmd, sizeof cmd,
            "rm -rf '%s' && mkdir -p '%s' && "
            "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
            "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
            "UNISACC_CACHE_DIR='%s' UNISACC_RUN_CACHE=1 UNISACC_RR_TIME=1 "
            "'%s' -b lnx/x86_64 '%s' -o '%s' && '%s'",
            oc_dir, oc_dir, oc_dir, cand_bin, h_cx, same_elf, same_elf);
        run_sh(work_dir, cmd, 30, &r);
        ck_nn(r.rc == 42 && !has_bytes(r.err, r.errn, "RR_TIME\tlookup_hit="), "e2e-pm-close-ext-build-runs-42");
        np_free(&r);

        cx_fmt(cmd, sizeof cmd,
            "rm -f '%s' '%s' && "
            "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
            "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
            "UNISACC_CACHE_DIR='%s' UNISACC_RUN_CACHE=1 UNISACC_RR_TIME=1 "
            "'%s' -b lnx/x86_64 '%s' -o '%s' && '%s'",
            e2_nb, same_elf, oc_dir, cand_bin, h_cx, same_elf, same_elf);
        run_sh(work_dir, cmd, 30, &r);
        ck_nn(r.rc == 42 && has_bytes(r.err, r.errn, "RR_TIME\tlookup_hit=0") &&
              !has_bytes(r.err, r.errn, "RR_TIME\tlookup_hit=2"), "e2e-pm-close-did-not-poison-builtin-cache");
        np_free(&r);

        cx_fmt(cmd, sizeof cmd,
            "rm -f '%s' && "
            "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
            "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
            "UNISACC_CACHE_DIR='%s' UNISACC_RUN_CACHE=1 UNISACC_RR_TIME=1 "
            "'%s' -b lnx/x86_64 '%s' -o '%s' && '%s'",
            same_elf, oc_dir, cand_bin, h_cx, same_elf, same_elf);
        run_sh(work_dir, cmd, 30, &r);
        ck_nn(r.rc == 42 && has_bytes(r.err, r.errn, "RR_TIME\tlookup_hit=2"), "e2e-pm-close-subsequent-builtin-hits-warm");
        np_free(&r);
    }

    /* (E10) B2 rspl multi-file split compile: external e2 writes 0 unitobj AND post-ext builtin run misses cache */
    {
        char m1[4400], m2[4400], rspl_cache[4200];
        cx_fmt(m1, sizeof m1, "%s/rspl_a.cx", work_dir);
        cx_fmt(m2, sizeof m2, "%s/rspl_b.cx", work_dir);
        cx_fmt(rspl_cache, sizeof rspl_cache, "%s/e2e_rspl_cache", base_dir);
        cx_fmt(cmd, sizeof cmd,
            "printf 'int rspl_helper(void); int main(void) { return rspl_helper(); }\\n' > '%s' && "
            "printf 'int rspl_helper(void) { return 42; }\\n' > '%s' && "
            "rm -f '%s' && rm -rf '%s' && mkdir -p '%s'",
            m1, m2, e2_nb, rspl_cache, rspl_cache);
        run_sh(work_dir, cmd, 15, &r); np_free(&r);

        /* Step 1: With external e2.nb present, rspl MUST bypass AND unitobj dir MUST stay empty (0 files)! */
        ck_nn(write_file_bytes(e2_nb, real_e2, real_e2_n) == 0, "e2e-rspl-write-real-e2");
        cx_fmt(cmd, sizeof cmd,
            "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
            "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
            "UNISACC_CACHE_DIR='%s' UNISACC_RUN_CACHE=1 UNISACC_RUN_SPLIT=1 UNISACC_RR_TIME=1 '%s' -run '%s' '%s'; "
            "RC=$?; UOC=$(find '%s/unitobj' -type f 2>/dev/null | wc -l); "
            "echo \"RSPL_UOC=$UOC\"; exit $RC",
            rspl_cache, cand_bin, m1, m2, rspl_cache);
        run_sh(work_dir, cmd, 30, &r);
        ck_nn(r.rc == 42 && has_bytes(r.out, r.outn, "RSPL_UOC=0") &&
              !has_bytes(r.err, r.errn, "RR_TIME\tlookup_hit="), "e2e-rspl-ext-leaves-unitobj-empty");
        np_free(&r);

        /* Step 2: Remove external e2.nb -> first builtin UNISACC_RUN_SPLIT=1 MUST miss unitobj (runs cold inference, then populates 3 unitobj)! */
        cx_fmt(cmd, sizeof cmd,
            "rm -f '%s' && "
            "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
            "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
            "UNISACC_CACHE_DIR='%s' UNISACC_RUN_CACHE=1 UNISACC_RUN_SPLIT=1 UNISACC_RR_TIME=1 '%s' -run '%s' '%s'; "
            "RC=$?; UOC=$(find '%s/unitobj' -type f 2>/dev/null | wc -l); "
            "echo \"RSPL_UOC_AFTER=$UOC\"; exit $RC",
            e2_nb, rspl_cache, cand_bin, m1, m2, rspl_cache);
        run_sh(work_dir, cmd, 30, &r);
        ck_nn(r.rc == 42 && has_bytes(r.err, r.errn, "RR_TIME\tinference\tstage=e2") &&
              has_bytes(r.out, r.outn, "RSPL_UOC_AFTER=3"), "e2e-rspl-ext-then-builtin-misses");
        np_free(&r);

        /* Step 3: Warm builtin rspl hits unitobj cleanly */
        cx_fmt(cmd, sizeof cmd,
            "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
            "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
            "UNISACC_CACHE_DIR='%s' UNISACC_RUN_CACHE=1 UNISACC_RUN_SPLIT=1 UNISACC_RR_TIME=1 '%s' -run '%s' '%s'",
            rspl_cache, cand_bin, m1, m2);
        run_sh(work_dir, cmd, 30, &r);
        ck_nn(r.rc == 42 && !has_bytes(r.err, r.errn, "RR_TIME\tinference\tstage=e2"), "e2e-rspl-builtin-inherits-sealed-absent");
        np_free(&r);
    }

    /* (E11) unisacc stream single-seal + --nn-dir + --no-external-nn + --models */
    {
        char st_ext[4400], st_ext_nb[4500];
        cx_fmt(st_ext, sizeof st_ext, "%s/e2e_stream_nn", base_dir);
        cx_fmt(st_ext_nb, sizeof st_ext_nb, "%s/e2.nb", st_ext);
        cx_fmt(cmd, sizeof cmd, "mkdir -p '%s'", st_ext);
        run_sh(".", cmd, 10, &r); np_free(&r);
        ck_nn(write_file_bytes(st_ext_nb, real_e2, real_e2_n) == 0, "e2e-stream-ext-write");

        ck_nn(write_file_bytes(e2_nb, (const unsigned char *)"BADMAGIC!", 9) == 0, "e2e-stream-plant-bad");
        cx_fmt(cmd, sizeof cmd, "printf 'int main(void) { return 42; }\\n' | '%s' stream e2 --route lnx/x86_64/image/O0 --models '%s' >/dev/null",
               cand_bin, cand_bin);
        run_sh(work_dir, cmd, 20, &r);
        ck_nn(r.rc == 0, "e2e-stream-models-forces-builtin");
        np_free(&r);

        cx_fmt(cmd, sizeof cmd,
            "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
            "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
            "'%s' stream e2 --route lnx/x86_64/image/O0 --no-external-nn < '%s' >/dev/null", cand_bin, h_cx);
        run_sh(work_dir, cmd, 20, &r);
        ck_nn(r.rc == 0, "e2e-stream-no-external-nn-ignores-corrupt");
        np_free(&r);

        cx_fmt(cmd, sizeof cmd,
            "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
            "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
            "'%s' stream e2 --route lnx/x86_64/image/O0 --nn-dir '%s' < '%s' >/dev/null", cand_bin, st_ext, h_cx);
        run_sh(work_dir, cmd, 20, &r);
        ck_nn(r.rc == 0, "e2e-stream-nn-dir-explicit-ok");
        np_free(&r);

        cx_fmt(cmd, sizeof cmd,
            "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
            "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
            "'%s' stream e2 --route lnx/x86_64/image/O0 < '%s' >/dev/null", cand_bin, h_cx);
        run_sh(work_dir, cmd, 20, &r);
        ck_nn(r.rc != 0, "e2e-stream-corrupt-beside-refused");
        np_free(&r);

        ck_nn(write_file_bytes(e2_nb, real_e2, real_e2_n) == 0, "e2e-stream-write-real-e2");
        cx_fmt(cmd, sizeof cmd,
            "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
            "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
            "'%s' stream e2 --route lnx/x86_64/image/O0 < '%s' >/dev/null", cand_bin, h_cx);
        run_sh(work_dir, cmd, 20, &r);
        ck_nn(r.rc == 0, "e2e-stream-real-e2-sealed-ok");
        np_free(&r);

        cx_fmt(cmd, sizeof cmd, "rm -f '%s'", e2_nb);
        run_sh(".", cmd, 10, &r); np_free(&r);
    }

    /* (E12) SOURCES_SID unchanged when <repo>/nn/e2.nb added; falls back cleanly without .git, explicit UNMEASURED otherwise */
    cx_fmt(cmd, sizeof cmd,
        "rm -rf '%s/sid_snap' && mkdir -p '%s/sid_snap' && "
        "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then "
        "  git archive HEAD | tar -xf - -C '%s/sid_snap'; "
        "elif [ -f seed/ident.c ] && [ -f iterate/kernel/typekw.tsv ] && [ -f build/core-closure.tsv ] && [ -f cxroot.tsv ] && [ -d ext ]; then "
        "  tar -cf - exec src kernel include weights seed cx iterate/kernel/typekw.tsv tools build/core-closure.tsv cxroot.tsv ext | tar -xf - -C '%s/sid_snap'; "
        "else exit 77; fi && "
        "cc -std=c99 -O2 -w -I '%s/sid_snap/seed' '%s/sid_snap/seed/ident.c' -o '%s/sid_ident' && "
        "S1=$('%s/sid_ident' '%s/sid_snap') && "
        "mkdir -p '%s/sid_snap/nn' && printf 'UNINETB1N' > '%s/sid_snap/nn/e2.nb' && "
        "S2=$('%s/sid_ident' '%s/sid_snap') && "
        "[ -n \"$S1\" ] && [ \"$S1\" = \"$S2\" ] && rm -rf '%s/sid_snap'",
        base_dir, base_dir, base_dir, base_dir, base_dir, base_dir, base_dir,
        base_dir, base_dir, base_dir, base_dir, base_dir, base_dir, base_dir);
    run_sh(".", cmd, 30, &r);
    if (r.rc == 77) {
        g_unmeasured = g_unmeasured + 1;
        printf("UNMEASURED\te2e-external-nn-outside-sources-sid\treason=missing-repo-inputs\n");
    } else {
        ck_nn(r.rc == 0, "e2e-external-nn-outside-sources-sid");
    }
    np_free(&r);

    /* (E13) Single-source forwarding (1->2 stub replay -> multi/image + /unit closure) and multi-source /unit e1 closure */
    {
        unsigned char *real_units = 0, *real_e1 = 0;
        long real_units_n = 0, real_e1_n = 0;
        char units_nb[4400], e1_nb[4400], fwd_cx[4400], fwd_elf[4400], u1_cx[4400], u2_cx[4400], m_elf[4400];
        ck_nn(extract_real_stage("./unisacc.com", "units", &real_units, &real_units_n) == 0 && real_units_n > 32, "e2e-extract-real-units");
        ck_nn(extract_real_stage("./unisacc.com", "e1", &real_e1, &real_e1_n) == 0 && real_e1_n > 32, "e2e-extract-real-e1");
        cx_fmt(units_nb, sizeof units_nb, "%s/units.nb", nn_dir);
        cx_fmt(e1_nb, sizeof e1_nb, "%s/e1.nb", nn_dir);
        cx_fmt(fwd_cx, sizeof fwd_cx, "%s/fwd_single.cx", work_dir);
        cx_fmt(fwd_elf, sizeof fwd_elf, "%s/fwd_single.elf", work_dir);
        cx_fmt(u1_cx, sizeof u1_cx, "%s/u_a.cx", work_dir);
        cx_fmt(u2_cx, sizeof u2_cx, "%s/u_b.cx", work_dir);
        cx_fmt(m_elf, sizeof m_elf, "%s/m_unit.elf", work_dir);
        cx_fmt(cmd, sizeof cmd,
            "printf 'int puts(const char *); int main(void) { puts(\"fwd-nn\"); return 42; }\\n' > '%s' && "
            "printf 'int unit_helper(void); int main(void) { return unit_helper(); }\\n' > '%s' && "
            "printf 'int unit_helper(void) { return 42; }\\n' > '%s' && rm -f '%s' '%s' '%s'",
            fwd_cx, u1_cx, u2_cx, e2_nb, units_nb, e1_nb);
        run_sh(work_dir, cmd, 15, &r); np_free(&r);

        if (real_units && real_e1) {
            ck_nn(write_file_bytes(units_nb, real_units, real_units_n) == 0, "e2e-write-real-units");
            ck_nn(write_file_bytes(e1_nb, real_e1, real_e1_n) == 0, "e2e-write-real-e1");
            cx_fmt(cmd, sizeof cmd,
                "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
                "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
                "UNISACC_CACHE_DIR='%s' UNISACC_RUN_CACHE=1 '%s' -b lnx/x86_64 '%s' -o '%s' && '%s' >/dev/null",
                cache_dir, cand_bin, fwd_cx, fwd_elf, fwd_elf);
            run_sh(work_dir, cmd, 30, &r);
            ck_nn(r.rc == 42, "e2e-fwd-single-real-units-e1-ok");
            np_free(&r);

            cx_fmt(cmd, sizeof cmd,
                "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
                "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
                "UNISACC_CACHE_DIR='%s' UNISACC_RUN_CACHE=1 '%s' -b lnx/x86_64 '%s' '%s' -o '%s' && '%s'",
                cache_dir, cand_bin, u1_cx, u2_cx, m_elf, m_elf);
            run_sh(work_dir, cmd, 30, &r);
            ck_nn(r.rc == 42, "e2e-multi-real-unit-e1-ok");
            np_free(&r);

            cx_fmt(cmd, sizeof cmd,
                "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
                "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
                "'%s' -b osx/arm64 -S '%s' '%s' >/dev/null",
                cand_bin, u1_cx, u2_cx);
            run_sh(work_dir, cmd, 30, &r);
            ck_nn(r.rc == 0, "e2e-osx-multi-real-unit-e1-ok");
            np_free(&r);
        }

        /* Corrupt units.nb MUST be probed+refused on single-source forwarding (1->2 multi), but ignored on -E pp! */
        ck_nn(write_file_bytes(units_nb, (const unsigned char *)"BADMAGIC!", 9) == 0, "e2e-write-corrupt-units");
        cx_fmt(cmd, sizeof cmd,
            "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
            "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
            "'%s' -b lnx/x86_64 -E '%s' >/dev/null", cand_bin, h_cx);
        run_sh(work_dir, cmd, 20, &r);
        ck_nn(r.rc == 0, "e2e-pp-ignores-corrupt-units");
        np_free(&r);

        cx_fmt(cmd, sizeof cmd,
            "rm -f '%s' && "
            "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
            "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
            "'%s' -b lnx/x86_64 '%s' -o '%s'", fwd_elf, cand_bin, fwd_cx, fwd_elf);
        run_sh(work_dir, cmd, 20, &r);
        ck_nn(r.rc == 1 && has_bytes(r.err, r.errn, "unisacc: model driver:") &&
              has_bytes(r.err, r.errn, "bad UNINETB1N magic") && sy_exists(fwd_elf) == 0,
              "e2e-fwd-single-corrupt-units-refused");
        np_free(&r);

        /* Corrupt e1.nb MUST be probed+refused on multi-source /unit route AND single-source 1->2 unit-only fallthrough */
        cx_fmt(cmd, sizeof cmd, "rm -f '%s' '%s'", units_nb, e2_nb);
        run_sh(".", cmd, 10, &r); np_free(&r);
        if (real_e1) {
            ck_nn(write_file_bytes(e1_nb, real_e1, real_e1_n) == 0, "e2e-write-unit-only-real-e1");
            cx_fmt(cmd, sizeof cmd,
                "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
                "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
                "UNISACC_CACHE_DIR='%s' UNISACC_RUN_CACHE=1 '%s' -run '%s'",
                cache_dir, cand_bin, fwd_cx);
            run_sh(work_dir, cmd, 30, &r);
            ck_nn(r.rc == 42, "e2e-fwd-single-unit-only-real-e1-run-ok");
            np_free(&r);

            cx_fmt(cmd, sizeof cmd,
                "rm -f '%s' && "
                "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
                "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
                "UNISACC_CACHE_DIR='%s' UNISACC_RUN_CACHE=1 '%s' -b lnx/x86_64 '%s' -o '%s' && '%s' >/dev/null",
                fwd_elf, cache_dir, cand_bin, fwd_cx, fwd_elf, fwd_elf);
            run_sh(work_dir, cmd, 30, &r);
            ck_nn(r.rc == 42, "e2e-fwd-single-unit-only-real-e1-out-ok");
            np_free(&r);
        }
        ck_nn(write_file_bytes(e1_nb, (const unsigned char *)"BADMAGIC!", 9) == 0, "e2e-write-corrupt-e1");
        cx_fmt(cmd, sizeof cmd,
            "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
            "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
            "'%s' -run '%s'", cand_bin, fwd_cx);
        run_sh(work_dir, cmd, 20, &r);
        ck_nn(r.rc == 1 && has_bytes(r.err, r.errn, "unisacc: model driver:") &&
              has_bytes(r.err, r.errn, "bad UNINETB1N magic"),
              "e2e-fwd-single-unit-only-corrupt-e1-run-refused");
        np_free(&r);
        cx_fmt(cmd, sizeof cmd,
            "rm -f '%s' && "
            "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
            "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
            "'%s' -b lnx/x86_64 '%s' -o '%s'", fwd_elf, cand_bin, fwd_cx, fwd_elf);
        run_sh(work_dir, cmd, 20, &r);
        ck_nn(r.rc == 1 && has_bytes(r.err, r.errn, "unisacc: model driver:") &&
              has_bytes(r.err, r.errn, "bad UNINETB1N magic") && sy_exists(fwd_elf) == 0,
              "e2e-fwd-single-unit-only-corrupt-e1-out-refused");
        np_free(&r);
        cx_fmt(cmd, sizeof cmd,
            "rm -f '%s' && "
            "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
            "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
            "'%s' -b lnx/x86_64 '%s' '%s' -o '%s'", m_elf, cand_bin, u1_cx, u2_cx, m_elf);
        run_sh(work_dir, cmd, 20, &r);
        ck_nn(r.rc == 1 && has_bytes(r.err, r.errn, "unisacc: model driver:") &&
              has_bytes(r.err, r.errn, "bad UNINETB1N magic") && sy_exists(m_elf) == 0,
              "e2e-multi-corrupt-unit-e1-refused");
        np_free(&r);

        cx_fmt(cmd, sizeof cmd,
            "env -u UNISACC_NN_DIR -u UNISACC_NN_MODE -u UNISACC_PHASE -u UNISACC_CTOR "
            "-u UNISACC_CHAIN_PHASE_BOUND_S -u UNISACC_CHAIN_TOOLS_EPOCH -u UNISACC_CHAIN_SHAMEMO -u UNISACC_IDENTITY_HELPER -u UNISA_CONTAINER "
            "'%s' -b osx/arm64 -S '%s' '%s' >/dev/null", cand_bin, u1_cx, u2_cx);
        run_sh(work_dir, cmd, 20, &r);
        ck_nn(r.rc == 1 && has_bytes(r.err, r.errn, "unisacc: model driver:") &&
              has_bytes(r.err, r.errn, "bad UNINETB1N magic"),
              "e2e-osx-multi-corrupt-unit-e1-refused");
        np_free(&r);

        cx_fmt(cmd, sizeof cmd, "rm -f '%s' '%s'", units_nb, e1_nb);
        run_sh(".", cmd, 10, &r); np_free(&r);
        if (real_units) free(real_units);
        if (real_e1) free(real_e1);
    }
}

int main(int argc, char **argv) {
    check_ape_owner_policy();
    CxcState st;
    char why[128], base_dir[4096], dir[4200], nb[4400], env_nn[4200], long560[4400], long4200[4600], cmd[4096];
    char *av1[4], *av2[3], *av3[2];
    int idx, raw = 0, compressed = 0, rc;
    const unsigned char *mb = 0;
    long mn = 0;
    unsigned crc = 0;
    const char *e2e_cand = 0;
    np_result r;

    for (int a = 1; a < argc; a++) {
        if (tx_eqz(argv[a], "--e2e") && a + 1 < argc) e2e_cand = argv[++a];
        else { printf("FAIL\tbad-arg\t%s\n", argv[a]); return 2; }
    }

    if (sy_mkdtemp(sy_tmpdir(), "nn-ext-check-", base_dir, sizeof base_dir) != 0) {
        printf("FAIL\tmkdtemp\n");
        return 1;
    }
    cx_fmt(dir, sizeof dir, "%s/nn-dir", base_dir);
    cx_fmt(nb, sizeof nb, "%s/e2.nb", dir);
    cx_fmt(env_nn, sizeof env_nn, "%s/env-nn", base_dir);

    unsetenv("UNISACC_NN_DIR"); unsetenv("UNISACC_NN_MODE"); unsetenv("UNISACC_PHASE");
    unsetenv("UNISACC_CTOR"); unsetenv("UNISACC_CHAIN_PHASE_BOUND_S");
    unsetenv("UNISACC_CHAIN_TOOLS_EPOCH"); unsetenv("UNISACC_CHAIN_SHAMEMO");
    unsetenv("UNISACC_IDENTITY_HELPER"); unsetenv("UNISA_CONTAINER");
    unsetenv("UNISACC_APE_SELF");
    unsetenv("UNISACC_CACHE_DIR"); unsetenv("UNISACC_RUN_SPLIT");

    /* Unknown / unbooted default-deny & L0 bad-arg invariants */
    cxn_destroy();
    ck_nn(tx_eqz(cxn_why(), "external nn refused"), "why-default-msg");
    ck_nn(cxn_cache_allowed() == 0 && cxn_dir_get() == 0, "unknown-unbooted-cache-forbidden");
    ck_nn(cxn_try_load("e2", &mb, &mn, &raw, &crc, &compressed, ex_crc32_test) == 3, "unknown-unbooted-try-load-refused");
    ck_nn(sy_open_dir_nofollow("") == -EINVAL && sy_open_dir_nofollow(0) == -EINVAL, "l0-open-dir-empty-einval");
    ck_nn(sy_openat_read_nofollow(-1, "e2.nb") == -EINVAL && sy_openat_read_nofollow(0, "") == -EINVAL &&
          sy_openat_read_nofollow(0, "nonexistent") != -EINVAL, "l0-openat-bad-arg-einval");
    ck_nn(sy_self_path(0, 16) == -EINVAL && sy_self_path(cmd, 1) == -EINVAL, "l0-self-path-bad-arg-einval");

    ck_nn(sizeof(CxcState) == 144, "cli-abi-size");
    memset(&st, 0, sizeof st);
    av1[0] = "unisacc"; av1[1] = "--nn-dir"; av1[2] = dir; av1[3] = "a.cx";
    ck_nn(cxc_default_run(&st, av1, 4, why, 128) == 0, "cli-default-run");
    idx = 1;
    ck_nn(cxc_step(&st, av1, 4, &idx, why, 128) == 0 && idx == 3, "cli-nn-dir-step");
    ck_nn(tx_eqz(cxc_nn_dir_get(), dir) && cxc_no_ext_nn_get() == 0, "cli-nn-dir-val");

    memset(&st, 0, sizeof st);
    av2[0] = "unisacc"; av2[1] = "--no-external-nn"; av2[2] = "a.cx";
    ck_nn(cxc_default_run(&st, av2, 3, why, 128) == 0, "cli-noext-default-run");
    idx = 1;
    ck_nn(cxc_step(&st, av2, 3, &idx, why, 128) == 0 && idx == 2, "cli-noext-step");
    ck_nn(cxc_no_ext_nn_get() == 1, "cli-noext-val");

    memset(&st, 0, sizeof st);
    av3[0] = "unisacc"; av3[1] = "--nn-dir";
    idx = 1;
    ck_nn(cxc_step(&st, av3, 2, &idx, why, 128) == 5, "cli-nn-dir-missing-arg");

    /* Priorities, bare-name no ./nn, Windows \, L0 sy_self_path truncation, overlong refusal */
    {
        char fake_exe[4400], want_nn[4400], cmdm[4600], self_dir[4400];
        cx_fmt(fake_exe, sizeof fake_exe, "%s/fakebin/tool", base_dir);
        cx_fmt(want_nn, sizeof want_nn, "%s/fakebin/nn", base_dir);
        cx_fmt(self_dir, sizeof self_dir, "%s/longself", base_dir);
        cx_fmt(cmdm, sizeof cmdm, "mkdir -p '%s/fakebin' '%s/fakebin/nn' '%s' '%s'", base_dir, base_dir, env_nn, dir);
        run_sh(".", cmdm, 10, &r); np_free(&r);

        setenv("UNISACC_NN_DIR", env_nn, 1);
        ck_nn(cxn_init(0, 0, fake_exe) == 1 && tx_eqz(cxn_dir_get(), env_nn), "prio-env-over-beside");
        ck_nn(cxn_init(dir, 0, fake_exe) == 1 && tx_eqz(cxn_dir_get(), dir), "prio-cli-over-env");
        ck_nn(cxn_init(dir, 1, fake_exe) == 0 && cxn_dir_get() == 0, "prio-noext-over-cli");
        unsetenv("UNISACC_NN_DIR");

        ck_nn(cxn_init(0, 0, fake_exe) == 1 && tx_eqz(cxn_dir_get(), want_nn), "prio-beside-fallback");
        ck_nn(cxn_init(0, 0, "unisacc") == 0 && cxn_dir_get() == 0 && cxn_cache_allowed() == 1, "bare-name-never-falls-back-cwd-nn");
        ck_nn(cxn_init(0, 0, "C:\\tools\\unisacc.exe") == 1 && tx_eqz(cxn_dir_get(), "C:\\tools\\nn") &&
              cxn_cache_allowed() == 1, "win-backslash-beside");
        ck_nn(cxn_init("C:\\tools\\nn", 0, 0) == 1 && tx_eqz(cxn_dir_get(), "C:\\tools\\nn") && cxn_cache_allowed() == 1,
              "win-explicit-absent-enoent-ok");
        ck_nn(cxn_init(0, 0, "/unisacc.com") == 1 && tx_eqz(cxn_dir_get(), "/nn"), "root-slash-beside-path");
        ck_nn(cxn_init(0, 0, 0) >= 0 && cxn_uncovered_why() == 0, "l0-self-path-ok");

        /* Simulated -ENOSYS hooks: exercise cxn_note_uncovered / cxn_uncovered_why / explicit refusal */
        cxn_set_sys_hooks(mock_open_enosys, 0);
        ck_nn(cxn_boot(0, 0, 0, why, sizeof why) == 0 && cxn_dir_get() == 0 && cxn_cache_allowed() == 1 &&
              cxn_uncovered_why() != 0 && has_bytes(cxn_uncovered_why(), strlen(cxn_uncovered_why()), "UNCOVERED:"),
              "sim-win-enosys-beside-fallback-named-uncovered");
        ck_nn(cxn_boot(dir, 0, 0, why, sizeof why) < 0 && has_bytes(why, strlen(why), "UNCOVERED:") &&
              has_bytes(cxn_why(), strlen(cxn_why()), "-ENOSYS") && cxn_cache_allowed() == 0,
              "sim-win-enosys-explicit-hard-refused");
        cxn_set_sys_hooks(0, mock_self_enosys);
        ck_nn(cxn_boot(0, 0, 0, why, sizeof why) == 0 && cxn_dir_get() == 0 && cxn_cache_allowed() == 1 &&
              cxn_uncovered_why() != 0 && has_bytes(cxn_uncovered_why(), strlen(cxn_uncovered_why()), "UNCOVERED:"),
              "sim-darwin-enosys-beside-fallback-named-uncovered");
        cxn_set_sys_hooks(0, 0);

        {
            char full_sp[4096], small_sp[4096];
            int splen = sy_self_path(full_sp, (int)sizeof full_sp);
            ck_nn(splen > 4, "sy-self-path-len-gt4");
            ck_nn(sy_self_path(small_sp, 4) == -ENAMETOOLONG, "sy-self-path-small-cap-enametoolong");
            ck_nn(splen > 1 && sy_self_path(small_sp, splen) == -ENAMETOOLONG, "sy-self-path-exact-cap-enametoolong");
            ck_nn(splen > 1 && sy_self_path(small_sp, splen + 1) == splen && tx_eqz(small_sp, full_sp), "sy-self-path-cap-plus1-ok");
        }

        cx_fmt(long560, sizeof long560, "%s", base_dir);
        for (int s = 0; s < 12; s++) {
            size_t bl = strlen(long560);
            cx_fmt(long560 + bl, sizeof long560 - bl, "/d012345678901234567890123456789012345678901234567890");
        }
        ck_nn(strlen(long560) > 550 && cxn_init(long560, 0, 0) == 1 && tx_eqz(cxn_dir_get(), long560), "explicit-560-char-not-truncated");

        memset(long4200, 'c', 4200);
        long4200[0] = '/'; long4200[4200] = 0;
        ck_nn(cxn_init(long4200, 0, 0) < 0 && cxn_dir_get() == 0 && cxn_cache_allowed() == 0, "explicit-overlong-4200-refused");
        setenv("UNISACC_NN_DIR", long4200, 1);
        ck_nn(cxn_boot(0, 0, 0, why, sizeof why) < 0 && cxn_dir_get() == 0, "env-overlong-4200-refused");
        unsetenv("UNISACC_NN_DIR");
        long4200[4190] = '/';
        ck_nn(cxn_init(0, 0, long4200) < 0 && cxn_cache_allowed() == 0, "beside-overlong-4200-refused");
    }

    unsigned char *real_e2 = 0;
    long real_e2_n = 0;
    ck_nn(extract_real_stage("./unisacc.com", "e2", &real_e2, &real_e2_n) == 0 && real_e2_n > 32, "extract-real-e2-uninetb1n");

    /* Sealed closure, stage validation, UNPROBED refusal, and 5-state machine checks */
    cxn_boot(dir, 0, 0, why, sizeof why);
    ck_nn(cxn_dir_present() == 1 && cxn_cache_allowed() == 0, "unsealed-dir-cache-forbidden");
    cxn_destroy();
    {
        int fa = sy_open_dir_nofollow(dir);
        if (fa >= 0) sy_close(fa);
        ck_nn(cxn_boot(dir, 0, 0, why, sizeof why) == 0 && cxn_dir_present() == 1, "dfd-leak-boot");
        cxn_destroy();
        int fb = sy_open_dir_nofollow(dir);
        if (fb >= 0) sy_close(fb);
        ck_nn(fa >= 0 && fb == fa, "dfd-closed-on-destroy");

        int s0 = dup(0);
        if (s0 >= 0) {
            close(0);
            int brc = cxn_boot(dir, 0, 0, why, sizeof why);
            cxn_destroy();
            int f0 = sy_open_dir_nofollow(dir);
            if (f0 >= 0) sy_close(f0);
            dup2(s0, 0);
            close(s0);
            ck_nn(brc == 0 && f0 == 0, "dfd-zero-closed-on-destroy");
        }
    }
    cxn_boot(dir, 0, 0, why, sizeof why);
    ck_nn(cxn_probe_stage(0, why, sizeof why) != 0 && cxn_cache_allowed() == 0, "null-stage-name-refused");
    cxn_boot(dir, 0, 0, why, sizeof why);
    ck_nn(cxn_probe_stage("", why, sizeof why) != 0 && cxn_cache_allowed() == 0, "empty-stage-name-refused");
    cxn_boot(dir, 0, 0, why, sizeof why);
    ck_nn(cxn_probe_stage("BAD$STAGE", why, sizeof why) != 0 &&
          has_bytes(cxn_why(), strlen(cxn_why()), "invalid") && cxn_cache_allowed() == 0, "invalid-stage-name-refused");
    cxn_boot(dir, 0, 0, why, sizeof why);
    ck_nn(cxn_probe_stage("e2", why, sizeof why) == 0 && cxn_probe_stage("e2", why, sizeof why) == 0 &&
          cxn_cache_allowed() == 0, "pre-seal-after-probe-cache-forbidden");
    ck_nn(cxn_try_load("e2", &mb, &mn, &raw, &crc, &compressed, ex_crc32_test) == 3, "unsealed-try-load-refused");
    cxn_boot(dir, 0, 0, why, sizeof why);
    ck_nn(cxn_probe_route(route_along_two, "lnx/x86_64/image/O0", why, sizeof why) == 0, "probe-route-dedups-ok");

    cxn_boot(dir, 0, 0, why, sizeof why);
    ck_nn(cxn_probe_stage("e2", why, sizeof why) == 0 && cxn_seal() == 0 && cxn_dir_present() == 0 && cxn_cache_allowed() == 1,
          "sealed-all-absent-cache-allowed");
    ck_nn(cxn_try_load("e2", &mb, &mn, &raw, &crc, &compressed, ex_crc32_test) == 2, "sealed-absent-fallback-builtin");
    ck_nn(cxn_try_load("e1", &mb, &mn, &raw, &crc, &compressed, ex_crc32_test) == 3 && cxn_cache_allowed() == 0,
          "unprobed-stage-refused-never-absent");

    cxn_boot(dir, 0, 0, why, sizeof why);
    ck_nn(cxn_probe_stage("e2", why, sizeof why) == 0 && cxn_seal() == 0 && cxn_probe_stage("e1", why, sizeof why) != 0 &&
          cxn_cache_allowed() == 0, "probe-after-seal-refused");

    /* Truncated < 9 bytes and > 32 stage cap checks */
    ck_nn(write_file_bytes(nb, (const unsigned char *)"UNIN", 4) == 0, "write-trunc4-nb");
    ck_nn(cxn_boot(dir, 0, 0, why, sizeof why) == 0 && cxn_probe_stage("e2", why, sizeof why) != 0 && cxn_seal() != 0,
          "truncated-4b-refused");
    (void)sy_unlink(nb);

    cxn_boot(dir, 0, 0, why, sizeof why);
    {
        int cap_ok = 1;
        char snm[24];
        for (int k = 0; k < 32; k++) {
            cx_fmt(snm, sizeof snm, "s%d", k);
            if (cxn_probe_stage(snm, why, sizeof why) != 0) cap_ok = 0;
        }
        ck_nn(cap_ok && cxn_probe_stage("s0", why, sizeof why) == 0 &&
              cxn_probe_stage("s32", why, sizeof why) != 0 &&
              has_bytes(why, strlen(why), "stage limit exceeded") &&
              cxn_probe_stage("s33", why, sizeof why) != 0, "snap-32-stage-cap-enforced");
    }

    /* Dir O_NOFOLLOW symlink (-ELOOP, incl. trailing slash), ENOTDIR, stage O_NOFOLLOW symlink (-ELOOP), and FIFO non-hang */
    {
        char sym_dir[4400], sym_dir_slash[4410], dir_slash[4210], notdir[4200], sym_target[4500];
        cx_fmt(sym_dir, sizeof sym_dir, "%s/sym_dir", base_dir);
        cx_fmt(sym_dir_slash, sizeof sym_dir_slash, "%s/sym_dir/", base_dir);
        cx_fmt(dir_slash, sizeof dir_slash, "%s/", dir);
        cx_fmt(cmd, sizeof cmd, "ln -sfn '%s' '%s'", dir, sym_dir);
        run_sh(".", cmd, 10, &r); np_free(&r);
        int dr1 = sy_open_dir_nofollow(sym_dir);
        int dr2 = sy_open_dir_nofollow(sym_dir_slash);
        if (dr1 >= 0) sy_close(dr1);
        if (dr2 >= 0) sy_close(dr2);
        ck_nn((dr1 == -ELOOP || dr1 == -ENOTDIR) &&
              cxn_boot(sym_dir, 0, 0, why, sizeof why) != 0 &&
              (has_bytes(why, strlen(why), "-ELOOP") || has_bytes(why, strlen(why), "-ENOTDIR")) &&
              (has_bytes(cxn_why(), strlen(cxn_why()), "-ELOOP") || has_bytes(cxn_why(), strlen(cxn_why()), "-ENOTDIR")) &&
              cxn_cache_allowed() == 0, "dir-symlink-nofollow-refused");
        ck_nn((dr2 == -ELOOP || dr2 == -ENOTDIR) &&
              cxn_boot(sym_dir_slash, 0, 0, why, sizeof why) != 0 &&
              (has_bytes(why, strlen(why), "-ELOOP") || has_bytes(why, strlen(why), "-ENOTDIR")) && cxn_cache_allowed() == 0, "dir-symlink-trailing-slash-nofollow-refused");
        {
            int df_sl = sy_open_dir_nofollow(dir_slash);
            if (df_sl >= 0) sy_close(df_sl);
            ck_nn(df_sl >= 0 && cxn_boot(dir_slash, 0, 0, why, sizeof why) == 0 && cxn_dir_present() == 1, "real-dir-trailing-slash-ok");
        }

        cx_fmt(notdir, sizeof notdir, "%s/not_a_dir", base_dir);
        ck_nn(write_file_bytes(notdir, (const unsigned char *)"file", 4) == 0, "write-nondir");
        ck_nn(cxn_boot(notdir, 0, 0, why, sizeof why) != 0 && cxn_cache_allowed() == 0, "nondir-enotdir-refused");

        if (real_e2) {
            cx_fmt(sym_target, sizeof sym_target, "%s/real_target_e2.nb", base_dir);
            ck_nn(write_file_bytes(sym_target, real_e2, real_e2_n) == 0, "write-stage-sym-target");
            cx_fmt(cmd, sizeof cmd, "ln -sf '%s' '%s'", sym_target, nb);
            run_sh(".", cmd, 10, &r); np_free(&r);
            ck_nn(cxn_boot(dir, 0, 0, why, sizeof why) == 0 && cxn_probe_stage("e2", why, sizeof why) != 0 &&
                  has_bytes(why, strlen(why), "-ELOOP") && cxn_seal() != 0 && cxn_cache_allowed() == 0, "stage-symlink-eloop-refused");
            cx_fmt(cmd, sizeof cmd, "rm -f '%s'", nb);
            run_sh(".", cmd, 10, &r); np_free(&r);
        }

        cx_fmt(cmd, sizeof cmd, "rm -f '%s' && mkfifo '%s'", nb, nb);
        run_sh(".", cmd, 10, &r); np_free(&r);
        ck_nn(cxn_boot(dir, 0, 0, why, sizeof why) == 0 && cxn_probe_stage("e2", why, sizeof why) != 0 &&
              cxn_try_load("e2", &mb, &mn, &raw, &crc, &compressed, ex_crc32_test) == 3 &&
              cxn_cache_allowed() == 0, "fifo-nonregular-refused");
        cx_fmt(cmd, sizeof cmd, "rm -f '%s'", nb);
        run_sh(".", cmd, 10, &r); np_free(&r);
    }

    /* Beside valid real model + formal-chain overrides */
    {
        char beside_nn[4400], beside_e2[4500], fake_exe[4200];
        cx_fmt(fake_exe, sizeof fake_exe, "%s/fakebin/tool", base_dir);
        cx_fmt(beside_nn, sizeof beside_nn, "%s/fakebin/nn", base_dir);
        cx_fmt(beside_e2, sizeof beside_e2, "%s/e2.nb", beside_nn);
        ck_nn(real_e2 != 0 && write_file_bytes(beside_e2, real_e2, real_e2_n) == 0, "write-beside-real-e2");
        ck_nn(cxn_init(0, 0, fake_exe) == 1 && cxn_probe_stage("e2", why, sizeof why) == 0 &&
              cxn_seal() == 0 && cxn_cache_allowed() == 0,
              "beside-active-real-nb-forbids-cache");

        {
            static const char *const fc_vars[] = {
                "UNISACC_NN_MODE", "UNISACC_PHASE", "UNISACC_CTOR",
                "UNISACC_CHAIN_TOOLS_EPOCH", "UNISACC_CHAIN_PHASE_BOUND_S",
                "UNISACC_CHAIN_SHAMEMO", "UNISACC_IDENTITY_HELPER"
            };
            static const char *const fc_vals[] = {
                "builtin", "build", "/tmp/ctor", "1", "60", "/tmp/shamemo", "/tmp/idhelper"
            };
            int fc_ok = 1;
            for (int fi = 0; fi < 7; fi++) {
                setenv(fc_vars[fi], fc_vals[fi], 1);
                if (cxn_boot(dir, 0, 0, why, sizeof why) != 0 || cxn_dir_get() != 0 || cxn_cache_allowed() != 1) fc_ok = 0;
                unsetenv(fc_vars[fi]);
            }
            setenv("UNISACC_NN_MODE", "external", 1);
            if (cxn_boot(dir, 0, 0, why, sizeof why) != 0 || cxn_dir_present() != 1) fc_ok = 0;
            unsetenv("UNISACC_NN_MODE");
            ck_nn(fc_ok, "formal-chain-all-envs-force-builtin");
        }

        ck_nn(cxn_boot(0, 0, "/some/pkg.bin", why, sizeof why) == 0 && cxn_dir_get() == 0, "models-pkg-forces-builtin");

        setenv("UNISA_CONTAINER", "/some/pkg.bin", 1);
        ck_nn(cxn_boot(0, 0, 0, why, sizeof why) == 0 && cxn_dir_get() == 0, "container-pkg-forces-builtin");
        setenv("UNISA_CONTAINER", "./unisacc.com", 1);
        unsetenv("UNISACC_APE_SELF");
        ck_nn(cxn_boot(dir, 0, 0, why, sizeof why) == 0 && cxn_dir_get() == 0, "container-named-unisacc-com-needs-launcher-marker");
        setenv("UNISACC_APE_SELF", "./some-other.com", 1);
        ck_nn(cxn_boot(dir, 0, 0, why, sizeof why) == 0 && cxn_dir_get() == 0, "mismatched-container-marker-stays-disabled");
        setenv("UNISA_CONTAINER", beside_e2, 1);
        setenv("UNISACC_APE_SELF", beside_e2, 1);
        ck_nn(cxn_boot(dir, 0, 0, why, sizeof why) == 0 && cxn_dir_get() == 0, "matching-model-path-is-not-shell-ape");
        setenv("UNISA_CONTAINER", "./missing-outer", 1);
        setenv("UNISACC_APE_SELF", "./missing-outer", 1);
        ck_nn(cxn_boot(0, 0, 0, why, sizeof why) < 0 &&
            tx_eqz(why, "external nn APE launch path cannot be resolved"), "matching-missing-ape-path-refused");
        unsetenv("UNISA_CONTAINER");
        ck_nn(cxn_boot(dir, 0, 0, why, sizeof why) == 0 && cxn_dir_present() == 1, "raw-entry-ignores-unpaired-marker");
        if (e2e_cand && is_launch_ape(e2e_cand)) {
            setenv("UNISA_CONTAINER", e2e_cand, 1);
            setenv("UNISACC_APE_SELF", e2e_cand, 1);
            ck_nn(cxn_boot(dir, 0, 0, why, sizeof why) == 0 && cxn_dir_present() == 1, "launcher-matched-ape-allows-explicit");
        }
        setenv("UNISACC_PHASE", "A", 1);
        ck_nn(cxn_boot(dir, 0, 0, why, sizeof why) == 0 && cxn_dir_get() == 0, "chain-env-wins-over-launcher");
        unsetenv("UNISACC_PHASE");
        ck_nn(cxn_boot(dir, 0, "/some/pkg.bin", why, sizeof why) == 0 &&
            cxn_dir_get() == 0, "models-win-over-launcher");
        unsetenv("UNISACC_APE_SELF"); unsetenv("UNISA_CONTAINER");
    }

    /* Corrupt magic refused before cache */
    cxn_boot(dir, 0, 0, why, sizeof why);
    ck_nn(write_file_bytes(nb, (const unsigned char *)"BADMAGIC!", 9) == 0, "write-bad-nb");
    ck_nn(cxn_probe_stage("e2", why, sizeof why) != 0 && cxn_cache_allowed() == 0, "probe-corrupt-magic-refused-before-cache");
    ck_nn(cxn_try_load("e2", &mb, &mn, &raw, &crc, &compressed, ex_crc32_test) == 3, "corrupt-nb-refused");

    if (real_e2) {
        unsigned want_crc = ex_crc32_test((char *)real_e2, (int)real_e2_n);
        char nb_tmp[4500];
        cxn_boot(dir, 0, 0, why, sizeof why);
        ck_nn(write_file_bytes(nb, real_e2, real_e2_n) == 0, "write-real-e2");
        ck_nn(cxn_probe_stage("e2", why, sizeof why) == 0 && cxn_seal() == 0 && cxn_cache_allowed() == 0,
              "explicit-real-e2-forbids-cache");
        rc = cxn_try_load("e2", &mb, &mn, &raw, &crc, &compressed, ex_crc32_test);
        ck_nn(rc == 0 && compressed == 2 && mn == real_e2_n && crc == want_crc && !memcmp(mb, real_e2, (size_t)real_e2_n),
              "external-real-e2-load-exact");

        /* Direct unit coverage of cxn_stream_seal (stream single-seal helper) */
        ck_nn(cxn_stream_seal(dir, 0, 0, "e2", why, sizeof why) == 0 && cxn_cache_allowed() == 0 &&
              cxn_try_load("e2", &mb, &mn, &raw, &crc, &compressed, ex_crc32_test) == 0, "stream-seal-ext-loads-exact");
        ck_nn(cxn_stream_seal(dir, 1, 0, "e2", why, sizeof why) == 0 && cxn_cache_allowed() == 1 &&
              cxn_try_load("e2", &mb, &mn, &raw, &crc, &compressed, ex_crc32_test) == 2, "stream-seal-noext-builtin");

        /* Direct unit coverage of B2 runsplit.cx:308 and runsplit.cx:467 guards */
        {
            char uo_base[4300], uo_sub[4400], sha64[65];
            const char *srcs[2] = {"a.cx", "b.cx"};
            unsigned char *img = 0;
            long imgn = 0;
            cx_fmt(uo_base, sizeof uo_base, "%s/unit_rspl_cache", base_dir);
            cx_fmt(uo_sub, sizeof uo_sub, "%s/unitobj", uo_base);
            mm_fill(sha64, 64, 'a', 64); sha64[64] = 0;
            setenv("UNISACC_CACHE_DIR", uo_base, 1);
            setenv("UNISACC_RUN_SPLIT", "1", 1);

            ck_nn(cxn_boot(dir, 0, 0, why, sizeof why) == 0 && cxn_probe_stage("e2", why, sizeof why) == 0 &&
                  cxn_seal() == 0 && cxn_cache_allowed() == 0, "unit-rspl-arm-ext");
            ck_nn(rspl_drive("./unisacc.com", "lnx/x86_64", 1, 2, srcs, stub_rspl_reset, stub_rspl_span,
                             stub_rspl_put, stub_rspl_pop, stub_rspl_inc, stub_rspl_obj, &img, &imgn) == 1,
                  "unit-rspl-drive-ext-returns-1");
            (void)rspl_try(sha64, "lnx/x86_64", 1, 2, srcs, stub_rspl_inc, stub_rspl_compile_clo, &img, &imgn);
            cx_fmt(cmd, sizeof cmd, "[ -z \"$(find '%s' -type f 2>/dev/null)\" ]", uo_sub);
            run_sh(".", cmd, 10, &r);
            ck_nn(r.rc == 0, "unit-rspl-try-ext-writes-0-unitobj");
            np_free(&r);

            /* Positive control: when ABSENT & sealed (cxn_cache_allowed()==1), rspl_try DOES write closure unitobj and rspl_drive reaches compile! */
            ck_nn(cxn_boot(dir, 1, 0, why, sizeof why) == 0 && cxn_cache_allowed() == 1, "unit-rspl-arm-builtin");
            (void)rspl_try(sha64, "lnx/x86_64", 1, 2, srcs, stub_rspl_inc, stub_rspl_compile_clo, &img, &imgn);
            cx_fmt(cmd, sizeof cmd, "[ \"$(find '%s' -type f 2>/dev/null | wc -l)\" -ge 1 ]", uo_sub);
            run_sh(".", cmd, 10, &r);
            ck_nn(r.rc == 0, "unit-rspl-try-builtin-writes-unitobj");
            np_free(&r);
            ck_nn(rspl_drive("./unisacc.com", "lnx/x86_64", 1, 2, srcs, stub_rspl_reset, stub_rspl_span,
                             stub_rspl_put, stub_rspl_pop, stub_rspl_inc, stub_rspl_obj, &img, &imgn) == 2,
                  "unit-rspl-drive-builtin-reaches-compile");
            unsetenv("UNISACC_CACHE_DIR");
            unsetenv("UNISACC_RUN_SPLIT");
            (void)stub_rspl_compile_fail;
        }

        /* Sticky bits MUST survive cxn_close() (drive.cx pm_close before dv_finish rc_store_elf!) */
        ck_nn(cxn_boot(dir, 0, 0, why, sizeof why) == 0 && cxn_probe_stage("e2", why, sizeof why) == 0 &&
              cxn_seal() == 0, "pre-cxn-close-arm-ext");
        cxn_close();
        ck_nn(cxn_cache_allowed() == 0, "after-cxn-close-cache-still-forbidden");

        /* Double-compile clean reset */
        cxn_destroy();
        ck_nn(cxn_boot(dir, 1, 0, why, sizeof why) == 0 && cxn_seal() == 0 && cxn_cache_allowed() == 1 &&
              cxn_try_load("e2", &mb, &mn, &raw, &crc, &compressed, ex_crc32_test) == 2,
              "double-compile-clean-reset");

        /* Atomic rename replacement after probe+seal preserves one-shot immutable snapshot */
        cx_fmt(nb_tmp, sizeof nb_tmp, "%s.tmp_toctou", nb);
        cxn_boot(dir, 0, 0, why, sizeof why);
        ck_nn(cxn_probe_stage("e2", why, sizeof why) == 0 && cxn_seal() == 0, "snapshot-probe-seal");
        ck_nn(write_file_bytes(nb_tmp, (const unsigned char *)"BADMAGIC!", 9) == 0, "snapshot-stage-bad-tmp");
        cx_fmt(cmd, sizeof cmd, "mv -f '%s' '%s'", nb_tmp, nb);
        run_sh(".", cmd, 10, &r);
        ck_nn(r.rc == 0, "snapshot-atomic-replace-after-seal");
        np_free(&r);
        rc = cxn_try_load("e2", &mb, &mn, &raw, &crc, &compressed, ex_crc32_test);
        ck_nn(rc == 0 && mn == real_e2_n && crc == want_crc && !memcmp(mb, real_e2, (size_t)real_e2_n),
              "snapshot-immutable-survives-atomic-replace");

        /* Documented contract boundary: same-size in-place overwrite without rename */
        {
            unsigned char *same_sz = (unsigned char *)malloc((size_t)real_e2_n);
            int dok = 0;
            if (same_sz) {
                ck_nn(write_file_bytes(nb, real_e2, real_e2_n) == 0, "unsupported-restore-real");
                cxn_boot(dir, 0, 0, why, sizeof why);
                cxn_probe_stage("e2", why, sizeof why);
                cxn_seal();
                mm_copy(same_sz, real_e2_n, real_e2, real_e2_n);
                same_sz[real_e2_n - 1] = (unsigned char)(same_sz[real_e2_n - 1] ^ 1u);
                if (write_file_bytes(nb, same_sz, real_e2_n) == 0) {
                    rc = cxn_try_load("e2", &mb, &mn, &raw, &crc, &compressed, ex_crc32_test);
                    dok = (rc == 0 && !memcmp(mb, real_e2, (size_t)real_e2_n));
                }
                free(same_sz);
            }
            ck_nn(dok, "same-size-inplace-overwrite-unsupported-documented");
            printf("INFO\tsame-size-inplace-overwrite\tUNSUPPORTED-DOCUMENTED\tnot-detected-per-contract\n");
        }

        /* Absent sealed snapshot ignores late atomic drop */
        (void)sy_unlink(nb);
        cxn_boot(dir, 0, 0, why, sizeof why);
        ck_nn(cxn_probe_stage("e2", why, sizeof why) == 0 && cxn_seal() == 0 && cxn_cache_allowed() == 1, "absent-sealed-cache-allowed");
        ck_nn(write_file_bytes(nb, real_e2, real_e2_n) == 0, "absent-late-atomic-write");
        rc = cxn_try_load("e2", &mb, &mn, &raw, &crc, &compressed, ex_crc32_test);
        ck_nn(rc == 2 && cxn_cache_allowed() == 1, "absent-sealed-ignores-late-atomic-drop");

        /* Missing dir snapshot ignores late mkdir + model drop */
        {
            char late_dir[4300], late_nb[4400];
            cx_fmt(late_dir, sizeof late_dir, "%s/late_nn", base_dir);
            cx_fmt(late_nb, sizeof late_nb, "%s/e2.nb", late_dir);
            ck_nn(cxn_boot(late_dir, 0, 0, why, sizeof why) == 0 && cxn_cache_allowed() == 1, "missing-dir-sealed-builtin");
            cx_fmt(cmd, sizeof cmd, "mkdir -p '%s'", late_dir);
            run_sh(".", cmd, 10, &r); np_free(&r);
            ck_nn(write_file_bytes(late_nb, real_e2, real_e2_n) == 0, "missing-dir-late-write");
            rc = cxn_try_load("e2", &mb, &mn, &raw, &crc, &compressed, ex_crc32_test);
            ck_nn(rc == 2 && cxn_cache_allowed() == 1, "missing-dir-sealed-ignores-late-mkdir-drop");
        }
    }

    if (e2e_cand && real_e2) {
        int ape = is_launch_ape(e2e_cand);
        ck_nn(ape, "e2e-requires-packed-shell-ape");
        if (ape) setenv("XDG_CACHE_HOME", base_dir, 1);
        if (ape) run_e2e(e2e_cand, base_dir, real_e2, real_e2_n);
    }

    if (real_e2) free(real_e2);
    cxn_destroy();
    (void)sy_remove_all(base_dir);
    printf("CHECK_NN_EXTERNAL\tfailed=%d\n", g_fail);
    if (!e2e_cand) {
        printf("E2E_LAYER\tstatus=UNMEASURED\trun_with=--e2e CANDIDATE_PATH\n");
    } else if (g_fail) {
        printf("E2E_LAYER\tstatus=FAIL\tcand=%s\n", e2e_cand);
    } else if (g_unmeasured) {
        printf("E2E_LAYER\tstatus=UNMEASURED\tunmeasured=%d\tcand=%s\n", g_unmeasured, e2e_cand);
    } else {
        printf("E2E_LAYER\tstatus=PASS\tcand=%s\n", e2e_cand);
    }
    return (g_fail || (e2e_cand && g_unmeasured)) ? 1 : 0;
}
