/* P3 framing, DEFLATE extents, CRC and binary-network structure. */
#pragma unisa use runtime.packagestruct
#pragma unisa use runtime.packagefooter
#pragma unisa use runtime.model_payload
#pragma unisa use runtime.network_structure
static int visit(void *ctx, const unsigned char *p, long n, long raw, unsigned long crc) {
    int *count = (int *)ctx;
    if (cxmp_audit_with(p,n,raw,(unsigned)crc,cxns_audit)) return 2;
    (*count)++;
    return 0;
}
int main(int argc, char **argv) {
    size_t n; char *bytes; const unsigned char *data; long length; int ver=0, count=0, rc;
    if (argc != 2) { fputs("payload-audit: usage PACKAGE\n",stderr); return 2; }
    bytes=cx_read(argv[1],&n);
    if (!bytes || n>2147483647UL) { free(bytes); fputs("payload-audit: read\n",stderr); return 2; }
    data=(const unsigned char *)bytes; length=(long)n;
    if (n<2 || bytes[0]!='P' || bytes[1]!=' ') {
        PackageFooter f;
        if (!packagefooter_locate_bytes(data,length,&f)) { free(bytes); fputs("payload-audit: footer\n",stderr); return 2; }
        data+=(long)f.package_offset; length=(long)f.package_length;
    }
    rc=cxps_models(data,length,&ver,visit,&count);
    free(bytes);
    if (rc || ver!=3) { fputs("payload-audit: model-or-structure\n",stderr); return 1; }
    printf("CXPAYLOAD_AUDIT\tP3\t%d\n",count);
    return 0;
}
