/* tools/s9-shards-flow.cx -- 把 s9 待跑片交给 devsvc flow 并行驱动;本工具只发表与跑单片节点,不做裁决。
 *   sh ./unisacc.com tools/s9-shards-flow.cx -- emit ROOT RUN [--class light|heavy|alone|all] [--par N] [--out FILE] [--driver BIN]
 *   sh ./unisacc.com tools/s9-shards-flow.cx -- node ROOT RUN LEAF [--driver BIN]
 * emit: 核 driver 与其 .sha256 一致后调 `driver pending ROOT RUN`(与 aggregate 同一 pending 判定),每个待跑片出一行
 *   exec 节点(无依赖);表首行 `par N`:light 与 all 缺省 8,heavy 取 limits 的 s9.heavy.width,alone 为 1。
 *   末行 S9_FLOW pending= emitted= class= par=(给了 --out 时打到 stdout,否则打到 stderr,stdout 只有节点表)。
 *   用法: emit --out T.tsv 后 `devsvc flow run T.tsv --par N --bg` 再 wait;先 light,再 heavy,再 alone,每轮后重发表。
 * node: 给 driver 55 秒的 UNISACC_BOUND_DEADLINE_MONO,跑 `driver step ROOT RUN --slice LEAF`,输出原样带回。
 *   片的 DONE 已落盘(DONE_RECORDED 或 ALREADY_DONE)退出 0;STEP_NO_PROGRESS 退出 4;其余按 driver 退出码,0 与 3 以外原样,否则 1。
 *   退出 0 只表示该片已执行并留下收据,通过与否只由 `driver aggregate` 判定;写栅栏、heavy 上限、身份与冻结核验都在 driver 内,本工具不绕过。
 */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.allsession
#pragma unisa use cxlib.limits

#define SF_MAX 2048
#define SF_GRANT_S 55
typedef struct { char leaf[80]; int alone, heavy, budget; } sf_row;
static sf_row rows[SF_MAX];
static int nrows;
static char why[512];

static void refuse(const char *s, const char *d) { fprintf(stderr, "s9-shards-flow: REFUSE %s %s\n", s, d ? d : ""); exit(2); }

static void driver_identity(const char *driver) {
    char hp[4600], h[65];
    size_t n;
    char *want;
    if (cx_fmt(hp, sizeof hp, "%s.sha256", driver)) refuse("path-bound", driver);
    want = as_read(hp, 0, &n, why, sizeof why);
    if (!want || n != 65 || want[64] != '\n') refuse("driver-sha-record", hp);
    if (as_sha_file(driver, 0, h, 0, why, sizeof why) || memcmp(h, want, 64)) refuse("driver-sha", driver);
    free(want);
}

static int run_driver(char **v, const char *root, np_result *r) {
    char env[96];
    char *envadd[2];
    sy_ts_t t;
    if (sy_mono(&t) || cx_fmt(env, sizeof env, "UNISACC_BOUND_DEADLINE_MONO=%.9f", (double)t.sec + (double)t.nsec / 1e9 + SF_GRANT_S)) refuse("deadline-env", 0);
    envadd[0] = env; envadd[1] = 0;
    if (np_run(v, root, envadd, SF_GRANT_S + 2, r, why, sizeof why)) refuse("driver-transport", why);
    return r->rc;
}

static int field_int(const char *line, const char *key) {
    size_t n = strlen(line), z = strlen(key);
    for (size_t i = 0; z && i + z <= n; i++) if (!memcmp(line + i, key, z)) return atoi(line + i + z);
    return -1;
}

static int contains(const char *s, size_t n, const char *needle) {
    size_t z = strlen(needle);
    for (size_t i = 0; i + z <= n; i++) if (!memcmp(s + i, needle, z)) return 1;
    return 0;
}

static int emit(int argc, char **argv) {
    const char *root = argv[2], *run = argv[3], *cls = "all", *out = 0, *driver_opt = 0;
    char driver[4400], self[4400], com[4400];
    int par = 0, summary = -1, emitted = 0;
    np_result r = {0};
    np_buf t = {0};
    for (int i = 4; i < argc; i++) {
        if (!strcmp(argv[i], "--class") && i + 1 < argc) cls = argv[++i];
        else if (!strcmp(argv[i], "--par") && i + 1 < argc) par = atoi(argv[++i]);
        else if (!strcmp(argv[i], "--out") && i + 1 < argc) out = argv[++i];
        else if (!strcmp(argv[i], "--driver") && i + 1 < argc) driver_opt = argv[++i];
        else refuse("emit-argument", argv[i]);
    }
    if (strcmp(cls, "all") && strcmp(cls, "light") && strcmp(cls, "heavy") && strcmp(cls, "alone")) refuse("class", cls);
    if (root[0] != '/' || run[0] != '/') refuse("absolute-root-and-run", 0);
    if (cx_fmt(driver, sizeof driver, "%s%s", driver_opt ? driver_opt : run, driver_opt ? "" : "/driver") ||
        cx_fmt(self, sizeof self, "%s/tools/s9-shards-flow.cx", root) || cx_fmt(com, sizeof com, "%s/unisacc.com", root)) refuse("path-bound", 0);
    driver_identity(driver);
    {
        char *v[] = {driver, "pending", (char *)root, (char *)run, 0};
        int rc = run_driver(v, root, &r);
        if (rc) { if (r.outn) fwrite(r.out, 1, r.outn, stderr); if (r.errn) fwrite(r.err, 1, r.errn, stderr); fprintf(stderr, "s9-shards-flow: REFUSE pending-listing rc=%d\n", rc); return 2; }
    }
    for (size_t at = 0; at < r.outn;) {
        size_t e = at;
        char line[400];
        while (e < r.outn && r.out[e] != '\n') e++;
        if (e - at < sizeof line) {
            if (e > at && mm_copy(line, (long)sizeof line, r.out + at, (long)(e - at))) refuse("line-copy", 0);
            line[e - at] = 0;
            if (!strncmp(line, "S9_PENDING\tslice=", 17)) {
                sf_row *x;
                size_t z = 0;
                const char *q = line + 17;
                if (nrows == SF_MAX) refuse("pending-rows", 0);
                x = &rows[nrows++];
                while (q[z] && q[z] != '\t' && z + 1 < sizeof x->leaf) { char c = q[z]; if (c == ';' || c == '=' || c == '/' || c == ' ') refuse("slice-name", line); x->leaf[z] = c; z++; }
                x->leaf[z] = 0;
                x->alone = field_int(line, "\talone="); x->heavy = field_int(line, "\theavy="); x->budget = field_int(line, "\tbudget=");
                if (!z || x->alone < 0 || x->heavy < 0 || x->budget < 0) refuse("pending-wire", line);
            } else if (!strncmp(line, "S9_PENDING_SUMMARY\tpending=", 27)) summary = atoi(line + 27);
        }
        at = e + 1;
    }
    np_free(&r);
    if (summary != nrows) refuse("pending-summary-mismatch", 0);
    if (par <= 0) {
        if (!strcmp(cls, "alone")) par = 1;
        else if (!strcmp(cls, "heavy")) { par = (int)lm_get("s9.heavy.width", 0); if (par < 1) par = 1; }
        else par = 8;
    }
    if (par > 32) refuse("par", 0);
    { char ln[64]; if (cx_fmt(ln, sizeof ln, "par %d\n", par)) refuse("format-bound", 0); np_puts(&t, ln); }
    for (int i = 0; i < nrows; i++) {
        const sf_row *x = &rows[i];
        int k = x->alone ? 2 : x->heavy ? 1 : 0;
        if ((!strcmp(cls, "light") && k != 0) || (!strcmp(cls, "heavy") && k != 1) || (!strcmp(cls, "alone") && k != 2)) continue;
        np_puts(&t, x->leaf); np_puts(&t, "\texec\t-\ta0=sh;a1="); np_puts(&t, com); np_puts(&t, ";a2="); np_puts(&t, self);
        np_puts(&t, ";a3=--;a4=node;a5="); np_puts(&t, root); np_puts(&t, ";a6="); np_puts(&t, run); np_puts(&t, ";a7="); np_puts(&t, x->leaf);
        if (driver_opt) { np_puts(&t, ";a8=--driver;a9="); np_puts(&t, driver_opt); }
        np_puts(&t, ";cwd="); np_puts(&t, root); np_puts(&t, ";timeout_ms=58000\n");
        emitted++;
    }
    if (out) { if (cx_write(out, t.p, (long)t.n)) refuse("table-write", out); }
    else if (t.n) fwrite(t.p, 1, t.n, stdout);
    fprintf(out ? stdout : stderr, "S9_FLOW\tpending=%d\temitted=%d\tclass=%s\tpar=%d\tgrant_s=%d\ttable=%s\n", nrows, emitted, cls, par, SF_GRANT_S, out ? out : "-");
    free(t.p);
    return 0;
}

static int node(int argc, char **argv) {
    const char *root = argv[2], *run = argv[3], *leaf = argv[4], *driver_opt = 0;
    char driver[4400], mark[200];
    np_result r = {0};
    long t0 = sy_now_ms();
    int rc, result;
    if (argc == 7 && !strcmp(argv[5], "--driver")) driver_opt = argv[6];
    else if (argc != 5) refuse("node ROOT RUN LEAF [--driver BIN]", 0);
    if (root[0] != '/' || run[0] != '/') refuse("absolute-root-and-run", 0);
    if (cx_fmt(driver, sizeof driver, "%s%s", driver_opt ? driver_opt : run, driver_opt ? "" : "/driver")) refuse("path-bound", 0);
    driver_identity(driver);
    {
        char *v[] = {driver, "step", (char *)root, (char *)run, "--slice", (char *)leaf, 0};
        rc = run_driver(v, root, &r);
    }
    if (r.outn) fwrite(r.out, 1, r.outn, stdout);
    if (r.errn) fwrite(r.err, 1, r.errn, stderr);
    if (cx_fmt(mark, sizeof mark, "S9\tSTEP_SLICE\tslice=%s\tstatus=DONE_RECORDED\n", leaf)) refuse("format-bound", 0);
    if (r.out && contains(r.out, r.outn, mark)) result = 0;
    else {
        if (cx_fmt(mark, sizeof mark, "S9\tSTEP_SLICE\tslice=%s\tstatus=ALREADY_DONE\n", leaf)) refuse("format-bound", 0);
        if (r.out && contains(r.out, r.outn, mark)) result = 0;
        else if (rc == 4 || (r.out && contains(r.out, r.outn, "S9\tSTEP_NO_PROGRESS"))) result = 4;
        else result = (rc == 0 || rc == 3) ? 1 : rc;
    }
    printf("S9_FLOW_NODE\tslice=%s\tresult=%s\tdriver_rc=%d\tms=%ld\n", leaf, result == 0 ? "DONE_RECORDED" : result == 4 ? "NO_PROGRESS" : "NOT_RECORDED", rc, sy_now_ms() - t0);
    np_free(&r);
    return result;
}

int main(int argc, char **argv) {
    if (argc >= 4 && !strcmp(argv[1], "emit")) return emit(argc, argv);
    if (argc >= 5 && !strcmp(argv[1], "node")) return node(argc, argv);
    fprintf(stderr, "usage: s9-shards-flow emit ROOT RUN [--class light|heavy|alone|all] [--par N] [--out FILE] [--driver BIN] | node ROOT RUN LEAF [--driver BIN]\n");
    return 2;
}
