static char out[262144];
static char *candidate_input="release/candidate.tsv";
static int rx(const char *a1, const char *a2, const char *a3, const char *tool) {
    char ex[4400], up[4400], tp[4400]; char *v[20]; int k = 0, rc; np_result r = {0}; char why[256];
    char *env[] = {pathenv, fakeenv, "RELEASE_EXEC_NO_EVENTS=1", "RELEASE_EXEC_POLL_MS=10", "RELEASE_EXEC_POLL_MAX=3", 0};
    char realenv[4200]; cx_fmt(realenv, sizeof realenv, "CHECK_RX_REAL=%s", root);
    char *env2[] = {pathenv, fakeenv, "RELEASE_EXEC_NO_EVENTS=1", "RELEASE_EXEC_POLL_MS=10", "RELEASE_EXEC_POLL_MAX=3", realenv, 0};
    cx_fmt(up, sizeof up, "%s/%s", root, leafs[0]); cx_fmt(tp, sizeof tp, "%s/%s", root, tool ? tool : "tools/release-exec.cx");
    cx_fmt(ex, sizeof ex, "%s/xout", td);
    v[k++]=tool?hookbin:execbin;
    v[k++] = "--execute"; v[k++] = candidate_input; v[k++] = "--layout"; v[k++] = lay;
    v[k++] = "--out"; v[k++] = ex; v[k++] = "--baseline"; v[k++] = "/nonexistent-baseline";
    if (a1) v[k++] = (char *)a1; if (a2) v[k++] = (char *)a2; if (a3) v[k++] = (char *)a3;
    v[k] = 0;
    out[0] = 0;
    if (np_run(v, fx, tool ? env2 : env, 55, &r, why, sizeof why)) { np_free(&r); return 125; }
    { size_t n = 0; for (size_t i = 0; i < r.outn && n + 1 < sizeof out; i++) out[n++] = r.out[i];
      for (size_t i = 0; i < r.errn && n + 1 < sizeof out; i++) out[n++] = r.err[i]; out[n] = 0; }
    rc = r.rc; np_free(&r);
    return rc;
}
/* assertion inputs are child output (cat of a fixture file the children wrote) */
static char *catf(const char *p) {
    np_result r = {0}; char why[200]; char *v[] = {"cat", "--", (char *)p, 0}; char *o;
    if (np_run(v, "/", 0, 10, &r, why, sizeof why) || r.rc) { np_free(&r); return 0; }
    o = malloc(r.outn + 1);
    if (o) { for (size_t i = 0; i < r.outn; i++) o[i] = r.out[i]; o[r.outn] = 0; }
    np_free(&r);
    return o;
}
static char *calls(void) { char p[4400]; cx_fmt(p, sizeof p, "%s/calls.log", td); return catf(p); }
/* every seq[i] is the prefix of a later line than seq[i-1] */
static int ordered(const char *t, const char **seq, int n) {
    long at = 0, L = tlen(t); int i = 0;
    while (i < n && at < L) {
        long e = tx_chr(t + at, L - at, '\n'), ll = e < 0 ? L - at : e, sn = tlen(seq[i]);
        if (ll >= sn && !memcmp(t + at, seq[i], (size_t)sn)) i++;
        at += ll + 1;
    }
    if (i < n) sy_printf("  missing in order: %s\n", seq[i]);
    return i == n;
}
static void expect_gate(const char *name, int rc, const char *gate) {
    char g[200]; cx_fmt(g, sizeof g, "release-exec: REFUSE RELEASE_EXEC_GATE_%s step=", gate);
    ck(rc == 2 && has(out, g), name);
    if (!(rc == 2 && has(out, g))) sy_printf("  rc=%d tail: %.400s\n", rc, out + (tlen(out) > 400 ? tlen(out) - 400 : 0));
}

/* N0: release-run before --execute existed, from a git archive of 85a2d3242e (read-only /tmp copy) */
static void part_n(void) {
