    fixture(99, 5, 0, 1); expect_gate("G1.dvqualify-count-differs", rx("--dry", 0, 0, 0), "EXPECTED_FAIL");
    fixture(98, 0, 0, 1); expect_gate("G1.ape-version-differs", rx("--dry", 0, 0, 0), "APE_VERSION");
    fixture(99, 0, 1, 1); expect_gate("G1.ratchets-fail", rx("--dry", 0, 0, 0), "RATCHETS");
    fixture(99, 0, 0, 1);
    put(fx,"release/evidence/0.0.99/ratchets.txt","# freeze=2222222222222222222222222222222222222222\nRATCHETS\tok=15\tfail=0\n");
    expect_gate("G1.ratchets-receipt-wrong-freeze",rx("--dry",0,0,0),"RATCHETS");
    { char p[4500], head[128], want[128];
      fixture(99,0,0,1);
      if(git("read-tree","HEAD",0,0,0,0,0) || git("rev-parse","HEAD",0,0,0,head,sizeof head))die("fixture freeze");
      cx_fmt(p,sizeof p,"%s/release/candidate.tsv",fx);char *table=slurp(p);
