      cx_fmt(p,sizeof p,"%s/release/evidence/0.0.99/ratchets.txt",fx);rmrf(p);
      candidate_input="freeze-candidate.tsv";
      rx("--dry",0,0,0);char *saved=slurp(p);
      cx_fmt(want,sizeof want,"# freeze=%s",head);
      ck(has(out,"source=frozen-HEAD") && saved && has(saved,want) && has(saved,"RATCHETS\tok=15\tfail=0"),"G1.dry-saves-freeze-ratchets");
      free(saved);candidate_input="release/candidate.tsv"; }
    fixture(99, 0, 0, 1); put(lay, "pkg.bin", "changed after the table\n");
    expect_gate("G2.asset-byte-change", rx("--dry", 0, 0, 0), "ASSETS");
