      ck(rc==0 && has(ix,"exec-3b-ci-dispatch-2") && has(ix,"superseded-by=777002") &&
         has(ix,"exec-3-ci-dispatch") && has(ix,"777001"),"G4.explicit-redispatch-keeps-old-run");free(ix);
      cx_fmt(p,sizeof p,"%s/replacement",td);sy_unlink(p);}
    fixture(99, 0, 0, 1);
