       !has(c, "gh -R example/fixture release delete") && !has(c, "unisacc tools/devsvc -- git commit -m v0.0.99 Y2"), "G5.rollback-executed-no-delete");
    free(c);
}

static int oracle(char **args,np_buf *result){
    char why[256];char *env[]={pathenv,fakeenv,0};np_result r={0};
    int rc=np_run(args,fx,env,55,&r,why,sizeof why)?125:r.rc;
    if(result && !rc)np_put(result,r.out,r.outn);
    if(rc && r.errn)sy_write_all(2,r.err,(long)r.errn);
    np_free(&r);return rc;
}
static void part_r(void){
    char image[4600],source[4600],table[4600],dest[4600],saved[4600],p[4600],q[4600],oldape[4600];
    char *steps[]={"metadata","tag","download","asset-sha","version","smoke","comm","layout-generate","layout-check","checksums","zip-members"};
    fixture(99,0,0,1);put(td,"state","false");put(td,"oldape","old");
    cx_fmt(oldape,sizeof oldape,"%s/oldape",td);cx_fmt(table,sizeof table,"%s/release/candidate.tsv",fx);
    cx_fmt(dest,sizeof dest,"%s/result",td);cx_fmt(saved,sizeof saved,"%s/whole",td);cx_fmt(image,sizeof image,"%s/oracle",td);
    cx_fmt(source,sizeof source,"%s/release/tools/c47-1-readback.cx",root);
    char *compile[]={"sh",(char*)leafs[0],source,"-o",image,0};if(sh(compile,root,0,0))die("readback build");
    cx_fmt(p,sizeof p,"%s/release/tools",fx);if(sy_mkdir(p,0700))die("fixture oracle dir");
    cx_fmt(q,sizeof q,"%s/c47-1-readback.cx",p);if(sy_copy(source,q,0600))die("fixture oracle");
    put(fx,"tools/chain-step.cx","smoke fixture");put(fx,"tools/check-run-comm.cx","comm fixture");put(fx,"tools/release-layout.cx","layout fixture");
    for(int i=0;i<6;i++){cx_fmt(p,sizeof p,"%s/%s",lay,leafs[i]);cx_fmt(q,sizeof q,"%s/remote/%s",td,leafs[i]);if(sy_copy(p,q,0600))die("fixture asset");}
    char *args[]={image,fx,table,dest,oldape,"false",0,0,0,0};
    np_buf whole={0},parts={0},replay={0};int rc=oracle(args,&whole);
    ck(!rc && whole.n && has(whole.p,"C47_1_READBACK PASS "),"readback.whole");
    if(sy_rename(dest,saved))die("save full evidence");
    args[6]="--step";args[7]=steps[1];ck(oracle(args,0)!=0,"readback.missing-prerequisite");
    for(int i=0;i<11 && !rc;i++){
        args[7]=steps[i];
        if(i==1){put(dest,"tag.stdout","interrupted");args[8]="--resume";}
        rc=oracle(args,&parts);
        if(i==1)ck(!rc,"readback.resume-interrupted-step");
    }
    ck(!rc && parts.n==whole.n && !memcmp(parts.p,whole.p,parts.n),"readback.identical-stdout");
    char *diff[]={"diff","-qr","--exclude=*.done","--exclude=*.report","--exclude=interrupted-*",saved,dest,0};
    ck(!rc && !sh(diff,root,0,0),"readback.identical-evidence");
    args[7]=steps[10];args[8]="--resume";int resumed=oracle(args,&replay);
    ck(!resumed && replay.n && has(replay.p,"C47_1_READBACK PASS "),"readback.resume-complete");
    put(td,"oldape","different");ck(oracle(args,0)!=0,"readback.changed-input");put(td,"oldape","old");
    cx_fmt(p,sizeof p,"%s/metadata.done",dest);
    char *valid=slurp(p);put(dest,"metadata.done","damaged");
    ck(oracle(args,0)!=0,"readback.damaged-marker");
    if(valid){put(dest,"metadata.done",valid);free(valid);}
    put(dest,"metadata.stdout","corrupt");ck(oracle(args,0)!=0,"readback.damaged-receipt");
    free(whole.p);free(parts.p);free(replay.p);
}
int main(int argc, char **argv) {
    const char *part = "nabcr", *path;
    if(argc==2 && tx_eqz(argv[1],"--fixture-image")){sy_printf("RELEASE_FIXTURE_IMAGE\n");return 0;}
    if (argc >= 3 && tx_eqz(argv[1], "--fake")) {
        const char *d = sy_env("CHECK_RX_FAKE");
        if (!d || cx_fmt(fdir, sizeof fdir, "%s", d)) return 3;
        return tx_eqz(argv[2], "gh") ? fake_gh(argc, argv) : fake_unisacc(argc, argv);
    }
    if ((argc==3 || argc==4 || argc==5) && tx_eqz(argv[1],"--part"))part=argv[2];
    if (sy_cwd(root, sizeof root)) die("cwd");
    if (cx_fmt(td, sizeof td, "/tmp/check-release-exec-%d", sy_pid())) die("td");
    rmrf(td);
    { char *v[] = {"mkdir", "-p", td, 0}; if (sh(v, "/", 0, 0)) die("mkdir td"); }
    sy_child_t prep,hook;int preparing=0,preparing_hook=0;
    if(strcmp(part,"n")) {
        char self[4096],msg[120];
        if(cx_fmt(selfbin,sizeof selfbin,"%s/check",td) || cx_fmt(execbin,sizeof execbin,"%s/exec",td))die("fixture image path");
        char *probe[]={selfbin,"--fixture-image",0};
        if(sy_self_path(self,sizeof self)<0 || sy_copy(!strncmp(self,"/memfd:",7)?"/proc/self/exe":self,selfbin,0700) ||
           sh(probe,root,msg,sizeof msg) || !tx_eqz(msg,"RELEASE_FIXTURE_IMAGE")) {
            char *v[]={"sh",leafs[0],"tools/check-release-exec.cx","-o",selfbin,0};if(sh(v,root,0,0))die("prepare fixture executable");
        }
        char *v[]={"sh",leafs[0],"tools/release-exec.cx","-o",execbin,0};
        sy_spawn_t o;sy_spawn_init(&o);o.argv=v;o.cwd=root;o.pgroup=-1;o.deadline_ms=30000;
        if(argc>=4){if(sy_copy(argv[3],execbin,0700))die("release-exec material");}
        else{if(sy_proc_spawn(&o,&prep))die("prepare release executable");preparing=1;}
        if(strchr(part,'b')){
            if(cx_fmt(hookbin,sizeof hookbin,"%s/hook",td))die("hook path");
            char *h[]={"sh",leafs[0],"tools/release-run.cx","-o",hookbin,0};
            if(argc==5){if(sy_realpath(argv[4],hookbin,sizeof hookbin)<0)die("release-run material");}
            else{o.argv=h;if(sy_proc_spawn(&o,&hook))die("prepare hook");preparing_hook=1;}
        }
    }
    cx_fmt(fx, sizeof fx, "%s/repo", td); cx_fmt(lay, sizeof lay, "%s/layout", td); cx_fmt(binp, sizeof binp, "%s/bin", td);
    path = sy_env("PATH");
    if (cx_fmt(pathenv, sizeof pathenv, "PATH=%s:%s", binp, path ? path : "/usr/bin:/bin") || cx_fmt(fakeenv, sizeof fakeenv, "CHECK_RX_FAKE=%s", td)) die("env");
    if (strchr(part, 'n')) part_n();
    if(preparing){sy_exit_t st;int rc=sy_proc_wait(&prep,&st);sy_proc_close(&prep);if(rc || sy_exit_code(&st))die("release executable");}
    if(preparing_hook){sy_exit_t st;int rc=sy_proc_wait(&hook,&st);sy_proc_close(&hook);if(rc || sy_exit_code(&st))die("release-run executable");}
    if (strchr(part, 'a')) part_a();
    if (strchr(part, 'b')) part_b();
    if (strchr(part, 'c')) part_c();
    if (strchr(part, 'r')) part_r();
    rmrf(td);
    sy_printf("CHECK_RELEASE_EXEC\t%s\tpart=%s\tfailed=%d\n", failed ? "FAIL" : "PASS", part, failed);
    return failed ? 1 : 0;
}
