/* tools/check-release-exec.cx -- contract check of tools/release-exec.cx (release-run --execute).
 *
 *   sh ./unisacc.com tools/check-release-exec.cx [-- --part a|b]   (from the repo root)
 *
 * Everything runs in a private fixture repo under /tmp: fake gh and fake ./unisacc.com are
 * this same file in --fake mode (thin sh wrappers put first in PATH / in the fixture root);
 * they log every call and answer from fixture state. No GitHub, no shared checkout write.
 * part a (gates and dry):
 *   N0 the release-run before --execute existed (85a2d3242e) refuses --execute (fail first)
 *   D1 --dry on a ready fixture: all G1 gates PASS, commands expanded, zero gh/devsvc calls
 *   G1 negatives: STRICT (FAIL outside expected-fail.tsv), EXPECTED_FAIL (count differs),
 *      CANDIDATE_SHA (batch candidate= differs), APE_VERSION, RATCHETS; ASSETS (byte change)
 * part b (execute with fake gh):
 *   E1 full execute: rc 0, external order X -> create -> upload -> download -> workflow run ->
 *      run view -> Y1 -> edit --draft=false -> download -> readback -> Y2, INDEX exec-1..7 rows
 *   R1 --from-step 7 after E1: no create/upload/workflow run/edit repeated
 *   R2 release-run --execute hook reaches release-exec (same RESULT)
 *   G3 DRAFT_READBACK (downloaded byte differs), G4 CI_SUCCESS (job failure), CI_VERDICT (fail=1),
 *   G5 READBACK rc 1 after publish -> rollback commands run (--draft=true, previous --latest),
 *      no release delete, no tag delete
 *   N3 origin/main ancestor gate: pass at X/Y1/Y2; main advanced before X, during CI (before Y1)
 *      and during readback (before Y2) each refused MAIN_ADVANCED with both heads, no commit,
 *      no rollback of public state; no origin/main -> MAIN_UNKNOWN
 *   N4 --warm: cold compile then cache hit in the readback path forms, receipt hit without
 *      recompile, step 6 sees READY, identity change rewarms, forged receipt refused, evicted
 *      cache recompiled, a compile that never caches refused without receipt
 * Marker: CHECK_RELEASE_EXEC. */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use sys.sig
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.releasecandidate

static int failed;
static char root[4096], td[4096], fx[4400], lay[4400], binp[4400], pathenv[8192], fakeenv[4500];
static char selfbin[4400],execbin[4400],hookbin[4400];
#define tlen(s) tx_len((s), 1 << 24)
/* record match: some line of b starts with s or ends with s (output and call logs are line records) */
static int has(const char *b, const char *s) {
    long n = b ? tlen(b) : 0, at = 0, sn = tlen(s);
    while (b && at < n) {
        long e = tx_chr(b + at, n - at, '\n'), ll = e < 0 ? n - at : e;
        if (ll >= sn && (!memcmp(b + at, s, (size_t)sn) || !memcmp(b + at + ll - sn, s, (size_t)sn))) return 1;
        at += ll + 1;
    }
    return 0;
}
static void ck(int ok, const char *n) { sy_printf("%s\tcheck-release-exec.%s\n", ok ? "PASS" : "FAIL", n); if (!ok) failed++; }
static void die(const char *s) { sy_eprintf("check-release-exec: %s\n", s); sy_exit(2); }
static char *slurp(const char *p) { size_t n = 0; return cx_read(p, &n); }
static int put(const char *dir, const char *leaf, const char *text) {
    char p[4800]; return cx_fmt(p, sizeof p, "%s/%s", dir, leaf) || cx_write(p, text, tlen(text));
}
static int sh(char **v, const char *cwd, char *o, long cap) {
    np_result r = {0}; char why[256] = {0}; int rc;
    if (o && cap) o[0] = 0;
    if (np_run(v, cwd, 0, 30, &r, why, sizeof why)) { np_free(&r); return 125; }
    rc = r.rc;
    if (o && cap) { size_t n = r.outn < (size_t)cap - 1 ? r.outn : (size_t)cap - 1; for (size_t i = 0; i < n; i++) o[i] = r.out[i]; o[n] = 0; while (n && o[n - 1] == '\n') o[--n] = 0; }
    np_free(&r);
    return rc;
}

/* ================= fake mode ================= */
static char fdir[4096];
static void flog(const char *who, int argc, char **argv, int from) {
    /* one O_APPEND write per call: the N4 warm-up runs fake children in parallel */
    np_buf b = {0}; char p[4400]; int fd;
    cx_fmt(p, sizeof p, "%s/calls.log", fdir);
    np_puts(&b, who);
    /* tool paths are logged without their extension: assertions then never name a source file */
    for (int i = from; i < argc; i++) {
        long n2 = tlen(argv[i]);
        np_puts(&b, " ");
        if (n2 > 3 && argv[i][n2 - 3] == '.' && argv[i][n2 - 2] == 'c' && argv[i][n2 - 1] == 'x') np_put(&b, argv[i], (size_t)(n2 - 3));
        else np_puts(&b, argv[i]);
    }
    np_puts(&b, "\n");
    fd = sy_open(p, O_WRONLY | O_CREAT | O_APPEND, 0644);
    if (fd >= 0) { sy_write_all(fd, b.p, (long)b.n); sy_close(fd); }
    free(b.p);
}
static int argi(int argc, char **argv, const char *s) { for (int i = 0; i < argc; i++) if (tx_eqz(argv[i], s)) return i; return -1; }
static void copy_file(const char *a, const char *b, int corrupt) {
    size_t n = 0; char *t = cx_read(a, &n);
    if (!t) return;
    if (corrupt && n) t[0] ^= 1;
    cx_write(b, t, n); free(t);
}
static const char *leafs[6] = {"unisacc.com", "pkg.bin", "slice-win-arm64", "unisacc.com.build.json", "build.json", "SHA256SUMS"};
/* N3 fixture: a commit on top of HEAD becomes the remote main (as if another window pushed) */
static void advance_main(const char *flag) {
    char p[4400], repo[4400], tree[128], head[128], c[128], spec[200];
    cx_fmt(p, sizeof p, "%s/%s", fdir, flag);
    if (flag[0] && (sy_exists(p) != 1 || sy_unlink(p))) return;
    cx_fmt(repo, sizeof repo, "%s/repo", fdir);
    { char *v[] = {"git", "rev-parse", "HEAD^{tree}", 0}; if (sh(v, repo, tree, sizeof tree)) return; }
    { char *v[] = {"git", "rev-parse", "HEAD", 0}; if (sh(v, repo, head, sizeof head)) return; }
    { char *v[] = {"git", "-c", "user.name=fixture", "-c", "user.email=fixture@example.invalid", "commit-tree", tree, "-p", head, "-m", "another window", 0}; if (sh(v, repo, c, sizeof c)) return; }
    cx_fmt(spec, sizeof spec, "%s:refs/heads/main", c);
    { char *v[] = {"git", "push", "-q", "origin", spec, 0}; sh(v, repo, 0, 0); }
}
static int fake_gh(int argc, char **argv) {
    char p[4400], q[4800]; char *t;
    flog("gh", argc, argv, 3);
    if(argi(argc,argv,"api")>0){sy_printf("1111111111111111111111111111111111111111\n");return 0;}
    cx_fmt(p, sizeof p, "%s/state", fdir);
    if (argi(argc, argv, "view") > 0 && argi(argc, argv, "release") > 0) {
        t = slurp(p);
        if (!t || tx_eqz(t, "none")) { free(t); return 1; }
        sy_printf("%s\n", t); free(t); return 0;
    }
    if (argi(argc, argv, "create") > 0) return cx_write(p, "true", 4) ? 1 : 0;
    if (argi(argc, argv, "upload") > 0) {
        for (int i = 0; i < argc; i++) if (strchr(argv[i], '/')) {
            const char *l = strrchr(argv[i], '/') + 1;
            cx_fmt(q, sizeof q, "%s/remote/%s", fdir, l); copy_file(argv[i], q, 0);
        }
        return 0;
    }
    if (argi(argc, argv, "download") > 0) {
        int d = argi(argc, argv, "-D"); char flag[4400]; int corrupt;
        cx_fmt(flag, sizeof flag, "%s/corrupt-download", fdir); corrupt = sy_exists(flag) == 1;
        if(d<0){d=argi(argc,argv,"--dir");if(d<0 || d+1>=argc || sy_mkdir(argv[d+1],0700))return 1;}
        for (int i = 0; i < 6; i++) {
            char a[4800];
            if (argi(argc, argv, "-p") > 0) { int want = 0; for (int k = 0; k < argc - 1; k++) if (tx_eqz(argv[k], "-p") && tx_eqz(argv[k + 1], leafs[i])) want = 1; if (!want) continue; }
            cx_fmt(a, sizeof a, "%s/remote/%s", fdir, leafs[i]); cx_fmt(q, sizeof q, "%s/%s", argv[d + 1], leafs[i]);
            copy_file(a, q, corrupt && i == 1);
        }
        return 0;
    }
    if (argi(argc, argv, "edit") > 0) {
        if (argi(argc, argv, "--draft=false") > 0) cx_write(p, "false", 5);
        if (argi(argc, argv, "--draft=true") > 0) cx_write(p, "true", 4);
        return 0;
    }
    if (argi(argc, argv, "workflow") > 0) return 0;
    if (argi(argc, argv, "list") > 0) { cx_fmt(q,sizeof q,"%s/replacement",fdir);sy_printf("%s\t9999-01-01T00:00:00Z\n",sy_exists(q)==1?"777002":"777001"); return 0; }
    if (argi(argc, argv, "run") > 0 && argi(argc, argv, "view") > 0) {
        if(argi(argc,argv,"status,conclusion")>0){cx_fmt(q,sizeof q,"%s/replacement",fdir);sy_printf("completed\t%s\n",sy_exists(q)==1?"failure":"success");return 0;}
        if (argi(argc, argv, "--log") > 0) { advance_main("advance-at-ci"); cx_fmt(q, sizeof q, "%s/ci.log", fdir); t = slurp(q); if (t) sy_printf("%s", t); free(t); return 0; }
        if (argi(argc, argv, "status") > 0) { sy_printf("completed\n"); return 0; }
        cx_fmt(q, sizeof q, "%s/ci.json", fdir); t = slurp(q); if (t) sy_printf("%s", t); free(t); return 0;
    }
    return 3;
}
static int fake_unisacc(int argc, char **argv) {
    char q[4400]; char *t;
    flog("unisacc", argc, argv, 3);
    if (argc < 4) return 3;
    /* N4 fixture run cache: keyed by the tool path exactly as passed (as the product keys it) */
    if (argc >= 6 && tx_eqz(argv[4], "--") && (tx_eqz(argv[5], "warm") || tx_eqz(argv[5], "--list-steps"))) {
        char key[4400]; long i, n = tlen(argv[3]); int existed;
        if (n > 4000) return 3;
        for (i = 0; i < n; i++) key[i] = argv[3][i] == '/' ? '_' : argv[3][i];
        key[n] = 0;
        cx_fmt(q, sizeof q, "%s/fakecache/%s", fdir, key);
        existed = sy_exists(q) == 1;
        { char nc[4400]; char *skip; int uncached; cx_fmt(nc, sizeof nc, "%s/nocache", fdir);
          skip = slurp(nc); uncached = skip && tx_eqz(skip, argv[3]); free(skip);
          if (!existed && !uncached && cx_write(q, "compiled\n", 9)) return 3; }
        if (sy_env("UNISACC_RR_TIME")) {
            if (existed) sy_eprintf("RR_TIME\tlookup_hit=2\tns=1\n");
            else sy_eprintf("RR_TIME\tlookup_hit=0\tns=1\nRR_TIME\toutput\tkind=exec-prepare\tbytes=1\tns=1\n");
        }
        if (tx_eqz(argv[5], "--list-steps")) { sy_printf("metadata\nzip-members\n"); return 0; }
        return 2;
    }
    if(argv[3][0]=='/'){
        const char *tool=strrchr(argv[3],'/')+1;
        if(tx_eqz(tool,"chain-step.cx") || tx_eqz(tool,"check-run-comm.cx")){sy_printf("fixture child %s\n",tool);return 0;}
        if(tx_eqz(tool,"release-layout.cx")){
            if(argi(argc,argv,"--check")<0){
                char src[4600],dst[4600];if(sy_mkdir(argv[argc-1],0700))return 1;
                for(int i=0;i<6;i++){
                    cx_fmt(src,sizeof src,"%s/layout/%s",fdir,leafs[i]);
                    cx_fmt(dst,sizeof dst,"%s/%s",argv[argc-1],leafs[i]);
                    if(sy_copy(src,dst,0600))return 1;
                }
            }
            sy_printf("layout fixture\n");return 0;
        }
    }
    if (tx_eqz(argv[3], "tools/ratchets.cx")) { sy_printf("RATCHETS\tok=15\tfail=0\n"); return 0; }
    if (tx_eqz(argv[3], "tools/devsvc.cx")) {
        int mi=argi(argc,argv,"-m");
        if(mi>0 && mi+1<argc && has(argv[mi+1]," Y1")){
            if(argi(argc,argv,"release/evidence/0.0.99/INDEX.tsv")<0)return 2;
            for(int i=argi(argc,argv,"--whole")+1;i<argc && argv[i][0]!='-';i++){
                sy_stat_t st;if(!sy_lstat(argv[i],&st) && st.kind=='d')return 2;
            }
            sy_printf("Y1_FIXTURE_REGULAR_FILES\n");
        }
        sy_printf("OK\tfake devsvc\n"); return 0;
    }
    if (tx_eqz(argv[3], "tools/release-decide.cx")) { cx_fmt(q, sizeof q, "%s/decision.txt", fdir); t = slurp(q); if (t) sy_printf("%s", t); free(t); return 0; }
    if (tx_eqz(argv[3], "release/tools/c47-1-readback.cx")) {
        if(argi(argc,argv,"--list-steps")>0){sy_printf("metadata\nzip-members\n");return 0;}
        cx_fmt(q,sizeof q,"%s/readback-timeout-once",fdir);
        if(sy_exists(q)==1){
            if(argc<10 || sy_mkdir(argv[7],0700))return 2;
            if(sy_unlink(q) || put(fdir,"first-output",argv[7]))return 2;
            return 124;
        }
        cx_fmt(q,sizeof q,"%s/first-output",fdir);
        if(sy_exists(q)==1){
            char *first=slurp(q);
            if(!first || argc<10 || tx_eqz(argv[7],first) || sy_exists(first)!=1 || sy_exists(argv[7])!=0)return 2;
            free(first);
            if(sy_unlink(q) || put(fdir,"fresh-output-verified","yes"))return 2;
        }
        advance_main("advance-at-readback");
        cx_fmt(q, sizeof q, "%s/readback-fail", fdir);
        sy_printf("READBACK_STEP fake %s\n", sy_exists(q) == 1 ? "FAIL" : "PASS");
        if(argc>11 && tx_eqz(argv[11],"zip-members") && sy_exists(q)==0){
            RcCandidate c;char why[256];
            if(rcand_load(argv[6],&c,why,sizeof why))return 2;
            sy_printf("C47_1_READBACK PASS expected_draft=false tag=%s version=%s commit=%s output=%s\n",c.tag,c.version,c.commit,argv[7]);
        }
        return sy_exists(q) == 1 ? 1 : 0;
    }
    if (tx_eqz(argv[3], "tools/release-exec.cx")) {   /* the release-run hook: forward to the real tool */
        const char *real = sy_env("CHECK_RX_REAL"); char rp[4400], cwd[4096]; np_result r = {0}; char why[256]; char *v[40]; int k = 0, rc;
        cx_fmt(rp, sizeof rp, "%s/tools/release-exec.cx", real); sy_cwd(cwd, sizeof cwd);
        char prepared[4400];cx_fmt(prepared,sizeof prepared,"%s/exec",fdir);
        v[k++] = prepared;
        for (int i = 4+(argc>4 && tx_eqz(argv[4],"--")); i < argc && k < 39; i++) v[k++] = argv[i];
        v[k] = 0;
        if (np_run(v, cwd, 0, 55, &r, why, sizeof why)) return 125;
        if (r.outn) sy_write_all(1, r.out, r.outn); if (r.errn) sy_write_all(2, r.err, r.errn);
        rc = r.rc; np_free(&r); return rc;
    }
    return 3;
}

/* ================= fixture ================= */
static char sha[6][65];
static void sha_of(const char *p, char *hex) {
    char o[300]; char *v[] = {"sha256sum", "--", (char *)p, 0};
    if (sh(v, root, o, sizeof o) || tlen(o) < 64) die("sha256sum");
    for (int i = 0; i < 64; i++) hex[i] = o[i];
    hex[64] = 0;
}
static int git(const char *a, const char *b, const char *c, const char *d, const char *e, char *o, long cap) {
    char *v[16]; int k = 0;
    v[k++] = "git"; v[k++] = "-c"; v[k++] = "user.name=fixture"; v[k++] = "-c"; v[k++] = "user.email=fixture@example.invalid";
    if (a) v[k++] = (char *)a; if (b) v[k++] = (char *)b; if (c) v[k++] = (char *)c; if (d) v[k++] = (char *)d; if (e) v[k++] = (char *)e;
    v[k] = 0;
    return sh(v, fx, o, cap);
}
static void rmrf(const char *p) { char *v[] = {"rm", "-rf", (char *)p, 0}; sh(v, "/", 0, 0); }
/* gh run view --json answer: six candidate jobs, job number bad (1..6) concluded failure */
static void ci_json(int bad) {
    np_buf b = {0}; char row[200];
    np_puts(&b, "{\"conclusion\":\"success\",\"databaseId\":777001,\"jobs\":[");
    for (int i = 1; i <= 6; i++) {
        cx_fmt(row, sizeof row, "%s{\"conclusion\":\"%s\",\"databaseId\":%d,\"name\":\"candidate (%c)\"}", i > 1 ? "," : "", i == bad ? "failure" : "success", i, 'a' + i - 1);
        np_puts(&b, row);
    }
    np_puts(&b, "]}\n"); np_put(&b, "", 1);
    put(td, "ci.json", b.p); free(b.p);
}
/* opts: version printed by the fake APE, strict variant, ratchets fail count */
static void fixture(int fixture_patch, int strict_variant, int ratchet_fail, int with_expected) {
    char p[4800], t[8192], cand[4096], blob[128], tree[128], tree2[128], commit[128], row[600];
    char apever[32];cx_fmt(apever,sizeof apever,"0.0.%d",fixture_patch);
    rmrf(fx); rmrf(lay);
