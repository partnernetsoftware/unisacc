        "gh -R example/fixture release upload v0.0.99", "gh -R example/fixture release download v0.0.99 -D", "gh -R example/fixture workflow run candidate-native.yml --ref v0.0.99 -f release_tag=v0.0.99",
        "gh -R example/fixture run view 777001 --json conclusion", "gh -R example/fixture run view 777001 --log", "unisacc tools/devsvc -- git commit -m v0.0.99 Y1",
        "gh -R example/fixture release edit v0.0.99 --draft=false --latest", "gh -R example/fixture release download v0.0.99 -p unisacc.com -p SHA256SUMS",
        "unisacc release/tools/c47-1-readback", "unisacc tools/devsvc -- git commit -m v0.0.99 Y2: public readback"};
    /* E1 full execute */
    fixture(99, 0, 0, 1);
    put(td,"readback-timeout-once","1");
    {char d[4500];cx_fmt(d,sizeof d,"%s/release/evidence/0.0.99/nested",fx);sy_mkdir(d,0700);}
    rc = rx(0, 0, 0, 0); c = calls();
    ck(git("ls-remote","--exit-code","--heads","origin","refs/heads/v0.0.99",0,0)==0,"E1.release-branch-created");
    ck(rc==0 && c && has(c,"unisacc tools/devsvc -- git commit -m v0.0.99 Y1"),"E1.Y1-regular-files-only");
    cx_fmt(p,sizeof p,"%s/fresh-output-verified",td);
    ck(rc==0 && sy_exists(p)==1,"E1.retry-uses-new-output-keeps-first");
    ck(rc == 0 && has(out, "RELEASE_EXEC\tRESULT\tEXECUTED"), "E1.execute-ok");
    if (rc) sy_printf("  rc=%d tail: %.600s\n", rc, out + (tlen(out) > 600 ? tlen(out) - 600 : 0));
    ck(c && ordered(c, seq, 12), "E1.external-order");
    ck(c && !has(c, "gh -R example/fixture release delete") && !has(c, "gh -R example/fixture release edit v0.0.99 --draft=true"), "E1.no-delete-no-rollback");
    cx_fmt(p, sizeof p, "%s/release/evidence/0.0.99/INDEX.tsv", fx);
    { char *ix = catf(p);
      ck(has(ix, "exec-1-X-commit\t") && has(ix, "exec-2-draft-readback\t") && has(ix, "exec-3-ci-dispatch\t") && has(ix, "exec-3-ci\t") && has(ix, "exec-4-Y1\t") &&
         has(ix, "exec-5-publish\t") && has(ix, "exec-6-public-readback\t") && has(ix, "exec-7-Y2-done\t"), "E1.index-rows");
      free(ix); }
    { char cp[4500]; cx_fmt(cp, sizeof cp, "%s/release/candidate.tsv", fx); char *t = catf(cp); ck(has(t, "example/fixture\tv0.0.99\t1111111111111111111111111111111111111111\t0.0.99\tcandidate-native.yml\tv0.0.99\t777001\t"), "E1.ci-run-id-filled"); free(t);
      cx_fmt(cp, sizeof cp, "%s/release/evidence/0.0.99/ci-777001.log", fx); ck(sy_exists(cp) == 1, "E1.ci-evidence-kept"); }
    free(c);
    /* R1 resume from step 7: verify-only for 1..6 */
    put(td, "calls.log", "");
    rc = rx("--from-step", "7", 0, 0); c = calls();
    ck(rc == 0 && has(out, "STEP\t1\tX-commit\tVERIFY") && has(out, "SKIP\t7\tY2 already recorded"), "R1.resume-ok");
    ck(c && !has(c, "gh -R example/fixture release create") && !has(c, "gh -R example/fixture release upload") && !has(c, "gh -R example/fixture workflow run") &&
       !has(c, "gh -R example/fixture release edit") && !has(c, "unisacc tools/devsvc -- git commit"), "R1.no-repeated-external-action");
    free(c);
    /* R2 release-run hook */
    put(td, "calls.log", "");
    rc = rx("--from-step", "7", 0, "tools/release-run.cx");
    ck(rc == 0 && has(out, "RELEASE_EXEC\tRESULT\tEXECUTED"), "R2.release-run-execute-hook");
}
/* lines of t equal to s */
static int count_lines(const char *t, const char *s) {
    long n = t ? tlen(t) : 0, at = 0, sn = tlen(s); int k = 0;
    while (t && at < n) {
        long e = tx_chr(t + at, n - at, '\n'), ll = e < 0 ? n - at : e;
        if (ll == sn && !memcmp(t + at, s, (size_t)sn)) k++;
        at += ll + 1;
    }
    return k;
}
static char *refsha(const char *ref) { static char o[128]; char *v[] = {"git", "rev-parse", (char *)ref, 0}; if (sh(v, fx, o, sizeof o)) o[0] = 0; return o; }
/* N3: origin/main must be an ancestor of HEAD before X, Y1 and Y2 */
static void part_m(void) {
    int rc; char *c, want[300], om[64], head[64];
    cx_fmt(fdir, sizeof fdir, "%s", td);
    fixture(99, 0, 0, 1);
    rc = rx(0, 0, 0, 0);
    ck(rc == 0 && has(out, "GATE\t1\tMAIN_ANCESTOR\tPASS") && has(out, "GATE\t4\tMAIN_ANCESTOR\tPASS") && has(out, "GATE\t7\tMAIN_ANCESTOR\tPASS"), "N3.ancestor-pass-x-y1-y2");
    /* X: another window pushed main before the run */
    fixture(99, 0, 0, 1); advance_main("");
    { char *v[] = {"git", "fetch", "-q", "origin", 0}; sh(v, fx, 0, 0); }
    cx_fmt(om, sizeof om, "%s", refsha("refs/remotes/origin/main")); cx_fmt(head, sizeof head, "%s", refsha("HEAD"));
    put(td, "calls.log", "");
    rc = rx(0, 0, 0, 0); c = calls();
    expect_gate("N3.x-main-advanced", rc, "MAIN_ADVANCED");
    cx_fmt(want, sizeof want, "origin/main=%s HEAD=%s", om, head);
    ck(rc == 2 && tlen(om) == 40 && tx_find(out, tlen(out), want, tlen(want)) >= 0 && has(out, "--from-step 1") && has(out, "ROLLBACK\t1\tNONE\tmain moved; candidate and public state untouched") &&
       c && !has(c, "unisacc tools/devsvc -- git commit") && !has(c, "gh -R example/fixture release create"), "N3.x-names-heads-no-commit-no-merge");
    free(c);
    /* Y1: main moves while CI runs */
    fixture(99, 0, 0, 1); put(td, "advance-at-ci", "1");
    rc = rx(0, 0, 0, 0); c = calls();
    expect_gate("N3.y1-main-advanced", rc, "MAIN_ADVANCED");
    ck(rc == 2 && has(out, "GATE\t1\tMAIN_ANCESTOR\tPASS") && has(out, "--from-step 4") && c && !has(c, "unisacc tools/devsvc -- git commit -m v0.0.99 Y1") &&
       !has(c, "gh -R example/fixture release edit v0.0.99 --draft=false"), "N3.y1-before-commit-not-published");
    free(c);
    /* Y2: main moves during the public readback; public state is not rolled back */
    fixture(99, 0, 0, 1); put(td, "advance-at-readback", "1");
    rc = rx(0, 0, 0, 0); c = calls();
    expect_gate("N3.y2-main-advanced", rc, "MAIN_ADVANCED");
    ck(rc == 2 && has(out, "GATE\t4\tMAIN_ANCESTOR\tPASS") && has(out, "--from-step 7") && c && has(c, "gh -R example/fixture release edit v0.0.99 --draft=false --latest") &&
       !has(c, "gh -R example/fixture release edit v0.0.99 --draft=true") && !has(c, "unisacc tools/devsvc -- git commit -m v0.0.99 Y2"), "N3.y2-no-rollback-no-commit");
    free(c);
    /* no remote-tracking main (no history): named refusal, never a pass */
    fixture(99, 0, 0, 1);
    { char *v[] = {"git", "update-ref", "-d", "refs/remotes/origin/main", 0}; sh(v, fx, 0, 0); }
    expect_gate("N3.no-origin-main-refused", rx(0, 0, 0, 0), "MAIN_UNKNOWN");
}
static int rxw(void) {
    char ex[4400]; char *v[] = {execbin, "--warm", "release/candidate.tsv", "--layout", lay, "--out", ex, 0}; np_result r = {0}; char why[256]; int rc;
    char *env[] = {pathenv, fakeenv, 0};
    cx_fmt(ex, sizeof ex, "%s/xout", td);
    out[0] = 0;
    if (np_run(v, fx, env, 55, &r, why, sizeof why)) { np_free(&r); return 125; }
    { size_t n = 0; for (size_t i = 0; i < r.outn && n + 1 < sizeof out; i++) out[n++] = r.out[i];
      for (size_t i = 0; i < r.errn && n + 1 < sizeof out; i++) out[n++] = r.err[i]; out[n] = 0; }
    rc = r.rc; np_free(&r);
    return rc;
}
static void warm_key_of(char *key) {
    long k = tx_find(out, tlen(out), "WARM\tRECEIPT\t", 13), j = 0; key[0] = 0;
    if (k < 0) return;
    k = tx_find(out + k, tlen(out + k), "key=", 4) + k;
    if (k < 0) return;
    k += 4; while (j < 64 && out[k + j]) { key[j] = out[k + j]; j++; }
    key[j] = 0;
}
/* N4: readback warm-up of the checkout-product compiles */
static void part_w(void) {
    int rc; char *c, line[4800], k1[80], k2[80], p[4800];
    static const char *forms[5] = {"release/tools/c47-1-readback -- --list-steps", "%s/tools/chain-step -- warm", "tools/release-ape -- warm", "%s/tools/check-run-comm -- warm", "%s/tools/release-layout -- warm"};
    fixture(99, 0, 0, 1);
    cx_fmt(p, sizeof p, "%s/release/tools", fx); sy_mkdir(p, 0700);
    put(fx, "release/tools/c47-1-readback.cx", "readback fixture"); put(fx, "tools/chain-step.cx", "smoke fixture"); put(fx, "tools/release-ape.cx", "ape fixture");
    put(fx, "tools/check-run-comm.cx", "comm fixture"); put(fx, "tools/release-layout.cx", "layout fixture");
    put(td, "calls.log", "");
    rc = rxw(); c = calls(); warm_key_of(k1);
    { int forms_ok = 1;
      for (int i = 0; i < 5; i++) { char f[300]; cx_fmt(f, sizeof f, forms[i], fx); cx_fmt(line, sizeof line, "unisacc %s", f); if (count_lines(c, line) != 2) { forms_ok = 0; sy_printf("  warm calls %d: %s\n", count_lines(c, line), line); } }
      ck(rc == 0 && has(out, "WARM\tRECEIPT\tNEW") && has(out, "WARM\tRESULT\tREADY") && count_lines(out, "WARM\tTARGET\ttools/chain-step.cx\tHIT\tafter-cold") == 1 &&
         count_lines(out, "WARM\tTARGET\trelease/tools/c47-1-readback.cx\tHIT\tafter-cold") == 1 && forms_ok, "N4.warm-compiles-once-then-hits-readback-forms"); }
    free(c);
    put(td, "calls.log", "");
    rc = rxw(); c = calls(); warm_key_of(k2);
    cx_fmt(line, sizeof line, "unisacc %s/tools/chain-step -- warm", fx);
    ck(rc == 0 && has(out, "WARM\tRECEIPT\tHIT") && tx_eqz(k1, k2) && tlen(k1) == 64 && count_lines(c, line) == 1, "N4.same-identity-no-recompile");
    free(c);
    rc = rx(0, 0, 0, 0);
    cx_fmt(line, sizeof line, "WARM\t6\tREADY\tkey=%s", k1);
    ck(rc == 0 && has(out, line), "N4.readback-step-sees-warm-identity");
    /* identity changes: one entry tool's bytes */
    put(fx, "tools/chain-step.cx", "smoke fixture changed");
    put(td, "calls.log", "");
    rc = rxw(); c = calls(); warm_key_of(k2);
    cx_fmt(line, sizeof line, "unisacc %s/tools/chain-step -- warm", fx);
    ck(rc == 0 && has(out, "WARM\tRECEIPT\tNEW") && !tx_eqz(k1, k2) && count_lines(c, line) == 2, "N4.identity-change-rewarms");
    free(c);
    /* receipt bytes changed: refused */
    cx_fmt(p, sizeof p, "xout/warm-%s.tsv", k2);
    put(td, p, "WARM\tforged\n");
    rc = rxw();
    ck(rc == 2 && has(out, "release-exec: REFUSE RELEASE_EXEC_GATE_WARM_RECEIPT receipt="), "N4.tampered-receipt-refused");
    /* cache evicted under a valid receipt: the probe misses, the warm-up compiles again */
    fixture(99, 0, 0, 1);
    cx_fmt(p, sizeof p, "%s/xout", td); rmrf(p);
    cx_fmt(p, sizeof p, "%s/release/tools", fx); sy_mkdir(p, 0700);
    put(fx, "release/tools/c47-1-readback.cx", "readback fixture"); put(fx, "tools/chain-step.cx", "smoke fixture"); put(fx, "tools/release-ape.cx", "ape fixture");
    put(fx, "tools/check-run-comm.cx", "comm fixture"); put(fx, "tools/release-layout.cx", "layout fixture");
    rxw();
    cx_fmt(p, sizeof p, "%s/fakecache/tools_release-ape.cx", td); rmrf(p);
    rc = rxw();
    ck(rc == 0 && has(out, "WARM\tRECEIPT\tHIT") && has(out, "WARM\tTARGET\ttools/release-ape.cx\tMISS\treceipt") && has(out, "WARM\tREWARM\t1 target(s)") &&
       has(out, "WARM\tTARGET\ttools/release-ape.cx\tHIT\tafter-rewarm"), "N4.evicted-cache-recompiled");
    /* a compile that never lands in the run cache: refused, no receipt */
    cx_fmt(p, sizeof p, "%s/xout", td); rmrf(p);
    put(fx, "tools/release-layout.cx", "layout fixture uncached");
    { char lp[4600]; cx_fmt(lp, sizeof lp, "%s/tools/release-layout.cx", fx); put(td, "nocache", lp); }
    cx_fmt(p, sizeof p, "%s/fakecache", td); rmrf(p); sy_mkdir(p, 0700);
    rc = rxw(); warm_key_of(k2);
    cx_fmt(p, sizeof p, "%s/xout/warm-%s.tsv", td, k2);
    ck(rc == 2 && has(out, "WARM\tTARGET\ttools/release-layout.cx\tMISS\tafter-cold") && has(out, "release-exec: REFUSE RELEASE_EXEC_GATE_WARM 1 target(s) not served from the run cache") &&
       sy_exists(p) == 0, "N4.uncached-compile-refused-no-receipt");
    cx_fmt(p, sizeof p, "%s/nocache", td); rmrf(p);
}
static void part_c(void) {
    int rc; char *c, p[4500];
    /* G3 draft readback */
    fixture(99, 0, 0, 1); put(td, "corrupt-download", "1");
    rc = rx(0, 0, 0, 0); expect_gate("G3.draft-readback-mismatch", rc, "DRAFT_READBACK");
    c = calls(); ck(has(out, "ROLLBACK\t2\tPLAN\tnot public") && c && !has(c, "gh -R example/fixture workflow run") && !has(c, "gh -R example/fixture release edit v0.0.99 --draft=false"), "G3.stops-before-ci-and-publish"); free(c);
    /* G4 CI */
    fixture(99, 0, 0, 1);
    ci_json(3);
    rc = rx(0, 0, 0, 0); expect_gate("G4.ci-job-not-success", rc, "CI_SUCCESS");
    c = calls(); ck(c && !has(c, "gh -R example/fixture release edit v0.0.99 --draft=false"), "G4.ci-fail-not-published"); free(c);
    put(td,"calls.log","");
    rc=rx(0,0,0,0);c=calls();
    ck(rc==2 && c && !has(c,"gh -R example/fixture workflow run"),"G4.failure-no-implicit-redispatch");free(c);
    rc=rx("--redispatch",0,0,0);
    ck(rc==2 && has(out,"release-exec: REFUSE RELEASE_EXEC_GATE_REDISPATCH previous run must be completed with conclusion failure"),"G4.redispatch-requires-failed-conclusion");
    put(td,"replacement","1");ci_json(0);rc=rx("--redispatch",0,0,0);
    {char p[4500];cx_fmt(p,sizeof p,"%s/release/evidence/0.0.99/INDEX.tsv",fx);char *ix=catf(p);
      ck(rc==0 && has(ix,"exec-3b-ci-dispatch-2") && has(ix,"superseded-by=777002") &&
         has(ix,"exec-3-ci-dispatch") && has(ix,"777001"),"G4.explicit-redispatch-keeps-old-run");free(ix);
      cx_fmt(p,sizeof p,"%s/replacement",td);sy_unlink(p);}
    fixture(99, 0, 0, 1);
    put(td, "ci.log", "report\tx\t2026Z CANDIDATE_QUALIFY\tverdict=NOT_QUALIFIED\tpass=41\tfail=1\tnot_run=0\tinvalid=0\n");
    rc = rx(0, 0, 0, 0); expect_gate("G4.ci-verdict-fail", rc, "CI_VERDICT");
    /* G5 readback failure after publish -> rollback runs */
    fixture(99, 0, 0, 1); put(td, "readback-fail", "1");
    rc = rx(0, 0, 0, 0); expect_gate("G5.readback-fail", rc, "READBACK");
    c = calls();
    ck(c && has(c, "gh -R example/fixture release edit v0.0.99 --draft=true") && has(c, "gh -R example/fixture release edit v0.0.98 --latest") &&
       !has(c, "gh -R example/fixture release delete") && !has(c, "unisacc tools/devsvc -- git commit -m v0.0.99 Y2"), "G5.rollback-executed-no-delete");
    free(c);
    part_m();
    part_w();
}

static int oracle(char **args,np_buf *result){
    char why[256];char *env[]={pathenv,fakeenv,0};np_result r={0};
    int rc=np_run(args,fx,env,55,&r,why,sizeof why)?125:r.rc;
    if(result && !rc)np_put(result,r.out,r.outn);
    if(rc && r.errn)sy_write_all(2,r.err,(long)r.errn);
    np_free(&r);return rc;
}
static void part_r(void){
    char image[4600],source[4600],table[4600],dest[4600],saved[4600],p[4600],q[4600],oldape[4600];
    char *steps[]={"metadata","tag","download","asset-sha","version","smoke","comm","layout-generate","layout-check","checksums","zip-members"};
    fixture(99,0,0,1);put(td,"state","false");put(td,"oldape","old");
    cx_fmt(oldape,sizeof oldape,"%s/oldape",td);cx_fmt(table,sizeof table,"%s/release/candidate.tsv",fx);
    cx_fmt(dest,sizeof dest,"%s/result",td);cx_fmt(saved,sizeof saved,"%s/whole",td);cx_fmt(image,sizeof image,"%s/oracle",td);
    cx_fmt(source,sizeof source,"%s/release/tools/c47-1-readback.cx",root);
    char *compile[]={"sh",(char*)leafs[0],source,"-o",image,0};if(sh(compile,root,0,0))die("readback build");
    cx_fmt(p,sizeof p,"%s/release/tools",fx);if(sy_mkdir(p,0700))die("fixture oracle dir");
    cx_fmt(q,sizeof q,"%s/c47-1-readback.cx",p);if(sy_copy(source,q,0600))die("fixture oracle");
    put(fx,"tools/chain-step.cx","smoke fixture");put(fx,"tools/check-run-comm.cx","comm fixture");put(fx,"tools/release-layout.cx","layout fixture");
    for(int i=0;i<6;i++){cx_fmt(p,sizeof p,"%s/%s",lay,leafs[i]);cx_fmt(q,sizeof q,"%s/remote/%s",td,leafs[i]);if(sy_copy(p,q,0600))die("fixture asset");}
    char *args[]={image,fx,table,dest,oldape,"false",0,0,0,0};
    np_buf whole={0},parts={0},replay={0};int rc=oracle(args,&whole);
    ck(!rc && whole.n && has(whole.p,"C47_1_READBACK PASS "),"readback.whole");
    if(sy_rename(dest,saved))die("save full evidence");
    args[6]="--step";args[7]=steps[1];ck(oracle(args,0)!=0,"readback.missing-prerequisite");
    for(int i=0;i<11 && !rc;i++){
        args[7]=steps[i];
        if(i==1){put(dest,"tag.stdout","interrupted");args[8]="--resume";}
        rc=oracle(args,&parts);
        if(i==1)ck(!rc,"readback.resume-interrupted-step");
    }
    ck(!rc && parts.n==whole.n && !memcmp(parts.p,whole.p,parts.n),"readback.identical-stdout");
    char *diff[]={"diff","-qr","--exclude=*.done","--exclude=*.report","--exclude=interrupted-*",saved,dest,0};
    ck(!rc && !sh(diff,root,0,0),"readback.identical-evidence");
    args[7]=steps[10];args[8]="--resume";int resumed=oracle(args,&replay);
    ck(!resumed && replay.n && has(replay.p,"C47_1_READBACK PASS "),"readback.resume-complete");
    put(td,"oldape","different");ck(oracle(args,0)!=0,"readback.changed-input");put(td,"oldape","old");
    cx_fmt(p,sizeof p,"%s/metadata.done",dest);
    char *valid=slurp(p);put(dest,"metadata.done","damaged");
    ck(oracle(args,0)!=0,"readback.damaged-marker");
    if(valid){put(dest,"metadata.done",valid);free(valid);}
    put(dest,"metadata.stdout","corrupt");ck(oracle(args,0)!=0,"readback.damaged-receipt");
    free(whole.p);free(parts.p);free(replay.p);
}
int main(int argc, char **argv) {
    const char *part = "nabcr", *path;
    if(argc==2 && tx_eqz(argv[1],"--fixture-image")){sy_printf("RELEASE_FIXTURE_IMAGE\n");return 0;}
    if (argc >= 3 && tx_eqz(argv[1], "--fake")) {
        const char *d = sy_env("CHECK_RX_FAKE");
        if (!d || cx_fmt(fdir, sizeof fdir, "%s", d)) return 3;
        return tx_eqz(argv[2], "gh") ? fake_gh(argc, argv) : fake_unisacc(argc, argv);
    }
    if ((argc==3 || argc==4 || argc==5) && tx_eqz(argv[1],"--part"))part=argv[2];
    if (sy_cwd(root, sizeof root)) die("cwd");
    /* fixture repos live in a unique directory under $CLAUDE_JOB_DIR/tmp or $TMPDIR, never directly in /tmp */
    { char base[4096]; const char *j = sy_env("CLAUDE_JOB_DIR"), *t = sy_env("TMPDIR");
      if (j && j[0] == '/') { if (cx_fmt(base, sizeof base, "%s/tmp", j)) die("td base"); { char *v[] = {"mkdir", "-p", base, 0}; if (sh(v, "/", 0, 0)) die("td base"); } }
      else if (t && t[0] == '/' && !tx_eqz(t, "/tmp") && !tx_eqz(t, "/tmp/")) { if (cx_fmt(base, sizeof base, "%s", t)) die("td base"); }
      else if (cx_fmt(base, sizeof base, "/tmp/check-release-exec-root-%d", sy_uid()) || (sy_mkdir(base, 0700) && sy_exists(base) != 1)) die("td base");
      if (sy_mkdtemp(base, "check-release-exec-", td, sizeof td)) die("td"); }
    sy_child_t prep,hook;int preparing=0,preparing_hook=0;
    if(strcmp(part,"n")) {
        char self[4096],msg[120];
        if(cx_fmt(selfbin,sizeof selfbin,"%s/check",td) || cx_fmt(execbin,sizeof execbin,"%s/exec",td))die("fixture image path");
        char *probe[]={selfbin,"--fixture-image",0};
        if(sy_self_path(self,sizeof self)<0 || sy_copy(!strncmp(self,"/memfd:",7)?"/proc/self/exe":self,selfbin,0700) ||
           sh(probe,root,msg,sizeof msg) || !tx_eqz(msg,"RELEASE_FIXTURE_IMAGE")) {
            char *v[]={"sh",leafs[0],"tools/check-release-exec.cx","-o",selfbin,0};if(sh(v,root,0,0))die("prepare fixture executable");
        }
        char *v[]={"sh",leafs[0],"tools/release-exec.cx","-o",execbin,0};
        sy_spawn_t o;sy_spawn_init(&o);o.argv=v;o.cwd=root;o.pgroup=-1;o.deadline_ms=30000;
        if(argc>=4){if(sy_copy(argv[3],execbin,0700))die("release-exec material");}
        else{if(sy_proc_spawn(&o,&prep))die("prepare release executable");preparing=1;}
        if(strchr(part,'b')){
            if(cx_fmt(hookbin,sizeof hookbin,"%s/hook",td))die("hook path");
            char *h[]={"sh",leafs[0],"tools/release-run.cx","-o",hookbin,0};
            if(argc==5){if(sy_realpath(argv[4],hookbin,sizeof hookbin)<0)die("release-run material");}
            else{o.argv=h;if(sy_proc_spawn(&o,&hook))die("prepare hook");preparing_hook=1;}
        }
    }
    cx_fmt(fx, sizeof fx, "%s/repo", td); cx_fmt(lay, sizeof lay, "%s/layout", td); cx_fmt(binp, sizeof binp, "%s/bin", td);
    path = sy_env("PATH");
    if (cx_fmt(pathenv, sizeof pathenv, "PATH=%s:%s", binp, path ? path : "/usr/bin:/bin") || cx_fmt(fakeenv, sizeof fakeenv, "CHECK_RX_FAKE=%s", td)) die("env");
    if (strchr(part, 'n')) part_n();
    if(preparing){sy_exit_t st;int rc=sy_proc_wait(&prep,&st);sy_proc_close(&prep);if(rc || sy_exit_code(&st))die("release executable");}
    if(preparing_hook){sy_exit_t st;int rc=sy_proc_wait(&hook,&st);sy_proc_close(&hook);if(rc || sy_exit_code(&st))die("release-run executable");}
    if (strchr(part, 'a')) part_a();
    if (strchr(part, 'b')) part_b();
    if (strchr(part, 'c')) part_c();
    if (strchr(part, 'r')) part_r();
    rmrf(td);
    sy_printf("CHECK_RELEASE_EXEC\t%s\tpart=%s\tfailed=%d\n", failed ? "FAIL" : "PASS", part, failed);
    return failed ? 1 : 0;
}
