    cx_fmt(old, sizeof old, "%s/old", td); cx_fmt(tarp, sizeof tarp, "%s/old.tar", td); cx_fmt(up, sizeof up, "%s/%s", root, leafs[0]);
    { char *v[] = {"mkdir", "-p", old, 0}; sh(v, "/", 0, 0); }
    /* The devsvc qualify layout is a git archive plus one private commit: 85a2d3242e is absent there.
     * Without the object the same old source comes from the committed fixture
     * tests/release-exec/old-release-run-85a2d3242e.txt (byte copy of tools/release-run.cx at 85a2d3242e)
     * over the current cxroot.tsv, tools/cxlib, cx, ext; the N0 assertion below is unchanged. */
    { char *e[] = {"git", "cat-file", "-e", "85a2d3242e^{commit}", 0};
      if (sh(e, root, 0, 0)) {
          char oldsrc[4400], dst[4400]; cx_fmt(oldsrc, sizeof oldsrc, "%s/tests/release-exec/old-release-run-85a2d3242e.txt", root); cx_fmt(dst, sizeof dst, "%s/tools/release-run.cx", old);
          { char *g[] = {"git", "archive", "-o", tarp, "HEAD", "cxroot.tsv", "tools/cxlib", "cx", "ext", 0}; if (sh(g, root, 0, 0)) die("git archive head libs"); }
          { char *t[] = {"tar", "-xf", tarp, "-C", old, 0}; if (sh(t, "/", 0, 0)) die("tar head libs"); }
          { char *c[] = {"cp", oldsrc, dst, 0}; if (sh(c, "/", 0, 0)) die("old release-run fixture"); }
          sy_printf("NOTE\tN0\tno-history 85a2d3242e: committed fixture stands in\n");
      } else {
    { char *g[] = {"git", "archive", "-o", tarp, "85a2d3242e", "cxroot.tsv", "tools/release-run.cx", "tools/cxlib", "cx", "ext", 0};
      if (sh(g, root, 0, 0)) die("git archive old release-run"); }
    { char *t[] = {"tar", "-xf", tarp, "-C", old, 0}; if (sh(t, "/", 0, 0)) die("tar old release-run"); }
      } }
    { char *v[] = {"sh", up, "tools/release-run.cx", "--", "--execute", "release/candidate.tsv", "--dry", 0};
      if (np_run(v, old, 0, 50, &r, why, sizeof why)) die("old release-run");
      { size_t n = r.errn < sizeof o - 1 ? r.errn : sizeof o - 1; for (size_t i = 0; i < n; i++) o[i] = r.err[i]; o[n] = 0; }
      ck(r.rc == 2 && has(o, "release-run: REFUSE usage") && !has(o, "RELEASE_EXEC") && !has(o, "release-exec: REFUSE"), "N0.old-release-run-has-no-execute");
      np_free(&r); }
}
