    fixture(99, 3, 0, 1); expect_gate("G1.batch-candidate-differs", rx("--dry", 0, 0, 0), "CANDIDATE_SHA");
    fixture(99, 4, 0, 1); rc = rx("--dry", 0, 0, 0);
