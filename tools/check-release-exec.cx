    ck(has(out, "CMD\t2\tDRY\tgh -R example/fixture release create v0.0.99 --draft --title 0.0.99 --target 1111111111111111111111111111111111111111") &&
       has(out, "CMD\t3\tDRY\tgh -R example/fixture workflow run candidate-native.yml --ref v0.0.99 -f release_tag=v0.0.99") &&
       has(out, "CMD\t5\tDRY\tgh -R example/fixture release edit v0.0.99 --draft=false --latest"), "D1.commands-expanded");
    ck(has(out, "GATE\t1\tX_PUSHED\tDEFERRED") && has(out, "GATE\t6\tREADBACK\tDEFERRED") && !has(out, "GATE\t6\tREADBACK\tPASS"), "D1.external-state-deferred-not-pass");
    ck(c && !has(c, "gh ") && !has(c, "unisacc tools/devsvc") && !has(c, "unisacc release/tools/c47-1-readback"), "D1.dry-zero-gh-zero-commit-zero-readback");
    free(c);
