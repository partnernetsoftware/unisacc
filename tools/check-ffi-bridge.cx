/* tools/check-ffi-bridge.cx -- the bridge-mode switch and its named refusals (C44 FFI step 1b).
 *
 *   sh ./unisacc.com tools/check-ffi-bridge.cx
 *
 * UNISA_FFI_BRIDGE selects the marcher: force / off / unset / anything else (refused by name).
 * Until the in-tree assembly bridge is linked into the product image, bridge mode must refuse
 * every call by name -- never mis-marshal one silently. Arguments point at values: a pointer
 * argument is `&pointer`, not the pointer. */
#pragma unisa use sys.ffi
#pragma unisa use sys.env
#pragma unisa use text.text

static int assertions, failed;
static void ok(int cond, const char *name) {
    assertions++;
    if (!cond) failed++;
    printf("%s\t%s\n", cond ? "PASS" : "FAIL", name);
}

int main(void) {
    void *h = sy_ffi_default();
    void *fn = sy_ffi_dlsym(h, "getpid");
    int kinds[2];
    void *vals[2];
    int out = 0, r;
    double d = 1.0, dout = 0;

    ok(tx_find(sy_ffi_last_error(), 64, "", 0) >= 0, "last-error-starts-empty");

    sy_setenv("UNISA_FFI_BRIDGE", "force", 1);
    ok(sy_ffi_set_bridge_mode(-1) == 0, "mode-init-from-env");
    r = sy_ffi_call(fn, SY_FFI_INT, 0, 0, 0, 0, &out);
    ok(r < 0 && tx_find(sy_ffi_last_error(), 128, "not linked in this build") >= 0, "force-refuses-integer");

    kinds[0] = SY_FFI_DOUBLE; vals[0] = &d;
    r = sy_ffi_call(fn, SY_FFI_INT, kinds, vals, 1, 1, &out);
    ok(r < 0 && tx_find(sy_ffi_last_error(), 128, "floating-point") >= 0, "force-refuses-double-arg");

    r = sy_ffi_call(fn, SY_FFI_DOUBLE, 0, 0, 0, 1, &dout);
    ok(r < 0 && tx_find(sy_ffi_last_error(), 128, "floating-point") >= 0, "force-refuses-double-result");

    sy_setenv("UNISA_FFI_BRIDGE", "off", 1);
    ok(sy_ffi_set_bridge_mode(-1) == 0, "mode-off");
    out = 0;
    r = sy_ffi_call(fn, SY_FFI_INT, 0, 0, 0, 0, &out);
    ok(r == 0 && out > 0, "off-uses-libffi");

    sy_setenv("UNISA_FFI_BRIDGE", "nonsense", 1);
    ok(sy_ffi_set_bridge_mode(-1) != 0 && tx_find(sy_ffi_last_error(), 128, "unknown value") >= 0, "unknown-value-refused");

    printf("FFI_BRIDGE\tassertions=%d\tfailed=%d\n", assertions, failed);
    return failed ? 1 : 0;
}
