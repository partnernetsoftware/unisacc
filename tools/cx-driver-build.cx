/* Independent compilation units, then link. No saved test results.
 * ROOT BUILDER IDENTITY_HELPER NEW_OR_EXISTING_OUT STEP [ABS_MODELS EXPECTED_SHA256 [TARGET]]
 * The native provider supports Linux and macOS x86_64/arm64; a selected
 * package must supply the corresponding unit-object route. */
#pragma unisa use cxlib.netpack
static const char *build_target="lnx/x86_64";
static void fail(const char *s){fprintf(stderr,"cx-driver-build: %s errno=%d\n",s,errno);exit(2);}
static void join(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)fail("path-bound");}
static void hash(const char *p,char h[65]){size_t n;char *s=cx_read(p,&n);if(!s)fail("read-input");cx_sha256_hex(s,n,h);free(s);}
static void absent(const char *p){struct stat st;errno=0;if(!lstat(p,&st)||errno!=ENOENT)fail("output-must-not-exist");}
static void save(const char *p,const char *s){FILE *f=fopen(p,"wx");if(!f||fwrite(s,1,strlen(s),f)!=strlen(s)||fclose(f))fail("write-record");}
static void sid(const char *root,const char *helper,char h[65]){
 char *v[]={(char *)helper,(char *)root,0};np_result r={0};char why[1024];
 if(np_run(v,root,0,8,&r,why,sizeof why)||r.rc||r.errn||r.outn!=65||r.out[64]!='\n')fail("source-identity");
 for(int i=0;i<64;i++)if(!((r.out[i]>='0'&&r.out[i]<='9')||(r.out[i]>='a'&&r.out[i]<='f')))fail("source-identity-shape");
 memcpy(h,r.out,64);h[64]=0;np_free(&r);
}
static void receipt(char *s,size_t cap,const char *source,const char *builder,const char *identity,const char *tool,const char *netpack,const char *models,const char *step,const char *artifact){
 const char *flags=!strcmp(step,"driver")?"-O0 -c -funit":!strcmp(step,"link")?"default-link":"-O2 -c -funit";
 int n=snprintf(s,cap,"CXDRIVERUNIT4\nsource\t%s\nbuilder\t%s\nidentity\t%s\ntool\t%s\nnetpack\t%s\nmodels\t%s\ntarget\t%s\nstep\t%s\nflags\t%s\nartifact\t%s\n",source,builder,identity,tool,netpack,models,build_target,step,flags,artifact);if(n<0||(size_t)n>=cap)fail("receipt-bound");
}
int main(int argc,char **argv){
 if(argc<6||argc>9)fail("usage ROOT BUILDER IDENTITY_HELPER OUT STEP [ABS_MODELS EXPECTED_SHA256 [TARGET]]");
 if(argc==7)fail("expected-model-hash-required");
 if(argc==9){build_target=argv[8];if(strcmp(build_target,"lnx/x86_64")&&strcmp(build_target,"lnx/arm64")&&strcmp(build_target,"osx/x86_64")&&strcmp(build_target,"osx/arm64"))fail("unsupported-target");}
 /* An inherited override would silently replace the builder's embedded models,
    while the receipt only binds the builder bytes. */
 if(argc==6&&getenv("UNISA_CONTAINER"))fail("unbound-model-override");
 char root[4096],builder[4096],ident[4096],out[4096],self[4096];
 if(!realpath(argv[1],root)||!realpath(argv[2],builder)||!realpath(argv[3],ident)||!realpath(__FILE__,self))fail("resolve-inputs");
 if(mkdir(argv[4],0700)&&errno!=EEXIST)fail("mkdir");struct stat st;
 if(lstat(argv[4],&st)||!S_ISDIR(st.st_mode)||!realpath(argv[4],out))fail("output-directory");
 char modelpath[4096],modelhash[65];int external=argc>=7;
 if(external){if(argv[6][0]!='/'||lstat(argv[6],&st)||!S_ISREG(st.st_mode)||!realpath(argv[6],modelpath))fail("model-path");hash(modelpath,modelhash);if(strcmp(modelhash,argv[7]))fail("model-identity-mismatch");}else strcpy(modelhash,"embedded");
 const char *names[]={"driver","output","native","deps","input","path","args","cli","compat","environment","archive","route","codec","footer","attrframe","modelnumber","lifetime","modeldecode","packagelifetime","packagedecode","transition","execution","alu","stack","coreoutput","sparse","bytes","sourceframe","tapelink","asmtext","fwdstub","cxmod","fwdmerge","memlayout","fwdsig","fwdincrement","peimport","hostbind","routespan","routestep","routetime","modelload","runexec","stagehandoff","binddep","bindonly","bindgate","bindtarget","bindret","bindimage","bindrun","bindexec","bindargs","bindcount","bindsym","bindhost","srcgate","tapegate","prunegate","frontparse","frontpp","backlower","backimage","optgate","backencode","libgate","compilergate","rungate","coregate","bindpure","maingate","imagegate","optmore","linkmore","parsemore","floatgate","bindtemp","bindkey","bindsplit","bindstage","bindfilter","link"};int step=-1;for(int i=0;i<82;i++)if(!strcmp(argv[5],names[i]))step=i;if(step<0)fail("unknown-step");
 char source[65],bh[65],ih[65],th[65],nh[65],after[65],artifact[65],record[1024],netpack[4400];join(netpack,root,"tools/cxlib/netpack.cx");sid(root,ident,source);hash(builder,bh);hash(ident,ih);hash(self,th);hash(netpack,nh);
 int osx=!strncmp(build_target,"osx/",4);
 const char *files[]={"driver.o","output.o","native.o","deps.o","input.o","path.o","args.o","cli.o","compat.o","environment.o","archive.o","route.o","codec.o","footer.o","attrframe.o","modelnumber.o","lifetime.o","modeldecode.o","packagelifetime.o","packagedecode.o","transition.o","execution.o","alu.o","stack.o","coreoutput.o","sparse.o","bytes.o","sourceframe.o","tapelink.o","asmtext.o","fwdstub.o","cxmod.o","fwdmerge.o","memlayout.o","fwdsig.o","fwdincrement.o","peimport.o","hostbind.o","routespan.o","routestep.o","routetime.o","modelload.o","runexec.o","stagehandoff.o","binddep.o","bindonly.o","bindgate.o","bindtarget.o","bindret.o","bindimage.o","bindrun.o","bindexec.o","bindargs.o","bindcount.o","bindsym.o","bindhost.o","srcgate.o","tapegate.o","prunegate.o","frontparse.o","frontpp.o","backlower.o","backimage.o","optgate.o","backencode.o","libgate.o","compilergate.o","rungate.o","coregate.o","bindpure.o","maingate.o","imagegate.o","optmore.o","linkmore.o","parsemore.o","floatgate.o","bindtemp.o","bindkey.o","bindsplit.o","bindstage.o","bindfilter.o",osx?"driver.macho":"driver.elf"};char objs[81][4400],output[4400],rp[4400],leaf[100];
 for(int i=0;i<81;i++)join(objs[i],out,files[i]);join(output,out,files[step]);absent(output);
 { if (cx_fmt(leaf,sizeof leaf,"%s.receipt",names[step])) { fprintf(stderr, "cx-driver-build: text too long for leaf\n"); exit(2); } }join(rp,out,leaf);absent(rp);
 if(step==81)for(int i=0;i<81;i++){
  hash(objs[i],artifact);receipt(record,sizeof record,source,bh,ih,th,nh,modelhash,names[i],artifact);
  char p[4400];{ if (cx_fmt(leaf,sizeof leaf,"%s.receipt",names[i])) { fprintf(stderr, "cx-driver-build: text too long for leaf\n"); exit(2); } }join(p,out,leaf);size_t n;char *s=cx_read(p,&n);
  if(!s||n!=strlen(record)||memcmp(s,record,n))fail("unit-receipt-or-source-mismatch");free(s);
 }
 char bound[4400],headers[4400],quotes[4400],src[4400];join(bound,root,"tools/bound");join(headers,root,"include");join(quotes,root,"exec/c");
 const char *sources[]={"exec/c/asmcompiler.c","cx/driver/output.cx",osx?"cx/runtime/process_group_osx.cx":"cx/runtime/process_group.cx","cx/driver/deps.cx","cx/driver/input.cx","cx/driver/path.cx","cx/driver/args.cx","cx/driver/cli.cx","cx/driver/compat.cx","cx/driver/environment.cx","cx/driver/archive.cx","cx/driver/route.cx","cx/runtime/codec.cx","cx/runtime/packagefooter.cx","cx/runtime/attribute_frame.cx","cx/runtime/model_number.cx","cx/runtime/model_lifetime.cx","cx/runtime/model_decode.cx","cx/runtime/package_lifetime.cx","cx/runtime/package_decode.cx","cx/core/transition.cx","cx/core/execute.cx","cx/core/alu.cx","cx/core/stack.cx","cx/core/output.cx","cx/core/sparse.cx","cx/core/bytes.cx","cx/runtime/source_frame.cx","cx/compiler/tapelink.cx","cx/compiler/asmtext.cx","cx/compiler/fwdstub.cx","cx/compiler/cxmod.cx","cx/compiler/fwdmerge.cx","cx/runtime/memlayout.cx","cx/compiler/fwdsig.cx","cx/compiler/fwdincrement.cx","cx/runtime/peimport.cx","cx/compiler/hostbind.cx","cx/runtime/routespan.cx","cx/runtime/routestep.cx","cx/runtime/routetime.cx","cx/runtime/modelload.cx","cx/runtime/runexec.cx","cx/runtime/stagehandoff.cx","cx/compiler/binddep.cx","cx/compiler/bindonly.cx","cx/compiler/bindgate.cx","cx/compiler/bindtarget.cx","cx/compiler/bindret.cx","cx/compiler/bindimage.cx","cx/compiler/bindrun.cx","cx/compiler/bindexec.cx","cx/compiler/bindargs.cx","cx/compiler/bindcount.cx","cx/compiler/bindsym.cx","cx/compiler/bindhost.cx","cx/compiler/srcgate.cx","cx/compiler/tapegate.cx","cx/compiler/prunegate.cx","cx/compiler/frontparse.cx","cx/compiler/frontpp.cx","cx/compiler/backlower.cx","cx/compiler/backimage.cx","cx/compiler/optgate.cx","cx/compiler/backencode.cx","cx/compiler/libgate.cx","cx/compiler/compilergate.cx","cx/compiler/rungate.cx","cx/core/coregate.cx","cx/compiler/bindpure.cx","cx/compiler/maingate.cx","cx/compiler/imagegate.cx","cx/compiler/optmore.cx","cx/compiler/linkmore.cx","cx/compiler/parsemore.cx","cx/compiler/floatgate.cx","cx/compiler/bindtemp.cx","cx/compiler/bindkey.cx","cx/compiler/bindsplit.cx","cx/compiler/bindstage.cx","cx/compiler/bindfilter.cx"};if(step<81)join(src,root,sources[step]);
 /* The large transitional driver is compiled at O0 to stay within the
    watchdog; smaller independent modules remain O2. The flags are receipted. */
 char *compile[]={bound,"50","sh",builder,"--models",modelpath,step==0?"-O0":"-O2","-I",headers,"-iquote",quotes,"-b",(char *)build_target,"-c","-funit",src,"-o",output,0};
 char *linkv[]={bound,"50","sh",builder,"--models",modelpath,"-b",(char *)build_target,objs[0],objs[1],objs[2],objs[3],objs[4],objs[5],objs[6],objs[7],objs[8],objs[9],objs[10],objs[11],objs[12],objs[13],objs[14],objs[15],objs[16],objs[17],objs[18],objs[19],objs[20],objs[21],objs[22],objs[23],objs[24],objs[25],objs[26],objs[27],objs[28],objs[29],objs[30],objs[31],objs[32],objs[33],objs[34],objs[35],objs[36],objs[37],objs[38],objs[39],objs[40],objs[41],objs[42],objs[43],objs[44],objs[45],objs[46],objs[47],objs[48],objs[49],objs[50],objs[51],objs[52],objs[53],objs[54],objs[55],objs[56],objs[57],objs[58],objs[59],objs[60],objs[61],objs[62],objs[63],objs[64],objs[65],objs[66],objs[67],objs[68],objs[69],objs[70],objs[71],objs[72],objs[73],objs[74],objs[75],objs[76],objs[77],objs[78],objs[79],objs[80],"-o",output,0};
 if(!external){for(int i=4;;i++){compile[i]=compile[i+2];if(!compile[i])break;}for(int i=4;;i++){linkv[i]=linkv[i+2];if(!linkv[i])break;}}
 /* Native ELF builders are executed directly so the receipted builder hash
    covers the program itself. APE and shell entrypoints still use sh. */
 size_t builder_n;char *builder_bytes=cx_read(builder,&builder_n);if(!builder_bytes)fail("read-builder");
 int native=builder_n>=4&&!memcmp(builder_bytes,"\177ELF",4);free(builder_bytes);
 if(native){for(int i=2;;i++){compile[i]=compile[i+1];if(!compile[i])break;}for(int i=2;;i++){linkv[i]=linkv[i+1];if(!linkv[i])break;}}
 np_result r={0};char why[1024];if(np_run(step==81?linkv:compile,root,0,52,&r,why,sizeof why))fail(why);
 if(r.outn)fwrite(r.out,1,r.outn,stdout);if(r.errn)fwrite(r.err,1,r.errn,stderr);
 if(r.rc){fprintf(stderr,"cx-driver-build: step=%s child_rc=%d stdout_bytes=%ld stderr_bytes=%ld\n",names[step],r.rc,(long)r.outn,(long)r.errn);np_free(&r);fail("unit-command-failed");}np_free(&r);
 sid(root,ident,after);if(strcmp(source,after))fail("source-changed");hash(builder,after);if(strcmp(bh,after))fail("builder-changed");hash(ident,after);if(strcmp(ih,after))fail("identity-helper-changed");hash(self,after);if(strcmp(th,after))fail("tool-changed");hash(netpack,after);if(strcmp(nh,after))fail("netpack-changed");
 if(step==81)for(int i=0;i<81;i++){
  hash(objs[i],artifact);receipt(record,sizeof record,source,bh,ih,th,nh,modelhash,names[i],artifact);
  char p[4400];{ if (cx_fmt(leaf,sizeof leaf,"%s.receipt",names[i])) { fprintf(stderr, "cx-driver-build: text too long for leaf\n"); exit(2); } }join(p,out,leaf);size_t n;char *s=cx_read(p,&n);
  if(!s||n!=strlen(record)||memcmp(s,record,n))fail("unit-changed-during-link");free(s);
 }
 if(external){hash(modelpath,after);if(strcmp(modelhash,after))fail("models-changed");}
 hash(output,artifact);receipt(record,sizeof record,source,bh,ih,th,nh,modelhash,names[step],artifact);save(rp,record);
 printf("CXDRIVER_BUILD\tstep=%s\tartifact=%s\tsource=%s\tPREPARED_NOT_TESTED\n",names[step],artifact,source);return 0;
}
