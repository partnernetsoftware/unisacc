/* Real independently prepared source/object fixture; no fabricated inventory verification. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sysx.process
#pragma unisa use text.text
static char home[4400],work[4400],com[4400],tool[4400],invtool[4400],src[4400],obj[4400],ctor[4400],inv[4400],seal[4400],receipt[4400],replay[4400];
static int checks,failed;
static void die(const char *s){fprintf(stderr,"check-object-source-replay: %s\n",s);exit(2);}
static void path(char *p,const char *a,const char *b){if(cx_fmt(p,4400,"%s/%s",a,b))die("path");}
static void put(const char *p,const char *s){if(cx_write(p,s,strlen(s)))die("write");}
static char *readfile(const char *p,size_t *n){char *b=cx_read(p,n);if(!b)die("read");return b;}
static void copyfile(const char *a,const char *b){size_t n;char *s=readfile(a,&n);if(cx_write(b,s,n))die("copy");free(s);}
static long hash(const char *p,char h[65]){size_t n;char *b=readfile(p,&n);if(sy_sha256_hex(b,(long)n,h))cx_sha256_hex(b,n,h);free(b);return (long)n;}
static np_result run(char **v,int expect,const char *label,const char *needle){np_result r={0};char why[1024];int tr=np_run(v,home,0,!strcmp(label,"real-inventory-verified")?30:8,&r,why,sizeof why);int ok=!tr&&!r.residue&&r.rc==expect&&(!needle||(r.err&&strstr(r.err,needle)));checks++;failed+=!ok;printf("%s\t%s\n",ok?"PASS":"FAIL",label);if(!ok){fprintf(stderr,"transport=%d rc=%d %s\n",tr,r.rc,why);if(r.err)fwrite(r.err,1,r.errn,stderr);}return r;}
static void replaycase(const char *start,int expect,const char *label,const char *needle){char *v[]={"sh",com,tool,"--","--inventory",inv,"--slice",work,"--sources",seal,"--out",replay,"--start",(char *)start,"--count","1",0};np_result r=run(v,expect,label,needle);np_free(&r);}
static void replace(const char *file,const char *old,const char *value){size_t n;char *s=readfile(file,&n),*at=strstr(s,old);if(!at||strstr(at+strlen(old),old))die("exact replacement");size_t a=(size_t)(at-s),o=strlen(old),v=strlen(value);char *b=malloc(n-o+v+1);if(!b)die("alloc");memcpy(b,s,a);memcpy(b+a,value,v);memcpy(b+a+v,s+a+o,n-a-o);if(cx_write(file,b,n-o+v))die("replace");free(b);free(s);}
int main(void){if(!realpath(".",home))die("home");snprintf(work,sizeof work,"%s/out/object-source-replay-check-XXXXXX",home);if(!mkdtemp(work))die("temp");path(com,home,"unisacc.com");path(tool,home,"tools/object-source-replay.cx");path(invtool,home,"tools/slice-inventory.cx");path(src,work,"probe.cx");path(obj,work,"probe.o");path(ctor,work,"unisacc.com");path(inv,work,"inventory.tsv");path(seal,work,"sources.tsv");path(receipt,work,"receipt.txt");path(replay,work,"replayed");copyfile(com,ctor);put(src,"int proof(void){return 37;}\n");
 char *build[]={"sh",ctor,"-O2","-c","-b","lnx/x86_64","-funit","-o",obj,src,0};np_result r=run(build,0,"real-source-object-prepared",0);np_free(&r);
 char cs[65],os[65];long cb=hash(ctor,cs),ob=hash(obj,os);FILE *f=fopen(receipt,"wb");if(!f)die("receipt");fprintf(f,"entry-build-v3\nroot\t%s\np3\t%s\np3_sha\t%s\nconstructor\t%s\nconstructor_sha\t%s\nconstructor_bytes\t%ld\nvia\tsh\nobject_level\tmode=default\tall=-O2\ttarget=lnx/x86_64\nprobe.o\tsha=%s\tbytes=%ld\tsrc=-\n",work,ctor,cs,ctor,cs,cb,os,ob);if(fclose(f))die("close");char p[4400];path(p,work,"tools");if(mkdir(p,0700))die("tools");path(p,work,"tools/entry-build.cx");put(p,"#define EB_OBJ 1\nvoid roots(void){keys[0]=\"probe.o\";src_rel[0]=\"probe.cx\";}\n");
 char *inventory[]={"sh",com,invtool,"--","--slice",work,"--tools-root",home,0};r=run(inventory,0,"real-inventory-verified",0);if(r.rc||!r.out||!strstr(r.out,"identity=VERIFIED"))die("inventory preparation incomplete");if(cx_write(inv,r.out,r.outn))die("inventory capture");np_free(&r);
 char *prepare[]={"sh",com,tool,"--","--inventory",inv,"--slice",work,"--sources",seal,"--prepare",0};r=run(prepare,0,"seal-prepared-not-pass",0);np_free(&r);
 replaycase("0",0,"actual-object-byte-replay",0);
 replaycase("0",2,"new-output-required","new output directory");
 char bak[4400];path(bak,work,"original.o");copyfile(obj,bak);put(obj,"corrupt\n");replaycase("0",2,"tampered-object-refused","original object identity");copyfile(bak,obj);
 path(bak,work,"constructor.bak");copyfile(ctor,bak);put(ctor,"changed\n");replaycase("0",2,"tampered-constructor-refused","constructor identity");copyfile(bak,ctor);
 put(src,"/* changed comment */\nint proof(void){return 37;}\n");replaycase("0",2,"tampered-source-refused","source SHA seal mismatch");put(src,"int proof(void){return 37;}\n");
 replaycase("9",2,"out-of-range-refused","batch range");
 replace(inv,"\tprobe.cx\t","\t../probe.cx\t");replaycase("0",2,"unsafe-source-refused","unsafe planned source");
 printf("OBJECT_SOURCE_REPLAY_CHECK\tchecks=%d\tfailed=%d\twork=%s\n",checks,failed,work);return failed?1:0;
}
