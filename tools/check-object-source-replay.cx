/* Real independently prepared source/object fixture; no fabricated inventory verification. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sys.env
#pragma unisa use sysx.process
#pragma unisa use text.text
#pragma unisa use mem.bytes
static char home[4400],work[4400],com[4400],tool[4400],invtool[4400],src[4400],obj[4400],ctor[4400],inv[4400],seal[4400],receipt[4400],replay[4400];
static int checks,failed,part_number;static const char *fixture_target="lnx/x86_64";
static void die(const char *s){fprintf(stderr,"check-object-source-replay: %s\n",s);exit(2);}
static void path(char *p,const char *a,const char *b){if(cx_fmt(p,4400,"%s/%s",a,b))die("path");}
static void put(const char *p,const char *s){if(cx_write(p,s,strlen(s)))die("write");}
static char *readfile(const char *p,size_t *n){char *b=cx_read(p,n);if(!b)die("read");return b;}
static void copyfile(const char *a,const char *b){size_t n;char *s=readfile(a,&n);if(cx_write(b,s,n))die("copy");free(s);}
static long hash(const char *p,char h[65]){size_t n;char *b=readfile(p,&n);if(sy_sha256_hex(b,(long)n,h))cx_sha256_hex(b,n,h);free(b);return (long)n;}
static np_result run(char **v,int expect,const char *label,const char *needle){np_result r={0};char why[1024];int secs=!strcmp(label,"entry-cache-named-refusal")?55:(!strcmp(label,"real-inventory-verified")?30:8);int tr=np_run(v,home,0,secs,&r,why,sizeof why);int ok=!tr&&!r.residue&&r.rc==expect&&(!needle||(r.err&&strstr(r.err,needle)));checks++;failed+=!ok;printf("%s\t%s\n",ok?"PASS":"FAIL",label);if(!ok){fprintf(stderr,"transport=%d rc=%d %s\n",tr,r.rc,why);if(r.err)fwrite(r.err,1,r.errn,stderr);}return r;}
static void replaycase(const char *start,int expect,const char *label,const char *needle){char *v[]={"sh",com,tool,"--","--inventory",inv,"--slice",work,"--sources",seal,"--out",replay,"--start",(char *)start,"--count","1",0};np_result r=run(v,expect,label,needle);np_free(&r);}
static void replace(const char *file,const char *old,const char *value){size_t n;char *s=readfile(file,&n),*at=strstr(s,old);if(!at||strstr(at+strlen(old),old))die("exact replacement");size_t a=(size_t)(at-s),o=strlen(old),v=strlen(value);char *b=malloc(n-o+v+1);if(!b)die("alloc");mm_copy(b, a, s, a);mm_copy(b+a, v, value, v);mm_copy(b+a+v, n-a-o, s+a+o, n-a-o);if(cx_write(file,b,n-o+v))die("replace");free(b);free(s);}
/* Opt-in probe of a real prepared split OUT. The caller removes/tampers
   KEY.cache or KEY first; no fabricated cache receipt is accepted. */
static int entry_cache_probe(int argc,char **argv){
 if(argc!=8)die("usage --entry-cache ROOT P3 OUT CONSTRUCTOR KEY REASON");
 if(!realpath(".",home))die("home");path(com,home,"unisacc.com");path(tool,home,"tools/entry-build.cx");
 char *v[]={"sh",com,tool,"--",argv[2],argv[3],argv[4],argv[5],"--link-only",0};
 np_result r=run(v,1,"entry-cache-named-refusal",argv[6]);
 int ok=r.err&&strstr(r.err,"entry-build: REFUSE ")&&strstr(r.err,argv[7]);
 checks++;failed+=!ok;printf("%s\tentry-cache-reason\n",ok?"PASS":"FAIL");np_free(&r);
 printf("ENTRY_CACHE_CHECK\tchecks=%d\tfailed=%d\n",checks,failed);return failed?1:0;
}
int main(int argc,char **argv){if(argc>1&&!strcmp(argv[1],"--entry-cache"))return entry_cache_probe(argc,argv);int arm=0;for(int i=1;i<argc;i++){if(!strcmp(argv[i],"--arm64")&&!arm){arm=1;fixture_target="lnx/arm64";}else if(!strcmp(argv[i],"--part")&&!part_number&&i+1<argc&&strlen(argv[i+1])==1&&argv[i+1][0]>='1'&&argv[i+1][0]<='3')part_number=argv[++i][0]-'0';else die("usage [--arm64] [--part 1|2|3] | --entry-cache ROOT P3 OUT CONSTRUCTOR KEY REASON");}if(!realpath(".",home))die("home");(cx_fmt(work, sizeof work, "%s/object-source-replay-check-XXXXXX", sy_tmpdir()) ? exit(2) : (void)0);if(!mkdtemp(work))die("temp");path(com,home,"unisacc.com");path(tool,home,"tools/object-source-replay.cx");path(invtool,home,"tools/slice-inventory.cx");path(src,work,"probe.cx");path(obj,work,"probe.o");path(ctor,work,"unisacc.com");path(inv,work,"inventory.tsv");path(seal,work,"sources.tsv");path(receipt,work,"receipt.txt");path(replay,work,"replayed");copyfile(com,ctor);put(src,"int proof(void){return 37;}\n");
 char *build[]={"sh",ctor,"-O2","-c","-b",(char *)fixture_target,"-funit","-o",obj,src,0};np_result r=run(build,0,"real-source-object-prepared",0);np_free(&r);
 char cs[65],os[65];long cb=hash(ctor,cs),ob=hash(obj,os);FILE *f=fopen(receipt,"wb");if(!f)die("receipt");fprintf(f,"entry-build-v3\nroot\t%s\np3\t%s\np3_sha\t%s\nconstructor\t%s\nconstructor_sha\t%s\nconstructor_bytes\t%ld\nvia\tsh\nobject_level\tmode=default\tall=-O2\ttarget=%s\nprobe.o\tsha=%s\tbytes=%ld\tsrc=-\n",work,ctor,cs,ctor,cs,cb,fixture_target,os,ob);if(fclose(f))die("close");char p[4400];path(p,work,"tools");if(mkdir(p,0700))die("tools");path(p,work,"tools/entry-build.cx");put(p,"#define EB_OBJ 1\nvoid roots(void){keys[0]=\"probe.o\";src_rel[0]=\"probe.cx\";}\n");
 char *inventory[]={"sh",com,invtool,"--","--slice",work,"--tools-root",home,0};r=run(inventory,0,"real-inventory-verified",0);if(r.rc||!r.out||!strstr(r.out,"identity=VERIFIED"))die("inventory preparation incomplete");if(cx_write(inv,r.out,r.outn))die("inventory capture");np_free(&r);
 char *prepare[]={"sh",com,tool,"--","--inventory",inv,"--slice",work,"--sources",seal,"--prepare",0};r=run(prepare,0,"seal-prepared-not-pass",0);np_free(&r);
 replaycase("0",0,"actual-object-byte-replay",0);
 char target_old[64],target_other[64];(cx_fmt(target_old, sizeof target_old, "target=%s", fixture_target) ? exit(2) : (void)0);(cx_fmt(target_other, sizeof target_other, "target=%s", !strcmp(fixture_target,"lnx/arm64")?"lnx/x86_64":"lnx/arm64") ? exit(2) : (void)0);
 if(!part_number||part_number==1){
 replace(inv,target_old,target_other);replaycase("0",2,"inventory-target-mismatch-refused","inventory identity/target");replace(inv,target_other,target_old);
 replace(receipt,target_old,"target=osx/arm64");replaycase("0",2,"nonlinux-receipt-refused","object flags/target");replace(receipt,"target=osx/arm64",target_old);
 char duplicate[128];(cx_fmt(duplicate, sizeof duplicate, "%s\ttarget=lnx/arm64", target_old) ? exit(2) : (void)0);replace(receipt,target_old,duplicate);replaycase("0",2,"duplicate-target-refused","duplicate field");replace(receipt,duplicate,target_old);
 }
 if(!part_number||part_number==2){
 replaycase("0",2,"new-output-required","new output directory");
 char bak[4400];path(bak,work,"original.o");copyfile(obj,bak);put(obj,"corrupt\n");replaycase("0",2,"tampered-object-refused","original object identity");copyfile(bak,obj);
 path(bak,work,"constructor.bak");copyfile(ctor,bak);put(ctor,"changed\n");replaycase("0",2,"tampered-constructor-refused","constructor identity");copyfile(bak,ctor);
 }
 if(!part_number||part_number==3){
 put(src,"/* changed comment */\nint proof(void){return 37;}\n");replaycase("0",2,"tampered-source-refused","source SHA seal mismatch");put(src,"int proof(void){return 37;}\n");
 replaycase("9",2,"out-of-range-refused","batch range");
 replace(inv,"\tprobe.cx\t","\t../probe.cx\t");replaycase("0",2,"unsafe-source-refused","unsafe planned source");
 }
 printf("OBJECT_SOURCE_REPLAY_CHECK\tchecks=%d\tfailed=%d\twork=%s\ttarget=%s\n",checks,failed,work,fixture_target);return failed?1:0;
}
