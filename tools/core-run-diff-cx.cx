#pragma unisa use core.execute
#pragma unisa use core.transition
#pragma unisa use core.alu
#pragma unisa use core.sparse
#pragma unisa use core.bytes
#pragma unisa use core.stack
#pragma unisa use core.output
#pragma unisa use core.memory
#pragma unisa use core_run_spec
#pragma unisa use sys.io
#pragma unisa use sys.sha
/* One half of the core_run differential (tools/check-core-run-diff.cx): run the CX execution
   kernel of cx/core/execute.cx on a fixed model and print the outcome as one line.  The structs
   stay in core_run_spec, so this driver only owns the prototype it links against. */
/* The CX kernel calls these two host hooks; the fetch hook is only reached by a model action that
   this model never runs, so declining is enough. */
void core_host_panic(const char *reason) { sy_eprintf("core-run-diff-cx: panic: %s\n", reason ? reason : "?"); }
int core_run(const void *m, unsigned char *input, int inputn, const char *src, long long maxsteps, void *result);
static unsigned char model[2048];
static unsigned char outcome[256];
static const char empty[1] = {0};
int main(int argc, char **argv) {
    int ci, in_n = 0;
    const unsigned char *in;
    const void *ob, *eb;
    char oh[65], eh[65];
    int st;
    if (argc != 2 || argv[1][0] < '0' || argv[1][0] > '2' || argv[1][1]) { sy_eprintf("usage: core-run-diff-cx.cx CASE\n"); return 2; }
    ci = argv[1][0] - '0';
    in = crs_case(ci, &in_n);
    if (!in) { sy_eprintf("core-run-diff-cx: bad case\n"); return 2; }
    if (crs_model_size() > (long)sizeof model || crs_result_size() > (long)sizeof outcome) { sy_eprintf("core-run-diff-cx: buffer too small\n"); return 2; }
    if (crs_fill(model)) { sy_eprintf("core-run-diff-cx: model fill\n"); return 2; }
    st = core_run(model, (unsigned char *)in, in_n, crs_src(), 1000, outcome);
    ob = crs_out_b(outcome); eb = crs_err_b(outcome);
    sy_sha256_hex(ob ? ob : empty, crs_out_n(outcome), oh);
    sy_sha256_hex(eb ? eb : empty, crs_err_n(outcome), eh);
    sy_printf("CORE_RUN case=%d st=%d outn=%d errn=%d outsha=%s errsha=%s\n",
              ci, st, crs_out_n(outcome), crs_err_n(outcome), oh, eh);
    return 0;
}
