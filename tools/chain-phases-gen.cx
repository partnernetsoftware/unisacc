/* Build metadata: --write regenerates; --check compares canonical bytes.
 * Model facts never contain orchestration phases. */
#pragma unisa use sys.fs
#pragma unisa use mem.bytes
#pragma unisa use cxlib.chainfacts
#pragma unisa use cxlib.sourcepackage
static char bytes[131072];
static int used, count;
static const char *outer;
static char previous[80], lane_previous[80];
static int target_lane(const char *s) {
    return !strncmp(s,"gen1-",5)||!strncmp(s,"g2-lnx-",7)||!strncmp(s,"g3-lnx-",7)||!strncmp(s,"g2-osx-",7)||!strncmp(s,"g3-osx-",7)||!strncmp(s,"g2-win-",7)||!strncmp(s,"g3-win-",7)||!strncmp(s,"wf-",3);
}
static void emit(const char *id) {
    char deps[2048],domain[160]; const char *lane=target_lane(outer)?outer:"-";
    int legacy=!strncmp(id,"g2-lnx-",7)&&strstr(id,"-obj-");
    if(legacy) cx_fmt(deps,sizeof deps,"-");
    else if(strcmp(lane,"-")) {
        if(*lane_previous) cx_fmt(deps,sizeof deps,"%s",lane_previous);
        else if(!strncmp(lane,"wf-",3)) cx_fmt(deps,sizeof deps,!strstr(lane,"-g")?"gen1-lnx-x86_64":strstr(lane,"-g2")?"g2-lnx-x86_64":"g3-lnx-x86_64");
        else if(!strncmp(lane,"gen1-lnx-",9)) cx_fmt(deps,sizeof deps,"p3");
        else if(!strncmp(lane,"gen1-",5)) cx_fmt(deps,sizeof deps,"wf-prepare,wf-span-prep");
        else if(!strncmp(lane,"g2-lnx-",7)) cx_fmt(deps,sizeof deps,"gen1-lnx-x86_64");
        else if(!strncmp(lane,"g3-lnx-",7)) cx_fmt(deps,sizeof deps,!strcmp(lane,"g3-lnx-x86_64")?"g2-lnx-x86_64":"g2-lnx-x86_64,g2-lnx-arm64");
        else if(!strncmp(lane,"g3-",3)) cx_fmt(deps,sizeof deps,"wf-prep-g3,wf-span-prep-g3,g2-%s",lane+3);
        else cx_fmt(deps,sizeof deps,"wf-prep-g%c,wf-span-prep-g%c",lane[1],lane[1]);
    } else if(!strcmp(id,"kernels-g2")) cx_fmt(deps,sizeof deps,"g2-lnx-x86_64");
    else if(!strcmp(id,"kernels-g3")) cx_fmt(deps,sizeof deps,"g3-lnx-x86_64");
    else if(!strcmp(id,"compare")) cx_fmt(deps,sizeof deps,"gen1-lnx-x86_64,gen1-lnx-arm64,gen1-osx-x86_64,gen1-osx-arm64,gen1-win-x86_64,gen1-win-arm64,g2-lnx-x86_64,g2-lnx-arm64,g3-lnx-x86_64,g3-lnx-arm64,kernels-g2,kernels-g3,g2-osx-x86_64,g2-osx-arm64,g2-win-x86_64,g2-win-arm64,g3-osx-x86_64,g3-osx-arm64,g3-win-x86_64,g3-win-arm64");
    else cx_fmt(deps,sizeof deps,"%s",*previous?previous:"-");
    cx_fmt(domain,sizeof domain,"%s",strcmp(lane,"-")?lane:"outer");
    int n=snprintf(bytes+used,sizeof bytes-used,"%d\t%s\t%s\t90\t%s\t%s\t%d\n",count,id,domain,deps,lane,strcmp(lane,"-")?4:1);
    if(n<0||n>=(int)sizeof bytes-used){fprintf(stderr,"chain-phases-gen: output bound\n");exit(2);}
    used+=n;count++;
    if(!legacy) { cx_fmt(previous,sizeof previous,"%s",id); if(strcmp(lane,"-"))cx_fmt(lane_previous,sizeof lane_previous,"%s",id); }
}
/* Reject a stale generated library before deriving phase expansion. */
static int facts_current(void) {
    FILE *f=fopen("build/chain-facts.tsv","rb");
    char line[4400],want[4400];int row=0,ok=1;
    if(!f)return 0;
    while(fgets(line,sizeof line,f)) {
        size_t n=strlen(line);if(!n||line[n-1]!='\n'){ok=0;break;}
        if(line[0]=='#')continue;
        if(row==0){if(cx_fmt(want,sizeof want,"count\tnets\t%d\n",cf_net_count())){ok=0;break;}}
        else if(row==1){if(cx_fmt(want,sizeof want,"count\ttools\t%d\n",cf_tool_count())){ok=0;break;}}
        else if(row==2){if(cx_fmt(want,sizeof want,"count\tfront_slice\t%d\n",cf_front_slice())){ok=0;break;}}
        else if(row==3){if(cx_fmt(want,sizeof want,"count\twf_max\t%d\n",cf_wf_max())){ok=0;break;}}
        else if(row<4+cf_root_count()){if(cx_fmt(want,sizeof want,"root\t%s\t%s\n",cf_root_key(row-4),cf_root_source(row-4))){ok=0;break;}}
        else if(row<4+cf_root_count()+cf_p3_count()){if(cx_fmt(want,sizeof want,"p3\t%s\t-\n",cf_p3_phase(row-4-cf_root_count()))){ok=0;break;}}
        else {ok=0;break;}
        if(strcmp(line,want)){ok=0;break;}row++;
    }
    if(ferror(f)||row!=4+cf_root_count()+cf_p3_count())ok=0;
    if(fclose(f))ok=0;return ok;
}
int main(int argc, char **argv) {
    const char *dst = "build/chain-phases.tsv";
    const char *base[] = {"snap","build","ctx","host","list","warmup","jobs-tool","jobs-gen","jobs-tbl","jobs-net","final","routes","p3","gen1-lnx-x86_64","gen1-lnx-arm64","gen1-osx-x86_64","gen1-osx-arm64","gen1-win-x86_64","gen1-win-arm64","g2-lnx-x86_64","g2-lnx-arm64","g3-lnx-x86_64","g3-lnx-arm64","kernels-g2","kernels-g3","g2-osx-x86_64","g2-osx-arm64","g2-win-x86_64","g2-win-arm64","g3-osx-x86_64","g3-osx-arm64","g3-win-x86_64","g3-win-arm64","compare","pack"};
    if (argc != 2 || (strcmp(argv[1], "--write") && strcmp(argv[1], "--check"))) { fprintf(stderr, "chain-phases-gen: usage --write|--check\n"); return 2; }
    if(!facts_current()){fprintf(stderr,"chain-phases-gen: DIFF construction facts\n");return 1;}
    if(cf_net_count()!=sp_model_count()||cf_tool_count()!=sp_tool_count()){fprintf(stderr,"chain-phases-gen: DIFF network counts\n");return 1;}
    used = snprintf(bytes, sizeof bytes, "# order\tid\texclusive_dir\ttimeout_s\tdeps\tlane\tparallelism\n# generated by tools/chain-phases-gen.cx --write; do not edit\n");
    for (int i = 0; i < (int)(sizeof base / sizeof *base); i++) {
        outer=base[i]; lane_previous[0]=0;
        char id[80];
        if(!strcmp(base[i],"gen1-osx-x86_64")||!strcmp(base[i],"g2-osx-x86_64")||!strcmp(base[i],"g3-osx-x86_64")) {
            char prep[80];
            int gen=base[i][1]=='e'?1:base[i][1]-'0';
            if(gen==1)cx_fmt(prep,sizeof prep,"wf-prepare");else cx_fmt(prep,sizeof prep,"wf-prep-g%d",gen);
            outer=prep;lane_previous[0]=0;emit(prep);
            if(gen==1)cx_fmt(prep,sizeof prep,"wf-span-prep");else cx_fmt(prep,sizeof prep,"wf-span-prep-g%d",gen);
            outer=prep;lane_previous[0]=0;emit(prep);
            outer=base[i];lane_previous[0]=0;
        }
        if (!strcmp(base[i], "ctx")) { emit("wave-objects"); emit("wave-runner"); }
        if (!strcmp(base[i], "build")) { emit("build-objects"); emit("build-front"); }
        if (!strncmp(base[i], "gen1-lnx-", 9)) {
            if (cx_fmt(id, sizeof id, "%s-objects", base[i])) return 2;
            emit(id);
        }
        if (!strcmp(base[i], "final")) {
            for (int j = 0; j < cf_net_count(); j++) {
                if (cx_fmt(id, sizeof id, "final-net-%d", j)) return 2;
                emit(id);
            }
        }
        if (!strcmp(base[i], "p3")) {
            for (int j = 0; j < cf_p3_count(); j++) {
                if (cx_fmt(id, sizeof id, "p3-%s", cf_p3_phase(j))) return 2;
                emit(id);
            }
        }
        if (!strncmp(base[i], "jobs-", 5)) {
            int n = !strcmp(base[i], "jobs-tool") ? cf_tool_count() : cf_net_count();
            for (int j = 0; j < n; j++) for (int a = 0; a < 2; a++) {
                if (cx_fmt(id, sizeof id, "%s-%d-%s", base[i], j, a ? "finish" : "start")) return 2;
                emit(id);
            }
        } else if (!strcmp(base[i], "g2-lnx-x86_64") || !strcmp(base[i], "g2-lnx-arm64")) {
            for (int j = 0; j < cf_root_count(); j++) {
                if (cx_fmt(id, sizeof id, "%s-obj-%d", base[i], j)) return 2;
                emit(id);
            }
            if (cx_fmt(id, sizeof id, "%s-closure-prepare", base[i])) return 2;
            emit(id);
            if (cx_fmt(id, sizeof id, "%s-closure", base[i])) return 2;
            emit(id);
            if (cx_fmt(id, sizeof id, "%s-objects", base[i])) return 2;
            emit(id);
        } else if (!strncmp(base[i], "g3-lnx-", 7)) {
            if (cx_fmt(id, sizeof id, "%s-closure-prepare", base[i])) return 2;
            emit(id);
            if (cx_fmt(id, sizeof id, "%s-closure", base[i])) return 2;
            emit(id);
            if (cx_fmt(id, sizeof id, "%s-objects", base[i])) return 2;
            emit(id);
        }
        emit(base[i]);
    }
    if (!strcmp(argv[1], "--write")) { if (cx_write(dst, bytes, used)) return 2; }
    else { size_t n = 0; char *s = cx_read(dst, &n); int same = s && n == (size_t)used && !memcmp(s, bytes, n); free(s); if (!same) { fprintf(stderr, "chain-phases-gen: DIFF\n"); return 1; } }
    printf("CHAIN_PHASES\tstatus=%s\tn=%d\n", !strcmp(argv[1], "--write") ? "WRITE" : "CHECK", count);
    return 0;
}
