/* Build metadata: --write regenerates; --check compares canonical bytes.
 * Model facts never contain orchestration phases. */
#pragma unisa use sys.fs
#pragma unisa use mem.bytes
#pragma unisa use cxlib.chainfacts
#pragma unisa use cxlib.sourcepackage
#pragma unisa use cxlib.limits
static char bytes[131072];
static int used, count;
static const char *outer;
static char previous[80], lane_previous[80];
static int target_lane(const char *s) {
    return !strncmp(s,"gen1-",5)||!strncmp(s,"g2-lnx-",7)||!strncmp(s,"g3-lnx-",7)||!strncmp(s,"g2-osx-",7)||!strncmp(s,"g3-osx-",7)||!strncmp(s,"g2-win-",7)||!strncmp(s,"g3-win-",7)||!strncmp(s,"wf-",3);
}
/* Residue facts (build/chain-residue.tsv: phase, policy, record, paths) become columns 8..10.
 * A path is relative to the chain output dir: no leading '/', no "." or ".." component, no "//",
 * at least two components; one '*' is allowed in the last component of a path, never in a record. */
static char *res_text, *res_phase[64], *res_policy[64], *res_record[64], *res_paths[64];
static int res_n, res_used[64];
static void res_die(const char *why, const char *what) { fprintf(stderr, "chain-phases-gen: REFUSE residue fact %s: %s\n", why, what ? what : "-"); exit(2); }
static int res_rel(const char *s, size_t n, int glob) {
    size_t start = 0, slash = 0; int stars = 0;
    if (!n || s[0] == '/' || s[n - 1] == '/') return 0;
    for (size_t i = 0; i <= n; i++) {
        if (i < n && s[i] != '/') {
            char c = s[i];
            if (c == '*') { if (!glob || stars++) return 0; continue; }
            if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '.' || c == '-')) return 0;
            continue;
        }
        size_t len = i - start;
        if (!len || (len == 1 && s[start] == '.') || (len == 2 && s[start] == '.' && s[start + 1] == '.')) return 0;
        if (i < n) { if (stars) return 0; slash++; }
        start = i + 1;
    }
    return slash > 0;
}
static void res_load(void) {
    size_t n = 0; res_text = cx_read("build/chain-residue.tsv", &n);
    if (!res_text || !n || n > 16384 || res_text[n - 1] != '\n' || memchr(res_text, 0, n) || memchr(res_text, '\r', n)) res_die("text", "build/chain-residue.tsv");
    for (char *p = res_text; *p;) {
        char *e = strchr(p, '\n'), *v[4]; int fields = 1; *e = 0;
        if (*p != '#') {
            v[0] = p;
            for (char *q = p; *q; q++) if (*q == '\t') { *q = 0; if (fields == 4) res_die("columns", v[0]); v[fields++] = q + 1; }
            if (fields != 4 || res_n == 64) res_die("columns", v[0]);
            for (int i = 0; i < res_n; i++) if (!strcmp(res_phase[i], v[0])) res_die("duplicate phase", v[0]);
            if (strcmp(v[1], "scrub") && strcmp(v[1], "refuse")) res_die("policy", v[1]);
            if (!res_rel(v[2], strlen(v[2]), 0)) res_die("record", v[2]);
            for (const char *s = v[3];;) {
                const char *c = strchr(s, ','); size_t len = c ? (size_t)(c - s) : strlen(s);
                if (!res_rel(s, len, 1) || (len == strlen(v[2]) && !memcmp(s, v[2], len))) res_die("path", v[3]);
                if (!c) break;
                s = c + 1;
            }
            res_phase[res_n] = v[0]; res_policy[res_n] = v[1]; res_record[res_n] = v[2]; res_paths[res_n] = v[3]; res_n++;
        }
        p = e + 1;
    }
}
/* Input identity sidecar build/chain-phase-inputs.tsv (id, inputs). The phase table itself keeps its
 * 10 columns because candidate-chain and chain-run refuse any other column count; a consumer joins by id.
 * inputs is a comma list of tokens: phase:ID (upstream output; one per deps entry), src:GLOB (source
 * tree), table:PATH (fact table); "-" only for a phase with no input at all. Derived from the phase class. */
static char ibytes[65536];
static int iused;
static int starts(const char *s, const char *p) { return !strncmp(s, p, strlen(p)); }
static void inputs_of(const char *id, const char *deps, char *o, size_t cap) {
    size_t k = 0; o[0] = 0;
    if (strcmp(deps, "-")) {
        for (const char *s = deps;;) {
            const char *c = strchr(s, ','); size_t len = c ? (size_t)(c - s) : strlen(s);
            int n = snprintf(o + k, cap - k, "%sphase:%.*s", k ? "," : "", (int)len, s);
            if (n < 0 || (size_t)n >= cap - k) { fprintf(stderr, "chain-phases-gen: inputs bound\n"); exit(2); }
            k += (size_t)n;
            if (!c) break;
            s = c + 1;
        }
    }
    const char *extra;
    if (!strcmp(id, "snap")) extra = "src:git-tree";
    else if (starts(id, "jobs-tool-") || starts(id, "jobs-gen-")) extra = "src:tools/**,table:build/chain-facts.tsv";
    else if (starts(id, "jobs-") || starts(id, "final-net-") || starts(id, "p3-")) extra = "src:cx/**,table:build/chain-facts.tsv";
    else if (starts(id, "kernels-")) extra = "table:build/chain-residue.tsv";
    else if (!strcmp(id, "compare") || !strcmp(id, "pack") || !strcmp(id, "final") || !strcmp(id, "routes")) extra = "src:tools/**";
    else if (!strcmp(id, "list") || !strcmp(id, "warmup") || !strcmp(id, "host")) extra = "src:tools/**,table:build/chain-facts.tsv";
    else extra = "src:cx/**,src:src/**,src:seed/**,table:build/chain-facts.tsv";
    int n = snprintf(o + k, cap - k, "%s%s,table:build/limits.tsv", k ? "," : "", extra);
    if (n < 0 || (size_t)n >= cap - k) { fprintf(stderr, "chain-phases-gen: inputs bound\n"); exit(2); }
}
/* Fall-through sidecar build/chain-phase-fallthrough.tsv (id, fallthrough), joined by id like the
 * inputs sidecar (the phase table keeps its 10 columns). An outer phase X is run as
 * "candidate-chain --resume --until X" without --lane: that call walks the main flow of
 * tools/candidate-chain.cx from the top and rebuilds inline every phase on the way that has no
 * checkpoint, writing the directory of the lane that owns it. fallthrough lists the phases that must
 * therefore be complete before X may start, as a comma list in table order; the full set is the
 * listed ids closed under deps. The list holds every earlier lane-final row (id == lane) and the
 * tails of the earlier outer rows (a serially chained outer row replaces its predecessor, one with
 * an explicit dependency list is appended). A pack-path call (--until cache-manager|pack) skips
 * g3, kernels-g3 and compare, so those rows are left out of its list. "-" for a lane row (a lane
 * never visits sibling targets) and for a phase with nothing before it. */
static char fbytes[65536], ft_id[96][80];
static int fused, ft_n, ft_outer[96];
static int pack_path_id(const char *id) { return !strcmp(id, "cache-manager") || !strcmp(id, "pack"); }
static int pack_skipped(const char *id) {
    return !strncmp(id, "g3-", 3) || !strcmp(id, "wf-prep-g3") || !strcmp(id, "wf-span-prep-g3") || !strcmp(id, "kernels-g3") || !strcmp(id, "compare");
}
/* Channel shards: final-net-N and p3-guard-N (N decimal). Each is its own lane and exclusive dir,
 * width 4, and depends only on the family's start phase (jobs-net, p3-guard-init); the join row
 * (final, p3-opguard-prep) lists every shard in deps. A shard never enters ft_id: a later outer row
 * reaches it through the join row's deps closure, and the join row's own fall-through list carries
 * its shard list (join_list) so that the list still contains its whole deps closure. */
static char shard_list[2][1024];
static int shard_n[2];
static int shard_of(const char *id) {
    const char *d = !strncmp(id, "final-net-", 10) ? id + 10 : !strncmp(id, "p3-guard-", 9) ? id + 9 : 0;
    if (!d || !*d) return 0;
    for (const char *q = d; *q; q++) if (*q < '0' || *q > '9') return 0;
    return id[0] == 'f' ? 1 : 2;
}
static const char *shard_start(int family) { return family == 1 ? "jobs-net" : "p3-guard-init"; }
static const char *join_list(const char *id) {
    int f = !strcmp(id, "final") ? 0 : !strcmp(id, "p3-opguard-prep") ? 1 : -1;
    return f >= 0 && shard_n[f] ? shard_list[f] : 0;
}
static void fall_emit(const char *id, const char *lane, int chained) {
    int n, k = 0, is_outer = !strcmp(lane, "-");
    const char *own = join_list(id);
    n = snprintf(fbytes + fused, sizeof fbytes - fused, "%s\t", id);
    if (n < 0 || n >= (int)sizeof fbytes - fused) { fprintf(stderr, "chain-phases-gen: output bound\n"); exit(2); }
    fused += n;
    if (is_outer) for (int i = 0; i < ft_n; i++) {
        if (pack_path_id(id) && pack_skipped(ft_id[i])) continue;
        n = snprintf(fbytes + fused, sizeof fbytes - fused, "%s%s", k ? "," : "", ft_id[i]);
        if (n < 0 || n >= (int)sizeof fbytes - fused) { fprintf(stderr, "chain-phases-gen: output bound\n"); exit(2); }
        fused += n; k++;
    }
    if (is_outer && own) {
        n = snprintf(fbytes + fused, sizeof fbytes - fused, "%s%s", k ? "," : "", own);
        if (n < 0 || n >= (int)sizeof fbytes - fused) { fprintf(stderr, "chain-phases-gen: output bound\n"); exit(2); }
        fused += n; k++;
    }
    n = snprintf(fbytes + fused, sizeof fbytes - fused, "%s\n", k ? "" : "-");
    if (n < 0 || n >= (int)sizeof fbytes - fused) { fprintf(stderr, "chain-phases-gen: output bound\n"); exit(2); }
    fused += n;
    if (shard_of(id)) return;
    if (!is_outer && strcmp(id, lane)) return;
    if (is_outer && chained && ft_n && ft_outer[ft_n - 1]) ft_n--;
    if (ft_n == 96) { fprintf(stderr, "chain-phases-gen: fallthrough bound\n"); exit(2); }
    cx_fmt(ft_id[ft_n], sizeof ft_id[ft_n], "%s", id); ft_outer[ft_n++] = is_outer;
}
static void emit(const char *id) {
    char deps[2048],domain[160]; int shard=shard_of(id); const char *lane=shard?id:target_lane(outer)?outer:"-"; int chained=0;
    const char *joined=join_list(id);
    const char *policy="-",*record="-",*paths="-";
    for(int i=0;i<res_n;i++)if(!strcmp(res_phase[i],id)){policy=res_policy[i];record=res_record[i];paths=res_paths[i];res_used[i]=1;}
    int legacy=!strncmp(id,"g2-lnx-",7)&&strstr(id,"-obj-");
    if(legacy) cx_fmt(deps,sizeof deps,"-");
    else if(shard) {
        /* The start phase must be the row emitted just before the family's first shard. */
        const char *start=shard_start(shard); char *list=shard_list[shard-1]; size_t have=strlen(list);
        if(strcmp(previous,start)){fprintf(stderr,"chain-phases-gen: REFUSE shard start: %s\n",id);exit(2);}
        if(cx_fmt(list+have,sizeof shard_list[0]-have,"%s%s",have?",":"",id)){fprintf(stderr,"chain-phases-gen: shard list bound\n");exit(2);}
        shard_n[shard-1]++;
        cx_fmt(deps,sizeof deps,"%s",start);
    }
    /* A join row replaces its predecessor in ft_id like a chained row: the start phase is in its deps closure. */
    else if(joined) { cx_fmt(deps,sizeof deps,"%s",joined); chained=1; }
    else if(strcmp(lane,"-")) {
        if(*lane_previous) cx_fmt(deps,sizeof deps,"%s",lane_previous);
        else if(!strncmp(lane,"wf-",3)) cx_fmt(deps,sizeof deps,!strstr(lane,"-g")?"gen1-lnx-x86_64":strstr(lane,"-g2")?"g2-lnx-x86_64":"g3-lnx-x86_64");
        else if(!strncmp(lane,"gen1-lnx-",9)) cx_fmt(deps,sizeof deps,"p3");
        else if(!strncmp(lane,"gen1-",5)) cx_fmt(deps,sizeof deps,"wf-prepare,wf-span-prep");
        else if(!strncmp(lane,"g2-lnx-",7)) cx_fmt(deps,sizeof deps,"gen1-lnx-x86_64");
        else if(!strncmp(lane,"g3-lnx-",7)) cx_fmt(deps,sizeof deps,!strcmp(lane,"g3-lnx-x86_64")?"g2-lnx-x86_64":"g2-lnx-x86_64,g2-lnx-arm64");
        else if(!strncmp(lane,"g3-",3)) cx_fmt(deps,sizeof deps,"wf-prep-g3,wf-span-prep-g3,g2-%s",lane+3);
        else cx_fmt(deps,sizeof deps,"wf-prep-g%c,wf-span-prep-g%c",lane[1],lane[1]);
    } else if(!strcmp(id,"kernels-g2")) cx_fmt(deps,sizeof deps,"g2-lnx-x86_64");
    else if(!strcmp(id,"kernels-g3")) cx_fmt(deps,sizeof deps,"g3-lnx-x86_64");
    else if(!strcmp(id,"compare")) cx_fmt(deps,sizeof deps,"gen1-lnx-x86_64,gen1-lnx-arm64,gen1-osx-x86_64,gen1-osx-arm64,gen1-win-x86_64,gen1-win-arm64,g2-lnx-x86_64,g2-lnx-arm64,g3-lnx-x86_64,g3-lnx-arm64,kernels-g2,kernels-g3,g2-osx-x86_64,g2-osx-arm64,g2-win-x86_64,g2-win-arm64,g3-osx-x86_64,g3-osx-arm64,g3-win-x86_64,g3-win-arm64");
    /* g3 and compare are off the pack path: pack takes its six inputs from fixedpoint/g2 only;
       the g2 == g3 equality is owned by compare and by the public release gate. */
    else if(!strcmp(id,"cache-manager")) cx_fmt(deps,sizeof deps,"g2-lnx-x86_64");
    else if(!strcmp(id,"pack")) cx_fmt(deps,sizeof deps,"cache-manager,g2-lnx-x86_64,g2-lnx-arm64,g2-osx-x86_64,g2-osx-arm64,g2-win-x86_64,g2-win-arm64,kernels-g2");
    else { cx_fmt(deps,sizeof deps,"%s",*previous?previous:"-"); chained=1; }
    if(!legacy) fall_emit(id,lane,chained);
    else { int m=snprintf(fbytes+fused,sizeof fbytes-fused,"%s\t-\n",id); if(m<0||m>=(int)sizeof fbytes-fused){fprintf(stderr,"chain-phases-gen: output bound\n");exit(2);} fused+=m; }
    cx_fmt(domain,sizeof domain,"%s",strcmp(lane,"-")?lane:"outer");
    /* timeout_s is the phase.bound limit of build/limits.tsv (scope = phase id). */
    double bound=lm_get("phase.bound",id);
    if(bound<1){fprintf(stderr,"chain-phases-gen: unknown limit phase.bound\n");exit(2);}
    int n=snprintf(bytes+used,sizeof bytes-used,"%d\t%s\t%s\t%d\t%s\t%s\t%d\t%s\t%s\t%s\n",count,id,domain,(int)bound,deps,lane,strcmp(lane,"-")?4:1,policy,record,paths);
    if(n<0||n>=(int)sizeof bytes-used){fprintf(stderr,"chain-phases-gen: output bound\n");exit(2);}
    used+=n;count++;
    {char in[4800];inputs_of(id,deps,in,sizeof in);
     int m=snprintf(ibytes+iused,sizeof ibytes-iused,"%s\t%s\n",id,in);
     if(m<0||m>=(int)sizeof ibytes-iused){fprintf(stderr,"chain-phases-gen: output bound\n");exit(2);}
     iused+=m;}
    if(!legacy&&!shard) { cx_fmt(previous,sizeof previous,"%s",id); if(strcmp(lane,"-"))cx_fmt(lane_previous,sizeof lane_previous,"%s",id); }
}
/* Write-set assertion over build/chain-phase-outputs.tsv (hand-written facts): each shard family has
 * exclusive rows (phase_pattern FAMILY-{i}, exclusive_dir yes, phases = shard count) whose
 * write_path_pattern starts with OUT/ and contains {i}; instantiated for every shard of the family
 * (same start phase), no two shards share a path and none lies under another shard's directory. */
static void out_die(const char *why, const char *what) { fprintf(stderr, "chain-phases-gen: REFUSE shard outputs %s: %s\n", why, what ? what : "-"); exit(2); }
static int out_inst(char *o, size_t cap, const char *pat, int index) {
    size_t k = 0;
    for (const char *p = pat; *p;) {
        int n;
        if (!strncmp(p, "{i}", 3)) { n = snprintf(o + k, cap - k, "%d", index); p += 3; }
        else { n = snprintf(o + k, cap - k, "%c", *p); p++; }
        if (n < 0 || (size_t)n >= cap - k) return 1;
        k += (size_t)n;
    }
    return 0;
}
static void outputs_check(void) {
    static const char *fam[2] = {"final-net", "p3-guard"};
    static char inst[512][200]; static int inst_shard[512];
    size_t n = 0; char *text = cx_read("build/chain-phase-outputs.tsv", &n);
    if (!text || !n || n > 65536 || text[n - 1] != '\n' || memchr(text, 0, n)) out_die("text", "build/chain-phase-outputs.tsv");
    for (int f = 0; f < 2; f++) {
        char pat[16][160], want[40]; int np = 0, ni = 0;
        if (!shard_n[f]) out_die("no shard", fam[f]);
        if (cx_fmt(want, sizeof want, "%s-{i}", fam[f])) out_die("bound", fam[f]);
        for (char *p = text; p < text + n;) {
            char *e = memchr(p, '\n', (size_t)(text + n - p)), *v[8]; int fields = 1;
            if (*p != '#') {
                v[0] = p;
                for (char *q = p; q < e; q++) if (*q == '\t' || !*q) { *q = 0; if (fields == 8) out_die("columns", v[0]); v[fields++] = q + 1; }
                *e = 0;
                if (fields != 8) out_die("columns", v[0]);
                if (!strcmp(v[0], fam[f]) && !strcmp(v[1], want) && !strcmp(v[5], "yes")) {
                    if (np == 16) out_die("row bound", fam[f]);
                    if (atoi(v[2]) != shard_n[f]) out_die("phases count", v[3]);
                    if (strncmp(v[3], "OUT/", 4) || !strstr(v[3], "{i}")) out_die("pattern", v[3]);
                    for (int i = 0; i < np; i++) if (!strcmp(pat[i], v[3])) out_die("duplicate pattern", v[3]);
                    if (cx_fmt(pat[np++], sizeof pat[0], "%s", v[3])) out_die("pattern bound", v[3]);
                }
                for (int i = 1; i < fields; i++) v[i][-1] = '\t';
            }
            *e = '\n'; p = e + 1;
        }
        if (!np) out_die("no exclusive row", fam[f]);
        for (int s = 0; s < shard_n[f]; s++) for (int i = 0; i < np; i++) {
            if (ni == 512 || out_inst(inst[ni], sizeof inst[ni], pat[i], s)) out_die("instance bound", fam[f]);
            inst_shard[ni++] = s;
        }
        for (int a = 0; a < ni; a++) for (int b = 0; b < ni; b++) if (inst_shard[a] != inst_shard[b]) {
            size_t la = strlen(inst[a]);
            if (!strcmp(inst[a], inst[b]) || (inst[a][la - 1] == '/' && !strncmp(inst[b], inst[a], la))) out_die("overlap", inst[a]);
        }
    }
    free(text);
}
/* Reject a stale generated library before deriving phase expansion. */
static int facts_current(void) {
    FILE *f=fopen("build/chain-facts.tsv","rb");
    char line[4400],want[4400];int row=0,ok=1;
    if(!f)return 0;
    while(fgets(line,sizeof line,f)) {
        size_t n=strlen(line);if(!n||line[n-1]!='\n'){ok=0;break;}
        if(line[0]=='#')continue;
        if(row==0){if(cx_fmt(want,sizeof want,"count\tnets\t%d\n",cf_net_count())){ok=0;break;}}
        else if(row==1){if(cx_fmt(want,sizeof want,"count\ttools\t%d\n",cf_tool_count())){ok=0;break;}}
        else if(row==2){if(cx_fmt(want,sizeof want,"count\tfront_slice\t%d\n",cf_front_slice())){ok=0;break;}}
        else if(row==3){if(cx_fmt(want,sizeof want,"count\twf_max\t%d\n",cf_wf_max())){ok=0;break;}}
        else if(row<4+cf_root_count()){if(cx_fmt(want,sizeof want,"root\t%s\t%s\n",cf_root_key(row-4),cf_root_source(row-4))){ok=0;break;}}
        else if(row<4+cf_root_count()+cf_p3_count()){if(cx_fmt(want,sizeof want,"p3\t%s\t-\n",cf_p3_phase(row-4-cf_root_count()))){ok=0;break;}}
        else {ok=0;break;}
        if(strcmp(line,want)){ok=0;break;}row++;
    }
    if(ferror(f)||row!=4+cf_root_count()+cf_p3_count())ok=0;
    if(fclose(f))ok=0;return ok;
}
int main(int argc, char **argv) {
    const char *dst = "build/chain-phases.tsv";
    const char *base[] = {"snap","build","ctx","host","list","warmup","jobs-tool","jobs-gen","jobs-tbl","jobs-net","final","routes","p3","gen1-lnx-x86_64","gen1-lnx-arm64","gen1-osx-x86_64","gen1-osx-arm64","gen1-win-x86_64","gen1-win-arm64","g2-lnx-x86_64","g2-lnx-arm64","g3-lnx-x86_64","g3-lnx-arm64","kernels-g2","kernels-g3","g2-osx-x86_64","g2-osx-arm64","g2-win-x86_64","g2-win-arm64","g3-osx-x86_64","g3-osx-arm64","g3-win-x86_64","g3-win-arm64","compare","cache-manager","pack"};
    if (argc != 2 || (strcmp(argv[1], "--write") && strcmp(argv[1], "--check"))) { fprintf(stderr, "chain-phases-gen: usage --write|--check\n"); return 2; }
    if(!facts_current()){fprintf(stderr,"chain-phases-gen: DIFF construction facts\n");return 1;}
    if(cf_net_count()!=sp_model_count()||cf_tool_count()!=sp_tool_count()){fprintf(stderr,"chain-phases-gen: DIFF network counts\n");return 1;}
    res_load();
    used = snprintf(bytes, sizeof bytes, "# order\tid\texclusive_dir\ttimeout_s\tdeps\tlane\tparallelism\tresidue_policy\tresidue_record\tresidue_paths\n# generated by tools/chain-phases-gen.cx --write; do not edit\n");
    for (int i = 0; i < (int)(sizeof base / sizeof *base); i++) {
        outer=base[i]; lane_previous[0]=0;
        char id[80];
        if(!strcmp(base[i],"gen1-osx-x86_64")||!strcmp(base[i],"g2-osx-x86_64")||!strcmp(base[i],"g3-osx-x86_64")) {
            char prep[80];
            int gen=base[i][1]=='e'?1:base[i][1]-'0';
            if(gen==1)cx_fmt(prep,sizeof prep,"wf-prepare");else cx_fmt(prep,sizeof prep,"wf-prep-g%d",gen);
            outer=prep;lane_previous[0]=0;emit(prep);
            if(gen==1)cx_fmt(prep,sizeof prep,"wf-span-prep");else cx_fmt(prep,sizeof prep,"wf-span-prep-g%d",gen);
            outer=prep;lane_previous[0]=0;emit(prep);
            outer=base[i];lane_previous[0]=0;
        }
        if (!strcmp(base[i], "ctx")) { emit("wave-objects"); emit("wave-runner"); }
        if (!strcmp(base[i], "build")) { emit("build-objects"); emit("build-front"); }
        if (!strncmp(base[i], "gen1-lnx-", 9)) {
            if (cx_fmt(id, sizeof id, "%s-objects", base[i])) return 2;
            emit(id);
        }
        if (!strcmp(base[i], "final")) {
            for (int j = 0; j < cf_net_count(); j++) {
                if (cx_fmt(id, sizeof id, "final-net-%d", j)) return 2;
                emit(id);
            }
        }
        if (!strcmp(base[i], "p3")) {
            for (int j = 0; j < cf_p3_count(); j++) {
                if (cx_fmt(id, sizeof id, "p3-%s", cf_p3_phase(j))) return 2;
                emit(id);
            }
        }
        if (!strncmp(base[i], "jobs-", 5)) {
            int n = !strcmp(base[i], "jobs-tool") ? cf_tool_count() : cf_net_count();
            for (int j = 0; j < n; j++) for (int a = 0; a < 2; a++) {
                if (cx_fmt(id, sizeof id, "%s-%d-%s", base[i], j, a ? "finish" : "start")) return 2;
                emit(id);
            }
        } else if (!strcmp(base[i], "g2-lnx-x86_64") || !strcmp(base[i], "g2-lnx-arm64")) {
            for (int j = 0; j < cf_root_count(); j++) {
                if (cx_fmt(id, sizeof id, "%s-obj-%d", base[i], j)) return 2;
                emit(id);
            }
            if (cx_fmt(id, sizeof id, "%s-closure-prepare", base[i])) return 2;
            emit(id);
            if (cx_fmt(id, sizeof id, "%s-closure", base[i])) return 2;
            emit(id);
            if (cx_fmt(id, sizeof id, "%s-objects", base[i])) return 2;
            emit(id);
        } else if (!strncmp(base[i], "g3-lnx-", 7)) {
            if (cx_fmt(id, sizeof id, "%s-closure-prepare", base[i])) return 2;
            emit(id);
            if (cx_fmt(id, sizeof id, "%s-closure", base[i])) return 2;
            emit(id);
            if (cx_fmt(id, sizeof id, "%s-objects", base[i])) return 2;
            emit(id);
        }
        emit(base[i]);
    }
    for (int i = 0; i < res_n; i++) if (!res_used[i]) res_die("unknown phase", res_phase[i]);
    outputs_check();
    {   const char *idst = "build/chain-phase-inputs.tsv";
        static char ihead[] = "# id\tinputs\n# generated by tools/chain-phases-gen.cx --write; do not edit\n";
        static char all[65664]; int an = snprintf(all, sizeof all, "%s%.*s", ihead, iused, ibytes);
        if (an < 0 || an >= (int)sizeof all) { fprintf(stderr, "chain-phases-gen: output bound\n"); return 2; }
        if (!strcmp(argv[1], "--write")) { if (cx_write(idst, all, (size_t)an)) return 2; }
        else { size_t n = 0; char *s = cx_read(idst, &n); int same = s && n == (size_t)an && !memcmp(s, all, n); free(s); if (!same) { fprintf(stderr, "chain-phases-gen: DIFF inputs\n"); return 1; } }
    }
    {   const char *fdst = "build/chain-phase-fallthrough.tsv";
        static char fhead[] = "# id\tfallthrough\n# generated by tools/chain-phases-gen.cx --write; do not edit\n";
        static char fall[65664]; int fn = snprintf(fall, sizeof fall, "%s%.*s", fhead, fused, fbytes);
        if (fn < 0 || fn >= (int)sizeof fall) { fprintf(stderr, "chain-phases-gen: output bound\n"); return 2; }
        if (!strcmp(argv[1], "--write")) { if (cx_write(fdst, fall, (size_t)fn)) return 2; }
        else { size_t n = 0; char *s = cx_read(fdst, &n); int same = s && n == (size_t)fn && !memcmp(s, fall, n); free(s); if (!same) { fprintf(stderr, "chain-phases-gen: DIFF fallthrough\n"); return 1; } }
    }
    if (!strcmp(argv[1], "--write")) { if (cx_write(dst, bytes, used)) return 2; }
    else { size_t n = 0; char *s = cx_read(dst, &n); int same = s && n == (size_t)used && !memcmp(s, bytes, n); free(s); if (!same) { fprintf(stderr, "chain-phases-gen: DIFF\n"); return 1; } }
    printf("CHAIN_PHASES\tstatus=%s\tn=%d\n", !strcmp(argv[1], "--write") ? "WRITE" : "CHECK", count);
    return 0;
}
