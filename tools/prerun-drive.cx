/* tools/prerun-drive.cx -- bounded window-granularity qualification prerun driver and offline replay verifier.
 * Subcommands:
 *   plan   --ids-file FILE --out DIR [--win-size 8..12] [--heavy-file FILE] [--warmup N]
 *          [--times-file FILE --normal-jobs 1..16] [--priority-file FILE] [--near-bound-file FILE] [--window-lanes 1..8]
 *   run    --root DIR --candidate APE --out DIR [--resume] [--max-jobs N] [--max-retries 2]
 *          [--window-lanes 1..8] (defaults to the new plan's width, 1 on legacy plans)
 *          (--load-cap N is still accepted but ignored with a PRERUN_DEPRECATED line: load gates retired 2026-11-20)
 *   merge  --in-dir DIR --out DIR [--version VER] [--skip-name FILE]
 *   archive --in-dir RUN_DIR --repo DIR --version V  (after the supervisor closes its log)
 *   g1-dry --root DIR --strict FILE --expected-fail FILE --expected-unmeasured FILE --out DIR [--version VER]
 *   rebase-rev --plan|--execute --from-dir DIR --to-rev COMMIT [--root REPO] [--out NEW_DIR]
 *   replay --ids-file FILE --evidence-dir DIR --out DIR [--expected-strict FILE] [--expected-g1dry FILE]
 * Batch result lines are kept verbatim. Timed windows can recover missing
 * evidence in single-batch runs, each with its own deadline. */
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use sys.sha
#pragma unisa use sysx.process
#pragma unisa use sysx.reaper
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use text.text
#pragma unisa use cxlib.testplan
#pragma unisa use cxlib.pik1

#define PD_PW 4400
#define PD_MAX_IDS TP_BATCH_CAP
#define PD_PREP_MAXB 1024
#define PD_MAX_WINS 2048
#define PD_MAX_FILES (PD_MAX_WINS + PD_MAX_IDS)
#define PD_CHILD_SECONDS 58
#define PD_MAX_LANES 8
#define PD_DEFAULT_LANES 4
#define PD_DEFAULT_NORMAL_JOBS 8
/* Reserve 13 seconds before the 58s outer cutoff for dvqualify startup/layout overhead:
 * window packing target budget ceiling is <= 45000ms. Single batches with historical time
 * > 45000ms (up to the 54000ms single-window split limit) run in exclusive 1-batch windows. */
#define PD_WINDOW_RESERVE_MS 13000
#define PD_WINDOW_TARGET_MS (PD_CHILD_SECONDS * 1000 - PD_WINDOW_RESERVE_MS)
#define PD_SINGLE_RESERVE_MS 4000
#define PD_BATCH_WINDOW_MS (PD_CHILD_SECONDS * 1000 - PD_SINGLE_RESERVE_MS)
#define PD_TIMED_BUDGET_MS 22000
#define PD_DEFAULT_UNMEASURED_MS 15000
#define PD_TIMED_HEADER "# prerun-drive windows\n# timing=wave-v1 jobs="

typedef struct {
    char id[128];
    int heavy;
    int near_bound;
    int priority;
    int nonpass;
    int measured;
    long time_ms;
} PdBatch;

typedef struct {
    char wid[32];
    int jobs;
    char phase[24];
    int start;
    int count;
    int idxs[32];
} PdWin;

typedef struct {
    char id[128];
    char domain[64];
    char status[24];
    int rc;
    char note[256];
    int seen;
    int had_fail;
    int superseded;
    char raw_line[1024];
} PdState;

static PdBatch pd_ids[PD_MAX_IDS];
static int pd_nids = 0;
static PdWin pd_wins[PD_MAX_WINS];
static int pd_nwins = 0;
static PdState pd_states[PD_MAX_IDS];
static int pd_nstates = 0;
static char pd_heavy_extra[256][128];
static int pd_nheavy_extra = 0;
static int pd_has_times = 0;
static int pd_has_priority = 0;
static int pd_mut_times_use_nonpass = 0;
static int pd_normal_jobs = PD_DEFAULT_NORMAL_JOBS;
static int pd_plan_lanes = PD_DEFAULT_LANES;
static int pd_keep_going = 1;
static int pd_scout;
static int pd_rebase_run;
static char *pd_expected_rows;
static char pd_candidate_sha[65];
static int pd_max_wins = PD_MAX_WINS;
static long pd_unmeasured_ms = 0;
static int pd_has_overhead = 0;
static long pd_measured_wall_ms = 0;
static long pd_measured_batch_ms = 0;
static long pd_outer_overhead_ms = 0;
static long pd_run_wall_ms = 0;
static long pd_run_batch_ms = 0;
static int pd_run_measured_wins = 0;

static int pd_refuse(const char *why) {
    fprintf(stderr, "PRERUN_DRIVE\tREFUSE\treason=%s\n", why);
    return 2;
}

static void pd_mkdirs(const char *dir) {
    char tmp[PD_PW];
    size_t n = strlen(dir);
    if (n >= sizeof tmp || mm_copy(tmp, sizeof tmp, dir, n + 1)) return;
    for (size_t i = 1; i < n; i++) if (tmp[i] == '/') { tmp[i] = 0; sy_mkdir(tmp, 0755); tmp[i] = '/'; }
    sy_mkdir(tmp, 0755);
}

static int pd_starts(const char *s, const char *pre) {
    size_t pl = strlen(pre);
    return strlen(s) >= pl && memcmp(s, pre, pl) == 0;
}

static int pd_is_compile_smoke_id(const char *id) {
    return pd_starts(id, "daily-compile-smoke-") || pd_starts(id, "compile-smoke-");
}

static int pd_is_early_canary_id(const char *id) {
    return pd_starts(id, "ri-image-") || tx_eqz(id, "ri-route-refuse") || tx_eqz(id, "lane-key-probes") ||
           pd_is_compile_smoke_id(id);
}

static int pd_is_expected_unmeasured_id(const char *id) {
    return tx_eqz(id, "tools-default-regression") || tx_eqz(id, "cx-booter-ape");
}

static int pd_is_warmup_excluded_id(const char *id) {
    return pd_is_expected_unmeasured_id(id) || pd_starts(id, "unit-frontcache-") || pd_starts(id, "opt-frame4-");
}

static int pd_is_isolated_long_id(const char *id) {
    static const char *builtin[] = {
        "slow-split", "unit-frontcache-equiv0", "unit-frontcache-equiv1",
        "unit-frontcache-equiv2", "unit-frontcache-equiv3b", "unit-frontcache-equiv4", 0
    };
    if (pd_starts(id, "slow-split-")) return 1;
    for (int i = 0; builtin[i]; i++) if (tx_eqz(id, builtin[i])) return 1;
    return 0;
}

static int pd_is_heavy_id(const char *id) {
    static const char *builtin[] = {
        "real-commit", "unit-frontcache-equiv3", "check-split-parents-table", "check-split-parents-g1a", "check-split-parents-g1b", "check-split-parents-g1c",
        "check-gen-all-check", "check-gen-all-pass", "check-gen-all-hang",
        "c-negative", "stream-pipe-parts", 0
    };
    for (int i = 0; builtin[i]; i++) if (tx_eqz(id, builtin[i])) return 1;
    if (pd_starts(id, "netregen-")) return 1;
    for (int i = 0; i < pd_nheavy_extra; i++) if (tx_eqz(id, pd_heavy_extra[i])) return 1;
    return 0;
}

/* Explicit heavy declarations are exclusive unless the material contract is known.
 * Each netregen uses its own out/material paths. Early canaries keep their barriers. */
static int pd_can_share_window(const char *phase, const char *ids, int jobs) {
    if (jobs != 1 || !ids[0] || strchr(ids, ',') || pd_is_early_canary_id(ids)) return 0;
    return tx_eqz(phase, "long") ||
           (tx_eqz(phase, "heavy") && (pd_starts(ids, "netregen-") || tx_eqz(ids, "unit-frontcache-equiv3") || pd_is_isolated_long_id(ids)));
}

static int pd_width(const char *s, int max) {
    int n = 0;
    for (; *s >= '0' && *s <= '9'; s++) {
        n = n * 10 + *s - '0';
        if (n > max) return 0;
    }
    return *s ? 0 : n;
}

static int pd_load_heavy_file(const char *path) {
    unsigned char *b = 0; int64_t n = 0;
    if (sy_read_file(path, &b, &n, 1 << 20)) return -1;
    int64_t pos = 0;
    while (pos < n && pd_nheavy_extra < 256) {
        int64_t ls = pos;
        while (pos < n && b[pos] != '\n') pos++;
        int64_t le = pos;
        if (pos < n) pos++;
        while (le > ls && (b[le - 1] == '\r' || b[le - 1] == ' ' || b[le - 1] == '\t')) le--;
        while (ls < le && (b[ls] == ' ' || b[ls] == '\t')) ls++;
        if (le > ls && b[ls] != '#' && (size_t)(le - ls) < 127) {
            if (!mm_copy(pd_heavy_extra[pd_nheavy_extra], 128, (const char *)b + ls, (size_t)(le - ls))) {
                pd_heavy_extra[pd_nheavy_extra][le - ls] = 0;
                pd_nheavy_extra++;
            }
        }
    }
    mm_free(b);
    return 0;
}

static int pd_load_ids(const char *path) {
    unsigned char *b = 0; int64_t n = 0;
    pd_nids = 0;
    if (sy_read_file(path, &b, &n, 4 << 20)) return -1;
    int64_t pos = 0;
    while (pos < n && pd_nids < PD_MAX_IDS) {
        int64_t ls = pos;
        while (pos < n && b[pos] != '\n') pos++;
        int64_t le = pos;
        if (pos < n) pos++;
        while (le > ls && (b[le - 1] == '\r' || b[le - 1] == ' ' || b[le - 1] == '\t')) le--;
        while (ls < le && (b[ls] == ' ' || b[ls] == '\t')) ls++;
        if (le <= ls || b[ls] == '#') continue;
        /* Allow TSV first column or plain one-id-per-line */
        int64_t end = ls;
        while (end < le && b[end] != '\t' && b[end] != ' ') end++;
        size_t len = (size_t)(end - ls);
        if (len == 0 || len >= 127) continue;
        char id[128];
        if (mm_copy(id, sizeof id, (const char *)b + ls, len)) continue;
        id[len] = 0;
        if (tx_eqz(id, "batch") || tx_eqz(id, "id") || tx_eqz(id, "RAW") || tx_eqz(id, "SUMMARY")) continue;
        int dup = 0;
        for (int i = 0; i < pd_nids; i++) if (tx_eqz(pd_ids[i].id, id)) { dup = 1; break; }
        if (dup) continue;
        cx_fmt(pd_ids[pd_nids].id, sizeof pd_ids[pd_nids].id, "%s", id);
        pd_ids[pd_nids].heavy = pd_is_heavy_id(id);
        pd_ids[pd_nids].near_bound = 0;
        pd_ids[pd_nids].priority = 0;
        pd_ids[pd_nids].nonpass = 0;
        pd_ids[pd_nids].measured = 0;
        pd_ids[pd_nids].time_ms = pd_is_compile_smoke_id(id) ? PD_DEFAULT_UNMEASURED_MS : 5000;
        pd_nids++;
    }
    mm_free(b);
    return 0;
}

static int pd_is_digits(const char *s, int64_t len) {
    if (len <= 0 || len > 18) return 0;
    for (int64_t i = 0; i < len; i++) if (s[i] < '0' || s[i] > '9') return 0;
    return 1;
}

static int pd_find_id(const char *id, size_t len) {
    if (len == 0 || len >= 127) return -1;
    for (int i = 0; i < pd_nids; i++) {
        if (strlen(pd_ids[i].id) == len && memcmp(pd_ids[i].id, id, len) == 0) return i;
    }
    return -1;
}

static long pd_parse_window_wall_buf(const char *b, int64_t n) {
    static char wnames[PD_MAX_WINS][32];
    static long wvals[PD_MAX_WINS];
    int nw = 0;
    long direct_sum = 0;
    int64_t pos = 0;
    while (pos < n) {
        int64_t ls = pos;
        while (pos < n && b[pos] != '\n') pos++;
        int64_t le = pos;
        if (pos < n) pos++;
        if (le > ls && b[le - 1] == '\r') le--;
        int64_t llen = le - ls;
        const char *line = b + ls;
        if (llen <= 0) continue;
        long dw = tx_find(line, (long)llen, "window_wall_ms=", 15);
        if (dw >= 0) {
            const char *p = line + dw + 15;
            long v = 0; int dig = 0;
            while (p < b + le && *p >= '0' && *p <= '9') { v = v * 10 + (*p - '0'); p++; dig++; }
            if (dig > 0) direct_sum += v;
            continue;
        }
        if (tx_find(line, (long)llen, "PRERUN_WINDOW\t", 14) < 0) continue;
        if (tx_find(line, (long)llen, "\tphase=prebuild-self\t", 21) >= 0) continue;
        long wp = tx_find(line, (long)llen, "\twindow=", 8);
        long mp = tx_find(line, (long)llen, "\twall_ms=", 9);
        if (wp < 0 || mp < 0) continue;
        const char *ws = line + wp + 8;
        const char *we = ws;
        while (we < b + le && *we != '\t') we++;
        size_t wl = (size_t)(we - ws);
        if (wl == 0 || wl >= 31) continue;
        char wname[32];
        mm_copy(wname, sizeof wname, ws, wl);
        wname[wl] = 0;
        const char *ms = line + mp + 9;
        long v = 0; int dig = 0;
        while (ms < b + le && *ms >= '0' && *ms <= '9') { v = v * 10 + (*ms - '0'); ms++; dig++; }
        if (dig <= 0) continue;
        int idx = -1;
        for (int i = 0; i < nw; i++) if (tx_eqz(wnames[i], wname)) { idx = i; break; }
        if (idx < 0 && nw < PD_MAX_WINS) {
            idx = nw++;
            cx_fmt(wnames[idx], sizeof wnames[idx], "%s", wname);
        }
        if (idx >= 0) wvals[idx] = v;
    }
    long total = direct_sum;
    for (int i = 0; i < nw; i++) total += wvals[i];
    return total;
}

static long pd_find_companion_wall_ms(const char *times_path) {
    char dir[PD_PW], logp[PD_PW];
    const char *slash = strrchr(times_path, '/');
    const char *base = slash ? slash + 1 : times_path;
    if (slash) {
        size_t dl = (size_t)(slash - times_path);
        if (dl == 0 || dl >= sizeof dir) return 0;
        mm_copy(dir, sizeof dir, times_path, dl);
        dir[dl] = 0;
    } else {
        cx_fmt(dir, sizeof dir, ".");
    }
    const char *st = strstr(base, "-strict-");
    if (base[0] == 'v' && st && (size_t)(st - (base + 1)) < 32) {
        char ver[32];
        size_t vl = (size_t)(st - (base + 1));
        mm_copy(ver, sizeof ver, base + 1, vl);
        ver[vl] = 0;
        unsigned char *lb = 0; int64_t ln = 0;
        if (!cx_fmt(logp, sizeof logp, "%s/%s/prerun-supervise.log", dir, ver) &&
            sy_read_file(logp, &lb, &ln, 16 << 20) == 0 && lb && ln > 0) {
            long w = pd_parse_window_wall_buf((const char *)lb, ln);
            mm_free(lb);
            if (w > 0) return w;
        }
        if (lb) mm_free(lb);
    }
    const char *cands[] = {"prerun-supervise.log", "supervise.log", 0};
    for (int i = 0; cands[i]; i++) {
        unsigned char *lb = 0; int64_t ln = 0;
        if (!cx_fmt(logp, sizeof logp, "%s/%s", dir, cands[i]) &&
            sy_read_file(logp, &lb, &ln, 16 << 20) == 0 && lb && ln > 0) {
            long w = pd_parse_window_wall_buf((const char *)lb, ln);
            mm_free(lb);
            if (w > 0) return w;
        }
        if (lb) mm_free(lb);
    }
    return 0;
}

static int pd_load_times_file(const char *path) {
    unsigned char *b = 0; int64_t n = 0;
    if (sy_read_file(path, &b, &n, 16 << 20)) return -1;
    static char seen_ids[PD_MAX_IDS][128];
    static long seen_ms[PD_MAX_IDS];
    int nseen = 0;
    int measured = 0;
    pd_has_overhead = 0;
    pd_measured_wall_ms = 0;
    pd_measured_batch_ms = 0;
    pd_outer_overhead_ms = 0;
    long self_wall_ms = pd_parse_window_wall_buf((const char *)b, n);
    int64_t pos = 0;
    while (pos < n) {
        int64_t ls = pos;
        while (pos < n && b[pos] != '\n') pos++;
        int64_t le = pos;
        if (pos < n) pos++;
        if (le > ls && b[le - 1] == '\r') le--;
        if (le <= ls || b[ls] == '#') continue;
        if (le - ls >= 4 && memcmp(b + ls, "RAW\t", 4) == 0) continue;
        if (le - ls >= 8 && memcmp(b + ls, "SUMMARY\t", 8) == 0) continue;
        if (le - ls >= 14 && memcmp(b + ls, "PRERUN_WINDOW\t", 14) == 0) continue;
        const char *cols[10]; int64_t clens[10]; int nc = 0; int64_t p = ls;
        while (nc < 10) {
            int64_t cs = p;
            while (p < le && b[p] != '\t') p++;
            cols[nc] = (const char *)b + cs; clens[nc] = p - cs; nc++;
            if (p >= le) break;
            p++;
        }
        const char *id_col = 0, *ms_col = 0, *st_col = 0;
        int64_t id_len = 0, ms_len = 0, st_len = 0;
        if (nc >= 4 && pd_is_digits(cols[0], clens[0]) && pd_is_digits(cols[3], clens[3])) {
            id_col = cols[1]; id_len = clens[1];
            st_col = cols[2]; st_len = clens[2];
            ms_col = cols[3]; ms_len = clens[3];
        } else if (nc >= 6 && pd_is_digits(cols[5], clens[5])) {
            id_col = cols[0]; id_len = clens[0];
            st_col = cols[2]; st_len = clens[2];
            ms_col = cols[5]; ms_len = clens[5];
        } else if (nc >= 2 && pd_is_digits(cols[1], clens[1])) {
            id_col = cols[0]; id_len = clens[0];
            ms_col = cols[1]; ms_len = clens[1];
        }
        if (st_col && !pd_mut_times_use_nonpass &&
            !(st_len == 4 && memcmp(st_col, "PASS", 4) == 0)) {
            continue;
        }
        if (id_col && ms_col) {
            long raw_v = 0;
            if (ms_len > 0 && ms_len < 16) {
                char nbuf[16];
                mm_copy(nbuf, sizeof nbuf, ms_col, (size_t)ms_len);
                nbuf[ms_len] = 0;
                raw_v = atol(nbuf);
            }
            if (id_len > 0 && id_len < 127 && raw_v > 0) {
                int sidx = -1;
                for (int si = 0; si < nseen; si++) {
                    if (strlen(seen_ids[si]) == (size_t)id_len && memcmp(seen_ids[si], id_col, (size_t)id_len) == 0) {
                        sidx = si;
                        break;
                    }
                }
                if (sidx < 0 && nseen < PD_MAX_IDS) {
                    sidx = nseen++;
                    mm_copy(seen_ids[sidx], sizeof seen_ids[sidx], id_col, (size_t)id_len);
                    seen_ids[sidx][id_len] = 0;
                }
                if (sidx >= 0) seen_ms[sidx] = raw_v;
            }
            int idx = pd_find_id(id_col, (size_t)id_len);
            if (idx >= 0) {
                long v = PD_BATCH_WINDOW_MS + 1;
                if (ms_len <= 5) {
                    char nbuf[6];
                    mm_copy(nbuf, sizeof nbuf, ms_col, (size_t)ms_len);
                    nbuf[ms_len] = 0;
                    v = atol(nbuf);
                }
                if (v < 500) v = 500;
                if (pd_ids[idx].heavy && !pd_mut_times_use_nonpass && v > PD_BATCH_WINDOW_MS && v <= 55000)
                    v = PD_BATCH_WINDOW_MS;
                if (!pd_ids[idx].measured || v > pd_ids[idx].time_ms)
                    pd_ids[idx].time_ms = v;
                pd_ids[idx].measured = 1;
                measured++;
            }
        }
    }
    mm_free(b);
    if (measured == 0) return -1;
    long sum_batch_ms = 0;
    for (int si = 0; si < nseen; si++) sum_batch_ms += seen_ms[si];
    long wall_ms = self_wall_ms > 0 ? self_wall_ms : pd_find_companion_wall_ms(path);
    if (wall_ms > 0 && sum_batch_ms > 0) {
        pd_has_overhead = 1;
        pd_measured_wall_ms = wall_ms;
        pd_measured_batch_ms = sum_batch_ms;
        pd_outer_overhead_ms = wall_ms - sum_batch_ms;
    }
    pd_has_times = 1;
    return 0;
}

static int pd_load_priority_file(const char *path) {
    unsigned char *b = 0; int64_t n = 0;
    if (sy_read_file(path, &b, &n, 8 << 20)) return -1;
    int has_pass_rows = 0;
    int64_t pos = 0;
    while (pos < n) {
        int64_t ls = pos;
        while (pos < n && b[pos] != '\n') pos++;
        int64_t le = pos;
        if (pos < n) pos++;
        if (le > ls && b[le - 1] == '\r') le--;
        if (le <= ls || b[ls] == '#') continue;
        const char *cols[6]; int64_t clens[6]; int nc = 0; int64_t p = ls;
        while (nc < 6) {
            int64_t cs = p;
            while (p < le && b[p] != '\t') p++;
            cols[nc] = (const char *)b + cs; clens[nc] = p - cs; nc++;
            if (p >= le) break;
            p++;
        }
        if (nc >= 3 && clens[2] == 4 && memcmp(cols[2], "PASS", 4) == 0) {
            has_pass_rows = 1;
            break;
        }
    }
    pos = 0;
    while (pos < n) {
        int64_t ls = pos;
        while (pos < n && b[pos] != '\n') pos++;
        int64_t le = pos;
        if (pos < n) pos++;
        while (le > ls && (b[le - 1] == '\r' || b[le - 1] == ' ' || b[le - 1] == '\t')) le--;
        while (ls < le && (b[ls] == ' ' || b[ls] == '\t')) ls++;
        if (le <= ls || b[ls] == '#') continue;
        const char *cols[6]; int64_t clens[6]; int nc = 0; int64_t p = ls;
        while (nc < 6) {
            int64_t cs = p;
            while (p < le && b[p] != '\t') p++;
            cols[nc] = (const char *)b + cs; clens[nc] = p - cs; nc++;
            if (p >= le) break;
            p++;
        }
        if (clens[0] == 3 && memcmp(cols[0], "RAW", 3) == 0) continue;
        if (clens[0] == 7 && memcmp(cols[0], "SUMMARY", 7) == 0) continue;
        if (clens[0] == 10 && memcmp(cols[0], "CHECKPOINT", 10) == 0) continue;
        if (clens[0] == 5 && memcmp(cols[0], "batch", 5) == 0) continue;
        if (clens[0] == 2 && memcmp(cols[0], "id", 2) == 0) continue;
        if (has_pass_rows && nc >= 3) {
            const char *id_col = pd_is_digits(cols[0], clens[0]) ? cols[1] : cols[0];
            int64_t id_len = pd_is_digits(cols[0], clens[0]) ? clens[1] : clens[0];
            int is_pass = (clens[2] == 4 && memcmp(cols[2], "PASS", 4) == 0);
            int idx = pd_find_id(id_col, (size_t)id_len);
            if (idx >= 0) {
                pd_ids[idx].priority = is_pass ? 0 : 2;
                pd_ids[idx].nonpass = is_pass ? 0 : 1;
            }
        } else {
            int64_t id_len = 0;
            while (id_len < clens[0] && cols[0][id_len] != ' ') id_len++;
            int idx = pd_find_id(cols[0], (size_t)id_len);
            if (idx >= 0) {
                int pval = 2;
                if (nc >= 2 && ((clens[1] == 1 && cols[1][0] == '2') ||
                                (clens[1] == 7 && memcmp(cols[1], "WIN_OSX", 7) == 0) ||
                                (clens[1] == 8 && memcmp(cols[1], "PLATFORM", 8) == 0))) {
                    pval = 1;
                }
                if (pval > pd_ids[idx].priority) pd_ids[idx].priority = pval;
            }
        }
    }
    mm_free(b);
    pd_has_priority = 1;
    return 0;
}

static int pd_load_near_bound_file(const char *path) {
    unsigned char *b = 0; int64_t n = 0;
    if (sy_read_file(path, &b, &n, 8 << 20)) return -1;
    int64_t pos = 0;
    while (pos < n) {
        int64_t ls = pos;
        while (pos < n && b[pos] != '\n') pos++;
        int64_t le = pos;
        if (pos < n) pos++;
        while (le > ls && (b[le - 1] == '\r' || b[le - 1] == ' ' || b[le - 1] == '\t')) le--;
        while (ls < le && (b[ls] == ' ' || b[ls] == '\t')) ls++;
        if (le <= ls || b[ls] == '#') continue;
        const char *cols[12]; int64_t clens[12]; int nc = 0; int64_t p = ls;
        while (nc < 12) {
            int64_t cs = p;
            while (p < le && b[p] != '\t') p++;
            cols[nc] = (const char *)b + cs; clens[nc] = p - cs; nc++;
            if (p >= le) break;
            p++;
        }
        if (clens[0] == 5 && memcmp(cols[0], "batch", 5) == 0) continue;
        if (clens[0] == 2 && memcmp(cols[0], "id", 2) == 0) continue;
        int mark = 0;
        if (nc >= 10 && clens[9] == 10 && memcmp(cols[9], "near-bound", 10) == 0) {
            mark = 1;
        } else if (nc >= 9 && clens[8] == 10 && memcmp(cols[8], "near-bound", 10) == 0) {
            mark = 1;
        } else if (nc == 8 || (nc >= 8 && clens[7] == 10 && memcmp(cols[7], "near-bound", 10) == 0)) {
            if (clens[7] == 10 && memcmp(cols[7], "near-bound", 10) == 0) mark = 1;
        } else if (nc == 1) {
            mark = 1;
        }
        if (mark) {
            int idx = pd_find_id(cols[0], (size_t)clens[0]);
            if (idx >= 0) pd_ids[idx].near_bound = 1;
        }
    }
    mm_free(b);
    return 0;
}

static void pd_pack_normal_group(int *rem, int nrem, int win_size, int *w_normal) {
    if (nrem <= 0) return;
    if (!pd_has_times) {
        int norm_rem[PD_MAX_IDS];
        int nnorm = 0;
        for (int i = 0; i < nrem; i++) {
            if (pd_is_isolated_long_id(pd_ids[rem[i]].id) && pd_nwins < pd_max_wins) {
                PdWin *w = &pd_wins[pd_nwins++];
                cx_fmt(w->wid, sizeof w->wid, "W%04d", pd_nwins - 1);
                w->jobs = 1;
                cx_fmt(w->phase, sizeof w->phase, "long");
                w->count = 1;
                w->idxs[0] = rem[i];
            } else {
                norm_rem[nnorm++] = rem[i];
            }
        }
        int pos = 0;
        while (pos < nnorm && pd_nwins < pd_max_wins) {
            int take = nnorm - pos;
            if (take > win_size) {
                if (nnorm - pos < win_size + 8 && nnorm - pos >= 16) take = (nnorm - pos) / 2;
                else take = win_size;
            }
            PdWin *w = &pd_wins[pd_nwins];
            cx_fmt(w->wid, sizeof w->wid, "W%04d", pd_nwins);
            w->jobs = pd_normal_jobs;
            cx_fmt(w->phase, sizeof w->phase, "normal");
            w->count = take;
            for (int k = 0; k < take; k++) w->idxs[k] = norm_rem[pos + k];
            pos += take;
            pd_nwins++;
            (*w_normal)++;
        }
        return;
    }
    /* Sort descending by historical time_ms, breaking ties by original position.
     * Isolated-long batches sort ahead of normal batches so all long windows group
     * together into contiguous window_lanes=4 waves without fragmenting normal packing. */
    for (int i = 1; i < nrem; i++) {
        int v = rem[i];
        long t = pd_ids[v].time_ms;
        int iso_v = pd_is_isolated_long_id(pd_ids[v].id) || t > PD_TIMED_BUDGET_MS ||
                    (!pd_ids[v].measured && !(pd_unmeasured_ms > 0 || pd_is_compile_smoke_id(pd_ids[v].id)));
        int j = i - 1;
        while (j >= 0) {
            int u = rem[j];
            long tu = pd_ids[u].time_ms;
            int iso_u = pd_is_isolated_long_id(pd_ids[u].id) || tu > PD_TIMED_BUDGET_MS ||
                        (!pd_ids[u].measured && !(pd_unmeasured_ms > 0 || pd_is_compile_smoke_id(pd_ids[u].id)));
            if (iso_u < iso_v || (iso_u == iso_v && tu < t)) {
                rem[j + 1] = rem[j];
                j--;
            } else break;
        }
        rem[j + 1] = v;
    }
    int pos = 0;
    while (pos < nrem && pd_nwins < pd_max_wins) {
        PdWin *w = &pd_wins[pd_nwins];
        cx_fmt(w->wid, sizeof w->wid, "W%04d", pd_nwins);
        w->jobs = pd_normal_jobs;
        cx_fmt(w->phase, sizeof w->phase, "normal");
        w->count = 0;
        int can_pack_unmeasured = (pd_unmeasured_ms > 0 || pd_is_compile_smoke_id(pd_ids[rem[pos]].id));
        if (pd_is_isolated_long_id(pd_ids[rem[pos]].id) || pd_ids[rem[pos]].time_ms > PD_TIMED_BUDGET_MS ||
            (!pd_ids[rem[pos]].measured && !can_pack_unmeasured)) {
            /* An isolated or missing sample cannot establish parallel wall time unless conservative --unmeasured-ms is set. */
            cx_fmt(w->phase, sizeof w->phase, "long");
            w->idxs[w->count++] = rem[pos++];
            w->jobs = 1;
            pd_nwins++;
            continue;
        }
        long cost = 0;
        /* dvqualify preserves --ids order and barriers every --segment-batches jobs. */
        while (pos < nrem && w->count < win_size &&
               !pd_is_isolated_long_id(pd_ids[rem[pos]].id) &&
               cost + pd_ids[rem[pos]].time_ms <= PD_TIMED_BUDGET_MS) {
            cost += pd_ids[rem[pos]].time_ms;
            for (int lane = 0; lane < w->jobs && pos < nrem && w->count < win_size &&
                 !pd_is_isolated_long_id(pd_ids[rem[pos]].id) &&
                 (pd_ids[rem[pos]].measured || pd_unmeasured_ms > 0 || pd_is_compile_smoke_id(pd_ids[rem[pos]].id)); lane++)
                w->idxs[w->count++] = rem[pos++];
        }
        if (!w->count) return;
        pd_nwins++;
        (*w_normal)++;
    }
}

static int pd_warmup_fits(int i, long cost) {
    return !pd_has_times || ((pd_ids[i].measured || pd_unmeasured_ms > 0) &&
        cost + pd_ids[i].time_ms <= PD_TIMED_BUDGET_MS);
}

static int pd_build_plan(int win_size, int warmup_n, const char *out_dir) {
    int used[PD_MAX_IDS];
    int i, w_warmup = 0, w_heavy = 0, w_normal = 0, w_near_bound = 0, has_rc = -1;
    if (win_size < 8 || win_size > 12) return pd_refuse("win-size-must-be-8-to-12");
    if (pd_normal_jobs < 1 || pd_normal_jobs > 16) return pd_refuse("normal-jobs-must-be-1-to-16");
    if (pd_max_wins < 1 || pd_max_wins > PD_MAX_WINS) return pd_refuse("invalid-max-wins");
    if (pd_unmeasured_ms < 0 || pd_unmeasured_ms > PD_BATCH_WINDOW_MS) return pd_refuse("invalid-unmeasured-ms");
    if (pd_nids <= 0) return pd_refuse("empty-ids-file");
    if (pd_nids >= PD_PREP_MAXB) {
        fprintf(stderr, "PRERUN_MAXB_EXCEEDED\tbatches=%d\tmaxb=%d\n", pd_nids, PD_PREP_MAXB);
        return pd_refuse("batch-count-reaches-release-prep-maxb-1024");
    }
    for (i = 0; i < pd_nids; i++) {
        used[i] = 0;
        if (pd_has_times) {
            if (!pd_ids[i].measured) {
                long u_ms = pd_unmeasured_ms > 0 ? pd_unmeasured_ms : PD_TIMED_BUDGET_MS;
                if (pd_is_compile_smoke_id(pd_ids[i].id) && u_ms < PD_DEFAULT_UNMEASURED_MS)
                    u_ms = PD_DEFAULT_UNMEASURED_MS;
                pd_ids[i].time_ms = u_ms;
            }
            if (pd_ids[i].time_ms > PD_BATCH_WINDOW_MS) {
                fprintf(stderr, "PRERUN_SPLIT_REQUIRED\tbatch=%s\testimate_ms=%ld\tlimit_ms=%d\n",
                    pd_ids[i].id, pd_ids[i].time_ms, PD_BATCH_WINDOW_MS);
                return pd_refuse("batch-exceeds-single-window-estimate");
            }
        }
        if (tx_eqz(pd_ids[i].id, "real-commit")) has_rc = i;
    }
    pd_nwins = 0;

    /* 1. Cold-cache warmup window (jobs=1, lightest single batch; avoid non-PASS and cold-heavy unit-frontcache-*) */
    if (warmup_n > 0) {
        PdWin *w = &pd_wins[pd_nwins];
        cx_fmt(w->wid, sizeof w->wid, "W0000");
        w->jobs = 1;
        cx_fmt(w->phase, sizeof w->phase, "warmup");
        w->count = 0;
        long cost = 0;
        if (pd_has_times && warmup_n == 1) {
            int best = -1;
            for (i = 0; i < pd_nids; i++) {
                if (!pd_ids[i].heavy && !pd_ids[i].near_bound && !pd_ids[i].nonpass && !pd_is_early_canary_id(pd_ids[i].id) &&
                    !pd_is_warmup_excluded_id(pd_ids[i].id) && pd_warmup_fits(i, 0)) {
                    if (best < 0 || pd_ids[i].time_ms < pd_ids[best].time_ms) best = i;
                }
            }
            if (best < 0) {
                for (i = 0; i < pd_nids; i++) {
                    if (!pd_ids[i].heavy && !pd_ids[i].near_bound && !pd_is_warmup_excluded_id(pd_ids[i].id) && pd_warmup_fits(i, 0)) {
                        if (best < 0 || pd_ids[i].time_ms < pd_ids[best].time_ms) best = i;
                    }
                }
            }
            if (best < 0) {
                for (i = 0; i < pd_nids; i++) {
                    if (!pd_ids[i].heavy && !pd_ids[i].near_bound && pd_warmup_fits(i, 0)) {
                        if (best < 0 || pd_ids[i].time_ms < pd_ids[best].time_ms) best = i;
                    }
                }
            }
            if (best >= 0) {
                w->idxs[w->count++] = best;
                used[best] = 1;
                cost += pd_ids[best].time_ms;
            }
        } else {
            for (i = 0; i < pd_nids && w->count < warmup_n && w->count < win_size; i++) {
                if (!pd_ids[i].heavy && !pd_ids[i].near_bound && !pd_ids[i].priority && !pd_is_early_canary_id(pd_ids[i].id) &&
                    !pd_is_warmup_excluded_id(pd_ids[i].id) && pd_warmup_fits(i, cost)) {
                    w->idxs[w->count++] = i;
                    used[i] = 1;
                    cost += pd_ids[i].time_ms;
                }
            }
            for (i = 0; i < pd_nids && w->count < warmup_n && w->count < win_size; i++) {
                if (!used[i] && !pd_ids[i].heavy && !pd_ids[i].near_bound && !pd_is_warmup_excluded_id(pd_ids[i].id) && pd_warmup_fits(i, cost)) {
                    w->idxs[w->count++] = i;
                    used[i] = 1;
                    cost += pd_ids[i].time_ms;
                }
            }
            for (i = 0; i < pd_nids && w->count < warmup_n && w->count < win_size; i++) {
                if (!used[i] && !pd_ids[i].heavy && !pd_ids[i].near_bound && pd_warmup_fits(i, cost)) {
                    w->idxs[w->count++] = i;
                    used[i] = 1;
                    cost += pd_ids[i].time_ms;
                }
            }
        }
        if (w->count > 0) { pd_nwins++; w_warmup = 1; }
    }

    /* 1b. Early product-qualification canaries (ri-image-*, ri-route-refuse, lane-key-probes):
     *     pack immediately after W0000 warmup (before 70+ heavy netregen windows) so any product
     *     or lane table regression fails within the first 2 minutes instead of after 45 minutes. */
    {
        static int can_rem[PD_MAX_IDS];
        int ncan = 0;
        for (i = 0; i < pd_nids; i++) {
            if (!used[i] && !pd_ids[i].heavy && !pd_ids[i].near_bound && pd_is_early_canary_id(pd_ids[i].id)) {
                can_rem[ncan++] = i;
                used[i] = 1;
            }
        }
        pd_pack_normal_group(can_rem, ncan, win_size, &w_normal);
    }

    /* 2. Priority batches first (tier 2 = explicit risk/non-PASS first, tier 1 = secondary platform priority;
     *    within each tier pack normal parallel windows before single-batch heavy windows so first red light fires in W0001) */
    if (pd_has_priority) {
        for (int prio = 2; prio >= 1; prio--) {
            static int pri_rem[PD_MAX_IDS];
            int npri = 0;
            for (i = 0; i < pd_nids; i++) {
                if (!used[i] && !pd_ids[i].heavy && !pd_ids[i].near_bound && pd_ids[i].priority == prio) {
                    pri_rem[npri++] = i;
                    used[i] = 1;
                }
            }
            pd_pack_normal_group(pri_rem, npri, win_size, &w_normal);
            if (has_rc >= 0 && !used[has_rc] && !pd_ids[has_rc].near_bound && pd_ids[has_rc].priority == prio && pd_nwins + 2 <= pd_max_wins) {
                PdWin *wp = &pd_wins[pd_nwins++];
                cx_fmt(wp->wid, sizeof wp->wid, "W%04d", pd_nwins - 1);
                wp->jobs = 1;
                cx_fmt(wp->phase, sizeof wp->phase, "prebuild-self");
                wp->count = 1;
                wp->idxs[0] = has_rc;

                PdWin *wr = &pd_wins[pd_nwins++];
                cx_fmt(wr->wid, sizeof wr->wid, "W%04d", pd_nwins - 1);
                wr->jobs = 1;
                cx_fmt(wr->phase, sizeof wr->phase, "heavy");
                wr->count = 1;
                wr->idxs[0] = has_rc;
                used[has_rc] = 1;
                w_heavy++;
            }
            for (i = 0; i < pd_nids; i++) {
                if (!used[i] && pd_ids[i].heavy && !pd_ids[i].near_bound && pd_ids[i].priority == prio && pd_nwins < pd_max_wins) {
                    PdWin *w = &pd_wins[pd_nwins];
                    cx_fmt(w->wid, sizeof w->wid, "W%04d", pd_nwins);
                    w->jobs = 1;
                    cx_fmt(w->phase, sizeof w->phase, "heavy");
                    w->count = 1;
                    w->idxs[0] = i;
                    used[i] = 1;
                    pd_nwins++;
                    w_heavy++;
                }
            }
        }
    }

    /* 3. Two-phase real-commit: prebuild-self followed by single-batch jobs=1 window */
    if (has_rc >= 0 && !used[has_rc] && !pd_ids[has_rc].near_bound && pd_nwins + 2 <= pd_max_wins) {
        PdWin *wp = &pd_wins[pd_nwins++];
        cx_fmt(wp->wid, sizeof wp->wid, "W%04d", pd_nwins - 1);
        wp->jobs = 1;
        cx_fmt(wp->phase, sizeof wp->phase, "prebuild-self");
        wp->count = 1;
        wp->idxs[0] = has_rc;

        PdWin *wr = &pd_wins[pd_nwins++];
        cx_fmt(wr->wid, sizeof wr->wid, "W%04d", pd_nwins - 1);
        wr->jobs = 1;
        cx_fmt(wr->phase, sizeof wr->phase, "heavy");
        wr->count = 1;
        wr->idxs[0] = has_rc;
        used[has_rc] = 1;
        w_heavy++;
    }

    /* 4. Other heavy batches: each in its own jobs=1 window */
    for (i = 0; i < pd_nids; i++) {
        if (!used[i] && pd_ids[i].heavy && !pd_ids[i].near_bound && pd_nwins < pd_max_wins) {
            PdWin *w = &pd_wins[pd_nwins];
            cx_fmt(w->wid, sizeof w->wid, "W%04d", pd_nwins);
            w->jobs = 1;
            cx_fmt(w->phase, sizeof w->phase, "heavy");
            w->count = 1;
            w->idxs[0] = i;
            used[i] = 1;
            pd_nwins++;
            w_heavy++;
        }
    }

    /* 5. Remaining normal batches */
    {
        static int rem[PD_MAX_IDS];
        int nrem = 0;
        for (i = 0; i < pd_nids; i++) if (!used[i] && !pd_ids[i].near_bound) { rem[nrem++] = i; used[i] = 1; }
        pd_pack_normal_group(rem, nrem, win_size, &w_normal);
    }

    /* 6. Final near-bound -j 1 warm windows (exclusive, after cache warmup and normal/heavy work).
     *    Preserve two-phase prebuild-self for real-commit when real-commit itself is near-bound. */
    for (i = 0; i < pd_nids; i++) {
        if (!used[i] && pd_ids[i].near_bound) {
            if (i == has_rc) {
                if (pd_nwins + 2 > pd_max_wins) continue;
                PdWin *wp = &pd_wins[pd_nwins++];
                cx_fmt(wp->wid, sizeof wp->wid, "W%04d", pd_nwins - 1);
                wp->jobs = 1;
                cx_fmt(wp->phase, sizeof wp->phase, "prebuild-self");
                wp->count = 1;
                wp->idxs[0] = i;
            }
            if (pd_nwins < pd_max_wins) {
                PdWin *w = &pd_wins[pd_nwins];
                cx_fmt(w->wid, sizeof w->wid, "W%04d", pd_nwins);
                w->jobs = 1;
                cx_fmt(w->phase, sizeof w->phase, "near-bound-warm");
                w->count = 1;
                w->idxs[0] = i;
                used[i] = 1;
                pd_nwins++;
                w_near_bound++;
            }
        }
    }

    int planned = 0;
    long estimated = 0, max_window = 0, lane_wall = 0, lane_peak = 0;
    int lane_count = 0, lane_groups = 0;
    for (int wi = 0; wi < pd_nwins; wi++) {
        PdWin *w = &pd_wins[wi];
        if (tx_eqz(w->phase, "prebuild-self")) {
            if(lane_count){lane_wall+=lane_peak;lane_groups++;lane_peak=0;lane_count=0;}
            continue;
        }
        planned += w->count;
        long wall = 0;
        for (int k = 0; k < w->count; k += w->jobs)
            wall += pd_ids[w->idxs[k]].time_ms;
        if (w->count > 1 && wall > PD_WINDOW_TARGET_MS)
            return pd_refuse("window-exceeds-target-budget");
        long target_wall = wall > PD_WINDOW_TARGET_MS ? PD_WINDOW_TARGET_MS : wall;
        if (target_wall > max_window) max_window = target_wall;
        estimated += wall;
        if (w->count == 1 && pd_can_share_window(w->phase, pd_ids[w->idxs[0]].id, w->jobs)) {
            if (wall > lane_peak) lane_peak = wall;
            if (++lane_count < pd_plan_lanes) continue;
        } else {
            lane_wall += wall;
            lane_groups++;
        }
        if (lane_count) { lane_wall += lane_peak; lane_groups++; lane_peak = 0; lane_count = 0; }
    }
    if (lane_count) { lane_wall += lane_peak; lane_groups++; }
    if (planned != pd_nids) {
        fprintf(stderr, "PRERUN_MAX_WINS_EXCEEDED\twindows=%d\tmax_wins=%d\tplanned=%d\ttotal=%d\n",
                pd_nwins, pd_max_wins, planned, pd_nids);
        return pd_refuse("window-plan-did-not-cover-every-batch");
    }
    pd_mkdirs(out_dir);
    char wpath[PD_PW];
    if (cx_fmt(wpath, sizeof wpath, "%s/windows.tsv", out_dir)) return pd_refuse("path-bound");
    size_t cap = 65536 + (size_t)pd_nids * 160;
    char *buf = (char *)mm_alloc(cap);
    if (!buf) return pd_refuse("oom");
    size_t bp = 0;
    char timed_hdr[160];
    const char *hdr = timed_hdr;
    if (pd_has_times) {
        if (cx_fmt(timed_hdr, sizeof timed_hdr, PD_TIMED_HEADER "%d budget_ms=%d\n# window-lanes=%d\nwindow\tjobs\tphase\tcount\tids\n",
                   pd_normal_jobs, PD_TIMED_BUDGET_MS,pd_plan_lanes)) { mm_free(buf); return pd_refuse("timed-header-bound"); }
    } else if (cx_fmt(timed_hdr,sizeof timed_hdr,"# prerun-drive windows\n# window-lanes=%d\nwindow\tjobs\tphase\tcount\tids\n",pd_plan_lanes)) {
        mm_free(buf);return pd_refuse("window-header-bound");
    }
    size_t hl = strlen(hdr);
    mm_copy(buf + bp, cap - bp, hdr, hl); bp += hl;
    for (int wi = 0; wi < pd_nwins; wi++) {
        PdWin *w = &pd_wins[wi];
        char line_hdr[128];
        cx_fmt(line_hdr, sizeof line_hdr, "%s\t%d\t%s\t%d\t", w->wid, w->jobs, w->phase, w->count);
        size_t lh = strlen(line_hdr);
        if (bp + lh + 2 >= cap) break;
        mm_copy(buf + bp, cap - bp, line_hdr, lh); bp += lh;
        for (int k = 0; k < w->count; k++) {
            const char *id = pd_ids[w->idxs[k]].id;
            size_t il = strlen(id);
            if (bp + il + 3 >= cap) break;
            if (k > 0) buf[bp++] = ',';
            mm_copy(buf + bp, cap - bp, id, il); bp += il;
        }
        buf[bp++] = '\n';
    }
    int wrc = sy_write_file(wpath, buf, (int64_t)bp, 0644);
    mm_free(buf);
    if (wrc) return pd_refuse("write-windows");
    printf("PRERUN_PLAN\ttotal=%d\twindows=%d\twarmup=%d\theavy=%d\tnormal=%d\tout=%s\n",
           pd_nids, pd_nwins, w_warmup, w_heavy, w_normal, wpath);
    if (w_near_bound > 0)
        printf("PRERUN_NEAR_BOUND\twindows=%d\tphase=near-bound-warm\tjobs=1\n", w_near_bound);
    if (pd_has_times) {
        printf("PRERUN_LANE_ESTIMATE\twindow_lanes=%d\tnormal_jobs=%d\tgroups=%d\twall_ms=%ld\tserial_ms=%ld\tscope=batch-timing-only-no-contention\n",
               pd_plan_lanes,pd_normal_jobs,lane_groups,lane_wall,estimated);
        if (pd_has_overhead)
            printf("PRERUN_ESTIMATE\twave_ms=%ld\tmax_window_ms=%ld\tbudget_ms=%d\tscope=batch-timing-only\touter_overhead=%ldms\touter_overhead_ms=%ld\twindow_wall_ms=%ld\tsum_batch_ms=%ld\treserve_ms=%d\n",
                   estimated, max_window, PD_TIMED_BUDGET_MS, pd_outer_overhead_ms, pd_outer_overhead_ms, pd_measured_wall_ms, pd_measured_batch_ms, PD_WINDOW_RESERVE_MS);
        else
            printf("PRERUN_ESTIMATE\twave_ms=%ld\tmax_window_ms=%ld\tbudget_ms=%d\tscope=batch-timing-only\touter_overhead=UNMEASURED\treserve_ms=%d\n",
                   estimated, max_window, PD_TIMED_BUDGET_MS, PD_WINDOW_RESERVE_MS);
    }
    return 0;
}

static int pd_state_find(const char *id) {
    for (int i = 0; i < pd_nstates; i++) if (tx_eqz(pd_states[i].id, id)) return i;
    if (pd_nstates >= PD_MAX_IDS) return -1;
    PdState *s = &pd_states[pd_nstates];
    memset(s, 0, sizeof *s);
    cx_fmt(s->id, sizeof s->id, "%s", id);
    return pd_nstates++;
}

static void pd_ingest_strict_buf(const char *b, int64_t n) {
    int64_t pos = 0;
    while (pos < n) {
        int64_t ls = pos;
        while (pos < n && b[pos] != '\n') pos++;
        int64_t le = pos;
        if (pos < n) pos++;
        if (le > ls && b[le - 1] == '\r') le--;
        if (le <= ls || b[ls] == '#') continue;
        if (le - ls >= 4 && memcmp(b + ls, "RAW\t", 4) == 0) continue;
        if (le - ls >= 8 && memcmp(b + ls, "SUMMARY\t", 8) == 0) continue;
        if (le - ls >= 6 && memcmp(b + ls, "batch\t", 6) == 0) continue;
        const char *cols[12]; int64_t clens[12]; int nc = 0; int64_t p = ls;
        while (nc < 12) {
            int64_t cs = p;
            while (p < le && b[p] != '\t') p++;
            cols[nc] = b + cs; clens[nc] = p - cs; nc++;
            if (p >= le) break;
            p++;
        }
        if (nc < 3 || clens[0] <= 0 || clens[0] >= 127 || clens[2] <= 0 || clens[2] >= 23) continue;
        char id[128], st[24];
        if (mm_copy(id, sizeof id, cols[0], (size_t)clens[0])) continue;
        id[clens[0]] = 0;
        if (mm_copy(st, sizeof st, cols[2], (size_t)clens[2])) continue;
        st[clens[2]] = 0;
        int idx = pd_state_find(id);
        if (idx < 0) continue;
        PdState *s = &pd_states[idx];
        if (s->seen && tx_eqz(s->status, "FAIL") && tx_eqz(st, "PASS")) s->superseded = 1;
        if (tx_eqz(st, "FAIL")) s->had_fail = 1;
        s->seen++;
        cx_fmt(s->status, sizeof s->status, "%s", st);
        if (clens[1] > 0 && clens[1] < (int64_t)sizeof s->domain) {
            mm_copy(s->domain, sizeof s->domain, cols[1], (size_t)clens[1]);
            s->domain[clens[1]] = 0;
        }
        if (nc >= 4 && clens[3] > 0 && clens[3] < 12) {
            char rcb[16];
            mm_copy(rcb, sizeof rcb, cols[3], (size_t)clens[3]);
            rcb[clens[3]] = 0;
            s->rc = atoi(rcb);
        }
        if (nc >= 9 && clens[8] > 0) {
            size_t nl = (size_t)(clens[8] < 250 ? clens[8] : 250);
            mm_copy(s->note, sizeof s->note, cols[8], nl);
            s->note[nl] = 0;
        } else {
            cx_fmt(s->note, sizeof s->note, "-");
        }
        size_t rl = (size_t)(le - ls < 1000 ? le - ls : 1000);
        mm_copy(s->raw_line, sizeof s->raw_line, b + ls, rl);
        s->raw_line[rl] = 0;
    }
}

/* Harvest already-completed PASS rows (and their RAW lines) from an existing window evidence file
 * so an outer window timeout or resumed partial window never discards completed batches. */
static void pd_harvest_passed(const char *outp, const char *full_ids,
                              char *saved_hdr, size_t hdr_cap,
                              char *saved_rows, size_t rows_cap, size_t *rows_len,
                              int *passed_flags, char win_ids[][128], int nwin,
                              char *rem_ids, size_t rem_cap) {
    unsigned char *b = 0; int64_t n = 0;
    if (sy_read_file(outp, &b, &n, 4 << 20) == 0 && b && n > 0) {
        int64_t pos = 0;
        int last_pass_idx = -1;
        size_t hp = strlen(saved_hdr);
        while (pos < n) {
            int64_t ls = pos;
            while (pos < n && b[pos] != '\n') pos++;
            int64_t le = pos;
            if (pos < n) pos++;
            if (le > ls && b[le - 1] == '\r') le--;
            int64_t llen = le - ls;
            const char *line = (const char *)b + ls;
            if (llen <= 0) continue;
            if (line[0] == '#' || (llen >= 6 && memcmp(line, "batch\t", 6) == 0)) {
                if (tx_find(line, (long)llen, "# segment=", 10) < 0 &&
                    tx_find(line, (long)llen, "# PLANNED=", 10) < 0 &&
                    tx_find(saved_hdr, (long)hp, line, (long)llen) < 0 &&
                    hp + (size_t)llen + 2 < hdr_cap) {
                    mm_copy(saved_hdr + hp, hdr_cap - hp, line, (size_t)llen);
                    hp += (size_t)llen;
                    saved_hdr[hp++] = '\n';
                    saved_hdr[hp] = 0;
                }
                last_pass_idx = -1;
                continue;
            }
            if (llen >= 4 && memcmp(line, "RAW\t", 4) == 0) {
                if (last_pass_idx >= 0 && *rows_len + (size_t)llen + 2 < rows_cap) {
                    mm_copy(saved_rows + *rows_len, rows_cap - *rows_len, line, (size_t)llen);
                    *rows_len += (size_t)llen;
                    saved_rows[(*rows_len)++] = '\n';
                    saved_rows[*rows_len] = 0;
                }
                last_pass_idx = -1;
                continue;
            }
            last_pass_idx = -1;
            if ((llen >= 8 && memcmp(line, "SUMMARY\t", 8) == 0) ||
                (llen >= 11 && memcmp(line, "CHECKPOINT\t", 11) == 0)) continue;
            const char *cols[6]; int64_t clens[6]; int nc = 0; int64_t p = 0;
            while (nc < 6 && p <= llen) {
                int64_t cs = p;
                while (p < llen && line[p] != '\t') p++;
                cols[nc] = line + cs; clens[nc] = p - cs; nc++; p++;
            }
            if (nc >= 3 && clens[2] == 4 && memcmp(cols[2], "PASS", 4) == 0) {
                for (int wi = 0; wi < nwin; wi++) {
                    if (!passed_flags[wi] && strlen(win_ids[wi]) == (size_t)clens[0] &&
                        memcmp(win_ids[wi], cols[0], (size_t)clens[0]) == 0) {
                        if (*rows_len + (size_t)llen + 2 < rows_cap) {
                            mm_copy(saved_rows + *rows_len, rows_cap - *rows_len, line, (size_t)llen);
                            *rows_len += (size_t)llen;
                            saved_rows[(*rows_len)++] = '\n';
                            saved_rows[*rows_len] = 0;
                            passed_flags[wi] = 1;
                            last_pass_idx = wi;
                        }
                        break;
                    }
                }
            }
        }
        mm_free(b);
    }
    rem_ids[0] = 0;
    size_t rp = 0;
    for (int wi = 0; wi < nwin; wi++) {
        if (!passed_flags[wi]) {
            size_t il = strlen(win_ids[wi]);
            if (rp + il + 2 < rem_cap) {
                if (rp > 0) rem_ids[rp++] = ',';
                mm_copy(rem_ids + rp, rem_cap - rp, win_ids[wi], il);
                rp += il;
                rem_ids[rp] = 0;
            }
        }
    }
    (void)full_ids;
}

static void pd_prepend_saved(const char *outp, const char *saved_hdr, const char *saved_rows, size_t saved_len) {
    if (saved_len == 0) return;
    unsigned char *ob = 0; int64_t on = 0;
    int has_ob = (sy_read_file(outp, &ob, &on, 4 << 20) == 0 && ob && on > 0);
    size_t hlen = strlen(saved_hdr);
    size_t cap = hlen + saved_len + (size_t)(has_ob ? on : 0) + 64;
    char *comb = (char *)mm_alloc(cap);
    if (!comb) { if (ob) mm_free(ob); return; }
    size_t cp = 0;
    if (hlen > 0) {
        mm_copy(comb + cp, cap - cp, saved_hdr, hlen);
        cp += hlen;
    } else {
        const char *dh = "# devsvc qualify\nbatch\tdomain\tstatus\trc\tcandidate\tms\tload1\tretries\tnote\n";
        size_t dl = strlen(dh);
        mm_copy(comb + cp, cap - cp, dh, dl);
        cp += dl;
    }
    mm_copy(comb + cp, cap - cp, saved_rows, saved_len);
    cp += saved_len;
    if (has_ob) {
        int64_t pos = 0;
        while (pos < on) {
            int64_t ls = pos;
            while (pos < on && ob[pos] != '\n') pos++;
            int64_t le = pos;
            if (pos < on) pos++;
            int64_t llen = le - ls;
            if (llen > 0 && ob[ls] != '#' && !(llen >= 6 && memcmp(ob + ls, "batch\t", 6) == 0)) {
                mm_copy(comb + cp, cap - cp, (const char *)ob + ls, (size_t)llen);
                cp += (size_t)llen;
                comb[cp++] = '\n';
            }
        }
        mm_free(ob);
    }
    sy_write_file(outp, comb, (int64_t)cp, 0644);
    mm_free(comb);
}

static int pd_sum_window_batch_ms(const char *outp, long *out_sum) {
    unsigned char *b = 0; int64_t n = 0;
    *out_sum = 0;
    if (!outp || !outp[0] || sy_read_file(outp, &b, &n, 4 << 20) != 0 || !b || n <= 0) {
        if (b) mm_free(b);
        return 0;
    }
    int count = 0;
    long sum = 0;
    int64_t pos = 0;
    while (pos < n) {
        int64_t ls = pos;
        while (pos < n && b[pos] != '\n') pos++;
        int64_t le = pos;
        if (pos < n) pos++;
        if (le > ls && b[le - 1] == '\r') le--;
        if (le <= ls || b[ls] == '#') continue;
        if (le - ls >= 4 && memcmp(b + ls, "RAW\t", 4) == 0) continue;
        if (le - ls >= 8 && memcmp(b + ls, "SUMMARY\t", 8) == 0) continue;
        if (le - ls >= 11 && memcmp(b + ls, "CHECKPOINT\t", 11) == 0) continue;
        if (le - ls >= 6 && memcmp(b + ls, "batch\t", 6) == 0) continue;
        const char *cols[8]; int64_t clens[8]; int nc = 0; int64_t p = ls;
        while (nc < 8) {
            int64_t cs = p;
            while (p < le && b[p] != '\t') p++;
            cols[nc] = (const char *)b + cs; clens[nc] = p - cs; nc++;
            if (p >= le) break;
            p++;
        }
        if (nc >= 6 && pd_is_digits(cols[5], clens[5]) && clens[5] < 16) {
            char nbuf[16];
            mm_copy(nbuf, sizeof nbuf, cols[5], (size_t)clens[5]);
            nbuf[clens[5]] = 0;
            sum += atol(nbuf);
            count++;
        }
    }
    mm_free(b);
    *out_sum = sum;
    return count;
}

static int pd_call_window(const char *root, const char *cand, const char *mock_runner,
                          const char *wid, const char *ids, const char *outp,
                          int jobs, int attempt, char *temp_env) {
    char size[12], seq[12], why[256];
    if (cx_fmt(size, sizeof size, "%d", jobs) || cx_fmt(seq, sizeof seq, "%d", attempt)) return 2;
    char *real[] = {"sh", "./unisacc.com", "tools/dvqualify.cx", "--", ".",
                    "--candidate", (char *)cand, "--ids", (char *)ids, "--out", (char *)outp,
                    "--jobs", size, "--segment-batches", size, 0};
    char *mock[] = {"sh", (char *)mock_runner, "window", (char *)wid, size,
                    (char *)ids, (char *)outp, seq, 0};
    np_result r = {0};
    char *env[] = {temp_env, 0};
    char ep[PD_PW];
    int have_ep = (outp && outp[0] && !cx_fmt(ep, sizeof ep, "%s.stderr", outp));
    /* A retry reuses the same <outp>.stderr path; drop any sidecar from the previous attempt first,
       so a later silent pass never leaves the earlier attempt's refusal reason next to the window. */
    if (have_ep) (void)sy_unlink(ep);
    int s1mp = 0; { const char *e = sy_env("UNISACC_S1_MAX_PROCS"); int v = (e && e[0]) ? atoi(e) : 0; if (v >= 1 && v <= 256) s1mp = v; }
    int tr = np_run_capped(mock_runner ? mock : real, root, temp_env ? env : 0, PD_CHILD_SECONDS, s1mp, &r, why, sizeof why);
    int rc = tr ? 124 : r.rc;
    /* Keep the child's stderr next to the window output: the candidate refusal reason (e.g. a
     * duplicate label), PRECHECK/LAYOUT/KIT evidence.  Only adds a file; never changes the verdict,
     * the budget or rc. A failed write is ignored (the window result is already in outp).  r.err is
     * a byte buffer of r.errn bytes; sy_write_file writes exactly that many, no NUL needed.  A
     * sidecar is diagnostic, so cap it at the last 1 MiB: the tail carries the refusal/exit reason
     * and this keeps a runaway child's stderr from filling the window directory. */
    if (r.errn > 0 && r.err && have_ep) {
        long keep = (long)r.errn > (1L << 20) ? (1L << 20) : (long)r.errn;
        (void)sy_write_file(ep, r.err + ((long)r.errn - keep), (int64_t)keep, 0644);
    }
    np_free(&r);
    return rc;
}

static void pd_log_window(const char *wid, const char *phase, const char *outp,
                          int jobs, int attempt, int rc, long wall_ms) {
    long sum_batch_ms = 0;
    if (pd_sum_window_batch_ms(outp, &sum_batch_ms) > 0) {
        long overhead_ms = wall_ms - sum_batch_ms;
        pd_run_wall_ms += wall_ms;
        pd_run_batch_ms += sum_batch_ms;
        pd_run_measured_wins++;
        printf("PRERUN_WINDOW\twindow=%s\tphase=%s\tattempt=%d\tjobs=%d\trc=%d\twall_ms=%ld\tsum_batch_ms=%ld\touter_overhead_ms=%ld\n",
               wid, phase, attempt, jobs, rc, wall_ms, sum_batch_ms, overhead_ms);
    } else {
        printf("PRERUN_WINDOW\twindow=%s\tphase=%s\tattempt=%d\tjobs=%d\trc=%d\twall_ms=%ld\touter_overhead=UNMEASURED\n",
               wid, phase, attempt, jobs, rc, wall_ms);
    }
    fflush(stdout);
}

static int pd_window_attempt(const char *root, const char *cand, const char *mock_runner,
                             const char *wid, const char *phase, const char *ids,
                             const char *outp, int jobs, int attempt) {
    long started = sy_now_ms();
    int rc = pd_call_window(root, cand, mock_runner, wid, ids, outp, jobs, attempt, 0);
    pd_log_window(wid, phase, outp, jobs, attempt, rc, sy_now_ms() - started);
    return rc;
}

/* Expected failures retain their raw FAIL row. Match the candidate column and
 * the complete old->new image fingerprint, never just the batch name. */
static int pd_expected_red(const PdState *s) {
    if (!pd_expected_rows || !pd_candidate_sha[0] || strlen(s->note) != 136 ||
        strncmp(s->note, "image=", 6) || strncmp(s->note + 70, "->", 2)) return 0;
    for (int i = 6; i < 136; i++) {
        if (i != 70 && i != 71 && !strchr("0123456789abcdef", s->note[i])) return 0;
    }
    const char *candidate = s->raw_line;
    for (int i = 0; i < 4; i++) {
        candidate = strchr(candidate, '\t');
        if (!candidate) return 0;
        candidate++;
    }
    if (strncmp(candidate, pd_candidate_sha, 64) || candidate[64] != '\t') return 0;
    char key[400];
    if (cx_fmt(key, sizeof key, "%s\t%s\t", s->id, s->note)) return 0;
    const char *row = pd_expected_rows;
    while (*row) {
        if (!strncmp(row, key, strlen(key))) return 1;
        row = strchr(row, '\n');
        if (!row) break;
        row++;
    }
    return 0;
}

static int pd_scout_state(const char *dir) {
    char p[PD_PW];
    if (cx_fmt(p, sizeof p, "%s/SCOUT_ONLY", dir)) return -1;
    return sy_exists(p);
}

static int pd_batch_receipt(const char *path, const char *id, int rc) {
    unsigned char *buf = 0;
    int64_t n = 0;
    if (sy_read_file(path, &buf, &n, 4 << 20)) return 0;
    pd_nstates = 0;
    pd_ingest_strict_buf((const char *)buf, n);
    mm_free(buf);
    if (pd_nstates != 1 || !tx_eqz(pd_states[0].id, id)) return 0;
    if (tx_eqz(pd_states[0].status, "PASS")) return rc == 0 ? 1 : 0;
    return tx_eqz(pd_states[0].status, "FAIL") || tx_eqz(pd_states[0].status, "UNKNOWN") ? 2 : 0;
}

/* Keep the original wave and its completed rows. Recovery receipts sort
 * after that wave and each finished child can be reused by --resume. */
static int pd_recover_serial(const char *root, const char *cand, const char *out_dir,
                             const char *mock_runner, const char *wid, char ids[][128],
                             const int *passed, int count, int max_retries, int resume) {
    int incomplete = 0;
    for (int i = 0; i < count; i++) {
        if (passed[i]) continue;
        char part[48], outp[PD_PW], done[PD_PW];
        if (cx_fmt(part, sizeof part, "%s.z%02d", wid, i + 1) ||
            cx_fmt(outp, sizeof outp, "%s/strict-%s.tsv", out_dir, part) ||
            cx_fmt(done, sizeof done, "%s/done.%s", out_dir, part)) return -1;
        if (resume && sy_exists(done) == 1 && pd_batch_receipt(outp, ids[i], 0)) continue;
        int matched = 0, tries = 0;
        for (int attempt = 1; attempt <= max_retries; attempt++) {
            tries = attempt;
            sy_unlink(outp);
            int rc = pd_window_attempt(root, cand, mock_runner, part, "serial-recovery",
                                       ids[i], outp, 1, attempt);
            matched = pd_batch_receipt(outp, ids[i], rc);
            if (matched == 1) break;
        }
        if (matched == 2 && tx_eqz(pd_states[0].domain, "product-qualification") && tx_eqz(pd_states[0].status, "FAIL")) {
            int expected = pd_expected_red(&pd_states[0]);
            if (expected || pd_scout) {
                const char *label = expected ? "PRERUN_EXPECTED_RED" : "PRERUN_SCOUT_RED";
                printf("%s\tbatch=%s\twindow=%s\traw=%s\n", label, ids[i], part, pd_states[0].raw_line);
                const char *receipt = pd_scout ? "SCOUT_ONLY\n" : "EXPECTED_FAIL\n";
                if (sy_write_atomic(done, receipt, strlen(receipt), 0644)) return -1;
                continue;
            }
            printf("PRERUN_PRODUCT_RED_STOP\tbatch=%s\tdomain=product-qualification\tstatus=FAIL\trc=%d\tretries=%d\twindow=%s\ttriage=inspect-strict-%s.tsv\traw=%s\n",
                   ids[i], pd_states[0].rc, tries, part, part, pd_states[0].raw_line);
            printf("PRERUN_STOP\tbatch=%s\tretries=%d\twindow=%s\traw=%s\n",
                   ids[i], tries, part, pd_states[0].raw_line);
            return 2;
        }
        int allow_keep = (pd_keep_going == 2) || (pd_keep_going >= 1 && matched == 2 && tx_eqz(pd_states[0].status, "UNKNOWN"));
        if (matched && (matched == 1 || allow_keep)) {
            if (sy_write_atomic(done, "SERIAL_DONE\n", 12, 0644)) return -1;
            if (matched == 2) {
                printf("PRERUN_KEEP_GOING\tbatch=%s\tretries=%d\twindow=%s\traw=serial-recovery-%s\n",
                       ids[i], tries, part, pd_states[0].status);
            }
        } else {
            printf("%s\tbatch=%s\twindow=%s\traw=serial-recovery-incomplete\n",
                   pd_keep_going == 2 ? "PRERUN_INCOMPLETE" : "PRERUN_STOP", ids[i], part);
            incomplete++;
            if (pd_keep_going != 2) break;
        }
    }
    return incomplete != 0;
}

static int pd_prebuild_layout(const char *root, const char *cand, char *lay_out, size_t cap) {
    if (!cand || !cand[0] || tx_eqz(cand, "-")) return -1;
    unsigned char *cb = 0; int64_t cn = 0;
    char sha[65], head[64], why[256];
    if (sy_read_file(cand, &cb, &cn, 256L << 20) || !cb || sy_sha256_hex(cb, cn, sha)) {
        if (cb) mm_free(cb);
        return -1;
    }
    mm_free(cb);
    np_result gr = {0};
    char *gv[] = {"git", "-C", (char *)root, "rev-parse", "HEAD", 0};
    if (np_run(gv, 0, 0, 10, &gr, why, sizeof why) || gr.rc || gr.outn < 40) {
        np_free(&gr);
        return -1;
    }
    for (int i = 0; i < 40; i++) {
        char c = gr.out[i];
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) { np_free(&gr); return -1; }
        head[i] = c;
    }
    head[40] = 0;
    np_free(&gr);
    const char *td = sy_env("TMPDIR");
    if (!td || !*td) td = "/tmp";
    char cache[PD_PW], receipt[PD_PW], gitp[PD_PW], comp[PD_PW];
    if (cx_fmt(cache, sizeof cache, "%s/unisacc-qualify-%s-%s", td, sha, head) ||
        cx_fmt(receipt, sizeof receipt, "%s/ready", cache)) return -1;
    unsigned char *rb = 0; int64_t rn = 0;
    if (sy_read_file(receipt, &rb, &rn, 256) == 0 && rb && rn > 41) {
        char *tab = (char *)memchr(rb, '\t', (size_t)rn);
        if (tab && (tab - (char *)rb) > 5 && memcmp(rb, "tree-", 5) == 0) {
            char rec[64];
            size_t rl = (size_t)(tab - (char *)rb);
            if (rl < sizeof rec && !mm_copy(rec, sizeof rec, rb, rl)) {
                rec[rl] = 0;
                sy_stat_t st1, st2;
                if (!cx_fmt(lay_out, cap, "%s/%s", cache, rec) &&
                    !cx_fmt(gitp, sizeof gitp, "%s/.git", lay_out) &&
                    !cx_fmt(comp, sizeof comp, "%s/unisacc.com", lay_out) &&
                    sy_lstat(gitp, &st1) == 0 && sy_lstat(comp, &st2) == 0 && st2.kind == 'f') {
                    mm_free(rb);
                    return 0;
                }
            }
        }
    }
    if (rb) mm_free(rb);
    pd_mkdirs(cache);
    if (sy_mkdtemp(cache, "tree-", lay_out, cap)) return -1;
    const char *base_name = strrchr(lay_out, '/');
    base_name = base_name ? base_name + 1 : lay_out;
    char scmd[8192];
    if (cx_fmt(scmd, sizeof scmd,
        "git -C '%s' archive --format=tar HEAD | tar -x -C '%s' && "
        "cp '%s' '%s/unisacc.com' && chmod 0755 '%s/unisacc.com' && "
        "git -C '%s' init -q && "
        "git -C '%s' add -Af -- . ':(exclude)unisacc.com' && "
        "git -C '%s' -c user.name=devsvc-qualify -c user.email=qualify@localhost -c commit.gpgsign=false commit -q -m 'devsvc qualify layout' && "
        "printf '%%s\\t%%s\\n' '%s' \"$(git -C '%s' rev-parse 'HEAD^{tree}')\" > '%s'",
        root, lay_out, cand, lay_out, lay_out, lay_out, lay_out, lay_out,
        base_name, lay_out, receipt)) return -1;
    char *sv[] = {"sh", "-c", scmd, 0};
    np_result sr = {0};
    int tr = np_run(sv, root, 0, 50, &sr, why, sizeof why);
    int ok = (!tr && sr.rc == 0);
    np_free(&sr);
    return ok ? 0 : -1;
}

static int pd_freeze_source_root(const char *root, const char *out_dir,
                                 char *frozen_root, size_t rcap, char *frozen_rev, size_t vcap) {
    char rroot[PD_PW], rout[PD_PW], revf[PD_PW], froot[PD_PW], ghead[PD_PW], why[256];
    frozen_root[0] = 0;
    frozen_rev[0] = 0;
    pd_mkdirs(out_dir);
    if (!root || !root[0] || sy_realpath(root, rroot, sizeof rroot) < 0)
        cx_fmt(rroot, sizeof rroot, "%s", (root && root[0]) ? root : ".");
    if (!out_dir || !out_dir[0] || sy_realpath(out_dir, rout, sizeof rout) < 0)
        cx_fmt(rout, sizeof rout, "%s", (out_dir && out_dir[0]) ? out_dir : ".");
    if (cx_fmt(revf, sizeof revf, "%s/frozen-source.rev", rout) ||
        cx_fmt(froot, sizeof froot, "%s/frozen-root", rout) ||
        cx_fmt(ghead, sizeof ghead, "%s/.git/HEAD", froot)) return -1;
    unsigned char *rb = 0; int64_t rn = 0;
    if (sy_read_file(revf, &rb, &rn, 128) == 0 && rb && rn >= 40) {
        int valid = 1;
        for (int i = 0; i < 40; i++) {
            char c = (char)rb[i];
            if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) { valid = 0; break; }
            if (i + 1 < (int)vcap) frozen_rev[i] = c;
        }
        mm_free(rb);
        if (valid) frozen_rev[40] = 0;
        else frozen_rev[0] = 0;
    } else if (rb) {
        mm_free(rb);
    }
    if (!frozen_rev[0]) {
        np_result gr = {0};
        char *gv[] = {"git", "-C", rroot, "rev-parse", "HEAD", 0};
        if (np_run(gv, 0, 0, 10, &gr, why, sizeof why) || gr.rc || gr.outn < 40) {
            np_free(&gr);
            return -1;
        }
        for (int i = 0; i < 40; i++) {
            char c = gr.out[i];
            if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) { np_free(&gr); return -1; }
            if (i + 1 < (int)vcap) frozen_rev[i] = c;
        }
        frozen_rev[40] = 0;
        np_free(&gr);
        char rline[64];
        cx_fmt(rline, sizeof rline, "%s\n", frozen_rev);
        sy_write_file(revf, rline, (int64_t)strlen(rline), 0644);
    }
    sy_stat_t st;
    if (sy_lstat(ghead, &st) != 0) {
        char scmd[8192];
        /* release/evidence/*-deferred.tsv is historical failure evidence (67 tracked files, 139 DEFERRED rows).
         * A frozen-root is built once per prerun dir and then cloned by every fixture that copies a work dir,
         * so carrying it multiplies history into every count of "deferred now" (measured: 2919 of 2923
         * DEFERRED rows in one prerun dir came from this family, 1407 copies of 67 files).  The release-flow
         * decisions that read these proofs read REPO/release/evidence/..., not the frozen root, and
         * prerun-inputs already names a missing one as unreadable-in-PV, so pruning them here removes the
         * multiplication without hiding anything.  Counting rule: tools/deferred-census.cx. */
        if (cx_fmt(scmd, sizeof scmd,
            "g=$(git -C '%s' rev-parse --path-format=absolute --git-common-dir) && "
            "rm -rf '%s' && mkdir -p '%s/.git/refs/heads' '%s/.git/refs/tags' && "
            "git -C '%s' archive --format=tar '%s' -- . ':(exclude,glob)**/release/evidence/**/*-deferred.tsv' | tar -x -C '%s' && "
            "ln -s \"$g/objects\" '%s/.git/objects' && "
            "printf '[core]\\n\\trepositoryformatversion = 0\\n\\tfilemode = true\\n\\tbare = false\\n' > '%s/.git/config' && "
            "printf '%%s\\n' '%s' > '%s/.git/HEAD' && "
            "{ [ ! -e '%s/unisacc.com' ] || { [ -e '%s/unisacc.com' ] && [ ! -L '%s/unisacc.com' ]; } || ln -sfn '%s/unisacc.com' '%s/unisacc.com'; }",
            rroot, froot, froot, froot, rroot, frozen_rev, froot, froot, froot, frozen_rev, froot,
            rroot, froot, froot, rroot, froot)) return -1;
        char *sv[] = {"sh", "-c", scmd, 0};
        np_result sr = {0};
        int tr = np_run(sv, 0, 0, 45, &sr, why, sizeof why);
        int ok = (!tr && sr.rc == 0);
        np_free(&sr);
        if (!ok) return -1;
    }
    cx_fmt(frozen_root, rcap, "%s", froot);
    return 0;
}

/* Verify or stamp `# source=<rev>` in OUTP against FROZEN_REV ( rooted at EFF_ROOT ).
 * Returns 0 on match, 1 on source drift (prints PRERUN_SOURCE_DRIFT + PRERUN_STOP). */
static int pd_verify_window_source(const char *outp, const char *wid, int attempt,
                                   const char *eff_root, const char *frozen_rev) {
    if (!frozen_rev || !frozen_rev[0]) return 0;
    unsigned char *b = 0; int64_t n = 0;
    if (sy_read_file(outp, &b, &n, 4 << 20) != 0 || !b || n <= 0) {
        if (b) mm_free(b);
        return 0;
    }
    long pos = tx_find((const char *)b, (long)n, "source=", 7);
    if (pos >= 0 && pos + 7 + 40 <= (long)n) {
        char actual[48];
        mm_copy(actual, sizeof actual, (const char *)b + pos + 7, 40);
        actual[40] = 0;
        mm_free(b);
        if (!tx_eqz(actual, frozen_rev)) {
            printf("PRERUN_SOURCE_DRIFT\tstatus=FAIL\twindow=%s\texpected=%s\tactual=%s\n",
                   wid, frozen_rev, actual);
            printf("PRERUN_STOP\tbatch=%s\tretries=%d\twindow=%s\traw=source-drift-expected-%s-got-%s\n",
                   wid, attempt, wid, frozen_rev, actual);
            return 1;
        }
        return 0;
    }
    /* No `# source=` line yet (e.g. mock runner in a git root): resolve eff_root HEAD, stamp `# source=`, and verify. */
    char why[256], actual[48] = {0};
    np_result gr = {0};
    char *gv[] = {"git", "-C", (char *)eff_root, "rev-parse", "HEAD", 0};
    if (np_run(gv, 0, 0, 10, &gr, why, sizeof why) == 0 && gr.rc == 0 && gr.outn >= 40) {
        mm_copy(actual, sizeof actual, gr.out, 40);
        actual[40] = 0;
    }
    np_free(&gr);
    if (actual[0]) {
        char hdr[128];
        cx_fmt(hdr, sizeof hdr, "# source=%s\n", actual);
        size_t hl = strlen(hdr);
        char *nb = (char *)mm_alloc((size_t)n + hl + 1);
        if (nb) {
            mm_copy(nb, (size_t)n + hl + 1, hdr, hl);
            mm_copy(nb + hl, (size_t)n + 1, b, (size_t)n);
            sy_write_file(outp, nb, (int64_t)((size_t)n + hl), 0644);
            mm_free(nb);
        }
        mm_free(b);
        if (!tx_eqz(actual, frozen_rev)) {
            printf("PRERUN_SOURCE_DRIFT\tstatus=FAIL\twindow=%s\texpected=%s\tactual=%s\n",
                   wid, frozen_rev, actual);
            printf("PRERUN_STOP\tbatch=%s\tretries=%d\twindow=%s\traw=source-drift-expected-%s-got-%s\n",
                   wid, attempt, wid, frozen_rev, actual);
            return 1;
        }
        return 0;
    }
    mm_free(b);
    return 0;
}

typedef struct {
    char wid[32], phase[24], ids[4096], done[PD_PW], strict[PD_PW];
    int jobs;
} PdWindow;

static int pd_next_window(const unsigned char *wb, int64_t wn, int64_t *offset,
                          const char *out_dir, PdWindow *w) {
    while (*offset < wn) {
        int64_t ls = *offset, le = ls;
        while (le < wn && wb[le] != '\n') le++;
        *offset = le < wn ? le + 1 : le;
        if (le > ls && wb[le - 1] == '\r') le--;
        if (le == ls || wb[ls] == '#' || (le - ls >= 7 && memcmp(wb + ls, "window\t", 7) == 0)) continue;
        const unsigned char *pos = wb + ls, *end = wb + le;
        char jobs[3], count[16];
        char *fields[] = {w->wid, jobs, w->phase, count, w->ids};
        size_t caps[] = {sizeof w->wid, sizeof jobs, sizeof w->phase, sizeof count, sizeof w->ids};
        for (int i = 0; i < 5; i++) {
            const unsigned char *at = pos;
            while (at < end && *at != '\t') at++;
            size_t n = (size_t)(at - pos);
            if (n == 0 || n >= caps[i] || (i < 4 && at == end) || (i == 4 && at != end)) return -1;
            if (mm_copy(fields[i], caps[i], pos, n)) return -1;
            fields[i][n] = 0;
            pos = at == end ? end : at + 1;
        }
        w->jobs = pd_width(jobs, 16);
        if (!w->jobs) return -2;
        if (strpbrk(w->wid, "/\\") ||
            cx_fmt(w->done, sizeof w->done, "%s/done.%s", out_dir, w->wid) ||
            cx_fmt(w->strict, sizeof w->strict, "%s/strict-%s.tsv", out_dir, w->wid)) return -1;
        return 1;
    }
    return 0;
}

typedef struct {
    PdWindow window;
    const char *root, *cand, *mock;
    char env[PD_PW + 8];
    int pid, fds[2], rc;
    long wall_ms;
} PdLane;

typedef struct { int rc; long wall_ms; } PdLaneResult;

static int pd_lane_child(void *opaque) {
    PdLane *lane = (PdLane *)opaque;
    PdWindow *w = &lane->window;
    PdLaneResult result = {0};
    long start = sy_now_ms();
    result.rc = pd_call_window(lane->root, lane->cand, lane->mock,
                               w->wid, w->ids, w->strict, 1, 1, lane->env);
    result.wall_ms = sy_now_ms() - start;
    return write(1, &result, sizeof result) != sizeof result;
}

static volatile sig_atomic_t pd_lane_interrupted;

static void pd_lane_interrupt(int signal_number) { pd_lane_interrupted = signal_number; }

static int pd_first_attempts(PdLane *group, int count, const char *dir,
                             const char *root, const char *cand, const char *mock) {
    for (int i = 0; i < count; i++) {
        PdLane *lane = &group[i];
        char tmp[PD_PW];
        sy_stat_t st;
        if (cx_fmt(tmp, sizeof tmp, "%s/.lane-tmp-%d", dir, i + 1) ||
            (sy_mkdir(tmp, 0700) && (sy_lstat(tmp, &st) || st.kind != 'd' ||
                                    st.mode != 0700 || st.uid != sy_uid())) ||
            cx_fmt(lane->env, sizeof lane->env, "TMPDIR=%s", tmp)) return -1;
        lane->root = root;
        lane->cand = cand;
        lane->mock = mock;
        lane->pid = 0;
    }
    fflush(stdout);
    pd_lane_interrupted = 0;
    void (*term)(int) = signal(SIGTERM, pd_lane_interrupt);
    void (*intr)(int) = signal(SIGINT, pd_lane_interrupt);
    long deadline = sy_now_ms() + PD_CHILD_SECONDS * 1000 + 500;
    int active = 0, bad = 0;
    for (int i = 0; i < count && !pd_lane_interrupted; i++) {
        PdLane *lane = &group[i];
        int rm = sy_unlink(lane->window.strict);
        if (rm && rm != -ENOENT) { bad = 1; break; }
        lane->pid = sy_fork_session(pd_lane_child, lane, lane->fds);
        if (lane->pid <= 0) { bad = 1; break; }
        active++;
    }
    while (active && !bad && !pd_lane_interrupted && sy_now_ms() < deadline) {
        for (int i = 0; i < count; i++) {
            PdLane *lane = &group[i];
            if (lane->pid <= 0) continue;
            int status = 0;
            int got = waitpid(lane->pid, &status, WNOHANG);
            if (!got || (got < 0 && errno == EINTR)) continue;
            lane->pid = 0;
            active--;
            PdLaneResult result;
            int n = WIFEXITED(status) && WEXITSTATUS(status) == 0 && got > 0 ?
                    read(lane->fds[0], &result, sizeof result) : -1;
            sy_close(lane->fds[0]);
            sy_close(lane->fds[1]);
            if (n != sizeof result) { bad = 1; break; }
            lane->rc = result.rc;
            lane->wall_ms = result.wall_ms;
        }
        if (active && !bad) sy_sleep_ms(10);
    }
    if (active || pd_lane_interrupted) bad = 1;
    for (int i = 0; i < count; i++) {
        PdLane *lane = &group[i];
        if (lane->pid <= 0) continue;
        char report[256];
        rp_kill_tree(lane->pid, 100, 0, 0, report, sizeof report);
        int status;
        waitpid(lane->pid, &status, WNOHANG);
        sy_close(lane->fds[0]);
        sy_close(lane->fds[1]);
    }
    signal(SIGTERM, term);
    signal(SIGINT, intr);
    return bad ? -1 : 0;
}

static void pd_clean_stale_opt_frame4_in(const char *base_dir) {
    sy_dir_t d;
    char stale[32][PD_PW];
    int nstale = 0, next;
    if (!base_dir || !base_dir[0] || sy_dir_open(&d, base_dir)) return;
    while ((next = sy_dir_next(&d)) == 1 && nstale < 32) {
        size_t nl = strlen(d.name);
        if (!pd_starts(d.name, "opt-frame4-material-") || nl < 25 || strcmp(d.name + nl - 4, ".dir") != 0)
            continue;
        char dirp[PD_PW], recp[PD_PW];
        sy_stat_t dst, mst;
        if (cx_fmt(dirp, sizeof dirp, "%s/%s", base_dir, d.name) ||
            cx_fmt(recp, sizeof recp, "%s/materials.tsv", dirp)) continue;
        if (sy_lstat(dirp, &dst) != 0 || dst.kind != 'd') continue;
        if (sy_lstat(recp, &mst) == 0 && mst.kind == 'f') continue;
        cx_fmt(stale[nstale], sizeof stale[nstale], "%s", dirp);
        printf("PRERUN_STALE_OPT_FRAME4\taction=LIST\tpath=%s\treason=missing-materials-tsv\n", dirp);
        nstale++;
    }
    sy_dir_close(&d);
    if (nstale > 0) fflush(stdout);
    for (int i = 0; i < nstale; i++) {
        char why[256];
        char *rmv[] = {"rm", "-rf", stale[i], 0};
        np_result r = {0};
        int tr = np_run(rmv, 0, 0, 10, &r, why, sizeof why);
        int ok = (!tr && r.rc == 0 && sy_exists(stale[i]) == 0);
        np_free(&r);
        printf("PRERUN_STALE_OPT_FRAME4\taction=%s\tpath=%s\n", ok ? "REMOVED" : "FAILED", stale[i]);
    }
    if (nstale > 0) fflush(stdout);
}

static void pd_prepare_opt_frame4(const char *eff_root, const char *cand, const char *out_dir,
                                  const char *mock_runner, int resume, const unsigned char *wb, int64_t wn) {
    char pcache[PD_PW], donep[PD_PW], outp[PD_PW], cmd[8192], why[256], lay_dir[PD_PW];
    pd_clean_stale_opt_frame4_in(out_dir);
    if (!cx_fmt(pcache, sizeof pcache, "%s/prep-cache", out_dir))
        pd_clean_stale_opt_frame4_in(pcache);
    if (!wb || wn <= 0 || tx_find((const char *)wb, (long)wn, "opt-frame4-", 11) < 0) return;
    if (cx_fmt(donep, sizeof donep, "%s/done.prepare-opt-frame4", out_dir) ||
        cx_fmt(outp, sizeof outp, "%s/prepare-opt-frame4.tsv", out_dir)) return;
    if (resume && sy_exists(donep) == 1) return;
    const char *run_cwd = eff_root;
    long started = sy_now_ms();
    if (mock_runner) {
        if (cx_fmt(cmd, sizeof cmd, "sh '%s' prepare-opt-frame4 'opt-frame4-material' '%s'", mock_runner, outp)) return;
    } else if (pd_prebuild_layout(eff_root, cand, lay_dir, sizeof lay_dir) == 0) {
        run_cwd = lay_dir;
        if (cx_fmt(cmd, sizeof cmd, "cd '%s' && sh ./unisacc.com tools/affected.cx -- --materials-dump --prepare-materials --ids opt-frame4-o2-negative-label", lay_dir)) return;
    } else {
        const char *use_cand = (cand && cand[0] && !tx_eqz(cand, "-")) ? cand : "./unisacc.com";
        if (cx_fmt(cmd, sizeof cmd, "cd '%s' && sh '%s' tools/affected.cx -- --materials-dump --prepare-materials --ids opt-frame4-o2-negative-label", eff_root, use_cand)) return;
    }
    char *av[] = {"sh", "-c", cmd, 0};
    np_result r = {0};
    int s1mp = 0; { const char *e = sy_env("UNISACC_S1_MAX_PROCS"); int v = (e && e[0]) ? atoi(e) : 0; if (v >= 1 && v <= 256) s1mp = v; }
    int tr = np_run_capped(av, run_cwd, 0, PD_CHILD_SECONDS, s1mp, &r, why, sizeof why);
    int rc = tr ? 124 : r.rc;
    if (rc == 0 && !mock_runner && r.out && r.outn > 0 && tx_find(r.out, (long)r.outn, "REFUSED=", 8) >= 0)
        rc = 1;
    np_free(&r);
    printf("PRERUN_PREPARE_MATERIAL\tmaterial=opt-frame4-material\trc=%d\twall_ms=%ld\n", rc, sy_now_ms() - started);
    fflush(stdout);
    if (rc == 0)
        (void)sy_write_file(donep, "OPT_FRAME4_MATERIAL\tREADY\n", 26, 0644);
}
static int pd_parse_entry_link_row(const char *out, long outn,
                                   char *path_out, size_t path_cap,
                                   char *refuse_out, size_t refuse_cap) {
    /* Exact record contract from tools/affected.cx:2235-2237 (U10-8):
     *   MATERIAL<TAB>piece-d-driveargs-link<TAB>entry-link<TAB><artifact_path>
     *   MATERIAL<TAB>piece-d-driveargs-link<TAB>entry-link<TAB>-<TAB>REFUSED=<reason>
     * Scans ALL lines and requires EXACTLY ONE matching row (duplicates or later REFUSED -> -1).
     * Any bare '-' column without REFUSED= -> -1 (never falls into READY).
     * Returns: 0=READY (path_out filled), 3=retryable deadline deferral, -1=missing/dup/malformed, -2=hard refusal. */
    static const char pfx[] = "MATERIAL\tpiece-d-driveargs-link\tentry-link\t";
    const long pfxn = (long)(sizeof pfx - 1);
    long at = 0;
    int matches = 0, result = -1;
    path_out[0] = 0;
    refuse_out[0] = 0;
    if (!out || outn <= 0) return -1;
    while (at < outn) {
        long nl = at;
        while (nl < outn && out[nl] != '\n') nl++;
        long ln = nl - at;
        if (ln > 0 && out[at + ln - 1] == '\r') ln--;
        if (ln > pfxn && tx_same(out + at, pfxn, pfx, pfxn)) {
            const char *rest = out + at + pfxn;
            long rlen = ln - pfxn;
            long tab = 0;
            matches++;
            if (matches > 1) {
                path_out[0] = 0;
                (void)cx_fmt(refuse_out, refuse_cap, "duplicate-material-row");
                return -1;
            }
            while (tab < rlen && rest[tab] != '\t') tab++;
            if (tab == 1 && rest[0] == '-') {
                const char *r5 = (tab + 1 < rlen) ? (rest + tab + 1) : 0;
                long r5n = r5 ? (rlen - tab - 1) : 0;
                if (r5 && r5n > 8 && tx_same(r5, 8, "REFUSED=", 8)) {
                    long why_n = r5n - 8;
                    if (why_n >= (long)refuse_cap) why_n = (long)refuse_cap - 1;
                    mm_copy(refuse_out, refuse_cap, r5 + 8, (size_t)why_n);
                    refuse_out[why_n] = 0;
                    if ((why_n >= 20 && tx_same(refuse_out, 20, "stepwise-more-steps=", 20)) ||
                        (why_n >= 18 && tx_same(refuse_out, 18, "prebuild-deadline=", 18))) {
                        result = 3;
                    } else {
                        result = -2;
                    }
                } else {
                    (void)cx_fmt(refuse_out, refuse_cap, "bare-dash-column");
                    return -1;
                }
            } else if (tab > 0 && tab == rlen && tab < (long)path_cap && !(tab == 1 && rest[0] == '-')) {
                mm_copy(path_out, path_cap, rest, (size_t)tab);
                path_out[tab] = 0;
                result = 0;
            } else {
                (void)cx_fmt(refuse_out, refuse_cap, "malformed-material-row");
                return -1;
            }
        }
        at = nl + 1;
    }
    return matches == 1 ? result : -1;
}

static int pd_file_sha256_hex(const char *path, char out65[65]) {
    unsigned char *b = 0;
    int64_t n = 0;
    if (!path || !path[0] || tx_eqz(path, "-")) return -1;
    if (sy_read_file(path, &b, &n, 64 << 20) != 0 || !b) {
        if (b) mm_free(b);
        return -1;
    }
    cx_sha256_hex(b, (size_t)n, out65);
    mm_free(b);
    return 0;
}

static int pd_material_content_sha(const char *art_path, char out65[65]) {
    sy_stat_t st;
    char mf[PD_PW];
    if (!art_path || !art_path[0] || tx_eqz(art_path, "-")) return -1;
    if (sy_stat(art_path, &st) != 0) return -1;
    if (st.kind == 'f') return pd_file_sha256_hex(art_path, out65);
    if (st.kind == 'd') {
        if (!cx_fmt(mf, sizeof mf, "%s/materials.tsv", art_path) && sy_exists(mf) == 1) {
            return pd_file_sha256_hex(mf, out65);
        }
        return -1;
    }
    return -1;
}

static void pd_source_tree_id(const char *eff_root, const char *out_dir, char out65[65]) {
    char why[128], revf[PD_PW];
    /* 1. Frozen prerun archive carries out_dir/frozen-source.rev (plain tree without .git) */
    if (out_dir && out_dir[0] && !cx_fmt(revf, sizeof revf, "%s/frozen-source.rev", out_dir)) {
        unsigned char *rb = 0;
        int64_t rn = 0;
        if (sy_read_file(revf, &rb, &rn, 256) == 0 && rb && rn >= 7) {
            long n = 0;
            while (n < (long)rn && n < 64 && rb[n] != '\n' && rb[n] != '\r') n++;
            if (n >= 7) {
                mm_copy(out65, 65, (const char *)rb, (size_t)n);
                out65[n] = 0;
                mm_free(rb);
                return;
            }
        }
        if (rb) mm_free(rb);
    }
    /* 2. Git checkout root */
    {
        char *av[] = {"git", "-C", (char *)(eff_root ? eff_root : "."), "rev-parse", "--verify", "HEAD^{tree}", 0};
        np_result r = {0};
        int tr = np_run(av, 0, 0, 10, &r, why, sizeof why);
        if (!tr && r.rc == 0 && r.out && r.outn >= 40) {
            long n = 0;
            while (n < (long)r.outn && n < 64 && r.out[n] != '\n' && r.out[n] != '\r') n++;
            mm_copy(out65, 65, r.out, (size_t)n);
            out65[n] = 0;
            np_free(&r);
            return;
        }
        np_free(&r);
    }
    /* 3. Plain tree without .git or frozen-source.rev: hash actual key source file contents */
    {
        static const char *kfiles[5] = {
            "tools/affected.cx",
            "src/driveargs_m1.cx",
            "cx/driver/driveargs_m1_impl.cx",
            "cx/driver/stream_s1_m1.cx",
            "build/chain-facts.tsv"
        };
        char acc[1024], fp[PD_PW], fsha[65];
        long at = 0;
        int i, any = 0;
        acc[0] = 0;
        for (i = 0; i < 5; i++) {
            if (eff_root && !cx_fmt(fp, sizeof fp, "%s/%s", eff_root, kfiles[i]) &&
                pd_file_sha256_hex(fp, fsha) == 0) {
                char row[96];
                if (!cx_fmt(row, sizeof row, "%d:%s\n", i, fsha)) {
                    long rn = tx_len(row, (long)sizeof row);
                    if (at + rn < (long)sizeof acc) {
                        mm_copy(acc + at, (size_t)((long)sizeof acc - at), row, (size_t)rn);
                        at += rn;
                        acc[at] = 0;
                        any = 1;
                    }
                }
            }
        }
        if (any) {
            cx_sha256_hex(acc, (size_t)at, out65);
            return;
        }
    }
    cx_sha256_hex(eff_root ? eff_root : "", (size_t)tx_len(eff_root ? eff_root : "", 4096), out65);
}

static int pd_entry_link_identity(const char *eff_root, const char *out_dir, const char *cand, const char *art_path, char out65[65]) {
    char cand_sha[65], tree_id[65], mat_sha[65], buf[512];
    if (pd_material_content_sha(art_path, mat_sha) != 0) return -1;
    if (cand && cand[0] && !tx_eqz(cand, "-") && sy_exists(cand) == 1) {
        if (pd_file_sha256_hex(cand, cand_sha) != 0) return -1;
    } else {
        (void)cx_fmt(cand_sha, sizeof cand_sha, "none");
    }
    pd_source_tree_id(eff_root, out_dir, tree_id);
    if (cx_fmt(buf, sizeof buf, "ENTRY_LINK_V2\ncand=%s\ntree=%s\nmat=%s\n", cand_sha, tree_id, mat_sha)) return -1;
    cx_sha256_hex(buf, (size_t)tx_len(buf, (long)sizeof buf), out65);
    return 0;
}

static int pd_verify_entry_link_done(const char *donep, const char *eff_root, const char *out_dir, const char *cand) {
    unsigned char *b = 0;
    int64_t n = 0;
    char rec_id[128], rec_path[PD_PW], cur_id[65];
    static const char pfx[] = "ENTRY_LINK_MATERIAL\tREADY\tid=";
    const long pfxn = (long)(sizeof pfx - 1);
    long at, nl, ptab;
    if (!donep) return 0;
    if (sy_read_file(donep, &b, &n, 8192) != 0 || !b || n <= pfxn) {
        if (b) mm_free(b);
        return 0;
    }
    nl = 0;
    while (nl < (long)n && b[nl] != '\n' && b[nl] != '\r') nl++;
    if (nl <= pfxn || !tx_same((const char *)b, pfxn, pfx, pfxn)) { mm_free(b); return 0; }
    at = pfxn;
    ptab = at;
    while (ptab < nl && b[ptab] != '\t') ptab++;
    if (ptab - at <= 0 || ptab - at >= (long)sizeof rec_id) { mm_free(b); return 0; }
    mm_copy(rec_id, sizeof rec_id, (const char *)b + at, (size_t)(ptab - at));
    rec_id[ptab - at] = 0;
    if (ptab + 6 >= nl || !tx_same((const char *)b + ptab, 6, "\tpath=", 6)) { mm_free(b); return 0; }
    {
        long plen = nl - (ptab + 6);
        if (plen <= 0 || plen >= (long)sizeof rec_path) { mm_free(b); return 0; }
        mm_copy(rec_path, sizeof rec_path, (const char *)b + ptab + 6, (size_t)plen);
        rec_path[plen] = 0;
    }
    mm_free(b);
    if (pd_entry_link_identity(eff_root, out_dir, cand, rec_path, cur_id) != 0) return 0;
    return tx_eqz(rec_id, cur_id) ? 1 : 0;
}

static int pd_prepare_entry_link(const char *eff_root, const char *cand, const char *out_dir,
                                 const char *mock_runner, int resume, const unsigned char *wb, int64_t wn) {
    char donep[PD_PW], outp[PD_PW], cmd[8192], why[256], lay_dir[PD_PW];
    char full_id[65], art_path[PD_PW], ref_why[256], done_line[PD_PW + 160];
    const int max_passes = 6;
    const int pass_timeout_s = 55;
    if (!wb || wn <= 0 || tx_find((const char *)wb, (long)wn, "piece-d-driveargs-link", 22) < 0) return 0;
    if (cx_fmt(donep, sizeof donep, "%s/done.prepare-entry-link", out_dir) ||
        cx_fmt(outp, sizeof outp, "%s/prepare-entry-link.tsv", out_dir)) return -1;
    if (resume && sy_exists(donep) == 1) {
        if (pd_verify_entry_link_done(donep, eff_root, out_dir, cand)) return 0;
        printf("PRERUN_PREPARE_MATERIAL\tmaterial=entry-link\tresume=invalidated\n");
        fflush(stdout);
    }
    for (int pass = 1; pass <= max_passes; pass++) {
        const char *run_cwd = eff_root;
        long started = sy_now_ms();
        if (mock_runner) {
            if (cx_fmt(cmd, sizeof cmd, "sh '%s' prepare-entry-link 'entry-link' '%s' '%d'", mock_runner, outp, pass)) return -1;
        } else if (pd_prebuild_layout(eff_root, cand, lay_dir, sizeof lay_dir) == 0) {
            run_cwd = lay_dir;
            if (cx_fmt(cmd, sizeof cmd, "cd '%s' && sh ./unisacc.com tools/affected.cx -- --materials-dump --prepare-materials --ids piece-d-driveargs-link", lay_dir)) return -1;
        } else {
            const char *use_cand = (cand && cand[0] && !tx_eqz(cand, "-")) ? cand : "./unisacc.com";
            if (cx_fmt(cmd, sizeof cmd, "cd '%s' && sh '%s' tools/affected.cx -- --materials-dump --prepare-materials --ids piece-d-driveargs-link", eff_root, use_cand)) return -1;
        }
        char *av[] = {"sh", "-c", cmd, 0};
        np_result r = {0};
        int s1mp = 0; { const char *e = sy_env("UNISACC_S1_MAX_PROCS"); int v = (e && e[0]) ? atoi(e) : 0; if (v >= 1 && v <= 256) s1mp = v; }
        int tr = np_run_capped(av, run_cwd, 0, pass_timeout_s, s1mp, &r, why, sizeof why);
        int rc = tr ? 124 : r.rc;
        int parsed = -1;
        art_path[0] = 0;
        ref_why[0] = 0;
        if (rc == 0) {
            parsed = pd_parse_entry_link_row(r.out, (long)r.outn, art_path, sizeof art_path, ref_why, sizeof ref_why);
        }
        np_free(&r);
        printf("PRERUN_PREPARE_MATERIAL\tmaterial=entry-link\tpass=%d\trc=%d\tstate=%s\tdetail=%s\twall_ms=%ld\n",
               pass, rc,
               parsed == 0 ? "READY" : (parsed == 3 ? "DEFERRED" : "REFUSED"),
               parsed == 0 ? art_path : (ref_why[0] ? ref_why : "missing-material-row"),
               sy_now_ms() - started);
        fflush(stdout);
        if (rc == 0 && parsed == 0) {
            if (pd_entry_link_identity(eff_root, out_dir, cand, art_path, full_id) != 0) return -1;
            if (cx_fmt(done_line, sizeof done_line, "ENTRY_LINK_MATERIAL\tREADY\tid=%s\tpath=%s\n", full_id, art_path)) return -1;
            if (sy_write_file(donep, done_line, tx_len(done_line, (long)sizeof done_line), 0644) != 0) return -1;
            return 0;
        }
        if (rc == 0 && parsed == 3) continue; /* named deadline deferral: stepwise-more-steps / prebuild-deadline */
        break; /* non-zero rc, empty output, duplicate/bare-dash row, or hard refusal: do not retry */
    }
    return -1;
}
static int pd_text_has_enospc(const char *s, long n) {
    if (!s || n <= 0) return 0;
    if (tx_find(s, n, "No space left", 13) >= 0) return 1;
    if (tx_find(s, n, "设备上没有空间", 21) >= 0) return 1;
    if (tx_find(s, n, "ENOSPC", 6) >= 0) return 1;
    return 0;
}
static int pd_parse_min_free(const char *s, unsigned long long *out) {
    unsigned long long v = 0;
    if (!s[0]) return -1;
    for (const char *p = s; *p; p++) {
        if (*p < '0' || *p > '9') return -1;
        unsigned long long d = (unsigned long long)(*p - '0');
        if (v > ((~0ULL) - d) / 10ULL) return -1;
        v = v * 10ULL + d;
    }
    if (v == 0) return -1;
    *out = v;
    return 0;
}
static long pd_mock_avail_mb = -2;
static int pd_check_min_free(const char *out_dir, const char *wid, unsigned long long min_free_bytes) {
    if (!min_free_bytes) return 0;
    long avail_mb = (pd_mock_avail_mb >= -1) ? pd_mock_avail_mb : sy_disk_avail_mb(out_dir);
    int low = 0;
    if (avail_mb < 0)
        printf("PRERUN_DISK_FREE\tstatus=UNMEASURED\trc=%ld\twindow=%s\n", avail_mb, wid);
    else if ((unsigned long long)avail_mb * 1048576ULL < min_free_bytes) {
        printf("PRERUN_INFRA\treason=ENOSPC\twindow=%s\n", wid);
        low = 1;
    }
    return low;
}
static void pd_infra_enospc(const char *outp, int *hit_out) {
    char ep[PD_PW];
    const char *ps[2] = {0, outp};
    *hit_out = 0;
    if (!cx_fmt(ep, sizeof ep, "%s.stderr", outp)) ps[0] = ep;
    for (int i = 0; i < 2 && !*hit_out; i++) {
        unsigned char *b = 0; int64_t n = 0;
        if (ps[i] && sy_read_file(ps[i], &b, &n, 1 << 20) == 0) {
            if (pd_text_has_enospc((const char *)b, n)) *hit_out = 1;
            mm_free(b);
        }
    }
}
/* Extract first line containing REFUSE from result file or sidecar .stderr, truncated to cap-1 bytes (255 bytes for cur[256]). */
static void pd_extract_refuse(const char *outp, char *dst, size_t cap) {
    char ep[PD_PW];
    const char *ps[2] = {0, outp};
    if (!dst || cap < 2) return;
    dst[0] = 0;
    if (!cx_fmt(ep, sizeof ep, "%s.stderr", outp)) ps[0] = ep;
    for (int i = 0; i < 2 && !dst[0]; i++) {
        unsigned char *b = 0; int64_t n = 0;
        if (ps[i] && sy_read_file(ps[i], &b, &n, 1 << 20) == 0) {
            const char *s = (const char *)b;
            long at = tx_find(s, (long)n, "REFUSE", 6);
            if (at >= 0) {
                long ls = at, le = at + 6;
                while (ls > 0 && s[ls - 1] != '\n') ls--;
                while (le < (long)n && s[le] != '\n' && s[le] != '\r') le++;
                size_t len = (size_t)(le - ls);
                if (len >= cap) len = cap - 1;
                mm_copy(dst, cap, s + ls, len);
                dst[len] = 0;
            }
            mm_free(b);
        }
    }
}
static void pd_track_repeat_rc2(int win_rc, const char *outp, const char *wid,
                                char *prev_ref, size_t prev_cap, int *same_cnt, int *stop_out) {
    char cur[256];
    cur[0] = 'X';
    cur[1] = 0;
    *stop_out = 0;
    if (win_rc == 2) pd_extract_refuse(outp, cur, sizeof cur);
    else cur[0] = 0;
    if (cur[0]) {
        if (tx_eqz(prev_ref, cur)) {
            (*same_cnt)++;
        } else {
            cx_fmt(prev_ref, prev_cap, "%s", cur);
            *same_cnt = 1;
        }
        if (*same_cnt >= 3) {
            printf("PRERUN_INFRA\treason=REPEAT_RC2\twindow=%s\n", wid);
            *stop_out = 1;
        }
    } else {
        prev_ref[0] = 0;
        *same_cnt = 0;
    }
}


static int pd_cmd_run(const char *root, const char *cand, const char *out_dir, int resume, int max_jobs, int load_cap, int max_retries, int lanes, const char *mock_runner, unsigned long long min_free_bytes) {
    char wpath[PD_PW], real_root[PD_PW];
    unsigned char *wb = 0; int64_t wn = 0;
    pd_run_wall_ms = 0;
    pd_run_batch_ms = 0;
    pd_run_measured_wins = 0;
    if (!root || !root[0]) root = ".";
    if (sy_realpath(root, real_root, sizeof real_root) > 0 && real_root[0]) root = real_root;
    if (cx_fmt(wpath, sizeof wpath, "%s/windows.tsv", out_dir) || sy_read_file(wpath, &wb, &wn, 4 << 20))
        return pd_refuse("read-windows-tsv");
    int timed = tx_prefix((char *)wb, wn, PD_TIMED_HEADER, sizeof PD_TIMED_HEADER - 1);
    if (!lanes) {
        const char *key = "\n# window-lanes=";
        long at = tx_find((const char *)wb, wn, key, strlen(key));
        lanes = 1;
        if (at >= 0) {
            const char *start = (const char *)wb + at + strlen(key);
            if (start + 1 >= (const char *)wb + wn ||
                start[0] < '1' || start[0] > '8' || start[1] != '\n') {
                mm_free(wb); return pd_refuse("invalid-window-lanes");
            }
            lanes = start[0] - '0';
        }
    }
    if (timed && atoi((char *)wb + sizeof PD_TIMED_HEADER - 1) > max_jobs) {
        mm_free(wb);
        return pd_refuse("timed-plan-exceeds-max-jobs");
    }
    char frozen_root[PD_PW], frozen_rev[64], canonical_dir[PD_PW];
    if (sy_realpath(out_dir, canonical_dir, sizeof canonical_dir) <= 0) {
        mm_free(wb); return pd_refuse("run-output-directory");
    }
    out_dir = canonical_dir;
    int marker = pd_scout_state(out_dir);
    if (marker < 0 || (marker && !pd_scout)) { mm_free(wb); return pd_refuse("scout-directory"); }
    if (pd_scout && !marker) {
        sy_dir_t d;
        if (sy_dir_open(&d, out_dir)) { mm_free(wb); return pd_refuse("scout-dir-read"); }
        int next;
        while ((next = sy_dir_next(&d)) == 1) {
            if (!strncmp(d.name, "strict-", 7) || !strncmp(d.name, "done.", 5) || !strcmp(d.name, "run.done")) break;
        }
        sy_dir_close(&d);
        if (next != 0) { mm_free(wb); return pd_refuse("scout-requires-unused-directory"); }
        char p[PD_PW];
        if (cx_fmt(p, sizeof p, "%s/SCOUT_ONLY", out_dir) || sy_write_atomic(p, "SCOUT_ONLY\n", 11, 0644)) {
            mm_free(wb); return pd_refuse("scout-marker-write");
        }
    }
    char ef[PD_PW];
    if (cx_fmt(ef, sizeof ef, "%s/expected-fail.tsv", out_dir)) { mm_free(wb); return pd_refuse("expected-fail-path"); }
    int exists = sy_exists(ef);
    if (exists < 0) { mm_free(wb); return pd_refuse("expected-fail-read"); }
    if (exists) {
        size_t size = 0;
        pd_expected_rows = cx_read(ef, &size);
        if (!pd_expected_rows || pd_file_sha256_hex(cand, pd_candidate_sha)) {
            mm_free(wb); return pd_refuse("expected-fail-input");
        }
    }
    const char *eff_root = root;
    frozen_root[0] = 0;
    frozen_rev[0] = 0;
    if (pd_freeze_source_root(root, out_dir, frozen_root, sizeof frozen_root, frozen_rev, sizeof frozen_rev) == 0 &&
        frozen_root[0] && frozen_rev[0]) {
        eff_root = frozen_root;
        printf("PRERUN_FROZEN_SOURCE\trev=%s\troot=%s\n", frozen_rev, eff_root);
        fflush(stdout);
    }
    {
        int64_t cpos = 0;
        int planned_batches = 0;
        while (cpos < wn) {
            int64_t ls = cpos;
            while (cpos < wn && wb[cpos] != '\n') cpos++;
            int64_t le = cpos;
            if (cpos < wn) cpos++;
            if (le > ls && wb[le - 1] == '\r') le--;
            if (le <= ls || wb[ls] == '#' || (le - ls >= 7 && memcmp(wb + ls, "window\t", 7) == 0)) continue;
            const char *cols[8]; int64_t clens[8]; int nc = 0; int64_t p = ls;
            while (nc < 8) {
                int64_t cs = p;
                while (p < le && wb[p] != '\t') p++;
                cols[nc] = (const char *)wb + cs; clens[nc] = p - cs; nc++;
                if (p >= le) break;
                p++;
            }
            if (nc < 5) continue;
            if (clens[2] == 13 && memcmp(cols[2], "prebuild-self", 13) == 0) continue;
            char cbuf[16];
            if (clens[3] > 0 && clens[3] < 15 && !mm_copy(cbuf, sizeof cbuf, cols[3], (size_t)clens[3])) {
                cbuf[clens[3]] = 0;
                int cval = atoi(cbuf);
                if (cval > 0) planned_batches += cval;
            }
        }
        if (planned_batches >= PD_PREP_MAXB) {
            fprintf(stderr, "PRERUN_MAXB_EXCEEDED\tbatches=%d\tmaxb=%d\n", planned_batches, PD_PREP_MAXB);
            mm_free(wb);
            return pd_refuse("batch-count-reaches-release-prep-maxb-1024");
        }
    }
    pd_prepare_opt_frame4(eff_root, cand, out_dir, mock_runner, resume, wb, wn);
    if (pd_prepare_entry_link(eff_root, cand, out_dir, mock_runner, resume, wb, wn) != 0) {
        mm_free(wb);
        return pd_refuse("prepare-entry-link-incomplete");
    }
    int64_t pos = 0;
    int ran = 0, skipped = 0, incomplete = 0;
    char infra_ref[256] = {0};
    int infra_same = 0;
    int retry_counts[PD_MAX_IDS];
    char retry_ids[PD_MAX_IDS][128];
    int nretry = 0;
    static PdLane group[PD_MAX_LANES];
    int queued = 0, next = 0;
    while (pos < wn || next < queued) {
        PdWindow current;
        PdLane *prefetched = 0;
        if (next < queued) {
            prefetched = &group[next++];
            current = prefetched->window;
        } else {
            int row = pd_next_window(wb, wn, &pos, out_dir, &current);
            if (row == 0) break;
            if (row < 0) {
                mm_free(wb); return pd_refuse(row == -2 ? "invalid-window-jobs" : "invalid-window-row");
            }
        }
        char *wid = current.wid, *phase = current.phase, *ids = current.ids;
        char *donep = current.done, *outp = current.strict;
        int jobs = current.jobs;
        if (!timed && tx_eqz(phase, "normal") && jobs > 1) jobs = max_jobs;
        else if (jobs > max_jobs) jobs = max_jobs;
        sy_stat_t st;
        if (resume && sy_lstat(donep, &st) == 0) {
            skipped++;
            continue;
        }
        if (pd_check_min_free(out_dir, wid, min_free_bytes)) {
            mm_free(wb);
            return 2;
        }
        if (!prefetched && lanes > 1 && pd_can_share_window(phase, ids, current.jobs) &&
            (!resume || (sy_exists(outp) == 0 && sy_exists(donep) == 0))) {
            group[0].window = current;
            queued = 1;
            int64_t look = pos;
            while (queued < lanes) {
                PdWindow *w = &group[queued].window;
                if (pd_next_window(wb, wn, &look, out_dir, w) != 1 ||
                    !pd_can_share_window(w->phase, w->ids, w->jobs) ||
                    (resume && (sy_exists(w->strict) != 0 || sy_exists(w->done) != 0))) break;
                int distinct = 1;
                for (int i = 0; i < queued; i++) {
                    if (tx_eqz(w->wid, group[i].window.wid) || tx_eqz(w->ids, group[i].window.ids)) distinct = 0;
                }
                if (!distinct) break;
                queued++;
                pos = look;
            }
            next = queued;
            if (queued > 1) {
                if (!mock_runner && !frozen_rev[0]) {
                    mm_free(wb); return pd_refuse("window-lanes-require-frozen-source");
                }
                printf("PRERUN_LANES\tfirst=%s\twindows=%d\n", wid, queued);
                long wave_start = sy_now_ms();
                if (pd_first_attempts(group, queued, canonical_dir, eff_root, cand, mock_runner)) {
                    mm_free(wb); return pd_refuse("window-lane-worker-failed");
                }
                printf("PRERUN_LANE_WALL\tfirst=%s\twindows=%d\twall_ms=%ld\n",
                       wid, queued, sy_now_ms() - wave_start);
                prefetched = &group[0];
                next = 1;
            }
        }
        (void)load_cap;   /* load gates retired 2026-11-20: --max-jobs is the fixed bound, load1 never lowers it */
        if (tx_eqz(phase, "prebuild-self")) {
            char cmd[8192], why[256], lay_dir[PD_PW];
            const char *run_cwd = eff_root;
            np_result r = {0};
            long started = sy_now_ms();
            if (mock_runner) {
                cx_fmt(cmd, sizeof cmd, "sh '%s' prebuild-self '%s' '%s'", mock_runner, wid, outp);
            } else if (pd_prebuild_layout(eff_root, cand, lay_dir, sizeof lay_dir) == 0) {
                run_cwd = lay_dir;
                cx_fmt(cmd, sizeof cmd, "cd '%s' && sh ./unisacc.com tools/devsvc.cx -- prebuild-self", lay_dir);
            } else {
                const char *use_cand = (cand && cand[0] && !tx_eqz(cand, "-")) ? cand : "./unisacc.com";
                cx_fmt(cmd, sizeof cmd, "cd '%s' && sh '%s' tools/devsvc.cx -- prebuild-self", eff_root, use_cand);
            }
            char *av[] = {"sh", "-c", cmd, 0};
            int s1mp = 0; { const char *e = sy_env("UNISACC_S1_MAX_PROCS"); int v = (e && e[0]) ? atoi(e) : 0; if (v >= 1 && v <= 256) s1mp = v; }
    int tr = np_run_capped(av, run_cwd, 0, PD_CHILD_SECONDS, s1mp, &r, why, sizeof why);
            int rc = tr ? 124 : r.rc;
            np_free(&r);
            printf("PRERUN_WINDOW\twindow=%s\tphase=%s\tattempt=%d\tjobs=%d\trc=%d\twall_ms=%ld\touter_overhead=UNMEASURED\n",
                   wid, phase, 1, jobs, rc, sy_now_ms() - started);
            fflush(stdout);
            if (rc != 0) {
                if (pd_keep_going == 2) {
                    char dline[128];
                    cx_fmt(dline, sizeof dline, "PREBUILD_SELF\tKEEP_GOING\trc=%d\n", rc);
                    sy_write_file(donep, dline, (int64_t)strlen(dline), 0644);
                    printf("PRERUN_KEEP_GOING\tbatch=prebuild-self\tretries=1\twindow=%s\traw=prebuild-self rc=%d\n", wid, rc);
                    ran++;
                    continue;
                }
                printf("PRERUN_STOP\twindow=%s\tphase=prebuild-self\trc=%d\n", wid, rc);
                mm_free(wb);
                return 1;
            }
            sy_write_file(donep, "PREBUILD_SELF\tOK\n", 17, 0644);
            ran++;
            continue;
        }

        char win_ids[32][128];
        int passed_flags[32] = {0};
        int nwin = 0;
        {
            const char *q = ids;
            while (*q && nwin < 32) {
                const char *c = strchr(q, ',');
                size_t l = c ? (size_t)(c - q) : strlen(q);
                if (l > 0 && l < 127) {
                    mm_copy(win_ids[nwin], 128, q, l);
                    win_ids[nwin][l] = 0;
                    nwin++;
                }
                if (!c) break;
                q = c + 1;
            }
        }
        static char saved_hdr[2048], saved_rows[32768];
        char rem_ids[4096];
        size_t saved_len = 0;
        saved_hdr[0] = 0;
        saved_rows[0] = 0;
        cx_fmt(rem_ids, sizeof rem_ids, "%s", ids);
        if (!prefetched && resume && sy_lstat(outp, &st) == 0) {
            if (pd_verify_window_source(outp, wid, 0, eff_root, frozen_rev)) {
                mm_free(wb); return 1;
            }
            pd_harvest_passed(outp, ids, saved_hdr, sizeof saved_hdr, saved_rows, sizeof saved_rows, &saved_len,
                              passed_flags, win_ids, nwin, rem_ids, sizeof rem_ids);
            if (!rem_ids[0]) {
                char dline[128];
                cx_fmt(dline, sizeof dline, "QUALIFY_DONE\twindow=%s\tjobs=%d\tattempts=1\n", wid, jobs);
                sy_write_file(donep, dline, (int64_t)strlen(dline), 0644);
                ran++;
                continue;
            }
        }

        char serialp[PD_PW];
        if (cx_fmt(serialp, sizeof serialp, "%s/serial.%s", out_dir, wid)) {
            mm_free(wb); return pd_refuse("serial-path-bound");
        }
        int serial = timed && resume && sy_exists(serialp) == 1;
        int attempt = 0;
        int win_final_rc = -1;
        for (;;) {
            if (serial) {
                int result = pd_recover_serial(eff_root, cand, out_dir, mock_runner, wid,
                                               win_ids, passed_flags, nwin, max_retries, resume);
                if (result < 0) { mm_free(wb); return pd_refuse("serial-recovery-receipt-write"); }
                if (result == 2) { mm_free(wb); return 1; }
                if (result == 0) {
                    if (sy_write_atomic(donep, "SERIAL_DONE\n", 12, 0644)) {
                        mm_free(wb); return pd_refuse("serial-window-receipt-write");
                    }
                    ran++;
                } else {
                    incomplete++;
                    if (pd_keep_going != 2) { mm_free(wb); return 1; }
                }
                break;
            }
            attempt++;
            size_t prev_saved_len = saved_len;
            const char *run_ids = rem_ids[0] ? rem_ids : ids;
            int rc;
            if (prefetched && attempt == 1) {
                rc = prefetched->rc;
                pd_log_window(wid, phase, outp, jobs, attempt, rc, prefetched->wall_ms);
            } else {
                sy_unlink(outp);
                if (prefetched) {
                    long start = sy_now_ms();
                    rc = pd_call_window(eff_root, cand, mock_runner, wid, run_ids, outp, jobs, attempt, prefetched->env);
                    pd_log_window(wid, phase, outp, jobs, attempt, rc, sy_now_ms() - start);
                } else {
                    rc = pd_window_attempt(eff_root, cand, mock_runner, wid, phase, run_ids, outp, jobs, attempt);
                }
            }
            {
                int enospc_hit = 0;
                if (rc != 0) {
                    enospc_hit = 1;
                    pd_infra_enospc(outp, &enospc_hit);
                }
                if (enospc_hit) {
                    printf("PRERUN_INFRA\treason=ENOSPC\twindow=%s\n", wid);
                    mm_free(wb);
                    return 2;
                }
            }
            if (pd_verify_window_source(outp, wid, attempt, eff_root, frozen_rev)) {
                mm_free(wb);
                return 1;
            }

            if (prev_saved_len > 0) {
                pd_prepend_saved(outp, saved_hdr, saved_rows, prev_saved_len);
            }
            pd_harvest_passed(outp, ids, saved_hdr, sizeof saved_hdr, saved_rows, sizeof saved_rows, &saved_len,
                              passed_flags, win_ids, nwin, rem_ids, sizeof rem_ids);
            if (timed && rc == 124 && jobs > 1 && rem_ids[0]) {
                if (sy_write_atomic(serialp, "jobs=1\n", 7, 0644)) {
                    mm_free(wb); return pd_refuse("serial-recovery-marker-write");
                }
                printf("PRERUN_RECOVER\twindow=%s\tfrom_jobs=%d\tto_jobs=1\tremaining=%s\n", wid, jobs, rem_ids);
                serial = 1;
                continue;
            }

            unsigned char *ob = 0; int64_t on = 0;
            int has_nonpass = 0, bad_rc = rc, bad_prod_fail = 0;
            char bad_id[128] = {0}, bad_raw[1024] = {0};
            pd_nstates = 0;
            if (sy_read_file(outp, &ob, &on, 4 << 20) == 0 && ob && on > 0) {
                pd_ingest_strict_buf((const char *)ob, on);
                if (tx_eqz(phase, "warmup") && tx_find((const char *)ob, (long)on, "kit-window\t", 11) >= 0) {
                    has_nonpass = 1;
                    cx_fmt(bad_id, sizeof bad_id, "kit-window");
                    cx_fmt(bad_raw, sizeof bad_raw, "warmup-kit-window-not-ready");
                }
                for (int k = 0; k < pd_nstates; k++) {
                    if (!tx_eqz(pd_states[k].status, "PASS")) {
                        int is_pf = (tx_eqz(pd_states[k].domain, "product-qualification") && tx_eqz(pd_states[k].status, "FAIL"));
                        if (!has_nonpass || (is_pf && !bad_prod_fail)) {
                            has_nonpass = 1;
                            bad_prod_fail = is_pf;
                            bad_rc = pd_states[k].rc;
                            cx_fmt(bad_id, sizeof bad_id, "%s", pd_states[k].id);
                            cx_fmt(bad_raw, sizeof bad_raw, "%s", pd_states[k].raw_line);
                        }
                        if (bad_prod_fail) break;
                    }
                }
                mm_free(ob);
            } else {
                has_nonpass = 1;
                cx_fmt(bad_id, sizeof bad_id, "%s", wid);
                cx_fmt(bad_raw, sizeof bad_raw, "no-output rc=%d", rc);
            }

            if (!has_nonpass && !rem_ids[0] && rc == 0) {
                if (tx_eqz(phase, "warmup")) {
                    printf("PRERUN_WARMUP_READY\twindow=%s\tids=%s\tlayout=ready\tkit=ready\n", wid, ids);
                    fflush(stdout);
                }
                char dline[128];
                cx_fmt(dline, sizeof dline, "QUALIFY_DONE\twindow=%s\tjobs=%d\tattempts=%d\n", wid, jobs, attempt);
                sy_write_file(donep, dline, (int64_t)strlen(dline), 0644);
                ran++;
                win_final_rc = 0;
                break;
            }
            if (!has_nonpass && rem_ids[0]) {
                has_nonpass = 1;
                const char *comma = strchr(rem_ids, ',');
                size_t bl = comma ? (size_t)(comma - rem_ids) : strlen(rem_ids);
                if (bl >= sizeof bad_id) bl = sizeof bad_id - 1;
                mm_copy(bad_id, sizeof bad_id, rem_ids, bl);
                bad_id[bl] = 0;
                cx_fmt(bad_raw, sizeof bad_raw, "window-timeout-remaining=%s rc=%d", rem_ids, rc);
            }
            int only_unknown = (pd_nstates > 0 && !bad_prod_fail);
            for (int i = 0; i < nwin && only_unknown; i++) {
                if (passed_flags[i]) continue;
                int st_idx = pd_state_find(win_ids[i]);
                if (st_idx < 0 || !pd_states[st_idx].seen || !tx_eqz(pd_states[st_idx].status, "UNKNOWN"))
                    only_unknown = 0;
            }
            /* Track per-batch retry count; stop immediately after max_retries (default 2) */
            int ridx = -1;
            for (int k = 0; k < nretry; k++) if (tx_eqz(retry_ids[k], bad_id)) { ridx = k; break; }
            if (ridx < 0 && nretry < PD_MAX_IDS) {
                ridx = nretry++;
                cx_fmt(retry_ids[ridx], sizeof retry_ids[ridx], "%s", bad_id);
                retry_counts[ridx] = 0;
            }
            if (ridx >= 0) retry_counts[ridx]++;
            int cnt = (ridx >= 0) ? retry_counts[ridx] : attempt;
            if (cnt >= max_retries) {
                if (bad_prod_fail) {
                    int all_accounted = 1, unexpected = 0;
                    for (int j = 0; j < nwin; j++) {
                        int k = pd_state_find(win_ids[j]);
                        if (k < 0 || !pd_states[k].seen) { all_accounted = 0; continue; }
                        PdState *s = &pd_states[k];
                        if (tx_eqz(s->status, "PASS")) continue;
                        if (tx_eqz(s->status, "FAIL") && tx_eqz(s->domain, "product-qualification") && pd_expected_red(s))
                            printf("PRERUN_EXPECTED_RED\tbatch=%s\twindow=%s\traw=%s\n", s->id, wid, s->raw_line);
                        else {
                            unexpected++;
                            if (pd_scout) printf("PRERUN_SCOUT_RED\tbatch=%s\twindow=%s\traw=%s\n", s->id, wid, s->raw_line);
                        }
                    }
                    if (pd_scout || (all_accounted && !unexpected)) {
                        const char *receipt = pd_scout ? "SCOUT_ONLY\n" : "EXPECTED_FAIL\n";
                        if (sy_write_atomic(donep, receipt, strlen(receipt), 0644)) { mm_free(wb); return pd_refuse("red-receipt-write"); }
                        ran++;
                        break;
                    }
                    printf("PRERUN_PRODUCT_RED_STOP\tbatch=%s\tdomain=product-qualification\tstatus=FAIL\trc=%d\tretries=%d\twindow=%s\ttriage=inspect-strict-%s.tsv\traw=%s\n",
                           bad_id, bad_rc, cnt, wid, wid, bad_raw);
                    printf("PRERUN_STOP\tbatch=%s\tretries=%d\twindow=%s\traw=%s\n", bad_id, cnt, wid, bad_raw);
                    mm_free(wb);
                    return 1;
                }
                if (pd_keep_going == 2 || (pd_keep_going >= 1 && only_unknown)) {
                    win_final_rc = rc;
                    if (timed) {
                        int missing = 0;
                        for (int i = 0; i < nwin; i++) {
                            int state = pd_state_find(win_ids[i]);
                            if (state >= 0 && pd_states[state].seen) continue;
                            printf("PRERUN_INCOMPLETE\tbatch=%s\twindow=%s\traw=timed-window-missing-evidence rc=%d\n",
                                   win_ids[i], wid, rc);
                            missing = 1;
                        }
                        if (missing) { incomplete++; break; }
                    } else if (rc == 124 && rem_ids[0] && !mock_runner) {
                        size_t prev_sl = saved_len;
                        sy_unlink(outp);
                        pd_window_attempt(root, cand, 0, wid, phase, rem_ids, outp, max_jobs, attempt + 1);
                        if (prev_sl > 0) pd_prepend_saved(outp, saved_hdr, saved_rows, prev_sl);
                    }
                    char dline[256];
                    cx_fmt(dline, sizeof dline, "QUALIFY_DONE\twindow=%s\tjobs=%d\tattempts=%d\tfail-kept=1\tbatch=%s\n", wid, jobs, attempt, bad_id);
                    sy_write_file(donep, dline, (int64_t)strlen(dline), 0644);
                    printf("PRERUN_KEEP_GOING\tbatch=%s\tretries=%d\twindow=%s\traw=%s\n", bad_id, cnt, wid, bad_raw);
                    ran++;
                    break;
                }
                printf("PRERUN_STOP\tbatch=%s\tretries=%d\twindow=%s\traw=%s\n", bad_id, cnt, wid, bad_raw);
                mm_free(wb);
                return 1;
            }
            if (!timed) jobs = 1;
        }
        {
            int repeat_stop = 1;
            pd_track_repeat_rc2(win_final_rc, outp, wid, infra_ref, sizeof infra_ref, &infra_same, &repeat_stop);
            if (repeat_stop) {
                mm_free(wb);
                return 2;
            }
        }
    }
    mm_free(wb);
    if (pd_scout) {
        printf("PRERUN_RUN\tstatus=SCOUT_ONLY\tran=%d\tskipped=%d\tincomplete=%d\n", ran, skipped, incomplete);
        return 1;
    }
    if (incomplete) {
        printf("PRERUN_RUN\tstatus=INCOMPLETE\tran=%d\tskipped=%d\tmissing_windows=%d\tout=%s\n",
               ran, skipped, incomplete, out_dir);
        return 1;
    }
    {
        char rdp[PD_PW], rdb[384];
        if (!cx_fmt(rdp, sizeof rdp, "%s/%s", out_dir, pd_rebase_run ? "run.rebase-pending" : "run.done")) {
            if (pd_run_measured_wins > 0 &&
                !cx_fmt(rdb, sizeof rdb, "status\tDONE\nran\t%d\nskipped\t%d\nwindow_wall_ms\t%ld\nsum_batch_ms\t%ld\nouter_overhead_ms\t%ld\n",
                        ran, skipped, pd_run_wall_ms, pd_run_batch_ms, pd_run_wall_ms - pd_run_batch_ms))
                sy_write_file(rdp, rdb, (int64_t)strlen(rdb), 0644);
            else if (!cx_fmt(rdb, sizeof rdb, "status\tDONE\nran\t%d\nskipped\t%d\n", ran, skipped))
                sy_write_file(rdp, rdb, (int64_t)strlen(rdb), 0644);
        }
    }
    if (pd_rebase_run) return 0;
    if (pd_run_measured_wins > 0)
        printf("PRERUN_RUN\tstatus=DONE\tran=%d\tskipped=%d\tout=%s\twindow_wall_ms=%ld\tsum_batch_ms=%ld\touter_overhead_ms=%ld\n",
               ran, skipped, out_dir, pd_run_wall_ms, pd_run_batch_ms, pd_run_wall_ms - pd_run_batch_ms);
    else
        printf("PRERUN_RUN\tstatus=DONE\tran=%d\tskipped=%d\tout=%s\touter_overhead=UNMEASURED\n", ran, skipped, out_dir);
    return 0;
}

static int pd_cmp_str(const char *a, const char *b) {
    return strcmp(a, b);
}

static int pd_archive_version(const char *ver) {
    int dots = 0, digits = 0;
    if (strlen(ver) >= 32) return 0;
    for (const char *p = ver; *p; p++) {
        if (*p >= '0' && *p <= '9') digits++;
        else if (*p == '.' && digits) { dots++; digits = 0; }
        else return 0;
    }
    return dots == 2 && digits > 0;
}

static int pd_cmd_archive(const char *in, const char *repo, const char *ver) {
    if (pd_scout_state(in) != 0) return pd_refuse("scout-only-not-evidence");
    char dir[PD_PW], src[PD_PW], dest[2][PD_PW];
    const char *names[] = {"windows.tsv", "supervise.log"};
    unsigned char *bytes[2] = {0};
    int64_t size[2] = {0};
    const char *error = 0;
    int redacted = 0;
    if (!pd_archive_version(ver)) return pd_refuse("archive-invalid-version");
    if (cx_fmt(dir, sizeof dir, "%s/release/evidence/%s", repo, ver))
        return pd_refuse("archive-path-bound");
    for (int i = 0; i < 2; i++) {
        if (cx_fmt(src, sizeof src, "%s/%s", in, names[i]) ||
            cx_fmt(dest[i], sizeof dest[i], "%s/prerun-%s", dir, names[i])) {
            error = "archive-path-bound";
            break;
        }
        if (sy_read_file(src, &bytes[i], &size[i], 16 << 20) || size[i] <= 0) {
            error = i ? "archive-read-supervise-log" : "archive-read-windows";
            break;
        }
    }
    if (!error) {
        /* Keep the window table verbatim. Replace this account's home prefix in the log. */
        char *log = (char *)bytes[1];
        const char *home = sy_env("HOME");
        long nh = home && home[0] == '/' ? (long)strlen(home) : 0;
        long read = 0, write = 0;
        while (read < size[1]) {
            if (nh > 1 && read + nh < size[1] && log[read + nh] == '/' &&
                !memcmp(log + read, home, (size_t)nh)) {
                log[write++] = '~';
                read += nh;
                redacted++;
            } else log[write++] = log[read++];
        }
        size[1] = write;
        if (tx_find(log, write, "/" "home/", 6) >= 0 ||
            tx_find((const char *)bytes[0], size[0], "/" "home/", 6) >= 0)
            error = "archive-unresolved-home-path";
    }
    if (!error) {
        if (sy_mkdir_all(dir, 0755)) error = "archive-create-directory";
        sy_stat_t st;
        for (int i = 0; !error && i < 2; i++) {
            int rc = sy_lstat(dest[i], &st);
            if (rc == 0) error = "archive-destination-exists";
            else if (rc != -ENOENT) error = "archive-destination-stat";
        }
    }
    if (!error) {
        char staging[PD_PW], paths[2][PD_PW];
        int installed = 0;
        if (sy_mkdtemp(dir, ".prerun-archive-", staging, sizeof staging)) error = "archive-stage-directory";
        else {
            for (int i = 0; !error && i < 2; i++) {
                if (cx_fmt(paths[i], sizeof paths[i], "%s/%s", staging, names[i]) ||
                    sy_write_atomic(paths[i], bytes[i], size[i], 0644)) error = "archive-stage-write";
            }
            for (int i = 0; !error && i < 2; i++) {
                int rc = sy_link(paths[i], dest[i]);
                if (rc) error = rc == -EEXIST ? "archive-destination-exists" : "archive-install";
                else installed++;
            }
            if (error && installed && sy_unlink(dest[0])) error = "archive-rollback-failed";
            if (sy_remove_all(staging) && !error) error = "archive-stage-cleanup";
        }
    }
    mm_free(bytes[0]);
    mm_free(bytes[1]);
    if (error) return pd_refuse(error);
    printf("PRERUN_ARCHIVE\tversion=%s\twindows_bytes=%lld\tlog_bytes=%lld\thome_paths_redacted=%d\n",
        ver, (long long)size[0], (long long)size[1], redacted);
    return 0;
}

static int pd_cmd_merge(const char *in_dir, const char *out_dir, const char *ver) {
    if (pd_scout_state(in_dir) != 0) return pd_refuse("scout-only-not-evidence");
    sy_dir_t d;
    static char files[PD_MAX_FILES][256];
    int nf = 0;
    if (sy_dir_open(&d, in_dir) != 0) return pd_refuse("open-in-dir");
    while (sy_dir_next(&d) == 1) {
        if (pd_starts(d.name, "strict-") && d.name_n > 11 &&
            memcmp(d.name + d.name_n - 4, ".tsv", 4) == 0 &&
            !tx_eqz(d.name, "strict-final.tsv")) {
            if (nf == PD_MAX_FILES) { sy_dir_close(&d); return pd_refuse("too-many-strict-window-files"); }
            cx_fmt(files[nf], sizeof files[nf], "%s", d.name);
            nf++;
        }
    }
    sy_dir_close(&d);
    if (nf == 0) return pd_refuse("no-strict-window-files");
    for (int i = 1; i < nf; i++) {
        char key[256];
        cx_fmt(key, sizeof key, "%s", files[i]);
        int j = i - 1;
        while (j >= 0 && pd_cmp_str(files[j], key) > 0) {
            cx_fmt(files[j + 1], sizeof files[j + 1], "%s", files[j]);
            j--;
        }
        cx_fmt(files[j + 1], sizeof files[j + 1], "%s", key);
    }

    pd_mkdirs(out_dir);
    size_t cap = 4 << 20;
    char *merged = (char *)mm_alloc(cap);
    if (!merged) return pd_refuse("oom");
    size_t mp = 0;
    int wrote_hdr = 0;
    char last_summary[1024] = {0};
    pd_nstates = 0;

    for (int fi = 0; fi < nf; fi++) {
        char fp[PD_PW];
        unsigned char *b = 0; int64_t n = 0;
        if (cx_fmt(fp, sizeof fp, "%s/%s", in_dir, files[fi]) || sy_read_file(fp, &b, &n, 2 << 20)) continue;
        pd_ingest_strict_buf((const char *)b, n);
        int64_t pos = 0;
        while (pos < n) {
            int64_t ls = pos;
            while (pos < n && b[pos] != '\n') pos++;
            int64_t le = pos;
            if (pos < n) pos++;
            int64_t raw_len = le - ls;
            int is_hdr = (raw_len >= 1 && b[ls] == '#') || (raw_len >= 6 && memcmp(b + ls, "batch\t", 6) == 0);
            int is_sum = (raw_len >= 8 && memcmp(b + ls, "SUMMARY\t", 8) == 0);
            if (is_sum) {
                size_t sl = (size_t)(raw_len < 1000 ? raw_len : 1000);
                mm_copy(last_summary, sizeof last_summary, (const char *)b + ls, sl);
                last_summary[sl] = 0;
                continue;
            }
            if (is_hdr) {
                if (wrote_hdr) continue;
            } else {
                wrote_hdr = 1;
            }
            if (mp + (size_t)raw_len + 2 < cap) {
                mm_copy(merged + mp, cap - mp, (const char *)b + ls, (size_t)raw_len);
                mp += (size_t)raw_len;
                merged[mp++] = '\n';
            }
        }
        mm_free(b);
    }

    int n_pass = 0, n_fail = 0, n_unk = 0, n_sup = 0;
    static char ef_buf[65536], eu_buf[65536];
    size_t efp = 0, eup = 0;
    const char *ef_h = "batch\texpected\treason\n";
    const char *eu_h = "batch\treason\tevidence\n";
    mm_copy(ef_buf, sizeof ef_buf, ef_h, strlen(ef_h)); efp = strlen(ef_h);
    mm_copy(eu_buf, sizeof eu_buf, eu_h, strlen(eu_h)); eup = strlen(eu_h);
    for (int i = 0; i < pd_nstates; i++) {
        PdState *s = &pd_states[i];
        if (s->superseded) n_sup++;
        if (tx_eqz(s->status, "PASS")) n_pass++;
        else if (tx_eqz(s->status, "FAIL")) {
            n_fail++;
            char row[512];
            cx_fmt(row, sizeof row, "%s\t%s\tdraft from prerun-drive (%s); expires=next\n", s->id, s->note, ver ? ver : "dev");
            size_t rl = strlen(row);
            if (efp + rl < sizeof ef_buf) { mm_copy(ef_buf + efp, sizeof ef_buf - efp, row, rl); efp += rl; }
        } else {
            n_unk++;
            char row[512];
            cx_fmt(row, sizeof row, "%s\tno-producer\t%s-deferred.tsv\n", s->id, s->id);
            size_t rl = strlen(row);
            if (eup + rl < sizeof eu_buf) { mm_copy(eu_buf + eup, sizeof eu_buf - eup, row, rl); eup += rl; }
        }
    }

    if (last_summary[0]) {
        char sum_tail[1024] = {0}, sum_line[1280] = {0};
        size_t tp = 0;
        const char *p = last_summary;
        while (*p) {
            const char *te = p;
            while (*te && *te != '\t') te++;
            size_t tl = (size_t)(te - p);
            if (tl > 0 &&
                !(tl == 7 && memcmp(p, "SUMMARY", 7) == 0) &&
                !pd_starts(p, "batches=") &&
                !pd_starts(p, "PASS=") &&
                !pd_starts(p, "FAIL=") &&
                !pd_starts(p, "UNKNOWN=") &&
                !pd_starts(p, "INVALID=")) {
                if (tp + tl + 2 < sizeof sum_tail) {
                    sum_tail[tp++] = '\t';
                    mm_copy(sum_tail + tp, sizeof sum_tail - tp, p, tl);
                    tp += tl;
                    sum_tail[tp] = 0;
                }
            }
            p = *te ? te + 1 : te;
        }
        cx_fmt(sum_line, sizeof sum_line, "SUMMARY\tbatches=%d\tPASS=%d\tFAIL=%d\tUNKNOWN=%d\tINVALID=0%s",
               pd_nstates, n_pass, n_fail, n_unk, sum_tail);
        size_t sl = strlen(sum_line);
        if (mp + sl + 2 < cap) {
            mm_copy(merged + mp, cap - mp, sum_line, sl);
            mp += sl;
            merged[mp++] = '\n';
        }
    }

    char spath[PD_PW], efpath[PD_PW], eupath[PD_PW];
    if (cx_fmt(spath, sizeof spath, "%s/strict-final.tsv", out_dir) ||
        cx_fmt(efpath, sizeof efpath, "%s/expected-fail.draft.tsv", out_dir) ||
        cx_fmt(eupath, sizeof eupath, "%s/expected-unmeasured.draft.tsv", out_dir)) {
        mm_free(merged);
        return pd_refuse("path-bound");
    }
    int wrc = sy_write_file(spath, merged, (int64_t)mp, 0644);
    mm_free(merged);
    if (wrc) return pd_refuse("write-strict-final");
    sy_write_file(efpath, ef_buf, (int64_t)efp, 0644);
    sy_write_file(eupath, eu_buf, (int64_t)eup, 0644);

    printf("PRERUN_MERGE\twindows=%d\tbatches=%d\tPASS=%d\tFAIL=%d\tUNKNOWN=%d\tSUPERSEDED=%d\tout=%s\n",
           nf, pd_nstates, n_pass, n_fail, n_unk, n_sup, spath);
    return 0;
}

static int pd_cmd_replay(const char *ids_file, const char *ev_dir, const char *out_dir, const char *exp_strict, const char *exp_g1dry) {
    if (pd_load_ids(ids_file)) return pd_refuse("read-ids-file");
    if (pd_build_plan(10, 4, out_dir)) return 2;
    /* Verify plan invariants: every id covered once, normal windows 8..12, heavy jobs=1 */
    int covered = 0;
    for (int wi = 0; wi < pd_nwins; wi++) {
        PdWin *w = &pd_wins[wi];
        if (tx_eqz(w->phase, "prebuild-self")) continue;
        if (tx_eqz(w->phase, "heavy") && w->jobs != 1) return pd_refuse("heavy-window-jobs-not-1");
        if (tx_eqz(w->phase, "normal") && (w->count < 1 || w->count > 12)) return pd_refuse("normal-window-size-bound");
        covered += w->count;
    }
    if (covered != pd_nids) return pd_refuse("plan-coverage-mismatch");

    if (pd_cmd_merge(ev_dir, out_dir, "replay")) return 2;
    int m_total = pd_nstates, m_pass = 0, m_fail = 0, m_unk = 0, m_sup = 0;
    for (int i = 0; i < pd_nstates; i++) {
        if (pd_states[i].superseded) m_sup++;
        if (tx_eqz(pd_states[i].status, "PASS")) m_pass++;
        else if (tx_eqz(pd_states[i].status, "FAIL")) m_fail++;
        else m_unk++;
    }

    if (exp_strict) {
        unsigned char *eb = 0; int64_t en = 0;
        if (sy_read_file(exp_strict, &eb, &en, 8 << 20)) return pd_refuse("read-expected-strict");
        pd_nstates = 0;
        pd_ingest_strict_buf((const char *)eb, en);
        mm_free(eb);
        int e_total = pd_nstates, e_pass = 0, e_fail = 0, e_unk = 0, e_sup = 0;
        for (int i = 0; i < pd_nstates; i++) {
            if (pd_states[i].superseded) e_sup++;
            if (tx_eqz(pd_states[i].status, "PASS")) e_pass++;
            else if (tx_eqz(pd_states[i].status, "FAIL")) e_fail++;
            else e_unk++;
        }
        if (e_total != m_total || e_pass != m_pass || e_fail != m_fail || e_unk != m_unk || e_sup != m_sup) {
            fprintf(stderr, "PRERUN_REPLAY\tMISMATCH\tmerged=%d/%d/%d/%d/%d\texpected=%d/%d/%d/%d/%d\n",
                    m_total, m_pass, m_fail, m_unk, m_sup, e_total, e_pass, e_fail, e_unk, e_sup);
            return 1;
        }
    }

    if (exp_g1dry) {
        unsigned char *gb = 0; int64_t gn = 0;
        if (sy_read_file(exp_g1dry, &gb, &gn, 1 << 20)) return pd_refuse("read-expected-g1dry");
        char want_ef[64], want_sup[64];
        cx_fmt(want_ef, sizeof want_ef, "expected_fail=%d", m_fail);
        cx_fmt(want_sup, sizeof want_sup, "superseded=%d", m_sup);
        int ok_ef = (tx_find((const char *)gb, (long)gn, want_ef, (long)strlen(want_ef)) >= 0);
        int ok_sup = (tx_find((const char *)gb, (long)gn, want_sup, (long)strlen(want_sup)) >= 0);
        mm_free(gb);
        if (!ok_ef || !ok_sup) {
            fprintf(stderr, "PRERUN_REPLAY\tG1_MISMATCH\twant=%s,%s\n", want_ef, want_sup);
            return 1;
        }
    }

    printf("PRERUN_REPLAY\tstatus=MATCH\tplan_ids=%d\tevid_batches=%d\tPASS=%d\tFAIL=%d\tUNKNOWN=%d\tSUPERSEDED=%d\n",
           pd_nids, m_total, m_pass, m_fail, m_unk, m_sup);
    return 0;
}

static int pd_cmd_g1_dry(const char *root, const char *cand_tsv, const char *strict_f, const char *ef_f, const char *eu_f, const char *out_dir, const char *ver) {
    char lay[PD_PW], evd[PD_PW], g1out[PD_PW], g1txt[PD_PW], cmd[8192], why[256];
    np_result r = {0};
    pd_mkdirs(out_dir);
    if (cx_fmt(lay, sizeof lay, "%s/g1layout", out_dir) ||
        cx_fmt(evd, sizeof evd, "%s/release/evidence", lay) ||
        cx_fmt(g1out, sizeof g1out, "%s/g1out", out_dir) ||
        cx_fmt(g1txt, sizeof g1txt, "%s/g1dry.txt", out_dir)) return pd_refuse("path-bound");
    pd_mkdirs(evd);
    pd_mkdirs(g1out);
    {   /* a real directory at LAY/cx|tools|tests would make the link step below create LAY/cx/cx and the like: refuse */
        static const char *ln_names[] = {"cx", "tools", "tests", 0}; char lp[4400]; sy_stat_t lst;
        for (int li = 0; ln_names[li]; li++) if (cx_fmt(lp, sizeof lp, "%s/%s", lay, ln_names[li]) || (sy_lstat(lp, &lst) == 0 && lst.kind == 'd')) return pd_refuse("g1-layout-real-dir");
    }
    if (cx_fmt(cmd, sizeof cmd,
        "cp '%s' '%s/release/candidate.tsv' && cp '%s' '%s/v%s-strict.tsv' && "
        "cp '%s' '%s/v%s-expected-fail.tsv' && cp '%s' '%s/v%s-expected-unmeasured.tsv' && "
        "ln -sfn '%s/unisacc.com' '%s/unisacc.com' && ln -sfn '%s/cx' '%s/cx' && "
        "ln -sfn '%s/cxroot.tsv' '%s/cxroot.tsv' && ln -sfn '%s/tools' '%s/tools' && ln -sfn '%s/tests' '%s/tests'",
        cand_tsv, lay, strict_f, evd, ver, ef_f, evd, ver, eu_f, evd, ver,
        root, lay, root, lay, root, lay, root, lay, root, lay)) return pd_refuse("g1-prep-fmt");
    {
        char *pv[] = {"sh", "-c", cmd, 0};
        if (np_run(pv, root, 0, 20, &r, why, sizeof why) || r.rc) { np_free(&r); return pd_refuse("g1-prep-run"); }
        np_free(&r);
    }
    if (cx_fmt(cmd, sizeof cmd,
        "cd '%s' && sh ./unisacc.com tools/release-exec.cx -- "
        "--execute '%s/release/candidate.tsv' --layout '%s' --dry --out '%s' --baseline /nonexistent",
        root, lay, lay, g1out)) return pd_refuse("g1-run-fmt");
    {
        char *rv[] = {"sh", "-c", cmd, 0};
        int tr = np_run(rv, root, 0, 45, &r, why, sizeof why);
        size_t tot = (size_t)(r.outn + r.errn);
        char *all = (char *)mm_alloc(tot + 1);
        if (all) {
            if (r.outn > 0) mm_copy(all, tot + 1, r.out, (size_t)r.outn);
            if (r.errn > 0) mm_copy(all + r.outn, tot + 1 - (size_t)r.outn, r.err, (size_t)r.errn);
            all[tot] = 0;
            sy_write_file(g1txt, all, (int64_t)tot, 0644);
            int pass = (!tr && tx_find(all, (long)tot, "GATE\t1\tSTRICT\tPASS\t", 19) >= 0);
            printf("PRERUN_G1_DRY\tstatus=%s\trc=%d\tout=%s\n", pass ? "PASS" : "FAIL", tr ? 124 : r.rc, g1txt);
            mm_free(all);
            np_free(&r);
            return pass ? 0 : 1;
        }
        np_free(&r);
        return pd_refuse("oom");
    }
}

static int pd_env_lookup(const char *dir, const char *key, char *val, size_t vcap) {
    char p[PD_PW];
    unsigned char *b = 0; int64_t n = 0;
    val[0] = 0;
    if (!dir || !dir[0] || cx_fmt(p, sizeof p, "%s/prerun-env.tsv", dir) || sy_read_file(p, &b, &n, 1 << 20)) return 0;
    size_t kl = strlen(key);
    int64_t pos = 0;
    int found = 0;
    while (pos < n) {
        int64_t ls = pos;
        while (pos < n && b[pos] != '\n') pos++;
        int64_t le = pos;
        if (pos < n) pos++;
        if (le > ls && b[le - 1] == '\r') le--;
        if ((size_t)(le - ls) > kl + 1 && !memcmp(b + ls, key, kl) && b[ls + (int64_t)kl] == '\t') {
            size_t vl = (size_t)(le - (ls + (int64_t)kl + 1));
            if (vl > 0 && vl < vcap) {
                mm_copy(val, vcap, (const char *)b + ls + kl + 1, vl);
                val[vl] = 0;
                found = 1;
            }
            break;
        }
    }
    mm_free(b);
    return found;
}

static int pd_has_run_done(const char *dir) {
    char p[PD_PW];
    unsigned char *b = 0; int64_t n = 0;
    if (!dir || !dir[0] || cx_fmt(p, sizeof p, "%s/run.done", dir) || sy_read_file(p, &b, &n, 65536)) return 0;
    int ok = (tx_find((const char *)b, (long)n, "status\tDONE\n", 12) >= 0);
    mm_free(b);
    return ok;
}

typedef struct {
    char id[96];
    unsigned char planned;
    unsigned char foreign;
} PdBMeta;

static PdBMeta pd_bmeta[TP_BATCH_CAP];
static int pd_nbmeta = 0;
static char pd_pq_ids[TP_BATCH_CAP][96];
static int pd_npq = 0;
static char pd_split_p[64][96];
static int pd_nsplit_p = 0;

static int pd_is_split_p(const char *id, size_t len) {
    for (int i = 0; i < pd_nsplit_p; i++) {
        if (strlen(pd_split_p[i]) == len && !memcmp(pd_split_p[i], id, len)) return 1;
    }
    return 0;
}

static PdBMeta *pd_find_bmeta(const char *id, size_t len) {
    for (int i = 0; i < pd_nbmeta; i++) {
        if (strlen(pd_bmeta[i].id) == len && !memcmp(pd_bmeta[i].id, id, len)) return &pd_bmeta[i];
    }
    return 0;
}

static int pd_in_pq(const char *id) {
    for (int i = 0; i < pd_npq; i++) if (tx_eqz(pd_pq_ids[i], id)) return 1;
    return 0;
}

static void pd_add_batch_meta(const char *id, long idn, int planned, int foreign) {
    PdBMeta *m = &pd_bmeta[pd_nbmeta++];
    mm_copy(m->id, sizeof m->id, id, (size_t)idn);
    m->id[idn] = 0;
    m->planned = planned;
    m->foreign = foreign;
}

static int pd_git_show_rev(const char *root, const char *rev, const char *rel, unsigned char **out_b, int64_t *out_n) {
    char spec[512], why[256];
    *out_b = 0; *out_n = 0;
    if (!rev || !rev[0] || cx_fmt(spec, sizeof spec, "%s:%s", rev, rel)) return 1;
    char *av[] = {"git", "-C", (char *)root, "show", spec, 0};
    np_result r = {0};
    if (np_run(av, 0, 0, 15, &r, why, sizeof why) || r.rc != 0 || !r.out) {
        np_free(&r);
        return 1;
    }
    unsigned char *cp = (unsigned char *)mm_alloc((size_t)r.outn + 1);
    if (!cp) { np_free(&r); return 1; }
    if (r.outn > 0) mm_copy(cp, (size_t)r.outn + 1, r.out, (size_t)r.outn);
    cp[r.outn] = 0;
    *out_b = cp;
    *out_n = (int64_t)r.outn;
    np_free(&r);
    return 0;
}

static int pd_load_repo_batch_meta(const char *root, const char *rev) {
    char p[PD_PW];
    unsigned char *b = 0; int64_t n = 0;
    pd_nbmeta = 0; pd_npq = 0; pd_nsplit_p = 0;
    if (!pd_git_show_rev(root, rev, "tests/split-parents.tsv", &b, &n)) {
        int64_t pos = 0;
        while (pos < n && pd_nsplit_p < 64) {
            int64_t ls = pos;
            while (pos < n && b[pos] != '\n') pos++;
            int64_t le = pos;
            if (pos < n) pos++;
            if (le <= ls || b[ls] == '#') continue;
            int64_t te = ls;
            while (te < le && b[te] != '\t') te++;
            size_t l = (size_t)(te - ls);
            if (l > 0 && l < 95 && !(l == 6 && !memcmp(b + ls, "parent", 6))) {
                mm_copy(pd_split_p[pd_nsplit_p], 96, (const char *)b + ls, l);
                pd_split_p[pd_nsplit_p][l] = 0;
                pd_nsplit_p++;
            }
        }
        mm_free(b); b = 0; n = 0;
    }
    if (pd_git_show_rev(root, rev, "tests/batches.tsv", &b, &n)) {
        return pd_refuse("read-freeze-rev-batches");
    }
    {
        int rc = tp_visit_prepare_meta((const char *)b, n, pd_add_batch_meta);
        mm_free(b); b = 0; n = 0;
        if (rc) return pd_refuse("prepare-batch-meta-limit");
    }
    if (pd_git_show_rev(root, rev, "tests/batch-domain-index.tsv", &b, &n)) {
        /* Compute batch-domain-index from an exclusive mkdtemp git-archive snapshot of rev (never mutable worktree). */
        char snap[PD_PW], cmd[4096], qp[PD_PW], qc[PD_PW], why[256];
        const char *td = sy_tmpdir();
        const char *btd = (td && td[0] == '/') ? td : "/tmp";
        if (sy_mkdtemp(btd, "pd-rev-snap-", snap, sizeof snap) == 0 &&
            !cx_fmt(cmd, sizeof cmd, "git -C '%s' archive '%s' -- tests tools cx cxroot.tsv | tar -x -C '%s'", root, rev, snap)) {
            char *av[] = {"sh", "-c", cmd, 0};
            np_result ar = {0};
            if (!np_run(av, 0, 0, 20, &ar, why, sizeof why) && ar.rc == 0 &&
                sy_realpath("./unisacc.com", qp, sizeof qp) > 0 &&
                !cx_fmt(qc, sizeof qc, "%s/tools/derived-query.cx", snap) &&
                sy_exists(qp) == 1 && sy_exists(qc) == 1) {
                char *qv[] = {"sh", qp, qc, "--", "batch-domains", "--root", snap, "--path", 0};
                np_result qr = {0};
                if (!np_run(qv, snap, 0, 30, &qr, why, sizeof why) && qr.rc == 0 && qr.out && qr.outn > 0) {
                    size_t ql = (size_t)qr.outn;
                    while (ql > 0 && (qr.out[ql - 1] == '\n' || qr.out[ql - 1] == '\r')) ql--;
                    if (ql > 0 && ql < sizeof p) {
                        mm_copy(p, sizeof p, qr.out, ql);
                        p[ql] = 0;
                        sy_read_file(p, &b, &n, 8 << 20);
                    }
                }
                np_free(&qr);
            }
            np_free(&ar);
            (void)sy_remove_all(snap);
        }
    }
    if (b && n > 0) {
        int64_t pos = 0;
        while (pos < n) {
            int64_t ls = pos;
            while (pos < n && b[pos] != '\n') pos++;
            int64_t le = pos;
            if (pos < n) pos++;
            if (le > ls && b[le - 1] == '\r') le--;
            if (le <= ls || b[ls] == '#') continue;
            const char *c[4]; int64_t cl[4]; int nc = 0; int64_t q = ls;
            while (nc < 4) {
                int64_t cs = q;
                while (q < le && b[q] != '\t') q++;
                c[nc] = (const char *)b + cs; cl[nc] = q - cs; nc++;
                if (q >= le) break;
                q++;
            }
            if (nc >= 2 && cl[0] > 0 && cl[0] < 95 &&
                !(cl[0] == 2 && !memcmp(c[0], "id", 2)) &&
                cl[1] == 21 && !memcmp(c[1], "product-qualification", 21) &&
                !pd_is_split_p(c[0], (size_t)cl[0])) {
                char id[96];
                mm_copy(id, 96, c[0], (size_t)cl[0]);
                id[cl[0]] = 0;
                if (!pd_in_pq(id)) {
                    if (pd_npq == TP_BATCH_CAP) { mm_free(b); return pd_refuse("prepare-product-qualification-limit"); }
                    cx_fmt(pd_pq_ids[pd_npq++], 96, "%s", id);
                }
            }
        }
        mm_free(b);
    }
    return 0;
}

static void pd_find_latest_strict(const char *root, const char *cur_ver, char *out_path, size_t cap) {
    char evd[PD_PW], cur_pfx[64], best[256] = {0};
    out_path[0] = 0;
    if (cx_fmt(evd, sizeof evd, "%s/release/evidence", root) ||
        cx_fmt(cur_pfx, sizeof cur_pfx, "v%s-strict-", cur_ver ? cur_ver : "")) return;
    sy_dir_t d;
    if (sy_dir_open(&d, evd) != 0) return;
    while (sy_dir_next(&d) == 1) {
        if (d.name[0] == 'v' && d.name[1] >= '0' && d.name[1] <= '9' &&
            strstr(d.name, "-strict-") != 0 &&
            d.name_n > 12 && !memcmp(d.name + d.name_n - 4, ".tsv", 4) &&
            (!cur_ver || !cur_ver[0] || !pd_starts(d.name, cur_pfx))) {
            if (!best[0] || strcmp(d.name, best) > 0) {
                cx_fmt(best, sizeof best, "%s", d.name);
            }
        }
    }
    sy_dir_close(&d);
    if (best[0]) cx_fmt(out_path, cap, "%s/%s", evd, best);
}

static int pd_cmd_prepare(const char *from_chain_dir, const char *root_arg, const char *ver_arg,
                          const char *out_arg, const char *ids_arg, const char *times_arg,
                          const char *prio_arg, const char *heavy_f, int win_sz, int warmup) {
    char root[PD_PW], cdir[PD_PW], idp[PD_PW], ape_path[PD_PW], out_dir[PD_PW];
    char head_rev[64] = {0}, chain_rev[64] = {0}, ape_sha[65] = {0}, ver[64] = {0}, why[256] = {0};
    if (!from_chain_dir || !from_chain_dir[0]) return pd_refuse("prepare-requires-from-chain-dir");
    if (root_arg && root_arg[0]) {
        if (sy_realpath(root_arg, root, sizeof root) < 0) cx_fmt(root, sizeof root, "%s", root_arg);
    } else {
        if (sy_realpath(".", root, sizeof root) < 0) cx_fmt(root, sizeof root, ".");
    }
    {
        char *gv[] = {"git", "-C", root, "rev-parse", "HEAD", 0};
        np_result gr = {0};
        if (np_run(gv, 0, 0, 10, &gr, why, sizeof why) || gr.rc != 0 || !gr.out || gr.outn < 40) {
            np_free(&gr);
            return pd_refuse("git-rev-parse-head");
        }
        mm_copy(head_rev, sizeof head_rev, gr.out, 40);
        head_rev[40] = 0;
        np_free(&gr);
    }
    if (!cx_fmt(idp, sizeof idp, "%s/chain-run.identity", from_chain_dir) && sy_exists(idp) == 1) {
        cx_fmt(cdir, sizeof cdir, "%s", from_chain_dir);
    } else if (!cx_fmt(idp, sizeof idp, "%s/%s/chain-run.identity", from_chain_dir, head_rev) && sy_exists(idp) == 1) {
        cx_fmt(cdir, sizeof cdir, "%s/%s", from_chain_dir, head_rev);
    } else {
        cdir[0] = 0;
        sy_dir_t d;
        if (sy_dir_open(&d, from_chain_dir) == 0) {
            while (sy_dir_next(&d) == 1) {
                if (d.name[0] == '.') continue;
                if (!cx_fmt(idp, sizeof idp, "%s/%s/chain-run.identity", from_chain_dir, d.name) && sy_exists(idp) == 1) {
                    cx_fmt(cdir, sizeof cdir, "%s/%s", from_chain_dir, d.name);
                    break;
                }
            }
            sy_dir_close(&d);
        }
        if (!cdir[0] || cx_fmt(idp, sizeof idp, "%s/chain-run.identity", cdir))
            return pd_refuse("missing-chain-run-identity");
    }
    {
        unsigned char *ib = 0; int64_t in = 0;
        if (sy_read_file(idp, &ib, &in, 65536)) return pd_refuse("read-chain-run-identity");
        int64_t pos = 0;
        while (pos < in) {
            int64_t ls = pos;
            while (pos < in && ib[pos] != '\n') pos++;
            int64_t le = pos;
            if (pos < in) pos++;
            if (le > ls && ib[le - 1] == '\r') le--;
            if (le - ls > 4 && !memcmp(ib + ls, "rev=", 4)) {
                size_t rl = (size_t)(le - (ls + 4));
                if (rl < sizeof chain_rev) {
                    mm_copy(chain_rev, sizeof chain_rev, (const char *)ib + ls + 4, rl);
                    chain_rev[rl] = 0;
                }
            }
        }
        mm_free(ib);
    }
    if (strlen(chain_rev) != 40) return pd_refuse("invalid-chain-rev");
    if (strcmp(chain_rev, head_rev) != 0) return pd_refuse("candidate-rev-mismatch");
    if (pd_load_repo_batch_meta(root, chain_rev)) return 2;
    if (cx_fmt(ape_path, sizeof ape_path, "%s/ape-final/unisacc-next.com", cdir) || sy_exists(ape_path) != 1)
        return pd_refuse("missing-candidate-ape");
    {
        unsigned char *ab = 0; int64_t an = 0;
        if (sy_read_file(ape_path, &ab, &an, 256 << 20) || sy_sha256_hex(ab, an, ape_sha)) {
            if (ab) mm_free(ab);
            return pd_refuse("hash-candidate-ape");
        }
        mm_free(ab);
    }
    if (ver_arg && ver_arg[0]) {
        cx_fmt(ver, sizeof ver, "%s", ver_arg);
    } else {
        char *vv[] = {"sh", ape_path, "--version", 0};
        np_result vr = {0};
        if (!np_run(vv, 0, 0, 15, &vr, why, sizeof why) && vr.rc == 0 && vr.out && vr.outn > 8) {
            const char *p = vr.out;
            if (!strncmp(p, "unisacc ", 8)) p += 8;
            size_t vl = 0;
            while (p[vl] && p[vl] != '\n' && p[vl] != '\r' && p[vl] != ' ' && vl + 1 < sizeof ver) {
                ver[vl] = p[vl]; vl++;
            }
            ver[vl] = 0;
        }
        np_free(&vr);
    }
    if (!pd_archive_version(ver)) return pd_refuse("prepare-invalid-version");
    if (out_arg && out_arg[0]) {
        cx_fmt(out_dir, sizeof out_dir, "%s", out_arg);
    } else {
        const char *td = sy_tmpdir();
        const char *btd = (td && td[0] == '/') ? td : "/tmp";
        if (cx_fmt(out_dir, sizeof out_dir, "%s/unisacc-session-v%s-prerun-%.10s", btd, ver, chain_rev))
            return pd_refuse("out-dir-bound");
    }
    pd_mkdirs(out_dir);

    char latest_strict[PD_PW] = {0}, ids_path[PD_PW] = {0}, times_path[PD_PW] = {0}, prio_path[PD_PW] = {0};
    pd_find_latest_strict(root, ver, latest_strict, sizeof latest_strict);
    if (!latest_strict[0]) pd_find_latest_strict(root, "", latest_strict, sizeof latest_strict);

    if (heavy_f && pd_load_heavy_file(heavy_f)) return pd_refuse("read-heavy-file");
    /* Independent runnable count derived directly from freeze rev's tests/batches.tsv (separate from writer loop). */
    int expected_runnable = 0;
    {
        unsigned char *fb = 0; int64_t fn = 0;
        if (pd_git_show_rev(root, chain_rev, "tests/batches.tsv", &fb, &fn))
            return pd_refuse("read-freeze-rev-batches-for-count");
        int64_t pos = 0;
        while (pos < fn) {
            int64_t ls = pos;
            while (pos < fn && fb[pos] != '\n') pos++;
            int64_t le = pos;
            if (pos < fn) pos++;
            if (le > ls && fb[le - 1] == '\r') le--;
            if (le <= ls || fb[ls] == '#') continue;
            long o0 = 0, l0 = 0, o1 = 0, l1 = 0, o5 = 0, l5 = 0;
            if (!tx_field((const char *)fb + ls, (long)(le - ls), '\t', 0, &o0, &l0) && l0 > 0 && l0 < 95 &&
                !tx_field((const char *)fb + ls, (long)(le - ls), '\t', 1, &o1, &l1) && l1 == 11 &&
                tx_same((const char *)fb + ls + o1, l1, "IMPLEMENTED", 11) &&
                !tx_field((const char *)fb + ls, (long)(le - ls), '\t', 5, &o5, &l5)) {
                char bid[96];
                mm_copy(bid, sizeof bid, (const char *)fb + ls + o0, (size_t)l0);
                bid[l0] = 0;
                int is_foreign = (l5 > 0 && !(l5 == 10 && tx_same((const char *)fb + ls + o5, l5, "lnx/x86_64", 10)) &&
                                  !(l5 == 3 && tx_same((const char *)fb + ls + o5, l5, "all", 3)) &&
                                  !(l5 == 1 && fb[ls + o5] == '-'));
                if (!is_foreign && !pd_is_split_p(bid, (size_t)l0) && pd_in_pq(bid)) expected_runnable++;
            }
        }
        mm_free(fb);
    }
    if (expected_runnable <= 0) return pd_refuse("empty-expected-runnable");
    if (ids_arg && ids_arg[0]) {
        cx_fmt(ids_path, sizeof ids_path, "%s", ids_arg);
        if (pd_load_ids(ids_path)) return pd_refuse("read-ids-file");
        if (pd_nids != expected_runnable) return pd_refuse("explicit-ids-mismatch-freeze-rev");
        for (int i = 0; i < pd_nids; i++) {
            if (!pd_in_pq(pd_ids[i].id)) return pd_refuse("explicit-ids-mismatch-freeze-rev");
        }
    } else {
        if (cx_fmt(ids_path, sizeof ids_path, "%s/ids.txt", out_dir)) return pd_refuse("ids-path-bound");
        /* Always compute runnable ids fresh from the freeze rev's registered batches (no reuse of old ids.txt). */
        size_t cap = 65536, bp = 0;
        char *ibuf = (char *)mm_alloc(cap);
        if (!ibuf) return pd_refuse("oom");
        for (int i = 0; i < pd_npq; i++) {
            const char *id = pd_pq_ids[i];
            size_t l = strlen(id);
            if (pd_is_split_p(id, l)) continue;
            PdBMeta *m = pd_find_bmeta(id, l);
            if (m && (m->planned || m->foreign)) continue;
            if (bp + l + 2 >= cap) { mm_free(ibuf); return pd_refuse("ids-buffer-bound"); }
            mm_copy(ibuf + bp, cap - bp, id, l);
            bp += l;
            ibuf[bp++] = '\n';
        }
        if (sy_write_file(ids_path, ibuf, (int64_t)bp, 0644) != 0) {
            mm_free(ibuf);
            return pd_refuse("write-ids-failed");
        }
        mm_free(ibuf);
        if (pd_load_ids(ids_path) || pd_nids <= 0) return pd_refuse("empty-prepared-ids");
        if (pd_nids != expected_runnable) return pd_refuse("ids-count-mismatch");
        printf("PRERUN_IDS_COMPUTED\trev=%s\tcount=%d\texpected=%d\n", chain_rev, pd_nids, expected_runnable);
    }

    int bad_planned = 0, bad_foreign = 0;
    for (int i = 0; i < pd_nids; i++) {
        PdBMeta *m = pd_find_bmeta(pd_ids[i].id, strlen(pd_ids[i].id));
        if (m) {
            if (m->planned) bad_planned++;
            if (m->foreign) bad_foreign++;
        }
    }
    if (bad_planned > 0 || bad_foreign > 0)
        return pd_refuse("ids-contains-planned-or-foreign-platform");

    int excl_total = 0, excl_planned = 0, excl_foreign = 0, excl_stale = 0, extra_non_pq = 0;
    for (int i = 0; i < pd_npq; i++) {
        const char *id = pd_pq_ids[i];
        size_t l = strlen(id);
        if (pd_find_id(id, l) < 0) {
            excl_total++;
            PdBMeta *m = pd_find_bmeta(id, l);
            if (m && m->planned) excl_planned++;
            else if (m && m->foreign) excl_foreign++;
            else excl_stale++;
        }
    }
    for (int i = 0; i < pd_nids; i++) {
        if (!pd_in_pq(pd_ids[i].id)) extra_non_pq++;
    }

    if (times_arg && times_arg[0]) {
        cx_fmt(times_path, sizeof times_path, "%s", times_arg);
    } else {
        const char *hm = sy_env("HOME");
        if (hm && hm[0] == '/' && !cx_fmt(times_path, sizeof times_path, "%s/.cache/unisacc/batch-times.tsv", hm) && sy_exists(times_path) == 1) {
            /* use home cache */
        } else if (latest_strict[0] && sy_exists(latest_strict) == 1) {
            cx_fmt(times_path, sizeof times_path, "%s", latest_strict);
        } else if (!cx_fmt(times_path, sizeof times_path, "%s/build/phase-times.tsv", root) && sy_exists(times_path) == 1) {
            /* use repo build/phase-times.tsv */
        } else {
            times_path[0] = 0;
        }
    }
    if (times_path[0]) (void)pd_load_times_file(times_path);

    if (prio_arg && prio_arg[0]) {
        cx_fmt(prio_path, sizeof prio_path, "%s", prio_arg);
    } else if (latest_strict[0]) {
        cx_fmt(prio_path, sizeof prio_path, "%s", latest_strict);
    } else if (!cx_fmt(prio_path, sizeof prio_path, "%s/tests/commit-tier-selection.tsv", root) && sy_exists(prio_path) == 1) {
        /* use commit-tier-selection.tsv */
    } else {
        prio_path[0] = 0;
    }
    if (prio_path[0]) (void)pd_load_priority_file(prio_path);

    if (warmup < 0) warmup = pd_has_times ? 1 : 4;
    if (pd_build_plan(win_sz, warmup, out_dir)) return 2;

    char envp[PD_PW], envb[8192];
    if (cx_fmt(envp, sizeof envp, "%s/prerun-env.tsv", out_dir) ||
        cx_fmt(envb, sizeof envb,
            "version\t%s\n"
            "root\t%s\n"
            "chain_dir\t%s\n"
            "rev\t%s\n"
            "candidate\t%s\n"
            "ape_sha256\t%s\n"
            "ids_file\t%s\n"
            "times_file\t%s\n"
            "priority_file\t%s\n"
            "prerun_dir\t%s\n"
            "ids_count\t%d\n"
            "dvqualify_list_count\t%d\n"
            "excluded_total\t%d\n"
            "excluded_planned\t%d\n"
            "excluded_foreign_platform\t%d\n"
            "excluded_stale\t%d\n"
            "extra_non_pq\t%d\n"
            "normal_jobs\t%d\n"
            "keep_going\t%d\n"
            "total_windows\t%d\n",
            ver, root, cdir, chain_rev, ape_path, ape_sha,
            ids_path, times_path[0] ? times_path : "-", prio_path[0] ? prio_path : "-",
            out_dir, pd_nids, pd_npq, excl_total, excl_planned, excl_foreign, excl_stale,
            extra_non_pq, pd_normal_jobs, pd_keep_going ? 1 : 0, pd_nwins))
        return pd_refuse("prerun-env-fmt");
    if (sy_write_file(envp, envb, (int64_t)strlen(envb), 0644))
        return pd_refuse("write-prerun-env");

    printf("PRERUN_PREPARE\tversion=%s\trev=%s\tape_sha256=%s\tids=%d\tdvqualify_list=%d\texcluded_planned=%d\texcluded_foreign_platform=%d\texcluded_stale=%d\twindows=%d\tout=%s\n",
           ver, chain_rev, ape_sha, pd_nids, pd_npq, excl_planned, excl_foreign, excl_stale, pd_nwins, out_dir);
    return 0;
}

static int pd_is_hex40(const char *s) {
    if (!s) return 0;
    for (int i = 0; i < 40; i++) {
        char c = s[i];
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return 0;
    }
    return s[40] == 0;
}

static int pd_git_is_commit(const char *repo, const char *rev) {
    char *av[] = {"git", "-C", (char *)repo, "cat-file", "-t", (char *)rev, 0};
    char *out = 0; size_t on = 0;
    if (!pd_is_hex40(rev)) return 0;
    if (cx_runv_timeout(av, 10, &out, &on) != 0 || !out) { free(out); return 0; }
    int ok = (on >= 6 && !strncmp(out, "commit", 6));
    free(out);
    return ok;
}

static int pd_rebase_cmp(const void *a, const void *b) { return strcmp((const char *)a, (const char *)b); }

/* A window can finish only part of its plan. Bind each completed row to the
 * segment's source and the candidate bytes before using it for a rebase. */
static int pd_rebase_evidence(const char *dir, const char *rev, const char *sha, const char *stamp_base) {
    sy_dir_t d;
    static char files[PD_MAX_FILES][256];
    int nf = 0, next;
    if (sy_dir_open(&d, dir)) return pd_refuse("rebase-evidence-dir");
    while ((next = sy_dir_next(&d)) == 1) {
        if (strncmp(d.name, "strict-W", 8) || d.name_n < 13 || strcmp(d.name + d.name_n - 4, ".tsv")) continue;
        if (nf == PD_MAX_FILES || cx_fmt(files[nf], sizeof files[0], "%s", d.name)) {
            sy_dir_close(&d); return pd_refuse("rebase-evidence-limit");
        }
        nf++;
    }
    sy_dir_close(&d);
    if (next < 0) return pd_refuse("rebase-evidence-dir");
    qsort(files, nf, sizeof files[0], pd_rebase_cmp);
    pd_nstates = 0;
    char source[64], digest[80], row_identity[80];
    cx_fmt(source, sizeof source, "# source=%s", rev);
    cx_fmt(digest, sizeof digest, " ape_sha256=%s", sha);
    cx_fmt(row_identity, sizeof row_identity, "\tPASS\t0\t%s\t", sha);
    for (int fi = 0; fi < nf; fi++) {
        char path[PD_PW]; size_t n = 0;
        if (cx_fmt(path, sizeof path, "%s/%s", dir, files[fi])) return pd_refuse("rebase-strict-path");
        char *bytes = cx_read(path, &n);
        if (!bytes) return pd_refuse("rebase-strict-read");
        int bound = 0, had_bound = 0;
        for (char *p = bytes; *p; ) {
            char *end = strchr(p, '\n');
            if (end) *end = 0;
            if (!strncmp(p, "# source=", 9)) {
                size_t k = strlen(source);
                char *ape = strstr(p, digest);
                bound = !strncmp(p, source, k) && (p[k] == ' ' || !p[k]) &&
                    ape && (!ape[strlen(digest)] || ape[strlen(digest)] == ' ');
                if (bound) had_bound = 1;
            } else if (p[0] && p[0] != '#' && strncmp(p, "RAW\t", 4) &&
                       strncmp(p, "SUMMARY\t", 8) && strncmp(p, "batch\t", 6)) {
                char *tab = strchr(p, '\t');
                if (tab && tab > p && tab-p < 127) {
                    char *status = strchr(tab+1, '\t');
                    *tab = 0;
                    int idx = pd_state_find(p);
                    *tab = '\t';
                    if (idx < 0) { free(bytes); return pd_refuse("rebase-evidence-limit"); }
                    pd_states[idx].seen = 1;
                    cx_fmt(pd_states[idx].status, sizeof pd_states[idx].status, "%s",
                           bound && status && !strncmp(status, row_identity, strlen(row_identity)) ? "PASS" : "RERUN");
                }
            }
            if (!end) break;
            *end = '\n'; p = end + 1;
        }
        if (stamp_base) {
            char *header = strstr(bytes, source);
            size_t k = header ? (size_t)(header - bytes) + strlen(source) : 0;
            char base[64]; cx_fmt(base, sizeof base, " base=%s", stamp_base);
            size_t extra = strlen(base);
            char *stamped = malloc(n + extra + 1);
            if (!had_bound || !k || !stamped) { free(bytes); free(stamped); return pd_refuse("rebase-stamp-provenance"); }
            if (mm_copy(stamped, n+extra+1, bytes, k) ||
                mm_copy(stamped+k, n+extra+1-k, base, extra) ||
                mm_copy(stamped+k+extra, n+1-k, bytes+k, n-k)) {
                free(stamped); free(bytes); return pd_refuse("rebase-stamp-bound");
            }
            int err = sy_write_atomic(path, stamped, n+extra, 0644);
            free(stamped);
            if (err) { free(bytes); return pd_refuse("rebase-stamp-provenance"); }
        }
        free(bytes);
    }
    return 0;
}

static int pd_rebase_window_ids(const char *dir, const char *expected) {
    char p[PD_PW]; unsigned char *b = 0; int64_t n = 0, offset = 0;
    if (cx_fmt(p, sizeof p, "%s/windows.tsv", dir) || sy_read_file(p, &b, &n, 4 << 20)) return -1;
    PdWindow w; int rc;
    pd_nids = 0;
    while ((rc = pd_next_window(b, n, &offset, dir, &w)) == 1) {
        if (!strcmp(w.phase, "prebuild-self")) continue;
        char *id = w.ids;
        while (id && *id) {
            char *next = strchr(id, ',');
            if (next) *next++ = 0;
            if (pd_nids >= PD_MAX_IDS || !*id || strlen(id) >= sizeof pd_ids[0].id) { rc = -1; break; }
            for (int i = 0; i < pd_nids; i++) if (!strcmp(id, pd_ids[i].id)) { rc = -1; break; }
            if (rc < 0) break;
            cx_fmt(pd_ids[pd_nids++].id, sizeof pd_ids[0].id, "%s", id);
            id = next;
        }
        if (rc < 0) break;
    }
    mm_free(b);
    char count[32]; cx_fmt(count, sizeof count, "%d", pd_nids);
    return rc || !pd_nids || strcmp(expected, count) ? -1 : 0;
}

static int pd_rebase_guard(const char *repo, const char *from, const char *to, const char *chain,
                           char **changes, int nchanges) {
    char path[PD_PW], revline[64], why[512] = {0}, hit[PD_PW] = {0}; size_t n;
    if (cx_fmt(path, sizeof path, "%s/chain-run.identity", chain)) return pd_refuse("chain-identity-path");
    char *identity = cx_read(path, &n);
    if (!identity) return pd_refuse("missing-chain-run-identity");
    int tools = 0, rev_ok = 0;
    cx_fmt(revline, sizeof revline, "rev=%s", from);
    for (char *p = identity; p && *p;) {
        char *next = strchr(p, '\n'); if (next) *next++ = 0;
        if (!strncmp(p,"rev=",4)) {
            if (strcmp(p,revline) || rev_ok) { free(identity); return pd_refuse("chain-rev-mismatch"); }
            rev_ok = 1;
        }
        if (!strncmp(p, "tool_blob=", 10)) {
            char *tool = p+10, *sep = strrchr(tool, ':');
            if (!sep || sep == tool || strlen(sep+1) != 64 || strspn(sep+1, "0123456789abcdef") != 64) {
                free(identity); return pd_refuse("invalid-chain-tool-list");
            }
            *sep = 0; tools++;
            for (int i = 0; i < nchanges; i++) if (!strcmp(changes[i], tool)) {
                fprintf(stderr, "PRERUN_REBASE_INTERSECTION\tpath=%s\n", tool);
                free(identity); return pd_refuse("chain-tool-changed");
            }
        }
        p = next;
    }
    free(identity);
    if (!rev_ok || !tools) return pd_refuse("incomplete-chain-identity");
    char *ancestor[] = {"git", "-C", (char *)repo, "merge-base", "--is-ancestor", (char *)from, (char *)to, 0};
    char *msg = 0; size_t m = 0; int rc = cx_runv_timeout(ancestor, 10, &msg, &m); free(msg);
    if (rc) return pd_refuse("rebase-target-not-descendant");
    int64_t hits = 0, other = 0;
    if (pik1_rev_delta(repo, from, to, &hits, &other, hit, sizeof hit, why, sizeof why)) {
        fprintf(stderr, "PRERUN_REBASE_SID\tdetail=%s\n", why);
        return pd_refuse("sources-sid-unverified");
    }
    if (hits) {
        fprintf(stderr, "PRERUN_REBASE_INTERSECTION\tpath=%s\n", hit);
        return pd_refuse("sources-sid-changed");
    }
    return 0;
}

static int pd_cmd_rebase_rev_plan(const char *from_dir, const char *from_rev_arg, const char *to_rev,
                                  const char *root_arg, const char *out_dir, int plan_mode) {
    char from_rev[64] = {0}, repo[PD_PW] = {0};
    const int execute = plan_mode == 2;
    char sha[65] = {0}, candidate[PD_PW], chain[PD_PW], count[32], frozen[PD_PW] = {0};
    if (!plan_mode) return pd_refuse("rebase-rev-requires-plan-or-execute");
    if (!from_dir || !from_dir[0] || !to_rev || !to_rev[0]) return pd_refuse("rebase-rev-requires-from-dir-and-to-rev");
    { sy_stat_t st; if (sy_stat(from_dir, &st) || st.kind != 'd') return pd_refuse("missing-from-dir"); }
    if (!root_arg || !root_arg[0]) root_arg = ".";
    if (sy_realpath(root_arg, repo, sizeof repo) < 0) return pd_refuse("bad-root");
    if (!pd_git_is_commit(repo, to_rev)) return pd_refuse("invalid-to-rev");
    if (out_dir && out_dir[0]) {
        char src[PD_PW], resolved[PD_PW], ancestor[PD_PW];
        if (sy_realpath(from_dir, src, sizeof src) < 0 || cx_fmt(ancestor, sizeof ancestor, "%s", out_dir))
            return pd_refuse("rebase-output-path");
        int rc;
        while ((rc = sy_realpath(ancestor, resolved, sizeof resolved)) < 0) {
            if (rc != -ENOENT) return pd_refuse("rebase-output-path");
            char *sep = strrchr(ancestor, '/');
            if (!strcmp(sep ? sep+1 : ancestor, "..")) return pd_refuse("rebase-output-path");
            if (!sep) { ancestor[0] = '.'; ancestor[1] = 0; }
            else if (sep == ancestor) ancestor[1] = 0;
            else *sep = 0;
        }
        size_t n = strlen(src);
        if (!strncmp(src, resolved, n) && (!resolved[n] || resolved[n]=='/')) return pd_refuse("out-dir-inside-from-dir");
    }
    char env_path[PD_PW];
    if (cx_fmt(env_path, sizeof env_path, "%s/prerun-env.tsv", from_dir)) return pd_refuse("rebase-env-path");
    int env_exists = sy_exists(env_path);
    int prepared = pd_env_lookup(from_dir, "rev", from_rev, sizeof from_rev);
    if (env_exists < 0 || (env_exists && !prepared)) return pd_refuse("invalid-prerun-env");
    if (prepared) {
        if (from_rev_arg && strcmp(from_rev_arg, from_rev)) return pd_refuse("base-rev-mismatch");
        if (!pd_env_lookup(from_dir, "ape_sha256", sha, sizeof sha) || strlen(sha) != 64 ||
            strspn(sha, "0123456789abcdef") != 64 || pd_scout_state(from_dir) != 0) return pd_refuse("invalid-prerun-evidence");
    } else if (execute) return pd_refuse("execute-requires-prerun-env");
    else if (from_rev_arg && from_rev_arg[0]) {
        cx_fmt(from_rev, sizeof from_rev, "%s", from_rev_arg);
    } else {
        char ep[PD_PW]; size_t en = 0; char *eb = 0;
        if (cx_fmt(ep, sizeof ep, "%s/env.tsv", from_dir)) return pd_refuse("path-too-long");
        eb = cx_read(ep, &en);
        if (!eb) return pd_refuse("missing-from-rev-and-env-tsv");
        for (size_t i = 0; i < en; ) {
            size_t j = i; while (j < en && eb[j] != '\n') j++;
            if (j - i > 4 && !strncmp(eb + i, "rev\t", 4)) {
                size_t vl = j - i - 4; if (vl > 40) vl = 40;
                mm_copy(from_rev, sizeof from_rev, eb + i + 4, vl); from_rev[vl] = 0;
                break;
            }
            i = j + 1;
        }
        free(eb);
    }
    if (!pd_git_is_commit(repo, from_rev)) return pd_refuse("invalid-from-rev");

    char ids_p[PD_PW];
    if (cx_fmt(ids_p, sizeof ids_p, "%s/ids.txt", from_dir)) return pd_refuse("path-too-long");
    if (prepared) {
        if (!pd_env_lookup(from_dir, "ids_count", count, sizeof count) || pd_rebase_window_ids(from_dir, count))
            return pd_refuse("rebase-window-ids");
        if (pd_rebase_evidence(from_dir, from_rev, sha, 0)) return 2;
    } else if (pd_load_ids(ids_p)) return pd_refuse("read-ids-file");

    static char pass_ids[4096][128]; int npass = 0;
    { char pp[PD_PW]; size_t pn = 0; char *pb = 0;
      if (!prepared && !cx_fmt(pp, sizeof pp, "%s/pass.ids", from_dir) && (pb = cx_read(pp, &pn)) != 0) {
          for (size_t i = 0; i < pn && npass < 4096; ) {
              size_t j = i; while (j < pn && pb[j] != '\n' && pb[j] != '\r') j++;
              if (j > i && j - i < 128) {
                  mm_copy(pass_ids[npass], 128, pb + i, j - i);
                  pass_ids[npass][j - i] = 0;
                  npass++;
              }
              while (j < pn && (pb[j] == '\n' || pb[j] == '\r')) j++;
              i = j;
          }
          free(pb);
      }
    }

    char range[128]; cx_fmt(range, sizeof range, "%s..%s", from_rev, to_rev);
    char *dv[] = {"git", "-C", repo, "diff", "--name-status", "--no-renames", range, 0};
    char *dout = 0; size_t dlen = 0;
    if (cx_runv_timeout(dv, 20, &dout, &dlen) != 0) { free(dout); return pd_refuse("git-diff-failed"); }
    char *cfiles[256]; int ncf = 0, total_cf = 0, conservative = 0;
    if (dout) {
        for (size_t i = 0; i < dlen; ) {
            size_t j = i; while (j < dlen && dout[j] != '\n') j++;
            if (j > i) {
                total_cf++;
                if (dout[i] == 'D') conservative = 1;
                size_t tab = i; while (tab < j && dout[tab] != '\t') tab++;
                if (tab + 1 < j && ncf < 256) { dout[j] = 0; cfiles[ncf++] = dout + tab + 1; }
                else { conservative = 1; }
            }
            i = j + 1;
        }
    }

    if (execute) {
        if (ncf != total_cf) { free(dout); return pd_refuse("changed-files-unverified"); }
        for (int i = 0; i < ncf; i++) if (cfiles[i][0] == '"') { free(dout); return pd_refuse("quoted-path-unverified"); }
        char actual[65], full_candidate[PD_PW];
        if (!pd_env_lookup(from_dir, "chain_dir", chain, sizeof chain) ||
            !pd_env_lookup(from_dir, "candidate", candidate, sizeof candidate) ||
            cx_fmt(full_candidate, sizeof full_candidate, "%s/ape-final/unisacc-next.com", chain) ||
            strcmp(candidate, full_candidate) || pd_file_sha256_hex(candidate, actual) || strcmp(actual, sha)) {
            free(dout); return pd_refuse("rebase-candidate-mismatch");
        }
        if (pd_rebase_guard(repo, from_rev, to_rev, chain, cfiles, ncf)) { free(dout); return 2; }
        char p[PD_PW], line[64], expected[64];
        if (!out_dir || sy_mkdir(out_dir, 0700)) { free(dout); return pd_refuse("execute-requires-new-output"); }
        if (cx_fmt(p, sizeof p, "%s/frozen-source.rev", out_dir) || cx_fmt(line, sizeof line, "%s\n", to_rev) ||
            sy_write_file(p, line, strlen(line), 0644) ||
            pd_freeze_source_root(repo, out_dir, frozen, sizeof frozen, expected, sizeof expected) || strcmp(expected, to_rev)) {
            free(dout); return pd_refuse("rebase-target-freeze");
        }
    }
    static char aff_ids[4096][128]; int naff = 0;
    if (!conservative && ncf > 0) {
        char *av[276]; int k = 0; char uc[PD_PW], tmp[PD_PW] = {0};
        if (prepared && !execute) {
            char p[PD_PW], line[64], check[64];
            if (sy_mkdtemp(sy_tmpdir(), "rebase-plan-", tmp, sizeof tmp) ||
                cx_fmt(p, sizeof p, "%s/frozen-source.rev", tmp) || cx_fmt(line, sizeof line, "%s\n", to_rev) ||
                sy_write_file(p, line, strlen(line), 0644) ||
                pd_freeze_source_root(repo, tmp, frozen, sizeof frozen, check, sizeof check) || strcmp(check, to_rev)) {
                if (tmp[0]) sy_remove_all(tmp);
                free(dout); return pd_refuse("rebase-plan-target-freeze");
            }
        }
        cx_fmt(uc, sizeof uc, "%s/unisacc.com", repo);
        av[k++] = "sh"; av[k++] = "-c"; av[k++] = "cd \"$1\" && shift && exec \"$@\""; av[k++] = "_"; av[k++] = frozen[0] ? frozen : repo;
        av[k++] = "sh"; av[k++] = uc; av[k++] = "tools/affected.cx"; av[k++] = "--"; av[k++] = "--list-only"; av[k++] = "--files";
        for (int i = 0; i < ncf && k < 274; i++) av[k++] = cfiles[i];
        av[k] = 0;
        char *aout = 0; size_t alen = 0;
        int ar = cx_runv_timeout(av, 60, &aout, &alen);
        if (tmp[0] && sy_remove_all(tmp)) { free(aout); free(dout); return pd_refuse("rebase-plan-cleanup"); }
        if (ar || !aout || !strstr(aout, "AFFECTED_SUMMARY\t")) { free(aout); free(dout); return pd_refuse("affected-failed"); }
        if (strstr(aout, "unreadable")) conservative = 1;
        for (size_t i = 0; !conservative && i < alen && naff < 4096; ) {
            size_t j = i; while (j < alen && aout[j] != '\n') j++;
            if (j - i > 9 && !strncmp(aout + i, "AFFECTED\t", 9)) {
                size_t s = i + 9, e = s;
                while (e < j && aout[e] != '\t') e++;
                if (e > s && e - s < 128) {
                    mm_copy(aff_ids[naff], 128, aout + s, e - s);
                    aff_ids[naff][e - s] = 0;
                    naff++;
                }
            }
            i = j + 1;
        }
        free(aout);
    }
    free(dout);

    int n_reuse = 0, n_rerun = 0;
    FILE *pf = 0;
    if (out_dir && out_dir[0]) {
        char rf[PD_PW], ro[PD_PW], op[PD_PW];
        if (sy_realpath(from_dir, rf, sizeof rf) > 0 && sy_realpath(out_dir, ro, sizeof ro) > 0 && !strcmp(rf, ro)) {
            return pd_refuse("out-dir-equals-from-dir");
        }
        if (!strcmp(from_dir, out_dir)) return pd_refuse("out-dir-equals-from-dir");
        sy_mkdir_all(out_dir, 0755);
        if (cx_fmt(op, sizeof op, "%s/rebase-plan.tsv", out_dir) || !(pf = fopen(op, "w"))) {
            return pd_refuse("cannot-write-rebase-plan");
        }
        fprintf(pf, "batch\taction\n");
    }
    for (int i = 0; i < pd_nids; i++) {
        const char *id = pd_ids[i].id;
        int is_pass = 0, is_aff = conservative ? 1 : 0;
        if (prepared) {
            int idx = pd_state_find(id);
            is_pass = idx >= 0 && pd_states[idx].seen && !strcmp(pd_states[idx].status, "PASS");
        } else for (int j = 0; j < npass; j++) if (!strcmp(id, pass_ids[j])) { is_pass = 1; break; }
        for (int j = 0; !is_aff && j < naff; j++) if (!strcmp(id, aff_ids[j])) { is_aff = 1; break; }
        if (is_pass && !is_aff) {
            n_reuse++;
            if (pf) fprintf(pf, "%s\tREUSE\n", id);
        } else {
            if (pf) fprintf(pf, "%s\tRERUN\n", id);
            if (execute && n_rerun != i) pd_ids[n_rerun] = pd_ids[i];
            n_rerun++;
        }
    }
    if (pf && (ferror(pf) || fclose(pf))) return pd_refuse("write-rebase-plan");
    printf("PRERUN_REBASE_PLAN_UNCOVERED\titems=over-256-files-conservative-rerun,unregistered-batch\n");
    printf("PRERUN_REBASE_PLAN\tfrom_rev=%s\tto_rev=%s\tchanged_files=%d\treuse=%d\trerun=%d\tmode=%s\n",
           from_rev, to_rev, total_cf, n_reuse, n_rerun, execute ? "execute" : "plan");
    if (execute) {
        char launcher[PD_PW];
        if (cx_fmt(launcher, sizeof launcher, "%s/unisacc.com", frozen)) return pd_refuse("frozen-launcher-path");
        int present = sy_exists(launcher);
        if (present < 0 || (!present && sy_symlink(candidate, launcher))) return pd_refuse("frozen-launcher-unavailable");
        pd_nids = n_rerun;
        if (n_rerun) {
            if (pd_build_plan(8, 1, out_dir)) return pd_refuse("rebase-build-windows");
            pd_keep_going = 2;
            pd_rebase_run = 1;
            int rc = pd_cmd_run(repo, candidate, out_dir, 0, 8, 0, 2, 1, 0, 0);
            if (pd_rebase_evidence(out_dir, to_rev, sha, from_rev)) return 2;
            if (rc) return rc;
            for (int i = 0; i < pd_nids; i++) {
                int idx = pd_state_find(pd_ids[i].id);
                if (idx < 0 || !pd_states[idx].seen || strcmp(pd_states[idx].status, "PASS"))
                    return pd_refuse("rebase-rerun-not-pass");
            }
            char pending[PD_PW], done[PD_PW];
            if (cx_fmt(pending, sizeof pending, "%s/run.rebase-pending", out_dir) ||
                cx_fmt(done, sizeof done, "%s/run.done", out_dir) || sy_rename(pending, done)) return pd_refuse("rebase-completion-receipt");
        }
        printf("PRERUN_REBASE_EXECUTE\tsource=%s\tbase=%s\treuse=%d\trerun=%d\n", to_rev, from_rev, n_reuse, n_rerun);
    }
    return 0;
}

int main(int argc, char **argv) {
    if (argc < 2) return pd_refuse("usage: prepare|plan|run|merge|archive|replay|rebase-rev");
    const char *sub = argv[1];
    if (tx_eqz(sub, "rebase-rev") || tx_eqz(sub, "--rebase-rev")) {
        const char *from_d = 0, *from_r = 0, *to_r = 0, *root_d = 0, *out_d = 0;
        int plan_mode = 0;
        for (int i = 2; i < argc; i++) {
            if (tx_eqz(argv[i], "--from-dir") && i + 1 < argc) from_d = argv[++i];
            else if (tx_eqz(argv[i], "--from-rev") && i + 1 < argc) from_r = argv[++i];
            else if (tx_eqz(argv[i], "--to-rev") && i + 1 < argc) to_r = argv[++i];
            else if (tx_eqz(argv[i], "--root") && i + 1 < argc) root_d = argv[++i];
            else if ((tx_eqz(argv[i], "--out") || tx_eqz(argv[i], "--dir")) && i + 1 < argc) out_d = argv[++i];
            else if (tx_eqz(argv[i], "--plan") && !plan_mode) plan_mode = 1;
            else if (tx_eqz(argv[i], "--execute") && !plan_mode) plan_mode = 2;
            else return pd_refuse("unknown-rebase-rev-arg");
        }
        return pd_cmd_rebase_rev_plan(from_d, from_r, to_r, root_d, out_d, plan_mode);
    }
    if (tx_eqz(sub, "prepare")) {
        const char *chain_d = 0, *root_d = 0, *ver = 0, *out_d = 0, *ids_f = 0, *times_f = 0, *prio_f = 0, *heavy_f = 0;
        int win_sz = 10, warmup = -1;
        pd_keep_going = 1;
        pd_unmeasured_ms = PD_DEFAULT_UNMEASURED_MS;
        for (int i = 2; i < argc; i++) {
            if (tx_eqz(argv[i], "--from-chain-dir") && i + 1 < argc) chain_d = argv[++i];
            else if (tx_eqz(argv[i], "--root") && i + 1 < argc) root_d = argv[++i];
            else if (tx_eqz(argv[i], "--version") && i + 1 < argc) ver = argv[++i];
            else if ((tx_eqz(argv[i], "--out") || tx_eqz(argv[i], "--dir")) && i + 1 < argc) out_d = argv[++i];
            else if (tx_eqz(argv[i], "--ids-file") && i + 1 < argc) ids_f = argv[++i];
            else if (tx_eqz(argv[i], "--times-file") && i + 1 < argc) times_f = argv[++i];
            else if (tx_eqz(argv[i], "--priority-file") && i + 1 < argc) prio_f = argv[++i];
            else if (tx_eqz(argv[i], "--heavy-file") && i + 1 < argc) heavy_f = argv[++i];
            else if (tx_eqz(argv[i], "--normal-jobs") && i + 1 < argc) { pd_normal_jobs = atoi(argv[++i]); if (pd_normal_jobs < 1) pd_normal_jobs = 2; }
            else if (tx_eqz(argv[i], "--window-lanes") && i + 1 < argc) {
                pd_plan_lanes = pd_width(argv[++i], PD_MAX_LANES);
                if (!pd_plan_lanes) return pd_refuse("invalid-window-lanes");
            }
            else if (tx_eqz(argv[i], "--win-size") && i + 1 < argc) win_sz = atoi(argv[++i]);
            else if (tx_eqz(argv[i], "--warmup") && i + 1 < argc) warmup = atoi(argv[++i]);
            else if (tx_eqz(argv[i], "--max-wins") && i + 1 < argc) { pd_max_wins = atoi(argv[++i]); if (pd_max_wins <= 0) pd_max_wins = -1; }
            else if (tx_eqz(argv[i], "--unmeasured-ms") && i + 1 < argc) { pd_unmeasured_ms = atol(argv[++i]); if (pd_unmeasured_ms <= 0) pd_unmeasured_ms = -1; }
            else if (tx_eqz(argv[i], "--keep-going")) pd_keep_going = 2;
            else if (tx_eqz(argv[i], "--no-keep-going") || tx_eqz(argv[i], "--fail-fast-unknown")) pd_keep_going = 0;
            else return pd_refuse("unknown-prepare-arg");
        }
        return pd_cmd_prepare(chain_d, root_d, ver, out_d, ids_f, times_f, prio_f, heavy_f, win_sz, warmup);
    }
    if (tx_eqz(sub, "plan")) {
        const char *ids_f = 0, *out_d = 0, *heavy_f = 0, *times_f = 0, *prio_f = 0, *nb_f = 0;
        int win_sz = 10, warmup = -1;
        for (int i = 2; i < argc; i++) {
            if (tx_eqz(argv[i], "--ids-file") && i + 1 < argc) ids_f = argv[++i];
            else if (tx_eqz(argv[i], "--out") && i + 1 < argc) out_d = argv[++i];
            else if (tx_eqz(argv[i], "--heavy-file") && i + 1 < argc) heavy_f = argv[++i];
            else if (tx_eqz(argv[i], "--times-file") && i + 1 < argc) times_f = argv[++i];
            else if (tx_eqz(argv[i], "--priority-file") && i + 1 < argc) prio_f = argv[++i];
            else if (tx_eqz(argv[i], "--near-bound-file") && i + 1 < argc) nb_f = argv[++i];
            else if (tx_eqz(argv[i], "--normal-jobs") && i + 1 < argc) { pd_normal_jobs = atoi(argv[++i]); if (pd_normal_jobs < 1) pd_normal_jobs = 2; }
            else if (tx_eqz(argv[i], "--window-lanes") && i + 1 < argc) {
                pd_plan_lanes = pd_width(argv[++i], PD_MAX_LANES);
                if (!pd_plan_lanes) return pd_refuse("invalid-window-lanes");
            }
            else if (tx_eqz(argv[i], "--win-size") && i + 1 < argc) win_sz = atoi(argv[++i]);
            else if (tx_eqz(argv[i], "--warmup") && i + 1 < argc) warmup = atoi(argv[++i]);
            else if (tx_eqz(argv[i], "--max-wins") && i + 1 < argc) { pd_max_wins = atoi(argv[++i]); if (pd_max_wins <= 0) pd_max_wins = -1; }
            else if (tx_eqz(argv[i], "--unmeasured-ms") && i + 1 < argc) { pd_unmeasured_ms = atol(argv[++i]); if (pd_unmeasured_ms <= 0) pd_unmeasured_ms = -1; }
            else if (tx_eqz(argv[i], "--mutate-times-use-nonpass")) pd_mut_times_use_nonpass = 1;
            else return pd_refuse("unknown-plan-arg");
        }
        if (!ids_f || !ids_f[0] || !out_d || !out_d[0]) return pd_refuse("plan-requires-ids-file-and-out");
        if (heavy_f && pd_load_heavy_file(heavy_f)) return pd_refuse("read-heavy-file");
        if (pd_load_ids(ids_f)) return pd_refuse("read-ids-file");
        if (times_f && pd_load_times_file(times_f)) return pd_refuse("read-times-file");
        if (prio_f && pd_load_priority_file(prio_f)) return pd_refuse("read-priority-file");
        if (nb_f && pd_load_near_bound_file(nb_f)) return pd_refuse("read-near-bound-file");
        if (warmup < 0) warmup = pd_has_times ? 1 : 4;
        return pd_build_plan(win_sz, warmup, out_d);
    }
    if (tx_eqz(sub, "run")) {
        const char *root = 0, *cand = 0, *out_d = 0, *mock_r = 0;
        char env_root[PD_PW] = {0}, env_cand[PD_PW] = {0}, env_jobs[32] = {0}, env_kg[32] = {0}, real_root[PD_PW] = {0};
        int resume = 0, max_j = PD_DEFAULT_NORMAL_JOBS, has_max_j = 0, load_cap = 6, max_ret = 2, has_kg = 0, lanes = 0;
        unsigned long long min_free_bytes = 0;
        pd_keep_going = 1;
        for (int i = 2; i < argc; i++) {
            if (tx_eqz(argv[i], "--root") && i + 1 < argc) root = argv[++i];
            else if (tx_eqz(argv[i], "--candidate") && i + 1 < argc) cand = argv[++i];
            else if ((tx_eqz(argv[i], "--out") || tx_eqz(argv[i], "--dir")) && i + 1 < argc) out_d = argv[++i];
            else if (tx_eqz(argv[i], "--resume")) resume = 1;
            else if (tx_eqz(argv[i], "--max-jobs") && i + 1 < argc) { max_j = atoi(argv[++i]); has_max_j = 1; }
            else if (tx_eqz(argv[i], "--window-lanes") && i + 1 < argc) {
                lanes = pd_width(argv[++i], PD_MAX_LANES);
                if (!lanes) return pd_refuse("invalid-window-lanes");
            }
            else if (tx_eqz(argv[i], "--load-cap") && i + 1 < argc) { load_cap = atoi(argv[++i]); fprintf(stderr, "PRERUN_DEPRECATED\t--load-cap\tignored: load gates retired 2026-11-20, use --max-jobs\n"); }
            else if (tx_eqz(argv[i], "--max-retries") && i + 1 < argc) max_ret = atoi(argv[++i]);
            else if (tx_eqz(argv[i], "--min-free")) {
                if (i + 1 >= argc || pd_parse_min_free(argv[++i], &min_free_bytes) != 0)
                    return pd_refuse("invalid-min-free");
            }
            else if (tx_eqz(argv[i], "--mock-avail-mb")) {
                if (i + 1 >= argc) return pd_refuse("invalid-mock-avail-mb");
                const char *ms = argv[++i];
                if (tx_eqz(ms, "-1")) pd_mock_avail_mb = -1;
                else {
                    unsigned long long mv = 0;
                    if (tx_eqz(ms, "0")) pd_mock_avail_mb = 0;
                    else if (pd_parse_min_free(ms, &mv) != 0 || mv > 1000000000ULL) return pd_refuse("invalid-mock-avail-mb");
                    else pd_mock_avail_mb = (long)mv;
                }
            }
            else if (tx_eqz(argv[i], "--scout")) pd_scout = 1;
            else if (tx_eqz(argv[i], "--keep-going")) { pd_keep_going = 2; has_kg = 1; }
            else if (tx_eqz(argv[i], "--no-keep-going") || tx_eqz(argv[i], "--fail-fast-unknown")) { pd_keep_going = 0; has_kg = 1; }
            else if (tx_eqz(argv[i], "--mock-runner") && i + 1 < argc) mock_r = argv[++i];
            else return pd_refuse("unknown-run-arg");
        }
        if (pd_mock_avail_mb >= -1 && !mock_r) return pd_refuse("mock-avail-mb-requires-mock-runner");
        if (out_d) {
            if (!root && pd_env_lookup(out_d, "root", env_root, sizeof env_root)) root = env_root;
            if (!cand && pd_env_lookup(out_d, "candidate", env_cand, sizeof env_cand)) cand = env_cand;
            if (!has_max_j && pd_env_lookup(out_d, "normal_jobs", env_jobs, sizeof env_jobs) && atoi(env_jobs) > 0)
                max_j = atoi(env_jobs);
            if (!has_kg && pd_env_lookup(out_d, "keep_going", env_kg, sizeof env_kg))
                pd_keep_going = atoi(env_kg) ? 1 : 0;
        }
        if (!root) root = ".";
        if (sy_realpath(root, real_root, sizeof real_root) > 0 && real_root[0]) root = real_root;
        if (!out_d || (!cand && !mock_r)) return pd_refuse("run-requires-out-and-candidate");
        if (max_ret < 1 || max_ret > 3) return pd_refuse("invalid-max-retries");
        return pd_cmd_run(root, cand ? cand : "-", out_d, resume, max_j, load_cap, max_ret, lanes, mock_r, min_free_bytes);
    }
    if (tx_eqz(sub, "merge")) {
        const char *in_d = 0, *out_d = 0, *ver = 0;
        char env_ver[64] = {0};
        int used_dir = 0;
        for (int i = 2; i < argc; i++) {
            if (tx_eqz(argv[i], "--in-dir") && i + 1 < argc) in_d = argv[++i];
            else if (tx_eqz(argv[i], "--out") && i + 1 < argc) out_d = argv[++i];
            else if (tx_eqz(argv[i], "--dir") && i + 1 < argc) { in_d = argv[++i]; out_d = in_d; used_dir = 1; }
            else if (tx_eqz(argv[i], "--version") && i + 1 < argc) ver = argv[++i];
            else return pd_refuse("unknown-merge-arg");
        }
        if (!in_d || !out_d) return pd_refuse("merge-requires-in-dir-and-out");
        if (!ver && pd_env_lookup(in_d, "version", env_ver, sizeof env_ver)) ver = env_ver;
        if ((used_dir || env_ver[0]) && !pd_has_run_done(in_d)) return pd_refuse("run-not-done");
        return pd_cmd_merge(in_d, out_d, ver);
    }
    if (tx_eqz(sub, "archive")) {
        const char *in = 0, *repo = 0, *ver = 0;
        char env_ver[64] = {0}, env_root[PD_PW] = {0}, real_repo[PD_PW] = {0};
        for (int i = 2; i < argc; i++) {
            if ((tx_eqz(argv[i], "--in-dir") || tx_eqz(argv[i], "--dir")) && i + 1 < argc) in = argv[++i];
            else if (tx_eqz(argv[i], "--repo") && i + 1 < argc) repo = argv[++i];
            else if (tx_eqz(argv[i], "--version") && i + 1 < argc) ver = argv[++i];
            else return pd_refuse("unknown-archive-arg");
        }
        if (in) {
            if (!ver && pd_env_lookup(in, "version", env_ver, sizeof env_ver)) ver = env_ver;
            if (!repo && pd_env_lookup(in, "root", env_root, sizeof env_root)) repo = env_root;
        }
        if (!repo) repo = ".";
        if (sy_realpath(repo, real_repo, sizeof real_repo) > 0 && real_repo[0]) repo = real_repo;
        if (!in || !ver) return pd_refuse("archive-requires-in-dir-and-version");
        return pd_cmd_archive(in, repo, ver);
    }
    if (tx_eqz(sub, "g1-dry")) {
        const char *root = ".", *cand_t = 0, *strict_f = 0, *ef_f = 0, *eu_f = 0, *out_d = 0, *ver = "0.0.84";
        char real_root[PD_PW] = {0};
        for (int i = 2; i < argc; i++) {
            if (tx_eqz(argv[i], "--root") && i + 1 < argc) root = argv[++i];
            else if (tx_eqz(argv[i], "--candidate-tsv") && i + 1 < argc) cand_t = argv[++i];
            else if (tx_eqz(argv[i], "--strict") && i + 1 < argc) strict_f = argv[++i];
            else if (tx_eqz(argv[i], "--expected-fail") && i + 1 < argc) ef_f = argv[++i];
            else if (tx_eqz(argv[i], "--expected-unmeasured") && i + 1 < argc) eu_f = argv[++i];
            else if (tx_eqz(argv[i], "--out") && i + 1 < argc) out_d = argv[++i];
            else if (tx_eqz(argv[i], "--version") && i + 1 < argc) ver = argv[++i];
            else return pd_refuse("unknown-g1-dry-arg");
        }
        if (sy_realpath(root, real_root, sizeof real_root) > 0 && real_root[0]) root = real_root;
        if (!cand_t || !strict_f || !ef_f || !eu_f || !out_d) return pd_refuse("g1-dry-missing-args");
        return pd_cmd_g1_dry(root, cand_t, strict_f, ef_f, eu_f, out_d, ver);
    }
    if (tx_eqz(sub, "replay")) {
        const char *ids_f = 0, *ev_d = 0, *out_d = 0, *exp_s = 0, *exp_g = 0;
        for (int i = 2; i < argc; i++) {
            if (tx_eqz(argv[i], "--ids-file") && i + 1 < argc) ids_f = argv[++i];
            else if (tx_eqz(argv[i], "--evidence-dir") && i + 1 < argc) ev_d = argv[++i];
            else if (tx_eqz(argv[i], "--out") && i + 1 < argc) out_d = argv[++i];
            else if (tx_eqz(argv[i], "--expected-strict") && i + 1 < argc) exp_s = argv[++i];
            else if (tx_eqz(argv[i], "--expected-g1dry") && i + 1 < argc) exp_g = argv[++i];
            else return pd_refuse("unknown-replay-arg");
        }
        if (!ids_f || !ev_d || !out_d) return pd_refuse("replay-requires-ids-file-evidence-dir-and-out");
        return pd_cmd_replay(ids_f, ev_d, out_d, exp_s, exp_g);
    }
    return pd_refuse("unknown-subcommand");
}
