/* tools/ratchets.cx -- run sixteen repo ratchets and show only what is wrong.
 *
 *   sh ./unisacc.com tools/ratchets.cx [-- --only PATH-PREFIX]
 *
 * Starts tests/cxraw.cx, tests/cxinclude.cx, tests/cxapis.cx, tests/cxtrunc.cx, tests/cxlibc.cx, tests/cxplatform.cx
 * (platform #if branches and raw syscalls outside L0), tests/srcshape.cx (src/ lines, longest block and `if`
 * count only go down), tests/coreapi.cx (the core modules' exported names and signatures only go down),
 * verwriter, aluiwidth, outdep, check-literal, net-deps (gate 14) and notcovered (the 14th ratchet:
 * tools/notcovered-census.cx --check, distinct "not covered:" refusal texts under exec/ only go down,
 * base tests/notcovered.tsv) and dup-census (the 15th: tools/dup-census.cx --check, byte-identical static
 * function groups in tools/ and tools/cxlib/ and their redundant lines only go down, base
 * build/dup-census-baseline.tsv) and no-home-path (the 16th: tools/no-home-path.cx --check, lines with an
 * absolute home path that leaks a system user name only go down, base build/no-home-path-baseline.tsv) and
 * ref-job-paths (the 17th: tools/ref-job-paths.cx --check, references to private job scratch files in plans/ and
 * prd_mempalace.md only go down, exempt rows expire, base build/ref-job-paths-baseline.tsv).
 * Tool line counts are reports, not ratchets.
 * with --check in parallel
 * (each under tools/bound 55) and prints, per ratchet, one line
 *   RATCHET<TAB>name<TAB>ok|FAIL|ERROR<TAB>its summary line
 * followed by the rows that make it fail (a row naming a file above its baseline, a row naming a whole-tree
 * total above its baseline, or a file with no row), but not the
 * "stale row" or "below baseline" notes.  With --only PREFIX, only offending rows whose file starts with PREFIX
 * are printed (the status still covers the whole tree).  Ends with RATCHETS<TAB>ok=N<TAB>fail=M<TAB>elapsed_ms=T
 * and exits 0 only when all nine are ok.  One call instead of nine serial ones (about 5 x 10 s, plus each
 * symindex query: cxlibc's and coreapi's twenty-six dumps). */
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use sys.env

#define NRK 18
typedef struct { const char *name; int pid, ofd, efd; char *out; long n; int rc; } Rk;

static void slurp(int fd, char **buf, long *n) {
    long cap = 1 << 16, r; char *b = mm_alloc(cap);
    *n = 0;
    while (b && (r = sy_read(fd, b + *n, cap - 1 - *n)) > 0) {
        *n += r;
        if (*n + 1 >= cap) { char *g = mm_grow(b, cap * 2); if (!g) break; b = g; cap *= 2; }
    }
    if (b) b[*n] = 0;
    *buf = b;
}

static long rk_rfind(const char *s, long n, const char *needle, long nl) {
    long pos = -1, at = 0;
    if (nl <= 0 || n < nl) return -1;
    while (at <= n - nl) {
        long f = tx_find(s + at, n - at, needle, nl);
        if (f < 0) break;
        pos = at + f;
        at = pos + 1;
    }
    return pos;
}

/* 1 when LINE (len n) names a failing file or a whole-tree overflow:
 * extracts the offending path/scope span [*ps, *pe) by format delimiter (TAB or EOL for CORE-*, TAB for FAIL\t,
 * rightmost phrase boundary for verwriter/outdep/cx-wildcard-product/" has "/" total lines "/" baseline "),
 * so paths containing spaces or " has " are not truncated and prefix substrings do not false-match. */
static int offending_span(const char *l, long n, long *ps, long *pe, int *softp) {
    long c, s = -1, t, w, e;
    int is_core = 0;
    if (softp) *softp = 0;
    if (n > 0 && l[n - 1] == '\r') n--;
    if (tx_prefix(l, n, "CORE-NEW ", 9) || tx_prefix(l, n, "CORE-SIG ", 9)) { s = 9; is_core = 1; }
    else if (tx_prefix(l, n, "CORE-MISSING ", 13)) { s = 13; is_core = 1; }
    else if (tx_prefix(l, n, "CORE-ALIAS-CALLERS ", 19)) { s = 19; is_core = 1; }
    else if (tx_prefix(l, n, "FAIL\t", 5) && tx_find(l, n, " above ", 7) >= 0) s = 5;
    if (s >= 0) {
        t = tx_chr(l + s, n - s, '\t');
        if (t < 0 && is_core) t = n - s;
        if (t <= 0) return 0;
        *ps = s; *pe = s + t;
        return 1;
    }
    c = tx_chr(l, n, ':');
    if (c < 0 || c + 2 >= n || l[c + 1] != ' ') return 0;
    if (tx_find(l, n, "stale row", 9) >= 0) return 0;
    if (softp) *softp = tx_prefix(l, n, "cxlibc:", 7) || tx_prefix(l, n, "cxraw:", 6);
    s = c + 2;
    if (tx_prefix(l, n, "verwriter: ", 11) && (w = tx_find(l + s, n - s, " has writer ", 12)) >= 0) {
        s += w + 12;
        e = rk_rfind(l + s, n - s, " and no baseline row", 20);
        if (e <= 0) return 0;
        *ps = s; *pe = s + e;
        return 1;
    }
    if (tx_prefix(l, n, "outdep: ", 8) && (w = tx_find(l + s, n - s, " out/ literals in ", 18)) >= 0) {
        s += w + 18;
        e = rk_rfind(l + s, n - s, ", baseline ", 11);
        if (e <= 0) return 0;
        *ps = s; *pe = s + e;
        return 1;
    }
    if (tx_prefix(l + s, n - s, "cx-wildcard-product: ", 21)) {
        s += 21;
        e = rk_rfind(l + s, n - s, " uses a use ", 12);
        if (e <= 0) return 0;
        *ps = s; *pe = s + e;
        return 1;
    }
    if (tx_prefix(l + s, n - s, "move target ", 12) && tx_find(l + s, n - s, " != move ", 9) >= 0) {
        s += 12;
        e = rk_rfind(l + s, n - s, " baseline ", 10);
        if (softp) *softp = 0;
    } else {
        if (tx_prefix(l + s, n - s, "module ", 7)) s += 7;   /* cxinclude: "module PATH has N include lines" */
        else if (tx_prefix(l + s, n - s, "move target ", 12)) s += 12;
        e = rk_rfind(l + s, n - s, " has ", 5);
        if (e < 0) e = rk_rfind(l + s, n - s, " total lines ", 13);
    }
    if (e <= 0) return 0;
    *ps = s; *pe = s + e;
    return 1;
}

static int offending(const char *l, long n, const char *only) {
    long ps = 0, pe = 0, ol;
    if (!offending_span(l, n, &ps, &pe, 0)) return 0;
    if (only) {
        ol = tx_len(only, 4096);
        if (pe - ps < ol || !tx_prefix(l + ps, pe - ps, only, ol)) return 0;
    }
    return 1;
}

/* the script of a ratchet: tests/NAME.cx, except notcovered, whose census tool lives in tools/ */
static const char *rk_script(const char *name, char *buf, long cap) {
    if (tx_eqz(name, "notcovered")) return "tools/notcovered-census.cx";
    if (tx_eqz(name, "dup-census")) return "tools/dup-census.cx";
    if (tx_eqz(name, "no-home-path")) return "tools/no-home-path.cx";
    if (tx_eqz(name, "ref-job-paths")) return "tools/ref-job-paths.cx";
    if (tx_eqz(name, "tsv-lint")) return "tools/tsv-lint.cx";
    if (cx_fmt(buf, cap, "tests/%s.cx", name)) return 0;
    return buf;
}

static int rk_own_tool_or_table(const char *name, const char *p, long pl) {
    char b[96];
    if (!cx_fmt(b, sizeof b, "tests/%s.cx", name) && pl == tx_len(b, sizeof b) && tx_same(p, pl, b, pl)) return 1;
    if (!cx_fmt(b, sizeof b, "tests/%s.tsv", name) && pl == tx_len(b, sizeof b) && tx_same(p, pl, b, pl)) return 1;
    if (!cx_fmt(b, sizeof b, "tools/%s.cx", name) && pl == tx_len(b, sizeof b) && tx_same(p, pl, b, pl)) return 1;
    if (!cx_fmt(b, sizeof b, "tools/check-%s.cx", name) && pl == tx_len(b, sizeof b) && tx_same(p, pl, b, pl)) return 1;
    if (!cx_fmt(b, sizeof b, "build/%s-baseline.tsv", name) && pl == tx_len(b, sizeof b) && tx_same(p, pl, b, pl)) return 1;
    if (!cx_fmt(b, sizeof b, "build/%s-exempt.tsv", name) && pl == tx_len(b, sizeof b) && tx_same(p, pl, b, pl)) return 1;
    return 0;
}

static int rk_path_hits(const char *name, const char *p, long pl, int precommit_soft) {
    if (pl <= 0) return 0;
    if ((pl == 17 && tx_same(p, 17, "tools/ratchets.cx", 17)) ||
        (pl == 18 && tx_same(p, 18, "tools/precommit.cx", 18)) ||
        (pl == 23 && tx_same(p, 23, "tools/precommit-flow.cx", 23)) ||
        (pl == 25 && tx_same(p, 25, "tests/precommit-gates.tsv", 25))) return 1;
    if (rk_own_tool_or_table(name, p, pl)) return 1;
    if (tx_eqz(name, "srcshape")) return tx_prefix(p, pl, "src/", 4);
    if (tx_eqz(name, "coreapi")) return tx_prefix(p, pl, "cx/", 3) || tx_prefix(p, pl, "tools/symindex", 14);
    if (tx_eqz(name, "notcovered")) return tx_prefix(p, pl, "exec/", 5) || tx_prefix(p, pl, "tools/notcovered-census", 23);
    if (tx_eqz(name, "tsv-lint")) return tx_prefix(p, pl, "exec/", 5) || tx_prefix(p, pl, "tools/tsv-lint", 14) || (pl == 27 && tx_same(p, 27, "build/tsv-lint-baseline.tsv", 27));
    if (tx_eqz(name, "dup-census")) return tx_prefix(p, pl, "tools/", 6);
    if (tx_eqz(name, "ref-job-paths")) return (pl == 16 && tx_same(p, 16, "prd_mempalace.md", 16));
    if (tx_eqz(name, "aluiwidth") || tx_eqz(name, "net-deps"))
        return tx_prefix(p, pl, "src/", 4) || tx_prefix(p, pl, "cx/", 3) ||
               tx_prefix(p, pl, "exec/", 5) || tx_prefix(p, pl, "seed/", 5) || tx_prefix(p, pl, "include/", 8);
    if (tx_eqz(name, "outdep"))
        return tx_prefix(p, pl, "tools/", 6) || tx_prefix(p, pl, "tests/", 6) || tx_prefix(p, pl, "src/", 4);
    if (precommit_soft && (tx_eqz(name, "cxlibc") || tx_eqz(name, "cxraw")))
        return !tx_prefix(p, pl, "tools/", 6) && !tx_prefix(p, pl, "tests/", 6);
    return 1;
}

static int rk_affected(const char *name) {
    const char *env = sy_env("UNISACC_RATCHETS_PATHS");
    const char *soft = sy_env("UNISACC_RATCHETS_PRECOMMIT");
    int precommit_soft = (soft && soft[0] == '1');
    if (!precommit_soft || !env || !env[0]) return 1;
    long n = tx_len(env, 1 << 20), at = 0;
    int any_path = 0;
    while (at < n) {
        long e = tx_chr(env + at, n - at, '\n'), l = e < 0 ? n - at : e;
        if (l > 0 && env[at + l - 1] == '\r') l--;
        if (l > 0) {
            any_path = 1;
            if (rk_path_hits(name, env + at, l, precommit_soft)) return 1;
        }
        at += (e < 0 ? l : e + 1);
    }
    return any_path ? 0 : 1;
}

static char *rk_skip_msg(const char *name, long *out_n) {
    char buf[160];
    if (cx_fmt(buf, sizeof buf, "%s: ok: skipped (unaffected by staged paths)\n", name)) return 0;
    long l = tx_len(buf, sizeof buf);
    char *m = mm_alloc(l + 1);
    if (!m) return 0;
    for (long i = 0; i <= l; i++) m[i] = buf[i];
    *out_n = l;
    return m;
}

static int rk_is_global_only(const char *name) {
    return tx_eqz(name, "net-deps") || tx_eqz(name, "notcovered") ||
           tx_eqz(name, "tsv-lint") || tx_eqz(name, "ref-job-paths");
}

static int rk_is_ident_char(char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
}

static int rk_buf_has_ident(const char *b, long bn, const char *fn, long fl) {
    long pos = 0;
    if (!b || bn < fl || fl <= 0) return 0;
    while (pos + fl <= bn) {
        long hit = tx_find(b + pos, bn - pos, fn, fl);
        if (hit < 0) break;
        hit += pos;
        if ((hit == 0 || !rk_is_ident_char(b[hit - 1])) &&
            (hit + fl == bn || !rk_is_ident_char(b[hit + fl]))) {
            return 1;
        }
        pos = hit + 1;
    }
    return 0;
}

static int rk_staged_has_ident(const char *path, long pl, const char *fn, long fl) {
    char spec[1100], pbuf[1100];
    char *sv[] = {"./tools/bound", "10", "git", "show", spec, 0};
    char *sv_nb[] = {"git", "show", spec, 0};
    int ofd = -1, pid, ex = 0, code = 0, sig = 0, found = 0;
    long deadline = sy_now_ms() + 10000;
    if (pl <= 0 || pl >= 1024 || fl <= 0) return 0;
    spec[0] = ':';
    for (long i = 0; i < pl; i++) spec[i + 1] = path[i];
    spec[pl + 1] = 0;
    pid = sy_spawn_pipe(sy_exists("./tools/bound") == 1 ? sv : sv_nb, 0, 0, &ofd, 0);
    if (pid > 0 && ofd >= 0) {
        long cap = 1 << 16, n = 0, r;
        char *b = mm_alloc(cap);
        while (b && sy_now_ms() < deadline && (r = sy_read(ofd, b + n, cap - 1 - n)) > 0) {
            n += r;
            if (n + 1 >= cap) {
                char *g = mm_grow(b, cap * 2);
                if (!g) break;
                b = g;
                cap *= 2;
            }
        }
        sy_close(ofd);
        if (sy_now_ms() >= deadline) sy_kill(pid);
        if (sy_wait_status(pid, 0, &ex, &code, &sig) == pid && ex && code == 0 && b && n > 0) {
            found = rk_buf_has_ident(b, n, fn, fl);
            mm_free(b);
            return found;
        }
        if (b) mm_free(b);
    }
    for (long i = 0; i < pl; i++) pbuf[i] = path[i];
    pbuf[pl] = 0;
    {
        size_t fsz = 0;
        char *fb = cx_read(pbuf, &fsz);
        if (fb) {
            found = rk_buf_has_ident(fb, (long)fsz, fn, fl);
            mm_free(fb);
        }
    }
    return found;
}

static int rk_dup_fn_hits_staged(const char *fn, long fl, const char *see_p, long see_l, const char *names, long sn) {
    long a2;
    for (a2 = 0; a2 < sn; ) {
        long nl = tx_len(names + a2, sn - a2);
        const char *p = names + a2;
        if (nl <= 0) break;
        if (rk_own_tool_or_table("dup-census", p, nl)) return 1;
        if (see_l > 0 && nl == see_l && tx_same(p, nl, see_p, see_l)) return 1;
        if (tx_prefix(p, nl, "tools/", 6) && nl > 3 && tx_same(p + nl - 3, 3, ".cx", 3)) {
            if (rk_staged_has_ident(p, nl, fn, fl)) return 1;
        }
        a2 += nl + 1;
    }
    return 0;
}

static int rk_any_hit(const char *name, const char *names, long sn) {
    const char *env = sy_env("UNISACC_RATCHETS_PATHS");
    long a2;
    if (env && env[0]) {
        long n = tx_len(env, 1 << 20), at = 0;
        while (at < n) {
            long e = tx_chr(env + at, n - at, '\n'), l = e < 0 ? n - at : e;
            if (l > 0 && env[at + l - 1] == '\r') l--;
            if (l > 0 && rk_path_hits(name, env + at, l, 1)) return 1;
            at += (e < 0 ? l : e + 1);
        }
    }
    for (a2 = 0; a2 < sn; ) {
        long nl = tx_len(names + a2, sn - a2);
        if (nl <= 0) break;
        if (rk_path_hits(name, names + a2, nl, 1)) return 1;
        a2 += nl + 1;
    }
    return 0;
}

static int rk_precommit_match(const char *rows_file, const char *paths_file) {
    size_t rsz = 0, psz = 0;
    char *rows = cx_read(rows_file, &rsz), *names = cx_read(paths_file, &psz);
    long rn = (long)rsz, sn = (long)psz, at = 0;
    char cur_rk_name[64], cur_rk_sum[256];
    int cur_rk_fail = 0, cur_rk_gblk = 0, cur_dup_has_fn = 0, blocked = 0;
    if (!rows || !names) return 2;
    cur_rk_name[0] = 0; cur_rk_sum[0] = 0;
    while (at < rn) {
        long e = tx_chr(rows + at, rn - at, '\n'), raw_l = e < 0 ? rn - at : e, l = raw_l, ps = 0, pe = 0, a2;
        const char *r = rows + at;
        int soft = 0;
        if (l > 0 && r[l - 1] == '\r') l--;
        if (l > 8 && tx_prefix(r, l, "RATCHET\t", 8)) {
            long o1, l1, o2, l2, o3, l3;
            cur_rk_name[0] = 0; cur_rk_sum[0] = 0; cur_rk_fail = 0; cur_rk_gblk = 0; cur_dup_has_fn = 0;
            if (!tx_field(r, l, '\t', 1, &o1, &l1) && l1 > 0 && l1 < (long)sizeof cur_rk_name &&
                !tx_field(r, l, '\t', 2, &o2, &l2)) {
                for (long j = 0; j < l1; j++) cur_rk_name[j] = r[o1 + j];
                cur_rk_name[l1] = 0;
                if (!tx_field(r, l, '\t', 3, &o3, &l3) && l3 > 0) {
                    long cl = l3 < (long)sizeof cur_rk_sum - 1 ? l3 : (long)sizeof cur_rk_sum - 1;
                    for (long j = 0; j < cl; j++) cur_rk_sum[j] = r[o3 + j];
                    cur_rk_sum[cl] = 0;
                }
                cur_rk_fail = (l2 == 4 && tx_same(r + o2, 4, "FAIL", 4)) || (l2 == 5 && tx_same(r + o2, 5, "ERROR", 5));
                if (cur_rk_fail && rk_is_global_only(cur_rk_name) && rk_any_hit(cur_rk_name, names, sn)) {
                    printf("precommit: blocked: RATCHET %s FAIL (%s)\n", cur_rk_name, cur_rk_sum);
                    blocked++;
                    cur_rk_gblk = 1;
                }
            }
        } else if (l > 2 && r[0] == ' ' && r[1] == ' ') {
            const char *b = r + 2; long bn = l - 2;
            if (cur_rk_fail && tx_eqz(cur_rk_name, "dup-census") &&
                tx_prefix(b, bn, "dup-census: ", 12) &&
                tx_find(b + 12, bn - 12, " verbatim copies across ", 24) >= 0) {
                long h = tx_find(b + 12, bn - 12, " has ", 5);
                long see = tx_find(b, bn, "; see ", 6);
                const char *see_p = (see >= 0 && bn > see + 7 && b[bn - 1] == ')') ? (b + see + 6) : 0;
                long see_l = see_p ? (bn - (see + 6) - 1) : 0;
                cur_dup_has_fn = 1;
                if (h > 0 && rk_dup_fn_hits_staged(b + 12, h, see_p, see_l, names, sn)) {
                    printf("precommit: blocked: RATCHET dup-census FAIL (%s):%.*s\n", cur_rk_sum, (int)(l - 1), r + 1);
                    blocked++;
                    cur_rk_gblk = 1;
                }
                at += raw_l + 1;
                continue;
            }
            if (cur_rk_fail && !cur_rk_gblk && !(tx_eqz(cur_rk_name, "dup-census") && cur_dup_has_fn) &&
                (tx_find(b, bn, " total lines ", 13) >= 0 || tx_find(b, bn, "total debt ", 11) >= 0 || tx_find(b, bn, "expired exempt row", 18) >= 0) &&
                rk_any_hit(cur_rk_name, names, sn)) {
                printf("precommit: blocked: RATCHET %s FAIL (%s):%.*s\n", cur_rk_name, cur_rk_sum, (int)(l - 1), r + 1);
                blocked++;
                cur_rk_gblk = 1;
            }
            if (offending_span(b, bn, &ps, &pe, &soft) && ps >= 0 && pe > ps && pe <= bn) {
                for (a2 = 0; a2 < sn; ) {
                    long nl = tx_len(names + a2, sn - a2);
                    if (nl <= 0) break;
                    if (tx_same(names + a2, nl, b + ps, pe - ps)) {
                        int toolish = tx_prefix(names + a2, nl, "tools/", 6) || tx_prefix(names + a2, nl, "tests/", 6);
                        if (!toolish || !soft) {
                            printf("precommit: blocked:%.*s\n", (int)(l - 1), r + 1);
                            blocked++;
                        }
                        break;
                    }
                    a2 += nl + 1;
                }
            }
        }
        at += raw_l + 1;
    }
    printf("RATCHETS_PRECOMMIT\tblocked=%d\n", blocked);
    return 0;
}

static int judge(Rk *rk, const char *only, int *okp, int *skipp);
static void from_run(Rk *rk, const char *dir);

int main(int argc, char **argv) {
    static Rk rk[NRK] = {{"cxraw"}, {"cxinclude"}, {"cxapis"}, {"cxtrunc"}, {"cxlibc"}, {"cxplatform"}, {"srcshape"}, {"coreapi"}, {"verwriter"}, {"aluiwidth"}, {"outdep"}, {"check-literal"}, {"net-deps"}, {"notcovered"}, {"dup-census"}, {"no-home-path"}, {"ref-job-paths"}, {"tsv-lint"}};
    const char *only = 0; long t0 = sy_now_ms(); int k, ok = 0, fail = 0, skipped = 0;
    if (argc == 4 && tx_eqz(argv[1], "--precommit")) return rk_precommit_match(argv[2], argv[3]);
    if ((argc == 3 || argc == 5) && tx_eqz(argv[1], "--rows")) {   /* --rows SAVED [--only P]: the filter alone, on a saved ratchet output */
        size_t n; char *b = cx_read(argv[2], &n); long at = 0;
        if (!b) { fprintf(stderr, "ratchets: cannot read %s\n", argv[2]); return 2; }
        if (argc == 5) { if (!tx_eqz(argv[3], "--only")) return 2; only = argv[4]; }
        while (at < (long)n) {
            long e = tx_chr(b + at, (long)n - at, '\n'), ln = e < 0 ? (long)n - at : e;
            if (offending(b + at, ln, only)) printf("%.*s\n", (int)ln, b + at);
            at += ln + 1;
        }
        return 0;
    }
    if (argc == 2 && tx_eqz(argv[1], "--plan")) {   /* PLAN<TAB>rk-NAME<TAB>argv...: the spawn line of each ratchet */
        for (k = 0; k < NRK; k++) {
            char sb[64];
            if (!rk_affected(rk[k].name)) continue;
            printf("PLAN\trk-%s\t./tools/bound\t55\tsh\t./unisacc.com\t%s\t--\t--check\n", rk[k].name, rk_script(rk[k].name, sb, sizeof sb));
        }
        return 0;
    }
    if ((argc == 3 || argc == 5) && tx_eqz(argv[1], "--from-run")) {   /* judge a flow run of the --plan nodes */
        const char *soft = sy_env("UNISACC_RATCHETS_PRECOMMIT");
        int precommit_soft = (soft && soft[0] == '1');
        if (argc == 5) { if (!tx_eqz(argv[3], "--only")) return 2; only = argv[4]; }
        from_run(rk, argv[2]);
        fail = judge(rk, only, &ok, &skipped);
        if (skipped > 0 || precommit_soft) printf("RATCHETS\tok=%d\tfail=%d\tskipped=%d\telapsed_ms=%ld\n", ok, fail, skipped, sy_now_ms() - t0);
        else printf("RATCHETS\tok=%d\tfail=%d\telapsed_ms=%ld\n", ok, fail, sy_now_ms() - t0);
        return fail ? 1 : 0;
    }
    if (argc >= 3 && tx_eqz(argv[1], "--affected")) {
        char abuf[65536]; long ap = 0;
        for (k = 2; k < argc; k++) {
            long al = tx_len(argv[k], 4096);
            if (ap + al + 2 < (long)sizeof abuf) {
                for (long j = 0; j < al; j++) abuf[ap++] = argv[k][j];
                abuf[ap++] = '\n';
            }
        }
        abuf[ap] = 0;
        sy_setenv("UNISACC_RATCHETS_PATHS", abuf, 1);
        sy_setenv("UNISACC_RATCHETS_PRECOMMIT", "1", 1);
    } else if (argc == 3 && tx_eqz(argv[1], "--only")) only = argv[2];
    else if (argc != 1) { fprintf(stderr, "usage: tools/ratchets.cx [--only PATH-PREFIX | --affected PATH... | --rows SAVED [--only PATH-PREFIX] | --plan | --from-run DIR [--only PATH-PREFIX]]\n"); return 2; }
    char lsf[4200]; int lsfd = -1, lspid; lsf[0] = 0;
    if (!sy_env("UNISACC_CX_LSFILES")) {   /* one tracked-.cx listing for the round; symindex (cxlibc, coreapi: 28 queries) reuses it; fall back to its own query when absent */
        char *gv[] = {"git", "ls-files", "-s", "-z", "--", "*.cx", 0}; char *lb; long ln;
        if (!cx_fmt(lsf, sizeof lsf, "%s/ratchets-%d.lst", sy_tmpdir(), sy_pid()) && (lspid = sy_spawn_pipe(gv, 0, 0, &lsfd, 0)) > 0) {
            int ex = 0, code = 0, sig = 0;
            slurp(lsfd, &lb, &ln); sy_close(lsfd);
            if (sy_wait_status(lspid, 0, &ex, &code, &sig) == lspid && ex && code == 0 && lb && ln > 0 && cx_write(lsf, lb, ln) == 0) sy_setenv("UNISACC_CX_LSFILES", lsf, 1);
            else lsf[0] = 0;
        } else lsf[0] = 0;
    }
    for (k = 0; k < NRK; k++) {
        char sb[64], *script;
        if (!rk_affected(rk[k].name)) {
            rk[k].pid = -2;
            rk[k].rc = 0;
            rk[k].out = rk_skip_msg(rk[k].name, &rk[k].n);
            continue;
        }
        script = (char *)rk_script(rk[k].name, sb, sizeof sb);
        if (!script) return 2;
        {   char *v[] = {"./tools/bound", "55", "sh", "./unisacc.com", script, "--", "--check", 0};
            rk[k].pid = sy_spawn_pipe(v, 0, 0, &rk[k].ofd, 0);   /* stderr merged: the ratchets print their rows there */
        }
        if (rk[k].pid < 0) { fprintf(stderr, "ratchets: cannot start %s\n", rk[k].name); return 2; }
    }
    for (k = 0; k < NRK; k++) {
        int ex = 0, code = 0, sig = 0;
        if (rk[k].pid == -2) continue;
        slurp(rk[k].ofd, &rk[k].out, &rk[k].n);
        sy_close(rk[k].ofd);
        rk[k].rc = sy_wait_status(rk[k].pid, 0, &ex, &code, &sig) == rk[k].pid && ex ? code : -1;
    }
    fail = judge(rk, only, &ok, &skipped);
    if (lsf[0]) sy_unlink(lsf);
    {   const char *soft = sy_env("UNISACC_RATCHETS_PRECOMMIT");
        int precommit_soft = (soft && soft[0] == '1');
        if (skipped > 0 || precommit_soft) printf("RATCHETS\tok=%d\tfail=%d\tskipped=%d\telapsed_ms=%ld\n", ok, fail, skipped, sy_now_ms() - t0);
        else printf("RATCHETS\tok=%d\tfail=%d\telapsed_ms=%ld\n", ok, fail, sy_now_ms() - t0);
    }
    return fail ? 1 : 0;
}

/* the one judgement: per ratchet a RATCHET line plus its offending rows; returns fail, *okp = ok, *skipp = skipped */
static int judge(Rk *rk, const char *only, int *okp, int *skipp) {
    int k, ok = 0, fail = 0, skipped = 0;
    for (k = 0; k < NRK; k++) {
        const char *o = rk[k].out ? rk[k].out : ""; long at = 0, summary = -1, sn = 0;
        int isok, isskip;
        while (at < rk[k].n) {   /* the summary is the line with " ok: " or " FAIL: " */
            long e = tx_chr(o + at, rk[k].n - at, '\n'), ln = e < 0 ? rk[k].n - at : e;
            /* summary: "…: ok: …" / "…: FAIL: …" (the nine), or "…\tstatus=PASS|FAIL" (check-literal) */
            if (tx_find(o + at, ln, ": ok: ", 6) >= 0 || tx_find(o + at, ln, ": FAIL: ", 8) >= 0
                || tx_find(o + at, ln, "status=PASS", 11) >= 0 || tx_find(o + at, ln, "status=FAIL", 11) >= 0) { summary = at; sn = ln; }
            at += ln + 1;
        }
        isok = rk[k].rc == 0 && summary >= 0 &&
               (tx_find(o + summary, sn, ": ok: ", 6) >= 0 || tx_find(o + summary, sn, "status=PASS", 11) >= 0);
        isskip = isok && (rk[k].pid == -2 || tx_find(o + summary, sn, ": ok: skipped (", 15) >= 0);
        if (isskip) skipped++; else if (isok) ok++; else fail++;
        printf("RATCHET\t%s\t%s\t%.*s\n", rk[k].name, isok ? "ok" : summary >= 0 ? "FAIL" : "ERROR", (int)(summary >= 0 ? sn : 0), summary >= 0 ? o + summary : "");
        at = 0;
        while (at < rk[k].n) {
            long e = tx_chr(o + at, rk[k].n - at, '\n'), ln = e < 0 ? rk[k].n - at : e;
            if (offending(o + at, ln, only)) printf("  %.*s\n", (int)ln, o + at);
            at += ln + 1;
        }
    }
    *okp = ok;
    *skipp = skipped;
    return fail;
}

/* --from-run DIR: rk[k].out from DIR/out/rk-NAME.out, rc from the last ok/fail row of rk-NAME in
 * DIR/events.tsv (missing, timeout or skip = -1, as a killed child in the spawned path) */
static void from_run(Rk *rk, const char *dir) {
    char p[1300], id[64]; size_t en = 0, bn = 0; char *ev; int k;
    if (cx_fmt(p, sizeof p, "%s/events.tsv", dir)) ev = 0; else ev = (char *)cx_read(p, &en);
    for (k = 0; k < NRK; k++) {
        long i = 0, il; int rc = -1;
        rk[k].out = 0; rk[k].n = 0;
        if (cx_fmt(id, sizeof id, "rk-%s", rk[k].name)) { rk[k].rc = -1; continue; }
        il = tx_len(id, 64);
        while (ev && i < (long)en) {
            long e = i, io, ilen, so, sl, ro, rl; while (e < (long)en && ev[e] != '\n') e++;
            if (!tx_field(ev + i, e - i, '\t', 2, &io, &ilen) && ilen == il && tx_same(ev + i + io, ilen, id, il) &&
                !tx_field(ev + i, e - i, '\t', 3, &so, &sl) && !tx_field(ev + i, e - i, '\t', 5, &ro, &rl)) {
                if ((sl == 2 && tx_same(ev + i + so, 2, "ok", 2)) || (sl == 4 && tx_same(ev + i + so, 4, "fail", 4))) {
                    long v = 0, j; int neg = 0;
                    for (j = 0; j < rl; j++) { if (ev[i + ro + j] == '-') neg = 1; else v = v * 10 + (ev[i + ro + j] - '0'); }
                    rc = neg ? -1 : (int)v;
                } else if (sl != 5 || !tx_same(ev + i + so, 5, "start", 5)) rc = -1;
            }
            i = e + 1;
        }
        rk[k].rc = rc;
        if (!cx_fmt(p, sizeof p, "%s/out/%s.out", dir, id)) {
            char *b = (char *)cx_read(p, &bn);
            if (b) { char *g = mm_grow(b, bn + 1); if (g) { g[bn] = 0; rk[k].out = g; rk[k].n = (long)bn; } }
        }
        if (rk[k].rc == -1 && !rk[k].out && !rk_affected(rk[k].name)) {
            rk[k].rc = 0;
            rk[k].out = rk_skip_msg(rk[k].name, &rk[k].n);
        }
    }
}
