/* tools/ratchets.cx -- run sixteen repo ratchets and show only what is wrong.
 *
 *   sh ./unisacc.com tools/ratchets.cx [-- --only PATH-PREFIX]
 *
 * Starts tests/cxraw.cx, tests/cxinclude.cx, tests/cxapis.cx, tests/cxtrunc.cx, tests/cxlibc.cx, tests/cxplatform.cx
 * (platform #if branches and raw syscalls outside L0), tests/srcshape.cx (src/ lines, longest block and `if`
 * count only go down), tests/coreapi.cx (the core modules' exported names and signatures only go down),
 * verwriter, aluiwidth, outdep, check-literal, net-deps (gate 14) and notcovered (the 14th ratchet:
 * tools/notcovered-census.cx --check, distinct "not covered:" refusal texts under exec/ only go down,
 * base tests/notcovered.tsv) and dup-census (the 15th: tools/dup-census.cx --check, byte-identical static
 * function groups in tools/ and tools/cxlib/ and their redundant lines only go down, base
 * build/dup-census-baseline.tsv) and no-home-path (the 16th: tools/no-home-path.cx --check, lines with an
 * absolute home path that leaks a system user name only go down, base build/no-home-path-baseline.tsv).
 * Tool line counts are reports, not ratchets.
 * with --check in parallel
 * (each under tools/bound 55) and prints, per ratchet, one line
 *   RATCHET<TAB>name<TAB>ok|FAIL|ERROR<TAB>its summary line
 * followed by the rows that make it fail (a row naming a file above its baseline, a row naming a whole-tree
 * total above its baseline, or a file with no row), but not the
 * "stale row" or "below baseline" notes.  With --only PREFIX, only offending rows whose file starts with PREFIX
 * are printed (the status still covers the whole tree).  Ends with RATCHETS<TAB>ok=N<TAB>fail=M<TAB>elapsed_ms=T
 * and exits 0 only when all nine are ok.  One call instead of nine serial ones (about 5 x 10 s, plus each
 * symindex query: cxlibc's and coreapi's twenty-six dumps). */
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use sys.env

#define NRK 16
typedef struct { const char *name; int pid, ofd, efd; char *out; long n; int rc; } Rk;

static void slurp(int fd, char **buf, long *n) {
    long cap = 1 << 16, r; char *b = mm_alloc(cap);
    *n = 0;
    while (b && (r = sy_read(fd, b + *n, cap - 1 - *n)) > 0) {
        *n += r;
        if (*n + 1 >= cap) { char *g = mm_grow(b, cap * 2); if (!g) break; b = g; cap *= 2; }
    }
    if (b) b[*n] = 0;
    *buf = b;
}

/* 1 when LINE (len n) names a failing file or a whole-tree overflow:
 * "<tool>: <path> has ..." or "<tool>: <scope> total lines N, baseline M", without "stale row" */
static int offending(const char *l, long n, const char *only) {
    long c = tx_chr(l, n, ':'), s;
    if (c < 0 || c + 2 >= n || l[c + 1] != ' ') return 0;
    if (tx_find(l, n, "stale row", 9) >= 0) return 0;
    s = c + 2;
    if (tx_prefix(l + s, n - s, "module ", 7)) s += 7;   /* cxinclude: "module PATH has N include lines" */
    if (tx_find(l + s, n - s, " total lines ", 13) < 0 && tx_find(l, n, " has ", 5) < 0) return 0;
    if (only && !tx_prefix(l + s, n - s, only, tx_len(only, 4096))) return 0;
    return 1;
}

/* the script of a ratchet: tests/NAME.cx, except notcovered, whose census tool lives in tools/ */
static const char *rk_script(const char *name, char *buf, long cap) {
    if (tx_eqz(name, "notcovered")) return "tools/notcovered-census.cx";
    if (tx_eqz(name, "dup-census")) return "tools/dup-census.cx";
    if (tx_eqz(name, "no-home-path")) return "tools/no-home-path.cx";
    if (cx_fmt(buf, cap, "tests/%s.cx", name)) return 0;
    return buf;
}

static int rk_path_hits(const char *name, const char *p, long pl, int precommit_soft) {
    long nl = tx_len(name, 64);
    if (pl <= 0) return 0;
    if ((pl == 17 && tx_same(p, 17, "tools/ratchets.cx", 17)) ||
        (pl == 18 && tx_same(p, 18, "tools/precommit.cx", 18)) ||
        (pl == 23 && tx_same(p, 23, "tools/precommit-flow.cx", 23)) ||
        (pl == 25 && tx_same(p, 25, "tests/precommit-gates.tsv", 25))) return 1;
    if (nl > 0 && tx_find(p, pl, name, nl) >= 0) return 1;
    if (tx_eqz(name, "srcshape")) return tx_prefix(p, pl, "src/", 4);
    if (tx_eqz(name, "coreapi")) return tx_prefix(p, pl, "cx/", 3) || tx_prefix(p, pl, "tools/symindex", 14);
    if (tx_eqz(name, "notcovered")) return tx_prefix(p, pl, "exec/", 5);
    if (tx_eqz(name, "dup-census")) return tx_prefix(p, pl, "tools/", 6);
    if (tx_eqz(name, "aluiwidth") || tx_eqz(name, "net-deps"))
        return tx_prefix(p, pl, "src/", 4) || tx_prefix(p, pl, "cx/", 3) ||
               tx_prefix(p, pl, "exec/", 5) || tx_prefix(p, pl, "seed/", 5) || tx_prefix(p, pl, "include/", 8);
    if (tx_eqz(name, "outdep"))
        return tx_prefix(p, pl, "tools/", 6) || tx_prefix(p, pl, "tests/", 6) || tx_prefix(p, pl, "src/", 4);
    if (precommit_soft && (tx_eqz(name, "cxlibc") || tx_eqz(name, "cxraw")))
        return !tx_prefix(p, pl, "tools/", 6) && !tx_prefix(p, pl, "tests/", 6);
    return 1;
}

static int rk_affected(const char *name) {
    const char *env = sy_env("UNISACC_RATCHETS_PATHS");
    const char *soft = sy_env("UNISACC_RATCHETS_PRECOMMIT");
    int precommit_soft = (soft && soft[0] == '1');
    if (!env || !env[0]) return 1;
    long n = tx_len(env, 1 << 20), at = 0;
    int any_path = 0;
    while (at < n) {
        long e = tx_chr(env + at, n - at, '\n'), l = e < 0 ? n - at : e;
        if (l > 0 && env[at + l - 1] == '\r') l--;
        if (l > 0) {
            any_path = 1;
            if (rk_path_hits(name, env + at, l, precommit_soft)) return 1;
        }
        at += (e < 0 ? l : e + 1);
    }
    return any_path ? 0 : 1;
}

static char *rk_skip_msg(const char *name, long *out_n) {
    char buf[160];
    if (cx_fmt(buf, sizeof buf, "%s: ok: skipped (unaffected by staged paths)\n", name)) return 0;
    long l = tx_len(buf, sizeof buf);
    char *m = mm_alloc(l + 1);
    if (!m) return 0;
    for (long i = 0; i <= l; i++) m[i] = buf[i];
    *out_n = l;
    return m;
}

static int judge(Rk *rk, const char *only, int *okp);
static void from_run(Rk *rk, const char *dir);

int main(int argc, char **argv) {
    static Rk rk[NRK] = {{"cxraw"}, {"cxinclude"}, {"cxapis"}, {"cxtrunc"}, {"cxlibc"}, {"cxplatform"}, {"srcshape"}, {"coreapi"}, {"verwriter"}, {"aluiwidth"}, {"outdep"}, {"check-literal"}, {"net-deps"}, {"notcovered"}, {"dup-census"}, {"no-home-path"}};
    const char *only = 0; long t0 = sy_now_ms(); int k, ok = 0, fail = 0;
    if ((argc == 3 || argc == 5) && tx_eqz(argv[1], "--rows")) {   /* --rows SAVED [--only P]: the filter alone, on a saved ratchet output */
        size_t n; char *b = cx_read(argv[2], &n); long at = 0;
        if (!b) { fprintf(stderr, "ratchets: cannot read %s\n", argv[2]); return 2; }
        if (argc == 5) { if (!tx_eqz(argv[3], "--only")) return 2; only = argv[4]; }
        while (at < (long)n) {
            long e = tx_chr(b + at, (long)n - at, '\n'), ln = e < 0 ? (long)n - at : e;
            if (offending(b + at, ln, only)) printf("%.*s\n", (int)ln, b + at);
            at += ln + 1;
        }
        return 0;
    }
    if (argc == 2 && tx_eqz(argv[1], "--plan")) {   /* PLAN<TAB>rk-NAME<TAB>argv...: the spawn line of each ratchet */
        for (k = 0; k < NRK; k++) {
            char sb[64];
            if (!rk_affected(rk[k].name)) continue;
            printf("PLAN\trk-%s\t./tools/bound\t55\tsh\t./unisacc.com\t%s\t--\t--check\n", rk[k].name, rk_script(rk[k].name, sb, sizeof sb));
        }
        return 0;
    }
    if ((argc == 3 || argc == 5) && tx_eqz(argv[1], "--from-run")) {   /* judge a flow run of the --plan nodes */
        if (argc == 5) { if (!tx_eqz(argv[3], "--only")) return 2; only = argv[4]; }
        from_run(rk, argv[2]);
        fail = judge(rk, only, &ok);
        printf("RATCHETS\tok=%d\tfail=%d\telapsed_ms=%ld\n", ok, fail, sy_now_ms() - t0);
        return fail ? 1 : 0;
    }
    if (argc >= 3 && tx_eqz(argv[1], "--affected")) {
        char abuf[65536]; long ap = 0;
        for (k = 2; k < argc; k++) {
            long al = tx_len(argv[k], 4096);
            if (ap + al + 2 < (long)sizeof abuf) {
                for (long j = 0; j < al; j++) abuf[ap++] = argv[k][j];
                abuf[ap++] = '\n';
            }
        }
        abuf[ap] = 0;
        sy_setenv("UNISACC_RATCHETS_PATHS", abuf, 1);
    } else if (argc == 3 && tx_eqz(argv[1], "--only")) only = argv[2];
    else if (argc != 1) { fprintf(stderr, "usage: tools/ratchets.cx [--only PATH-PREFIX | --affected PATH... | --rows SAVED [--only PATH-PREFIX] | --plan | --from-run DIR [--only PATH-PREFIX]]\n"); return 2; }
    char lsf[4200]; int lsfd = -1, lspid; lsf[0] = 0;
    if (!sy_env("UNISACC_CX_LSFILES")) {   /* one tracked-.cx listing for the round; symindex (cxlibc, coreapi: 28 queries) reuses it; fall back to its own query when absent */
        char *gv[] = {"git", "ls-files", "-s", "-z", "--", "*.cx", 0}; char *lb; long ln;
        if (!cx_fmt(lsf, sizeof lsf, "%s/ratchets-%d.lst", sy_tmpdir(), sy_pid()) && (lspid = sy_spawn_pipe(gv, 0, 0, &lsfd, 0)) > 0) {
            int ex = 0, code = 0, sig = 0;
            slurp(lsfd, &lb, &ln); sy_close(lsfd);
            if (sy_wait_status(lspid, 0, &ex, &code, &sig) == lspid && ex && code == 0 && lb && ln > 0 && cx_write(lsf, lb, ln) == 0) sy_setenv("UNISACC_CX_LSFILES", lsf, 1);
            else lsf[0] = 0;
        } else lsf[0] = 0;
    }
    for (k = 0; k < NRK; k++) {
        char sb[64], *script;
        if (!rk_affected(rk[k].name)) {
            rk[k].pid = -2;
            rk[k].rc = 0;
            rk[k].out = rk_skip_msg(rk[k].name, &rk[k].n);
            continue;
        }
        script = (char *)rk_script(rk[k].name, sb, sizeof sb);
        if (!script) return 2;
        {   char *v[] = {"./tools/bound", "55", "sh", "./unisacc.com", script, "--", "--check", 0};
            rk[k].pid = sy_spawn_pipe(v, 0, 0, &rk[k].ofd, 0);   /* stderr merged: the ratchets print their rows there */
        }
        if (rk[k].pid < 0) { fprintf(stderr, "ratchets: cannot start %s\n", rk[k].name); return 2; }
    }
    for (k = 0; k < NRK; k++) {
        int ex = 0, code = 0, sig = 0;
        if (rk[k].pid == -2) continue;
        slurp(rk[k].ofd, &rk[k].out, &rk[k].n);
        sy_close(rk[k].ofd);
        rk[k].rc = sy_wait_status(rk[k].pid, 0, &ex, &code, &sig) == rk[k].pid && ex ? code : -1;
    }
    fail = judge(rk, only, &ok);
    if (lsf[0]) sy_unlink(lsf);
    printf("RATCHETS\tok=%d\tfail=%d\telapsed_ms=%ld\n", ok, fail, sy_now_ms() - t0);
    return fail ? 1 : 0;
}

/* the one judgement: per ratchet a RATCHET line plus its offending rows; returns fail, *okp = ok */
static int judge(Rk *rk, const char *only, int *okp) {
    int k, ok = 0, fail = 0;
    for (k = 0; k < NRK; k++) {
        const char *o = rk[k].out ? rk[k].out : ""; long at = 0, summary = -1, sn = 0;
        int isok;
        while (at < rk[k].n) {   /* the summary is the line with " ok: " or " FAIL: " */
            long e = tx_chr(o + at, rk[k].n - at, '\n'), ln = e < 0 ? rk[k].n - at : e;
            /* summary: "…: ok: …" / "…: FAIL: …" (the nine), or "…\tstatus=PASS|FAIL" (check-literal) */
            if (tx_find(o + at, ln, ": ok: ", 6) >= 0 || tx_find(o + at, ln, ": FAIL: ", 8) >= 0
                || tx_find(o + at, ln, "status=PASS", 11) >= 0 || tx_find(o + at, ln, "status=FAIL", 11) >= 0) { summary = at; sn = ln; }
            at += ln + 1;
        }
        isok = rk[k].rc == 0 && summary >= 0 &&
               (tx_find(o + summary, sn, ": ok: ", 6) >= 0 || tx_find(o + summary, sn, "status=PASS", 11) >= 0);
        if (isok) ok++; else fail++;
        printf("RATCHET\t%s\t%s\t%.*s\n", rk[k].name, isok ? "ok" : summary >= 0 ? "FAIL" : "ERROR", (int)(summary >= 0 ? sn : 0), summary >= 0 ? o + summary : "");
        at = 0;
        while (at < rk[k].n) {
            long e = tx_chr(o + at, rk[k].n - at, '\n'), ln = e < 0 ? rk[k].n - at : e;
            if (offending(o + at, ln, only)) printf("  %.*s\n", (int)ln, o + at);
            at += ln + 1;
        }
    }
    *okp = ok;
    return fail;
}

/* --from-run DIR: rk[k].out from DIR/out/rk-NAME.out, rc from the last ok/fail row of rk-NAME in
 * DIR/events.tsv (missing, timeout or skip = -1, as a killed child in the spawned path) */
static void from_run(Rk *rk, const char *dir) {
    char p[1300], id[64]; size_t en = 0, bn = 0; char *ev; int k;
    if (cx_fmt(p, sizeof p, "%s/events.tsv", dir)) ev = 0; else ev = (char *)cx_read(p, &en);
    for (k = 0; k < NRK; k++) {
        long i = 0, il; int rc = -1;
        rk[k].out = 0; rk[k].n = 0;
        if (cx_fmt(id, sizeof id, "rk-%s", rk[k].name)) { rk[k].rc = -1; continue; }
        il = tx_len(id, 64);
        while (ev && i < (long)en) {
            long e = i, io, ilen, so, sl, ro, rl; while (e < (long)en && ev[e] != '\n') e++;
            if (!tx_field(ev + i, e - i, '\t', 2, &io, &ilen) && ilen == il && tx_same(ev + i + io, ilen, id, il) &&
                !tx_field(ev + i, e - i, '\t', 3, &so, &sl) && !tx_field(ev + i, e - i, '\t', 5, &ro, &rl)) {
                if ((sl == 2 && tx_same(ev + i + so, 2, "ok", 2)) || (sl == 4 && tx_same(ev + i + so, 4, "fail", 4))) {
                    long v = 0, j; int neg = 0;
                    for (j = 0; j < rl; j++) { if (ev[i + ro + j] == '-') neg = 1; else v = v * 10 + (ev[i + ro + j] - '0'); }
                    rc = neg ? -1 : (int)v;
                } else if (sl != 5 || !tx_same(ev + i + so, 5, "start", 5)) rc = -1;
            }
            i = e + 1;
        }
        rk[k].rc = rc;
        if (!cx_fmt(p, sizeof p, "%s/out/%s.out", dir, id)) {
            char *b = (char *)cx_read(p, &bn);
            if (b) { char *g = mm_grow(b, bn + 1); if (g) { g[bn] = 0; rk[k].out = g; rk[k].n = (long)bn; } }
        }
        if (rk[k].rc == -1 && !rk[k].out && !rk_affected(rk[k].name)) {
            rk[k].rc = 0;
            rk[k].out = rk_skip_msg(rk[k].name, &rk[k].n);
        }
    }
}
