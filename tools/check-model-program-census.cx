/* Independent UNINETB1 bytes: empty S, one Q action and C prefix reuse. */
#pragma unisa use sys.fs
#pragma unisa use sysx.process
#pragma unisa use text.text
#pragma unisa use mem.bytes
static int checks,bad;static char root[4400],tmp[4400],file[4400],table[4400],com[4400],tool[4400];
static void ck(int yes,const char *s){checks++;printf("%s\t%s\n",yes?"PASS":"FAIL",s);if(!yes)bad++;}
static char *run(int expect,int custom){char *v[12];int k=0;v[k++]="sh";v[k++]=com;v[k++]=tool;v[k++]="--";v[k++]="--model";v[k++]=file;if(custom){v[k++]="--arity";v[k++]=table;}v[k]=0;np_result r={0};char why[512]={0};int e=np_run(v,root,0,8,&r,why,sizeof why);char *out=0;if(!e&&!r.residue&&r.rc==expect){out=malloc(r.outn+1);if(!out)exit(2);mm_copy(out, r.outn, r.out, r.outn);out[r.outn]=0;}else fprintf(stderr,"transport=%d rc=%d expected=%d why=%s\n%s\n",e,r.rc,expect,why,r.err?r.err:"");np_free(&r);return out;}
static unsigned char valid[]={85,78,73,78,69,84,66,49,'T',2,4,0,2,0,'S',0,'Q',2,98,'C',0,2,0,'R',0,0,1,0};
int main(void){char pattern[]="/tmp/check-model-program-census-XXXXXX";if(!realpath(".",root)||!mkdtemp(pattern))return 2;(cx_fmt(tmp, sizeof tmp, "%s", pattern) ? exit(2) : (void)0);if(cx_fmt(com,sizeof com,"%s/unisacc.com",root)||cx_fmt(tool,sizeof tool,"%s/tools/model-program-census.cx",root)||cx_fmt(file,sizeof file,"%s/model",tmp)||cx_fmt(table,sizeof table,"%s/arity",tmp))return 2;if(cx_write(file,valid,sizeof valid))return 2;char *s=run(0,0);ck(s&&strstr(s,"kind=T"),"formal decoder accepts tiny table");ck(s&&strstr(s,"raw=28\traw_header=14\traw_constants=2\traw_action_program=7\traw_selector_bytes=5"),"four raw sections exact 28 byte conservation");ck(s&&strstr(s,"states=1\trows=0\tsequences=2\tactions_explicit=1\tactions_expanded=2"),"Q/C prefix expanded and explicit counts");ck(s&&strstr(s,"semantic_decision_share=UNKNOWN")&&strstr(s,"compressed_section_allocation=NONE"),"representation boundaries explicit");free(s);
unsigned char network[]={85,78,73,78,69,84,66,49,'N',2,4,0,2,0,0,'S',0,'Q',2,98,'C',0,2,0,'H',0,0,128,4,0,1,0};if(cx_write(file,network,sizeof network))return 2;s=run(0,0);ck(s&&strstr(s,"kind=N")&&strstr(s,"raw=32\traw_header=15\traw_constants=2\traw_action_program=7\traw_selector_bytes=8"),"independent network selector with top header and exact section conservation");free(s);
if(cx_write(file,valid,sizeof valid-1))return 2;s=run(2,0);ck(s!=0,"truncated selector refused by decoder");free(s);unsigned char broken[sizeof valid];mm_copy(broken, sizeof valid, valid, sizeof valid);broken[18]=126;if(cx_write(file,broken,sizeof broken))return 2;s=run(2,0);ck(s!=0,"unknown opcode refused by decoder");free(s);mm_copy(broken, sizeof valid, valid, sizeof valid);broken[21]=4;if(cx_write(file,broken,sizeof broken))return 2;s=run(2,0);ck(s!=0,"C prefix past referenced qlen refuses");free(s);
if(cx_write(file,valid,sizeof valid))return 2;size_t n;char *a=cx_read("exec/facts/core-ops.tsv",&n);if(!a)return 2;char *p=strstr(a,"ACCEPT\t49\t0");if(!p)return 2;p[10]='1';if(cx_write(table,a,n))return 2;free(a);s=run(2,1);ck(s!=0,"fact arity mismatch refuses measurement");free(s);unlink(file);unlink(table);rmdir(tmp);printf("MODEL_PROGRAM_CENSUS_CHECK\tchecks=%d\tfailed=%d\n",checks,bad);return bad?1:0;}
