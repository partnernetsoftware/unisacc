/* Source-preserving adapter for the legacy C ledger, not a second parser.
 * ROOT ABS_NEW_DIR RELATIVE_FIXTURE | --verify ROOT DIR RELATIVE_FIXTURE
 * Only known includes are removed: the CX edition supplies their declarations
 * and shared SHA implementation. Source/product identity is checked twice.
 * Output is PREPARED material; every contract must still execute. */
#pragma unisa use cxlib.netpack
#pragma unisa use text.text
static char root[4096],work[4096],product[4400],fixture[4400];
static np_buf body,record;static char hashes[4][65];
static void die(const char *s){fprintf(stderr,"ledger-material: REFUSE %s\n",s);exit(2);}
static void path(char *p,size_t cap,const char *a,const char *b){int n=snprintf(p,cap,"%s/%s",a,b);if(n<0||(size_t)n>=cap)die("path bound");}
static char *load(const char *p,size_t *n){struct stat st;if(lstat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>16777216)die(p);char *s=cx_read(p,n);if(!s||*n!=(size_t)st.st_size)die("read/size changed");return s;}
static void source_id(char *out){char bound[4400],ident[4400],why[1024];path(bound,sizeof bound,root,"tools/bound");path(ident,sizeof ident,root,"seed/ident.c");char *v[]={bound,"15","sh",product,ident,"--",root,0};np_result r;if(np_run(v,root,0,20,&r,why,sizeof why))die(why);if(r.rc||r.errn||r.outn!=65||r.out[64]!='\n')die("source identity");memcpy(out,r.out,64);out[64]=0;np_free(&r);}
static void adapt(const char *s,size_t n){
 const char *includes[]={"#include <stdio.h>","#include <stdlib.h>","#include <string.h>","#include <sys/stat.h>","#include \"../../include/unisa_sha256.h\"","#include <unistd.h>","#include <dirent.h>","#include <errno.h>","#include <fcntl.h>"};
 size_t at=0;unsigned mask=0;while(at<n){size_t end=at;while(end<n&&s[end]!='\n')end++;size_t len=end-at;int i,skip=0;for(i=0;i<9;i++)if(len==strlen(includes[i])&&!memcmp(s+at,includes[i],len)){if(mask&(1u<<i))die("duplicate include");mask|=1u<<i;skip=1;break;}if(!skip){if(len>=8&&!memcmp(s+at,"#include",8))die("new include requires explicit adaptation");np_put(&body,s+at,end-at+(end<n));}at=end+(end<n);}
 if(mask!=511)die("include contract changed");
}
static void output(const char *name,np_buf *b,int verify){char p[4400];path(p,sizeof p,work,name);if(verify){size_t n;char *s=load(p,&n);int ok=n==b->n&&!memcmp(s,b->p,n);free(s);if(!ok)die("material/receipt changed");return;}int f=open(p,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC|O_NOFOLLOW,0600);if(f<0)die("exclusive output");size_t at=0;while(at<b->n){ssize_t z=write(f,b->p+at,b->n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("write; partial retained");at+=(size_t)z;}if(fsync(f)||close(f))die("fsync/close");}
int main(int argc,char **argv){int verify=argc==5&&tx_eq(argv[1], "--verify", 1L << 20),i;if(verify){argc--;argv++;}if(argc!=4||!realpath(argv[1],root)||argv[2][0]!='/'||strlen(argv[2])>=sizeof work||argv[3][0]=='/'||strstr(argv[3],".."))die("usage ROOT ABS_NEW_DIR RELATIVE_FIXTURE");strcpy(work,argv[2]);path(product,sizeof product,root,"unisacc.com");path(fixture,sizeof fixture,root,argv[3]);char paths[4][4400],before[65],after[65],bootstrap[65],bh[65];path(paths[0],sizeof paths[0],root,"exec/c/resourceledger.h");path(paths[1],sizeof paths[1],root,"tools/ledger-material.cx");path(paths[2],sizeof paths[2],root,"tools/cxlib/netpack.cx");strcpy(paths[3],fixture);source_id(before);size_t n;char *s=load(product,&n);cx_sha256_hex(s,n,bootstrap);free(s);
 np_puts(&record,"ledger-material-v1\nstatus\tPREPARED\nscope\tsource-preserving-C-ledger-transition\nsource\t");np_puts(&record,before);np_puts(&record,"\nbootstrap\t");np_puts(&record,bootstrap);np_puts(&record,"\n");
 for(i=0;i<4;i++){s=load(paths[i],&n);if(memchr(s,0,n))die("NUL in source");cx_sha256_hex(s,n,hashes[i]);np_puts(&record,paths[i]);np_puts(&record,"\t");np_puts(&record,hashes[i]);np_puts(&record,"\n");if(i==0)adapt(s,n);if(i==3){const char *mark="/* LEDGER_BODY */";char *p=strstr(s,mark);if(p){if(strstr(p+1,mark))die("duplicate fixture delimiter");size_t at=(size_t)(p-s)+strlen(mark);np_buf joined={0};np_put(&joined,s,at);np_puts(&joined,"\n");np_put(&joined,body.p,body.n);np_puts(&joined,"\n");np_put(&joined,s+at,n-at);free(body.p);body=joined;}else{np_puts(&body,"\n");np_put(&body,s,n);}}free(s);}
 source_id(after);if(strcmp(before,after))die("source changed during preparation");s=load(product,&n);cx_sha256_hex(s,n,bh);free(s);if(strcmp(bootstrap,bh))die("bootstrap changed");for(i=0;i<4;i++){s=load(paths[i],&n);cx_sha256_hex(s,n,bh);free(s);if(strcmp(hashes[i],bh))die("input changed");}cx_sha256_hex(body.p,body.n,bh);np_puts(&record,"snapshot.cx\t");np_puts(&record,bh);np_puts(&record,"\n");if(!verify&&mkdir(work,0700))die("new output directory");output("snapshot.cx",&body,verify);output("material.tsv",&record,verify);puts(verify?"VERIFIED\tledger-material\tno-test-result":"PREPARED\tledger-material\tno-test-result");return 0;
}
