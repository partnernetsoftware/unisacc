/* tools/check-s8c-bind.cx -- usage of s8c-bind is a named refusal. */
#pragma unisa use cxlib.netpack
static int npass,nfail;
static void ck(int ok,const char *n){printf("%s\t%s\n",ok?"PASS":"FAIL",n);if(ok)npass++;else nfail++;}
int main(void){
    np_result r;char why[800];
    char *v[]={"sh","./unisacc.com","tools/s8c-bind.cx",0};
    if(np_run(v,".",0,20,&r,why,sizeof why)){fprintf(stderr,"%s\n",why);return 2;}
    ck(r.rc==2,"usage-rc2");
    ck(r.errn&&strstr(r.err,"usage: ROOT SESSION CANDIDATE MAP"),"usage-text");
    np_free(&r);
    printf("S8C_BIND\tpass=%d\tfail=%d\n",npass,nfail);
    return nfail?1:0;
}
