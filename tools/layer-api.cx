/* tools/layer-api.cx -- the frozen interface manifest of a tape-library package.
 *
 *   sh ./unisacc.com tools/layer-api.cx -- --write|--check [--pkg PKG] [--root ROOT] [--product FILE]
 *
 * For each package of ROOT/build/tlib-packages.tsv (or the one named by --pkg) the public
 * functions and types of its units are read from the product's own -cx-interface output and
 * written as ROOT/build/layer-api/PKG.tsv: name, signature, signature sha (16 hex), file.
 *
 * --write  regenerate the manifest. Prints the bump class against the manifest it replaces:
 *          none (same names and signatures), minor (only additions), major (a name or signature
 *          went away), new (no manifest before). The table's api_sha and version are NOT edited
 *          here: the line NEXT names the sha to put in the table together with the version bump.
 * --check  rc 1 unless, for every package checked:
 *          (1) the manifest file equals what the source gives now;
 *          (2) its sha256 equals the table's api_sha;
 *          (3) no unit uses an outer module: the use closure of every unit stays inside the
 *              package's own units and the units of its declared dependencies. A unit excluded
 *              from the package counts as outer (a packed object that needs it could not link).
 * One line per package: LAYER_API<TAB>pkg<TAB>ok|FAIL|WROTE<TAB>rows=N<TAB>units=M<TAB>api_sha=...
 * --bump   inside a git root computes api_sha and the content sha from the git INDEX (blobs), not the
 *          work tree; a source path of the package (units, exclusions) that differs between index and
 *          work tree (modified or untracked) is refused: rc 2 and `REFUSE<TAB>pkg<TAB>dirty-package-path<TAB>path`.
 *          --index-only skips that refusal and still reads the index. Outside a git root: the work tree.
 * Exit: 0 ok, 1 a check failed, 2 usage or an unreadable input.
 * Check: tools/check-layer-api.cx. */
#pragma unisa use cxlib.tlibpkg
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.proc
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use mem.heap

static TpPkg pk;
static TpPkg dp[TP_MAXD];
static char root[4096], product[4400];
/* Where content_sha reads the unit files: ROOT, or a snapshot of the git index (--bump in a git root). */
static char croot[4400];
static int index_only;

/* 1 when ROOT is itself the top level of a git work tree. */
static int is_git_root(void) {
    char *v[6], *o = 0, top[4400];
    size_t n = 0;
    int rc;
    v[0] = "git"; v[1] = "-C"; v[2] = root; v[3] = "rev-parse"; v[4] = "--show-toplevel"; v[5] = 0;
    rc = cx_runv_timeout(v, 20, &o, &n);
    if (rc != 0 || !o || n == 0) { mm_free(o); return 0; }
    while (n > 0 && (o[n - 1] == '\n' || o[n - 1] == '\r')) n--;
    if (n == 0 || n >= sizeof top) { mm_free(o); return 0; }
    o[n] = 0;
    rc = sy_realpath(o, top, sizeof top) >= 0 && tx_eqz(top, root);
    mm_free(o);
    return rc;
}

/* 1 when PATH (N bytes) is a source path of the loaded package pk (unit or exclusion). */
static int pkg_path(const char *s, long n) {
    int i;
    for (i = 0; i < pk.nunit; i++) if (tx_len(pk.unit[i], TX_ZCAP) == n && tx_same(pk.unit[i], n, s, n)) return 1;
    for (i = 0; i < pk.nexcl; i++) if (tx_len(pk.excl[i], TX_ZCAP) == n && tx_same(pk.excl[i], n, s, n)) return 1;
    return 0;
}

/* 0 when no source path of pk differs between the index and the work tree (untracked included);
   else prints REFUSE lines naming each dirty path and returns 1. Staged-only changes are clean. */
static int dirty_refuse(void) {
    char *v[8], *o = 0;
    size_t n = 0;
    long i = 0, e;
    int bad = 0;
    v[0] = "git"; v[1] = "-C"; v[2] = root; v[3] = "status"; v[4] = "--porcelain";
    v[5] = "--untracked-files=all"; v[6] = 0;
    if (cx_runv_timeout(v, 30, &o, &n) != 0 || !o) { mm_free(o); sy_eprintf("layer-api: git status failed\n"); return 2; }
    while (i < (long)n) {
        e = i;
        while (e < (long)n && o[e] != '\n') e++;
        if (e - i > 3 && o[i + 1] != ' ' && pkg_path(o + i + 3, e - i - 3)) {
            sy_printf("REFUSE\t%s\tdirty-package-path\t%.*s\n", pk.pkg, (int)(e - i - 3), o + i + 3);
            bad = 1;
        }
        i = e + 1;
    }
    mm_free(o);
    return bad;
}

/* checkout-index the given source paths of P from the index into PRE (ends with '/'). 0, or 2. */
static int export_paths(const char *pre, const char **p, int np) {
    char *v[128], pf[4420], *o = 0;
    size_t n = 0;
    int i = 0, k, rc;
    if (cx_fmt(pf, sizeof pf, "--prefix=%s", pre)) return 2;
    while (i < np) {
        k = 0;
        v[k++] = "git"; v[k++] = "-C"; v[k++] = root; v[k++] = "checkout-index"; v[k++] = pf; v[k++] = "--";
        while (i < np && k < 120) v[k++] = (char *)p[i++];
        v[k] = 0;
        rc = cx_runv_timeout(v, 30, &o, &n);
        mm_free(o); o = 0;
        if (rc) return 2;
    }
    return 0;
}

/* Export the index blobs of every unit and exclusion of pk and of its dependencies into a fresh directory
   under ROOT/.trash (snap). 0, or 2. */
static int index_export(char *snap, long sl) {
    char pre[4410], dot[4400], why[512];
    const char *ps[TP_MAXU + TP_MAXX];
    int i, d, np;
    if (cx_fmt(dot, sizeof dot, "%s/.trash", root) || cx_fmt(snap, (size_t)sl, "%s/idx-%d-%ld", dot, sy_pid(), sy_now_ms()) ||
        cx_fmt(pre, sizeof pre, "%s/", snap)) return 2;
    (void)sy_mkdir(dot, 0755);
    if (sy_mkdir(snap, 0755)) return 2;
    np = 0;
    for (i = 0; i < pk.nunit; i++) ps[np++] = pk.unit[i];
    for (i = 0; i < pk.nexcl; i++) ps[np++] = pk.excl[i];
    if (export_paths(pre, ps, np)) return 2;
    for (d = 0; d < pk.ndep; d++) {
        if (tp_load(root, pk.dep_pkg[d], &dp[d], why, sizeof why)) return 2;
        np = 0;
        for (i = 0; i < dp[d].nunit; i++) ps[np++] = dp[d].unit[i];
        for (i = 0; i < dp[d].nexcl; i++) ps[np++] = dp[d].excl[i];
        if (export_paths(pre, ps, np)) return 2;
    }
    return 0;
}

/* 1 when manifest B has a row with the same name, signature and signature sha as the row at
   L[0..n): the first three fields, whatever file declares them. */

/* 1 when manifest B has a row with the same name, signature and signature sha as the row at
   L[0..n): the first three fields, whatever file declares them. */
static int has_row(const char *b, long bn, const char *l, long n) {
    long o1, l1, o2, l2, i = 0, e, key;
    if (tx_field(l, n, '\t', 2, &o1, &l1)) return 0;
    key = o1 + l1;
    while (i < bn) {
        e = i;
        while (e < bn && b[e] != '\n') e++;
        if (e - i > key && b[i] != '#' && b[i + key] == '\t' && tx_same(b + i, key, l, key) &&
            !tx_field(b + i, e - i, '\t', 2, &o2, &l2) && o2 + l2 == key) return 1;
        i = e + 1;
    }
    return 0;
}

/* 1 when some row of A is missing from B. */
static int lost_rows(const char *a, long an, const char *b, long bn) {
    long i = 0, e;
    while (i < an) {
        e = i;
        while (e < an && a[e] != '\n') e++;
        if (e > i && a[i] != '#' && !has_row(b, bn, a + i, e - i)) return 1;
        i = e + 1;
    }
    return 0;
}

/* 0 when every unit's closure stays inside the package and its dependencies. */
static int outer_check(void) {
    char why[512];
    int u, d, bad = 0;
    for (d = 0; d < pk.ndep; d++)
        if (tp_load(root, pk.dep_pkg[d], &dp[d], why, sizeof why)) {
            sy_printf("OUTER\t%s\tdependency-unreadable\t%s\n", pk.pkg, why);
            return 1;
        }
    for (u = 0; u < pk.nunit; u++) {
        char *c = tp_closure(root, product, pk.unit[u], why, sizeof why);
        long n, i = 0, e;
        if (!c) { sy_printf("OUTER\t%s\tclosure-unreadable\t%s\n", pk.unit[u], why); return 1; }
        n = tx_len(c, TX_ZCAP);
        while (i < n) {
            char one[4400];
            int in = 0;
            e = i;
            while (e < n && c[e] != '\n') e++;
            if (e > i && !tx_copy(one, sizeof one, c + i, e - i)) {
                if (tp_find_unit(&pk, one) >= 0) in = 1;
                for (d = 0; d < pk.ndep && !in; d++) if (tp_find_unit(&dp[d], one) >= 0) in = 1;
                if (!in) {
                    sy_printf("OUTER\t%s\tuses\t%s\t%s\n", pk.unit[u], one,
                              tp_find_excl(&pk, one) >= 0 ? "excluded-from-package" : "outside-package-and-deps");
                    bad = 1;
                }
            }
            i = e + 1;
        }
        mm_free(c);
    }
    return bad;
}

/* Content identity: sha256 over the sorted lines "unit<TAB>path<TAB>source-sha" of the package's units
   and "excl<TAB>path<TAB>source-sha-or-dash" of its exclusions (paths relative to ROOT). 0, or 2. */
static int content_sha(const char *name, char hex[65]) {
    static char ord[TP_MAXU + TP_MAXX];
    char why[512], fh[65], line[4800], p[4400];
    TpBuf b = {0, 0, 0, 0};
    int i, j, n, t;
    if (tp_load(root, name, &pk, why, sizeof why)) { sy_eprintf("layer-api: %s\n", why); return 2; }
    n = pk.nunit + pk.nexcl;
    for (i = 0; i < n; i++) ord[i] = (char)i;
    for (i = 1; i < n; i++) {
        t = ord[i];
        for (j = i - 1; j >= 0; j--) {
            const char *a = ord[j] < pk.nunit ? pk.unit[(int)ord[j]] : pk.excl[ord[j] - pk.nunit];
            const char *c = t < pk.nunit ? pk.unit[t] : pk.excl[t - pk.nunit];
            int ka = ord[j] < pk.nunit ? 0 : 1, kc = t < pk.nunit ? 0 : 1;
            if (ka < kc || (ka == kc && tx_cmp(a, tx_len(a, TX_ZCAP), c, tx_len(c, TX_ZCAP)) <= 0)) break;
            ord[j + 1] = ord[j];
        }
        ord[j + 1] = (char)t;
    }
    for (i = 0; i < n; i++) {
        int isu = ord[i] < pk.nunit;
        const char *rel = isu ? pk.unit[(int)ord[i]] : pk.excl[ord[i] - pk.nunit];
        if (cx_fmt(p, sizeof p, "%s/%s", croot, rel)) return 2;
        if (tp_sha_file(p, fh)) {
            if (isu) { sy_eprintf("layer-api: unreadable unit %s\n", rel); return 2; }
            fh[0] = '-'; fh[1] = 0;
        }
        if (cx_fmt(line, sizeof line, isu ? "unit\t%s\t%s\n" : "excl\t%s\t%s\n", rel, fh)) return 2;
        tp_puts(&b, line);
    }
    if (b.bad || !b.b) return 2;
    tp_sha(b.b, (size_t)b.n, hex);
    mm_free(b.b);
    return 0;
}

static int one_freeze(const char *name) {
    char hex[65];
    int r = content_sha(name, hex);
    if (r) return r;
    sy_printf("VERSIONED\t%s\t%s\tfrozen=%s\n", name, pk.version, hex);
    return 0;
}

/* Rewrite PKG's row of build/tlib-packages.tsv: version, api_sha, frozen (ninth field). 0, or 2. */
static int set_row(const char *name, const char *ver, const char *api, const char *frozen) {
    char path[4400], f[9][600];
    size_t n = 0;
    char *t = 0;
    long i = 0, e, k, o, l;
    TpBuf b = {0, 0, 0, 0};
    int hit = 0;
    if (cx_fmt(path, sizeof path, "%s/build/tlib-packages.tsv", root)) return 2;
    t = cx_read(path, &n);
    if (!t) return 2;
    while (i < (long)n) {
        e = i;
        while (e < (long)n && t[e] != '\n') e++;
        if (t[i] != '#' && !tx_field(t + i, e - i, '\t', 0, &o, &l) && l == tx_len(name, 128) && tx_same(t + i + o, l, name, l)) {
            for (k = 0; k < 9; k++) {
                if (tx_field(t + i, e - i, '\t', (int)k, &o, &l)) { f[k][0] = '-'; f[k][1] = 0; }
                else if (tx_copy(f[k], sizeof f[k], t + i + o, l)) { mm_free(t); return 2; }
            }
            tx_copy(f[1], sizeof f[1], ver, tx_len(ver, 64));
            tx_copy(f[2], sizeof f[2], api, 64);
            tx_copy(f[8], sizeof f[8], frozen, 64);
            for (k = 0; k < 9; k++) { if (k) tp_put(&b, "\t", 1); tp_puts(&b, f[k]); }
            tp_put(&b, "\n", 1);
            hit = 1;
        } else {
            tp_put(&b, t + i, e - i);
            if (e < (long)n) tp_put(&b, "\n", 1);
        }
        i = e + 1;
    }
    mm_free(t);
    if (!hit || b.bad || cx_write(path, b.b, (size_t)b.n)) { mm_free(b.b); return 2; }
    mm_free(b.b);
    return 0;
}

/* build/tlib-policy.tsv: 1 when PKG is declared stable (row PKG, else row `stable`, else yes; missing file = yes). */
static int pkg_stable(const char *name) {
    char tp[4400], *t;
    size_t tn = 0;
    long i = 0, e, o, l, o2, l2;
    int glob = 1, per = -1;
    if (cx_fmt(tp, sizeof tp, "%s/build/tlib-policy.tsv", root) || !(t = cx_read(tp, &tn))) return 1;
    while (i < (long)tn) {
        e = i;
        while (e < (long)tn && t[e] != '\n') e++;
        if (t[i] != '#' && !tx_field(t + i, e - i, '\t', 0, &o, &l) && !tx_field(t + i, e - i, '\t', 1, &o2, &l2)) {
            int yes = l2 == 3 && tx_same(t + i + o2, l2, "yes", 3);
            if (l == 6 && tx_same(t + i + o, l, "stable", 6)) glob = yes;
            else if (l == tx_len(name, 128) && tx_same(t + i + o, l, name, l)) per = yes;
        }
        i = e + 1;
    }
    mm_free(t);
    return per >= 0 ? per : glob;
}

/* --bump: class from the api diff against the committed manifest (unchanged -> z, additive -> y,
   breaking -> x), then version, api_sha, content sha and the manifest are rewritten together.
   Pre-stable (build/tlib-policy.tsv) caps the class at z. */
static int one_bump(const char *name) {
    char why[512], path[4400], dir[4400], hex[65], fz[65], nv[40], cur[65], *api, *old;
    long an = 0;
    size_t on = 0;
    int rows = 0, v[3], cls;
    const char *what;
    if (tp_load(root, name, &pk, why, sizeof why)) { sy_eprintf("layer-api: %s\n", why); return 2; }
    {
        char snap[4400];
        int git = is_git_root(), fr = 0;
        snap[0] = 0;
        if (git) {
            if (!index_only && dirty_refuse()) return 2;
            if (index_export(snap, sizeof snap) || sy_chdir(snap)) { sy_eprintf("layer-api: cannot export the index\n"); if (snap[0]) cx_rmtree(snap); (void)sy_chdir(root); return 2; }
            tx_copy(croot, sizeof croot, snap, tx_len(snap, TX_ZCAP));
        }
        api = tp_api(product, &pk, &an, &rows, why, sizeof why);
        if (api) { tp_sha(api, (size_t)an, hex); fr = content_sha(name, fz); }
        if (git) { (void)sy_chdir(root); cx_rmtree(snap); tx_copy(croot, sizeof croot, root, tx_len(root, TX_ZCAP)); }
        if (!api) { sy_eprintf("layer-api: %s\n", why); return 2; }
        if (fr) { mm_free(api); return 2; }
    }
    if (cx_fmt(dir, sizeof dir, "%s/build/layer-api", root) || cx_fmt(path, sizeof path, "%s/%s.tsv", dir, name)) return 2;
    if (tp_ver_parse(pk.version, v)) { sy_eprintf("layer-api: bad version of %s\n", name); return 2; }
    old = cx_read(path, &on);
    if (old && tx_eqz(hex, pk.api_sha)) cls = 3;
    else cls = old ? (lost_rows(old, (long)on, api, an) ? 1 : lost_rows(api, an, old, (long)on) ? 2 : 3) : 2;
    cur[0] = 0;
    {
        char tp[4400], *t;
        size_t tn = 0;
        long i = 0, e, o, l, o2, l2;
        if (!cx_fmt(tp, sizeof tp, "%s/build/tlib-packages.tsv", root) && (t = cx_read(tp, &tn))) {
            while (i < (long)tn) {
                e = i;
                while (e < (long)tn && t[e] != '\n') e++;
                if (t[i] != '#' && !tx_field(t + i, e - i, '\t', 0, &o, &l) && l == tx_len(name, 128) &&
                    tx_same(t + i + o, l, name, l) && !tx_field(t + i, e - i, '\t', 8, &o2, &l2) && l2 == 64)
                    tx_copy(cur, 65, t + i + o2, 64);
                i = e + 1;
            }
            mm_free(t);
        }
    }
    if (cur[0] && tx_eqz(cur, fz) && tx_eqz(hex, pk.api_sha)) {
        sy_printf("BUMP\t%s\tunchanged\t%s\n", name, pk.version);
        mm_free(old); mm_free(api);
        return 0;
    }
    if (!cur[0]) { what = "adopt"; tx_copy(nv, sizeof nv, pk.version, tx_len(pk.version, 32)); }
    else {
        if (cls != 3 && !pkg_stable(name)) {
            sy_printf("BUMP\t%s\tpre-stable class=z (would be %s)\n", name, cls == 1 ? "x" : "y");
            cls = 3;
        }
        if (cls == 1) { v[0]++; v[1] = 0; v[2] = 0; what = "major"; }
        else if (cls == 2) { v[1]++; v[2] = 0; what = "minor"; }
        else { v[2]++; what = "patch"; }
        if (cx_fmt(nv, sizeof nv, "%d.%d.%d", v[0], v[1], v[2])) return 2;
    }
    (void)sy_mkdir(dir, 0755);
    if (cx_write(path, api, (size_t)an) || set_row(name, nv, hex, fz)) { sy_eprintf("layer-api: cannot rewrite %s\n", name); return 2; }
    sy_printf("BUMP\t%s\t%s\t%s -> %s\tapi_sha=%s\tfrozen=%s\n", name, what, pk.version, nv, hex, fz);
    mm_free(old); mm_free(api);
    return 0;
}

static int one_pkg(const char *name, int write) {
    char why[512], path[4400], dir[4400], hex[65];
    char *api, *old;
    long an = 0;
    size_t on = 0;
    int rows = 0, bad = 0;
    if (tp_load(root, name, &pk, why, sizeof why)) { sy_eprintf("layer-api: %s\n", why); return 2; }
    api = tp_api(product, &pk, &an, &rows, why, sizeof why);
    if (!api) { sy_eprintf("layer-api: %s\n", why); return 2; }
    tp_sha(api, (size_t)an, hex);
    if (cx_fmt(dir, sizeof dir, "%s/build/layer-api", root) || cx_fmt(path, sizeof path, "%s/%s.tsv", dir, name)) return 2;
    old = cx_read(path, &on);
    if (write) {
        const char *bump = "new";
        if (old) bump = lost_rows(old, (long)on, api, an) ? "major" : lost_rows(api, an, old, (long)on) ? "minor" : "none";
        (void)sy_mkdir(dir, 0755);
        if (cx_write(path, api, (size_t)an)) { sy_eprintf("layer-api: cannot write %s\n", path); return 2; }
        sy_printf("LAYER_API\t%s\tWROTE\trows=%d\tunits=%d\tapi_sha=%s\tbump=%s\n", name, rows, pk.nunit, hex, bump);
        if (!tx_eqz(hex, pk.api_sha))
            sy_printf("NEXT\t%s\tset api_sha to %s in build/tlib-packages.tsv with a %s version bump (now %s)\n",
                      name, hex, bump, pk.version);
        mm_free(old);
        mm_free(api);
        return 0;
    }
    if (!old) { sy_printf("DIFF\t%s\tmanifest-missing\t%s\n", name, path); bad = 1; }
    else if ((long)on != an || !mm_same(old, api, an)) {
        sy_printf("DIFF\t%s\tmanifest-differs-from-source\t%s\n", name,
                  lost_rows(old, (long)on, api, an) ? "major" : "minor");
        bad = 1;
    }
    if (!tx_eqz(hex, pk.api_sha)) { sy_printf("DIFF\t%s\ttable-api-sha\ttable=%s\tsource=%s\n", name, pk.api_sha, hex); bad = 1; }
    if (outer_check()) bad = 1;
    sy_printf("LAYER_API\t%s\t%s\trows=%d\tunits=%d\tapi_sha=%s\n", name, bad ? "FAIL" : "ok", rows, pk.nunit, hex);
    mm_free(old);
    mm_free(api);
    return bad;
}

int main(int argc, char **argv) {
    const char *only = 0, *rarg = ".", *parg = 0;
    char *names;
    long nn = 0, i = 0, e;
    int write = -1, k, rc = 0, seen = 0;
    for (k = 1; k < argc; k++) {
        if (tx_eqz(argv[k], "--write") && write < 0) write = 1;
        else if (tx_eqz(argv[k], "--check") && write < 0) write = 0;
        else if (tx_eqz(argv[k], "--freeze") && write < 0 && k + 1 < argc) { write = 2; only = argv[++k]; }
        else if (tx_eqz(argv[k], "--bump") && write < 0 && k + 1 < argc) { write = 3; only = argv[++k]; }
        else if (tx_eqz(argv[k], "--index-only")) index_only = 1;
        else if (tx_eqz(argv[k], "--pkg") && k + 1 < argc) only = argv[++k];
        else if (tx_eqz(argv[k], "--root") && k + 1 < argc) rarg = argv[++k];
        else if (tx_eqz(argv[k], "--product") && k + 1 < argc) parg = argv[++k];
        else { write = -1; break; }
    }
    if (write < 0) {
        sy_eprintf("layer-api: usage: --write|--check|--freeze PKG|--bump PKG [--pkg PKG] [--root ROOT] [--product FILE]\n");
        return 2;
    }
    if (sy_realpath(rarg, root, sizeof root) < 0) { sy_eprintf("layer-api: bad root %s\n", rarg); return 2; }
    if (parg) { if (sy_realpath(parg, product, sizeof product) < 0) { sy_eprintf("layer-api: bad product %s\n", parg); return 2; } }
    else if (cx_fmt(product, sizeof product, "%s/unisacc.com", root)) return 2;
    if (sy_chdir(root)) { sy_eprintf("layer-api: cannot enter %s\n", root); return 2; }
    tx_copy(croot, sizeof croot, root, tx_len(root, TX_ZCAP));
    names = tp_names(root, &nn);
    if (!names) { sy_eprintf("layer-api: cannot read %s/build/tlib-packages.tsv\n", root); return 2; }
    while (i < nn) {
        char name[64];
        e = i;
        while (e < nn && names[e] != '\n') e++;
        if (e > i && !tx_copy(name, sizeof name, names + i, e - i) && (!only || tx_eqz(only, name))) {
            int r = write == 2 ? one_freeze(name) : write == 3 ? one_bump(name) : one_pkg(name, write);
            seen++;
            if (r > rc) rc = r;
        }
        i = e + 1;
    }
    mm_free(names);
    if (!seen) { sy_eprintf("layer-api: no such package: %s\n", only ? only : "(table empty)"); return 2; }
    return rc;
}
