#pragma unisa use sys.io
#pragma unisa use text.text
/* exec/facts/inc-abspath.tsv: drive-letter absolute #include per target.
   sh ./unisacc.com tools/inc-abspath-gen.cx -- --check
   win rows are 1, others 0. The INC2 chain and PD.drive CMPI byte must match. */
#define TSV "exec/facts/inc-abspath.tsv"
#define BYTE "exec/pp/directive-body-byte.tsv"
#define RES "exec/pp/directive-body-result.tsv"
#define PDB "exec/pp/shared-predefine-byte.tsv"
#define PDR "exec/pp/shared-predefine-result.tsv"
#define NROW 6

static const char *want_os[NROW] = {"lnx","lnx","osx","osx","win","win"};
static const char *want_arch[NROW] = {"x86_64","arm64","x86_64","arm64","x86_64","arm64"};
static const char *want_bit[NROW] = {"0","0","0","0","1","1"};

static int fail(const char *w) {
    sy_eprintf("inc-abspath-gen\tFAIL\t%s\n", w);
    return 1;
}

static int has_line(const char *path, const char *s) {
    size_t n = 0, sl = 0, i;
    char *b = cx_read(path, &n);
    if (!b) return 0;
    while (s[sl]) sl++;
    if (sl == 0 || n < sl) return 0;
    for (i = 0; i + sl <= n; i++) {
        size_t k = 0;
        while (k < sl && b[i + k] == s[k]) k++;
        if (k == sl) return 1;
    }
    return 0;
}

static int parse_facts(void) {
    size_t n = 0, i = 0;
    char *b = cx_read(TSV, &n);
    int row = 0, saw = 0;
    if (!b || n == 0 || b[n - 1] != '\n') return fail("tsv-read");
    while (i < n) {
        size_t e = i;
        while (e < n && b[e] != '\n') e++;
        b[e] = 0;
        if (!saw) {
            if (!tx_eqz(b + i, "# os\tarch\tdrive_letter")) return fail("tsv-header");
            saw = 1;
        } else if (b[i] != '#') {
            const char *f[3];
            int len[3], k = 0, start = 0, p;
            int ln = (int)(e - i);
            for (p = 0; p <= ln; p++) {
                if (p == ln || b[i + p] == '\t') {
                    if (k >= 3) return fail("row-fields");
                    f[k] = b + i + start;
                    len[k] = p - start;
                    k++;
                    start = p + 1;
                }
            }
            if (k != 3 || row >= NROW) return fail("row-count");
            if (len[0] != 3 || len[1] < 5 || len[2] != 1) return fail("row-shape");
            /* tx_eqz on non-z: compare manually */
            {
                int j;
                for (j = 0; j < len[0]; j++) if (f[0][j] != want_os[row][j]) return fail("os-order");
                if (want_os[row][len[0]]) return fail("os-order");
                for (j = 0; j < len[1]; j++) if (f[1][j] != want_arch[row][j]) return fail("arch-order");
                if (want_arch[row][len[1]]) return fail("arch-order");
                if (f[2][0] != want_bit[row][0]) return fail("bit");
            }
            row++;
        }
        i = e + 1;
    }
    if (row != NROW) return fail("row-count");
    return 0;
}

int main(int argc, char **argv) {
    if (argc != 2 || !tx_eqz(argv[1], "--check")) {
        sy_eprintf("inc-abspath-gen\tusage\t--check\n");
        return 2;
    }
    if (parse_facts()) return 1;
    if (!has_line(BYTE, "INC2\t65-90,97-122\tINC2.d1")) return fail("inc2-letter");
    if (!has_line(BYTE, "INC2.d1\t58\tINC2.d2")) return fail("inc2-colon");
    if (!has_line(BYTE, "INC2.d2\t47,92\tINC2.d3")) return fail("inc2-slash");
    if (!has_line(BYTE, "INC2.d3\t*\tINC2.drv")) return fail("inc2-drv");
    if (!has_line(BYTE, "INC2.c\t*\tINC4")) return fail("inc2-c");
    if (!has_line(RES, "INC2.drv\t1\tKEY.S")) return fail("drv-win");
    if (!has_line(RES, "INC2.f\t1\tKEY.S")) return fail("slash-f");
    if (!has_line(RES, "INC2.drv\t0,2\tINC2Q")) return fail("drv-rel");
    if (!has_line(PDB, "CMPI\",\"DRIVEB\",119")) return fail("pd-cmp");
    if (!has_line(PDR, "LDI\",\"DRIVEABS\",1")) return fail("pd-win");
    if (!has_line(PDR, "LDI\",\"DRIVEABS\",0")) return fail("pd-posix");
    sy_eprintf("inc-abspath-gen\tCHECK\trows=%d\n", NROW);
    return 0;
}
