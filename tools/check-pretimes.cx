/* tools/check-pretimes.cx -- contract check of cxlib.pretimes (the one precommit timing ledger writer).
 *
 *   cx tools/check-pretimes.cx --
 *
 * (1) pt_row writes the header once and then one TAB row per call: time, committer, node, ms, verdict.
 * (2) UNISACC_PRECOMMIT_TIMES names the file; "off" disables the ledger entirely (no append).
 * (3) The committer comes from DEVSVC_OWNER (USER when unset), a TAB or newline in it becomes "_"
 *     (a row stays one line with five fields), and it is cut at 60 bytes.
 * (4) pt_total records now-T0 ms and answers PASS for blocked=0, BLOCK otherwise.
 * Last line CHECK_PRETIMES<TAB>assertions=N<TAB>failed=M, rc 0 when M is 0. */
#pragma unisa use cxlib.pretimes
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.time
#pragma unisa use sys.proc
#pragma unisa use mem.heap

static int nas, failed;
static void ck(int ok, const char *name) {
    nas++;
    if (!ok) failed++;
    sy_printf("%s\tpretimes.%s\n", ok ? "PASS" : "FAIL", name);
}

/* the line B[START..END) split on TAB; returns the field count (0 for an empty line) */
static int fields(const char *b, long start, long end, const char *f[6], long fl[6]) {
    int n = 0; long q = start, s;
    if (end <= start) return 0;
    while (q <= end && n < 6) {
        s = q;
        while (q < end && b[q] != '\t') q++;
        f[n] = b + s; fl[n] = q - s; n++;
        q++;
    }
    return n;
}
/* start offset and length of the 0-based LINE in B (length 0 when past the end) */
static long line_at(const char *b, long n, long line, long *off) {
    long at = 0, k = 0;
    while (at < n) {
        long e = at;
        while (e < n && b[e] != '\n') e++;
        if (k == line) { *off = at; return e - at; }
        at = e + 1; k++;
    }
    *off = n;
    return 0;
}
static long lines(const char *b, long n) {
    long at = 0, c = 0;
    while (at < n) { long e = at; while (e < n && b[e] != '\n') e++; c++; at = e + 1; }
    return c;
}
static int eq(const char *p, long n, const char *v) { long m = (long)strlen(v); return n == m && !memcmp(p, v, (size_t)n); }
/* the decimal value of field P[0..N), or -1 when it is not all digits */
static long num(const char *p, long n) {
    long v = 0, i;
    if (n <= 0) return -1;
    for (i = 0; i < n; i++) { if (p[i] < '0' || p[i] > '9') return -1; v = v * 10 + (p[i] - '0'); }
    return v;
}

static char *slurp(const char *p, long *n) {
    size_t sz = 0;
    char *b = (char *)cx_read(p, &sz);
    *n = b ? (long)sz : 0;
    return b;
}

int main(int argc, char **argv) {
    char tp[400];
    long n = 0; const char *td = sy_tmpdir(); char *b;
    (void)argc; (void)argv;
    if (!td || !td[0]) { sy_printf("FAIL\tpretimes.no-tmpdir\n"); return 2; }
    if (snprintf(tp, sizeof tp, "%s/check-pretimes-%d.tsv", td, (int)sy_pid()) >= (int)sizeof tp) return 2;
    sy_unlink(tp);
    sy_setenv("UNISACC_PRECOMMIT_TIMES", tp, 1);
    {   /* (1) header once, then one row per call */
        long o, l;
        pt_row("lint", 11, "PASS");
        pt_row("ratchets", 22, "FAIL");
        b = slurp(tp, &n);
        ck(b && lines(b, n) == 3, "header-once-two-rows");
        l = line_at(b, n, 0, &o);
        ck(eq(b + o, l, "time\tcommitter\tnode\tms\tverdict"), "header");
        l = line_at(b, n, 1, &o);
        { const char *f[6]; long fl[6]; int nf = fields(b, o, o + l, f, fl);
          ck(nf == 5 && fl[0] > 0 && fl[1] > 0 && eq(f[2], fl[2], "lint") && eq(f[3], fl[3], "11") && eq(f[4], fl[4], "PASS"), "row-fields"); }
        l = line_at(b, n, 2, &o);
        { const char *f[6]; long fl[6]; int nf = fields(b, o, o + l, f, fl);
          ck(nf == 5 && eq(f[2], fl[2], "ratchets") && eq(f[3], fl[3], "22") && eq(f[4], fl[4], "FAIL"), "second-row"); }
        if (b) mm_free(b);
    }
    {   /* (2) off disables */
        long n2 = 0; char *b2;
        sy_setenv("UNISACC_PRECOMMIT_TIMES", "off", 1);
        pt_row("lint", 33, "PASS");
        b2 = slurp(tp, &n2);
        ck(b2 && lines(b2, n2) == 3, "off-writes-nothing");
        if (b2) mm_free(b2);
        sy_setenv("UNISACC_PRECOMMIT_TIMES", tp, 1);
    }
    {   /* (3) committer sanitising and cut */
        long o, l;
        sy_setenv("DEVSVC_OWNER", "a\tb\nc", 1);
        pt_row("gate", 1, "RAN");
        b = slurp(tp, &n);
        l = line_at(b, n, 3, &o);
        { const char *f[6]; long fl[6]; int nf = fields(b, o, o + l, f, fl);
          ck(nf == 5 && eq(f[1], fl[1], "a_b_c"), "committer-sanitised"); }
        if (b) mm_free(b);
        { char who[120]; int i; for (i = 0; i < 100; i++) who[i] = 'x'; who[100] = 0; sy_setenv("DEVSVC_OWNER", who, 1); }
        pt_row("gate2", 2, "RAN");
        b = slurp(tp, &n);
        l = line_at(b, n, 4, &o);
        { const char *f[6]; long fl[6]; int nf = fields(b, o, o + l, f, fl);
          ck(nf == 5 && fl[1] == 60, "committer-cut-60"); }
        if (b) mm_free(b);
    }
    {   /* (4) pt_total verdict and elapsed */
        long o, o2, t0 = sy_now_ms() - 5;
        sy_unsetenv("DEVSVC_OWNER");
        pt_total(t0, "precommit", 0);
        pt_total(t0, "precommit", 1);
        b = slurp(tp, &n);
        { long l = line_at(b, n, 5, &o);
          const char *f[6]; long fl[6]; int nf = fields(b, o, o + l, f, fl);
          ck(nf == 5 && num(f[3], fl[3]) >= 5 && eq(f[2], fl[2], "precommit") && eq(f[4], fl[4], "PASS"), "total-pass"); }
        { long l = line_at(b, n, 6, &o2);
          const char *f[6]; long fl[6]; int nf = fields(b, o2, o2 + l, f, fl);
          ck(nf == 5 && eq(f[4], fl[4], "BLOCK"), "total-block"); }
        if (b) mm_free(b);
    }
    sy_unsetenv("UNISACC_PRECOMMIT_TIMES");
    sy_unlink(tp);
    sy_printf("CHECK_PRETIMES\tassertions=%d\tfailed=%d\n", nas, failed);
    return failed ? 1 : 0;
}
