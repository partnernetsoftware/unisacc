/* mutation-gate.cx -- author-side mutation gate: does a check really detect faults in the code a patch adds?
 *
 * Usage (cwd = a repo checkout with ./unisacc.com; the gate never writes into it):
 *   mutation-gate.cx -- run  --patch P --base REV --check 'CMD' [--check 'CMD'...] --out DIR
 *                            [--repo R] [--max N] [--par N] [--min-score F] [--coverage-check]
 *                            [--mutate-checks] [--git] [--deadline-s S (30..3600, default 280)]
 *       --git: the private tree becomes a git repo with the patch committed (for checks using git grep/diff).
 *       prep + workers + report in one call.  It may exceed 55 s: start it with
 *       `devsvc x --bg --par 1 -- sh ./unisacc.com tools/mutation-gate.cx -- run ...` and `devsvc wait`.
 *   mutation-gate.cx -- prep   (same options)  private tree + mutants + baseline check, bounded under 55 s
 *   mutation-gate.cx -- worker --out DIR --slot K   runs mutants with id % par == K in DIR/slot-K
 *   mutation-gate.cx -- report --out DIR [--min-score F] [--allow-uncovered FILE] [--adjudicated FILE]
 *   mutation-gate.cx -- execution --produce 'CMD' --judge 'CMD' --assertion PASS_NAME
 *                           --expect-missing FAIL_NAME --expect-stale FAIL_NAME [--timeout-s N]
 *       Each command receives RUN_ID ($1) and EVIDENCE_PATH ($2) in the current checkout.
 *       Produce a previous green run, judge both mutations under a fresh ID, then prove that ID can pass.
 *       Judge stdout must contain exactly one matching PASS/FAIL<TAB>NAME line, with rc 0/1 respectively.
 *       Missing evidence and stale evidence require different named refusals.
 *       Both fixed mutations must be killed. Infrastructure failures refuse with rc 2.
 *   mutation-gate.cx -- run|prep ... --report [--expect-fail NAME|--expect-rc N]...
 *       --report records assertion evidence per mutant without replacing the existing gate verdict.
 *       An expectation applies to the preceding --check and may be repeated. An assertion name
 *       matches a whole FAIL record. Infrastructure exits cannot be declared as expected.
 *       --report --out DIR (or report --report --out DIR) also writes mutation-quality.tsv.
 *       run and report both take --allow-uncovered FILE and --adjudicated FILE:
 *       --allow-uncovered: TSV rows `file<TAB>function<TAB>reason`, one per uncovered function the reviewer
 *         accepts; an uncovered function not listed makes the verdict FAIL.
 *       --adjudicated: TSV rows `file<TAB>line<TAB>mutation<TAB>equivalent|out-of-scope<TAB>reason`; a surviving
 *         mutant whose file and line match and whose mutation equals its description or kind leaves the
 *         denominator.  Other verdict words, or a row without reason, is a refusal (rc 2).
 *
 * prep: `git -C R archive REV` is unpacked into DIR/slot-0 and P is applied with `git apply`; slots 1..par-1
 * are copies.  Only added lines of .cx/.c files are mutated; blank lines, comment lines, preprocessor lines and
 * (unless --mutate-checks) files named check-*.cx are skipped.
 * Operators: cmp (== != < <= > >= swapped, boundary), neg (if (x) -> if (!(x))), int (n -> n+1 / 1 -> 0),
 * str (one character of a string literal), del (drop a return / blocked += / rcpt_set statement, or turn a
 * call statement into 0), arg (drop the last argument of a call with >= 2 arguments), logic (&& <-> ||).
 * At most --max (default 30) are picked round robin over (file, operator) buckets.  --coverage-check adds one
 * `cov` mutant per touched function: `*(volatile int *)0 = 0;` right after its opening brace; a surviving cov
 * mutant means the checks never execute that function (typical cause: the check tests its own copy).
 * worker: per mutant the line is replaced in the slot tree, the file must still compile
 * (`sh ./unisacc.com -c -funit FILE -o TMP`; compile failures are discarded and counted), then every check
 * runs in the slot (cwd = slot, ckk_sh_t, at most 55 s each, inside `setsid` so the process group is killed
 * on return); a mutant is killed when some check has rc != 0 or prints failed=N with N > 0.  The original
 * file is restored before the next mutant.
 * report: DIR/survivors.tsv (id file line kind mutated-line), DIR/SUMMARY and the line
 *   MUTATION_GATE mutants=N killed=K survived=S compile_fail=C missing=X score=K/N(=F) adjudicated=A
 *                 score_adj=K/(N-A)(=G) min=M verdict=PASS|FAIL
 * (cov mutants are reported apart as MUTATION_COVERAGE funcs=N covered=K uncovered=U allowed=W, followed by
 * one MG_UNCOVERED file func allowed|blocking line per uncovered function).  rc 0 when the adjudicated score
 * >= min-score (default 0.6) and every uncovered function is listed in --allow-uncovered, rc 1 otherwise,
 * rc 2 on refusal
 * (bad arguments, patch does not apply, baseline check not green, no mutant).  N = 0 is a refusal.
 *

 * Two usage traps, both learned the hard way:
 * (1) --check is all-or-nothing against the baseline: passing only the driver patch without its check
 *     patch leaves the tree's own check red, and the gate REFUSEs "baseline check not green" instead of
 *     reporting mutants. Always pass one combined patch that carries both.
 * (2) --adjudicated is a data file, not a TSV with a header: a header row is read as a verdict and the
 *     gate REFUSEs "--adjudicated verdict must be equivalent or out-of-scope". Leave the header out.
 *
 * Session dir and slot reclaim:
 * --out is optional. Without it the dir is <TMPDIR>/unisacc-session-mutation-gate-<patch-stem>-<sha8>: the
 * same patch bytes always give the same dir, so prep, the workers run spawns and a later report agree, and
 * a different patch never lands in another patch's tree. TMPDIR decides where sessions live, so a caller
 * that runs two gates at once gives each its own TMPDIR.
 * An explicit --out is registered the same way: prep writes conf.tsv and session.tsv (pid, started_at,
 * patch, base, par, state) in BOTH cases, so an orphan is found by state plus liveness, not by the name.
 * Slots are deleted only when the directory PROVES it is a gate session: a non-empty SUMMARY (the verdict),
 * a non-empty conf.tsv, and a session.tsv carrying a `state<TAB>VALUE` line. Anything else is kept and
 * named (MG_SLOTS_KEPT reason=not-mine|no-summary), because --out may point at someone else's tree and two
 * touching files are not ownership. */
#pragma unisa use cxlib.ckrun
#pragma unisa use sys.fs
#pragma unisa use sys.time
#pragma unisa use sysx.process
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use text.text
#pragma unisa use sys.sha
#pragma unisa use cxlib.sessionroot
#pragma unisa use sys.proc
#pragma unisa use sys.posix

#define MG_MAXCHK 8
#define MG_MAXC 4096
#define MG_LINE 4096

static const char *g_patch, *g_base, *g_out, *g_repo = 0, *g_chk[MG_MAXCHK];
static int g_quality, g_expect_n;
static int g_expect_check[64], g_expect_code[64];
static const char *g_expect_name[64];
static int g_nchk, g_max = 30, g_par = 0, g_cov, g_mutchecks, g_git, g_slot = -1, g_deadline = 280;
static int g_scope_product, g_prod_touched, g_hunks;
static const char *g_build_cmd;
static double g_min = 0.6;
static int g_min_set;
static const char *g_allow_unc, *g_adjud;

static void die2(const char *a, const char *b) { fprintf(stderr, "mutation-gate: REFUSE %s %s\n", a, b ? b : ""); exit(2); }

static int sh(const char *script, char *out, int cap, int secs) { return ckk_sh_t("mutation-gate", script, out, cap, secs); }

/* single-quote S for sh into D */
static void shq(char *d, int cap, const char *s) {
    int k = 0; d[k++] = '\'';
    for (; *s; s++) { if (k > cap - 6) die2("quote", "too long"); if (*s == '\'') { d[k++] = '\''; d[k++] = '\\'; d[k++] = '\''; d[k++] = '\''; } else d[k++] = *s; }
    d[k++] = '\''; d[k] = 0;
}

static char *slurp(const char *p, size_t *n);
static void spit(const char *p, const char *b, size_t n);
static int sh(const char *script, char *out, int cap, int secs);
/* ---------- session dir derivation, registration, slot reclaim ---------- */
/* --out is optional. When absent the dir is derived from the patch content identity, so prep, the
   workers spawned by run, and a later report all compute the same path. Same patch bytes -> same dir;
   different bytes -> different dir (a stale slot tree can never be mistaken for this run's). */
static void derive_out(void) {
    char id[512], leaf[256], stem[256], hex[65];
    const char *base, *dot;
    size_t pn = 0;
    char *pb;
    if (g_out) return;
    if (!g_patch) die2("usage", "--out absent and no --patch to derive it from");
    pb = slurp(g_patch, &pn);
    if (!pb) die2("read", g_patch);
    if (sy_sha256_hex(pb, (long)pn, hex)) { mm_free(pb); die2("sha256", g_patch); }
    mm_free(pb);
    base = strrchr(g_patch, '/');
    base = base ? base + 1 : g_patch;
    cx_fmt(leaf, sizeof leaf, "%s", base);
    while ((dot = strrchr(leaf, '.')) != 0) ((char *)dot)[0] = 0;
    cx_fmt(stem, sizeof stem, "%s", leaf[0] ? leaf : "patch");
    cx_fmt(id, sizeof id, "mutation-gate-%.80s-%.8s", stem, hex);
    { static char ob[1024]; if (sr_default(id, ob, sizeof ob)) die2("session root", id); g_out = ob; }
}

/* state: prepared when prep finishes, done when report wrote a verdict. Anything else means the run
   died; whoever reclaims orphan session dirs keys off this file instead of re-parsing the dir name. */
static void write_session(const char *state) {
    char p[1024], b[2048]; int k = 0;
    cx_fmt(p, sizeof p, "%s/session.tsv", g_out);
    k += snprintf(b + k, sizeof b - k, "pid\t%d\nstarted_at\t%ld\npatch\t%s\nbase\t%s\npar\t%d\nstate\t%s\n",
                  sy_pid(), sy_now_ms(), g_patch ? g_patch : "", g_base ? g_base : "", g_par, state);
    spit(p, b, (size_t)k);
}

/* A slot tree is ours to delete only when this directory holds ALL FOUR of: a non-empty SUMMARY (the
   verdict), a non-empty conf.tsv (prep wrote the run's settings), and a session.tsv that carries a
   `state<TAB>VALUE` line with a value (prep/report wrote it). Existence alone is not proof: empty files
   with the right names are something any caller can create, and the gate never deletes a path it cannot
   prove it made. */
static int has_state_line(const char *b, size_t n) {
    long at = 0, hit;
    while ((hit = tx_find(b + at, (long)n - at, "state\t", 6)) >= 0) {
        long p = at + hit;
        at = p + 6;
        if (p > 0 && b[p - 1] != '\n') continue;          /* 'state\t' mid-line is another field's text */
        if (at < (long)n && b[at] != '\n' && b[at] != '\r') return 1;
    }
    return 0;
}

static int mine(const char *reason, long cap) {
    char p[1024];
    size_t sn = 0, cn = 0, nn = 0;
    char *sb, *cb, *nb;
    cx_fmt(p, sizeof p, "%s/SUMMARY", g_out);
    sb = slurp(p, &sn);
    if (!sb || sn == 0) { if (sb) mm_free(sb); if (reason) cx_fmt(reason, cap, "no-summary"); return 0; }
    mm_free(sb);
    cx_fmt(p, sizeof p, "%s/conf.tsv", g_out);
    cb = slurp(p, &cn);
    if (!cb || cn == 0) { if (cb) mm_free(cb); if (reason) cx_fmt(reason, cap, "not-mine"); return 0; }
    mm_free(cb);
    cx_fmt(p, sizeof p, "%s/session.tsv", g_out);
    nb = slurp(p, &nn);
    if (!nb || !has_state_line(nb, nn)) { if (nb) mm_free(nb); if (reason) cx_fmt(reason, cap, "not-mine"); return 0; }
    mm_free(nb);
    return 1;
}

/* Drop every slot tree, but only after mine() says the verdict and both registration files are here.
   A killed run leaves no SUMMARY, and a run that failed before reporting must keep its trees so the
   operator can read the compile logs. */
static void drop_slots(void) {
    char p[1024], cmd[16384], qs[2048]; int i, k = 0, any = 0;
    if (!mine(0, 0)) return;
    k = snprintf(cmd, sizeof cmd, "rm -rf --");
    /* reclaim 不带 conf 里的 par(它没跑 prep),所以按挂盘实际存在的槽扫,而不是按 g_par。 */
    for (i = 0; i < 64; i++) {
        cx_fmt(p, sizeof p, "%s/slot-%d", g_out, i);
        if (sy_exists(p) != 1) continue;
        shq(qs, sizeof qs, p);
        if (k + (int)strlen(qs) + 2 >= (int)sizeof cmd) break;
        k += snprintf(cmd + k, sizeof cmd - k, " %s", qs);
        any = 1;
    }
    if (!any) return;
    if (sh(cmd, 0, 0, 55)) { fprintf(stderr, "mutation-gate: WARN slot reclaim failed: %s\n", cmd); return; }
    printf("MG_SLOTS_RECLAIMED cmd=%s\n", cmd);
}

/* 独立入口:只做清槽判定,不碰 report。夹具靠它验三条分支(有结论+两份登记才删;缺 SUMMARY 记
   no-summary;缺 conf.tsv/session.tsv 记 not-mine)。 */
static void drop_slots_mode(void) {
    char why[64];
    if (!mine(why, sizeof why)) { printf("MG_SLOTS_KEPT reason=%s out=%s\n", why, g_out); return; }
    drop_slots();
}

static char *slurp(const char *p, size_t *n) { size_t z = 0; char *b = cx_read(p, &z); if (n) *n = z; return b; }
static void spit(const char *p, const char *b, size_t n) { if (cx_write(p, b, n) != 0) die2("write", p); }
/* checked copy: refuses instead of truncating or overrunning */
static void cp(void *d, long cap, const void *s, long n) { if (mm_copy(d, cap, s, n) != 0) die2("copy", "out of bound"); }

/* ---------- configuration persisted by prep ---------- */
static void expect_failure(const char *type, const char *value) {
    if (!g_nchk || g_expect_n == 64 || !*value || strpbrk(value, "\t\r\n") || strlen(value) > 250)
        die2("invalid check expectation", value);
    int n = g_expect_n++;
    g_expect_check[n] = g_nchk - 1;
    g_expect_name[n] = 0;
    g_expect_code[n] = 0;
    if (!strcmp(type, "name")) g_expect_name[n] = value;
    else {
        char *end;
        long code = strtol(value, &end, 10);
        if (*end || code < 1 || code > 123) die2("expected assertion rc must be 1..123", value);
        g_expect_code[n] = (int)code;
    }
}

static void save_conf(void) {
    char p[1024], b[16384]; int k = 0, i;
    cx_fmt(p, sizeof p, "%s/conf.tsv", g_out);
    k += snprintf(b + k, sizeof b - k, "par\t%d\nmax\t%d\nmin\t%g\ncov\t%d\n", g_par, g_max, g_min, g_cov);
    if (g_scope_product) {
        if (cx_fmt(b + k, sizeof b - k, "scope\tproduct\nhunks\t%d\n", g_hunks)) die2("conf", "too long");
        k += (int)strlen(b + k);
    }
    if (g_build_cmd) {
        if (cx_fmt(b + k, sizeof b - k, "build\t%s\n", g_build_cmd)) die2("conf", "too long");
        k += (int)strlen(b + k);
    }
    if (g_quality) {
        if (cx_fmt(b + k, sizeof b - k, "quality\t1\n")) die2("conf", "too long");
        k += (int)strlen(b + k);
    }
    for (i = 0; i < g_nchk; i++) {
        if (cx_fmt(b + k, sizeof b - k, "check\t%s\n", g_chk[i])) die2("conf", "too long");
        k += (int)strlen(b + k);
        for (int j = 0; j < g_expect_n; j++) {
            if (g_expect_check[j] != i) continue;
            int rc = g_expect_name[j]
                ? cx_fmt(b + k, sizeof b - k, "expect-name\t%s\n", g_expect_name[j])
                : cx_fmt(b + k, sizeof b - k, "expect-rc\t%d\n", g_expect_code[j]);
            if (rc) die2("conf", "too long");
            k += (int)strlen(b + k);
        }
    }
    if (k >= (int)sizeof b) die2("conf", "too long");
    spit(p, b, (size_t)k);
}
static void load_conf(void) {
    char p[1024]; size_t n; char *b, *s, *e;
    cx_fmt(p, sizeof p, "%s/conf.tsv", g_out);
    b = slurp(p, &n); if (!b) die2("missing", p);
    g_nchk = g_expect_n = 0;
    for (s = b; s < b + n; s = e + 1) {
        e = s; while (e < b + n && *e != '\n') e++; *e = 0;
        if (!strncmp(s, "par\t", 4)) g_par = atoi(s + 4);
        else if (!strncmp(s, "max\t", 4)) g_max = atoi(s + 4);
        else if (!strncmp(s, "cov\t", 4)) g_cov = atoi(s + 4);
        else if (!strcmp(s, "scope\tproduct")) g_scope_product = 1;
        else if (!strncmp(s, "hunks\t", 6)) g_hunks = atoi(s + 6);
        else if (!strncmp(s, "build\t", 6)) g_build_cmd = s + 6;
        else if (!strncmp(s, "min\t", 4) && !g_min_set) g_min = atof(s + 4);
        else if (!strcmp(s, "quality\t1")) g_quality = 1;
        else if (!strncmp(s, "check\t", 6) && g_nchk < MG_MAXCHK) g_chk[g_nchk++] = s + 6;
        else if (!strncmp(s, "expect-name\t", 12)) expect_failure("name", s + 12);
        else if (!strncmp(s, "expect-rc\t", 10)) expect_failure("rc", s + 10);
    }
}

/* ---------- lexical helpers ---------- */
/* m[i] = 1 when line[i] is code (not inside a string/char literal or comment).  `st` is the block-comment state the
   line starts in: without it a line whose block comment closes and then carries real code was masked as if the
   comment had never opened, so the walkers mutated the comment's text and left the code alone. */
static void code_mask(const char *l, char *m, int st) {
    int i = 0;
    for (; l[i]; i++) {
        if (st == 0) {
            if (l[i] == '/' && l[i + 1] == '/') { for (; l[i]; i++) m[i] = 0; break; }
            if (l[i] == '/' && l[i + 1] == '*') { st = 3; m[i] = 0; continue; }
            if (l[i] == '"') { st = 1; m[i] = 0; continue; }
            if (l[i] == '\'') { st = 2; m[i] = 0; continue; }
            m[i] = 1;
        } else {
            m[i] = 0;
            if ((st == 1 || st == 2) && l[i] == '\\' && l[i + 1]) { m[++i] = 0; continue; }
            if (st == 1 && l[i] == '"') st = 0;
            else if (st == 2 && l[i] == '\'') st = 0;
            else if (st == 3 && l[i] == '*' && l[i + 1] == '/') { m[++i] = 0; st = 0; }
        }
    }
    m[i] = 0;
}
/* state after the line: 3 inside a block comment, 0 outside.  A string or char literal that is still open at the
   end of a line is malformed C on its own, so it is reported as outside rather than carried forward. */
static int end_state(const char *l, int st) {
    int i = 0;
    while (l[i]) {
        if (st == 0) {
            if (l[i] == '/' && l[i + 1] == '/') break;
            if (l[i] == '/' && l[i + 1] == '*') { st = 3; i += 2; continue; }
            if (l[i] == '"' || l[i] == '\'') { int q = l[i]; i++; while (l[i] && l[i] != q) i += l[i] == '\\' ? 2 : 1; if (l[i]) i++; continue; }
            i++;
        } else {
            if (l[i] == '*' && l[i + 1] == '/') { st = 0; i += 2; continue; }
            i++;
        }
    }
    return st;
}
static int isid(int c) { int l = c | 32; return c == '_' || (c >= '0' && c <= '9') || (l >= 'a' && l <= 'z'); }
static int isdig(int c) { return c >= '0' && c <= '9'; }
/* index of the ')' matching '(' at o (code only), -1 when not on this line */
static int match_paren(const char *l, const char *m, int o) {
    int d = 0, i;
    for (i = o; l[i]; i++) { if (!m[i]) continue; if (l[i] == '(') d++; else if (l[i] == ')' && --d == 0) return i; }
    return -1;
}
static int splice(char *d, int cap, const char *l, int a, int b, const char *ins) {
    /* d = l[0..a) + ins + l[b..] */
    return cx_fmt(d, cap, "%.*s%s%s", a, l, ins, l + b) ? -1 : 0;
}
/* 1 when the line, entered in comment state `st`, holds a character outside comments and string literals.  The
   entry state is what makes a comment close followed by real code observable: from state 0 the walkers mutated
   text and never looked at `60`. */
static int has_code(const char *l, int st) {
    char m[MG_LINE]; int i;
    code_mask(l, m, st);
    for (i = 0; l[i]; i++) if (m[i] && (!g_scope_product || (l[i] != ' ' && l[i] != '\t' && l[i] != '\r'))) return 1;
    return 0;
}
/* A preprocessor line is a directive, not C code: mutating `#define K 4096` to 4097 or a `#include` path only ever
   dies at compile time, which scores as killed without any check proving the code works.  They are skipped by the
   same rule the old `skip_line` used, now stated as what it is about rather than as a list of leading characters. */
static int is_preproc(const char *l) {
    while (*l == ' ' || *l == '\t') l++;
    return *l == '#';
}

/* ---------- candidates ---------- */
typedef struct { int file, line, kind; char *text; char desc[96]; } Cand;
static const char *KN[] = { "cmp", "neg", "int", "str", "del", "arg", "logic", "stmt", "retc", "cov" };
#define NK 10
static Cand *g_c; static int g_nc, g_cc;
static char *g_files[512]; static int g_nf;

static void add(int f, int ln, int kind, const char *text, const char *desc) {
    if (g_nc == g_cc) { g_cc = g_cc ? g_cc * 2 : 256; g_c = mm_grow(g_c, (long)g_cc * (long)sizeof(Cand)); }
    g_c[g_nc].file = f; g_c[g_nc].line = ln; g_c[g_nc].kind = kind; g_c[g_nc].text = mm_strdup(text);
    cx_fmt(g_c[g_nc].desc, sizeof g_c[g_nc].desc, "%s", desc); g_nc++;
}

static int has_cand_text(int f, int ln, const char *text) {
    for (int c = 0; c < g_nc; c++) {
        if (g_c[c].file == f && g_c[c].line == ln && !strcmp(g_c[c].text, text)) return 1;
    }
    return 0;
}

static int is_local_decl(const char *t) {
    const char *p = t;
    if (!isid((unsigned char)*p) || isdig((unsigned char)*p)) return 0;
    size_t n1 = 0;
    while (isid((unsigned char)p[n1])) n1++;
    if ((n1 == 6 && !strncmp(p, "return", 6)) || (n1 == 4 && !strncmp(p, "goto", 4)) ||
        (n1 == 4 && !strncmp(p, "else", 4)) || (n1 == 6 && !strncmp(p, "sizeof", 6))) return 0;
    p += n1;
    while (*p == ' ' || *p == '\t' || *p == '*') p++;
    return isid((unsigned char)*p) && !isdig((unsigned char)*p);
}

static void gen_stmt(int f, int ln, const char *l, const char *m) {
    const char *t = l;
    int bal_b = 0, bal_p = 0, last_nb = -1;
    if (l[0] != ' ' && l[0] != '\t') return;
    while (*t == ' ' || *t == '\t') t++;
    if (!*t || *t == ';' || *t == '{' || *t == '}' || *t == '#') return;
    if (!strncmp(t, "else", 4) && !isid((unsigned char)t[4])) return;
    if (!strncmp(t, "case", 4) && !isid((unsigned char)t[4])) return;
    if (!strncmp(t, "default", 7) && (t[7] == ':' || t[7] == ' ')) return;
    if (!strncmp(t, "typedef", 7) && !isid((unsigned char)t[7])) return;
    if ((!strncmp(t, "struct", 6) && !isid((unsigned char)t[6])) ||
        (!strncmp(t, "enum", 4) && !isid((unsigned char)t[4])) ||
        (!strncmp(t, "union", 5) && !isid((unsigned char)t[5]))) return;
    if (!strncmp(t, "for", 3) && !isid((unsigned char)t[3])) return;
    if (is_local_decl(t)) return;
    for (int k = 0; l[k]; k++) {
        if (!m[k]) continue;
        if (l[k] == '{') bal_b++;
        else if (l[k] == '}') bal_b--;
        else if (l[k] == '(') bal_p++;
        else if (l[k] == ')') bal_p--;
        if (l[k] != ' ' && l[k] != '\t' && l[k] != '\r' && l[k] != '\n') last_nb = k;
    }
    if (bal_b != 0 || bal_p != 0 || last_nb < 0 || l[last_nb] != ';') return;
    if (strstr(t, "(void)0;") && strlen(t) <= 9) return;
    if (!has_cand_text(f, ln, ";")) add(f, ln, 7, ";", "delete statement");
}

static void gen_line(int f, int ln, const char *l, int st) {
    char m[MG_LINE], d[MG_LINE + 64], desc[96]; int i, n = (int)strlen(l), done;
    if (n >= MG_LINE - 8) return;
    code_mask(l, m, st);
    /* cmp: first comparison operator */
    for (i = 0, done = 0; l[i] && !done; i++) {
        const char *rep = 0; int w = 1;
        if (!m[i]) continue;
        if (l[i] == '=' && l[i + 1] == '=') { rep = "!="; w = 2; }
        else if (l[i] == '!' && l[i + 1] == '=') { rep = "=="; w = 2; }
        else if (l[i] == '<' && l[i + 1] == '=') { rep = "<"; w = 2; }
        else if (l[i] == '>' && l[i + 1] == '=') { rep = ">"; w = 2; }
        else if (l[i] == '<' && l[i + 1] != '<' && (i == 0 || l[i - 1] != '<')) rep = "<=";
        else if (l[i] == '>' && l[i + 1] != '>' && (i == 0 || (l[i - 1] != '>' && l[i - 1] != '-'))) rep = ">=";
        if (rep && !splice(d, sizeof d, l, i, i + w, rep)) { cx_fmt(desc, sizeof desc, "col %d %.*s -> %s", i + 1, w, l + i, rep); add(f, ln, 0, d, desc); done = 1; }
        if (rep) i += w - 1;
    }
    /* neg: if ( ... ) wrapped in !( ) */
    for (i = 0; l[i]; i++) {
        if (m[i] && l[i] == 'i' && l[i + 1] == 'f' && (i == 0 || !isid(l[i - 1])) && !isid(l[i + 2])) {
            int o = i + 2, c; while (l[o] == ' ') o++;
            if (l[o] != '(') continue;
            c = match_paren(l, m, o); if (c < 0) break;
            if (!cx_fmt(d, sizeof d, "%.*s(!(%.*s))%s", o, l, c - o - 1, l + o + 1, l + c + 1)) { cx_fmt(desc, sizeof desc, "col %d if (x) -> if (!(x))", i + 1); add(f, ln, 1, d, desc); }
            break;
        }
    }
    /* int: first decimal literal not part of an identifier */
    for (i = 0; l[i]; i++) {
        if (m[i] && isdig(l[i]) && (i == 0 || (!isid(l[i - 1]) && l[i - 1] != '.'))) {
            int e = i; long v = 0; char nv[32];
            while (isdig(l[e])) { v = v * 10 + (l[e] - '0'); e++; }
            if (isid(l[e]) || l[e] == '.' || (e - i) > 9) { i = e; continue; }
            cx_fmt(nv, sizeof nv, "%ld", v == 1 ? 0L : v + 1);
            if (!splice(d, sizeof d, l, i, e, nv)) { cx_fmt(desc, sizeof desc, "col %d %ld -> %s", i + 1, v, nv); add(f, ln, 2, d, desc); }
            break;
        }
    }
    /* str: first string literal with a letter: change its last letter before '=' or its last letter */
    for (i = 0; l[i]; i++) {
        if (l[i] == '"' && (i == 0 || m[i - 1] || i == 0) && (i == 0 || l[i - 1] != '\'')) {
            int e = i + 1, pick = -1, eq = -1;
            while (l[e] && l[e] != '"') { if (l[e] == '\\' && l[e + 1]) { e += 2; continue; } if (l[e] == '=' && eq < 0) eq = e; e++; }
            if (!l[e]) break;
            { int j, lim = eq > 0 ? eq : e; for (j = i + 1; j < lim; j++) if ((l[j] >= 'a' && l[j] <= 'z') || (l[j] >= 'A' && l[j] <= 'Z')) { if (j > i + 1 && l[j - 1] == '%') continue; if (j > i + 1 && l[j - 1] == '\\') continue; pick = j; } }
            if (pick > 0) {
                char r[2]; r[0] = l[pick] == 'X' ? 'Y' : 'X'; r[1] = 0;
                if (!splice(d, sizeof d, l, pick, pick + 1, r)) { cx_fmt(desc, sizeof desc, "col %d string char %c -> %s", pick + 1, l[pick], r); add(f, ln, 3, d, desc); }
                break;
            }
            i = e;
        }
    }
    /* del: whole statement line, or call statement -> 0 */
    {
        const char *t = l; while (*t == ' ' || *t == '\t') t++;
        int bal = 0, k; for (k = 0; l[k]; k++) if (m[k]) { if (l[k] == '{') bal++; else if (l[k] == '}') bal--; }
        int endsemi = 0; for (k = n - 1; k >= 0 && (l[k] == ' ' || l[k] == '\t' || l[k] == '\n' || l[k] == '\r'); k--); endsemi = k >= 0 && l[k] == ';';
        int keyw = !strncmp(t, "return", 6) || strstr(l, "blocked +=") || strstr(l, "blocked+=") || strstr(l, "rcpt_set(");
        if (keyw && bal == 0 && endsemi && strncmp(t, "return", 6) == 0 && !strchr(t, '{')) { add(f, ln, 4, ";", "delete return line"); }
        else if (keyw && bal == 0 && endsemi && !strchr(t, '{') && !strncmp(t, "blocked", 7)) { add(f, ln, 4, ";", "delete blocked += line"); }
        else {
            const char *want[] = { "rcpt_set(", "blocked +=", "blocked+=", 0 }; int w;
            for (w = 0; want[w]; w++) {
                const char *p = strstr(l, want[w]); int o, c;
                if (!p || !m[p - l]) continue;
                o = (int)(p - l);
                if (w == 0) { int po = o + 8; c = match_paren(l, m, po); if (c < 0) continue; if (!splice(d, sizeof d, l, o, c + 1, "(void)0")) { add(f, ln, 4, d, "rcpt_set(...) -> (void)0"); } }
                else { const char *s2 = strchr(p, ';'); if (!s2) continue; if (!splice(d, sizeof d, l, o, (int)(s2 - l), "(void)0")) add(f, ln, 4, d, "blocked += x -> (void)0"); }
                break;
            }
        }
    }
    /* arg: first call with >= 2 top-level args: drop the last one */
    for (i = 1; l[i] && (l[0] == ' ' || l[0] == '\t'); i++) {   /* column-0 lines are definitions: no call to cut */
        if (m[i] && l[i] == '(' && isid(l[i - 1])) {
            int c = match_paren(l, m, i), d0 = 0, k, last = -1, s0 = i - 1;
            if (c < 0) continue;
            while (s0 > 0 && isid(l[s0 - 1])) s0--;
            if (!strncmp(l + s0, "if", 2) && i - s0 == 2) continue;
            if ((!strncmp(l + s0, "for", 3) && i - s0 == 3) || (!strncmp(l + s0, "while", 5) && i - s0 == 5) || (!strncmp(l + s0, "switch", 6) && i - s0 == 6) || (!strncmp(l + s0, "sizeof", 6) && i - s0 == 6) || (!strncmp(l + s0, "return", 6) && i - s0 == 6)) continue;
            for (k = i + 1; k < c; k++) { if (!m[k]) continue; if (l[k] == '(' || l[k] == '[' || l[k] == '{') d0++; else if (l[k] == ')' || l[k] == ']' || l[k] == '}') d0--; else if (l[k] == ',' && d0 == 0) last = k; }
            if (last < 0) continue;
            if (!splice(d, sizeof d, l, last, c, "")) { cx_fmt(desc, sizeof desc, "col %d %.*s(...) drop last argument", s0 + 1, i - s0 > 40 ? 40 : i - s0, l + s0); add(f, ln, 5, d, desc); }
            break;
        }
    }
    /* logic */
    for (i = 0; l[i]; i++) {
        if (m[i] && ((l[i] == '&' && l[i + 1] == '&') || (l[i] == '|' && l[i + 1] == '|'))) {
            if (!splice(d, sizeof d, l, i, i + 2, l[i] == '&' ? "||" : "&&")) { cx_fmt(desc, sizeof desc, "col %d %.2s swapped", i + 1, l + i); add(f, ln, 6, d, desc); }
            break;
        }
    }
    if (g_scope_product) gen_stmt(f, ln, l, m);
}

/* ---------- patch parsing ---------- */
typedef struct { int file, line; } Add;
static Add *g_add; static int g_nadd, g_cadd;
static char *g_noncx_prod[256]; static int g_n_noncx_prod;

static int is_product_path(const char *p) {
    return !strncmp(p, "src/", 4) || !strncmp(p, "cx/", 3) || !strncmp(p, "exec/", 5);
}

static int want_file(const char *p) {
    int n = (int)strlen(p), i;
    if (g_scope_product && !is_product_path(p)) return 0;
    if (!(n > 3 && !strcmp(p + n - 3, ".cx")) && !(n > 2 && !strcmp(p + n - 2, ".c"))) return 0;
    if (g_mutchecks) return 1;
    { const char *b = strrchr(p, '/'); b = b ? b + 1 : p; if (!strncmp(b, "check-", 6)) return 0; }
    (void)i;   /* a check command may run the product file itself (exact-output checks): only check-*.cx is skipped */
    return 1;
}
static void parse_patch(const char *patch) {
    size_t n; char *b = slurp(patch, &n), *s, *e; int cur = -1, nl = 0;
    if (!b) die2("cannot read patch", patch);
    for (s = b; s < b + n; s = e + 1) {
        e = s; while (e < b + n && *e != '\n') e++;
        if (e - s >= 6 && !strncmp(s, "+++ ", 4)) {
            char p[1024]; int L = (int)(e - s) - 4; const char *q = s + 4;
            if (L > 2 && !strncmp(q, "b/", 2)) { q += 2; L -= 2; }
            if (L >= (int)sizeof p) L = sizeof p - 1;
            cp(p, (long)sizeof p, q, L); p[L] = 0;
            { char *t = strchr(p, '\t'); if (t) *t = 0; }
            cur = -1;
            if (g_scope_product && is_product_path(p)) g_prod_touched = 1;
            if (want_file(p) && g_nf < 512) { g_files[g_nf] = mm_strdup(p); cur = g_nf++; }
            else if (g_scope_product && is_product_path(p) && strcmp(p, "/dev/null") && g_n_noncx_prod < 256) {
                const char *bname = strrchr(p, '/'); bname = bname ? bname + 1 : p;
                if (g_mutchecks || strncmp(bname, "check-", 6)) g_noncx_prod[g_n_noncx_prod++] = mm_strdup(p);
            }
            continue;
        }
        if (e - s >= 4 && !strncmp(s, "--- ", 4)) continue;
        if (!strncmp(s, "diff ", 5)) { cur = -1; continue; }
        if (!strncmp(s, "@@ ", 3)) {
            const char *pl = memchr(s, '+', (size_t)(e - s));
            nl = pl ? atoi(pl + 1) : 0;
            if (cur >= 0) g_hunks++;
            continue;
        }
        if (cur < 0) continue;
        if (*s == '+') { if (g_nadd == g_cadd) { g_cadd = g_cadd ? g_cadd * 2 : 512; g_add = mm_grow(g_add, (long)g_cadd * (long)sizeof(Add)); } g_add[g_nadd].file = cur; g_add[g_nadd].line = nl; g_nadd++; nl++; }
        else if (*s == ' ') nl++;
    }
    mm_free(b);
}

/* split file into lines (in place) */
static int split_lines(char *b, size_t n, char ***out) {
    int cnt = 1, k = 0; size_t i; char **v;
    for (i = 0; i < n; i++) if (b[i] == '\n') cnt++;
    v = mm_alloc((long)(cnt + 1) * (long)sizeof(char *));
    v[k++] = b;
    for (i = 0; i < n; i++) if (b[i] == '\n') { b[i] = 0; if (i + 1 <= n) v[k++] = b + i + 1; }
    *out = v; return k;
}

static int find_func_open(char **L, int *sts, int nlines, int ln, int multi_line, int *head_ln_out, int *brace_ln_out, int *brace_col_out) {
    for (int j = ln; j >= 1; j--) {
        const char *l = L[j - 1];
        if (l[0] == '}' && j != ln) return 0;
        if (l[0] && l[0] != ' ' && l[0] != '\t' && l[0] != '/' && l[0] != '*' && l[0] != '}' &&
            !is_preproc(l) && strchr(l, '(') && !strstr(l, "typedef") && !strstr(l, "struct ")) {
            int max_off = multi_line ? 4 : 0;
            for (int off = 0; off <= max_off && j + off <= ln && j + off <= nlines; off++) {
                const char *bl = L[j + off - 1];
                char m[MG_LINE];
                if (strlen(bl) >= MG_LINE - 40) return 0;
                code_mask(bl, m, sts[j + off - 1]);
                for (int k = 0; bl[k]; k++) {
                    if (!m[k]) continue;
                    if (bl[k] == ';') return 0;
                    if (bl[k] == '{') {
                        *head_ln_out = j;
                        *brace_ln_out = j + off;
                        *brace_col_out = k;
                        return 1;
                    }
                }
            }
            return 0;
        }
    }
    return 0;
}

static int seen_line_add(int *seen, int cap, int ln) {
    int k;
    for (k = 0; k < cap && seen[k]; k++) if (seen[k] == ln) return 0;
    if (k < cap) seen[k] = ln;
    return 1;
}

static void gen_cov(int f, char **L, int *sts, int nlines, int ln, int *seen, int nseen_cap) {
    if (!g_scope_product) {
        int j, k; char d[MG_LINE + 64], desc[96];
        for (j = ln - 1; j >= 1; j--) {
            const char *l = L[j - 1];
            if (l[0] == '}') return;
            if (l[0] && l[0] != ' ' && l[0] != '\t' && l[0] != '/' && l[0] != '*' && !is_preproc(l) && strchr(l, '(') && strchr(l, '{')) {
                for (k = 0; k < nseen_cap && seen[k]; k++) if (seen[k] == j) return;
                if (k < nseen_cap) seen[k] = j;
                const char *br = strchr(l, '{');
                int o = (int)(br - l);
                if (splice(d, sizeof d, l, o + 1, o + 1, " *(volatile int *)0 = 0; ")) return;
                cx_fmt(desc, sizeof desc, "abort at entry of %.60s", l);
                add(f, j, NK - 1, d, desc);
                return;
            }
        }
        return;
    }
    int hj = 0, bj = 0, o = -1;
    char d[MG_LINE + 256], desc[96];
    const char *ins = " { FILE *_mgf = fopen(\"__MG_PROBE__\", \"w\"); if (_mgf) { fputs(\"__MG_TOKEN__\\n\", _mgf); fclose(_mgf); } *(volatile int *)0 = 0; } ";
    if (!find_func_open(L, sts, nlines, ln, 1, &hj, &bj, &o)) return;
    if (!seen_line_add(seen, nseen_cap, bj)) return;
    if (splice(d, sizeof d, L[bj - 1], o + 1, o + 1, ins)) return;
    cx_fmt(desc, sizeof desc, "abort at entry of %.60s", L[hj - 1]);
    add(f, bj, NK - 1, d, desc);
}

static void gen_retc(int f, char **L, int *sts, int nlines, int ln, int *seen, int nseen_cap) {
    int hj = 0, bj = 0, o = -1;
    char d[MG_LINE + 64], desc[96];
    if (!find_func_open(L, sts, nlines, ln, 1, &hj, &bj, &o)) return;
    if (!seen_line_add(seen, nseen_cap, bj)) return;
    const char *hl = L[hj - 1];
    const char *par_p = strchr(hl, '(');
    if (!par_p) return;
    const char *nm = par_p;
    while (nm > hl && nm[-1] == ' ') nm--;
    while (nm > hl && isid((unsigned char)nm[-1])) nm--;
    while (nm > hl && (nm[-1] == ' ' || nm[-1] == '\t')) nm--;
    int is_ptr = (nm > hl && nm[-1] == '*');
    int is_void = 0;
    if (!is_ptr && nm >= hl + 4 && !strncmp(nm - 4, "void", 4) &&
        (nm - 4 == hl || !isid((unsigned char)nm[-5]))) {
        is_void = 1;
    }
    if (!is_ptr && strstr(hl, "union ") && (const char *)strstr(hl, "union ") < nm) return;
    if (!is_ptr && strstr(hl, "struct ") && (const char *)strstr(hl, "struct ") < nm) return;
    const char *ins = is_void ? " return; " : " return 0; ";
    if (splice(d, sizeof d, L[bj - 1], o + 1, o + 1, ins)) return;
    cx_fmt(desc, sizeof desc, "%s at entry of %.52s", is_void ? "return" : "return 0", hl);
    add(f, bj, 8, d, desc);
}

/* ---------- prep ---------- */
static void prep(void) {
    char cmd[16384], q1[2048], q2[2048], q3[2048], out[8192], p[1024]; int rc, i, f;
    long t0 = sy_now_ms();
    if (!g_patch || !g_base || !g_nchk) die2("usage", "need --patch --base --check (--out optional)");
    if (g_scope_product && !g_cov) die2("--scope product requires --coverage-check", "");
    if (g_scope_product && (!g_build_cmd || !g_build_cmd[0])) die2("--scope product requires --build", "");
    if (!g_repo) { const char *h = getenv("HOME"); static char rb[512]; cx_fmt(rb, sizeof rb, "%s/repos/unisacc", h ? h : "."); g_repo = rb; }
    if (g_par <= 0) { long nc = sy_ncpu(); g_par = nc > 1 ? (int)(nc / 2) : 1; }
    if (g_par > 16) g_par = 16;
    if (sy_exists(g_out)) {
        cx_fmt(p, sizeof p, "%s/conf.tsv", g_out);
        if (sy_exists(p)) {
            /* 已准备过:拒绝,不代删(这目录也可能是别的窗口给的)。reclaim 只在已经有结论(SUMMARY)
               时才会动手——只 prep 过还没 report 的目录跑 reclaim 会得到 reason=no-summary 且登记文件
               仍在,再 prep 照样被拒,所以先把适用条件写清,再把要删的都列出来。 */
            fprintf(stderr, "mutation-gate: REFUSE out dir already prepared %s\n", g_out);
            fprintf(stderr, "mutation-gate: reclaim --out clears slots only after a verdict (SUMMARY); for a prep-only dir delete every path listed below, then prep again\n");
            fprintf(stderr, "mutation-gate: with a verdict there: sh ./unisacc.com tools/mutation-gate.cx -- reclaim --out '%s'\n", g_out);
            fprintf(stderr, "mutation-gate: delete by hand: rm -rf");
            cx_fmt(p, sizeof p, "%s/conf.tsv", g_out); if (sy_exists(p) == 1) fprintf(stderr, " '%s'", p);
            cx_fmt(p, sizeof p, "%s/session.tsv", g_out); if (sy_exists(p) == 1) fprintf(stderr, " '%s'", p);
            for (i = 0; i < g_par; i++) { cx_fmt(p, sizeof p, "%s/slot-%d", g_out, i); if (sy_exists(p) == 1) fprintf(stderr, " '%s'", p); }
            fprintf(stderr, "\n");
            exit(2);
        }
    }
    sy_mkdir(g_out, 0755);
    shq(q1, sizeof q1, g_repo); shq(q2, sizeof q2, g_base); shq(q3, sizeof q3, g_out);
    {
        char qp[2048], ab[1024], rab[1024], qr[2048], top[2048];
        if (!realpath(g_patch, ab)) die2("patch", g_patch);
        if (!realpath(g_repo, rab)) die2("repo", g_repo);
        shq(qp, sizeof qp, ab);
        shq(qr, sizeof qr, rab);
        cx_fmt(cmd, sizeof cmd, "git -C %s rev-parse --show-toplevel 2>/dev/null", qr);
        if (sh(cmd, top, sizeof top, 15) != 0) die2("--repo is not a git repo", g_repo);
        { size_t tl = strlen(top); while (tl > 0 && (top[tl - 1] == '\n' || top[tl - 1] == '\r')) top[--tl] = 0; }
        if (strcmp(top, rab) != 0) die2("--repo is not a git toplevel", g_repo);
        if (g_build_cmd && g_build_cmd[0]) {
            cx_fmt(cmd, sizeof cmd, "set -e; mkdir -p %s/slot-0 %s/m; git -C %s archive %s | tar -x -C %s/slot-0; "
                   "if [ -e unisacc.com ]; then cp -Lf unisacc.com %s/slot-0/unisacc.com; fi; cd %s/slot-0 || exit 3; "
                   "GIT_CEILING_DIRECTORIES=\"$(dirname \"$PWD\")\" git apply --whitespace=nowarn %s 2>&1 || GIT_CEILING_DIRECTORIES=\"$(dirname \"$PWD\")\" git apply --3way %s 2>&1 || exit 3",
                   q3, q3, qr, q2, q3, q3, q3, qp, qp);
        } else {
            cx_fmt(cmd, sizeof cmd, "set -e; mkdir -p %s/slot-0 %s/m; git -C %s archive %s | tar -x -C %s/slot-0; ln -sfn \"$(pwd)/unisacc.com\" %s/slot-0/unisacc.com 2>/dev/null || true; "
                   "if [ -L unisacc.com ]; then ln -sfn \"$(readlink -f unisacc.com)\" %s/slot-0/unisacc.com; fi; cd %s/slot-0 || exit 3; "
                   "GIT_CEILING_DIRECTORIES=\"$(dirname \"$PWD\")\" git apply --whitespace=nowarn %s 2>&1 || GIT_CEILING_DIRECTORIES=\"$(dirname \"$PWD\")\" git apply --3way %s 2>&1 || exit 3",
                   q3, q3, qr, q2, q3, q3, q3, q3, qp, qp);
        }
    }
    rc = sh(cmd, out, sizeof out, 55);
    if (rc != 0) { fprintf(stderr, "%s", out); die2("archive or git apply failed rc", ""); }
    if (g_git) {   /* checks that need a work tree (git grep, git diff) get a private repo with the patch committed */
        cx_fmt(cmd, sizeof cmd, "set -e; cd %s/slot-0; git init -q; git -c user.email=mg@local -c user.name=mutation-gate add -A >/dev/null; "
               "git -c user.email=mg@local -c user.name=mutation-gate commit -q -m mutation-gate-base >/dev/null", q3);
        rc = sh(cmd, out, sizeof out, 55);
        if (rc != 0) { fprintf(stderr, "%s", out); die2("git init of private tree failed", ""); }
    }
    parse_patch(g_patch);
    /* candidates per file: walk every line so the block-comment state carries across lines, and only an added
       line that still holds code after that walk becomes a candidate.  A patch line inside a multi-line comment
       whose continuation does not start with an asterisk is prose, and mutating it only ever produced survivors. */
    for (f = 0; f < g_nf; f++) {
        size_t n; char **L; int nl, a, seen[256], seen_retc[256], i, *sts;
        cx_fmt(p, sizeof p, "%s/slot-0/%s", g_out, g_files[f]);
        char *b = slurp(p, &n); if (!b) continue;
        nl = split_lines(b, n, &L);
        memset(seen, 0, sizeof seen);
        memset(seen_retc, 0, sizeof seen_retc);
        /* entry comment state per line, computed once in a forward walk: the walkers need to know whether a line
           starts inside a block comment: a comment close followed by code is code from there on, and a mask built
           from state 0 would rewrite the comment text and leave `60` alone. */
        sts = mm_zalloc((long)(nl + 1) * (long)sizeof(int));
        for (i = 1; i <= nl; i++) sts[i] = end_state(L[i - 1], sts[i - 1]);
        for (i = 1; i <= nl; i++) {
            int added = 0;
            for (a = 0; a < g_nadd; a++) if (g_add[a].file == f && g_add[a].line == i) { added = 1; break; }
            if (!added) continue;
            if (is_preproc(L[i - 1])) continue;     /* directives die at compile time: not a check's kill */
            if (!has_code(L[i - 1], sts[i - 1])) continue;
            gen_line(f, i, L[i - 1], sts[i - 1]);
            if (g_cov) gen_cov(f, L, sts, nl, i, seen, 256);
            if (g_scope_product) gen_retc(f, L, sts, nl, i, seen_retc, 256);
        }
        mm_free(sts);
        mm_free(L); mm_free(b);
    }
    /* selection: round robin over (file, kind) buckets; cov mutants are all kept (not limited by --max) */
    {
        int *pick = mm_zalloc((long)(g_nc + 1) * (long)sizeof(int)), *used = mm_zalloc((long)(g_nc + 1) * (long)sizeof(int)), np = 0, round, any, id = 0;
        char tsv[1 << 16]; int tk = 0;
        for (round = 0; np < g_max; round++) {
            any = 0;
            for (f = 0; f < g_nf && np < g_max; f++) for (int k = 0; k < NK - 1 && np < g_max; k++) {
                int seen = 0, c, cand = 0; for (c = 0; c < g_nc; c++) if (g_c[c].file == f && g_c[c].kind == k) cand++;
                if (cand == 0) continue;
                /* stride through the bucket so later rounds spread over the file */
                int want = round, idx = -1, cnt = 0;
                if (want >= cand) continue;
                for (c = 0; c < g_nc; c++) if (g_c[c].file == f && g_c[c].kind == k) { if (cnt == want) { idx = c; break; } cnt++; }
                (void)seen;
                if (idx >= 0 && !used[idx]) { used[idx] = 1; pick[np++] = idx; any = 1; }
            }
            if (!any) break;
        }
        if (g_cov) for (int c = 0; c < g_nc; c++) if (g_c[c].kind == NK - 1) pick[np++] = c;
        for (i = 0; i < np; i++) {
            Cand *c = &g_c[pick[i]];
            char mp[1024]; cx_fmt(mp, sizeof mp, "%s/m/%d.line", g_out, id);
            spit(mp, c->text, strlen(c->text));
            tk += snprintf(tsv + tk, sizeof tsv - tk, "%d\t%s\t%d\t%s\t%s\n", id, g_files[c->file], c->line, KN[c->kind], c->desc);
            if (tk >= (int)sizeof tsv - 200) break;
            id++;
        }
        cx_fmt(p, sizeof p, "%s/mutants.tsv", g_out); spit(p, tsv, (size_t)tk);
        printf("MG_PREP files=%d added_lines=%d candidates=%d selected=%d par=%d\n", g_nf, g_nadd, g_nc, id, g_par);
        if (id == 0) {
            save_conf();
            if (g_scope_product) die2("no product mutant", g_prod_touched ? "(patch touches product paths with 0 product mutants)" : "(patch adds no mutable product line)");
            die2("no mutant", "(patch adds no mutable .cx/.c line outside checks)");
        }
    }
    save_conf();
    for (i = 0; i < g_n_noncx_prod; i++) {
        fprintf(stderr, "MG_WARN product non-.cx file has 0 mutants: %s\n", g_noncx_prod[i]);
    }
    if (g_build_cmd && g_build_cmd[0]) {
        char qb[4096], sc[8192];
        shq(qb, sizeof qb, g_build_cmd);
        cx_fmt(sc, sizeof sc, "cd %s/slot-0 && exec setsid -w sh -c %s 2>&1", q3, qb);
        rc = sh(sc, out, sizeof out, 55);
        printf("MG_BASELINE build rc=%d\n", rc);
        if (rc != 0) { fprintf(stderr, "%.2000s\n", out); die2("baseline build failed:", g_build_cmd); }
    }
    /* baseline: every check must be green on the unmutated patched tree */
    for (i = 0; i < g_nchk; i++) {
        char sc[8192]; int failed;
        { char qc[4096]; shq(qc, sizeof qc, g_chk[i]); cx_fmt(sc, sizeof sc, "cd %s/slot-0 && exec setsid -w sh -c %s 2>&1", q3, qc); }
        rc = sh(sc, out, sizeof out, 55);
        { const char *fp = strstr(out, "failed="); failed = fp ? atoi(fp + 7) : 0; }
        printf("MG_BASELINE check=%d rc=%d failed=%d\n", i, rc, failed);
        if (rc != 0 || failed > 0) { fprintf(stderr, "%.2000s\n", out); die2("baseline check not green on patched tree:", g_chk[i]); }
    }
    /* harness self-test: the compile gate must reject a broken file, otherwise every mutant would be judged
       on a stale or unparsed tree (a non-waiting wrapper once made every rc 0) */
    {
        char fp[2048], qf[2048], sc[8192]; size_t on; char *orig;
        cx_fmt(fp, sizeof fp, "%s/slot-0/%s", g_out, g_files[g_c[0].file]);
        orig = slurp(fp, &on); if (!orig) die2("read", fp);
        { char *nb = mm_alloc((long)on + 64); cp(nb, (long)on + 64, orig, (long)on); cp(nb + on, 64, "\n@@ mutation-gate broken @@\n", 28); spit(fp, nb, on + 28); mm_free(nb); }
        shq(qf, sizeof qf, g_files[g_c[0].file]);
        cx_fmt(sc, sizeof sc, "cd %s/slot-0 && exec setsid -w sh ./unisacc.com -c -funit %s -o .mg-selftest.o >/dev/null 2>&1", q3, qf);
        rc = sh(sc, out, sizeof out, 55);
        spit(fp, orig, on); mm_free(orig);
        { char tp[1024]; cx_fmt(tp, sizeof tp, "%s/slot-0/.mg-selftest.o", g_out); sy_unlink(tp); }
        printf("MG_SELFTEST compile_gate_rejects_broken=%s\n", rc ? "yes" : "no");
        if (rc == 0) die2("compile gate inert:", "a deliberately broken file compiled");
    }
    if (g_scope_product) {
        char fp[2048], sc[8192], qb[4096], qc[4096]; size_t on; char *orig;
        cx_fmt(fp, sizeof fp, "%s/slot-0/%s", g_out, g_files[g_c[0].file]);
        orig = slurp(fp, &on); if (!orig) die2("read", fp);
        { char *nb = mm_alloc((long)on + 64); cp(nb, (long)on + 64, orig, (long)on); cp(nb + on, 64, "\n@@ mutation-gate broken @@\n", 28); spit(fp, nb, on + 28); mm_free(nb); }
        shq(qb, sizeof qb, g_build_cmd);
        cx_fmt(sc, sizeof sc, "cd %s/slot-0 && exec setsid -w sh -c %s >/dev/null 2>&1", q3, qb);
        rc = sh(sc, out, sizeof out, 55);
        if (rc == 0) {
            shq(qc, sizeof qc, g_chk[0]);
            cx_fmt(sc, sizeof sc, "cd %s/slot-0 && exec setsid -w sh -c %s 2>&1", q3, qc);
            rc = sh(sc, out, sizeof out, 55);
            { const char *fp2 = strstr(out, "failed="); if (rc == 0 && fp2 && atoi(fp2 + 7) > 0) rc = 1; }
        }
        spit(fp, orig, on); mm_free(orig);
        printf("MG_LIVENESS build_or_check_rejects_broken=%s\n", rc ? "yes" : "no");
        if (rc == 0) die2("liveness selftest failed:", "--build/--check stayed green on broken product file");
    }
    /* slot copies */
    for (i = 1; i < g_par; i++) { cx_fmt(cmd, sizeof cmd, "cp -a %s/slot-0 %s/slot-%d", q3, q3, i); if (sh(cmd, out, sizeof out, 55)) die2("copy slot", ""); }
    write_session("prepared");
    printf("MG_PREP_DONE ms=%ld out=%s\n", sy_now_ms() - t0, g_out);
}

/* ---------- worker ---------- */
static int killed_by(const char *out, int rc) {
    const char *p = out;
    if (rc != 0) return 1;
    while ((p = strstr(p, "failed=")) != 0) { if (atoi(p + 7) > 0) return 1; p += 7; }
    return 0;
}

enum Quality { Q_SURVIVED, Q_WEAK, Q_UNKNOWN, Q_NAMED, Q_INVALID };
static const char *quality_labels[] = {"SURVIVED", "KILL-weak", "UNKNOWN", "KILL-named", "INVALID"};

static int is_infra_line(const char *s, size_t n) {
    static const char *const tags[] = {"REFUSE", "ERR", 0};
    for (int t = 0; tags[t]; t++) {
        size_t tl = strlen(tags[t]);
        if (n == tl && !strncmp(s, tags[t], tl)) return 1;
        if (n > tl && !strncmp(s, tags[t], tl) && (s[tl] == ' ' || s[tl] == '\t' || s[tl] == ':')) return 1;
        for (size_t i = 0; i + tl < n; i++) {
            if ((s[i] == ' ' || s[i] == '\t') && !strncmp(s + i + 1, tags[t], tl)) {
                size_t a = i + 1 + tl;
                if (a == n || s[a] == ' ' || s[a] == '\t' || s[a] == ':') return 1;
            }
        }
    }
    return 0;
}

static int buf_has_infra(const char *b, size_t n) {
    for (const char *s = b; s < b + n;) {
        const char *e = memchr(s, '\n', (size_t)(b + n - s));
        size_t len = (size_t)(e ? e - s : (b + n - s));
        if (len && s[len - 1] == '\r') len--;
        if (is_infra_line(s, len)) return 1;
        s = e ? e + 1 : b + n;
    }
    return 0;
}

static int quality_check(const char *out, int rc, int check) {
    if (rc < 0 || rc >= 124) return Q_UNKNOWN;
    int named = 0, infrastructure = 0;
    for (const char *s = out; *s;) {
        const char *e = strchr(s, '\n');
        if (!e) e = s + strlen(s);
        size_t n = (size_t)(e - s);
        if (n && s[n - 1] == '\r') n--;
        if (is_infra_line(s, n)) infrastructure = 1;
        if (*e && (!strncmp(s, "FAIL ", 5) || !strncmp(s, "FAIL\t", 5))) {
            for (int i = 0; i < g_expect_n; i++) {
                const char *name = g_expect_name[i];
                if (g_expect_check[i] == check && name && strlen(name) + 5 == n && !memcmp(s + 5, name, n - 5)) named = 1;
            }
        }
        s = *e ? e + 1 : e;
    }
    if (infrastructure) return Q_UNKNOWN;
    for (int i = 0; i < g_expect_n; i++) {
        if (g_expect_check[i] == check && g_expect_code[i] && g_expect_code[i] == rc) named = 1;
    }
    if (named) return Q_NAMED;
    if (rc > 1) return Q_UNKNOWN;
    return killed_by(out, rc) ? Q_WEAK : Q_SURVIVED;
}

static void cstr_esc(char *dst, int cap, const char *src) {
    int k = 0;
    for (; *src && k < cap - 3; src++) {
        if (*src == '\\' || *src == '"') dst[k++] = '\\';
        dst[k++] = *src;
    }
    dst[k] = 0;
}

static size_t subst_probe(char *dst, size_t cap, const char *src, size_t sn, const char *probe, const char *tok) {
    size_t k = 0;
    for (size_t i = 0; i < sn; ) {
        if (i + 12 <= sn && !memcmp(src + i, "__MG_PROBE__", 12)) {
            size_t pl = strlen(probe);
            if (k + pl >= cap) return 0;
            cp(dst + k, (long)(cap - k), probe, (long)pl); k += pl; i += 12;
        } else if (i + 12 <= sn && !memcmp(src + i, "__MG_TOKEN__", 12)) {
            size_t tl = strlen(tok);
            if (k + tl >= cap) return 0;
            cp(dst + k, (long)(cap - k), tok, (long)tl); k += tl; i += 12;
        } else {
            if (k + 1 >= cap) return 0;
            dst[k++] = src[i++];
        }
    }
    return k;
}

static void worker(void) {
    char p[1024], out_abs[1024], q3[2048], sd[1024], res[1024]; size_t n; char *tsv, *s, *e; int fd_rows = 0;
    load_conf();
    if (!realpath(g_out, out_abs)) cx_fmt(out_abs, sizeof out_abs, "%s", g_out);
    cx_fmt(sd, sizeof sd, "%s/slot-%d", g_out, g_slot); shq(q3, sizeof q3, sd);
    cx_fmt(p, sizeof p, "%s/mutants.tsv", g_out); tsv = slurp(p, &n); if (!tsv) die2("missing", p);
    cx_fmt(res, sizeof res, "%s/res-%d.tsv", g_out, g_slot);
    { char acc[1 << 15]; int ak = 0;
    for (s = tsv; s < tsv + n; s = e + 1) {
        char row[2048], file[1024], fp[2048], mp[1024], probe_path[1200], probed_marker[1200], probe_esc[2200], token[96], expect_tok[100], out[65536], cmd[8192];
        int id, line, L, rc = 0, first_kill_rc = 0, i, verdict = 0, is_cov_row = 0, cov_probed = 0, best_cov_rank = 0;
        int quality = Q_SURVIVED, quality_rc = 0, check_id = -1;
        long t0 = sy_now_ms();
        e = s; while (e < tsv + n && *e != '\n') e++;
        L = (int)(e - s); if (L <= 0 || L >= (int)sizeof row) continue;
        cp(row, (long)sizeof row, s, L); row[L] = 0;
        id = atoi(row); if (id % g_par != g_slot) continue;
        { char *t1 = strchr(row, '\t'), *t2 = t1 ? strchr(t1 + 1, '\t') : 0, *t3 = t2 ? strchr(t2 + 1, '\t') : 0; if (!t2) continue; cp(file, (long)sizeof file - 1, t1 + 1, (long)(t2 - t1 - 1)); file[t2 - t1 - 1] = 0; line = atoi(t2 + 1); if (t3 && !strncmp(t3 + 1, "cov\t", 4)) is_cov_row = 1; }
        cx_fmt(fp, sizeof fp, "%s/%s", sd, file); cx_fmt(mp, sizeof mp, "%s/m/%d.line", g_out, id);
        cx_fmt(probe_path, sizeof probe_path, "%s/m/%d.probe", out_abs, id);
        sy_unlink(probe_path);
        for (i = 0; i < g_nchk; i++) {
            cx_fmt(probed_marker, sizeof probed_marker, "%s/m/%d.probed-%d", out_abs, id, i);
            sy_unlink(probed_marker);
        }
        cstr_esc(probe_esc, sizeof probe_esc, probe_path);
        cx_fmt(token, sizeof token, "%d-%d-%ld", id, (int)getpid(), t0);
        cx_fmt(expect_tok, sizeof expect_tok, "%s\n", token);
        size_t on, mn; char *orig = slurp(fp, &on), *ml = slurp(mp, &mn);
        if (!orig || !ml) { if (orig) mm_free(orig); if (ml) mm_free(ml); continue; }
        /* build mutated file */
        { size_t rcap = mn + 2400; char *rep = mm_alloc((long)rcap);
          size_t rlen = subst_probe(rep, rcap, ml, mn, probe_esc, token);
          char *nb = mm_alloc((long)(on + rlen + 8)); size_t k = 0, ls = 0; int cur = 1, replaced = 0; size_t i2;
          for (i2 = 0; i2 <= on; i2++) {
              if (i2 == on && ls == on) break;
              if (i2 == on || orig[i2] == '\n') {
                  if (cur == line) { cp(nb + k, (long)(on + rlen + 8 - k), rep, (long)rlen); k += rlen; replaced++; } else { cp(nb + k, (long)(on + rlen + 8 - k), orig + ls, (long)(i2 - ls)); k += i2 - ls; }
                  if (i2 < on) nb[k++] = '\n';
                  ls = i2 + 1; cur++;
              }
          }
          mm_free(rep);
          if (replaced != 1 || (k == on && !memcmp(nb, orig, on))) {
              quality = Q_INVALID;
              mm_free(nb);
              goto save_result;
          }
          spit(fp, nb, k); mm_free(nb); }
        /* compile gate */
        { char qf[2048]; shq(qf, sizeof qf, file);
          char ql[2048], lp[1024]; cx_fmt(lp, sizeof lp, "%s/m/%d.compile.log", g_out, id); shq(ql, sizeof ql, lp);
          cx_fmt(cmd, sizeof cmd, "cd %s && exec setsid -w sh ./unisacc.com -c -funit %s -o .mg-compile-%d.o >%s 2>&1", q3, qf, id, ql); }
        rc = sh(cmd, out, sizeof out, 55);
        { char tmpo[1024]; cx_fmt(tmpo, sizeof tmpo, "%s/.mg-compile-%d.o", sd, id); sy_unlink(tmpo); }
        if (rc != 0) { verdict = 2; quality = Q_UNKNOWN; quality_rc = rc; }
        else if (g_build_cmd && g_build_cmd[0]) {
            char qb[4096];
            shq(qb, sizeof qb, g_build_cmd);
            cx_fmt(cmd, sizeof cmd, "cd %s && exec setsid -w sh -c %s 2>&1", q3, qb);
            out[0] = 0; rc = sh(cmd, out, sizeof out, 55);
            if (rc != 0) { verdict = g_scope_product ? 3 : 2; quality = Q_UNKNOWN; quality_rc = rc; }
        }
        if (rc == 0 && verdict == 0) {
            for (i = 0; i < g_nchk; i++) {
                char qc[4096]; int this_probed = 0;
                shq(qc, sizeof qc, g_chk[i]);
                cx_fmt(cmd, sizeof cmd, "cd %s && exec setsid -w sh -c %s 2>&1", q3, qc);
                if (is_cov_row && g_scope_product) sy_unlink(probe_path);
                out[0] = 0; rc = sh(cmd, out, sizeof out, 55);
                if (is_cov_row && g_scope_product) {
                    size_t pn = 0; char *pb = slurp(probe_path, &pn);
                    if (pb && pn == strlen(expect_tok) && !memcmp(pb, expect_tok, pn)) {
                        this_probed = 1;
                        cx_fmt(probed_marker, sizeof probed_marker, "%s/m/%d.probed-%d", out_abs, id, i);
                        spit(probed_marker, "1\n", 2);
                    }
                    if (pb) mm_free(pb);
                    sy_unlink(probe_path);
                }
                if (g_quality || g_scope_product) {
                    int observation = quality_check(out, rc, i);
                    if (observation != Q_SURVIVED) {
                        cx_fmt(p, sizeof p, "%s/m/%d.check-%d.log", g_out, id, i);
                        spit(p, out, strlen(out));
                    }
                    if (is_cov_row && g_scope_product) {
                        int valid_cov = this_probed && !buf_has_infra(out, strlen(out)) &&
                            (observation == Q_NAMED || observation == Q_WEAK ||
                             (observation == Q_UNKNOWN && (rc == 139 || rc == 134 || rc == 135)));
                        int rank = valid_cov ? (observation == Q_NAMED ? 4 : 3)
                                 : (observation > Q_SURVIVED ? 2 : (this_probed ? 1 : 0));
                        if (rank > best_cov_rank || (rank == best_cov_rank && observation > quality)) {
                            best_cov_rank = rank;
                            quality = observation; quality_rc = rc; check_id = i;
                            cov_probed = this_probed;
                        }
                    } else if (observation > quality) {
                        quality = observation; quality_rc = rc; check_id = i;
                    }
                }
                if (!verdict && killed_by(out, rc)) { verdict = 1; first_kill_rc = rc; }
                if (verdict && ((!(g_quality || g_scope_product)) || (!is_cov_row && quality == Q_NAMED) || (is_cov_row && g_scope_product && best_cov_rank == 4))) break;
            }
        }
        spit(fp, orig, on);
        save_result:
        mm_free(orig); mm_free(ml);
        const char *legacy = quality == Q_INVALID ? "invalid" : verdict == 1 ? "killed" : verdict == 2 ? "compile_fail" : verdict == 3 ? "build_fail" : "survived";
        if (cx_fmt(acc + ak, sizeof acc - ak, "%d\t%s\t%d\t%ld\t%s\t%d\t%d\n",
                   id, legacy, verdict == 1 ? first_kill_rc : rc, sy_now_ms() - t0,
                   (g_quality || g_scope_product || quality == Q_INVALID) ? quality_labels[quality] : "-", quality_rc, check_id))
            die2("worker results", "too many bytes");
        ak += (int)strlen(acc + ak);
        spit(res, acc, (size_t)ak); fd_rows++;
    } }
    cx_fmt(p, sizeof p, "%s/done-%d", g_out, g_slot); spit(p, "1\n", 2);
    printf("MG_WORKER slot=%d rows=%d\n", g_slot, fd_rows);
}

/* ---------- report ---------- */
/* nth (0-based) TAB field of ROW into D; 0 when absent */
static int field(const char *row, int nth, char *d, int cap) {
    const char *s = row, *e; int k;
    for (k = 0; k < nth; k++) {
        s += strcspn(s, "\t\n");
        if (*s != '\t') { d[0] = 0; return 0; }
        s++;
    }
    e = s; while (*e && *e != '\t' && *e != '\n') e++;
    k = (int)(e - s); if (k >= cap) k = cap - 1;
    cp(d, cap, s, k); d[k] = 0; return 1;
}
/* function name of a cov mutant: the identifier right before the first '(' in "abort at entry of <line>" */
static void cov_func(const char *desc, char *d, int cap) {
    const char *p = strstr(desc, "abort at entry of "), *q, *a;
    int k;
    d[0] = 0; if (!p) return;
    p += 18; q = strchr(p, '('); if (!q) return;
    while (q > p && q[-1] == ' ') q--;
    a = q; while (a > p && isid((unsigned char)a[-1])) a--;
    k = (int)(q - a); if (k <= 0) return; if (k >= cap) k = cap - 1;
    cp(d, cap, a, k); d[k] = 0;
}
/* reviewer list: rows split into lines; comment (#) and blank lines skipped.  NULL path -> 0 rows. */
static int load_list(const char *path, char ***rows) {
    size_t n; char *b; int nr;
    *rows = 0; if (!path) return 0;
    b = slurp(path, &n); if (!b) die2("cannot read", path);
    nr = split_lines(b, n, rows);
    return nr;
}
/* is (file, func) in the --allow-uncovered rows?  rows must have a non-empty reason */
static int allowed_unc(char **R, int nr, const char *file, const char *func) {
    char f[1024], fn[256], why[1024]; int i;
    for (i = 0; i < nr; i++) {
        if (!R[i][0] || R[i][0] == '#') continue;
        if (!field(R[i], 0, f, sizeof f) || !field(R[i], 1, fn, sizeof fn) || !field(R[i], 2, why, sizeof why) || !why[0]) die2("--allow-uncovered row needs file, function, reason:", R[i]);
        if (!strcmp(f, file) && !strcmp(fn, func)) return 1;
    }
    return 0;
}
/* is the surviving mutant (file, line, kind, desc) adjudicated? */
static int adjudicated(char **R, int nr, const char *file, int line, const char *kind, const char *desc) {
    char f[1024], ln[32], mu[256], vd[64], why[1024]; int i;
    for (i = 0; i < nr; i++) {
        if (!R[i][0] || R[i][0] == '#') continue;
        if (!field(R[i], 0, f, sizeof f) || !field(R[i], 1, ln, sizeof ln) || !field(R[i], 2, mu, sizeof mu) || !field(R[i], 3, vd, sizeof vd) || !field(R[i], 4, why, sizeof why) || !why[0])
            die2("--adjudicated row needs file, line, mutation, verdict, reason:", R[i]);
        if (strcmp(vd, "equivalent") && strcmp(vd, "out-of-scope")) die2("--adjudicated verdict must be equivalent or out-of-scope:", R[i]);
        if (!strcmp(f, file) && atoi(ln) == line && (!strcmp(mu, desc) || !strcmp(mu, kind))) return 1;
    }
    return 0;
}

static int result_quality(const char *row) {
    char label[32];
    if (!row) return Q_UNKNOWN;
    if (!strncmp(row, "invalid\t", 8)) return Q_INVALID;
    if (!field(row, 3, label, sizeof label)) return Q_UNKNOWN;
    for (int i = 0; i <= Q_INVALID; i++) if (!strcmp(label, quality_labels[i])) return i;
    return Q_UNKNOWN;
}

static int check_log_has_infra(int id, int check_idx) {
    char p[1024];
    size_t n = 0;
    char *b;
    if (check_idx < 0) return 0;
    if (cx_fmt(p, sizeof p, "%s/m/%d.check-%d.log", g_out, id, check_idx)) return 0;
    b = slurp(p, &n);
    if (!b) return 0;
    int hit = buf_has_infra(b, n);
    mm_free(b);
    return hit;
}

static int check_log_has_named_assert(int id, int check_idx) {
    char p[1024];
    size_t n = 0;
    char *b;
    if (check_idx < 0) return 0;
    if (cx_fmt(p, sizeof p, "%s/m/%d.check-%d.log", g_out, id, check_idx)) return 0;
    b = slurp(p, &n);
    if (!b) return 0;
    int hit = 0, infra = 0;
    for (const char *s = b; s < b + n;) {
        const char *e = memchr(s, '\n', (size_t)(b + n - s));
        size_t len = (size_t)(e ? e - s : (b + n - s));
        if (len && s[len - 1] == '\r') len--;
        if (is_infra_line(s, len)) { infra = 1; break; }
        if (e && (!strncmp(s, "FAIL ", 5) || !strncmp(s, "FAIL\t", 5))) {
            for (int j = 0; j < g_expect_n; j++) {
                const char *name = g_expect_name[j];
                if (g_expect_check[j] == check_idx && name && strlen(name) + 5 == len && !memcmp(s + 5, name, len - 5)) hit = 1;
            }
        }
        s = e ? e + 1 : b + n;
    }
    mm_free(b);
    return hit && !infra;
}

typedef struct { char *b; size_t len, cap; } DynBuf;
static void dyn_app(DynBuf *d, const char *s, size_t n) {
    if (!n) return;
    if (d->len + n + 1 > d->cap) {
        size_t nc = d->cap ? d->cap : 4096;
        while (nc < d->len + n + 1) nc *= 2;
        d->b = mm_grow(d->b, (long)nc);
        d->cap = nc;
    }
    cp(d->b + d->len, (long)(d->cap - d->len), s, (long)n);
    d->len += n;
    d->b[d->len] = 0;
}

static int report(void) {
    char p[1024], sv[1 << 16], unc[8192]; size_t n; char *tsv, *s, *e; int N = 0, K = 0, S = 0, C = 0, CN = 0, CK = 0, CS = 0, sk = 0, missing = 0, verdict;
    int A = 0, CW = 0, uk = 0, md_N = 0, md_K = 0, md_S = 0, md_L = 0, md_A = 0, md_F = 0, md_C = 0, md_D = 0; char **AU, **AJ; int nau, naj;
    DynBuf sum_buf = {0}, md_buf = {0};
    FILE *quality_file = 0;
    int qualities[Q_INVALID + 1] = {0}, qa = 0;
    load_conf();
    if (g_scope_product && !g_cov) die2("--scope product requires --coverage-check", "");
    if (g_scope_product && (!g_build_cmd || !g_build_cmd[0])) die2("--scope product requires --build", "");
    nau = load_list(g_allow_unc, &AU); naj = load_list(g_adjud, &AJ);
    unc[0] = 0;
    cx_fmt(p, sizeof p, "%s/mutants.tsv", g_out); tsv = slurp(p, &n); if (!tsv) die2("missing", p);
    if (g_quality) {
        cx_fmt(p, sizeof p, "%s/mutation-quality.tsv", g_out);
        quality_file = fopen(p, "w");
        if (!quality_file) die2("write", p);
        fputs("id\tfile\tline\tkind\tclassification\trc\tcheck_index\tadjudicated\n", quality_file);
    }
    char *res[16]; size_t rn[16]; int i;
    for (i = 0; i < g_par && i < 16; i++) { cx_fmt(p, sizeof p, "%s/res-%d.tsv", g_out, i); res[i] = slurp(p, &rn[i]); if (!res[i]) rn[i] = 0; }
    sk += snprintf(sv + sk, sizeof sv - sk, "id\tfile\tline\tkind\tmutation\tmutated_line\n");
    for (s = tsv; s < tsv + n; s = e + 1) {
        char row[2048], key[32], mp[1024]; int id, L, slot; const char *r = 0, *kind;
        e = s; while (e < tsv + n && *e != '\n') e++;
        L = (int)(e - s); if (L <= 0 || L >= (int)sizeof row) continue;
        cp(row, (long)sizeof row, s, L); row[L] = 0; id = atoi(row); slot = id % g_par;
        { char *t = row; int k; for (k = 0; k < 3 && t; k++) t = strchr(t + 1, '\t'); kind = t ? t + 1 : ""; }
        int iscov = !strncmp(kind, "cov", 3);
        cx_fmt(key, sizeof key, "%d\t", id);
        if (slot < 16 && res[slot]) { const char *q = res[slot]; while (q && q < res[slot] + rn[slot]) { if (!strncmp(q, key, strlen(key))) { r = q + strlen(key); break; } q = memchr(q, '\n', (size_t)(res[slot] + rn[slot] - q)); if (q) q++; } }
        char fl[1024], kd[32], ds[256], ln[32], qrc_s[32], qchk_s[32];
        field(row, 1, fl, sizeof fl); field(row, 2, ln, sizeof ln); field(row, 3, kd, sizeof kd); field(row, 4, ds, sizeof ds);
        int is_adj = r && !iscov && !strncmp(r, "survived\t", 9) && adjudicated(AJ, naj, fl, atoi(ln), kd, ds);
        int q = result_quality(r);
        int qrc = (r && field(r, 4, qrc_s, sizeof qrc_s) && strcmp(qrc_s, "-")) ? atoi(qrc_s) : 0;
        int qchk = (r && field(r, 5, qchk_s, sizeof qchk_s) && strcmp(qchk_s, "-")) ? atoi(qchk_s) : -1;
        int unexec = !r || q == Q_INVALID || !strncmp(r, "compile_fail", 12) || !strncmp(r, "build_fail", 10);
        char pm_path[1024];
        int probed = g_scope_product && iscov && qchk >= 0 &&
            !cx_fmt(pm_path, sizeof pm_path, "%s/m/%d.probed-%d", g_out, id, qchk) && sy_exists(pm_path) == 1;
        int cov_live_kill = iscov && !unexec && probed && !check_log_has_infra(id, qchk) && (q == Q_NAMED || q == Q_WEAK || (q == Q_UNKNOWN && (qrc == 139 || qrc == 134 || qrc == 135)));
        int prod_named_kill = g_scope_product && !iscov && !unexec && q == Q_NAMED && check_log_has_named_assert(id, qchk);
        if (g_scope_product) {
            char linebuf[2048];
            if (!iscov) {
                md_N++;
                if (prod_named_kill) {
                    md_K++;
                } else if (!unexec && q == Q_SURVIVED) {
                    md_S++; md_A += is_adj;
                    if (!is_adj) {
                        if (!cx_fmt(linebuf, sizeof linebuf, "MD_SURVIVOR %s %s %s\n", fl, ln, kd))
                            dyn_app(&md_buf, linebuf, strlen(linebuf));
                    }
                } else {
                    const char *why = (!r || q == Q_INVALID) ? "missing"
                        : !strncmp(r, "compile_fail", 12) ? "compile_fail"
                        : !strncmp(r, "build_fail", 10) ? "build_fail"
                        : (q == Q_UNKNOWN && qrc == 124) ? "timeout"
                        : "infra";
                    md_L++;
                    if (!cx_fmt(linebuf, sizeof linebuf, "MD_NOT_LIVE %s %s %s %s\n", fl, ln, kd, why))
                        dyn_app(&md_buf, linebuf, strlen(linebuf));
                }
            } else {
                md_F++;
                if (cov_live_kill) {
                    md_C++;
                } else {
                    const char *why = (!r || q == Q_INVALID) ? "missing"
                        : !strncmp(r, "compile_fail", 12) ? "compile_fail"
                        : !strncmp(r, "build_fail", 10) ? "build_fail"
                        : (q == Q_UNKNOWN && qrc == 124) ? "timeout"
                        : (check_log_has_infra(id, qchk) || (qrc >= 125 && qrc <= 127) || qrc == 137 || qrc == 143) ? "infra"
                        : "cov";
                    md_D++;
                    if (!cx_fmt(linebuf, sizeof linebuf, "MD_NOT_LIVE %s %s cov %s\n", fl, ln, why))
                        dyn_app(&md_buf, linebuf, strlen(linebuf));
                }
            }
        }
        if (quality_file) {
            char qr[32], qi[32];
            int q_adj = q == Q_SURVIVED && is_adj;
            if (!r || !field(r, 4, qr, sizeof qr)) cx_fmt(qr, sizeof qr, "-");
            if (!r || !field(r, 5, qi, sizeof qi)) cx_fmt(qi, sizeof qi, "-");
            if (!iscov) { qualities[q]++; qa += q_adj; }
            fprintf(quality_file, "%d\t%s\t%s\t%s\t%s\t%s\t%s\t%d\n", id, fl, ln, kd, quality_labels[q], qr, qi, q_adj);
        }
        if (!r) { missing++; continue; }
        if (q == Q_INVALID) {
            if (iscov) missing++;
            continue;
        }
        if (!strncmp(r, "compile_fail", 12) || !strncmp(r, "build_fail", 10)) { C++; continue; }
        if (iscov) {
            CN++;
            if (g_scope_product ? cov_live_kill : !strncmp(r, "killed", 6)) CK++;
            else {
                char fn[256]; int ok; CS++;
                cov_func(ds, fn, sizeof fn);
                ok = fn[0] && allowed_unc(AU, nau, fl, fn);
                if (ok) CW++;
                uk += snprintf(unc + uk, sizeof unc - uk, "MG_UNCOVERED %s %s %s line=%s\n", fl, fn[0] ? fn : "?", ok ? "allowed" : "blocking", ln);
                if (uk > (int)sizeof unc - 400) uk = (int)sizeof unc - 400;
            }
        }
        else {
            N++;
            if (!strncmp(r, "killed", 6)) K++;
            else { S++; A += is_adj; }
        }
        if (!strncmp(r, "survived", 8)) {
            size_t mn; cx_fmt(mp, sizeof mp, "%s/m/%d.line", g_out, id); char *ml = slurp(mp, &mn);
            char *t; for (t = ml; ml && *t; t++) if (*t == '\t' || *t == '\n') *t = ' ';
            /* row = id file line kind desc */
            sk += snprintf(sv + sk, sizeof sv - sk, "%s\t%.300s\n", row, ml ? ml : "");
            if (sk > (int)sizeof sv - 600) sk = (int)sizeof sv - 600;
            if (ml) mm_free(ml);
        }
    }
    if (quality_file) {
        int low = qualities[Q_NAMED], high = low + qualities[Q_WEAK] + qualities[Q_UNKNOWN];
        int qn = high + qualities[Q_SURVIVED] - qa;
        if (ferror(quality_file) || fclose(quality_file)) die2("write", "mutation-quality.tsv");
        const char *status = !qn ? "UNMEASURED" : (double)low / qn >= g_min ? "ABOVE" :
                             (double)high / qn < g_min ? "BELOW" : "INCONCLUSIVE";
        printf("MUTATION_QUALITY named=%d weak=%d unknown=%d invalid=%d survived=%d adjudicated=%d lower=%d/%d upper=%d/%d min=%.2f status=%s\n",
               low, qualities[Q_WEAK], qualities[Q_UNKNOWN], qualities[Q_INVALID], qualities[Q_SURVIVED], qa,
               low, qn, high, qn, g_min, status);
    }
    cx_fmt(p, sizeof p, "%s/survivors.tsv", g_out); spit(p, sv, (size_t)sk);
    double sc = N ? (double)K / N : 0.0;
    int NA = N - A; double sa = NA > 0 ? (double)K / NA : (N > 0 ? 1.0 : 0.0);
    /* uncovered > 0 fails unless every uncovered function is allowed by the reviewer list */
    verdict = (N > 0 && sa + 1e-9 >= g_min && CS == CW && missing == 0) ? 0 : 1;
    if (g_scope_product && (md_K + md_S + md_L != md_N || md_C + md_D != md_F))
        die2("MUTATION_DIFF accounting mismatch", "");
    { char head[16384];
      int hk = snprintf(head, sizeof head, "MUTATION_GATE mutants=%d killed=%d survived=%d compile_fail=%d missing=%d score=%d/%d(=%.2f) adjudicated=%d score_adj=%d/%d(=%.2f) min=%.2f verdict=%s\n", N, K, S, C, missing, K, N, sc, A, K, NA, sa, g_min, verdict ? "FAIL" : "PASS");
      if (hk > 0) dyn_app(&sum_buf, head, (size_t)hk < sizeof head ? (size_t)hk : sizeof head - 1);
      if (g_cov && !cx_fmt(head, sizeof head, "MUTATION_COVERAGE funcs=%d covered=%d uncovered=%d allowed=%d\n%s", CN, CK, CS, CW, unc))
          dyn_app(&sum_buf, head, strlen(head));
    }
    int md_verdict = (md_N > 0 && (md_S - md_A) == 0 && md_L == 0 && md_D == 0) ? 0 : 1;
    if (g_scope_product) {
        char mdline[512];
        if (!cx_fmt(mdline, sizeof mdline, "MUTATION_DIFF scope=product hunks=%d mutants=%d killed=%d survived=%d not_live=%d cov_funcs=%d cov_live=%d cov_not_live=%d adjudicated=%d verdict=%s\n",
                    g_hunks, md_N, md_K, md_S, md_L, md_F, md_C, md_D, md_A, md_verdict ? "FAIL" : "PASS"))
            dyn_app(&sum_buf, mdline, strlen(mdline));
        if (md_buf.len) dyn_app(&sum_buf, md_buf.b, md_buf.len);
    }
    cx_fmt(p, sizeof p, "%s/SUMMARY", g_out); spit(p, sum_buf.b ? sum_buf.b : "", sum_buf.len);
    if (sum_buf.b) fputs(sum_buf.b, stdout);
    if (md_buf.b) mm_free(md_buf.b);
    if (sum_buf.b) mm_free(sum_buf.b);
    printf("MG_SURVIVORS %s/survivors.tsv\n", g_out);
    write_session((g_scope_product ? md_N : N) ? "done" : "done-empty");
    if (g_scope_product) return md_N == 0 ? 2 : md_verdict;
    if (N == 0) return 2;
    return verdict;
}

/* ---------- run ---------- */
static int run_all(const char *self) {
    char cmd[16384], out[8192], q3[2048], qs[2048]; int i, rc; long t0 = sy_now_ms();
    prep();
    shq(q3, sizeof q3, g_out); shq(qs, sizeof qs, self);
    for (i = 0; i < g_par; i++) {
        cx_fmt(cmd, sizeof cmd, "setsid timeout -k 5 %d sh ./unisacc.com %s -- worker --out %s --slot %d > %s/worker-%d.log 2>&1 < /dev/null & echo $! > %s/worker-%d.pid", g_deadline, qs, q3, i, q3, i, q3, i);
        rc = sh(cmd, out, sizeof out, 30); if (rc) die2("spawn worker", "");
    }
    /* bounded wait: total deadline g_deadline s; default mode keeps 2 s poll, product scope polls every 250 ms */
    { int poll_ms = g_scope_product ? 250 : 2000;
      int max_it = g_scope_product ? (g_deadline * 4 + 20) : (g_deadline / 2 + 10);
      for (int it = 0; it < max_it; it++) {
        int done = 0; char p[1024];
        for (i = 0; i < g_par; i++) { cx_fmt(p, sizeof p, "%s/done-%d", g_out, i); if (sy_exists(p)) done++; }
        if (done == g_par) break;
        /* a worker whose process group is gone without done marker counts as finished (missing rows reported) */
        { int alive = 0; for (i = 0; i < g_par; i++) { char sc[2048]; cx_fmt(sc, sizeof sc, "kill -0 \"$(cat %s/worker-%d.pid)\" 2>/dev/null", q3, i); if (sh(sc, 0, 0, 5) == 0) alive++; } if (alive == 0) break; }
        sy_sleep_ms(poll_ms);
      }
    }
    /* clean leftovers by real PGID (setsid: pgid == pid) */
    for (i = 0; i < g_par; i++) { cx_fmt(cmd, sizeof cmd, "p=$(cat %s/worker-%d.pid 2>/dev/null) && kill -0 \"$p\" 2>/dev/null && kill -TERM -- -\"$p\" 2>/dev/null; true", q3, i); sh(cmd, 0, 0, 5); }
    rc = report();
    /* 只有 report 写出了结论才清槽:SUMMARY 非空才动手,否则保留现场。 */
    if (rc == 0 || rc == 1) { write_session("done"); drop_slots(); }
    printf("MG_RUN ms=%ld\n", sy_now_ms() - t0);
    return rc;
}

static int execution_command(const char *cmd, const char *id, const char *path, int secs,
                             const char *pass_name, const char *fail_name) {
    char *argv[] = {"sh", "-c", (char *)cmd, "mutation-gate", (char *)id, (char *)path, 0};
    np_result res = {0};
    char why[256] = {0};
    int rc = np_run(argv, 0, 0, secs, &res, why, sizeof why);
    int result = 2;
    if (!rc && !res.residue && !res.timed_out && (res.rc == 0 || res.rc == 1)) {
        if (!pass_name) result = res.rc;
        else if (res.out) {
            const char *prefix = res.rc == 0 ? "PASS\t" : "FAIL\t";
            const char *name = res.rc == 0 ? pass_name : fail_name;
            long len = name ? (long)strlen(name) : 0;
            long pass_len = (long)strlen(pass_name);
            int matches = 0, records = 0;
            for (long at = 0; at < (long)res.outn;) {
                long end = at;
                while (end < (long)res.outn && res.out[end] != '\n') end++;
                const char *line = res.out + at;
                if (end < (long)res.outn) {
                    if (name && end - at == len + 5 && !memcmp(line, prefix, 5) &&
                        !memcmp(line + 5, name, (size_t)len)) matches++;
                    if ((end - at == pass_len + 5 && !memcmp(line, "PASS\t", 5) &&
                         !memcmp(line + 5, pass_name, (size_t)pass_len)) ||
                        (end - at >= 5 && !memcmp(line, "FAIL\t", 5))) records++;
                }
                at = end + 1;
            }
            if (records == 1 && matches == 1) result = res.rc;
        }
    }
    if (res.outn) (void)sy_write_all(1, res.out, (long)res.outn);
    if (res.errn) (void)sy_write_all(2, res.err, (long)res.errn);
    if (result == 2) fprintf(stderr, "mutation-gate: execution result unverified rc=%d %s\n", res.rc, why);
    np_free(&res);
    return result;
}

static unsigned char *execution_evidence(const char *path, int64_t *n) {
    sy_stat_t st;
    unsigned char *data = 0;
    if (sy_lstat(path, &st) != 0 || st.kind != 'f' || st.size <= 0 ||
        sy_read_file(path, &data, n, 64L << 20) != 0 || !data || *n != st.size) {
        mm_free(data);
        return 0;
    }
    return data;
}

static int execution_name_ok(const char *name) {
    return name && *name && !strpbrk(name, "\r\n\t");
}

static int execution_gate(int argc, char **argv) {
    const char *produce = 0, *judge = 0, *assertion = 0;
    const char *missing = 0, *stale = 0;
    int secs = 55;
    for (int i = 2; i < argc; i += 2) {
        if (i + 1 == argc) die2("missing value for", argv[i]);
        const char *v = argv[i + 1];
        if (!strcmp(argv[i], "--produce")) produce = v;
        else if (!strcmp(argv[i], "--judge")) judge = v;
        else if (!strcmp(argv[i], "--assertion")) assertion = v;
        else if (!strcmp(argv[i], "--expect-missing")) missing = v;
        else if (!strcmp(argv[i], "--expect-stale")) stale = v;
        else if (!strcmp(argv[i], "--timeout-s")) {
            char *end;
            long parsed = strtol(v, &end, 10);
            if (!*v || *end || parsed < 1 || parsed > 55) die2("bad --timeout-s", v);
            secs = (int)parsed;
        } else die2("unknown execution option", argv[i]);
    }
    if (!produce || !*produce || !judge || !*judge || !execution_name_ok(assertion) ||
        !execution_name_ok(missing) || !execution_name_ok(stale) || !strcmp(missing, stale))
        die2("usage", "execution --produce CMD --judge CMD --assertion NAME --expect-missing NAME --expect-stale DIFFERENT_NAME");

    char tmp[1024], path[1100], old_id[1100], current_id[1100];
    if (sr_scratch("mutation-gate-execution", tmp, sizeof tmp)) die2("execution scratch", "");
    if (cx_fmt(path, sizeof path, "%s/evidence", tmp) ||
        sy_mkdtemp(tmp, "id-", old_id, sizeof old_id) ||
        sy_mkdtemp(tmp, "id-", current_id, sizeof current_id)) {
        (void)sy_remove_all(tmp);
        die2("execution scratch", "");
    }

    int64_t old_n = 0;
    unsigned char *old = 0;
    int deleted = 2, replayed = 2, result = 2;
    if (execution_command(produce, old_id, path, secs, 0, 0) || !(old = execution_evidence(path, &old_n)) ||
        execution_command(judge, old_id, path, secs, assertion, 0) || sy_unlink(path) != 0) {
        fprintf(stderr, "mutation-gate: REFUSE execution baseline\n");
        goto done;
    }

    deleted = execution_command(judge, current_id, path, secs, assertion, missing);
    sy_stat_t st;
    if (sy_lstat(path, &st) != -ENOENT || sy_write_file(path, old, (long)old_n, 0600) != 0) goto done;
    replayed = execution_command(judge, current_id, path, secs, assertion, stale);
    int64_t replay_n = 0;
    unsigned char *readback = execution_evidence(path, &replay_n);
    int unchanged = readback && replay_n == old_n && mm_same(readback, old, (long)old_n);
    mm_free(readback);
    if (!unchanged) {
        replayed = 2;
        fprintf(stderr, "mutation-gate: REFUSE replay evidence changed by judge\n");
        goto done;
    }
    if (sy_unlink(path) != 0 || execution_command(produce, current_id, path, secs, 0, 0) ||
        !(readback = execution_evidence(path, &replay_n))) {
        deleted = replayed = 2;
        fprintf(stderr, "mutation-gate: REFUSE current positive control\n");
        goto done;
    }
    mm_free(readback);
    if (execution_command(judge, current_id, path, secs, assertion, 0) != 0) {
        deleted = replayed = 2;
        fprintf(stderr, "mutation-gate: REFUSE current positive control\n");
        goto done;
    }
    if (deleted != 2 && replayed != 2) result = (deleted == 1 && replayed == 1) ? 0 : 1;
done:
    printf("MUTATION_EXECUTION\toperator=delete-run-step\tverdict=%s\n",
           deleted == 2 ? "UNMEASURED" : (deleted == 1 ? "KILLED" : "SURVIVED"));
    printf("MUTATION_EXECUTION\toperator=feed-previous-output\tverdict=%s\n",
           replayed == 2 ? "UNMEASURED" : (replayed == 1 ? "KILLED" : "SURVIVED"));
    mm_free(old);
    if (sy_remove_all(tmp) != 0) return 2;
    return result;
}

int main(int argc, char **argv) {
    const char *mode; int i;
    if (argc < 2) die2("usage", "run|prep|worker|report ...");
    mode = argv[1];
    if (!strcmp(mode, "execution")) return execution_gate(argc, argv);
    if (!strcmp(mode, "--report")) { mode = "report"; g_quality = 1; }
    for (i = 2; i < argc; i++) {
        const char *a = argv[i], *v = i + 1 < argc ? argv[i + 1] : 0;
        if (!strcmp(a, "--coverage-check")) { g_cov = 1; continue; }
        if (!strcmp(a, "--report")) { g_quality = 1; continue; }
        if (!strcmp(a, "--mutate-checks")) { g_mutchecks = 1; continue; }
        if (!strcmp(a, "--git")) { g_git = 1; continue; }
        if (!v) die2("missing value for", a);
        if (!strcmp(a, "--patch")) g_patch = v;
        else if (!strcmp(a, "--base")) g_base = v;
        else if (!strcmp(a, "--out")) g_out = v;
        else if (!strcmp(a, "--repo")) g_repo = v;
        else if (!strcmp(a, "--check")) { if (g_nchk >= MG_MAXCHK) die2("too many", "--check"); g_chk[g_nchk++] = v; }
        else if (!strcmp(a, "--expect-fail")) expect_failure("name", v);
        else if (!strcmp(a, "--expect-rc")) expect_failure("rc", v);
        else if (!strcmp(a, "--max")) { g_max = atoi(v); if (g_max < 1 || g_max > 500) die2("--max outside 1..500", v); }
        else if (!strcmp(a, "--par")) { g_par = atoi(v); if (g_par < 1 || g_par > 16) die2("--par outside 1..16", v); }
        else if (!strcmp(a, "--min-score")) { g_min = atof(v); g_min_set = 1; if (g_min < 0 || g_min > 1) die2("--min-score outside 0..1", v); }
        else if (!strcmp(a, "--allow-uncovered")) g_allow_unc = v;
        else if (!strcmp(a, "--adjudicated")) g_adjud = v;
        else if (!strcmp(a, "--slot")) g_slot = atoi(v);
        else if (!strcmp(a, "--deadline-s")) { g_deadline = atoi(v); if (g_deadline < 30 || g_deadline > 3600) die2("--deadline-s outside 30..3600", v); }
        else if (!strcmp(a, "--scope")) {
            if (!strcmp(v, "product")) g_scope_product = 1;
            else if (!strcmp(v, "all")) g_scope_product = 0;
            else die2("unknown --scope", v);
        }
        else if (!strcmp(a, "--build")) g_build_cmd = v;
        else die2("unknown option", a);
        i++;
    }
    derive_out();
    if (!g_out) die2("usage", "--out required");
    if (g_scope_product && !g_cov && (!strcmp(mode, "prep") || !strcmp(mode, "run")))
        die2("--scope product requires --coverage-check", "");
    if (g_scope_product && (!g_build_cmd || !g_build_cmd[0]) && (!strcmp(mode, "prep") || !strcmp(mode, "run")))
        die2("--scope product requires --build", "");
    if (g_expect_n && (!(g_quality || g_scope_product) || (strcmp(mode, "run") && strcmp(mode, "prep"))))
        die2("usage", "check expectations require run or prep with --report");
    if (!strcmp(mode, "prep")) { prep(); return 0; }
    if (!strcmp(mode, "worker")) { if (g_slot < 0) die2("usage", "--slot"); worker(); return 0; }
    if (!strcmp(mode, "report")) return report();
    if (!strcmp(mode, "reclaim")) { drop_slots_mode(); return 0; }
    if (!strcmp(mode, "run")) return run_all("tools/mutation-gate.cx");
    die2("unknown mode", mode);
    return 2;
}
