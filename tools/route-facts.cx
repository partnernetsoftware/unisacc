/* tools/route-facts.cx -- route and stage decision as a full-key fact table (draft) and
 * the installed product's observed baseline over the same keys.  No consumer reads these
 * tables yet; they prepare moving the decision from code to "fact table -> generator -> table".
 *
 *   sh ./unisacc.com tools/route-facts.cx -- --write              write build/route-facts.draft.tsv
 *   sh ./unisacc.com tools/route-facts.cx -- --check              draft file equals the generator output
 *   sh ./unisacc.com tools/route-facts.cx -- --baseline --write   run the product on every key, write build/route-baseline.tsv
 *   sh ./unisacc.com tools/route-facts.cx -- --baseline --check   run the product on every key, compare with the file
 *   sh ./unisacc.com tools/route-facts.cx -- --compare A B        compare every shared column of every key; rc 1 on a mismatch
 *
 * Key domain: mode 0..5 x level 0..2 x six targets = 108 cells.
 *   mode 0 image, 1 pp (-E), 2 tape (-S), 3 run (-run), 4 tokens (-dump-tokens), 5 object (-c -b).
 * Draft columns: mode level target kind route gap stages cont rc.
 *   kind, route and gap restate cx/driver/route.cx (cxt_kind, cxt_route_write, warnings off, one source)
 *   and cx/runtime/runexec.cx (st_gap); the baseline cannot observe them, so they are compared with nothing.
 *   stages, cont and rc are the columns the baseline observes.
 * Baseline method: for each key run the product in ./unisacc.com with UNISACC_RR_TIME=1 and a private
 *   empty UNISACC_CACHE_DIR on a one-line C source, flags "-OL -b TARGET MODEFLAGS"; stages is the
 *   order of "RR_TIME<TAB>inference<TAB>stage=" lines on stderr, cont is e4 when e4 ran, else prune when
 *   prune ran, else "-"; rc is the product's exit code.  Each child is bounded to 20 s.
 * Product under test: ./unisacc.com in the current directory.  Work files go to $TMPDIR or /tmp. */
#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use text.text
#pragma unisa use cxlib.netpack

#define DRAFT "build/route-facts.draft.tsv"
#define BASE "build/route-baseline.tsv"
#define NMODE 6
#define NLEVEL 3
#define NTGT 6
#define NCELL 108
#define CAP 65536
#define MAXROW 256
#define MAXCOL 12

static const char *tgts[NTGT] = { "lnx/x86_64", "lnx/arm64", "osx/x86_64", "osx/arm64", "win/x86_64", "win/arm64" };
static const char *kinds[NMODE] = { "image", "pp", "tape", "run", "tokens", "object" };

static char obuf[CAP];
static long olen;

static int fail(const char *why) {
    fprintf(stderr, "route-facts\tFAIL\t%s\n", why);
    return 2;
}

static void put(const char *s) {
    while (*s && olen + 1 < CAP) obuf[olen++] = *s++;
    obuf[olen] = 0;
}

static void put_int(int v) {
    char t[16];
    if (cx_fmt(t, sizeof t, "%d", v)) t[0] = 0;
    put(t);
}

static long slurp(const char *path, char *dst, long cap) {
    FILE *f = fopen(path, "rb");
    long n;
    if (!f) return -1;
    n = (long)fread(dst, 1, (size_t)(cap - 1), f);
    fclose(f);
    dst[n] = 0;
    return n;
}

static int spill(const char *path, const char *src, long n) {
    FILE *f = fopen(path, "wb");
    if (!f) return 1;
    if ((long)fwrite(src, 1, (size_t)n, f) != n) { fclose(f); return 1; }
    return fclose(f) ? 1 : 0;
}

/* ---- the draft: the decision written out per key ---- */

static const char *draft_stages(int mode, int level) {
    if (mode == 1) return "-";
    if (mode == 4) return "tokenpp,tokenlex";
    if (mode == 2) return level > 0 ? "e2,e1,e3,tapecheck,e4" : "e2,e1,e3,tapecheck";
    if (mode == 5) return level > 0 ? "e2,e1,e3,tapecheck,e4,prune,lower,elf" : "e2,e1,e3,tapecheck,prune,lower,elf";
    return level > 0 ? "e2,e1,e3,e4,prune,lower,elf" : "e2,e1,e3,prune,lower,elf";
}

static const char *draft_cont(int mode, int level) {
    if (mode == 1 || mode == 4) return "-";
    if (level > 0) return "e4";
    return mode == 2 ? "-" : "prune";
}

static const char *draft_gap(int mode, int level) {
    if (mode == 1) return "e2";
    if (mode == 4) return "tokens";
    if (mode == 5) return "object";
    if (mode == 2) return level > 0 ? "e4" : "tapecheck";
    if (mode == 3) return "memory";
    return "elf";
}

static void draft_build(void) {
    int m, l, t;
    olen = 0;
    put("# Draft route fact table. Generated by tools/route-facts.cx -- --write. Not read by any consumer.\n");
    put("# Key: mode level target. kind route gap restate the source and are not observed by the baseline.\n");
    put("# NATIVE in route is the host target: cxt_decide forces it for -run.\n");
    put("mode\tlevel\ttarget\tkind\troute\tgap\tstages\tcont\trc\n");
    for (m = 0; m < NMODE; m++) for (l = 0; l < NLEVEL; l++) for (t = 0; t < NTGT; t++) {
        put_int(m); put("\t"); put_int(l); put("\t"); put(tgts[t]); put("\t"); put(kinds[m]); put("\t");
        if (m == 4) put("tokens");
        else if (m == 1) { put(tgts[t]); put("/pp"); }
        else { put(m == 3 ? "NATIVE" : tgts[t]); put("/"); put(kinds[m]); put("/O"); put_int(l); }
        put("\t"); put(draft_gap(m, l)); put("\t"); put(draft_stages(m, l)); put("\t"); put(draft_cont(m, l)); put("\t0\n");
    }
}

/* ---- the baseline: what the installed product does per key ---- */

static char work[4096], prod[4200], srcp[4200], cache_env[4400], outp[4200];

static int base_cell(int m, int l, int t) {
    char *av[16];
    char *env[3];
    char why[512], lv[8];
    np_result r = {0};
    const char *mark = "RR_TIME\tinference\tstage=";
    int k = 0, ml = 24, saw_e4 = 0, saw_prune = 0, first = 1;
    size_t i;
    if (cx_fmt(lv, sizeof lv, "-O%d", l)) return 1;
    av[k++] = "sh"; av[k++] = prod; av[k++] = lv; av[k++] = "-b"; av[k++] = (char *)tgts[t];
    if (m == 0) { av[k++] = "-o"; av[k++] = outp; }
    if (m == 1) av[k++] = "-E";
    if (m == 2) { av[k++] = "-S"; av[k++] = "-o"; av[k++] = outp; }
    if (m == 3) av[k++] = "-run";
    if (m == 4) av[k++] = "-dump-tokens";
    if (m == 5) { av[k++] = "-c"; av[k++] = "-o"; av[k++] = outp; }
    av[k++] = srcp; av[k] = 0;
    env[0] = "UNISACC_RR_TIME=1"; env[1] = cache_env; env[2] = 0;
    if (np_run(av, work, env, 20, &r, why, sizeof why)) {
        fprintf(stderr, "route-facts\tFAIL\tspawn mode=%d level=%d target=%s: %s\n", m, l, tgts[t], why);
        return 1;
    }
    put_int(m); put("\t"); put_int(l); put("\t"); put(tgts[t]); put("\t");
    for (i = 0; r.err && i + ml < r.errn; i++) {
        if ((i == 0 || r.err[i - 1] == '\n') && !memcmp(r.err + i, mark, (size_t)ml)) {
            char name[32];
            int n = 0;
            size_t j = i + ml;
            while (j < r.errn && r.err[j] != '\t' && r.err[j] != '\n' && n < 31) name[n++] = r.err[j++];
            name[n] = 0;
            if (!first) put(",");
            put(name);
            first = 0;
            if (!strcmp(name, "e4")) saw_e4 = 1;
            if (!strcmp(name, "prune")) saw_prune = 1;
        }
    }
    if (first) put("-");
    put("\t"); put(saw_e4 ? "e4" : saw_prune ? "prune" : "-"); put("\t"); put_int(r.rc); put("\n");
    np_free(&r);
    return 0;
}

static int base_build(void) {
    const char *td = getenv("TMPDIR");
    char cache[4200];
    int m, l, t;
    if (!td || !td[0]) td = "/tmp";
    if (sy_realpath("./unisacc.com", prod, sizeof prod) < 0) return fail("no ./unisacc.com here");
    if (cx_fmt(work, sizeof work, "%s/route-facts-%d", td, (int)getpid()) ||
        cx_fmt(cache, sizeof cache, "%s/cache", work) ||
        cx_fmt(cache_env, sizeof cache_env, "UNISACC_CACHE_DIR=%s", cache) ||
        cx_fmt(srcp, sizeof srcp, "%s/a.c", work) ||
        cx_fmt(outp, sizeof outp, "%s/out.bin", work)) return fail("paths");
    if (sy_mkdir_all(cache, 0700)) return fail("mkdir work");
    if (spill(srcp, "int main(void){return 0;}\n", 26)) return fail("write source");
    olen = 0;
    put("# Route baseline observed from the installed product. Generated by tools/route-facts.cx -- --baseline --write.\n");
    put("# Method: UNISACC_RR_TIME=1, private empty cache, flags -OL -b TARGET and the mode flag, one-line C source.\n");
    put("# Mode flags: 0 -o FILE, 1 -E, 2 -S -o FILE, 3 -run, 4 -dump-tokens, 5 -c -o FILE.\n");
    put("mode\tlevel\ttarget\tstages\tcont\trc\n");
    for (m = 0; m < NMODE; m++) for (l = 0; l < NLEVEL; l++) for (t = 0; t < NTGT; t++)
        if (base_cell(m, l, t)) return 2;
    return 0;
}

/* ---- compare two tables on every shared column of every key ---- */

typedef struct { char *f[MAXCOL]; int n; } Row;
typedef struct { Row head; Row rows[MAXROW]; int nrows; } Tab;

static char abuf[CAP], bbuf[CAP];
static Tab ta, tb;

static int tab_parse(char *buf, long n, Tab *t) {
    long i = 0;
    int seen_head = 0;
    t->nrows = 0;
    while (i < n) {
        long s = i;
        Row *r;
        while (i < n && buf[i] != '\n') i++;
        if (i >= n) return 1;
        buf[i++] = 0;
        if (buf[s] == '#') continue;
        if (!seen_head) { r = &t->head; seen_head = 1; }
        else { if (t->nrows >= MAXROW) return 1; r = &t->rows[t->nrows++]; }
        r->n = 0;
        r->f[r->n++] = buf + s;
        while (buf[s]) {
            if (buf[s] == '\t') { buf[s] = 0; if (r->n >= MAXCOL) return 1; r->f[r->n++] = buf + s + 1; }
            s++;
        }
    }
    return !seen_head;
}

static int tab_shape(const Tab *t, const char *name) {
    int i;
    if (t->head.n < 4 || strcmp(t->head.f[0], "mode") || strcmp(t->head.f[1], "level") || strcmp(t->head.f[2], "target")) {
        fprintf(stderr, "route-facts\tFAIL\t%s: header must start with mode level target\n", name);
        return 1;
    }
    if (t->nrows != NCELL) {
        fprintf(stderr, "route-facts\tFAIL\t%s: %d rows, want %d\n", name, t->nrows, NCELL);
        return 1;
    }
    for (i = 0; i < t->nrows; i++) if (t->rows[i].n != t->head.n) {
        fprintf(stderr, "route-facts\tFAIL\t%s: row %d has %d fields, want %d\n", name, i + 1, t->rows[i].n, t->head.n);
        return 1;
    }
    return 0;
}

static int same_key(const Row *a, const Row *b) {
    return !strcmp(a->f[0], b->f[0]) && !strcmp(a->f[1], b->f[1]) && !strcmp(a->f[2], b->f[2]);
}

static int compare(const char *pa, const char *pb) {
    long na = slurp(pa, abuf, CAP), nb = slurp(pb, bbuf, CAP);
    int i, j, c, d, cols = 0, bad = 0;
    if (na < 0 || nb < 0) return fail("cannot read a table");
    if (tab_parse(abuf, na, &ta) || tab_parse(bbuf, nb, &tb)) return fail("table shape");
    if (tab_shape(&ta, pa) || tab_shape(&tb, pb)) return 2;
    for (i = 0; i < ta.nrows; i++) for (j = 0; j < i; j++) if (same_key(&ta.rows[i], &ta.rows[j])) return fail("duplicate key in first table");
    for (c = 3; c < ta.head.n; c++) for (d = 3; d < tb.head.n; d++) if (!strcmp(ta.head.f[c], tb.head.f[d])) cols++;
    if (cols < 1) return fail("no shared column");
    for (i = 0; i < ta.nrows; i++) {
        const Row *ra = &ta.rows[i], *rb = 0;
        for (j = 0; j < tb.nrows; j++) if (same_key(ra, &tb.rows[j])) { rb = &tb.rows[j]; break; }
        if (!rb) {
            fprintf(stderr, "route-facts\tFAIL\tkey %s %s %s missing from %s\n", ra->f[0], ra->f[1], ra->f[2], pb);
            return 2;
        }
        for (c = 3; c < ta.head.n; c++) for (d = 3; d < tb.head.n; d++)
            if (!strcmp(ta.head.f[c], tb.head.f[d]) && strcmp(ra->f[c], rb->f[d])) {
                printf("ROUTE_MISMATCH\t%s\t%s\t%s\t%s\t%s\t%s\n", ra->f[0], ra->f[1], ra->f[2], ta.head.f[c], ra->f[c], rb->f[d]);
                bad++;
            }
    }
    printf("ROUTE_COMPARE\tcells=%d\tcols=%d\tmismatch=%d\n", ta.nrows, cols, bad);
    return bad ? 1 : 0;
}

static int emit(const char *path, int write, const char *tag) {
    long n;
    if (write) {
        if (spill(path, obuf, olen)) return fail("cannot write table");
        printf("%s_WRITE\t%s\tbytes=%ld\n", tag, path, olen);
        return 0;
    }
    n = slurp(path, abuf, CAP);
    if (n != olen || memcmp(abuf, obuf, (size_t)olen)) {
        fprintf(stderr, "route-facts\tFAIL\t%s differs from the recomputed table (rerun with --write)\n", path);
        return 1;
    }
    printf("%s_CHECK\t%s\tbytes=%ld\n", tag, path, olen);
    return 0;
}

int main(int argc, char **argv) {
    int base = 0, write = 0, check = 0, i;
    if (argc == 4 && !strcmp(argv[1], "--compare")) return compare(argv[2], argv[3]);
    for (i = 1; i < argc; i++) {
        if (!strcmp(argv[i], "--baseline")) base = 1;
        else if (!strcmp(argv[i], "--write")) write = 1;
        else if (!strcmp(argv[i], "--check")) check = 1;
        else return fail("usage: --write | --check | --baseline --write | --baseline --check | --compare A B");
    }
    if (write == check) return fail("give exactly one of --write and --check");
    if (base) {
        if (base_build()) return 2;
        return emit(BASE, write, "ROUTE_BASELINE");
    }
    draft_build();
    return emit(DRAFT, write, "ROUTE_DRAFT");
}
