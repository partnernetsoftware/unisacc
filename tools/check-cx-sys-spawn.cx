/* Checks cx/sys/proc.cx sy_spawn_pipe/sy_wait_status and cx/mem/bytes.cx:
     sh ./unisacc.com tools/check-cx-sys-spawn.cx
   Real children (sh -c ...): merged and split output, cwd, stdin from /dev/null, exit code and
   signal decoding, NOHANG, a missing program and a missing cwd as -errno; then every mm_* edge.
   Prints PASS/FAIL lines and CX_SYS_SPAWN<TAB>failed=N. */
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.time
#pragma unisa use sys.env
#pragma unisa use sysx.net
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use text.text

static int failed;
static void ck(int ok, const char *name) { if (!ok) failed++; printf("%s\tspawn.%s\n", ok ? "PASS" : "FAIL", name); }

/* read FD to the end into OUT (cap bytes, NUL-terminated); its length */
static long slurp(int fd, char *out, long cap) {
    long n = 0, k;
    while (n < cap - 1 && (k = sy_read(fd, out + n, cap - 1 - n)) > 0) n += k;
    out[n] = 0;
    sy_close(fd);
    return n;
}

int main(void) {
    char buf[256], ebuf[256];
    int pid, ofd = -1, efd = -1, ex = -1, code = -1, sig = -1;

    {   char *v[] = {"sh", "-c", "printf out; printf err >&2; exit 3", 0};
        pid = sy_spawn_pipe(v, 0, 0, &ofd, 0);
        slurp(ofd, buf, sizeof buf);
        ck(pid > 0 && sy_wait_status(pid, 0, &ex, &code, &sig) == pid && ex == 1 && code == 3 && sig == 0
           && (tx_eq(buf, "outerr", 16) || tx_eq(buf, "errout", 16)), "merged-output-exit-3");
    }
    {   char *v[] = {"sh", "-c", "printf out; printf err >&2", 0};
        pid = sy_spawn_pipe(v, 0, SY_SPAWN_STDERR_SPLIT, &ofd, &efd);
        slurp(ofd, buf, sizeof buf); slurp(efd, ebuf, sizeof ebuf);
        ck(pid > 0 && sy_wait_status(pid, 0, &ex, &code, 0) == pid && ex && code == 0
           && tx_eq(buf, "out", 16) && tx_eq(ebuf, "err", 16), "split-output");
    }
    {   char *v[] = {"sh", "-c", "pwd; cat; echo eof", 0};
        pid = sy_spawn_pipe(v, "/tmp", 0, &ofd, 0);
        slurp(ofd, buf, sizeof buf);
        ck(pid > 0 && sy_wait_status(pid, 0, 0, 0, 0) == pid && tx_eq(buf, "/tmp\neof\n", 32), "cwd-and-stdin-devnull");
    }
    {   char *v[] = {"sh", "-c", "kill -9 $$", 0};
        pid = sy_spawn_pipe(v, 0, 0, &ofd, 0);
        slurp(ofd, buf, sizeof buf);
        ck(pid > 0 && sy_wait_status(pid, 0, &ex, &code, &sig) == pid && ex == 0 && sig == 9, "signal-decoded");
    }
    {   char *v[] = {"sh", "-c", "sleep 1", 0};
        pid = sy_spawn_pipe(v, 0, 0, &ofd, 0);
        ck(pid > 0 && sy_wait_status(pid, 1, 0, 0, 0) == 0, "nohang-while-running");
        ck(sy_kill(pid) == 128 + 9, "kill-group");
        sy_close(ofd);
    }
    {   char *v[] = {"no-such-program-cx-spawn", 0};
        ck(sy_spawn_pipe(v, 0, 0, &ofd, 0) == -ENOENT, "missing-program-enoent");
    }
    {   char *v[] = {"/bin/sh", "-c", "true", 0};
        ck(sy_spawn_pipe(v, "/no/such/dir/cx", SY_SPAWN_NO_PATH, &ofd, 0) == -ENOENT, "missing-cwd-enoent");
        ck(sy_spawn_pipe(v, 0, SY_SPAWN_STDERR_SPLIT, &ofd, 0) == -EINVAL, "split-needs-err-fd");
    }

    {   /* sy_open / sy_lseek: write, then read the last byte back through an END-relative seek */
        const char *f = "/tmp/cx-sys-spawn-open.tmp";
        int fd = sy_open(f, O_CREAT | O_WRONLY | O_TRUNC, 0600); char last = 0; long end;
        ck(fd >= 0 && sy_write_all(fd, "line\n", 5) == 0 && sy_close(fd) == 0, "open-create-write");
        fd = sy_open(f, O_RDONLY, 0);
        end = sy_lseek(fd, -1, SEEK_END);
        ck(fd >= 0 && end == 4 && sy_read(fd, &last, 1) == 1 && last == '\n' && sy_lseek(fd, 0, SEEK_CUR) == 5, "lseek-end-and-cur");
        sy_close(fd); sy_unlink(f);
        ck(sy_open("/no/such/dir/cx-open", O_RDONLY, 0) == -ENOENT && sy_lseek(-1, 0, SEEK_SET) == -EBADF, "open-enoent-lseek-ebadf");
    }
    {   /* sy_realpath: a file reached through tools/sys (a link to ../cx/sys) and directly gives one name */
        char a[4096], b[4096], tiny[4]; int na = sy_realpath("tools/sys/fs.cx", a, sizeof a), nb = sy_realpath("cx/sys/fs.cx", b, sizeof b);
        ck(na > 0 && na == nb && tx_eq(a, b, 4096) && a[0] == '/', "realpath-link-and-direct-same");
        ck(sy_realpath("no/such/file.cx", a, sizeof a) == -ENOENT && sy_realpath("cx/sys/fs.cx", tiny, sizeof tiny) == -ENAMETOOLONG, "realpath-enoent-and-too-small");
    }
    {   /* sy_stat_t.kind: a pipe end is 'p', a socket is 's' */
        int pf[2] = {-1, -1}, so = sy_tcp_listen(0, 1); sy_stat_t sp, ss;
        ck(sy_pipe(pf) == 0 && sy_fstat(pf[0], &sp) == 0 && sp.kind == 'p', "kind-fifo-p");
        ck(so >= 0 && sy_fstat(so, &ss) == 0 && ss.kind == 's', "kind-socket-s");
        sy_close(pf[0]); sy_close(pf[1]); if (so >= 0) sy_close(so);
    }
    {   /* sy_chdir: into /tmp and back; an empty or missing path is refused and the cwd stays */
        char home[4096], there[4096], tmp[4096], back[4096];
        int nh = sy_realpath(".", home, sizeof home), nt = sy_realpath("/tmp", tmp, sizeof tmp);
        int in = sy_chdir("/tmp"), nw = sy_realpath(".", there, sizeof there), out = sy_chdir(home);
        ck(nh > 0 && nt > 0 && in == 0 && nw > 0 && tx_eq(there, tmp, 4096) && out == 0, "chdir-into-and-back");
        ck(sy_chdir("") == -EINVAL && sy_chdir("/no/such/dir") == -ENOENT && sy_realpath(".", back, sizeof back) > 0 && tx_eq(back, home, 4096), "chdir-refusals-keep-cwd");
    }
    {   /* sy_stat_t.dev: a hard link shares (dev, ino); another file differs in ino; /proc is another device */
        sy_stat_t s1, s2, s3, sp; const char *f1 = "/tmp/cx-sys-dev-a", *f2 = "/tmp/cx-sys-dev-b", *f3 = "/tmp/cx-sys-dev-c";
        char *v[] = {"sh", "-c", "rm -f /tmp/cx-sys-dev-a /tmp/cx-sys-dev-b /tmp/cx-sys-dev-c; : > /tmp/cx-sys-dev-a; ln /tmp/cx-sys-dev-a /tmp/cx-sys-dev-b; : > /tmp/cx-sys-dev-c", 0};
        pid = sy_spawn_pipe(v, 0, 0, &ofd, 0); slurp(ofd, buf, sizeof buf); sy_wait_status(pid, 0, 0, 0, 0);
        ck(sy_stat(f1, &s1) == 0 && sy_stat(f2, &s2) == 0 && sy_stat(f3, &s3) == 0
           && s1.dev == s2.dev && s1.ino == s2.ino && s1.dev == s3.dev && s1.ino != s3.ino, "dev-ino-hard-link-same");
        ck(sy_stat("/proc/self", &sp) == 0 && sp.dev != s1.dev, "dev-differs-across-mounts");
        sy_unlink(f1); sy_unlink(f2); sy_unlink(f3);
    }
    {   /* sy_setenv reaches a later child; overwrite 0 keeps the old value; bad names refused */
        char *v[] = {"sh", "-c", "printf %s \"$CX_SPAWN_ENV\"", 0};
        ck(sy_setenv("CX_SPAWN_ENV", "one", 1) == 0 && sy_setenv("CX_SPAWN_ENV", "two", 0) == 0, "setenv");
        pid = sy_spawn_pipe(v, 0, 0, &ofd, 0); slurp(ofd, buf, sizeof buf); sy_wait_status(pid, 0, 0, 0, 0);
        ck(tx_eq(buf, "one", 16), "setenv-reaches-child-overwrite-0-keeps");
        ck(sy_setenv("", "x", 1) == -EINVAL && sy_setenv("A=B", "x", 1) == -EINVAL, "setenv-bad-name");
        ck(sy_unsetenv("CX_SPAWN_ENV") == 0 && sy_env("CX_SPAWN_ENV") == 0 && sy_unsetenv("CX_SPAWN_ENV") == 0, "unsetenv-removes-absent-ok");
        pid = sy_spawn_pipe(v, 0, 0, &ofd, 0); slurp(ofd, buf, sizeof buf); sy_wait_status(pid, 0, 0, 0, 0);
        ck(tx_eq(buf, "", 16), "unsetenv-gone-in-child");
        ck(sy_unsetenv("") == -EINVAL && sy_unsetenv("A=B") == -EINVAL && sy_unsetenv(0) == -EINVAL, "unsetenv-bad-name");
    }
    {   char d[8] = "abcdefg"; char big[16]; int i;
        ck(mm_copy(d, 8, "XYZ", 3) == 0 && tx_eq(d, "XYZdefg", 8), "copy");
        ck(mm_copy(d, 2, "XYZ", 3) == -ERANGE && tx_eq(d, "XYZdefg", 8), "copy-over-cap-untouched");
        ck(mm_copy(d, 8, 0, 3) == -EINVAL && mm_copy(d, 8, "x", -1) == -EINVAL && mm_copy(0, 0, 0, 0) == 0, "copy-bad-args");
        ck(mm_move(d + 1, 7, d, 6) == 0 && tx_eq(d, "XXYZdef", 8), "move-overlap");
        ck(mm_fill(d, 8, 0x41 + 256, 7) == 0 && tx_eq(d, "AAAAAAA", 8), "fill-byte-masked");
        ck(mm_fill(d, 3, 'q', 4) == -ERANGE && tx_eq(d, "AAAAAAA", 8), "fill-over-cap-untouched");
        for (i = 0; i < 16; i++) big[i] = (char)i;
        ck(mm_same(big, big, 16) && !mm_same(big, big + 1, 15) && mm_same(0, 0, 0) && !mm_same(big, big, -1), "same");
        ck(mm_cmp("\x01", "\xff", 1) < 0 && mm_cmp("b", "a", 1) > 0 && mm_cmp("ab", "ab", 2) == 0, "cmp-unsigned");
    }
    {   /* mem.heap: libc semantics under mm_* names */
        char *p = mm_alloc(16), *z = mm_zalloc(64), *g, *d; int i, zero = 1;
        for (i = 0; i < 64; i++) if (z && z[i]) zero = 0;
        ck(p != 0 && z != 0 && zero && mm_alloc(0) == 0 && mm_alloc(-1) == 0 && mm_zalloc(0) == 0, "alloc-zalloc");
        if (p) { mm_copy(p, 16, "keep", 5); }
        g = mm_grow(p, 1 << 20);
        ck(g != 0 && tx_eq(g, "keep", 8), "grow-keeps-contents");
        ck(mm_grow(g, 0) == 0 && tx_eq(g, "keep", 8), "grow-to-zero-refused-block-kept");
        d = mm_strdup("dup me");
        ck(d && d != (char *)"dup me" && tx_eq(d, "dup me", 16) && mm_strdup(0) == 0, "strdup");
        { char *fresh = mm_grow(0, 32); ck(fresh != 0, "grow-null-allocates"); mm_free(fresh); }
        mm_free(g); mm_free(z); mm_free(d); mm_free(0);
        ck(1, "free-null-is-noop");
    }
    {   /* sy_spawn_t / sy_proc_*: the one options struct */
        sy_spawn_t o; sy_child_t c; sy_exit_t st; int r;
        char *v1[] = {"sh", "-c", "printf %s \"$CX_ONLY\"; pwd; cat; exit 5", 0};
        char *envv[] = {"CX_ONLY=yes", "PATH=/usr/bin:/bin", 0};
        sy_spawn_init(&o);
        ck(o.argv == 0 && o.env == 0 && o.cwd == 0 && o.in_fd == SY_STDIO_INHERIT && o.out_fd == SY_STDIO_INHERIT
           && o.err_fd == SY_STDIO_INHERIT && o.flags == 0 && o.pgroup == 0 && o.deadline_ms == 0, "init-all-inherit");
        o.argv = v1; o.env = envv; o.cwd = "/tmp"; o.in_fd = SY_STDIO_NULL; o.out_fd = SY_STDIO_PIPE; o.flags = SY_SPAWN_ERR_TO_OUT;
        r = sy_proc_spawn(&o, &c);
        ck(r == 0 && c.pid > 0 && c.out_fd >= 0 && c.in_fd == -1 && c.err_fd == -1, "proc-spawn-pipe-fields");
        slurp(c.out_fd, buf, sizeof buf); c.out_fd = -1;
        ck(sy_proc_wait(&c, &st) == 0 && st.exited && st.code == 5 && sy_exit_code(&st) == 5 && tx_eq(buf, "yes/tmp\n", 32), "env-cwd-stdin-null-exit5");
        sy_proc_close(&c);
        {   char *v[] = {"cat", 0}; char got[32]; sy_spawn_init(&o); o.argv = v; o.in_fd = SY_STDIO_PIPE; o.out_fd = SY_STDIO_PIPE; o.pgroup = -1;
            r = sy_proc_spawn(&o, &c);
            ck(r == 0 && c.in_fd >= 0 && c.out_fd >= 0 && sy_write_all(c.in_fd, "ping", 4) == 0, "stdin-pipe-write");
            sy_close(c.in_fd); c.in_fd = -1;
            slurp(c.out_fd, got, sizeof got); c.out_fd = -1;
            ck(tx_eq(got, "ping", 8) && sy_proc_wait(&c, &st) == 0 && st.exited && st.code == 0, "stdin-pipe-echo-wait");
            ck(sy_proc_wait(&c, &st) < 0, "wait-twice-errno");
        }
        {   char *v[] = {"sh", "-c", "sleep 30", 0}; long t0 = sy_now_ms(), dt;
            sy_spawn_init(&o); o.argv = v; o.pgroup = -1; o.deadline_ms = 200;
            r = sy_proc_spawn(&o, &c);
            ck(r == 0 && sy_proc_try_wait(&c, &st) == 0, "try-wait-running");
            ck(sy_proc_wait(&c, &st) == 0, "deadline-wait-returns");
            dt = sy_now_ms() - t0;
            ck(st.timed_out == 1 && st.sig == 9 && sy_exit_code(&st) == 124 && dt >= 150 && dt < 5000, "deadline-kills-timed-out-124");
        }
        {   char *v[] = {"sh", "-c", "sleep 30", 0};
            sy_spawn_init(&o); o.argv = v; o.pgroup = -1;
            r = sy_proc_spawn(&o, &c);
            ck(r == 0 && sy_proc_kill(&c, SIGTERM) == 0 && sy_proc_wait(&c, &st) == 0 && st.exited == 0 && st.sig == 15 && sy_exit_code(&st) == 143 && st.timed_out == 0, "kill-term-group-128-plus-sig");
            ck(sy_proc_kill(&c, SIGTERM) == -ESRCH, "kill-after-reap-esrch");
        }
        {   char *v[] = {"sh", "-c", "exit 7", 0}; int k = 0;
            sy_spawn_init(&o); o.argv = v; o.out_fd = SY_STDIO_NULL;
            ck(sy_proc_run(&o, &st) == 0 && st.exited && st.code == 7, "run-exit-7");
            r = sy_proc_spawn(&o, &c);
            while (r == 0 && sy_proc_try_wait(&c, &st) == 0 && k++ < 500) sy_sleep_ms(5);
            ck(r == 0 && st.exited && st.code == 7, "try-wait-reaps");
        }
        {   char *vn[] = {"no-such-program-cx-spawn", 0}; char *ve[] = {0}; char *vt[] = {"true", 0};
            sy_spawn_init(&o); o.argv = vn;
            ck(sy_proc_spawn(&o, &c) == -ENOENT && sy_proc_run(&o, &st) == -ENOENT, "missing-program-enoent-new");
            o.argv = vn; o.env = envv;
            ck(sy_proc_spawn(&o, &c) == -ENOENT, "missing-program-enoent-with-env");
            o.argv = ve; o.env = 0;
            ck(sy_proc_spawn(&o, &c) == -EINVAL && sy_proc_spawn(0, &c) == -EINVAL, "empty-argv-einval");
            o.argv = vt; o.out_fd = SY_STDIO_PIPE;
            ck(sy_proc_run(&o, &st) == -EINVAL, "run-refuses-pipe");
            o.out_fd = SY_STDIO_INHERIT; o.cwd = "/no/such/dir/cx";
            ck(sy_proc_spawn(&o, &c) == -ENOENT, "missing-cwd-enoent-new");
            ck(sy_proc_wait(0, &st) == -EINVAL && sy_proc_kill(0, 9) == -EINVAL && sy_proc_close(0) == -EINVAL, "null-args-einval");
        }
        ck(sy_exit_decode(0x0300, &st) == 0 && st.exited && st.code == 3 && st.raw == 0x0300, "decode-exit");
        ck(sy_exit_decode(9, &st) == 0 && !st.exited && st.sig == 9 && sy_exit_code(&st) == 137, "decode-signal");
        ck(sy_exit_decode(0x7f, &st) == -EINVAL && sy_exit_decode(0, 0) == -EINVAL && sy_exit_code(0) == -EINVAL, "decode-refusals");
        ck(sy_ppid() > 0 && sy_ppid() != sy_pid(), "ppid");
    }
    {   /* sy_deadline_t on the monotonic clock */
        sy_deadline_t n = sy_deadline_never(), p = sy_deadline_in(0), f = sy_deadline_in(300), g = sy_deadline_in(100), m; long w = 0, l;
        sy_deadline_t arr[3]; int64_t t0 = sy_mono_ns(), t1;
        ck(t0 > 0 && (t1 = sy_mono_ns()) >= t0, "mono-ns-monotonic");
        ck(n.at_ns == 0 && sy_deadline_left(&n) == -1 && !sy_deadline_passed(&n) && sy_deadline_left(0) == -1, "never");
        l = sy_deadline_left(&f);
        ck(sy_deadline_passed(&p) && sy_deadline_left(&p) == 0 && !sy_deadline_passed(&f) && l > 0 && l <= 300, "in-and-left");
        ck(sy_deadline_in(-5).at_ns > 0 && sy_deadline_passed(&p), "in-nonpositive-expired");
        m = sy_deadline_min(&f, &g); ck(m.at_ns == g.at_ns, "min-earlier");
        m = sy_deadline_min(&n, &f); ck(m.at_ns == f.at_ns, "min-never-yields");
        m = sy_deadline_min(&n, &n); ck(m.at_ns == 0, "min-both-never");
        arr[0] = n; arr[1] = f; arr[2] = g;
        ck(sy_timer_next(arr, 3, &w) == 2 && w > 0 && w <= 100, "timer-next-index");
        arr[2] = n; ck(sy_timer_next(arr, 3, &w) == 1, "timer-next-skips-never");
        arr[1] = n; ck(sy_timer_next(arr, 3, &w) == -1 && w == -1 && sy_timer_next(arr, 0, &w) == -1, "timer-next-none");
        ck(sy_timer_next(arr, 3, 0) == -EINVAL && sy_timer_next(0, 2, &w) == -EINVAL && sy_timer_next(arr, -1, &w) == -EINVAL, "timer-next-einval");
        {   sy_deadline_t s = sy_deadline_in(60); int64_t a = sy_mono_ns(), b;
            ck(sy_sleep_until(&s) == 0, "sleep-until-ok"); b = sy_mono_ns();
            ck(b - a >= 50 * 1000000LL && sy_deadline_passed(&s), "sleep-until-waited");
            ck(sy_sleep_until(&n) == -EINVAL && sy_sleep_until(0) == -EINVAL && sy_sleep_until(&p) == 0, "sleep-until-refusals");
        }
    }
    printf("CX_SYS_SPAWN\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
