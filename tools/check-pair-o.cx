/* tools/check-pair-o.cx -- fixture tests for tools/pair-o.cx (fake ape shell, no product).
 *
 * Covers: usage refuse, SAME, DIFF, REFUSE_SAME, UNMEASURED (bound timeout), list summary.
 * Ends with CHECK_PAIR_O. */
#pragma unisa use cxlib.procrun
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use sys.posix
#pragma unisa use text.text
#pragma unisa use mem.heap

static int failed;

static void ck(int ok, const char *n) {
    printf("%s\tcheck-pair-o.%s\n", ok ? "PASS" : "FAIL", n);
    if (!ok) failed++;
}

static void die(const char *s) { fprintf(stderr, "check-pair-o: %s\n", s); exit(2); }

static int has(const pr_result *r, const char *needle) {
    long i, nn, rn;
    if (!r || !r->out || !needle) return 0;
    nn = tx_len(needle, 200); rn = (long)r->outn;
    if (nn <= 0 || rn < nn) return 0;
    for (i = 0; i + nn <= rn; i++) {
        long k = 0;
        while (k < nn && r->out[i + k] == needle[k]) k++;
        if (k == nn) return 1;
    }
    return 0;
}

static int has_err(const pr_result *r, const char *needle) {
    long i, nn, rn;
    if (!r || !r->err || !needle) return 0;
    nn = tx_len(needle, 200); rn = (long)r->errn;
    if (nn <= 0 || rn < nn) return 0;
    for (i = 0; i + nn <= rn; i++) {
        long k = 0;
        while (k < nn && r->err[i + k] == needle[k]) k++;
        if (k == nn) return 1;
    }
    return 0;
}

int main(void) {
    pr_result r;
    char root[900], com[900], tool[900], ape[900], src[900], od[900], list[900];
    char *av[32];
    int t;
    static const char ape_body[] =
        "OUT=\nFILE=\nMODELS=-\n"
        "while [ $# -gt 0 ]; do\n"
        "  case \"$1\" in\n"
        "    --models) MODELS=$2; shift 2 ;;\n"
        "    -o) OUT=$2; shift 2 ;;\n"
        "    *) FILE=$1; shift ;;\n"
        "  esac\n"
        "done\n"
        "case \"$MODELS\" in\n"
        "  *sleep*) sleep 5; echo x >\"$OUT\"; exit 0 ;;\n"
        "  *fail*) echo refuse >&2; exit 2 ;;\n"
        "  *left*) echo left-body >\"$OUT\"; exit 0 ;;\n"
        "  *right*) echo right-body >\"$OUT\"; exit 0 ;;\n"
        "  *) echo same-body >\"$OUT\"; exit 0 ;;\n"
        "esac\n";

    if (cx_fmt(root, sizeof root, "%s/check-pair-o-%d", sy_tmpdir(), sy_pid())) die("root");
    if (sy_exists(root) == 1) sy_remove_all(root);
    if (sy_mkdir_all(root, 0700)) die("mkdir");
    {
        char cwd[800];
        if (sy_realpath(".", cwd, sizeof cwd) < 0) die("cwd");
        if (cx_fmt(tool, sizeof tool, "%s/tools/pair-o.cx", cwd)) die("tool");
        if (cx_fmt(com, sizeof com, "%s/unisacc.com", cwd)) die("com");
    }
    if (cx_fmt(ape, sizeof ape, "%s/fake-ape.sh", root) ||
        cx_fmt(src, sizeof src, "%s/t.cx", root) ||
        cx_fmt(od, sizeof od, "%s/out", root) ||
        cx_fmt(list, sizeof list, "%s/list.txt", root)) die("paths");
    if (sy_write_file(ape, ape_body, (int64_t)(sizeof ape_body - 1), 0600)) die("ape");
    if (sy_write_file(src, "int main(void){return 0;}\n", 25, 0600)) die("src");
    if (sy_write_file(list, "a.cx\nb.cx\n", 10, 0600)) die("list");
    /* touch list files as empty sources under root */
    {
        char a[900], b[900];
        if (cx_fmt(a, sizeof a, "%s/a.cx", root) || cx_fmt(b, sizeof b, "%s/b.cx", root)) die("ab");
        if (sy_write_file(a, "x\n", 2, 0600) || sy_write_file(b, "y\n", 2, 0600)) die("abw");
        /* list paths relative: rewrite list with absolute */
        {
            char body[2000];
            if (cx_fmt(body, sizeof body, "%s\n%s\n", a, b)) die("listb");
            if (sy_write_file(list, body, (int64_t)tx_len(body, sizeof body), 0600)) die("listw");
        }
    }

    /* usage refuse */
    {
        char *u[] = {"sh", com, tool, "--", "--file", src, 0};
        t = pr_run("pair-o-usage", u, 0, 0, 40, &r);
        ck(t == 0 && r.rc == 2 && has_err(&r, "PAIR_O_ERROR"), "usage-refuse");
        pr_free(&r);
    }

    /* SAME */
    {
        char *u[] = {"sh", com, tool, "--",
            "--ape", ape, "--orig", "same-a", "--patched", "same-b",
            "--file", src, "--outdir", od, "--bound", "20", 0};
        t = pr_run("pair-o-same", u, 0, 0, 45, &r);
        ck(t == 0 && r.rc == 0 && has(&r, "ORACLE\tSAME\t"), "same");
        pr_free(&r);
    }

    /* DIFF */
    {
        char od2[900];
        if (cx_fmt(od2, sizeof od2, "%s/out-diff", root)) die("od2");
        {
            char *u[] = {"sh", com, tool, "--",
                "--ape", ape, "--orig", "left-pack", "--patched", "right-pack",
                "--file", src, "--outdir", od2, "--bound", "20", 0};
            t = pr_run("pair-o-diff", u, 0, 0, 45, &r);
            ck(t == 0 && r.rc == 1 && has(&r, "ORACLE\tDIFF\t"), "diff");
            pr_free(&r);
        }
    }

    /* REFUSE_SAME */
    {
        char od3[900];
        if (cx_fmt(od3, sizeof od3, "%s/out-refuse", root)) die("od3");
        {
            char *u[] = {"sh", com, tool, "--",
                "--ape", ape, "--orig", "fail-a", "--patched", "fail-b",
                "--file", src, "--outdir", od3, "--bound", "20", 0};
            t = pr_run("pair-o-refuse", u, 0, 0, 45, &r);
            ck(t == 0 && r.rc == 0 && has(&r, "ORACLE\tREFUSE_SAME\t"), "refuse-same");
            pr_free(&r);
        }
    }

    /* UNMEASURED via bound timeout */
    {
        char od4[900];
        if (cx_fmt(od4, sizeof od4, "%s/out-um", root)) die("od4");
        {
            char *u[] = {"sh", com, tool, "--",
                "--ape", ape, "--orig", "sleep-a", "--patched", "sleep-b",
                "--file", src, "--outdir", od4, "--bound", "1", 0};
            t = pr_run("pair-o-um", u, 0, 0, 20, &r);
            ck(t == 0 && r.rc == 3 && has(&r, "ORACLE\tUNMEASURED\t"), "unmeasured-timeout");
            pr_free(&r);
        }
    }

    /* list summary: two SAME */
    {
        char od5[900];
        if (cx_fmt(od5, sizeof od5, "%s/out-list", root)) die("od5");
        {
            char *u[] = {"sh", com, tool, "--",
                "--ape", ape, "--orig", "same-a", "--patched", "same-b",
                "--list", list, "--start", "0", "--count", "2",
                "--outdir", od5, "--bound", "20", "--jobs", "2", 0};
            t = pr_run("pair-o-list", u, 0, 0, 50, &r);
            ck(t == 0 && r.rc == 0 && has(&r, "ORACLE_SUMMARY\t") &&
               has(&r, "same=2") && has(&r, "PAIR_O_JOBS\t"), "list-summary");
            pr_free(&r);
        }
    }

    sy_remove_all(root);
    printf("CHECK_PAIR_O\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
