/* cap-gen: build/std-surface.tsv -> cx/sys/capgen.cx (the data table behind sy_cap).
 *   sh ./unisacc.com tools/cap-gen.cx -- --write|--check|--facts [ROOT]
 * Rule (prd_cx.md 0.7 C5): sy_cap(X) is 1 on a target iff no row with `cap=X` has a `refuse...` cell in
 * that target's column (lnx/osx/win = columns 6..8).  Values come only from the table scan.
 * --facts prints "cap<TAB>lnx<TAB>osx<TAB>win" refuse-row counts.  --check: 1 on byte drift, 2 on refusal.
 * CG_UNVERIFIED lists caps whose table cells contradict the implementation (reported, never edited here). */
#pragma unisa use sys.fs
#pragma unisa use mem.bytes
#pragma unisa use cxlib.netpack
#define MAXC 32
static const char *CG_UNVERIFIED[] = {"memfd-exec", 0};
static char *names[MAXC];
static int cnt[MAXC][3], nc;
static void die(const char *s) { fprintf(stderr, "cap-gen: REFUSE %s\n", s); exit(2); }
static int cap_ok(const char *s) {
    if (!*s) return 0;
    for (; *s; s++) if (!strchr("abcdefghijklmnopqrstuvwxyz0123456789-", *s)) return 0;
    return 1;
}
static int cap_index(const char *name) {
    for (int i = 0; i < nc; i++) if (!strcmp(names[i], name)) return i;
    if (nc == MAXC) die("cap bound");
    names[nc] = (char *)name; return nc++;
}
static int unverified(const char *n) {
    for (int i = 0; CG_UNVERIFIED[i]; i++) if (!strcmp(CG_UNVERIFIED[i], n)) return 1;
    return 0;
}
static void upper(char *d, const char *s) {
    for (; *s; s++) *d++ = *s == '-' ? '_' : (*s >= 'a' && *s <= 'z' ? *s - 32 : *s);
    *d = 0;
}
int main(int argc, char **argv) {
    if (argc < 2 || argc > 3 || (strcmp(argv[1], "--write") && strcmp(argv[1], "--check") && strcmp(argv[1], "--facts"))) {
        fprintf(stderr, "cap-gen: usage --write|--check|--facts [ROOT]\n");
        return 2;
    }
    const char *root = argc == 3 ? argv[2] : ".";
    char src[2600], dst[2600];
    if (cx_fmt(src, sizeof src, "%s/build/std-surface.tsv", root) || cx_fmt(dst, sizeof dst, "%s/cx/sys/capgen.cx", root)) die("path bound");
    size_t n; char *s = cx_read(src, &n);
    if (!s || !n || n > 4000000 || s[n - 1] != '\n' || memchr(s, 0, n) || memchr(s, '\r', n)) die("table text");
    int rows = 0;
    for (char *p = s; *p; ) {
        char *e = strchr(p, '\n'); *e = 0;
        if (*p && *p != '#') {
            char *f[14]; int k = 0; f[k++] = p;
            for (char *q = p; *q; q++) if (*q == '\t') { *q = 0; if (k == 14) die("columns"); f[k++] = q + 1; }
            if (k != 14) die("columns");
            rows++;
            for (int t = 0; t < 3; t++) {
                char *c = f[5 + t];
                if (strncmp(c, "refuse", 6)) continue;
                char *m = strstr(c, "cap=");
                if (!m) continue;   /* refused without a cap word: not a capability row */
                m += 4;
                char *end = m; while (*end && *end != ' ') end++;
                char save = *end; *end = 0;
                if (!cap_ok(m)) die("cap token");
                char *own = strdup(m);
                *end = save;
                int i = cap_index(own);
                if (names[i] != own) free(own);
                cnt[i][t]++;
            }
        }
        p = e + 1;
    }
    if (!nc || !rows) die("no cap rows");
    if (!strcmp(argv[1], "--facts")) {
        for (int i = 0; i < nc; i++) printf("%s\t%d\t%d\t%d%s\n", names[i], cnt[i][0], cnt[i][1], cnt[i][2], unverified(names[i]) ? "\tUNVERIFIED" : "");
        return 0;
    }
    np_buf b = {0};
    char line[512], up[64];
    np_puts(&b, "#pragma unisa module capgen\n#pragma unisa dock\n");
    np_puts(&b, "/* Generated by tools/cap-gen.cx --write from build/std-surface.tsv; do not edit by hand.\n"
            "   Entry = 1 iff no row with that cap is refused in the target column (lnx, osx, win). */\n");
    np_puts(&b, "enum {\n");
    for (int i = 0; i < nc; i++) { upper(up, names[i]); cx_fmt(line, sizeof line, "    SY_CAP_%s = %d,\n", up, i); np_puts(&b, line); }
    cx_fmt(line, sizeof line, "    SY_CAP_COUNT = %d\n};\n", nc); np_puts(&b, line);
    np_puts(&b, "static const char *const sy_cap_names[SY_CAP_COUNT] = {\n");
    for (int i = 0; i < nc; i++) { cx_fmt(line, sizeof line, "    \"%s\",\n", names[i]); np_puts(&b, line); }
    np_puts(&b, "};\nstatic const unsigned char sy_cap_tab[SY_CAP_COUNT][3] = {\n");
    for (int i = 0; i < nc; i++) {
        cx_fmt(line, sizeof line, "    {%d, %d, %d},   /* %s: refused rows lnx=%d osx=%d win=%d%s */\n",
               !cnt[i][0], !cnt[i][1], !cnt[i][2], names[i], cnt[i][0], cnt[i][1], cnt[i][2], unverified(names[i]) ? " UNVERIFIED" : "");
        np_puts(&b, line);
    }
    np_puts(&b, "};\n");
    int check = !strcmp(argv[1], "--check");
    if (check) {
        size_t z; char *old = cx_read(dst, &z);
        int same = old && z == b.n && !memcmp(old, b.p, z);
        free(old);
        if (!same) { fprintf(stderr, "cap-gen: DIFF\n"); return 1; }
    } else if (cx_write(dst, b.p, b.n)) die("write table");
    printf("CAP_GEN\tstatus=%s\tcaps=%d\trows=%d\n", check ? "CHECK" : "WRITE", nc, rows);
    return 0;
}
