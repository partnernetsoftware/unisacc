/* tools/formats-macho-pe.cx -- formats matrix Mach-O / PE structure cells (tests/formats-domain-matrix.tsv):
 *   macho.{x86_64,arm64}.load-commands, macho.{x86_64,arm64}.codesign,
 *   pe.{x86_64,arm64}.sections, pe.{x86_64,arm64}.imports-reloc-loadconfig
 *   sh ./unisacc.com tools/formats-macho-pe.cx -- ROOT ABS_OUT
 * Two inline fixtures (a bare `return 7` and a data + printf program) are compiled by the installed product at -O2 for
 * osx/x86_64, osx/arm64, win/x86_64, win/arm64 (8 images). Every oracle below is written from the published layouts
 * (Mach-O loader.h / codesign.h, PE/COFF specification), never from product output:
 *  Mach-O: MH_MAGIC_64, MH_EXECUTE; LC_SEGMENT_64 __PAGEZERO (vmaddr 0, no file bytes, prot 0), __TEXT r-x, a separate
 *   rw __DATA, __LINKEDIT r--; segment file extents inside the file and pairwise disjoint; load commands end before the
 *   __text section's file offset (header slack measured); LC_LOAD_DYLINKER, LC_LOAD_DYLIB, LC_MAIN present; MH_PIE set;
 *   LC_SYMTAB with zero symbols and an 8-byte all-NUL string table inside __LINKEDIT; LC_DYSYMTAB all zero; LC_DYLD_INFO
 *   with rebase/weak/lazy/export empty and bind info inside __LINKEDIT; no LC_UUID.
 *  Mach-O codesign: LC_CODE_SIGNATURE inside __LINKEDIT; big-endian SuperBlob 0xfade0cc0 with one CodeDirectory blob
 *   (0xfade0c02, version 0x20400, flags adhoc 0x2, hashType SHA-256, hashSize 32, pageSize 2^12, nSpecialSlots 0,
 *   codeLimit == signature offset); every page hash recomputed with cx_sha256 over the file equals the stored slot.
 *  PE: MZ + PE32+ (0x20b), machine x86_64/arm64, TimeDateStamp 0, SectionAlignment 4096, FileAlignment 512,
 *   MajorSubsystemVersion declared (>= 4), sections .text/.rdata/.data/.reloc with RVAs multiples of SectionAlignment,
 *   raw offsets/sizes multiples of FileAlignment, raw extents inside the file and disjoint, virtual extents disjoint and
 *   ascending, entry point inside .text, SizeOfImage covering the last section.
 *  PE imports/reloc/loadconfig: import directory inside .rdata, one descriptor naming KERNEL32.dll, INT and IAT thunks
 *   mirror each other and end with 0, every hint/name inside .rdata and NUL-terminated, IAT directory equals the
 *   descriptor's FirstThunk with size (n+1)*8; .reloc holds blocks of DIR64 entries whose targets are inside the image,
 *   sorted and without duplicates, grouped by page; load-config directory (size 320) inside .rdata with its
 *   SecurityCookie pointing into .data, and the single relocation targets exactly that cookie field.
 * Controls: each oracle is also run on a privately mutated copy (one byte of a page flipped; a section RVA misaligned)
 * and must report its named refusal, so a vacuous oracle cannot pass. Outer bound 55 s; each child <= 12 s. */
#pragma unisa use cxlib.netpack
#pragma unisa use text.text

static char root[4096], outdir[4096], bound[4400], product[4400];
static FILE *res; static int npass, nfail, nnotrun;
static void die(const char *s) { fprintf(stderr, "formats-macho-pe: REFUSE %s errno=%d\n", s, errno); exit(2); }
static void path(char *p, size_t cap, const char *a, const char *b) { int n = snprintf(p, cap, "%s/%s", a, b); if (n < 0 || (size_t)n >= cap) die("path"); }
static void saved(const char *p, const char *s, size_t n) { int f = open(p, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600); if (f < 0) die("exclusive create"); while (n) { ssize_t k = write(f, s, n); if (k <= 0) die("write"); s += k; n -= (size_t)k; } if (close(f)) die("close"); }
static void row(const char *state, const char *cell, const char *label, const char *detail) { fprintf(res, "%s\t%s\t%s\t%s\n", state, cell, label, detail); if (tx_eq(state, "PASS", 1L << 20)) npass++; else if (tx_eq(state, "FAIL", 1L << 20)) nfail++; else nnotrun++; }
static void check(int ok, const char *cell, const char *label, const char *detail) { row(ok ? "PASS" : "FAIL", cell, label, detail); }
static unsigned long long get(const unsigned char *p, int n) { unsigned long long v = 0; for (int i = n - 1; i >= 0; i--) v = (v << 8) | p[i]; return v; }
static unsigned long long getbe(const unsigned char *p, int n) { unsigned long long v = 0; for (int i = 0; i < n; i++) v = (v << 8) | p[i]; return v; }
static int span(size_t n, unsigned long long at, unsigned long long len) { return at <= n && len <= n - at; }
static int disjoint(unsigned long long a0, unsigned long long a1, unsigned long long b0, unsigned long long b1) { return a1 <= b0 || b1 <= a0; }

/* ---- Mach-O ---- */
typedef struct { unsigned long long vmaddr, vmsize, fileoff, filesize; int initprot, nsects; char name[17]; } Seg;
typedef struct { Seg seg[8]; int nseg; int has_dylinker, has_dylib, has_main, has_uuid, pie; unsigned long long textsect_off, cmds_end; unsigned long long symoff, nsyms, stroff, strsize; int dysym_zero; unsigned long long bind_off, bind_size, other_dyld; unsigned long long sigoff, siglen; const char *why; } Macho;
static int seg_find(const Macho *m, const char *name) { for (int i = 0; i < m->nseg; i++) if (tx_eq(m->seg[i].name, name, 1L << 20)) return i; return -1; }
static const char *macho_parse(const unsigned char *p, size_t n, int arm, Macho *m) {
    memset(m, 0, sizeof *m); m->dysym_zero = 1;
    if (n < 32 || get(p, 4) != 0xfeedfacfULL || get(p + 4, 4) != (arm ? 0x100000cULL : 0x1000007ULL) || get(p + 12, 4) != 2) return "macho-header";
    unsigned long long count = get(p + 16, 4), size = get(p + 20, 4), at = 32, flags = get(p + 24, 4); m->pie = (flags & 0x200000) != 0;
    if (!count || !span(n, 32, size)) return "macho-bounds";
    for (unsigned long long i = 0; i < count; i++) { if (at + 8 > 32 + size) return "macho-bounds"; unsigned long long cmd = get(p + at, 4), len = get(p + at + 4, 4); if (len < 8 || len > 32 + size - at) return "macho-bounds";
        if (cmd == 0x19) { if (len < 72 || m->nseg >= 8) return "macho-segment"; Seg *s = &m->seg[m->nseg++]; memcpy(s->name, p + at + 8, 16); s->name[16] = 0; s->vmaddr = get(p + at + 24, 8); s->vmsize = get(p + at + 32, 8); s->fileoff = get(p + at + 40, 8); s->filesize = get(p + at + 48, 8); s->initprot = (int)get(p + at + 60, 4); s->nsects = (int)get(p + at + 64, 4);
            if (len != 72 + 80ULL * s->nsects) return "macho-segment"; for (int k = 0; k < s->nsects; k++) { const unsigned char *q = p + at + 72 + 80 * k; if (!memcmp(q, "__text", 7)) m->textsect_off = get(q + 48, 4); } }
        else if (cmd == 0xe) m->has_dylinker = 1; else if (cmd == 0xc) m->has_dylib = 1; else if (cmd == 0x80000028) m->has_main = 1; else if (cmd == 0x1b) m->has_uuid = 1;
        else if (cmd == 0x2) { if (len != 24) return "macho-symtab"; m->symoff = get(p + at + 8, 4); m->nsyms = get(p + at + 12, 4); m->stroff = get(p + at + 16, 4); m->strsize = get(p + at + 20, 4); }
        else if (cmd == 0xb) { if (len != 80) return "macho-dysymtab"; for (int k = 8; k < 80; k++) if (p[at + k]) m->dysym_zero = 0; }
        else if (cmd == 0x80000022 || cmd == 0x22) { if (len != 48) return "macho-dyldinfo"; m->other_dyld = get(p + at + 8, 4) | get(p + at + 12, 4) | get(p + at + 24, 4) | get(p + at + 28, 4) | get(p + at + 32, 4) | get(p + at + 36, 4) | get(p + at + 40, 4) | get(p + at + 44, 4); m->bind_off = get(p + at + 16, 4); m->bind_size = get(p + at + 20, 4); }
        else if (cmd == 0x1d) { if (len != 16) return "macho-codesig"; m->sigoff = get(p + at + 8, 4); m->siglen = get(p + at + 12, 4); }
        at += len; }
    m->cmds_end = at; return 0;
}
static void macho_cells(const unsigned char *p, size_t n, int arm, const char *fx) {
    const char *cell = arm ? "macho.arm64.load-commands" : "macho.x86_64.load-commands", *cs = arm ? "macho.arm64.codesign" : "macho.x86_64.codesign"; Macho m; char lab[200], d[300];
    const char *why = macho_parse(p, n, arm, &m); { if (cx_fmt(lab, sizeof lab, "%s.parse", fx)) { fprintf(stderr, "formats-macho-pe: text too long for lab\n"); exit(2); } } if (why) { row("FAIL", cell, lab, why); return; }
    int pz = seg_find(&m, "__PAGEZERO"), tx = seg_find(&m, "__TEXT"), da = seg_find(&m, "__DATA"), le = seg_find(&m, "__LINKEDIT");
    { if (cx_fmt(lab, sizeof lab, "%s.four-segments", fx)) { fprintf(stderr, "formats-macho-pe: text too long for lab\n"); exit(2); } } check(pz >= 0 && tx >= 0 && da >= 0 && le >= 0 && m.nseg == 4, cell, lab, "__PAGEZERO __TEXT __DATA __LINKEDIT");
    if (pz < 0 || tx < 0 || da < 0 || le < 0) return;
    const Seg *P = &m.seg[pz], *T = &m.seg[tx], *D = &m.seg[da], *L = &m.seg[le];
    { if (cx_fmt(lab, sizeof lab, "%s.pagezero", fx)) { fprintf(stderr, "formats-macho-pe: text too long for lab\n"); exit(2); } } check(P->vmaddr == 0 && P->filesize == 0 && P->initprot == 0 && P->vmsize >= 0x100000000ULL, cell, lab, "vmaddr 0, no file bytes, prot 0, >= 4 GiB");
    { if (cx_fmt(lab, sizeof lab, "%s.text-rx-data-rw-linkedit-r", fx)) { fprintf(stderr, "formats-macho-pe: text too long for lab\n"); exit(2); } } check(T->initprot == 5 && D->initprot == 3 && L->initprot == 1 && T->fileoff == 0, cell, lab, "prots 5/3/1, __TEXT at file 0");
    int inb = span(n, T->fileoff, T->filesize) && span(n, D->fileoff, D->filesize) && span(n, L->fileoff, L->filesize);
    int dj = disjoint(T->fileoff, T->fileoff + T->filesize, D->fileoff, D->fileoff + D->filesize) && disjoint(D->fileoff, D->fileoff + D->filesize, L->fileoff, L->fileoff + L->filesize) && disjoint(T->fileoff, T->fileoff + T->filesize, L->fileoff, L->fileoff + L->filesize);
    int vdj = disjoint(T->vmaddr, T->vmaddr + T->vmsize, D->vmaddr, D->vmaddr + D->vmsize) && D->vmaddr >= T->vmaddr + T->vmsize && L->vmaddr >= D->vmaddr + D->vmsize;
    { if (cx_fmt(lab, sizeof lab, "%s.segment-extents", fx)) { fprintf(stderr, "formats-macho-pe: text too long for lab\n"); exit(2); } } check(inb && dj && vdj && D->fileoff == T->fileoff + T->filesize && L->fileoff == D->fileoff + D->filesize, cell, lab, "file extents in bounds, contiguous, disjoint; vm ascending");
    { if (cx_fmt(lab, sizeof lab, "%s.commands-before-text", fx)) { fprintf(stderr, "formats-macho-pe: text too long for lab\n"); exit(2); } } { if (cx_fmt(d, sizeof d, "slack %llu bytes between the last command and __text", m.textsect_off - m.cmds_end)) { fprintf(stderr, "formats-macho-pe: text too long for d\n"); exit(2); } } check(m.textsect_off && m.cmds_end <= m.textsect_off, cell, lab, d);
    { if (cx_fmt(lab, sizeof lab, "%s.dylinker-dylib-main-pie", fx)) { fprintf(stderr, "formats-macho-pe: text too long for lab\n"); exit(2); } } check(m.has_dylinker && m.has_dylib && m.has_main && m.pie && !m.has_uuid, cell, lab, "LC_LOAD_DYLINKER, LC_LOAD_DYLIB, LC_MAIN, MH_PIE, no LC_UUID");
    int strtab_ok = m.nsyms == 0 && m.strsize == 8 && span(n, m.stroff, 8) && m.stroff >= L->fileoff && m.stroff + 8 <= L->fileoff + L->filesize; for (int k = 0; strtab_ok && k < 8; k++) if (p[m.stroff + k]) strtab_ok = 0;
    { if (cx_fmt(lab, sizeof lab, "%s.symtab-dysymtab-dyldinfo", fx)) { fprintf(stderr, "formats-macho-pe: text too long for lab\n"); exit(2); } } check(strtab_ok && m.dysym_zero && m.other_dyld == 0 && m.bind_off >= L->fileoff && m.bind_off + m.bind_size <= L->fileoff + L->filesize, cell, lab, "0 symbols, 8-NUL strtab in __LINKEDIT, zero dysymtab, only bind info");
    /* codesign */
    { if (cx_fmt(lab, sizeof lab, "%s.signature-in-linkedit", fx)) { fprintf(stderr, "formats-macho-pe: text too long for lab\n"); exit(2); } } int sig_in = m.sigoff && span(n, m.sigoff, m.siglen) && m.sigoff >= L->fileoff && m.sigoff + m.siglen <= L->fileoff + L->filesize; check(sig_in, cs, lab, "LC_CODE_SIGNATURE extent inside __LINKEDIT");
    if (!sig_in) return;
    const unsigned char *sb = p + m.sigoff; int sb_ok = m.siglen >= 20 && getbe(sb, 4) == 0xfade0cc0ULL && getbe(sb + 4, 4) == m.siglen && getbe(sb + 8, 4) == 1 && getbe(sb + 12, 4) == 0 && getbe(sb + 16, 4) == 20;
    { if (cx_fmt(lab, sizeof lab, "%s.superblob", fx)) { fprintf(stderr, "formats-macho-pe: text too long for lab\n"); exit(2); } } check(sb_ok, cs, lab, "0xfade0cc0, one blob of type 0 at 20");
    if (!sb_ok || m.siglen < 20 + 88) return;
    const unsigned char *cd = sb + 20; unsigned long long cdlen = getbe(cd + 4, 4), hashoff = getbe(cd + 16, 4), identoff = getbe(cd + 20, 4), nspecial = getbe(cd + 24, 4), ncode = getbe(cd + 28, 4), limit = getbe(cd + 32, 4); int hsize = cd[36], htype = cd[37], pagesz = cd[39];
    int cd_ok = getbe(cd, 4) == 0xfade0c02ULL && 20 + cdlen == m.siglen && getbe(cd + 8, 4) == 0x20400 && getbe(cd + 12, 4) == 2 && hsize == 32 && htype == 2 && pagesz == 12 && nspecial == 0 && limit == m.sigoff && identoff + 6 <= cdlen && !memcmp(cd + identoff, "unisa", 6) && hashoff + 32 * ncode <= cdlen && ncode == (m.sigoff + 4095) / 4096;
    { if (cx_fmt(lab, sizeof lab, "%s.codedirectory", fx)) { fprintf(stderr, "formats-macho-pe: text too long for lab\n"); exit(2); } } { if (cx_fmt(d, sizeof d, "version 0x20400, adhoc, SHA-256/32, page 4096, codeLimit %llu, %llu slots, ident unisa", limit, ncode)) { fprintf(stderr, "formats-macho-pe: text too long for d\n"); exit(2); } } check(cd_ok, cs, lab, d);
    if (!cd_ok) return;
    int hashes_ok = 1; for (unsigned long long s = 0; s < ncode; s++) { unsigned long long a = s * 4096, l = a + 4096 > limit ? limit - a : 4096; char hex[65]; cx_sha256_hex(p + a, (size_t)l, hex); unsigned char raw[32]; for (int k = 0; k < 32; k++) { unsigned v; sscanf(hex + 2 * k, "%2x", &v); raw[k] = (unsigned char)v; } if (memcmp(raw, cd + hashoff + 32 * s, 32)) hashes_ok = 0; }
    { if (cx_fmt(lab, sizeof lab, "%s.page-hashes", fx)) { fprintf(stderr, "formats-macho-pe: text too long for lab\n"); exit(2); } } check(hashes_ok, cs, lab, "every page hash recomputed with cx_sha256 equals its slot");
    /* control: flip one byte of page 0 in a private copy, the hash oracle must refuse */
    { unsigned char *c = malloc(n); if (!c) die("alloc"); { void *cx_kept = memcpy(c, p, n); (void)cx_kept; } c[m.textsect_off] ^= 1; char hex[65]; cx_sha256_hex(c, 4096 < limit ? 4096 : (size_t)limit, hex); unsigned char raw[32]; for (int k = 0; k < 32; k++) { unsigned v; sscanf(hex + 2 * k, "%2x", &v); raw[k] = (unsigned char)v; } { if (cx_fmt(lab, sizeof lab, "%s.control-flipped-byte-refused", fx)) { fprintf(stderr, "formats-macho-pe: text too long for lab\n"); exit(2); } } check(memcmp(raw, cd + hashoff, 32) != 0, cs, lab, "page-0 hash differs after one flipped byte"); free(c); }
}

/* ---- PE ---- */
typedef struct { char name[9]; unsigned long long vsize, va, rawsize, rawoff, flags; } Sect;
typedef struct { Sect s[8]; int ns; unsigned long long entry, imgbase, sectalign, filealign, sizeimage, sizeheaders, pe, opt, optn, dir[16][2]; int machine_ok, stamp0, subsys_major, subsystem; } Pe;
static const char *pe_parse(const unsigned char *p, size_t n, int arm, Pe *e) {
    memset(e, 0, sizeof *e);
    if (n < 64 || memcmp(p, "MZ", 2)) return "pe-header"; e->pe = get(p + 60, 4);
    if (!span(n, e->pe, 24) || memcmp(p + e->pe, "PE\0\0", 4)) return "pe-header"; e->machine_ok = get(p + e->pe + 4, 2) == (arm ? 0xaa64ULL : 0x8664ULL); e->ns = (int)get(p + e->pe + 6, 2); e->stamp0 = get(p + e->pe + 8, 4) == 0; e->optn = get(p + e->pe + 20, 2); e->opt = e->pe + 24;
    if (e->optn < 112 || !span(n, e->opt, e->optn) || get(p + e->opt, 2) != 0x20b) return "pe-optional";
    const unsigned char *o = p + e->opt; e->entry = get(o + 16, 4); e->imgbase = get(o + 24, 8); e->sectalign = get(o + 32, 4); e->filealign = get(o + 36, 4); e->subsys_major = (int)get(o + 48, 2); e->sizeimage = get(o + 56, 4); e->sizeheaders = get(o + 60, 4); e->subsystem = (int)get(o + 68, 2);
    unsigned long long ndir = get(o + 108, 4); if (ndir != 16 || e->optn != 112 + 16 * 8) return "pe-directories"; for (int i = 0; i < 16; i++) { e->dir[i][0] = get(o + 112 + 8 * i, 4); e->dir[i][1] = get(o + 116 + 8 * i, 4); }
    unsigned long long st = e->opt + e->optn; if (e->ns < 1 || e->ns > 8 || !span(n, st, 40ULL * e->ns)) return "pe-sections";
    for (int i = 0; i < e->ns; i++) { const unsigned char *q = p + st + 40 * i; memcpy(e->s[i].name, q, 8); e->s[i].name[8] = 0; e->s[i].vsize = get(q + 8, 4); e->s[i].va = get(q + 12, 4); e->s[i].rawsize = get(q + 16, 4); e->s[i].rawoff = get(q + 20, 4); e->s[i].flags = get(q + 36, 4); }
    return 0;
}
static int pe_sect(const Pe *e, const char *name) { for (int i = 0; i < e->ns; i++) if (tx_eq(e->s[i].name, name, 1L << 20)) return i; return -1; }
static long long rva2off(const Pe *e, unsigned long long rva, unsigned long long len, int *sect) { for (int i = 0; i < e->ns; i++) { const Sect *s = &e->s[i]; unsigned long long vs = s->vsize > s->rawsize ? s->vsize : s->rawsize; if (rva >= s->va && rva + len <= s->va + vs && rva + len <= s->va + s->rawsize) { if (sect) *sect = i; return (long long)(s->rawoff + (rva - s->va)); } } return -1; }
static void pe_cells(const unsigned char *p, size_t n, int arm, const char *fx) {
    const char *cell = arm ? "pe.arm64.sections" : "pe.x86_64.sections", *ci = arm ? "pe.arm64.imports-reloc-loadconfig" : "pe.x86_64.imports-reloc-loadconfig"; Pe e; char lab[200], d[300];
    const char *why = pe_parse(p, n, arm, &e); { if (cx_fmt(lab, sizeof lab, "%s.parse", fx)) { fprintf(stderr, "formats-macho-pe: text too long for lab\n"); exit(2); } } if (why) { row("FAIL", cell, lab, why); return; }
    { if (cx_fmt(lab, sizeof lab, "%s.header", fx)) { fprintf(stderr, "formats-macho-pe: text too long for lab\n"); exit(2); } } { if (cx_fmt(d, sizeof d, "PE32+, machine ok, TimeDateStamp 0, align 4096/512, subsystem %d v%d", e.subsystem, e.subsys_major)) { fprintf(stderr, "formats-macho-pe: text too long for d\n"); exit(2); } } check(e.machine_ok && e.stamp0 && e.sectalign == 4096 && e.filealign == 512 && e.subsys_major >= 4 && e.subsystem == 3, cell, lab, d);
    int tx = pe_sect(&e, ".text"), rd = pe_sect(&e, ".rdata"), da = pe_sect(&e, ".data"), rl = pe_sect(&e, ".reloc");
    { if (cx_fmt(lab, sizeof lab, "%s.four-sections", fx)) { fprintf(stderr, "formats-macho-pe: text too long for lab\n"); exit(2); } } check(tx >= 0 && rd >= 0 && da >= 0 && rl >= 0 && e.ns == 4, cell, lab, ".text .rdata .data .reloc");
    if (tx < 0 || rd < 0 || da < 0 || rl < 0) return;
    int align_ok = 1, inb = 1, dj = 1, asc = 1; unsigned long long last_end = 0;
    for (int i = 0; i < e.ns; i++) { const Sect *s = &e.s[i]; if (s->va % 4096 || s->rawoff % 512 || s->rawsize % 512) align_ok = 0; if (!span(n, s->rawoff, s->rawsize) || s->rawoff < e.sizeheaders) inb = 0; if (s->va < last_end) asc = 0; last_end = s->va + ((s->vsize + 4095) / 4096) * 4096;
        for (int j = 0; j < i; j++) if (!disjoint(s->rawoff, s->rawoff + s->rawsize, e.s[j].rawoff, e.s[j].rawoff + e.s[j].rawsize)) dj = 0; }
    { if (cx_fmt(lab, sizeof lab, "%s.section-alignment", fx)) { fprintf(stderr, "formats-macho-pe: text too long for lab\n"); exit(2); } } check(align_ok, cell, lab, "RVAs multiples of 4096, raw offsets and sizes multiples of 512");
    { if (cx_fmt(lab, sizeof lab, "%s.section-extents", fx)) { fprintf(stderr, "formats-macho-pe: text too long for lab\n"); exit(2); } } check(inb && dj && asc && e.sizeimage >= last_end, cell, lab, "raw extents in file, disjoint; virtual ascending; SizeOfImage covers them");
    { if (cx_fmt(lab, sizeof lab, "%s.entry-in-text", fx)) { fprintf(stderr, "formats-macho-pe: text too long for lab\n"); exit(2); } } check(e.entry >= e.s[tx].va && e.entry < e.s[tx].va + e.s[tx].vsize && (e.s[tx].flags & 0x20000000), cell, lab, "AddressOfEntryPoint inside executable .text");
    { if (cx_fmt(lab, sizeof lab, "%s.section-flags", fx)) { fprintf(stderr, "formats-macho-pe: text too long for lab\n"); exit(2); } } check((e.s[rd].flags & 0x80000000) == 0 && (e.s[da].flags & 0x80000000) && (e.s[rl].flags & 0x02000000), cell, lab, ".rdata read-only, .data writable, .reloc discardable");
    /* control: misalign .rdata's RVA in a private copy; the alignment oracle must refuse */
    { Pe c = e; c.s[rd].va += 16; int ok = 1; for (int i = 0; i < c.ns; i++) if (c.s[i].va % 4096) ok = 0; { if (cx_fmt(lab, sizeof lab, "%s.control-misaligned-refused", fx)) { fprintf(stderr, "formats-macho-pe: text too long for lab\n"); exit(2); } } check(!ok, cell, lab, "alignment oracle refuses a +16 RVA"); }
    /* imports */
    int rs; long long imp = rva2off(&e, e.dir[1][0], e.dir[1][1], &rs); { if (cx_fmt(lab, sizeof lab, "%s.import-directory", fx)) { fprintf(stderr, "formats-macho-pe: text too long for lab\n"); exit(2); } } check(imp >= 0 && rs == rd && e.dir[1][1] == 40, ci, lab, "one descriptor + terminator inside .rdata");
    if (imp < 0) return;
    const unsigned char *desc = p + imp; unsigned long long oft = get(desc, 4), name = get(desc + 12, 4), ft = get(desc + 16, 4); int term_zero = 1; for (int k = 20; k < 40; k++) if (desc[k]) term_zero = 0;
    long long nameoff = rva2off(&e, name, 13, 0); int dll_ok = nameoff >= 0 && !memcmp(p + nameoff, "KERNEL32.dll", 13);
    long long into = rva2off(&e, oft, 8, 0), iato = rva2off(&e, ft, 8, 0); int thunk_ok = into >= 0 && iato >= 0 && term_zero; unsigned long long nimp = 0;
    if (thunk_ok) { for (unsigned long long k = 0; ; k++) { if (!span(n, (unsigned long long)into + 8 * k, 8) || !span(n, (unsigned long long)iato + 8 * k, 8)) { thunk_ok = 0; break; } unsigned long long a = get(p + into + 8 * k, 8), b = get(p + iato + 8 * k, 8); if (a != b) { thunk_ok = 0; break; } if (!a) { nimp = k; break; }
            if (a >> 63) { thunk_ok = 0; break; } int hs; long long ho = rva2off(&e, a, 3, &hs); if (ho < 0 || hs != rd) { thunk_ok = 0; break; } int nul = 0; for (unsigned long long q = (unsigned long long)ho + 2; q < n && q < (unsigned long long)ho + 256; q++) if (!p[q]) { nul = 1; break; } if (!nul) thunk_ok = 0; } }
    { if (cx_fmt(lab, sizeof lab, "%s.import-thunks", fx)) { fprintf(stderr, "formats-macho-pe: text too long for lab\n"); exit(2); } } { if (cx_fmt(d, sizeof d, "%llu imports from KERNEL32.dll, INT == IAT, hint/name entries NUL-terminated in .rdata", nimp)) { fprintf(stderr, "formats-macho-pe: text too long for d\n"); exit(2); } } check(dll_ok && thunk_ok && nimp > 0, ci, lab, d);
    { if (cx_fmt(lab, sizeof lab, "%s.iat-directory", fx)) { fprintf(stderr, "formats-macho-pe: text too long for lab\n"); exit(2); } } check(e.dir[12][0] == ft && e.dir[12][1] == (nimp + 1) * 8, ci, lab, "IAT directory equals FirstThunk, size (n+1)*8");
    /* load config */
    int cs; long long cfg = rva2off(&e, e.dir[10][0], e.dir[10][1], &cs); unsigned long long cookie = cfg >= 0 && e.dir[10][1] >= 0x60 ? get(p + cfg + 0x58, 8) : 0;
    int cookie_in_data = cookie >= e.imgbase + e.s[da].va && cookie < e.imgbase + e.s[da].va + (e.s[da].vsize > e.s[da].rawsize ? e.s[da].vsize : e.s[da].rawsize);
    { if (cx_fmt(lab, sizeof lab, "%s.load-config", fx)) { fprintf(stderr, "formats-macho-pe: text too long for lab\n"); exit(2); } } check(cfg >= 0 && cs == rd && e.dir[10][1] == 320 && get(p + cfg, 4) == 320 && cookie_in_data, ci, lab, "320-byte load config in .rdata, SecurityCookie inside .data");
    /* relocations */
    int rsct; long long rel = rva2off(&e, e.dir[5][0], e.dir[5][1], &rsct); int rel_ok = rel >= 0 && rsct == rl && e.dir[5][1] >= 8; unsigned long long nrel = 0, target_cookie = 0, prev_rva = 0; int sorted = 1, dedup = 1, grouped = 1, inimg = 1;
    if (rel_ok) { unsigned long long at = 0, lastpage = 0; while (at + 8 <= e.dir[5][1]) { unsigned long long page = get(p + rel + at, 4), bsz = get(p + rel + at + 4, 4); if (bsz < 8 || at + bsz > e.dir[5][1] || page % 4096) { rel_ok = 0; break; } if (nrel && page <= lastpage) grouped = 0; lastpage = page;
            for (unsigned long long q = 8; q + 2 <= bsz; q += 2) { unsigned long long ent = get(p + rel + at + q, 2), type = ent >> 12, off = ent & 0xfff; if (type == 0) continue; if (type != 10) { rel_ok = 0; break; } unsigned long long rva = page + off; if (nrel && rva < prev_rva) sorted = 0; if (nrel && rva == prev_rva) dedup = 0; prev_rva = rva; if (rva + 8 > e.sizeimage) inimg = 0; if (rva == e.dir[10][0] + 0x58) target_cookie = 1; nrel++; }
            at += bsz; } }
    { if (cx_fmt(lab, sizeof lab, "%s.relocations", fx)) { fprintf(stderr, "formats-macho-pe: text too long for lab\n"); exit(2); } } { if (cx_fmt(d, sizeof d, "%llu DIR64 entries in .reloc, sorted, unique, page-grouped, inside the image, cookie field relocated", nrel)) { fprintf(stderr, "formats-macho-pe: text too long for d\n"); exit(2); } } check(rel_ok && nrel >= 1 && sorted && dedup && grouped && inimg && target_cookie, ci, lab, d);
}

typedef struct { const char *name, *src; } Fx;
static const Fx fixtures[2] = { { "ret7", "int main(void){return 7;}\n" }, { "data-print", "#include <stdio.h>\nstatic int tbl[64]={1,2,3};\nstatic const char *msg=\"hello, formats\";\nint main(void){int i,s=0;for(i=0;i<64;i++){tbl[i]+=i;s+=tbl[i];}printf(\"%s %d\\n\",msg,s);return s%256;}\n" } };
static const char *targets[4] = { "osx/x86_64", "osx/arm64", "win/x86_64", "win/arm64" }; static const char *tslug[4] = { "osx-x86_64", "osx-arm64", "win-x86_64", "win-arm64" };

int main(int argc, char **argv) {
    if (argc != 3 || !realpath(argv[1], root) || argv[2][0] != '/') { fputs("usage: ROOT ABS_OUT\n", stderr); return 2; }
    { if (cx_fmt(outdir, sizeof outdir, "%s", argv[2])) { fprintf(stderr, "formats-macho-pe: text too long for outdir\n"); exit(2); } } if (mkdir(outdir, 0700)) die("new out dir must be absent");
    path(bound, sizeof bound, root, "tools/bound"); path(product, sizeof product, root, "unisacc.com");
    char rp[4400]; path(rp, sizeof rp, outdir, "results.tsv"); res = fopen(rp, "wbx"); if (!res) die("results");
    { size_t pn; char *pb = cx_read(product, &pn); if (!pb) die("product"); char h[65]; cx_sha256_hex(pb, pn, h); free(pb); fprintf(res, "IDENTITY\tproduct=%s\n", h); }
    for (int f = 0; f < 2; f++) { char src[4400]; { if (cx_fmt(src, sizeof src, "%s/%s.c", outdir, fixtures[f].name)) { fprintf(stderr, "formats-macho-pe: text too long for src\n"); exit(2); } } saved(src, fixtures[f].src, strlen(fixtures[f].src));
        for (int t = 0; t < 4; t++) { char img[4400], fx[64]; { if (cx_fmt(img, sizeof img, "%s/%s.%s", outdir, fixtures[f].name, tslug[t])) { fprintf(stderr, "formats-macho-pe: text too long for img\n"); exit(2); } } { if (cx_fmt(fx, sizeof fx, "%s.%s", fixtures[f].name, tslug[t])) { fprintf(stderr, "formats-macho-pe: text too long for fx\n"); exit(2); } }
            char *v[] = { bound, "12", "sh", product, src, "-O2", "-b", (char *)targets[t], "-o", img, 0 }; char *env[] = { 0 }; np_result r; char why[1024];
            if (np_run(v, root, env, 14, &r, why, sizeof why) || r.rc) { row("NOT_RUN", t < 2 ? "macho" : "pe", fx, "compile failed"); np_free(&r); continue; } np_free(&r);
            size_t n; unsigned char *p = (unsigned char *)cx_read(img, &n); if (!p) die("image read");
            if (t < 2) macho_cells(p, n, t == 1, fx); else pe_cells(p, n, t == 3, fx); free(p); } }
    fprintf(res, "SUMMARY\tpass=%d\tfail=%d\tnot_run=%d\n", npass, nfail, nnotrun); fclose(res);
    printf("FORMATS_MACHO_PE\tpass=%d\tfail=%d\tnot_run=%d\n", npass, nfail, nnotrun);
    return nfail || nnotrun ? 1 : 0;
}
