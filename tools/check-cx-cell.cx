#pragma unisa use compiler.cellname
#pragma unisa use runtime.cellname
#pragma unisa use compiler.targetname
#pragma unisa use runtime.targetname
#pragma unisa use sys.io
#pragma unisa use text.text
/* Generated by tools/cell-gen.cx. Narrow check of the six joined cells. */
static int join_cell(char *dst, int cap, const char *os, const char *arch) {
    int n = 0;
    int i;
    if (!dst || cap < 2 || !os || !arch) return 1;
    for (i = 0; os[i]; i++) {
        if (n + 1 >= cap) return 1;
        dst[n] = os[i];
        n++;
    }
    if (n + 1 >= cap) return 1;
    dst[n] = '/';
    n++;
    for (i = 0; arch[i]; i++) {
        if (n + 1 >= cap) return 1;
        dst[n] = arch[i];
        n++;
    }
    dst[n] = 0;
    return 0;
}
int main(void) {
    const char *os; const char *arch; const char *ros; const char *rarch;
    const char *cell; const char **missing; char buf[64]; int i;
    missing = 0;
    if (cel_count() != 6 || rcl_count() != 6) return 1;
    if (tn_count() != 6 || rtt_count() != 6) return 1;
    for (i = 0; i < 6; i++) {
        if (tn_at(i, &os, &arch)) return 1;
        if (rtt_at(i, &ros, &rarch)) return 1;
        if (!tx_eqz(os, ros) || !tx_eqz(arch, rarch)) return 1;
        if (join_cell(buf, 64, os, arch)) return 1;
        if (cel_at(i, &cell) || !tx_eqz(cell, buf)) return 1;
        if (rcl_at(i, &cell) || !tx_eqz(cell, buf)) return 1;
    }
    if (cel_at(0, missing) != 4) return 1;
    if (rcl_at(0, missing) != 4) return 1;
    if (cel_at(-1, &cell) != 2) return 1;
    if (cel_at(6, &cell) != 2) return 1;
    if (rcl_at(-1, &cell) != 2) return 1;
    if (rcl_at(6, &cell) != 2) return 1;
    sy_printf("CX_CELL\tok=6\tfailed=0\n");
    return 0;
}
