/* check-speed-probe: samples for tools/speed-probe.cx
 * Two synthetic jobs emit RR_TIME lines; the probe must parse ns -> ms and
 * rank by total. Samples live in a mkdtemp directory under $TMPDIR, never in the tree. */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use sys.time
#pragma unisa use sysx.poll
#pragma unisa use sys.posix

/* an unlinked spool file the drained output of a bounded child goes to */
static int spool_open(void) {
    char t[4096];
    int fd;
    if (cx_fmt(t, sizeof t, "%s/r2b-XXXXXX", sy_tmpdir())) return -1;
    fd = mkstemp(t);
    if (fd >= 0) sy_unlink(t);
    return fd;
}

/* sy_spawn_pipe with a 50 s deadline: the child's stdout (and stderr when EFD is given) is drained here with sy_poll
   into spool files; past the deadline its process group is killed.  OFD/EFD come back as the spool files, rewound,
   and the child is NOT reaped: the caller's sy_wait_status(pid) still reports its real status (128+9 when killed). */
static int spawn_pipe_bounded(char **argv, const char *cwd, int flags, int *ofd, int *efd) {
    int po = -1, pe = -1, pid, fo, fe = -1, open_o = 1, open_e = efd ? 1 : 0, killed = 0;
    long deadline = sy_now_ms() + 50000;
    char chunk[16384];
    pid = sy_spawn_pipe(argv, cwd, flags, &po, efd ? &pe : 0);
    if (pid < 0) return pid;
    fo = spool_open();
    if (efd) fe = spool_open();
    if (fo < 0 || (efd && fe < 0)) { sy_killpg(pid, 9); sy_signal(pid, 9); sy_close(po); if (efd) sy_close(pe); return -EIO; }
    while (open_o || open_e) {
        sy_pollfd_t p[2];
        int n = 0, io = -1, ie = -1, r;
        long left = deadline - sy_now_ms(), g;
        if (left <= 0) {
            if (killed) break;
            sy_killpg(pid, 9); sy_signal(pid, 9); killed = 1; deadline = sy_now_ms() + 2000;
            continue;
        }
        if (open_o) { io = n; p[n].fd = po; p[n].events = SY_POLLIN; p[n].revents = 0; n++; }
        if (open_e) { ie = n; p[n].fd = pe; p[n].events = SY_POLLIN; p[n].revents = 0; n++; }
        r = sy_poll(p, n, left > 200 ? 200 : left);
        if (r < 0) break;
        if (io >= 0 && p[io].revents) {
            g = sy_read(po, chunk, sizeof chunk);
            if (g > 0) { if (sy_write_all(fo, chunk, g)) break; } else open_o = 0;
        }
        if (ie >= 0 && p[ie].revents) {
            g = sy_read(pe, chunk, sizeof chunk);
            if (g > 0) { if (sy_write_all(fe, chunk, g)) break; } else open_e = 0;
        }
    }
    if (open_o || open_e) { sy_killpg(pid, 9); sy_signal(pid, 9); }
    sy_close(po);
    if (efd) sy_close(pe);
    sy_lseek(fo, 0, 0);
    *ofd = fo;
    if (efd) { sy_lseek(fe, 0, 0); *efd = fe; }
    return pid;
}

#define CAP (1L << 18)
static int failed;
static void ck(int ok, const char *n) { if (!ok) failed++; printf("%s\tspeed-probe.%s\n", ok ? "PASS" : "FAIL", n); }
static char out[CAP];

static int run(char **av) {
    char *argv[8]; int i = 0, ofd, efd, pid, ex = 0, code = 0, sig = 0; long n = 0, r; char junk[2048];
    argv[i++] = "sh"; argv[i++] = "./unisacc.com"; argv[i++] = "tools/speed-probe.cx"; argv[i++] = "--";
    for (int k = 0; av[k] && i < 7; k++) argv[i++] = av[k];
    argv[i] = 0;
    pid = spawn_pipe_bounded(argv, 0, SY_SPAWN_STDERR_SPLIT, &ofd, &efd);
    if (pid < 0) return -1;
    while (n < CAP - 1 && (r = sy_read(ofd, out + n, CAP - 1 - n)) > 0) n += r;
    out[n] = 0;
    while (sy_read(ofd, junk, sizeof junk) > 0) {}
    while (sy_read(efd, junk, sizeof junk) > 0) {}
    sy_close(ofd); sy_close(efd);
    if (sy_wait_status(pid, 0, &ex, &code, &sig) != pid || !ex) return -1;
    return code;
}
static int has(const char *s) { return tx_find(out, tx_len(out, CAP), s, tx_len(s, 512)) >= 0; }
/* position of NEEDLE in OUT (or -1); -2 when a later needle is missing */
static long at(const char *s) { return tx_find(out, tx_len(out, CAP), s, tx_len(s, 256)); }

static char base[CAP];   /* 本次运行的独占样本目录：mkdtemp($TMPDIR)，不写仓内 out/ */

int main(int argc, char **argv) {
    const char *td = sy_env("TMPDIR");
    char bigp[4600], smallp[4600], jobsp[4600], outdir[4600], jobs[9600];
    (void)argc; (void)argv;
    if (!td || !td[0]) td = "/tmp";
    if (snprintf(base, sizeof base, "%s/speed-probe-XXXXXX", td) >= (int)sizeof base) return 2;
    if (!mkdtemp(base)) { fputs("check-speed-probe: mkdtemp\n", stderr); return 2; }
    if (snprintf(bigp, sizeof bigp, "%s/big.cx", base) >= (int)sizeof bigp ||
        snprintf(smallp, sizeof smallp, "%s/small.cx", base) >= (int)sizeof smallp ||
        snprintf(jobsp, sizeof jobsp, "%s/jobs.tsv", base) >= (int)sizeof jobsp ||
        snprintf(outdir, sizeof outdir, "%s/out", base) >= (int)sizeof outdir) return 2;
    /* big: lower 1500 elf 2400; small: lower 100 elf 100 */
    const char *big = "#include <stdio.h>\nint main(void){fprintf(stderr,\"RR_TIME\\tinference\\tstage=tapecheck\\trc=0\\tns=750000000\\nRR_TIME\\tinference\\tstage=lower\\trc=0\\tns=1500000000\\nRR_TIME\\tinference\\tstage=elf\\trc=0\\tns=2400000000\\n\");return 0;}\n";
    const char *small = "#include <stdio.h>\nint main(void){fprintf(stderr,\"RR_TIME\\tinference\\tstage=lower\\trc=0\\tns=100000000\\nRR_TIME\\tinference\\tstage=elf\\trc=0\\tns=100000000\\n\");return 0;}\n";
    if (cx_write(bigp, big, tx_len(big, 4096))) { ck(0, "write-big"); return 1; }
    if (cx_write(smallp, small, tx_len(small, 4096))) { ck(0, "write-small"); return 1; }
    if (snprintf(jobs, sizeof jobs, "small\t%s\nbig\t%s\n", smallp, bigp) >= (int)sizeof jobs) return 2;
    if (cx_write(jobsp, jobs, tx_len(jobs, CAP * 2))) { ck(0, "write-jobs"); return 1; }
    char *av[3]; av[0] = jobsp; av[1] = outdir; av[2] = 0;
    int rc = run(av);
    ck(rc == 0, "exit-zero");
    ck(at("small\t200\t100\t100\t0\t0") >= 0, "small-parsed");
    ck(at("big\t4650\t1500\t2400\t750\t0") >= 0, "big-parsed");
    ck(at("1\tbig") >= 0 && at("1\tbig") < at("2\tsmall"), "ranked-by-total");
    ck(at("top10\ttotal_ms") >= 0, "top10-header");
    printf("SPEED_PROBE_CHECKS\tassertions=6\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
