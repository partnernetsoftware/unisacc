/* Exercise the real CLI native image; module mutation controls live in check-chainargv. */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.time
#pragma unisa use sys.posix
int main(int argc,char **argv){char root[4400],dir[4400],bin[4400],com[4400],src[4400],bad[4400];if(argc!=3||sy_realpath(argv[1],root,sizeof root)<0||argv[2][0]!='/')return 2;
if(cx_fmt(dir,sizeof dir,"%s",argv[2])||sy_mkdir(dir,0700)||cx_fmt(bin,sizeof bin,"%s/check",dir)||cx_fmt(com,sizeof com,"%s/unisacc.com",root)||cx_fmt(src,sizeof src,"%s/tools/chain-argv-check.cx",root)||cx_fmt(bad,sizeof bad,"%s/nul.cx",dir))return 2;
char *compile[]={"sh",com,src,"-o",bin,0};if(cx_runv_timeout(compile,40,0,0))return 2;
int failed=0;char *positive[]={bin,0};if(cx_runv_timeout(positive,10,0,0))failed++;
char *usage[]={bin,"extra",0};if(cx_runv_timeout(usage,10,0,0)!=2)failed++;
char *missing[]={bin,"/nonexistent/chain-argv-fixture",src,src,0};if(cx_runv_timeout(missing,10,0,0)!=2)failed++;
char bytes[2]={'x',0};if(cx_write(bad,bytes,2))return 2;char *nul[]={bin,bad,src,src,0};if(cx_runv_timeout(nul,10,0,0)!=2)failed++;
printf("CHECK_CHAIN_ARGV_CHECK\tfailed=%d\n",failed);return failed?1:0;}
