/* Fixture contracts, not six-target native execution or final module attribution. */
#pragma unisa use sys.fs
#pragma unisa use sysx.process
#pragma unisa use text.text
#pragma unisa use mem.bytes
static int checks,bad;
static void ck(int yes,const char *s){checks++;printf("%s\t%s\n",yes?"PASS":"FAIL",s);if(!yes)bad++;}
static char *run(char **v,int expected){np_result r={0};char why[512]={0};int e=np_run(v,0,0,20,&r,why,sizeof why);char *s=0;if(!e&&!r.residue&&r.rc==expected){s=malloc(r.outn+1);if(!s)exit(2);mm_copy(s, r.outn, r.out, r.outn);s[r.outn]=0;}else fprintf(stderr,"transport=%d rc=%d why=%s\n%s\n",e,r.rc,why,r.err?r.err:"");np_free(&r);return s;}
int main(void){char tmp[]="/tmp/check-logic-distribution-XXXXXX",p[4400];if(!mkdtemp(tmp))return 2;if(cx_fmt(p,sizeof p,"%s/slice",tmp))return 2;unsigned char raw[64]={127,'E','L','F',2,1};if(cx_write(p,raw,sizeof raw))return 2;
char *v[]={"sh","./unisacc.com","tools/logic-distribution.cx","--","--slice","lnx/x86_64",p,0};char *s=run(v,0);ck(s&&strstr(s,"format=ELF\tbytes=64"),"ELF fixture byte extent");ck(s&&strstr(s,"total=64\tattributed=0\tunattributed=64\tsum=64\tstatus=EXACT"),"unknown module bytes conserve image");ck(s&&strstr(s,"semantic_decision_share=UNKNOWN"),"no semantic share invented");free(s);
char *sv[]={"sh","./unisacc.com","tools/logic-distribution.cx","--","--selfcheck",0};s=run(sv,0);ck(s&&strstr(s,"CENSUS_SELFTEST PASS"),"classifier lexical positive and negative fixtures");free(s);raw[0]='X';if(cx_write(p,raw,sizeof raw))return 2;s=run(v,2);ck(s!=0,"unknown image format refuses");free(s);char *empty[]={"sh","./unisacc.com","tools/logic-distribution.cx","--",0};s=run(empty,2);ck(s!=0,"missing mode refuses");free(s);unlink(p);rmdir(tmp);printf("LOGIC_DISTRIBUTION_CHECK\tchecks=%d\tfailed=%d\n",checks,bad);return bad?1:0;}
