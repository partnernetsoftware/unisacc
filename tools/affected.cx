/* tools/affected.cx -- "I changed these files: which registered test batches must run again?", and run them.
   From the repo root:

     sh ./unisacc.com tools/affected.cx -- (--since REV | --files F... | --ids ID...) [--list-only | --run [-j N]]
     sh ./unisacc.com tools/affected.cx -- --domain NAME [--domain NAME...] [--domain-summary]
     Domain options intersect --files/--since/--ids/--layer and tier/host filters.
     The checked domain index is loaded only when a domain option is present.
     Summaries describe selection, never an executed test result.
     sh ./unisacc.com tools/affected.cx -- --users FILE
     sh ./unisacc.com tools/affected.cx -- --materials-dump [--ids ID...] [--family NAME] [--prepare-materials]

   Material dump filters: --ids accepts batch IDs (including comma lists). --family NAME selects an exact,
   complete material name: one material is one family, not a hyphen prefix. Repeat --family to select a
   union of names. With both filters, only their intersection is emitted/prepared. Unknown IDs and names
   are independently refused, even when the intersection is empty. No filters preserves registry order.

   Changed files: --since REV is `git diff --name-only REV --` (tracked files changed between REV and the
   working tree; untracked files are not listed), --files names them (repo-relative or absolute; a file that
   no longer exists still matches by its spelling).  --ids skips the search and names batches to run.
   Batches: every tests/batches.tsv row with implementation IMPLEMENTED and mode SOURCE (the registry is read
   and validated with cxlib.testplan).  Its roots are the source field, the entry field when it holds no
   {placeholder}, and the plain path tokens of its args field.  A batch is affected by a changed file that is
     source   one of its root sources;
     use      in the transitive `#pragma unisa use` / `#include "..."` closure of a root (a use resolves as
              cx/compiler/cxmod.cx does: beside the using file, else by the nearest cxroot.tsv -- cxlib.cxroot);
     literal  named inside a string literal of a root source as a repo-relative path that exists (a leading ./
              or / is dropped; a directory with two or more components matches every file below it);
    literal-use  in the use closure of a .cx file named that way (a check that spawns a tool); the file so
             named is itself a tool, so its own path literals count too (one more hop at --tier commit, the
             full transitive closure at every other tier -- see `Tier depth` below);
    arg / arg-use  the same for a path token of the args field;
     table    observed exec/*.tsv generator input of an exactly named recipe/job/artifact (see below).
   Files are compared by sy_realpath, so two link spellings of one file are one file.
   Prints AFFECTED<TAB>id<TAB>why=FILE<TAB>via=KIND per batch (the strongest match, first changed file on a
   tie) and AFFECTED_SUMMARY<TAB>changed=N<TAB>batches=M<TAB>scanned=K.  --list-only (the default) stops there.
   --run [--candidate ABS_DIR] [-j N] (N 1..8, default the free machine admission tokens of cxlib.flowadmit fa_budget, at most 8): each affected batch through tests/run-batch.cx into
   sy_tmpdir()/unisacc-affected-PID/ (its output in that run dir as ID.log), at most N at once; prints each BATCH_RUN line
   (RUN_REFUSED<TAB>id when run-batch printed none) and AFFECTED_RUN<TAB>pass=..<TAB>fail=..<TAB>deferred=..
   <TAB>elapsed_ms=..  No batch is started after 45 s; batches still running at 54 s are killed with their
   process groups (Linux: descendants found with pgrep -P) -- both are reported DEFERRED<TAB>id, to be run
   again with --ids.  A batch that declares materials is DEFERRED (run-batch needs them supplied).
   AFFECTED_RUN also carries kit_ms=, prep_ms= and run_ms=: kit is the tlib kit pre-build, prep is the
   material pre-build, run is start-to-finish of the batches; the three add up to elapsed_ms.  They exist
   for tools/batch-cost.cx to attribute cold builds and link time, and change no decision.
   --native-run-batch opts into compiling the runner in the layout's private .git directory.
   The key binds the source closure, candidate and compile command. A damaged executable is
   refused, and a failed build reports NATIVE_RUNBATCH_FALLBACK before the ordinary invocation.
   tests/run-batch.cx prints BATCH_TIMING after BATCH_RUN with prep_ms/link_ms/run_ms/norm_ms/total_ms and
   kit=hot|cold|fallback, so a single batch's phases are attributable without parsing its stderr.
   rc: 0 every run batch PASS (or nothing to run), 1 any FAIL/UNKNOWN/RUN_REFUSED, 3 only deferrals,
   2 usage, registry or I/O error.
  Tier depth: the literal-hop depth follows --tier.  commit keeps the registry read cheap for every commit:
  one extra hop (a changed tool's own literals, so a two-hop defect like check-release-ape -> ape-pack is
  still caught) but no transitive closure.  daily, release, and every invocation without --tier take the
  full transitive closure, decycled by the (epoch, via) monotonicity in mark(): a node re-enters only when
  its via strengthens.  An unknown tier name is a usage error.
   --users FILE: every tracked .cx (archive/ and symlinks skipped) whose use closure holds FILE, as
   USER<TAB>path, then USERS_SUMMARY<TAB>file=..<TAB>users=N<TAB>scanned=K.
   Table inputs: exec/pipeline/table-deps.tsv is net-deps' static conservative manifest closure.
   Only exec/ paths ending in .tsv are table dependencies; other input kinds are refused, not relabelled.
   Exact recipe/job/artifact literals in the source/use closure and args select those inputs;
   this is not a proof of computed runtime model selection or current generated-byte equivalence.
  Product inputs: tests/batch-product-inputs.tsv (header there) declares what each batch tests. A batch
  holding a `require` placeholder ({candidate}, {hostcc}, ...) must have an id row (else rc 2
  BATCH_PRODUCT_INPUT_UNDECLARED); a change under its declared prefixes selects it via=declared. A batch
  with an id row, or inferred by the `near` row (materials -, only {root}/{out}), takes via=table edges
  only from the commit-tier closure; when the full closure matched only through a deeper literal chain
  it is dropped (NARROWED under --plan). Every other via keeps full depth; other batches are unchanged.
  --no-product-inputs, a missing table or a header-only table give the old output bytes.
  --plan: list only; each AFFECTED row gains reason= (declared prefixes, model<-naming node, or via:file).
  Checked by tools/check-affected-product-inputs.cx. */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.time
#pragma unisa use sysx.poll
#pragma unisa use sys.posix
#pragma unisa use mem.arena
#pragma unisa use mem.bytes
#pragma unisa use text.text
#pragma unisa use cxlib.testplan
#pragma unisa use sysx.process
#pragma unisa use cxlib.cxroot
#pragma unisa use sys.env
#pragma unisa use cxlib.toolprep
#pragma unisa use cxlib.platformscope
#pragma unisa use cxlib.tlibpkg
#pragma unisa use cxlib.kernelinputs
#pragma unisa use cxlib.flowadmit
#pragma unisa use cxlib.batchdomain

/* an unlinked spool file the drained output of a bounded child goes to */
static int spool_open(void) {
    char t[4096];
    int fd;
    if (cx_fmt(t, sizeof t, "%s/r2b-XXXXXX", sy_tmpdir())) return -1;
    fd = mkstemp(t);
    if (fd >= 0) sy_unlink(t);
    return fd;
}

/* sy_spawn_pipe with a 50 s deadline: the child's stdout (and stderr when EFD is given) is drained here with sy_poll
   into spool files; past the deadline its process group is killed.  OFD/EFD come back as the spool files, rewound,
   and the child is NOT reaped: the caller's sy_wait_status(pid) still reports its real status (128+9 when killed). */
static int spawn_pipe_bounded(char **argv, const char *cwd, int flags, int *ofd, int *efd) {
    int po = -1, pe = -1, pid, fo, fe = -1, open_o = 1, open_e = efd ? 1 : 0, killed = 0;
    long deadline = sy_now_ms() + 50000;
    char chunk[16384];
    pid = sy_spawn_pipe(argv, cwd, flags, &po, efd ? &pe : 0);
    if (pid < 0) return pid;
    fo = spool_open();
    if (efd) fe = spool_open();
    if (fo < 0 || (efd && fe < 0)) { sy_killpg(pid, 9); sy_signal(pid, 9); sy_close(po); if (efd) sy_close(pe); return -EIO; }
    while (open_o || open_e) {
        sy_pollfd_t p[2];
        int n = 0, io = -1, ie = -1, r;
        long left = deadline - sy_now_ms(), g;
        if (left <= 0) {
            if (killed) break;
            sy_killpg(pid, 9); sy_signal(pid, 9); killed = 1; deadline = sy_now_ms() + 2000;
            continue;
        }
        if (open_o) { io = n; p[n].fd = po; p[n].events = SY_POLLIN; p[n].revents = 0; n++; }
        if (open_e) { ie = n; p[n].fd = pe; p[n].events = SY_POLLIN; p[n].revents = 0; n++; }
        r = sy_poll(p, n, left > 200 ? 200 : left);
        if (r < 0) break;
        if (io >= 0 && p[io].revents) {
            g = sy_read(po, chunk, sizeof chunk);
            if (g > 0) { if (sy_write_all(fo, chunk, g)) break; } else open_o = 0;
        }
        if (ie >= 0 && p[ie].revents) {
            g = sy_read(pe, chunk, sizeof chunk);
            if (g > 0) { if (sy_write_all(fe, chunk, g)) break; } else open_e = 0;
        }
    }
    if (open_o || open_e) { sy_killpg(pid, 9); sy_signal(pid, 9); }
    sy_close(po);
    if (efd) sy_close(pe);
    sy_lseek(fo, 0, 0);
    *ofd = fo;
    if (efd) { sy_lseek(fe, 0, 0); *efd = fe; }
    return pid;
}

#define CAP (1L << 24)
#define MAXNODE 16384
#define HASHN 32768
#define MAXBATCH 2048
#define MAXJOBS 8

static int arena;
static char root[4096];
static const char *candidate_dir;
static int native_requested, native_ready;
static char native_runner[4400], native_digest[65];
static long root_n;
static const char *root_product_relative = "./unisacc.com"; /* lint:allow R1-product Explicit current-root candidate launcher; preserve the existing relative argv contract. */
static int root_candidate(char *dst,size_t cap){return cx_fmt(dst,cap,"%s/unisacc.com",root);}
static void die(const char *s) { fprintf(stderr, "affected: %s\n", s); exit(2); }
static char *keep(const char *s, long n) { char *p = ar_dup(arena, s, n); if (!p) die("out of memory"); return p; }
static char *zkeep(const char *s) { return keep(s, tx_len(s, CAP)); }

/* ---------- a growable buffer in the arena ---------- */
typedef struct { char *p; long n, cap; } Buf;
static int read_all(char **argv, Buf *out);
static void put(Buf *b, const char *s, long n) {
    if (b->n + n + 1 > b->cap) {
        long c = (b->n + n + 1) * 2; char *t = ar_alloc(arena, c);
        if (!t) die("out of memory");
        if (b->n && mm_copy(t, c, b->p, b->n)) die("buffer copy");
        b->p = t; b->cap = c;
    }
    if (n && mm_copy(b->p + b->n, b->cap - b->n, s, n)) die("buffer copy");
    b->n += n; b->p[b->n] = 0;
}
static void puts_(Buf *b, const char *s) { put(b, s, tx_len(s, CAP)); }

/* ---------- files: one node per realpath ---------- */
enum { V_NONE = 0, V_SOURCE, V_USE, V_LIT, V_LITUSE, V_ARG, V_ARGUSE, V_GUARD, V_TABLE, V_DECL };
static const char *via_name[] = {"-", "source", "use", "literal", "literal-use", "arg", "arg-use", "guard", "table", "declared"};
typedef struct {
    char *key;      /* realpath, or the absolute spelling when it does not resolve */
    char *given;    /* the repo-relative spelling it was first reached by: uses resolve beside it */
    int parsed, cx, isdir, mark, via;
    unsigned long models;
    int *use; int nuse;
    char **tok; int ntok, tokcap;   /* path-like string-literal tokens (raw) */
} Node;
static Node node[MAXNODE];
static int nnode, hslot[HASHN], epoch;

static unsigned long hash(const char *s) { unsigned long h = 1469598103934665603UL; while (*s) { h ^= (unsigned char)*s++; h *= 1099511628211UL; } return h; }
static int lookup(const char *key, const char *given, int create) {
    unsigned long h = hash(key) & (HASHN - 1);
    long kl = tx_len(key, 8192);
    while (hslot[h]) {
        if (tx_eqz(node[hslot[h] - 1].key, key)) return hslot[h] - 1;
        h = (h + 1) & (HASHN - 1);
    }
    if (!create) return -1;
    if (nnode == MAXNODE) die("too many files");
    {   Node *N = &node[nnode];
        N->key = keep(key, kl); N->given = zkeep(given);
        N->cx = kl > 3 && tx_eqz(key + kl - 3, ".cx");
        hslot[h] = ++nnode;
        return nnode - 1;
    }
}
/* REL repo-relative (or absolute): its node */
/* 同一次运行里同一拼写只 realpath 一次、同一字面量 token 只 stat 一次:
   1034 个批共享大量同名源(尤其 cx/sys/*),不做记忆时每批都要重做这些系统调用。 */
static char *spell[8192]; static int spell_node[8192];
static int spell_get(const char *rel) {
    unsigned long h = hash(rel) & 8191; int i;
    for (i = 0; i < 8192; i++) {
        unsigned long s = (h + (unsigned long)i) & 8191;
        if (!spell[s]) return -1;
        if (tx_eqz(spell[s], rel)) return spell_node[s];
    }
    return -1;
}
static void spell_put(const char *rel, int ni) {
    unsigned long h = hash(rel) & 8191; int i;
    for (i = 0; i < 8192; i++) {
        unsigned long s = (h + (unsigned long)i) & 8191;
        if (!spell[s]) { spell[s] = keep(rel, tx_len(rel, 8192)); spell_node[s] = ni; return; }
        if (tx_eqz(spell[s], rel)) { spell_node[s] = ni; return; }
    }
}
static int path_node(const char *rel, int create) {
    char abs[8192], real[4096]; int r, cached; const char *given = rel;
    if (rel[0] != '/' && (cached = spell_get(rel)) >= 0) return cached;
    if (rel[0] == '/') { if (cx_fmt(abs, sizeof abs, "%s", rel)) die("path too long"); }
    else if (cx_fmt(abs, sizeof abs, "%s/%s", root, rel)) die("path too long");
    if (rel[0] == '/' && tx_prefix(rel, tx_len(rel, 8192), root, root_n) && rel[root_n] == '/') given = rel + root_n + 1;
    r = sy_realpath(abs, real, sizeof real);
    if (r < 0 && r != -ENOENT && r != -ENOTDIR) fprintf(stderr, "NOTE\trealpath\t%s\terr=%d\n", rel, r);
    {   int ni = lookup(r >= 0 ? real : abs, given, create);
        if (create && rel[0] != '/') spell_put(rel, ni);
        return ni;
    }
}
static const char *display(int ni) {
    const char *k = node[ni].key;
    if (tx_prefix(k, tx_len(k, 8192), root, root_n) && k[root_n] == '/') return k + root_n + 1;
    return k;
}
/* Static conservative MODEL<TAB>exec TSV closure; independent of the observed-read oracle. */
static char *model_id[64];
static char *model_names[64][7];
static long model_lengths[64][7];
static int model_count, *input_node, *input_model, input_count;
static void load_models(void) {
    size_t n; char *s = cx_read("exec/pipeline/table-deps.tsv", &n); long at = 0;
    if (!s) die("cannot read table dependency projection");
    { long i, rows = 0;
      for (i = 0; i < (long)n; i++) if (s[i] == '\n') rows++;
      input_node = ar_alloc(arena, (rows + 1) * (long)sizeof *input_node);
      input_model = ar_alloc(arena, (rows + 1) * (long)sizeof *input_model);
      if (!input_node || !input_model) die("table dependency allocation"); }
    while (at < (long)n) {
        long end = at, tab; int m;
        while (end < (long)n && s[end] != '\n') end++;
        if (end == (long)n) die("model input projection requires LF rows");
        if (s[at] != '#' && end > at) {
            tab = tx_chr(s + at, end - at, '\t');
            if (tab < 1 || tab + 1 == end - at) die("model input projection row");
            { const char *p = s + at + tab + 1; long pn = end - at - tab - 1;
              if (pn < 10 || !tx_prefix(p, pn, "exec/", 5) || !tx_prefix(p + pn - 4, 4, ".tsv", 4)) die("table dependency must be an exec TSV"); }
            s[at + tab] = 0; s[end] = 0;
            for (m = 0; m < model_count && !tx_eqz(model_id[m], s + at); m++) {}
            if (m == model_count) {
                if (model_count == 64) die("too many models");
                model_id[model_count++] = zkeep(s + at);
            }
            input_model[input_count] = m; input_node[input_count++] = path_node(s + at + tab + 1, 1);
        }
        at = end + 1;
    }
    free(s);
    { int m, k; char name[256];
      const char *prefix[] = {"", "gen-", "tbl-", "net-", "", "", ""};
      const char *suffix[] = {"", "", "", "", ".json", ".tbl", ".net"};
      for (m = 0; m < model_count; m++) for (k = 0; k < 7; k++) {
          if (cx_fmt(name, sizeof name, "%s%s%s", prefix[k], model_id[m], suffix[k])) die("model name bound");
          model_lengths[m][k] = tx_len(name, sizeof name); model_names[m][k] = keep(name, model_lengths[m][k]);
      }
    }
}
static unsigned char len_hit[4096];   /* len_hit[n]: some model name has length n (n < 4096), built lazily */
static int len_hit_ready;
static unsigned long model_token(const char *s, long n) {
    int m, k; unsigned long bits = 0;
    if (!len_hit_ready) {
        for (m = 0; m < model_count; m++) for (k = 0; k < 7; k++) if (model_lengths[m][k] > 0 && model_lengths[m][k] < 4096) len_hit[model_lengths[m][k]] = 1;
        len_hit_ready = 1;
    }
    if (n >= 0 && n < 4096 && !len_hit[n]) return 0;
    for (m = 0; m < model_count; m++) for (k = 0; k < 7; k++)
        if (model_lengths[m][k] == n && tx_prefix(s, n, model_names[m][k], n)) bits |= 1UL << m;
    return bits;
}

static int is_pathc(int c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '-' || c == '.' || c == '/' || c == '+'; }
static void add_tok(Node *N, const char *s, long n) {
    long i = 0; int dot = 0, slash = 0;
    if (n >= 2 && s[0] == '.' && s[1] == '/') { s += 2; n -= 2; dot = 1; }
    while (n > 0 && s[0] == '/') { s++; n--; }
    while (n > 0 && s[n - 1] == '/') n--;
    if (n < 1 || n > 1000) return;
    for (i = 0; i < n; i++) {
        if (s[i] == '/') { slash = 1; if (i + 1 < n && s[i + 1] == '/') return; }
        if (s[i] == '.' && i + 1 < n && s[i + 1] == '.' && (i == 0 || s[i - 1] == '/')) return;
    }
    if (!slash && !dot) return;
    if (N->ntok == N->tokcap) {
        int c = N->tokcap ? N->tokcap * 2 : 16; char **t = ar_alloc(arena, (long)c * (long)sizeof *t);
        if (!t) die("out of memory");
        if (N->ntok && mm_copy(t, (long)c * (long)sizeof *t, N->tok, (long)N->ntok * (long)sizeof *t)) die("copy");
        N->tok = t; N->tokcap = c;
    }
    N->tok[N->ntok++] = keep(s, n);
}
static void add_literal(Node *N, const char *s, long n) {
    N->models |= model_token(s, n);
    long i = 0, a;
    while (i < n) {
        while (i < n && !is_pathc((unsigned char)s[i])) i++;
        a = i;
        while (i < n && is_pathc((unsigned char)s[i])) i++;
        if (i > a) add_tok(N, s + a, i - a);
    }
}
static void add_dep(int ni, const char *rel) {
    Node *N; int d, k;
    d = path_node(rel, 1);
    N = &node[ni];
    if (sy_exists(node[d].key) != 1) { fprintf(stderr, "NOTE\tunresolved\t%s\tin=%s\n", rel, N->given); return; }
    for (k = 0; k < N->nuse; k++) if (N->use[k] == d) return;
    if (N->nuse == 64) die("more than 64 uses in one file");
    N->use[N->nuse++] = d;
}
static long skip_blank(const char *b, long i, long n) { while (i < n && (b[i] == ' ' || b[i] == '\t')) i++; return i; }
static long word(const char *b, long i, long n, const char *w) {
    long wl = tx_len(w, 64);
    if (i + wl <= n && tx_prefix(b + i, n - i, w, wl) && (i + wl == n || b[i + wl] == ' ' || b[i + wl] == '\t' || b[i + wl] == '"')) return i + wl;
    return -1;
}
/* "#pragma unisa use NAME" or "#include \"FILE\"" at B[i] (the '#') */
static void directive(int ni, const char *b, long i, long n) {
    char dir[4096], rel[8192]; long dl = tx_len(node[ni].given, 4095), j, a;
    while (dl > 0 && node[ni].given[dl - 1] != '/') dl--;
    if (tx_copy(dir, sizeof dir, node[ni].given, dl)) die("path too long");
    i = skip_blank(b, i + 1, n);
    if ((j = word(b, i, n, "pragma")) >= 0) {
        i = skip_blank(b, j, n);
        if ((j = word(b, i, n, "unisa")) < 0) return;
        i = skip_blank(b, j, n);
        if ((j = word(b, i, n, "use")) < 0) return;
        i = skip_blank(b, j, n);
        a = i;
        while (i < n && ((b[i] >= 'a' && b[i] <= 'z') || (b[i] >= 'A' && b[i] <= 'Z') || (b[i] >= '0' && b[i] <= '9') || b[i] == '_' || b[i] == '.')) i++;
        if (i == a || i - a > 200) return;
        if ((i - a == 3 && tx_prefix(b + a, 3, "std", 3)) || (i - a == 6 && tx_prefix(b + a, 6, "std.cx", 6)) || tx_prefix(b + a, i - a, "std.", 4)) return;
        if (cxr_path(node[ni].given, b + a, i - a, rel, sizeof rel)) die("cxroot: cannot resolve use");
        add_dep(ni, rel);
    } else if ((j = word(b, i, n, "include")) >= 0) {
        i = skip_blank(b, j, n);
        if (i >= n || b[i] != '"') return;
        a = ++i;
        while (i < n && b[i] != '"' && b[i] != '\n') i++;
        if (i >= n || b[i] != '"' || i == a) return;
        if (cx_fmt(rel, sizeof rel, "%s%.*s", dir, (int)(i - a), b + a)) die("path too long");
        add_dep(ni, rel);
    }
}
static void parse(int ni) {
    size_t n0; long n, i = 0; int ls = 1; char *b;
    node[ni].parsed = 1;
    if (!node[ni].cx) return;
    b = cx_read(node[ni].key, &n0);
    if (!b) { fprintf(stderr, "NOTE\tunreadable\t%s\n", node[ni].given); return; }
    n = (long)n0;
    node[ni].use = ar_alloc(arena, 64 * (long)sizeof(int));
    if (!node[ni].use) die("out of memory");
    while (i < n) {
        char c = b[i];
        if (c == '\n') { ls = 1; i++; continue; }
        if (c == ' ' || c == '\t' || c == '\r' || c == '\f') { i++; continue; }
        if (c == '/' && i + 1 < n && b[i + 1] == '*') {
            long e = tx_find(b + i + 2, n - i - 2, "*/", 2);
            i = e < 0 ? n : i + 2 + e + 2;
            continue;
        }
        if (c == '/' && i + 1 < n && b[i + 1] == '/') { while (i < n && b[i] != '\n') i++; continue; }
        if (c == '#' && ls) { directive(ni, b, i, n); ls = 0; i++; continue; }
        ls = 0;
        if (c == '"') {
            long s = ++i;
            while (i < n && b[i] != '"' && b[i] != '\n') { if (b[i] == '\\' && i + 1 < n) i++; i++; }
            add_literal(&node[ni], b + s, i - s);
            i++; continue;
        }
        if (c == '\'') {
            i++;
            while (i < n && b[i] != '\'' && b[i] != '\n') { if (b[i] == '\\' && i + 1 < n) i++; i++; }
            i++; continue;
        }
        i++;
    }
}

/* ---------- closure of one batch (or one file) ---------- */
static int dirs[4096], dirvia[4096], ndirs;
/* 字面量传递深度随档位:commit 只多跟一层(不改「很多工具都点名同一个文件」时的提交代价),
   daily/release/--all/默认 无限传递并靠 via 单调性去环(发布与日档要的是完整闭包)。 */
static int lit_unlimited = 1;
static int child_via(int v) { return v == V_SOURCE ? V_USE : v == V_LIT ? V_LITUSE : v == V_ARG ? V_ARGUSE : v; }
static void named(const char *tok, int via);
static void named_file(const char *tok, int via);
static long t_parse, t_walk;
static void mark(int ni, int via) {
    Node *N = &node[ni]; int k;
    if (N->mark == epoch && N->via <= via) return;
    N->mark = epoch; N->via = via;
    { long q = sy_now_ms(); if (!N->parsed) parse(ni); t_parse += sy_now_ms() - q; }
    N = &node[ni];
    { long q = sy_now_ms();
    for (k = 0; k < N->nuse; k++) mark(N->use[k], child_via(via));
    /* 被字面量/arg 点到的文件本身也是「工具」:它自己再点名的文件同样算进来,否则 A -> tool.cx -> B
       这种两跳只跟一层(实测:改 tools/ape-pack.cx 只选中 chain-fresh-out 一批,check-release-ape 的
       夹具陈旧红了数天没人发现)。
       commit 档只再跟一层:链工具(candidate-chain/chain-step/chain-run 等)都字面量点名 ape-pack,
       无限传递会让改 ape-pack 选中 37 个 commit 档批次,每次提交都得跑整链。
       daily/release/--all/默认 无限传递:发布与日档要完整闭包,三跳以上也必须到。
       去环靠 mark 的 (epoch, via) 单调性:同一节点只在其 via 变强时重入,child_via 只会变弱。 */
    if (via == V_LIT || via == V_ARG)
        for (k = 0; k < N->ntok; k++) named_file(N->tok[k], via == V_ARG ? V_ARGUSE : V_LITUSE);
    else if (lit_unlimited && (via == V_LITUSE || via == V_ARGUSE))
        for (k = 0; k < N->ntok; k++) named_file(N->tok[k], via);
    t_walk += sy_now_ms() - q; }
}
/* a path token TOK (repo-relative) named by a root, as VIA (V_LIT or V_ARG) */
/* 同一 token 同一次运行只 stat 一次:结果(返回码与 kind)按 token 记忆;冻结输入下与逐次 stat 等价。 */
/* .git/ 前缀 token:工作树里 .git 是 gitdir 指针文件,经 git rev-parse --git-path 取真实路径(50 s 时限);
   成功返回 1 并写 abs,失败返回 0(调用方按原拼接,stat 错误照常报告)。 */
static int git_path_abs(const char *tok, char *abs, int cap) {
    char *v[8]; int ofd, pid, ex = 0, code = 0, sig = 0; long n, got = 0; char b[4096];
    if (!(tok[0] == '.' && tok[1] == 'g' && tok[2] == 'i' && tok[3] == 't' && tok[4] == '/' && tok[5])) return 0;
    v[0] = "git"; v[1] = "rev-parse"; v[2] = "--path-format=absolute"; v[3] = "--git-path"; v[4] = (char *)tok + 5; v[5] = 0;
    pid = spawn_pipe_bounded(v, root, 0, &ofd, 0);
    if (pid < 0) return 0;
    while (got < (long)sizeof b - 1 && (n = sy_read(ofd, b + got, (long)sizeof b - 1 - got)) > 0) got += n;
    sy_close(ofd);
    if (sy_wait_status(pid, 0, &ex, &code, &sig) < 0 || !ex || code != 0) return 0;
    while (got > 0 && (b[got - 1] == '\n' || b[got - 1] == '\r')) got--;
    if (got <= 0 || got >= cap) return 0;
    { long i; for (i = 0; i < got; i++) abs[i] = b[i]; abs[got] = 0; }
    return 1;
}
static char *ts_key[32768]; static int ts_r[32768]; static char ts_kind[32768];
static int tok_stat(const char *tok, sy_stat_t *st) {
    unsigned long h = hash(tok) & 32767; int i; char abs[8192];
    for (i = 0; i < 32768; i++) {
        unsigned long s = (h + (unsigned long)i) & 32767;
        if (!ts_key[s]) {
            int r;
            if (!git_path_abs(tok, abs, sizeof abs) && cx_fmt(abs, sizeof abs, "%s/%s", root, tok)) return -ENAMETOOLONG;
            r = sy_stat(abs, st);
            ts_key[s] = zkeep(tok); ts_r[s] = r; ts_kind[s] = r < 0 ? 0 : st->kind;
            return r;
        }
        if (tx_eqz(ts_key[s], tok)) { st->kind = ts_kind[s]; return ts_r[s]; }
    }
    return sy_stat("/nonexistent-affected-memo-full", st);
}
static void named(const char *tok, int via) {
    sy_stat_t st; int r, ni;
    r = tok_stat(tok, &st);
    if (r == -ENAMETOOLONG) return;
    if (r < 0) { if (r != -ENOENT) fprintf(stderr, "NOTE\tliteral-stat\t%s\terr=%d\n", tok, r); return; }
    ni = path_node(tok, 1);
    if (st.kind == 'd') {
        if (tx_chr(tok, tx_len(tok, 2048), '/') < 0) return;   /* a top-level directory names too much */
        if (ndirs < 4096) { dirs[ndirs] = ni; dirvia[ndirs] = via; ndirs++; }
        return;
    }
    if (st.kind == 'f') mark(ni, via);
}
/* 传递层只跟「文件」:目录记号若也传递,任何提到 exec/parse2 这类目录名的工具都会把它变成整棵子树的
   守卫,而负控用的正是一个不存在的表路径(exec/parse2/no-such-affected-table.tsv),会因此被误选中。 */
static void named_file(const char *tok, int via) {
    sy_stat_t st;
    if (tok_stat(tok, &st) < 0 || st.kind != 'f') return;
    mark(path_node(tok, 1), via);
}
static void mark_root(const char *rel) {
    int ni = path_node(rel, 1), k;
    mark(ni, V_SOURCE);
    for (k = 0; k < node[ni].ntok; k++) named(node[ni].tok[k], V_LIT);
}

/* Batches that read their inputs through a computed path (a runtime unit list): no use/literal/arg
   edge reaches them, so a change anywhere below these subtrees reruns them.  Explicit, not scanned;
   weakest match -- any source/use/literal/arg edge wins over a guard. */
static const char *GUARD[][4] = {
    {"cross-targets-lnx", "src", "cx/sys", "include"},
    {"cross-targets-osx", "src", "cx/sys", "include"},
    {"cross-targets-win", "src", "cx/sys", "include"},
    {0, 0, 0, 0}
};
static void mark_guards(const char *id) {
    int g, k;
    for (g = 0; GUARD[g][0]; g++) if (tx_eqz(GUARD[g][0], id))
        for (k = 1; k < 4 && GUARD[g][k]; k++) {
            if (ndirs >= 4096) die("too many guarded directories");
            dirs[ndirs] = path_node(GUARD[g][k], 1); dirvia[ndirs++] = V_GUARD;
        }
}

/* ---------- registry ---------- */
typedef struct { char *id, *source, *entry, *args, *materials, *tier, *platform; int budget; } Batch;
static Batch batch[MAXBATCH];
/* A batch registered for another native host cannot run here.  It is reported as
   NOT_APPLICABLE, counted separately, and never as a failure: before this, an osx row
   selected by a change was handed to run-batch, refused there, and became a red batch. */
static int nna;
static int host_allows(int b) {
    if (psc_platform_allowed(batch[b].platform)) return 1;
    printf("NOT_APPLICABLE\t%s\tplatform=%s\thost_scope=%s\n", batch[b].id, batch[b].platform, psc_host_scope());
    nna++;
    return 0;
}
/* An inherited hard deadline that has already passed refuses every child before it starts, so
   one named REFUSE here replaces a wall of per-batch failures the caller would have to read. */
static void refuse_expired_inherited_deadline(void) {
    const char *v = getenv("UNISACC_BOUND_DEADLINE_MONO");
    if (!v || !*v) return;
    { char *end = 0; double d = strtod(v, &end); sy_ts_t t;
      if (end == v || (end && *end) || !(d > 0)) return;
      if (sy_mono(&t)) return;
      if (d <= (double)t.sec + (double)t.nsec / 1e9) {
          printf("REFUSE\tinherited-deadline-expired\tUNISACC_BOUND_DEADLINE_MONO=%s\n", v);
          exit(2);
      } }
}
static int nbatch;
static const char *selected_tier;
static int domain_on,domain_filter,domain_wanted[6],domain_of[MAXBATCH],domain_registered[6];
static void domain_load(void){
    Buf out={0,0,0};char product[4400];if(root_candidate(product,sizeof product))die("domain candidate path bound");
    char*v[]={"sh",product,"tools/batch-domains-gen.cx","--","--check","--dump",0};
    if(read_all(v,&out)){fprintf(stderr,"DOMAIN_REFUSE\treason=index-not-current\taction=run batch-domains-gen --write after resolving named contract errors\n");exit(2);}
    for(int b=0;b<nbatch;b++)domain_of[b]=-1;int rows=0;
    for(char*p=out.p;p&&*p;){char*e=strchr(p,'\n');if(!e)die("domain index missing newline");*e=0;
        if(*p&&*p!='#'&&strcmp(p,"id\tdomain\torigin\tbasis")){char*f[4];int nf=1;f[0]=p;for(char*q=p;*q;q++)if(*q=='\t'){*q=0;if(nf==4)die("domain index row shape");f[nf++]=q+1;}
            if(nf!=4)die("domain index row shape");int k=bdom_kind(f[1]);if(k<0)die("domain index unknown domain");domain_registered[k]++;rows++;
            for(int b=0;b<nbatch;b++)if(tx_eqz(batch[b].id,f[0])){if(domain_of[b]>=0)die("domain index duplicate batch");domain_of[b]=k;break;}
        }p=e+1;
    }if(!rows)die("domain index empty");for(int b=0;b<nbatch;b++)if(domain_of[b]<0){fprintf(stderr,"DOMAIN_REFUSE\tid=%s\treason=missing-index-row\taction=resolve declaration or explicit exception, then regenerate\n",batch[b].id);exit(2);}
}
static int domain_accept(int b){return !domain_on||!domain_filter||domain_wanted[domain_of[b]];}
/* registered is the full denominator; eligible applies tier and host; selected applies the query. */
static void domain_emit(const int*sel,int nsel){if(!domain_on)return;int eligible[6]={0},chosen[6]={0},total=0;
    for(int b=0;b<nbatch;b++)if((!selected_tier||tp_tier_includes(selected_tier,batch[b].tier))&&psc_platform_allowed(batch[b].platform))eligible[domain_of[b]]++;
    for(int i=0;i<nsel;i++)chosen[domain_of[sel[i]]]++;
    for(int k=0;k<6;k++){total+=domain_registered[k];printf("DOMAIN_SUMMARY\tdomain=%s\tregistered=%d\teligible=%d\tselected=%d\n",bdom_name(k),domain_registered[k],eligible[k],chosen[k]);}
    printf("DOMAIN_TOTAL\tregistered=%d\tselected=%d\tselection-only\tno-test-result\n",total,nsel);
}
static void on_batch(const tp_batch_view *v, void *ctx) {
    (void)ctx;
    /* The assembler contract lives in its generated material directory. Other
       PREPARED rows still require their own reviewed producer admission. */
    int assembler = tx_eqz(v->mode,"PREPARED") && tx_eqz(v->id,"assembler") && tx_eqz(v->materials,"assembler");
    if (!tx_eqz(v->implementation, "IMPLEMENTED") || (!tx_eqz(v->mode, "SOURCE") && !assembler)) return;
    if (nbatch == MAXBATCH) die("too many batches");
    batch[nbatch].id = zkeep(v->id); batch[nbatch].source = zkeep(v->source); batch[nbatch].entry = zkeep(v->entry);
    batch[nbatch].args = zkeep(v->args); batch[nbatch].materials = zkeep(v->materials);
    batch[nbatch].platform = zkeep(v->platform);
    batch[nbatch].tier = zkeep(v->tier); batch[nbatch].budget = atoi(v->budget);
    nbatch++;
}
static void on_cov(const tp_coverage_view *v, void *ctx) { (void)v; (void)ctx; }
static void load_registry(void) {
    size_t rn, cn; char why[1200]; tp_summary sum; tp_observer ob = {on_batch, on_cov, 0};
    char *r = cx_read("tests/batches.tsv", &rn), *c = cx_read("tests/coverage.tsv", &cn);
    if (!r || !c) die("cannot read tests/batches.tsv or tests/coverage.tsv");
    if (tp_visit(root, r, rn, c, cn, &ob, &sum, why, sizeof why)) { fprintf(stderr, "affected: REFUSE metadata %s\n", why); exit(2); }
    if(domain_on)domain_load();
}
/* --plan reason: per model, the first closure node (or -1 = an args token) that named it; -2 unset */
static int model_src[64]; static unsigned long cur_models;
static void mark_batch(Batch *B) {
    unsigned long models = 0; int ni;
    for (ni = 0; ni < 64; ni++) model_src[ni] = -2;
    ndirs = 0; epoch++;
    mark_root(B->source);
    if (tx_chr(B->entry, tx_len(B->entry, 4096), '{') < 0 && !tx_eqz(B->entry, B->source)) mark_root(B->entry);
    mark_guards(B->id);
    if (!tx_eqz(B->args, "-")) {   /* ';'-separated tokens; {placeholders} skipped */
        const char *at = B->args;
        while (*at) {
            long n = 0; char tok[2048];
            while (at[n] && at[n] != ';') n++;
            { unsigned long tb = model_token(at, n); int m; for (m = 0; m < model_count; m++) if ((tb & (1UL << m)) && model_src[m] == -2) model_src[m] = -1; models |= tb; }
            if (n > 0 && at[0] != '{' && n < (long)sizeof tok && tx_chr(at, n, '/') >= 0 && !tx_copy(tok, sizeof tok, at, n)) named(tok, V_ARG);
            at += n; if (*at) at++;
        }
    }
    for (ni = 0; ni < nnode; ni++) if (node[ni].mark == epoch && node[ni].models) {
        int m; for (m = 0; m < model_count; m++) if ((node[ni].models & (1UL << m)) && model_src[m] == -2) model_src[m] = ni;
        models |= node[ni].models;
    }
    cur_models = models;
    for (ni = 0; ni < input_count; ni++) if (models & (1UL << input_model[ni])) mark(input_node[ni], V_TABLE);
}
/* the strongest match of the changed files against the current marks: its via, *WHY the file */
static int match(const int *changed, int nch, int *why) {
    int best = V_NONE, k, d;
    for (k = 0; k < nch; k++) {
        int ci = changed[k], v = V_NONE;
        if (node[ci].mark == epoch) v = node[ci].via;
        for (d = 0; d < ndirs; d++) {
            const char *dk = node[dirs[d]].key, *ck = node[ci].key; long dl = tx_len(dk, 8192);
            if (tx_prefix(ck, tx_len(ck, 8192), dk, dl) && ck[dl] == '/' && (v == V_NONE || dirvia[d] < v)) v = dirvia[d];
        }
        if (v != V_NONE && (best == V_NONE || v < best)) { best = v; *why = ci; }
    }
    return best;
}
/* 批级记忆:(source,entry,args) 与 changed[] 不变时 mark_batch+match 的结论也不变,而批 id 只影响
   mark_guards(只对 3 个 cross-targets 批生效)。1034 个 IMPLEMENTED SOURCE 批只有 560 个 distinct
   源。命中时直接复用 (v, why),不重算闭包;guard 批仍走完整路径以免漏掉目录守卫。 */
static char *bkey[4096]; static int bv[4096], bwhy[4096], bsrc[4096], bmod[4096];
/* --plan: for a via=table match on node WHY, the model that pulled the table in (*MOD) and the closure
   node that named that model (return; -1 = an args token, -2 = none found). Changes no decision. */
static int table_reason(int why, int *mod) {
    int k; *mod = -1;
    for (k = 0; k < input_count; k++)
        if (input_node[k] == why && (cur_models & (1UL << input_model[k]))) { *mod = input_model[k]; return model_src[input_model[k]]; }
    return -2;
}
static int bslot(const char *k, int create) {
    unsigned long h = hash(k) & 4095; int i;
    for (i = 0; i < 4096; i++) {
        unsigned long s = (h + (unsigned long)i) & 4095;
        if (!bkey[s]) { if (!create) return -1; bkey[s] = keep(k, tx_len(k, 8200)); return (int)s; }
        if (tx_eqz(bkey[s], k)) return (int)s;
    }
    return -1;
}
static int batch_has_guard(const char *id) {
    int g; for (g = 0; GUARD[g][0]; g++) if (tx_eqz(GUARD[g][0], id)) return 1;
    return 0;
}

/* ---------- child processes ---------- */
static int read_all(char **argv, Buf *out) {
    int ofd, efd, pid, ex = 0, code = 0, sig = 0; char chunk[65536]; long r; Buf err = {0, 0, 0};
    pid = spawn_pipe_bounded(argv, root, SY_SPAWN_STDERR_SPLIT, &ofd, &efd);
    if (pid < 0) return pid;
    while ((r = sy_read(ofd, chunk, sizeof chunk)) > 0) put(out, chunk, r);
    while ((r = sy_read(efd, chunk, sizeof chunk)) > 0) put(&err, chunk, r);
    sy_close(ofd); sy_close(efd);
    if (sy_wait_status(pid, 0, &ex, &code, &sig) < 0) return -EIO;
    if (err.n) fprintf(stderr, "%s", err.p);
    return ex ? code : 128 + sig;
}
static long parse_long(const char *s, long n) { long v = 0, i; if (n < 1 || n > 18) return -1; for (i = 0; i < n; i++) { if (s[i] < '0' || s[i] > '9') return -1; v = v * 10 + (s[i] - '0'); } return v; }

/* the batch's own tree: freeze it, kill it, re-check what survived, and report the residue (0: everything
   the scan saw is gone).  KEEP lists the other live children so one deadline cannot take a sibling job with
   it.  -ENOSYS where /proc is absent: the previous group kill, and a residue no code can vouch for. */
static int kill_tree(int pid, const int *keep, int nkeep, char *rep, int repcap) {
    int sv = sy_kill_tree(pid, 2000, keep, nkeep, rep, repcap);
    if (sv < 0) { sy_killpg(pid, 9); sy_kill(pid); return sv; }
    /* SIGKILL 到进程真正消失之间有窗口:第一轮报的 residue 可能只是还在 dying。再扫第二轮,只报第二轮
       仍然活着的 pid —— 那才是真的没杀干净(实测 residue=1 survived=PID 全是这种竞态)。 */
    if (sv > 0) {
        char rep2[256];
        sv = sy_kill_tree(pid, 2000, keep, nkeep, rep2, sizeof rep2);
        if (sv < 0) { sy_killpg(pid, 9); sy_kill(pid); return sv; }
        if (sv > 0 && rep && repcap > 0) { int u = 0; const char *s = rep2; while (s[u] && u < repcap - 1) { rep[u] = s[u]; u++; } rep[u] = 0; }
    }
    return sv;
}

typedef struct { int pid, ofd, efd, bi; long deadline, t_spawn; Buf out, err; } Child;
/* P9 实测耗时事实表: run-batch 自己在跑完时追加一行; 被本工具在截止时杀掉的批 run-batch 写不了,
   在这里补一行 status=KILLED、total_ms=实际已跑毫秒(下界)。只记观测,不判通过,不用于跳过执行。
   路径与开关同 tests/run-batch.cx(UNISACC_BATCH_TIMES,off 不记;UNISACC_TABLES 已设时不写真表)。 */
static void bt_killed(const char *id, long ms) {
    const char *bt = sy_env("UNISACC_BATCH_TIMES"), *tt = sy_env("UNISACC_TABLES"), *home = sy_env("HOME"); char tp[4400], ln[512];
    if (bt && *bt) { if (tx_eqz(bt, "off") || cx_fmt(tp, sizeof tp, "%s", bt)) return; }
    else if ((tt && *tt) || !home || !*home || cx_fmt(tp, sizeof tp, "%s/.cache/unisacc/batch-times.tsv", home)) return;
    if (!cx_fmt(ln, sizeof ln, "%ld\t%s\tKILLED\t%ld\t-1\t-\t-\taffected-kill\n", sy_wall_s(), id, ms)) (void)sy_append_file(tp, ln, tx_len(ln, 512), 0644);
}
static char outparent[4400];
static long t_main, start_deadline = 45000, hard_deadline = 54000;
static int deadline_hook;   /* --start/--hard-deadline-ms 是测试钩子:给了就按给的数,不再按注册预算推导 */

/* the last line of S starting with PREFIX, or 0 */
static const char *last_line(const char *s, long n, const char *prefix, long *ln) {
    long at = 0, pl = tx_len(prefix, 512); const char *found = 0;
    while (at < n) {
        long e = at;
        while (e < n && s[e] != '\n') e++;
        if (e - at >= pl && tx_prefix(s + at, e - at, prefix, pl)) { found = s + at; *ln = e - at; }
        at = e + 1;
    }
    return found;
}
/* 1 PASS, 0 not */
static int finish(Child *C, int ex, int code, int sig) {
    char logp[4600], pre[256]; Buf lg = {0, 0, 0}; long ln = 0, ln2 = 0; const char *line; const char *id = batch[C->bi].id;
    put(&lg, C->out.p ? C->out.p : "", C->out.n); puts_(&lg, "\n--- stderr ---\n"); put(&lg, C->err.p ? C->err.p : "", C->err.n);
    {   const char *tl = last_line(C->out.p ? C->out.p : "", C->out.n, "BATCH_TIMING\t", &ln2);
        if (tl) { puts_(&lg, ""); put(&lg, tl, ln2); }
    }
    if (cx_fmt(logp, sizeof logp, "%s/%s.log", outparent, id) || cx_write(logp, lg.p, (size_t)lg.n)) fprintf(stderr, "NOTE\tlog\tcannot write %s\n", logp);
    if (cx_fmt(pre, sizeof pre, "BATCH_RUN\tid=%s\t", id)) die("id too long");
    line = last_line(C->out.p ? C->out.p : "", C->out.n, pre, &ln);
    if (line) {
        if (native_requested) printf("%.*s\trunner=%s\n",(int)ln,line,native_ready?"native":"sh");
        else printf("%.*s\n", (int)ln, line);
        return tx_find(line, ln, "\tstatus=PASS\t", 13) >= 0;
    }
    {   const char *why = last_line(C->err.p ? C->err.p : "", C->err.n, "run-batch: ", &ln);
        printf("RUN_REFUSED\t%s\trc=%d\tlog=%s\treason=%.*s\n", id, ex ? code : 128 + sig, logp + root_n + 1, why ? (int)ln : 1, why ? why : "-");
    }
    return 0;
}
/* --prepare-materials: resolve each declared material to a canonical path before run-batch.
   Preparable kinds: `NAME-tool:path` (-> tools/NAME.cx, falling back to tests/cases/NAME.cx when that file does
   not exist, built native by the toolprep kit, else the product under tools/bound 55; PREP_SECS 90 under the
   owner ceiling) and `streams` (tools/streams-material.cx: a directory of seven legacy-contract shims).
   Everything else stays DEFERRED with a named reason (sha256 values and any name without a producer).
   The builds run BEFORE the batch loop, at most PREP_PAR at a time, each bounded at PREP_SECS (and
   never past the run's own 54 s kill), and no build starts after PREP_BUDGET_MS from process start (the rest are DEFERRED prebuild-budget; a rerun
   resumes from the cache).  Identity = sha256 over the source use/literal closure plus the product sha;
   the result lives at ~/.cache/unisacc/prep-cache/NAME-ID16.{bin,rcpt}; a hit is re-verified by the file's own sha256.
   A receipt is never a PASS and a PASS is never cached. */
#define PREP_PAR 3
#define PREP_SECS 90
#define PREP_BUDGET_MS 38000
typedef struct { char name[128]; int kind, state; char id[17], path[4400], rcpt[4400], src[600], why[200], sha[65], closure[65], native_fingerprint[65], ver[160], via[600]; long ms; int cached; } Prep;
/* PK_PROD: the product under test itself (ROOT/unisacc.com, identity = its sha).  PK_HOST: a declared host
   oracle (/usr/bin/cc|ld|ar, identity = file sha + first --version line).  PK_MDIR: a directory from a material
   tool (net/pp-gold/object-material), artifact sha = material.tsv.  PK_SVAL/PK_SID: a sha256 value derived
   from an already PREPARED material (streams.json com_sha256 of one stage / identity-helper run on ROOT). */
enum { PK_TOOL = 1, PK_STREAMS = 2, PK_IDENT = 3, PK_PROD = 4, PK_HOST = 5, PK_MDIR = 6, PK_SVAL = 7, PK_SID = 8, PK_HOSTC = 9 };   /* PK_IDENT: seed/ident.c compiled with cc (closure = ident.c + sha256.h) */   /* PK_STREAMS: a directory of seven shims from tools/streams-material.cx; its artifact sha is that of streams.json */
enum { PS_TODO = 0, PS_READY, PS_FAILED };
static int prep_on = 0;
#define PREP_MAX 64   /* distinct preparable materials per run (slots, not a time bound) */
static Prep prep[PREP_MAX];
static int nprep = 0;
static char prod_sha[65];
static char cachedir[4400];

static int prep_find(const char *name) { int k; for (k = 0; k < nprep; k++) if (tx_eqz(prep[k].name, name)) return k; return -1; }
static int cmp_s(const void *a, const void *b) { return strcmp(*(char *const *)a, *(char *const *)b); }
/* sha256 over the sorted "path<TAB>filesha" lines of the source closure of REL */
static int closure_sha(const char *rel, char *out65) {
    char **ln = ar_alloc(arena, 4096 * (long)sizeof(char *)); int k, n = 0; Buf all = {0, 0, 0};
    if (!ln) die("out of memory");
    epoch++;
    mark_root(rel);
    for (k = 0; k < nnode && n < 4096; k++) {
        char *s; size_t sz; char h[65], line[8400]; if (node[k].mark != epoch) continue;
        s = cx_read(node[k].key, &sz);
        if (!s) return -1;
        cx_sha256_hex(s, sz, h);
        free(s);
        if (cx_fmt(line, sizeof line, "%s\t%s\n", display(k), h)) return -1;
        ln[n++] = zkeep(line);
    }
    qsort(ln, n, sizeof(char *), cmp_s);
    for (k = 0; k < n; k++) puts_(&all, ln[k]);
    cx_sha256_hex(all.p ? all.p : "", (size_t)all.n, out65);
    return 0;
}
static int file_sha(const char *p, char *h) { size_t sz; char *s = cx_read(p, &sz); if (!s) return -1; tp_sha(s, sz, h); free(s); return 0; }   /* same SHA-256; cxlib.tlibpkg tp_sha = kernel AF_ALG with the portable fallback */
/* The opt-in runner is built from the candidate and this checkout, never from
 * a caller-supplied executable. The default route doesn't inspect this cache. */
static int native_key(const char *candidate,char *key) {
    char ape[65],sources[65],recipe[512],receipt[4400],manifest[65]="";
    if(candidate_dir && (cx_fmt(receipt,sizeof receipt,"%s/receipt.tsv",candidate_dir) || file_sha(receipt,manifest)))return -1;
    if(file_sha(candidate,ape) || closure_sha("tests/run-batch.cx",sources) ||
       cx_fmt(recipe,sizeof recipe,"run-batch-v1\t%s\t%s\tsh APE tests/run-batch.cx -o IMAGE\n%s",ape,sources,manifest))return -1;
    tp_sha(recipe,strlen(recipe),key);return 0;
}
static int native_intact(void) {
    char got[65];sy_stat_t st;
    return !sy_lstat(native_runner,&st) && st.kind=='f' && st.uid==sy_uid() &&
           !file_sha(native_runner,got) && !strcmp(got,native_digest);
}
static int native_prepare(const char *candidate) {
    char gitdir[4200],dir[4200],key[65],again[65],lock[4400],receipt[4400],temp[4500];
    sy_stat_t st;int rc=0;
    if(native_key(candidate,key) || cx_fmt(gitdir,sizeof gitdir,"%s/.git",root) ||
       sy_lstat(gitdir,&st) || st.uid!=sy_uid()) return 0;
    if(st.kind=='f'){
        /* Git resolves the per-worktree gitdir. Check its backlink before
           creating anything there; never put a worktree cache in common-dir. */
        char back[4400],resolved[4400]; size_t n=0;
        if(!git_path_abs(".git/gitdir",back,sizeof back))return 0;
        char *point=cx_read(back,&n);
        int matches=point && n==strlen(gitdir)+1 && point[n-1]=='\n' && !memcmp(point,gitdir,n-1);
        free(point);
        char *slash=strrchr(back,'/');
        if(!matches || !slash || strcmp(slash,"/gitdir"))return 0;
        *slash=0;
        if(sy_realpath(back,resolved,sizeof resolved)<0 || strcmp(back,resolved) ||
           cx_fmt(gitdir,sizeof gitdir,"%s",resolved) || sy_lstat(gitdir,&st) || st.uid!=sy_uid())return 0;
    }
    if(st.kind!='d' || cx_fmt(dir,sizeof dir,"%s/unisacc-native-runner",gitdir) ||
       (sy_mkdir(dir,0700) && (sy_lstat(dir,&st) || st.kind!='d' || st.mode!=0700 || st.uid!=sy_uid())) ||
       cx_fmt(native_runner,sizeof native_runner,"%s/%s",dir,key) ||
       cx_fmt(receipt,sizeof receipt,"%s.sha256",native_runner) ||
       cx_fmt(lock,sizeof lock,"%s/prepare.lock",dir) ||
       cx_fmt(temp,sizeof temp,"%s.%d.tmp",native_runner,sy_pid()))return 0;
    int fd=open(lock,O_RDWR|O_CREAT|O_NOFOLLOW|O_CLOEXEC,0600);
    if(fd<0)return 0;
    long end=sy_now_ms()+3000;
    while(sy_flock(fd,6)){if(sy_now_ms()>=end){sy_close(fd);return 0;}sy_sleep_ms(50);}
    int present=sy_lstat(receipt,&st),repair=0,refuse_current=0;
    if(!present){
        size_t n=0;char *record=st.kind=='f' && st.uid==sy_uid()?cx_read(receipt,&n):0;
        if(!record || n!=64 || mm_copy(native_digest,sizeof native_digest,record,64))rc=-1;
        else {
            native_digest[64]=0;
            if(native_intact())rc=1;
            else {
                int missing=sy_lstat(native_runner,&st)==-ENOENT;
                refuse_current=!missing;
                if(sy_unlink(receipt))rc=-1;
                else {repair=1;present=-ENOENT;}
            }
        }
        free(record);
    }
    if(present==-ENOENT){
        char *v[]={"sh",(char *)candidate,"tests/run-batch.cx","-o",temp,0};np_result result={0};char why[256];
        if(!np_run(v,root,0,55,&result,why,sizeof why) && !result.rc &&
           !file_sha(temp,native_digest) && !native_key(candidate,again) && !strcmp(again,key) &&
           !sy_rename(temp,native_runner) && !sy_write_atomic(receipt,native_digest,64,0600))rc=1;
        np_free(&result);sy_unlink(temp);
        if(repair && rc==1)printf("NATIVE_RUNBATCH_REBUILT\tkey=%s\treason=%s\n",key,refuse_current?"digest-mismatch":"missing-image");
        if(refuse_current)rc=-1;
    }
    sy_close(fd);
    if(rc==1)printf("PREPARED\tnative-run-batch\tkey=%s\tsha256=%s\tpath=%s\n",key,native_digest,native_runner);
    return rc;
}
/* A material.tsv hash alone cannot attest either generated CX root. */
static int prep_asm_sha(const char *dir,char h[65]) {
    const char *names[]={"assembler.cx","contracts.cx","material.tsv"};Buf bytes={0};
    for(int i=0;i<3;i++){char p[4500],sha[65],row[200];struct stat st;
        if(cx_fmt(p,sizeof p,"%s/%s",dir,names[i])||lstat(p,&st)||!S_ISREG(st.st_mode)||file_sha(p,sha)||cx_fmt(row,sizeof row,"%s\t%s\n",names[i],sha))return -1;
        puts_(&bytes,row);
    }
    cx_sha256_hex(bytes.p,(size_t)bytes.n,h);return 0;
}
static int prep_art_sha(const Prep *P, char *h) {
    if(P->kind==PK_MDIR&&tx_eqz(P->name,"isolated-streams")){
        Buf all={0};
        for(int i=0;i<10;i++){
            char leaf[64],path[4500],sha[65],row[160];sy_stat_t st;
            if(i<8){if(cx_fmt(leaf,sizeof leaf,"unisacc-stream%d.com",i+1))return -1;}
            else if(cx_fmt(leaf,sizeof leaf,"%s",i==8?"streams.json":"material.tsv"))return -1;
            if(cx_fmt(path,sizeof path,"%s/%s",P->path,leaf)||sy_lstat(path,&st)||st.kind!='f'||file_sha(path,sha)||cx_fmt(row,sizeof row,"%s\t%s\n",leaf,sha))return -1;
            puts_(&all,row);
        }
        cx_sha256_hex(all.p,(size_t)all.n,h);return 0;
    }
    if(P->kind==PK_MDIR && tx_eqz(P->name,"assembler"))return prep_asm_sha(P->path,h);
    char leaf[4500];
    if (P->kind != PK_STREAMS && P->kind != PK_MDIR) return file_sha(P->path, h);
    if (cx_fmt(leaf, sizeof leaf, "%s/%s", P->path, P->kind == PK_STREAMS ? "streams.json" : "material.tsv")) return -1;
    return file_sha(leaf, h);
}
/* 1 when the stored receipt names exactly this identity and the artifact's own sha256 still matches */
static int prep_verify(Prep *P) {
    char leaf[4400], want[400], *s; size_t sz; int ok;
    if (cx_fmt(leaf, sizeof leaf, "%s", P->path)) return 0;
    if (prep_art_sha(P, P->sha)) return 0;
    if(P->kind==PK_HOSTC){
        char side[4600],prefix[400],actual[65];size_t count;struct stat st;
        if(lstat(P->path,&st)||!S_ISREG(st.st_mode)||!(st.st_mode&0111)||cx_fmt(side,sizeof side,"%s.material.tsv",P->path)||lstat(side,&st)||!S_ISREG(st.st_mode))return 0;
        char *receipt=cx_read(side,&count);if(!receipt)return 0;
        if(cx_fmt(prefix,sizeof prefix,"libneed-native-material-v1\nstatus\tPREPARED\nfingerprint\t%s\nartifact\t%s\n",P->native_fingerprint,P->sha)){free(receipt);return 0;}
        size_t header=strlen(prefix);int valid=count>header&&!memcmp(receipt,prefix,header);
        if(valid){tp_sha(receipt+header,count-header,actual);valid=!strcmp(actual,P->native_fingerprint);}free(receipt);if(!valid)return 0;
    }
    if (cx_fmt(want, sizeof want, "closure=%s\tproduct=%s\tartifact=%s\n", P->closure, prod_sha, P->sha)) return 0;
    s = cx_read(P->rcpt, &sz);
    if (!s) return 0;
    ok = sz == (size_t)tx_len(want, sizeof want) && !memcmp(s, want, sz);
    free(s);
    return ok;
}
/* The source file a material name resolves to: tools/NAME.cx, or tests/cases/NAME.cx when the first is
   absent (fixtures: fake-gh, fake-s9, fake-release-prepare).  Shared with --materials-dump, so the reported
   resolution and the one the build uses cannot drift.  0 with SRC set, -1 with WHY. */
static int prep_kind_of(const char *name, int kind) {
    long nl = tx_len(name, 256);
    if (kind == 2) {
        static const char *st[] = {"lower", "e1", "e2", "e3", "e4", "prune", "elf"}; int i;
        if (tx_eqz(name, "current-source-id")) return PK_SID;
        if (nl > 11 && tx_prefix(name, nl, "stream-", 7) && tx_eqz(name + nl - 4, "-sha"))
            for (i = 0; i < 7; i++) if (nl - 11 == tx_len(st[i], 16) && !memcmp(name + 7, st[i], (size_t)(nl - 11))) return PK_SVAL;
        return 0;
    }
    if (tx_eqz(name, "unitcache-product") || tx_eqz(name, "e2model")) return PK_PROD;
    if (tx_eqz(name, "hostcc") || tx_eqz(name, "hostld") || tx_eqz(name, "hostar") || tx_eqz(name, "hosttcc")) return PK_HOST;
    if (tx_eqz(name, "nets") || tx_eqz(name, "pp-gold") || tx_eqz(name, "objects") || tx_eqz(name,"assembler") || tx_eqz(name,"kernels") || tx_eqz(name,"isolated-streams")) return PK_MDIR;
    if (tx_eqz(name, "libneed-native")) return PK_HOSTC;
    if (tx_eqz(name, "streams")) return PK_STREAMS;
    if (tx_eqz(name, "identity-helper")) return PK_IDENT;
    return PK_TOOL;
}
static int prep_source(const char *name, int kind, char *src, long cap, char *why, int whycap) {
    long nl = tx_len(name, 256);
    char cand[600];
    int pk = prep_kind_of(name, kind);
    if (pk == PK_SVAL) { cx_fmt(src, cap, "streams/streams.json:%.*s", (int)(nl - 11), name + 7); return 0; }
    if (pk == PK_SID) { cx_fmt(src, cap, "identity-helper:ROOT"); return 0; }
    if (pk == PK_PROD) { cx_fmt(src, cap, "unisacc.com"); return 0; }
    if (pk == PK_HOSTC) { cx_fmt(src, cap, "tools/libneed-native-material.cx"); return 0; }
    if (pk == PK_HOST && tx_eqz(name, "hosttcc")) {
        const char *want = getenv("TCC"), *at = getenv("PATH");
        if (!want || !*want) want = "tcc";
        if (strchr(want, '/')) {
            if (access(want, X_OK) == 0 && !cx_fmt(src, cap, "%s", want)) return 0;   /* canonicalized in prep_add */
            if (errno == ENOENT) cx_fmt(why, whycap, "HOST_TOOL_MISSING:hosttcc:%s", want);
            else cx_fmt(why, whycap, "host-tool-access=%s:errno=%d", want, errno);
            return -1;
        }
        if (!at) at = "/bin:/usr/bin";
        for (;;) {
            const char *end = strchr(at, ':'); long n = end ? end - at : (long)strlen(at);
            char path[4400];
            if (cx_fmt(path, sizeof path, "%.*s/%s", n ? (int)n : 1, n ? at : ".", want)) {
                cx_fmt(why, whycap, "host-tool-path-too-long=hosttcc"); return -1;
            }
            if (access(path, X_OK) == 0) {
                if (!cx_fmt(src, cap, "%s", path)) return 0;   /* canonicalized in prep_add */
                cx_fmt(why, whycap, "host-tool-unreadable=%s", path); return -1;
            }
            if (errno != ENOENT) {
                cx_fmt(why, whycap, "host-tool-access=%s:errno=%d", path, errno); return -1;
            }
            if (!end) break;
            at = end + 1;
        }
        cx_fmt(why, whycap, "HOST_TOOL_MISSING:hosttcc:%s", want); return -1;
    }
    if (pk == PK_HOST) { cx_fmt(src, cap, "/usr/bin/%s", name + 4); return 0; }
    if (pk == PK_MDIR && tx_eqz(name,"kernels")) { cx_fmt(src,cap,"tools/kernel-build.cx"); return 0; }
    if (pk == PK_MDIR && tx_eqz(name,"isolated-streams")) { if(cx_fmt(src,cap,"tools/isolated-streams-material.cx"))return -1;return 0; }
    if (pk == PK_MDIR) { if (cx_fmt(src, cap, "tools/%s-material.cx", tx_eqz(name,"assembler") ? "asm" : tx_eqz(name, "nets") ? "net" : tx_eqz(name, "objects") ? "object" : "pp-gold")) return -1; }
    else
    if (kind == 2) { cx_fmt(why, whycap, "unpreparable=sha256-value:%s", name); return -1; }
    else
    if (nl > 5 && tx_eqz(name + nl - 5, "-tool")) {
        if (cx_fmt(src, cap, "tools/%.*s.cx", (int)(nl - 5), name)) { cx_fmt(why, whycap, "source-name-too-long=%s", name); return -1; }
        if (cx_fmt(cand, sizeof cand, "%s/%s", root, src) || sy_exists(cand) != 1) {
            if (cx_fmt(src, cap, "tests/cases/%.*s.cx", (int)(nl - 5), name)) { cx_fmt(why, whycap, "source-name-too-long=%s", name); return -1; }
        }
    } else if (tx_eqz(name, "streams")) { if (cx_fmt(src, cap, "tools/streams-material.cx")) return -1; }
    else if (tx_eqz(name, "identity-helper")) { if (cx_fmt(src, cap, "seed/ident.c")) return -1; }   /* compiled from source (C helper, cc), not a .cx tool */
    else { cx_fmt(why, whycap, "no-producer=%s", name); return -1; }
    if (cx_fmt(cand, sizeof cand, "%s/%s", root, src) || sy_exists(cand) != 1) { cx_fmt(why, whycap, "source-absent=%s", src); return -1; }
    return 0;
}
/* register NAME when it is preparable; returns its slot or -1 (with WHY set) */
static int prep_plan(const char *name, int kind, char *why, int cap) {
    int k = prep_find(name); Prep *P; char h[65], buf[600];
    if (k >= 0) return k;
    if (nprep >= PREP_MAX) { cx_fmt(why, cap, "too-many-materials"); return -1; }
    P = &prep[nprep];
    memset(P, 0, sizeof *P);
    cx_fmt(P->name, sizeof P->name, "%s", name);
    P->kind = prep_kind_of(name, kind);
    if (prep_source(name, kind, P->src, (long)sizeof P->src, why, cap)) return -1;
    if (P->kind == PK_PROD) {   /* A split product has an executable launcher and a distinct model container. */
        const char *leaf = candidate_dir && tx_eqz(name,"e2model") ? "pkg-hdr.bin" : "unisacc.com";
        if (cx_fmt(P->path, sizeof P->path, "%s/%s", candidate_dir ? candidate_dir : root, leaf)) { cx_fmt(why, cap, "path-too-long=%s", name); return -1; }
        if(candidate_dir) {
            if(file_sha(P->path,P->sha)){cx_fmt(why,cap,"candidate-material-unreadable=%s",name);return -1;}
        } else if(mm_copy(P->sha,sizeof P->sha,prod_sha,65))die("material digest bound");
        if(mm_copy(P->closure,sizeof P->closure,P->sha,65) || mm_copy(P->id,sizeof P->id,P->sha,16))die("material identity bound");
        P->id[16] = 0;
        P->state = PS_READY; P->cached = 1; return nprep++;
    }
    if (P->kind == PK_HOST) {   /* declared host oracle: canonical path, file sha, first --version line */
        /* The batch front gate (tests/run-batch.cx supplied()) takes only a non-link path that is its own
           realpath, so the material is the resolved regular executable; the spelling found stays as via=. */
        char bound[4400], *av[6], idl[800], idh[65]; Buf o = {0, 0, 0}; long e = 0; struct stat hs; int r;
        if (cx_fmt(P->via, sizeof P->via, "%s", P->src)) { cx_fmt(why, cap, "host-tool-path-too-long=%s", name); return -1; }
        r = sy_realpath(P->src, P->path, (int)sizeof P->path);
        if (r == -ENOENT || r == -ENOTDIR) { cx_fmt(why, cap, "host-tool-unresolved=%s", P->src); return -1; }
        if (r < 0) { cx_fmt(why, cap, "host-tool-realpath=%s:errno=%d", P->src, -r); return -1; }
        errno = 0;
        if (lstat(P->path, &hs)) { cx_fmt(why, cap, "host-tool-stat=%s:errno=%d", P->path, errno); return -1; }
        if (!S_ISREG(hs.st_mode)) { cx_fmt(why, cap, "host-tool-not-regular=%s", P->path); return -1; }
        if (access(P->path, X_OK)) { cx_fmt(why, cap, "host-tool-not-executable=%s:errno=%d", P->path, errno); return -1; }
        if (file_sha(P->path, P->sha)) { cx_fmt(why, cap, "host-tool-unreadable=%s", P->path); return -1; }
        if (cx_fmt(bound, sizeof bound, "%s/tools/bound", root)) return -1;
        av[0] = bound; av[1] = "5"; av[2] = P->path; av[3] = "--version"; av[4] = 0;
        if (read_all(av, &o) != 0 || !o.n) { cx_fmt(why, cap, "host-tool-version=%s", P->src); return -1; }
        while (e < o.n && o.p[e] != '\n' && o.p[e] != '\t') e++;
        cx_fmt(P->ver, sizeof P->ver, "%.*s", (int)(e < 150 ? e : 150), o.p);
        /* identity = content sha plus canonical path */
        if (cx_fmt(idl, sizeof idl, "%s\n%s\n", P->sha, P->path)) { cx_fmt(why, cap, "host-tool-path-too-long=%s", name); return -1; }
        tp_sha(idl, (size_t)tx_len(idl, sizeof idl), idh);
        memcpy(P->closure, idh, 65); memcpy(P->id, idh, 16); P->id[16] = 0;
        P->state = PS_READY; P->cached = 1; return nprep++;
    }
    if(P->kind==PK_MDIR&&tx_eqz(name,"kernels")){
        const char *material=getenv("UNISACC_KERNELS_MATERIAL_DIR");char tool[4400],product[4400],bound[4400],receipt[4600],identity[140];struct stat st;
        if(!material||!*material){cx_fmt(why,cap,"MULTIPHASE_REQUIRED:kernels:bootstrap,prepare,prepare-assembler,preprocess-ISA,assemble-ISA,link-ISA,seal");return -1;}
        if(!realpath(material,P->path)||lstat(P->path,&st)||!S_ISDIR(st.st_mode)){cx_fmt(why,cap,"kernels-material-directory");return -1;}
        if(cx_fmt(tool,sizeof tool,"%s/%s",root,P->src)||root_candidate(product,sizeof product)||cx_fmt(bound,sizeof bound,"%s/tools/bound",root))return -1;
        char *v[]={bound,"25","sh",product,tool,"--",root,P->path,"--verify",0};Buf observed={0,0,0};
        if(read_all(v,&observed)||!observed.p||!strstr(observed.p,"VERIFIED\tkernels\t")){cx_fmt(why,cap,"kernels-material-refused");return -1;}
        if(cx_fmt(receipt,sizeof receipt,"%s/material.tsv",P->path)||file_sha(receipt,P->sha)||closure_sha(P->src,P->closure)||cx_fmt(identity,sizeof identity,"%s%s",P->sha,P->closure))return -1;
        cx_sha256_hex(identity,128,P->closure);memcpy(P->id,P->closure,16);P->id[16]=0;P->state=PS_READY;P->cached=1;return nprep++;
    }
    if (P->kind == PK_SVAL || P->kind == PK_SID) {   /* resolved by prep_derive once its producer is PREPARED */
        char w2[200];
        if (prep_plan(P->kind == PK_SVAL ? "streams" : "identity-helper", 1, w2, (int)sizeof w2) < 0) { cx_fmt(why, cap, "producer-refused=%s:%s", name, w2); return -1; }
        if (nprep >= PREP_MAX) { cx_fmt(why, cap, "too-many-materials"); return -1; }
        P = &prep[nprep];   /* the recursive plan may have taken the slot: re-seat */
        memset(P, 0, sizeof *P);
        cx_fmt(P->name, sizeof P->name, "%s", name);
        P->kind = prep_kind_of(name, kind);
        (void)prep_source(name, kind, P->src, (long)sizeof P->src, why, cap);
        return nprep++;
    }
    if (P->kind == PK_IDENT) {
        char a[4400], b2[4400], ha[65], hb[65], both[140];
        if (cx_fmt(a, sizeof a, "%s/seed/ident.c", root) || cx_fmt(b2, sizeof b2, "%s/seed/sha256.h", root)
            || file_sha(a, ha) || file_sha(b2, hb) || cx_fmt(both, sizeof both, "%s%s", ha, hb)) { cx_fmt(why, cap, "closure-unreadable=%s", P->src); return -1; }
        cx_sha256_hex(both, (size_t)tx_len(both, sizeof both), P->closure);
    } else
    if (closure_sha(P->src, P->closure)) { cx_fmt(why, cap, "closure-unreadable=%s", P->src); return -1; }
    if(P->kind==PK_HOSTC) {
        /* Resolve missing HOSTCC before source-running the producer: CC also
           participates in the product's native tool compilation. */
        const char *want=getenv("UNISACC_LIBNEED_CC"),*at=getenv("PATH");int found=0;
        if(!want||!*want)want=getenv("CC");
        if(!want||!*want)want="cc";
        if(strpbrk(want,"\r\n\t ")){cx_fmt(why,cap,"hostcc-single-executable-required");return -1;}
        if(strchr(want,'/')){
            if(!access(want,X_OK))found=1;
            else if(errno!=ENOENT){cx_fmt(why,cap,"hostcc-access-errno=%d",errno);return -1;}
        }else{
            if(!at)at="/bin:/usr/bin";
            for(;;){const char *end=strchr(at,':');long n=end?end-at:(long)strlen(at);char candidate[4400];
                if(cx_fmt(candidate,sizeof candidate,"%.*s/%s",n?(int)n:1,n?at:".",want))return -1;
                if(!access(candidate,X_OK)){found=1;break;}
                if(errno!=ENOENT){cx_fmt(why,cap,"hostcc-access-errno=%d",errno);return -1;}
                if(!end)break;at=end+1;
            }
        }
        if(!found){cx_fmt(why,cap,"HOST_TOOL_MISSING:hostcc");return -1;}
        char product[4400],tool[4400],bound[4400],combined[140];Buf output={0,0,0};
        if(root_candidate(product,sizeof product)||cx_fmt(tool,sizeof tool,"%s/%s",root,P->src)||cx_fmt(bound,sizeof bound,"%s/tools/bound",root))return -1;
        char *v[]={bound,"20","sh",product,tool,"--","--fingerprint",root,0};
        int rc=read_all(v,&output);
        if(rc||output.n!=65||output.p[64]!='\n'){cx_fmt(why,cap,rc==3?"HOST_TOOL_MISSING:hostcc":"libneed-native-fingerprint-refused");return -1;}
        for(int i=0;i<64;i++)if(!((output.p[i]>='0'&&output.p[i]<='9')||(output.p[i]>='a'&&output.p[i]<='f'))){cx_fmt(why,cap,"libneed-native-fingerprint-shape");return -1;}
        memcpy(P->native_fingerprint,output.p,64);P->native_fingerprint[64]=0;
        if(cx_fmt(combined,sizeof combined,"%s%s",P->closure,P->native_fingerprint))return -1;
        cx_sha256_hex(combined,128,P->closure);
    }
    if(P->kind==PK_MDIR && tx_eqz(P->name,"assembler")) {
        Buf inputs={0};puts_(&inputs,root);puts_(&inputs,"\n");puts_(&inputs,P->closure);
        for(int i=0;i<ki_asm_count();i++){char p[4500],h[65],row[4600];
            if(cx_fmt(p,sizeof p,"%s/%s",root,ki_asm_file(i))||file_sha(p,h)||cx_fmt(row,sizeof row,"%s\t%s\n",ki_asm_file(i),h)){cx_fmt(why,cap,"assembler-input-unreadable");return -1;}
            puts_(&inputs,row);
        }
        cx_sha256_hex(inputs.p,(size_t)inputs.n,P->closure);
    }
    if (P->kind == PK_STREAMS) {   /* the shims call tools/streams-e1-frame.cx at run time: its closure is part of the identity */
        char h2[65], both[140];
        if (closure_sha("tools/streams-e1-frame.cx", h2) || cx_fmt(both, sizeof both, "%s%s", P->closure, h2)) { cx_fmt(why, cap, "closure-unreadable=tools/streams-e1-frame.cx"); return -1; }
        cx_sha256_hex(both, (size_t)tx_len(both, sizeof both), P->closure);
    }
    if(P->kind==PK_MDIR&&tx_eqz(P->name,"isolated-streams")){
        char runner_sha[65],both[140];
        if(closure_sha("tools/isolated-stream.cx",runner_sha)||cx_fmt(both,sizeof both,"%s%s",P->closure,runner_sha)){cx_fmt(why,cap,"closure-unreadable=tools/isolated-stream.cx");return -1;}
        cx_sha256_hex(both,(size_t)tx_len(both,sizeof both),P->closure);
    }
    /* the checkout root is part of the identity: builders such as tools/source-package.cx embed
       realpath(__FILE__), so one closure built under two roots yields different bytes and must not share a cache name */
    {   char idb[4400]; if (cx_fmt(idb, sizeof idb, "%s%s\troot=%s", P->closure, prod_sha, root)) { cx_fmt(why, cap, "identity=%s", name); return -1; }
        cx_sha256_hex(idb, (size_t)tx_len(idb, sizeof idb), h);
        memcpy(P->id, h, 16); P->id[16] = 0; }
    if (cx_fmt(P->path, sizeof P->path, "%s/%s-%s.%s", cachedir, name, P->id, P->kind == PK_STREAMS || P->kind == PK_MDIR ? "dir" : "bin")
        || cx_fmt(P->rcpt, sizeof P->rcpt, "%s/%s-%s.rcpt", cachedir, name, P->id)) { cx_fmt(why, cap, "path-too-long=%s", name); return -1; }
    if (prep_verify(P)) { P->state = PS_READY; P->cached = 1; }
    return nprep++;
}
typedef struct { int pid, ofd, efd, job, secs; long t0; char tmp[4400]; Buf out, err; } PJob;
static int prep_start(PJob *J, int k) {
    Prep *P = &prep[k]; char product[4400], bound[4400], image[4400], kitdir[4400], srcabs[4400], pid_s[32];
    char *av[16]; int n = 0;
    if (root_candidate(product, sizeof product) || cx_fmt(bound, sizeof bound, "%s/tools/bound", root)
        || tp_kit_dir(root, kitdir, sizeof kitdir) || cx_fmt(image, sizeof image, "%s/tlib-prep", kitdir)
        || cx_fmt(srcabs, sizeof srcabs, "%s/%s", root, P->src)
        || cx_fmt(pid_s, sizeof pid_s, "%d", sy_pid())
        || cx_fmt(J->tmp, sizeof J->tmp, "%s/%s-%s.%s.tmp", cachedir, P->name, P->id, pid_s)) return -1;
    {
        static char s_all[16], s_kit[16];
        static const char *script = "[ -x \"$2\" ] && \"$1\" \"$8\" \"$2\" prep \"$3\" -o \"$4\" --root \"$5\" && exit 0; exec \"$1\" \"$7\" sh \"$6\" \"$3\" -o \"$4\"";
        static const char *sscript = "exec \"$1\" \"$7\" sh \"$6\" \"$3\" -- \"$5\" \"$4\" >/dev/null";   /* streams-material.cx ROOT NEW_OUTDIR (absent) */
        static const char *cscript = "exec \"$1\" \"$7\" sh \"$6\" \"$3\" -- \"$5\" \"$4\" \"$6\" >/dev/null";   /* isolated-streams: explicit candidate compiler */
        static const char *iscript = "exec \"$1\" \"$8\" cc -std=c99 -D_POSIX_C_SOURCE=200809L -O2 -w \"$3\" -o \"$4\"";   /* same flags as chain-step seed-helper */
        long left = (hard_deadline - (sy_now_ms() - t_main)) / 1000 - 2;   /* a build never outlives the run's own kill deadline */
        J->secs = left < PREP_SECS ? (int)left : PREP_SECS;
        if (J->secs < 6) return -2;
        if (cx_fmt(s_all, sizeof s_all, "%d", J->secs) || cx_fmt(s_kit, sizeof s_kit, "%d", J->secs < 20 ? J->secs : 20)) return -1;
        static const char *pscript = "exec \"$1\" \"$7\" sh \"$6\" \"$3\" -- prepare \"$5\" \"$4\" >/dev/null";   /* pp-gold/object-material prepare ROOT NEW_ABS_MATERIAL */
        int is_net = P->kind == PK_MDIR && (tx_eqz(P->name, "nets") || tx_eqz(P->name,"assembler") || tx_eqz(P->name,"isolated-streams"));   /* ROOT NEW_OUTDIR producers */
        av[n++] = "sh"; av[n++] = "-c"; av[n++] = (char *)(tx_eqz(P->name,"isolated-streams")?cscript:P->kind == PK_STREAMS || is_net ? sscript : P->kind == PK_MDIR || P->kind == PK_HOSTC ? pscript : P->kind == PK_IDENT ? iscript : script); av[n++] = "sh"; av[n++] = bound; av[n++] = image; av[n++] = srcabs; av[n++] = J->tmp; av[n++] = root; av[n++] = product; av[n++] = s_all; av[n++] = s_kit;
    }
    av[n] = 0;
    J->job = k; J->t0 = sy_now_ms(); J->out.p = 0; J->out.n = J->out.cap = 0; J->err = J->out;
    J->pid = sy_spawn_pipe(av, root, SY_SPAWN_STDERR_SPLIT, &J->ofd, &J->efd);
    return J->pid < 0 ? J->pid : 0;
}
static void prep_done(PJob *J, int ok) {
    Prep *P = &prep[J->job]; char rc[800];
    P->ms = sy_now_ms() - J->t0;
    if (ok) {
        char expected[65];int assembler=P->kind==PK_MDIR&&tx_eqz(P->name,"assembler");
        if(assembler&&prep_asm_sha(J->tmp,expected))ok=0;
        if(ok&&P->kind==PK_HOSTC){char from[4600],to[4600];if(cx_fmt(from,sizeof from,"%s.material.tsv",J->tmp)||cx_fmt(to,sizeof to,"%s.material.tsv",P->path)||sy_rename(from,to))ok=0;}
        if(ok)(void)sy_rename(J->tmp, P->path);   /* a concurrent run may have placed the same identity first: verified below */
        if (prep_art_sha(P, P->sha)) ok = 0;
        if(assembler&&ok&&strcmp(expected,P->sha)){ok=0;cx_fmt(P->why,sizeof P->why,"assembler-publish-content-mismatch");}
        if (ok && !cx_fmt(rc, sizeof rc, "closure=%s\tproduct=%s\tartifact=%s\n", P->closure, prod_sha, P->sha) && cx_write(P->rcpt, rc, (size_t)tx_len(rc, sizeof rc)) == 0 && (P->kind!=PK_HOSTC || prep_verify(P))) { P->state = PS_READY; return; }
    }
    P->state = PS_FAILED;
    if (!P->why[0]) cx_fmt(P->why, sizeof P->why, "build-failed=%s", P->name);
}
/* PK_SVAL / PK_SID: the value comes from the PREPARED producer, never from the object under test and never a
   literal.  stream-STAGE-sha = streams.json com_sha256 of that stage, cross-checked against the shim file's own
   sha; current-source-id = the identity-helper's 64-hex output on ROOT.  0 ready, -1 with WHY. */
static int prep_derive(Prep *P) {
    int k = prep_find(P->kind == PK_SVAL ? "streams" : "identity-helper"); Prep *Q;
    P->state = PS_FAILED;
    if (k < 0 || prep[k].state != PS_READY) { cx_fmt(P->why, sizeof P->why, "producer-not-prepared=%s", P->name); return -1; }
    Q = &prep[k];
    if (P->kind == PK_SVAL) {
        char leaf[4500], pat[64], h[65]; size_t sz; char *s; long nl = tx_len(P->name, 128), a, f, c;
        if (cx_fmt(leaf, sizeof leaf, "%s/streams.json", Q->path) || cx_fmt(pat, sizeof pat, "\"stream_unit\":\"%.*s\"", (int)(nl - 11), P->name + 7)) return -1;
        s = cx_read(leaf, &sz);
        if (!s) { cx_fmt(P->why, sizeof P->why, "streams-json-unreadable=%s", P->name); return -1; }
        a = tx_find(s, (long)sz, pat, tx_len(pat, sizeof pat));
        f = a < 0 ? -1 : tx_find(s + a, (long)sz - a, "\"file\":\"", 8);
        c = a < 0 ? -1 : tx_find(s + a, (long)sz - a, "\"com_sha256\":\"", 14);
        if (a < 0 || f < 0 || c < 0 || a + c + 14 + 64 > (long)sz) { free(s); cx_fmt(P->why, sizeof P->why, "streams-json-no-stage=%s", P->name); return -1; }
        memcpy(P->sha, s + a + c + 14, 64); P->sha[64] = 0;
        {   long fe = a + f + 8, fl = 0; while (fe + fl < (long)sz && s[fe + fl] != '"' && fl < 200) fl++;
            if (cx_fmt(leaf, sizeof leaf, "%s/%.*s", Q->path, (int)fl, s + fe)) { free(s); return -1; } }
        free(s);
        if (file_sha(leaf, h) || !tx_eqz(h, P->sha)) { cx_fmt(P->why, sizeof P->why, "streams-json-sha-mismatch=%s", P->name); return -1; }
    } else {
        char bound[4400], *av[5]; Buf o = {0, 0, 0}; int i;
        if (cx_fmt(bound, sizeof bound, "%s/tools/bound", root)) return -1;
        av[0] = bound; av[1] = "10"; av[2] = Q->path; av[3] = root; av[4] = 0;
        if (read_all(av, &o) != 0 || o.n != 65 || o.p[64] != '\n') { cx_fmt(P->why, sizeof P->why, "identity-helper-output=%s", P->name); return -1; }
        for (i = 0; i < 64; i++) if (!((o.p[i] >= '0' && o.p[i] <= '9') || (o.p[i] >= 'a' && o.p[i] <= 'f'))) { cx_fmt(P->why, sizeof P->why, "identity-helper-hex=%s", P->name); return -1; }
        memcpy(P->sha, o.p, 64); P->sha[64] = 0;
    }
    memcpy(P->path, P->sha, 65);   /* the material's value handed to run-batch is the sha itself */
    memcpy(P->closure, Q->closure, 65); memcpy(P->id, Q->id, 17);
    P->state = PS_READY;
    return 0;
}
/* --materials-dump prints only MATERIAL rows: a reader that hands them to run-batch must not have to skip
   PREPARED/PREBUILD lines.  When a dump asked for the build, those reports go to stderr instead. */
static int prep_quiet;
/* --prep-only: kit + materials only, no batch loop; the summary the AFFECTED_PREP line reports */
static int prep_only, pb_materials, pb_hits, pb_built, pb_failed;
static int prep_plan_only;   /* --prep-plan: print each planned material's cache identity and stop; builds nothing */
static const char *kit_state = "unknown";
static void prep_print(const char *fmt, ...) { va_list ap; va_start(ap, fmt); vfprintf(prep_quiet ? stderr : stdout, fmt, ap); va_end(ap); }
static const char *material_family[MAXBATCH]; static int nmaterial_family;
static int material_wanted(const char *name) {
    int k;
    if (!nmaterial_family) return 1;
    for (k = 0; k < nmaterial_family; k++) if (tx_eqz(name, material_family[k])) return 1;
    return 0;
}
/* UNISACC_PREP_CACHE: an isolated material/prewarm cache directory (checks use it so a negative control never
   touches the shared ~/.cache/unisacc/prep-cache); unset = the shared default. */
static int prep_cache_dir(char *out, int cap) {
    const char *e = sy_env("UNISACC_PREP_CACHE");
    if (e && e[0] == '/') return cx_fmt(out, cap, "%s", e);
    return cx_fmt(out, cap, "%s/.cache/unisacc/prep-cache", sy_env_or("HOME", "."));
}
/* Compile prewarm of tests/run-batch.cx.  The product's run cache is keyed by product + source content, so the
   prewarm only fills that compile cache: run-batch is started with no arguments, which stops at its usage line
   (rc 2) before any batch is selected, so no test is executed and no result is kept.  The receipt records the
   identity (run-batch sha, product sha, compile-cache dir) that was warmed; --run recomputes it and reports
   compile_use=prewarmed only on an exact match, else cold.  The receipt never skips work: the batch always runs. */
static int prewarm_identity(char *line, int cap) {
    char rb[4400], rs[65], ps[65];
    const char *cd = sy_env("UNISACC_CACHE_DIR");
    if (cx_fmt(rb, sizeof rb, "%s/tests/run-batch.cx", root) || file_sha(rb, rs)) return -1;
    if (cx_fmt(rb, sizeof rb, "%s/unisacc.com", root) || file_sha(rb, ps)) return -1;
    return cx_fmt(line, cap, "run-batch=%s\tproduct=%s\tcompile_cache=%s\n", rs, ps, cd && cd[0] ? cd : "default");
}
static int prewarm_receipt(char *path, int cap) {
    char d[4400];
    if (prep_cache_dir(d, sizeof d)) return -1;
    return cx_fmt(path, cap, "%s/run-batch-prewarm.tsv", d);
}
static const char *compile_use(void) {
    char want[512], path[4400], *have; size_t n; int same;
    if (prewarm_identity(want, sizeof want) || prewarm_receipt(path, sizeof path)) return "unknown";
    have = cx_read(path, &n);
    if (!have) return "cold";
    same = (long)n == tx_len(want, sizeof want) && memcmp(have, want, n) == 0;
    free(have);
    return same ? "prewarmed" : "cold";
}
static int prewarm_compile(long *ms) {
    char bound[4400], product[4400], lim[8] = "40", line[512], path[4400]; Buf out = {0, 0, 0}; char *av[8]; int rc; long t0 = sy_now_ms();
    *ms = 0;
    if (cx_fmt(bound, sizeof bound, "%s/tools/bound", root) || root_candidate(product, sizeof product)) return 0;
    av[0] = bound; av[1] = lim; av[2] = "sh"; av[3] = product; av[4] = "tests/run-batch.cx"; av[5] = 0;
    rc = read_all(av, &out);
    *ms = sy_now_ms() - t0;
    if (rc != 2 || out.n != 0) { printf("PREWARM_FAILED\trun-batch\trc=%d\tstdout=%ld\n", rc, out.n); return 0; }   /* usage goes to stderr with rc 2; any stdout means it did more than stop */
    if (prewarm_identity(line, sizeof line) || prewarm_receipt(path, sizeof path)
        || cx_write(path, line, (size_t)tx_len(line, sizeof line))) { printf("PREWARM_FAILED\trun-batch\treceipt\n"); return 0; }
    printf("PREWARMED\trun-batch\t%.*s", (int)tx_len(line, sizeof line), line);
    return 1;
}
static void prebuild(const int *sel, int nsel) {
    int b, todo[PREP_MAX], ntodo = 0, nextt = 0, k, nact = 0, hits = 0, built = 0, failed = 0, deferred = 0; PJob job[PREP_PAR]; long t0 = sy_now_ms();
    if (prep_cache_dir(cachedir, sizeof cachedir)) die("path too long");
    {   char od[4400]; long n = tx_len(cachedir, sizeof cachedir), k; int r;   /* the cache directory, parents included */
        for (k = 1; k <= n; k++) if (k == n || cachedir[k] == '/') {
            if (tx_copy(od, sizeof od, cachedir, k)) die("path too long");
            r = sy_mkdir(od, 0755); if (r < 0 && r != -EEXIST) die("cannot make the prep-cache directory");
        } }
    { char pu[4400]; if (cx_fmt(pu, sizeof pu, "%s/unisacc.com", root) || file_sha(pu, prod_sha)) die("cannot hash unisacc.com"); }
    for (b = 0; b < nsel; b++) {
        const char *at = batch[sel[b]].materials; tp_material_decl d; int rc;
        if (tx_eqz(at, "-")) continue;
        while ((rc = tp_material_next(&at, &d)) > 0) { char why[200]; if (material_wanted(d.name)) (void)prep_plan(d.name, d.kind, why, sizeof why); }
    }
    if (prep_plan_only) {   /* identity only (id, cache hit or miss, cache path): a plan, never PREPARED */
        for (k = 0; k < nprep; k++) printf("PREP_PLAN\t%s\tid=%s\tcache=%s\tpath=%s%s%s\n", prep[k].name, prep[k].id, prep[k].state == PS_READY ? "hit" : "miss", prep[k].path, prep[k].via[0] ? "\tvia=" : "", prep[k].via);
        printf("PREP_PLAN_SUMMARY\tmaterials=%d\troot=%s\tcache_dir=%s\n", nprep, root, cachedir);
        fflush(stdout); exit(0);
    }
    for (k = 0; k < nprep; k++) { if (prep[k].state == PS_READY) hits++; else if (prep[k].kind != PK_SVAL && prep[k].kind != PK_SID) todo[ntodo++] = k; }
    while (nextt < ntodo || nact) {
        sy_pollfd_t fds[2 * PREP_PAR]; int who[2 * PREP_PAR], isout[2 * PREP_PAR], nf = 0, m;
        while (nact < PREP_PAR && nextt < ntodo) {
            Prep *P = &prep[todo[nextt]];
            if (sy_now_ms() - t_main >= PREP_BUDGET_MS) { P->state = PS_FAILED; cx_fmt(P->why, sizeof P->why, "prebuild-budget=%s", P->name); deferred++; nextt++; continue; }
            {   int sr = prep_start(&job[nact], todo[nextt]);
                if (sr == -2) { P->state = PS_FAILED; cx_fmt(P->why, sizeof P->why, "prebuild-budget=%s", P->name); deferred++; nextt++; continue; }
                if (sr < 0) { P->state = PS_FAILED; cx_fmt(P->why, sizeof P->why, "spawn-failed=%s", P->name); failed++; nextt++; continue; }
            }
            nact++; nextt++;
        }
        if (!nact) continue;
        for (k = 0; k < nact; k++) {
            if (job[k].ofd >= 0) { fds[nf].fd = job[k].ofd; fds[nf].events = SY_POLLIN; fds[nf].revents = 0; who[nf] = k; isout[nf++] = 1; }
            if (job[k].efd >= 0) { fds[nf].fd = job[k].efd; fds[nf].events = SY_POLLIN; fds[nf].revents = 0; who[nf] = k; isout[nf++] = 0; }
        }
        if (nf && sy_poll(fds, nf, 200) < 0) die("poll");
        for (m = 0; m < nf; m++) {
            int c = who[m]; char chunk[16384]; long r;
            if (!fds[m].revents) continue;
            r = sy_read(fds[m].fd, chunk, sizeof chunk);
            if (r > 0) { if ((isout[m] ? job[c].out.n : job[c].err.n) < 65536) put(isout[m] ? &job[c].out : &job[c].err, chunk, r); continue; }
            if (r == -EINTR || r == -EAGAIN) continue;
            sy_close(fds[m].fd);
            if (isout[m]) job[c].ofd = -1; else job[c].efd = -1;
        }
        for (k = 0; k < nact; k++) {
            int ex = 0, code = 0, sig = 0, over = sy_now_ms() - job[k].t0 > (job[k].secs + 3) * 1000L;
            if (over && (job[k].ofd >= 0 || job[k].efd >= 0)) {
                char rep[128]; (void)kill_tree(job[k].pid, 0, 0, rep, sizeof rep);
                if (job[k].ofd >= 0) sy_close(job[k].ofd);
                if (job[k].efd >= 0) sy_close(job[k].efd);
                job[k].ofd = job[k].efd = -1;
                cx_fmt(prep[job[k].job].why, sizeof prep[0].why, "build-timeout-%ds=%s", job[k].secs, prep[job[k].job].name);
                (void)sy_wait_status(job[k].pid, 0, &ex, &code, &sig); prep_done(&job[k], 0); failed++;
                job[k] = job[nact - 1]; nact--; k--; continue;
            }
            if (job[k].ofd >= 0 || job[k].efd >= 0) continue;
            if (sy_wait_status(job[k].pid, 0, &ex, &code, &sig) < 0) { ex = 1; code = 255; }
            if (ex && code == 0) prep_done(&job[k], 1);
            else { cx_fmt(prep[job[k].job].why, sizeof prep[0].why, "build-failed=%s:rc=%d", prep[job[k].job].name, ex ? code : 128 + sig); prep_done(&job[k], 0); }
            if (prep[job[k].job].state == PS_READY) built++; else { failed++; if (job[k].err.n) fprintf(stderr, "%.*s", (int)(job[k].err.n > 2000 ? 2000 : job[k].err.n), job[k].err.p); }
            job[k] = job[nact - 1]; nact--; k--;
        }
    }
    for (k = 0; k < nprep; k++) if (prep[k].kind == PK_SVAL || prep[k].kind == PK_SID) { if (prep_derive(&prep[k])) failed++; else built++; }
    for (k = 0; k < nprep; k++)
        if (prep[k].state == PS_READY && prep[k].kind == PK_HOST) prep_print("PREPARED\t%s\tid=%s\tsha256=%s\tcache=%s\tms=%ld\tpath=%s\tversion=%s\tvia=%s\n", prep[k].name, prep[k].id, prep[k].sha, "hit", 0L, prep[k].path, prep[k].ver, prep[k].via);
        else if (prep[k].state == PS_READY) prep_print("PREPARED\t%s\tid=%s\tsha256=%s\tcache=%s\tms=%ld\n", prep[k].name, prep[k].id, prep[k].sha, prep[k].cached ? "hit" : "built", prep[k].ms);
        else prep_print("PREP_FAILED\t%s\t%s\n", prep[k].name, prep[k].why);
    prep_print("PREBUILD\tmaterials=%d\thit=%d\tbuilt=%d\tfailed=%d\tdeferred=%d\telapsed_ms=%ld\n", nprep, hits, built, failed, deferred, sy_now_ms() - t0);
    pb_materials = nprep; pb_hits = hits; pb_built = built; pb_failed = failed + deferred;
}
static char prep_val[32][4400];
/* the material arguments of batch B, or a named reason */
static int prepare_materials(const Batch *B, const char **av, int *nav, char *why, int cap) {
    const char *at = B->materials; tp_material_decl d; int rc, n = 0;
    while ((rc = tp_material_next(&at, &d)) > 0) {
        int k = prep_find(d.name);
        if (n >= 32) { cx_fmt(why, cap, "too-many-materials"); return 1; }
        if (k < 0) { if (prep_plan(d.name, d.kind, why, cap) < 0) return 1; k = prep_find(d.name); }
        if (k < 0 || prep[k].state != PS_READY) { cx_fmt(why, cap, "%s", k >= 0 && prep[k].why[0] ? prep[k].why : "not-prepared"); return 1; }
        cx_fmt(prep_val[n], sizeof prep_val[0], "%s=%s", d.name, prep[k].path);
        av[*nav] = prep_val[n]; (*nav)++; n++;
    }
    if (rc < 0) { cx_fmt(why, cap, "materials-syntax"); return 1; }
    return 0;
}
/* tools/tlib.cx kit under a 40 s bound; its own PREPARED line (rebuilt=N) is forwarded, else a visible FAILED line. */
static void kit_prepare(void) {
    char bound[4400], product[4400], lim[8] = "40"; Buf out = {0, 0, 0}; char *av[8]; int rc, shown = 0; long i, e;
    if (cx_fmt(bound, sizeof bound, "%s/tools/bound", root) || root_candidate(product, sizeof product)) return;
    av[0] = bound; av[1] = lim; av[2] = "sh"; av[3] = product; av[4] = "tools/tlib.cx"; av[5] = "--"; av[6] = "kit"; av[7] = 0;
    rc = read_all(av, &out);
    for (i = 0; i < out.n; i = e + 1) {
        e = i; while (e < out.n && out.p[e] != '\n') e++;
        if (tx_prefix(out.p + i, e - i, "PREPARED\ttlib-kit", 17)) {
            long r = tx_find(out.p + i, e - i, "rebuilt=", 8);
            printf("%.*s\n", (int)(e - i), out.p + i); shown = 1;
            if (r >= 0 && r + 8 < e - i) kit_state = out.p[i + r + 8] == '0' && (r + 9 >= e - i || out.p[i + r + 9] < '0' || out.p[i + r + 9] > '9') ? "hit" : "built";
        }
    }
    if (!shown) printf("PREPARED\ttlib-kit\trebuilt=UNKNOWN\trc=%d\n", rc);
}
/* 每批的硬杀线 = 它自己的注册预算(batches.tsv 第 7 列)+ 2 秒收尾,而不是全局一个 42 秒:42 秒是 kit 重建
   要吃 40 秒那时代的数,kit 现在 <1 秒,留着只会把 45/55 秒预算的批白杀。总窗口仍是单命令 60 秒:
   窗口不够就如实 DEFERRED,注册预算本身不动。--hard-deadline-ms 是测试钩子,给了就按给的数。 */
static long window_end;
static int run(const int *sel, int nsel, int jobs) {
    refuse_expired_inherited_deadline();
    Child ch[MAXJOBS]; int nrun = 0, next = 0, pass = 0, fail = 0, deferred = 0, k, m;
    char runner[4400], candidate[4400];
    long t_start = sy_now_ms(), t0 = t_start, kit_ms = 0, prep_ms = 0; const char *cu = "unknown";
    window_end = t_start + (deadline_hook ? hard_deadline : 57000);   /* 60 秒总上限,留 3 秒收尾 */
    sy_child_subreaper();   /* orphans of a killed batch become our children, so the sweep can see them */
    if (cx_fmt(runner, sizeof runner, "%s/tests/run-batch.cx", root) || cx_fmt(candidate, sizeof candidate, "%s/unisacc.com", root)
        || cx_fmt(outparent, sizeof outparent, "%s/unisacc-affected-%d", sy_tmpdir(), sy_pid())) die("path too long");
    /* run-batch.cx accepts an output parent below ROOT/out or below sy_tmpdir()/unisacc-affected-; no repo-local out/ is created */
    if (sy_mkdir(outparent, 0755) < 0) die("cannot make unisacc-affected-PID");
    if(native_requested){
        native_ready=native_prepare(candidate);
        if(native_ready<0)die("NATIVE_RUNBATCH_IDENTITY_MISMATCH");
        if(!native_ready)fprintf(stderr,"NATIVE_RUNBATCH_FALLBACK\tprepare failed\n");
    }
    printf("RUN_DIR\t%s\tjobs=%d\n", outparent, jobs);
    {   long k0 = sy_now_ms();
        kit_prepare();   /* the tlib kit once, before any batch: -j N batches then find it fresh and link from it */
        kit_ms = sy_now_ms() - k0;
    }
    /* kit 与预建的时间都不从批次的 36/42 秒里扣:两个 deadline 在预建之后再计时。
       实测:kit 重建吃满 40 秒时,后面的批全被 start-deadline / killed-at-deadline 丢掉;
       预建(材料与首跑要用的编译缓存)同理,冷首跑多吃十几秒会把硬杀线吃掉。 */
    t0 = sy_now_ms(); t_main = t0;
    {   long p0 = sy_now_ms();
        if (prep_on) prebuild(sel, nsel);   /* materials first (bounded, up to PREP_PAR at once) */
        prep_ms = sy_now_ms() - p0;
    }
    if (prep_only) {   /* 只预热:不进批循环,不打 BATCH_RUN/PASS;材料只记 PREPARED */
        {   int k; for (k = 0; k < nprep; k++) if (prep[k].state == PS_READY)   /* 材料身份,供后续 --run 的 PREPARED 行核对 */
                printf("PREP_IDENTITY\t%s\tid=%s\tsha256=%s\tproduct=%s\tpath=%s\n", prep[k].name, prep[k].id, prep[k].sha, prod_sha, prep[k].path); }
        {   long pw_ms = 0; int pw = native_ready ? 1 : prewarm_compile(&pw_ms);
            printf("AFFECTED_PREP\tkit=%s\tmaterials=%d\tbuilt=%d\thit=%d\tfailed=%d\tkit_ms=%ld\tprep_ms=%ld\tcompile_prewarmed=%d\tprewarm_ms=%ld\n",
                   kit_state, pb_materials, pb_built, pb_hits, pb_failed, kit_ms, prep_ms, pw, pw_ms);
            return pb_failed || !pw ? 1 : 0; }
    }
    cu = compile_use();   /* 只是标记:批次照常全跑,编译缓存由产品按内容身份自核 */
    t_main = sy_now_ms();   /* 预建结束才起算:prep 已经计入 prep_ms,不再占批次的启动/硬杀窗口 */
    while (next < nsel || nrun) {
        sy_pollfd_t fds[2 * MAXJOBS]; int who[2 * MAXJOBS], isout[2 * MAXJOBS], nf = 0;
        long now = sy_now_ms();
        while (nrun < jobs && next < nsel && now - t_main < start_deadline) {
            Batch *B = &batch[sel[next]]; Child *C = &ch[nrun];
            const char *av[48] = {"sh", candidate, runner, "--"}; int nav = 4;
            if(native_ready){
                if(!native_intact())die("NATIVE_RUNBATCH_IDENTITY_MISMATCH");
                av[0]=native_runner;nav=1;
            }
            if (candidate_dir) { av[nav++] = "--candidate"; av[nav++] = candidate_dir; }
            av[nav++] = root; av[nav++] = outparent; av[nav++] = B->id;
            if (!tx_eqz(B->materials, "-")) {
                char why[200];
                if (!prep_on) { printf("DEFERRED\t%s\tneeds-materials=%s\n", B->id, B->materials); deferred++; next++; continue; }
                if (prepare_materials(B, av, &nav, why, sizeof why)) { printf("DEFERRED\t%s\tprepare-failed=%s\n", B->id, why); deferred++; next++; continue; }
                av[nav] = 0;
            }
            C->bi = sel[next]; C->out.p = 0; C->out.n = C->out.cap = 0; C->err = C->out;
            C->deadline = sy_now_ms() + (B->budget > 0 ? B->budget : 55) * 1000L + 2000;
            if (C->deadline > window_end) C->deadline = window_end;
            C->t_spawn = sy_now_ms();
            C->pid = sy_spawn_pipe(av, root, SY_SPAWN_STDERR_SPLIT, &C->ofd, &C->efd);
            next++;
            if (C->pid < 0) { printf("RUN_REFUSED\t%s\tspawn=%d\n", B->id, C->pid); fail++; continue; }
            nrun++;
        }
        if (next < nsel && now - t_main >= start_deadline) {
            for (; next < nsel; next++) { printf("DEFERRED\t%s\tstart-deadline\n", batch[sel[next]].id); deferred++; }
        }
        if (!nrun) continue;
        {   int any = 0;
            for (k = 0; k < nrun; k++) if (now >= ch[k].deadline) any = 1;
            if (any) {
                for (k = 0; k < nrun; k++) {
                    int keep[MAXJOBS], nkeep = 0; char rep[256];
                    if (now < ch[k].deadline) continue;
                    { int j; for (j = 0; j < nrun; j++) if (j != k) keep[nkeep++] = ch[j].pid; }
                    {   int sv = kill_tree(ch[k].pid, keep, nkeep, rep, sizeof rep);
                        if (ch[k].ofd >= 0) sy_close(ch[k].ofd);
                        if (ch[k].efd >= 0) sy_close(ch[k].efd);
                        if (sv > 0) printf("DEFERRED\t%s\tkilled-at-deadline\tresidue=%d\tsurvived=%s\n", batch[ch[k].bi].id, sv, rep);
                        else printf("DEFERRED\t%s\tkilled-at-deadline\n", batch[ch[k].bi].id);
                        bt_killed(batch[ch[k].bi].id, sy_now_ms() - ch[k].t_spawn);
                        deferred++;
                    }
                    ch[k] = ch[nrun - 1]; nrun--; k--;
                }
                continue;
            }
        }
        if (now >= window_end) {   /* 单命令窗口用尽:剩的不再启动,如实 DEFERRED */
            for (; next < nsel; next++) { printf("DEFERRED\t%s\tstart-deadline\n", batch[sel[next]].id); deferred++; }
        }
        for (k = 0; k < nrun; k++) {
            if (ch[k].ofd >= 0) { fds[nf].fd = ch[k].ofd; fds[nf].events = SY_POLLIN; fds[nf].revents = 0; who[nf] = k; isout[nf++] = 1; }
            if (ch[k].efd >= 0) { fds[nf].fd = ch[k].efd; fds[nf].events = SY_POLLIN; fds[nf].revents = 0; who[nf] = k; isout[nf++] = 0; }
        }
        if (nf && sy_poll(fds, nf, 200) < 0) die("poll");
        for (m = 0; m < nf; m++) {
            int c = who[m]; char chunk[65536]; long r;
            if (!fds[m].revents) continue;
            r = sy_read(fds[m].fd, chunk, sizeof chunk);
            if (r > 0) { put(isout[m] ? &ch[c].out : &ch[c].err, chunk, r); continue; }
            if (r == -EINTR || r == -EAGAIN) continue;
            sy_close(fds[m].fd);
            if (isout[m]) ch[c].ofd = -1; else ch[c].efd = -1;
        }
        for (k = 0; k < nrun; k++) {   /* both pipes closed: reap and report */
            int ex = 0, code = 0, sig = 0;
            if (ch[k].ofd >= 0 || ch[k].efd >= 0) continue;
            if (sy_wait_status(ch[k].pid, 0, &ex, &code, &sig) < 0) { ex = 1; code = 255; }
            if (finish(&ch[k], ex, code, sig)) pass++; else fail++;
            ch[k] = ch[nrun - 1]; nrun--; k--;
        }
    }
    /* kit_use: prepared = the tlib kit reported rebuilt=0 (its own content/identity check passed, nothing rebuilt);
       rebuilt = identity mismatched and the kit was rebuilt here; unknown = no PREPARED line.  Never a test result. */
    printf("AFFECTED_RUN\tpass=%d\tfail=%d\tdeferred=%d\tnot_applicable=%d\telapsed_ms=%ld\tkit_ms=%ld\tprep_ms=%ld\trun_ms=%ld\tkit_use=%s\tcompile_use=%s\n",
           pass, fail, deferred, nna, sy_now_ms() - t_start, kit_ms, prep_ms, sy_now_ms() - t0 - prep_ms,
           tx_eqz(kit_state, "hit") ? "prepared" : tx_eqz(kit_state, "built") ? "rebuilt" : "unknown", cu);
    return fail ? 1 : deferred ? 3 : 0;
}

/* ---------- --users ---------- */
static int users(const char *file) {
    char *gv[] = {"git", "ls-files", "-s", "-z", "--", "*.cx", 0}; Buf list = {0, 0, 0}; long at = 0; int target, found = 0, scanned = 0;
    char abs[8192];
    if (file[0] == '/') { if (cx_fmt(abs, sizeof abs, "%s", file)) die("path too long"); }
    else if (cx_fmt(abs, sizeof abs, "%s/%s", root, file)) die("path too long");
    if (sy_exists(abs) != 1) { fprintf(stderr, "affected: --users: no file %s\n", file); return 2; }
    target = path_node(file, 1);
    if (read_all(gv, &list) != 0) die("git ls-files failed");
    while (at < list.n) {   /* "MODE SHA STAGE\tPATH\0" */
        char *e = list.p + at; long ln = tx_len(e, list.n - at), tab = tx_chr(e, ln, '\t');
        if (tab > 0 && !tx_prefix(e, ln, "120000", 6) && !tx_prefix(e + tab + 1, ln - tab - 1, "archive/", 8)) {
            int ni = path_node(e + tab + 1, 1);
            scanned++; epoch++;
            mark(ni, V_SOURCE);
            if (ni != target && node[target].mark == epoch) { printf("USER\t%s\n", e + tab + 1); found++; }
        }
        at += ln + 1;
    }
    printf("USERS_SUMMARY\tfile=%s\tusers=%d\tscanned=%d\n", display(target), found, scanned);
    return 0;
}

/* --iface-narrow (C4): a changed file that is a unit of a tlib package whose interface is the same before and
   after the change cannot change what a downstream unit compiles against; only its behaviour can differ.
   Batches that reach it through use edges only (use / literal-use / arg-use) and whose root neither sits
   beside it nor uses it directly are then printed as DEFERRED_BY_IFACE instead of AFFECTED: listed, counted,
   never silently dropped.  The interface is "the same" only when all three hold: build/layer-api/P.tsv and
   build/iface-hash.tsv are byte-equal to HEAD, tools/iface-hash.cx --check passes, and tools/layer-api.cx
   --check --pkg P passes on the work tree (manifest == what the source gives now).  Any other outcome,
   a changed file outside every package, --full, or --tier release keeps the full selection. */
static int iface_narrow, iface_full;
static const char *iface_verdict;   /* test hook: same|changed replaces the three probes, not the package lookup */
static int eqb(const char *a, const char *b, long n) { long i; for (i = 0; i < n; i++) if (a[i] != b[i]) return 0; return 1; }
/* the package whose layer-api manifest names REL in its file column, into PKG; 1 found, 0 none */
static int iface_pkg(const char *rel, char *pkg, long cap) {
    size_t tn, mn; char *t = cx_read("build/iface-hash.tsv", &tn), *m; long at = 0, rl = tx_len(rel, 4096); int found = 0;
    if (!t) return 0;
    while (at < (long)tn && !found) {
        long e = at, f[4], nf = 0, i;
        while (e < (long)tn && t[e] != '\n') e++;
        if (t[at] != '#' && e > at) {
            char src[600];
            f[nf++] = at;
            for (i = at; i < e && nf < 4; i++) if (t[i] == '\t') f[nf++] = i + 1;
            if (nf == 4 && e - f[3] < (long)sizeof src && f[1] - 1 - f[0] < cap) {
                for (i = 0; i < e - f[3]; i++) src[i] = t[f[3] + i];
                src[e - f[3]] = 0;
                m = cx_read(src, &mn);
                if (m) {
                    long a2 = 0;
                    while (a2 < (long)mn && !found) {
                        long e2 = a2, tabs = 0, s3 = -1, j;
                        while (e2 < (long)mn && m[e2] != '\n') e2++;
                        if (m[a2] != '#') for (j = a2; j < e2; j++) if (m[j] == '\t' && ++tabs == 3) { s3 = j + 1; break; }
                        if (s3 >= 0 && e2 - s3 == rl && eqb(m + s3, rel, rl)) found = 1;
                        a2 = e2 + 1;
                    }
                    free(m);
                    if (found) { for (i = 0; i < f[1] - 1 - f[0]; i++) pkg[i] = t[f[0] + i]; pkg[f[1] - 1 - f[0]] = 0; }
                }
            }
        }
        at = e + 1;
    }
    free(t);
    return found;
}
/* the line of TAB-table T (N bytes) whose first field is PKG: start in *S, length in *L; 1 found */
static int pkg_line(const char *t, long n, const char *pkg, long *s, long *l) {
    long pl = tx_len(pkg, 256), at = 0;
    while (at < n) {
        long e = at; while (e < n && t[e] != '\n') e++;
        if (e - at > pl && t[at + pl] == '\t' && eqb(t + at, pkg, pl)) { *s = at; *l = e - at; return 1; }
        at = e + 1;
    }
    return 0;
}
static int lines_eq(const char *a, long as, long al, const char *b, long bs, long bl) { return al == bl && eqb(a + as, b + bs, al); }
static char *iface_fresh; static size_t iface_fresh_n; static int iface_fresh_state;   /* 0 not run, 1 ok, -1 failed */
static const char *iface_stale;   /* test hook: this package's probe fails, every other package is "same" */
/* 1 when package PKG's interface is proven the same in HEAD and in the work tree; WHY names the probe that decided.
   Only PKG's own rows count: its layer-api table against HEAD, its iface-hash row against HEAD and against a recompute
   written to a private temp file (the shared build/iface-hash.tsv is never written), and layer-api --check --pkg PKG.
   Another package's stale table no longer turns narrowing off. */
static int iface_same(const char *pkg, const char **why) {
    char man[400], tmp[600]; Buf o = {0, 0, 0}, h = {0, 0, 0}; size_t tn = 0; char *t; long s1, l1, s2, l2, s3, l3;
    if (iface_stale) { if (tx_eqz(iface_stale, pkg)) { *why = "iface-hash-row"; return 0; } *why = "same"; return 1; }
    if (iface_verdict) { *why = "verdict-hook"; return tx_eqz(iface_verdict, "same"); }
    if (cx_fmt(man, sizeof man, "build/layer-api/%s.tsv", pkg)) { *why = "pkg-name"; return 0; }
    { char *v[] = {"git", "diff", "--quiet", "HEAD", "--", man, 0}; if (read_all(v, &o) != 0) { *why = "manifest-differs-from-HEAD"; return 0; } }
    if (iface_fresh_state == 0) {
        char *v[] = {"sh", (char*)root_product_relative, "tools/iface-hash.cx", "--", "--write", "--table", tmp, 0};
        iface_fresh_state = -1;
        if (!cx_fmt(tmp, sizeof tmp, "%s/unisacc-affected-ifh-%d.tsv", sy_tmpdir(), sy_pid()) && read_all(v, &o) == 0) {
            iface_fresh = cx_read(tmp, &iface_fresh_n); if (iface_fresh) iface_fresh_state = 1;
        }
        sy_unlink(tmp);
    }
    if (iface_fresh_state < 0) { *why = "iface-hash-recompute"; return 0; }
    t = cx_read("build/iface-hash.tsv", &tn);
    if (!t) { *why = "iface-hash-row"; return 0; }
    { char *v[] = {"git", "show", "HEAD:build/iface-hash.tsv", 0}; if (read_all(v, &h) != 0) { free(t); *why = "iface-hash-row"; return 0; } }
    if (!pkg_line(t, (long)tn, pkg, &s1, &l1) || !pkg_line(iface_fresh, (long)iface_fresh_n, pkg, &s2, &l2) || !pkg_line(h.p, h.n, pkg, &s3, &l3)
        || !lines_eq(t, s1, l1, iface_fresh, s2, l2) || !lines_eq(t, s1, l1, h.p, s3, l3)) { free(t); *why = "iface-hash-row"; return 0; }
    free(t);
    { char *v[] = {"sh", (char*)root_product_relative, "tools/layer-api.cx", "--", "--check", "--pkg", (char *)pkg, 0}; if (read_all(v, &o) != 0) { *why = "layer-api-check"; return 0; } }
    *why = "same"; return 1;
}
/* 1 when batch root REL sits in the directory of changed node CI or uses it directly (or cannot be told) */
static int iface_direct(const char *rel, int ci) {
    int ni = path_node(rel, 0), k; const char *a, *c = display(ci); long la, lc, da = -1, dc = -1, i;
    if (ni < 0 || !node[ni].parsed) return 1;
    for (k = 0; k < node[ni].nuse; k++) if (node[ni].use[k] == ci) return 1;
    a = display(ni); la = tx_len(a, 4096); lc = tx_len(c, 4096);
    for (i = 0; i < la; i++) if (a[i] == '/') da = i;
    for (i = 0; i < lc; i++) if (c[i] == '/') dc = i;
    return da >= 0 && da == dc && eqb(a, c, da);
}

/* --symbol-narrow SYMS (needs --iface-narrow on): SYMS is a comma list of functions whose bodies changed (signatures
   did not; a signature change is the package-level interface probe's job).  Of the batches iface narrowing keeps,
   only those whose source/entry use-closure contains a file calling one of SYMS (per tools/symindex.cx calls) stay
   AFFECTED; the rest print DEFERRED_BY_SYMBOL.  No symbol sites found, or an unparsed node, keeps the batch. */
static const char *sym_list;
static char sym_state[MAXNODE]; static int sym_stamp[MAXNODE], sym_cur, sym_on;
static int sym_reach(int ni) {
    int k;
    if (ni < 0 || sym_stamp[ni] == sym_cur) return 0;
    sym_stamp[ni] = sym_cur;
    if (sym_state[ni]) return 1;
    if (!node[ni].parsed) return 1;
    for (k = 0; k < node[ni].nuse; k++) if (sym_reach(node[ni].use[k])) return 1;
    return 0;
}
static int sym_batch(const char *src, const char *entry) {
    int ni = path_node(src, 0);
    sym_cur++;
    if (ni < 0 || sym_reach(ni)) return 1;
    if (tx_chr(entry, tx_len(entry, 4096), '{') < 0) { int ei = path_node(entry, 0); if (ei < 0 || sym_reach(ei)) return 1; }
    return 0;
}
/* mark every file calling a symbol of SYMS; returns the number of call sites (0 = cannot narrow) */
static int sym_load(const char *syms) {
    char *v[] = {"sh", (char*)root_product_relative, "tools/symindex.cx", "--", "calls", (char *)syms, "--tracked", 0}; Buf o = {0, 0, 0}; long at = 0; int n = 0;
    if (read_all(v, &o) != 0) return 0;
    while (at < o.n) {
        long ln = 0, c = 0;
        while (at + ln < o.n && o.p[at + ln] != '\n') ln++;
        while (c < ln && o.p[at + c] != ':' && o.p[at + c] != '\t') c++;
        if (c > 0 && c < ln && o.p[at + c] == ':' && o.p[at] != 'N' && o.p[at] != 'S' && c < 600) {
            char path[600]; long i; int ni;
            for (i = 0; i < c; i++) path[i] = o.p[at + i];
            path[c] = 0; ni = path_node(path, 0);
            if (ni >= 0) sym_state[ni] = 1;
            n++;
        }
        at += ln + 1;
    }
    return n;
}

static int closure_dump;
static int plan_on;   /* --plan: list only, each AFFECTED row gains reason= (which model/closure node or via) */
/* ---------- product-input declarations (tests/batch-product-inputs.tsv, see its header) ----------
   pi_kind[b]: 0 unchanged full-depth selection, 1 inferred near (exec table edges from the commit-tier
   closure only), 2 declared (near closure plus a change under one of pi_inputs[b] selects via=declared).
   A table with no data rows (or --no-product-inputs) leaves every batch at 0: output is the old bytes. */
static const char *pi_path = "tests/batch-product-inputs.tsv";
static int pi_off, pi_rows, pi_kind[MAXBATCH]; static char *pi_inputs[MAXBATCH];
static int pi_ndecl, pi_nnear, pi_narrowed, pi_dhits;
static int pi_list_has(const char *list, const char *s, long n) {   /* comma list LIST holds exactly S[0..n) */
    const char *p = list;
    while (*p) { long m = 0; while (p[m] && p[m] != ',') m++; if (m == n && tx_prefix(p, m, s, n)) return 1; p += m; if (*p) p++; }
    return 0;
}
static void pi_load(void) {
    size_t n; char *s; long at = 0; int b, bad = 0; char *req[64]; int nreq = 0; char *nearl = 0;
    char *idk[MAXBATCH], *idv[MAXBATCH]; int nid = 0;
    if (pi_off) return;
    s = cx_read(pi_path, &n);
    if (!s) { if (errno == ENOENT) return; fprintf(stderr, "affected: REFUSE product-inputs read %s errno=%d\n", pi_path, errno); exit(2); }
    while (at < (long)n) {
        long end = at; char *f[4]; int nf = 1;
        while (end < (long)n && s[end] != '\n') end++;
        if (end == (long)n) { fprintf(stderr, "affected: REFUSE product-inputs requires LF rows\n"); exit(2); }
        s[end] = 0;
        if (s[at] && s[at] != '#' && strcmp(s + at, "kind\tkey\tinputs\tbasis")) {
            char *q; f[0] = s + at;
            for (q = s + at; *q; q++) if (*q == '\t') { *q = 0; if (nf == 4) break; f[nf++] = q + 1; }
            if (nf != 4 || !f[1][0] || !f[2][0] || !f[3][0]) { fprintf(stderr, "affected: REFUSE product-inputs row shape near '%s'\n", f[0]); exit(2); }
            if (tx_eqz(f[0], "require")) { if (nreq == 64) die("product-inputs: too many require rows"); req[nreq++] = f[1]; }
            else if (tx_eqz(f[0], "near")) { if (nearl) die("product-inputs: one near row"); nearl = f[1]; }
            else if (tx_eqz(f[0], "id")) {
                int k; for (k = 0; k < nid; k++) if (tx_eqz(idk[k], f[1])) { fprintf(stderr, "BATCH_PRODUCT_INPUT_DUPLICATE\tid=%s\n", f[1]); exit(2); }
                if (tx_eqz(f[2], "-")) { fprintf(stderr, "affected: REFUSE product-inputs id row needs inputs\tid=%s\n", f[1]); exit(2); }
                idk[nid] = f[1]; idv[nid++] = f[2];
            } else { fprintf(stderr, "affected: REFUSE product-inputs kind '%s'\n", f[0]); exit(2); }
            pi_rows++;
        }
        at = end + 1;
    }
    if (!pi_rows) return;
    { int k; for (k = 0; k < nid; k++) { for (b = 0; b < nbatch && !tx_eqz(batch[b].id, idk[k]); b++) {}
        if (b == nbatch) { fprintf(stderr, "BATCH_PRODUCT_INPUT_UNKNOWN\tid=%s\n", idk[k]); bad = 1; } } }
    for (b = 0; b < nbatch; b++) {
        const char *a = batch[b].args; int k, need = -1, other = 0;
        for (k = 0; k < nid; k++) if (tx_eqz(idk[k], batch[b].id)) break;
        if (k < nid) { pi_kind[b] = 2; pi_inputs[b] = idv[k]; pi_ndecl++; continue; }
        if (!tx_eqz(a, "-")) while (*a) {
            long m = 0; int r; while (a[m] && a[m] != ';') m++;
            if (m > 1 && a[0] == '{' && a[m - 1] == '}') {
                for (r = 0; r < nreq; r++) if (tx_len(req[r], 256) == m && tx_prefix(a, m, req[r], m)) need = r;
                if (!nearl || !pi_list_has(nearl, a, m)) other = 1;
            }
            a += m; if (*a) a++;
        }
        if (need >= 0) { fprintf(stderr, "BATCH_PRODUCT_INPUT_UNDECLARED\tid=%s\tplaceholder=%s\taction=add an id row to %s\n", batch[b].id, req[need], pi_path); bad = 1; continue; }
        if (nearl && !other && tx_eqz(batch[b].materials, "-")) { pi_kind[b] = 1; pi_nnear++; }
    }
    if (bad) exit(2);
}
static int pi_declared_hit(int b, const int *changed, int nch, int *why) {   /* first changed file under a declared prefix */
    int k;
    if (pi_kind[b] != 2) return 0;
    for (k = 0; k < nch; k++) {
        int pass, known = sy_exists(node[changed[k]].key) == 1, q;
        /* a deleted product input still counts while the static table closure names it; a path that neither
           exists nor is a known table input is not a product input (check-affected unrelated-table-no-model-edge) */
        for (q = 0; !known && q < input_count; q++) if (input_node[q] == changed[k]) known = 1;
        if (!known) continue;   /* the resolved repo-relative name, then the spelling given (a symlinked tree resolves outside root) */
        for (pass = 0; pass < 2; pass++) {
            const char *d = pass ? node[changed[k]].given : display(changed[k]), *p = pi_inputs[b]; long dn;
            if (!d) continue;
            while (d[0] == '.' && d[1] == '/') d += 2;
            dn = tx_len(d, 8192);
            while (*p) { long m = 0; while (p[m] && p[m] != ',') m++;
                if (m > 0 && dn >= m && tx_prefix(d, dn, p, m) && (p[m - 1] == '/' || dn == m || d[m] == '/')) { *why = changed[k]; return 1; }
                p += m; if (*p) p++; }
        }
    }
    return 0;
}
static int materials_dump;  /* --materials-dump: report each declared material's resolved source and stop */
/* --family-index emits every single-family query in one process. The same indexed lookup serves
   --family NAME; default and repeated-family union dumps retain registry row order byte for byte. */
static int family_index;
typedef struct { char *name; Buf rows; } DumpFamily;
static DumpFamily dump_family[MAXBATCH];
static int dump_slot[MAXBATCH * 2], dump_n;
static Buf dump_full;
static int dump_lookup(const char *name, int create) {
    unsigned h = 2166136261u; const unsigned char *s = (const unsigned char *)name; int slot, k;
    while (*s) h = (h ^ *s++) * 16777619u;
    slot = (int)(h % (MAXBATCH * 2));
    while ((k = dump_slot[slot]) != 0) {
        if (tx_eqz(dump_family[k - 1].name, name)) return k - 1;
        slot = (slot + 1) % (MAXBATCH * 2);
    }
    if (!create) return -1;
    if (dump_n == MAXBATCH) die("material-family-index-bound");
    k = dump_n++; dump_family[k].name = zkeep(name); dump_slot[slot] = k + 1; return k;
}
static void dump_add(const char *name, const char *line) {
    int k = dump_lookup(name, 1);
    puts_(&dump_family[k].rows, line); puts_(&dump_full, line);
}
static void dump_emit_family(const char *name) {
    int k = dump_lookup(name, 0);
    if (k >= 0) fwrite(dump_family[k].rows.p, 1, (size_t)dump_family[k].rows.n, stdout);
}
static const char *layer;   /* --layer NAME: see build/batch-packages.tsv */
static void usage(void) {
    fprintf(stderr, "usage: affected.cx -- (--since REV | --files F... | --ids ID... | --layer NAME) [--list-only | --run [-j N]] [--iface-narrow] [--full] | --users FILE | --closure-dump\n");
    exit(2);
}
int main(int argc, char **argv) {
    int a = 1, mode_run = 0, jobs = 0, nch = 0, nsel = 0, k, b, src = 0;
    static int changed[MAXNODE], sel[MAXBATCH];
    const char *since = 0;
    char **files = 0; int nfiles = 0;
    t_main = sy_now_ms();
    arena = ar_new(1L << 34);
    if (!arena) die("cannot create the arena");
    if (sy_is_reg("tests/batches.tsv") != 1 || sy_is_reg("tests/run-batch.cx") != 1) die("run from the repo root (tests/batches.tsv not found)");
    if (sy_realpath(".", root, sizeof root) < 0) die("cannot resolve the root");
    root_n = tx_len(root, sizeof root);
    if (argc == 3 && tx_eqz(argv[1], "--users")) return users(argv[2]);
    load_models();
    while (a < argc) {
        if (tx_eqz(argv[a], "--since") && a + 1 < argc) { since = argv[a + 1]; a += 2; src++; }
        else if (tx_eqz(argv[a], "--files") || tx_eqz(argv[a], "--ids")) {
            int ids = tx_eqz(argv[a], "--ids"), q2;
            files = argv + a + 1; nfiles = 0; a++;
            while (a < argc && !tx_prefix(argv[a], tx_len(argv[a], 4096), "--", 2)) { a++; nfiles++; }
            if (!nfiles) usage();
            if (ids) {   /* --ids also takes a comma-separated list, so a caller that joins DEFERRED names
                            (tools/affected-drain.cx does) needs no change.  The pieces go into a static array:
                            ARGV belongs to the caller, and inserting into it would walk over the next option. */
                static char *idsplit[MAXBATCH]; int nn = 0;
                for (q2 = 0; q2 < nfiles; q2++) {
                    char *s = files[q2];
                    while (*s && nn < MAXBATCH) {
                        idsplit[nn++] = s;
                        while (*s && *s != ',') s++;
                        if (*s == ',') *s++ = 0;
                    }
                }
                files = idsplit; nfiles = nn;
                if (!nfiles) usage();
            }
            src += ids ? 100 : 1;
        }
        else if (tx_eqz(argv[a], "--list-only")) { mode_run = 0; a++; }
        else if(tx_eqz(argv[a],"--domain-summary")){domain_on=1;a++;}
        else if(tx_eqz(argv[a],"--domain")&&a+1<argc){int k=bdom_kind(argv[a+1]);if(k<0){fprintf(stderr,"DOMAIN_REFUSE\treason=unknown-domain\tname=%s\n",argv[a+1]);return 2;}domain_on=domain_filter=1;domain_wanted[k]=1;a+=2;}
        else if (tx_eqz(argv[a], "--tier") && a + 1 < argc) { selected_tier = argv[a+1]; if (strcmp(selected_tier,"commit") && strcmp(selected_tier,"daily") && strcmp(selected_tier,"release")) usage(); lit_unlimited = strcmp(selected_tier, "commit") != 0; a += 2; }
        else if (tx_eqz(argv[a], "--closure-dump")) { closure_dump = 1; a++; }
        else if (tx_eqz(argv[a], "--plan")) { plan_on = 1; mode_run = 0; a++; }
        else if (tx_eqz(argv[a], "--no-product-inputs")) { pi_off = 1; a++; }
        else if (tx_eqz(argv[a], "--product-inputs") && a + 1 < argc) { pi_path = argv[a + 1]; a += 2; }
        else if (tx_eqz(argv[a], "--materials-dump")) { materials_dump = 1; a++; }
        else if (tx_eqz(argv[a], "--family-index")) { family_index = 1; a++; }
        else if (tx_eqz(argv[a], "--family") && a + 1 < argc) {
            if (nmaterial_family == MAXBATCH || !argv[a + 1][0] || tx_prefix(argv[a + 1], tx_len(argv[a + 1], 4096), "--", 2)) usage();
            material_family[nmaterial_family++] = argv[a + 1]; a += 2;
        }
        else if (tx_eqz(argv[a], "--layer") && a + 1 < argc) {
            static const char *known[] = {"base", "ext", "stream", "compiler", "driver", "chain", "release", "all", 0}; int q;
            layer = argv[a + 1]; a += 2;
            for (q = 0; known[q] && !tx_eqz(known[q], layer); q++) {}
            if (!known[q]) die("--layer: base|ext|stream|compiler|driver|chain|release|all");
        }
        else if (tx_eqz(argv[a], "--run")) { mode_run = 1; a++; }
        else if (tx_eqz(argv[a], "--candidate")) {
            if (candidate_dir || a+1 >= argc || argv[a+1][0] != '/') die("--candidate requires one absolute directory");
            candidate_dir = argv[a+1]; a += 2;
        }
        else if (tx_eqz(argv[a], "--prep-only")) { mode_run = 1; prep_only = 1; prep_on = 1; a++; }
        else if (tx_eqz(argv[a], "--prep-plan")) { mode_run = 1; prep_only = 1; prep_on = 1; prep_plan_only = 1; a++; }
        else if (tx_eqz(argv[a], "--iface-narrow")) { iface_narrow = 1; a++; }
        else if (tx_eqz(argv[a], "--full")) { iface_full = 1; a++; }
        else if (tx_eqz(argv[a], "--symbol-narrow") && a + 1 < argc) { sym_list = argv[a + 1]; a += 2; }
        else if (tx_eqz(argv[a], "--iface-stale") && a + 1 < argc) { iface_stale = argv[a + 1]; a += 2; }   /* test hook: one package's probe fails */
        else if (tx_eqz(argv[a], "--iface-verdict") && a + 1 < argc) {   /* test hook */
            iface_verdict = argv[a + 1]; a += 2;
            if (!tx_eqz(iface_verdict, "same") && !tx_eqz(iface_verdict, "changed")) usage();
        }
        else if (tx_eqz(argv[a], "--prepare-materials")) { prep_on = 1; a++; }
        else if (tx_eqz(argv[a], "--native-run-batch")) { native_requested=1; a++; }
        else if (tx_eqz(argv[a], "-j") && a + 1 < argc) { jobs = (int)parse_long(argv[a + 1], tx_len(argv[a + 1], 8)); if (jobs < 1 || jobs > MAXJOBS) die("-j N: 1..8"); a += 2; }
        else if (tx_eqz(argv[a], "--start-deadline-ms") && a + 1 < argc) {   /* test hook: start no batch after N ms */
            start_deadline = parse_long(argv[a + 1], tx_len(argv[a + 1], 8));
            if (start_deadline < 0 || start_deadline > 45000) die("--start-deadline-ms 0..45000");
            deadline_hook = 1; a += 2;
        }
        else if (tx_eqz(argv[a], "--hard-deadline-ms") && a + 1 < argc) {   /* test hook: kill what still runs after N ms */
            hard_deadline = parse_long(argv[a + 1], tx_len(argv[a + 1], 8));
            if (hard_deadline < 0 || hard_deadline > 54000) die("--hard-deadline-ms 0..54000");
            deadline_hook = 1; a += 2;
        }
        else usage();
    }
    if(candidate_dir && (!mode_run || prep_only || prep_plan_only))die("--candidate requires --run");
    if(native_requested && (!mode_run || prep_plan_only))die("--native-run-batch requires --run or --prep-only");
    if(domain_on&&(materials_dump||closure_dump||family_index||nmaterial_family))die("--domain supports --files, --since, --ids, --layer and domain-only selection");
    if(domain_on&&mode_run&&!jobs){int c=fa_budget();jobs=c<1?4:c>MAXJOBS?MAXJOBS:c;}
    if (materials_dump) {   /* the source each declared material resolves to.  The row is
                               MATERIAL<TAB>BATCH<TAB>NAME<TAB>SOURCE-or-'-'[<TAB>REFUSED=why] -- four
                               fields plus the reason on a refusal -- and with --prepare-materials it is the
                               built artifact's absolute cache path instead of a repo-relative source, so a
                               caller can hand it straight to run-batch without knowing the cache layout. */
        if ((src && src != 100) || mode_run || layer || closure_dump || (family_index && (nmaterial_family || prep_on))) usage();
        load_registry();
        for (k = 0; k < nfiles; k++) {
            for (b = 0; b < nbatch && !tx_eqz(batch[b].id, files[k]); b++) {}
            if (b == nbatch) { fprintf(stderr, "affected: REFUSE id %s is not an IMPLEMENTED SOURCE batch\n", files[k]); return 2; }
        }
        for (k = 0; k < nmaterial_family; k++) {
            int found = 0;
            for (b = 0; b < nbatch && !found; b++) {
                const char *at = batch[b].materials; tp_material_decl d;
                while (tp_material_next(&at, &d) > 0) if (tx_eqz(d.name, material_family[k])) { found = 1; break; }
            }
            if (!found) { fprintf(stderr, "affected: REFUSE family %s is not a declared material name\n", material_family[k]); return 2; }
        }
        for (b = 0; b < nbatch; b++) {
            if (src == 100) {
                for (k = 0; k < nfiles && !tx_eqz(batch[b].id, files[k]); k++) {}
                if (k == nfiles) continue;
            }
            sel[nsel++] = b;
        }
        if (prep_on) {   /* build first: the row must be what run-batch will be handed, not a plan; the
                            build reports go to stderr so this output stays one row per material. */
            /* Only selected batches and material names enter the prebuild plan. */
            prep_quiet = 1;
            prebuild(sel, nsel);
            prep_quiet = 0;
        }
        for (k = 0; k < nsel; k++) {
            const char *at; tp_material_decl d; int rc2;
            b = sel[k]; at = batch[b].materials;
            if (tx_eqz(at, "-")) continue;
            while ((rc2 = tp_material_next(&at, &d)) > 0) {
                char src[600], why[200], line[5200]; int fmt_rc;
                /* A single source query and the bulk query share the same complete family index.
                   Prepared dumps still plan only requested names; multi-family unions keep row order. */
                if (!material_wanted(d.name) && (prep_on || nmaterial_family != 1)) continue;
                why[0] = 0;
                if (prep_on) {
                    int k = prep_find(d.name);
                    if (k < 0) { (void)prep_plan(d.name, d.kind, why, (int)sizeof why); k = prep_find(d.name); }
                    if (k < 0) fmt_rc = cx_fmt(line, sizeof line, "MATERIAL\t%s\t%s\t-\tREFUSED=%s\n", batch[b].id, d.name, why);
                    else if (prep[k].state != PS_READY) fmt_rc = cx_fmt(line, sizeof line, "MATERIAL\t%s\t%s\t-\tREFUSED=%s\n", batch[b].id, d.name, prep[k].why);
                    else fmt_rc = cx_fmt(line, sizeof line, "MATERIAL\t%s\t%s\t%s\n", batch[b].id, d.name, prep[k].path);
                } else if (prep_source(d.name, d.kind, src, (long)sizeof src, why, (int)sizeof why))
                    fmt_rc = cx_fmt(line, sizeof line, "MATERIAL\t%s\t%s\t-\tREFUSED=%s\n", batch[b].id, d.name, why);
                else fmt_rc = cx_fmt(line, sizeof line, "MATERIAL\t%s\t%s\t%s\n", batch[b].id, d.name, src);
                if (fmt_rc) die("material-row-bound");
                dump_add(d.name, line);
            }
        }
        if (family_index) {
            for (k = 0; k < dump_n; k++) {
                printf("INDEX_BEGIN\t%s\n", dump_family[k].name);
                dump_emit_family(dump_family[k].name);
                printf("INDEX_END\t%s\n", dump_family[k].name);
            }
        } else if (nmaterial_family == 1) dump_emit_family(material_family[0]);
        else if (dump_full.n) fwrite(dump_full.p, 1, (size_t)dump_full.n, stdout);
        return 0;
    }
    if (nmaterial_family || family_index) usage();
    if (closure_dump) {   /* the facts tools/batch-packages-gen.cx builds build/batch-packages.tsv from */
        if (src || mode_run) usage();
        load_registry();
        for (b = 0; b < nbatch; b++) {
            int ni, d;
            mark_batch(&batch[b]);
            printf("B\t%s\t%s\t%s\t%s\n", batch[b].id, batch[b].tier, batch[b].materials, batch[b].source);
            for (ni = 0; ni < nnode; ni++) if (node[ni].mark == epoch) printf("C\t%s\t%s\t%s\n", batch[b].id, via_name[node[ni].via], display(ni));
            for (d = 0; d < ndirs; d++) printf("D\t%s\t%s\t%s\n", batch[b].id, via_name[dirvia[d]], display(dirs[d]));
        }
        printf("CLOSURE_SUMMARY\tbatches=%d\tfiles=%d\n", nbatch, nnode);
        return 0;
    }
    if(domain_on&&!src&&!layer){if(mode_run&&!domain_filter)die("--domain-summary --run needs a selection");load_registry();for(b=0;b<nbatch;b++){if(!domain_accept(b)||(selected_tier&&!tp_tier_includes(selected_tier,batch[b].tier)))continue;if(!host_allows(b))continue;sel[nsel++]=b;if(domain_filter)printf("SELECTED\t%s\n",batch[b].id);}domain_emit(sel,nsel);return mode_run?run(sel,nsel,jobs):0;}
    if (layer) {   /* coarse cut: the batches build/batch-packages.tsv puts in LAYER, plus layer `all` and every batch the table does not name */
        Buf projection={0,0,0}; char product[4400]; int own = 0, all = 0, missing = 0;
        if (src) usage();
        if(root_candidate(product,sizeof product))die("package query product path");
        char *query[]={"sh",product,"tools/batch-packages-gen.cx","--","--query",0};
        if(read_all(query,&projection) || !projection.n)die("batch package query failed");
        char *t=projection.p;size_t tn=projection.n;
        load_registry();
        for (b = 0; b < nbatch; b++) {
            char key[400]; long at, kl, ll = 0; const char *lay = "-";
            if(!domain_accept(b))continue;
            if(selected_tier && !tp_tier_includes(selected_tier,batch[b].tier))continue;
            if (cx_fmt(key, sizeof key, "\nbatch\t%s\t", batch[b].id)) die("id too long");
            kl = tx_len(key, sizeof key); at = tx_find(t, (long)tn, key, kl);
            if (at >= 0) { lay = t + at + kl; while (at + kl + ll < (long)tn && lay[ll] != '\t' && lay[ll] != '\n') ll++; }
            if (at >= 0 && !(ll == 3 && tx_prefix(lay, 3, "all", 3)) && !(ll == tx_len(layer, 64) && tx_prefix(lay, ll, layer, ll))) continue;
            if (!host_allows(b)) continue;   /* count after the platform filter, so own + all + unknown == batches */
            if (at < 0) missing++;
            else if (ll == 3 && tx_prefix(lay, 3, "all", 3)) all++;
            else own++;
            printf("LAYER\t%s\tlayer=%.*s\n", batch[b].id, at < 0 ? 7 : (int)ll, at < 0 ? "unknown" : lay);
            sel[nsel++] = b;
        }
        printf("LAYER_SUMMARY\tlayer=%s\tbatches=%d\town=%d\tall=%d\tunknown=%d\tscanned=%d\n", layer, nsel, own, all, missing, nbatch);
        domain_emit(sel,nsel);
        return mode_run ? run(sel, nsel, jobs) : 0;
    }
    if (src != 1 && src != 100) usage();
    /* 预建把 t_main 推到 prep 之后,这里不再收紧 start/hard:收紧只会把 45/55 秒预算的批白丢。 */
    { long r0 = sy_now_ms(); load_registry(); fprintf(stderr, "LIST_TIMING\tregistry_ms=%ld\n", sy_now_ms() - r0); }
    if (!jobs) { int c = fa_budget(); jobs = c < 1 ? 4 : c > MAXJOBS ? MAXJOBS : c; }
    if (src == 100) {   /* --ids: run (or list) exactly these */
        for (k = 0; k < nfiles; k++) {
            for (b = 0; b < nbatch && !tx_eqz(batch[b].id, files[k]); b++) {}
            if (b == nbatch) { fprintf(stderr, "affected: REFUSE id %s is not an IMPLEMENTED SOURCE batch\n", files[k]); return 2; }
            if(!domain_accept(b))continue;
            if(selected_tier && !tp_tier_includes(selected_tier,batch[b].tier))continue;
            if (!host_allows(b)) continue;
            sel[nsel++] = b;
            printf("SELECTED\t%s\n", batch[b].id);
        }
        domain_emit(sel,nsel);return mode_run ? run(sel, nsel, jobs) : 0;
    }
    if (since) {
        char *gv[] = {"git", "diff", "--name-only", "-z", (char *)since, "--", 0}; Buf o = {0, 0, 0}; long at = 0;
        if (read_all(gv, &o) != 0) die("git diff failed");
        while (at < o.n) {
            long ln = tx_len(o.p + at, o.n - at);
            if (ln > 0) { if (nch == MAXNODE) die("too many changed files"); changed[nch++] = path_node(o.p + at, 1); }
            at += ln + 1;
        }
    } else for (k = 0; k < nfiles; k++) changed[nch++] = path_node(files[k], 1);
    {   /* interface narrowing: off unless asked, never at --tier release, never with --full, and only when
           every changed file is a unit of a package whose interface is proven unchanged */
        const char *state = "off", *reason = "not-requested"; static char ipkg[128];
        if (iface_narrow) {
            if (iface_full) reason = "full";
            else if (selected_tier && tx_eqz(selected_tier, "release")) reason = "release-tier";
            else if (!nch) reason = "no-changed-file";
            else {
                state = "on"; reason = "same";
                for (k = 0; k < nch; k++) {
                    const char *w = "same";
                    if (!iface_pkg(display(changed[k]), ipkg, (long)sizeof ipkg)) { state = "off"; reason = "file-outside-packages"; break; }
                    if (!iface_same(ipkg, &w)) { state = "off"; if (tx_eqz(w, "verdict-hook")) reason = "interface-changed"; else { static char rb[300]; cx_fmt(rb, sizeof rb, "pkg=%s,probe=%s", ipkg, w); reason = rb; } break; }
                }
            }
            if (tx_eqz(state, "off")) iface_narrow = 0;
            if (iface_narrow && (iface_full || (selected_tier && tx_eqz(selected_tier, "release")))) die("iface narrowing reached a full-selection path");
            printf("IFACE_NARROW\tstate=%s\treason=%s\n", state, reason);
        }
        if (sym_list) {
            const char *sreason = "not-iface-narrowed";
            if (iface_narrow) { if (sym_load(sym_list) > 0) { sym_on = 1; sreason = "sites-found"; } else sreason = "no-call-sites"; }
            printf("SYMBOL_NARROW\tstate=%s\treason=%s\tsymbols=%s\n", sym_on ? "on" : "off", sreason, sym_list);
        }
    }
    pi_load();
    int ndefer = 0, nsymdefer = 0;
    {   long t_reg = sy_now_ms(), t_mark = 0, t_sweep = 0, t_match = 0, t0b, t1b; t_parse = 0; t_walk = 0;
        /* 分段耗时只写 stderr,给人与 tools/list-profile 用,不参与任何判定。 */
        for (b = 0; b < nbatch; b++) {
            if(!domain_accept(b))continue;
            if(selected_tier && !tp_tier_includes(selected_tier,batch[b].tier))continue;
            int why = -1, v, tsrc = -2, tmod = -1;
            char key[8400]; int slot = -1;
            if (cx_fmt(key, sizeof key, "%s\t%s\t%s", batch[b].source, batch[b].entry, batch[b].args)) die("key bound");
            t0b = sy_now_ms();
            if (!batch_has_guard(batch[b].id)) slot = bslot(key, 0);
            if (slot >= 0) { v = bv[slot]; why = bwhy[slot]; tsrc = bsrc[slot]; tmod = bmod[slot]; t1b = sy_now_ms(); t_mark += t1b - t0b; t0b = t1b; }
            else {
                mark_batch(&batch[b]);
                t1b = sy_now_ms(); t_mark += t1b - t0b; t0b = t1b;
                v = match(changed, nch, &why);
                t_match += sy_now_ms() - t0b;
                if (v == V_TABLE) tsrc = table_reason(why, &tmod);
                if (!batch_has_guard(batch[b].id) && (slot = bslot(key, 1)) >= 0) { bv[slot] = v; bwhy[slot] = why; bsrc[slot] = tsrc; bmod[slot] = tmod; }
            }
            if (pi_kind[b]) {   /* product-input narrowing: only table edges change; every other via keeps full depth */
                int deep = 0, deep_why = why, deep_src = tsrc, deep_mod = tmod;
                if (v == V_TABLE && lit_unlimited) {
                    int w2 = -1, v2; lit_unlimited = 0; mark_batch(&batch[b]); v2 = match(changed, nch, &w2); lit_unlimited = 1;
                    if (v2 == V_NONE) deep = 1; else { v = v2; why = w2; if (v == V_TABLE) tsrc = table_reason(why, &tmod); }
                }
                if ((v == V_NONE || deep) && pi_declared_hit(b, changed, nch, &why)) { v = V_DECL; deep = 0; pi_dhits++; }
                if (deep) {
                    pi_narrowed++;
                    if (plan_on) printf("NARROWED\t%s\twhy=%s\tvia=table\treason=deep-model:%s<-%s\n", batch[b].id, display(deep_why),
                        deep_mod >= 0 ? model_id[deep_mod] : "?", deep_src >= 0 ? display(deep_src) : deep_src == -1 ? "args" : "?");
                    continue;
                }
            }
            if (v == V_NONE) continue;
            /* 平台过滤在推迟之前:一台机器跑不了的批既不能被算进 selected,也不能被算进 DEFERRED/full=,否则
               「推迟」与「选不出」会互相掩盖。nna 记这些批,守恒式以它为两侧的同一基数。 */
            if (!host_allows(b)) continue;   /* host_allows 自己记 nna 并打印 NOT_APPLICABLE,这里不再加 */
            if (iface_narrow && (v == V_USE || v == V_LITUSE || v == V_ARGUSE) && !batch_has_guard(batch[b].id)
                && !iface_direct(batch[b].source, why)
                && (tx_chr(batch[b].entry, tx_len(batch[b].entry, 4096), '{') >= 0 || !iface_direct(batch[b].entry, why))) {
                printf("DEFERRED_BY_IFACE\t%s\twhy=%s\tvia=%s\treason=interface-unchanged\n", batch[b].id, display(why), via_name[v]);
                ndefer++; continue;
            }
            if (sym_on && (v == V_USE || v == V_LITUSE || v == V_ARGUSE) && !batch_has_guard(batch[b].id) && !sym_batch(batch[b].source, batch[b].entry)) {
                printf("DEFERRED_BY_SYMBOL\t%s\twhy=%s\tvia=%s\treason=symbol-unreferenced\n", batch[b].id, display(why), via_name[v]);
                nsymdefer++; continue;
            }
            /* 平台过滤已在上方做完(先过滤后推迟):这里不再重复,否则 nna 会双计。 */
            if (plan_on) {
                printf("AFFECTED\t%s\twhy=%s\tvia=%s\treason=", batch[b].id, display(why), via_name[v]);
                if (v == V_TABLE) printf("model:%s<-%s\n", tmod >= 0 ? model_id[tmod] : "?", tsrc >= 0 ? display(tsrc) : tsrc == -1 ? "args" : "?");
                else if (v == V_DECL) printf("declared:%s\n", pi_inputs[b]);
                else printf("%s:%s\n", via_name[v], display(why));
            } else printf("AFFECTED\t%s\twhy=%s\tvia=%s\n", batch[b].id, display(why), via_name[v]);
            sel[nsel++] = b;
        }
        t_sweep = sy_now_ms() - t_reg - t_mark - t_match;
        fprintf(stderr, "LIST_TIMING\tmark_ms=%ld\tmatch_ms=%ld\tsweep_ms=%ld\tbatches=%d\tnodes=%d\tchanged=%d\n",
                t_mark, t_match, t_sweep < 0 ? 0 : t_sweep, nbatch, nnode, nch);
        fprintf(stderr, "LIST_TIMING2\tparse_ms=%ld\twalk_ms=%ld\n", t_parse, t_walk);
    }
    if (iface_narrow) printf("DEFERRED_BY_IFACE_SUMMARY\tdeferred=%d\tselected=%d\tfull=%d\trerun=--full\n", ndefer, nsel + nsymdefer, ndefer + nsel + nsymdefer);
    if (sym_on) printf("DEFERRED_BY_SYMBOL_SUMMARY\tdeferred=%d\tselected=%d\tfull=%d\trerun=--full\n", nsymdefer, nsel, ndefer + nsymdefer + nsel);
    printf("AFFECTED_SUMMARY\tchanged=%d\tbatches=%d\tscanned=%d\tnot_applicable=%d\n", nch, nsel, nbatch, nna);
    if (pi_rows) printf("PRODUCT_INPUTS_SUMMARY\tdeclared=%d\tnear=%d\tnarrowed=%d\tdeclared_hits=%d\ttable=%s\n", pi_ndecl, pi_nnear, pi_narrowed, pi_dhits, pi_path);
    domain_emit(sel,nsel);
    return mode_run ? run(sel, nsel, jobs) : 0;
}
