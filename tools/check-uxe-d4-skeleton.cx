#pragma unisa use chrome_dom
#pragma unisa use text.fmt

typedef struct { double x,y,z; } Point;
static Point feet[4], probes[10];
static Point rest[4][3];
static int need[10];
static const int colors[][3]={{187,139,62},{119,74,49},{61,74,92},{185,63,49},{236,239,234}};
static const char *kinds[]={"joint","foot","chassis","witness","smoke"};
typedef struct { int kind; Point center; double w,h,d; } TownPart;
enum { HOUSE, CLOCK, GEAR, CRANE, SMOKE };
static const char *part_name[]={"house","clock","gear","crane","smoke"};
static TownPart town[24];
static int town_count, part_counts[5];
static double upper_mass, upper_x, upper_z;

static int survey_town(void) {
    size_t n=0;
    char *data=cx_read("ujs/practice/uxe/test/d4-town.tsv",&n);
    char *line=data?strchr(data,'\n'):0;
    int valid=line!=0;
    upper_mass=10.6*1.55*6.4+4.2;
    upper_x=3.62*4.2;
    upper_z=.02*4.2;
    while(line && line[1]) {
        char label[24];
        int i, v[6];
        TownPart *part;
        if(town_count>=24 || sscanf(line+1,"%23s %d %d %d %d %d %d",label,
            &v[0],&v[1],&v[2],&v[3],&v[4],&v[5])!=7) { valid=0; break; }
        for(i=0;i<5 && strcmp(label,part_name[i]);i++) {}
        if(i>=5 || v[3]<=0 || v[4]<=0 || v[5]<=0) { valid=0; break; }
        part=&town[town_count++];
        part_counts[i]++;
        *part=(TownPart){i,{v[0]/1000.0,v[1]/1000.0,v[2]/1000.0},
            v[3]/1000.0,v[4]/1000.0,v[5]/1000.0};
        if(i!=SMOKE) {
            double mass=part->w*part->h*part->d;
            upper_mass+=mass;
            upper_x+=mass*part->center.x;
            upper_z+=mass*part->center.z;
        }
        line=strchr(line+1,'\n');
    }
    if(data) free(data);
    return valid && part_counts[HOUSE]>=9;
}

static double twice_area(Point a,Point b,Point c) {
    return (b.x-a.x)*(c.z-a.z)-(b.z-a.z)*(c.x-a.x);
}

static int survey(void) {
    size_t n=0;
    char *spec=cx_read("ujs/practice/uxe/test/d4-legs.tsv",&n);
    char *line=spec?strchr(spec,'\n'):0;
    double mass=upper_mass;
    Point load={upper_x,0,upper_z};
    /* Nominal uniform-density box approximation for the upper structure. */
    int i,ok=1;
    for(i=0;i<4;i++) {
        char label[24];
        int p[9];
        if(!line || sscanf(line+1,"%23s %d %d %d %d %d %d %d %d %d",label,
            &p[0],&p[1],&p[2],&p[3],&p[4],&p[5],&p[6],&p[7],&p[8])!=10) { ok=0; break; }
        if(p[1]<=p[4] || p[4]<=p[7] || p[7]!=320) ok=0;
        {
            int j;
            for(j=0;j<3;j++) rest[i][j]=(Point){p[3*j]/1000.0,p[3*j+1]/1000.0,p[3*j+2]/1000.0};
        }
        feet[i]=(Point){p[6]/1000.0,p[7]/1000.0,p[8]/1000.0};
        probes[2*i]=(Point){p[3]/1000.0,p[4]/1000.0,p[5]/1000.0};
        probes[2*i+1]=(Point){feet[i].x,.16,feet[i].z+.62};
        /* The far-left knee lies behind the front skirt in this camera. */
        need[2*i]=i==0?2:0; need[2*i+1]=1;
        /* Equal nominal leg masses around each of the three pivots. */
        load.x+=(p[0]+p[3]+p[6])/1000.0;
        load.z+=(p[2]+p[5]+p[8])/1000.0;
        mass+=3;
        line=strchr(line+1,'\n');
    }
    if(spec) free(spec);
    if(!ok) return 0;
    load.x/=mass; load.z/=mass;
    for(i=0;i<4;i++) {
        if(twice_area(feet[i],feet[(i+1)%4],feet[(i+2)%4])<=0 ||
            twice_area(feet[i],feet[(i+1)%4],load)<=0) return 0;
    }
    printf("D4_SUPPORT\tcenter_x_mm=%d center_z_mm=%d inside=1 supports=4\n",(int)(load.x*1000),(int)(load.z*1000));
    probes[8]=(Point){.55,5.4,3.2}; need[8]=2;
    probes[9]=(Point){2.98,12.9,-1.99}; need[9]=4;
    return 1;
}

static int identify(int *rgb) {
    int i,j,best=-1,score=100000;
    int sum=rgb[0]+rgb[1]+rgb[2];
    if(sum<70) return -1;
    for(i=0;i<5;i++) {
        int total=colors[i][0]+colors[i][1]+colors[i][2], distance=0;
        for(j=0;j<3;j++) distance+=abs(1000*rgb[j]/sum-1000*colors[i][j]/total);
        if(distance<score) { score=distance; best=i; }
    }
    return score<=24?best:-1;
}

static double length_squared(Point a,Point b) {
    double dx=a.x-b.x,dy=a.y-b.y,dz=a.z-b.z;
    return dx*dx+dy*dy+dz*dz;
}

static int byte(const char **p) {
    int value=0;
    if(**p<'0'||**p>'9') return -1;
    while(**p>='0' && **p<='9') {
        value=value*10+**p-'0';
        if(value>255) return -1;
        *p=*p+1;
    }
    return value;
}

static int read_gait(const char *p, int walking) {
    int frame, leg, j, stance_fail=0, length_fail=0, air_fail=0, plant_fail=0;
    int swings[4]={0}, max_air=0;
    int frames=walking?97:48, slide_fail=0, seam_fail=0, forward_fail=0, ground_fail=0;
    Point previous[4], first[4];
    int planted[4]={0};
    double first_body=0, previous_body=0, advance=0, peak_lift=0, max_slide_sq=0;
    for(frame=0;frame<frames;frame++) {
        Point pose[4][3], support[4], center={upper_x,0,upper_z};
        int supports=0,air=0;
        double super_mass=upper_mass, body=0;
        for(leg=0;leg<4;leg++) for(j=0;j<3;j++) {
            double c[3];
            int axis;
            for(axis=0;axis<3;axis++) {
                int hi=byte(&p), lo;
                if(hi<0 || *p++!=',') return 2;
                lo=byte(&p);
                if(lo<0) return 2;
                if((frame!=frames-1 || leg!=3 || j!=2 || axis!=2) && *p++!=',') return 2;
                c[axis]=(hi*256+lo)/1024.0-16;
            }
            pose[leg][j]=(Point){c[0],c[1],c[2]};
            center.x+=c[0]; center.z+=c[2];
        }
        for(leg=0;leg<4;leg++) {
            Point foot=pose[leg][2];
            double lift=foot.y-rest[leg][2].y;
            int on_ground=foot.y<=rest[leg][2].y+.012;
            if(lift>peak_lift) peak_lift=lift;
            if(!frame) first[leg]=foot;
            if(walking && frame && on_ground && planted[leg]) {
                double slip_sq=length_squared(foot,previous[leg]);
                int slipped=slip_sq>.000009;
                if(slip_sq>max_slide_sq) max_slide_sq=slip_sq;
                slide_fail+=slipped;
                if(frame%48==0) seam_fail+=slipped;
            }
            if(walking && frame%48==0) {
                double expected=.48*(frame/48);
                Point landing=first[leg];
                landing.x+=expected;
                if(length_squared(foot,landing)>.000009) seam_fail++;
            }
            previous[leg]=foot;
            planted[leg]=on_ground;
            if(!on_ground) {
                air++; swings[leg]++;
            } else {
                support[supports++]=foot;
                if(!walking) plant_fail+=length_squared(foot,rest[leg][2])>.0002;
                else plant_fail+=foot.y<rest[leg][2].y-.012;
            }
            for(j=0;j<2;j++) {
                double reference=length_squared(rest[leg][j],rest[leg][j+1]);
                double actual=length_squared(pose[leg][j],pose[leg][j+1]);
                length_fail+=actual-reference>.025 || reference-actual>.025;
            }
            center.x+=super_mass*(pose[leg][0].x-rest[leg][0].x)/4;
            center.z+=super_mass*(pose[leg][0].z-rest[leg][0].z)/4;
            body+=(pose[leg][0].x-rest[leg][0].x)/4;
        }
        if(!frame) first_body=body;
        advance=body-first_body;
        if(walking && frame && frame%48==0) {
            double difference=advance-.48*(frame/48);
            forward_fail+=difference<-.003 || difference>.003;
            if(body-previous_body<-.4 || body-previous_body>.4) seam_fail++;
            for(leg=0;leg<4;leg++) {
                air_fail+=swings[leg]<4 || swings[leg]>10;
                swings[leg]=0;
            }
        }
        previous_body=body;
        center.x/=super_mass+12; center.z/=super_mass+12;
        if(air>max_air) max_air=air;
        air_fail+=air>1;
        int stable=supports>=3;
        for(j=0;stable && j<supports;j++) stable=twice_area(support[j],support[(j+1)%supports],center)>=0;
        stance_fail+=!stable;
    }
    if(walking) {
        for(frame=0;frame<9;frame++) {
            int rgb[3];
            if(*p++!=';') return 2;
            for(j=0;j<3;j++) {
                rgb[j]=byte(&p);
                if(rgb[j]<0 || (j<2 && *p++!=',')) return 2;
            }
            ground_fail+=rgb[0]<125 || rgb[0]<rgb[1]+50 || rgb[1]<rgb[2]+22;
        }
        if(strncmp(p,"</output>",9)) return 2;
        printf("D4_WALK frames=%d advance_mm=%d peak_lift_mm=%d max_slide_mm2=%d slide_fail=%d forward_fail=%d air_fail=%d seam_fail=%d stance_fail=%d length_fail=%d plant_fail=%d ground_fail=%d\n",
            frames,(int)(1000*advance+.5),(int)(1000*peak_lift+.5),(int)(1000000*max_slide_sq+.5),
            slide_fail,forward_fail,air_fail,seam_fail,
            stance_fail,length_fail,plant_fail,ground_fail);
        return slide_fail || forward_fail || air_fail || seam_fail || stance_fail || length_fail || plant_fail || ground_fail;
    }
    if(strncmp(p,"</output>",9)) return 2;
    for(leg=0;leg<4;leg++) if(swings[leg]<4 || swings[leg]>10) air_fail++;
    printf("D4_GAIT\tframes=48 max_air=%d stance_fail=%d length_fail=%d air_fail=%d plant_fail=%d swings=%d,%d,%d,%d\n",
        max_air,stance_fail,length_fail,air_fail,plant_fail,swings[0],swings[1],swings[2],swings[3]);
    return !!(stance_fail || length_fail || air_fail || plant_fail);
}

static void project(Point p,double *px,double *py) {
    double x=p.x-14.4,y=p.y-12,z=p.z-19.2;
    double ground=.6*x+.8*z, depth=-(24*ground+7*y)/25, up=(24*y-7*ground)/25;
    *px=640+576*(.8*x-.6*z)/depth;
    *py=360-576*up/depth;
}

static int read_framing(const char *p) {
    char *data;
    const char *line;
    size_t size=0;
    int width,height,ref_x0,ref_y0,ref_x1,ref_y1,ex,ey,ez,ty,focal;
    int i,min_x=1280,max_x=0,min_y=720,max_y=0;
    double ref_ratio,limit,actual,model_x0=1280,model_x1=0,model_y0=720,model_y1=0;
    double dx,dz,dy,horizontal,vertical_sin,vertical_cos,distance;
    data=cx_read("ujs/practice/uxe/test/d4-framing.tsv",&size);
    line=data?strchr(data,'\n'):0;
    i=line?sscanf(line+1,"%d %d %d %d %d %d %d %d %d %d %d",
        &width,&height,&ref_x0,&ref_y0,&ref_x1,&ref_y1,&ex,&ey,&ez,&ty,&focal):0;
    if(data) free(data);
    if(i!=11 || width!=1280 || height!=720 || ref_x0<0 || ref_y0<0 ||
        ref_x1>width || ref_y1>height || ref_x0>=ref_x1 || ref_y0>=ref_y1 || focal<=0) return 2;
    ref_ratio=(double)((ref_x1-ref_x0)*(ref_y1-ref_y0))/(width*height);
    limit=ref_ratio*.46;
    if(limit<.40) limit=.40;
    dx=ex/1000.0; dz=ez/1000.0; dy=(ey-ty)/1000.0;
    /* Nominal horizontal eye ratio is 3:4. This avoids depending on browser matrices. */
    if(ex<=0 || 4*ex!=3*ez) return 2;
    horizontal=dx*5/3;
    distance=horizontal;
    for(i=0;i<8;i++) distance=(distance+(horizontal*horizontal+dy*dy)/distance)/2;
    vertical_sin=dy/distance; vertical_cos=horizontal/distance;
    for(i=0;i<town_count+4;i++) {
        Point center;
        double w,h,d;
        int j;
        if(i<town_count) {
            TownPart part=town[i];
            if(part.kind==SMOKE) continue;
            center=part.center; w=part.w; h=part.h; d=part.d;
            if(part.kind==HOUSE || part.kind==CLOCK) center.y+=h/2;
        } else {
            center=feet[i-town_count]; w=1.42; h=.64; d=1.24;
        }
        for(j=0;j<8;j++) {
            double x=center.x+(j&1?w:-w)/2-dx, y=center.y+(j&2?h:-h)/2-ey/1000.0;
            double z=center.z+(j&4?d:-d)/2-dz, ground=.6*x+.8*z;
            double depth=-(vertical_cos*ground+vertical_sin*y), up=vertical_cos*y-vertical_sin*ground;
            double px,py;
            if(depth<=0) return 2;
            px=width/2+focal*(.8*x-.6*z)/depth;
            py=height/2-focal*up/depth;
            if(px<model_x0) model_x0=px;
            if(px>model_x1) model_x1=px;
            if(py<model_y0) model_y0=py;
            if(py>model_y1) model_y1=py;
        }
    }
    for(i=0;i<128*72;i++) {
        int rgb[3],j,x=5+(i%128)*10,y=5+(i/128)*10;
        for(j=0;j<3;j++) {
            rgb[j]=byte(&p);
            if(rgb[j]<0 || (j<2 && *p++!=',')) return 2;
        }
        if(i+1<128*72 && *p++!=';') return 2;
        /* Warm stone, steel, timber or ink. Exclude cool sky, green terrain and near-white smoke. */
        if((rgb[0]>rgb[1]+12 && rgb[1]>rgb[2]+8) ||
            (rgb[0]>12 && rgb[0]<110 && rgb[1]>rgb[0]+6 && rgb[2]>rgb[1]+9) ||
            (rgb[0]>115 && rgb[1]>105 && rgb[1]-rgb[2]>18 && rgb[0]>=rgb[1])) {
            if(x<min_x) min_x=x;
            if(x>max_x) max_x=x;
            if(y<min_y) min_y=y;
            if(y>max_y) max_y=y;
        }
    }
    if(strncmp(p,"</output>",9)) return 2;
    if(model_x0<0) model_x0=0;
    if(model_y0<0) model_y0=0;
    if(model_x1>width) model_x1=width;
    if(model_y1>height) model_y1=height;
    actual=max_x>=min_x && max_y>=min_y?(double)((max_x-min_x+10)*(max_y-min_y+10))/(width*height):0;
    double model=(model_x1-model_x0)*(model_y1-model_y0)/(width*height);
    int failed=model<limit || actual<limit;
    printf("D4_FRAMING\tref_permille=%d model_permille=%d actual_permille=%d min_permille=%d failed=%d\n",
        (int)(1000*ref_ratio),(int)(1000*model),(int)(1000*actual),(int)(1000*limit),failed);
    return failed;
}

static int tone(int r,int g,int b,const int *color) {
    return g>35 && abs(r*color[1]-g*color[0])<g*9 && abs(b*color[1]-g*color[2])<g*9;
}

static int read_town(const char *p) {
    static const int white[]={232,226,197}, roof[]={181,84,46}, gold[]={218,161,59};
    static const int dial[]={180,207,182}, lift[]={152,78,96}, smoke[]={236,239,234};
    int i,houses=0,gears=0,clocks=0,cranes=0,puffs=0,town_pixels=0,failed=0;
    double min_x=1280,max_x=0,min_y=720,max_y=0;
    double gear_x=0,gear_y=0,clock_x=0,clock_y=0,crane_x=0,crane_y=0,smoke_x=0,smoke_y=0;
    for(i=0;i<town_count;i++) {
        TownPart part=town[i];
        Point q=part.center;
        int k;
        if(part.kind==GEAR) project(q,&gear_x,&gear_y);
        if(part.kind==CLOCK) {
            q.y+=part.h-.92; q.z+=part.d/2;
            project(q,&clock_x,&clock_y);
        }
        if(part.kind==CRANE) project(q,&crane_x,&crane_y);
        if(part.kind==SMOKE && smoke_x==0) project(q,&smoke_x,&smoke_y);
        if(part.kind!=HOUSE && part.kind!=CLOCK) continue;
        for(k=0;k<8;k++) {
            double x,y;
            q=(Point){part.center.x+(k&1?1:-1)*part.w/2,
                part.center.y+(k&2?part.h:0),part.center.z+(k&4?1:-1)*part.d/2};
            project(q,&x,&y);
            if(x<min_x) min_x=x;
            if(x>max_x) max_x=x;
            if(y<min_y) min_y=y;
            if(y>max_y) max_y=y;
        }
    }
    for(i=0;i<128*72;i++) {
        int rgb[3],j,x=5+(i%128)*10,y=5+(i/128)*10;
        for(j=0;j<3;j++) {
            rgb[j]=byte(&p);
            if(rgb[j]<0 || (j<2 && *p++!=',')) return 2;
        }
        if(i+1<128*72 && *p++!=';') return 2;
        if(x>=min_x-12 && x<=max_x+12 && y>=min_y-16 && y<=max_y+8) {
            int tile=tone(rgb[0],rgb[1],rgb[2],roof);
            houses+=tile;
            town_pixels+=tile || tone(rgb[0],rgb[1],rgb[2],white);
        }
        if(x>gear_x-40 && x<gear_x+40 && y>gear_y-42 && y<gear_y+42)
            gears+=tone(rgb[0],rgb[1],rgb[2],gold);
        if(x>clock_x-20 && x<clock_x+20 && y>clock_y-20 && y<clock_y+20)
            clocks+=tone(rgb[0],rgb[1],rgb[2],dial);
        if(x>crane_x-52 && x<crane_x+52 && y>crane_y-14 && y<crane_y+55)
            cranes+=tone(rgb[0],rgb[1],rgb[2],lift);
        if(x>smoke_x-66 && x<smoke_x+66 && y>smoke_y-60 && y<smoke_y+60)
            puffs+=tone(rgb[0],rgb[1],rgb[2],smoke) && rgb[0]>156;
    }
    if(strncmp(p,"</output>",9)) return 2;
    failed+=part_counts[HOUSE]<9 || part_counts[CLOCK]!=1 || part_counts[GEAR]!=1 ||
        part_counts[CRANE]!=1 || part_counts[SMOKE]<4;
    failed+=town_pixels*100.0<(max_x-min_x)*(max_y-min_y)*.28;
    failed+=houses<30 || clocks<2 || cranes<4 || puffs<12;
    failed+=gears<7;
    printf("D4_DENSITY\thouses=%d roof_samples=%d occupied=%d/9216 gear=%d clock=%d crane=%d smoke=%d failed=%d\n",
        part_counts[HOUSE],houses,town_pixels,gears,clocks,cranes,puffs,failed);
    return !!failed;
}

static int patches[3][4];
static const char *surface_name[]={"wall","deck","metal"};
static int survey_finish(void) {
    size_t n=0;
    char *data=cx_read("ujs/practice/uxe/test/d4-finish.tsv",&n);
    char *line=data?strchr(data,'\n'):0;
    int i;
    for(i=0;i<3 && line;i++) {
        char name[20];
        int *q=patches[i];
        if(sscanf(line+1,"%19s %d %d %d %d",name,&q[0],&q[1],&q[2],&q[3])!=5 ||
            strcmp(name,surface_name[i]) || q[0]<0 || q[1]<0 || q[2]<1 ||
            q[3]<1 || q[2]>64 || q[3]>64 || q[0]+q[2]>1280 || q[1]+q[3]>720) break;
        line=strchr(line+1,'\n');
    }
    if(data) free(data);
    return i==3;
}

static int read_rgb(const char **p,int rgb[3]) {
    int i;
    for(i=0;i<3;i++) {
        rgb[i]=byte(p);
        if(rgb[i]<0) return 0;
        if(i<2) {
            if(**p!=',') return 0;
            *p=*p+1;
        }
    }
    return 1;
}

static int read_finish(const char *p) {
    static const int smoke[]={236,239,234}, wall[]={232,226,197}, deck[]={92,60,46};
    int i,k,failed=0,smoke_pixels=0,occupied[5]={0},bands=0;
    for(i=0;i<128*72;i++) {
        int rgb[3],x=i%128*10+5;
        if(!read_rgb(&p,rgb) || *p++!=';') return 2;
        if(i/128<26 && rgb[0]>138 && tone(rgb[0],rgb[1],rgb[2],smoke)) {
            smoke_pixels++;
            if(x>=480 && x<1080) occupied[(x-480)/120]++;
        }
    }
    for(i=0;i<5;i++) bands+=occupied[i]>=15;
    failed+=part_counts[SMOKE]<4 || bands<4 || smoke_pixels<190;
    printf("D4_SMOKE\tspec_clusters=%d visible_bands=%d upper_samples=%d/3328\n",part_counts[SMOKE],bands,smoke_pixels);
    for(k=0;k<3;k++) {
        int n=patches[k][2]*patches[k][3],count=0,levels=0,bins[86]={0};
        double total=0,sumsq=0,variance;
        for(i=0;i<n;i++) {
            int rgb[3],material,r;
            if(!read_rgb(&p,rgb) || ((k<2 || i+1<n) && *p++!=';')) return 2;
            r=rgb[0];
            if(k<2) material=tone(r,rgb[1],rgb[2],k==0?wall:deck);
            else material=r>60 && r<166 && abs(r-rgb[1])<31 && abs(r-rgb[2])<37;
            if(!material) continue;
            count++;
            total+=r; sumsq+=r*r;
            if(!bins[r/3]++) levels++;
        }
        variance=count?(sumsq-total*total/count)/count:0;
        failed+=count<n/4 || levels<5 || variance<12;
        printf("D4_TEXTURE\t%s samples=%d levels=%d variance=%d\n",surface_name[k],count,levels,(int)variance);
    }
    if(strncmp(p,"</output>",9)) return 2;
    printf("D4_FINISH\tfailed=%d\n",failed);
    return !!failed;
}

static int check_pose(const char *mode) {
    char cwd[1024],url[1600],profile[128],option[160],*out=0;
    size_t size=0;
    const char *p;
    char *args[]={"google-chrome","--headless=new","--use-angle=swiftshader",
        "--enable-unsafe-swiftshader","--allow-file-access-from-files","--window-size=1280,807",
        "--virtual-time-budget=3000","--no-first-run",option,"--dump-dom",url,0};
    int i,at,rc,failed=0;
    int walking=!strcmp(mode,"walk") || !strcmp(mode,"sliding-feet") || !strcmp(mode,"frozen-body");
    int gait=walking || !strcmp(mode,"gait") || !strcmp(mode,"three-air") || !strcmp(mode,"long-leg");
    int density=!strcmp(mode,"density") || !strcmp(mode,"small-town") || !strcmp(mode,"no-gear");
    int framing=!strcmp(mode,"framing") || !strcmp(mode,"wide-camera");
    int finish=!strcmp(mode,"finish") || !strcmp(mode,"no-texture") || !strcmp(mode,"single-smoke");
    if(!gait && !density && !framing && !finish && strcmp(mode,"normal") && strcmp(mode,"short-leg") && strcmp(mode,"no-deck")) return 2;
    if(!town_count && !survey_town()) { printf("FAIL D4_TOWN_DATA\n"); return 1; }
    if(!survey()) { printf("FAIL D4_SUPPORT\n"); return 1; }
    if(!getcwd(cwd,sizeof cwd)) return 2;
    at=tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/d4-skeleton.html?mode=%s&pixels=",cwd,mode);
    if(at<0 || at>=(int)sizeof url) return 2;
    for(i=0;walking && i<9;i++) {
        /* Project the center of the fixed marker's top with the nominal chase camera. */
        double x=-14.4-.12*i,y=.24-12,z=9-19.2;
        double ground=.6*x+.8*z, depth=-(24*ground+7*y)/25, up=(24*y-7*ground)/25;
        int px=(int)(640+576*(.8*x-.6*z)/depth),py=(int)(360-576*up/depth);
        int w=tx_snprintf(url+at,sizeof url-at,"%s%d,%d",i?";":"",px,py);
        if(w<0 || w>=(int)sizeof url-at || px<0 || px>=1280 || py<0 || py>=720) return 2;
        at+=w;
    }
    if(finish) {
        int w;
        if(!survey_finish()) return 2;
        w=tx_snprintf(url+at,sizeof url-at,"&patches=%d,%d,%d,%d;%d,%d,%d,%d;%d,%d,%d,%d",
            patches[0][0],patches[0][1],patches[0][2],patches[0][3],patches[1][0],patches[1][1],
            patches[1][2],patches[1][3],patches[2][0],patches[2][1],patches[2][2],patches[2][3]);
        if(w<0 || w>=(int)sizeof url-at) return 2;
    }
    for(i=0;!gait && !density && !framing && !finish && i<10;i++) {
        double x=probes[i].x-14.4,y=probes[i].y-12,z=probes[i].z-19.2;
        double ground=.6*x+.8*z, depth=-(24*ground+7*y)/25, up=(24*y-7*ground)/25;
        int px=(int)(640+576*(.8*x-.6*z)/depth),py=(int)(360-576*up/depth);
        int w=tx_snprintf(url+at,sizeof url-at,"%s%d,%d",i?";":"",px,py);
        if(w<0 || w>=(int)sizeof url-at || px<0 || px>=1280 || py<0 || py>=720) return 2;
        at+=w;
    }
    if(tx_snprintf(profile,sizeof profile,"/tmp/chrome-dom-d4-%d",(int)getpid())>=(int)sizeof profile ||
        tx_snprintf(option,sizeof option,"--user-data-dir=%s",profile)>=(int)sizeof option) return 2;
    rc=cx_runv_timeout(args,30,&out,&size);
    chd_wipe(profile);
    p=out?strstr(out,"<output id=\"pixels\">"):0;
    if(rc || !p) return 2;
    p+=strlen("<output id=\"pixels\">");
    if(gait || density || framing || finish) {
        rc=gait?read_gait(p,walking):density?read_town(p):framing?read_framing(p):read_finish(p);
        free(out);
        printf("CHECK_UXE_D4_SKELETON\tmode=%s failed=%d\n",mode,rc);
        return rc;
    }
    for(i=0;i<10;i++) {
        int c[3],j,observed;
        for(j=0;j<3;j++) {
            if(*p<'0'||*p>'9') return 2;
            c[j]=0;
            while(*p>='0'&&*p<='9') { c[j]=10*c[j]+*p++-'0'; if(c[j]>255) return 2; }
            if(j<2 && *p++!=',') return 2;
        }
        if(i<9 && *p++!=';') return 2;
        observed=identify(c);
        printf("%s sample=%d expected=%s rgb=%d,%d,%d got=%s\n",observed==need[i]?"PASS":"FAIL",
            i,kinds[need[i]],c[0],c[1],c[2],observed<0?"other":kinds[observed]);
        failed+=observed!=need[i];
    }
    if(strncmp(p,"</output>",9)) return 2;
    free(out);
    printf("CHECK_UXE_D4_SKELETON\tn=10 failed=%d mode=%s\n",failed,mode);
    return failed?1:0;
}

int main(int argc,char **argv) {
    int fixed, dynamic, density, framing, finish, walk;
    if(argc==2) return check_pose(argv[1]);
    if(argc!=1) return 2;
    fixed=check_pose("normal");
    dynamic=check_pose("gait");
    density=check_pose("density");
    framing=check_pose("framing");
    finish=check_pose("finish");
    walk=check_pose("walk");
    if(dynamic>fixed) fixed=dynamic;
    if(density>fixed) fixed=density;
    if(framing>fixed) fixed=framing;
    if(finish>fixed) fixed=finish;
    return fixed>walk?fixed:walk;
}
