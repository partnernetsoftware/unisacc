/* tools/check-kernel-context.cx -- the native-kernel context binds exactly what it should.
 *   sh ./unisacc.com tools/check-kernel-context.cx
 * Behavioral cases, all on copies; the tree is never modified:
 *   .S-byte-changes-context   one kernel .S sha differs -> context differs
 *   tests-file-ignored        no tests/ path is an input at all
 *   thin-head-ignored         unisacc.com (the launcher) is not an input
 *   context-tool-byte-change  each declared tool SHA must affect the context
 * Prints PASS/FAIL and KERNEL_CONTEXT<TAB>assertions=N<TAB>failed=M. */
#pragma unisa use cxlib.kernelinputs
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sys.io
#pragma unisa use text.text
static int assertions, failed;
static void ok(int c, const char *n) { assertions++; if (!c) failed++; printf("%s\t%s\n", c ? "PASS" : "FAIL", n); }
static int same(const char *a, const char *b) { long i = 0; if (!a || !b) return 0; while (a[i] && a[i] == b[i]) i++; return a[i] == b[i]; }
int main(void) {
    char root[4400], p[4600], ks[24][65], ts[6][65], ksum[65], body[4096], body2[4096];
    const char *tptr[6];
    int i;
    size_t n = 0;
    long bn = 0;
    if (sy_cwd(root, sizeof root) < 0) return 2;
    for (i = 0; i < 24; i++) { const char *f = ki_kernel_source(i); char *b; ks[i][0] = 0; if (!f) return 2; if (cx_fmt(p, sizeof p, "%s/%s", root, f)) return 2; b = cx_read(p, &n); if (!b) { printf("MISSING %s\n", p); return 2; } cx_sha256_hex(b, n, ks[i]); free(b); }
    for (i = 0; i < 6; i++) { const char *f = ki_context_file(i); char *b; ts[i][0] = 0; if (!f) return 2; if (cx_fmt(p, sizeof p, "%s/%s", root, f)) return 2; b = cx_read(p, &n); if (!b) { printf("MISSING %s\n", p); return 2; } cx_sha256_hex(b, n, ts[i]); free(b); }
    { const char *kptr[24]; for (i = 0; i < 6; i++) tptr[i] = ts[i]; for (i = 0; i < 24; i++) kptr[i] = ks[i]; ki_kernel_source_sha(kptr, ksum); bn = ki_context_body(body, sizeof body, ksum, tptr); if (bn < 0) return 2; }
    {   char k2[24][65]; for (i = 0; i < 24; i++) { long j; for (j = 0; j < 65; j++) k2[i][j] = ks[i][j]; }
        k2[0][0] = (k2[0][0] == '0') ? '1' : '0';
        { char ksum2[65]; const char *k2p[24]; for (i = 0; i < 24; i++) k2p[i] = k2[i]; ki_kernel_source_sha(k2p, ksum2); if (ki_context_body(body2, sizeof body2, ksum2, tptr) < 0) return 2; }
        ok(!same(body, body2), "S-byte-changes-context"); }
    {   int hit = 0;
        for (i = 0; i < 24; i++) if (tx_contains(ki_kernel_source(i), tx_len(ki_kernel_source(i),200), "tests/", 6)) hit = 1;
        for (i = 0; i < 6; i++) if (tx_contains(ki_context_file(i), tx_len(ki_context_file(i),200), "tests/", 6)) hit = 1;
        ok(!hit, "tests-file-ignored"); }
    {   int hit = 0;
        for (i = 0; i < 24; i++) if (tx_contains(ki_kernel_source(i), tx_len(ki_kernel_source(i),200), "unisacc.com", 11)) hit = 1;
        for (i = 0; i < 6; i++) if (tx_contains(ki_context_file(i), tx_len(ki_context_file(i),200), "unisacc.com", 11)) hit = 1;
        ok(!hit, "thin-head-ignored"); }
    for (i = 0; i < 6; i++) {
        char saved = ts[i][0];
        ts[i][0] = saved == '0' ? '1' : '0';
        if (ki_context_body(body2, sizeof body2, ksum, tptr) < 0) return 2;
        ok(!same(body, body2), ki_context_file(i));
        ts[i][0] = saved;
    }
    printf("KERNEL_CONTEXT\tassertions=%d\tfailed=%d\n", assertions, failed);
    return failed ? 1 : 0;
}
