/* From repository root: sh ./unisacc.com tools/check-gh-record.cx -- ; prints failed=N.
 * Uses an injected fake gh (a sh script in out/) and real files; no network, no credentials. */
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use sys.time
#pragma unisa use sysx.poll
#pragma unisa use sys.posix

static int failed;
static void ck(int ok, const char *name) { if (!ok) failed++; printf("%s\tgh-record.%s\n", ok ? "PASS" : "FAIL", name); }

static char dir[4096], tape[4400], fake[4400];

/* run gh-record with ARGS (NULL-terminated), capture stdout to *out; return exit code */
static int run(char **args, char **out) {
    char *av[40], buf[65536]; int i = 0, k, fd, pid, ex = 0, code = 0, sig = 0; long n = 0, g;
    av[i++] = "sh"; av[i++] = "./unisacc.com"; av[i++] = "tools/gh-record.cx"; av[i++] = "--";
    for (k = 0; args[k] && i < 39; k++) av[i++] = args[k];
    av[i] = 0;
    long deadline = sy_now_ms() + 50000;
    pid = sy_spawn_pipe(av, 0, 0, &fd, 0); if (pid < 0) return -1;
    for (;;) {
        sy_pollfd_t pf[1]; long left = deadline - sy_now_ms();
        if (left <= 0) { sy_killpg(pid, 9); sy_signal(pid, 9); break; }
        pf[0].fd = fd; pf[0].events = SY_POLLIN; pf[0].revents = 0;
        if (sy_poll(pf, 1, left > 200 ? 200 : left) < 0) break;
        if (pf[0].revents) { g = sy_read(fd, buf + n, sizeof buf - 1 - n); if (g <= 0) break; n += g; }
    }
    buf[n] = 0; sy_close(fd);
    if (sy_wait_status(pid, 0, &ex, &code, &sig) != pid) return -1;
    if (out) *out = strdup(buf);
    return ex ? code : 128 + sig;
}

int main(void) {
    char *o = 0; int rc;
    char p1[4400];
    if (cx_fmt(dir, sizeof dir, "%s/gh-record-%ld", sy_tmpdir(), (long)sy_now_ms())) return 2;
    sy_mkdir(dir, 0755);
    cx_fmt(tape, sizeof tape, "%s/tape", dir); cx_fmt(fake, sizeof fake, "%s/fake-gh.sh", dir);
    cx_fmt(p1, sizeof p1, "#!/bin/sh\nif [ \"$1\" = --version ]; then echo 'gh version 9.9.9 (fixture)'; exit 0; fi\n"
        "if [ \"$1\" = api ]; then echo '{\"message\":\"Not Found\"}'; exit 1; fi\necho \"view $*\"; echo tab\there; exit 0\n");
    if (cx_write(fake, p1, strlen(p1))) return 2;
    sy_chmod(fake, 0755);
    char gh[4500]; cx_fmt(gh, sizeof gh, "sh %s", fake);

    { char *a[] = { "record", "--tape", tape, "--gh", gh, "--", "release", "view", "v1", 0 };
      rc = run(a, &o); ck(rc == 0 && strstr(o, "RECORDED rc=0"), "record-ok"); }
    { char *a[] = { "record", "--tape", tape, "--gh", gh, "--", "api", "repos/x/y/releases/tags/v1", 0 };
      rc = run(a, &o); ck(rc == 0 && strstr(o, "RECORDED rc=1"), "record-nonzero-rc-kept"); }
    { char *a[] = { "replay", "--tape", tape, "--", "release", "view", "v1", 0 };
      rc = run(a, &o); ck(rc == 0 && !strcmp(o, "view release view v1\ntab here\n"), "roundtrip-stdout-rc"); }
    { char *a[] = { "replay", "--tape", tape, "--", "api", "repos/x/y/releases/tags/v1", 0 };
      rc = run(a, &o); ck(rc == 1 && !strcmp(o, "{\"message\":\"Not Found\"}\n"), "roundtrip-recorded-rc1"); }
    { char *a[] = { "replay", "--tape", tape, "--", "release", "view", "v2", 0 };
      rc = run(a, &o); ck(rc == 2, "no-tape-rc2"); }
    { char *a[] = { "replay", "--tape", tape, "--", "view", "release", "v1", 0 };
      rc = run(a, &o); ck(rc == 2, "argv-order-exact"); }
    { char *a[] = { "replay", "--tape", tape, "--", "release", "view", 0 };
      rc = run(a, &o); ck(rc == 2, "argv-prefix-no-match"); }
    { char *w[][8] = { { "release", "create", "v1", 0 }, { "release", "upload", "v1", "f", 0 }, { "release", "edit", "v1", 0 },
        { "release", "delete", "v1", 0 }, { "api", "-X", "POST", "x", 0 }, { "api", "--method", "PATCH", "x", 0 },
        { "api", "-XDELETE", "x", 0 }, { "api", "--method=PUT", "x", 0 }, { "api", "x", "-f", "a=b", 0 }, { "pr", "merge", "1", 0 } };
      int i, bad = 0;
      for (i = 0; i < 10; i++) {
          char *a[16]; int k = 0, j;
          a[k++] = "record"; a[k++] = "--tape"; a[k++] = tape; a[k++] = "--gh"; a[k++] = gh; a[k++] = "--";
          for (j = 0; w[i][j]; j++) a[k++] = w[i][j];
          a[k] = 0;
          if (run(a, &o) != 2) bad++;
      }
      ck(!bad, "write-class-refused-rc2"); }
    { char *a[] = { "replay", "--tape", tape, "--", "release", "delete", "v1", 0 };
      rc = run(a, &o); ck(rc == 2, "replay-write-class-refused"); }
    { char *a[] = { "api", "-X", "get", "x", 0 };
      char *b[] = { "record", "--tape", tape, "--gh", gh, "--", "api", "-X", "get", "x", 0 };
      (void)a; rc = run(b, &o); ck(rc == 0, "api-explicit-get-allowed"); }
    { char *a[] = { "record", "--tape", tape, "--gh", gh, "--day", "100", "--", "release", "view", "old", 0 };
      rc = run(a, &o); ck(rc == 0, "record-old-day"); }
    { char *a[] = { "replay", "--tape", tape, "--today", "131", "--", "release", "view", "old", 0 };
      rc = run(a, &o); ck(rc == 1, "stale-31-days-rc1"); }
    { char *a[] = { "replay", "--tape", tape, "--today", "130", "--", "release", "view", "old", 0 };
      rc = run(a, &o); ck(rc == 0, "fresh-30-days-ok"); }
    { char *a[] = { "replay", "--tape", tape, "--today", "131", "--max-age-days", "40", "--", "release", "view", "old", 0 };
      rc = run(a, &o); ck(rc == 0, "max-age-days-adjustable"); }
    printf("CHECK_GH_RECORD\tfailed=%d\n", failed);
    printf("failed=%d\n", failed);
    return failed ? 1 : 0;
}
