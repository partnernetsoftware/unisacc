/* tools/refactor.cx -- find, confirm, then apply mechanical call rewrites in parallel, each file
   verified against its own command and reverted on any difference (plans/refactor-tool-2026-10-30.md).

     sh ./unisacc.com tools/refactor.cx -- find [--auto] RULES FILE...   > CANDIDATES.tsv
     sh ./unisacc.com tools/refactor.cx -- apply CANDIDATES.tsv JOBS VERIFY...
     sh ./unisacc.com tools/refactor.cx -- sweep RULES JOBS (FILE... | --tracked) -- VERIFY...
     sh ./unisacc.com tools/refactor.cx -- rename [--auto] OLD NEW (FILE... | --tracked)   > CANDIDATES.tsv
     sh ./unisacc.com tools/refactor.cx -- sites NAME[,NAME...] (FILE... | --tracked)

   sweep is one resumable round of find --auto + apply (apply's deadline 36 s, so the whole call stays
   under 60 s): files apply SKIPs or REVERTs go on out/refactor-verify/skip-<rules path>.txt and are not
   retried; it ends with SWEEP ok= skip= revert= defer= remaining=N and exits 0 when nothing remains,
   3 when it should be called again, 1 on any revert.  Repeat the same call until it exits 0.

   RULES (TSV, '#' comments): id  call  prefix  argc  template  use  class  [context  [where]]
     call     the called name; prefix: the characters that must sit right before it ('-': none), replaced too;
     argc     top-level argument count; template: the replacement, $1..$9 the arguments (trimmed);
     use      a module the replacement needs ('-': none), e.g. text.text; class: safe | review;
     context  any (default) | truth: the call's value must be used only as a truth value -- the whole
              condition of if (...) / while (...), or an operand of && / || followed by ) && || ? ; , or :;
     where    '-' or $N=TEXT: argument N, trimmed, must be exactly TEXT (e.g. $3=1L << 20).
   CANDIDATES (TSV): verdict  file  offset  line  rule  class  why  original  replacement  use
     find writes verdict "accept" for safe rows under --auto, else "-"; apply takes only "accept" rows.
     Tabs, newlines and backslashes inside fields are written as \t \n \\.
   Scanning skips comments, string and character literals.  A match is downgraded to review when it
   spans lines or holds a comment, and to skip in reserved paths (ujs/ apps/csih/ archive/ kernel/
   src/ cx/) or when the needed module has no link beside the file (e.g. text/ for text.text).
   apply: per file, VERIFY (sh -c, {file} replaced) runs before the edit and after it; stdout, stderr
   and exit code must be byte-identical, otherwise the file is restored.  Every original must still
   sit at its offset, or the whole file is skipped.  Up to JOBS files are verified at once.
   Prints one line per file (OK | SKIP | REVERT) and REFACTOR<TAB>ok=..<TAB>skip=..<TAB>revert=..;
   rc 0 when nothing was reverted, 1 otherwise, 2 for usage or I/O. */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use mem.arena
#pragma unisa use text.text

#define CAP (1L << 24)
#define MAXRULE 64
#define MAXCAND 8192
#define MAXJOBS 16

static int arena;
static void die(const char *s) { fprintf(stderr, "refactor: %s\n", s); exit(2); }
static char *keep(const char *s, long n) { char *p = ar_dup(arena, s, n); if (!p) die("out of memory"); return p; }
static char *zdup(const char *s) { return keep(s, tx_len(s, CAP)); }

/* ---------- a growable output buffer in the arena ---------- */
typedef struct { char *p; long n, cap; } Buf;
static void put(Buf *b, const char *s, long n) {
    long i;
    if (b->n + n + 1 > b->cap) {
        long c = (b->n + n + 1) * 2; char *t = ar_alloc(arena, c);
        if (!t) die("out of memory");
        for (i = 0; i < b->n; i++) t[i] = b->p[i];
        b->p = t; b->cap = c;
    }
    for (i = 0; i < n; i++) b->p[b->n + i] = s[i];
    b->n += n; b->p[b->n] = 0;
}
static void puts_(Buf *b, const char *s) { put(b, s, tx_len(s, CAP)); }
/* a field with \t \n \\ escaped */
static void putesc(Buf *b, const char *s, long n) {
    long i;
    for (i = 0; i < n; i++) {
        if (s[i] == '\t') put(b, "\\t", 2); else if (s[i] == '\n') put(b, "\\n", 2);
        else if (s[i] == '\\') put(b, "\\\\", 2); else put(b, s + i, 1);
    }
}
static char *unesc(const char *s, long n, long *outn) {
    char *o = ar_alloc(arena, n + 1); long i, k = 0;
    if (!o) die("out of memory");
    for (i = 0; i < n; i++) {
        if (s[i] == '\\' && i + 1 < n) {
            i++; o[k++] = s[i] == 't' ? '\t' : s[i] == 'n' ? '\n' : s[i];
        } else o[k++] = s[i];
    }
    o[k] = 0; *outn = k; return o;
}

/* ---------- TSV rows ---------- */
static int split(char *line, char **f, int maxf) {
    int k = 0; char *p = line;
    f[k++] = p;
    while (*p) { if (*p == '\t') { *p = 0; if (k == maxf) return -1; f[k++] = p + 1; } p++; }
    return k;
}

/* ---------- rules ---------- */
typedef struct { char *id, *call, *prefix, *tmpl, *use, *cls, *where; int argc, truth, where_arg; } Rule;
static Rule rules[MAXRULE];
static int sites_mode;   /* sites: list call sites instead of candidate rows */
static int rename_rule = -1;   /* rename: the rule whose call is the identifier to rename, its template the new name */
static int nrules;
static void load_rules(const char *path) {
    size_t n; char *b = cx_read(path, &n), *line, *e, *f[10]; long i = 0; int nf;
    if (!b) die("cannot read the rules");
    while (i < (long)n) {
        line = b + i; e = line; while (*e && *e != '\n') e++;
        i = (long)(e - b) + 1; *e = 0;
        if (!*line || *line == '#') continue;
        nf = split(line, f, 10);
        if (nrules == MAXRULE || nf < 7 || nf > 9) die("rules: want 7 to 9 fields: id call prefix argc template use class [context [where]]");
        if (nf >= 8 && !tx_eq(f[7], "any", 8) && !tx_eq(f[7], "truth", 8)) die("rules: context is any or truth");
        rules[nrules].truth = nf >= 8 && tx_eq(f[7], "truth", 8);
        rules[nrules].where_arg = 0; rules[nrules].where = "";
        if (nf == 9 && !tx_eq(f[8], "-", 4)) {
            if (f[8][0] != '$' || f[8][1] < '1' || f[8][1] > '9' || f[8][2] != '=') die("rules: where is $N=TEXT or -");
            rules[nrules].where_arg = f[8][1] - '0'; rules[nrules].where = f[8] + 3;
        }
        rules[nrules].id = f[0]; rules[nrules].call = f[1];
        rules[nrules].prefix = tx_eq(f[2], "-", 4) ? "" : f[2];
        rules[nrules].argc = (int)strtol(f[3], 0, 10);
        rules[nrules].tmpl = f[4]; rules[nrules].use = f[5]; rules[nrules].cls = f[6];
        if (rules[nrules].argc < 0 || rules[nrules].argc > 9) die("rules: argc 0..9");
        nrules++;
    }
}

static int is_id(int c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || (c >= '0' && c <= '9'); }

static const char *reserved[] = {"ujs/", "apps/csih/", "archive/", "kernel/", "src/", "cx/", 0};
/* reserved paths belong to other lanes; the lane's owner opens its own with REFACTOR_ALLOW=PREFIX[:PREFIX...]
   (e.g. REFACTOR_ALLOW=cx/driver/ for the compiler lane).  ujs/ and archive/ stay closed. */
static int in_reserved(const char *path) {
    int k; long pl = tx_len(path, CAP); const char *al = sy_env("REFACTOR_ALLOW");
    if (al && !tx_prefix(path, pl, "ujs/", 4) && !tx_prefix(path, pl, "archive/", 8)) {
        while (*al) {
            const char *e = al; while (*e && *e != ':') e++;
            if (e > al && tx_prefix(path, pl, al, e - al)) return 0;
            al = *e ? e + 1 : e;
        }
    }
    for (k = 0; reserved[k]; k++) if (tx_prefix(path, pl, reserved[k], tx_len(reserved[k], 64))) return 1;
    return 0;
}
/* the module's first path component must be a directory (link) beside the file */
static int module_reachable(const char *file, const char *use) {
    char dir[4400], top[256]; long dl = tx_len(file, CAP), k = 0; sy_stat_t st;
    if (tx_eq(use, "-", 4)) return 1;
    while (dl > 0 && file[dl - 1] != '/') dl--;
    while (use[k] && use[k] != '.' && k < 255) { top[k] = use[k]; k++; }
    top[k] = 0;
    if (cx_fmt(dir, sizeof dir, "%.*s%s", (int)dl, file, top)) return 0;
    return sy_stat(dir, &st) == 0 && st.kind == 'd';
}
static int has_use(const char *src, long n, const char *use) {
    char needle[300];
    if (cx_fmt(needle, sizeof needle, "#pragma unisa use %s", use)) return 0;
    return tx_find(src, n, needle, tx_len(needle, 300)) >= 0;
}
/* the installed product refuses a unit with more than 32 uses ("more than 32 uses in one unit");
   the candidate allows 48.  Count the file's own #pragma unisa use lines. */
#define USE_LIMIT 32
static int count_uses(const char *src, long n) {
    long at = 0; int c = 0;
    while (at < n) { long k = tx_find(src + at, n - at, "#pragma unisa use ", 18); if (k < 0) break; c++; at += k + 18; }
    return c;
}

/* ---------- find ---------- */
static long skip_ws(const char *b, long i, long n) { while (i < n && (b[i] == ' ' || b[i] == '\t' || b[i] == '\n' || b[i] == '\r')) i++; return i; }
static long skip_ws_back(const char *b, long i) { while (i >= 0 && (b[i] == ' ' || b[i] == '\t' || b[i] == '\n' || b[i] == '\r')) i--; return i; }
/* 1 when b[ps..close] is used only as a truth value (see context in the header): what precedes it is
   && or || or the '(' of if / while, and what follows binds no tighter than && */
static int truth_context(const char *b, long n, long ps, long close) {
    long p = skip_ws_back(b, ps - 1), q = skip_ws(b, close + 1, n), k, e;
    int paren = 0;
    if (p >= 1 && ((b[p] == '&' && b[p - 1] == '&') || (b[p] == '|' && b[p - 1] == '|'))) {
        if (p >= 2 && (b[p - 2] == '&' || b[p - 2] == '|')) return 0;
    } else if (p >= 0 && b[p] == '(') {
        e = skip_ws_back(b, p - 1); k = e;
        while (k >= 0 && is_id((unsigned char)b[k])) k--;
        if (!tx_same(b + k + 1, e - k, "if", 2) && !tx_same(b + k + 1, e - k, "while", 5)) return 0;
        paren = 1;
    } else return 0;
    if (q >= n) return 0;
    if (b[q] == ')') return 1;
    if (q + 1 < n && ((b[q] == '&' && b[q + 1] == '&') || (b[q] == '|' && b[q + 1] == '|'))) return 1;
    if (paren) return 0;   /* if (call ? ...) and the like: leave to a person */
    return b[q] == '?' || b[q] == ';' || b[q] == ',' || b[q] == ':';
}

/* From the '(' at P, find the matching ')' and the top-level argument spans. -1 when unbalanced. */
static long parse_args(const char *b, long p, long n, long *as, long *ae, int *na, int *multiline, int *comment) {
    long i = p + 1, start = i; int depth = 0;
    *na = 0; *multiline = 0; *comment = 0;
    while (i < n) {
        char c = b[i];
        if (c == '\n') *multiline = 1;
        if (c == '/' && i + 1 < n && (b[i + 1] == '*' || b[i + 1] == '/')) { *comment = 1; return -1; }
        if (c == '"' || c == '\'') {
            char q = c; i++;
            while (i < n && b[i] != q) { if (b[i] == '\\') i++; if (i < n && b[i] == '\n') *multiline = 1; i++; }
            i++; continue;
        }
        if (c == '(' || c == '[' || c == '{') depth++;
        else if (c == ')' || c == ']' || c == '}') {
            if (depth == 0) {
                if (c != ')') return -1;
                if (i > start || *na > 0) { if (*na == 9) return -1; as[*na] = start; ae[*na] = i; (*na)++; }
                return i;
            }
            depth--;
        } else if (c == ',' && depth == 0) {
            if (*na == 9) return -1;
            as[*na] = start; ae[*na] = i; (*na)++; start = i + 1;
        }
        i++;
    }
    return -1;
}
static void trim(const char *b, long *s, long *e) {
    while (*s < *e && (b[*s] == ' ' || b[*s] == '\t' || b[*s] == '\n')) (*s)++;
    while (*e > *s && (b[*e - 1] == ' ' || b[*e - 1] == '\t' || b[*e - 1] == '\n')) (*e)--;
}
static void render(Buf *o, const char *tmpl, const char *b, long *as, long *ae) {
    long i, n = tx_len(tmpl, CAP);
    for (i = 0; i < n; i++) {
        if (tmpl[i] == '$' && i + 1 < n && tmpl[i + 1] >= '1' && tmpl[i + 1] <= '9') {
            int k = tmpl[i + 1] - '1'; long s = as[k], e = ae[k];
            trim(b, &s, &e); put(o, b + s, e - s); i++;
        } else put(o, tmpl + i, 1);
    }
}

static int find_file(Buf *out, const char *file, int autoacc) {
    size_t sz; char *b = cx_read(file, &sz); long n, i = 0, line = 1; int mode = 0, count = 0;
    if (!b) { fprintf(stderr, "refactor: cannot read %s\n", file); return -1; }
    n = (long)sz;
    while (i < n) {
        char c = b[i];
        if (c == '\n') line++;
        if (mode == 1) { if (c == '\n') mode = 0; i++; continue; }
        if (mode == 2) { if (c == '*' && i + 1 < n && b[i + 1] == '/') { mode = 0; i += 2; continue; } i++; continue; }
        if (mode == 3 || mode == 4) {
            if (c == '\\' && i + 1 < n) { i += 2; continue; }
            if ((mode == 3 && c == '"') || (mode == 4 && c == '\'')) mode = 0;
            i++; continue;
        }
        if (c == '/' && i + 1 < n && b[i + 1] == '/') { mode = 1; i += 2; continue; }
        if (c == '/' && i + 1 < n && b[i + 1] == '*') { mode = 2; i += 2; continue; }
        if (c == '"') { mode = 3; i++; continue; }
        if (c == '\'') { mode = 4; i++; continue; }
        if (is_id((unsigned char)c) && !(c >= '0' && c <= '9') && (i == 0 || !is_id((unsigned char)b[i - 1]))) {
            long a = i, j, k; int r;
            while (i < n && is_id((unsigned char)b[i])) i++;
            if (rename_rule >= 0 && tx_same(b + a, i - a, rules[rename_rule].call, tx_len(rules[rename_rule].call, 256))) {
                Rule *R = &rules[rename_rule]; char num[64]; const char *cls = in_reserved(file) ? "skip" : "safe";
                /* rename: the bare identifier anywhere outside comments and literals, as an apply row */
                puts_(out, autoacc && tx_eq(cls, "safe", 8) ? "accept" : "-"); put(out, "\t", 1);
                putesc(out, file, tx_len(file, CAP)); put(out, "\t", 1);
                if (cx_fmt(num, sizeof num, "%ld\t%ld\t", a, line)) die("format");
                puts_(out, num); puts_(out, R->id); put(out, "\t", 1); puts_(out, cls); put(out, "\t", 1);
                puts_(out, tx_eq(cls, "skip", 8) ? "reserved path" : "rename"); put(out, "\t", 1);
                putesc(out, b + a, i - a); put(out, "\t", 1); puts_(out, R->tmpl); put(out, "\t-\n", 3);
                count++;
                continue;
            }
            j = skip_ws(b, i, n);
            if (j >= n || b[j] != '(') continue;
            for (r = 0; r < nrules; r++) {
                Rule *R = &rules[r]; long pl = tx_len(R->prefix, 64), ps = a, close, as[9], ae[9];
                int na, ml, cm; const char *cls, *why; Buf rep = {0, 0, 0};
                if (!tx_same(b + a, i - a, R->call, tx_len(R->call, 256))) continue;
                if (pl) {
                    if (a < pl || !tx_same(b + a - pl, pl, R->prefix, pl)) continue;
                    ps = a - pl;
                    if (ps > 0 && (b[ps - 1] == '!' || b[ps - 1] == '=')) continue;   /* '!!x' or '!=': not this shape */
                }
                close = parse_args(b, j, n, as, ae, &na, &ml, &cm);
                if (close < 0 || (R->argc >= 0 && na != R->argc)) continue;
                if (R->truth && !truth_context(b, n, ps, close)) continue;
                if (sites_mode) {   /* FILE:LINE<TAB>the call; go on inside its arguments, so nested calls count too */
                    char num[32];
                    putesc(out, file, tx_len(file, CAP));
                    if (cx_fmt(num, sizeof num, ":%ld\t", line)) die("format");
                    puts_(out, num); putesc(out, b + ps, close + 1 - ps); put(out, "\n", 1);
                    for (k = i; k <= j; k++) if (b[k] == '\n') line++;
                    i = j + 1; count++;
                    break;
                }
                if (R->where_arg) {   /* that argument, trimmed, must be exactly the given text */
                    long ws = as[R->where_arg - 1], we = ae[R->where_arg - 1];
                    if (R->where_arg > na) continue;
                    trim(b, &ws, &we);
                    if (!tx_same(b + ws, we - ws, R->where, tx_len(R->where, 256))) continue;
                }
                render(&rep, R->tmpl, b, as, ae);
                cls = R->cls; why = "rule";
                if (ml) { cls = "review"; why = "spans lines"; }
                if (cm) { cls = "review"; why = "holds a comment"; }
                if (!tx_eq(R->use, "-", 4) && !has_use(b, n, R->use) && tx_find(b, n, "#pragma unisa module", 20) >= 0) {
                    /* a used module that gains a use: its dependents may then pull the same module in through
                       another link path, which the installed product counts twice; compiling the module alone
                       cannot show that */
                    cls = "review"; why = "module file would gain a use";
                }
                if (!tx_eq(R->use, "-", 4) && !has_use(b, n, R->use) && count_uses(b, n) >= USE_LIMIT) {
                    cls = "skip"; why = "a new use would pass the 32-use limit of the installed product";
                }
                if (!module_reachable(file, R->use)) { cls = "skip"; why = "no module link beside the file"; }
                if (in_reserved(file)) { cls = "skip"; why = "reserved path"; }
                {   char num[64];
                    puts_(out, autoacc && tx_eq(cls, "safe", 8) ? "accept" : "-"); put(out, "\t", 1);
                    putesc(out, file, tx_len(file, CAP)); put(out, "\t", 1);
                    if (cx_fmt(num, sizeof num, "%ld\t%ld\t", ps, line)) die("format");
                    puts_(out, num); puts_(out, R->id); put(out, "\t", 1); puts_(out, cls); put(out, "\t", 1);
                    puts_(out, why); put(out, "\t", 1);
                    putesc(out, b + ps, close + 1 - ps); put(out, "\t", 1);
                    putesc(out, rep.p ? rep.p : "", rep.n); put(out, "\t", 1);
                    puts_(out, R->use); put(out, "\n", 1);
                }
                for (k = j; k <= close; k++) if (b[k] == '\n') line++;
                i = close + 1; count++;
                break;
            }
            continue;
        }
        i++;
    }
    return count;
}

/* ---------- apply ---------- */
typedef struct { char *file; long off; char *orig, *rep, *use; long on, rn; } Cand;
static Cand cands[MAXCAND];
static int ncands;

static void load_cands(const char *path) {
    size_t n; char *b = cx_read(path, &n), *line, *e, *f[12]; long i = 0, fn;
    if (!b) die("cannot read the candidates");
    while (i < (long)n) {
        line = b + i; e = line; while (*e && *e != '\n') e++;
        i = (long)(e - b) + 1; *e = 0;
        if (!*line || *line == '#') continue;
        if (split(line, f, 12) != 10) die("candidates: want 10 fields");
        if (!tx_eq(f[0], "accept", 8)) continue;
        if (ncands == MAXCAND) die("too many candidates");
        cands[ncands].file = unesc(f[1], tx_len(f[1], CAP), &fn);
        cands[ncands].off = strtol(f[2], 0, 10);
        cands[ncands].orig = unesc(f[7], tx_len(f[7], CAP), &cands[ncands].on);
        cands[ncands].rep = unesc(f[8], tx_len(f[8], CAP), &cands[ncands].rn);
        cands[ncands].use = f[9];
        ncands++;
    }
}

typedef struct { char *file; int first, count; char *orig; size_t on; char *outb, *errb; int rc; char *out1, *out2, *expect; } Job;
/* one running VERIFY: started for a batch of files together, collected afterwards */
typedef struct { int pid, ofd, efd; } Run;

/* start VERIFY for FILE; -1 when it cannot start */
static int verify_start(const char *tmpl, const char *file, Run *r) {
    Buf cmd = {0, 0, 0}; long i, n = tx_len(tmpl, CAP), fl = tx_len(file, CAP); char *argv[4];
    for (i = 0; i < n; i++) {
        if (tmpl[i] == '{' && tx_prefix(tmpl + i, n - i, "{file}", 6)) { put(&cmd, file, fl); i += 5; }
        else put(&cmd, tmpl + i, 1);
    }
    if (sy_env("REFACTOR_DEBUG")) fprintf(stderr, "refactor-debug: start %s\n", cmd.p);
    {   char *bargv[6];   /* every check runs under the native watchdog, so one hang cannot hold the batch */
        bargv[0] = "./tools/bound"; bargv[1] = "50"; bargv[2] = "sh"; bargv[3] = "-c"; bargv[4] = cmd.p; bargv[5] = 0;
        (void)argv;
        r->pid = sy_spawn_pipe(bargv, 0, SY_SPAWN_STDERR_SPLIT, &r->ofd, &r->efd);
    }
    return r->pid < 0 ? -1 : 0;
}
/* collect a started VERIFY: stdout, stderr and the exit status (128+N for signal N); -1 on failure.
   stdout is drained first; a child that fills its stderr pipe before finishing stdout would wait,
   so VERIFY commands are expected to write their stderr after or in small amounts. */
static int verify_finish(Run *r, char **out, char **err, int *rc) {
    Buf o = {0, 0, 0}, e = {0, 0, 0}; char chunk[4096]; long k; int ex = 0, code = 0, sig = 0;
    while ((k = sy_read(r->ofd, chunk, sizeof chunk)) > 0) put(&o, chunk, k);
    while ((k = sy_read(r->efd, chunk, sizeof chunk)) > 0) put(&e, chunk, k);
    sy_close(r->ofd); sy_close(r->efd);
    if (sy_wait_status(r->pid, 0, &ex, &code, &sig) != r->pid) return -1;
    *out = o.p ? o.p : ""; *err = e.p ? e.p : ""; *rc = ex ? code : 128 + sig;
    if (sy_env("REFACTOR_DEBUG")) fprintf(stderr, "refactor-debug: finish rc=%d out=%ld err=%ld %.80s\n", *rc, o.n, e.n, *err);
    return 0;
}

/* ---------- --verify-from REGISTRY: the file's own registered batch as its check ---------- */
static char *reg_text; static size_t reg_n;
static char *reg_expect;   /* the matched row's expect field, e.g. rc0:MARKER */
static char root_abs[4096];
static int verify_seq;
/* append S single-quoted for sh */
static void put_quoted(Buf *b, const char *s, long n) {
    long i;
    put(b, "'", 1);
    for (i = 0; i < n; i++) { if (s[i] == '\'') puts_(b, "'\\''"); else put(b, s + i, 1); }
    put(b, "'", 1);
}
/* the command for FILE from its registered batch (mode SOURCE, entry or source == FILE), with
   {root} {candidate} {out} filled; *OUTP gets the fresh out path (masked before comparing).
   0 when FILE has no usable row (unregistered, or a material placeholder it cannot fill). */
static char *registry_cmd(const char *file, char **outp) {
    long i = 0, fl = tx_len(file, CAP);
    while (i < (long)reg_n) {
        char *line = reg_text + i, *e = line, *f[16]; long ln; int nf;
        while (*e && *e != '\n') e++;
        ln = e - line; i = (long)(e - reg_text) + 1;
        if (!ln || *line == '#') continue;
        {   char *row = keep(line, ln);
            nf = split(row, f, 16);
            if (nf != 12 || !tx_eq(f[1], "IMPLEMENTED", 16) || !tx_eq(f[4], "SOURCE", 8)) continue;
            if (!tx_same(f[8], tx_len(f[8], CAP), file, fl) && !tx_same(f[3], tx_len(f[3], CAP), file, fl)) continue;
            {   Buf c = {0, 0, 0}; char outdir[4400]; char *a = f[9]; long al = tx_len(a, CAP), s = 0, k;
                /* unique per process and call: a check that refuses an existing output must never see one */
                if (cx_fmt(outdir, sizeof outdir, "%s/out/refactor-verify/%d-%d", root_abs, sy_pid(), ++verify_seq)) return 0;
                reg_expect = zdup(f[11]);
                puts_(&c, "sh ./unisacc.com "); put_quoted(&c, f[8], tx_len(f[8], CAP));
                if (!tx_eq(a, "-", 4)) {
                    puts_(&c, " --");
                    for (k = 0; k <= al; k++) {
                        if (k == al || a[k] == ';') {
                            const char *tok = a + s; long tl = k - s; Buf t = {0, 0, 0}; long q;
                            for (q = 0; q < tl; q++) {
                                if (tok[q] == '{') {
                                    long r = q; while (r < tl && tok[r] != '}') r++;
                                    if (tx_same(tok + q, r - q + 1, "{root}", 6)) puts_(&t, root_abs);
                                    else if (tx_same(tok + q, r - q + 1, "{out}", 5)) puts_(&t, outdir);
                                    else if (tx_same(tok + q, r - q + 1, "{candidate}", 11)) { puts_(&t, root_abs); puts_(&t, "/unisacc.com"); }
                                    else return 0;   /* a material placeholder: cannot verify here */
                                    q = r;
                                } else put(&t, tok + q, 1);
                            }
                            put(&c, " ", 1); put_quoted(&c, t.p ? t.p : "", t.n);
                            s = k + 1;
                        }
                    }
                }
                *outp = zdup(outdir);
                return c.p;
            }
        }
    }
    return 0;
}
/* S with every occurrence of the fresh out path P replaced by "{out}" */
static char *mask_out(const char *s, const char *p) {
    Buf o = {0, 0, 0}; long n = tx_len(s, CAP), pl = p ? tx_len(p, 8192) : 0, i = 0;
    if (!pl) return (char *)s;
    while (i < n) {
        if (i + pl <= n && tx_same(s + i, pl, p, pl)) { puts_(&o, "{out}"); i += pl; }
        else { put(&o, s + i, 1); i++; }
    }
    return o.p ? o.p : "";
}

static int same_z(const char *a, const char *b) {
    long an = tx_len(a, CAP), bn = tx_len(b, CAP);
    return an == bn && tx_same(a, an, b, bn);
}

/* the edited bytes of job J (candidates sorted by offset), or 0 when an original is not at its offset */
static char *edited(Job *J, long *outn) {
    Buf o = {0, 0, 0}; long at = 0; int c; const char *use = 0;
    for (c = J->first; c < J->first + J->count; c++) {
        Cand *C = &cands[c];
        if (C->off < at || C->off + C->on > (long)J->on || !tx_same(J->orig + C->off, C->on, C->orig, C->on)) return 0;
        if (!tx_eq(C->use, "-", 4) && !has_use(J->orig, (long)J->on, C->use)) use = C->use;
        put(&o, J->orig + at, C->off - at); put(&o, C->rep, C->rn); at = C->off + C->on;
    }
    put(&o, J->orig + at, (long)J->on - at);
    if (use) {   /* add the use line after the last '#pragma unisa' line at the top, else first */
        Buf u = {0, 0, 0}; long p = 0, last = 0, ln;
        while (p < o.n) {
            long e2 = p; while (e2 < o.n && o.p[e2] != '\n') e2++;
            ln = e2 - p;
            if (tx_prefix(o.p + p, ln, "#pragma unisa", 13)) last = e2 + 1;
            else if (ln && o.p[p] != '/' && o.p[p] != ' ' && o.p[p] != '*' && last) break;
            p = e2 + 1;
        }
        put(&u, o.p, last); puts_(&u, "#pragma unisa use "); puts_(&u, use); put(&u, "\n", 1);
        put(&u, o.p + last, o.n - last);
        *outn = u.n; return u.p;
    }
    *outn = o.n; return o.p;
}

static long range_from = 0, range_count = -1;   /* --range A N: only files A..A+N-1 (in file order) */
static long deadline_ms = 48000;   /* no edit is started that its re-verify could not finish inside this */
static int apply(const char *candpath, int jobs, const char *verify) {
    static Job js[MAXCAND];
    int nj = 0, c, j, ok = 0, skip = 0, rev = 0;
    load_cands(candpath);
    /* group accepted candidates by file, sorted by offset (insertion into place) */
    for (c = 1; c < ncands; c++) {
        Cand t = cands[c]; int d = c - 1;
        while (d >= 0 && (tx_eq(cands[d].file, t.file, CAP) ? cands[d].off > t.off : 0)) { cands[d + 1] = cands[d]; d--; }
        cands[d + 1] = t;
    }
    for (c = 0; c < ncands; c++) {
        if (nj && tx_eq(js[nj - 1].file, cands[c].file, CAP)) { js[nj - 1].count++; continue; }
        js[nj].file = cands[c].file; js[nj].first = c; js[nj].count = 1; nj++;
    }
    if (range_count >= 0) {   /* keep only the requested slice of files, so one call fits its time bound */
        long a = range_from < nj ? range_from : nj, z = a + range_count < nj ? a + range_count : nj, q;
        for (q = a; q < z; q++) js[q - a] = js[q];
        nj = (int)(z - a);
        printf("RANGE\tfiles %ld..%ld\n", a, z - 1);
    }
    long t0 = sy_now_ms(), deferred = 0;
    for (j = 0; j < nj; j += jobs) {
        int k, end = j + jobs < nj ? j + jobs : nj, state[MAXJOBS];
        Run run[MAXJOBS], twin[MAXJOBS]; char *tw_out[MAXJOBS];
        long tb;
        if (sy_now_ms() - t0 > deadline_ms / 2) {   /* no time for another baseline + re-verify: leave the rest */
            for (k = j; k < nj; k++) printf("DEFER\t%s\tdeadline (run again with --range %d %d)\n", js[k].file, (int)(range_from + k), nj - k);
            deferred = nj - j;
            break;
        }
        tb = sy_now_ms();
        for (k = j; k < end; k++) {   /* baselines, each run twice at once: an unstable check cannot verify */
            Job *J = &js[k]; const char *cmd = verify, *cmd2 = verify;
            J->orig = cx_read(J->file, &J->on); J->out1 = J->out2 = 0; tw_out[k - j] = 0;
            if (!verify && (!(cmd = registry_cmd(J->file, &J->out1)) || !(cmd2 = registry_cmd(J->file, &tw_out[k - j])))) {
                printf("SKIP\t%s\tno registered SOURCE batch whose arguments can be filled\n", J->file); skip++;
                state[k - j] = -1; continue;
            }
            J->expect = verify ? 0 : reg_expect;
            state[k - j] = J->orig && verify_start(cmd, J->file, &run[k - j]) == 0 && verify_start(cmd2, J->file, &twin[k - j]) == 0;
        }
        for (k = j; k < end; k++) {
            Job *J = &js[k]; char *o3 = "", *e3 = ""; int rc3 = -1;
            if (state[k - j] < 0) continue;
            if (!state[k - j] || verify_finish(&run[k - j], &J->outb, &J->errb, &J->rc) < 0
                || verify_finish(&twin[k - j], &o3, &e3, &rc3) < 0) { state[k - j] = 0; continue; }
            if (rc3 != J->rc || !same_z(mask_out(o3, tw_out[k - j]), mask_out(J->outb, J->out1))
                || !same_z(mask_out(e3, tw_out[k - j]), mask_out(J->errb, J->out1))) {
                printf("SKIP\t%s\tits check is not stable (two unchanged runs differ)\n", J->file); skip++;
                state[k - j] = -1; continue;
            }
            /* a failing baseline proves nothing: equal failures before and after are not a verification */
            if (J->rc != 0) {
                printf("SKIP\t%s\tits check fails before any edit (rc %d)\n", J->file, J->rc); skip++;
                state[k - j] = -1; continue;
            }
            if (J->expect && tx_prefix(J->expect, tx_len(J->expect, 256), "rc0:", 4)) {
                const char *mk = J->expect + 4; long ml = tx_len(mk, 200);
                if (tx_find(J->outb, tx_len(J->outb, CAP), mk, ml) < 0) {
                    printf("SKIP\t%s\tits check does not print the registered marker %s\n", J->file, mk); skip++;
                    state[k - j] = -1; continue;
                }
            }
        }
        {   /* the re-verify takes about as long as the baselines did; never edit what could not be re-checked */
            long now = sy_now_ms(), base = now - tb;
            if (now - t0 + base + base / 2 > deadline_ms) {
                for (k = j; k < nj; k++) printf("DEFER\t%s\tdeadline before editing (run again with --range %d %d)\n", js[k].file, (int)(range_from + k), nj - k);
                deferred = nj - j;
                break;
            }
        }
        for (k = j; k < end; k++) {   /* edits, then every re-verify started together */
            Job *J = &js[k]; long nn; char *nb; const char *cmd = verify;
            if (state[k - j] < 0) { state[k - j] = 0; continue; }
            if (!state[k - j]) { printf("SKIP\t%s\tcannot read or run the baseline\n", J->file); skip++; continue; }
            nb = edited(J, &nn);
            if (!nb) { printf("SKIP\t%s\tan original is no longer at its offset\n", J->file); skip++; state[k - j] = 0; continue; }
            {   /* the original first goes to out/refactor-verify/backup/, so a killed run can be undone by hand */
                char bp[4400]; static int bseq; long q, fl = tx_len(J->file, CAP); Buf nm = {0, 0, 0};
                for (q = 0; q < fl; q++) put(&nm, J->file[q] == '/' ? "%" : J->file + q, 1);
                if (sy_mkdir("out/refactor-verify", 0700) < 0 && sy_exists("out/refactor-verify") != 1) die("cannot make out/refactor-verify");
                if (sy_mkdir("out/refactor-verify/backup", 0700) < 0 && sy_exists("out/refactor-verify/backup") != 1) die("cannot make the backup directory");
                if (cx_fmt(bp, sizeof bp, "out/refactor-verify/backup/%d-%d-%s", sy_pid(), ++bseq, nm.p)) die("backup path");
                if (cx_write(bp, J->orig, J->on) != 0) { printf("SKIP\t%s\tcannot write its backup\n", J->file); skip++; state[k - j] = 0; continue; }
            }
            if (cx_write(J->file, nb, (size_t)nn) != 0) { printf("SKIP\t%s\tcannot write\n", J->file); skip++; state[k - j] = 0; continue; }
            if (!verify) cmd = registry_cmd(J->file, &J->out2);
            if (!cmd || verify_start(cmd, J->file, &run[k - j]) < 0) state[k - j] = 2;
        }
        for (k = j; k < end; k++) {   /* compare; restore on any difference */
            Job *J = &js[k]; char *o2 = "", *e2 = ""; int rc2 = -1;
            if (!state[k - j]) continue;
            if (state[k - j] == 2 || verify_finish(&run[k - j], &o2, &e2, &rc2) < 0 || rc2 != J->rc
                || !same_z(mask_out(o2, J->out2), mask_out(J->outb, J->out1))
                || !same_z(mask_out(e2, J->out2), mask_out(J->errb, J->out1))) {
                if (cx_write(J->file, J->orig, J->on) != 0) die("cannot restore a file: stop");
                printf("REVERT\t%s\tverify differs (rc %d -> %d)\n", J->file, J->rc, rc2); rev++;
                continue;
            }
            printf("OK\t%s\t%d edits\n", J->file, J->count); ok++;
        }
    }
    printf("REFACTOR\tok=%d\tskip=%d\trevert=%d\tdefer=%ld\telapsed_ms=%ld\n", ok, skip, rev, deferred, sy_now_ms() - t0);
    return rev ? 1 : 0;
}

/* find_file over every tracked .cx file (symlinks skipped); -1 when one cannot be read */
static int scan_tracked(Buf *out, int autoacc) {
    char *gv[] = {"git", "ls-files", "-s", "-z", "--", "*.cx", 0}, chunk[65536]; int ofd, pid; long r, at = 0;
    Buf list = {0, 0, 0};
    pid = sy_spawn_pipe(gv, 0, 0, &ofd, 0);
    if (pid < 0) die("cannot run git ls-files");
    while ((r = sy_read(ofd, chunk, sizeof chunk)) > 0) put(&list, chunk, r);
    sy_close(ofd); sy_wait_status(pid, 0, 0, 0, 0);
    while (at < list.n) {   /* "MODE SHA STAGE\tPATH\0" */
        char *e = list.p + at; long ln = tx_len(e, list.n - at), tab = tx_chr(e, ln, '\t');
        if (ln < 0) break;
        if (tab > 0 && !tx_prefix(e, ln, "120000", 6) && find_file(out, e + tab + 1, autoacc) < 0) return -1;
        at += ln + 1;
    }
    return 0;
}

/* ---------- sweep: find + apply as one resumable round ---------- */
/* 1 when FILE is a line of the skip list S (n bytes) */
static int skipped(const char *s, long n, const char *file) {
    long at = 0, fl = tx_len(file, CAP);
    while (at < n) {
        long e = tx_chr(s + at, n - at, '\n'), ln = e < 0 ? n - at : e;
        if (tx_same(s + at, ln, file, fl)) return 1;
        at += ln + 1;
    }
    return 0;
}
/* the candidate rows (with header) for TARGETS minus the skip list; *accepted counts accept rows */
static void sweep_find(Buf *out, char **targets, int nt, int tracked, const char *sk, long skn, long *accepted) {
    Buf all = {0, 0, 0}; long at = 0;
    puts_(out, "# verdict\tfile\toffset\tline\trule\tclass\twhy\toriginal\treplacement\tuse\n");
    if (tracked) { if (scan_tracked(&all, 1) < 0) die("cannot scan the tracked files"); }
    else { int k; for (k = 0; k < nt; k++) if (find_file(&all, targets[k], 1) < 0) die("cannot read a target"); }
    *accepted = 0;
    while (at < all.n) {   /* drop rows of skip-listed files */
        char *l = all.p + at; long e = tx_chr(l, all.n - at, '\n'), ln = e < 0 ? all.n - at : e + 1, t1 = tx_chr(l, ln, '\t'), t2;
        char file[4400];
        t2 = t1 < 0 ? -1 : tx_chr(l + t1 + 1, ln - t1 - 1, '\t');
        if (t1 >= 0 && t2 >= 0 && t2 < (long)sizeof file && !tx_copy(file, sizeof file, l + t1 + 1, t2) && !skipped(sk, skn, file)) {
            put(out, l, ln);
            if (tx_prefix(l, ln, "accept\t", 7)) (*accepted)++;
        }
        at += ln;
    }
}
static int sweep(char **argv, int argc) {
    /* sweep RULES JOBS (FILE... | --tracked) -- CHECK...  */
    char skp[4400], cand[4400], *sk; size_t skn0; long skn, acc = 0, after = 0, k, dash = -1;
    Buf c = {0, 0, 0}, v = {0, 0, 0}, log = {0, 0, 0}, sl = {0, 0, 0}; int jobs, tracked, ok = 0, sk2 = 0, rev = 0, def = 0;
    for (k = 4; k < argc; k++) if (tx_eq(argv[k], "--", 4)) { dash = k; break; }
    if (dash < 0 || dash + 1 >= argc) die("sweep RULES JOBS (FILE... | --tracked) -- CHECK...");
    jobs = (int)strtol(argv[3], 0, 10);
    if (jobs < 1 || jobs > MAXJOBS) die("JOBS 1..16");
    load_rules(argv[2]);
    tracked = dash == 5 && tx_eq(argv[4], "--tracked", 16);
    {   long i; char *rb = zdup(argv[2]);   /* the skip list is per rules file: out/refactor-verify/skip-<rules path with / as _>.txt */
        for (i = 0; rb[i]; i++) if (rb[i] == '/') rb[i] = '_';
        sy_mkdir("out/refactor-verify", 0700);
        if (cx_fmt(skp, sizeof skp, "out/refactor-verify/skip-%s.txt", rb) || cx_fmt(cand, sizeof cand, "out/refactor-verify/sweep-%d.tsv", sy_pid())) die("path");
    }
    sk = cx_read(skp, &skn0); skn = sk ? (long)skn0 : 0; if (!sk) sk = "";
    sweep_find(&c, argv + 4, (int)(dash - 4), tracked, sk, skn, &acc);
    if (!acc) { printf("SWEEP\tok=0\tskip=0\trevert=0\tdefer=0\tremaining=0\tskip_list=%s\n", skp); return 0; }
    if (cx_write(cand, c.p, (size_t)c.n) != 0) die("cannot write the candidates");
    for (k = dash + 1; k < argc; k++) { if (k > dash + 1) put(&v, " ", 1); puts_(&v, argv[k]); }
    {   char jb[16], *av[10]; int ofd, pid; long r; char chunk[8192];
        if (cx_fmt(jb, sizeof jb, "%d", jobs)) die("format");
        av[0] = "sh"; av[1] = "./unisacc.com"; av[2] = "tools/refactor.cx"; av[3] = "--"; av[4] = "apply"; av[5] = cand; av[6] = jb; av[7] = v.p; av[8] = 0;
        sy_setenv("REFACTOR_DEADLINE_MS", "36000", 1);   /* two finds of the whole tree take up to about 10 s */
        pid = sy_spawn_pipe(av, 0, 0, &ofd, 0);
        if (pid < 0) die("cannot start apply");
        while ((r = sy_read(ofd, chunk, sizeof chunk)) > 0) { put(&log, chunk, r); sy_write_all(1, chunk, r); }
        sy_close(ofd); sy_wait_status(pid, 0, 0, 0, 0);
    }
    {   long at = 0;   /* SKIP and REVERT files go on the skip list, so the next round does not retry them */
        put(&sl, sk, skn);
        while (at < log.n) {
            char *l = log.p + at; long e = tx_chr(l, log.n - at, '\n'), ln = e < 0 ? log.n - at : e, t2;
            int isskip = tx_prefix(l, ln, "SKIP\t", 5), isrev = tx_prefix(l, ln, "REVERT\t", 7);
            if (tx_prefix(l, ln, "OK\t", 3)) ok++;
            if (tx_prefix(l, ln, "DEFER\t", 6)) def++;
            if (isskip || isrev) {
                long s = isskip ? 5 : 7; t2 = tx_chr(l + s, ln - s, '\t'); if (t2 < 0) t2 = ln - s;
                if (isskip) sk2++; else rev++;
                put(&sl, l + s, t2); put(&sl, "\n", 1);
            }
            at += ln + 1;
        }
        if (sk2 + rev && cx_write(skp, sl.p, (size_t)sl.n) != 0) die("cannot write the skip list");
    }
    {   Buf again = {0, 0, 0}; size_t n2; char *s2 = cx_read(skp, &n2);
        sweep_find(&again, argv + 4, (int)(dash - 4), tracked, s2 ? s2 : "", s2 ? (long)n2 : 0, &after);
    }
    sy_unlink(cand);
    printf("SWEEP\tok=%d\tskip=%d\trevert=%d\tdefer=%d\tremaining=%ld\tskip_list=%s\n", ok, sk2, rev, def, after, skp);
    return rev ? 1 : after ? 3 : 0;
}

int main(int argc, char **argv) {
    arena = ar_new(1L << 32);
    if (!arena) die("cannot create the arena");
    if (argc >= 4 && tx_eq(argv[1], "find", 8)) {
        int a = 2, autoacc = 0, k; Buf out = {0, 0, 0};
        if (tx_eq(argv[a], "--auto", 8)) { autoacc = 1; a++; }
        load_rules(argv[a++]);
        puts_(&out, "# verdict\tfile\toffset\tline\trule\tclass\twhy\toriginal\treplacement\tuse\n");
        for (k = a; k < argc; k++) if (find_file(&out, argv[k], autoacc) < 0) return 2;
        return sy_write_all(1, out.p, out.n) == 0 ? 0 : 2;
    }
    if (argc >= 4 && tx_eq(argv[1], "sites", 8)) {
        /* sites NAME[,NAME...] (FILE... | --tracked): every call of those names, with any argument count,
           outside comments and literals, as FILE:LINE<TAB>call; --tracked scans every tracked .cx file
           (symlinks skipped).  The search half of find, for a whole tree in one process. */
        char *names = zdup(argv[2]), *p = names; int k; Buf out = {0, 0, 0};
        while (*p) {
            char *s = p; while (*p && *p != ',') p++;
            if (*p) *p++ = 0;
            if (!*s) continue;
            if (nrules == MAXRULE) die("too many names");
            rules[nrules].id = s; rules[nrules].call = s; rules[nrules].prefix = ""; rules[nrules].argc = -1;
            rules[nrules].tmpl = ""; rules[nrules].use = "-"; rules[nrules].cls = "site";
            rules[nrules].truth = 0; rules[nrules].where_arg = 0; rules[nrules].where = "";
            nrules++;
        }
        sites_mode = 1;
        if (tx_eq(argv[3], "--tracked", 16)) { if (scan_tracked(&out, 0) < 0) return 2; }
        else for (k = 3; k < argc; k++) if (find_file(&out, argv[k], 0) < 0) return 2;
        return sy_write_all(1, out.p ? out.p : "", out.n) == 0 ? 0 : 2;
    }
    if (argc >= 5 && tx_eq(argv[1], "rename", 8)) {
        /* rename OLD NEW (FILE... | --tracked): every OLD identifier outside comments and literals (calls,
           types, macros, declarations alike) as candidate rows that apply takes, verified per file like any
           rule; rows in reserved paths are skip.  Nothing is accepted unless --auto comes first. */
        int a = 2, autoacc = 0, k; Buf out = {0, 0, 0};
        if (tx_eq(argv[a], "--auto", 8)) { autoacc = 1; a++; }
        if (argc < a + 3) die("rename [--auto] OLD NEW (FILE... | --tracked)");
        rules[0].id = "rename"; rules[0].call = argv[a]; rules[0].prefix = ""; rules[0].argc = -2;
        rules[0].tmpl = argv[a + 1]; rules[0].use = "-"; rules[0].cls = "safe";
        rules[0].truth = 0; rules[0].where_arg = 0; rules[0].where = "";
        nrules = 1; rename_rule = 0;
        for (k = 0; argv[a + 1][k]; k++) if (!is_id((unsigned char)argv[a + 1][k])) die("NEW must be an identifier");
        puts_(&out, "# verdict\tfile\toffset\tline\trule\tclass\twhy\toriginal\treplacement\tuse\n");
        if (tx_eq(argv[a + 2], "--tracked", 16)) { if (scan_tracked(&out, autoacc) < 0) return 2; }
        else for (k = a + 2; k < argc; k++) if (find_file(&out, argv[k], autoacc) < 0) return 2;
        return sy_write_all(1, out.p, out.n) == 0 ? 0 : 2;
    }
    if (argc >= 7 && tx_eq(argv[1], "sweep", 8)) return sweep(argv, argc);
    if (argc >= 5 && tx_eq(argv[1], "apply", 8)) {
        if (sy_env("REFACTOR_DEADLINE_MS")) deadline_ms = strtol(sy_env("REFACTOR_DEADLINE_MS"), 0, 10);   /* sweep leaves room for its finds */
        Buf v = {0, 0, 0}; int k, jobs = (int)strtol(argv[3], 0, 10);
        if (jobs < 1 || jobs > MAXJOBS) die("JOBS 1..16");
        if (argc >= 8 && tx_eq(argv[4], "--range", 8)) {
            range_from = strtol(argv[5], 0, 10); range_count = strtol(argv[6], 0, 10);
            if (range_from < 0 || range_count < 0) die("--range A N");
            for (k = 7; k < argc; k++) argv[k - 3] = argv[k];   /* drop the three --range words */
            argc -= 3;
        }
        if (tx_eq(argv[4], "--verify-from", 16)) {   /* each file's registered batch is its check */
            if (argc != 6) die("apply CANDIDATES JOBS --verify-from REGISTRY");
            reg_text = cx_read(argv[5], &reg_n);
            if (!reg_text) die("cannot read the registry");
            if (sy_realpath(".", root_abs, sizeof root_abs) < 0) die("cannot resolve the root");
            {   char vd[4400]; int m;
                if (cx_fmt(vd, sizeof vd, "%s/out/refactor-verify", root_abs)) die("path");
                m = sy_mkdir(vd, 0700);
                if (m != 0 && m != -EEXIST) die("cannot make out/refactor-verify");
            }
            return apply(argv[2], jobs, 0);
        }
        for (k = 4; k < argc; k++) { if (k > 4) put(&v, " ", 1); puts_(&v, argv[k]); }
        return apply(argv[2], jobs, v.p);
    }
    fprintf(stderr, "usage: refactor.cx sweep RULES JOBS (FILE... | --tracked) -- CHECK... | rename [--auto] OLD NEW (FILE... | --tracked) | sites NAME[,NAME...] (FILE... | --tracked) | find [--auto] RULES FILE... | apply CANDIDATES JOBS (VERIFY... | --verify-from REGISTRY)\n");
    return 2;
}
