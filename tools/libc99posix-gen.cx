#pragma unisa use sys.io
#pragma unisa use text.text
/* Project exec/facts/libc99posix.tsv onto cx/compiler/libc99bind.cx.
   sh ./unisacc.com tools/libc99posix-gen.cx -- --check
   sh ./unisacc.com tools/libc99posix-gen.cx -- --write
   bind is host-export, cx-own, syscall, or per-cell (KIND:SYMBOL cells).
   cx-own requires a static definition in include/. No libc and no include. */
#define TSV "exec/facts/libc99posix.tsv"
#define OUT "cx/compiler/libc99bind.cx"
#define MAXROWS 128
#define NCOL 6
#define NAMEMAX 32
#define SIGMAX 96
#define CONMAX 96
#define BINDMAX 16
#define FILECAP 8192

static const char *own_header(const char *name) {
    if (tx_eqz(name, "strdup")) return "include/string.h";
    if (tx_eqz(name, "clock_gettime")) return "include/time.h";
    if (tx_eqz(name, "pread") || tx_eqz(name, "pwrite") || tx_eqz(name, "write")
        || tx_eqz(name, "pipe") || tx_eqz(name, "getcwd") || tx_eqz(name, "ftruncate"))
        return "include/unistd.h";
    return 0;
}

typedef struct {
    char name[NAMEMAX];
    char sig[SIGMAX];
    char con[CONMAX];
    char bind[NCOL][BINDMAX];
    char cell[NCOL][NAMEMAX];
} Row;
static Row rows[MAXROWS];
static int nrows;

static int fail(const char *w) {
    sy_eprintf("libc99posix-gen\tFAIL\t%s\n", w);
    return 1;
}

static int copy_n(char *d, int cap, const char *s, int n) {
    int i;
    if (n < 1 || n >= cap) return -1;
    for (i = 0; i < n; i++) d[i] = s[i];
    d[n] = 0;
    return 0;
}

static int take_row(const char *line, int n) {
    const char *f[10];
    int len[10];
    int i, k, start;
    char rowbind[BINDMAX];
    if (nrows >= MAXROWS) return fail("row-capacity");
    k = 0;
    start = 0;
    for (i = 0; i <= n; i++) {
        if (i == n || line[i] == '\t') {
            if (k >= 10) return fail("row-fields");
            f[k] = line + start;
            len[k] = i - start;
            k++;
            start = i + 1;
        }
    }
    if (k != 10) return fail("row-fields");
    if (copy_n(rows[nrows].name, NAMEMAX, f[0], len[0])) return fail("name");
    if (copy_n(rows[nrows].sig, SIGMAX, f[1], len[1])) return fail("sig");
    if (copy_n(rows[nrows].con, CONMAX, f[2], len[2])) return fail("con");
    if (copy_n(rowbind, BINDMAX, f[3], len[3])) return fail("bind");
    for (i = 0; i < nrows; i++)
        if (tx_eqz(rows[i].name, rows[nrows].name)) return fail("duplicate-name");
    for (i = 0; i < NCOL; i++) {
        const char *kind = f[3], *sym = f[4 + i];
        int kn = len[3], sn = len[4 + i];
        if (tx_eqz(rowbind, "per-cell")) {
            int j = 0;
            while (j < sn && sym[j] != ':') j++;
            if (j == sn) return fail("cell-kind");
            kind = sym; kn = j; sym += j + 1; sn -= j + 1;
        }
        if (copy_n(rows[nrows].bind[i], BINDMAX, kind, kn)) return fail("bind");
        if (copy_n(rows[nrows].cell[i], NAMEMAX, sym, sn)) return fail("cell");
        if (!tx_eqz(rows[nrows].bind[i], "host-export") && !tx_eqz(rows[nrows].bind[i], "cx-own")
            && !tx_eqz(rows[nrows].bind[i], "syscall")) return fail("bind-kind");
        if (tx_eqz(rows[nrows].bind[i], "host-export") && tx_eqz(rows[nrows].cell[i], "-"))
            return fail("host-cell");
    }
    nrows++;
    return 0;
}

static int parse_tsv(char *b, size_t n) {
    size_t i = 0;
    int saw = 0;
    if (n == 0 || b[n - 1] != '\n') return fail("tsv-newline");
    while (i < n) {
        size_t e = i;
        while (e < n && b[e] != '\n') e++;
        b[e] = 0;
        if (e == i) return fail("tsv-blank");
        if (!saw) {
            if (!tx_eqz(b + i, "# name\tsignature\tconstraint\tbind\tlnx/x86_64\tlnx/arm64\tosx/x86_64\tosx/arm64\twin/x86_64\twin/arm64"))
                return fail("tsv-header");
            saw = 1;
        } else if (b[i] == '#') {
            /* Provenance and whole-row contract comments do not add rows. */
        } else if (take_row(b + i, (int)(e - i))) {
            return 1;
        }
        i = e + 1;
    }
    if (!nrows) return fail("row-count");
    return 0;
}

static int has_static(const char *path, const char *nm) {
    size_t n = 0, i;
    char *b = cx_read(path, &n);
    int nl = 0;
    if (!b) return 0;
    while (nm[nl]) nl++;
    i = 0;
    while (i + 8 + (size_t)nl < n) {
        if (b[i] == 's' && b[i + 1] == 't' && b[i + 2] == 'a' && b[i + 3] == 't'
            && b[i + 4] == 'i' && b[i + 5] == 'c' && b[i + 6] == ' ') {
            size_t j = i + 7;
            while (j + (size_t)nl + 1 < n && b[j] != '\n' && b[j] != '{') {
                int k = 0;
                while (k < nl && b[j + k] == nm[k]) k++;
                if (k == nl && (b[j + nl] == '(' || b[j + nl] == ' ')) return 1;
                j++;
            }
        }
        i++;
    }
    return 0;
}

static int check_own(void) {
    int i, c;
    for (i = 0; i < nrows; i++) {
        const char *hdr = own_header(rows[i].name);
        int checked = 0;
        for (c = 0; c < NCOL; c++) {
            if (!tx_eqz(rows[i].bind[c], "cx-own")) continue;
            if (!tx_eqz(rows[i].cell[c], "-")) return fail("own-cell");
            if (!hdr) return fail("own-hdr");
            if (!checked && !has_static(hdr, rows[i].name)) return fail("own-body");
            checked = 1;
        }
    }
    return 0;
}

static int app(char *dst, int cap, int *n, const char *s) {
    int i = 0;
    while (s[i]) {
        if (*n + 1 >= cap) return -1;
        dst[*n] = s[i];
        *n += 1;
        i++;
    }
    dst[*n] = 0;
    return 0;
}

static int emit(char *dst, int cap) {
    int n = 0, i;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa module libc99bind\n")) return -1;
    if (app(dst, cap, &n, "/* Generated by tools/libc99posix-gen.cx from exec/facts/libc99posix.tsv.\n")) return -1;
    if (app(dst, cap, &n, "   Do not edit by hand. Target names select the exact fact-table cell.\n")) return -1;
    if (app(dst, cap, &n, "   Only host-export cells return a symbol; all other bindings return 0. */\n")) return -1;
    if (app(dst, cap, &n, "static int l99_eq(const char *nm, int nl, const char *s) {\n")) return -1;
    if (app(dst, cap, &n, "    int i; i = 0; while (s[i]) { if (i >= nl || nm[i] != s[i]) return 0; i = i + 1; } return i == nl;\n}\n")) return -1;
    if (app(dst, cap, &n, "const char *l99_fwdsym(const char *nm, int nl, const char *target) {\n")) return -1;
    if (app(dst, cap, &n, "    int slot, tl;\n    if (!nm || nl < 1 || !target) return 0;\n    tl = 0; while (tl < 32 && target[tl]) tl = tl + 1;\n    slot = -1;\n")) return -1;
    {
        const char *targets[NCOL] = {"lnx/x86_64", "lnx/arm64", "osx/x86_64", "osx/arm64", "win/x86_64", "win/arm64"};
        int c;
        for (c = 0; c < NCOL; c++) {
            char line[128];
            if (cx_fmt(line, sizeof line, "    if (l99_eq(target, tl, \"%s\")) slot = %d;\n", targets[c], c)) return -1;
            if (app(dst, cap, &n, line)) return -1;
        }
        for (i = 0; i < nrows; i++) {
            int hosts = 0;
            for (c = 0; c < NCOL; c++) if (tx_eqz(rows[i].bind[c], "host-export")) hosts++;
            if (!hosts) continue;
            if (app(dst, cap, &n, "    if (l99_eq(nm, nl, \"") || app(dst, cap, &n, rows[i].name)
                || app(dst, cap, &n, "\")) {\n")) return -1;
            for (c = 0; c < NCOL; c++) {
                char line[128];
                if (!tx_eqz(rows[i].bind[c], "host-export")) continue;
                if (cx_fmt(line, sizeof line, "        if (slot == %d) return \"%s\";\n", c, rows[i].cell[c])) return -1;
                if (app(dst, cap, &n, line)) return -1;
            }
            if (app(dst, cap, &n, "        return 0;\n    }\n")) return -1;
        }
    }
    if (app(dst, cap, &n, "    return 0;\n}\n")) return -1;
    return n;
}

static int same_bytes(const char *a, size_t an, const char *b, int bn) {
    int i;
    if (an != (size_t)bn) return 0;
    for (i = 0; i < bn; i++) if (a[i] != b[i]) return 0;
    return 1;
}

int main(int argc, char **argv) {
    size_t nb = 0, on = 0;
    char *b, *cur;
    char file[FILECAP];
    int dowrite, fn;
    if (argc != 2 || (!tx_eqz(argv[1], "--check") && !tx_eqz(argv[1], "--write"))) {
        sy_eprintf("libc99posix-gen\tusage\t--check|--write\n");
        return 2;
    }
    dowrite = tx_eqz(argv[1], "--write");
    b = cx_read(TSV, &nb);
    if (!b) return fail("tsv-read");
    if (parse_tsv(b, nb)) return 1;
    if (check_own()) return 1;
    fn = emit(file, FILECAP);
    if (fn < 0) return fail("emit");
    if (dowrite) {
        if (cx_write(OUT, file, (size_t)fn)) return fail("write");
        sy_eprintf("libc99posix-gen\tWRITE\trows=%d\n", nrows);
        return 0;
    }
    cur = cx_read(OUT, &on);
    if (!cur) return fail("bind-read");
    if (!same_bytes(cur, on, file, fn)) return fail("bind-diff");
    sy_eprintf("libc99posix-gen\tCHECK\trows=%d\n", nrows);
    return 0;
}
