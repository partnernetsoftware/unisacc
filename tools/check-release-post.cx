    if (cx_fmt(cmd, sizeof cmd, "printf '# freeze\\n9.9.9-FREEZE\\t2026-11-26\\tfreeze-test\\n' > '%s/build/freeze.tsv'", root)) return 2;
    (void)ckk_sh_t("check-release-post", cmd, out, (int)sizeof out, 10);
    seed_root_files(ape998, "");
    sy_unlink(stf);
    rc = run_rp_raw("run --version 9.9.9 --execute");
    ck(rc == 0 && has("POST_STEP\t5\troot-upgrade\tOK\troot-upgraded") &&
       has("POST_STEP\t8\tthaw-freeze\tOK\tfreeze-row-thawed") &&
       has("RELEASE_POST\tstatus=DONE"), "full-e2e-upgrade-then-thaw");
    if (cx_fmt(cmd, sizeof cmd, "grep -q '^# 9\\.9\\.9-FREEZE.*Y2=%s)' '%s/build/freeze.tsv'", real_y2, root)) return 2;
    ck(ckk_sh_t("check-release-post", cmd, out, (int)sizeof out, 10) == 0, "full-e2e-freeze-tsv-thawed");

    /* dry-write hook */
    rc = run_rp("run --version 9.9.9 --dry --mutant-dry-write --step 4");
    ck(rc != 0 && has("mutant-dry-write"), "mutant-dry-write-red");

    /* Private /tmp source mutants: tested via assertion predicate clean=1 vs mutant=0 (red-then-green kill) */
    if (!no_mut) {
        char mdir[1100];

        /* Mutant 1: disable default g_root_up */
        if (cx_fmt(cmd, sizeof cmd, "printf '# freeze\\n9.9.9-FREEZE\\t2026-11-26\\tfreeze-test\\n' > '%s/build/freeze.tsv'", root)) return 2;
        (void)ckk_sh_t("check-release-post", cmd, out, (int)sizeof out, 10);
        seed_root_files(ape998, "");
        sy_unlink(stf);
        if (prepare_alt_rp_tree("disable-root-up", "g_dry = 0; g_exec = 0; g_root_up = 1;", "g_dry = 0; g_exec = 0; g_root_up = 0;", mdir, sizeof mdir) == 0) {
            rc = run_rp_in(mdir, "run --version 9.9.9 --execute");
            int rc_step5_blk = (rc != 0 && has("POST_STEP\t5\troot-upgrade\tSKIPPED") && has("BLOCKED:root-upgrade"));
            ck(rc_step5_blk && pred_thaw_stale_refused(cwd) && pred_thaw_stale_refused(mdir),
               "mutant-disable-default-root-up-blocks-thaw-e2e");
        } else ck(0, "mutant-disable-default-root-up-blocks-thaw-e2e");

        /* Mutant 2: SKIPPED wrongly sets DONE on Step 5 */
        sy_unlink(stf);
        if (prepare_alt_rp_tree("skip-marks-done", "if (rc == 0 && !g_step_skipped[n] && g_exec) {", "if (rc >= 0 && g_exec) {", mdir, sizeof mdir) == 0) {
            rc = run_rp_in(mdir, "run --version 9.9.9 --execute --no-root-upgrade defer-reason");
            int rc_skip_blk = (rc != 0 && has("POST_STEP\t5\troot-upgrade\tSKIPPED") && has("BLOCKED:root-upgrade"));
            ck(rc_skip_blk && pred_thaw_stale_refused(cwd) && pred_thaw_stale_refused(mdir),
               "mutant-skip-marks-done-still-blocks-thaw");
        } else ck(0, "mutant-skip-marks-done-still-blocks-thaw");

        /* Mutant 3 (B5): skip-thaw-root-gate killed by pred_thaw_stale_refused (clean=1, mutant=0) */
        if (prepare_alt_rp_tree("skip-thaw-root-gate", "if (!gate_ok) {", "if (0 && !gate_ok) {", mdir, sizeof mdir) == 0) {
            int clean_ok = pred_thaw_stale_refused(cwd);
            int mut_esc  = pred_thaw_stale_refused(mdir);
            ck(clean_ok == 1 && mut_esc == 0, "mutant-skip-thaw-root-gate-killed-red-then-green");
        } else ck(0, "mutant-skip-thaw-root-gate-killed-red-then-green");

        /* Mutant 4 (B4a + B5): early shortcut when freeze.tsv has no active row killed by pred_thaw_empty_freeze_stale_refused */
        if (cx_fmt(cmd, sizeof cmd, "printf '# freeze\\n' > '%s/build/freeze.tsv'", root)) return 2;
        (void)ckk_sh_t("check-release-post", cmd, out, (int)sizeof out, 10);
        if (prepare_alt_rp_tree("b4a-early-return",
                "    /* Unconditional verification BEFORE consulting build/freeze.tsv: Y2 + release SHA + live Gate 24 */\n",
                "    if (!cx_fmt(frz_p, sizeof frz_p, \"%s/build/freeze.tsv\", g_repo) && rp_freeze_row_find(frz_p, g_ver, 0, 0, 0, 0) == 0) { post_step(8, \"OK\", \"already-thawed-or-absent\"); return 0; }\n",
                mdir, sizeof mdir) == 0) {
            int clean_ok = pred_thaw_empty_freeze_stale_refused(cwd);
            int mut_esc  = pred_thaw_empty_freeze_stale_refused(mdir);
            ck(clean_ok == 1 && mut_esc == 0, "mutant-b4a-early-return-killed-red-then-green");
        } else ck(0, "mutant-b4a-early-return-killed-red-then-green");

        /* Mutant 5 (B4b + B5): early break without status check killed by pred_y2_fail_row_refused */
        if (cx_fmt(cmd, sizeof cmd,
            "printf '# freeze\\n9.9.9-FREEZE\\t2026-11-26\\tfreeze-test\\n' > '%s/build/freeze.tsv' && "
            "printf 'exec-7-Y2-done\\tnow\\t-\\t%s\\tFAIL\\nexec-7-Y2-done\\tnow\\t-\\t%s\\tdone\\n' > '%s/INDEX.tsv'",
            root, real_y2, real_y2, ev)) return 2;
        (void)ckk_sh_t("check-release-post", cmd, out, (int)sizeof out, 10);
        seed_root_files(ape999, "11223344556677889900aabbccddeeff00112233");
        if (prepare_alt_rp_tree("b4b-early-break",
                "                rp_status_is_bad(l + c2o, c2l) ||\n                rp_status_is_bad(l + c4o, c4l)) {\n                bad = 1;\n                break;\n            }",
                "                0) { bad = 1; break; }",
                mdir, sizeof mdir) == 0) {
            /* Also strip break loop check behavior by checking clean=1 vs mutant on FAIL row */
            int clean_ok = pred_y2_fail_row_refused(cwd);
            int mut_esc  = pred_y2_fail_row_refused(mdir);
            ck(clean_ok == 1 && mut_esc == 0, "mutant-b4b-status-skip-killed-red-then-green");
        } else ck(0, "mutant-b4b-status-skip-killed-red-then-green");
    }

    sy_remove_all(root);
    {
        int failed = ck_failures();
        int total = ck_assertions();
        printf("RELEASE_POST_SUMMARY\tfailed=%d\tpassed=%d\n", failed, total - failed);
        if (!failed) printf("CHECK_RELEASE_POST\n");
        return ck_failures() ? 1 : 0;
    }
}
