    if (cx_fmt(cmd, sizeof cmd,
        "printf 'READBACK_SHA unisacc.com %s\\nREADBACK_SHA unisacc.com bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\\n' > '%s/public-readback.txt'",
