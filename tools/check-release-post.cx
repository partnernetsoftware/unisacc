/* tools/check-release-post.cx -- fixture + source-mutant kill suite for tools/release-post.cx
 *
 * Covers: plan lines, dry zero-write, Step 5 default auto-upgrade, backup-SHA matching gate,
 * interrupted installer swap -> verified rollback, rollback rc!=0 / wrong restored SHA -> FAIL,
 * 3-source SHA + readback-only --ape-sha cross-check, forged state 5/8 DONE re-verification,
 * Step 1 + Step 8 strict Y2 (no FAIL/conflict/non-commit), no unverified early thaw when freeze absent,
 * single-step STEP_DONE, pgrep error fail-closed, missing default tool-index smoke, and red-then-green mutants.
 * Ends CHECK_RELEASE_POST. */
#pragma unisa use cxlib.ckassert
#pragma unisa use cxlib.ckrun
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use sys.posix
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

static char out[1 << 16];
static char root[900], cwd[800], ev[950], stf[950];
static char chain[950], met[950], day[950], inst[950], fakegh[950];
static char cdir[950], pdir[950], bdir[950];
static char ape998[950], ape999[950], ape997[950], sha998[80], sha999[80], sha997[80];
static char real_y2[64];

static int run_rp_in(const char *tool_dir, const char *extra) {
    char cmd[5200];
    if (cx_fmt(cmd, sizeof cmd,
        "cd '%s' && cx tools/release-post.cx -- %s"
        " --repo '%s' --evidence-dir '%s' --state-file '%s'"
        " --chain-dir '%s' --prerun-dir '%s' --backup-dir '%s'"
        " --chain-bin 'sh %s' --metrics-bin 'sh %s' --day-bin 'sh %s' --install-bin 'sh %s'"
        " --gh-bin '%s' --install-root '%s' --pgrep-pat '[z]zz-no-such-proc-zzz'",
        tool_dir, extra, root, ev, stf, cdir, pdir, bdir,
        chain, met, day, inst, fakegh, root)) return -1;
    return ckk_sh_t("check-release-post", cmd, out, (int)sizeof out, 55);
}

static int run_rp_raw(const char *extra) { return run_rp_in(cwd, extra); }

static int run_rp(const char *extra) {
    char cmd[5200];
    if (cx_fmt(cmd, sizeof cmd, "%s --ape '%s' --ape-sha '%s'", extra, ape999, sha999)) return -1;
    return run_rp_raw(cmd);
}

static int has(const char *s) { return ckk_has(out, (int)sizeof out, s); }

static int has_y2_done(const char *body, size_t n) {
    const char key[] = "exec-7-Y2-done";
    const size_t key_n = sizeof key - 1;
    size_t at = 0;
    while (at < n) {
        size_t end = at;
        while (end < n && body[end] != '\n') end++;
        if (end - at > key_n && body[at + key_n] == '\t' &&
            tx_same(body + at, key_n, key, key_n)) return 1;
        at = end < n ? end + 1 : end;
    }
    return 0;
}

static long rp_byte_span_find(const char *hay, long hn, const char *needle, long nn) {
    if (!hay || !needle || nn <= 0 || hn < nn) return -1;
    for (long i = 0; i <= hn - nn; i++) {
        long j = 0;
        while (j < nn && hay[i + j] == needle[j]) j++;
        if (j == nn) return i;
    }
    return -1;
}

static int prepare_alt_rp_tree(const char *tag, const char *find_str, const char *sub_str, char *mdir_out, size_t mcap) {
    char p[1300], cmd[5600];
    size_t sn = 0; char *src;
    if (cx_fmt(mdir_out, mcap, "%s/alt-%s", root, tag)) return -1;
    if (cx_fmt(cmd, sizeof cmd,
        "rm -rf '%s' && mkdir -p '%s/tools' && "
        "[ ! -d '%s/cx' ] && ln -sT '%s/cx' '%s/cx' && ln -s '%s/cxroot.tsv' '%s/cxroot.tsv' && "
        "ln -s '%s/unisacc.com' '%s/unisacc.com' && "
        "[ ! -d '%s/tools/cxlib' ] && ln -sT '%s/tools/cxlib' '%s/tools/cxlib' && "
        "ln -s '%s/tools/bound' '%s/tools/bound' && ln -s '%s/tools/bound.c' '%s/tools/bound.c' && "
        "ln -s '%s/tools/root-current.cx' '%s/tools/root-current.cx' && "
        "{ [ ! -e '%s/ext' ] || { [ ! -d '%s/ext' ] && ln -sT '%s/ext' '%s/ext'; }; }",
        mdir_out, mdir_out,
        mdir_out, cwd, mdir_out, cwd, mdir_out,
        cwd, mdir_out,
        mdir_out, cwd, mdir_out,
        cwd, mdir_out, cwd, mdir_out,
        cwd, mdir_out,
        cwd, mdir_out, cwd, mdir_out)) return -1;
    if (ckk_sh_t("alt-tree", cmd, out, (int)sizeof out, 15) != 0) return -1;
    cx_fmt(p, sizeof p, "%s/tools/release-post.cx", cwd);
    src = cx_read(p, &sn);
    if (!src) return -1;
    long fl = tx_len(find_str, 4096), rl = tx_len(sub_str, 4096);
    long at = rp_byte_span_find(src, (long)sn, find_str, fl);
    if (at < 0 || rp_byte_span_find(src + at + fl, (long)sn - at - fl, find_str, fl) >= 0) { mm_free(src); return -1; }
    size_t mn = sn - (size_t)fl + (size_t)rl;
    char *mb = mm_alloc((long)mn + 1);
    if (!mb) { mm_free(src); return -1; }
    mm_copy(mb, (long)mn + 1, src, at);
    mm_copy(mb + at, (long)mn + 1 - at, sub_str, rl);
    mm_copy(mb + at + rl, (long)mn + 1 - at - rl, src + at + fl, (long)sn - at - fl);
    mm_free(src);
    cx_fmt(p, sizeof p, "%s/tools/release-post.cx", mdir_out);
    if (cx_write(p, mb, mn)) { mm_free(mb); return -1; }
    mm_free(mb);
    return 0;
}

static int seed_root_files(const char *ape_path, const char *commit_or_empty) {
    char cmd[2400];
    if (cx_fmt(cmd, sizeof cmd,
        "cp '%s' '%s/unisacc.com' && chmod 700 '%s/unisacc.com' && "
        "S=$(sha256sum '%s/unisacc.com' | awk '{print $1}') && B=$(wc -c < '%s/unisacc.com' | tr -d ' ') && "
        "printf '%%s\\t%%s\\tunisacc.com\\n' \"$S\" \"$B\" > '%s/unisacc.com.ape.sha256' && "
        "CM='%s' && "
        "if [ -n \"$CM\" ]; then "
        "  printf '{\\n  \"bytes\": %%s,\\n  \"commit\": \"%%s\",\\n  \"schema\": 1,\\n  \"product_kind\": \"ape1\",\\n  \"product_digest\": \"%%s\"\\n}\\n' \"$B\" \"$CM\" \"$S\" > '%s/unisacc.com.build.json'; "
        "else "
        "  printf '{\\n  \"bytes\": %%s,\\n  \"schema\": 1,\\n  \"product_kind\": \"ape1\",\\n  \"product_digest\": \"%%s\"\\n}\\n' \"$B\" \"$S\" > '%s/unisacc.com.build.json'; "
        "fi",
        ape_path, root, root, root, root, root, commit_or_empty ? commit_or_empty : "", root, root)) return -1;
    return ckk_sh_t("seed-root", cmd, out, (int)sizeof out, 10) == 0 ? 0 : -1;
}

/* Predicates shared between clean baseline and mutant kill verification */
static int pred_thaw_stale_refused(const char *tool_dir) {
    int rc = run_rp_in(tool_dir, "thaw --version 9.9.9 --execute");
    return rc != 0 && has("POST_THAW_GATE\tFAIL") && has("thaw-blocked-root-stale") && has("BLOCKED:thaw-freeze");
}

static int pred_thaw_empty_freeze_stale_refused(const char *tool_dir) {
    int rc = run_rp_in(tool_dir, "thaw --version 9.9.9 --execute");
    return rc != 0 && !has("already-thawed") && !has("POST_STEP\t8\tthaw-freeze\tOK") && has("BLOCKED:thaw-freeze");
}

static int pred_y2_fail_row_refused(const char *tool_dir) {
    int rc = run_rp_in(tool_dir, "thaw --version 9.9.9 --execute");
    return rc != 0 && has("missing-exec-7-Y2-done") && has("BLOCKED:thaw-freeze");
}

static int seed_ok_bins(void) {
    char cmd[8000];
    if (cx_fmt(cmd, sizeof cmd,
        "printf '#!/bin/sh\\n"
        "echo CHAIN_FAKE\\n"
        "for a in \"$@\"; do\\n"
        "  case \"$a\" in\\n"
        "    --verify) echo \"BACKUP_VERIFY\\tPASS\\tversion=9.9.9\\tfiles=7\"; exit 0;;\\n"
        "    --dry) echo MARK_DRY; exit 0;;\\n"
        "    --commit) echo MARK_COMMIT; exit 0;;\\n"
        "  esac\\n"
        "done\\n"
        "exit 0\\n' > '%s' && chmod 700 '%s'", chain, chain)) return 2;
    if (ckk_sh_t("check-release-post", cmd, out, (int)sizeof out, 10) != 0) return 2;
    if (cx_fmt(cmd, sizeof cmd,
        "printf '#!/bin/sh\\necho MET\\nexit 0\\n' > '%s' && chmod 700 '%s' && "
        "printf '#!/bin/sh\\necho DAY\\nexit 0\\n' > '%s' && chmod 700 '%s' && "
        "cat > '%s' << 'EOFINST'\n"
        "#!/bin/sh\n"
        "[ \"$1\" = \"--\" ] && shift\n"
        "R=\"$1\"; shift\n"
        "for a in \"$@\"; do [ \"$a\" = \"--rollback\" ] && RB=1; [ \"$a\" = \"--backup\" ] && BK=1; [ \"$a\" = \"--write\" ] && WR=1; done\n"
        "CUR=$(sha256sum \"$R/unisacc.com\" 2>/dev/null | awk '{print $1}')\n"
        "if [ \"$BK\" = \"1\" ]; then\n"
        "  [ \"$FAKE_INST_STALE_BACKUP_DRY\" = \"1\" ] && CUR=\"ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff\"\n"
        "  echo \"INSTALL_APE\\tBACKUP_DRYRUN\\t$CUR\\t10\\tunisacc.com\"\n"
        "  exit 0\n"
        "fi\n"
        "if [ \"$RB\" = \"1\" ] && [ \"$WR\" = \"1\" ]; then\n"
        "  [ \"$FAKE_INST_RB_FAIL\" = \"1\" ] && { echo \"INSTALL_APE\\tREFUSED\\trollback-step-failed\" > \"$R/.rollback-old.0\"; echo \"INSTALL_APE\\tREFUSED\\trollback-step-failed\"; exit 1; }\n"
        "  [ \"$FAKE_INST_RB_WRONG_SHA\" = \"1\" ] && { printf '#!/bin/sh\\necho bogus\\n' > \"$R/unisacc.com\"; echo \"INSTALL_APE\\tROLLED_BACK\\tbad\"; exit 0; }\n"
        "  cp \"$R/unisacc.com.bak\" \"$R/unisacc.com\" && chmod 700 \"$R/unisacc.com\"\n"
        "  cp \"$R/unisacc.com.ape.sha256.bak\" \"$R/unisacc.com.ape.sha256\" 2>/dev/null || true\n"
        "  cp \"$R/unisacc.com.build.json.bak\" \"$R/unisacc.com.build.json\" 2>/dev/null || true\n"
        "  echo \"INSTALL_APE\\tROLLED_BACK\\t$CUR\"; exit 0\n"
        "fi\n"
        "if [ \"$RB\" = \"1\" ]; then echo \"INSTALL_APE\\tROLLBACK_DRYRUN\\t$CUR\"; exit 0; fi\n"
        "if [ \"$WR\" = \"1\" ]; then\n"
        "  APE=\"$1\"; SHA=\"$2\"\n"
        "  [ -f \"$R/unisacc.com\" ] && cp \"$R/unisacc.com\" \"$R/unisacc.com.bak\"\n"
        "  [ -f \"$R/unisacc.com.ape.sha256\" ] && cp \"$R/unisacc.com.ape.sha256\" \"$R/unisacc.com.ape.sha256.bak\"\n"
        "  [ -f \"$R/unisacc.com.build.json\" ] && cp \"$R/unisacc.com.build.json\" \"$R/unisacc.com.build.json.bak\"\n"
        "  cp \"$APE\" \"$R/unisacc.com\" && chmod 700 \"$R/unisacc.com\"\n"
        "  [ \"$FAKE_INST_SWAP_THEN_FAIL\" = \"1\" ] && { echo \"install interrupted after swap\"; exit 2; }\n"
        "  SZ=$(wc -c < \"$R/unisacc.com\" | tr -d ' ')\n"
        "  printf '%%s\\t%%s\\tunisacc.com\\n' \"$SHA\" \"$SZ\" > \"$R/unisacc.com.ape.sha256\"\n"
        "  printf '{\\n  \"bytes\": %%s,\\n  \"commit\": \"11223344556677889900aabbccddeeff00112233\",\\n  \"schema\": 1,\\n  \"product_kind\": \"ape1\",\\n  \"product_digest\": \"%%s\"\\n}\\n' \"$SZ\" \"$SHA\" > \"$R/unisacc.com.build.json\"\n"
        "  echo \"INSTALL_APE\\tINSTALLED\"; exit 0\n"
        "fi\n"
        "exit 0\n"
        "EOFINST\n"
        "chmod 700 '%s' && "
        "cat > '%s' << 'EOFGH'\n"
        "#!/bin/sh\n"
        "if [ \"$FAKE_GH_FAIL\" = \"1\" ]; then exit 1; fi\n"
        "D=\"\"; while [ $# -gt 0 ]; do if [ \"$1\" = \"--dir\" ]; then D=\"$2\"; shift 2; else shift; fi; done\n"
        "if [ \"$FAKE_GH_BADSHA\" = \"1\" ]; then printf '#!/bin/sh\\necho bad\\n' > \"$D/unisacc.com\"; chmod 700 \"$D/unisacc.com\"; exit 0; fi\n"
        "cp '%s' \"$D/unisacc.com\" && chmod 700 \"$D/unisacc.com\"\n"
        "EOFGH\n"
        "chmod 700 '%s'",
        met, met, day, day, inst, inst, fakegh, ape999, fakegh)) return 2;
    return ckk_sh_t("check-release-post", cmd, out, (int)sizeof out, 10) == 0 ? 0 : 2;
}

int main(int argc, char **argv) {
    int no_mut = (argc >= 2 && tx_eqz(argv[1], "--no-mutants"));
    char cmd[6000]; int rc; long now;
    const char *td = sy_env("TMPDIR");
    if (!td || !td[0]) td = "/tmp";
    if (ckk_sh_t("check-release-post", "pwd", out, (int)sizeof out, 20) != 0) return 2;
    cx_fmt(cwd, sizeof cwd, "%s", out);
    { long n = tx_len(cwd, sizeof cwd); while (n > 0 && cwd[n - 1] == '\n') cwd[--n] = 0; }
    now = sy_wall_s();
    if (cx_fmt(root, sizeof root, "%s/rp-check-%ld", td, now % 1000000000)) return 2;
    sy_remove_all(root);
    if (sy_mkdir_all(root, 0700)) return 2;
    if (cx_fmt(ev, sizeof ev, "%s/ev", root) ||
        cx_fmt(stf, sizeof stf, "%s/state.tsv", root) ||
        cx_fmt(cdir, sizeof cdir, "%s/chain", root) ||
        cx_fmt(pdir, sizeof pdir, "%s/prerun", root) ||
        cx_fmt(bdir, sizeof bdir, "%s/backup", root) ||
        cx_fmt(chain, sizeof chain, "%s/fake-chain.sh", root) ||
        cx_fmt(met, sizeof met, "%s/fake-met.sh", root) ||
        cx_fmt(day, sizeof day, "%s/fake-day.sh", root) ||
        cx_fmt(inst, sizeof inst, "%s/fake-inst.sh", root) ||
        cx_fmt(fakegh, sizeof fakegh, "%s/fake-gh.sh", root) ||
        cx_fmt(ape998, sizeof ape998, "%s/ape_998.com", root) ||
        cx_fmt(ape999, sizeof ape999, "%s/ape_999.com", root) ||
        cx_fmt(ape997, sizeof ape997, "%s/ape_997.com", root)) return 2;
    sy_mkdir_all(ev, 0700); sy_mkdir_all(cdir, 0700); sy_mkdir_all(pdir, 0700); sy_mkdir_all(bdir, 0700);

    const char y2_row[] = "# index\nexec-7-Y2-done\tnow\t-\tabc\tdone\n";
    const char other_rows[] = "exec-7-Y2-done-extra\tnow\nother\texec-7-Y2-done\n";
    ck(has_y2_done(y2_row, sizeof y2_row - 1), "index-y2-key-with-tab");
    ck(!has_y2_done(other_rows, sizeof other_rows - 1), "index-y2-prefix-and-other-column-refused");

    if (cx_fmt(cmd, sizeof cmd,
        "set -e; mkdir -p '%s/release' '%s/tools'; "
        "printf '#!/bin/sh\\nif [ \"$1\" = \"--version\" ]; then echo \"unisacc 9.9.8\"; exit 0; fi\\n' > '%s'; chmod 700 '%s'; "
        "printf '#!/bin/sh\\nif [ \"$1\" = \"--version\" ]; then echo \"unisacc 9.9.9\"; exit 0; fi\\nexit 0\\n' > '%s'; chmod 700 '%s'; "
        "printf '#!/bin/sh\\nif [ \"$1\" = \"--version\" ]; then echo \"unisacc 9.9.7\"; exit 0; fi\\nexit 0\\n' > '%s'; chmod 700 '%s'; "
        "printf 'TOOL_INDEX\\tok\\n' > '%s/tools/tool-index.cx'; "
        "printf 'exec-7-Y2-done\\tnow\\t-\\t0123456789012345678901234567890123456789\\tdone\\n' > '%s/INDEX.tsv'; "
        "sha256sum '%s' '%s' '%s' | awk '{print $1}' > '%s/shas.txt'",
        root, root, ape998, ape998, ape999, ape999, ape997, ape997, root, ev, ape998, ape999, ape997, root)) return 2;
    ck(ckk_sh_t("check-release-post", cmd, out, (int)sizeof out, 10) == 0, "seed-index");
    {
        char sp[1000]; size_t sn = 0; char *sb;
        cx_fmt(sp, sizeof sp, "%s/shas.txt", root);
        sb = cx_read(sp, &sn);
        if (!sb || sn < 195) return 2;
        mm_copy(sha998, 65, sb, 64); sha998[64] = 0;
        mm_copy(sha999, 65, sb + 65, 64); sha999[64] = 0;
        mm_copy(sha997, 65, sb + 130, 64); sha997[64] = 0;
        mm_free(sb);
    }
    ck(seed_root_files(ape998, "") == 0, "seed-root-998");
    if (cx_fmt(cmd, sizeof cmd,
        "printf 'repo\\ttag\\tcommit\\tversion\\tworkflow\\tworkflow_ref\\tci_run_id\\tape\\tape_sha256\\tpackage\\tpackage_sha256\\twin_arm64\\twin_arm64_sha256\\trecord\\trecord_sha256\\tbuild_alias\\tbuild_alias_sha256\\tzip\\tzip_sha256\\tchecksums\\tchecksums_sha256\\n"
        "org/r\\tv9.9.9\\t11223344556677889900aabbccddeeff00112233\\t9.9.9\\tw\\tv9.9.9\\t1\\tunisacc.com\\t%s\\tp\\t%s\\tw\\t%s\\tr\\t%s\\tb\\t%s\\t-\\t-\\ts\\t%s\\n' > '%s/release/candidate.tsv' && "
        "printf 'unisacc-next.com\\tape-final/unisacc-next.com\\tsha=%s\\tbytes=10\\n' > '%s/ape-receipt.txt' && "
        "printf 'READBACK_SHA unisacc.com %s\\n' > '%s/public-readback.txt'",
        sha999, sha999, sha999, sha999, sha999, sha999, root, sha999, ev, sha999, ev)) return 2;
    ck(ckk_sh_t("check-release-post", cmd, out, (int)sizeof out, 10) == 0, "seed-cand-receipt-readback");
    ck(seed_ok_bins() == 0, "seed-bins");

    /* Seed git history + version-seq + active 9.9.9-FREEZE so full-run dry/execute verify Step 8 cleanly */
    if (cx_fmt(cmd, sizeof cmd,
        "set -e; mkdir -p '%s/build' '%s/release/evidence/9.9.9' && "
        "cp '%s/ape-receipt.txt' '%s/release/evidence/9.9.9/ape-receipt.txt' && "
        "cp '%s/public-readback.txt' '%s/release/evidence/9.9.9/public-readback.txt' && "
        "printf 'slot\\tversion\\tclass\\tstate\\tnote\\n1\\t9.9.8\\told\\t已公开\\told\\n' > '%s/build/version-seq.tsv' && "
        "git -C '%s' init -q -b main && "
        "git -C '%s' config user.email 'test@local' && git -C '%s' config user.name 'test' && "
        "git -C '%s' add build/version-seq.tsv && "
        "GIT_AUTHOR_DATE='2026-11-25T10:00:00+0000' GIT_COMMITTER_DATE='2026-11-25T10:00:00+0000' "
        "git -C '%s' commit -q -m v998 && git -C '%s' tag v9.9.8 && "
        "printf 'slot\\tversion\\tclass\\tstate\\tnote\\n1\\t9.9.8\\told\\t已公开\\told\\n2\\t9.9.9\\tnew\\t已公开\\tnew\\n' > '%s/build/version-seq.tsv' && "
        "git -C '%s' add build/version-seq.tsv release/candidate.tsv release/evidence/9.9.9/ape-receipt.txt release/evidence/9.9.9/public-readback.txt && "
        "GIT_AUTHOR_DATE='2026-11-26T10:00:00+0000' GIT_COMMITTER_DATE='2026-11-26T10:00:00+0000' "
        "git -C '%s' commit -q -m v999 && git -C '%s' tag v9.9.9 && "
        "git -C '%s' rev-parse HEAD > '%s/y2.txt' && "
        "printf '# freeze\\n9.9.9-FREEZE\\t2026-11-26\\tfreeze-test\\n' > '%s/build/freeze.tsv'",
        root, root, ev, root, ev, root, root, root, root, root, root, root, root, root, root, root, root, root, root, root)) return 2;
    ck(ckk_sh_t("check-release-post", cmd, out, (int)sizeof out, 20) == 0, "seed-git-freeze");
    {
        char yp[1000]; size_t yn = 0; char *yb;
        cx_fmt(yp, sizeof yp, "%s/y2.txt", root);
        yb = cx_read(yp, &yn);
        if (!yb || yn < 40) return 2;
        mm_copy(real_y2, sizeof real_y2, yb, 40); real_y2[40] = 0;
        mm_free(yb);
    }
    if (cx_fmt(cmd, sizeof cmd, "printf 'exec-7-Y2-done\\tnow\\t-\\t%s\\tdone\\n' > '%s/INDEX.tsv'", real_y2, ev)) return 2;
    (void)ckk_sh_t("check-release-post", cmd, out, (int)sizeof out, 10);

    rc = run_rp("plan --version 9.9.9");
    ck(rc == 0 && has("RELEASE_POST_PLAN\tversion=9.9.9") && has("POST_PLAN\t1\tindex-seal") &&
       has("POST_PLAN\t7\trearrange-patch-print") && has("POST_PLAN\t8\tthaw-freeze") &&
       has("RELEASE_POST\tstatus=PLAN"), "plan-lines");

    /* dry zero-write */
    rc = run_rp("run --version 9.9.9 --dry");
    ck(rc == 0 && has("RELEASE_POST\tstatus=DONE") && has("POST_ROOT_BACKUP_GATE\tPASS") &&
       has("POST_STEP\t5\troot-upgrade\tOK\tdry-auto-root-upgrade-ready") &&
       has("POST_STEP\t8\tthaw-freeze\tOK\tdry-awaiting-root-upgrade") && sy_exists(stf) == 0, "dry-ok");

    /* Stale backup gate MUST refuse */
    if (cx_fmt(cmd, sizeof cmd,
        "FAKE_INST_STALE_BACKUP_DRY=1 cx tools/release-post.cx -- run --version 9.9.9 --dry "
        "--repo '%s' --evidence-dir '%s' --install-root '%s' --install-bin 'sh %s' --step 5",
        root, ev, root, inst)) return 2;
    rc = ckk_sh_t("check-release-post", cmd, out, (int)sizeof out, 25);
    ck(rc != 0 && has("POST_ROOT_BACKUP_GATE\tFAIL") && has("POST_STEP\t5\troot-upgrade\tFAIL\tPOST_ROOT_BACKUP_GATE"),
       "stale-backup-gate-refused");

    /* Execute default: auto-resolves + default tool-index smoke + upgrades + thaws */
    rc = run_rp_raw("run --version 9.9.9 --execute");
    ck(rc == 0 && has("POST_STEP\t5\troot-upgrade\tOK\troot-upgraded") && has("POST_STEP\t8\tthaw-freeze\tOK\tfreeze-row-thawed") && has("RELEASE_POST\tstatus=DONE"), "execute-default-upgrades");

    /* Forged 5<TAB>DONE when root is stale 9.9.8 MUST NOT skip Step 5 */
    if (cx_fmt(cmd, sizeof cmd, "printf '# freeze\\n9.9.9-FREEZE\\t2026-11-26\\tfreeze-test\\n' > '%s/build/freeze.tsv'", root)) return 2;
