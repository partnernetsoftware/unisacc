        "printf 'CANDIDATE\\trev=11223344556677889900aabbccddeeff00112233\\tsha=%%s\\tbytes=%%s\\tversion=9.9.10\\tsource=%s\\tnot=PUBLISHED\\n' \"$S\" \"$B\" > '%s/unisacc.com.candidate.tsv'",
