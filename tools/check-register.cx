/* tools/check-register.cx -- the registry lock in tools/register.cx, on a PRIVATE copy of the tables.
 *
 *   sh ./unisacc.com tools/check-register.cx -- --prepare ABS_OUT
 *
 * The fixture rows never touch tests/batches.tsv and tests/coverage.tsv: the check copies them into
 * ABS_OUT/check-register-tables-XXXXXX/tests, points register calls at that copy with UNISACC_TABLES, and
 * asserts byte-for-byte on the copy.  The real tables are asserted unchanged at the end, so a concurrent
 * registration lane can no longer make this check fail by writing in the same window (2026-11-02: one
 * such false FAIL).  DRIVER = the register under test (tools/register.cx).
 *
 *   sh ./unisacc.com tools/check-register.cx -- --out ABS_OUT
 *
 * Two registrations overlap on tests/batches.tsv and tests/coverage.tsv; before the lock they saw each
 * other's half-written registry and rolled back through no fault of either row (2026-11-02, three
 * ROLLED_BACK in a row).  Cases:
 *   1. two concurrent registrations of fresh IDs both succeed: exactly one row of each in both files,
 *      nothing lost, nothing duplicated;
 *   2. one concurrent registration fails its batch (marker never printed) and rolls back while the other
 *      succeeds: only the failing call's two lines are gone, the other's row survives;
 *   3. a held lock makes a caller wait and then fail by name (lock timeout), touching neither file;
 *   4. a rollback that cannot take the lock at all reports the two left-over rows with their line numbers
 *      and exits 3 (status=DIRTY), never a bare lock timeout;
 *   5. a MARKER that already carries "rc0:" is refused and both files stay byte-identical;
 *   6. after the check removes its own rows both registries are byte-identical to the originals.
 * The fixture batches are real: tools/register-fixture.cx prints REGISTER_FIXTURE_OK, so run-batch passes.
 * Rows are removed by exact line content, never by restoring the whole file, so a row someone else
 * appended meanwhile stays.
 * Mode --root-preflight (batch register-root-preflight, marker CX_REGISTER_ROOT): register started in a
 * root without out/ and/or ./unisacc.com refuses by name with the fixing command, exit 2, nothing written. */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.posix
#pragma unisa use sys.sha
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use cxlib.procrun
#pragma unisa use cxlib.runnerprep

static int failed, checks;
static char root[4096], fx[4400], bpath[4400], cpath[4400], tables[4400], rbpath[4400], rcpath[4400], envtables[4440];
static char prepared_driver[4400], output[4400];
static void native_args(char **v) {
    if (!prepared_driver[0]) return;
    for (int i=0; v[i] && v[i+1] && v[i+2] && v[i+3]; i++) {
        if (!strcmp(v[i], "sh") && !strcmp(v[i+1], "./unisacc.com") && !strcmp(v[i+2], "tools/register.cx") && !strcmp(v[i+3], "--")) {
            v[i]=prepared_driver; int j=i+1; do { v[j]=v[j+3]; } while(v[j++]); return;
        }
    }
}
#define DRIVER "tools/register.cx"

static void ok(int c, const char *what) {
    checks++;
    printf("%s\t%s\n", c ? "PASS" : "FAIL", what);
    if (!c) failed++;
}

static void die(const char *a, const char *b) { fprintf(stderr, "check-register: %s%s%s\n", a, b ? ": " : "", b ? b : ""); exit(2); }

static void pjoin(char *out, size_t cap, const char *a, const char *b) {
    if (cx_fmt(out, cap, "%s/%s", a, b)) die("path bound", b);
}

/* number of lines in P that start with PREFIX */
static long count_lines(const char *p, const char *prefix) {
    size_t n = 0, pl = strlen(prefix); char *b = cx_read(p, &n), *s; long at = 0, c = 0;
    if (!b) die("read", p);
    while (at < (long)n) {
        s = memchr(b + at, '\n', n - (size_t)at);
        {   long e = s ? (long)(s - (b + at)) : (long)n - at;
            if (e >= (long)pl && !memcmp(b + at, prefix, pl)) c++;
            at += e + 1;
        }
    }
    free(b);
    return c;
}

static long count_all(const char *p) {
    size_t n = 0; char *b = cx_read(p, &n), *s; long at = 0, c = 0;
    if (!b) die("read", p);
    while (at < (long)n) { s = memchr(b + at, '\n', n - (size_t)at); at += (s ? (long)(s - (b + at)) : (long)n - at) + 1; c++; }
    free(b);
    return c;
}

/* remove exactly one line equal to LINE (which ends in \n); 0 when found and removed.
   Every other line, including ones appended meanwhile, is carried over verbatim. */
static int take_out(const char *path, const char *line) {
    size_t n = 0, ll = strlen(line); char *b = cx_read(path, &n), *s; long at = 0; int bad = 0;
    if (!b) return 1;
    while (at < (long)n) {
        s = memchr(b + at, '\n', n - (size_t)at);
        {   long e = s ? (long)(s - (b + at)) : (long)n - at, ln = e + 1;
            if (ln == (long)ll && !memcmp(b + at, line, ll)) {
                FILE *f = fopen(path, "wb");
                if (!f) { free(b); return 1; }
                if (fwrite(b, 1, (size_t)at, f) != (size_t)at) bad = 1;
                if (fwrite(b + at + ln, 1, n - (size_t)at - (size_t)ln, f) != n - (size_t)at - (size_t)ln) bad = 1;
                if (fclose(f) != 0) bad = 1;
                free(b);
                return bad;
            }
            at += ln;
        }
    }
    free(b);
    return 1;
}

/* run ARGV bounded at 58 s (cxlib.procrun: on timeout the process group is killed and the reason is in OUT);
   the last cap-1 bytes of stderr followed by stdout into OUT (terminated): exit code, or -1 when it did not run to an exit */
static int run(char **argv, char *out, long cap) {
    char *native[64]; int ai=0;
    while(argv[ai]) { if(ai==63) die("argv bound",0); native[ai]=argv[ai]; ai++; }
    native[ai]=0; native_args(native);
    pr_result r; int rc; long en, on, skip, k, n = 0;
    out[0] = 0;
    if (pr_run("check-register child", native, 0, 0, 58, &r)) { if (cx_fmt(out, (size_t)cap, "%s", r.why)) out[0] = 0; return -1; }
    en = r.err ? (long)r.errn : 0; on = r.out ? (long)r.outn : 0;
    skip = en + on > cap - 1 ? en + on - (cap - 1) : 0;
    for (k = skip; k < en + on; k++) out[n++] = k < en ? r.err[k] : r.out[k - en];
    out[n] = 0;
    rc = r.rc; pr_free(&r);
    return rc < 0 ? -1 : rc;
}

/* the two registry lines tools/register.cx appends for ID/MARKER/TEXT */
static void rows(char *b, size_t bn, char *c, size_t cn, const char *id, const char *marker, const char *text) {
    if (cx_fmt(b, bn, "%s\tIMPLEMENTED\tinterfaces\t%s\tSOURCE\tlnx/x86_64\t55\t-\t%s\t-\tinterfaces.%s\trc0:%s\tproduct\tcommit\n",
               id, fx, fx, id, marker)) die("row bound", id);
    if (cx_fmt(c, cn, "interfaces.%s\tinterfaces\tIMPLEMENTED_SEPARATE_BATCH\t%s\t%s\n", id, text, fx)) die("row bound", id);
}

/* copy SRC over DST byte for byte; 0 on success */
static int copy_file(const char *src, const char *dst) {
    size_t n = 0; char *b = cx_read(src, &n); FILE *f; int bad = 0;
    if (!b) return 1;
    f = fopen(dst, "wb");
    if (!f) { free(b); return 1; }
    if (fwrite(b, 1, n, f) != n) bad = 1;
    if (fclose(f) != 0) bad = 1;
    free(b);
    return bad;
}

/* ARGV for one register call; the environment carries the private table directory into the child
   (the runtime's setenv is in-process only, so env(1) is the way a child sees a variable). */
static void reg_argv(char **av, const char **store, const char *id, const char *marker, const char *text) {
    (void)store;
    av[0] = "env"; av[1] = (char *)envtables; av[2] = "sh"; av[3] = "./unisacc.com"; av[4] = DRIVER; av[5] = "--";
    av[6] = (char *)id; av[7] = fx; av[8] = (char *)marker; av[9] = (char *)text; av[10] = fx; av[11] = "interfaces"; av[12] = 0;
    native_args(av);
}

/* A separate bounded mode keeps the existing concurrency cases unchanged. DRIVER_SOURCE may
 * explicitly select a frozen old source for a paired failing regression, never a cached result. */
static int metadata_rollback(const char *driver) {
    const char *bad="invalid-existing-metadata\tBROKEN\n";
    FILE *f=fopen(bpath,"ab");if(!f||fwrite(bad,1,strlen(bad),f)!=strlen(bad)||fclose(f))die("invalid metadata fixture",bpath);
    size_t bn,cn;char *beforeb=cx_read(bpath,&bn),*beforec=cx_read(cpath,&cn);
    if(!beforeb||!beforec)die("fixture snapshot",tables);
    char out[1<<15];char *a[]={"env","REGISTER_LOCK_MS=300","REGISTER_ROLLBACK_LOCK_MS=100",envtables,
        "./tools/bound","15","sh","./unisacc.com",(char *)driver,"--","cr-invalid-metadata",fx,
        "REGISTER_FIXTURE_OK","invalid existing metadata rollback",fx,"interfaces",0};
    int rc=run(a,out,sizeof out);printf("METADATA_CHILD\trc=%d\tretained=%s\n%s",rc,tables,out);
    ok(rc==1,"metadata refusal exits 1 within the child bound");
    ok(strstr(out,"metadata_valid!=1")&&strstr(out,"REFUSE"),"existing invalid metadata really refuses list");
    ok(strstr(out,"status=ROLLED_BACK")&&strstr(out,"rows_removed=2"),"metadata refusal reports exact two-row rollback");
    ok(!strstr(out,"status=DIRTY")&&!strstr(out,"lock timeout"),"own append lock does not obstruct rollback");
    ok(!count_lines(bpath,"cr-invalid-metadata\t")&&!count_lines(cpath,"interfaces.cr-invalid-metadata\t"),"both attempted rows are absent");
    size_t an,acn;char *afterb=cx_read(bpath,&an),*afterc=cx_read(cpath,&acn);
    ok(afterb&&an==bn&&!memcmp(afterb,beforeb,bn),"original invalid batch table preserved byte for byte");
    ok(afterc&&acn==cn&&!memcmp(afterc,beforec,cn),"original coverage table preserved byte for byte");
    ok(count_lines(bpath,"invalid-existing-metadata\t")==1,"preexisting invalid row is preserved");
    free(beforeb);free(beforec);free(afterb);free(afterc);
    printf("CX_REGISTER_METADATA\tchecks=%d\tfailed=%d\tretained=%s\n",checks,failed,tables);
    return failed?1:0;
}

/* run ARGV with CWD as the child's directory, bounded at 30 s; stderr then stdout into OUT; exit code or -1 */
static int run_in(const char *cwd, char **argv, char *out, long cap) {
    pr_result r; int rc;
    out[0] = 0;
    if (pr_run("register-root", argv, cwd, 0, 30, &r)) { cx_fmt(out, (size_t)cap, "%s", r.why); return -1; }
    if (cx_fmt(out, (size_t)cap, "%s%s", r.err ? r.err : "", r.out ? r.out : "")) out[0] = 0;
    rc = r.rc; pr_free(&r);
    return rc;
}
static void sha_of(const char *p, char *h) { size_t n = 0; char *b = cx_read(p, &n); if (!b) die("read", p); cx_sha256_hex(b, (long)n, h); free(b); }

/* --root-preflight [DRIVER]: register started in a root without ./unisacc.com and/or out/ (a private clone)
   must refuse by name with the fixing command and exit 2 before anything is written.  The root is an empty
   temp directory used as the child's cwd; register itself is this checkout's, started by absolute path.
   DRIVER (absolute, or relative to this root) selects another register source for a paired run: the
   pre-fix register (git show eae7faf84a^:tools/register.cx) must turn the named-refusal items red. */
static int root_preflight(const char *driver) {
    static char out[1 << 15]; char hold[4400], com[4400], drv[4400], outdir[4400], fake[4400], hb[65], hc[65], h[65]; int rc;
    char *a[] = {"env", envtables, "sh", com, drv, "--", "cr-root", "tools/register-fixture.cx", "REGISTER_FIXTURE_OK", "root preflight row", "tools/register-fixture.cx", "interfaces", 0};
    if (cx_fmt(hold, sizeof hold, "%s/check-register-root-XXXXXX", output) || !mkdtemp(hold)) die("mkdtemp", "root");
    pjoin(com, sizeof com, root, "unisacc.com");
    if (driver[0] == '/') { if (cx_fmt(drv, sizeof drv, "%s", driver)) die("path bound", driver); } else pjoin(drv, sizeof drv, root, driver);
    if (sy_exists(drv) != 1) die("no such driver", drv);
    printf("ROOT_PREFLIGHT_DRIVER\t%s\n", drv);
    pjoin(outdir, sizeof outdir, hold, "out"); pjoin(fake, sizeof fake, hold, "unisacc.com");
    sha_of(bpath, hb); sha_of(cpath, hc);
    /* neither: both are named, each with its fix */
    rc = run_in(hold, a, out, sizeof out);
    ok(rc == 2, "a root with neither out/ nor unisacc.com is refused with exit 2");
    ok(strstr(out, "REFUSE no out/ directory in this root") && strstr(out, "fix: mkdir out"), "missing out/ is named with the fixing command");
    ok(strstr(out, "REFUSE no ./unisacc.com in this root") && strstr(out, "fix: cp SHARED_ROOT/unisacc.com"), "missing unisacc.com is named with the fixing command");
    ok(!strstr(out, "ROLLED_BACK") && strstr(out, "nothing was written"), "the refusal is not a rollback and says nothing was written");
    /* out/ only: unisacc.com alone is named */
    if (sy_mkdir(outdir, 0700)) die("mkdir", outdir);
    rc = run_in(hold, a, out, sizeof out);
    ok(rc == 2 && strstr(out, "REFUSE no ./unisacc.com in this root") && !strstr(out, "no out/ directory"), "with out/ present only the missing unisacc.com is named");
    /* unisacc.com only: out/ alone is named */
    if (sy_rmdir(outdir)) die("rmdir", outdir);
    {   FILE *f = fopen(fake, "wb"); if (!f || fputs("placeholder\n", f) == EOF || fclose(f)) die("write", fake); }
    rc = run_in(hold, a, out, sizeof out);
    ok(rc == 2 && strstr(out, "REFUSE no out/ directory in this root") && !strstr(out, "no ./unisacc.com"), "with unisacc.com present only the missing out/ is named");
    /* out as a regular file is not a directory */
    {   FILE *f = fopen(outdir, "wb"); if (!f || fclose(f)) die("write", outdir); }
    rc = run_in(hold, a, out, sizeof out);
    ok(rc == 2 && strstr(out, "REFUSE no out/ directory in this root"), "out as a regular file is still refused by name");
    if (sy_unlink(outdir)) die("unlink", outdir);
    /* both present: the preflight lets the call through to the next refusal (the check path does not exist in this root) */
    if (sy_mkdir(outdir, 0700)) die("mkdir", outdir);
    rc = run_in(hold, a, out, sizeof out);
    ok(rc == 2 && strstr(out, "no such check") && !strstr(out, "REFUSE no "), "with both present the root preflight passes (next refusal: no such check)");
    sha_of(bpath, h); ok(!strcmp(h, hb), "no refused call wrote batches.tsv");
    sha_of(cpath, h); ok(!strcmp(h, hc), "no refused call wrote coverage.tsv");
    sy_unlink(fake); sy_rmdir(outdir);
    ok(sy_rmdir(hold) == 0, "the refused calls left nothing in the root (no out/register-* reservation, no lock)");
    sy_unlink(bpath); sy_unlink(cpath);
    {   char p[4400]; pjoin(p, sizeof p, tables, ".register.lock"); sy_unlink(p); sy_rmdir(tables); }
    printf("CX_REGISTER_ROOT\tchecks=%d\tfailed=%d\n", checks, failed);
    return failed ? 1 : 0;
}

int main(int argc,char **argv) {
    int prepare = argc == 3 && !strcmp(argv[1], "--prepare");
    if (prepare || (argc >= 3 && !strcmp(argv[1], "--out"))) {
        if (argv[2][0]!='/' || cx_fmt(output,sizeof output,"%s",argv[2])) die("absolute output required",0);
        if (prepare) argc=1; else { argc-=2; argv+=2; }
    }
    int args_only=argc==2&&!strcmp(argv[1],"--args-check");
    int metadata_only=(argc==2||argc==3)&&!strcmp(argv[1],"--metadata-rollback");
    int root_only=(argc==2||argc==3)&&!strcmp(argv[1],"--root-preflight");
    if(argc!=1&&!args_only&&!metadata_only&&!root_only)return 2;
    static char abuf[1 << 15], bbuf[1 << 15];
    char *av0[16], *av1[16], *v[2] = { av0, av1 };
    const char *ids[4] = { "cr-a", "cr-b", "cr-c", "cr-d" };
    char rowsb[4][4096], rowsc[4][4096];
    long before_b, before_c;
    char orig_hb[65], orig_hc[65], real_hb[65], real_hc[65];
    int i, j;
    if (sy_realpath(".", root, sizeof root) < 0) die("cwd", 0);
    if (!output[0] && cx_fmt(output,sizeof output,"%s/%s/check-register",root,"out")) die("output path",0);
    { char od[4400]; if (cx_fmt(od,sizeof od,"%s/out",root)) die("output path",0); if (sy_mkdir(od,0700) && sy_exists(od)!=1) die("out directory",od); }
    if (sy_mkdir(output,0700) && sy_exists(output)!=1) die("output directory",output);
    if (!root_only) {
        char cache[4400], bin[4400], why[512]; int reused;
        if (rn_prepare(root,DRIVER,output,prepared_driver,sizeof prepared_driver,&reused,why,sizeof why)) die(why,0);
        if (cx_fmt(cache,sizeof cache,"%s/%s/register-native",root,"out")) die("prepare cache",0);
        if (sy_mkdir(cache,0700) && sy_exists(cache)!=1) die("prepare cache",cache);
        if (rn_prepare(root,"tests/run.cx",cache,bin,sizeof bin,&reused,why,sizeof why) || rn_prepare(root,"tests/run-batch.cx",cache,bin,sizeof bin,&reused,why,sizeof why)) die(why,0);
        if (prepare) return 0;
    }
    pjoin(rbpath, sizeof rbpath, root, "tests/batches.tsv");
    pjoin(rcpath, sizeof rcpath, root, "tests/coverage.tsv");
    {   /* the private table directory: everything below works on this copy, never on the shared tables.
           Explicit output keeps preparation and consumption in the caller-owned directory. */
        char hold[4400];
        if (cx_fmt(hold, sizeof hold, "%s/check-register-tables-XXXXXX", output)) die("path bound", "tables");
        if (!mkdtemp(hold)) die("mkdir", hold);
        if (cx_fmt(tables, sizeof tables, "%s/tests", hold)) die("path bound", "tables");
        {   int r = sy_mkdir(tables, 0700); if (r < 0 && r != -EEXIST) die("mkdir", tables); }
        if (cx_fmt(envtables, sizeof envtables, "UNISACC_TABLES=%s", tables)) die("path bound", "env");
    }
    pjoin(bpath, sizeof bpath, tables, "batches.tsv");
    pjoin(cpath, sizeof cpath, tables, "coverage.tsv");
    if (copy_file(rbpath, bpath) || copy_file(rcpath, cpath)) die("cannot copy the registry", tables);
    before_b = count_all(bpath); before_c = count_all(cpath);
    if (before_b < 1 || before_c < 1) die("empty registry", 0);
    {   size_t n = 0; char *b = cx_read(bpath, &n); if (!b) die("read", bpath); cx_sha256_hex(b, (long)n, orig_hb); free(b);
        b = cx_read(cpath, &n); if (!b) die("read", cpath); cx_sha256_hex(b, (long)n, orig_hc); free(b);
    }
    {   size_t n = 0; char *b = cx_read(rbpath, &n); if (!b) die("read", rbpath); cx_sha256_hex(b, (long)n, real_hb); free(b);
        b = cx_read(rcpath, &n); if (!b) die("read", rcpath); cx_sha256_hex(b, (long)n, real_hc); free(b);
    }

    /* fixture: tools/register-fixture.cx is a real SOURCE entry (registry source paths must be tools/,
       tests/ or cx/), prints REGISTER_FIXTURE_OK and exits 0 */
    if (cx_fmt(fx, sizeof fx, "%s", "tools/register-fixture.cx")) die("fixture path", 0);
    if (!sy_exists(fx)) die("missing fixture", fx);

    if(metadata_only)return metadata_rollback(argc==3?argv[2]:DRIVER);
    if(root_only)return root_preflight(argc==3?argv[2]:DRIVER);

    if(args_only){
        char *args[]={"env",envtables,"sh","./unisacc.com",DRIVER,"--","cr-args",fx,"REGISTER_FIXTURE_ARGS_OK","explicit argv fixture",fx,"interfaces","product","--args","alpha;beta",0};
        int rc=run(args,abuf,sizeof abuf);ok(rc==0&&strstr(abuf,"status=REGISTERED"),"explicit two args reach real fixture and marker");size_t n;char *bytes=cx_read(bpath,&n);ok(bytes&&strstr(bytes,"\talpha;beta\tinterfaces.cr-args\trc0:REGISTER_FIXTURE_ARGS_OK\tproduct\tcommit\n"),"final registry keeps exact encoded args");free(bytes);
        char hb[65],hc[65],afterb[65],afterc[65];bytes=cx_read(bpath,&n);cx_sha256_hex(bytes,n,hb);free(bytes);bytes=cx_read(cpath,&n);cx_sha256_hex(bytes,n,hc);free(bytes);
        args[6]="cr-args-empty";args[14]="";rc=run(args,abuf,sizeof abuf);ok(rc==2&&strstr(abuf,"empty args"),"empty args refuse before mutation");args[6]="cr-args-tab";args[14]="alpha\tbeta";rc=run(args,abuf,sizeof abuf);ok(rc==2&&strstr(abuf,"empty args"),"control field refuses before mutation");bytes=cx_read(bpath,&n);cx_sha256_hex(bytes,n,afterb);free(bytes);bytes=cx_read(cpath,&n);cx_sha256_hex(bytes,n,afterc);free(bytes);ok(!strcmp(hb,afterb)&&!strcmp(hc,afterc),"refused args preserve private registries");printf("REGISTER_ARGS_CHECK\tchecks=%d\tfailed=%d\n",checks,failed);return failed?1:0;
    }

    /* case 1: both concurrent registrations succeed */
    rows(rowsb[0], sizeof rowsb[0], rowsc[0], sizeof rowsc[0], "cr-a", "REGISTER_FIXTURE_OK", "concurrent row A");
    rows(rowsb[1], sizeof rowsb[1], rowsc[1], sizeof rowsc[1], "cr-b", "REGISTER_FIXTURE_OK", "concurrent row B");
    reg_argv(av0, 0, "cr-a", "REGISTER_FIXTURE_OK", "concurrent row A");
    reg_argv(av1, 0, "cr-b", "REGISTER_FIXTURE_OK", "concurrent row B");
    {   int fd[2], pid[2], ex = 0, code = 0, sig = 0, rc0, rc1;
        pid[0] = sy_spawn_pipe(v[0], 0, 0, &fd[0], 0);
        pid[1] = sy_spawn_pipe(v[1], 0, 0, &fd[1], 0);
        {   long n = 0, r; for (;;) { r = sy_read(fd[0], abuf + n, (long)sizeof abuf - 1 - n); if (r <= 0) break; n += r; if (n >= (long)sizeof abuf - 1) break; } abuf[n] = 0; sy_close(fd[0]); }
        {   long n = 0, r; for (;;) { r = sy_read(fd[1], bbuf + n, (long)sizeof bbuf - 1 - n); if (r <= 0) break; n += r; if (n >= (long)sizeof bbuf - 1) break; } bbuf[n] = 0; sy_close(fd[1]); }
        sy_wait_status(pid[0], 0, &ex, &code, &sig); rc0 = ex ? code : -1;
        ex = code = sig = 0; sy_wait_status(pid[1], 0, &ex, &code, &sig); rc1 = ex ? code : -1;
        ok(rc0 == 0 && rc1 == 0, "two concurrent registrations both exit 0");
    }
    ok(strstr(abuf, "status=REGISTERED") && strstr(bbuf, "status=REGISTERED"), "both report REGISTERED");
    ok(count_lines(bpath, "cr-a\t") == 1 && count_lines(bpath, "cr-b\t") == 1, "each batch row appears exactly once");
    ok(count_lines(cpath, "interfaces.cr-a\t") == 1 && count_lines(cpath, "interfaces.cr-b\t") == 1, "each coverage row appears exactly once");
    ok(count_all(bpath) == before_b + 2 && count_all(cpath) == before_c + 2, "no line lost or duplicated in either file");

    /* case 2: one fails its batch, rolls back, the other survives */
    rows(rowsb[2], sizeof rowsb[2], rowsc[2], sizeof rowsc[2], "cr-c", "NEVER_PRINTED", "rollback row");
    rows(rowsb[3], sizeof rowsb[3], rowsc[3], sizeof rowsc[3], "cr-d", "REGISTER_FIXTURE_OK", "survivor row");
    reg_argv(av0, 0, "cr-c", "NEVER_PRINTED", "rollback row");
    reg_argv(av1, 0, "cr-d", "REGISTER_FIXTURE_OK", "survivor row");
    {   int fd[2], pid[2], ex = 0, code = 0, sig = 0, rc0, rc1;
        pid[0] = sy_spawn_pipe(v[0], 0, 0, &fd[0], 0);
        pid[1] = sy_spawn_pipe(v[1], 0, 0, &fd[1], 0);
        {   long n = 0, r; for (;;) { r = sy_read(fd[0], abuf + n, (long)sizeof abuf - 1 - n); if (r <= 0) break; n += r; if (n >= (long)sizeof abuf - 1) break; } abuf[n] = 0; sy_close(fd[0]); }
        {   long n = 0, r; for (;;) { r = sy_read(fd[1], bbuf + n, (long)sizeof bbuf - 1 - n); if (r <= 0) break; n += r; if (n >= (long)sizeof bbuf - 1) break; } bbuf[n] = 0; sy_close(fd[1]); }
        sy_wait_status(pid[0], 0, &ex, &code, &sig); rc0 = ex ? code : -1;
        ex = code = sig = 0; sy_wait_status(pid[1], 0, &ex, &code, &sig); rc1 = ex ? code : -1;
        ok(rc0 == 1 && strstr(abuf, "status=ROLLED_BACK") && strstr(abuf, "rows_removed=2"), "the failing call rolls both rows back");
        ok(rc1 == 0 && strstr(bbuf, "status=REGISTERED"), "the overlapping call still registers");
    }
    ok(count_lines(bpath, "cr-c\t") == 0 && count_lines(cpath, "interfaces.cr-c\t") == 0, "the rolled-back rows are gone");
    ok(count_lines(bpath, "cr-d\t") == 1 && count_lines(cpath, "interfaces.cr-d\t") == 1, "the survivor row is intact");
    ok(count_lines(bpath, "cr-a\t") == 1 && count_lines(bpath, "cr-b\t") == 1, "case 1 rows survived the rollback");

    /* case 3: a held lock makes the caller wait, then fail by name, touching neither file */
    {   char hb1[65], hb2[65];
        size_t n = 0; char *b = cx_read(bpath, &n); cx_sha256_hex(b, (long)n, hb1); free(b);
        b = cx_read(cpath, &n); cx_sha256_hex(b, (long)n, hb2); free(b);
        {   int holder = fork();
            if (holder == 0) {
                char lp[4400]; int fd; long z;
                pjoin(lp, sizeof lp, tables, ".register.lock");
                fd = sy_open(lp, O_RDWR | O_CREAT, 0666);
                if (fd < 0 || sy_flock(fd, 2) != 0) _exit(3);
                for (z = 0; z < 600; z++) usleep(5000);   /* hold for 3 s */
                _exit(0);
            }
            usleep(250000);   /* let the holder take it */
            {   { char out[1 << 15]; int rc;   /* env(1) carries the shortened wait into register.cx */
                    char *w[14] = { "env", "REGISTER_LOCK_MS=300", envtables, "sh", "./unisacc.com", DRIVER, "--",
                                    "cr-e", fx, "REGISTER_FIXTURE_OK", "lock timeout row", fx, "interfaces", 0 };
                    rc = run(w, out, sizeof out);
                    ok(rc == 2, "a held lock fails the caller with exit 2");
                    ok(strstr(out, "lock timeout") != 0, "the failure is named (lock timeout)");
                }
            }
            {   int ex = 0, code = 0, sig = 0; sy_wait_status(holder, 0, &ex, &code, &sig); }
        }
        ok(count_lines(bpath, "cr-e\t") == 0 && count_lines(cpath, "interfaces.cr-e\t") == 0, "the timed-out call wrote no rows");
        {   char h[65]; size_t m = 0; char *b2 = cx_read(bpath, &m); cx_sha256_hex(b2, (long)m, h); free(b2);
            ok(!strcmp(h, hb1), "batches.tsv is untouched by the timeout"); }
        {   char h[65]; size_t m = 0; char *b2 = cx_read(cpath, &m); cx_sha256_hex(b2, (long)m, h); free(b2);
            ok(!strcmp(h, hb2), "coverage.tsv is untouched by the timeout"); }
    }

    /* case 5: refusals exit 2 by name and write nothing -- an existing ID, a missing CHECK, an empty
       MARKER, a TAB in a field, a MARKER that already carries "rc0:".  These are the interfaces.cx-register coverage row's own assertions (merged
       from register-tool); the fixture
       runs them on the private copy, so a refusal can never leave a row behind in the shared tables. */
    {   char h1[65], h2[65], out[1 << 15]; int rc;
        size_t n = 0; char *b = cx_read(bpath, &n); cx_sha256_hex(b, (long)n, h1); free(b);
        b = cx_read(cpath, &n); cx_sha256_hex(b, (long)n, h2); free(b);
        {   char *a[16] = { "env", envtables, "sh", "./unisacc.com", DRIVER, "--", "cr-a", fx,
                             "REGISTER_FIXTURE_OK", "duplicate id row", fx, "interfaces", 0 };
            rc = run(a, out, sizeof out);
            ok(rc == 2 && strstr(out, "already registered"), "an existing ID is refused by name and exits 2");
        }
        {   char *a[16] = { "env", envtables, "sh", "./unisacc.com", DRIVER, "--", "cr-f",
                             "tools/no-such-check.cx", "REGISTER_FIXTURE_OK", "missing check row", fx, "interfaces", 0 };
            rc = run(a, out, sizeof out);
            ok(rc == 2 && strstr(out, "no such check"), "a missing CHECK file is refused by name and exits 2");
        }
        {   char *a[16] = { "env", envtables, "sh", "./unisacc.com", DRIVER, "--", "cr-g", fx,
                             "", "empty marker row", fx, "interfaces", 0 };
            rc = run(a, out, sizeof out);
            ok(rc == 2 && strstr(out, "empty field"), "an empty MARKER is refused by name and exits 2");
        }
        {   char *a[16] = { "env", envtables, "sh", "./unisacc.com", DRIVER, "--", "cr-h", fx,
                             "REGISTER_FIXTURE_OK", "bad\tfield", fx, "interfaces", 0 };
            rc = run(a, out, sizeof out);
            ok(rc == 2 && strstr(out, "empty field"), "a TAB in a field is refused by name and exits 2");
        }
        {   char hb[65], hc[65], h[65]; size_t m = 0; char *b2;
            b2 = cx_read(bpath, &m); cx_sha256_hex(b2, (long)m, hb); free(b2);
            b2 = cx_read(cpath, &m); cx_sha256_hex(b2, (long)m, hc); free(b2);
            {   char *a[16] = { "env", envtables, "sh", "./unisacc.com", DRIVER, "--", "cr-i", fx,
                                 "rc0:REGISTER_FIXTURE_OK", "doubled prefix row", fx, "interfaces", 0 };
                rc = run(a, out, sizeof out);
                /* a full expect as MARKER would become "rc0:rc0:.." and make every batch in the registry
                   refuse (tp_visit), so it is refused by name before the appends */
                ok(rc == 2 && strstr(out, "MARKER must be one rc0: tail"), "a MARKER carrying the rc0: prefix is refused by name and exits 2");
            }
            b2 = cx_read(bpath, &m); cx_sha256_hex(b2, (long)m, h); free(b2);
            ok(!strcmp(h, hb), "the refused MARKER left batches.tsv byte for byte");
            b2 = cx_read(cpath, &m); cx_sha256_hex(b2, (long)m, h); free(b2);
            ok(!strcmp(h, hc), "the refused MARKER left coverage.tsv byte for byte");
        }
        {   char h[65]; size_t m = 0; char *b2 = cx_read(bpath, &m); cx_sha256_hex(b2, (long)m, h); free(b2);
            ok(!strcmp(h, h1), "no refused call appended a batch row"); }
        {   char h[65]; size_t m = 0; char *b2 = cx_read(cpath, &m); cx_sha256_hex(b2, (long)m, h); free(b2);
            ok(!strcmp(h, h2), "no refused call appended a coverage row"); }
    }

    /* case 6: the rollback cannot have the lock, so it must say which rows are still where and exit by a
       dedicated code instead of a bare timeout.  The fixture never prints the registered marker and is slow
       enough for the holder below to take the lock before the rollback gets there. */
    {   char hb[65], hc[65]; size_t m = 0; char *b2 = cx_read(bpath, &m); cx_sha256_hex(b2, (long)m, hb); free(b2);
        b2 = cx_read(cpath, &m); cx_sha256_hex(b2, (long)m, hc); free(b2);
        {   char b[4096], c[4096];
            /* the row this call will append (the slow fixture, not the passing one) */
            if (cx_fmt(b, sizeof b, "cr-j\tIMPLEMENTED\tinterfaces\ttools/register-fixture-slow.cx\tSOURCE\tlnx/x86_64\t55\t-\ttools/register-fixture-slow.cx\t-\tinterfaces.cr-j\trc0:REGISTER_FIXTURE_OK\tproduct\tcommit\n")
                || cx_fmt(c, sizeof c, "interfaces.cr-j\tinterfaces\tIMPLEMENTED_SEPARATE_BATCH\tdirty rollback row\ttools/register-fixture-slow.cx\n")) die("row bound", "cr-j");
            int holder = fork();
            if (holder == 0) {
                /* Take the lock only once the row is in the table: register holds it across its own appends
                   and --list, and the batch run that follows is outside it.  Polling for the row makes the
                   window deterministic instead of a sleep race.
                   The lock must cover register's whole batch run *and* its 3x300 ms rollback, so it is
                   released only after the register child exits: a fixed hold (3 s) was the same order as
                   register's 2.6-3.0 s total and the case went red on 4 of 6 runs.  A done-file written by
                   the parent after the child is reaped is the release signal. */
                char lp[4400], dp[4400]; int fd, won = 0; long z; size_t m = 0;
                for (z = 0; z < 200 && !won; z++) {
                    char *t = cx_read(bpath, &m);
                    if (t) { won = strstr(t, b) != 0; free(t); }
                    if (!won) usleep(10000);
                }
                if (!won) _exit(4);
                pjoin(lp, sizeof lp, tables, ".register.lock");
                fd = sy_open(lp, O_RDWR | O_CREAT, 0666);
                if (fd < 0 || sy_flock(fd, 2) != 0) _exit(3);
                pjoin(dp, sizeof dp, tables, ".register.holder-done");
                for (z = 0; z < 4000 && !sy_exists(dp); z++) usleep(5000);   /* wait for the parent's signal */
                _exit(0);
            }
            {   char out[1 << 15]; int rc;
                char *w[16] = { "env", "REGISTER_ROLLBACK_LOCK_MS=300", envtables, "sh", "./unisacc.com", DRIVER, "--",
                                "cr-j", "tools/register-fixture-slow.cx", "REGISTER_FIXTURE_OK", "dirty rollback row",
                                "tools/register-fixture-slow.cx", "interfaces", 0 };
                rc = run(w, out, sizeof out);
                ok(rc == 3, "a rollback that cannot lock exits 3");
                ok(strstr(out, "tables may be dirty: leftover row cr-j at batches.tsv:") != 0
                   && strstr(out, "coverage.tsv:") != 0, "the dirty tables are named with the left-over row's line numbers");
            }
            {   int ex = 0, code = 0, sig = 0; char dp[4400];
                /* The register run above has returned, so its rollback has already tried the lock.
                   Write the done-file first (that is what releases the holder), then reap it: reaping
                   first would deadlock, because the child waits for this file.  The lock therefore spans
                   register's whole batch run plus its 3x300 ms rollback instead of a fixed 3 s. */
                if (cx_fmt(dp, sizeof dp, "%s/.register.holder-done", tables)) die("path bound", "holder-done");
                {   FILE *df = fopen(dp, "wb");
                    if (!df || fputc('x', df) == EOF || fclose(df)) die("holder-done write", dp);
                }
                sy_wait_status(holder, 0, &ex, &code, &sig);
            }
        }
        /* the rows really are there: the message was not a guess; remove them by exact content */
        {   char b[4096], c[4096]; int removed = 0;
            if (cx_fmt(b, sizeof b, "cr-j\tIMPLEMENTED\tinterfaces\ttools/register-fixture-slow.cx\tSOURCE\tlnx/x86_64\t55\t-\ttools/register-fixture-slow.cx\t-\tinterfaces.cr-j\trc0:REGISTER_FIXTURE_OK\tproduct\tcommit\n")
                || cx_fmt(c, sizeof c, "interfaces.cr-j\tinterfaces\tIMPLEMENTED_SEPARATE_BATCH\tdirty rollback row\ttools/register-fixture-slow.cx\n")) die("row bound", "cr-j");
            removed += take_out(bpath, b) == 0; removed += take_out(cpath, c) == 0;
            ok(removed == 2, "the dirty rows were still in both tables");
        }
        {   char h[65]; b2 = cx_read(bpath, &m); cx_sha256_hex(b2, (long)m, h); free(b2);
            ok(!strcmp(h, hb), "batches.tsv is back to its pre-case content"); }
        {   char h[65]; b2 = cx_read(cpath, &m); cx_sha256_hex(b2, (long)m, h); free(b2);
            ok(!strcmp(h, hc), "coverage.tsv is back to its pre-case content"); }
    }

    /* cleanup: remove exactly our own rows, then require the originals back byte for byte */
    {   int removed = 0;
        long nb0 = before_b, nc0 = before_c;
        for (j = 0; j < 4; j++) {
            if (take_out(bpath, rowsb[j]) == 0) removed++;
            if (take_out(cpath, rowsc[j]) == 0) removed++;
        }
        ok(removed == 6, "cleanup removed exactly the six check rows");
        ok(count_all(bpath) == nb0 && count_all(cpath) == nc0, "both registries are back to their original length");
        {   char h[65]; size_t m = 0; char *b = cx_read(bpath, &m); cx_sha256_hex(b, (long)m, h); free(b);
            ok(!strcmp(h, orig_hb), "batches.tsv restored byte for byte (other lanes' rows intact)"); }
        {   char h[65]; size_t m = 0; char *b = cx_read(cpath, &m); cx_sha256_hex(b, (long)m, h); free(b);
            ok(!strcmp(h, orig_hc), "coverage.tsv restored byte for byte (other lanes' rows intact)"); }
        for (i = 0; i < 4; i++) {
            if (count_lines(bpath, ids[i]) || count_lines(cpath, ids[i])) { failed++; checks++; printf("FAIL\tresidue row %s\n", ids[i]); break; }
        }
        {   char h[65]; size_t m = 0; char *b = cx_read(rbpath, &m); cx_sha256_hex(b, (long)m, h); free(b);
            ok(!strcmp(h, real_hb), "tests/batches.tsv was never written (the fixture used a private copy)"); }
        {   char h[65]; size_t m = 0; char *b = cx_read(rcpath, &m); cx_sha256_hex(b, (long)m, h); free(b);
            ok(!strcmp(h, real_hc), "tests/coverage.tsv was never written (the fixture used a private copy)"); }
        {   char p[4400]; if (!cx_fmt(p, sizeof p, "%s/batches.tsv", tables)) sy_unlink(p);
            if (!cx_fmt(p, sizeof p, "%s/coverage.tsv", tables)) sy_unlink(p);
            if (!cx_fmt(p, sizeof p, "%s/.register.lock", tables)) sy_unlink(p);
            if (!cx_fmt(p, sizeof p, "%s/.register.holder-done", tables)) sy_unlink(p);
            if (sy_rmdir(tables) != 0) { checks++; failed++; printf("FAIL\tprivate copy not removed\n"); }
        }
    }
    printf("CX_REGISTER\tchecks=%d\tfailed=%d\n", checks, failed);
    return failed ? 1 : 0;
}
