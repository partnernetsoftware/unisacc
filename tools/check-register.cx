/* tools/check-register.cx -- the registry lock in tools/register.cx, on a PRIVATE copy of the tables.
 *
 *   sh ./unisacc.com tools/check-register.cx -- --prepare ABS_OUT
 *
 * The fixture rows never touch tests/batches.tsv and tests/coverage.tsv: the check copies them into
 * ABS_OUT/check-register-tables-XXXXXX/tests, points register calls at that copy with UNISACC_TABLES, and
 * asserts byte-for-byte on the copy.  The real tables are asserted unchanged at the end, so a concurrent
 * registration lane can no longer make this check fail by writing in the same window (2026-11-02: one
 * such false FAIL).  DRIVER = the register under test (tools/register.cx).
 *
 *   sh ./unisacc.com tools/check-register.cx -- --out ABS_OUT
 *
 * Two registrations overlap on tests/batches.tsv and tests/coverage.tsv; before the lock they saw each
 * other's half-written registry and rolled back through no fault of either row (2026-11-02, three
 * ROLLED_BACK in a row).  Cases:
 *   1. two concurrent registrations of fresh IDs both succeed: exactly one row of each in both files,
 *      nothing lost, nothing duplicated;
 *   2. one concurrent registration fails its batch (marker never printed) and rolls back while the other
 *      succeeds: only the failing call's two lines are gone, the other's row survives;
 *   3. a held lock makes a caller wait and then fail by name (lock timeout), touching neither file;
 *   4. a rollback that cannot take the lock at all reports the two left-over rows with their line numbers
 *      and exits 3 (status=DIRTY), never a bare lock timeout;
 *   5. a MARKER that already carries "rc0:" is refused and both files stay byte-identical;
 *   6. after the check removes its own rows both registries are byte-identical to the originals.
 * The fixture batches are real: tools/register-fixture.cx prints REGISTER_FIXTURE_OK, so run-batch passes.
 * The --tool fixture starts two callers together; register serializes both verification and writes
 * under its lock. A separate verifier fixture edits tables inside that interval to test rollback.
 * Rows are removed by exact line content, never by restoring the whole file, so a row someone else
 * appended meanwhile stays.
 * Mode --root-preflight (batch register-root-preflight, marker CX_REGISTER_ROOT): register started in a
 * root without ./unisacc.com refuses by name with the fixing command, exit 2, nothing written; a missing
 * out/ is not a refusal and none is created (the work directories live under sy_tmpdir()). */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use sys.proc
#pragma unisa use sys.posix
#pragma unisa use sys.sha
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use cxlib.procrun
#pragma unisa use cxlib.runnerprep
#pragma unisa use cxlib.loadavg

static int failed, checks;
static char root[4096], fx[4400], bpath[4400], cpath[4400], tables[4400], rbpath[4400], rcpath[4400], envtables[4440];
static char prepared_driver[4400], output[4400];
static void native_args(char **v) {
    if (!prepared_driver[0]) return;
    for (int i=0; v[i] && v[i+1] && v[i+2] && v[i+3]; i++) {
        if (!strcmp(v[i], "sh") && !strcmp(v[i+1], "./unisacc.com") && !strcmp(v[i+2], "tools/register.cx") && !strcmp(v[i+3], "--")) {
            v[i]=prepared_driver; int j=i+1; do { v[j]=v[j+3]; } while(v[j++]); return;
        }
    }
}
#define DRIVER "tools/register.cx"

static void ok(int c, const char *what) {
    checks++;
    printf("%s\t%s\n", c ? "PASS" : "FAIL", what);
    if (!c) failed++;
}

static void die(const char *a, const char *b) { fprintf(stderr, "check-register: %s%s%s\n", a, b ? ": " : "", b ? b : ""); exit(2); }

static void pjoin(char *out, size_t cap, const char *a, const char *b) {
    if (cx_fmt(out, cap, "%s/%s", a, b)) die("path bound", b);
}

/* number of lines in P that start with PREFIX */
static long count_lines(const char *p, const char *prefix) {
    size_t n = 0, pl = strlen(prefix); char *b = cx_read(p, &n), *s; long at = 0, c = 0;
    if (!b) die("read", p);
    while (at < (long)n) {
        s = memchr(b + at, '\n', n - (size_t)at);
        {   long e = s ? (long)(s - (b + at)) : (long)n - at;
            if (e >= (long)pl && !memcmp(b + at, prefix, pl)) c++;
            at += e + 1;
        }
    }
    free(b);
    return c;
}

static long count_all(const char *p) {
    size_t n = 0; char *b = cx_read(p, &n), *s; long at = 0, c = 0;
    if (!b) die("read", p);
    while (at < (long)n) { s = memchr(b + at, '\n', n - (size_t)at); at += (s ? (long)(s - (b + at)) : (long)n - at) + 1; c++; }
    free(b);
    return c;
}

/* remove exactly one line equal to LINE (which ends in \n); 0 when found and removed.
   Every other line, including ones appended meanwhile, is carried over verbatim. */
static int take_out(const char *path, const char *line) {
    size_t n = 0, ll = strlen(line); char *b = cx_read(path, &n), *s; long at = 0; int bad = 0;
    if (!b) return 1;
    while (at < (long)n) {
        s = memchr(b + at, '\n', n - (size_t)at);
        {   long e = s ? (long)(s - (b + at)) : (long)n - at, ln = e + 1;
            if (ln == (long)ll && !memcmp(b + at, line, ll)) {
                FILE *f = fopen(path, "wb");
                if (!f) { free(b); return 1; }
                if (fwrite(b, 1, (size_t)at, f) != (size_t)at) bad = 1;
                if (fwrite(b + at + ln, 1, n - (size_t)at - (size_t)ln, f) != n - (size_t)at - (size_t)ln) bad = 1;
                if (fclose(f) != 0) bad = 1;
                free(b);
                return bad;
            }
            at += ln;
        }
    }
    free(b);
    return 1;
}

/* run ARGV bounded at 58 s (cxlib.procrun: on timeout the process group is killed and the reason is in OUT);
   the last cap-1 bytes of stderr followed by stdout into OUT (terminated): exit code, or -1 when it did not run to an exit */
static int run(char **argv, char *out, long cap) {
    char *native[64]; int ai=0;
    while(argv[ai]) { if(ai==63) die("argv bound",0); native[ai]=argv[ai]; ai++; }
    native[ai]=0; native_args(native);
    pr_result r; int rc; long en, on, skip, k, n = 0;
    out[0] = 0;
    if (pr_run("check-register child", native, 0, 0, 58, &r)) { if (cx_fmt(out, (size_t)cap, "%s", r.why)) out[0] = 0; return -1; }
    en = r.err ? (long)r.errn : 0; on = r.out ? (long)r.outn : 0;
    skip = en + on > cap - 1 ? en + on - (cap - 1) : 0;
    for (k = skip; k < en + on; k++) out[n++] = k < en ? r.err[k] : r.out[k - en];
    out[n] = 0;
    rc = r.rc; pr_free(&r);
    return rc < 0 ? -1 : rc;
}

/* the two registry lines tools/register.cx appends for ID/MARKER/TEXT */
static void rows(char *b, size_t bn, char *c, size_t cn, const char *id, const char *marker, const char *text) {
    if (cx_fmt(b, bn, "%s\tIMPLEMENTED\tinterfaces\t%s\tSOURCE\tlnx/x86_64\t55\t-\t%s\t-\tinterfaces.%s\trc0:%s\tproduct\tcommit\n",
               id, fx, fx, id, marker)) die("row bound", id);
    if (cx_fmt(c, cn, "interfaces.%s\tinterfaces\tIMPLEMENTED_SEPARATE_BATCH\t%s\t%s\n", id, text, fx)) die("row bound", id);
}

/* copy SRC over DST byte for byte; 0 on success */
static int copy_file(const char *src, const char *dst) {
    size_t n = 0; char *b = cx_read(src, &n); FILE *f; int bad = 0;
    if (!b) return 1;
    f = fopen(dst, "wb");
    if (!f) { free(b); return 1; }
    if (fwrite(b, 1, n, f) != n) bad = 1;
    if (fclose(f) != 0) bad = 1;
    free(b);
    return bad;
}

/* ARGV for one register call; the environment carries the private table directory into the child
   (the runtime's setenv is in-process only, so env(1) is the way a child sees a variable). */
static void reg_argv(char **av, const char **store, const char *id, const char *marker, const char *text) {
    (void)store;
    av[0] = "env"; av[1] = (char *)envtables; av[2] = "sh"; av[3] = "./unisacc.com"; av[4] = DRIVER; av[5] = "--";
    av[6] = (char *)id; av[7] = fx; av[8] = (char *)marker; av[9] = (char *)text; av[10] = fx; av[11] = "interfaces"; av[12] = 0;
    native_args(av);
}

/* A separate bounded mode keeps the existing concurrency cases unchanged. DRIVER_SOURCE may
 * explicitly select a frozen old source for a paired failing regression, never a cached result. */
static int metadata_rollback(const char *driver) {
    const char *bad="invalid-existing-metadata\tBROKEN\n";
    FILE *f=fopen(bpath,"ab");if(!f||fwrite(bad,1,strlen(bad),f)!=strlen(bad)||fclose(f))die("invalid metadata fixture",bpath);
    size_t bn,cn;char *beforeb=cx_read(bpath,&bn),*beforec=cx_read(cpath,&cn);
    if(!beforeb||!beforec)die("fixture snapshot",tables);
    char out[1<<15];char *a[]={"env","REGISTER_LOCK_MS=300","REGISTER_ROLLBACK_LOCK_MS=100",envtables,
        "./tools/bound","15","sh","./unisacc.com",(char *)driver,"--","cr-invalid-metadata",fx,
        "REGISTER_FIXTURE_OK","invalid existing metadata rollback",fx,"interfaces",0};
    int rc=run(a,out,sizeof out);printf("METADATA_CHILD\trc=%d\tretained=%s\n%s",rc,tables,out);
    ok(rc==1,"metadata refusal exits 1 within the child bound");
    ok(strstr(out,"metadata_valid!=1")&&strstr(out,"REFUSE"),"existing invalid metadata really refuses list");
    ok(strstr(out,"status=ROLLED_BACK")&&strstr(out,"rows_removed=2"),"metadata refusal reports exact two-row rollback");
    ok(!strstr(out,"status=DIRTY")&&!strstr(out,"lock timeout"),"own append lock does not obstruct rollback");
    ok(!count_lines(bpath,"cr-invalid-metadata\t")&&!count_lines(cpath,"interfaces.cr-invalid-metadata\t"),"both attempted rows are absent");
    size_t an,acn;char *afterb=cx_read(bpath,&an),*afterc=cx_read(cpath,&acn);
    ok(afterb&&an==bn&&!memcmp(afterb,beforeb,bn),"original invalid batch table preserved byte for byte");
    ok(afterc&&acn==cn&&!memcmp(afterc,beforec,cn),"original coverage table preserved byte for byte");
    ok(count_lines(bpath,"invalid-existing-metadata\t")==1,"preexisting invalid row is preserved");
    free(beforeb);free(beforec);free(afterb);free(afterc);
    printf("CX_REGISTER_METADATA\tchecks=%d\tfailed=%d\tretained=%s\n",checks,failed,tables);
    return failed?1:0;
}

/* run ARGV with CWD as the child's directory, bounded at 30 s; stderr then stdout into OUT; exit code or -1 */
static int run_in(const char *cwd, char **argv, char *out, long cap) {
    pr_result r; int rc;
    out[0] = 0;
    if (pr_run("register-root", argv, cwd, 0, 30, &r)) { cx_fmt(out, (size_t)cap, "%s", r.why); return -1; }
    if (cx_fmt(out, (size_t)cap, "%s%s", r.err ? r.err : "", r.out ? r.out : "")) out[0] = 0;
    rc = r.rc; pr_free(&r);
    return rc;
}
/* 1 when the private registry table at PATH (the fixture's behavioural output, not a source file) holds TEXT */
static int registry_has(const char *path, const char *text) {
    size_t n = 0, tl = strlen(text), i; char *b = cx_read(path, &n); int hit = 0;
    if (!b) return 0;
    for (i = 0; !hit && tl && i + tl <= n; i++) hit = !memcmp(b + i, text, tl);
    free(b);
    return hit;
}
static void sha_of(const char *p, char *h) { size_t n = 0; char *b = cx_read(p, &n); if (!b) die("read", p); cx_sha256_hex(b, (long)n, h); free(b); }

/* --root-preflight [DRIVER]: register started in a root without ./unisacc.com and/or out/ (a private clone)
   must refuse by name with the fixing command and exit 2 before anything is written.  The root is an empty
   temp directory used as the child's cwd; register itself is this checkout's, started by absolute path.
   DRIVER (absolute, or relative to this root) selects another register source for a paired run: the
   pre-fix register (git show eae7faf84a^:tools/register.cx) must turn the named-refusal items red. */
static int root_preflight(const char *driver) {
    static char out[1 << 15]; char hold[4400], com[4400], drv[4400], outdir[4400], fake[4400], hb[65], hc[65], h[65]; int rc;
    char *a[] = {"env", envtables, "sh", com, drv, "--", "cr-root", "tools/register-fixture.cx", "REGISTER_FIXTURE_OK", "root preflight row", "tools/register-fixture.cx", "interfaces", 0};
    if (cx_fmt(hold, sizeof hold, "%s/check-register-root-XXXXXX", output) || !mkdtemp(hold)) die("mkdtemp", "root");
    pjoin(com, sizeof com, root, "unisacc.com");
    if (driver[0] == '/') { if (cx_fmt(drv, sizeof drv, "%s", driver)) die("path bound", driver); } else pjoin(drv, sizeof drv, root, driver);
    if (sy_exists(drv) != 1) die("no such driver", drv);
    printf("ROOT_PREFLIGHT_DRIVER\t%s\n", drv);
    pjoin(outdir, sizeof outdir, hold, "out"); pjoin(fake, sizeof fake, hold, "unisacc.com");
    sha_of(bpath, hb); sha_of(cpath, hc);
    /* neither: both are named, each with its fix */
    rc = run_in(hold, a, out, sizeof out);
    ok(rc == 2, "a root with neither out/ nor unisacc.com is refused with exit 2");
    ok(!strstr(out, "no out/ directory") && !strstr(out, "mkdir out") && sy_exists(outdir) != 1, "a missing out/ is not a refusal, no fix asks for mkdir out, and none is created");
    ok(strstr(out, "REFUSE no ./unisacc.com in this root") && strstr(out, "fix: cp SHARED_ROOT/unisacc.com"), "missing unisacc.com is named with the fixing command");
    ok(!strstr(out, "ROLLED_BACK") && strstr(out, "nothing was written"), "the refusal is not a rollback and says nothing was written");
    /* out/ only: unisacc.com alone is named */
    if (sy_mkdir(outdir, 0700)) die("mkdir", outdir);
    rc = run_in(hold, a, out, sizeof out);
    ok(rc == 2 && strstr(out, "REFUSE no ./unisacc.com in this root") && !strstr(out, "no out/ directory"), "with out/ present only the missing unisacc.com is named");
    /* unisacc.com only: out/ is no longer required (project owner 2026-11-13, nothing goes under out/), so the
       preflight passes to the next refusal and no out/ appears */
    if (sy_rmdir(outdir)) die("rmdir", outdir);
    {   FILE *f = fopen(fake, "wb"); if (!f || fputs("placeholder\n", f) == EOF || fclose(f)) die("write", fake); }
    rc = run_in(hold, a, out, sizeof out);
    ok(rc == 2 && strstr(out, "no such check") && !strstr(out, "REFUSE no ") && sy_exists(outdir) != 1, "with unisacc.com present a missing out/ is not refused and not created (next refusal: no such check)");
    /* out as a regular file is left alone and does not matter either */
    {   FILE *f = fopen(outdir, "wb"); if (!f || fclose(f)) die("write", outdir); }
    rc = run_in(hold, a, out, sizeof out);
    ok(rc == 2 && strstr(out, "no such check") && !strstr(out, "no out/ directory"), "out as a regular file is not a root refusal (next refusal: no such check)");
    if (sy_unlink(outdir)) die("unlink", outdir);
    /* both present: the preflight lets the call through to the next refusal (the check path does not exist in this root) */
    if (sy_mkdir(outdir, 0700)) die("mkdir", outdir);
    rc = run_in(hold, a, out, sizeof out);
    ok(rc == 2 && strstr(out, "no such check") && !strstr(out, "REFUSE no "), "with both present the root preflight passes (next refusal: no such check)");
    sha_of(bpath, h); ok(!strcmp(h, hb), "no refused call wrote batches.tsv");
    sha_of(cpath, h); ok(!strcmp(h, hc), "no refused call wrote coverage.tsv");
    sy_unlink(fake); sy_rmdir(outdir);
    ok(sy_rmdir(hold) == 0, "the refused calls left nothing in the root (no out/register-* reservation, no lock)");
    sy_unlink(bpath); sy_unlink(cpath);
    {   char p[4400]; pjoin(p, sizeof p, tables, ".register.lock"); sy_unlink(p); sy_rmdir(tables); }
    printf("CX_REGISTER_ROOT\tchecks=%d\tfailed=%d\n", checks, failed);
    return failed ? 1 : 0;
}

/* --tool-check: tools/register.cx --tool in a private git root (git init in a temp directory; cx, ext,
   cxroot.tsv and unisacc.com are links to this checkout, tools/bound and tests/tools-compile.cx are copies).
   Seven tracked tools, one shard row plus one stale row past the range.  Asserted: the two new tools land at
   their C byte order places ('-' before letters, zz last), the shard rows follow the count both ways (001
   added right after 000, the stale 005 taken out), new files are staged, tools-compile --shards accepts the
   result, a second call changes no byte, a 64-hex literal is reported and with --pin-owner registered once,
   and a refused or failed call leaves tables and index as they were. */
static void put_file(const char *dir, const char *rel, const char *text) {
    char p[4400]; FILE *f; pjoin(p, sizeof p, dir, rel);
    f = fopen(p, "wb"); if (!f || fputs(text, f) == EOF || fclose(f)) die("write", p);
}
static void candidate_registration(void) {
    char dev[4096], entry[4400], pkg[4400], nets[4400], launcher[4400];
    char e[65], p[65], n[65], l[65], product[65], identity[65], text[32768], receipt[512], log[8192];
    char b[65], c[65], after_b[65], after_c[65];
    pjoin(dev,sizeof dev,tables,"dev");
    if(mkdir(dev,0700))die("mkdir",dev);
    pjoin(entry,sizeof entry,dev,"entry"); pjoin(pkg,sizeof pkg,dev,"pkg");
    pjoin(nets,sizeof nets,dev,"nets"); pjoin(launcher,sizeof launcher,dev,"unisacc.com");
    put_file(dev,"entry","#!/bin/sh\necho DEV_MARKER\n");
    put_file(dev,"pkg","package\n"); put_file(dev,"nets","nets\n");
    if(cx_fmt(text,sizeof text,"#!/bin/sh\n# NOT_RELEASE dev-product-v1 scope=LOCAL (tools/dev-product.cx); lnx/x86_64 only\nexec env UNISA_CONTAINER='%s' UNISACC_LOCAL=1 UNISACC_CACHE_DIR=\"${DEV_PRODUCT_CACHE:-%s/runcache}\" '%s' \"$@\"\n",pkg,dev,entry))die("launcher bound",0);
    put_file(dev,"unisacc.com",text);
    if(chmod(entry,0700)||chmod(launcher,0700))die("chmod",dev);
    sha_of(entry,e); sha_of(pkg,p); sha_of(nets,n); sha_of(launcher,l);
    if(cx_fmt(text,sizeof text,"%s\n%s\n",e,p))die("digest bound",0);
    cx_sha256_hex(text,strlen(text),product);
    if(cx_fmt(text,sizeof text,"NOT_RELEASE\tdev-product-v1\nentry\t%s\t%s\npkg\t%s\t%s\nnets_pkg\t%s\t%s\nproduct\t%s\t%s\nscope\tLOCAL\n",entry,e,pkg,p,nets,n,launcher,product))die("manifest bound",0);
    put_file(dev,"receipt.tsv",text);
    if(cx_fmt(text,sizeof text,"dev-product-v1\nlauncher\t%s\nentry\t%s\npkg\t%s\nnets_pkg\t%s\n",l,e,p,n))die("identity bound",0);
    cx_sha256_hex(text,strlen(text),identity);
    if(cx_fmt(receipt,sizeof receipt,"BATCH_RUN\tid=cr-dev\tstatus=PASS\trc=0\ttransport=0\tmarker=DEV_MARKER\tcandidate=%s\t",identity))die("receipt bound",0);
    char *args[]={"env",envtables,prepared_driver,"cr-dev",fx,"DEV_MARKER","explicit candidate",fx,"--runner",dev,0};
    int rc=run(args,log,sizeof log);
    ok(rc==0 && strstr(log,receipt) && strstr(log,"REGISTER\tid=cr-dev\tstatus=REGISTERED\n"),"explicit candidate produces its own PASS receipt and registers");
    sha_of(bpath,b); sha_of(cpath,c);
    put_file(dev,"pkg","changed package\n");
    args[3]="cr-dev-bad";
    rc=run(args,log,sizeof log);
    sha_of(bpath,after_b); sha_of(cpath,after_c);
    ok(rc==1 && strstr(log,"REFUSE candidate members pkg=") && strstr(log,":sha-mismatch") && strstr(log,"REGISTER\tid=cr-dev-bad\tstatus=ROLLED_BACK\trows_removed=2\n") && !strcmp(b,after_b) && !strcmp(c,after_c),"changed candidate rolls back only its own rows");
}
static void concurrent_tools(const char *dir,const char *one,const char *two,int right_rc){
    char *left[]={prepared_driver,"--tool",(char*)one,0},*right[]={prepared_driver,"--tool",(char*)two,0};
    char msg[4096];int pid=fork();
    if(pid<0)die("fork","register pair");
    if(pid==0)_exit(run_in(dir,left,msg,sizeof msg));
    int rc=run_in(dir,right,msg,sizeof msg),ex=0,code=-1,sig=0;
    sy_wait_status(pid,0,&ex,&code,&sig);
    ok(ex && code==0 && rc==right_rc,right_rc?"serialized tool requests keep the successful registration":"two simultaneous callers both complete under the registry lock");
}
static int tool_check(void) {
    static char out[1 << 15], src[4096]; char hold[4400], a[4400], b[4400], sp[4400], bp[4400], pp[4400], hs[65], hb[65], hp[65], h[65], hex[65], pinrow[400];
    const char *links[] = { "cx", "ext", "cxroot.tsv", "unisacc.com" }, *copies[] = { "tools/bound", "tools/bound.c", "tests/tools-compile.cx" };
    const char *old[] = { "ta", "tb", "tc", "td", "te", "tf", "tg" };
    int i, rc;
    char *gi[] = {"git", "init", "-q", ".", 0}, *ga[] = {"git", "add", "--", "tools/ta.cx", "tools/tb.cx", "tools/tc.cx", "tools/td.cx", "tools/te.cx", "tools/tf.cx", "tools/tg.cx", 0};
    char *r1[] = {prepared_driver, "--tool", "tools/tzz.cx", "--tool", "tools/t-new.cx", 0};
    char *r2[] = {prepared_driver, "--tool", "tools/tzz.cx", "--tool", "tools/t-new.cx", "--pin-owner", "fx", 0};
    char *rm[] = {prepared_driver, "--tool", "tools/absent.cx", 0};
    char *rq[] = {prepared_driver, "--tool", "tools/tq.cx", 0};
    char *gs[] = {"git", "add", "--", "tools/stray.cx", 0}, *gq[] = {"git", "ls-files", "--error-unmatch", "--", "tools/tq.cx", 0};
    char *gn[] = {"git", "ls-files", "--error-unmatch", "--", "tools/t-new.cx", "tools/tzz.cx", 0};
    char *sh[] = {"sh", "./unisacc.com", "tests/tools-compile.cx", "--", "--shards", ".", 0};
    if (cx_fmt(hold, sizeof hold, "%s/check-register-tool-XXXXXX", output) || !mkdtemp(hold)) die("mkdtemp", "tool");
    pjoin(a, sizeof a, hold, "tools"); if (sy_mkdir(a, 0700)) die("mkdir", a);
    pjoin(a, sizeof a, hold, "tests"); if (sy_mkdir(a, 0700)) die("mkdir", a);
    for (i = 0; i < 4; i++) { pjoin(a, sizeof a, root, links[i]); pjoin(b, sizeof b, hold, links[i]); if (symlink(a, b)) die("symlink", b); }
    for (i = 0; i < 3; i++) { pjoin(a, sizeof a, root, copies[i]); pjoin(b, sizeof b, hold, copies[i]); if (copy_file(a, b)) die("copy", b); }
    pjoin(a, sizeof a, hold, "tools/bound"); if (chmod(a, 0755)) die("chmod", a);
    src[0] = 0;
    for (i = 0; i < 7; i++) {
        char rel[64]; size_t n = strlen(src);
        if (cx_fmt(rel, sizeof rel, "tools/%s.cx", old[i]) || cx_fmt(src + n, sizeof src - n, "%s\tregular\n", rel)) die("bound", "fixture");
        put_file(hold, rel, "int main(void){return 0;}\n");
    }
    put_file(hold, "tests/tools-compile-sources.tsv", src);
#define TC_ROW(N3, N) "tools-compile-" N3 "\tIMPLEMENTED\tcontract\ttests/tools-compile.cx\tSOURCE\tlnx/x86_64\t55\t-\ttests/tools-compile.cx\t{root};{out};" N "\ttools.compile-all\trc0:TOOLS_COMPILE\tproduct\tdaily\n"
    put_file(hold, "tests/batches.tsv", "x-before\tx\n" TC_ROW("000", "0") "x-after\tx\n" TC_ROW("005", "5") "x-last\tx\n");
    put_file(hold, "tools/pins.tsv", "path\tkind\ttarget\tvalue\towner\tstatus\n");
    memset(hex, 'a', 64); hex[64] = 0;   /* built here: a 64-hex literal in this source would itself need a pins row */
    if (cx_fmt(src, sizeof src, "static const char *k = \"%s\";\nint main(void){return !k;}\n", hex)) die("bound", "hex");
    put_file(hold, "tools/t-new.cx", src); put_file(hold, "tools/tzz.cx", "int main(void){return 0;}\n");
    pjoin(sp, sizeof sp, hold, "tests/tools-compile-sources.tsv"); pjoin(bp, sizeof bp, hold, "tests/batches.tsv"); pjoin(pp, sizeof pp, hold, "tools/pins.tsv");
    if (run_in(hold, gi, out, sizeof out) || run_in(hold, ga, out, sizeof out)) die("git fixture", out);
    /* refused before anything is written */
    sha_of(sp, hs); sha_of(bp, hb);
    rc = run_in(hold, rm, out, sizeof out);
    ok(rc == 2 && strstr(out, "no such file") && strstr(out, "tools/absent.cx"), "--tool with a missing file is refused by name, exit 2");
    sha_of(sp, h); ok(!strcmp(h, hs), "the refused --tool wrote no sources row"); sha_of(bp, h); ok(!strcmp(h, hb), "the refused --tool wrote no batches row");
    /* first registration */
    rc = run_in(hold, r1, out, sizeof out);
    ok(rc == 0 && strstr(out, "REGISTER_TOOL\tstatus=REGISTERED"), "--tool with two new tools ends REGISTERED");
    ok(strstr(out, "sources_added=2\tinventory=9\tshards=2\tshard_rows_added=1\tshard_rows_removed=1"), "two sources added, nine sources are two shards, one shard row added and the stale one removed");
    {   size_t n = 0; char *t = cx_read(sp, &n);
        const char *want = "tools/t-new.cx\tregular\ntools/ta.cx\tregular\ntools/tb.cx\tregular\ntools/tc.cx\tregular\ntools/td.cx\tregular\ntools/te.cx\tregular\ntools/tf.cx\tregular\ntools/tg.cx\tregular\ntools/tzz.cx\tregular\n";
        ok(t && n == strlen(want) && !memcmp(t, want, n), "the new tools stand at their C byte order places (t-new before ta, tzz last)"); free(t);
    }
    ok(count_lines(bp, "tools-compile-") == 2 && count_lines(bp, "tools-compile-000\t") == 1 && count_lines(bp, "tools-compile-001\t") == 1, "the shard rows are exactly 000 and 001");
    ok(registry_has(bp, "x-before\tx\n" TC_ROW("000", "0") TC_ROW("001", "1") "x-after\tx\nx-last\tx\n") && count_all(bp) == 5, "001 is inserted right after 000 in the contract format, 005 is gone, other rows untouched");
    ok(run_in(hold, gn, out, sizeof out) == 0, "both new tools are staged in the index");
    rc = run_in(hold, sh, out, sizeof out);
    ok(rc == 0 && strstr(out, "2\n") && !strstr(out, "REFUSE"), "tests/tools-compile.cx --shards accepts the registered state and prints 2");
    {
        char *dry[]={prepared_driver,"--tool","--sync","--dry",0};
        char cv[4500],decl[4500],idx[4500],c0[65],d0[65],i0[65];
        pjoin(cv,sizeof cv,hold,"tests/coverage.tsv");pjoin(decl,sizeof decl,hold,"tests/batch-product-inputs.tsv");
        pjoin(idx,sizeof idx,hold,".git/index");
        put_file(hold,"tests/coverage.tsv","coverage\tuntouched\n");
        put_file(hold,"tests/batch-product-inputs.tsv","id\tkeep\ttools/fx.cx\tfixture\n");
        sha_of(cv,c0);sha_of(decl,d0);sha_of(idx,i0);
        size_t n;char *saved=cx_read(bp,&n);if(!saved)die("read",bp);
        put_file(hold,"tests/batches.tsv","x-before\tx\n" TC_ROW("000","0") "x-after\tx\nx-last\tx\n");
        sha_of(bp,hb);sha_of(sp,hs);
        rc=run_in(hold,dry,out,sizeof out);
        if(rc)fprintf(stderr,"sync dry rc=%d %s\n",rc,out);
        ok(rc==0 && strstr(out,"shard_rows_added=1"),"sync dry reports the missing registered shard");
        ok(strstr(out,"REGISTER_SYNC_TABLE\ttests/coverage.tsv\tnot_checked\n") &&
           strstr(out,"REGISTER_SYNC_TABLE\ttests/batch-product-inputs.tsv\tnot_checked\n"),
           "sync dry identifies tables without a proposed delta");
        sha_of(bp,h);ok(!strcmp(h,hb),"sync dry leaves shard rows byte-identical");
        sha_of(sp,h);ok(!strcmp(h,hs),"sync dry leaves source inventory byte-identical");
        sha_of(cv,h);ok(!strcmp(h,c0),"sync dry leaves coverage byte-identical");
        sha_of(decl,h);ok(!strcmp(h,d0),"sync dry leaves product declarations byte-identical");
        sha_of(idx,h);ok(!strcmp(h,i0),"sync dry leaves git index byte-identical");
        put_file(hold,"tests/batches.tsv","x-before\tx\n" TC_ROW("000","0") TC_ROW("01","1") "x-after\tx\nx-last\tx\n");
        rc=run_in(hold,dry,out,sizeof out);
        ok(rc==2 && strstr(out,"REFUSE batch contract or duplicate"),"sync dry refuses a malformed in-range shard id");
        if(cx_write(bp,saved,n))die("restore private shard fixture",bp);
        free(saved);
    }
    rc = run_in(hold, r1, out, sizeof out);   /* the literal is still undeclared: reported again, nothing written */
    ok(strstr(out, "PIN_NEEDED\ttools/t-new.cx:1\t") && strstr(out, "pins_needed=1") && count_all(pp) == 1, "a 64-hex literal without a pins row is reported as PIN_NEEDED with its line, pins.tsv untouched");
    sha_of(sp, hs); sha_of(bp, hb);
    ok(rc == 0 && strstr(out, "REGISTER_TOOL\tstatus=UNCHANGED") && strstr(out, "sources_added=0") && strstr(out, "shard_rows_added=0\tshard_rows_removed=0"), "a second identical --tool call ends UNCHANGED");
    /* --pin-owner registers the literal once */
    rc = run_in(hold, r2, out, sizeof out);
    if (cx_fmt(pinrow, sizeof pinrow, "tools/t-new.cx#%s\tliteral\t-\t%s\tfx\tok\n", hex, hex)) die("bound", "pinrow");
    ok(rc == 0 && strstr(out, "pins_added=1\tpins_needed=0") && registry_has(pp, pinrow) && count_all(pp) == 2, "--pin-owner appends the literal row in the pins.tsv format");
    sha_of(pp, hp);
    rc = run_in(hold, r2, out, sizeof out);
    ok(rc == 0 && strstr(out, "REGISTER_TOOL\tstatus=UNCHANGED") && strstr(out, "pins_added=0\tpins_needed=0"), "repeating with --pin-owner ends UNCHANGED");
    sha_of(sp, h); ok(!strcmp(h, hs), "repeat calls left tools-compile-sources.tsv byte-identical");
    sha_of(bp, h); ok(!strcmp(h, hb), "repeat calls left batches.tsv byte-identical");
    sha_of(pp, h); ok(!strcmp(h, hp), "repeat calls left pins.tsv byte-identical");
    /* a failing verification (a tracked tool that is in no registry row) is rolled back completely */
    put_file(hold, "tools/stray.cx", "int main(void){return 0;}\n"); put_file(hold, "tools/tq.cx", "int main(void){return 0;}\n");
    if (run_in(hold, gs, out, sizeof out)) die("git add stray", out);
    rc = run_in(hold, rq, out, sizeof out);
    ok(rc == 1 && strstr(out, "REGISTER_TOOL\tstatus=ROLLED_BACK\tfailed_step=tests/tools-compile.cx --shards") && strstr(out, "REFUSE added\ttools/stray.cx"), "a failed verification is ROLLED_BACK with the step and the tools-compile refusal named");
    sha_of(sp, h); ok(!strcmp(h, hs), "the rollback restored tools-compile-sources.tsv"); sha_of(bp, h); ok(!strcmp(h, hb), "the rollback restored batches.tsv");
    ok(run_in(hold, gq, out, sizeof out) == 1, "the rollback unstaged the tool this call had staged");
    put_file(hold,"tests/tools-compile.cx",
        "int main(void){FILE *f=fopen(\"tests/tools-compile-sources.tsv\",\"rb\");if(!f)return 2;char line[512];while(fgets(line,sizeof line,f))if(!strcmp(line,\"tools/reject.cx\\tregular\\n\")){fclose(f);return 1;}fclose(f);puts(\"2\");return 0;}\n");
    put_file(hold,"tools/left.cx","int main(void){return 0;}\n");
    put_file(hold,"tools/right.cx","int main(void){return 0;}\n");
    put_file(hold,"tools/third.cx","int main(void){return 0;}\n");
    put_file(hold,"tools/reject.cx","int main(void){return 0;}\n");
    concurrent_tools(hold,"tools/left.cx","tools/right.cx",0);
    ok(registry_has(sp,"tools/left.cx\tregular\n") && registry_has(sp,"tools/right.cx\tregular\n"),"different keys both retained");
    concurrent_tools(hold,"tools/third.cx","tools/reject.cx",1);
    ok(registry_has(sp,"tools/third.cx\tregular\n") && !registry_has(sp,"tools/reject.cx\tregular\n"),"failed tool removes only its own key");
    /* The verifier is a separate process. Mutate the private registry while
       the transaction is waiting for its result, exactly at the rollback boundary. */
    put_file(hold,"tests/coverage.tsv","id\tlayer\n");
    put_file(hold,"tests/batch-product-inputs.tsv","kind\tkey\tinputs\tbasis\n");
    FILE *stale=fopen(bp,"ab");if(!stale||fputs(TC_ROW("005","5"),stale)<0||fclose(stale))die("stale shard",bp);
    put_file(hold,"tests/tools-compile.cx",
        "int main(void){FILE *f=fopen(\"tests/batches.tsv\",\"ab\");if(!f)return 2;fputs(\"other-writer\\tvalue\\n\",f);fclose(f);"
        "f=fopen(\"tests/tools-compile-sources.tsv\",\"r+b\");if(!f)return 2;char line[512];while(fgets(line,sizeof line,f)){if(!strcmp(line,\"tools/tq.cx\\tregular\\n\")){fseek(f,-8,SEEK_CUR);fputs(\"symlink\\n\",f);break;}}fclose(f);"
        "f=fopen(\"tests/coverage.tsv\",\"ab\");if(!f)return 2;fputs(\"other-coverage\\tunit\\n\",f);fclose(f);"
        "f=fopen(\"tests/batch-product-inputs.tsv\",\"ab\");if(!f)return 2;fputs(\"id\\tother-writer\\tcx/\\tfixture\\n\",f);fclose(f);return 1;}\n");
    size_t oldlen;char *original=cx_read(bp,&oldlen);
    if(!original)die("read batch snapshot",bp);
    put_file(hold,"tools/remove-me.cx","int main(void){return 0;}\n");
    char *both[]={prepared_driver,"--tool","tools/tq.cx","--tool","tools/remove-me.cx",0};
    rc=run_in(hold,both,out,sizeof out);
    size_t newlen;char *current=cx_read(bp,&newlen);
    const char *extra="other-writer\tvalue\n";
    ok(rc!=0 && current && newlen==oldlen+strlen(extra) && !memcmp(original,current,oldlen) &&
       !memcmp(current+oldlen,extra,strlen(extra)),"batch bytes equal their original order plus the peer's one line");
    free(original);free(current);
    ok(!count_lines(sp,"tools/remove-me.cx\t"),"failed registration removes its untouched new row");
    ok(registry_has(sp,"tools/tq.cx\tsymlink\n"),"rollback retains subsequently replaced same-key source");
    /* Coverage and product inputs are read-only in --tool; exercise their
       fingerprints at the pre-publication boundary below. */
    rc=run_in(hold,rq,out,sizeof out);
    ok(rc==2 && strstr(out,"key-conflict"),"same source key with a different kind is refused");
    /* A verifier-independent writer changes only the fourth registry while
       git is inspecting the new path, between fingerprint and publication. */
    pjoin(a,sizeof a,hold,"tools/bound");pjoin(b,sizeof b,hold,"tools/bound-real");
    if(sy_rename(a,b))die("rename fixture bound",a);
    put_file(hold,"bound-probe.cx",
        "int main(int argc,char **argv){if(argc>3&&!strcmp(argv[3],\"ls-files\")){"
        "FILE *f=fopen(access(\"coverage-conflict\",F_OK)?\"tests/batch-product-inputs.tsv\":\"tests/coverage.tsv\",\"ab\");if(!f)return 2;fprintf(f,\"id\\tpeer-%d\\tcx/\\tfixture\\n\",getpid());fclose(f);}"
        "argv[0]=\"./tools/bound-real\";execv(argv[0],argv);return 2;}\n");
    char *compile[]={"sh","./unisacc.com","bound-probe.cx","-o","tools/bound",0};
    if(run_in(hold,compile,out,sizeof out))die("build concurrent writer",out);
    put_file(hold,"tools/replan.cx","int main(void){return 0;}\n");
    char *replan[]={prepared_driver,"--tool","tools/replan.cx",0};
    sha_of(sp,hs);sha_of(bp,hb);
    rc=run_in(hold,replan,out,sizeof out);
    ok(rc==2 && strstr(out,"registry-changed-three-times"),"three conflicting product declarations refuse by name");
    sha_of(sp,h);ok(!strcmp(h,hs),"three conflicts publish no sources change");
    sha_of(bp,h);ok(!strcmp(h,hb),"three conflicts publish no batch change");
    pjoin(a,sizeof a,hold,"tests/batch-product-inputs.tsv");
    ok(count_lines(a,"id\tpeer-")==3,"all three conflicting declarations remain");
    put_file(hold,"coverage-conflict","1\n");
    rc=run_in(hold,replan,out,sizeof out);
    pjoin(a,sizeof a,hold,"tests/coverage.tsv");
    ok(rc==2 && strstr(out,"registry-changed-three-times") && count_lines(a,"id\tpeer-")==3 &&
       !count_lines(sp,"tools/replan.cx\t"),"coverage-only changes invalidate the whole plan on each attempt");
    printf("CX_REGISTER_TOOL\tchecks=%d\tfailed=%d\tretained=%s\n", checks, failed, hold);
    return failed ? 1 : 0;
}
/* The caller supplies the native register built with REGISTER_TXN_FAULT_TEST.
   Every case creates a new private repository. Only its writer can be killed. */
static void sync_fixture_command(const char *cwd,char **argv){
    char output[4096];if(run_in(cwd,argv,output,sizeof output))die(argv[0],output);
}
static void sync_fixture_root(char *dir,size_t cap,int slow){
    char here[4096],p[4500],q[4500],ape[4096];
    if(!realpath(".",here)||sy_mkdtemp(sy_tmpdir(),"check-register-sync-",dir,cap))die("private sync root",0);
    char *material[]={"cp","-rL","--","cx","ext",dir,0};sync_fixture_command(here,material);
    pjoin(p,sizeof p,dir,"libcx");char *libs[]={"cp","-rL","--","tools/cxlib",p,0};sync_fixture_command(here,libs);
    const char *dirs[]={"tools","tests"};
    for(int i=0;i<2;i++){pjoin(p,sizeof p,dir,dirs[i]);if(sy_mkdir(p,0700))die("fixture directory",p);}
    const char *files[]={"tools/bound","tools/bound.c","tests/run-batch.cx"};
    for(int i=0;i<3;i++){pjoin(p,sizeof p,dir,files[i]);if(sy_copy(files[i],p,i?0644:0755))die("fixture copy",p);}
    pjoin(p,sizeof p,dir,"tools/cxlib");if(symlink("../libcx",p))die("fixture library alias",p);
    const char *from[]={"cxroot.tsv","tests/tools-compile.cx","tests/fixtures/register-sync/driver.cx"};
    const char *to[]={"cxroot.tsv","tests/inventory.cx","tests/tools-compile.cx"};
    for(int i=0;i<3;i++){pjoin(p,sizeof p,dir,to[i]);if(sy_copy(from[i],p,0644))die("fixture input",p);}
    if(slow)put_file(dir,"tests/cold-slow","1\n");
    const char *registries[]={"tests/batches.tsv","tests/coverage.tsv"};
    for(int i=0;i<2;i++){
        FILE *in=fopen(registries[i],"rb");pjoin(p,sizeof p,dir,registries[i]);FILE *out=fopen(p,"wb");
        char line[16384];int rows=0;
        if(!in||!out)die("open fixture registry",p);
        while(fgets(line,sizeof line,in)){
            if(!strchr(line,'\n'))die("truncated registry row",p);
            if(!rows || (i==1 && !strncmp(line,"tools.compile-all\t",18))){
                if(fputs(line,out)==EOF)die("fixture registry write",p);rows++;
            }
        }
        if(ferror(in)||fclose(in)||fclose(out)||rows!=i+1)die("fixture registry rows",p);
    }
    put_file(dir,"tests/batch-product-inputs.tsv","kind\tkey\tinputs\tbasis\n");put_file(dir,"tests/tools-compile-sources.tsv","");
    put_file(dir,"tools/check-fx.cx","int main(void){return 0;}\n");
    char *gi[]={"git","init","-q",0},*ga[]={"git","add","-Af","--",".",0};
    char *gc[]={"git","-c","user.name=register-fixture","-c","user.email=fixture@localhost","-c","commit.gpgsign=false","commit","-qm","sync fixture",0};
    sync_fixture_command(dir,gi);sync_fixture_command(dir,ga);sync_fixture_command(dir,gc);
    pjoin(q,sizeof q,dir,"unisacc.com");if(!realpath("unisacc.com",ape)||sy_copy(ape,q,0755))die("fixture ape",q);
}
static char *dir,*bin,err[16384],p[4400],*original[4];static size_t lens[4];
static const char *leaf[]={"batches.tsv","tools-compile-sources.tsv","coverage.tsv","batch-product-inputs.tsv"};
static void path(int i){if(cx_fmt(p,sizeof p,"%s/tests/%s",dir,leaf[i]))exit(2);}
static char *sync_line(const char *prefix){
    size_t n=strlen(prefix);
    for(char *row=err;*row;){
        char *end=strchr(row,'\n');size_t len=end?(size_t)(end-row):strlen(row);
        if(len>=n && !memcmp(row,prefix,n) && (len==n||row[n]=='\t'||row[n]==' '))return row;
        if(!end)break;row=end+1;
    }
    return 0;
}
static int call(int recover){char *v[]={bin,"--tool","--sync",recover?"--recover":0,0};pr_result r;
    if(pr_run("verify register sync",v,dir,0,58,&r)){fprintf(stderr,"sync fixture transport: %s\n",r.why);return -1;}
    int rc=r.rc;cx_fmt(err,sizeof err,"%s%s",r.out?r.out:"",r.err?r.err:"");printf("%s",err);pr_free(&r);return rc;}
static int sync_prepare(const char *mode){
    char private_root[4400];sync_fixture_root(private_root,sizeof private_root,!strcmp(mode,"cold"));
    /* Prepare only the inventory tool in the outer fixture. The measured batch still runs
       under two disabled caches inside a different, newly archived private repository. */
    char *prepare[]={"sh","./unisacc.com","tests/tools-compile.cx","--","--register",".","inventory.fixture.tsv",0};
    sync_fixture_command(private_root,prepare);put_file(private_root,"sync.fixture.mode",mode);
    printf("SYNC_FIXTURE_PREPARED\t%s\n",private_root);return 0;
}
static int sync_write_check(char **av){
    char canon[4096],tmp[4096],prefix[4400],marker[4500];bin=av[2];dir=av[4];
    if(bin[0]!='/'||!realpath(dir,canon)||strcmp(canon,dir)||!realpath(sy_tmpdir(),tmp)||
       cx_fmt(prefix,sizeof prefix,"%s/check-register-sync-",tmp)||strncmp(dir,prefix,strlen(prefix))||strchr(dir+strlen(prefix),'/'))die("private sync fixture required",dir);
    pjoin(marker,sizeof marker,dir,"sync.fixture.mode");size_t mn;char *m=cx_read(marker,&mn);
    if(!m||mn!=strlen(av[3])||memcmp(m,av[3],mn))die("prepared fixture mode",marker);free(m);
    struct stat original_stat[4];for(int i=0;i<4;i++){path(i);original[i]=cx_read(p,&lens[i]);if(!original[i]||lstat(p,&original_stat[i]))return 2;}
    double initial_load=tool_load1();printf("REGISTER_CHECK_LOAD start=%.2f\n",initial_load);
    if(initial_load>4){puts("CX_REGISTER_SYNC UNKNOWN load-before");return 3;}
    if(!strcmp(av[3],"write")){
        int rc=call(0);double end_load=tool_load1();printf("REGISTER_CHECK_LOAD end=%.2f\n",end_load);
        if(rc==2 && end_load>4 && sync_line("REFUSE OVER_33000MS")){puts("CX_REGISTER_SYNC UNKNOWN load-at-cold-refusal");return 3;}
        ok(rc==0 && sync_line("REGISTER_SYNC\tstatus=PUBLISHED"),"write publishes");
        path(0);ok(count_lines(p,"tools-compile-000\tIMPLEMENTED\t")==1,"shard published");
        for(int i=2;i<4;i++){struct stat st;path(i);ok(!lstat(p,&st)&&st.st_ino==original_stat[i].st_ino,"hash guard preserves table inode");}
    }else if(!strcmp(av[3],"cold")){
        int rc=call(0),batch_rc=-1;long wall=0,run_ms=0;
        char *sample=sync_line("REGISTER_COLD\tid=tools-compile-000");
        ok(rc==2 && sample && sscanf(sample,"REGISTER_COLD\tid=tools-compile-000\twall_ms=%ld\trun_ms=%ld\trc=%d",&wall,&run_ms,&batch_rc)==3 &&
           wall>33000 && run_ms>0 && batch_rc==0 && sync_line("REFUSE OVER_33000MS"),"completed real slow batch refused on measured wall time");
        for(int i=0;i<4;i++){size_t n;path(i);char *b=cx_read(p,&n);ok(b&&n==lens[i]&&!memcmp(b,original[i],n),leaf[i]);free(b);}
    }else if(!strcmp(av[3],"fault")||!strcmp(av[3],"fault1")||!strcmp(av[3],"fault3")||!strcmp(av[3],"fault4")){
        const char *point=av[3][5]?av[3]+5:"2";int third=*point=='3';
        int pid=fork();if(pid<0)return 2;
        if(!pid){if(chdir(dir) || setenv("REGISTER_TXN_STOP",point,1))_exit(2);char *v[]={bin,"--tool","--sync",0};execv(bin,v);_exit(2);}
        int st=0,stopped=0,reaped=0;long end=sy_now_ms()+55000;
        while(sy_now_ms()<end){int w=waitpid(pid,&st,WNOHANG|WUNTRACED);if(w==pid){stopped=WIFSTOPPED(st);reaped=!stopped;break;}sy_sleep_ms(20);}
        if(!reaped){sy_signal(pid,9);int sig=0;ok(sy_wait_status(pid,0,0,0,&sig)==pid && sig==9,"SIGKILL writer");}
        printf("REGISTER_KILL stop=%s\n",point);ok(stopped,"writer reached requested transaction step");if(!stopped)return 1;
        for(int i=0;i<2;i++){size_t n;path(i);char *b=cx_read(p,&n);ok(b&&((n!=lens[i]||memcmp(b,original[i],n)!=0)==(i==1||*point>='2')),"published keys match stop point");free(b);}
        path(0);const char *peer="other-writer\tindependent\n";if(sy_append_file(p,peer,strlen(peer),0644))return 2;
        ok(call(0)==2 && sync_line("register: RECOVERY_REQUIRED:"),"pending transaction refuses registration");
        char record[4500];size_t rn; pjoin(record,sizeof record,dir,"tests/.register-txn/record.tsv");
        char *saved=cx_read(record,&rn);if(!saved||!rn)die("transaction fixture record",record);
        char digest[4][65];for(int i=0;i<4;i++){path(i);sha_of(p,digest[i]);}
        if(sy_append_file(record,"x",1,0600))die("damage private manifest",record);
        ok(call(1)==2 && sync_line("register: transaction-digest-mismatch:"),"damaged manifest refuses recovery");
        for(int i=0;i<4;i++){char h[65];path(i);sha_of(p,h);ok(!strcmp(h,digest[i]),"damaged manifest leaves table intact");}
        if(sy_write_atomic(record,saved,rn,0600))die("restore private manifest",record);free(saved);
        if(third){
            int owner=fork();if(owner<0)die("recovery fork",dir);
            if(!owner){if(chdir(dir)||setenv("REGISTER_RECOVER_STOP","1",1))_exit(2);char *v[]={bin,"--tool","--sync","--recover",0};execv(bin,v);_exit(2);}
            int status=0,waiting=0;long deadline=sy_now_ms()+3000;
            while(sy_now_ms()<deadline){int w=waitpid(owner,&status,WNOHANG|WUNTRACED);if(w==owner){waiting=WIFSTOPPED(status);break;}sy_sleep_ms(10);}
            ok(waiting,"recovery holds lock after manifest verification");
            if(!waiting){sy_signal(owner,9);waitpid(owner,&status,0);return 1;}
            sy_setenv("REGISTER_LOCK_MS","100",1);
            int refused=call(0);sy_signal(owner,18);
            ok(refused==2 && sync_line("register: lock timeout:"),"second writer refused during recovery");
            int ex=0,code=-1;ok(sy_wait_status(owner,0,&ex,&code,0)==owner&&ex&&code==0,"resumed recovery completes");
            char leftover[4500];pjoin(leftover,sizeof leftover,dir,"tests/.register-clean-fixture");
            if(sy_mkdir(leftover,0700))die("retired fixture",leftover);
            ok(call(1)==0&&sync_line("REGISTER_SYNC RETIRED_CLEANUP_PENDING")&&sync_line("REGISTER_SYNC\tstatus=NO_PENDING"),"retired journal distinguished from pending rollback");
        }else ok(call(1)==0 && sync_line("REGISTER_SYNC\tRECOVERY_REQUIRED") && sync_line("REGISTER_SYNC\tRECOVERED"),"explicit rollback");
        for(int i=0;i<4;i++){size_t n;path(i);char *b=cx_read(p,&n);
            ok(b && n==lens[i]+(i==0?strlen(peer):0) && !memcmp(b,original[i],lens[i]) && (i||!memcmp(b+lens[i],peer,strlen(peer))),leaf[i]);free(b);}
    }
    if(strcmp(av[3],"fault")&&strcmp(av[3],"fault1")&&strcmp(av[3],"fault4")&&strcmp(av[3],"fault3")&&strcmp(av[3],"write")&&strcmp(av[3],"cold"))return 2;
    printf("CX_REGISTER_SYNC\tchecks=%d\tfailed=%d\tretained=%s\n",checks,failed,dir);return failed?1:0;
}
int main(int argc,char **argv) {
    if(argc==3 && !strcmp(argv[1],"--sync-write-prepare"))return sync_prepare(argv[2]);
    if(argc==5 && !strcmp(argv[1],"--sync-write-check"))return sync_write_check(argv);
    int prepare = argc == 3 && !strcmp(argv[1], "--prepare");
    if (prepare || (argc >= 3 && !strcmp(argv[1], "--out"))) {
        if (argv[2][0]!='/' || cx_fmt(output,sizeof output,"%s",argv[2])) die("absolute output required",0);
        if (prepare) argc=1; else { argc-=2; argv+=2; }
    }
    int args_only=argc==2&&!strcmp(argv[1],"--args-check");
    int metadata_only=(argc==2||argc==3)&&!strcmp(argv[1],"--metadata-rollback");
    int root_only=(argc==2||argc==3)&&!strcmp(argv[1],"--root-preflight");
    int tool_only=argc==2&&!strcmp(argv[1],"--tool-check");
    if(argc!=1&&!args_only&&!metadata_only&&!root_only&&!tool_only)return 2;
    static char abuf[1 << 15], bbuf[1 << 15];
    char *av0[16], *av1[16], *v[2] = { av0, av1 };
    const char *ids[4] = { "cr-a", "cr-b", "cr-c", "cr-d" };
    char rowsb[4][4096], rowsc[4][4096];
    long before_b, before_c;
    char orig_hb[65], orig_hc[65], real_hb[65], real_hc[65];
    int i, j;
    if (sy_realpath(".", root, sizeof root) < 0) die("cwd", 0);
    /* default work directory under sy_tmpdir(), never under ROOT/out (project owner 2026-11-13) */
    if (!output[0] && cx_fmt(output,sizeof output,"%s/unisacc-check-register",sy_tmpdir())) die("output path",0);
    if (sy_mkdir(output,0700) && sy_exists(output)!=1) die("output directory",output);
    if (!root_only) {
        char cache[4400], bin[4400], why[512]; int reused;
        if (rn_prepare(root,DRIVER,output,prepared_driver,sizeof prepared_driver,&reused,why,sizeof why)) die(why,0);
        if (cx_fmt(cache,sizeof cache,"%s/unisacc-register-native",sy_tmpdir())) die("prepare cache",0);
        if (sy_mkdir(cache,0700) && sy_exists(cache)!=1) die("prepare cache",cache);
        if (rn_prepare(root,"tests/run.cx",cache,bin,sizeof bin,&reused,why,sizeof why) || rn_prepare(root,"tests/run-batch.cx",cache,bin,sizeof bin,&reused,why,sizeof why)) die(why,0);
        if (prepare) return 0;
    }
    pjoin(rbpath, sizeof rbpath, root, "tests/batches.tsv");
    pjoin(rcpath, sizeof rcpath, root, "tests/coverage.tsv");
    {   /* the private table directory: everything below works on this copy, never on the shared tables.
           Explicit output keeps preparation and consumption in the caller-owned directory. */
        char hold[4400];
        if (cx_fmt(hold, sizeof hold, "%s/check-register-tables-XXXXXX", output)) die("path bound", "tables");
        if (!mkdtemp(hold)) die("mkdir", hold);
        if (cx_fmt(tables, sizeof tables, "%s/tests", hold)) die("path bound", "tables");
        {   int r = sy_mkdir(tables, 0700); if (r < 0 && r != -EEXIST) die("mkdir", tables); }
        if (cx_fmt(envtables, sizeof envtables, "UNISACC_TABLES=%s", tables)) die("path bound", "env");
    }
    pjoin(bpath, sizeof bpath, tables, "batches.tsv");
    pjoin(cpath, sizeof cpath, tables, "coverage.tsv");
    if (copy_file(rbpath, bpath) || copy_file(rcpath, cpath)) die("cannot copy the registry", tables);
    before_b = count_all(bpath); before_c = count_all(cpath);
    if (before_b < 1 || before_c < 1) die("empty registry", 0);
    {   size_t n = 0; char *b = cx_read(bpath, &n); if (!b) die("read", bpath); cx_sha256_hex(b, (long)n, orig_hb); free(b);
        b = cx_read(cpath, &n); if (!b) die("read", cpath); cx_sha256_hex(b, (long)n, orig_hc); free(b);
    }
    {   size_t n = 0; char *b = cx_read(rbpath, &n); if (!b) die("read", rbpath); cx_sha256_hex(b, (long)n, real_hb); free(b);
        b = cx_read(rcpath, &n); if (!b) die("read", rcpath); cx_sha256_hex(b, (long)n, real_hc); free(b);
    }

    /* fixture: tools/register-fixture.cx is a real SOURCE entry (registry source paths must be tools/,
       tests/ or cx/), prints REGISTER_FIXTURE_OK and exits 0 */
    if (cx_fmt(fx, sizeof fx, "%s", "tools/register-fixture.cx")) die("fixture path", 0);
    if (!sy_exists(fx)) die("missing fixture", fx);

    if(metadata_only)return metadata_rollback(argc==3?argv[2]:DRIVER);
    if(root_only)return root_preflight(argc==3?argv[2]:DRIVER);
    if(tool_only)return tool_check();

    if(args_only){
        candidate_registration();
        /* A relative dev-product directory must be rejected before registration.
           The private tables must remain byte-identical even when a candidate is unavailable. */
        char *invalid_runner[]={"env",envtables,prepared_driver,"cr-relative-runner",fx,
            "REGISTER_FIXTURE_OK","relative candidate",fx,"interfaces","product","--runner","relative-dir",0};
        char before_batch[65],before_coverage[65],after[65];
        sha_of(bpath,before_batch);sha_of(cpath,before_coverage);
        int runner_rc=run(invalid_runner,abuf,sizeof abuf);
        ok(runner_rc==2 && strstr(abuf,"--runner requires an absolute dev-product directory"),"relative runner refused by name");
        sha_of(bpath,after);ok(!strcmp(after,before_batch),"relative runner preserves batch registry bytes");
        sha_of(cpath,after);ok(!strcmp(after,before_coverage),"relative runner preserves coverage registry bytes");
        char *args[]={"env",envtables,"sh","./unisacc.com",DRIVER,"--","cr-args",fx,"REGISTER_FIXTURE_ARGS_OK","explicit argv fixture",fx,"interfaces","product","--args","alpha;beta",0,0};
        int rc=run(args,abuf,sizeof abuf);ok(rc==0&&strstr(abuf,"status=REGISTERED"),"explicit two args reach real fixture and marker");size_t n;char *bytes;ok(registry_has(bpath,"\talpha;beta\tinterfaces.cr-args\trc0:REGISTER_FIXTURE_ARGS_OK\tproduct\tcommit\n"),"final registry keeps exact encoded args");
        char hb[65],hc[65],afterb[65],afterc[65];bytes=cx_read(bpath,&n);cx_sha256_hex(bytes,n,hb);free(bytes);bytes=cx_read(cpath,&n);cx_sha256_hex(bytes,n,hc);free(bytes);
        args[6]="cr-args-empty";args[14]="";rc=run(args,abuf,sizeof abuf);ok(rc==2&&strstr(abuf,"empty args"),"empty args refuse before mutation");args[6]="cr-args-tab";args[14]="alpha\tbeta";rc=run(args,abuf,sizeof abuf);ok(rc==2&&strstr(abuf,"empty args"),"control field refuses before mutation");bytes=cx_read(bpath,&n);cx_sha256_hex(bytes,n,afterb);free(bytes);bytes=cx_read(cpath,&n);cx_sha256_hex(bytes,n,afterc);free(bytes);ok(!strcmp(hb,afterb)&&!strcmp(hc,afterc),"refused args preserve private registries");/* args normalisation: spaces and --opt=value fold into the table's ';' convention */
        args[15]="--no-run";args[6]="cr-args-sp";args[8]="REGISTER_FIXTURE_OK";args[14]="--cases lock";rc=run(args,abuf,sizeof abuf);ok(rc==0&&registry_has(bpath,"\t--cases;lock\tinterfaces.cr-args-sp\trc0:"),"--args '--cases lock' is stored as --cases;lock");
        args[6]="cr-args-eq";args[14]="--cases=lock";rc=run(args,abuf,sizeof abuf);ok(rc==0&&registry_has(bpath,"\t--cases;lock\tinterfaces.cr-args-eq\trc0:"),"--args '--cases=lock' is stored as --cases;lock");
        args[6]="cr-args-mix";args[14]="--cases=lock  --x=1 k=v";rc=run(args,abuf,sizeof abuf);ok(rc==0&&registry_has(bpath,"\t--cases;lock;--x;1;k=v\tinterfaces.cr-args-mix\trc0:"),"mixed spaces and = fold per token, plain k=v is kept");
        args[6]="cr-args-semi";args[14]="--cases;lock";rc=run(args,abuf,sizeof abuf);ok(rc==0&&registry_has(bpath,"\t--cases;lock\tinterfaces.cr-args-semi\trc0:"),"an already normalised args field is unchanged");args[15]=0;
        /* --no-run: rows written, batch not run (marker never printed, so a real run would roll back) */
        {   char *nr[]={"env",envtables,"sh","./unisacc.com",DRIVER,"--","cr-nr-ok",fx,"NEVER_PRINTED","no-run row",fx,"interfaces","--no-run",0};
            rc=run(nr,abuf,sizeof abuf);
            ok(rc==0&&strstr(abuf,"status=REGISTERED_NORUN")&&!strstr(abuf,"BATCH_RUN")&&!strstr(abuf,"ROLLED_BACK"),"--no-run writes the rows, does not run the batch, ends REGISTERED_NORUN");
            ok(strstr(abuf,"NOT done")!=0,"--no-run tells the caller to produce its own evidence");
            ok(count_lines(bpath,"cr-nr-ok\t")==1&&count_lines(cpath,"interfaces.cr-nr-ok\t")==1,"--no-run rows are in both private tables");
            ok(registry_has(bpath,"cr-nr-ok\tIMPLEMENTED\t")&&!registry_has(bpath,"cr-nr-ok\tPASS"),"--no-run row is IMPLEMENTED, never PASS");
        }
        /* default (no --no-run) still runs the batch and rolls back on failure */
        {   char *df[]={"env",envtables,"sh","./unisacc.com",DRIVER,"--","cr-nr-fail",fx,"NEVER_PRINTED","default failing row",fx,"interfaces",0};
            rc=run(df,abuf,sizeof abuf);
            ok(rc==1&&strstr(abuf,"status=ROLLED_BACK")&&strstr(abuf,"rows_removed=2"),"default registration still runs the batch and rolls back a failing one");
            ok(!count_lines(bpath,"cr-nr-fail\t")&&!count_lines(cpath,"interfaces.cr-nr-fail\t"),"the failed default registration left no row");
        }
        printf("REGISTER_ARGS_CHECK\tchecks=%d\tfailed=%d\n",checks,failed);return failed?1:0;
    }

    /* case 1: both concurrent registrations succeed */
    rows(rowsb[0], sizeof rowsb[0], rowsc[0], sizeof rowsc[0], "cr-a", "REGISTER_FIXTURE_OK", "concurrent row A");
    rows(rowsb[1], sizeof rowsb[1], rowsc[1], sizeof rowsc[1], "cr-b", "REGISTER_FIXTURE_OK", "concurrent row B");
    reg_argv(av0, 0, "cr-a", "REGISTER_FIXTURE_OK", "concurrent row A");
    reg_argv(av1, 0, "cr-b", "REGISTER_FIXTURE_OK", "concurrent row B");
    {   int fd[2], pid[2], ex = 0, code = 0, sig = 0, rc0, rc1;
        pid[0] = sy_spawn_pipe(v[0], 0, 0, &fd[0], 0);
        pid[1] = sy_spawn_pipe(v[1], 0, 0, &fd[1], 0);
        {   long n = 0, r; for (;;) { r = sy_read(fd[0], abuf + n, (long)sizeof abuf - 1 - n); if (r <= 0) break; n += r; if (n >= (long)sizeof abuf - 1) break; } abuf[n] = 0; sy_close(fd[0]); }
        {   long n = 0, r; for (;;) { r = sy_read(fd[1], bbuf + n, (long)sizeof bbuf - 1 - n); if (r <= 0) break; n += r; if (n >= (long)sizeof bbuf - 1) break; } bbuf[n] = 0; sy_close(fd[1]); }
        sy_wait_status(pid[0], 0, &ex, &code, &sig); rc0 = ex ? code : -1;
        ex = code = sig = 0; sy_wait_status(pid[1], 0, &ex, &code, &sig); rc1 = ex ? code : -1;
        ok(rc0 == 0 && rc1 == 0, "two concurrent registrations both exit 0");
    }
    ok(strstr(abuf, "status=REGISTERED") && strstr(bbuf, "status=REGISTERED"), "both report REGISTERED");
    ok(count_lines(bpath, "cr-a\t") == 1 && count_lines(bpath, "cr-b\t") == 1, "each batch row appears exactly once");
    ok(count_lines(cpath, "interfaces.cr-a\t") == 1 && count_lines(cpath, "interfaces.cr-b\t") == 1, "each coverage row appears exactly once");
    ok(count_all(bpath) == before_b + 2 && count_all(cpath) == before_c + 2, "no line lost or duplicated in either file");

    /* case 2: one fails its batch, rolls back, the other survives */
    rows(rowsb[2], sizeof rowsb[2], rowsc[2], sizeof rowsc[2], "cr-c", "NEVER_PRINTED", "rollback row");
    rows(rowsb[3], sizeof rowsb[3], rowsc[3], sizeof rowsc[3], "cr-d", "REGISTER_FIXTURE_OK", "survivor row");
    reg_argv(av0, 0, "cr-c", "NEVER_PRINTED", "rollback row");
    reg_argv(av1, 0, "cr-d", "REGISTER_FIXTURE_OK", "survivor row");
    {   int fd[2], pid[2], ex = 0, code = 0, sig = 0, rc0, rc1;
        pid[0] = sy_spawn_pipe(v[0], 0, 0, &fd[0], 0);
        pid[1] = sy_spawn_pipe(v[1], 0, 0, &fd[1], 0);
        {   long n = 0, r; for (;;) { r = sy_read(fd[0], abuf + n, (long)sizeof abuf - 1 - n); if (r <= 0) break; n += r; if (n >= (long)sizeof abuf - 1) break; } abuf[n] = 0; sy_close(fd[0]); }
        {   long n = 0, r; for (;;) { r = sy_read(fd[1], bbuf + n, (long)sizeof bbuf - 1 - n); if (r <= 0) break; n += r; if (n >= (long)sizeof bbuf - 1) break; } bbuf[n] = 0; sy_close(fd[1]); }
        sy_wait_status(pid[0], 0, &ex, &code, &sig); rc0 = ex ? code : -1;
        ex = code = sig = 0; sy_wait_status(pid[1], 0, &ex, &code, &sig); rc1 = ex ? code : -1;
        ok(rc0 == 1 && strstr(abuf, "status=ROLLED_BACK") && strstr(abuf, "rows_removed=2"), "the failing call rolls both rows back");
        ok(rc1 == 0 && strstr(bbuf, "status=REGISTERED"), "the overlapping call still registers");
    }
    ok(count_lines(bpath, "cr-c\t") == 0 && count_lines(cpath, "interfaces.cr-c\t") == 0, "the rolled-back rows are gone");
    ok(count_lines(bpath, "cr-d\t") == 1 && count_lines(cpath, "interfaces.cr-d\t") == 1, "the survivor row is intact");
    ok(count_lines(bpath, "cr-a\t") == 1 && count_lines(bpath, "cr-b\t") == 1, "case 1 rows survived the rollback");

    /* case 3: a held lock makes the caller wait, then fail by name, touching neither file */
    {   char hb1[65], hb2[65];
        size_t n = 0; char *b = cx_read(bpath, &n); cx_sha256_hex(b, (long)n, hb1); free(b);
        b = cx_read(cpath, &n); cx_sha256_hex(b, (long)n, hb2); free(b);
        {   int holder = fork();
            if (holder == 0) {
                char lp[4400]; int fd; long z;
                pjoin(lp, sizeof lp, tables, ".register.lock");
                fd = sy_open(lp, O_RDWR | O_CREAT, 0666);
                if (fd < 0 || sy_flock(fd, 2) != 0) _exit(3);
                for (z = 0; z < 600; z++) usleep(5000);   /* hold for 3 s */
                _exit(0);
            }
            usleep(250000);   /* let the holder take it */
            {   { char out[1 << 15]; int rc;   /* env(1) carries the shortened wait into register.cx */
                    char *w[14] = { "env", "REGISTER_LOCK_MS=300", envtables, "sh", "./unisacc.com", DRIVER, "--",
                                    "cr-e", fx, "REGISTER_FIXTURE_OK", "lock timeout row", fx, "interfaces", 0 };
                    rc = run(w, out, sizeof out);
                    ok(rc == 2, "a held lock fails the caller with exit 2");
                    ok(strstr(out, "lock timeout") != 0, "the failure is named (lock timeout)");
                }
            }
            {   int ex = 0, code = 0, sig = 0; sy_wait_status(holder, 0, &ex, &code, &sig); }
        }
        ok(count_lines(bpath, "cr-e\t") == 0 && count_lines(cpath, "interfaces.cr-e\t") == 0, "the timed-out call wrote no rows");
        {   char h[65]; size_t m = 0; char *b2 = cx_read(bpath, &m); cx_sha256_hex(b2, (long)m, h); free(b2);
            ok(!strcmp(h, hb1), "batches.tsv is untouched by the timeout"); }
        {   char h[65]; size_t m = 0; char *b2 = cx_read(cpath, &m); cx_sha256_hex(b2, (long)m, h); free(b2);
            ok(!strcmp(h, hb2), "coverage.tsv is untouched by the timeout"); }
    }

    /* case 5: refusals exit 2 by name and write nothing -- an existing ID, a missing CHECK, an empty
       MARKER, a TAB in a field, a MARKER that already carries "rc0:".  These are the interfaces.cx-register coverage row's own assertions (merged
       from register-tool); the fixture
       runs them on the private copy, so a refusal can never leave a row behind in the shared tables. */
    {   char h1[65], h2[65], out[1 << 15]; int rc;
        size_t n = 0; char *b = cx_read(bpath, &n); cx_sha256_hex(b, (long)n, h1); free(b);
        b = cx_read(cpath, &n); cx_sha256_hex(b, (long)n, h2); free(b);
        {   char *a[16] = { "env", envtables, "sh", "./unisacc.com", DRIVER, "--", "cr-a", fx,
                             "REGISTER_FIXTURE_OK", "duplicate id row", fx, "interfaces", 0 };
            rc = run(a, out, sizeof out);
            ok(rc == 2 && strstr(out, "already registered"), "an existing ID is refused by name and exits 2");
        }
        {   char *a[16] = { "env", envtables, "sh", "./unisacc.com", DRIVER, "--", "cr-f",
                             "tools/no-such-check.cx", "REGISTER_FIXTURE_OK", "missing check row", fx, "interfaces", 0 };
            rc = run(a, out, sizeof out);
            ok(rc == 2 && strstr(out, "no such check"), "a missing CHECK file is refused by name and exits 2");
        }
        {   char *a[16] = { "env", envtables, "sh", "./unisacc.com", DRIVER, "--", "cr-g", fx,
                             "", "empty marker row", fx, "interfaces", 0 };
            rc = run(a, out, sizeof out);
            ok(rc == 2 && strstr(out, "empty field"), "an empty MARKER is refused by name and exits 2");
        }
        {   char *a[16] = { "env", envtables, "sh", "./unisacc.com", DRIVER, "--", "cr-h", fx,
                             "REGISTER_FIXTURE_OK", "bad\tfield", fx, "interfaces", 0 };
            rc = run(a, out, sizeof out);
            ok(rc == 2 && strstr(out, "empty field"), "a TAB in a field is refused by name and exits 2");
        }
        {   char hb[65], hc[65], h[65]; size_t m = 0; char *b2;
            b2 = cx_read(bpath, &m); cx_sha256_hex(b2, (long)m, hb); free(b2);
            b2 = cx_read(cpath, &m); cx_sha256_hex(b2, (long)m, hc); free(b2);
            {   char *a[16] = { "env", envtables, "sh", "./unisacc.com", DRIVER, "--", "cr-i", fx,
                                 "rc0:REGISTER_FIXTURE_OK", "doubled prefix row", fx, "interfaces", 0 };
                rc = run(a, out, sizeof out);
                /* a full expect as MARKER would become "rc0:rc0:.." and make every batch in the registry
                   refuse (tp_visit), so it is refused by name before the appends */
                ok(rc == 2 && strstr(out, "MARKER must be one rc0: tail"), "a MARKER carrying the rc0: prefix is refused by name and exits 2");
            }
            b2 = cx_read(bpath, &m); cx_sha256_hex(b2, (long)m, h); free(b2);
            ok(!strcmp(h, hb), "the refused MARKER left batches.tsv byte for byte");
            b2 = cx_read(cpath, &m); cx_sha256_hex(b2, (long)m, h); free(b2);
            ok(!strcmp(h, hc), "the refused MARKER left coverage.tsv byte for byte");
        }
        {   char h[65]; size_t m = 0; char *b2 = cx_read(bpath, &m); cx_sha256_hex(b2, (long)m, h); free(b2);
            ok(!strcmp(h, h1), "no refused call appended a batch row"); }
        {   char h[65]; size_t m = 0; char *b2 = cx_read(cpath, &m); cx_sha256_hex(b2, (long)m, h); free(b2);
            ok(!strcmp(h, h2), "no refused call appended a coverage row"); }
    }

    /* case 6: the rollback cannot have the lock, so it must say which rows are still where and exit by a
       dedicated code instead of a bare timeout.  The fixture never prints the registered marker and is slow
       enough for the holder below to take the lock before the rollback gets there. */
    {   char hb[65], hc[65]; size_t m = 0; char *b2 = cx_read(bpath, &m); cx_sha256_hex(b2, (long)m, hb); free(b2);
        b2 = cx_read(cpath, &m); cx_sha256_hex(b2, (long)m, hc); free(b2);
        {   char b[4096], c[4096];
            /* the row this call will append (the slow fixture, not the passing one) */
            if (cx_fmt(b, sizeof b, "cr-j\tIMPLEMENTED\tinterfaces\ttools/register-fixture-slow.cx\tSOURCE\tlnx/x86_64\t55\t-\ttools/register-fixture-slow.cx\t-\tinterfaces.cr-j\trc0:REGISTER_FIXTURE_OK\tproduct\tcommit\n")
                || cx_fmt(c, sizeof c, "interfaces.cr-j\tinterfaces\tIMPLEMENTED_SEPARATE_BATCH\tdirty rollback row\ttools/register-fixture-slow.cx\n")) die("row bound", "cr-j");
            int holder = fork();
            if (holder == 0) {
                /* Take the lock only once the row is in the table: register holds it across its own appends
                   and --list, and the batch run that follows is outside it.  Polling for the row makes the
                   window deterministic instead of a sleep race.
                   The lock must cover register's whole batch run *and* its 3x300 ms rollback, so it is
                   released only after the register child exits: a fixed hold (3 s) was the same order as
                   register's 2.6-3.0 s total and the case went red on 4 of 6 runs.  A done-file written by
                   the parent after the child is reaped is the release signal. */
                char lp[4400], dp[4400]; int fd, won = 0; long z; size_t m = 0;
                for (z = 0; z < 200 && !won; z++) {
                    won = registry_has(bpath, b);
                    if (!won) usleep(10000);
                }
                if (!won) _exit(4);
                pjoin(lp, sizeof lp, tables, ".register.lock");
                fd = sy_open(lp, O_RDWR | O_CREAT, 0666);
                if (fd < 0 || sy_flock(fd, 2) != 0) _exit(3);
                pjoin(dp, sizeof dp, tables, ".register.holder-done");
                for (z = 0; z < 4000 && !sy_exists(dp); z++) usleep(5000);   /* wait for the parent's signal */
                _exit(0);
            }
            {   char out[1 << 15]; int rc;
                char *w[16] = { "env", "REGISTER_ROLLBACK_LOCK_MS=300", envtables, "sh", "./unisacc.com", DRIVER, "--",
                                "cr-j", "tools/register-fixture-slow.cx", "REGISTER_FIXTURE_OK", "dirty rollback row",
                                "tools/register-fixture-slow.cx", "interfaces", 0 };
                rc = run(w, out, sizeof out);
                ok(rc == 3, "a rollback that cannot lock exits 3");
                ok(strstr(out, "tables may be dirty: leftover row cr-j at batches.tsv:") != 0
                   && strstr(out, "coverage.tsv:") != 0, "the dirty tables are named with the left-over row's line numbers");
            }
            {   int ex = 0, code = 0, sig = 0; char dp[4400];
                /* The register run above has returned, so its rollback has already tried the lock.
                   Write the done-file first (that is what releases the holder), then reap it: reaping
                   first would deadlock, because the child waits for this file.  The lock therefore spans
                   register's whole batch run plus its 3x300 ms rollback instead of a fixed 3 s. */
                if (cx_fmt(dp, sizeof dp, "%s/.register.holder-done", tables)) die("path bound", "holder-done");
                {   FILE *df = fopen(dp, "wb");
                    if (!df || fputc('x', df) == EOF || fclose(df)) die("holder-done write", dp);
                }
                sy_wait_status(holder, 0, &ex, &code, &sig);
            }
        }
        /* the rows really are there: the message was not a guess; remove them by exact content */
        {   char b[4096], c[4096]; int removed = 0;
            if (cx_fmt(b, sizeof b, "cr-j\tIMPLEMENTED\tinterfaces\ttools/register-fixture-slow.cx\tSOURCE\tlnx/x86_64\t55\t-\ttools/register-fixture-slow.cx\t-\tinterfaces.cr-j\trc0:REGISTER_FIXTURE_OK\tproduct\tcommit\n")
                || cx_fmt(c, sizeof c, "interfaces.cr-j\tinterfaces\tIMPLEMENTED_SEPARATE_BATCH\tdirty rollback row\ttools/register-fixture-slow.cx\n")) die("row bound", "cr-j");
            removed += take_out(bpath, b) == 0; removed += take_out(cpath, c) == 0;
            ok(removed == 2, "the dirty rows were still in both tables");
        }
        {   char h[65]; b2 = cx_read(bpath, &m); cx_sha256_hex(b2, (long)m, h); free(b2);
            ok(!strcmp(h, hb), "batches.tsv is back to its pre-case content"); }
        {   char h[65]; b2 = cx_read(cpath, &m); cx_sha256_hex(b2, (long)m, h); free(b2);
            ok(!strcmp(h, hc), "coverage.tsv is back to its pre-case content"); }
    }

    /* cleanup: remove exactly our own rows, then require the originals back byte for byte */
    {   int removed = 0;
        long nb0 = before_b, nc0 = before_c;
        for (j = 0; j < 4; j++) {
            if (take_out(bpath, rowsb[j]) == 0) removed++;
            if (take_out(cpath, rowsc[j]) == 0) removed++;
        }
        ok(removed == 6, "cleanup removed exactly the six check rows");
        ok(count_all(bpath) == nb0 && count_all(cpath) == nc0, "both registries are back to their original length");
        {   char h[65]; size_t m = 0; char *b = cx_read(bpath, &m); cx_sha256_hex(b, (long)m, h); free(b);
            ok(!strcmp(h, orig_hb), "batches.tsv restored byte for byte (other lanes' rows intact)"); }
        {   char h[65]; size_t m = 0; char *b = cx_read(cpath, &m); cx_sha256_hex(b, (long)m, h); free(b);
            ok(!strcmp(h, orig_hc), "coverage.tsv restored byte for byte (other lanes' rows intact)"); }
        for (i = 0; i < 4; i++) {
            if (count_lines(bpath, ids[i]) || count_lines(cpath, ids[i])) { failed++; checks++; printf("FAIL\tresidue row %s\n", ids[i]); break; }
        }
        {   char h[65]; size_t m = 0; char *b = cx_read(rbpath, &m); cx_sha256_hex(b, (long)m, h); free(b);
            ok(!strcmp(h, real_hb), "tests/batches.tsv was never written (the fixture used a private copy)"); }
        {   char h[65]; size_t m = 0; char *b = cx_read(rcpath, &m); cx_sha256_hex(b, (long)m, h); free(b);
            ok(!strcmp(h, real_hc), "tests/coverage.tsv was never written (the fixture used a private copy)"); }
        {   char p[4400]; if (!cx_fmt(p, sizeof p, "%s/batches.tsv", tables)) sy_unlink(p);
            if (!cx_fmt(p, sizeof p, "%s/coverage.tsv", tables)) sy_unlink(p);
            if (!cx_fmt(p, sizeof p, "%s/.register.lock", tables)) sy_unlink(p);
            if (!cx_fmt(p, sizeof p, "%s/.register.holder-done", tables)) sy_unlink(p);
            if (sy_rmdir(tables) != 0) { checks++; failed++; printf("FAIL\tprivate copy not removed\n"); }
        }
    }
    printf("CX_REGISTER\tchecks=%d\tfailed=%d\n", checks, failed);
    return failed ? 1 : 0;
}
