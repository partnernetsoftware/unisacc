/* tools/check-cx-lint.cx -- fixtures for tools/cx-lint.cx (run from the repo root).
 *
 *   sh ./unisacc.com tools/check-cx-lint.cx
 *
 * Writes small positive/negative .cx samples under sy_tmpdir()/cx-lint-check-PID/ (and a tests/
 * subdirectory for the R1-version refusal exemption), runs tools/cx-lint.cx on each (bounded 50 s)
 * and asserts the exact count per rule: every rule has at least two positive and two negative
 * samples, including comment/string/char/continuation traps for the lexer, the lint:allow comment
 * (with and without a reason, wrong rule), the R1-product data-flow cases (existence check, guard,
 * label, literal in an argv slot, run first argument, NULL-terminated initializer), --rules and
 * R3-die (missing / conditional / non-final exit, delegation, int die, _or_die, lint:allow).
 * Then the 0.0.50 rb_die defect from git history (3d6589c0d7^ reported, 3d6589c0d7 clean) and
 * three real 0.0.49 rework samples:
 *   6eec399892^:tools/chain-step.cx   R2-sep must be reported (missing "--" before --rev),
 *   6eec399892:tools/chain-step.cx    R2-sep must not be reported (fixed),
 *   60a7dd0cd8^:tools/kernel-route.cx R1-product must be reported (hard-wired ROOT/unisacc.com).
 * Skipped (SKIP line, not PASS) when a history object is missing in a shallow checkout.
 * Prints CHECK_CX_LINT<TAB>passed=N<TAB>failed=M<TAB>skipped=K; exit 0 only when failed=0. */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use mem.heap

static char dir[4096];
static int passed, failed, skipped;

static int put(const char *name, const char *body, long n, char *path, int cap) {
    int fd;
    if (cx_fmt(path, cap, "%s/%s", dir, name)) return -1;
    fd = sy_open_new(path, 0644);
    if (fd < 0) return -1;
    if (sy_write_all(fd, body, n)) { sy_close(fd); return -1; }
    return sy_close(fd);
}

/* count of LINT rows with RULE in cx-lint's output for PATH (optionally under --rules FILTER), -1 on run failure */
static int count_rules(const char *path, const char *filter, const char *rule) {
    char *v[] = {"sh", "./unisacc.com", "tools/cx-lint.cx", "--", (char *)path, 0, 0, 0};
    char *out = 0; size_t n = 0; char pat[64]; int c;
    if (filter) { v[4] = "--rules"; v[5] = (char *)filter; v[6] = (char *)path; }
    if (cx_runv_timeout(v, 50, &out, &n) || !out) return -1;
    if (cx_fmt(pat, sizeof pat, "LINT\t%s\t", rule)) return -1;
    c = (int)tx_count(out, (long)n, pat, tx_len(pat, 64));
    if (!tx_contains(out, (long)n, "CX_LINT\tfiles=1\t", 16)) c = -1;
    mm_free(out);
    return c;
}
static int count(const char *path, const char *rule) { return count_rules(path, 0, rule); }

/* NAME may carry a tests/ prefix (the R1-version refusal exemption keys on the path) */
static void expect_rules(const char *name, const char *body, const char *filter, const char *rule, int want) {
    char p[4400]; int got;
    if (put(name, body, tx_len(body, 1 << 20), p, sizeof p)) { printf("FAIL\t%s\twrite\n", name); failed++; return; }
    got = count_rules(p, filter, rule);
    if (got == want) { printf("PASS\t%s\t%s=%d\n", name, rule, got); passed++; }
    else { printf("FAIL\t%s\t%s want=%d got=%d\n", name, rule, want, got); failed++; }
    sy_unlink(p);
}
static void expect(const char *name, const char *body, const char *rule, int want) { expect_rules(name, body, 0, rule, want); }

static void history(const char *rev, const char *file, const char *name, const char *rule, int at_least) {
    char spec[512], p[4400]; char *out = 0; size_t n = 0; int got;
    char *v[] = {"git", "show", spec, 0};
    if (cx_fmt(spec, sizeof spec, "%s:%s", rev, file)) { failed++; return; }
    if (cx_runv_timeout(v, 20, &out, &n) || !out || n == 0) { printf("SKIP\t%s\tno history object %s\n", name, spec); skipped++; return; }
    if (put(name, out, (long)n, p, sizeof p)) { printf("FAIL\t%s\twrite\n", name); failed++; return; }
    mm_free(out);
    got = count(p, rule);
    if (at_least ? got >= 1 : got == 0) { printf("PASS\t%s\t%s=%d\n", name, rule, got); passed++; }
    else { printf("FAIL\t%s\t%s want %s got=%d\n", name, rule, at_least ? ">=1" : "0", got); failed++; }
    sy_unlink(p);
}

int main(void) {
    if (cx_fmt(dir, sizeof dir, "%s/cx-lint-check-%d", sy_tmpdir(), sy_pid()) || sy_mkdir(dir, 0700)) {
        fprintf(stderr, "check-cx-lint: cannot create scratch dir\n"); return 2;
    }
    {   char sub[4400];
        if (cx_fmt(sub, sizeof sub, "%s/tests", dir) || sy_mkdir(sub, 0700)) { fprintf(stderr, "check-cx-lint: cannot create scratch tests dir\n"); return 2; } }
    /* R1-version */
    expect("v1.cx", "static const char *v = \"0.0.49\";\n", "R1-version", 1);
    expect("v2.cx", "int f(void){ return puts(\"unisacc 0.0.50 ready\"); }\n", "R1-version", 1);
    expect("v3.cx", "/* \"0.0.49\" in a comment */\n// \"unisacc 0.0.49\"\nint x = '0';\n", "R1-version", 0);
    expect("v4.cx", "static const char *a = \"0.0.0\", *b = \"10.0.49x\", *c = \"\\\"0.0.\\\"\";\n", "R1-version", 0);
    expect("v5.cx", "int main(void){ ck(!rv_valid(\"0.0.48.1.2\"),\"five-part\"); return 0; }\n", "R1-version", 1);   /* tool, not test code: ck(!) does not exempt */
    expect("tests/v6.cx", "int main(void){ ck(!rv_valid(\"0.0.48.1.2\"),\"five-part\"); return 0; }\n", "R1-version", 0);
    expect("tests/v7.cx", "int main(void){ fixture(\"version\\n0.0.48\\n\",1); fixture(\"other\\n0.0.48\\n\",0); return 0; }\n", "R1-version", 2);
    expect("tests/v8.cx", "int main(void){ replace_reject(\"v.tsv\",\"version\\t0.0.43\\n\",\"bad\"); return 0; }\n", "R1-version", 0);
    expect("check-v9.cx", "int main(void){ ck(rv_valid(\"0.0.48\"),\"ok\"); ck(!rv_valid(\" 0.0.48\"),\"refuse.space\"); return 0; }\n", "R1-version", 0);
    expect("v10.cx", "static const char *v = \"0.0.49\";   /* lint:allow R1-version test pin for the 0.0.49 oracle */\n"
                     "static const char *w = \"0.0.49\";   // lint:allow R1 same pin\n", "R1-version", 0);
    expect("v11.cx", "static const char *v = \"0.0.49\";   /* lint:allow R1-version */\n"
                     "static const char *w = \"0.0.49\"; // lint:allow\n"
                     "static const char *x = \"0.0.49\"; /* lint:allow R2-timeout wrong rule */\n", "R1-version", 3);
    expect("v12.cx", "static const char *a = \"plans/release-0.0.43.md\", *b = \"waivers-0.0.44.tsv\", *c = \"release-0.0.43.md\";\n", "R1-version", 0);
    /* R1-product */
    expect("p1.cx", "int f(char *o){ char c[64]; cx_fmt(c, 64, \"%s/unisacc.com\", o);\n"
                    " char *v[] = {\"sh\", c, 0}; return sy_run(v, o, 1, 0); }\n", "R1-product", 1);
    expect("p2.cx", "static char prod[64];\nint g(char **v,int n){ path(prod,64,\".\",\"unisacc.com\");\n"
                    " v[n++]=prod; v[n]=0; return child(v); }\n", "R1-product", 1);
    expect("p3.cx", "int f(void){ return puts(\"sh ./unisacc.com tools/x.cx\"); }\n"
                    "int g(char **v){ return cx_runv_timeout(v, 5, 0, 0); }\n", "R1-product", 0);
    expect("p4.cx", "/* \"unisacc.com\" */ int f(char **v){ return sy_run(v, 0, 0, 0); }\n"
                    "int h(void){ return puts(\"unisacc.com\"); }\n", "R1-product", 0);
    expect("p5.cx", "int f(char **v,char *o){ char p[64]; cx_fmt(p, 64, \"%s/unisacc.com\", o);\n"
                    " if (!exists(p)) return 1; return sy_run(v, o, 64, 0); }\n", "R1-product", 0);   /* existence check only */
    expect("p6.cx", "int f(char **v,char *o){ guard_path(o, \"unisacc.com\"); puts(\"unisacc.com\"); return sy_run(v, o, 64, 0); }\n",
                    "R1-product", 0);   /* guard + label in a block that runs children */
    expect("p7.cx", "int f(char *t){ char *v[] = {\"sh\", \"./unisacc.com\", t, 0}; return wrapper(v); }\n", "R1-product", 1);   /* literal in argv slot */
    expect("p8.cx", "int f(char **v,int n){ v[n++] = (char *)\"./unisacc.com\"; v[n] = 0; return 0; }\n", "R1-product", 1);
    expect("p9.cx", "int f(char *o){ char c[64]; cx_fmt(c, 64, \"%s/unisacc.com\", o); return sy_run(c, o, 64, 0); }\n", "R1-product", 1);   /* run first arg */
    expect("p10.cx", "static const char *m[] = {\"unisacc.com\", \"unisacc.com.build.json\"};\n"
                     "int f(char *o){ char c[64]; cx_fmt(c, 64, \"%s/unisacc.com\", o); return tx_eqz(c, o) ? 0 : sy_run(m, o, 64, 0); }\n",
                     "R1-product", 0);   /* name list without NULL terminator; compared, not run */
    expect("p11.cx", "int f(char *o){ char c[64]; cx_fmt(c, 64, \"%s/unisacc.com\", o);\n"
                     " char *v[] = {\"sh\", c, 0}; char *w[] = {\"sh\", c, \"x\", 0}; return child(v) + child(w); }\n", "R1-product", 1);   /* one report per literal */
    expect("p12.cx", "int f(char *r){ char p[64]; path(p, r, \"unisacc.com\"); hash(p); path(p, r, \"seed.c\");\n"
                     " char *v[] = {\"sh\", p, 0}; return child(v); }\n", "R1-product", 0);   /* name refilled without the literal */
    expect("p13.cx", "int f(char *r){ char p[64]; path(p, r, \"unisacc.com\"); hash(p); path(p, r, \"seed.c\"); hash(p);\n"
                     " path(p, r, \"unisacc.com\"); { char *v[] = {\"sh\", p, 0}; return child(v); } }\n", "R1-product", 1);   /* refilled with it again */
    /* R2-timeout */
    expect("t1.cx", "int f(char **v,char *o){ return sy_run(v, o, 64, 0); }\n", "R2-timeout", 1);
    expect("t2.cx", "int f(char **v){ int e, o; return sy_spawn_pipe(v, \".\", 0, &o, &e); }\n"
                    "int g(char *c){ char *o; size_t n; return cx_run(c, &o, &n); }\n", "R2-timeout", 2);
    expect("t3.cx", "int f(char **v,char *o){ char *w[]={\"./tools/bound\",\"30\",v[0],0}; return sy_run(w, o, 64, 0); }\n",
                    "R2-timeout", 0);
    expect("t4.cx", "int f(char **v){ char *o; size_t n; /* sy_run(v) */ return cx_runv_timeout(v, 9, &o, &n); }\n"
                    "static const char *s = \"sy_spawn(x)\";\n#define M(x) \\\n  sy_run_bound(x)\n", "R2-timeout", 0);
    /* R2-sep */
    expect("s1.cx", "int f(char *s,char **a){ char com[99], tool[99]; int n=0;\n"
                    " cx_fmt(com, 99, \"%s/unisacc.com\", s); cx_fmt(tool, 99, \"%s/tools/rb.cx\", s);\n"
                    " a[n++]=\"sh\"; a[n++]=com; a[n++]=tool; a[n++]=\"--rev\"; a[n]=0; return 0; }\n", "R2-sep", 1);
    expect("s2.cx", "int f(void){ char *o; size_t n; return cx_run_timeout(\"sh ./unisacc.com tools/x.cx --check\", 9, &o, &n); }\n",
                    "R2-sep", 1);
    expect("s3.cx", "int f(char **a){ int n=0; a[n++]=\"sh\"; a[n++]=\"./unisacc.com\"; a[n++]=\"tools/x.cx\";\n"
                    " a[n++]=\"--\"; a[n++]=\"--rev\"; a[n]=0; return 0; }\n", "R2-sep", 0);
    expect("s4.cx", "static const char *u = \"sh ./unisacc.com tools/x.cx -- --check\";\n"
                    "/* sh ./unisacc.com tools/y.cx --bad */ static char *w[] = {\"sh\", \"./unisacc.com\", \"t.cx\", \"--\", \"--x\", 0};\n",
                    "R2-sep", 0);
    expect("s5.cx", "static const char *fixture = \"int f(void){ return run(\\\"sh ./unisacc.com tools/x.cx --check\\\"); }\";\n", "R2-sep", 0);
    expect("s6.cx", "int f(void){ char *o; size_t n; return cx_run_timeout(\"sh ./unisacc.com tools/x.cx --check\", 9, &o, &n); }\n"
                    "int g(void){ char *o; size_t n; return cx_run_timeout(\"sh ./unisacc.com tools/y.cx --write\", 9, &o, &n); }\n", "R2-sep", 2);
    /* --rules filter */
    expect_rules("r1.cx", "int f(char **v,char *o){ return sy_run(v, o, 64, 0); }\nstatic const char *x = \"0.0.49\";\n", "R2", "R2-timeout", 1);
    expect_rules("r2.cx", "int f(char **v,char *o){ return sy_run(v, o, 64, 0); }\nstatic const char *x = \"0.0.49\";\n", "R2", "R1-version", 0);
    expect_rules("r3.cx", "int f(char **v,char *o){ return sy_run(v, o, 64, 0); }\nstatic const char *x = \"0.0.49\";\n", "R1-version,R2-sep", "R1-version", 1);
    /* real 0.0.49 rework samples */
    history("6eec399892^", "tools/chain-step.cx", "h-chain-step-before.cx", "R2-sep", 1);
    history("6eec399892", "tools/chain-step.cx", "h-chain-step-after.cx", "R2-sep", 0);
    history("60a7dd0cd8^", "tools/kernel-route.cx", "h-kernel-route-before.cx", "R1-product", 1);
    /* R3-die */
    expect("d1.cx", "static void rb_die(const char *s) {\n    sy_eprintf(\"x: %s\\n\", s);\n}\n", "R3-die", 1);
    expect("d2.cx", "static void die(const char *s){ if (s) exit(2); }\nvoid x_die(void){ exit(2); cleanup(); }\n", "R3-die", 2);
    expect("d3.cx", "static void die(const char *s){ fprintf(stderr, \"%s\\n\", s); exit(2); }\n"
                    "static void cs_die(const char *a){ sy_eprintf(\"%s (%d)\\n\", a, f(1)); sy_exit(1); }\n"
                    "void t_die(const char *a){ note(a); die(a); }\n", "R3-die", 0);
    expect("d4.cx", "/* void die(void){ } */ static const char *s = \"void die(void){ }\";\n"
                    "static int die(const char *m){ puts(m); return 2; }\n"
                    "void pp_digest_or_die(const char *r){ if (!r) exit(2); }\nvoid diet(void){ }\nvoid die(void);\n", "R3-die", 0);
    expect("d5.cx", "static void die(void){ done(2); }   /* lint:allow R3-die done() exits after cleanup */\n"
                    "static void b_die(void){ done(2); }   /* lint:allow R3-die */\n", "R3-die", 1);
    expect_rules("d6.cx", "static void die(void){ }\nint f(char **v,char *o){ return sy_run(v, o, 64, 0); }\n", "R2,R3", "R3-die", 1);
    /* the 0.0.50 defect: rb_die lost its sy_exit (01ac82b13c), restored in 3d6589c0d7 */
    history("3d6589c0d7^", "tools/release-build.cx", "h-release-build-before.cx", "R3-die", 1);
    history("3d6589c0d7", "tools/release-build.cx", "h-release-build-after.cx", "R3-die", 0);
    {   char sub[4400]; if (!cx_fmt(sub, sizeof sub, "%s/tests", dir)) sy_rmdir(sub); }
    sy_rmdir(dir);
    printf("CHECK_CX_LINT\tpassed=%d\tfailed=%d\tskipped=%d\n", passed, failed, skipped);
    return failed ? 1 : 0;
}
