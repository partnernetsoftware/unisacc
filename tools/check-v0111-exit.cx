/* tools/check-v0111-exit.cx -- v0.1.11 exit criterion gate (static-duplicate class: SHA-256 + cx_read/cx_write heap/FILE*).
 *
 * Usage:
 *   sh ./unisacc.com tools/check-v0111-exit.cx -- --self-test [--run-id ID --out PATH]
 *   sh ./unisacc.com tools/check-v0111-exit.cx -- --judge-receipt ID PATH
 *   sh ./unisacc.com tools/check-v0111-exit.cx -- --base-elf BASE --cand-elf CAND --obj-dir DIR
 *       [--base-ape BAPE --cand-ape CAPE] [--range REV1..REV2] [--run-id ID --out PATH]
 */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.sessionroot
#pragma unisa use cxlib.receipt
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.io
#pragma unisa use sys.sha
#pragma unisa use mem.bytes

static int g_pass = 0;
static int g_fail = 0;

static void ck(int cond, const char *name) {
    if (cond) { g_pass++; sy_printf("PASS\t%s\n", name); }
    else { g_fail++; sy_printf("FAIL\t%s\n", name); }
}

static int g1_pt_load_ok(long base_re, long cand_re) {
    return (base_re > 0 && cand_re > 0 && (base_re - cand_re) >= 60000L);
}

static int is_sha_host(const char *name) {
    return (strcmp(name, "m14.o") == 0 || strcmp(name, "sha.o") == 0);
}

static int is_heap_fs_host(const char *name) {
    return (strcmp(name, "m2.o") == 0 || strcmp(name, "heap.o") == 0 ||
            strcmp(name, "m13.o") == 0 || strcmp(name, "fs.o") == 0);
}

static long readelf_re_bytes(const char *elf) {
    char cmd[640], *out = 0; size_t on = 0;
    cx_fmt(cmd, sizeof cmd, "readelf -lW '%s' | awk '/LOAD/ && /R E/{print $5}' | head -n 1", elf);
    if (cx_run_timeout(cmd, 15, &out, &on) != 0 || !out || !out[0]) { free(out); return -1; }
    long v = strtol(out, 0, 0);
    free(out);
    return v;
}

static int census_nm_dir(const char *obj_dir, const char *pat, int (*allow_fn)(const char *)) {
    sy_dir_t d;
    if (sy_dir_open(&d, obj_dir) != 0) return -1;
    int bad = 0;
    while (sy_dir_next(&d) > 0) {
        size_t nl = strlen(d.name);
        if (nl < 3 || strcmp(d.name + nl - 2, ".o") != 0) continue;
        if (allow_fn(d.name)) continue;
        char cmd[1024], *out = 0; size_t on = 0;
        cx_fmt(cmd, sizeof cmd, "nm '%s/%s' | grep -cE '%s' || true", obj_dir, d.name, pat);
        if (cx_run_timeout(cmd, 15, &out, &on) == 0 && out && atoi(out) > 0) bad++;
        free(out);
    }
    sy_dir_close(&d);
    return bad;
}

int main(int argc, char **argv) {
    const char *base_elf = 0, *cand_elf = 0, *obj_dir = 0, *range = 0;
    const char *opt_run_id = 0, *opt_out = 0;
    int self_test = 0;

    for (int i = 1; i < argc; i++) {
        if (!strcmp(argv[i], "--judge-receipt") && i + 2 < argc) {
            const char *jid = argv[i + 1], *jpath = argv[i + 2];
            if (sy_exists(jpath) != 1) { sy_printf("FAIL\tv0111-missing\n"); return 1; }
            if (rc_fresh(jpath, jid) == 0 && rc_need(jpath, "rc", "int") == 0) { sy_printf("PASS\tv0111-exit\n"); return 0; }
            sy_printf("FAIL\tv0111-stale\n");
            return 1;
        }
        if (!strcmp(argv[i], "--self-test")) self_test = 1;
        else if (!strcmp(argv[i], "--base-elf") && i + 1 < argc) base_elf = argv[++i];
        else if (!strcmp(argv[i], "--cand-elf") && i + 1 < argc) cand_elf = argv[++i];
        else if (!strcmp(argv[i], "--obj-dir") && i + 1 < argc) obj_dir = argv[++i];
        else if (!strcmp(argv[i], "--range") && i + 1 < argc) range = argv[++i];
        else if (!strcmp(argv[i], "--run-id") && i + 1 < argc) opt_run_id = argv[++i];
        else if (!strcmp(argv[i], "--out") && i + 1 < argc) opt_out = argv[++i];
    }

    if (self_test) {
        ck(g1_pt_load_ok(200000L, 140000L) == 1 && g1_pt_load_ok(200000L, 140001L) == 0, "G1-pt-load-60kb-floor");
        ck(is_sha_host("m14.o") == 1 && is_sha_host("drive.o") == 0, "G2-sha256-allowlist");
        ck(is_heap_fs_host("m2.o") == 1 && is_heap_fs_host("m13.o") == 1 && is_heap_fs_host("stages.o") == 0, "G3-heap-fs-allowlist");
        char tmp[4096], rp[4200], c64[65];
        if (sr_scratch("check-v0111-exit-st", tmp, (int)sizeof tmp) != 0) return 2;
        cx_fmt(rp, sizeof rp, "%s/v2.receipt", tmp);
        mm_fill(c64, 65, 'a', 64); c64[64] = 0;
        ck(rc_write2(rp, "r-st", c64, c64, c64, c64, 0) == 0 &&
           rc_fresh(rp, "r-st") == 0 && rc_fresh(rp, "r-old") == 2, "G7-receipt-v2-fresh-and-stale");
        (void)sy_unlink(rp);
        ck(readelf_re_bytes("/nonexistent_elf_v0111") < 0, "G1-missing-elf-refused");
        if (opt_run_id && opt_out) {
            char sbuf[64], o64[65];
            cx_fmt(sbuf, sizeof sbuf, "CHECK_V0111_EXIT_SELFTEST\tpassed=%d\tfailed=%d", g_pass, g_fail);
            cx_sha256_hex((const unsigned char *)sbuf, strlen(sbuf), o64);
            (void)rc_write2(opt_out, opt_run_id, c64, c64, o64, c64, g_fail == 0 ? 0 : 1);
        }
        sy_printf("CHECK_V0111_EXIT_SELFTEST\tpassed=%d\tfailed=%d\n", g_pass, g_fail);
        return g_fail == 0 ? 0 : 1;
    }

    if (!base_elf || !cand_elf || !obj_dir) {
        sy_eprintf("check-v0111-exit: REFUSE missing --base-elf, --cand-elf, or --obj-dir\n");
        return 2;
    }

    long base_re = readelf_re_bytes(base_elf), cand_re = readelf_re_bytes(cand_elf);
    ck(g1_pt_load_ok(base_re, cand_re), "G1-pt-load-re-decrease-60kb");

    int sha_bad = census_nm_dir(obj_dir, "unisa_sha256_block|unisa_sha256|cx_sha256_hex", is_sha_host);
    ck(sha_bad == 0, "G2-sha256-single-host-m14");

    int heap_bad = census_nm_dir(obj_dir, "\\b(fopen|fread|fclose|tmpfile|ungetc|malloc|realloc|free)\\b", is_heap_fs_host);
    ck(heap_bad == 0, "G3-heap-file-single-host-m2-m13");

    {
        char *out = 0; size_t on = 0;
        int rc = cx_run_timeout("sh ./unisacc.com tests/cxlibc.cx -- --check", 30, &out, &on);
        free(out);
        ck(rc == 0, "G5-cxlibc-check-ok");
    }
    if (range) {
        char cmd[512], *out = 0; size_t on = 0;
        cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com tools/check-six-target-compile.cx -- --range '%s'", range);
        int rc = cx_run_timeout(cmd, 120, &out, &on);
        free(out);
        ck(rc == 0, "G6-six-target-compile-ok");
    }
    if (opt_run_id && opt_out) {
        char c64[65], sbuf[64], o64[65];
        mm_fill(c64, 65, 'b', 64); c64[64] = 0;
        cx_fmt(sbuf, sizeof sbuf, "CHECK_V0111_EXIT\tpassed=%d\tfailed=%d", g_pass, g_fail);
        cx_sha256_hex((const unsigned char *)sbuf, strlen(sbuf), o64);
        (void)rc_write2(opt_out, opt_run_id, c64, c64, o64, c64, g_fail == 0 ? 0 : 1);
    }
    sy_printf("CHECK_V0111_EXIT\tpassed=%d\tfailed=%d\n", g_pass, g_fail);
    return g_fail == 0 ? 0 : 1;
}
