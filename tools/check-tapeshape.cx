#pragma unisa use sys.proc
#pragma unisa use sys.io
/* Narrow check: cx/compiler/tapeshape.cx is the bytes tools/tapeshape-gen.cx
   emits from exec/facts/tape-shape.tsv. The 72 opcode names and shapes are
   not listed again here.
   sh ./unisacc.com tools/check-tapeshape.cx */
int main(void) {
    char *av[] = {"sh", "./unisacc.com", "tools/tapeshape-gen.cx", "--", "--check", 0};
    char buf[4096];
    int cut = 0;
    int rc = sy_run(av, buf, (int)sizeof buf, &cut);
    if (rc != 0 || cut) {
        sy_printf("%s", buf);
        sy_printf("CX_TAPESHAPE\tfailed=1\trc=%d\tcut=%d\n", rc, cut);
        return 1;
    }
    sy_printf("%s", buf);
    sy_printf("CX_TAPESHAPE\tfailed=0\n");
    return 0;
}
