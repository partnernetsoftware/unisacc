/* End-to-end real pp closures in a temporary minimal tree; no out dependency. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sys.env
#pragma unisa use sysx.process
#pragma unisa use mem.bytes
static char root[4096],base[8192],copyroot[8192],com[8192],tool[8192],binary[8192],closure[8192];static int checks,failed;
static void die(const char *s){fprintf(stderr,"NET_DIGEST_CHECK %s errno=%d\n",s,errno);exit(2);}
static void ck(int yes,const char *name){checks++;failed+=!yes;printf("%s\t%s\n",yes?"PASS":"FAIL",name);}
static void parents(const char *path){char p[16384];if(cx_fmt(p,sizeof p,"%s",path))die("path");for(char *s=p+1;*s;s++)if(*s=='/'){*s=0;struct stat st;if(lstat(p,&st)){if(errno!=ENOENT||mkdir(p,0700))die("mkdir");}else if(!S_ISDIR(st.st_mode))die("directory type");*s='/';}}
static void save(const char *path,const void *p,size_t n){parents(path);if(cx_write(path,p,n))die("write");}
static int chosen(const char *s){return !strcmp(s,"shared-e2")||!strcmp(s,"tokenpp")||!strcmp(s,"warnpp-shared");}
static np_result run(const char *net,const char *graph){char *v[]={binary,"--root",copyroot,"--closure",(char *)graph,"--net",(char *)net,0};np_result r={0};char why[300];if(np_run(v,root,0,12,&r,why,sizeof why)||r.residue)die("child bound");return r;}
static void refused(const char *net,const char *g,const char *label){np_result r=run(net,g);ck(r.rc==2&&!r.outn,label);if(r.rc!=2)fprintf(stderr,"%s\n",r.err?r.err:"");np_free(&r);}
static void digest(np_result *r,char out[65]){char *p=r->out?strstr(r->out,"\tsha256="):0;if(r->rc||!p||strlen(p)<72)die("digest missing");mm_copy(out, 64, p+8, 64);out[64]=0;}
int main(int argc,char **argv){if(argc!=1)die("arguments");if(!realpath(".",root)||cx_fmt(base,sizeof base,"%s/net-digest-check-XXXXXX",sy_tmpdir())||!mkdtemp(base)||cx_fmt(copyroot,sizeof copyroot,"%s/tree",base)||mkdir(copyroot,0700)||cx_fmt(com,sizeof com,"%s/unisacc.com",root)||cx_fmt(tool,sizeof tool,"%s/tools/net-digest.cx",root)||cx_fmt(closure,sizeof closure,"%s/closure.tsv",base))die("paths");
 if(cx_fmt(binary,sizeof binary,"%s/net-digest.exe",base))die("binary path");char *build[]={"sh",com,tool,"-o",binary,0};np_result built={0};char bw[300];if(np_run(build,root,0,35,&built,bw,sizeof bw)||built.rc||built.residue){fprintf(stderr,"%s\n",built.err?built.err:"");die("measured repeated-startup compile");}np_free(&built);
 char *v[]={"sh",com,"tools/net-deps.cx",0};np_result graph={0};char why[300];if(np_run(v,root,0,20,&graph,why,sizeof why)||graph.rc||graph.residue)die("real net-deps");save(closure,graph.out,graph.outn);char *g=malloc(graph.outn+1);if(!g)die("allocation");mm_copy(g, graph.outn+1, graph.out, graph.outn+1);char first[8192]={0};char *p=strchr(g,'\n')+1;while(*p){char *lf=strchr(p,'\n');if(!lf)die("graph framing");*lf=0;if(*p!='#'){char *f[5];f[0]=p;int n=1;for(char *q=p;*q;q++)if(*q=='\t'){*q=0;if(n==5)die("graph fields");f[n++]=q+1;}if(n!=5)die("graph fields");if(chosen(f[0])){char from[16384],to[16384];if(cx_fmt(from,sizeof from,"%s/%s",root,f[3])||cx_fmt(to,sizeof to,"%s/%s",copyroot,f[3]))die("path");size_t n;char *s=cx_read(from,&n);if(!s)die("copy source");save(to,s,n);free(s);if(!first[0]&&!strcmp(f[3],"exec/pp/location-byte.tsv"))(cx_fmt(first, sizeof first, "%s", f[3]) ? exit(2) : (void)0);}}p=lf+1;}char dest[16384];cx_fmt(dest,sizeof dest,"%s/tools/cxlib/sourcepackage.cx",copyroot);size_t rn;char *recipes=cx_read("tools/cxlib/sourcepackage.cx",&rn);if(!recipes)die("recipe read");save(dest,recipes,rn);free(recipes);if(!first[0])die("location closure");
 const char *names[]={"shared-e2","tokenpp","warnpp-shared"};char hashes[3][65];for(int i=0;i<3;i++){np_result r=run(names[i],closure);ck(!r.rc&&r.out&&strstr(r.out,names[i]),names[i]);digest(&r,hashes[i]);np_free(&r);}ck(strcmp(hashes[0],hashes[1])&&strcmp(hashes[0],hashes[2])&&strcmp(hashes[1],hashes[2]),"recipe flags give distinct identities");
 char input[16384];cx_fmt(input,sizeof input,"%s/%s",copyroot,first);size_t in;char *bytes=cx_read(input,&in);if(!bytes||!in)die("mutation file");bytes[0]^=1;save(input,bytes,in);np_result r=run(names[0],closure);char h[65];digest(&r,h);ck(strcmp(h,hashes[0]),"inside closure changes digest");np_free(&r);bytes[0]^=1;save(input,bytes,in);cx_fmt(dest,sizeof dest,"%s/unrelated.txt",copyroot);save(dest,"external",8);r=run(names[0],closure);digest(&r,h);ck(!strcmp(h,hashes[0]),"outside closure leaves digest unchanged");np_free(&r);
 if(unlink(input))die("unlink");refused(names[0],closure,"missing input refuses without digest");save(input,bytes,in);if(unlink(input)||symlink("/etc/passwd",input))die("symlink");refused(names[0],closure,"symlink input refuses");if(unlink(input))die("unlink symlink");save(input,bytes,in);if(chmod(input,0000))die("chmod");refused(names[0],closure,"EACCES refuses");if(chmod(input,0600))die("restore mode");
 char bad[8192];cx_fmt(bad,sizeof bad,"%s/bad.tsv",base);const char *extra[]={"shared-e2\tpp\t-\texec/pp/location-byte.tsv\ttable\n","shared-e2\tpp\t-\t../escape\ttable\n","not-a-net\tpp\t-\texec/pp/location-byte.tsv\ttable\n","shared-e2\tpp\t-\tnotdir/input\ttable\n","BAD\n"};const char *labels[]={"duplicate closure row","escape closure path","unknown graph net","ENOTDIR refuses","malformed closure"};cx_fmt(dest,sizeof dest,"%s/notdir",copyroot);save(dest,"file",4);for(int i=0;i<5;i++){size_t z=graph.outn+strlen(extra[i]);char *b=malloc(z+1);if(!b)die("allocation");mm_copy(b, graph.outn, graph.out, graph.outn);mm_copy(b+graph.outn, strlen(extra[i]), extra[i], strlen(extra[i]));save(bad,b,z);free(b);refused(names[0],bad,labels[i]);}refused("unknown-net",closure,"unknown selected net");printf("NET_DIGEST_CHECK\tchecks=%d\tfailed=%d\n",checks,failed);free(bytes);free(g);np_free(&graph);return failed?1:0;}
