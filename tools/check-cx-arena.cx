/* Checks cx/mem/arena.cx: sh ./unisacc.com tools/check-cx-arena.cx; exit 1 on any FAIL. */
#pragma unisa use mem.arena
static int bad;
static void ok(int c, const char *name) { printf("%s\t%s\n", c ? "PASS" : "FAIL", name); if (!c) bad = 1; }
int main(void) {
    int a = ar_new(1000), h[16], i, all = 1;
    char *p = ar_alloc(a, 10), *q = ar_alloc(a, 10), *d;
    ok(a > 0 && p && q && p != q, "new-alloc");
    ok(((unsigned long)p & 15) == 0 && ((unsigned long)q & 15) == 0, "aligned");
    for (i = 0; i < 10; i++) all = all && p[i] == 0;
    ok(all, "zeroed");
    ok(ar_alloc(a, 981) == 0, "limit-refused");
    ok(ar_alloc(a, 0) == 0 && ar_alloc(99, 1) == 0, "bad-args");
    d = ar_dup(a, "hey", 3);
    ok(d && d[0] == 'h' && d[2] == 'y' && d[3] == 0, "dup");
    ok(ar_drop(a) == 0 && ar_drop(a) == 1 && ar_alloc(a, 1) == 0, "drop-once");
    for (i = 0; i < 16; i++) h[i] = ar_new(10);
    ok(h[15] > 0 && ar_new(10) == 0, "sixteen-live");
    for (i = 0; i < 16; i++) ar_drop(h[i]);
    ok(ar_new(10) > 0, "reuse-after-drop");
    printf("%s\tcheck-cx-arena\n", bad ? "FAIL" : "PASS");
    return bad;
}
