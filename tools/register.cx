/* tools/register.cx -- register a check program as a test batch, validate the registry, run it once.
 *
 *   sh ./unisacc.com tools/register.cx -- ID CHECK.cx MARKER "COVERAGE TEXT" "FILES" [LAYER] [HEADERS] [--args ARGS]
 *
 * Appends one SOURCE batch row to tests/batches.tsv
 *   ID IMPLEMENTED LAYER CHECK SOURCE lnx/x86_64 55 - CHECK - LAYER.ID rc0:MARKER HEADERS
 * and one coverage row to tests/coverage.tsv
 *   LAYER.ID LAYER IMPLEMENTED_SEPARATE_BATCH COVERAGE-TEXT FILES
 * (LAYER defaults to interfaces), then runs tests/run.cx --list (metadata_valid=1 required) and
 * tests/run-batch.cx for ID into out/register-ID-PID/.  On any refusal or failure exactly the two appended
 * lines are taken out again (other lines, even ones appended meanwhile, stay) and the exit is 1; an ID that
 * is already registered, a missing CHECK, a TAB or newline in a field, or a MARKER that is not one rc0: tail
 * ([A-Z0-9_]+ — register writes the "rc0:" itself, so a full expect would double the prefix) is refused before
 * anything is written (exit 2).  The row is also checked in memory before the appends: twelve TAB fields and a
 * last field exactly "rc0:"+MARKER, the same shape tp_expect accepts, so a malformed row cannot reach the table
 * where tp_visit would then refuse every batch in the registry.  HEADERS selects the include-search contract
 * the batch declares: "product" (default) means the packaged candidate's embedded headers only, "tree" means
 * ROOT/include is added explicitly for checks that inspect this checkout's include layout.  Prints the BATCH_RUN line and REGISTER<TAB>id=..<TAB>status=REGISTERED|ROLLED_BACK.
 * The six manual steps (two appends, --list, mkdir, run-batch, read the result) as one call.
 *
 * Two registrations of different batches touch the same two files, so the append-validate span holds an
 * exclusive flock on tests/.register.lock: without it a concurrent register sees the other's append and the
 * shared --list validation fails through no fault of either row (observed 2026-11-02, three ROLLED_BACK in a
 * row).  The batch run itself is outside the lock (it only reads the row) and the rollback takes it back
 * with its own, longer, retried wait (REGISTER_ROLLBACK_LOCK_MS, default 20000, three attempts): if the lock
 * is still held the rollback prints "tables may be dirty: leftover row <id> at batches.tsv:<line>,
 * coverage.tsv:<line>", reports status=DIRTY and exits 3, so a refusal can never end in a silent lock
 * timeout with the rows still in the registry.  A register call's own lock wait is REGISTER_LOCK_MS:
 * a registered check that registers too would otherwise wait on a lock its own parent holds.  Waiting is capped at REGISTER_LOCK_MS (default and maximum 45000) and a timeout is
 * a named failure, not a silent retry loop.  The lock fd is close-on-exec so run.cx/run-batch cannot inherit
 * it.  Rollback removes exactly this call's two line contents and leaves every other line alone.
 *
 * UNISACC_TABLES names the table directory (default tests): the two tables, their lock, and the tables that
 * tests/run.cx --list and tests/run-batch.cx read all move together.  A check that registers fixtures points
 * it at a private copy, so its fixture rows never meet another lane's writes (the byte-for-byte restore
 * assertions of tools/check-register.cx cannot hold while a third party appends in the same window).
 *
 * The root it runs in (the current directory) must hold ./unisacc.com and an out/ directory: --list and
 * run-batch are started as `sh ./unisacc.com ...` and the trial run writes out/register-ID-PID/.  A private
 * clone has neither (both are untracked), and the call then used to end in a bare ROLLED_BACK rc=1 with no
 * reason.  Both are checked before the lock and before anything is written: each missing one is named on
 * stderr with the command that fixes it, and the exit is 2. */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.posix
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use text.fmt
#pragma unisa use mem.heap
#pragma unisa use cxlib.runnerprep

static void rg_die(const char *a, const char *b) { fprintf(stderr, "register: %s%s%s\n", a, b ? ": " : "", b ? b : ""); exit(2); }

/* the registry lock: exclusive flock on tests/.register.lock, waited for at most REGISTER_LOCK_MS
   (default 45000, also the maximum: a longer wait means the holder is not making progress and the
   caller should be told so by name).  Returns the held fd; releases are just sy_flock(UN)+close. */
/* The two tables live in tests/ unless UNISACC_TABLES names another directory.  A check that registers
   fixtures then works on a private copy instead of racing every other registration lane on the real
   files (the byte-for-byte restore assertions cannot hold while someone else appends). */
static const char *rg_tdir(void) { const char *e = getenv("UNISACC_TABLES"); return e && *e ? e : "tests"; }
static const char *rg_bpath(void) { static char p[4400]; if (tx_snprintf(p, sizeof p, "%s/batches.tsv", rg_tdir()) >= (int)sizeof p) rg_die("path bound", "batches.tsv"); return p; }
static const char *rg_cpath(void) { static char p[4400]; if (tx_snprintf(p, sizeof p, "%s/coverage.tsv", rg_tdir()) >= (int)sizeof p) rg_die("path bound", "coverage.tsv"); return p; }
static const char *rg_lockpath(void) { static char p[4400]; if (tx_snprintf(p, sizeof p, "%s/.register.lock", rg_tdir()) >= (int)sizeof p) rg_die("path bound", "lock"); return p; }
static long rg_lock_ms(void) {
    const char *e = getenv("REGISTER_LOCK_MS"); long v = e ? atol(e) : 45000;
    return v < 100 ? 100 : v > 45000 ? 45000 : v;
}
/* One bounded attempt at the exclusive lock: the held fd, or -1 when the wait ran out.  Anything but
   "held by someone else" and EINTR is fatal by name. */
static int rg_try_lock(long ms) {
    long waited = 0; int fd = sy_open(rg_lockpath(), O_RDWR | O_CREAT, 0666), r;
    if (fd < 0) rg_die("cannot open lock", rg_lockpath());
    if (fcntl(fd, F_SETFD, FD_CLOEXEC) != 0) { sy_close(fd); rg_die("cannot mark lock close-on-exec", rg_lockpath()); }
    for (;;) {
        r = sy_flock(fd, 2 | 4);   /* exclusive, do not wait */
        if (r == 0) return fd;
        if (r != -EWOULDBLOCK && r != -EINTR) { sy_close(fd); rg_die("cannot flock", rg_lockpath()); }
        if (waited >= ms) { sy_close(fd); return -1; }
        sy_sleep_ms(50); waited += 50;
    }
}
static int rg_lock(void) {
    long ms = rg_lock_ms(); int fd = rg_try_lock(ms);
    if (fd < 0) { fprintf(stderr, "register: lock timeout: %s held longer than %ld ms\n", rg_lockpath(), ms); exit(2); }
    return fd;
}
/* The rollback's wait is its own and longer, and it retries: a refusal must end either with the two rows
   gone or with a named dirty table, never with a bare lock timeout (the rows are then still in the registry
   and every later run sees them).  REGISTER_ROLLBACK_LOCK_MS overrides it for tests. */
static long rg_rollback_ms(void) {
    const char *e = getenv("REGISTER_ROLLBACK_LOCK_MS"); long v = e ? atol(e) : 20000;
    return v < 100 ? 100 : v > 120000 ? 120000 : v;
}
static int rg_lock_rollback(void) {
    int fd = -1, attempt;
    for (attempt = 0; attempt < 3; attempt++) { fd = rg_try_lock(rg_rollback_ms()); if (fd >= 0) break; }
    return fd;
}

/* 1-based line number of the line equal to LINE (which ends in \n) in PATH, 0 when it is not there */
static long line_of(const char *path, const char *line) {
    size_t n; char *b = cx_read(path, &n); long at = 0, ll = tx_len(line, 1 << 16), no = 0;
    if (!b) return 0;
    while (at < (long)n) {
        long e = tx_chr(b + at, (long)n - at, '\n'), ln = e < 0 ? (long)n - at : e + 1;
        no++;
        if (ln == ll && tx_same(b + at, ln, line, ll)) { free(b); return no; }
        at += ln;
    }
    free(b);
    return 0;
}
static void rg_unlock(int fd) { if (fd >= 0) { sy_flock(fd, 8); sy_close(fd); } }

/* tp_expect in tools/cxlib/testplan.cx accepts "rc0:" followed by [A-Z0-9_]+ only, and tests/run-batch.cx
   validates the WHOLE registry through tp_visit: one malformed expect makes every batch refuse (2026-11-02:
   one uncommitted row "rc0:rc0:ROOT_IDENTITY" blocked 27 census rows).  register.cx writes that field as
   "rc0:" + MARKER, so a MARKER that is already an expect would become a double prefix; refuse it by name
   before anything is written. */
static int rg_marker_ok(const char *m) {
    if (!*m) return 0;
    for (; *m; m++) if (!((*m >= 'A' && *m <= 'Z') || (*m >= '0' && *m <= '9') || *m == '_')) return 0;
    return 1;
}
/* The two untracked things a root needs before a registration can be tried; every missing one is named
   with its fix.  0 when the root is usable. */
static int rg_root_missing(void) {
    int bad = 0;
    if (sy_exists("unisacc.com") != 1) {
        fprintf(stderr, "register: REFUSE no ./unisacc.com in this root: the registry listing and the trial batch run are started as `sh ./unisacc.com ...` (a private clone does not carry it); fix: cp SHARED_ROOT/unisacc.com SHARED_ROOT/unisacc.com.build.json .\n");
        bad++;
    }
    if (sy_exists("out/.") != 1) {
        fprintf(stderr, "register: REFUSE no out/ directory in this root: the trial batch run writes out/register-ID-PID/ (out/ is untracked, a fresh clone has none); fix: mkdir out\n");
        bad++;
    }
    return bad;
}

/* Check the generated fourteen-column row before append: expect is rc0:MARKER,
   followed by the headers contract and commit (or platform release) tier. */
static int rg_row_ok(const char *row, const char *marker) {
    int fields = 0; size_t ml = tx_len(marker, 512); const char *at = row, *expect = 0, *headers = 0, *tier = 0;
    for (; *at; at++) if (*at == '\t') { fields++; if(fields==11)expect=at+1;if(fields==12)headers=at+1;if(fields==13)tier=at+1; }
    if(fields!=13||!expect||!headers||!tier||strncmp(expect,"rc0:",4)||(size_t)(headers-expect)!=ml+5||memcmp(expect+4,marker,ml))return 0;
    if(!((tier-headers==8&&!memcmp(headers,"product\t",8))||(tier-headers==5&&!memcmp(headers,"tree\t",5))))return 0;
    return tx_eqz(tier,"commit\n")||tx_eqz(tier,"release\n");
}

static int clean(const char *s) { for (; *s; s++) if (*s == '\t' || *s == '\n' || *s == '\r') return 0; return 1; }

/* 1 when a line of the file starts with KEY followed by a TAB */
static int has_key(const char *path, const char *key) {
    size_t n; char *b = cx_read(path, &n); long at = 0, kl = tx_len(key, 256);
    if (!b) rg_die("cannot read", path);
    while (at < (long)n) {
        long e = tx_chr(b + at, (long)n - at, '\n'), ln = e < 0 ? (long)n - at : e;
        if (ln > kl && tx_prefix(b + at, ln, key, kl) && b[at + kl] == '\t') return 1;
        at += ln + 1;
    }
    return 0;
}

static int append(const char *path, const char *line) {
    int fd = sy_open(path, O_WRONLY | O_APPEND, 0), bad;
    if (fd < 0) return 1;
    bad = sy_write_all(fd, line, tx_len(line, 1 << 16)) != 0;
    return sy_close(fd) != 0 || bad;
}

/* rewrite PATH without the one line equal to LINE (which ends in \n); 0 when it was found and removed */
static int take_out(const char *path, const char *line) {
    size_t n; char *b = cx_read(path, &n); long at = 0, ll = tx_len(line, 1 << 16);
    if (!b) return 1;
    while (at < (long)n) {
        long e = tx_chr(b + at, (long)n - at, '\n'), ln = e < 0 ? (long)n - at : e + 1;
        if (ln == ll && tx_same(b + at, ln, line, ll)) {
            int fd = sy_open(path, O_WRONLY | O_TRUNC, 0), bad;
            if (fd < 0) return 1;
            bad = sy_write_all(fd, b, at) != 0 || sy_write_all(fd, b + at + ln, (long)n - at - ln) != 0;
            return sy_close(fd) != 0 || bad;
        }
        at += ln;
    }
    return 1;
}

/* run ARGV, the LAST cap-1 bytes of stdout+stderr into OUT (terminated): the summaries come last; exit code or -1.
   Every child is started under ./tools/bound SECONDS (argv[0], argv[1]): that is its time bound, and an argv
   without it is not run. */
static int run(char **argv, char *out, long cap) {
    int ofd, pid, ex = 0, code = 0, sig = 0; long n = 0, r, k, half = (cap - 1) / 2;
    out[0] = 0;
    if (!argv[0] || !tx_eqz(argv[0], "./tools/bound") || !argv[1]) return -1;
    pid = sy_spawn_pipe(argv, 0, 0, &ofd, 0);
    if (pid < 0) return -1;
    for (;;) {
        if (n == cap - 1) { for (k = 0; k < n - half; k++) out[k] = out[k + half]; n -= half; }
        r = sy_read(ofd, out + n, cap - 1 - n);
        if (r <= 0) break;
        n += r;
    }
    out[n] = 0;
    sy_close(ofd);
    if (sy_wait_status(pid, 0, &ex, &code, &sig) != pid || !ex) return -1;
    return code;
}

int main(int argc, char **argv) {
    static char brow[8192], crow[8192], cid[512], root[4096], parent[4400], buf[1 << 16];
    const char *id, *check, *marker, *text, *files, *layer, *headers;
    const char *arguments="-";
    if(argc>=3&&tx_eqz(argv[argc-2],"--args")){arguments=argv[argc-1];argc-=2;if(!*arguments||!clean(arguments))rg_die("empty args, TAB or newline in args",0);}
    int rc, okrun, lk; long at;
    if (argc < 6 || argc > 8) rg_die("usage", "ID CHECK.cx MARKER \"COVERAGE TEXT\" \"FILES\" [LAYER] [HEADERS] [--args ARGS]");
    id = argv[1]; check = argv[2]; marker = argv[3]; text = argv[4]; files = argv[5]; layer = argc >= 7 ? argv[6] : "interfaces";
    headers = argc == 8 ? argv[7] : "product";
    if (!clean(id) || !clean(check) || !clean(marker) || !clean(text) || !clean(files) || !clean(layer) || !*id || !*marker) rg_die("empty field, TAB or newline in a field", 0);
    if (!tx_eqz(headers, "product") && !tx_eqz(headers, "tree")) rg_die("HEADERS must be product or tree", headers);
    if (!rg_marker_ok(marker)) rg_die("MARKER must be one rc0: tail ([A-Z0-9_]+), register adds the \"rc0:\" itself", marker);
    if (rg_root_missing()) { fprintf(stderr, "register: nothing was written (id %s)\n", id); return 2; }
    if (!sy_exists(check)) rg_die("no such check", check);
    if (tx_snprintf(cid, sizeof cid, "%s.%s", layer, id) >= (int)sizeof cid) rg_die("id too long", id);
    char cache[4400], listbin[4400], batchbin[4400], why[512]; int reused;
    if (sy_realpath(".", root, sizeof root) < 0 || cx_fmt(cache, sizeof cache, "%s/out/register-native", root)) rg_die("prepare path", 0);
    if (sy_mkdir(cache, 0700) && sy_exists(cache) != 1) rg_die("prepare directory", cache);
    if (rn_prepare(root, "tests/run.cx", cache, listbin, sizeof listbin, &reused, why, sizeof why) ||
        rn_prepare(root, "tests/run-batch.cx", cache, batchbin, sizeof batchbin, &reused, why, sizeof why)) rg_die(why, 0);
    lk = rg_lock();   /* the duplicate checks, both appends and --list are one span (see the header) */
    if (has_key(rg_bpath(), id)) rg_die("batch already registered", id);
    if (has_key(rg_cpath(), cid)) rg_die("coverage row already present", cid);
    if (tx_snprintf(brow, sizeof brow, "%s\tIMPLEMENTED\t%s\t%s\tSOURCE\tlnx/x86_64\t55\t-\t%s\t%s\t%s\trc0:%s\t%s\t%s\n", id, layer, check, check, arguments, cid, marker, headers, tx_eqz(layer,"platform")?"release":"commit") >= (int)sizeof brow
        || tx_snprintf(crow, sizeof crow, "%s\t%s\tIMPLEMENTED_SEPARATE_BATCH\t%s\t%s\n", cid, layer, text, files) >= (int)sizeof crow) rg_die("row too long", id);
    if (!rg_row_ok(brow, marker)) rg_die("row would fail the tp_expect check", id);
    if (append(rg_bpath(), brow)) rg_die("cannot append", rg_bpath());
    if (append(rg_cpath(), crow)) { take_out(rg_bpath(), brow); rg_die("cannot append", rg_cpath()); }
    {   char *v[] = {"./tools/bound", "55", listbin, "--list", 0};
        rc = run(v, buf, sizeof buf);
        okrun = tx_find(buf, tx_len(buf, sizeof buf), "metadata_valid=1", 16) >= 0;
        if (!okrun) {
            printf("LIST\trc=%d\tmetadata_valid!=1\n", rc);
            /* --list refuses on stderr (REFUSE<TAB>reason<TAB>detail); the capture is the only copy */
            { size_t bn = tx_len(buf, sizeof buf); if (bn) { fwrite(buf, 1, bn, stderr); if (buf[bn - 1] != '\n') fputc('\n', stderr); } }
        }
    }
    if (okrun) {
        /* The batch run is outside the lock: run.cx/run-batch only read the row, while a check that itself
           registers (tools/check-register.cx) would otherwise wait on a lock its own parent holds. */
        rg_unlock(lk); lk = -1;
        if (sy_realpath(".", root, sizeof root) < 0 || tx_snprintf(parent, sizeof parent, "%s/out/register-%s-%d", root, id, sy_pid()) >= (int)sizeof parent
            || sy_mkdir(parent, 0700) != 0) { okrun = 0; fprintf(stderr, "register: cannot create the trial run directory out/register-%s-%d under %s (is out/ a writable directory?)\n", id, sy_pid(), root); parent[0] = 0; }
        else {
            char *v[] = {"./tools/bound", "58", batchbin, root, parent, (char *)id, 0};
            rc = run(v, buf, sizeof buf);
            at = tx_find(buf, tx_len(buf, sizeof buf), "BATCH_RUN\t", 10);
            if (at >= 0) { long e = tx_chr(buf + at, tx_len(buf + at, sizeof buf), '\n'); printf("%.*s\n", (int)(e < 0 ? tx_len(buf + at, sizeof buf) : e), buf + at); }
            okrun = rc == 0 && at >= 0 && tx_find(buf + at, tx_len(buf + at, sizeof buf), "status=PASS", 11) >= 0;
            if (!okrun) fputs(buf, stderr);
        }
    }
    if (parent[0]) sy_rmdir(parent);   /* the trial run's empty reservation: out/register-ID-PID must not pile up */
    if (!okrun) {
        int t1, t2; long bno, cno;
        /* --list can fail while the append/validate lock is still owned here. */
        rg_unlock(lk); lk = -1;
        lk = rg_lock_rollback();   /* the rollback reads and rewrites both files: take the span back */
        if (lk < 0) {   /* never a bare timeout: say which rows are still where, and exit by a dedicated code */
            bno = line_of(rg_bpath(), brow); cno = line_of(rg_cpath(), crow);
            fprintf(stderr, "register: tables may be dirty: leftover row %s at batches.tsv:%ld, coverage.tsv:%ld\n", id, bno, cno);
            printf("REGISTER\tid=%s\tstatus=DIRTY\trows_left=2\n", id);
            return 3;
        }
        t1 = take_out(rg_bpath(), brow); t2 = take_out(rg_cpath(), crow);
        rg_unlock(lk);
        printf("REGISTER\tid=%s\tstatus=ROLLED_BACK\trows_removed=%d\n", id, (!t1) + (!t2));
        return 1;
    }
    if (lk >= 0) rg_unlock(lk);
    printf("REGISTER\tid=%s\tstatus=REGISTERED\n", id);
    /* build/batch-packages.tsv is generated from the registry: a new batch makes the committed copy stale
       (check-batch-packages table-fresh).  Regenerate it here, only for the real tables (a fixture run with
       UNISACC_TABLES set must not rewrite the checked-in build table). */
    if (!getenv("UNISACC_TABLES") || !*getenv("UNISACC_TABLES")) {
        char *v[] = {"./tools/bound", "58", "sh", "./unisacc.com", "tools/batch-packages-gen.cx", "--", "--write", 0};
        rc = run(v, buf, sizeof buf);
        if (rc != 0) {
            fprintf(stderr, "register: batch registered but build/batch-packages.tsv NOT regenerated (rc=%d); run tools/batch-packages-gen.cx -- --write\n", rc);
            printf("REGISTER\tid=%s\tbatch_packages=STALE\n", id);
            return 4;
        }
        printf("REGISTER\tid=%s\tbatch_packages=REGENERATED\n", id);
        /* DSG-REG1: also leave the per-batch manifest tests/manifests/ID.tsv (checked by tools/reg-manifest.cx,
           so a later commit that carries one of the three rows without the others is caught). */
        {   size_t pn = 0; char *pb = (char *)cx_read("build/batch-packages.tsv", &pn), key[600], mp[700], *m;
            size_t i = 0, kl, bl = strlen(brow), cl = strlen(crow), ml;
            if (!pb || cx_fmt(key, sizeof key, "batch\t%s\t", id) || cx_fmt(mp, sizeof mp, "tests/manifests/%s.tsv", id)) { printf("REGISTER\tid=%s\tmanifest=SKIPPED\n", id); return 0; }
            kl = strlen(key);
            while (i < pn) {
                size_t e = i; while (e < pn && pb[e] != '\n') e++;
                if (e - i > kl && !memcmp(pb + i, key, kl)) {
                    ml = 6 + bl + 9 + cl + 9 + (e - i) + 1; m = (char *)mm_alloc(ml + 1);
                    if (!m) break;
                    memcpy(m, "batch\t", 6); mm_copy(m + 6, ml + 1 - 6, brow, bl);
                    memcpy(m + 6 + bl, "coverage\t", 9); mm_copy(m + 15 + bl, ml + 1 - 15 - bl, crow, cl);
                    memcpy(m + 15 + bl + cl, "packages\t", 9); mm_copy(m + 24 + bl + cl, ml + 1 - 24 - bl - cl, pb + i, e - i); m[24 + bl + cl + (e - i)] = '\n';
                    sy_mkdir("tests/manifests", 0755);
                    printf("REGISTER\tid=%s\tmanifest=%s\n", id, cx_write(mp, m, ml) ? "WRITE_FAILED" : "WRITTEN");
                    mm_free(m); return 0;
                }
                i = e + 1;
            }
            printf("REGISTER\tid=%s\tmanifest=SKIPPED\n", id);
        }
    }
    return 0;
}
