/* tools/register.cx -- register a check program as a test batch, validate the registry, run it once.
 *
 *   sh ./unisacc.com tools/register.cx -- ID CHECK.cx MARKER "COVERAGE TEXT" "FILES" [LAYER] [HEADERS] [--args ARGS]
 *
 * Appends one SOURCE batch row to tests/batches.tsv
 *   ID IMPLEMENTED LAYER CHECK SOURCE lnx/x86_64 55 - CHECK - LAYER.ID rc0:MARKER HEADERS
 * and one coverage row to tests/coverage.tsv
 *   LAYER.ID LAYER IMPLEMENTED_SEPARATE_BATCH COVERAGE-TEXT FILES
 * (LAYER defaults to interfaces), then runs tests/run.cx --list (metadata_valid=1 required) and
 * tests/run-batch.cx for ID into out/register-ID-PID/.  On any refusal or failure exactly the two appended
 * lines are taken out again (other lines, even ones appended meanwhile, stay) and the exit is 1; an ID that
 * is already registered, a missing CHECK, a TAB or newline in a field, or a MARKER that is not one rc0: tail
 * ([A-Z0-9_]+ — register writes the "rc0:" itself, so a full expect would double the prefix) is refused before
 * anything is written (exit 2).  The row is also checked in memory before the appends: twelve TAB fields and a
 * last field exactly "rc0:"+MARKER, the same shape tp_expect accepts, so a malformed row cannot reach the table
 * where tp_visit would then refuse every batch in the registry.  HEADERS selects the include-search contract
 * the batch declares: "product" (default) means the packaged candidate's embedded headers only, "tree" means
 * ROOT/include is added explicitly for checks that inspect this checkout's include layout.  Prints the BATCH_RUN line and REGISTER<TAB>id=..<TAB>status=REGISTERED|ROLLED_BACK.
 * The six manual steps (two appends, --list, mkdir, run-batch, read the result) as one call.
 *
 * Two registrations of different batches touch the same two files, so the append-validate span holds an
 * exclusive flock on tests/.register.lock: without it a concurrent register sees the other's append and the
 * shared --list validation fails through no fault of either row (observed 2026-11-02, three ROLLED_BACK in a
 * row).  The batch run itself is outside the lock (it only reads the row) and the rollback takes it back
 * with its own, longer, retried wait (REGISTER_ROLLBACK_LOCK_MS, default 20000, three attempts): if the lock
 * is still held the rollback prints "tables may be dirty: leftover row <id> at batches.tsv:<line>,
 * coverage.tsv:<line>", reports status=DIRTY and exits 3, so a refusal can never end in a silent lock
 * timeout with the rows still in the registry.  A register call's own lock wait is REGISTER_LOCK_MS:
 * a registered check that registers too would otherwise wait on a lock its own parent holds.  Waiting is capped at REGISTER_LOCK_MS (default and maximum 45000) and a timeout is
 * a named failure, not a silent retry loop.  The lock fd is close-on-exec so run.cx/run-batch cannot inherit
 * it.  Rollback removes exactly this call's two line contents and leaves every other line alone.
 *
 * UNISACC_TABLES names the table directory (default tests): the two tables, their lock, and the tables that
 * tests/run.cx --list and tests/run-batch.cx read all move together.  A check that registers fixtures points
 * it at a private copy, so its fixture rows never meet another lane's writes (the byte-for-byte restore
 * assertions of tools/check-register.cx cannot hold while a third party appends in the same window).
 *
 * The root it runs in (the current directory) must hold ./unisacc.com: --list and run-batch are started
 * through it.  A root without it used to end in a bare ROLLED_BACK rc=1 with no reason; it is checked before
 * the lock and before anything is written, named on stderr with the command that fixes it, exit 2.
 * Nothing is created under out/ (project owner 2026-11-13): the prepared runner cache is
 * sy_tmpdir()/unisacc-register-native and the trial run directory sy_tmpdir()/register-ID-PID; an out/
 * directory is neither required nor made. */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.posix
#pragma unisa use sys.time
#pragma unisa use sys.env
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use text.fmt
#pragma unisa use mem.heap
#pragma unisa use cxlib.runnerprep

static void rg_die(const char *a, const char *b) { fprintf(stderr, "register: %s%s%s\n", a, b ? ": " : "", b ? b : ""); exit(2); }

/* the registry lock: exclusive flock on tests/.register.lock, waited for at most REGISTER_LOCK_MS
   (default 45000, also the maximum: a longer wait means the holder is not making progress and the
   caller should be told so by name).  Returns the held fd; releases are just sy_flock(UN)+close. */
/* The two tables live in tests/ unless UNISACC_TABLES names another directory.  A check that registers
   fixtures then works on a private copy instead of racing every other registration lane on the real
   files (the byte-for-byte restore assertions cannot hold while someone else appends). */
static const char *rg_tdir(void) { const char *e = getenv("UNISACC_TABLES"); return e && *e ? e : "tests"; }
static const char *rg_bpath(void) { static char p[4400]; if (tx_snprintf(p, sizeof p, "%s/batches.tsv", rg_tdir()) >= (int)sizeof p) rg_die("path bound", "batches.tsv"); return p; }
static const char *rg_cpath(void) { static char p[4400]; if (tx_snprintf(p, sizeof p, "%s/coverage.tsv", rg_tdir()) >= (int)sizeof p) rg_die("path bound", "coverage.tsv"); return p; }
static const char *rg_lockpath(void) { static char p[4400]; if (tx_snprintf(p, sizeof p, "%s/.register.lock", rg_tdir()) >= (int)sizeof p) rg_die("path bound", "lock"); return p; }
static long rg_lock_ms(void) {
    const char *e = getenv("REGISTER_LOCK_MS"); long v = e ? atol(e) : 45000;
    return v < 100 ? 100 : v > 45000 ? 45000 : v;
}
/* One bounded attempt at the exclusive lock: the held fd, or -1 when the wait ran out.  Anything but
   "held by someone else" and EINTR is fatal by name. */
static int rg_try_lock(long ms) {
    long waited = 0; int fd = sy_open(rg_lockpath(), O_RDWR | O_CREAT, 0666), r;
    if (fd < 0) rg_die("cannot open lock", rg_lockpath());
    if (fcntl(fd, F_SETFD, FD_CLOEXEC) != 0) { sy_close(fd); rg_die("cannot mark lock close-on-exec", rg_lockpath()); }
    for (;;) {
        r = sy_flock(fd, 2 | 4);   /* exclusive, do not wait */
        if (r == 0) return fd;
        if (r != -EWOULDBLOCK && r != -EINTR) { sy_close(fd); rg_die("cannot flock", rg_lockpath()); }
        if (waited >= ms) { sy_close(fd); return -1; }
        sy_sleep_ms(50); waited += 50;
    }
}
static int rg_lock(void) {
    long ms = rg_lock_ms(); int fd = rg_try_lock(ms);
    if (fd < 0) { fprintf(stderr, "register: lock timeout: %s held longer than %ld ms\n", rg_lockpath(), ms); exit(2); }
    return fd;
}
/* The rollback's wait is its own and longer, and it retries: a refusal must end either with the two rows
   gone or with a named dirty table, never with a bare lock timeout (the rows are then still in the registry
   and every later run sees them).  REGISTER_ROLLBACK_LOCK_MS overrides it for tests. */
static long rg_rollback_ms(void) {
    const char *e = getenv("REGISTER_ROLLBACK_LOCK_MS"); long v = e ? atol(e) : 20000;
    return v < 100 ? 100 : v > 120000 ? 120000 : v;
}
static int rg_lock_rollback(void) {
    int fd = -1, attempt;
    for (attempt = 0; attempt < 3; attempt++) { fd = rg_try_lock(rg_rollback_ms()); if (fd >= 0) break; }
    return fd;
}

/* 1-based line number of the line equal to LINE (which ends in \n) in PATH, 0 when it is not there */
static long line_of(const char *path, const char *line) {
    size_t n; char *b = cx_read(path, &n); long at = 0, ll = tx_len(line, 1 << 16), no = 0;
    if (!b) return 0;
    while (at < (long)n) {
        long e = tx_chr(b + at, (long)n - at, '\n'), ln = e < 0 ? (long)n - at : e + 1;
        no++;
        if (ln == ll && tx_same(b + at, ln, line, ll)) { free(b); return no; }
        at += ln;
    }
    free(b);
    return 0;
}
static void rg_unlock(int fd) { if (fd >= 0) { sy_flock(fd, 8); sy_close(fd); } }

/* tp_expect in tools/cxlib/testplan.cx accepts "rc0:" followed by [A-Z0-9_]+ only, and tests/run-batch.cx
   validates the WHOLE registry through tp_visit: one malformed expect makes every batch refuse (2026-11-02:
   one uncommitted row "rc0:rc0:ROOT_IDENTITY" blocked 27 census rows).  register.cx writes that field as
   "rc0:" + MARKER, so a MARKER that is already an expect would become a double prefix; refuse it by name
   before anything is written. */
static int rg_marker_ok(const char *m) {
    if (!*m) return 0;
    for (; *m; m++) if (!((*m >= 'A' && *m <= 'Z') || (*m >= '0' && *m <= '9') || *m == '_')) return 0;
    return 1;
}
/* The two untracked things a root needs before a registration can be tried; every missing one is named
   with its fix.  0 when the root is usable. */
static int rg_root_missing(void) {
    int bad = 0;
    if (sy_exists("unisacc.com") != 1) {
        fprintf(stderr, "register: REFUSE no ./unisacc.com in this root: the registry listing and the trial batch run are started as `sh ./unisacc.com ...` (a private clone does not carry it); fix: cp SHARED_ROOT/unisacc.com SHARED_ROOT/unisacc.com.build.json .\n");
        bad++;
    }
    /* no out/ requirement any more (project owner 2026-11-13: nothing may be created under out/ in the
       checkout): the runner cache and the trial run directory live under sy_tmpdir() */
    return bad;
}

/* Check the generated fourteen-column row before append: expect is rc0:MARKER,
   followed by the headers contract and commit (or platform release) tier. */
static int rg_row_ok(const char *row, const char *marker) {
    int fields = 0; size_t ml = tx_len(marker, 512); const char *at = row, *expect = 0, *headers = 0, *tier = 0;
    for (; *at; at++) if (*at == '\t') { fields++; if(fields==11)expect=at+1;if(fields==12)headers=at+1;if(fields==13)tier=at+1; }
    if(fields!=13||!expect||!headers||!tier||strncmp(expect,"rc0:",4)||(size_t)(headers-expect)!=ml+5||memcmp(expect+4,marker,ml))return 0;
    if(!((tier-headers==8&&!memcmp(headers,"product\t",8))||(tier-headers==5&&!memcmp(headers,"tree\t",5))))return 0;
    return tx_eqz(tier,"commit\n")||tx_eqz(tier,"release\n");
}

static int clean(const char *s) { for (; *s; s++) if (*s == '\t' || *s == '\n' || *s == '\r') return 0; return 1; }
/* P9 登记贴线告警(只告警,不拦): 读 tests/run-batch.cx 追加的实测耗时表(UNISACC_BATCH_TIMES 或
   $HOME/.cache/unisacc/batch-times.tsv),该批已有实测最大值超过 45000 毫秒时打一行具名 WARN.
   判据与文案同 tools/batch-timing.cx max;表只是观测,不改登记结果与退出码。 */
#define RG_WARN_MS 45000
static void rg_timing_warn(const char *id) {
    const char *bt = sy_env("UNISACC_BATCH_TIMES"), *home = sy_env("HOME"); char tp[4400]; size_t n = 0; char *s; long at = 0, best = -1, idn = tx_len(id, 512);
    if (bt && *bt) { if (tx_eqz(bt, "off") || cx_fmt(tp, sizeof tp, "%s", bt)) return; }
    else if (!home || !*home || cx_fmt(tp, sizeof tp, "%s/.cache/unisacc/batch-times.tsv", home)) return;
    s = cx_read(tp, &n);
    if (!s) return;
    while (at < (long)n) {
        long e = at, ioff, ilen, toff, tlen, v = 0, i; int d = 0;
        while (e < (long)n && s[e] != '\n') e++;
        if (e > at && s[at] != '#' && !tx_field(s + at, e - at, '\t', 1, &ioff, &ilen) && !tx_field(s + at, e - at, '\t', 3, &toff, &tlen) &&
            ilen == idn && mm_same(s + at + ioff, id, idn)) {
            for (i = 0; i < tlen && s[at + toff + i] >= '0' && s[at + toff + i] <= '9'; i++) { v = v * 10 + (s[at + toff + i] - '0'); d = 1; }
            if (d && i == tlen && v > best) best = v;
        }
        at = e + 1;
    }
    mm_free(s);
    if (best > RG_WARN_MS) printf("REGISTER\tid=%s\tWARN=near-limit\tmax_ms=%ld\tthreshold_ms=%d\thint=tools/batch-timing.cx split %s\n", id, best, RG_WARN_MS, id);
}

/* 1 when a line of the file starts with KEY followed by a TAB */
static int has_key(const char *path, const char *key) {
    size_t n; char *b = cx_read(path, &n); long at = 0, kl = tx_len(key, 256);
    if (!b) rg_die("cannot read", path);
    while (at < (long)n) {
        long e = tx_chr(b + at, (long)n - at, '\n'), ln = e < 0 ? (long)n - at : e;
        if (ln > kl && tx_prefix(b + at, ln, key, kl) && b[at + kl] == '\t') return 1;
        at += ln + 1;
    }
    return 0;
}

static int append(const char *path, const char *line) {
    int fd = sy_open(path, O_WRONLY | O_APPEND, 0), bad;
    if (fd < 0) return 1;
    bad = sy_write_all(fd, line, tx_len(line, 1 << 16)) != 0;
    return sy_close(fd) != 0 || bad;
}

/* rewrite PATH without the one line equal to LINE (which ends in \n); 0 when it was found and removed */
static int take_out(const char *path, const char *line) {
    size_t n; char *b = cx_read(path, &n); long at = 0, ll = tx_len(line, 1 << 16);
    if (!b) return 1;
    while (at < (long)n) {
        long e = tx_chr(b + at, (long)n - at, '\n'), ln = e < 0 ? (long)n - at : e + 1;
        if (ln == ll && tx_same(b + at, ln, line, ll)) {
            int fd = sy_open(path, O_WRONLY | O_TRUNC, 0), bad;
            if (fd < 0) return 1;
            bad = sy_write_all(fd, b, at) != 0 || sy_write_all(fd, b + at + ln, (long)n - at - ln) != 0;
            return sy_close(fd) != 0 || bad;
        }
        at += ln;
    }
    return 1;
}

/* run ARGV, the LAST cap-1 bytes of stdout+stderr into OUT (terminated): the summaries come last; exit code or -1.
   Every child is started under ./tools/bound SECONDS (argv[0], argv[1]): that is its time bound, and an argv
   without it is not run. */
/* run_start spawns (the bound rule as in run), run_collect drains and reaps: between them the caller may
   do independent work while the child runs (the batch-packages runner prepare overlaps the trial run). */
static int run_start(char **argv, int *ofd) {
    if (!argv[0] || !tx_eqz(argv[0], "./tools/bound") || !argv[1]) return -1;
    return sy_spawn_pipe(argv, 0, 0, ofd, 0);
}
static int run_collect(int pid, int ofd, char *out, long cap) {
    int ex = 0, code = 0, sig = 0; long n = 0, r, k, half = (cap - 1) / 2;
    out[0] = 0;
    if (pid < 0) return -1;
    for (;;) {
        if (n == cap - 1) { for (k = 0; k < n - half; k++) out[k] = out[k + half]; n -= half; }
        r = sy_read(ofd, out + n, cap - 1 - n);
        if (r <= 0) break;
        n += r;
    }
    out[n] = 0;
    sy_close(ofd);
    if (sy_wait_status(pid, 0, &ex, &code, &sig) != pid || !ex) return -1;
    return code;
}
static int run(char **argv, char *out, long cap) {
    int ofd, pid, ex = 0, code = 0, sig = 0; long n = 0, r, k, half = (cap - 1) / 2;
    out[0] = 0;
    if (!argv[0] || !tx_eqz(argv[0], "./tools/bound") || !argv[1]) return -1;
    pid = sy_spawn_pipe(argv, 0, 0, &ofd, 0);
    if (pid < 0) return -1;
    for (;;) {
        if (n == cap - 1) { for (k = 0; k < n - half; k++) out[k] = out[k + half]; n -= half; }
        r = sy_read(ofd, out + n, cap - 1 - n);
        if (r <= 0) break;
        n += r;
    }
    out[n] = 0;
    sy_close(ofd);
    if (sy_wait_status(pid, 0, &ex, &code, &sig) != pid || !ex) return -1;
    return code;
}

/* ---- --tool mode: one command for the inventory side of "a new tools/NAME.cx" ----
 *
 *   sh ./unisacc.com tools/register.cx -- --tool tools/NAME.cx [--tool tools/OTHER.cx ...] [--pin-owner OWNER]
 *
 * (a) inserts "tools/NAME.cx<TAB>regular" (symlink for a symlink) into tests/tools-compile-sources.tsv at its
 *     C byte order place (unsigned byte compare, the order of LC_ALL=C sort and of the git index);
 * (b) makes the tools-compile-NNN rows of batches.tsv exactly 000..ceil(rows/8)-1: missing rows are added
 *     after the last existing shard row, rows past the range are taken out;
 * (c) every 64-hex literal of the tool that has no tools/pins.tsv row is printed as PIN_NEEDED with the row
 *     to add; with --pin-owner OWNER the row "FILE#HEX literal - HEX OWNER ok" is appended instead;
 * (d) git add of each tool that is not tracked yet (a tracked file is left alone: its staging is the caller's).
 * Then tests/tools-compile.cx --shards . must print the computed count.  Everything is validated before the
 * first write; when a later step or the verification fails the three tables are written back from the bytes
 * read at the start and the files this call staged are unstaged again (git rm --cached), exit 1 with the
 * step named.  A second identical call changes nothing and ends status=UNCHANGED.  Nothing is compiled and
 * no PASS is recorded here: the shard batches themselves still have to be run. */
#define RG_TOOLS_MAX 64
#define RG_SOURCES "tests/tools-compile-sources.tsv"
#define RG_PINS "tools/pins.tsv"
static int rg_bcmp(const char *a, long al, const char *b, long bl) {
    long i, m = al < bl ? al : bl;
    for (i = 0; i < m; i++) if ((unsigned char)a[i] != (unsigned char)b[i]) return (unsigned char)a[i] < (unsigned char)b[i] ? -1 : 1;
    return al < bl ? -1 : al > bl;
}
static int rg_ishex(char c) { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'); }
/* shard index of a "tools-compile-NNN<TAB>" line, -1 for any other line */
static long rg_shard_of(const char *l, long ln) {
    long i = 14, v = 0;
    if (ln < 16 || memcmp(l, "tools-compile-", 14)) return -1;
    while (i < ln && l[i] >= '0' && l[i] <= '9' && v < 100000) v = v * 10 + (l[i++] - '0');
    return i > 14 && i < ln && l[i] == '\t' ? v : -1;
}
/* 1 when pins.tsv (PB, PN) has a row for TOOL (path "TOOL#..." or "TOOL:...") whose value field is HEX */
static int rg_pin_has(const char *pb, long pn, const char *tool, const char *hex) {
    long at = 0, tl = (long)strlen(tool);
    while (at < pn) {
        long e = at, f = 0, k;
        while (e < pn && pb[e] != '\n') e++;
        if (e - at > tl && !memcmp(pb + at, tool, (size_t)tl) && (pb[at + tl] == '#' || pb[at + tl] == ':'))
            for (k = at; k < e; k++) if (pb[k] == '\t' && ++f == 3) { if (e - k - 1 >= 65 && !memcmp(pb + k + 1, hex, 64) && pb[k + 65] == '\t') return 1; break; }
        at = e + 1;
    }
    return 0;
}
static int rg_tool_restore(const char *path, const char *b, size_t n, int changed) {
    if (!changed) return 0;
    if (cx_write(path, b, n)) { fprintf(stderr, "register: --tool rollback could NOT restore %s\n", path); return 1; }
    return 0;
}
static int rg_tool_mode(int argc, char **argv) {
    static char buf[1 << 15];
    const char *tools[RG_TOOLS_MAX], *kinds[RG_TOOLS_MAX], *owner = 0; int staged[RG_TOOLS_MAX], have[RG_TOOLS_MAX], nt = 0, i, j, rc, lk;
    char *sb, *bb, *pb = 0, *ns, *nb, *np = 0; size_t sn = 0, bn = 0, pn = 0, nsn = 0, nbn = 0, npn = 0;
    long at, rows = 0, shards, added_src = 0, added_sh = 0, removed_sh = 0, added_pin = 0, need_pin = 0, ins, *seen;
    int ch_s, ch_b, ch_p = 0, dirty = 0, did = 0;
    for (i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--tool") && i + 1 < argc) {
            const char *t = argv[++i]; size_t tl = strlen(t); struct stat st; int dup = 0;
            if (tl < 10 || tl > 240 || memcmp(t, "tools/", 6) || strcmp(t + tl - 3, ".cx") || !clean(t) || strstr(t, "..") || strstr(t, "//")) rg_die("--tool wants tools/NAME.cx", t);
            if (lstat(t, &st)) rg_die("--tool: no such file", t);
            if (!S_ISREG(st.st_mode) && !S_ISLNK(st.st_mode)) rg_die("--tool: not a regular file or symlink", t);
            for (j = 0; j < nt; j++) if (!strcmp(tools[j], t)) dup = 1;
            if (dup) continue;
            if (nt == RG_TOOLS_MAX) rg_die("too many --tool", t);
            tools[nt] = t; kinds[nt] = S_ISLNK(st.st_mode) ? "symlink" : "regular"; staged[nt] = 0; nt++;
        } else if (tx_eqz(argv[i], "--pin-owner") && i + 1 < argc) {
            owner = argv[++i]; if (!*owner || !clean(owner)) rg_die("--pin-owner wants a plain name", owner);
        } else rg_die("usage", "--tool tools/NAME.cx [--tool ...] [--pin-owner OWNER]");
    }
    if (!nt) rg_die("usage", "--tool tools/NAME.cx [--tool ...] [--pin-owner OWNER]");
    for (i = 1; i < nt; i++) {   /* byte order, so one merge pass places them all */
        const char *t = tools[i], *k = kinds[i];
        for (j = i - 1; j >= 0 && rg_bcmp(tools[j], (long)strlen(tools[j]), t, (long)strlen(t)) > 0; j--) { tools[j + 1] = tools[j]; kinds[j + 1] = kinds[j]; }
        tools[j + 1] = t; kinds[j + 1] = k;
    }
    if (rg_root_missing()) { fprintf(stderr, "register: nothing was written (--tool)\n"); return 2; }
    if (sy_exists("tools/bound") != 1) rg_die("--tool: no ./tools/bound in this root", 0);
    if (sy_exists("tests/tools-compile.cx") != 1) rg_die("--tool: no tests/tools-compile.cx in this root", 0);
    lk = rg_lock();
    sb = cx_read(RG_SOURCES, &sn); bb = cx_read(rg_bpath(), &bn);
    if (!sb) rg_die("cannot read", RG_SOURCES);
    if (!bb) rg_die("cannot read", rg_bpath());
    if ((sn && sb[sn - 1] != '\n') || (bn && bb[bn - 1] != '\n')) rg_die("--tool: table does not end in a newline", sn && sb[sn - 1] != '\n' ? RG_SOURCES : rg_bpath());
    /* (a) merge the tools into the sources table.  Presence is decided over the whole table first: the
       reviewed table is compared as a set by tools-compile and is not guaranteed to be in order everywhere,
       so a row that stands out of order must still count as registered and never be inserted twice. */
    ns = malloc(sn + (size_t)nt * 260 + 1);
    if (!ns) rg_die("allocation", 0);
    for (j = 0; j < nt; j++) have[j] = 0;
    for (at = 0; at < (long)sn;) {
        long e = at, pl = 0;
        while (e < (long)sn && sb[e] != '\n') e++;
        while (pl < e - at && sb[at + pl] != '\t') pl++;
        for (j = 0; j < nt; j++) if (!rg_bcmp(tools[j], (long)strlen(tools[j]), sb + at, pl)) have[j] = 1;
        at = e + 1;
    }
    for (at = 0, j = 0; at < (long)sn;) {
        long e = at, pl = 0;
        while (e < (long)sn && sb[e] != '\n') e++;
        while (pl < e - at && sb[at + pl] != '\t') pl++;
        for (;; j++) {
            if (j < nt && have[j]) continue;
            if (j >= nt || rg_bcmp(tools[j], (long)strlen(tools[j]), sb + at, pl) > 0) break;
            nsn += (size_t)tx_snprintf(ns + nsn, 260, "%s\t%s\n", tools[j], kinds[j]); added_src++; rows++;
        }
        if (mm_copy(ns + nsn, (long)(sn + (size_t)nt * 260 + 1 - nsn), sb + at, (long)(e + 1 - at))) rg_die("sources copy bound", 0); nsn += (size_t)(e + 1 - at); rows++;
        at = e + 1;
    }
    for (; j < nt; j++) if (!have[j]) { nsn += (size_t)tx_snprintf(ns + nsn, 260, "%s\t%s\n", tools[j], kinds[j]); added_src++; rows++; }
    shards = rows / 8 + (rows % 8 != 0);
    /* (b) the shard rows: exactly 0..shards-1 */
    seen = calloc((size_t)shards + 1, sizeof *seen); nb = malloc(bn + (size_t)shards * 256 + 1);
    if (!seen || !nb) rg_die("allocation", 0);
    for (at = 0, ins = -1; at < (long)bn;) {
        long e = at, s;
        while (e < (long)bn && bb[e] != '\n') e++;
        s = rg_shard_of(bb + at, e - at);
        if (s >= 0 && s < shards) { seen[s] = 1; ins = e + 1; }
        at = e + 1;
    }
    if (ins < 0) ins = (long)bn;
    for (at = 0;;) {
        if (at == ins) for (j = 0; j < shards; j++) if (!seen[j]) {
            nbn += (size_t)tx_snprintf(nb + nbn, 256, "tools-compile-%03d\tIMPLEMENTED\tcontract\ttests/tools-compile.cx\tSOURCE\tlnx/x86_64\t55\t-\ttests/tools-compile.cx\t{root};{out};%d\ttools.compile-all\trc0:TOOLS_COMPILE\tproduct\tdaily\n", j, j);
            added_sh++;
        }
        if (at >= (long)bn) break;
        {   long e = at;
            while (e < (long)bn && bb[e] != '\n') e++;
            if (rg_shard_of(bb + at, e - at) >= shards) removed_sh++;
            else { if (mm_copy(nb + nbn, (long)(bn + (size_t)shards * 256 + 1 - nbn), bb + at, (long)(e + 1 - at))) rg_die("batches copy bound", 0); nbn += (size_t)(e + 1 - at); }
            at = e + 1;
        }
    }
    /* (c) 64-hex literals without a pins row */
    if (sy_exists(RG_PINS) == 1) { pb = cx_read(RG_PINS, &pn); if (!pb) rg_die("cannot read", RG_PINS); }
    np = malloc(pn + 1); if (!np) rg_die("allocation", 0);
    if (pn && mm_copy(np, (long)pn + 1, pb, (long)pn)) rg_die("pins copy bound", 0);
    npn = pn;
    for (i = 0; i < nt; i++) {
        size_t tn = 0, k = 0; char *tb = cx_read(tools[i], &tn), hex[65]; long line = 1;
        if (!tb) rg_die("cannot read", tools[i]);
        while (k < tn) {
            size_t r = k;
            if (tb[k] == '\n') { line++; k++; continue; }
            if (!rg_ishex(tb[k])) { k++; continue; }
            while (r < tn && rg_ishex(tb[r])) r++;
            if (r - k == 64 && !(k && ((tb[k - 1] >= 'g' && tb[k - 1] <= 'z') || (tb[k - 1] >= 'A' && tb[k - 1] <= 'Z') || tb[k - 1] == '_'))) {
                if (mm_copy(hex, 65, tb + k, 64)) rg_die("hex copy bound", 0); hex[64] = 0;
                if (!rg_pin_has(np, (long)npn, tools[i], hex)) {
                    if (owner && pb) {
                        char *g = realloc(np, npn + 600); if (!g) rg_die("allocation", 0);
                        np = g; if (npn && np[npn - 1] != '\n') np[npn++] = '\n';
                        npn += (size_t)tx_snprintf(np + npn, 590, "%s#%s\tliteral\t-\t%s\t%s\tok\n", tools[i], hex, hex, owner); added_pin++;
                    } else { need_pin++; printf("REGISTER_TOOL\tPIN_NEEDED\t%s:%ld\trow=%s#%s<TAB>literal<TAB>-<TAB>%s<TAB>OWNER<TAB>ok\thint=rerun with --pin-owner OWNER or add the row to %s\n", tools[i], line, tools[i], hex, hex, RG_PINS); }
                }
            }
            k = r;
        }
        free(tb);
    }
    ch_s = nsn != sn || memcmp(ns, sb, sn); ch_b = nbn != bn || memcmp(nb, bb, bn); ch_p = added_pin > 0;
    /* (d) stage what is not tracked yet, then write, then verify; any failure from here on is undone */
    {   const char *step = 0;
        for (i = 0; i < nt && !step; i++) {
            char *q[] = {"./tools/bound", "20", "git", "ls-files", "--error-unmatch", "--", (char *)tools[i], 0};
            char *a[] = {"./tools/bound", "20", "git", "add", "--", (char *)tools[i], 0};
            rc = run(q, buf, sizeof buf);
            if (rc == 0) continue;
            if (rc != 1) { step = "git ls-files"; fprintf(stderr, "register: --tool: git ls-files %s failed rc=%d (is this root a git work tree?): %s\n", tools[i], rc, buf); break; }
            rc = run(a, buf, sizeof buf);
            if (rc != 0) { step = "git add"; fprintf(stderr, "register: --tool: git add %s failed rc=%d: %s\n", tools[i], rc, buf); }
            else { staged[i] = 1; did = 1; }
        }
        if (!step && ch_s) { dirty |= 1; if (cx_write(RG_SOURCES, ns, nsn)) step = "write " RG_SOURCES; }
        if (!step && ch_b) { dirty |= 2; if (cx_write(rg_bpath(), nb, nbn)) step = "write batches.tsv"; }
        if (!step && ch_p) { dirty |= 4; if (cx_write(RG_PINS, np, npn)) step = "write " RG_PINS; }
        if (!step) {
            char *v[] = {"./tools/bound", "55", "sh", "./unisacc.com", "tests/tools-compile.cx", "--", "--shards", ".", 0};
            char want[32]; long bl;
            /* tools-compile reads ROOT/tests/batches.tsv: with UNISACC_TABLES the private batches table is
               not the one it sees, so only the inventory half can be verified there */
            rc = run(v, buf, sizeof buf); bl = (long)strlen(buf);
            tx_snprintf(want, sizeof want, "%ld\n", shards);
            if (rc != 0 || bl < (long)strlen(want) || strcmp(buf + bl - strlen(want), want) || (bl > (long)strlen(want) && buf[bl - strlen(want) - 1] != '\n')) {
                step = "tests/tools-compile.cx --shards";
                fprintf(stderr, "register: --tool: verification failed rc=%d want=%ld got:\n%s%s", rc, shards, buf, bl && buf[bl - 1] == '\n' ? "" : "\n");
            }
        }
        if (step) {
            int bad = 0;
            bad |= rg_tool_restore(RG_PINS, pb, pn, dirty & 4);
            bad |= rg_tool_restore(rg_bpath(), bb, bn, dirty & 2);
            bad |= rg_tool_restore(RG_SOURCES, sb, sn, dirty & 1);
            for (i = 0; i < nt; i++) if (staged[i]) {
                char *u[] = {"./tools/bound", "20", "git", "rm", "--cached", "-q", "--", (char *)tools[i], 0};
                if (run(u, buf, sizeof buf) != 0) { bad = 1; fprintf(stderr, "register: --tool rollback could NOT unstage %s\n", tools[i]); }
            }
            rg_unlock(lk);
            printf("REGISTER_TOOL\tstatus=%s\tfailed_step=%s\n", bad ? "DIRTY" : "ROLLED_BACK", step);
            return bad ? 3 : 1;
        }
    }
    rg_unlock(lk);
    for (i = 0; i < nt; i++) printf("REGISTER_TOOL\ttool=%s\tkind=%s\tgit=%s\n", tools[i], kinds[i], staged[i] ? "ADDED" : "TRACKED");
    printf("REGISTER_TOOL\tsources_added=%ld\tinventory=%ld\tshards=%ld\tshard_rows_added=%ld\tshard_rows_removed=%ld\tpins_added=%ld\tpins_needed=%ld\n", added_src, rows, shards, added_sh, removed_sh, added_pin, need_pin);
    /* new or removed shard batches make the generated build/batch-packages.tsv stale (real tables only) */
    if ((added_sh || removed_sh) && (!getenv("UNISACC_TABLES") || !*getenv("UNISACC_TABLES")) && sy_exists("tools/batch-packages-gen.cx") == 1) {
        char *v[] = {"./tools/bound", "58", "sh", "./unisacc.com", "tools/batch-packages-gen.cx", "--", "--write", 0};
        rc = run(v, buf, sizeof buf);
        if (rc != 0) {
            fprintf(stderr, "register: tool registered but build/batch-packages.tsv NOT regenerated (rc=%d); run tools/batch-packages-gen.cx -- --write\n", rc);
            printf("REGISTER_TOOL\tbatch_packages=STALE\n"); return 4;
        }
        printf("REGISTER_TOOL\tbatch_packages=REGENERATED\n");
    }
    printf("REGISTER_TOOL\tstatus=%s\n", ch_s || ch_b || ch_p || did ? "REGISTERED" : "UNCHANGED");
    return 0;
}

int main(int argc, char **argv) {
    if (argc >= 2 && (tx_eqz(argv[1], "--tool") || tx_eqz(argv[1], "--pin-owner"))) return rg_tool_mode(argc, argv);
    static char brow[8192], crow[8192], cid[512], root[4096], parent[4400], buf[1 << 16];
    const char *id, *check, *marker, *text, *files, *layer, *headers;
    const char *arguments="-";
    static char normargs[8192];
    int norun = 0;
    {   int w = 1, r;   /* --no-run may stand anywhere: strip it and keep the rest in order */
        for (r = 1; r < argc; r++) { if (tx_eqz(argv[r], "--no-run")) norun = 1; else argv[w++] = argv[r]; }
        argc = w; argv[argc] = 0;
    }
    if(argc>=3&&tx_eqz(argv[argc-2],"--args")){arguments=argv[argc-1];argc-=2;if(!*arguments||!clean(arguments))rg_die("empty args, TAB or newline in args",0);
        /* table convention: words of one args field are joined by ';' ("--cases;lock"); spaces and the
           "--opt=value" form are folded into it */
        {   int tok0 = 1, dashed = 0, eqdone = 0; size_t o = 0; const char *p = arguments;
            for (; *p; p++) {
                if (o + 2 >= sizeof normargs) rg_die("args too long", 0);
                if (*p == ' ') { if (o && normargs[o - 1] != ';') { while (p[1] == ' ') p++; if (p[1]) normargs[o++] = ';'; } tok0 = 1; dashed = 0; eqdone = 0; continue; }
                if (tok0) { dashed = p[0] == '-' && p[1] == '-'; tok0 = 0; }
                if (dashed && !eqdone && *p == '=') { normargs[o++] = ';'; eqdone = 1; continue; }
                if (*p == ';') eqdone = 1;
                normargs[o++] = *p;
            }
            normargs[o] = 0; if (!o) rg_die("empty args, TAB or newline in args",0);
            arguments = normargs;
        }
    }
    int rc, okrun, lk; long at;
    if (argc < 6 || argc > 8) rg_die("usage", "ID CHECK.cx MARKER \"COVERAGE TEXT\" \"FILES\" [LAYER] [HEADERS] [--args ARGS]");
    id = argv[1]; check = argv[2]; marker = argv[3]; text = argv[4]; files = argv[5]; layer = argc >= 7 ? argv[6] : "interfaces";
    headers = argc == 8 ? argv[7] : "product";
    if (!clean(id) || !clean(check) || !clean(marker) || !clean(text) || !clean(files) || !clean(layer) || !*id || !*marker) rg_die("empty field, TAB or newline in a field", 0);
    if (!tx_eqz(headers, "product") && !tx_eqz(headers, "tree")) rg_die("HEADERS must be product or tree", headers);
    if (!rg_marker_ok(marker)) rg_die("MARKER must be one rc0: tail ([A-Z0-9_]+), register adds the \"rc0:\" itself", marker);
    if (rg_root_missing()) { fprintf(stderr, "register: nothing was written (id %s)\n", id); return 2; }
    if (!sy_exists(check)) rg_die("no such check", check);
    if (tx_snprintf(cid, sizeof cid, "%s.%s", layer, id) >= (int)sizeof cid) rg_die("id too long", id);
    char cache[4400], listbin[4400], batchbin[4400], bpbin[4400], why[512]; int reused, bpok = 0;
    if (sy_realpath(".", root, sizeof root) < 0 || cx_fmt(cache, sizeof cache, "%s/unisacc-register-native", sy_tmpdir())) rg_die("prepare path", 0);
    if (sy_mkdir(cache, 0700) && sy_exists(cache) != 1) rg_die("prepare directory", cache);
    if (rn_prepare(root, "tests/run.cx", cache, listbin, sizeof listbin, &reused, why, sizeof why) ||
        rn_prepare(root, "tests/run-batch.cx", cache, batchbin, sizeof batchbin, &reused, why, sizeof why)) rg_die(why, 0);
    lk = rg_lock();   /* the duplicate checks, both appends and --list are one span (see the header) */
    if (has_key(rg_bpath(), id)) rg_die("batch already registered", id);
    if (has_key(rg_cpath(), cid)) rg_die("coverage row already present", cid);
    if (tx_snprintf(brow, sizeof brow, "%s\tIMPLEMENTED\t%s\t%s\tSOURCE\tlnx/x86_64\t55\t-\t%s\t%s\t%s\trc0:%s\t%s\t%s\n", id, layer, check, check, arguments, cid, marker, headers, tx_eqz(layer,"platform")?"release":"commit") >= (int)sizeof brow
        || tx_snprintf(crow, sizeof crow, "%s\t%s\tIMPLEMENTED_SEPARATE_BATCH\t%s\t%s\n", cid, layer, text, files) >= (int)sizeof crow) rg_die("row too long", id);
    if (!rg_row_ok(brow, marker)) rg_die("row would fail the tp_expect check", id);
    if (append(rg_bpath(), brow)) rg_die("cannot append", rg_bpath());
    if (append(rg_cpath(), crow)) { take_out(rg_bpath(), brow); rg_die("cannot append", rg_cpath()); }
    {   char *v[] = {"./tools/bound", "55", listbin, "--list", 0};
        rc = run(v, buf, sizeof buf);
        okrun = tx_find(buf, tx_len(buf, sizeof buf), "metadata_valid=1", 16) >= 0;
        if (!okrun) {
            printf("LIST\trc=%d\tmetadata_valid!=1\n", rc);
            /* --list refuses on stderr (REFUSE<TAB>reason<TAB>detail); the capture is the only copy */
            { size_t bn = tx_len(buf, sizeof buf); if (bn) { fwrite(buf, 1, bn, stderr); if (buf[bn - 1] != '\n') fputc('\n', stderr); } }
        }
    }
    if (okrun && norun) {
        /* --no-run: the rows stay as IMPLEMENTED, nothing is run or recorded as PASS here */
        rg_unlock(lk); lk = -1; parent[0] = 0;
        fprintf(stderr, "register: --no-run: the trial batch run was NOT done; the caller must produce batch evidence for %s itself (tests/run-batch.cx) and remove the rows if it fails\n", id);
    } else if (okrun) {
        /* The batch run is outside the lock: run.cx/run-batch only read the row, while a check that itself
           registers (tools/check-register.cx) would otherwise wait on a lock its own parent holds. */
        rg_unlock(lk); lk = -1;
        /* tests/run-batch.cx accepts a canonical output parent below ROOT/out or named TMP/unisacc-affected-* only */
        char tmpc[4096];
        if (sy_realpath(".", root, sizeof root) < 0 || sy_realpath(sy_tmpdir(), tmpc, sizeof tmpc) < 0 || tx_snprintf(parent, sizeof parent, "%s/unisacc-affected-register-%s-%d", tmpc, id, sy_pid()) >= (int)sizeof parent
            || sy_mkdir(parent, 0700) != 0) { okrun = 0; fprintf(stderr, "register: cannot create the trial run directory register-%s-%d under %s (is the temp directory writable?)\n", id, sy_pid(), sy_tmpdir()); parent[0] = 0; }
        else {
            char *v[] = {"./tools/bound", "58", batchbin, root, parent, (char *)id, 0};
            int bofd = -1, bpid = run_start(v, &bofd);
            /* while the trial run executes: prepare the batch-packages-gen native image (preparation only;
               --write itself still runs after PASS, below).  A prepare failure is not a verdict: the
               regeneration then falls back to sh ./unisacc.com. */
            if (bpid >= 0 && (!getenv("UNISACC_TABLES") || !*getenv("UNISACC_TABLES")))
                bpok = !rn_prepare(root, "tools/batch-packages-gen.cx", cache, bpbin, sizeof bpbin, &reused, why, sizeof why);
            rc = run_collect(bpid, bofd, buf, sizeof buf);
            at = tx_find(buf, tx_len(buf, sizeof buf), "BATCH_RUN\t", 10);
            if (at >= 0) { long e = tx_chr(buf + at, tx_len(buf + at, sizeof buf), '\n'); printf("%.*s\n", (int)(e < 0 ? tx_len(buf + at, sizeof buf) : e), buf + at); }
            okrun = rc == 0 && at >= 0 && tx_find(buf + at, tx_len(buf + at, sizeof buf), "status=PASS", 11) >= 0;
            if (!okrun) fputs(buf, stderr);
        }
    }
    if (parent[0]) sy_rmdir(parent);   /* the trial run's empty reservation: sy_tmpdir()/register-ID-PID must not pile up */
    if (!okrun) {
        int t1, t2; long bno, cno;
        /* --list can fail while the append/validate lock is still owned here. */
        rg_unlock(lk); lk = -1;
        lk = rg_lock_rollback();   /* the rollback reads and rewrites both files: take the span back */
        if (lk < 0) {   /* never a bare timeout: say which rows are still where, and exit by a dedicated code */
            bno = line_of(rg_bpath(), brow); cno = line_of(rg_cpath(), crow);
            fprintf(stderr, "register: tables may be dirty: leftover row %s at batches.tsv:%ld, coverage.tsv:%ld\n", id, bno, cno);
            printf("REGISTER\tid=%s\tstatus=DIRTY\trows_left=2\n", id);
            return 3;
        }
        t1 = take_out(rg_bpath(), brow); t2 = take_out(rg_cpath(), crow);
        rg_unlock(lk);
        printf("REGISTER\tid=%s\tstatus=ROLLED_BACK\trows_removed=%d\n", id, (!t1) + (!t2));
        return 1;
    }
    if (lk >= 0) rg_unlock(lk);
    printf("REGISTER\tid=%s\tstatus=%s\n", id, norun ? "REGISTERED_NORUN" : "REGISTERED");
    rg_timing_warn(id);
    /* build/batch-packages.tsv is generated from the registry: a new batch makes the committed copy stale
       (check-batch-packages table-fresh).  Regenerate it here, only for the real tables (a fixture run with
       UNISACC_TABLES set must not rewrite the checked-in build table). */
    if (!getenv("UNISACC_TABLES") || !*getenv("UNISACC_TABLES")) {
        char *v[] = {"./tools/bound", "58", "sh", "./unisacc.com", "tools/batch-packages-gen.cx", "--", "--write", 0};
        char *vn[] = {"./tools/bound", "58", bpbin, "--write", 0};
        rc = run(bpok ? vn : v, buf, sizeof buf);
        if (rc != 0) {
            fprintf(stderr, "register: batch registered but build/batch-packages.tsv NOT regenerated (rc=%d); run tools/batch-packages-gen.cx -- --write\n", rc);
            printf("REGISTER\tid=%s\tbatch_packages=STALE\n", id);
            return 4;
        }
        printf("REGISTER\tid=%s\tbatch_packages=REGENERATED\n", id);
        /* DSG-REG1: also leave the per-batch manifest tests/manifests/ID.tsv (checked by tools/reg-manifest.cx,
           so a later commit that carries one of the three rows without the others is caught). */
        {   size_t pn = 0; char *pb = (char *)cx_read("build/batch-packages.tsv", &pn), key[600], mp[700], *m;
            size_t i = 0, kl, bl = strlen(brow), cl = strlen(crow), ml;
            if (!pb || cx_fmt(key, sizeof key, "batch\t%s\t", id) || cx_fmt(mp, sizeof mp, "tests/manifests/%s.tsv", id)) { printf("REGISTER\tid=%s\tmanifest=SKIPPED\n", id); return 0; }
            kl = strlen(key);
            while (i < pn) {
                size_t e = i; while (e < pn && pb[e] != '\n') e++;
                if (e - i > kl && !memcmp(pb + i, key, kl)) {
                    ml = 6 + bl + 9 + cl + 9 + (e - i) + 1; m = (char *)mm_alloc(ml + 1);
                    if (!m) break;
                    memcpy(m, "batch\t", 6); mm_copy(m + 6, ml + 1 - 6, brow, bl);
                    memcpy(m + 6 + bl, "coverage\t", 9); mm_copy(m + 15 + bl, ml + 1 - 15 - bl, crow, cl);
                    memcpy(m + 15 + bl + cl, "packages\t", 9); mm_copy(m + 24 + bl + cl, ml + 1 - 24 - bl - cl, pb + i, e - i); m[24 + bl + cl + (e - i)] = '\n';
                    sy_mkdir("tests/manifests", 0755);
                    printf("REGISTER\tid=%s\tmanifest=%s\n", id, cx_write(mp, m, ml) ? "WRITE_FAILED" : "WRITTEN");
                    mm_free(m); return 0;
                }
                i = e + 1;
            }
            printf("REGISTER\tid=%s\tmanifest=SKIPPED\n", id);
        }
    }
    return 0;
}
