/* tools/register.cx -- register a check program as a test batch, validate the registry, run it once.
 *
 *   sh ./unisacc.com tools/register.cx -- ID CHECK.cx MARKER "COVERAGE TEXT" "FILES" [LAYER] [HEADERS] [--runner ABS_DEV_DIR] [--args ARGS]
 *   sh ./unisacc.com tools/register.cx -- --tool --sync --dry
 *   sh ./unisacc.com tools/register.cx -- --tool --sync
 *   sh ./unisacc.com tools/register.cx -- --tool --sync --recover
 * A new shard must pass a cold run in a fresh private Git layout within 33000 ms.
 * Publication serializes registry writers. An interrupted writer leaves a versioned
 * .register-txn directory in the table directory. Explicit recovery rolls back the
 * owned keys after validating every snapshot and preserves unrelated edits. Readers
 * that need a consistent four-table view must take the registry lock.
 * The inventory preview holds the registration lock. It may create
 * .register.lock in the table directory. Only the private layout receives
 * proposed table bytes. The shared compile coverage row must agree across
 * its registry and shard manifests. New shard manifests use the official
 * package projection. Product input declarations are fingerprinted only.
 *
 * Appends one SOURCE batch row to tests/batches.tsv
 *   ID IMPLEMENTED LAYER CHECK SOURCE lnx/x86_64 55 - CHECK - LAYER.ID rc0:MARKER HEADERS
 * and one coverage row to tests/coverage.tsv
 *   LAYER.ID LAYER IMPLEMENTED_SEPARATE_BATCH COVERAGE-TEXT FILES
 * (LAYER defaults to interfaces), then runs tests/run.cx --list (metadata_valid=1 required) and
 * tests/run-batch.cx for ID into out/register-ID-PID/.  On any refusal or failure exactly the two appended
 * lines are taken out again (other lines, even ones appended meanwhile, stay) and the exit is 1; an ID that
 * is already registered, a missing CHECK, a TAB or newline in a field, or a MARKER that is not one rc0: tail
 * ([A-Z0-9_]+ — register writes the "rc0:" itself, so a full expect would double the prefix) is refused before
 * anything is written (exit 2).  The row is also checked in memory before the appends: twelve TAB fields and a
 * last field exactly "rc0:"+MARKER, the same shape tp_expect accepts, so a malformed row cannot reach the table
 * where tp_visit would then refuse every batch in the registry.  HEADERS selects the include-search contract
 * the batch declares: "product" (default) means the packaged candidate's embedded headers only, "tree" means
 * ROOT/include is added explicitly for checks that inspect this checkout's include layout.  Prints the BATCH_RUN line and REGISTER<TAB>id=..<TAB>status=REGISTERED|ROLLED_BACK.
 * The six manual steps (two appends, --list, mkdir, run-batch, read the result) as one call.
 *
 * Two registrations of different batches touch the same two files, so the append-validate span holds an
 * exclusive flock on tests/.register.lock: without it a concurrent register sees the other's append and the
 * shared --list validation fails through no fault of either row (observed 2026-11-02, three ROLLED_BACK in a
 * row).  The batch run itself is outside the lock (it only reads the row) and the rollback takes it back
 * with its own, longer, retried wait (REGISTER_ROLLBACK_LOCK_MS, default 20000, three attempts): if the lock
 * is still held the rollback prints "tables may be dirty: leftover row <id> at batches.tsv:<line>,
 * coverage.tsv:<line>", reports status=DIRTY and exits 3, so a refusal can never end in a silent lock
 * timeout with the rows still in the registry.  A register call's own lock wait is REGISTER_LOCK_MS:
 * a registered check that registers too would otherwise wait on a lock its own parent holds.  Waiting is capped at REGISTER_LOCK_MS (default and maximum 45000) and a timeout is
 * a named failure, not a silent retry loop.  The lock fd is close-on-exec so run.cx/run-batch cannot inherit
 * it.  Rollback removes exactly this call's two line contents and leaves every other line alone.
 *
 * UNISACC_TABLES names the table directory (default tests): the two tables, their lock, and the tables that
 * tests/run.cx --list and tests/run-batch.cx read all move together.  A check that registers fixtures points
 * it at a private copy, so its fixture rows never meet another lane's writes (the byte-for-byte restore
 * assertions of tools/check-register.cx cannot hold while a third party appends in the same window).
 *
 * The root it runs in (the current directory) must hold ./unisacc.com: --list and run-batch are started
 * through it.  A root without it used to end in a bare ROLLED_BACK rc=1 with no reason; it is checked before
 * the lock and before anything is written, named on stderr with the command that fixes it, exit 2.
 * Nothing is created under out/ (project owner 2026-11-13): the prepared runner cache is
 * sy_tmpdir()/unisacc-register-native and the trial run directory sy_tmpdir()/register-ID-PID; an out/
 * directory is neither required nor made. */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.posix
#pragma unisa use sys.time
#pragma unisa use sys.env
#pragma unisa use sys.sha
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use text.fmt
#pragma unisa use mem.heap
#pragma unisa use cxlib.runnerprep

static void rg_die(const char *a, const char *b) { fprintf(stderr, "register: %s%s%s\n", a, b ? ": " : "", b ? b : ""); exit(2); }

/* the registry lock: exclusive flock on tests/.register.lock, waited for at most REGISTER_LOCK_MS
   (default 45000, also the maximum: a longer wait means the holder is not making progress and the
   caller should be told so by name).  Returns the held fd; releases are just sy_flock(UN)+close. */
/* The two tables live in tests/ unless UNISACC_TABLES names another directory.  A check that registers
   fixtures then works on a private copy instead of racing every other registration lane on the real
   files (the byte-for-byte restore assertions cannot hold while someone else appends). */
static const char *rg_tdir(void) { const char *e = getenv("UNISACC_TABLES"); return e && *e ? e : "tests"; }
static const char *rg_bpath(void) { static char p[4400]; if (tx_snprintf(p, sizeof p, "%s/batches.tsv", rg_tdir()) >= (int)sizeof p) rg_die("path bound", "batches.tsv"); return p; }
static const char *rg_cpath(void) { static char p[4400]; if (tx_snprintf(p, sizeof p, "%s/coverage.tsv", rg_tdir()) >= (int)sizeof p) rg_die("path bound", "coverage.tsv"); return p; }
static const char *rg_lockpath(void) { static char p[4400]; if (tx_snprintf(p, sizeof p, "%s/.register.lock", rg_tdir()) >= (int)sizeof p) rg_die("path bound", "lock"); return p; }
static long rg_lock_ms(void) {
    const char *e = getenv("REGISTER_LOCK_MS"); long v = e ? atol(e) : 45000;
    return v < 100 ? 100 : v > 45000 ? 45000 : v;
}
/* One bounded attempt at the exclusive lock: the held fd, or -1 when the wait ran out.  Anything but
   "held by someone else" and EINTR is fatal by name. */
static int rg_try_lock(long ms) {
    long waited = 0; int fd = sy_open(rg_lockpath(), O_RDWR | O_CREAT, 0666), r;
    if (fd < 0) rg_die("cannot open lock", rg_lockpath());
    if (fcntl(fd, F_SETFD, FD_CLOEXEC) != 0) { sy_close(fd); rg_die("cannot mark lock close-on-exec", rg_lockpath()); }
    for (;;) {
        r = sy_flock(fd, 2 | 4);   /* exclusive, do not wait */
        if (r == 0) return fd;
        if (r != -EWOULDBLOCK && r != -EINTR) { sy_close(fd); rg_die("cannot flock", rg_lockpath()); }
        if (waited >= ms) { sy_close(fd); return -1; }
        sy_sleep_ms(50); waited += 50;
    }
}
static void rg_pending(void);
static int rg_lock(void) {
    long ms = rg_lock_ms(); int fd = rg_try_lock(ms);
    if (fd < 0) { fprintf(stderr, "register: lock timeout: %s held longer than %ld ms\n", rg_lockpath(), ms); exit(2); }
    rg_pending();
    return fd;
}
/* The rollback's wait is its own and longer, and it retries: a refusal must end either with the two rows
   gone or with a named dirty table, never with a bare lock timeout (the rows are then still in the registry
   and every later run sees them).  REGISTER_ROLLBACK_LOCK_MS overrides it for tests. */
static long rg_rollback_ms(void) {
    const char *e = getenv("REGISTER_ROLLBACK_LOCK_MS"); long v = e ? atol(e) : 20000;
    return v < 100 ? 100 : v > 120000 ? 120000 : v;
}
static int rg_lock_rollback(void) {
    int fd = -1, attempt;
    for (attempt = 0; attempt < 3; attempt++) { fd = rg_try_lock(rg_rollback_ms()); if (fd >= 0) break; }
    if(fd>=0)rg_pending();
    return fd;
}

/* 1-based line number of the line equal to LINE (which ends in \n) in PATH, 0 when it is not there */
static long line_of(const char *path, const char *line) {
    size_t n; char *b = cx_read(path, &n); long at = 0, ll = tx_len(line, 1 << 16), no = 0;
    if (!b) return 0;
    while (at < (long)n) {
        long e = tx_chr(b + at, (long)n - at, '\n'), ln = e < 0 ? (long)n - at : e + 1;
        no++;
        if (ln == ll && tx_same(b + at, ln, line, ll)) { free(b); return no; }
        at += ln;
    }
    free(b);
    return 0;
}
static void rg_unlock(int fd) { if (fd >= 0) { sy_flock(fd, 8); sy_close(fd); } }

/* tp_expect in tools/cxlib/testplan.cx accepts "rc0:" followed by [A-Z0-9_]+ only, and tests/run-batch.cx
   validates the WHOLE registry through tp_visit: one malformed expect makes every batch refuse (2026-11-02:
   one uncommitted row "rc0:rc0:ROOT_IDENTITY" blocked 27 census rows).  register.cx writes that field as
   "rc0:" + MARKER, so a MARKER that is already an expect would become a double prefix; refuse it by name
   before anything is written. */
static int rg_marker_ok(const char *m) {
    if (!*m) return 0;
    for (; *m; m++) if (!((*m >= 'A' && *m <= 'Z') || (*m >= '0' && *m <= '9') || *m == '_')) return 0;
    return 1;
}
/* The two untracked things a root needs before a registration can be tried; every missing one is named
   with its fix.  0 when the root is usable. */
static int rg_root_missing(void) {
    int bad = 0;
    if (sy_exists("unisacc.com") != 1) {
        fprintf(stderr, "register: REFUSE no ./unisacc.com in this root: the registry listing and the trial batch run are started as `sh ./unisacc.com ...` (a private clone does not carry it); fix: cp SHARED_ROOT/unisacc.com SHARED_ROOT/unisacc.com.build.json .\n");
        bad++;
    }
    /* no out/ requirement any more (project owner 2026-11-13: nothing may be created under out/ in the
       checkout): the runner cache and the trial run directory live under sy_tmpdir() */
    return bad;
}

/* Check the generated fourteen-column row before append: expect is rc0:MARKER,
   followed by the headers contract and commit (or platform release) tier. */
static int rg_row_ok(const char *row, const char *marker) {
    int fields = 0; size_t ml = tx_len(marker, 512); const char *at = row, *expect = 0, *headers = 0, *tier = 0;
    for (; *at; at++) if (*at == '\t') { fields++; if(fields==11)expect=at+1;if(fields==12)headers=at+1;if(fields==13)tier=at+1; }
    if(fields!=13||!expect||!headers||!tier||strncmp(expect,"rc0:",4)||(size_t)(headers-expect)!=ml+5||memcmp(expect+4,marker,ml))return 0;
    if(!((tier-headers==8&&!memcmp(headers,"product\t",8))||(tier-headers==5&&!memcmp(headers,"tree\t",5))))return 0;
    return tx_eqz(tier,"commit\n")||tx_eqz(tier,"release\n");
}

static int clean(const char *s) { for (; *s; s++) if (*s == '\t' || *s == '\n' || *s == '\r') return 0; return 1; }
/* P9 登记贴线告警(只告警,不拦): 读 tests/run-batch.cx 追加的实测耗时表(UNISACC_BATCH_TIMES 或
   $HOME/.cache/unisacc/batch-times.tsv),该批已有实测最大值超过 45000 毫秒时打一行具名 WARN.
   判据与文案同 tools/batch-timing.cx max;表只是观测,不改登记结果与退出码。 */
#define RG_WARN_MS 45000
static void rg_timing_warn(const char *id) {
    const char *bt = sy_env("UNISACC_BATCH_TIMES"), *home = sy_env("HOME"); char tp[4400]; size_t n = 0; char *s; long at = 0, best = -1, idn = tx_len(id, 512);
    if (bt && *bt) { if (tx_eqz(bt, "off") || cx_fmt(tp, sizeof tp, "%s", bt)) return; }
    else if (!home || !*home || cx_fmt(tp, sizeof tp, "%s/.cache/unisacc/batch-times.tsv", home)) return;
    s = cx_read(tp, &n);
    if (!s) return;
    while (at < (long)n) {
        long e = at, ioff, ilen, toff, tlen, v = 0, i; int d = 0;
        while (e < (long)n && s[e] != '\n') e++;
        if (e > at && s[at] != '#' && !tx_field(s + at, e - at, '\t', 1, &ioff, &ilen) && !tx_field(s + at, e - at, '\t', 3, &toff, &tlen) &&
            ilen == idn && mm_same(s + at + ioff, id, idn)) {
            for (i = 0; i < tlen && s[at + toff + i] >= '0' && s[at + toff + i] <= '9'; i++) { v = v * 10 + (s[at + toff + i] - '0'); d = 1; }
            if (d && i == tlen && v > best) best = v;
        }
        at = e + 1;
    }
    mm_free(s);
    if (best > RG_WARN_MS) printf("REGISTER\tid=%s\tWARN=near-limit\tmax_ms=%ld\tthreshold_ms=%d\thint=tools/batch-timing.cx split %s\n", id, best, RG_WARN_MS, id);
}

/* 1 when a line of the file starts with KEY followed by a TAB */
static int has_key(const char *path, const char *key) {
    size_t n; char *b = cx_read(path, &n); long at = 0, kl = tx_len(key, 256);
    if (!b) rg_die("cannot read", path);
    while (at < (long)n) {
        long e = tx_chr(b + at, (long)n - at, '\n'), ln = e < 0 ? (long)n - at : e;
        if (ln > kl && tx_prefix(b + at, ln, key, kl) && b[at + kl] == '\t') return 1;
        at += ln + 1;
    }
    return 0;
}

static int append(const char *path, const char *line) {
    int fd = sy_open(path, O_WRONLY | O_APPEND, 0), bad;
    if (fd < 0) return 1;
    bad = sy_write_all(fd, line, tx_len(line, 1 << 16)) != 0;
    return sy_close(fd) != 0 || bad;
}

/* rewrite PATH without the one line equal to LINE (which ends in \n); 0 when it was found and removed */
static int take_out(const char *path, const char *line) {
    size_t n; char *b = cx_read(path, &n); long at = 0, ll = tx_len(line, 1 << 16);
    if (!b) return 1;
    while (at < (long)n) {
        long e = tx_chr(b + at, (long)n - at, '\n'), ln = e < 0 ? (long)n - at : e + 1;
        if (ln == ll && tx_same(b + at, ln, line, ll)) {
            int fd = sy_open(path, O_WRONLY | O_TRUNC, 0), bad;
            if (fd < 0) return 1;
            bad = sy_write_all(fd, b, at) != 0 || sy_write_all(fd, b + at + ln, (long)n - at - ln) != 0;
            return sy_close(fd) != 0 || bad;
        }
        at += ln;
    }
    return 1;
}

/* run ARGV, the LAST cap-1 bytes of stdout+stderr into OUT (terminated): the summaries come last; exit code or -1.
   Every child is started under ./tools/bound SECONDS (argv[0], argv[1]): that is its time bound, and an argv
   without it is not run. */
/* run_start spawns (the bound rule as in run), run_collect drains and reaps: between them the caller may
   do independent work while the child runs (the batch-packages runner prepare overlaps the trial run). */
static int run_start(char **argv, int *ofd) {
    if (!argv[0] || !tx_eqz(argv[0], "./tools/bound") || !argv[1]) return -1;
    return sy_spawn_pipe(argv, 0, 0, ofd, 0);
}
static int run_collect(int pid, int ofd, char *out, long cap) {
    int ex = 0, code = 0, sig = 0; long n = 0, r, k, half = (cap - 1) / 2;
    out[0] = 0;
    if (pid < 0) return -1;
    for (;;) {
        if (n == cap - 1) { for (k = 0; k < n - half; k++) out[k] = out[k + half]; n -= half; }
        r = sy_read(ofd, out + n, cap - 1 - n);
        if (r <= 0) break;
        n += r;
    }
    out[n] = 0;
    sy_close(ofd);
    if (sy_wait_status(pid, 0, &ex, &code, &sig) != pid || !ex) return -1;
    return code;
}
static int run(char **argv, char *out, long cap) {
    int ofd, pid, ex = 0, code = 0, sig = 0; long n = 0, r, k, half = (cap - 1) / 2;
    out[0] = 0;
    if (!argv[0] || !tx_eqz(argv[0], "./tools/bound") || !argv[1]) return -1;
    pid = sy_spawn_pipe(argv, 0, 0, &ofd, 0);
    if (pid < 0) return -1;
    for (;;) {
        if (n == cap - 1) { for (k = 0; k < n - half; k++) out[k] = out[k + half]; n -= half; }
        r = sy_read(ofd, out + n, cap - 1 - n);
        if (r <= 0) break;
        n += r;
    }
    out[n] = 0;
    sy_close(ofd);
    if (sy_wait_status(pid, 0, &ex, &code, &sig) != pid || !ex) return -1;
    return code;
}

/* ---- --tool mode: one command for the inventory side of "a new tools/NAME.cx" ----
 *
 *   sh ./unisacc.com tools/register.cx -- --tool tools/NAME.cx [--tool tools/OTHER.cx ...] [--pin-owner OWNER]
 *
 * (a) inserts "tools/NAME.cx<TAB>regular" (symlink for a symlink) into tests/tools-compile-sources.tsv at its
 *     C byte order place (unsigned byte compare, the order of LC_ALL=C sort and of the git index);
 * (b) makes the tools-compile-NNN rows of batches.tsv exactly 000..ceil(rows/8)-1: missing rows are added
 *     after the last existing shard row, rows past the range are taken out;
 * (c) every 64-hex literal of the tool that has no tools/pins.tsv row is printed as PIN_NEEDED with the row
 *     to add; with --pin-owner OWNER the row "FILE#HEX literal - HEX OWNER ok" is appended instead;
 * (d) git add of each tool that is not tracked yet (a tracked file is left alone: its staging is the caller's).
 * Then tests/tools-compile.cx --shards . must print the computed count.  Everything is validated before the
 * first write. A failed verification reverses this call's additions and removals by key against the
 * latest table and unstages the files this call staged (git rm --cached), exit 1 with the
 * step named.  A second identical call changes nothing and ends status=UNCHANGED.  Nothing is compiled and
 * no PASS is recorded here: the shard batches themselves still have to be run. */
#define RG_TOOLS_MAX 64
#define RG_SOURCES "tests/tools-compile-sources.tsv"
#define RG_PINS "tools/pins.tsv"
static int rg_bcmp(const char *a, long al, const char *b, long bl) {
    long i, m = al < bl ? al : bl;
    for (i = 0; i < m; i++) if ((unsigned char)a[i] != (unsigned char)b[i]) return (unsigned char)a[i] < (unsigned char)b[i] ? -1 : 1;
    return al < bl ? -1 : al > bl;
}
static int rg_ishex(char c) { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'); }
/* shard index of a "tools-compile-NNN<TAB>" line, -1 for any other line */
static long rg_shard_of(const char *l, long ln) {
    long i = 14, v = 0;
    if (ln < 16 || memcmp(l, "tools-compile-", 14)) return -1;
    while (i < ln && l[i] >= '0' && l[i] <= '9' && v < 100000) v = v * 10 + (l[i++] - '0');
    return i > 14 && i < ln && l[i] == '\t' ? v : -1;
}
/* 1 when pins.tsv (PB, PN) has a row for TOOL (path "TOOL#..." or "TOOL:...") whose value field is HEX */
static int rg_pin_has(const char *pb, long pn, const char *tool, const char *hex) {
    long at = 0, tl = (long)strlen(tool);
    while (at < pn) {
        long e = at, f = 0, k;
        while (e < pn && pb[e] != '\n') e++;
        if (e - at > tl && !memcmp(pb + at, tool, (size_t)tl) && (pb[at + tl] == '#' || pb[at + tl] == ':'))
            for (k = at; k < e; k++) if (pb[k] == '\t' && ++f == 3) { if (e - k - 1 >= 65 && !memcmp(pb + k + 1, hex, 64) && pb[k + 65] == '\t') return 1; break; }
        at = e + 1;
    }
    return 0;
}
/* These three tool tables have their primary key in the first TSV column.
   Inverse changes are applied to the current file, preserving intervening
   edits. Deleted rows return immediately before their next surviving anchor. */
typedef struct {const char *p; long n,key;} RegRow;
static RegRow *rg_rows(const char *p,size_t n,int *count){
    int rows=0;for(size_t i=0;i<n;i++)if(p[i]=='\n')rows++;
    RegRow *r=calloc(rows+2,sizeof *r);if(!r)rg_die("allocation",0);
    *count=0;
    for(size_t i=0;i<n;){
        size_t end=i,key=i;
        while(end<n && p[end]!='\n')end++;
        while(key<end && p[key]!='\t')key++;
        if(end<n)end++;
        r[*count].p=p+i;r[*count].n=end-i;r[*count].key=key-i;
        (*count)++;i=end;
    }
    return r;
}
static int rg_find_row(RegRow *r,int n,const RegRow *row){
    for(int i=0;i<n;i++)if(r[i].key==row->key && !memcmp(r[i].p,row->p,row->key))return i;
    return -1;
}
/* A pending transaction records before/after bytes. Recovery modifies only
   keys owned by that change. Product input declarations use (kind,key). */
static RegRow *rg_transaction_rows(const char *bytes,size_t size,int declarations,int *count){
    RegRow *rows=rg_rows(bytes,size,count);
    if(declarations)for(int i=0;i<*count;i++){
        RegRow *r=&rows[i];
        if(r->n && r->p[0]!='#' && r->key<r->n && r->p[r->key]=='\t'){
            r->key++;
            while(r->key<r->n && r->p[r->key]!='\t' && r->p[r->key]!='\n')r->key++;
        }
    }
    return rows;
}
static int rg_same_row(const RegRow *a,const RegRow *b){
    return (!a || !b) ? a==b : a->n==b->n && !memcmp(a->p,b->p,a->n);
}
static int rg_unique_row(RegRow *rows,int n,const RegRow *key,const RegRow **value){
    *value=0;
    for(int i=0;i<n;i++)if(rows[i].key==key->key && !memcmp(rows[i].p,key->p,key->key)){
        if(*value)return -1;
        *value=&rows[i];
    }
    return 0;
}
/* Produce the result in memory for all four tables before any recovery
   rename. Encountering a third value is a conflict, even for a removal. */
static char *rg_recovery_image(const char *path,int declarations,
        const char *before,size_t bn,const char *after,size_t an,
        const char *current,size_t cn,size_t *outn){
    int nb,na,nc;
    RegRow *old=rg_transaction_rows(before,bn,declarations,&nb);
    RegRow *published=rg_transaction_rows(after,an,declarations,&na);
    RegRow *now=rg_transaction_rows(current,cn,declarations,&nc);
    const RegRow **replace=calloc(nc+1,sizeof *replace);
    int *remove=calloc(nc+1,sizeof *remove),*insert=malloc((nb+1)*sizeof *insert);
    char *out=malloc(cn+bn+1);
    if(!out || !replace || !remove || !insert)rg_die("recovery allocation",path);
    const RegRow *key=0;
    int anchor=nc;
    for(int i=nb-1;i>=0;i--){
        const RegRow *orig=&old[i],*post=0,*live=0;
        int pos=rg_find_row(now,nc,orig);
        insert[i]=-1;
        if(pos>=0)anchor=pos;
        int w=rg_find_row(published,na,orig);
        if(w>=0 && rg_same_row(orig,&published[w]))continue;
        key=orig;
        if(rg_unique_row(published,na,orig,&post) || rg_unique_row(now,nc,orig,&live) ||
           (!rg_same_row(live,orig) && !rg_same_row(live,post)))goto conflict;
        if(!live)insert[i]=anchor;
        else replace[pos]=orig;
    }
    /* Rows removed at the tail belong after the last surviving original
       row, before any independent rows appended during the interruption. */
    int previous=-1;
    for(int i=0;i<nb;i++){
        if(insert[i]==nc)insert[i]=previous+1;
        else if(insert[i]<0){int pos=rg_find_row(now,nc,&old[i]);if(pos>=0)previous=pos;}
    }
    for(int i=0;i<na;i++){
        const RegRow *post=&published[i],*live=0;
        if(rg_find_row(old,nb,post)>=0)continue;
        key=post;
        if(rg_unique_row(now,nc,post,&live) || (live && !rg_same_row(live,post)))goto conflict;
        if(live)remove[live-now]=1;
    }
    *outn=0;
    for(int i=0;i<=nc;i++){
        for(int j=0;j<nb;j++)if(insert[j]==i){
            if(mm_copy(out+*outn,cn+bn-*outn,old[j].p,old[j].n))rg_die("rollback copy bound",path);*outn+=old[j].n;
        }
        if(i<nc && !remove[i]){
            const RegRow *keep=replace[i]?replace[i]:&now[i];
            if(mm_copy(out+*outn,cn+bn-*outn,keep->p,keep->n))rg_die("rollback copy bound",path);*outn+=keep->n;
        }
    }
    out[*outn]=0;
    goto finish;
conflict:
    fprintf(stderr,"register: REFUSE recovery-key-conflict %s key=%.*s\n",path,(int)key->key,key->p);
    free(out);out=0;
finish:
    free(insert);free(remove);free(replace);free(now);free(published);free(old);
    return out;
}
static int rg_inverse_once(const char *path,const char *before,size_t bn,const char *written,size_t wn){
    size_t cn;char *cur=cx_read(path,&cn);
    if(!cur)return 1;
    int na,nb,nc;
    RegRow *original=rg_rows(before,bn,&na),*ours=rg_rows(written,wn,&nb),*now=rg_rows(cur,cn,&nc);
    char *result=malloc(cn+bn+1);if(!result)rg_die("allocation",0);
    int *anchor=calloc(na+1,sizeof *anchor);if(!anchor)rg_die("allocation",0);
    int next=nc;
    for(int i=na-1;i>=0;i--){
        int pos=rg_find_row(now,nc,&original[i]);anchor[i]=-1;
        if(pos>=0)next=pos;
        else if(rg_find_row(ours,nb,&original[i])<0)anchor[i]=next;
    }
    int previous=-1;
    for(int i=0;i<na;i++){
        if(anchor[i]==nc)anchor[i]=previous+1;
        else if(anchor[i]<0){int pos=rg_find_row(now,nc,&original[i]);if(pos>=0)previous=pos;}
    }
    size_t used=0;
    for(int j=0;j<=nc;j++){
        for(int i=0;i<na;i++)if(anchor[i]==j){
            if(mm_copy(result+used,cn+bn+1-used,original[i].p,original[i].n))rg_die("rollback bound",path);
            used+=original[i].n;
        }
        if(j==nc)break;
        int w=rg_find_row(ours,nb,&now[j]);
        if(w>=0 && ours[w].n==now[j].n && !memcmp(ours[w].p,now[j].p,now[j].n) && rg_find_row(original,na,&now[j])<0)continue;
        if(mm_copy(result+used,cn+bn+1-used,now[j].p,now[j].n))rg_die("rollback bound",path);
        used+=now[j].n;
    }
    size_t vn;char *verified=cx_read(path,&vn);
    int err=!verified?1:vn!=cn||memcmp(verified,cur,cn)?4:
        used==cn&&!memcmp(result,cur,cn)?0:!!sy_write_atomic(path,result,used,0644);
    free(verified);free(anchor);free(result);free(now);free(ours);free(original);free(cur);return err;
}
static int rg_tool_restore(const char *path,const char *before,size_t bn,const char *written,size_t wn,int changed){
    if(!changed)return 0;
    for(int trial=0;trial<3;trial++){
        int rc=rg_inverse_once(path,before,bn,written,wn);
        if(rc!=4)return rc;
    }
    fprintf(stderr,"register: REFUSE rollback-input-changed-three-times %s\n",path);
    return 1;
}
static int rg_snapshot(const char *path,char hex[65]){
    sy_stat_t st;int rc=sy_lstat(path,&st);
    if(rc==-ENOENT){hex[0]=0;return 0;}
    if(rc || st.kind!='f')return 1;
    size_t n;char *b=cx_read(path,&n);if(!b)return 1;
    int failed=sy_sha256_hex(b,n,hex);free(b);return failed;
}
static int rg_plan_delta(const char *path,const char *before,size_t bn,const char *after,size_t an){
    int oldn,newn,changes=0;
    RegRow *old=rg_rows(before,bn,&oldn),*next=rg_rows(after,an,&newn);
    for(int i=0;i<oldn;i++){
        int j=rg_find_row(next,newn,&old[i]);
        if(j<0 || old[i].n!=next[j].n || memcmp(old[i].p,next[j].p,old[i].n)){
            printf("REGISTER_SYNC_KEY\t%s\t%s\t%.*s\n",path,j<0?"remove":"change",(int)old[i].key,old[i].p);
            changes++;
        }
    }
    for(int i=0;i<newn;i++)if(rg_find_row(old,oldn,&next[i])<0){
        printf("REGISTER_SYNC_KEY\t%s\tadd\t%.*s\n",path,(int)next[i].key,next[i].p);changes++;
    }
    free(old);free(next);
    printf("REGISTER_SYNC_TABLE\t%s\tchanged_keys=%d\n",path,changes);
    return changes;
}
typedef struct {char path[4400],*before,*after,*cur,*undo;size_t bn,an,cn,un;} RgTable;
static const char *rg_names[]={"tools-compile-sources.tsv","batches.tsv","coverage.tsv","batch-product-inputs.tsv"};
static char journal[4400];
static void rg_report_retired(void){
    DIR *d=opendir(rg_tdir());if(!d)return;
    struct dirent *entry;
    while((entry=readdir(d)))if(!strncmp(entry->d_name,".register-clean-",16))
        fprintf(stderr,"REGISTER_SYNC RETIRED_CLEANUP_PENDING %s/%s\n",rg_tdir(),entry->d_name);
    closedir(d);
}
static void rg_pending(void){
    rg_report_retired();
    if(cx_fmt(journal,sizeof journal,"%s/.register-txn",rg_tdir()))rg_die("transaction path",0);
    sy_stat_t st;int r=sy_lstat(journal,&st);
    if(r!=-ENOENT)rg_die(r || st.kind!='d'?"transaction-path-invalid":"RECOVERY_REQUIRED",journal);
}
static void rg_file(char *p,size_t cap,const char *dir,const char *name){
    if(cx_fmt(p,cap,"%s/%s",dir,name))rg_die("transaction path",dir);
}
static char *rg_read_regular(const char *p,size_t *n){
    sy_stat_t st;if(sy_lstat(p,&st) || st.kind!='f')rg_die("transaction-file-invalid",p);
    char *b=cx_read(p,n);if(!b)rg_die("transaction-read",p);return b;
}
/* Only the decimal shard number crosses the journal boundary. */
typedef struct {int shard,mode;char *before,*after;size_t bn,an;} RgManifest;
static int rg_manifest_dir(char *dir,size_t cap){
    rg_file(dir,cap,rg_tdir(),"manifests");
    sy_stat_t st;int rc=sy_lstat(dir,&st);
    if(rc==-ENOENT)return 0;
    if(rc||st.kind!='d')rg_die("manifest-directory-invalid",dir);
    return 1;
}
static void rg_manifest_path(int shard,char *path,size_t cap){
    char dir[4400];rg_manifest_dir(dir,sizeof dir);
    if(shard<0 || shard>=100000 || cx_fmt(path,cap,"%s/tools-compile-%03d.tsv",dir,shard))rg_die("manifest-path-invalid",dir);
}
static int rg_manifest_state(RgManifest *m,int apply,int rollback){
    char path[4600],now[65],before[65]="",after[65]="";rg_manifest_path(m->shard,path,sizeof path);
    if(rg_snapshot(path,now)||(m->before&&sy_sha256_hex(m->before,m->bn,before))||
       (m->after&&sy_sha256_hex(m->after,m->an,after)))rg_die("manifest-state-invalid",path);
    if(*now){
        sy_stat_t st;if(sy_lstat(path,&st) || st.mode!=m->mode)rg_die("manifest-mode-changed",path);
    }
    if(tx_eqz(now,rollback?before:after))return 0;
    if(!tx_eqz(now,rollback?after:before))rg_die("manifest-input-changed",path);
    char *bytes=rollback?m->before:m->after;
    if(!apply)return 0;
    if(!bytes)return sy_unlink(path);
    char tmp[4500];rg_file(tmp,sizeof tmp,journal,"table.tmp");
    return sy_write_atomic(tmp,bytes,rollback?m->bn:m->an,0600)||sy_chmod(tmp,m->mode)||sy_rename(tmp,path);
}
static char *rg_manifest_bytes(RgManifest *m,int count,size_t *n){
    size_t cap=1;
    for(int i=0;i<count;i++)cap+=80+m[i].bn+m[i].an;
    char *b=malloc(cap);if(!b)rg_die("allocation",0);
    *n=0;
    for(int i=0;i<count;i++){
        if(cx_fmt(b+*n,cap-*n,"%d %d %ld %ld\n",m[i].shard,m[i].mode,m[i].before?(long)m[i].bn:-1L,m[i].after?(long)m[i].an:-1L))rg_die("manifest-record-bound",0);
        *n+=strlen(b+*n);
        if(m[i].bn && mm_copy(b+*n,cap-*n,m[i].before,m[i].bn))rg_die("manifest-record-bound",0);
        *n+=m[i].bn;
        if(m[i].an && mm_copy(b+*n,cap-*n,m[i].after,m[i].an))rg_die("manifest-record-bound",0);
        *n+=m[i].an;
    }
    return b;
}
static RgManifest *rg_manifest_decode(char *b,size_t n,int *count){
    int cap=8;RgManifest *m=calloc(cap,sizeof *m);if(!m)rg_die("allocation",0);
    *count=0;
    for(size_t at=0;at<n;){
        char header[80];int shard,mode;long bn,an;
        if(sscanf(b+at,"%d %d %ld %ld",&shard,&mode,&bn,&an)!=4 || shard<0 || shard>=100000 || mode<0 || mode>0777 || bn< -1 || an< -1 ||
           (bn<0)==(an<0) || cx_fmt(header,sizeof header,"%d %d %ld %ld\n",shard,mode,bn,an) ||
           strlen(header)>n-at || memcmp(header,b+at,strlen(header)))rg_die("manifest-journal-invalid",0);
        at+=strlen(header);
        if((size_t)(bn<0?an:bn)>n-at || (*count && shard<=m[*count-1].shard))rg_die("manifest-journal-invalid",0);
        if(*count==cap){cap*=2;m=realloc(m,cap*sizeof *m);if(!m)rg_die("allocation",0);}
        RgManifest *r=m+*count;*count+=1;r->shard=shard;r->mode=mode;r->bn=bn<0?0:bn;r->an=an<0?0:an;
        r->before=bn<0?0:b+at;r->after=an<0?0:b+at;at+=r->bn+r->an;
    }
    return m;
}
/* All names in the journal are constants; it cannot supply a write path. */
static void rg_record(RgTable *tables,const char *dir,int reading,RgManifest **manifests,int *count,int *create_dir){
    char record[4096]="REGISTER_TXN\t1\n",p[4500],name[128],digest[65],seal[128];size_t used=strlen(record),n;
    rg_file(p,sizeof p,dir,"record.tsv");
    char *saved=reading?rg_read_regular(p,&n):0;
    int v2=reading?(n>=used && !memcmp(saved,"REGISTER_TXN\t2\n",used)):1;
    if(v2)record[used-2]='2';
    else if(reading){
        sy_stat_t st;rg_file(p,sizeof p,dir,"manifests.bin");
        if(sy_lstat(p,&st)!=-ENOENT)rg_die("transaction-digest-mismatch",p);
    }
    for(int i=0;i<4;i++){
        RgTable *t=tables+i;rg_file(t->path,sizeof t->path,rg_tdir(),rg_names[i]);
        for(int j=0;j<2;j++){
            char **bytes=j?&t->after:&t->before;size_t *length=j?&t->an:&t->bn;
            if(cx_fmt(name,sizeof name,"%s.%s",rg_names[i],j?"after":"before"))rg_die("transaction name",0);
            rg_file(p,sizeof p,dir,name);
            if(reading)*bytes=rg_read_regular(p,length);
            else if(sy_write_atomic(p,*bytes,*length,0600))rg_die("transaction-stage",p);
            if(sy_sha256_hex(*bytes,*length,digest) || cx_fmt(record+used,sizeof record-used,"%s\t%s\n",name,digest))rg_die("transaction digest",p);
            used=strlen(record);
        }
    }
    size_t mn=0;char *payload=0;
    if(v2){
        rg_file(p,sizeof p,dir,"manifests.bin");
        payload=reading?rg_read_regular(p,&mn):rg_manifest_bytes(*manifests,*count,&mn);
        if(reading)*create_dir=n>used+6 && !memcmp(saved+used,"mkdir=1",7);
        if((!reading && sy_write_atomic(p,payload,mn,0600))||sy_sha256_hex(payload,mn,digest)||
           cx_fmt(record+used,sizeof record-used,"mkdir=%d\nmanifests.bin\t%s\n",*create_dir,digest))rg_die("manifest-record",p);
        used=strlen(record);
    }
    if(sy_sha256_hex(record,used,digest) || cx_fmt(seal,sizeof seal,"id\t%s\n",digest) || used+strlen(seal)>=sizeof record)rg_die("transaction seal",dir);
    if(mm_copy(record+used,sizeof record-used,seal,strlen(seal)+1))rg_die("record bound",dir);used+=strlen(seal);
    rg_file(p,sizeof p,dir,"record.tsv");
    if(!reading){if(sy_write_atomic(p,record,used,0600))rg_die("transaction-record-write",p);return;}
    if(n!=used || memcmp(saved,record,n))rg_die("transaction-digest-mismatch",p);
    free(saved);if(v2)*manifests=rg_manifest_decode(payload,mn,count);
}
static void rg_retire(void){
    char trash[4400],dest[4500];
    if(sy_mkdtemp(rg_tdir(),".register-clean-",trash,sizeof trash))rg_die("transaction-cleanup",journal);
    rg_file(dest,sizeof dest,trash,"finished");
    if(sy_rename(journal,dest))rg_die("transaction-finalize",journal);
    char file[4700],leaf[128];
    rg_file(file,sizeof file,dest,"table.tmp");
    int tmp_rc=sy_unlink(file);if(tmp_rc && tmp_rc!=-ENOENT)rg_die("retired-table-cleanup",file);
    for(int i=0;i<4;i++)for(int j=0;j<2;j++){
        if(cx_fmt(leaf,sizeof leaf,"%s.%s",rg_names[i],j?"after":"before"))rg_die("transaction name",dest);
        rg_file(file,sizeof file,dest,leaf);
        if(sy_unlink(file))rg_die("retired-snapshot-cleanup",file);
    }
    rg_file(file,sizeof file,dest,"record.tsv");
    char side[4700];rg_file(side,sizeof side,dest,"manifests.bin");
    tmp_rc=sy_unlink(side);if(tmp_rc && tmp_rc!=-ENOENT)rg_die("retired-manifest-cleanup",side);
    if(sy_unlink(file)||sy_rmdir(dest)||sy_rmdir(trash))rg_die("retired-record-cleanup",dest);
}
/* Preserve the table's access mode even when the caller's umask is 077. */
static int rg_replace_table(const char *path,const char *bytes,size_t size){
    char tmp[4500];struct stat st;
    if(lstat(path,&st)||!S_ISREG(st.st_mode))return 1;
    rg_file(tmp,sizeof tmp,journal,"table.tmp");
    return sy_write_atomic(tmp,bytes,size,0600)||sy_chmod(tmp,st.st_mode&0777)||sy_rename(tmp,path);
}
static void rg_recover(void){
    RgTable t[4]={0};
    fprintf(stderr,"REGISTER_SYNC\tRECOVERY_REQUIRED\t%s\n",journal);
    int count=0,create_dir=0;RgManifest *m=0;rg_record(t,journal,1,&m,&count,&create_dir);
    for(int i=0;i<count;i++)rg_manifest_state(m+i,0,1);
#ifdef REGISTER_TXN_FAULT_TEST
    if(tx_eqz(sy_env_or("REGISTER_RECOVER_STOP",""),"1"))sy_signal(sy_pid(),19);
#endif
    for(int i=0;i<4;i++){
        t[i].cur=rg_read_regular(t[i].path,&t[i].cn);
        t[i].undo=rg_recovery_image(t[i].path,i==3,t[i].before,t[i].bn,t[i].after,t[i].an,t[i].cur,t[i].cn,&t[i].un);
        if(!t[i].undo)rg_die("recovery refused",t[i].path);
    }
    for(int i=0;i<4;i++){
        char now[65],expect[65];
        if(rg_snapshot(t[i].path,now)||sy_sha256_hex(t[i].cur,t[i].cn,expect)||!tx_eqz(now,expect))rg_die("recovery-input-changed",t[i].path);
        if(t[i].cn!=t[i].un || memcmp(t[i].cur,t[i].undo,t[i].un))
            if(rg_replace_table(t[i].path,t[i].undo,t[i].un))rg_die("recovery-write",t[i].path);
    }
    for(int i=0;i<count;i++)if(rg_manifest_state(m+i,1,1))rg_die("manifest-rollback-write",journal);
    char dir[4500];if(create_dir && rg_manifest_dir(dir,sizeof dir)){
        int rc=sy_rmdir(dir);if(rc && rc!=-ENOTEMPTY)rg_die("manifest-directory-rollback",dir);
    }
    rg_retire();puts("REGISTER_SYNC\tRECOVERED\tpolicy=rollback");
}
static int rg_sync_publish(const char *sources,size_t sn,const char *batch,size_t bn,const char *coverage,size_t cn,RgManifest *m,int count,char versions[][65]){
    RgTable t[4]={0};const int order[]={2,0,1,3};int changed=0;
    char tmp[4400],hash[65];
    for(int i=0;i<4;i++){
        rg_file(t[i].path,sizeof t[i].path,rg_tdir(),rg_names[i]);t[i].before=rg_read_regular(t[i].path,&t[i].bn);
        if(sy_sha256_hex(t[i].before,t[i].bn,hash)||!tx_eqz(hash,versions[order[i]]))return 4;
        t[i].after=i==0?(char*)sources:i==1?(char*)batch:i==2?(char*)coverage:t[i].before;
        t[i].an=i==0?sn:i==1?bn:i==2?cn:t[i].bn;
        if(t[i].an!=t[i].bn || memcmp(t[i].before,t[i].after,t[i].an))changed++;
    }
    if(!changed && !count){puts("REGISTER_SYNC\tstatus=UNCHANGED");return 0;}
    if(sy_mkdtemp(rg_tdir(),".register-stage-",tmp,sizeof tmp))rg_die("transaction-stage",rg_tdir());
    char dir[4500];int create_dir=count && !rg_manifest_dir(dir,sizeof dir);
    rg_record(t,tmp,0,&m,&count,&create_dir);
    if(sy_rename(tmp,journal)){cx_rmtree(tmp);rg_die("transaction-activate",journal);}
    if(create_dir && sy_mkdir(dir,0755)){rg_recover();return 4;}
    for(int i=0;i<4;i++){
        if(rg_snapshot(t[i].path,hash) || !tx_eqz(hash,versions[order[i]]) ||
           ((t[i].an!=t[i].bn || memcmp(t[i].before,t[i].after,t[i].an)) && rg_replace_table(t[i].path,t[i].after,t[i].an))){rg_recover();return 4;}
#ifdef REGISTER_TXN_FAULT_TEST
        /* Linux fixture binary only. The parent observes WUNTRACED before it sends SIGKILL. */
        const char *stop=sy_env_or("REGISTER_TXN_STOP","");
        if(stop[0]=='1'+i && !stop[1])sy_signal(sy_pid(),19);
#endif
    }
    for(int i=0;i<count;i++)if(rg_manifest_state(m+i,1,0)){rg_recover();return 4;}
#ifdef REGISTER_TXN_FAULT_TEST
    if(count && tx_eqz(sy_env_or("REGISTER_TXN_STOP",""),"manifest"))sy_signal(sy_pid(),19);
#endif
    rg_retire();printf("REGISTER_SYNC\tstatus=PUBLISHED\tchanged_tables=%d\tchanged_manifests=%d\n",changed,count);return 0;
}
/* Shared-table rows another window is still writing (unstaged rows whose source files are untracked)
   must not decide this layout: a row of the proposed table that is absent from the layout's own base
   copy (index tree or HEAD) and names a repository path missing from the layout is skipped and named.
   Rows present in the base copy are kept verbatim, so a staged or committed row whose source is
   missing still reaches the runner and is refused there (missing-implemented-source). */
static int rg_path_token(const char *s,size_t n){
    static const char *ext[]={".cx",".c",".h",".S",".tsv",".md",".sh",0};
    if(n<4||s[0]=='/'||!memchr(s,'/',n))return 0;
    for(size_t i=0;i+1<n;i++)if(s[i]=='.'&&s[i+1]=='.')return 0;
    for(int e=0;ext[e];e++){size_t el=strlen(ext[e]);if(n>el&&!memcmp(s+n-el,ext[e],el))return 1;}
    return 0;
}
static int rg_line_missing_path(const char *lay,const char *s,size_t n){
    size_t i=0;
    while(i<n){
        while(i<n&&(s[i]=='\t'||s[i]==' '||s[i]==';'))i++;
        size_t b=i;while(i<n&&s[i]!='\t'&&s[i]!=' '&&s[i]!=';')i++;
        if(i>b&&i-b<1024&&rg_path_token(s+b,i-b)){
            char rel[1024],p[5600];sy_stat_t st;
            if(mm_copy(rel,sizeof rel,s+b,i-b))return 0;rel[i-b]=0;
            if(cx_fmt(p,sizeof p,"%s/%s",lay,rel))return 0;
            if(sy_lstat(p,&st)==-ENOENT)return 1;
        }
    }
    return 0;
}
static char *rg_layout_rows(const char *lay,const char *rel,const char *bytes,size_t n,size_t *outn){
    char p[5600];size_t bn=0;char *base=0,*out=malloc(n+1);if(!out)return 0;
    if(!cx_fmt(p,sizeof p,"%s/%s",lay,rel)){sy_stat_t st;if(sy_lstat(p,&st)==0&&st.kind=='f')base=cx_read(p,&bn);}
    size_t used=0,i=0;
    while(i<n){
        size_t b=i;while(i<n&&bytes[i]!='\n')i++;size_t len=i-b;if(i<n)i++;
        int keep=1;
        if(len&&bytes[b]!='#'&&rg_line_missing_path(lay,bytes+b,len)){
            keep=0;
            if(base)for(size_t k=0;k+len<=bn;k++){
                if((k==0||base[k-1]=='\n')&&!memcmp(base+k,bytes+b,len)&&(k+len==bn||base[k+len]=='\n')){keep=1;break;}
            }
            if(!keep){printf("REGISTER_LAYOUT_SKIP\ttable=%s\trow=",rel);fwrite(bytes+b,1,len,stdout);fputc('\n',stdout);}
        }
        if(keep){if(mm_copy(out+used,n+1-used,bytes+b,i-b)){free(base);free(out);return 0;}used+=i-b;}
    }
    free(base);*outn=used;return out;
}
static int rg_layout_table(const char *lay,const char *rel,const char *bytes,size_t n){
    size_t on=0;char p[5600];char *f=rg_layout_rows(lay,rel,bytes,n,&on);int rc=!f||cx_fmt(p,sizeof p,"%s/%s",lay,rel)||sy_write_atomic(p,f,on,0644);
    free(f);return rc;
}
/* A cold layout contains the complete tracked source tree and fresh compiler intermediates. */
static int rg_clean_layout(const char *private_dir){
    char why[600];int rc=unisa_safedel(private_dir,SAFEDEL_PURGE|SAFEDEL_RECURSIVE,100000,why,sizeof why);
    if(rc)fprintf(stderr,"register: cold-layout-cleanup %s: %s\n",private_dir,why);
    return rc;
}
/* Archive the exact index tree that supplied the proposed inventory, then run the real batch
   in its own single-commit repository. Only the batch invocation counts against 33000 ms. */
static int rg_cold_shard(const char *stage,const char *sources,size_t sn,const char *batch,size_t bn,const char *coverage,size_t cn,int shard){
    char lay[4400],tar[4500],idx[4500],envindex[4600],out[4550],p[4600],buf[32768],tree[80],id[64],want[128],ape[4096];
    sy_stat_t st;
    if(sy_mkdtemp(stage,"layout-",lay,sizeof lay))return 2;
    rg_file(tar,sizeof tar,lay,"snapshot.tar");rg_file(idx,sizeof idx,lay,"snapshot.index");
    char *ip[]={"./tools/bound","5","git","rev-parse","--git-path","index",0};
    if(run(ip,buf,sizeof buf)||!strchr(buf,'\n'))return 2;
    *strchr(buf,'\n')=0;if(sy_copy(buf,idx,0600)||cx_fmt(envindex,sizeof envindex,"GIT_INDEX_FILE=%s",idx))return 2;
    char *wt[]={"./tools/bound","15","env",envindex,"git","write-tree",0};
    if(run(wt,tree,sizeof tree)||!strchr(tree,'\n'))return 2;*strchr(tree,'\n')=0;
    char *ar[]={"./tools/bound","55","git","archive","-o",tar,tree,0};
    char *extract[]={"./tools/bound","55","tar","-xf",tar,"-C",lay,0};
    if(run(ar,buf,sizeof buf)||run(extract,buf,sizeof buf)||sy_unlink(tar)||sy_unlink(idx))return 2;
    rg_file(p,sizeof p,lay,"tests");if(sy_lstat(p,&st)||st.kind!='d')return 2;
    for(int i=0;i<4;i++){
        char testdir[4500],live[4500];size_t n;rg_file(testdir,sizeof testdir,lay,"tests");
        char rel[64];rg_file(live,sizeof live,rg_tdir(),rg_names[i]);
        if(cx_fmt(rel,sizeof rel,"tests/%s",rg_names[i]))return 2;
        char *extra=i==3?rg_read_regular(live,&n):0;
        int rc=rg_layout_table(lay,rel,i==0?sources:i==1?batch:i==2?coverage:extra,i==0?sn:i==1?bn:i==2?cn:n);free(extra);if(rc)return 2;
    }
    char db[4500],dbarg[4600],gitlink[4500];rg_file(db,sizeof db,stage,"cold-git-objects");
    if(cx_fmt(dbarg,sizeof dbarg,"--separate-git-dir=%s",db))return 2;
    char *init[]={"./tools/bound","15","env","-u","GIT_DIR","-u","GIT_WORK_TREE","-u","GIT_INDEX_FILE","git","-C",lay,"init","-q",dbarg,0};
    char *add[]={"./tools/bound","55","env","-u","GIT_DIR","-u","GIT_WORK_TREE","-u","GIT_INDEX_FILE","git","-C",lay,"add","-Af","--",".",":(exclude)unisacc.com",0};
    char *commit[]={"./tools/bound","55","env","-u","GIT_DIR","-u","GIT_WORK_TREE","-u","GIT_INDEX_FILE","git","-C",lay,"-c","user.name=register","-c","user.email=register@localhost","-c","commit.gpgsign=false","commit","-qm","register cold layout",0};
    rg_file(p,sizeof p,lay,"unisacc.com");if(!realpath("./unisacc.com",ape)||sy_lstat(p,&st)!=-ENOENT||sy_copy(ape,p,0755))return 2;
    rg_file(p,sizeof p,lay,"out");if(sy_mkdir(p,0700))return 2;rg_file(out,sizeof out,p,"trial");if(sy_mkdir(out,0700))return 2;
    if(cx_fmt(id,sizeof id,"tools-compile-%03d",shard)||cx_fmt(want,sizeof want,"BATCH_RUN\tid=%s\tstatus=PASS\t",id))return 2;
    char temp[4600],privtmp[4500];rg_file(privtmp,sizeof privtmp,lay,"out/cold-tmp");
    if(sy_mkdir(privtmp,0700)||cx_fmt(temp,sizeof temp,"TMPDIR=%s",privtmp))return 2;
    /* The runner is test infrastructure, not the shard under test: build it from this layout's own
       sources before the clock (cxlib.runnerprep, reused only when the layout's use-closure identity and
       the image sha both match), so 33000 ms measures the batch, not a cold compile of tests/run-batch.cx
       (measured 19-25 s of the old 37-47 s wall). The batch itself still runs with run/unit caches off. */
    char rcache[4500],rbin[4400],rwhy[512];int rreused=0;
    if(cx_fmt(rcache,sizeof rcache,"%s/unisacc-register-native",sy_tmpdir()))return 2;
    if(sy_mkdir(rcache,0700) && sy_exists(rcache)!=1)return 2;
    char *trial[]={"./tools/bound","55","env","-C",lay,"-u","GIT_DIR","-u","GIT_WORK_TREE","-u","GIT_INDEX_FILE","-u","UNISACC_TABLES",temp,"UNISACC_BATCH_TIMES=off","UNISACC_RUN_CACHE=0","UNISACC_UNIT_CACHE=0",rbin,lay,out,id,0};
    rg_file(gitlink,sizeof gitlink,lay,".git");
    if(run(init,buf,sizeof buf)||run(add,buf,sizeof buf)||run(commit,buf,sizeof buf)){sy_unlink(gitlink);return 2;}
    if(rn_prepare(lay,"tests/run-batch.cx",rcache,rbin,sizeof rbin,&rreused,rwhy,sizeof rwhy)){
        sy_unlink(gitlink);fprintf(stderr,"REFUSE cold-runner-prepare id=%s %s\n",id,rwhy);return 2;}
    printf("REGISTER_COLD_RUNNER\tid=%s\tsource=tests/run-batch.cx\treused=%d\tuntimed=prep-only\n",id,rreused);
    long start=sy_now_ms();int rc=run(trial,buf,sizeof buf);long elapsed=sy_now_ms()-start;
    if(sy_unlink(gitlink)||rg_clean_layout(db))return 2;
    char timing[128];if(cx_fmt(timing,sizeof timing,"BATCH_TIMING\tid=%s\t",id))return 2;
    char *row=strstr(buf,timing),*ms=row?strstr(row,"\trun_ms="):0,*end=row?strchr(row,'\n'):0;
    char value[32]="UNMEASURED";if(ms && end && ms<end){ms+=8;int n=0;while(ms[n]>='0'&&ms[n]<='9'&&n<30)n++;if(n&&ms[n]=='\t'){if(mm_copy(value,sizeof value-1,ms,n))return 2;value[n]=0;}}
    printf("REGISTER_COLD\tid=%s\twall_ms=%ld\trun_ms=%s\trc=%d\n",id,elapsed,value,rc);
    if(elapsed>33000){fprintf(stderr,"REFUSE OVER_33000MS id=%s wall_ms=%ld run_ms=%s\n",id,elapsed,value);return 2;}
    if(rc || !strstr(buf,want) || tx_eqz(value,"UNMEASURED")){fprintf(stderr,"REFUSE cold-batch-receipt id=%s %s\n",id,buf);return 2;}
    return 0;
}
static void rg_mkdirs(const char *dir){
    char tmp[4600]; size_t n=strlen(dir);
    if(n>=sizeof tmp || mm_copy(tmp,sizeof tmp,dir,n+1))return;
    for(size_t i=1;i<n;i++)if(tmp[i]=='/'){tmp[i]=0;sy_mkdir(tmp,0700);tmp[i]='/';}
    sy_mkdir(tmp,0700);
}
/* NEW-BATCH-QUALIFY-LAYOUT-SELFTEST-GATE: run a newly registered batch inside a single-commit
   shallow tree (no git history, no CLAUDE_JOB_DIR, cold run/unit/prep caches) before accepting
   registration. Any failure rolls back the appended rows and emits a named REFUSE reason. */
static int rg_qualify_layout_selftest(const char *root,const char *id,const char *check_src,const char *files,const char *batchbin,int use_dev,const char *devdir){
    char stage[4400],lay[4500],tar[4600],db[4500],dbarg[4600],gitlink[4600],out[4600],p[4600],src_abs[4600],ape[4096];
    char privtmp[4600],coldcache[4600],coldprep[4600],envtmp[4700],envcache[4700],envprep[4700],want[128];
    static char buf[1<<16];
    sy_stat_t st;
    if(sy_mkdtemp(sy_tmpdir(),"unisacc-reg-layout-",stage,sizeof stage))return 2;
    rg_file(lay,sizeof lay,stage,"tree");
    if(sy_mkdir(lay,0700)){rg_clean_layout(stage);return 2;}
    rg_file(tar,sizeof tar,stage,"head.tar");
    {
        char *ar[]={"./tools/bound","55","git","archive","-o",tar,"HEAD",0};
        char *ex[]={"./tools/bound","55","tar","-xf",tar,"-C",lay,0};
        if(run(ar,buf,sizeof buf)||run(ex,buf,sizeof buf)||sy_unlink(tar)){rg_clean_layout(stage);return 2;}
    }
    /* Overlay the new batch source file and declared files (may be untracked/modified in worktree) plus live tables. */
    if(check_src[0]!='/' && cx_fmt(src_abs,sizeof src_abs,"%s/%s",root,check_src)==0 && cx_fmt(p,sizeof p,"%s/%s",lay,check_src)==0){
        char *sl=strrchr(p,'/');
        if(sl){*sl=0;rg_mkdirs(p);*sl='/';}
        sy_unlink(p);
        if(sy_copy(src_abs,p,0644)){rg_clean_layout(stage);return 2;}
    }
    if(files && *files){
        const char *q=files;
        while(*q){
            while(*q==' '||*q=='\t')q++;
            const char *s=q;
            while(*q && *q!=' ' && *q!='\t')q++;
            size_t fl=(size_t)(q-s);
            if(fl>0 && fl<1024 && s[0]!='/' && !(fl>=2 && s[0]=='.' && s[1]=='.')){
                char rel[1024]; if(mm_copy(rel,sizeof rel,s,fl))continue; rel[fl]=0;
                if(cx_fmt(src_abs,sizeof src_abs,"%s/%s",root,rel)==0 && sy_lstat(src_abs,&st)==0 && st.kind=='f' &&
                   cx_fmt(p,sizeof p,"%s/%s",lay,rel)==0){
                    char *sl=strrchr(p,'/');
                    if(sl){*sl=0;rg_mkdirs(p);*sl='/';}
                    sy_unlink(p);
                    if(sy_copy(src_abs,p,0644)){rg_clean_layout(stage);return 2;}
                }
            }
        }
    }
    {
        char dst_b[4600],dst_c[4600];
        if(cx_fmt(dst_b,sizeof dst_b,"%s/tests/batches.tsv",lay)||cx_fmt(dst_c,sizeof dst_c,"%s/tests/coverage.tsv",lay)){rg_clean_layout(stage);return 2;}
        size_t lbn=0,lcn=0;char *lb=cx_read(rg_bpath(),&lbn),*lc=cx_read(rg_cpath(),&lcn);
        int trc=!lb||!lc||rg_layout_table(lay,"tests/batches.tsv",lb,lbn)||rg_layout_table(lay,"tests/coverage.tsv",lc,lcn);
        free(lb);free(lc);(void)dst_b;(void)dst_c;
        if(trc){rg_clean_layout(stage);return 2;}
    }
    rg_file(p,sizeof p,lay,"unisacc.com");
    if(!realpath("./unisacc.com",ape)||sy_lstat(p,&st)!=-ENOENT||sy_copy(ape,p,0755)){rg_clean_layout(stage);return 2;}
    rg_file(db,sizeof db,stage,"shallow-git");
    if(cx_fmt(dbarg,sizeof dbarg,"--separate-git-dir=%s",db)){rg_clean_layout(stage);return 2;}
    rg_file(gitlink,sizeof gitlink,lay,".git");
    {
        char *init[]={"./tools/bound","15","env","-u","GIT_DIR","-u","GIT_WORK_TREE","-u","GIT_INDEX_FILE","git","-C",lay,"init","-q",dbarg,0};
        char *add[]={"./tools/bound","55","env","-u","GIT_DIR","-u","GIT_WORK_TREE","-u","GIT_INDEX_FILE","git","-C",lay,"add","-Af","--",".",":(exclude)unisacc.com",0};
        char *commit[]={"./tools/bound","55","env","-u","GIT_DIR","-u","GIT_WORK_TREE","-u","GIT_INDEX_FILE","git","-C",lay,"-c","user.name=register","-c","user.email=register@localhost","-c","commit.gpgsign=false","commit","-qm","register single-commit qualify layout",0};
        if(run(init,buf,sizeof buf)||run(add,buf,sizeof buf)||run(commit,buf,sizeof buf)){sy_unlink(gitlink);rg_clean_layout(stage);return 2;}
    }
    rg_file(p,sizeof p,lay,"out");if(sy_mkdir(p,0700)){sy_unlink(gitlink);rg_clean_layout(stage);return 2;}
    rg_file(out,sizeof out,p,"trial");rg_file(privtmp,sizeof privtmp,p,"cold-tmp");
    rg_file(coldcache,sizeof coldcache,p,"cold-cache");rg_file(coldprep,sizeof coldprep,p,"cold-prep");
    if(sy_mkdir(out,0700)||sy_mkdir(privtmp,0700)||sy_mkdir(coldcache,0700)||sy_mkdir(coldprep,0700)||
       cx_fmt(envtmp,sizeof envtmp,"TMPDIR=%s",privtmp)||cx_fmt(envcache,sizeof envcache,"UNISACC_CACHE_DIR=%s",coldcache)||
       cx_fmt(envprep,sizeof envprep,"UNISACC_PREP_CACHE=%s",coldprep)||cx_fmt(want,sizeof want,"BATCH_RUN\tid=%s\tstatus=PASS\t",id)){
        sy_unlink(gitlink);rg_clean_layout(stage);return 2;
    }
    char *trial[32]; int n=0;
    trial[n++]="./tools/bound"; trial[n++]="55"; trial[n++]="env"; trial[n++]="-C"; trial[n++]=lay;
    trial[n++]="-u"; trial[n++]="GIT_DIR"; trial[n++]="-u"; trial[n++]="GIT_WORK_TREE"; trial[n++]="-u"; trial[n++]="GIT_INDEX_FILE";
    trial[n++]="-u"; trial[n++]="CLAUDE_JOB_DIR"; trial[n++]="-u"; trial[n++]="UNISACC_TABLES";
    trial[n++]=envcache; trial[n++]=envprep;
    trial[n++]="UNISACC_BATCH_TIMES=off";
    trial[n++]=(char *)batchbin;
    if(use_dev){trial[n++]="--candidate"; trial[n++]=(char *)devdir;}
    trial[n++]=lay; trial[n++]=out; trial[n++]=(char *)id; trial[n]=0;
    long start=sy_now_ms();
    int rc=run(trial,buf,sizeof buf);
    long elapsed=sy_now_ms()-start;
    sy_unlink(gitlink);
    rg_clean_layout(stage);
    if(rc==0 && strstr(buf,want)){
        printf("REGISTER_LAYOUT_SELFTEST\tid=%s\tstatus=PASS\tms=%ld\n",id,elapsed);
        return 0;
    }
    const char *why="layout-selftest-failed";
    if(rc==124 || strstr(buf,"transport=-1"))why="timeout-55s-cold";
    else if(strstr(buf,"not a valid object name") || strstr(buf,"unknown revision") || strstr(buf,"bad object"))why="git-history-dependency";
    else if(strstr(buf,"CLAUDE_JOB_DIR"))why="env-dependency";
    printf("REGISTER_LAYOUT_SELFTEST\tid=%s\tstatus=REFUSE\treason=%s\trc=%d\tms=%ld\n",id,why,rc,elapsed);
    fputs(buf,stderr);
    return 1;
}
typedef struct {const RegRow *old,*next;RegRow pkg;char hash[65],*file;size_t bytes;int mode;} RgShard;
typedef struct {RgShard *shards;int limit,count;RgManifest *changes;RegRow fact;char *coverage,*original;size_t cn,on;} RgShardPlan;
static void rg_coverage_source(RegRow *chosen,RegRow source){
    int tabs=0;for(int i=0;i<source.n;i++)if(source.p[i]=='\t')tabs++;
    if(tabs!=4 || source.n<19 || memcmp(source.p,"tools.compile-all\t",18) || source.p[source.n-1]!='\n')rg_die("coverage-source-invalid","tools.compile-all");
    if(chosen->p && !rg_same_row(chosen,&source))rg_die("coverage-key-conflict","tools.compile-all");
    *chosen=source;
}
static void rg_shard_manifest(RgShard *s,RegRow *chosen){
    int count,have_batch=0,have_pkg=0,have_cov=0;RegRow *rows=rg_rows(s->file,s->bytes,&count);
    for(int j=0;j<count;j++){
        RegRow r=rows[j];if(r.key+1>=r.n)rg_die("manifest-row-invalid",0);
        const char *tag=r.p;r.p+=r.key+1;r.n-=r.key+1;
        if(r.key==5 && !memcmp(tag,"batch",5)){
            if(have_batch++ || !rg_same_row(&r,s->old?s->old:s->next))rg_die("manifest-batch-conflict",0);
        }else if(r.key==8 && !memcmp(tag,"packages",8)){
            if(have_pkg++ || !rg_same_row(&r,&s->pkg))rg_die("manifest-packages-conflict",0);
        }else if(r.key==8 && !memcmp(tag,"coverage",8)){
            if(have_cov++)rg_die("manifest-duplicate-coverage",0);
            rg_coverage_source(chosen,r);
        }else if(r.key!=7 || memcmp(tag,"compile",7))rg_die("manifest-tag-invalid",0);
    }
    if(!have_batch||!have_pkg||!have_cov)rg_die("manifest-incomplete",0);
    free(rows);
}
/* Other batches may share the same coverage key. Their manifest is never
   rewritten by shard registration, but a conflicting row blocks publication. */
static void rg_check_shared_coverage(RgShardPlan *plan){
    if(!plan->fact.p)return;
    char dir[4500],path[4800];if(!rg_manifest_dir(dir,sizeof dir))return;
    DIR *d=opendir(dir);if(!d)rg_die("manifest-directory-invalid",dir);
    for(;;){
        errno=0;struct dirent *e=readdir(d);if(!e){if(errno)rg_die("manifest-directory-read",dir);break;}
        size_t len=strlen(e->d_name);
        if(len<5 || memcmp(e->d_name+len-4,".tsv",4))continue;
        rg_file(path,sizeof path,dir,e->d_name);
        size_t n;char *bytes=rg_read_regular(path,&n);
        for(size_t at=0;at<n;){
            char *lf=memchr(bytes+at,'\n',n-at);size_t end=lf?(size_t)(lf-bytes)+1:n;
            const char *prefix="coverage\ttools.compile-all\t";
            if(end-at>=strlen(prefix)&&!memcmp(bytes+at,prefix,strlen(prefix))){
                RegRow value={bytes+at+9,end-at-9,17};
                if(!rg_same_row(&plan->fact,&value))rg_die("coverage-key-conflict",path);
            }
            at=end;
        }
        free(bytes);
    }
    closedir(d);
}
static int rg_shard_inputs_current(RgShardPlan *plan){
    for(int i=0;i<plan->limit;i++){
        RgShard *s=plan->shards+i;if(!s->old&&!s->next)continue;
        char path[4600],hash[65];rg_manifest_path(i,path,sizeof path);
        if(rg_snapshot(path,hash)||!tx_eqz(hash,s->hash))return 0;
        if(s->file){sy_stat_t st;if(sy_lstat(path,&st)||st.mode!=s->mode)return 0;}
    }
    return 1;
}
static void rg_plan_shards(RgShardPlan *plan,const char *stage,const char *bb,size_t bn,const char *nb,size_t nbn){
    int counts[2];RegRow *rows[2];rows[0]=rg_rows(bb,bn,counts);rows[1]=rg_rows(nb,nbn,counts+1);
    for(int k=0;k<2;k++)for(int j=0;j<counts[k];j++){
        long id=rg_shard_of(rows[k][j].p,rows[k][j].n);
        if(id>=100000)rg_die("shard-index-bound",0);
        if(id>=plan->limit)plan->limit=id+1;
    }
    plan->shards=calloc(plan->limit+1,sizeof *plan->shards);
    plan->changes=calloc(plan->limit+1,sizeof *plan->changes);
    if(!plan->shards||!plan->changes)rg_die("allocation",0);
    for(int k=0;k<2;k++)for(int j=0;j<counts[k];j++){
        RegRow *r=rows[k]+j;long id=rg_shard_of(r->p,r->n);if(id<0)continue;
        char name[64];if(cx_fmt(name,sizeof name,"tools-compile-%03ld",id)||strlen(name)!=r->key||memcmp(r->p,name,r->key))rg_die("shard-key-invalid",0);
        RgShard *s=plan->shards+id;const RegRow **slot=k?&s->next:&s->old;
        if(*slot)rg_die("duplicate-shard-key",name);*slot=r;
    }
    plan->original=rg_read_regular(rg_cpath(),&plan->on);plan->coverage=plan->original;plan->cn=plan->on;
    if(!plan->limit)return;
    RegRow chosen={0};int nc;RegRow *cr=rg_rows(plan->original,plan->on,&nc);
    for(int j=0;j<nc;j++)if(cr[j].key==17&&!memcmp(cr[j].p,"tools.compile-all",17)){
        if(chosen.p)rg_die("duplicate-coverage-key","tools.compile-all");rg_coverage_source(&chosen,cr[j]);
    }
    int has_coverage=chosen.p!=0;
    char in[4600];rg_file(in,sizeof in,stage,"manifest-query.tsv");
    FILE *f=fopen(in,"wb");if(!f)rg_die("manifest-query-stage",in);
    for(int i=0;i<plan->limit;i++){
        RgShard *s=plan->shards+i;const RegRow *r=s->next?s->next:s->old;
        if(r && fwrite(r->p,1,r->n,f)!=(size_t)r->n)rg_die("manifest-query-write",in);
    }
    if(fclose(f))rg_die("manifest-query-write",in);
    char product[4096];if(!realpath("unisacc.com",product))rg_die("manifest-query-product",0);
    char *query[]={"sh",product,"tools/batch-packages-gen.cx","--","--query","--registry",in,0},*output=0;size_t bytes=0;
    if(cx_runv_timeout(query,30,&output,&bytes)||!output)rg_die("manifest-packages-query",in);
    int np;RegRow *packages=rg_rows(output,bytes,&np);
    for(int j=0;j<np;j++){
        RegRow r=packages[j];if(r.key!=5||memcmp(r.p,"batch",5))continue;
        long id=rg_shard_of(r.p+6,r.n-6);
        if(id<0||id>=plan->limit||plan->shards[id].pkg.p)rg_die("manifest-query-invalid",in);
        plan->shards[id].pkg=r;
    }
    for(int i=0;i<plan->limit;i++){
        RgShard *s=plan->shards+i;if(!s->old&&!s->next)continue;
        if(!s->pkg.p)rg_die("manifest-query-missing",in);
        char path[4600];rg_manifest_path(i,path,sizeof path);sy_stat_t st;int rc=sy_lstat(path,&st);
        if(rc==-ENOENT)continue;
        if(rc || st.kind!='f' || st.mode>0777)rg_die("manifest-file-invalid",path);
        s->mode=st.mode;
        s->file=rg_read_regular(path,&s->bytes);
        if(sy_sha256_hex(s->file,s->bytes,s->hash))rg_die("manifest-hash",path);
        rg_shard_manifest(s,&chosen);
    }
    if(!chosen.p)rg_die("coverage-source-missing","tools.compile-all");
    plan->fact=chosen;rg_check_shared_coverage(plan);
    if(!has_coverage){
        if(plan->on && plan->original[plan->on-1]!='\n')rg_die("coverage-incomplete",rg_cpath());
        plan->cn+=chosen.n;plan->coverage=malloc(plan->cn+1);
        if(!plan->coverage||mm_copy(plan->coverage,plan->cn,plan->original,plan->on)||
           mm_copy(plan->coverage+plan->on,chosen.n,chosen.p,chosen.n))rg_die("allocation",0);
        plan->coverage[plan->cn]=0;
    }
    for(int i=0;i<plan->limit;i++){
        RgShard *s=plan->shards+i;RgManifest *m=plan->changes+plan->count;
        if(s->old&&!s->next&&s->file){m->before=s->file;m->bn=s->bytes;}
        else if(!s->old&&s->next&&!s->file){
            size_t cap=32+s->next->n+chosen.n+s->pkg.n;m->after=malloc(cap);
            if(!m->after||cx_fmt(m->after,cap,"batch\t%.*scoverage\t%.*spackages\t%.*s",(int)s->next->n,s->next->p,(int)chosen.n,chosen.p,(int)s->pkg.n,s->pkg.p))rg_die("manifest-format",0);
            m->an=strlen(m->after);
        }else continue;
        m->shard=i;m->mode=m->before?s->mode:0644;plan->count++;
        printf("REGISTER_SYNC_MANIFEST\ttools-compile-%03d\t%s\n",i,m->after?"add":"remove");
    }
}
static int rg_tool_mode(int argc, char **argv) {
    static char buf[1 << 15];
    const char *tools[RG_TOOLS_MAX], *kinds[RG_TOOLS_MAX], *owner = 0; int staged[RG_TOOLS_MAX], have[RG_TOOLS_MAX], nt = 0, i, j, rc, lk;
    char *sb, *bb, *pb = 0, *ns, *nb, *np = 0; size_t sn = 0, bn = 0, pn = 0, nsn = 0, nbn = 0, npn = 0;
    long at, rows = 0, shards, added_src = 0, added_sh = 0, removed_sh = 0, added_pin = 0, need_pin = 0, ins, *seen;
    int ch_s, ch_b, ch_p = 0, dirty = 0, did = 0;
    int sync_dry=argc==4 && tx_eqz(argv[1],"--tool") && tx_eqz(argv[2],"--sync") && tx_eqz(argv[3],"--dry");
    int publishing=argc==3 && tx_eqz(argv[1],"--tool") && tx_eqz(argv[2],"--sync");
    int sync=publishing || sync_dry;
    char stage[4400],stage_tests[4500],stage_sources[4600],stage_batches[4600];
    for (i = 1; !sync && i < argc; i++) {
        if (tx_eqz(argv[i], "--tool") && i + 1 < argc) {
            const char *t = argv[++i]; size_t tl = strlen(t); struct stat st; int dup = 0;
            if (tl < 10 || tl > 240 || memcmp(t, "tools/", 6) || strcmp(t + tl - 3, ".cx") || !clean(t) || strstr(t, "..") || strstr(t, "//")) rg_die("--tool wants tools/NAME.cx", t);
            if (lstat(t, &st)) rg_die("--tool: no such file", t);
            if (!S_ISREG(st.st_mode) && !S_ISLNK(st.st_mode)) rg_die("--tool: not a regular file or symlink", t);
            for (j = 0; j < nt; j++) if (!strcmp(tools[j], t)) dup = 1;
            if (dup) continue;
            if (nt == RG_TOOLS_MAX) rg_die("too many --tool", t);
            tools[nt] = t; kinds[nt] = S_ISLNK(st.st_mode) ? "symlink" : "regular"; staged[nt] = 0; nt++;
        } else if (tx_eqz(argv[i], "--pin-owner") && i + 1 < argc) {
            owner = argv[++i]; if (!*owner || !clean(owner)) rg_die("--pin-owner wants a plain name", owner);
        } else rg_die("usage", "--tool tools/NAME.cx [--tool ...] [--pin-owner OWNER]");
    }
    if (!nt && !sync) rg_die("usage", "--tool tools/NAME.cx [--tool ...] [--pin-owner OWNER] | --tool --sync [--dry|--recover]");
    for (i = 1; i < nt; i++) {   /* byte order, so one merge pass places them all */
        const char *t = tools[i], *k = kinds[i];
        for (j = i - 1; j >= 0 && rg_bcmp(tools[j], (long)strlen(tools[j]), t, (long)strlen(t)) > 0; j--) { tools[j + 1] = tools[j]; kinds[j + 1] = kinds[j]; }
        tools[j + 1] = t; kinds[j + 1] = k;
    }
    if (rg_root_missing()) { fprintf(stderr, "register: nothing was written (--tool)\n"); return 2; }
    if (sy_exists("tools/bound") != 1) rg_die("--tool: no ./tools/bound in this root", 0);
    if (sy_exists("tests/tools-compile.cx") != 1) rg_die("--tool: no tests/tools-compile.cx in this root", 0);
    lk = rg_lock();
    char decl[4400],versions[5][65],index_path[4400],index_hash[65],product_path[4096],product_hash[65];
    if(publishing){
        char *index_cmd[]={"./tools/bound","5","git","rev-parse","--git-path","index",0};
        if(run(index_cmd,index_path,sizeof index_path)||!strchr(index_path,'\n'))rg_die("sync-index-path",0);
        *strchr(index_path,'\n')=0;
        if(rg_snapshot(index_path,index_hash)||!index_hash[0]||!realpath("unisacc.com",product_path)||rg_snapshot(product_path,product_hash)||!product_hash[0])rg_die("sync-input-identity",0);
    }
    if(cx_fmt(decl,sizeof decl,"%s/batch-product-inputs.tsv",rg_tdir()))rg_die("path bound","batch-product-inputs");
    char syncsrc[4400];rg_file(syncsrc,sizeof syncsrc,rg_tdir(),rg_names[0]);
    const char *sourcepath=sync?syncsrc:RG_SOURCES;
    const char *tables[]={rg_bpath(),rg_cpath(),sourcepath,decl,RG_PINS};
    for(int t=0;t<5;t++)if(rg_snapshot(tables[t],versions[t]))rg_die("cannot fingerprint",tables[t]);
    sb = cx_read(sourcepath, &sn); bb = cx_read(rg_bpath(), &bn);
    if (!sb) rg_die("cannot read", RG_SOURCES);
    if (!bb) rg_die("cannot read", rg_bpath());
    if ((sn && sb[sn - 1] != '\n') || (bn && bb[bn - 1] != '\n')) rg_die("--tool: table does not end in a newline", sn && sb[sn - 1] != '\n' ? RG_SOURCES : rg_bpath());
    /* (a) merge the tools into the sources table.  Presence is decided over the whole table first: the
       reviewed table is compared as a set by tools-compile and is not guaranteed to be in order everywhere,
       so a row that stands out of order must still count as registered and never be inserted twice. */
    ns = malloc(sn + (size_t)nt * 260 + 1);
    if (!ns) rg_die("allocation", 0);
    for (j = 0; j < nt; j++) have[j] = 0;
    for (at = 0; at < (long)sn;) {
        long e = at, pl = 0;
        while (e < (long)sn && sb[e] != '\n') e++;
        while (pl < e - at && sb[at + pl] != '\t') pl++;
        for (j = 0; j < nt; j++) if (!rg_bcmp(tools[j], (long)strlen(tools[j]), sb + at, pl)) {
            if(e-at!=pl+1+(long)strlen(kinds[j]) || memcmp(sb+at+pl+1,kinds[j],strlen(kinds[j])))rg_die("key-conflict",tools[j]);
            have[j] = 1;
        }
        at = e + 1;
    }
    for (at = 0, j = 0; at < (long)sn;) {
        long e = at, pl = 0;
        while (e < (long)sn && sb[e] != '\n') e++;
        while (pl < e - at && sb[at + pl] != '\t') pl++;
        for (;; j++) {
            if (j < nt && have[j]) continue;
            if (j >= nt || rg_bcmp(tools[j], (long)strlen(tools[j]), sb + at, pl) > 0) break;
            nsn += (size_t)tx_snprintf(ns + nsn, 260, "%s\t%s\n", tools[j], kinds[j]); added_src++; rows++;
        }
        if (mm_copy(ns + nsn, (long)(sn + (size_t)nt * 260 + 1 - nsn), sb + at, (long)(e + 1 - at))) rg_die("sources copy bound", 0); nsn += (size_t)(e + 1 - at); rows++;
        at = e + 1;
    }
    for (; j < nt; j++) if (!have[j]) { nsn += (size_t)tx_snprintf(ns + nsn, 260, "%s\t%s\n", tools[j], kinds[j]); added_src++; rows++; }
    if(sync){
        if(sy_mkdtemp(sy_tmpdir(),"register-sync-",stage,sizeof stage) ||
           cx_fmt(stage_tests,sizeof stage_tests,"%s/tests",stage) || sy_mkdir(stage_tests,0700) ||
           cx_fmt(stage_sources,sizeof stage_sources,"%s/tools-compile-sources.tsv",stage_tests) ||
           cx_fmt(stage_batches,sizeof stage_batches,"%s/batches.tsv",stage_tests))rg_die("sync private layout",0);
        char *generate[]={"./tools/bound","30","sh","./unisacc.com","tests/tools-compile.cx","--","--register",".",stage_sources,0};
        rc=run(generate,buf,sizeof buf);
        if(rc){cx_rmtree(stage);rg_die("sync inventory",buf);}
        free(ns);ns=cx_read(stage_sources,&nsn);
        if(!ns){cx_rmtree(stage);rg_die("sync inventory read",0);}
        rows=0;for(size_t k=0;k<nsn;k++)if(ns[k]=='\n')rows++;
    }
    shards = rows / 8 + (rows % 8 != 0);
    /* (b) the shard rows: exactly 0..shards-1 */
    seen = calloc((size_t)shards + 1, sizeof *seen); nb = malloc(bn + (size_t)shards * 256 + 1);
    if (!seen || !nb) rg_die("allocation", 0);
    for (at = 0, ins = -1; at < (long)bn;) {
        long e = at, s;
        while (e < (long)bn && bb[e] != '\n') e++;
        s = rg_shard_of(bb + at, e - at);
        if (s >= 0 && s < shards) { seen[s] = 1; ins = e + 1; }
        at = e + 1;
    }
    if (ins < 0) ins = (long)bn;
    for (at = 0;;) {
        if (at == ins) for (j = 0; j < shards; j++) if (!seen[j]) {
            nbn += (size_t)tx_snprintf(nb + nbn, 256, "tools-compile-%03d\tIMPLEMENTED\tcontract\ttests/tools-compile.cx\tSOURCE\tlnx/x86_64\t55\t-\ttests/tools-compile.cx\t{root};{out};%d\ttools.compile-all\trc0:TOOLS_COMPILE\tproduct\tdaily\n", j, j);
            added_sh++;
        }
        if (at >= (long)bn) break;
        {   long e = at;
            while (e < (long)bn && bb[e] != '\n') e++;
            if (rg_shard_of(bb + at, e - at) >= shards) removed_sh++;
            else { if (mm_copy(nb + nbn, (long)(bn + (size_t)shards * 256 + 1 - nbn), bb + at, (long)(e + 1 - at))) rg_die("batches copy bound", 0); nbn += (size_t)(e + 1 - at); }
            at = e + 1;
        }
    }
    if(sync){
        char gitdir[4600],worktree[4600],want[64];
        char *gitpath[]={"./tools/bound","5","git","rev-parse","--absolute-git-dir",0};
        if(run(gitpath,buf,sizeof buf) || !strchr(buf,'\n')){cx_rmtree(stage);rg_die("sync git directory",buf);}
        *strchr(buf,'\n')=0;
        if(cx_fmt(gitdir,sizeof gitdir,"GIT_DIR=%s",buf) ||
           cx_fmt(worktree,sizeof worktree,"GIT_WORK_TREE=%s",stage) || cx_write(stage_batches,nb,nbn)){
            cx_rmtree(stage);rg_die("sync private tables",0);
        }
        char *verify[]={"./tools/bound","30","env",gitdir,worktree,"sh","./unisacc.com","tests/tools-compile.cx","--","--shards",stage,0};
        rc=run(verify,buf,sizeof buf);
        if(cx_fmt(want,sizeof want,"%ld\n",shards) || rc || !tx_eqz(buf,want))rg_die("sync shard verification",buf);
        RgShardPlan plan={0};rg_plan_shards(&plan,stage,bb,bn,nb,nbn);
        if(publishing && added_sh){
            rg_unlock(lk);
            for(j=0;j<shards;j++)if(!seen[j] && rg_cold_shard(stage,ns,nsn,nb,nbn,plan.coverage,plan.cn,j)){
                rg_clean_layout(stage);rg_die("cold-shard-preflight",0);
            }
            lk=rg_lock();
            rg_check_shared_coverage(&plan);
        }
        if(publishing?rg_clean_layout(stage):cx_rmtree(stage))rg_die("sync cleanup",stage);
        for(int t=0;t<4;t++){
            char current[65];if(rg_snapshot(tables[t],current))rg_die("sync snapshot",tables[t]);
            if(!tx_eqz(current,versions[t])){rg_unlock(lk);return 4;}
        }
        if(publishing){
            char now[65],ape[4096];
            if(rg_snapshot(index_path,now)||!tx_eqz(now,index_hash)||!realpath("unisacc.com",ape)||rg_snapshot(ape,now)||!tx_eqz(now,product_hash)||!rg_shard_inputs_current(&plan)){rg_unlock(lk);return 4;}
        }
        rg_plan_delta(sourcepath,sb,sn,ns,nsn);rg_plan_delta(rg_bpath(),bb,bn,nb,nbn);
        rg_plan_delta(rg_cpath(),plan.original,plan.on,plan.coverage,plan.cn);
        printf("REGISTER_SYNC_TABLE\t%s\tnot_checked\n",decl);
        printf("REGISTER_SYNC\tmode=%s\tshards=%ld\tshard_rows_added=%ld\tshard_rows_removed=%ld\n",sync_dry?"dry":"write",shards,added_sh,removed_sh);
        rc=publishing?rg_sync_publish(ns,nsn,nb,nbn,plan.coverage,plan.cn,plan.changes,plan.count,versions):0;
        rg_unlock(lk);free(sb);free(bb);free(ns);free(nb);free(seen);return rc;
    }
    /* (c) 64-hex literals without a pins row */
    if (sy_exists(RG_PINS) == 1) { pb = cx_read(RG_PINS, &pn); if (!pb) rg_die("cannot read", RG_PINS); }
    np = malloc(pn + 1); if (!np) rg_die("allocation", 0);
    if (pn && mm_copy(np, (long)pn + 1, pb, (long)pn)) rg_die("pins copy bound", 0);
    npn = pn;
    for (i = 0; i < nt; i++) {
        size_t tn = 0, k = 0; char *tb = cx_read(tools[i], &tn), hex[65]; long line = 1;
        if (!tb) rg_die("cannot read", tools[i]);
        while (k < tn) {
            size_t r = k;
            if (tb[k] == '\n') { line++; k++; continue; }
            if (!rg_ishex(tb[k])) { k++; continue; }
            while (r < tn && rg_ishex(tb[r])) r++;
            if (r - k == 64 && !(k && ((tb[k - 1] >= 'g' && tb[k - 1] <= 'z') || (tb[k - 1] >= 'A' && tb[k - 1] <= 'Z') || tb[k - 1] == '_'))) {
                if (mm_copy(hex, 65, tb + k, 64)) rg_die("hex copy bound", 0); hex[64] = 0;
                if (!rg_pin_has(np, (long)npn, tools[i], hex)) {
                    if (owner && pb) {
                        char *g = realloc(np, npn + 600); if (!g) rg_die("allocation", 0);
                        np = g; if (npn && np[npn - 1] != '\n') np[npn++] = '\n';
                        npn += (size_t)tx_snprintf(np + npn, 590, "%s#%s\tliteral\t-\t%s\t%s\tok\n", tools[i], hex, hex, owner); added_pin++;
                    } else { need_pin++; printf("REGISTER_TOOL\tPIN_NEEDED\t%s:%ld\trow=%s#%s<TAB>literal<TAB>-<TAB>%s<TAB>OWNER<TAB>ok\thint=rerun with --pin-owner OWNER or add the row to %s\n", tools[i], line, tools[i], hex, hex, RG_PINS); }
                }
            }
            k = r;
        }
        free(tb);
    }
    ch_s = nsn != sn || memcmp(ns, sb, sn); ch_b = nbn != bn || memcmp(nb, bb, bn); ch_p = added_pin > 0;
    /* (d) stage what is not tracked yet, then write, then verify; any failure from here on is undone */
    {   const char *step = 0;
        for (i = 0; i < nt && !step; i++) {
            char *q[] = {"./tools/bound", "20", "git", "ls-files", "--error-unmatch", "--", (char *)tools[i], 0};
            char *a[] = {"./tools/bound", "20", "git", "add", "--", (char *)tools[i], 0};
            rc = run(q, buf, sizeof buf);
            if (rc == 0) continue;
            if (rc != 1) { step = "git ls-files"; fprintf(stderr, "register: --tool: git ls-files %s failed rc=%d (is this root a git work tree?): %s\n", tools[i], rc, buf); break; }
            rc = run(a, buf, sizeof buf);
            if (rc != 0) { step = "git add"; fprintf(stderr, "register: --tool: git add %s failed rc=%d: %s\n", tools[i], rc, buf); }
            else { staged[i] = 1; did = 1; }
        }
        int stale=0;
        int targets[]={2,0,4},changes[]={ch_s,ch_b,ch_p};
        char *values[]={ns,nb,np};size_t sizes[]={nsn,nbn,npn};
        for(int w=0;w<3 && !step;w++){
            for(int t=0;!step && t<5;t++){
                char current[65];
                if(rg_snapshot(tables[t],current))step=tables[t];
                else if(!tx_eqz(current,versions[t])){step="registry input changed";stale=1;}
            }
            if(!step && changes[w]){
                int t=targets[w];
                if(sy_sha256_hex(values[w],sizes[w],versions[t]) || sy_write_atomic(tables[t],values[w],sizes[w],0644))step=tables[t];
                else dirty|=1<<w;
            }
        }
        if (!step) {
            char *v[] = {"./tools/bound", "55", "sh", "./unisacc.com", "tests/tools-compile.cx", "--", "--shards", ".", 0};
            char want[32]; long bl;
            /* tools-compile reads ROOT/tests/batches.tsv: with UNISACC_TABLES the private batches table is
               not the one it sees, so only the inventory half can be verified there */
            rc = run(v, buf, sizeof buf); bl = (long)strlen(buf);
            tx_snprintf(want, sizeof want, "%ld\n", shards);
            if (rc != 0 || bl < (long)strlen(want) || strcmp(buf + bl - strlen(want), want) || (bl > (long)strlen(want) && buf[bl - strlen(want) - 1] != '\n')) {
                step = "tests/tools-compile.cx --shards";
                fprintf(stderr, "register: --tool: verification failed rc=%d want=%ld got:\n%s%s", rc, shards, buf, bl && buf[bl - 1] == '\n' ? "" : "\n");
            }
        }
        if (step) {
            int bad = 0;
            bad |= rg_tool_restore(RG_PINS,pb,pn,np,npn,dirty & 4);
            bad |= rg_tool_restore(rg_bpath(),bb,bn,nb,nbn,dirty & 2);
            bad |= rg_tool_restore(RG_SOURCES,sb,sn,ns,nsn,dirty & 1);
            for (i = 0; i < nt; i++) if (staged[i]) {
                char *u[] = {"./tools/bound", "20", "git", "rm", "--cached", "-q", "--", (char *)tools[i], 0};
                if (run(u, buf, sizeof buf) != 0) { bad = 1; fprintf(stderr, "register: --tool rollback could NOT unstage %s\n", tools[i]); }
            }
            rg_unlock(lk);
            printf("REGISTER_TOOL\tstatus=%s\tfailed_step=%s\n", bad ? "DIRTY" : "ROLLED_BACK", step);
            return bad ? 3 : stale ? 4 : 1;
        }
    }
    rg_unlock(lk);
    for (i = 0; i < nt; i++) printf("REGISTER_TOOL\ttool=%s\tkind=%s\tgit=%s\n", tools[i], kinds[i], staged[i] ? "ADDED" : "TRACKED");
    printf("REGISTER_TOOL\tsources_added=%ld\tinventory=%ld\tshards=%ld\tshard_rows_added=%ld\tshard_rows_removed=%ld\tpins_added=%ld\tpins_needed=%ld\n", added_src, rows, shards, added_sh, removed_sh, added_pin, need_pin);
    printf("REGISTER_TOOL\tstatus=%s\n", ch_s || ch_b || ch_p || did ? "REGISTERED" : "UNCHANGED");
    if (ch_s || ch_b || ch_p || did) printf("REGISTER_NEXT\tderive --write --only links,batch-domains\n");
    return 0;
}

int main(int argc, char **argv) {
    /* --layout-rows LAYDIR REL PROPOSED: print the rows of PROPOSED a layout keeps (fixture entry for
       tools/check-register-cold-runner.cx; reads only, writes nothing). */
    if(argc==5 && tx_eqz(argv[1],"--layout-rows")){
        size_t pn=0,on=0;char *pb=cx_read(argv[4],&pn);if(!pb){fprintf(stderr,"register: layout-rows read %s\n",argv[4]);return 2;}
        char *o=rg_layout_rows(argv[2],argv[3],pb,pn,&on);if(!o)return 2;
        fwrite(o,1,on,stdout);free(o);free(pb);return 0;
    }
    if(argc==4 && tx_eqz(argv[1],"--tool") && tx_eqz(argv[2],"--sync") && tx_eqz(argv[3],"--recover")){
        int fd=rg_try_lock(rg_lock_ms());if(fd<0)rg_die("recovery-lock-timeout",rg_lockpath());
        rg_report_retired();
        rg_file(journal,sizeof journal,rg_tdir(),".register-txn");
        sy_stat_t st;int ex=sy_lstat(journal,&st);
        if(ex==-ENOENT)puts("REGISTER_SYNC\tstatus=NO_PENDING");
        else if(ex || st.kind!='d')rg_die("transaction-path-invalid",journal);
        else rg_recover();
        rg_unlock(fd);return 0;
    }
    if (argc >= 2 && (tx_eqz(argv[1], "--tool") || tx_eqz(argv[1], "--pin-owner"))) {
        for(int trial=0;trial<3;trial++){int rc=rg_tool_mode(argc,argv);if(rc!=4)return rc;}
        rg_die("REFUSE registry-changed-three-times",0);
    }
    static char brow[8192], crow[8192], cid[512], root[4096], parent[4400], buf[1 << 16];
    const char *id, *check, *marker, *text, *files, *layer, *headers;
    const char *arguments="-";
    static char normargs[8192];
    int norun = 0, force_layout = 0;
    char devdir[4096];int use_dev=0;
    {   int w = 1, r;   /* --no-run may stand anywhere: strip it and keep the rest in order */
        for (r = 1; r < argc; r++) {
            if(tx_eqz(argv[r],"--args") && r+1<argc){argv[w++]=argv[r];argv[w++]=argv[++r];}
            else if(tx_eqz(argv[r],"--runner")){
                if(use_dev || r+1==argc || argv[r+1][0]!='/')rg_die("--runner requires an absolute dev-product directory",0);
                sy_stat_t st;
                if(sy_realpath(argv[++r],devdir,sizeof devdir)<0 || sy_stat(devdir,&st) || st.kind!='d')rg_die("--runner invalid dev-product directory",argv[r]);
                use_dev=1;
            } else if (tx_eqz(argv[r], "--no-run")) norun = 1;
            else if (tx_eqz(argv[r], "--layout-selftest")) force_layout = 1;
            else argv[w++] = argv[r];
        }
        argc = w; argv[argc] = 0;
    }
    if(argc>=3&&tx_eqz(argv[argc-2],"--args")){arguments=argv[argc-1];argc-=2;if(!*arguments||!clean(arguments))rg_die("empty args, TAB or newline in args",0);
        /* table convention: words of one args field are joined by ';' ("--cases;lock"); spaces and the
           "--opt=value" form are folded into it */
        {   int tok0 = 1, dashed = 0, eqdone = 0; size_t o = 0; const char *p = arguments;
            for (; *p; p++) {
                if (o + 2 >= sizeof normargs) rg_die("args too long", 0);
                if (*p == ' ') { if (o && normargs[o - 1] != ';') { while (p[1] == ' ') p++; if (p[1]) normargs[o++] = ';'; } tok0 = 1; dashed = 0; eqdone = 0; continue; }
                if (tok0) { dashed = p[0] == '-' && p[1] == '-'; tok0 = 0; }
                if (dashed && !eqdone && *p == '=') { normargs[o++] = ';'; eqdone = 1; continue; }
                if (*p == ';') eqdone = 1;
                normargs[o++] = *p;
            }
            normargs[o] = 0; if (!o) rg_die("empty args, TAB or newline in args",0);
            arguments = normargs;
        }
    }
    int rc, okrun, lk; long at;
    if (argc < 6 || argc > 8) rg_die("usage", "ID CHECK.cx MARKER \"COVERAGE TEXT\" \"FILES\" [LAYER] [HEADERS] [--runner ABS_DEV_DIR] [--args ARGS]");
    id = argv[1]; check = argv[2]; marker = argv[3]; text = argv[4]; files = argv[5]; layer = argc >= 7 ? argv[6] : "interfaces";
    headers = argc == 8 ? argv[7] : "product";
    if (!clean(id) || !clean(check) || !clean(marker) || !clean(text) || !clean(files) || !clean(layer) || !*id || !*marker) rg_die("empty field, TAB or newline in a field", 0);
    if (!tx_eqz(headers, "product") && !tx_eqz(headers, "tree")) rg_die("HEADERS must be product or tree", headers);
    if (!rg_marker_ok(marker)) rg_die("MARKER must be one rc0: tail ([A-Z0-9_]+), register adds the \"rc0:\" itself", marker);
    if (rg_root_missing()) { fprintf(stderr, "register: nothing was written (id %s)\n", id); return 2; }
    if (!sy_exists(check)) rg_die("no such check", check);
    if (tx_snprintf(cid, sizeof cid, "%s.%s", layer, id) >= (int)sizeof cid) rg_die("id too long", id);
    char cache[4400], listbin[4400], batchbin[4400], bpbin[4400], why[512]; int reused, bpok = 0;
    if (sy_realpath(".", root, sizeof root) < 0 || cx_fmt(cache, sizeof cache, "%s/unisacc-register-native", sy_tmpdir())) rg_die("prepare path", 0);
    if (sy_mkdir(cache, 0700) && sy_exists(cache) != 1) rg_die("prepare directory", cache);
    if (rn_prepare(root, "tests/run.cx", cache, listbin, sizeof listbin, &reused, why, sizeof why) ||
        rn_prepare(root, "tests/run-batch.cx", cache, batchbin, sizeof batchbin, &reused, why, sizeof why)) rg_die(why, 0);
    lk = rg_lock();   /* the duplicate checks, both appends and --list are one span (see the header) */
    if (has_key(rg_bpath(), id)) rg_die("batch already registered", id);
    if (has_key(rg_cpath(), cid)) rg_die("coverage row already present", cid);
    if (tx_snprintf(brow, sizeof brow, "%s\tIMPLEMENTED\t%s\t%s\tSOURCE\tlnx/x86_64\t55\t-\t%s\t%s\t%s\trc0:%s\t%s\t%s\n", id, layer, check, check, arguments, cid, marker, headers, tx_eqz(layer,"platform")?"release":"commit") >= (int)sizeof brow
        || tx_snprintf(crow, sizeof crow, "%s\t%s\tIMPLEMENTED_SEPARATE_BATCH\t%s\t%s\n", cid, layer, text, files) >= (int)sizeof crow) rg_die("row too long", id);
    if (!rg_row_ok(brow, marker)) rg_die("row would fail the tp_expect check", id);
    if (append(rg_bpath(), brow)) rg_die("cannot append", rg_bpath());
    if (append(rg_cpath(), crow)) { take_out(rg_bpath(), brow); rg_die("cannot append", rg_cpath()); }
    {   char *v[] = {"./tools/bound", "55", listbin, "--list", 0};
        rc = run(v, buf, sizeof buf);
        okrun = tx_find(buf, tx_len(buf, sizeof buf), "metadata_valid=1", 16) >= 0;
        if (!okrun) {
            printf("LIST\trc=%d\tmetadata_valid!=1\n", rc);
            /* --list refuses on stderr (REFUSE<TAB>reason<TAB>detail); the capture is the only copy */
            { size_t bn = tx_len(buf, sizeof buf); if (bn) { fwrite(buf, 1, bn, stderr); if (buf[bn - 1] != '\n') fputc('\n', stderr); } }
        }
    }
    if (okrun && norun) {
        /* --no-run: the rows stay as IMPLEMENTED, nothing is run or recorded as PASS here */
        rg_unlock(lk); lk = -1; parent[0] = 0;
        fprintf(stderr, "register: --no-run: the trial batch run was NOT done; the caller must produce batch evidence for %s itself (tests/run-batch.cx) and remove the rows if it fails\n", id);
    } else if (okrun) {
        /* The batch run is outside the lock: run.cx/run-batch only read the row, while a check that itself
           registers (tools/check-register.cx) would otherwise wait on a lock its own parent holds. */
        rg_unlock(lk); lk = -1;
        /* tests/run-batch.cx accepts a canonical output parent below ROOT/out or named TMP/unisacc-affected-* only */
        char tmpc[4096];
        if (sy_realpath(".", root, sizeof root) < 0 || sy_realpath(sy_tmpdir(), tmpc, sizeof tmpc) < 0 || tx_snprintf(parent, sizeof parent, "%s/unisacc-affected-register-%s-%d", tmpc, id, sy_pid()) >= (int)sizeof parent
            || sy_mkdir(parent, 0700) != 0) { okrun = 0; fprintf(stderr, "register: cannot create the trial run directory register-%s-%d under %s (is the temp directory writable?)\n", id, sy_pid(), sy_tmpdir()); parent[0] = 0; }
        else {
            char *v[9]={"./tools/bound","58",batchbin};int argc_run=3;
            if(use_dev){v[argc_run++]="--candidate";v[argc_run++]=devdir;}
            v[argc_run++]=root;v[argc_run++]=parent;v[argc_run++]=(char*)id;v[argc_run]=0;
            int bofd = -1, bpid = run_start(v, &bofd);
            /* while the trial run executes: prepare the batch-packages-gen native image (preparation only;
               the row query runs after PASS). Source execution remains available on a cold build. */
            if (bpid >= 0 && (!getenv("UNISACC_TABLES") || !*getenv("UNISACC_TABLES")))
                bpok = !rn_prepare(root, "tools/batch-packages-gen.cx", cache, bpbin, sizeof bpbin, &reused, why, sizeof why);
            rc = run_collect(bpid, bofd, buf, sizeof buf);
            at = tx_find(buf, tx_len(buf, sizeof buf), "BATCH_RUN\t", 10);
            if (at >= 0) { long e = tx_chr(buf + at, tx_len(buf + at, sizeof buf), '\n'); printf("%.*s\n", (int)(e < 0 ? tx_len(buf + at, sizeof buf) : e), buf + at); }
            okrun = rc == 0 && at >= 0 && tx_find(buf + at, tx_len(buf + at, sizeof buf), "status=PASS", 11) >= 0;
            if (!okrun) fputs(buf, stderr);
            if (okrun && (!getenv("UNISACC_TABLES") || !*getenv("UNISACC_TABLES") || force_layout)) {
                if (rg_qualify_layout_selftest(root, id, check, files, batchbin, use_dev, devdir) != 0) okrun = 0;
            }
        }
    }
    if (parent[0]) sy_rmdir(parent);   /* the trial run's empty reservation: sy_tmpdir()/register-ID-PID must not pile up */
    if (!okrun) {
        int t1, t2; long bno, cno;
        /* --list can fail while the append/validate lock is still owned here. */
        rg_unlock(lk); lk = -1;
        lk = rg_lock_rollback();   /* the rollback reads and rewrites both files: take the span back */
        if (lk < 0) {   /* never a bare timeout: say which rows are still where, and exit by a dedicated code */
            bno = line_of(rg_bpath(), brow); cno = line_of(rg_cpath(), crow);
            fprintf(stderr, "register: tables may be dirty: leftover row %s at batches.tsv:%ld, coverage.tsv:%ld\n", id, bno, cno);
            printf("REGISTER\tid=%s\tstatus=DIRTY\trows_left=2\n", id);
            return 3;
        }
        t1 = take_out(rg_bpath(), brow); t2 = take_out(rg_cpath(), crow);
        rg_unlock(lk);
        printf("REGISTER\tid=%s\tstatus=ROLLED_BACK\trows_removed=%d\n", id, (!t1) + (!t2));
        return 1;
    }
    if (lk >= 0) rg_unlock(lk);
    printf("REGISTER\tid=%s\tstatus=%s\n", id, norun ? "REGISTERED_NORUN" : "REGISTERED");
    rg_timing_warn(id);
    /* For a real registration obtain its canonical manifest row from the current registry. */
    if (!getenv("UNISACC_TABLES") || !*getenv("UNISACC_TABLES")) {
        char *v[] = {"./tools/bound", "58", "sh", "./unisacc.com", "tools/batch-packages-gen.cx", "--", "--query","--row",(char*)id,0};
        char *vn[] = {"./tools/bound", "58", bpbin, "--query","--row",(char*)id,0};
        rc = run(bpok ? vn : v, buf, sizeof buf);
        if (rc != 0) {
            fprintf(stderr, "register: batch registered but package row query failed (rc=%d)\n", rc);
            return 4;
        }
        printf("REGISTER\tid=%s\tbatch_packages=QUERIED\n", id);
        /* DSG-REG1: also leave the per-batch manifest tests/manifests/ID.tsv (checked by tools/reg-manifest.cx,
           so a later commit that carries one of the three rows without the others is caught). */
        {   size_t pn = strlen(buf); char *pb = buf, key[600], mp[700], *m;
            size_t i = 0, kl, bl = strlen(brow), cl = strlen(crow), ml;
            if (!pb || cx_fmt(key, sizeof key, "batch\t%s\t", id) || cx_fmt(mp, sizeof mp, "tests/manifests/%s.tsv", id)) { printf("REGISTER\tid=%s\tmanifest=SKIPPED\n", id); printf("REGISTER_NEXT\tderive --write --only links,batch-domains\n"); return 0; }
            kl = strlen(key);
            while (i < pn) {
                size_t e = i; while (e < pn && pb[e] != '\n') e++;
                if (e - i > kl && !memcmp(pb + i, key, kl)) {
                    ml = 6 + bl + 9 + cl + 9 + (e - i) + 1; m = (char *)mm_alloc(ml + 1);
                    if (!m) break;
                    memcpy(m, "batch\t", 6); mm_copy(m + 6, ml + 1 - 6, brow, bl);
                    memcpy(m + 6 + bl, "coverage\t", 9); mm_copy(m + 15 + bl, ml + 1 - 15 - bl, crow, cl);
                    memcpy(m + 15 + bl + cl, "packages\t", 9); mm_copy(m + 24 + bl + cl, ml + 1 - 24 - bl - cl, pb + i, e - i); m[24 + bl + cl + (e - i)] = '\n';
                    sy_mkdir("tests/manifests", 0755);
                    printf("REGISTER\tid=%s\tmanifest=%s\n", id, cx_write(mp, m, ml) ? "WRITE_FAILED" : "WRITTEN");
                    printf("REGISTER_NEXT\tderive --write --only links,batch-domains\n");
                    mm_free(m); return 0;
                }
                i = e + 1;
            }
            printf("REGISTER\tid=%s\tmanifest=SKIPPED\n", id);
        }
    }
    printf("REGISTER_NEXT\tderive --write --only links,batch-domains\n");
    return 0;
}
