#pragma unisa use sys.io
#pragma unisa use text.text
/* Project exec/facts/pp-targets.tsv onto one cell string per row.
   sh ./unisacc.com tools/cell-gen.cx -- --check
   sh ./unisacc.com tools/cell-gen.cx -- --write
   A cell is the os column, a slash, then the arch column, in file order.
   Exactly six data rows. A null out-pointer returns 4.
   An index outside 0..count-1 returns 2.
   The two-pointer targetname tables stay as they are.
   No libc and no include. */
#define TSV "exec/facts/pp-targets.tsv"
#define NTARGET 6
#define NAMEMAX 32
#define FILECAP 4096
#define CHECKCAP 4096

typedef struct {
    char os[NAMEMAX];
    char arch[NAMEMAX];
    char cell[NAMEMAX];
} Row;

static Row rows[NTARGET];
static int nrows;

static int fail(const char *why) {
    sy_eprintf("cell-gen\tFAIL\t%s\n", why);
    return 1;
}

static int ident(const char *s, int n) {
    int i;
    if (n < 1 || n >= NAMEMAX) return 0;
    if (!((s[0] >= 'a' && s[0] <= 'z') || s[0] == '_')) return 0;
    for (i = 1; i < n; i++) {
        char c = s[i];
        if (c >= 'a' && c <= 'z') continue;
        if (c >= '0' && c <= '9') continue;
        if (c == '_') continue;
        return 0;
    }
    return 1;
}

static void copy_field(char *dst, const char *s, int n) {
    int i;
    for (i = 0; i < n; i++) dst[i] = s[i];
    dst[n] = 0;
}

static int join_cell(char *dst, const char *os, const char *arch) {
    int n = 0;
    int i;
    for (i = 0; os[i]; i++) {
        if (n + 1 >= NAMEMAX) return -1;
        dst[n] = os[i];
        n++;
    }
    if (n + 1 >= NAMEMAX) return -1;
    dst[n] = '/';
    n++;
    for (i = 0; arch[i]; i++) {
        if (n + 1 >= NAMEMAX) return -1;
        dst[n] = arch[i];
        n++;
    }
    dst[n] = 0;
    return 0;
}

static int take_row(const char *line, int n) {
    const char *f[2];
    int len[2];
    int i, k, start;
    if (nrows >= NTARGET) return fail("cell-count");
    k = 0;
    start = 0;
    for (i = 0; i <= n; i++) {
        if (i == n || line[i] == '\t') {
            if (k >= 2) return fail("row-fields");
            f[k] = line + start;
            len[k] = i - start;
            k++;
            start = i + 1;
        }
    }
    if (k != 2) return fail("row-fields");
    if (!ident(f[0], len[0]) || !ident(f[1], len[1])) return fail("row-charset");
    copy_field(rows[nrows].os, f[0], len[0]);
    copy_field(rows[nrows].arch, f[1], len[1]);
    if (join_cell(rows[nrows].cell, rows[nrows].os, rows[nrows].arch))
        return fail("cell-fit");
    nrows++;
    return 0;
}

static int parse_tsv(char *b, size_t n) {
    size_t i = 0;
    int saw = 0;
    if (n == 0 || b[n - 1] != '\n') return fail("tsv-newline");
    while (i < n) {
        size_t e = i;
        while (e < n && b[e] != '\n') e++;
        b[e] = 0;
        if (e == i) return fail("tsv-blank");
        if (!saw) {
            if (!tx_eqz(b + i, "# os\tarch")) return fail("tsv-header");
            saw = 1;
        } else if (b[i] == '#') {
            return fail("tsv-comment");
        } else if (take_row(b + i, (int)(e - i))) {
            return 1;
        }
        i = e + 1;
    }
    if (nrows != NTARGET) return fail("cell-count");
    return 0;
}

static int unique_cells(void) {
    int i, j;
    for (i = 0; i < nrows; i++) {
        for (j = i + 1; j < nrows; j++) {
            if (tx_eqz(rows[i].cell, rows[j].cell)) return fail("cell-dup");
        }
    }
    return 0;
}

static int app(char *dst, int cap, int *n, const char *s) {
    int i = 0;
    while (s[i]) {
        if (*n + 1 >= cap) return -1;
        dst[*n] = s[i];
        *n += 1;
        i++;
    }
    dst[*n] = 0;
    return 0;
}

static int app_digit(char *dst, int cap, int *n, int d) {
    char s[2];
    if (d < 0 || d > 9) return -1;
    s[0] = (char)('0' + d);
    s[1] = 0;
    return app(dst, cap, n, s);
}

static int emit_mod(char *dst, int cap, const char *prefix) {
    int n = 0, i;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa module cellname\n")) return -1;
    if (app(dst, cap, &n, "/* Generated by tools/cell-gen.cx from exec/facts/pp-targets.tsv.\n")) return -1;
    if (app(dst, cap, &n, "   Do not edit by hand. One cell is os, a slash, then arch.\n")) return -1;
    if (app(dst, cap, &n, "   A null out-pointer returns 4. An index outside 0..count-1 returns 2.\n")) return -1;
    if (app(dst, cap, &n, "   No libc and no include. */\n")) return -1;
    if (app(dst, cap, &n, "int ")) return -1;
    if (app(dst, cap, &n, prefix)) return -1;
    if (app(dst, cap, &n, "_count(void) {\n    return ")) return -1;
    if (app_digit(dst, cap, &n, nrows)) return -1;
    if (app(dst, cap, &n, ";\n}\n")) return -1;
    if (app(dst, cap, &n, "int ")) return -1;
    if (app(dst, cap, &n, prefix)) return -1;
    if (app(dst, cap, &n, "_at(int index, const char **cell) {\n")) return -1;
    if (app(dst, cap, &n, "    if (!cell) return 4;\n")) return -1;
    for (i = 0; i < nrows; i++) {
        if (app(dst, cap, &n, "    if (index == ")) return -1;
        if (app_digit(dst, cap, &n, i)) return -1;
        if (app(dst, cap, &n, ") { *cell = \"")) return -1;
        if (app(dst, cap, &n, rows[i].cell)) return -1;
        if (app(dst, cap, &n, "\"; return 0; }\n")) return -1;
    }
    if (app(dst, cap, &n, "    return 2;\n}\n")) return -1;
    return n;
}

static int emit_check(char *dst, int cap) {
    int n = 0;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa use compiler.cellname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use runtime.cellname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use compiler.targetname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use runtime.targetname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use sys.io\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use text.text\n")) return -1;
    if (app(dst, cap, &n, "/* Generated by tools/cell-gen.cx. Narrow check of the six joined cells. */\n")) return -1;
    if (app(dst, cap, &n, "static int join_cell(char *dst, int cap, const char *os, const char *arch) {\n")) return -1;
    if (app(dst, cap, &n, "    int n = 0;\n    int i;\n")) return -1;
    if (app(dst, cap, &n, "    if (!dst || cap < 2 || !os || !arch) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    for (i = 0; os[i]; i++) {\n")) return -1;
    if (app(dst, cap, &n, "        if (n + 1 >= cap) return 1;\n")) return -1;
    if (app(dst, cap, &n, "        dst[n] = os[i];\n        n++;\n    }\n")) return -1;
    if (app(dst, cap, &n, "    if (n + 1 >= cap) return 1;\n    dst[n] = '/';\n    n++;\n")) return -1;
    if (app(dst, cap, &n, "    for (i = 0; arch[i]; i++) {\n")) return -1;
    if (app(dst, cap, &n, "        if (n + 1 >= cap) return 1;\n")) return -1;
    if (app(dst, cap, &n, "        dst[n] = arch[i];\n        n++;\n    }\n")) return -1;
    if (app(dst, cap, &n, "    dst[n] = 0;\n    return 0;\n}\n")) return -1;
    if (app(dst, cap, &n, "int main(void) {\n")) return -1;
    if (app(dst, cap, &n, "    const char *os; const char *arch; const char *ros; const char *rarch;\n")) return -1;
    if (app(dst, cap, &n, "    const char *cell; const char **missing; char buf[64]; int i;\n")) return -1;
    if (app(dst, cap, &n, "    missing = 0;\n")) return -1;
    if (app(dst, cap, &n, "    if (cel_count() != 6 || rcl_count() != 6) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (tn_count() != 6 || rtt_count() != 6) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    for (i = 0; i < 6; i++) {\n")) return -1;
    if (app(dst, cap, &n, "        if (tn_at(i, &os, &arch)) return 1;\n")) return -1;
    if (app(dst, cap, &n, "        if (rtt_at(i, &ros, &rarch)) return 1;\n")) return -1;
    if (app(dst, cap, &n, "        if (!tx_eqz(os, ros) || !tx_eqz(arch, rarch)) return 1;\n")) return -1;
    if (app(dst, cap, &n, "        if (join_cell(buf, 64, os, arch)) return 1;\n")) return -1;
    if (app(dst, cap, &n, "        if (cel_at(i, &cell) || !tx_eqz(cell, buf)) return 1;\n")) return -1;
    if (app(dst, cap, &n, "        if (rcl_at(i, &cell) || !tx_eqz(cell, buf)) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    }\n")) return -1;
    if (app(dst, cap, &n, "    if (cel_at(0, missing) != 4) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rcl_at(0, missing) != 4) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (cel_at(-1, &cell) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (cel_at(6, &cell) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rcl_at(-1, &cell) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rcl_at(6, &cell) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    sy_printf(\"CX_CELL\\tok=6\\tfailed=0\\n\");\n")) return -1;
    if (app(dst, cap, &n, "    return 0;\n}\n")) return -1;
    return n;
}

static int same_bytes(const char *a, size_t an, const char *b, int bn) {
    int i;
    if (an != (size_t)bn) return 0;
    for (i = 0; i < bn; i++) if (a[i] != b[i]) return 0;
    return 1;
}

static int one_file(int dowrite, const char *path, const char *body, int n) {
    size_t on = 0;
    char *cur;
    if (dowrite) {
        if (cx_write(path, body, (size_t)n)) return fail("write");
        return 0;
    }
    cur = cx_read(path, &on);
    if (!cur) return fail(path);
    if (!same_bytes(cur, on, body, n)) return fail(path);
    return 0;
}

int main(int argc, char **argv) {
    size_t nb = 0;
    char *b;
    char file[FILECAP], check[CHECKCAP];
    int dowrite, fn, cn;
    if (argc != 2 || (!tx_eqz(argv[1], "--check") && !tx_eqz(argv[1], "--write"))) {
        sy_eprintf("cell-gen\tusage\t--check|--write\n");
        return 2;
    }
    dowrite = tx_eqz(argv[1], "--write");
    b = cx_read(TSV, &nb);
    if (!b) return fail("tsv-read");
    if (parse_tsv(b, nb)) return 1;
    if (unique_cells()) return 1;
    cn = emit_check(check, CHECKCAP);
    if (cn < 0) return fail("emit-check");
    fn = emit_mod(file, FILECAP, "cel");
    if (fn < 0) return fail("emit-compiler");
    if (one_file(dowrite, "cx/compiler/cellname.cx", file, fn)) return 1;
    fn = emit_mod(file, FILECAP, "rcl");
    if (fn < 0) return fail("emit-runtime");
    if (one_file(dowrite, "cx/runtime/cellname.cx", file, fn)) return 1;
    if (one_file(dowrite, "tools/check-cx-cell.cx", check, cn)) return 1;
    if (dowrite) sy_printf("CELL_GEN\tWROTE\trows=%d\n", nrows);
    else sy_printf("CELL_GEN\tCHECK\trows=%d\n", nrows);
    return 0;
}
