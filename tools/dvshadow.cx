/* S2 shadow telemetry. Unified cgroup v2 only. On v1 the capacity verdict is UNMEASURED.
 * Phase one observes MemAvailable; memory.max/current and a reserved core belong to phase two. */
#pragma unisa use sys.fs
#pragma unisa use sys.time
#pragma unisa use text.text
#define DS_PATH 4096
#define DS_CPUS 8192
static char prefix[DS_PATH];
/* Read one field starting at column zero, or the first line of a scalar file. */
static int field(const char *name,const char *key,char *out,size_t cap){
    char path[DS_PATH],line[16384];size_t n=strlen(key);
    if(cx_fmt(path,sizeof path,"%s%s",prefix,name))return -1;
    FILE *f=fopen(path,"r");if(!f)return errno==ENOENT?-2:-1;
    int result=-1;
    while(fgets(line,sizeof line,f)){
        size_t len=strlen(line);if(!len||line[len-1]!='\n')break;
        if(len<=n||memcmp(line,key,n))continue;
        line[len-1]=0;char *p=line+n;while(*p==' '||*p=='\t')p++;
        if(tx_copy(out,cap,p,strlen(p))==0)result=0;
        break;
    }
    fclose(f);return result;
}
static int number(const char **pp,long *out){
    const char *p=*pp;long v=0;if(*p<'0'||*p>'9')return 0;
    while(*p>='0'&&*p<='9'){int d=*p++-'0';if(v>(LONG_MAX-d)/10)return 0;v=v*10+d;}
    *pp=p;*out=v;return 1;
}
static int cpus(const char *p,unsigned char *bits){
    while(*p){
        long a,b;if(!number(&p,&a))return 0;b=a;
        if(*p=='-'){p++;if(!number(&p,&b))return 0;}
        if(b<a||b>=DS_CPUS)return 0;
        for(long i=a;i<=b;i++)bits[i]=1;
        if(!*p)return 1;
        if(*p++!=','||!*p)return 0;
    }
    return 0;
}
static int safe_path(const char *s){
    if(*s!='/')return 0;
    for(const char *p=s;*p;p++){
        if(*p=='\\'||*p<' ')return 0;
        if(*p=='/' && p[1]=='.' && (!p[2]||p[2]=='/'||(p[2]=='.'&&(!p[3]||p[3]=='/'))))return 0;
    }
    return 1;
}
static int mount_for(const char *group,char *base,char *leaf){
    char path[DS_PATH],line[16384],root[DS_PATH],mount[DS_PATH];
    if(!safe_path(group)||cx_fmt(path,sizeof path,"%s/proc/self/mountinfo",prefix))return 0;
    FILE *f=fopen(path,"r");if(!f)return 0;int best=-1;
    while(fgets(line,sizeof line,f)){
        if(!strchr(line,'\n')||!strstr(line," - cgroup2 "))continue;
        if(sscanf(line,"%*s %*s %*s %4095s %4095s",root,mount)!=2||!safe_path(root)||!safe_path(mount))continue;
        int n=!strcmp(root,"/")?0:(int)strlen(root);
        if(n<=best||strncmp(group,root,n)||(group[n]&&group[n]!='/'))continue;
        if(cx_fmt(base,DS_PATH,"%s",mount)||cx_fmt(leaf,DS_PATH,"%s%s",mount,group[n]&&strcmp(group+n,"/")?group+n:""))continue;
        best=n;
    }
    fclose(f);return best>=0;
}
/* -2 is an explicitly unlimited cpu.max. -1 means unavailable or malformed. */
static long quota(const char *p){
    long q=0,period=0;int unlimited=!strncmp(p,"max ",4);
    if(unlimited)p+=3;else if(!number(&p,&q)||q<=0||q>LONG_MAX/1000)return -1;
    if(*p!=' '&&*p!='\t')return -1;while(*p==' '||*p=='\t')p++;
    if(!number(&p,&period)||period<=0||*p)return -1;
    return unlimited?-2:q*1000/period;
}
static void capacity(long *allowed,long *limit,unsigned char *effective){
    char group[DS_PATH],base[DS_PATH],dir[DS_PATH],path[DS_PATH],buf[16384];
    unsigned char aff[DS_CPUS]={0},set[DS_CPUS]={0};
    int affinity=!field("/proc/self/status","Cpus_allowed_list:",buf,sizeof buf)&&cpus(buf,aff);
    if(field("/proc/self/cgroup","0::",group,sizeof group)||!mount_for(group,base,dir))return;
    int set_ok=0,bad=0,seen=0;long bound=-2;
    for(;;){
        if(set_ok>=0){
            if(cx_fmt(path,sizeof path,"%s/cpuset.cpus.effective",dir))return;
            int rc=field(path,"",buf,sizeof buf);
            if(!rc){
                memset(set,0,sizeof set);set_ok=cpus(buf,set)?1:-1;
                for(int i=0;i<DS_CPUS;i++)aff[i]&=set[i];
            }else if(rc!=-2)set_ok=-1;
        }
        if(cx_fmt(path,sizeof path,"%s/cpu.max",dir))return;
        int rc=field(path,"",buf,sizeof buf);
        if(!rc){long v=quota(buf);seen=1;if(v==-1)bad=1;if(v>=0&&(bound<0||v<bound))bound=v;}
        else if(rc!=-2)bad=1;
        if(!strcmp(dir,base))break;
        char *end=strrchr(dir,'/');if(!end||end<=dir)return;*end=0;
    }
    if(affinity&&set_ok==1){
        *allowed=0;for(int i=0;i<DS_CPUS;i++)if(aff[i])(*allowed)++;
        if(effective)memcpy(effective,aff,sizeof aff);
    }
    if(seen&&!bad)*limit=bound;
}
static void metric(const char *key,long v){
    if(v==-2)printf("\t%s=max",key);else if(v<0)printf("\t%s=UNMEASURED",key);else printf("\t%s=%ld",key,v);
}
/* Read only visible processes; stat times exclude waited-for children. Count each
 * selected PID once even when the caller supplies nested managed roots. */
typedef struct {long pid,ppid,start,ticks,rss;int member;} Proc;
typedef struct {Proc p[4096];int n,tree_ok;long busy,total,ncpu;unsigned char mask[DS_CPUS];} Snapshot;
static Snapshot before,after;
static int proc_order(const void *a,const void *b){
    const Proc *x=a,*y=b;return (x->pid>y->pid)-(x->pid<y->pid);
}
static Proc *lookup(Snapshot *s,long pid){
    Proc key={0};key.pid=pid;return bsearch(&key,s->p,s->n,sizeof key,proc_order);
}
static int proc_entry(long pid,Proc *e){
    char path[128],buf[2048],rss[128];if(cx_fmt(path,sizeof path,"/proc/%ld/stat",pid))return 0;
    if(field(path,"",buf,sizeof buf))return 0;
    char *end=strrchr(buf,')');if(!end||end[1]!=' '||!end[2]||end[3]!=' ')return 0;
    char *p=end+4;long u=0,k=0;
    for(int i=4;i<=22;i++){
        char *tail=0;errno=0;long v=strtol(p,&tail,10);if(errno||tail==p||*tail!=' ')return 0;
        if(i==4)e->ppid=v;if(i==14)u=v;if(i==15)k=v;if(i==22)e->start=v;p=tail+1;
    }
    if(u<0||k<0||u>LONG_MAX-k||e->start<0)return 0;
    e->pid=pid;e->ticks=u+k;e->rss=-1;
    if(cx_fmt(path,sizeof path,"/proc/%ld/status",pid))return 0;
    if(!field(path,"VmRSS:",rss,sizeof rss)){
        const char *v=rss;long mem;if(number(&v,&mem)&&!strcmp(v," kB"))e->rss=mem;
    }
    return 1;
}
static void host_ticks(Snapshot *s){
    char path[DS_PATH],line[16384];long limit=-1;s->ncpu=-1;capacity(&s->ncpu,&limit,s->mask);
    s->total=-1;if(s->ncpu<=0||cx_fmt(path,sizeof path,"%s/proc/stat",prefix))return;
    FILE *f=fopen(path,"r");if(!f)return;
    long sum=0,active=0,seen=0;
    while(fgets(line,sizeof line,f)){
        if(strncmp(line,"cpu",3))continue;const char *p=line+3;long cpu;
        if(!number(&p,&cpu)||cpu>=DS_CPUS||!s->mask[cpu])continue;
        if(*p!=' ')break;
        long v[8];
        int i=0;for(;i<8;i++){while(*p==' ')p++;if(!number(&p,&v[i])||sum>LONG_MAX-v[i])break;sum+=v[i];if(i!=3&&i!=4)active+=v[i];}
        if(i!=8)break;seen++;
    }
    if(seen==s->ncpu){s->total=sum;s->busy=active;}fclose(f);
}
static int mark_roots(Snapshot *s,const char *roots){
    const char *p=roots;
    if(!strcmp(p,"self")){Proc *e=lookup(s,getpid());if(!e)return 0;e->member=1;return 1;}
    if(!strcmp(p,"-"))return 1;
    for(;;){
        long pid,start;if(!number(&p,&pid)||*p++!=':'||!number(&p,&start))return 0;
        Proc *e=lookup(s,pid);if(!e||e->start!=start)return 0;e->member=1;
        if(!*p)return 1;if(*p++!=',')return 0;
    }
}
static void snapshot(Snapshot *s,const char *dir,const char *roots){
    if(tx_copy(prefix,sizeof prefix,dir,strlen(dir)))return;
    host_ticks(s);
    char path[DS_PATH];if(cx_fmt(path,sizeof path,"%s/proc",prefix))return;
    DIR *d=opendir(path);if(!d)return;struct dirent *de;
    int complete=1;
    while((de=readdir(d))){
        const char *p=de->d_name;long pid;if(!number(&p,&pid)||*p)continue;
        if(s->n>=4096){complete=0;break;}
        if(proc_entry(pid,&s->p[s->n]))s->n++;
        else complete=0;
    }
    closedir(d);qsort(s->p,s->n,sizeof s->p[0],proc_order);
    if(!complete||!mark_roots(s,roots))return;
    for(int i=0;i<s->n;i++){
        Proc *e=&s->p[i];int depth=0;
        while(e&&!e->member&&e->ppid>0){if(++depth>128)return;e=lookup(s,e->ppid);}
        s->p[i].member=e&&e->member;
    }
    s->tree_ok=1;
}
static long observed_rss(Snapshot *s){
    if(!s->tree_ok)return -1;long kb=0;
    for(int i=0;i<s->n;i++)if(s->p[i].member){long v=s->p[i].rss;if(v<0||kb>LONG_MAX-v)return -1;kb+=v;}
    return kb;
}
static long managed_delta(Snapshot *a,Snapshot *b){
    if(!a->tree_ok||!b->tree_ok)return -1;
    long ticks=0;int n=0;
    for(int i=0;i<a->n;i++)if(a->p[i].member){
        Proc *old=&a->p[i],*newp=lookup(b,old->pid);
        if(!newp||!newp->member||old->start!=newp->start||old->ticks>newp->ticks)return -1;
        long dt=newp->ticks-old->ticks;if(ticks>LONG_MAX-dt)return -1;ticks+=dt;n++;
    }
    for(int i=0;i<b->n;i++)if(b->p[i].member)n--;
    return n==0?ticks:-1;
}
static int occupancy(int argc,char **argv){
    long t0,t1,estimate=-1;const char *roots;
    before.total=-1;after.total=-1;
    if(!strcmp(argv[1],"occupancy-replay")){
        if(argc!=8||!safe_path(argv[2])||!safe_path(argv[4]))return 2;
        const char *a=argv[3],*b=argv[5];if(!number(&a,&t0)||*a||!number(&b,&t1)||*b)return 2;
        roots=argv[6];snapshot(&before,argv[2],roots);snapshot(&after,argv[4],roots);
    }else{
        if(argc!=4)return 2;roots=argv[2];t0=sy_now_ms();snapshot(&before,"",roots);
        sy_sleep_ms(200);t1=sy_now_ms();snapshot(&after,"",roots);
    }
    const char *h=argv[argc-1];if(strcmp(h,"-")&&(!number(&h,&estimate)||*h))return 2;
    const char *why="ok";long host=-1,managed=-1,ext=-1;
    if(!t0)why="first-sample";else if(t1<=t0)why="invalid-interval";else if(t1-t0>2000)why="stale-interval";
    else if(before.total<0||after.total<0||memcmp(before.mask,after.mask,sizeof before.mask))why="host-sample-unavailable";
    else if(after.total<=before.total||after.busy<before.busy||after.busy-before.busy>after.total-before.total)why="counter-regressed";
    else{
        long total=after.total-before.total,used=after.busy-before.busy,ticks=managed_delta(&before,&after);
        host=(long)((double)used/total*before.ncpu*1000.0+0.5);
        if(ticks<0||ticks>used)why="tree-sample-incomplete";
        else{managed=(long)((double)ticks/total*before.ncpu*1000.0+0.5);ext=host-managed;}
    }
    printf("S2_OCCUPANCY");metric("host_busy_mcpu",host);metric("managed_mcpu",managed);metric("external_mcpu",ext);
    metric("rss_now_kb",observed_rss(&after));metric("rss_estimate_kb",estimate);
    printf("\treason=%s\tt0_ms=%ld\tt1_ms=%ld\n",why,t0,t1);return 0;
}
int main(int argc,char **argv){
    if(argc>=2&&(!strcmp(argv[1],"occupancy")||!strcmp(argv[1],"occupancy-replay")))return occupancy(argc,argv);
    if(argc<2||strcmp(argv[1],"sample"))return 2;
    long need=-1;
    for(int i=2;i<argc;i+=2){
        if(i+1>=argc)return 2;const char *p=argv[i+1];
        if(!strcmp(argv[i],"--root")){if(!safe_path(p)||tx_copy(prefix,sizeof prefix,p,strlen(p)))return 2;}
        else if(!strcmp(argv[i],"--need-kb")){if(!number(&p,&need)||*p)return 2;}
        else return 2;
    }
    long allowed=-1,limit=-1,cap=-1,mem=-1;char buf[128];
    capacity(&allowed,&limit,0);
    if(allowed>=0&&limit!=-1){cap=allowed*1000;if(limit>=0&&limit<cap)cap=limit;}
    if(!field("/proc/meminfo","MemAvailable:",buf,sizeof buf)){const char *p=buf;long v;if(number(&p,&v)&&!strcmp(p," kB"))mem=v;}
    printf("S2_CAPACITY");metric("allowed_cpus",allowed);metric("quota_mcpu",limit);metric("capacity_mcpu",cap);metric("mem_available_kb",mem);
    if(need>=0)printf("\twould_admit=%s\treason=%s",mem>=0&&need>mem?"no":"UNMEASURED",mem>=0&&need>mem?"insufficient-memory":"requires-occupancy");
    puts("");
    return 0;
}
