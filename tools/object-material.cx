/* prepare ROOT NEW_ABS_MATERIAL | --verify ROOT MATERIAL. Caller bound55.
 * Three actual product object compilations, each bound8, plus two bound8
 * source observations during preparation: explicit child budgets total40s.
 * PREPARED records content and provenance, never a functional test PASS.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use text.text
static char root[4096],mat[4096],product[4400],bound[4400],ident[4400],self[4096];
static const char *main_literal="extern int object_value; int main(void){return object_value;}\n";
static const char *value_literal="int object_value=7;\n";
static const char *leaves[]={"main.cx","value.cx","main-x86_64.o","value-x86_64.o","value-arm64.o"};
static void die(const char *s){fprintf(stderr,"object-material: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void path(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path bound");}
static char *load(const char *p,size_t *n){struct stat a,b;errno=0;if(lstat(p,&a))die(errno==ENOENT?"input absent":"input stat");if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>16777216)die("bounded regular input");int fd=open(p,O_RDONLY|O_NOFOLLOW|O_NONBLOCK|O_CLOEXEC);if(fd<0||fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size)die("input descriptor");*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s)die("allocation");size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("read extent");at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int bad=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(z||bad||closed)die("input changed");s[*n]=0;return s;}
static void digest(const char *p,char h[65]){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,h);free(s);}
static void save(const char *name,const char *s,size_t n){char p[4400];path(p,mat,name);int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive material output");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("material write");at+=(size_t)z;}int synced=fsync(fd),closed=close(fd);if(synced||closed)die("material close");}
static void row(np_buf *b,const char *k,const char *v){np_puts(b,k);np_puts(b,"\t");np_puts(b,v);np_puts(b,"\n");}
static np_result call(char **v,int seconds,const char *label,int evidence){if(unsetenv("UNISACC_RF_CAPTURE")||unsetenv("UNISA_ATTRIBUTES"))die("clear ambient resource state");char why[1024];np_result r;if(np_run(v,root,0,seconds+2,&r,why,sizeof why))die(why);if(evidence){char name[100],status[40];snprintf(name,sizeof name,"%s.stdout",label);save(name,r.out,r.outn);snprintf(name,sizeof name,"%s.stderr",label);save(name,r.err,r.errn);int n=snprintf(status,sizeof status,"rc\t%d\n",r.rc);snprintf(name,sizeof name,"%s.status",label);save(name,status,(size_t)n);}return r;}
static void source(char h[65],const char *label,int evidence){char *v[]={bound,"8","sh",product,ident,"--",root,0};np_result r=call(v,8,label,evidence);int ok=!r.rc&&!r.errn&&r.outn==65&&r.out[64]=='\n';if(ok){memcpy(h,r.out,64);h[64]=0;for(int i=0;i<64;i++)if(!((h[i]>='0'&&h[i]<='9')||(h[i]>='a'&&h[i]<='f')))ok=0;}if(!ok&&r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);if(!ok)die("source identity");}
static void literal(const char *name,const char *expected){char p[4400];size_t n;path(p,mat,name);char *s=load(p,&n);int ok=n==strlen(expected)&&!memcmp(s,expected,n);free(s);if(!ok)die("literal source changed");}
static np_buf record(const char *source_sha){np_buf b={0};char h[65],p[4400];np_puts(&b,"objects-material-v1\nstatus\tPREPARED\nscope\tthree-product-Linux-unit-objects-no-test-result\n");row(&b,"source",source_sha);digest(product,h);row(&b,"product",h);digest(self,h);row(&b,"tool",h);path(p,root,"tools/cxlib/netpack.cx");digest(p,h);row(&b,"module-netpack",h);row(&b,"flags","-O2 -c -funit -b TARGET");row(&b,"targets","main=lnx/x86_64,value=lnx/x86_64,value=lnx/arm64");literal("main.cx",main_literal);literal("value.cx",value_literal);for(int i=0;i<5;i++){path(p,mat,leaves[i]);digest(p,h);row(&b,leaves[i],h);}return b;}
static void stable_record(const np_buf *before,const char *sid){np_buf after=record(sid);int ok=before->n==after.n&&!memcmp(before->p,after.p,before->n);free(after.p);if(!ok)die("material or construction inputs changed");}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN object-material draft requires Linux/x86_64 host\n",stderr);return 3;
#endif
 int verify=argc==4&&tx_eq(argv[1], "--verify", 1L << 20);if(argc!=4||(!verify&&!tx_eq(argv[1], "prepare", 1L << 20))||!realpath(argv[2],root)||argv[3][0]!='/'||strlen(argv[3])>=sizeof mat||strpbrk(argv[3],"\t\r\n")||!realpath(__FILE__,self))die("usage prepare ROOT NEW_ABS_MATERIAL | --verify ROOT MATERIAL");strcpy(mat,argv[3]);path(product,root,"unisacc.com");path(bound,root,"tools/bound");path(ident,root,"seed/ident.c");char before_source[65],after_source[65];
 if(verify){struct stat st;if(lstat(mat,&st)||!S_ISDIR(st.st_mode))die("material must be a real directory");source(before_source,"verify-source",0);np_buf expected=record(before_source);char p[4400];size_t n;path(p,mat,"material.tsv");char *s=load(p,&n);int ok=n==expected.n&&!memcmp(s,expected.p,n);free(s);if(!ok)die("material receipt mismatch");stable_record(&expected,before_source);source(after_source,"verify-source-after",0);if(!tx_eq(before_source, after_source, 1L << 20))die("source changed during verification");stable_record(&expected,after_source);s=load(p,&n);ok=n==expected.n&&!memcmp(s,expected.p,n);free(s);if(!ok)die("material receipt changed during verification");free(expected.p);puts("VERIFIED\tobjects-material\tno-test-result");return 0;}
 if(mkdir(mat,0700))die("new material directory required");save("main.cx",main_literal,strlen(main_literal));save("value.cx",value_literal,strlen(value_literal));source(before_source,"source-before",1);char product_before[65],tool_before[65],module_before[65],p[4400],after[65];digest(product,product_before);digest(self,tool_before);path(p,root,"tools/cxlib/netpack.cx");digest(p,module_before);for(int i=0;i<3;i++){char input[4400],output[4400],label[80];path(input,mat,i?"value.cx":"main.cx");path(output,mat,leaves[i+2]);struct stat st;errno=0;if(!lstat(output,&st)||errno!=ENOENT)die("object output must be absent");char *v[]={bound,"8","sh",product,"-O2","-c","-funit","-b",i==2?"lnx/arm64":"lnx/x86_64",input,"-o",output,0};snprintf(label,sizeof label,"compile-%d",i);np_buf cmd={0};for(int j=0;v[j];j++){char arg[40];snprintf(arg,sizeof arg,"arg-%d",j);row(&cmd,arg,v[j]);}char name[100];snprintf(name,sizeof name,"%s.argv.tsv",label);save(name,cmd.p,cmd.n);free(cmd.p);np_result r=call(v,8,label,1);int ok=!r.rc&&!r.outn&&!r.errn;if(!ok&&r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);if(!ok)die("actual product object compilation failed");}
 np_buf expected=record(before_source);source(after_source,"source-after",1);if(!tx_eq(before_source, after_source, 1L << 20))die("source changed during preparation");digest(product,after);if(!tx_eq(after, product_before, 1L << 20))die("product changed during preparation");digest(self,after);if(!tx_eq(after, tool_before, 1L << 20))die("tool changed during preparation");path(p,root,"tools/cxlib/netpack.cx");digest(p,after);if(!tx_eq(after, module_before, 1L << 20))die("module changed during preparation");stable_record(&expected,after_source);save("material.tsv",expected.p,expected.n);free(expected.p);puts("PREPARED\tobjects-material\tno-test-result");return 0;
}
