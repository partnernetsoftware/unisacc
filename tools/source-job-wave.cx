/* Reusable formal source-package waves on the declared Linux/x86_64 host.
   ROOT CTX BUILD host|list|wave|final [tool|gen|tbl|net FIRST COUNT ACTION]
   ACTION is start-job or finish-job, COUNT1..4. Each call needs its own
   tools/bound58 (hard60); never wrap the entire131-job sequence in one call.
   Run all five tools, then42 gen,42 tbl,42 net, respecting start/finish order.
   BUILD must be fresh, containing the product-built source-package-O2.elf
   and immutable saved bootstrap/build record at the historical filenames
   Root41-bootstrap.com[.build.json]. Those names do not assert identity:
   actual bytes are recorded. The caller saves the actual compile output;
   compile-controller.argv.tsv below declares the expected build invocation.
   host records the explicit distro zlib paths/environment; list initializes
   the exclusive outer directory. Existing foundation owns every dependency
   and byte check and formal record. No result cache or qualification grant. */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.kernelsha
#pragma unisa use text.text
/* Concurrency ceiling and fallback live in exec/facts/limits.tsv, so the number exists once. */
#define WAVE_JOBS_MAX 16
#define WAVE_JOBS_FALLBACK 4
static int wave_jobs(void) {
    char *v[] = {"nproc", 0};
    np_result r = {0};
    char why[256] = {0};
    int n = WAVE_JOBS_FALLBACK;
    if (!np_run(v, 0, 0, 5, &r, why, sizeof why) && r.rc == 0 && r.outn > 0) {
        long got = strtol(r.out, 0, 10);
        if (got >= 1 && got <= 4096) n = (int)got;
    }
    np_free(&r);
    return n > WAVE_JOBS_MAX ? WAVE_JOBS_MAX : n;
}
static char root[4096],ctx[4400],build[4400],controller[4400],bound[4400],outer[4400],ids[131][128],library_env[4600];
static int nids;
/* Reuse is DISABLED unless UNISACC_WAVE_REUSE=1: the recorded identity does not
 * cover every file a job reads yet (SPEED-02), so reuse may carry stale bytes. */
static int reuse_enabled(void){const char *s=getenv("UNISACC_WAVE_REUSE");return s&&!strcmp(s,"1");}
static void die(const char *s){fprintf(stderr,"source-wave: %s errno=%d\n",s,errno);exit(2);}
static void checked(int n){if(n<0)die("format");}
static void path(char p[4400],const char *a,const char *b){if(cx_path_join(p,4400,a,b))die("path");}
static char *load(const char *p,size_t *n){char *s=cx_read(p,n);if(!s)die(p);return s;}
static void save(const char *p,const char *s,size_t n){int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive outer output");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("write");at+=(size_t)z;}int synced=fsync(fd),closed=close(fd);if(synced||closed)die("sync/close");}
static long long now(void){long t[2]={0};if(__syscall6(228,1,(long)t,0,0,0)||t[0]<0||t[1]<0||t[1]>=1000000000L||t[0]>(LLONG_MAX-t[1])/1000000000LL)die("monotonic clock");return t[0]*1000000000LL+t[1];}
static void evidence(const char *label,const char *suffix,const char *s,size_t n){char p[4400];checked(cx_fmt(p,sizeof p,"%s/%s.%s",outer,label,suffix));save(p,s,n);}
static int call(const char *action,const char *id,const char *label){
 if(id&&(tx_eqz(action,"start-job")||tx_eqz(action,"finish-job"))){
  char rec[4400];struct stat st;
  if(!cx_fmt(rec,sizeof rec,"%s/jobs/%s/record.tsv",ctx,id)&&!lstat(rec,&st)&&S_ISREG(st.st_mode)&&st.st_size>0){
   printf("SKIP_COMPLETE\t%s\t%s\n",action,id);return 0;
  }
 }
 char *v[]={bound,"55",controller,(char *)action,root,ctx,(char *)id,0};if(!id)v[6]=0;
 np_buf argv={0};for(int i=0;v[i];i++){np_putll(&argv,i);np_puts(&argv,"\t");np_puts(&argv,v[i]);np_puts(&argv,"\n");}evidence(label,"argv.tsv",argv.p,argv.n);free(argv.p);
 char *environment[]={"CPATH=/usr/include/node",library_env,0};np_buf env={0};np_puts(&env,environment[0]);np_puts(&env,"\n");np_puts(&env,environment[1]);np_puts(&env,"\n");evidence(label,"env",env.p,env.n);free(env.p);
 np_result r={0};char why[1500]={0};long long begin=now();int transport=np_run(v,root,environment,58,&r,why,sizeof why);long long elapsed=now()-begin;
 evidence(label,"stdout",r.out,r.outn);evidence(label,"stderr",r.err,r.errn);if(transport)evidence(label,"error",why,strlen(why));
 char s[180];checked(cx_fmt(s,sizeof s,"transport\t%d\nrc\t%d\nelapsed_ns\t%lld\n",transport,r.rc,elapsed));evidence(label,"status",s,strlen(s));
 printf("%s transport=%d rc=%d wall_ns=%lld\n",label,transport,r.rc,elapsed);if((transport||r.rc)&&r.errn)fwrite(r.err,1,r.errn,stderr);int bad=transport?3:r.rc?1:0;np_free(&r);return bad;
}
/* Reuse probe: for each job of PHASE ask the controller whether its recorded
 * identity still matches the live inputs. Prints one line per job, "REUSE HIT"
 * or "REUSE MISS <id>" on stdout, and never touches BUILD or OUT. A caller that
 * sees only HIT lines knows the whole phase is already up to date and no job
 * command needs to run. */
/* One-process batch reuse: every job of PHASE is decided inside a single
 * controller process (reuse-batch IDLIST), so the context is verified once and
 * a path shared by many jobs is hashed once. Reuse stays opt-in. */
static void reuse_phase(const char *phase){
 char p[4400],prefix[20];np_buf list={0};int fd;size_t at=0;
 if(!reuse_enabled())die("reuse-disabled-set-UNISACC_WAVE_REUSE=1");
 enumerate();checked(cx_fmt(prefix,sizeof prefix,"%s-",phase));
 for(int i=0;i<nids;i++)if(!strncmp(ids[i],prefix,strlen(prefix))){np_puts(&list,ids[i]);np_puts(&list,"\n");}
 if(!list.n)die("phase extent");
 checked(cx_fmt(p,sizeof p,"%s/reuse-batch.ids",outer));if(unlink(p)&&errno!=ENOENT)die("reuse-id-list-unlink");
 fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);
 if(fd<0)die("reuse-id-list");
 while(at<list.n){ssize_t z=write(fd,list.p+at,list.n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("reuse-id-write");at+=(size_t)z;}
 if(fsync(fd)||close(fd))die("reuse-id-close");
 free(list.p);
 { char *v[]={bound,"55",controller,"reuse-batch",root,ctx,p,0};
   np_result r={0};char why[1500]={0};char *env[]={"CPATH=/usr/include/node",library_env,0};
   long long begin=now();
   int transport=np_run(v,root,env,58,&r,why,sizeof why);
   long long elapsed=now()-begin;
   if(r.outn)fwrite(r.out,1,r.outn,stdout);
   if(transport||r.rc){if(r.errn)fwrite(r.err,1,r.errn,stderr);}
   printf("REUSE_BATCH\t%s\ttransport=%d\trc=%d\twall_ns=%lld\n",phase,transport,r.rc,elapsed);
   np_free(&r);
   if(transport||r.rc)die("reuse-batch-failed"); }
}
static void reuse(const char *phase,int first,int count){
 if(!reuse_enabled())die("reuse-disabled-set-UNISACC_WAVE_REUSE=1");if(count<1||count>WAVE_JOBS_MAX)die("concurrency-out-of-range");enumerate();char prefix[20];checked(cx_fmt(prefix,sizeof prefix,"%s-",phase));int selected[131],n=0;for(int i=0;i<nids;i++)if(!strncmp(ids[i],prefix,strlen(prefix)))selected[n++]=i;if(first+count>n)die("phase extent");
 int hits=0;for(int j=0;j<count;j++){const char *id=ids[selected[first+j]];char *v[]={bound,"55",controller,"reuse-job",root,ctx,(char *)id,0};
  np_result r={0};char why[1500]={0};char *environment[]={"CPATH=/usr/include/node",library_env,0};int transport=np_run(v,root,environment,58,&r,why,sizeof why);
  if(transport||r.rc){if(r.errn)fwrite(r.err,1,r.errn,stderr);printf("REUSE\tMISS\t%s\n",id);}
  else {hits++;printf("REUSE\tHIT\t%s\n",id);}
  np_free(&r);}
 printf("REUSE_PHASE\t%s\tfirst=%d\tcount=%d\thits=%d\n",phase,first,count,hits);
}
static void enumerate(void){
 char p[4400];path(p,outer,"list.stdout");{struct stat ls;if(lstat(p,&ls)&&errno==ENOENT)die("no outer/list.stdout: run 'list' (after 'host') on this BUILD first");}size_t n;char *s=load(p,&n);if(memchr(s,0,n)||!n||s[n-1]!=10)die("list wire");
 for(char *line=s;*line;){char *end=strchr(line,'\n');if(!end)die("list LF");*end=0;char *tab=strchr(line,'\t');if(tab){*tab=0;char *state_end=strchr(tab+1,'\t');if(state_end)*state_end=0;if(tx_eqz(tab+1, "IMPLEMENTED_DRAFT_NOT_RUN")){if(nids>=131||strlen(line)>=sizeof ids[0])die("job count/name");for(int i=0;i<nids;i++)if(tx_eqz(ids[i], line))die("duplicate job");{if(cx_fmt(ids[nids],sizeof ids[nids],"%s",line))die("job count/name");nids++;}}}line=end+1;}free(s);
 int counts[4]={0};const char *prefix[]={"tool-","gen-","tbl-","net-"};for(int i=0;i<nids;i++){int found=0;for(int k=0;k<4;k++)if(!strncmp(ids[i],prefix[k],strlen(prefix[k]))){counts[k]++;found++;}if(found!=1)die("unknown job phase");}
 if(nids!=131||counts[0]!=5||counts[1]!=42||counts[2]!=42||counts[3]!=42)die("authoritative 131 inventory");
}
static void hashrow(np_buf *b,const char *p){size_t n;char *s=load(p,&n),sha[65];if(n>=1024){if(ks_sha256_hex(s,n,sha))die("AF_ALG digest");}else cx_sha256_hex(s,n,sha);free(s);np_puts(b,p);np_puts(b,"\t");np_putll(b,n);np_puts(b,"\t");np_puts(b,sha);np_puts(b,"\n");}
static void host_libz(void){char dir[4400],link[4400];path(dir,build,"host-libz");if(mkdir(dir,0700))die("exclusive host-libz directory");path(link,dir,"libz.so");const char *target="/usr/lib/x86_64-linux-gnu/libz.so.1.2.11";if(symlink(target,link))die("exclusive pinned libz symlink");np_buf b={0};np_puts(&b,"CPATH=/usr/include/node\n");np_puts(&b,library_env);np_puts(&b,"\nlibz.so-target\t");np_puts(&b,target);np_puts(&b,"\n# host CC/subtools/system headers/linker/libraries remain DECLARED nonhermetic\n");hashrow(&b,"/usr/include/node/zlib.h");hashrow(&b,"/usr/include/node/zconf.h");hashrow(&b,target);hashrow(&b,link);char p[4400];path(p,build,"host-inputs.tsv");save(p,b.p,b.n);free(b.p);puts("PREPARED explicit pinned host zlib environment");}
static void record_controller(void){
 np_buf b={0};np_puts(&b,"# Declared unchanged-source -O2 build; actual compiler evidence belongs to caller\n# path\tbytes\tsha256\n");char p[4400];const char *source[]={"tools/source-package.cx","tools/cxlib/netpack.cx","tools/cxlib/kernelsha.cx","unisacc.com","unisacc.com.build.json"};for(int i=0;i<5;i++){path(p,root,source[i]);hashrow(&b,p);}hashrow(&b,controller);path(p,build,"Root41-bootstrap.com");hashrow(&b,p);path(p,build,"Root41-bootstrap.com.build.json");hashrow(&b,p);path(p,build,"controller-identities.tsv");save(p,b.p,b.n);free(b.p);
 np_buf a={0};const char *parts[]={bound,"55","sh",0,"-O2",0,"-o",controller};char bootstrap[4400],sourcepath[4400];path(bootstrap,build,"Root41-bootstrap.com");path(sourcepath,root,"tools/source-package.cx");parts[3]=bootstrap;parts[5]=sourcepath;for(int i=0;i<8;i++){np_putll(&a,i);np_puts(&a,"\t");np_puts(&a,parts[i]);np_puts(&a,"\n");}path(p,build,"compile-controller.argv.tsv");save(p,a.p,a.n);free(a.p);
}
static int number(const char *s){char *end;long n=strtol(s,&end,10);if(!s[0]||*end||n<0||n>131)die("number");return (int)n;}
static void wave(const char *phase,int first,int count,const char *action){
 if(!tx_eqz(action, "start-job")&&!tx_eqz(action, "finish-job"))die("start/finish action");if(count<1||count>WAVE_JOBS_MAX)die("concurrency-out-of-range");enumerate();char prefix[20];checked(cx_fmt(prefix,sizeof prefix,"%s-",phase));int selected[131],n=0;for(int i=0;i<nids;i++)if(!strncmp(ids[i],prefix,strlen(prefix)))selected[n++]=i;if(first+count>n)die("phase extent");
 pid_t *pids=calloc((size_t)count,sizeof *pids);if(!pids)die("allocation");fflush(stdout);for(int j=0;j<count;j++){const char *id0=ids[selected[first+j]];if(!strcmp(action,"start-job")&&reuse_enabled()){char *rv[]={bound,"55",controller,"reuse-job",root,ctx,(char *)id0,0};np_result rr={0};char why2[1500]={0};char *renv[]={"CPATH=/usr/include/node",library_env,0};int tr=np_run(rv,root,renv,58,&rr,why2,sizeof why2);int hit=!tr&&!rr.rc;if(rr.errn)fwrite(rr.err,1,rr.errn,stderr);np_free(&rr);if(hit){printf("REUSED\t%s\tidentity-and-bytes-verified\n",id0);continue;}}pids[j]=fork();if(pids[j]<0)die("fork");if(!pids[j]){const char *id=ids[selected[first+j]];char label[180];checked(cx_fmt(label,sizeof label,"%s-%s",action,id));exit(call(action,id,label));}}
 int bad=0;for(int j=0;j<count;j++){if(pids[j]<=0)continue;int st;pid_t p;do{p=waitpid(pids[j],&st,0);}while(p<0&&errno==EINTR);if(p!=pids[j]||!WIFEXITED(st)||WEXITSTATUS(st)){bad++;printf("UNKNOWN_OR_FAILED %s %s wait_status=%d\n",action,ids[selected[first+j]],p==pids[j]?st:-1);}}if(bad)die("wave failed; raw outputs retained");printf("WAVE phase=%s first=%d count=%d action=%s all_outer_rc0\n",phase,first,count,action);
}
static void success(const char *label){char p[4400];checked(cx_fmt(p,sizeof p,"%s/%s.status",outer,label));size_t n;char *s=load(p,&n);if(strncmp(s,"transport\t0\nrc\t0\n",17))die("UNKNOWN/nonzero outer status");free(s);}
static void final(void){
 enumerate();if(call("--verify-context",0,"verify-final"))die("final context verification");np_buf b={0};np_puts(&b,"# actual start/finish outer statuses, command status and formal record required\n# job\tstart_outer_rc\tfinish_outer_rc\tcommand_rc\trecord\n");
 for(int i=0;i<nids;i++){char label[180],p[4400];checked(cx_fmt(label,sizeof label,"start-job-%s",ids[i]));success(label);checked(cx_fmt(label,sizeof label,"finish-job-%s",ids[i]));success(label);checked(cx_fmt(p,sizeof p,"%s/jobs/%s/command.status",ctx,ids[i]));size_t n;char *s=load(p,&n);if(n!=5||memcmp(s,"rc\t0\n",5))die("actual job command status");free(s);checked(cx_fmt(p,sizeof p,"%s/jobs/%s/record.tsv",ctx,ids[i]));struct stat st;if(lstat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<=0)die("formal record absent");np_puts(&b,ids[i]);np_puts(&b,"\t0\t0\t0\t");np_puts(&b,p);np_puts(&b,"\n");}
 char jobs[4400];path(jobs,ctx,"jobs");DIR *d=opendir(jobs);if(!d)die("jobs directory");int actual=0;for(;;){errno=0;struct dirent *e=readdir(d);if(!e){int er=errno;if(closedir(d)||er)die("jobs iteration");break;}if(!tx_eqz(e->d_name, ".")&&!tx_eqz(e->d_name, ".."))actual++;}if(actual!=131)die("formal job directory count");
 char p[4400];path(p,build,"job-outer-statuses.tsv");save(p,b.p,b.n);free(b.p);puts("PREPARED formal source context and131 jobs; all actual start/finish/command statuses0; no PC/GEN/install/package/test qualification");
}
int main(int argc,char **argv){
 if(argc<5||!realpath(argv[1],root)||!realpath(argv[2],ctx)||!realpath(argv[3],build))die("ROOT CTX BUILD host|list|wave|final [phase first count start-job|finish-job]");path(controller,build,"source-package-O2.elf");path(bound,root,"tools/bound");path(outer,build,"outer");checked(cx_fmt(library_env,sizeof library_env,"LIBRARY_PATH=%s/host-libz",build));
 if(argc==5&&tx_eqz(argv[4], "host"))host_libz();
 else if(argc==5&&tx_eqz(argv[4], "list")){if(mkdir(outer,0700))die("fresh outer directory");record_controller();if(call("--list",0,"list"))die("authoritative list failed");enumerate();printf("LIST authoritative_jobs=%d tools=5 gen=42 tbl=42 net=42\n",nids);}
 else if(argc==9&&tx_eqz(argv[4], "wave"))wave(argv[5],number(argv[6]),number(argv[7]),argv[8]);
 else if(argc==8&&tx_eqz(argv[4], "reuse")){reuse(argv[5],number(argv[6]),number(argv[7]));}
 else if(argc==6&&tx_eqz(argv[4], "reuse-batch")){reuse_phase(argv[5]);}
 else if(argc==5&&tx_eqz(argv[4], "final"))final();else die("arguments");return 0;
}
