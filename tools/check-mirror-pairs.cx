/* Checks that assertions kept in several platform copies stay aligned:
   sh ./unisacc.com tools/check-mirror-pairs.cx [-- --staged PATH...]   (from the repo root)
   Root cause it guards (2026-11-17): 55cc27a7e8 moved the product default to O1; f86aa982b3 gave only the
   lnx copy (tests/check-stream-pipe.cx) explicit -O0 on its reference compiles, the Windows copy
   tests/win-portable-cell.ps1 was missed and release CI went red 25 hours later (fixed in 5493e53e4c).
   tests/mirror-pairs.tsv lists, per assertion marker, an anchor for each side.  fileA (.cx) side: the line
   holding sp_ref(" and anchorA; flags are the space tokens of the first string argument.  fileB (.ps1)
   side: the line holding anchorB; flags are the quoted array items after @( that start with '-'.
   Each marker must give the same flag set on both sides, else FAIL with both files and lines.
   Negative control: a temporary copy of fileB with the first '-O0', removed from marker B's line must
   make the comparison fail (the real file is not touched).
   --staged PATH...: given staged paths, print MIRROR_WARN for a pair with only one side staged (rc 0).
   Prints PASS/FAIL lines and CHECK_MIRROR_PAIRS<TAB>failed=N. */
#pragma unisa use sys.fs
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use text.text
#pragma unisa use sys.env
#pragma unisa use sys.posix

#define MP_MAX 64
#define MP_TOK 32

typedef struct { char group[64], fa[256], fb[256], mk[16], aa[128], ab[128]; } mp_row;
static mp_row rows[MP_MAX];
static int nrows;
static int failed;

/* bounded substring search inside one line [s, s+n) */
static long mp_find(const char *s, long n, const char *pat) {
    long m = (long)tx_len(pat, 256), i;
    if (m == 0 || m > n) return -1;
    for (i = 0; i + m <= n; i++) if (mm_cmp(s + i, pat, (size_t)m) == 0) return i;
    return -1;
}

static void mp_cpy(char *d, size_t cap, const char *s, long n) {
    if (n < 0) n = 0;
    if ((size_t)n >= cap) n = (long)cap - 1;
    mm_copy(d, cap, s, (size_t)n);
    d[n] = 0;
}

static int load_rows(const char *path) {
    unsigned char *b;
    int64_t n, i = 0;
    int line = 0;
    if (sy_read_file(path, &b, &n, 1 << 20) != 0) return -1;
    while (i < n) {
        int64_t e = i, c;
        const char *f[7];
        long fl[7];
        int k = 0;
        while (e < n && b[e] != '\n') e++;
        f[0] = (const char *)b + i;
        for (c = i; c < e && k < 7; c++) {
            if (b[c] == '\t') { fl[k] = (long)((const char *)b + c - f[k]); k++; if (k < 7) f[k] = (const char *)b + c + 1; }
        }
        if (k < 7) { fl[k] = (long)((const char *)b + e - f[k]); k++; }
        if (line++ > 0 && k >= 6 && nrows < MP_MAX) {
            mp_row *r = &rows[nrows++];
            mp_cpy(r->group, sizeof r->group, f[0], fl[0]);
            mp_cpy(r->fa, sizeof r->fa, f[1], fl[1]);
            mp_cpy(r->fb, sizeof r->fb, f[2], fl[2]);
            mp_cpy(r->mk, sizeof r->mk, f[3], fl[3]);
            mp_cpy(r->aa, sizeof r->aa, f[4], fl[4]);
            mp_cpy(r->ab, sizeof r->ab, f[5], fl[5]);
        }
        i = e + 1;
    }
    mm_free(b);
    return 0;
}

typedef struct { char t[MP_TOK][24]; int n; int line; } mp_set;

static void set_add(mp_set *s, const char *p, long n) {
    int i;
    char w[24];
    if (n <= 0 || p[0] != '-' || s->n >= MP_TOK) return;
    mp_cpy(w, sizeof w, p, n);
    for (i = 0; i < s->n; i++) if (tx_eqz(s->t[i], w)) return;
    mm_copy(s->t[s->n], sizeof s->t[0], w, (size_t)tx_len(w, sizeof w) + 1);
    s->n++;
}

/* side 0: .cx sp_ref line; side 1: .ps1 array line.  0 found, -1 no line, -2 unreadable. */
static int extract(const char *path, int side, const char *anchor, mp_set *s) {
    unsigned char *b;
    int64_t n, i = 0;
    int line = 0, hit = -1;
    s->n = 0;
    s->line = 0;
    if (sy_read_file(path, &b, &n, 8 << 20) != 0) return -2;
    while (i < n && hit < 0) {
        int64_t e = i;
        const char *L = (const char *)b + i;
        long ln, a, p, j;
        while (e < n && b[e] != '\n') e++;
        ln = (long)(e - i);
        line++;
        if (mp_find(L, ln, anchor) >= 0) {
            if (side == 0 && (a = mp_find(L, ln, "sp_ref(\"")) >= 0) {
                p = a + 8;
                j = p;
                while (j < ln && L[j] != '"') j++;
                while (p < j) {
                    long q = p;
                    while (q < j && L[q] != ' ') q++;
                    set_add(s, L + p, q - p);
                    p = q + 1;
                }
                hit = line;
            } else if (side == 1 && (a = mp_find(L, ln, "@(")) >= 0) {
                p = a + 2;
                while (p < ln && L[p] != ')') {
                    if (L[p] == '\'') {
                        long q = p + 1;
                        while (q < ln && L[q] != '\'') q++;
                        set_add(s, L + p + 1, q - p - 1);
                        p = q + 1;
                    } else p++;
                }
                hit = line;
            }
        }
        i = e + 1;
    }
    mm_free(b);
    s->line = hit > 0 ? hit : 0;
    return hit > 0 ? 0 : -1;
}

static int same_set(const mp_set *x, const mp_set *y) {
    int i, j, f;
    if (x->n != y->n) return 0;
    for (i = 0; i < x->n; i++) {
        for (f = 0, j = 0; j < y->n; j++) if (tx_eqz(x->t[i], y->t[j])) f = 1;
        if (!f) return 0;
    }
    return 1;
}

static void show(const mp_set *s) {
    int i;
    for (i = 0; i < s->n; i++) printf("%s%s", i ? "," : "", s->t[i]);
    if (s->n == 0) printf("-");
}

/* compare every row; FB_OVERRIDE replaces fileB when non-null.  QUIET suppresses PASS lines.
   Returns the number of mismatching or missing markers. */
static int compare_all(const char *fb_override, int quiet, const char *tag) {
    int r, bad = 0;
    for (r = 0; r < nrows; r++) {
        mp_set a, b;
        const char *fb = fb_override ? fb_override : rows[r].fb;
        int ra = extract(rows[r].fa, 0, rows[r].aa, &a);
        int rb = extract(fb, 1, rows[r].ab, &b);
        if (ra != 0 || rb != 0 || !same_set(&a, &b)) {
            bad++;
            if (quiet) continue;
            printf("FAIL\t%s\t%s/%s\t%s:%d\t", tag, rows[r].group, rows[r].mk, rows[r].fa, a.line);
            show(&a);
            printf("\t%s:%d\t", fb, b.line);
            show(&b);
            printf("\n");
        } else if (!quiet) {
            printf("PASS\t%s\t%s/%s\t%s:%d\t%s:%d\t", tag, rows[r].group, rows[r].mk, rows[r].fa, a.line, fb, b.line);
            show(&a);
            printf("\n");
        }
    }
    return bad;
}

/* writes a copy of PATH with the first "'-O0'," on the line holding ANCHOR removed; 0 when removed */
static int make_negative(const char *path, const char *anchor, const char *out) {
    unsigned char *b;
    int64_t n, i = 0;
    int rc = -1;
    if (sy_read_file(path, &b, &n, 8 << 20) != 0) return -1;
    while (i < n && rc != 0) {
        int64_t e = i;
        long ln, a, k;
        while (e < n && b[e] != '\n') e++;
        ln = (long)(e - i);
        if (mp_find((const char *)b + i, ln, anchor) >= 0 && (k = mp_find((const char *)b + i, ln, "'-O0',")) >= 0) {
            a = (long)i + k;
            unsigned char *o = mm_alloc((long)n);
            if (o) {
                mm_copy(o, (size_t)n, b, (size_t)a);
                mm_copy(o + a, (size_t)(n - a), b + a + 6, (size_t)(n - a - 6));
                if (sy_write_file(out, o, n - 6, 0644) == 0) rc = 0;
                mm_free(o);
            }
        }
        i = e + 1;
    }
    mm_free(b);
    return rc;
}

static void ck(int ok, const char *what) {
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", what);
    if (!ok) failed++;
}

int main(int argc, char **argv) {
    char neg[4096];
    int i, r;
    if (load_rows("tests/mirror-pairs.tsv") != 0 || nrows == 0) {
        printf("FAIL\tload tests/mirror-pairs.tsv\nCHECK_MIRROR_PAIRS\tfailed=1\n");
        return 1;
    }
    if (argc > 1 && tx_eqz(argv[1], "--staged")) {
        for (r = 0; r < nrows; r++) {
            int ha = 0, hb = 0;
            for (i = 2; i < argc; i++) {
                if (tx_eqz(argv[i], rows[r].fa)) ha = 1;
                if (tx_eqz(argv[i], rows[r].fb)) hb = 1;
            }
            if (ha != hb && (r == 0 || !tx_eqz(rows[r].group, rows[r - 1].group)))
                printf("MIRROR_WARN\tgroup=%s\tstaged=%s\tunstaged=%s\tcheck the other copy\n", rows[r].group,
                       ha ? rows[r].fa : rows[r].fb, ha ? rows[r].fb : rows[r].fa);
        }
        return 0;
    }
    ck(compare_all(0, 0, "real") == 0, "real pairs aligned");
    if (cx_fmt(neg, sizeof neg, "%s/mirror-neg-%d.ps1", sy_tmpdir(), (int)getpid())) {
        ck(0, "neg path");
    } else {
        int made = make_negative(rows[0].fb, rows[0].ab, neg);
        ck(made == 0, "negative fixture built (one -O0 removed from marker B copy)");
        if (made == 0) ck(compare_all(neg, 1, "neg") > 0, "negative control: removed -O0 is detected");
        sy_unlink(neg);
    }
    printf("CHECK_MIRROR_PAIRS\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
