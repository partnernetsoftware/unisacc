/* Independent check for module path. Not a product driver.
   tools/driver -> ../cx/driver. This unit consumes that module.
   Run one source: sh ./unisacc.com tools/check-driver-path.cx
   Not run in the turn that added it. */
#pragma unisa use driver.path

static int g_fail;

static void note(int ok, const char *name) {
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", name);
    if (!ok) g_fail = g_fail + 1;
}

static void paths(const char *p, int bin, int tape, int obj, int arc, const char *name) {
    int ok;
    ok = cxp_tapebin_path(p) == bin && cxp_tape_path(p) == tape
        && cxp_object_path(p) == obj && cxp_archive_path(p) == arc;
    note(ok, name);
}

static void target(const char *t, int id, const char *name) {
    note(cxp_tapebin_target(t) == id, name);
}

int main(void) {
    g_fail = 0;
    paths("", 0, 0, 0, 0, "empty");
    paths("a", 0, 0, 0, 0, "short-a");
    paths(".", 0, 0, 0, 0, "short-dot");
    paths(".tap", 0, 0, 0, 0, "short-tape");
    paths(".tapebi", 0, 0, 0, 0, "short-bin");
    paths(".ob", 0, 0, 0, 0, "short-obj");
    paths(".o", 0, 0, 1, 0, "exact-o");
    paths(".a", 0, 0, 1, 1, "exact-a");
    paths(".obj", 0, 0, 1, 0, "exact-obj");
    paths(".tape", 0, 1, 0, 0, "exact-tape");
    paths(".tapebin", 1, 0, 0, 0, "exact-bin");
    paths("A.O", 0, 0, 0, 0, "case-o");
    paths("b.A", 0, 0, 0, 0, "case-a");
    paths("c.OBJ", 0, 0, 0, 0, "case-obj");
    paths("d.TAPE", 0, 0, 0, 0, "case-tape");
    paths("e.TAPEBIN", 0, 0, 0, 0, "case-bin");
    paths("f.Tape", 0, 0, 0, 0, "case-tape-mixed");
    paths("g.Obj", 0, 0, 0, 0, "case-obj-mixed");
    paths("dir/a.o", 0, 0, 1, 0, "dir-o");
    paths("dir/a.a", 0, 0, 1, 1, "dir-a");
    paths("dir/a.obj", 0, 0, 1, 0, "dir-obj");
    paths("dir/a.tape", 0, 1, 0, 0, "dir-tape");
    paths("dir/a.tapebin", 1, 0, 0, 0, "dir-bin");
    paths("a.tapebin.tape", 0, 1, 0, 0, "tape-after-bin");
    paths("a.tape.tapebin", 1, 0, 0, 0, "bin-after-tape");
    paths("a.obj.a", 0, 0, 1, 1, "archive-after-obj");
    paths("a.a.obj", 0, 0, 1, 0, "obj-after-archive");
    paths("a.o ", 0, 0, 0, 0, "trail-o");
    paths("a.tape ", 0, 0, 0, 0, "trail-tape");
    paths("a.tapebin ", 0, 0, 0, 0, "trail-bin");
    paths("a.c", 0, 0, 0, 0, "src-c");
    paths("a.cx", 0, 0, 0, 0, "src-cx");
    paths("a.s", 0, 0, 0, 0, "src-s");
    paths(0, 0, 0, 0, 0, "null-path");

    target("lnx/x86_64", 1, "tgt-lnx-x86");
    target("lnx/arm64", 2, "tgt-lnx-arm");
    target("osx/x86_64", 3, "tgt-osx-x86");
    target("osx/arm64", 4, "tgt-osx-arm");
    target("win/x86_64", 5, "tgt-win-x86");
    target("win/arm64", 6, "tgt-win-arm");
    target("", 0, "tgt-empty");
    target(0, 0, "tgt-null");
    target("LNX/x86_64", 0, "tgt-case-os");
    target("lnx/X86_64", 0, "tgt-case-arch");
    target("OSX/arm64", 0, "tgt-case-osx");
    target("win/ARM64", 0, "tgt-case-win");
    target("lnx/i386", 0, "tgt-unknown-cpu");
    target("lnx/x86_32", 0, "tgt-unknown-32");
    target("bsd/x86_64", 0, "tgt-unknown-os");
    target("lnx/x86_64/extra", 0, "tgt-extra");
    target("lnx", 0, "tgt-short-os");
    target("arm64", 0, "tgt-short-arch");
    target(" lnx/x86_64", 0, "tgt-lead-space");
    target("lnx/x86_64 ", 0, "tgt-trail-space");
    target("lnx\\x86_64", 0, "tgt-backslash");
    target(".tapebin", 0, "tgt-not-path");
    paths("lnx/x86_64", 0, 0, 0, 0, "path-not-target");

    printf("CXP\tfailed=%d\n", g_fail);
    return g_fail ? 1 : 0;
}
