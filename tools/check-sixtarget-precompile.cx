/* tools/check-sixtarget-precompile.cx -- self-check for tools/sixtarget-precompile.cx (M4/J10).
 * Marker: CHECK_SIXTARGET<TAB>failed=N */
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use sys.posix
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use cxlib.ckrun

static int passed = 0, failed = 0;
static void st_ck(int ok, const char *name) {
    if (ok) passed++; else failed++;
    printf("%s\tsixtarget.%s\n", ok ? "PASS" : "FAIL", name);
}

static void patch_unistd_fixture(const char *dir, int add_fwd) {
    char up[512];
    unsigned char *b = 0;
    int64_t n = 0;
    if (cx_fmt(up, sizeof up, "%s/include/unistd.h", dir) != 0) return;
    if (sy_read_file(up, &b, &n, 1 << 20) != 0 || !b || n <= 0) {
        if (b) mm_free(b);
        return;
    }
    const char *fwd_blk =
        "#if defined(_WIN32) && (!__UNISA_FTRIM_LIBC || __UN_rmdir)\n"
        "static int rmdir(const char *__u_p); /* unlinkat's _WIN32 branch calls it; the body sits further down */\n"
        "#endif\n";
    const char *anchor = "#if !__UNISA_FTRIM_LIBC || __UN_unlinkat\n";
    long fpos = tx_find((const char *)b, (long)n, "static int rmdir(const char *__u_p);", 36);
    if (add_fwd && fpos < 0) {
        long apos = tx_find((const char *)b, (long)n, anchor, (long)strlen(anchor));
        if (apos >= 0) {
            size_t fl = strlen(fwd_blk);
            char *nb = (char *)mm_alloc((size_t)n + fl + 8);
            if (nb) {
                mm_copy(nb, (size_t)n + fl + 8, b, (size_t)apos);
                mm_copy(nb + apos, (size_t)n + fl + 8 - (size_t)apos, fwd_blk, fl);
                mm_copy(nb + apos + fl, (size_t)n + 8 - (size_t)apos, (const char *)b + apos, (size_t)(n - apos));
                sy_write_file(up, nb, n + (int64_t)fl, 0600);
                mm_free(nb);
            }
        }
    } else if (!add_fwd && fpos >= 0) {
        long bpos = tx_find((const char *)b, (long)n, fwd_blk, (long)strlen(fwd_blk));
        if (bpos >= 0) {
            size_t fl = strlen(fwd_blk);
            char *nb = (char *)mm_alloc((size_t)n + 8);
            if (nb) {
                mm_copy(nb, (size_t)n + 8, b, (size_t)bpos);
                mm_copy(nb + bpos, (size_t)n + 8 - (size_t)bpos, (const char *)b + bpos + fl, (size_t)(n - bpos - (long)fl));
                sy_write_file(up, nb, n - (int64_t)fl, 0600);
                mm_free(nb);
            }
        }
    }
    mm_free(b);
}

int main(void) {
    char out[16384], cmd[4096], root[2048];
    long t0 = sy_now_ms();

    if (sy_realpath(".", root, sizeof root) < 0) {
        printf("FAIL\tresolve-root\nCHECK_SIXTARGET\tfailed=1\tms=0\n");
        return 1;
    }

    char tmp[256], stbin[320], good_cx[320], bad_err_cx[320], bad_fn_cx[320], d2_wrap[320], nod2_wrap[320];
    tx_snprintf(tmp, sizeof tmp, "/tmp/ck-st-%d-%ld", (int)getpid(), t0 % 100000L);
    tx_snprintf(stbin, sizeof stbin, "%s/sixtarget.bin", tmp);
    tx_snprintf(good_cx, sizeof good_cx, "%s/good.cx", tmp);
    tx_snprintf(bad_err_cx, sizeof bad_err_cx, "%s/badwin_err.cx", tmp);
    tx_snprintf(bad_fn_cx, sizeof bad_fn_cx, "%s/badwin_fn.cx", tmp);
    tx_snprintf(d2_wrap, sizeof d2_wrap, "%s/d2-wrap.sh", tmp);
    tx_snprintf(nod2_wrap, sizeof nod2_wrap, "%s/nod2-wrap.sh", tmp);
    sy_mkdir_all(tmp, 0700);

    tx_snprintf(cmd, sizeof cmd, "sh ./unisacc.com -o %s tools/sixtarget-precompile.cx", stbin);
    if (ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out) != 0) {
        st_ck(0, "compile-sixtarget-precompile");
        tx_snprintf(cmd, sizeof cmd, "rm -rf %s", tmp);
        ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out);
        printf("CHECK_SIXTARGET\tfailed=%d\tms=%ld\n", failed, sy_now_ms() - t0);
        return 1;
    }

    /* 1. CLI refusal checks */
    tx_snprintf(cmd, sizeof cmd, "%s", stbin);
    st_ck(ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out) == 2 && ckk_has(out, sizeof out, "usage:"), "no-args-refused");
    tx_snprintf(cmd, sizeof cmd, "%s --bad-flag", stbin);
    st_ck(ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out) == 2 && ckk_has(out, sizeof out, "bad argument"), "bad-flag-refused");
    tx_snprintf(cmd, sizeof cmd, "%s --mode nope", stbin);
    st_ck(ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out) == 2 && ckk_has(out, sizeof out, "usage:"), "bad-mode-refused");
    tx_snprintf(cmd, sizeof cmd, "%s --mode files", stbin);
    st_ck(ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out) == 2 && ckk_has(out, sizeof out, "at least one --file"), "files-empty-refused");
    tx_snprintf(cmd, sizeof cmd, "%s --mode files --file %s --target bad/arch", stbin, good_cx);
    st_ck(ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out) == 2 && ckk_has(out, sizeof out, "invalid --target"), "bad-target-refused");
    tx_snprintf(cmd, sizeof cmd, "%s --mode files --file %s --part 2/2", stbin, good_cx);
    st_ck(ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out) == 2 && ckk_has(out, sizeof out, "bad --part"), "bad-part-range-refused");
    tx_snprintf(cmd, sizeof cmd, "%s --mode files --file %s --part noslash", stbin, good_cx);
    st_ck(ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out) == 2 && ckk_has(out, sizeof out, "bad --part"), "bad-part-syntax-refused");
    tx_snprintf(cmd, sizeof cmd, "%s --mode files --file %s --deadline-s 56", stbin, good_cx);
    st_ck(ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out) == 2 && ckk_has(out, sizeof out, "1..55"), "bad-deadline-refused");
    tx_snprintf(cmd, sizeof cmd, "%s --mode files --file %s --par 0", stbin, good_cx);
    st_ck(ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out) == 2 && ckk_has(out, sizeof out, "--par must be 1..16"), "bad-par-zero-refused");
    tx_snprintf(cmd, sizeof cmd, "%s --mode files --file %s --par 17", stbin, good_cx);
    st_ck(ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out) == 2 && ckk_has(out, sizeof out, "--par must be 1..16"), "bad-par-over-16-refused");
    tx_snprintf(cmd, sizeof cmd, "%s --mode templates --root /nonexistent-st-root", stbin);
    st_ck(ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out) == 2 && ckk_has(out, sizeof out, "cannot resolve --root"), "bad-root-refused");
    tx_snprintf(cmd, sizeof cmd, "%s --mode templates --compiler /nonexistent-st-comp", stbin);
    st_ck(ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out) == 2 && ckk_has(out, sizeof out, "cannot resolve --compiler"), "bad-compiler-refused");

    /* Write fixture units */
    const char *good_src = "int st_good_fn(void) { return 42; }\n";
    sy_write_file(good_cx, good_src, (int64_t)strlen(good_src), 0600);

    const char *bad_err_src =
        "int st_bad_err(void) {\n"
        "#ifdef _WIN32\n"
        "    return win_only_undeclared_sym + 1;\n"
        "#else\n"
        "    return 0;\n"
        "#endif\n"
        "}\n";
    sy_write_file(bad_err_cx, bad_err_src, (int64_t)strlen(bad_err_src), 0600);

    const char *bad_fn_src =
        "int st_bad_fn(void) {\n"
        "#ifdef _WIN32\n"
        "    return undeclared_win_only_fn(1);\n"
        "#else\n"
        "    return 0;\n"
        "#endif\n"
        "}\n";
    sy_write_file(bad_fn_cx, bad_fn_src, (int64_t)strlen(bad_fn_src), 0600);

    /* Self-contained D2 wrapper and non-D2 wrapper around real ./unisacc.com */
    char wbuf[1024];
    int wn = tx_snprintf(wbuf, sizeof wbuf,
        "#!/bin/sh\n"
        "tgt=\"\"; src=\"\"\n"
        "prev=\"\"\n"
        "for a in \"$@\"; do\n"
        "  if [ \"$prev\" = \"-b\" ]; then tgt=\"$a\"; fi\n"
        "  case \"$a\" in *.cx) src=\"$a\" ;; esac\n"
        "  prev=\"$a\"\n"
        "done\n"
        "case \"$tgt\" in win/*)\n"
        "  if [ -n \"$src\" ] && grep -qE '_st_d2_undeclared_fn|undeclared_win_only_fn' \"$src\"; then\n"
        "    echo \"$src:3:12: error: call to undeclared function 'undeclared_win_only_fn' [-Wc99-implicit-function]\" >&2\n"
        "    exit 1\n"
        "  fi ;;\n"
        "esac\n"
        "exec sh '%s/unisacc.com' \"$@\"\n", root);
    sy_write_file(d2_wrap, wbuf, wn, 0700);

    int nwn = tx_snprintf(wbuf, sizeof wbuf,
        "#!/bin/sh\n"
        "out=\"\"\n"
        "prev=\"\"\n"
        "for a in \"$@\"; do\n"
        "  if [ \"$prev\" = \"-o\" ]; then out=\"$a\"; fi\n"
        "  prev=\"$a\"\n"
        "done\n"
        "if [ -n \"$out\" ]; then printf 'FAKEOBJ' > \"$out\"; fi\n"
        "exit 0\n");
    sy_write_file(nod2_wrap, wbuf, nwn, 0700);

    /* 2. Positive: good.cx passes all 6 targets */
    tx_snprintf(cmd, sizeof cmd, "%s --mode files --file %s", stbin, good_cx);
    int rc_g = ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out);
    st_ck(rc_g == 0 &&
       ckk_has(out, sizeof out, "SIXTARGET_OK\ttarget=lnx/x86_64\t") &&
       ckk_has(out, sizeof out, "SIXTARGET_OK\ttarget=lnx/arm64\t") &&
       ckk_has(out, sizeof out, "SIXTARGET_OK\ttarget=osx/x86_64\t") &&
       ckk_has(out, sizeof out, "SIXTARGET_OK\ttarget=osx/arm64\t") &&
       ckk_has(out, sizeof out, "SIXTARGET_OK\ttarget=win/x86_64\t") &&
       ckk_has(out, sizeof out, "SIXTARGET_OK\ttarget=win/arm64\t") &&
       ckk_has(out, sizeof out, "SIXTARGET_SUMMARY\tmode=files\ttargets=6\tchecked=6\tfailed=0\t") &&
       ckk_has(out, sizeof out, "\tverdict=PASS\n"),
       "files-good-all-6-targets");

    /* 3. Target sharding (--part 0/2 and --part 1/2) */
    tx_snprintf(cmd, sizeof cmd, "%s --mode files --file %s --part 0/2", stbin, good_cx);
    int rc_p0 = ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out);
    st_ck(rc_p0 == 0 && ckk_has(out, sizeof out, "\ttargets=3\tchecked=3\tfailed=0\t") &&
       ckk_has(out, sizeof out, "target=lnx/x86_64") && !ckk_has(out, sizeof out, "target=lnx/arm64"),
       "shard-part-0-of-2");

    tx_snprintf(cmd, sizeof cmd, "%s --mode files --file %s --part 1/2", stbin, good_cx);
    int rc_p1 = ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out);
    st_ck(rc_p1 == 0 && ckk_has(out, sizeof out, "\ttargets=3\tchecked=3\tfailed=0\t") &&
       ckk_has(out, sizeof out, "target=win/arm64") && !ckk_has(out, sizeof out, "target=win/x86_64"),
       "shard-part-1-of-2");

    /* 3b. --par only reorders the work: a width of 1 must still compile every target, and the target set
       must equal the unthrottled one (a width loop that drops or duplicates slots shows here). */
    tx_snprintf(cmd, sizeof cmd, "%s --mode files --file %s --par 1", stbin, good_cx);
    int rc_par1 = ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out);
    st_ck(rc_par1 == 0 &&
       ckk_has(out, sizeof out, "SIXTARGET_SUMMARY\tmode=files\ttargets=6\tchecked=6\tfailed=0\t") &&
       ckk_has(out, sizeof out, "target=lnx/x86_64") && ckk_has(out, sizeof out, "target=lnx/arm64") &&
       ckk_has(out, sizeof out, "target=osx/x86_64") && ckk_has(out, sizeof out, "target=osx/arm64") &&
       ckk_has(out, sizeof out, "target=win/x86_64") && ckk_has(out, sizeof out, "target=win/arm64"),
       "par-one-still-compiles-every-target");

    tx_snprintf(cmd, sizeof cmd, "%s --mode files --file %s --par 3", stbin, good_cx);
    st_ck(ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out) == 0 &&
       ckk_has(out, sizeof out, "SIXTARGET_SUMMARY\tmode=files\ttargets=6\tchecked=6\tfailed=0\t"),
       "par-three-same-verdict");

    /* 4. Negative: real win-only compile error fails win targets with target + diag line */
    tx_snprintf(cmd, sizeof cmd, "%s --mode files --file %s", stbin, bad_err_cx);
    int rc_be = ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out);
    st_ck(rc_be == 1 &&
       ckk_has(out, sizeof out, "SIXTARGET_OK\ttarget=lnx/x86_64\t") &&
       ckk_has(out, sizeof out, "SIXTARGET_FAIL\ttarget=win/x86_64\t") &&
       ckk_has(out, sizeof out, "SIXTARGET_FAIL\ttarget=win/arm64\t") &&
       ckk_has(out, sizeof out, "error:") &&
       ckk_has(out, sizeof out, "\ttargets=6\tchecked=6\tfailed=2\t") &&
       ckk_has(out, sizeof out, "\tverdict=FAIL\n"),
       "win-only-error-fails-win-targets-with-diag");

    /* 5. D2 probe: --require-d2 refuses non-D2 compiler; D2 compiler fails win undeclared function */
    tx_snprintf(cmd, sizeof cmd, "%s --mode files --file %s --compiler %s --require-d2", stbin, bad_fn_cx, nod2_wrap);
    int rc_nd2 = ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out);
    st_ck(rc_nd2 == 2 && ckk_has(out, sizeof out, "SIXTARGET_REFUSE\treason=compiler-lacks-d2"),
       "require-d2-refuses-non-d2-compiler");

    tx_snprintf(cmd, sizeof cmd, "%s --mode files --file %s --compiler %s --require-d2", stbin, bad_fn_cx, d2_wrap);
    int rc_d2 = ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out);
    st_ck(rc_d2 == 1 &&
       ckk_has(out, sizeof out, "SIXTARGET_OK\ttarget=lnx/x86_64\t") &&
       ckk_has(out, sizeof out, "SIXTARGET_FAIL\ttarget=win/x86_64\t") &&
       ckk_has(out, sizeof out, "SIXTARGET_FAIL\ttarget=win/arm64\t") &&
       ckk_has(out, sizeof out, "undeclared_win_only_fn") &&
       ckk_has(out, sizeof out, "\tfailed=2\t") &&
       ckk_has(out, sizeof out, "\tverdict=FAIL\n"),
       "d2-win-undeclared-fn-fails-with-target-and-diag");

    /* 6. Templates mode (J10): instantiates both templates and precompiles */
    tx_snprintf(cmd, sizeof cmd, "%s --mode templates --target win/x86_64", stbin);
    int rc_tpl = ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out);
    st_ck(rc_tpl == 0 &&
       ckk_has(out, sizeof out, "SIXTARGET_OK\ttarget=win/x86_64\tunit=tools/templates/whole-front.cx.in\t") &&
       ckk_has(out, sizeof out, "SIXTARGET_OK\ttarget=win/x86_64\tunit=tools/templates/whole-win-span.cx.in\t") &&
       ckk_has(out, sizeof out, "SIXTARGET_SUMMARY\tmode=templates\ttargets=1\tchecked=2\tfailed=0\t") &&
       ckk_has(out, sizeof out, "\tverdict=PASS\n"),
       "templates-mode-win-x86_64");

    /* 7. Chain-units mode with --filter /sys/ and unit sharding --part 0/4 */
    tx_snprintf(cmd, sizeof cmd, "%s --mode chain-units --filter /sys/ --target win/x86_64 --part 0/4", stbin);
    int rc_cu = ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out);
    st_ck(rc_cu == 0 &&
       ckk_has(out, sizeof out, "SIXTARGET_OK\ttarget=win/x86_64\t") &&
       ckk_has(out, sizeof out, "SIXTARGET_SUMMARY\tmode=chain-units\ttargets=1\t") &&
       ckk_has(out, sizeof out, "\tfailed=0\t") &&
       ckk_has(out, sizeof out, "\tverdict=PASS\n"),
       "chain-units-filter-sys-sharded");

    /* 8. Chain-units empty filter result must FAIL (never silent PASS) */
    tx_snprintf(cmd, sizeof cmd, "%s --mode chain-units --filter __no_such_unit__ --target lnx/x86_64", stbin);
    int rc_ce = ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out);
    st_ck(rc_ce == 1 && ckk_has(out, sizeof out, "plan-empty-or-failed") && ckk_has(out, sizeof out, "\tverdict=FAIL\n"),
       "chain-units-empty-refused");

    /* 9. Headers mode (SIXTARGET-M4-NO-UNTRIMMED-HEADER-SCAN):
     *    - missing include/ under --root refused with rc 2
     *    - 0.0.86 2c9dbac43e header tree (git archive when present, else exact unistd.h fixture) fails naming unistd.h:119 and rmdir
     *    - 0.0.86 38feea2ad3 header tree passes with 0 undeclared hits */
    tx_snprintf(cmd, sizeof cmd, "%s --mode headers --root %s --compiler %s/unisacc.com", stbin, tmp, root);
    st_ck(ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out) == 2 && ckk_has(out, sizeof out, "cannot prepare headers scan"),
       "headers-missing-include-refused");
    {
        char h2c9[320], h38f[320];
        tx_snprintf(h2c9, sizeof h2c9, "%s/hdr-2c9", tmp);
        tx_snprintf(h38f, sizeof h38f, "%s/hdr-38f", tmp);
        sy_mkdir_all(h2c9, 0700);
        sy_mkdir_all(h38f, 0700);
        tx_snprintf(cmd, sizeof cmd,
            "if git rev-parse --verify 2c9dbac43e^{commit} >/dev/null 2>&1 && git rev-parse --verify 38feea2ad3^{commit} >/dev/null 2>&1; then "
            "(git archive 2c9dbac43e include | tar -x -C '%s') & "
            "(git archive 38feea2ad3 include | tar -x -C '%s') & wait; "
            "else cp -R '%s/include' '%s/include' && cp -R '%s/include' '%s/include'; fi",
            h2c9, h38f, root, h2c9, root, h38f);
        ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out);
        patch_unistd_fixture(h2c9, 0);
        patch_unistd_fixture(h38f, 1);

        char out2[4096], out3[4096], f2[340], f3[340];
        tx_snprintf(f2, sizeof f2, "%s/h2.out", tmp);
        tx_snprintf(f3, sizeof f3, "%s/h3.out", tmp);
        tx_snprintf(cmd, sizeof cmd,
            "(%s --mode headers --root '%s' --compiler '%s/unisacc.com' --target win/x86_64 >'%s' 2>&1; printf 'RC2=%%d\\n' $? >>'%s') & "
            "(%s --mode headers --root '%s' --compiler '%s/unisacc.com' --target win/x86_64 >'%s' 2>&1; printf 'RC3=%%d\\n' $? >>'%s') & wait",
            stbin, h2c9, root, f2, f2, stbin, h38f, root, f3, f3);
        ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out);
        unsigned char *b2 = 0, *b3 = 0; int64_t n2 = 0, n3 = 0;
        memset(out2, 0, sizeof out2); memset(out3, 0, sizeof out3);
        if (sy_read_file(f2, &b2, &n2, 65536) == 0 && b2) { mm_copy(out2, sizeof out2 - 1, b2, (size_t)(n2 < 4095 ? n2 : 4095)); mm_free(b2); }
        if (sy_read_file(f3, &b3, &n3, 65536) == 0 && b3) { mm_copy(out3, sizeof out3 - 1, b3, (size_t)(n3 < 4095 ? n3 : 4095)); mm_free(b3); }

        st_ck(ckk_has(out2, sizeof out2, "RC2=1\n") &&
           ckk_has(out2, sizeof out2, "SIXTARGET_FAIL\ttarget=win/x86_64\tunit=include/unistd.h\t") &&
           ckk_has(out2, sizeof out2, "unistd.h:119:") &&
           ckk_has(out2, sizeof out2, "rmdir") &&
           ckk_has(out2, sizeof out2, "SIXTARGET_SUMMARY\tmode=headers\ttargets=1\tchecked=1\tfailed=1\t") &&
           ckk_has(out2, sizeof out2, "\tverdict=FAIL\n"),
           "headers-2c9dbac43e-red-names-unistd-119-rmdir");

        st_ck(ckk_has(out3, sizeof out3, "RC3=0\n") &&
           ckk_has(out3, sizeof out3, "SIXTARGET_OK\ttarget=win/x86_64\tunit=include/cx.h,include/*.h,include/sys/*.h\t") &&
           ckk_has(out3, sizeof out3, "SIXTARGET_SUMMARY\tmode=headers\ttargets=1\tchecked=1\tfailed=0\t") &&
           ckk_has(out3, sizeof out3, "\tverdict=PASS\n"),
           "headers-38feea2ad3-green-zero-undeclared");
    }

    /* 10. Regression (F): UNISACC_PREFLIGHT_REV and --rev must compile the pinned <rev>, NOT dirty/broken HEAD checkout,
     *     across BOTH templates and chain-units modes. */
    {
        char revfx[320], good_rev[64] = {0}, bad_tpl[512], bad_sig[512];
        tx_snprintf(revfx, sizeof revfx, "%s/rev-fx", tmp);
        sy_mkdir_all(revfx, 0700);
        tx_snprintf(cmd, sizeof cmd,
            "git archive HEAD cx include ext src cxroot.tsv tools/templates | tar -x -C '%s' && "
            "cd '%s' && git init -q && git add --all && "
            "git -c user.name=fx -c user.email=fx@local -c core.hooksPath=/dev/null -c commit.gpgsign=false commit -qm good && "
            "git rev-parse HEAD", revfx, revfx);
        int rc_mk = ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out);
        size_t oln = strlen(out);
        const char *sha_ln = out;
        for (size_t k = oln; k > 0; k--) {
            if (out[k - 1] == '\n' && k < oln) { sha_ln = out + k; break; }
        }
        /* Find 40-hex commit sha from last non-empty line */
        for (size_t k = 0; k + 40 <= oln; k++) {
            int hex = 1;
            for (int j = 0; j < 40; j++) {
                char ch = out[k + (size_t)j];
                if (!((ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f'))) { hex = 0; break; }
            }
            if (hex && (k + 40 == oln || out[k + 40] == '\n' || out[k + 40] == '\r')) {
                mm_copy(good_rev, sizeof good_rev, out + k, 40);
                good_rev[40] = 0;
            }
        }
        (void)sha_ln;
        st_ck(rc_mk == 0 && strlen(good_rev) == 40, "rev-fixture-created");
        if (strlen(good_rev) == 40) {
            tx_snprintf(bad_tpl, sizeof bad_tpl, "%s/tools/templates/whole-front.cx.in", revfx);
            tx_snprintf(bad_sig, sizeof bad_sig, "%s/cx/runtime/sys/sig.cx", revfx);
            unsigned char *tb = 0, *sb = 0; int64_t tn = 0, sn = 0;
            if (sy_read_file(bad_tpl, &tb, &tn, 1 << 20) == 0 && tb && tn > 0) {
                const char *ap = "\nint _broken_head_tpl(void){return undeclared_bad_head_tpl_fn();}\n";
                size_t al = strlen(ap);
                char *nb = (char *)mm_alloc((size_t)tn + al + 1);
                if (nb) {
                    mm_copy(nb, (size_t)tn + al + 1, tb, (size_t)tn);
                    mm_copy(nb + tn, al + 1, ap, al + 1);
                    sy_write_file(bad_tpl, nb, tn + (int64_t)al, 0600);
                    mm_free(nb);
                }
                mm_free(tb);
            }
            if (sy_read_file(bad_sig, &sb, &sn, 1 << 20) == 0 && sb && sn > 0) {
                const char *ap = "\nint _broken_head_sig(void){return undeclared_bad_head_sig_fn();}\n";
                size_t al = strlen(ap);
                char *nb = (char *)mm_alloc((size_t)sn + al + 1);
                if (nb) {
                    mm_copy(nb, (size_t)sn + al + 1, sb, (size_t)sn);
                    mm_copy(nb + sn, al + 1, ap, al + 1);
                    sy_write_file(bad_sig, nb, sn + (int64_t)al, 0600);
                    mm_free(nb);
                }
                mm_free(sb);
            }
            tx_snprintf(cmd, sizeof cmd,
                "cd '%s' && git add tools/templates/whole-front.cx.in cx/runtime/sys/sig.cx && "
                "git -c user.name=fx -c user.email=fx@local -c core.hooksPath=/dev/null -c commit.gpgsign=false commit -qm bad",
                revfx);
            ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out);

            char tf1[340], tf2[340], tf3[340], cf1[340], cf2[340], cf3[340];
            char to1[4096], to2[4096], to3[4096], co1[4096], co2[4096], co3[4096];
            tx_snprintf(tf1, sizeof tf1, "%s/rt1.out", tmp);
            tx_snprintf(tf2, sizeof tf2, "%s/rt2.out", tmp);
            tx_snprintf(tf3, sizeof tf3, "%s/rt3.out", tmp);
            tx_snprintf(cf1, sizeof cf1, "%s/rc1.out", tmp);
            tx_snprintf(cf2, sizeof cf2, "%s/rc2.out", tmp);
            tx_snprintf(cf3, sizeof cf3, "%s/rc3.out", tmp);
            tx_snprintf(cmd, sizeof cmd,
                "(cd '%s' && '%s' --mode templates --target win/x86_64 --compiler '%s/unisacc.com' >'%s' 2>&1; printf 'RC=%%d\\n' $? >>'%s') & "
                "(cd '%s' && UNISACC_PREFLIGHT_REV='%s' '%s' --mode templates --target win/x86_64 --compiler '%s/unisacc.com' >'%s' 2>&1; printf 'RC=%%d\\n' $? >>'%s') & "
                "('%s' --mode templates --root '%s' --rev '%s' --target win/x86_64 --compiler '%s/unisacc.com' >'%s' 2>&1; printf 'RC=%%d\\n' $? >>'%s') & "
                "wait",
                revfx, stbin, root, tf1, tf1,
                revfx, good_rev, stbin, root, tf2, tf2,
                stbin, revfx, good_rev, root, tf3, tf3);
            ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out);
            tx_snprintf(cmd, sizeof cmd,
                "(cd '%s' && '%s' --mode chain-units --filter cx/runtime/sys/sig.cx --target win/x86_64 --compiler '%s/unisacc.com' >'%s' 2>&1; printf 'RC=%%d\\n' $? >>'%s') & "
                "(cd '%s' && UNISACC_PREFLIGHT_REV='%s' '%s' --mode chain-units --filter cx/runtime/sys/sig.cx --target win/x86_64 --compiler '%s/unisacc.com' >'%s' 2>&1; printf 'RC=%%d\\n' $? >>'%s') & "
                "('%s' --mode chain-units --root '%s' --rev '%s' --filter cx/runtime/sys/sig.cx --target win/x86_64 --compiler '%s/unisacc.com' >'%s' 2>&1; printf 'RC=%%d\\n' $? >>'%s') & "
                "wait",
                revfx, stbin, root, cf1, cf1,
                revfx, good_rev, stbin, root, cf2, cf2,
                stbin, revfx, good_rev, root, cf3, cf3);
            ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out);

            const char *fpaths[6] = { tf1, tf2, tf3, cf1, cf2, cf3 };
            char *fbufs[6] = { to1, to2, to3, co1, co2, co3 };
            for (int fi = 0; fi < 6; fi++) {
                unsigned char *fb = 0; int64_t fn = 0;
                memset(fbufs[fi], 0, 4096);
                if (sy_read_file(fpaths[fi], &fb, &fn, 65536) == 0 && fb) {
                    mm_copy(fbufs[fi], 4095, fb, (size_t)(fn < 4095 ? fn : 4095));
                    mm_free(fb);
                }
            }

            st_ck(ckk_has(to1, sizeof to1, "RC=1\n") &&
                  ckk_has(to1, sizeof to1, "undeclared_bad_head_tpl_fn"),
                  "templates-head-checkout-fails-without-rev");
            st_ck(ckk_has(to2, sizeof to2, "RC=0\n") &&
                  ckk_has(to2, sizeof to2, "SIXTARGET_SUMMARY\tmode=templates\ttargets=1\tchecked=2\tfailed=0\t") &&
                  ckk_has(to2, sizeof to2, "\tverdict=PASS\n"),
                  "templates-env-rev-compiles-rev-not-checkout");
            st_ck(ckk_has(to3, sizeof to3, "RC=0\n") &&
                  ckk_has(to3, sizeof to3, "\tverdict=PASS\n"),
                  "templates-cli-rev-compiles-rev-not-checkout");
            st_ck(ckk_has(co1, sizeof co1, "RC=1\n") &&
                  ckk_has(co1, sizeof co1, "undeclared_bad_head_sig_fn"),
                  "chain-units-head-checkout-fails-without-rev");
            st_ck(ckk_has(co2, sizeof co2, "RC=0\n") &&
                  ckk_has(co2, sizeof co2, "SIXTARGET_OK\ttarget=win/x86_64\tunit=cx/runtime/sys/sig.cx\t") &&
                  ckk_has(co2, sizeof co2, "\tverdict=PASS\n"),
                  "chain-units-env-rev-compiles-rev-not-checkout");
            st_ck(ckk_has(co3, sizeof co3, "RC=0\n") &&
                  ckk_has(co3, sizeof co3, "SIXTARGET_OK\ttarget=win/x86_64\tunit=cx/runtime/sys/sig.cx\t") &&
                  ckk_has(co3, sizeof co3, "\tverdict=PASS\n"),
                  "chain-units-cli-rev-compiles-rev-not-checkout");
        }
    }

    /* 11. Worker killed / missing output must fail loudly and count toward checked and failed (never silent pass) */
    {
        char kill_wrap[320];
        tx_snprintf(kill_wrap, sizeof kill_wrap, "%s/kill-worker-wrap.sh", tmp);
        const char *kbody =
            "#!/bin/sh\n"
            "kill -9 $PPID 2>/dev/null || true\n"
            "exit 1\n";
        if (sy_write_file(kill_wrap, kbody, (int64_t)strlen(kbody), 0755) == 0) {
            sy_chmod(kill_wrap, 0755);
            tx_snprintf(cmd, sizeof cmd, "%s --mode files --file %s --target lnx/x86_64 --compiler %s", stbin, good_cx, kill_wrap);
            st_ck(ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out) == 1 &&
                  ckk_has(out, sizeof out, "SIXTARGET_FAIL\ttarget=lnx/x86_64\t") &&
                  ckk_has(out, sizeof out, "diag=worker-signaled\n") &&
                  ckk_has(out, sizeof out, "SIXTARGET_SUMMARY\tmode=files\ttargets=1\tchecked=1\tfailed=1\t") &&
                  ckk_has(out, sizeof out, "\tverdict=FAIL\n"),
                  "files-signaled-worker-counted-as-fail");

            tx_snprintf(cmd, sizeof cmd, "%s --mode templates --target lnx/x86_64 --compiler %s", stbin, kill_wrap);
            st_ck(ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out) == 1 &&
                  ckk_has(out, sizeof out, "SIXTARGET_FAIL\ttarget=lnx/x86_64\tunit=tools/templates/") &&
                  ckk_has(out, sizeof out, "diag=worker-signaled\n") &&
                  ckk_has(out, sizeof out, "SIXTARGET_SUMMARY\tmode=templates\ttargets=1\tchecked=2\tfailed=2\t") &&
                  ckk_has(out, sizeof out, "\tverdict=FAIL\n"),
                  "templates-signaled-worker-counted-as-fail");
        }
    }

    /* 12. 1-to-1 (target, unit) identity bijection: reject duplicate, unknown, wrong-target, or extra lines even when OK count == expect_n */
    {
        unsigned char *stsrc = 0;
        int64_t stlen = 0;
        if (sy_read_file("tools/sixtarget-precompile.cx", &stsrc, &stlen, 1 << 20) == 0 && stsrc && stlen > 0) {
            long bpos = tx_find((const char *)stsrc, (long)stlen, "/* ST_COLLECT_BEGIN */", 22);
            long epos = tx_find((const char *)stsrc, (long)stlen, "/* ST_COLLECT_END */", 20);
            if (bpos >= 0 && epos > bpos) {
                char hcx[320], hbin[320], hf1[320], hf2[320], hf3[320], hf4[320], hf5[320];
                char lcx_s[2100], lcx_d[320], lcr_s[2100], lcr_d[320];
                tx_snprintf(lcx_s, sizeof lcx_s, "%s/cx", root);
                tx_snprintf(lcx_d, sizeof lcx_d, "%s/cx", tmp);
                tx_snprintf(lcr_s, sizeof lcr_s, "%s/cxroot.tsv", root);
                tx_snprintf(lcr_d, sizeof lcr_d, "%s/cxroot.tsv", tmp);
                sy_symlink(lcx_s, lcx_d);
                sy_symlink(lcr_s, lcr_d);
                tx_snprintf(hcx, sizeof hcx, "%s/collect_harness.cx", tmp);
                tx_snprintf(hbin, sizeof hbin, "%s/collect_harness.bin", tmp);
                tx_snprintf(hf1, sizeof hf1, "%s/col1.txt", tmp);
                tx_snprintf(hf2, sizeof hf2, "%s/col2.txt", tmp);
                tx_snprintf(hf3, sizeof hf3, "%s/col3.txt", tmp);
                tx_snprintf(hf4, sizeof hf4, "%s/col4.txt", tmp);
                tx_snprintf(hf5, sizeof hf5, "%s/col5.txt", tmp);
                const char *hdr =
                    "#pragma unisa use sys.fs\n"
                    "#pragma unisa use sys.posix\n"
                    "#pragma unisa use mem.bytes\n"
                    "#pragma unisa use mem.heap\n"
                    "#pragma unisa use text.text\n";
                const char *main_code =
                    "\nint main(void) {\n"
                    "    const char *exp[2] = { \"a.cx\", \"b.cx\" };\n"
                    "    int c = 0, f = 0;\n"
                    "    c = 0; f = 0; st_collect_worker_out(\"__HF1__\", 0, 1, 0, \"lnx/x86_64\", exp, 2, 0, &c, &f);\n"
                    "    printf(\"CASE1 c=%d f=%d\\n\", c, f);\n"
                    "    c = 0; f = 0; st_collect_worker_out(\"__HF2__\", 0, 1, 0, \"lnx/x86_64\", exp, 2, 0, &c, &f);\n"
                    "    printf(\"CASE2 c=%d f=%d\\n\", c, f);\n"
                    "    c = 0; f = 0; st_collect_worker_out(\"__HF3__\", 0, 1, 0, \"lnx/x86_64\", exp, 2, 0, &c, &f);\n"
                    "    printf(\"CASE3 c=%d f=%d\\n\", c, f);\n"
                    "    c = 0; f = 0; st_collect_worker_out(\"__HF4__\", 0, 1, 0, \"lnx/x86_64\", exp, 2, 0, &c, &f);\n"
                    "    printf(\"CASE4 c=%d f=%d\\n\", c, f);\n"
                    "    c = 0; f = 0; st_collect_worker_out(\"__HF5__\", 0, 1, 0, \"lnx/x86_64\", exp, 2, 0, &c, &f);\n"
                    "    printf(\"CASE5 c=%d f=%d\\n\", c, f);\n"
                    "    return 0;\n"
                    "}\n";
                size_t slen = (size_t)(epos - bpos);
                size_t hcap = strlen(hdr) + slen + strlen(main_code) + 2048;
                char *hbuf = (char *)mm_alloc(hcap);
                if (hbuf) {
                    /* Replace placeholders __HF1__..__HF5__ cleanly */
                    size_t hp = 0;
                    mm_copy(hbuf + hp, hcap - hp, hdr, strlen(hdr)); hp += strlen(hdr);
                    mm_copy(hbuf + hp, hcap - hp, stsrc + bpos, slen); hp += slen;
                    const char *mp = main_code;
                    while (*mp && hp + 512 < hcap) {
                        if (memcmp(mp, "__HF1__", 7) == 0) { size_t l = strlen(hf1); mm_copy(hbuf + hp, hcap - hp, hf1, l); hp += l; mp += 7; }
                        else if (memcmp(mp, "__HF2__", 7) == 0) { size_t l = strlen(hf2); mm_copy(hbuf + hp, hcap - hp, hf2, l); hp += l; mp += 7; }
                        else if (memcmp(mp, "__HF3__", 7) == 0) { size_t l = strlen(hf3); mm_copy(hbuf + hp, hcap - hp, hf3, l); hp += l; mp += 7; }
                        else if (memcmp(mp, "__HF4__", 7) == 0) { size_t l = strlen(hf4); mm_copy(hbuf + hp, hcap - hp, hf4, l); hp += l; mp += 7; }
                        else if (memcmp(mp, "__HF5__", 7) == 0) { size_t l = strlen(hf5); mm_copy(hbuf + hp, hcap - hp, hf5, l); hp += l; mp += 7; }
                        else hbuf[hp++] = *mp++;
                    }
                    hbuf[hp] = 0;
                    sy_write_file(hcx, hbuf, (int64_t)hp, 0600);
                    mm_free(hbuf);

                    const char *c1 = "SIXTARGET_OK\ttarget=lnx/x86_64\tunit=a.cx\tms=1\nSIXTARGET_OK\ttarget=lnx/x86_64\tunit=b.cx\tms=1\n";
                    const char *c2 = "SIXTARGET_OK\ttarget=lnx/x86_64\tunit=a.cx\tms=1\nSIXTARGET_OK\ttarget=lnx/x86_64\tunit=a.cx\tms=1\n";
                    const char *c3 = "SIXTARGET_OK\ttarget=lnx/x86_64\tunit=a.cx\tms=1\nSIXTARGET_OK\ttarget=lnx/x86_64\tunit=evil.cx\tms=1\n";
                    const char *c4 = "SIXTARGET_OK\ttarget=lnx/x86_64\tunit=a.cx\tms=1\nSIXTARGET_OK\ttarget=osx/arm64\tunit=b.cx\tms=1\n";
                    const char *c5 = "SIXTARGET_OK\ttarget=lnx/x86_64\tunit=a.cx\tms=1\nSIXTARGET_OK\ttarget=lnx/x86_64\tunit=b.cx\tms=1\nSIXTARGET_OK\ttarget=lnx/x86_64\tunit=b.cx\tms=1\n";
                    sy_write_file(hf1, c1, (int64_t)strlen(c1), 0600);
                    sy_write_file(hf2, c2, (int64_t)strlen(c2), 0600);
                    sy_write_file(hf3, c3, (int64_t)strlen(c3), 0600);
                    sy_write_file(hf4, c4, (int64_t)strlen(c4), 0600);
                    sy_write_file(hf5, c5, (int64_t)strlen(c5), 0600);

                    tx_snprintf(cmd, sizeof cmd, "sh ./unisacc.com -o '%s' '%s' && '%s'", hbin, hcx, hbin);
                    int rc_bi = ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out);
                    st_ck(rc_bi == 0 &&
                          ckk_has(out, sizeof out, "CASE1 c=2 f=0\n") &&
                          ckk_has(out, sizeof out, "CASE2 c=3 f=2\n") &&
                          ckk_has(out, sizeof out, "CASE3 c=3 f=2\n") &&
                          ckk_has(out, sizeof out, "CASE4 c=3 f=2\n") &&
                          ckk_has(out, sizeof out, "CASE5 c=3 f=1\n") &&
                          ckk_has(out, sizeof out, "diag=worker-unexpected-or-duplicate-unit\n") &&
                          ckk_has(out, sizeof out, "diag=worker-unexpected-target\n"),
                          "worker-bijection-rejects-dup-unknown-wrongtarget-extra");
                }
            }
            mm_free(stsrc);
        }
    }

    /* Cleanup */
    tx_snprintf(cmd, sizeof cmd, "rm -rf %s", tmp);
    ckk_sh("CHECK_SIXTARGET", cmd, out, sizeof out);

    printf("CHECK_SIXTARGET\tfailed=%d\tms=%ld\n", failed, sy_now_ms() - t0);
    return failed ? 1 : 0;
}
