static void verify_native_phase(int packing,np_buf *w){np_buf inputs=native_inputs(packing);np_buf expected=native_record(packing,&inputs);char dir[4400],receipt[4400];phase_paths(packing?"pack":"declare",dir,receipt);canonical(dir);equal(receipt,&expected);if(w){char h[65];hash_bytes(expected.p,expected.n,h);row(w,receipt,h);}free(inputs.p);free(expected.p);}
static void execute_native_phase(int packing){check_context();verify_pc();np_buf before=native_inputs(packing);char dir[4400],receipt[4400],p[4400],evidence[4400];phase_paths(packing?"pack":"declare",dir,receipt);absent(dir);if(packing){pc_file(p,"compiler.pkg");absent(p);}else{pc_file(p,"declaration");absent(p);pc_file(p,"audit");absent(p);}if(mkdir(dir,0700))die("new-native-phase-required");SpArgs *a=native_args(packing);path(evidence,dir,"command");np_result r=command(a->v,40,evidence);free(a);int rc=r.rc;if(r.outn)fwrite(r.out,1,r.outn,stdout);if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);if(rc)die("native-construction-failed-partial-retained");check_context();verify_pc();np_buf after=native_inputs(packing);if(before.n!=after.n||memcmp(before.p,after.p,before.n))die("native-phase-complete-input-DAG-changed");np_buf expected=native_record(packing,&after);write_new(receipt,expected.p,expected.n);free(expected.p);free(before.p);free(after.p);verify_native_phase(packing,0);printf("PREPARED\tsource-package-%s\tactual-native-C-command\tno-test-result\n",packing?"pack":"declaration");}
static np_buf complete_inputs(void){np_buf b={0};np_puts(&b,"source-package-inputs-v1\n");row(&b,"status","CONTENT_AND_SOURCE_OBSERVATIONS-no-test-result");phase_inputs(&b,"seal-inputs");all_jobs(&b);all_models_routes(&b);verify_native_phase(1,&b);char p[4400];path(p,root,"include");tree_append(&b,p,"CARRIED_HEADERS");pc_file(p,"kernels");tree_append(&b,p,"PRIVATE_KERNELS");row(&b,"NN-provenance","34-delta-NN-recipes-actually-run-via-native-seed-gen-tbl-net;existing-classic18-weight-and-Python-source-files-remain-full-SID-inputs-not-claimed-reconstructed");row(&b,"host-dependencies","CC-subtools-system-headers-linker-libraries-zlib-DECLARED-not-hermetic;reference-executable-not-invoked-by-these-C-APIs");row(&b,"trust","saved-bootstrap-initial-SID-and-controller-compilation-trusted;unsigned-receipts-not-independent-history;no-training-no-cached-test-PASS");return b;}
static np_buf package_record(const np_buf *inputs){np_buf b={0};np_puts(&b,"source-package-v1\n");row(&b,"status","PREPARED-no-test-result");row(&b,"environment-policy",environment_policy);row(&b,"source",sid);row(&b,"source-context",ctx);row(&b,"source-context-sha",context_sha);row(&b,"foundation",basis_pin);row(&b,"consumer",consumer_sha);digest_identity(&b);row(&b,"bootstrap",bootstrap);row(&b,"bootstrap-sha",bootstrap_sha);row(&b,"root-product-sha",product_sha);row(&b,"cc-sha",cc_sha);row(&b,"cc-version-sha",cc_version_sha);char h[65],p[4400];hash_bytes(inputs->p,inputs->n,h);row(&b,"model-inputs.tsv",h);pc_file(p,"context.tsv");digest(p,h);row(&b,"pack-context",h);package_identity(&b);const char *phases[]={"declare","pack"};for(int i=0;i<2;i++){char dir[4400],receipt[4400];phase_paths(phases[i],dir,receipt);digest(receipt,h);row(&b,phases[i],h);}row(&b,"ABI","P3-current-core-action-ABI;native-LP64-constructors;UNIKERN1-arm64+x86_64");row(&b,"scope","source-material-identity-only;not-P7-refresh;not-functional-NN-PASS-full-N22-hermetic-CC-zero-Python-chain-or-foreign-hosts");return b;}
static void final_stage(int verify){char input_file[4400],receipt_file[4400];pc_file(input_file,"model-inputs.tsv");pc_file(receipt_file,"package.tsv");if(!verify){absent(input_file);absent(receipt_file);}check_context();verify_pc();np_buf before=complete_inputs();np_buf record_before=package_record(&before);if(verify){equal(input_file,&before);equal(receipt_file,&record_before);}check_context();verify_pc();np_buf after=complete_inputs();np_buf record_after=package_record(&after);if(before.n!=after.n||memcmp(before.p,after.p,before.n)||record_before.n!=record_after.n||memcmp(record_before.p,record_after.p,record_before.n))die("package-seal-or-verification-endpoints-changed");if(verify){equal(input_file,&after);equal(receipt_file,&record_after);}else{absent(input_file);absent(receipt_file);write_new(input_file,after.p,after.n);write_new(receipt_file,record_after.p,record_after.n);equal(input_file,&after);equal(receipt_file,&record_after);}free(before.p);free(after.p);free(record_before.p);free(record_after.p);puts(verify?"VERIFIED\tsource-package-v1\tpure-read-no-NN-construction-no-test-result":"PREPARED\tsource-package-v1\tactual-source-P3-material-no-test-result");}
