 else{arg(a,"--compressed");arg(a,"-o");pc_file(p,"compiler.pkg");arg(a,p);arg(a,"--mount");arg(a,"006864722f");path(p,root,"include");arg(a,p);arg(a,"--mount");arg(a,"006b65726e656c2f");pc_file(p,"kernels");arg(a,p);arg(a,"--mount");arg(a,"00707265646566696e65732f");pc_file(p,"declaration/predefines");arg(a,p);pc_file(p,"declaration/routes.tsv");arg(a,p);}return a;}
static void command_evidence(np_buf *w,const char *phase,const SpArgs *a){char dir[4400],receipt[4400],p[4400];phase_paths(phase,dir,receipt);np_buf argv={0};for(int i=0;i<a->n;i++){char key[32];snprintf(key,sizeof key,"arg-%d",i);row(&argv,key,a->v[i]);row(w,key,a->v[i]);}path(p,dir,"command.argv.tsv");equal(p,&argv);free(argv.p);np_buf ok={0};np_puts(&ok,"rc\t0\n");path(p,dir,"command.status");equal(p,&ok);free(ok.p);const char *files[]={"command.argv.tsv","command.stdout","command.stderr","command.status"};for(int i=0;i<4;i++){char h[65];path(p,dir,files[i]);digest(p,h);row(w,p,h);}}
static void package_identity(np_buf *w){char p[4400],h[65],size[40];pc_file(p,"compiler.pkg");SpObservedFile *f=sp_observe(p,0);size_t n=f->n,hn=f->prefix_n;const unsigned char *s=f->prefix;if(n<10||memcmp(s,"P 3 ",4))die("actual-native-pack-not-P3");size_t at=4;for(int i=0;i<3;i++){unsigned value=0;int digits=0;while(at<hn&&s[at]>='0'&&s[at]<='9'){if(value>6553||(value==6553&&s[at]>'6'))die("P3-header-count-bound");value=value*10+(unsigned)(s[at++]-'0');digits++;}if(!digits||!value||at>=hn||s[at++]!=(i==2?'\n':' '))die("P3-header-count-shape");}memcpy(h,f->hash,65);snprintf(size,sizeof size,"%lu",(unsigned long)n);row(w,"compiler.pkg",h);row(w,"compiler.pkg-bytes",size);row(w,"wire-boundary","P3-header-and-full-content-identity;UNINETB1/DEFLATE-semantics-come-from-actual-pinned-native-pack-not-a-new-decoder-or-functional-test");}
static void verify_native_phase(int packing,np_buf *w);
