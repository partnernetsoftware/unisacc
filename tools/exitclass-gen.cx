/* exitclass-gen: build/exit-classes.tsv -> tools/cxlib/exitclass.cx.
 *   sh ./unisacc.com tools/exitclass-gen.cx -- --write|--check [ROOT]
 * ROOT defaults to ".". --check is nonzero on byte drift (1) or a refused table (2).
 * Generated exports are only ec_class(rc) and ec_retryable(rc). chain-run calls ec_retryable. */
#pragma unisa use sys.fs
#pragma unisa use mem.bytes
#pragma unisa use cxlib.netpack
#define MAXR 32
static int rcs[MAXR];
static char *names[MAXR], *classes[MAXR], *sources[MAXR];
static int nr;
static void die(const char *s) { fprintf(stderr, "exitclass-gen: REFUSE %s\n", s); exit(2); }
static int ident(const char *s) {
    if (!*s) return 0;
    for (; *s; s++) if (!strchr("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", *s)) return 0;
    return 1;
}
static int class_ok(const char *s) {
    return !strcmp(s, "RETRYABLE") || !strcmp(s, "DETERMINISTIC") || !strcmp(s, "UNKNOWN");
}
static int source_ok(const char *s) {
    const char *c = strrchr(s, ':');
    if (!c || c == s || !c[1]) return 0;
    for (const char *p = s; p < c; p++) if (!strchr("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_./-", *p)) return 0;
    for (const char *p = c + 1; *p; p++) if (*p < '0' || *p > '9') return 0;
    return 1;
}
static int parse_rc(const char *s, int *out) {
    int sign = 1, v = 0, any = 0;
    if (*s == '-') { sign = -1; s++; }
    if (!*s) return 0;
    for (; *s; s++) { if (*s < '0' || *s > '9') return 0; any = 1; v = v * 10 + (*s - '0'); }
    *out = sign * v;
    return any;
}
int main(int argc, char **argv) {
    if (argc < 2 || argc > 3 || (strcmp(argv[1], "--write") && strcmp(argv[1], "--check"))) {
        fprintf(stderr, "exitclass-gen: usage --write|--check [ROOT]\n");
        return 2;
    }
    const char *root = argc == 3 ? argv[2] : ".";
    char src[2600], dst[2600];
    if (cx_fmt(src, sizeof src, "%s/build/exit-classes.tsv", root) || cx_fmt(dst, sizeof dst, "%s/tools/cxlib/exitclass.cx", root)) die("path bound");
    size_t n; char *s = cx_read(src, &n);
    if (!s || !n || n > 65536 || s[n - 1] != '\n' || memchr(s, 0, n) || memchr(s, '\r', n)) die("table text");
    for (char *p = s; *p; ) {
        char *e = strchr(p, '\n'); *e = 0;
        if (*p && *p != '#') {
            char *f[4]; int k = 0; f[k++] = p;
            for (char *q = p; *q && k < 5; q++) if (*q == '\t') { *q = 0; if (k == 4) die("columns"); f[k++] = q + 1; }
            if (k != 4) die("columns");
            int rc; if (!parse_rc(f[0], &rc)) die("rc");
            if (!ident(f[1]) || !class_ok(f[2]) || !source_ok(f[3])) die("token");
            if (nr == MAXR) die("row bound");
            for (int i = 0; i < nr; i++) if (rcs[i] == rc) die("duplicate rc");
            rcs[nr] = rc; names[nr] = f[1]; classes[nr] = f[2]; sources[nr] = f[3]; nr++;
        }
        p = e + 1;
    }
    if (!nr) die("empty table");
    np_buf b = {0};
    np_puts(&b, "/* Generated by tools/exitclass-gen.cx --write; edit build/exit-classes.tsv. */\n");
    np_puts(&b, "#pragma unisa module exitclass\n");
    for (int i = 0; i < nr; i++) {
        char row[256];
        if (cx_fmt(row, sizeof row, "/* %d %s %s %s */\n", rcs[i], names[i], classes[i], sources[i])) die("comment bound");
        np_puts(&b, row);
    }
    np_puts(&b, "static const int ec_rc[] = {\n");
    for (int i = 0; i < nr; i++) { char num[32]; cx_fmt(num, sizeof num, " %d,\n", rcs[i]); np_puts(&b, num); }
    np_puts(&b, "};\nstatic const char *ec_cls[] = {\n");
    for (int i = 0; i < nr; i++) { np_puts(&b, " \""); np_puts(&b, classes[i]); np_puts(&b, "\",\n"); }
    np_puts(&b, "};\nstatic int ec_find(int rc) {\n"
            " int n = (int)(sizeof ec_rc / sizeof ec_rc[0]);\n"
            " for (int i = 0; i < n; i++) if (ec_rc[i] == rc) return i;\n"
            " return -1;\n}\n"
            "const char *ec_class(int rc) { int i = ec_find(rc); return i < 0 ? \"UNKNOWN\" : ec_cls[i]; }\n"
            "int ec_retryable(int rc) { return !strcmp(ec_class(rc), \"RETRYABLE\"); }\n");
    int check = !strcmp(argv[1], "--check");
    if (check) {
        size_t z; char *old = cx_read(dst, &z);
        int same = old && z == b.n && !memcmp(old, b.p, z);
        free(old);
        if (!same) { fprintf(stderr, "exitclass-gen: DIFF\n"); return 1; }
    } else if (cx_write(dst, b.p, b.n)) die("write library");
    printf("EXITCLASS_GEN\tstatus=%s\trows=%d\n", check ? "CHECK" : "WRITE", nr);
    return 0;
}
