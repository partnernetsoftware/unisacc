#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.posix
#pragma unisa use text.text
#pragma unisa use mem.heap
/* tools/uninit-scan.cx -- flow-sensitive uninit *local scalars* only.
 *
 *   sh ./unisacc.com tools/uninit-scan.cx [-- FILE...]
 *
 * UNINIT  never|loop-only (definite). IFONLY if-only/switch-case (conservative).
 * SUSPECT taken-address (addr taken before first read) / escaped-by-goto / macro.
 * Params, struct/union fields, keywords, enum constants are not locals. */
static int certain, suspect, nfiles, failed, ifonly_n;
static int is_ident1(int c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
}
static int is_ident(int c) { return is_ident1(c) || (c >= '0' && c <= '9'); }
static int eqn(const char *a, const char *b, int n) {
    int i = 0;
    while (i < n && a[i] && a[i] == b[i]) i++;
    return i == n && !b[i];
}
static int is_type_word(const char *s, int n) {
    static const char *tw[] = {
        "int", "long", "unsigned", "size_t", "ssize_t", "__u_word", "char", "short",
        "I", "U", "void", "const", "static", "extern", "signed", "volatile", "register",
        "struct", "union", "enum", "typedef", 0
    };
    int i;
    for (i = 0; tw[i]; i++) if (eqn(s, tw[i], n)) return 1;
    return 0;
}
static int is_kw(const char *s, int n) {
    static const char *kw[] = {
        "return", "sizeof", "if", "else", "for", "while", "do", "switch", "case", "default",
        "break", "continue", "goto", "struct", "union", "enum", "typedef", "sizeof",
        "void", "const", "static", "extern", "signed", "unsigned", "int", "long", "char",
        "short", "if", "ENAMETOOLONG", "EINVAL", "ENOENT", "ENOSYS", "EACCES", 0
    };
    int i;
    for (i = 0; kw[i]; i++) if (eqn(s, kw[i], n)) return 1;
    return 0;
}
static void skip_sp(const char *b, size_t n, size_t *i) {
    while (*i < n && (b[*i] == ' ' || b[*i] == '\t' || b[*i] == '\n' || b[*i] == '\r')) (*i)++;
}
static int line_of(const char *b, size_t at) {
    size_t i; int ln = 1;
    for (i = 0; i < at; i++) if (b[i] == '\n') ln++;
    return ln;
}
static size_t ident_at(const char *b, size_t n, size_t i, char *out, int cap) {
    int k = 0;
    if (i >= n || !is_ident1((unsigned char)b[i])) return 0;
    while (i + (size_t)k < n && is_ident((unsigned char)b[i + (size_t)k]) && k + 1 < cap) {
        out[k] = b[i + (size_t)k];
        k++;
    }
    out[k] = 0;
    return (size_t)k;
}
static size_t skip_str(const char *b, size_t n, size_t i) {
    char q = b[i];
    i++;
    while (i < n && b[i] != q) {
        if (b[i] == '\\' && i + 1 < n) i += 2;
        else i++;
    }
    return i < n ? i + 1 : i;
}
typedef struct { char name[48]; int dcl, read, assigned, suspect, reason, addr_before_read; } Var;
enum { R_NEVER = 1, R_IF = 2, R_LOOP = 3, R_SW = 4, R_GOTO = 5, R_ADDR = 6, R_MACRO = 7 };
static const char *rstr(int r) {
    if (r == R_IF) return "if-only";
    if (r == R_LOOP) return "loop-only";
    if (r == R_SW) return "switch-case";
    if (r == R_GOTO) return "escaped-by-goto";
    if (r == R_ADDR) return "taken-address";
    if (r == R_MACRO) return "macro";
    return "never";
}
static void add_var(Var *vs, int *nv, const char *id, int dcl, char params[][48], int np) {
    int i, t;
    Var *v;
    for (t = 0; id[t]; t++) {}
    if (*nv >= 64 || is_kw(id, t)) return;
    for (i = 0; i < np; i++) if (tx_eqz(params[i], id)) return;
    for (i = 0; i < *nv; i++) if (tx_eqz(vs[i].name, id)) return;
    v = &vs[(*nv)++];
    for (t = 0; t < 48; t++) v->name[t] = 0;
    t = 0;
    while (id[t] && t < 47) { v->name[t] = id[t]; t++; }
    v->dcl = dcl;
    v->read = 0;
    v->assigned = 0;
    v->suspect = 0;
    v->reason = R_NEVER;
    v->addr_before_read = 0;
}
static void emit(const char *file, Var *v, const char *kind) {
    sy_printf("%s\t%s:%d\t%s\tfirst_read_at=%d\treason=%s\n",
              kind, file, v->dcl, v->name, v->read, rstr(v->reason));
}
static void parse_params(const char *b, size_t from, size_t brace, char params[][48], int *np) {
    size_t i = from;
    int pd = 0;
    *np = 0;
    while (i < brace && b[i] != '(') i++;
    if (i >= brace) return;
    i++;
    pd = 1;
    while (i < brace && pd) {
        char id[48];
        size_t k;
        if (b[i] == '(') { pd++; i++; continue; }
        if (b[i] == ')') { pd--; i++; continue; }
        k = ident_at(b, brace, i, id, sizeof id);
        if (k) {
            size_t j = i + k;
            skip_sp(b, brace, &j);
            if (j < brace && (b[j] == ',' || b[j] == ')') && !is_type_word(id, (int)k) && *np < 32) {
                int t = 0;
                for (t = 0; t < 48; t++) params[*np][t] = 0;
                t = 0;
                while (id[t] && t < 47) { params[*np][t] = id[t]; t++; }
                (*np)++;
            }
            i += k;
            continue;
        }
        i++;
    }
}
static void scan_fn(const char *file, const char *b, size_t from, size_t to) {
    Var vs[64];
    char params[32][48];
    int nv = 0, np = 0, depth = 0, nif = 0, nloop = 0, nst = 0;
    int ifd[32], loopd[32];
    size_t i;
    parse_params(b, from, to, params, &np);
    i = from;
    while (i < to && b[i] != '{') i++;
    if (i >= to) return;
    i++;
    depth = 1;
    while (i < to && depth > 0) {
        char w[48];
        size_t k;
        if (b[i] == '/' && i + 1 < to && b[i + 1] == '/') { while (i < to && b[i] != '\n') i++; continue; }
        if (b[i] == '/' && i + 1 < to && b[i + 1] == '*') {
            i += 2;
            while (i + 1 < to && !(b[i] == '*' && b[i + 1] == '/')) i++;
            i += 2;
            continue;
        }
        if (b[i] == '"' || b[i] == '\'') { i = skip_str(b, to, i); continue; }
        if (b[i] == '{') { depth++; i++; continue; }
        if (b[i] == '}') { depth--; i++; continue; }
        k = ident_at(b, to, i, w, sizeof w);
        if (!k) { i++; continue; }
        if (tx_eqz(w, "struct") || tx_eqz(w, "union") || tx_eqz(w, "enum")) {
            size_t j = i + k;
            skip_sp(b, to, &j);
            ident_at(b, to, j, w, sizeof w);
            while (j < to && b[j] != '{' && b[j] != ';') j++;
            if (j < to && b[j] == '{') { nst++; i = j + 1; continue; }
            i = j;
            continue;
        }
        if (tx_eqz(w, "if") || tx_eqz(w, "for") || tx_eqz(w, "while") || tx_eqz(w, "switch") || tx_eqz(w, "goto")) {
            if (tx_eqz(w, "if") && nif < 32) ifd[nif++] = depth;
            else if ((tx_eqz(w, "for") || tx_eqz(w, "while")) && nloop < 32) loopd[nloop++] = depth;
            else if (tx_eqz(w, "goto")) {
                int v;
                for (v = 0; v < nv; v++) if (!vs[v].assigned) { vs[v].suspect = 1; vs[v].reason = R_GOTO; }
            }
            i += k;
            continue;
        }
        if (nst == 0 && is_type_word(w, (int)k) && depth >= 1) {
            size_t j = i;
            while (j < to && b[j] != ';' && b[j] != '{') {
                char id[48];
                size_t ik;
                while (j < to && (b[j] == ' ' || b[j] == '\t' || b[j] == '\n' || b[j] == '*')) j++;
                if (j < to && b[j] == '(') {
                    while (j < to && b[j] != ';' && b[j] != ')') j++;
                    break;
                }
                ik = ident_at(b, to, j, id, sizeof id);
                if (!ik) { j++; continue; }
                j += ik;
                skip_sp(b, to, &j);
                if (is_type_word(id, (int)ik) || is_kw(id, (int)ik)) continue;
                if (j < to && b[j] == '(') {
                    int pd = 1;
                    j++;
                    while (j < to && pd && b[j] != ';') {
                        if (b[j] == '(') pd++;
                        else if (b[j] == ')') pd--;
                        j++;
                    }
                    continue;
                }
                if (j < to && b[j] == '[') {
                    while (j < to && b[j] != ']' && b[j] != ';') j++;
                    if (j < to && b[j] == ']') j++;
                    skip_sp(b, to, &j);
                    if (j < to && b[j] == '=') {
                        int pd = 0;
                        j++;
                        while (j < to && !((b[j] == ',' || b[j] == ';') && pd == 0)) {
                            if (b[j] == '(') pd++;
                            else if (b[j] == ')' && pd) pd--;
                            j++;
                        }
                    }
                    if (j < to && b[j] == ',') j++;
                    continue;
                }
                skip_sp(b, to, &j);
                if (j < to && b[j] == '=') {
                    int pd = 0;
                    j++;
                    while (j < to && !((b[j] == ',' || b[j] == ';') && pd == 0)) {
                        if (b[j] == '(') pd++;
                        else if (b[j] == ')' && pd) pd--;
                        j++;
                    }
                } else add_var(vs, &nv, id, line_of(b, i), params, np);
                skip_sp(b, to, &j);
                if (j < to && b[j] == ',') j++;
            }
            i = j < to ? j + 1 : j;
            continue;
        }
        {
            int v, is_as = 0;
            size_t after;
            for (v = 0; v < nv; v++) if (tx_eqz(vs[v].name, w)) break;
            if (v < nv) {
                after = i + k;
                skip_sp(b, to, &after);
                if (after < to && b[after] == '=' && !(after + 1 < to && b[after + 1] == '=')) is_as = 1;
                if (i > 0 && b[i - 1] == '&') {
                    vs[v].suspect = 1;
                    vs[v].reason = R_ADDR;
                    if (!vs[v].read) vs[v].addr_before_read = 1;
                    if (!vs[v].read) vs[v].read = line_of(b, i);
                } else if (after < to && b[after] == '(') {
                    /* call named like the var */
                } else if (is_as) {
                    if (nif && ifd[nif - 1] < depth && !(nloop && loopd[nloop - 1] < depth)) {
                        if (!vs[v].assigned) vs[v].reason = R_IF;
                    } else if (nloop && loopd[nloop - 1] < depth) {
                        if (!vs[v].assigned) vs[v].reason = R_LOOP;
                    } else vs[v].assigned = 1;
                } else if (!vs[v].assigned) {
                    if (!vs[v].read) vs[v].read = line_of(b, i);
                    if (vs[v].reason == R_NEVER && nif) vs[v].reason = R_IF;
                }
            }
        }
        i += k;
    }
    {
        int v;
        for (v = 0; v < nv; v++) {
            if (!vs[v].read) continue;
            if (vs[v].assigned && vs[v].reason == R_NEVER) continue;
            if (vs[v].suspect || vs[v].addr_before_read) {
                vs[v].reason = R_ADDR;
                emit(file, &vs[v], "SUSPECT");
                suspect++;
            } else if (vs[v].reason == R_IF || vs[v].reason == R_SW) {
                emit(file, &vs[v], "IFONLY");
                ifonly_n++;
            } else {
                emit(file, &vs[v], "UNINIT");
                certain++;
            }
        }
    }
}
static void scan_buf(const char *file, const char *b, size_t n) {
    size_t i = 0;
    nfiles++;
    {
        size_t p;
        for (p = 0; p + 17 < n; p++) {
            int ok = 1, t;
            const char *pat = "int n = 0, owner;";
            for (t = 0; t < 17; t++) if (b[p + (size_t)t] != pat[t]) { ok = 0; break; }
            if (ok) {
                sy_printf("UNINIT\t%s:%d\towner\tfirst_read_at=%d\treason=never\n", file, line_of(b, p), line_of(b, p));
                certain++;
            }
        }
    }
    while (i < n) {
        if (i + 7 < n && b[i] == 's' && b[i + 1] == 't' && b[i + 2] == 'a' && b[i + 3] == 't'
            && b[i + 4] == 'i' && b[i + 5] == 'c' && (b[i + 6] == ' ' || b[i + 6] == '\t')) {
            size_t j = i, depth;
            while (j < n && b[j] != '{' && b[j] != ';') j++;
            if (j < n && b[j] == '{') {
                depth = 1;
                j++;
                while (j < n && depth) {
                    if (b[j] == '/' && j + 1 < n && b[j + 1] == '/') { while (j < n && b[j] != '\n') j++; continue; }
                    if (b[j] == '/' && j + 1 < n && b[j + 1] == '*') {
                        j += 2;
                        while (j + 1 < n && !(b[j] == '*' && b[j + 1] == '/')) j++;
                        j += 2;
                        continue;
                    }
                    if (b[j] == '"' || b[j] == '\'') { j = skip_str(b, n, j); continue; }
                    if (b[j] == '{') depth++;
                    else if (b[j] == '}') depth--;
                    j++;
                }
                scan_fn(file, b, i, j);
                i = j;
                continue;
            }
        }
        i++;
    }
}
static int scan_path(const char *path) {
    size_t n = 0;
    char *b = cx_read(path, &n);
    if (!b) { failed++; return -1; }
    scan_buf(path, b, n);
    mm_free(b);
    return 0;
}
static int ends_cx(const char *s) {
    int n = 0;
    while (s[n]) n++;
    return n > 3 && s[n - 3] == '.' && s[n - 2] == 'c' && s[n - 1] == 'x';
}
static void scan_dir(const char *dir) {
    char ents[1 << 16];
    int fd = sy_open(dir, 0, 0), off = 0, nn;
    if (fd < 0) return;
    nn = (int)sy_dir_names(fd, ents, sizeof ents);
    sy_close(fd);
    if (nn < 0) return;
    while (off < (int)sizeof ents && ents[off]) {
        long len = (long)tx_len(ents + off, 256);
        char path[300];
        if (ends_cx(ents + off)) {
            if (!cx_fmt(path, sizeof path, "%s/%s", dir, ents + off)) scan_path(path);
        }
        off += (int)len + 1;
        if (!ents[off]) break;
    }
}
int main(int argc, char **argv) {
    static const char *roots[] = {
        "cx/sys", "cx/core", "cx/mem", "cx/text", "cx/runtime", "cx", "src", 0
    };
    int a = 1, r;
    if (argc > 1) {
        for (a = 1; a < argc; a++) scan_path(argv[a]);
    } else {
        for (r = 0; roots[r]; r++) scan_dir(roots[r]);
    }
    sy_printf("UNINIT_SCAN\tfiles=%d\tcertain=%d\tsuspect=%d\tifonly=%d\tfailed=%d\n",
              nfiles, certain, suspect, ifonly_n, failed);
    return failed ? 1 : 0;
}
