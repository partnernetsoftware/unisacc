#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.posix
#pragma unisa use text.text
#pragma unisa use mem.heap
/* tools/uninit-scan.cx -- flow-sensitive uninit local reads. Inventory, not a ratchet.
 *
 *   sh ./unisacc.com tools/uninit-scan.cx [-- FILE...]
 *
 * Default roots: cx/sys cx/core cx/mem cx/text cx/runtime cx src (only .cx).
 * UNINIT  file:line var first_read_at=... reason=if-only|loop-only|switch-case|never
 * SUSPECT file:line var first_read_at=... reason=escaped-by-goto|taken-address|macro
 * UNINIT_SCAN files=N certain=A suspect=B failed=0 */
static int certain, suspect, nfiles, failed;
static int is_ident1(int c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
}
static int is_ident(int c) {
    return is_ident1(c) || (c >= '0' && c <= '9');
}
static int is_type_word(const char *s, int n) {
    static const char *tw[] = {
        "int", "long", "unsigned", "size_t", "ssize_t", "__u_word", "char", "short",
        "I", "U", "void", "const", "static", "extern", "signed", "volatile", "register", 0
    };
    int i, k;
    for (i = 0; tw[i]; i++) {
        k = 0;
        while (tw[i][k]) k++;
        if (k == n) {
            int j = 0;
            while (j < n && s[j] == tw[i][j]) j++;
            if (j == n) return 1;
        }
    }
    return 0;
}
static void skip_sp(const char *b, size_t n, size_t *i) {
    while (*i < n && (b[*i] == ' ' || b[*i] == '\t' || b[*i] == '\n' || b[*i] == '\r')) (*i)++;
}
static int line_of(const char *b, size_t at) {
    size_t i; int ln = 1;
    for (i = 0; i < at; i++) if (b[i] == '\n') ln++;
    return ln;
}
static size_t ident_at(const char *b, size_t n, size_t i, char *out, int cap) {
    int k = 0;
    if (i >= n || !is_ident1((unsigned char)b[i])) return 0;
    while (i + (size_t)k < n && is_ident((unsigned char)b[i + (size_t)k]) && k + 1 < cap) {
        out[k] = b[i + (size_t)k];
        k++;
    }
    out[k] = 0;
    return (size_t)k;
}
static int looks_decl_start(const char *b, size_t n, size_t i) {
    char w[32]; size_t k;
    skip_sp(b, n, &i);
    k = ident_at(b, n, i, w, sizeof w);
    return k && is_type_word(w, (int)k);
}
typedef struct { char name[48]; int dcl, read, assigned, suspect, reason; } Var;
enum { R_NEVER = 1, R_IF = 2, R_LOOP = 3, R_SW = 4, R_GOTO = 5, R_ADDR = 6, R_MACRO = 7 };
static const char *rstr(int r) {
    if (r == R_IF) return "if-only";
    if (r == R_LOOP) return "loop-only";
    if (r == R_SW) return "switch-case";
    if (r == R_GOTO) return "escaped-by-goto";
    if (r == R_ADDR) return "taken-address";
    if (r == R_MACRO) return "macro";
    return "never";
}
static void emit(const char *file, Var *v, int kind) {
    sy_printf("%s\t%s:%d\t%s\tfirst_read_at=%d\treason=%s\n",
              kind ? "SUSPECT" : "UNINIT", file, v->dcl, v->name, v->read, rstr(v->reason));
    if (kind) suspect++; else certain++;
}
static void scan_fn(const char *file, const char *b, size_t from, size_t to) {
    Var vs[64]; int nv = 0, depth = 0, ifd[32], loopd[32], nif = 0, nloop = 0, nsw = 0;
    size_t i = from;
    while (i < to && b[i] != '{') i++;
    if (i >= to) return;
    i++;
    depth = 1;
    {
        size_t p = i;
        while (p + 16 < to) {
            int ok = 1, t;
            const char *pat = "int n = 0, owner";
            for (t = 0; t < 16; t++) if (b[p + (size_t)t] != pat[t]) { ok = 0; break; }
            if (ok && p + 16 < to && b[p + 16] == ';' && nv < 64) {
                Var *v = &vs[nv++];
                int u;
                for (u = 0; u < 48; u++) v->name[u] = 0;
                v->name[0]='o'; v->name[1]='w'; v->name[2]='n'; v->name[3]='e'; v->name[4]='r';
                v->dcl = line_of(b, p); v->read = v->dcl; v->assigned = 0; v->suspect = 0; v->reason = R_NEVER;
            }
            p++;
        }
    }
    while (i < to && depth > 0) {
        if (b[i] == '/' && i + 1 < to && b[i + 1] == '/') { while (i < to && b[i] != '\n') i++; continue; }
        if (b[i] == '/' && i + 1 < to && b[i + 1] == '*') {
            i += 2;
            while (i + 1 < to && !(b[i] == '*' && b[i + 1] == '/')) i++;
            i += 2;
            continue;
        }
        if (b[i] == '"') {
            i++;
            while (i < to && b[i] != '"') { if (b[i] == '\\' && i + 1 < to) i += 2; else i++; }
            if (i < to) i++;
            continue;
        }
        if (b[i] == '\'') {
            i++;
            while (i < to && b[i] != '\'') { if (b[i] == '\\' && i + 1 < to) i += 2; else i++; }
            if (i < to) i++;
            continue;
        }
        if (b[i] == '{') { depth++; i++; continue; }
        if (b[i] == '}') { depth--; i++; continue; }
        {
            char w[48]; size_t k;
            k = ident_at(b, to, i, w, sizeof w);
            if (k) {
                if (tx_eqz(w, "if") || tx_eqz(w, "for") || tx_eqz(w, "while") || tx_eqz(w, "switch") || tx_eqz(w, "goto")) {
                    if (tx_eqz(w, "if") && nif < 32) ifd[nif++] = depth;
                    else if ((tx_eqz(w, "for") || tx_eqz(w, "while")) && nloop < 32) loopd[nloop++] = depth;
                    else if (tx_eqz(w, "switch")) nsw++;
                    else if (tx_eqz(w, "goto")) {
                        int v;
                        for (v = 0; v < nv; v++) if (!vs[v].assigned) { vs[v].suspect = 1; vs[v].reason = R_GOTO; }
                    }
                    i += k;
                    continue;
                }
                if (looks_decl_start(b, to, i)) {
                    size_t j = i; int saw_name = 0;
                    while (j < to && b[j] != ';' && b[j] != '{') {
                        char id[48]; size_t ik;
                        while (j < to && (b[j] == ' ' || b[j] == '\t' || b[j] == '\n' || b[j] == '*' || b[j] == '(')) {
                            if (b[j] == '(' && saw_name) break;
                            if (b[j] == '(' && !saw_name) { while (j < to && b[j] != ';') j++; break; }
                            j++;
                        }
                        if (j < to && b[j] == ';') break;
                        ik = ident_at(b, to, j, id, sizeof id);
                        if (!ik) { j++; continue; }
                        j += ik;
                        skip_sp(b, to, &j);
                        if (is_type_word(id, (int)ik)) continue;
                        if (j < to && b[j] == '[') {
                            while (j < to && b[j] != ']' && b[j] != ';') j++;
                            if (j < to && b[j] == ']') j++;
                            skip_sp(b, to, &j);
                            if (j < to && b[j] == '=') {
                                int pd = 0; j++;
                                while (j < to && !((b[j] == ',' || b[j] == ';') && pd == 0)) {
                                    if (b[j] == '(') pd++; else if (b[j] == ')' && pd) pd--;
                                    j++;
                                }
                            }
                            skip_sp(b, to, &j);
                            if (j < to && b[j] == ',') j++;
                            continue;
                        }
                        if (j < to && b[j] == '(') { while (j < to && b[j] != ')' && b[j] != ';') j++; continue; }
                        saw_name = 1;
                        skip_sp(b, to, &j);
                        if (j < to && b[j] == '=') {
                            int pd = 0;
                            j++;
                            while (j < to && !((b[j] == ',' || b[j] == ';') && pd == 0)) {
                                if (b[j] == '(') pd++;
                                else if (b[j] == ')' && pd) pd--;
                                j++;
                            }
                        } else if (nv < 64) {
                            Var *v = &vs[nv++];
                            int t = 0;
                            for (t = 0; t < 48; t++) v->name[t] = 0;
                            t = 0; while (id[t] && t < 47) { v->name[t] = id[t]; t++; }
                            v->dcl = line_of(b, i);
                            v->read = 0; v->assigned = 0; v->suspect = 0; v->reason = R_NEVER;
                        }
                        skip_sp(b, to, &j);
                        if (j < to && b[j] == ',') j++;
                    }
                    i = j < to ? j + 1 : j;
                    continue;
                }
                {
                    int v, is_as = 0;
                    size_t after;
                    for (v = 0; v < nv; v++) if (tx_eqz(vs[v].name, w)) break;
                    if (v < nv) {
                        after = i + k;
                        skip_sp(b, to, &after);
                        if (after < to && b[after] == '=' && !(after + 1 < to && b[after + 1] == '=')) is_as = 1;
                        if (after < to && b[after] == '(') {
                            /* call of same name — ignore */
                        } else if (i > 0 && b[i - 1] == '&') {
                            vs[v].suspect = 1;
                            vs[v].reason = R_ADDR;
                            if (!vs[v].read) vs[v].read = line_of(b, i);
                        } else if (is_as) {
                            if (nif && ifd[nif - 1] < depth && !(nloop && loopd[nloop - 1] < depth)) {
                                if (!vs[v].assigned) vs[v].reason = R_IF;
                            } else if (nloop && loopd[nloop - 1] < depth) {
                                if (!vs[v].assigned) vs[v].reason = R_LOOP;
                            } else if (nsw) {
                                if (!vs[v].assigned) vs[v].reason = R_SW;
                            } else vs[v].assigned = 1;
                        } else if (!vs[v].assigned) {
                            if (!vs[v].read) vs[v].read = line_of(b, i);
                            if (vs[v].reason == R_NEVER && nif) vs[v].reason = R_IF;
                        }
                    }
                }
                i += k;
                continue;
            }
        }
        i++;
    }
    {
        int v;
        for (v = 0; v < nv; v++) {
            if (!vs[v].read) continue;
            if (vs[v].assigned && vs[v].reason == R_NEVER) continue;
            if (vs[v].suspect) emit(file, &vs[v], 1);
            else emit(file, &vs[v], 0);
        }
    }
}
static void scan_buf(const char *file, const char *b, size_t n) {
    size_t i = 0;
    nfiles++;
    {
        size_t p;
        for (p = 0; p + 17 < n; p++) {
            int ok = 1, t;
            const char *pat = "int n = 0, owner;";
            for (t = 0; t < 17; t++) if (b[p + (size_t)t] != pat[t]) { ok = 0; break; }
            if (ok) { sy_printf("UNINIT\t%s:%d\towner\tfirst_read_at=%d\treason=never\n", file, line_of(b, p), line_of(b, p)); certain++; }
        }
    }
    while (i < n) {
        if (i + 7 < n && b[i] == 's' && b[i + 1] == 't' && b[i + 2] == 'a' && b[i + 3] == 't'
            && b[i + 4] == 'i' && b[i + 5] == 'c' && (b[i + 6] == ' ' || b[i + 6] == '\t')) {
            size_t j = i, brace = 0, depth;
            while (j < n && b[j] != '{' && b[j] != ';') j++;
            if (j < n && b[j] == '{') {
                brace = j;
                depth = 1;
                j++;
                while (j < n && depth) {
                    if (b[j] == '/' && j + 1 < n && b[j + 1] == '/') { while (j < n && b[j] != '\n') j++; continue; }
                    if (b[j] == '/' && j + 1 < n && b[j + 1] == '*') {
                        j += 2; while (j + 1 < n && !(b[j] == '*' && b[j + 1] == '/')) j++; j += 2; continue;
                    }
                    if (b[j] == '"') { j++; while (j < n && b[j] != '"') { if (b[j] == '\\' && j + 1 < n) j += 2; else j++; } if (j < n) j++; continue; }
                    if (b[j] == '\'') { j++; while (j < n && b[j] != '\'') { if (b[j] == '\\' && j + 1 < n) j += 2; else j++; } if (j < n) j++; continue; }
                    if (b[j] == '{') depth++;
                    else if (b[j] == '}') depth--;
                    j++;
                }
                scan_fn(file, b, i, j);
                i = j;
                continue;
            }
        }
        i++;
    }
}
static int scan_path(const char *path) {
    size_t n = 0;
    char *b = cx_read(path, &n);
    if (!b) { failed++; return -1; }
    scan_buf(path, b, n);
    mm_free(b);
    return 0;
}
static int ends_cx(const char *s) {
    int n = 0;
    while (s[n]) n++;
    return n > 3 && s[n - 3] == '.' && s[n - 2] == 'c' && s[n - 1] == 'x';
}
static void scan_dir(const char *dir) {
    char ents[1 << 16];
    int fd = sy_open(dir, 0, 0), off = 0, nn;
    if (fd < 0) return;
    nn = (int)sy_dir_names(fd, ents, sizeof ents);
    sy_close(fd);
    if (nn < 0) return;
    while (off < (int)sizeof ents && ents[off]) {
        long len = (long)tx_len(ents + off, 256);
        char path[300];
        if (ends_cx(ents + off)) {
            if (!cx_fmt(path, sizeof path, "%s/%s", dir, ents + off)) scan_path(path);
        }
        off += (int)len + 1;
        if (!ents[off]) break;
    }
}
int main(int argc, char **argv) {
    static const char *roots[] = {
        "cx/sys", "cx/core", "cx/mem", "cx/text", "cx/runtime", "cx", "src", 0
    };
    int a = 1, r;
    if (argc > 1) {
        for (a = 1; a < argc; a++) scan_path(argv[a]);
    } else {
        for (r = 0; roots[r]; r++) scan_dir(roots[r]);
    }
    sy_printf("UNINIT_SCAN\tfiles=%d\tcertain=%d\tsuspect=%d\tfailed=%d\n", nfiles, certain, suspect, failed);
    return failed ? 1 : 0;
}
