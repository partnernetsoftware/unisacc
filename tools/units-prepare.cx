/* 显式部件开发材料，不认证 slice/pkg 与整 APE 同候选或发布资格。
 * ROOT ABS_OUT SLICE MODELS VERSION CARRIERS|- loader|swap|seal|seal-loader。
 * loader 创建新 OUT 并实际编译 test-loader；swap 编译现有 p3-swap；
 * seal 检查全部常规叶、记录实际 SHA，最后输出 loader.env。不使用历史临时文件。
 * SLICE/MODELS 必须由调用者从真实 APE 提取并独立核身份；VERSION 显式指定。
 */
#pragma unisa use cxlib.netpack
#pragma unisa use text.text
#pragma unisa use mem.bytes
static char root[4096],out[4096],slice[4096],models[4096],carriers[4096],product[4400],bound[4400];
static void die(const char *s){fprintf(stderr,"units-prepare: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void path(char *p,const char *a,const char *b){int z=snprintf(p,4400,"%s/%s",a,b);if(z<0||z>=4400)die("path bound");}
static char *load(const char *p,size_t *n){struct stat a,b;if(lstat(p,&a)||!S_ISREG(a.st_mode)||a.st_size<=0||a.st_size>16777216)die("bounded regular input");int fd=open(p,O_RDONLY|O_NOFOLLOW|O_CLOEXEC|O_NONBLOCK);if(fd<0||fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size)die("input descriptor");*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s)die("allocation");size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("input read");at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int changed=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(z||changed||closed)die("input changed");s[*n]=0;return s;}
static void save(const char *name,const char *s,size_t n,int mode){char p[4400];path(p,out,name);int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,mode);if(fd<0||fchmod(fd,(mode_t)mode))die("exclusive output");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("output write");at+=(size_t)z;}int a=fsync(fd),b=close(fd);if(a||b)die("output close");}
static void digest(np_buf *b,const char *name,const char *p){
 size_t n;char h[65],text[100];char *s=load(p,&n);cx_sha256_hex(s,n,h);free(s);
 np_puts(b,name);np_puts(b,"\t");np_puts(b,h);
 if(cx_fmt(text,sizeof text,"\t%lu\n",(unsigned long)n))die("digest size bound");
 np_put(b,text,strlen(text));
}
static void compile(const char *rel,const char *name){
 char source[4400],why[1400];path(source,root,rel);
 char *v[]={bound,"40","sh",product,"-b","lnx/x86_64",source,"-o","-",0};
 np_result r;if(np_run(v,root,0,42,&r,why,sizeof why))die(why);
 char log[100];
 if(cx_fmt(log,sizeof log,"%s.stderr",name))die("stderr name bound");
 save(log,r.err,r.errn,0600);
 char rc[40];
 if(cx_fmt(rc,sizeof rc,"rc\t%d\n",r.rc))die("status bound");
 if(cx_fmt(log,sizeof log,"%s.status",name))die("status name bound");
 save(log,rc,strlen(rc),0600);
 if(r.rc||r.errn||r.outn<64||memcmp(r.out,"\177ELF",4)){if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);die("native tool compiler refused");}
 save(name,r.out,r.outn,0700);np_free(&r);
}
int main(int argc,char **argv){
 if(argc!=8||!realpath(argv[1],root)||argv[2][0]!='/'||strlen(argv[2])>=sizeof out||!realpath(argv[3],slice)||!realpath(argv[4],models)||!argv[5][0])die("usage ROOT ABS_OUT SLICE MODELS VERSION CARRIERS|- loader|swap|seal|seal-loader");
 if(strcmp(argv[6],"-")&&!realpath(argv[6],carriers))die("carrier directory");
 if(mm_copy(out,sizeof out,argv[2],strlen(argv[2])+1))die("output bound");
 const char *safe[]={root,out,slice,models,argv[5],carriers};
 for(int i=0;i<6;i++)if(strpbrk(safe[i],"'\r\n\t"))die("environment quoting");
 path(product,root,"unisacc.com");path(bound,root,"tools/bound");
 if(!strcmp(argv[7],"loader")){
  if(mkdir(out,0700))die("new output required");compile("tools/test-loader.cx","test-loader");
 }else{
  struct stat st;if(lstat(out,&st)||!S_ISDIR(st.st_mode))die("real output directory");
  if(!strcmp(argv[7],"swap"))compile("tools/lab-loader/p3-swap.cx","p3-swap");
  else if(!strcmp(argv[7],"seal")||!strcmp(argv[7],"seal-loader")){
   int loader_only=!strcmp(argv[7],"seal-loader");if(!loader_only&&!carriers[0])die("fan seal requires explicit carriers");
   char loader[4400],swap[4400],source[4400];path(loader,out,"test-loader");path(swap,out,"p3-swap");
   if(access(loader,X_OK)||access(swap,X_OK)||access(slice,X_OK))die("executable materials required");
   np_buf receipt={0},env={0},fan={0};
   np_puts(&receipt,"units-material-v1\nstatus\tPREPARED\nscope\tdevelopment-evidence-no-same-candidate-claim\n");
   digest(&receipt,"bootstrap",product);digest(&receipt,"slice",slice);digest(&receipt,"models",models);digest(&receipt,"loader",loader);digest(&receipt,"swap",swap);
   const char *sources[]={"tools/units-prepare.cx","tools/test-loader.cx","tools/lab-loader/p3-swap.cx"};
   for(int i=0;i<3;i++){path(source,root,sources[i]);digest(&receipt,sources[i],source);}
   if(!loader_only)for(int i=0;i<6;i++){
    char leaf[30];
    if(cx_fmt(leaf,sizeof leaf,"carrier.%d",i))die("carrier name bound");
    path(source,carriers,leaf);digest(&receipt,leaf,source);
   }
   np_puts(&receipt,"version\t");np_puts(&receipt,argv[5]);np_puts(&receipt,"\n");save(loader_only?"loader6-material.tsv":"material.tsv",receipt.p,receipt.n,0600);
   const char *keys[]={"TEST_LOADER_ROOT","TEST_LOADER_LOADER","TEST_LOADER_SLICE","TEST_LOADER_MODELS","TEST_LOADER_SWAP","TEST_LOADER_CARRIER_DIR","TEST_LOADER_TARGET","TEST_LOADER_VERSION"};
   const char *values[]={root,loader,slice,models,swap,carriers,"lnx/x86_64",argv[5]};
   for(int i=0;i<8;i++){
    if(loader_only&&i==5)continue;
    np_puts(&env,"export ");np_puts(&env,keys[i]);np_puts(&env,"='");np_puts(&env,values[i]);np_puts(&env,"'\n");
    if(i<6){np_puts(&fan,keys[i]);np_puts(&fan,"=");np_puts(&fan,values[i]);np_puts(&fan,"\n");}
   }
   if(loader_only)save("loader6.env",env.p,env.n,0600);else{save("loader-shell.env",env.p,env.n,0600);save("loader.env",fan.p,fan.n,0600);}
   free(fan.p);free(env.p);free(receipt.p);
  }else die("unknown stage");
 }
 printf("PREPARED\tunits-material\tstage=%s\tno-test-result\n",argv[7]);return 0;
}
