/* 准备 fan --env 材料到绝对 OUT。幂等只报 PREPARED。不宣称发布资格。
 * sh ./unisacc.com tools/units-prepare.cx -- --out ABS
 */
#pragma unisa use sys.fs
#pragma unisa use text.text
#pragma unisa use mem.bytes
static void die(const char *s){fprintf(stderr,"units-prepare: %s\n",s);exit(2);}
static void cpy(const char *a,const char *b){
    size_t n;char *s=cx_read(a,&n);if(!s)die("copy src");if(cx_write(b,s,n))die("copy dst");free(s);
}
int main(int argc,char **argv){
    const char *out=0;char envp[4400],slice[4400],pkg[4400],loader[4400],car[4400],body[2000];int i;
    for(i=1;i<argc;i++){
        if(!strcmp(argv[i],"--out")&&i+1<argc)out=argv[++i];
        else if(!strcmp(argv[i],"--"))continue;
        else die("usage --out ABS");
    }
    if(!out||out[0]!='/')die("--out must be absolute");
    if(cx_fmt(envp,sizeof envp,"%s/loader.env",out))die("path");
    if(!access(envp,R_OK)){printf("PREPARED\tout=%s\talready=1\n",out);return 0;}
    if(mkdir(out,0700)&&errno!=EEXIST)die("mkdir");
    if(access("/tmp/loaderimpl/test-loader-C1",R_OK)||access("/tmp/loader-ape-proof-dbISgu/slice",R_OK)
       ||access("/tmp/loader-ape-proof-dbISgu/pkg",R_OK)||access("/tmp/check-loader-nets-rgymqr/carrier.0",R_OK))
        die("frozen extract missing; need test-loader-C1 + ape-proof slice/pkg + rgymqr carriers");
    if(cx_fmt(loader,sizeof loader,"%s/test-loader",out)||cx_fmt(slice,sizeof slice,"%s/slice",out)
       ||cx_fmt(pkg,sizeof pkg,"%s/pkg",out)||cx_fmt(car,sizeof car,"%s/carriers",out))die("path");
    if(mkdir(car,0700)&&errno!=EEXIST)die("carriers mkdir");
    cpy("/tmp/loaderimpl/test-loader-C1",loader);chmod(loader,0755);
    cpy("/tmp/loader-ape-proof-dbISgu/slice",slice);chmod(slice,0755);
    cpy("/tmp/loader-ape-proof-dbISgu/pkg",pkg);
    {const char *n[]={"carrier.0","carrier.1","carrier.2","carrier.3","carrier.4","carrier.5",0};int k;
     for(k=0;n[k];k++){char a[4400],b[4400];
      if(cx_fmt(a,sizeof a,"/tmp/check-loader-nets-rgymqr/%s",n[k])||cx_fmt(b,sizeof b,"%s/%s",car,n[k]))die("cpath");
      cpy(a,b);}
    }
    if(cx_fmt(body,sizeof body,
        "TEST_LOADER_ROOT=/home/devali/repos/unisacc\nTEST_LOADER_LOADER=%s\nTEST_LOADER_SLICE=%s\nTEST_LOADER_MODELS=%s\nTEST_LOADER_CARRIER_DIR=%s\n",
        loader,slice,pkg,car))die("env");
    if(cx_write(envp,body,strlen(body)))die("env write");
    printf("PREPARED\tout=%s\tenv=%s\tscope=development-evidence\n",out,envp);
    return 0;
}
