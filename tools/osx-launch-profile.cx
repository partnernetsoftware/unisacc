/* One architecture per invocation. Warm launches are measured, never cached. */
#pragma unisa use sysx.process
#pragma unisa use sys.time
#pragma unisa use sys.hostid
#pragma unisa use mem.bytes
static long lp_deadline;
static void lp_die(const char *s){fprintf(stderr,"osx-launch-profile: %s\n",s);exit(2);}
static long lp_median2(long *v){long a[10];for(int i=0;i<10;i++)a[i]=v[i];for(int i=1;i<10;i++){long x=a[i];int j=i;while(j&&a[j-1]>x){a[j]=a[j-1];j--;}a[j]=x;}return a[4]+a[5];}
static int lp_samples(int argc,char **argv){if(argc!=13)return 2;int limit=!strcmp(argv[2],"version")?50:!strcmp(argv[2],"run")?300:0;if(!limit)return 2;long a[10];for(int i=0;i<10;i++){char *end=0;errno=0;a[i]=strtol(argv[i+3],&end,10);if(errno||!*argv[i+3]||*end||a[i]<0||a[i]>60000)return 2;}long m=lp_median2(a);printf("LAUNCH_SAMPLE_EVALUATION\tmode=%s\tmedian_x2_ms=%ld\tlimit_ms=%d\tsynthetic=1\n",argv[2],m,limit);return m<=limit*2?0:1;}
static void lp_hash(const char *p,char h[65]){struct stat st;if(stat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<=0||st.st_size>67108864)lp_die("regular APE <=64MiB required");size_t n;char*b=cx_read(p,&n);if(!b||n!=(size_t)st.st_size)lp_die("read APE");cx_sha256_hex(b,n,h);free(b);}
static int lp_one(char **v,const char *mode,int index,int expected){if(lp_deadline-sy_now_ms()<5100)lp_die("overall deadline: incomplete measurement");np_result r={0};char why[1000]={0};long t=sy_now_ms();int tr=np_run(v,0,0,5,&r,why,sizeof why);long ms=sy_now_ms()-t;int valid=!tr&&!r.residue&&r.rc==expected;if(!strcmp(mode,"version")&&(!r.out||!r.outn||!strstr(r.out,"unisacc")))valid=0;printf("LAUNCH\tmode=%s\tindex=%d\twarmup=%d\telapsed_ms=%ld\trc=%d\ttransport=%d\tresidue=%d\tvalid=%d\n",mode,index,index==0,ms,r.rc,tr,r.residue,valid);if(!valid){fprintf(stderr,"launch rejected: mode=%s rc=%d transport=%d residue=%d %s\n",mode,r.rc,tr,r.residue,why);if(r.errn)fwrite(r.err,1,r.errn,stderr);}np_free(&r);if(!valid)return -1;return (int)ms;}
int main(int argc,char **argv){if(argc>1&&!strcmp(argv[1],"--samples"))return lp_samples(argc,argv);if(argc!=3){fprintf(stderr,"usage: osx-launch-profile APE arm64|x86_64\n");return 2;}if(strncmp(tn_self(),"osx/",4))lp_die("Darwin host required");const char *arch=!strcmp(argv[2],"arm64")?"-arm64":!strcmp(argv[2],"x86_64")?"-x86_64":0;if(!arch)lp_die("unknown architecture");lp_deadline=sy_now_ms()+52000;char ape[4400],before[65],after[65];if(!realpath(argv[1],ape))lp_die("APE path");lp_hash(ape,before);char tmp[]="/tmp/osx-launch-profile-XXXXXX";if(!mkdtemp(tmp))lp_die("fresh fixture directory");char r7[4500];if(cx_fmt(r7,sizeof r7,"%s/r7.c",tmp)||cx_write(r7,"int main(void){return 7;}\n",26))lp_die("r7 source");printf("OSX_LAUNCH_IDENTITY\tape=%s\tsha256=%s\tarch=%s\thost=%s\tscope=warm-launch-only\n",ape,before,argv[2],tn_self());char *version[]={"/usr/bin/arch",(char*)arch,"/bin/sh",ape,"--version",0};char *run[]={"/usr/bin/arch",(char*)arch,"/bin/sh",ape,"-run",r7,0};long measurements[2][10];const char *modes[]={"version","run"};int failed=0;for(int group=0;group<2;group++){for(int i=0;i<=10;i++){int ms=lp_one(group?run:version,modes[group],i,group?7:0);if(ms<0){unlink(r7);rmdir(tmp);return 1;}if(i)measurements[group][i-1]=ms;}long med=lp_median2(measurements[group]);int limit=group?300:50;int pass=med<=2*limit;failed+=!pass;printf("LAUNCH_MEDIAN\tmode=%s\tn=10\tmedian_x2_ms=%ld\tlimit_ms=%d\tstatus=%s\n",modes[group],med,limit,pass?"PASS":"FAIL");}lp_hash(ape,after);if(strcmp(before,after))lp_die("APE changed during measurements");if(unlink(r7)||rmdir(tmp))lp_die("fixture cleanup");printf("OSX_LAUNCH_PROFILE\tstatus=%s\tarch=%s\tsha256=%s\tversion_n=10\trun_n=10\tidentity_stable=1\n",failed?"FAIL":"PASS",argv[2],before);return failed?1:0;}
