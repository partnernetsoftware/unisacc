/* tools/check-uxe-tex16-proj.cx -- 转调 uxe-tex16-proj --write 后再 -- 无 write 应仍可跑.
 * sh ./unisacc.com tools/check-uxe-tex16-proj.cx --
 */
int main(void) {
    char *av[6];
    char *out = 0;
    size_t n = 0;
    int rc;
    av[0] = "sh"; av[1] = "./unisacc.com"; av[2] = "tools/uxe-tex16-proj.cx";
    av[3] = "--"; av[4] = 0;
    rc = cx_runv_timeout(av, 20, &out, &n);
    if (out && n) fwrite(out, 1, n, stdout);
    if (out) free(out);
    return rc == 0 ? 0 : 1;
}
