/* tools/cx-lint.cx -- token-level lint for .cx tools and tests (report only).
 *
 *   sh ./unisacc.com tools/cx-lint.cx [-- [--strict] [--rules R2,R1-version,...] [PATH...]]
 *
 * Without PATH, lints every tracked tools/ and tests/ .cx file (git ls-files, bounded 30 s).
 * A small C lexer skips // and block comments, string/char literals (with escapes) and
 * backslash-newline continuations; rules then run on the token stream of each top-level
 * brace block (a function body; file-scope tokens form one block of their own).
 *
 *   R1 second source of truth
 *     R1-version  a string literal holding a release version "0.0.N" with N >= 10 or
 *                 "unisacc 0.0." outside tools/cxlib/releaseversion.cx.  A literal that is a file
 *                 name (contains '/', or ends in .md/.tsv) is a reference, not reported.  Exempt in test code
 *                 (a path under tests/ or a tools/check-*.cx) when the literal is refusal data:
 *                 the same block names refuse/reject/invalid/bad/expect_fail (identifier or
 *                 literal, any case) or the statement is wrapped in ck(!...).
 *     R1-product  a product path literal ("unisacc.com" or ".../unisacc.com", no spaces) that
 *                 actually reaches a child process: the literal itself, or an identifier filled
 *                 from it in the same block (x = ...lit... or f(x, ..., lit)), lands in an argv
 *                 slot (v[n++] = x, {x, ...}, {..., x, ...}) or is the first argument of a run
 *                 call (sy_run, sy_spawn..., cx_run..., runv).  A name refilled by the same call or
 *                 assignment without the literal (path(p, root, "seed.c") after path(p, root,
 *                 "unisacc.com")) drops the taint until refilled with it.  APPROXIMATION:
 *                 block-scoped data flow over names; a literal that is only compared,
 *                 existence-checked, labelled or passed to a guard helper is not reported.
 *     lint:allow  a trailing comment  "lint:allow R1 REASON" (block or // comment, e.g.
 *                 // lint:allow R1-version REASON) on the reported line suppresses an R1 rule whose name starts with the
 *                 given token; REASON must be non-empty or the allow is ignored (stderr note).
 *                 R2 rules cannot be allowed; R3 rules can.
 *   R2 child processes
 *     R2-timeout  sy_run / sy_spawn / sy_spawn_inherit / sy_spawn_pipe / cx_run / cx_runv
 *                 (APIs with no time-limit parameter) called in a block that names no
 *                 bound/timeout/deadline (identifier or literal).  APPROXIMATION: any such
 *                 word in the block counts as a guard.
 *     R2-sep      an argv built as <unisacc.com> <TOOL.cx> "--x..." (the product, then a .cx
 *                 tool, then a literal starting with "--" that is not "--") or one shell
 *                 literal "... unisacc.com T.cx --x" (a literal containing escaped quotes \"
 *                 is embedded source, e.g. a lint fixture, and is skipped).  The product/tool may be literals or
 *                 identifiers first filled from a call with such a literal (cx_fmt(com, ..,
 *                 "%s/unisacc.com")).
 *
 * --rules LIST   only rules whose name starts with one of the comma-separated prefixes are
 *                reported and counted (R2 = R2-timeout + R2-sep).
 *   R3 failure helpers
 *     R3-die      a function "void NAME(...)" whose name ends in "die" (not "_or_die", a
 *                 conditional helper) and whose body's last statement is not a call to exit /
 *                 _exit / _Exit / sy_exit / abort or another die-named function.  The product
 *                 has no _Noreturn, so a die that loses its exit turns every failure silent
 *                 (release-build rb_die, 0.0.50).  An int-returning die ("return die(..)") is
 *                 not covered.  lint:allow R3-die REASON on the header line suppresses it.
 *
 *   R4-source-anchor (cannot be allowed)
 *     Source-path literals (.c/.h/.cx/.inc/.in), path construction, read returns,
 *     assignments, aliases and same-file helper parameters/returns are propagated to
 *     substring/mutation helpers. Unknown cx_read origins are refused after path
 *     propagation settles; explicit TSV paths remain facts. Source text requires
 *     token/AST analysis. Punctuation searches up to two bytes permit lexing.
 *     This conservative same-file analysis is not arbitrary C: no preprocessor
 *     expansion, general indirect calls, pointer/field aliases or cross-file summaries.
 *     Function scopes separate locals; first-parameter read/path wrappers have
 *     call-site summaries. Private paths require a child argv consumer or a write
 *     from observed child output before raw reads are accepted. Source copies and
 *     source extensions override that approximate producer contract; it is not a
 *     proof of arbitrary child filesystem effects. Unknown reads remain refused.
 *
 * Output:  LINT<TAB>rule<TAB>path:line<TAB>summary, then
 *          CX_LINT<TAB>files=N<TAB>findings=M<TAB>elapsed_ms=T
 * Exit 0 always; with --strict, 1 when any finding; 2 on IO errors.  A path that is ENOENT (a
 * dangling tracked symlink) is skipped with a stderr note and not counted in files=. */
#pragma unisa use sys.fs
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

enum { T_ID, T_STR, T_CHR, T_NUM, T_P };
typedef struct { int kind, line; const char *s; long n; } Tok;

static Tok *toks; static long ntok, captok;
static long findings, missing;
static const char *cur_path;
static const char *rules_filter;   /* --rules LIST or 0 */

#define MAXALLOW 512
typedef struct { int line; char rule[24]; } Allow;
static Allow allows[MAXALLOW]; static int nallow;

static void push(int kind, int line, const char *s, long n) {
    if (ntok == captok) {
        long c = captok ? captok * 2 : 4096;
        Tok *g = mm_grow(toks, c * (long)sizeof(Tok));
        if (!g) { fprintf(stderr, "cx-lint: out of memory\n"); exit(2); }
        toks = g; captok = c;
    }
    toks[ntok].kind = kind; toks[ntok].line = line; toks[ntok].s = s; toks[ntok].n = n; ntok++;
}
static int idc(int c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || (c >= '0' && c <= '9'); }
static int sp(int c) { return c == ' ' || c == '\t' || c == '\r' || c == '\n'; }

/* A comment body C[0..n) at LINE: record "lint:allow RULE REASON" when REASON is non-empty. */
static void note_allow(const char *c, long n, int line) {
    long p = tx_find(c, n, "lint:allow", 10), q, r;
    if (p < 0) return;
    p += 10;
    while (p < n && sp(c[p])) p++;
    q = p;
    while (q < n && (idc(c[q]) || c[q] == '-')) q++;
    if (q == p || q - p >= 24) { fprintf(stderr, "cx-lint: %s:%d: lint:allow without a rule name is ignored\n", cur_path, line); return; }
    r = q;
    while (r < n && sp(c[r])) r++;
    if (r >= n) { fprintf(stderr, "cx-lint: %s:%d: lint:allow %.*s without a reason is ignored\n", cur_path, line, (int)(q - p), c + p); return; }
    if (nallow < MAXALLOW) {
        allows[nallow].line = line;
        mm_copy(allows[nallow].rule, sizeof allows[nallow].rule, c + p, (size_t)(q - p));
        allows[nallow].rule[q - p] = 0;
        nallow++;
    }
}

/* Lex B[0..n); string/char tokens hold the raw bytes between the quotes. */
static void lex(const char *b, long n) {
    long i = 0; int line = 1;
    ntok = 0; nallow = 0;
    while (i < n) {
        char c = b[i];
        if (c == '\n') { line++; i++; continue; }
        if (c == '\\' && i + 1 < n && b[i + 1] == '\n') { line++; i += 2; continue; }
        if (c == '\\' && i + 2 < n && b[i + 1] == '\r' && b[i + 2] == '\n') { line++; i += 3; continue; }
        if (c == ' ' || c == '\t' || c == '\r' || c == '\f' || c == '\v') { i++; continue; }
        if (c == '/' && i + 1 < n && b[i + 1] == '/') {
            long s = i + 2; int l0 = line;
            while (i < n && b[i] != '\n') { if (b[i] == '\\' && i + 1 < n && b[i + 1] == '\n') { line++; i++; } i++; }
            note_allow(b + s, i - s, l0);
            continue;
        }
        if (c == '/' && i + 1 < n && b[i + 1] == '*') {
            long s; int l0 = line;
            i += 2; s = i;
            while (i < n && !(b[i] == '*' && i + 1 < n && b[i + 1] == '/')) { if (b[i] == '\n') line++; i++; }
            note_allow(b + s, i - s, l0);
            i += 2; continue;
        }
        if (c == '"' || c == '\'') {
            long s = ++i; int l0 = line;
            while (i < n && b[i] != c && b[i] != '\n') { if (b[i] == '\\' && i + 1 < n) { if (b[i + 1] == '\n') line++; i++; } i++; }
            push(c == '"' ? T_STR : T_CHR, l0, b + s, i - s);
            if (i < n && b[i] == c) i++;
            continue;
        }
        if (idc(c)) {
            long s = i;
            if (c >= '0' && c <= '9') { while (i < n && (idc(b[i]) || b[i] == '.')) i++; push(T_NUM, line, b + s, i - s); }
            else { while (i < n && idc(b[i])) i++; push(T_ID, line, b + s, i - s); }
            continue;
        }
        push(T_P, line, b + i, 1); i++;
    }
}

static int is(const Tok *t, int kind, const char *w) { return t->kind == kind && tx_same(t->s, t->n, w, tx_len(w, 256)); }
static int has(const Tok *t, const char *w) { return tx_contains(t->s, t->n, w, tx_len(w, 256)); }
static int ends(const Tok *t, const char *w) { return tx_suffix(t->s, t->n, w, tx_len(w, 256)); }

static int rule_selected(const char *rule) {
    const char *p = rules_filter; long rl = tx_len(rule, 32);
    if (!p) return 1;
    while (*p) {
        long l = 0;
        while (p[l] && p[l] != ',') l++;
        if (l > 0 && l <= rl && tx_same(rule, l, p, l)) return 1;
        p += l; if (*p == ',') p++;
    }
    return 0;
}
static int allowed(const char *rule, int line) {
    int j; long rl = tx_len(rule, 32);
    if (rule[0] != 'R' || (rule[1] != '1' && rule[1] != '3')) return 0;   /* R2 rules cannot be allowed */
    for (j = 0; j < nallow; j++) {
        long al = tx_len(allows[j].rule, 24);
        if (allows[j].line == line && al <= rl && tx_same(rule, al, allows[j].rule, al)) return 1;
    }
    return 0;
}

static void report(const char *rule, int line, const char *fmt, const Tok *t) {
    int k = t ? (int)(t->n > 60 ? 60 : t->n) : 0;
    if (!rule_selected(rule) || allowed(rule, line)) return;
    printf("LINT\t%s\t%s:%d\t", rule, cur_path, line);
    printf(fmt, k, t ? t->s : "");
    printf("\n");
    findings++;
}

static int product_lit(const Tok *t) {
    return t->kind == T_STR && tx_chr(t->s, t->n, ' ') < 0 &&
           (is(t, T_STR, "unisacc.com") || ends(t, "/unisacc.com"));
}
static int version_lit(const Tok *t) {
    long i;
    if (t->kind != T_STR) return 0;
    if (has(t, "unisacc 0.0.")) return 1;   /* lint:allow R1-version the matcher's own pattern, not a version claim */
    if (tx_chr(t->s, t->n, '/') >= 0 || ends(t, ".md") || ends(t, ".tsv")) return 0;   /* a file name carrying a version is a reference, not a claim */
    for (i = 0; i + 5 < t->n; i++) {
        const char *s = t->s + i;
        if ((i == 0 || !(s[-1] >= '0' && s[-1] <= '9') ) && s[0] == '0' && s[1] == '.' && s[2] == '0' && s[3] == '.' &&
            s[4] >= '1' && s[4] <= '9' && i + 5 < t->n && s[5] >= '0' && s[5] <= '9') return 1;
    }
    return 0;
}
static const char *untimed[] = {"sy_run", "sy_spawn", "sy_spawn_inherit", "sy_spawn_pipe", "cx_run", "cx_runv", 0};
static int untimed_call(long k, long e) {
    int j;
    if (toks[k].kind != T_ID || k + 1 >= e || !is(&toks[k + 1], T_P, "(")) return 0;
    for (j = 0; untimed[j]; j++) if (is(&toks[k], T_ID, untimed[j])) return 1;
    return 0;
}
static int run_call(long k, long e) {
    if (toks[k].kind != T_ID || k + 1 >= e || !is(&toks[k + 1], T_P, "(")) return 0;
    return untimed_call(k, e) || is(&toks[k], T_ID, "cx_run_timeout") || is(&toks[k], T_ID, "cx_runv_timeout") ||
           is(&toks[k], T_ID, "runv");
}
static int guard_word(const Tok *t) {
    if (t->kind != T_ID && t->kind != T_STR) return 0;
    return has(t, "bound") || has(t, "timeout") || has(t, "deadline") || has(t, "Timeout") || has(t, "Deadline");
}
/* a word that marks test data meant to be refused */
static int refusal_word(const Tok *t) {
    if (t->kind != T_ID && t->kind != T_STR) return 0;
    return has(t, "refuse") || has(t, "REFUSE") || has(t, "Refuse") || has(t, "reject") || has(t, "REJECT") || has(t, "Reject") ||
           has(t, "invalid") || has(t, "INVALID") || has(t, "Invalid") || has(t, "bad") || has(t, "BAD") || has(t, "Bad") ||
           has(t, "expect_fail") || has(t, "expect-fail");
}

#define MAXT 64
/* kind 1 product, 2 .cx tool; lit = token index of the literal; fn = token index of the filling call's
   name (-1 for "x = ..."); off = the name was since refilled by the same call/assignment without the literal */
typedef struct { const char *s; long n; int kind; long lit, fn; int done, off; } Taint;
static Taint taint[MAXT]; static int ntaint;
static int taint_of(const Tok *t) {
    int j;
    if (t->kind == T_STR) return product_lit(t) ? 1 : ends(t, ".cx") ? 2 : 0;
    if (t->kind != T_ID) return 0;
    for (j = 0; j < ntaint; j++) if (tx_same(taint[j].s, taint[j].n, t->s, t->n)) return taint[j].off ? 0 : taint[j].kind;
    return 0;
}
/* Token K is the name being refilled by the same call (f(K, ...)) or assignment (K = ...) that tainted it:
   the taint follows the statement -- on when it holds the literal kind again, off otherwise. */
static void refill(long k, long stmt, long e) {
    int j; long q, end;
    for (j = 0; j < ntaint; j++) {
        Taint *te = &taint[j]; int same = 0;
        if (!tx_same(te->s, te->n, toks[k].s, toks[k].n)) continue;
        if (te->fn >= 0) same = k >= 2 && is(&toks[k - 1], T_P, "(") && k + 1 < e && is(&toks[k + 1], T_P, ",") &&
                                 toks[k - 2].kind == T_ID && tx_same(toks[k - 2].s, toks[k - 2].n, toks[te->fn].s, toks[te->fn].n);
        else same = k + 2 < e && is(&toks[k + 1], T_P, "=") && !is(&toks[k + 2], T_P, "=");
        if (!same) continue;
        for (end = stmt; end < e && !is(&toks[end], T_P, ";") && !is(&toks[end], T_P, "{") && !is(&toks[end], T_P, "}"); end++) ;
        te->off = 1;
        for (q = stmt; q < end; q++)
            if (toks[q].kind == T_STR && (te->kind == 1 ? product_lit(&toks[q]) : ends(&toks[q], ".cx"))) { te->off = 0; break; }
    }
}
static Taint *taint_entry(const Tok *t) {
    int j;
    if (t->kind != T_ID) return 0;
    for (j = 0; j < ntaint; j++) if (tx_same(taint[j].s, taint[j].n, t->s, t->n)) return &taint[j];
    return 0;
}

/* Token index K sits in an argv slot: "] = K", "{ K", or ", K" directly inside a brace initializer
   (OPEN is the innermost unclosed bracket at K).  A "(char *)" cast before K is skipped. */
static int argv_init(long k, long e) {   /* the brace initializer around K is NULL-terminated: "..., 0 }" */
    long q; int d = 0;
    for (q = k; q < e; q++) {
        if (is(&toks[q], T_P, "{") || is(&toks[q], T_P, "(") || is(&toks[q], T_P, "[")) d++;
        else if (is(&toks[q], T_P, ")") || is(&toks[q], T_P, "]")) d--;
        else if (is(&toks[q], T_P, "}")) {
            if (d-- == 0) return q > k && (is(&toks[q - 1], T_NUM, "0") || is(&toks[q - 1], T_ID, "NULL"));
        }
        else if (is(&toks[q], T_P, ";")) return 0;
    }
    return 0;
}
static int argv_slot(long k, long b, long e, char open) {
    long p = k - 1;
    if (p >= b + 3 && is(&toks[p], T_P, ")") && is(&toks[p - 1], T_P, "*") && toks[p - 2].kind == T_ID && is(&toks[p - 3], T_P, "("))
        p -= 4;
    if (p < b) return 0;
    if (is(&toks[p], T_P, "=") && p > b && is(&toks[p - 1], T_P, "]")) return 1;
    if (is(&toks[p], T_P, "{") || (is(&toks[p], T_P, ",") && open == '{')) return argv_init(k, e);
    return 0;
}

/* Rules over the tokens [b, e) of one top-level block. */
static void block(long b, long e, int versions_ok, int testish) {
    long k, s, stmt = b; int guarded = 0, refusing = 0;
    char stack[64]; int depth = 0;
    ntaint = 0;
    for (k = b; k < e; k++) { if (guard_word(&toks[k])) guarded = 1; if (refusal_word(&toks[k])) refusing = 1; }
    /* taint: statement with a product/.cx literal -> its first call's first identifier argument, or the
       identifier left of '=' */
    for (s = b; s < e; ) {
        long t = s, lit = 0; int kind = 0;
        while (t < e && !is(&toks[t], T_P, ";") && !is(&toks[t], T_P, "{") && !is(&toks[t], T_P, "}")) {
            if (!kind && toks[t].kind == T_STR) { kind = product_lit(&toks[t]) ? 1 : ends(&toks[t], ".cx") ? 2 : 0; lit = t; }
            t++;
        }
        if (kind && ntaint < MAXT) {
            long q;
            for (q = s; q < lit; q++) {
                if (is(&toks[q], T_P, "(") && toks[q + 1].kind == T_ID && q + 2 < lit && is(&toks[q + 2], T_P, ",")) {
                    if (taint_entry(&toks[q + 1])) break;   /* already tracked under this name: first filling statement wins */
                    taint[ntaint].s = toks[q + 1].s; taint[ntaint].n = toks[q + 1].n; taint[ntaint].kind = kind;
                    taint[ntaint].lit = lit; taint[ntaint].fn = q > s && toks[q - 1].kind == T_ID ? q - 1 : -1;
                    taint[ntaint].done = 0; taint[ntaint].off = 0; ntaint++; break;
                }
                if (is(&toks[q], T_P, "=") && q > s && toks[q - 1].kind == T_ID && !is(&toks[q + 1], T_P, "=")) {
                    if (taint_entry(&toks[q - 1])) break;
                    taint[ntaint].s = toks[q - 1].s; taint[ntaint].n = toks[q - 1].n; taint[ntaint].kind = kind;
                    taint[ntaint].lit = lit; taint[ntaint].fn = -1; taint[ntaint].done = 0; taint[ntaint].off = 0; ntaint++; break;
                }
            }
        }
        s = t + 1;
    }
    for (k = b; k < e; k++) {
        Tok *t = &toks[k];
        char open = depth ? stack[depth - 1] : 0;
        if (t->kind == T_P) {
            if (t->s[0] == '(' || t->s[0] == '[' || t->s[0] == '{') { if (depth < 64) stack[depth] = t->s[0]; depth++; }
            else if ((t->s[0] == ')' || t->s[0] == ']' || t->s[0] == '}') && depth > 0) depth--;
            if (t->s[0] == ';' || t->s[0] == '{' || t->s[0] == '}') stmt = k + 1;
        }
        if (!versions_ok && version_lit(t)) {
            int exempt = 0;
            if (testish) {
                long q;
                exempt = refusing;
                for (q = stmt; q + 2 < k && !exempt; q++)
                    if (is(&toks[q], T_ID, "ck") && is(&toks[q + 1], T_P, "(") && is(&toks[q + 2], T_P, "!")) exempt = 1;
            }
            if (!exempt) report("R1-version", t->line, "version literal \"%.*s\" outside releaseversion", t);
        }
        if (t->kind == T_ID && taint_entry(t)) refill(k, stmt, e);
        /* R1-product: the literal, or a name filled from it, reaches an argv slot or a run call's first argument */
        if (product_lit(t) && argv_slot(k, b, e, open))
            report("R1-product", t->line, "product path literal \"%.*s\" placed in an argv slot", t);
        else if (t->kind == T_ID && taint_of(t) == 1) {
            Taint *te = taint_entry(t);
            int hit = argv_slot(k, b, e, open);
            if (!hit && k >= b + 2 && is(&toks[k - 1], T_P, "(") && run_call(k - 2, e)) hit = 1;
            if (hit && te && !te->done) {
                te->done = 1;
                report("R1-product", toks[te->lit].line, "product path literal \"%.*s\" fills a name that reaches a child argv", &toks[te->lit]);
            }
        }
        if (untimed_call(k, e) && !guarded) report("R2-timeout", t->line, "%.*s( with no bound/timeout/deadline in the block", t);
        if (t->kind == T_STR && tx_find(t->s, t->n, "\\\"", 2) < 0) {   /* one shell literal "... unisacc.com X.cx --opt"; a literal holding
                                                                           escaped quotes is embedded source/data (a lint fixture), not a command */
            long p = tx_find(t->s, t->n, "unisacc.com ", 12);
            if (p >= 0) {
                long q = tx_find(t->s + p, t->n - p, ".cx ", 4);
                if (q >= 0) {
                    const char *a = t->s + p + q + 4; long rest = t->n - p - q - 4;
                    if (rest >= 3 && a[0] == '-' && a[1] == '-' && a[2] != ' ')
                        report("R2-sep", t->line, "shell literal runs a .cx tool with --option but no -- separator: \"%.*s\"", t);
                }
            }
        }
        if (taint_of(t) == 1 && !is(&toks[k - 1], T_P, "(")) {   /* argv element, not a cx_fmt destination */
            long q, lim = k + 24 < e ? k + 24 : e;
            for (q = k + 1; q < lim; q++) {
                if (is(&toks[q], T_P, ";") && q + 1 < lim && is(&toks[q + 1], T_P, "}")) break;
                if (taint_of(&toks[q]) == 2 && !is(&toks[q - 1], T_P, "(")) {
                    long r;
                    for (r = q + 1; r < lim + 12 && r < e; r++) {
                        if (toks[r].kind == T_STR) {
                            if (toks[r].n > 2 && toks[r].s[0] == '-' && toks[r].s[1] == '-')
                                report("R2-sep", toks[r].line, "argv runs a .cx tool then \"%.*s\" with no \"--\" separator", &toks[r]);
                            break;
                        }
                        if (toks[r].kind == T_ID && taint_of(&toks[r]) == 0 && !is(&toks[r], T_ID, "char") && !is(&toks[r], T_ID, "n") &&
                            !is(&toks[r], T_ID, "a") && !is(&toks[r], T_ID, "av") && !is(&toks[r], T_ID, "argv") && !is(&toks[r], T_ID, "v")) {
                            if (r + 1 < e && (is(&toks[r + 1], T_P, ",") || is(&toks[r + 1], T_P, ";") || is(&toks[r + 1], T_P, "}"))) break;
                        }
                    }
                    break;
                }
            }
        }
    }
}

/* R3-die: a name that ends in "die" (but not "_or_die", a conditional helper). */
static int die_name(const Tok *t) {
    return t->kind == T_ID && ends(t, "die") && !ends(t, "_or_die");
}
static int exit_call(long k, long e) {
    const Tok *t = &toks[k];
    if (t->kind != T_ID || k + 1 >= e || !is(&toks[k + 1], T_P, "(")) return 0;
    return is(t, T_ID, "exit") || is(t, T_ID, "_exit") || is(t, T_ID, "_Exit") || is(t, T_ID, "sy_exit") ||
           is(t, T_ID, "abort") || die_name(t);
}
/* Token K opens a top-level block.  The index of the function name when the header is
   "void NAME(...)" with a die name, else -1. */
static long die_header(long k) {
    long p = k - 1; int d = 0;
    if (p < 3 || !is(&toks[p], T_P, ")")) return -1;
    for (; p >= 0; p--) {
        if (is(&toks[p], T_P, ")")) d++;
        else if (is(&toks[p], T_P, "(") && --d == 0) break;
    }
    if (p < 2 || !die_name(&toks[p - 1]) || !is(&toks[p - 2], T_ID, "void")) return -1;
    return p - 1;
}
/* The body [b, e] of die function NAME ({ at b, } at e): its last statement must be an exit call. */
static void die_tail(long name, long b, long e) {
    long q = e - 2; int d = 0;
    if (e - 1 > b && is(&toks[e - 1], T_P, ";")) {
        for (; q > b; q--) {
            if (is(&toks[q], T_P, ")")) d++;
            else if (is(&toks[q], T_P, "(")) d--;
            else if (d == 0 && (is(&toks[q], T_P, ";") || is(&toks[q], T_P, "{") || is(&toks[q], T_P, "}"))) break;
        }
        if (exit_call(q + 1, e)) return;
    }
    report("R3-die", toks[name].line, "%.*s( does not end in an exit call: a die that returns lets the caller continue", &toks[name]);
}

static int testish_path(const char *path) {
    long n = tx_len(path, 4096), i, base = 0;
    for (i = 0; i < n; i++) if (path[i] == '/') base = i + 1;
    if (tx_prefix(path, n, "tests/", 6) || tx_find(path, n, "/tests/", 7) >= 0) return 1;
    return tx_prefix(path + base, n - base, "check-", 6);
}

/* R4 reuses lex/is/report. Monotone name flow deliberately has no allow path.
 * Bounded table exhaustion is itself a finding (never a silent analysis truncation). */
#define MAXANCHOR 2048
typedef struct { Tok name; long scope; int source; } Anchor;
static Anchor anchor[MAXANCHOR]; static int nanchor;
static long *anchor_scopes;
static int *anchor_reads, *anchor_builders, *anchor_runners;
typedef struct { const Tok *name; long first,last; int global,reads,builders,runners; } AnchorMeta;
static AnchorMeta *anchor_meta_table; static long anchor_meta_cap;
static long *anchor_ends,*anchor_next;
static int anchor_slots[MAXANCHOR*2];
static unsigned long anchor_hash(const Tok *t,long scope) {
    unsigned long h=2166136261UL;long i;
    for(i=0;i<t->n;i++)h=(h^(unsigned char)t->s[i])*16777619UL;
    return h^((unsigned long)scope*2654435761UL);
}
static AnchorMeta *anchor_meta(const Tok *t) {
    if(t->kind!=T_ID)return 0;
    unsigned long s=anchor_hash(t,0)&(anchor_meta_cap-1);
    while(anchor_meta_table[s].name&&!tx_same(t->s,t->n,anchor_meta_table[s].name->s,anchor_meta_table[s].name->n))s=(s+1)&(anchor_meta_cap-1);
    if(!anchor_meta_table[s].name)anchor_meta_table[s].name=t;
    return &anchor_meta_table[s];
}
static int anchor_lookup(const Tok *t,long scope,int create) {
    unsigned long s=anchor_hash(t,scope)&(MAXANCHOR*2-1);int j;
    while(anchor_slots[s]){j=anchor_slots[s]-1;if(anchor[j].scope==scope&&tx_same(t->s,t->n,anchor[j].name.s,anchor[j].name.n))return j;s=(s+1)&(MAXANCHOR*2-1);}
    if(!create||nanchor==MAXANCHOR)return -1;
    j=nanchor++;anchor[j].name=*t;anchor[j].scope=scope;anchor[j].source=0;anchor_slots[s]=j+1;return j;
}
static void anchor_release(void) {
    mm_free(anchor_scopes);mm_free(anchor_reads);mm_free(anchor_builders);mm_free(anchor_runners);
    mm_free(anchor_ends);mm_free(anchor_next);mm_free(anchor_meta_table);
}
static long anchor_close(long open);
static void anchor_structure(void) {
    long k, q, fn = 0,top=0; int depth = 0;long *stack=mm_alloc((ntok+1)*sizeof *stack);
    anchor_ends=mm_alloc((ntok+1)*sizeof *anchor_ends);anchor_next=mm_alloc((ntok+1)*sizeof *anchor_next);
    anchor_meta_cap=16;while(anchor_meta_cap<(ntok+1)*2)anchor_meta_cap*=2;
    anchor_meta_table=mm_alloc(anchor_meta_cap*sizeof *anchor_meta_table);
    if(!stack||!anchor_ends||!anchor_next||!anchor_meta_table){fprintf(stderr,"cx-lint: source-flow index memory\n");exit(2);}
    memset(anchor_meta_table,0,anchor_meta_cap*sizeof *anchor_meta_table);memset(anchor_slots,0,sizeof anchor_slots);
    for(k=0;k<ntok;k++){anchor_ends[k]=ntok;anchor_next[k]=0;}
    for(k=0;k<ntok;k++){if(is(&toks[k],T_P,"("))stack[top++]=k;else if(is(&toks[k],T_P,")")&&top)anchor_ends[stack[--top]]=k;}
    mm_free(stack);
    anchor_scopes = mm_alloc((ntok+1)*sizeof *anchor_scopes);
    anchor_reads = mm_alloc((ntok+1)*sizeof *anchor_reads);
    anchor_builders = mm_alloc((ntok+1)*sizeof *anchor_builders);
    anchor_runners = mm_alloc((ntok+1)*sizeof *anchor_runners);
    if(!anchor_scopes||!anchor_reads||!anchor_builders||!anchor_runners){fprintf(stderr,"cx-lint: source-flow memory\n");exit(2);}
    for(k=0;k<ntok;k++){anchor_scopes[k]=0;anchor_reads[k]=0;anchor_builders[k]=0;anchor_runners[k]=0;}
    for(k=0;k<ntok;k++) {
        if(!depth && toks[k].kind==T_ID && k+1<ntok && is(&toks[k+1],T_P,"(")) {
            long e=anchor_close(k+1);
            if(e+1<ntok&&is(&toks[e+1],T_P,"{")) {
                fn=k+1; for(q=k+2;q<=e;q++)anchor_scopes[q]=fn;
            }
        }
        if(is(&toks[k],T_P,"{"))depth++;
        if(depth)anchor_scopes[k]=fn;
        if(is(&toks[k],T_P,"}")&&--depth==0)fn=0;
    }
    /* Narrow structural summaries: returned cx_read(first formal), including a
     * local temporary; and a first-output path builder calling cx_fmt/snprintf. */
    for(k=0;k<ntok;k++)if(anchor_scopes[k]) {
        long f=anchor_scopes[k]-1, p=f+2;
        while(p<ntok&&!is(&toks[p],T_P,",")&&!is(&toks[p],T_P,")"))p++;
        if(p<=f+2)continue;
        Tok *formal=&toks[p-1];
        if(k+2<ntok&&is(&toks[k+1],T_P,"(")&&toks[k+2].kind==T_ID&&
           tx_same(formal->s,formal->n,toks[k+2].s,toks[k+2].n)) {
            if(is(&toks[k],T_ID,"cx_read")) {
                long r, result=k>=2&&is(&toks[k-1],T_P,"=")?k-2:-1;
                for(r=k;r<ntok&&anchor_scopes[r]==f+1;r++)if(is(&toks[r],T_ID,"return")&&r+1<ntok&&
                    (r+1==k||(result>=0&&tx_same(toks[result].s,toks[result].n,toks[r+1].s,toks[r+1].n))))anchor_reads[f]=1;
                if(k>0&&is(&toks[k-1],T_ID,"return"))anchor_reads[f]=1;
            }
            if(is(&toks[k],T_ID,"fopen")&&k>=2&&is(&toks[k-1],T_P,"=")) {
                Tok *stream=&toks[k-2]; long r;
                for(r=k+1;r+2<ntok&&anchor_scopes[r]==f+1;r++)if(is(&toks[r],T_ID,"fread")&&is(&toks[r+1],T_P,"(")) {
                    long e=anchor_close(r+1), a=r+2, j; int uses=0;
                    for(j=a;j<e;j++)if(toks[j].kind==T_ID&&tx_same(stream->s,stream->n,toks[j].s,toks[j].n))uses=1;
                    if(uses)for(j=e+1;j+1<ntok&&anchor_scopes[j]==f+1;j++)if(is(&toks[j],T_ID,"return")&&tx_same(toks[a].s,toks[a].n,toks[j+1].s,toks[j+1].n))anchor_reads[f]=1;
                }
            }
            if(is(&toks[k],T_ID,"cx_fmt")||is(&toks[k],T_ID,"snprintf"))anchor_builders[f]=1;
            if(is(&toks[k],T_ID,"np_run")||is(&toks[k],T_ID,"cx_runv_timeout"))anchor_runners[f]|=1;
            if(is(&toks[k],T_ID,"np_run")) {
                long e=anchor_close(k+1), j;
                for(j=k+2;j+1<e;j++)if(is(&toks[j],T_P,"&")&&toks[j+1].kind==T_ID) {
                    long r; for(r=e+1;r+1<ntok&&anchor_scopes[r]==f+1;r++)if(is(&toks[r],T_ID,"return")&&tx_same(toks[j+1].s,toks[j+1].n,toks[r+1].s,toks[r+1].n))anchor_runners[f]|=2;
                }
            }
        }
    }
    /* Preserve token order and all matching definitions; cache facts, never findings. */
    for(k=0;k<ntok;k++)if(toks[k].kind==T_ID){
        AnchorMeta *m=anchor_meta(&toks[k]);
        if(!anchor_scopes[k]&&!(k+1<ntok&&is(&toks[k+1],T_P,"(")))m->global=1;
        m->reads|=anchor_reads[k];m->builders|=anchor_builders[k];m->runners|=anchor_runners[k];
        if(k+1<ntok&&is(&toks[k+1],T_P,"(")){
            long e=anchor_close(k+1);if(e+1<ntok&&is(&toks[e+1],T_P,"{")){
                if(m->last)anchor_next[m->last-1]=k+1;else m->first=k+1;m->last=k+1;
            }
        }
    }
}
static int anchor_name(const Tok *t) {
    if(t->kind!=T_ID)return -1;
    long at=t-toks,scope=at>=0&&at<ntok?anchor_scopes[at]:0;int j;
    if(at>=0&&at+1<ntok&&is(&toks[at+1],T_P,"(")){
        j=anchor_lookup(t,scope,0);if(j>=0&&(anchor[j].source&8))return j;scope=0;
    }
    AnchorMeta *m=anchor_meta(t);if(scope&&m->global)scope=0;
    return anchor_lookup(t,scope,1);
}
static int anchor_path(const Tok *t) {
    return t->kind == T_STR && tx_chr(t->s, t->n, '\\') < 0 &&
        (ends(t, ".c") || ends(t, ".h") || ends(t, ".cx") || ends(t, ".inc") || ends(t, ".in"));
}
static long anchor_close(long open);
static int anchor_unknown;
static int anchor_data_branch(long call,long a,long ae) {
    long el,q;
    /* Exact supported refinement: ext=strrchr(PATH,'.'); flag=ext &&
     * (!strcmp(ext,".cx") || ... .c/.h/.S); if(flag){...}else{read(PATH)}.
     * A changed predicate remains unknown, rather than becoming an exemption. */
    for(el=call-1;el>=0&&anchor_scopes[el]==anchor_scopes[call];el--)if(is(&toks[el],T_ID,"else")&&el+1<call&&is(&toks[el+1],T_P,"{")) {
        long end=el+2,start=el-1,cond,flag,assign,ext,r,pathend;int d=1,mask=0,ok=1;
        for(;end<ntok&&d;end++){if(is(&toks[end],T_P,"{"))d++;if(is(&toks[end],T_P,"}"))d--;}
        if(call>=end||start<0||!is(&toks[start],T_P,"}"))continue;
        d=1;for(start--;start>=0&&d;start--){if(is(&toks[start],T_P,"}"))d++;if(is(&toks[start],T_P,"{"))d--;}
        cond=start-3;
        if(cond<0||!is(&toks[cond],T_ID,"if")||!is(&toks[cond+1],T_P,"(")||!is(&toks[cond+3],T_P,")"))continue;
        flag=cond+2;
        for(assign=cond-1;assign>0;assign--)if(is(&toks[assign],T_P,"=")&&tx_same(toks[assign-1].s,toks[assign-1].n,toks[flag].s,toks[flag].n))break;
        ext=assign+1;
        if(assign<=0||ext+4>=cond||toks[ext].kind!=T_ID||!is(&toks[ext+1],T_P,"&")||!is(&toks[ext+2],T_P,"&")||!is(&toks[ext+3],T_P,"("))continue;
        r=ext+4;
        for(;;){
            if(r+6>=cond||!is(&toks[r],T_P,"!")||!is(&toks[r+1],T_ID,"strcmp")||!is(&toks[r+2],T_P,"(")||!tx_same(toks[r+3].s,toks[r+3].n,toks[ext].s,toks[ext].n)||!is(&toks[r+4],T_P,",")||!is(&toks[r+6],T_P,")")){ok=0;break;}
            if(is(&toks[r+5],T_STR,".cx"))mask|=1;else if(is(&toks[r+5],T_STR,".c"))mask|=2;else if(is(&toks[r+5],T_STR,".h"))mask|=4;else if(is(&toks[r+5],T_STR,".S"))mask|=8;else{ok=0;break;}
            r+=7;if(is(&toks[r],T_P,")"))break;
            if(!is(&toks[r],T_P,"|")||!is(&toks[r+1],T_P,"|")){ok=0;break;}r+=2;
        }
        if(!ok||mask!=15||!is(&toks[r+1],T_P,";"))continue;
        for(q=assign-1;q>1;q--)if(is(&toks[q],T_P,"=")&&tx_same(toks[q-1].s,toks[q-1].n,toks[ext].s,toks[ext].n))break;
        if(q<=1||!is(&toks[q+1],T_ID,"strrchr")||!is(&toks[q+2],T_P,"("))continue;
        pathend=q+3;while(pathend<assign&&!is(&toks[pathend],T_P,","))pathend++;
        if(pathend-(q+3)!=ae-a||!is(&toks[pathend+1],T_CHR,"."))continue;
        for(r=0;r<ae-a;r++)if(toks[a+r].kind!=toks[q+3+r].kind||!tx_same(toks[a+r].s,toks[a+r].n,toks[q+3+r].s,toks[q+3+r].n))ok=0;
        if(ok)return 1;
    }
    return 0;
}
/* Bits: source path, source/unknown bytes, declared facts path. */
static int anchor_value(long b,long e);
static int anchor_read_path(long call,long a,long ae) {
    long k,h;
    if(ae!=a+1||toks[a].kind!=T_ID)return anchor_value(a,ae);
    for(k=call-1;k>=0&&anchor_scopes[k]==anchor_scopes[call];k--) {
        if(is(&toks[k],T_P,"}"))break;
        if(toks[k].kind!=T_ID||k+2>=call||!is(&toks[k+1],T_P,"("))continue;
        long end=anchor_close(k+1), first=k+2, next;
        if(end>=call||toks[first].kind!=T_ID||!tx_same(toks[first].s,toks[first].n,toks[a].s,toks[a].n))continue;
        next=first+1;if(!is(&toks[next],T_P,","))continue;
        if(is(&toks[k],T_ID,"cx_write")){int v=anchor_value(next+1,end);if(v&2)return 257;}
        int builder=is(&toks[k],T_ID,"cx_fmt")||is(&toks[k],T_ID,"snprintf");
        AnchorMeta *m=anchor_meta(&toks[k]);if(m&&m->builders)builder=1;
        if(builder)return anchor_value(next+1,end);
    }
    return anchor_value(a,ae);
}
static int anchor_value(long b, long e) {
    long k; int value = 0;
    for (k = b; k < e; k++) {
        if(k>b&&(is(&toks[k-1],T_P,".")||(k>b+1&&is(&toks[k-1],T_P,">")&&is(&toks[k-2],T_P,"-"))))continue;
        int j = anchor_name(&toks[k]), v = anchor_path(&toks[k]) ? 1 :
            toks[k].kind == T_STR && ends(&toks[k],".tsv") ? 4 : j >= 0 ? anchor[j].source : 0;
        if (k + 1 < e && is(&toks[k+1],T_P,"(")) {
            long end = anchor_close(k+1); int reader=is(&toks[k],T_ID,"cx_read"), result=is(&toks[k],T_ID,"cx0_plan");
            AnchorMeta *m=anchor_meta(&toks[k]);if(m){if(m->reads)reader=1;if(m->runners&2)result=1;}
            if(reader && end<=e) {
                long ae=k+2; int d=0; while(ae<end){if(is(&toks[ae],T_P,"("))d++;if(is(&toks[ae],T_P,")"))d--;if(!d&&is(&toks[ae],T_P,","))break;ae++;}
                int origin=anchor_read_path(k,k+2,ae);
                v=(origin&256)?2:anchor_data_branch(k,k+2,ae)?128:(origin&1)?2:(origin&32)?32:(origin&4)?128:anchor_unknown?2:0;
                k=end;
            } else if(result&&end<=e){v=32;k=end;
            } else if((is(&toks[k],T_ID,"ca_token_text")||is(&toks[k],T_ID,"ca_tokens"))&&end<=e){v=64;k=end;
            } else if(is(&toks[k],T_ID,"sy_tmpdir"))v=16;
        }
        value |= v;
    }
    return value;
}
static int anchor_mark(long k, int value) {
    int j = anchor_name(&toks[k]);
    if (j < 0 || (anchor[j].source | value) == anchor[j].source) return 0;
    anchor[j].source |= value; return 1;
}
static long anchor_close(long open) {
    return open>=0&&open<ntok?anchor_ends[open]:ntok;
}
static long anchor_arg_end(long b, long e) {
    long k; int d = 0;
    for (k = b; k < e; k++) {
        if (is(&toks[k], T_P, "(") || is(&toks[k], T_P, "[")) d++;
        else if (is(&toks[k], T_P, ")") || is(&toks[k], T_P, "]")) d--;
        else if (!d && is(&toks[k], T_P, ",")) return k;
    }
    return e;
}
static int anchor_builtin(const Tok *t) {
    return is(t,T_ID,"strstr") || is(t,T_ID,"strcasestr") || is(t,T_ID,"memmem") ||
        is(t,T_ID,"tx_find") || is(t,T_ID,"tx_contains") || is(t,T_ID,"tx_count") ||
        is(t,T_ID,"np_count") || is(t,T_ID,"swap_all") || has(t,"replace") || has(t,"mutate");
}
static int anchor_sink(const Tok *t) {
    int j=anchor_name(t);
    return anchor_builtin(t)||(j>=0&&(anchor[j].source&8));
}
static int anchor_input(long call,long a,long ae) {
    long k,q;
    if(ae!=a+1||toks[a].kind!=T_ID)return anchor_value(a,ae);
    for(k=call-1;k>0&&anchor_scopes[k]==anchor_scopes[call];k--) {
        if(is(&toks[k],T_P,"}"))break; /* A sibling/control join keeps merged origins. */
        if(!is(&toks[k],T_P,"=")||is(&toks[k+1],T_P,"=")||is(&toks[k-1],T_P,"="))continue;
        if(toks[k-1].kind!=T_ID||!tx_same(toks[k-1].s,toks[k-1].n,toks[a].s,toks[a].n))continue;
        for(q=k+1;q<call&&!is(&toks[q],T_P,";");q++);
        return anchor_value(k+1,anchor_arg_end(k+1,q));
    }
    return anchor_value(a,ae);
}
static void source_anchors(int testish) {
    long k, q; int changed = 1, rounds = 0;
    if(!testish)return;
    for(k=0;k<ntok;k++)if(toks[k].kind==T_ID&&anchor_builtin(&toks[k]))break;
    if(k==ntok||!rule_selected("R4-source-anchor"))return;
    nanchor = 0; anchor_unknown = 0; anchor_structure();
    for (k = 0; k < ntok; k++) if (toks[k].kind == T_ID && anchor_name(&toks[k]) < 0) {
        report("R4-source-anchor", toks[k].line, "source-flow name capacity exceeded at %.*s", &toks[k]);anchor_release();return;
    }
    while (changed && rounds++ <= nanchor * 2 + 2) {
        long fn = -1; int depth = 0; changed = 0;
        for (k = 0; k < ntok; k++) {
            if (is(&toks[k],T_P,"{")) depth++;
            if (is(&toks[k],T_P,"}")) { if (--depth == 0) fn = -1; }
            if(k>0&&is(&toks[k],T_P,"=")&&is(&toks[k-1],T_P,"]")) {
                long left=k-2, end=k+1, r;
                while(left>0&&!is(&toks[left],T_P,"["))left--;
                while(end<ntok&&!is(&toks[end],T_P,";"))end++;
                if(left>0&&toks[left-1].kind==T_ID) {
                    changed|=anchor_mark(left-1,anchor_value(k+1,end));
                    if(anchor_value(left-1,left)&32)for(r=k+1;r<end;r++)if(anchor_value(r,r+1)&16)changed|=anchor_mark(r,32);
                }
            }
            if (is(&toks[k],T_ID,"return") && fn >= 0) {
                for (q = k + 1; q < ntok && !is(&toks[q],T_P,";"); q++) ;
                if(!anchor_reads[fn])changed |= anchor_mark(fn,anchor_value(k + 1,q));
            }
            if (k > 0 && k + 1 < ntok && is(&toks[k],T_P,"=") && !is(&toks[k+1],T_P,"=")) {
                for (q = k + 1; q < ntok && !is(&toks[q],T_P,";"); q++) ;
                q = anchor_arg_end(k+1,q);
                changed |= anchor_mark(k - 1,anchor_value(k + 1,q));
                if (q == k+2 && anchor_sink(&toks[k+1])) changed |= anchor_mark(k-1,8);
            }
            if (toks[k].kind == T_ID && k + 1 < ntok && is(&toks[k+1],T_P,"(")) {
                long end = anchor_close(k+1), a = k+2, h;
                if (end >= ntok) continue;
                if (end + 1 < ntok && is(&toks[end+1],T_P,"{")) { if (!depth) fn = k; continue; }
                if (anchor_value(a,end) && (is(&toks[k],T_ID,"cx_fmt") || is(&toks[k],T_ID,"snprintf") ||
                    is(&toks[k],T_ID,"path") || is(&toks[k],T_ID,"join"))) changed |= anchor_mark(a,anchor_value(a,end));
                if(is(&toks[k],T_ID,"mkdtemp"))changed |= anchor_mark(a,16);
                if(is(&toks[k],T_ID,"mkdir")&&k>=2&&is(&toks[k-1],T_P,"(")&&is(&toks[k-2],T_ID,"if")&&end+2<ntok&&is(&toks[end+1],T_P,")")&&(ends(&toks[end+2],"die")||is(&toks[end+2],T_ID,"exit")))changed|=anchor_mark(a,16);
                if(is(&toks[k],T_ID,"realpath")) {long ae=anchor_arg_end(a,end);if(ae+1<end)changed |= anchor_mark(ae+1,anchor_value(a,ae));}
                if(is(&toks[k],T_ID,"np_run")||is(&toks[k],T_ID,"cx_runv_timeout"))changed |= anchor_mark(a,32);
                if(is(&toks[k],T_ID,"cx_runv_timeout")) {long ae=anchor_arg_end(a,end);ae=anchor_arg_end(ae+1,end);if(ae+1<end){long out=ae+1;while(out<end&&toks[out].kind!=T_ID)out++;if(out<end)changed|=anchor_mark(out,32);}}
                if(is(&toks[k],T_ID,"cx_write")) {long ae=anchor_arg_end(a,end);int content=anchor_value(ae+1,end);if(content&2)changed|=anchor_mark(a,257);else if(content&32)changed|=anchor_mark(a,32);}
                /* Same-file direct calls: actual argument origin -> formal name. */
                AnchorMeta *callee=anchor_meta(&toks[k]);
                for(h=callee?callee->first-1:-1;h>=0;h=anchor_next[h]-1){
                    long he=anchor_close(h+1),p=h+2,ab=a;
                    if(anchor_builders[h])changed |= anchor_mark(a,anchor_value(a,end));
                    if(anchor_runners[h])changed |= anchor_mark(a,32);
                    if(anchor_reads[h])continue;
                    while (p < he && ab < end) {
                        long pe = anchor_arg_end(p,he), be = anchor_arg_end(ab,end), name = pe-1;
                        while (name > p && toks[name].kind != T_ID) name--;
                        changed |= anchor_mark(name,anchor_value(ab,be));
                        {long q,actual=ab;int stars=0;for(q=p;q<pe;q++)if(is(&toks[q],T_P,"*"))stars++;
                         while(actual<be&&toks[actual].kind!=T_ID)actual++;
                         if(stars>=2&&actual<be)changed|=anchor_mark(actual,anchor_value(name,name+1));}
                        p = pe+1; ab = be+1;
                    }
                }
            }
        }
        if (!changed && !anchor_unknown) { anchor_unknown = 1; changed = 1; }
    }
    for (k = 0; k + 1 < ntok; k++) if (anchor_sink(&toks[k]) && is(&toks[k+1],T_P,"(")) {
        long e = anchor_close(k+1), ae = anchor_arg_end(k+2,e), p; int delimiter = 0;
        int origin=anchor_input(k,k+2,ae), unknown=0;
        if(!origin&&ae==k+3&&toks[k+2].kind==T_ID&&anchor_scopes[k]) {
            long f=anchor_scopes[k]-1, end=anchor_close(f+1), q;
            for(q=f+2;q<end;q++)if(toks[q].kind==T_ID&&tx_same(toks[q].s,toks[q].n,toks[k+2].s,toks[k+2].n))unknown=1;
        }
        if (!(origin & 2)&&!unknown) continue;
        /* Lexer punctuation searches are not source assertions or mutation anchors. */
        for (p = ae+1; p < e; p++) if (toks[p].kind == T_STR) {
            long c; delimiter = toks[p].n > 0 && toks[p].n <= 2 && !has(&toks[k],"replace") && !has(&toks[k],"mutate") && !is(&toks[k],T_ID,"swap_all");
            for (c = 0; c < toks[p].n; c++) if (idc(toks[p].s[c])) delimiter = 0;
            break;
        }
        if (!delimiter) {char why[256];cx_fmt(why,sizeof why,"%%.*s source-anchor input-origin=%d%s; use facts/behavior/token provenance",origin,unknown?" unknown-parameter":"");report("R4-source-anchor",toks[k].line,why,&toks[k]);}
    }
    anchor_release();
}

static void lint_file(const char *path) {
    int fd = sy_open_read(path); long n, k, start = 0, die_at = -1; int depth = 0; char *b;
    int versions_ok, testish;
    if (fd == -2) { fprintf(stderr, "cx-lint: skip %s (ENOENT, e.g. dangling tracked symlink)\n", path); missing++; return; }
    if (fd < 0) { fprintf(stderr, "cx-lint: cannot open %s (rc %d)\n", path, fd); exit(2); }
    n = sy_reg_size(fd);
    if (n < 0) { fprintf(stderr, "cx-lint: cannot size %s\n", path); exit(2); }
    b = mm_alloc(n + 1);
    if (!b || sy_read_full(fd, b, n)) { fprintf(stderr, "cx-lint: cannot read %s\n", path); exit(2); }
    sy_close(fd);
    b[n] = 0;
    cur_path = path;
    versions_ok = tx_suffix(path, tx_len(path, 4096), "cxlib/releaseversion.cx", 23);
    testish = testish_path(path);
    lex(b, n);
    source_anchors(testish);
    for (k = 0; k < ntok; k++) {
        if (is(&toks[k], T_P, "{")) { if (depth++ == 0) { block(start, k, versions_ok, testish); start = k; die_at = die_header(k); } }
        else if (is(&toks[k], T_P, "}") && depth > 0) {
            if (--depth == 0) { if (die_at >= 0) die_tail(die_at, start, k); block(start, k + 1, versions_ok, testish); start = k + 1; }
        }
    }
    block(start, ntok, versions_ok, testish);
}

int main(int argc, char **argv) {
    long t0 = sy_now_ms(), files = 0; int i, strict = 0, given = 0;
    for (i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--strict")) strict = 1;
        else if (tx_eqz(argv[i], "--rules") && i + 1 < argc) rules_filter = argv[++i];
        else if (tx_eqz(argv[i], "--")) continue;
        else { given = 1; lint_file(argv[i]); files++; }
    }
    if (!given) {
        char *v[] = {"git", "ls-files", "--", "tools/*.cx", "tests/*.cx", 0};
        char *out = 0; size_t n = 0; long p = 0;
        if (cx_runv_timeout(v, 30, &out, &n) || !out) { fprintf(stderr, "cx-lint: git ls-files failed\n"); return 2; }
        while (p < (long)n) {
            long q = p;
            while (q < (long)n && out[q] != '\n') q++;
            out[q] = 0;
            if (q > p) { lint_file(out + p); files++; }
            p = q + 1;
        }
    }
    printf("CX_LINT\tfiles=%ld\tfindings=%ld\telapsed_ms=%ld\n", files - missing, findings, sy_now_ms() - t0);
    if (missing) fprintf(stderr, "cx-lint: %ld tracked path(s) missing on disk, not linted\n", missing);
    return strict && findings ? 1 : 0;
}
