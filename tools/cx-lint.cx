/* tools/cx-lint.cx -- token-level lint for .cx tools and tests (report only).
 *
 *   sh ./unisacc.com tools/cx-lint.cx [-- [--strict] [--rules R2,R1-version,...] [PATH...]]
 *
 * Without PATH, lints every tracked tools/ and tests/ .cx file (git ls-files, bounded 30 s).
 * A small C lexer skips // and block comments, string/char literals (with escapes) and
 * backslash-newline continuations; rules then run on the token stream of each top-level
 * brace block (a function body; file-scope tokens form one block of their own).
 *
 *   R1 second source of truth
 *     R1-version  a string literal holding a release version "0.0.N" with N >= 10 or
 *                 "unisacc 0.0." outside tools/cxlib/releaseversion.cx.  A literal that is a file
 *                 name (contains '/', or ends in .md/.tsv) is a reference, not reported.  Exempt in test code
 *                 (a path under tests/ or a tools/check-*.cx) when the literal is refusal data:
 *                 the same block names refuse/reject/invalid/bad/expect_fail (identifier or
 *                 literal, any case) or the statement is wrapped in ck(!...).
 *     R1-product  a product path literal ("unisacc.com" or ".../unisacc.com", no spaces) that
 *                 actually reaches a child process: the literal itself, or an identifier filled
 *                 from it in the same block (x = ...lit... or f(x, ..., lit)), lands in an argv
 *                 slot (v[n++] = x, {x, ...}, {..., x, ...}) or is the first argument of a run
 *                 call (sy_run, sy_spawn..., cx_run..., runv).  A name refilled by the same call or
 *                 assignment without the literal (path(p, root, "seed.c") after path(p, root,
 *                 "unisacc.com")) drops the taint until refilled with it.  APPROXIMATION:
 *                 block-scoped data flow over names; a literal that is only compared,
 *                 existence-checked, labelled or passed to a guard helper is not reported.
 *     lint:allow  a trailing comment  "lint:allow R1 REASON" (block or // comment, e.g.
 *                 // lint:allow R1-version REASON) on the reported line suppresses an R1 rule whose name starts with the
 *                 given token; REASON must be non-empty or the allow is ignored (stderr note).
 *                 R2 rules cannot be allowed.
 *   R2 child processes
 *     R2-timeout  sy_run / sy_spawn / sy_spawn_inherit / sy_spawn_pipe / cx_run / cx_runv
 *                 (APIs with no time-limit parameter) called in a block that names no
 *                 bound/timeout/deadline (identifier or literal).  APPROXIMATION: any such
 *                 word in the block counts as a guard.
 *     R2-sep      an argv built as <unisacc.com> <TOOL.cx> "--x..." (the product, then a .cx
 *                 tool, then a literal starting with "--" that is not "--") or one shell
 *                 literal "... unisacc.com T.cx --x" (a literal containing escaped quotes \"
 *                 is embedded source, e.g. a lint fixture, and is skipped).  The product/tool may be literals or
 *                 identifiers first filled from a call with such a literal (cx_fmt(com, ..,
 *                 "%s/unisacc.com")).
 *
 * --rules LIST   only rules whose name starts with one of the comma-separated prefixes are
 *                reported and counted (R2 = R2-timeout + R2-sep).
 *
 * Output:  LINT<TAB>rule<TAB>path:line<TAB>summary, then
 *          CX_LINT<TAB>files=N<TAB>findings=M<TAB>elapsed_ms=T
 * Exit 0 always; with --strict, 1 when any finding; 2 on IO errors.  A path that is ENOENT (a
 * dangling tracked symlink) is skipped with a stderr note and not counted in files=. */
#pragma unisa use sys.fs
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

enum { T_ID, T_STR, T_CHR, T_NUM, T_P };
typedef struct { int kind, line; const char *s; long n; } Tok;

static Tok *toks; static long ntok, captok;
static long findings, missing;
static const char *cur_path;
static const char *rules_filter;   /* --rules LIST or 0 */

#define MAXALLOW 512
typedef struct { int line; char rule[24]; } Allow;
static Allow allows[MAXALLOW]; static int nallow;

static void push(int kind, int line, const char *s, long n) {
    if (ntok == captok) {
        long c = captok ? captok * 2 : 4096;
        Tok *g = mm_grow(toks, c * (long)sizeof(Tok));
        if (!g) { fprintf(stderr, "cx-lint: out of memory\n"); exit(2); }
        toks = g; captok = c;
    }
    toks[ntok].kind = kind; toks[ntok].line = line; toks[ntok].s = s; toks[ntok].n = n; ntok++;
}
static int idc(int c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || (c >= '0' && c <= '9'); }
static int sp(int c) { return c == ' ' || c == '\t' || c == '\r' || c == '\n'; }

/* A comment body C[0..n) at LINE: record "lint:allow RULE REASON" when REASON is non-empty. */
static void note_allow(const char *c, long n, int line) {
    long p = tx_find(c, n, "lint:allow", 10), q, r;
    if (p < 0) return;
    p += 10;
    while (p < n && sp(c[p])) p++;
    q = p;
    while (q < n && (idc(c[q]) || c[q] == '-')) q++;
    if (q == p || q - p >= 24) { fprintf(stderr, "cx-lint: %s:%d: lint:allow without a rule name is ignored\n", cur_path, line); return; }
    r = q;
    while (r < n && sp(c[r])) r++;
    if (r >= n) { fprintf(stderr, "cx-lint: %s:%d: lint:allow %.*s without a reason is ignored\n", cur_path, line, (int)(q - p), c + p); return; }
    if (nallow < MAXALLOW) {
        allows[nallow].line = line;
        mm_copy(allows[nallow].rule, sizeof allows[nallow].rule, c + p, (size_t)(q - p));
        allows[nallow].rule[q - p] = 0;
        nallow++;
    }
}

/* Lex B[0..n); string/char tokens hold the raw bytes between the quotes. */
static void lex(const char *b, long n) {
    long i = 0; int line = 1;
    ntok = 0; nallow = 0;
    while (i < n) {
        char c = b[i];
        if (c == '\n') { line++; i++; continue; }
        if (c == '\\' && i + 1 < n && b[i + 1] == '\n') { line++; i += 2; continue; }
        if (c == '\\' && i + 2 < n && b[i + 1] == '\r' && b[i + 2] == '\n') { line++; i += 3; continue; }
        if (c == ' ' || c == '\t' || c == '\r' || c == '\f' || c == '\v') { i++; continue; }
        if (c == '/' && i + 1 < n && b[i + 1] == '/') {
            long s = i + 2; int l0 = line;
            while (i < n && b[i] != '\n') { if (b[i] == '\\' && i + 1 < n && b[i + 1] == '\n') { line++; i++; } i++; }
            note_allow(b + s, i - s, l0);
            continue;
        }
        if (c == '/' && i + 1 < n && b[i + 1] == '*') {
            long s; int l0 = line;
            i += 2; s = i;
            while (i < n && !(b[i] == '*' && i + 1 < n && b[i + 1] == '/')) { if (b[i] == '\n') line++; i++; }
            note_allow(b + s, i - s, l0);
            i += 2; continue;
        }
        if (c == '"' || c == '\'') {
            long s = ++i; int l0 = line;
            while (i < n && b[i] != c && b[i] != '\n') { if (b[i] == '\\' && i + 1 < n) { if (b[i + 1] == '\n') line++; i++; } i++; }
            push(c == '"' ? T_STR : T_CHR, l0, b + s, i - s);
            if (i < n && b[i] == c) i++;
            continue;
        }
        if (idc(c)) {
            long s = i;
            if (c >= '0' && c <= '9') { while (i < n && (idc(b[i]) || b[i] == '.')) i++; push(T_NUM, line, b + s, i - s); }
            else { while (i < n && idc(b[i])) i++; push(T_ID, line, b + s, i - s); }
            continue;
        }
        push(T_P, line, b + i, 1); i++;
    }
}

static int is(const Tok *t, int kind, const char *w) { return t->kind == kind && tx_same(t->s, t->n, w, tx_len(w, 256)); }
static int has(const Tok *t, const char *w) { return tx_contains(t->s, t->n, w, tx_len(w, 256)); }
static int ends(const Tok *t, const char *w) { return tx_suffix(t->s, t->n, w, tx_len(w, 256)); }

static int rule_selected(const char *rule) {
    const char *p = rules_filter; long rl = tx_len(rule, 32);
    if (!p) return 1;
    while (*p) {
        long l = 0;
        while (p[l] && p[l] != ',') l++;
        if (l > 0 && l <= rl && tx_same(rule, l, p, l)) return 1;
        p += l; if (*p == ',') p++;
    }
    return 0;
}
static int allowed(const char *rule, int line) {
    int j; long rl = tx_len(rule, 32);
    if (rule[0] != 'R' || rule[1] != '1') return 0;   /* only R1 rules can be allowed */
    for (j = 0; j < nallow; j++) {
        long al = tx_len(allows[j].rule, 24);
        if (allows[j].line == line && al <= rl && tx_same(rule, al, allows[j].rule, al)) return 1;
    }
    return 0;
}

static void report(const char *rule, int line, const char *fmt, const Tok *t) {
    int k = t ? (int)(t->n > 60 ? 60 : t->n) : 0;
    if (!rule_selected(rule) || allowed(rule, line)) return;
    printf("LINT\t%s\t%s:%d\t", rule, cur_path, line);
    printf(fmt, k, t ? t->s : "");
    printf("\n");
    findings++;
}

static int product_lit(const Tok *t) {
    return t->kind == T_STR && tx_chr(t->s, t->n, ' ') < 0 &&
           (is(t, T_STR, "unisacc.com") || ends(t, "/unisacc.com"));
}
static int version_lit(const Tok *t) {
    long i;
    if (t->kind != T_STR) return 0;
    if (has(t, "unisacc 0.0.")) return 1;   /* lint:allow R1-version the matcher's own pattern, not a version claim */
    if (tx_chr(t->s, t->n, '/') >= 0 || ends(t, ".md") || ends(t, ".tsv")) return 0;   /* a file name carrying a version is a reference, not a claim */
    for (i = 0; i + 5 < t->n; i++) {
        const char *s = t->s + i;
        if ((i == 0 || !(s[-1] >= '0' && s[-1] <= '9') ) && s[0] == '0' && s[1] == '.' && s[2] == '0' && s[3] == '.' &&
            s[4] >= '1' && s[4] <= '9' && i + 5 < t->n && s[5] >= '0' && s[5] <= '9') return 1;
    }
    return 0;
}
static const char *untimed[] = {"sy_run", "sy_spawn", "sy_spawn_inherit", "sy_spawn_pipe", "cx_run", "cx_runv", 0};
static int untimed_call(long k, long e) {
    int j;
    if (toks[k].kind != T_ID || k + 1 >= e || !is(&toks[k + 1], T_P, "(")) return 0;
    for (j = 0; untimed[j]; j++) if (is(&toks[k], T_ID, untimed[j])) return 1;
    return 0;
}
static int run_call(long k, long e) {
    if (toks[k].kind != T_ID || k + 1 >= e || !is(&toks[k + 1], T_P, "(")) return 0;
    return untimed_call(k, e) || is(&toks[k], T_ID, "cx_run_timeout") || is(&toks[k], T_ID, "cx_runv_timeout") ||
           is(&toks[k], T_ID, "runv");
}
static int guard_word(const Tok *t) {
    if (t->kind != T_ID && t->kind != T_STR) return 0;
    return has(t, "bound") || has(t, "timeout") || has(t, "deadline") || has(t, "Timeout") || has(t, "Deadline");
}
/* a word that marks test data meant to be refused */
static int refusal_word(const Tok *t) {
    if (t->kind != T_ID && t->kind != T_STR) return 0;
    return has(t, "refuse") || has(t, "REFUSE") || has(t, "Refuse") || has(t, "reject") || has(t, "REJECT") || has(t, "Reject") ||
           has(t, "invalid") || has(t, "INVALID") || has(t, "Invalid") || has(t, "bad") || has(t, "BAD") || has(t, "Bad") ||
           has(t, "expect_fail") || has(t, "expect-fail");
}

#define MAXT 64
/* kind 1 product, 2 .cx tool; lit = token index of the literal; fn = token index of the filling call's
   name (-1 for "x = ..."); off = the name was since refilled by the same call/assignment without the literal */
typedef struct { const char *s; long n; int kind; long lit, fn; int done, off; } Taint;
static Taint taint[MAXT]; static int ntaint;
static int taint_of(const Tok *t) {
    int j;
    if (t->kind == T_STR) return product_lit(t) ? 1 : ends(t, ".cx") ? 2 : 0;
    if (t->kind != T_ID) return 0;
    for (j = 0; j < ntaint; j++) if (tx_same(taint[j].s, taint[j].n, t->s, t->n)) return taint[j].off ? 0 : taint[j].kind;
    return 0;
}
/* Token K is the name being refilled by the same call (f(K, ...)) or assignment (K = ...) that tainted it:
   the taint follows the statement -- on when it holds the literal kind again, off otherwise. */
static void refill(long k, long stmt, long e) {
    int j; long q, end;
    for (j = 0; j < ntaint; j++) {
        Taint *te = &taint[j]; int same = 0;
        if (!tx_same(te->s, te->n, toks[k].s, toks[k].n)) continue;
        if (te->fn >= 0) same = k >= 2 && is(&toks[k - 1], T_P, "(") && k + 1 < e && is(&toks[k + 1], T_P, ",") &&
                                 toks[k - 2].kind == T_ID && tx_same(toks[k - 2].s, toks[k - 2].n, toks[te->fn].s, toks[te->fn].n);
        else same = k + 2 < e && is(&toks[k + 1], T_P, "=") && !is(&toks[k + 2], T_P, "=");
        if (!same) continue;
        for (end = stmt; end < e && !is(&toks[end], T_P, ";") && !is(&toks[end], T_P, "{") && !is(&toks[end], T_P, "}"); end++) ;
        te->off = 1;
        for (q = stmt; q < end; q++)
            if (toks[q].kind == T_STR && (te->kind == 1 ? product_lit(&toks[q]) : ends(&toks[q], ".cx"))) { te->off = 0; break; }
    }
}
static Taint *taint_entry(const Tok *t) {
    int j;
    if (t->kind != T_ID) return 0;
    for (j = 0; j < ntaint; j++) if (tx_same(taint[j].s, taint[j].n, t->s, t->n)) return &taint[j];
    return 0;
}

/* Token index K sits in an argv slot: "] = K", "{ K", or ", K" directly inside a brace initializer
   (OPEN is the innermost unclosed bracket at K).  A "(char *)" cast before K is skipped. */
static int argv_init(long k, long e) {   /* the brace initializer around K is NULL-terminated: "..., 0 }" */
    long q; int d = 0;
    for (q = k; q < e; q++) {
        if (is(&toks[q], T_P, "{") || is(&toks[q], T_P, "(") || is(&toks[q], T_P, "[")) d++;
        else if (is(&toks[q], T_P, ")") || is(&toks[q], T_P, "]")) d--;
        else if (is(&toks[q], T_P, "}")) {
            if (d-- == 0) return q > k && (is(&toks[q - 1], T_NUM, "0") || is(&toks[q - 1], T_ID, "NULL"));
        }
        else if (is(&toks[q], T_P, ";")) return 0;
    }
    return 0;
}
static int argv_slot(long k, long b, long e, char open) {
    long p = k - 1;
    if (p >= b + 3 && is(&toks[p], T_P, ")") && is(&toks[p - 1], T_P, "*") && toks[p - 2].kind == T_ID && is(&toks[p - 3], T_P, "("))
        p -= 4;
    if (p < b) return 0;
    if (is(&toks[p], T_P, "=") && p > b && is(&toks[p - 1], T_P, "]")) return 1;
    if (is(&toks[p], T_P, "{") || (is(&toks[p], T_P, ",") && open == '{')) return argv_init(k, e);
    return 0;
}

/* Rules over the tokens [b, e) of one top-level block. */
static void block(long b, long e, int versions_ok, int testish) {
    long k, s, stmt = b; int guarded = 0, refusing = 0;
    char stack[64]; int depth = 0;
    ntaint = 0;
    for (k = b; k < e; k++) { if (guard_word(&toks[k])) guarded = 1; if (refusal_word(&toks[k])) refusing = 1; }
    /* taint: statement with a product/.cx literal -> its first call's first identifier argument, or the
       identifier left of '=' */
    for (s = b; s < e; ) {
        long t = s, lit = 0; int kind = 0;
        while (t < e && !is(&toks[t], T_P, ";") && !is(&toks[t], T_P, "{") && !is(&toks[t], T_P, "}")) {
            if (!kind && toks[t].kind == T_STR) { kind = product_lit(&toks[t]) ? 1 : ends(&toks[t], ".cx") ? 2 : 0; lit = t; }
            t++;
        }
        if (kind && ntaint < MAXT) {
            long q;
            for (q = s; q < lit; q++) {
                if (is(&toks[q], T_P, "(") && toks[q + 1].kind == T_ID && q + 2 < lit && is(&toks[q + 2], T_P, ",")) {
                    if (taint_entry(&toks[q + 1])) break;   /* already tracked under this name: first filling statement wins */
                    taint[ntaint].s = toks[q + 1].s; taint[ntaint].n = toks[q + 1].n; taint[ntaint].kind = kind;
                    taint[ntaint].lit = lit; taint[ntaint].fn = q > s && toks[q - 1].kind == T_ID ? q - 1 : -1;
                    taint[ntaint].done = 0; taint[ntaint].off = 0; ntaint++; break;
                }
                if (is(&toks[q], T_P, "=") && q > s && toks[q - 1].kind == T_ID && !is(&toks[q + 1], T_P, "=")) {
                    if (taint_entry(&toks[q - 1])) break;
                    taint[ntaint].s = toks[q - 1].s; taint[ntaint].n = toks[q - 1].n; taint[ntaint].kind = kind;
                    taint[ntaint].lit = lit; taint[ntaint].fn = -1; taint[ntaint].done = 0; taint[ntaint].off = 0; ntaint++; break;
                }
            }
        }
        s = t + 1;
    }
    for (k = b; k < e; k++) {
        Tok *t = &toks[k];
        char open = depth ? stack[depth - 1] : 0;
        if (t->kind == T_P) {
            if (t->s[0] == '(' || t->s[0] == '[' || t->s[0] == '{') { if (depth < 64) stack[depth] = t->s[0]; depth++; }
            else if ((t->s[0] == ')' || t->s[0] == ']' || t->s[0] == '}') && depth > 0) depth--;
            if (t->s[0] == ';' || t->s[0] == '{' || t->s[0] == '}') stmt = k + 1;
        }
        if (!versions_ok && version_lit(t)) {
            int exempt = 0;
            if (testish) {
                long q;
                exempt = refusing;
                for (q = stmt; q + 2 < k && !exempt; q++)
                    if (is(&toks[q], T_ID, "ck") && is(&toks[q + 1], T_P, "(") && is(&toks[q + 2], T_P, "!")) exempt = 1;
            }
            if (!exempt) report("R1-version", t->line, "version literal \"%.*s\" outside releaseversion", t);
        }
        if (t->kind == T_ID && taint_entry(t)) refill(k, stmt, e);
        /* R1-product: the literal, or a name filled from it, reaches an argv slot or a run call's first argument */
        if (product_lit(t) && argv_slot(k, b, e, open))
            report("R1-product", t->line, "product path literal \"%.*s\" placed in an argv slot", t);
        else if (t->kind == T_ID && taint_of(t) == 1) {
            Taint *te = taint_entry(t);
            int hit = argv_slot(k, b, e, open);
            if (!hit && k >= b + 2 && is(&toks[k - 1], T_P, "(") && run_call(k - 2, e)) hit = 1;
            if (hit && te && !te->done) {
                te->done = 1;
                report("R1-product", toks[te->lit].line, "product path literal \"%.*s\" fills a name that reaches a child argv", &toks[te->lit]);
            }
        }
        if (untimed_call(k, e) && !guarded) report("R2-timeout", t->line, "%.*s( with no bound/timeout/deadline in the block", t);
        if (t->kind == T_STR && tx_find(t->s, t->n, "\\\"", 2) < 0) {   /* one shell literal "... unisacc.com X.cx --opt"; a literal holding
                                                                           escaped quotes is embedded source/data (a lint fixture), not a command */
            long p = tx_find(t->s, t->n, "unisacc.com ", 12);
            if (p >= 0) {
                long q = tx_find(t->s + p, t->n - p, ".cx ", 4);
                if (q >= 0) {
                    const char *a = t->s + p + q + 4; long rest = t->n - p - q - 4;
                    if (rest >= 3 && a[0] == '-' && a[1] == '-' && a[2] != ' ')
                        report("R2-sep", t->line, "shell literal runs a .cx tool with --option but no -- separator: \"%.*s\"", t);
                }
            }
        }
        if (taint_of(t) == 1 && !is(&toks[k - 1], T_P, "(")) {   /* argv element, not a cx_fmt destination */
            long q, lim = k + 24 < e ? k + 24 : e;
            for (q = k + 1; q < lim; q++) {
                if (is(&toks[q], T_P, ";") && q + 1 < lim && is(&toks[q + 1], T_P, "}")) break;
                if (taint_of(&toks[q]) == 2 && !is(&toks[q - 1], T_P, "(")) {
                    long r;
                    for (r = q + 1; r < lim + 12 && r < e; r++) {
                        if (toks[r].kind == T_STR) {
                            if (toks[r].n > 2 && toks[r].s[0] == '-' && toks[r].s[1] == '-')
                                report("R2-sep", toks[r].line, "argv runs a .cx tool then \"%.*s\" with no \"--\" separator", &toks[r]);
                            break;
                        }
                        if (toks[r].kind == T_ID && taint_of(&toks[r]) == 0 && !is(&toks[r], T_ID, "char") && !is(&toks[r], T_ID, "n") &&
                            !is(&toks[r], T_ID, "a") && !is(&toks[r], T_ID, "av") && !is(&toks[r], T_ID, "argv") && !is(&toks[r], T_ID, "v")) {
                            if (r + 1 < e && (is(&toks[r + 1], T_P, ",") || is(&toks[r + 1], T_P, ";") || is(&toks[r + 1], T_P, "}"))) break;
                        }
                    }
                    break;
                }
            }
        }
    }
}

static int testish_path(const char *path) {
    long n = tx_len(path, 4096), i, base = 0;
    for (i = 0; i < n; i++) if (path[i] == '/') base = i + 1;
    if (tx_prefix(path, n, "tests/", 6) || tx_find(path, n, "/tests/", 7) >= 0) return 1;
    return tx_prefix(path + base, n - base, "check-", 6);
}

static void lint_file(const char *path) {
    int fd = sy_open_read(path); long n, k, start = 0; int depth = 0; char *b;
    int versions_ok, testish;
    if (fd == -2) { fprintf(stderr, "cx-lint: skip %s (ENOENT, e.g. dangling tracked symlink)\n", path); missing++; return; }
    if (fd < 0) { fprintf(stderr, "cx-lint: cannot open %s (rc %d)\n", path, fd); exit(2); }
    n = sy_reg_size(fd);
    if (n < 0) { fprintf(stderr, "cx-lint: cannot size %s\n", path); exit(2); }
    b = mm_alloc(n + 1);
    if (!b || sy_read_full(fd, b, n)) { fprintf(stderr, "cx-lint: cannot read %s\n", path); exit(2); }
    sy_close(fd);
    b[n] = 0;
    cur_path = path;
    versions_ok = tx_suffix(path, tx_len(path, 4096), "cxlib/releaseversion.cx", 23);
    testish = testish_path(path);
    lex(b, n);
    for (k = 0; k < ntok; k++) {
        if (is(&toks[k], T_P, "{")) { if (depth++ == 0) { block(start, k, versions_ok, testish); start = k; } }
        else if (is(&toks[k], T_P, "}") && depth > 0) { if (--depth == 0) { block(start, k + 1, versions_ok, testish); start = k + 1; } }
    }
    block(start, ntok, versions_ok, testish);
}

int main(int argc, char **argv) {
    long t0 = sy_now_ms(), files = 0; int i, strict = 0, given = 0;
    for (i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--strict")) strict = 1;
        else if (tx_eqz(argv[i], "--rules") && i + 1 < argc) rules_filter = argv[++i];
        else if (tx_eqz(argv[i], "--")) continue;
        else { given = 1; lint_file(argv[i]); files++; }
    }
    if (!given) {
        char *v[] = {"git", "ls-files", "--", "tools/*.cx", "tests/*.cx", 0};
        char *out = 0; size_t n = 0; long p = 0;
        if (cx_runv_timeout(v, 30, &out, &n) || !out) { fprintf(stderr, "cx-lint: git ls-files failed\n"); return 2; }
        while (p < (long)n) {
            long q = p;
            while (q < (long)n && out[q] != '\n') q++;
            out[q] = 0;
            if (q > p) { lint_file(out + p); files++; }
            p = q + 1;
        }
    }
    printf("CX_LINT\tfiles=%ld\tfindings=%ld\telapsed_ms=%ld\n", files - missing, findings, sy_now_ms() - t0);
    if (missing) fprintf(stderr, "cx-lint: %ld tracked path(s) missing on disk, not linted\n", missing);
    return strict && findings ? 1 : 0;
}
