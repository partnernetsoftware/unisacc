/* tools/core-libc-map.cx -- map docked cx/{sys,mem,text} core files to their docked libc/host symbols.
 *
 *   sh ./unisacc.com tools/core-libc-map.cx -- [--write | --check] [--table PATH]
 *
 * Scans regular .cx files under cx/sys, cx/mem, cx/text that declare `#pragma unisa dock` at line start,
 * runs `tools/symindex.cx external --names` once over that sorted list, and emits/checks:
 *   core_file <TAB> face_prefix <TAB> symbol <TAB> kind <TAB> sites
 * Prints CORE_LIBC_MAP<TAB>OK|WROTE|DIFF<TAB>rows=N<TAB>files=F<TAB>symbols=S; exits 0 on OK/WROTE, 1 on DIFF, 2 on error. */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.posix
#pragma unisa use sysx.process
#pragma unisa use text.text
#pragma unisa use mem.heap

#define CLM_MAXF 256
#define CLM_MAXR 2048

typedef struct {
    char file[128];
    char pref[8];
    char sym[128];
    char kind[16];
    long sites;
} ClmRow;

static char clm_files[CLM_MAXF][128];
static int clm_nf;
static ClmRow clm_rows[CLM_MAXR];
static int clm_nr;

static void clm_die(const char *s) { fprintf(stderr, "core-libc-map: %s\n", s); exit(2); }

static int clm_has_dock(const char *path) {
    size_t n = 0;
    char *b = cx_read(path, &n);
    if (!b) return 0;
    long i = 0;
    int in_blk = 0, found = 0;
    while (i < (long)n && !found) {
        long ls = i, le;
        while (i < (long)n && b[i] != '\n') i++;
        le = i; if (i < (long)n) i++;
        if (!in_blk) {
            long j = ls;
            while (j < le && (b[j] == ' ' || b[j] == '\t')) j++;
            if (j < le && b[j] == '#') {
                j++; while (j < le && (b[j] == ' ' || b[j] == '\t')) j++;
                if (j + 6 <= le && tx_prefix(b + j, le - j, "pragma", 6)) {
                    j += 6;
                    if (j < le && (b[j] == ' ' || b[j] == '\t')) {
                        while (j < le && (b[j] == ' ' || b[j] == '\t')) j++;
                        if (j + 5 <= le && tx_prefix(b + j, le - j, "unisa", 5)) {
                            j += 5;
                            if (j < le && (b[j] == ' ' || b[j] == '\t')) {
                                while (j < le && (b[j] == ' ' || b[j] == '\t')) j++;
                                if (j + 4 <= le && tx_prefix(b + j, le - j, "dock", 4) &&
                                    (j + 4 == le || b[j + 4] == ' ' || b[j + 4] == '\t' || b[j + 4] == '\r' || b[j + 4] == '/')) found = 1;
                            }
                        }
                    }
                }
            }
        }
        {   long k = ls;
            while (k < le) {
                if (in_blk) { if (k + 1 < le && b[k] == '*' && b[k + 1] == '/') { in_blk = 0; k += 2; } else k++; }
                else if (b[k] == '"' || b[k] == '\'') { char q = b[k++]; while (k < le && b[k] != q) { if (b[k] == '\\' && k + 1 < le) k += 2; else k++; } if (k < le) k++; }
                else if (k + 1 < le && b[k] == '/' && b[k + 1] == '/') break;
                else if (k + 1 < le && b[k] == '/' && b[k + 1] == '*') { in_blk = 1; k += 2; }
                else k++;
            }
        }
    }
    free(b);
    return found;
}

static void clm_scan_dir(const char *dir) {
    sy_dir_t d;
    int r;
    if (sy_dir_open(&d, dir) != 0) clm_die(dir);
    while ((r = sy_dir_next(&d)) == 1) {
        if (d.name_n < 4 || d.name[d.name_n - 3] != '.' || d.name[d.name_n - 2] != 'c' || d.name[d.name_n - 1] != 'x') continue;
        char p[256];
        struct stat st;
        if (cx_fmt(p, sizeof p, "%s/%.*s", dir, (int)d.name_n, d.name)) clm_die("path");
        if (lstat(p, &st) != 0 || !S_ISREG(st.st_mode)) continue;
        if (!clm_has_dock(p)) continue;
        if (clm_nf >= CLM_MAXF) clm_die("too many core files");
        cx_fmt(clm_files[clm_nf], sizeof clm_files[0], "%s", p);
        clm_nf++;
    }
    sy_dir_close(&d);
}

static void clm_sort_files(void) {
    int i, j;
    for (i = 0; i < clm_nf; i++) {
        for (j = i + 1; j < clm_nf; j++) {
            if (strcmp(clm_files[i], clm_files[j]) > 0) {
                char tmp[128];
                cx_fmt(tmp, sizeof tmp, "%s", clm_files[i]);
                cx_fmt(clm_files[i], sizeof clm_files[0], "%s", clm_files[j]);
                cx_fmt(clm_files[j], sizeof clm_files[0], "%s", tmp);
            }
        }
    }
}

static void clm_sort_rows(void) {
    int i, j;
    for (i = 0; i < clm_nr; i++) {
        for (j = i + 1; j < clm_nr; j++) {
            int c = strcmp(clm_rows[i].file, clm_rows[j].file);
            if (c == 0) c = strcmp(clm_rows[i].sym, clm_rows[j].sym);
            if (c > 0) {
                ClmRow t = clm_rows[i];
                clm_rows[i] = clm_rows[j];
                clm_rows[j] = t;
            }
        }
    }
}

static const char *clm_prefix_of(const char *path) {
    if (tx_prefix(path, (long)tx_len(path, 128), "cx/mem/", 7)) return "mm_";
    if (tx_prefix(path, (long)tx_len(path, 128), "cx/text/", 8)) return "tx_";
    return "sy_";
}

int main(int argc, char **argv) {
    int mode = 0; /* 0=check, 1=write */
    const char *tpath = "build/core-libc-map.tsv";
    int a;
    for (a = 1; a < argc; a++) {
        if (tx_eqz(argv[a], "--write")) mode = 1;
        else if (tx_eqz(argv[a], "--check")) mode = 0;
        else if (tx_eqz(argv[a], "--table") && a + 1 < argc) tpath = argv[++a];
        else clm_die("usage: [--write | --check] [--table PATH]");
    }
    clm_scan_dir("cx/mem");
    clm_scan_dir("cx/sys");
    clm_scan_dir("cx/text");
    clm_sort_files();
    if (clm_nf == 0) clm_die("no docked core files found");

    char *av[CLM_MAXF + 10];
    int k = 0, i;
    av[k++] = "sh";
    av[k++] = "./unisacc.com"; /* lint:allow R1 invokes tools/symindex.cx under current product */
    av[k++] = "tools/symindex.cx";
    av[k++] = "--";
    av[k++] = "external";
    av[k++] = "--names";
    for (i = 0; i < clm_nf; i++) av[k++] = clm_files[i];
    av[k] = 0;

    np_result res;
    char why[256];
    if (np_run(av, ".", 0, 45, &res, why, sizeof why) || res.rc != 0 || !res.out) {
        if (res.err) fputs(res.err, stderr);
        np_free(&res);
        clm_die("symindex external failed");
    }

    long pos = 0, n = (long)res.outn;
    while (pos < n) {
        long ls = pos, le;
        while (pos < n && res.out[pos] != '\n') pos++;
        le = pos; if (pos < n) pos++;
        if (le - ls < 6 || !tx_prefix(res.out + ls, le - ls, "NAME\t", 5)) continue;
        long p0 = ls + 5, t1 = p0; while (t1 < le && res.out[t1] != '\t') t1++;
        long s0 = t1 + 1, t2 = s0; while (t2 < le && res.out[t2] != '\t') t2++;
        long k0 = t2 + 1, t3 = k0; while (t3 < le && res.out[t3] != '\t') t3++;
        long c0 = t3 + 1;
        if (t1 >= le || t2 >= le || t3 >= le) continue;
        if (!((t3 - k0 == 4 && tx_prefix(res.out + k0, 4, "libc", 4)) ||
              (t3 - k0 == 4 && tx_prefix(res.out + k0, 4, "host", 4)))) continue;
        if (!tx_prefix(res.out + c0, le - c0, "sites=", 6)) continue;
        long sites = 0, j;
        for (j = c0 + 6; j < le && res.out[j] >= '0' && res.out[j] <= '9'; j++) sites = sites * 10 + (res.out[j] - '0');
        if (clm_nr >= CLM_MAXR) clm_die("too many rows");
        {   ClmRow *r = &clm_rows[clm_nr++];
            cx_fmt(r->file, sizeof r->file, "%.*s", (int)(t1 - p0), res.out + p0);
            cx_fmt(r->pref, sizeof r->pref, "%s", clm_prefix_of(r->file));
            cx_fmt(r->sym, sizeof r->sym, "%.*s", (int)(t2 - s0), res.out + s0);
            cx_fmt(r->kind, sizeof r->kind, "%.*s", (int)(t3 - k0), res.out + k0);
            r->sites = sites;
        }
    }
    np_free(&res);
    clm_sort_rows();

    long cap = (long)clm_nr * 160 + 512, opos = 0;
    char *out = mm_alloc((size_t)cap);
    if (!out) clm_die("oom");
    {   const char *hdr = "# build/core-libc-map.tsv -- core docked files to docked libc/host symbols (generated by tools/core-libc-map.cx -- --write)\ncore_file\tface_prefix\tsymbol\tkind\tsites\n";
        long hl = (long)tx_len(hdr, 512), j;
        for (j = 0; j < hl; j++) out[opos++] = hdr[j];
    }
    int uniq_files = 0;
    for (i = 0; i < clm_nr; i++) {
        char line[320];
        if (i == 0 || strcmp(clm_rows[i].file, clm_rows[i - 1].file) != 0) uniq_files++;
        cx_fmt(line, sizeof line, "%s\t%s\t%s\t%s\t%ld\n", clm_rows[i].file, clm_rows[i].pref, clm_rows[i].sym, clm_rows[i].kind, clm_rows[i].sites);
        long ll = (long)tx_len(line, sizeof line), j;
        for (j = 0; j < ll; j++) out[opos++] = line[j];
    }

    if (mode == 1) {
        if (cx_write(tpath, out, (size_t)opos) != 0) clm_die("write failed");
        sy_printf("CORE_LIBC_MAP\tWROTE\trows=%d\tfiles=%d\ttable=%s\n", clm_nr, uniq_files, tpath);
        mm_free(out);
        return 0;
    }

    size_t dn = 0;
    char *disk = cx_read(tpath, &dn);
    if (!disk || (long)dn != opos || memcmp(disk, out, (size_t)opos) != 0) {
        sy_printf("CORE_LIBC_MAP\tDIFF\trows=%d\tfiles=%d\ttable=%s\t(run: sh ./unisacc.com tools/core-libc-map.cx -- --write)\n", clm_nr, uniq_files, tpath);
        if (disk) free(disk);
        mm_free(out);
        return 1;
    }
    free(disk);
    mm_free(out);
    sy_printf("CORE_LIBC_MAP\tOK\trows=%d\tfiles=%d\ttable=%s\n", clm_nr, uniq_files, tpath);
    return 0;
}
