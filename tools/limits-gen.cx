/* limits-gen: build/limits.tsv (唯一事实表) -> tools/cxlib/limits.cx.
 *   sh ./unisacc.com tools/limits-gen.cx -- --write|--check [ROOT]
 * ROOT 默认 "."; --check 在字节漂移、覆盖行缺 ledger_id/expires、覆盖行过期、
 * segment+segment.margin>op.rule、phase.bound 的 max>segment-3 时非零(漂移 1, 事实拒绝 2)。 */
#pragma unisa use sys.fs
#pragma unisa use sys.time
#pragma unisa use mem.bytes
#pragma unisa use cxlib.netpack
#define MAXR 64
static char *ids[MAXR],*scopes[MAXR],*defs[MAXR],*maxs[MAXR];
static int nr;
static void die(const char *s){fprintf(stderr,"limits-gen: REFUSE %s\n",s);exit(2);}
static int safe(const char *s){if(!*s)return 0;for(;*s;s++)if(!strchr("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_./*-",*s))return 0;return 1;}
static int num(const char *s){int dot=0;if(!*s)return 0;for(;*s;s++){if(*s=='.'){if(dot++)return 0;}else if(*s<'0'||*s>'9')return 0;}return 1;}
static int date_ok(const char *s){if(strlen(s)!=10||s[4]!='-'||s[7]!='-')return 0;for(int i=0;i<10;i++)if(i!=4&&i!=7&&(s[i]<'0'||s[i]>'9'))return 0;return 1;}
static double base(const char *id,int which){for(int i=0;i<nr;i++)if(!strcmp(ids[i],id)&&!strcmp(scopes[i],"*"))return atof(which?maxs[i]:defs[i]);die("missing base row");return 0;}
int main(int argc,char **argv){
 if(argc<2||argc>3||(strcmp(argv[1],"--write")&&strcmp(argv[1],"--check"))){fprintf(stderr,"limits-gen: usage --write|--check [ROOT]\n");return 2;}
 const char *root=argc==3?argv[2]:".";char src[2600],dst[2600];
 if(cx_fmt(src,sizeof src,"%s/build/limits.tsv",root)||cx_fmt(dst,sizeof dst,"%s/tools/cxlib/limits.cx",root))die("path bound");
 size_t n;char *s=cx_read(src,&n);if(!s||!n||n>65536||s[n-1]!='\n'||memchr(s,0,n)||memchr(s,'\r',n))die("table text");
 char today[16];{long z=sy_wall_s()/86400+719468,era=z/146097,doe=z-era*146097,yoe=(doe-doe/1460+doe/36524-doe/146096)/365,y=yoe+era*400,doy=doe-(365*yoe+yoe/4-yoe/100),mp=(5*doy+2)/153,d=doy-(153*mp+2)/5+1,m=mp<10?mp+3:mp-9;if(m<=2)y++;if(cx_fmt(today,sizeof today,"%04ld-%02ld-%02ld",y,m,d))die("date");}
 for(char *p=s;*p;){char *e=strchr(p,'\n');*e=0;
  if(*p&&*p!='#'){char *f[7];int k=0;f[k++]=p;for(char *q=p;*q&&k<8;q++)if(*q=='\t'){*q=0;if(k==7)die("columns");f[k++]=q+1;}
   if(k!=7)die("columns");
   if(!safe(f[0])||!safe(f[1])||!safe(f[4])||!safe(f[5])||(strcmp(f[6],"-")&&!date_ok(f[6])))die("token");
   if(!num(f[2])||!num(f[3]))die("number");
   if(atof(f[2])>atof(f[3]))die("default exceeds max");
   if(nr==MAXR)die("row bound");
   for(int i=0;i<nr;i++)if(!strcmp(ids[i],f[0])&&!strcmp(scopes[i],f[4]))die("duplicate row");
   if(strcmp(f[4],"*")){
    if(!strcmp(f[5],"-")||!strcmp(f[6],"-"))die("override without ledger_id/expires");
    if(strcmp(f[6],today)<0)die("override expired");
   }
   ids[nr]=f[0];scopes[nr]=f[4];defs[nr]=f[2];maxs[nr]=f[3];nr++;}
  p=e+1;}
 if(!nr)die("empty table");
 for(int i=0;i<nr;i++)base(ids[i],0);
 if(base("segment",0)+base("segment.margin",0)>base("op.rule",0))die("segment+margin exceeds op.rule");
 for(int i=0;i<nr;i++)if(!strcmp(ids[i],"phase.bound")&&atof(maxs[i])>base("segment",0)-3)die("phase.bound max exceeds segment-3");
 np_buf b={0};
 np_puts(&b,"/* Generated by tools/limits-gen.cx --write; edit build/limits.tsv. */\n#pragma unisa module limits\n");
 np_puts(&b,"static const char *lm_ids[] = {\n");for(int i=0;i<nr;i++){np_puts(&b," \"");np_puts(&b,ids[i]);np_puts(&b,"\",\n");}np_puts(&b,"};\n");
 np_puts(&b,"static const char *lm_scopes[] = {\n");for(int i=0;i<nr;i++){np_puts(&b," \"");np_puts(&b,scopes[i]);np_puts(&b,"\",\n");}np_puts(&b,"};\n");
 np_puts(&b,"static const double lm_defs[] = {\n");for(int i=0;i<nr;i++){np_puts(&b," ");np_puts(&b,defs[i]);np_puts(&b,",\n");}np_puts(&b,"};\n");
 np_puts(&b,"static const double lm_maxs[] = {\n");for(int i=0;i<nr;i++){np_puts(&b," ");np_puts(&b,maxs[i]);np_puts(&b,",\n");}np_puts(&b,"};\n");
 np_puts(&b,"static int lm_scope_match(const char *pat, const char *key) {\n"
  " int n = (int)strlen(pat);\n"
  " if (n && pat[n - 1] == '*') return !strncmp(pat, key, (size_t)(n - 1));\n"
  " return !strcmp(pat, key);\n}\n"
  "static int lm_find(const char *id, const char *scope_key) {\n"
  " int base = -1, n = (int)(sizeof lm_ids / sizeof lm_ids[0]);\n"
  " for (int i = 0; i < n; i++) {\n"
  "  if (strcmp(lm_ids[i], id)) continue;\n"
  "  if (!strcmp(lm_scopes[i], \"*\")) base = i;\n"
  "  else if (scope_key && lm_scope_match(lm_scopes[i], scope_key)) return i;\n"
  " }\n return base;\n}\n"
  "double lm_get(const char *id, const char *scope_key) { int i = lm_find(id, scope_key); return i < 0 ? -1.0 : lm_defs[i]; }\n"
  "double lm_max(const char *id, const char *scope_key) { int i = lm_find(id, scope_key); return i < 0 ? -1.0 : lm_maxs[i]; }\n"
  "int lm_count(void) { return (int)(sizeof lm_ids / sizeof lm_ids[0]); }\n");
 int check=!strcmp(argv[1],"--check");
 if(check){size_t z;char *old=cx_read(dst,&z);int same=old&&z==b.n&&!memcmp(old,b.p,z);free(old);if(!same){fprintf(stderr,"limits-gen: DIFF\n");return 1;}}
 else if(cx_write(dst,b.p,b.n))die("write library");
 printf("LIMITS_GEN\tstatus=%s\trows=%d\n",check?"CHECK":"WRITE",nr);
 return 0;
}
