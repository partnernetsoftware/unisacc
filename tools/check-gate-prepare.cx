/* check-gate-prepare.cx -- affected.cx --prepare-materials keeps an unpreparable material DEFERRED
 * with a named reason, and the default run (no flag) still defers on needs-materials.
 * Fast: no native build is started (the chosen batch declares a sha256 material, which is unpreparable).
 *   sh ./unisacc.com tools/check-gate-prepare.cx --
 */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use mem.bytes
#pragma unisa use text.text
static int has(const char *s, const char *w) { return s && strstr(s, w) != 0; }
static char *runaff(int prep) {
    char *av[] = {"./tools/bound", "40", "sh", "./unisacc.com", "tools/affected.cx", "--", "--ids", "release-ctor", "--run", "--prepare-materials", 0};
    char *out = 0; size_t n = 0;
    if (!prep) av[9] = 0;
    (void)cx_runv_timeout(av, 45, &out, &n);   /* rc 3 = only deferrals; judged by the lines below */
    return out;
}
int main(void) {
    int bad = 0;
    char *a = runaff(0), *b = runaff(1);
    if (!has(a, "DEFERRED\trelease-ctor\tneeds-materials=")) { printf("FAIL\tdefault-defers\n"); bad++; } else printf("PASS\tdefault-defers\n");
    if (!has(b, "DEFERRED\trelease-ctor\tprepare-failed=no-producer=") && !has(b, "DEFERRED\trelease-ctor\tprepare-failed=unpreparable=")) { printf("FAIL\tprepare-names-reason\n"); bad++; } else printf("PASS\tprepare-names-reason\n");
    if (!has(b, "PREBUILD\tmaterials=") || has(a, "PREBUILD\t")) { printf("FAIL\tprebuild-phase-only-with-flag\n"); bad++; } else printf("PASS\tprebuild-phase-only-with-flag\n");
    if (has(b, "\tstatus=PASS")) { printf("FAIL\tno-false-pass\n"); bad++; } else printf("PASS\tno-false-pass\n");
    {char *av[]={"sh","./unisacc.com","tools/affected.cx","--","--tier","commit","--ids","candidate-chain-watch","--run","-j","1",0};
     char *out=0;size_t n=0;int rc=cx_runv_timeout(av,40,&out,&n);
     if(rc!=3||!has(out,"DEFERRED\tcandidate-chain-watch\tneeds-materials=candidate-chain-tool:path")||has(out,"status=PASS")||has(out,"PREBUILD\t")){
         printf("FAIL\tcommit-native-tool-needs-materials-without-prepare\n");bad++;
     }else printf("PASS\tcommit-native-tool-needs-materials-without-prepare\n");free(out);
    }
    if (bad) return 1;
    printf("CHECK_GATE_PREPARE\n");
    return 0;
}
