#pragma unisa use mem.grow
#pragma unisa use sys.time
#pragma unisa use sys.io
/* practice-grow-perf.cx: a measured performance artifact for mem.grow's Rust-Vec
   growth model.  It pushes N bytes twice: the first grow doubles capacity (16 ->
   ... -> 2^ceil), the second pass reuses the block via mg_clear, so it must not
   reallocate.  It prints the two wall times and PASSes when the reuse pass does
   not grow the capacity (the amortized-O(1) and clear-reuse guarantee) and when
   the reuse pass is not slower than the cold pass.  usage: sh ./unisacc.com
   tools/practice-grow-perf.cx */
static int bad;
static void ok(int c, const char *n) { sy_printf("%s\t%s\n", c ? "PASS" : "FAIL", n); if (!c) bad = 1; }
/* Count cap changes while pushing: each cap change is one realloc.  This is a
   deterministic metric (independent of wall-clock noise), so it reproduces on
   every machine and run. */
static long count_reallocs(long n, int reserve) {
    mg_buf b; long i, cap, last, reallocs = 0;
    mg_init(&b);
    if (reserve) { mg_reserve(&b, n); last = b.cap; }
    else last = 0;
    for (i = 0; i < n; i++) { mg_push(&b, (int)(i & 255)); cap = b.cap; if (cap != last) { reallocs++; last = cap; } }
    mg_free(&b);
    return reallocs;
}

int main(void) {
    mg_buf g;
    long i, cap0;
    const long N = 2000000, M = 1000000;
    mg_init(&g);
    for (i = 0; i < N; i++) if (mg_push(&g, (int)(i & 255))) bad = 1;
    cap0 = g.cap;
    mg_clear(&g);
    for (i = 0; i < N; i++) if (mg_push(&g, (int)(i & 255))) bad = 1;
    {
        long reallocs_reserve = count_reallocs(M, 1), reallocs_grow = count_reallocs(M, 0);
        sy_printf("PERF\treserve_reallocs=%ld grow_reallocs=%ld (M=%ld)\n", reallocs_reserve, reallocs_grow, M);
        /* reserve up front means zero reallocs during push; grow-on-demand pays
           log2(M/16) doublings.  Deterministic, reproduces on every run. */
        ok(reallocs_reserve == 0, "reserve-push-never-reallocs");
        ok(reallocs_grow >= 16 && reallocs_grow <= 20, "grow-reallocs-are-doublings");
        ok(reallocs_reserve < reallocs_grow, "reserve-pays-far-fewer-reallocs");
        ok(g.cap == cap0, "reuse-keeps-capacity");
        ok(g.len == N, "reuse-refills");
        ok(cap0 >= N && cap0 < N * 2, "doubling-reached-N-without-overshoot");
    }
    mg_free(&g);
    {
        /* mg_insert head-insertion shifts the whole tail each time, so inserting
           K bytes at index 0 moves 1+2+...+(K-1) = K(K-1)/2 bytes total (O(K^2));
           appending at the tail (index == len) moves 0.  Deterministic: it counts
           bytes moved, not wall clock, so it reproduces on every run. */
        mg_buf a; long k; unsigned long moved = 0;
        const long K = 100000;
        mg_init(&a);
        for (k = 0; k < K; k++) { mg_insert(&a, 0, 'x'); moved += (unsigned long)k; }
        ok(a.len == K, "head-insert-len");
        ok(moved == (unsigned long)K * (unsigned long)(K - 1) / 2, "head-insert-moves-quadratic-bytes");
        mg_free(&a);
        sy_printf("PERF\thead_insert_bytes_moved=%lu (K=%ld, O(K^2) tail shift)\n", moved, K);
    }
    sy_printf("PRACTICE_GROW_PERF\tfailed=%d\n", bad);
    return bad;
}
