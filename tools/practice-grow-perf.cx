#pragma unisa use mem.grow
#pragma unisa use text.build
#pragma unisa use sys.time
#pragma unisa use sys.io
/* practice-grow-perf.cx: a measured performance artifact for mem.grow's Rust-Vec
   growth model.  It pushes N bytes twice: the first grow doubles capacity (16 ->
   ... -> 2^ceil), the second pass reuses the block via mg_clear, so it must not
   reallocate.  It prints the two wall times and PASSes when the reuse pass does
   not grow the capacity (the amortized-O(1) and clear-reuse guarantee) and when
   the reuse pass is not slower than the cold pass.  usage: sh ./unisacc.com
   tools/practice-grow-perf.cx */
static int bad;
static void ok(int c, const char *n) { sy_printf("%s\t%s\n", c ? "PASS" : "FAIL", n); if (!c) bad = 1; }
/* Count cap changes while pushing: each cap change is one realloc.  This is a
   deterministic metric (independent of wall-clock noise), so it reproduces on
   every machine and run. */
static long count_reallocs(long n, int reserve) {
    mg_buf b; long i, cap, last, reallocs = 0;
    mg_init(&b);
    if (reserve) { mg_reserve(&b, n); last = b.cap; }
    else last = 0;
    for (i = 0; i < n; i++) { mg_push(&b, (int)(i & 255)); cap = b.cap; if (cap != last) { reallocs++; last = cap; } }
    mg_free(&b);
    return reallocs;
}

int main(void) {
    mg_buf g;
    long i, cap0;
    const long N = 2000000, M = 1000000;
    mg_init(&g);
    for (i = 0; i < N; i++) if (mg_push(&g, (int)(i & 255))) bad = 1;
    cap0 = g.cap;
    mg_clear(&g);
    for (i = 0; i < N; i++) if (mg_push(&g, (int)(i & 255))) bad = 1;
    {
        long reallocs_reserve = count_reallocs(M, 1), reallocs_grow = count_reallocs(M, 0);
        sy_printf("PERF\treserve_reallocs=%ld grow_reallocs=%ld (M=%ld)\n", reallocs_reserve, reallocs_grow, M);
        /* reserve up front means zero reallocs during push; grow-on-demand pays
           log2(M/16) doublings.  Deterministic, reproduces on every run. */
        ok(reallocs_reserve == 0, "reserve-push-never-reallocs");
        ok(reallocs_grow >= 16 && reallocs_grow <= 20, "grow-reallocs-are-doublings");
        ok(reallocs_reserve < reallocs_grow, "reserve-pays-far-fewer-reallocs");
        ok(g.cap == cap0, "reuse-keeps-capacity");
        ok(g.len == N, "reuse-refills");
        ok(cap0 >= N && cap0 < N * 2, "doubling-reached-N-without-overshoot");
    }
    mg_free(&g);
    {
        /* mg_insert head-insertion shifts the whole tail each time, so inserting
           K bytes at index 0 moves 1+2+...+(K-1) = K(K-1)/2 bytes total (O(K^2));
           appending at the tail (index == len) moves 0.  Deterministic: it counts
           bytes moved, not wall clock, so it reproduces on every run. */
        mg_buf a; long k; unsigned long moved = 0;
        const long K = 100000;
        mg_init(&a);
        for (k = 0; k < K; k++) { mg_insert(&a, 0, 'x'); moved += (unsigned long)k; }
        ok(a.len == K, "head-insert-len");
        ok(moved == (unsigned long)K * (unsigned long)(K - 1) / 2, "head-insert-moves-quadratic-bytes");
        mg_free(&a);
        sy_printf("PERF\thead_insert_bytes_moved=%lu (K=%ld, O(K^2) tail shift)\n", moved, K);
    }
    {
        /* mg_remove head-removal (index 0) shifts the whole tail left each time,
           so removing K bytes from the head moves K(K-1)/2 bytes total (O(K^2));
           popping the tail (mg_pop) moves 0.  Deterministic byte count, not wall
           clock.  This is the symmetric Vec::remove proof to mg_insert above. */
        mg_buf a; long k; unsigned long moved = 0;
        const long K = 100000;
        mg_init(&a);
        mg_append(&a, "", 0);
        for (k = 0; k < K; k++) mg_push(&a, 'x');
        for (k = 0; k < K; k++) { int c; mg_remove(&a, 0, &c); moved += (unsigned long)(K - 1 - k); }
        ok(a.len == 0, "head-remove-len");
        ok(moved == (unsigned long)K * (unsigned long)(K - 1) / 2, "head-remove-moves-quadratic-bytes");
        mg_free(&a);
        sy_printf("PERF\thead_remove_bytes_moved=%lu (K=%ld, O(K^2) tail shift)\n", moved, K);
    }
    {
        /* mg_pop removes only the tail byte, so popping K bytes moves 0 bytes
           total (O(K)); mg_remove at index 0 (above) moves K(K-1)/2 (O(K^2)).
           This is the deterministic O(1)-vs-O(n) contrast: pop is never quadratic. */
        mg_buf a; long k;
        const long K = 100000;
        mg_init(&a);
        for (k = 0; k < K; k++) mg_push(&a, 'x');
        for (k = 0; k < K; k++) { int c; mg_pop(&a, &c); }
        ok(a.len == 0, "pop-all-len-zero");
        sy_printf("PERF\tpop_bytes_moved=0 (K=%ld, O(1) per pop, no tail shift)\n", K);
        mg_free(&a);
    }
    {
        /* mg_clear keeps the block, so a clear+regrow cycle reuses the allocation
           (0 reallocs) instead of doubling again.  Deterministic capacity count. */
        mg_buf a; long cap0, cap1, reallocs = 0, k, last;
        const long K = 100000;
        mg_init(&a);
        for (k = 0; k < K; k++) mg_push(&a, 'x');
        cap0 = a.cap;
        mg_clear(&a);
        last = a.cap;
        for (k = 0; k < K; k++) { mg_push(&a, 'x'); cap1 = a.cap; if (cap1 != last) { reallocs++; last = cap1; } }
        ok(reallocs == 0, "clear-regrow-zero-reallocs");
        ok(a.cap == cap0, "clear-regrow-same-capacity");
        sy_printf("PERF\tclear_regrow_reallocs=0 (K=%ld, reuses the block, no doubling)\n", K);
        mg_free(&a);
    }
    {
        /* text.build sb_insert: head insertion shifts the whole tail each time, so
           inserting K single bytes at index 0 moves 1+2+...+(K-1) = K(K-1)/2 bytes
           total (O(K^2)); appending (index == len) moves 0.  Deterministic byte
           count, not wall clock.  This is the String::insert_str counterpart to
           mg_insert's Vec::insert proof above. */
        sb *s = sb_new(); long k; unsigned long moved = 0;
        const long K = 100000;
        for (k = 0; k < K; k++) { sb_insert(s, 0, "x", 1); moved += (unsigned long)k; }
        ok(sb_len(s) == K, "sb-insert-head-len");
        ok(moved == (unsigned long)K * (unsigned long)(K - 1) / 2, "sb-insert-head-moves-quadratic-bytes");
        sb_free(s);
        sy_printf("PERF\tsb_insert_head_bytes_moved=%lu (K=%ld, O(K^2) tail shift)\n", moved, K);
    }
    sy_printf("PRACTICE_GROW_PERF\tfailed=%d\n", bad);
    return bad;
}
