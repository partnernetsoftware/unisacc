#pragma unisa use mem.grow
#pragma unisa use sys.time
/* practice-grow-perf.cx: a measured performance artifact for mem.grow's Rust-Vec
   growth model.  It pushes N bytes twice: the first grow doubles capacity (16 ->
   ... -> 2^ceil), the second pass reuses the block via mg_clear, so it must not
   reallocate.  It prints the two wall times and PASSes when the reuse pass does
   not grow the capacity (the amortized-O(1) and clear-reuse guarantee) and when
   the reuse pass is not slower than the cold pass.  usage: sh ./unisacc.com
   tools/practice-grow-perf.cx */
static int bad;
static void ok(int c, const char *n) { printf("%s\t%s\n", c ? "PASS" : "FAIL", n); if (!c) bad = 1; }
int main(void) {
    mg_buf g;
    long i, cap0, t0, t1, t2;
    const long N = 2000000;
    mg_init(&g);
    t0 = sy_now_ms();
    for (i = 0; i < N; i++) if (mg_push(&g, (int)(i & 255))) bad = 1;
    t1 = sy_now_ms();
    cap0 = g.cap;
    mg_clear(&g);
    t2 = sy_now_ms();
    for (i = 0; i < N; i++) if (mg_push(&g, (int)(i & 255))) bad = 1;
    {
        long cold = t1 - t0, reuse = sy_now_ms() - t2;
        printf("PERF\tcold_ms=%ld reuse_ms=%ld cap=%ld (N=%ld)\n", cold, reuse, cap0, N);
        ok(g.cap == cap0, "reuse-keeps-capacity");
        ok(g.len == N, "reuse-refills");
        ok(reuse <= cold + 5, "reuse-not-slower-than-cold");
        ok(cap0 >= N && cap0 < N * 2, "doubling-reached-N-without-overshoot");
    }
    mg_free(&g);
    printf("PRACTICE_GROW_PERF\tfailed=%d\n", bad);
    return bad;
}
