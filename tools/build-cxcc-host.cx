/* Build gcc_cx and clang_cx on the machine that will run them.
   Each driver is compiled by the same compiler name it will call.
   gcc and clang are taken from PATH. A missing name is skipped.
   The drivers link src/cxmod.c and do not call unisacc.com. -o only.
   Product file: <cmd>_<lnx|osx|win><64|32>-<x86|arm>.bin
   Windows uses .exe. This Linux x86-64 host writes
   out/cxcc-host/gcc_cx_lnx64-x86.bin and clang_cx_lnx64-x86.bin.
   write_launcher replaces the repo-root .com with a shell that execs that
   file. The six-cell APE pack is what leaves gcc_cx.com and clang_cx.com
   in place. 32-bit and win64-arm are names, not slices.
   The driver names tools/cxproc.cx. This builder compiles that file too,
   because stock gcc and clang do not expand `#pragma unisa use`.

   Linux, and OSX when the name gcc is on PATH:
   gcc -std=c99 -Werror=implicit-function-declaration -include include/cx.h -x c tools/build-cxcc-host.cx -o out/cxcc-host/build
   ./out/cxcc-host/build
   OSX when the host compiler is clang (Apple clang is enough to build this file):
   clang -std=c99 -Werror=implicit-function-declaration -include include/cx.h -x c tools/build-cxcc-host.cx -o out/cxcc-host/build
   ./out/cxcc-host/build
   Then: sh ./gcc_cx.com FILE.cx -o OUT
         sh ./clang_cx.com FILE.cx -o OUT

   Windows, from the repository root, MinGW gcc or MinGW clang on PATH.
   The .com file is that native program, not a shell script:
   gcc -std=c99 -Werror=implicit-function-declaration -I tools/cxcc-hostinc -include include/cx.h -include tools/cxcc-hostinc/win.h -x c tools/build-cxcc-host.cx -o out/cxcc-host/build.exe
   out\cxcc-host\build.exe
   Then: gcc_cx.com FILE.cx -o OUT
         clang_cx.com FILE.cx -o OUT
   On Windows this builder calls posix_spawnp and waitpid. The bodies are
   tools/cxcc-hostinc/spawn.h (CreateProcessA and open). Linux and OSX use
   the system libc through cx_run_timeout.
*/
static int write_text(const char *path, const char *text) {
    FILE *f;
    size_t want, n;
    f = fopen(path, "wb");
    if (!f) return -1;
    want = strlen(text);
    n = fwrite(text, 1, want, f);
    if (fclose(f) != 0) return -1;
    return n == want ? 0 : -1;
}

/* Host build dir: $TMPDIR (default /tmp)/unisacc-cxcc-host-UID.  tools/cxcc.cx computes the same path. */
static char H[256];
static int host_dir_init(void) {
    const char *td = getenv("TMPDIR");
    int k;
    if (!td || !td[0]) td = getenv("TEMP");
    if (!td || !td[0]) td = "/tmp";
#ifdef _WIN32
    k = snprintf(H, sizeof H, "%s/unisacc-cxcc-host-w", td);
#else
    k = snprintf(H, sizeof H, "%s/unisacc-cxcc-host-%lu", td, (unsigned long)getuid());
#endif
    return (k < 0 || k >= (int)sizeof H) ? -1 : 0;
}

static int ensure_dir(const char *path) {
    struct stat st;
    if (mkdir(path, 0755) == 0) return 0;
    if (errno == EEXIST && stat(path, &st) == 0 && S_ISDIR(st.st_mode)) return 0;
    fprintf(stderr, "build-cxcc-host: cannot create %s\n", path);
    return -1;
}

#ifndef _WIN32
static int run(const char *cmd) {
    char *buf = 0;
    size_t n = 0;
    int rc;
    rc = cx_run_timeout(cmd, 50, &buf, &n);
    if (buf && n && fwrite(buf, 1, n, stderr) != n) {
        free(buf);
        return 1;
    }
    free(buf);
    if (rc != 0) fprintf(stderr, "build-cxcc-host: rc=%d %s\n", rc, cmd);
    return rc;
}

static int on_path(const char *cc) {
    char line[96];
    char *buf = 0;
    size_t n = 0;
    int rc, k;
    k = snprintf(line, sizeof line, "command -v %s >/dev/null 2>&1", cc);
    if (k < 0 || k >= (int)sizeof line) return 0;
    rc = cx_run_timeout(line, 10, &buf, &n);
    free(buf);
    return rc == 0;
}

/* Product file: <cmd>_<os><64|32>-<x86|arm>.bin  (Windows uses .exe). */
static int host_bin_name(const char *cmd, char *out, size_t cap) {
    char *osb = 0, *mb = 0;
    size_t on = 0, mn = 0;
    const char *os, *bits, *arch;
    int rc, k;
    rc = cx_run_timeout("uname -s", 5, &osb, &on);
    if (rc != 0 || !osb) { free(osb); return -1; }
    rc = cx_run_timeout("uname -m", 5, &mb, &mn);
    if (rc != 0 || !mb) { free(osb); free(mb); return -1; }
    while (on && (osb[on - 1] == '\n' || osb[on - 1] == '\r')) osb[--on] = 0;
    while (mn && (mb[mn - 1] == '\n' || mb[mn - 1] == '\r')) mb[--mn] = 0;
    if (!strcmp(osb, "Linux")) os = "lnx";
    else if (!strcmp(osb, "Darwin")) os = "osx";
    else { free(osb); free(mb); return -1; }
    if (!strcmp(mb, "x86_64")) { bits = "64"; arch = "x86"; }
    else if (!strcmp(mb, "aarch64") || !strcmp(mb, "arm64")) { bits = "64"; arch = "arm"; }
    else if (!strcmp(mb, "i386") || !strcmp(mb, "i686")) { bits = "32"; arch = "x86"; }
    else if (!strncmp(mb, "arm", 3)) { bits = "32"; arch = "arm"; }
    else { free(osb); free(mb); return -1; }
    k = snprintf(out, cap, "%s_%s%s-%s.bin", cmd, os, bits, arch);
    free(osb);
    free(mb);
    return (k < 0 || (size_t)k >= cap) ? -1 : 0;
}

static int write_launcher(const char *cmdname, const char *bin) {
    char path[64];
    char text[512];
    int k;
    k = snprintf(path, sizeof path, "%s.com", cmdname);
    if (k < 0 || k >= (int)sizeof path) return -1;
    k = snprintf(text, sizeof text,
                 "#!/bin/sh\n"
                 "here=$(CDPATH= cd -- \"$(dirname \"$0\")\" && pwd) || exit 2\n"
                 "exec \"${TMPDIR:-/tmp}/unisacc-cxcc-host-$(id -u)/%s\" \"$@\"\n",
                 bin);
    if (k < 0 || k >= (int)sizeof text) return -1;
    if (write_text(path, text)) return -1;
    if (chmod(path, 0755) != 0) return -1;
    return 0;
}

static int build_pch(const char *cc, const char *tag) {
    char d[320], line[1024];
    int k;
    (void)cc;
    k = snprintf(d, sizeof d, "%s/%s-trim", H, tag[0] == 'c' ? "clang" : "gcc");
    if (k < 0 || k >= (int)sizeof d || ensure_dir(d)) return 1;
    k = snprintf(line, sizeof line, "cp include/cx.h include/cx-nested.h include/unisa_sha256.h include/unisa_safedel.h %s/", d);
    if (k < 0 || k >= (int)sizeof line || run(line)) return 1;
    if (tag[0] == 'c') k = snprintf(line, sizeof line, "clang -std=c99 -D__UNISA_FTRIM_LIBC=1 -x c-header %s/cx.h -o %s/cx.h.pch", d, d);
    else k = snprintf(line, sizeof line, "gcc -std=c99 -D__UNISA_FTRIM_LIBC=1 -x c-header %s/cx.h -o %s/cx.h.gch", d, d);
    if (k < 0 || k >= (int)sizeof line || run(line)) return 1;
    return 0;
}

static int build_one(const char *cc, const char *cmdname) {
    char line[1024];
    char bin[80];
    int k;
    if (host_bin_name(cmdname, bin, sizeof bin)) return 1;
    k = snprintf(line, sizeof line,
                 "%s -std=c99 -Werror=implicit-function-declaration -include stdlib.h -DCXM_HOST_REALPATH -c src/cxmod.c -o %s/%s-cxmod.o",
                 cc, H, cc);
    if (k < 0 || k >= (int)sizeof line || run(line)) return 1;
    k = snprintf(line, sizeof line,
                 "%s -std=c99 -Werror=implicit-function-declaration -include include/cx.h -x c -c tools/cxcc.cx -o %s/%s-cxcc.o",
                 cc, H, cc);
    if (k < 0 || k >= (int)sizeof line || run(line)) return 1;
    k = snprintf(line, sizeof line,
                 "%s -std=c99 -Werror=implicit-function-declaration -include include/cx.h -x c -c tools/cxproc.cx -o %s/%s-cxproc.o",
                 cc, H, cc);
    if (k < 0 || k >= (int)sizeof line || run(line)) return 1;
    k = snprintf(line, sizeof line,
                 "%s -std=c99 -Werror=implicit-function-declaration -include include/cx.h -x c -c tools/%s.cx -o %s/%s-main.o",
                 cc, cmdname, H, cc);
    if (k < 0 || k >= (int)sizeof line || run(line)) return 1;
    k = snprintf(line, sizeof line,
                 "%s -std=c99 -o %s/%s %s/%s-cxcc.o %s/%s-cxproc.o %s/%s-cxmod.o %s/%s-main.o",
                 cc, H, bin, H, cc, H, cc, H, cc, H, cc);
    if (k < 0 || k >= (int)sizeof line || run(line)) return 1;
    if (write_launcher(cmdname, bin)) return 1;
    printf("build-cxcc-host: %s\n", bin);
    return 0;
}
#else
static int build_pch(const char *cc, const char *tag) { (void)cc; (void)tag; return 0; }
static int copy_file(const char *from, const char *to) {
    FILE *in, *out;
    char buf[8192];
    size_t n;
    in = fopen(from, "rb");
    if (!in) return -1;
    out = fopen(to, "wb");
    if (!out) { fclose(in); return -1; }
    while ((n = fread(buf, 1, sizeof buf, in)) > 0) {
        if (fwrite(buf, 1, n, out) != n) { fclose(in); fclose(out); return -1; }
    }
    if (ferror(in)) { fclose(in); fclose(out); return -1; }
    if (fclose(in) != 0) { fclose(out); return -1; }
    if (fclose(out) != 0) return -1;
    return 0;
}

static int on_path(const char *cc) {
    const char *env, *p, *q;
    char tryb[4096];
    char name[2][80];
    int npass, pass, n, k;
    env = getenv("PATH");
    if (!env || strlen(cc) >= 60) return 0;
    if (snprintf(name[0], sizeof name[0], "%s", cc) < 0) return 0;
    npass = 1;
    if (!strstr(cc, ".exe") && !strstr(cc, ".EXE")) {
        if (snprintf(name[1], sizeof name[1], "%s.exe", cc) > 0) npass = 2;
    }
    p = env;
    while (*p) {
        q = p;
        while (*q && *q != ';') q++;
        n = (int)(q - p);
        for (pass = 0; pass < npass; pass++) {
            if (n <= 0) k = snprintf(tryb, sizeof tryb, "%s", name[pass]);
            else k = snprintf(tryb, sizeof tryb, "%.*s/%s", n, p, name[pass]);
            if (k > 0 && k < (int)sizeof tryb && access(tryb, 0) == 0) return 1;
        }
        if (*q == 0) break;
        p = q + 1;
    }
    return 0;
}

static int wrun(char **av) {
    pid_t pid = 0;
    int st = 0, spr, rc, i;
    spr = posix_spawnp(&pid, av[0], 0, 0, av, 0);
    if (spr != 0) {
        fprintf(stderr, "build-cxcc-host: cannot run");
        for (i = 0; av[i]; i++) fprintf(stderr, " %s", av[i]);
        fputc('\n', stderr);
        return 1;
    }
    if (waitpid(pid, &st, 0) < 0) {
        fprintf(stderr, "build-cxcc-host: lost child\n");
        return 1;
    }
    if (WIFEXITED(st)) rc = WEXITSTATUS(st);
    else if (WIFSIGNALED(st)) rc = 128 + WTERMSIG(st);
    else rc = 2;
    if (rc == 0) return 0;
    fprintf(stderr, "build-cxcc-host: rc=%d", rc);
    for (i = 0; av[i]; i++) fprintf(stderr, " %s", av[i]);
    fputc('\n', stderr);
    return 1;
}

static int host_bin_name(const char *cmd, char *out, size_t cap) {
    const char *tag;
#if defined(_WIN64) && (defined(__aarch64__) || defined(_M_ARM64))
    tag = "win64-arm";
#elif defined(_WIN64)
    tag = "win64-x86";
#elif defined(__aarch64__) || defined(_M_ARM64) || defined(__arm__) || defined(_M_ARM)
    tag = "win32-arm";
#else
    tag = "win32-x86";
#endif
    {
        int k = snprintf(out, cap, "%s_%s.exe", cmd, tag);
        return (k < 0 || (size_t)k >= cap) ? -1 : 0;
    }
}

static int build_one(const char *cc, const char *cmdname) {
    char omod[320], occ[320], oproc[320], omain[320], obin[320], srcpath[80], com[80], bin[80];
    char *av[20];
    int k;
    k = snprintf(omod, sizeof omod, "%s/%s-cxmod.o", H, cc);
    if (k < 0 || k >= (int)sizeof omod) return 1;
    k = snprintf(occ, sizeof occ, "%s/%s-cxcc.o", H, cc);
    if (k < 0 || k >= (int)sizeof occ) return 1;
    k = snprintf(oproc, sizeof oproc, "%s/%s-cxproc.o", H, cc);
    if (k < 0 || k >= (int)sizeof oproc) return 1;
    k = snprintf(omain, sizeof omain, "%s/%s-main.o", H, cc);
    if (k < 0 || k >= (int)sizeof omain) return 1;
    if (host_bin_name(cmdname, bin, sizeof bin)) return 1;
    k = snprintf(obin, sizeof obin, "%s/%s", H, bin);
    if (k < 0 || k >= (int)sizeof obin) return 1;
    k = snprintf(srcpath, sizeof srcpath, "tools/%s.cx", cmdname);
    if (k < 0 || k >= (int)sizeof srcpath) return 1;
    k = snprintf(com, sizeof com, "%s.com", cmdname);
    if (k < 0 || k >= (int)sizeof com) return 1;
    av[0] = (char *)cc;
    av[1] = "-std=c99";
    av[2] = "-Werror=implicit-function-declaration";
    av[3] = "-include";
    av[4] = "stdlib.h";
    av[5] = "-c";
    av[6] = "src/cxmod.c";
    av[7] = "-o";
    av[8] = omod;
    av[9] = 0;
    if (wrun(av)) return 1;
    av[3] = "-I";
    av[4] = "tools/cxcc-hostinc";
    av[5] = "-include";
    av[6] = "include/cx.h";
    av[7] = "-include";
    av[8] = "tools/cxcc-hostinc/win.h";
    av[9] = "-x";
    av[10] = "c";
    av[11] = "-c";
    av[12] = "tools/cxcc.cx";
    av[13] = "-o";
    av[14] = occ;
    av[15] = 0;
    if (wrun(av)) return 1;
    av[12] = "tools/cxproc.cx";
    av[14] = oproc;
    if (wrun(av)) return 1;
    /* The entry file needs cx.h, not win.h. Drop the second -include. */
    av[7] = "-x";
    av[8] = "c";
    av[9] = "-c";
    av[10] = srcpath;
    av[11] = "-o";
    av[12] = omain;
    av[13] = 0;
    if (wrun(av)) return 1;
    av[1] = "-std=c99";
    av[2] = "-o";
    av[3] = obin;
    av[4] = occ;
    av[5] = oproc;
    av[6] = omod;
    av[7] = omain;
    av[8] = 0;
    if (wrun(av)) return 1;
    if (copy_file(obin, com)) return 1;
    return 0;
}
#endif

int main(void) {
    int built = 0;
    if (host_dir_init() || ensure_dir(H)) return 1;
    if (on_path("gcc")) {
        if (build_one("gcc", "gcc_cx")) return 1;
        if (build_pch("gcc", "gcc")) return 1;
        built = 1;
    } else fprintf(stderr, "build-cxcc-host: skip gcc_cx (gcc is not on PATH)\n");
    if (on_path("clang")) {
        if (build_one("clang", "clang_cx")) return 1;
        if (build_pch("clang", "clang")) return 1;
        built = 1;
    } else fprintf(stderr, "build-cxcc-host: skip clang_cx (clang is not on PATH)\n");
    if (!built) {
        fprintf(stderr, "build-cxcc-host: no compiler on PATH\n");
        return 1;
    }
    printf("build-cxcc-host: ok\n");
    return 0;
}
