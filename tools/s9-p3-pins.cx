/* s9-p3-pins: 同一候选 pkg.bin/APE 现算 P3 与文件 sha，写 MAP 钉。
 *   sh ./unisacc.com tools/s9-p3-pins.cx -- PKG_OR_APE MAP_OUT
 * 自指钉；禁止旧候选拷贝。PREPARED≠PASS。 */
#pragma unisa use cxlib.packagefooter
#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
#pragma unisa use sys.io
static void die(const char *s){sy_eprintf("s9-p3-pins: REFUSE %s\n",s);exit(2);}
int main(int argc,char **argv){
    int a=argc>=2&&!strcmp(argv[1],"--")?2:1;
    if(argc-a!=2){sy_eprintf("usage: PKG MAP_OUT\n");return 2;}
    size_t n=0; char *b=cx_read(argv[a],&n); if(!b||n<16) die("read");
    PackageFooter f; if(!packagefooter_locate_bytes((unsigned char*)b,(long)n,&f)||f.package_length<=0) die("not canonical P3");
    char file_sha[65], p3_sha[65];
    cx_sha256_hex(b,n,file_sha);
    cx_sha256_hex(b+f.package_offset,(size_t)f.package_length,p3_sha);
    int fd=sy_open_new(argv[a+1],0600);
    if(fd<0) die("MAP_OUT must be absent");
    char row[512];
    if(cx_fmt(row,sizeof row,"candidate-file-sha\t%s\np3-sha\t%s\n",file_sha,p3_sha)) die("fmt");
    { long L=0; while(row[L]) L++; if(sy_write_all(fd,row,L)||sy_close(fd)) die("write"); }
    sy_printf("PINS\tfile=%s\tp3=%s\n",file_sha,p3_sha);
    return 0;
}
