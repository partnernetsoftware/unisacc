/* tools/archive-ar-cases.cx -- formats cell archive.product-ar (prd.md:669: `unisacc ar rcs|t|x` produces/reads archives
 * the system ar accepts; the link pulls only needed members).
 *   sh ./unisacc.com tools/archive-ar-cases.cx -- ROOT ABS_OUT HOST_AR
 * Fixtures: used.c (used()=5), unused.c (unused()=99), main.c (main = used()+2 -> exit 7), compiled as unit objects
 * (`-c -b lnx/x86_64 -funit`). Oracles (independent, written here; exec/c/compiler.c:424 product_ar, :401 selection):
 *   structure: an ar(5) parser of this file -- magic `!<arch>\n`, 60-byte headers (name 16, mtime 12, uid 6, gid 6,
 *     mode 8, size 10 decimal, fmag "`\n"), members at even offsets with a single pad byte after odd sizes, member names
 *     and sizes equal to the inputs, member bytes identical to the input objects, no trailing bytes;
 *   t-listing: `unisacc ar t` prints exactly the member names in order;
 *   x-extract: `unisacc ar x` rewrites each member byte-identical to the input;
 *   link-only-needed: image from main.o + lib.a(used.o, unused.o) is byte-equal to the image from main.o + used.o, and
 *     exits 7; the archive order (unused first) must not change that;
 *   HOST_AR (the declared oracle; fable ruling 2026-10-28: "system ar accepts" is an interoperability contract, so the
 *     host tool stays the oracle and the cx parser is an added assertion): host `ar t` / `ar x` on the product archive
 *     must give the exact listing and identical bytes; the product must `t` and link a host-made archive to the same
 *     image. Its path, `--version` first line and SHA-256 are recorded as oracle identity (oracle_id). */
#pragma unisa use cxlib.netpack
#pragma unisa use text.text

static char root[4096], outdir[4096], product[4400], hostar[4096]; static int npass, nfail; static FILE *res;
static void die(const char *s) { fprintf(stderr, "archive-ar-cases: REFUSE %s errno=%d\n", s, errno); exit(2); }
static void path(char *p, size_t cap, const char *a, const char *b) { int n = snprintf(p, cap, "%s/%s", a, b); if (n < 0 || (size_t)n >= cap) die("path"); }
static void saved(const char *p, const char *s, size_t n) { int f = open(p, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600); if (f < 0) die("exclusive create"); while (n) { ssize_t k = write(f, s, n); if (k <= 0) die("write"); s += k; n -= (size_t)k; } if (close(f)) die("close"); }
static void check(int ok, const char *label, const char *detail) { fprintf(res, "%s\tarchive.product-ar.%s\t%s\n", ok ? "PASS" : "FAIL", label, detail); printf("%s\t%s\n", ok ? "PASS" : "FAIL", label); if (ok) npass++; else nfail++; }
static void info(const char *state, const char *label, const char *detail) { fprintf(res, "%s\tarchive.product-ar.%s\t%s\n", state, label, detail); printf("%s\t%s\n", state, label); }
/* run ARGV in DIR, 20 s bound */
static int runin(const char *dir, char *const argv[], np_result *r) { char why[1024]; return np_run((char *const *)argv, dir, 0, 20, r, why, sizeof why); }
static int prod(const char *dir, char *const extra[], np_result *r) { char *v[16]; int n = 0; v[n++] = "sh"; v[n++] = product; for (int i = 0; extra[i]; i++) { if (n >= 15) die("argv"); v[n++] = extra[i]; } v[n] = 0; return runin(dir, v, r); }
static int prod_rc(const char *dir, char *const extra[]) { np_result r; if (prod(dir, extra, &r)) return -1; int rc = r.rc; np_free(&r); return rc; }
static char *load(const char *p, size_t *n) { char *b = cx_read(p, &n[0]); if (!b) die(p); return b; }
static int same(const char *a, const char *b) { size_t na, nb; char *x = cx_read(a, &na), *y = cx_read(b, &nb); int ok = x && y && na == nb && !memcmp(x, y, na); free(x); free(y); return ok; }
/* independent ar(5) walk: fills names/sizes/offsets; returns 0 on a malformed archive with WHY */
static int ar_walk(const char *b, size_t n, char names[8][17], size_t sizes[8], size_t offs[8], int *count, char *why, size_t cap) {
    *count = 0; if (n < 8 || memcmp(b, "!<arch>\n", 8)) { snprintf(why, cap, "bad magic"); return 0; } size_t at = 8;
    while (at < n) { if (at % 2) { snprintf(why, cap, "member at odd offset %zu", at); return 0; } if (n - at < 60) { snprintf(why, cap, "truncated header at %zu", at); return 0; }
        const char *h = b + at; if (h[58] != '`' || h[59] != '\n') { snprintf(why, cap, "bad fmag at %zu", at); return 0; }
        size_t sz = 0; for (int i = 48; i < 58 && h[i] != ' '; i++) { if (h[i] < '0' || h[i] > '9') { snprintf(why, cap, "non-decimal size at %zu", at); return 0; } sz = sz * 10 + (size_t)(h[i] - '0'); }
        if (*count >= 8) { snprintf(why, cap, "more than 8 members"); return 0; } int k = 0; while (k < 16 && h[k] != ' ' && h[k] != '/') { names[*count][k] = h[k]; k++; } names[*count][k] = 0;
        if (sz > n - at - 60) { snprintf(why, cap, "member %s size %zu overruns", names[*count], sz); return 0; } sizes[*count] = sz; offs[*count] = at + 60; (*count)++;
        at += 60 + sz; if (sz % 2) { if (at >= n || b[at] != '\n') { snprintf(why, cap, "pad byte after odd member is not \\n"); return 0; } at++; } }
    if (at != n) { snprintf(why, cap, "trailing bytes"); return 0; } return 1; }

int main(int argc, char **argv) {
    if (argc != 4 || !realpath(argv[1], root) || argv[2][0] != '/' || !realpath(argv[3], hostar)) { fputs("usage: ROOT ABS_OUT HOST_AR\n", stderr); return 2; }
    { if (cx_fmt(outdir, sizeof outdir, "%s", argv[2])) { fprintf(stderr, "archive-ar-cases: text too long for outdir\n"); exit(2); } } if (mkdir(outdir, 0700)) die("new out dir must be absent"); path(product, sizeof product, root, "unisacc.com");
    char rp[4400]; path(rp, sizeof rp, outdir, "results.tsv"); res = fopen(rp, "wbx"); if (!res) die("results");
    { size_t n; char *b = load(product, &n); char h[65]; cx_sha256_hex(b, n, h); free(b); fprintf(res, "IDENTITY\tcandidate=%s\thost_ar=%s\n", h, argc == 4 ? hostar : "-"); }
    const char *srcs[3][2] = { { "used.c", "int used(void){return 5;}\n" }, { "unused.c", "int unused(void){return 99;}\n" }, { "main.c", "int used(void);int main(void){return used()+2;}\n" } };
    for (int i = 0; i < 3; i++) { char p[4400]; path(p, sizeof p, outdir, srcs[i][0]); saved(p, srcs[i][1], strlen(srcs[i][1])); char o[64]; { if (cx_fmt(o, sizeof o, "%.*s.o", (int)(strlen(srcs[i][0]) - 2), srcs[i][0])) { fprintf(stderr, "archive-ar-cases: text too long for o\n"); exit(2); } } char *v[] = { "-c", "-b", "lnx/x86_64", "-funit", "-o", o, (char *)srcs[i][0], 0 }; if (prod_rc(outdir, v)) die("unit object"); }
    /* rcs + structure */
    { char *v[] = { "ar", "rcs", "lib.a", "used.o", "unused.o", 0 }; check(prod_rc(outdir, v) == 0, "rcs.rc0", "unisacc ar rcs lib.a used.o unused.o"); }
    char lib[4400]; path(lib, sizeof lib, outdir, "lib.a"); size_t ln; char *lb = load(lib, &ln); char names[8][17] = { { 0 } }; size_t sizes[8], offs[8]; int cnt; char why[200] = "ok";
    int ok = ar_walk(lb, ln, names, sizes, offs, &cnt, why, sizeof why); check(ok, "structure.ar5-parse", why);
    if (ok) { check(cnt == 2 && tx_eq(names[0], "used.o", 1L << 20) && tx_eq(names[1], "unused.o", 1L << 20), "structure.member-names-in-order", cnt == 2 ? names[1] : "count");
        for (int i = 0; i < 2 && i < cnt; i++) { char p[4400]; path(p, sizeof p, outdir, names[i]); size_t on; char *ob = load(p, &on); char d[120]; { if (cx_fmt(d, sizeof d, "%s size %zu archive %zu", names[i], on, sizes[i])) { fprintf(stderr, "archive-ar-cases: text too long for d\n"); exit(2); } } check(on == sizes[i] && !memcmp(ob, lb + offs[i], on), "structure.member-bytes-identical", d); free(ob); } }
    free(lb);
    /* t */
    { char *v[] = { "ar", "t", "lib.a", 0 }; np_result r; if (prod(outdir, v, &r)) check(0, "t.listing", "transport"); else { check(!r.rc && r.outn == 16 && !memcmp(r.out, "used.o\nunused.o\n", 16), "t.listing", "exact `used.o\\nunused.o\\n`"); np_free(&r); } }
    /* x */
    { char xd[4400]; path(xd, sizeof xd, outdir, "x"); if (mkdir(xd, 0700)) die("x dir"); char *v[] = { "ar", "x", "../lib.a", 0 }; check(prod_rc(xd, v) == 0, "x.rc0", "unisacc ar x ../lib.a");
      char a[4400], b[4400]; path(a, sizeof a, xd, "used.o"); path(b, sizeof b, outdir, "used.o"); check(same(a, b), "x.used-identical", "extracted used.o == input"); path(a, sizeof a, xd, "unused.o"); path(b, sizeof b, outdir, "unused.o"); check(same(a, b), "x.unused-identical", "extracted unused.o == input"); }
    /* link only needed */
    { char *v1[] = { "-o", "img-lib", "main.o", "lib.a", 0 }, *v2[] = { "-o", "img-obj", "main.o", "used.o", 0 }, *v3[] = { "ar", "rcs", "rev.a", "unused.o", "used.o", 0 }, *v4[] = { "-o", "img-rev", "main.o", "rev.a", 0 };
      int r1 = prod_rc(outdir, v1), r2 = prod_rc(outdir, v2), r3 = prod_rc(outdir, v3), r4 = prod_rc(outdir, v4); char d[120]; { if (cx_fmt(d, sizeof d, "link rc lib=%d obj=%d rev-ar=%d rev=%d", r1, r2, r3, r4)) { fprintf(stderr, "archive-ar-cases: text too long for d\n"); exit(2); } }
      char a[4400], b[4400], c[4400]; path(a, sizeof a, outdir, "img-lib"); path(b, sizeof b, outdir, "img-obj"); path(c, sizeof c, outdir, "img-rev");
      check(!r1 && !r2 && same(a, b), "link.only-needed.byte-equal", d); check(!r3 && !r4 && same(c, b), "link.only-needed.order-independent", d);
      if (chmod(a, 0700)) die("chmod"); char bound[4400]; path(bound, sizeof bound, root, "tools/bound"); char *e[] = { bound, "5", a, 0 }; np_result r; if (runin(outdir, e, &r)) die("exec"); { if (cx_fmt(d, sizeof d, "rc=%d stdout=%zu", r.rc, r.outn)) { fprintf(stderr, "archive-ar-cases: text too long for d\n"); exit(2); } } check(r.rc == 7 && !r.outn, "link.executes-7", d); np_free(&r); }
    /* A malformed archive must be rejected by the linker's member reader. */
    { char bad[4400], image[4400]; path(bad, sizeof bad, outdir, "truncated.a");
      saved(bad, "!<arch>\nshort", 13); path(image, sizeof image, outdir, "img-truncated");
      char *v[] = { "-o", "img-truncated", "main.o", "truncated.a", 0 }; np_result r;
      if (prod(outdir, v, &r)) check(0, "link.truncated-archive", "transport");
      else { const char *msg = "ar: truncated member header\n"; struct stat st; errno = 0;
        int absent = lstat(image, &st) != 0 && errno == ENOENT;
        check(r.rc == 1 && !r.outn && r.errn == strlen(msg) && !memcmp(r.err, msg, r.errn) && absent,
              "link.truncated-archive", "rc 1, named refusal, no image"); np_free(&r); } }
    /* host ar: the declared oracle (asserted), with its identity recorded */
    { np_result r; char *vv[] = { hostar, "--version", 0 }; char ver[200] = "-"; if (!runin(outdir, vv, &r)) { size_t k = 0; while (k < r.outn && r.out[k] != '\n' && k < 199) { ver[k] = r.out[k]; k++; } ver[k] = 0; np_free(&r); }
      size_t hn; char *hb = cx_read(hostar, &hn); char hh[65] = "-"; if (hb) { cx_sha256_hex(hb, hn, hh); free(hb); } fprintf(res, "ORACLE\thost_ar=%s\toracle_id=%s+%s\n", hostar, ver, hh);
      char *v[] = { hostar, "t", "lib.a", 0 }; if (runin(outdir, v, &r)) check(0, "host-ar.t-on-product-archive", "transport"); else { char d[120]; { if (cx_fmt(d, sizeof d, "host ar t rc=%d", r.rc)) { fprintf(stderr, "archive-ar-cases: text too long for d\n"); exit(2); } } check(!r.rc && r.outn == 16 && !memcmp(r.out, "used.o\nunused.o\n", 16), "host-ar.t-on-product-archive", d); np_free(&r); }
      char hx[4400]; path(hx, sizeof hx, outdir, "hx"); if (mkdir(hx, 0700)) die("hx dir"); char *x[] = { hostar, "x", "../lib.a", 0 }; int xr = runin(hx, x, &r) ? -1 : r.rc; if (xr >= 0) np_free(&r);
      { char a[4400], b[4400], c[4400], e[4400]; path(a, sizeof a, hx, "used.o"); path(b, sizeof b, outdir, "used.o"); path(c, sizeof c, hx, "unused.o"); path(e, sizeof e, outdir, "unused.o"); char d[80]; { if (cx_fmt(d, sizeof d, "host ar x rc=%d", xr)) { fprintf(stderr, "archive-ar-cases: text too long for d\n"); exit(2); } } check(!xr && same(a, b) && same(c, e), "host-ar.x-on-product-archive.identical", d); }
      char *w[] = { hostar, "rcs", "host.a", "used.o", "unused.o", 0 }; int wr = runin(outdir, w, &r) ? -1 : r.rc; if (wr >= 0) np_free(&r); char d[200]; { if (cx_fmt(d, sizeof d, "host ar rcs rc=%d", wr)) { fprintf(stderr, "archive-ar-cases: text too long for d\n"); exit(2); } } check(!wr, "host-ar.rcs.rc0", d);
      char *t[] = { "ar", "t", "host.a", 0 }; np_result q; if (prod(outdir, t, &q)) check(0, "host-ar.product-t-on-host-archive", "transport"); else { { if (cx_fmt(d, sizeof d, "product t rc=%d", q.rc)) { fprintf(stderr, "archive-ar-cases: text too long for d\n"); exit(2); } } check(!q.rc && q.outn == 16 && !memcmp(q.out, "used.o\nunused.o\n", 16), "host-ar.product-t-on-host-archive", d); np_free(&q); }
      char *l[] = { "-o", "img-host", "main.o", "host.a", 0 }; int lr = prod_rc(outdir, l); char a[4400], b[4400]; path(a, sizeof a, outdir, "img-host"); path(b, sizeof b, outdir, "img-obj"); { if (cx_fmt(d, sizeof d, "link rc=%d", lr)) { fprintf(stderr, "archive-ar-cases: text too long for d\n"); exit(2); } } check(!lr && same(a, b), "host-ar.product-links-host-archive.byte-equal", d); }
    fprintf(res, "SUMMARY\tpass=%d\tfail=%d\n", npass, nfail); fclose(res); printf("ARCHIVE_AR_CASES\tpass=%d\tfail=%d\n", npass, nfail); return nfail ? 1 : 0;
}
