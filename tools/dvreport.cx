/* Tool self-check: tools/check-dvreport.cx. Per-job diagnostic from retained timing events.
 * --sample FILE or --instance DIR, --kind CMD --job ID [--window-ms N] [--job-out FILE].
 * Check: dvreport. */
#pragma unisa use sys.fs
#pragma unisa use text.conv

static long number(const char *s) {
    int64_t n;
    return s && *s>='0' && *s<='9' && !tx_to_i64(s,strlen(s),10,&n) && n>=0 ? (long)n : -1;
}
/* Resolve the existing job identity of a known child. A reused PID or an
 * incomplete event cannot attribute an unrelated request to this caller. */
static int resolve(const char *dir,const char *file,const char *kind,long pid,long epoch,char *job) {
    char path[4096],line[1024],prefix[96],suffix[48];
    if(cx_fmt(path,sizeof path,"%s/%s",dir,file) || cx_fmt(prefix,sizeof prefix,"\tphase\tcmd=%s\t",kind) ||
       cx_fmt(suffix,sizeof suffix,"-%ld",pid))return 1;
    FILE *f=fopen(path,"r");
    if(!f)return errno!=ENOENT;
    int bad=0;
    while(fgets(line,sizeof line,f)){
        long seq,t; char *p=strstr(line,"\tjob=");
        if(!p || !strstr(line,prefix) || sscanf(line,"EV\t%ld\t%ld\t",&seq,&t)!=2 || t<epoch)continue;
        p+=5;char *end=strpbrk(p,"\t\n");if(!end)continue;*end=0;
        long n=strlen(p),k=strlen(suffix);
        if(n<=k || strcmp(p+n-k,suffix))continue;
        if((*job && strcmp(job,p)) || cx_fmt(job,96,"%s",p)){bad=1;break;}
    }
    if(ferror(f))bad=1;
    fclose(f);return bad;
}
static void percent(char *s,long part,long total) {
    if (part<0 || total<=0) cx_fmt(s,32,"UNMEASURED");
    else cx_fmt(s,32,"%.0f",(double)part*100.0/(double)total);
}
typedef struct {
    char last_begin[160];
    char active_inner[160];
    char last_ended[160];
    char best_done[160];
    long last_ended_ms;
    long best_done_ms;
    long out_ms;
    int gates_open;
    int saw_phase;
    int saw_timeout;
} PhaseTrace;

static void scan_job_out(const char *path,PhaseTrace *tr) {
    char line[2048];
    if(!path || !*path)return;
    FILE *f=fopen(path,"r");
    if(!f)return;
    while(fgets(line,sizeof line,f)){
        char *end=strchr(line,'\n'); if(end)*end=0;
        if(!strncmp(line,"COMMIT_PHASE\t",13)){
            char *nm=0,*st=0; long ms=-1;
            for(char *p=line+13;p;){
                char *next=strchr(p,'\t'); if(next)*next++=0;
                if(!strncmp(p,"name=",5)) nm=p+5;
                else if(!strncmp(p,"state=",6)) st=p+6;
                else if(!strncmp(p,"ms=",3)) ms=number(p+3);
                p=next;
            }
            if(!nm || !*nm || !st || !*st)continue;
            tr->saw_phase=1;
            if(!strcmp(st,"begin")){
                cx_fmt(tr->last_begin,sizeof tr->last_begin,"%s",nm);
                if(!strcmp(nm,"gates")) tr->gates_open=1;
                else cx_fmt(tr->active_inner,sizeof tr->active_inner,"%s",nm);
            } else if(!strcmp(st,"end")){
                if(!strcmp(nm,"gates")) tr->gates_open=0;
                else {
                    if(!strcmp(tr->active_inner,nm)) tr->active_inner[0]=0;
                    cx_fmt(tr->last_ended,sizeof tr->last_ended,"%s",nm);
                    tr->last_ended_ms=ms;
                    if(ms>=0 && ms>tr->best_done_ms){
                        tr->best_done_ms=ms;
                        cx_fmt(tr->best_done,sizeof tr->best_done,"%s",nm);
                    }
                }
            }
        } else if(!strncmp(line,"X\ttimeout\t",10) || !strncmp(line,"GIT_COMMIT\t",11)){
            if(strstr(line,"\trc=124") || strstr(line,"\treason=timeout")) tr->saw_timeout=1;
            char *mp=strstr(line,"\tms=");
            if(mp){
                char buf[32]; int k=0; mp+=4;
                while(mp[k]>='0' && mp[k]<='9' && k<31){buf[k]=mp[k];k++;}
                buf[k]=0;
                long v=number(buf);
                if(v>tr->out_ms)tr->out_ms=v;
            }
        }
    }
    fclose(f);
}

int main(int argc,char **argv) {
    const char *kind="",*job="",*sample=0,*dir=0,*job_out=0;
    long window=-1,pid=0,epoch=-1;char resolved[96]="";
    for (int i=1;i<argc;i+=2) {
        if (i+1==argc) return 2;
        if (!strcmp(argv[i],"--kind")) kind=argv[i+1];
        else if (!strcmp(argv[i],"--job")) job=argv[i+1];
        else if (!strcmp(argv[i],"--sample")) sample=argv[i+1];
        else if (!strcmp(argv[i],"--instance")) dir=argv[i+1];
        else if (!strcmp(argv[i],"--job-out")) job_out=argv[i+1];
        else if (!strcmp(argv[i],"--window-ms")) window=number(argv[i+1]);
        else if (!strcmp(argv[i],"--pid")) pid=number(argv[i+1]);
        else if (!strcmp(argv[i],"--since-epoch")) epoch=number(argv[i+1]);
        else return 2;
    }
    if ((!dir && !sample && !job_out) || (dir && sample)) return 2;
    if (dir && !*job && pid>0 && epoch>=0 &&
        !resolve(dir,"events.tsv.1",kind,pid,epoch,resolved) &&
        !resolve(dir,"events.tsv",kind,pid,epoch,resolved)) job=resolved;
    int known=!strcmp(kind,"git.commit") || !strcmp(kind,"qualify") || !strcmp(kind,"x") || !strcmp(kind,"flow") || !strcmp(kind,"perf");
    char longest[160]="UNMEASURED"; long maximum=-1,total=-1,total_rc=-1;
    int refused=0,totals=0;
    for(int part=0;known && *job && (dir || sample) && part<(sample?1:2);part++){
      char path[4096],line[2048];
      if(!sample && cx_fmt(path,sizeof path,"%s/%s",dir,part?"events.tsv":"events.tsv.1"))break;
      FILE *f=fopen(sample?sample:path,"r");if(!f)continue;
      while(fgets(line,sizeof line,f)){
        char *end=strchr(line,'\n');if(!end)continue;*end=0;
        char *body;
        if(sample) {
            if(strncmp(line,"JOB\t",4))continue;
            body=line+4;
        } else {
            long seq,t;int offset=0;
            if(sscanf(line,"EV\t%ld\t%ld\tphase\t%n",&seq,&t,&offset)!=2 || !offset)continue;
            body=line+offset;
        }
        char *name=0,*op=0,*id=0; long ms=-1,rc=-1;
        for (char *p=body;p;) {
            char *next=strchr(p,'\t'); if(next)*next++=0;
            if (!strncmp(p,"cmd=",4)) op=p+4;
            else if (!strncmp(p,"phase=",6)) name=p+6;
            else if (!strncmp(p,"job=",4)) id=p+4;
            else if (!strncmp(p,"ms=",3)) ms=number(p+3);
            else if (!strncmp(p,"rc=",3)) rc=number(p+3);
            p=next;
        }
        if (!op || strcmp(op,kind) || !id || strcmp(id,job) || !name || !*name || ms<0) continue;
        if (!strcmp(name,"total")) {total=ms;total_rc=rc;totals++;continue;}
        if (!strcmp(name,"gates") && !strcmp(kind,"git.commit") && (rc==1 || rc==2)) refused=1;
        if (ms>maximum) {maximum=ms;cx_fmt(longest,sizeof longest,"%s",name);}
      }
      fclose(f);
    }
    PhaseTrace tr; memset(&tr,0,sizeof tr); tr.last_ended_ms=-1; tr.best_done_ms=-1; tr.out_ms=-1;
    if(known && *job){
        char auto_out[4096];
        if(job_out && *job_out) scan_job_out(job_out,&tr);
        else if(dir && !cx_fmt(auto_out,sizeof auto_out,"%s/jobs/%s/out",dir,job)) scan_job_out(auto_out,&tr);
        else if(sample && *sample) scan_job_out(sample,&tr);
    }
    char stalled[160]="";
    int timed_out=(total_rc==124 || tr.saw_timeout);
    if(tr.saw_phase && (timed_out || tr.active_inner[0] || tr.gates_open)){
        if(tr.active_inner[0]) cx_fmt(stalled,sizeof stalled,"%s",tr.active_inner);
        else if(tr.gates_open && tr.last_ended[0]) cx_fmt(stalled,sizeof stalled,"after:%s",tr.last_ended);
        else if(tr.gates_open) cx_fmt(stalled,sizeof stalled,"gates");
        else if(timed_out && tr.last_begin[0]) cx_fmt(stalled,sizeof stalled,"%s",tr.last_begin);
    }
    /* Keep measured longest/share_pct/window_pct strictly from timing events;
     * stalled_phase/max_done_phase are inferred separately from COMMIT_PHASE traces. */
    if(!strcmp(kind,"qualify") && !strncmp(longest,"batch:",6))window=60000;
    if(!strcmp(kind,"qualify") && !strcmp(longest,"segment"))window=300000;
    char share[32],pressure[32],advice_buf[220];
    percent(share,maximum,totals==1 && total>=maximum?total:-1);
    percent(pressure,maximum,window);
    const char *rate=totals!=1?"UNMEASURED":total_rc==0?"0":refused?"100":"UNMEASURED";
    const char *base_adv=maximum<0 || window<=0?"UNMEASURED":(double)maximum/window>0.6?"split-phase":"none";
    if(stalled[0] && (!strcmp(base_adv,"split-phase") || timed_out)) cx_fmt(advice_buf,sizeof advice_buf,"split-phase:%s",stalled);
    else cx_fmt(advice_buf,sizeof advice_buf,"%s",base_adv);
    if(stalled[0] && tr.best_done[0] && tr.best_done_ms>=0)
        printf("REPORT\tcmd=%s\tjob=%s\tlongest=%s\tshare_pct=%s\trefused_pct=%s\twindow_pct=%s\tadvice=%s\tstalled_phase=%s\tmax_done_phase=%s:%ldms\n",
               kind,job,longest,share,rate,pressure,advice_buf,stalled,tr.best_done,tr.best_done_ms);
    else if(stalled[0])
        printf("REPORT\tcmd=%s\tjob=%s\tlongest=%s\tshare_pct=%s\trefused_pct=%s\twindow_pct=%s\tadvice=%s\tstalled_phase=%s\n",
               kind,job,longest,share,rate,pressure,advice_buf,stalled);
    else
        printf("REPORT\tcmd=%s\tjob=%s\tlongest=%s\tshare_pct=%s\trefused_pct=%s\twindow_pct=%s\tadvice=%s\n",
               kind,job,longest,share,rate,pressure,advice_buf);
    return 0;
}
