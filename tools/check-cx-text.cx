/* Checks cx/text/text.cx: sh ./unisacc.com tools/check-cx-text.cx; prints PASS/FAIL per case, exit 1 on any FAIL. */
#pragma unisa use text.text
static int bad;
static void ok(int c, const char *name) { printf("%s\t%s\n", c ? "PASS" : "FAIL", name); if (!c) bad = 1; }
int main(void) {
    char buf[8], unterminated[3] = {'a', 'b', 'c'};
    ok(tx_len("abc", 8) == 3, "len");
    ok(tx_len(unterminated, 3) == -1, "len-unterminated");
    ok(tx_len(0, 8) == -1 && tx_len("a", -1) == -1, "len-bad-args");
    ok(tx_same("ab", 2, "ab", 2) && !tx_same("ab", 2, "ac", 2) && !tx_same("ab", 2, "abc", 3), "same");
    ok(tx_eq("x", "x", 4) && !tx_eq("x", "y", 4) && !tx_eq(unterminated, "abc", 3), "eq");
    ok(tx_prefix("abcdef", 6, "abc", 3) && !tx_prefix("ab", 2, "abc", 3), "prefix");
    ok(tx_suffix("abcdef", 6, "def", 3) && !tx_suffix("abcdef", 6, "abc", 3) && !tx_suffix("ab", 2, "abc", 3), "suffix");
    ok(tx_contains("hello world", 11, "o w", 3) && !tx_contains("abc", 3, "z", 1), "contains");
    ok(tx_count("aaa", 3, "a", 1) == 3, "count-overlapping-single-byte");
    ok(tx_count("ababab", 6, "ab", 2) == 3, "count-non-overlapping-pairs");
    ok(tx_count("hello", 5, "z", 1) == 0, "count-absent-zero");
    ok(tx_count("aaa", 3, "", 0) == -1, "count-empty-needle-refused");
    ok(tx_count("a", 1, "aa", 2) == -1 && tx_count(0, 3, "a", 1) == -1, "count-bad-args");
    ok(tx_contains("abc", 3, "", 0) && tx_contains("", 0, "", 0) && !tx_contains("ab", 2, "abc", 3), "contains-edge");
    ok(!tx_contains(0, 3, "x", 1) && !tx_contains("abc", 3, 0, 1) && !tx_contains("abc", -1, "a", 1), "contains-bad-args");
    ok(tx_suffix("abc", 3, "", 0) && !tx_suffix(0, 3, "x", 1) && !tx_suffix("abc", 3, 0, 1) && !tx_suffix("abc", -1, "c", 1), "suffix-edge");
    ok(tx_chr("a=b", 3, '=') == 1 && tx_chr("ab", 2, '=') == -1, "chr");
    ok(tx_find("hello world", 11, "o w", 3) == 4 && tx_find("abc", 3, "", 0) == 0 && tx_find("ab", 2, "abc", 3) == -1, "find");
    ok(tx_rchr("a/b/c", 5, '/') == 3 && tx_rchr("abc", 3, '/') == -1 && tx_rchr("x", -1, 'x') == -1, "rchr");
    ok(tx_cmp("abc", 3, "abd", 3) < 0 && tx_cmp("b", 1, "a", 1) > 0 && tx_cmp("ab", 2, "abc", 3) < 0
       && tx_cmp("abc", 3, "ab", 2) > 0 && tx_cmp("same", 4, "same", 4) == 0 && tx_cmp("\xff", 1, "\x01", 1) > 0, "cmp");
    ok(tx_copy(buf, 8, "hello", 5) == 0 && tx_eq(buf, "hello", 8), "copy");
    buf[0] = 'Z';
    ok(tx_copy(buf, 5, "hello", 5) == 1 && buf[0] == 'Z', "copy-too-long-untouched");
    ok(tx_eqz("abc", "abc") && !tx_eqz("abc", "abd") && !tx_eqz("abc", "ab") && !tx_eqz(0, "x") && !tx_eqz("x", 0), "eqz");
    ok(tx_eqz(unterminated, "abc") == 0, "eqz-unterminated");
    ok(tx_prefixz("abcdef", "abc", 3) && !tx_prefixz("ab", "abc", 3) && !tx_prefixz("abc", "abd", 3), "prefixz");
    ok(tx_prefixz("abc", "abc", 0) && tx_prefixz("abc", "abc", -1) == 0, "prefixz-edge");
    ok(tx_fields("a,b,c", 5, ',') == 3 && tx_fields(",,", 2, ',') == 3 && tx_fields("abc", 3, ',') == 1, "fields-count");
    {
        long off, len;
        ok(tx_trim("  hi  ", 6, &off, &len) == 0 && off == 2 && len == 2, "trim");
        ok(tx_trim("\t\n x \r\n", 7, &off, &len) == 0 && off == 3 && len == 1, "trim-ws-mix");
        ok(tx_trim("   ", 3, &off, &len) == 0 && len == 0, "trim-all-ws-empty");
        ok(tx_trim("abc", 3, &off, &len) == 0 && off == 0 && len == 3, "trim-none");
        ok(tx_trimc(",,a,,", 5, ',', &off, &len) == 0 && off == 2 && len == 1, "trimc");
        ok(tx_trimc("", 0, ',', &off, &len) == 0 && off == 0 && len == 0, "trimc-empty");
        ok(tx_trim("x", -1, &off, &len) == -1 && tx_trim(0, 3, &off, &len) == -1, "trim-bad-args");
    }
    ok(tx_fields("", 0, ',') == 0 && tx_fields(0, 3, ',') == -1 && tx_fields("a", -1, ',') == -1, "fields-edge");
    {
        long off, len;
        ok(tx_field("a,b,c", 5, ',', 1, &off, &len) == 0 && off == 2 && len == 1, "field-second");
        ok(tx_field(",,x", 3, ',', 0, &off, &len) == 0 && len == 0, "field-empty-first");
        ok(tx_field("a,b,c", 5, ',', 3, &off, &len) == -1, "field-out-of-range");
        ok(tx_field("a,b", 3, ',', -1, &off, &len) == -1, "field-neg-idx");
    }
    printf("%s\tcheck-cx-text\n", bad ? "FAIL" : "PASS");
    printf("CX_TEXT\tfailed=%d\n", bad);
    return bad;
}
