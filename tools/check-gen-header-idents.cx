/* tools/check-gen-header-idents.cx -- tools/gen-header-idents.cx 的检查:仓内 build/header-idents.tsv 与源头一致、关键行在表、
 * 夹具(条件分支 define、枚举常量、数字记号、注释字符串、子目录头)逐字节期望、两次生成逐字节相同、
 * 私有副本改头后 --check rc 1、三个变异(漏 #define 分支、漏枚举常量、非确定顺序)必须被 --check 检出。
 *
 *   sh ./unisacc.com tools/check-gen-header-idents.cx */
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.time
#pragma unisa use sys.posix
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use cxlib.muthelp

static int failed;
static char dir[320];
static void ck(int ok, const char *name) {
    if (ok) sy_printf("PASS\tcheck-gen-header-idents.%s\n", name);
    else { failed++; sy_printf("FAIL\tcheck-gen-header-idents.%s\n", name); }
}
static int run(const char *root, const char *args, char *out, long cap) {
    char cmd[900]; char *o = 0; size_t n = 0; int rc;
    if (root) cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com tools/gen-header-idents.cx -- %s --root %s", args, root);
    else cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com tools/gen-header-idents.cx -- %s", args);
    char *v[] = {"sh", "-c", cmd, 0};
    rc = cx_runv_timeout(v, 50, &o, &n);
    out[0] = 0; if (o && (long)n < cap) { mm_copy(out, cap, o, n); out[n] = 0; }
    return rc;
}
static char *rd(const char *p, long *n) {
    size_t m = 0; char *t = cx_read(p, &m); *n = (long)m; return t;
}
static int same(const char *a, long an, const char *b, long bn) { return a && b && an == bn && mm_same(a, b, an); }

int main(void) {
    char out[2000], p[500], q[500];
    long n = 0, n2 = 0;
    char *t, *t2;
    int rc;
    long t0 = sy_now_ms();
    /* (1) 仓内表与源头一致 */
    rc = run(0, "--check", out, sizeof out);
    ck(rc == 0, "repo-check-rc0");
    t = rd("build/header-idents.tsv", &n);
    ck(t && n > 1000, "repo-table-nonempty");
    ck(t && mh_rowcount(t, n, "stdio.h\tprintf\tident") == 1, "repo-printf-ident");
    ck(t && mh_rowcount(t, n, "stdio.h\tfopen\tident") == 1, "repo-fopen-ident");
    ck(t && mh_rowcount(t, n, "stdio.h\tstdout\tmacro") == 1 && mh_rowcount(t, n, "stdio.h\tEOF\tmacro") == 1 && mh_rowcount(t, n, "stdio.h\tNULL\tmacro") == 1, "repo-stdio-macros");
    ck(t && mh_rowcount(t, n, "# header\tname\tkind") == 1, "repo-header-line");
    /* (2) 夹具 */
    if (cx_fmt(dir, sizeof dir, "%s/hdr-idents-XXXXXX", sy_tmpdir()) || !mkdtemp(dir)) { ck(0, "tmpdir"); return 1; }
    mh_mkdir(dir, "include"); mh_mkdir(dir, "include/sub"); mh_mkdir(dir, "build");
    mh_put(dir, "include/a.h",
        "/* comment ignored_c */\n"
        "#ifndef A_H\n#define A_H\n#include <zzinc.h>\n"
        "#ifdef FOO\n#define COND_ONE 1\n#else\n#define COND_TWO 0x1F\n#endif\n"
        "enum { ENUM_B = 2, ENUM_A = 1 };\n"
        "extern int *fn_x(int pa, const char *s = \"str_lit\");\n"
        "#define FN_MAC(x) ((x) + 1e5)\n"
        "static long var_z;\n"
        "#endif\n");
    mh_put(dir, "include/sub/b.h", "typedef unsigned long my_t;\n#define B_ONLY 1\n");
    mh_put(dir, "include/z.txt", "not_a_header\n");
    rc = run(dir, "--write", out, sizeof out);
    ck(rc == 0, "fixture-write");
    cx_fmt(p, sizeof p, "%s/build/header-idents.tsv", dir);
    t = rd(p, &n);
    ck(t && mh_rowcount(t, n, "a.h\tENUM_A\tident") == 1 && mh_rowcount(t, n, "a.h\tENUM_B\tident") == 1, "fixture-enum-consts");
    ck(t && mh_rowcount(t, n, "a.h\tCOND_ONE\tmacro") == 1 && mh_rowcount(t, n, "a.h\tCOND_TWO\tmacro") == 1 && mh_rowcount(t, n, "a.h\tA_H\tmacro") == 1, "fixture-cond-defines");
    ck(t && mh_rowcount(t, n, "a.h\tFN_MAC\tmacro") == 1 && mh_rowcount(t, n, "a.h\tFN_MAC\tident") == 1, "fixture-funcmacro-both-kinds");
    ck(t && mh_rowcount(t, n, "a.h\tfn_x\tident") == 1 && mh_rowcount(t, n, "a.h\tvar_z\tident") == 1 && mh_rowcount(t, n, "sub/b.h\tmy_t\tident") == 1, "fixture-func-var-type-subdir");
    ck(t && mh_rowcount(t, n, "a.h\tignored_c\tident") == 0 && mh_rowcount(t, n, "a.h\tstr_lit\tident") == 0 && mh_rowcount(t, n, "a.h\tzzinc\tident") == 0, "fixture-comment-string-include-skipped");
    ck(t && mh_rowcount(t, n, "a.h\tx1F\tident") == 0 && mh_rowcount(t, n, "a.h\te5\tident") == 0 && mh_rowcount(t, n, "a.h\tdefine\tident") == 0 && mh_rowcount(t, n, "a.h\tifdef\tident") == 0, "fixture-numbers-directives-skipped");
    ck(t && mh_rowcount(t, n, "a.h\tint\tident") == 1 && mh_rowcount(t, n, "a.h\tpa\tident") == 1, "fixture-dedup-keywords-params");
    ck(t && mh_rowcount(t, n, "z.txt\tnot_a_header\tident") == 0, "fixture-non-h-skipped");
    /* (3) 确定性:再生成一次逐字节相同 */
    cx_fmt(q, sizeof q, "%s/build/second.tsv", dir);
    rc = run(dir, "--write", out, sizeof out);
    t2 = rd(p, &n2);
    ck(rc == 0 && same(t, n, t2, n2), "deterministic-rerun");
    /* 排序:每头内 ident 在前 macro 在后,名字升序 */
    {
        long a = 0, b = 0;
        const char *s1 = "a.h\tA_H\tident", *s2 = "a.h\tENUM_A\tident";
        long i = 0, pos1 = -1, pos2 = -1;
        while (t && i < n) {
            long e = i; while (e < n && t[e] != '\n') e++;
            if (e - i == tx_len(s1, 100) && mm_same(t + i, s1, e - i)) pos1 = i;
            if (e - i == tx_len(s2, 100) && mm_same(t + i, s2, e - i)) pos2 = i;
            i = e + 1;
        }
        (void)a; (void)b;
        ck(pos1 >= 0 && pos2 > pos1, "sorted-bytes");
    }
    rc = run(dir, "--check", out, sizeof out);
    ck(rc == 0, "fixture-check-rc0");
    /* (4) 变异:各自 --check 必须 rc 1 */
    rc = run(dir, "--check --mut 1", out, sizeof out);
    ck(rc == 1, "mutant-miss-cond-define-detected");
    rc = run(dir, "--check --mut 2", out, sizeof out);
    ck(rc == 1, "mutant-miss-enum-const-detected");
    rc = run(dir, "--check --mut 3", out, sizeof out);
    ck(rc == 1, "mutant-unordered-detected");
    /* (5) 私有副本改一个头后 --check rc 1(表未重算) */
    mh_put(dir, "include/sub/b.h", "typedef unsigned long my_t;\n#define B_ONLY 1\nint added_later;\n");
    rc = run(dir, "--check", out, sizeof out);
    ck(rc == 1, "header-edit-detected");
    /* 缺表 */
    cx_fmt(q, sizeof q, "%s/build/header-idents.tsv", dir);
    unlink(q);
    rc = run(dir, "--check", out, sizeof out);
    ck(rc == 1, "missing-table-detected");
    rc = run(dir, "--bogus", out, sizeof out);
    ck(rc == 2, "bad-arg-rc2");
    sy_printf("ELAPSED_MS\t%ld\n", sy_now_ms() - t0);
    if (failed) { sy_printf("FAILED\t%d\n", failed); return 1; }
    sy_printf("HEADER_IDENTS\n");
    return 0;
}
