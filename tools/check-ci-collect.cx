/* tools/check-ci-collect.cx -- fixtures for tools/ci-collect.cx (fake gh executable, no network).
 *
 *   sh ./unisacc.com tools/check-ci-collect.cx
 *
 * All six success -> CI_ALL=success rc 0; one failure -> CI_ALL=failure rc 1 and the job listed; one in progress, one
 * missing, empty job list and gh failure -> never success (rc 3); non-native jobs are ignored; TSV columns checked.
 * Prints PASS|FAIL lines and CHECK_CI_COLLECT<TAB>failed=N. */
static int failed;
static void ck(int ok, const char *n) { printf("%s\tcheck-ci-collect.%s\n", ok ? "PASS" : "FAIL", n); if (!ok) failed++; }
static void put(const char *d, const char *name, const char *body) {
    char p[512]; FILE *f;
    cx_fmt(p, sizeof p, "%s/%s", d, name);
    f = fopen(p, "w");
    if (!f) { printf("FAIL\tcheck-ci-collect.write\n"); exit(1); }
    fputs(body, f); fclose(f);
}
static void app(char *d, const char *s) { size_t n = strlen(d); cx_fmt(d + n, 4096 - n, "%s", s); }
static int run(const char *cmd, char *out, size_t cap) {
    FILE *p = popen(cmd, "r"); size_t n = 0; int rc;
    if (!p) return -1;
    while (n + 1 < cap) { size_t k = fread(out + n, 1, cap - 1 - n, p); if (!k) break; n += k; }
    out[n] = 0; rc = pclose(p);
    return WEXITSTATUS(rc);
}
static int col(const char *d, char *out, size_t cap) {
    char c[1024];
    cx_fmt(c, sizeof c, "timeout 50 sh ./unisacc.com tools/ci-collect.cx -- --run 4242 --gh %s/gh 2>&1", d);
    return run(c, out, cap);
}
static const char *J(int i, const char *st, const char *co) {
    static char b[6][300];
    static const char *RN[6] = {"ubuntu-24.04, lnx, x86_64", "ubuntu-24.04-arm, lnx, arm64", "macos-15-intel, osx, x86_64", "macos-15, osx, arm64", "windows-2025, win, x86_64", "windows-11-arm, win, arm64"};
    cx_fmt(b[i], sizeof b[i], "candidate (%s, yes)\t%s\t%s\t2026-11-14T01:00:0%dZ\t2026-11-14T01:10:00Z\thttps://x/job/%d\n", RN[i], st, co, i, i);
    return b[i];
}
int main(void) {
    char d[] = "/tmp/cicol-XXXXXX", out[8192], c[256], body[4096];
    int rc, i;
    if (!mkdtemp(d)) { printf("FAIL\tcheck-ci-collect.mkdtemp\n"); return 1; }
    put(d, "gh", "#!/bin/sh\nD=$(dirname \"$0\")\n[ -f \"$D/ghfail\" ] && exit 1\ncat \"$D/jobs.tsv\"\n");
    cx_fmt(c, sizeof c, "chmod +x %s/gh", d); (void)system(c);
    body[0] = 0;
    app(body, "fetch\tcompleted\tsuccess\t\t\thttps://x/f\n");
    for (i = 0; i < 6; i++) app(body, J(i, "completed", "success"));
    put(d, "jobs.tsv", body);
    rc = col(d, out, sizeof out);
    ck(rc == 0, "all.rc0");
    ck(strstr(out, "CI_ALL=success") != 0, "all.marker");
    ck(strstr(out, "job\ttarget\tconclusion\tstarted\tcompleted\turl") != 0, "all.header");
    ck(strstr(out, "candidate (macos-15, osx, arm64, yes)\tosx/arm64\tsuccess\t2026-11-14T01:00:03Z\t2026-11-14T01:10:00Z\thttps://x/job/3") != 0, "all.columns");
    ck(strstr(out, "fetch\t") == 0, "all.non_native_ignored");
    body[0] = 0;
    for (i = 0; i < 6; i++) app(body, J(i, "completed", i == 4 ? "failure" : "success"));
    put(d, "jobs.tsv", body);
    rc = col(d, out, sizeof out);
    ck(rc == 1 && strstr(out, "CI_ALL=failure") != 0 && strstr(out, "CI_ALL=success") == 0, "fail.verdict");
    ck(strstr(out, "CI_NOT_SUCCESS\tcandidate (windows-2025, win, x86_64, yes)\tnot-success") != 0, "fail.listed");
    body[0] = 0;
    for (i = 0; i < 6; i++) app(body, i == 1 ? J(i, "in_progress", "") : J(i, "completed", "success"));
    put(d, "jobs.tsv", body);
    rc = col(d, out, sizeof out);
    ck(rc == 3 && strstr(out, "CI_ALL=success") == 0 && strstr(out, "CI_ALL=pending") != 0, "inprogress.pending");
    ck(strstr(out, "lnx/arm64\tPENDING") != 0, "inprogress.conclusion_pending");
    body[0] = 0;
    for (i = 0; i < 5; i++) app(body, J(i, "completed", "success"));
    put(d, "jobs.tsv", body);
    rc = col(d, out, sizeof out);
    ck(rc == 3 && strstr(out, "PENDING\twin/arm64\tmissing") != 0 && strstr(out, "CI_ALL=success") == 0, "missing.pending");
    put(d, "jobs.tsv", "");
    rc = col(d, out, sizeof out);
    ck(rc == 3 && strstr(out, "CI_ALL=success") == 0, "empty.not_success");
    put(d, "ghfail", "");
    rc = col(d, out, sizeof out);
    ck(rc == 3 && strstr(out, "gh-run-view-failed") != 0 && strstr(out, "CI_ALL=success") == 0, "gh_failure");
    cx_fmt(c, sizeof c, "sh ./unisacc.com tools/ci-collect.cx -- --run abc >/dev/null 2>&1");
    rc = WEXITSTATUS(system(c));
    ck(rc == 2, "usage.bad_run");
    cx_fmt(c, sizeof c, "rm -rf %s", d); (void)system(c);
    printf("CHECK_CI_COLLECT\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
