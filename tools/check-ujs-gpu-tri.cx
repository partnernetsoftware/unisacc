/* tools/check-ujs-gpu-tri.cx -- dump-dom AUTO; 只认 <title> 文本.
 *
 * sh ./unisacc.com tools/check-ujs-gpu-tri.cx --
 *
 * 无 /usr/bin/google-chrome: 末行 UJS_GPU_TRI_UNMEASURED 退出 2,不是 PASS。
 * 批次只在有 chrome 的机器上记 PASS。
 */
static int hx(int c) {
    if (c >= '0' && c <= '9') return c - '0';
    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
    return -1;
}
static int title_is(const char *s, size_t n, const char *want) {
    size_t i, j, a, b, wl = 0;
    if (!s || !want) return 0;
    while (want[wl]) wl++;
    for (i = 0; i + 7 < n; i++) {
        if (s[i] == '<' && s[i + 1] == 't' && s[i + 2] == 'i' && s[i + 3] == 't' &&
            s[i + 4] == 'l' && s[i + 5] == 'e' && s[i + 6] == '>') {
            a = i + 7;
            for (b = a; b + 8 < n; b++) {
                if (s[b] == '<' && s[b + 1] == '/' && s[b + 2] == 't' && s[b + 3] == 'i' &&
                    s[b + 4] == 't' && s[b + 5] == 'l' && s[b + 6] == 'e' && s[b + 7] == '>') {
                    if (b - a != wl) return 0;
                    for (j = 0; j < wl; j++) if (s[a + j] != want[j]) return 0;
                    return 1;
                }
            }
            return 0;
        }
    }
    return 0;
}
static int dump_dom(const char *url, char **out, size_t *on) {
    char *av[12];
    const char *chrome = "/usr/bin/google-chrome";
    av[0] = (char *)chrome;
    av[1] = "--headless=new";
    av[2] = "--enable-unsafe-swiftshader";
    av[3] = "--allow-file-access-from-files";
    av[4] = "--disable-web-security";
    av[5] = "--virtual-time-budget=20000";
    av[6] = "--timeout=20000";
    av[7] = "--dump-dom";
    av[8] = (char *)url;
    av[9] = 0;
    *out = 0;
    *on = 0;
    return cx_runv_timeout(av, 25, out, on);
}
static void make_url(char *url, int cap, const char *cwd, const char *suf) {
    const char *pre = "file://";
    int n = 0, i;
    while (pre[n]) { url[n] = pre[n]; n++; }
    for (i = 0; cwd[i] && n < cap - 2; i++) url[n++] = cwd[i];
    for (i = 0; suf[i] && n < cap - 1; i++) url[n++] = suf[i];
    url[n] = 0;
}
int main(int argc, char **argv) {
    FILE *f;
    char line[1024];
    unsigned char b[4096];
    int nb = 0, hi, lo;
    unsigned ofnv = 0;
    char *p;
    char *av[4];
    char *out = 0;
    size_t on = 0;
    int rc;
    char cwd[512];
    char url[640];
    const char *chrome = "/usr/bin/google-chrome";
    (void)argc; (void)argv;
    f = fopen("ujs/tests/uxep-tri-oracle.tsv", "rb");
    if (!f) { fprintf(stderr, "no tsv\n"); return 2; }
    while (fgets(line, (int)sizeof line, f)) {
        if (line[0] == '#' || line[0] == 'k') continue;
        p = line;
        while (*p && *p != '\t') p++;
        if (*p == '\t') p++;
        while (*p >= '0' && *p <= '9') p++;
        if (*p == '\t') p++;
        while (*p >= '0' && *p <= '9') p++;
        if (*p == '\t') p++;
        while (*p >= '0' && *p <= '9') { ofnv = ofnv * 10u + (unsigned)(*p - '0'); p++; }
        break;
    }
    fclose(f);
    if (!ofnv) { fprintf(stderr, "no fnv in tsv\n"); return 2; }
    f = fopen("ujs/tests/uxep-tri-oracle.hex", "rb");
    if (!f) { fprintf(stderr, "no hex\n"); return 2; }
    while (fgets(line, (int)sizeof line, f)) {
        p = line;
        if (line[0] == '#') continue;
        while (*p && *p != '\n' && *p != '\r') {
            while (*p == ' ' || *p == '\t') p++;
            if (!*p || *p == '\n' || *p == '\r') break;
            hi = hx(*p++);
            lo = hx(*p++);
            if (hi < 0 || lo < 0 || nb >= 4096) { fclose(f); return 2; }
            b[nb++] = (unsigned char)((hi << 4) | lo);
        }
    }
    fclose(f);
    if (nb < 168) { fprintf(stderr, "hex short\n"); return 2; }
    printf("oracle_fnv\t%u\thex_bytes\t%d\n", ofnv, nb);
    f = fopen(chrome, "rb");
    if (!f) {
        printf("UJS_GPU_TRI_UNMEASURED\tno-chrome\n");
        return 2;
    }
    fclose(f);
    av[0] = (char *)chrome;
    av[1] = "--version";
    av[2] = 0;
    rc = cx_runv_timeout(av, 10, &out, &on);
    if (out && on) fwrite(out, 1, on, stdout);
    if (out) { free(out); out = 0; on = 0; }
    if (rc != 0) {
        printf("UJS_GPU_TRI_UNMEASURED\tchrome-version\n");
        return 2;
    }
    if (!getcwd(cwd, sizeof cwd)) return 2;
    make_url(url, (int)sizeof url, cwd, "/ujs/practice/uxe/demo/gpu-tri/index.html?auto=1");
    rc = dump_dom(url, &out, &on);
    if (!out || !title_is(out, on, "GPU_TRI_OK")) {
        printf("FAIL\tgood-title rc=%d\n", rc);
        if (out) free(out);
        return 1;
    }
    printf("PASS\tgood-title\n");
    free(out); out = 0; on = 0;
    make_url(url, (int)sizeof url, cwd, "/ujs/practice/uxe/demo/gpu-tri/index.html?auto=1&oracle_fnv=1");
    rc = dump_dom(url, &out, &on);
    if (!out || !title_is(out, on, "GPU_TRI_FAIL") || title_is(out, on, "GPU_TRI_OK")) {
        printf("FAIL\tcounter-title rc=%d\n", rc);
        if (out) free(out);
        return 1;
    }
    printf("PASS\tcounter-title GPU_TRI_FAIL\n");
    if (out) free(out);
    printf("UJS_GPU_TRI_OK\n");
    return 0;
}
