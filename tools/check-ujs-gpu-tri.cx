/* tools/check-ujs-gpu-tri.cx -- dump-dom AUTO; chrome 缺失则 UNMEASURED.
 *
 * sh ./unisacc.com tools/check-ujs-gpu-tri.cx --
 */
static int hx(int c) {
    if (c >= '0' && c <= '9') return c - '0';
    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
    return -1;
}
static int has_str(const char *s, size_t n, const char *need) {
    size_t i, j, m = 0;
    while (need[m]) m++;
    if (!s || n < m) return 0;
    for (i = 0; i + m <= n; i++) {
        for (j = 0; j < m; j++) if (s[i + j] != need[j]) break;
        if (j == m) return 1;
    }
    return 0;
}
int main(int argc, char **argv) {
    FILE *f;
    char line[1024];
    unsigned char b[4096];
    int nb = 0, hi, lo;
    unsigned ofnv = 0;
    char *p;
    char *av[16];
    char *out = 0;
    size_t on = 0;
    int rc;
    const char *chrome = "/usr/bin/google-chrome";
    (void)argc; (void)argv;
    f = fopen("ujs/tests/uxep-tri-oracle.tsv", "rb");
    if (!f) { fprintf(stderr, "no tsv\n"); return 2; }
    while (fgets(line, (int)sizeof line, f)) {
        if (line[0] == '#' || line[0] == 'k') continue;
        p = line;
        while (*p && *p != '\t') p++;
        if (*p == '\t') p++;
        while (*p >= '0' && *p <= '9') p++;
        if (*p == '\t') p++;
        while (*p >= '0' && *p <= '9') p++;
        if (*p == '\t') p++;
        while (*p >= '0' && *p <= '9') { ofnv = ofnv * 10u + (unsigned)(*p - '0'); p++; }
        break;
    }
    fclose(f);
    if (!ofnv) { fprintf(stderr, "no fnv in tsv\n"); return 2; }
    f = fopen("ujs/tests/uxep-tri-oracle.hex", "rb");
    if (!f) { fprintf(stderr, "no hex\n"); return 2; }
    while (fgets(line, (int)sizeof line, f)) {
        p = line;
        if (line[0] == '#') continue;
        while (*p && *p != '\n' && *p != '\r') {
            while (*p == ' ' || *p == '\t') p++;
            if (!*p || *p == '\n' || *p == '\r') break;
            hi = hx(*p++);
            lo = hx(*p++);
            if (hi < 0 || lo < 0 || nb >= 4096) { fclose(f); return 2; }
            b[nb++] = (unsigned char)((hi << 4) | lo);
        }
    }
    fclose(f);
    if (nb < 168) { fprintf(stderr, "hex short\n"); return 2; }
    printf("oracle_fnv\t%u\thex_bytes\t%d\n", ofnv, nb);
    f = fopen(chrome, "rb");
    if (!f) {
        printf("UJS_GPU_TRI_UNMEASURED\tno-chrome\n");
        return 2;
    }
    fclose(f);
    av[0] = (char *)chrome;
    av[1] = "--version";
    av[2] = 0;
    rc = cx_runv_timeout(av, 10, &out, &on);
    if (out && on) fwrite(out, 1, on, stdout);
    if (out) { free(out); out = 0; on = 0; }
    if (rc != 0) {
        printf("UJS_GPU_TRI_UNMEASURED\tchrome-version\n");
        return 2;
    }
    av[0] = (char *)chrome;
    {
        char cwd[512];
        char url[640];
        int n = 0, i;
        const char *pre = "file://";
        const char *suf = "/ujs/practice/uxe/demo/gpu-tri/index.html?auto=1";
        if (!getcwd(cwd, sizeof cwd)) return 2;
        while (pre[n]) { url[n] = pre[n]; n++; }
        for (i = 0; cwd[i] && n < 620; i++) url[n++] = cwd[i];
        for (i = 0; suf[i] && n < 638; i++) url[n++] = suf[i];
        url[n] = 0;
        av[0] = (char *)chrome;
        av[1] = "--headless=new";
        av[2] = "--enable-unsafe-swiftshader";
        av[3] = "--allow-file-access-from-files";
        av[4] = "--disable-web-security";
        av[5] = "--virtual-time-budget=20000";
        av[6] = "--timeout=20000";
        av[7] = "--dump-dom";
        av[8] = url;
        av[9] = 0;
        rc = cx_runv_timeout(av, 25, &out, &on);
    }
    if (out && on) {
        if (has_str(out, on, "GPU_TRI_OK")) {
            fwrite(out, 1, on > 400 ? 400 : on, stdout);
            if (out) free(out);
            printf("\nUJS_GPU_TRI_OK\n");
            return 0;
        }
        if (has_str(out, on, "GPU_TRI_UNMEASURED") || has_str(out, on, "<title>gpu-tri</title>")) {
            printf("UJS_GPU_TRI_UNMEASURED\tdump-dom-too-early rc=%d\n", rc);
            if (out) free(out);
            return 2;
        }
    }
    if (out) free(out);
    printf("UJS_GPU_TRI_UNMEASURED\tdump-dom rc=%d\n", rc);
    return 2;
}
