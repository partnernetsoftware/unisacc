/* tools/check-ujs-gpu-tri.cx -- dump-dom AUTO; 只认 <title> 文本.
 *
 * sh ./unisacc.com tools/check-ujs-gpu-tri.cx --
 *
 * 无 /usr/bin/google-chrome: 末行 UJS_GPU_TRI_UNMEASURED 退出 2,不是 PASS。
 * 批次只在有 chrome 的机器上记 PASS。
 * 每次 chrome 独立 --user-data-dir; 终 title 不重试; 仅 gpu-tri/UNMEASURED/缺 title 有界重试最多 3。
 * chrome 偶发未到终 title 根因未定位; retries 字段保留。
 */
static int g_seq;
static int hx(int c) {
    if (c >= '0' && c <= '9') return c - '0';
    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
    return -1;
}
static int title_span(const char *s, size_t n, size_t *a, size_t *b) {
    size_t i;
    if (!s) return 0;
    for (i = 0; i + 7 < n; i++) {
        if (s[i] == '<' && s[i + 1] == 't' && s[i + 2] == 'i' && s[i + 3] == 't' &&
            s[i + 4] == 'l' && s[i + 5] == 'e' && s[i + 6] == '>') {
            *a = i + 7;
            for (*b = *a; *b + 8 < n; (*b)++) {
                if (s[*b] == '<' && s[*b + 1] == '/' && s[*b + 2] == 't' && s[*b + 3] == 'i' &&
                    s[*b + 4] == 't' && s[*b + 5] == 'l' && s[*b + 6] == 'e' && s[*b + 7] == '>')
                    return 1;
            }
            return 0;
        }
    }
    return 0;
}
static int title_is(const char *s, size_t n, const char *want) {
    size_t a, b, j, wl = 0;
    if (!s || !want) return 0;
    while (want[wl]) wl++;
    if (!title_span(s, n, &a, &b)) return 0;
    if (b - a != wl) return 0;
    for (j = 0; j < wl; j++) if (s[a + j] != want[j]) return 0;
    return 1;
}
static int title_pending(const char *s, size_t n) {
    if (!s || !n) return 1;
    if (title_is(s, n, "gpu-tri")) return 1;
    if (title_is(s, n, "GPU_TRI_UNMEASURED")) return 1;
    if (!title_is(s, n, "GPU_TRI_OK") && !title_is(s, n, "GPU_TRI_FAIL") &&
        !title_is(s, n, "GPU_TRI_PKT")) return 1;
    return 0;
}
static void wipe_dir(const char *dir) {
    char *av[4];
    char *o = 0;
    size_t n = 0;
    av[0] = "rm";
    av[1] = "-rf";
    av[2] = (char *)dir;
    av[3] = 0;
    cx_runv_timeout(av, 8, &o, &n);
    if (o) free(o);
}
static void kill_profile(const char *dir) {
    char *av[5];
    char *o = 0;
    size_t n = 0;
    av[0] = "pkill";
    av[1] = "-f";
    av[2] = (char *)dir;
    av[3] = 0;
    cx_runv_timeout(av, 5, &o, &n);
    if (o) free(o);
}
static int leftover_profile(const char *dir) {
    char *av[5];
    char *o = 0;
    size_t n = 0;
    int rc;
    av[0] = "pgrep";
    av[1] = "-f";
    av[2] = (char *)dir;
    av[3] = 0;
    rc = cx_runv_timeout(av, 5, &o, &n);
    if (o) free(o);
    return rc == 0;
}
static int dump_dom(const char *url, char **out, size_t *on, char *dir, int dcap) {
    char *av[16];
    const char *chrome = "/usr/bin/google-chrome";
    int k = 0, i;
    const char *pre = "/tmp/gpu-tri-";
    k = 0;
    while (pre[k] && k < dcap - 12) { dir[k] = pre[k]; k++; }
    {
        int pid = (int)getpid();
        int seq = ++g_seq;
        int n = pid * 1000 + seq;
        char tmp[16];
        int t = 0;
        if (n < 0) n = -n;
        if (!n) tmp[t++] = '0';
        else {
            char r[16];
            int m = 0;
            while (n && m < 15) { r[m++] = (char)('0' + (n % 10)); n /= 10; }
            while (m) tmp[t++] = r[--m];
        }
        tmp[t] = 0;
        for (i = 0; tmp[i] && k < dcap - 1; i++) dir[k++] = tmp[i];
        dir[k] = 0;
    }
    mkdir(dir, 0700);
    av[0] = (char *)chrome;
    av[1] = "--headless=new";
    av[2] = "--enable-unsafe-swiftshader";
    av[3] = "--allow-file-access-from-files";
    av[4] = "--disable-web-security";
    av[5] = "--no-first-run";
    av[6] = "--no-default-browser-check";
    av[7] = "--user-data-dir=";
    /* chrome wants --user-data-dir=PATH as one argv; rebuild */
    {
        static char ud[256];
        const char *flag = "--user-data-dir=";
        int u = 0, j;
        while (flag[u]) { ud[u] = flag[u]; u++; }
        for (j = 0; dir[j] && u < 255; j++) ud[u++] = dir[j];
        ud[u] = 0;
        av[7] = ud;
    }
    av[8] = "--virtual-time-budget=20000";
    av[9] = "--timeout=20000";
    av[10] = "--dump-dom";
    av[11] = (char *)url;
    av[12] = 0;
    *out = 0;
    *on = 0;
    return cx_runv_timeout(av, 25, out, on);
}
static int expect_title(const char *url, const char *want, const char *forbid, const char *label) {
    char *out = 0;
    size_t on = 0;
    char dir[128];
    int rc, attempt, retries = 0;
    for (attempt = 0; attempt < 3; attempt++) {
        rc = dump_dom(url, &out, &on, dir, (int)sizeof dir);
        if (title_pending(out, on)) {
            retries++;
            printf("retry\t%s\tattempt=%d\trc=%d\tpending=1\n", label, attempt + 1, rc);
            kill_profile(dir);
            wipe_dir(dir);
            if (out) { free(out); out = 0; on = 0; }
            continue;
        }
        if (out && title_is(out, on, want) && (!forbid || !title_is(out, on, forbid))) {
            printf("PASS\t%s\tretries=%d\n", label, retries);
            kill_profile(dir);
            wipe_dir(dir);
            if (leftover_profile(dir)) printf("WARN\tleftover\t%s\n", dir);
            if (out) free(out);
            return 0;
        }
        printf("FAIL\t%s\trc=%d\tretries=%d\tfinal=1\n", label, rc, retries);
        kill_profile(dir);
        wipe_dir(dir);
        if (out) free(out);
        return 1;
    }
    printf("FAIL\t%s\tincomplete\tretries=%d\n", label, retries);
    return 1;
}
static void make_url(char *url, int cap, const char *cwd, const char *suf) {
    const char *pre = "file://";
    int n = 0, i;
    while (pre[n]) { url[n] = pre[n]; n++; }
    for (i = 0; cwd[i] && n < cap - 2; i++) url[n++] = cwd[i];
    for (i = 0; suf[i] && n < cap - 1; i++) url[n++] = suf[i];
    url[n] = 0;
}
int main(int argc, char **argv) {
    FILE *f;
    char line[1024];
    unsigned char b[4096];
    int nb = 0, hi, lo;
    unsigned ofnv = 0;
    char *p;
    char *av[4];
    char *out = 0;
    size_t on = 0;
    int rc;
    char cwd[512];
    char url[640];
    const char *chrome = "/usr/bin/google-chrome";
    (void)argc; (void)argv;
    f = fopen("ujs/tests/uxep-tri-oracle.tsv", "rb");
    if (!f) { fprintf(stderr, "no tsv\n"); return 2; }
    while (fgets(line, (int)sizeof line, f)) {
        if (line[0] == '#' || line[0] == 'k') continue;
        p = line;
        while (*p && *p != '\t') p++;
        if (*p == '\t') p++;
        while (*p >= '0' && *p <= '9') p++;
        if (*p == '\t') p++;
        while (*p >= '0' && *p <= '9') p++;
        if (*p == '\t') p++;
        while (*p >= '0' && *p <= '9') { ofnv = ofnv * 10u + (unsigned)(*p - '0'); p++; }
        break;
    }
    fclose(f);
    if (!ofnv) { fprintf(stderr, "no fnv in tsv\n"); return 2; }
    f = fopen("ujs/tests/uxep-tri-oracle.hex", "rb");
    if (!f) { fprintf(stderr, "no hex\n"); return 2; }
    while (fgets(line, (int)sizeof line, f)) {
        p = line;
        if (line[0] == '#') continue;
        while (*p && *p != '\n' && *p != '\r') {
            while (*p == ' ' || *p == '\t') p++;
            if (!*p || *p == '\n' || *p == '\r') break;
            hi = hx(*p++);
            lo = hx(*p++);
            if (hi < 0 || lo < 0 || nb >= 4096) { fclose(f); return 2; }
            b[nb++] = (unsigned char)((hi << 4) | lo);
        }
    }
    fclose(f);
    if (nb < 168) { fprintf(stderr, "hex short\n"); return 2; }
    printf("oracle_fnv\t%u\thex_bytes\t%d\n", ofnv, nb);
    f = fopen(chrome, "rb");
    if (!f) {
        printf("UJS_GPU_TRI_UNMEASURED\tno-chrome\n");
        return 2;
    }
    fclose(f);
    av[0] = (char *)chrome;
    av[1] = "--version";
    av[2] = 0;
    rc = cx_runv_timeout(av, 10, &out, &on);
    if (out && on) fwrite(out, 1, on, stdout);
    if (out) { free(out); out = 0; on = 0; }
    if (rc != 0) {
        printf("UJS_GPU_TRI_UNMEASURED\tchrome-version\n");
        return 2;
    }
    if (!getcwd(cwd, sizeof cwd)) return 2;
    make_url(url, (int)sizeof url, cwd, "/ujs/practice/uxe/demo/gpu-tri/index.html?auto=1");
    if (expect_title(url, "GPU_TRI_OK", 0, "good-title")) return 1;
    make_url(url, (int)sizeof url, cwd, "/ujs/practice/uxe/demo/gpu-tri/index.html?auto=1&oracle_fnv=1");
    if (expect_title(url, "GPU_TRI_FAIL", "GPU_TRI_OK", "counter-title")) return 1;
    make_url(url, (int)sizeof url, cwd, "/ujs/practice/uxe/demo/gpu-tri/index.html?auto=1&expect_er=0");
    if (expect_title(url, "GPU_TRI_PKT", "GPU_TRI_OK", "pixel-counter")) return 1;
    printf("UJS_GPU_TRI_OK\n");
    return 0;
}
