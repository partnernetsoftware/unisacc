/* tools/reserved-names.cx -- refuse Windows-reserved path segments in tracked files (0.0.94 CI lesson).
 *
 *   sh ./unisacc.com tools/reserved-names.cx -- --check [--root DIR]
 *
 * Scans `git -C ROOT ls-files` (ROOT default "."). A path fails when any of:
 *   (1) a path segment, with its last ".ext" stripped, equals (case-insensitive) nul, con, prn, aux,
 *       com1..com9, or lpt1..lpt9;
 *   (2) a path segment ends with '.' or ' ';
 *   (3) the path contains one of \ : * ? " < > |.
 * Baseline is 0 hits: any hit prints
 *   reserved-names: PATH reason=...
 * and the summary is "reserved-names: FAIL: files=N hits=H" (exit 1), else
 * "reserved-names: ok: files=N hits=0" (exit 0).
 * 19th ratchet in tools/ratchets.cx. Check: tools/check-reserved-names.cx. */
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

static const char *root = ".";

static int lower(char c) {
    if (c >= 'A' && c <= 'Z') return c - 'A' + 'a';
    return (unsigned char)c;
}

static int eq_ci(const char *a, long an, const char *b) {
    long i, bn = 0; while (b[bn]) bn++;
    if (an != bn) return 0;
    for (i = 0; i < an; i++) if (lower(a[i]) != lower(b[i])) return 0;
    return 1;
}

static void stem(const char *seg, long n, const char **out, long *on) {
    long i, dot = -1;
    for (i = 0; i < n; i++) if (seg[i] == '.') dot = i;
    if (dot > 0) { *out = seg; *on = dot; }
    else { *out = seg; *on = n; }
}

static int is_reserved_stem(const char *s, long n) {
    static const char *names[] = {
        "nul", "con", "prn", "aux",
        "com1", "com2", "com3", "com4", "com5", "com6", "com7", "com8", "com9",
        "lpt1", "lpt2", "lpt3", "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9",
        0
    };
    int i;
    for (i = 0; names[i]; i++) if (eq_ci(s, n, names[i])) return 1;
    return 0;
}

static int has_illegal(const char *p, long n) {
    long i;
    for (i = 0; i < n; i++) {
        char c = p[i];
        if (c == '\\' || c == ':' || c == '*' || c == '?' || c == '"' || c == '<' || c == '>' || c == '|') return 1;
    }
    return 0;
}

static const char *bad_path(const char *p, long n, char *why, long wcap) {
    long at = 0;
    if (has_illegal(p, n)) {
        if (cx_fmt(why, wcap, "illegal-char")) return why;
        return "illegal-char";
    }
    while (at <= n) {
        long e = at; const char *st; long sn;
        while (e < n && p[e] != '/') e++;
        if (e > at) {
            if (p[e - 1] == '.' || p[e - 1] == ' ') {
                if (cx_fmt(why, wcap, "trailing-dot-or-space")) return why;
                return "trailing-dot-or-space";
            }
            stem(p + at, e - at, &st, &sn);
            if (is_reserved_stem(st, sn)) {
                if (cx_fmt(why, wcap, "reserved-stem")) return why;
                return "reserved-stem";
            }
        }
        if (e >= n) break;
        at = e + 1;
    }
    return 0;
}

static int do_check(void) {
    char *v[] = {"git", "-C", (char *)root, "ls-files", "-z", 0};
    char *out = 0; size_t n = 0; int rc;
    long at = 0, files = 0, hits = 0; char why[64];
    rc = cx_runv_timeout(v, 50, &out, &n);
    if (rc || !out) {
        fprintf(stderr, "reserved-names: FAIL: git ls-files rc=%d\n", rc);
        mm_free(out);
        return 1;
    }
    while (at < (long)n) {
        long e = at; const char *reason;
        while (e < (long)n && out[e]) e++;
        if (e > at) {
            files++;
            reason = bad_path(out + at, e - at, why, sizeof why);
            if (reason) {
                hits++;
                printf("reserved-names: %.*s reason=%s\n", (int)(e - at), out + at, reason);
            }
        }
        at = e + 1;
    }
    mm_free(out);
    if (hits) {
        printf("reserved-names: FAIL: files=%ld hits=%ld (baseline 0; rename off Windows reserved device names)\n", files, hits);
        return 1;
    }
    printf("reserved-names: ok: files=%ld hits=0\n", files);
    return 0;
}

int main(int argc, char **argv) {
    int i, want = 0;
    for (i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--root") && i + 1 < argc) root = argv[++i];
        else if (tx_eqz(argv[i], "--check")) want = 1;
        else {
            fprintf(stderr, "usage: tools/reserved-names.cx -- --check [--root DIR]\n");
            return 2;
        }
    }
    if (want) return do_check();
    fprintf(stderr, "usage: tools/reserved-names.cx -- --check [--root DIR]\n");
    return 2;
}
