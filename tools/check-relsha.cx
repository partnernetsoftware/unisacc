/* tools/check-relsha.cx -- C4-p1: 40-hex target; short sha and tag-delete refuse. */
#pragma unisa use cxlib.relsha

static int failed;
static void ck(int ok, const char *n) {
    printf("%s\tcheck-relsha.%s\n", ok ? "PASS" : "FAIL", n);
    if (!ok) failed++;
}
int main(void) {
    ck(rs_sha40(0) != 0, "null-refuse");
    ck(rs_sha40("abc") != 0, "short-sha-refuse");
    ck(rs_sha40("23e6a567dd3ab5e481dbe3c98491bc87dd2a3b9") != 0, "39-hex-refuse");
    ck(rs_sha40("23e6a567dd3ab5e481dbe3c98491bc87dd2a3b95") == 0, "40-hex-ok");
    ck(rs_sha40("23E6A567DD3AB5E481DBE3C98491BC87DD2A3B95") != 0, "uppercase-refuse");
    ck(rs_is_tag_delete("gh release delete v0.0.53") == 1, "release-delete-refuse");
    ck(rs_is_tag_delete("git tag -d v0.0.53") == 1, "git-tag-d-refuse");
    ck(rs_is_tag_delete("gh release edit v0 --tag v1 --target 23e6a567dd3ab5e481dbe3c98491bc87dd2a3b95") == 0, "edit-tag-ok");
    printf("CHECK_RELSHA\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
