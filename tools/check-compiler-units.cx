        contract[4] = 'Y'; contract[5] = 'M'; contract[6] = '1'; contract[7] = '\n';
        contract[8] = 1; contract[10] = 2; contract[11] = 0;
        contract[12] = 1; contract[17] = 1;
        contract[20] = 2; contract[24] = 1; contract[25] = 1;
