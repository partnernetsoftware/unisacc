            ck(strcmp(bx_ar_big(), "ar: archive too large\n") == 0, "ar-big");
            ck(strcmp(bx_ar_kind(), "ar: not an archive\n") == 0, "ar-kind");
            ck(strcmp(bx_ar_op(), "ar: operation must be r, q, t or x\n") == 0, "ar-op");
            for (i = 0; i < 64; i++) decl[i] = 'Z';
            ck(bx_as_opt_line(0, decl, 64) == 4 && decl[0] == 'Z', "as-opt-null");
            ck(bx_as_opt_line("-z", decl, 64) == 0 && strcmp(decl, "as: unknown option -z\n") == 0, "as-opt-z");
            ck(bx_as_write_line(0, decl, 64) == 4, "as-write-null");
            ck(bx_as_write_line("a.o", decl, 64) == 0 && strcmp(decl, "as: cannot write a.o\n") == 0, "as-write");
            ck(bx_as_head_line("f.s", decl, 64) == 0 && strcmp(decl, "as: f.s: -S header target conflicts with -b\n") == 0, "as-head");
            for (i = 0; i < 64; i++) decl[i] = 'Z';
            ck(bx_as_err_line(0, 1, "bad", decl, 64) == 4 && decl[0] == 'Z', "as-err-null");
            ck(bx_as_err_line("f.s", 1, 0, decl, 64) == 4 && decl[0] == 'Z', "as-err-nullerr");
            ck(bx_as_err_line("f.s", 3, "", decl, 64) == 0 && strcmp(decl, "as: f.s:3: error\n") == 0, "as-err-empty");
            ck(bx_as_err_line("f.s", -3, "bad", decl, 64) == 0 && strcmp(decl, "as: f.s:-3: bad\n") == 0, "as-err-neg");
            ck(bx_ar_write_line("l.a", decl, 64) == 0 && strcmp(decl, "ar: cannot write l.a\n") == 0, "ar-write");
            ck(bx_link_none_line("a.o", decl, 64) == 0 && strcmp(decl, "link: no input unit selected from a.o\n") == 0, "link-none");
            ck(bx_link_start_line("a.o", decl, 64) == 0 && strcmp(decl, "link: missing _start entry in a.o\n") == 0, "link-start");
            {
                char tape[256];
                for (i = 0; i < 256; i++) tape[i] = 'Z';
                ck(bx_link_target_line(0, "b", tape, 256) == 4 && tape[0] == 'Z', "link-tgt-null");
                ck(bx_link_target_line("x86", "arm", tape, 256) == 0 && strcmp(tape, "unisacc: error: the objects were compiled for different targets (x86, arm)\n") == 0, "link-tgt");
                ck(bx_view_err_line(0, "a.o", "bad", tape, 256) == 0 && strcmp(tape, "nm: a.o: bad (Linux objects; Mach-O and COFF: 0.0.19)\n") == 0, "view-err-nm");
                ck(bx_view_err_line(1, "a.o", "bad", tape, 256) == 0 && strcmp(tape, "objdump: a.o: bad (Linux objects; Mach-O and COFF: 0.0.19)\n") == 0, "view-err-dump");
                for (i = 0; i < 256; i++) tape[i] = 'Z';
                ck(bx_view_err_line(1, 0, "bad", tape, 256) == 4 && tape[0] == 'Z', "view-err-null");
                ck(bx_link_tape_line(0, tape, 256) == 4 && tape[0] == 'Z', "link-tape-null");
                ck(bx_link_tape_line("p.o", tape, 256) == 0 && strcmp(tape, "unisacc: error: p.o carries no unit tape (compile it with -c -b os/arch -funit; objects from other compilers are not linked yet)\n") == 0, "link-tape");
            }
        }
    }
    printf("CHECK_COMPILER_UNITS failed=%d\n", failed);
    return failed ? 1 : 0;
}
