            ck(fw_undef_line("a", -1, decl, 64) == 4 && decl[0] == 'Z', "fwd-line-negn");
            ck(fw_undef_line("a", 1, 0, 64) == 4, "fwd-line-nullout");
            ck(fw_undef_line("foo", 3, decl, 40) == 1 && decl[0] == 'Z', "fwd-line-short");
