#pragma unisa use compiler.tapelink
#pragma unisa use compiler.asmtext
/* Upper modules only. Emission and failure stay injected; this file does not
   link a product compiler and does not claim a host or six-target pass. */
static int failed, die_calls;
static void ck(int ok, const char *name) {
    printf("%s %s\n", ok ? "PASS" : "FAIL", name);
    if (!ok) failed++;
}
static int injected_emit(int c) { (void)c; return 0; }
static int injected_die(char *m) { (void)m; die_calls++; return 1; }
static int asm_emit(char *p, long n) { (void)p; (void)n; return 0; }
int main(void) {
    char shortb[8], arm[] = "# unisacc -S lnx/arm64\n", x64[] = "# unisacc -S lnx/x86_64\n";
    long len;
    len = -1;
    ck(tl_bind(0, injected_die) == 1, "bind-rejects-null-emit");
    ck(tl_bind(injected_emit, 0) == 1, "bind-rejects-null-die");
    ck(tl_bind(injected_emit, injected_die) == 0, "bind-accepts-callbacks");
    die_calls = 0;
    ck(tl_tape(shortb, 8, &len) == 0 && die_calls == 0, "short-tape-miss-without-die");
    ck(at_bind(0) == 1, "asm-bind-rejects-null");
    ck(at_bind(asm_emit) == 0, "asm-bind-accepts-emit");
    ck(at_header_arch(arm, (long long)(sizeof arm - 1)) == 1, "header-arm64");
    ck(at_header_arch(x64, (long long)(sizeof x64 - 1)) == 0, "header-x86_64");
    printf("CHECK_COMPILER_UNITS failed=%d\n", failed);
    return failed ? 1 : 0;
}
