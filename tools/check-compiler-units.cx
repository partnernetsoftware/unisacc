        ck(strcmp(fw_simple_type(0, 0, 0, 4, 0, 0, 0, 0), "float") == 0, "fwd-type-float");
        ck(strcmp(fw_simple_type(0, 0, 0, 8, 0, 0, 0, 0), "double") == 0, "fwd-type-double");
        ck(strcmp(fw_simple_type(0, 0, 0, 0, 0, 0, 1, 0), "signed char") == 0, "fwd-type-sc");
        ck(strcmp(fw_simple_type(0, 0, 0, 0, 0, 0, 1, 1), "unsigned char") == 0, "fwd-type-uc");
        ck(strcmp(fw_simple_type(0, 0, 0, 0, 0, 0, 1, 2), "unsigned char") == 0, "fwd-type-uc2");
        ck(strcmp(fw_simple_type(0, 0, 0, 0, 0, 0, 1, -1), "unsigned char") == 0, "fwd-type-ucneg");
        ck(strcmp(fw_simple_type(0, 0, 0, 0, 0, 0, 2, 0), "short") == 0, "fwd-type-short");
        ck(strcmp(fw_simple_type(0, 0, 0, 0, 0, 0, 2, 1), "unsigned short") == 0, "fwd-type-ushort");
        ck(strcmp(fw_simple_type(0, 0, 0, 0, 0, 0, 4, 0), "int") == 0, "fwd-type-int");
        ck(strcmp(fw_simple_type(0, 0, 0, 0, 0, 0, 4, 1), "unsigned int") == 0, "fwd-type-uint");
        ck(strcmp(fw_simple_type(0, 0, 0, 0, 0, 0, 8, 0), "long") == 0, "fwd-type-long");
        ck(strcmp(fw_simple_type(0, 0, 0, 0, 0, 0, 8, 1), "unsigned long") == 0, "fwd-type-ulong");
        ck(fw_simple_type(0, 0, 0, 0, 0, 0, 3, 0) == 0, "fwd-type-width");
        ck(fw_simple_type(0, 0, 0, 2, 0, 0, 0, 0) == 0, "fwd-type-kind");
        {
            char decl[64];
            int i;
            const char *two[2];
            const char *one[1];
            const char *badrow[1];
            for (i = 0; i < 64; i++) decl[i] = 'Z';
            ck(fw_decl(0, 0, 0, 0, decl, 64) == 4 && decl[0] == 'Z', "fwd-decl-nullret");
            ck(fw_decl("int", 0, 0, 0, 0, 64) == 4, "fwd-decl-nullout");
            ck(fw_decl("int", 0, 0, -1, decl, 64) == 4 && decl[0] == 'Z', "fwd-decl-negn");
            ck(fw_decl("int", 0, 0, 1, decl, 64) == 4 && decl[0] == 'Z', "fwd-decl-nullargs");
            badrow[0] = 0;
            ck(fw_decl("int", 0, badrow, 1, decl, 64) == 4 && decl[0] == 'Z', "fwd-decl-nullarg");
            ck(fw_decl("int", 0, 0, 0, decl, 0) == 4 && decl[0] == 'Z', "fwd-decl-cap0");
            ck(fw_decl("int", 0, 0, 0, decl, 15) == 1 && decl[0] == 'Z', "fwd-decl-short");
            ck(fw_decl("int", 0, 0, 0, decl, 16) == 0 && strcmp(decl, "int (*a0)(void)") == 0, "fwd-decl-void");
            ck(fw_decl("", 0, 0, 0, decl, 32) == 0 && strcmp(decl, " (*a0)(void)") == 0, "fwd-decl-empty");
            ck(fw_decl("int", -3, 0, 0, decl, 32) == 0 && strcmp(decl, "int (*a-3)(void)") == 0, "fwd-decl-neg");
            one[0] = "char *";
            ck(fw_decl("void", 1, one, 1, decl, 32) == 0 && strcmp(decl, "void (*a1)(char *)") == 0, "fwd-decl-one");
            two[0] = "int";
            two[1] = "char *";
            ck(fw_decl("void *", 12, two, 2, decl, 26) == 1, "fwd-decl-two-short");
            for (i = 0; i < 64; i++) decl[i] = 'Z';
            ck(fw_decl("void *", 12, two, 2, decl, 27) == 0 && strcmp(decl, "void * (*a12)(int, char *)") == 0, "fwd-decl-two");
            ck(fw_side_head(0, 0) == 1, "fwd-head-shortnull");
            ck(fw_side_head(0, 6) == 1, "fwd-head-six");
            ck(fw_side_head(0, 7) == 4, "fwd-head-null");
            ck(fw_side_head((const unsigned char *)"USLFW1\n", 7) == 0, "fwd-head-ok");
            ck(fw_side_head((const unsigned char *)"USLFW1x", 7) == 1, "fwd-head-bad");
            ck(fw_side_head((const unsigned char *)"uslfw1\n", 7) == 1, "fwd-head-case");
            ck(fw_side_bad(0, 4, 10, 6) == 0, "fwd-span-fit");
            ck(fw_side_bad(0, 5, 10, 6) == 1, "fwd-span-over");
            ck(fw_side_bad(256, 0, 10, 0) == 0, "fwd-span-ccw");
            ck(fw_side_bad(257, 0, 10, 0) == 1, "fwd-span-ccwhi");
            ck(strcmp(fw_side_why(0), "unisacc: error: forwarding side-car missing\n") == 0, "fwd-side-miss");
            ck(strcmp(fw_side_why(1), "unisacc: error: forwarding side-car malformed\n") == 0, "fwd-side-bad");
            ck(fw_side_why(2) == 0, "fwd-side-kind");
            ck(fw_undef(0, 0, 0, 0) == 0, "fwd-undef-ok");
            ck(fw_undef(0, 0, 0, 32) == 0, "fwd-undef-32");
            ck(fw_undef(0, 0, 0, 33) == 1, "fwd-undef-33");
            ck(fw_undef(0, 0, 0, -1) == 0, "fwd-undef-negn");
            ck(fw_undef(1, 0, 0, 0) == 1, "fwd-undef-bad");
            ck(fw_undef(2, 0, 0, 0) == 1, "fwd-undef-bad2");
            ck(fw_undef(0, 1, 0, 0) == 1, "fwd-undef-struct");
            ck(fw_undef(0, -1, 0, 0) == 1, "fwd-undef-structneg");
            ck(fw_undef(0, 0, 1, 0) == 1, "fwd-undef-ret");
            ck(fw_emit_miss(0) == 1, "fwd-emit-miss");
            ck(fw_emit_miss(1) == 0, "fwd-emit-ok");
            ck(fw_emit_miss(2) == 0, "fwd-emit-two");
            ck(fw_emit_miss(-1) == 0, "fwd-emit-neg");
            for (i = 0; i < 64; i++) decl[i] = 'Z';
