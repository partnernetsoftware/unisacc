/* tools/check-textx-json-edit.cx -- ext/textx/json.cx object editing: folding js_parse, js_parse_keepdup,
 *   js_obj_put, js_obj_del, js_assert_tree.
 *   sh ./unisacc.com tools/check-textx-json-edit.cx [-- --cases edit;api;assert;mutc;mut1;mut2;mut3]
 *   edit    tests/fixtures/textx-json-edit/js-object-edit.tsv (143 cases made with JavaScript; never started here):
 *           per row why TAB input-json TAB ops-json TAB parsed-keys-json TAB expected-json, every field JSON. The
 *           input (a JSON string) is parsed with js_parse (JSON.parse folding: later value, first position), the
 *           ops (put -> js_obj_put with a clone of the value, del -> js_obj_del)
 *           are applied in order, the key list of the result must equal parsed-keys (despite its name it is the key order after the ops), and js_emit_pretty must give exactly the expected text. Zero differences or FAIL;
 *           the first 10 differing rows are printed whole. Fixture note: -0 reaches the ops as 0 (JSON.stringify).
 *   api     js_parse_keepdup keeps repeated keys (js_parse folds the same text); put on a tree with repeated keys
 *           (keepdup or js_obj_set) replaces the FIRST match only; del removes all of them; error returns and
 *           ownership (a refused put leaves CHILD with the caller); putting the node already held is a no-op;
 *           folding at depth, with 2000 distinct keys twice, bad text still refused; put/del churn
 *   assert  js_assert_tree: normal parsed tree and 0 give 0; one node under two parents, twice in one array, a
 *           shared node deep in a 60-level doubling DAG (2^60 paths: must stop early) give -EEXIST; a cycle and
 *           nesting over the depth limit give -ELOOP
 *   mutc/mut1..3  a private copy of json.cx with one line changed must fail the named cases (child runs edit and
 *           api): mutc unmutated control; mut1 put replaces the LAST match; mut2 the fold keeps the first value;
 *           mut3 del removes only the first match
 * Prints PASS/FAIL per case and CHECK_TEXTX_JSON_EDIT<TAB>failed=N; exit 0 only when N is 0. */
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use text.text
#pragma unisa use text.num
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use testx.check
#pragma unisa use cxlib.muthelp
#pragma unisa use textx.json

#define OCAP 262144
static unsigned char o1[OCAP + 8];

static long emitp(const js_val *v) { long r = js_emit(v, o1, OCAP); if (r >= 0) o1[r] = 0; else o1[0] = 0; return r; }
static int is(const js_val *v, const char *want) { long r = emitp(v); return r == (long)strlen(want) && !memcmp(o1, want, (size_t)r); }
static js_val *pk(const char *t) { return js_parse_keepdup(t, (long)strlen(t), 0, 0); }
static js_val *pf(const char *t) { return js_parse(t, (long)strlen(t), 0, 0); }
static js_val *num(double d) { return js_mk_num(d); }

/* ---- edit: the fixture ---- */
static int keys_are(const js_val *o, const js_val *want) {
    long i;
    if (js_kind(o) != JS_OBJ || js_kind(want) != JS_ARR || js_len(o) != js_len(want)) return 0;
    for (i = 0; i < js_len(o); i++) {
        const char *k = js_key(o, i), *w = js_str(js_at(want, i));
        if (!k || !w || strcmp(k, w)) return 0;
    }
    return 1;
}
static void group_edit(void) {
    static const char *fp = "tests/fixtures/textx-json-edit/js-object-edit.tsv";
    size_t n = 0, i; char *src; long cnt = 0, bad = 0, shown = 0;
    if (sy_exists(fp) != 1) { printf("UNMEASURED\tedit\tfixture absent: %s\n", fp); tk_ok(0, "edit-fixture-present"); return; }
    src = cx_read(fp, &n);
    for (i = 0; src && i < n; ) {
        size_t e = i, f[5], nf = 0, k; int ok = 1; js_val *fv[5] = {0, 0, 0, 0, 0}, *doc = 0; long r = -1;
        while (e < n && src[e] != '\n') e++;
        if (src[i] == '#' || e == i) { i = e + 1; continue; }
        f[0] = i; nf = 1;
        for (k = i; k < e && nf < 5; k++) if (src[k] == '\t') f[nf++] = k + 1;
        cnt++;
        if (nf != 5) ok = 0;
        else {
            size_t end[5]; long j;
            for (j = 0; j < 4; j++) end[j] = f[j + 1] - 1;
            end[4] = e;
            for (j = 1; j < 5; j++) { fv[j] = js_parse(src + f[j], (long)(end[j] - f[j]), 0, 0); if (!fv[j]) ok = 0; }
            if (ok) {
                const char *in = js_str(fv[1]); long ni = js_str_len(fv[1]);
                doc = in ? js_parse(in, ni, 0, 0) : 0;
                if (!doc || js_kind(fv[2]) != JS_ARR) ok = 0;
                for (j = 0; ok && j < js_len(fv[2]); j++) {
                    js_val *op = js_at(fv[2], j), *v = js_get(op, "value");
                    const char *kind = js_str(js_get(op, "op")), *key = js_str(js_get(op, "key"));
                    if (!kind || !key) { ok = 0; break; }
                    if (!strcmp(kind, "put")) { js_val *c = js_clone(v); if (!c || js_obj_put(doc, key, c)) { js_free(c); ok = 0; } }
                    else if (!strcmp(kind, "del")) { if (js_obj_del(doc, key)) ok = 0; }
                    else ok = 0;
                }
                if (ok) {
                    r = js_emit_pretty(doc, o1, OCAP);
                    ok = keys_are(doc, fv[3]) && r >= 0 && r == js_str_len(fv[4]) && !memcmp(o1, js_str(fv[4]), (size_t)r);
                }
            }
        }
        if (!ok && ++bad && shown++ < 10) {
            printf("  DIFF row %ld: %.*s\n", cnt, (int)(e - i), src + i);
            if (r >= 0) printf("  got: %.*s\n", (int)r, (char *)o1);
        }
        { int j; for (j = 1; j < 5; j++) js_free(fv[j]); }
        js_free(doc);
        i = e + 1;
    }
    printf("EDIT\tcases\tn=%ld\tdiff=%ld\n", cnt, bad);
    tk_ok(src && cnt == 143 && bad == 0, "edit-fixture-143-cases");
}

/* ---- api ---- */
static void group_api(void) {
    js_val *o, *c, *x; long i; char gen[64];
    static const char dup3[] = "{\"a\":1,\"b\":2,\"a\":3}";
    o = pk(dup3); tk_ok(o && js_len(o) == 3 && is(o, dup3), "api-keepdup-keeps-all"); js_free(o);
    o = pf(dup3); tk_ok(o && js_len(o) == 2 && is(o, "{\"a\":3,\"b\":2}"), "api-parse-folds-same-text"); js_free(o);
    o = pf("{\"z\":1,\"a\":2,\"z\":9,\"m\":3,\"a\":8}"); tk_ok(o && is(o, "{\"z\":9,\"a\":8,\"m\":3}"), "api-fold-order-z-a-m"); js_free(o);
    o = pf("[{\"k\":1,\"k\":2},{\"k\":{\"x\":1,\"x\":2,\"x\":3}}]"); tk_ok(o && is(o, "[{\"k\":2},{\"k\":{\"x\":3}}]"), "api-fold-nested-in-array-and-object"); js_free(o);
    o = pk("[{\"k\":1,\"k\":2}]"); tk_ok(o && is(o, "[{\"k\":1,\"k\":2}]"), "api-keepdup-nested"); js_free(o);
    o = pk(dup3); tk_ok(js_obj_put(o, "a", num(9)) == 0 && is(o, "{\"a\":9,\"b\":2,\"a\":3}"), "api-put-first-of-keepdup"); js_free(o);
    o = pk(dup3); tk_ok(js_obj_del(o, "a") == 0 && is(o, "{\"b\":2}"), "api-del-all-dups"); js_free(o);
    o = js_mk_obj(); js_obj_set(o, "a", num(1)); js_obj_set(o, "a", num(2));
    tk_ok(js_obj_put(o, "a", num(5)) == 0 && is(o, "{\"a\":5,\"a\":2}") && js_obj_set(o, "a", num(6)) == 0 && js_len(o) == 3, "api-set-still-appends-put-replaces-first"); js_free(o);
    o = pf("{\"a\":1,\"b\":2}"); tk_ok(js_obj_del(o, "zz") == 0 && js_obj_del(o, "") == 0 && is(o, "{\"a\":1,\"b\":2}"), "api-del-missing-ok");
    tk_ok(js_obj_del(o, "a") == 0 && js_obj_put(o, "a", num(7)) == 0 && is(o, "{\"b\":2,\"a\":7}"), "api-del-then-put-goes-last");
    c = js_at(o, 0); tk_ok(js_obj_put(o, "b", c) == 0 && is(o, "{\"b\":2,\"a\":7}"), "api-put-same-node-noop");
    c = num(1);
    tk_ok(js_obj_put(o, 0, c) < 0 && js_obj_put(0, "a", c) < 0 && js_obj_put(o, "a", 0) < 0 && js_obj_put(o, "a", o) < 0, "api-put-bad-args");
    tk_ok(js_obj_del(0, "a") < 0 && js_obj_del(o, 0) < 0, "api-del-bad-args");
    x = js_mk_arr();
    tk_ok(js_obj_put(x, "a", c) < 0 && js_obj_del(x, "a") < 0 && js_len(x) == 0, "api-put-del-refuse-array");
    tk_ok(is(c, "1") && is(o, "{\"b\":2,\"a\":7}"), "api-refused-put-leaves-child-and-object");
    js_free(c); js_free(x); js_free(o);
    o = js_mk_obj();
    for (i = 0; i < 2000; i++) { cx_fmt(gen, sizeof gen, "k%ld", i); js_obj_set(o, gen, num((double)i)); }
    for (i = 0; i < 2000; i++) { cx_fmt(gen, sizeof gen, "k%ld", i); if (js_obj_put(o, gen, num((double)(i + 1))) || js_obj_put(o, "new", num(1))) break; }
    tk_ok(i == 2000 && js_len(o) == 2001 && js_num(js_get(o, "k1999")) == 2000.0, "api-put-2000-keys");
    for (i = 0; i < 2000; i += 2) { cx_fmt(gen, sizeof gen, "k%ld", i); if (js_obj_del(o, gen)) break; }
    tk_ok(i == 2000 && js_len(o) == 1001 && js_num(js_get(o, "k1")) == 2.0 && !js_get(o, "k0"), "api-del-1000-keys");
    js_free(o);
    {   static char big[40000]; long w = 0;
        big[w++] = '{';
        for (i = 0; i < 2000; i++) { cx_fmt(gen, sizeof gen, "\"k%ld\":1,\"k%ld\":2,", i, i); w += (long)strlen(gen); if (w < 39000) { mh_copy(big + w - (long)strlen(gen), gen, (long)strlen(gen)); } }
        big[w - 1] = '}';
        o = js_parse(big, w, 0, 0);
        tk_ok(o == 0 || js_len(o) <= 2000, "api-fold-large-object-bounded");
        js_free(o); }
    {   char err[96]; o = js_parse("{\"a\":1,\"a\":}", 12, err, sizeof err); tk_ok(!o && tk_has(err, "offset"), "api-bad-text-still-refused"); js_free(o); }
    for (i = 0; i < 3000; i++) {
        o = pf("{\"a\":1,\"b\":[1,2],\"a\":{\"q\":1}}");
        if (js_obj_put(o, "b", pf("{\"deep\":[1,{\"x\":2}]}")) || js_obj_del(o, "a") || js_obj_put(o, "a", num(1)) || js_len(o) != 2) break;
        js_free(o);
    }
    tk_ok(i == 3000, "api-put-del-churn-3000");
}

/* ---- assert ---- */
static void group_assert(void) {
    js_val *o, *a, *b, *x, *arr[64]; long i;
    tk_ok(js_assert_tree(0) == 0, "assert-null-is-0");
    x = num(1); tk_ok(js_assert_tree(x) == 0, "assert-scalar-is-0"); js_free(x);
    o = pf("{\"a\":[1,2,{\"b\":[]}],\"c\":{\"d\":\"s\"}}"); tk_ok(js_assert_tree(o) == 0, "assert-parsed-tree-is-0"); js_free(o);
    o = js_mk_obj(); a = js_mk_arr(); x = num(5);
    js_arr_push(a, x); js_obj_set(o, "p", a); js_obj_set(o, "q", x);
    tk_ok(js_assert_tree(o) == -EEXIST, "assert-node-under-two-parents");
    o->n = 1; mm_free(o->keys[1]); o->keys[1] = 0; js_free(o);
    a = js_mk_arr(); x = num(5); js_arr_push(a, x); js_arr_push(a, x);
    tk_ok(js_assert_tree(a) == -EEXIST, "assert-same-node-twice-in-array");
    a->n = 1; js_free(a);
    a = js_mk_arr(); b = js_mk_arr(); js_arr_push(a, b); js_arr_push(b, a);
    tk_ok(js_assert_tree(a) == -ELOOP, "assert-cycle");
    b->n = 0; js_free(a);
    a = js_mk_arr(); x = a;
    for (i = 0; i < 135; i++) { b = js_mk_arr(); js_arr_push(x, b); x = b; }
    tk_ok(js_assert_tree(a) == -ELOOP, "assert-nesting-over-limit");
    js_free(a);
    arr[0] = js_mk_arr();
    for (i = 1; i < 60; i++) { arr[i] = js_mk_arr(); js_arr_push(arr[i], arr[i - 1]); js_arr_push(arr[i], arr[i - 1]); }
    tk_ok(js_assert_tree(arr[59]) == -EEXIST, "assert-doubling-dag-stops-early");
    for (i = 0; i < 60; i++) arr[i]->n = 0;
    for (i = 0; i < 60; i++) js_free(arr[i]);
    a = js_mk_arr();
    for (i = 0; i < 5000; i++) { b = js_mk_obj(); js_obj_set(b, "i", num((double)i)); js_arr_push(a, b); }
    tk_ok(js_assert_tree(a) == 0, "assert-large-normal-tree-10000-nodes");
    js_free(a);
}

/* ---- mutation: private copy of the package source with one change ---- */
static char work[4096], com[4400], root[4096];
static int setup(const char *old, const char *nw) {
    char lk[4400], p[4400]; char *src, *dst; size_t n, i, k = 0, ln;
    if (!mh_put_mut(root, work, "ext/textx/json.cx", old, nw)) return 0;
    if (!mh_put_mut(root, work, "tools/check-textx-json-edit.cx", "", "")) return 0;
    if (cx_fmt(lk, sizeof lk, "%s/r", work)) return 0;
    if (sy_exists(lk) != 1 && sy_symlink(root, lk)) return 0;
    if (cx_fmt(p, sizeof p, "%s/cxroot.tsv", root)) return 0;
    src = cx_read(p, &n);
    if (!src || !(dst = mm_alloc((long)n * 2 + 64))) return 0;
    i = 0;
    while (i < n) {   /* each line; R rows other than textx get the r/ link prefix on DIR */
        size_t e = i, t1 = 0, t2 = 0;
        while (e < n && src[e] != '\n') { if (src[e] == '\t') { if (!t1) t1 = e; else if (!t2) t2 = e; } e++; }
        ln = e - i;
        if (ln > 2 && src[i] == 'R' && src[i + 1] == '\t' && t2 && !(t2 - (i + 2) == 5 && !strncmp(src + i + 2, "textx", 5))) {
            mh_copy(dst + k, src + i, (long)(t2 + 1 - i)); k += t2 + 1 - i;
            dst[k++] = 'r'; dst[k++] = '/';
            mh_copy(dst + k, src + t2 + 1, (long)(e - t2 - 1)); k += e - t2 - 1;
        } else { mh_copy(dst + k, src + i, (long)ln); k += ln; }
        if (e < n) dst[k++] = '\n';
        i = e + 1;
    }
    dst[k] = 0;
    return tk_write(work, "cxroot.tsv", dst) == 0;
}
static const char *ccases = "edit;api";
static int child(void) {
    char probe[4400]; char *av[] = { "sh", com, probe, "--", "--cases", (char *)ccases, 0 };
    if (cx_fmt(probe, sizeof probe, "%s/tools/check-textx-json-edit.cx", work)) return -1;
    { int rc = tk_run(av, 0, 55000); if (rc != 0 && rc != 1) printf("  child rc=%d\n%s\n", rc, tk_out()); return rc; }
}
static void group_mut(int part) {
    int rc;
    if (tk_scratch("check-textx-json-edit", work, sizeof work)) { tk_ok(0, "mut-scratch"); return; }
    if (part == 0) {
        if (setup("", "")) { rc = child(); tk_ok(rc == 0 && tk_has(tk_out(), "PASS\tedit-fixture-143-cases") && tk_has(tk_out(), "PASS\tapi-put-first-of-keepdup"), "mut-control-unmutated-passes"); }
        else tk_ok(0, "mut-control-setup");
    }
    if (part == 1) {
        if (setup("    at = js_findk(o, key, kn);", "    { long q; at = -1; for (q = 0; q < o->n; q++) if (o->klens[q] == kn && mm_same(o->keys[q], key, kn)) at = q; }")) {
            rc = child(); tk_ok(rc == 1 && tk_has(tk_out(), "FAIL\tapi-put-first-of-keepdup") && tk_has(tk_out(), "FAIL\tapi-set-still-appends-put-replaces-first"), "mut-put-last-detected");
        } else tk_ok(0, "mut-put-last-setup");
    }
    if (part == 2) {
        if (setup("js_free(c->items[q]); c->items[q] = x; mm_free(key);", "js_free(x); mm_free(key);")) {
            rc = child(); tk_ok(rc == 1 && tk_has(tk_out(), "FAIL\tedit-fixture-143-cases") && tk_has(tk_out(), "FAIL\tapi-parse-folds-same-text"), "mut-fold-first-value-detected");
        } else tk_ok(0, "mut-fold-setup");
    }
    if (part == 3) {
        if (setup("        if (o->klens[i] == kn && mm_same(o->keys[i], key, kn)) { js_free(o->items[i]); mm_free(o->keys[i]); continue; }", "        if (w == i && o->klens[i] == kn && mm_same(o->keys[i], key, kn)) { js_free(o->items[i]); mm_free(o->keys[i]); continue; }")) {
            rc = child(); tk_ok(rc == 1 && tk_has(tk_out(), "FAIL\tapi-del-all-dups"), "mut-del-first-only-detected");
        } else tk_ok(0, "mut-del-first-setup");
    }
}

int main(int argc, char **argv) {
    tk_begin("");
    tk_cases_init(argc, argv);
    if (sy_cwd(root, sizeof root) < 0 || cx_fmt(com, sizeof com, "%s/unisacc.com", root)) return 2;
    if (tk_case("edit")) group_edit();
    if (tk_case("api")) group_api();
    if (tk_case("assert")) group_assert();
    if (tk_case("mutc")) group_mut(0);
    if (tk_case("mut1")) group_mut(1);
    if (tk_case("mut2")) group_mut(2);
    if (tk_case("mut3")) group_mut(3);
    return tk_end("CHECK_TEXTX_JSON_EDIT", 0);
}
