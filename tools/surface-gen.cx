#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use text.text
/* Lay the compiler and runtime stream skeletons from the two fact tables.
   sh ./unisacc.com tools/surface-gen.cx -- --check
   sh ./unisacc.com tools/surface-gen.cx -- --write
   Streams come from exec/pipeline/image-stages.tsv (official column).
   Nets come from exec/pipeline/gold-stages.tsv.
   Compiler gets one skeleton per stream and per net.
   Runtime gets one skeleton per stream. Nets stay on the compiler side.
   Each file is a stem module whose only function returns 0.
   Behavior stays for later TDD. No libc and no include. */
#define STREAMS "exec/pipeline/image-stages.tsv"
#define NETS "exec/pipeline/gold-stages.tsv"
#define SMAX 8
#define NMAX 24
#define NAMEMAX 32
#define FILECAP 1024
#define CHECKCAP 16384
#define RTCHECKCAP 4096

typedef struct { char stage[NAMEMAX]; char official[NAMEMAX]; } SRow;
typedef struct { char name[NAMEMAX]; } NRow;

static SRow srows[SMAX];
static NRow nrows_v[NMAX];
static int ns, nn;

static int fail(const char *why) {
    sy_eprintf("surface-gen\tFAIL\t%s\n", why);
    return 1;
}

static int ident(const char *s, int n) {
    int i;
    if (n < 1 || n >= NAMEMAX) return 0;
    if (!((s[0] >= 'a' && s[0] <= 'z') || s[0] == '_')) return 0;
    for (i = 1; i < n; i++) {
        char c = s[i];
        if (c >= 'a' && c <= 'z') continue;
        if (c >= '0' && c <= '9') continue;
        if (c == '_') continue;
        return 0;
    }
    return 1;
}

static int field_ok(const char *s, int n) {
    int i;
    if (n < 1 || n >= NAMEMAX) return 0;
    for (i = 0; i < n; i++) {
        char c = s[i];
        if (c >= 'a' && c <= 'z') continue;
        if (c >= '0' && c <= '9') continue;
        if (c == '.' || c == '_') continue;
        return 0;
    }
    return 1;
}

static void copy_field(char *dst, const char *s, int n) {
    int i;
    for (i = 0; i < n; i++) dst[i] = s[i];
    dst[n] = 0;
}

static int take_stream(const char *line, int n) {
    const char *f[5];
    int len[5];
    int i, k, start;
    if (ns >= 7) return fail("stream-count");
    k = 0;
    start = 0;
    for (i = 0; i <= n; i++) {
        if (i == n || line[i] == '\t') {
            if (k >= 5) return fail("row-fields");
            f[k] = line + start;
            len[k] = i - start;
            k++;
            start = i + 1;
        }
    }
    if (k != 5) return fail("row-fields");
    for (i = 0; i < 5; i++) if (!field_ok(f[i], len[i])) return fail("row-charset");
    if (!ident(f[4], len[4])) return fail("official-ident");
    copy_field(srows[ns].stage, f[0], len[0]);
    copy_field(srows[ns].official, f[4], len[4]);
    ns++;
    return 0;
}

static int parse_streams(char *b, size_t n) {
    size_t i = 0;
    int saw = 0;
    if (n == 0 || b[n - 1] != '\n') return fail("stream-newline");
    while (i < n) {
        size_t e = i;
        while (e < n && b[e] != '\n') e++;
        b[e] = 0;
        if (e == i) return fail("stream-blank");
        if (!saw) {
            if (!tx_eqz(b + i, "# stage\tinput format\toutput format\tmodel file\tofficial"))
                return fail("stream-header");
            saw = 1;
        } else if (b[i] == '#') {
            return fail("stream-comment");
        } else if (take_stream(b + i, (int)(e - i))) {
            return 1;
        }
        i = e + 1;
    }
    if (ns != 7) return fail("stream-count");
    return 0;
}

static int parse_nets(char *b, size_t n) {
    size_t i = 0;
    int saw = 0;
    if (n == 0 || b[n - 1] != '\n') return fail("net-newline");
    while (i < n) {
        size_t e = i;
        int len;
        while (e < n && b[e] != '\n') e++;
        b[e] = 0;
        if (e == i) return fail("net-blank");
        if (!saw) {
            if (!tx_eqz(b + i, "# stage")) return fail("net-header");
            saw = 1;
        } else if (b[i] == '#') {
            return fail("net-comment");
        } else {
            len = (int)(e - i);
            if (nn >= 18) return fail("net-count");
            if (!ident(b + i, len)) return fail("net-ident");
            copy_field(nrows_v[nn].name, b + i, len);
            nn++;
        }
        i = e + 1;
    }
    if (nn != 18) return fail("net-count");
    return 0;
}

static int unique_names(void) {
    int i, j;
    for (i = 0; i < ns; i++) {
        for (j = i + 1; j < ns; j++) {
            if (tx_eqz(srows[i].official, srows[j].official)) return fail("official-dup");
            if (tx_eqz(srows[i].stage, srows[j].stage)) return fail("stage-dup");
        }
    }
    for (i = 0; i < nn; i++) {
        for (j = i + 1; j < nn; j++) {
            if (tx_eqz(nrows_v[i].name, nrows_v[j].name)) return fail("net-dup");
        }
    }
    return 0;
}

static int app(char *dst, int cap, int *n, const char *s) {
    int i = 0;
    while (s[i]) {
        if (*n + 1 >= cap) return -1;
        dst[*n] = s[i];
        *n += 1;
        i++;
    }
    dst[*n] = 0;
    return 0;
}

static int app_n(char *dst, int cap, int *n, int d) {
    char s[4];
    int k = 0;
    if (d < 0 || d > 99) return -1;
    if (d >= 10) s[k++] = (char)('0' + d / 10);
    s[k++] = (char)('0' + d % 10);
    s[k] = 0;
    return app(dst, cap, n, s);
}

static int emit_skel(char *dst, int cap, const char *stem, const char *prefix) {
    int n = 0;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa module ")) return -1;
    if (app(dst, cap, &n, stem)) return -1;
    if (app(dst, cap, &n, "\n/* Generated by tools/surface-gen.cx. Skeleton only.\n")) return -1;
    if (app(dst, cap, &n, "   The body returns 0. Behavior is later TDD.\n")) return -1;
    if (app(dst, cap, &n, "   Do not edit by hand. No libc and no include. */\n")) return -1;
    if (app(dst, cap, &n, "int ")) return -1;
    if (app(dst, cap, &n, prefix)) return -1;
    if (app(dst, cap, &n, "_")) return -1;
    if (app(dst, cap, &n, stem)) return -1;
    if (app(dst, cap, &n, "(void) {\n    return 0;\n}\n")) return -1;
    return n;
}

static int emit_check(char *dst, int cap) {
    int n = 0, i;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa use compiler.streamname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use compiler.netname\n")) return -1;
    for (i = 0; i < ns; i++) {
        if (app(dst, cap, &n, "#pragma unisa use compiler.stream.")) return -1;
        if (app(dst, cap, &n, srows[i].official)) return -1;
        if (app(dst, cap, &n, "\n")) return -1;
    }
    for (i = 0; i < nn; i++) {
        if (app(dst, cap, &n, "#pragma unisa use compiler.net.")) return -1;
        if (app(dst, cap, &n, nrows_v[i].name)) return -1;
        if (app(dst, cap, &n, "\n")) return -1;
    }
    if (app(dst, cap, &n, "#pragma unisa use sys.io\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use text.text\n")) return -1;
    if (app(dst, cap, &n, "/* Generated by tools/surface-gen.cx. Narrow check of the surface skeletons. */\n")) return -1;
    if (app(dst, cap, &n, "int main(void) {\n")) return -1;
    if (app(dst, cap, &n, "    const char *off; const char *code; const char *name;\n")) return -1;
    if (app(dst, cap, &n, "    if (sn_count() != 7) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (nn_count() != 18) return 1;\n")) return -1;
    for (i = 0; i < ns; i++) {
        if (app(dst, cap, &n, "    if (sn_at(")) return -1;
        if (app_n(dst, cap, &n, i)) return -1;
        if (app(dst, cap, &n, ", &off, &code) || !tx_eqz(off, \"")) return -1;
        if (app(dst, cap, &n, srows[i].official)) return -1;
        if (app(dst, cap, &n, "\") || !tx_eqz(code, \"")) return -1;
        if (app(dst, cap, &n, srows[i].stage)) return -1;
        if (app(dst, cap, &n, "\")) return 1;\n")) return -1;
        if (app(dst, cap, &n, "    if (sks_")) return -1;
        if (app(dst, cap, &n, srows[i].official)) return -1;
        if (app(dst, cap, &n, "()) return 1;\n")) return -1;
    }
    for (i = 0; i < nn; i++) {
        if (app(dst, cap, &n, "    if (nn_at(")) return -1;
        if (app_n(dst, cap, &n, i)) return -1;
        if (app(dst, cap, &n, ", &name) || !tx_eqz(name, \"")) return -1;
        if (app(dst, cap, &n, nrows_v[i].name)) return -1;
        if (app(dst, cap, &n, "\")) return 1;\n")) return -1;
        if (app(dst, cap, &n, "    if (skn_")) return -1;
        if (app(dst, cap, &n, nrows_v[i].name)) return -1;
        if (app(dst, cap, &n, "()) return 1;\n")) return -1;
    }
    if (app(dst, cap, &n, "    sy_printf(\"CX_SURFACE\\tok=25\\tfailed=0\\n\");\n")) return -1;
    if (app(dst, cap, &n, "    return 0;\n}\n")) return -1;
    return n;
}

static int emit_rt_check(char *dst, int cap) {
    int n = 0, i;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa use compiler.streamname\n")) return -1;
    for (i = 0; i < ns; i++) {
        if (app(dst, cap, &n, "#pragma unisa use runtime.stream.")) return -1;
        if (app(dst, cap, &n, srows[i].official)) return -1;
        if (app(dst, cap, &n, "\n")) return -1;
    }
    if (app(dst, cap, &n, "#pragma unisa use sys.io\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use text.text\n")) return -1;
    if (app(dst, cap, &n, "/* Generated by tools/surface-gen.cx. Narrow check of the runtime stream skeletons. */\n")) return -1;
    if (app(dst, cap, &n, "int main(void) {\n")) return -1;
    if (app(dst, cap, &n, "    const char *off; const char *code;\n")) return -1;
    if (app(dst, cap, &n, "    if (sn_count() != 7) return 1;\n")) return -1;
    for (i = 0; i < ns; i++) {
        if (app(dst, cap, &n, "    if (sn_at(")) return -1;
        if (app_n(dst, cap, &n, i)) return -1;
        if (app(dst, cap, &n, ", &off, &code) || !tx_eqz(off, \"")) return -1;
        if (app(dst, cap, &n, srows[i].official)) return -1;
        if (app(dst, cap, &n, "\") || !tx_eqz(code, \"")) return -1;
        if (app(dst, cap, &n, srows[i].stage)) return -1;
        if (app(dst, cap, &n, "\")) return 1;\n")) return -1;
        if (app(dst, cap, &n, "    if (rts_")) return -1;
        if (app(dst, cap, &n, srows[i].official)) return -1;
        if (app(dst, cap, &n, "()) return 1;\n")) return -1;
    }
    if (app(dst, cap, &n, "    sy_printf(\"CX_RUNTIME_SURFACE\\tok=7\\tfailed=0\\n\");\n")) return -1;
    if (app(dst, cap, &n, "    return 0;\n}\n")) return -1;
    return n;
}

static int same_bytes(const char *a, size_t an, const char *b, int bn) {
    int i;
    if (an != (size_t)bn) return 0;
    for (i = 0; i < bn; i++) if (a[i] != b[i]) return 0;
    return 1;
}

static int one_file(int dowrite, const char *path, const char *body, int n) {
    size_t on = 0;
    char *cur;
    if (dowrite) {
        if (cx_write(path, body, (size_t)n)) return fail("write");
        return 0;
    }
    cur = cx_read(path, &on);
    if (!cur) return fail(path);
    if (!same_bytes(cur, on, body, n)) return fail(path);
    return 0;
}

static int ensure_dir(const char *path) {
    if (sy_mkdir(path, 0755) && sy_exists(path) != 1) return fail(path);
    return 0;
}

int main(int argc, char **argv) {
    size_t snb = 0, nnb = 0;
    char *sb, *nb;
    char file[FILECAP], path[160], check[CHECKCAP], rtcheck[RTCHECKCAP];
    int dowrite, i, fn, cn, rn;
    if (argc != 2 || (!tx_eqz(argv[1], "--check") && !tx_eqz(argv[1], "--write"))) {
        sy_eprintf("surface-gen\tusage\t--check|--write\n");
        return 2;
    }
    dowrite = tx_eqz(argv[1], "--write");
    sb = cx_read(STREAMS, &snb);
    if (!sb) return fail("stream-read");
    nb = cx_read(NETS, &nnb);
    if (!nb) return fail("net-read");
    if (parse_streams(sb, snb)) return 1;
    if (parse_nets(nb, nnb)) return 1;
    if (unique_names()) return 1;
    cn = emit_check(check, CHECKCAP);
    if (cn < 0) return fail("emit-check");
    rn = emit_rt_check(rtcheck, RTCHECKCAP);
    if (rn < 0) return fail("emit-rt-check");
    if (dowrite) {
        if (ensure_dir("cx/compiler/stream") || ensure_dir("cx/compiler/net")) return 1;
        if (ensure_dir("cx/runtime/stream")) return 1;
    }
    for (i = 0; i < ns; i++) {
        fn = emit_skel(file, FILECAP, srows[i].official, "sks");
        if (fn < 0) return fail("emit-stream");
        if (cx_fmt(path, sizeof path, "cx/compiler/stream/%s.cx", srows[i].official))
            return fail("path");
        if (one_file(dowrite, path, file, fn)) return 1;
    }
    for (i = 0; i < nn; i++) {
        fn = emit_skel(file, FILECAP, nrows_v[i].name, "skn");
        if (fn < 0) return fail("emit-net");
        if (cx_fmt(path, sizeof path, "cx/compiler/net/%s.cx", nrows_v[i].name))
            return fail("path");
        if (one_file(dowrite, path, file, fn)) return 1;
    }
    if (one_file(dowrite, "tools/check-cx-surface.cx", check, cn)) return 1;
    for (i = 0; i < ns; i++) {
        fn = emit_skel(file, FILECAP, srows[i].official, "rts");
        if (fn < 0) return fail("emit-runtime");
        if (cx_fmt(path, sizeof path, "cx/runtime/stream/%s.cx", srows[i].official))
            return fail("path");
        if (one_file(dowrite, path, file, fn)) return 1;
    }
    if (one_file(dowrite, "tools/check-cx-runtime-surface.cx", rtcheck, rn)) return 1;
    if (dowrite) sy_printf("SURFACE_GEN\tWROTE\tstreams=%d\tnets=%d\truntime_streams=%d\n", ns, nn, ns);
    else sy_printf("SURFACE_GEN\tCHECK\tstreams=%d\tnets=%d\truntime_streams=%d\n", ns, nn, ns);
    return 0;
}
