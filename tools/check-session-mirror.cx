/* tools/check-session-mirror.cx -- fixture tests for tools/session-mirror.cx (never touches ~/.claude).
 *
 *   sh ./unisacc.com tools/check-session-mirror.cx
 *
 * Builds SRC/MIRROR under $TMPDIR. Asserts hardlink, memory copy, no symlink mirror,
 * wipe+short-tail (inode != mirror) restore old+tail, longer-src restore whole,
 * prune spares src/gen-trap canary, mutant-skip-marker, mutant-prune-src red-under-mutation.
 * Ends with CHECK_SESSION_MIRROR. Uses cxlib.ckassert (ck) and cxlib.ckrun (ckk_sh_t/ckk_has). */
#pragma unisa use cxlib.ckassert
#pragma unisa use cxlib.ckrun
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sys.posix
#pragma unisa use text.text
#pragma unisa use mem.heap

static char out[1 << 16];

int main(void) {
    char root[1024], cwd[1024], cmd[4096], src[1100], mir[1100], dest[1100];
    sy_stat_t a, b; int rc;
    const char *td = sy_env("TMPDIR");
    if (!td || !td[0]) td = "/tmp";
    if (ckk_sh_t("check-session-mirror", "pwd", out, (int)sizeof out, 55) != 0) return 2;
    cx_fmt(cwd, sizeof cwd, "%s", out);
    { long n = tx_len(cwd, sizeof cwd); while (n > 0 && cwd[n - 1] == '\n') cwd[--n] = 0; }

    cx_fmt(cmd, sizeof cmd, "mktemp -d %s/session-mirror-check-XXXXXX", td);
    if (ckk_sh_t("check-session-mirror", cmd, out, (int)sizeof out, 55) != 0) return 2;
    cx_fmt(root, sizeof root, "%s", out);
    { long n = tx_len(root, sizeof root); while (n > 0 && root[n - 1] == '\n') root[--n] = 0; }
    if (cx_fmt(src, sizeof src, "%s/src", root) || cx_fmt(mir, sizeof mir, "%s/mir", root) ||
        cx_fmt(dest, sizeof dest, "%s/dest", root)) return 2;

    /* seed SRC */
    cx_fmt(cmd, sizeof cmd,
        "set -e; mkdir -p '%s/memory' '%s/sess1' '%s/gen-trap'; "
        "printf 'OLDSEG\\n' > '%s/chat.jsonl'; "
        "printf 'MEM1\\n' > '%s/memory/notes.txt'; "
        "printf 'S1\\n' > '%s/sess1/a.jsonl'; "
        "printf 'CANARY\\n' > '%s/gen-trap/canary.txt'; "
        "printf '1\\n' > '%s/gen-trap/.gen-stamp'; "
        "ln -s chat.jsonl '%s/link-chat.jsonl'",
        src, src, src, src, src, src, src, src, src);
    ck(ckk_sh_t("check-session-mirror", cmd, out, (int)sizeof out, 55) == 0, "fixture-seed");

    /* first run -> reset gen=1 */
    cx_fmt(cmd, sizeof cmd,
        "sh '%s/unisacc.com' '%s/tools/session-mirror.cx' -- --src '%s' --mirror '%s' run",
        cwd, cwd, src, mir);
    rc = ckk_sh_t("check-session-mirror", cmd, out, (int)sizeof out, 55);
    ck(rc == 0 && ckk_has(out, (int)sizeof out, "MIRROR_RESET") && ckk_has(out, (int)sizeof out, "gen=1"), "run-reset");

    /* hardlink same inode */
    cx_fmt(cmd, sizeof cmd, "%s/chat.jsonl", src);
    ck(sy_lstat(cmd, &a) == 0, "stat-src-chat");
    cx_fmt(cmd, sizeof cmd, "%s/gen-1/chat.jsonl", mir);
    ck(sy_lstat(cmd, &b) == 0, "stat-mir-chat");
    ck(a.dev == b.dev && a.ino == b.ino, "hardlink-inode");
    {
        char lp[1200]; sy_stat_t ls;
        cx_fmt(lp, sizeof lp, "%s/gen-1/link-chat.jsonl", mir);
        ck(sy_lstat(lp, &ls) != 0, "symlink-not-mirrored");
    }

    /* memory is a distinct inode (copy) */
    cx_fmt(cmd, sizeof cmd, "%s/memory/notes.txt", src);
    ck(sy_lstat(cmd, &a) == 0, "stat-src-mem");
    cx_fmt(cmd, sizeof cmd, "%s/gen-1/memory/notes.txt", mir);
    ck(sy_lstat(cmd, &b) == 0, "stat-mir-mem");
    ck(!(a.dev == b.dev && a.ino == b.ino) && a.size == b.size, "memory-copied");

    /* idempotent second run */
    cx_fmt(cmd, sizeof cmd,
        "sh '%s/unisacc.com' '%s/tools/session-mirror.cx' -- --src '%s' --mirror '%s' run",
        cwd, cwd, src, mir);
    rc = ckk_sh_t("check-session-mirror", cmd, out, (int)sizeof out, 55);
    ck(rc == 0 && !ckk_has(out, (int)sizeof out, "MIRROR_RESET") && ckk_has(out, (int)sizeof out, "reset=0"), "run-idempotent");

    /* wipe SRC, rebuild with short tail only */
    cx_fmt(cmd, sizeof cmd,
        "set -e; rm -rf '%s'; mkdir -p '%s'; printf 'T\\n' > '%s/chat.jsonl'",
        src, src, src);
    ck(ckk_sh_t("check-session-mirror", cmd, out, (int)sizeof out, 55) == 0, "wipe-rebuild-tail");
    {
        char sp[1200], mp[1200]; sy_stat_t ss, ms;
        cx_fmt(sp, sizeof sp, "%s/chat.jsonl", src);
        cx_fmt(mp, sizeof mp, "%s/gen-1/chat.jsonl", mir);
        ck(sy_lstat(sp, &ss) == 0 && sy_lstat(mp, &ms) == 0 &&
           !(ss.dev == ms.dev && ss.ino == ms.ino) && ss.size < ms.size, "wipe-inode-differs");
    }

    /* mutant: skip marker detect -> no MIRROR_RESET (wrong) */
    cx_fmt(cmd, sizeof cmd,
        "sh '%s/unisacc.com' '%s/tools/session-mirror.cx' -- --src '%s' --mirror '%s' --mutant-skip-marker run",
        cwd, cwd, src, mir);
    rc = ckk_sh_t("check-session-mirror", cmd, out, (int)sizeof out, 55);
    ck(rc == 0 && !ckk_has(out, (int)sizeof out, "MIRROR_RESET"), "mutant-skip-marker-no-reset");

    /* real run after wipe -> must RESET to gen=2 */
    cx_fmt(cmd, sizeof cmd,
        "sh '%s/unisacc.com' '%s/tools/session-mirror.cx' -- --src '%s' --mirror '%s' run",
        cwd, cwd, src, mir);
    rc = ckk_sh_t("check-session-mirror", cmd, out, (int)sizeof out, 55);
    ck(rc == 0 && ckk_has(out, (int)sizeof out, "MIRROR_RESET") && ckk_has(out, (int)sizeof out, "gen=2"), "wipe-detect-reset");

    /* restore merge: mirror longer than short SRC -> old||tail */
    cx_fmt(cmd, sizeof cmd,
        "set -e; rm -f '%s/gen-2/chat.jsonl'; printf 'OLDSEGMENT\\n' > '%s/gen-2/chat.jsonl'; "
        "printf 'TAIL\\n' > '%s/chat.jsonl'",
        mir, mir, src);
    ck(ckk_sh_t("check-session-mirror", cmd, out, (int)sizeof out, 55) == 0, "prep-restore");

    cx_fmt(cmd, sizeof cmd,
        "sh '%s/unisacc.com' '%s/tools/session-mirror.cx' -- --src '%s' --mirror '%s' restore '%s'",
        cwd, cwd, src, mir, dest);
    rc = ckk_sh_t("check-session-mirror", cmd, out, (int)sizeof out, 55);
    ck(rc == 0 && ckk_has(out, (int)sizeof out, "MIRROR_RESTORE"), "restore-rc");
    {
        unsigned char *b; int64_t n;
        char path[1200];
        cx_fmt(path, sizeof path, "%s/chat.jsonl", dest);
        ck(sy_read_file(path, &b, &n, 4096) >= 0 && b, "restore-read");
        if (b) {
            ck(n == 16 && b[0] == 'O' && b[10] == '\n' && b[11] == 'T', "restore-old-plus-tail");
            /* OLDSEGMENT\n (11) + TAIL\n (5) = 16 */
            mm_free(b);
        } else ck(0, "restore-old-plus-tail");
    }

    /* reverse: SRC longer than mirror -> restore takes SRC whole */
    {
        char dest2[1100]; unsigned char *b; int64_t n; char path[1200];
        cx_fmt(dest2, sizeof dest2, "%s/dest2", root);
        cx_fmt(cmd, sizeof cmd,
            "set -e; rm -f '%s/gen-2/chat.jsonl'; printf 'SHORT\\n' > '%s/gen-2/chat.jsonl'; "
            "printf 'LONGER_SOURCE_BODY\\n' > '%s/chat.jsonl'",
            mir, mir, src);
        ck(ckk_sh_t("check-session-mirror", cmd, out, (int)sizeof out, 55) == 0, "prep-longer-src");
        cx_fmt(cmd, sizeof cmd,
            "sh '%s/unisacc.com' '%s/tools/session-mirror.cx' -- --src '%s' --mirror '%s' restore '%s'",
            cwd, cwd, src, mir, dest2);
        rc = ckk_sh_t("check-session-mirror", cmd, out, (int)sizeof out, 55);
        ck(rc == 0 && ckk_has(out, (int)sizeof out, "MIRROR_RESTORE"), "restore-longer-rc");
        cx_fmt(path, sizeof path, "%s/chat.jsonl", dest2);
        ck(sy_read_file(path, &b, &n, 4096) >= 0 && b, "restore-longer-read");
        if (b) {
            ck(n == 19 && b[0] == 'L', "restore-longer-whole-src");
            mm_free(b);
        } else ck(0, "restore-longer-whole-src");
    }

    /* re-seed SRC gen-trap after wipe; normal prune must spare canary */
    cx_fmt(cmd, sizeof cmd,
        "set -e; mkdir -p '%s/gen-trap'; printf 'CANARY\\n' > '%s/gen-trap/canary.txt'; "
        "printf '1\\n' > '%s/gen-trap/.gen-stamp'",
        src, src, src);
    ck(ckk_sh_t("check-session-mirror", cmd, out, (int)sizeof out, 55) == 0, "reseed-gen-trap");
    cx_fmt(cmd, sizeof cmd,
        "sh '%s/unisacc.com' '%s/tools/session-mirror.cx' -- --src '%s' --mirror '%s' run",
        cwd, cwd, src, mir);
    rc = ckk_sh_t("check-session-mirror", cmd, out, (int)sizeof out, 55);
    ck(rc == 0, "run-after-trap");
    {
        char can[1200];
        cx_fmt(can, sizeof can, "%s/gen-trap/canary.txt", src);
        ck(sy_exists(can) == 1, "prune-spares-src-canary");
    }

    /* mutant prune-src deletes trap; prune-spares goes red if mutant is default */
    cx_fmt(cmd, sizeof cmd,
        "sh '%s/unisacc.com' '%s/tools/session-mirror.cx' -- --src '%s' --mirror '%s' --mutant-prune-src run",
        cwd, cwd, src, mir);
    rc = ckk_sh_t("check-session-mirror", cmd, out, (int)sizeof out, 55);
    {
        char can[1200];
        cx_fmt(can, sizeof can, "%s/gen-trap/canary.txt", src);
        ck(rc == 0 && sy_exists(can) != 1, "mutant-prune-src-deletes-trap");
    }

    /* status */
    cx_fmt(cmd, sizeof cmd,
        "sh '%s/unisacc.com' '%s/tools/session-mirror.cx' -- --src '%s' --mirror '%s' status",
        cwd, cwd, src, mir);
    rc = ckk_sh_t("check-session-mirror", cmd, out, (int)sizeof out, 55);
    ck(rc == 0 && ckk_has(out, (int)sizeof out, "MIRROR_STATUS"), "status-line");

    sy_remove_all(root);
    {
        int failed = ck_failures();
        int total = ck_assertions();
        printf("SESSION_MIRROR_SUMMARY\tfailed=%d\tpassed=%d\n", failed, total - failed);
        if (!failed) printf("CHECK_SESSION_MIRROR\n");
        return failed ? 1 : 0;
    }
}
