#pragma unisa use chrome_dom

/* R: staggered masonry, G: clustered watercolor grain, B: reserved. */
static const char path[]="ujs/practice/uxe/test/d3-masonry.rgba";
static unsigned char tile[64*64*4];
static unsigned char sky[160*90*4];
static const char sky_path[]="ujs/practice/uxe/test/d3-sky.rgba";
static unsigned char cloud_volume[160*90*4];
static const char volume_path[]="ujs/practice/uxe/test/d3-cloud-volume.rgba";
static unsigned char cloud_soft[160*90*4];
static const char soft_path[]="ujs/practice/uxe/test/d3-cloud-soft.rgba";
static unsigned char leaf[64*64*4];
static const char leaf_path[]="ujs/practice/uxe/test/d3-leaf.rgba";

static unsigned int grain(unsigned int x,unsigned int y) {
    unsigned int n=x*374761393u+y*668265263u;
    n=(n^(n>>13))*1274126177u;
    return (n^(n>>16))&255;
}

static int watercolor(int x,int y) {
    int gx=x/8, gy=y/8, fx=x%8, fy=y%8;
    int a=grain(gx,gy), b=grain((gx+1)%8,gy);
    int c=grain(gx,(gy+1)%8), d=grain((gx+1)%8,(gy+1)%8);
    return ((a*(8-fx)+b*fx)*(8-fy)+(c*(8-fx)+d*fx)*fy)/64;
}

static void generate(void) {
    int x,y;
    for(y=0;y<64;y++) for(x=0;x<64;x++) {
        int course=y/16, shifted=(x+16*(course%2))%64;
        int joint=shifted%32, row=y%16, stone=shifted/32;
        int fleck=grain(x,y)%13;
        int wash=watercolor(x,y);
        int k=(y*64+x)*4;
        int base=221+grain(stone,course)%22;
        int ragged=grain(x/4,y/4)%3==0;
        tile[k]=row==0 || joint==0 || (ragged && (row==1 || joint==1))
            ? 160+fleck : base+fleck;
        tile[k+1]=205+wash/8+fleck;
        tile[k+2]=255;
        tile[k+3]=255;
    }
}

static void generate_sky(unsigned char *pixels,int layered) {
    /* Lobes overlap in three banks. Their upper shoulders catch more light. */
    static int lobes[][4]={{-2,24,19,9},{12,23,18,10},{27,19,15,10},{42,26,20,8},
        {52,27,14,6},{100,9,23,6},{111,5,12,7},{122,12,15,5},
        {142,39,20,6},{154,36,12,9},{168,40,19,7}};
    int x,y,i;
    for(y=0;y<90;y++) for(x=0;x<160;x++) {
        int k=(y*160+x)*4, alpha=0, light=0;
        int clear[3]={66+y,126+y*3/4,184+y/2};
        int broad=watercolor(x%64,y%64)-128;
        int fine=watercolor((2*x+17)%64,(2*y+13)%64)-128;
        int grain_detail=grain(x,y)-128;
        for(i=0;i<11;i++) {
            int dx=x-lobes[i][0], dy=y-lobes[i][1], rx=lobes[i][2], ry=lobes[i][3];
            int inside=256-256*dx*dx/(rx*rx)-256*dy*dy/(ry*ry);
            int cover=inside*8;
            int shade=245-dy*52/ry;
            if(layered) {
                int density=inside+broad/4+fine/7+grain_detail/24;
                int exposure=221-dy*58/ry+broad/8+fine/13;
                cover=density*9;
                if(layered==2) {
                    int feather=96+broad/6;
                    int t=(density+24)*255/feather;
                    if(t<0) t=0;
                    if(t>255) t=255;
                    cover=t*t*(765-2*t)/(255*255);
                }
                if(exposure>=228) shade=251;
                else if(exposure>=214) shade=239;
                else if(exposure>=194) shade=218;
                else shade=187;
            }
            if(cover<0) cover=0;
            if(cover>255) cover=255;
            if(shade>251) shade=251;
            if(cover>0 && shade>light) light=shade;
            if(cover>alpha) alpha=cover;
        }
        for(i=0;i<3;i++) {
            int cloud=light-(2-i)*8;
            pixels[k+i]=(clear[i]*(255-alpha)+cloud*alpha+127)/255;
        }
        pixels[k+3]=255;
    }
}

static void generate_leaf(void) {
    int x,y;
    for(y=0;y<64;y++) for(x=0;x<64;x++) {
        int k=(y*64+x)*4;
        int end=abs(y-30), center=31+(y-30)/8;
        int teeth=abs(y%8-4)+abs((y+3)%13-6);
        int width=30-end*end/33-teeth;
        int distance=abs(x-center);
        int wash=watercolor(x,y);
        int shadow=y>31+(wash-128)/10+abs(x-24)/5;
        int gap=distance>width-7 && grain(x/3,y/4)<85;
        leaf[k]=shadow?185+wash/9:230+wash/11;
        leaf[k+1]=tile[k+1];
        leaf[k+2]=255;
        leaf[k+3]=width>0 && distance<width && !gap ? 255 : 0;
    }
}

static int output(const char *file_path,const unsigned char *pixels,size_t length,int write) {
    int ok;
    if(write) {
        FILE *file=fopen(file_path,"wb");
        if(!file) return 2;
        ok=fwrite(pixels,1,length,file)==length;
        if(fclose(file)) ok=0;
    } else {
        size_t size=0;
        char *disk=cx_read(file_path,&size);
        ok=disk && size==length && !memcmp(disk,pixels,length);
        if(disk) free(disk);
    }
    printf("GEN_D3_MASONRY\t%s\tbytes=%d\t%s\n",ok?"PASS":"FAIL",(int)length,file_path);
    return !ok;
}

int main(int argc,char **argv) {
    int write, masonry, clouds, foliage, volume, soft;
    if(argc!=2 || (strcmp(argv[1],"--write") && strcmp(argv[1],"--check"))) return 2;
    write=!strcmp(argv[1],"--write");
    generate();
    generate_sky(sky,0);
    generate_sky(cloud_volume,1);
    generate_sky(cloud_soft,2);
    generate_leaf();
    masonry=output(path,tile,sizeof tile,write);
    clouds=output(sky_path,sky,sizeof sky,write);
    foliage=output(leaf_path,leaf,sizeof leaf,write);
    volume=output(volume_path,cloud_volume,sizeof cloud_volume,write);
    soft=output(soft_path,cloud_soft,sizeof cloud_soft,write);
    return masonry || clouds || foliage || volume || soft;
}
