/* tools/s9-nightly.cx -- 私有克隆内按手册编排 s9,本工具不代替真跑资格。
 *
 *   sh ./unisacc.com tools/s9-nightly.cx -- ROOT RUN --tier commit|daily [--date YYYY-MM-DD] [--max-steps N] [--step-s S] [--fake SCRIPT]
 *
 * tier: commit -> init 带 "--tier commit";daily -> init 不带 --tier(s9-shards 只认 commit,缺省即全层)。
 *   sh ./unisacc.com tools/s9-nightly.cx -- ROOT --resume RUN [--tier T] [--date D] [--max-steps N] [--step-s S] [--fake SCRIPT]
 *
 * --resume RUN: 沿用已 init+prepare 的 RUN(须含 session.tsv),跳过 build/init/prepare,
 * 直接 step 直到非 PENDING -> retry UNKNOWN 片 -> aggregate;每个 step 仍自动设 UNISACC_BOUND_DEADLINE_MONO。
 * 报告写 s9-nightly-DATE-TIER-resume.md,不覆盖首跑报告;日志首行为 resume。
 * --date 缺省取当日(sy_wall_s + sy_local_fmt);--max-steps 缺省 4。每步记墙钟毫秒;日志超 8000 字节截断标 TRUNCATED。
 *
 * 子阶段(0.0.57,每次调用独立有界、可重复,调用方循环到非 PENDING):
 *   ROOT RUN --tier T --phase init                 薄入口依次运行下列同一帮手
 *   ROOT RUN --tier T --phase build-shards|build-waves 独立构造；build 依序薄入口
 *   ROOT RUN --tier T --phase build|map|init-session|prepare-1..6
 *   ROOT RUN --tier T --phase map-register-N       第N个材料登记(六prepare后；N从1起)
 *   ROOT RUN --tier T --phase map --map-family NAME 每材料族独立准备；全部族完成后 --phase map 聚合封口。
 * map封口在写map.intent前核全体IMPLEMENTED/SOURCE材料族，缺失/陈旧一次列全；未就绪不留map意图。
 * 已有map.intent但缺映射文件时具名NEW_RUN_REQUIRED，不重建、不猜成功；映射存在仍核原SHA与成功证据。
 * --map-controls 使用独立临时目录和合成登记/收据验证这些边界，不授产品资格。
 * RI F4b: 同一 ROOT/RUN/tier 依次调用 --phase map --map-family ri-flow-runtime
 * --material-stage source、compile、seal,再以 --map-family ri-flow-data
 * --material-stage data 准备数据。每次独立 50 秒预算,不走 affected 单次预算。
 * compile 仅记 COMPILED;seal 后才能以无 --material-stage 的对应族调用发布映射。
 * data 调用 flow-native prepare PRODUCT DATA;收据重放逐叶复核,不缓存 PASS。
 * 恢复协议：执行前 intent，成功后同会话 owned-outputs 证据，最后原子写 done。
 * done 丢失但输入、执行体及本相产物 SHA 全部核对一致时补写并记 RECOVERED；任一失配 REFUSE，不重造覆盖。
 * 旧协议只有产物而无成功证据时不追认；必须保留原拒绝。准备证据不是测试结论。
 * 每子相内部预算50s，收据绑定内容身份；相同输入核验后SKIP。材料族使用完整材料名精确匹配。
 * 显式子相须在编排源码树运行；跨cwd时 UNISACC_S9_NIGHTLY_SOURCE 指向实际编排源以核身份。
 * 94de54e70b将原spawn/drain两循环分别改成invoke，造成两套相同prepare；本次合并为一次。
 *   ROOT --resume RUN --phase steps [--max-steps N] 默认 1 步、每步 240s;仍有新片退出 3 status=PENDING,走完退出 0 STEPS_DONE
 *   ROOT --resume RUN --phase aggregate [--agg-parts N]  retry UNKNOWN 片,再 N(默认 4)片 aggregate --part K N(已有片记录跳过)+ --merge N
 * 缺省 --phase all 行为不变(含单次整体 aggregate;--agg-parts N 可在 all 里改用分片)。
 * 顺序: s9-native build -> init --tier T -> prepare checker, executor-all-waves,
 * executor-run-batch, executor, driver, selection -> step 直到非 PENDING -> aggregate。
 * --fake 用 SCRIPT 代替 s9-native/driver,供夹具验证顺序/超时/失败停止。
 */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.die
#pragma unisa use cxlib.limits
#pragma unisa use cxlib.s9map
#pragma unisa use cxlib.testplan
#pragma unisa use cxlib.allsession

static char root[4096], why[512];
static const char *fake;
static int pass_n, fail_n, notexec_n;
static char logbuf[8000];
static int logn, truncated;
static long last_ms;
static int step_s_cur; /* >0 仅在 step 调用期间设置 */
static const char *xa4, *xa5;
static void die(const char *a, const char *b) { tool_die("s9-nightly", a, b, 2); }
static int L_I(const char *id) { double v = lm_get(id, 0); if (v < 0) die("limit-unknown", id); return (int)v; }
/* 每行 "名称\t墙钟毫秒";超过上限(预留 16 字节给标记)则截断并记 TRUNCATED,不 die。 */
static void note(const char *s) {
    char line[256];
    int n;
    if (cx_fmt(line, sizeof line, "%s\t%ld", s, last_ms)) { truncated = 1; return; }
    n = (int)strlen(line);
    if (truncated || logn + n + 2 >= (int)sizeof logbuf - 16) {
        if (!truncated) {
            truncated = 1;
            if (tx_copy(logbuf + logn, (long)(sizeof logbuf - logn), "TRUNCATED\n", 10)) die("log", 0);
            logn += 10;
            logbuf[logn] = 0;
        }
        return;
    }
    if (tx_copy(logbuf + logn, (long)(sizeof logbuf - logn), line, n)) die("log", 0);
    logn += n;
    logbuf[logn++] = '\n';
    logbuf[logn] = 0;
}
/* A step that started but whose result was thrown away, because another step of the same phase failed.  It is
   never counted as PASS and its artifact is never reused: the line says so in the report. */
static void note_not_run(const char *s) {
    char line[256];
    int n;
    if (cx_fmt(line, sizeof line, "%s\t0\tNOT_RUN\n", s)) { truncated = 1; return; }
    n = (int)strlen(line);
    if (truncated || logn + n + 2 >= (int)sizeof logbuf - 16) { truncated = 1; return; }
    if (tx_copy(logbuf + logn, (long)(sizeof logbuf - logn), line, n)) die("log", 0);
    logn += n;
    logbuf[logn] = 0;
}
static char *step_env[2];
static char step_env_buf[96];
static int run_step(char **v, const char *cwd, int sec, np_result *r) {
    char **ev = 0;
    /* step 动词:子进程环境带 UNISACC_BOUND_DEADLINE_MONO=单调时钟(CLOCK_MONOTONIC)当前+step_s,与 s9-shards as_now 同源 */
    if (v[0] && step_s_cur > 0) {
        sy_ts_t t;
        if (sy_mono(&t) || cx_fmt(step_env_buf, sizeof step_env_buf, "UNISACC_BOUND_DEADLINE_MONO=%.9f", (double)t.sec + (double)t.nsec / 1e9 + step_s_cur)) die("deadline-env", 0);
        step_env[0] = step_env_buf;
        step_env[1] = 0;
        ev = step_env;
    }
    if (np_run(v, cwd, ev, sec, r, why, sizeof why)) {
        fprintf(stderr,"s9-nightly: transport %s\n",why); return 99;
    }
    return r->rc;
}
/* The s9 root is a frozen `git archive` tree (F). A batch material declared as
   NAME-tool:path is produced by tools/affected.cx --prepare-materials, whose
   cache lives under $HOME/.cache/unisacc/prep-cache, never in the repo out/.
   MAP is that NAME<TAB>/ABS/PATH table for `s9-shards init`; a material nothing
   can produce is reported on stderr and left out, so only the batches that
   declare it become NOT_AVAIL while the rest of their slice still runs. */
static char mapfile[16384];      /* the map's CONTENT, as the dump printed it */
static char mappath[4400];       /* the file that content was written to: init takes a path, not content */
static char s9run[4400];         /* the RUN directory, set once in main: the map file lives beside it */
static char why4[300];
static int map_budget;
static const char *map_family, *material_stage;
static const char *native_material_dir,*native_material_shards,*native_material_waves;
static int materials_map(char *map, long cap, char *why, int whycap) {
    char product[4400], tool[4400], *v[10];
    np_result r = {0};
    int k = 0, rc;
    if (cx_fmt(product, sizeof product, "%s/%s", root, "unisacc" ".com") ||
        cx_fmt(tool, sizeof tool, "%s/tools/affected.cx", root)) { cx_fmt(why, whycap, "path"); return 1; }
    /* Test seam, like tools/bound's UNISACC_BOUND_PS: a program standing in for the dump itself, so a check
       can exercise the reader against a dump no real tool would produce (one where every material is
       refused).  Unset -- the normal run -- the command line is exactly the same as before. */
    {   const char *seam = sy_env("UNISACC_S9_MATERIALS_DUMP_SEAM");
        if (seam && *seam) { v[k++] = (char *)seam; }   /* an executable standing in for the dump */
        else {
            v[k++] = "sh"; v[k++] = product; v[k++] = tool; v[k++] = "--";
            v[k++] = "--materials-dump"; v[k++] = "--prepare-materials";
            if (map_family) { v[k++] = "--family"; v[k++] = (char *)map_family; }
        }
    }
    v[k] = 0;
    rc = run_step(v, root, map_budget > 0 ? map_budget : L_I("s9.cmd"), &r);
    if (rc) { cx_fmt(why, whycap, "materials-dump rc=%d", rc); np_free(&r); return 1; }
    /* the format and the absolute-path rule live in one place, tools/cxlib/s9map.cx, so this reader and the
       check that asserts it cannot drift again.  An empty map is a failure, not a quiet full run: every
       material the batches declare was refused, which is exactly the state 0.0.67 reported as PASS. */
    if (s9_map_from_dump(r.out ? r.out : "", (long)r.outn, map, cap, why, whycap)) { np_free(&r); return 1; }
    if (!s9_map_rows()) { cx_fmt(why, whycap, "materials-map-empty refused=%ld", s9_map_refused()); np_free(&r); return 1; }
    np_free(&r);
    /* `s9-shards init` takes the map as a FILE PATH (all-waves reads argv[5]), not as its content.  The dump used
       to arrive as a zero-row map and '-', which is why this never showed: with a non-empty map the content went
       where a path belongs and every init was refused.  The file must live OUTSIDE RUN -- init refuses a session
       directory that already exists -- so it sits beside it as RUN.materials.tsv and its path is what init gets;
       a finished run keeps the map it was sealed against. */
    if (cx_fmt(mappath, sizeof mappath, "%s.materials.tsv", s9run)) { cx_fmt(why, whycap, "map-path"); return 1; }
    if (cx_write(mappath, map, (size_t)tx_len(map, (long)cap))) { cx_fmt(why, whycap, "map-write %s", mappath); return 1; }
    return 0;
}
static const char *save_to; /* 非空时 invoke 把子进程完整 stdout 写到该路径(不受 out 缓冲截断) */
/* Native images belong to this session's sidecar, migrated with the init receipts.
 * Each leaf has one total 50s construction bound; no nested two-image build.
 * Receipts bind current inputs AND image bytes, never a test result. */
static int init_identity(const char *tier, int mapped, char hex[65]);
/* 只在 init_one 的一次前/后测量窗口复用；绝不跨子相或执行边界。 */
static int identity_epoch, identity_ready;
static as_ident identity_live;
static const char *native_tier;
static int daily_no_candidate;
/* 原子持久化证据，缺失与内容失配严格区分。 */
static int evidence_file(const char *p,const char *body,int save) {
    char tmp[5000];size_t z;char *s;
    if(save){if(cx_fmt(tmp,sizeof tmp,"%s.pending-%ld",p,(long)getpid())||cx_write(tmp,body,strlen(body)))return -1;return rename(tmp,p);}
    if(sy_exists(p)!=1)return 0;
    s=as_read(p,0,&z,why,sizeof why);int ok=s&&z==strlen(body)&&!memcmp(s,body,z);free(s);
    if(!ok){cx_fmt(why,sizeof why,"REFUSE evidence-changed %s",p);return -1;}return 1;
}
/* A prepared directory is immutable: exactly two actual native images and a
 * seal binding their SHA256 values to this ROOT's complete current inputs.
 * Import creates this RUN's own receipts only after all bytes are verified. */
static int native_material_check(const char *identity,char hashes[2][65]){
    struct stat st;char p[5000],body[9000];const char *names[]={"shards.bin","waves.bin"};
    if(!native_material_dir||native_material_dir[0]!='/'||lstat(native_material_dir,&st)||!S_ISDIR(st.st_mode)){cx_fmt(why,sizeof why,"REFUSE native-material-directory");return -1;}
    DIR *d=opendir(native_material_dir);if(!d){cx_fmt(why,sizeof why,"REFUSE native-material-open");return -1;}int count=0,bad=0;
    for(;;){errno=0;struct dirent *e=readdir(d);if(!e){if(errno)bad=1;break;}if(!strcmp(e->d_name,".")||!strcmp(e->d_name,".."))continue;if(strcmp(e->d_name,names[0])&&strcmp(e->d_name,names[1])&&strcmp(e->d_name,"native-material.tsv"))bad=1;count++;}
    if(closedir(d))bad=1;if(bad||count!=3){cx_fmt(why,sizeof why,"REFUSE native-material-inventory");return -1;}
    for(int i=0;i<2;i++)if(cx_fmt(p,sizeof p,"%s/%s",native_material_dir,names[i])||as_sha_file(p,0,hashes[i],0,why,sizeof why)||sy_access(p,1)){cx_fmt(why,sizeof why,"REFUSE native-material-image name=%s",names[i]);return -1;}
    if(cx_fmt(body,sizeof body,"S9NATIVE-MATERIAL-v1\t%s\t%s\nshards\t%s\nwaves\t%s\n",root,identity,hashes[0],hashes[1])||cx_fmt(p,sizeof p,"%s/native-material.tsv",native_material_dir))return -1;
    if(evidence_file(p,body,0)!=1){cx_fmt(why,sizeof why,"REFUSE native-material-identity-or-sha");return -1;}return 0;
}
static int native_material_seal(const char *tier){
    char before[65],after[65],hashes[2][65],h[65],p[5000],body[9000];const char *sources[]={native_material_shards,native_material_waves},*names[]={"shards.bin","waves.bin"};
    identity_epoch=0;identity_ready=0;
    if(!native_material_dir||native_material_dir[0]!='/'||!sources[0]||!sources[1]||init_identity(tier,0,before))return -1;
    if(mkdir(native_material_dir,0700)){cx_fmt(why,sizeof why,"REFUSE native-material-new-directory-required");return -1;}
    for(int i=0;i<2;i++){
        size_t n;char *s=as_read(sources[i],0,&n,why,sizeof why);if(!s)return -1;
        if(n<64||memcmp(s,"\177ELF",4)||sy_access(sources[i],1)){free(s);cx_fmt(why,sizeof why,"REFUSE native-material-actual-executable name=%s",names[i]);return -1;}
        cx_sha256_hex(s,n,hashes[i]);int rc=cx_fmt(p,sizeof p,"%s/%s",native_material_dir,names[i])||cx_write(p,s,n)||chmod(p,0700);free(s);if(rc)return -1;
        if(as_sha_file(p,0,h,0,why,sizeof why)||strcmp(h,hashes[i])||as_sha_file(sources[i],0,h,0,why,sizeof why)||strcmp(h,hashes[i])){cx_fmt(why,sizeof why,"REFUSE native-material-copy-changed");return -1;}
    }
    identity_ready=0;if(init_identity(tier,0,after)||strcmp(before,after)){cx_fmt(why,sizeof why,"REFUSE native-material-input-changed");return -1;}
    if(cx_fmt(body,sizeof body,"S9NATIVE-MATERIAL-v1\t%s\t%s\nshards\t%s\nwaves\t%s\n",root,before,hashes[0],hashes[1])||cx_fmt(p,sizeof p,"%s/native-material.tsv",native_material_dir)||evidence_file(p,body,1)||native_material_check(before,hashes))return -1;
    printf("PREPARED\tnative-material-dir\tpath=%s\tno-test-result\n",native_material_dir);return 0;
}
static int native_image(int waves, int build, char bin[4800]) {
    char state[4600], inside[4600], rec[4840], source[4400], product[4400], done[4840],intent[4840];
    char input[65], after[65], hash[65], body[5000];
    const char *leaf = waves ? "build-waves" : "build-shards";
    size_t z; char *saved; int rc;
    long started = sy_now_ms();
    if (cx_fmt(state,sizeof state,"%s.nightly-init",s9run) ||
        cx_fmt(inside,sizeof inside,"%s/.nightly-init",s9run)) return -1;
    if (sy_exists(inside)==1 && cx_fmt(state,sizeof state,"%s",inside)) return -1;
    if (build && sy_exists(state)!=1 && mkdir(state,0700)) return -1;
    if (cx_fmt(bin,4800,"%s/%s.bin",state,leaf) || cx_fmt(rec,sizeof rec,"%s/%s.native",state,leaf) ||
        init_identity(native_tier,0,input)) return -1;
    if(cx_fmt(done,sizeof done,"%s/%s.done",state,leaf)||cx_fmt(intent,sizeof intent,"%s/%s.intent",state,leaf))return -1;
    char material_hash[2][65];if(native_material_dir&&!fake&&native_material_check(input,material_hash))return -1;
    if (sy_exists(rec)==1) {
        if(cx_fmt(body,sizeof body,"S9INTENT-v1\t%s\t%s\t%s\n",s9run,leaf,input)||evidence_file(intent,body,0)!=1)return -1;
        if (as_sha_file(bin,1,hash,0,why,sizeof why) || sy_access(bin,1)) return -1;
        if(native_material_dir&&!fake&&strcmp(hash,material_hash[waves?1:0])){cx_fmt(why,sizeof why,"REFUSE native-material-import-sha");return -1;}
        if (cx_fmt(body,sizeof body,"S9NATIVE-v2\t%s\t%s\t%s\n",s9run,input,hash)) return -1;
        saved=as_read(rec,0,&z,why,sizeof why);
        rc=saved && z==strlen(body) && !memcmp(saved,body,z); free(saved);
        if (!rc) { cx_fmt(why,sizeof why,"native-identity-changed %s",leaf); return -1; }
        int sealed=evidence_file(done,body,0);if(sealed<0)return -1;
        if(!sealed){if(evidence_file(done,body,1))return -1;printf("S9_INIT\tphase=%s\tstatus=RECOVERED\n",leaf);}
        else if(build)printf("S9_INIT\tphase=%s\tstatus=SKIP\n",leaf);
        return 0;
    }
    if (!build) { cx_fmt(why,sizeof why,"missing-native %s",leaf); return -1; }
    if(sy_exists(bin)==1){cx_fmt(why,sizeof why,"REFUSE native-success-evidence-missing %s",leaf);return -1;}
    if(cx_fmt(body,sizeof body,"S9INTENT-v1\t%s\t%s\t%s\n",s9run,leaf,input)||evidence_file(intent,body,1))return -1;
    np_result r={0};
    if(native_material_dir&&!fake){
        char p[5000];if(cx_fmt(p,sizeof p,"%s/%s.bin",native_material_dir,waves?"waves":"shards"))return -1;
        saved=as_read(p,0,&z,why,sizeof why);if(!saved)return -1;cx_sha256_hex(saved,z,hash);
        if(strcmp(hash,material_hash[waves?1:0])){free(saved);cx_fmt(why,sizeof why,"REFUSE native-material-read-sha");return -1;}
        rc=cx_write(bin,saved,z);free(saved);if(!rc)rc=chmod(bin,0700);
    } else if(fake) {
        char *v[]={(char *)fake,"build",root,s9run,(char *)leaf,0};
        int left=(int)((49000-(sy_now_ms()-started))/1000);
        rc=left>0?run_step(v,root,left,&r):124;
        if(!rc) { saved=as_read(fake,1,&z,why,sizeof why); if(!saved)rc=-1;
            else {rc=cx_write(bin,saved,z);free(saved);if(!rc)rc=chmod(bin,0700);} }
    } else {
        if(cx_fmt(source,sizeof source,"%s/tools/%s.cx",root,waves?"all-waves":"s9-shards") ||
            cx_fmt(product,sizeof product,"%s/unisacc.com",root)) return -1;
        char *v[]={"sh",product,source,"-o",bin,0};
        int left=(int)((49000-(sy_now_ms()-started))/1000);
        rc=left>0?run_step(v,root,left,&r):124;
    }
    if(r.errn)fwrite(r.err,1,r.errn,stderr);
    if(r.residue)rc=rc?rc:1;
    np_free(&r);
    if(rc || sy_now_ms()-started>=50000) return rc?rc:124;
    identity_ready=0;
    if(init_identity(native_tier,0,after)||strcmp(input,after)||as_sha_file(bin,1,hash,0,why,sizeof why)||sy_access(bin,1))return -1;
    if(sy_now_ms()-started>=50000)return 124;
    if(cx_fmt(body,sizeof body,"S9NATIVE-v2\t%s\t%s\t%s\n",s9run,input,hash)||evidence_file(rec,body,1))return -1;
    if(evidence_file(done,body,1))return -1;
    printf("S9_INIT\tphase=%s\tstatus=DONE\n",leaf);return 0;
}
static int native_exec(char bin[4800]) {
    char waves[4800];
    if(native_image(0,0,bin)||native_image(1,0,waves))return -1;
    if(sy_setenv("UNISACC_ALL_WAVES_NATIVE",waves,1)||sy_setenv("S9_ALLWAVES_ELF",waves,1))return -1;
    return 0;
}
static int invoke(const char *verb, const char *a1, const char *a2, const char *a3, int sec, char *out, int ocap) {
    char tool[4800];
    char *v[16];
    int k = 0, rc;
    long t0 = sy_now_ms();
    np_result r = {0};
    if (fake) {
        v[k++] = (char *)fake;
        v[k++] = (char *)verb;
        if (a1) v[k++] = (char *)a1;
        if (a2) v[k++] = (char *)a2;
        if (a3) v[k++] = (char *)a3;
        if (xa4) v[k++] = (char *)xa4;
        if (xa5) v[k++] = (char *)xa5;
        v[k] = 0;
        rc = run_step(v, root, sec, &r);
    } else {
        if (native_exec(tool)) return -1;
        v[k++] = tool;
        v[k++] = (char *)verb;
        if (a1) v[k++] = (char *)a1;
        if (a2) v[k++] = (char *)a2;
        if (a3) v[k++] = (char *)a3;
        if (xa4) v[k++] = (char *)xa4;
        if (xa5) v[k++] = (char *)xa5;
        v[k] = 0;
        rc = run_step(v, root, sec, &r);
    }
    last_ms = sy_now_ms() - t0;
    if (rc) {
        if (r.out && r.outn) fwrite(r.out,1,r.outn,stderr);
        if (r.err && r.errn) fwrite(r.err,1,r.errn,stderr);
    }
    if (save_to) { if (cx_write(save_to, r.out ? r.out : "", r.out ? r.outn : 0)) die("save-stdout", save_to); }
    if (out && ocap > 0) {
        size_t n = r.outn < (size_t)(ocap - 1) ? r.outn : (size_t)(ocap - 1);
        if (r.out && n && mm_copy(out, ocap, r.out, (long)n)) { np_free(&r); die("copy", 0); }
        out[n] = 0;
    }
    np_free(&r);
    return rc;
}
/* A phase of independent children at once (Q1).  Each child gets its own capture buffer, so nothing here
   touches last_ms/save_to/xa4 and the report shape is unchanged.  The children of one phase write different
   files (prepare NAME writes its own artifact, aggregate --part K N its own agg-part-K-N), so only starting
   and draining is serial.  A child not yet drained blocks on write when its 64 KiB pipe fills; every phase's
   per-child output is a few lines, far below that. */
typedef struct { const char *name; int pid, fd, deadline_s; long t0; np_buf out; } ParJob;
/* NP_BUF, not NP_RESULT: np_free takes the latter and would run off the end of this struct. */
static void par_free(ParJob *j) { free(j->out.p); j->out.p = 0; j->out.n = j->out.cap = 0; }
/* DEADLINE_S is the child's own bound, enforced by par_drain (kill its group and rc 124): it is carried here so
   the spawn and the wait agree on one number, and so the spawn block itself names the bound it is under. */
static int par_spawn(ParJob *j, const char *verb, const char *a1, const char *a2, const char *a3, const char *a4, const char *a5, int deadline_s) {
    char tool[4800];
    char *v[16];
    int k = 0;
    j->pid = 0; j->fd = -1; j->out.p = 0; j->out.n = 0; j->out.cap = 0; j->t0 = sy_now_ms(); j->deadline_s = deadline_s;
    if (fake) {
        v[k++] = (char *)fake; v[k++] = (char *)verb;
        if (a1) v[k++] = (char *)a1;
        if (a2) v[k++] = (char *)a2;
        if (a3) v[k++] = (char *)a3;
        if (a4) v[k++] = (char *)a4;
        if (a5) v[k++] = (char *)a5;
    } else {
        if (native_exec(tool)) return -1;
        v[k++] = tool; v[k++] = (char *)verb;
        if (a1) v[k++] = (char *)a1;
        if (a2) v[k++] = (char *)a2;
        if (a3) v[k++] = (char *)a3;
        if (a4) v[k++] = (char *)a4;
        if (a5) v[k++] = (char *)a5;
    }
    v[k] = 0;
    j->pid = sy_spawn_pipe(v, root, 0, &j->fd, 0);
    if (j->pid <= 0) { j->pid = 0; j->fd = -1; return -1; }
    return 0;
}
/* Drain one child: its whole stdout+stderr into J->out, then its exit code in *RC (128+sig when signalled).
   SEC bounds the child: past it the child's process group is killed and *RC is 124, so one hung child cannot
   hold the phase (and the caller's 55 s budget) open. */
static int par_drain(ParJob *j, int *rc) {
    int sec = j->deadline_s;   /* the bound the spawn was given: one number, no second guess here */
    char chunk[4096]; int ex = 0, code = 0, sig = 0, w;
    for (;;) {
        long r;
        (void)sy_sleep_ms(20);   /* a phase has at most six children: no busy loop, no poll when its type is not visible */
        r = sy_read(j->fd, chunk, sizeof chunk);
        if (r > 0) { np_put(&j->out, chunk, (size_t)r); continue; }
        w = sy_wait_status(j->pid, 1, &ex, &code, &sig);
        if (w == j->pid) break;
        if (w < 0) { sy_close(j->fd); j->fd = -1; j->pid = 0; last_ms = sy_now_ms() - j->t0; return -1; }
        if (sec > 0 && sy_now_ms() - j->t0 > (long)sec * 1000L) {
            (void)sy_kill(j->pid);          /* its own group: the child and whatever it started */
            sy_close(j->fd); j->fd = -1; j->pid = 0;
            last_ms = sy_now_ms() - j->t0;
            *rc = 124;
            return 0;
        }
    }
    for (;;) {   /* the child is gone: whatever is still buffered in its pipe is its last words */
        long r = sy_read(j->fd, chunk, sizeof chunk);
        if (r > 0) { np_put(&j->out, chunk, (size_t)r); continue; }
        if (r == -EINTR || r == -EAGAIN) continue;
        break;
    }
    sy_close(j->fd); j->fd = -1;
    last_ms = sy_now_ms() - j->t0;
    *rc = ex ? code : 128 + sig;
    return 0;
}
/* 步终态只凭 s9-shards step 的显式信号(0.0.68):STEP_FINISHED 行表示没有未发片也没有活片;
 * STEP_NO_PROGRESS 行或退出码 4 表示仍有待跑片而本步一片未发。输出里有没有 S9_WT 行不再用于判断完成。 */
static int step_finished(const char *s) {
    return s && strstr(s, "S9\tSTEP_FINISHED") != 0;
}
static int step_no_progress(const char *s, int rc) {
    return rc == 4 || (s && strstr(s, "S9\tSTEP_NO_PROGRESS") != 0);
}
/* 数 RUN 下 *.start 与 *.done;unk 收集有 start 无 done 的片名(最多 64 个)。 */
static char unk[64][96];
static int scan_run(const char *runp, int *starts, int *dones) {
    DIR *d = opendir(runp);
    struct dirent *e;
    int nu = 0;
    *starts = *dones = 0;
    if (!d) return 0;
    while ((e = readdir(d))) {
        size_t z = strlen(e->d_name);
        if (z > 6 && !strcmp(e->d_name + z - 6, ".start")) {
            char dn[4400], dp[4400];
            (*starts)++;
            if (cx_fmt(dn, sizeof dn, "%.*s.done", (int)(z - 6), e->d_name) || cx_fmt(dp, sizeof dp, "%s/%s", runp, dn)) continue;
            if (sy_exists(dp) != 1 && nu < 64 && z - 6 < sizeof unk[0]) {
                if (mm_copy(unk[nu], (long)sizeof unk[nu], e->d_name, (long)(z - 6))) continue;
                unk[nu][z - 6] = 0;
                nu++;
            }
        } else if (z > 5 && !strcmp(e->d_name + z - 5, ".done")) (*dones)++;
    }
    closedir(d);
    return nu;
}
static void write_report(const char *path, const char *status) {
    char body[9000];
    int n;
    n = snprintf(body, sizeof body,
                 "s9-nightly\nstatus\t%s\npass\t%d\nfail\t%d\nnot_executed\t%d\ntruncated\t%d\nlog\tname\twall_ms\n%s",
                 status, pass_n, fail_n, notexec_n, truncated, logbuf);
    if (n < 0 || n >= (int)sizeof body) die("report-bound", 0);
    if (cx_write(path, body, (size_t)n)) die("write", path);
}
/* 初始化收据只缓存构造，不缓存任何测试结论。调用方 cwd 必须是本工具源码树。
 * build -> map -> init-session -> prepare-1..6；每次显式子相只运行一相。
 * RUN 不存在时用 RUN.nightly-init (0700)，init 后原子迁入 RUN/.nightly-init。
 * 每相前后重新读取内容身份；身份不符硬拒绝，不能把旧构造算作成功。 */
static const char *init_names[] = {"build", "map", "init-session", "prepare-1", "prepare-2", "prepare-3", "prepare-4", "prepare-5", "prepare-6"};
static const char *init_name(int n) {
    static char material[48];
    if(n<9)return init_names[n];
    if(cx_fmt(material,sizeof material,"map-register-%d",n-8))die("phase-name",0);
    return material;
}
static const char *init_preps[] = {"checker", "executor-all-waves", "executor-run-batch", "executor", "driver", "selection"};
static char init_state[4600], init_side[4600];
static long init_t0;
static int init_left(void) {
    long left = 50000 - (sy_now_ms() - init_t0);
    return left > 0 ? (int)(left / 1000) : 0;
}
static int init_identity(const char *tier, int mapped, char hex[65]) {
    as_ident id; char own[65], mh[65], fh[65], body[8192];
    if (identity_epoch && identity_ready) id=identity_live;
    else if (fake) {
        static const char *trees[] = {"tests", "tools", "cx", "src", "seed"};
        np_buf b = {0}; char p[4400], h[65]; int i;
        memset(&id, 0, sizeof id);
        for (i = 0; i < 5; i++) {
            if (as_join(p, sizeof p, root, trees[i])) { free(b.p); return -1; }
            if (sy_exists(p) == 1) {
                if (as_tree(p, 1, h, 0, why, sizeof why)) { free(b.p); return -1; }
                np_puts(&b, trees[i]); np_puts(&b, h);
            }
        }
        cx_sha256_hex(b.p ? b.p : "", b.n, id.harness); free(b.p);
        if (as_join(p, sizeof p, root, "unisacc.com")) return -1;
        if (sy_exists(p) == 1 && as_sha_file(p, 1, id.candidate, 0, why, sizeof why)) return -1;
    } else if (as_identity(root, 1, &id, why, sizeof why)) return -1;
    if(identity_epoch&&!identity_ready){identity_live=id;identity_ready=1;}
    { const char *source=sy_env("UNISACC_S9_NIGHTLY_SOURCE");
      if (as_sha_file(source&&*source?source:"tools/s9-nightly.cx",1,own,0,why,sizeof why)) return -1; }
    cx_sha256_hex("", 0, mh); cx_sha256_hex("", 0, fh);
    if (mapped && as_sha_file(mappath, 0, mh, 0, why, sizeof why)) return -1;
    if (fake && as_sha_file(fake, 1, fh, 0, why, sizeof why)) return -1;
    if (cx_fmt(body, sizeof body, "S9INIT-v1\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n",
        root, tier, id.candidate_kind, id.candidate, id.legacy_candidate,
        id.registry, id.sid, id.harness, own, mh, fake ? fake : "-", fh)) return -1;
    if(daily_no_candidate){np_buf scoped={0};np_puts(&scoped,body);np_puts(&scoped,"scope=daily-no-candidate\n");cx_sha256_hex(scoped.p,scoped.n,hex);free(scoped.p);}
    else cx_sha256_hex(body, strlen(body), hex); return 0;
}
static int init_receipt(int n, const char *identity, int write_it) {
    char p[4800], pending[4840], body[256]; size_t z; char *saved; int ok;
    if (cx_fmt(p, sizeof p, "%s/%s.done", init_state, init_name(n)) ||
        cx_fmt(body, sizeof body, "S9INIT-v1\t%s\t%s\n", init_name(n), identity)) return -1;
    if (write_it) {
        if (cx_fmt(pending, sizeof pending, "%s.pending-%ld", p, (long)getpid()) || cx_write(pending, body, strlen(body))) return -1;
        return rename(pending, p);
    }
    if (sy_exists(p) != 1) return 0;
    saved = as_read(p, 0, &z, why, sizeof why); if (!saved) return -1;
    ok = z == strlen(body) && !memcmp(saved, body, z); free(saved);
    if (!ok) { cx_fmt(why, sizeof why, "identity-changed %s", init_name(n)); return -1; }
    return 1;
}
/* 一个材料一相，避免登记持有同一会话写锁的子进程并发。 */
static int init_material_count(void) {
    size_t z, i; int n = 0; char *s = as_read(mappath, 0, &z, why, sizeof why);
    if (!s) return -1;
    for (i = 0; i < z; i++) if (s[i] == '\n') n++;
    free(s); return n;
}
static int init_materials(int wanted, const char *run, char *out, int cap) {
    size_t z; char *s = as_read(mappath, 0, &z, why, sizeof why), *at;
    int rc = -1, row = 0;
    if (!s) return -1;
    at = s;
    while (*at) {
        char *end = strchr(at, '\n'), *tab = strchr(at, '\t');
        if (!end || !tab || tab > end) break;
        if (row++ == wanted) {
            *tab = 0; xa4 = at;
            rc = init_left() < 1 ? 124 : invoke("prepare", root, run, "material", init_left(), out, cap);
            xa4 = 0; break;
        }
        at = end + 1;
    }
    free(s); return rc;
}
/* F4b: each invocation executes at most one producer stage. Material paths
 * stay beside RUN, since init moves its bookkeeping directory into RUN. */
static const char *ri_names[]={"source","compile","seal","data"};
static int ri_family(const char *name){return name&&(!strcmp(name,"ri-flow-runtime")||!strcmp(name,"ri-flow-data"));}
static int ri_paths(const char *run,char base[4600],char mat[4800],char data[4800]){
 return cx_fmt(base,4600,"%s.ri-flow-materials",run)||cx_fmt(mat,4800,"%s/runtime",base)||cx_fmt(data,4800,"%s/data",base);
}
static int ri_exists(const char *p){struct stat st;errno=0;if(!lstat(p,&st))return 1;if(errno==ENOENT)return 0;cx_fmt(why,sizeof why,"REFUSE ri-path-stat errno=%d",errno);return -1;}
static int ri_stage_path(const char *run,int k,const char *suffix,char p[5000]){
 return cx_fmt(p,5000,"%s.ri-flow-materials/%s.%s",run,ri_names[k],suffix);
}
static int ri_outputs(const char *run,int k,char hash[65]){
 char base[4600],mat[4800],data[4800],p[5000],h[65];np_buf b={0};
 const char *leaves[]={"runtime.c","material.tsv","flow-native","flow-native.pending.tsv","flow-native.tsv"};int count=k==0?2:k==1?4:5;
 if(ri_paths(run,base,mat,data))return -1;
 for(int i=0;i<count;i++){if(cx_fmt(p,sizeof p,"%s/%s",mat,leaves[i])||as_sha_file(p,0,h,0,why,sizeof why)){free(b.p);return -1;}np_puts(&b,leaves[i]);np_puts(&b,"\t");np_puts(&b,h);np_puts(&b,"\n");}
 if(k==3){if(as_tree(data,1,h,0,why,sizeof why)){free(b.p);return -1;}np_puts(&b,"data\t");np_puts(&b,h);np_puts(&b,"\n");}
 cx_sha256_hex(b.p,b.n,hash);free(b.p);return 0;
}
static const char *ri_inputs[]={"exec/c/run.c","exec/c/core.c","exec/c/core.h","exec/c/codec.h","exec/c/packagefooter.h","exec/c/resourceledger.h","include/unisa_sha256.h","tools/ri-material.cx","tests/cases/ri-flow.cx"};
static int ri_closure(char hash[65]){
 np_buf b={0};char p[4800],h[65];
 for(int i=0;i<9;i++){
  if(cx_fmt(p,sizeof p,"%s/%s",root,ri_inputs[i])){free(b.p);return -1;}
  struct stat st;errno=0;if(lstat(p,&st)){if(errno!=ENOENT||cx_fmt(p,sizeof p,"%s/archive/reference-c/%s",root,ri_inputs[i])){free(b.p);return -1;}}
  if(as_sha_file(p,0,h,0,why,sizeof why)){free(b.p);return -1;}np_puts(&b,ri_inputs[i]);np_puts(&b,"\t");np_puts(&b,h);np_puts(&b,"\n");
 }
 cx_sha256_hex(b.p,b.n,hash);free(b.p);return 0;
}
static int ri_receipt(const char *run,const char *identity,int k,int write_it){
 char p[5000],h[65],closure[65],body[6000];if(ri_closure(closure)||ri_outputs(run,k,h)||ri_stage_path(run,k,"done",p)||cx_fmt(body,sizeof body,"S9RI-v1\t%s\t%s\t%s\t%s\t%s\t%s\n",run,identity,ri_names[k],k==1?"COMPILED":"PREPARED",h,closure))return -1;
 return evidence_file(p,body,write_it);
}
static int ri_ready(const char *run,const char *identity,int upto){
 for(int i=0;i<=upto;i++){char p[5000];if(ri_stage_path(run,i,"intent",p)||evidence_file(p,identity,0)!=1||ri_receipt(run,identity,i,0)!=1){cx_fmt(why,sizeof why,"REFUSE ri-stage-required stage=%s action=RUN_MATERIAL_STAGE",ri_names[i]);return -1;}}
 return 0;
}
static int ri_stage_state(const char *run,const char *identity,int k){
 char p[5000];if(ri_stage_path(run,k,"intent",p))return -1;int intent=evidence_file(p,identity,0);if(intent<0)return -1;
 if(intent==1){if(ri_receipt(run,identity,k,0)==1)return 1;cx_fmt(why,sizeof why,"REFUSE ri-stage-interrupted stage=%s action=NEW_RUN_REQUIRED",ri_names[k]);return -1;}
 if(ri_stage_path(run,k,"done",p))return -1;int present=ri_exists(p);if(present<0)return -1;if(present){cx_fmt(why,sizeof why,"REFUSE ri-stage-orphan-receipt stage=%s action=NEW_RUN_REQUIRED",ri_names[k]);return -1;}return 0;
}
static int ri_stage(const char *run,const char *tier,const char *stage){
 int k=-1;for(int i=0;i<4;i++)if(!strcmp(stage,ri_names[i]))k=i;if(k<0){cx_fmt(why,sizeof why,"REFUSE ri-stage name must be source|compile|seal|data");return 2;}
 if(!map_family||strcmp(map_family,k==3?"ri-flow-data":"ri-flow-runtime")){cx_fmt(why,sizeof why,"REFUSE ri-stage-family-mismatch");return 2;}
 char base[4600],mat[4800],data[4800],product[4800],tool[4800],p[5000],identity[65],after[65];
 init_t0=sy_now_ms();identity_epoch=0;identity_ready=0;
 char closure_before[65],closure_after[65];
 if(ri_paths(run,base,mat,data)||init_identity(tier,0,identity)||ri_closure(closure_before))return 1;
 int exists=ri_exists(base);if(exists<0)return 1;if(!exists&&mkdir(base,0700))return 1;
 {struct stat st;if(lstat(base,&st)||!S_ISDIR(st.st_mode)){cx_fmt(why,sizeof why,"REFUSE ri-material-base-kind");return 1;}}
 if(k&&ri_ready(run,identity,k-1))return 1;
 int state=ri_stage_state(run,identity,k);if(state<0)return 1;
 if(state==1){printf("S9_RI_STAGE\tstage=%s\tstatus=%s\treuse=verified-material-only\n",stage,k==1?"COMPILED":"PREPARED");return 0;}
 if(cx_fmt(product,sizeof product,"%s/unisacc.com",root))return 1;
 if(k==3){char canonical[4800];if(!realpath(product,canonical)||cx_fmt(product,sizeof product,"%s",canonical))return 1;}
 char *v[12];int n=0;
 if(k==3){if(cx_fmt(tool,sizeof tool,"%s/flow-native",mat))return 1;v[n++]=tool;v[n++]="prepare";v[n++]=product;v[n++]=data;}
 else{if(cx_fmt(tool,sizeof tool,"%s/tools/%s",root,k==0?"ri-material.cx":"ri-flow-material.cx"))return 1;v[n++]="sh";v[n++]=product;v[n++]=tool;v[n++]="--";if(k)v[n++]=(char*)stage;v[n++]=root;v[n++]=mat;if(!k)v[n++]="tests/cases/ri-flow.cx";}
 v[n]=0;
 if(ri_stage_path(run,k,"intent",p)||evidence_file(p,identity,1))return 1;
 np_result r={0};int seconds=init_left();if(seconds<1)return 124;int rc=run_step(v,root,seconds,&r);
 if(ri_stage_path(run,k,"stdout",p)||cx_write(p,r.out?r.out:"",r.outn)||ri_stage_path(run,k,"stderr",p)||cx_write(p,r.err?r.err:"",r.errn)){np_free(&r);return 1;}
 char result[160];if(cx_fmt(result,sizeof result,"rc\t%d\nresidue\t%d\n",rc,r.residue)||ri_stage_path(run,k,"status",p)||cx_write(p,result,strlen(result))){np_free(&r);return 1;}
 if(r.outn)fwrite(r.out,1,r.outn,stdout);if(r.errn)fwrite(r.err,1,r.errn,stderr);
 if(rc||r.residue){np_free(&r);cx_fmt(why,sizeof why,"REFUSE ri-stage-producer stage=%s rc=%d action=NEW_RUN_REQUIRED",stage,rc);return rc?rc:1;}np_free(&r);
 identity_ready=0;if(init_identity(tier,0,after)||strcmp(identity,after)||ri_closure(closure_after)||strcmp(closure_before,closure_after)){cx_fmt(why,sizeof why,"REFUSE ri-stage-input-changed action=NEW_RUN_REQUIRED");return 1;}
 if(ri_receipt(run,identity,k,1))return 1;
 printf("S9_RI_STAGE\tstage=%s\tstatus=%s\treuse=no\n",stage,k==1?"COMPILED":"PREPARED");return 0;
}
static int ri_dump(const char *run,const char *identity,const char *family,np_buf *wire){
 if(ri_ready(run,identity,!strcmp(family,"ri-flow-data")?3:2))return 1;
 char base[4600],mat[4800],data[4800];if(ri_paths(run,base,mat,data))return 1;const char *value=!strcmp(family,"ri-flow-data")?data:mat;
 as_registry r;if(as_registry_load(root,&r,why,sizeof why))return 1;int count=0;
 for(int i=0;i<r.nb;i++){if(strcmp(r.b[i].impl,"IMPLEMENTED")||strcmp(r.b[i].mode,"SOURCE"))continue;const char *at=r.b[i].materials;tp_material_decl d;int next;
  while((next=tp_material_next(&at,&d))>0)if(!strcmp(d.name,family)){if(d.kind!=1){as_registry_free(&r);return 1;}np_puts(wire,"MATERIAL\t");np_puts(wire,r.b[i].id);np_puts(wire,"\t");np_puts(wire,family);np_puts(wire,"\t");np_puts(wire,value);np_puts(wire,"\n");count++;}
  if(next<0){as_registry_free(&r);return 1;}
 }
 as_registry_free(&r);return count?0:1;
}
static char map_families[256][128];
static char map_planned[256][128];
static int map_planned_n;
static int map_family_admitted(const as_batch *b,const tp_material_decl *d) {
    if(strcmp(b->impl,"IMPLEMENTED"))return 0;
    if(!strcmp(b->mode,"SOURCE"))return 1;
    return !strcmp(b->mode,"PREPARED")&&!strcmp(b->id,"assembler")&&d->kind==1&&!strcmp(d->name,"assembler");
}
static int map_families_load(void) {
    as_registry r; int n=0; map_planned_n=0;
    if(as_registry_load(root,&r,why,sizeof why)) return -1;
    for(int i=0;i<r.nb;i++) {
        const char *at=r.b[i].materials; tp_material_decl d; int rc;
        while((rc=tp_material_next(&at,&d))>0) {
            if(!map_family_admitted(&r.b[i],&d))continue;
            int j; for(j=0;j<n&&strcmp(map_families[j],d.name);j++) {}
            if(j==n) { if(n==256||cx_fmt(map_families[n],sizeof map_families[n],"%s",d.name)) {as_registry_free(&r);return -1;} n++; }
        }
        if(rc<0) {as_registry_free(&r);return -1;}
    }
    for(int i=0;i<r.nb;i++) {
        const char *at=r.b[i].materials;tp_material_decl d;int rc;
        while((rc=tp_material_next(&at,&d))>0) {
            if(map_family_admitted(&r.b[i],&d))continue;
            int j;for(j=0;j<n&&strcmp(map_families[j],d.name);j++){}
            if(j<n)continue;
            for(j=0;j<map_planned_n&&strcmp(map_planned[j],d.name);j++){}
            if(j==map_planned_n) {
                if(map_planned_n==256||cx_fmt(map_planned[map_planned_n],sizeof map_planned[0],"%s",d.name)){as_registry_free(&r);return -1;}
                map_planned_n++;
            }
        }
        if(rc<0){as_registry_free(&r);return -1;}
    }
    for(int i=0;i<map_planned_n;i++)printf("S9_MAP_FAMILY\tname=%s\timplementation=PLANNED\tstatus=not_applicable\n",map_planned[i]);
    printf("S9_MAP_SUMMARY\timplemented=%d\tnot_applicable=%d\ttotal=%d\n",n,map_planned_n,n+map_planned_n);
    as_registry_free(&r); return n;
}
/* A family receipt binds both its immutable input identity and exact dump bytes.
 * Sealing reads every declared family, including explicit refusals, before making MAP. */
/* Pure read pass: validate every required family before a map intent can be
 * written. A refused dump is still family evidence, never a batch PASS. */
static int map_collect_families(const char *run,const char *state,const char *identity,int count,np_buf *all) {
    np_buf missing={0};int bad=0;
    for(int i=0;i<count;i++) {
        char p[4800],receipt[4840],intent[4840],hash[65],want[5000];size_t n=0,rn=0;
        if(cx_fmt(p,sizeof p,"%s/family-%s.dump",state,map_families[i])||
           cx_fmt(receipt,sizeof receipt,"%s.sha",p)||cx_fmt(intent,sizeof intent,"%s.intent",p)){free(missing.p);return -1;}
        char *dump=cx_read(p,&n),*saved=cx_read(receipt,&rn);int valid=0;
        if(dump&&saved) {
            cx_sha256_hex(dump,n,hash);
            if(cx_fmt(want,sizeof want,"S9FAMILY-v2\t%s\t%s\t%s\n",run,identity,hash)){free(dump);free(saved);free(missing.p);return -1;}
            valid=rn==strlen(want)&&!memcmp(saved,want,rn)&&evidence_file(intent,identity,0)==1;
            if(valid&&ri_family(map_families[i])&&ri_ready(run,identity,!strcmp(map_families[i],"ri-flow-data")?3:2))valid=0;
        }
        if(!valid){if(bad++)np_puts(&missing,",");np_puts(&missing,map_families[i]);}
        else np_put(all,dump,n);
        free(dump);free(saved);
    }
    if(bad) {
        fprintf(stderr,"s9-nightly: REFUSE map-families-unready count=%d families=%s\n",bad,missing.p);
        cx_fmt(why,sizeof why,"REFUSE map-families-unready count=%d; see complete family list",bad);
    }
    free(missing.p);return bad?-1:0;
}
static int map_start_gate(const char *run,const char *identity,int has_intent) {
    if(has_intent) {
        struct stat st;errno=0;
        if(lstat(mappath,&st)) {
            if(errno==ENOENT)cx_fmt(why,sizeof why,"REFUSE map-recovery-materials-missing action=NEW_RUN_REQUIRED path=%s",mappath);
            else cx_fmt(why,sizeof why,"REFUSE map-recovery-materials-stat errno=%d action=CHECK_ACCESS",errno);
            return -1;
        }
        if(!S_ISREG(st.st_mode)){cx_fmt(why,sizeof why,"REFUSE map-recovery-materials-kind action=NEW_RUN_REQUIRED");return -1;}
        return 0;
    }
    if(fake||sy_env("UNISACC_S9_MATERIALS_DUMP_SEAM"))return 0;
    int count=map_families_load();if(count<0)return -1;
    np_buf all={0};int rc=map_collect_families(run,init_state,identity,count,&all);free(all.p);return rc;
}
static int map_verify_only;
/* The SOURCE registry already enumerates libneed-native. Its HOSTCC producer
 * is shared with affected; only verified material bytes enter a prepared map. */
static int libneed_family_check(np_result *dump) {
    const char *at=dump->out?dump->out:"";int seen=0;
    while(*at){const char *end=strchr(at,'\n');if(!end)return 1;
        if(!strncmp(at,"MATERIAL\t",9)){
            const char *batch_end=memchr(at+9,'\t',(size_t)(end-at-9));
            const char *tag="\tlibneed-native\t";size_t tn=strlen(tag);
            if(!batch_end||end-batch_end<(long)tn||memcmp(batch_end,tag,tn))return 1;
            const char *value=batch_end+tn;seen++;
            if(value<end&&*value=='-'){
                if(end-value<10||memcmp(value,"-\tREFUSED=",10))return 1;
                printf("S9_MAP_PRODUCER\tname=libneed-native\tstatus=DEFERRED\treason=%.*s\n",(int)(end-value-10),value+10);
            }else{
                char native[4600],product[4400],tool[4400];size_t n=(size_t)(end-value);
                if(!n||value[0]!='/'||n>=sizeof native||memchr(value,'\t',n))return 1;
                if(mm_copy(native,sizeof native,value,(long)n))return 1;native[n]=0;
                if(cx_fmt(product,sizeof product,"%s/unisacc.com",root)||cx_fmt(tool,sizeof tool,"%s/tools/libneed-native-material.cx",root))return 1;
                char *v[]={"sh",product,tool,"--","--verify",root,native,0};np_result r={0};int rc=run_step(v,root,15,&r);
                int ok=!rc&&!r.residue&&r.out&&strstr(r.out,"VERIFIED\tlibneed-native\t");
                if(!ok&&r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);if(!ok)return 1;
                printf("S9_MAP_PRODUCER\tname=libneed-native\tstatus=PREPARED\tpath=%s\n",native);
            }
        }at=end+1;
    }return seen?0:1;
}
static int map_family_phase(const char *run,const char *tier,const char *family,int seal) {
    char state[4600],p[4800],rec[4800],identity[65],h[65],want[5000],done[4840],intent[4840];
    int nn=map_families_load(); np_buf all={0};
    if(nn<0||cx_fmt(state,sizeof state,"%s.nightly-init",run))return 1;
    char inside[4600];if(cx_fmt(inside,sizeof inside,"%s/.nightly-init",run))return 1;
    if(sy_exists(inside)==1&&cx_fmt(state,sizeof state,"%s",inside))return 1;
    if(sy_exists(state)!=1&&mkdir(state,0700))return 1;
    if(cx_fmt(mappath,sizeof mappath,"%s.materials.tsv",run)||init_identity(tier,0,identity))return 1;
    if(!seal&&ri_family(family)&&ri_ready(run,identity,!strcmp(family,"ri-flow-data")?3:2))return 1;
    if(seal&&map_collect_families(run,state,identity,nn,&all)){free(all.p);return 1;}
    for(int i=0;!seal&&i<nn;i++) {
        if(strcmp(family,map_families[i]))continue;
        if(cx_fmt(p,sizeof p,"%s/family-%s.dump",state,map_families[i])||cx_fmt(rec,sizeof rec,"%s.sha",p))return 1;
        if(cx_fmt(done,sizeof done,"%s.done",p)||cx_fmt(intent,sizeof intent,"%s.intent",p))return 1;
        size_t z=0,rz=0;char *b=cx_read(p,&z),*saved=cx_read(rec,&rz);
        int valid=0;
        if(b&&saved) {cx_sha256_hex(b,z,h);if(cx_fmt(want,sizeof want,"S9FAMILY-v2\t%s\t%s\t%s\n",run,identity,h)){free(b);free(saved);return 1;} valid=rz==strlen(want)&&!memcmp(saved,want,rz);}
        free(saved);
        if ((b || sy_exists(rec)==1) && !valid) {
            free(b); fprintf(stderr,"s9-nightly: REFUSE family-provenance %s\n",map_families[i]); return 1;
        }
        if(!valid&&!seal) {
            free(b); b=0; char product[4400],tool[4400],*v[16],ccenv[4600];np_result r={0};
            if(cx_fmt(product,sizeof product,"%s/unisacc.com",root)||cx_fmt(tool,sizeof tool,"%s/tools/affected.cx",root))return 1;
            v[0]="sh";v[1]=product;v[2]=tool;v[3]="--";v[4]="--materials-dump";v[5]="--prepare-materials";v[6]="--family";v[7]=map_families[i];v[8]=0;
            if(!strcmp(map_families[i],"libneed-native")){
                /* Material HOSTCC selection survives a clean infrastructure
                   compiler environment, including an explicitly missing CC. */
                const char *cc=getenv("UNISACC_LIBNEED_CC");if(!cc||!*cc)cc=getenv("CC");if(!cc||!*cc)cc="cc";
                if(cx_fmt(ccenv,sizeof ccenv,"UNISACC_LIBNEED_CC=%s",cc))return 1;
                char *native[]={"env","-u","CC",ccenv,"sh",product,tool,"--","--materials-dump","--prepare-materials","--family",map_families[i],0};
                for(int j=0;j<13;j++)v[j]=native[j];
            }
            if(ri_family(map_families[i])){
                np_buf wire={0};if(ri_dump(run,identity,map_families[i],&wire)){free(wire.p);return 1;}r.out=wire.p;r.outn=wire.n;
            }
            if(evidence_file(intent,identity,1)){np_free(&r);return 1;}
            int rc=ri_family(map_families[i])?0:run_step(v,root,50,&r);
            if(rc||r.residue){if(r.outn)fwrite(r.out,1,r.outn,stderr);if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);return rc?rc:1;}
            if(!strcmp(map_families[i],"libneed-native")&&libneed_family_check(&r)){np_free(&r);return 1;}
            cx_sha256_hex(r.out?r.out:"",r.outn,h);
            char after[65];if(init_identity(tier,0,after)||strcmp(identity,after)){np_free(&r);return 1;}
            if(cx_fmt(want,sizeof want,"S9FAMILY-v2\t%s\t%s\t%s\n",run,identity,h)||cx_write(p,r.out?r.out:"",r.outn)||evidence_file(rec,want,1)){np_free(&r);return 1;}
            if(evidence_file(done,want,1)){np_free(&r);return 1;}
            np_free(&r);printf("S9_MAP_FAMILY\tname=%s\tstatus=PREPARED\n",map_families[i]);return 0;
        }
        if(!valid){free(b);free(all.p);fprintf(stderr,"s9-nightly: missing or stale family %s\n",map_families[i]);return 1;}
        if(evidence_file(intent,identity,0)!=1){free(b);fprintf(stderr,"s9-nightly: REFUSE family-intent %s\n",map_families[i]);return 1;}
        if(!seal){
            if(!strcmp(map_families[i],"libneed-native")){np_result current={0};current.out=b;current.outn=z;if(libneed_family_check(&current)){free(b);return 1;}}
            int sealed=evidence_file(done,want,0);if(sealed<0){free(b);return 1;}
            if(!sealed&&evidence_file(done,want,1)){free(b);return 1;}
            free(b);printf("S9_MAP_FAMILY\tname=%s\tstatus=%s\n",map_families[i],sealed?"SKIP":"RECOVERED");return 0;
        }
        np_put(&all,b,z);free(b);
    }
    if(!seal){free(all.p);for(int i=0;i<map_planned_n;i++)if(!strcmp(family,map_planned[i]))return 0;return 2;}
    int rc=s9_map_from_dump(all.p?all.p:"",all.n,mapfile,sizeof mapfile,why,sizeof why);free(all.p);
    if(rc||!s9_map_rows())return 1;
    /* Keep receipted family dumps byte-for-byte; canonicalize only the sealed
     * session map. allsession rejects symlinks/non-real paths (e.g. /usr/bin/ar).
     * Non-path SHA values remain exact and the pure s9map parser stays pure. */
    np_buf canonical={0}; char *at=mapfile;
    while(*at) {
        char *end=strchr(at,'\n'),*tab=strchr(at,'\t'),resolved[4400];
        if(!end||!tab||tab>end){free(canonical.p);return 1;}
        *end=0;
        np_put(&canonical,at,(size_t)(tab-at+1));
        if(tab[1]=='/') {
            if(sy_realpath(tab+1,resolved,sizeof resolved)<0) {
                fprintf(stderr,"s9-nightly: REFUSE material-realpath %s\n",tab+1);
                cx_fmt(why,sizeof why,"REFUSE material-realpath %s",tab+1);
                free(canonical.p);return 1;
            }
            np_puts(&canonical,resolved);
        } else np_puts(&canonical,tab+1);
        np_puts(&canonical,"\n");at=end+1;
    }
    if(canonical.n>=sizeof mapfile){free(canonical.p);return 1;}
    if(mm_copy(mapfile,sizeof mapfile,canonical.p,canonical.n)){free(canonical.p);return 1;}
    mapfile[canonical.n]=0;free(canonical.p);
    if(map_verify_only)return evidence_file(mappath,mapfile,0)==1?0:-1;
    return cx_write(mappath,mapfile,strlen(mapfile));
}
/* 底层封印必须与实际字节一致；不能把「存在」当成成功。 */
static int phase_sha(const char *run,const char *leaf,char hash[65]) {
    char p[4800],hp[4840],want[66];
    if(as_join(p,sizeof p,run,leaf)||cx_fmt(hp,sizeof hp,"%s.sha256",p)||as_sha_file(p,0,hash,0,why,sizeof why))return -1;
    if(cx_fmt(want,sizeof want,"%s\n",hash))return -1;
    return evidence_file(hp,want,0)==1?0:-1;
}
static int phase_checker(const char *run,const as_manifest *m,np_buf *wire) {
    char h[65],source[65],p[4800];size_t z;
    if(phase_sha(run,"checker",h)||phase_sha(run,"checker.identity",source)||as_join(p,sizeof p,root,"tools/all-waves.cx")||as_sha_file(p,0,source,0,why,sizeof why)||as_join(p,sizeof p,run,"nonce"))return -1;
    char *nonce=as_read(p,0,&z,why,sizeof why);
    if(!nonce||z!=65||nonce[64]!='\n'){free(nonce);return -1;}
    nonce[64]=0;if(!tp_material_value(2,nonce)){free(nonce);return -1;}
    np_puts(wire,"S9_CHECKER\t");np_puts(wire,root);np_puts(wire,"\t");np_puts(wire,run);np_puts(wire,"\t");np_putll(wire,m->created);np_puts(wire,"\t");np_puts(wire,m->ident.candidate_kind);np_puts(wire,"\t");np_puts(wire,m->ident.candidate);np_puts(wire,"\t");np_puts(wire,m->ident.harness);np_puts(wire,"\t");np_puts(wire,source);np_puts(wire,"\t");np_puts(wire,nonce);np_puts(wire,"\t");np_puts(wire,h);np_puts(wire,"\n");free(nonce);
    if(as_join(p,sizeof p,run,"checker.identity"))return -1;
    return evidence_file(p,wire->p,0)==1?0:-1;
}
static int phase_owned(int n,const char *run) {
    if(n==0)return 0; /* phase_outputs 核两份 native intent/identity/SHA。 */
    if(n==1){if(fake)return -1;map_verify_only=1;int rc=map_family_phase(run,native_tier,0,1);map_verify_only=0;return rc;}
    if(fake)return -1; /* 假执行不冒充真实底层 provenance。 */
    as_manifest m;char h[65],p[4800];int rc=-1;
    if(as_load(run,&m,why,sizeof why))return -1;
    if(strcmp(root,m.root)||as_ident_diff(&identity_live,&m.ident)||strcmp(identity_live.sid,m.ident.sid))goto done;
    if(as_join(p,sizeof p,run,"materials.tsv")||as_sha_file(p,0,h,0,why,sizeof why)||strcmp(h,m.map_sha)||as_sha_file(mappath,0,h,0,why,sizeof why)||strcmp(h,m.map_sha))goto done;
    if(n==2){
        if(m.daily_no_candidate!=daily_no_candidate)goto done;
        const char *meta[]={"nonce","mode","tier","selection.tsv","inputs"};for(int i=0;i<5;i++)if(phase_sha(run,meta[i],h))goto done;
        const char *mode=!strcmp(native_tier,"commit")?"COMMIT_ONLY\n":!strcmp(native_tier,"release")?"RELEASE_ONLY\n":"FULL\n";
        char body[128];if(as_join(p,sizeof p,run,"mode")||evidence_file(p,mode,0)!=1)goto done;
        if(cx_fmt(body,sizeof body,"%s\n",!strcmp(native_tier,"daily")?"all":native_tier)||as_join(p,sizeof p,run,"tier")||evidence_file(p,body,0)!=1)goto done;
        if(cx_fmt(body,sizeof body,!strcmp(native_tier,"daily")?"":"--tier\n%s\n",native_tier)||as_join(p,sizeof p,run,"selection.tsv")||evidence_file(p,body,0)!=1)goto done;
        char bin[4800];if(native_image(1,0,bin))goto done;
        int left=init_left();if(left<1)goto done;
        np_result r={0};char *v[]={bin,"inputs",root,0};int rr=run_step(v,root,left,&r);
        if(as_join(p,sizeof p,run,"inputs")||rr||r.residue||evidence_file(p,r.out?r.out:"",0)!=1){np_free(&r);goto done;}np_free(&r);rc=0;
    }
    else if(n==3||n==4){np_buf wire={0};rc=phase_checker(run,&m,&wire);
        if(!rc&&n==4){np_buf copy={0};np_puts(&copy,"COPY_VERIFIED_SAME_RUN\tcompile_ns=0\n");np_put(&copy,wire.p,wire.n);if(as_join(p,sizeof p,run,"executor/all-waves.copy")||evidence_file(p,copy.p,0)!=1)rc=-1;free(copy.p);}
        free(wire.p);if(rc)goto done;
    } else if(n==7)rc=phase_sha(run,"driver",h);
    else if(n==8)rc=phase_sha(run,"plan.tsv",h);
    else if(n>=9){
        size_t z;char *map=as_read(mappath,0,&z,why,sizeof why),*at=map;int row=0;
        while(at&&*at){char *end=strchr(at,'\n'),*tab=strchr(at,'\t');if(!end||!tab||tab>end)break;
            if(row++==n-9){*tab=0;*end=0;const as_material *x=as_find_material(&m,at);
                if(x&&!strcmp(x->path,tab+1)&&!as_material_measure(x->kind,x->path,1,h,0,why,sizeof why)&&!strcmp(h,x->content))rc=0;break;
            }at=end+1;
        }free(map);
    }
    if(n>=4&&n<=6){rc=0;for(int i=n==5?1:0;i<(n==4?1:2);i++){
        const char *leaf=i?"executor/run-batch":"executor/all-waves";char record[4840];size_t z;
        if(as_join(p,sizeof p,run,leaf)||as_sha_file(p,0,h,0,why,sizeof why)||cx_fmt(record,sizeof record,"%s.stage",p)){rc=-1;break;}
        char *s=as_read(record,0,&z,why,sizeof why);char *f[4];long long ns,created;
        if(!s||!z||s[z-1]!='\n'){free(s);rc=-1;break;}s[z-1]=0;
        if(as_split(s,f,4)!=4||strcmp(f[0],h)||as_digits(f[1],&ns)||strcmp(f[2],run)||as_digits(f[3],&created)||created!=m.created||(n==4&&ns!=0)||(n==6&&(!m.has_executor||strcmp(h,i?m.runner_sha:m.exec_sha))))rc=-1;
        free(s);if(!rc&&n==4){char checker[65];if(phase_sha(run,"checker",checker)||strcmp(checker,h))rc=-1;}if(rc)break;
    }}
done:as_free(&m);return rc;
}
/* 成功 outputs 在 .done 前落盘；旧产物没有成功证据时绝不补历史。 */
static int phase_outputs(int n,const char *run,char hex[65]) {
    np_buf b={0};char p[4800],h[65],bin[4800];int rc=0;
    for(int k=0;k<2;k++) {
        if(native_image(k,0,bin)||as_sha_file(bin,0,h,0,why,sizeof why)){free(b.p);return -1;}
        np_puts(&b,h);
    }
    if(n==1){if(as_sha_file(mappath,0,h,0,why,sizeof why)){free(b.p);return -1;}np_puts(&b,h);}
    else if(n>=2) {
        static const char *const owned[]={
            "materials.tsv","nonce","nonce.sha256","mode","mode.sha256","tier","tier.sha256","selection.tsv","selection.tsv.sha256","inputs","inputs.sha256",0,
            "checker","checker.sha256","checker.identity","checker.identity.sha256",0,
            "executor/all-waves","executor/all-waves.stage","executor/all-waves.copy",0,
            "executor/run-batch","executor/run-batch.stage",0,
            "executor/all-waves","executor/run-batch",0,
            "driver","driver.sha256",0,
            "plan.tsv","plan.tsv.sha256",0};
        if(!fake) {
            as_manifest m;as_ident live;
            if(as_load(run,&m,why,sizeof why)) {free(b.p);return -1;}
            if((identity_epoch&&identity_ready?(live=identity_live,0):as_identity(root,1,&live,why,sizeof why))||as_ident_diff(&live,&m.ident)||strcmp(live.sid,m.ident.sid)||strcmp(root,m.root)){as_free(&m);free(b.p);return -1;}
            np_puts(&b,m.root);np_putll(&b,m.created);np_puts(&b,m.map_sha);
            if(n==6) {if(!m.has_executor){as_free(&m);free(b.p);return -1;}np_puts(&b,m.exec_sha);np_puts(&b,m.runner_sha);}
            if(n>=9) {
                size_t z;char *map=as_read(mappath,0,&z,why,sizeof why),*at=map;int row=0;const as_material *material=0;
                while(at&&*at){char *end=strchr(at,'\n'),*tab=strchr(at,'\t');if(!end||!tab||tab>end)break;if(row++==n-9){*tab=0;material=as_find_material(&m,at);break;}at=end+1;}
                if(!material||as_material_fp(material,h,why,sizeof why)||strcmp(h,material->fingerprint))rc=-1;
                else {np_puts(&b,material->name);np_puts(&b,material->path);np_puts(&b,material->content);np_puts(&b,h);}
                free(map);
            }
            as_free(&m);
        }
        if(n<9) {
            int group=0;size_t i=0;while(group<n-2){if(!owned[i++])group++;}
            for(;owned[i];i++) {
                if(as_join(p,sizeof p,run,owned[i])){rc=-1;break;}
                if(fake&&sy_exists(p)!=1)continue;
                if(as_sha_file(p,0,h,0,why,sizeof why)){rc=-1;break;}
                np_puts(&b,owned[i]);np_puts(&b,"\t");np_puts(&b,h);np_puts(&b,"\n");
            }
        }
    }
    if(!rc)cx_sha256_hex(b.p?b.p:"",b.n,hex);free(b.p);return rc;
}
static int phase_evidence(int n,const char *suffix,const char *identity,const char *output,int write_it) {
    char p[4800],tmp[4840],body[512];size_t z;char *saved;
    if(cx_fmt(p,sizeof p,"%s/%s.%s",init_state,init_name(n),suffix)||cx_fmt(body,sizeof body,"S9EVIDENCE-v1\t%s\t%s\t%s\t%s\n",s9run,init_name(n),identity,output))return -1;
    if(write_it){if(cx_fmt(tmp,sizeof tmp,"%s.pending-%ld",p,(long)getpid())||cx_write(tmp,body,strlen(body)))return -1;return rename(tmp,p);}
    if(sy_exists(p)!=1)return 0;
    saved=as_read(p,0,&z,why,sizeof why);int ok=saved&&z==strlen(body)&&!memcmp(saved,body,z);free(saved);
    if(!ok){cx_fmt(why,sizeof why,"REFUSE phase-provenance %s",init_name(n));return -1;}return 1;
}
static int init_one(int n, const char *run, const char *tier, int reuse, char *out, int cap) {
    char before[65], after[65], predecessor[65], base[65], inside[4600], outputs[65]; int rc, j;
    init_t0 = sy_now_ms();
    identity_epoch=1;identity_ready=0;
    if (cx_fmt(init_side, sizeof init_side, "%s.nightly-init", run) ||
        cx_fmt(inside, sizeof inside, "%s/.nightly-init", run) ||
        cx_fmt(mappath, sizeof mappath, "%s.materials.tsv", run)) return -1;
    if (cx_fmt(init_state, sizeof init_state, "%s", sy_exists(inside) == 1 ? inside : init_side)) return -1;
    out[0] = 0;
    if (reuse) {
        if (sy_exists(init_state) != 1 && mkdir(init_state, 0700)) return -1;
        if (init_identity(tier, n > 1, before)) return -1;
        if (n > 0 && init_identity(tier, 0, base)) return -1;
        for (j = 0; j < n; j++) {
            if (init_receipt(j, j == 0 ? base : before, 0) != 1) {
                cx_fmt(why, sizeof why, "prerequisite %s", init_name(j)); return -1;
            }
        }
        if(n==1) {
            int intent=phase_evidence(n,"intent",before,"-",0);
            if(intent<0||(intent==1&&map_start_gate(run,before,1)))return -1;
        }
        if (n == 1 && sy_exists(mappath) == 1) {
            if (init_identity(tier, 1, predecessor)) return -1;
            rc = init_receipt(n, predecessor, 0);
        } else rc = init_receipt(n, before, 0);
        if (rc < 0) return -1;
        if (rc == 1) {
            if(n==0) { char bin[4800];if(native_image(0,0,bin)||native_image(1,0,bin))return -1; }
            const char *expected=n==1?predecessor:before;
            int ev=phase_evidence(n,"intent",before,"-",0);
            if(ev<0)return -1;
            if(ev==1&&(phase_outputs(n,run,outputs)||phase_evidence(n,"outputs",expected,outputs,0)!=1))return -1;
            note(init_name(n)); printf("S9_INIT\tphase=%s\tstatus=SKIP\n", init_name(n)); return 0;
        }
        const char *expected=before;
        if(n==1&&sy_exists(mappath)==1)expected=predecessor;
        int evidence=phase_evidence(n,"intent",before,"-",0);
        if(evidence<0)return -1;
        if(evidence==1) {
            if(phase_outputs(n,run,outputs))return -1;
            evidence=phase_evidence(n,"outputs",expected,outputs,0);
            if(evidence<0)return -1;
            if(evidence==1) {
                if(init_receipt(n,expected,1))return -1;
                printf("S9_INIT\tphase=%s\tstatus=RECOVERED\n",init_name(n));return 0;
            }
            if(phase_owned(n,run)){cx_fmt(why,sizeof why,"REFUSE phase-success-evidence-missing %s",init_name(n));return -1;}
            /* 旧 outputs 缺失，只能由同 RUN 的底层成功封印重新封口。 */
            identity_ready=0;
            if(init_identity(tier,n>0,after)||strcmp(expected,after)||phase_outputs(n,run,outputs)||phase_owned(n,run)||phase_evidence(n,"outputs",expected,outputs,1)||init_receipt(n,expected,1))return -1;
            printf("S9_INIT\tphase=%s\tstatus=RECOVERED\n",init_name(n));return 0;
        }
        if(n==1&&map_start_gate(run,before,0))return -1;
        if(phase_evidence(n,"intent",before,"-",1))return -1;
    }
    if (init_left() < 1) return 124;
    if (n == 0 && fake && !reuse) rc=invoke("build",0,0,0,init_left(),out,cap);
    else if (n == 0) {
        char bin[4800];
        rc=native_image(0,1,bin);
        if(!rc)rc=native_image(1,1,bin);
    }
    else if (n == 1) {
        if (fake) rc = cx_write(mappath, "", 0);
        else if(sy_env("UNISACC_S9_MATERIALS_DUMP_SEAM")) { map_budget=init_left();rc=materials_map(mapfile,sizeof mapfile,why,sizeof why);map_budget=0; }
        else rc=map_family_phase(run,tier,0,1);
    } else if (n == 2) {
        if (!fake && sy_exists(run) == 1) { cx_fmt(why, sizeof why, "init requires absent RUN"); return -1; }
        if (strcmp(tier, "daily")) { xa4 = "--tier"; xa5 = tier; }
        else if (daily_no_candidate) xa4 = "--daily-no-candidate";
        rc = invoke("init", root, run, fake ? "-" : mappath, init_left(), out, cap);
        xa4 = xa5 = 0; if (rc == 3) rc = 0;
        if (!rc && fake && sy_exists(run) != 1 && mkdir(run, 0700)) return -1;
    } else if (n >= 9) {
        rc = init_materials(n - 9, run, out, cap);
    } else {
        rc = invoke("prepare", root, run, init_preps[n - 3], init_left(), out, cap);
    }
    note(init_name(n)); if (rc) return rc;
    identity_ready=0; /* 执行后必须重新完整测量，随后仅复用这个新快照。 */
    if (reuse) {
        if (init_identity(tier, n > 0, after)) return -1;
        if (n != 1 && strcmp(before, after)) { cx_fmt(why, sizeof why, "identity changed during %s", init_name(n)); return -1; }
        if (n == 1) {
            /* 允许本相新建映射，但候选、源码等输入不能随之变化。 */
            if (init_identity(tier, 0, predecessor)) return -1;
            if (strcmp(base, predecessor)) { cx_fmt(why, sizeof why, "identity changed during map"); return -1; }
        }
        if (n == 2 && strcmp(init_state, inside)) {
            if (rename(init_state, inside)) return -1;
            if (cx_fmt(init_state, sizeof init_state, "%s", inside)) return -1;
        }
        if(phase_outputs(n,run,outputs)||phase_evidence(n,"outputs",after,outputs,1))return -1;
        if (init_receipt(n, after, 1)) return -1;
    }
    printf("S9_INIT\tphase=%s\tstatus=DONE\n", init_name(n)); return 0;
}

static void map_control_check(int yes,const char *name,int *bad){if(!yes)(*bad)++;printf("MAP_CONTROL\t%s\tchecked=%d\n",name,yes);}
static int map_control_family(const char *run,const char *identity,const char *family,const char *batch,const char *artifact) {
    char p[4800],rp[4840],dump[5000],hash[65],record[5000];
    if(cx_fmt(p,sizeof p,"%s/family-%s.dump",init_state,family)||
       cx_fmt(dump,sizeof dump,"MATERIAL\t%s\t%s\t%s\n",batch,family,artifact))return -1;
    cx_sha256_hex(dump,strlen(dump),hash);
    if(cx_fmt(record,sizeof record,"S9FAMILY-v2\t%s\t%s\t%s\n",run,identity,hash)||
       cx_write(p,dump,strlen(dump))||cx_fmt(rp,sizeof rp,"%s.sha",p)||cx_write(rp,record,strlen(record))||
       cx_fmt(rp,sizeof rp,"%s.intent",p)||cx_write(rp,identity,strlen(identity)))return -1;
    return 0;
}
/* Tiny typed registry and family receipts; no product qualification or producer
 * success is inferred from these deliberately synthetic control artifacts. */
static int map_controls(void) {
    char dir[]="/tmp/check-s9-map-XXXXXX",run[4400],artifact[4400],p[4800],intent[4800],identity[65],other[65];int bad=0;
    if(!mkdtemp(dir)||cx_fmt(root,sizeof root,"%s",dir)||cx_fmt(run,sizeof run,"%s/run",dir)||
       cx_fmt(s9run,sizeof s9run,"%s",run)||cx_fmt(init_state,sizeof init_state,"%s.nightly-init",run)||
       cx_fmt(mappath,sizeof mappath,"%s.materials.tsv",run)||mkdir(init_state,0700))return 2;
    cx_sha256_hex("map-control-input",17,identity);cx_sha256_hex("changed-map-input",17,other);
    const char *dirs[]={"tests","tools"};for(int i=0;i<2;i++){if(as_join(p,sizeof p,root,dirs[i])||mkdir(p,0700))return 2;}
    if(as_join(p,sizeof p,root,"tests/case.cx")||cx_write(p,"int main(void){return 0;}\n",strlen("int main(void){return 0;}\n"))||
       cx_fmt(artifact,sizeof artifact,"%s/artifact",root)||cx_write(artifact,"fixture",7))return 2;
    const char *registry=
      "id\timplementation\tlayer\tsource\tmode\tplatform\tbudget_seconds\tmaterials\tentry\targs\tcoverage\texpect\theaders\ttier\n"
      "host-row\tIMPLEMENTED\tinterfaces\ttests/case.cx\tSOURCE\tlnx/x86_64\t55\thosttcc:path\ttests/case.cx\t-\tmap.fixture\trc0:MAP_FIXTURE\tproduct\tdaily\n"
      "wave-row\tIMPLEMENTED\tinterfaces\ttests/case.cx\tSOURCE\tlnx/x86_64\t55\tall-waves-tool:path\ttests/case.cx\t-\tmap.fixture\trc0:MAP_FIXTURE\tproduct\trelease\n"
      "duplicate-family\tIMPLEMENTED\tinterfaces\ttests/case.cx\tSOURCE\tosx/arm64\t55\tall-waves-tool:path\ttests/case.cx\t-\tmap.fixture\trc0:MAP_FIXTURE\tproduct\tcommit\n"
      "planned-row\tPLANNED\tinterfaces\ttests/case.cx\tSOURCE\tlnx/x86_64\t55\tplanned-only:path\ttests/case.cx\t-\tmap.fixture\tNOT_READY\tproduct\trelease\n"
      "prepared-row\tIMPLEMENTED\tinterfaces\ttests/case.cx\tPREPARED\tlnx/x86_64\t55\tprepared-only:path\t{prepared-only}/case.cx\t-\tmap.fixture\trc0:MAP_FIXTURE\tproduct\tdaily\n"
      "assembler\tIMPLEMENTED\tinterfaces\ttests/case.cx\tPREPARED\tlnx/x86_64\t55\tassembler:path\t{assembler}/contracts.cx\t-\tmap.fixture\trc0:MAP_FIXTURE\tproduct\tdaily\n";
    const char *coverage="id\tlayer\timplementation\texpected_or_gap\tsource\nmap.fixture\tinterfaces\tIMPLEMENTED_SEPARATE_BATCH\tmap control\ttests/case.cx\n";
    if(as_join(p,sizeof p,root,"tests/batches.tsv")||cx_write(p,registry,strlen(registry))||
       as_join(p,sizeof p,root,"tests/coverage.tsv")||cx_write(p,coverage,strlen(coverage))||
       cx_fmt(intent,sizeof intent,"%s/map.intent",init_state))return 2;
    int count=map_families_load();
    if(count<0){fprintf(stderr,"map-controls: registry refused: %s\n",why);return 2;}
    map_control_check(count==3&&map_planned_n==2&&!strcmp(map_families[0],"hosttcc")&&!strcmp(map_families[1],"all-waves-tool")&&!strcmp(map_families[2],"assembler"),"implemented-source-family-set-deduplicated-all-tiers",&bad);
    map_control_check(!strcmp(map_families[2],"assembler")&&map_planned_n==2,"prepared-assembler-explicitly-admitted-other-prepared-still-excluded",&bad);
    int rc=map_start_gate(run,identity,0);
    map_control_check(rc!=0&&sy_exists(intent)==0&&sy_exists(mappath)==0,"all-missing-refused-before-map-intent",&bad);
    if(map_control_family(run,identity,"hosttcc","host-row",artifact))return 2;
    rc=map_start_gate(run,identity,0);
    map_control_check(rc!=0&&sy_exists(intent)==0,"remaining-family-refused-without-poisoning-run",&bad);
    if(map_control_family(run,identity,"all-waves-tool","wave-row",artifact)||map_control_family(run,identity,"assembler","assembler",artifact))return 2;
    rc=map_start_gate(run,identity,0);
    map_control_check(!rc&&sy_exists(intent)==0,"same-run-ready-after-filling-all-families",&bad);
    np_buf all={0};char parsed[16384];
    rc=map_collect_families(run,init_state,identity,count,&all);
    map_control_check(!rc&&!s9_map_from_dump(all.p,all.n,parsed,sizeof parsed,why,sizeof why)&&s9_map_rows()==3,"ready-families-form-complete-map",&bad);free(all.p);
    if(cx_fmt(p,sizeof p,"%s/family-hosttcc.dump",init_state)||cx_write(p,"tampered",8))return 2;
    rc=map_start_gate(run,identity,0);map_control_check(rc!=0&&sy_exists(intent)==0,"family-dump-sha-tamper-refused",&bad);
    if(map_control_family(run,identity,"hosttcc","host-row",artifact))return 2;
    rc=map_start_gate(run,other,0);map_control_check(rc!=0&&sy_exists(intent)==0,"family-input-identity-change-refused",&bad);
    char foreign[4400];if(cx_fmt(foreign,sizeof foreign,"%s/other-run",dir))return 2;
    rc=map_start_gate(foreign,identity,0);map_control_check(rc!=0&&sy_exists(intent)==0,"family-other-run-receipts-refused",&bad);
    if(cx_fmt(p,sizeof p,"%s/family-hosttcc.dump.intent",init_state)||cx_write(p,"tampered",8))return 2;
    rc=map_start_gate(run,identity,0);map_control_check(rc!=0&&sy_exists(intent)==0,"family-intent-tamper-refused",&bad);
    if(map_control_family(run,identity,"hosttcc","host-row",artifact)||
       cx_fmt(p,sizeof p,"%s/family-all-waves-tool.dump.sha",init_state)||unlink(p))return 2;
    rc=map_start_gate(run,identity,0);map_control_check(rc!=0&&sy_exists(intent)==0,"family-receipt-absent-refused",&bad);
    if(map_control_family(run,identity,"all-waves-tool","wave-row",artifact)||phase_evidence(1,"intent",identity,"-",1))return 2;
    rc=map_start_gate(run,identity,1);
    map_control_check(rc!=0&&strstr(why,"map-recovery-materials-missing")&&strstr(why,"NEW_RUN_REQUIRED")&&!strstr(why,"file-absent")&&phase_evidence(1,"intent",identity,"-",0)==1,"interrupted-map-missing-product-requires-new-run",&bad);
    if(cx_write(mappath,"fixture",7))return 2;
    map_control_check(!map_start_gate(run,identity,1),"existing-map-continues-to-original-sha-verification",&bad);
    if(unlink(mappath)||mkdir(mappath,0700))return 2;
    map_control_check(map_start_gate(run,identity,1)!=0&&strstr(why,"materials-kind"),"map-product-directory-refused",&bad);
    if(rmdir(mappath))return 2;
    if(!bad){char *clean[]={"rm","-rf","--",dir,0};np_result r={0};if(np_run(clean,0,0,5,&r,why,sizeof why)||r.rc)return 2;np_free(&r);}
    printf("MAP_CONTROLS\tfailed=%d\n",bad);return bad?1:0;
}
static int ri_controls(void){
 char dir[]="/tmp/check-s9-ri-XXXXXX",run[4400],base[4600],mat[4800],data[4800],p[5000],identity[65],other[65];int bad=0;
 if(!mkdtemp(dir)||cx_fmt(run,sizeof run,"%s/run",dir)||ri_paths(run,base,mat,data)||mkdir(base,0700)||mkdir(mat,0700))return 2;
 cx_sha256_hex("ri-control",10,identity);cx_sha256_hex("changed-ri",10,other);
 if(cx_fmt(root,sizeof root,"%s",dir))return 2;
 const char *dirs[]={"exec","exec/c","include","tools","tests","tests/cases"};
 for(int i=0;i<6;i++)if(cx_fmt(p,sizeof p,"%s/%s",root,dirs[i])||mkdir(p,0700))return 2;
 for(int i=0;i<9;i++)if(cx_fmt(p,sizeof p,"%s/%s",root,ri_inputs[i])||cx_write(p,"closure",7))return 2;
 map_control_check(ri_ready(run,identity,2)!=0,"ri-unprepared-refused",&bad);
 const char *leaves[]={"runtime.c","material.tsv","flow-native","flow-native.pending.tsv","flow-native.tsv"};
 for(int k=0;k<3;k++){
  int first=k==0?0:k==1?2:4,last=k==0?2:k==1?4:5;
  for(int j=first;j<last;j++)if(cx_fmt(p,sizeof p,"%s/%s",mat,leaves[j])||cx_write(p,leaves[j],strlen(leaves[j])))return 2;
  if(ri_stage_path(run,k,"intent",p)||evidence_file(p,identity,1)||ri_receipt(run,identity,k,1))return 2;
  map_control_check(ri_stage_state(run,identity,k)==1&&ri_ready(run,identity,k)==0,"ri-stage-receipt-verifies-material",&bad);
  if(k==1){size_t n;if(ri_stage_path(run,k,"done",p))return 2;char *s=as_read(p,0,&n,why,sizeof why);if(!s)return 2;map_control_check(strstr(s,"\tCOMPILED\t")&&!strstr(s,"\tPREPARED\t")&&ri_ready(run,identity,2)!=0,"ri-compiled-not-prepared",&bad);free(s);}
 }
 map_control_check(ri_ready(run,identity,2)==0,"ri-sealed-runtime-ready",&bad);
 map_control_check(ri_ready(run,other,2)!=0,"ri-input-identity-change-refused",&bad);
 if(cx_fmt(p,sizeof p,"%s/exec/c/core.h",root)||cx_write(p,"changed",7))return 2;
 map_control_check(ri_ready(run,identity,2)!=0,"ri-C-closure-change-refused",&bad);
 if(cx_write(p,"closure",7))return 2;
 char foreign[4400];if(cx_fmt(foreign,sizeof foreign,"%s/foreign",dir))return 2;
 map_control_check(ri_ready(foreign,identity,2)!=0,"ri-other-run-refused",&bad);
 if(cx_fmt(p,sizeof p,"%s/runtime.c",mat)||cx_write(p,"tamper",6))return 2;
 map_control_check(ri_ready(run,identity,2)!=0,"ri-source-output-tamper-refused",&bad);
 if(cx_write(p,leaves[0],strlen(leaves[0])))return 2;
 if(cx_fmt(p,sizeof p,"%s/flow-native",mat)||cx_write(p,"tamper",6))return 2;
 map_control_check(ri_ready(run,identity,2)!=0,"ri-native-output-tamper-refused",&bad);
 if(cx_write(p,leaves[2],strlen(leaves[2]))||ri_stage_path(run,2,"done",p)||unlink(p))return 2;
 map_control_check(ri_stage_state(run,identity,2)<0&&strstr(why,"NEW_RUN_REQUIRED"),"ri-interrupted-seal-refused",&bad);
 if(ri_receipt(run,identity,2,1)||mkdir(data,0700)||cx_fmt(p,sizeof p,"%s/material.tsv",data)||cx_write(p,"fixture",7)||ri_stage_path(run,3,"intent",p)||evidence_file(p,identity,1)||ri_receipt(run,identity,3,1))return 2;
 map_control_check(!ri_ready(run,identity,3),"ri-data-ready-after-seal",&bad);
 if(cx_fmt(p,sizeof p,"%s/unrecorded",data)||cx_write(p,"extra",5))return 2;
 map_control_check(ri_ready(run,identity,3)!=0,"ri-data-inventory-tamper-refused",&bad);
 if(!bad){char *v[]={"rm","-rf","--",dir,0};np_result r={0};if(np_run(v,0,0,5,&r,why,sizeof why)||r.rc)return 2;np_free(&r);}
 printf("RI_CONTROLS\tfailed=%d\n",bad);return bad?1:0;
}
int main(int argc, char **argv) {
    if(argc==2&&!strcmp(argv[1],"--ri-controls"))return ri_controls();
    if(argc==2&&!strcmp(argv[1],"--map-controls"))return map_controls();
    const char *run = 0, *tier = "commit", *date = 0;
    int resume = 0, phase = 0, agg_parts = 0, max_set = 0, step_set = 0; /* phase: 0 all, 1 init, 2 steps, 3 aggregate */
    char report[4400], tmp[4000], datebuf[32], aggout[4400];
    static const char *const sfxs[] = {"", "-init", "-steps", "-aggregate", "-build", "-map", "-init-session", "-prepare-1", "-prepare-2", "-prepare-3", "-prepare-4", "-prepare-5", "-prepare-6"};
    int i, rc, steps, max_steps = 4, step_s = L_I("s9.step.max"), step_done = 0;
    int init_part, material_phase=0;
    if (argc < 3) die("usage", "ROOT RUN --tier commit|daily|release [--date D] [--fake SCRIPT]");
    if (sy_realpath(argv[1], root, sizeof root) < 0) die("root", argv[1]);
    run = argv[2];
    if (!strcmp(argv[2], "--resume")) {
        if (argc < 4) die("usage", "ROOT --resume RUN");
        resume = 1;
        run = argv[3];
    }
    if (cx_fmt(s9run, sizeof s9run, "%s", run)) die("run-path", run);
    fake = 0;
    for (i = resume ? 4 : 3; i < argc; i++) {
        if (!strcmp(argv[i], "--tier") && i + 1 < argc) tier = argv[++i];
        else if (!strcmp(argv[i], "--date") && i + 1 < argc) date = argv[++i];
        else if (!strcmp(argv[i], "--fake") && i + 1 < argc) fake = argv[++i];
        else if (!strcmp(argv[i], "--map-family") && i + 1 < argc) map_family = argv[++i];
        else if(!strcmp(argv[i],"--native-material-dir")&&i+1<argc)native_material_dir=argv[++i];
        else if(!strcmp(argv[i],"--seal-native-materials")&&i+2<argc){native_material_shards=argv[++i];native_material_waves=argv[++i];}
        else if (!strcmp(argv[i], "--material-stage") && i + 1 < argc) material_stage = argv[++i];
        else if (!strcmp(argv[i], "--daily-no-candidate")) daily_no_candidate = 1;
        else if (!strcmp(argv[i], "--step-s") && i + 1 < argc) { step_s = atoi(argv[++i]); step_set = 1; }
        else if (!strcmp(argv[i], "--max-steps") && i + 1 < argc) { max_steps = atoi(argv[++i]); max_set = 1; }
        else if (!strcmp(argv[i], "--agg-parts") && i + 1 < argc) agg_parts = atoi(argv[++i]);
        else if (!strcmp(argv[i], "--phase") && i + 1 < argc) {
            const char *ph = argv[++i];
            if (!strcmp(ph, "all")) phase = 0;
            else if (!strcmp(ph, "init")) phase = 1;
            else if (!strcmp(ph, "steps")) phase = 2;
            else if (!strcmp(ph, "aggregate")) phase = 3;
            else if (!strcmp(ph, "build")) phase = 4;
            else if (!strcmp(ph, "build-shards")) phase = 100;
            else if (!strcmp(ph, "build-waves")) phase = 101;
            else if (!strcmp(ph, "map")) phase = 5;
            else if (!strcmp(ph, "init-session")) phase = 6;
            else if (!strcmp(ph, "prepare-1")) phase = 7;
            else if (!strcmp(ph, "prepare-2")) phase = 8;
            else if (!strcmp(ph, "prepare-3")) phase = 9;
            else if (!strcmp(ph, "prepare-4")) phase = 10;
            else if (!strcmp(ph, "prepare-5")) phase = 11;
            else if (!strcmp(ph, "prepare-6")) phase = 12;
            else if (!strncmp(ph, "map-register-", 13)) {
                char *end; long mat=strtol(ph+13,&end,10); char canonical[48];
                if (*end || mat < 1 || mat > 2147483638L || cx_fmt(canonical, sizeof canonical, "map-register-%ld", mat) || strcmp(canonical, ph)) die("phase", ph);
                material_phase=(int)mat; phase=13;
            }
            else die("phase", ph);
        }
        else die("unknown", argv[i]);
    }
    /* 子阶段(0.0.57,0.0.56 起跑 455s 超 5 分钟铁律):init 只做 build/init/prepare;steps 默认只走 1 步且每步 240s;
     * aggregate 默认分 4 片(s9-shards aggregate --part K N)再 --merge,每次调用都在 55s 内。steps/aggregate 沿用已 init 的 RUN,须配 --resume。
     * 每个子阶段都可重复执行(已存在的片记录跳过),调用方循环到非 PENDING 即可。 */
    if ((phase == 1 || phase >= 4) && resume) die("phase", "initialization takes RUN, not --resume");
    if ((phase == 2 || phase == 3) && !resume) die("phase", "steps|aggregate need --resume RUN");
    if (phase == 2 && !max_set) max_steps = 1;
    if (phase == 2 && !step_set) step_s = L_I("s9.step");
    if (phase == 3 && !agg_parts) agg_parts = 4;
    if (agg_parts < 0 || agg_parts > 64) die("agg-parts", "need 0..64");
    if (max_steps < 1) die("max-steps", "need >= 1");
    if (strcmp(tier, "commit") && strcmp(tier, "daily") && strcmp(tier, "release")) die("tier", tier);
    if (daily_no_candidate && strcmp(tier, "daily")) die("scope", "--daily-no-candidate requires --tier daily");
    if (!date) {
        long ws = sy_wall_s();
        if (ws <= 86400 || sy_local_fmt(datebuf, sizeof datebuf, "%Y-%m-%d", ws) != 10) die("date", "wall clock unusable; pass --date");
        date = datebuf;
    }
    {   /* report lives beside the run directory (its parent), never under ROOT/out */
        char rd[4400];
        long sl = tx_rchr(run, (long)strlen(run), '/');
        size_t rn = sl > 0 ? (size_t)sl : 0;
        if (rn >= sizeof rd) die("report", 0);
        if (rn) { if (mm_copy(rd, (long)sizeof rd, run, (long)rn)) die("report", 0); rd[rn] = 0; } else { rd[0] = '.'; rd[1] = 0; }
        if (phase == 100 || phase == 101) {
            if(cx_fmt(report,sizeof report,"%s/s9-nightly-%s-%s-%s.md",rd,date,tier,phase==100?"build-shards":"build-waves"))die("report",0);
        } else if (phase >= 13) {
            if (cx_fmt(report, sizeof report, "%s/s9-nightly-%s-%s-map-register-%d.md", rd, date, tier, material_phase)) die("report", 0);
        } else if (cx_fmt(report, sizeof report, "%s/s9-nightly-%s-%s%s.md", rd, date, tier, phase ? sfxs[phase] : resume ? "-resume" : "")) die("report", 0);
    }
    if (resume) {
        char sess[4400];
        if (cx_fmt(sess, sizeof sess, "%s/session.tsv", run) || sy_exists(sess) != 1) die("resume-no-session", run);
    }
    {   /* 前置门(0.0.65 教训): 根下候选 unisacc.com 不可执行则 REFUSE, 不自动 chmod, 不进入分步阶段 */
        char cand[4400];
        sy_stat_t cst;
        if (cx_fmt(cand, sizeof cand, "%s/%s", root, "unisacc" ".com")) die("root-path", root);
        if (!fake || sy_exists(cand) == 1) {
            if (sy_stat(cand, &cst)) die("REFUSE candidate missing", cand);
            if (sy_access(cand, 1) != 0) {
                char why2[4600];
                if (cx_fmt(why2, sizeof why2, "%s mode=%04o (X_OK failed)", cand, cst.mode)) die("REFUSE candidate not executable", cand);
                die("REFUSE candidate not executable", why2);
            }
        }
    }
    native_tier=tier;
    if(native_material_dir&&fake)die("native-materials","requires real prepared executors");
    if(native_material_shards){int nr=native_material_seal(tier);if(nr)fprintf(stderr,"s9-nightly: %s\n",why);return nr?2:0;}
    if(phase==100||phase==101) {
        char bin[4800];int nr=native_image(phase==101,1,bin);
        if(nr)fprintf(stderr,"s9-nightly: %s\n",why);
        printf("S9_NIGHTLY\tstatus=%s\tstep=%s\trc=%d\n",nr?"FAIL":"INIT_PHASE_DONE",phase==100?"build-shards":"build-waves",nr);
        return nr?1:0;
    }
    if(material_stage&&!map_family)die("material-stage","requires --map-family ri-flow-runtime|ri-flow-data");
    if(map_family) {
        if(phase!=5||fake)die("map-family","requires real --phase map");
        if(!strcmp(map_family,"libneed-native")&&getenv("CC")&&*getenv("CC")){
            /* A real env/exec boundary is required: the runtime's setenv does
               not update execvp's environ in every prepared tool layout. */
            const char *saved=getenv("UNISACC_LIBNEED_CC");if(!saved||!*saved)saved=getenv("CC");
            char selection[4600],product[4400],source[4400];char **v=calloc((size_t)argc+10,sizeof *v);if(!v)die("hostcc-selection","allocation");
            if(cx_fmt(selection,sizeof selection,"UNISACC_LIBNEED_CC=%s",saved)||cx_fmt(product,sizeof product,"%s/unisacc.com",root)||cx_fmt(source,sizeof source,"%s/tools/s9-nightly.cx",root))die("hostcc-selection","path");
            int n=0;v[n++]="/usr/bin/env";v[n++]="-u";v[n++]="CC";v[n++]=selection;v[n++]="sh";v[n++]=product;v[n++]=source;v[n++]="--";
            for(int j=1;j<argc;j++)v[n++]=argv[j];v[n]=0;
            np_result clean={0};int rc=run_step(v,root,50,&clean);if(clean.outn)fwrite(clean.out,1,clean.outn,stdout);if(clean.errn)fwrite(clean.err,1,clean.errn,stderr);np_free(&clean);free(v);return rc;
        }
        if(material_stage&&!ri_family(map_family))die("material-stage","requires ri-flow-runtime|ri-flow-data");
        long t0=sy_now_ms();int mr=material_stage?ri_stage(run,tier,material_stage):map_family_phase(run,tier,map_family,0);
        if(mr)fprintf(stderr,"s9-nightly: %s\n",why);
        printf("S9_MAP_FAMILY\trc=%d\twall_ms=%ld\n",mr,sy_now_ms()-t0);return mr;
    }
    pass_n = fail_n = 0;
    notexec_n = 1;
    note(resume ? "resume" : "begin");
    if (!resume) {
        int init_total = 9, mi;
        if (material_phase) {
            if(cx_fmt(mappath,sizeof mappath,"%s.materials.tsv",run))die("map-path",0);
            mi=init_material_count();
            if(mi<0||material_phase>mi)die("phase-material-missing",why);
            init_total=9+material_phase;
        }
        for (init_part = 0; init_part < init_total; init_part++) {
            if (phase >= 4 && init_part != (material_phase ? material_phase+8 : phase-4)) continue;
            tmp[0] = 0; why[0] = 0;
            if(init_part==1&&phase<4&&!fake&&!sy_env("UNISACC_S9_MATERIALS_DUMP_SEAM")) {
                int nf=map_families_load();if(nf<0)die("map-families",why);
                for(int fi=0;fi<nf;fi++)if(map_family_phase(run,tier,map_families[fi],0))die("map-family",map_families[fi]);
            }
            rc = init_one(init_part, run, tier, !(fake && phase == 0), tmp, sizeof tmp);
            identity_epoch=0;identity_ready=0; /* 此相已结束，不能给下一调用复用。 */
            if (rc) {
                if (tmp[0]) fprintf(stderr, "s9-nightly: %s\n", tmp);
                fprintf(stderr, "s9-nightly: %s\n", why);
                /* 分相名保留作定位；失败仍须具名到材料准备者，后续未执行者逐条记 NOT_RUN。 */
                if(init_part>=3&&init_part<9) {
                    note(init_preps[init_part-3]);
                    if(phase<4)for(int pending=init_part+1;pending<9;pending++)note_not_run(init_preps[pending-3]);
                }
                fail_n++; write_report(report, "FAIL");
                if(init_part>=3&&init_part<9)
                    printf("S9_NIGHTLY\tstatus=FAIL\tstep=prepare-%s\tphase=%s\trc=%d\treport=%s\n",init_preps[init_part-3],init_name(init_part),rc,report);
                else printf("S9_NIGHTLY\tstatus=FAIL\tstep=%s\trc=%d\treport=%s\n", init_name(init_part), rc, report);
                return 1;
            }
            pass_n++;
            if (init_part == 8 && phase < 4 && !fake) {
                mi = init_material_count();
                if (mi < 0) die("materials-map", why);
                init_total = 9 + mi;
            }
        }
        if (phase == 1 || phase >= 4) {
            write_report(report, phase == 1 ? "PREPARED" : "INIT_PHASE_DONE");
            printf("S9_NIGHTLY\tstatus=%s\tpass=%d\treport=%s\n", phase == 1 ? "PREPARED" : "INIT_PHASE_DONE", pass_n, report);
            return 0;
        }
    }
    if (phase != 3)
    for (steps = 0; steps < max_steps; steps++) {
        int starts, dones, nu, finished = 0;
        step_s_cur = step_s;
        rc = invoke("step", root, run, 0, step_s + 5, tmp, sizeof tmp);
        step_s_cur = 0;
        {   /* 记 "step 输出首行前 100 字节",状态文本可见,日志随之变长 */
            char sn[128];
            int q = 5;
            tx_copy(sn, sizeof sn, "step ", 5);
            for (int z = 0; tmp[z] && tmp[z] != '\n' && z < 100; z++) sn[q++] = tmp[z] == '\t' ? ' ' : tmp[z];
            sn[q] = 0;
            note(sn);
        }
        /* 仍有待跑片而本步一片未发:不是完成也不是待续,专用状态 NO_PROGRESS、退出码 4,不进 aggregate。 */
        if (step_no_progress(tmp, rc)) { fail_n++; write_report(report, "NO_PROGRESS"); printf("S9_NIGHTLY\tstatus=NO_PROGRESS\tstep=step\trc=%d\treport=%s\n", rc, report); return 4; }
        if (rc != 0 && rc != 3) { fail_n++; write_report(report, "FAIL"); printf("S9_NIGHTLY\tstatus=FAIL\tstep=step\trc=%d\treport=%s\n", rc, report); return 1; }
        /* 出口仅一条:本步输出带 S9 STEP_FINISHED 行。缺 S9_WT 行不是出口;start==done 也不是出口(可能仍有未发片),只用于 retry 判断。 */
        nu = scan_run(run, &starts, &dones);
        if (step_finished(tmp)) finished = 1;
        pass_n++;
        if (finished) { step_done = 1; break; }
        if (steps == max_steps - 1 && phase == 2) {
            /* 子阶段 steps:本轮预算用完仍有新片,不是失败;退出码 3 = PENDING,调用方重复本阶段(单步 <= step-s+5 秒) */
            write_report(report, "PENDING");
            printf("S9_NIGHTLY\tstatus=PENDING\tstep=steps\treport=%s\n", report);
            return 3;
        }
        if (steps == max_steps - 1) { fail_n++; write_report(report, "FAIL"); printf("S9_NIGHTLY\tstatus=FAIL\tstep=step-pending\treport=%s\n", report); return 1; }
        (void)nu;
    }
    if (phase == 2) {
        write_report(report, "STEPS_DONE");
        printf("S9_NIGHTLY\tstatus=STEPS_DONE\tpass=%d\tfail=%d\tnot_executed=%d\treport=%s\n", pass_n, fail_n, notexec_n, report);
        return 0;
    }
    /* 有 start 无 done 的片(UNKNOWN):每片调 retry 一次,再 aggregate;结果由 aggregate 定 */
    {
        int starts, dones, nu = scan_run(run, &starts, &dones), k;
        for (k = 0; k < nu; k++) {
            rc = invoke("retry", root, run, unk[k], L_I("s9.cmd"), tmp, sizeof tmp);
            note("retry");
        }
    }
    (void)step_done;
    if (cx_fmt(aggout, sizeof aggout, "%s/aggregate.out", run)) die("aggout-path", 0); /* s9-verdict 读此文件 */
    if (sy_exists(run) != 1) sy_mkdir(run, 0755); /* 真 init 已建;--fake 路径可能没有 */
    if (agg_parts > 0) {
        /* 分片聚合:每片一次独立调用(<=55s),各自写自己的 agg-part-K-N,所以并行起、按序收(Q1);最终仍由 --merge
           出唯一结论。已有片记录的跳过(可续跑)。片失败时 aggregate.out 由本进程在 merge 阶段处理,并行子进程不再从
           本进程写覆盖:失败即报具名步骤,与串行时的 rc/naming 相同。 */
        char ns[16];
        int k, ntodo = 0, todo[64];
        ParJob pj[64];
        cx_fmt(ns, sizeof ns, "%d", agg_parts);
        for (k = 0; k < agg_parts; k++) {
            char pn[4400], leaf[64];
            if (cx_fmt(leaf, sizeof leaf, "agg-part-%d-%d", k, agg_parts) || cx_fmt(pn, sizeof pn, "%s/%s", run, leaf)) die("part-path", 0);
            if (sy_exists(pn) == 1) { note("aggregate-part-reused"); continue; }
            todo[ntodo++] = k;
        }
        for (k = 0; k < ntodo; k++) {
            char ks[16];
            cx_fmt(ks, sizeof ks, "%d", todo[k]);
            if (par_spawn(&pj[k], "aggregate", root, run, "--part", ks, ns, L_I("s9.cmd"))) {
                int q;
                for (q = 0; q < k; q++) { (void)sy_kill(pj[q].pid); par_free(&pj[q]); }
                fail_n++; write_report(report, "FAIL");
                printf("S9_NIGHTLY\tstatus=FAIL\tstep=aggregate-part-%d\treason=cannot-start\treport=%s\n", todo[k], report);
                return 1;
            }
        }
        for (k = 0; k < ntodo; k++) {
            int prc = -1, dr = par_drain(&pj[k], &prc), q;
            note("aggregate-part");
            if (dr || prc != 0) {
                /* 片失败时也留下 aggregate.out(含 S9_RECEIPT reason),除非之后成功的 merge 覆盖它:并行后子进程的
                   stdout 在本进程里,所以由这里原样写入,与串行时 save_to 的字节一致。 */
                if (pj[k].out.p) (void)cx_write(aggout, pj[k].out.p, pj[k].out.n);
                for (q = k + 1; q < ntodo; q++) { (void)sy_kill(pj[q].pid); par_free(&pj[q]); }
                par_free(&pj[k]);
                fail_n++; write_report(report, "FAIL");
                printf("S9_NIGHTLY\tstatus=FAIL\tstep=aggregate-part-%d\trc=%d\treport=%s\n", todo[k], prc, report);
                return 1;
            }
            par_free(&pj[k]);
        }
        xa4 = ns;
        xa5 = 0;
        save_to = aggout;
        rc = invoke("aggregate", root, run, "--merge", L_I("s9.cmd"), tmp, sizeof tmp);
        save_to = 0;
        xa4 = xa5 = 0;
        note("aggregate-merge");
    } else {
    save_to = aggout;
    rc = invoke("aggregate", root, run, 0, L_I("s9.cmd"), tmp, sizeof tmp);
    save_to = 0;
    note("aggregate");
    }
    if (rc != 0) { fail_n++; write_report(report, "FAIL"); printf("S9_NIGHTLY\tstatus=FAIL\tstep=aggregate\trc=%d\treport=%s\n", rc, report); return 1; }
    pass_n++;
    notexec_n = 0;
    write_report(report, "PASS");
    printf("S9_NIGHTLY\tstatus=PASS\tpass=%d\tfail=%d\tnot_executed=%d\treport=%s\n", pass_n, fail_n, notexec_n, report);
    return 0;
}
