/* tools/s9-nightly.cx -- 私有克隆内按手册编排 s9,本工具不代替真跑资格。
 *
 *   sh ./unisacc.com tools/s9-nightly.cx -- ROOT RUN --tier commit|daily [--date YYYY-MM-DD] [--max-steps N] [--step-s S] [--fake SCRIPT]
 *
 * tier: commit -> init 带 "--tier commit";daily -> init 不带 --tier(s9-shards 只认 commit,缺省即全层)。
 * --date 缺省取当日(sy_wall_s + sy_local_fmt);--max-steps 缺省 4。每步记墙钟毫秒;日志超 8000 字节截断标 TRUNCATED。
 *
 * 顺序: s9-native build -> init --tier T -> prepare checker, executor-all-waves,
 * executor-run-batch, executor, driver, selection -> step 直到非 PENDING -> aggregate。
 * --fake 用 SCRIPT 代替 s9-native/driver,供夹具验证顺序/超时/失败停止。
 */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.die

static char root[4096], why[512];
static const char *fake;
static int pass_n, fail_n, notexec_n;
static char logbuf[8000];
static int logn, truncated;
static long last_ms;
static int step_s_cur; /* >0 仅在 step 调用期间设置 */
static const char *xa4, *xa5;
static void die(const char *a, const char *b) { tool_die("s9-nightly", a, b, 2); }
/* 每行 "名称\t墙钟毫秒";超过上限(预留 16 字节给标记)则截断并记 TRUNCATED,不 die。 */
static void note(const char *s) {
    char line[256];
    int n;
    if (cx_fmt(line, sizeof line, "%s\t%ld", s, last_ms)) { truncated = 1; return; }
    n = (int)strlen(line);
    if (truncated || logn + n + 2 >= (int)sizeof logbuf - 16) {
        if (!truncated) {
            truncated = 1;
            if (tx_copy(logbuf + logn, (long)(sizeof logbuf - logn), "TRUNCATED\n", 10)) die("log", 0);
            logn += 10;
            logbuf[logn] = 0;
        }
        return;
    }
    if (tx_copy(logbuf + logn, (long)(sizeof logbuf - logn), line, n)) die("log", 0);
    logn += n;
    logbuf[logn++] = '\n';
    logbuf[logn] = 0;
}
static char *step_env[2];
static char step_env_buf[96];
static int run_step(char **v, const char *cwd, int sec, np_result *r) {
    char **ev = 0;
    /* step 动词:子进程环境带 UNISACC_BOUND_DEADLINE_MONO=单调时钟(CLOCK_MONOTONIC)当前+step_s,与 s9-shards as_now 同源 */
    if (v[0] && step_s_cur > 0) {
        sy_ts_t t;
        if (sy_mono(&t) || cx_fmt(step_env_buf, sizeof step_env_buf, "UNISACC_BOUND_DEADLINE_MONO=%.9f", (double)t.sec + (double)t.nsec / 1e9 + step_s_cur)) die("deadline-env", 0);
        step_env[0] = step_env_buf;
        step_env[1] = 0;
        ev = step_env;
    }
    if (np_run(v, cwd, ev, sec, r, why, sizeof why)) { np_free(r); return 99; }
    return r->rc;
}
static int invoke(const char *verb, const char *a1, const char *a2, const char *a3, int sec, char *out, int ocap) {
    char com[4400], tool[4400];
    char *v[16];
    int k = 0, rc;
    long t0 = sy_now_ms();
    np_result r = {0};
    if (fake) {
        v[k++] = (char *)fake;
        v[k++] = (char *)verb;
        if (a1) v[k++] = (char *)a1;
        if (a2) v[k++] = (char *)a2;
        if (a3) v[k++] = (char *)a3;
        if (xa4) v[k++] = (char *)xa4;
        if (xa5) v[k++] = (char *)xa5;
        v[k] = 0;
        rc = run_step(v, root, sec, &r);
    } else {
        if (cx_fmt(com, sizeof com, "%s/%s", root, "unisacc" ".com") ||
            cx_fmt(tool, sizeof tool, "%s/tools/s9-native.cx", root)) die("path", 0);
        v[k++] = "sh"; v[k++] = com; v[k++] = tool; v[k++] = "--";
        v[k++] = (char *)verb;
        if (a1) v[k++] = (char *)a1;
        if (a2) v[k++] = (char *)a2;
        if (a3) v[k++] = (char *)a3;
        if (xa4) v[k++] = (char *)xa4;
        if (xa5) v[k++] = (char *)xa5;
        v[k] = 0;
        rc = run_step(v, root, sec, &r);
    }
    last_ms = sy_now_ms() - t0;
    if (out && ocap > 0) {
        size_t n = r.outn < (size_t)(ocap - 1) ? r.outn : (size_t)(ocap - 1);
        if (r.out && n && mm_copy(out, ocap, r.out, (long)n)) { np_free(&r); die("copy", 0); }
        out[n] = 0;
    }
    np_free(&r);
    return rc;
}
/* 本步是否还有新片在跑/待跑:输出含 S9_WT 行即有片被调度或拒绝,无该行即无新片。 */
static int has_wt(const char *s) {
    return s && strstr(s, "S9_WT") != 0;
}
/* 数 RUN 下 *.start 与 *.done;unk 收集有 start 无 done 的片名(最多 64 个)。 */
static char unk[64][96];
static int scan_run(const char *runp, int *starts, int *dones) {
    DIR *d = opendir(runp);
    struct dirent *e;
    int nu = 0;
    *starts = *dones = 0;
    if (!d) return 0;
    while ((e = readdir(d))) {
        size_t z = strlen(e->d_name);
        if (z > 6 && !strcmp(e->d_name + z - 6, ".start")) {
            char dn[4400], dp[4400];
            (*starts)++;
            if (cx_fmt(dn, sizeof dn, "%.*s.done", (int)(z - 6), e->d_name) || cx_fmt(dp, sizeof dp, "%s/%s", runp, dn)) continue;
            if (sy_exists(dp) != 1 && nu < 64 && z - 6 < sizeof unk[0]) {
                if (mm_copy(unk[nu], (long)sizeof unk[nu], e->d_name, (long)(z - 6))) continue;
                unk[nu][z - 6] = 0;
                nu++;
            }
        } else if (z > 5 && !strcmp(e->d_name + z - 5, ".done")) (*dones)++;
    }
    closedir(d);
    return nu;
}
static void write_report(const char *path, const char *status) {
    char body[9000];
    int n;
    n = snprintf(body, sizeof body,
                 "s9-nightly\nstatus\t%s\npass\t%d\nfail\t%d\nnot_executed\t%d\ntruncated\t%d\nlog\tname\twall_ms\n%s",
                 status, pass_n, fail_n, notexec_n, truncated, logbuf);
    if (n < 0 || n >= (int)sizeof body) die("report-bound", 0);
    if (cx_write(path, body, (size_t)n)) die("write", path);
}

int main(int argc, char **argv) {
    const char *run = 0, *tier = "commit", *date = 0;
    char report[4400], tmp[4000], datebuf[32];
    int i, rc, steps, max_steps = 4, step_s = 290, step_done = 0;
    static const char *preps[] = {"checker", "executor-all-waves", "executor-run-batch", "executor", "driver", "selection"};
    if (argc < 3) die("usage", "ROOT RUN --tier commit|daily|release [--date D] [--fake SCRIPT]");
    if (sy_realpath(argv[1], root, sizeof root) < 0) die("root", argv[1]);
    run = argv[2];
    fake = 0;
    for (i = 3; i < argc; i++) {
        if (!strcmp(argv[i], "--tier") && i + 1 < argc) tier = argv[++i];
        else if (!strcmp(argv[i], "--date") && i + 1 < argc) date = argv[++i];
        else if (!strcmp(argv[i], "--fake") && i + 1 < argc) fake = argv[++i];
        else if (!strcmp(argv[i], "--step-s") && i + 1 < argc) step_s = atoi(argv[++i]);
        else if (!strcmp(argv[i], "--max-steps") && i + 1 < argc) max_steps = atoi(argv[++i]);
        else die("unknown", argv[i]);
    }
    if (max_steps < 1) die("max-steps", "need >= 1");
    if (strcmp(tier, "commit") && strcmp(tier, "daily") && strcmp(tier, "release")) die("tier", tier);
    if (!date) {
        long ws = sy_wall_s();
        if (ws <= 86400 || sy_local_fmt(datebuf, sizeof datebuf, "%Y-%m-%d", ws) != 10) die("date", "wall clock unusable; pass --date");
        date = datebuf;
    }
    if (cx_fmt(report, sizeof report, "%s/%s/s9-nightly-%s-%s.md", root, "out", date, tier)) die("report", 0);
    pass_n = fail_n = 0;
    notexec_n = 1;
    note("begin");
    rc = invoke("build", 0, 0, 0, 55, tmp, sizeof tmp);
    note("build");
    if (rc != 0) { fail_n++; write_report(report, "FAIL"); printf("S9_NIGHTLY\tstatus=FAIL\tstep=build\trc=%d\treport=%s\n", rc, report); return 1; }
    pass_n++;
    /* s9-shards init: commit 与 release 透传 --tier; daily 不带 --tier 即 FULL。 */
    if (!strcmp(tier, "commit") || !strcmp(tier, "release")) { xa4 = "--tier"; xa5 = (char *)tier; }
    rc = invoke("init", root, run, "-", 55, tmp, sizeof tmp);
    xa4 = xa5 = 0;
    note("init");
    if (rc != 0 && rc != 3) { fail_n++; write_report(report, "FAIL"); printf("S9_NIGHTLY\tstatus=FAIL\tstep=init\trc=%d\treport=%s\n", rc, report); return 1; }
    pass_n++;
    for (i = 0; i < 6; i++) {
        rc = invoke("prepare", root, run, preps[i], 55, tmp, sizeof tmp);
        note(preps[i]);
        if (rc != 0) { fail_n++; write_report(report, "FAIL"); printf("S9_NIGHTLY\tstatus=FAIL\tstep=prepare-%s\trc=%d\treport=%s\n", preps[i], rc, report); return 1; }
        pass_n++;
    }
    for (steps = 0; steps < max_steps; steps++) {
        int starts, dones, nu, finished = 0;
        step_s_cur = step_s;
        rc = invoke("step", root, run, 0, step_s + 5, tmp, sizeof tmp);
        step_s_cur = 0;
        {   /* 记 "step 输出首行前 100 字节",状态文本可见,日志随之变长 */
            char sn[128];
            int q = 5;
            tx_copy(sn, sizeof sn, "step ", 5);
            for (int z = 0; tmp[z] && tmp[z] != '\n' && z < 100; z++) sn[q++] = tmp[z] == '\t' ? ' ' : tmp[z];
            sn[q] = 0;
            note(sn);
        }
        if (rc != 0 && rc != 3) { fail_n++; write_report(report, "FAIL"); printf("S9_NIGHTLY\tstatus=FAIL\tstep=step\trc=%d\treport=%s\n", rc, report); return 1; }
        /* 出口仅一条:本步输出无 S9_WT 行(本步没有新发片)。start==done 不是出口(可能仍有未发片),只用于 retry 判断。 */
        nu = scan_run(run, &starts, &dones);
        if (!has_wt(tmp)) finished = 1;
        pass_n++;
        if (finished) { step_done = 1; break; }
        if (steps == max_steps - 1) { fail_n++; write_report(report, "FAIL"); printf("S9_NIGHTLY\tstatus=FAIL\tstep=step-pending\treport=%s\n", report); return 1; }
        (void)nu;
    }
    /* 有 start 无 done 的片(UNKNOWN):每片调 retry 一次,再 aggregate;结果由 aggregate 定 */
    {
        int starts, dones, nu = scan_run(run, &starts, &dones), k;
        for (k = 0; k < nu; k++) {
            rc = invoke("retry", root, run, unk[k], 55, tmp, sizeof tmp);
            note("retry");
        }
    }
    (void)step_done;
    rc = invoke("aggregate", root, run, 0, 55, tmp, sizeof tmp);
    note("aggregate");
    if (rc != 0) { fail_n++; write_report(report, "FAIL"); printf("S9_NIGHTLY\tstatus=FAIL\tstep=aggregate\trc=%d\treport=%s\n", rc, report); return 1; }
    pass_n++;
    notexec_n = 0;
    write_report(report, "PASS");
    printf("S9_NIGHTLY\tstatus=PASS\tpass=%d\tfail=%d\tnot_executed=%d\treport=%s\n", pass_n, fail_n, notexec_n, report);
    return 0;
}
