/* tools/check-tapeslice-gen.cx -- check tools/tapeslice-gen.cx generator contract (--check, usage reject, and bytes parity). */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use text.text
#pragma unisa use cxlib.procrun

static int g_pass = 0;
static int g_fail = 0;
static char g_out[8192];

static void ck(int ok, const char *name) {
    if (ok) { g_pass++; sy_printf("PASS\tcheck-tapeslice-gen.%s\n", name); }
    else { g_fail++; sy_printf("FAIL\tcheck-tapeslice-gen.%s\n", name); }
}

int main(void) {
    int cut = 0, rc;
    char *vc[] = {"sh", "./unisacc.com", "tools/tapeslice-gen.cx", "--", "--check", 0}; /* lint:allow R1-product invokes generator via checkout product */
    char *vu[] = {"sh", "./unisacc.com", "tools/tapeslice-gen.cx", "--", "--badopt", 0}; /* lint:allow R1-product negative arg check via checkout product */
    rc = pr_run_merged(vc, 45, g_out, (int)sizeof g_out, &cut);
    ck(rc == 0 && !cut && tx_find(g_out, tx_len(g_out, sizeof g_out), "TAPESLICE_GEN\tCHECK\trows=34\thost_slots=37", 41) >= 0,
       "generator-check-passes");
    rc = pr_run_merged(vu, 45, g_out, (int)sizeof g_out, &cut);
    ck(rc != 0, "generator-bad-arg-rejected");
    sy_printf("CHECK_TAPESLICE_GEN\tpassed=%d\tfailed=%d\n", g_pass, g_fail);
    return g_fail ? 1 : 0;
}
