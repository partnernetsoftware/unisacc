/* 轻夹具：直接复用核对器实现；正控读取真实三个源码，负控仅变异内存副本。
 * 不创建快照、不启动编译器、不运行链。未知构造须 REFUSE，不能当跳过成功。
 * 用法：check-chain-argv-check [ROOT]；进程内复用实现，无子编译。 */
#pragma unisa use cxlib.chainargv
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use cxlib.netpack
#pragma unisa use sys.posix
static int fixture_failed;
static void fixture_ck(int ok,const char *name){printf("%s\tcheck-chain-argv-check.%s\n",ok?"PASS":"FAIL",name);if(!ok)fixture_failed++;}
static char *fixture_replace(const char *s,const char *from,const char *to){
 const char *p=strstr(s,from);if(!p)return 0;size_t a=p-s,b=strlen(from),c=strlen(to),n=strlen(s);char *r=malloc(n-b+c+1);if(!r)return 0;
 if(mm_copy(r,n-b+c+1,s,a)||mm_copy(r+a,n-b+c+1-a,to,c)||mm_copy(r+a+c,n-a-b+1,p+b,n-a-b+1)){free(r);return 0;}return r;
}
static void fixture_case(const char *source,const char *chain,const char *front,const char *from,const char *to,const char *name,const char *diagnostic){
 char *changed=fixture_replace(source,from,to);if(!changed){fixture_ck(0,"mutation-anchor-missing");return;}
 int diagnostics=0,mismatch=0;int rc=ca_check(changed,chain,front,diagnostic,&diagnostics,&mismatch);fixture_ck(rc==2&&diagnostics>0&&!mismatch,name);free(changed);
}
int main(int argc,char **argv){
 if(argc!=1&&argc!=2){fprintf(stderr,"usage: check-chain-argv-check [ROOT]\n");return 2;}
 if(argc==2&&sy_chdir(argv[1])){fprintf(stderr,"REFUSE\tfixture ROOT unreadable\n");return 2;}
 size_t n;char *a=cx_read("tools/candidate-chain.cx",&n),*b=cx_read("tools/chain-step.cx",&n),*c=cx_read("tools/whole-front.cx",&n);
 if(!a||!b||!c){fprintf(stderr,"REFUSE\tfixture source unreadable\n");free(a);free(b);free(c);return 2;}
 int baseline=ca_check(a,b,c,0,0,0);fixture_ck(baseline==0,"real-source-positive");
 if(baseline){free(a);free(b);free(c);printf("CHECK_CHAIN_ARGV_CHECK\tfailed=%d\tnegative_controls=NOT_RUN-baseline-refused\n",fixture_failed);return 1;}
 fixture_case(a,b,c,"a[3] = build; a[4] = 0;","a[3] = 0; a[4] = 0;","missing-positional","callee argc guard rejects missing argument");
 fixture_case(a,b,c,"a[1] = (char *)rev; a[2] = snap; a[3] = build;","a[1] = snap; a[2] = (char *)rev; a[3] = build;","swapped-positionals","positional role/order mismatch");
 fixture_case(a,b,c,"a[n++]=\"--identity-helper\";a[n++]=(char *)helper;","a[n++]=(char *)helper;","blocker3-bare-helper","bare helper or unexpected positional argument");
 fixture_case(a,b,c,"a[n++]=(char *)snap;a[n++]=(char *)pkg;","a[n++]=(char *)pkg;a[n++]=(char *)snap;","g2-fixedpoint-swapped-positionals","positional role/order mismatch");
 fixture_case(a,b,c,"a[n++]=\"--identity-helper\";a[n++]=(char *)helper;","a[n++]=\"--identity-helper\";","g2-fixedpoint-missing-helper-value","missing option value");
 fixture_case(a,b,c,"if(step(root,a))die(keys?\"fixedpoint objects\":\"fixedpoint link\",phase);","if(unknown_step(root,a))die(keys?\"fixedpoint objects\":\"fixedpoint link\",phase);","g2-fixedpoint-unknown-wrapper","relevant argv escapes through unknown wrapper");
 fixture_case(a,b,c,"a[1] = (char *)rev; a[2] = snap; a[3] = build;","a[1] = unknown_builder(rev); a[2] = snap; a[3] = build;","unknown-construction-refused","unsupported array construction or missing terminator");
 fixture_case(a,b,c,"v[n++] = (char *)snap; v[n++] = (char *)pkg; v[n++] = (char *)ctor;","v[n++] = (char *)pkg; v[n++] = (char *)snap; v[n++] = (char *)ctor;","whole-front-swapped-positionals","positional role/order mismatch");
 fixture_case(a,b,c,"if (step(root, a)) die(\"build\", build);","if (unknown_step(root, a)) die(\"build\", build);","unknown-wrapper-refused","relevant argv escapes through unknown wrapper");
 fixture_case(a,b,c,"v[n++] = offset; v[n++] = amount;","v[n++] = amount; v[n++] = offset;","dynamic-front-swap","positional role/order mismatch");
 fixture_case(a,b,c,"i < slices; i++) v[n++] = parts[i];","i < unknown_slices; i++) v[n++] = parts[i];","dynamic-merge-bound-refused","unsupported array construction or missing terminator");
 fixture_case(a,b,c,"i < cf_root_count(); i++) v[n++] = span_roots[i];","i < cf_root_count()+1; i++) v[n++] = span_roots[i];","dynamic-roots-bound-refused","unsupported array construction or missing terminator");
 char *callee=fixture_replace(b,"return cs_build(argv[2], argv[3], argv[4]);","return cs_build(argv[3], argv[2], argv[4]);");
 int diagnostics=0,mismatch=0;const char *expected="callee forwarding/signature order differs from parser contract";
 fixture_ck(callee&&ca_check(a,callee,c,expected,&diagnostics,&mismatch)==2&&diagnostics>0&&!mismatch,"callee-position-swap-refused");free(callee);
 char *parser=fixture_replace(c,"physical(argv[2],root);physical(argv[3],pkg);","physical(argv[3],root);physical(argv[2],pkg);");
 fixture_ck(parser&&ca_check(a,b,parser,expected,&diagnostics,&mismatch)==2&&diagnostics>0&&!mismatch,"callee-whole-position-swap-refused");free(parser);
 free(a);free(b);free(c);printf("CHECK_CHAIN_ARGV_CHECK\tfailed=%d\n",fixture_failed);return fixture_failed?1:0;
}
