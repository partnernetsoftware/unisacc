/* 消费者可见边界：实际启动预检，不检查源码文本。
 * sh ./unisacc.com tools/check-chain-precheck.cx
 * 创建私有微型git仓及作业记录；不依赖 /tmp/c2* 现场。
 * CHAIN_PRECHECK=/absolute/controller.elf 可复用已编译控制器进行修复前负控；
 * 不设置时执行当前源码。所有写入均限于本夹具新建的仓外目录。
 */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use text.text
static char base[4400],repo[4400],chain[4400],fresh[4400],com[4400],tool[4400];static int bad,checks;
static void die(const char *s){fprintf(stderr,"check-chain-precheck: %s\n",s);exit(2);}
static void path(char *p,const char *a,const char *b){if(cx_fmt(p,4400,"%s/%s",a,b))die("path bound");}
static void put(const char *p,const char *s){if(cx_write(p,s,strlen(s)))die("fixture write");}
static void md(const char *p){if(mkdir(p,0700))die("fixture mkdir");}
static void ok(int c,const char *s){checks++;printf("%s\t%s\n",c?"PASS":"FAIL",s);if(!c)bad++;}
static void command(char **v){np_result r;char why[1400];if(np_run(v,repo,0,10,&r,why,sizeof why)||r.rc||r.residue)die("fixture git");np_free(&r);}
static int consume_paths(const char *rpath,const char *cpath,const char *opath,const char *phase,const char *a,const char *b,const char *needle,int rc){char *v[]={"sh",com,tool,"--",(char *)rpath,(char *)cpath,(char *)opath,(char *)phase,(char *)a,(char *)b,0};if(!a)v[8]=0;else if(!b)v[9]=0;const char *external=sy_env_or("CHAIN_PRECHECK","");char *native[]={(char *)external,(char *)rpath,(char *)cpath,(char *)opath,(char *)phase,(char *)a,(char *)b,0};if(!a)native[5]=0;else if(!b)native[6]=0;if(*external&&(*external!='/'||access(external,X_OK)))die("CHAIN_PRECHECK must be an executable absolute controller path");np_result r;char why[1400];int t=np_run(*external?native:v,repo,0,55,&r,why,sizeof why);int yes=!t&&r.rc==rc&&!r.residue&&((r.out&&strstr(r.out,needle))||(r.err&&strstr(r.err,needle)));if(!yes){if(r.out)fwrite(r.out,1,r.outn,stderr);if(r.err)fwrite(r.err,1,r.errn,stderr);}np_free(&r);return yes;}
static int consume(const char *phase,const char *a,const char *b,const char *needle,int rc){return consume_paths(repo,chain,fresh,phase,a,b,needle,rc);}
static void constructor_behavior(void){char p[4400],q[4400];ok(consume("probe","entry",0,"constructor candidate unavailable",2),"init无需构造器但probe无两个候选时具名拒绝");path(p,chain,"sl-lnx");md(p);path(q,p,"candidate");size_t n;char *native=cx_read("/bin/false",&n);if(!native||n<4||memcmp(native,"\177ELF",4)||cx_write(q,native,n)||chmod(q,0700))die("real native fixture");free(native);ok(consume("probe","entry",0,"FAIL",1),"旧控制器ENOENT回退真实native候选并直接执行保留非零状态");if(chmod(q,0600))die("candidate permission");ok(consume("slice","all",0,"constructor executable access failed",2),"candidate不可执行明确拒绝");if(chmod(q,0700))die("candidate restore");path(p,chain,"ctrl");put(p,"not a directory\n");ok(consume("slice-link",0,0,"constructor preferred stat failed",2),"旧控制器父路径ENOTDIR不回退可执行candidate");if(unlink(p)||unlink(q))die("constructor fixture remove");}
static void macro_behavior(void){char dir[4400],header[4400],src[4400],body[10000];path(dir,base,"macro-consumer");md(dir);path(header,dir,"value.h");path(src,dir,"check.c");if(cx_fmt(body,sizeof body,"#include \"value.h\"\n#if PRECHECK_VALUE != 7\n#error relative_value\n#endif\n#include \"%s\"\n#if PRECHECK_VALUE != 7\n#error absolute_value\n#endif\nint main(void){return PRECHECK_VALUE;}\n",header))die("macro body");put(src,body);for(int i=0;i<2;i++){put(header,i?"#define PRECHECK_VALUE 8\n":"#define PRECHECK_VALUE   ( 7 )\n");char *v[]={"sh",com,"-b","lnx/x86_64","-E",src,0};np_result r;char why[1400];int t=np_run(v,dir,0,30,&r,why,sizeof why);ok(!t&&!r.residue&&(i?r.rc!=0:r.rc==0),i?"真实预处理器对错误宏值触发#error":"真实预处理器接受等值宏且与输出空白无关");np_free(&r);}}
static void native_fixture(void){char dir[4400],src[4400],bin[4400],p[4400],q[4400];path(dir,repo,"tools");md(dir);path(src,base,"job.c");path(bin,dir,"bound");put(src,"#include <stdio.h>\n#include <string.h>\n#include <unistd.h>\nint main(int n,char **v){if(n>3&&!strcmp(v[1],\"40\")){execv(v[2],v+2);return 120;}if(n<3)return 121;if(!strcmp(v[1],\"fail\")){fputs(\"seed-gen: state mode conflict\\n\",stderr);return 9;}FILE *in=fopen(!strcmp(v[1],\"pp\")?\"input.tsv\":v[1],\"rb\");if(!in)return 122;unsigned long sum=0;int c;while((c=fgetc(in))!=EOF)sum+=(unsigned char)c;int err=ferror(in);if(fclose(in)||err)return 125;FILE *o=fopen(v[2],\"wb\");if(!o)return 123;int bad=fprintf(o,\"%lu\\n\",sum)<0;return fclose(o)||bad?124:0;}\n");char *cc[]={"cc",src,"-o",bin,0};command(cc);path(p,chain,"ctx/jobs/tool-gen");md(p);path(q,p,"result.exe");size_t n;char *s=cx_read(bin,&n);if(!s||cx_write(q,s,n)||chmod(q,0700))die("native job fixture");free(s);path(p,chain,"ctx/jobs/gen-case/command.argv.tsv");char text[18000];if(cx_fmt(text,sizeof text,"arg-0\t%s\narg-1\t40\narg-2\t%s/ctx/jobs/tool-gen/result.exe\narg-3\tfail\narg-4\t%s/ctx/jobs/gen-case/result.json\n",bin,chain,chain))die("native argv");put(p,text);}
static long fixture_mtime_ns(const struct stat *s){
#ifdef __APPLE__
 return s->st_mtimespec.tv_nsec;
#elif defined(_WIN32)
 return 0;
#elif defined(_UNISA_SYS_STAT_H)
 return s->st_mtime_nsec;
#else
 return s->st_mtim.tv_nsec;
#endif
}
static void fixture_snapshot(const char *dir,np_buf *b,int depth){if(depth>32)die("fixture snapshot depth");DIR *d=opendir(dir);if(!d)die("fixture snapshot open");struct dirent *e;while((e=readdir(d))){if(!strcmp(e->d_name,".")||!strcmp(e->d_name,".."))continue;char p[4400],row[4800];path(p,dir,e->d_name);struct stat st;if(lstat(p,&st))die("fixture snapshot stat");if(cx_fmt(row,sizeof row,"%s\t%lld\t%lld\t%ld\n",p,(long long)st.st_size,(long long)st.st_mtime,fixture_mtime_ns(&st)))die("fixture snapshot bound");if(b->n>67108864-strlen(row))die("fixture snapshot extent");np_puts(b,row);if(S_ISDIR(st.st_mode))fixture_snapshot(p,b,depth+1);}closedir(d);}
static void copied_behavior(const char *list){
 char original[4400],duplicate[4400],p[4400],q[4400],text[18000];path(original,base,"original-records");path(duplicate,base,"copied-records");char *cp[]={"cp","-a",chain,original,0};command(cp);
 const char *ids[]={"gen-case","tbl-case","net-case"},*tools[]={"tool-gen","tool-tbl","tool-net"},*ext[]={"json","tbl","net"};
 for(int i=0;i<3;i++){if(i){if(cx_fmt(text,sizeof text,"ctx/jobs/%s",ids[i]))die("fixture path");path(p,original,text);md(p);path(q,p,"command.status");put(q,"rc\t0\n");if(cx_fmt(text,sizeof text,"ctx/jobs/%s",tools[i]))die("fixture path");path(p,original,text);md(p);path(q,p,"result.exe");char src[4400];path(src,original,"ctx/jobs/tool-gen/result.exe");size_t n;char *s=cx_read(src,&n);if(!s||cx_write(q,s,n)||chmod(q,0700))die("fixture tool copy");free(s);}
  char input[4400];if(!i){if(cx_fmt(input,sizeof input,"pp"))die("fixture mode");}else if(cx_fmt(input,sizeof input,"%s/ctx/jobs/%s/result.%s",original,ids[i-1],ext[i-1]))die("fixture input");if(cx_fmt(text,sizeof text,"arg-0\t%s/tools/bound\narg-1\t40\narg-2\t%s/ctx/jobs/%s/result.exe\narg-3\t%s\narg-4\t%s/ctx/jobs/%s/result.%s\n%s",repo,original,tools[i],input,original,ids[i],ext[i],!i?"arg-5\t--shared-predefines\narg-6\t--no-autoinc\narg-7\t--locations\n":""))die("copied argv");char leaf[400];if(cx_fmt(leaf,sizeof leaf,"ctx/jobs/%s/command.argv.tsv",ids[i]))die("fixture leaf");path(q,original,leaf);put(q,text);
 }char *cp2[]={"cp","-a",original,duplicate,0};command(cp2);
 /* 副本工具必须完成真实转换；原工具失效且原输入为不同数据，不能靠argv回显冒充隔离。 */
 size_t fn;char *falsebin=cx_read("/bin/false",&fn);if(!falsebin)die("original tool poison");for(int i=0;i<3;i++){if(cx_fmt(q,sizeof q,"%s/ctx/jobs/%s/result.exe",original,tools[i])||cx_write(q,falsebin,fn)||chmod(q,0700))die("original tool poison");if(cx_fmt(q,sizeof q,"%s/ctx/jobs/%s/result.%s",original,ids[i],ext[i]))die("original payload poison");put(q,"original-only\n");}free(falsebin);
 np_buf before={0},after={0};fixture_snapshot(original,&before,0);path(fresh,base,"copied-run");ok(consume_paths(repo,duplicate,fresh,"init","--files",list,"PREPARED",0),"真实复制链初始化且不改ctx/reads");
 const char *converted[]={"570\n","166\n","167\n"};for(int i=0;i<3;i++){ok(consume_paths(repo,duplicate,fresh,"job",ids[i],0,"PREPARED",0),"复制链gen/tbl/net真实执行");char leaf[400];if(cx_fmt(leaf,sizeof leaf,"jobs/%s/result.%s",ids[i],ext[i]))die("fixture result");path(q,fresh,leaf);size_t n;char *s=cx_read(q,&n);ok(s&&n==strlen(converted[i])&&!memcmp(s,converted[i],n),"副本工具真实读取私有输入并生成精确字节和570/166/167，输出位于NEW_OUT");free(s);}
 fixture_snapshot(original,&after,0);ok(before.n==after.n&&!memcmp(before.p,after.p,before.n),"复制链执行前后原目录文件名大小mtime完全不变");free(before.p);free(after.p);
 path(q,duplicate,"ctx/jobs/gen-case/command.argv.tsv");if(cx_fmt(text,sizeof text,"arg-0\t%s/tools/bound\narg-1\t40\narg-2\t%s/ctx/jobs/tool-gen/result.exe\narg-3\tpp\narg-4\t%s/escaped.json\n",repo,original,base))die("escaped argv");put(q,text);path(fresh,base,"copied-escape");ok(consume_paths(repo,duplicate,fresh,"init","--files",list,"PREPARED",0)&&consume_paths(repo,duplicate,fresh,"job","gen-case",0,"job output outside authorized NEW_OUT",2),"启动前按精确arg4拒绝根外写路径");path(q,base,"escaped.json");struct stat st;ok(lstat(q,&st)&&errno==ENOENT,"被拒绝的输出未创建");
}
int main(void){
 char root[4096],p[4400],q[4400],list[4400],text[10000];if(!realpath(".",root))die("cwd");path(com,root,"unisacc.com");path(tool,root,"tools/chain-precheck.cx");if(cx_fmt(base,sizeof base,"%s/chain-precheck-check-XXXXXX",sy_env_or("TMPDIR","/tmp"))||!mkdtemp(base))die("temporary directory");path(repo,base,"root");md(repo);path(chain,base,"chain");md(chain);path(p,chain,"ctx");md(p);path(q,p,"jobs");md(q);path(p,q,"gen-case");md(p);path(q,p,"command.status");put(q,"rc\t0\n");path(q,p,"command.reads.tsv");if(cx_fmt(text,sizeof text,"%s\n%s/input.tsv\n",repo,repo))die("reads bound");put(q,text);path(q,p,"command.argv.tsv");put(q,"arg-0\tsh\narg-1\t-c\narg-2\tprintf 'seed-gen: state mode conflict\\n' >&2; exit 9\n");path(q,repo,"input.tsv");put(q,"input\n");char *v1[]={"git","init","-q",0};command(v1);char *v2[]={"git","add","input.tsv",0};command(v2);char *v3[]={"git","-c","user.name=precheck","-c","user.email=precheck@invalid","commit","-qm","fixture",0};command(v3);
 native_fixture();
 path(q,chain,"ctx/jobs/tool-gen/command.status");put(q,"rc\t0\n");
 path(list,base,"files");put(list,"missing.tsv\n");path(fresh,base,"unmapped");ok(consume("init","--files",list,"unmapped",2),"未映射输入明确拒绝");
 put(list,"input.tsv\n");path(fresh,base,"run");ok(consume("init","--files",list,"PREPARED",0),"真实reads映射初始化");
 path(q,repo,"input.tsv");if(cx_fmt(text,sizeof text,"%s\n",q))die("absolute list");put(list,text);path(fresh,base,"absolute-input");ok(consume("init","--files",list,"PREPARED",0),"绝对ROOT、CHAIN_OUT、NEW_OUT及根内绝对表真实映射成功");
 path(fresh,base,"relative-input");ok(consume_paths(".","../chain","../relative-input","init","--files",list,"PREPARED",0),"相对ROOT、CHAIN_OUT、NEW_OUT与绝对表真实映射成功");
 path(q,repo,"second.tsv");put(q,"second input\n");path(q,p,"command.reads.tsv");if(cx_fmt(text,sizeof text,"%s\n%s/input.tsv\n%s/second.tsv\n",repo,repo,repo))die("shared reads bound");put(q,text);put(list,"input.tsv\nsecond.tsv\ninput.tsv\n");path(fresh,base,"shared-inputs");ok(consume("init","--files",list,"PREPARED",0),"同一gen读取两表及重复清单输入均真实初始化成功");path(q,fresh,"selected.tsv");size_t selected_n;char *selected_text=cx_read(q,&selected_n);ok(selected_text&&selected_n==9&&!memcmp(selected_text,"gen-case\n",9),"两表命中同一gen只调度一项且重复输入不追加");free(selected_text);
 if(cx_fmt(text,sizeof text,"%s-extra/input.tsv\n",repo))die("outside list");put(list,text);path(fresh,base,"outside-prefix");ok(consume("init","--files",list,"file-list-outside-root",2),"共享ROOT前缀的根外绝对表拒绝");
 put(list,"input.tsv\n");path(fresh,base,"missing-parent/new");ok(consume("init","--files",list,"errno=2",2),"输出父目录ENOENT明确保留");path(q,base,"parent-file");put(q,"file\n");path(fresh,q,"new");ok(consume("init","--files",list,"errno=20",2),"输出父目录ENOTDIR不冒充ENOENT");
 path(q,base,"absent-root");ok(consume_paths(q,chain,fresh,"init","--files",list,"errno=2",2),"ROOT缺失明确保留ENOENT");path(q,base,"parent-file/child");ok(consume_paths(q,chain,fresh,"init","--files",list,"errno=20",2),"ROOT父目录ENOTDIR明确保留");
 if(geteuid()!=0){char denied[4400];path(denied,base,"denied-parent");md(denied);if(chmod(denied,0000))die("output permission fixture");path(fresh,denied,"new");ok(consume("init","--files",list,"errno=13",2),"输出父目录EACCES不得当作ENOENT");ok(consume_paths(fresh,chain,fresh,"init","--files",list,"errno=13",2),"ROOT父目录EACCES不得当作ENOENT");if(chmod(denied,0700))die("output permission restore");}
 path(fresh,base,"run");
 constructor_behavior();
 path(q,repo,"out");struct stat outstat;ok(!lstat(q,&outstat)&&S_ISDIR(outstat.st_mode),"init自动创建ROOT/out快照父目录");
 ok(consume("job","tbl-other",0,"job not selected",2),"未选择gen的tbl作业拒绝");ok(consume("job","net-other",0,"job not selected",2),"未选择gen的net作业拒绝");
 path(q,fresh,"selected.tsv");put(q,"prefix-gen-case\n");ok(consume("job","gen-case",0,"job not selected",2),"selected不接受行内后缀命中");put(q,"gen-case\n");
 ok(consume("job","gen-case",0,"FAIL",1),"实际子进程非零不能冒充通过");path(q,fresh,"jobs/gen-case/command.status");size_t n;char *s=cx_read(q,&n);ok(s&&n>=5&&!memcmp(s,"rc\t9\n",5),"新作业保留失败command.status");free(s);ok(consume("finish",0,0,"selected gen incomplete",2),"失败作业阻断汇总PASS");
 const char *badstatus[]={"rc\t1\n","rc\t0\nrc\t1\n","rc\t0\ntransport\t0\nresidue\t0\nrc\t1\n","rc\t0\ntransport\t0\nresidue\t1\n"};
 for(int i=0;i<4;i++){path(q,p,"command.status");put(q,badstatus[i]);if(cx_fmt(text,sizeof text,"bad-status-%d",i))die("status path");path(fresh,base,text);ok(consume("init","--files",list,"chain gen status failed",2),"旧链失败、重复字段或残留状态拒绝");}path(q,p,"command.status");put(q,"rc\t0\n");
 const char *paths[]={"/input.tsv\n","C:/input.tsv\n","../input.tsv\n","input.tsv.extra\n"};for(int i=0;i<4;i++){put(list,paths[i]);if(cx_fmt(text,sizeof text,"bad-path-%d",i))die("path fixture");path(fresh,base,text);ok(consume("init","--files",list,i==3?"unmapped":i==0?"file-list-outside-root":"file-list-relative-path",2),"根外绝对路径、父路径及后缀输入拒绝");}
 put(list,"input.tsv\n");copied_behavior(list);
 path(fresh,base,"run");char baseline[4400],probejob[4400];path(baseline,base,"baseline");md(baseline);path(q,fresh,"source-root");put(q,baseline);path(probejob,chain,"ctx/jobs/gen-probe");md(probejob);path(q,probejob,"command.reads.tsv");if(cx_fmt(text,sizeof text,"%s\n%s/optional-missing\n",baseline,baseline))die("negative read fixture");put(q,text);
 ok(consume("reuse",0,0,"PREPARED",0),"双端ENOENT存在探测允许复用");path(q,repo,"optional-missing");put(q,"now exists\n");ok(consume("reuse",0,0,"reuse-input-stat-or-existence-changed",2),"原来不存在的输入出现必须拒绝");if(unlink(q))die("fixture unlink");path(q,baseline,"optional-missing");put(q,"old file\n");ok(consume("reuse",0,0,"baseline=",2),"单端缺失拒绝且诊断包含路径");
 if(unlink(q))die("fixture unlink");md(q);char child[4400];path(child,q,"child");put(child,"x\n");path(q,repo,"optional-missing");put(q,"not a directory\n");path(q,probejob,"command.reads.tsv");if(cx_fmt(text,sizeof text,"%s\n%s/optional-missing/child\n",baseline,baseline))die("ENOTDIR fixture");put(q,text);ok(consume("reuse",0,0,"reuse-input-stat-or-existence-changed",2),"ENOTDIR不得当成双端ENOENT");
 if(geteuid()!=0){path(q,baseline,"optional-missing");if(chmod(q,0000))die("permission fixture");ok(consume("reuse",0,0,"baseline-errno=13",2),"EACCES保留精确错误且不得吞为不存在");if(chmod(q,0700))die("permission restore");}
 path(q,repo,"out");if(rmdir(q))die("snapshot parent fixture");put(q,"not a directory\n");put(list,"input.tsv\n");path(fresh,base,"invalid-snapshot-parent");ok(consume("init","--files",list,"ROOT/out must be a directory",2),"ROOT/out普通文件明确拒绝");if(unlink(q)||symlink(".",q))die("snapshot symlink fixture");path(fresh,base,"symlink-snapshot-parent");ok(consume("init","--files",list,"ROOT/out must be a directory",2),"ROOT/out符号链接不冒充新快照父目录");
 macro_behavior();
 printf("CHAIN_PRECHECK_CHECK\tchecks=%d\tfailed=%d\n",checks,bad);return bad?1:0;
}
