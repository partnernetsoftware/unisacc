#pragma unisa use sys.fd
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.io
/* Narrow check for sys.fd. One byte through a duplicated pipe end.
   sh ./unisacc.com tools/check-cx-sys-fd.cx */
static int bad;
static void ok(int c, const char *n) {
    sy_printf("%s\t%s\n", c ? "PASS" : "FAIL", n);
    if (!c) bad = 1;
}
int main(void) {
    int p[2];
    int d;
    p[0] = -1;
    p[1] = -1;
    char b;
    ok(sy_dup(-1) == -EINVAL, "dup-neg");
    ok(sy_dup2(-1, 1) == -EINVAL, "dup2-neg-old");
    ok(sy_dup2(0, -1) == -EINVAL, "dup2-neg-new");
    ok(sy_pipe(p) == 0, "pipe");
    if (p[0] >= 0) {
        d = sy_dup(p[0]);
        ok(d >= 0 && d != p[0], "dup-new");
        ok(sy_dup2(p[0], p[0]) == p[0], "dup2-same");
        ok(sy_write_all(p[1], "Z", 1) == 0, "write");
        b = 0;
        ok(sy_read(d, &b, 1) == 1 && b == 'Z', "dup-reads");
        ok(sy_dup(999999) == -EBADF, "dup-bad");
        sy_close(d);
        sy_close(p[0]);
        sy_close(p[1]);
    }
    sy_printf("CX_SYS_FD\tfailed=%d\n", bad);
    return bad;
}
