/* Product-facing classic18 functional gate (C44 draft; mergeable).
 * New-weight netcore + gold infer via nets.cx; candidate must not be Root APE.
 *
 *   --neg-root-as-candidate ROOT EVIDENCE NEW_OUT
 *   --design-smoke ROOT BUILT EVIDENCE MATERIALS_PARENT NEW_OUT [NET]
 *   --gate ROOT CANDIDATE BUILT EVIDENCE MATERIALS_PARENT NEW_OUT [NET]
 *
 * MATERIALS_PARENT/<stage>/ or .../c43-<stage>-partition-merge-01/
 * BUILT = private emit tree with kernel/weight.*.inc matching materials.
 * design-smoke always NOT_READY (Root may run CX; not a product PASS).
 * --gate refuses candidate sha == Root unisacc.com, runs nets (+ --check-oracle).
 * Does not yet prove APE embeds BUILT MODEL (needs GEN pin); not N22/install.
 */
#pragma unisa use cxlib.netpack
static const char *stages[18]={"pp","lex","parse","type","scope","irsel","enc","reloc","regmap","tyinfo","pfconv","peep","opinfo","prec","binsel","isel","abi","combo"};
static char root[4096],cand[4096],built[4096],evidence[4096],mats[4096],out[4096],overlay[4400],netmat[4400];
static void die(const char *s){fprintf(stderr,"classic18-product-nets: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void path(char *p,size_t cap,const char *a,const char *b){int n=snprintf(p,cap,"%s/%s",a,b);if(n<0||(size_t)n>=cap)die("path-bound");}
static char *load(const char *p,size_t *n){struct stat a,b;errno=0;if(lstat(p,&a))die(errno==ENOENT?"input-absent":"input-stat");if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>16777216)die("bounded-regular-input");int fd=open(p,O_RDONLY|O_CLOEXEC|O_NONBLOCK|O_NOFOLLOW);if(fd<0)die("input-open");if(fstat(fd,&b)||!S_ISREG(b.st_mode)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size){close(fd);die("input-descriptor");}*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s){close(fd);die("allocation");}size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0){close(fd);die("input-extent");}at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int changed=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(z||changed||closed){free(s);die("input-changed-or-close");}s[*n]=0;return s;}
static void digest(const char *p,char h[65]){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,h);free(s);}
static void save(const char *p,const char *s,size_t n){int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive-output");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0){close(fd);die("output-write");}at+=(size_t)z;}int synced=fsync(fd),closed=close(fd);if(synced||closed)die("output-close");}
static void field(const char *s,const char *key,char *outb,size_t cap){char tag[120];int z=snprintf(tag,sizeof tag,"\n%s\t",key);if(z<0||z>=(int)sizeof tag)die("field-key");const char *p=strstr(s,tag);if(!p||strstr(p+1,tag))die("field-missing-or-duplicate");p+=z;const char *e=strchr(p,'\n');if(!e||e==p||e-p>=(ptrdiff_t)cap)die("field-bound");memcpy(outb,p,(size_t)(e-p));outb[e-p]=0;}
static int nybble(char c){if(c>='0'&&c<='9')return c-'0';if(c>='a'&&c<='f')return c-'a'+10;return -1;}
static np_buf literal(const char *file){size_t n;char *s=load(file,&n);if(memchr(s,0,n))die("literal-nul");char *p=strstr(s,"*/");if(!p)die("literal-comment");p+=2;np_buf b={0};while(*p){while(*p==' '||*p=='\t'||*p=='\n'||*p=='\r')p++;if(!*p)break;if(*p!='"')die("literal-quote");p++;while(*p&&*p!='"'){if(!p[1]||!p[2]||!p[3]||p[0]!='\\'||p[1]!='x'||nybble(p[2])<0||nybble(p[3])<0)die("literal-hex");char c=(char)((nybble(p[2])<<4)|nybble(p[3]));np_put(&b,&c,1);p+=4;}if(*p!='"')die("literal-close");p++;}free(s);return b;}
static void mat_dir(char *p,size_t cap,const char *stage){char a[4400],b[4400];struct stat st;path(a,sizeof a,mats,stage);if(!lstat(a,&st)&&S_ISDIR(st.st_mode)){if(snprintf(p,cap,"%s",a)>=(int)cap)die("mat-path");return;}{int z=snprintf(b,sizeof b,"%s/c43-%s-partition-merge-01",mats,stage);if(z<0||(size_t)z>=sizeof b)die("mat-alt");}if(!lstat(b,&st)&&S_ISDIR(st.st_mode)){if(snprintf(p,cap,"%s",b)>=(int)cap)die("mat-path");return;}die("material-directory-absent");}
static void join3(char *p,size_t cap,const char *a,const char *b,const char *c){char mid[4400];path(mid,sizeof mid,a,b);path(p,cap,mid,c);}
static void bind_evidence(const char *product_sha){char p[4400],got[4096];size_t n;path(p,sizeof p,evidence,"evidence.tsv");char *s=load(p,&n);if(n<40||strncmp(s,"classic18-private-evidence-v1\n",30)||!strstr(s,"\nstatus\tEVIDENCE_ONLY\n"))die("evidence-wire");field(s,"product-sha256",got,sizeof got);if(strcmp(got,product_sha))die("evidence-product-mismatch");field(s,"pp-authority",got,sizeof got);if(strncmp(got,"gold-table-partition-7cbdb9cc",28))die("evidence-pp-authority");free(s);}
static void bind_materials_and_built(void){char mdir[4400],mp[4400],wp[4400],dp[4400],lp[4400],h[65],want[65],rel[80];for(int i=0;i<18;i++){mat_dir(mdir,sizeof mdir,stages[i]);path(mp,sizeof mp,mdir,"material.tsv");size_t n;char *mr=load(mp,&n);if(strncmp(mr,"gold-partition-material-v1\n",27))die("material-wire");field(mr,"stage",want,sizeof want);if(strcmp(want,stages[i]))die("material-stage");field(mr,"weights-sha256",want,sizeof want);path(mp,sizeof mp,mdir,"weights.bin");digest(mp,h);if(strcmp(h,want))die("material-weight-digest");if(i==0&&strcmp(h,"7cbdb9ccef371dbcdb45fc60b612c2139292eafc81de3ceb15fcd7dcc37fca48"))die("pp-authority-material");free(mr);snprintf(rel,sizeof rel,"weight.%s.inc",stages[i]);join3(wp,sizeof wp,built,"kernel",rel);np_buf lit=literal(wp);path(mp,sizeof mp,mdir,"weights.bin");size_t wn;char *w=load(mp,&wn);int ok=lit.n==wn&&!memcmp(lit.p,w,wn);free(lit.p);free(w);if(!ok)die("built-weight-not-material");snprintf(rel,sizeof rel,"dense.%s.inc",stages[i]);join3(dp,sizeof dp,built,"kernel",rel);join3(lp,sizeof lp,root,"kernel",rel);np_buf a=literal(dp),b=literal(lp);ok=a.n==b.n&&!memcmp(a.p,b.p,a.n);free(a.p);free(b.p);if(!ok)die("built-dense-not-live");}}
static void make_overlay(void){path(overlay,sizeof overlay,out,"overlay");if(mkdir(overlay,0700))die("overlay-mkdir");DIR *d=opendir(root);if(!d)die("root-list");for(;;){errno=0;struct dirent *e=readdir(d);if(!e){int err=errno;if(closedir(d)||err)die("root-list-close");break;}if(!strcmp(e->d_name,".")||!strcmp(e->d_name,".."))continue;if(strchr(e->d_name,'/'))die("root-name");char src[4400],dst[4400];path(src,sizeof src,root,e->d_name);path(dst,sizeof dst,overlay,e->d_name);if(symlink(src,dst))die("overlay-symlink");}char kdst[4400],ksrc[4400];path(kdst,sizeof kdst,overlay,"kernel");if(unlink(kdst)&&errno!=ENOENT)die("overlay-unlink-kernel");path(ksrc,sizeof ksrc,built,"kernel");if(symlink(ksrc,kdst))die("overlay-kernel-link");}
static void run_net_material(void){char product[4400],bound[4400],tool[4400],why[1400];path(netmat,sizeof netmat,out,"nets-material");path(product,sizeof product,root,"unisacc.com");path(bound,sizeof bound,root,"tools/bound");path(tool,sizeof tool,root,"tools/net-material.cx");char *v[]={bound,"30","sh",product,tool,"--",overlay,netmat,0};np_result r;if(np_run(v,root,0,35,&r,why,sizeof why))die(why);const char *want="PREPARED\tnet-material\tweights-reused\tno-test-result\n";int ok=!r.rc&&!r.errn&&r.outn==strlen(want)&&!memcmp(r.out,want,r.outn);if(!ok&&r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);if(!ok)die("net-material-prepare");}
static void run_nets(const char *runner,const char *only,char *summary,size_t cap){char bound[4400],batch[4400],why[1400];path(bound,sizeof bound,root,"tools/bound");path(batch,sizeof batch,netmat,"nets.cx");char *v_all[]={bound,"55","sh",(char *)runner,batch,"--",root,0};char *v_one[]={bound,"55","sh",(char *)runner,batch,"--",root,(char *)only,0};np_result r;if(np_run(only?v_one:v_all,root,0,58,&r,why,sizeof why))die(why);if(r.rc||r.errn||!r.outn||r.out[r.outn-1]!='\n'){if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);die("nets-batch");}if(r.outn>=cap)die("nets-summary-bound");memcpy(summary,r.out,r.outn);summary[r.outn]=0;if(!strstr(summary,"NETS\t")){np_free(&r);die("nets-missing-NETS-line");}np_free(&r);}
static void run_oracle(const char *runner,char *summary,size_t cap){char bound[4400],why[1400];path(bound,sizeof bound,root,"tools/bound");char *v[]={bound,"55","sh",(char *)runner,"--check-oracle",0};np_result r;if(np_run(v,root,0,58,&r,why,sizeof why))die(why);if(r.rc||r.errn){if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);die("check-oracle");}if(r.outn>=cap)die("oracle-summary-bound");memcpy(summary,r.out,r.outn);summary[r.outn]=0;np_free(&r);}
static int neg_root(void){char product[4400],hroot[65],hcand[65],p[4400];path(product,sizeof product,root,"unisacc.com");digest(product,hroot);if(!realpath(product,cand))die("candidate-path");digest(cand,hcand);if(mkdir(out,0700))die("fresh-out");if(strcmp(hroot,hcand))die("neg-expected-equal-sha");np_buf rec={0};np_puts(&rec,"classic18-product-nets-v1\nstatus\tREFUSED\nreason\tcandidate-equals-root-ape\nscope\tnegative-control-not-ready\nroot-ape-sha256\t");np_puts(&rec,hroot);np_puts(&rec,"\ncandidate-sha256\t");np_puts(&rec,hcand);np_puts(&rec,"\n");path(p,sizeof p,out,"receipt.tsv");save(p,rec.p,rec.n);free(rec.p);puts("REFUSED\tclassic18-product-nets\tcandidate-equals-root-ape\tNOT_READY");return 2;}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN classic18-product-nets requires Linux/x86_64 LP64\n",stderr);return 3;
#endif
 if(argc<2)die("usage");
 if(!strcmp(argv[1],"--neg-root-as-candidate")){if(argc!=5||!realpath(argv[2],root)||!realpath(argv[3],evidence)||argv[4][0]!='/'||strlen(argv[4])>=sizeof out)die("usage-neg");strcpy(out,argv[4]);return neg_root();}
 int design=!strcmp(argv[1],"--design-smoke"),gate=!strcmp(argv[1],"--gate");if(!design&&!gate)die("unknown-mode");
 int need=gate?8:7;const char *only=0;if(argc!=need&&argc!=need+1)die("usage-smoke-or-gate");
 if(!realpath(argv[2],root))die("root");if(gate&&!realpath(argv[3],cand))die("candidate");
 if(!realpath(argv[gate?4:3],built)||!realpath(argv[gate?5:4],evidence)||!realpath(argv[gate?6:5],mats))die("inputs");
 if(argv[gate?7:6][0]!='/'||strlen(argv[gate?7:6])>=sizeof out)die("out");strcpy(out,argv[gate?7:6]);if(argc==need+1)only=argv[need];
 if(mkdir(out,0700))die("fresh-out");
 char product[4400],hroot[65],hcand[65];path(product,sizeof product,root,"unisacc.com");digest(product,hroot);
 if(gate){digest(cand,hcand);if(!strcmp(hroot,hcand))die("candidate-equals-root-ape");}else{strcpy(cand,product);strcpy(hcand,hroot);}
 bind_evidence(hroot);bind_materials_and_built();make_overlay();run_net_material();
 char nets_out[65536],oracle_out[8192];oracle_out[0]=0;run_nets(gate?cand:product,only,nets_out,sizeof nets_out);
 if(gate)run_oracle(cand,oracle_out,sizeof oracle_out);
 np_buf rec={0};np_puts(&rec,"classic18-product-nets-v1\nstatus\t");np_puts(&rec,gate?"EXECUTED":"NOT_READY");np_puts(&rec,"\nscope\t");np_puts(&rec,gate?"candidate-runner-new-weight-netcore-gold-infer":"design-smoke-root-runner-new-weight-netcore-not-product-pass");np_puts(&rec,"\nroot-ape-sha256\t");np_puts(&rec,hroot);np_puts(&rec,"\nrunner-sha256\t");np_puts(&rec,hcand);np_puts(&rec,"\nbuilt\t");np_puts(&rec,built);np_puts(&rec,"\nevidence\t");np_puts(&rec,evidence);np_puts(&rec,"\ncoverage-gap\tcandidate-MODEL-embed-vs-BUILT-requires-GEN-pin-or-extract\ncheck-oracle\t");np_puts(&rec,gate?"ran-on-candidate":"skipped-design-smoke");np_puts(&rec,"\n");
 char p[4400];path(p,sizeof p,out,"nets.stdout");save(p,nets_out,strlen(nets_out));if(gate&&oracle_out[0]){path(p,sizeof p,out,"oracle.stdout");save(p,oracle_out,strlen(oracle_out));}
 path(p,sizeof p,out,"receipt.tsv");save(p,rec.p,rec.n);free(rec.p);
 printf("%s\tclassic18-product-nets\trunner=%s\tnets=executed\toracle=%s\n",gate?"GATE":"NOT_READY",gate?"candidate":"root-design-only",gate?"ran":"skipped");
 return gate?0:3;
}
