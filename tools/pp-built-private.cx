/* Construct a private built.json pp entry from verified six-cube weights, then
 * run the native kernel emitter (tools/kernel-emit.cx --built) into a private root. No live source
 * or kernel file is changed. ROOT PP_MATERIAL NEW_ABS_OUT. */
#pragma unisa use cxlib.netpack
static char root[4096],mat[4096],out[4096];
static void die(const char *s){fprintf(stderr,"pp-built-private: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void copy_fit(char *dst, size_t cap, const char *src){size_t i=0;if(cap==0)die("copy-bound");while(src[i]&&i+1<cap){dst[i]=src[i];i++;}if(src[i])die("copy-bound");dst[i]=0;}
static void path(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path-bound");}
static char *load(const char *p,size_t *n){struct stat a,b;errno=0;if(lstat(p,&a))die(errno==ENOENT?"input-absent":"input-stat");if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>16777216)die("bounded-regular-input");int fd=open(p,O_RDONLY|O_CLOEXEC|O_NONBLOCK|O_NOFOLLOW);if(fd<0)die("input-open");if(fstat(fd,&b)||!S_ISREG(b.st_mode)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size){close(fd);die("input-descriptor");}*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s){close(fd);die("allocation");}size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0){close(fd);die("input-extent");}at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int changed=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(z||changed||closed){free(s);die("input-changed-or-close");}s[*n]=0;return s;}
static void save(const char *p,const char *s,size_t n){int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive-output");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0){close(fd);die("output-write");}at+=(size_t)z;}int synced=fsync(fd),closed=close(fd);if(synced||closed)die("output-close");}
static void number(np_buf *b,int x){char s[40];int n=snprintf(s,sizeof s,"%d",x);if(n<0||n>=(int)sizeof s)die("number-bound");np_put(b,s,(size_t)n);}
static unsigned long long le(const unsigned char *p,int n){unsigned long long v=0;for(int i=n-1;i>=0;i--)v=(v<<8)|p[i];return v;}
static void verify_material(void){char product[4400],bound[4400],tool[4400],why[1400];path(product,root,"unisacc.com");path(bound,root,"tools/bound");path(tool,root,"tools/pp-gold-material.cx");char *v[]={bound,"20","sh",product,tool,"--","--verify",root,mat,0};np_result r;if(np_run(v,root,0,23,&r,why,sizeof why))die(why);const char *want="VERIFIED\tpp-gold-material\tno-test-result\n";int good=!r.rc&&!r.errn&&r.outn==strlen(want)&&!memcmp(r.out,want,r.outn);if(!good&&r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);if(!good)die("pp-material-current-verification");}
static np_buf pp_json(const unsigned char *w,size_t n){if(n!=142||le(w+96,4)!=6)die("pp-model-extent-or-entries");unsigned long long masks[6][2];int cls[6],wei[6];for(int j=0;j<6;j++){masks[j][0]=le(w+j*16,8);masks[j][1]=le(w+j*16+8,8);const unsigned char *e=w+100+j*7;if(masks[j][0]>511||masks[j][1]>3||!masks[j][0]&&!masks[j][1]||le(e,2)!=(unsigned)j||e[2]||le(e+3,2)>3||le(e+5,2)>16)die("pp-model-structure");cls[j]=(int)le(e+3,2);wei[j]=(int)le(e+5,2);if(wei[j]!=1)die("pp-canonical-one-weight");}for(int a=0;a<9;a++)for(int b=0;b<2;b++){int hit=0;for(int j=0;j<6;j++)if((!masks[j][0]||(masks[j][0]>>a&1))&&(!masks[j][1]||(masks[j][1]>>b&1)))hit++;if(hit!=1)die("pp-not-disjoint-total");}
 np_buf p={0};np_puts(&p,"{\"H\":6,\"b1\":[");for(int j=0;j<6;j++){if(j)np_puts(&p,",");number(&p,1-(masks[j][0]!=0)-(masks[j][1]!=0));}np_puts(&p,"],\"feeds\":[");for(int c=0;c<11;c++){if(c)np_puts(&p,",");np_puts(&p,"[");int first=1;for(int j=0;j<6;j++){unsigned long long mask=c<9?masks[j][0]:masks[j][1];int bit=c<9?c:c-9;if(mask>>bit&1){if(!first)np_puts(&p,",");number(&p,j);first=0;}}np_puts(&p,"]");}np_puts(&p,"],\"heads\":[[\"y\",[\"take\",\"skip\",\"pop\",\"macro\"]]],\"maxlogit\":1,\"offs\":[0,9],\"stage\":\"pp\",\"w2\":{\"y\":[");for(int j=0;j<6;j++){if(j)np_puts(&p,",");np_puts(&p,"[[");number(&p,cls[j]);np_puts(&p,",");number(&p,wei[j]);np_puts(&p,"]]");}np_puts(&p,"]}}");return p;}
static char *pp_start(char *s,size_t n){const char *tag="\"pp\":";char *p=strstr(s,tag);if(!p||strstr(p+1,tag)||p[5]!='{')die("unique-pp-json-member");return p+5;}
static char *object_end(char *s,size_t n){int depth=0,string=0,escape=0;for(size_t i=0;i<n;i++){char c=s[i];if(string){if(escape)escape=0;else if(c=='\\')escape=1;else if(c=='\"')string=0;continue;}if(c=='\"'){string=1;continue;}if(c=='{')depth++;else if(c=='}'&&--depth==0)return s+i+1;else if(c=='}'&&depth<0)die("json-object-depth");}die("json-object-end");return 0;}
static int nybble(char c){if(c>='0'&&c<='9')return c-'0';if(c>='a'&&c<='f')return c-'a'+10;return -1;}
static np_buf literal(const char *file){size_t n;char *s=load(file,&n),*p=strstr(s,"*/");if(!p)die("generated-literal-comment");p+=2;np_buf b={0};while(*p){while(*p==' '||*p=='\t'||*p=='\n'||*p=='\r')p++;if(!*p)break;if(*p!='\"')die("generated-literal-quote");p++;while(*p&&*p!='\"'){if(!p[1]||!p[2]||!p[3]||p[0]!='\\'||p[1]!='x'||nybble(p[2])<0||nybble(p[3])<0)die("generated-literal-hex");char c=(char)((nybble(p[2])<<4)|nybble(p[3]));np_put(&b,&c,1);p+=4;}if(*p!='\"')die("generated-literal-close");p++;}free(s);return b;}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN pp-built-private requires Linux/x86_64 LP64\n",stderr);return 3;
#endif
 if(argc!=4||sizeof(long)!=8||!realpath(argv[1],root)||!realpath(argv[2],mat)||argv[3][0]!='/'||strlen(argv[3])>=sizeof out||strpbrk(argv[3],"\r\n\t"))die("usage-ROOT-PP-MATERIAL-NEW-ABS-OUT");copy_fit(out,sizeof out,argv[3]);verify_material();
 char src[4400],dst[4400],h[65],oldh[65],newh[65];path(src,mat,"pp.weights");size_t wn;char *w=load(src,&wn);cx_sha256_hex(w,wn,h);np_buf p=pp_json((const unsigned char *)w,wn);
 path(src,root,"weights/built.json");size_t bn;char *old=load(src,&bn);if(memchr(old,0,bn)||!bn||old[0]!='{'||old[bn-1]!='}')die("built-json-wire");cx_sha256_hex(old,bn,oldh);char *a=pp_start(old,bn),*z=object_end(a,bn-(size_t)(a-old));np_buf built={0};np_put(&built,old,(size_t)(a-old));np_put(&built,p.p,p.n);np_puts(&built,z);free(p.p);free(old);cx_sha256_hex(built.p,built.n,newh);
 if(mkdir(out,0700))die("fresh-output-required");path(dst,out,"weights");if(mkdir(dst,0700))die("private-weights-directory");path(dst,out,"kernel");if(mkdir(dst,0700))die("private-kernel-directory");path(src,root,"include");path(dst,out,"include");if(symlink(src,dst))die("private-include-link");path(dst,out,"weights/built.json");save(dst,built.p,built.n);free(built.p);
 /* the native emitter (tools/kernel-emit.cx, byte-equal to the retired python3 -m unisa emit-kernel) over the private built.json */
 char bound[4400],why[1400],com[4400],tool[4400],kdir[4400],bjson[4400];path(bound,root,"tools/bound");path(com,root,"unisacc.com");path(tool,root,"tools/kernel-emit.cx");path(kdir,out,"kernel");path(bjson,out,"weights/built.json");
 char *v[]={bound,"35","sh",com,tool,"--","--write",root,kdir,"--built",bjson,0};char *env[]={0};np_result r;if(np_run(v,root,env,38,&r,why,sizeof why))die(why);if(r.rc||r.errn){if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);die("private-kernel-emitter");}np_free(&r);
 path(src,out,"kernel/weight.pp.inc");np_buf actual=literal(src);if(actual.n!=wn||memcmp(actual.p,w,wn))die("emitted-pp-not-material");free(actual.p);free(w);path(src,out,"kernel/dense.pp.inc");np_buf dense=literal(src);path(dst,root,"kernel/dense.pp.inc");np_buf baseline=literal(dst);if(dense.n!=18||baseline.n!=18||memcmp(dense.p,baseline.p,18))die("dense-pp-changed");char dh[65];cx_sha256_hex(dense.p,dense.n,dh);free(dense.p);free(baseline.p);
 const char *stages[]={"lex","parse","type","scope","irsel","enc","reloc","regmap","tyinfo","pfconv","peep","opinfo","prec","binsel","isel","abi","combo"};for(int i=0;i<17;i++)for(int kind=0;kind<2;kind++){char rel[100];int z=snprintf(rel,sizeof rel,"kernel/%s.%s.inc",kind?"dense":"weight",stages[i]);if(z<0||z>=(int)sizeof rel)die("stage-path");path(src,out,rel);path(dst,root,rel);np_buf now=literal(src),was=literal(dst);int same=now.n==was.n&&!memcmp(now.p,was.p,now.n);free(now.p);free(was.p);if(!same)die("other-seventeen-model-bytes-changed");}
 np_buf receipt={0};np_puts(&receipt,"pp-built-private-v1\nstatus\tPREPARED\nscope\tprivate-built-json-and-native-emitter-no-live-product-change\npp.weights\t");np_puts(&receipt,h);np_puts(&receipt,"\nold-built.json\t");np_puts(&receipt,oldh);np_puts(&receipt,"\nprivate-built.json\t");np_puts(&receipt,newh);np_puts(&receipt,"\ndense.pp\t");np_puts(&receipt,dh);np_puts(&receipt,"\nother-seventeen\tweight-and-dense-bytes-unchanged\nemitter\ttools/kernel-emit.cx --write ROOT kernel --built weights/built.json\n");path(dst,out,"receipt.tsv");save(dst,receipt.p,receipt.n);free(receipt.p);printf("PREPARED\tpp-built-private\tpp=%s\tbuilt=%s\tdense=%s\tother-stages=17-unchanged\n",h,newh,dh);return 0;
}
