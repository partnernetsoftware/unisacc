/* Test-only L4 persistence controls; never linked into the product. */
#pragma unisa use sys.proc
int main(void){
    char *v[]={"sh","./unisacc.com","tests/cases/model_image/check_cache.cx",0};
    char *out=0;size_t n=0;int rc=cx_runv_timeout(v,50,&out,&n);
    if(out&&n&&fwrite(out,1,n,stdout)!=n){free(out);return 2;}
    free(out);return rc;
}
