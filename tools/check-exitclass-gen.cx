/* check-exitclass-gen: tools/exitclass-gen.cx contract.
 *   sh ./unisacc.com tools/check-exitclass-gen.cx [-- WORK]
 * WORK defaults to out. Compiles the generator once, then:
 *   check-tree rc 0; fixture write then check rc 0; one-byte drift rc 1; bad class rc 2. */
#pragma unisa use cxlib.toolprep
#pragma unisa use sys.fs
#pragma unisa use sys.proc
static int failed, checks;
static char fix[2600], tbl[2700], lib[2700], cmd[6000], outb[4000], native[2800];
static void ck(int ok, const char *n) { checks++; if (!ok) failed++; printf("%s\texitclass-gen.%s\n", ok ? "PASS" : "FAIL", n); }
static int has(const char *s, const char *w) {
    size_t n = strlen(s), k = strlen(w);
    for (size_t i = 0; i + k <= n; i++) if (!memcmp(s + i, w, k)) return 1;
    return 0;
}
static int sh(const char *c, char *out, int cap) {
    char *v[] = {"sh", "-c", (char *)c, 0}, *text = 0; size_t n = 0, i; int rc = cx_runv_timeout(v, 40, &text, &n);
    for (i = 0; text && i < n && (int)i < cap - 1; i++) out[i] = text[i];
    out[text && (int)n < cap - 1 ? n : (size_t)(text ? cap - 1 : 0)] = 0;
    free(text);
    if (rc < 0 || rc >= 124) return -1;
    return rc;
}
static const char *ROW = "-9\tSIGKILL\tRETRYABLE\ttools/chain-run.cx:333\n2\tREFUSE\tDETERMINISTIC\ttools/chain-verdict.cx:88\n";
int main(int argc, char **argv) {
    char root[2048], why[256];
    const char *work = argc >= 2 && argv[1][0] != '-' ? argv[1] : "out";
    if (argc > 2 || strlen(work) > 2400 || strchr(work, '\'')) { fprintf(stderr, "check-exitclass-gen: usage [WORK]\n"); return 2; }
    if (!getcwd(root, sizeof root)) return 2;
    if (cx_fmt(fix, sizeof fix, "%s/exitclass-gen-fixture-%d", work, sy_pid())
        || cx_fmt(tbl, sizeof tbl, "%s/build/exit-classes.tsv", fix)
        || cx_fmt(lib, sizeof lib, "%s/tools/cxlib/exitclass.cx", fix)
        || cx_fmt(native, sizeof native, "%s/exitclass-gen-native", work)) return 2;
    if (tq_native(root, "tools/exitclass-gen.cx", native, why, sizeof why)) { fprintf(stderr, "check-exitclass-gen: %s\n", why); return 2; }
    if (cx_fmt(cmd, sizeof cmd, "mkdir -p '%s/build' '%s/tools/cxlib'", fix, fix) || sh(cmd, outb, sizeof outb) != 0) { printf("FAIL\tfixture\n"); return 2; }
    if (cx_fmt(cmd, sizeof cmd, "'%s' --check '%s' 2>&1", native, root)) return 2;
    ck(sh(cmd, outb, sizeof outb) == 0 && has(outb, "status=CHECK"), "check-tree");
    if (cx_write(tbl, ROW, strlen(ROW))) { printf("FAIL\twrite-table\n"); return 2; }
    if (cx_fmt(cmd, sizeof cmd, "'%s' --write '%s' 2>&1", native, fix)) return 2;
    ck(sh(cmd, outb, sizeof outb) == 0 && has(outb, "status=WRITE"), "write");
    if (cx_fmt(cmd, sizeof cmd, "'%s' --check '%s' 2>&1", native, fix)) return 2;
    ck(sh(cmd, outb, sizeof outb) == 0 && has(outb, "status=CHECK"), "check-fixture");
    { size_t n = 0; char *s = cx_read(lib, &n);
      if (s && n > 10) { s[n - 3] = s[n - 3] == 'x' ? 'y' : 'x'; ck(!cx_write(lib, s, n) && sh(cmd, outb, sizeof outb) == 1 && has(outb, "DIFF"), "neg-drift"); }
    if (cx_write(tbl, "9\tBAD\tMAYBE\ttools/chain-run.cx:1\n", strlen("9\tBAD\tMAYBE\ttools/chain-run.cx:1\n"))) return 2;
      free(s); }
    if (cx_fmt(cmd, sizeof cmd, "'%s' --write '%s' 2>&1", native, fix)) return 2;
    ck(sh(cmd, outb, sizeof outb) == 2 && has(outb, "REFUSE"), "neg-class");
    printf("CHECK_EXITCLASS_GEN\tchecks=%d\tfailed=%d\n", checks, failed);
    return failed ? 1 : 0;
}
