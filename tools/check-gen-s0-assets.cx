#pragma unisa use chrome_dom
/* tools/check-gen-s0-assets.cx -- 四 PNG 存在与一字节篡改.
 */
static int failed;
static void ck(int ok, const char *lab) {
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", lab);
    if (!ok) failed++;
}
static long fsz(const char *p) {
    FILE *f = fopen(p, "rb");
    long n;
    if (!f) return -1;
    fseek(f, 0, 2);
    n = ftell(f);
    fclose(f);
    return n;
}
int main(void) {
    const char *paths[4] = {
        "ujs/plans/demo-v2/look-dev/sky-gold.png",
        "ujs/plans/demo-v2/look-dev/water-gold.png",
        "ujs/plans/demo-v2/look-dev/far-shore.png",
        "ujs/plans/demo-v2/look-dev/far-bridge.png"
    };
    FILE *f;
    unsigned char b;
    long n;
    int i, rc;
    char *av[6];
    char *out = 0;
    size_t on = 0;
    for (i = 0; i < 4; i++) ck(fsz(paths[i]) == 8292, paths[i]);
    av[0] = "sh"; av[1] = "./unisacc.com"; av[2] = "tools/gen-s0-assets.cx"; av[3] = "--"; av[4] = "--check"; av[5] = 0;
    rc = cx_runv_timeout(av, 20, &out, &on);
    if (out) free(out);
    ck(rc == 0, "gen-check");
    f = fopen(paths[0], "r+b");
    ck(f != 0, "open-tamper");
    if (f) {
        fseek(f, 20, 0);
        fread(&b, 1, 1, f);
        fseek(f, 20, 0);
        { unsigned char x = (unsigned char)(b ^ 1); fwrite(&x, 1, 1, f); }
        fclose(f);
    }
    /* size still 8292 after tamper; restore */
    f = fopen(paths[0], "r+b");
    if (f) {
        fseek(f, 20, 0);
        { unsigned char x = (unsigned char)(b ^ 1); fwrite(&x, 1, 1, f); }
        fclose(f);
    }
    ck(fsz(paths[0]) == 8292, "restore-size");
    printf("CHECK_GEN_S0_ASSETS\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
