#pragma unisa use cxlib.ckassert
#pragma unisa use chrome_dom
/* tools/check-gen-s0-assets.cx -- 四 PNG 存在与一字节篡改.
 */
static int failed;
static long fsz(const char *p) {
    FILE *f = fopen(p, "rb");
    long n;
    if (!f) return -1;
    fseek(f, 0, 2);
    n = ftell(f);
    fclose(f);
    return n;
}
int main(void) {
    const char *paths[] = {
        "ujs/plans/demo-v2/look-dev/far-shore.png",
        "ujs/plans/demo-v2/look-dev/far-bridge.png",
        "ujs/plans/demo-v2/look-dev/bow-lamp.png",
        "ujs/plans/demo-v2/look-dev/sky-gradient.png"
    };
    FILE *f;
    unsigned char b;
    long n;
    int i, rc;
    char *av[6];
    char *out = 0;
    size_t on = 0;
    for (i = 0; i < 4; i++) ck_record(&failed, fsz(paths[i]) == 8292, paths[i]);

    av[0] = "sh"; av[1] = "./unisacc.com"; av[2] = "tools/gen-s0-assets.cx"; av[3] = "--"; av[4] = "--check"; av[5] = 0;
    rc = cx_runv_timeout(av, 20, &out, &on);
    if (out) free(out);
    ck_record(&failed, rc == 0, "gen-check");
    f = fopen(paths[0], "r+b");
    ck_record(&failed, f != 0, "open-tamper");
    if (f) {
        fseek(f, 20, 0);
        fread(&b, 1, 1, f);
        fseek(f, 20, 0);
        { unsigned char x = (unsigned char)(b ^ 1); fwrite(&x, 1, 1, f); }
        fclose(f);
    }
    out = 0; on = 0;
    rc = cx_runv_timeout(av, 20, &out, &on);
    if (out) { fwrite(out, 1, on, stdout); free(out); }
    ck_record(&failed, rc != 0, "tamper-diff");
    av[4] = "--write";
    out = 0; on = 0;
    rc = cx_runv_timeout(av, 20, &out, &on);
    if (out) free(out);
    av[4] = "--check";
    out = 0; on = 0;
    rc = cx_runv_timeout(av, 20, &out, &on);
    if (out) free(out);
    ck_record(&failed, rc == 0, "restore-ok");


    printf("CHECK_GEN_S0_ASSETS\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
