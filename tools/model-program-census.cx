/* Physical representation census, not semantic decision ownership. Formal decoder validates;
 * this parser only locates binary section spans. No compression bytes are apportioned. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use runtime.codec
#pragma unisa use runtime.packagefooter
#pragma unisa use runtime.package_decode
#pragma unisa use runtime.package_lifetime
#pragma unisa use runtime.model_decode
#pragma unisa use runtime.model_lifetime
#pragma unisa use runtime.model_number
#pragma unisa use compiler.bindstage
static int arity[1024],nops;
static long totals[10],models,kinds[2];static char arity_sha[65];
static void fail(const char *s){fprintf(stderr,"MODEL_PROGRAM_CENSUS REFUSE %s\n",s);exit(2);}
static void *alloc(void *p,size_t n){return realloc(p,n?n:1);}
static unsigned char *load(const char *p,size_t *n){unsigned char *s=(unsigned char *)cx_read(p,n);if(!s)fail(p);return s;}
static void ops(const char *p){size_t n;char *s=(char *)load(p,&n),*at=s;if(sy_sha256_hex(s,n,arity_sha))cx_sha256_hex(s,n,arity_sha);for(int i=0;i<1024;i++)arity[i]=-1;while(*at){char *e=strchr(at,'\n');if(e)*e=0;if(*at&&*at!='#'){char *a=strchr(at,'\t');if(!a)fail("arity schema");char *b=strchr(a+1,'\t');if(!b||strchr(b+1,'\t'))fail("arity schema");*b=0;char *end;long ix=strtol(a+1,&end,10);if(*end||ix!=nops||ix>=1024)fail("arity index order");long count=strtol(b+1,&end,10);if(*end||count<0||count>32)fail("arity value");arity[nops++]=count;}if(!e)break;at=e+1;}free(s);if(!nops)fail("empty arity");}
static long long number(const unsigned char *s,long n,long *at){long long v;if(cxmn_number(s,n,at,1,&v))fail("binary number");return v;}
static int tag(const unsigned char *s,long n,long *at){int v;if(cxmn_tag(s,n,at,1,&v))fail("binary tag");return v;}
static long skip_actions(const CxModel *m,long from,long actions){for(long i=0;i<actions;i++){if(from<0||from>=m->nqa)fail("decoded action extent");long op=m->qa[from];if(op<0||op>=nops||arity[op]<0)fail("action arity index");from+=1+arity[op];if(from>m->nqa)fail("decoded operand extent");}return from;}
static void model(const unsigned char *s,long n,long stored,long index){CxDecode d={0};d.allocate=alloc;d.release=free;if(cxmd_decode(&d,s,n))fail(d.why?d.why:"decode");CxModel *m=&d.model;if(n<8||memcmp(s,"UNINETB1",8))fail("only UNINETB1 section measurement supported");long at=8;int kind=tag(s,n,&at);long ns=number(s,n,&at),nq=number(s,n,&at);number(s,n,&at);long nstr=number(s,n,&at);number(s,n,&at);if(kind=='N')number(s,n,&at);if(ns!=m->ns||nq!=m->nq||nstr!=m->nstr)fail("decoded header count mismatch");long header=at;
for(long i=0;i<nstr;i++){if(tag(s,n,&at)!='S')fail("string tag");long z=number(s,n,&at);if(z<0||z>n-at||z!=m->strl[i]||memcmp(s+at,m->str[i],z))fail("decoded string mismatch");at+=z;}long constants=at-header,startq=at,explicit_actions=0,expanded=0;
for(long q=0;q<nq;q++){int t=tag(s,n,&at);long prefix=0,count;if(t=='C'){long ref=number(s,n,&at);prefix=number(s,n,&at);count=number(s,n,&at);if(ref<0||ref>=q||prefix<1||prefix>m->qlen[ref])fail("prefix extent");}else if(t=='Q')count=number(s,n,&at);else fail("sequence tag");if(count<0||prefix+count!=m->qlen[q])fail("decoded qlen mismatch");long dest=skip_actions(m,m->qoff[q],prefix);for(long j=0;j<count;j++){long op=number(s,n,&at);if(op<0||op>=nops||arity[op]<0||dest>=m->nqa||m->qa[dest++]!=op)fail("action arity/opcode mismatch");for(int k=0;k<arity[op];k++){long long v=number(s,n,&at);if(dest>=m->nqa||m->qa[dest++]!=v)fail("decoded action operand mismatch");}}long expected=q+1<nq?m->qoff[q+1]:m->nqa;if(dest!=expected)fail("arity does not match decoded action extent");explicit_actions+=count;expanded+=m->qlen[q];}
long program=at-startq,selector=n-at,rows=0;if(selector<0)fail("section extent");for(int i=0;i<m->ns;i++)rows+=m->rowc[i];char sha[65];if(sy_sha256_hex(s,n,sha))cx_sha256_hex(s,n,sha);printf("MODEL\t%ld\tkind=%c\tstored=%ld\traw=%ld\traw_header=%ld\traw_constants=%ld\traw_action_program=%ld\traw_selector_bytes=%ld\tstates=%ld\trows=%ld\tsequences=%ld\tactions_explicit=%ld\tactions_expanded=%ld\tsha=%s\tconservation=EXACT\n",index,kind,stored,n,header,constants,program,selector,ns,rows,nq,explicit_actions,expanded,sha);long values[10]={n,header,constants,program,selector,ns,rows,nq,explicit_actions,expanded};for(int i=0;i<10;i++)totals[i]+=values[i];models++;kinds[m->isnet?1:0]++;cxml_release(m,free);}
static void package(const char *path){size_t n;unsigned char *s=load(path,&n);char hash[65];if(sy_sha256_hex(s,n,hash))cx_sha256_hex(s,n,hash);printf("PACKAGE_INPUT\tbytes=%ld\tsha=%s\n",(long)n,hash);PackageFooter f;long off=0,len=n;if(packagefooter_locate_bytes(s,n,&f)){off=f.package_offset;len=f.package_length;}CxPackageDecode d={0};d.allocate=alloc;d.release=free;if(cxpk_decode(&d,s+off,len))fail(d.why?d.why:"package decode");CxPackage *p=&d.package;CxCodecCrc crc;cxcodec_crc_init(&crc);for(int i=0;i<p->m;i++){const unsigned char *b=s+off+p->off[i];unsigned char *raw=0;long rn=p->raw[i];if(rn<=0||rn>67108864)fail("model raw bound");if(p->ver>=3){raw=malloc(rn);if(!raw||cxcodec_inflate(raw,rn,b,p->len[i]))fail("inflate");uint32_t actual;if(cxcodec_crc(&crc,(char *)raw,rn,&actual)||actual!=p->crc[i])fail("model crc");b=raw;}model(b,rn,p->len[i],i);free(raw);}p->file=0;cxpl_release(p,free);free(s);}
int main(int argc,char **argv){const char *arity_path="exec/facts/core-ops.tsv";for(int i=1;i<argc;i++)if(!strcmp(argv[i],"--arity")&&i+1<argc)arity_path=argv[++i];ops(arity_path);int modes=0;for(int i=1;i<argc;i++){if(!strcmp(argv[i],"--arity")&&i+1<argc)i++;else if(!strcmp(argv[i],"--model")&&i+1<argc){size_t n;unsigned char *s=load(argv[++i],&n);model(s,n,n,0);free(s);modes++;}else if(!strcmp(argv[i],"--package")&&i+1<argc){package(argv[++i]);modes++;}else fail("usage --model FILE | --package FILE [--arity PATH]");}if(!modes)fail("mode required");printf("KINDS\tdecision_table_T=%ld\tnetwork_selector_N=%ld\tarity_sha=%s\n",kinds[0],kinds[1],arity_sha);printf("MODEL_PROGRAM_CENSUS\tmodels=%ld\traw=%ld\traw_header=%ld\traw_constants=%ld\traw_action_program=%ld\traw_selector_bytes=%ld\tstates=%ld\trows=%ld\tsequences=%ld\tactions_explicit=%ld\tactions_expanded=%ld\tsemantic_decision_share=UNKNOWN\tcompressed_section_allocation=NONE\n",models,totals[0],totals[1],totals[2],totals[3],totals[4],totals[5],totals[6],totals[7],totals[8],totals[9]);return 0;}
