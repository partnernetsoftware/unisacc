/* tools/lex-attr-gen.cx -- generate exec/lex/attr-byte.tsv from exec/facts/lex-attr-whitelist.tsv.
 *   sh ./unisacc.com tools/lex-attr-gen.cx -- --write
 *   sh ./unisacc.com tools/lex-attr-gen.cx -- --check
 * Builds a deterministic byte-automaton trie for whitelisted __attribute__((...)) names:
 *   - constructor / destructor -> CF.kind1 / CF.kind2 -> ATW.after
 *   - visibility -> ATW.vis0 (accepts only visibility("default"), rejects hidden/protected/etc.)
 *   - 13 harmless attributes -> ATW.after (skips optional balanced (...) args, handles strings)
 *   - optional __name__ double-underscore form supported for every whitelisted name
 *   - all other attributes (aligned, packed, cleanup, section, weak, alias, naked, vector_size, unknown)
 *     -> HALT [["REJECT","not covered: attribute"]] */
#pragma unisa use sys.fs
#pragma unisa use text.text
#pragma unisa use mem.bytes

#define LAG_MAXN 512
#define LAG_OUT 131072

typedef struct {
    int ch[26]; /* 'a'..'z' */
    int u;      /* '_' */
    int term;   /* 0=none, 1=ctor, 2=dtor, 3=ignore, 4=vis_default */
} LagNode;

static LagNode lag_nodes[LAG_MAXN];
static int lag_nn = 1;
static char lag_buf[LAG_OUT];
static size_t lag_len = 0;

static void lag_put(const char *s) {
    size_t n = strlen(s);
    if (lag_len + n >= LAG_OUT) {
        fprintf(stderr, "lex-attr-gen: REFUSE output buffer overflow\n");
        exit(2);
    }
    if (mm_copy(lag_buf + lag_len, (long)(LAG_OUT - lag_len), s, (long)n)) exit(2);
    lag_len += n;
    lag_buf[lag_len] = 0;
}

static void lag_putf(const char *fmt, int a, int b, int c) {
    char tmp[256];
    if (cx_fmt(tmp, sizeof tmp, fmt, a, b, c)) exit(2);
    lag_put(tmp);
}

static int lag_new_node(void) {
    if (lag_nn >= LAG_MAXN) {
        fprintf(stderr, "lex-attr-gen: REFUSE trie node overflow\n");
        exit(2);
    }
    int id = lag_nn++;
    for (int i = 0; i < 26; i++) lag_nodes[id].ch[i] = -1;
    lag_nodes[id].u = -1;
    lag_nodes[id].term = 0;
    return id;
}

static void lag_insert(const char *name, int kind) {
    int cur = 0;
    for (const char *p = name; *p; p++) {
        int next = -1;
        if (*p >= 'a' && *p <= 'z') {
            int idx = *p - 'a';
            if (lag_nodes[cur].ch[idx] < 0) lag_nodes[cur].ch[idx] = lag_new_node();
            next = lag_nodes[cur].ch[idx];
        } else if (*p == '_') {
            if (lag_nodes[cur].u < 0) lag_nodes[cur].u = lag_new_node();
            next = lag_nodes[cur].u;
        } else {
            fprintf(stderr, "lex-attr-gen: REFUSE invalid char in attribute name: %s\n", name);
            exit(2);
        }
        cur = next;
    }
    if (lag_nodes[cur].term != 0) {
        fprintf(stderr, "lex-attr-gen: REFUSE duplicate attribute name: %s\n", name);
        exit(2);
    }
    lag_nodes[cur].term = kind;
}

static const char *lag_term_target(int kind) {
    if (kind == 1) return "CF.kind1";
    if (kind == 2) return "CF.kind2";
    if (kind == 4) return "ATW.vis0";
    return "ATW.after";
}

static const char *lag_term_tu1(int kind) {
    if (kind == 1) return "ATW.tu1.1";
    if (kind == 2) return "ATW.tu1.2";
    if (kind == 4) return "ATW.tu1.4";
    return "ATW.tu1.3";
}

static void lag_emit_dispatch_edges(const char *state) {
    char tmp[256];
    for (int c = 0; c < 26; c++) {
        if (lag_nodes[0].ch[c] >= 0) {
            if (cx_fmt(tmp, sizeof tmp, "%s\t%d\tATW.T%d\t[[\"ADV\"]]\n", state, 'a' + c, lag_nodes[0].ch[c])) exit(2);
            lag_put(tmp);
        }
    }
}

static void lag_generate(void) {
    lag_len = 0;
    lag_buf[0] = 0;
    lag_put("# Generated by tools/lex-attr-gen.cx from exec/facts/lex-attr-whitelist.tsv. Do not hand-edit.\n");
    lag_put("# state\tbyte\tnext\tactions\n");

    /* ATW.o1: after outer '(' of __attribute__(, expect '(' */
    lag_put("ATW.o1\t9,10,11,12,13,32\tATW.o1\t[[\"ADV\"]]\n");
    lag_put("ATW.o1\t40\tATW.item\t[[\"PUSH\",\"P\"],[\"ADV\"]]\n");
    lag_put("ATW.o1\t256\tHALT\t[[\"REJECT\",\"unterminated attribute or asm\"]]\n");
    lag_put("ATW.o1\t*\tHALT\t[[\"REJECT\",\"not covered: attribute\"]]\n");

    /* ATW.item: inside (( ... )), expect attribute name, ',', ')', or '__' prefix */
    lag_put("ATW.item\t9,10,11,12,13,32\tATW.item\t[[\"ADV\"]]\n");
    lag_put("ATW.item\t44\tATW.item\t[[\"ADV\"]]\n");
    lag_put("ATW.item\t41\tATW.c1\t[[\"POP\"],[\"ADV\"]]\n");
    lag_put("ATW.item\t95\tATW.u1\t[[\"ADV\"]]\n");
    lag_emit_dispatch_edges("ATW.item");
    lag_put("ATW.item\t256\tHALT\t[[\"REJECT\",\"unterminated attribute or asm\"]]\n");
    lag_put("ATW.item\t*\tHALT\t[[\"REJECT\",\"not covered: attribute\"]]\n");

    /* ATW.u1 / ATW.u2: optional leading '__' before attribute name */
    lag_put("ATW.u1\t95\tATW.u2\t[[\"ADV\"]]\n");
    lag_put("ATW.u1\t256\tHALT\t[[\"REJECT\",\"unterminated attribute or asm\"]]\n");
    lag_put("ATW.u1\t*\tHALT\t[[\"REJECT\",\"not covered: attribute\"]]\n");
    lag_emit_dispatch_edges("ATW.u2");
    lag_put("ATW.u2\t256\tHALT\t[[\"REJECT\",\"unterminated attribute or asm\"]]\n");
    lag_put("ATW.u2\t*\tHALT\t[[\"REJECT\",\"not covered: attribute\"]]\n");

    /* Trailing '__' check states for each kind 1..4 */
    for (int k = 1; k <= 4; k++) {
        char tmp[256];
        if (cx_fmt(tmp, sizeof tmp, "ATW.tu1.%d\t95\tATW.tu2.%d\t[[\"ADV\"]]\n", k, k)) exit(2); lag_put(tmp);
        if (cx_fmt(tmp, sizeof tmp, "ATW.tu1.%d\t256\tHALT\t[[\"REJECT\",\"unterminated attribute or asm\"]]\n", k)) exit(2); lag_put(tmp);
        if (cx_fmt(tmp, sizeof tmp, "ATW.tu1.%d\t*\tHALT\t[[\"REJECT\",\"not covered: attribute\"]]\n", k)) exit(2); lag_put(tmp);
        if (cx_fmt(tmp, sizeof tmp, "ATW.tu2.%d\t48-57,65-90,95,97-122\tHALT\t[[\"REJECT\",\"not covered: attribute\"]]\n", k)) exit(2); lag_put(tmp);
        if (cx_fmt(tmp, sizeof tmp, "ATW.tu2.%d\t256\tHALT\t[[\"REJECT\",\"unterminated attribute or asm\"]]\n", k)) exit(2); lag_put(tmp);
        if (cx_fmt(tmp, sizeof tmp, "ATW.tu2.%d\t*\t%s\t[]\n", k, lag_term_target(k))) exit(2); lag_put(tmp);
    }

    /* Trie states ATW.T1 .. ATW.T(lag_nn-1) */
    for (int id = 1; id < lag_nn; id++) {
        LagNode *nd = &lag_nodes[id];
        char tmp[256];
        for (int c = 0; c < 26; c++) {
            if (nd->ch[c] >= 0) {
                lag_putf("ATW.T%d\t%d\tATW.T%d\t[[\"ADV\"]]\n", id, 'a' + c, nd->ch[c]);
            }
        }
        if (nd->u >= 0) {
            lag_putf("ATW.T%d\t%d\tATW.T%d\t[[\"ADV\"]]\n", id, 95, nd->u);
        } else if (nd->term > 0) {
            if (cx_fmt(tmp, sizeof tmp, "ATW.T%d\t95\t%s\t[[\"ADV\"]]\n", id, lag_term_tu1(nd->term))) exit(2);
            lag_put(tmp);
        }
        if (nd->term > 0) {
            /* Reject if identifier continues with any non-matching ident char */
            for (int c = 0; c < 26; c++) {
                if (nd->ch[c] < 0) {
                    if (cx_fmt(tmp, sizeof tmp, "ATW.T%d\t%d\tHALT\t[[\"REJECT\",\"not covered: attribute\"]]\n", id, 'a' + c)) exit(2);
                    lag_put(tmp);
                }
            }
            if (cx_fmt(tmp, sizeof tmp, "ATW.T%d\t48-57,65-90\tHALT\t[[\"REJECT\",\"not covered: attribute\"]]\n", id)) exit(2);
            lag_put(tmp);
            if (cx_fmt(tmp, sizeof tmp, "ATW.T%d\t256\tHALT\t[[\"REJECT\",\"unterminated attribute or asm\"]]\n", id)) exit(2);
            lag_put(tmp);
            if (cx_fmt(tmp, sizeof tmp, "ATW.T%d\t*\t%s\t[]\n", id, lag_term_target(nd->term))) exit(2);
            lag_put(tmp);
        } else {
            if (cx_fmt(tmp, sizeof tmp, "ATW.T%d\t256\tHALT\t[[\"REJECT\",\"unterminated attribute or asm\"]]\n", id)) exit(2);
            lag_put(tmp);
            if (cx_fmt(tmp, sizeof tmp, "ATW.T%d\t*\tHALT\t[[\"REJECT\",\"not covered: attribute\"]]\n", id)) exit(2);
            lag_put(tmp);
        }
    }

    /* visibility("default") exact matcher */
    lag_put("ATW.vis0\t9,10,11,12,13,32\tATW.vis0\t[[\"ADV\"]]\n");
    lag_put("ATW.vis0\t40\tATW.vis1\t[[\"ADV\"]]\n");
    lag_put("ATW.vis0\t256\tHALT\t[[\"REJECT\",\"unterminated attribute or asm\"]]\n");
    lag_put("ATW.vis0\t*\tHALT\t[[\"REJECT\",\"not covered: attribute\"]]\n");

    lag_put("ATW.vis1\t9,10,11,12,13,32\tATW.vis1\t[[\"ADV\"]]\n");
    lag_put("ATW.vis1\t34\tATW.vis_d\t[[\"ADV\"]]\n");
    lag_put("ATW.vis1\t256\tHALT\t[[\"REJECT\",\"unterminated attribute or asm\"]]\n");
    lag_put("ATW.vis1\t*\tHALT\t[[\"REJECT\",\"not covered: attribute\"]]\n");

    {
        const char *word = "default\"";
        const char *st[9] = {"ATW.vis_d","ATW.vis_e","ATW.vis_f","ATW.vis_a","ATW.vis_u","ATW.vis_l","ATW.vis_t","ATW.vis_q","ATW.vis_c"};
        for (int i = 0; i < 8; i++) {
            char tmp[256];
            if (cx_fmt(tmp, sizeof tmp, "%s\t%d\t%s\t[[\"ADV\"]]\n", st[i], (int)(unsigned char)word[i], st[i + 1])) exit(2);
            lag_put(tmp);
            if (cx_fmt(tmp, sizeof tmp, "%s\t256\tHALT\t[[\"REJECT\",\"unterminated attribute or asm\"]]\n", st[i])) exit(2);
            lag_put(tmp);
            if (cx_fmt(tmp, sizeof tmp, "%s\t*\tHALT\t[[\"REJECT\",\"not covered: attribute\"]]\n", st[i])) exit(2);
            lag_put(tmp);
        }
    }
    lag_put("ATW.vis_c\t9,10,11,12,13,32\tATW.vis_c\t[[\"ADV\"]]\n");
    lag_put("ATW.vis_c\t41\tATW.after\t[[\"ADV\"]]\n");
    lag_put("ATW.vis_c\t256\tHALT\t[[\"REJECT\",\"unterminated attribute or asm\"]]\n");
    lag_put("ATW.vis_c\t*\tHALT\t[[\"REJECT\",\"not covered: attribute\"]]\n");

    /* ATW.after: after a whitelisted attribute name */
    lag_put("ATW.after\t9,10,11,12,13,32\tATW.after\t[[\"ADV\"]]\n");
    lag_put("ATW.after\t44\tATW.item\t[[\"ADV\"]]\n");
    lag_put("ATW.after\t41\tATW.c1\t[[\"POP\"],[\"ADV\"]]\n");
    lag_put("ATW.after\t40\tATW.arg\t[[\"ADV\"]]\n");
    lag_put("ATW.after\t256\tHALT\t[[\"REJECT\",\"unterminated attribute or asm\"]]\n");
    lag_put("ATW.after\t*\tHALT\t[[\"REJECT\",\"not covered: attribute\"]]\n");

    /* ATW.arg / ATW.arg2 / ATW.arg_str / ATW.arg_esc: skip balanced args for harmless attrs (format, deprecated, nonnull, ctor priority) */
    lag_put("ATW.arg\t40\tATW.arg2\t[[\"ADV\"]]\n");
    lag_put("ATW.arg\t41\tATW.after\t[[\"ADV\"]]\n");
    lag_put("ATW.arg\t34\tATW.arg_str\t[[\"ADV\"]]\n");
    lag_put("ATW.arg\t256\tHALT\t[[\"REJECT\",\"unterminated attribute or asm\"]]\n");
    lag_put("ATW.arg\t*\tATW.arg\t[[\"ADV\"]]\n");

    lag_put("ATW.arg2\t41\tATW.arg\t[[\"ADV\"]]\n");
    lag_put("ATW.arg2\t256\tHALT\t[[\"REJECT\",\"unterminated attribute or asm\"]]\n");
    lag_put("ATW.arg2\t*\tATW.arg2\t[[\"ADV\"]]\n");

    lag_put("ATW.arg_str\t92\tATW.arg_esc\t[[\"ADV\"]]\n");
    lag_put("ATW.arg_str\t34\tATW.arg\t[[\"ADV\"]]\n");
    lag_put("ATW.arg_str\t256\tHALT\t[[\"REJECT\",\"unterminated attribute or asm\"]]\n");
    lag_put("ATW.arg_str\t*\tATW.arg_str\t[[\"ADV\"]]\n");

    lag_put("ATW.arg_esc\t256\tHALT\t[[\"REJECT\",\"unterminated attribute or asm\"]]\n");
    lag_put("ATW.arg_esc\t*\tATW.arg_str\t[[\"ADV\"]]\n");

    /* ATW.c1: expect outer ')' -> POP -> ATTCHK -> CF.finish -> DISPATCH */
    lag_put("ATW.c1\t9,10,11,12,13,32\tATW.c1\t[[\"ADV\"]]\n");
    lag_put("ATW.c1\t41\tATTCHK\t[[\"POP\"],[\"ADV\"]]\n");
    lag_put("ATW.c1\t256\tHALT\t[[\"REJECT\",\"unterminated attribute or asm\"]]\n");
    lag_put("ATW.c1\t*\tHALT\t[[\"REJECT\",\"not covered: attribute\"]]\n");

    /* ASM.*: match volatile(...) / __volatile__(...) after __asm__ / asm -> REJECT "not covered: inline asm";
       any mismatch falls back to ASM.fallback (JUMP E + emit identifier token). */
    {
        const char *vw = "olatile";
        for (int i = 0; i < 7; i++) {
            char tmp[256];
            if (i < 6) {
                if (cx_fmt(tmp, sizeof tmp, "ASM.v%d\t%d\tASM.v%d\t[[\"ADV\"]]\n", i + 1, (int)(unsigned char)vw[i], i + 2)) exit(2);
            } else {
                if (cx_fmt(tmp, sizeof tmp, "ASM.v%d\t%d\tASM.lp\t[[\"ADV\"]]\n", i + 1, (int)(unsigned char)vw[i])) exit(2);
            }
            lag_put(tmp);
            if (cx_fmt(tmp, sizeof tmp, "ASM.v%d\t*\tASM.fallback\t[]\n", i + 1)) exit(2);
            lag_put(tmp);
        }
        const char *uw = "_volatile__";
        for (int i = 0; i < 11; i++) {
            char tmp[256];
            if (i < 10) {
                if (cx_fmt(tmp, sizeof tmp, "ASM.u%d\t%d\tASM.u%d\t[[\"ADV\"]]\n", i + 1, (int)(unsigned char)uw[i], i + 2)) exit(2);
            } else {
                if (cx_fmt(tmp, sizeof tmp, "ASM.u%d\t%d\tASM.lp\t[[\"ADV\"]]\n", i + 1, (int)(unsigned char)uw[i])) exit(2);
            }
            lag_put(tmp);
            if (cx_fmt(tmp, sizeof tmp, "ASM.u%d\t*\tASM.fallback\t[]\n", i + 1)) exit(2);
            lag_put(tmp);
        }
        lag_put("ASM.lp\t9,10,11,12,13,32\tASM.lp\t[[\"ADV\"]]\n");
        lag_put("ASM.lp\t40\tHALT\t[[\"REJECT\",\"not covered: inline asm\"]]\n");
        lag_put("ASM.lp\t*\tASM.fallback\t[]\n");
    }
}

int main(int argc, char **argv) {
    int mode = 0; /* 1=check, 2=write */
    const char *facts = "exec/facts/lex-attr-whitelist.tsv";
    const char *outp = "exec/lex/attr-byte.tsv";

    for (int i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--check")) mode = 1;
        else if (tx_eqz(argv[i], "--write")) mode = 2;
        else if (tx_eqz(argv[i], "--facts") && i + 1 < argc) facts = argv[++i];
        else if (tx_eqz(argv[i], "--out") && i + 1 < argc) outp = argv[++i];
        else { fprintf(stderr, "usage: lex-attr-gen --check|--write [--facts FILE] [--out FILE]\n"); return 2; }
    }
    if (mode == 0) { fprintf(stderr, "lex-attr-gen: REFUSE --check or --write required\n"); return 2; }

    for (int c = 0; c < 26; c++) lag_nodes[0].ch[c] = -1;
    lag_nodes[0].u = -1;
    lag_nodes[0].term = 0;

    size_t sz = 0, i = 0;
    char *s = cx_read(facts, &sz);
    if (!s) { fprintf(stderr, "lex-attr-gen: REFUSE cannot read %s\n", facts); return 2; }
    int nwords = 0;
    while (i < sz) {
        size_t a = i;
        while (i < sz && s[i] != '\n') i++;
        size_t len = i - a;
        if (len > 0 && s[a + len - 1] == '\r') len--;
        if (i < sz && s[i] == '\n') i++;
        if (len == 0 || s[a] == '#') continue;
        char line[512];
        if (len >= sizeof line) { free(s); return 2; }
        if (mm_copy(line, (long)sizeof line, s + a, (long)len)) { free(s); return 2; }
        line[len] = 0;
        char *t1 = strchr(line, '\t');
        if (!t1) { free(s); return 2; }
        *t1++ = 0;
        char *t2 = strchr(t1, '\t');
        if (t2) *t2 = 0;
        if (tx_eqz(line, "name")) continue;
        int kind = 0;
        if (tx_eqz(t1, "ctor")) kind = 1;
        else if (tx_eqz(t1, "dtor")) kind = 2;
        else if (tx_eqz(t1, "ignore")) kind = 3;
        else if (tx_eqz(t1, "vis_default")) kind = 4;
        else { fprintf(stderr, "lex-attr-gen: REFUSE unknown kind %s\n", t1); free(s); return 2; }
        lag_insert(line, kind);
        nwords++;
    }
    free(s);
    if (nwords == 0) { fprintf(stderr, "lex-attr-gen: REFUSE empty whitelist\n"); return 2; }

    lag_generate();

    if (mode == 2) {
        if (cx_write(outp, lag_buf, lag_len)) { fprintf(stderr, "lex-attr-gen: REFUSE write %s\n", outp); return 2; }
        printf("LEX_ATTR_GEN\tmode=write\twords=%d\tnodes=%d\tbytes=%zu\tout=%s\n", nwords, lag_nn, lag_len, outp);
        return 0;
    }

    size_t cur_sz = 0;
    char *cur = cx_read(outp, &cur_sz);
    int same = (cur && cur_sz == lag_len && tx_same(cur, (long)cur_sz, lag_buf, (long)lag_len));
    if (cur) free(cur);
    printf("LEX_ATTR_GEN\tmode=check\twords=%d\tnodes=%d\tstatus=%s\n", nwords, lag_nn, same ? "OK" : "DRIFT");
    return same ? 0 : 1;
}
