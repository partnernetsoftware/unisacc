#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.sig
#pragma unisa use text.text
#pragma unisa use mem.heap
/* Do the carried C headers agree with glibc on the conversions a program actually
 * uses? (C44-LIBC-01..05)
 *
 *   sh ./unisacc.com tools/check-libc-probes.cx -- ROOT
 *
 * Each case is a small self-checking C program whose expectations are glibc's,
 * recorded as literals in the program (no host gcc, no host libc at run time).
 * Every case is compiled and run through the product TWICE: once as a `.c` unit
 * and once as a `.cx` unit, so both entry paths reach the headers.
 *
 *   putc       putc() is a function, and its return is the character written
 *   sigusr     SIGUSR1/SIGUSR2 exist (10/12 on Linux) and reach a handler
 *   nan        NAN has a clear sign bit, so "%f" is "nan" and not "-nan"
 *   scanset    scanf reads "%[...]" -- ranges, negation, width, a 16000-char field
 *   pctn       printf "%n" stores the count and prints nothing, even when truncated
 *   scanfn     scanf "%n" stores the count after the last conversion, and skips no space
 *   strtod     strtod reads inf/infinity/nan[()] and leaves end past the word
 *
 * The `putc` case needs a product built from these headers: the prelude's name
 * table is baked in at build time, so an installed product without the name
 * still refuses the call.  The other six are green on a rebuilt or an installed
 * product that carries the header text.
 *
 * Ends with CHECK_LIBC_PROBES failed=N; rc 1 when any case failed.
 */
static int g_fail;
static void die(const char *s) { sy_eprintf("libc-probes: REFUSE %s\n", s); sy_exit(2); }
static void ck(int ok, const char *name) {
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", name);
    if (!ok) g_fail = g_fail + 1;
}
static int has(const char *h, long n, const char *needle) {
    long i, k, m;
    m = tx_len(needle, 4096);
    if (!h || m == 0) return 0;
    i = 0;
    while (i + m <= n) {
        k = 0;
        while (k < m && h[i + k] == needle[k]) k = k + 1;
        if (k == m) return 1;
        i = i + 1;
    }
    return 0;
}
static int wr(const char *path, const char *s) {
    int fd;
    fd = sy_open(path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (fd < 0) return 1;
    if (sy_write_all(fd, s, tx_len(s, 4096))) { sy_close(fd); return 1; }
    sy_close(fd);
    return 0;
}
static const char *case_src[7];
static const char *case_ok[7];
static const char *case_name[7];
static int case_file[7];

static const char *src_putc =
    "#include <stdio.h>\n"
    "#include <string.h>\n"
    "int main(int argc, char **argv) {\n"
    "    FILE *f; char b[16]; int i, r;\n"
    "    if (argc < 2) { printf(\"BAD argv\\n\"); return 1; }\n"
    "    f = fopen(argv[1], \"w\");\n"
    "    if (!f) { printf(\"BAD open-w\\n\"); return 1; }\n"
    "    for (i = 0; i < 5; i++) {\n"
    "        r = putc('a' + i, f);\n"
    "        if (r != 'a' + i) { printf(\"BAD ret %d\\n\", r); return 1; }\n"
    "    }\n"
    "    if (putc('\\n', f) != 10) { printf(\"BAD ret-nl\\n\"); return 1; }\n"
    "    if (fclose(f) != 0) { printf(\"BAD close\\n\"); return 1; }\n"
    "    f = fopen(argv[1], \"r\");\n"
    "    if (!f) { printf(\"BAD open-r\\n\"); return 1; }\n"
    "    if (fgets(b, sizeof b, f) == NULL) { printf(\"BAD fgets\\n\"); return 1; }\n"
    "    fclose(f);\n"
    "    if (strcmp(b, \"abcde\\n\") != 0) { printf(\"BAD text [%s]\\n\", b); return 1; }\n"
    "    printf(\"OK putc-roundtrip\\n\");\n"
    "    return 0;\n"
    "}\n";

static const char *src_sigusr =
    "#include <stdio.h>\n"
    "#include <signal.h>\n"
    "static volatile sig_atomic_t got;\n"
    "static void on(int s) { got = got + s; }\n"
    "int main(void) {\n"
    "    void (*p)(int);\n"
    "    if (SIGUSR1 != 10 || SIGUSR2 != 12) { printf(\"BAD nums %d %d\\n\", (int)SIGUSR1, (int)SIGUSR2); return 1; }\n"
    "    p = signal(SIGUSR1, on);\n"
    "    if (p != SIG_DFL) { printf(\"BAD prev\\n\"); return 1; }\n"
    "    if (raise(SIGUSR1) != 0) { printf(\"BAD raise\\n\"); return 1; }\n"
    "    if (got != SIGUSR1) { printf(\"BAD got %d\\n\", (int)got); return 1; }\n"
    "    if (signal(SIGUSR2, SIG_IGN) != SIG_DFL) { printf(\"BAD prev2\\n\"); return 1; }\n"
    "    if (raise(SIGUSR2) != 0) { printf(\"BAD raise2\\n\"); return 1; }\n"
    "    printf(\"OK sigusr1-raise\\n\");\n"
    "    return 0;\n"
    "}\n";

static const char *src_nan =
    "#include <stdio.h>\n"
    "#include <string.h>\n"
    "#include <math.h>\n"
    "int main(void) {\n"
    "    double n = NAN;\n"
    "    char b[32];\n"
    "    snprintf(b, sizeof b, \"%f\", n);\n"
    "    if (strcmp(b, \"nan\") != 0) { printf(\"BAD f [%s]\\n\", b); return 1; }\n"
    "    snprintf(b, sizeof b, \"%g\", n);\n"
    "    if (strcmp(b, \"nan\") != 0) { printf(\"BAD g [%s]\\n\", b); return 1; }\n"
    "    snprintf(b, sizeof b, \"%F\", n);\n"
    "    if (strcmp(b, \"NAN\") != 0) { printf(\"BAD F [%s]\\n\", b); return 1; }\n"
    "    if (isnan(n) == 0) { printf(\"BAD isnan\\n\"); return 1; }\n"
    "    if (signbit(n) != 0) { printf(\"BAD signbit\\n\"); return 1; }\n"
    "    if (n == n) { printf(\"BAD eq\\n\"); return 1; }\n"
    "    if (!(NAN != NAN)) { printf(\"BAD ne\\n\"); return 1; }\n"
    "    printf(\"OK nan-sign\\n\");\n"
    "    return 0;\n"
    "}\n";

static const char *src_scanset =
    "#include <stdio.h>\n"
    "#include <string.h>\n"
    "int main(void) {\n"
    "    char set[64], a[32], b[32], w[16], cl[8], line[64];\n"
    "    static char big[17000];\n"
    "    int n, k, v;\n"
    "    v = 0;\n"
    "    n = sscanf(\"abc123\", \"%[a-z]%d\", set, &v);\n"
    "    if (n != 2 || strcmp(set, \"abc\") != 0 || v != 123) { printf(\"BAD lower n=%d [%s] %d\\n\", n, set, v); return 1; }\n"
    "    n = sscanf(\"key=value\", \"%[^=]=%[a-z]\", a, b);\n"
    "    if (n != 2 || strcmp(a, \"key\") != 0 || strcmp(b, \"value\") != 0) { printf(\"BAD neg n=%d [%s] [%s]\\n\", n, a, b); return 1; }\n"
    "    set[0] = 0;\n"
    "    n = sscanf(\"1abc\", \"%[a-z]\", set);\n"
    "    if (n != 0 || set[0] != 0) { printf(\"BAD empty n=%d\\n\", n); return 1; }\n"
    "    n = sscanf(\"abcdef\", \"%3[a-f]\", w);\n"
    "    if (n != 1 || strcmp(w, \"abc\") != 0) { printf(\"BAD width n=%d [%s]\\n\", n, w); return 1; }\n"
    "    n = sscanf(\"A1b2C\", \"%[A-Z]\", set);\n"
    "    if (n != 1 || strcmp(set, \"A\") != 0) { printf(\"BAD upper n=%d [%s]\\n\", n, set); return 1; }\n"
    "    n = sscanf(\"ab;cd\", \"%[^;]\", line);\n"
    "    if (n != 1 || strcmp(line, \"ab\") != 0) { printf(\"BAD stopset n=%d [%s]\\n\", n, line); return 1; }\n"
    "    n = sscanf(\"x-y-z\", \"%[a-z-]\", line);\n"
    "    if (n != 1 || strcmp(line, \"x-y-z\") != 0) { printf(\"BAD dash-last n=%d [%s]\\n\", n, line); return 1; }\n"
    "    n = sscanf(\"]]x\", \"%[]]\", cl);\n"
    "    if (n != 1 || strcmp(cl, \"]]\") != 0) { printf(\"BAD rbracket n=%d [%s]\\n\", n, cl); return 1; }\n"
    "    for (k = 0; k < 16000; k++) big[k] = (char)('a' + (k % 26));\n"
    "    big[16000] = 0;\n"
    "    { static char wide[17000];\n"
    "      n = sscanf(big, \"%[a-z]\", wide);\n"
    "      /* 16000 letters and no width: the scanset must take every one of them */\n"
    "      if (n != 1 || strlen(wide) != 16000) { printf(\"BAD long n=%d len=%d\\n\", n, (int)strlen(wide)); return 1; }\n"
    "      n = sscanf(big, \"%[^\\n]\", wide);\n"
    "      if (n != 1 || strlen(wide) != 16000) { printf(\"BAD long-line n=%d len=%d\\n\", n, (int)strlen(wide)); return 1; } }\n"
    "    n = sscanf(big, \"%12[a-z]\", w);\n"
    "    if (n != 1 || strlen(w) != 12) { printf(\"BAD long-width n=%d len=%d\\n\", n, (int)strlen(w)); return 1; }\n"
    "    printf(\"OK scanset\\n\");\n"
    "    return 0;\n"
    "}\n";

static const char *src_pctn =
    "#include <stdio.h>\n"
    "#include <string.h>\n"
    "int main(void) {\n"
    "    char b[32]; char cw[24];\n"
    "    int used, n, q;\n"
    "    long lused;\n"
    "    used = -1;\n"
    "    n = snprintf(b, sizeof b, \"ab%dcd%n\", 12, &used);\n"
    "    if (n != 6 || used != 6 || strcmp(b, \"ab12cd\") != 0) { printf(\"BAD snprintf n=%d used=%d [%s]\\n\", n, used, b); return 1; }\n"
    "    used = -1;\n"
    "    n = printf(\"hello%n\\n\", &used);\n"
    "    if (n != 6 || used != 5) { printf(\"BAD printf n=%d used=%d\\n\", n, used); return 1; }\n"
    "    used = -1; lused = -1;\n"
    "    n = snprintf(b, sizeof b, \"%d%ln\", 7, &lused);\n"
    "    if (n != 1 || lused != 1) { printf(\"BAD ln n=%d lused=%ld\\n\", n, (long)lused); return 1; }\n"
    "    { unsigned char uc = 0; short sh = 0;\n"
    "      n = snprintf(b, sizeof b, \"xyz%hhn|%hn\", &uc, &sh);\n"
    "      if (n != 4 || uc != 3 || sh != 4) { printf(\"BAD hhn n=%d uc=%d sh=%d\\n\", n, (int)uc, (int)sh); return 1; } }\n"
    "    /* %n prints nothing, so a truncating snprintf must not write past the cap */\n"
    "    for (q = 0; q < 24; q++) cw[q] = '#';\n"
    "    used = -1;\n"
    "    n = snprintf(cw, 8, \"1234567%n89\", &used);\n"
    "    if (used != 7) { printf(\"BAD cap used=%d\\n\", used); return 1; }\n"
    "    if (n != 9) { printf(\"BAD cap ret %d\\n\", n); return 1; }\n"
    "    if (strcmp(cw, \"1234567\") != 0) { printf(\"BAD cap [%s]\\n\", cw); return 1; }\n"
    "    for (q = 8; q < 24; q++) if (cw[q] != '#') { printf(\"BAD overflow %d\\n\", q); return 1; }\n"
    "    printf(\"OK printf-count\\n\");\n"
    "    return 0;\n"
    "}\n";

static const char *src_scanfn =
    "#include <stdio.h>\n"
    "#include <string.h>\n"
    "int main(void) {\n"
    "    int a, k, n;\n"
    "    long lv, lk;\n"
    "    short sv, sk;\n"
    "    signed char cv, ck;\n"
    "    char w[8];\n"
    "    a = 0; k = -1;\n"
    "    n = sscanf(\"77\", \"%d%n\", &a, &k);\n"
    "    if (n != 1 || a != 77 || k != 2) { printf(\"BAD d-n n=%d a=%d k=%d\\n\", n, a, k); return 1; }\n"
    "    a = 0; k = -1;\n"
    "    n = sscanf(\" 7\", \" %d%n\", &a, &k);\n"
    "    if (n != 1 || a != 7 || k != 2) { printf(\"BAD space-n n=%d k=%d\\n\", n, k); return 1; }\n"
    "    /* %n takes no input and skips no white space: on \" ab\" the count is 0 */\n"
    "    w[0] = 0; k = -1;\n"
    "    n = sscanf(\" ab\", \"%n%s\", &k, w);\n"
    "    if (n != 1 || k != 0 || strcmp(w, \"ab\") != 0) { printf(\"BAD noskip n=%d k=%d [%s]\\n\", n, k, w); return 1; }\n"
    "    lv = 0; lk = -1;\n"
    "    n = sscanf(\"1234567\", \"%ld%ln\", &lv, &lk);\n"
    "    if (n != 1 || lv != 1234567 || lk != 7) { printf(\"BAD ln n=%d lv=%ld lk=%ld\\n\", n, (long)lv, (long)lk); return 1; }\n"
    "    sv = 0; sk = -1;\n"
    "    n = sscanf(\"42\", \"%hd%hn\", &sv, &sk);\n"
    "    if (n != 1 || sv != 42 || sk != 2) { printf(\"BAD hn n=%d sv=%d sk=%d\\n\", n, (int)sv, (int)sk); return 1; }\n"
    "    cv = 0; ck = -1;\n"
    "    n = sscanf(\"9x\", \"%hhd%hhn\", &cv, &ck);\n"
    "    if (n != 1 || cv != 9 || ck != 1) { printf(\"BAD hhn n=%d cv=%d ck=%d\\n\", n, (int)cv, (int)ck); return 1; }\n"
    "    a = 0; k = -1;\n"
    "    n = sscanf(\"\", \"%d%n\", &a, &k);\n"
    "    if (n != -1 || k != -1) { printf(\"BAD eof n=%d k=%d\\n\", n, k); return 1; }\n"
    "    printf(\"OK scanf-count\\n\");\n"
    "    return 0;\n"
    "}\n";

static const char *src_strtod =
    "#include <stdio.h>\n"
    "#include <stdlib.h>\n"
    "#include <string.h>\n"
    "#include <errno.h>\n"
    "int main(void) {\n"
    "    char *e; double d;\n"
    "    e = NULL; d = strtod(\"inf\", &e);\n"
    "    if (!(d > 1.7e308) || e == NULL || *e != 0) { printf(\"BAD inf %g [%s]\\n\", d, e ? e : \"-\"); return 1; }\n"
    "    e = NULL; d = strtod(\"-INFINITY\", &e);\n"
    "    if (!(d < -1.7e308) || *e != 0) { printf(\"BAD -infinity\\n\"); return 1; }\n"
    "    e = NULL; d = strtod(\"Infinityx\", &e);\n"
    "    if (!(d > 1.7e308) || strcmp(e, \"x\") != 0) { printf(\"BAD inf-end [%s]\\n\", e); return 1; }\n"
    "    e = NULL; d = strtod(\"nan\", &e);\n"
    "    if (d == d || *e != 0) { printf(\"BAD nan [%s]\\n\", e); return 1; }\n"
    "    e = NULL; d = strtod(\"NAN(abc)\", &e);\n"
    "    if (d == d || *e != 0) { printf(\"BAD nan-seq [%s]\\n\", e); return 1; }\n"
    "    e = NULL; d = strtod(\"  -inf \", &e);\n"
    "    if (!(d < -1.7e308) || strcmp(e, \" \") != 0) { printf(\"BAD space-inf [%s]\\n\", e); return 1; }\n"
    "    e = NULL; d = strtod(\"+nanxyz\", &e);\n"
    "    if (d == d || strcmp(e, \"xyz\") != 0) { printf(\"BAD nan-end [%s]\\n\", e); return 1; }\n"
    "    /* the forms that already worked must keep working */\n"
    "    e = NULL; d = strtod(\"0x1p3\", &e);\n"
    "    if (d != 8.0 || *e != 0) { printf(\"BAD hex %g\\n\", d); return 1; }\n"
    "    e = NULL; d = strtod(\"1e3x\", &e);\n"
    "    if (d != 1000.0 || strcmp(e, \"x\") != 0) { printf(\"BAD exp %g\\n\", d); return 1; }\n"
    "    e = NULL; d = strtod(\"in\", &e);\n"
    "    if (d != 0.0 || e == NULL || strcmp(e, \"in\") != 0) { printf(\"BAD prefix [%s]\\n\", e); return 1; }\n"
    "    printf(\"OK strtod-infnan\\n\");\n"
    "    return 0;\n"
    "}\n";

int main(int argc, char **argv) {
    char root[4096], com[4400], work[4400];
    char sp[4500], bp[4500], tag[128];
    char *v[8];
    char *e[2];
    char why[512];
    np_result r;
    int i, c, s, k, ok;
    const char *suffix[2];
    if (argc >= 2 && argv[1][0]) { if (cx_fmt(root, sizeof root, "%s", argv[1])) die("root"); }
    else if (sy_cwd(root, sizeof root) < 0) die("cwd");
    if (cx_fmt(com, sizeof com, "%s/unisacc.com", root)) die("com");
    if (sy_mkdtemp(sy_tmpdir(), "clp-", work, (int)sizeof work)) die("work");
    case_name[0] = "putc";     case_src[0] = src_putc;     case_ok[0] = "OK putc-roundtrip";   case_file[0] = 1;
    case_name[1] = "sigusr";   case_src[1] = src_sigusr;   case_ok[1] = "OK sigusr1-raise";    case_file[1] = 0;
    case_name[2] = "nan";      case_src[2] = src_nan;      case_ok[2] = "OK nan-sign";         case_file[2] = 0;
    case_name[3] = "scanset";  case_src[3] = src_scanset;  case_ok[3] = "OK scanset";          case_file[3] = 0;
    case_name[4] = "pctn";     case_src[4] = src_pctn;     case_ok[4] = "OK printf-count";     case_file[4] = 0;
    case_name[5] = "scanfn";   case_src[5] = src_scanfn;   case_ok[5] = "OK scanf-count";      case_file[5] = 0;
    case_name[6] = "strtod";   case_src[6] = src_strtod;   case_ok[6] = "OK strtod-infnan";    case_file[6] = 0;
    suffix[0] = "c";
    suffix[1] = "cx";
    e[0] = "UNISACC_RUN_CACHE=0"; e[1] = 0;
    k = 0;
    c = 0;
    while (c < 7) {
        s = 0;
        while (s < 2) {
            if (cx_fmt(sp, sizeof sp, "%s/%s.%s", work, case_name[c], suffix[s])) die("src");
            if (cx_fmt(bp, sizeof bp, "%s/%s.%s.bin", work, case_name[c], suffix[s])) die("bin");
            if (wr(sp, case_src[c])) die("write src");
            i = 0; v[i++] = "sh"; v[i++] = com; v[i++] = sp;
            if (case_file[c]) { v[i++] = "--"; v[i++] = bp; }
            v[i] = 0;
            if (np_run(v, root, e, 60, &r, why, sizeof why)) die(why);
            ok = r.rc == 0 && has(r.out, (long)r.outn, case_ok[c]);
            if (!ok) printf("NOTE\t%s\trc\t%d\t%.*s", case_name[c], r.rc,
                            (int)(r.outn > 300 ? 300 : r.outn), r.out ? r.out : "");
            if (cx_fmt(tag, sizeof tag, "%s/%s", case_name[c], suffix[s])) die("tag");
            ck(ok, tag);
            np_free(&r);
            k = k + 1;
            s = s + 1;
        }
        c = c + 1;
    }
    printf("CHECK_LIBC_PROBES\tfailed=%d\n", g_fail);
    return g_fail ? 1 : 0;
}
