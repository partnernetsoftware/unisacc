/* tools/check-derive-flow.cx -- tools/derive-flow.cx 的检查:仓内清单 --check 时,flow 版与串行 derive.cx 的 DERIVE 行
 * (去掉 ms 列)排序后逐行相同,DERIVE_SUMMARY 计数相同,退出码相同;并核 --write 无参转调串行(用法错 rc 2)。
 *   sh ./unisacc.com tools/check-derive-flow.cx */
#pragma unisa use sys.io
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.bytes
#pragma unisa use mem.heap

static int failed, nok;
static void ck(int ok, const char *name) {
    if (ok) { nok++; sy_printf("PASS\tcheck-derive-flow.%s\n", name); }
    else { failed++; sy_printf("FAIL\tcheck-derive-flow.%s\n", name); }
}
static char *lines[64]; static int nl;
static int scmp(const char *a, const char *b) { while (*a && *a == *b) { a++; b++; } return (unsigned char)*a - (unsigned char)*b; }
/* 把 DERIVE 行去掉第 4 列(ms)收进 lines,排序;SUMMARY 截到 elapsed_ms 前写进 sum */
static int norm(const char *o, long n, char ***res, char *sum, long scap) {
    long at = 0; int i, j; nl = 0; sum[0] = 0;
    while (at < n) {
        long e = tx_chr(o + at, n - at, '\n'), ln = e < 0 ? n - at : e, k, c = 0; const char *l = o + at; char *d;
        at += ln + 1;
        if (ln > 15 && mm_same(l, "DERIVE_SUMMARY\t", 15)) { long q = 15; while (q + 12 <= ln && !mm_same(l + q, "\telapsed_ms=", 12)) q++; if (q + 12 > ln) q = -1; if (q > 0 && q < scap) { mm_copy(sum, scap, l, q); sum[q] = 0; } continue; }
        if (ln < 7 || !mm_same(l, "DERIVE\t", 7) || nl >= 64) continue;
        d = mm_alloc(ln + 1); if (!d) return 1;
        { long w = 0; for (k = 0; k < ln; k++) { if (l[k] == '\t') c++; if (c == 3) { while (k + 1 < ln && l[k + 1] != '\t') k++; c++; continue; } d[w++] = l[k]; } d[w] = 0; }
        lines[nl++] = d;
    }
    for (i = 1; i < nl; i++) for (j = i; j > 0 && scmp(lines[j - 1], lines[j]) > 0; j--) { char *t = lines[j]; lines[j] = lines[j - 1]; lines[j - 1] = t; }
    *res = lines;
    return 0;
}
static int runv(const char *tool, const char *args, char **o, size_t *n) {
    char cmd[600]; char *v[] = {"sh", "-c", cmd, 0};
    cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com tools/%s -- %s", tool, args);
    *o = 0; *n = 0;
    return cx_runv_timeout(v, 58, o, n);
}
int main(void) {
    char *so, *fo, ss[300], fs[300], *sl[64], **r; size_t sn, fn; int src, frc, ns, i, same;
    {   /* 两版并发起跑(各自输出与退出码落临时目录),总时约等于较慢一版 */
        char cmd[1200], p[400], *v[] = {"sh", "-c", cmd, 0}, *o = 0, *t; size_t n = 0, m = 0;
        const char *d = "/tmp/check-derive-flow.d";
        cx_fmt(cmd, sizeof cmd, "mkdir -p %s; (sh ./unisacc.com tools/derive.cx -- --check > %s/s.out; echo $? > %s/s.rc) & "
               "(sh ./unisacc.com tools/derive-flow.cx -- --check > %s/f.out; echo $? > %s/f.rc) & wait", d, d, d, d, d);
        cx_runv_timeout(v, 58, &o, &n);
        cx_fmt(p, sizeof p, "%s/s.out", d); so = cx_read(p, &sn);
        cx_fmt(p, sizeof p, "%s/f.out", d); fo = cx_read(p, &fn);
        cx_fmt(p, sizeof p, "%s/s.rc", d); t = cx_read(p, &m); src = t && m ? t[0] - '0' : -1;
        cx_fmt(p, sizeof p, "%s/f.rc", d); t = cx_read(p, &m); frc = t && m ? t[0] - '0' : -1;
    }
    ck(so && fo && src == frc && (src == 0 || src == 1), "check-rc-equal");
    if (!so || !fo) { sy_printf("DERIVE_FLOW_CHECK\tok=%d\tfailed=%d\n", nok, failed); return 1; }
    norm(so, (long)sn, &r, ss, sizeof ss); ns = nl; for (i = 0; i < ns; i++) sl[i] = lines[i];
    norm(fo, (long)fn, &r, fs, sizeof fs);
    same = ns == nl && ns == 9;
    for (i = 0; same && i < ns; i++) if (scmp(sl[i], lines[i]) != 0) same = 0;
    ck(same, "derive-lines-sorted-equal");
    ck(ss[0] && scmp(ss, fs) == 0, "summary-counts-equal");
    frc = runv("derive-flow.cx", "--bogus", &fo, &fn);
    ck(frc == 2, "usage-rc2");
    sy_printf("DERIVE_FLOW_CHECK\tok=%d\tfailed=%d\n", nok, failed);
    return failed ? 1 : 0;
}
