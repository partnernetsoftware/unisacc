/* tools/check-coldcompile.cx -- the real tools/coldcompile.cx on two fixture sources.
 *
 *   sh ./unisacc.com tools/check-coldcompile.cx -- NEW_DIR      (from the repository root, NEW_DIR below it)
 *
 * One measuring call over a source that compiles (it uses a module beside it) and one that does not:
 * the table gets its header and two rows; the good row has a positive time, rc 0, two units, the
 * module as its only use and the summed bytes of both files; the bad row keeps its non-zero rc and is
 * counted in compile_failed; no per-file directory is left in the tool's temporary directory.
 * --plan-only prints the same closure with "-" for the measured fields and leaves the table alone; a
 * FILE without a plan is named, counted, exits 1 and does not stop the files after it.  A call without
 * FILE is rc 2.  Prints PASS/FAIL per case and CHECK_COLDCOMPILE<TAB>failed=N. */
#pragma unisa use sys.fs
#pragma unisa use text.text

static int failed;
static char dir[4096];

static void ck(int ok, const char *name) {
    if (!ok) failed++;
    printf("%s\tcoldcompile.%s\n", ok ? "PASS" : "FAIL", name);
}
static void leaf(char *p, const char *name) {
    if (cx_fmt(p, 4400, "%s/%s", dir, name)) { printf("check-coldcompile: path bound\n"); exit(2); }
}
static void put(const char *p, const char *s) {
    if (cx_write(p, s, (size_t)tx_len(s, 8192))) { printf("check-coldcompile: write %s\n", p); exit(2); }
}
static int has(const char *s, long n, const char *w) { return s && tx_find(s, n, w, tx_len(w, 8192)) >= 0; }
static long lines(const char *s, long n) { long k = 0, i; for (i = 0; i < n; i++) if (s[i] == '\n') k++; return k; }
/* tools/coldcompile.cx with up to three arguments, its TMPDIR set to TMP; stdout in *o */
static char tmpenv[4500];
static int tool(const char *a, const char *b, const char *c, char **o, size_t *n) {
    char *v[16]; int k = 0;
    v[k++] = "tools/bound"; v[k++] = "50"; v[k++] = "env"; v[k++] = tmpenv; v[k++] = "sh"; v[k++] = "./unisacc.com"; v[k++] = "tools/coldcompile.cx"; v[k++] = "--";
    v[k++] = (char *)a; if (b) v[k++] = (char *)b; if (c) v[k++] = (char *)c;
    v[k] = 0; *o = 0; *n = 0;
    return cx_runv_timeout(v, 55, o, n);
}
/* field F (0-based) of the row of TABLE that starts with KEY, into OUT */
static int field(const char *t, long n, const char *key, int f, char *out, long cap) {
    long at = 0, kl = tx_len(key, 4400);
    while (at < n) {
        long e = at, p, k = 0; int i = 0;
        while (e < n && t[e] != '\n') e++;
        if (e - at > kl && tx_find(t + at, kl, key, kl) == 0 && t[at + kl] == '\t') {
            p = at;
            while (i < f && p < e) { if (t[p] == '\t') i++; p++; }
            while (p < e && t[p] != '\t' && k < cap - 1) out[k++] = t[p++];
            out[k] = 0;
            return i == f;
        }
        at = e + 1;
    }
    return 0;
}
/* entries of D named coldcompile-* (the tool's per-file directories) */
static int leftovers(const char *d) { DIR *h = opendir(d); struct dirent *e; int k = 0; if (!h) return -1; while ((e = readdir(h)) != 0) if (!strncmp(e->d_name, "coldcompile-", 12)) k++; closedir(h); return k; }

int main(int argc, char **argv) {
    char root[4096], good[4400], mod[4400], bad[4400], table[4400], scratch[4400], rgood[4400], rmod[4400], rbad[4400], rnone[4400], f[4400], want[64];
    const char *gsrc = "#pragma unisa use ccmod\nint main(void) { return cc_value(); }\n";
    const char *msrc = "#pragma unisa module ccmod\nint cc_value(void) { return 3; }\n";
    const char *bsrc = "int main(void) { return undeclared_thing; }\n";
    char *o = 0, *t = 0; size_t on = 0, tn = 0; long rl; int rc;
    if (argc != 2 || sy_realpath(".", root, sizeof root) < 0 || cx_fmt(dir, sizeof dir, "%s", argv[1])) { printf("usage NEW_DIR\n"); return 2; }
    rl = tx_len(root, sizeof root);
    if (tx_find(dir, rl, root, rl) != 0 || dir[rl] != '/') { printf("check-coldcompile: NEW_DIR must be below the repository root\n"); return 2; }
    if (sy_mkdir(dir, 0700)) { printf("check-coldcompile: NEW_DIR must not exist\n"); return 2; }
    leaf(good, "ccgood.cx"); leaf(mod, "ccmod.cx"); leaf(bad, "ccbad.cx"); leaf(table, "table.tsv"); leaf(scratch, "tmp");
    if (cx_fmt(rnone, sizeof rnone, "%s/absent.cx", dir + rl + 1)) return 2;
    if (cx_fmt(tmpenv, sizeof tmpenv, "TMPDIR=%s", scratch)) return 2;
    if (cx_fmt(rgood, sizeof rgood, "%s", good + rl + 1) || cx_fmt(rmod, sizeof rmod, "%s", mod + rl + 1) || cx_fmt(rbad, sizeof rbad, "%s", bad + rl + 1)) return 2;
    if (sy_mkdir(scratch, 0700)) return 2;
    put(good, gsrc); put(mod, msrc); put(bad, bsrc);

    rc = tool(table, rgood, rbad, &o, &on);
    ck(rc == 0 && has(o, (long)on, "COLDCOMPILE\tfiles=2\tcompile_failed=1\tplan_failed=0\n"), "two-files-measured-one-compile-failure-counted");
    free(o);
    t = cx_read(table, &tn);
    ck(t && lines(t, (long)tn) == 3 && tx_find(t, (long)tn, "file\tcold_ms\trc\tunits\tclosure_bytes\tload1\tuses\n", 47) == 0, "table-header-and-two-rows");
    ck(t && field(t, (long)tn, rgood, 1, f, sizeof f) && strtol(f, 0, 10) > 0 && field(t, (long)tn, rgood, 2, f, sizeof f) && !strcmp(f, "0"), "good-row-positive-time-rc0");
    cx_fmt(want, sizeof want, "%ld", tx_len(gsrc, 8192) + tx_len(msrc, 8192));
    ck(t && field(t, (long)tn, rgood, 3, f, sizeof f) && !strcmp(f, "2") && field(t, (long)tn, rgood, 4, f, sizeof f) && !strcmp(f, want) &&
       field(t, (long)tn, rgood, 6, f, sizeof f) && !strcmp(f, rmod), "good-row-closure-two-units-bytes-and-use");
    ck(t && field(t, (long)tn, rbad, 2, f, sizeof f) && strcmp(f, "0") && strcmp(f, "-") && field(t, (long)tn, rbad, 6, f, sizeof f) && !strcmp(f, "-"), "bad-row-keeps-nonzero-rc");
    ck(leftovers(scratch) == 0, "no-per-file-directory-left");

    rc = tool("--plan-only", rgood, 0, &o, &on);
    cx_fmt(f, sizeof f, "%s\t-\t-\t2\t%s\t-\t%s\n", rgood, want, rmod);
    ck(rc == 0 && has(o, (long)on, f) && has(o, (long)on, "COLDCOMPILE\tfiles=1\tcompile_failed=0\tplan_failed=0\n"), "plan-only-row-without-measurement");
    free(o);
    rc = tool("--plan-only", rnone, rgood, &o, &on);
    ck(rc == 1 && has(o, (long)on, f) && has(o, (long)on, "COLDCOMPILE\tfiles=1\tcompile_failed=0\tplan_failed=1\n"), "file-without-plan-counted-rc1-rest-still-done");
    free(o);
    rc = tool(table, 0, 0, &o, &on);
    ck(rc == 2, "no-file-rc2");
    free(o);
    {   size_t n2 = 0; char *t2 = cx_read(table, &n2);
        ck(t && t2 && n2 == tn && tx_find(t2, (long)n2, t, (long)tn) == 0, "table-unchanged-by-plan-only-and-refusals");
        free(t2);
    }
    free(t);
    printf("CHECK_COLDCOMPILE\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
