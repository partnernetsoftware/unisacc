/* tools/check-release-usage.cx -- release-build 缺参数必须干净退出,且 freeze 必须真的成功(0.0.50)。
 * 背景:(1)rb_die 在 D 集成时丢了 sy_exit(1),p3 只给 ROOT 时打印 usage 后继续执行,越界读 argv
 * 以 SIGSEGV(139) 退出;(2)D5R 重写 rb_pipe 后不再去掉尾部换行,rb_freeze 把 "<40 hex>\n" 读成 41 字节,
 * 每条 freeze 路径都在 "rev" 处 die——在 (1) 未修时这个失败是静默的。
 * main() 对 p3/slice 总是先 freeze(rev 默认 HEAD),freeze 会在 ROOT/out 建快照,所以每个用例都在
 * 各自的临时共享克隆里跑(幂等),工具源取被测 ROOT 的工作树。
 *   U1 p3 只给 ROOT:freeze 成功(stdout 有 "release-build\trev\t" 成功行、stderr 无 "release-build: rev"
 *      die 文本),随后缺参以 rc1 退出且 stderr 有 usage 行,绝不能 139/11;
 *   U2 slice 只给 ROOT:同上 rc1 且干净;
 *   U3 rb_die 源文本必须含 sy_exit(回归钉);
 *   U4 rb_pipe 源文本必须含尾部换行修剪(回归钉);
 *   U5 freeze 的 rev 子进程(git rev-parse --verify X^{commit})换成 sleep 20、UNISACC_RB_PIPE_MS=2000:
 *      必须以 "release-build: rev timeout after 2000 ms" 具名退出 rc1(非 139),不能落成普通 rev 失败
 *      (rb_pipe 经 cxlib.procrun pr_run 按整秒限时,1500 这类非整秒值回落默认 55s,故用 2000);
 *   U6 快照根(无 .git、有 include/cx-flat.h):不冻结,打印 snapshot 行后缺参 rc1;
 *   U7 既非 git 也非快照的目录:具名拒绝 neither a git work tree,无 git archive 文本。
 * release-build 只编一次(rb_bin),U1/U2/U5/U6/U7 都复用它,总耗时须 <60s。 */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use sys.sig
#pragma unisa use cxlib.netpack
#pragma unisa use mem.heap

static int failed;
static char root[4096];

static void ck(int ok, const char *n) {
    sy_printf("%s\tcheck-release-usage.%s\n", ok ? "PASS" : "FAIL", n);
    if (!ok) failed++;
}
static long tlen(const char *s) { return tx_len(s, 1 << 20); }
/* 在 b[0..bn) 内按位比对找 s(不经源文本锚点助手;输入是子进程输出或回归钉,逐位比对) */
static int hasn(const char *b, long bn, const char *s, long sn) {
    long i;
    for (i = 0; i + sn <= bn; i++) if (tx_same(b + i, sn, s, sn)) return 1;
    return 0;
}
static int has(const char *b, const char *s) { return hasn(b, tlen(b), s, tlen(s)); }

/* 被测 ROOT 的 release-build 只编一次到 rb_bin(测量:单次编译约 16s,三用例各编一次会超 60s 上限),
   各用例在临时共享克隆 TMP/r 里跑 [PRE]rb_bin <sub> TMP/r;stdout+stderr 合并进 buf。
   PRE 是加在命令前的环境赋值(U5 用),其余用例传 ""。 */
static char rb_dir[4400], rb_bin[4400];
static int build_rb(void) {
    np_result r = {0}; char why[512] = {0}; char src[4400], com[4400]; int rc;
    char *v[] = {"sh", com, src, "-o", rb_bin, 0};
    if (cx_fmt(rb_dir, sizeof rb_dir, "%s/release-usage-bin-XXXXXX", sy_tmpdir()) || !mkdtemp(rb_dir)) return -1;
    if (cx_fmt(rb_bin, sizeof rb_bin, "%s/release-build", rb_dir) ||
        cx_fmt(com, sizeof com, "%s/unisacc.com", root) ||
        cx_fmt(src, sizeof src, "%s/tools/release-build.cx", root)) return -1;
    rc = np_run(v, rb_dir, 0, 50, &r, why, sizeof why) || r.rc ? -1 : 0;
    if (rc && r.errn) fwrite(r.err, 1, r.errn, stderr);
    np_free(&r);
    return rc;
}
static int fresh_run(const char *pre, const char *sub, char *buf, long cap) {
    char tmp[4400], cmd[9000], rmc[4600]; np_result r = {0}; char why[512] = {0}; int rc = -1;
    char *sh[4];
    buf[0] = 0;
    if (cx_fmt(tmp, sizeof tmp, "%s/release-usage-XXXXXX", sy_tmpdir()) || !mkdtemp(tmp)) return -2;
    if (cx_fmt(cmd, sizeof cmd,
        "git clone -q --shared '%s' '%s/r' && cp '%s/unisacc.com' '%s/r/unisacc.com' && "
        "cp '%s/unisacc.com.build.json' '%s/r/unisacc.com.build.json' 2>/dev/null; "
        "cd '%s/r' && %s'%s' %s '%s/r'",
        root, tmp, root, tmp, root, tmp, tmp, pre, rb_bin, sub, tmp)) return -3;
    sh[0] = "sh"; sh[1] = "-c"; sh[2] = cmd; sh[3] = 0;
    if (np_run(sh, tmp, 0, 50, &r, why, sizeof why) == 0) {
        long m = (long)r.errn, o = (long)r.outn, i;
        if (m > cap - 1) m = cap - 1;
        for (i = 0; i < m; i++) buf[i] = r.err[i];
        if (m + o > cap - 1) o = cap - 1 - m;
        for (i = 0; i < o; i++) buf[m + i] = r.out[i];
        buf[m + o] = 0;
        rc = r.rc;
    }
    np_free(&r);
    if (!cx_fmt(rmc, sizeof rmc, "rm -rf '%s'", tmp)) { np_result q = {0}; char w2[128] = {0};
        sh[2] = rmc; np_run(sh, rb_dir, 0, 20, &q, w2, sizeof w2); np_free(&q); }
    return rc;
}

/* ROOT 残留清单:顶层与 out/ 一层中本检查可能留下的条目(release-snap-*、release-usage*、.fz-*、顶层条目名),排序后比对。 */
static int root_list(char *o, long cap) {
    char cmd[9000]; char *sh[4]; np_result r = {0}; char why[128] = {0}; long n, i; int rc;
    if (cx_fmt(cmd, sizeof cmd,
        "cd '%s' && { ls -A; find . -maxdepth 3 \\( -name 'release-snap-*' -o -name 'release-usage*' -o -name '.fz-*' \\) -print; } | sort",
        root)) return -1;
    sh[0] = "sh"; sh[1] = "-c"; sh[2] = cmd; sh[3] = 0;
    rc = np_run(sh, root, 0, 20, &r, why, sizeof why);
    n = (long)r.outn; if (n > cap - 1) n = cap - 1;
    for (i = 0; i < n; i++) o[i] = r.out[i];
    o[n] = 0;
    np_free(&r);
    return rc;
}
static char lst0[65536], lst1[65536];
static char tmp0[4400], home0[4400], fx[4400], ftc[4400], cbase[4600];

int main(void) {
    char buf[16384]; int rc;
    if (sy_cwd(root, sizeof root)) return 2;
    if (root_list(lst0, sizeof lst0)) return 2;
    if (build_rb()) { sy_eprintf("check-release-usage: release-build compile failed\n"); return 2; }
    /* freeze 的快照落在链基目录(cxlib.chainroot cr_snap)。夹具:唯一目录下并列 home/ 与 tmp/,
       HOME、TMPDIR 指过去,UNISACC_CHAIN_BASE 指该 TMPDIR 下的会话根;不写真实缓存链根,也不写 ROOT/out。
       release-build 已在上面用原环境编好;原 TMPDIR 留到末尾清理 rb_dir 时恢复。 */
    if (cx_fmt(tmp0, sizeof tmp0, "%s", sy_tmpdir()) || cx_fmt(home0, sizeof home0, "%s", sy_env_or("HOME", ""))) return 2;
    { char fh[4400], ft[4400];
      if (cx_fmt(fx, sizeof fx, "%s/release-usage-fx-%d", tmp0, (int)getpid()) || cx_fmt(fh, sizeof fh, "%s/home", fx) || cx_fmt(ft, sizeof ft, "%s/tmp", fx)) return 2;
      if (sy_mkdir(fx, 0700) || sy_mkdir(fh, 0700) || sy_mkdir(ft, 0700) || sy_realpath(ft, ftc, sizeof ftc) < 0) return 2;
      if (cx_fmt(cbase, sizeof cbase, "%s/unisacc-session-chain-usage", ftc)) return 2;
      if (sy_setenv("HOME", fh, 1) || sy_setenv("TMPDIR", ftc, 1) || sy_setenv("UNISACC_CHAIN_BASE", cbase, 1)) return 2; }
    /* U1 */
    rc = fresh_run("", "p3", buf, sizeof buf);
    ck(rc == 1, "U1 p3 missing args exits 1 (not segv)");
    ck(has(buf, "release-build\trev\t"), "U1 freeze rev succeeded (success line present)");
    ck(!has(buf, "release-build: rev"), "U1 no rev die text (rb_pipe trims trailing newline)");
    ck(has(buf, "usage: p3 ROOT SRC_PKG OUT_PKG"), "U1 usage line present");
    /* U2 */
    rc = fresh_run("", "slice", buf, sizeof buf);
    ck(rc == 1, "U2 slice missing args exits 1 (not segv)");
    ck(has(buf, "release-build\trev\t") && !has(buf, "release-build: rev"), "U2 freeze ok before refusal");
    ck(has(buf, "release-build:"), "U2 clean refusal");
    /* U8: 同快照连续 freeze,产品相同则跳过(inode/mtime/ctime 不变);产品内容变更则重写且字节同根 */
    { char td[4400], cmd[9000], u8base[4600]; np_result r = {0}; char why[512] = {0}; char *sh[4]; long m, i;
      if (cx_fmt(td, sizeof td, "%s/release-usage-frz-XXXXXX", sy_tmpdir()) || !mkdtemp(td)) return 2;
      /* U8 自己的链基目录:其下 snap/ 里只会有这一个克隆的快照,S 就是它(快照必须在链基目录下,克隆里不得出现 out/) */
      if (cx_fmt(u8base, sizeof u8base, "%s/unisacc-session-chain-usage-u8", ftc) || sy_setenv("UNISACC_CHAIN_BASE", u8base, 1)) return 2;
      if (cx_fmt(cmd, sizeof cmd,
          "git clone -q --shared '%s' '%s/r' && cp '%s/unisacc.com' '%s/unisacc.com.build.json' '%s/r/' && cd '%s/r' && "
          "'%s' freeze . >o1 2>&1; S=$(ls -d '%s'/snap/*-*); [ $(ls -d '%s'/snap/* | wc -l) = 1 ] && [ -f $S/.release-rev ] && echo U8_SNAP_AT_CHAIN_BASE; [ ! -e out ] && echo U8_NO_OUT_DIR; s1=$(stat -c '%%i %%y %%z' $S/unisacc.com); "
          "'%s' freeze . >o2 2>&1; s2=$(stat -c '%%i %%y %%z' $S/unisacc.com); "
          "[ \"$s1\" = \"$s2\" ] && echo U8_STAT_SAME; grep -q 'freeze-product.unchanged' o2 && echo U8_UNCHANGED_MSG; "
          "printf x >> $S/unisacc.com; '%s' freeze . >o3 2>&1; s3=$(stat -c '%%i %%y %%z' $S/unisacc.com); "
          "[ \"$s2\" != \"$s3\" ] && echo U8_STAT_CHANGED; grep -q 'freeze-product.rewritten' o3 && echo U8_REWRITTEN_MSG; "
          "cmp -s unisacc.com $S/unisacc.com && echo U8_BYTES_EQ; ls -a $S | grep -q '^.fz-' || echo U8_NO_STAGE; cd /; rm -rf '%s'",
          root, td, root, root, td, td, rb_bin, u8base, u8base, rb_bin, rb_bin, td)) return 2;
      sh[0] = "sh"; sh[1] = "-c"; sh[2] = cmd; sh[3] = 0; buf[0] = 0;
      if (np_run(sh, td, 0, 50, &r, why, sizeof why) == 0) {
          m = (long)r.outn; if (m > (long)sizeof buf - 1) m = sizeof buf - 1;
          for (i = 0; i < m; i++) buf[i] = r.out[i];
          buf[m] = 0;
      }
      np_free(&r);
      ck(has(buf, "U8_STAT_SAME") && has(buf, "U8_UNCHANGED_MSG"), "U8 same product: freeze skips copy, inode/mtime/ctime kept");
      ck(has(buf, "U8_STAT_CHANGED") && has(buf, "U8_REWRITTEN_MSG") && has(buf, "U8_BYTES_EQ"), "U8 changed product: snapshot rewritten, bytes equal root");
      ck(has(buf, "U8_NO_STAGE"), "U8 staging dir removed");
      ck(has(buf, "U8_SNAP_AT_CHAIN_BASE") && has(buf, "U8_NO_OUT_DIR"), "U8 snapshot below the chain base, no out/ in the checkout");
      if (sy_setenv("UNISACC_CHAIN_BASE", cbase, 1)) return 2;
    }
    /* U6 + U7:复用单次编译的 rb_bin,不再各编一次。 */
    { char td[4400], cmd[9000]; np_result r = {0}; char why[512] = {0}; char *sh[4]; long m, o, i;
      if (cx_fmt(td, sizeof td, "%s/release-usage-snap-XXXXXX", sy_tmpdir()) || !mkdtemp(td)) return 2;
      if (cx_fmt(cmd, sizeof cmd,
          "mkdir -p '%s/s/include' '%s/s/out' '%s/n' && cp '%s/include/cx-flat.h' '%s/s/include/' && "
          "'%s' p3 '%s/s'; echo rc=$?; '%s' p3 '%s/n'; echo rc=$?; rm -rf '%s'",
          td, td, td, root, td, rb_bin, td, rb_bin, td, td)) return 2;
      sh[0] = "sh"; sh[1] = "-c"; sh[2] = cmd; sh[3] = 0; buf[0] = 0;
      if (np_run(sh, td, 0, 50, &r, why, sizeof why) == 0) {
          m = (long)r.errn; o = (long)r.outn; if (m > (long)sizeof buf - 1) m = sizeof buf - 1;
          for (i = 0; i < m; i++) buf[i] = r.err[i];
          if (m + o > (long)sizeof buf - 1) o = sizeof buf - 1 - m;
          for (i = 0; i < o; i++) buf[m + i] = r.out[i];
          buf[m + o] = 0;
      }
      np_free(&r);
      ck(has(buf, "release-build\tsnapshot\t") && !has(buf, "release-build\trev\t"), "U6 snapshot root not frozen");
      ck(has(buf, "usage: p3 ROOT SRC_PKG OUT_PKG") && has(buf, "rc=1\n"), "U6 snapshot root then missing args rc1");
      ck(has(buf, "neither a git work tree") && !has(buf, "git archive"), "U7 plain dir refused by name");
    }
    /* U3 + U4: 源文本回归钉 */
    { char p[4400]; size_t n; char *b;
      if (cx_fmt(p, sizeof p, "%s/tools/release-build.cx", root)) return 2;
      b = (char *)cx_read(p, &n);
      ck(b && hasn(b, (long)n, "sy_eprintf(\"release-build: %s\\n\", s);\n    sy_exit(1);", 53), "U3 rb_die exits");
      { const char *pin = "while (m > 0 && (out[m - 1] == '\\n' || out[m - 1] == '\\r')) m--;";
        ck(b && hasn(b, (long)n, pin, tlen(pin)), "U4 rb_pipe trims trailing newline (source pin)"); }
      if (b) mm_free(b); }
    /* U5: freeze 的 rev 子进程换成 sleep,上限压到 2000ms:必须以具名 timeout 死(含相位名与毫秒),
       rc 为 1 而不是 139,也不能落到调用方的普通 "release-build: rev" 文本。 */
    { char fb[4400], git[4400], real[512], script[1024], pre[4600]; int cut = 0;
      char *wh[] = {"sh", "-c", "command -v git", 0};
      if (sy_run(wh, real, sizeof real, &cut) || !real[0]) return 2;
      { long k = tlen(real); while (k > 0 && (real[k - 1] == '\n' || real[k - 1] == '\r')) real[--k] = 0; }
      if (cx_fmt(fb, sizeof fb, "%s/release-usage-fb-%d", sy_tmpdir(), (int)getpid()) ||
          cx_fmt(git, sizeof git, "%s/git", fb) ||
          cx_fmt(script, sizeof script, "#!/bin/sh\ncase \"$*\" in \"rev-parse --verify \"*\"^{commit}\") exec sleep 20;; esac\nexec '%s' \"$@\"\n", real) ||
          cx_fmt(pre, sizeof pre, "PATH='%s':\"$PATH\" UNISACC_RB_PIPE_MS=2000 ", fb)) return 2;
      if (sy_mkdir(fb, 0700) || cx_write(git, script, (size_t)tlen(script)) || sy_chmod(git, 0700)) return 2;
      rc = fresh_run(pre, "p3", buf, sizeof buf);
      ck(rc != 139 && rc != 11 && rc == 1, "U5 pipe timeout exits 1 (not segv)");
      ck(has(buf, "release-build: rev timeout after 2000 ms"), "U5 timeout named with phase and ceiling ms");
      ck(!has(buf, "release-build: rev\n"), "U5 timeout not reported as ordinary rev failure");
      if (cx_rmtree(fb)) return 2; }
    /* 恢复原环境后清 rb_dir 与夹具根(都在原 TMPDIR 下,本进程 mkdir 的唯一目录) */
    if (sy_setenv("TMPDIR", tmp0, 1) || sy_setenv("HOME", home0, 1) || sy_setenv("UNISACC_CHAIN_BASE", "", 1)) return 2;
    if (cx_rmtree(rb_dir)) return 2;
    /* 夹具根含子进程在其 TMPDIR 下留的缓存,条目数超 cx_rmtree 的 1000 上限,故用 rm -rf(路径为本进程 mkdir 的唯一目录) */
    { char *rmv[] = {"rm", "-rf", fx, 0}; np_result q = {0}; char w2[128] = {0};
      if (np_run(rmv, 0, 0, 20, &q, w2, sizeof w2) || q.rc) { np_free(&q); return 2; }
      np_free(&q); }
    /* U9: 失败/拒绝用例都在私有临时目录里跑,ROOT 前后清单必须一致(无新增文件) */
    if (root_list(lst1, sizeof lst1)) return 2;
    ck(tx_eqz(lst0, lst1), "U9 ROOT has no new file after failing cases");
    sy_printf("CHECK_RELEASE_USAGE\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
