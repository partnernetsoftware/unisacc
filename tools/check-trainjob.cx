/* tools/check-trainjob.cx -- entry and CLI contract check for tools/trainjob.cx (unit J4 skeleton; J2/J3 extend).
 * Marker: CHECK_TRAINJOB<TAB>failed=N */
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use mem.bytes
#pragma unisa use text.text
#pragma unisa use cxlib.ckrun

static int failed = 0;
static void ck(int ok, const char *name) {
    if (!ok) failed++;
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", name);
}

int main(void) {
    char out[2048];
    long t0 = sy_now_ms();
    ck(ckk_sh("CHECK_TRAINJOB", "sh ./unisacc.com tools/trainjob.cx", out, sizeof out) == 2 &&
       ckk_has(out, sizeof out, "usage: trainjob.cx"), "no-args-refused");
    ck(ckk_sh("CHECK_TRAINJOB", "sh ./unisacc.com tools/trainjob.cx -- unknown", out, sizeof out) == 2 &&
       ckk_has(out, sizeof out, "usage: trainjob.cx"), "unknown-subcmd-refused");
    ck(ckk_sh("CHECK_TRAINJOB", "sh ./unisacc.com tools/trainjob.cx -- why", out, sizeof out) == 2 &&
       ckk_has(out, sizeof out, "why requires directory"), "why-no-dir-refused");
    ck(ckk_sh("CHECK_TRAINJOB", "sh ./unisacc.com tools/trainjob.cx -- why --bad-flag", out, sizeof out) == 2 &&
       ckk_has(out, sizeof out, "bad argument"), "why-bad-flag-refused");
    ck(ckk_sh("CHECK_TRAINJOB", "sh ./unisacc.com tools/check-trainjob-why.cx", out, sizeof out) == 0 &&
       ckk_has(out, sizeof out, "CHECK_TRAINJOB_WHY\tfailed=0"), "delegates-why-suite");
    printf("CHECK_TRAINJOB\tfailed=%d\tms=%ld\n", failed, sy_now_ms() - t0);
    return failed ? 1 : 0;
}
