#pragma unisa use compiler.groupname
#pragma unisa use runtime.groupname
#pragma unisa use sys.io
#pragma unisa use text.text
/* Generated by tools/group-gen.cx. Narrow check of the four route groups. */
int main(void) {
    const char *name;
    const char **missing;
    missing = 0;
    if (pgn_count() != 4) return 1;
    if (rgn_count() != 4) return 1;
    if (pgn_at(0, &name) || !tx_eqz(name, "pp")) return 1;
    if (rgn_at(0, &name) || !tx_eqz(name, "pp")) return 1;
    if (pgn_at(1, &name) || !tx_eqz(name, "tape")) return 1;
    if (rgn_at(1, &name) || !tx_eqz(name, "tape")) return 1;
    if (pgn_at(2, &name) || !tx_eqz(name, "image")) return 1;
    if (rgn_at(2, &name) || !tx_eqz(name, "image")) return 1;
    if (pgn_at(3, &name) || !tx_eqz(name, "run")) return 1;
    if (rgn_at(3, &name) || !tx_eqz(name, "run")) return 1;
    if (pgn_at(0, missing) != 4) return 1;
    if (rgn_at(0, missing) != 4) return 1;
    if (pgn_at(-1, &name) != 2) return 1;
    if (pgn_at(4, &name) != 2) return 1;
    if (rgn_at(-1, &name) != 2) return 1;
    if (rgn_at(4, &name) != 2) return 1;
    sy_printf("CX_GROUP\tok=4\tfailed=0\n");
    return 0;
}
