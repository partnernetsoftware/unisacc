/* tools/check-v0110-exit.cx -- executable exit-criterion check for v0.1.10 (tape speed gate, lnx/x86_64).
 *
 * Usage:
 *   sh ./unisacc.com tools/check-v0110-exit.cx -- [--product APE] [--max-load L] [--repeat N]
 *       [--frozen-baseline FILE] [--write-frozen FILE] [--shard-tool PATH]
 *       [--tier16-dir DIR --tier16-manifest FILE] [--tier102-dir DIR --tier102-manifest FILE] [CHAIN_DIR]
 *   sh ./unisacc.com tools/check-v0110-exit.cx -- --self-test
 *
 * Checks against the current candidate (criterion-first, RED at opening):
 *   (1) tier 16 tape/native <= 15x on a quiet machine (9 repeats, median, load1 recorded,
 *       native baseline frozen by candidate identity);
 *   (2) tier 102/106 full sharded run cmp EQUAL vs native (uses committed agyneon3 shard tool);
 *   (3) all 102/106 units ran under tape (verified against candidate unit inventory >= 102).
 */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.posix
#pragma unisa use sys.proc
#pragma unisa use sys.time
#pragma unisa use sys.sha
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use text.conv
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use cxlib.netpack

enum {
    V10_PW = 4400,
    V10_MAX_OBJS = 256,
    V10_MAX_REPS = 25,
    V10_GATE_REPS = 9,
    V10_GATE_MAX_LOAD_X100 = 600,
    V10_MIN_TIER102_UNITS = 102,
    V10_MAX_TIER102_UNITS = 106,
    V10_UNIT_SHARDS = 4
};

static int g_pass = 0;
static int g_fail = 0;
static int g_quiet_rec = 0;
static char g_last_detail[512];

static void v10_rec(int ok, const char *name, const char *detail) {
    cx_fmt(g_last_detail, sizeof g_last_detail, "%s", (detail && detail[0]) ? detail : "-");
    if (ok) {
        g_pass++;
        if (!g_quiet_rec) sy_printf("PASS\tv0110-exit.%s\t%s\n", name, (detail && detail[0]) ? detail : "-");
    } else {
        g_fail++;
        if (!g_quiet_rec) sy_printf("FAIL\tv0110-exit.%s\t%s\n", name, (detail && detail[0]) ? detail : "-");
    }
}

/* Minimal M1 8-slot (mask <= 383) tl_dce driver matching tools/check-tape-tldce-speed.cx. */
static const char V10_TLDCE_DRIVER_SRC[] =
    "#pragma unisa use compiler.tapelink\n"
    "#pragma unisa use sys.fs\n"
    "#pragma unisa use mem.heap\n"
    "#pragma unisa use mem.bytes\n"
    "long sy_rlimit_as(void) { return -1; }\n"
    "static unsigned char *g_ob = 0;\n"
    "static long g_on = 0;\n"
    "static long g_ocap = 0;\n"
    "static int d_emit(int c) {\n"
    "    if (g_on >= g_ocap) {\n"
    "        long nc = g_ocap > 0 ? g_ocap * 2 : 1048576;\n"
    "        unsigned char *nb = (unsigned char *)mm_alloc(nc);\n"
    "        if (!nb) return 1;\n"
    "        if (g_ob && g_on > 0) (void)mm_copy(nb, nc, g_ob, g_on);\n"
    "        if (g_ob) mm_free(g_ob);\n"
    "        g_ob = nb; g_ocap = nc;\n"
    "    }\n"
    "    g_ob[g_on++] = (unsigned char)(c & 255);\n"
    "    return 0;\n"
    "}\n"
    "static int d_die(char *m) {\n"
    "    if (m) { long l = 0; while (m[l]) l++; if (l > 0) (void)sy_write_all(2, m, l); }\n"
    "    return 1;\n"
    "}\n"
    "static void put_u64(char *dst, int *pos, unsigned long long v) {\n"
    "    char d[24]; int n = 0;\n"
    "    if (v == 0) { dst[(*pos)++] = '0'; return; }\n"
    "    while (v > 0) { d[n++] = (char)('0' + (v % 10ull)); v /= 10ull; }\n"
    "    while (n > 0) dst[(*pos)++] = d[--n];\n"
    "}\n"
    "static void put_s(char *dst, int *pos, const char *s) {\n"
    "    while (*s) dst[(*pos)++] = *s++;\n"
    "}\n"
    "static int read_obj(const char *path, unsigned char **out_b, long *out_n) {\n"
    "    int fd = sy_open(path, O_RDONLY, 0);\n"
    "    if (fd < 0) return -1;\n"
    "    sy_stat_t st;\n"
    "    if (sy_fstat(fd, &st) != 0 || st.size <= 0 || st.size > 67108864L) { sy_close(fd); return -1; }\n"
    "    unsigned char *b = (unsigned char *)mm_alloc((long)st.size + 1);\n"
    "    if (!b) { sy_close(fd); return -1; }\n"
    "    if (sy_read_full(fd, b, (long)st.size) != 0) { mm_free(b); sy_close(fd); return -1; }\n"
    "    sy_close(fd);\n"
    "    b[st.size] = 0;\n"
    "    *out_b = b; *out_n = (long)st.size;\n"
    "    return 0;\n"
    "}\n"
    "int main(int argc, char **argv) {\n"
    "    if (argc < 3) return 2;\n"
    "    const char *out_path = argv[1];\n"
    "    if (tl_bind(d_emit, d_die) || tl_begin()) return 3;\n"
    "    int u = 0;\n"
    "    for (int i = 2; i < argc; i++) {\n"
    "        unsigned char *b = 0; long bn = 0, tl = 0;\n"
    "        if (read_obj(argv[i], &b, &bn) != 0) return 4;\n"
    "        char *t = tl_tape((char *)b, bn, &tl);\n"
    "        if (!t || tl <= 0) { mm_free(b); return 5; }\n"
    "        if (u == 0) tl_adopt_first(); else if (tl_target_differs()) { mm_free(b); return 12; }\n"
    "        if (tl_unitver(t, (int)tl) != 0 || tl_unit(t, (int)tl, u) != 0 || tl_note_links(t, tl) != 0) { mm_free(b); return 6; }\n"
    "        u++;\n"
    "        mm_free(b);\n"
    "    }\n"
    "    g_on = tl_dce((char *)g_ob, g_on);\n"
    "    if (tl_check_undef() != 0) return 7;\n"
    "    if (tl_entry_missing() != 0) return 8;\n"
    "    if (tl_dce_cut() <= 0) return 11;\n"
    "    tl_finish(u);\n"
    "    int fd = sy_open(out_path, O_WRONLY, 0);\n"
    "    if (fd < 0) return 9;\n"
    "    if (g_on > 0 && sy_write_all(fd, g_ob, g_on) != 0) { sy_close(fd); return 10; }\n"
    "    sy_close(fd);\n"
    "    char msg[160]; int mp = 0;\n"
    "    put_s(msg, &mp, \"TLDCE_DRIVER\\tunits=\"); put_u64(msg, &mp, (unsigned long long)u);\n"
    "    put_s(msg, &mp, \"\\tbytes=\"); put_u64(msg, &mp, (unsigned long long)g_on);\n"
    "    put_s(msg, &mp, \"\\tdce_cut=\"); put_u64(msg, &mp, (unsigned long long)tl_dce_cut());\n"
    "    msg[mp++] = '\\n';\n"
    "    (void)sy_write_all(1, msg, mp);\n"
    "    mm_free(g_ob);\n"
    "    return 0;\n"
    "}\n";

static int v10_is_dir(const char *path) {
    sy_stat_t st;
    if (!path || !path[0]) return 0;
    return sy_stat(path, &st) == 0 && st.kind == 'd';
}

static int v10_is_hex64(const char *s) {
    if (!s) return 0;
    for (int i = 0; i < 64; i++) {
        char c = s[i];
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return 0;
    }
    return s[64] == 0;
}

static int v10_sha_bytes(const char *path, char sha_out[65], long *bytes_out) {
    size_t n = 0;
    char *b = cx_read(path, &n);
    if (!b) return -1;
    cx_sha256_hex(b, n, sha_out);
    if (bytes_out) *bytes_out = (long)n;
    mm_free(b);
    return 0;
}

static int v10_files_eq(const char *pa, const char *pb) {
    size_t na = 0, nb = 0;
    char *ba = cx_read(pa, &na);
    char *bb = cx_read(pb, &nb);
    int eq = (ba && bb && na == nb && (na == 0 || memcmp(ba, bb, na) == 0));
    if (ba) mm_free(ba);
    if (bb) mm_free(bb);
    return eq;
}

static int v10_read_load1_x100(char text_out[32]) {
    unsigned char *b = 0;
    int64_t n = 0;
    cx_fmt(text_out, 32, "-");
    if (sy_read_file("/proc/loadavg", &b, &n, 1024) != 0 || !b || n <= 0) {
        if (b) mm_free(b);
        return -1;
    }
    int i = 0;
    while (i < 31 && i < (int)n && b[i] != ' ' && b[i] != '\n' && b[i] != '\r') {
        text_out[i] = (char)b[i];
        i++;
    }
    text_out[i] = 0;
    int whole = 0, frac = 0, p = 0;
    while (p < n && b[p] >= '0' && b[p] <= '9') { whole = whole * 10 + (b[p] - '0'); p++; }
    if (p < n && b[p] == '.') {
        p++;
        int mult = 10;
        while (p < n && b[p] >= '0' && b[p] <= '9' && mult > 0) { frac += (b[p] - '0') * mult; mult /= 10; p++; }
    }
    mm_free(b);
    return whole * 100 + frac;
}

static void v10_sort_i64(int64_t *a, int n) {
    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {
            if (a[j] < a[i]) { int64_t t = a[i]; a[i] = a[j]; a[j] = t; }
        }
    }
}

static int v10_run_cmd(char *const argv[], const char *cwd, int secs,
                       int *rc_out, int64_t *ns_out, char *obuf, size_t ocap,
                       char *ebuf, size_t ecap, int *res_out) {
    np_result r = {0};
    char why[256];
    int64_t t0 = sy_mono_ns();
    int tr = np_run(argv, cwd, 0, secs, &r, why, sizeof why);
    int64_t t1 = sy_mono_ns();
    if (ns_out) *ns_out = (t0 >= 0 && t1 > t0) ? (t1 - t0) : 1;
    if (rc_out) *rc_out = tr ? 124 : r.rc;
    if (res_out) *res_out = r.residue;
    if (obuf && ocap > 0) {
        obuf[0] = 0;
        if (r.out && r.outn > 0) {
            size_t c = r.outn < ocap - 1 ? r.outn : ocap - 1;
            mm_copy(obuf, (long)ocap, r.out, (long)c);
            obuf[c] = 0;
        }
    }
    if (ebuf && ecap > 0) {
        ebuf[0] = 0;
        if (r.err && r.errn > 0) {
            size_t c = r.errn < ecap - 1 ? r.errn : ecap - 1;
            mm_copy(ebuf, (long)ecap, r.err, (long)c);
            ebuf[c] = 0;
        }
    }
    int failed = (tr != 0 || r.residue != 0);
    np_free(&r);
    return failed ? -1 : 0;
}

static int v10_find_line(const char *buf, const char *prefix, char *line_out, size_t cap) {
    if (!buf || !prefix || !line_out || cap == 0) return -1;
    size_t pl = strlen(prefix);
    const char *p = buf;
    while (*p) {
        const char *e = p;
        while (*e && *e != '\n' && *e != '\r') e++;
        size_t ln = (size_t)(e - p);
        if (ln >= pl && memcmp(p, prefix, pl) == 0) {
            size_t c = ln < cap - 1 ? ln : cap - 1;
            mm_copy(line_out, (long)cap, p, (long)c);
            line_out[c] = 0;
            return 0;
        }
        p = *e ? e + 1 : e;
    }
    return -1;
}

static int v10_line_kv_str(const char *line, const char *key, char *val_out, size_t cap) {
    if (!line || !key || !val_out || cap == 0) return -1;
    size_t kl = strlen(key);
    const char *p = line;
    while (*p) {
        const char *e = p;
        while (*e && *e != '\t') e++;
        size_t fn = (size_t)(e - p);
        if (fn > kl + 1 && memcmp(p, key, kl) == 0 && p[kl] == '=') {
            size_t vl = fn - (kl + 1);
            if (vl >= cap) return -1;
            mm_copy(val_out, (long)cap, p + kl + 1, (long)vl);
            val_out[vl] = 0;
            return 0;
        }
        p = (*e == '\t') ? e + 1 : e;
    }
    return -1;
}

static int v10_line_kv_u64(const char *line, const char *key, unsigned long long *out) {
    char v[64];
    if (v10_line_kv_str(line, key, v, sizeof v) != 0 || !v[0]) return -1;
    unsigned long long acc = 0;
    for (int i = 0; v[i]; i++) {
        if (v[i] < '0' || v[i] > '9') return -1;
        acc = acc * 10ull + (unsigned long long)(v[i] - '0');
    }
    *out = acc;
    return 0;
}

static int v10_line_has_str(const char *line, const char *key, const char *want) {
    char v[128];
    return v10_line_kv_str(line, key, v, sizeof v) == 0 && tx_eqz(v, want);
}

static int v10_speed_ok(int64_t tape_med_ns, int64_t nat_med_ns) {
    if (tape_med_ns <= 0 || nat_med_ns <= 0) return 0;
    return (double)tape_med_ns <= (double)nat_med_ns * 15.0;
}

static int v10_quiet_ok(int load_x100, int max_load_x100) {
    return load_x100 >= 0 && max_load_x100 > 0 && load_x100 <= max_load_x100;
}

static int v10_units_ok(int expected_units, int ran_units) {
    return expected_units >= V10_MIN_TIER102_UNITS && ran_units == expected_units;
}

static void v10_harness_sha(char sha_out[65]) {
    const char *tag = ";native=-O2;tape=-target=lnx/x86_64\n";
    size_t sl = strlen(V10_TLDCE_DRIVER_SRC), tl = strlen(tag);
    char *buf = (char *)mm_alloc((long)(sl + tl + 1));
    if (!buf) { mm_fill(sha_out, 65, '0', 64); sha_out[64] = 0; return; }
    mm_copy(buf, (long)(sl + tl + 1), V10_TLDCE_DRIVER_SRC, (long)sl);
    mm_copy(buf + sl, (long)(tl + 1), tag, (long)tl);
    cx_sha256_hex(buf, sl + tl, sha_out);
    mm_free(buf);
}

static int v10_input_set_sha(const char *manifest_path, const char objs[][512], int nobjs, char sha_out[65]) {
    if (nobjs <= 0 || nobjs > V10_MAX_OBJS) return -1;
    long cap = 256L + (long)nobjs * 320L;
    char *buf = (char *)mm_alloc(cap);
    if (!buf) return -1;
    long pos = 0;
    if (manifest_path && manifest_path[0]) {
        char msha[65];
        if (v10_sha_bytes(manifest_path, msha, 0) != 0 ||
            cx_fmt(buf + pos, (size_t)(cap - pos), "manifest\t%s\n", msha)) {
            mm_free(buf);
            return -1;
        }
        pos += (long)strlen(buf + pos);
    } else {
        if (cx_fmt(buf + pos, (size_t)(cap - pos), "fixture\t%d\n", nobjs)) {
            mm_free(buf);
            return -1;
        }
        pos += (long)strlen(buf + pos);
    }
    for (int i = 0; i < nobjs; i++) {
        char osha[65];
        if (v10_sha_bytes(objs[i], osha, 0) != 0) { mm_free(buf); return -1; }
        const char *base = objs[i];
        for (const char *q = objs[i]; *q; q++) if (*q == '/') base = q + 1;
        if (cx_fmt(buf + pos, (size_t)(cap - pos), "%d\t%s\t%s\n", i, base, osha)) {
            mm_free(buf);
            return -1;
        }
        pos += (long)strlen(buf + pos);
    }
    cx_sha256_hex(buf, (size_t)pos, sha_out);
    mm_free(buf);
    return 0;
}

static int v10_parse_load_x100(const char *s, long len) {
    if (!s || len <= 0 || len > 16) return -1;
    int whole = 0, frac = 0, p = 0;
    if (s[0] < '0' || s[0] > '9') return -1;
    while (p < (int)len && s[p] >= '0' && s[p] <= '9') {
        if (whole > 10000) return -1;
        whole = whole * 10 + (s[p] - '0');
        p++;
    }
    if (p < (int)len) {
        if (s[p] != '.') return -1;
        p++;
        int mult = 10;
        if (p >= (int)len || s[p] < '0' || s[p] > '9') return -1;
        while (p < (int)len && s[p] >= '0' && s[p] <= '9') {
            if (mult > 0) { frac += (s[p] - '0') * mult; mult /= 10; }
            p++;
        }
    }
    if (p != (int)len) return -1;
    return whole * 100 + frac;
}

/* Format: v10_frozen_v2<TAB>cand_sha<TAB>input_sha<TAB>harness_sha<TAB>reps<TAB>load1<TAB>nat_med_ns<TAB>s0,...,s8 */
static int v10_load_frozen_baseline(const char *path, const char *expect_cand_sha,
                                    const char *expect_input_sha, const char *expect_harness_sha,
                                    int expect_reps, int max_load_x100,
                                    int64_t *nat_med_ns_out, char *why, size_t wcap) {
    size_t n = 0;
    char *b = cx_read(path, &n);
    if (!b || n == 0) {
        if (b) mm_free(b);
        cx_fmt(why, (int)wcap, "frozen-baseline-unreadable");
        return -1;
    }
    long at = 0;
    while (at < (long)n) {
        long e = at;
        while (e < (long)n && b[e] != '\n' && b[e] != '\r') e++;
        long ln = e - at;
        const char *l = b + at;
        at = e + 1;
        if (ln <= 0 || l[0] == '#') continue;

        const char *f[8];
        long fl[8];
        int nf = 0;
        long pos = 0;
        while (nf < 8 && pos <= ln) {
            long s = pos;
            while (pos < ln && l[pos] != '\t') pos++;
            f[nf] = l + s;
            fl[nf] = pos - s;
            nf++;
            if (pos >= ln) break;
            pos++;
        }
        if (nf != 8 || !tx_same(f[0], fl[0], "v10_frozen_v2", 13)) {
            mm_free(b);
            cx_fmt(why, (int)wcap, "frozen-baseline-bad-format");
            return -1;
        }
        char csha[65], isha[65], hsha[65];
        if (fl[1] != 64 || fl[2] != 64 || fl[3] != 64) {
            mm_free(b);
            cx_fmt(why, (int)wcap, "frozen-baseline-bad-sha");
            return -1;
        }
        mm_copy(csha, sizeof csha, f[1], 64); csha[64] = 0;
        mm_copy(isha, sizeof isha, f[2], 64); isha[64] = 0;
        mm_copy(hsha, sizeof hsha, f[3], 64); hsha[64] = 0;
        if (!v10_is_hex64(csha) || !v10_is_hex64(isha) || !v10_is_hex64(hsha)) {
            mm_free(b);
            cx_fmt(why, (int)wcap, "frozen-baseline-bad-hex");
            return -1;
        }
        if (!tx_eqz(csha, expect_cand_sha)) {
            mm_free(b);
            cx_fmt(why, (int)wcap, "baseline-candidate-identity-mismatch");
            return -2;
        }
        if (!tx_eqz(isha, expect_input_sha)) {
            mm_free(b);
            cx_fmt(why, (int)wcap, "baseline-input-identity-mismatch");
            return -3;
        }
        if (!tx_eqz(hsha, expect_harness_sha)) {
            mm_free(b);
            cx_fmt(why, (int)wcap, "baseline-harness-identity-mismatch");
            return -4;
        }
        int64_t freps = -1, med_val = -1;
        if (fl[4] <= 0 || tx_to_i64(f[4], fl[4], 10, &freps) != 0 || freps != (int64_t)expect_reps) {
            mm_free(b);
            cx_fmt(why, (int)wcap, "baseline-reps-mismatch");
            return -1;
        }
        int fload = v10_parse_load_x100(f[5], fl[5]);
        if (!v10_quiet_ok(fload, max_load_x100)) {
            mm_free(b);
            cx_fmt(why, (int)wcap, "baseline-not-quiet");
            return -6;
        }
        if (fl[6] <= 0 || tx_to_i64(f[6], fl[6], 10, &med_val) != 0 || med_val <= 0) {
            mm_free(b);
            cx_fmt(why, (int)wcap, "frozen-baseline-bad-ns");
            return -1;
        }
        int64_t samples[V10_MAX_REPS];
        int nsamp = 0;
        long sp = 0;
        while (sp < fl[7] && nsamp < expect_reps) {
            long c = sp;
            while (c < fl[7] && f[7][c] != ',') c++;
            int64_t sv = -1;
            if (c == sp || tx_to_i64(f[7] + sp, c - sp, 10, &sv) != 0 || sv <= 0) {
                mm_free(b);
                cx_fmt(why, (int)wcap, "frozen-baseline-bad-samples");
                return -1;
            }
            samples[nsamp++] = sv;
            sp = c + 1;
            if (c == fl[7]) break;
        }
        if (nsamp != expect_reps || sp < fl[7]) {
            mm_free(b);
            cx_fmt(why, (int)wcap, "frozen-baseline-sample-count");
            return -1;
        }
        v10_sort_i64(samples, nsamp);
        if (samples[nsamp / 2] != med_val) {
            mm_free(b);
            cx_fmt(why, (int)wcap, "frozen-baseline-median-mismatch");
            return -5;
        }
        *nat_med_ns_out = med_val;
        mm_free(b);
        return 0;
    }
    mm_free(b);
    cx_fmt(why, (int)wcap, "frozen-baseline-empty");
    return -1;
}

static int v10_load_manifest(const char *manifest_path, const char *obj_dir,
                             char objs[V10_MAX_OBJS][512], int *bad_out) {
    size_t n = 0;
    char *b = cx_read(manifest_path, &n);
    if (!b) return -1;
    int count = 0, bad = 0;
    long at = 0;
    while (at < (long)n) {
        long e = at;
        while (e < (long)n && b[e] != '\n' && b[e] != '\r') e++;
        long ln = e - at;
        const char *l = b + at;
        at = e + 1;
        if (ln <= 0 || l[0] == '#') continue;
        if (ln < 67 || l[64] != ' ' || l[65] != ' ') { bad++; continue; }
        char want[65];
        mm_copy(want, sizeof want, l, 64);
        want[64] = 0;
        if (!v10_is_hex64(want) || count >= V10_MAX_OBJS) { bad++; continue; }
        long rel_len = ln - 66;
        if (rel_len <= 0 || rel_len >= 200) { bad++; continue; }
        char rel[204], full[512], got[65];
        mm_copy(rel, sizeof rel, l + 66, rel_len);
        rel[rel_len] = 0;
        if (cx_fmt(full, sizeof full, "%s/%s", obj_dir, rel) ||
            v10_sha_bytes(full, got, 0) != 0 || !tx_eqz(got, want)) {
            bad++;
            continue;
        }
        cx_fmt(objs[count], 512, "%s", full);
        count++;
    }
    mm_free(b);
    *bad_out = bad;
    return count;
}

static int v10_load_receipt_objs(const char *chain_dir, char objs[V10_MAX_OBJS][512]) {
    char rcpt[V10_PW], g2[V10_PW];
    if (cx_fmt(rcpt, sizeof rcpt, "%s/fixedpoint/g2/lnx-x86_64/receipt.txt", chain_dir) ||
        cx_fmt(g2, sizeof g2, "%s/fixedpoint/g2/lnx-x86_64", chain_dir)) return -1;
    size_t n = 0;
    char *b = cx_read(rcpt, &n);
    if (!b || n == 0) {
        if (b) mm_free(b);
        return -1;
    }
    int count = 0;
    long at = 0;
    while (at < (long)n) {
        long e = at;
        while (e < (long)n && b[e] != '\n' && b[e] != '\r') e++;
        long ln = e - at;
        const char *l = b + at;
        at = e + 1;
        if (ln <= 0) continue;
        long t1 = tx_chr(l, ln, '\t');
        if (t1 <= 2 || t1 >= 63) continue;
        if (l[t1 - 2] != '.' || l[t1 - 1] != 'o') continue;
        char kbuf[64], full[512];
        mm_copy(kbuf, sizeof kbuf, l, t1);
        kbuf[t1] = 0;
        if (cx_fmt(full, sizeof full, "%s/%s", g2, kbuf)) continue;
        if (sy_exists(full) != 1) {
            if (cx_fmt(full, sizeof full, "%s/candidate/%s", g2, kbuf) || sy_exists(full) != 1) {
                mm_free(b);
                return -1;
            }
        }
        if (count >= V10_MAX_OBJS) { mm_free(b); return -1; }
        cx_fmt(objs[count], 512, "%s", full);
        count++;
    }
    mm_free(b);
    return count > 0 ? count : -1;
}

static int v10_build_tier16_fixture(const char *root, const char *prod_ape, const char *tdir,
                                    char objs[V10_MAX_OBJS][512]) {
    char p[V10_PW], o[V10_PW], src[1024], obuf[4096];
    int rc = 0;
    if (sy_mkdir(tdir, 0755) != 0 && sy_exists(tdir) != 1) return -1;
    for (int i = 0; i < 16; i++) {
        char rp[32], ro[32];
        if (cx_fmt(p, sizeof p, "%s/u%03d.cx", tdir, i) ||
            cx_fmt(o, sizeof o, "%s/u%03d.o", tdir, i) ||
            cx_fmt(rp, sizeof rp, "u%03d.cx", i) ||
            cx_fmt(ro, sizeof ro, "u%03d.o", i)) return -1;
        if (i == 0) {
            cx_fmt(src, sizeof src,
                "extern int f_1(int x);\n"
                "extern int tl_dead_missing(void);\n"
                "static int dead_0(int x) { return x * 3 + 7 + tl_dead_missing(); }\n"
                "int main(void) { return f_1(1) & 127; }\n");
        } else if (i + 1 < 16) {
            cx_fmt(src, sizeof src,
                "extern int f_%d(int x);\n"
                "extern int tl_dead_missing(void);\n"
                "int dead_%d(int x) { int s = x; for (int k = 0; k < 16; k++) s = (s * 33) ^ k; return s + tl_dead_missing(); }\n"
                "int f_%d(int x) { return f_%d(x + 1); }\n",
                i + 1, i, i, i + 1);
        } else {
            cx_fmt(src, sizeof src,
                "int dead_%d(int x) { return x ^ 42; }\n"
                "int f_%d(int x) { return x; }\n", i, i);
        }
        if (cx_write(p, src, (size_t)tx_len(src, sizeof src))) return -1;
        char *av[] = {"sh", (char *)prod_ape, "-O2", "-c", "-b", "lnx/x86_64", "-funit", rp, "-o", ro, 0};
        if (v10_run_cmd(av, tdir, 30, &rc, 0, obuf, sizeof obuf, 0, 0, 0) != 0) rc = 124;
        (void)sy_unlink(p);
        if (rc != 0 || sy_exists(o) != 1) return -1;
        cx_fmt(objs[i], 512, "%s", o);
    }
    (void)root;
    return 16;
}

static void v10_resolve_shard_tool(const char *root, const char *explicit_tool, char out[V10_PW]) {
    out[0] = 0;
    if (explicit_tool && explicit_tool[0]) {
        cx_fmt(out, V10_PW, "%s", explicit_tool);
        return;
    }
    char p[V10_PW];
    if (!cx_fmt(p, sizeof p, "%s/tools/tape-tldce-shard.cx", root) && sy_exists(p) == 1) {
        cx_fmt(out, V10_PW, "%s", p);
    }
}

static void v10_check_c1(const char *root, const char *cand_ape, const char *cand_sha,
                         const char *t16_dir, const char *t16_man, const char *frozen_path,
                         const char *write_frozen, int reps, int max_load_x100) {
    char tmp[V10_PW], detail[512], input_sha[65], harness_sha[65];
    if (sy_mkdtemp("/tmp", "check-v0110", tmp, sizeof tmp) != 0) {
        v10_rec(0, "c1-tier16-speed-15x", "mkdtemp-failed");
        return;
    }
    static char objs[V10_MAX_OBJS][512];
    int nobjs = 0, bad_m = 0;
    const char *man_used = 0;
    if (t16_man && t16_man[0]) {
        nobjs = v10_load_manifest(t16_man, t16_dir, objs, &bad_m);
        if (nobjs != 16 || bad_m != 0) {
            (void)sy_remove_all(tmp);
            v10_rec(0, "c1-tier16-speed-15x", "tier16-manifest-invalid");
            return;
        }
        man_used = t16_man;
    } else {
        char fdir[V10_PW];
        if (cx_fmt(fdir, sizeof fdir, "%s/objs16", tmp) ||
            v10_build_tier16_fixture(root, cand_ape, fdir, objs) != 16) {
            (void)sy_remove_all(tmp);
            v10_rec(0, "c1-tier16-speed-15x", "tier16-fixture-compile-failed");
            return;
        }
        nobjs = 16;
    }
    if (v10_input_set_sha(man_used, objs, nobjs, input_sha) != 0) {
        (void)sy_remove_all(tmp);
        v10_rec(0, "c1-tier16-speed-15x", "input-set-hash-failed");
        return;
    }
    v10_harness_sha(harness_sha);

    char l1_start[32];
    int l1s_x100 = v10_read_load1_x100(l1_start);
    if (!v10_quiet_ok(l1s_x100, max_load_x100)) {
        cx_fmt(detail, sizeof detail, "load1_start=%s max_load=%d.%02d quiet=0 reason=machine-not-quiet",
               l1_start, max_load_x100 / 100, max_load_x100 % 100);
        (void)sy_remove_all(tmp);
        v10_rec(0, "c1-tier16-speed-15x", detail);
        return;
    }

    char drv_cx[V10_PW], drv_nat[V10_PW], drv_tape[V10_PW], drv_slice[V10_PW];
    char run_bin[V10_PW], so_path[V10_PW], ref_out[V10_PW];
    char link_tsv[V10_PW], tgt_tsv[V10_PW], link_cx[V10_PW], tgt_cx[V10_PW];
    if (cx_fmt(drv_cx, sizeof drv_cx, "%s/tldce_driver.cx", tmp) ||
        cx_fmt(drv_nat, sizeof drv_nat, "%s/tldce_native", tmp) ||
        cx_fmt(drv_tape, sizeof drv_tape, "%s/tldce.tape", tmp) ||
        cx_fmt(drv_slice, sizeof drv_slice, "%s/tldce.tapeslice", tmp) ||
        cx_fmt(run_bin, sizeof run_bin, "%s/tapemode_run", tmp) ||
        cx_fmt(so_path, sizeof so_path, "%s/libtape_m1.so", tmp) ||
        cx_fmt(ref_out, sizeof ref_out, "%s/native_ref.tape", tmp) ||
        cx_fmt(link_tsv, sizeof link_tsv, "%s/cxroot.tsv", tmp) ||
        cx_fmt(tgt_tsv, sizeof tgt_tsv, "%s/cxroot.tsv", root) ||
        cx_fmt(link_cx, sizeof link_cx, "%s/cx", tmp) ||
        cx_fmt(tgt_cx, sizeof tgt_cx, "%s/cx", root)) {
        (void)sy_remove_all(tmp);
        v10_rec(0, "c1-tier16-speed-15x", "path-too-long");
        return;
    }
    (void)sy_symlink(tgt_tsv, link_tsv);
    (void)sy_symlink(tgt_cx, link_cx);
    if (cx_write(drv_cx, V10_TLDCE_DRIVER_SRC, (size_t)tx_len(V10_TLDCE_DRIVER_SRC, sizeof V10_TLDCE_DRIVER_SRC))) {
        (void)sy_remove_all(tmp);
        v10_rec(0, "c1-tier16-speed-15x", "driver-write-failed");
        return;
    }

    static char obuf[65536];
    char line[512];
    int rc = 0;
    char *av1[] = {"sh", (char *)cand_ape, drv_cx, "-o", drv_nat, 0};
    char *av2[] = {"sh", (char *)cand_ape, "--target", "lnx/x86_64", "-S", drv_cx, "-o", drv_tape, 0};
    char *av3[] = {"sh", (char *)cand_ape, "tools/tapepack.cx", "--", drv_tape, "-o", drv_slice, 0};
    char *av4[] = {"sh", (char *)cand_ape, "tools/tapemode-run.cx", "-o", run_bin, 0};
    const char *cc_bin = (sy_exists("/usr/bin/cc") == 1) ? "/usr/bin/cc" : "cc";
    char *av5[] = {(char *)cc_bin, "-shared", "-fPIC", "-O2", "-o", so_path,
                   "tools/tape/asm/tape_x86_64.S", "tools/tape/asm/hoststub_lnx_x86_64.S", 0};

    if (v10_run_cmd(av1, root, 35, &rc, 0, obuf, sizeof obuf, 0, 0, 0) != 0 || rc != 0 ||
        v10_run_cmd(av2, root, 35, &rc, 0, obuf, sizeof obuf, 0, 0, 0) != 0 || rc != 0 ||
        v10_run_cmd(av3, root, 35, &rc, 0, obuf, sizeof obuf, 0, 0, 0) != 0 || rc != 0 ||
        v10_run_cmd(av4, root, 35, &rc, 0, obuf, sizeof obuf, 0, 0, 0) != 0 || rc != 0 ||
        v10_run_cmd(av5, root, 25, &rc, 0, obuf, sizeof obuf, 0, 0, 0) != 0 || rc != 0) {
        (void)sy_remove_all(tmp);
        v10_rec(0, "c1-tier16-speed-15x", "driver-build-failed");
        return;
    }

    char *nav[32];
    int nk = 0;
    nav[nk++] = drv_nat;
    nav[nk++] = ref_out;
    for (int i = 0; i < nobjs; i++) nav[nk++] = objs[i];
    nav[nk] = 0;

    int64_t nat_ns[V10_MAX_REPS], wns = 0, nat_med_ns = -1;
    if (sy_write_file(ref_out, "", 0, 0644) != 0) {
        (void)sy_remove_all(tmp);
        v10_rec(0, "c1-tier16-speed-15x", "native-out-init-failed");
        return;
    }
    int tr_nw = v10_run_cmd(nav, root, 25, &rc, &wns, obuf, sizeof obuf, 0, 0, 0);
    if (tr_nw == 0 && (rc == 7 || rc == 8 || rc == 11 || rc == 12)) {
        const char *why_refuse = (rc == 11) ? "input-no-dead-extern" :
                                 (rc == 7) ? "input-undef-symbols" :
                                 (rc == 8) ? "input-entry-missing" : "input-target-mismatch";
        cx_fmt(detail, sizeof detail, "REFUSE %s rc=%d reason=tl-dce-input-rejected", why_refuse, rc);
        (void)sy_remove_all(tmp);
        v10_rec(0, "c1-tier16-speed-15x", detail);
        return;
    }
    if (tr_nw != 0 || rc != 0) {
        cx_fmt(detail, sizeof detail, "native-warmup-failed tr=%d rc=%d out=%.160s", tr_nw, rc, obuf);
        (void)sy_remove_all(tmp);
        v10_rec(0, "c1-tier16-speed-15x", detail);
        return;
    }
    unsigned long long ref_cut = 0, ref_units = 0;
    if (v10_find_line(obuf, "TLDCE_DRIVER\t", line, sizeof line) != 0 ||
        v10_line_kv_u64(line, "units", &ref_units) != 0 || ref_units != 16ull ||
        v10_line_kv_u64(line, "dce_cut", &ref_cut) != 0 || ref_cut == 0 ||
        sy_exists(ref_out) != 1) {
        (void)sy_remove_all(tmp);
        v10_rec(0, "c1-tier16-speed-15x", "native-ref-invalid");
        return;
    }

    const char *base_mode = "live-candidate-frozen";
    if (frozen_path && frozen_path[0]) {
        char fwhy[128];
        if (v10_load_frozen_baseline(frozen_path, cand_sha, input_sha, harness_sha,
                                     reps, max_load_x100, &nat_med_ns, fwhy, sizeof fwhy) != 0) {
            cx_fmt(detail, sizeof detail, "candidate_sha=%.12s reason=%s", cand_sha, fwhy);
            (void)sy_remove_all(tmp);
            v10_rec(0, "c1-tier16-speed-15x", detail);
            return;
        }
        base_mode = "frozen-record";
    } else {
        for (int r = 0; r < reps; r++) {
            char nop[V10_PW];
            cx_fmt(nop, sizeof nop, "%s/nat-%d.tape", tmp, r);
            if (sy_exists(nop) == 1 || sy_write_file(nop, "", 0, 0644) != 0) {
                (void)sy_remove_all(tmp);
                v10_rec(0, "c1-tier16-speed-15x", "native-out-init-failed");
                return;
            }
            nav[1] = nop;
            if (v10_run_cmd(nav, root, 25, &rc, &nat_ns[r], obuf, sizeof obuf, 0, 0, 0) != 0 || rc != 0 ||
                v10_find_line(obuf, "TLDCE_DRIVER\t", line, sizeof line) != 0 ||
                !v10_files_eq(ref_out, nop)) {
                (void)sy_remove_all(tmp);
                v10_rec(0, "c1-tier16-speed-15x", "native-repeat-failed");
                return;
            }
            (void)sy_unlink(nop);
        }
        int64_t sorted_ns[V10_MAX_REPS];
        mm_copy(sorted_ns, (long)sizeof sorted_ns, nat_ns, (long)sizeof nat_ns);
        v10_sort_i64(sorted_ns, reps);
        nat_med_ns = sorted_ns[reps / 2];
        if (write_frozen && write_frozen[0]) {
            char row[1024];
            if (cx_fmt(row, sizeof row, "v10_frozen_v2\t%s\t%s\t%s\t%d\t%s\t%lld\t",
                       cand_sha, input_sha, harness_sha, reps, l1_start, (long long)nat_med_ns)) {
                (void)sy_remove_all(tmp);
                v10_rec(0, "c1-tier16-speed-15x", "write-frozen-format");
                return;
            }
            long rp = (long)strlen(row);
            for (int r = 0; r < reps; r++) {
                if (cx_fmt(row + rp, sizeof row - (size_t)rp, r + 1 < reps ? "%lld," : "%lld\n", (long long)nat_ns[r])) {
                    (void)sy_remove_all(tmp);
                    v10_rec(0, "c1-tier16-speed-15x", "write-frozen-format");
                    return;
                }
                rp += (long)strlen(row + rp);
            }
            if (cx_write(write_frozen, row, (size_t)rp)) {
                (void)sy_remove_all(tmp);
                v10_rec(0, "c1-tier16-speed-15x", "write-frozen-failed");
                return;
            }
        }
    }

    char tout_w[V10_PW];
    cx_fmt(tout_w, sizeof tout_w, "%s/tape-out-warm.tape", tmp);
    char *tav[32];
    int tk = 0;
    tav[tk++] = run_bin;
    tav[tk++] = "--so"; tav[tk++] = so_path;
    tav[tk++] = "--budget"; tav[tk++] = "500000000";
    tav[tk++] = drv_slice;
    int out_arg_idx = tk++;
    tav[out_arg_idx] = tout_w;
    for (int i = 0; i < nobjs; i++) tav[tk++] = objs[i];
    tav[tk] = 0;

    if (sy_exists(tout_w) == 1 || sy_write_file(tout_w, "", 0, 0644) != 0) {
        (void)sy_remove_all(tmp);
        v10_rec(0, "c1-tier16-speed-15x", "tape-warmup-out-init-failed");
        return;
    }
    int trc = 0;
    if (v10_run_cmd(tav, root, 20, &trc, &wns, obuf, sizeof obuf, 0, 0, 0) != 0 || trc != 0) {
        unsigned long long st = 99ull, ec = 99ull;
        if (v10_find_line(obuf, "TAPEMODE_RUN\t", line, sizeof line) == 0) {
            (void)v10_line_kv_u64(line, "status", &st);
            (void)v10_line_kv_u64(line, "exit_code", &ec);
        }
        cx_fmt(detail, sizeof detail,
               "reps=%d cand_sha=%.12s baseline=%s nat_med_ms=%.3f tape_warmup=FAIL rc=%d status=%llu exit_code=%llu load1=%s",
               reps, cand_sha, base_mode, (double)nat_med_ns / 1e6, trc, st, ec, l1_start);
        (void)sy_remove_all(tmp);
        v10_rec(0, "c1-tier16-speed-15x", detail);
        return;
    }
    (void)sy_unlink(tout_w);

    int64_t tape_ns[V10_MAX_REPS];
    int cmp_all = 1;
    for (int r = 0; r < reps; r++) {
        char tout[V10_PW];
        cx_fmt(tout, sizeof tout, "%s/tape-out-%d.tape", tmp, r);
        if (sy_exists(tout) == 1 || sy_write_file(tout, "", 0, 0644) != 0) {
            (void)sy_remove_all(tmp);
            v10_rec(0, "c1-tier16-speed-15x", "tape-out-init-failed");
            return;
        }
        tav[out_arg_idx] = tout;
        int tr = v10_run_cmd(tav, root, 20, &trc, &tape_ns[r], obuf, sizeof obuf, 0, 0, 0);
        unsigned long long st = 99ull, ec = 99ull, stp = 0, tcut = 0, tu = 0;
        int frame_ok = (v10_find_line(obuf, "TAPEMODE_RUN\t", line, sizeof line) == 0 &&
                        v10_line_kv_u64(line, "status", &st) == 0 && st == 0ull &&
                        v10_line_kv_u64(line, "exit_code", &ec) == 0 && ec == 0ull &&
                        v10_line_kv_u64(line, "steps", &stp) == 0 && stp > 0ull);
        int drv_ok = (v10_find_line(obuf, "TLDCE_DRIVER\t", line, sizeof line) == 0 &&
                      v10_line_kv_u64(line, "units", &tu) == 0 && tu == 16ull &&
                      v10_line_kv_u64(line, "dce_cut", &tcut) == 0 && tcut == ref_cut);
        if (tr != 0 || trc != 0 || !frame_ok || !drv_ok || !v10_files_eq(ref_out, tout)) {
            cmp_all = 0;
            cx_fmt(detail, sizeof detail,
                   "reps=%d cand_sha=%.12s baseline=%s nat_med_ms=%.3f tape_rep=%d rc=%d status=%llu cmp_ok=0 load1=%s",
                   reps, cand_sha, base_mode, (double)nat_med_ns / 1e6, r + 1, trc, st, l1_start);
            (void)sy_remove_all(tmp);
            v10_rec(0, "c1-tier16-speed-15x", detail);
            return;
        }
        (void)sy_unlink(tout);
    }

    char l1_end[32];
    int l1e_x100 = v10_read_load1_x100(l1_end);
    int quiet = v10_quiet_ok(l1s_x100, max_load_x100) && v10_quiet_ok(l1e_x100, max_load_x100);
    v10_sort_i64(tape_ns, reps);
    int64_t tape_med_ns = tape_ns[reps / 2];
    double ratio = (double)tape_med_ns / (double)(nat_med_ns > 0 ? nat_med_ns : 1);
    int sp_ok = v10_speed_ok(tape_med_ns, nat_med_ns);

    cx_fmt(detail, sizeof detail,
           "reps=%d cand_sha=%.12s baseline=%s input=%.12s harness=%.12s nat_med_ms=%.3f tape_med_ms=%.3f ratio=%.3f limit=15.000 quiet=%d load1_start=%s load1_end=%s cmp=%s",
           reps, cand_sha, base_mode, input_sha, harness_sha, (double)nat_med_ns / 1e6, (double)tape_med_ns / 1e6,
           ratio, quiet, l1_start, l1_end, cmp_all ? "EQUAL" : "DIFF");
    (void)sy_remove_all(tmp);
    v10_rec(sp_ok && quiet && cmp_all, "c1-tier16-speed-15x", detail);
}

static int v10_count_executed_unit_shards(const char *obuf, int expect_shards, int *shards_seen_out) {
    int seen[64];
    for (int i = 0; i < 64; i++) seen[i] = 0;
    int total_units = 0, n_seen = 0, expect_idx = 0;
    const char *p = obuf;
    while (p && *p) {
        const char *e = p;
        while (*e && *e != '\n' && *e != '\r') e++;
        size_t ln = (size_t)(e - p);
        if (ln > 10 && memcmp(p, "SHARD_RUN\t", 10) == 0 && ln < 511) {
            char line[512];
            mm_copy(line, sizeof line, p, (long)ln);
            line[ln] = 0;
            if (v10_line_has_str(line, "kind", "unit")) {
                char nm[64];
                unsigned long long ucnt = 0, urc = 99ull, ustp = 0;
                if (v10_line_kv_str(line, "name", nm, sizeof nm) != 0 || nm[0] != 'u' || !nm[1]) return -1;
                int64_t idx = -1;
                if (tx_to_i64(nm + 1, (long)strlen(nm + 1), 10, &idx) != 0 ||
                    idx != (int64_t)expect_idx || idx < 0 || idx >= 64 || seen[idx]) return -1;
                if (v10_line_kv_u64(line, "units", &ucnt) != 0 || ucnt == 0ull || ucnt > (unsigned long long)V10_MAX_OBJS ||
                    v10_line_kv_u64(line, "rc", &urc) != 0 || urc != 0ull ||
                    v10_line_kv_u64(line, "steps", &ustp) != 0 || ustp == 0ull) return -1;
                seen[idx] = 1;
                total_units += (int)ucnt;
                n_seen++;
                expect_idx++;
            }
        }
        p = *e ? e + 1 : e;
    }
    if (shards_seen_out) *shards_seen_out = n_seen;
    if (n_seen != expect_shards || n_seen <= 0) return -1;
    return total_units;
}

static int v10_run_shard_stage(const char *root, const char *cand_ape, const char *shard_tool,
                               const char *tool_sha_pre, const char *eff_man, const char *eff_dir,
                               const char *run_dir, const char *stage, int shard_idx, const char *out_path,
                               char *stage_buf, size_t stage_cap, char *comb_buf, size_t comb_cap,
                               size_t *comb_pos, int *rc_out, int *tr_out) {
    char idx_s[16];
    char *av[32];
    int k = 0;
    av[k++] = "sh"; av[k++] = (char *)cand_ape; av[k++] = (char *)shard_tool; av[k++] = "--";
    av[k++] = "--manifest"; av[k++] = (char *)eff_man;
    av[k++] = "--obj-dir"; av[k++] = (char *)eff_dir;
    av[k++] = "--product"; av[k++] = (char *)cand_ape;
    av[k++] = "--unit-shards"; av[k++] = "4";
    av[k++] = "--dce-root-shards"; av[k++] = "2";
    av[k++] = "--bfs-pops"; av[k++] = "1400";
    av[k++] = "--shard-timeout"; av[k++] = "55";
    av[k++] = "--run-dir"; av[k++] = (char *)run_dir;
    av[k++] = "--stage"; av[k++] = (char *)stage;
    if (shard_idx >= 0) {
        cx_fmt(idx_s, sizeof idx_s, "%d", shard_idx);
        av[k++] = "--shard-idx"; av[k++] = idx_s;
    }
    if (out_path && out_path[0]) {
        av[k++] = "--out"; av[k++] = (char *)out_path;
    }
    av[k] = 0;
    int rc = 0;
    int tr = v10_run_cmd(av, root, 58, &rc, 0, stage_buf, stage_cap, 0, 0, 0);
    if (rc_out) *rc_out = rc;
    if (tr_out) *tr_out = tr;
    char tool_sha_post[65];
    if (tr != 0 || rc != 0 || v10_sha_bytes(shard_tool, tool_sha_post, 0) != 0 ||
        !tx_eqz(tool_sha_pre, tool_sha_post)) {
        return -1;
    }
    size_t slen = strlen(stage_buf);
    if (slen > 0 && *comb_pos + slen + 2 < comb_cap) {
        mm_copy(comb_buf + *comb_pos, (long)(comb_cap - *comb_pos), stage_buf, (long)slen);
        *comb_pos += slen;
        if (comb_buf[*comb_pos - 1] != '\n') comb_buf[(*comb_pos)++] = '\n';
        comb_buf[*comb_pos] = 0;
    }
    return 0;
}

static void v10_check_c2_c3(const char *root, const char *cand_ape, const char *shard_tool,
                            const char *chain_dir, const char *t102_dir, const char *t102_man) {
    char detail[512];
    static char objs[V10_MAX_OBJS][512];
    int expected_units = 0;
    const char *eff_dir = t102_dir;
    const char *eff_man = t102_man;
    char tmp[V10_PW], auto_man[V10_PW], g2_dir[V10_PW];
    tmp[0] = 0;
    int build_auto_man = 0;
    if (t102_man && t102_man[0]) {
        int bad_m = 0;
        expected_units = v10_load_manifest(t102_man, t102_dir, objs, &bad_m);
        if (bad_m != 0 || expected_units < V10_MIN_TIER102_UNITS) {
            cx_fmt(detail, sizeof detail, "expected_units=%d bad_manifest=%d min_units=%d",
                   expected_units, bad_m, V10_MIN_TIER102_UNITS);
            v10_rec(0, "c2-tier102-sharded-cmp-equal", detail);
            v10_rec(0, "c3-all-units-ran-under-tape", detail);
            return;
        }
    } else if (chain_dir && chain_dir[0]) {
        expected_units = v10_load_receipt_objs(chain_dir, objs);
        if (expected_units < V10_MIN_TIER102_UNITS) {
            cx_fmt(detail, sizeof detail, "expected_units=%d min_units=%d reason=receipt-objs-missing",
                   expected_units, V10_MIN_TIER102_UNITS);
            v10_rec(0, "c2-tier102-sharded-cmp-equal", detail);
            v10_rec(0, "c3-all-units-ran-under-tape", detail);
            return;
        }
        if (cx_fmt(g2_dir, sizeof g2_dir, "%s/fixedpoint/g2/lnx-x86_64", chain_dir)) {
            v10_rec(0, "c2-tier102-sharded-cmp-equal", "path-too-long");
            v10_rec(0, "c3-all-units-ran-under-tape", "path-too-long");
            return;
        }
        eff_dir = g2_dir;
        build_auto_man = 1;
    } else {
        cx_fmt(detail, sizeof detail, "expected_units=0 min_units=%d reason=no-tier102-inventory",
               V10_MIN_TIER102_UNITS);
        v10_rec(0, "c2-tier102-sharded-cmp-equal", detail);
        v10_rec(0, "c3-all-units-ran-under-tape", detail);
        return;
    }

    if (!shard_tool || !shard_tool[0] || sy_exists(shard_tool) != 1) {
        cx_fmt(detail, sizeof detail,
               "expected_units=%d ran_units=0 cmp=UNMEASURED reason=shard-tool-not-committed",
               expected_units);
        v10_rec(0, "c2-tier102-sharded-cmp-equal", detail);
        cx_fmt(detail, sizeof detail,
               "expected_units=%d ran_units=0 min_units=%d reason=sharded-tape-run-absent",
               expected_units, V10_MIN_TIER102_UNITS);
        v10_rec(0, "c3-all-units-ran-under-tape", detail);
        return;
    }

    char tool_sha_pre[65], stamp_p[V10_PW], run_dir[V10_PW], fresh_out[V10_PW];
    if (v10_sha_bytes(shard_tool, tool_sha_pre, 0) != 0 ||
        sy_mkdtemp("/tmp", "check-v0110-c23", tmp, sizeof tmp) != 0 ||
        cx_fmt(stamp_p, sizeof stamp_p, "%s/invoke.stamp", tmp) ||
        cx_fmt(run_dir, sizeof run_dir, "%s/shard_run", tmp) ||
        cx_fmt(fresh_out, sizeof fresh_out, "%s/sharded_final.tape", tmp) ||
        sy_exists(fresh_out) == 1 ||
        cx_write(stamp_p, "S", 1)) {
        if (tmp[0]) (void)sy_remove_all(tmp);
        v10_rec(0, "c2-tier102-sharded-cmp-equal", "fresh-run-setup-failed");
        v10_rec(0, "c3-all-units-ran-under-tape", "fresh-run-setup-failed");
        return;
    }
    if (build_auto_man) {
        static char mbuf[32768];
        long mpos = 0;
        size_t g2l = strlen(g2_dir);
        for (int i = 0; i < expected_units; i++) {
            char osha[65];
            const char *rel = objs[i];
            if (strncmp(rel, g2_dir, g2l) == 0 && rel[g2l] == '/') rel += g2l + 1;
            if (v10_sha_bytes(objs[i], osha, 0) != 0 ||
                cx_fmt(mbuf + mpos, sizeof mbuf - (size_t)mpos, "%s  %s\n", osha, rel)) {
                (void)sy_remove_all(tmp);
                v10_rec(0, "c2-tier102-sharded-cmp-equal", "auto-manifest-failed");
                v10_rec(0, "c3-all-units-ran-under-tape", "auto-manifest-failed");
                return;
            }
            mpos += (long)strlen(mbuf + mpos);
        }
        if (cx_fmt(auto_man, sizeof auto_man, "%s/receipt_manifest.txt", tmp) ||
            cx_write(auto_man, mbuf, (size_t)mpos)) {
            (void)sy_remove_all(tmp);
            v10_rec(0, "c2-tier102-sharded-cmp-equal", "auto-manifest-write-failed");
            v10_rec(0, "c3-all-units-ran-under-tape", "auto-manifest-write-failed");
            return;
        }
        eff_man = auto_man;
    }
    sy_stat_t stamp_st, out_st;
    if (sy_stat(stamp_p, &stamp_st) != 0) {
        (void)sy_remove_all(tmp);
        v10_rec(0, "c2-tier102-sharded-cmp-equal", "stamp-stat-failed");
        v10_rec(0, "c3-all-units-ran-under-tape", "stamp-stat-failed");
        return;
    }

    static char obuf[65536], stage_buf[16384];
    obuf[0] = 0;
    size_t comb_pos = 0;
    int rc = 0, tr = 0;
    const char *fail_stage = "prep";
    int st_ok = (v10_run_shard_stage(root, cand_ape, shard_tool, tool_sha_pre, eff_man, eff_dir,
                                       run_dir, "prep", -1, 0, stage_buf, sizeof stage_buf,
                                       obuf, sizeof obuf, &comb_pos, &rc, &tr) == 0);
    if (st_ok) {
        fail_stage = "native";
        st_ok = (v10_run_shard_stage(root, cand_ape, shard_tool, tool_sha_pre, eff_man, eff_dir,
                                     run_dir, "native", -1, 0, stage_buf, sizeof stage_buf,
                                     obuf, sizeof obuf, &comb_pos, &rc, &tr) == 0);
    }
    for (int s = 0; st_ok && s < V10_UNIT_SHARDS; s++) {
        fail_stage = "unit";
        st_ok = (v10_run_shard_stage(root, cand_ape, shard_tool, tool_sha_pre, eff_man, eff_dir,
                                     run_dir, "unit", s, 0, stage_buf, sizeof stage_buf,
                                     obuf, sizeof obuf, &comb_pos, &rc, &tr) == 0);
    }
    int dce_skipped = 0;
    char sline[512];
    for (int r = 0; st_ok && r < 2 && !dce_skipped; r++) {
        fail_stage = "dce-root";
        st_ok = (v10_run_shard_stage(root, cand_ape, shard_tool, tool_sha_pre, eff_man, eff_dir,
                                     run_dir, "dce-root", r, 0, stage_buf, sizeof stage_buf,
                                     obuf, sizeof obuf, &comb_pos, &rc, &tr) == 0);
        if (st_ok && v10_find_line(stage_buf, "SHARD_RUN\t", sline, sizeof sline) == 0) {
            unsigned long long sk = 0;
            if (v10_line_kv_u64(sline, "skip", &sk) == 0 && sk == 1ull) dce_skipped = 1;
        }
    }
    for (int w = 0; st_ok && !dce_skipped; w++) {
        if (w >= 24) { fail_stage = "dce-bfs-max"; st_ok = 0; break; }
        fail_stage = "dce-bfs";
        st_ok = (v10_run_shard_stage(root, cand_ape, shard_tool, tool_sha_pre, eff_man, eff_dir,
                                     run_dir, "dce-bfs", w, 0, stage_buf, sizeof stage_buf,
                                     obuf, sizeof obuf, &comb_pos, &rc, &tr) == 0);
        if (!st_ok) break;
        unsigned long long rem = 1ull;
        if (v10_find_line(stage_buf, "SHARD_RUN\t", sline, sizeof sline) != 0 ||
            v10_line_kv_u64(sline, "rem", &rem) != 0) {
            fail_stage = "dce-bfs-parse";
            st_ok = 0;
            break;
        }
        if (rem == 0ull) break;
    }
    if (st_ok) {
        fail_stage = "compact";
        st_ok = (v10_run_shard_stage(root, cand_ape, shard_tool, tool_sha_pre, eff_man, eff_dir,
                                     run_dir, "compact", -1, fresh_out, stage_buf, sizeof stage_buf,
                                     obuf, sizeof obuf, &comb_pos, &rc, &tr) == 0);
    }

    if (!st_ok) {
        cx_fmt(detail, sizeof detail, "expected_units=%d stage=%s shard_tool=%s tr=%d rc=%d cmp=FAIL",
               expected_units, fail_stage, shard_tool, tr, rc);
        (void)sy_remove_all(tmp);
        v10_rec(0, "c2-tier102-sharded-cmp-equal", detail);
        v10_rec(0, "c3-all-units-ran-under-tape", detail);
        return;
    }

    char line[512], sum_cmp[32], sum_sha[128];
    unsigned long long nat_u = 0, nat_cut = 0, sum_u = 0, sum_bytes = 0, sum_cut = 0, m1_sub = 0;
    int slice_ok = (v10_find_line(obuf, "SHARD_SLICE\t", line, sizeof line) == 0 &&
                    v10_line_kv_u64(line, "subset_m1_383", &m1_sub) == 0 && m1_sub == 1ull);
    int nat_ok = (v10_find_line(obuf, "NATIVE_REF\t", line, sizeof line) == 0 &&
                  v10_line_kv_u64(line, "units", &nat_u) == 0 && nat_u == (unsigned long long)expected_units &&
                  v10_line_kv_u64(line, "dce_cut", &nat_cut) == 0 && nat_cut > 0ull);
    int sum_ok = (v10_find_line(obuf, "TAPE_TLDCE_SHARD_SUMMARY\t", line, sizeof line) == 0 &&
                  v10_line_kv_u64(line, "units", &sum_u) == 0 && sum_u == (unsigned long long)expected_units &&
                  v10_line_kv_u64(line, "bytes", &sum_bytes) == 0 && sum_bytes > 0ull &&
                  v10_line_kv_u64(line, "dce_cut", &sum_cut) == 0 && sum_cut == nat_cut &&
                  v10_line_kv_str(line, "cmp", sum_cmp, sizeof sum_cmp) == 0 && tx_eqz(sum_cmp, "EQUAL") &&
                  v10_line_kv_str(line, "sha256", sum_sha, sizeof sum_sha) == 0 && v10_is_hex64(sum_sha));

    int shards_seen = 0;
    int ran_from_shards = v10_count_executed_unit_shards(obuf, V10_UNIT_SHARDS, &shards_seen);

    char actual_out_sha[65];
    long actual_out_bytes = -1;
    int fresh_ok = (sy_stat(fresh_out, &out_st) == 0 && out_st.kind == 'f' &&
                    out_st.mtime >= stamp_st.mtime &&
                    v10_sha_bytes(fresh_out, actual_out_sha, &actual_out_bytes) == 0 &&
                    actual_out_bytes > 0 && (unsigned long long)actual_out_bytes == sum_bytes &&
                    tx_eqz(actual_out_sha, sum_sha));

    int c2_ok = (slice_ok && nat_ok && sum_ok && fresh_ok);
    int c3_ok = (c2_ok && v10_units_ok(expected_units, ran_from_shards));

    cx_fmt(detail, sizeof detail,
           "expected_units=%d ran_from_shards=%d shards=%d cmp=%s fresh=%d tool_sha=%.12s shard_tool=%s",
           expected_units, ran_from_shards, shards_seen, sum_ok ? sum_cmp : "FAIL",
           fresh_ok, tool_sha_pre, shard_tool);
    (void)sy_remove_all(tmp);
    v10_rec(c2_ok && ran_from_shards == expected_units, "c2-tier102-sharded-cmp-equal", detail);
    v10_rec(c3_ok, "c3-all-units-ran-under-tape", detail);
}

static int v10_self_test(const char *root) {
    v10_rec(v10_speed_ok(15000000LL, 1000000LL) && !v10_speed_ok(15000001LL, 1000000LL),
            "selftest.speed-15x-boundary", "15.000x/15.001x");
    v10_rec(v10_quiet_ok(350, 600) && v10_quiet_ok(600, 600) && !v10_quiet_ok(601, 600),
            "selftest.quiet-load1", "6.00/6.01");
    v10_rec(v10_units_ok(102, 102) && v10_units_ok(105, 105) && v10_units_ok(106, 106) &&
            !v10_units_ok(101, 101) && !v10_units_ok(106, 105),
            "selftest.unit-count-coverage", "102/105/106");

    char pat[] = "/tmp/check-v0110-self-XXXXXX";
    if (!mkdtemp(pat)) return 2;

    /* Item (1) red-first: frozen baseline pins cand_sha + input_sha + harness_sha + reps=9 + quiet load1 + raw sample median. */
    {
        char fpath[V10_PW], s1[65], s2[65], i1[65], i2[65], h1[65], h2[65], row[512], why[128];
        mm_fill(s1, 65, 'a', 64); s1[64] = 0;
        mm_fill(s2, 65, 'b', 64); s2[64] = 0;
        mm_fill(i1, 65, 'c', 64); i1[64] = 0;
        mm_fill(i2, 65, 'd', 64); i2[64] = 0;
        mm_fill(h1, 65, 'e', 64); h1[64] = 0;
        mm_fill(h2, 65, 'f', 64); h2[64] = 0;
        int64_t got_ns = 0;
        const char *samp = "100,200,300,400,500,600,700,800,900";
        if (cx_fmt(fpath, sizeof fpath, "%s/frozen.tsv", pat) ||
            cx_fmt(row, sizeof row, "v10_frozen_v2\t%s\t%s\t%s\t9\t2.50\t500\t%s\n", s1, i1, h1, samp) ||
            cx_write(fpath, row, (size_t)tx_len(row, sizeof row))) {
            (void)sy_remove_all(pat); return 2;
        }
        int ok_hit = (v10_load_frozen_baseline(fpath, s1, i1, h1, 9, 600, &got_ns, why, sizeof why) == 0 && got_ns == 500LL);
        int ok_cand = (v10_load_frozen_baseline(fpath, s2, i1, h1, 9, 600, &got_ns, why, sizeof why) == -2);
        int ok_inp = (v10_load_frozen_baseline(fpath, s1, i2, h1, 9, 600, &got_ns, why, sizeof why) == -3);
        int ok_har = (v10_load_frozen_baseline(fpath, s1, i1, h2, 9, 600, &got_ns, why, sizeof why) == -4);

        char badrow[512];
        cx_fmt(badrow, sizeof badrow, "v10_frozen_v2\t%s\t%s\t%s\t9\t2.50\t999\t%s\n", s1, i1, h1, samp);
        (void)cx_write(fpath, badrow, (size_t)tx_len(badrow, sizeof badrow));
        int ok_med = (v10_load_frozen_baseline(fpath, s1, i1, h1, 9, 600, &got_ns, why, sizeof why) == -5);

        cx_fmt(badrow, sizeof badrow, "v10_frozen_v2\t%s\t%s\t%s\t9\t9.50\t500\t%s\n", s1, i1, h1, samp);
        (void)cx_write(fpath, badrow, (size_t)tx_len(badrow, sizeof badrow));
        int ok_load = (v10_load_frozen_baseline(fpath, s1, i1, h1, 9, 600, &got_ns, why, sizeof why) == -6);

        cx_fmt(badrow, sizeof badrow, "%s\t1234567\t1.50\n", s1);
        (void)cx_write(fpath, badrow, (size_t)tx_len(badrow, sizeof badrow));
        int ok_leg = (v10_load_frozen_baseline(fpath, s1, i1, h1, 9, 600, &got_ns, why, sizeof why) == -1);

        v10_rec(ok_hit && ok_cand && ok_inp && ok_har && ok_med && ok_load && ok_leg,
                "selftest.item1-frozen-baseline-pinning", "v2+cand+input+harness+median+quiet+legacy-refused");
    }

    /* Item (2) red-first: resolve tools/tape-tldce-shard.cx by default and reject --repeat != 9. */
    {
        char fxroot[V10_PW], fxt[V10_PW], fxsh[V10_PW], res[V10_PW], unis[V10_PW], c0[V10_PW];
        int res_ok = (!cx_fmt(fxroot, sizeof fxroot, "%s/fxroot", pat) &&
                      !cx_fmt(fxt, sizeof fxt, "%s/tools", fxroot) &&
                      !cx_fmt(fxsh, sizeof fxsh, "%s/tape-tldce-shard.cx", fxt) &&
                      !sy_mkdir_all(fxt, 0755) &&
                      !cx_write(fxsh, "/* shard */\n", 12) &&
                      (v10_resolve_shard_tool(fxroot, 0, res), tx_eqz(res, fxsh)));
        int rc_rep = 0;
        char obuf[4096];
        cx_fmt(unis, sizeof unis, "%s/unisacc.com", root);
        cx_fmt(c0, sizeof c0, "%s/tools/check-v0110-exit.cx", root);
        char *av_bad_rep[] = {"sh", unis, c0, "--", "--repeat", "1", 0};
        int tr = v10_run_cmd(av_bad_rep, root, 20, &rc_rep, 0, obuf, sizeof obuf, 0, 0, 0);
        v10_rec(res_ok && tr == 0 && rc_rep == 2,
                "selftest.item2-resolve-and-fixed-repeat", "tape-tldce-shard+repeat1-refused");
    }

    /* Items (2)+(3)+(4) e2e harness with real 102-entry manifest and mock shard .cx tool. */
    {
        char odir[V10_PW], mpath[V10_PW], mock_cx[V10_PW], unis[V10_PW];
        char lnk_cx[V10_PW], tgt_cx[V10_PW], lnk_tsv[V10_PW], tgt_tsv[V10_PW];
        char osha[65];
        int setup_ok = 1;
        if (cx_fmt(odir, sizeof odir, "%s/objs102", pat) ||
            cx_fmt(mpath, sizeof mpath, "%s/manifest.txt", pat) ||
            cx_fmt(mock_cx, sizeof mock_cx, "%s/mock_shard.cx", pat) ||
            cx_fmt(unis, sizeof unis, "%s/unisacc.com", root) ||
            cx_fmt(lnk_cx, sizeof lnk_cx, "%s/cx", pat) || cx_fmt(tgt_cx, sizeof tgt_cx, "%s/cx", root) ||
            cx_fmt(lnk_tsv, sizeof lnk_tsv, "%s/cxroot.tsv", pat) || cx_fmt(tgt_tsv, sizeof tgt_tsv, "%s/cxroot.tsv", root) ||
            sy_mkdir_all(odir, 0755) || sy_symlink(tgt_cx, lnk_cx) || sy_symlink(tgt_tsv, lnk_tsv)) setup_ok = 0;

        if (setup_ok) {
            static char mtxt[16384];
            long mp = 0;
            cx_sha256_hex("OBJ1", 4, osha);
            for (int i = 0; i < 102; i++) {
                char op[V10_PW];
                if (cx_fmt(op, sizeof op, "%s/u%03d.o", odir, i) || cx_write(op, "OBJ1", 4) ||
                    cx_fmt(mtxt + mp, sizeof mtxt - (size_t)mp, "%s  u%03d.o\n", osha, i)) {
                    setup_ok = 0; break;
                }
                mp += (long)strlen(mtxt + mp);
            }
            if (setup_ok && cx_write(mpath, mtxt, (size_t)mp)) setup_ok = 0;
        }
        const char *msrc =
            "#pragma unisa use sys.fs\n#pragma unisa use sys.env\n#pragma unisa use sys.io\n"
            "#pragma unisa use sys.sha\n#pragma unisa use text.text\n"
            "#pragma unisa use text.conv\n"
            "int main(int argc, char **argv) {\n"
            "  const char *mode = sy_env(\"V10_MOCK_SHARD\");\n"
            "  const char *outp = 0, *stg = 0, *rdir = 0;\n"
            "  int seen_man=0,seen_od=0,seen_us=0,seen_rs=0,seen_bp=0,seen_to=0,sidx=-1;\n"
            "  for (int i = 1; i + 1 < argc; i++) {\n"
            "    if (tx_eqz(argv[i], \"--manifest\")) seen_man=1;\n"
            "    else if (tx_eqz(argv[i], \"--obj-dir\")) seen_od=1;\n"
            "    else if (tx_eqz(argv[i], \"--unit-shards\")) seen_us=1;\n"
            "    else if (tx_eqz(argv[i], \"--dce-root-shards\")) seen_rs=1;\n"
            "    else if (tx_eqz(argv[i], \"--bfs-pops\")) seen_bp=1;\n"
            "    else if (tx_eqz(argv[i], \"--shard-timeout\")) seen_to=1;\n"
            "    else if (tx_eqz(argv[i], \"--run-dir\")) rdir = argv[i+1];\n"
            "    else if (tx_eqz(argv[i], \"--stage\")) stg = argv[i+1];\n"
            "    else if (tx_eqz(argv[i], \"--shard-idx\")) { int64_t v=-1; (void)tx_to_i64(argv[i+1],(long)strlen(argv[i+1]),10,&v); sidx=(int)v; }\n"
            "    else if (tx_eqz(argv[i], \"--out\")) outp = argv[i+1];\n"
            "  }\n"
            "  if (!seen_man || !seen_od || !seen_us || !seen_rs || !seen_bp || !seen_to || !rdir || !stg) return 2;\n"
            "  const char *payload = \"TAPE_MOCK_OUT\";\n"
            "  char sha[65], buf[1024]; cx_sha256_hex(payload, 13, sha);\n"
            "  int use_err = (mode && tx_eqz(mode, \"stderr-only\"));\n"
            "  int skip_u2 = (mode && tx_eqz(mode, \"skip-u2\"));\n"
            "  buf[0] = 0;\n"
            "  if (tx_eqz(stg, \"prep\")) cx_fmt(buf, sizeof buf, \"SHARD_SLICE\\tbytes=100\\thost_slots=8\\tmask=383\\tsubset_m1_383=1\\nSTAGE_PREP\\trun_id=m1\\tunits=102\\n\");\n"
            "  else if (tx_eqz(stg, \"native\")) cx_fmt(buf, sizeof buf, \"NATIVE_REF\\tunits=102\\tms=5\\tdce_cut=7\\n\");\n"
            "  else if (tx_eqz(stg, \"unit\")) {\n"
            "    if (!(skip_u2 && sidx == 2)) cx_fmt(buf, sizeof buf, \"SHARD_RUN\\tname=u%d\\tkind=unit\\tunits=%d\\trc=0\\tms=5\\tsteps=100\\n\", sidx, sidx < 2 ? 26 : 25);\n"
            "  } else if (tx_eqz(stg, \"dce-root\")) cx_fmt(buf, sizeof buf, \"SHARD_RUN\\tname=r%d\\tkind=dce_root\\trc=0\\tms=3\\tsteps=50\\tskip=0\\n\", sidx);\n"
            "  else if (tx_eqz(stg, \"dce-bfs\")) cx_fmt(buf, sizeof buf, \"SHARD_RUN\\tname=w%d\\tkind=dce_bfs\\tpops=10\\trem=0\\trc=0\\tms=2\\tsteps=20\\n\", sidx);\n"
            "  else if (tx_eqz(stg, \"compact\")) {\n"
            "    if (!outp) return 2;\n"
            "    if (mode && tx_eqz(mode, \"sha-mismatch\")) { if (cx_write(outp, \"WRONG_OUT_DATA\", 14)) return 2; }\n"
            "    else if (!mode || !tx_eqz(mode, \"no-out-write\")) { if (cx_write(outp, payload, 13)) return 2; }\n"
            "    cx_fmt(buf, sizeof buf, \"SHARD_RUN\\tname=c0\\tkind=dce_compact\\tdce_cut=7\\trc=0\\tms=2\\tsteps=10\\nTAPE_TLDCE_SHARD_SUMMARY\\tunits=102\\tshards=7\\ttotal_ms=25\\tmax_shard_ms=6\\ttotal_steps=410\\tbytes=13\\tdce_cut=7\\tcmp=EQUAL\\tsha256=%s\\n\", sha);\n"
            "  } else return 2;\n"
            "  (void)sy_write_all(use_err ? 2 : 1, buf, (long)strlen(buf));\n"
            "  return 0;\n"
            "}\n";
        if (setup_ok && cx_write(mock_cx, msrc, (size_t)tx_len(msrc, 4096))) setup_ok = 0;

        int ok_pos = 0, ok_noout = 0, ok_sha = 0, ok_err = 0, ok_skip = 0, ok_mut = 0;
        if (setup_ok) {
            char isha_a[65], isha_b[65];
            char one_obj[V10_PW];
            static char objs_mut[2][512];
            cx_fmt(objs_mut[0], 512, "%s/u000.o", odir);
            cx_fmt(objs_mut[1], 512, "%s/u001.o", odir);
            if (v10_input_set_sha(mpath, objs_mut, 2, isha_a) == 0 &&
                !cx_fmt(one_obj, sizeof one_obj, "%s/u001.o", odir) &&
                !cx_write(one_obj, "MUT2", 4) &&
                v10_input_set_sha(mpath, objs_mut, 2, isha_b) == 0) {
                ok_mut = !tx_eqz(isha_a, isha_b);
                (void)cx_write(one_obj, "OBJ1", 4);
            }

            int sp = g_pass, sf = g_fail;
            g_quiet_rec = 1;
            sy_setenv("V10_MOCK_SHARD", "ok", 1);
            g_pass = 0; g_fail = 0;
            v10_check_c2_c3(root, unis, mock_cx, 0, odir, mpath);
            ok_pos = (g_pass == 2 && g_fail == 0);

            sy_setenv("V10_MOCK_SHARD", "no-out-write", 1);
            g_pass = 0; g_fail = 0;
            v10_check_c2_c3(root, unis, mock_cx, 0, odir, mpath);
            ok_noout = (g_fail == 2);

            sy_setenv("V10_MOCK_SHARD", "sha-mismatch", 1);
            g_pass = 0; g_fail = 0;
            v10_check_c2_c3(root, unis, mock_cx, 0, odir, mpath);
            ok_sha = (g_fail == 2);

            sy_setenv("V10_MOCK_SHARD", "stderr-only", 1);
            g_pass = 0; g_fail = 0;
            v10_check_c2_c3(root, unis, mock_cx, 0, odir, mpath);
            ok_err = (g_fail == 2);

            sy_setenv("V10_MOCK_SHARD", "skip-u2", 1);
            g_pass = 0; g_fail = 0;
            v10_check_c2_c3(root, unis, mock_cx, 0, odir, mpath);
            ok_skip = (g_fail == 2);

            g_quiet_rec = 0;
            (void)sy_unsetenv("V10_MOCK_SHARD");
            g_pass = sp; g_fail = sf;
        }
        v10_rec(ok_pos, "selftest.item2-shard-cli-flags-e2e", "actual-flags-passed-to-shard-tool");
        v10_rec(ok_noout && ok_sha && ok_err, "selftest.item3-fresh-out-sha-stdout-required",
                "no-out+sha-mismatch+stderr-only-all-refused");
        v10_rec(ok_skip, "selftest.item4-unit-shards-sum-rejects-skipped-u2",
                "77-of-102-units-refused-despite-summary-102");
        v10_rec(ok_mut, "selftest.item1-input-sha-sensitive-to-object-mutation", "mutated-obj-changes-input-sha");
    }

    /* Item (5) red-first: tier16 fixture with no dead extern refuses as named input error (rc=11), NOT warmup/speed fail. */
    {
        char nd_dir[V10_PW], nd_man[V10_PW], unis[V10_PW], mtxt[4096], obuf[4096];
        long mp = 0;
        int nd_built = (!cx_fmt(nd_dir, sizeof nd_dir, "%s/t16_nodead", pat) &&
                        !cx_fmt(nd_man, sizeof nd_man, "%s/manifest.txt", nd_dir) &&
                        !cx_fmt(unis, sizeof unis, "%s/unisacc.com", root) &&
                        !sy_mkdir_all(nd_dir, 0755));
        for (int i = 0; nd_built && i < 16; i++) {
            char sp[V10_PW], op[V10_PW], src[256], hex[65];
            if (cx_fmt(sp, sizeof sp, "%s/u%03d.cx", nd_dir, i) ||
                cx_fmt(op, sizeof op, "%s/u%03d.o", nd_dir, i)) { nd_built = 0; break; }
            if (i == 0) cx_fmt(src, sizeof src, "extern int f_1(int x);\nint main(void) { return f_1(1) & 127; }\n");
            else if (i < 15) cx_fmt(src, sizeof src, "extern int f_%d(int x);\nint f_%d(int x) { return f_%d(x + 1); }\n", i + 1, i, i + 1);
            else cx_fmt(src, sizeof src, "int f_15(int x) { return x; }\n");
            int rc = 0;
            char *avc[] = {"sh", unis, "-O2", "-c", "-b", "lnx/x86_64", "-funit", sp, "-o", op, 0};
            if (cx_write(sp, src, (size_t)tx_len(src, sizeof src)) ||
                v10_run_cmd(avc, root, 25, &rc, 0, obuf, sizeof obuf, 0, 0, 0) != 0 || rc != 0 ||
                v10_sha_bytes(op, hex, 0) != 0 ||
                cx_fmt(mtxt + mp, sizeof mtxt - (size_t)mp, "%s  u%03d.o\n", hex, i)) {
                nd_built = 0; break;
            }
            (void)sy_unlink(sp);
            mp += (long)strlen(mtxt + mp);
        }
        int nd_ok = 0;
        if (nd_built && !cx_write(nd_man, mtxt, (size_t)mp)) {
            int sp = g_pass, sf = g_fail;
            g_quiet_rec = 1;
            g_pass = 0; g_fail = 0;
            v10_check_c1(root, unis, unis, nd_dir, nd_man, 0, 0, V10_GATE_REPS, 100000);
            nd_ok = (g_fail == 1 && strstr(g_last_detail, "REFUSE input-no-dead-extern rc=11") != 0 &&
                     strstr(g_last_detail, "native-warmup-failed") == 0);
            g_quiet_rec = 0;
            g_pass = sp; g_fail = sf;
        }
        v10_rec(nd_ok, "selftest.item5-tier16-no-dead-extern-refusal", "rc11-named-input-refusal");
    }

    (void)sy_remove_all(pat);
    sy_printf("CHECK_V0110_EXIT_SELFTEST\tpassed=%d\tfailed=%d\n", g_pass, g_fail);
    return g_fail ? 1 : 0;
}

int main(int argc, char **argv) {
    const char *chain_dir = 0, *prod_ape = 0, *frozen_path = 0, *write_frozen = 0;
    const char *shard_tool = 0, *t16_dir = ".", *t16_man = 0, *t102_dir = ".", *t102_man = 0;
    int reps = V10_GATE_REPS, self_test = 0, max_load_x100 = V10_GATE_MAX_LOAD_X100;
    char root[V10_PW], def_chain[V10_PW], def_ape[V10_PW], cand_sha[65], shard_path[V10_PW];

    for (int i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--")) continue;
        else if (tx_eqz(argv[i], "--self-test")) self_test = 1;
        else if (tx_eqz(argv[i], "--chain-dir") && i + 1 < argc) chain_dir = argv[++i];
        else if (tx_eqz(argv[i], "--product") && i + 1 < argc) prod_ape = argv[++i];
        else if (tx_eqz(argv[i], "--frozen-baseline") && i + 1 < argc) frozen_path = argv[++i];
        else if (tx_eqz(argv[i], "--write-frozen") && i + 1 < argc) write_frozen = argv[++i];
        else if (tx_eqz(argv[i], "--shard-tool") && i + 1 < argc) shard_tool = argv[++i];
        else if (tx_eqz(argv[i], "--tier16-dir") && i + 1 < argc) t16_dir = argv[++i];
        else if (tx_eqz(argv[i], "--tier16-manifest") && i + 1 < argc) t16_man = argv[++i];
        else if (tx_eqz(argv[i], "--tier102-dir") && i + 1 < argc) t102_dir = argv[++i];
        else if (tx_eqz(argv[i], "--tier102-manifest") && i + 1 < argc) t102_man = argv[++i];
        else if (tx_eqz(argv[i], "--repeat") && i + 1 < argc) {
            int64_t rv = 0;
            const char *rs = argv[++i];
            if (tx_to_i64(rs, (long)strlen(rs), 10, &rv) != 0 || rv != V10_GATE_REPS) {
                sy_eprintf("check-v0110-exit: gate requires --repeat %d (got %s)\n", V10_GATE_REPS, rs);
                return 2;
            }
            reps = (int)rv;
        } else if (tx_eqz(argv[i], "--max-load") && i + 1 < argc) {
            double lv = atof(argv[++i]);
            if (lv <= 0.0 || lv > 6.0) {
                sy_eprintf("check-v0110-exit: bad --max-load (must be >0 and <=6.0)\n");
                return 2;
            }
            max_load_x100 = (int)(lv * 100.0 + 0.5);
        } else if (tx_eqz(argv[i], "--help") || tx_eqz(argv[i], "-h")) {
            sy_printf("usage: sh ./unisacc.com tools/check-v0110-exit.cx -- [--product APE] [--max-load L] [--repeat N] [--frozen-baseline FILE] [--write-frozen FILE] [--shard-tool PATH] [--self-test] [CHAIN_DIR]\n");
            return 0;
        } else if (argv[i][0] == '-') {
            sy_eprintf("check-v0110-exit: unknown option %s\n", argv[i]);
            return 2;
        } else if (!chain_dir) {
            chain_dir = argv[i];
        } else {
            sy_eprintf("check-v0110-exit: unexpected extra arg %s\n", argv[i]);
            return 2;
        }
    }

    if (sy_cwd(root, sizeof root) < 0) return 2;
    if (self_test) return v10_self_test(root);

    if (!chain_dir || !chain_dir[0]) {
        const char *hm = sy_env("HOME");
        if (hm && hm[0] &&
            !cx_fmt(def_chain, sizeof def_chain, "%s/.cache/unisacc/chains/bg-b1/c9275e7756acad801ff2f206b3aa6a891e8115a2", hm) &&
            v10_is_dir(def_chain)) {
            chain_dir = def_chain;
        }
    }
    if (!prod_ape || !prod_ape[0]) {
        if (chain_dir && chain_dir[0] &&
            !cx_fmt(def_ape, sizeof def_ape, "%s/ape-final/unisacc-next.com", chain_dir) &&
            sy_exists(def_ape) == 1) {
            prod_ape = def_ape;
        } else if (!cx_fmt(def_ape, sizeof def_ape, "%s/unisacc.com", root) && sy_exists(def_ape) == 1) {
            prod_ape = def_ape;
        }
    }
    if (!prod_ape || !prod_ape[0] || sy_exists(prod_ape) != 1 ||
        sy_realpath(prod_ape, def_ape, sizeof def_ape) < 0) {
        sy_eprintf("check-v0110-exit: candidate APE missing\n");
        return 2;
    }
    prod_ape = def_ape;
    if (v10_sha_bytes(prod_ape, cand_sha, 0) != 0) {
        sy_eprintf("check-v0110-exit: candidate APE unreadable\n");
        return 2;
    }

    v10_resolve_shard_tool(root, shard_tool, shard_path);
    v10_check_c1(root, prod_ape, cand_sha, t16_dir, t16_man, frozen_path, write_frozen, reps, max_load_x100);
    v10_check_c2_c3(root, prod_ape, shard_path, chain_dir, t102_dir, t102_man);

    sy_printf("CHECK_V0110_EXIT\tverdict=%s\tcandidate_sha=%.12s\tpassed=%d\tfailed=%d\n",
              g_fail == 0 ? "GREEN" : "RED", cand_sha, g_pass, g_fail);
    return g_fail == 0 ? 0 : 1;
}
