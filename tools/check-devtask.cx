/* devtask contracts on a private store directory: add, claim, write-domain conflict refusal, done, block/resume,
 * gap, stale, list through the CLI, event rows, and eight concurrent claims of one task (exactly one wins);
 * job-style work orders (task open/status/done/list): remaining seconds decrease, changes outside the write domain
 * are warned and block done, a failing acceptance gives rc 1 without a task.done row, all passing gives rc 0 with one. */
#pragma unisa use cxlib.devtask
#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
#pragma unisa use sys.time
#pragma unisa use sys.env
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
static int failed, assertions;
static void ck(int ok, const char *s) { assertions++; if (!ok) failed++; printf("%s\t%s\n", ok ? "PASS" : "FAIL", s); }
static const DtTask *find(const DtSet *s, const char *id) { for (int i = 0; i < s->n; i++) if (!strcmp(s->t[i].id, id)) return &s->t[i]; return 0; }
static int state_is(const char *dir, const char *id, const char *state, const char *owner) {
    DtSet s; char why[512]; int ok = 0; const DtTask *t;
    if (dt_load(dir, &s, why, sizeof why)) return 0;
    t = find(&s, id); ok = t && !strcmp(t->state, state) && (!owner || !strcmp(t->owner, owner));
    dt_free(&s); return ok;
}
/* number of event rows for id with the given event name */
static long events(const char *dir, const char *id, const char *ev) {
    char p[2048], key[64]; unsigned char *b = 0; int64_t n = 0; long count = 0, kl;
    if (cx_fmt(p, sizeof p, "%s/task-events.tsv", dir)) return -1;
    if (sy_read_file(p, &b, &n, 1L << 24)) return -1;
    kl = snprintf(key, sizeof key, "\t%s\t%s\t", id, ev);
    for (long i = 0; i + kl <= n; i++) if (!memcmp(b + i, key, kl)) count++;
    free(b); return count;
}
static int sh(char *cmd, np_result *r) { char *v[] = {"sh", "-c", cmd, 0}; char why[256]; return np_run(v, 0, 0, 50, r, why, sizeof why); }
int main(void) {
    char dir[] = "/tmp/check-devtask-XXXXXX", why[2048], id[16], id2[16], id3[16], id4[16], cmd[4096]; long now = 1800000000; DtSet s; np_result r = {0}; int rc;
    if (!mkdtemp(dir)) return 2;
    ck(dt_domain_hit("tools/dev", "docs,tools/devtask.cx", 0, 0) == 1 && dt_domain_hit("tools/a.cx", "tools/b.cx,src", 0, 0) == 0, "domain-prefix-intersection");
    ck(dt_domain_ok("tools/a.cx,src") && !dt_domain_ok("/abs") && !dt_domain_ok("a/../b") && !dt_domain_ok("a,,b"), "domain-validation");
    ck(!dt_add(dir, "first task", "tools/a.cx,src/x", 10, 0, now, id, sizeof id, why, sizeof why) && !strcmp(id, "T1"), "add-first-id");
    ck(!dt_add(dir, "overlapping task", "src", 0, 0, now, id2, sizeof id2, why, sizeof why) && !strcmp(id2, "T2"), "add-second-id");
    ck(!dt_add(dir, "disjoint task", "docs/y.md", 0, "bob", now, id3, sizeof id3, why, sizeof why) && !strcmp(id3, "T3"), "add-reserved");
    ck(dt_add(dir, "bad", "/abs", 0, 0, now, id4, sizeof id4, why, sizeof why) == 2 && dt_add(dir, "tab\there", "x", 0, 0, now, id4, sizeof id4, why, sizeof why) == 2, "add-bad-input-refused");
    ck(state_is(dir, "T1", "open", "-") && events(dir, "T1", "add") == 1, "add-open-with-event");
    ck(dt_change(dir, "done", "T1", 0, "abc123", now, why, sizeof why) == 1 && state_is(dir, "T1", "open", "-"), "done-needs-claimed");
    ck(!dt_change(dir, "claim", "T1", "alice", 0, now, why, sizeof why) && state_is(dir, "T1", "claimed", "alice") && events(dir, "T1", "claim") == 1, "claim-open");
    ck(dt_change(dir, "claim", "T1", "carol", 0, now, why, sizeof why) == 1 && state_is(dir, "T1", "claimed", "alice"), "claim-twice-refused");
    rc = dt_change(dir, "claim", "T2", "carol", 0, now, why, sizeof why);
    ck(rc == 1 && strstr(why, "intersects") && strstr(why, "T1(owner=alice") && state_is(dir, "T2", "open", "-") && events(dir, "T2", "claim") == 0, "claim-domain-conflict-refused-names-holder");
    ck(dt_change(dir, "claim", "T3", "carol", 0, now, why, sizeof why) == 1 && !dt_change(dir, "claim", "T3", "bob", 0, now, why, sizeof why) && state_is(dir, "T3", "claimed", "bob"), "claim-reserved-owner-only");
    ck(!dt_change(dir, "gap", "T1", 0, "missing regex", now, why, sizeof why) && state_is(dir, "T1", "claimed", "alice") && events(dir, "T1", "gap") == 1, "gap-keeps-state");
    ck(!dt_load(dir, &s, why, sizeof why) && find(&s, "T1") && !dt_stale(find(&s, "T1"), now + 599) && dt_stale(find(&s, "T1"), now + 601) && !dt_stale(find(&s, "T2"), now + 99999), "stale-after-deadline");
    dt_free(&s);
    ck(!dt_change(dir, "block", "T3", 0, "waiting", now, why, sizeof why) && state_is(dir, "T3", "blocked", "bob") && dt_change(dir, "claim", "T3", "carol", 0, now, why, sizeof why) == 1 && !dt_change(dir, "claim", "T3", "bob", 0, now, why, sizeof why), "block-then-owner-resumes");
    ck(!dt_change(dir, "done", "T1", 0, "abc123", now + 5, why, sizeof why) && state_is(dir, "T1", "done", "alice") && events(dir, "T1", "done") == 1, "done-claimed");
    ck(!dt_load(dir, &s, why, sizeof why) && find(&s, "T1") && !strcmp(find(&s, "T1")->evidence, "abc123") && strstr(find(&s, "T1")->gap, "missing regex"), "done-keeps-evidence-and-gap");
    dt_free(&s);
    ck(!dt_change(dir, "claim", "T2", "carol", 0, now, why, sizeof why) && state_is(dir, "T2", "claimed", "carol"), "claim-after-holder-done");
    ck(dt_change(dir, "claim", "T9", "carol", 0, now, why, sizeof why) == 2 && dt_change(dir, "drop", "T1", 0, "late", now, why, sizeof why) == 1, "missing-id-and-dead-task-refused");
    {   char *v[] = {"sh", "./unisacc.com", "tools/devtask.cx", "--", "list", "--state", "claimed", "--dir", dir, 0};
        rc = np_run(v, 0, 0, 40, &r, why, sizeof why);
        ck(!rc && !r.rc && r.out && strstr(r.out, "T2\tclaimed\tcarol\t") && strstr(r.out, "T3\tclaimed\tbob\t") && !strstr(r.out, "T1\t") && strstr(r.out, "DEVTASK_LIST\tcount=2\ttotal=3"), "cli-list-state-filter");
        np_free(&r);
    }
    {   char *v[] = {"sh", "./unisacc.com", "tools/devtask.cx", "--", "claim", "T2", "--owner", "dave", "--dir", dir, 0};
        rc = np_run(v, 0, 0, 40, &r, why, sizeof why);
        ck(!rc && r.rc == 1, "cli-claim-refused-rc1");
        np_free(&r);
    }
    ck(!dt_add(dir, "raced task", "race/only", 0, 0, now, id4, sizeof id4, why, sizeof why) && !strcmp(id4, "T4"), "add-race-target");
    if (cx_fmt(cmd, sizeof cmd, "for i in 1 2 3 4 5 6 7 8; do (sh ./unisacc.com tools/devtask.cx -- claim T4 --owner w$i --dir %s >%s/c$i.out 2>%s/c$i.err; echo $? >%s/c$i.rc) & done; wait; cat %s/c*.rc", dir, dir, dir, dir, dir)) return 1;
    {   char *v[] = {"sh", "-c", cmd, 0}; int ok = 0, refused = 0, other = 0;
        rc = np_run(v, 0, 0, 50, &r, why, sizeof why);
        for (long i = 0; !rc && r.out && i < (long)r.outn; i++) { if (r.out[i] == '\n') continue; if (r.out[i] == '0') ok++; else if (r.out[i] == '1') refused++; else other++; }
        ck(!rc && !r.rc && ok == 1 && refused == 7 && other == 0, "concurrent-claim-exactly-one-rc0");
        np_free(&r);
        ck(state_is(dir, "T4", "claimed", 0) && events(dir, "T4", "claim") == 1, "concurrent-claim-one-event-row");
    }
    /* job-style work orders (R5): private git repo under dir, acceptance run directly, clock from DEVTASK_NOW */
    ck(dw_in("in,tools/x.cx", "in/a.txt") && dw_in("in,tools/x.cx", "tools/x.cx") && !dw_in("in,tools/x.cx", "other.txt") && dw_id_ok("r5-a") && !dw_id_ok("a/b") && !dw_id_ok("a b"), "work-domain-membership-and-id");
#define WT "DEVSVC_OWNER= DEVTASK_ACCEPT_DIRECT=1 DEVTASK_DIR=%s/st DEVTASK_NOW=%ld sh ./unisacc.com tools/devtask.cx -- task "
#define WO "DEVSVC_OWNER=me DEVTASK_EVENTS=%s/ev.tsv DEVTASK_ACCEPT_DIRECT=1 DEVTASK_DIR=%s/st DEVTASK_NOW=%ld sh ./unisacc.com tools/devtask.cx -- task "
    {   char st[64]; int ok;
        if (cx_fmt(st, sizeof st, "%s/st", dir)) return 1;
        ok = !cx_fmt(cmd, sizeof cmd, "mkdir -p %s/repo/in && cd %s/repo && git init -q && echo a >in/a.txt && echo b >other.txt && git add . && git -c user.name=t -c user.email=t@t commit -qm init && echo pre >predirty.txt", dir, dir) && !sh(cmd, &r) && !r.rc;
        ck(ok, "work-setup-private-repo"); np_free(&r);
        ok = !cx_fmt(cmd, sizeof cmd, WT "open --id w1 --title 'demo order' --write in --accept 'test -f in/ok' --accept true --deadline-min 10 --root %s/repo", dir, now, dir) && !sh(cmd, &r) && !r.rc && r.out && strstr(r.out, "TASK\topen\tw1\tdeadline_s=600\taccept=2\twrite=in");
        ck(ok && events(st, "w1", "task.open") == 1, "work-open-records-order"); np_free(&r);
        ok = !cx_fmt(cmd, sizeof cmd, WT "open --id w1 --title again --write in --accept true --deadline-min 10 --root %s/repo", dir, now, dir) && !sh(cmd, &r) && r.rc == 1;
        ck(ok, "work-open-twice-refused-rc1"); np_free(&r);
        ok = !cx_fmt(cmd, sizeof cmd, WT "open --id w2 --title noaccept --write in --deadline-min 10 --root %s/repo", dir, now, dir) && !sh(cmd, &r) && r.rc == 2;
        ck(ok, "work-open-without-accept-rc2"); np_free(&r);
        ok = !cx_fmt(cmd, sizeof cmd, WT "status w1", dir, now + 10) && !sh(cmd, &r) && !r.rc && r.out && strstr(r.out, "used_s=10\tleft_s=590\t") && strstr(r.out, "TASK_STATUS\tw1\tchanged=0\toutside=0\toverdue=0");
        ck(ok, "work-status-clean-after-open"); np_free(&r);
        ok = !cx_fmt(cmd, sizeof cmd, WT "status w1", dir, now + 100) && !sh(cmd, &r) && !r.rc && r.out && strstr(r.out, "used_s=100\tleft_s=500\t");
        ck(ok, "work-status-remaining-decreases"); np_free(&r);
        ok = !cx_fmt(cmd, sizeof cmd, WT "status w1", dir, now + 700) && !sh(cmd, &r) && !r.rc && r.out && strstr(r.out, "left_s=-100\t") && strstr(r.out, "overdue=1");
        ck(ok, "work-status-overdue-after-deadline"); np_free(&r);
        ok = !cx_fmt(cmd, sizeof cmd, "echo x >>%s/repo/in/a.txt && echo y >>%s/repo/other.txt && " WT "status w1", dir, dir, dir, now + 20) && !sh(cmd, &r) && !r.rc && r.out
            && strstr(r.out, "CHANGED\tin/a.txt\n") && strstr(r.out, "OUTSIDE_WARN\tother.txt\n") && !strstr(r.out, "predirty.txt") && strstr(r.out, "changed=1\toutside=1");
        ck(ok, "work-status-warns-outside-write-domain-and-skips-snapshot"); np_free(&r);
        ok = !cx_fmt(cmd, sizeof cmd, WT "done w1", dir, now + 30) && !sh(cmd, &r) && r.rc == 1 && r.out && strstr(r.out, "ACCEPT\t1\tFAIL\trc=1") && strstr(r.out, "ACCEPT\t2\tPASS")
            && strstr(r.out, "TASK_NOT_DONE\tw1\taccept_failed=1\toutside=1") && !strstr(r.out, "\nDONE\tw1");
        ck(ok && events(st, "w1", "task.done") == 0, "work-done-failing-accept-rc1-no-event"); np_free(&r);
        ok = !cx_fmt(cmd, sizeof cmd, "echo 'echo boom-marker; exit 7' >%s/repo/in/ok && " WT "open --id w3 --title tail --write in --accept 'sh in/ok' --deadline-min 1 --root %s/repo && " WT "done w3", dir, dir, now, dir, dir, now + 1) && !sh(cmd, &r) && r.rc == 1 && r.out
            && strstr(r.out, "ACCEPT\t1\tFAIL\trc=7") && strstr(r.out, "boom-marker") && strstr(r.out, "TASK_NOT_DONE\tw3");
        ck(ok && events(st, "w3", "task.done") == 0, "work-done-prints-failing-output-tail"); np_free(&r);
        ok = !cx_fmt(cmd, sizeof cmd, WT "done w1", dir, now + 40) && !sh(cmd, &r) && r.rc == 1 && r.out && strstr(r.out, "ACCEPT\t1\tPASS") && strstr(r.out, "OUTSIDE_CHANGED\tother.txt\n") && strstr(r.out, "accept_failed=0\toutside=1");
        ck(ok && events(st, "w1", "task.done") == 0, "work-done-outside-change-rc1-no-event"); np_free(&r);
        ok = !cx_fmt(cmd, sizeof cmd, "echo b >%s/repo/other.txt && " WT "done w1", dir, dir, now + 50) && !sh(cmd, &r) && !r.rc && r.out && strstr(r.out, "DONE\tw1\taccept=2\t") && strstr(r.out, "used_s=50\tlate=0") && !strstr(r.out, "TASK_NOT_DONE");
        ck(ok && events(st, "w1", "task.done") == 1, "work-done-all-pass-rc0-one-event"); np_free(&r);
        ok = !cx_fmt(cmd, sizeof cmd, WT "list", dir, now + 60) && !sh(cmd, &r) && !r.rc && r.out && strstr(r.out, "w1\tdone\t50\t0\tin\tdemo order") && strstr(r.out, "w3\topen\t") && strstr(r.out, "DEVTASK_WORK\tcount=2");
        ck(ok, "work-list-states"); np_free(&r);
        ok = !cx_fmt(cmd, sizeof cmd, WT "status nosuch", dir, now) && !sh(cmd, &r) && r.rc == 2;
        ck(ok, "work-missing-id-rc2"); np_free(&r);
        /* owner attribution: another window's commit is not reported, another window's dirty path is INFO_FOREIGN and does not block done */
        ok = !cx_fmt(cmd, sizeof cmd, ": >%s/ev.tsv && " WO "open --id w4 --title owned --write in --accept true --deadline-min 10 --root %s/repo && cd %s/repo && echo f >foreign.txt && echo z >>other.txt && git add other.txt"
                " && git -c user.name=o -c user.email=o@o commit -qm other && cd - >/dev/null && " WO "status w4", dir, dir, dir, now, dir, dir, dir, dir, now + 5) && !sh(cmd, &r) && !r.rc && r.out
            && strstr(r.out, "INFO_FOREIGN\tforeign.txt\n") && !strstr(r.out, "other.txt") && strstr(r.out, "outside=0\toverdue=0\tforeign=1\towner=me");
        ck(ok, "work-owner-foreign-dirty-is-info-and-foreign-commit-unreported"); np_free(&r);
        ok = !cx_fmt(cmd, sizeof cmd, WO "done w4", dir, dir, now + 6) && !sh(cmd, &r) && !r.rc && r.out && strstr(r.out, "INFO_FOREIGN\tforeign.txt\n") && !strstr(r.out, "OUTSIDE_CHANGED") && strstr(r.out, "DONE\tw4\t");
        ck(ok && events(st, "w4", "task.done") == 1, "work-owner-foreign-does-not-block-done"); np_free(&r);
        ok = !cx_fmt(cmd, sizeof cmd, WO "open --id w5 --title mine --write in --accept true --deadline-min 10 --root %s/repo && echo m >%s/repo/mine.txt"
                " && printf 'EV\\t9\\t%ld\\tf.write\\towner=me\\tpid=1\\trc=0\\tms=1\\tpath=mine.txt\\tsha=%%s\\n' $(sha256sum <%s/repo/mine.txt | cut -c1-64) >>%s/ev.tsv && " WO "done w5",
                dir, dir, now, dir, dir, now + 5, dir, dir, dir, dir, now + 7) && !sh(cmd, &r) && r.rc == 1 && r.out && strstr(r.out, "OUTSIDE_CHANGED\tmine.txt\n") && strstr(r.out, "TASK_NOT_DONE\tw5\taccept_failed=0\toutside=1");
        ck(ok && events(st, "w5", "task.done") == 0, "work-owner-own-outside-write-still-blocks"); np_free(&r);
    }
    /* acceptance memo: same input identity skips passed commands, a changed write domain reruns them */
    {   char st[64]; int ok;
        if (cx_fmt(st, sizeof st, "%s/st", dir)) return 1;
        ok = !cx_fmt(cmd, sizeof cmd, WT "open --id m1 --title memo --write in --accept 'echo x >>%s/cnt' --accept 'test -f in/ok2' --deadline-min 10 --root %s/repo", dir, now, dir, dir) && !sh(cmd, &r) && !r.rc;
        ck(ok, "memo-open"); np_free(&r);
        ok = !cx_fmt(cmd, sizeof cmd, WT "done m1", dir, now + 1) && !sh(cmd, &r) && r.rc == 1 && r.out && strstr(r.out, "ACCEPT\t1\tPASS") && strstr(r.out, "ACCEPT\t2\tFAIL");
        ck(ok, "memo-first-done-runs-both"); np_free(&r);
        ok = !cx_fmt(cmd, sizeof cmd, WT "done m1", dir, now + 2) && !sh(cmd, &r) && r.rc == 1 && r.out && strstr(r.out, "ACCEPT\t1\tSKIP_PASSED") && strstr(r.out, "ACCEPT\t2\tFAIL");
        ck(ok, "memo-unchanged-input-skips-passed"); np_free(&r);
        ok = !cx_fmt(cmd, sizeof cmd, "wc -l <%s/cnt", dir) && !sh(cmd, &r) && r.out && atoi(r.out) == 1;
        ck(ok, "memo-skipped-command-not-executed"); np_free(&r);
        ok = !cx_fmt(cmd, sizeof cmd, "echo ok >%s/repo/in/ok2 && " WT "done m1", dir, dir, now + 3) && !sh(cmd, &r) && !r.rc && r.out && strstr(r.out, "ACCEPT\t1\tPASS") && strstr(r.out, "ACCEPT\t2\tPASS") && strstr(r.out, "DONE\tm1\t");
        ck(ok, "memo-changed-input-reruns-all"); np_free(&r);
        /* parallel: two 30 s acceptance commands inside one 45 s wall, started with --bg then waited */
        ok = !cx_fmt(cmd, sizeof cmd, WT "open --id p1 --title par --write in --accept 'sleep 30' --accept 'sleep 30; echo second' --deadline-min 10 --root %s/repo", dir, now, dir) && !sh(cmd, &r) && !r.rc;
        ck(ok, "par-open"); np_free(&r);
        {   long t0 = sy_now_ms(), tb;
            ok = !cx_fmt(cmd, sizeof cmd, WO "done p1 --bg", dir, dir, now + 4) && !sh(cmd, &r) && !r.rc && r.out && strstr(r.out, "JOB\t");
            tb = sy_now_ms() - t0;
            ck(ok && tb < 15000, "bg-returns-immediately-with-job"); np_free(&r);
            ok = !cx_fmt(cmd, sizeof cmd, WO "done --wait p1", dir, dir, now + 5) && !sh(cmd, &r) && !r.rc && r.out && strstr(r.out, "ACCEPT\t1\tPASS") && strstr(r.out, "ACCEPT\t2\tPASS") && strstr(r.out, "DONE\tp1\t");
            ck(ok && sy_now_ms() - t0 < 45000, "par-two-30s-accepts-under-45s-and-bg-done"); np_free(&r);
        }
        ck(events(st, "p1", "task.done") == 1, "bg-writes-task-done-event");
    }
    printf("%s\tassertions=%d\tfailed=%d\n", failed ? "CHECK_DEVTASK_FAIL" : "CHECK_DEVTASK", assertions, failed);
    return failed ? 1 : 0;
}
