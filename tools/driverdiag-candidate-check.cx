/* Finite 95b2 -> 5675 driver diagnostic candidate material check. No installation or release. */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.kernelsha
#pragma unisa use text.text
static char root[4096],origin[4096],source[4096],candidate[4096],generated[4096],oldctx[4096],product[4400];
static np_buf evidence;
static void die(const char *s){fprintf(stderr,"driverdiag-candidate-check: REFUSE %s\n",s);exit(2);}
static void path(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path-bound");}
static char *readfile(const char *p,size_t *n){struct stat st;if(lstat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>268435456)die(p);char *s=cx_read(p,n);if(!s||*n!=(size_t)st.st_size)die("read-size");return s;}
static void digest(const char *p,char h[65]){size_t n;char *s=readfile(p,&n);if(ks_sha256_hex(s,n,h))die("sha256");free(s);}
static void row(const char *key,const char *value){np_puts(&evidence,key);np_puts(&evidence,"\t");np_puts(&evidence,value);np_puts(&evidence,"\n");}
static void pin(const char *p,const char *expected,const char *label){char h[65];digest(p,h);if(!tx_eq(h, expected, 1L << 20))die(label);row(label,h);}
static void execute(char **v,const char *needle,int budget,const char *label){np_result r;char why[1400];if(np_run(v,root,0,budget,&r,why,sizeof why))die(why);if(r.rc||r.errn||!strstr(r.out,needle)){fprintf(stderr,"child %s rc=%d stderr=%.*s\n",label,r.rc,(int)r.errn,r.err);np_free(&r);die(label);}char h[65];if(ks_sha256_hex(r.out,r.outn,h))die("child-sha");row(label,h);np_free(&r);}
static void embedded(const char *p,const char **body,size_t *bytes,char **owned){size_t n;char *s=readfile(p,&n);if(n<16||memcmp(s+n-16,"UNIPKG1\n",8))die("package-footer");unsigned long long z=0;for(int i=7;i>=0;i--)z=(z<<8)|(unsigned char)s[n-8+i];if(!z||z>n-16)die("package-extent");*body=s+n-16-(size_t)z;*bytes=(size_t)z;*owned=s;}
int main(int argc,char **argv){
 if(argc!=7||!realpath(argv[1],root)||!realpath(argv[2],origin)||!realpath(argv[3],source)||!realpath(argv[4],candidate)||!realpath(argv[5],generated)||!realpath(argv[6],oldctx)||tx_eq(origin, source, 1L << 20))die("usage TOOL_ROOT ORIGIN_ROOT SOURCE_ROOT CANDIDATE CURRENT_CONTEXT ORIGIN_CONTEXT");
 np_puts(&evidence,"driverdiag-candidate-material-check-v1\n");path(product,root,"unisacc.com");
 pin(product,"cb743c27b736119a3c88b1146187c35a8dec955149590eb38b860520a62c1e55","executing-bootstrap");
 char baseline[4400],record[4400],helper[4400],delta[4400],compare[4400],jobs[4400];path(baseline,root,"unisacc.com");path(record,root,"unisacc.com.build.json");
 pin(baseline,"cb743c27b736119a3c88b1146187c35a8dec955149590eb38b860520a62c1e55","origin-product");
 pin(record,"9783c93d2bdc5a4cfdfe6f564871dbce168dea75cd94c178906f56ba700c2798","origin-record");
 pin(candidate,"79fb84e65a10b55ce40be5f68746748acbd38f441944046c0a5dfa5718bc0c32","candidate");
 char candidate_record[4400];if(snprintf(candidate_record,sizeof candidate_record,"%s.build.json",candidate)>=(int)sizeof candidate_record)die("candidate-record-path");pin(candidate_record,"4608b9ac9c06f3e9f0e55db8255dbc0bd876248b529119e7e6fb2d116ba1e466","candidate-record");
 const char *a,*b;size_t an,bn;char *aa,*bb;embedded(baseline,&a,&an,&aa);embedded(candidate,&b,&bn,&bb);if(an!=bn||memcmp(a,b,an))die("embedded-package-changed");char ph[65];if(ks_sha256_hex(b,bn,ph)||!tx_eq(ph, "7b806ec2502694a0a0af3ffdc348106a7c6e8dc76f737fdd3f36fffd39194194", 1L << 20))die("package-pin");row("preserved-package",ph);free(aa);free(bb);
 path(helper,source,"out/epoch-context-01/identity-helper");pin(helper,"72c2ddb9a4c7ebee1caa057224f63830b489abf5f99d4d6841d07a14fc820918","identity-helper");
 char *oi[]={helper,origin,0},*si[]={helper,source,0};execute(oi,"95b23dc90b25b8b30eddbf4aed2215f48ba293d11d0fc433ff483fb7da2bbd81\n",10,"origin-source");execute(si,"5675f55751f76566e42f59ca22529c289dda169bc1b1b49aef5932efa09b0b75\n",10,"candidate-source");
 path(delta,root,"tools/cxpack-source-delta.cx");path(compare,root,"tools/source-model-compare.cx");path(jobs,generated,"context.tsv");pin(jobs,"dc06a0fd1c2989e0b48a4bb65633163e55755fe71f9b119dce349934030a7f35","current-context");path(jobs,oldctx,"context.tsv");pin(jobs,"70dbb7095c5a1c9bfa107b8042a71f9218fabd003a66b234b782b08cee4606e4","origin-context");char dh[65],ch[65],after[65];digest(delta,dh);digest(compare,ch);row("delta-tool",dh);row("json-tool",ch);
 char *dv[]={"sh",product,delta,"--",origin,source,"driverdiag-v1",0};execute(dv,"witness=977f3c83419785af87a147b61cd4420261f1e59972109835c6947ddc9d12c0c2\n",20,"source-delta-observation");
 char *cv[]={helper,source,"check",candidate,0};execute(cv,"product freshness: verified 79fb84e65a10b55ce40be5f68746748acbd38f441944046c0a5dfa5718bc0c32\n",10,"candidate-record-verification");
 /* Source profile verifies all eight model/construction trees byte-for-byte;
  * no generator rerun is claimed for this driver-only change. */
 row("model-reuse-basis","fixed-two-driver-deltas-all-model-trees-identical");
 digest(delta,after);if(!tx_eq(dh, after, 1L << 20))die("delta-tool-changed");digest(compare,after);if(!tx_eq(ch, after, 1L << 20))die("json-tool-changed");
 execute(oi,"95b23dc90b25b8b30eddbf4aed2215f48ba293d11d0fc433ff483fb7da2bbd81\n",10,"origin-source-after");execute(si,"5675f55751f76566e42f59ca22529c289dda169bc1b1b49aef5932efa09b0b75\n",10,"candidate-source-after");
 pin(product,"cb743c27b736119a3c88b1146187c35a8dec955149590eb38b860520a62c1e55","executing-bootstrap-after");pin(record,"9783c93d2bdc5a4cfdfe6f564871dbce168dea75cd94c178906f56ba700c2798","origin-record-after");
 pin(candidate,"79fb84e65a10b55ce40be5f68746748acbd38f441944046c0a5dfa5718bc0c32","candidate-after");
 pin(candidate_record,"4608b9ac9c06f3e9f0e55db8255dbc0bd876248b529119e7e6fb2d116ba1e466","candidate-record-after");
 if(fwrite(evidence.p,1,evidence.n,stdout)!=evidence.n)die("stdout");free(evidence.p);puts("CHECKED\tfinite-material-applicability\tNOT_INSTALLED_NOT_RELEASE_QUALIFIED");return 0;
}
