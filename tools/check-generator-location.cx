/* 真实构造器拒绝合同；独立输入不重编生成器，--batch在私有输出构造真实GCC hostgen；不生成网。
 * sh ./unisacc.com tools/check-generator-location.cx -- ROOT ABS_GEN FRESH_OUT；或 --batch ROOT FRESH_OUT
 * 10个中后段拒绝，加上下文、事实表头少/多列及JSON默认exit2/整文件来源边界。
 * OUT必须不存在；每个输入、stderr/stdout、状态及定位预期均留存。 */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use text.text
static void die(const char *s){fprintf(stderr,"generator-location: %s\n",s);exit(2);}
static void put(const char *p,const char *s){if(cx_write(p,s,strlen(s)))die("write");}
static void path(char *p,const char *a,const char *b){if(cx_fmt(p,4400,"%s/%s",a,b))die("path");}
int main(int argc,char **argv){
    if(argc==4&&!strcmp(argv[1],"--batch")){
        char gen[4400],entry[4400],fresh[4400],why[1024];np_result r={0};
        if(argv[2][0]!='/'||argv[3][0]!='/'||mkdir(argv[3],0700))die("batch ROOT and fresh absolute output");
        path(gen,argv[3],"hostgen");path(entry,argv[2],"tools/dev-run");path(fresh,argv[3],"checks");
        char *build[]={"sh",entry,"--seed-gen=gcc-O2",gen,0};
        if(np_run(build,argv[2],0,25,&r,why,sizeof why))die(why);
        int bad=r.rc||r.residue;fwrite(r.out?r.out:"",1,r.outn,stdout);fwrite(r.err?r.err:"",1,r.errn,stderr);np_free(&r);if(bad)die("hostgen build failed");
        char *check[]={argv[0],argv[2],gen,fresh,0};return main(4,check);
    }
    if(argc!=4)die("usage: ROOT ABS_GEN FRESH_OUT");
    char root[4400],gen[4400],work[4400],p[4400],dir[4400],man[4400],out[4400],table[4400];
    if(sy_realpath(argv[1],root,sizeof root)<0||sy_realpath(argv[2],gen,sizeof gen)<0)die("absolute inputs");
    if(mkdir(argv[3],0700)||sy_realpath(argv[3],work,sizeof work)<0)die("fresh out");
    const char *badrow[]={
      "block\tS\t*\tNEXT\t[[\"PUSH\",[\"constant\",\"state3z\"]]]\n",
      "block\tS\t*\tNEXT\t{}\n",
      "block\tS\t*\tNEXT\t[[]]\n",
      "block\tS\t*\tNEXT\t[[\"@\"]]\n",
      "block\tS\t*\tNEXT\t[[\"@\",\"missing\"]]\n",
      "block\tS\t*\tNEXT\t[[\"@bytes\",0]]\n",
      "block\tS\t*\tNEXT\t[[\"@bytes\",\"\"]]\n",
      "block\tS\t*\tNEXT\t[[\"PUSH\",[\"observation\",64]]]\n",
      "block\tS\t999\tNEXT\t[]\n",
      "block\tS\t*\t\t[]\n"};
    const char *reason[]={"unknown constant binding","action sequence is not a list","invalid rule action","invalid named sequence","unknown named sequence","byte action needs a string","empty byte action","invalid observation substitution","invalid observation key","empty section state or target"};
    int failures=0;
    path(p,work,"expected.tsv"); FILE *expected=fopen(p,"wb");if(!expected)die("expected");
    for(int k=0;k<10;k++){
        char name[60],body[32000],needle[4600],why[1000],status[80];int n=0,line=k?37+k*19:4;
        if(cx_fmt(name,sizeof name,"case-%02d",k))die("case");path(dir,work,name);if(mkdir(dir,0700))die("case mkdir");
        path(man,dir,"gen-manifest.tsv");put(man,"# parent context\nrows\tcontrol\tblock\t-\t-\t-\t-\t-\t-\n");
        path(p,dir,"control-byte.tsv");put(p,"# valid nested sibling\nblock\tBYTE\t*\tNEXT\t[]\n");
        for(int j=1;j<line;j++){memcpy(body+n,"# padding\n",10);n+=10;}body[n]=0;
        if(cx_fmt(body+n,sizeof body-n,"%s# trailing row must not steal provenance\nother\tTAIL\t*\tNEXT\t[]\n",badrow[k]))die("body");
        path(table,dir,"control-result.tsv");put(table,body);path(out,dir,"graph.json");
        char *v[]={gen,"inspect-manifest-graph",man,"{}","{}",out,0};np_result r;
        int run=np_run(v,root,0,55,&r,why,sizeof why);
        if(cx_fmt(needle,sizeof needle,"seed-gen: %s:%d:",table,line))die("needle");
        int ok=!run&&r.rc==1&&!r.residue&&(!r.out||!r.out[0])&&r.err&&strstr(r.err,needle);
        fprintf(expected,"%s\t%s\t%d\t%s\n",name,table,line,reason[k]);
        path(p,dir,"stderr");put(p,r.err?r.err:"");path(p,dir,"stdout");put(p,r.out?r.out:"");
        if(cx_fmt(status,sizeof status,"rc\t%d\nrun\t%d\n",r.rc,run))die("status");path(p,dir,"status.tsv");put(p,status);
        printf("%s\t%s\n",ok?"PASS":"FAIL",name);if(!ok)failures++;np_free(&r);
    }
    /* Consumers after closing the top-level reader must not borrow its last row;
       consumers after template expansion still belong to their manifest row. */
    for(int k=0;k<2;k++){
        const char *name=k?"template-return-context":"closed-top-level-context";
        char needle[4600],why[1000],status[80];
        path(dir,work,name);if(mkdir(dir,0700))die("context mkdir");
        path(man,dir,"gen-manifest.tsv");path(out,dir,"graph.json");
        if(k){
            put(man,"# caller row must survive template expansion\ntemplate\tprobe\tsection\t-\t-\t-\t-\t-\t{\"with\":{\"names\":0},\"seqenv\":\"names\",\"mode\":\"r\"}\n");
            path(table,dir,"probe-template.tsv");
            put(table,"# template reader has a distinct source\nsection\tblock\t-\t-\trule:r\tS\t*\tNEXT\t[]\n# last template row must not escape\n");
        }else put(man,"# closed top-level input\n# its second line is not an argument source\n# nor is its final line\n");
        char *v[]={gen,"inspect-manifest-graph",man,k?"{}":"[]","{}",out,0};np_result r;
        int run=np_run(v,root,0,55,&r,why,sizeof why);
        if(cx_fmt(needle,sizeof needle,k?"seed-gen: %s:2:":"seed-gen:",man))die("context expected");
        int ok=!run&&r.rc==1&&!r.residue&&(!r.out||!r.out[0])&&r.err&&strstr(r.err,needle);
        if(k)ok=ok&&!strstr(r.err,table);else ok=ok&&!strstr(r.err,man);
        fprintf(expected,"%s\t%s\t%d\t%s\n",name,k?man:"-",k?2:0,k?"manifest row after template return":"no input location after top-level close");
        path(p,dir,"stderr");put(p,r.err?r.err:"");path(p,dir,"stdout");put(p,r.out?r.out:"");
        if(cx_fmt(status,sizeof status,"rc\t%d\nrun\t%d\n",r.rc,run))die("context status");path(p,dir,"status.tsv");put(p,status);
        printf("%s\t%s\n",ok?"PASS":"FAIL",name);if(!ok)failures++;np_free(&r);
    }
    /* Standard facts-gen metadata must not hide malformed rows after the real
       two-column header. Keep missing and extra value columns independent. */
    for(int k=0;k<2;k++){
        const char *name=k?"facts-header-extra-column":"facts-header-missing-value";
        char execdir[4400],factsdir[4400],probedir[4400],why[1000],status[80],body[1000];
        path(dir,work,name);if(mkdir(dir,0700))die("facts case mkdir");
        path(execdir,dir,"exec");if(mkdir(execdir,0700))die("facts exec mkdir");
        path(factsdir,execdir,"facts");if(mkdir(factsdir,0700))die("facts directory mkdir");
        path(probedir,execdir,"probe");if(mkdir(probedir,0700))die("facts probe mkdir");
        path(man,probedir,"gen-manifest.tsv");
        put(man,"# op\tstem\tsection\twhen\tfacts\tfresh\tseq\tbind\topts\n#! base build/parsebase.py\nrows\tprobe\tmain\t-\tprobe\t-\t-\tVALUE=VALUE\t-\n");
        path(p,probedir,"probe-byte.tsv");put(p,"# section\tstate\tobservation\ttarget\tactions\n");
        path(p,probedir,"probe-result.tsv");put(p,"# section\tstate\tobservation\ttarget\tactions\nmain\tSTART\t*\tDEAD\t[[\"LDI\",\"v\",[\"constant\",\"VALUE\"]],[\"ACCEPT\"]]\n");
        if(cx_fmt(body,sizeof body,"# exec/facts/probe.tsv: written by tools/facts-gen.cx, do not edit\n# input fixture.tsv sha256:0000000000000000\n# name\tvalue\n%s\n",k?"VALUE\t7\textra":"VALUE"))die("facts body");
        path(table,factsdir,"probe.tsv");put(table,body);path(out,dir,"result.json");
        char *v[]={gen,"probe",out,0};np_result r;int run=np_run(v,dir,0,55,&r,why,sizeof why);
        int ok=!run&&r.rc==1&&!r.residue&&(!r.out||!r.out[0])&&r.err&&strstr(r.err,"seed-gen: exec/facts/probe.tsv:4:")&&access(out,F_OK)!=0;
        fprintf(expected,"%s\texec/facts/probe.tsv\t4\t%s; no model output\n",name,k?"extra value column":"missing value column");
        path(p,dir,"stderr");put(p,r.err?r.err:"");path(p,dir,"stdout");put(p,r.out?r.out:"");
        if(cx_fmt(status,sizeof status,"rc\t%d\nrun\t%d\nmodel_exists\t%d\n",r.rc,run,access(out,F_OK)==0))die("facts status");path(p,dir,"status.tsv");put(p,status);
        printf("%s\t%s\n",ok?"PASS":"FAIL",name);if(!ok)failures++;np_free(&r);
    }
    if(fclose(expected))die("close");
    /* Whole-file fread must use its JSON source, never a previous TSV row.
       The unbound header probe also fixes the original rc=2 contract. */
    char json[4400],probe[4400],exe[4400],source[15000],include[4400];
    path(json,work,"invalid.json");put(json,"\n\n\n]\n");
    for(int bound=0;bound<2;bound++){
        path(probe,work,bound?"json-bound.c":"json-default.c");path(exe,work,bound?"json-bound":"json-default");
        path(include,root,bound?"seed/gen.c":"seed/json.h");
        if(bound){
            if(cx_fmt(source,sizeof source,"#define main generator_main\n#include \"%s\"\n#undef main\nint main(int n,char **v){JDoc d;input_location=(InputLocation){\"previous.tsv\",987};jparse_file(&d,v[1]);return 0;}\n",include))die("bound source");
        }else if(cx_fmt(source,sizeof source,"#include \"%s\"\nint main(int n,char **v){JDoc d;jparse_file(&d,v[1]);return 0;}\n",include))die("default source");
        put(probe,source);char *cc[]={"gcc","-std=c99","-O0",probe,"-o",exe,0};np_result built;char why[1000];
        if(np_run(cc,root,0,55,&built,why,sizeof why)||built.rc||built.residue)die("JSON probe build");np_free(&built);
        char *run[]={exe,json,0};np_result r;int failed=np_run(run,root,0,55,&r,why,sizeof why);char needle[4600];
        if(cx_fmt(needle,sizeof needle,bound?"json: %s:4:":"json: %s:",json))die("JSON expected");
        int ok=!failed&&r.rc==2&&!r.residue&&(!r.out||!r.out[0])&&r.err&&strstr(r.err,needle)&&!strstr(r.err,"previous.tsv");
        printf("%s\t%s\n",ok?"PASS":"FAIL",bound?"json-whole-file-location":"json-default-exit2");if(!ok)failures++;
        path(p,work,bound?"json-bound.stderr":"json-default.stderr");put(p,r.err?r.err:"");np_free(&r);
    }
    printf("GENERATOR_LOCATION\tchecked=16 failed=%d\n",failures);
    return failures?1:0;
}
