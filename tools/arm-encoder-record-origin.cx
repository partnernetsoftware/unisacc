/* Static Linux ARM two-pass record certificate. Transcript consistency, not authenticity.
 * TARGET CONFIG WATCH IMAGE; compact-v1 only, root frame, immutable model/profile SHA.
 */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use text.text
#pragma unisa use cxlib.watchbundle
static int bundle_mode;static char bundle_identity[65];
#define AR_DELTA "8d56c3089e1b46d459d35f577bc8bf2f683f30b198bf0305099f48dffe6e1e3d"
#define AR_CONFIG "8ef302ee88b76de993624c107118f1ab5f37cadfcfffe3e6e98d2c04679ce964"
typedef struct {long lo,hi,ws,we,begin,end;} ArRow;
static ArRow *rows;static long nr,cap;
static char buffer[65536];static int used;
static void fail(const char *s){fprintf(stderr,"ARM_ENCODER_RECORD REFUSE %s\n",s);exit(2);}
static void emit(const char *s,int n){if(n<0||n>=1024)fail("output line");if(used+n>sizeof buffer){if(sy_write_all(1,buffer,used))fail("output write");used=0;}memcpy(buffer+used,s,n);used+=n;}
static char *load(const char *p,size_t *n,long limit,int text){struct stat st;if(stat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>limit)fail("input extent");char *b=cx_read(p,n);if(!b||*n!=(size_t)st.st_size||(text&&(memchr(b,0,*n)||memchr(b,'\r',*n))))fail("input read/text");return b;}
static void hash(const char *s,size_t n,char h[65]){if(sy_sha256_hex(s,(long)n,h))cx_sha256_hex(s,n,h);}
static char *watch_load(const char *path,size_t *n){if(bundle_mode)return wb_watch(path,n,bundle_identity);return load(path,n,67108864,1);}
static void watch_hash(const char *b,size_t n,char h[65]){if(bundle_mode)memcpy(h,bundle_identity,65);else hash(b,n,h);}
static int certificate_transport(char *line,int n,long cap){if(!bundle_mode)return n;if(n<1||n>=cap||line[n-1]!='\n')fail("bundle certificate bound");int added=snprintf(line+n-1,cap-n+1,"\twatch_transport=watch-bundle-v1\n");if(added<0||added>=cap-n+1)fail("bundle transport bound");return n-1+added;}
static long number(const char *s){long n=0;if(!s||!*s)fail("number");for(;*s;s++){if(*s<'0'||*s>'9'||n>1000000000)fail("number");n=n*10+*s-'0';}return n;}
static int split(char *s,char **v){int n=1;v[0]=s;for(;*s;s++)if(*s=='\t'){if(n==32)fail("columns");*s=0;v[n++]=s+1;}return n;}
static char *field(char **v,int n,const char *k){size_t z=strlen(k);char *r=0;for(int i=1;i<n;i++)if(!strncmp(v[i],k,z)&&v[i][z]=='='){if(r)fail("duplicate field");r=v[i]+z+1;}if(!r)fail("missing field");return r;}
static void scan(const char *s,long n){for(long lo=0;lo<n;){long hi=lo;while(hi<n&&s[hi]!='\n')hi++;if(hi==n)fail("target final LF");hi++;long ws=lo;while(ws<hi&&(s[ws]==' '||s[ws]=='\t'))ws++;long we=ws;while(we<hi&&s[we]!=' '&&s[we]!='\t'&&s[we]!='\n')we++;if(we>ws&&s[ws]!='@'&&s[we-1]!=':'){if(nr==1000000)fail("row bound");if(nr==cap){cap=cap?cap*2:1024;rows=realloc(rows,cap*sizeof *rows);if(!rows)fail("allocation");}rows[nr++]=(ArRow){lo,hi,ws,we,0,0};}lo=hi;}}
static unsigned long long le(const unsigned char *p,long n,long off,int z){if(off<0||off>n||z>n-off)fail("ELF bound");unsigned long long v=0;for(int i=0;i<z;i++)v|=(unsigned long long)p[off+i]<<(8*i);return v;}
static void elf(const unsigned char *p,long n,long text,long pad){if(n<176||memcmp(p,"\177ELF\2\1\1",7)||le(p,n,16,2)!=2||le(p,n,18,2)!=183||le(p,n,20,4)!=1||le(p,n,32,8)!=64||le(p,n,40,8)||le(p,n,52,2)!=64||le(p,n,54,2)!=56||le(p,n,56,2)!=2)fail("static ARM ELF");int rx=0,data=0;for(int i=0;i<2;i++){long a=64+i*56;if(le(p,n,a,4)!=1)fail("ELF segment");if(le(p,n,a+4,4)&1){if(rx++||le(p,n,a+4,4)!=5||le(p,n,a+8,8)||le(p,n,a+32,8)!=(unsigned long long)(176+text))fail("ELF text extent");unsigned long long va=le(p,n,a+16,8),entry=le(p,n,24,8);if(entry<va+176||entry>=va+176+text)fail("ELF entry");}else if(data++||le(p,n,a+4,4)!=6||le(p,n,a+8,8)!=(unsigned long long)pad||pad>n||le(p,n,a+32,8)>(unsigned long long)(n-pad))fail("ELF data extent");}if(rx!=1||data!=1||text>n-176)fail("ELF closure");}
typedef struct {long id,end;char sha[65];} ArFrame;
static void foreign_format(const unsigned char *im,long n,long text,long prefix,int mac,int forward){
 if(mac){
  if(le(im,n,0,4)!=4277009103ULL||le(im,n,4,4)!=16777228||le(im,n,8,4)!=0||le(im,n,12,4)!=2||le(im,n,16,4)!=12||le(im,n,20,4)!=832)fail("MachO header");
  long p=32;int found=0,entry=0,sig=0;
  for(int i=0;i<12;i++){long cmd=le(im,n,p,4),z=le(im,n,p+4,4);if(z<8||z>n-p)fail("MachO command extent");
   if(cmd==25){long ns=le(im,n,p+64,4);if(ns>(z-72)/80)fail("MachO sections");for(long j=0;j<ns;j++){long a=p+72+j*80;if(!memcmp(im+a,"__text\0",7)){if(found++||le(im,n,a+40,8)!=(unsigned long long)text||le(im,n,a+48,4)!=1020||le(im,n,p+40,8)>1020||le(im,n,p+48,8)<(unsigned long long)(1020+text))fail("MachO text section");}}}
   if(cmd==2147483688ULL){long e=le(im,n,p+8,8);if(entry++||e<1020||e>=1020+text)fail("MachO entry");}
   if(cmd==29){if(sig++||le(im,n,p+8,4)!=(unsigned long long)prefix||le(im,n,p+12,4)!=(unsigned long long)(n-prefix))fail("MachO signature prefix");}
   p+=z;
  }if(found!=1||entry!=1||sig!=1||p!=864)fail("MachO command closure");
 }else{
  if(n<1024||memcmp(im,"MZ",2))fail("PE DOS");long p=le(im,n,60,4);if(le(im,n,p,4)!=17744||le(im,n,p+4,2)!=43620||le(im,n,p+6,2)!=(forward?4:3))fail("PE COFF");long os=le(im,n,p+20,2),o=p+24;
  if(os!=240||le(im,n,o,2)!=523||le(im,n,o+32,4)!=4096||le(im,n,o+36,4)!=512||le(im,n,o+60,4)!=1024)fail("PE optional header");long e=le(im,n,o+16,4);if(e<4096||e>=4096+text)fail("PE entry");
  int found=0,rel=0;for(int i=0;i<(forward?4:3);i++){long a=o+os+i*40;if(a>n-40)fail("PE section extent");if(!memcmp(im+a,".text\0",6)){if(found++||le(im,n,a+8,4)!=(unsigned long long)text||le(im,n,a+12,4)!=4096||le(im,n,a+16,4)!=(unsigned long long)((text+511)&-512)||le(im,n,a+20,4)!=1024)fail("PE text section");}if(!memcmp(im+a,".reloc\0",7)){if(rel++||le(im,n,a+20,4)!=(unsigned long long)prefix)fail("PE relocation copy offset");}}if(found!=1||rel!=1)fail("PE sections");
 }
}
/* Model28 PE forward metadata. None of these ranges are attributed to q. */
static void pe_forward_format(const unsigned char *im,long n,long text,long prefix,long *m){
 long rd=m[0],rf=m[1],df=m[2],dt=m[3],cookie=m[4],rl=m[6];
 if(rd!=4096+((text+4095)&-4096)||rf!=1024+((text+511)&-512)||df!=rf+1536||dt!=rd+4096||m[5]!=prefix||m[7]!=128||cookie<5368709120LL+dt+128||rl<8||prefix+((rl+511)&-512)!=n||df>prefix)fail("PE forward layout");
 long p=le(im,n,60,4),o=p+24,a=o+240;int data=0,rdata=0,rel=0;
 if(le(im,n,p+22,2)!=34||le(im,n,o+24,8)!=5368709120ULL||le(im,n,o+68,2)!=3||le(im,n,o+70,2)!=33088||le(im,n,o+4,4)!=(unsigned long long)((text+511)&-512))fail("PE forward image header");
 for(int i=0;i<4;i++,a+=40){
  if(!memcmp(im+a,".rdata\0",7)){if(rdata++||le(im,n,a+8,4)!=1256||le(im,n,a+12,4)!=rd||le(im,n,a+16,4)!=1536||le(im,n,a+20,4)!=rf||le(im,n,a+36,4)!=1073741888)fail("PE forward rdata");}
  if(!memcmp(im+a,".data\0",6)){if(data++||le(im,n,a+12,4)!=dt||le(im,n,a+20,4)!=df||le(im,n,a+16,4)>(unsigned long long)(prefix-df)||le(im,n,a+36,4)!=3221225536ULL)fail("PE forward data");}
  if(!memcmp(im+a,".reloc\0",7)){if(rel++||le(im,n,a+8,4)!=rl||le(im,n,a+16,4)!=(unsigned long long)((rl+511)&-512)||le(im,n,o+152,4)!=le(im,n,a+12,4)||le(im,n,o+156,4)!=rl||le(im,n,a+36,4)!=1107296320||le(im,n,o+56,4)!=((le(im,n,a+12,4)+rl+4095)&~4095ULL))fail("PE forward reloc");}
 }
 if(data!=1||rdata!=1||rel!=1||le(im,n,o+108,4)!=16||le(im,n,o+120,4)!=rd||le(im,n,o+124,4)!=40||le(im,n,o+192,4)!=rd+936||le(im,n,o+196,4)!=320||le(im,n,o+208,4)!=rd+256||le(im,n,o+212,4)!=216)fail("PE forward directories");
 if(rf>n-1536||le(im,n,rf,4)!=rd+40||le(im,n,rf+4,4)||le(im,n,rf+8,4)||le(im,n,rf+12,4)!=rd+916||le(im,n,rf+16,4)!=rd+256||memcmp(im+rf+916,"KERNEL32.dll\0",13)||le(im,n,rf+936,4)!=320||le(im,n,rf+1024,8)!=(unsigned long long)cookie)fail("PE forward import/config");
 for(int i=20;i<40;i++)if(im[rf+i])fail("PE forward null descriptor");
 const int names[26]={472,488,500,512,526,540,554,572,588,606,620,644,662,676,690,708,730,752,772,788,808,830,852,868,886,900};
 for(int i=0;i<27;i++){unsigned long long v=i==26?0:rd+names[i];if(le(im,n,rf+40+i*8,8)!=v||le(im,n,rf+256+i*8,8)!=v)fail("PE forward thunk");}
}

