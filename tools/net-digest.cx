/* Canonical closure content digest v1. This is not a build cache or runtime-read
 * completeness proof. --closure consumes an explicitly supplied net-deps graph;
 * the default obtains the graph once from net-deps. No legacy tree_digest exists. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sysx.process
#pragma unisa use crypto.sha256
#pragma unisa use mem.bytes
#define ND_VERSION "net-digest-framed-v1"
typedef struct {char *name,*stage,*recipe;char digest[65];long files,bytes;} Net;
typedef struct {int net;char *path,*kind;} Entry;
static Net nets[64];static int nn;static Entry *entries;static long ne,ecap;
static void die(const char *why){fprintf(stderr,"NET_DIGEST REFUSE %s errno=%d\n",why,errno);exit(2);}
static void *alloc(size_t n){void *p=malloc(n?n:1);if(!p)die("allocation");return p;}
static char *copy(const char *p,size_t n){char *r=alloc(n+1);mm_copy(r, n, p, n);r[n]=0;return r;}
static void relative(const char *p){if(!*p||*p=='/'||strchr(p,'\\'))die("nonrelative path");const char *s=p;for(;;p++){unsigned c=(unsigned char)*p;if(c&&c<32)die("path control");if(!c||c=='/'){long n=p-s;if(!n||(n==1&&*s=='.')||(n==2&&s[0]=='.'&&s[1]=='.'))die("noncanonical path");if(!c)break;s=p+1;}}}
/* Component-wise no-follow checks reject links, including parent-directory links.
 * The opened fd, rather than a second pathname read, supplies the hashed bytes. */
static int openfile(const char *root,const char *rel){relative(rel);char path[16384];if(cx_fmt(path,sizeof path,"%s/%s",root,rel))die("path length");struct stat st;long base=strlen(root);for(char *p=path+base+1;;p++){if(*p=='/'||!*p){char c=*p;*p=0;if(lstat(path,&st))die("input lstat");if(c?!S_ISDIR(st.st_mode):!S_ISREG(st.st_mode))die("input type/link");*p=c;if(!c)break;}}int fd=open(path,O_RDONLY|O_NOFOLLOW);struct stat fs;if(fd<0||fstat(fd,&fs)||!S_ISREG(fs.st_mode)||fs.st_dev!=st.st_dev||fs.st_ino!=st.st_ino)die("input open identity");return fd;}
static char *load(const char *root,const char *rel,size_t *n){int fd=openfile(root,rel);struct stat st;if(fstat(fd,&st)||st.st_size<0||st.st_size>67108864)die("metadata size");char *s=alloc(st.st_size+1);size_t used=0;while(used<(size_t)st.st_size){ssize_t k=read(fd,s+used,st.st_size-used);if(k<0&&errno==EINTR)continue;if(k<=0)die("metadata read");used+=k;}char extra;if(read(fd,&extra,1)!=0||close(fd))die("metadata changed/close");s[used]=0;*n=used;return s;}
static void hash(const void *p,size_t n,char h[65]){if(sy_sha256_hex(p,n,h)&&cx_sha256_hex(p,n,h))die("SHA");}
static void frame(cs_sha256_t *s,const char *p,size_t n){unsigned char len[8];for(int i=0;i<8;i++)len[i]=(unsigned long long)n>>(i*8);if(cs_sha256_update(s,len,8)||cs_sha256_update(s,p,n))die("hash update");}
static void finish(cs_sha256_t *s,char h[65]){unsigned char out[32];if(cs_sha256_final(s,out))die("hash final");const char *hex="0123456789abcdef";for(int i=0;i<32;i++){h[2*i]=hex[out[i]>>4];h[2*i+1]=hex[out[i]&15];}h[64]=0;}
static int netid(const char *s){for(int i=0;i<nn;i++)if(!strcmp(nets[i].name,s))return i;return -1;}
static void recipes(const char *root){size_t n;char *s=load(root,"tools/cxlib/sourcepackage.cx",&n);char *p=strstr(s,"recipes[]={");if(!p)die("recipe declaration");p+=11;while(*p){while(*p&&*p!='{'&&*p!='}')p++;if(*p=='}')break;if(!*p)die("recipe end");char *start=p;int depth=1,quoted=0;p++;while(*p&&depth){if(*p=='"'&&(p==start||p[-1]!='\\'))quoted=!quoted;if(!quoted){if(*p=='{')depth++;if(*p=='}')depth--;}p++;}if(depth||nn==64)die("recipe shape");char *q=start+1;while(*q==' '||*q=='\t')q++;if(*q++!='"')die("recipe name");char *e=strchr(q,'"');if(!e)die("recipe name");char *name=copy(q,e-q);if(netid(name)>=0)die("duplicate recipe");q=strchr(e+1,'"');if(!q)die("recipe stage");e=strchr(++q,'"');if(!e)die("recipe stage");nets[nn].name=name;nets[nn].stage=copy(q,e-q);nets[nn].recipe=copy(start,p-start);nn++;}if(nn!=42)die("expected 42 recipes");free(s);}
static int compare(const void *a,const void *b){const Entry *x=a,*y=b;int n=strcmp(nets[x->net].name,nets[y->net].name);return n?n:strcmp(x->path,y->path);}
static void graph(char *s,size_t n){if(!n||s[n-1]!='\n'||memchr(s,0,n)||memchr(s,'\r',n))die("graph text");char *p=s,*lf=strchr(p,'\n');*lf=0;if(strcmp(p,"net\tstage\tmanifest\tinput_file\tkind"))die("graph header");p=lf+1;while(*p){lf=strchr(p,'\n');*lf=0;if(*p!='#'){char *f[5];f[0]=p;int k=1;for(char *q=p;*q;q++)if(*q=='\t'){*q=0;if(k==5)die("graph fields");f[k++]=q+1;}if(k!=5)die("graph fields");int id=netid(f[0]);if(id<0||strcmp(f[1],nets[id].stage))die("graph net/stage");if(strcmp(f[2],"-"))relative(f[2]);relative(f[3]);if(strcmp(f[4],"table")&&strcmp(f[4],"facts")&&strcmp(f[4],"shared-generator"))die("graph kind");if(ne==ecap){ecap=ecap?ecap*2:1024;if(ecap>1048576)die("graph count");Entry *a=realloc(entries,ecap*sizeof *a);if(!a)die("graph allocation");entries=a;}entries[ne].net=id;entries[ne].path=copy(f[3],strlen(f[3]));entries[ne++].kind=copy(f[4],strlen(f[4]));}p=lf+1;}qsort(entries,ne,sizeof *entries,compare);long counts[64]={0};for(long i=0;i<ne;i++){if(i&&entries[i].net==entries[i-1].net&&!strcmp(entries[i].path,entries[i-1].path))die("duplicate closure path");counts[entries[i].net]++;}for(int i=0;i<nn;i++)if(!counts[i])die("missing net closure");}
static void digest(const char *root,int id,const char *tool){cs_sha256_t s;cs_sha256_init(&s);frame(&s,ND_VERSION,strlen(ND_VERSION));frame(&s,tool,64);frame(&s,nets[id].name,strlen(nets[id].name));frame(&s,nets[id].stage,strlen(nets[id].stage));frame(&s,nets[id].recipe,strlen(nets[id].recipe));unsigned char buf[65536];for(long i=0;i<ne;i++)if(entries[i].net==id){Entry *e=entries+i;frame(&s,e->path,strlen(e->path));frame(&s,e->kind,strlen(e->kind));int fd=openfile(root,e->path);struct stat before,after;if(fstat(fd,&before)||before.st_size<0)die("input stat");unsigned char len[8];for(int j=0;j<8;j++)len[j]=(unsigned long long)before.st_size>>(j*8);cs_sha256_update(&s,len,8);long total=0;for(;;){ssize_t n=read(fd,buf,sizeof buf);if(n<0&&errno==EINTR)continue;if(n<0)die("input read");if(!n)break;cs_sha256_update(&s,buf,n);total+=n;}if(fstat(fd,&after)||close(fd)||total!=before.st_size||after.st_size!=before.st_size||after.st_mtime!=before.st_mtime||after.st_ctime!=before.st_ctime)die("input changed/close");nets[id].files++;nets[id].bytes+=total;}finish(&s,nets[id].digest);}
int main(int argc,char **argv){const char *root=".",*closure=0,*wanted=0,*exported=0;int all=0;for(int i=1;i<argc;i++){if(!strcmp(argv[i],"--root")&&i+1<argc)root=argv[++i];else if(!strcmp(argv[i],"--closure")&&i+1<argc)closure=argv[++i];else if(!strcmp(argv[i],"--net")&&i+1<argc&&!wanted)wanted=argv[++i];else if(!strcmp(argv[i],"--all")&&!all)all=1;else if(!strcmp(argv[i],"--export-closure")&&i+1<argc&&!exported)exported=argv[++i];else die("usage --root DIR [--closure TSV] (--net NAME|--all) [--export-closure NEW]");}if((all&&wanted)||(!all&&!wanted&&!exported))die("selection");struct stat rt;if(lstat(root,&rt)||!S_ISDIR(rt.st_mode))die("root directory/link");recipes(root);int selected=wanted?netid(wanted):-1;if(wanted&&selected<0)die("unknown net");size_t gn;char *g;np_result r={0};if(closure){g=closure[0]=='/'?load("/",closure+1,&gn):load(".",closure,&gn);}else{char *v[]={"sh","./unisacc.com","tools/net-deps.cx","--","--root",(char *)root,0};char why[300];if(np_run(v,".",0,35,&r,why,sizeof why)||r.rc||r.residue)die("net-deps failed");g=copy(r.out,r.outn);gn=r.outn;np_free(&r);}char *original=copy(g,gn);graph(g,gn);
 cs_sha256_t ts;cs_sha256_init(&ts);const char *tools[]={"tools/net-digest.cx","tools/net-deps.cx","ext/crypto/sha256.cx",0};for(int i=0;tools[i];i++){size_t n;char *s=load(".",tools[i],&n);frame(&ts,tools[i],strlen(tools[i]));frame(&ts,s,n);free(s);}char tool[65];finish(&ts,tool);for(int i=0;i<nn;i++)if(all||i==selected)digest(root,i,tool);
 if(exported){int fd=sy_open_new(exported,0600);if(fd<0||sy_write_all(fd,original,gn)||sy_close(fd))die("exclusive export");}for(int i=0;i<nn;i++)if(all||i==selected)printf("NET_DIGEST\tversion=1\tnet=%s\tstage=%s\tsha256=%s\tfiles=%ld\tbytes=%ld\ttool_sha=%s\tclosure=static-upper-bound\n",nets[i].name,nets[i].stage,nets[i].digest,nets[i].files,nets[i].bytes,tool);if(exported&&!all&&!wanted)printf("NET_CLOSURE\tstate=PREPARED\trows=%ld\tnets=%d\n",ne,nn);return 0;}
