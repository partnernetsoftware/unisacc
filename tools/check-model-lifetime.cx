/* Partial and complete ownership fixtures: each allocation is observed. */
#pragma unisa use runtime.model_lifetime
static int freed, nulls, failed;
static void release(void *p) { if(p) { freed++; free(p); } else nulls++; }
static void ck(int ok,const char *name) { printf("%s\t%s\n",ok?"PASS":"FAIL",name); if(!ok) failed++; }
int main(void) {
    CxModel m={0}, zero={0};
    m.ns=2; m.nstr=2; m.loaded=1;
    m.str=calloc(2,sizeof *m.str); m.str[0]=malloc(1);
    m.rowk=calloc(2,sizeof *m.rowk); m.rowk[1]=malloc(sizeof(int));
    cxml_release(&m,release);
    ck(freed==4,"partial-released");
    ck(!memcmp(&m,&zero,sizeof m),"partial-reset");
    ck(nulls==16,"null-slots-preserved");
    freed=nulls=0; m.nq=1; m.qa=malloc(sizeof *m.qa); m.qoff=malloc(sizeof *m.qoff);
    cxml_release(&m,release);
    ck(freed==2 && !memcmp(&m,&zero,sizeof m),"flat-arrays");
    m.ns=7; cxml_release(&m,0); ck(m.ns==7,"null-release-no-change");
    cxml_release(0,release); ck(freed==2,"null-model");
    printf("CXMODEL_LIFETIME\tfailed=%d\n",failed); return failed?1:0;
}
