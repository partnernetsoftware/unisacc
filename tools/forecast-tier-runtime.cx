/* CLI: forecast-tier-runtime ROOT [TIMINGS ESTIMATES SUMMARY [JOBS]]
 * Emits the same ordered columns and registry-order conditional schedules as
 * the frozen forecast algorithm. No batch, host tool or material is executed.
 * Unmeasured/non-PASS executable rows use registry budgets; planned rows do not
 * contribute execution cost. Heavy/material waits remain UNESTIMATED.
 */
#pragma unisa use cxlib.tierruntime
#pragma unisa use cxlib.netpack

static int ft_scope(ct_item *a,int scope){
    if(scope==0)return ct_eq(a->tier,"commit");
    if(scope==1)return ct_eq(a->tier,"daily");
    if(scope==2)return ct_eq(a->tier,"release");
    if(scope==3)return !ct_eq(a->tier,"release");
    return 1;
}

static void ft_notes(np_buf *out){
    np_puts(out,"# Generated by tools/forecast-tier-runtime.cx; no tests executed; no qualification asserted\n");
    np_puts(out,"# PASS completion only is measured; UNKNOWN/FAIL wall and timeout lower bounds are not completion times\n");
    np_puts(out,"# Budgets are estimates, not completion guarantees; PLANNED excluded from execution costs\n");
    np_puts(out,"# All execution numbers conditional on native host and required registered materials; construction and waits UNESTIMATED\n");
    np_puts(out,"# Registry-order conservative forecast windows do not alter selected commit windows; pools/scopes are overlapping views\n");
}

int main(int argc,char **argv){
    if(argc!=2&&argc!=5&&argc!=6)
        ct_die("usage: ROOT [TIMINGS ESTIMATES SUMMARY [JOBS]]");
    const char *root=argv[1];
    const char *timing=argc>=5?argv[2]:"tests/commit-tier-timings.tsv";
    const char *estimate_path=argc>=5?argv[3]:"tests/tier-runtime-estimates.tsv";
    const char *summary_path=argc>=5?argv[4]:"tests/tier-runtime-summary.tsv";
    int jobs=argc==6?(int)ct_num(argv[5]):16;
    if(jobs<1||jobs>16)ct_die("jobs must be 1..16");
    ct_table reg={0},times={0},domains={0};
    ct_load(root,"tests/batches.tsv",&reg);
    ct_load(root,timing,&times);
    ct_domains(root,&domains);
    ct_meta(&times);
    ct_item *items=calloc(reg.n,sizeof(ct_item));
    ct_wave *waves=calloc(reg.n,sizeof(ct_wave));
    const char **platforms=calloc(reg.n,sizeof(char*));
    if(!items||!waves||!platforms)ct_die("allocation");
    int nplatforms=0;
    np_buf estimates={0},summary={0};
    ft_notes(&estimates);
    np_puts(&estimates,"registry_order\tid\tassigned_tier\tin_commit\tin_daily\tin_release\tin_all\tplatform\timplementation\tmaterials\tdomains\tstatus\tcompletion_ns\tobserved_wall_ns\ttimeout_lower_bound_ns\tobserved_reason\tsource_log\tsource_line\tbudget_seconds\testimate_ns\testimate_source\texecution_condition\tmaterial_build_seconds\tplatform_wait_seconds\n");
    for(int r=0;r<reg.n;r++){
        ct_item *a=&items[r];
        a->id=ct_get(&reg,r,"id");
        a->tier=ct_get(&reg,r,"tier");
        if(!ct_eq(a->tier,"commit")&&!ct_eq(a->tier,"daily")&&!ct_eq(a->tier,"release"))
            ct_die("unknown tier");
        a->platform=ct_get(&reg,r,"platform");
        a->impl=ct_get(&reg,r,"implementation");
        a->materials=ct_get(&reg,r,"materials");
        a->budget=ct_get(&reg,r,"budget_seconds");
        a->domains=ct_domain(&domains,a->id);
        int index=ct_find(&times,a->id);
        a->status=ct_get_or(&times,index,"status","UNMEASURED");
        a->completion=ct_get_or(&times,index,"completion_ns","-");
        a->passed=ct_eq(a->status,"PASS")&&!ct_eq(a->completion,"-");
        a->cost=a->passed?ct_num(a->completion):ct_seconds_ns(ct_num(a->budget));
        int executable=ct_eq(a->impl,"IMPLEMENTED");
        int material=!ct_eq(a->materials,"-");
        int seen=0;
        for(int p=0;p<nplatforms;p++)if(ct_eq(platforms[p],a->platform))seen=1;
        if(!seen)platforms[nplatforms++]=a->platform;
        ct_int(&estimates,r+1);
        ct_text(&estimates,a->id);
        ct_text(&estimates,a->tier);
        ct_int(&estimates,ct_eq(a->tier,"commit"));
        ct_int(&estimates,!ct_eq(a->tier,"release"));
        ct_int(&estimates,1);
        ct_int(&estimates,1);
        ct_text(&estimates,a->platform);
        ct_text(&estimates,a->impl);
        ct_text(&estimates,a->materials);
        ct_text(&estimates,a->domains);
        ct_text(&estimates,a->status);
        ct_text(&estimates,a->completion);
        ct_text(&estimates,ct_get_or(&times,index,"observed_wall_ns","-"));
        ct_text(&estimates,ct_get_or(&times,index,"timeout_lower_bound_ns","-"));
        ct_text(&estimates,ct_get_or(&times,index,"reason","-"));
        ct_text(&estimates,ct_get_or(&times,index,"source_log","-"));
        ct_text(&estimates,ct_get_or(&times,index,"source_line","-"));
        ct_text(&estimates,a->budget);
        if(executable)ct_int(&estimates,a->cost);else ct_text(&estimates,"-");
        ct_text(&estimates,!executable?"excluded-planned":a->passed?"measured-PASS-completion":"registry-budget");
        ct_text(&estimates,!executable?"not-executable":material?"materials-ready-and-native-host-available":"native-host-available");
        ct_text(&estimates,material?"UNESTIMATED":"-");
        ct_last(&estimates,executable?"UNESTIMATED":"-");
    }
    for(int p=1;p<nplatforms;p++){
        const char *value=platforms[p];
        int j=p;
        while(j>0&&strcmp(platforms[j-1],value)>0){platforms[j]=platforms[j-1];j--;}
        platforms[j]=value;
    }
    const char *scopes[]={"commit-layer","daily-layer","release-layer","daily-cumulative","release-cumulative","all"};
    const char *pools[]={"all-executable","material-free","materials-heavy"};
    ft_notes(&summary);
    np_puts(&summary,"scope\tplatform\tpool\tregistered\timplemented\tplanned\tmeasured_pass\tbudget_estimated\tunknown\tfail\tunmeasured\tjobs\twindows\tstartup_ns\tper_window_framework_ns\tmargin\traw_execution_ns\tconditional_execution_ns\tconditional_execution_seconds\tmaterial_build_seconds\tplatform_wait_seconds\tend_to_end_seconds\twindow_ids\n");
    for(int scope=0;scope<6;scope++){
        for(int platform=0;platform<nplatforms;platform++){
            for(int pool=0;pool<3;pool++){
                int registered=0,implemented=0,passed=0,budget=0,unknown=0,fail=0,unmeasured=0,nwave=0,heavy=0;
                memset(waves,0,(size_t)reg.n*sizeof(ct_wave));
                for(int r=0;r<reg.n;r++){
                    ct_item *a=&items[r];
                    if(!ft_scope(a,scope)||!ct_eq(a->platform,platforms[platform]))continue;
                    int material=!ct_eq(a->materials,"-");
                    if((pool==1&&material)||(pool==2&&!material))continue;
                    registered++;
                    unknown+=ct_eq(a->status,"UNKNOWN");
                    fail+=ct_eq(a->status,"FAIL");
                    unmeasured+=ct_eq(a->status,"UNMEASURED");
                    if(!ct_eq(a->impl,"IMPLEMENTED"))continue;
                    implemented++;
                    passed+=a->passed;
                    budget+=!a->passed;
                    if(material)heavy=1;
                    if(!nwave||!ct_compatible(&waves[nwave-1],items,r,jobs))nwave++;
                    ct_add(&waves[nwave-1],items,r);
                }
                long long raw=nwave?times.startup:0;
                for(int w=0;w<nwave;w++)raw+=times.reserve+waves[w].peak;
                long long predicted=ct_margin(raw);
                char seconds[80];
                ct_format_seconds(seconds,sizeof seconds,predicted);
                ct_text(&summary,scopes[scope]);
                ct_text(&summary,platforms[platform]);
                ct_text(&summary,pools[pool]);
                ct_int(&summary,registered);
                ct_int(&summary,implemented);
                ct_int(&summary,registered-implemented);
                ct_int(&summary,passed);
                ct_int(&summary,budget);
                ct_int(&summary,unknown);
                ct_int(&summary,fail);
                ct_int(&summary,unmeasured);
                ct_int(&summary,jobs);
                ct_int(&summary,nwave);
                ct_int(&summary,nwave?times.startup:0);
                ct_int(&summary,times.reserve);
                ct_text(&summary,"5/4");
                ct_int(&summary,raw);
                ct_int(&summary,predicted);
                ct_text(&summary,seconds);
                ct_text(&summary,heavy?"UNESTIMATED":"-");
                ct_text(&summary,implemented?"UNESTIMATED":"-");
                ct_text(&summary,"UNESTIMATED");
                np_buf ids={0};
                for(int w=0;w<nwave;w++){
                    if(w)np_puts(&ids,";");
                    ct_ids(&ids,&waves[w],items);
                }
                ct_last(&summary,nwave?ids.p:"-");
                free(ids.p);
                if(pool==0)printf("%s\t%s\t%d\t%d\t%d\t%d\t%s\n",scopes[scope],platforms[platform],registered,implemented,registered-implemented,nwave,seconds);
            }
        }
    }
    ct_write(root,estimate_path,&estimates);
    ct_write(root,summary_path,&summary);
    printf("FORECAST_TIER_RUNTIME\tregistered=%d\tplatforms=%d\tqualification=NOT_ASSERTED\n",reg.n,nplatforms);
    return 0;
}
