  if(status_known){char *sv=as_read(j->status,0,&sn,why,sizeof why);if(!sv)die("status-file",why);char *end=0;raw=strtol(sv,&end,10);if(end==sv||*end!='\n'||end[1]||raw<0)die("status-file-shape",j->status);cx_sha256_hex(sv,sn,sh);free(sv);}
