 char self[4096],want[4400],rb[4400],h[65];join(want,sizeof want,session,"executor/all-waves");join(rb,sizeof rb,session,"executor/run-batch");if(!realpath("/proc/self/exe",self)||!tx_eqz(self, want))die("run-requires-the-session-native-executor",want);
 int lock=as_lock(session,1,why,sizeof why);if(lock<0)die("session-lock",why);as_manifest m;if(as_load(session,&m,why,sizeof why))die("session-manifest",why);if(!tx_eqz(m.root, root))die("session-root-mismatch",m.root);
 if(!m.has_executor)die("executor-not-registered",session);if(as_sha_file(want,0,h,0,why,sizeof why)||!tx_eqz(h, m.exec_sha))die("executor-changed",want);if(as_sha_file(rb,0,h,0,why,sizeof why)||!tx_eqz(h, m.runner_sha))die("executor-changed",rb);
 if(as_sha_file(candidate,0,h,0,why,sizeof why)||!tx_eqz(h, m.ident.candidate))die("session-candidate-changed","start-a-new-session");refuse_changed_session(&m);
 const as_wave *w=0;for(int i=0;i<m.nwave;i++)if(tx_eqz(m.wave[i].mode, "split")&&tx_eqz(m.wave[i].ids, id)&&!m.wave[i].finished&&!m.wave[i].superseded)w=&m.wave[i];
