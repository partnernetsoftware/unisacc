 if(!b)die("unknown-batch",id);if(!tx_eqz(b->impl, "IMPLEMENTED"))die("batch-not-implemented",id);if(!as_wave_platform_allowed(b->platform))die("batch-needs-another-native-host",id);if(decided(&m,id))die("batch-already-decided-in-session",id);
 Job j;memset(&j,0,sizeof j);j.b=b;if(as_entry(root,b,&m,j.entry,why,sizeof why))die("batch-entry",why);char src[4400];join(src,sizeof src,root,b->source);add_input(&j,src);add_input(&j,j.entry);plan_inputs(&j);
