 if(shared_wt){char mk[4400];join(mk,sizeof mk,session,"wt-shared");np_buf mb={0,0,0};np_puts(&mb,shared_wt);np_puts(&mb,"\n");save_new(mk,mb.p,mb.n);free(mb.p);}
 np_buf sb={0,0,0};np_puts(&sb,"START\tmode=");np_puts(&sb,heavy?"heavy":"light");np_puts(&sb,"\tdir=");np_puts(&sb,dir);np_puts(&sb,"\tids=");np_puts(&sb,ids.p);np_puts(&sb,"\n");if(as_append(fd,session,"start",seq,sb.p,sb.n,why,sizeof why))die("manifest-append",why);free(sb.p);
