}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("all-waves: NOT_RUN requires Linux/x86_64 (run-batch's single native host)\n",stderr);return 3;
#endif
 if(argc<2)die("usage","init|material|wave|pending|executor|start|run|finish ...");
 if(!strcmp(argv[1],"init"))return cmd_init(argc,argv);if(!strcmp(argv[1],"material"))return cmd_material(argc,argv);if(!strcmp(argv[1],"wave"))return cmd_wave(argc,argv);if(!strcmp(argv[1],"pending"))return cmd_pending(argc,argv);
 if(!strcmp(argv[1],"executor"))return cmd_executor(argc,argv);if(!strcmp(argv[1],"start"))return cmd_start(argc,argv);if(!strcmp(argv[1],"run"))return cmd_run(argc,argv);if(!strcmp(argv[1],"finish"))return cmd_finish(argc,argv);
 die("usage","init|material|wave|pending|executor|start|run|finish ...");return 2;
}
