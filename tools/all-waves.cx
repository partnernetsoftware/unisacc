 as_registry reg;if(as_registry_load(root,&reg,why,sizeof why))die("registry-metadata",why);const as_batch *b=as_find_batch(&reg,id);if(!b||!tx_eqz(b->impl, "IMPLEMENTED"))die("batch-not-implemented",id);
 char *v[48];char storage[33][4400];int n=0,s=0;char base[4400],out[4400],err[4400],status[4400],secs[16];join(base,sizeof base,session,w->dir);jobpath(out,base,id,"stdout");jobpath(err,base,id,"stderr");jobpath(status,base,id,"status");
