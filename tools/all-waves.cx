 v[n++]=bound;v[n++]="--status";v[n++]=status;v[n++]=secs;v[n++]=rb;v[n++]=root;v[n++]=base;v[n++]=(char *)id;
 if(!tx_eqz(b->materials, "-")){const char *q=b->materials;tp_material_decl d;while(tp_material_next(&q,&d)>0){const char *name=d.name;if(s==32)die("material-args",id);const as_material *x=as_find_material(&m,name);if(!x||x->kind!=d.kind)die("material-unregistered-or-type",name);char fp[65];if(as_material_fp(x,fp,why,sizeof why)||!tx_eqz(fp, x->fingerprint))die("material-changed-since-registration",name);{ if (cx_fmt(storage[s],sizeof storage[s],"%s=%s",name,x->path)) { fprintf(stderr, "all-waves: text too long for storage[s]\n"); exit(2); } }v[n++]=storage[s++];}}
 v[n]=0;double left_at_fork=deadline-now_s();long long t0=as_now();pid_t pid=fork();if(pid<0)die("fork",id);
 if(!pid){int o=open(out,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC|O_NOFOLLOW,0600);int e=open(err,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC|O_NOFOLLOW,0600);if(o<0||e<0||dup2(o,1)<0||dup2(e,2)<0||chdir(root))_exit(126);execv(bound,v);_exit(127);}
