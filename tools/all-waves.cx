 np_puts(&rb2,"\tbound_rc=");np_putll(&rb2,bound_rc);np_puts(&rb2,"\tchild_status=");if(known)np_putll(&rb2,raw);else np_puts(&rb2,"ABSENT");np_puts(&rb2,"\tstatus=");np_puts(&rb2,sh);np_puts(&rb2,"\tstdout=");np_puts(&rb2,oh);np_puts(&rb2,"\tstdout_bytes=");np_putll(&rb2,(long long)on);
 np_puts(&rb2,"\tstderr=");np_puts(&rb2,eh);np_puts(&rb2,"\tstderr_bytes=");np_putll(&rb2,(long long)en);np_puts(&rb2,"\tstart_ns=");np_putll(&rb2,t0);np_puts(&rb2,"\tend_ns=");np_putll(&rb2,t1);np_puts(&rb2,"\n");
 char mp[4400];join(mp,sizeof mp,session,"session.tsv");int fd=open(mp,O_WRONLY|O_APPEND|O_CLOEXEC|O_NOFOLLOW);if(fd<0)die("manifest-open",mp);if(as_append(fd,session,"run",m.seq+1,rb2.p,rb2.n,why,sizeof why))die("manifest-append",why);close(fd);free(rb2.p);
 /* A separate exclusive seal catches edits to the final RUN block before FINISH.
    A missing seal leaves the interrupted attempt UNKNOWN. */
 {as_manifest sealed;if(as_load(session,&sealed,why,sizeof why))die("run-seal-manifest",why);const as_wave *sw=0;for(int i=0;i<sealed.nwave;i++)if(tx_eqz(sealed.wave[i].nonce, w->nonce))sw=&sealed.wave[i];if(!sw||!sw->run)die("run-seal-block",id);char seal[4400],leaf[200],value[66];jobpath(seal,base,id,"runseal");if(mm_copy(value,sizeof value,sw->run_sha,64))die("run-seal-bound",id);value[64]='\n';value[65]=0;save_new(seal,value,65);as_free(&sealed);}
 printf("RUN\t%s\tattempt=%s\tbound_seconds=%d\tbound_rc=%d\tchild_status=%s%lld\tbatch_wall_ns=%lld\touter_left_at_entry_s=%.3f\touter_left_at_fork_s=%.3f\touter_left_after_seal_s=%.3f\tverdict=DECIDED_BY_FINISH\n",id,w->nonce,seconds,bound_rc,known?"":"ABSENT",known?raw:0LL,t1-t0,left_at_entry,left_at_fork,deadline-now_s());
 as_registry_free(&reg);as_free(&m);close(lock);return 0;
}
static int cmd_finish(int argc,char **argv){
 if(argc!=6)die("usage","finish ROOT SESSION ID NONCE");outer_window();canonical_root(argv[2]);existing_session(argv[3]);char verdict[16],reason[200];
 if(as_finish(root,session,argv[4],argv[5],verdict,reason,why,sizeof why))die_why();
 printf("FINISH\t%s\t%s\treason=%s\tattempt=%s\tqualification=NOT_DECIDED_HERE\n",argv[4],verdict,reason,argv[5]);return strcmp(verdict,"PASS")?1:0;
}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("all-waves: NOT_RUN requires Linux/x86_64 (run-batch's single native host)\n",stderr);return 3;
#endif
 if(argc<2)die("usage","init|material|wave|pending|executor|start|run|finish ...");
 if(argc==3&&!strcmp(argv[1],"inputs")){canonical_root(argv[2]);np_buf snapshot={0};size_t n;wt_scan(root,&n,&snapshot);if(n&&fwrite(snapshot.p,1,n,stdout)!=n)die("inputs-write",0);free(snapshot.p);return 0;}
 /* Consumer control: compare saved input snapshots with the very same wave gate. */
 if((argc==4||argc==5)&&!strcmp(argv[1],"inputs-diff")){
    size_t an=0,bn=0;char *a=cx_read(argv[2],&an),*b=cx_read(argv[3],&bn);
    if(!a||!b)die("inputs-diff-read",0);np_buf out={0};if(argc==5)np_puts(&out,argv[4]);int moved=wt_diff(a,an,b,bn,&out);
    printf("WT_CHANGED\tpaths=%d\n",moved);if(out.n&&fwrite(out.p,1,out.n,stdout)!=out.n)die("inputs-diff-write",0);
    free(a);free(b);free(out.p);return 0;
 }
 /* S9 epoch close: one fresh worktree measurement after every child of a step ended, compared with
    the snapshot the supervisor verified before launching them.  Writes the record exclusively and
    never reads an earlier record, so no scan result is reused across epochs.  rc 2 = changed. */
 if(argc>=6&&!strcmp(argv[1],"wt-close")){
    canonical_root(argv[2]);const char *rec=argv[4];if(rec[0]!='/'||!strstr(rec,"/wt-epoch-"))die("wt-epoch-path",rec);
    size_t an=0;char *a=cx_read(argv[3],&an);if(!a)die("wt-close-before-read",argv[3]);
    long long t0=as_now();np_buf now={0,0,0};size_t bn=0;wt_scan(root,&bn,&now);long long scan_ns=as_now()-t0;
    np_buf paths={0,0,0};int moved=wt_diff(a,an,now.p,bn,&paths);char hb[65],ha[65];cx_sha256_hex(a,an,hb);cx_sha256_hex(now.p?now.p:"",bn,ha);
    np_buf r={0,0,0};np_puts(&r,"S9_WT_EPOCH\tv1\nbefore\t");np_puts(&r,hb);np_puts(&r,"\nafter\t");np_puts(&r,ha);np_puts(&r,"\nmoved\t");np_putll(&r,moved);np_puts(&r,"\nscan_ns\t");np_putll(&r,scan_ns);np_puts(&r,"\nclosed_ns\t");np_putll(&r,as_now());np_puts(&r,"\n");
    for(int i=5;i<argc;i++){if(!argv[i][0]||strchr(argv[i],'\n')||strchr(argv[i],'\t')||strchr(argv[i],'/'))die("wt-epoch-leaf",argv[i]);np_puts(&r,"slice\t");np_puts(&r,argv[i]);np_puts(&r,"\n");}
    for(size_t at=0;at<paths.n;){size_t e=at;while(e<paths.n&&paths.p[e]!='\n')e++;np_puts(&r,"path\t");np_put(&r,paths.p+at,e-at);np_puts(&r,"\n");at=e+1;}
    np_puts(&r,"END\n");save_new(rec,r.p,r.n);char rh[66],sp[4400];cx_sha256_hex(r.p,r.n,rh);rh[64]='\n';rh[65]=0;{int z=snprintf(sp,sizeof sp,"%s.sha256",rec);if(z<0||(size_t)z>=sizeof sp)die("path-bound",rec);}save_new(sp,rh,65);
    printf("WT_EPOCH\t%s\tmoved=%d\tscans=%d\tscan_ns=%lld\tslices=%d\trecord=%s\n",moved?"CHANGED":"STABLE",moved,g_wt_scans,scan_ns,argc-5,rec);if(moved&&paths.n)fwrite(paths.p,1,paths.n,stdout);
    free(a);free(now.p);free(paths.p);free(r.p);return moved?2:0;
 }
 if(tx_eqz(argv[1], "init"))return cmd_init(argc,argv);if(tx_eqz(argv[1], "material"))return cmd_material(argc,argv);if(tx_eqz(argv[1], "wave"))return cmd_wave(argc,argv);if(tx_eqz(argv[1], "pending"))return cmd_pending(argc,argv);
 if(tx_eqz(argv[1], "executor"))return cmd_executor(argc,argv);if(tx_eqz(argv[1], "start"))return cmd_start(argc,argv);if(tx_eqz(argv[1], "run"))return cmd_run(argc,argv);if(tx_eqz(argv[1], "finish"))return cmd_finish(argc,argv);
 die("usage","init|material|wave|pending|executor|start|run|finish ...");return 2;
}
