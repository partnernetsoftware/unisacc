  char leaf[200];{int z=snprintf(leaf,sizeof leaf,"%s.stdout",j->b->id);if(z<0||(size_t)z>=sizeof leaf){fprintf(stderr,"bound-format\n");exit(2);}};np_puts(&r,"\nstdout\t");np_puts(&r,leaf);np_puts(&r,"\t");np_puts(&r,oh);np_puts(&r,"\t");np_putll(&r,(long long)on);{int z=snprintf(leaf,sizeof leaf,"%s.stderr",j->b->id);if(z<0||(size_t)z>=sizeof leaf){fprintf(stderr,"bound-format\n");exit(2);}};np_puts(&r,"\nstderr\t");np_puts(&r,leaf);np_puts(&r,"\t");np_puts(&r,eh);np_puts(&r,"\t");np_putll(&r,(long long)en);
