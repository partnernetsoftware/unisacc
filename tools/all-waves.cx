  np_buf r={0,0,0};np_puts(&r,"ALLRECEIPT\tv1\nbatch\t");np_puts(&r,j->b->id);np_puts(&r,"\nwave\t");np_putll(&r,seq);np_puts(&r,"\nregistry_row_sha\t");np_puts(&r,j->b->row);np_puts(&r,"\nregistry_sha\t");np_puts(&r,m.ident.registry);np_puts(&r,"\nsource_sid\t");np_puts(&r,m.ident.sid);np_puts(&r,"\nharness_sha\t");np_puts(&r,m.ident.harness);
  np_puts(&r,"\ncandidate_before\t");np_puts(&r,before);np_puts(&r,"\ncandidate_after\t");np_puts(&r,after.candidate[0]?after.candidate:"UNMEASURED");np_puts(&r,"\nidentity_after\t");np_puts(&r,identity_stable?"STABLE":"CHANGED");np_puts(&r,"\nchild_seconds\t");np_putll(&r,j->seconds);
