    A missing seal leaves the interrupted attempt UNKNOWN. */
 {as_manifest sealed;if(as_load(session,&sealed,why,sizeof why))die("run-seal-manifest",why);const as_wave *sw=0;for(int i=0;i<sealed.nwave;i++)if(!strcmp(sealed.wave[i].nonce,w->nonce))sw=&sealed.wave[i];if(!sw||!sw->run)die("run-seal-block",id);char seal[4400],leaf[200],value[66];jobpath(seal,base,id,"runseal");memcpy(value,sw->run_sha,64);value[64]='\n';value[65]=0;save_new(seal,value,65);as_free(&sealed);}
 printf("RUN\t%s\tattempt=%s\tbound_seconds=%d\tbound_rc=%d\tchild_status=%s%lld\tbatch_wall_ns=%lld\touter_left_at_entry_s=%.3f\touter_left_at_fork_s=%.3f\touter_left_after_seal_s=%.3f\tverdict=DECIDED_BY_FINISH\n",id,w->nonce,seconds,bound_rc,known?"":"ABSENT",known?raw:0LL,t1-t0,left_at_entry,left_at_fork,deadline-now_s());
