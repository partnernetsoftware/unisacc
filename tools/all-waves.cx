 int npass=0,nfail=0,nunknown=0;
 for(int i=0;i<count;i++){Job *j=&job[i];hash_inputs(j,j->after);int inputs_stable=1;for(int k=0;k<j->ninput;k++)if(!tx_eqz(j->before[k], j->after[k]))inputs_stable=0;
