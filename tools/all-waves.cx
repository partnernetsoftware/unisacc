 np_puts(&rb2,"\tstderr=");np_puts(&rb2,eh);np_puts(&rb2,"\tstderr_bytes=");np_putll(&rb2,(long long)en);np_puts(&rb2,"\tstart_ns=");np_putll(&rb2,t0);np_puts(&rb2,"\tend_ns=");np_putll(&rb2,t1);np_puts(&rb2,"\n");
 char mp[4400];join(mp,sizeof mp,session,"session.tsv");int fd=open(mp,O_WRONLY|O_APPEND|O_CLOEXEC|O_NOFOLLOW);if(fd<0)die("manifest-open",mp);if(as_append(fd,session,"run",m.seq+1,rb2.p,rb2.n,why,sizeof why))die("manifest-append",why);close(fd);free(rb2.p);
