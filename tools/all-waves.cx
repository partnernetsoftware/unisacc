/* all-waves -- execute registered IMPLEMENTED batches in bounded waves of one session.
 *
 * Every command runs under one outer watchdog of at most 55 s:
 *   tools/bound 55 sh ./unisacc.com tools/all-waves.cx -- init     ROOT NEW_SESSION CANDIDATE MATERIALS_MAP|-
 *   tools/bound 55 sh ./unisacc.com tools/all-waves.cx -- material ROOT SESSION NAME
 *   tools/bound 55 sh ./unisacc.com tools/all-waves.cx -- wave     ROOT SESSION [--child-seconds N] --light ID [ID ID ID]
 *   tools/bound 55 sh ./unisacc.com tools/all-waves.cx -- wave     ROOT SESSION [--child-seconds N] --heavy ID
 * S9's native descendant supervisor instead invokes the frozen executor with
 * wave ROOT SESSION --s9-supervised --heavy ID... and its inherited remaining
 * deadline (at most 300 s). No whole-wave bound 55 surrounds identity/receipts;
 * every spawned run-batch still retains its own bound of at most 55 s.
 * With --shared-wt RUN/wt-epoch-N the child skips its own worktree scans; the S9 step measures
 * once before (freeze_check) and once after all its children (wt-close ROOT BEFORE RECORD LEAF...),
 * and the S9 aggregate refuses the session unless that record lists it with moved=0.
 *   sh ./unisacc.com tools/all-waves.cx -- pending ROOT SESSION      (read-only listing; no verdicts)
 * SESSION is a new absolute directory below ROOT/out.  CANDIDATE must be ROOT/unisacc.com, because
 * tests/run-batch.cx (the only executor) binds that path. MATERIALS_MAP has lines
 * NAME<TAB>VALUE: a canonical path for bare/:path registry declarations, or a strict lowercase
 * 64-byte hex literal for :sha256. Each is independently identity-hashed by its own
 * `material` command before a wave may use it.  A light wave runs at most four materials-free
 * batches concurrently; a heavy wave runs exactly one batch of any kind. Each child uses
 *   tools/bound --status F S RUN/executor/run-batch ROOT SESSION/wave-N ID [m=path...]
 * where S = min(registry budget, --child-seconds, what is left of the outer window minus 12 s for
 * the after-measurements), so the runner always outlives its children and writes every receipt.
 * A wave refuses before starting when the candidate, registry, source SID, harness trees, materials
 * map or a material fingerprint differs from the session, when a batch already has a PASS or FAIL
 * receipt (FAIL is sticky; only UNKNOWN may be retried), or when the window is too short.
 * The START block is written before any child runs, so a killed wave remains visible as interrupted.
 * This writes evidence only; tests/all-aggregate.cx decides qualification.
 *
 * Split attempts give one batch a whole tools/bound 55 window (a wave's child gets only what is left
 * after ~12 s cx-run startup and the 12 s after-measurement reserve):
 *   tools/bound 55 sh ./unisacc.com tools/all-waves.cx -- executor ROOT SESSION
 *       once per session: the session candidate compiles tools/all-waves.cx and tests/run-batch.cx to
 *       SESSION/executor/{all-waves,run-batch}; their SHAs go into an executor block.  This is a
 *       measured startup cache (cx-run ~12 s, native ~1 ms here), never a cached test result.
 *   tools/bound 55 sh ./unisacc.com tools/all-waves.cx -- start ROOT SESSION ID
 *       every wave refusal, then SESSION/attempt-<nonce16>/ID.start (identity, input before-hashes,
 *       materials) and a START mode=split block with the attempt nonce.  Prints the run/finish lines.
 *   tools/bound 58 SESSION/executor/all-waves run ROOT SESSION ID
 *       only the registered native executor (/proc/self/exe SHA) may run it.  It forks
 *       ROOT/tools/bound --status F S SESSION/executor/run-batch ROOT ATTEMPT_DIR ID [m=path...]
 *       with S = 55 when the outer window allows (refused below the batch budget), waitpid()s bound
 *       itself and seals bound rc, child status, transcript and status-file hashes in a RUN block in
 *       the same command.  Its own pre-fork and post-wait work is milliseconds.
 *   tools/bound 55 sh ./unisacc.com tools/all-waves.cx -- finish ROOT SESSION ID NONCE
 *       re-measures identity, re-checks everything against the RUN block and writes the receipt and
 *       FINISH (cxlib.allsession as_finish).  There is no bound-rc argument. */
#pragma unisa use cxlib.allsession
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.testplan
#pragma unisa use text.text
#pragma unisa use mem.bytes
/* Concurrency ceiling and fallback live in exec/facts/limits.tsv, so the number exists once.
   Core count comes from `nproc` through the same capture helper every other probe uses; when it is
   unavailable the fallback applies, which is the pre-split behaviour. */
#define WAVE_JOBS_MAX 16
#define WAVE_JOBS_FALLBACK 4
static int wave_jobs(void) {
    char *v[] = {"nproc", 0};
    np_result r = {0};
    char why[256] = {0};
    int n = WAVE_JOBS_FALLBACK;
    if (!np_run(v, 0, 0, 5, &r, why, sizeof why) && r.rc == 0 && r.outn > 0) {
        long got = strtol(r.out, 0, 10);
        if (got >= 1 && got <= 4096) n = (int)got;
    }
    np_free(&r);
    return n > WAVE_JOBS_MAX ? WAVE_JOBS_MAX : n;
}
static char root[4096],session[4096],candidate[4400],bound[4400],runner[4400],why[1700];
static double deadline;
static void die(const char *name,const char *detail){printf("REFUSE\t%s\t%s\n",name,detail?detail:"-");fprintf(stderr,"all-waves: REFUSE %s %s\n",name,detail?detail:"-");exit(2);}
static void join(char *out,size_t cap,const char *a,const char *b){int n=snprintf(out,cap,"%s/%s",a,b);if(n<0||(size_t)n>=cap)die("path-bound",b);}
static double now_s(void){long long t=as_now();if(t<0)die("monotonic-clock",0);return (double)t/1e9;}
static void outer_window_limit(double maximum){const char *d=getenv("UNISACC_BOUND_DEADLINE_MONO");char *end=0;if(!d||!*d)die("outer-bound-required","supervisor deadline required");deadline=strtod(d,&end);double left=deadline-now_s();if(!end||*end||left<=0||left>maximum)die("outer-window-range",d);}
static void outer_window(void){outer_window_limit(57.5);}
static void canonical_root(const char *arg){if(arg[0]!='/'||!realpath(arg,root)||!tx_eqz(root, arg))die("canonical-root",arg);join(candidate,sizeof candidate,root,"unisacc.com");join(bound,sizeof bound,root,"tools/bound");join(runner,sizeof runner,root,"tests/run-batch.cx");}
static void below_out(const char *p){char base[4400],canon[4096];join(base,sizeof base,root,"out");if(!realpath(base,canon))die("root-out",base);size_t n=strlen(canon);if(strncmp(p,canon,n)||p[n]!='/'||!p[n+1])die("session-must-be-below-ROOT/out",p);}
static void existing_session(const char *arg){if(arg[0]!='/'||!realpath(arg,session)||!tx_eqz(session, arg))die("canonical-session",arg);below_out(session);}
static void save_new(const char *p,const char *s,size_t n){int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC|O_NOFOLLOW,0600);if(fd<0)die("exclusive-write",p);size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("write",p);at+=(size_t)z;}if(fsync(fd)||close(fd))die("write-close",p);}
static void check_identity(const as_manifest *m,as_ident *live){
 if(!tx_eqz(m->root, root))die("session-root-mismatch",m->root);if(as_identity(root,1,live,why,sizeof why))die("live-identity",why);
 const char *d=as_ident_diff(live,&m->ident);if(d){char name[80];{int z=snprintf(name,sizeof name,"session-%s-changed",d);if(z<0||(size_t)z>=sizeof name){fprintf(stderr,"bound-format\n");exit(2);}};die(name,"start-a-new-session");}
 char p[4400],h[65];join(p,sizeof p,session,"materials.tsv");if(as_sha_file(p,0,h,0,why,sizeof why)||!tx_eqz(h, m->map_sha))die("session-materials-map-changed",p);
 if(as_material_bind(session,m,why,sizeof why))die("session-material-binding",why);
}
/* materials.tsv: NAME<TAB>PATH lines; returns the path for NAME or 0 */
static int map_lookup(const char *map,size_t n,const char *name,char out[4096]){size_t at=0,nl=strlen(name);while(at<n){size_t end=at;while(end<n&&map[end]!='\n')end++;if(end-at>nl+1&&!memcmp(map+at,name,nl)&&map[at+nl]=='\t'){size_t z=end-at-nl-1;if(z>=4096)return 0;{unsigned char *cxb_d=(unsigned char *)(out);const unsigned char *cxb_s=(const unsigned char *)(map+at+nl+1);size_t cxb_n=(size_t)(z),cxb_i;for(cxb_i=0;cxb_i<cxb_n;cxb_i++)cxb_d[cxb_i]=cxb_s[cxb_i];};out[z]=0;return 1;}at=end+1;}return 0;}
static int declared_material(const as_registry *r,const char *name){return as_material_kind(r,name);}

static int cmd_init(int argc,char **argv){
 if(argc!=6)die("usage","init ROOT NEW_SESSION CANDIDATE MATERIALS_MAP|-");outer_window();canonical_root(argv[2]);
 char cand[4096];if(!realpath(argv[4],cand)||!tx_eqz(cand, candidate))die("candidate-must-be-ROOT/unisacc.com","run-batch.cx binds ROOT/unisacc.com");
 /* the new session: absolute, parent canonical, below ROOT/out, absent */
 if(argv[3][0]!='/'||strlen(argv[3])>=sizeof session)die("session-absolute",argv[3]);char parent[4096],pc[4096];{ if (cx_fmt(parent, sizeof parent, "%s",argv[3])) { fprintf(stderr, "all-waves: text too long for parent\n"); exit(2); } }char *slash=strrchr(parent,'/');if(!slash||!slash[1]||tx_eqz(slash+1, ".")||tx_eqz(slash+1, ".."))die("session-leaf",argv[3]);*slash=0;
 if(!realpath(parent,pc)||!tx_eqz(pc, parent))die("session-parent-canonical",parent);{ if (cx_fmt(session, sizeof session, "%s", argv[3])) { fprintf(stderr, "all-waves: text too long for session\n"); exit(2); } }below_out(session);struct stat st;errno=0;if(!lstat(session,&st)||errno!=ENOENT)die("session-must-be-absent",session);
 as_registry reg;if(as_registry_load(root,&reg,why,sizeof why))die("registry-metadata",why);int implemented=0;for(int i=0;i<reg.nb;i++)if(tx_eqz(reg.b[i].impl, "IMPLEMENTED"))implemented++;
 char *map;size_t mn=0;if(tx_eqz(argv[5], "-")){map=malloc(1);if(!map)die("allocation",0);map[0]=0;}else if(!(map=as_read(argv[5],0,&mn,why,sizeof why)))die("materials-map",why);
 if(mn&&map[mn-1]!='\n')die("materials-map-wire",argv[5]);
 int nmap=0;size_t at=0;while(at<mn){size_t end=at;while(map[end]!='\n')end++;char line[4400];if(end-at>=sizeof line)die("materials-map-line",0);{unsigned char *cxb_d=(unsigned char *)(line);const unsigned char *cxb_s=(const unsigned char *)(map+at);size_t cxb_n=(size_t)(end-at),cxb_i;for(cxb_i=0;cxb_i<cxb_n;cxb_i++)cxb_d[cxb_i]=cxb_s[cxb_i];};line[end-at]=0;at=end+1;
  char *tab=strchr(line,'\t');if(!tab||strchr(tab+1,'\t'))die("materials-map-fields",line);*tab=0;const char *name=line,*path=tab+1;char canon[4096];
  int mk=declared_material(&reg,name);if(mk<1)die("materials-map-undeclared-name",name);if(!tp_material_value(mk,path))die("materials-map-typed-value",name);if(mk==2){nmap++;continue;}
  errno=0;struct stat ms;if(lstat(path,&ms)){if(errno==ENOENT)die("material-absent",path);char d[4200];{int z=snprintf(d,sizeof d,"%s errno=%d",path,errno);if(z<0||(size_t)z>=sizeof d){fprintf(stderr,"bound-format\n");exit(2);}};die("material-stat",d);}
  if(!S_ISREG(ms.st_mode)&&!S_ISDIR(ms.st_mode))die("material-path-kind",path);if(path[0]!='/'||!realpath(path,canon)||!tx_eqz(canon, path))die("material-path-canonical",path);nmap++;}
 /* duplicate names */
 {size_t a=0;while(a<mn){size_t e=a;while(map[e]!='\n')e++;size_t t=a;while(map[t]!='\t')t++;char name[200];if(t-a>=sizeof name)die("materials-map-name",0);{unsigned char *cxb_d=(unsigned char *)(name);const unsigned char *cxb_s=(const unsigned char *)(map+a);size_t cxb_n=(size_t)(t-a),cxb_i;for(cxb_i=0;cxb_i<cxb_n;cxb_i++)cxb_d[cxb_i]=cxb_s[cxb_i];};name[t-a]=0;char first[4096];size_t prefix=a;if(prefix&&map_lookup(map,prefix,name,first))die("materials-map-duplicate",name);a=e+1;}}
 as_ident id;{const char *par=getenv("UNISACC_IDENTITY_PARENT");if(par&&par[0]){as_manifest pm;if(as_load(par,&pm,why,sizeof why))die("identity-parent",why);if(!tx_eqz(pm.root, root))die("identity-parent-root",pm.root);if(!pm.ident.sid[0])die("identity-parent-sid",par);id=pm.ident;as_free(&pm);}else if(as_identity(root,1,&id,why,sizeof why))die("live-identity",why);}
 char map_sha[65];cx_sha256_hex(map,mn,map_sha);long long created=as_now();
 if(mkdir(session,0700))die("session-mkdir",session);char p[4400];join(p,sizeof p,session,"materials.tsv");save_new(p,map,mn);join(p,sizeof p,session,"lock");save_new(p,"",0);
 np_buf h={0,0,0};np_puts(&h,"ALLSESSION\tv2\nroot\t");np_puts(&h,root);np_puts(&h,"\ncandidate_sha\t");np_puts(&h,id.candidate);np_puts(&h,"\nbatches_sha\t");np_puts(&h,id.batches);np_puts(&h,"\ncoverage_sha\t");np_puts(&h,id.coverage);
 np_puts(&h,"\nregistry_sha\t");np_puts(&h,id.registry);np_puts(&h,"\nsource_sid\t");np_puts(&h,id.sid);np_puts(&h,"\nharness_sha\t");np_puts(&h,id.harness);np_puts(&h,"\nmaterials_map_sha\t");np_puts(&h,map_sha);np_puts(&h,"\ncreated_ns\t");np_putll(&h,created);np_puts(&h,"\ncandidate_kind\t");np_puts(&h,id.candidate_kind);np_puts(&h,"\nEND\t0\n");
 join(p,sizeof p,session,"session.tsv");save_new(p,h.p,h.n);free(h.p);free(map);
 printf("INIT\tsession=%s\tcandidate=%s\tregistry=%s\tsid=%s\tharness=%s\tmaterials_mapped=%d\timplemented_batches=%d\tqualification=NOT_EXECUTED\n",session,id.candidate,id.registry,id.sid,id.harness,nmap,implemented);
 as_registry_free(&reg);return 0;
}
static int cmd_material(int argc,char **argv){
 if(argc!=5)die("usage","material ROOT SESSION NAME");outer_window();canonical_root(argv[2]);existing_session(argv[3]);
 int lock=as_lock(session,1,why,sizeof why);if(lock<0)die("session-lock",why);as_manifest m;if(as_load(session,&m,why,sizeof why))die("session-manifest",why);as_ident live;check_identity(&m,&live);
 if(as_find_material(&m,argv[4]))die("material-already-registered",argv[4]);char p[4400],path[4096];size_t mn;join(p,sizeof p,session,"materials.tsv");char *map=as_read(p,0,&mn,why,sizeof why);if(!map)die("materials-map",why);if(!map_lookup(map,mn,argv[4],path))die("material-not-in-map",argv[4]);free(map);
 as_registry reg;if(as_registry_load(root,&reg,why,sizeof why))die("registry-metadata",why);int mk=declared_material(&reg,argv[4]);as_registry_free(&reg);if(mk<1)die("material-undeclared",argv[4]);
 char fp1[65],fp2[65],content[65];long entries=0;long long t0=as_now();
 if(as_material_measure(mk,path,0,fp1,0,why,sizeof why))die("material-fingerprint",why);if(as_material_measure(mk,path,1,content,&entries,why,sizeof why))die("material-content",why);if(as_material_measure(mk,path,0,fp2,0,why,sizeof why))die("material-fingerprint",why);if(!tx_eqz(fp1, fp2))die("material-changed-while-hashing",argv[4]);
 np_buf b={0,0,0};np_puts(&b,"MATERIAL\t");np_puts(&b,argv[4]);np_puts(&b,"\t");np_puts(&b,path);np_puts(&b,"\tcontent=");np_puts(&b,content);np_puts(&b,"\tfingerprint=");np_puts(&b,fp1);np_puts(&b,"\tentries=");np_putll(&b,entries);as_material_tag(&b,mk);np_puts(&b,"\n");
 join(p,sizeof p,session,"session.tsv");int fd=open(p,O_WRONLY|O_APPEND|O_CLOEXEC|O_NOFOLLOW);if(fd<0)die("manifest-open",p);if(as_append(fd,session,"material",m.seq+1,b.p,b.n,why,sizeof why))die("manifest-append",why);close(fd);free(b.p);
 printf("MATERIAL\t%s\tpath=%s\tcontent=%s\tfingerprint=%s\tentries=%ld\thash_ns=%lld\tstate=PREPARED-identity-only\n",argv[4],path,content,fp1,entries,as_now()-t0);as_free(&m);close(lock);return 0;
}
static int decided(const as_manifest *m,const char *id){for(int i=0;i<m->nref;i++)if(tx_eqz(m->ref[i].id, id)&&!tx_eqz(m->ref[i].verdict, "UNKNOWN"))return 1;return 0;}
/* Tier is a caller selection only: the session registry and qualification stay complete. */
static const char *tier_filter;
static char tier_ids[2048][128];static int tier_count;
static void tier_batch(const tp_batch_view *v,void *ctx){(void)ctx;if(!strcmp(v->implementation,"IMPLEMENTED")&&tp_tier_includes(tier_filter,v->tier)){if(tier_count==2048)die("tier-limit",v->id);if(cx_fmt(tier_ids[tier_count],sizeof tier_ids[0],"%s",v->id))die("tier-id-bound",v->id);tier_count++;}}
static void tier_cov(const tp_coverage_view *v,void *ctx){(void)v;(void)ctx;}
static void select_tier(const char *value){
 if(strcmp(value,"commit")&&strcmp(value,"daily")&&strcmp(value,"release"))die("unknown-tier",value);tier_filter=value;tier_count=0;
 char p[4400];size_t rn,cn;join(p,sizeof p,root,"tests/batches.tsv");char *r=as_read(p,0,&rn,why,sizeof why);join(p,sizeof p,root,"tests/coverage.tsv");char *c=as_read(p,0,&cn,why,sizeof why);if(!r||!c)die("registry-metadata",why);
 tp_summary s;tp_observer ob={tier_batch,tier_cov,0};if(tp_visit(root,r,rn,c,cn,&ob,&s,why,sizeof why))die("registry-metadata",why);free(r);free(c);
}
static int tier_selected(const char *id){if(!tier_filter)return 1;for(int i=0;i<tier_count;i++)if(!strcmp(id,tier_ids[i]))return 1;return 0;}
static int cmd_pending(int argc,char **argv){
 if(argc!=4&&!(argc==6&&!strcmp(argv[4],"--tier")))die("usage","pending ROOT SESSION [--tier commit|daily|release]");canonical_root(argv[2]);existing_session(argv[3]);if(argc==6)select_tier(argv[5]);as_manifest m;if(as_load(session,&m,why,sizeof why))die("session-manifest",why);as_registry reg;if(as_registry_load(root,&reg,why,sizeof why))die("registry-metadata",why);int n=0;
 for(int i=0;i<reg.nb;i++){as_batch *b=&reg.b[i];if(!tx_eqz(b->impl, "IMPLEMENTED")||decided(&m,b->id))continue;n++;int ready=1;if(!tx_eqz(b->materials, "-")){const char *q=b->materials;tp_material_decl d;while(tp_material_next(&q,&d)>0){const as_material *x=as_find_material(&m,d.name);if(!x||x->kind!=d.kind)ready=0;}}
  if(!tier_selected(b->id)){n--;continue;}
  printf("PENDING\t%s\twave_class=%s\tbudget=%d\tmaterials=%s\tmaterials_registered=%s\n",b->id,strcmp(b->materials,"-")?"heavy":"light-or-heavy",b->budget,b->materials,ready?"yes":"no");}
 int open=0;for(int i=0;i<m.nwave;i++){const as_wave *w=&m.wave[i];if(!tx_eqz(w->mode, "split")||w->finished)continue;open++;printf("OPEN_ATTEMPT\t%s\tattempt=%s\tstate=%s\n",w->ids,w->nonce,w->superseded?"SUPERSEDED-UNKNOWN":w->run?"RUN-SEALED-AWAITING-FINISH":"STARTED-AWAITING-RUN");}
 printf("PENDING_SUMMARY\tundecided=%d\topen_attempts=%d\texecutor=%s\tqualification=NOT_DECIDED_HERE\n",n,open,m.has_executor?"REGISTERED":"ABSENT");as_registry_free(&reg);as_free(&m);return 0;
}

typedef struct {const as_batch *b;char entry[4400];char **input;char (*before)[65];char (*after)[65];int ninput;char out[4400],err[4400],status[4400],receipt[4400];pid_t pid;long long t0,t1;int bound_rc,seconds;} Job;
static void jobpath(char out[4400],const char *wavedir,const char *id,const char *suffix){char leaf[200];int z=snprintf(leaf,sizeof leaf,"%s.%s",id,suffix);if(z<0||(size_t)z>=sizeof leaf)die("leaf-bound",id);join(out,4400,wavedir,leaf);}
static void add_input(Job *j,const char *p){for(int i=0;i<j->ninput;i++)if(tx_eqz(j->input[i], p))return;j->input=realloc(j->input,(size_t)(j->ninput+1)*sizeof *j->input);j->before=realloc(j->before,(size_t)(j->ninput+1)*sizeof *j->before);j->after=realloc(j->after,(size_t)(j->ninput+1)*sizeof *j->after);if(!j->input||!j->before||!j->after)die("allocation",0);j->input[j->ninput]=malloc(strlen(p)+1);if(!j->input[j->ninput])die("allocation",0);{ void *cx_kept = memcpy(j->input[j->ninput], p, strlen(p) + 1); (void)cx_kept; }j->ninput++;}
/* the module closure the product itself plans for the entry */
static void plan_inputs(Job *j){char *v[]={"sh",candidate,"-cx-plan",j->entry,0};np_result r;char reason[1200];if(np_run(v,root,0,10,&r,reason,sizeof reason))die("cx-plan-transport",reason);if(r.rc||!r.outn||r.out[r.outn-1]!='\n'){np_free(&r);die("cx-plan",j->entry);}
 size_t at=0;while(at<r.outn){size_t end=at;while(r.out[end]!='\n')end++;r.out[end]=0;char *line=r.out+at;at=end+1;char *t1=strchr(line,'\t');if(!t1||line==t1)die("cx-plan-line",line);char *t2=strchr(t1+1,'\t');if(t2)*t2=0;char full[4400];if(t1[1]=='/'){if(strlen(t1+1)>=sizeof full)die("cx-plan-path",t1+1);{ if (cx_fmt(full, sizeof full, "%s",t1+1)) { fprintf(stderr, "all-waves: text too long for full\n"); exit(2); } }}else join(full,sizeof full,root,t1+1);add_input(j,full);}np_free(&r);}
static void hash_inputs(Job *j,char (*dst)[65]){for(int i=0;i<j->ninput;i++)if(as_sha_file(j->input[i],1,dst[i],0,why,sizeof why))die("input-hash",why);}
/* the first TAB-separated column of buf[at..e); 0 when the line has no such column */
static int col0(const char *buf,size_t at,size_t e,char *dst,size_t cap){size_t k=0;if(at>=e||buf[at]=='\t')return 0;while(at<e&&buf[at]!='\t'&&k+1<cap)dst[k++]=buf[at++];dst[k]=0;return k>0;}
/* Content snapshots include tracked (even missing) and untracked inputs. Only the
   append-only integration ledger is excluded; registry tables remain inputs.
   Unlike porcelain, this detects a second edit of an already dirty file. */
static int g_wt_scans;   /* full worktree measurements taken by this process; printed as evidence */
static char *wt_scan(const char *r, size_t *n, np_buf *buf) {
    g_wt_scans++;
    char *v[] = {"git", "-C", (char *)r, "ls-files", "-c", "-o", "--exclude-standard", "-z", 0};
    np_result x = {0}; char reason[1700] = {0};
    if (np_run(v,r,0,10,&x,reason,sizeof reason)||x.rc) die("worktree-unmeasured",reason);
    size_t at=0;
    while(at<x.outn){
        const char *rel=x.out+at;size_t z=strlen(rel);at+=z+1;
        if(!z||!strncmp(rel,"out/",4)||!strcmp(rel,"agentwork/ledger.tsv")||!strncmp(rel,"agentwork/ledger/",17))continue;
        if(strchr(rel,'\n')||strchr(rel,'\t'))die("worktree-path-wire",rel);
        char p[4400],h[65];struct stat st;
        join(p,sizeof p,r,rel);errno=0;
        np_puts(buf,"?? ");np_puts(buf,rel);np_puts(buf,"\t");
        if(lstat(p,&st)){
            if(errno!=ENOENT)die("worktree-stat",p);
            np_puts(buf,"ABSENT");
        }else if(S_ISLNK(st.st_mode)){
            char link[4400],target[4096];ssize_t k=readlink(p,link,sizeof link-1);
            if(k<0||(size_t)k>=sizeof link-1)die("worktree-link",p);link[k]=0;
            cx_sha256_hex(link,(size_t)k,h);np_puts(buf,h);np_puts(buf,"\t");
            if(!realpath(p,target)){
                if(errno!=ENOENT)die("worktree-link-target",p);
                np_puts(buf,"DANGLING");
            }else{
                if(as_tree(target,1,h,0,reason,sizeof reason))die("worktree-link-input",reason);
                np_puts(buf,h);
            }
        }else if(S_ISREG(st.st_mode)){
            if(as_sha_file(p,0,h,0,reason,sizeof reason))die("worktree-input",reason);
            np_puts(buf,h);
