 static const char *src[2]={"tools/all-waves.cx","tests/run-batch.cx"},*leaf[2]={"all-waves","run-batch"};char sha[2][65];long long each[2]={0,0},t0=as_now();
 for(int i=0;i<2;i++){char s[4400],d[4400],record[4400],name[80],reason[1200];join(s,sizeof s,root,src[i]);join(d,sizeof d,dir,leaf[i]);if(cx_fmt(name,sizeof name,"%s.stage",leaf[i]))die("executor-stage-path",leaf[i]);join(record,sizeof record,dir,name);
  if(part==2){size_t n;char *wire=as_read(record,0,&n,why,sizeof why);if(!wire||!n||wire[n-1]!='\n')die("executor-stage",record);wire[n-1]=0;char *f[4];long long created;if(as_split(wire,f,4)!=4||as_digits(f[1],&each[i])||strcmp(f[2],session)||as_digits(f[3],&created)||created!=m.created||as_sha_file(d,0,sha[i],0,why,sizeof why)||strcmp(f[0],sha[i]))die("executor-stage-changed",record);free(wire);continue;}
  if(part>=0&&part!=i)continue;struct stat st;errno=0;if(!lstat(d,&st)||errno!=ENOENT)die("executor-output-must-be-new",d);
  char *v[]={"sh",candidate,s,"-o",d,0};np_result r={0};long long a=as_now();if(np_run(v,root,0,25,&r,reason,sizeof reason))die("executor-compile-transport",reason);int ok=!r.rc;if(!ok){if(r.outn)fwrite(r.out,1,r.outn,stdout);if(r.errn)fwrite(r.err,1,r.errn,stderr);}np_free(&r);if(!ok)die("executor-compile",src[i]);each[i]=as_now()-a;if(as_sha_file(d,0,sha[i],0,why,sizeof why))die("executor-hash",why);
  as_ident post;if(as_identity(root,0,&post,why,sizeof why))die("live-identity",why);const char *diff=as_ident_diff(&post,&m.ident);if(diff)die("session-identity-changed-during-executor-compile",diff);
  if(part>=0){np_buf stage={0};np_puts(&stage,sha[i]);np_puts(&stage,"\t");np_putll(&stage,each[i]);np_puts(&stage,"\t");np_puts(&stage,session);np_puts(&stage,"\t");np_putll(&stage,m.created);np_puts(&stage,"\n");if(as_save_new(record,stage.p,stage.n,why,sizeof why))die("executor-stage-write",why);free(stage.p);printf("EXECUTOR_PART\tname=%s\tsha256=%s\tcompile_ns=%lld\tstate=PREPARED-not-registered\n",leaf[i],sha[i],each[i]);as_free(&m);close(lock);return 0;}
 }
 as_ident post;if(as_identity(root,0,&post,why,sizeof why))die("live-identity",why);const char *d=as_ident_diff(&post,&m.ident);if(d)die("session-identity-changed-during-executor-compile",d);
 np_buf b={0};np_puts(&b,"EXECUTOR\tall_waves=");np_puts(&b,sha[0]);np_puts(&b,"\trun_batch=");np_puts(&b,sha[1]);np_puts(&b,"\tcompile_ns=");np_putll(&b,part==2?each[0]+each[1]:as_now()-t0);np_puts(&b,"\n");
