}
/* Borrow bytes, index by path/full line, then emit in legacy after/before order.
   Existing output paths participate in indexed deduplication. No snapshot copies. */
typedef struct {const char *p;size_t n,path,seq;unsigned side,emit;} wt_line;
static int wt_bytes(const char *a,size_t an,const char *b,size_t bn){
    size_t n=an<bn?an:bn;int c=n?memcmp(a,b,n):0;
    return c?c:an<bn?-1:an>bn?1:0;
}
static int wt_order(const void *av,const void *bv){
    const wt_line *a=av,*b=bv;int c=wt_bytes(a->p,a->path,b->p,b->path);
    return c?c:wt_bytes(a->p,a->n,b->p,b->n);
}
static int wt_sequence(const void *av,const void *bv){
    const wt_line *a=av,*b=bv;return a->seq<b->seq?-1:a->seq>b->seq?1:0;
}
static int wt_diff(const char *a,size_t an,const char *b,size_t bn,np_buf *out){
    /* Identical bytes need neither an index nor output mutation. */
    if(an==bn&&(!an||!memcmp(a,b,an)))return 0;
    size_t count=0;
    for(int pass=0;pass<3;pass++){
        const char *s=pass==0?b:pass==1?a:out->p;size_t n=pass==0?bn:pass==1?an:out->n;
        for(size_t at=0;at<n;){
            if(count==(size_t)-1/sizeof(wt_line))die("worktree-index-size",0);
            count++;while(at<n&&s[at]!='\n')at++;if(at<n)at++;
        }
    }
    wt_line *lines=malloc(count*sizeof *lines);if(!lines)die("allocation",0);
    size_t used=0;
    for(int pass=0;pass<3;pass++){
        const char *s=pass==0?b:pass==1?a:out->p;size_t n=pass==0?bn:pass==1?an:out->n,at=0;
        while(at<n){size_t end=at,path=at;while(end<n&&s[end]!='\n')end++;
            if(pass==2)path=end;else while(path<end&&s[path]!='\t')path++;
            lines[used].p=s+at;lines[used].n=end-at;lines[used].path=path-at;
            lines[used].seq=used;lines[used].emit=0;lines[used].side=pass==2?4:pass==0?2:1;used++;at=end<n?end+1:end;
        }
    }
    qsort(lines,count,sizeof *lines,wt_order);
    size_t at=0;
    while(at<count){size_t first=at,best=count;int existing=0;
        while(at<count&&!wt_bytes(lines[first].p,lines[first].path,lines[at].p,lines[at].path)){
            size_t line=at;unsigned sides=0;
            do{sides|=lines[at].side;if(lines[at].side==4)existing=1;at++;}
            while(at<count&&!wt_order(&lines[line],&lines[at]));
            if((sides&3)!=3)for(size_t k=line;k<at;k++)if(lines[k].side!=4&&(best==count||lines[k].seq<lines[best].seq))best=k;
        }
        if(!existing&&best<count)lines[best].emit=1;
    }
    qsort(lines,count,sizeof *lines,wt_sequence);
    int moved=0;
    for(size_t k=0;k<count;k++)if(lines[k].emit){
        if(moved==2147483647)die("worktree-path-count",0);
        np_put(out,lines[k].p,lines[k].path);np_puts(out,"\n");moved++;
    }
    free(lines);return moved;
}
/* ---- wave domains -----------------------------------------------------------------------------
   tests/wave-domains.tsv says which batches may not share a wave.  One predicate for all four
   kinds: serial (no neighbour), wt (writes a shared path), hs (writes the harness trees), and
   mi:<name> (writes that material).  Absent = no constraint.  Placement keeps two batches apart
   when their masks intersect; the window only limits how many run at once. */
#define DOM_SERIAL 1ULL
#define DOM_WT 2ULL
#define DOM_HS 4ULL
#define DOM_USER 8ULL          /* first bit available to mi:<name> */
#define DOM_MAXM 61
static char g_dommat[DOM_MAXM][64];
static int g_ndommat;
static unsigned long long g_dommask[131];   /* indexed like argv order; set per wave */
/* the mask of ID from the table, or 0 when unlisted */
static unsigned long long domain_of(const char *tab, size_t tn, const char *id) {
    size_t at = 0;
    while (at < tn) {
        size_t e = at; char sid[128], dom[512];
        while (e < tn && tab[e] != '\n') e++;
        if (e > at && tab[at] != '#' && col0(tab, at, e, sid, sizeof sid) && !strcmp(sid, id)) {
            size_t d = at, k = 0; unsigned long long mask = 0;
            while (d < e && tab[d] != '\t') d++;      /* past the id */
            if (d < e) d++;
            while (d < e && tab[d] != '\t' && k + 1 < sizeof dom) dom[k++] = tab[d++];
            dom[k] = 0;
            {   size_t p = 0;
                while (dom[p]) {
                    char t[128]; size_t q = 0;
                    while (dom[p] && dom[p] != ',') { if (q + 1 < sizeof t) t[q++] = dom[p]; p++; }
                    t[q] = 0;
                    if (dom[p] == ',') p++;
                    if (!t[0]) continue;
                    if (!strcmp(t, "serial")) mask |= DOM_SERIAL;
                    else if (!strcmp(t, "wt")) mask |= DOM_WT;
                    else if (!strcmp(t, "hs")) mask |= DOM_HS;
                    else if (!strncmp(t, "mi:", 3) && t[3]) {
                        int m;
                        for (m = 0; m < g_ndommat; m++) if (!strcmp(g_dommat[m], t + 3)) break;
                        if (m == g_ndommat && g_ndommat < DOM_MAXM) { if (cx_fmt(g_dommat[g_ndommat], 64, "%s", t + 3)) die("domain material", "-"); m = g_ndommat++; }
                        if (m < DOM_MAXM) mask |= DOM_USER << m;
                    }
                } }
            return mask;
        }
        at = e + 1;
    }
    return 0;
}
static void spawn(Job *j,const char *wavedir,const as_manifest *m){ char *v[80];char storage[33][4400];int n=0,s=0;char secs[16];char native[4400],h[65],self[4096];{int z=snprintf(secs,sizeof secs,"%d",j->seconds);if(z<0||(size_t)z>=sizeof secs){fprintf(stderr,"bound-format\n");exit(2);}};
 if(m->has_executor){join(native,sizeof native,session,"executor/run-batch");if(as_sha_file(native,0,h,0,why,sizeof why)||strcmp(h,m->runner_sha))die("runner-sha-mismatch",native);}
 else{if(!realpath("/proc/self/exe",self))die("self-exe",session);{char *slash=strrchr(self,'/');if(!slash)die("self-exe",self);*slash=0;}join(native,sizeof native,self,"run-batch");if(as_sha_file(native,0,h,0,why,sizeof why))die("executor-run-batch-required",native);}
 v[n++]=bound;v[n++]="--status";v[n++]=j->status;v[n++]=secs;v[n++]=native;v[n++]=root;v[n++]=(char *)wavedir;v[n++]=j->b->id;
 if(!tx_eqz(j->b->materials, "-")){const char *q=j->b->materials;tp_material_decl d;while(tp_material_next(&q,&d)>0){const char *name=d.name;if(s==32)die("material-args",j->b->id);const as_material *x=as_find_material(m,name);if(!x||x->kind!=d.kind)die("material-unregistered-or-type",name);{int z=snprintf(storage[s],sizeof storage[s],"%s=%s",name,x->path);if(z<0||(size_t)z>=sizeof storage[s]){fprintf(stderr,"bound-format\n");exit(2);}};v[n++]=storage[s++];}}
 v[n]=0;j->t0=as_now();pid_t pid=fork();if(pid<0)die("fork",j->b->id);
 if(!pid){int o=open(j->out,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC|O_NOFOLLOW,0600);int e=open(j->err,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC|O_NOFOLLOW,0600);if(o<0||e<0||dup2(o,1)<0||dup2(e,2)<0||chdir(root))_exit(126);execv(bound,v);_exit(127);}
 j->pid=pid;
}
static int cmd_wave(int argc,char **argv){
