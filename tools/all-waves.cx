 as_registry_free(&reg);as_free(&m);close(lock);if(!identity_stable)return 2;return npass==count?0:1;
}
/* ---- split attempts ------------------------------------------------------------------------------ */
static void refuse_changed_session(const as_manifest *m){for(int i=0;i<m->nwave;i++)if(m->wave[i].changed)die("session-identity-changed-during-earlier-wave","start-a-new-session");}
static void die_why(void){char name[200];const char *t=strchr(why,'\t');size_t n=t?(size_t)(t-why):strlen(why);if(n>=sizeof name)n=sizeof name-1;{ void *cx_kept = memcpy(name,why,n); (void)cx_kept; }name[n]=0;die(name,t?t+1:"-");}
static int cmd_executor(int argc,char **argv){
 if(argc!=4)die("usage","executor ROOT SESSION");outer_window();canonical_root(argv[2]);existing_session(argv[3]);
 int lock=as_lock(session,1,why,sizeof why);if(lock<0)die("session-lock",why);as_manifest m;if(as_load(session,&m,why,sizeof why))die("session-manifest",why);as_ident live;check_identity(&m,&live);refuse_changed_session(&m);
 if(m.has_executor)die("executor-already-registered",session);
 char dir[4400];join(dir,sizeof dir,session,"executor");if(mkdir(dir,0700))die("executor-dir-must-be-new",dir);
 static const char *src[2]={"tools/all-waves.cx","tests/run-batch.cx"},*leaf[2]={"all-waves","run-batch"};char sha[2][65];long long each[2],t0=as_now();
 for(int i=0;i<2;i++){char s[4400],d[4400],reason[1200];join(s,sizeof s,root,src[i]);join(d,sizeof d,dir,leaf[i]);char *v[]={"sh",candidate,s,"-o",d,0};np_result r;long long a=as_now();
  if(np_run(v,root,0,25,&r,reason,sizeof reason))die("executor-compile-transport",reason);int ok=!r.rc;if(!ok&&r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);if(!ok)die("executor-compile",src[i]);each[i]=as_now()-a;if(as_sha_file(d,0,sha[i],0,why,sizeof why))die("executor-hash",why);}
 /* the compile must have read the session's candidate and harness trees */
 as_ident post;if(as_identity(root,0,&post,why,sizeof why))die("live-identity",why);const char *d=as_ident_diff(&post,&m.ident);if(d)die("session-identity-changed-during-executor-compile",d);
 np_buf b={0,0,0};np_puts(&b,"EXECUTOR\tall_waves=");np_puts(&b,sha[0]);np_puts(&b,"\trun_batch=");np_puts(&b,sha[1]);np_puts(&b,"\tcompile_ns=");np_putll(&b,as_now()-t0);np_puts(&b,"\n");
 char mp[4400];join(mp,sizeof mp,session,"session.tsv");int fd=open(mp,O_WRONLY|O_APPEND|O_CLOEXEC|O_NOFOLLOW);if(fd<0)die("manifest-open",mp);if(as_append(fd,session,"executor",m.seq+1,b.p,b.n,why,sizeof why))die("manifest-append",why);close(fd);free(b.p);
 printf("EXECUTOR\tall_waves=%s\tall_waves_compile_ns=%lld\trun_batch=%s\trun_batch_compile_ns=%lld\tdir=%s\tstate=PREPARED-startup-cache-not-a-result\n",sha[0],each[0],sha[1],each[1],dir);as_free(&m);close(lock);return 0;
}
static void urandom_hex(char out[65]){unsigned char raw[32];int fd=open("/dev/urandom",O_RDONLY|O_CLOEXEC);if(fd<0)die("urandom-open",0);size_t at=0;while(at<sizeof raw){ssize_t z=read(fd,raw+at,sizeof raw-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("urandom-read",0);at+=(size_t)z;}close(fd);cx_sha256_hex((const char *)raw,sizeof raw,out);}
static int cmd_start(int argc,char **argv){
 if(argc!=5)die("usage","start ROOT SESSION ID");outer_window();canonical_root(argv[2]);existing_session(argv[3]);const char *id=argv[4];
 int lock=as_lock(session,1,why,sizeof why);if(lock<0)die("session-lock",why);as_manifest m;if(as_load(session,&m,why,sizeof why))die("session-manifest",why);as_ident live;check_identity(&m,&live);refuse_changed_session(&m);
 if(!m.has_executor)die("executor-not-registered","run all-waves executor ROOT SESSION first");
 as_registry reg;if(as_registry_load(root,&reg,why,sizeof why))die("registry-metadata",why);const as_batch *b=as_find_batch(&reg,id);
 if(!b)die("unknown-batch",id);if(strcmp(b->impl,"IMPLEMENTED"))die("batch-not-implemented",id);if(strcmp(b->platform,"lnx/x86_64"))die("batch-needs-another-native-host",id);if(decided(&m,id))die("batch-already-decided-in-session",id);
 Job j;memset(&j,0,sizeof j);j.b=b;if(as_entry(root,b,&m,j.entry,why,sizeof why))die("batch-entry",why);char src[4400];join(src,sizeof src,root,b->source);add_input(&j,src);add_input(&j,j.entry);plan_inputs(&j);
 np_buf mat={0,0,0};
 if(strcmp(b->materials,"-")){const char *q=b->materials;tp_material_decl d;while(tp_material_next(&q,&d)>0){const char *name=d.name;const as_material *x=as_find_material(&m,name);if(!x||x->kind!=d.kind)die("material-unregistered-or-type",name);char fp[65];if(as_material_fp(x,fp,why,sizeof why)||strcmp(fp,x->fingerprint))die("material-changed-since-registration",name);
   np_puts(&mat,"material\t");np_puts(&mat,name);np_puts(&mat,"\t");np_puts(&mat,x->path);np_puts(&mat,"\t");np_puts(&mat,x->content);np_puts(&mat,"\t");np_puts(&mat,x->fingerprint);as_material_tag(&mat,x->kind);np_puts(&mat,"\n");}}
 j.before=calloc((size_t)j.ninput,sizeof *j.before);if(!j.before)die("allocation",0);hash_inputs(&j,j.before);
 char nonce[65],dir[64],base[4400],p[4400],leaf[200];urandom_hex(nonce);{ if (cx_fmt(dir,sizeof dir,"attempt-%.16s",nonce)) { fprintf(stderr, "all-waves: text too long for dir\n"); exit(2); } }join(base,sizeof base,session,dir);if(mkdir(base,0700))die("attempt-dir-must-be-new",base);
 np_buf s={0,0,0};np_puts(&s,"ALLATTEMPT\tv1\nbatch\t");np_puts(&s,id);np_puts(&s,"\nnonce\t");np_puts(&s,nonce);np_puts(&s,"\ndir\t");np_puts(&s,dir);np_puts(&s,"\nregistry_row_sha\t");np_puts(&s,b->row);np_puts(&s,"\ncandidate\t");np_puts(&s,live.candidate);np_puts(&s,"\nregistry\t");np_puts(&s,live.registry);
 np_puts(&s,"\nsid\t");np_puts(&s,live.sid);np_puts(&s,"\nharness\t");np_puts(&s,live.harness);np_puts(&s,"\nmaterials_map\t");np_puts(&s,m.map_sha);np_puts(&s,"\n");
 for(int i=0;i<j.ninput;i++){np_puts(&s,"input\t");np_puts(&s,j.input[i]);np_puts(&s,"\t");np_puts(&s,j.before[i]);np_puts(&s,"\n");}if(mat.n)np_put(&s,mat.p,mat.n);free(mat.p);np_puts(&s,"END\n");
 { if (cx_fmt(leaf,sizeof leaf,"%s.start",id)) { fprintf(stderr, "all-waves: text too long for leaf\n"); exit(2); } }join(p,sizeof p,base,leaf);save_new(p,s.p,s.n);char ssha[65];cx_sha256_hex(s.p,s.n,ssha);free(s.p);
 long long t=as_now();np_buf sb={0,0,0};np_puts(&sb,"START\tmode=split\tdir=");np_puts(&sb,dir);np_puts(&sb,"\tids=");np_puts(&sb,id);np_puts(&sb,"\tnonce=");np_puts(&sb,nonce);np_puts(&sb,"\tsnapshot=");np_puts(&sb,ssha);np_puts(&sb,"\tstart_ns=");np_putll(&sb,t);np_puts(&sb,"\n");
 char mp[4400];join(mp,sizeof mp,session,"session.tsv");int fd=open(mp,O_WRONLY|O_APPEND|O_CLOEXEC|O_NOFOLLOW);if(fd<0)die("manifest-open",mp);if(as_append(fd,session,"start",m.seq+1,sb.p,sb.n,why,sizeof why))die("manifest-append",why);close(fd);free(sb.p);
 printf("START\t%s\tattempt=%s\tdir=%s\tinputs=%d\tbudget=%d\tqualification=NOT_DECIDED_HERE\n",id,nonce,base,j.ninput,b->budget);
 printf("NEXT_RUN\t%s/tools/bound 58 %s/executor/all-waves run %s %s %s\n",root,session,root,session,id);
 printf("NEXT_FINISH\t%s/tools/bound 55 sh %s %s/tools/all-waves.cx -- finish %s %s %s %s\n",root,candidate,root,root,session,id,nonce);
 as_registry_free(&reg);as_free(&m);close(lock);return 0;
}
/* Native executor only.  The bound rc recorded here is the one this process observed with waitpid(). */
static int cmd_run(int argc,char **argv){
 if(argc!=5)die("usage","run ROOT SESSION ID");const char *id=argv[4];
 {const char *d=getenv("UNISACC_BOUND_DEADLINE_MONO");char *end=0;if(!d||!*d)die("outer-bound-required","run under tools/bound 58");deadline=strtod(d,&end);double left=deadline-now_s();if(!end||*end||left<=0||left>60.5)die("outer-bound-58-max-required",d);}
 double left_at_entry=deadline-now_s();canonical_root(argv[2]);existing_session(argv[3]);
 char self[4096],want[4400],rb[4400],h[65];join(want,sizeof want,session,"executor/all-waves");join(rb,sizeof rb,session,"executor/run-batch");if(!realpath("/proc/self/exe",self)||strcmp(self,want))die("run-requires-the-session-native-executor",want);
 int lock=as_lock(session,1,why,sizeof why);if(lock<0)die("session-lock",why);as_manifest m;if(as_load(session,&m,why,sizeof why))die("session-manifest",why);if(strcmp(m.root,root))die("session-root-mismatch",m.root);
 if(!m.has_executor)die("executor-not-registered",session);if(as_sha_file(want,0,h,0,why,sizeof why)||strcmp(h,m.exec_sha))die("executor-changed",want);if(as_sha_file(rb,0,h,0,why,sizeof why)||strcmp(h,m.runner_sha))die("executor-changed",rb);
 if(as_sha_file(candidate,0,h,0,why,sizeof why)||strcmp(h,m.ident.candidate))die("session-candidate-changed","start-a-new-session");refuse_changed_session(&m);
 const as_wave *w=0;for(int i=0;i<m.nwave;i++)if(!strcmp(m.wave[i].mode,"split")&&!strcmp(m.wave[i].ids,id)&&!m.wave[i].finished&&!m.wave[i].superseded)w=&m.wave[i];
 if(!w)die("attempt-not-started",id);if(w->run)die("attempt-already-run",w->nonce);
 as_registry reg;if(as_registry_load(root,&reg,why,sizeof why))die("registry-metadata",why);const as_batch *b=as_find_batch(&reg,id);if(!b||strcmp(b->impl,"IMPLEMENTED"))die("batch-not-implemented",id);
 char *v[48];char storage[33][4400];int n=0,s=0;char base[4400],out[4400],err[4400],status[4400],secs[16];join(base,sizeof base,session,w->dir);jobpath(out,base,id,"stdout");jobpath(err,base,id,"stderr");jobpath(status,base,id,"status");
 /* bound 58 has a hard deadline at +60.  Keep four seconds for waitpid,
    hashing and the RUN append; a prompt fork still grants the child all 55. */
 int seconds=55;{double avail=deadline-now_s()-4.0;if(avail<55)seconds=(int)avail;int need=b->budget<55?b->budget:55;if(seconds<need)die("run-window-below-budget","run under tools/bound 58");}{ if (cx_fmt(secs,sizeof secs,"%d",seconds)) { fprintf(stderr, "all-waves: text too long for secs\n"); exit(2); } }
 v[n++]=bound;v[n++]="--status";v[n++]=status;v[n++]=secs;v[n++]=rb;v[n++]=root;v[n++]=base;v[n++]=(char *)id;
 if(strcmp(b->materials,"-")){const char *q=b->materials;tp_material_decl d;while(tp_material_next(&q,&d)>0){const char *name=d.name;if(s==32)die("material-args",id);const as_material *x=as_find_material(&m,name);if(!x||x->kind!=d.kind)die("material-unregistered-or-type",name);char fp[65];if(as_material_fp(x,fp,why,sizeof why)||strcmp(fp,x->fingerprint))die("material-changed-since-registration",name);{ if (cx_fmt(storage[s],sizeof storage[s],"%s=%s",name,x->path)) { fprintf(stderr, "all-waves: text too long for storage[s]\n"); exit(2); } }v[n++]=storage[s++];}}
 v[n]=0;double left_at_fork=deadline-now_s();long long t0=as_now();pid_t pid=fork();if(pid<0)die("fork",id);
 if(!pid){int o=open(out,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC|O_NOFOLLOW,0600);int e=open(err,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC|O_NOFOLLOW,0600);if(o<0||e<0||dup2(o,1)<0||dup2(e,2)<0||chdir(root))_exit(126);execv(bound,v);_exit(127);}
 int st=0;pid_t got;do{got=waitpid(pid,&st,0);}while(got<0&&errno==EINTR);if(got!=pid)die("waitpid",id);long long t1=as_now();int bound_rc=WIFEXITED(st)?WEXITSTATUS(st):128+(WIFSIGNALED(st)?WTERMSIG(st):0);
 size_t on=0,en=0;char *o=as_read(out,0,&on,why,sizeof why),*e=as_read(err,0,&en,why,sizeof why);if(!o||!e)die("run-transcript",why);char oh[65],eh[65],sh[65]="ABSENT";cx_sha256_hex(o,on,oh);cx_sha256_hex(e,en,eh);free(o);free(e);
 struct stat ss;errno=0;int known=!lstat(status,&ss);if(!known&&errno!=ENOENT)die("status-file-stat",status);long long raw=0;
 if(known){size_t sn;char *sv=as_read(status,0,&sn,why,sizeof why);if(!sv)die("status-file",why);char *end=0;raw=strtol(sv,&end,10);if(end==sv||*end!='\n'||end[1]||raw<0)die("status-file-shape",status);cx_sha256_hex(sv,sn,sh);free(sv);}
