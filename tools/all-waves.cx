 printf("EXECUTOR\tall_waves=%s\tall_waves_compile_ns=%lld\trun_batch=%s\trun_batch_compile_ns=%lld\tdir=%s\tstate=PREPARED-startup-cache-not-a-result\n",sha[0],each[0],sha[1],each[1],dir);as_free(&m);close(lock);return 0;
}
static void urandom_hex(char out[65]){unsigned char raw[32];int fd=open("/dev/urandom",O_RDONLY|O_CLOEXEC);if(fd<0)die("urandom-open",0);size_t at=0;while(at<sizeof raw){ssize_t z=read(fd,raw+at,sizeof raw-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("urandom-read",0);at+=(size_t)z;}close(fd);cx_sha256_hex((const char *)raw,sizeof raw,out);}
static int cmd_start(int argc,char **argv){
 if(argc!=5)die("usage","start ROOT SESSION ID");outer_window();canonical_root(argv[2]);existing_session(argv[3]);const char *id=argv[4];
 int lock=as_lock(session,1,why,sizeof why);if(lock<0)die("session-lock",why);as_manifest m;if(as_load(session,&m,why,sizeof why))die("session-manifest",why);as_ident live;check_identity(&m,&live);refuse_changed_session(&m);
 if(!m.has_executor)die("executor-not-registered","run all-waves executor ROOT SESSION first");
