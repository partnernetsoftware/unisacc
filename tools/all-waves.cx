  for(int k=0;k<i;k++)if(tx_eqz(job[k].b->id, id))die("duplicate-batch",id);if(decided(&m,id))die("batch-already-decided-in-session",id);if(light&&!tx_eqz(b->materials, "-"))die("light-wave-requires-materials-free-batch",id);
  job[i].b=b;if(as_entry(root,b,&m,job[i].entry,why,sizeof why))die("batch-entry",why);char src[4400];join(src,sizeof src,root,b->source);add_input(&job[i],src);add_input(&job[i],job[i].entry);plan_inputs(&job[i]);
  if(!tx_eqz(b->materials, "-")){const char *q=b->materials;tp_material_decl d;while(tp_material_next(&q,&d)>0){const char *name=d.name;const as_material *x=as_find_material(&m,name);if(!x||x->kind!=d.kind)die("material-unregistered-or-type",name);char fp[65];if(as_material_fp(x,fp,why,sizeof why)||!tx_eqz(fp, x->fingerprint))die("material-changed-since-registration",name);}}
