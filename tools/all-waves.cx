 if(at+1<argc&&!strcmp(argv[at],"--tier")){select_tier(argv[at+1]);at+=2;}if(at>=argc)die("usage","wave selection missing");if(tx_eqz(argv[at], "--child-seconds")){if(at+2>=argc)die("usage","--child-seconds N");cap_seconds=atoi(argv[at+1]);if(cap_seconds<1||cap_seconds>55)die("child-seconds-range",argv[at+1]);at+=2;}
 int heavy=!strcmp(argv[at],"--heavy"),light=!strcmp(argv[at],"--light");if(!heavy&&!light)die("usage","--light or --heavy");at++;int count=argc-at;if(count<1||count>WAVE_JOBS_MAX)die("wave-shape","light-or-heavy-takes-one-to-WAVE_JOBS_MAX-ids");
 /* Selection may omit a known batch, but must not hide a misspelled ID. */
 if(tier_filter){as_registry selected_reg;if(as_registry_load(root,&selected_reg,why,sizeof why))die("registry-metadata",why);
  for(int i=at;i<argc;i++)if(!as_find_batch(&selected_reg,argv[i]))die("unknown-batch",argv[i]);
  as_registry_free(&selected_reg);}
 if(tier_filter){int kept=0;for(int i=at;i<argc;i++)if(tier_selected(argv[i]))argv[at+kept++]=argv[i];count=kept;argc=at+kept;if(!count){printf("WAVE_SELECTION\ttier=%s\tselected=0\n",tier_filter);return 0;}}
 int lock=as_lock(session,1,why,sizeof why);if(lock<0)die("session-lock",why);as_manifest m;if(as_load(session,&m,why,sizeof why))die("session-manifest",why);as_ident live;check_identity(&m,&live);
 for(int i=0;i<m.nwave;i++)if(m.wave[i].changed)die("session-identity-changed-during-earlier-wave","start-a-new-session");
