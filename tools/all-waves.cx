 {int done[131];memset(done,0,sizeof done);int next_launch=0,active=0,left=count;
  while(left){int launched=0;
   while(active<active_max&&next_launch<count){int j2=next_launch;unsigned long long busy=0;int k2,free_slot=1;
    for(k2=0;k2<count;k2++)if(!done[k2]&&job[k2].pid>0&&!job[k2].t1&&k2!=j2)busy|=g_dommask[k2];
