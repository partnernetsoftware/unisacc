/* speed-probe: installed-product timings. JOBS.tsv is NAME<TAB>ARGV, split on spaces/tabs.
 * Usage: cx tools/speed-probe.cx -- JOBS.tsv OUTDIR
 * Saves complete stderr in NAME.rr and measurements in per-object.tsv.
 * total_ms/wall_ns are observed spawn-to-exit/capture, not a partial phase sum.
 * Repeated inference phases and model loading are summed separately in ns.
 * Missing observations are UNMEASURED; a measured zero stays zero.
 * Inherits the caller's model/run-cache policy. Use fresh -o for artifact-cold input;
 * RUN_CACHE=0 also disables model caches and must be labelled as a separate observation.
 */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use text.text
#pragma unisa use text.num
#pragma unisa use sys.time
#pragma unisa use sysx.run
#pragma unisa use sys.posix
#pragma unisa use mem.bytes

#define LINE (1L << 16)
#define OUTCAP (1L << 20)

static char path_line[LINE];
static char rrtmp[OUTCAP];

static int die(const char *m) { printf("speed-probe: %s\n", m); return 2; }

/* The pipe helper bounds the child; all stderr is persisted before parsing. */
static int run_job(const char *name,char *argvline,const char *rrpath,long *wall){
    char *argv[64];int i=0,k=0,ofd,efd,pid,ex=0,code=0,sig=0;long n=0,r;char chunk[4096];sy_ts_t begin,end;
    argv[i++]="env";argv[i++]="UNISACC_RR_TIME=1";argv[i++]="sh";argv[i++]="./unisacc.com";
    while(argvline[k]&&i<62){while(argvline[k]==' '||argvline[k]=='\t')k++;if(!argvline[k])break;
        argv[i++]=argvline+k;while(argvline[k]&&argvline[k]!=' '&&argvline[k]!='\t')k++;if(argvline[k])argvline[k++]=0;}
    argv[i]=0;*wall=-1;rrtmp[0]=0;if(sy_mono(&begin))return -1;
    pid=px_spawn_spool(argv,0,SY_SPAWN_STDERR_SPLIT,&ofd,&efd);if(pid<0)return -1;
    int waited=sy_wait_status(pid,0,&ex,&code,&sig)==pid;
    if(!sy_mono(&end))*wall=(end.sec-begin.sec)*1000000000L+end.nsec-begin.nsec;
    while(sy_read(ofd,chunk,sizeof chunk)>0){}sy_close(ofd);
    int fd=sy_open(rrpath,O_WRONLY|O_CREAT|O_TRUNC|O_CLOEXEC,0600),bad=fd<0,overflow=0;
    while((r=sy_read(efd,chunk,sizeof chunk))>0){
        if(fd>=0&&sy_write_all(fd,chunk,r))bad=1;
        if(!overflow){if(r>=OUTCAP-n||mm_copy(rrtmp+n,OUTCAP-n,chunk,(size_t)r))overflow=1;else n+=r;}
    }
    if(r<0)bad=1;rrtmp[n]=0;sy_close(efd);if(fd>=0&&sy_close(fd))bad=1;
    if(bad||overflow){fprintf(stderr,"speed-probe: %s raw timing %s: %s\n",name,overflow?"exceeds parser capacity":"write failed",rrpath);return -1;}
    if(!waited)return -1;return ex?code:128+sig;
}

/* Sum all matching invocations; -1 means no observation, not measured zero. */
static long timing_ns(const char *s,const char *category,const char *stage){
    char prefix[80];if(cx_fmt(prefix,sizeof prefix,"RR_TIME\t%s\t",category))return -1;
    long n=tx_len(s,OUTCAP),at=0,total=0,seen=0,plen=strlen(prefix);
    while(at<n){long e=at;while(e<n&&s[e]!='\n')e++;
        if(e-at>=plen&&!memcmp(s+at,prefix,(size_t)plen)){
            int match=stage==0;
            if(stage){long p=tx_find(s+at,e-at,"\tstage=",7);if(p>=0){p+=at+7;long q=p;while(q<e&&s[q]!='\t')q++;
                match=(long)strlen(stage)==q-p&&!memcmp(s+p,stage,(size_t)(q-p));}}
            long v=match?tx_find(s+at,e-at,"\tns=",4):-1;
            if(v>=0){v+=at+4;long acc=0,start=v;while(v<e&&s[v]>='0'&&s[v]<='9')acc=acc*10+s[v++]-'0';
                if(v>start&&(v==e||s[v]=='\t')){total+=acc;seen=1;}}
        }at=e+1;
    }return seen?total:-1;
}

/* 1 when the last "RR_TIME<TAB>artifact_hit=N" line says the product reused a cached artifact (no stages ran) */
static int artifact_hit(const char *s) {
    long n = tx_len(s, OUTCAP), at = 0; int hit = 0;
    while (at < n) {
        long e = at;
        while (e < n && s[e] != '\n') e++;
        if (tx_prefix(s + at, e - at, "RR_TIME\tartifact_hit=", 21) && e - at > 21) hit = s[at + 21] == '1';
        at = e + 1;
    }
    return hit;
}

typedef struct{char name[64];long total,ns[8],model,inference;int code,hit;}row;
static row rows[256];
static const char *stage_keys[]={"e1","e2","e3","units","prune","lower","elf","tapecheck"};
static void number(FILE *f,long ns,int ms){if(ns<0)fprintf(f,"UNMEASURED");else fprintf(f,"%ld",ms?ns/1000000:ns);}
static void print_row(FILE *f,const row *r){
    fprintf(f,"%s\t",r->name);number(f,r->total,1);fputc('\t',f);number(f,r->ns[5],1);fputc('\t',f);
    number(f,r->ns[6],1);fputc('\t',f);number(f,r->ns[7],1);fprintf(f,"\t%d",r->code);
    for(int j=0;j<8;j++){fputc('\t',f);number(f,r->ns[j],0);}fputc('\t',f);number(f,r->model,0);
    fputc('\t',f);number(f,r->inference,0);fputc('\t',f);number(f,r->total,0);fprintf(f,"\t%d\n",r->hit);
}

int main(int argc,char **argv){
    if(argc<2)return die("usage: -- JOBS.tsv OUTDIR");
    const char *jobs=argv[1],*outdir=argc>2?argv[2]:sy_tmpdir();long jn=0;char *jb=cx_read(jobs,&jn);
    if(!jb||jn>=LINE){free(jb);return die("cannot read jobs file");}
    if(mm_copy(path_line,sizeof path_line,jb,(size_t)jn)){free(jb);return 2;}path_line[jn]=0;free(jb);
    int mkdir_rc=sy_mkdir(outdir,0700);if(mkdir_rc&&mkdir_rc!=-EEXIST)return die("cannot create output directory");
    int nr=0;long at=0;
    while(at<jn&&nr<256){long e=at;while(e<jn&&path_line[e]!='\n')e++;
        if(e>at){long t=tx_find(path_line+at,e-at,"\t",1);
            if(t>0){
                if(t>=64)return die("job name exceeds bound");
                if(mm_copy(rows[nr].name,sizeof rows[nr].name,path_line+at,(size_t)t))return 2;rows[nr].name[t]=0;
                if(strchr(rows[nr].name,'/')||!strcmp(rows[nr].name,".")||!strcmp(rows[nr].name,".."))return die("job name must be a filename");
                char arg[LINE],rawpath[4400];long al=e-at-t-1;
                if(mm_copy(arg,sizeof arg,path_line+at+t+1,(size_t)al))return 2;arg[al]=0;
                if(cx_fmt(rawpath,sizeof rawpath,"%s/%s.rr",outdir,rows[nr].name))return die("raw output path exceeds bound");
                rows[nr].code=run_job(rows[nr].name,arg,rawpath,&rows[nr].total);
                for(int j=0;j<8;j++)rows[nr].ns[j]=timing_ns(rrtmp,"inference",stage_keys[j]);
                rows[nr].model=timing_ns(rrtmp,"model",0);rows[nr].inference=timing_ns(rrtmp,"inference",0);
                rows[nr].hit=artifact_hit(rrtmp);nr++;
            }
        }at=e+1;
    }
    char tablepath[4400];if(cx_fmt(tablepath,sizeof tablepath,"%s/per-object.tsv",outdir))return die("table path exceeds bound");
    FILE *table=fopen(tablepath,"wb");if(!table)return die("cannot write per-object.tsv");
    const char *header="per-object\ttotal_ms\tlower_ms\telf_ms\ttapecheck_ms\trc\te1_ns\te2_ns\te3_ns\tunits_ns\tprune_ns\tlower_ns\telf_ns\ttapecheck_ns\tmodel_ns\tinference_ns\twall_ns\tartifact_hit\n";
    fputs(header,stdout);fputs(header,table);
    for(int i=0;i<nr;i++){print_row(stdout,&rows[i]);print_row(table,&rows[i]);}
    int table_bad=ferror(table);if(fclose(table))table_bad=1;if(table_bad)return die("per-object.tsv write failed");
    int used[256];for(int i=0;i<nr;i++)used[i]=0;
    printf("\ntop10\ttotal_ms\tlower_ms\telf_ms\ttapecheck_ms\n");
    for(int k=0;k<10&&k<nr;k++){
        int best=-1;for(int i=0;i<nr;i++)if(!used[i]&&(best<0||rows[i].total>rows[best].total))best=i;
        if(best<0)break;used[best]=1;printf("%d\t%s\t",k+1,rows[best].name);number(stdout,rows[best].total,1);
        for(int j=5;j<8;j++){fputc('\t',stdout);number(stdout,rows[best].ns[j],1);}fputc('\n',stdout);
    }
    for(int i=0;i<nr;i++)if(rows[i].hit)printf("NOTE\t%s\tartifact_hit=1\tmissing phases remain UNMEASURED; use fresh -o for artifact-cold measurement\n",rows[i].name);
    return 0;
}
