/* Direct generated facts API contract, independent of generator execution. */
#pragma unisa use cxlib.chainfacts
#pragma unisa use text.text
static int phase_at(const char *name){for(int i=0;i<cf_p3_count();i++)if(!strcmp(cf_p3_phase(i),name))return i;return -1;}
int main(void){int failed=0;
if(!(cf_root_count()==44&&cf_p3_count()==47&&cf_net_count()==42&&cf_tool_count()==5))failed++;
if(!(!strcmp(cf_root_key(0),"drive.o")&&!strcmp(cf_root_source(0),"src/unisacc.cx")&&!strcmp(cf_root_key(cf_root_count()-1),"drivestream.o")&&!strcmp(cf_p3_phase(0),"guard-init")&&!strcmp(cf_p3_phase(cf_p3_count()-1),"assemble")))failed++;
if(!(!cf_root_key(-1)&&!cf_root_source(cf_root_count())&&!cf_p3_phase(cf_p3_count())))failed++;
/* Order: every guard, then the opguard phases (prep, one per ISA), then models. The kernel
   base verdicts are sealed before any model bytes are produced. */
{int last_guard=-1,first_op=cf_p3_count(),last_op=-1,ops=0,models=phase_at("models");
for(int i=0;i<cf_p3_count();i++){const char *p=cf_p3_phase(i);if(!strncmp(p,"guard-",6))last_guard=i;if(!strncmp(p,"opguard-",8)){ops++;if(i<first_op)first_op=i;last_op=i;}}
if(!(last_guard==cf_p3_guard_count()&&first_op==last_guard+1&&ops==3&&last_op==first_op+ops-1&&models==last_op+1&&models<phase_at("resources")&&phase_at("resources")<phase_at("assemble")))failed++;
if(!(phase_at("opguard-prep")==first_op&&phase_at("opguard-x86_64")>first_op&&phase_at("opguard-arm64")>first_op&&phase_at("opguard-x86_64")!=phase_at("opguard-arm64")&&phase_at("opguard")<0))failed++;}
printf("CHECK_CHAINFACTS\tfailed=%d\n",failed);return failed?1:0;}
