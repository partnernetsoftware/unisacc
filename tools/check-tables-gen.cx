/* tools/check-tables-gen.cx -- tools/tables-gen.cx on a private fixture root (real tables untouched).
 *
 *   sh ./unisacc.com tools/check-tables-gen.cx
 *
 *  (1) manifest rows all in the tables: --check exits 0 and counts the legacy row;
 *  (2) coverage row with other content: exit 1, STALE naming tests/coverage.tsv;
 *  (3) compile row absent: exit 1, MISSING naming tests/tools-compile-sources.tsv;
 *  (4) --write replaces the stale row, appends the missing batch row, inserts the compile row in byte order,
 *      keeps the legacy rows; --check then exits 0;
 *  (5) a malformed manifest exits 2 and --write changes nothing;
 *  (6) --write with --index is refused (exit 2);
 *  (7) precommit: a staged manifest whose compile row is not in the staged table is BLOCKED; with it, passes.
 * Prints PASS/FAIL per case and CHECK_TABLES_GEN<TAB>failed=N; exit 0 only when 0. */
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.io
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use mem.heap

static int failed;
static char *out_buf;
static size_t out_n;

static void ck(int ok, const char *name) {
    if (!ok) failed++;
    sy_printf("%s\ttables-gen.%s\n", ok ? "PASS" : "FAIL", name);
}
static void fatal(const char *what) {
    sy_printf("check-tables-gen: %s\nCHECK_TABLES_GEN\tfailed=%d\n", what, failed + 1);
    exit(1);
}
static int run(const char *mode, const char *extra, const char *root) {
    char *v[16]; int k = 0;
    mm_free(out_buf); out_buf = 0; out_n = 0;
    v[k++] = "sh"; v[k++] = "-c"; v[k++] = "exec \"$@\" 2>&1"; v[k++] = "sh";
    v[k++] = "sh"; v[k++] = "./unisacc.com"; v[k++] = "tools/tables-gen.cx"; v[k++] = "--";
    v[k++] = (char *)mode; if (extra) v[k++] = (char *)extra; v[k++] = "--root"; v[k++] = (char *)root; v[k] = 0;
    return cx_runv_timeout(v, 50, &out_buf, &out_n);
}
static int shq(const char *cmd) {
    char *v[] = {"sh", "-c", (char *)cmd, 0}; mm_free(out_buf); out_buf = 0; out_n = 0;
    return cx_runv_timeout(v, 55, &out_buf, &out_n);
}
static int has(const char *w) { return out_buf && tx_find(out_buf, (long)out_n, w, tx_len(w, 256)) >= 0; }
static void mkd(const char *d) { int rc = sy_mkdir(d, 0755); if (rc != 0 && rc != -EEXIST) fatal("mkdir"); }
static void put(const char *root, const char *rel, const char *text) {
    char p[800]; int fd;
    if (cx_fmt(p, sizeof p, "%s/%s", root, rel)) fatal("path");
    fd = sy_open(p, O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (fd < 0) fatal("cannot write fixture");
    sy_write_all(fd, text, tx_len(text, 100000));
    sy_close(fd);
}
static int file_is(const char *root, const char *rel, const char *want) {
    char p[800]; size_t n = 0, wl = strlen(want); char *b; int ok;
    if (cx_fmt(p, sizeof p, "%s/%s", root, rel)) fatal("path");
    b = (char *)cx_read(p, &n);
    ok = b && n == wl && !memcmp(b, want, wl);
    mm_free(b);
    return ok;
}

#define LEG "old\tIMPLEMENTED\tl\to.cx\tSOURCE\tp\t55\t-\to.cx\t-\tl.old\trc0:OLD\tproduct\tcommit\n"
#define BROW "fx\tIMPLEMENTED\tl\ttools/check-fx.cx\tSOURCE\tp\t55\t-\ttools/check-fx.cx\t-\tl.fx\trc0:FX\tproduct\tcommit\n"
#define CROW "l.fx\tl\tIMPLEMENTED_SEPARATE_BATCH\ttext\tfiles\n"
#define CBAD "l.fx\tl\tIMPLEMENTED_SEPARATE_BATCH\tother\tfiles\n"
#define SROW "tools/check-fx.cx\tregular\n"
#define SA "tools/a.cx\tregular\n"
#define SZ "tools/z.cx\tregular\n"
static const char *MAN = "batch\t" BROW "coverage\t" CROW "packages\tbatch\tfx\tall\t-\t-\t-\t-\t-\t-\n" "compile\t" SROW;

static void pc_cases(void) {
    char td[400], cwd[400], cmd[2400]; char *o = 0; size_t n = 0; int rc, i; char *v[] = {"pwd", 0};
    if (cx_runv_timeout(v, 10, &o, &n) != 0 || n < 2 || n >= sizeof cwd) fatal("pwd");
    mm_copy(cwd, sizeof cwd, o, n); cwd[n] = 0; for (i = 0; cwd[i]; i++) if (cwd[i] == '\n') cwd[i] = 0;
    if (cx_fmt(td, sizeof td, "%s/tg-pc-XXXXXX", sy_tmpdir()) || !mkdtemp(td)) fatal("tmpdir");
    if (cx_fmt(cmd, sizeof cmd, "cd '%s' && git init -q . && git config user.email a@b && git config user.name t && mkdir -p tests/manifests build && "
               "ln -s '%s/unisacc.com' unisacc.com && ln -s '%s/tools' tools && ln -s '%s/cx' cx && ln -s '%s/cxroot.tsv' cxroot.tsv", td, cwd, cwd, cwd, cwd) || shq(cmd)) fatal("pc fixture");
    put(td, "tests/batches.tsv", "id\n" BROW);
    put(td, "tests/coverage.tsv", "id\n" CROW);
    put(td, "tests/tools-compile-sources.tsv", SA);   /* compile row absent on purpose */
    put(td, "build/batch-packages.tsv", "# h\n" "batch\tfx\tall\t-\t-\t-\t-\t-\t-\n");
    if (cx_fmt(cmd, sizeof cmd, "cd '%s' && git add tests build && git commit -q --no-verify -m base", td) || shq(cmd)) fatal("pc base");
    put(td, "tests/manifests/fx.tsv", MAN);
    if (cx_fmt(cmd, sizeof cmd, "cd '%s' && git add tests/manifests/fx.tsv && sh ./unisacc.com tools/precommit.cx 2>&1", td)) fatal("c");
    rc = shq(cmd); ck(rc == 1 && has("BLOCKED generated registration table MISSING\ttests/tools-compile-sources.tsv\ttools/check-fx.cx"), "precommit-compile-row-missing-refused");
    put(td, "tests/tools-compile-sources.tsv", SA SROW);
    if (cx_fmt(cmd, sizeof cmd, "cd '%s' && git add tests/tools-compile-sources.tsv && sh ./unisacc.com tools/precommit.cx 2>&1", td)) fatal("c");
    rc = shq(cmd); ck(rc == 0 && !has("BLOCKED generated registration table"), "precommit-tables-match-manifest-passes");
    if (cx_fmt(cmd, sizeof cmd, "rm -rf '%s'", td) || shq(cmd)) fatal("cleanup");
}

int main(void) {
    char root[600], d[800], cmd[900]; int rc;
    if (cx_fmt(root, sizeof root, "%s/check-tables-gen-%d", sy_tmpdir(), sy_pid())) fatal("root");
    mkd(root);
    if (cx_fmt(d, sizeof d, "%s/tests", root)) fatal("d"); mkd(d);
    if (cx_fmt(d, sizeof d, "%s/tests/manifests", root)) fatal("d"); mkd(d);
    put(root, "tests/manifests/fx.tsv", MAN);

    put(root, "tests/batches.tsv", "id\n" LEG BROW);
    put(root, "tests/coverage.tsv", "id\n" CROW);
    put(root, "tests/tools-compile-sources.tsv", SA SROW SZ);
    rc = run("--check", 0, root); ck(rc == 0 && has("manifests=1\tstale=0\twritten=0\tlegacy=1\thard=0"), "complete-pass-counts-legacy");

    put(root, "tests/coverage.tsv", "id\n" CBAD);
    rc = run("--check", 0, root); ck(rc == 1 && has("STALE\ttests/coverage.tsv\tl.fx"), "stale-coverage-refused");
    ck(file_is(root, "tests/coverage.tsv", "id\n" CBAD), "check-does-not-write");

    put(root, "tests/coverage.tsv", "id\n" CROW);
    put(root, "tests/tools-compile-sources.tsv", SA SZ);
    rc = run("--check", 0, root); ck(rc == 1 && has("MISSING\ttests/tools-compile-sources.tsv\ttools/check-fx.cx"), "missing-compile-refused");

    put(root, "tests/batches.tsv", "id\n" LEG);
    put(root, "tests/coverage.tsv", "id\n" CBAD);
    rc = run("--write", 0, root); ck(rc == 0 && has("stale=3\twritten=3"), "write-regenerates-three");
    ck(file_is(root, "tests/batches.tsv", "id\n" LEG BROW), "write-appends-batch-keeps-legacy");
    ck(file_is(root, "tests/coverage.tsv", "id\n" CROW), "write-replaces-stale-in-place");
    ck(file_is(root, "tests/tools-compile-sources.tsv", SA SROW SZ), "write-inserts-compile-in-byte-order");
    rc = run("--check", 0, root); ck(rc == 0, "check-after-write");

    put(root, "tests/coverage.tsv", "id\n" CBAD);
    put(root, "tests/manifests/fx.tsv", "batch\tfx\tonly\ncoverage\t" CROW);
    rc = run("--write", 0, root); ck(rc == 2 && has("MALFORMED\tfx.tsv"), "malformed-manifest-exit2");
    ck(file_is(root, "tests/coverage.tsv", "id\n" CBAD), "malformed-manifest-writes-nothing");
    put(root, "tests/manifests/fx.tsv", "batch\t" BROW);
    rc = run("--check", 0, root); ck(rc == 2 && has("need batch and coverage lines"), "manifest-without-coverage-exit2");
    put(root, "tests/manifests/fx.tsv", MAN);
    rc = run("--write", "--index", root); ck(rc == 2 && has("usage"), "write-with-index-refused");
    /* a table that is not there: hard error when a manifest row needs it, nothing to do when no manifest exists */
    if (cx_fmt(cmd, sizeof cmd, "rm -f '%s/tests/tools-compile-sources.tsv'", root) || shq(cmd)) fatal("rm table");
    rc = run("--check", 0, root); ck(rc == 2 && has("MALFORMED\ttests/tools-compile-sources.tsv\ttable unreadable"), "needed-table-absent-exit2");
    if (cx_fmt(cmd, sizeof cmd, "rm -f '%s/tests/manifests/fx.tsv'", root) || shq(cmd)) fatal("rm manifest");
    rc = run("--check", 0, root); ck(rc == 0 && has("manifests=0\tstale=0"), "no-manifest-absent-table-passes");

    pc_cases();
    if (cx_fmt(cmd, sizeof cmd, "rm -rf '%s'", root) || shq(cmd)) fatal("cleanup");
    sy_printf("CHECK_TABLES_GEN\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
