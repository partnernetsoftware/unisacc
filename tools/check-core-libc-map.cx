/* tools/check-core-libc-map.cx -- verification and tamper mutation check for tools/core-libc-map.cx.
 *
 *   sh ./unisacc.com tools/check-core-libc-map.cx
 *
 * Verifies:
 *   (1) repo build/core-libc-map.tsv matches tools/core-libc-map.cx --check (rc=0, CORE_LIBC_MAP OK);
 *   (2) table contains expected core mappings: cx/mem/heap.cx -> malloc/calloc/realloc/free, cx/text/fmt.cx -> vsnprintf;
 *   (3) tampered copy of build/core-libc-map.tsv is rejected with rc=1 and CORE_LIBC_MAP DIFF.
 * Prints PASS/FAIL lines and CHECK_CORE_LIBC_MAP<TAB>passed=N<TAB>failed=M; exits 0 iff failed == 0. */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sysx.process
#pragma unisa use text.text

static int passed, failed;

static void ck(int ok, const char *name) {
    if (ok) passed++; else failed++;
    sy_printf("%s\tcore-libc-map.%s\n", ok ? "PASS" : "FAIL", name);
}

static int has_row(const char *buf, long n, const char *file, const char *sym) {
    long i = 0, fl = (long)tx_len(file, 128), sl = (long)tx_len(sym, 128);
    while (i < n) {
        long a = i, b;
        while (i < n && buf[i] != '\n') i++;
        b = i; if (i < n) i++;
        if (b <= a || buf[a] == '#') continue;
        long t1 = a; while (t1 < b && buf[t1] != '\t') t1++;
        long t2 = t1 + 1; while (t2 < b && buf[t2] != '\t') t2++;
        long t3 = t2 + 1; while (t3 < b && buf[t3] != '\t') t3++;
        if (t1 - a == fl && t3 - (t2 + 1) == sl &&
            tx_prefix(buf + a, fl, file, fl) && tx_prefix(buf + t2 + 1, sl, sym, sl)) return 1;
    }
    return 0;
}

int main(void) {
    np_result r;
    char why[256];
    char *av1[] = {"sh", "./unisacc.com", "tools/core-libc-map.cx", "--", "--check", 0}; /* lint:allow R1 invokes tool under test */
    int rc1 = np_run(av1, ".", 0, 50, &r, why, sizeof why);
    ck(rc1 == 0 && r.rc == 0 && r.out && tx_find(r.out, (long)r.outn, "CORE_LIBC_MAP\tOK\t", 17) >= 0, "repo-table-check-ok");
    np_free(&r);

    size_t tn = 0;
    char *tb = cx_read("build/core-libc-map.tsv", &tn);
    ck(tb != 0 && tn > 100, "repo-table-readable");
    if (tb) {
        ck(has_row(tb, (long)tn, "cx/mem/heap.cx", "malloc") &&
           has_row(tb, (long)tn, "cx/mem/heap.cx", "calloc") &&
           has_row(tb, (long)tn, "cx/mem/heap.cx", "realloc") &&
           has_row(tb, (long)tn, "cx/mem/heap.cx", "free"), "heap-has-allocators");
        ck(has_row(tb, (long)tn, "cx/text/fmt.cx", "vsnprintf"), "fmt-has-vsnprintf");

        char dir[4096], badf[4200];
        if (cx_fmt(dir, sizeof dir, "%s/check-clm-XXXXXX", sy_env_or("TMPDIR", "/tmp")) || !mkdtemp(dir) ||
            cx_fmt(badf, sizeof badf, "%s/tampered.tsv", dir)) {
            ck(0, "mut-tamper-setup");
        } else {
            /* drop last line to simulate missing mapping */
            long cut = (long)tn - 2;
            while (cut > 0 && tb[cut] != '\n') cut--;
            cx_write(badf, tb, (size_t)(cut + 1));
            char *av2[] = {"sh", "./unisacc.com", "tools/core-libc-map.cx", "--", "--check", "--table", badf, 0}; /* lint:allow R1 tamper mutation test */
            int rc2 = np_run(av2, ".", 0, 50, &r, why, sizeof why);
            ck(rc2 == 0 && r.rc == 1 && r.out && tx_find(r.out, (long)r.outn, "CORE_LIBC_MAP\tDIFF\t", 19) >= 0, "mut-tampered-table-rejected");
            np_free(&r);
            cx_rmtree(dir);
        }
        free(tb);
    }

    sy_printf("CHECK_CORE_LIBC_MAP\tpassed=%d\tfailed=%d\n", passed, failed);
    return failed ? 1 : 0;
}
