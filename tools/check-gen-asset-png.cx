/* tools/check-gen-asset-png.cx -- 转调 gen-asset-png 无 --write.
 * sh ./unisacc.com tools/check-gen-asset-png.cx --
 */
int main(void) {
    char *av[5];
    char *out = 0;
    size_t n = 0;
    int rc;
    av[0] = "sh"; av[1] = "./unisacc.com"; av[2] = "tools/gen-asset-png.cx"; av[3] = "--"; av[4] = 0;
    rc = cx_runv_timeout(av, 20, &out, &n);
    if (out && n) fwrite(out, 1, n, stdout);
    if (out) free(out);
    return rc == 0 ? 0 : 1;
}
