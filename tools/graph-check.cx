/* tools/graph-check.cx -- machine check of the construction graph build/graph.tsv (read-only).
 *
 *   sh ./unisacc.com tools/graph-check.cx [-- [--graph F] [--chain F] [--hardwire F] [--no-hardwire] [--route F] [--no-route]]
 *
 * (a) structure: 12 named columns; kind in the fixed enumeration; every depends_on entry exists
 *     (a trailing * expands to every node with that prefix, "-" is none); no cycle; budget_s is an
 *     integer 1..60 (one child process; aggregate nodes carry per-step bounds); root_dependent is
 *     yes|no and a product kind (tool gen tbl net route p4 fixedpoint kernel pack install) marked yes
 *     is a FAIL row "root_dependent" (products must not depend on the physical build root).
 * (b) order: the six targets in first-appearance order of column 3 (shared/all excluded) are the
 *     fixedpoint phase order; they must equal the three copies in tools/chain-step.cx
 *     (cs_target[6], cs_fp_slices[6] and the i == 0 ? ... ternary chain) -- each differing copy is
 *     one ORDER_MISMATCH row naming file:line.  build/order-domains.tsv (--domains F) may pin a constant
 *     as a frozen exception (frozen_order = its exact six-target list, e.g. cs_target, whose order is part
 *     of the published routes/compiler.pkg bytes): that constant is compared with frozen_order instead of
 *     the graph and a difference is a FROZEN_ORDER_CHANGED row (counted in order_mismatch).  Undeclared
 *     constants, or a missing table, compare strictly with the graph.  Prints ORDER_DOMAINS declared=N frozen=M.
 * (c) hardwire: every row of build/hardwire.tsv (file, literal pattern) is scanned line by line;
 *     each hit is HARDWIRE<TAB>file:line<TAB>id:pattern.  Report only, not a gate in this step.
 * (d) route: per target, the gen1 slice phases the chain driver tools/candidate-chain.cx (--route F)
 *     really runs must be the ones the graph declares.  The graph is the truth: slice-phase nodes
 *     gen1.TARGET.PHASE (front0..2 count as front).  The chain side is read from its source: every
 *     function holding a "gen1-%s-PHASE" tag is a route function, each of its call sites that passes a
 *     "TARGET" literal runs those phases for that target (a phase behind `if (!PARAM) return 0;` only
 *     when the call does not pass 0 there), and mark(outdir, "gen1-TARGET-PHASE" in the driver body
 *     is a phase run inline.  Compared phases: front merge stub units e3 image plus every phase name
 *     the chain source holds; graph-only names outside that set (prep, whole, B, ...) are not route
 *     phases of the chain and are ignored.  Each difference is one row
 *       ROUTE_MISMATCH<TAB>target<TAB>phase<TAB>graph=...<TAB>chain=...
 *     (present on one side only, or the same phases in another order).  g2/g3 aggregate nodes are
 *     not compared: the chain builds only the linux slices there.  The chain side is recognised by
 *     source shape, so the summary says how much was seen: route_fns (distinct route functions) and
 *     route_events (target/phase runs).  A chain source with no route function at all is a row
 *       ROUTE_UNRECOGNIZED<TAB>file<TAB>reason
 *     and exit 1: a rewritten driver must not pass as "no mismatch".
 *
 * Output: FAIL/ORDER_MISMATCH/HARDWIRE/ROUTE_MISMATCH/ROUTE_UNRECOGNIZED rows, then
 *   GRAPH_CHECK<TAB>nodes=N<TAB>edges=M<TAB>cycles=C<TAB>order_mismatch=K<TAB>hardwire=H<TAB>route_mismatch=R<TAB>route_fns=F<TAB>route_events=E
 * (F and E are 0 under --no-route).  Exit 0 when no structure failure, K == 0, R == 0 and no
 * ROUTE_UNRECOGNIZED row; 1 otherwise; 2 on IO/usage errors. */
#pragma unisa use sys.fs
#pragma unisa use text.text
#pragma unisa use mem.heap

#define MAXN 4096
#define NKIND 17
static const char *kinds[NKIND] = {"freeze", "snap", "tool", "ctx", "wave", "compare", "route", "p4", "slice-phase",
                                   "fixedpoint", "kernel", "pack", "install", "s9", "gen", "tbl", "net"};
#define NDIM 5
static const char *dims[NDIM] = {"jobs", "units", "targets", "stages", "none"};
typedef struct { char id[128], kind[32], target[32]; char *deps, *cmd; int line; int *adj, nadj; int color; } Node;
static Node nodes[MAXN]; static int nn;
static long fails, edges, cycles, mism, hard, rmis;
static const char *graph_path = "build/graph.tsv", *chain_path = "tools/chain-step.cx", *hard_path = "build/hardwire.tsv";
static const char *route_path = "tools/candidate-chain.cx";

static char *slurp(const char *p, long *n) {
    int fd = sy_open_read(p); char *b;
    if (fd < 0) { fprintf(stderr, "graph-check: cannot open %s (rc %d)\n", p, fd); exit(2); }
    *n = sy_reg_size(fd);
    if (*n < 0) { fprintf(stderr, "graph-check: cannot size %s\n", p); exit(2); }
    b = mm_alloc(*n + 1);
    if (!b || sy_read_full(fd, b, *n)) { fprintf(stderr, "graph-check: cannot read %s\n", p); exit(2); }
    sy_close(fd); b[*n] = 0; return b;
}
static void fail(int line, const char *what, const char *detail) {
    printf("FAIL\tstructure\t%s:%d\t%s\t%s\n", graph_path, line, what, detail); fails++;
}
static int find(const char *id, long n) { int i; for (i = 0; i < nn; i++) if (tx_same(nodes[i].id, tx_len(nodes[i].id, 128), id, n)) return i; return -1; }
static void addedge(int from, int to) {
    Node *a = &nodes[from];
    if (a->nadj % 64 == 0) { int *g = mm_grow(a->adj, (a->nadj + 64) * (long)sizeof(int)); if (!g) exit(2); a->adj = g; }
    a->adj[a->nadj++] = to; edges++;
}
static int budget_ok(const char *s, long n) {
    long i, v = 0; if (n < 1 || n > 3) return 0;
    for (i = 0; i < n; i++) { if (s[i] < '0' || s[i] > '9') return 0; v = v * 10 + (s[i] - '0'); }
    return v >= 1 && v <= 60;
}
static void load_graph(void) {
    long n, p = 0, lineno = 0; int header = 0, i; char *b = slurp(graph_path, &n);
    while (p < n) {
        long q = p, off, len; lineno++;
        while (q < n && b[q] != '\n') q++;
        if (q == p || b[p] == '#') { p = q + 1; continue; }
        if (!header) {
            static const char *H = "node_id\tkind\ttarget\tdepends_on\tcommand\tinputs\toutputs\tobserved_wall_s\tbudget_s\tevidence_path\tnote\troot_dependent\tsplit_dim\tsplit_min";
            if (!tx_same(b + p, q - p, H, tx_len(H, 256)))
                { fail((int)lineno, "header", "expected the 14 named columns"); exit(1); }
            header = 1; p = q + 1; continue;
        }
        if (tx_fields(b + p, q - p, '\t') != 14) { fail((int)lineno, "columns", "row must have 14 tab-separated fields"); p = q + 1; continue; }
        if (nn == MAXN) { fail((int)lineno, "capacity", "more than MAXN nodes"); exit(2); }
        tx_field(b + p, q - p, '\t', 0, &off, &len); tx_copy(nodes[nn].id, 128, b + p + off, len);
        if (len == 0 || find(b + p + off, len) >= 0) fail((int)lineno, "node_id", len ? "duplicate node_id" : "empty node_id");
        tx_field(b + p, q - p, '\t', 1, &off, &len); tx_copy(nodes[nn].kind, 32, b + p + off, len);
        for (i = 0; i < NKIND; i++) if (tx_same(b + p + off, len, kinds[i], tx_len(kinds[i], 32))) break;
        if (i == NKIND) fail((int)lineno, "kind", nodes[nn].kind);
        tx_field(b + p, q - p, '\t', 2, &off, &len); tx_copy(nodes[nn].target, 32, b + p + off, len);
        tx_field(b + p, q - p, '\t', 3, &off, &len); nodes[nn].deps = mm_alloc(len + 1); tx_copy(nodes[nn].deps, len + 1, b + p + off, len);
        tx_field(b + p, q - p, '\t', 4, &off, &len); nodes[nn].cmd = mm_alloc(len + 1); if (!nodes[nn].cmd) exit(2); tx_copy(nodes[nn].cmd, len + 1, b + p + off, len);
        tx_field(b + p, q - p, '\t', 8, &off, &len);
        if (!budget_ok(b + p + off, len)) { char d[64]; tx_copy(d, 64, b + p + off, len); fail((int)lineno, "budget_s", d); }
        tx_field(b + p, q - p, '\t', 11, &off, &len);
        if (tx_same(b + p + off, len, "yes", 3)) {
            static const char *prod[10] = {"tool", "gen", "tbl", "net", "route", "p4", "fixedpoint", "kernel", "pack", "install"}; int k;
            for (k = 0; k < 10; k++) if (tx_eqz(nodes[nn].kind, prod[k])) { fail((int)lineno, "root_dependent", "product node marked yes"); break; }
        } else if (!tx_same(b + p + off, len, "no", 2)) { char d[64]; tx_copy(d, 64, b + p + off, len); fail((int)lineno, "root_dependent", d); }
        { long bv = 0, k2, noff, nlen, doff, dlen, moff, mlen; int d2;
          tx_field(b + p, q - p, '\t', 8, &off, &len);
          for (k2 = 0; k2 < len && b[p + off + k2] >= '0' && b[p + off + k2] <= '9'; k2++) bv = bv * 10 + (b[p + off + k2] - '0');
          tx_field(b + p, q - p, '\t', 10, &noff, &nlen);
          tx_field(b + p, q - p, '\t', 12, &doff, &dlen);
          for (d2 = 0; d2 < NDIM; d2++) if (tx_same(b + p + doff, dlen, dims[d2], tx_len(dims[d2], 16))) break;
          if (d2 == NDIM) { char d[64]; tx_copy(d, 64, b + p + doff, dlen); fail((int)lineno, "split_dim", d); }
          else if (d2 == NDIM - 1 && bv >= 45 && tx_find(b + p + noff, nlen, "split:none ", 11) < 0) fail((int)lineno, "split_dim", "budget_s>=45 and split_dim none needs 'split:none <reason>' in note");
          tx_field(b + p, q - p, '\t', 13, &moff, &mlen);
          { long mv = 0, k3; for (k3 = 0; k3 < mlen && b[p + moff + k3] >= '0' && b[p + moff + k3] <= '9'; k3++) mv = mv * 10 + (b[p + moff + k3] - '0');
            if (mlen < 1 || k3 != mlen || mv < 1) { char d[64]; tx_copy(d, 64, b + p + moff, mlen); fail((int)lineno, "split_min", d); } } }
        nodes[nn].line = (int)lineno; nn++;
        p = q + 1;
    }
    if (!header) { fail(0, "header", "no header row"); exit(1); }
    /* edges, after all ids are known */
    for (i = 0; i < nn; i++) {
        const char *d = nodes[i].deps; long dn = tx_len(d, 1 << 20), k, nf;
        if (tx_eqz(d, "-") || dn == 0) continue;
        nf = tx_fields(d, dn, ',');
        for (k = 0; k < nf; k++) {
            long off, len; int j, any = 0;
            tx_field(d, dn, ',', k, &off, &len);
            if (len > 1 && d[off + len - 1] == '*') {
                for (j = 0; j < nn; j++) if (j != i && tx_prefix(nodes[j].id, tx_len(nodes[j].id, 128), d + off, len - 1)) { addedge(i, j); any = 1; }
                if (!any) { char x[128]; tx_copy(x, 128, d + off, len); fail(nodes[i].line, "depends_on", x); }
            } else {
                j = find(d + off, len);
                if (j < 0) { char x[128]; tx_copy(x, 128, d + off, len); fail(nodes[i].line, "depends_on", x); }
                else if (j == i) fail(nodes[i].line, "depends_on", "self dependency");
                else addedge(i, j);
            }
        }
    }
}
/* DFS colouring; the first back edge found per start node is one cycle. */
static int dfs(int v) {
    int k; nodes[v].color = 1;
    for (k = 0; k < nodes[v].nadj; k++) {
        int w = nodes[v].adj[k];
        if (nodes[w].color == 1) { char d[300]; if (cx_fmt(d, sizeof d, "%s -> %s", nodes[v].id, nodes[w].id)) d[0] = 0; fail(nodes[v].line, "cycle", d); cycles++; return 1; }
        if (nodes[w].color == 0 && dfs(w)) return 1;
    }
    nodes[v].color = 2; return 0;
}
/* ---- order ---- */
static char gorder[6][32]; static int ngo;
static void graph_order(void) {
    int i, k;
    for (i = 0; i < nn; i++) {
        const char *t = nodes[i].target;
        if (tx_eqz(t, "shared") || tx_eqz(t, "all") || t[0] == 0) continue;
        for (k = 0; k < ngo; k++) if (tx_eqz(gorder[k], t)) break;
        if (k < ngo) continue;
        if (ngo == 6) { fail(nodes[i].line, "target", t); continue; }
        tx_copy(gorder[ngo++], 32, t, tx_len(t, 32));
    }
    if (ngo != 6) { char d[64]; if (cx_fmt(d, sizeof d, "%d distinct targets, want 6", ngo)) d[0] = 0; fail(0, "targets", d); }
}
/* the next COUNT string literals after position AT in b[0..n); each cut at '/'; returns count found */
static int literals(const char *b, long n, long at, int count, char out[][32]) {
    int got = 0; long i = at;
    while (got < count && i < n) {
        if (b[i] == '"') {
            long j = i + 1, len; while (j < n && b[j] != '"') j++;
            len = j - i - 1; { long s = tx_chr(b + i + 1, len, '/'); if (s >= 0) len = s; }
            tx_copy(out[got++], 32, b + i + 1, len); i = j + 1;
        } else i++;
    }
    return got;
}
static int line_of(const char *b, long at) { long i; int l = 1; for (i = 0; i < at; i++) if (b[i] == '\n') l++; return l; }
static void compare_copy(const char *b, long n, const char *anchor, const char *name, int skip, char want[][32], const char *row) {
    long at = tx_find(b, n, anchor, tx_len(anchor, 128)); char got[8][32]; int k, same = 1; char g[256], w[256]; long gl = 0, wl = 0;
    if (at < 0) { printf("ORDER_MISMATCH\t%s:0\t%s\tconstant not found\n", chain_path, name); mism++; return; }
    if (literals(b, n, at, 6 + skip, got) != 6 + skip) { printf("ORDER_MISMATCH\t%s:%d\t%s\tfewer than 6 literals\n", chain_path, line_of(b, at), name); mism++; return; }
    for (k = 0; k < 6; k++) {
        long a = tx_len(got[k + skip], 32), c = tx_len(want[k], 32);
        if (!tx_same(got[k + skip], a, want[k], c)) same = 0;
        tx_copy(g + gl, 256 - gl, got[k + skip], a); gl += a; g[gl++] = ','; tx_copy(w + wl, 256 - wl, want[k], c); wl += c; w[wl++] = ',';
    }
    g[gl ? gl - 1 : 0] = 0; w[wl ? wl - 1 : 0] = 0;
    if (!same) { printf("%s\t%s:%d\t%s\tgot=%s\twant=%s\n", row, chain_path, line_of(b, at), name, g, w); mism++; }
}
/* build/order-domains.tsv: constant, file, line_hint, domain, frozen_order, reason, evidence.  A constant whose
   frozen_order is a six-target list is a pinned exception: its source order must equal that list exactly
   (else FROZEN_ORDER_CHANGED, counted in order_mismatch).  Every other constant -- declared graph-order or not
   declared at all (or no table) -- is compared with the graph order. */
static char dconst[16][64], dfrozen[16][256]; static int ndom, nfrozen;
static const char *dom_path = "build/order-domains.tsv";
static void dput(char *dst, long cap, const char *s, long n) { if (n > cap - 1) n = cap - 1; if (n < 0) n = 0; tx_copy(dst, cap, s, n); dst[n] = 0; }
static void load_domains(void) {
    long n, p = 0; int header = 0, fd = sy_open_read(dom_path); char *b;
    if (fd < 0) return;   /* absent table: strict mode */
    sy_close(fd); b = slurp(dom_path, &n);
    while (p < n) {
        long q = p, off, len;
        while (q < n && b[q] != '\n') q++;
        if (q == p || b[p] == '#') { p = q + 1; continue; }
        if (!header) { header = 1; p = q + 1; continue; }
        if (tx_fields(b + p, q - p, '\t') < 7 || ndom == 16) { fprintf(stderr, "graph-check: bad order-domains row\n"); exit(2); }
        tx_field(b + p, q - p, '\t', 0, &off, &len); dput(dconst[ndom], 64, b + p + off, len);
        tx_field(b + p, q - p, '\t', 4, &off, &len); dput(dfrozen[ndom], 256, b + p + off, len);
        if (dfrozen[ndom][0] == '-' && dfrozen[ndom][1] == 0) dfrozen[ndom][0] = 0;
        if (dfrozen[ndom][0]) nfrozen++;
        ndom++; p = q + 1;
    }
    mm_free(b);
}
static void check_one(const char *b, long n, const char *name, const char *anchor, int skip) {
    int d; char want[6][32];
    for (d = 0; d < ndom; d++) if (tx_eqz(dconst[d], name)) break;
    if (d < ndom && dfrozen[d][0]) {
        const char *f = dfrozen[d]; long fl = tx_len(f, 256); int k;
        if (tx_fields(f, fl, ',') != 6) { printf("FROZEN_ORDER_CHANGED\t%s\t%s\tfrozen_order must list 6 targets\n", dom_path, name); mism++; return; }
        for (k = 0; k < 6; k++) { long off, len; tx_field(f, fl, ',', k, &off, &len); dput(want[k], 32, f + off, len); }
        compare_copy(b, n, anchor, name, skip, want, "FROZEN_ORDER_CHANGED");
    } else compare_copy(b, n, anchor, name, skip, gorder, "ORDER_MISMATCH");
}
static void check_order(void) {
    long n; char *b = slurp(chain_path, &n);
    load_domains();
    printf("ORDER_DOMAINS\tdeclared=%d\tfrozen=%d\n", ndom, nfrozen);
    if (ngo != 6) return;
    check_one(b, n, "cs_target", "cs_target[6] = {", 0);
    check_one(b, n, "cs_fp_slices", "cs_fp_slices[6] = {", 0);
    check_one(b, n, "phase-ternary", "\"kernel-route\" : i == 0 ?", 1);
    mm_free(b);
}
/* ---- hardwire ---- */
static void scan_file(const char *id, const char *file, const char *pat) {
    long n, p = 0, pl = tx_len(pat, 512); int line = 0; int fd = sy_open_read(file); char *b;
    if (fd < 0) { printf("HARDWIRE\t%s:0\t%s:%s\t(file unreadable rc %d)\n", file, id, pat, fd); hard++; return; }
    sy_close(fd); b = slurp(file, &n);
    while (p < n) {
        long q = p; line++;
        while (q < n && b[q] != '\n') q++;
        if (tx_contains(b + p, q - p, pat, pl)) { printf("HARDWIRE\t%s:%d\t%s:%s\n", file, line, id, pat); hard++; }
        p = q + 1;
    }
    mm_free(b);
}
static void check_hardwire(void) {
    long n, p = 0; int header = 0; char *b = slurp(hard_path, &n);
    while (p < n) {
        long q = p, off, len; char id[32], file[512], pat[512];
        while (q < n && b[q] != '\n') q++;
        if (q == p || b[p] == '#') { p = q + 1; continue; }
        if (!header) { header = 1; p = q + 1; continue; }
        if (tx_fields(b + p, q - p, '\t') < 3) { fprintf(stderr, "graph-check: bad hardwire row\n"); exit(2); }
        tx_field(b + p, q - p, '\t', 0, &off, &len); tx_copy(id, 32, b + p + off, len);
        tx_field(b + p, q - p, '\t', 1, &off, &len); tx_copy(file, 512, b + p + off, len);
        tx_field(b + p, q - p, '\t', 2, &off, &len); tx_copy(pat, 512, b + p + off, len);
        scan_file(id, file, pat);
        p = q + 1;
    }
    mm_free(b);
}
/* ---- route ---- */
typedef struct { char fn[64], phase[32]; int gate, line; } RFn;        /* one "gen1-%s-PHASE" tag inside function fn */
typedef struct { char target[32], phase[32], via[64]; int line; long pos; } REv;   /* the chain runs PHASE for TARGET */
static RFn rfn[64]; static int nrfn;
static REv rev[512]; static int nrev;
static char rvocab[32][32]; static int nrv;
static int route_fns, route_blind;
static int ident(char c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'; }
static void put_s(char *dst, long cap, const char *s, long n) { if (n > cap - 1) n = cap - 1; if (n < 0) n = 0; tx_copy(dst, cap, s, n); dst[n] = 0; }
/* front0, front1, front%d are the one phase "front" */
static void phase_norm(char *dst, const char *s, long n) { if (n >= 5 && tx_same(s, 5, "front", 5)) n = 5; put_s(dst, 32, s, n); }
static void vocab(const char *p) {
    int k; for (k = 0; k < nrv; k++) if (tx_eqz(rvocab[k], p)) return;
    if (nrv == 32) { fprintf(stderr, "graph-check: more than 32 route phase names\n"); exit(2); }
    put_s(rvocab[nrv++], 32, p, tx_len(p, 32));
}
static void route_event(const char *target, const char *phase, const char *via, int line, long pos) {
    if (nrev == 512) { fprintf(stderr, "graph-check: more than 512 route events in %s\n", route_path); exit(2); }
    put_s(rev[nrev].target, 32, target, tx_len(target, 32)); put_s(rev[nrev].phase, 32, phase, tx_len(phase, 32));
    put_s(rev[nrev].via, 64, via, tx_len(via, 64)); rev[nrev].line = line; rev[nrev].pos = pos; nrev++; vocab(phase);
}
/* every "gen1-%s-PHASE" literal: its enclosing function (the last column-0 `static ` line before it) and,
   when an `if (!PARAM) return 0;` stands between the function head and the literal, PARAM's position */
static void route_functions(const char *b, long n) {
    long i = 0;
    for (;;) {
        long at = tx_find(b + i, n - i, "\"gen1-%s-", 9), s, e, fs, paren, ns, j;
        if (at < 0) break;
        at += i; s = at + 9; e = s;
        while (e < n && b[e] != '"' && b[e] != '\n') e++;
        i = e;
        for (fs = at; fs >= 0; fs--) if ((fs == 0 || b[fs - 1] == '\n') && n - fs >= 7 && tx_same(b + fs, 7, "static ", 7)) break;
        if (fs < 0) continue;
        for (paren = fs; paren < at && b[paren] != '('; paren++) ;
        if (paren == at) continue;
        for (ns = paren; ns > fs && ident(b[ns - 1]); ns--) ;
        if (nrfn == 64) { fprintf(stderr, "graph-check: more than 64 route tags in %s\n", route_path); exit(2); }
        put_s(rfn[nrfn].fn, 64, b + ns, paren - ns); phase_norm(rfn[nrfn].phase, b + s, e - s);
        rfn[nrfn].gate = -1; rfn[nrfn].line = line_of(b, at);
        for (j = paren; j < at; ) {
            long g = tx_find(b + j, at - j, "if (!", 5), ge;
            if (g < 0) break;
            g += j + 5; for (ge = g; ge < at && ident(b[ge]); ge++) ;
            j = ge;
            if (ge > g && at - ge >= 11 && tx_same(b + ge, 11, ") return 0;", 11)) {
                long p = paren + 1, ps = p; int idx = 0, depth = 0;
                for (; p < at; p++) {
                    if (b[p] == '(') depth++;
                    else if (b[p] == ')' && depth > 0) depth--;
                    else if (b[p] == ',' || b[p] == ')') {
                        long z = p, a;
                        while (z > ps && !ident(b[z - 1])) z--;
                        for (a = z; a > ps && ident(b[a - 1]); a--) ;
                        if (tx_same(b + a, z - a, b + g, ge - g)) rfn[nrfn].gate = idx;
                        if (b[p] == ')') break;
                        idx++; ps = p + 1;
                    }
                }
            }
        }
        vocab(rfn[nrfn].phase); nrfn++;
    }
}
/* every call of a route function that passes one of the six targets as a string literal */
static void route_calls(const char *b, long n) {
    int f, k;
    for (f = 0; f < nrfn; f++) {
        long fl = tx_len(rfn[f].fn, 64), i = 0;
        for (k = 0; k < f; k++) if (tx_eqz(rfn[k].fn, rfn[f].fn)) break;
        if (k < f) continue;
        for (;;) {
            static char arg[12][96];
            long at = tx_find(b + i, n - i, rfn[f].fn, fl), ls, p, as; int na = 0, depth = 0, q = 0, t = -1, a, g;
            if (at < 0) break;
            at += i; i = at + fl;
            if ((at > 0 && ident(b[at - 1])) || at + fl >= n || b[at + fl] != '(') continue;
            for (ls = at; ls > 0 && b[ls - 1] != '\n'; ls--) ;
            if (n - ls >= 7 && tx_same(b + ls, 7, "static ", 7)) continue;   /* the definition or a prototype */
            for (p = at + fl + 1, as = p; p < n; p++) {
                char c = b[p];
                if (q) { if (c == '\\') p++; else if (c == '"') q = 0; continue; }
                if (c == '"') { q = 1; continue; }
                if (c == '(') { depth++; continue; }
                if (c == ')' && depth > 0) { depth--; continue; }
                if (c == ')' || (c == ',' && depth == 0)) {
                    long x = as, z = p;
                    while (x < z && (b[x] == ' ' || b[x] == '\n')) x++;
                    while (z > x && (b[z - 1] == ' ' || b[z - 1] == '\n')) z--;
                    if (na < 12) put_s(arg[na++], 96, b + x, z - x);
                    as = p + 1;
                    if (c == ')') break;
                }
            }
            for (a = 0; a < na && t < 0; a++) {
                long al = tx_len(arg[a], 96);
                if (al < 3 || arg[a][0] != '"' || arg[a][al - 1] != '"') continue;
                for (g = 0; g < ngo; g++) if (tx_same(arg[a] + 1, al - 2, gorder[g], tx_len(gorder[g], 32))) { t = g; break; }
            }
            if (t < 0) continue;
            for (k = f; k < nrfn; k++) {
                if (!tx_eqz(rfn[k].fn, rfn[f].fn)) continue;
                if (rfn[k].gate >= 0 && rfn[k].gate < na && tx_eqz(arg[rfn[k].gate], "0")) continue;
                route_event(gorder[t], rfn[k].phase, rfn[k].fn, line_of(b, at), at);
            }
        }
    }
}
/* mark(outdir, "gen1-TARGET-PHASE": a phase the driver body runs itself */
static void route_inline(const char *b, long n) {
    static const char *K = "mark(outdir, \"gen1-"; long kl = tx_len(K, 64), i = 0;
    for (;;) {
        long at = tx_find(b + i, n - i, K, kl), s, e; int g; char ph[32];
        if (at < 0) break;
        at += i; s = at + kl; i = s;
        for (g = 0; g < ngo; g++) {
            long gl = tx_len(gorder[g], 32);
            if (n - s > gl && tx_same(b + s, gl, gorder[g], gl) && b[s + gl] == '-') {
                for (e = s + gl + 1; e < n && b[e] != '"' && b[e] != '\n'; e++) ;
                phase_norm(ph, b + s + gl + 1, e - (s + gl + 1));
                route_event(gorder[g], ph, "inline", line_of(b, at), at);
                break;
            }
        }
    }
}
/* 1 and the normalised PHASE when node I is the slice-phase node gen1.TARGET.PHASE */
static int node_phase(int i, const char *target, char *ph) {
    const char *id = nodes[i].id; long il = tx_len(id, 128), tl = tx_len(target, 32);
    if (!tx_eqz(nodes[i].kind, "slice-phase") || il < 5 + tl + 2 || !tx_same(id, 5, "gen1.", 5)) return 0;
    if (!tx_same(id + 5, tl, target, tl) || id[5 + tl] != '.') return 0;
    phase_norm(ph, id + 5 + tl + 1, il - (5 + tl + 1));
    return 1;
}
/* append PH to the comma list SEQ unless it is already one of its items */
static void seq_add(char *seq, long cap, const char *ph) {
    long sl = tx_len(seq, cap), pl = tx_len(ph, 32), a = 0, z;
    while (a < sl) { for (z = a; z < sl && seq[z] != ','; z++) ; if (tx_same(seq + a, z - a, ph, pl)) return; a = z + 1; }
    if (sl + pl + 2 >= cap) return;
    if (sl) seq[sl++] = ',';
    tx_copy(seq + sl, cap - sl, ph, pl); seq[sl + pl] = 0;
}
static void check_route(void) {
    static const char *base[6] = {"front", "merge", "stub", "units", "e3", "image"};
    long n; char *b; int t, v, i, k;
    if (ngo != 6) return;
    b = slurp(route_path, &n);
    for (k = 0; k < 6; k++) vocab(base[k]);
    route_functions(b, n); route_calls(b, n); route_inline(b, n);
    for (i = 0; i < nrfn; i++) { for (k = 0; k < i; k++) if (tx_eqz(rfn[k].fn, rfn[i].fn)) break; if (k == i) route_fns++; }
    if (!route_fns) {   /* the reader is shape based: seeing nothing is a blind check, not a consistent route */
        printf("ROUTE_UNRECOGNIZED\t%s\tno function holds a \"gen1-%%s-PHASE\" tag: the chain driver's route shape changed and this check cannot see its per-target phases\n", route_path);
        route_blind = 1;
    }
    for (i = 1; i < nrev; i++) {   /* source order; stable, so one call keeps its phases in tag order */
        REv x = rev[i]; for (k = i; k > 0 && rev[k - 1].pos > x.pos; k--) rev[k] = rev[k - 1];
        rev[k] = x;
    }
    for (t = 0; t < 6; t++) {
        char gs[512], cs[512], ph[32]; int bad = 0;
        gs[0] = 0; cs[0] = 0;
        for (v = 0; v < nrv; v++) {
            int gi = -1, ci = -1;
            for (i = 0; i < nn && gi < 0; i++) if (node_phase(i, gorder[t], ph) && tx_eqz(ph, rvocab[v])) gi = i;
            for (i = 0; i < nrev && ci < 0; i++) if (tx_eqz(rev[i].target, gorder[t]) && tx_eqz(rev[i].phase, rvocab[v])) ci = i;
            if ((gi < 0) == (ci < 0)) continue;
            bad = 1; rmis++;
            printf("ROUTE_MISMATCH\t%s\t%s\t", gorder[t], rvocab[v]);
            if (gi >= 0) printf("graph=%s (%s:%d) command: %s\t", nodes[gi].id, graph_path, nodes[gi].line, nodes[gi].cmd);
            else printf("graph=absent (no slice-phase node gen1.%s.%s)\t", gorder[t], rvocab[v]);
            if (ci >= 0) printf("chain=runs it (%s:%d via %s)\n", route_path, rev[ci].line, rev[ci].via);
            else printf("chain=absent (%s never runs gen1-%s-%s)\n", route_path, gorder[t], rvocab[v]);
        }
        if (bad) continue;
        for (i = 0; i < nn; i++) if (node_phase(i, gorder[t], ph)) {
            for (v = 0; v < nrv; v++) if (tx_eqz(ph, rvocab[v])) break;
            if (v < nrv) seq_add(gs, 512, ph);
        }
        for (i = 0; i < nrev; i++) if (tx_eqz(rev[i].target, gorder[t])) seq_add(cs, 512, rev[i].phase);
        if (!tx_eqz(gs, cs)) { printf("ROUTE_MISMATCH\t%s\t(order)\tgraph=%s (%s)\tchain=%s (%s)\n", gorder[t], gs, graph_path, cs, route_path); rmis++; }
    }
    mm_free(b);
}
int main(int argc, char **argv) {
    int i, no_hard = 0, no_route = 0;
    for (i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--")) continue;
        else if (tx_eqz(argv[i], "--graph") && i + 1 < argc) graph_path = argv[++i];
        else if (tx_eqz(argv[i], "--chain") && i + 1 < argc) chain_path = argv[++i];
        else if (tx_eqz(argv[i], "--hardwire") && i + 1 < argc) hard_path = argv[++i];
        else if (tx_eqz(argv[i], "--no-hardwire")) no_hard = 1;
        else if (tx_eqz(argv[i], "--route") && i + 1 < argc) route_path = argv[++i];
        else if (tx_eqz(argv[i], "--no-route")) no_route = 1;
        else if (tx_eqz(argv[i], "--domains") && i + 1 < argc) dom_path = argv[++i];
        else { fprintf(stderr, "graph-check: unknown argument %s\n", argv[i]); return 2; }
    }
    load_graph();
    for (i = 0; i < nn; i++) if (nodes[i].color == 0) dfs(i);
    graph_order();
    check_order();
    if (!no_hard) check_hardwire();
    if (!no_route) check_route();
    printf("GRAPH_CHECK\tnodes=%d\tedges=%ld\tcycles=%ld\torder_mismatch=%ld\thardwire=%ld\troute_mismatch=%ld\troute_fns=%d\troute_events=%d\n", nn, edges, cycles, mism, hard, rmis, route_fns, nrev);
    return fails || mism || rmis || route_blind ? 1 : 0;
}
