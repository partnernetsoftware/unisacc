/* tools/flow.cx -- "I changed FILE...; what is the blast radius?" in one command.
 *
 *   sh ./unisacc.com tools/flow.cx -- check FILE... [--jobs N] [--run]
 *   sh ./unisacc.com tools/flow.cx -- graph FILE...
 *
 * check: runs symindex --delta on FILEs (affected files: forward use closure + reverse
 *   users), then affected --files on FILEs (affected test batches), and prints one
 *   combined report. With --run it also runs the affected batches (parallel via affected).
 * graph: runs symindex --graph FILEs (subgraph lands in out/symindex/v1/graph.tsv).
 *
 * This is the one-shot form of the event workflow; --watch (once cx/sys/watch.cx lands,
 * cx-architecture lane) feeds the same pipeline from file events.
 * Prints PASS/FAIL lines and CHECK_FLOW<TAB>failed=N. */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.sig
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use mem.heap

/* sy_run with a bound: ARGV runs under cx_runv_timeout (SECS, process group killed on expiry), stdout and stderr
   merged into OUT (CAP, NUL-terminated, *CUT set when it did not fit; CUT may be 0). */
static int bounded_run(char **argv, int secs, char *out, int cap, int *cut) {
    char *w[64], *b = 0;
    size_t n = 0, j;
    int k = 0, i, rc;
    if (cut) *cut = 0;
    if (!argv) return -EINVAL;
    w[k++] = "sh"; w[k++] = "-c"; w[k++] = "exec \"$@\" 2>&1"; w[k++] = "sh";
    for (i = 0; argv[i] && k < 63; i++) w[k++] = argv[i];
    if (argv[i]) return -E2BIG;
    w[k] = 0;
    rc = cx_runv_timeout(w, secs, &b, &n);
    if (cap > 0) {
        if (n > (size_t)cap - 1) { n = (size_t)cap - 1; if (cut) *cut = 1; }
        for (j = 0; b && j < n; j++) out[j] = b[j];
        out[b ? n : 0] = 0;
    }
    free(b);
    return rc;
}

static int failed;
static void ck(int ok, const char *name) { if (ok) sy_printf("PASS\tflow.%s\n", name); else { failed++; sy_printf("FAIL\tflow.%s\n", name); } }
static void die(const char *s) { sy_eprintf("flow: REFUSE %s\n", s); sy_exit(2); }
static int has(const char *s, const char *w) { return tx_find(s, tx_len(s, 1 << 20), w, tx_len(w, 128)) >= 0; }
static void emit(const char *s) {   /* print only report lines; drop NOTE and other tool chatter */
    const char *p = s;
    while (*p) {
        const char *e = p; while (*e && *e != '\n') e++;
        if (tx_prefix(p, (long)(e - p), "DELTA\t", 6) || tx_prefix(p, (long)(e - p), "DELTA_SUMMARY\t", 14)
            || tx_prefix(p, (long)(e - p), "AFFECTED\t", 9) || tx_prefix(p, (long)(e - p), "AFFECTED_SUMMARY\t", 17)
            || tx_prefix(p, (long)(e - p), "N\t", 2) || tx_prefix(p, (long)(e - p), "E\t", 2)
            || tx_prefix(p, (long)(e - p), "V\t", 2) || tx_prefix(p, (long)(e - p), "GRAPH\t", 6)
            || tx_prefix(p, (long)(e - p), "BATCH_RUN\t", 10) || tx_prefix(p, (long)(e - p), "AFFECTED_RUN\t", 13)) {
            fwrite(p, 1, (size_t)(e - p), stdout); fputc('\n', stdout);
        }
        p = *e ? e + 1 : e;
    }
}
static int f_atoi(const char *s) { int n = 0; while (*s >= '0' && *s <= '9') { n = n * 10 + (*s++ - '0'); if (n > 999) return 999; } return n; }

static char root[4096], com[4500], si[4600], af[4600];

/* run `sh COM TOOL -- ARGS...` into OUT (cap); returns the tool rc */
static int tool(const char *path, char **args, char *out, int cap) {
    char *v[64]; int k = 0;
    v[k++] = "sh"; v[k++] = com; v[k++] = (char *)path; v[k++] = "--";
    for (; *args; args++) v[k++] = *args;
    v[k] = 0;
    { int cut; return bounded_run(v, 50, out, cap, &cut); }
}

/* ---- watch mode: poll the source tree for changes, then run check on the dirty set ---- *
 * No inotify here (that is cx/sys/watch.cx, the cx-architecture lane). A poll over cx_walk with
 * the same stat prefilter symindex uses (size, whole-second mtime, ino, dev) is enough and needs
 * nothing below tools/. One tick = walk, diff against the last snapshot, check the changed files. */
#define FW_MAX 20000
typedef struct { char *path; long size, mtime, ino; unsigned long dev; } fw_ent;
static fw_ent fw_now[FW_MAX], fw_prev[FW_MAX];
static int fw_nnow, fw_nprev;
static int fw_take(const char *path, void *ctx) {
    sy_stat_t st;
    (void)ctx;
    if (fw_nnow == FW_MAX) return 0;
    {   long n = tx_len(path, 4096);
        if (!(n > 3 && path[n - 3] == '.' && path[n - 2] == 'c' && path[n - 1] == 'x')) return 0;   /* .cx only */
    }
    if (sy_lstat(path, &st) != 0 || st.kind != 'f') return 0;
    fw_now[fw_nnow].path = mm_alloc(tx_len(path, 4096) + 1);
    if (!fw_now[fw_nnow].path) return 0;
    if (tx_copy(fw_now[fw_nnow].path, tx_len(path, 4096) + 1, path, tx_len(path, 4096))) return 0;
    fw_now[fw_nnow].size = st.size; fw_now[fw_nnow].mtime = st.mtime;
    fw_now[fw_nnow].ino = st.ino; fw_now[fw_nnow].dev = st.dev;
    fw_nnow++;
    return 0;
}
static fw_ent *fw_find(fw_ent *tab, int n, const char *p, long pl) {
    int i; for (i = 0; i < n; i++) if (tx_eq(tab[i].path, p, pl)) return &tab[i];
    return 0;
}

int main(int argc, char **argv) {
    int a = 1, jobs = 4, run = 0, once = 0, rc, nf = 0, k;
    const char *mode;
    const char *files[256];
    char **argv2;
    char jobsbuf[16], *out;
    if (sy_cwd(root, (int)sizeof root) < 0 || cx_fmt(com, sizeof com, "%s/unisacc.com", root)
        || cx_fmt(si, sizeof si, "%s/tools/symindex.cx", root) || cx_fmt(af, sizeof af, "%s/tools/affected.cx", root)) die("paths");
    if (a >= argc) die("usage: check FILE... [--jobs N] [--run] | graph FILE... | watch [--jobs N] [--run]");
    mode = argv[a++];
    if (!tx_eqz(mode, "check") && !tx_eqz(mode, "graph") && !tx_eqz(mode, "watch")) die("mode is check, graph or watch");
    for (; a < argc; a++) {
        if (tx_eqz(argv[a], "--run")) run = 1;
        else if (tx_eqz(argv[a], "--once")) once = 1;
        else if (tx_eqz(argv[a], "--jobs") && a + 1 < argc) jobs = f_atoi(argv[++a]);
        else if (argv[a][0] == '-' && argv[a][1] == '-') die("unknown option");
        else { if (nf == 256) die("too many files"); files[nf++] = argv[a]; }
    }
    if (!tx_eqz(mode, "watch") && nf == 0) die("no files");
    if (cx_fmt(jobsbuf, sizeof jobsbuf, "%d", jobs < 1 ? 1 : jobs > 8 ? 8 : jobs)) die("jobs bound");
    out = mm_alloc(16L << 20);
    if (!out) die("out of memory");
    argv2 = mm_zalloc((long)(nf + 8) * (long)sizeof(char *));
    if (!argv2) die("out of memory");

    if (tx_eqz(mode, "watch")) {
        /* one tick: walk the tree, diff against the last snapshot, check the dirty .cx files */
        const char *dirs[] = {"cx", "src", "tools", "tests", "include"};
        int di, ii, changed = 0, first = 1;
        char **dirty = mm_zalloc(256 * (long)sizeof(char *));
        if (!dirty) die("out of memory");
        for (;;) {
            fw_nnow = 0;
            for (di = 0; di < 5; di++) {
                char dp[4400];
                if (cx_fmt(dp, sizeof dp, "%s/%s", root, dirs[di])) die("path too long");
                if (sy_exists(dp) == 1) cx_walk(dp, fw_take, 0);
            }
            /* diff: a now-file that is new or has a different (size,mtime,ino,dev) is dirty.
               The first scan only builds the baseline (nothing to compare against yet). */
            changed = 0;
            if (!first) for (ii = 0; ii < fw_nnow && changed < 256; ii++) {
                fw_ent *p = fw_find(fw_prev, fw_nprev, fw_now[ii].path, tx_len(fw_now[ii].path, 4096));
                if (p && p->size == fw_now[ii].size && p->mtime == fw_now[ii].mtime
                    && p->ino == fw_now[ii].ino && p->dev == fw_now[ii].dev) continue;
                dirty[changed++] = fw_now[ii].path;
            }
            /* swap: prev <- now */
            for (ii = 0; ii < fw_nprev; ii++) mm_free(fw_prev[ii].path);
            for (ii = 0; ii < fw_nnow; ii++) { char *pp2 = fw_now[ii].path; fw_prev[ii].path = pp2; fw_prev[ii].size = fw_now[ii].size; fw_prev[ii].mtime = fw_now[ii].mtime; fw_prev[ii].ino = fw_now[ii].ino; fw_prev[ii].dev = fw_now[ii].dev; fw_now[ii].path = 0; }
            fw_nprev = fw_nnow; fw_nnow = 0;
            if (first) { first = 0; sy_printf("FLOW_WATCH\ttick=1\tbaseline=%d\tfirst-scan\n", fw_nprev); }
            else if (changed) {
                sy_printf("FLOW_WATCH\ttick=1\tchanged=%d\n", changed);
                /* run the same delta+affected pipeline on the dirty set */
                k = 0; argv2[k++] = (char *)"--files";
                for (ii = 0; ii < changed; ii++) argv2[k++] = dirty[ii];
                argv2[k] = 0;
                rc = tool(af, argv2, out, 16 << 20);
                if (rc == 0) emit(out);
            } else sy_printf("FLOW_WATCH\ttick=1\tchanged=0\n");
            if (once) break;
            sy_sleep_ms(500);
        }
        sy_printf("CHECK_FLOW\tfailed=%d\n", failed);
        mm_free(out); mm_free(argv2); mm_free(dirty);
        return failed ? 1 : 0;
    }

    if (tx_eqz(mode, "graph")) {
        k = 0; argv2[k++] = (char *)"graph";
        for (a = 0; a < nf; a++) argv2[k++] = (char *)files[a];
        argv2[k] = 0;
        rc = tool(si, argv2, out, 16 << 20);
        ck(rc == 0 && has(out, "GRAPH\t"), "graph-ran");
        if (rc == 0) emit(out);
        sy_printf("CHECK_FLOW\tfailed=%d\n", failed);
        mm_free(out); mm_free(argv2);
        return failed ? 1 : 0;
    }

    /* check: delta (files) then affected (batches), then optional run */
    k = 0; argv2[k++] = (char *)"delta";
    for (a = 0; a < nf; a++) argv2[k++] = (char *)files[a];
    argv2[k] = 0;
    rc = tool(si, argv2, out, 16 << 20);
    ck(rc == 0 && has(out, "DELTA_SUMMARY\t"), "delta-ran");
    if (rc == 0) emit(out);

    k = 0; argv2[k++] = (char *)"--files";
    for (a = 0; a < nf; a++) argv2[k++] = (char *)files[a];
    argv2[k] = 0;
    rc = tool(af, argv2, out, 16 << 20);
    ck(rc == 0 && has(out, "AFFECTED_SUMMARY\t"), "affected-ran");
    if (rc == 0) emit(out);

    if (run && rc == 0) {
        k = 0; argv2[k++] = (char *)"--files";
        for (a = 0; a < nf; a++) argv2[k++] = (char *)files[a];
        argv2[k++] = (char *)"--run"; argv2[k++] = (char *)"-j"; argv2[k++] = jobsbuf;
        argv2[k] = 0;
        rc = tool(af, argv2, out, 16 << 20);
        ck(rc == 0 || rc == 3, "run-ran");
        if (rc == 0 || rc == 3) emit(out);
    }
    sy_printf("FLOW_SUMMARY\tmode=check\tfiles=%d\trun=%d\tjobs=%d\n", nf, run, jobs);
    sy_printf("CHECK_FLOW\tfailed=%d\n", failed);
    mm_free(out); mm_free(argv2);
    return failed ? 1 : 0;
}
