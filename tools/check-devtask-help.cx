/* tools/check-devtask-help.cx -- devtask task 与 devsvc task/f 的帮助与具名拒绝。
 *
 *   sh ./unisacc.com tools/check-devtask-help.cx        (在仓根跑)
 *
 * 经 tools/devsvc-core.cx(工作副本,等价 devsvc.cx --dev)与 tools/devtask.cx 直调两条入口,断言:
 *   (a) devsvc task open 缺必填项 rc 2,逐个点名缺的参数并写明 --accept 须为可执行命令,不回打 devsvc 总用法;
 *   (b) task open/amend/status/done/list 与 task 各自 --help rc 0,含 required/example 与 --accept 约束;
 *   (c) task done --id X 具名拒绝(ID 须为首个位置参数);未知子命令具名拒绝 rc 2;
 *   (d) devsvc f --help rc 0 含 read/write/edit 全语法;
 *   (e) devsvc task open 全参数在私有 --dir 建单 rc 0(无 DEVSVC_OWNER 也可),task status 回读。
 * 末行 CHECK_DEVTASK_HELP<TAB>failed=N;有 FAIL 则 rc 1。 */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sysx.process
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use cxlib.ckassert

#define F(dst, cap, ...) do { if (snprintf(dst, cap, __VA_ARGS__) < 0) fputs("", stderr); } while (0)
static int nfail;
static char out[1 << 15];
static void ca_local_assert(int c, const char *name) {
    printf("%s\tdevtask-help.%s\n", c ? "PASS" : "FAIL", name);
    if (!c) { printf("NOTE\tlast-output\t%.700s\n", out); nfail++; }
}

static int has(const char *s) { return strstr(out, s) != 0; }
#define ACC "--accept CMD must be an executable shell command"
int main(void) {
    char d[200], c[300]; int rc;
    const char *subs[] = {"open", "amend", "status", "done", "list", 0};
    const char *ents[] = {"tools/devsvc-core.cx", "tools/devtask.cx", 0};
    (void)sy_unsetenv("DEVSVC_OWNER");
    F(d, sizeof d, "/tmp/dthelp-%d", sy_pid());
    for (int e = 0; ents[e]; e++) {
        char nm[120]; const char *en = e ? "devtask" : "devsvc";
        { char *v[] = {"sh", "./unisacc.com", (char *)ents[e], "--", "task", "open", "--id", "z", "--title", "T", 0}; rc = ck_run(v, out, sizeof out); }
        F(nm, sizeof nm, "%s.open-missing-named", en);
        ca_local_assert(rc == 2 && has("missing required: --write P...|--write-ext ABSDIR --accept CMD --deadline-min N") && has(ACC) && !has("usage: devsvc flow"), nm);
        { char *v[] = {"sh", "./unisacc.com", (char *)ents[e], "--", "task", "open", "--id", "z", "--title", "T", "--write", "tools/x.cx", "--deadline-min", "5", 0}; rc = ck_run(v, out, sizeof out); }
        F(nm, sizeof nm, "%s.open-missing-accept-only", en);
        ca_local_assert(rc == 2 && has("missing required: --accept CMD\n") && has(ACC), nm);
        { char *v[] = {"sh", "./unisacc.com", (char *)ents[e], "--", "task", "open", "--id", "zp", "--title", "T", "--write", "tools/x.cx", "--accept", "检查通过且无回归", "--deadline-min", "5", "--dir", d, 0}; rc = ck_run(v, out, sizeof out); }
        F(nm, sizeof nm, "%s.open-accept-prose-refused", en);
        ca_local_assert(rc == 2 && has("--accept #1 is not an executable command") && has(ACC) && !has("TASK\topen"), nm);
        { char *v[] = {"sh", "./unisacc.com", (char *)ents[e], "--", "task", "open", "--id", "zq", "--title", "T", "--write", "tools/x.cx", "--accept", "true", "--accept", "nosuchprog_zz run the checks", "--deadline-min", "5", "--dir", d, 0}; rc = ck_run(v, out, sizeof out); }
        F(nm, sizeof nm, "%s.open-accept-unknown-word-refused", en);
        ca_local_assert(rc == 2 && has("--accept #2 is not an executable command (first word 'nosuchprog_zz'") && !has("TASK\topen"), nm);
        { char *v[] = {"sh", "./unisacc.com", (char *)ents[e], "--", "task", "open", "--id", "zr", "--title", "T", "--write", "tools/x.cx", "--accept", "   ", "--deadline-min", "5", "--dir", d, 0}; rc = ck_run(v, out, sizeof out); }
        F(nm, sizeof nm, "%s.open-accept-blank-refused", en);
        ca_local_assert(rc == 2 && has("--accept #1 is not an executable command") && !has("TASK\topen"), nm);
        for (int s = 0; subs[s]; s++) {
            { char *v[] = {"sh", "./unisacc.com", (char *)ents[e], "--", "task", (char *)subs[s], "--help", 0}; rc = ck_run(v, out, sizeof out); }
            F(c, sizeof c, "usage: devtask task %s", subs[s]);
            F(nm, sizeof nm, "%s.help-%s", en, subs[s]);
            ca_local_assert(rc == 0 && has(c) && (s == 4 || (has("required:") && has("example:"))) && (s || has(ACC)), nm);
        }
        { char *v[] = {"sh", "./unisacc.com", (char *)ents[e], "--", "task", "--help", 0}; rc = ck_run(v, out, sizeof out); }
        F(nm, sizeof nm, "%s.help-task", en); ca_local_assert(rc == 0 && has("devtask task SUB --help") && has(ACC), nm);
        { char *v[] = {"sh", "./unisacc.com", (char *)ents[e], "--", "task", "done", "--id", "z", 0}; rc = ck_run(v, out, sizeof out); }
        F(nm, sizeof nm, "%s.done-id-positional", en); ca_local_assert(rc == 2 && has("task done needs the work order ID as the first positional argument (got --id)"), nm);
        { char *v[] = {"sh", "./unisacc.com", (char *)ents[e], "--", "task", "bogus", 0}; rc = ck_run(v, out, sizeof out); }
        F(nm, sizeof nm, "%s.unknown-sub", en); ca_local_assert(rc == 2 && has("unknown task subcommand 'bogus'"), nm);
    }
    { char *v[] = {"sh", "./unisacc.com", "tools/devsvc-core.cx", "--", "f", "--help", 0}; rc = ck_run(v, out, sizeof out); }
    ca_local_assert(rc == 0 && has("devsvc f read PATH") && has("devsvc f write PATH") && has("devsvc f edit PATH --old-file A --new-file B") && has("example:"), "f-help");
    { char *v[] = {"sh", "./unisacc.com", "tools/devsvc-core.cx", "--", "f", "read", "--help", 0}; rc = ck_run(v, out, sizeof out); }
    ca_local_assert(rc == 0 && has("devsvc f read PATH"), "f-op-help");
    { char *v[] = {"sh", "./unisacc.com", "tools/devsvc-core.cx", "--", "task", "open", "--id", "z1", "--title", "T", "--write", "tools/x.cx", "--accept", "true", "--deadline-min", "5", "--dir", d, 0}; rc = ck_run(v, out, sizeof out); }
    ca_local_assert(rc == 0 && has("TASK\topen\tz1\tdeadline_s=300\taccept=1"), "devsvc-open-ok-no-owner");
    { char *v[] = {"sh", "./unisacc.com", "tools/devsvc-core.cx", "--", "task", "status", "z1", "--dir", d, 0}; rc = ck_run(v, out, sizeof out); }
    ca_local_assert(rc == 0 && has("TASK\tz1\tstate=open") && has("ACCEPT\t1\ttrue"), "devsvc-status");
    F(c, sizeof c, "rm -rf %s", d);
    { char *v[] = {"sh", "-c", c, 0}; (void)ck_run(v, out, sizeof out); }
    printf("CHECK_DEVTASK_HELP\tfailed=%d\n", nfail);
    return nfail ? 1 : 0;
}
