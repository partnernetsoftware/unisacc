/* Checks cx/sys/reslive.cx: sy_res_live / sy_res_note registry counts.
     sh ./unisacc.com tools/check-sys-reslive.cx
   Prints PASS/FAIL lines and SYS_RESLIVE<TAB>ok=N<TAB>failed=N; exit 1 on any FAIL. */
#pragma unisa use sys.reslive
static int nok, nfail;
static void ck(int c, const char *name) {
    printf("%s\treslive.%s\n", c ? "PASS" : "FAIL", name);
    if (c) nok++; else nfail++;
}
static void ckv(long got, long want, const char *name) {
    if (got != want) printf("NOTE\treslive.%s\tgot=%ld\twant=%ld\n", name, got, want);
    ck(got == want, name);
}
int main(void) {
    ckv(sy_res_live(SY_RES_FD), 0, "init-fd");
    ckv(sy_res_live(SY_RES_PROC), 0, "init-proc");
    ckv(sy_res_live(SY_RES_MAP), 0, "init-map");
    ckv(sy_res_live(0), -EINVAL, "kind-zero");
    ckv(sy_res_live(4), -EINVAL, "kind-high");
    ckv(sy_res_live(-1), -EINVAL, "kind-neg");
    ckv(sy_res_note(SY_RES_FD, 1), 1, "fd-plus");
    ckv(sy_res_note(SY_RES_FD, 1), 2, "fd-plus2");
    ckv(sy_res_live(SY_RES_FD), 2, "fd-live2");
    ckv(sy_res_live(SY_RES_PROC), 0, "kinds-independent");
    ckv(sy_res_note(SY_RES_FD, -1), 1, "fd-minus");
    ckv(sy_res_note(SY_RES_FD, -1), 0, "fd-back-zero");
    ckv(sy_res_note(SY_RES_FD, -1), -EINVAL, "fd-double-close");
    ckv(sy_res_live(SY_RES_FD), 0, "fd-unchanged-after-reject");
    ckv(sy_res_note(SY_RES_PROC, 0), -EINVAL, "delta-zero");
    ckv(sy_res_note(SY_RES_PROC, 2), -EINVAL, "delta-two");
    ckv(sy_res_note(SY_RES_PROC, -2), -EINVAL, "delta-minus-two");
    ckv(sy_res_note(7, 1), -EINVAL, "note-bad-kind");
    ckv(sy_res_note(SY_RES_MAP, 1), 1, "map-plus");
    ckv(sy_res_live(SY_RES_MAP), 1, "map-live");
    ckv(sy_res_note(SY_RES_MAP, -1), 0, "map-minus");
    ckv(sy_res_live(SY_RES_PROC), 0, "proc-untouched");
    printf("SYS_RESLIVE\tok=%d\tfailed=%d\n", nok, nfail);
    return nfail ? 1 : 0;
}
