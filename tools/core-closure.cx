/* tools/core-closure.cx -- 44 个构造根的编译闭包生成表 build/core-closure.tsv(身份按闭包取的底座)。
 *   sh ./unisacc.com tools/core-closure.cx -- --write|--check [--table PATH]
 * 取法:build/chain-facts.tsv 的每个 root 事实,用已装产品 `-cx-plan ROOT` 取 use 闭包(与 chain-step 对象编译同一取法)。
 * 只覆盖 use 路径(via=root 或 use);include、kernel、seed 路径不在 -cx-plan 里,不由本表声明。
 * -cx-plan 与目标无关(--target 被忽略,六目标输出相同),故只有 lnx-x86_64 为实测,其余五目标写 UNMEASURED 一行。
 * 列:target unit real via bytes roots(unit=计划所列仓内路径;real=符号链接真实目标,同则同值;roots=含该单元的根数)。
 * --check 末行 SAME 或 DRIFT(重算与表比对,不写)。--table 指定比对/写入的表路径(检查夹具用)。 */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use cxlib.procrun

#define MAXU 400
#define MAXR 64
static char *roots[MAXR]; static int nroots;
static char *units[MAXU]; static char *reals[MAXU]; static int uroot[MAXU]; static int ucnt[MAXU]; static long ubytes[MAXU]; static int nu;
static char cwd[512], rcwd[512];
static void die(const char *s){fprintf(stderr,"core-closure: REFUSE %s\n",s);exit(2);}
static const char *rel(const char *p, const char *pre){ size_t n=strlen(pre); if(!strncmp(p,pre,n)&&p[n]=='/') return p+n+1; return p; }
static int isroot(const char *u){ for(int i=0;i<nroots;i++) if(!strcmp(roots[i],u)) return 1; return 0; }
static int find(const char *u){ for(int i=0;i<nu;i++) if(!strcmp(units[i],u)) return i; return -1; }
static void addunit(const char *u){
  int i=find(u);
  if(i>=0){ ucnt[i]++; return; }
  if(nu>=MAXU) die("unit bound");
  char rp[1024]; char *real; size_t n;
  if(sy_realpath(u,rp,sizeof rp)<0) die("realpath");
  real=(char*)rel(rp,rcwd);
  char *b=cx_read(u,&n); if(!b) die("read unit"); free(b);
  units[nu]=strdup(u); reals[nu]=strdup(real); ucnt[nu]=1; ubytes[nu]=(long)n; uroot[nu]=isroot(u); nu++;
}
static void collect(void){
  size_t n; char *s=cx_read("build/chain-facts.tsv",&n); if(!s) die("chain-facts");
  for(char *p=s;*p;){ char *e=strchr(p,'\n'); if(!e) break; *e=0;
    if(!strncmp(p,"root\t",5)){ char *k=strchr(p+5,'\t'); if(!k) die("root row"); if(nroots>=MAXR) die("root bound"); roots[nroots++]=strdup(k+1); }
    p=e+1; }
  free(s);
  if(sy_cwd(cwd,sizeof cwd)) die("cwd");
  if(sy_realpath(cwd,rcwd,sizeof rcwd)<0) die("cwd real");
  for(int r=0;r<nroots;r++){
    char *av[]={"sh","./unisacc.com","-cx-plan",roots[r],0}; pr_result pl; memset(&pl,0,sizeof pl);
    int t=pr_run("cx-plan",av,0,0,40,&pl);
    if(t||pl.rc||!pl.out) die("cx-plan failed");
    for(char *p=pl.out;*p;){ char *e=strchr(p,'\n'); if(!e) break; *e=0;
      char *a=strchr(p,'\t'); if(!a) die("plan row"); a++; char *b=strchr(a,'\t'); if(b) *b=0;
      addunit(rel(rel(a,cwd),rcwd)); p=e+1; }
    pr_free(&pl);
  }
  /* 插入排序 */
  for(int i=1;i<nu;i++){ char *u=units[i],*rl=reals[i]; int ur=uroot[i],uc=ucnt[i]; long ub=ubytes[i]; int j=i-1;
    while(j>=0&&strcmp(units[j],u)>0){ units[j+1]=units[j]; reals[j+1]=reals[j]; uroot[j+1]=uroot[j]; ucnt[j+1]=ucnt[j]; ubytes[j+1]=ubytes[j]; j--; }
    units[j+1]=u; reals[j+1]=rl; uroot[j+1]=ur; ucnt[j+1]=uc; ubytes[j+1]=ub; }
}
static char *render(size_t *outn){
  size_t cap=1<<20; char *o=malloc(cap); size_t at=0; char line[2048];
#define PUT(...) do { if (cx_fmt(line, sizeof line, __VA_ARGS__)) die("render bound"); size_t k_ = strlen(line); if (mm_copy(o + at, cap - at, line, k_)) die("render bound"); at += k_; } while (0)
  PUT("# Generated by tools/core-closure.cx --write; do not edit. use-closure of the %d roots in build/chain-facts.tsv via -cx-plan.\n",nroots);
  PUT("# target\tunit\treal\tvia\tbytes\troots\n");
  for(int i=0;i<nu;i++) PUT("lnx-x86_64\t%s\t%s\t%s\t%ld\t%d\n",units[i],reals[i],uroot[i]?"root":"use",ubytes[i],ucnt[i]);
  const char *oth[]={"lnx-arm64","osx-x86_64","osx-arm64","win-x86_64","win-arm64",0};
  for(int i=0;oth[i];i++) PUT("%s\tUNMEASURED\t-\t-\t-\t-\n",oth[i]);
  *outn=at; return o;
}
int main(int argc,char **argv){
  int wr=0,ck=0,nt=0; const char *tables[8]; const char *dflt="build/core-closure.tsv";
  for(int i=1;i<argc;i++){ if(!strcmp(argv[i],"--write")) wr=1; else if(!strcmp(argv[i],"--check")) ck=1; else if(!strcmp(argv[i],"--table")&&i+1<argc&&nt<8) tables[nt++]=argv[++i]; else die("usage --write|--check [--table PATH]..."); }
  if(wr==ck) die("usage --write|--check [--table PATH]...");
  if(!nt) tables[nt++]=dflt;
  if(wr&&nt!=1) die("--write takes one table");
  collect(); size_t n; char *b=render(&n);
  printf("CORE_CLOSURE\troots=%d\tlnx-x86_64_units=%d\tother_targets=UNMEASURED(5)\n",nroots,nu);
  if(wr){ if(cx_write(tables[0],b,n)) die("write"); printf("WRITE\n"); return 0; }
  int bad=0;
  for(int i=0;i<nt;i++){ size_t z; char *old=cx_read(tables[i],&z); int same=old&&z==n&&!memcmp(old,b,n); free(old);
    if(nt>1) printf("TABLE\t%s\t%s\n",tables[i],same?"SAME":"DRIFT"); if(!same) bad=1; }
  printf(bad?"DRIFT\n":"SAME\n"); return bad;
}
