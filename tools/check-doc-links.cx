/* Checks tools/doc-links.cx: sh ./unisacc.com tools/check-doc-links.cx   (from the repo root)
   On tools/doc-links/fixture/docs/t.md: four links are checked (the https, #anchor, inline-code and fenced
   ones are not) and three are BROKEN (exit 1).  --fix-moved on a copy at out/check-doc-links-PID/docs/t.md
   rewrites the two whose file name is tracked once (exec/c/compiler.c and exec/enc/CONTROL_AUDIT.md, both
   under archive/reference-c/) to paths relative to the copy, both on one line, and leaves the third
   BROKEN; a second plain run of the copy then finds one broken link.
   Prints PASS/FAIL lines and CHECK_DOC_LINKS<TAB>failed=N. */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use sys.time
#pragma unisa use sysx.poll
#pragma unisa use sys.posix
#pragma unisa use sys.env

/* an unlinked spool file the drained output of a bounded child goes to */
static int spool_open(void) {
    char t[4096];
    int fd;
    if (cx_fmt(t, sizeof t, "%s/r2b-XXXXXX", sy_tmpdir())) return -1;
    fd = mkstemp(t);
    if (fd >= 0) sy_unlink(t);
    return fd;
}

/* sy_spawn_pipe with a 50 s deadline: the child's stdout (and stderr when EFD is given) is drained here with sy_poll
   into spool files; past the deadline its process group is killed.  OFD/EFD come back as the spool files, rewound,
   and the child is NOT reaped: the caller's sy_wait_status(pid) still reports its real status (128+9 when killed). */
static int spawn_pipe_bounded(char **argv, const char *cwd, int flags, int *ofd, int *efd) {
    int po = -1, pe = -1, pid, fo, fe = -1, open_o = 1, open_e = efd ? 1 : 0, killed = 0;
    long deadline = sy_now_ms() + 50000;
    char chunk[16384];
    pid = sy_spawn_pipe(argv, cwd, flags, &po, efd ? &pe : 0);
    if (pid < 0) return pid;
    fo = spool_open();
    if (efd) fe = spool_open();
    if (fo < 0 || (efd && fe < 0)) { sy_killpg(pid, 9); sy_signal(pid, 9); sy_close(po); if (efd) sy_close(pe); return -EIO; }
    while (open_o || open_e) {
        sy_pollfd_t p[2];
        int n = 0, io = -1, ie = -1, r;
        long left = deadline - sy_now_ms(), g;
        if (left <= 0) {
            if (killed) break;
            sy_killpg(pid, 9); sy_signal(pid, 9); killed = 1; deadline = sy_now_ms() + 2000;
            continue;
        }
        if (open_o) { io = n; p[n].fd = po; p[n].events = SY_POLLIN; p[n].revents = 0; n++; }
        if (open_e) { ie = n; p[n].fd = pe; p[n].events = SY_POLLIN; p[n].revents = 0; n++; }
        r = sy_poll(p, n, left > 200 ? 200 : left);
        if (r < 0) break;
        if (io >= 0 && p[io].revents) {
            g = sy_read(po, chunk, sizeof chunk);
            if (g > 0) { if (sy_write_all(fo, chunk, g)) break; } else open_o = 0;
        }
        if (ie >= 0 && p[ie].revents) {
            g = sy_read(pe, chunk, sizeof chunk);
            if (g > 0) { if (sy_write_all(fe, chunk, g)) break; } else open_e = 0;
        }
    }
    if (open_o || open_e) { sy_killpg(pid, 9); sy_signal(pid, 9); }
    sy_close(po);
    if (efd) sy_close(pe);
    sy_lseek(fo, 0, 0);
    *ofd = fo;
    if (efd) { sy_lseek(fe, 0, 0); *efd = fe; }
    return pid;
}

static int failed;
static void ck(int ok, const char *name) { if (!ok) failed++; printf("%s\tdoc-links.%s\n", ok ? "PASS" : "FAIL", name); }

static int dl(char **args, char *out, long cap) {
    char *argv[10]; int i = 0, k, ofd, pid, ex = 0, code = 0, sig = 0; long n = 0, r; char junk[4096];
    argv[i++] = "sh"; argv[i++] = "./unisacc.com"; argv[i++] = "tools/doc-links.cx"; argv[i++] = "--";
    for (k = 0; args[k] && i < 9; k++) argv[i++] = args[k];
    argv[i] = 0;
    pid = spawn_pipe_bounded(argv, 0, 0, &ofd, 0);
    if (pid < 0) return -1;
    while ((r = sy_read(ofd, out + n, cap - 1 - n)) > 0) n += r;
    out[n] = 0;
    while (sy_read(ofd, junk, sizeof junk) > 0) {}
    sy_close(ofd);
    if (sy_wait_status(pid, 0, &ex, &code, &sig) != pid || !ex) return -1;
    return code;
}
/* structural row assertion over tool output: no substring search.  A trailing newline anchors at the line end; the needle must
   match from some tab-separated field start (a field-sequence prefix of that line). */
static int has(const char *s, const char *needle) {
    long n = tx_len(s, 1 << 16), qe = tx_len(needle, 512), p = 0;
    int eol = 0;
    if (qe > 0 && needle[qe - 1] == '\n') { eol = 1; qe--; }
    while (p < n) {
        long e = p, f;
        while (e < n && s[e] != '\n') e++;
        for (f = p; f <= e; f++) {
            if (f > p && s[f - 1] != '\t') continue;
            if (e - f >= qe && tx_prefix(s + f, e - f, needle, qe) && (!eol || e - f == qe)) return 1;
        }
        p = e + 1;
    }
    return 0;
}
/* number of output lines starting with PAT */
static int nlines(const char *s, const char *pat) {
    long n = tx_len(s, 1 << 16), pl = tx_len(pat, 512), p = 0; int c = 0;
    while (p < n) {
        long e = p;
        while (e < n && s[e] != '\n') e++;
        if (e - p >= pl && tx_prefix(s + p, e - p, pat, pl)) c++;
        p = e + 1;
    }
    return c;
}

int main(void) {
    static char o[1 << 16]; char dir[200], docs[240], copy[280]; size_t n; char *src, *after; int rc;
    char *a1[] = {"tools/doc-links/fixture/docs/t.md", 0};
    rc = dl(a1, o, sizeof o);
    ck(rc == 1 && has(o, "DOC_LINKS\tfiles=1\tlinks=4\tbroken=3\tfixed=0\n") && has(o, "BROKEN\ttools/doc-links/fixture/docs/t.md:6\tmissing-nowhere.md\n")
       && nlines(o, "BROKEN\t") == 3 && !has(o, "nope.md") && !has(o, "nope2.md"), "check-four-links-three-broken-code-skipped");
    if (cx_fmt(dir, sizeof dir, "out/check-doc-links-%d", sy_pid()) || cx_fmt(docs, sizeof docs, "%s/docs", dir) || cx_fmt(copy, sizeof copy, "%s/t.md", docs)) return 2;
    src = cx_read("tools/doc-links/fixture/docs/t.md", &n);
    if (!src || sy_mkdir(dir, 0755) || sy_mkdir(docs, 0755)) return 2;
    {   int fd = sy_open_new(copy, 0644); if (fd < 0 || sy_write_all(fd, src, (long)n) || sy_close(fd)) return 2; }
    {   char *a2[] = {"--fix-moved", copy, 0};
        rc = dl(a2, o, sizeof o);
        after = cx_read(copy, &n);
        ck(rc == 1 && has(o, "fixed=2") && has(o, "broken=1") && after
           && nlines(after, "[a](../../../archive/reference-c/exec/c/compiler.c) and [b](../../../archive/reference-c/exec/enc/CONTROL_AUDIT.md)") == 1,
           "fix-moved-two-on-one-line");
    }
    {   char *a3[] = {copy, 0};
        rc = dl(a3, o, sizeof o);
        ck(rc == 1 && has(o, "links=4\tbroken=1\tfixed=0\n"), "fixed-links-resolve");
    }
    sy_unlink(copy);
    printf("CHECK_DOC_LINKS\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
