/* Checks ext.textx json.cx: parse/accessors/path/escape, strict rejects, surrogates, depth, truncation, speed. */
#pragma unisa use text.json
#pragma unisa use sys.time
#pragma unisa use sys.fs
#pragma unisa use mem.bytes
static int bad, total;
static void ok(int c, const char *name) { total++; printf("%s\t%s\n", c ? "PASS" : "FAIL", name); if (!c) bad++; }
static int rej(const char *s, const char *name) {
    char e[96]; js_val *v = js_parse(s, (long)strlen(s), e, sizeof e);
    ok(v == 0 && memcmp(e, "offset ", 7) == 0, name);
    js_free(v);
    return v == 0;
}
static int acc(const char *s, const char *name) {
    char e[96]; js_val *v = js_parse(s, (long)strlen(s), e, sizeof e);
    ok(v != 0, name);
    js_free(v);
    return v != 0;
}
int main(void) {
    char e[96], buf[256]; long ol = 0; js_val *v; int i;
    const char *t = "{\"message\":{\"role\":\"user\",\"content\":\"hi\\n\\\"x\\\"\"},\"n\":-12.5e1,\"ok\":true,\"z\":null,\"a\":[1,[2,3],{\"k\":\"v\"}]}";
    v = js_parse(t, (long)strlen(t), e, sizeof e);
    ok(v && js_kind(v) == JS_OBJ && js_len(v) == 5, "obj-parse");
    ok(js_str(js_path(v, "message.content")) && strcmp(js_str(js_path(v, "message.content")), "hi\n\"x\"") == 0, "path-content-unescaped");
    ok(js_num(js_get(v, "n")) == -125.0, "num-exp");
    ok(js_kind(js_get(v, "ok")) == JS_BOOL && js_bool(js_get(v, "ok")) == 1, "bool");
    ok(js_kind(js_get(v, "z")) == JS_NULL, "null");
    ok(js_len(js_get(v, "a")) == 3 && js_num(js_at(js_at(js_get(v, "a"), 1), 1)) == 3.0, "arr-at");
    ok(strcmp(js_str(js_path(v, "a.2.k")), "v") == 0, "path-array-index");
    ok(js_path(v, "a.9") == 0 && js_path(v, "message.nope") == 0 && js_get(v, "missing") == 0, "path-miss");
    ok(js_at(0, 0) == 0 && js_kind(0) == JS_NONE && js_str(js_get(v, "n")) == 0, "null-safe");
    js_free(v);
    acc(" [ ] ", "ws-empty-arr");
    acc("\"\"", "empty-str-scalar");
    acc("0", "zero");
    acc("-0.0e-0", "neg-zero-exp");
    acc("{\"a\":{}}", "nested-empty-obj");
    rej("", "rej-empty");
    rej("{\"a\":1} x", "rej-trailing");
    rej("[1,]", "rej-trailing-comma");
    rej("01", "rej-leading-zero");
    rej("1.", "rej-frac-no-digit");
    rej(".5", "rej-dot-start");
    rej("+1", "rej-plus");
    rej("1e", "rej-exp-no-digit");
    rej("-", "rej-minus-only");
    rej("\"a\tb\"", "rej-raw-control");
    rej("\"\\x\"", "rej-bad-escape");
    rej("\"abc", "rej-unterminated");
    rej("{a:1}", "rej-unquoted-key");
    rej("tru", "rej-bad-literal");
    rej("NaN", "rej-nan");
    v = js_parse("[1, 2 x]", 8, e, sizeof e);
    ok(v == 0 && memcmp(e, "offset 6:", 9) == 0, "err-offset-6");
    v = js_parse("\"\\ud83d\\ude00\\u00e9\\u4e2d\"", 26, e, sizeof e);
    ok(v && js_str_len(v) == 9 && memcmp(js_str(v), "\xf0\x9f\x98\x80\xc3\xa9\xe4\xb8\xad", 9) == 0, "surrogate-pair-utf8");
    js_free(v);
    rej("\"\\ud83d\"", "rej-lone-high");
    rej("\"\\ude00\"", "rej-lone-low");
    rej("\"\\ud83d\\u0041\"", "rej-high-then-nonlow");
    rej("\"\\u12g4\"", "rej-bad-hex");
    {
        char d[400]; int k;
        for (k = 0; k < 128; k++) d[k] = '['; for (k = 0; k < 128; k++) d[128 + k] = ']';
        v = js_parse(d, 256, e, sizeof e); ok(v != 0, "depth-128-ok"); js_free(v);
        for (k = 0; k < 129; k++) d[k] = '['; for (k = 0; k < 129; k++) d[129 + k] = ']';
        v = js_parse(d, 258, e, sizeof e); ok(v == 0 && strstr(e, "depth") != 0, "depth-129-rejected");
    }
    i = js_esc(buf, sizeof buf, "a\"b\\\n\x01", 6, &ol);
    ok(i == 1 && strcmp(buf, "a\\\"b\\\\\\n\\u0001") == 0 && ol == 14, "esc-full");
    i = js_esc(buf, 4, "ab\"cd", 5, &ol);
    ok(i == 0 && strcmp(buf, "ab") == 0 && ol == 2, "esc-truncated-whole-escape");
    ok(js_esc(buf, 1, "", 0, &ol) == 1 && buf[0] == 0, "esc-empty");
    ok(js_esc(0, 4, "a", 1, &ol) == -1, "esc-bad-args");
    {
        static char big[420000]; long n = 0, lines = 0, okc = 0, t0, t1; const char *row = "{\"type\":\"assistant\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"hello \\u4e2d world\"}]},\"n\":12345}\n";
        long rl = (long)strlen(row), st = 0, k;
        while (n + rl < (long)sizeof big - 1) { mm_copy(big + n, (long)sizeof big - n, row, rl); n += rl; lines++; }
        t0 = sy_now_ms();
        for (k = 0; k < n; k++) if (big[k] == '\n') {
            js_val *x = js_parse(big + st, k - st, e, sizeof e);
            if (x && js_str(js_path(x, "message.content.0.text"))) okc++;
            js_free(x); st = k + 1;
        }
        t1 = sy_now_ms();
        printf("perf\tbytes=%ld\tlines=%ld\tms=%ld\n", n, lines, (t1 - t0));
        ok(okc == lines, "perf-all-lines-parsed");
        printf("NOTE\tperf-400kb\tms=%ld\n", (t1 - t0));
    }
    /* ---- RFC 8259 conformance suite + known-divergence manifest + seeded fuzz ---- */
    {
        static const char *y_cases[] = {
            "null", "true", "false", "0", "-0", "42", "-42", "3.14159", "-0.001e+2", "1E-10",
            "\"\"", "\"hello\"", "\"\\\"\\\\\\/\\b\\f\\n\\r\\t\"", "\"\\u0000\"", "\"\\u0041\"",
            "\"\\uD834\\uDD1E\"", "[]", "[1,2,3]", "[true,false,null,\"\",{},[]]",
            "{}", "{\"\":1}", "{\"a\":1,\"a\":2}", "{\"a\":[{\"b\":[1,2,3]}]}",
            " \t\r\n{\"k\" : [ 1 , 2 ] }\r\n "
        };
        static const char *n_cases[] = {
            "", " ", "nullx", "trux", "fals", "True", "False", "NULL", "undefined", "Infinity", "-Infinity", "NaN",
            "00", "-01", "+0", "+1", ".1", "1.", "-.", "1e", "1e+", "1e-", "1.e1", "--1",
            "[", "]", "[,]", "[1,]", "[1,,2]", "[1 2]", "{", "}", "{,}", "{\"a\":1,}", "{\"a\"}", "{\"a\":}",
            "{1:2}", "{a:1}", "\"unterminated", "\"raw\nnewline\"", "\"raw\rreturn\"", "\"raw\x01ctrl\"",
            "\"\\a\"", "\"\\u123\"", "\"\\u123g\"", "\"\\uD800\"", "\"\\uDC00\"", "\"\\uD800\\u0041\"",
            "\xef\xbb\xbf{}", "1 2", "{} []", "[] trailing"
        };
        typedef struct { const char *id; const char *data; long len; int kind; } div_case_t;
        /* kind: 0 = must reject, 1 = i64 exact (9007199254740993), 2 = must reject overflow */
        static const div_case_t div_cases[] = {
            {"div-utf8-invalid-fffe", "\"\xff\xfe\"", 4, 0},
            {"div-utf8-overlong-c080", "\"\xc0\x80\"", 4, 0},
            {"div-utf8-truncated-3byte", "\"\xe2\x82\"", 4, 0},
            {"div-i64-precision-9007199254740993", "9007199254740993", 16, 1},
            {"div-num-overflow-1e400", "1e400", 5, 2}
        };
        unsigned char *kbuf = 0;
        int64_t klen = 0;
        char known_ids[32][64];
        int nknown = 0;
        int c_acc = 0, c_rej = 0, c_div = 0, c_unk = 0;
        int ci;
        if (sy_read_file("tests/json-conform-known.tsv", &kbuf, &klen, 65536) == 0 && kbuf && klen > 0) {
            long pos = 0;
            while (pos < (long)klen && nknown < 32) {
                long ls = pos;
                while (pos < (long)klen && kbuf[pos] != '\n') pos++;
                long ll = pos - ls;
                if (pos < (long)klen) pos++;
                if (ll > 0 && kbuf[ls] != '#') {
                    long t = 0;
                    while (t < ll && kbuf[ls + t] != '\t' && t < 63) t++;
                    if (t > 0) {
                        mm_copy(known_ids[nknown], 64, kbuf + ls, t);
                        known_ids[nknown][t] = 0;
                        nknown++;
                    }
                }
            }
        }
        ok(nknown == 5, "conform-known-manifest-loaded");
        for (ci = 0; ci < (int)(sizeof(y_cases) / sizeof(y_cases[0])); ci++) {
            js_val *jv = js_parse(y_cases[ci], (long)strlen(y_cases[ci]), e, sizeof e);
            if (jv) c_acc++; else { c_unk++; printf("FAIL\tconform-y-%d\t%s\n", ci, e); }
            js_free(jv);
        }
        for (ci = 0; ci < (int)(sizeof(n_cases) / sizeof(n_cases[0])); ci++) {
            long nl = (long)strlen(n_cases[ci]);
            js_val *jv = js_parse(n_cases[ci], nl, e, sizeof e);
            if (!jv && memcmp(e, "offset ", 7) == 0) c_rej++;
            else { c_unk++; printf("FAIL\tconform-n-%d\n", ci); }
            js_free(jv);
        }
        for (ci = 0; ci < (int)(sizeof(div_cases) / sizeof(div_cases[0])); ci++) {
            int diverged = 0;
            js_val *jv = js_parse(div_cases[ci].data, div_cases[ci].len, e, sizeof e);
            if (div_cases[ci].kind == 0) {
                if (jv != 0) diverged = 1;
            } else if (div_cases[ci].kind == 1) {
                if (!jv || (long long)js_num(jv) != 9007199254740993LL) diverged = 1;
            } else if (div_cases[ci].kind == 2) {
                if (jv != 0) diverged = 1;
            }
            js_free(jv);
            if (diverged) {
                int j, listed = 0;
                for (j = 0; j < nknown; j++) if (strcmp(known_ids[j], div_cases[ci].id) == 0) listed = 1;
                if (listed) c_div++; else { c_unk++; printf("FAIL\tconform-unlisted-div\t%s\n", div_cases[ci].id); }
            }
        }
        /* Self-check: dropping one row from the known list must produce unknown divergence. */
        {
            int sim_unk = 0;
            for (ci = 0; ci < (int)(sizeof(div_cases) / sizeof(div_cases[0])); ci++) {
                int j, listed = 0;
                for (j = 1; j < nknown; j++) if (strcmp(known_ids[j], div_cases[ci].id) == 0) listed = 1;
                if (!listed) sim_unk++;
            }
            ok(sim_unk == 1, "conform-drop-one-known-fails");
        }
        ok(c_acc == (int)(sizeof(y_cases) / sizeof(y_cases[0])), "conform-all-accept");
        ok(c_rej == (int)(sizeof(n_cases) / sizeof(n_cases[0])), "conform-all-reject");
        ok(c_div == nknown && c_unk == 0, "conform-divergences-match-manifest");
        printf("JSON_CONFORM\taccept=%d\treject=%d\tknown_div=%d\tunknown_div=%d\n", c_acc, c_rej, c_div, c_unk);

        /* Deterministic seeded fuzz + all-proper-prefix invariant */
        {
            unsigned long long rng = 0x5eed8259ULL;
            int prefixes = 0, muts = 0, bad_off = 0;
            int si;
            for (si = 0; si < 12; si++) {
                const char *s = y_cases[si * 2];
                long sl = (long)strlen(s), pl;
                for (pl = 0; pl < sl; pl++) {
                    js_val *pv = js_parse(s, pl, e, sizeof e);
                    prefixes++;
                    if (!pv) {
                        if (memcmp(e, "offset ", 7) != 0) bad_off++;
                        else {
                            long off = 0; int p = 7, hasd = 0;
                            while (e[p] >= '0' && e[p] <= '9') { off = off * 10 + (e[p] - '0'); p++; hasd = 1; }
                            if (!hasd || e[p] != ':' || off < 0 || off > pl) bad_off++;
                        }
                    }
                    js_free(pv);
                }
            }
            for (si = 0; si < 1200; si++) {
                const char *src; long sl; char mb[128]; long ml; int op;
                rng ^= rng << 13; rng ^= rng >> 7; rng ^= rng << 17;
                src = y_cases[(int)(rng % (sizeof(y_cases) / sizeof(y_cases[0])))];
                sl = (long)strlen(src);
                if (sl > 100) sl = 100;
                mm_copy(mb, sizeof mb, src, sl);
                ml = sl;
                rng ^= rng << 13; rng ^= rng >> 7; rng ^= rng << 17;
                op = (int)(rng % 4);
                if (op == 0 && ml > 0) {
                    long idx = (long)((rng >> 8) % (unsigned long long)ml);
                    mb[idx] ^= (char)(1 + ((rng >> 24) & 0x7f));
                } else if (op == 1 && ml > 0) {
                    ml = (long)((rng >> 8) % (unsigned long long)ml);
                } else if (op == 2 && ml < 110) {
                    long idx = ml ? (long)((rng >> 8) % (unsigned long long)ml) : 0;
                    long k;
                    for (k = ml; k > idx; k--) mb[k] = mb[k - 1];
                    mb[idx] = (char)((rng >> 20) & 0xff);
                    ml++;
                } else if (op == 3 && ml > 1) {
                    long idx = (long)((rng >> 8) % (unsigned long long)ml);
                    long k;
                    for (k = idx; k + 1 < ml; k++) mb[k] = mb[k + 1];
                    ml--;
                }
                {
                    js_val *mv = js_parse(mb, ml, e, sizeof e);
                    muts++;
                    if (!mv) {
                        if (memcmp(e, "offset ", 7) != 0) bad_off++;
                        else {
                            long off = 0; int p = 7, hasd = 0;
                            while (e[p] >= '0' && e[p] <= '9') { off = off * 10 + (e[p] - '0'); p++; hasd = 1; }
                            if (!hasd || e[p] != ':' || off < 0 || off > ml) bad_off++;
                        }
                    }
                    js_free(mv);
                }
            }
            ok(bad_off == 0, "fuzz-prefix-and-mut-offset-in-bounds");
            printf("JSON_FUZZ\tprefixes=%d\tmutations=%d\tcrashes=0\tbad_offset=%d\n", prefixes, muts, bad_off);
        }
    }
    printf("total=%d failed=%d\n", total, bad);
    printf("%s\n", bad ? "JSON_CHECK FAIL" : "JSON_CHECK");
    return bad;
}
