/* tools/release-run.cx -- 0.0.50 R / 0.0.51 H8:一键发布可续跑流程(发布编排,不构造候选)。
 *
 * 串 runbook 步骤 8-19 为带状态机的可续跑流程;严格按「提交 X(候选表)触发 CI ->
 * 提交 Y 回填 run id」两段提交;所有 gh 带 -R partnernetsoftware/unisacc。
 *
 *   sh ./unisacc.com tools/release-run.cx -- --dry-run ROOT CANDIDATE_TSV LAYOUT_DIR OUT_DIR
 *     本地重放:release-layout --check、SHA256SUMS 校验、release-dispatch --dry-run、
 *     release-decide(证据取 OUT_DIR/evidence.tsv,缺则 8xUNKNOWN)。不创建/修改 release,
 *     不触发 CI,不 push。输出与人工逐步执行逐行对照。
 *   sh ./unisacc.com tools/release-run.cx -- --pack ROOT CANDIDATE_TSV SRC_DIR OUT_DIR --chain-out CHAIN_DIR [--snap SNAP]
 *     H8 实跑化(本地重放打包,零网络零 gh):输入=ROOT 内候选表私有副本 + SRC_DIR
 *     候选目录(六片 + P4 + cache-manager 两份 + sources.tsv),自动:
 *     chain checkpoint、compare 尝试日志与 g2/g3 六片均须有完整同字节证据;UNKNOWN 一律拒绝。
 *       4 ape-pack   release-ape pack --osx-slices --cache-manager-osx 显式输入,
 *                    OUT_DIR/ape/unisacc-next.com 即 unisacc.com;
 *       5 inject     tools/version-inject.cx 对第六片注入表内版本,得 slice-win-arm64;
 *       6 layout     p3-package.body -> pkg.bin;按表 commit/version 与 sources.tsv 的
 *                    sources_sha256、APE sha 生成 build.json 与别名
 *                    unisacc.com.build.json;release-layout --candidate 生成
 *                    OUT_DIR/layout(含 zip 与 SHA256SUMS)并自带 --check;
 *       7 backfill   候选表 7 个哈希列由 OUT_DIR/layout 内产物文件 sha256 计算回填
 *                    (不手填),写 OUT_DIR/candidate.tsv 并 rcand_verify 7 资产;
 *       8 sums       layout 内 sha256sum --check;
 *       9 commands   只打印下一步命令:草稿创建 gh release create --draft、资产上传
 *                    gh release upload、CI 触发 gh workflow run(commit=提交 X)、
 *                    公开 gh release edit --draft=false --latest、改标签
 *                    gh release edit --tag NEW --target 完整 40 位(先改标签后公开,
 *                    永不先删旧标签;target 非 40 位拒绝)。全部仅打印,不执行;
 *                    CI 与公开两步保持人工确认。
 *   sh ./unisacc.com tools/release-run.cx -- --resume OUT_DIR
 *     从 OUT_DIR/state.tsv 记录的下一未完步继续;每步先核对前置产物身份。
 *
 *   --pack 追加选项(N-05 最小切片):
 *     --commit HEX40|HEAD  打包前把候选表 commit 字段回填为冻结提交:提交须在调用仓可解析,
 *                    其 release/candidate.tsv 的 version/tag 与输入表相同,输入表原 commit 须是
 *                    它的祖先或相等,否则 RELEASE_PACK_NOT_FREEZE_POINT / RELEASE_PACK_COMMIT_MISMATCH;
 *                    回填写 OUT_DIR/candidate-in.tsv 并打印前后值;已相等时空操作(表与产物字节不变)。
 *                    不给 --commit 时不回填(保持旧语义)。build.json 写出后回读,commit 须等于
 *                    回填值且等于 SID 实核所用快照的提交,否则 RELEASE_PACK_COMMIT_MISMATCH。
 *     --cm-sha X64 ARM64  cache-manager 期望 sha256;缺省读 ROOT/release/evidence/<version>/cache-manager.tsv。
 *     cache-manager 回落:SRC_DIR 下缺失或空文件时,先找持久副本
 *       ($UNISACC_RELEASE_CACHE 或 ~/.cache/unisacc 下 release-*\/cm/<role>、release-*\/<role>、
 *       release-cm/<sha8>/<role>,sha256 须等于期望值),找不到才用 ROOT 产品跑
 *       tools/cache-retain.cx -b osx/x86_64|osx/arm64 重建,sha256 须逐字节相等否则
 *       RELEASE_PACK_CM_SHA_MISMATCH;重建结果写入 release-cm/<sha8>/<role>。ape-pack 成功后
 *       把两份的 role/sha256/path/来源写 OUT_DIR/cache-manager.tsv 与
 *       ROOT/release/evidence/<version>/cache-manager.tsv。
 *   sh ./unisacc.com tools/release-run.cx -- --prepare VERSION --layout DIR [--out DIR] [...]
 *     B4: forwarded unchanged to tools/release-prep.cx (pre-publication drafts, no repo edit).
 *   sh ./unisacc.com tools/release-run.cx -- --plan CANDIDATE_TSV
 *     只列发布对外段固定顺序(X 提交、草稿、CI、Y1、公开、读回、Y2)每步的命令原文、
 *     前置门与回滚;不执行任何命令,零网络零 gh。
 *
 * SRC_DIR 输入约定(H8,与 0.0.50 后备重放 /tmp/cc-rel50 一致的文件名):
 *   p3.pkg win-x86_64 lnx-x86_64 lnx-arm64 osx-x86_64 osx-arm64 win-arm64
 *   cache-manager-x64 cache-manager-arm64 sources.tsv(一行 64 位 sources_sha256)
 * 步骤(state.tsv 追加 STEP<TAB>idx<TAB>name<TAB>DONE|REFUSED):
 *   0 layout-check  1 sums-check  2 dispatch-replay  3 decide
 *   4 ape-pack  5 inject  6 layout-gen  7 backfill  8 sums  9 commands
 * 真跑(--run,后续补丁扩展 10..)按 runbook:提交X -> 草稿 -> 分批上传 -> 机查 ->
 * workflow run(commit=X) -> 回填 run id 提交Y -> 终裁 -> 公开 -> 读回。
 * 子进程均 <=50s 有界。 */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use sys.sig
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.releasecandidate
#pragma unisa use cxlib.releaseversion
#pragma unisa use cxlib.relsha
#pragma unisa use cxlib.chainroot
static char root[4096], table[4048], layout[4048], out[4048], statep[4448], srcdir[4048], layoutout[4448], snapdir[4096];
static char chainout[4096];
static RcCandidate cand;
/* Commit backfill and cache-manager resolution state (N-05 minimal slice). */
static char commitarg[64], frozen[64], here[4096], sidcommit[64];
static char cmpath[2][4400], cmsha[2][65], cmwhere[2][16], cmwant[2][65];
static const char *cm_role[2] = {"x64", "arm64"};
static const char *cm_leaf[2] = {"cache-manager-x64", "cache-manager-arm64"};
static const char *cm_target[2] = {"osx/x86_64", "osx/arm64"};
static void commit_mismatch(const char *what, const char *a, const char *b);

static void die(const char *s) { sy_eprintf("release-run: REFUSE %s\n", s); sy_exit(2); }
static long tlen(const char *s) { return tx_len(s, 1 << 20); }
static void emit(const char *tag, const char *a, const char *b) {
    sy_printf("RELEASE_RUN\t%s\t%s%s%s\n", tag, a, b ? "\t" : "", b ? b : "");
}
static void mark(int idx, const char *name, const char *verdict) {
    char line[256];
    if (cx_fmt(line, sizeof line, "STEP\t%d\t%s\t%s\n", idx, name, verdict)) die("state-format");
    { int f = sy_open(statep, O_WRONLY | O_CREAT | O_APPEND, 0600);
      if (f < 0 || sy_write_all(f, line, tlen(line)) || sy_close(f)) die("state-write"); }
    emit("STEP", name, verdict);
}
static int child(char **v, const char *cwd) {
    np_result r = {0}; char why[512] = {0}; int rc;
    if (np_run(v, cwd, 0, 50, &r, why, sizeof why)) { np_free(&r); die("child-transport"); }
    rc = r.rc;
    if (r.outn) sy_write_all(1, r.out ? r.out : "", r.outn);
    if (r.errn) sy_write_all(2, r.err ? r.err : "", r.errn);
    np_free(&r);
    return rc;
}
static void step_layout_check(void) {
    char *v[] = {"sh", "unisacc.com", "tools/release-layout.cx", "--", "--candidate", table, "--check", layout, 0};
    if (child(v, root)) die("layout --check");
    mark(0, "layout-check", "DONE");
}
static void step_sums(void) {
    char *v[] = {"sha256sum", "--check", "SHA256SUMS", 0};
    if (child(v, layout)) die("sha256sum --check");
    mark(1, "sums-check", "DONE");
}
static void step_dispatch(void) {
    char *v[] = {"sh", "unisacc.com", "tools/release-dispatch.cx", "--", "--dry-run", table, layout, 0};
    if (child(v, root)) die("dispatch replay");
    mark(2, "dispatch-replay", "DONE");
}
static void step_decide(void) {
    char p[4400]; char *v[12]; int n = 0;
    if (cx_fmt(p, sizeof p, "%s/evidence.tsv", out)) die("path");
    v[n++] = "sh"; v[n++] = "unisacc.com"; v[n++] = "tools/release-decide.cx"; v[n++] = "--";
    v[n++] = "--candidate"; v[n++] = table;
    v[n++] = "--evidence"; v[n++] = p;
    v[n++] = "--assets"; v[n++] = layout;
    v[n] = 0;
    if (child(v, root)) die("decide");
    mark(3, "decide", "DONE");
}

/* ---- H8: --pack 本地重放 -------------------------------------------------- */

static void sha_of(const char *cwd, const char *path, char hex[65]) {
    char *v[] = {"sha256sum", "--", (char *)path, 0};
    np_result r = {0}; char why[256] = {0}; int i, bad = 0;
    if (np_run(v, cwd, 0, 20, &r, why, sizeof why) || r.rc || r.outn < 66) die("sha256sum");
    for (i = 0; i < 64; i++) {
        char c = r.out[i];
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) bad = 1;
        hex[i] = c;
    }
    hex[64] = 0; np_free(&r);
    if (bad) die("digest");
}
static void need(const char *dir, const char *name) {
    char p[4400];
    if (cx_fmt(p, sizeof p, "%s/%s", dir, name)) die("path");
    if (sy_exists(p) != 1) die(name);
}
/* chain-run writes ATTEMPT bindings and chain-run-N.stdout in --out.
 * chain-step emits CHAIN/fixedpoint verdicts; no guessed compare.log is trusted.
 * The six files below are the pack inputs (Linux entry.elf), not wrapper candidates. */
static char *pack_chain_text(const char *leaf){
    char p[4400];sy_stat_t st;size_t n=0;
    if(!chainout[0]||chainout[0]!='/'||cx_fmt(p,sizeof p,"%s/%s",chainout,leaf))die("UNKNOWN chain output");
    if(sy_stat(p,&st)||st.kind!='f'||st.size<=0||st.size>(1L<<26))die("UNKNOWN chain evidence missing or invalid");
    char *b=cx_read(p,&n);
    if(!b||n!=(size_t)st.size||b[n-1]!='\n'||memchr(b,0,n)||memchr(b,'\r',n)){free(b);die("UNKNOWN chain evidence text");}
    return b;
}
static int pack_fields(char *p,char **f,int cap){
    int n=0;for(;;){if(n==cap)return -1;f[n++]=p;char *q=strchr(p,'\t');if(!q)return n;*q=0;p=q+1;}
}
static long pack_number(const char *p){
    long n=0;if(!p||!*p)return -1;
    for(;*p;p++){if(*p<'0'||*p>'9'||n>(2147483647L-(*p-'0'))/10)return -1;n=n*10+*p-'0';}return n;
}
static void pack_chain_gate(void){
    char *b=pack_chain_text("checkpoint.tsv");int done=0;
    for(char *p=b;*p;){char *e=strchr(p,'\n'),*f[8];*e=0;int n=pack_fields(p,f,8);
        if(n>=2&&tx_eqz(f[1],"compare")){if(!tx_eqz(f[0],"DONE")){free(b);die("UNKNOWN compare checkpoint");}done=1;}p=e+1;
    }
    free(b);if(!done)die("UNKNOWN compare checkpoint not DONE");
    b=pack_chain_text("chain-run.tsv");long attempt=0,previous=0,recheck=0;int success=0,previous_recheck=0,memo=0;
    for(char *p=b;*p;){char *e=strchr(p,'\n');*e=0;
        if(!strncmp(p,"ATTEMPT\t",8)){
            char *f[8];int n=pack_fields(p,f,8);
            if(n!=7){free(b);die("UNKNOWN compare attempt schema");}
            if(tx_eqz(f[2],"phase=compare")){
                long id=pack_number(f[1]);if(id<=attempt){free(b);die("UNKNOWN compare attempt identity");}
                attempt=id;memo=tx_eqz(f[6],"memo=on");
                recheck=memo&&previous_recheck&&previous==id-1?previous:0;
                success=tx_eqz(f[3],"rc=0")&&tx_eqz(f[4],"residue=0")&&(tx_eqz(f[6],"memo=off")||(memo&&recheck))&&
                    !strncmp(f[5],"bound=",6)&&pack_number(f[5]+6)>0;
            }
            previous=pack_number(f[1]);
            previous_recheck=tx_eqz(f[2],"phase=compare-recheck")&&tx_eqz(f[3],"rc=0")&&tx_eqz(f[4],"residue=0")&&
                tx_eqz(f[6],"memo=off")&&!strncmp(f[5],"bound=",6)&&pack_number(f[5]+6)>0;
        }
        p=e+1;
    }
    free(b);if(!attempt||!success)die("UNKNOWN compare attempt not successful and memo-free");
    char leaf[100];if(cx_fmt(leaf,sizeof leaf,"chain-run-%ld.stdout",attempt))die("compare log path");
    if(memo){
        char rleaf[100];if(cx_fmt(rleaf,sizeof rleaf,"chain-run-%ld.stdout",recheck))die("compare recheck log path");
        b=pack_chain_text(rleaf);int full=0;
        for(char *p=b;*p;){char *e=strchr(p,'\n');*e=0;
            if(tx_eqz(p,"RECHECK\tbefore=compare\tfull=1\tmemo=off\tbuilt=0"))full++;
            p=e+1;
        }
        free(b);if(full!=1)die("UNKNOWN compare full recheck proof");
    }
    b=pack_chain_text(leaf);int seen=0,off=0;const char *kind[4]={"objects","kernels","slices","product"};
    for(char *p=b;*p;){char *e=strchr(p,'\n');*e=0;
        if(tx_eqz(p,"SHAMEMO\tchain\toff\treason=reached-compare")){
            if(seen||off){free(b);die("UNKNOWN compare memo shutdown order");}off=1;
        }else if(off&&!strncmp(p,"SHAMEMO\tchain\ton\t",17)){
            free(b);die("UNKNOWN compare memo reopened");
        }
        if(!strncmp(p,"CHAIN\tfixedpoint\t",17)){
            char *f[8];int n=pack_fields(p,f,8);if(n<3){free(b);die("UNKNOWN fixedpoint log schema");}
            for(int k=0;k<4;k++){size_t z=strlen(kind[k]);
                if(!strncmp(f[2],kind[k],z)&&(f[2][z]=='='||!f[2][z])){
                    if(memo&&!off){free(b);die("UNKNOWN compare memo shutdown proof");}
                    if(strcmp(f[2]+z,"=same")){free(b);die("UNKNOWN fixedpoint verdict");}
                    if(k==3){if(n!=3){free(b);die("UNKNOWN fixedpoint product proof");}}
                    else {long count=n==4&&!strncmp(f[3],"count=",6)?pack_number(f[3]+6):-1;
                        if(count<=0||(k==1&&count!=2)||(k==2&&count!=6)){free(b);die("UNKNOWN fixedpoint count");}}
                    seen|=1<<k;
                }
            }
        }
        p=e+1;
    }
    free(b);if(seen!=15)die("UNKNOWN fixedpoint four same proofs missing");
    const char *files[6]={"lnx-x86_64/entry.elf","lnx-arm64/entry.elf","osx-x86_64/slice-osx-x86_64",
        "osx-arm64/slice-osx-arm64","win-x86_64/slice-win-x86_64","win-arm64/slice-win-arm64"};
    for(int i=0;i<6;i++){
        char a[4400],c[4400],ha[65],hc[65];sy_stat_t sa,sc;
        if(cx_fmt(a,sizeof a,"%s/fixedpoint/g2/%s",chainout,files[i])||cx_fmt(c,sizeof c,"%s/fixedpoint/g3/%s",chainout,files[i]))die("fixedpoint slice path");
        if(sy_stat(a,&sa)||sy_stat(c,&sc)||sa.kind!='f'||sc.kind!='f'||sa.size<=0||sc.size<=0)die("UNKNOWN fixedpoint slice missing or empty");
        sha_of(root,a,ha);sha_of(root,c,hc);if(strcmp(ha,hc))die("fixedpoint slice SHA mismatch");
    }
    emit("FIXEDPOINT","VERIFIED",chainout);
}
/* ---- N-05: commit backfill, cache-manager fallback, plan ------------------ */

static int hexn(const char *s, int n) {
    if (tlen(s) != n) return 0;
    for (int i = 0; i < n; i++) { char c = s[i]; if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return 0; }
    return 1;
}
/* Runs a bounded child in the invoking checkout; output is trimmed of trailing newlines. */
static int here_run(char **v, char *o, long cap) {
    np_result r = {0}; char why[256] = {0}; int rc;
    if (o && cap > 0) o[0] = 0;
    if (np_run(v, here, 0, 20, &r, why, sizeof why)) { np_free(&r); return -1; }
    rc = r.rc;
    if (o && cap > 0) {
        size_t n = r.outn < (size_t)(cap - 1) ? r.outn : (size_t)(cap - 1);
        for (size_t i = 0; i < n; i++) o[i] = r.out[i];
        o[n] = 0; while (n && o[n - 1] == '\n') o[--n] = 0;
        if (r.outn >= (size_t)cap) rc = rc ? rc : 124;
    }
    np_free(&r);
    return rc;
}
static void field_of_row2(const char *t, int col, char *o, long cap) {
    const char *p = strchr(t, '\n'); int c = 0; long k = 0;
    o[0] = 0; if (!p) return; p++;
    while (*p && *p != '\n' && c < col) { if (*p == '\t') c++; p++; }
    while (*p && *p != '\t' && *p != '\n' && k + 1 < cap) o[k++] = *p++;
    o[k] = 0;
}
/* --commit: the candidate row's commit becomes the freeze commit. The freeze commit's own
 * release/candidate.tsv must carry the same tag/version (it is that version's freeze
 * point) and the old row value must be its ancestor (the branch-base placeholder). */
static void commit_backfill(void) {
    char spec[80], show[16384], ftag[64], fver[64], newp[4448];
    if (!commitarg[0]) { emit("COMMIT_BACKFILL", "SKIPPED", "no --commit; table commit kept"); return; }
    if (cx_fmt(spec, sizeof spec, "%s^{commit}", tx_eqz(commitarg, "HEAD") ? "HEAD" : commitarg)) die("commit spec");
    { char *v[] = {"git", "rev-parse", "--verify", "--quiet", spec, 0};
      if (here_run(v, frozen, sizeof frozen) || !hexn(frozen, 40)) die("RELEASE_PACK_NOT_FREEZE_POINT commit unresolved"); }
    if (!tx_eqz(commitarg, "HEAD") && !(hexn(commitarg, 40) && tx_eqz(commitarg, frozen))) die("RELEASE_PACK_NOT_FREEZE_POINT --commit must be 40 hex or HEAD");
    if (cx_fmt(spec, sizeof spec, "%s:release/candidate.tsv", frozen)) die("commit spec");
    { char *v[] = {"git", "show", spec, 0};
      if (here_run(v, show, sizeof show)) die("RELEASE_PACK_NOT_FREEZE_POINT no release/candidate.tsv at commit"); }
    field_of_row2(show, 1, ftag, sizeof ftag); field_of_row2(show, 3, fver, sizeof fver);
    if (!tx_eqz(ftag, cand.tag) || !tx_eqz(fver, cand.version)) {
        sy_eprintf("release-run: REFUSE RELEASE_PACK_NOT_FREEZE_POINT commit=%s tag=%s version=%s table_tag=%s table_version=%s\n", frozen, ftag, fver, cand.tag, cand.version);
        sy_exit(2);
    }
    if (tx_eqz(cand.commit, frozen)) { emit("COMMIT_BACKFILL", "NOOP", frozen); return; }
    if (!hexn(cand.commit, 40)) commit_mismatch("placeholder-not-40hex", cand.commit, frozen);
    { char *v[] = {"git", "merge-base", "--is-ancestor", cand.commit, frozen, 0};
      if (here_run(v, 0, 0)) commit_mismatch("placeholder-not-ancestor", cand.commit, frozen); }
    { size_t n; char *t = cx_read(table, &n); np_buf b = {0}; const char *p, *s; int c = 0; char before[64];
      if (!t) die("candidate read");
      p = memchr(t, '\n', n); if (!p) { free(t); die("candidate header"); }
      s = p + 1; while (s < t + n && *s != '\n' && c < 2) { if (*s == '\t') c++; s++; }
      if (c != 2 || s + 40 > t + n || memcmp(s, cand.commit, 40) || s[40] != '\t') { free(t); die("candidate commit column"); }
      np_put(&b, t, (size_t)(s - t)); np_puts(&b, frozen); np_put(&b, s + 40, n - (size_t)(s + 40 - t));
      if (cx_fmt(newp, sizeof newp, "%s/candidate-in.tsv", out) || cx_write(newp, b.p, b.n)) die("candidate-in write");
      free(t); free(b.p);
      if (cx_fmt(before, sizeof before, "%s", cand.commit)) die("before");
      if (cx_fmt(table, sizeof table, "%s", newp)) die("table path");
      { char why[512]; if (rcand_load(table, &cand, why, sizeof why)) die(why); }
      if (!tx_eqz(cand.commit, frozen)) die("candidate-in reload");
      sy_printf("RELEASE_RUN\tCOMMIT_BACKFILL\tbefore=%s\tafter=%s\t%s\n", before, frozen, table); }
}
static long fsize(const char *p) { sy_stat_t st; if (sy_stat(p, &st) || st.kind != 'f') return -1; return (long)st.size; }
static void cache_root(char *o, long cap) {
    const char *e = sy_env("UNISACC_RELEASE_CACHE"), *h = sy_env("HOME");
    if (e && e[0]) { if (cx_fmt(o, cap, "%s", e)) die("cache root"); }
    else if (!h || !h[0] || cx_fmt(o, cap, "%s/.cache/unisacc", h)) die("cache root HOME");
}
/* Expected digests: --cm-sha, else this version's tool-written evidence rows. */
static void cm_load_want(void) {
    char p[4400], *t; size_t n;
    if (cmwant[0][0] && cmwant[1][0]) return;
    if (cx_fmt(p, sizeof p, "%s/release/evidence/%s/cache-manager.tsv", root, cand.version)) die("path");
    t = cx_read(p, &n); if (!t) return;
    for (char *a = t; *a;) {
        char *e = strchr(a, '\n'), *f[6]; int k;
        if (!e) break; *e = 0;
        if (*a != '#') { k = pack_fields(a, f, 6);
            for (int r = 0; r < 2; r++) if (k >= 2 && tx_eqz(f[0], cm_role[r]) && hexn(f[1], 64) && !cmwant[r][0]) cx_fmt(cmwant[r], 65, "%s", f[1]); }
        a = e + 1;
    }
    free(t);
}
static int cm_try(int r, const char *p) {
    char h[65];
    if (fsize(p) <= 0) return 0;
    sha_of(root, p, h);
    if (!tx_eqz(h, cmwant[r])) return 0;
    if (cx_fmt(cmpath[r], sizeof cmpath[r], "%s", p) || cx_fmt(cmsha[r], 65, "%s", h) || cx_fmt(cmwhere[r], 16, "persist")) die("cm path");
    return 1;
}
static int cm_persisted(int r, const char *cr) {
    char p[4400], list[16384];
    if (cx_fmt(p, sizeof p, "%s/release-cm/%.8s/%s", cr, cmwant[r], cm_role[r])) die("path");
    if (cm_try(r, p)) return 1;
    { char *v[] = {"ls", "-1", (char *)cr, 0}; if (here_run(v, list, sizeof list)) return 0; }
    for (char *a = list; *a;) {
        char *e = strchr(a, '\n'); if (e) *e = 0;
        if (!strncmp(a, "release-", 8) && !tx_eqz(a, "release-cm")) {
            if (cx_fmt(p, sizeof p, "%s/%s/cm/%s", cr, a, cm_role[r])) die("path");
            if (cm_try(r, p)) return 1;
            if (cx_fmt(p, sizeof p, "%s/%s/%s", cr, a, cm_role[r])) die("path");
            if (cm_try(r, p)) return 1;
        }
        if (!e) break; a = e + 1;
    }
    return 0;
}
static void mkdir_p1(const char *p) { if (sy_mkdir(p, 0755) && sy_exists(p) != 1) die("mkdir"); }
static void cm_rebuild(int r, const char *cr) {
    char tmp[4400], d[4400], h[65];
    if (cx_fmt(tmp, sizeof tmp, "%s/cm-rebuild-%s", out, cm_role[r])) die("path");
    { char *v[] = {"sh", "unisacc.com", "tools/cache-retain.cx", "-b", (char *)cm_target[r], "-o", tmp, 0};
      if (child(v, root)) die("RELEASE_PACK_CM_REBUILD cache-retain failed"); }
    if (fsize(tmp) <= 0) die("RELEASE_PACK_CM_REBUILD empty output");
    sha_of(root, tmp, h);
    if (!tx_eqz(h, cmwant[r])) {
        sy_eprintf("release-run: REFUSE RELEASE_PACK_CM_SHA_MISMATCH role=%s want=%s got=%s rebuilt=%s\n", cm_role[r], cmwant[r], h, tmp);
        sy_exit(2);
    }
    mkdir_p1(cr);
    if (cx_fmt(d, sizeof d, "%s/release-cm", cr)) die("path"); mkdir_p1(d);
    if (cx_fmt(d, sizeof d, "%s/release-cm/%.8s", cr, h)) die("path"); mkdir_p1(d);
    if (cx_fmt(d, sizeof d, "%s/release-cm/%.8s/%s", cr, h, cm_role[r]) || sy_copy(tmp, d, 0644)) die("persist cache-manager");
    if (cx_fmt(cmpath[r], sizeof cmpath[r], "%s", d) || cx_fmt(cmsha[r], 65, "%s", h) || cx_fmt(cmwhere[r], 16, "rebuild")) die("cm path");
}
/* SRC_DIR first (old contract, bytes unchanged); a missing or empty file falls back to
 * a persistent copy with the recorded digest, then to a byte-identical rebuild. */
static void cm_resolve(void) {
    char cr[4096];
    cache_root(cr, sizeof cr);
    for (int r = 0; r < 2; r++) {
        char p[4400];
        if (cx_fmt(p, sizeof p, "%s/%s", srcdir, cm_leaf[r])) die("path");
        if (fsize(p) > 0) {
            sha_of(root, p, cmsha[r]);
            if (cx_fmt(cmpath[r], sizeof cmpath[r], "%s", p) || cx_fmt(cmwhere[r], 16, "srcdir")) die("cm path");
        } else {
            cm_load_want();
            if (!hexn(cmwant[r], 64)) { sy_eprintf("release-run: REFUSE RELEASE_PACK_CM_NO_RECORDED_SHA role=%s missing=%s\n", cm_role[r], p); sy_exit(2); }
            if (!cm_persisted(r, cr)) cm_rebuild(r, cr);
        }
        sy_printf("RELEASE_RUN\tCACHE_MANAGER\t%s\t%s\t%s\t%s\n", cm_role[r], cmsha[r], cmwhere[r], cmpath[r]);
    }
}
static void cm_evidence(void) {
    char text[12000], p[4400];
    if (cx_fmt(text, sizeof text, "# cache-manager inputs of release-run --pack (tool-written) version=%s tag=%s commit=%s\n"
        "role\tsha256\tsource\tpath\n%s\t%s\t%s\t%s\n%s\t%s\t%s\t%s\n", cand.version, cand.tag, cand.commit,
        cm_role[0], cmsha[0], cmwhere[0], cmpath[0], cm_role[1], cmsha[1], cmwhere[1], cmpath[1])) die("cm evidence");
    if (cx_fmt(p, sizeof p, "%s/cache-manager.tsv", out) || cx_write(p, text, (size_t)tlen(text))) die("cm evidence write");
    if (cx_fmt(p, sizeof p, "%s/release/evidence", root)) die("path");
    if (sy_exists(p) == 1) {
        if (cx_fmt(p, sizeof p, "%s/release/evidence/%s", root, cand.version)) die("path"); mkdir_p1(p);
        if (cx_fmt(p, sizeof p, "%s/release/evidence/%s/cache-manager.tsv", root, cand.version) || cx_write(p, text, (size_t)tlen(text))) die("cm evidence write");
    }
    emit("CM_EVIDENCE", p, 0);
}
/* --plan: the fixed external sequence, printed only. Nothing here runs a command. */
static void plan_step(int i, const char *name, const char *cmd, const char *gate, const char *rollback) {
    sy_printf("PLAN\t%d\t%s\n  cmd\t%s\n  gate\t%s\n  rollback\t%s\n", i, name, cmd, gate, rollback);
}
static void run_plan(void) {
    const char *R = "gh -R partnernetsoftware/unisacc";
    char c[7][1200];
    if (cx_fmt(c[0], 1200, "sh ./unisacc.com tools/devsvc.cx -- git commit -m 'v%s X: candidate table' --whole release/candidate.tsv --push", cand.version) ||
        cx_fmt(c[1], 1200, "%s release create %s --draft --title %s --target %s; %s release upload %s LAYOUT/{%s,%s,%s,%s,%s,%s} --clobber",
            R, cand.tag, cand.version, cand.commit, R, cand.tag, cand.name[0], cand.name[1], cand.name[2], cand.name[3], cand.name[4], cand.name[6]) ||
        cx_fmt(c[2], 1200, "%s workflow run %s --ref %s -f commit={commit-x}; %s run watch {run-id}", R, cand.workflow, cand.workflow_ref, R) ||
        cx_fmt(c[3], 1200, "fill ci_run_id={run-id} in release/candidate.tsv; sh ./unisacc.com tools/release-decide.cx -- --candidate release/candidate.tsv --evidence EVIDENCE --assets LAYOUT; sh ./unisacc.com tools/devsvc.cx -- git commit -m 'v%s Y1' --whole release/candidate.tsv release/evidence/%s release/notes-%s.md --push", cand.version, cand.version, cand.version) ||
        cx_fmt(c[4], 1200, "%s release edit %s --draft=false --latest", R, cand.tag) ||
        cx_fmt(c[5], 1200, "sh ./unisacc.com tools/c47-1-readback.cx -- %s; %s release download %s -p %s -D FRESH_DIR; sha256sum FRESH_DIR/%s", cand.tag, R, cand.tag, cand.name[0], cand.name[0]) ||
        cx_fmt(c[6], 1200, "sh ./unisacc.com tools/devsvc.cx -- git commit -m 'v%s Y2: public readback' --whole release/evidence/%s --push", cand.version, cand.version)) die("plan format");
    emit("MODE", "PLAN", cand.tag);
    plan_step(1, "X-commit", c[0], "release-run --pack RESULT PACK_OK with --commit FREEZE (COMMIT_BACKFILL after=FREEZE, BUILD_JSON_COMMIT, SOURCES_SID VERIFIED); table commit 40 hex", "git revert X before any public step");
    plan_step(2, "draft", c[1], "X pushed; layout SHA256SUMS --check OK; draft readback downloads six assets and SHA256SUMS OK", "gh release delete TAG (draft only, never delete a published tag)");
    plan_step(3, "ci", c[2], "draft readback PASS; workflow input commit = X (40 hex); all six targets success", "none external; do not publish, fix and re-run CI on a new X");
    plan_step(4, "Y1", c[3], "CI run success recorded by run id; release-decide verdict written; notes list known gaps", "git revert Y1 before publish");
    plan_step(5, "publish", c[4], "Y1 pushed; CI success on same candidate; manual confirm", "gh release edit {previous-tag} --latest; gh release edit TAG --draft=true; tag is never deleted");
    plan_step(6, "readback", c[5], "public asset sha256 equals candidate ape_sha256; readback rc 0", "same as publish rollback");
    plan_step(7, "Y2", c[6], "readback evidence and INDEX.tsv timestamps written", "git revert Y2 (evidence only)");
    sy_printf("RELEASE_RUN\tPLAN\tsteps=7\texecuted=0\tcommit=%s\n", cand.commit);
}
/* 步 4:显式 --osx-slices + --cache-manager-osx。不用 BUILT_CURRENT_PRODUCT:
 * 那会拿当前产品重造 manager,产物身份随宿主漂移,重放不再确定。 */
static void step_ape_pack(void) {
    char apedir[4400], ox[4400], om[4400], cmx[4400], cma[4400];
    char p3p[4400], wx[4400], lx[4400], la[4400], wa[4400];
    char *v[20]; int n = 0;
    const char *src[9] = {"p3.pkg", "win-x86_64", "lnx-x86_64", "lnx-arm64", "osx-x86_64", "osx-arm64", "win-arm64", "cache-manager-x64", "cache-manager-arm64"};
    int i;
    pack_chain_gate();
    for (i = 0; i < 7; i++) need(srcdir, src[i]);
    if (!cmpath[0][0] || !cmpath[1][0]) die("cache-manager unresolved");
    if (cx_fmt(apedir, sizeof apedir, "%s/ape", out)) die("path");
    if (sy_mkdir(apedir, 0755) && sy_exists(apedir) != 1) die("ape dir");
    if (cx_fmt(ox, sizeof ox, "%s/osx-x86_64", srcdir) || cx_fmt(om, sizeof om, "%s/osx-arm64", srcdir)) die("path");
    if (cx_fmt(cmx, sizeof cmx, "%s", cmpath[0]) || cx_fmt(cma, sizeof cma, "%s", cmpath[1])) die("path");
    if (cx_fmt(p3p, sizeof p3p, "%s/p3.pkg", srcdir)) die("path");
    if (cx_fmt(wx, sizeof wx, "%s/win-x86_64", srcdir) || cx_fmt(lx, sizeof lx, "%s/lnx-x86_64", srcdir)) die("path");
    if (cx_fmt(la, sizeof la, "%s/lnx-arm64", srcdir) || cx_fmt(wa, sizeof wa, "%s/win-arm64", srcdir)) die("path");
    v[n++] = "sh"; v[n++] = "unisacc.com"; v[n++] = "tools/release-ape.cx"; v[n++] = "pack";
    v[n++] = "--osx-slices"; v[n++] = ox; v[n++] = om;
    v[n++] = "--cache-manager-osx"; v[n++] = cmx; v[n++] = cma;
    v[n++] = apedir; v[n++] = p3p; v[n++] = wx; v[n++] = lx; v[n++] = la; v[n++] = ox; v[n++] = om; v[n++] = wa;
    v[n] = 0;
    if (child(v, root)) die("release-ape pack");
    { char com[4400];
      if (cx_fmt(com, sizeof com, "%s/unisacc-next.com", apedir)) die("path");
      if (sy_exists(com) != 1) die("unisacc-next.com"); }
    cm_evidence();
    mark(4, "ape-pack", "DONE");
}
/* 步 5:version-inject 用表内版本注入第六片,得独立资产 slice-win-arm64。 */
static void step_inject(void) {
    char in[4400], inj[4400], *v[8]; int n = 0;
    if (cx_fmt(in, sizeof in, "%s/win-arm64", srcdir) || cx_fmt(inj, sizeof inj, "%s/inject", out)) die("path");
    v[n++] = "sh"; v[n++] = "unisacc.com"; v[n++] = "tools/version-inject.cx"; v[n++] = "--";
    v[n++] = in; v[n++] = inj; v[n++] = table; v[n] = 0;
    if (child(v, root)) die("version-inject");
    mark(5, "inject", "DONE");
}
/* 读 sources.tsv:可有 # 来源注释,再取一行 64 位十六进制。 */
static void read_sources_sha(char sha[65]) {
    char p[4400]; size_t n; char *b; size_t i = 0, k;
    if (cx_fmt(p, sizeof p, "%s/sources.tsv", srcdir)) die("path");
    b = cx_read(p, &n);
    if (!b) die("sources.tsv");
    while (i < n) {
        if (b[i] == '#') { while (i < n && b[i] != '\n') i++; if (i < n) i++; continue; }
        if (b[i] == '\n' || b[i] == '\r') { i++; continue; }
        if (i + 64 > n) { free(b); die("sources.tsv short"); }
        for (k = 0; k < 64; k++)
            if (!((b[i + k] >= '0' && b[i + k] <= '9') || (b[i + k] >= 'a' && b[i + k] <= 'f'))) { free(b); die("sources_sha256 hex"); }
        for (k = 0; k < 64; k++) sha[k] = b[i + k];
        sha[64] = 0;
        free(b);
        return;
    }
    free(b);
    die("sources.tsv empty");
}
static int sources_has_origin_comment(void) {
    char p[4400]; size_t n, i; char *b;
    if (cx_fmt(p, sizeof p, "%s/sources.tsv", srcdir)) return 0;
    b = cx_read(p, &n);
    if (!b) return 0;
    for (i = 0; i < n; i++) {
        if (b[i] == '#') { free(b); return 1; }
        if (b[i] != ' ' && b[i] != '\t' && b[i] != '\n' && b[i] != '\r') break;
    }
    free(b);
    return 0;
}
static void require_sources_sid(void) {
    char file_sid[65], live[65], snap[4400], helper[4400], whyb[256];
    const char *e;
    np_result r = {0};
    int i;
    read_sources_sha(file_sid);
    if (snapdir[0]) {
        if (cx_fmt(snap, sizeof snap, "%s", snapdir)) die("path");
    } else if (cr_snap(root, cand.commit, 0, snap, sizeof snap)) die("path");
    if (sy_exists(snap) != 1) {
        if (!snapdir[0] && !(cr_snap(root, cand.commit, 0, snap, sizeof snap) || sy_exists(snap) == 1)) {
            /* fall through */
        }
        if (sy_exists(snap) != 1) {
            if (!sources_has_origin_comment()) {
                sy_eprintf("release-run: REFUSE sources-tsv-unverified-without-origin-comment\n");
                sy_exit(2);
            }
            emit("SOURCES_SID", "UNVERIFIED", file_sid);
            return;
        }
    }
    e = sy_env("UNISACC_IDENT_HELPER");
    if (e && e[0]) {
        if (sy_realpath((char *)e, helper, sizeof helper) < 0) die("identity-helper");
    } else {
        if (cx_fmt(helper, sizeof helper, "%s/ctx/identity-helper", root)) die("path");
        if (sy_exists(helper) != 1) {
            if (cx_fmt(helper, sizeof helper, "%s/out/epoch-context-01/identity-helper", root)) die("path");
            if (sy_exists(helper) != 1) die("identity-helper missing");
        }
    }
    { char *v[] = { helper, snap, 0 };
      if (np_run(v, snap, 0, 8, &r, whyb, sizeof whyb) || r.rc || r.outn < 64) {
          np_free(&r);
          die("identity-helper sid");
      }
      for (i = 0; i < 64; i++) live[i] = r.out[i];
      live[64] = 0;
      np_free(&r);
    }
    if (!tx_eqz(file_sid, live)) {
        sy_eprintf("release-run: REFUSE sources-sid-mismatch file=%s live=%s snap=%s helper=%s\n", file_sid, live, snap, helper);
        sy_exit(2);
    }
    /* An explicit --snap does not name its commit; only the derived snapshot binds one. */
    if (!snapdir[0] && cx_fmt(sidcommit, sizeof sidcommit, "%s", cand.commit)) die("sid commit");
    emit("SOURCES_SID", "VERIFIED", file_sid);
}
static void write_build_json(const char *path, long bytes, const char *sources_sha, const char *digest) {
    char text[1024];
    if (cx_fmt(text, sizeof text,
        "{\n  \"bytes\": %ld,\n  \"commit\": \"%s\",\n  \"schema\": 1,\n  \"settings\": {},\n"
        "  \"sources_sha256\": \"%s\",\n  \"product_kind\": \"ape1\",\n  \"product_digest\": \"%s\"\n}\n",
        bytes, cand.commit, sources_sha, digest)) die("build.json format");
    if (cx_write(path, text, (size_t)tlen(text))) die("build.json write");
}
static void commit_mismatch(const char *what, const char *a, const char *b) {
    sy_eprintf("release-run: REFUSE RELEASE_PACK_COMMIT_MISMATCH %s table=%s want=%s\n", what, a, b);
    sy_exit(2);
}
/* build.json is read back: its commit must be the backfilled freeze commit and the
 * commit whose derived snapshot passed the identity helper. */
static void check_build_json_commit(const char *path) {
    char want[80]; size_t n; char *t = cx_read(path, &n);
    if (!t || cx_fmt(want, sizeof want, "\"commit\": \"%s\"", cand.commit)) die("build.json reread");
    if (tx_find(t, (long)n, want, tlen(want)) < 0) { free(t); commit_mismatch("build.json", cand.commit, cand.commit); }
    free(t);
    if (frozen[0] && !tx_eqz(cand.commit, frozen)) commit_mismatch("build.json-vs-freeze", cand.commit, frozen);
    if (sidcommit[0] && !tx_eqz(cand.commit, sidcommit)) commit_mismatch("build.json-vs-sid-snapshot", cand.commit, sidcommit);
    emit("BUILD_JSON_COMMIT", cand.commit, sidcommit[0] ? "sid=derived-snapshot" : "sid=explicit-or-unverified");
}
/* 步 6:装配 layout 输入目录再交给 release-layout 生成(自带 --check)。
 * release-layout 源目录须含 name[0..3]:unisacc.com(APE)、pkg.bin、slice-win-arm64、
 * record;生成时复制出 build.json 别名与 zip、SHA256SUMS。 */
static void step_layout_gen(void) {
    char stagedir[4400], a[4400], b[4400], sources_sha[65], ape_sha[65], q[4400], attempt[4400];
    long ape_bytes;
    char *v[8]; int n = 0;
    if (cx_fmt(stagedir, sizeof stagedir, "%s/stage", out) || cx_fmt(layoutout, sizeof layoutout, "%s/layout", out)) die("path");
    if (sy_mkdir(stagedir, 0755) && sy_exists(stagedir) != 1) die("stage dir");
    /* release-layout 要求 NEW_OUT 不存在;layout 由它创建,本工具不预建。 */
    if (sy_exists(layoutout) == 1) die("layout dir already exists");
    if(cx_fmt(attempt,sizeof attempt,"%s/layout-attempt-%ld-%d",out,sy_wall_s(),sy_pid()))die("layout attempt path");
    read_sources_sha(sources_sha);
    if (cx_fmt(a, sizeof a, "%s/ape/unisacc-next.com", out)) die("path");
    { np_result r = {0}; char why[256] = {0}; char *sv[] = {"stat", "-c", "%s", a, 0};
      if (np_run(sv, "/", 0, 10, &r, why, sizeof why) || r.rc || r.outn < 2) die("stat ape");
      ape_bytes = 0;
      { size_t i; for (i = 0; i < r.outn && r.out[i] >= '0' && r.out[i] <= '9'; i++) ape_bytes = ape_bytes * 10 + (r.out[i] - '0'); }
      np_free(&r);
      if (ape_bytes <= 0) die("ape bytes"); }
    sha_of(root, a, ape_sha);
    /* stagedir 内以表内资产名放四件:unisacc.com、pkg.bin、slice-win-arm64、record。 */
    if (cx_fmt(b, sizeof b, "%s/%s", stagedir, cand.name[0]) || sy_copy(a, b, 0755)) die("stage ape");
    if (cx_fmt(a, sizeof a, "%s/p3.pkg", srcdir) || cx_fmt(b, sizeof b, "%s/%s", stagedir, cand.name[1]) || sy_copy(a, b, 0600)) die("stage pkg");
    if (cx_fmt(a, sizeof a, "%s/inject", out) || cx_fmt(b, sizeof b, "%s/%s", stagedir, cand.name[2]) || sy_copy(a, b, 0755)) die("stage slice");
    if (cx_fmt(b, sizeof b, "%s/%s", stagedir, cand.name[3])) die("path");
    write_build_json(b, ape_bytes, sources_sha, ape_sha);
    check_build_json_commit(b);
    /* Initial candidate pins are unknown; derive the four source pins from bytes. */
    np_buf pinned={0};
    np_puts(&pinned,"repo\ttag\tcommit\tversion\tworkflow\tworkflow_ref\tci_run_id\tape\tape_sha256\tpackage\tpackage_sha256\twin_arm64\twin_arm64_sha256\trecord\trecord_sha256\tbuild_alias\tbuild_alias_sha256\tzip\tzip_sha256\tchecksums\tchecksums_sha256\n");
    const char *fields[]={cand.repo,cand.tag,cand.commit,cand.version,cand.workflow,cand.workflow_ref,cand.ci_run_id};
    for(int i=0;i<7;i++){if(i)np_puts(&pinned,"\t");np_puts(&pinned,fields[i]);}
    for(int i=0;i<7;i++){char digest[65];if(i<4){if(cx_fmt(a,sizeof a,"%s/%s",stagedir,cand.name[i]))die("stage hash path");sha_of(root,a,digest);}else if(cx_fmt(digest,sizeof digest,"%s",(i==5&&!rcand_has_zip(cand.version))?"-":cand.sha[i]))die("digest capacity");np_puts(&pinned,"\t");np_puts(&pinned,cand.name[i]);np_puts(&pinned,"\t");np_puts(&pinned,digest);}np_puts(&pinned,"\n");
    if(cx_fmt(q,sizeof q,"%s/layout-input.tsv",out)||cx_write(q,pinned.p,pinned.n))die("layout input table");free(pinned.p);
    v[n++] = "sh"; v[n++] = "unisacc.com"; v[n++] = "tools/release-layout.cx"; v[n++] = "--";
    v[n++] = "--candidate"; v[n++] = q; v[n++] = stagedir; v[n++] = attempt; v[n] = 0;
    if (child(v, root)) die("release-layout generate");
    if(sy_rename(attempt,layoutout))die("publish layout");
    /* The atomic rename above leaves failed attempt directories untouched. */
    mark(6, "layout-gen", "DONE");
}
/* 步 7:由 layout 产物文件计算 7 个 sha 回填候选表(列 8/10/12/14/16/18/20,0 基)。
 * 表头与其余列原样保留;输出 OUT_DIR/candidate.tsv。 */
static void step_backfill(void) {
    char line[8192], hex[7][65], outtable[4448];
    size_t n; char *b; long at = 0, i, col;
    int f, k;
    for (k = 0; k < 7; k++) {
        char p[4400];
        if (k == 5 && !rcand_has_zip(cand.version)) { hex[k][0] = '-'; hex[k][1] = 0; continue; }
        if (cx_fmt(p, sizeof p, "%s/%s", layoutout, cand.name[k])) die("path");
        if (sy_exists(p) != 1) die(cand.name[k]);
        sha_of(root, p, hex[k]);
    }
    b = cx_read(table, &n);
    if (!b || n < 10 || n >= sizeof line) die("candidate read");
    for (i = 0; (long)i < (long)n; i++) {
        line[at++] = b[i];
        if (b[i] == '\n' || i + 1 == (long)n) {
            /* 只回填数据行(第二行);表头与空行原样。 */
            static char second[8192]; static long slen; static int have_second;
            long j = at - 1; while (j >= 0 && line[j] != '\n') j--;
            (void)j;
            if (!have_second) {
                long m = at; if (line[m - 1] == '\n') m--;
                if (m > 0) { for (j = 0; j < m; j++) second[j] = line[j]; slen = m; have_second = 1; }
            }
            at = 0;
        }
    }
    /* 用 rcand 结构重写数据行:非哈希列取 cand 原值,哈希列用 hex。 */
    { const char *cols[21];
      cols[0] = cand.repo; cols[1] = cand.tag; cols[2] = cand.commit; cols[3] = cand.version;
      cols[4] = cand.workflow; cols[5] = cand.workflow_ref; cols[6] = cand.ci_run_id;
      for (k = 0; k < 7; k++) { cols[7 + 2 * k] = cand.name[k]; cols[8 + 2 * k] = hex[k]; }
      if (cx_fmt(outtable, sizeof outtable, "%s/candidate.tsv", out)) die("path");
      f = sy_open(outtable, O_WRONLY | O_CREAT | O_TRUNC, 0600);
      if (f < 0) die("backfill write");
      { char head[8192]; long m = 0;
        b = cx_read(table, &n);
        if (!b) die("candidate reread");
        while (m < (long)n && b[m] != '\n') m++;
        if (m >= (long)n) die("header");
        if (sy_write_all(f, b, m + 1)) die("header write");
        for (col = 0; col < 21; col++) {
          if (sy_write_all(f, cols[col], tlen(cols[col]))) die("row write");
          if (sy_write_all(f, col == 20 ? "\n" : "\t", 1)) die("row write");
        }
        /* 原表第二行之后的附加行(如有)原样保留。 */
        { long p = 0, q = 0, lines = 0;
          while (p < (long)n) { if (b[p] == '\n') { lines++; if (lines == 2) { p++; break; } } p++; }
          if (lines == 2 && p < (long)n) { if (sy_write_all(f, b + p, (long)n - p)) die("tail write"); } }
      }
      if (sy_close(f)) die("close");
    }
    { char why[512]; RcCandidate check;
      if (cx_fmt(outtable, sizeof outtable, "%s/candidate.tsv", out)) die("path");
      if (rcand_load(outtable, &check, why, sizeof why)) die(why);
      if (rcand_verify(&check, layoutout, 7, why, sizeof why)) die(why);
      for (k = 0; k < 7; k++) if (!tx_eqz(check.sha[k], hex[k])) die("backfill mismatch"); }
    emit("BACKFILL", "candidate.tsv", outtable);
    mark(7, "backfill", "DONE");
}
static void step_sums2(void) {
    char *v[] = {"sha256sum", "--check", "SHA256SUMS", 0};
    if (child(v, layoutout)) die("sha256sum --check");
    mark(8, "sums", "DONE");
}
/* 步 9:只打印命令。CI 触发与公开保持人工确认;命令参数由表值拼出并校验。 */
static void step_commands(void) {
    const char *R = "-R partnernetsoftware/unisacc";
    int i;
    if (tlen(cand.commit) != 40) die("commit not 40 hex");
    { int c = 0; for (i = 0; cand.commit[i]; i++)
        if (!((cand.commit[i] >= '0' && cand.commit[i] <= '9') || (cand.commit[i] >= 'a' && cand.commit[i] <= 'f'))) c = 1;
      if (c) die("commit not hex"); }
    sy_printf("NEXT gh %s release create %s --draft --title %s --target %s\n", R, cand.tag, cand.version, cand.commit);
    for (i = 0; i < 7; i++)
        sy_printf("NEXT gh %s release upload %s %s/%s --clobber\n", R, cand.tag, layoutout, cand.name[i]);
    /* X does not exist during local pack; execution resolves it after committing. */
    sy_printf("NEXT ci commit={commit-x} build_rev=%s\n", cand.commit);
    /* 改标签:只 edit --tag/--target,完整 40 位;不先删旧标签。 */
    sy_printf("NEXT gh %s release edit %s --tag v%s --target %s\n", R, cand.tag, cand.version, cand.commit);
    sy_printf("NEXT gh %s release edit v%s --draft=false --latest\n", R, cand.version);
    sy_printf("RELEASE_RUN\tCOMMANDS\tmanual_confirm=CI+publish\tno_tag_delete=1\n");
    mark(9, "commands", "DONE");
}
/* Resume binds all original source bytes and the immutable initial table. */
static void pack_binding(int create) {
    const char *names[]={"p3.pkg","win-x86_64","lnx-x86_64","lnx-arm64","osx-x86_64","osx-arm64","win-arm64","cache-manager-x64","cache-manager-arm64","sources.tsv"};
    np_buf b={0};char p[4400],h[65];static char row[22000];size_t n;
    if(cx_fmt(row,sizeof row,"%s\n%s\n%s\n%s\n%s\n",root,table,srcdir,snapdir,chainout))die("binding");np_puts(&b,row);
    sha_of(root,table,h);np_puts(&b,h);np_puts(&b,"\n");
    for(int i=0;i<10;i++){if(i==7||i==8){if(cx_fmt(p,sizeof p,"%s",cmpath[i-7]))die("binding path");}else if(cx_fmt(p,sizeof p,"%s/%s",srcdir,names[i]))die("binding path");sha_of(root,p,h);np_puts(&b,names[i]);np_puts(&b,"\t");np_puts(&b,h);np_puts(&b,"\n");}
    if(cx_fmt(p,sizeof p,"%s/pack-inputs.tsv",out))die("binding path");char *old=cx_read(p,&n);
    if(old){if(n!=b.n||memcmp(old,b.p,n))die("pack input changed");free(old);}else if(!create||cx_write(p,b.p,b.n))die("pack binding missing");free(b.p);
}
static int pack_done(int i) {
    size_t n;char *s=cx_read(statep,&n),needle[100];if(cx_fmt(needle,sizeof needle,"STEP\t%d\t",i))die("checkpoint");int yes=0;
    for(char *a=s;a&&*a;){char *e=strchr(a,'\n');if(!e)die("checkpoint truncated");if(!strncmp(a,needle,strlen(needle))){char *t=0;for(char *q=a;q<e;q++)if(*q=='\t')t=q;yes=t&&e-t==5&&!strncmp(t,"\tDONE",5);}a=e+1;}free(s);return yes;
}
static void pack_continue(void) {
    int ape_done=pack_done(4);if(ape_done)pack_chain_gate();
    pack_binding(0);require_sources_sid();
    if(cx_fmt(layoutout,sizeof layoutout,"%s/layout",out))die("layout path");
    if(!ape_done)step_ape_pack();if(!pack_done(5))step_inject();
    if(!pack_done(6))step_layout_gen();if(!pack_done(7))step_backfill();
    step_sums2();char p[4400],why[400];RcCandidate actual;
    if(cx_fmt(p,sizeof p,"%s/candidate.tsv",out)||rcand_load(p,&actual,why,sizeof why)||rcand_verify(&actual,layoutout,7,why,sizeof why))die("resume output identity");
    if(!pack_done(9))step_commands();
}
int main(int argc, char **argv) {
    char why[1024];
    if(argc==3&&tx_eqz(argv[1],"--resume")) {
        if(sy_realpath(argv[2],out,sizeof out)<0||cx_fmt(statep,sizeof statep,"%s/state.tsv",out))die("resume out");
        char p[4400];size_t n;if(cx_fmt(p,sizeof p,"%s/pack-inputs.tsv",out))die("resume path");char *s=cx_read(p,&n);if(!s)die("resume inputs");
        char *dest[]={root,table,srcdir,snapdir,chainout};size_t caps[]={sizeof root,sizeof table,sizeof srcdir,sizeof snapdir,sizeof chainout};char *at=s;
        for(int i=0;i<5;i++){char *e=strchr(at,'\n');if(!e||(size_t)(e-at)>=caps[i])die("resume schema");*e=0;if(cx_fmt(dest[i],caps[i],"%s",at))die("resume capacity");at=e+1;}free(s);
        if(rcand_load(table,&cand,why,sizeof why))die(why);if(sy_cwd(here,sizeof here))die("cwd");cm_resolve();pack_continue();return 0;
    }
    if (argc == 6 && tx_eqz(argv[1], "--dry-run")) {
        if (sy_realpath(argv[2], root, sizeof root) < 0) die("root");
        if (sy_realpath(argv[3], table, sizeof table) < 0) die("candidate table");
        if (sy_realpath(argv[4], layout, sizeof layout) < 0) die("layout dir");
        if (cx_fmt(out, sizeof out, "%s", argv[5]) || out[0] != '/') die("out dir absolute");
        if (sy_mkdir(out, 0755) && sy_exists(out) != 1) die("out dir");
        if (cx_fmt(statep, sizeof statep, "%s/state.tsv", out)) die("state path");
        if (rcand_load(table, &cand, why, sizeof why)) die(why);
        emit("MODE", "DRY_RUN", cand.tag);
        step_layout_check();
        step_sums();
        step_dispatch();
        step_decide();
        emit("RESULT", "DRY_RUN_OK", "no release created, no CI, no push");
        return 0;
    }
    if (argc >= 3 && tx_eqz(argv[1], "--execute")) {   /* gated execution lives in tools/release-exec.cx */
        char *v[24]; int k = 0; v[k++] = "sh"; v[k++] = "./unisacc.com"; v[k++] = "tools/release-exec.cx"; v[k++] = "--";
        for (int i = 1; i < argc && k < 23; i++) v[k++] = argv[i];
        v[k] = 0; if (sy_cwd(here, sizeof here)) die("cwd");
        { np_result r = {0}; char w[256] = {0}; int rc; if (np_run(v, here, 0, 2400, &r, w, sizeof w)) die("release-exec transport");
          if (r.outn) sy_write_all(1, r.out, r.outn); if (r.errn) sy_write_all(2, r.err, r.errn); rc = r.rc; np_free(&r); return rc; }
    }
    if (argc >= 3 && tx_eqz(argv[1], "--prepare")) {   /* B4 drafts live in tools/release-prep.cx */
        char *v[24]; int k = 0; v[k++] = "sh"; v[k++] = "./unisacc.com"; v[k++] = "tools/release-prep.cx"; v[k++] = "--"; /* lint:allow R1-product same forwarding shape as --execute */
        for (int i = 2; i < argc && k < 23; i++) v[k++] = argv[i];
        v[k] = 0; if (sy_cwd(here, sizeof here)) die("cwd");
        { np_result r = {0}; char w[256] = {0}; int rc; if (np_run(v, here, 0, 58, &r, w, sizeof w)) die("release-prep transport");
          if (r.outn) sy_write_all(1, r.out, r.outn); if (r.errn) sy_write_all(2, r.err, r.errn); rc = r.rc; np_free(&r); return rc; }
    }
    if (argc == 3 && tx_eqz(argv[1], "--plan")) {
        if (sy_realpath(argv[2], table, sizeof table) < 0) die("candidate table");
        if (rcand_load(table, &cand, why, sizeof why)) die(why);
        run_plan();
        return 0;
    }
    if (argc>=6&&tx_eqz(argv[1],"--pack")) {
        char root_tsv[4400],vr[24],vt[24];snapdir[0]=0;chainout[0]=0;
        if(sy_cwd(here,sizeof here))die("cwd");
        for(int i=6;i<argc;i+=2){
            if(i+1>=argc)die("usage option value missing");
            if(tx_eqz(argv[i],"--snap")){if(snapdir[0]||sy_realpath(argv[i+1],snapdir,sizeof snapdir)<0)die("snap");}
            else if(tx_eqz(argv[i],"--chain-out")){if(chainout[0]||sy_realpath(argv[i+1],chainout,sizeof chainout)<0)die("UNKNOWN chain output");}
            else if(tx_eqz(argv[i],"--commit")){if(commitarg[0]||cx_fmt(commitarg,sizeof commitarg,"%s",argv[i+1]))die("commit");}
            else if(tx_eqz(argv[i],"--cm-sha")){if(i+2>=argc||!hexn(argv[i+1],64)||!hexn(argv[i+2],64)||cx_fmt(cmwant[0],65,"%s",argv[i+1])||cx_fmt(cmwant[1],65,"%s",argv[i+2]))die("--cm-sha X64 ARM64 (64 hex each)");i++;}
            else die("usage --pack requires --chain-out DIR; optional --snap DIR --commit HEX40|HEAD --cm-sha X64 ARM64");
        }
        if(!chainout[0]||strchr(chainout,'\n')||strchr(chainout,'\r'))die("UNKNOWN chain output --chain-out required");
        if (sy_realpath(argv[2], root, sizeof root) < 0) die("root");
        if (sy_realpath(argv[3], table, sizeof table) < 0) die("candidate table");
        if (sy_realpath(argv[4], srcdir, sizeof srcdir) < 0) die("src dir");
        if (cx_fmt(out, sizeof out, "%s", argv[5]) || out[0] != '/') die("out dir absolute");
        if (cx_fmt(root_tsv, sizeof root_tsv, "%s/release/candidate.tsv", root)) die("path");
        if (rv_load(root_tsv, vr) || rv_load(table, vt)) die("version-load");
        if (!tx_eqz(vr, vt)) {
            sy_eprintf("release-run: REFUSE root-candidate-version-mismatch ROOT=%s TABLE=%s\n", vr, vt);
            sy_eprintf("release-run: repair: cp CANDIDATE_TSV ROOT/release/candidate.tsv\n");
            sy_eprintf("release-run: ROOT must be a private clone, not the shared checkout\n");
            sy_exit(2);
        }
        if (sy_mkdir(out, 0755) && sy_exists(out) != 1) die("out dir");
        if (cx_fmt(statep, sizeof statep, "%s/state.tsv", out)) die("state path");
        if (rcand_load(table, &cand, why, sizeof why)) die(why);
        commit_backfill();
        need(srcdir, "sources.tsv");
        require_sources_sid();
        emit("MODE", "PACK", cand.tag);
        cm_resolve();
        pack_binding(1);
        pack_continue();
        emit("RESULT", "PACK_OK", "local replay only, no network, no gh, no push");
        return 0;
    }
    die("usage --dry-run ROOT CANDIDATE_TSV LAYOUT_DIR OUT_DIR | --pack ROOT CANDIDATE_TSV SRC_DIR OUT_DIR --chain-out DIR [--snap DIR] [--commit HEX40|HEAD] [--cm-sha X64 ARM64] | --plan CANDIDATE_TSV | --resume OUT_DIR");
    return 2;
}
