/* Source0d adopts frozen Source329 NN/declaration CONTENT with explicit origin.
 * prepare ROOT SNAPROOT LOGICAL_ROOT LOGICAL_PC KGEN ABS_SAVED_BOOTSTRAP
 *         TRUSTED_LIBNEED ORIGIN_VERIFIER_ELF ORIGIN_PROFILE NEW_PC
 * pack|seal|--verify|--snapshot ROOT PC
 * Linux/x86_64 LP64 native controller; outer watchdog55 remains mandatory.
 * Each endpoint freshly reads current/origin SID, runs the independent origin
 * verifier and NI comparison, and replays current kernel construction receipts.
 * Only pack executes a constructor, exactly once. No compilerpack or NN job.
 * New unsigned schema never edits old records or claims historical compilation,
 * hermetic host dependencies, NN evaluation, current NN construction or PASS.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.kernelsha
#pragma unisa use cxlib.nninputs
#pragma unisa use text.text

static char root[4096],snapshot[4096],logical_root[4096],logical_pc[4096],physical_pc[4096],origin_ctx[4096],kgen[4096],bootstrap[4096],trusted[4096],origin_elf[4096],origin_profile[4096],pc[4096],bound[4400],self[4400],self_elf[4096],sid[65],kernel_context_sha[65];
static int own_reads;
static char **owned_environment;
static const char *environment_policy="raw-environ-remove-SEED_GEN_GENERIC-SEED_GEN_TRACE-UNISACC_SEED_TRACE-UNISACC_RF_CAPTURE-UNISA_ATTRIBUTES-v1";
