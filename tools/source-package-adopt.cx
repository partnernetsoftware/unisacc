static void emit_observations(np_buf *b,const Endpoint *a,const Endpoint *z){number_row(b,"origin-jobs-before",107);number_row(b,"origin-jobs-after",107);number_row(b,"origin-models-before",34);number_row(b,"origin-models-after",34);number_row(b,"origin-physical-reads-before",number(a->origin_report.value[29]));number_row(b,"origin-physical-reads-after",number(z->origin_report.value[29]));number_row(b,"origin-executor-reads-before",number(a->origin_report.value[14]));number_row(b,"origin-executor-reads-after",number(z->origin_report.value[14]));number_row(b,"origin-wrapper-reads-before",number(a->origin_report.value[31]));number_row(b,"origin-wrapper-reads-after",number(z->origin_report.value[31]));number_row(b,"NI-physical-reads-before",a->ni.physical_reads);number_row(b,"NI-physical-reads-after",z->ni.physical_reads);number_row(b,"controller-physical-reads-before",a->own_physical_reads);number_row(b,"controller-physical-reads-after",z->own_physical_reads);number_row(b,"controller-physical-reads-post-endpoint",own_reads-z->own_physical_reads);number_row(b,"endpoint-before-ns",a->elapsed_ns);number_row(b,"endpoint-after-ns",z->elapsed_ns);number_row(b,"origin-endpoint-before-ns",number(a->origin_report.value[30]));number_row(b,"origin-endpoint-after-ns",number(z->origin_report.value[30]));number_row(b,"NI-before-ns",a->ni.elapsed_ns);number_row(b,"NI-after-ns",z->ni.elapsed_ns);row(b,"identity-helper-internal-reads","UNMEASURED");row(b,"libneed-internal-reads","UNMEASURED");row(b,"observations-scope","timings-and-readcounts-are-real-observations-not-test-PASS-or-stable-digest-inputs");}
