static void die(const char *s){fprintf(stderr,"source-package-adopt: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void path(char *p,const char *a,const char *b){char temp[4400];int n=snprintf(temp,sizeof temp,"%s/%s",a,b);if(n<0||n>=4400)die("path-bound");memcpy(p,temp,(size_t)n+1);}
static void row(np_buf *b,const char *key,const char *value){if(!key||!value||!*key||!*value||strpbrk(key,"\r\n\t")||strpbrk(value,"\r\n\t"))die("record-row");np_puts(b,key);np_puts(b,"\t");np_puts(b,value);np_puts(b,"\n");}
static void number_row(np_buf *b,const char *key,long long n){char v[80];snprintf(v,sizeof v,"%lld",n);row(b,key,v);}
static int within(const char *p,const char *base){size_t n=strlen(base);return !strncmp(p,base,n)&&(!p[n]||p[n]=='/');}
static void lexical(const char *p){if(!p||strlen(p)<2||strlen(p)>=4096||*p!='/'||p[strlen(p)-1]=='/'||strpbrk(p,"\r\n\t")||strstr(p,"//"))die("absolute-canonical-spelling");const char *a=p+1;while(*a){const char *e=strchr(a,'/');size_t n=e?(size_t)(e-a):strlen(a);if((n==1&&a[0]=='.')||(n==2&&a[0]=='.'&&a[1]=='.'))die("dot-path-component");if(!e)break;a=e+1;}}
static void canonical(const char *p){lexical(p);char actual[4400],part[4400];if(!realpath(p,actual)||!tx_eq(p, actual, 1L << 20)){char why[4600];snprintf(why,sizeof why,"canonical-input-required path=%s",p);die(why);}strcpy(part,p);for(size_t i=1;;i++){if(part[i]&&part[i]!='/')continue;char c=part[i];part[i]=0;struct stat st;if(lstat(part,&st)||S_ISLNK(st.st_mode)||(c&&!S_ISDIR(st.st_mode)))die("symlink-or-parent");part[i]=c;if(!c)break;}}
static void directory(const char *p){canonical(p);struct stat st;if(lstat(p,&st)||!S_ISDIR(st.st_mode))die("normal-directory-required");}
static void absent(const char *p){lexical(p);struct stat st;errno=0;if(!lstat(p,&st)||errno!=ENOENT)die("new-output-must-be-ENOENT");char parent[4400];strcpy(parent,p);char *slash=strrchr(parent,'/');if(!slash||slash==parent)die("output-parent");*slash=0;directory(parent);}
static void hash_bytes(const void *s,size_t n,char h[65]){if(n>=65536){int rc=ks_sha256_hex(s,n,h);if(rc){char why[120];snprintf(why,sizeof why,"kernelsha-buffer-rc=%d",rc);die(why);}}else cx_sha256_hex(s,n,h);}
static void digest_selfcheck(void){char h[65],why[120];int rc=ks_sha256_hex("",0,h);if(rc){snprintf(why,sizeof why,"kernelsha-empty-selfcheck-rc=%d",rc);die(why);}if(!tx_eq(h, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", 1L << 20))die("kernelsha-empty-selfcheck");rc=ks_sha256_hex("abc",3,h);if(rc){snprintf(why,sizeof why,"kernelsha-abc-selfcheck-rc=%d",rc);die(why);}if(!tx_eq(h, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", 1L << 20))die("kernelsha-abc-selfcheck");}
static char *load(const char *p,size_t *n){canonical(p);struct stat a,b;if(lstat(p,&a)||!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>134217728)die("bounded-regular-input");int fd=open(p,O_RDONLY|O_NOFOLLOW|O_NONBLOCK|O_CLOEXEC);if(fd<0||fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size||a.st_mode!=b.st_mode)die("input-descriptor");*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s)die("allocation");size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("input-extent");at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int bad=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size||a.st_mode!=b.st_mode;int cl=close(fd);if(z||bad||cl)die("input-changed-or-close");s[*n]=0;own_reads++;return s;}
static void digest(const char *p,char h[65]){size_t n;char *s=load(p,&n);hash_bytes(s,n,h);free(s);}
static void write_new(const char *p,const void *s,size_t n){absent(p);int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive-output");size_t at=0;while(at<n){ssize_t z=write(fd,(const char *)s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("output-write-partial-retained");at+=(size_t)z;}int sync=fsync(fd),cl=close(fd);if(sync||cl)die("output-sync-close-partial-retained");}
static void equal(const char *p,const np_buf *b){size_t n;char *s=load(p,&n);int ok=n==b->n&&!memcmp(s,b->p,n);free(s);if(!ok)die("receipt-bytes-mismatch");}
static void same(const np_buf *a,const np_buf *b,const char *reason){if(a->n!=b->n||memcmp(a->p,b->p,a->n))die(reason);}
static int hex_n(const char *s,size_t n){if(strlen(s)!=n)return 0;for(size_t i=0;i<n;i++)if(!((s[i]>='0'&&s[i]<='9')||(s[i]>='a'&&s[i]<='f')))return 0;return 1;}
static long long number(const char *s){if(!*s||(*s=='0'&&s[1]))return -1;long long n=0;for(;*s;s++){if(*s<'0'||*s>'9'||n>(LLONG_MAX-(*s-'0'))/10)return -1;n=n*10+*s-'0';}return n;}
static void field(const char *s,size_t n,const char *key,char *out,size_t cap){char needle[120];int z=snprintf(needle,sizeof needle,"\n%s\t",key);if(z<0||(size_t)z>=sizeof needle||!n||s[n-1]!='\n'||memchr(s,0,n)||memchr(s,'\r',n))die("field-wire");const char *a=strstr(s,needle);if(!a||strstr(a+1,needle))die("unique-field");a+=strlen(needle);const char *e=strchr(a,'\n');if(!e||e==a||(size_t)(e-a)>=cap||memchr(a,'\t',(size_t)(e-a)))die("field-bound");memcpy(out,a,(size_t)(e-a));out[e-a]=0;}
static void mapped(const char *logical,char physical[4400]){lexical(logical);if(!within(logical,logical_root)||within(logical,snapshot))die("origin-logical-path-role");char temp[4400];int n=snprintf(temp,sizeof temp,"%s%s",snapshot,logical+strlen(logical_root));if(n<0||n>=4096)die("origin-map-bound");canonical(temp);memcpy(physical,temp,(size_t)n+1);}
static int forbidden_environment(const char *s){const char *keys[]={"SEED_GEN_GENERIC","SEED_GEN_TRACE","UNISACC_SEED_TRACE","UNISACC_RF_CAPTURE","UNISA_ATTRIBUTES"};for(int i=0;i<5;i++){size_t n=strlen(keys[i]);if(!strncmp(s,keys[i],n)&&s[n]=='=')return 1;}return 0;}
static void clean_environment(void){size_t n=0;for(char **p=environ;*p;p++)n++;if(n>1048576)die("environment-bound");owned_environment=malloc((n+1)*sizeof *owned_environment);if(!owned_environment)die("allocation");size_t at=0;for(char **p=environ;*p;p++)if(!forbidden_environment(*p))owned_environment[at++]=*p;owned_environment[at]=0;environ=owned_environment;for(char **p=environ;*p;p++)if(forbidden_environment(*p))die("raw-environment-policy");}
static long long now_ns(void){long stamp[2]={0};long rc=__syscall6(228,1,(long)stamp,0,0,0);if(rc||stamp[0]<0||stamp[1]<0||stamp[1]>=1000000000L||stamp[0]>(LLONG_MAX-stamp[1])/1000000000LL)die("monotonic-clock");return stamp[0]*1000000000LL+stamp[1];}
static void check_environment(void){for(char **p=environ;*p;p++)if(forbidden_environment(*p))die("raw-environment-policy-changed");}
static np_result command(char *const v[],int seconds){check_environment();np_result r={0};char why[1200];if(np_run(v,root,0,seconds,&r,why,sizeof why)){fprintf(stderr,"%s\n",why);die("subprocess-transport");}return r;}
static void identity(const char *input,char h[65]){char helper[4400],actual[65];path(helper,kgen,"identity-helper");digest(helper,actual);if(!tx_eq(actual, helper_pin, 1L << 20))die("source-helper-execution-role-pin");char *v[]={bound,"4",helper,(char *)input,0};np_result r=command(v,4);int ok=!r.rc&&!r.errn&&r.outn==65&&r.out[64]=='\n';if(ok){memcpy(h,r.out,64);h[64]=0;ok=hex_n(h,64);}if(!ok){if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);die("fresh-source-helper");}np_free(&r);}
typedef struct {char value[32][4096];} OriginReport;
static const char *origin_keys[]={"status","logical-root","snapshot-root","logical-package","physical-package","current-verifier-root","execution-profile-path","executing-elf-path","origin-spec","executing-verifier","executing-elf","execution-profile","execution-closure","mapping-witness","execution-reads","origin-source","artifact","manifest","receipt","witness","epoch-artifact","epoch-record","epoch-path","producer","foundation","verifier","digest-module","jobs","models","physical-reads","elapsed-ns","wrapper-physical-reads"};
static void origin_observe(OriginReport *out,np_buf *stable){char executing[65];digest(origin_elf,executing);if(!tx_eq(executing, origin_elf_pin, 1L << 20))die("origin-verifier-execution-role-pin");char *v[]={bound,"12",origin_elf,"--snapshot",root,logical_root,snapshot,logical_pc,sid,origin_profile,0};/* Caller sets sid to independently measured ORIGIN for this call. */np_result r=command(v,12);const char *schema="source-origin-snapshot-v1\n";size_t sn=strlen(schema);if(r.rc||r.errn||r.outn<sn||r.outn>65536||memcmp(r.out,schema,sn)||memchr(r.out,0,r.outn)||memchr(r.out,'\r',r.outn)||r.out[r.outn-1]!='\n'){if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);die("origin-independent-verifier-refused-or-wire");}const char *at=r.out+sn,*end=r.out+r.outn;for(int i=0;i<32;i++){const char *e=memchr(at,'\n',(size_t)(end-at));size_t k=strlen(origin_keys[i]);if(!e||(size_t)(e-at)<=k+1||memcmp(at,origin_keys[i],k)||at[k]!='\t'||(size_t)(e-at-k-1)>=4096||memchr(at+k+1,'\t',(size_t)(e-at-k-1)))die("origin-report-row-order");size_t n=(size_t)(e-at-k-1);memcpy(out->value[i],at+k+1,n);out->value[i][n]=0;at=e+1;}if(at!=end)die("origin-report-trailing-bytes");np_free(&r);
 if(!tx_eq(out->value[9], origin_sp_pin, 1L << 20)||!tx_eq(out->value[10], origin_elf_pin, 1L << 20)||!tx_eq(out->value[16], origin_artifact_pin, 1L << 20)||!tx_eq(out->value[17], origin_manifest_pin, 1L << 20)||!tx_eq(out->value[18], origin_receipt_pin, 1L << 20))die("reviewed-origin-executor-and-package-identities");
 if(!tx_eq(out->value[0], "VERIFIED-origin-DAG-not-current-construction-no-test-result", 1L << 20)||!tx_eq(out->value[1], logical_root, 1L << 20)||!tx_eq(out->value[2], snapshot, 1L << 20)||!tx_eq(out->value[3], logical_pc, 1L << 20)||!tx_eq(out->value[4], physical_pc, 1L << 20)||!tx_eq(out->value[5], root, 1L << 20)||!tx_eq(out->value[6], origin_profile, 1L << 20)||!tx_eq(out->value[7], origin_elf, 1L << 20)||!tx_eq(out->value[8], spec_pin, 1L << 20)||!tx_eq(out->value[15], origin_expected, 1L << 20)||!tx_eq(out->value[23], producer_pin, 1L << 20)||!tx_eq(out->value[24], basis_pin, 1L << 20)||!tx_eq(out->value[25], out->value[9], 1L << 20)||!tx_eq(out->value[26], ks_pin, 1L << 20)||!tx_eq(out->value[27], "107", 1L << 20)||!tx_eq(out->value[28], "34", 1L << 20)||!tx_eq(out->value[29], "1004", 1L << 20)||number(out->value[14])<1||number(out->value[30])<1||number(out->value[31])<1)die("origin-report-identity-or-completeness");
 int hashes[]={8,9,10,11,12,13,15,16,17,18,19,20,21,23,24,25,26};for(int i=0;i<17;i++)if(!hex_n(out->value[hashes[i]],64))die("origin-report-hash-shape");char p[4400],h[65];path(p,root,"tools/cxlib/sourcepackage.cx");digest(p,h);if(!tx_eq(h, out->value[9], 1L << 20))die("origin-executing-module-mismatch");digest(origin_elf,h);if(!tx_eq(h, out->value[10], 1L << 20))die("origin-executing-ELF-mismatch");digest(origin_profile,h);if(!tx_eq(h, out->value[11], 1L << 20))die("origin-profile-mismatch");np_puts(stable,"source-package-adopted-origin-v1\n");for(int i=0;i<32;i++)if(i!=30)row(stable,origin_keys[i],out->value[i]);}

static int json_string(const char *s,const char *key,char *out,size_t cap,int optional){char needle[120];int z=snprintf(needle,sizeof needle,"\n  \"%s\": \"",key);if(z<0||(size_t)z>=sizeof needle)die("origin-execution-record-key");const char *a=strstr(s,needle);if(!a)return optional?0:-1;if(strstr(a+1,needle))return -1;a+=strlen(needle);const char *e=strchr(a,'"');if(!e||(size_t)(e-a)>=cap||memchr(a,'\\',(size_t)(e-a)))return -1;memcpy(out,a,(size_t)(e-a));out[e-a]=0;return 1;}
static void bootstrap_record(const char *s,size_t n,const char *artifact,size_t bytes){char a[65],source[65],commit[41],native[65],expected[1200];if(!n||n>=16384||memchr(s,0,n)||memchr(s,'\r',n)||json_string(s,"artifact_sha256",a,sizeof a,0)!=1||!tx_eq(a, artifact, 1L << 20)||json_string(s,"sources_sha256",source,sizeof source,0)!=1||!hex_n(source,64)||json_string(s,"commit",commit,sizeof commit,0)!=1||!hex_n(commit,40))die("origin-execution-bootstrap-record");int nh=json_string(s,"native_construction_sha256",native,sizeof native,1),z;if(nh<0||(nh&&!hex_n(native,64)))die("origin-execution-bootstrap-native-record");if(nh)z=snprintf(expected,sizeof expected,"{\n  \"artifact_sha256\": \"%s\",\n  \"bytes\": %lu,\n  \"commit\": \"%s\",\n  \"schema\": 1,\n  \"settings\": {},\n  \"sources_sha256\": \"%s\",\n  \"native_construction_sha256\": \"%s\"\n}\n",a,(unsigned long)bytes,commit,source,native);else z=snprintf(expected,sizeof expected,"{\n  \"artifact_sha256\": \"%s\",\n  \"bytes\": %lu,\n  \"commit\": \"%s\",\n  \"schema\": 1,\n  \"settings\": {},\n  \"sources_sha256\": \"%s\"\n}\n",a,(unsigned long)bytes,commit,source);if(z<0||(size_t)z!=n||memcmp(expected,s,n))die("origin-execution-bootstrap-record-canonical");}

/* Literal replay of the v2 kernel/assembler construction contract. Only the
 * explicit compiler-input role uses saved bootstrap bytes; receipt labels and
 * all44 source/object observations remain the original complete contract. */
static unsigned long long kernel_u64(const char *p){unsigned long long v=0;for(int i=7;i>=0;i--)v=(v<<8)|(unsigned char)p[i];return v;}
static void kernel_construction(np_buf *out,const char *kernel_context_sha){
 const char *inputs[]={"src/asmtext.c","src/internal_types.h","tools/asm-material.cx","unisacc.com","tests/assembler.cx","tests/arm-assembler.cx","tests/asm-layout.cx"};const char *outputs[]={"assembler.cx","contracts.cx"};char p[4400],dir[4400],h[65],assembler_source[65],assembler_binary[65];np_buf material={0};np_puts(&material,"unisacc-asm-material-v3\nstatus\tPREPARED\nscope\tsource-preserving-C-assembler-transition\nroot\t");np_puts(&material,root);np_puts(&material,"\n");for(int i=0;i<7;i++){if(i==3)strcpy(p,bootstrap);else path(p,root,inputs[i]);size_t n;char *data=load(p,&n);hash_bytes(data,n,h);free(data);np_puts(&material,i==3?"compiler-input\t":"source-input\t");np_puts(&material,inputs[i]);np_puts(&material,"\t");np_putll(&material,(long long)n);np_puts(&material,"\t");np_puts(&material,h);np_puts(&material,"\n");}path(dir,kgen,"assembler");for(int i=0;i<2;i++){path(p,dir,outputs[i]);size_t n;char *data=load(p,&n);hash_bytes(data,n,h);free(data);if(!i)strcpy(assembler_source,h);np_puts(&material,"material\t");np_puts(&material,outputs[i]);np_puts(&material,"\t");np_putll(&material,(long long)n);np_puts(&material,"\t");np_puts(&material,h);np_puts(&material,"\n");}path(p,dir,"material.tsv");equal(p,&material);hash_bytes(material.p,material.n,h);row(out,p,h);free(material.p);path(p,kgen,"assembler-native");digest(p,assembler_binary);np_buf native={0};np_puts(&native,"native-assembler-cache-v1\nflags\t-O2 -fno-trim-libc\n");row(&native,"context",kernel_context_sha);row(&native,"source",assembler_source);row(&native,"artifact",assembler_binary);path(p,kgen,"assembler-native.tsv");equal(p,&native);hash_bytes(native.p,native.n,h);row(out,p,h);free(native.p);
 const char *units[]={"transition","arith","buffer","memory","intern","bytes","format","stack","action","run","bridge"};const char *arches[]={"arm64","x86_64"};for(int a=0;a<2;a++)for(int e=0;e<2;e++){np_buf files={0};np_puts(&files,"unisacc-native-kernel-files-v1\n");for(int i=0;i<11;i++){char name[160];snprintf(name,sizeof name,"%s/%s.%s",arches[a],units[i],e?"o":"s");path(p,kgen,name);digest(p,h);row(&files,name,h);}char receipt[100];snprintf(receipt,sizeof receipt,"%s-%s.tsv",arches[a],e?"objects":"sources");path(p,kgen,receipt);equal(p,&files);hash_bytes(files.p,files.n,h);row(out,p,h);free(files.p);}
}
static void kernel_state_observe(np_buf *out){
 char p[4400],h[65],expected_helper[65];size_t n;path(p,kgen,"identity-helper.sha256");char *s=load(p,&n);if(n!=64)die("kernel-helper-receipt");memcpy(expected_helper,s,64);expected_helper[64]=0;free(s);path(p,kgen,"identity-helper");digest(p,h);if(!tx_eq(h, expected_helper, 1L << 20))die("kernel-helper-changed");
