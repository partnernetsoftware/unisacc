static void prepare(void){absent(pc);prepare_root_role();Endpoint *before=endpoint();if(mkdir(pc,0700))die("exclusive-pack-context");char p[4400];pc_file(p,"kernels");if(mkdir(p,0700))die("exclusive-private-kernels");pc_file(p,"context.tsv");write_new(p,before->context.p,before->context.n);pc_file(p,"adopted-origin.tsv");write_new(p,before->origin.p,before->origin.n);pc_file(p,"necessary-inputs.tsv");write_new(p,before->necessary.p,before->necessary.n);pc_file(p,"kernel-state.tsv");write_new(p,before->kernel.p,before->kernel.n);pc_file(p,"routes.tsv");write_new(p,before->routes.p,before->routes.n);const char *arches[]={"arm64.kernel","x86_64.kernel"},*resources[]={"arm64","x86_64"};for(int i=0;i<2;i++){char src[4400],dir[4400];path(src,kgen,arches[i]);pc_file(dir,"kernels");path(p,dir,resources[i]);copy_exact(src,p);}Endpoint *after=endpoint();endpoint_equal(before,after);verify_prepared(after);exact_kernel_directory();prepare_root_role();np_buf report={0};np_puts(&report,"source-package-adoption-prepare-v1\n");row(&report,"status","PREPARED-ADOPTED-origin-data-pack-NOT_EXECUTED-no-test-result");char h[65];hash_bytes(after->context.p,after->context.n,h);row(&report,"context",h);row(&report,"current-source",after->current_source);row(&report,"origin-source",after->origin_source);emit_observations(&report,before,after);stdout_bytes(&report);free(report.p);endpoint_free(before);endpoint_free(after);}
static void pack(void){Endpoint *before=endpoint();verify_prepared(before);exact_kernel_directory();char p[4400],dir[4400];pc_file(dir,"pack");absent(dir);pc_file(p,"compiler.pkg");absent(p);if(mkdir(dir,0700))die("exclusive-pack-phase");Args *a=pack_args();np_buf argv=argv_record(a);phase_file(p,"command.argv.tsv");write_new(p,argv.p,argv.n);free(argv.p);np_result r={0};char why[1600]={0};check_environment();int transport=np_run(a->v,root,0,40,&r,why,sizeof why);free(a);phase_file(p,"command.stdout");write_new(p,r.out,r.outn);phase_file(p,"command.stderr");write_new(p,r.err,r.errn);np_buf status={0};if(transport){np_puts(&status,"rc\tUNKNOWN\ntransport\tFAILED\n");phase_file(p,"command.transport");write_new(p,why,strlen(why));}else number_row(&status,"rc",r.rc);phase_file(p,"command.status");write_new(p,status.p,status.n);free(status.p);int rc=r.rc;np_free(&r);if(transport||rc)die("actual-pack-failed-partial-evidence-retained");Endpoint *after=endpoint();endpoint_equal(before,after);verify_prepared(after);exact_kernel_directory();np_buf receipt=phase_record(after);phase_file(p,"record.tsv");write_new(p,receipt.p,receipt.n);equal(p,&receipt);free(receipt.p);np_buf report={0};np_puts(&report,"source-package-adoption-pack-prepared-v1\n");row(&report,"status","PREPARED-EXECUTED-pack-ADOPTED-origin-NN-no-test-result");package_identity(&report);emit_observations(&report,before,after);stdout_bytes(&report);free(report.p);endpoint_free(before);endpoint_free(after);}
static np_buf complete_inputs(const Endpoint *e){verify_prepared(e);exact_kernel_directory();verify_phase(e);np_buf b={0};np_puts(&b,"source-package-adoption-inputs-v1\n");row(&b,"status","ADOPTED-34-origin-models-EXECUTED-only-pack-no-test-result");row(&b,"source",e->current_source);row(&b,"origin-source",e->origin_source);const char *files[]={"context.tsv","adopted-origin.tsv","necessary-inputs.tsv","kernel-state.tsv","routes.tsv","kernels/arm64","kernels/x86_64","pack/record.tsv","pack/command.argv.tsv","pack/command.stdout","pack/command.stderr","pack/command.status"};char p[4400],h[65];for(int i=0;i<12;i++){pc_file(p,files[i]);digest(p,h);row(&b,files[i],h);}row(&b,"origin-spec",e->origin_report.value[8]);row(&b,"origin-verifier",e->origin_report.value[9]);row(&b,"origin-verifier-ELF",e->origin_report.value[10]);row(&b,"origin-execution-profile",e->origin_report.value[11]);row(&b,"origin-execution-closure",e->origin_report.value[12]);row(&b,"origin-mapping",e->origin_report.value[13]);row(&b,"current-include",e->ni.current_include);row(&b,"origin-include",e->ni.origin_include);row(&b,"necessary-NN-input-witness",e->ni.witness);row(&b,"kernel-context",e->kernel_context);row(&b,"foundation",basis_pin);row(&b,"origin-consumer",producer_pin);row(&b,"models","34-ADOPTED-no-reexecution");row(&b,"jobs","107-origin-provenance-verified-no-reexecution");row(&b,"declaration","ADOPTED-original-native-compilerpack-output");row(&b,"operation","EXECUTED-pack");row(&b,"source-origin","old-actual-argv-status-and-receipts-preserved-at-origin-no-new-history-for-old-NN");row(&b,"trust","bootstrap-native-HOSTCC-systemdeps-zlib-and-kernelcrypto-declared-nonhermetic-unsigned-consistency-no-PASS");package_identity(&b);return b;}
static np_buf package_record(const Endpoint *e,const np_buf *inputs){np_buf b={0};np_puts(&b,"source-package-adoption-v1\n");row(&b,"status","PREPARED-ADOPTED-origin-NN-EXECUTED-pack-no-test-result");row(&b,"environment-policy",environment_policy);row(&b,"source",e->current_source);row(&b,"origin-source",e->origin_source);row(&b,"root",root);row(&b,"snapshot-root",snapshot);row(&b,"logical-root",logical_root);row(&b,"logical-package",logical_pc);row(&b,"physical-package",physical_pc);row(&b,"pack-context",pc);row(&b,"kernel-generation",kgen);row(&b,"kernel-context",e->kernel_context);row(&b,"foundation",basis_pin);row(&b,"origin-consumer",producer_pin);row(&b,"origin-spec",spec_pin);row(&b,"executing-origin-verifier",e->origin_report.value[9]);row(&b,"executing-origin-ELF",e->origin_report.value[10]);row(&b,"executing-origin-profile",e->origin_report.value[11]);row(&b,"executing-origin-closure",e->origin_report.value[12]);char h[65],p[4400];hash_bytes(inputs->p,inputs->n,h);row(&b,"model-inputs.tsv",h);hash_bytes(e->context.p,e->context.n,h);row(&b,"adoption-context",h);phase_file(p,"record.tsv");digest(p,h);row(&b,"pack-receipt",h);row(&b,"necessary-NN-inputs",e->ni.witness);row(&b,"current-include",e->ni.current_include);row(&b,"origin-include",e->ni.origin_include);controller_state(&b);package_identity(&b);row(&b,"jobs","107");row(&b,"models","34");row(&b,"model-operation","ADOPTED-not-constructed-current-source");row(&b,"declaration-operation","ADOPTED-origin-native-compilerpack-not-reexecuted");row(&b,"pack-operation","EXECUTED-native-pack-current-headers");row(&b,"scope","material-identity-only-not-P7-or-source-package-v1-no-historical-compilation-hermetic-CC-full-N22-NN-functional-PASS-or-foreign-host-qualification");return b;}
static void final_stage(int verify){char inputs_path[4400],receipt_path[4400];pc_file(inputs_path,"model-inputs.tsv");pc_file(receipt_path,"package.tsv");if(!verify){absent(inputs_path);absent(receipt_path);}Endpoint *before=endpoint();np_buf a=complete_inputs(before),ar=package_record(before,&a);if(verify){equal(inputs_path,&a);equal(receipt_path,&ar);}Endpoint *after=endpoint();endpoint_equal(before,after);np_buf z=complete_inputs(after),zr=package_record(after,&z);same(&a,&z,"full-package-inputs-changed-between-endpoints");same(&ar,&zr,"full-package-receipt-changed-between-endpoints");if(verify){equal(inputs_path,&z);equal(receipt_path,&zr);}else{write_new(inputs_path,z.p,z.n);write_new(receipt_path,zr.p,zr.n);equal(inputs_path,&z);equal(receipt_path,&zr);}char artifact[65],manifest[65],receipt[65],context_hash[65];pc_file(inputs_path,"compiler.pkg");digest(inputs_path,artifact);hash_bytes(z.p,z.n,manifest);hash_bytes(zr.p,zr.n,receipt);hash_bytes(after->context.p,after->context.n,context_hash);np_buf report={0};np_puts(&report,verify?"source-package-adoption-verify-v1\n":"source-package-adoption-seal-v1\n");row(&report,"status",verify?"VERIFIED-ADOPTED-origin-data-EXECUTED-pack-no-test-result":"PREPARED-ADOPTED-origin-data-EXECUTED-pack-no-test-result");row(&report,"artifact",artifact);row(&report,"manifest",manifest);row(&report,"receipt",receipt);row(&report,"context",context_hash);row(&report,"current-source",after->current_source);row(&report,"origin-source",after->origin_source);row(&report,"jobs","107");row(&report,"models","34");row(&report,"kernel-context",after->kernel_context);row(&report,"origin-spec",spec_pin);row(&report,"origin-verifier",after->origin_report.value[9]);row(&report,"origin-ELF",after->origin_report.value[10]);row(&report,"origin-profile",after->origin_report.value[11]);row(&report,"origin-execution-closure",after->origin_report.value[12]);row(&report,"origin-mapping",after->origin_report.value[13]);row(&report,"NI-witness",after->ni.witness);row(&report,"NI-module",after->ni.verifier);row(&report,"netpack-module",after->ni.netpack);row(&report,"kernelsha-module",after->ni.kernelsha);char h[65];digest(self,h);row(&report,"controller-source",h);digest(self_elf,h);row(&report,"controller-ELF",h);row(&report,"bootstrap",bootstrap);digest(bootstrap,h);row(&report,"bootstrap-sha",h);int bz=snprintf(inputs_path,sizeof inputs_path,"%s.build.json",bootstrap);if(bz<0||(size_t)bz>=sizeof inputs_path)die("bootstrap-record-path");digest(inputs_path,h);row(&report,"bootstrap-record-sha",h);emit_observations(&report,before,after);stdout_bytes(&report);free(report.p);free(a.p);free(ar.p);free(z.p);free(zr.p);endpoint_free(before);endpoint_free(after);}

/* One invocation-owned metadata view, independently fresh on every call.
 * This is not the double-endpoint --verify contract and supplies no atomic,
 * concurrent-mutator or ABA proof. Parents compare independent calls. */
static void snapshot_stage(void){long long begin=now_ns();Endpoint *e=endpoint();np_buf inputs=complete_inputs(e),record=package_record(e,&inputs);char inputs_path[4400],receipt_path[4400];pc_file(inputs_path,"model-inputs.tsv");pc_file(receipt_path,"package.tsv");equal(inputs_path,&inputs);equal(receipt_path,&record);char artifact[65],manifest[65],receipt[65],context_hash[65];pc_file(inputs_path,"compiler.pkg");digest(inputs_path,artifact);hash_bytes(inputs.p,inputs.n,manifest);hash_bytes(record.p,record.n,receipt);hash_bytes(e->context.p,e->context.n,context_hash);np_buf report={0};np_puts(&report,"source-package-adoption-snapshot-v1\n");row(&report,"status","VERIFIED-single-endpoint-ADOPTED-origin-data-EXECUTED-pack-no-test-result");row(&report,"artifact",artifact);row(&report,"manifest",manifest);row(&report,"receipt",receipt);row(&report,"context",context_hash);row(&report,"current-source",e->current_source);row(&report,"origin-source",e->origin_source);row(&report,"jobs","107");row(&report,"models","34");row(&report,"kernel-context",e->kernel_context);row(&report,"origin-spec",spec_pin);row(&report,"origin-verifier",e->origin_report.value[9]);row(&report,"origin-ELF",e->origin_report.value[10]);row(&report,"origin-profile",e->origin_report.value[11]);row(&report,"origin-execution-closure",e->origin_report.value[12]);row(&report,"origin-mapping",e->origin_report.value[13]);row(&report,"NI-witness",e->ni.witness);row(&report,"NI-module",e->ni.verifier);row(&report,"netpack-module",e->ni.netpack);row(&report,"kernelsha-module",e->ni.kernelsha);char h[65];digest(self,h);row(&report,"controller-source",h);digest(self_elf,h);row(&report,"controller-ELF",h);row(&report,"bootstrap",bootstrap);digest(bootstrap,h);row(&report,"bootstrap-sha",h);int bz=snprintf(inputs_path,sizeof inputs_path,"%s.build.json",bootstrap);if(bz<0||(size_t)bz>=sizeof inputs_path)die("bootstrap-record-path");digest(inputs_path,h);row(&report,"bootstrap-record-sha",h);number_row(&report,"origin-physical-reads",number(e->origin_report.value[29]));number_row(&report,"origin-executor-reads",number(e->origin_report.value[14]));number_row(&report,"origin-wrapper-reads",number(e->origin_report.value[31]));number_row(&report,"NI-physical-reads",e->ni.physical_reads);number_row(&report,"controller-physical-reads",e->own_physical_reads);number_row(&report,"controller-physical-reads-post-endpoint",own_reads-e->own_physical_reads);number_row(&report,"endpoint-ns",e->elapsed_ns);number_row(&report,"origin-endpoint-ns",number(e->origin_report.value[30]));number_row(&report,"NI-ns",e->ni.elapsed_ns);long long end=now_ns();if(end<begin)die("snapshot-monotonic-clock-backwards");number_row(&report,"snapshot-body-ns",end-begin);row(&report,"identity-helper-internal-reads","UNMEASURED");row(&report,"libneed-internal-reads","UNMEASURED");row(&report,"observations-scope","single-fresh-metadata-view-not-atomic-ABA-or-test-PASS;body-time-excludes-startup-context-restore-stdout;timings-and-counts-not-stable-digest-inputs");stdout_bytes(&report);free(report.p);free(inputs.p);free(record.p);endpoint_free(e);}

static void setup_common(void){directory(root);directory(snapshot);lexical(logical_root);lexical(logical_pc);directory(kgen);canonical(bootstrap);canonical(trusted);canonical(origin_elf);canonical(origin_profile);lexical(pc);if(tx_eq(root, snapshot, 1L << 20)||!within(pc,root)||within(pc,snapshot)||within(origin_elf,snapshot)||within(origin_profile,snapshot)||!within(origin_elf,root)||!within(origin_profile,root))die("explicit-path-roles");mapped(logical_pc,physical_pc);directory(physical_pc);char p[4400],ctx[4096];path(p,physical_pc,"context.tsv");size_t n;char *s=load(p,&n);field(s,n,"source-context",ctx,sizeof ctx);free(s);mapped(ctx,origin_ctx);directory(origin_ctx);char allowed[4400];path(allowed,root,"out");if(!within(pc,allowed)||within(pc,kgen)||within(pc,physical_pc)||within(pc,origin_ctx))die("new-PC-must-be-independent-ignored-out");path(bound,root,"tools/bound");path(self,root,"tools/source-package-adopt.cx");canonical(self);char own[4400];if(__FILE__[0]=='/'){if(strlen(__FILE__)>=sizeof own)die("own-source-bound");strcpy(own,__FILE__);}else path(own,root,__FILE__);canonical(own);if(!tx_eq(own, self, 1L << 20))die("actual-controller-source-required");digest_selfcheck();}
static void restore_context(const char *input){directory(input);strcpy(pc,input);char p[4400];pc_file(p,"context.tsv");size_t n;char *s=load(p,&n);const char *schema="source-package-adoption-context-v1\n";if(n<strlen(schema)||memcmp(s,schema,strlen(schema)))die("known-adoption-schema-required");char declared_root[4096];field(s,n,"root",declared_root,sizeof declared_root);if(!tx_eq(root, declared_root, 1L << 20))die("context-root-mismatch");field(s,n,"snapshot-root",snapshot,sizeof snapshot);field(s,n,"logical-root",logical_root,sizeof logical_root);field(s,n,"logical-package",logical_pc,sizeof logical_pc);field(s,n,"kernel-generation",kgen,sizeof kgen);field(s,n,"bootstrap",bootstrap,sizeof bootstrap);field(s,n,"trusted-libneed",trusted,sizeof trusted);field(s,n,"origin-verifier-ELF-path",origin_elf,sizeof origin_elf);field(s,n,"origin-profile-path",origin_profile,sizeof origin_profile);free(s);setup_common();}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN source-package-adopt requires Linux/x86_64/LP64 native\n",stderr);return 3;
#else
 if(sizeof(long)!=8||sizeof(void *)!=8)die("LP64-required");clean_environment();if(argc==12&&tx_eq(argv[1], "prepare", 1L << 20)){char *dest[]={root,snapshot,logical_root,logical_pc,kgen,bootstrap,trusted,origin_elf,origin_profile,pc};for(int i=0;i<10;i++){lexical(argv[i+2]);strcpy(dest[i],argv[i+2]);}setup_common();prepare();return 0;}if(argc==4&&(tx_eq(argv[1], "pack", 1L << 20)||tx_eq(argv[1], "seal", 1L << 20)||tx_eq(argv[1], "--verify", 1L << 20)||tx_eq(argv[1], "--snapshot", 1L << 20))){lexical(argv[2]);strcpy(root,argv[2]);restore_context(argv[3]);if(tx_eq(argv[1], "pack", 1L << 20))pack();else if(tx_eq(argv[1], "--snapshot", 1L << 20))snapshot_stage();else final_stage(tx_eq(argv[1], "--verify", 1L << 20));return 0;}die("usage prepare ROOT SNAPROOT LOGICAL_ROOT LOGICAL_PC KGEN ABS_SAVED_BOOTSTRAP TRUSTED_LIBNEED ORIGIN_VERIFIER_ELF ORIGIN_PROFILE NEW_PC | pack|seal|--verify|--snapshot ROOT PC");return 2;
#endif
}
