#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.sig
#pragma unisa use text.text
#pragma unisa use mem.heap
/* Does a project's own include/ directory shadow a bundled header? (C43-SHADOW-01)
 *
 *   sh ./unisacc.com tools/check-include-shadow.cx -- ROOT
 *
 * The product used to search a cwd-relative "include/" directory as if it were
 * a system directory: a project that happened to have include/stdio.h silently
 * replaced the bundled header, and a shipped binary read headers out of
 * whatever directory it was started in.  C99 6.10.2p2/p3 give <...> only the
 * implementation's system directories; that directory must be embedded, and a
 * tree header is reachable only through an explicit -I whose spelling is not
 * bare "include/" (for example -I <root>/include or -I ./include).
 *
 * Eight observations, each an end-to-end compile with the product:
 *   1 tree-header-ignored              <stdio.h> with cwd include/stdio.h at #error
 *   2 quote-not-searching-cwd-include  "stdio.h", no stdio.h beside the source
 *   3 embedded-header-used             clean directory, <stdio.h> still compiles
 *   4 cx-prelude-not-shadowed          .cx unit with cwd include/cx.h at #error
 *   5 cxflat-prelude-not-shadowed      .cx unit with cwd include/cx-flat.h at #error
 *   6 explicit-include-read            -I <dir>/include with stdio.h at #error
 *   7 explicit-dot-include-read        -I ./include with stdio.h at #error
 *   8 parent-directory-not-searched    parent include/stdio.h at #error, cwd one level down
 * The first three and the last assert rc==0 (the embedded header is what got
 * used); 6 and 7 assert rc!=0 (the explicit directory really was searched), so
 * a silently ignored -I cannot pass.
 */
static int g_fail;
static void die(const char *s) { sy_eprintf("include-shadow: REFUSE %s\n", s); sy_exit(2); }
static void ck(int ok, const char *name) {
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", name);
    if (!ok) g_fail = g_fail + 1;
}

static char root[4096], com[4400], bound[4400], work[4400];

static void mkdirs(const char *p) {
    char b[4400];
    long i, n = tx_len(p, 4400);
    if (n <= 0 || n + 1 > 4400) die("mkdirs");
    if (tx_copy(b, 4400, p, n + 1)) die("mkdirs");
    for (i = 1; i < n; i = i + 1) {
        if (b[i] == '/') { b[i] = 0; sy_mkdir(b, 0755); b[i] = '/'; }
    }
    sy_mkdir(b, 0755);
}

static void put(const char *path, const char *text) {
    int fd = sy_open(path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (fd < 0) die("write fixture");
    if (sy_write_all(fd, text, tx_len(text, 8192))) die("write fixture");
    sy_close(fd);
}

/* one compile; cwd is the directory the product is started in, inc an optional
   -I argument. Returns the product's exit status. */
static int build(const char *cwd, const char *src, const char *img, const char *inc) {
    char *v[16];
    char why[512];
    np_result r;
    int i = 0;
    int rc;
    v[i++] = bound; v[i++] = "50"; v[i++] = com;
    v[i++] = "-b"; v[i++] = "lnx/x86_64";
    if (inc) { v[i++] = "-I"; v[i++] = (char *)inc; }
    v[i++] = "-o"; v[i++] = (char *)img; v[i++] = (char *)src; v[i] = 0;
    if (np_run(v, cwd, 0, 50, &r, why, sizeof why)) die(why);
    rc = r.rc;
    np_free(&r);
    return rc;
}

int main(int argc, char **argv) {
    char p[4400], s[4400], img[4400];
    if (argc >= 2 && (tx_len(argv[1], 4400) == 0 || argv[1][0] != '/')) die("root");
    if (argc >= 2) { if (tx_copy(root, 4096, argv[1], tx_len(argv[1], 4096))) die("root"); }
    else if (sy_cwd(root, 4096) < 0) die("cwd");
    if (cx_fmt(com, sizeof com, "%s/unisacc.com", root)) die("com");
    if (cx_fmt(bound, sizeof bound, "%s/tools/bound", root)) die("bound");
    /* Scratch under $TMPDIR (or /tmp); keep the path off the repo tree (outdep). */
    if (sy_mkdtemp(sy_tmpdir(), "cis-", work, (int)sizeof work)) die("work");

    /* 1: cwd include/stdio.h must not be read for <stdio.h> */
    if (cx_fmt(p, sizeof p, "%s/shadow/include", work)) die("p1");
    mkdirs(p);
    if (cx_fmt(p, sizeof p, "%s/shadow/include/stdio.h", work)) die("p2");
    put(p, "#error SHADOWED_BY_CWD_INCLUDE\n");
    if (cx_fmt(s, sizeof s, "%s/shadow/a.cx", work)) die("s1");
    put(s, "#include <stdio.h>\nint main(void) { return 0; }\n");
    if (cx_fmt(img, sizeof img, "%s/shadow/a.img", work)) die("i1");
    { char d[4400]; if (cx_fmt(d, sizeof d, "%s/shadow", work)) die("d1");
      ck(build(d, s, img, 0) == 0, "tree-header-ignored"); }

    /* 2: "stdio.h" searches the including file's directory, not cwd/include */
    if (cx_fmt(s, sizeof s, "%s/shadow/q.cx", work)) die("s2");
    put(s, "#include \"stdio.h\"\nint main(void) { return 0; }\n");
    if (cx_fmt(img, sizeof img, "%s/shadow/q.img", work)) die("i2");
    { char d[4400]; if (cx_fmt(d, sizeof d, "%s/shadow", work)) die("d2");
      ck(build(d, s, img, 0) == 0, "quote-not-searching-cwd-include"); }

    /* 3: with nothing beside it, <stdio.h> comes from the embedded table */
    if (cx_fmt(p, sizeof p, "%s/clean", work)) die("p3");
    mkdirs(p);
    if (cx_fmt(s, sizeof s, "%s/clean/a.cx", work)) die("s3");
    put(s, "#include <stdio.h>\nint main(void) { return 0; }\n");
    if (cx_fmt(img, sizeof img, "%s/clean/a.img", work)) die("i3");
    { char d[4400]; if (cx_fmt(d, sizeof d, "%s/clean", work)) die("d3");
      ck(build(d, s, img, 0) == 0, "embedded-header-used"); }

    /* 4: the .cx prelude cx.h must not be shadowed by cwd include/cx.h */
    if (cx_fmt(p, sizeof p, "%s/cxroot/include", work)) die("p4");
    mkdirs(p);
    if (cx_fmt(p, sizeof p, "%s/cxroot/include/cx.h", work)) die("p5");
    put(p, "#error SHADOWED_CX_PRELUDE\n");
    if (cx_fmt(s, sizeof s, "%s/cxroot/a.cx", work)) die("s4");
    put(s, "int main(void) { return 0; }\n");
    if (cx_fmt(img, sizeof img, "%s/cxroot/a.img", work)) die("i4");
    { char d[4400]; if (cx_fmt(d, sizeof d, "%s/cxroot", work)) die("d4");
      ck(build(d, s, img, 0) == 0, "cx-prelude-not-shadowed"); }

    /* 5: same for the flattened prelude */
    if (cx_fmt(p, sizeof p, "%s/cxflat/include", work)) die("p6");
    mkdirs(p);
    if (cx_fmt(p, sizeof p, "%s/cxflat/include/cx-flat.h", work)) die("p7");
    put(p, "#error SHADOWED_CX_FLAT_PRELUDE\n");
    if (cx_fmt(s, sizeof s, "%s/cxflat/a.cx", work)) die("s5");
    put(s, "int main(void) { return 0; }\n");
    if (cx_fmt(img, sizeof img, "%s/cxflat/a.img", work)) die("i5");
    { char d[4400]; if (cx_fmt(d, sizeof d, "%s/cxflat", work)) die("d5");
      ck(build(d, s, img, 0) == 0, "cxflat-prelude-not-shadowed"); }

    /* 6: an explicit -I <dir>/include is still searched */
    if (cx_fmt(p, sizeof p, "%s/inc/include", work)) die("p8");
    mkdirs(p);
    if (cx_fmt(p, sizeof p, "%s/inc/include/stdio.h", work)) die("p9");
    put(p, "#error EXPLICIT_INCLUDE_READ\n");
    if (cx_fmt(s, sizeof s, "%s/inc/a.cx", work)) die("s6");
    put(s, "#include <stdio.h>\nint main(void) { return 0; }\n");
    if (cx_fmt(img, sizeof img, "%s/inc/a.img", work)) die("i6");
    { char d[4400], id[4400];
      if (cx_fmt(d, sizeof d, "%s/inc", work)) die("d6");
      if (cx_fmt(id, sizeof id, "%s/inc/include", work)) die("id6");
      ck(build(d, s, img, id) != 0, "explicit-include-read"); }

    /* 7: -I ./include (a spelling other than bare "include/") is searched too */
    if (cx_fmt(img, sizeof img, "%s/inc/b.img", work)) die("i7");
    { char d[4400];
      if (cx_fmt(d, sizeof d, "%s/inc", work)) die("d7");
      ck(build(d, s, img, "./include") != 0, "explicit-dot-include-read"); }

    /* 8: a parent directory's include/ is not searched either */
    if (cx_fmt(p, sizeof p, "%s/outer/include", work)) die("p10");
    mkdirs(p);
    if (cx_fmt(p, sizeof p, "%s/outer/include/stdio.h", work)) die("p11");
    put(p, "#error SHADOWED_BY_PARENT_INCLUDE\n");
    if (cx_fmt(p, sizeof p, "%s/outer/sub", work)) die("p12");
    mkdirs(p);
    if (cx_fmt(s, sizeof s, "%s/outer/sub/a.cx", work)) die("s8");
    put(s, "#include <stdio.h>\nint main(void) { return 0; }\n");
    if (cx_fmt(img, sizeof img, "%s/outer/sub/a.img", work)) die("i8");
    { char d[4400]; if (cx_fmt(d, sizeof d, "%s/outer/sub", work)) die("d8");
      ck(build(d, s, img, 0) == 0, "parent-directory-not-searched"); }

    printf("CHECK_INCLUDE_SHADOW\tassertions=8\tfailed=%d\n", g_fail);
    return g_fail ? 1 : 0;
}
