/* Independent local Git contracts, not historical replay qualification.
 * --native ABS_INTEGRATE ROOT supplies the actual built integrator and product.
 * 无参入口用当前ROOT真实产品构建唯一临时native，再运行同一组用例。
 * No fake metadata/ratchet/precommit programs are installed in fixture roots;
 * --prepare-only is deliberately NOT a gate verdict. Parent separately runs
 * five real 0.0.48 patches through the production gates and their budgets. */
#pragma unisa use cxlib.appendmerge
#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use mem.bytes
#pragma unisa use cxlib.productpkg
#pragma unisa use sys.time
static int checks,failed;static char why[1000];static long deadline;
static void die(const char *s){fprintf(stderr,"check-integrate-patch: %s\n",s);exit(2);}
static void ck(int ok,const char *s){checks++;printf("%s\t%s\n",ok?"PASS":"FAIL",s);if(!ok)failed++;}
static void path(char *p,size_t c,const char *a,const char *b){if(cx_fmt(p,c,"%s/%s",a,b))die("path");}
static void put(const char *p,const char *s,size_t n){if(cx_write(p,s,n))die("write");}
static np_result run(char **v,const char *cwd,int secs){long remaining=(deadline-sy_now_ms()-1000)/1000;if(remaining<1)die("check-deadline");if(remaining<secs)secs=(int)remaining;np_result r={0};if(np_run(v,cwd,0,secs,&r,why,sizeof why)||r.residue)die("transport");return r;}
static void ok(char **v,const char *cwd){np_result r=run(v,cwd,12);if(r.rc){if(r.errn)fwrite(r.err,1,r.errn,stderr);die("git-command");}np_free(&r);}
static void commit(const char *where){char *a[]={"git","-C",(char*)where,"add","--all",0};ok(a,0);char *c[]={"git","-C",(char*)where,"-c","user.name=Fixture","-c","user.email=you@example.com","-c","core.hooksPath=/dev/null","commit","-m","fixture",0};ok(c,0);}
static void append(const char *where,const char *key){for(int k=0;k<4;k++){char p[4400],row[2000];path(p,sizeof p,where,am_path(k));if(k==0){if(cx_fmt(row,sizeof row,"2026-11-09\tSHARED\t%s\t-\tevidence-%s\tfixture\n",key,key))die("row");}else if(k==1){if(cx_fmt(row,sizeof row,"%s\tg\timplementer\td\tg\tc\t1\t-\tREADY\to\tc\n",key))die("row");}else if(k==2){if(cx_fmt(row,sizeof row,"%s\tPLANNED\tinterfaces\ttools/a.cx\tSOURCE\tlnx/x86_64\t55\t-\ttools/a.cx\t-\tcov\trc0:A\tproduct\trelease\n",key))die("row");}else{if(cx_fmt(row,sizeof row,"%s\tinterfaces\tDECLARED_DEPENDENCY\t%s\ta\n",key,key))die("row");}size_t n;char *old=cx_read(p,&n);if(!old)die("table-read");np_buf b={0};np_put(&b,old,n);np_puts(&b,row);put(p,b.p,b.n);free(old);free(b.p);}}
static void fixture(const char *top,const char *native,const char *productroot,int conflict){
 char seed[4400],root[4400],other[4400],dest[4400],patch[4400],p[4400];if(cx_fmt(seed,sizeof seed,"%s/seed-%d",top,conflict)||cx_fmt(root,sizeof root,"%s/root-%d",top,conflict)||cx_fmt(other,sizeof other,"%s/other-%d",top,conflict)||cx_fmt(dest,sizeof dest,"%s/candidate-%d",top,conflict)||cx_fmt(patch,sizeof patch,"%s/patch-%d.diff",top,conflict))die("fixture-path");char *init[]={"git","init","-b","main",seed,0};ok(init,0);
 path(p,sizeof p,seed,"agentwork");if(sy_mkdir(p,0700))die("mkdir");path(p,sizeof p,seed,"tests");if(sy_mkdir(p,0700))die("mkdir");for(int k=0;k<4;k++){path(p,sizeof p,seed,am_path(k));put(p,am_header(k),strlen(am_header(k)));}
 const char *ignore="unisacc.com\nunisacc.com.dev/\n";path(p,sizeof p,seed,".gitignore");put(p,ignore,strlen(ignore));const char *attrs="* -text\nagentwork/ledger.tsv merge=binary\nagentwork/items.tsv merge=binary\ntests/batches.tsv merge=binary\ntests/coverage.tsv merge=binary\n";path(p,sizeof p,seed,".gitattributes");put(p,attrs,strlen(attrs));path(p,sizeof p,seed,"plain.txt");put(p,"base\n",5);commit(seed);
 /* Independent main clones retain the common base without a development branch. */
 char *cr[]={"git","clone","--local","--no-hardlinks","--branch","main",seed,root,0};ok(cr,0);char *cl[]={"git","clone","--local","--no-hardlinks","--branch","main",seed,other,0};ok(cl,0);if(pp_copy_product(productroot,root))die("product-copy");append(other,"theirs");if(conflict){path(p,sizeof p,other,"plain.txt");put(p,"theirs\n",7);}commit(other);char *dv[]={"git","-C",other,"diff","--full-index","HEAD^","HEAD",0};np_result r=run(dv,0,12);if(r.rc)die("patch-diff");put(patch,r.out,r.outn);np_free(&r);
 append(root,"ours");if(conflict){path(p,sizeof p,root,"plain.txt");put(p,"ours\n",5);}commit(root);
 char *head[]={"git","-C",root,"rev-parse","HEAD",0};r=run(head,0,12);if(r.rc)die("head");char before[65];if(r.outn>=sizeof before)die("head-bound");if(mm_copy(before,sizeof before,r.out,(long)r.outn))die("head-copy-bound");before[r.outn]=0;np_free(&r);
 char *apply[]={(char*)native,root,patch,dest,"--prepare-only",0};r=run(apply,0,55);ck(r.rc==(conflict?1:0),conflict?"non-table-conflict-is-nonzero":"real-stale-patch-threeway-prepare");ck(r.out&&!strstr(r.out,"READY_TO_COMMIT")&&!strstr(r.out,"GATES_ONLY"),"prepare-never-claims-gate-pass");if(!conflict)ck(r.out&&strstr(r.out,"status=PREPARED"),"prepared-phase-explicit");np_free(&r);
 r=run(head,0,12);ck(!r.rc&&r.out&&!strcmp(r.out,before),"source-HEAD-unchanged");np_free(&r);char *clean[]={"git","-C",root,"diff","--exit-code","HEAD",0};r=run(clean,0,12);ck(!r.rc&&!r.outn,"source-index-and-working-tree-unchanged");np_free(&r);
 if(!conflict){for(int k=0;k<4;k++){path(p,sizeof p,dest,am_path(k));size_t n;char *s=cx_read(p,&n);ck(s&&strstr(s,"ours")&&strstr(s,"theirs"),"both-table-sides-preserved");free(s);}char *hb[]={"git","-C",dest,"symbolic-ref","--short","HEAD",0};r=run(hb,0,12);ck(!r.rc&&r.out&&!strcmp(r.out,"main\n"),"candidate-HEAD-is-main");np_free(&r);r=run(apply,0,55);ck(r.rc==2,"existing-target-refused");np_free(&r);
  /* Resume must validate the frozen index/tree before attempting any gates. */path(p,sizeof p,dest,"plain.txt");put(p,"tampered\n",9);char *resume[]={(char*)native,"--resume",dest,0};r=run(resume,0,30);ck(r.rc==2&&r.err&&strstr(r.err,"candidate-unstaged-changes"),"resume-rejects-changed-input");np_free(&r);
 }else{char *u[]={"git","-C",dest,"ls-files","--unmerged",0};r=run(u,0,12);ck(!r.rc&&r.out&&strstr(r.out," 1\tplain.txt")&&strstr(r.out," 2\tplain.txt")&&strstr(r.out," 3\tplain.txt"),"non-table-three-sides-retained-in-index");np_free(&r);}
}
static void entry_neg(const char *top,const char *native,const char *productroot){
 char seed[4400],root[4400],dest[4400],patch[4400],p[4400],bare[4400];
 if(cx_fmt(seed,sizeof seed,"%s/neg-seed",top)||cx_fmt(root,sizeof root,"%s/neg-root",top)||cx_fmt(dest,sizeof dest,"%s/neg-dest",top)||cx_fmt(patch,sizeof patch,"%s/neg.patch",top)||cx_fmt(bare,sizeof bare,"%s/neg-origin.git",top))die("neg-path");
 char *init[]={"git","init","-b","main",seed,0};ok(init,0);
 path(p,sizeof p,seed,"agentwork");if(sy_mkdir(p,0700))die("mkdir");path(p,sizeof p,seed,"tests");if(sy_mkdir(p,0700))die("mkdir");
 for(int k=0;k<4;k++){path(p,sizeof p,seed,am_path(k));put(p,am_header(k),strlen(am_header(k)));}
 path(p,sizeof p,seed,".gitignore");put(p,"unisacc.com\n",12);path(p,sizeof p,seed,"plain.txt");put(p,"base\n",5);commit(seed);
 char *cr[]={"git","clone","--local","--no-hardlinks","--branch","main",seed,root,0};ok(cr,0);if(pp_copy_product(productroot,root))die("product-copy");
 const char *bad="diff --git a/plain.txt b/plain.txt\n--- a/plain.txt\n+++ b/plain.txt\n@@ -1 +1 @@\n-base\n+x\n";put(patch,bad,strlen(bad));
 char *apply[]={(char*)native,root,patch,dest,"--prepare-only",0};np_result r=run(apply,0,30);
 ck(r.rc==2&&r.err&&strstr(r.err,"patch-not-git-diff-with-index")&&strstr(r.err,"git diff --full-index"),"refuse-patch-without-index");np_free(&r);
 char *bi[]={"git","init","--bare",bare,0};ok(bi,0);
 ck(1,"bare-origin-fixture");
}
static void freeze_and_compile_neg(const char *top,const char *native,const char *productroot){
 char seed[4400],root[4400],other[4400],dest[4400],patch[4400],p[4400];
 if(cx_fmt(seed,sizeof seed,"%s/fr-seed",top)||cx_fmt(root,sizeof root,"%s/fr-root",top)||cx_fmt(other,sizeof other,"%s/fr-other",top)||cx_fmt(dest,sizeof dest,"%s/fr-dest",top)||cx_fmt(patch,sizeof patch,"%s/fr.patch",top))die("fr-path");
 char *init[]={"git","init","-b","main",seed,0};ok(init,0);
 path(p,sizeof p,seed,"agentwork");if(sy_mkdir(p,0700))die("mkdir");path(p,sizeof p,seed,"tests");if(sy_mkdir(p,0700))die("mkdir");
 for(int k=0;k<4;k++){path(p,sizeof p,seed,am_path(k));put(p,am_header(k),strlen(am_header(k)));}
 path(p,sizeof p,seed,".gitignore");put(p,"unisacc.com\n",12);path(p,sizeof p,seed,"plain.txt");put(p,"base\n",5);commit(seed);
 char *cr[]={"git","clone","--local","--no-hardlinks","--branch","main",seed,root,0};ok(cr,0);char *cl[]={"git","clone","--local","--no-hardlinks","--branch","main",seed,other,0};ok(cl,0);if(pp_copy_product(productroot,root))die("product-copy");
 path(p,sizeof p,other,"tools");if(sy_mkdir(p,0700)&&sy_exists(p)!=1)die("tools");path(p,sizeof p,other,"tools/badident.cx");put(p,"int main(void){return NOPE;}\n",28);commit(other);
 char *dv[]={"git","-C",other,"diff","--full-index","HEAD^","HEAD",0};np_result r=run(dv,0,12);if(r.rc)die("fr-diff");put(patch,r.out,r.outn);np_free(&r);
 char *apply[]={(char*)native,root,patch,dest,"--prepare-only",0};r=run(apply,0,55);
 ck(r.rc==2&&r.err&&strstr(r.err,"tool-compile-failed"),"refuse-undeclared-identifier-compile");np_free(&r);
 char dest2[4400],patch2[4400];if(cx_fmt(dest2,sizeof dest2,"%s/fr-dest2",top)||cx_fmt(patch2,sizeof patch2,"%s/fr2.patch",top))die("fr2");
 path(p,sizeof p,other,"plain.txt");put(p,"ok\n",3);commit(other);
 r=run(dv,0,12);if(r.rc)die("fr2-diff");put(patch2,r.out,r.outn);np_free(&r);
 char *apply2[]={(char*)native,root,patch2,dest2,"--prepare-only",0};r=run(apply2,0,55);ck(!r.rc,"rewrite-prep");np_free(&r);
 put(patch2,"rewritten-after-freeze\n",23);
 char *rs[]={(char*)native,"--resume",dest2,0};r=run(rs,0,20);
 ck(r.rc==2&&r.err&&strstr(r.err,"patch-author-rewritten-after-freeze"),"refuse-author-patch-rewritten");np_free(&r);
}
static void land_real(const char *top,const char *native,const char *productroot){
 char bare[4400],root[4400],other[4400],dest[4400],patch[4400],msg[4400],p[4400];
 if(cx_fmt(bare,sizeof bare,"%s/land.git",top)||cx_fmt(root,sizeof root,"%s/land-root",top)||cx_fmt(other,sizeof other,"%s/land-other",top)||cx_fmt(dest,sizeof dest,"%s/land-dest",top)||cx_fmt(patch,sizeof patch,"%s/land.patch",top)||cx_fmt(msg,sizeof msg,"%s/land.msg",top))die("land-path");
 char *bi[]={"git","init","--bare","-b","main",bare,0};ok(bi,0);
 char *cl[]={"git","clone",bare,root,0};ok(cl,0);
 path(p,sizeof p,root,"agentwork");if(sy_mkdir(p,0700))die("mkdir");path(p,sizeof p,root,"tests");if(sy_mkdir(p,0700))die("mkdir");
 for(int k=0;k<4;k++){path(p,sizeof p,root,am_path(k));put(p,am_header(k),strlen(am_header(k)));}
 path(p,sizeof p,root,".gitignore");put(p,"unisacc.com\n",12);path(p,sizeof p,root,"plain.txt");put(p,"base\n",5);commit(root);
 { char *pv[]={"git","-C",root,"push","-u","origin","main",0};ok(pv,0); }
 if(pp_copy_product(productroot,root))die("product-copy");
 char *co[]={"git","clone",bare,other,0};ok(co,0);
 path(p,sizeof p,other,"plain.txt");put(p,"landed\n",7);commit(other);
 { char *dv[]={"git","-C",other,"diff","--full-index","HEAD^","HEAD",0};np_result r=run(dv,0,12);if(r.rc)die("land-diff");put(patch,r.out,r.outn);np_free(&r); }
 put(msg,"land fixture\n",12);
 { char *ap[]={(char*)native,root,patch,dest,"--prepare-only",0};np_result r=run(ap,0,55);ck(!r.rc,"land-real-prep");np_free(&r); }
 path(p,sizeof p,dest,".git/integrate/ready.tsv");put(p,"INTEGRATE_READY1\nstatus\tREADY_TO_COMMIT\nscope\tmetadata-ratchets-precommit-only\npushed\t0\n",strlen("INTEGRATE_READY1\nstatus\tREADY_TO_COMMIT\nscope\tmetadata-ratchets-precommit-only\npushed\t0\n"));
 { char recp[4400];size_t rn;char *rs;path(recp,sizeof recp,dest,".git/integrate/receipt.tsv");rs=cx_read(recp,&rn);ck(rs!=0,"land-receipt-present");
   if(rs){const char *ps=strstr(rs,"\npatch\t"),*bs=strstr(rs,"\nbase\t");char rec[400];
    if(ps&&bs){ps+=7;bs+=6;const char *pe=strchr(ps,'\n'),*be=strchr(bs,'\n');
     if(pe&&be&&(pe-ps)==64&&(be-bs)==64){if(cx_fmt(rec,sizeof rec,"AFFECTED_GATE1\npatch\t%.*s\nbase\t%.*s\nstatus\tPASS\n",64,ps,64,bs))die("aff");path(p,sizeof p,dest,".git/integrate/affected.tsv");put(p,rec,strlen(rec));}}
    free(rs);}}
 { char bad[200];if(cx_fmt(bad,sizeof bad,"AFFECTED_GATE1\npatch\t%064d\nbase\t%064d\nstatus\tPASS\n",0,0))die("bad-aff");path(p,sizeof p,dest,".git/integrate/affected.tsv");put(p,bad,strlen(bad));
   char *ld[]={(char*)native,"--land",dest,"--message-file",msg,0};np_result r=run(ld,0,20);ck(r.rc==2&&r.err&&strstr(r.err,"land-affected-stale-reopen-gates"),"land-stale-affected");np_free(&r); }
 { char recp[4400];size_t rn;char *rs;path(recp,sizeof recp,dest,".git/integrate/receipt.tsv");rs=cx_read(recp,&rn);
   if(rs){const char *ps=strstr(rs,"\npatch\t"),*bs=strstr(rs,"\nbase\t");char rec[400];
    if(ps&&bs){ps+=7;bs+=6;const char *pe=strchr(ps,'\n'),*be=strchr(bs,'\n');
     if(pe&&be&&(pe-ps)==64&&(be-bs)==64){if(cx_fmt(rec,sizeof rec,"AFFECTED_GATE1\npatch\t%.*s\nbase\t%.*s\nstatus\tPASS\n",64,ps,64,bs))die("aff2");path(p,sizeof p,dest,".git/integrate/affected.tsv");put(p,rec,strlen(rec));}}
    free(rs);}}
 { char *ld[]={(char*)native,"--land",dest,"--message-file","/no/such/msg",0};np_result r=run(ld,0,15);ck(r.rc==2,"land-missing-message-file");np_free(&r); }
 /* the target is bare, so receive.denyCurrentBranch cannot refuse: a pre-receive hook gated on a flag file refuses the first push */
 char hook[4400],flag[4400];path(hook,sizeof hook,bare,"hooks/pre-receive");path(flag,sizeof flag,bare,"deny-push");
 { const char *h="#!/bin/sh\n[ -e \"$GIT_DIR/deny-push\" ] && exit 1\nexit 0\n";put(hook,h,strlen(h));char *cm[]={"chmod","755",hook,0};ok(cm,0);put(flag,"1\n",2); }
 { char *ld[]={"env","INTEGRATE_LAND_TEST=1",(char*)native,"--land",dest,"--message-file",msg,0};np_result r=run(ld,0,40);ck(r.rc==2&&r.err&&strstr(r.err,"land-push-failed-rolled-back"),"land-push-deny-rollback");np_free(&r); }
 { char *rm[]={"rm","-f",flag,0};ok(rm,0); }
 { char *ld[]={"env","INTEGRATE_LAND_TEST=1",(char*)native,"--land",dest,"--message-file",msg,0};np_result r=run(ld,0,40);ck(!r.rc&&r.out&&strstr(r.out,"status=LANDED"),"land-skip-affected-run");np_free(&r); }
 { char *lv[]={"git","--git-dir",bare,"log","-1","--format=%s",0};np_result r=run(lv,0,8);ck(!r.rc&&r.out&&strstr(r.out,"land fixture"),"land-real-log");np_free(&r); }
 { char *sv[]={"git","ls-remote",bare,"refs/heads/main",0};np_result r=run(sv,0,8);ck(!r.rc&&r.outn>40,"land-real-ls-remote");np_free(&r); }
}
static void aff_resume(const char *top,const char *native,const char *productroot){
 char bare[4400],root[4400],other[4400],dest[4400],patch[4400],log[4400],lenv[4500],p[4400];
 if(cx_fmt(bare,sizeof bare,"%s/af.git",top)||cx_fmt(root,sizeof root,"%s/af-root",top)||cx_fmt(other,sizeof other,"%s/af-other",top)||cx_fmt(dest,sizeof dest,"%s/af-dest",top)||cx_fmt(patch,sizeof patch,"%s/af.patch",top)||cx_fmt(log,sizeof log,"%s/af.log",top)||cx_fmt(lenv,sizeof lenv,"INTEGRATE_FAKE_AFF_LOG=%s",log))die("af-path");
 char *bi[]={"git","init","--bare","-b","main",bare,0};ok(bi,0);
 char *cl[]={"git","clone",bare,root,0};ok(cl,0);
 path(p,sizeof p,root,"agentwork");if(sy_mkdir(p,0700))die("mkdir");path(p,sizeof p,root,"tests");if(sy_mkdir(p,0700))die("mkdir");
 for(int k=0;k<4;k++){path(p,sizeof p,root,am_path(k));put(p,am_header(k),strlen(am_header(k)));}
 path(p,sizeof p,root,".gitignore");put(p,"unisacc.com\n",12);path(p,sizeof p,root,"plain.txt");put(p,"base\n",5);commit(root);
 { char *pv[]={"git","-C",root,"push","-u","origin","main",0};ok(pv,0); }
 if(pp_copy_product(productroot,root))die("product-copy");
 char *co[]={"git","clone",bare,other,0};ok(co,0);
 path(p,sizeof p,other,"plain.txt");put(p,"affx\n",5);commit(other);
 { char *dv[]={"git","-C",other,"diff","--full-index","HEAD^","HEAD",0};np_result r=run(dv,0,12);if(r.rc)die("af-diff");put(patch,r.out,r.outn);np_free(&r); }
 { char *ap[]={(char*)native,root,patch,dest,"--prepare-only",0};np_result r=run(ap,0,55);ck(!r.rc,"affected-resume-prep");np_free(&r); }
 { char *a1[]={"env","INTEGRATE_FAKE_AFF_IDS=a1,b2,c3","INTEGRATE_FAKE_AFF_MAX=2",lenv,(char*)native,"--test-affected",dest,0};np_result r=run(a1,0,20);ck(r.rc==3,"affected-first-run-pending-after-two");np_free(&r); }
 { char *a2[]={"env","INTEGRATE_FAKE_AFF_IDS=a1,b2,c3","INTEGRATE_FAKE_AFF_MAX=2",lenv,(char*)native,"--test-affected",dest,0};np_result r=run(a2,0,20);size_t ln;char *lg=cx_read(log,&ln);
   ck(!r.rc&&r.out&&strstr(r.out,"SKIP\tid=a1")&&strstr(r.out,"SKIP\tid=b2")&&lg&&ln==9&&!memcmp(lg,"a1\nb2\nc3\n",9),"affected-resume-skips-passed-batches");free(lg);np_free(&r); }
 { char rp[4400];size_t rn;path(rp,sizeof rp,dest,".git/integrate/receipt.tsv");char *rs=cx_read(rp,&rn);char *t=rs?strstr(rs,"\ntree\t"):0;
   if(t){t+=6;while(*t&&*t!='\n')*t++='0';put(rp,rs,rn);}ck(t!=0,"affected-identity-tampered");free(rs); }
 { char *a3[]={"env","INTEGRATE_FAKE_AFF_IDS=a1,b2,c3","INTEGRATE_FAKE_AFF_MAX=2",lenv,(char*)native,"--test-affected",dest,0};np_result r=run(a3,0,20);size_t ln;char *lg=cx_read(log,&ln);
   ck(r.rc==3&&r.out&&!strstr(r.out,"SKIP")&&lg&&ln==15&&!memcmp(lg,"a1\nb2\nc3\na1\nb2\n",15),"affected-identity-change-invalidates-record");free(lg);np_free(&r); }
}
static int mark_count(const char *mp,int base){size_t n;char *s=cx_read(mp,&n);int c=0;if(!s)return 0;for(size_t at=0;at<n;){const char *e=memchr(s+at,'\n',n-at);size_t z=e?(size_t)(e-s-at):n-at;if(z){int b=0;for(size_t i=0;i+13<=z;i++)if(!memcmp(s+at+i,"main-snapshot",13))b=1;if(b==base)c++;}at+=z+1;}free(s);return c;}
/* 行为负例:假棘轮工具每次真实运行向标记文件追加其cwd;基线侧(cwd含main-snapshot)与head侧分别计数。 */
static const char *rc_outdir;   /* 批次 {out}:基线棘轮缓存目录放这里之下 */
/* 六个 rc 模式共用一份 native integrate-patch:按内容身份(产品字节 + tools/cx/ext/cxroot.tsv 的索引 blob 与工作区差异)
   缓存在 TMPDIR,命中时再核二进制 sha;只是构造产物复用(PREPARED),不缓存任何检查结论。 */
static int rc_native(char *root,char *native,size_t cap){
 char product[4400],source[4400],dir[4400],key[65],bin[4600],shp[4600],tmp[4700],bh[65];
 if(sy_realpath(".",root,4096)<0)die("root");path(product,sizeof product,root,"unisacc.com");path(source,sizeof source,root,"tools/integrate-patch.cx");
 { np_buf b={0};size_t n;char *s=cx_read(product,&n);if(!s)die("rc-native-product");np_puts(&b,root);np_put(&b,"\n",1);np_put(&b,s,n);free(s);   /* 键含本树绝对路径:只复用本树构建的 native */
   char *ls[]={"git","ls-files","-s","--","tools","cx","ext","cxroot.tsv",0};np_result r=run(ls,root,20);if(r.rc)die("rc-native-ls");np_put(&b,r.out,r.outn);np_free(&r);
   char *df[]={"git","diff","HEAD","--","tools","cx","ext","cxroot.tsv",0};r=run(df,root,20);if(r.rc)die("rc-native-diff");np_put(&b,r.out,r.outn);np_free(&r);
   cx_sha256_hex(b.p,b.n,key);free(b.p); }
 if(cx_fmt(dir,sizeof dir,"%s/integrate-patch-native-cache",sy_tmpdir())||cx_fmt(bin,sizeof bin,"%s/%s.bin",dir,key)||cx_fmt(shp,sizeof shp,"%s/%s.sha",dir,key)||cx_fmt(native,cap,"%s",bin))die("rc-native-path");
 if(sy_exists(bin)==1&&sy_exists(shp)==1){size_t n,m;char *s=cx_read(bin,&n),*h=cx_read(shp,&m);int okb=0;if(s&&h&&m>=64){cx_sha256_hex(s,n,bh);okb=!memcmp(bh,h,64);}free(s);free(h);
   if(okb){printf("RC_NATIVE\tPREPARED\treused\tkey=%.16s\n",key);return 1;}}
 sy_mkdir(dir,0700);
 if(cx_fmt(tmp,sizeof tmp,"%s.tmp%d",bin,(int)getpid()))die("rc-native-path");
 { char *build[]={"sh",product,source,"-o",tmp,0};np_result r=run(build,root,55);if(r.rc){if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);die("native-build");}np_free(&r); }
 { size_t n;char *s=cx_read(tmp,&n);if(!s)die("rc-native-read");cx_sha256_hex(s,n,bh);free(s);char st[4800];if(cx_fmt(st,sizeof st,"%s.sha",tmp))die("rc-native-path");put(st,bh,64);
   if(sy_rename(tmp,bin)||sy_rename(st,shp))die("rc-native-store"); }
 printf("RC_NATIVE\tPREPARED\tbuilt\tkey=%.16s\n",key);return 1;}
static void rc_go(const char *top,const char *native,const char *root,const char *patch,const char *mark,const char *name,int want_base,int want_head,int want_hit){
 char dest[4400],menv[4600],cenv[4600],lbl[200];static int seq;if(cx_fmt(dest,sizeof dest,"%s/rc-dest-%d",top,++seq)||cx_fmt(menv,sizeof menv,"S4_MARK=%s",mark)||cx_fmt(cenv,sizeof cenv,"INTEGRATE_RATCHET_CACHE_DIR=%s/ratchet-cache",rc_outdir))die("rc-path");
 int b0=mark_count(mark,1),h0=mark_count(mark,0);
 { char *ap[]={(char*)native,(char*)root,(char*)patch,dest,"--prepare-only",0};np_result r=run(ap,0,30);int rc=r.rc;np_free(&r);if(rc)die("rc-prepare"); }
 { char *rs[]={"env",menv,cenv,(char*)native,"--resume",dest,0};np_result r=run(rs,0,50);int hit=r.out&&strstr(r.out,"ratchets-base=CACHE_HIT")!=0;
   int db=mark_count(mark,1)-b0,dh=mark_count(mark,0)-h0;
   if(cx_fmt(lbl,sizeof lbl,"ratchet-cache %s: base runs %d head runs %d hit %d",name,db,dh,hit))die("lbl");
   ck(db==want_base&&dh==want_head&&hit==want_hit,lbl);
   if(!(db==want_base&&dh==want_head&&hit==want_hit)){fprintf(stderr,"rc-resume rc=%d\n",r.rc);if(r.errn)fwrite(r.err,1,r.errn>2000?2000:r.errn,stderr);if(r.outn)fwrite(r.out,1,r.outn>2000?2000:r.outn,stderr);}
   np_free(&r); }
}
/* 改产品摘要:翻转根产品中非本机平台(Darwinarm64)启动行的一个字符,页脚/布局保持有效 */
static char *rc_find(char *s,size_t n,const char *pat,size_t pn){for(size_t i=0;i+pn<=n;i++)if(!memcmp(s+i,pat,pn))return s+i;return 0;}
static void rc_flip(const char *root){char p[4400];size_t n;path(p,sizeof p,root,"unisacc.com");char *s=cx_read(p,&n);if(!s)die("rc-flip-read");char *q=rc_find(s,n,"Darwinarm64) o=",15);char *k=q?rc_find(q,(size_t)(s+n-q)," k=",3):0;if(!k)die("rc-flip-anchor");k[3]=k[3]=='0'?'1':'0';put(p,s,n);free(s);}
static void rc_sh(const char *script,const char *a){char *v[]={"sh","-c",(char*)script,"rc",(char*)a,0};np_result r=run(v,0,10);int rc=r.rc;np_free(&r);if(rc)die("rc-sh");}
static void ratchet_cache(const char *top,const char *native,const char *productroot,int which){
 char seed[4400],root[4400],other[4400],patch[4400],mark[4400],cdir[4400],p[4400];
 if(cx_fmt(seed,sizeof seed,"%s/rc-seed",top)||cx_fmt(root,sizeof root,"%s/rc-root",top)||cx_fmt(other,sizeof other,"%s/rc-other",top)||cx_fmt(patch,sizeof patch,"%s/rc.patch",top)||cx_fmt(mark,sizeof mark,"%s/rc.marks",top)||cx_fmt(cdir,sizeof cdir,"%s/ratchet-cache",rc_outdir))die("rc-path");
 char *init[]={"git","init","-b","main",seed,0};ok(init,0);
 path(p,sizeof p,seed,"agentwork");if(sy_mkdir(p,0700))die("mkdir");path(p,sizeof p,seed,"tests");if(sy_mkdir(p,0700))die("mkdir");path(p,sizeof p,seed,"tools");if(sy_mkdir(p,0700))die("mkdir");
 for(int k=0;k<4;k++){path(p,sizeof p,seed,am_path(k));put(p,am_header(k),strlen(am_header(k)));}
 path(p,sizeof p,seed,".gitignore");put(p,"unisacc.com\n",12);path(p,sizeof p,seed,"plain.txt");put(p,"base\n",5);
 path(p,sizeof p,seed,"tests/run.cx");{const char *m="int main(void){puts(\"metadata_valid=1\");return 0;}\n";put(p,m,strlen(m));}
 path(p,sizeof p,seed,"tests/ratchet-input.txt");put(p,"in0\n",4);
 path(p,sizeof p,seed,"tools/ratchets.cx");{const char *m="int main(void){const char*mk=getenv(\"S4_MARK\");char cwd[4096],in[100]=\"\";if(!mk||!getcwd(cwd,sizeof cwd))return 2;FILE*f=fopen(mk,\"a\");if(!f)return 2;fprintf(f,\"%s\\n\",cwd);fclose(f);f=fopen(\"tests/ratchet-input.txt\",\"r\");if(f){if(fgets(in,sizeof in,f)){}fclose(f);}for(int i=0;in[i];i++)if(in[i]=='\\n')in[i]=0;printf(\"RATCHET\\tfake\\tok\\t%s\\n\",in);puts(\"RATCHETS\\tok=1\\tfail=0\\telapsed_ms=1\");return 0;}\n";put(p,m,strlen(m));}
 commit(seed);
 char *cr[]={"git","clone","--local","--no-hardlinks","--branch","main",seed,root,0};ok(cr,0);char *cl[]={"git","clone","--local","--no-hardlinks","--branch","main",seed,other,0};ok(cl,0);if(pp_copy_product(productroot,root))die("product-copy");
 /* 夹具根只含 git 跟踪内容 + 单独拷入的产品:删去 pp_copy_product 带入的 build.json 旁记,否则 integrate-patch 判未跟踪输入 */
 path(p,sizeof p,root,"unisacc.com.build.json");if(sy_exists(p)==1&&sy_unlink(p))die("rc-sidecar");
 path(p,sizeof p,other,"plain.txt");put(p,"patched\n",8);commit(other);
 { char *dv[]={"git","-C",other,"diff","--full-index","HEAD^","HEAD",0};np_result r=run(dv,0,12);if(r.rc)die("rc-diff");put(patch,r.out,r.outn);np_free(&r); }
 put(mark,"",0);
 rc_go(top,native,root,patch,mark,"cold miss runs base and head once each",1,1,0);
 if(which==1)rc_go(top,native,root,patch,mark,"same key hit runs head only once",0,1,1);
 else if(which==2){rc_sh("for f in \"$1\"/*; do printf 'garbage\\n' > \"$f\"; done",cdir);
  rc_go(top,native,root,patch,mark,"corrupted entry reruns base",1,1,0);}
 else if(which==3){rc_flip(root);rc_go(top,native,root,patch,mark,"changed product digest reruns base",1,1,0);}
 else if(which==4){path(p,sizeof p,root,"tests/ratchet-input.txt");put(p,"in1\n",4);commit(root);rc_go(top,native,root,patch,mark,"ratchet input one byte changed reruns base",1,1,0);}
 else if(which==5){path(p,sizeof p,root,"tools/ratchets.cx");{size_t n;char *s=cx_read(p,&n);np_buf b={0};np_put(&b,s,n);np_puts(&b,"/* tool source edit */\n");put(p,b.p,b.n);free(b.p);free(s);}commit(root);rc_go(top,native,root,patch,mark,"ratchet tool source changed reruns base",1,1,0);}
}
static void registry_neg(const char *top,const char *native){
 char dir[4400],okp[4400],pat[4400],mis[4400];
 if(cx_fmt(dir,sizeof dir,"%s/reg",top)||cx_fmt(okp,sizeof okp,"%s/tools/ok.cx",dir)||cx_fmt(pat,sizeof pat,"%s/ok.patch",dir)||cx_fmt(mis,sizeof mis,"%s/miss.patch",dir))die("reg-path");
 { char *mk[]={"mkdir","-p",dir,0};np_result r=run(mk,0,5);np_free(&r); }
 { char tools[4400];path(tools,sizeof tools,dir,"tools");if(sy_mkdir(tools,0700)&&sy_exists(tools)!=1)die("reg-tools"); }
 put(okp,"int main(void){return 0;}\n",24);
 { const char *okd="diff --git a/tests/batches.tsv b/tests/batches.tsv\nindex 1111111111111111111111111111111111111111..2222222222222222222222222222222222222222 100644\n--- a/tests/batches.tsv\n+++ b/tests/batches.tsv\n@@ -1,1 +1,2 @@\n id\timplementation\n+landx\tIMPLEMENTED\tinterfaces\ttools/ok.cx\tSOURCE\tlnx/x86_64\t55\t-\ttools/ok.cx\t--land-only\tcov\trc0:A\tproduct\tdaily\ndiff --git a/tools/ok.cx b/tools/ok.cx\nindex 1111111111111111111111111111111111111111..2222222222222222222222222222222222222222 100644\n--- a/tools/ok.cx\n+++ b/tools/ok.cx\n@@ -1 +1 @@\n-int main(void){return 1;}\n+int main(void){return 0;}\n";put(pat,okd,strlen(okd)); }
 { char *v[]={(char*)native,"--check-registry",pat,0};np_result r=run(v,dir,8);ck(!r.rc&&r.out&&strstr(r.out,"REGISTRY_OK"),"registry-modified-check-with-args-ok");np_free(&r); }
 { const char *bad="diff --git a/tests/batches.tsv b/tests/batches.tsv\nindex 1111111111111111111111111111111111111111..2222222222222222222222222222222222222222 100644\n--- a/tests/batches.tsv\n+++ b/tests/batches.tsv\n@@ -1,1 +1,2 @@\n id\timplementation\n+landy\tIMPLEMENTED\tinterfaces\ttools/missing-check.cx\tSOURCE\tlnx/x86_64\t55\t-\ttools/missing-check.cx\t--land-only\tcov\trc0:A\tproduct\tdaily\n";put(mis,bad,strlen(bad)); }
 { char *v[]={(char*)native,"--check-registry",mis,0};np_result r=run(v,dir,8);ck(r.rc==2&&r.err&&strstr(r.err,"registry-check-missing"),"registry-missing-check-refused");np_free(&r); }
}

int main(int argc,char **argv){
 deadline=sy_now_ms()+55000;
 int aff_only=argc==2&&!strcmp(argv[1],"--affected-only");
 int rc_which=0;{static const char *fl[]={"--rc-cold","--rc-hit","--rc-corrupt","--rc-product","--rc-input","--rc-tool","--rc-prepare"};for(int i=0;i<7;i++)if(argc==3&&!strcmp(argv[2],fl[i]))rc_which=i+1;}int rc_only=rc_which>0;
 static char rc_outabs[4096];
 if(rc_only){sy_mkdir(argv[1],0700);if(sy_realpath(argv[1],rc_outabs,sizeof rc_outabs)<0)die("rc-outdir");rc_outdir=rc_outabs;argc=2;}   /* {out} 可能是相对路径:子进程 cwd 不同,须先取绝对路径 */   /* 批次形态 {out};--rc-X */
 int land_only=(argc==2&&!strcmp(argv[1],"--land-only"))||aff_only||rc_only;
 if(!land_only&&argc!=1&&(argc!=4||strcmp(argv[1],"--native")))die("usage [--native ABS_INTEGRATE ROOT] | --land-only");
 char native[4096],root[4096],temp[4400];
 if(cx_fmt(temp,sizeof temp,"%s/integrate-patch-check-XXXXXX",sy_tmpdir())||!mkdtemp(temp))die("arguments");
 if(rc_only&&rc_native(root,native,sizeof native)){}
 else if(argc==1||land_only){char product[4400],source[4400];if(sy_realpath(".",root,sizeof root)<0)die("root");path(product,sizeof product,root,"unisacc.com");path(source,sizeof source,root,"tools/integrate-patch.cx");path(native,sizeof native,temp,"integrate-patch");char *build[]={"sh",product,source,"-o",native,0};np_result r=run(build,root,55);if(r.rc){if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);die("native-build");}np_free(&r);}
 else if(sy_realpath(argv[2],native,sizeof native)<0||sy_realpath(argv[3],root,sizeof root)<0)die("arguments");
 if(land_only){if(rc_which==7)ck(sy_exists(native)==1,"rc native prepared (PREPARED only, no verdict)");else if(rc_only)ratchet_cache(temp,native,root,rc_which-1);else if(aff_only)aff_resume(temp,native,root);else land_real(temp,native,root);printf("INTEGRATE_PATCH_MATERIALS\t%s\n",temp);printf("INTEGRATE_PATCH_CHECK\tchecks=%d\tfailed=%d\n",checks,failed);return failed?1:0;}
 fixture(temp,native,root,0);fixture(temp,native,root,1);entry_neg(temp,native,root);freeze_and_compile_neg(temp,native,root);registry_neg(temp,native);
 /* 基线棘轮缓存合同:键含基线树id与产品摘要,命中须过ratchet_valid,head侧永远现跑,可用环境变量关闭回完整双扫 */
 {char sp[4400];path(sp,sizeof sp,root,"tools/integrate-patch.cx");size_t sn;char *ss=cx_read(sp,&sn);
  ck(ss&&strstr(ss,"integrate-ratchet-cache/%s-%s.base.stdout\",bt,product")!=0,"ratchet cache key = baseline tree + product digest");
  ck(ss&&strstr(ss,"if(ratchet_valid(cs,cn)){char bp[5000]")!=0,"ratchet cache hit must pass ratchet_valid");
  ck(ss&&strstr(ss,"INTEGRATE_NO_RATCHET_CACHE")!=0&&strstr(ss,"headonly")!=0,"full pair path kept behind INTEGRATE_NO_RATCHET_CACHE; head always scanned");
  free(ss);}
 printf("INTEGRATE_PATCH_MATERIALS\t%s\n",temp);printf("INTEGRATE_PATCH_CHECK\tchecks=%d\tfailed=%d\n",checks,failed);return failed?1:0;}
