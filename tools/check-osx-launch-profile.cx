/* Independent fixtures; never grant a product launch-performance result. */
#pragma unisa use sysx.process
#pragma unisa use sys.time
#pragma unisa use sys.hostid
#pragma unisa use mem.bytes
static int checks,failed;static long deadline;static char root[4400],temp[4400],exe[4400];
static void die(const char*s){fprintf(stderr,"check-osx-launch-profile: %s\n",s);exit(2);}
static void path(char*p,size_t cap,const char*a,const char*b){if(cx_fmt(p,cap,"%s/%s",a,b))die("path");}
static void put(const char*p,const char*s){if(cx_write(p,s,strlen(s)))die("write fixture");}
static void ck(int yes,const char*s){checks++;failed+=!yes;printf("%s\t%s\n",yes?"PASS":"FAIL",s);}
static np_result call(char**v,int cap){if(deadline-sy_now_ms()<(cap+1)*1000)die("overall fixture deadline");np_result r={0};char why[1000]={0};if(np_run(v,root,0,cap,&r,why,sizeof why)||r.residue)die(why);return r;}
static void expect(char**v,int rc,const char*needle,const char*label,int cap){np_result r=call(v,cap);int ok=r.rc==rc&&(!needle||(r.out&&strstr(r.out,needle))||(r.err&&strstr(r.err,needle)));ck(ok,label);if(!ok)fprintf(stderr,"actual rc=%d\n%s%s",r.rc,r.out?r.out:"",r.err?r.err:"");np_free(&r);}
int main(int argc,char**argv){if(argc>2)return 2;if(!realpath(argc==2?argv[1]:".",root))die("ROOT");deadline=sy_now_ms()+52000;char pattern[]="/tmp/check-launch-profile-XXXXXX";if(!mkdtemp(pattern)||!realpath(pattern,temp))die("fresh temp");char product[4400],source[4400],fake_src[4400],fake[4400],wrapper[4400],text[9000];path(product,sizeof product,root,"unisacc.com");path(source,sizeof source,root,"tools/osx-launch-profile.cx");path(exe,sizeof exe,temp,"profile");char*build[]={"sh",product,source,"-o",exe,0};np_result r=call(build,25);ck(!r.rc,"compile current launch profiler");if(r.errn)fwrite(r.err,1,r.errn,stderr);if(r.rc)die("compile failed");np_free(&r);char*missing[]={exe,0};expect(missing,2,"usage","missing arguments rejected",3);char*sample[]={exe,"--samples","version","90","1","50","2","50","99","3","4","50","50",0};expect(sample,0,"median_x2_ms=100","unsorted even median includes both middle values",3);sample[3]="91";sample[4]="51";sample[5]="51";sample[6]="51";sample[7]="51";sample[8]="51";sample[9]="51";sample[10]="51";sample[11]="51";sample[12]="51";expect(sample,1,"median_x2_ms=102","version median over 50ms rejected",3);sample[2]="run";for(int i=3;i<13;i++)sample[i]="300";expect(sample,0,"median_x2_ms=600","run 300ms boundary accepted",3);sample[3]="302";sample[4]="302";sample[5]="302";sample[6]="302";sample[7]="302";sample[8]="302";expect(sample,1,"median_x2_ms=604","run median over 300ms rejected",3);sample[3]="-1";expect(sample,2,0,"negative sample rejected",3);sample[3]="4junk";expect(sample,2,0,"non-numeric sample rejected",3);
if(strncmp(tn_self(),"osx/",4)){printf("OSX_LAUNCH_PROFILE_CHECK\tchecks=%d\tfailed=%d\tprocess_controls=NOT_RUN_FOREIGN_HOST\n",checks,failed);return failed?1:0;}
path(fake_src,sizeof fake_src,temp,"fake.c");put(fake_src,"int main(int n,char**v){if(n<3)return 12;if(!strcmp(v[1],\"timeout\")){for(;;){} }if(!strcmp(v[1],\"bad\"))return 9;if(!strcmp(v[1],\"badtext\")){puts(\"wrong product\");return 0;}if(!strcmp(v[2],\"--version\")){puts(\"unisacc fixture\");return 0;}if(!strcmp(v[1],\"badrun\"))return 9;return 7;}\n");path(fake,sizeof fake,temp,"fake");char*fb[]={"sh",product,fake_src,"-o",fake,0};r=call(fb,10);ck(!r.rc,"compile independent process-control fixture");if(r.errn)fwrite(r.err,1,r.errn,stderr);if(r.rc)die("fake compile");np_free(&r);path(wrapper,sizeof wrapper,temp,"ape-wrapper");char*launch[]={exe,wrapper,"arm64",0};const char*modes[]={"bad","badtext","timeout","badrun","ok"};const char*needles[]={"rc=9","valid=0","transport=-1","mode=run rc=9","version_n=10\trun_n=10"};const char*labels[]={"wrong version exit refused","unrelated version text refused","5-second child timeout refused","wrong r7 exit refused","actual twenty measurements retain r7 exit 7"};for(int i=0;i<5;i++){if(cx_fmt(text,sizeof text,"#!/bin/sh\nexec '%s' '%s' \"$@\"\n",fake,modes[i]))die("thin fixture wrapper");put(wrapper,text);expect(launch,i==4?0:1,needles[i],labels[i],i==2?8:6);}launch[2]="foreign";expect(launch,2,"unknown architecture","foreign architecture refused",3);printf("OSX_LAUNCH_PROFILE_CHECK\tchecks=%d\tfailed=%d\tscope=independent-fixtures-only\tretained=%s\n",checks,failed,temp);return failed?1:0;}
