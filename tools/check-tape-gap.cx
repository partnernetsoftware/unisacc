/* Checks tools/tape-gap.cx: sh ./unisacc.com tools/check-tape-gap.cx   (from the repo root)
   On tools/tape-gap/cases.tape (write twice, .sys6 syscall, poll, an op with no row, one __ccw_ label):
   win/x86_64 reports syscall and poll as selected-0, nosuchop as no-row, the stub, and exits 1;
   lnx/x86_64 reports only nosuchop and the stub; write (covered on both) is never a gap, and its two
   uses count once as an op.  Prints PASS/FAIL lines and CHECK_TAPE_GAP<TAB>failed=N. */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use sys.time
#pragma unisa use sysx.poll
#pragma unisa use sys.posix
#pragma unisa use sys.env

/* an unlinked spool file the drained output of a bounded child goes to */
static int spool_open(void) {
    char t[4096];
    int fd;
    if (cx_fmt(t, sizeof t, "%s/r2b-XXXXXX", sy_tmpdir())) return -1;
    fd = mkstemp(t);
    if (fd >= 0) sy_unlink(t);
    return fd;
}

/* sy_spawn_pipe with a 50 s deadline: the child's stdout (and stderr when EFD is given) is drained here with sy_poll
   into spool files; past the deadline its process group is killed.  OFD/EFD come back as the spool files, rewound,
   and the child is NOT reaped: the caller's sy_wait_status(pid) still reports its real status (128+9 when killed). */
static int spawn_pipe_bounded(char **argv, const char *cwd, int flags, int *ofd, int *efd) {
    int po = -1, pe = -1, pid, fo, fe = -1, open_o = 1, open_e = efd ? 1 : 0, killed = 0;
    long deadline = sy_now_ms() + 50000;
    char chunk[16384];
    pid = sy_spawn_pipe(argv, cwd, flags, &po, efd ? &pe : 0);
    if (pid < 0) return pid;
    fo = spool_open();
    if (efd) fe = spool_open();
    if (fo < 0 || (efd && fe < 0)) { sy_killpg(pid, 9); sy_signal(pid, 9); sy_close(po); if (efd) sy_close(pe); return -EIO; }
    while (open_o || open_e) {
        sy_pollfd_t p[2];
        int n = 0, io = -1, ie = -1, r;
        long left = deadline - sy_now_ms(), g;
        if (left <= 0) {
            if (killed) break;
            sy_killpg(pid, 9); sy_signal(pid, 9); killed = 1; deadline = sy_now_ms() + 2000;
            continue;
        }
        if (open_o) { io = n; p[n].fd = po; p[n].events = SY_POLLIN; p[n].revents = 0; n++; }
        if (open_e) { ie = n; p[n].fd = pe; p[n].events = SY_POLLIN; p[n].revents = 0; n++; }
        r = sy_poll(p, n, left > 200 ? 200 : left);
        if (r < 0) break;
        if (io >= 0 && p[io].revents) {
            g = sy_read(po, chunk, sizeof chunk);
            if (g > 0) { if (sy_write_all(fo, chunk, g)) break; } else open_o = 0;
        }
        if (ie >= 0 && p[ie].revents) {
            g = sy_read(pe, chunk, sizeof chunk);
            if (g > 0) { if (sy_write_all(fe, chunk, g)) break; } else open_e = 0;
        }
    }
    if (open_o || open_e) { sy_killpg(pid, 9); sy_signal(pid, 9); }
    sy_close(po);
    if (efd) sy_close(pe);
    sy_lseek(fo, 0, 0);
    *ofd = fo;
    if (efd) { sy_lseek(fe, 0, 0); *efd = fe; }
    return pid;
}

static int failed;
static void ck(int ok, const char *name) { if (!ok) failed++; printf("%s\ttape-gap.%s\n", ok ? "PASS" : "FAIL", name); }

/* runs sh ./unisacc.com tools/tape-gap.cx -- tools/tape-gap/cases.tape TARGET; stdout into out; the exit code or -1 */
static int gap(const char *target, char *out, long cap) {
    char *argv[] = {"sh", "./unisacc.com", "tools/tape-gap.cx", "--", "tools/tape-gap/cases.tape", (char *)target, 0};
    int ofd, efd, pid, ex = 0, code = 0, sig = 0; long n = 0, r; char junk[4096];
    pid = spawn_pipe_bounded(argv, 0, SY_SPAWN_STDERR_SPLIT, &ofd, &efd);
    if (pid < 0) return -1;
    while ((r = sy_read(ofd, out + n, cap - 1 - n)) > 0) n += r;
    out[n] = 0;
    while (sy_read(ofd, junk, sizeof junk) > 0) {}
    while (sy_read(efd, junk, sizeof junk) > 0) {}
    sy_close(ofd); sy_close(efd);
    if (sy_wait_status(pid, 0, &ex, &code, &sig) != pid || !ex) return -1;
    return code;
}
static int has(const char *out, const char *s) { return tx_find(out, tx_len(out, 1 << 16), s, tx_len(s, 256)) >= 0; }

int main(void) {
    static char w[1 << 16], l[1 << 16];
    int rw = gap("win/x86_64", w, sizeof w), rl = gap("lnx/x86_64", l, sizeof l);
    ck(rw == 1 && has(w, "GAP\tsyscall\tuses=1\tfirst_line=3\tselected-0\n") && has(w, "GAP\tpoll\tuses=1\tfirst_line=4\tselected-0\n"), "win-syscall-poll-selected-0");
    ck(has(w, "GAP\tnosuchop\tuses=1\tfirst_line=5\tno-row\n") && has(l, "GAP\tnosuchop\tuses=1\tfirst_line=5\tno-row\n"), "unknown-op-no-row");
    ck(has(w, "CCW\t__ccw_0\tline=7\n") && has(l, "CCW\t__ccw_0\tline=7\n"), "ccw-stub-reported");
    ck(!has(w, "GAP\twrite") && !has(l, "GAP\twrite") && !has(l, "GAP\tsyscall") && !has(l, "GAP\tpoll"), "covered-ops-not-gaps");
    ck(has(w, "TAPE_GAP\ttarget=win/x86_64\tsys_ops=5\tgaps=3\tccw=1\n") && rl == 1 && has(l, "TAPE_GAP\ttarget=lnx/x86_64\tsys_ops=5\tgaps=1\tccw=1\n"), "summary-and-exit");
    printf("CHECK_TAPE_GAP\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
