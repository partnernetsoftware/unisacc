    mg_root = root;
    for (i = 1; i < argc; i++) {
        if (!strcmp(argv[i], "--cwd") && i + 1 < argc) d = argv[++i];
        else { fprintf(stderr, "devsvc: git pull [--cwd WORKTREE]: unexpected %s\n", argv[i]); git_argerr = 1; return 2; }
    }
    if (d != root && d[0] != '/') { F(top, sizeof top, "%s/%s", root, d); d = top; }
    if (!realpath(d, rd)) { fprintf(stderr, "devsvc: REFUSE git pull --cwd %s: no such directory\n", d); return 2; }
    {   char *bv[] = {"git", "-C", rd, "symbolic-ref", "--short", "-q", "HEAD", 0};
        if (runcap(bv, cur, sizeof cur) != 0) { fprintf(stderr, "devsvc: REFUSE git pull: %s is not on a branch\n", rd); return 2; }
        chomp(cur); }
    {   np_result r; char w[200]; char *v[] = {"git", "-C", rd, "fetch", "-q", "origin", 0}; int frc;
        if (np_run(v, 0, 0, 50, &r, w, sizeof w)) { printf("GIT_PULL\trc=1\treason=fetch-start\t%s\n", w); return 1; }
        frc = r.rc; np_free(&r);
        if (frc != 0) { printf("GIT_PULL\trc=1\treason=fetch-failed\tfetch_rc=%d\n", frc); return 1; } }
    F(spec, sizeof spec, "refs/remotes/origin/%s", cur);
    if (ovf || mg_rev(rd, spec, up, sizeof up)) { printf("GIT_PULL\trc=1\treason=no-upstream\t%s\n", spec); return 1; }
    for (att = 0; att < 4; att++) {
        if (mg_rev(rd, "HEAD", old, sizeof old)) { printf("GIT_PULL\trc=1\treason=no-head\n"); return 1; }
        if (mg_anc(rd, up, old)) { printf("GIT_PULL\trc=0\tcommit=%s\tbranch=%s\tcwd=%s\tup_to_date=1\n", old, cur, rd); return 0; }
        if (!mg_anc(rd, old, up)) {
            printf("PULL_HINT\tdiverged\t本地 %s 有未推送提交且与 origin/%s 分叉;不自动 merge/rebase:先 devsvc git merge origin/%s 再推送\n", cur, cur, cur);
            printf("GIT_PULL\trc=1\treason=diverged\tbranch=%s\tcwd=%s\n", cur, rd); return 1;
        }
