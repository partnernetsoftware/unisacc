            }
            {   char *v[] = {"git", "-C", rd, "commit-tree", tree, "-p", old, "-p", theirs, "-m", (char *)msg, 0};
                if (runcap(v, nw, sizeof nw) != 0) { mg_teardown(); printf("MERGE_HINT\tcommit-tree-failed\t-\nGIT_MERGE\trc=1\tconflicts=0\tbranch=%s\tcwd=%s\n", cur, rd); return 1; }
                chomp(nw); }
        }
        if (mg_lock(root)) { mg_teardown(); return 1; }
        if (att == 0) {   /* 受控注入点,只供 tools/check-devsvc-git.cx 夹具:落地前把 HEAD 从 old 移到给定提交一次,验证比较并交换失败后的重放;正常运行不设此变量 */
            const char *mvh = getenv("DEVSVC_TEST_MERGE_MOVE_HEAD");
            if (mvh && *mvh) { char *v2[] = {"git", "-C", rd, "update-ref", "HEAD", (char *)mvh, old, 0}; (void)runcap(v2, buf, sizeof buf); } }
        {   char *v[] = {"git", "-C", rd, "update-ref", "-m", "devsvc git merge", "HEAD", nw, old, 0};
            if (runcap(v, buf, sizeof buf) == 0) break; }
        mg_unlock(root);
