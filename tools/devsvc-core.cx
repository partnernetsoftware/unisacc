        if (!strcmp(argv[i], "--cwd") || !strcmp(argv[i], "--owner")) { i++; continue; }
        if (!strcmp(argv[i], "-m") && i + 1 < argc) {
            if (n + 1 >= FL_MAX_ARGV - 8) { fprintf(stderr, "devsvc: git commit: too many arguments (nothing committed)\n"); git_argerr = 1; return 2; }
            v[n++] = argv[i++];
            v[n++] = msg_with_window_trailer(argv[i], has_ci_own ? ci_own : 0, msg_tr, sizeof msg_tr);
            continue;
        }
        if (!strcmp(argv[i], "--registered") || !strcmp(argv[i], "--new-tool") || !strcmp(argv[i], "--batch") || !strcmp(argv[i], "--merge-continue")) {
            if (!strcmp(argv[i], "--registered")) need = "registry";
            freeze_hit = 1; pmode = 0;
        } else if (!strcmp(argv[i], "--whole") || !strcmp(argv[i], "--staged")) {
            pmode = 1;
        } else if (!strcmp(argv[i], "--keyed")) {
            pmode = 2;
        } else if (argv[i][0] == '-') {
            /* Non-path switches (--derive, --dry-run, --bg, --derive-selected, etc.) do NOT reset pmode */
        } else {
            if ((lf = lock_for(argv[i]))) need = lf;
            if (pmode == 2) {
                if (freeze_in_domain(froot, argv[i])) freeze_hit = 1;
                pmode = 3;
            } else if (pmode == 3) {
                if (strchr(argv[i], '/') && freeze_in_domain(froot, argv[i])) freeze_hit = 1;
                pmode = 0;
            } else {
                /* Check every non-option positional argument forwarded to commit-own */
                if (freeze_in_domain(froot, argv[i])) freeze_hit = 1;
            }
        }
        if (n >= FL_MAX_ARGV - 8) { fprintf(stderr, "devsvc: git commit: too many arguments (nothing committed)\n"); git_argerr = 1; return 2; }
        v[n++] = argv[i];
    }
    if (freeze_hit) {
        char fh[64];
        const char *who = has_ci_own ? ci_own : auto_owner();
        if (freeze_check(froot, who, fh, sizeof fh)) {
            fprintf(stderr, "LOCK_HELD freeze owner=%s\n", fh);
            printf("GIT_COMMIT\trc=1\treason=lock-held\tlock=freeze\towner=%s\n", fh);
            return 1;
        }
    }
    /* devsvc 拥有索引,第一阶段:commit 不再取 git-index 锁。commit-own 每个请求用私有索引(HEAD 加本请求路径)建树,
     * 门在私有树的检出上求值(不读共享索引与共享工作树),只在最后对 HEAD 做一次比较并交换(git update-ref NEW OLD);
     * HEAD 被他人推进且本请求路径未变则整遍重放,变了则具名报冲突。路径不重叠的 commit 因此真并行;
     * 写域锁(need)照旧按路径取。提交后只把本请求路径同步进共享索引(撞 index.lock 重试 12 次)。push 在提交之后、不持任何提交锁。 */
    {   char *bv[] = {"git", "-C", (char *)(cwd ? cwd : root), "rev-parse", "HEAD", 0}; if (runcap(bv, sha0, sizeof sha0) == 0) chomp(sha0); else sha0[0] = 0; }
    {   const char *work = cwd ? cwd : root;
        (void)cx_fmt(cv_work, sizeof cv_work, "%s", work);
        if (cwd && wbr[0]) (void)cx_fmt(cv_ref_hint, sizeof cv_ref_hint, "%s", wbr);
        else if (git_branch_name(work, cv_ref_hint, sizeof cv_ref_hint) != 0) cv_ref_hint[0] = 0;
        cv_ref[0] = 0; cv_ref_after[0] = 0; cv_ref_before[0] = 0; cv_push_rc = 0; cv_commit_rc = 0;
        if (cv_ref_hint[0]) {
            char bspec[240];
            if (!cx_fmt(bspec, sizeof bspec, "refs/heads/%s", cv_ref_hint) &&
                mg_rev(work, bspec, cv_ref_before, sizeof cv_ref_before) != 0)
                cv_ref_before[0] = 0;
        }
    }
    char owned[64]="",published[64]="",landed_base[64]="";
    int commit_stage_ok = 0, verify_mismatch = 0, push_attempted = 0;
    char bind_why[32] = "";
    {   x_last_err[0] = 0; x_last_out[0]=0;
        if(sha0[0])dt_identity(sha0);
        int derives=flag(n,v,"--derive"), derived_done=0;char dp[PW],did[65];
        if(derives){
            long prepare_start=sy_now_ms();
            char *pv[FL_MAX_ARGV+8];int pn=0;char dd[PW];
            F(dd,sizeof dd,"%s/commit-derive-%ld-%d",dir,sy_now_ms(),sy_pid());
            F(dp,sizeof dp,"%s/receipt",dd);
            if(ovf||sy_mkdir_all(dd,0700))return 3;
            for(i=0;i<n;i++)if(strcmp(v[i],"--derive"))pv[pn++]=v[i];
            pv[pn++]="--derive-prepare";pv[pn++]=dp;pv[pn]=0;
            printf("COMMIT_STAGE\tphase=derive\tjob=%s\tstate=begin\n",dd);fflush(stdout);
            rc=tool_locked_cwd(root,need,"tools/commit-own.cx",cwd,pn,pv);
            if(rc==0){unsigned char*b=0;int64_t bn=0;
                if(sy_read_file(dp,&b,&bn,34000)||!b||sy_sha256_hex(b,bn,did))rc=2;else derived_done=1;
                if(b)free(b);
            }
            printf("COMMIT_STAGE\tphase=derive\tjob=%s\trc=%d\tderived=%s\n",dd,rc,derived_done?"completed":"incomplete");
            dt_derive(prepare_start,rc);
            if(rc==0){pn=0;for(i=0;i<n;i++)if(strcmp(v[i],"--derive"))pv[pn++]=v[i];
                pv[pn++]="--derive-receipt";pv[pn++]=dp;pv[pn++]="--derive-id";pv[pn++]=did;pv[pn]=0;
                printf("COMMIT_STAGE\tphase=commit\tderived=completed\tidentity=%s\n",did);fflush(stdout);
                rc=tool_locked_cwd(root,need,"tools/commit-own.cx",cwd,pn,pv);
            }
            if(rc!=0)printf("COMMIT_STAGE_FAIL\tphase=%s\trc=%d\tderived=%s\tnext=devsvc git commit --status (retain receipt %s; retry original command if inputs changed)\n",derived_done?"commit":"derive",rc,derived_done?"completed":"incomplete",dp);
        }else rc = tool_locked_cwd(root, need, "tools/commit-own.cx", cwd, n, v);
        if(!derives || derived_done)dt_worker(x_last_err,flag(n,v,"--derive-selected"));
        git_landed_receipt(x_last_out,0,owned);
        git_landed_base(x_last_out, landed_base);
        const char *eff_base = landed_base[0] ? landed_base : sha0;
        if (rc != 0 && owned[0]) {
            int sy_cnt = 0, kp_cnt = 0;
            int is_to = commit_was_timeout(rc, x_last_err, x_last_out);
            const char *wd = cwd ? cwd : root;
            if (is_to && commit_bind_verify(wd, cv_ref_hint, cv_ref_before, landed_base, owned, cv_ref, sizeof cv_ref, cv_ref_after, sizeof cv_ref_after, 0, 0)) {
                mg_root = root;
                if (eff_base[0] && strcmp(eff_base, owned) != 0) {
                    (void)mg_sync(wd, eff_base, owned, "GIT_COMMIT_SYNC", &sy_cnt, &kp_cnt);
                    recover_landed_index(wd, eff_base, owned);
                }
                printf("GIT_COMMIT_RECOVERED\tcommit=%s\tfrom=%s\tsynced=%d\tkept=%d\n",
                       owned, eff_base[0] ? eff_base : "-", sy_cnt, kp_cnt);
                fflush(stdout);
                rc = 0;
            }
        }
        commit_stage_ok = (rc == 0 && git_full_oid(owned)) ? 1 : 0;
        if (rc == 0 && !git_full_oid(owned)) {
            verify_mismatch = 1;
            rc = 1;
            F(bind_why, sizeof bind_why, "%s", (!cv_ref_hint[0] || !git_full_oid(cv_ref_before)) ? "unbound" : "ref-mismatch");
        } else if (commit_stage_ok) {
            const char *wd = cwd ? cwd : root;
            if (!commit_bind_verify(wd, cv_ref_hint, cv_ref_before, landed_base, owned, cv_ref, sizeof cv_ref, cv_ref_after, sizeof cv_ref_after, bind_why, sizeof bind_why)) {
                verify_mismatch = 1;
                commit_stage_ok = 0;
                rc = 1;
            }
        }
        if (rc != 0) { err_tail(x_last_err, 20); commit_class_from(x_last_err); }   /* 失败原因:commit-own 作业 stderr 尾部最多 20 行;类别记进完成事件 */
        commit_stale_locks_emit(root, x_last_err, auto_owner(), commit_req_val(0));
        long push_start=sy_now_ms();int pushing=commit_stage_ok && push;
        if (pushing) {
            char *commits[]={owned};
            if(!owned[0]){fprintf(stderr,"GIT_PUSH_REFUSE\treason=missing-commit-receipt\n");rc=1;}
            else {
                push_attempted = 1;
                rc=git_push_owned(root,cwd,1,commits,1);
                pushed=git_landed_receipt(x_last_out,1,published);
                if(!pushed&&rc)pushed=git_landed_receipt(x_last_out,2,published);
                if(!pushed&&!rc)rc=1;
            }
            cv_push_rc = rc;
        }
        if(pushing)dt_push(push_start,rc); }
    commit_range_note(cwd ? cwd : root, (commit_stage_ok && landed_base[0]) ? landed_base : sha0, commit_stage_ok ? owned : "");
    if (commit_stage_ok) pin_prepare_kick(cwd ? cwd : root);
    F(sha,sizeof sha,"%s",published[0]?published:owned[0]?owned:"none");
    /* 本次没有提交收据时 commit=none。其他请求推进 HEAD 不属于本次。失败时在行尾加 reason=:
     * timeout(rc 124,60 秒窗口)、refused(rc 2,具名拒绝或参数错)、blocked(其它非 0,多为提交门拦下)。
     * 必须同时通过 commit-own rc==0 且现场绑定 refs/heads/<recorded_ref>==sha、parent==ref_before 与 cat-file -t commit;
     * 若 push 重放生成了不同的 published sha, 须现场核对 refs/heads/<recorded_ref>==published 并独立保留 local_sha 与 published_sha。
     * 未通过或回执写入失败时统一回退为 NOT_COMMITTED 且不打印任何被拒收的 40 位 sha(commit=none)。 */
    {   const char *why = 0;
        const char *work = cwd ? cwd : root;
        cv_ready = 1; cv_committed = 0; cv_sha[0] = 0; cv_local_sha[0] = 0; cv_published_sha[0] = 0; cv_reason[0] = 0;
        if (landed_base[0]) (void)cx_fmt(cv_base, sizeof cv_base, "%s", landed_base); else cv_base[0] = 0;
        if (commit_stage_ok && !verify_mismatch && git_full_oid(owned)) {
            F(cv_local_sha, sizeof cv_local_sha, "%s", owned);
            if (published[0] && strcmp(published, owned) != 0) {
                char pspec[240], ptip[64];
                if (!git_full_oid(published) || !cv_ref[0] || cx_fmt(pspec, sizeof pspec, "refs/heads/%s", cv_ref) ||
                    mg_rev(work, pspec, ptip, sizeof ptip) != 0 || strcmp(ptip, published) != 0 ||
                    !git_cat_commit(work, published)) {
                    verify_mismatch = 1;
                    rc = 1;
                    F(bind_why, sizeof bind_why, "ref-mismatch");
                } else {
                    F(cv_published_sha, sizeof cv_published_sha, "%s", published);
                    F(cv_ref_after, sizeof cv_ref_after, "%s", published);
                    F(cv_sha, sizeof cv_sha, "%s", published);
                    cv_committed = 1;
                    cv_commit_rc = 0;
                }
            } else if (git_full_oid(sha)) {
                if (published[0]) F(cv_published_sha, sizeof cv_published_sha, "%s", published);
                cv_committed = 1;
                cv_commit_rc = 0;
                F(cv_sha, sizeof cv_sha, "%s", sha);
            }
        }
        if (!cv_committed) {
            F(cv_reason, sizeof cv_reason, "%s", verify_mismatch ? (bind_why[0] ? bind_why : "ref-mismatch") : (rc == 124 ? "timeout" : rc == 2 ? "refused" : "blocked"));
            cv_commit_rc = rc ? rc : 1;
        }
        if (in_bg && bg_job_dir[0]) {
            if (commit_receipt_write(bg_job_dir, bg_job_id, rc) != 0) {
                int pub_unknown = (cv_committed && push_attempted && !pushed) ? 1 : 0;
                fprintf(stderr, "devsvc: cannot persist commit receipt %s/commit-receipt.tsv\n", bg_job_dir);
                if (pub_unknown) {
                    fprintf(stderr, "devsvc: keep ref %s reason=publish-unknown (push attempted without publish marker)\n",
                            cv_ref[0] ? cv_ref : "-");
                } else if (cv_committed && !cv_published_sha[0] && !push_attempted && cv_ref[0] &&
                           git_full_oid(cv_ref_before) && git_full_oid(cv_ref_after)) {
                    char rspec[240], rbuf[256];
                    if (!cx_fmt(rspec, sizeof rspec, "refs/heads/%s", cv_ref)) {
                        char *uv[] = {"git", "-C", (char *)work, "update-ref", rspec, cv_ref_before, cv_ref_after, 0};
                        if (runcap(uv, rbuf, sizeof rbuf) != 0)
                            fprintf(stderr, "devsvc: cannot rollback ref %s\n", rspec);
                    }
                }
                cv_committed = 0;
                cv_sha[0] = 0; cv_local_sha[0] = 0; cv_published_sha[0] = 0;
                F(cv_reason, sizeof cv_reason, "%s", pub_unknown ? "publish-unknown" : "blocked");
                cv_commit_rc = 1;
                if (rc == 0) rc = 1;
            } else {
                bg_receipt_written = 1;
            }
        }
        if (!cv_committed && !strcmp(cv_reason, "blocked") && verify_mismatch == 0 && commit_stage_ok) why = "blocked";
        else if (verify_mismatch) why = bind_why[0] ? bind_why : "ref-mismatch";
        else if (!cv_committed) why = cv_reason[0] ? cv_reason : "blocked";
        else if (rc != 0 && push) why = pushed ? "push-local-reconcile" : "push-failed";
        else if (rc != 0) why = "failed";
        const char *emit_sha = cv_committed ? cv_sha : "none";
        if (cwd) printf("GIT_COMMIT\trc=%d\tcommit=%s\tpushed=%d\tms=%ld\tbranch=%s\tcwd=%s", rc, emit_sha, pushed, sy_now_ms() - t0, wbr, cwd);
        else printf("GIT_COMMIT\trc=%d\tcommit=%s\tpushed=%d\tms=%ld", rc, emit_sha, pushed, sy_now_ms() - t0);
        if (why) printf("\treason=%s", why);
        printf("\n"); }
    return rc;
}

static int usage(void) {
    fprintf(stderr, "usage: devsvc flow run FILE.tsv|- [--jobs N] [--deadline-ms N] [--cat] [--run DIR] [--owner O] [--lock-wait-ms N] | flow - ...\n"
                    "       devsvc f read PATH [OFF LIM] | f write PATH --from SRC [--expect-sha X] [--mkdir]\n"
                    "       devsvc f edit PATH --old-file A --new-file B [--expect-sha X] [--all] [--chomp] | x [--timeout-ms N] [--cwd D] -- ARGV...\n");
    fprintf(stderr, "usage: devsvc start|serve [--ttl S] [--idle S] | ping | stop | status [--paths] | config\n"
                    "       devsvc lock acquire NAME --owner O [--ttl S] | lock release NAME --owner O | lock list\n"
                    "       devsvc run [--local] TOOL.cx [ARGS...] | events [--since N] | events emit KIND TEXT | events on-change PATH...\n"
                    "       devsvc git commit -m MSG (--whole PATH... | --keyed PATH KEYS | --registered ID...) [--push] [--bg] [--cwd WORKTREE]: strict args, unknown option or --help -> rc 2, no commit;\n"
                    "         last line: COMMIT_RESULT<TAB>COMMITTED<TAB>sha=<40><TAB>ref=<branch><TAB>job=<id><TAB>tip_contains=<yes|no> | NOT_COMMITTED<TAB>reason=<timeout|refused|blocked|ref-mismatch|unbound|running><TAB>job=<id>\n"
                    "       devsvc git push FULL_SHA... [--cwd WORKTREE]: publish only the listed commits to the current branch on origin\n"
                    "       devsvc git verify SHA [--cwd WORKTREE]: prints VERIFIED<TAB>sha=..<TAB>ref=.. (rc 0) or NOT_FOUND (rc 1)\n"
                    "       long commands (over 55 s): devsvc x --bg --par 1 [--timeout-ms N] -- ARGV... -> JOB<TAB>id (returns at once; job runs in its own session, deadline kills its process group);\n"
                    "         devsvc wait JOB [--timeout-ms N<=55000] [--tail N|--grep S|--summary] -> JOB_DONE id rc=N (rc is the job's) or WAIT_TIMEOUT rc 124 (job keeps running; wait again); devsvc jobs lists\n"
                    "       devsvc git commit --status [JOB]: receipts of recent commit jobs + live COMMIT_RESULT with tip_contains=yes|no (foreground commit runs as a job and prints JOB id first)\n"
                    "       devsvc git merge BRANCH [-m MSG] [--cwd WORKTREE]: private-index merge, others staged/dirty kept; conflicts -> MERGE_CONFLICT lines, rc 1 | git pull [--cwd WORKTREE]: fetch + fast-forward only | git add PATH...: sync index (out/, .., absolute, ignored refused) | git unstage PATH... [--owner O]: restore index entry to HEAD, worktree bytes unchanged\n"
                    "         MSG: attribution lines (Co-Authored-By:, Signed-off-by:, Generated with [Claude Code]) are dropped before commit; the first line left must be body text\n"
                    "       devsvc task open|amend|status|done|list ...  -> tools/devtask.cx task ...; devsvc task SUB --help gives the full syntax; devsvc f --help\n"
                    "       devsvc task open: --cwd absolute or repo-relative (under .claude/worktrees/ or a --write-ext dir); --write repo-relative prefixes or absolute under the repo root\n"
                    "       devsvc branch create --owner O --unit U [--base REF]: server-verified branch+worktree from plans/v01x-units.tsv (DEVSVC_OWNER is self-reported cooperation guard, not a security boundary; missing/invalid owner refused)\n"
                    "       devsvc accept-tree [create] --commit REV --owner R [--ttl S] | list | remove ID: dac-guarded (0444/0555 + entry refusal, same-UID can undo) expiry review worktree; expired trees also cleaned on service start\n");
    return 2;
}

/* ---- 后台作业:x|flow|git commit|register|derive 带 --bg 时在独立会话里跑(各自 deadline 照旧),元数据落 <实例>/jobs/<id>/
   (pid、meta、stdin、out、rc);结束记事件 job.done。wait 阻塞到结束或超时(超时 rc 124,不杀作业);jobs 列表;events --wait 等事件。 ---- */
static int main2(int argc, char **argv);
static char last_job[48];   /* bg_launch 最近一次起的作业 id */
typedef struct { int argc, commit; char **argv; char root[PW], jd[PW], id[48], owner[64]; } BgJob;
static int okjob(const char *s) { long n = 0; for (; s && s[n]; n++) if (!((s[n] >= '0' && s[n] <= '9') || s[n] == '-')) return 0; return n > 2 && n < 40; }
static int bg_child(void *ud) {
    BgJob *j = (BgJob *)ud; char p[PW + 16], t[400]; int fd, r; long t0 = sy_now_ms();
    F(p, sizeof p, "%s/out", j->jd); fd = sy_open(p, O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (fd < 0) return 126;
    sy_dup2(fd, 1); sy_dup2(fd, 2); sy_close(fd);
    F(p, sizeof p, "%s/stdin", j->jd); if (sy_exists(p) == 1) { fd = sy_open(p, O_RDONLY, 0); if (fd >= 0) { sy_dup2(fd, 0); sy_close(fd); } }
    in_bg = 1;
    bg_receipt_written = 0;
    F(bg_job_dir, sizeof bg_job_dir, "%s", j->jd);
    F(bg_job_id, sizeof bg_job_id, "%s", j->id);
    request_launcher = 0;  /* detached explicitly; the job owns its deadline */
    dt_job(j->id);
    if (j->commit && j->id[0]) F(commit_req, sizeof commit_req, "%s", j->id);
    r = main2(j->argc, j->argv);
    timing_finish(r);
    if(j->commit){
        if (!bg_receipt_written && commit_receipt_write(j->jd, j->id, r) != 0) {
            fprintf(stderr, "devsvc: cannot persist commit receipt %s/commit-receipt.tsv\n", j->jd);
            cv_committed = 0;
            cv_sha[0] = 0;
            if (!cv_ready || strcmp(cv_reason, "publish-unknown") != 0)
                (void)cx_fmt(cv_reason, sizeof cv_reason, "blocked");
            if (r == 0) r = 1;
        }
        report_window=FL_NODE_MS;report_end("git.commit",j->id);commit_result_emit(j->id, r);
    }
    else report_end(report_kind,j->id);
    fflush(stdout); fflush(stderr);
    if (j->commit && !cx_fmt(t, sizeof t, "emit\tgit.commit\towner=%s\tpid=%d\trc=%d\tms=%ld\tclass=%s\t%s\tgate=%s\treason=%s\treq=%s",
                            j->owner, sy_pid(), r, sy_now_ms() - t0, commit_outcome(r),
                            commit_range, commit_gate_val(r), commit_reason_val(r), commit_req_val(j->id)))
        request(j->root, t, 0);
    F(t, sizeof t, "%d\t%ld\n", r, sy_now_ms() - t0); F(p, sizeof p, "%s/rc", j->jd); sy_write_atomic(p, t, strlen(t), 0644);
    F(t, sizeof t, "emit\tjob.done\tid=%s\trc=%d\tms=%ld\towner=%s", j->id, r, sy_now_ms() - t0, j->owner); request(j->root, t, 0);
    return r;
}
/* 去掉 "--" 之前的 --bg;git 只认 commit。有则返回 1 */
static int bg_strip(const char *cmd, int argc, char **argv, int *pos) {
    int i;
    if (strcmp(cmd, "x") && strcmp(cmd, "flow") && strcmp(cmd, "git") && strcmp(cmd, "register") && strcmp(cmd, "derive")) return 0;
    if (!strcmp(cmd, "git") && (argc < 1 || strcmp(argv[0], "commit"))) return 0;
    for (i = 0; i < argc && strcmp(argv[i], "--"); i++) if (!strcmp(argv[i], "--bg")) { *pos = i; return 1; }
    return 0;
}
static int bg_launch(const char *root, const char *cmd, int oargc, char **oargv, char **bgarg) {
    static BgJob j; static char *nv[FL_MAX_ARGV + 8]; int i, n = 0, fds[2], pid, rd = 0; char p[PW + 16], t[PW + 200];
    if (oargc > FL_MAX_ARGV + 6) return 2;
    for (i = 0; i < oargc; i++) { if (oargv + i == bgarg) continue; nv[n++] = oargv[i]; if (!strcmp(oargv[i], "-")) rd = 1; }
    nv[n] = 0; j.argc = n; j.argv = nv; j.commit = !strcmp(cmd, "git");
    F(j.root, sizeof j.root, "%s", root); F(j.id, sizeof j.id, "%ld-%d", sy_now_ms(), sy_pid()); F(j.owner, sizeof j.owner, "%s", auto_owner());
    F(j.jd, sizeof j.jd, "%s/jobs/%s", dir, j.id);
    if (ovf || sy_mkdir_all(j.jd, 0700)) { fprintf(stderr, "devsvc: cannot create job directory\n"); return 3; }
    if (!strcmp(cmd, "flow") && rd) {   /* flow - 的节点表先读完落盘,作业从该文件读 stdin */
        AB b = {0, 0, 0}; char chunk[65536]; size_t k;
        while ((k = fread(chunk, 1, sizeof chunk, stdin)) > 0) { ab_add(&b, chunk, (long)k); if (b.n > (16L << 20)) return 2; }
        F(p, sizeof p, "%s/stdin", j.jd); if (sy_write_atomic(p, b.p ? b.p : "", b.n, 0600)) return 3;
    }
    {   long k = 0; t[0] = 0; for (i = 0; i < n && k < (long)sizeof t - 80; i++) { int w = snprintf(t + k, sizeof t - k, "%s%s", i ? " " : "", nv[i]); if (w < 0 || w >= (int)(sizeof t - k)) break; k += w; }
        clean(t); }
    {   char m[PW * 2 + 640];
        if (j.commit) {
            const char *cw = opt(n, nv, "--cwd", 0);
            char wbuf[PW], rbuf[PW], mref[200]; const char *mw = root;
            if (cw && cw[0]) {
                if (cw[0] == '/') (void)cx_fmt(wbuf, sizeof wbuf, "%s", cw);
                else (void)cx_fmt(wbuf, sizeof wbuf, "%s/%s", root, cw);
                if (realpath(wbuf, rbuf)) mw = rbuf; else mw = wbuf;
            }
            if (git_branch_name(mw, mref, sizeof mref) != 0) (void)cx_fmt(mref, sizeof mref, "-");
            F(m, sizeof m, "cmd\t%s\nowner\t%s\nstart\t%ld\nwork\t%s\nref\t%s\n", t, j.owner, sy_now_ms(), mw, mref);
        } else {
            F(m, sizeof m, "cmd\t%s\nowner\t%s\nstart\t%ld\n", t, j.owner, sy_now_ms());
        }
        F(p, sizeof p, "%s/meta", j.jd); sy_write_atomic(p, m, strlen(m), 0644); }
    fflush(stdout); fflush(stderr);
    pid = sy_fork_session(bg_child, &j, fds);
    if (pid < 0) { fprintf(stderr, "devsvc: cannot start background job (%d)\n", pid); return 3; }
    sy_close(fds[0]); sy_close(fds[1]);
    F(t, sizeof t, "%d\n", pid); F(p, sizeof p, "%s/pid", j.jd); sy_write_atomic(p, t, strlen(t), 0644);
    if (!bg_defer_job_line) printf("JOB\t%s\trun=%s\n", j.id, j.jd);
    F(last_job, sizeof last_job, "%s", j.id);
    return 0;
}
static int job_read(const char *jd, const char *name, char *out, long cap) {   /* 读小文件到 out;成功 0 */
    char p[PW + 16]; unsigned char *b = 0; int64_t n = 0;
    F(p, sizeof p, "%s/%s", jd, name);
    if (sy_exists(p) != 1 || sy_read_file(p, &b, &n, cap - 1) || !b) { if (b) free(b); return -1; }
    mm_copy(out, cap, b, n); out[n] = 0; free(b); return 0;
}
static int job_alive(const char *jd) { char t[32], p[64]; if (job_read(jd, "pid", t, sizeof t)) return 0; F(p, sizeof p, "/proc/%ld", atol(t)); return sy_exists(p) == 1; }
static int cmd_wait(int argc, char **argv) {
    long tm = 50000, t0 = sy_now_ms(); char jd[PW], t[64]; int i;
    for (i = 1; i < argc; i++) {
        int k;
        if (!strcmp(argv[i], "--timeout-ms") && i + 1 < argc) { tm = numarg(argv[++i]); if (tm < 1 || tm > 55000) break; }
        else if ((k = oc_opt(argc, argv, i)) > 0) i += k - 1;
        else break;
    }
    if (argc < 1 || !okjob(argv[0]) || i < argc || tm < 1) { fprintf(stderr, "devsvc: wait JOB [--timeout-ms N] [--tail N] [--head N] [--grep S]... [--summary] (1..55000, default 50000)\n"); return 2; }
    F(jd, sizeof jd, "%s/jobs/%s", dir, argv[0]);
    if (ovf || job_read(jd, "meta", (char *)big, 4096)) { fprintf(stderr, "devsvc: no such job %s\n", argv[0]); return 2; }
    for (;;) {
        if (!job_read(jd, "rc", t, sizeof t)) break;
        if (!job_alive(jd) && job_read(jd, "rc", t, sizeof t)) { printf("JOB_LOST\t%s\n", argv[0]); return 125; }
        if (sy_now_ms() - t0 >= tm) { printf("WAIT_TIMEOUT\t%s\tms=%ld\n", argv[0], sy_now_ms() - t0); return 124; }
        sy_sleep_ms(100);
    }
    {   char p[PW + 16]; unsigned char *b = 0; int64_t n = 0; long cap = 8192;   /* 输出尾部至多 8 KB;有输出控制时按其过滤,全量即作业 out */
        F(p, sizeof p, "%s/out", jd);
        if (oc.on && !sy_read_file(p, &b, &n, 1L << 26) && b) {
            if (oc.summary) {   /* 作业输出里已有的节点/结果行:SUM、NODE、X、DEVSVC_FLOW */
                long st, en; for (st = 0; st < n; st = en + 1) { en = st; while (en < n && b[en] != '\n') en++;
                    static const char *pre[] = {"SUM\t", "NODE\t", "X\t", "DEVSVC_FLOW\t", 0}; int j;
                    for (j = 0; pre[j]; j++) { long pl = strlen(pre[j]); if (en - st >= pl && !memcmp(b + st, pre[j], pl)) { printf("%.*s\n", (int)(en - st), (char *)b + st); break; } } }
            } else oc_emit((char *)b, (long)n);
            free(b); b = 0; n = -1;
        }
        if (n >= 0 && !sy_read_file(p, &b, &n, 1L << 26) && b) {
            if (n > cap) printf("DEVSVC_TAIL\tbytes=%ld\tshown=%ld\n", (long)n, cap);
            fwrite(b + (n > cap ? n - cap : 0), 1, (size_t)(n > cap ? cap : n), stdout);
            if (n > 0 && b[n - 1] != '\n') putchar('\n');
        }
        if (b) free(b); }
    printf("JOB_DONE\t%s\trc=%d\tms=%ld\n", argv[0], atoi(t), atol(strchr(t, '\t') ? strchr(t, '\t') + 1 : "0"));
    if (oc.on) printf("OUT=%s/out\n", jd);
    return atoi(t);
}
/* 作业目录清理(服务空闲巡检调用):只动实例目录 jobs/ 下合 okjob 名、已有 rc(已结束)的目录;
   结束超过 24 小时,或按新到旧数超过 200 的,删除;在途与 lost 不删。返回删除数 */
#define JOBS_KEEP 200
#define JOBS_AGE_S 86400
static int jobs_gc(void) {
    static char lst[1 << 16]; char jd[PW], *s, *e; int n = 0, del = 0; long now = sy_wall_s();
    char *v[] = {"ls", "-1t", jd, 0};
    F(jd, sizeof jd, "%s/jobs", dir);
    if (sy_exists(jd) != 1 || runcap(v, lst, sizeof lst) < 0) return 0;
    for (s = lst; *s; s = e) {
        char d[PW], rp[PW + 8]; sy_stat_t st;
        e = strchr(s, '\n'); if (e) *e++ = 0; else e = s + strlen(s);
        if (!okjob(s)) continue;
        n++;
        F(d, sizeof d, "%s/%s", jd, s); F(rp, sizeof rp, "%s/rc", d);
        if (sy_stat(rp, &st)) continue;
        if (n > JOBS_KEEP || now - st.mtime > JOBS_AGE_S) {
            if (sy_remove_all(d) == 0) del++;
        }
    }
    if (del) { char m[64]; F(m, sizeof m, "deleted=%d\tseen=%d", del, n); ev_add("jobs.gc", m); }
    return del;
}
/* flow 运行目录回收(同一空闲巡检):只删 TMPDIR 下的 flow 会话或旧 devsvc-flow- 目录，不跟符号链接，owner 是当前用户，
   mtime 超过 $DEVSVC_FLOWDIR_GC_AGE_S(缺省 7200 s)且 pgrep 命令行不含该路径的目录;每次最多 200 个,记 flowdir.gc 事件 */
#define FLOWDIR_GC_MAX 200
static const char flow_session_prefix[] = "unisacc-session-devsvc-flow-";
static int flowdir_gc(void) {
    static char lst[1 << 18]; char *s, *e; int del = 0, seen = 0; long now = sy_wall_s(), age = 7200; const char *ae = getenv("DEVSVC_FLOWDIR_GC_AGE_S");
    char tmp[PW]; char *v[] = {"find", tmp, "-maxdepth", "1", "(", "-name", "unisacc-session-devsvc-flow-*", "-o", "-name", "devsvc-flow-*", ")", "-type", "d", 0};
    if (ae && *ae && atol(ae) >= 0) age = atol(ae);
    { const char *gd = getenv("DEVSVC_FLOWDIR_GC_DIR"); F(tmp, sizeof tmp, "%s", gd && *gd ? gd : sy_tmpdir()); }   /* 覆盖目录仅供检查用 */
    if (runcap(v, lst, sizeof lst) < 0) return 0;
    for (s = lst; *s && del < FLOWDIR_GC_MAX; s = e) {
        sy_stat_t st; char *pg[] = {"pgrep", "-f", "--", s, 0}; char po[64]; const char *base;
        e = strchr(s, '\n'); if (e) *e++ = 0; else e = s + strlen(s);
        base = strrchr(s, '/'); base = base ? base + 1 : s;
        int session = !strncmp(base, flow_session_prefix, sizeof flow_session_prefix - 1);
        if ((!session && strncmp(base, "devsvc-flow-", sizeof "devsvc-flow-" - 1)) || strstr(s, "..")) continue;
        seen++;
        if (sy_lstat(s, &st) || st.kind != 'd' || st.uid != (long)sy_uid() || now - st.mtime < age) continue;
        if (session) {
            const char *p = base + sizeof flow_session_prefix - 1;
            char *end;
            long pid = strtol(p, &end, 10);
            if (p == end || *end != '-' || pid < 2 || pid > 2147483647 || sy_signal((int)pid, 0) != -ESRCH) continue;
        }
        if (runcap(pg, po, sizeof po) == 0) continue;   /* 有进程引用 */
        if (sy_remove_all(s) == 0) del++;
    }
    if (del) { char m[64]; F(m, sizeof m, "deleted=%d\tseen=%d", del, seen); ev_add("flowdir.gc", m); }
    return del;
}
/* 前台 git commit 回执:提交一律在作业里跑(独立会话,调用方被外层超时杀掉也照常完成并落 rc/out),
   前台跟随至作业结束(总 deadline COMMIT_FOLLOW_MS、轮询次数上限),回显作业输出,rc 即提交 rc;
   跟随超时 rc 124 并提示 git commit --status 取回执。 */
#define COMMIT_FOLLOW_MS 600000L
static int commit_follow(const char *root, const char *id) {
    char jd[PW], t[64]; long t0 = sy_now_ms(), n, follow_ms = COMMIT_FOLLOW_MS;
    {   const char *fe = getenv("DEVSVC_COMMIT_FOLLOW_MS");
        if (fe && atol(fe) >= 100 && atol(fe) <= COMMIT_FOLLOW_MS) follow_ms = atol(fe); }
    F(jd, sizeof jd, "%s/jobs/%s", dir, id);
    printf("COMMIT_PENDING\tjob=%s\tNOT_COMMITTED_YET\n", id);
    printf("JOB\t%s\trun=%s\n", id, jd);
    fflush(stdout);
    for (n = 0; n < follow_ms / 100 + 2; n++) {
        if (!job_read(jd, "rc", t, sizeof t)) break;
        if (!job_alive(jd) && job_read(jd, "rc", t, sizeof t)) {
            printf("JOB_LOST\t%s\n", id);
            printf("COMMIT_RESULT\tNOT_COMMITTED\treason=blocked\tjob=%s\n", id);
            return 125;
        }
        if (sy_now_ms() - t0 >= follow_ms) break;
        sy_sleep_ms(100);
    }
    if (job_read(jd, "rc", t, sizeof t)) {
        printf("WAIT_TIMEOUT\t%s\tms=%ld\thint=devsvc git commit --status %s\n", id, sy_now_ms() - t0, id);
        printf("COMMIT_PENDING\tjob=%s\tNOT_COMMITTED_YET\n", id);
        printf("COMMIT_RESULT\tNOT_COMMITTED\treason=timeout\tjob=%s\n", id);
        return 124;
    }
    {   char p[PW + 16]; unsigned char *b = 0; int64_t m = 0; CommitVerdict cv;
        F(p, sizeof p, "%s/out", jd);
        commit_verdict_from_job(root, jd, id, &cv);
        if (!sy_read_file(p, &b, &m, 1L << 26) && b) {
            long end = (long)m;
            while (end > 0 && (b[end - 1] == '\n' || b[end - 1] == '\r')) end--;
            long st = end;
            while (st > 0 && b[st - 1] != '\n') st--;
            if (end - st >= 14 && !memcmp(b + st, "COMMIT_RESULT\t", 14)) end = st;
            if (end > 0) {
                if (cv.committed) {
                    fwrite(b, 1, (size_t)end, stdout);
                    if (b[end - 1] != '\n') putchar('\n');
                } else {
                    long a, z;
                    for (a = 0; a < end; a = z + 1) {
                        z = a; while (z < end && b[z] != '\n') z++;
                        long ln = z - a;
                        if (ln > 0 && b[a + ln - 1] == '\r') ln--;
                        emit_git_line_sanitized((const char *)b + a, ln, 1);
                    }
                }
            }
            free(b);
        }
        commit_class_from(p);   /* 前台 commit 的完成事件 class= 取自作业输出 */
        if (cv.committed) {
            printf("COMMIT_RESULT\tCOMMITTED\tsha=%s\tref=%s\tjob=%s\ttip_contains=%s\n",
                   cv.sha, cv.ref, id, cv.tip_contains ? "yes" : "no");
            return cv.verdict_rc;
        }
        printf("COMMIT_RESULT\tNOT_COMMITTED\treason=%s\tjob=%s\n", cv.reason[0] ? cv.reason : "blocked", id);
        return cv.verdict_rc ? cv.verdict_rc : 1;
    }
}
/* git commit --status [JOB]:列最近至多 5 个 commit 作业(或指定 JOB)的回执:
   COMMIT_RECEIPT<TAB>JOB<TAB>done|running|lost<TAB>rc=N 后接作业输出里的 GIT_COMMIT 行(rc、commit 号、路径在其中与 meta cmd),
   并统一用结构化作业收据 + 现场 ref 检查给出 COMMIT_RESULT;未提交时不回放任何 40 位 sha */
static int commit_status(const char *root, const char *want) {
    char jd[PW], lst[1 << 15], *s, *e, t[64], m[4096]; int n = 0;
    char *v[] = {"ls", "-1t", jd, 0};
    char f_id[48] = "", f_st[16] = "", f_jd[PW] = "";
    CommitVerdict f_cv;
    memset(&f_cv, 0, sizeof f_cv);
    F(jd, sizeof jd, "%s/jobs", dir);
    if (want && !okjob(want)) {
        fprintf(stderr, "devsvc: git commit --status [JOB]: bad job id\n");
        printf("COMMIT_RESULT\tNOT_COMMITTED\treason=refused\tjob=-\n");
        return 2;
    }
    if (sy_exists(jd) != 1 || runcap(v, lst, sizeof lst) < 0) lst[0] = 0;
    for (s = lst; *s && n < 5; s = e) {
        char d[PW], *c, *ce, p[PW + 16]; unsigned char *b = 0; int64_t bn = 0; const char *st; int rc = -1;
        CommitVerdict jcv;
        e = strchr(s, '\n'); if (e) *e++ = 0; else e = s + strlen(s);
        if (!okjob(s) || (want && strcmp(s, want))) continue;
        F(d, sizeof d, "%s/%s", jd, s);
        if (job_read(d, "meta", m, sizeof m) || !meta_cmd_is_git_commit(m)) continue;
        c = strstr(m, "cmd\t"); if (!c) continue;
        c += 4; ce = strchr(c, '\n'); if (ce) *ce = 0;
        if (!job_read(d, "rc", t, sizeof t) && strict_parse_int(t, &rc) == 0) { st = "done"; } else { rc = -1; st = job_alive(d) ? "running" : "lost"; }
        memset(&jcv, 0, sizeof jcv);
        if (!strcmp(st, "done")) commit_verdict_from_job(root, d, s, &jcv);
        printf("COMMIT_RECEIPT\t%s\t%s\trc=%d\tcmd=%.300s\n", s, st, rc, c);
        if (n == 0) {
            (void)cx_fmt(f_id, sizeof f_id, "%s", s);
            (void)cx_fmt(f_st, sizeof f_st, "%s", st);
            (void)cx_fmt(f_jd, sizeof f_jd, "%s", d);
            f_cv = jcv;
        }
        F(p, sizeof p, "%s/out", d);
        if (!sy_read_file(p, &b, &bn, 1L << 24) && b) {
            long a, z;
            for (a = 0; a < bn; a = z + 1) {
                z = a; while (z < bn && b[z] != '\n') z++;
                if (z - a > 11 && !memcmp(b + a, "GIT_COMMIT\t", 11)) {
                    emit_git_line_sanitized((const char *)b + a, z - a, strcmp(st, "done") || !jcv.committed);
                }
            }
            free(b);
        }
        n++;
    }
    printf("COMMIT_RECEIPTS\tn=%d\n", n);
    if (n == 0) {
        printf("COMMIT_RESULT\tNOT_COMMITTED\treason=refused\tjob=%s\n", (want && want[0]) ? want : "-");
    } else if (!strcmp(f_st, "running")) {
        printf("COMMIT_RESULT\tNOT_COMMITTED\treason=running\tjob=%s\n", f_id);
    } else if (!strcmp(f_st, "lost")) {
        printf("COMMIT_RESULT\tNOT_COMMITTED\treason=blocked\tjob=%s\n", f_id);
    } else if (f_cv.committed) {
        printf("COMMIT_RESULT\tCOMMITTED\tsha=%s\tref=%s\tjob=%s\ttip_contains=%s\n",
               f_cv.sha, f_cv.ref, f_id, f_cv.tip_contains ? "yes" : "no");
    } else {
        printf("COMMIT_RESULT\tNOT_COMMITTED\treason=%s\tjob=%s\n", f_cv.reason[0] ? f_cv.reason : "blocked", f_id);
    }
    return want && !n ? 2 : 0;
}
static int cmd_jobs(void) {
    char jd[PW], lst[1 << 15], *s, *e, t[64], m[4096]; int n = 0;
    char *v[] = {"ls", "-1t", jd, 0};
    F(jd, sizeof jd, "%s/jobs", dir);
    if (sy_exists(jd) != 1 || runcap(v, lst, sizeof lst) < 0) { printf("JOBS\tn=0\n"); return 0; }
    for (s = lst; *s && n < 30; s = e) {
        char d[PW]; e = strchr(s, '\n'); if (e) *e++ = 0; else e = s + strlen(s);
        if (!okjob(s)) continue;
        F(d, sizeof d, "%s/%s", jd, s); if (job_read(d, "meta", m, sizeof m)) continue;
        {   char *c = strstr(m, "cmd\t"), *ce; if (c) { c += 4; ce = strchr(c, '\n'); if (ce) *ce = 0; } else c = "-";
            if (!job_read(d, "rc", t, sizeof t)) { char *q = strchr(t, '\t'); chomp(t); printf("JOB\t%s\tdone\trc=%d\tms=%ld\tcmd=%s\n", s, atoi(t), q ? atol(q + 1) : 0L, c); }
            else printf("JOB\t%s\t%s\tcmd=%s\n", s, job_alive(d) ? "running" : "lost", c); }
        n++;
    }
    printf("JOBS\tn=%d\n", n);
    return 0;
}
static int events_wait(const char *root, const char *kind, long since, long tm) {
    long t0 = sy_now_ms(), mx = since; char req[64];
    if (!okname(kind) || tm < 1 || tm > 55000) return 2;
    for (;;) {
        char *s, *e; int r;
        F(req, sizeof req, "events\t%ld", since < 0 ? 0 : since);
        r = request(root, req, 1);
        if (r) return say(r);
        if (since < 0) { s = strstr(resp, "seq="); since = s ? atol(s + 4) : 0; mx = since; continue; }   /* 缺省只等新事件 */
        for (s = resp; *s; s = e) {
            e = strchr(s, '\n'); if (e) *e++ = 0; else e = s + strlen(s);
            if (!strncmp(s, "EV\t", 3)) {
                char *f2 = strchr(s + 3, '\t'), *f3 = f2 ? strchr(f2 + 1, '\t') : 0; long q = atol(s + 3); size_t kl = strlen(kind);
                if (q > mx) mx = q;
                if (f3 && !strncmp(f3 + 1, kind, kl) && (f3[1 + kl] == '\t' || !f3[1 + kl])) { printf("%s\n", s); return 0; }
            }
        }
        since = mx;
        if (sy_now_ms() - t0 >= tm) { printf("WAIT_TIMEOUT\tevents\t%s\tseq=%ld\n", kind, mx); return 124; }
        sy_sleep_ms(200);
    }
}

/* ---- cx-dev 事件预建的自动拉起:写入落到 cx-dev 的表输入(exec/、seed/)且本检出已构造过 cx-dev bundle、又没有在跑的
   `cx-dev --watch` 时,在独立会话里后台起一个(CXDEV_EVENTS 指向本实例 events.tsv),不等它、不读它的输出。
   bundle 目录规则与 tools/cx-dev.cx --build 相同:$CXDEV_HOME(绝对路径),否则 ${TMPDIR:-/tmp}/cx-dev-<uid>/wt<检出根>。
   "已构造" = bundle 里有 cx-dev 与 ape.id;"在跑" = watch.lock 里的 pid 仍在 /proc。两个写入同时到达可能各起一个,
   第二个由 cx-dev 自己的 watch.lock(O_EXCL)拒绝并立即退出。有界性全在 cx-dev --watch(总寿命、空闲自退、负载门),
   本处不常驻。输出追加到 bundle/watch.log(超 1 MB 先清空)。$DEVSVC_CXDEV_WATCH=0 关闭。拉起成功记事件 cxdev.watch。 ---- */
typedef struct { char exe[PW], log[PW], ev[PW], cwd[PW]; } CxKick;
static int cxk_child(void *ud) {
    CxKick *k = (CxKick *)ud; int fd; char *av[] = {k->exe, "--watch", 0};
    fd = sy_open(k->log, O_WRONLY | O_CREAT | O_APPEND, 0600);
    if (fd < 0) return 126;
    sy_dup2(fd, 1); sy_dup2(fd, 2); sy_close(fd);
    if (k->ev[0] && setenv("CXDEV_EVENTS", k->ev, 1)) return 126;
    execv(k->exe, av);
    return 127;
}
static int cxk_input(const char *root, const char *path, char *rel, int cap) {   /* 路径是否 cx-dev 的表输入;rel 得仓内相对路径 */
    long rl = (long)strlen(root); const char *p = path;
    if (!p || !*p) return 0;
    if (p[0] == '/') { if (strncmp(p, root, rl) || p[rl] != '/') return 0; p += rl + 1; }
    while (p[0] == '.' && p[1] == '/') p += 2;
    if (strstr(p, "..") || snprintf(rel, cap, "%s", p) >= cap) return 0;
    return !strncmp(p, "exec/", 5) || !strncmp(p, "seed/", 5);
}
static int cxdev_kick(const char *root, const char *path) {   /* 返回 1:路径是表输入(拉起与否另论);0:不是或已关闭 */
    static CxKick k; char b[PW], p[PW + 16], rel[PW], t[32], rq[PW + 200]; const char *e = getenv("DEVSVC_CXDEV_WATCH"); int fds[2], pid; int64_t sz = 0;
    if ((e && !strcmp(e, "0")) || !cxk_input(root, path, rel, sizeof rel)) return 0;
    e = getenv("CXDEV_HOME");
    if (e && e[0] == '/') { if (snprintf(b, sizeof b, "%s", e) >= (int)sizeof b) return 1; }
    else { e = getenv("TMPDIR"); if (snprintf(b, sizeof b, "%s/cx-dev-%d/wt%s", e && e[0] ? e : "/tmp", (int)sy_uid(), root) >= (int)sizeof b) return 1; }
    if (snprintf(k.exe, sizeof k.exe, "%s/cx-dev", b) >= (int)sizeof k.exe || snprintf(k.log, sizeof k.log, "%s/watch.log", b) >= (int)sizeof k.log) return 1;
    if (snprintf(p, sizeof p, "%s/ape.id", b) >= (int)sizeof p || sy_exists(k.exe) != 1 || sy_exists(p) != 1) return 1;   /* 没构造过 bundle:不拉起 */
    if (!job_read(b, "watch.lock", t, sizeof t) && atol(t) > 0) {   /* 已有在跑的(/proc/PID/stat 可读且状态不是 Z:被杀后未回收的僵尸不算在跑) */
        char pp[64], st[512], *q; F(pp, sizeof pp, "/proc/%ld", atol(t));
        if (!job_read(pp, "stat", st, sizeof st) && (q = strrchr(st, ')')) && q[1] == ' ' && q[2] != 'Z' && q[2] != 'X') return 1;
    }
    k.ev[0] = 0; if (dir[0] && snprintf(k.ev, sizeof k.ev, "%s/events.tsv", dir) >= (int)sizeof k.ev) k.ev[0] = 0;
    if (sy_file_size(k.log, &sz) == 0 && sz > (1L << 20)) sy_unlink(k.log);
    fflush(stdout); fflush(stderr);
    pid = sy_fork_session(cxk_child, &k, fds);
    if (pid < 0) return 1;
    sy_close(fds[0]); sy_close(fds[1]);
    if (dir[0] && snprintf(rq, sizeof rq, "emit\tcxdev.watch\tstarted\tpid=%d\ttrigger=%.300s\tbundle=%.400s", pid, rel, b) < (int)sizeof rq) request(root, rq, 0);
    return 1;
}

int main(int argc, char **argv) {
    const char *parent=sy_env("DEVSVC_REQUEST_PARENT");
    if(parent) { request_launcher=atoi(parent); unsetenv("DEVSVC_REQUEST_PARENT"); }
    long t0 = sy_now_ms();dt_begin(t0);report_epoch=sy_wall_s();report_pid=sy_pid();
    int r = main2(argc, argv), a = argc > 1 && !strcmp(argv[1], "--") ? 2 : 1;
    if(request_launcher && sy_ppid()!=request_launcher)return r;
    if(!last_job[0])timing_finish(r);
    if (!ovf && dir[0] && argc > a) {   /* 命令完成事件:kind=<命令>.<子命令>,带 owner、rc、ms;实例不在则不记(不为记事件拉起实例) */
        static const char *ev[] = {"f", "x", "flow", "doc", "git", "run", "register", "derive", 0};
        int j; char root[PW], rq[600];
        for (j = 0; ev[j]; j++) if (!strcmp(argv[a], ev[j])) break;
        if (ev[j] && !(last_job[0] && !strcmp(argv[a], "git")) && sy_cwd(root, sizeof root) >= 0) {
            char sub[48] = "-"; int s = a + 1;
            if (!strcmp(argv[a], "x")) {   /* x 事件取工具名:跳过 --timeout-ms N、--cwd D、--owner N、--bg 等选项与 --,再跳过 sh 与 unisacc.com,去目录与 .cx 后缀 */
                while (s < argc && argv[s][0] == '-') {
                    if (!strcmp(argv[s], "--")) { s++; break; }
                    s += (!strcmp(argv[s], "--timeout-ms") || !strcmp(argv[s], "--cwd") || !strcmp(argv[s], "--par") || !strcmp(argv[s], "--owner") || !strcmp(argv[s], "--tail")
                          || !strcmp(argv[s], "--head") || !strcmp(argv[s], "--grep")) && s + 1 < argc ? 2 : 1;
                }
                while (s + 1 < argc && (!strcmp(argv[s], "sh") || strstr(argv[s], "unisacc.com"))) s++;
            }
            if (argc > s) {
                const char *w = argv[s], *sl = strrchr(w, '/'); int q, wn;
                if (!strcmp(argv[a], "x") && sl && sl[1]) w = sl + 1;
                for (q = 0; q < 47 && w[q]; q++) sub[q] = w[q]; sub[q] = 0; wn = q;
                if (!strcmp(argv[a], "x") && wn > 3 && !strcmp(sub + wn - 3, ".cx")) sub[wn - 3] = 0;
                clean(sub);
            }   /* 子命令词超 47 字节只取前缀 */
            char fx[700] = "";   /* f.edit/f.write 带 path 与写后 sha,供 devtask 按 owner 归属写域外改动 */
            if (!strcmp(argv[a], "x") && argc > s + 1 && (!strcmp(sub, "git") || !strcmp(sub, "gh"))) {   /* K6:x.git/x.gh 追加 sub=第一个非选项参数(git 的 -C/-c 带值) */
                int u = s + 1; char sw[48]; int q;
                while (u < argc && argv[u][0] == '-') u += (!strcmp(sub, "git") && (!strcmp(argv[u], "-C") || !strcmp(argv[u], "-c"))) ? 2 : 1;
                if (u < argc) { for (q = 0; q < 47 && argv[u][q]; q++) sw[q] = argv[u][q]; sw[q] = 0; clean(sw); F(fx, sizeof fx, "\tsub=%s", sw); }
            }
            if (!strcmp(argv[a], "git") && !strcmp(sub, "commit"))   /* K6+U0: class/gate/reason/req 全部入事件,旧列不动 */
                F(fx, sizeof fx, "\tclass=%s\t%s\tgate=%s\treason=%s\treq=%s",
                  commit_outcome(r), commit_range, commit_gate_val(r), commit_reason_val(r), commit_req_val(0));
            if (!strcmp(argv[a], "f") && (!strcmp(sub, "edit") || !strcmp(sub, "write") || !strcmp(sub, "edits")) && argc > a + 2 && !strchr(argv[a + 2], '\t') && !strchr(argv[a + 2], '\n')) {
                unsigned char *fb = 0; int64_t fn = 0; char hx[65] = "-";
                if (!sy_read_file(argv[a + 2], &fb, &fn, 1L << 27)) (void)sy_sha256_hex(fb ? (const void *)fb : (const void *)"", (long)fn, hx);
                free(fb); F(fx, sizeof fx, "\tpath=%.512s\tsha=%s", argv[a + 2], hx);
            }
            if (snprintf(rq, sizeof rq, "emit\t%s.%s\towner=%s\tpid=%d\trc=%d\tms=%ld%s", argv[a], sub, auto_owner(), sy_pid(), r, sy_now_ms() - t0, fx) < (int)sizeof rq) request(root, rq, 0);
        }
    }
    if (!ovf && r == 0 && argc > a + 2) {   /* 写入或提交涉及 cx-dev 的表输入:确保有一个事件预建进程在(见 cxdev_kick;实例不在也拉起,那时只靠它自己的指纹轮询) */
        char root[PW]; int i;
        if (sy_cwd(root, sizeof root) >= 0) {
            if (!strcmp(argv[a], "f") && (!strcmp(argv[a + 1], "edit") || !strcmp(argv[a + 1], "write") || !strcmp(argv[a + 1], "edits"))) cxdev_kick(root, argv[a + 2]);
            else if (!strcmp(argv[a], "git") && !strcmp(argv[a + 1], "commit") && !flag(argc, argv, "--cwd") && !getenv("DEVSVC_GIT_PARSE_ONLY")) { for (i = a + 2; i < argc; i++) if (cxdev_kick(root, argv[i])) break; }
        }
    }
    if(!last_job[0])report_end(report_kind,"");
    if (ovf && r == 0) r = 2;
    if (!in_bg && !last_job[0] && cv_is_git_commit && !cv_skip_verdict) commit_result_emit("-", r);
    if (ovf) { fprintf(stderr, "devsvc: a path or argument did not fit its buffer (%d)\n", ovf); return 2; }
    return r;
}
static int main2(int argc, char **argv) {
    char root[PW], req[2048]; const char *cmd; int a = 1;
    if (argc > 1 && !strcmp(argv[1], "--")) a = 2;
    if (argc <= a) return usage();
    cmd = argv[a]; argc -= a + 1; argv += a + 1;
    cv_is_git_commit = (!strcmp(cmd, "git") && argc >= 1 && !strcmp(argv[0], "commit")) ? 1 : 0;
    cv_skip_verdict = 0;
    if (sy_cwd(root, sizeof root) < 0) return 3;
    {   int cr = cfg_load(root);
        if (cr) { fprintf(stderr, "devsvc: repo table %s %s\n", cfg.table, cr == -1 ? "unreadable" : "malformed (missing or duplicate key, or lib rows != 3)"); return 3; } }
    if (!strcmp(cmd, "config")) {
        int i;
        printf("CFG\tproduct\t%s\nCFG\tself\t%s\n", cfg.product, cfg.self);
        for (i = 0; i < 3; i++) printf("CFG\tlib\t%s\n", cfg.lib[i]);
        printf("CFG\tonchange\t%s\nCFG\tonchange_tag\t%s\nCFG\tproc_pat\t%s\nCFG\tcache_sub\t%s\nCFG\tinst_env\t%s\n", cfg.onchange, cfg.onchange_tag, cfg.proc_pat, cfg.cache_sub, cfg.inst_env);
        for (i = 0; i < cfg.nlockname; i++) printf("CFG\tlock\t%s\n", cfg.lockname[i]);
        /* 以下为后加的行种;CFG lock 行与末行前两个字段保持原样,旧消费者不受影响 */
        for (i = 0; i < cfg.nlockname; i++) printf("CFG\tlockdomain\t%s\t%s\n", cfg.lockname[i], cfg.lockpfx[i][0] ? cfg.lockpfx[i] : "-");
        for (i = 0; i < cfg.ndoc; i++) printf("CFG\tdoc\t%s\n", cfg.docpat[i]);
        printf("CFG\ttable\t%s\tsource=%s\trev=%s\tsha256=%s\n", cfg.table, cfg.tabsrc, cfg.tabrev, cfg.tabsha);
        {   /* 非独立 .cx 的编译上下文表(cxlib.flowfile ff_ctx_lookup 的同一份表):每个数据行原样带前缀输出 */
            char cp[PW]; unsigned char *cb = 0; int64_t cn = 0, s0 = 0, k; int nctx = 0;
            if (snprintf(cp, sizeof cp, "%s/build/devsvc-compile-context.tsv", root) < (int)sizeof cp && !sy_read_file(cp, &cb, &cn, 1 << 20) && cb) {
                for (k = 0; k <= cn; k++) if (k == cn || cb[k] == '\n') {
                    if (k > s0 && cb[s0] != '#') { printf("CFG\tcompilectx\t%.*s\n", (int)(k - s0), (const char *)cb + s0); nctx++; }
                    s0 = k + 1;
                }
                free(cb);
            }
            printf("CFG\tcompilectx_table\tbuild/devsvc-compile-context.tsv\trows=%d\n", nctx);
        }
        printf("DEVSVC_CONFIG\ttable=%s\tlocks=%d\tdocs=%d\tsource=%s\trev=%s\tsha256=%s\n", cfg.table, cfg.nlockname, cfg.ndoc, cfg.tabsrc, cfg.tabrev, cfg.tabsha);
        return 0;
    }
    if (!strcmp(cmd, "git") && argc >= 1 && !strcmp(argv[0], "commit") &&
            !getenv("DEVSVC_GIT_PARSE_ONLY") && git_foreign_worktree(root,opt(argc,argv,"--cwd",0))) {
        fprintf(stderr,"GIT_COMMIT_REFUSE\treason=foreign-worktree\n");
        return 2;
    }
    if (inst_dir()) { fprintf(stderr, "devsvc: cannot resolve instance directory\n"); return 3; }
    if(!strcmp(cmd,"timing")){
        char *v[14]={"--quiet","tools/dvtiming.cx",(char*)dir};if(argc>10)return 2;
        for(int i=0;i<argc;i++)v[3+i]=argv[i];v[3+argc]=0;return cmd_run(root,3+argc,v);
    }
    if (!strcmp(cmd, "git") && argc >= 2 && !strcmp(argv[0], "commit") && !strcmp(argv[1], "--status")) {
        if (argc <= 3) { cv_skip_verdict = 1; return commit_status(root, argc == 3 ? argv[2] : 0); }
        return 2;
    }
    if(!strcmp(cmd,"git") && argc && !strcmp(argv[0],"commit")){report_kind="git.commit";report_window=FL_NODE_MS;}
    if(!strcmp(cmd,"flow") || !strcmp(cmd,"x") || (!strcmp(cmd,"git") && argc && !strcmp(argv[0],"commit")))
        dt_command(!strcmp(cmd,"git")?"git.commit":cmd,root,argc,argv);
    if (!strcmp(cmd, "git") && argc >= 2 && argc <= 56 && !strcmp(argv[0], "commit") && flag(argc, argv, "--untrack")) {   /* commit --untrack PATH:tools/dvgitx.cx 私有索引停跟踪,工作副本不动 */
        char *v[64]; int n = 0; v[n++] = "--quiet"; v[n++] = "tools/dvgitx.cx"; v[n++] = (char *)root; v[n++] = "untrack";
        for (int i = 1; i < argc; i++) v[n++] = argv[i];
        v[n] = 0; return cmd_run(root, n, v);
    }
    if (!strcmp(cmd, "git") && argc >= 1 && argc <= 56 && !strcmp(argv[0], "worktree")) {   /* git worktree add|remove|list:tools/dvgitx.cx,只许 .claude/worktrees/v0.0.NN */
        char *v[64]; int n = 0; v[n++] = "--quiet"; v[n++] = "tools/dvgitx.cx"; v[n++] = (char *)root;
        for (int i = 0; i < argc; i++) v[n++] = argv[i];
        v[n] = 0; return cmd_run(root, n, v);
    }
    if (!strcmp(cmd, "qualify") && argc <= 56) {   /* qualify --candidate APE [--set ..] [--out F] [--jobs N]:tools/dvqualify.cx,timing 事件经 DEVSVC_SOCK */
        if(!flag(argc,argv,"--list")){
            int cg = chain_admission_gate(root, opt(argc, argv, "--owner", getenv("DEVSVC_OWNER")), 0);
            if (cg) return cg;
            report_kind="qualify";report_window=1800000;
        }
        char *v[64]; int n = 0; v[n++] = "--quiet"; v[n++] = "tools/dvqualify.cx"; v[n++] = (char *)root;
        if(!strcmp(sy_env_or("DEVSVC_S2_SHADOW",""),"1"))v[1]=S2_TOOL;
        for (int i = 0; i < argc; i++) v[n++] = argv[i];
        v[n] = 0; setenv("DEVSVC_SOCK", sockp, 1); run_deadline_ms = 1800000; return cmd_run(root, n, v);
    }
    if (!strcmp(cmd, "f") && argc >= 1 && argc <= 56 && !strcmp(argv[0], "append")) {   /* f append PATH (--from F | --line T) [--expect-sha X]:tools/dvfile.cx */
        if (shared_checkout_write_gate(root, 1, "F", "append", argc >= 2 ? argv[1] : "", argc, argv)) return 1;
        char *v[64]; int n = 0; v[n++] = "--quiet"; v[n++] = "tools/dvfile.cx"; v[n++] = (char *)root;
        for (int i = 0; i < argc; i++) v[n++] = argv[i];
        v[n] = 0; return cmd_run(root, n, v);
    }
    if (!strcmp(cmd, "git") && argc >= 1 && !strcmp(argv[0], "commit") && git_commit_check(argc, argv)) { git_argerr = 1; return usage(); }   /* git_argerr:完成事件记 class=args */
    if (!strcmp(cmd, "git") && argc >= 1 && !strcmp(argv[0], "commit") && !getenv("DEVSVC_GIT_PARSE_ONLY") &&
        shared_checkout_git_commit_gate(root, argc, argv)) return 1;
    if (!strcmp(cmd, "git") && argc >= 1 && !strcmp(argv[0], "commit") && !in_bg && !flag(argc, argv, "--bg") && !getenv("DEVSVC_GIT_PARSE_ONLY")) {
        bg_defer_job_line = 1;
        int r = bg_launch(root, cmd, argc + a + 1, argv - (a + 1), 0);
        bg_defer_job_line = 0;
        return r ? r : commit_follow(root, last_job);
    }
    {   int bp;
        if (bg_strip(cmd, argc, argv, &bp)) {
            int r = bg_launch(root, cmd, argc + a + 1, argv - (a + 1), argv + bp);
            if (r == 0 && cv_is_git_commit) {
                printf("COMMIT_PENDING\tjob=%s\tNOT_COMMITTED_YET\n", last_job);
                printf("COMMIT_RESULT\tNOT_COMMITTED\treason=running\tjob=%s\n", last_job);
            }
            return r;
        }
    }
    if (!strcmp(cmd, "wait")) return cmd_wait(argc, argv);
    if (!strcmp(cmd, "jobs")) return cmd_jobs();
    if (!strcmp(cmd, "serve")) return serve(atol(opt(argc, argv, "--ttl", "1800")), atol(opt(argc, argv, "--idle", "300")));
    if (!strcmp(cmd, "start")) {
        int c = try_connect(1000);
        if (c >= 0) { sy_close(c); printf("OK\talready\t%s\n", sockp); return 0; }
        if (c == -ECONNREFUSED) sy_unlink(sockp);
        if (atol(opt(argc, argv, "--ttl", "1800")) <= 0 || atol(opt(argc, argv, "--ttl", "1800")) > TTL_MAX || atol(opt(argc, argv, "--idle", "300")) <= 0) return usage();
        c = spawn_server(root, opt(argc, argv, "--ttl", "1800"), opt(argc, argv, "--idle", "300"));
        if (c < 0) { fprintf(stderr, "devsvc: instance did not come up within 40 s\n"); return 3; }
        sy_close(c); printf("OK\tstarted\t%s\n", sockp); return 0;
    }
    if (!strcmp(cmd, "ping") || !strcmp(cmd, "stop")) return say(request(root, cmd, 0));
    if (!strcmp(cmd, "status")) return cmd_status(root, argc > 0 && !strcmp(argv[0], "--paths"));
    if (!strcmp(cmd, "rel")) return cmd_rel(root, argc, argv);
    if (!strcmp(cmd, "run")) { for(int k=0;k<argc && argv[k][0]!='\0';k++){
        if(argv[k][0]=='-')continue;
        if(report_tool(argv[k])){report_kind="run";report_window=run_deadline_ms;}break;
    } int r = cmd_run(root, argc, argv); return r == 2 && argc < 1 ? usage() : r; }
    if (!strcmp(cmd, "doc")) {
        int r = cmd_doc(root, argc, argv);
        if (r == 2 && !ovf) fprintf(stderr, "devsvc: bad doc arguments: doc get|set|append|remove|list|mermaid|repair FILE SECTION [k=v|k@=PATH ...] [--from F] [--body] [--expect-sha X]  (a '/' inside a title is written %%2F, '%%' as %%25)\n");
        return r;
    }
    if (!strcmp(cmd, "task")) {   /* 工单转 tools/devtask.cx task ...;参数、具名拒绝与各子命令 --help 由 devtask 给出 */
        char *v[64]; int n = 0, i;
        if (argc > 58) { fprintf(stderr, "devsvc: task: too many arguments (%d, max 58)\n", argc); return 2; }
        v[n++] = "--quiet"; v[n++] = "tools/devtask.cx"; v[n++] = "task";
        for (i = 0; i < argc; i++) v[n++] = argv[i];
        v[n] = 0;
        return cmd_run(root, n, v);
    }
    if (!strcmp(cmd, "react")) {
        char *v[24]; int n=0;
        if (argc < 1 || argc > 17) return 2;
        v[n++]="--quiet"; v[n++]="tools/dvreact.cx"; v[n++]="--service"; v[n++]=dir;
        for(int i=0;i<argc;i++) v[n++]=argv[i];
        v[n]=0; return cmd_run(root,n,v);
    }
    if (!strcmp(cmd, "product-map")) {
        char *v[64];int n=0;if(argc>58){fprintf(stderr,"devsvc: product-map: too many arguments\n");return 2;}
        v[n++]="--quiet";v[n++]="tools/product-map-query.cx";
        for(int i=0;i<argc;i++)v[n++]=argv[i];v[n]=0;
        return cmd_run(root,n,v);
    }
    if (!strcmp(cmd, "search")) {   /* search PATTERN [PATH...] [选项]:cxlib.devsearch,有界只读文本搜索,不调外部 rg/grep;事件只记范围与计数不记命中内容 */
        ds_stats ds; char ev[400]; int r = ds_main(root, argc, argv, &ds);
        fflush(stdout);
        F(ev, sizeof ev, "search\tpattern_len=%d\tfiles=%ld\tmatches=%ld\ttruncated=%d\tms=%ld\trc=%d", argc > 0 ? (int)strlen(argv[0]) : 0, ds.files, ds.matches, ds.truncated, ds.ms, r);
        flow_emit(root, ev);
        return r;
    }
    if (!strcmp(cmd, "tool-index")) {   /* tool-index [选项]:转 tools/derived-query.cx tool-index,按内容身份现算现查工具索引(R1 试点) */
        char *v[64]; int n = 0, i;
        if (argc > 58) { fprintf(stderr, "devsvc: tool-index: too many arguments (%d, max 58)\n", argc); return 2; }
        v[n++] = "--quiet"; v[n++] = "tools/derived-query.cx"; v[n++] = "tool-index";
        for (i = 0; i < argc; i++) v[n++] = argv[i];
        v[n] = 0;
        return cmd_run(root, n, v);
    }
    if (!strcmp(cmd, "precheck")) {   /* precheck --files PATH...:转 tools/precommit.cx -- --precheck PATH...(plans/devsvc.md 6 P6),逐门判定与耗时,不动索引 */
        char *v[64]; int n = 0, i;
        if (argc < 2 || strcmp(argv[0], "--files")) { fprintf(stderr, "devsvc: usage: precheck --files PATH...\n"); return 2; }
        if (argc > 58) { fprintf(stderr, "devsvc: precheck: too many paths (%d, max 57)\n", argc - 1); return 2; }
        v[n++] = "--quiet"; v[n++] = "tools/precommit.cx"; v[n++] = "--precheck";
        for (i = 1; i < argc; i++) v[n++] = argv[i];
        v[n] = 0;
        return cmd_run(root, n, v);
    }
    if (!strcmp(cmd, "f") && argc >= 1 && (!strcmp(argv[0], "--help") || !strcmp(argv[0], "-h") || (argc >= 2 && (!strcmp(argv[1], "--help") || !strcmp(argv[1], "-h"))))) {
        printf("usage: devsvc f read PATH [OFF LIM]\n"
               "       devsvc f write PATH (--from SRC | --stdin) [--expect-sha X] [--mkdir]\n"
               "       devsvc f edit PATH --old-file A --new-file B [--expect-sha X] [--all] [--chomp]\n"
               "       devsvc f edits PATH --stdin [--sep S] [--sep-next S2] [--expect-sha X]   (stdin: old/new groups, each old exactly once, one atomic write)\n"
               "  required: op (read|write|edit|edits) and PATH (repo-relative or absolute); write needs --from SRC or --stdin; edit needs --old-file and --new-file\n"
               "  optional: OFF LIM (read: start line and line count), --expect-sha X (refuse unless current sha256 is X), --mkdir (create parent dirs),\n"
               "            --all (replace every match, default exactly one), --chomp (drop one trailing newline of A and B)\n"
               "  output: F<TAB>op<TAB>ok<TAB>sha=..<TAB>lines=..; bad arguments rc 2\n"
               "  example: devsvc f edit tools/x.cx --old-file /tmp/a --new-file /tmp/b --chomp\n");
        return 0;
    }
    if (!strcmp(cmd, "flow") || !strcmp(cmd, "x") || !strcmp(cmd, "f")) {
        request_x=!strcmp(cmd,"x");
        int r = cmd[0] == 'x' ? cmd_x(root, argc, argv) : cmd[1] ? cmd_flow(root, argc, argv) : cmd_f(root, argc, argv);
        if (r == 2 && !ovf && !x_ran) fprintf(stderr, "devsvc: bad %s arguments (see usage in the file header)\n", cmd);
        return r;
    }
    if (!strcmp(cmd, "git")) { int r = cmd_git(root, argc, argv); return r == 2 && git_argerr ? usage() : r; }   /* 只有参数解析错才贴 usage;已启动的 git 动作保留真实 rc 与诊断 */
    if (!strcmp(cmd, "register")) { if (freeze_refuse_if_held(root, argc, argv)) return 1; return tool_locked(root, "registry", "tools/register.cx", argc, argv); }
    if (!strcmp(cmd, "derive")) return cmd_derive(root, argc, argv);
    if (!strcmp(cmd, "lock") && argc >= 1) {
        char ow[64];
        if (!strcmp(argv[0], "list")) return say(request(root, "lock-list", 1));
        int is_freeze = argc >= 2 && !strcmp(argv[1], "freeze");
        if (argc < 2 || !okname(argv[1]) || !resolve_owner_raw(argc, argv, ow, sizeof ow, is_freeze)) {
            fprintf(stderr, "devsvc: REFUSE lock-args: need lock acquire|release NAME [--owner O] (NAME and O/DEVSVC_OWNER non-empty, under 64 bytes, no spaces)\n");
            return usage();
        }
        if (!strcmp(argv[0], "acquire")) {
            const char *lp = opt(argc, argv, "--pid", getenv("DEVSVC_LOCK_PID"));
            const char *def_ttl = is_freeze ? "7200" : "600";
            int bp = (lp && lp[0]) ? atoi(lp) : 0;
            if (bp > 0) { char pt[96]; pi_self_tag(bp, pt, sizeof pt); F(req, sizeof req, "lock-acquire\t%s\t%s\t%s\t%s", argv[1], ow, opt(argc, argv, "--ttl", def_ttl), pt); }
            else F(req, sizeof req, "lock-acquire\t%s\t%s\t%s", argv[1], ow, opt(argc, argv, "--ttl", def_ttl));
        }
        else if (!strcmp(argv[0], "release")) F(req, sizeof req, "lock-release\t%s\t%s", argv[1], ow);
        else { fprintf(stderr, "devsvc: REFUSE lock-args: unknown lock action %s (acquire|release|list)\n", argv[0]); return usage(); }
        return say(request(root, req, 1));
    }
    if (!strcmp(cmd, "branch")) {
        if (argc >= 1 && (!strcmp(argv[0], "--help") || !strcmp(argv[0], "-h"))) {
            printf("usage: devsvc branch create --owner OWNER --unit UNIT_ID [--base REF]\n"
                   "  note: DEVSVC_OWNER is caller-reported (cooperation guard, not a security boundary); missing or invalid owner is refused.\n");
            return 0;
        }
        if (argc < 1 || strcmp(argv[0], "create") != 0) {
            fprintf(stderr, "devsvc: REFUSE branch-args: use devsvc branch create --owner OWNER --unit UNIT_ID [--base REF]\n");
            return 2;
        }
        const char *req_ow = 0, *unit_id = 0, *base_ref = "HEAD";
        for (int i = 1; i < argc; i++) {
            if (!strcmp(argv[i], "--owner") && i + 1 < argc) req_ow = argv[++i];
            else if (!strcmp(argv[i], "--unit") && i + 1 < argc) unit_id = argv[++i];
            else if (!strcmp(argv[i], "--base") && i + 1 < argc) base_ref = argv[++i];
            else { fprintf(stderr, "devsvc: REFUSE branch-args: unknown arg %s\n", argv[i]); return 2; }
        }
        const char *env_ow = getenv("DEVSVC_OWNER");
        if (!req_ow || !req_ow[0]) req_ow = env_ow;
        if (!req_ow || !req_ow[0]) {
            fprintf(stderr, "devsvc: REFUSE branch-missing-owner: --owner or DEVSVC_OWNER required\n");
            return 2;
        }
        if (!unit_id || !unit_id[0]) {
            fprintf(stderr, "devsvc: REFUSE branch-args: --unit required\n");
            return 2;
        }
        if (strchr(req_ow, '\t') || strchr(req_ow, '\n') || strchr(unit_id, '\t') || strchr(unit_id, '\n') ||
            strchr(base_ref, '\t') || strchr(base_ref, '\n') || (env_ow && (strchr(env_ow, '\t') || strchr(env_ow, '\n')))) {
            fprintf(stderr, "devsvc: REFUSE branch-args: control chars disallowed\n");
            return 2;
        }
        F(req, sizeof req, "branch-create\t%s\t%s\t%s\t%s", req_ow, unit_id, (env_ow && env_ow[0]) ? env_ow : "-", base_ref);
        int rrc = request(main_root[0] ? main_root : root, req, 1);
        if (rrc == 0) {
            fputs(resp, stdout);
            return 0;
        }
        if (!strncmp(resp, "ERR\t", 4)) fprintf(stderr, "devsvc: REFUSE %s", resp + 4);
        else fprintf(stderr, "devsvc: branch create failed rc=%d\n", rrc);
        return 1;
    }
    if (!strcmp(cmd, "accept-tree")) {
        if (argc >= 1 && (!strcmp(argv[0], "--help") || !strcmp(argv[0], "-h"))) {
            printf("usage: devsvc accept-tree [create] --commit REV [--owner REVIEWER] [--ttl SEC]\n"
                   "       devsvc accept-tree list\n"
                   "       devsvc accept-tree remove ID_OR_PATH\n"
                   "  note: DEVSVC_OWNER is caller-reported (cooperation guard, not a security boundary); missing or invalid owner is refused.\n"
                   "  note: readonly=dac-guarded means guarded entry refuses writes and files/dirs are 0444/0555 (same-UID can undo); expired trees are cleaned on sweep and at service start.\n");
            return 0;
        }
        if (argc >= 1 && !strcmp(argv[0], "list")) {
            int rrc = request(main_root[0] ? main_root : root, "accept-list", 1);
            return say(rrc);
        }
        if (argc >= 2 && !strcmp(argv[0], "remove")) {
            const char *target = argv[1], *ow = getenv("DEVSVC_OWNER");
            for (int i = 2; i < argc; i++) {
                if (!strcmp(argv[i], "--owner") && i + 1 < argc) ow = argv[++i];
                else { fprintf(stderr, "devsvc: REFUSE accept-tree-args: unknown arg %s\n", argv[i]); return 2; }
            }
            if (!ow || !ow[0]) {
                fprintf(stderr, "devsvc: REFUSE accept-missing-owner: --owner or DEVSVC_OWNER required\n");
                return 2;
            }
            if (strchr(target, '\t') || strchr(target, '\n') || strchr(ow, '\t') || strchr(ow, '\n')) {
                fprintf(stderr, "devsvc: REFUSE accept-tree-args: control chars disallowed\n");
                return 2;
            }
            F(req, sizeof req, "accept-remove\t%s\t%s", target, ow);
            int rrc = request(main_root[0] ? main_root : root, req, 1);
            if (rrc == 0) { fputs(resp, stdout); return 0; }
            if (!strncmp(resp, "ERR\t", 4)) fprintf(stderr, "devsvc: REFUSE %s", resp + 4);
            return 1;
        }
        int start = (argc >= 1 && !strcmp(argv[0], "create")) ? 1 : 0;
        const char *rev = 0, *ttl = "1800", *ow = getenv("DEVSVC_OWNER");
        for (int i = start; i < argc; i++) {
            if (!strcmp(argv[i], "--commit") && i + 1 < argc) rev = argv[++i];
            else if (!strcmp(argv[i], "--ttl") && i + 1 < argc) ttl = argv[++i];
            else if (!strcmp(argv[i], "--owner") && i + 1 < argc) ow = argv[++i];
            else { fprintf(stderr, "devsvc: REFUSE accept-tree-args: unknown arg %s\n", argv[i]); return 2; }
        }
        if (!rev || !rev[0]) {
            fprintf(stderr, "devsvc: REFUSE accept-tree-args: --commit REV required\n");
            return 2;
        }
        if (!ow || !ow[0]) {
            fprintf(stderr, "devsvc: REFUSE accept-missing-owner: --owner or DEVSVC_OWNER required\n");
            return 2;
        }
        if (strchr(rev, '\t') || strchr(rev, '\n') || strchr(ttl, '\t') || strchr(ow, '\t') || strchr(ow, '\n')) {
            fprintf(stderr, "devsvc: REFUSE accept-tree-args: control chars disallowed\n");
            return 2;
        }
        F(req, sizeof req, "accept-create\t%s\t%s\t%s", ow, rev, ttl);
        int rrc = request(main_root[0] ? main_root : root, req, 1);
        if (rrc == 0) { fputs(resp, stdout); return 0; }
        if (!strncmp(resp, "ERR\t", 4)) fprintf(stderr, "devsvc: REFUSE %s", resp + 4);
        else fprintf(stderr, "devsvc: accept-tree create failed rc=%d\n", rrc);
        return 1;
    }
    if (!strcmp(cmd, "events")) {
        if (argc >= 1 && !strcmp(argv[0], "emit")) {
            if (argc < 3 || !okname(argv[1])) { fprintf(stderr, "devsvc: REFUSE events-args: events emit KIND TEXT needs a KIND name (no spaces, under 64 bytes) and a TEXT argument\n"); return usage(); }
            {   long tn = (long)strlen(argv[2]); int tw = (int)(tn > EVW - 80 ? u8c_floor(argv[2], tn, EVW - 80) : tn);   /* cut on a character */
                F(req, sizeof req, "emit\t%s\t%.*s", argv[1], tw, argv[2]); }
            {   char *t = strchr(req + 5, '\t'); if (t) { char *q; for (q = t + 1; *q; q++) if (*q == '\n' || *q == '\r') *q = ' '; } }
            return say(request(root, req, 1));
        }
        if (argc >= 1 && !strcmp(argv[0], "on-change")) return cmd_onchange(root, argc - 1, argv + 1);
        if (argc >= 2 && !strcmp(argv[0], "--wait")) return events_wait(root, argv[1], numarg(opt(argc, argv, "--since", "x")), numarg(opt(argc, argv, "--timeout-ms", "50000")));
        F(req, sizeof req, "events\t%ld", atol(opt(argc, argv, "--since", "0")));
        return say(request(root, req, 1));
    }
    fprintf(stderr, "devsvc: REFUSE unknown-command: %s is not a devsvc command (usage below)\n", cmd);
    return usage();
}
