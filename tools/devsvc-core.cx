static void recover_landed_index(const char *wd, const char *base, const char *landed) {
    static char dt[1 << 16];
    char *dv[] = {"git", "-C", (char *)wd, "diff-tree", "--no-commit-id", "-r", (char *)base, (char *)landed, 0};
    if (runcap(dv, dt, sizeof dt) != 0) return;
    for (char *s = dt, *e; *s; s = e ? e + 1 : s + strlen(s)) {
        e = strchr(s, '\n');
        if (e) *e = 0;
        if (s[0] != ':') continue;
        char *tab = strchr(s, '\t');
        if (!tab || !tab[1]) continue;
        *tab = 0;
        const char *path = tab + 1;
        char o_mode[16] = "", n_mode[16] = "", o_sha[64] = "", n_sha[64] = "", st_ch[16] = "";
        if (sscanf(s + 1, "%15s %15s %63s %63s %15s", o_mode, n_mode, o_sha, n_sha, st_ch) != 5) continue;
        if (!strcmp(n_mode, "000000") || st_ch[0] == 'D') {
            char fpath[PW], ubuf[256];
            if (snprintf(fpath, sizeof fpath, "%s/%s", wd, path) < (int)sizeof fpath && sy_exists(fpath) == 0) {
                char *uv[] = {"git", "-C", (char *)wd, "update-index", "--force-remove", "--", (char *)path, 0};
                (void)runcap(uv, ubuf, sizeof ubuf);
            }
            continue;
        }
        if (!git_full_oid(n_sha)) continue;
        char ws[128] = "", cinfo[PW + 80], ubuf[256];
        char *hv[] = {"git", "-C", (char *)wd, "hash-object", "--no-filters", "--", (char *)path, 0};
        if (runcap(hv, ws, sizeof ws) != 0) continue;
        chomp(ws);
        if (strcmp(ws, n_sha) != 0) continue;
        if (snprintf(cinfo, sizeof cinfo, "%s,%s,%s", n_mode, n_sha, path) >= (int)sizeof cinfo) continue;
        char *uv[] = {"git", "-C", (char *)wd, "update-index", "--add", "--cacheinfo", cinfo, 0};
        (void)runcap(uv, ubuf, sizeof ubuf);
    }
}
static int git_push_owned_ex(const char *root, const char *cwd, int count, char **commits,
                             int nranges, char ranges[][84], int from_receipt, int carry_merge) {
    const char *work=cwd?cwd:root,*cache;
    char worker[PW],sync[PW],prod[PW],timeout[20],stop[32],scope[65],*args[FL_MAX_ARGV];
    long ms;
    int n=0;
    int64_t start=sy_mono_ns();
    int scoped = carry_merge && merge_owner_key(scope);
    if(count<1||count+2*nranges+from_receipt+16+2*scoped>=FL_MAX_ARGV||start<0)return 2;
    for(int i=0;i<count;i++)if(!git_full_oid(commits[i]))return 2;
    int64_t deadline=start+55000000000LL;
    push_prep_deadline=deadline;
    int error=native_get(work,"tools/commit-own.cx",worker,sizeof worker,&cache,&ms);
    if(!error)error=native_get(work,"tools/gitsync-run.cx",sync,sizeof sync,&cache,&ms);
    push_prep_deadline=0;
    if(error) {
        fprintf(stderr,"GIT_PUSH_REFUSE\treason=%s\tlog=%s\n",
                error==-ETIMEDOUT?"deadline":"worker-build",nlog[0]?nlog:"-");
        return 1;
    }
    int64_t now=sy_mono_ns();
    long left=(long)((deadline-now)/1000000LL);
    if(now<0||left<2000) {
        fprintf(stderr,"GIT_PUSH_REFUSE\treason=replay-deadline\n");
        return 1;
    }
    F(timeout,sizeof timeout,"%ld",left);
    F(stop,sizeof stop,"%lld",(long long)deadline);
    F(prod,sizeof prod,"%s/%s",root,cfg.product);
    if(ovf)return 2;
    args[n++]="--par";args[n++]="1";args[n++]="--light";args[n++]="--timeout-ms";args[n++]=timeout;
    if(cwd){args[n++]="--cwd";args[n++]=(char *)cwd;}
    args[n++]="--";args[n++]="sh";args[n++]=prod;args[n++]="tools/push-replay.cx";args[n++]="--";
    args[n++]=(char *)work;args[n++]=worker;args[n++]=sync;args[n++]=stop;
    if (scoped) { args[n++] = "--merge-owner"; args[n++] = scope; }
    if (from_receipt) args[n++] = "--from-receipt";
    for(int i=0;i<nranges;i++){args[n++]="--range";args[n++]=ranges[i];}
    for(int i=0;i<count;i++)args[n++]=commits[i];
    args[n]=0;
    x_last_out[0]=0;
    return cmd_x(root,n,args);
}
static int git_push_owned(const char *root, const char *cwd, int count, char **commits, int carry_merge) {
    return git_push_owned_ex(root, cwd, count, commits, 0, 0, 0, carry_merge);
}
static int shared_checkout_git_commit_gate(const char *root, int argc, char **argv) {
    char wcwd[PW];
    const char *froot = root;
    int i, pmode = 0;
    for (i = 1; i < argc; i++) {
        if (!strcmp(argv[i], "--cwd") && i + 1 < argc) {
            const char *d = argv[++i];
            if (d[0] == '/') {
                if (cx_fmt(wcwd, sizeof wcwd, "%s", d)) wcwd[0] = 0;
            } else {
                if (cx_fmt(wcwd, sizeof wcwd, "%s/%s", root, d)) wcwd[0] = 0;
            }
            froot = wcwd;
        }
    }
    if (shared_checkout_write_gate(froot, 0, "GIT", "commit", ".git-commit-target", argc, argv)) return 1;
    for (i = 1; i < argc; i++) {
        const char *a = argv[i];
        if (!strcmp(a, "--cwd") || !strcmp(a, "--owner") || !strcmp(a, "-m")) { i++; continue; }
        if (!strcmp(a, "--registered") || !strcmp(a, "--new-tool") || !strcmp(a, "--batch") || !strcmp(a, "--merge-continue")) {
            pmode = 0; continue;
        }
        if (!strcmp(a, "--whole") || !strcmp(a, "--staged")) { pmode = 1; continue; }
        if (!strcmp(a, "--keyed")) { pmode = 2; continue; }
        if (a[0] == '-') continue;
        if (pmode == 1 || pmode == 2) {
            if (shared_checkout_write_gate(froot, 0, "GIT", "commit", a, argc, argv)) return 1;
            if (pmode == 2) pmode = 3;
        } else if (pmode == 3) {
            pmode = 0;
        }
    }
    return 0;
}
static int cmd_git(const char *root, int argc, char **argv) {
