                const char *d = argv[++j];
                if (d[0] == '/') F(tmp_cwd, sizeof tmp_cwd, "%s", d); else F(tmp_cwd, sizeof tmp_cwd, "%s/%s", root, d);
                if (!realpath(tmp_cwd, cwd_buf)) { fprintf(stderr, "GIT_PUSH_REFUSE\treason=bad-cwd\tcwd=%s\n", d); return 2; }
