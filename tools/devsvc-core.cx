/* tools/devsvc.cx -- 仓开发服务(基础版):一个仓一个实例的有界常驻服务,加同一文件里的 CLI 客户端。
 * 批次 devsvc(tools/check-devsvc.cx)。设计稿 plans/devsvc.md。本仓配置表 tools/devsvc-repo.tsv(或 $DEVSVC_REPO_TABLE)。
 *
 *   sh ./unisacc.com tools/devsvc.cx -- config                         打印所读配置表(CFG 行含 lock、lockdomain 写域、doc 规则、table 身份,末行 DEVSVC_CONFIG);表缺失或缺键 rc 3
 *   sh ./unisacc.com tools/devsvc.cx -- start [--ttl S] [--idle S]     起实例(已在则报 already);默认 ttl 1800 s、idle 300 s
 *   sh ./unisacc.com tools/devsvc.cx -- ping | stop
 *   sh ./unisacc.com tools/devsvc.cx -- lock acquire NAME --owner O [--ttl S]   (默认 600 s,上限 3600 s;同属主再拿即续期)
 *   sh ./unisacc.com tools/devsvc.cx -- lock release NAME --owner O
 *   sh ./unisacc.com tools/devsvc.cx -- lock list
 *   sh ./unisacc.com tools/devsvc.cx -- run [--local] TOOL.cx [ARGS...]   用缓存的原生执行体跑已有工具;stdout/rc 即工具自己的
 *   sh ./unisacc.com tools/devsvc.cx -- events [--since N]             事件环(容量 256);N 为上次见到的 seq
 *   sh ./unisacc.com tools/devsvc.cx -- events emit KIND TEXT
 *   事件同时追加到实例目录 events.tsv(EV seq ts kind text;超 $DEVSVC_EV_ROTATE 字节,缺省 4 MB,轮转为 events.tsv.1);
 *   f/x/flow/doc/git/run/register/derive 命令结束各记一条 <命令>.<子命令> owner pid rc ms。owner 依次取 $DEVSVC_OWNER、
 *   $CLAUDE_JOB_ID(至多 40 字节字母数字连字符,否则丢弃)、有 $TMUX 时 pane-<$TMUX_PANE 数字>、auto-<pid>;各窗口(cc、cdx、子代理)应设 $DEVSVC_OWNER。
 *   追加字段(旧列不动):x.git/x.gh 带 sub=<第一个非选项参数>;git.commit 带 class=ok|timeout|args|<COMMIT_OWN_FAIL 类别>|other。
 *   f write|edit|edits 的这条事件另带 path= 与写后 sha=。成功的 f 写入或 git commit 涉及 exec/、seed/ 下的路径,且本检出已构造过
 *   cx-dev bundle 而没有在跑的 `cx-dev --watch` 时,后台拉起一个事件预建进程(不阻塞本命令;记事件 cxdev.watch;$DEVSVC_CXDEV_WATCH=0 关闭;见 cxdev_kick)。
 *   sh ./unisacc.com tools/devsvc.cx -- git log|diff|show|status ARGS|blame|ls-files ...   只读透传,不取锁,stdout 上限 1 MB 超出打 DEVSVC_TRUNCATED
 *   sh ./unisacc.com tools/devsvc.cx -- events on-change PATH...       只读接入:跑 on-change --dry-run,把 ON_CHANGE 行入环
 *   sh ./unisacc.com tools/devsvc.cx -- status [--paths]               各工作目录未提交数、在途进程、实例与锁(不拉起实例)
 *   sh ./unisacc.com tools/devsvc.cx -- tool-index [--sha] [--key] [--cache DIR] [--timeout-ms N]   工具索引按内容身份现查(转 tools/derived-query.cx):
 *     正文到 stdout,结果行 DQ tool-index hit|miss|recovered key= sha= 到 stderr;缓存 ~/.cache/unisacc/derived/tool-index/<key>.tsv,损坏即删并现算
 *   sh ./unisacc.com tools/devsvc.cx -- serve [--ttl S] [--idle S]     前台跑服务循环(start 即后台起它)
 *   sh ./unisacc.com tools/devsvc.cx -- flow run FILE.tsv|- --par N [--deadline-ms N] [--cat] [--run DIR] [--owner O] [--lock-wait-ms N]
 *   sh ./unisacc.com tools/devsvc.cx -- flow - [同上选项]             从 stdin 读节点表(格式见 tools/cxlib/flowexec.cx 头注:id op deps args)
 *   flow 加 --txn(或节点表里一行 `txn 1`):事务化,全部 file.*、doc.* 写节点先暂存不落盘,锁按名排序一次取齐(含写路径所属共享表锁),
 *     整组试编(被写 .cx 加直接消费者,`txn_consumers N` 设上限)、登记表成对校验、磁盘未被他人改动全过才逐文件原子落盘,否则整组不落盘;
 *     结果行 `NODE TXN ok|fail ... FLOW_TXN committed ...|TXN_ABORT reason= node= path= ...`,明细在 RUN/out/TXN.out
 *   sh ./unisacc.com tools/devsvc.cx -- f read PATH [OFF LIM]          内容到 stdout,结果行 F read ok sha= lines= bytes= 到 stderr
 *   sh ./unisacc.com tools/devsvc.cx -- f write PATH --from SRC [--expect-sha X] [--mkdir] [--owner O] [--lock-wait-ms N]
 *   sh ./unisacc.com tools/devsvc.cx -- f edit PATH --old-file A --new-file B [--expect-sha X] [--all] [--chomp]   (--chomp:两文件各去掉末尾一个换行)
 *   flow 与 x 必须显式 --par N(1..32,单节点也写;flow 可在节点表写一行 `par N`,命令行优先),缺省 rc 2 REFUSE missing --par
 *   sh ./unisacc.com tools/devsvc.cx -- x --par N [--timeout-ms N] [--cwd D] -- ARGV...   单条命令:stdout/stderr 原样转出,结果行 X 到 stderr,退出码即命令的
 *   x|flow|wait 输出控制:--tail N、--head N、--grep S(固定串,可多次,行级或)、--summary(每节点一行 SUM id rc ms lines first);
 *     任一给出即合并 stdout/stderr 过滤,全量落 run 目录 full.out(wait 为作业 out),略去行时打 DEVSVC_TRIMMED shown=N total=M,末行 OUT=路径;不给时行为不变
 *   x|flow|git commit|register|derive 加 --bg:立即打印 JOB id run=DIR(实例目录 jobs/<id>/),作业在独立会话跑,deadline 与锁照旧,结束记 job.done
 *   sh ./unisacc.com tools/devsvc.cx -- wait JOB [--timeout-ms N]      等作业(默认 50000,上限 55000):结束打输出尾部(至多 8 KB)与 JOB_DONE,rc 即作业的;超时 WAIT_TIMEOUT rc 124,不杀作业
 *   sh ./unisacc.com tools/devsvc.cx -- jobs                           列在途与最近 30 个作业
 *   sh ./unisacc.com tools/devsvc.cx -- events --wait KIND [--since SEQ] [--timeout-ms N]   阻塞等某类事件(缺省只等新事件),超时 rc 124
 *
 * flow/f/x:引擎(cxlib.flowexec、cxlib.flowfile)在客户端进程里跑,服务提供锁与事件环;这三个子命令不拉起实例,无实例时照跑但不取锁、
 *   不入环(汇总行 via=local)。flow 输出每节点一行 `NODE id 状态 rc= ms= 摘要 [sha=]`,末行 DEVSVC_FLOW(含 wall_ms、peak、via、locks、run=RUN 目录);
 *   --cat 把各节点 out/err 内容接在 NODE 行后。节点输出文件在 RUN/out/<id>.out|.err。节点事件在流结束后逐条以 flow.node 入环(字段同 EVT 行)。
 *   写锁:file.write、file.edit 节点(或带 lock= 键的任意节点)在开跑前向服务取锁,属主缺省 flow-<pid>,跑完即放;锁名为 lock 键或 path
 *   (在仓根下取相对段;含空白或 64 字节以上时为 sha: 加摘要前 16 位)。被他人持有时拒绝(rc 1,什么都不跑),--lock-wait-ms 内每 100 ms 重试。
 *   --owner 带入调用方已持有的锁名属主时只续期、不代放。客户端被杀则锁到 ttl(流截止加 10 s)自行过期。写根:$UNISACC_FLOW_ROOT,缺省当前目录。
 *   flow 退出码:0 全部 ok;1 有节点未 ok 或锁被拒;2 节点表被拒或参数错。x 超时为 124(整组 SIGKILL)。
 *
 * 实例目录:配置表 inst_env 所名环境变量(本仓 $UNISACC_DEVSVC_DIR),否则 $HOME/.cache/unisacc/devsvc/<sha256(git 公共目录绝对路径) 前 16 位>/,
 *   内有 sock(unix 域套接字)、pid、locks.tsv(锁落盘,实例重启后仍在)、native/<键>/<工具名>(原生执行体缓存)。
 *   所有版本工作目录共用一个实例(键取 git 公共目录)。
 * 有界:实例到 ttl(硬上限 7200 s)或连续 idle 秒无请求即自退并删 sock;不存在无界常驻。lock、run、events 在无实例时自动拉起;
 *   run --local 或拉起失败时本地构造并执行(同一缓存目录)。
 * 协议(一连接一请求):请求一行 TSV `verb<TAB>arg...<LF>`;响应首行 `OK<TAB>...` 或 `ERR<TAB>code<TAB>...`,其后载荷行,服务端关连接。
 *   verb:ping、stop、lock-acquire NAME OWNER TTL、lock-release NAME OWNER、lock-list、native ROOT TOOL、emit KIND TEXT、events SINCE。
 * 原生缓存键:工具源 sha256、产品真实路径与大小、ROOT 的 HEAD:cx HEAD:ext HEAD:tools/cxlib 树号、这三处 `git diff HEAD` 的 sha256。
 *   这三处有未跟踪文件或 diff 超 4 MiB 时不缓存(cache=bypass,每次重建),不拿可能过期的执行体冒充。
 * run 构造失败:应答 `ERR native TOOL rc= ms= log=完整日志路径`(rc -1000-N 即编译器退出码 N),其后 BUILD<TAB> 行是编译输出末段
 *   (至多 20 行、3000 字节);--local 时同样内容打到 stderr。日志留在缓存目录,下次构造同名工具时覆盖。
 * 已知限制(下一单):服务单线程,native 构造期间(冷最长 50 s)其它请求排队;事件环不落盘;status 不标路径归属;两个 start 同时清理
 *   陈旧 sock 有窄竞态。
 * 退出码:0 OK;1 服务答 ERR(如锁被他人持有);2 用法错;3 连不上实例;run 为工具自己的退出码(超 60 s 为 124)。
 * Check: tools/check-devsvc.cx(基础服务)、tools/check-devsvc-flow.cx(flow、f、x)。 */
#pragma unisa use net.unix
#pragma unisa use net.tcp
#pragma unisa use net.sock
#pragma unisa use sys.time
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.fd
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sys.sha
#pragma unisa use os.osx
#pragma unisa use sysx.process
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use cxlib.flowexec
#pragma unisa use dv.timing
#pragma unisa use dv.nativestat
#pragma unisa use dv.relmem
#pragma unisa use dv.procid
#pragma unisa use cxlib.flowfile
#pragma unisa use cxlib.flowdoc
#pragma unisa use sys.sigwatch

#define PW 1024
#define MAXLOCK 64
#define RING 256
#define EVW 512
#define TTL_MAX 7200
#define LOCK_TTL_MAX 3600

/* ---- 本仓配置层:仓专有知识只在配置表(ROOT/CFG_TABLE,或 $DEVSVC_REPO_TABLE 所指)里,核心(生命周期、锁、run、events)
   只经 cfg 读取。没有内置缺省:表缺失或缺键即拒绝(rc 3),不拿过期的缺省冒充。 ---- */
#define CFG_TABLE "tools/devsvc-repo.tsv"
#define CFG_LOCKS 16
typedef struct {
    char product[128];        /* 相对 ROOT 的产品入口:`sh ROOT/product SRC -o BIN` 构造,`sh ROOT/product SRC -- ARGS` 运行 */
    char self[128];           /* 本工具源,拉起实例用 */
    char lib[3][128];         /* 进原生缓存键的库源目录 */
    char onchange[128];       /* 事件来源工具 */
    char onchange_tag[64];    /* 其摘要行首词,后跟一个空格 */
    char proc_pat[128];       /* status 在途进程匹配串 */
    char cache_sub[128];      /* $HOME 下实例目录前缀 */
    char inst_env[64];        /* 指定实例目录的环境变量名 */
    char lockname[CFG_LOCKS][64]; int nlockname;   /* 约定锁名(协作约定,不强制) */
    char lockpfx[CFG_LOCKS][512];                  /* lock 行第三列:逗号分隔的写域,以 / 结尾为目录前缀,否则精确路径;- 或空为无 */
    char docpat[CFG_LOCKS][128]; int ndoc;         /* doc 行:devsvc doc 允许作用的文档(glob,* 不跨 /) */
    char table[1024];
    char tabsha[65];          /* 所读配置表全文的 sha256(config 输出的配置身份) */
    char tabsrc[16];          /* pinned(入口从 git 提交取出并交来的表)、env($DEVSVC_REPO_TABLE 所指)、worktree(ROOT 下工作区表) */
    char tabrev[48];          /* pinned 时为入口钉死的修订(提交号,读不出时为 HEAD);否则为 - */
} RepoCfg;
static RepoCfg cfg;
static int ovf;
static int cfg_set(char *dst, int cap, const char *v, long n) {
    if (n <= 0 || n >= cap) { ovf++; return 0; }
    if (mm_copy(dst, cap, v, n)) { ovf++; return 0; }
    dst[n] = 0; return 1;
}
/* 0 成功;-1 读不到表;-2 缺键、重复键或 lib 不是恰三行 */
static int cfg_load(const char *root) {
    unsigned char *b = 0; int64_t n = 0; char *s, *e, *end, *t, *t2; int nlib = 0, seen = 0, bad = 0; const char *ov = getenv("DEVSVC_REPO_TABLE");
    static const char *keys[] = {"product", "self", "onchange", "onchange_tag", "proc_pat", "cache_sub", "inst_env"};
    if (ov && *ov) { if (snprintf(cfg.table, sizeof cfg.table, "%s", ov) >= (int)sizeof cfg.table) return -1; }
    else if (snprintf(cfg.table, sizeof cfg.table, "%s/%s", root, CFG_TABLE) >= (int)sizeof cfg.table) return -1;
    if (sy_read_file(cfg.table, &b, &n, 1 << 16) || !b) return -1;
    /* 配置身份:内容 sha256 加来源。入口(tools/devsvc.cx)从 git 提交取表时经 DEVSVC_REPO_TABLE_PIN=<修订>:<表路径> 说明;
       只有其中路径与实际所读的表一致才认作 pinned,继承来的过期标记不冒充。 */
    {   const char *pin = getenv("DEVSVC_REPO_TABLE_PIN"), *c = pin ? strchr(pin, ':') : 0;
        if (sy_sha256_hex(b, n, cfg.tabsha)) { free(b); return -1; }
        if (cx_fmt(cfg.tabsrc, sizeof cfg.tabsrc, "%s", ov && *ov ? "env" : "worktree") || cx_fmt(cfg.tabrev, sizeof cfg.tabrev, "-")) return 3;
        if (ov && *ov && c && c > pin && c - pin < (long)sizeof cfg.tabrev && !strcmp(c + 1, cfg.table)) {
            if (cx_fmt(cfg.tabsrc, sizeof cfg.tabsrc, "pinned") || cx_fmt(cfg.tabrev, sizeof cfg.tabrev, "%.*s", (int)(c - pin), pin)) return 3; } }
    for (s = (char *)b, end = s + n; s < end; s = e + 1) {
        long kl, vl; int k; char *dst[] = {cfg.product, cfg.self, cfg.onchange, cfg.onchange_tag, cfg.proc_pat, cfg.cache_sub, cfg.inst_env};
        int cap[] = {sizeof cfg.product, sizeof cfg.self, sizeof cfg.onchange, sizeof cfg.onchange_tag, sizeof cfg.proc_pat, sizeof cfg.cache_sub, sizeof cfg.inst_env};
        e = memchr(s, '\n', end - s); if (!e) { if (end > s) bad++; break; }   /* 末行必须以换行结束 */
        if (e == s || *s == '#') continue;
        t = memchr(s, '\t', e - s); if (!t) { bad++; continue; }
        t2 = memchr(t + 1, '\t', e - t - 1); if (!t2) t2 = e;
        kl = t - s; vl = t2 - t - 1;
        if (kl == 3 && !memcmp(s, "key", 3)) continue;   /* 表头 */
        if (kl == 3 && !memcmp(s, "lib", 3)) { if (nlib >= 3 || !cfg_set(cfg.lib[nlib], sizeof cfg.lib[0], t + 1, vl)) bad++; else nlib++; continue; }
        if (kl == 3 && !memcmp(s, "doc", 3)) { if (cfg.ndoc >= CFG_LOCKS || !cfg_set(cfg.docpat[cfg.ndoc], sizeof cfg.docpat[0], t + 1, vl)) bad++; else cfg.ndoc++; continue; }
        if (kl == 4 && !memcmp(s, "lock", 4)) {
            char *t3 = t2 < e ? memchr(t2 + 1, '\t', e - t2 - 1) : 0; long pl = t2 < e ? (t3 ? t3 : e) - t2 - 1 : 0;
            if (cfg.nlockname >= CFG_LOCKS || !cfg_set(cfg.lockname[cfg.nlockname], 64, t + 1, vl)) { bad++; continue; }
            cfg.lockpfx[cfg.nlockname][0] = 0;
            if (pl > 0 && !(pl == 1 && t2[1] == '-') && !cfg_set(cfg.lockpfx[cfg.nlockname], sizeof cfg.lockpfx[0], t2 + 1, pl)) bad++; else cfg.nlockname++;
            continue;
        }
        if (kl > 6 && !memcmp(s, "admit_", 6)) continue;   /* admit_* rows belong to cxlib.flowadmit (load gate) */
        for (k = 0; k < 7; k++) if ((long)strlen(keys[k]) == kl && !memcmp(s, keys[k], kl)) break;
        if (k == 7) { static int warned; if (!warned++) fprintf(stderr, "devsvc: WARN repo table: unknown row kind %.*s ignored (newer table?)\n", (int)kl, s); continue; }
        if ((seen & (1 << k)) || !cfg_set(dst[k], cap[k], t + 1, vl)) { bad++; continue; }
        seen |= 1 << k;
    }
    free(b);
    return (bad || seen != 127 || nlib != 3) ? -2 : 0;
}

typedef struct { char name[64]; char owner[64]; long exp; pi_id_t holder; } Lock;
static Lock locks[MAXLOCK]; static int nlock;
static char ring[RING][EVW]; static long ring_wall[RING]; static long seq;
static long ring_floor;
static char dir[PW], sockp[PW];
static char resp[1 << 17]; static long rn;
static char big[1 << 22];

/* 带界格式化:装不下不静默截断,记 ovf;服务端把该请求答成 ERR overflow,客户端以 rc 2 退出。 */
#define F(dst, cap, ...) do { int f_ = snprintf(dst, cap, __VA_ARGS__); if (f_ < 0 || f_ >= (int)(cap)) ovf++; } while (0)
#define radd(...) do { if (rn < (long)sizeof resp - 1) { int k_ = snprintf(resp + rn, sizeof resp - rn, __VA_ARGS__); \
    if (k_ > 0) { rn += k_; if (rn > (long)sizeof resp - 1) rn = sizeof resp - 1; } } } while (0)
static void clean(char *s) { for (; *s; s++) if (*s == '\t' || *s == '\n' || *s == '\r') *s = ' '; }
static int runcap(char **argv, char *out, int cap) {
    np_result r; char why[200]; int rc; long n;   /* 55 秒上限,到点清理子进程;只取 stdout */
    memset(out, 0, cap);
    if (np_run(argv, 0, 0, 55, &r, why, sizeof why)) return -1;
    n = (long)r.outn; rc = r.rc;
    if (n > cap - 1) { np_free(&r); return -2; }
    if (n > 0 && mm_copy(out, cap, r.out, n)) { np_free(&r); return -2; }
    np_free(&r);
    return rc;
}
static void chomp(char *s) { long n = strlen(s); while (n > 0 && (s[n - 1] == '\n' || s[n - 1] == '\r')) s[--n] = 0; }

/* 一个 git 公共目录一个实例(同仓多个工作树共享);锁名由客户端加工作树前缀互不串:
   主工作树(公共目录 = 顶层/.git)不加前缀,其它工作树加 w<顶层摘要前 8 位>:,见 request() */
static char lkpfx[16];
static int inst_dir(void) {
    const char *e = getenv(cfg.inst_env);
    const char *fc = getenv("DEVSVC_FG_CWD"), *ft = getenv("DEVSVC_FG_TOP"), *fm = getenv("DEVSVC_FG_COMMON");
    char out[2 * PW], common[PW], top[PW], home[PW], hex[65], cur[PW];
    common[0] = top[0] = 0; lkpfx[0] = 0;
    if (fc && fc[0] == '/' && ft && ft[0] == '/' && fm && fm[0] == '/' &&
        !getenv("GIT_DIR") && !getenv("GIT_WORK_TREE") && !getenv("GIT_COMMON_DIR") && !getenv("GIT_INDEX_FILE") &&
        sy_cwd(cur, sizeof cur) >= 0 && !strcmp(cur, fc)) {
        F(common, sizeof common, "%s", fm); F(top, sizeof top, "%s", ft);
    } else {
        char *v[] = {"git", "rev-parse", "--path-format=absolute", "--git-common-dir", "--show-toplevel", 0};
        int grc = runcap(v, out, sizeof out); char *nl;
        if (grc == 0 && (nl = strchr(out, '\n'))) {
            *nl = 0; F(common, sizeof common, "%s", out); F(top, sizeof top, "%s", nl + 1); chomp(top);
        }
    }
    if (top[0] && common[0]) {
        char mainp[PW]; F(mainp, sizeof mainp, "%s/.git", top);
        if (strcmp(mainp, common) && !sy_sha256_hex(top, strlen(top), hex)) { hex[8] = 0; F(lkpfx, sizeof lkpfx, "w%s:", hex); }
    }
    if (e && *e) { if (snprintf(dir, sizeof dir, "%s", e) >= (int)sizeof dir) return -1; }
    else {
        long cl = (long)strlen(common);
        if (cl > 5 && !strcmp(common + cl - 5, "/.git")) common[cl - 5] = 0;   /* 键取主工作树顶层:与旧实例目录一致 */
        if (!common[0] || sy_homedir(home, sizeof home) < 0 || sy_sha256_hex(common, strlen(common), hex)) return -1;
        hex[16] = 0;
        if (snprintf(dir, sizeof dir, "%s/%s/%s", home, cfg.cache_sub, hex) >= (int)sizeof dir) return -1;
    }
    if (snprintf(sockp, sizeof sockp, "%s/sock", dir) >= 100) return -1;   /* sun_path 上限 */
    return sy_mkdir_all(dir, 0700) ? -1 : 0;
}

/* ---- 事件环 ---- */
static long ev_rotate_bytes(void) { const char *e = getenv("DEVSVC_EV_ROTATE"); long v = e ? atol(e) : 0; return v > 0 ? v : 4L << 20; }   /* 缺省 4 MB;检查用环境变量调小 */
#define EV_ROTATE ev_rotate_bytes()
/* Restore both retained generations, including logs from older services which
 * reused sequence numbers. Only a contiguous suffix can be offered to --since. */
static int ev_replay(const char *path, int current) {
    /* Read a bounded tail even when an instance uses a large rotation size. */
    int fd = sy_open_read(path), damaged = 0; long n, start;
    char *s, *end, *nl, *p, *body; sy_stat_t st;
    if (fd < 0) return fd;
    if (sy_fstat(fd, &st) || st.kind != 'f' || st.size <= 0) { sy_close(fd); return -EINVAL; }
    n = st.size >= (long)sizeof big ? sizeof big - 1 : st.size;
    start = st.size - n;
    if (sy_lseek(fd, start, SEEK_SET) < 0 || sy_read_full(fd, big, n)) { sy_close(fd); return -EIO; }
    sy_close(fd);
    s = big; end = s + n;
    if (start) { nl = memchr(s, '\n', n); if (!nl) return -EINVAL; s = nl + 1; }
    for (; s < end; s = nl + 1) {
        long id, wall;
        nl = memchr(s, '\n', end - s);
        if (!nl) { if (current) sy_append_file(path, "\n", 1, 0600); damaged = 1; break; }
        *nl = 0;
        if (strncmp(s, "EV\t", 3)) { damaged = 1; continue; }
        errno = 0; id = strtol(s + 3, &p, 10);
        if (errno || id <= 0 || *p != '\t') { damaged = 1; continue; }
        wall = strtol(p + 1, &body, 10);
        if (errno || wall <= 0 || *body != '\t' || nl - body <= 1 || nl - body > EVW ||
            strlen(body + 1) != (size_t)(nl - body - 1)) { damaged = 1; continue; }
        if (id <= seq) continue;
        if (id - 1 != seq) ring_floor = id - 1;
        seq = id;
        if (mm_copy(ring[(seq - 1) % RING], EVW, body + 1, nl - body)) return -EINVAL;
        ring_wall[(seq - 1) % RING] = wall;
    }
    return damaged ? -EINVAL : 0;
}
static void ev_resume(char *notice, int cap) {
    char cur[PW + 24], prev[PW + 24], high[PW + 24], *end; unsigned char *b = 0; int64_t n = 0;
    if (cx_fmt(cur, sizeof cur, "%s/events.tsv", dir) || cx_fmt(prev, sizeof prev, "%s/events.tsv.1", dir) ||
        cx_fmt(high, sizeof high, "%s/events.seq", dir)) { fprintf(stderr, "EVENT_SEQ_PATH_TOO_LONG\n"); return; }
    int backup = ev_replay(prev, 0), current = ev_replay(cur, 1);
    long watermark = 0;
    int saved = sy_read_file(high, &b, &n, 32);
    if (!saved) {
        errno = 0; watermark = strtol((char *)b, &end, 10);
        if (errno || watermark < 0 || end != (char *)b + n || !n) { watermark = 0; saved = -EINVAL; }
        free(b);
    }
    if (current || (backup && backup != -ENOENT) || (saved && saved != -ENOENT) || watermark > seq) {
        long floor = watermark;
        if (!floor && current != -ENOENT && current) floor = sy_wall_s() * 1000000L;
        if (seq < floor) { seq = floor; ring_floor = seq; }
        if (cx_fmt(notice, cap, "EVENT_SEQ_RECOVERY current_rc=%d rotated_rc=%d watermark_rc=%d resume=%ld", current, backup, saved, seq)) return;
        fprintf(stderr, "%s\n", notice);
    }
}
static void ev_add(const char *kind, const char *text) {
    if (seq == LONG_MAX) { fprintf(stderr, "EVENT_SEQ_EXHAUSTED\n"); return; }
    {
        char p[PW + 24], b[32];
        if (cx_fmt(b, sizeof b, "%ld", seq + 1) || cx_fmt(p, sizeof p, "%s/events.seq", dir) ||
            sy_write_atomic(p, b, strlen(b), 0600)) fprintf(stderr, "EVENT_SEQ_WATERMARK_UNWRITABLE\n");
    }
    char *e = ring[seq % RING];
    int w = snprintf(e, EVW, "%s\t%s", kind, text);   /* 事件正文超出 EVW 即截断并标记,这是环的定长合同 */
    if (w >= EVW) { e[EVW - 2] = '~'; e[EVW - 1] = 0; }
    ring_wall[seq % RING] = sy_wall_s();
    seq++;
    {   /* 持久化:追加到实例目录 events.tsv(行格式与 tools/devsvc-usage.cx 对齐);超过 EV_ROTATE 字节轮转为 events.tsv.1(只留一份) */
        char p[PW], p1[PW], ln[EVW + 64]; int64_t sz = 0; int w;
        if (snprintf(p, sizeof p, "%s/events.tsv", dir) >= (int)sizeof p || snprintf(p1, sizeof p1, "%s/events.tsv.1", dir) >= (int)sizeof p1) return;
        if (sy_file_size(p, &sz) == 0 && sz > EV_ROTATE) sy_rename(p, p1);
        w = snprintf(ln, sizeof ln, "EV\t%ld\t%ld\t%s\n", seq, ring_wall[(seq - 1) % RING], e);
        if (w > 0 && w < (int)sizeof ln) sy_append_file(p, ln, w, 0600);
    }
}

/* ---- 锁 ---- */
static void locks_save(void) {
    static char b[MAXLOCK * 256]; long n = 0; int i; char p[PW];
    for (i = 0; i < nlock && n < (long)sizeof b - 256; i++)
        n += snprintf(b + n, sizeof b - n, "%s\t%s\t%ld\t%d\t%llu\t%llu\t%llu\n",
                      locks[i].name, locks[i].owner, locks[i].exp,
                      locks[i].holder.pid, locks[i].holder.ticks,
                      locks[i].holder.btime, locks[i].holder.ns_ino);
    F(p, sizeof p, "%s/locks.tsv", dir);
    if (sy_write_atomic(p, b, n, 0600)) fprintf(stderr, "devsvc: cannot save %s\n", p);
}
static void locks_load(void) {
    char p[PW]; unsigned char *b = 0; int64_t n = 0; char *s, *e;
    F(p, sizeof p, "%s/locks.tsv", dir);
    if (sy_exists(p) != 1 || sy_read_file(p, &b, &n, 1 << 16) || !b) return;
    s = (char *)b;
    while (s < (char *)b + n && nlock < MAXLOCK) {
        char nm[64], ow[64]; long ex = 0; int pd = 0, got;
        unsigned long long tk = 0ULL, bt = 0ULL, ns = 0ULL;
        e = memchr(s, '\n', (char *)b + n - s); if (!e) break;
        *e = 0;
        got = sscanf(s, "%63[^\t]\t%63[^\t]\t%ld\t%d\t%llu\t%llu\t%llu", nm, ow, &ex, &pd, &tk, &bt, &ns);
        if (got == 3 || got == 5 || got == 7) {
            F(locks[nlock].name, 64, "%s", nm); F(locks[nlock].owner, 64, "%s", ow); locks[nlock].exp = ex;
            locks[nlock].holder.pid = (got >= 5) ? pd : 0;
            locks[nlock].holder.ticks = (got >= 5) ? tk : 0ULL;
            locks[nlock].holder.btime = (got == 7) ? bt : 0ULL;
            locks[nlock].holder.ns_ino = (got == 7) ? ns : 0ULL;
            nlock++;
        }
        s = e + 1;
    }
    free(b);
}
/* 最近过期的锁(名、属主)环:持有者过期后再 release 报 expired 而不是 not-held */
#define NEXPD 32
static Lock expd[NEXPD]; static long nexpd;
static int expd_find(const char *name, const char *owner) {
    long i; for (i = 0; i < NEXPD && i < nexpd; i++) if (!strcmp(expd[i].name, name) && !strcmp(expd[i].owner, owner)) return (int)i;
    return -1;
}
static void locks_expire(void) {
    long now = sy_wall_s(); int i, ch = 0; char t[280];
    for (i = 0; i < nlock; ) {
        unsigned long long cur_tk = 0ULL; const char *reason = "";
        int dead = locks[i].holder.pid > 0 && !pi_alive_ex(&locks[i].holder, &cur_tk, &reason);
        if (dead) {
            F(t, sizeof t, "%s\towner=%s\tpid=%d\tstart_ticks=%llu\tcur_ticks=%llu\treason=%s",
              locks[i].name, locks[i].owner, locks[i].holder.pid,
              locks[i].holder.ticks, cur_tk, reason);
            ev_add("lock.reap", t);
            expd[nexpd % NEXPD] = locks[i]; nexpd++;
            locks[i] = locks[--nlock]; ch = 1;
        } else if (locks[i].exp <= now) {
            F(t, sizeof t, "%s\towner=%s", locks[i].name, locks[i].owner);
            ev_add("lock.expire", t);
            expd[nexpd % NEXPD] = locks[i]; nexpd++;
            locks[i] = locks[--nlock]; ch = 1;
        } else i++;
    }
    if (ch) locks_save();
}
static int lock_find(const char *name) { int i; for (i = 0; i < nlock; i++) if (!strcmp(locks[i].name, name)) return i; return -1; }
static int okname(const char *s) { long n = s ? (long)strlen(s) : 0; return n > 0 && n < 64 && !strchr(s, ' '); }

/* ---- 原生执行体缓存(服务端与 --local 共用) ---- */
static char nlog[PW + 32];   /* 最近一次构造失败的完整日志路径;空串即没有 */
/* 构造失败日志的末段(至多 20 行、3000 字节),每行前缀 BUILD<TAB>,写进 dst;返回长度 */
static long build_tail(char *dst, long cap) {
    unsigned char *b = 0; int64_t n = 0; long k = 0, s, i, lines = 0;
    dst[0] = 0;
    if (!nlog[0] || sy_read_file(nlog, &b, &n, 1 << 22) || !b) return 0;
    s = n > 3000 ? (long)n - 3000 : 0;
    for (i = (long)n - 1; i > s; i--) if (b[i - 1] == '\n' && ++lines >= 20) { s = i; break; }
    while (s < n) {
        long e = s; int w;
        while (e < n && b[e] != '\n') e++;
        w = snprintf(dst + k, cap - k, "BUILD\t%.*s\n", (int)(e - s), (char *)b + s);
        if (w < 0 || w >= cap - k) break;
        k += w; s = e + 1;
    }
    dst[k] = 0;
    free(b);
    return k;
}
static void native_dirs(int bypass, const char *hex, char *kd, int kcap, char *mdir, int mcap) {
    const char *nd = getenv("DEVSVC_NATIVE_DIR"), *ie = getenv(cfg.inst_env); char home[PW], base[PW];
    base[0] = 0;
    if (nd && *nd) F(base, sizeof base, "%s", nd);
    else if ((ie && *ie) || sy_homedir(home, sizeof home) < 0) F(base, sizeof base, "%s/native", dir);
    else F(base, sizeof base, "%s/%s/native", home, cfg.cache_sub);
    if (mdir && cx_fmt(mdir, (size_t)mcap, "%s/memo", base)) ovf++;
    if (kd) {
        if (bypass) { if (cx_fmt(kd, (size_t)kcap, "%s/native/bypass", dir)) ovf++; }
        else { if (cx_fmt(kd, (size_t)kcap, "%s/%s", base, hex)) ovf++; }
    }
}
static int native_try_fast(const char *root, const char *tool, char *bin, int cap, long *ms) {
    char prod[PW], real[PW], mdir[PW]; long t0 = sy_now_ms();
    if (!root || !tool || !tool[0] || strstr(tool, "..") || tool[0] == '/' || tool[0] == '-') return -1;
    F(prod, sizeof prod, "%s/%s", root, cfg.product);
    if (ovf || sy_realpath(prod, real, sizeof real) < 0) return -1;
    native_dirs(0, "-", 0, 0, mdir, sizeof mdir);
    if (ovf || ns_try_hit(mdir, root, tool, real, bin, cap) != 0) return -1;
    *ms = sy_now_ms() - t0;
    return 0;
}
static int in_native_worker;
static long native_max_ms(void) {
    const char *v = getenv("DEVSVC_NATIVE_MAX_MS");
    long n = (v && v[0]) ? atol(v) : 0;
    return (n >= 200 && n <= 55000) ? n : 55000L;
}
static int native_no_async(void) {
    const char *v = getenv("UNISACC_NATIVE_NO_ASYNC");
    return v && v[0] == '1' && v[1] == 0;
}
static int native_get(const char *root, const char *tool, char *bin, int cap, const char **cache, long *ms) {
    static char keysrc[8192]; char src[PW], prod[PW], real[PW], hex[65], dhex[65], trees[400], st[4096], leaf[128], kd[PW], mdir[PW], tmp[PW];
    unsigned char *b = 0; int64_t n = 0; long t0 = sy_now_ms(), nmax = native_max_ms(), nat_dl = t0 + (nmax > 2500 ? nmax - 1500 : nmax + 500);
    int bypass = 0, rc, lfd = -1; const char *base; char *dot;
    sy_spawn_t o; sy_exit_t ex;
    *ms = 0; *cache = "miss"; nlog[0] = 0;
    if (strstr(tool, "..") || tool[0] == '/' || tool[0] == '-') return -EINVAL;
    static char cl[1 << 16]; long cn = 0;
    char phex[65]; long rl = (long)strlen(root); int fileref = 0;
    F(src, sizeof src, "%s/%s", root, tool); F(prod, sizeof prod, "%s/%s", root, cfg.product);
    if (sy_exists(src) != 1) return -ENOENT;
    if (sy_realpath(prod, real, sizeof real) < 0) return -ENOENT;
    native_dirs(0, "-", 0, 0, mdir, sizeof mdir);
    if (ns_try_hit(mdir, root, tool, real, bin, cap) == 0) { *cache = "hit"; *ms = sy_now_ms() - t0; return 0; }
    if (ns_prod_sha(real, mdir, phex)) return -EIO;
    big[0] = 0;
    {   char *v[] = {"sh", prod, "-cx-plan", src, 0}, plf[PW];
        long prem_ms = nat_dl - sy_now_ms();
        int pfd, prc; sy_spawn_t po; sy_exit_t pex;
        if (prem_ms <= 0) return -ETIMEDOUT;
        F(plf, sizeof plf, "%s/nat-plan-%d.tmp", dir, sy_pid());
        if (ovf) return -EIO;
        sy_unlink(plf);
        pfd = sy_open_new(plf, 0600);
        if (pfd < 0) bypass = 1;
        else {
            sy_spawn_init(&po); po.argv = v; po.cwd = root;
            po.pgroup = in_native_worker ? 0 : -1;
            po.deadline_ms = prem_ms;
            po.in_fd = SY_STDIO_NULL; po.out_fd = pfd; po.err_fd = SY_STDIO_NULL;
            prc = sy_proc_run(&po, &pex);
            sy_close(pfd);
            if (prc || pex.timed_out || sy_now_ms() >= nat_dl) { sy_unlink(plf); return -ETIMEDOUT; }
            if (sy_exit_code(&pex) != 0) bypass = 1;
            else {
                unsigned char *pb = 0; int64_t pn = 0;
                if (sy_read_file(plf, &pb, &pn, sizeof big) || !pb || pn >= (int64_t)sizeof big) bypass = 1;
                else {
                    if (pn > 0 && mm_copy(big, sizeof big, pb, (size_t)pn)) bypass = 1;
                    big[pn] = 0;
                }
                free(pb);
            }
            sy_unlink(plf);
        } }
    if (sy_now_ms() >= nat_dl) return -ETIMEDOUT;
    if (!bypass) {
        char *p = big;
        cl[0] = 0;
        while (*p && !bypass) {
            char *e = strchr(p, '\n'), *t1, *t2, fp[PW], fh[65];
            if (!e) e = p + strlen(p);
            t1 = memchr(p, '\t', e - p); t2 = t1 ? memchr(t1 + 1, '\t', e - t1 - 1) : 0;
            if (!t2) t2 = e;
            if (!t1 || t2 - t1 - 1 <= 0 || t2 - t1 - 1 >= (long)sizeof fp) { bypass = 1; break; }
            if (mm_copy(fp, sizeof fp, t1 + 1, t2 - t1 - 1)) { bypass = 1; break; }
            fp[t2 - t1 - 1] = 0;
            if (sy_read_file(fp, &b, &n, 1 << 24) || !b || sy_sha256_hex(b, n, fh)) bypass = 1;
            if (!bypass && !fileref) { int64_t k; for (k = 0; k + 8 <= n; k++) if (b[k] == '_' && !memcmp(b + k, "__FILE__", 8)) { fileref = 1; break; } }
            free(b); b = 0;
            if (!bypass) {
                const char *rp = fp; long fl;
                if (rl > 0 && !strncmp(fp, root, rl) && fp[rl] == '/') rp = fp + rl + 1;   /* 仓内文件记相对路径 */
                fl = (long)strlen(rp);
                if (cn + fl + 66 >= (long)sizeof cl || mm_copy(cl + cn, sizeof cl - cn, rp, fl)) bypass = 1;
                else { cn += fl; cl[cn++] = '\t'; if (mm_copy(cl + cn, sizeof cl - cn, fh, 64)) bypass = 1; cn += 64; cl[cn++] = '\n'; }
            }
            p = *e ? e + 1 : e;
        }
        if (cn == 0 || sy_sha256_hex(cl, cn, dhex)) bypass = 1;
    }
    F(keysrc, sizeof keysrc, "v3|%s|%s|%s|%s", fileref ? root : "-", tool, phex, bypass ? "-" : dhex);
    if (sy_sha256_hex(keysrc, strlen(keysrc), hex)) return -EIO;
    hex[20] = 0;
    base = strrchr(tool, '/'); base = base ? base + 1 : tool;
    F(leaf, sizeof leaf, "%s", base); dot = strrchr(leaf, '.'); if (dot) *dot = 0;
    native_dirs(bypass, hex, kd, sizeof kd, mdir, sizeof mdir);
    if (sy_mkdir_all(kd, 0700) || snprintf(bin, cap, "%s/%s", kd, leaf) >= cap) return -EIO;
    if (!bypass && ns_bin_ok(bin)) {
        ns_save(mdir, root, tool, real, big, bin);
        *cache = "hit"; *ms = sy_now_ms() - t0; return 0;
    }
    if (!bypass) {
        long lwait = nat_dl - sy_now_ms() - 500;
        if (lwait < 100) lwait = 100;
        if (lwait > 45000) lwait = 45000;
        if (ns_lock_begin_ms(bin, &lfd, lwait) != 0) return -ETIMEDOUT;
        if (sy_now_ms() >= nat_dl) { ns_lock_end(lfd); return -ETIMEDOUT; }
        if (ns_bin_ok(bin)) {
            ns_lock_end(lfd);
            ns_save(mdir, root, tool, real, big, bin);
            *cache = "hit"; *ms = sy_now_ms() - t0; return 0;
        }
    }
    if (bypass) *cache = "bypass";
    {   long crem = nat_dl - sy_now_ms();
        if (crem <= 0) { ns_lock_end(lfd); return -ETIMEDOUT; }
        if (crem > 50000) crem = 50000;
        F(tmp, sizeof tmp, "%s.tmp%d", bin, sy_pid());
        F(nlog, sizeof nlog, "%s.build.log", bin);
        {   char *v[] = {"sh", prod, src, "-o", tmp, 0}; int lf = sy_open(nlog, O_WRONLY | O_CREAT | O_TRUNC, 0600);
            sy_spawn_init(&o); o.argv = v; o.cwd = root; o.pgroup = in_native_worker ? 0 : -1; o.deadline_ms = crem;
            o.in_fd = SY_STDIO_NULL; o.out_fd = lf >= 0 ? lf : SY_STDIO_NULL; o.err_fd = lf >= 0 ? lf : SY_STDIO_NULL;
            rc = sy_proc_run(&o, &ex);
            if (lf >= 0) sy_close(lf); else nlog[0] = 0; }
    }
    *ms = sy_now_ms() - t0;
    /* 失败时日志留在原处(下次构造同名工具时覆盖),路径与末段由调用方回传 */
    if (ex.timed_out || sy_now_ms() >= nat_dl) { sy_unlink(tmp); ns_lock_end(lfd); return -ETIMEDOUT; }
    if (rc || sy_exit_code(&ex) != 0 || sy_exists(tmp) != 1) { sy_unlink(tmp); ns_lock_end(lfd); return rc ? rc : -(1000 + sy_exit_code(&ex)); }
    if (nlog[0]) sy_unlink(nlog);
    nlog[0] = 0;
    if (sy_rename(tmp, bin)) { sy_unlink(tmp); ns_lock_end(lfd); return -EIO; }
    if (!bypass) {   /* 记下执行体字节 sha,供命中时校验 */
        unsigned char *sb = 0; int64_t sn = 0; char got[65], sp[PW + 8];
        F(sp, sizeof sp, "%s.sha", bin);
        if (!sy_read_file(bin, &sb, &sn, 1 << 28) && sb && !sy_sha256_hex(sb, sn, got)) (void)sy_write_atomic(sp, got, 64, 0600);
        free(sb);
        (void)ns_bin_ok(bin);
        ns_save(mdir, root, tool, real, big, bin);
    }
    ns_lock_end(lfd);
    return 0;
}

/* ---- 服务端 ---- */
static int handle(char *line) {   /* 返回 1 表示收到 stop */
    char *f[6]; int nf = 0, i; char *s = line; long now = sy_wall_s();
    while (nf < 6) { f[nf++] = s; s = strchr(s, '\t'); if (!s) break; if (nf < 6) *s++ = 0; }
    for (i = nf; i < 6; i++) f[i] = "";
    locks_expire();
    if (!strcmp(f[0], "ping")) { radd("OK\tpong\tpid=%d\tseq=%ld\tlocks=%d\n", sy_pid(), seq, nlock); return 0; }
    if (!strcmp(f[0], "stop")) { radd("OK\tstopping\tpid=%d\n", sy_pid()); return 1; }
    if (!strcmp(f[0], "lock-acquire")) {
        long ttl = atol(f[3]); char t[256]; pi_id_t rid;
        memset(&rid, 0, sizeof rid);
        if (!okname(f[1]) || !okname(f[2]) || ttl <= 0 || ttl > LOCK_TTL_MAX) { radd("ERR\tusage\tlock-acquire NAME OWNER TTL(1..%d)\n", LOCK_TTL_MAX); return 0; }
        if (f[4][0] && pi_parse_tag_ex(f[4], &rid) != 0) memset(&rid, 0, sizeof rid);
        i = lock_find(f[1]);
        if (i >= 0 && strcmp(locks[i].owner, f[2])) { radd("ERR\theld\t%s\towner=%s\texpires_in_s=%ld\n", f[1], locks[i].owner, locks[i].exp - now); return 0; }
        if (i < 0) {
            if (nlock >= MAXLOCK) { radd("ERR\tfull\tmax=%d\n", MAXLOCK); return 0; }
            i = nlock++; F(locks[i].name, 64, "%s", f[1]); F(locks[i].owner, 64, "%s", f[2]);
            radd("OK\tacquired\t%s\towner=%s\texpires_in_s=%ld\n", f[1], f[2], ttl);
            if (rid.pid > 0) F(t, sizeof t, "%s\towner=%s\tttl=%ld\tpid=%d", f[1], f[2], ttl, rid.pid);
            else F(t, sizeof t, "%s\towner=%s\tttl=%ld", f[1], f[2], ttl);
            ev_add("lock.acquire", t);
            locks[i].exp = now + ttl; locks[i].holder = rid;
        } else {   /* 续期只延长不缩短:包装器用短 ttl 续调用方的长租约时不得把它截短; 且仅同 PID 或原持有者已确认死亡才改绑(P1) */
            if (locks[i].exp < now + ttl) locks[i].exp = now + ttl;
            if (rid.pid > 0 && locks[i].holder.pid > 0 && (rid.pid == locks[i].holder.pid || !pi_alive_ex(&locks[i].holder, 0, 0))) locks[i].holder = rid;
            radd("OK\trenewed\t%s\towner=%s\texpires_in_s=%ld\n", f[1], f[2], locks[i].exp - now);
        }
        locks_save(); return 0;
    }
    if (!strcmp(f[0], "lock-release")) {
        char t[200];
        i = lock_find(f[1]);
        if (i < 0) { if (expd_find(f[1], f[2]) >= 0) radd("ERR\texpired\t%s\towner=%s\n", f[1], f[2]); else radd("ERR\tnot-held\t%s\n", f[1]); return 0; }
        if (strcmp(locks[i].owner, f[2])) { radd("ERR\tnot-owner\t%s\towner=%s\n", f[1], locks[i].owner); return 0; }
        F(t, sizeof t, "%s\towner=%s", f[1], f[2]); ev_add("lock.release", t);
        locks[i] = locks[--nlock]; locks_save(); radd("OK\treleased\t%s\n", f[1]); return 0;
    }
    if (!strcmp(f[0], "lock-list")) {
        radd("OK\tlocks\tn=%d\n", nlock);
        for (i = 0; i < nlock; i++) {
            if (locks[i].holder.pid > 0) radd("LOCK\t%s\towner=%s\texpires_in_s=%ld\tpid=%d:%llu\tbtime=%llu\tns=%llu\n", locks[i].name, locks[i].owner, locks[i].exp - now, locks[i].holder.pid, locks[i].holder.ticks, locks[i].holder.btime, locks[i].holder.ns_ino);
            else radd("LOCK\t%s\towner=%s\texpires_in_s=%ld\n", locks[i].name, locks[i].owner, locks[i].exp - now);
        }
        return 0;
    }
    if (!strcmp(f[0], "native")) {
        char bin[PW]; const char *c; long ms; int r = native_get(f[1], f[2], bin, sizeof bin, &c, &ms);
        if (r) { char tl[3600]; build_tail(tl, sizeof tl); radd("ERR\tnative\t%s\trc=%d\tms=%ld\tlog=%s\n%s", f[2], r, ms, nlog[0] ? nlog : "-", tl); }
        else radd("OK\tnative\t%s\tcache=%s\tms=%ld\n", bin, c, ms);
        return 0;
    }
    if (!strcmp(f[0], "emit")) {
        if (!f[1][0]) { radd("ERR\tusage\temit KIND TEXT\n"); return 0; }
        /* TEXT 可含 TAB:f[2] 之后的字段被切开过,这里只取 f[2..] 重拼 */
        {   char t[EVW]; long k = 0; t[0] = 0;
            for (i = 2; i < nf; i++) { long w = snprintf(t + k, sizeof t - k, "%s%s", i > 2 ? "\t" : "", f[i]); if (w < 0 || w >= (long)sizeof t - k) { radd("ERR\ttoo-long\temit TEXT max=%d\n", EVW - 80); return 0; } k += w; }
            ev_add(f[1], t); }
        radd("OK\temitted\tseq=%ld\n", seq); return 0;
    }
    if (!strcmp(f[0], "events")) {
        long since = atol(f[1]), lo = seq > RING ? seq - RING : 0, k;
        if (lo < ring_floor) lo = ring_floor;
        if (since < lo) since = lo;
        if (since > seq) since = seq;
        radd("OK\tevents\tseq=%ld\tn=%ld\tdropped_before=%ld\n", seq, seq - since, lo);
        for (k = since; k < seq; k++) radd("EV\t%ld\t%ld\t%s\n", k + 1, ring_wall[k % RING], ring[k % RING]);
        return 0;
    }
    radd("ERR\tunknown-verb\t%s\n", f[0]);
    return 0;
}

static int try_connect(long ms) { return sy_unix_connect(sockp, sy_deadline_in(ms)); }

#define MAX_NAT_WORKERS 16
typedef struct { int ls, c; char line[2048]; } NatWork;
static int nat_pids[MAX_NAT_WORKERS], n_nat;
static long nat_t0[MAX_NAT_WORKERS];
static int native_worker(void *ud) {
    NatWork *w = (NatWork *)ud;
    int dn = sy_open("/dev/null", O_RDWR, 0);
    char et[32];
    in_native_worker = 1;
    sy_close(w->ls);
    if (dn >= 0) { if (dn != 1) sy_dup2(dn, 1); if (dn != 2) sy_dup2(dn, 2); if (dn > 2) sy_close(dn); }
    rn = 0; resp[0] = 0; ovf = 0;
    (void)handle(w->line);
    if (ovf) { rn = 0; radd("ERR\toverflow\tfield too long\n"); ovf = 0; }
    (void)sy_send_all_until(w->c, resp, rn, sy_deadline_in(5000));
    sy_close(w->c);
    F(et, sizeof et, "rc=%d\t", -ETIMEDOUT);
    if (strstr(resp, et)) {
        (void)sy_sig_watch(SIGTERM);
        (void)sy_signal(-sy_pid(), SIGTERM);
        sy_sleep_ms(20);
    }
    return 0;
}
static int jobs_gc(void);
static int flowdir_gc(void);
static int serve(long ttl, long idle) {
    int ls, c, stop = 0; long t0 = sy_now_ms(), last = t0, gc_at = 0; char p[PW], info[PW + 96]; static char line[8192];
    if (ttl <= 0 || ttl > TTL_MAX || idle <= 0) { fprintf(stderr, "devsvc: ttl 1..%d, idle >= 1\n", TTL_MAX); return 2; }
    ls = sy_unix_listen(sockp, 16);
    if (ls == -EADDRINUSE) {
        c = try_connect(1000);
        if (c >= 0) { sy_close(c); fprintf(stderr, "devsvc: instance already serving %s\n", sockp); return 4; }
        sy_unlink(sockp); ls = sy_unix_listen(sockp, 16);   /* 陈旧 sock:无人接听 */
    }
    if (ls < 0) { fprintf(stderr, "devsvc: listen %s rc=%d\n", sockp, ls); return 3; }
    F(p, sizeof p, "%s/pid", dir);
    F(info, sizeof info, "%d\t%ld\tttl=%ld\tidle=%ld\n", sy_pid(), sy_wall_s(), ttl, idle);
    sy_write_atomic(p, info, strlen(info), 0600);
    char recovery[160] = "";
    ev_resume(recovery, sizeof recovery);
    locks_load();
    chomp(info); ev_add("svc.start", info);
    if (recovery[0]) ev_add("svc.seq-recovery", recovery);
    while (!stop) {
        long now = sy_now_ms(), k = 0, r, nmax = native_max_ms();
        for (int wi = 0; wi < n_nat; ) {
            int wex = 0, wcd = 0, wsg = 0;
            if (sy_wait_status(nat_pids[wi], 1, &wex, &wcd, &wsg) != 0) {
                nat_pids[wi] = nat_pids[n_nat - 1];
                nat_t0[wi] = nat_t0[--n_nat];
            } else if (now - nat_t0[wi] >= nmax) {
                char ev[96];
                F(ev, sizeof ev, "pid=%d\tms=%ld", nat_pids[wi], now - nat_t0[wi]);
                ev_add("native.timeout", ev);
                (void)sy_kill(nat_pids[wi]);
                nat_pids[wi] = nat_pids[n_nat - 1];
                nat_t0[wi] = nat_t0[--n_nat];
            } else wi++;
        }
        if (now - t0 >= ttl * 1000 || now - last >= idle * 1000) break;
        if (now - gc_at >= 60000) { gc_at = now; (void)jobs_gc(); (void)flowdir_gc(); }   /* 空闲巡检:启动即一次,之后每 60 s */
        c = sy_tcp_accept(ls, 200);
        if (c < 0) { if (c != -ETIMEDOUT) sy_sleep_ms(50); continue; }
        {   sy_deadline_t d = sy_deadline_in(2000);
            line[0] = 0;
            while (k < (long)sizeof line - 1) {
                r = sy_recv_until(c, line + k, sizeof line - 1 - k, d);
                if (r <= 0) break;
                k += r; line[k] = 0;
                if (memchr(line, '\n', k)) break;
            }
            line[k] = 0; chomp(line); if (strchr(line, '\n')) *strchr(line, '\n') = 0;
            rn = 0; resp[0] = 0;
            ovf = 0;
            if (k > 0 && !strncmp(line, "rel-", 4)) {
                char *rb = 0; long rbl = 0;
                if (rm_handle(line, dir, &rb, &rbl) == 0 && rb) {
                    (void)sy_send_all_until(c, rb, rbl, sy_deadline_in(5000));
                    mm_free(rb); sy_close(c); last = sy_now_ms(); continue;
                }
                if (rb) mm_free(rb);
            }
            if (k > 0 && !strncmp(line, "native\t", 7)) {
                char *sp1 = strchr(line + 7, '\t');
                if (sp1 && !strchr(sp1 + 1, '\t')) {
                    char bin[PW], rbuf[PW]; long nms = 0;
                    long rl1 = sp1 - (line + 7);
                    if (rl1 > 0 && rl1 < (long)sizeof rbuf) {
                        mm_copy(rbuf, sizeof rbuf, line + 7, (size_t)rl1); rbuf[rl1] = 0;
                        if (native_try_fast(rbuf, sp1 + 1, bin, sizeof bin, &nms) == 0) {
                            radd("OK\tnative\t%s\tcache=hit\tms=%ld\n", bin, nms);
                            if (ovf) { rn = 0; radd("ERR\toverflow\tfield too long\n"); ovf = 0; }
                            sy_send_all_until(c, resp, rn, sy_deadline_in(2000));
                            sy_close(c); last = sy_now_ms(); continue;
                        }
                    }
                    if (!native_no_async() && n_nat < MAX_NAT_WORKERS) {
                        static NatWork nw; int fds[2], wp;
                        nw.ls = ls; nw.c = c;
                        if (!cx_fmt(nw.line, sizeof nw.line, "%s", line)) {
                            wp = sy_fork_session(native_worker, &nw, fds);
                            if (wp > 0) {
                                sy_close(fds[0]); sy_close(fds[1]);
                                nat_t0[n_nat] = sy_now_ms();
                                nat_pids[n_nat++] = wp;
                                sy_close(c); last = sy_now_ms(); continue;
                            }
                        }
                    }
                }
            }
            if (k > 0) stop = handle(line); else radd("ERR\tempty-request\n");
            if (ovf) { rn = 0; radd("ERR\toverflow\tfield too long\n"); ovf = 0; stop = 0; }
            sy_send_all_until(c, resp, rn, sy_deadline_in(2000));
        }
        sy_close(c);
        last = sy_now_ms();
    }
    while (n_nat > 0) {
        int wpid = nat_pids[--n_nat];
        (void)sy_kill(wpid);
    }
    sy_close(ls); sy_unlink(sockp); sy_unlink(p);
    return 0;
}

/* ---- 客户端 ---- */
static int spawn_server_polls(const char *root, const char *ttl, const char *idle, int polls) {
    char prod[PW], self[PW]; sy_spawn_t o; sy_child_t ch; int i, c;
    F(prod, sizeof prod, "%s/%s", root, cfg.product); F(self, sizeof self, "%s/%s", root, cfg.self);
    {   const char *sb = getenv("DEVSVC_SELF_BIN");   /* 固定版本入口(tools/dv.cx)给的本执行体路径:所起服务与客户端同一版本 */
        char *v[] = {"sh", prod, self, "--", "serve", "--ttl", (char *)ttl, "--idle", (char *)idle, 0};
        char *vb[] = {(char *)sb, "serve", "--ttl", (char *)ttl, "--idle", (char *)idle, 0};
        sy_spawn_init(&o); o.argv = sb && *sb ? vb : v; o.cwd = root; o.pgroup = -1;
        o.in_fd = SY_STDIO_NULL; o.out_fd = SY_STDIO_NULL; o.err_fd = SY_STDIO_NULL;
        if (sy_proc_spawn(&o, &ch)) return -1; }
    for (i = 0; i < polls; i++) {
        sy_exit_t st;
        c = try_connect(200);
        if (c >= 0) return c;
        if (sy_proc_try_wait(&ch, &st) == 1) { c = try_connect(200); return c >= 0 ? c : -1; }   /* 拉起进程已退:不再空等 */
        sy_sleep_ms(100);
    }
    return -1;
}
static int spawn_server(const char *root, const char *ttl, const char *idle) {
    return spawn_server_polls(root,ttl,idle,400);
}
static void timing_finish(int rc) {
    const char *root=dt_root();
    if(!*root)return;
    if(sy_exists(sockp)==0){
        int fd=spawn_server_polls(root,"1800","300",3);
        if(fd>=0)sy_close(fd);
    }
    dt_finish(sockp,rc);
}
/* 发一行请求,响应收进 resp。autostart=1 时连不上就拉起。返回 0 OK、1 ERR、3 连不上。 */
static int request(const char *root, const char *line, int autostart) {
    int c = try_connect(1500); long r; sy_deadline_t d;
    if (c < 0 && autostart) {
        if (c == -ECONNREFUSED) sy_unlink(sockp);
        c = spawn_server(root, "1800", "300");
    }
    rn = 0; resp[0] = 0;
    if (c < 0) return 3;
    if (lkpfx[0] && (!strncmp(line, "lock-acquire\t", 13) || !strncmp(line, "lock-release\t", 13))) {   /* 非主工作树:锁名加工作树前缀 */
        static char pl[1024]; F(pl, sizeof pl, "%.13s%s%s", line, lkpfx, line + 13); line = pl;
    }
    d = sy_deadline_in(58000);
    if (sy_send_all_until(c, line, strlen(line), d) || sy_send_all_until(c, "\n", 1, d)) { sy_close(c); return 3; }
    while (rn < (long)sizeof resp - 1) { r = sy_recv_until(c, resp + rn, sizeof resp - 1 - rn, d); if (r <= 0) break; rn += r; }
    resp[rn] = 0; sy_close(c);
    if (rn == 0) return 3;
    return strncmp(resp, "OK\t", 3) ? 1 : 0;
}
static int say(int rc) { if (rn) fputs(resp, stdout); else if (rc == 3) fprintf(stderr, "devsvc: no instance at %s\n", sockp); return rc; }
static const char *opt(int argc, char **argv, const char *name, const char *def) {
    int i; for (i = 0; i + 1 < argc; i++) if (!strcmp(argv[i], name)) return argv[i + 1]; return def;
}

static long run_deadline_ms = 60000;   /* qualify 放宽为自身逐批有界(每批 60 秒)的总上限 */
static const char *report_kind;
static long report_window, report_epoch;
static int report_pid;
static void report_end(const char *kind,const char *job) {
    char pid[32],epoch[32],window[32];
    if(!kind || !dir[0])return;
    cx_fmt(pid,sizeof pid,"%d",report_pid);cx_fmt(epoch,sizeof epoch,"%ld",report_epoch);
    cx_fmt(window,sizeof window,"%ld",report_window);
    char *v[]={"sh",cfg.product,"tools/dvreport.cx","--","--instance",dir,"--kind",(char*)kind,
               "--job",(char*)job,"--pid",pid,"--since-epoch",epoch,"--window-ms",window,0};
    sy_spawn_t o;sy_exit_t ex;sy_spawn_init(&o);o.argv=v;o.pgroup=-1;o.deadline_ms=35000;
    fflush(stdout);
    if(sy_proc_run(&o,&ex) || sy_exit_code(&ex))printf("REPORT\tcmd=%s\tjob=%s\tlongest=UNMEASURED\n",kind,job);
}
static int report_tool(const char *p) {
    const char *base=strrchr(p,'/');base=base?base+1:p;
    return !strcmp(base,"candidate-chain.cx") || !strcmp(base,"release-run.cx");
}
static int cmd_run(const char *root, int argc, char **argv) {   /* argv[0] = TOOL 或 --local */
    char bin[PW], req[2 * PW]; const char *cache = "?"; long prep = 0, t0, t1; int local = 0, rc, i; char *v[64];
    sy_spawn_t o; sy_exit_t ex;
    int quiet = getenv("DEVSVC_RUN_QUIET") && !strcmp(getenv("DEVSVC_RUN_QUIET"), "1");
    for (;;) {   /* TOOL 前的选项:--local、--quiet(抑制 DEVSVC_RUN 结果行)、--par N(与 flow、x 一致,接受并忽略) */
        if (argc > 0 && !strcmp(argv[0], "--local")) { local = 1; argc--; argv++; }
        else if (argc > 0 && !strcmp(argv[0], "--quiet")) { quiet = 1; argc--; argv++; }
        else if (argc > 1 && !strcmp(argv[0], "--par")) { argc -= 2; argv += 2; }
        else break;
    }
    if (argc > 3 && !strcmp(argv[1], "--par") && !strcmp(argv[3], "--")) { argv[2] = argv[0]; argc -= 2; argv += 2; }   /* TOOL --par N -- ARGS */
    if (argc < 1 || argc > 60) return 2;
    t0 = sy_now_ms(); bin[0] = 0;
    if (!local) {
        F(req, sizeof req, "native\t%s\t%s", root, argv[0]);
        rc = request(root, req, 1);
        if (rc == 0) {
            char *p = resp + 10, *e = strchr(p, '\t');   /* OK\tnative\tPATH\tcache=..\tms=.. */
            if (e) { *e = 0; F(bin, sizeof bin, "%s", p); cache = strstr(e + 1, "cache=hit") ? "hit" : strstr(e + 1, "cache=bypass") ? "bypass" : "miss"; }
        } else if (rc == 1) { fputs(resp, stderr); return 1; }
    }
    if (!bin[0]) { local = 1; rc = native_get(root, argv[0], bin, sizeof bin, &cache, &prep); if (rc) { char tl[3600]; build_tail(tl, sizeof tl); fprintf(stderr, "devsvc: cannot build %s rc=%d log=%s\n%s", argv[0], rc, nlog[0] ? nlog : "-", tl); return 1; } }
    t1 = sy_now_ms();
    {   int k = 1, sk = argc > 1 && !strcmp(argv[1], "--") ? 2 : 1;   /* 原生执行体不收驱动的 "--",TOOL 后紧跟的一个 "--" 去掉 */
        v[0] = bin; for (i = sk; i < argc; i++) v[k++] = argv[i]; v[k] = 0; }
    sy_spawn_init(&o); o.argv = v; o.flags = SY_SPAWN_NO_PATH; o.pgroup = -1; o.deadline_ms = run_deadline_ms;
    fflush(stdout);
    if(report_kind && !strcmp(report_kind,"qualify")) {
        sy_child_t child;rc=sy_proc_spawn(&o,&child);
        if(!rc){report_pid=child.pid;rc=sy_proc_wait(&child,&ex);sy_proc_close(&child);}
    } else rc = sy_proc_run(&o, &ex);
    if (!quiet) fprintf(stderr, "DEVSVC_RUN\t%s\tvia=%s\tcache=%s\tprep_ms=%ld\trun_ms=%ld\trc=%d\n", argv[0], local ? "local" : "service", cache, t1 - t0, sy_now_ms() - t1, rc ? -1 : sy_exit_code(&ex));
    return rc ? 1 : sy_exit_code(&ex);
}

static int cmd_onchange(const char *root, int argc, char **argv) {
    char bin[PW], req[EVW + 32]; const char *cache; long ms; int i, n = 0, posted = 0; char *v[64], *s, *e; static char out[1 << 16];
    if (argc < 1 || argc > 56) return 2;
    long tl = strlen(cfg.onchange_tag);
    F(req, sizeof req, "native\t%s\t%s", root, cfg.onchange);
    if (request(root, req, 1) == 0) { char *p = resp + 10; e = strchr(p, '\t'); if (!e) return 1; *e = 0; F(bin, sizeof bin, "%s", p); }
    else if (native_get(root, cfg.onchange, bin, sizeof bin, &cache, &ms)) return 1;
    v[n++] = bin; v[n++] = "--dry-run"; for (i = 0; i < argc; i++) v[n++] = argv[i]; v[n] = 0;
    runcap(v, out, sizeof out);
    for (s = out; *s; s = e + 1) {
        e = strchr(s, '\n'); if (!e) e = s + strlen(s) - 1; else *e = 0;
        if (!strncmp(s, cfg.onchange_tag, tl) && s[tl] == ' ') {
            puts(s);
            F(req, sizeof req, "emit\ton-change\t%.*s", EVW - 40, s + tl + 1);
            if (request(root, req, 1) == 0) posted++;
        }
        if (!e[1] && e[0]) break;
    }
    printf("DEVSVC_ONCHANGE\tposted=%d\n", posted);
    return 0;
}

static int cmd_rel(const char *root, int argc, char **argv) {
    char *req = 0, *reply = 0, chunk[16384]; long rlen = 0, rcap = 0, reql = 0, rr; int timing = 0, c, rc; sy_deadline_t d;
    if (rm_cli_prepare(root, cfg.product, argc, argv, &req, &reql, &timing) != 0) return 2;
    c = try_connect(1500);
    if (c < 0) { if (c == -ECONNREFUSED) sy_unlink(sockp); c = spawn_server(root, "1800", "300"); }
    if (c < 0) { mm_free(req); fprintf(stderr, "devsvc: no instance at %s\n", sockp); return 3; }
    d = sy_deadline_in(58000);
    if (sy_send_all_until(c, req, reql, d) || sy_send_all_until(c, "\n", 1, d)) { mm_free(req); sy_close(c); return 3; }
    mm_free(req);
    while ((rr = sy_recv_until(c, chunk, sizeof chunk, d)) > 0) {
        if (rlen + rr + 1 > rcap) {
            long ncap = rcap ? rcap * 2 : 32768; char *nb;
            while (ncap < rlen + rr + 1) ncap *= 2;
            nb = reply ? (char *)mm_grow(reply, ncap) : (char *)mm_alloc(ncap);
            if (!nb) { mm_free(reply); sy_close(c); return 3; }
            reply = nb; rcap = ncap;
        }
        mm_copy(reply + rlen, rcap - rlen, chunk, rr); rlen += rr; reply[rlen] = 0;
    }
    sy_close(c);
    if (!reply) return 3;
    rc = rm_cli_finish(reply, rlen, timing);
    mm_free(reply);
    return rc;
}

static int cmd_status(const char *root, int paths) {
    static char wt[1 << 14], st[1 << 18], ps[1 << 16]; char *s, *e, cur[PW], br[128]; int nwt = 0, dirty = 0, nproc = 0, up, nl = 0;
    char *v[] = {"git", "-C", (char *)root, "worktree", "list", "--porcelain", 0};
    cur[0] = 0; br[0] = 0;
    if (runcap(v, wt, sizeof wt - 2) != 0) { fprintf(stderr, "devsvc: git worktree list failed\n"); return 1; }
    {   long wn = strlen(wt); wt[wn] = '\n'; wt[wn + 1] = 0; }   /* runcap 留了 2 字节余量 */
    for (s = wt; *s; s = e + 1) {
        e = strchr(s, '\n'); if (!e) break; *e = 0;
        if (!strncmp(s, "worktree ", 9)) F(cur, sizeof cur, "%s", s + 9);
        else if (!strncmp(s, "branch ", 7)) F(br, sizeof br, "%s", strncmp(s + 7, "refs/heads/", 11) ? s + 7 : s + 18);
        else if (!*s && cur[0]) {
            char *g[] = {"git", "-C", cur, "status", "--porcelain", 0}; int m = 0, a = 0, u = 0, r; char *q, *qe;
            r = runcap(g, st, sizeof st);
            for (q = st; r == 0 && *q; q = qe + 1) {
                qe = strchr(q, '\n'); if (!qe) break; *qe = 0;
                if (q[0] == '?') u++; else { if (q[0] != ' ') a++; if (q[1] != ' ') m++; }
                if (paths) printf("PATH\t%s\t%.2s\t%s\n", br[0] ? br : "(detached)", q, q + 3);
                dirty++;
            }
            printf("WT\t%s\tbranch=%s\tstaged=%d\tunstaged=%d\tuntracked=%d%s\n", cur, br[0] ? br : "(detached)", a, m, u, r ? "\tstatus=UNMEASURED" : "");
            nwt++; cur[0] = 0; br[0] = 0;
        }
    }
    {   char *g[] = {"pgrep", "-af", cfg.proc_pat, 0}; char mine[32]; int ml = snprintf(mine, sizeof mine, "%d ", sy_pid());
        runcap(g, ps, sizeof ps);
        for (s = ps; *s; s = e + 1) {
            e = strchr(s, '\n'); if (!e) break; *e = 0;
            if (strncmp(s, mine, ml) && !strstr(s, "pgrep") && !strstr(s, "devsvc.cx -- status")) { clean(s); printf("PROC\t%.200s\n", s); nproc++; }
        } }
    up = request(root, "ping", 0) == 0;
    if (up) { chomp(resp); printf("SVC\tup\t%s\t%s\n", sockp, resp + 3); }
    else printf("SVC\tdown\t%s\n", sockp);
    if (up && request(root, "lock-list", 0) == 0) { s = strchr(resp, '\n'); if (s) { fputs(s + 1, stdout); for (s++; (s = strstr(s, "LOCK\t")); s++) nl++; } }
    printf("DEVSVC_STATUS\tworktrees=%d\tdirty_paths=%d\tprocs=%d\tsvc=%s\tlocks=%d\n", nwt, dirty, nproc, up ? "up" : "down", nl);
    return 0;
}

/* ---- flow:引擎在客户端进程里跑(服务单线程,不让长流堵住别的请求);服务给的是锁与事件环。无实例时只读流照跑,不取锁、不入环(via=local);
   含写节点的流先拉起实例,拉不起即 REFUSE writes-need-service(rc 1,不写)。 ---- */
static char fl_owner[64], held[MAXLOCK][64]; static int held_mine[MAXLOCK], nheld, svc_on, flow_needw;
static int local_writes_ok(void) { const char *e = getenv("DEVSVC_LOCAL_WRITES"); return e && !strcmp(e, "1"); }   /* 仅检查用:允许本地无锁写 */
/* 嵌套继承规则(plans/devsvc.md 第 3 节):devsvc 给子进程导出 UNISACC_FLOW_ROOT 时同时导出标记 UNISACC_FLOW_ROOT_JOB=<该根>。
   本进程根 ROOT 等于标记根或在其下 = 同仓嵌套,继承照旧;不在其下,且 UNISACC_FLOW_ROOT 仍是标记所记的那个继承值,就丢弃它改用 ROOT。
   未带标记的 UNISACC_FLOW_ROOT 视为调用者显式给的,始终保留。返回 0 成功。 */
static int dv_under(const char *r, const char *top) { long n = (long)strlen(top); return n > 0 && !strncmp(r, top, n) && (r[n] == 0 || r[n] == '/' || top[n - 1] == '/'); }
static int flow_root_env(const char *root) {
    const char *j = getenv("UNISACC_FLOW_ROOT_JOB"), *fr = getenv("UNISACC_FLOW_ROOT"); char keep[PW];
    if (fr && *fr && j && *j && !strcmp(fr, j) && !dv_under(root, j)) fr = 0;
    if (fr && *fr) { if (snprintf(keep, sizeof keep, "%s", fr) >= (int)sizeof keep) return -1; }
    else if (snprintf(keep, sizeof keep, "%s", root) >= (int)sizeof keep || setenv("UNISACC_FLOW_ROOT", keep, 1)) return -1;
    return setenv("UNISACC_FLOW_ROOT_JOB", keep, 1);
}
/* 写命令的实例探测:wr 时无实例先拉起(上限 40 s),拉不起打 REFUSE writes-need-service 返回 -1;否则 1 有实例、0 无(只读) */
static int wr_svc(const char *root, int wr) {
    int need = wr && !local_writes_ok();
    if (request(root, "ping", need) == 0) return 1;
    if (need) { fprintf(stderr, "devsvc: REFUSE writes-need-service: no instance at %s and autostart failed; nothing written\n", sockp); return -1; }
    return 0;
}
typedef struct { char *p; long n, cap; } AB;
static void ab_add(AB *a, const char *s, long n) {
    if (a->n + n + 1 > a->cap) { long c = (a->n + n + 1) * 2; char *q = realloc(a->p, c); if (!q) { ovf++; return; } a->p = q; a->cap = c; }
    if (n > 0 && mm_copy(a->p + a->n, a->cap - a->n, s, n)) { ovf++; return; }
    a->n += n; a->p[a->n] = 0;
}
/* 追加 k=v(v 按 flowfile 规则转义);同一节点内以 ';' 分隔 */
static void ab_kv(AB *a, const char *k, const char *v, long n) {
    char *d = malloc(3 * n + 1); long w;
    if (!d) { ovf++; return; }
    w = n ? ff_escape(v, n, d, 3 * n + 1) : 0;
    if (w < 0) { ovf++; free(d); return; }
    if (a->n && a->p[a->n - 1] != '\t') ab_add(a, ";", 1);
    ab_add(a, k, strlen(k)); ab_add(a, "=", 1); ab_add(a, d, w);
    free(d);
}
/* 锁名:路径在 ROOT 下则取相对段;含空白、控制字符或过长时取 sha: 加摘要前 16 位 */
static void lk_name(const char *root, const char *s, char *dst) {
    long rl = strlen(root); char hex[65]; const char *q; int plain;
    if (!strncmp(s, root, rl) && s[rl] == '/') s += rl + 1;
    plain = okname(s);
    for (q = s; plain && *q; q++) if ((unsigned char)*q <= ' ') plain = 0;
    if (plain) { F(dst, 64, "%s", s); return; }
    if (sy_sha256_hex(s, strlen(s), hex)) { ovf++; dst[0] = 0; return; }
    hex[16] = 0; F(dst, 64, "sha:%s", hex);
}
/* 0 拿到(或本次已持有);1 被他人持有或服务拒绝(resp 为 ERR 行);3 无实例。wait_ms 内每 100 ms 重试一次。 */
static int lk_take(const char *root, const char *name, long ttl, long wait_ms) {
    char req[320]; int i, rc; long end = sy_now_ms() + wait_ms;
    for (i = 0; i < nheld; i++) if (!strcmp(held[i], name)) return 0;
    if (nheld >= MAXLOCK) { rn = snprintf(resp, sizeof resp, "ERR\tfull\tmax=%d\n", MAXLOCK); return 1; }
    if (ttl > LOCK_TTL_MAX) ttl = LOCK_TTL_MAX;
    {   char pt[96]; pi_self_tag(0, pt, sizeof pt); F(req, sizeof req, "lock-acquire\t%s\t%s\t%ld\t%s", name, fl_owner, ttl, pt); }
    for (;;) {
        rc = request(root, req, 0);
        if (rc == 0) { F(held[nheld], 64, "%s", name); held_mine[nheld] = !strncmp(resp, "OK\tacquired", 11); nheld++; return 0; }
        if (rc != 1 || strncmp(resp, "ERR\theld", 8) || sy_now_ms() >= end) return rc;
        sy_sleep_ms(100);
    }
}
/* 只放本次新拿到的;调用方用 --owner 带进来的已持有锁(应答 renewed)不放 */
static void lk_drop(const char *root) {
    char req[200]; int i;
    for (i = 0; i < nheld; i++) if (held_mine[i]) { F(req, sizeof req, "lock-release\t%s\t%s", held[i], fl_owner); request(root, req, 0); }
    nheld = 0;
}
static void flow_emit(const char *root, const char *text) {
    char req[440], *q; int w;   /* 事件正文超出即截断并以 ~ 标记(环的定长合同;服务端对超长 emit 直接拒绝) */
    if (!svc_on) return;
    w = snprintf(req, sizeof req, "emit\tflow.node\t%s", text);
    if (w < 0) return;
    if (w >= (int)sizeof req) req[sizeof req - 2] = '~';
    for (q = req; *q; q++) if (*q == '\n' || *q == '\r') *q = ' ';
    request(root, req, 0);
}
static void dump(const char *path, FILE *to) {
    unsigned char *b = 0; int64_t n = 0;
    if (sy_read_file(path, &b, &n, 1 << 26) || !b) return;
    if (n > 0) fwrite(b, 1, (size_t)n, to);
    free(b);
}
/* 节点结果里的 sha:write/edit 取算子输出首行;整文件 read(无行段)取输出内容摘要 */
static void node_sha(const char *rdir, fl_node *nd, char *dst, int cap) {
    char p[PW + 300], t[32], hex[65]; unsigned char *b = 0; int64_t n = 0;
    dst[0] = 0;
    if (!strncmp(nd->op, "file.", 5) && nd->state == FL_OK) {
        F(p, sizeof p, "%s/out/%s.out", rdir, nd->id);
        if (sy_read_file(p, &b, &n, 1 << 26) || !b) return;
        if (strcmp(nd->op, "file.read")) { if (n >= 68 && !memcmp(b, "sha=", 4)) snprintf(dst, cap, "\tsha=%.64s", (char *)b + 4); }
        else if (fl_arg_get(nd->args, "offset_line", 0, t, sizeof t) == -1 && fl_arg_get(nd->args, "limit_line", 0, t, sizeof t) == -1
                 && !sy_sha256_hex(b, n, hex)) snprintf(dst, cap, "\tsha=%s", hex);
        free(b);
    }
}
static int cancel_hit(void) { return sy_sig_taken(SIGINT) + sy_sig_taken(SIGTERM) + sy_sig_taken(SIGHUP) > 0; }
static char x_last_err[PW + 300];   /* xmode 最近一次作业的 .err 路径(git commit 失败时回打尾部) */
/* PATH 的最后 MAXL 行打到 stderr,前缀 GIT_COMMIT_ERR */
static void err_tail(const char *path, int maxl) {
    unsigned char *b = 0; int64_t n = 0; long i, st; int lines = 0;
    if (!path[0] || sy_read_file(path, &b, &n, 1 << 24) || !b) return;
    while (n > 0 && b[n - 1] == '\n') n--;
    for (i = n - 1; i >= 0; i--) if (b[i] == '\n' && ++lines >= maxl) break;
    st = i + 1;
    while (st < n) { long e = st; while (e < n && b[e] != '\n') e++; fprintf(stderr, "GIT_COMMIT_ERR\t%.*s\n", (int)(e - st), (char *)b + st); st = e + 1; }
    free(b);
}
/* ---- 输出控制(x、flow、wait):--tail N、--head N、--grep S(固定串,可多次,行级或)、--summary(每节点一行)。
   任一出现即:全量输出落 run 目录(x/flow 为 RUN/full.out,wait 为作业 out),先 grep 再 head 再 tail;
   有行被略去时打 DEVSVC_TRIMMED<TAB>shown=N<TAB>total=M;末行 OUT=路径。都不给时行为不变。 ---- */
#define OC_GREP 8
static long numarg(const char *s);
static struct { long tail, head; int ng, summary, on; const char *grep[OC_GREP]; } oc;
static AB ocb;
/* argv[a] 是输出控制选项则吃掉,返回消耗个数;非此类 0;用法错 -1 */
static int oc_opt(int argc, char **argv, int a) {
    if (!strcmp(argv[a], "--summary")) { oc.summary = 1; oc.on = 1; return 1; }
    if (!strcmp(argv[a], "--tail") || !strcmp(argv[a], "--head")) {
        long n = a + 1 < argc ? numarg(argv[a + 1]) : -1;
        if (n < 1) return -1;
        if (argv[a][2] == 't') oc.tail = n; else oc.head = n;
        oc.on = 1; return 2;
    }
    if (!strcmp(argv[a], "--grep")) {
        if (a + 1 >= argc || !argv[a + 1][0] || oc.ng >= OC_GREP) return -1;
        oc.grep[oc.ng++] = argv[a + 1]; oc.on = 1; return 2;
    }
    return 0;
}
static void outs(const char *s, long n) { if (oc.on) ab_add(&ocb, s, n); else if (n > 0) fwrite(s, 1, (size_t)n, stdout); }
static void outfile(const char *path) {
    unsigned char *b = 0; int64_t n = 0;
    if (sy_read_file(path, &b, &n, 1 << 26) || !b) return;
    outs((char *)b, (long)n); free(b);
}
static int oc_hit(const char *s, long n) {
    int g; long k, gl;
    if (!oc.ng) return 1;
    for (g = 0; g < oc.ng; g++) { gl = strlen(oc.grep[g]); for (k = 0; k + gl <= n; k++) if (!memcmp(s + k, oc.grep[g], gl)) return 1; }
    return 0;
}
/* 按 grep/head/tail 打 TXT 的行 */
static void oc_emit(const char *t, long n) {
    long i, st, total = 0, m = 0, s, e, *ls = 0, *le = 0, cap = 0;
    for (st = 0; st < n; ) {
        long en = st; while (en < n && t[en] != '\n') en++;
        total++;
        if (oc_hit(t + st, en - st)) {
            if (m >= cap) { long c = cap ? cap * 2 : 256; long *a = realloc(ls, c * sizeof *ls), *b2; if (!a) break; ls = a; b2 = realloc(le, c * sizeof *le); if (!b2) break; le = b2; cap = c; }
            ls[m] = st; le[m] = en; m++;
        }
        st = en + 1;
    }
    e = oc.head && oc.head < m ? oc.head : m;
    s = oc.tail && e > oc.tail ? e - oc.tail : 0;
    for (i = s; i < e; i++) printf("%.*s\n", (int)(le[i] - ls[i]), t + ls[i]);
    if (e - s < total) printf("DEVSVC_TRIMMED\tshown=%ld\ttotal=%ld\n", e - s, total);
    free(ls); free(le);
}
/* 文件的行数与首个含 FAIL/REFUSE/error 的行(未找到时 first 不变) */
static long oc_scan(const char *path, char *first, int cap) {
    unsigned char *b = 0; int64_t n = 0; long st, lines = 0; static const char *pat[] = {"FAIL", "REFUSE", "error", 0};
    if (sy_read_file(path, &b, &n, 1 << 26) || !b) return 0;
    for (st = 0; st < n; ) {
        long en = st, k; int j; while (en < n && b[en] != '\n') en++;
        lines++;
        for (j = 0; !first[0] && pat[j]; j++) { long pl = strlen(pat[j]); for (k = st; k + pl <= en; k++) if (!memcmp(b + k, pat[j], pl)) { F(first, cap, "%.*s", (int)(en - st > 300 ? 300 : en - st), (char *)b + st); clean(first); break; } }
        st = en + 1;
    }
    free(b); return lines;
}
/* 落全量,打过滤结果;summary 时 SUMS 为已拼好的每节点行 */
static void oc_finish(const char *full, const char *sums, long shown) {   /* 只过滤前 shown 字节(其后是仅落盘的附录) */
    if (sy_write_atomic(full, ocb.p ? ocb.p : "", ocb.n, 0644)) fprintf(stderr, "devsvc: cannot write %s\n", full);
    if (shown > ocb.n) shown = ocb.n;
    if (oc.summary) fputs(sums ? sums : "", stdout); else oc_emit(ocb.p ? ocb.p : "", shown);
    printf("OUT=%s\n", full); fflush(stdout);
}
/* 每节点一行:SUM id rc ms lines first */
static void oc_sum(AB *a, const char *rdir, const char *id, int rc, const char *ms) {
    char p[PW + 300], first[320] = "", ln[800]; long nl;
    F(p, sizeof p, "%s/out/%s.out", rdir, id); nl = oc_scan(p, first, sizeof first);
    F(p, sizeof p, "%s/out/%s.err", rdir, id); nl += oc_scan(p, first, sizeof first);
    F(ln, sizeof ln, "SUM\t%s\trc=%d\tms=%s\tlines=%ld\tfirst=%s\n", id, rc, ms, nl, first[0] ? first : "-");
    ab_add(a, ln, strlen(ln));
}
static int flow_txn;   /* flow --txn:事务化(同节点表首行 txn 1),引擎见 cxlib.flowexec 头注 Transaction 段 */
static const char *lock_for(const char *p);
/* text 非空即内联节点表(写进 RUN/flow.tsv)。xmode:单条 exec,把节点 stdout/stderr 原样转出,返回节点退出码。 */
static int flow_go(const char *root, const char *file, const char *text, const char *rdir_in, int jobs, long dl, int cat, long wait_ms, int xmode) {
    static fl_flow f; fl_sum s; char why[1024], rdir[PW], p[PW + 300], nm[64], xst[16] = "?", xms[24] = "0"; int i, r, nl; unsigned char *eb = 0; int64_t en = 0; AB sums = {0, 0, 0};
    if (rdir_in) F(rdir, sizeof rdir, "%s", rdir_in); else F(rdir, sizeof rdir, "%s/devsvc-flow-%ld-%d", sy_tmpdir(), sy_now_ms(), sy_pid());
    if (ovf || sy_mkdir_all(rdir, 0755)) { fprintf(stderr, "devsvc: REFUSE run dir %s unusable\n", rdir); return 2; }
    if (text) {
        F(p, sizeof p, "%s/flow.tsv", rdir);
        if (sy_write_atomic(p, text, strlen(text), 0644)) { fprintf(stderr, "devsvc: REFUSE cannot write %s\n", p); return 2; }
        file = p;
    }
    if (fl_load(file, &f, why, (int)sizeof why)) { fprintf(stderr, "devsvc: REFUSE %s\n", why); return 2; }
    if (jobs < 1) jobs = f.par;   /* 命令行 --par 优先,其次节点表 par 行;都没有即拒绝(单节点也要写) */
    if (jobs < 1) { fprintf(stderr, "devsvc: REFUSE missing --par (give --par N, 1..32, or a flow line `par N`; one node too)\n"); fl_free(&f); return 2; }
    if (jobs > FL_MAX_JOBS) jobs = FL_MAX_JOBS;
    if (dl < 1) dl = FL_RUN_MS;
    if (flow_txn) f.txn = 1;
    long lock_begin=sy_now_ms();
    {   /* 写节点(file.write/edit、doc 写、stdout_to、lock 键、事务)必须持锁:无实例先拉起,拉不起具名拒绝,不静默转本地无锁写 */
        int needw = f.txn; char tb[8];
        for (i = 0; !needw && i < f.count; i++) if (f.n[i].lock[0] || fl_arg_get(f.n[i].args, "stdout_to", 0, tb, sizeof tb) != -1) needw = 1;
        flow_needw = needw && !local_writes_ok();
        if ((svc_on = wr_svc(root, needw)) < 0) { fl_free(&f); return 1; }
    }
    if (svc_on && f.txn) {   /* 事务:节点锁加写路径所属共享表锁(配置表 lock 行),去重排序后按固定顺序一次取齐 */
        static char nms[FL_MAX_NODES * 2][64]; static char pth[PW]; int nn = 0, a, b; const char *lf; long rl = strlen(root);
        for (i = 0; i < f.count; i++) if (f.n[i].lock[0]) {
            lk_name(root, f.n[i].lock, nms[nn]); if (nms[nn][0]) nn++;
            if (fl_arg_get(f.n[i].args, "path", 0, pth, sizeof pth) > 0) {
                const char *rp = pth; if (!strncmp(rp, root, rl) && rp[rl] == '/') rp += rl + 1;
                if ((lf = lock_for(rp))) { F(nms[nn], 64, "%s", lf); nn++; }
            }
        }
        for (a = 1; a < nn; a++) { char t[64]; F(t, 64, "%s", nms[a]); for (b = a; b > 0 && strcmp(nms[b - 1], t) > 0; b--) F(nms[b], 64, "%s", nms[b - 1]); F(nms[b], 64, "%s", t); }
        for (a = 0; a < nn; a++) {
            if (a && !strcmp(nms[a], nms[a - 1])) continue;
            r = lk_take(root, nms[a], dl / 1000 + 10, wait_ms);
            if (r == 3 && flow_needw) { fprintf(stderr, "devsvc: REFUSE writes-need-service: instance lost while taking %s; nothing written\n", nms[a]); lk_drop(root); fl_free(&f); return 1; }
            if (r == 3) { svc_on = 0; nheld = 0; break; }
            if (r) { chomp(resp); fprintf(stderr, "devsvc: REFUSE txn lock %s: %s\n", nms[a], resp); lk_drop(root); fl_free(&f); return 1; }
        }
    } else
    for (i = 0; svc_on && i < f.count; i++) if (f.n[i].lock[0]) {
        lk_name(root, f.n[i].lock, nm);
        r = lk_take(root, nm, dl / 1000 + 10, wait_ms);
        if (r == 3 && flow_needw) { fprintf(stderr, "devsvc: REFUSE writes-need-service: instance lost while taking %s; nothing written\n", nm); lk_drop(root); fl_free(&f); return 1; }
        if (r == 3) { svc_on = 0; nheld = 0; break; }
        if (r) { chomp(resp); fprintf(stderr, "devsvc: REFUSE lock %s for node %s: %s\n", nm, f.n[i].id, resp); lk_drop(root); fl_free(&f); return 1; }
    }
    nl = nheld;
    if (flow_root_env(root)) { lk_drop(root); fl_free(&f); return 2; }
    sy_sig_watch(SIGINT); sy_sig_watch(SIGTERM); sy_sig_watch(SIGHUP);
    fl_set_cancel(cancel_hit);
    { long t0c = sy_now_ms();
      r = fl_run(&f, rdir, jobs, dl, 0, &s);
      dt_flow(lock_begin,t0c,r<0?r:(xmode?f.n[0].rc:(s.fail||s.timeout?1:0)));
      lk_drop(root);
      if (fl_was_cancelled()) {   /* 客户端被 Ctrl-C/TERM/HUP:进程组已杀、锁已放,记事件后以 130 退出 */
          char rq[400]; F(rq, sizeof rq, "emit\tx.cancelled\towner=%s ms=%ld nodes=%d run=%s", fl_owner, sy_now_ms() - t0c, f.count, rdir);
          if (svc_on) request(root, rq, 0);
          fprintf(stderr, "devsvc: CANCELLED owner=%s ms=%ld run=%s\n", fl_owner, sy_now_ms() - t0c, rdir);
          fl_free(&f); return 130;
      } }
    if (r < 0) { fprintf(stderr, "devsvc: REFUSE run dir %s unusable (%d)\n", rdir, r); fl_free(&f); return 2; }
    F(p, sizeof p, "%s/events.tsv", rdir);
    if (sy_read_file(p, &eb, &en, 1 << 24) == 0 && eb) {
        char *q = (char *)eb, *e, *c[7], sha[80], ln[1600]; int nc, k;
        for (; (e = memchr(q, '\n', (char *)eb + en - q)); q = e + 1) {
            *e = 0;
            if (strncmp(q, "EVT\t", 4)) continue;
            flow_emit(root, q + 4);
            for (nc = 0, c[0] = q; nc < 6 && (c[nc + 1] = strchr(c[nc], '\t')); nc++) *c[nc + 1]++ = 0;
            if (nc < 6 || !strcmp(c[3], "start")) continue;
            for (k = 0; k < f.count && strcmp(f.n[k].id, c[2]); k++) ;
            if (xmode) { F(xst, sizeof xst, "%s", c[3]); F(xms, sizeof xms, "%s", c[4]); continue; }
            if (oc.summary && k < f.count) oc_sum(&sums, rdir, c[2], f.n[k].rc, c[4]);
            sha[0] = 0; if (k < f.count) node_sha(rdir, &f.n[k], sha, sizeof sha);
            F(ln, sizeof ln, "NODE\t%s\t%s\trc=%s\tms=%s\t%s%s\n", c[2], c[3], c[5], c[4], c[6], sha);
            outs(ln, strlen(ln));
        }
        free(eb);
    }
    if (xmode && oc.on) {   /* 输出控制:stdout 后接 stderr 合一过滤,X 行照旧走 stderr,末行 OUT= */
        F(p, sizeof p, "%s/out/%s.out", rdir, f.n[0].id); outfile(p);
        F(p, sizeof p, "%s/out/%s.err", rdir, f.n[0].id); outfile(p); F(x_last_err, sizeof x_last_err, "%s", p);
        if (oc.summary) oc_sum(&sums, rdir, f.n[0].id, f.n[0].rc, xms);
        fprintf(stderr, "X\t%s\trc=%d\tms=%s\tvia=%s\trun=%s\n", xst, f.n[0].rc, xms, svc_on ? "service" : "local", rdir); fflush(stderr);
        F(p, sizeof p, "%s/full.out", rdir); oc_finish(p, sums.p, ocb.n);
        r = f.n[0].rc < 0 ? 1 : f.n[0].rc; fl_free(&f); free(sums.p);
        return r;
    }
    if (xmode) {
        fflush(stdout);
        F(p, sizeof p, "%s/out/%s.out", rdir, f.n[0].id); dump(p, stdout); fflush(stdout);
        F(p, sizeof p, "%s/out/%s.err", rdir, f.n[0].id); dump(p, stderr); F(x_last_err, sizeof x_last_err, "%s", p);
        fprintf(stderr, "X\t%s\trc=%d\tms=%s\tvia=%s\trun=%s\n", xst, f.n[0].rc, xms, svc_on ? "service" : "local", rdir);
        r = f.n[0].rc < 0 ? 1 : f.n[0].rc; fl_free(&f);
        return r;
    }
    for (i = 0; cat && i < f.count; i++) {
        sy_stat_t st; long on, en2;
        F(p, sizeof p, "%s/out/%s.out", rdir, f.n[i].id); on = sy_stat(p, &st) == 0 ? (long)st.size : 0;
        char hd[200];
        if (on > 0) { F(hd, sizeof hd, "==> %s.out %ld <==\n", f.n[i].id, on); outs(hd, strlen(hd)); fflush(stdout); outfile(p); outs("\n", 1); }
        F(p, sizeof p, "%s/out/%s.err", rdir, f.n[i].id); en2 = sy_stat(p, &st) == 0 ? (long)st.size : 0;
        if (en2 > 0) { F(hd, sizeof hd, "==> %s.err %ld <==\n", f.n[i].id, en2); outs(hd, strlen(hd)); fflush(stdout); outfile(p); outs("\n", 1); }
    }
    {   char ln[PW + 400];
        F(ln, sizeof ln, "DEVSVC_FLOW\tnodes=%d\tok=%d\tfail=%d\ttimeout=%d\tskip=%d\twall_ms=%ld\tpeak=%d\tjobs=%d\tvia=%s\tlocks=%d\tpeak_tokens=%d\tadmit_wait_ms=%ld\tadmit=%s\tload_defer=%d\trun=%s\n",
          f.count, s.ok, s.fail, s.timeout, s.skip, s.wall_ms, s.max_running, jobs, svc_on ? "service" : "local", nl, s.peak_tokens, s.admit_wait_ms,
          s.load_timeout ? "timeout" : s.load_defer ? "deferred" : "ok", s.load_defer, rdir);
        outs(ln, strlen(ln)); }
    if (oc.on) {   /* --cat 未给时全量仍含各节点输出(附录,只落盘不参与过滤),便于事后查看 */
        long keep = ocb.n;
        for (i = 0; !cat && i < f.count; i++) {
            char hd[200];
            F(hd, sizeof hd, "==> %s.out <==\n", f.n[i].id); ab_add(&ocb, hd, strlen(hd)); F(p, sizeof p, "%s/out/%s.out", rdir, f.n[i].id); outfile(p);
            F(hd, sizeof hd, "==> %s.err <==\n", f.n[i].id); ab_add(&ocb, hd, strlen(hd)); F(p, sizeof p, "%s/out/%s.err", rdir, f.n[i].id); outfile(p);
        }
        F(p, sizeof p, "%s/full.out", rdir); oc_finish(p, sums.p, keep);
    }
    fl_free(&f); free(sums.p);
    return r;
}
static long numarg(const char *s) { long n = 0; if (!s || !*s) return -1; while (*s >= '0' && *s <= '9') { n = n * 10 + (*s++ - '0'); if (n > 100000000L) return -1; } return *s ? -1 : n; }
static void set_owner(int argc, char **argv) {
    const char *o = opt(argc, argv, "--owner", "");
    if (okname(o)) F(fl_owner, sizeof fl_owner, "%s", o); else F(fl_owner, sizeof fl_owner, "flow-%d", sy_pid());
}

static int x_ran;   /* cmd_x/cmd_flow 已把命令交给 flow 执行(子命令或节点非零 rc 不是参数错) */
#define FLOW_USE "usage: devsvc flow [run] FILE|- --par N [--bg] [--txn] [--cat] [--deadline-ms N] [--run DIR]  (options may sit before or after run FILE)"
#define X_USE "usage: devsvc x --par N [--tail N] [--timeout-ms N] [--cwd D] -- ARGV...  (options before --; after -- all is the command)"
static int cmd_flow(const char *root, int argc, char **argv) {   /* flow run FILE|- 或 flow - */
    const char *file = 0, *rdir = 0; char *text = 0; int a = 0, jobs = 0, cat = 0, oa; long dl = 0, wait = 0;
    int seen = 0;
    for (; a < argc; a++) {
        if (!strcmp(argv[a], "--cat") || !strcmp(argv[a], "--echo")) cat = 1;
        else if ((!strcmp(argv[a], "--par") || !strcmp(argv[a], "--jobs")) && a + 1 < argc) { long v = numarg(argv[++a]); if (v < 1 || v > 32) { fprintf(stderr, "devsvc: REFUSE --par wants 1..32\n"); return 2; } jobs = (int)v; }
        else if (!strcmp(argv[a], "--deadline-ms") && a + 1 < argc) { dl = numarg(argv[++a]); if (dl < 1 || dl > 3600000L) return 2; }
        else if (!strcmp(argv[a], "--lock-wait-ms") && a + 1 < argc) { wait = numarg(argv[++a]); if (wait < 0 || wait > 60000) return 2; }
        else if (!strcmp(argv[a], "--run") && a + 1 < argc) rdir = argv[++a];
        else if (!strcmp(argv[a], "--txn")) flow_txn = 1;
        else if (!strcmp(argv[a], "--owner") && a + 1 < argc) a++;
        else if ((oa = oc_opt(argc, argv, a))) { if (oa < 0) return 2; a += oa - 1; }
        else if (argv[a][0] == '-' && argv[a][1]) { fprintf(stderr, "devsvc: REFUSE flow: unknown or incomplete option %s\n%s\n", argv[a], FLOW_USE); return 2; }
        else if (!seen && !file && !strcmp(argv[a], "run")) seen = 1;
        else if (!file) file = argv[a];
        else { fprintf(stderr, "devsvc: REFUSE flow: unexpected word %s%s\n%s\n", argv[a], seen ? " after run FILE" : " (one FILE only)", FLOW_USE); return 2; }
    }
    if (!file) { fprintf(stderr, "devsvc: REFUSE flow: missing FILE\n%s\n", FLOW_USE); return 2; }
    set_owner(argc, argv);
    if (!strcmp(file, "-")) {
        AB b = {0, 0, 0}; char chunk[65536]; size_t k;
        while ((k = fread(chunk, 1, sizeof chunk, stdin)) > 0) { ab_add(&b, chunk, (long)k); if (b.n > (16L << 20)) return 2; }
        if (!b.p) { fprintf(stderr, "devsvc: REFUSE empty flow on stdin\n"); return 2; }
        text = b.p;
    }
    x_ran = 1;   /* 已过参数解析:此后 rc 为节点或 flow 结果,入口不再报 bad flow arguments */
    return flow_go(root, file, text, rdir, jobs, dl, cat, wait, 0);
}

static int cmd_x(const char *root, int argc, char **argv) {   /* x --par N [--timeout-ms N] [--cwd D] -- ARGV... */
    AB b = {0, 0, 0}; int a = 0, k = 0, par = 0; long tm = FL_NODE_MS; const char *cwd = 0; char key[16], num[32];
    for (; a < argc; a++) {
        if (!strcmp(argv[a], "--")) { a++; break; }
        else if (!strcmp(argv[a], "--par") && a + 1 < argc) { long v = numarg(argv[++a]); if (v < 1 || v > 32) { fprintf(stderr, "devsvc: REFUSE --par wants 1..32\n"); return 2; } par = (int)v; }
        else if (!strcmp(argv[a], "--timeout-ms") && a + 1 < argc) { tm = numarg(argv[++a]); if (tm < 1 || tm > FL_NODE_MAX_MS) return 2; }
        else if (!strcmp(argv[a], "--cwd") && a + 1 < argc) cwd = argv[++a];
        else if ((k = oc_opt(argc, argv, a))) { if (k < 0) return 2; a += k - 1; k = 0; }
        else if (argv[a][0] == '-' && argv[a][1]) { fprintf(stderr, "devsvc: REFUSE x: unknown or incomplete option %s\n%s\n", argv[a], X_USE); return 2; }
        else break;
    }
    if (a >= argc || argc - a > FL_MAX_ARGV) { fprintf(stderr, "devsvc: REFUSE x: %s\n%s\n", a >= argc ? "missing command after --" : "too many command words", X_USE); return 2; }
    for(int j=a;j<argc;j++) {
        if(report_tool(argv[j])){report_kind="x";report_window=tm;break;}
        const char *p=strrchr(argv[j],'/');p=p?p+1:argv[j];
        if(strcmp(p,"sh") && strcmp(p,"unisacc.com"))break;
    }
    if (!par) { fprintf(stderr, "devsvc: REFUSE missing --par (x needs --par N, 1..32; one command is --par 1)\n%s\n", X_USE); return 2; }
    if (!strcmp(argv[a], "git") && a + 1 < argc) {   /* 危险 git 子命令具名拒绝(rc 125);DEVSVC_ALLOW_DANGEROUS=1 放行并记事件。先跳过 -C X、-c X、--git-dir= 等前置选项再取子命令词 */
        static const char *bad[] = {"stash", "reset", "clean", "checkout", "restore", "rebase", 0};
        static const char *withval[] = {"-C", "-c", "--git-dir", "--work-tree", "--namespace", "--super-prefix", "--config-env", 0};
        const char *hit = 0, *al = getenv("DEVSVC_ALLOW_DANGEROUS"); int j, g = a + 1;
        while (g < argc && argv[g][0] == '-') {
            int v = 0; for (j = 0; withval[j]; j++) if (!strcmp(argv[g], withval[j])) v = 1;
            g += (v && g + 1 < argc) ? 2 : 1;
        }
        if (g < argc) for (j = 0; bad[j]; j++) if (!strcmp(argv[g], bad[j])) hit = bad[j];
        if (g < argc && !strcmp(argv[g], "push")) for (j = g + 1; j < argc; j++) if (!strcmp(argv[j], "--force") || !strcmp(argv[j], "-f") || !strncmp(argv[j], "--force-with-lease", 18)) hit = "push --force";
        if (hit && (!al || strcmp(al, "1"))) { fprintf(stderr, "devsvc: REFUSE x git %s: dangerous on a shared checkout (set DEVSVC_ALLOW_DANGEROUS=1 to override)\n", hit); return 125; }
        if (hit) { char rq[200]; F(rq, sizeof rq, "emit\tx.dangerous\tgit %s pid=%d", hit, sy_pid()); request(root, rq, 0); }
    }
    ab_add(&b, "x\texec\t-\t", 9);
    F(num, sizeof num, "%ld", tm); ab_kv(&b, "timeout_ms", num, strlen(num));
    if (cwd) ab_kv(&b, "cwd", cwd, strlen(cwd));
    for (; a < argc; a++, k++) { F(key, sizeof key, "a%d", k); ab_kv(&b, key, argv[a], strlen(argv[a])); }
    ab_add(&b, "\n", 1);
    if (ovf) return 2;
    F(fl_owner, sizeof fl_owner, "flow-%d", sy_pid());
    x_ran = 1;   /* 已过参数解析:此后 rc 为子命令或 flow 结果,入口不再报 bad x arguments */
    return flow_go(root, 0, b.p, 0, par, tm + 5000, 0, 0, 1);
}

/* ---- stdin 原文入口(f write/edit/edits --stdin):免先用原生工具备 old/new 文件 ---- */
#define SEP_NEW "@@DEVSVC-NEW@@"
#define SEP_NEXT "@@DEVSVC-NEXT@@"
static int flag(int argc, char **argv, const char *f) { int i; for (i = 0; i < argc; i++) if (!strcmp(argv[i], f)) return 1; return 0; }
/* stdin 全部读进 big;返回字节数,装不下返回 -1(不静默截断) */
static long stdin_all(void) {
    long n = 0, r;
    while (n < (long)sizeof big - 1 && (r = (long)fread(big + n, 1, sizeof big - 1 - n, stdin)) > 0) n += r;
    big[n] = 0;
    return n < (long)sizeof big - 1 ? n : -1;
}
/* 在 s[from, n) 里找独占一行的 sep:返回该行行首偏移,*after 为其下一行行首(或 n);没有返回 -1 */
static long sep_line(const char *s, long n, long from, const char *sep, long *after) {
    long sl = strlen(sep), i = from;
    while (i + sl <= n) {
        const char *q;
        if ((i == 0 || s[i - 1] == '\n') && !memcmp(s + i, sep, sl) && (i + sl == n || s[i + sl] == '\n')) { *after = i + sl < n ? i + sl + 1 : n; return i; }
        q = memchr(s + i, '\n', n - i); if (!q) break;
        i = q - s + 1;
    }
    return -1;
}

/* f read PATH [OFF LIM] | f write PATH --from SRC [--expect-sha X] [--mkdir] | f edit PATH --old-file A --new-file B [--expect-sha X] [--all] [--chomp]
   f write PATH --stdin | f edit PATH --stdin [--sep L] [--all] | f edits PATH --stdin [--sep L] [--sep-next L] [--expect-sha X]
   直接调 file 算子(单节点不必过引擎);write/edit 在有实例时先取路径锁。 */
static int cmd_f(const char *root, int argc, char **argv) {
    AB b = {0, 0, 0}; ff_out o; const char *op, *path, *xs; char fop[16], nm[64], ev[EVW]; int r, i, wr; long t0 = sy_now_ms(), wait;
    if (argc < 2) return 2;
    op = argv[0]; path = argv[1];
    static char tmpf[PW], ehex[65]; int nedit = 0;
    tmpf[0] = 0;
    if (strcmp(op, "read") && strcmp(op, "write") && strcmp(op, "edit") && strcmp(op, "edits")) return 2;
    wr = strcmp(op, "read") != 0;
    F(fop, sizeof fop, "file.%s", !strcmp(op, "edits") ? "write" : op);
    ab_kv(&b, "path", path, strlen(path));
    xs = opt(argc, argv, "--expect-sha", "");
    if (!wr) {
        if (argc >= 3 && numarg(argv[2]) >= 0) ab_kv(&b, "offset_line", argv[2], strlen(argv[2]));
        if (argc >= 4 && numarg(argv[3]) >= 0) ab_kv(&b, "limit_line", argv[3], strlen(argv[3]));
    } else if (!strcmp(op, "write")) {
        const char *src = opt(argc, argv, "--from", "");
        if (flag(argc, argv, "--stdin")) {   /* 内容即 stdin 全部字节(不去尾换行),经私有临时文件交给 file.write 原子落盘 */
            long n = stdin_all();
            if (*src || n < 0) { fprintf(stderr, "F\twrite\tfail\tEARG: --stdin excludes --from; stdin limit %ld bytes\n", (long)sizeof big - 2); return 1; }
            F(tmpf, sizeof tmpf, "/tmp/devsvc-stdin-%d.tmp", sy_pid());
            if (sy_write_file(tmpf, big, n, 0600)) { fprintf(stderr, "F\twrite\tfail\tEIO: cannot stage %s\n", tmpf); return 1; }
            src = tmpf;
        }
        if (!*src) return 2;
        ab_kv(&b, "from", src, strlen(src));
        for (i = 2; i < argc; i++) if (!strcmp(argv[i], "--mkdir")) ab_kv(&b, "mkdir", "1", 1);
    } else if (!strcmp(op, "edits")) {
        /* 多组 old/new 在内存里依次套用(每组 old 须在当时内容里恰好出现一次),全部成功才经 file.write 一次原子落盘;
           落盘带 expect_sha=读入时的摘要,期间别人改过即 ESHA 拒绝。任何一组失败则文件不动。 */
        unsigned char *cur = 0; int64_t cn = 0; long n, g0 = 0;
        const char *sep = opt(argc, argv, "--sep", SEP_NEW), *nxt = opt(argc, argv, "--sep-next", SEP_NEXT);
        if (!flag(argc, argv, "--stdin") || !*sep || !*nxt || !strcmp(sep, nxt)) return 2;
        if ((n = stdin_all()) < 0) { fprintf(stderr, "F\tedits\tfail\tEARG: stdin limit %ld bytes\n", (long)sizeof big - 2); return 1; }
        {   /* 相对路径按写根解析(同 file.write:UNISACC_FLOW_ROOT,缺省仓根),不按 cwd;否则读的文件与落盘的文件可能不是同一个 */
            static char rp[PW]; const char *fr = getenv("UNISACC_FLOW_ROOT"); int k;
            k = path[0] == '/' ? snprintf(rp, sizeof rp, "%s", path) : snprintf(rp, sizeof rp, "%s/%s", fr && *fr ? fr : root, path);
            if (k < 0 || k >= (int)sizeof rp) { fprintf(stderr, "F\tedits\tfail\tEARG: path too long\n"); return 1; }
            if (sy_read_file(rp, &cur, &cn, 1 << 26) || !cur) { fprintf(stderr, "F\tedits\tfail\tENOENT: cannot read %s\n", rp); return 1; } }
        if (sy_sha256_hex(cur, cn, ehex)) { free(cur); return 1; }
        if (*xs && strcmp(xs, ehex)) { fprintf(stderr, "F\tedits\tfail\tESHA: expect %s have %s\n", xs, ehex); free(cur); return 1; }
        for (;;) {
            long aft = n, a2 = 0, a3 = 0, g1 = sep_line(big, n, g0, nxt, &aft), ge, p, ol, nl, at = -1, cnt = 0, k; unsigned char *nb2;
            if (g1 < 0) ge = n > g0 && big[n - 1] == '\n' ? n - 1 : n; else ge = g1 > g0 ? g1 - 1 : g0;
            p = sep_line(big, ge, g0, sep, &a2);
            if (p <= g0 || sep_line(big, ge, a2, sep, &a3) >= 0) {
                fprintf(stderr, "F\tedits\tfail\tEARG: group %d needs a non-empty old, then exactly one separator line %s\n", nedit + 1, sep); free(cur); return 1; }
            ol = p - 1 - g0; nl = ge > a2 ? ge - a2 : 0;
            if (ol <= 0) { fprintf(stderr, "F\tedits\tfail\tEARG: group %d old is empty\n", nedit + 1); free(cur); return 1; }
            for (k = 0; k + ol <= cn; k++) {
                unsigned char *q = memchr(cur + k, big[g0], cn - ol - k + 1);
                if (!q) break;
                k = q - cur;
                if (!memcmp(q, big + g0, ol)) { cnt++; at = k; }
            }
            if (cnt != 1) { fprintf(stderr, "F\tedits\tfail\t%s: group %d old matches %ld times (need exactly 1); nothing written\n", cnt ? "EMULTI" : "ENOMATCH", nedit + 1, cnt); free(cur); return 1; }
            nb2 = malloc(cn - ol + nl + 1);
            if (!nb2) { free(cur); return 1; }
            if ((at > 0 && mm_copy(nb2, cn - ol + nl + 1, cur, at)) || (nl > 0 && mm_copy(nb2 + at, cn - ol + nl + 1 - at, big + a2, nl))
                || (cn - at - ol > 0 && mm_copy(nb2 + at + nl, cn - ol + 1 - at, cur + at + ol, cn - at - ol))) { free(nb2); free(cur); return 1; }
            free(cur); cur = nb2; cn = cn - ol + nl; nedit++;
            if (g1 < 0) break;
            g0 = aft;
        }
        F(tmpf, sizeof tmpf, "/tmp/devsvc-stdin-%d.tmp", sy_pid());
        if (sy_write_file(tmpf, cur, cn, 0600)) { fprintf(stderr, "F\tedits\tfail\tEIO: cannot stage %s\n", tmpf); free(cur); return 1; }
        free(cur);
        ab_kv(&b, "from", tmpf, strlen(tmpf));
        xs = ehex;
    } else if (flag(argc, argv, "--stdin")) {
        /* stdin = old 段、独占一行的分隔标记、new 段;分隔行前的那个换行与 stdin 末尾的一个换行不算内容 */
        long n = stdin_all(), p, a2 = 0, a3 = 0, ge; const char *sep = opt(argc, argv, "--sep", SEP_NEW);
        if (n < 0 || !*sep) { fprintf(stderr, "F\tedit\tfail\tEARG: stdin limit %ld bytes\n", (long)sizeof big - 2); return 1; }
        ge = n > 0 && big[n - 1] == '\n' ? n - 1 : n;
        p = sep_line(big, ge, 0, sep, &a2);
        if (p <= 1 || sep_line(big, ge, a2, sep, &a3) >= 0) { fprintf(stderr, "F\tedit\tfail\tEARG: stdin needs a non-empty old, then exactly one separator line %s, then new\n", sep); return 1; }
        for (i = 2; i < argc; i++) if (!strcmp(argv[i], "--all")) ab_kv(&b, "replace_all", "1", 1);
        ab_kv(&b, "old", big, p - 1); ab_kv(&b, "new", big + a2, ge > a2 ? ge - a2 : 0);
    } else {
        const char *fa = opt(argc, argv, "--old-file", ""), *fb = opt(argc, argv, "--new-file", ""); unsigned char *ta = 0, *tb = 0; int64_t na = 0, nb = 0; int ch = 0;
        if (!*fa || !*fb) return 2;
        if (sy_read_file(fa, &ta, &na, 1 << 26) || sy_read_file(fb, &tb, &nb, 1 << 26)) { fprintf(stderr, "F\tedit\tfail\tEARG: cannot read --old-file or --new-file\n"); return 1; }
        for (i = 2; i < argc; i++) { if (!strcmp(argv[i], "--all")) ab_kv(&b, "replace_all", "1", 1); if (!strcmp(argv[i], "--chomp")) ch = 1; }
        if (ch) { if (na > 0 && ta[na - 1] == '\n') na--; if (nb > 0 && tb[nb - 1] == '\n') nb--; }
        ab_kv(&b, "old", ta ? (char *)ta : "", (long)na); ab_kv(&b, "new", tb ? (char *)tb : "", (long)nb);
        if (ta) free(ta);
        if (tb) free(tb);
    }
    if (wr && *xs) ab_kv(&b, "expect_sha", xs, strlen(xs));
    if (wr && flag(argc, argv, "--no-compile-check")) ab_kv(&b, "compile_check", "0", 1);
    if (ovf || !b.p) return 2;
    set_owner(argc, argv);
    wait = numarg(opt(argc, argv, "--lock-wait-ms", "0")); if (wait < 0 || wait > 60000) return 2;
    if ((svc_on = wr_svc(root, wr)) < 0) return 1;
    if (wr && svc_on) {
        lk_name(root, path, nm);
        {   /* 编译上下文表里带验收命令的路径:命令最长 55 秒,锁租期相应加长,写入期间不失锁 */
            char ck[32], cc[1024], cr[400]; int lease = 30 + wait / 1000;
            if (ff_ctx_lookup(root, path, ck, cc, sizeof cc, cr, sizeof cr) == 1 && strcmp(cc, "-")) lease += 60;
            r = lk_take(root, nm, lease, wait);
        }
        if (r == 3 && local_writes_ok()) svc_on = 0;
        else if (r == 3) { fprintf(stderr, "F\t%s\trefused\tREFUSE writes-need-service: instance lost; nothing written\n", op); return 1; }
        else if (r) { chomp(resp); fprintf(stderr, "F\t%s\trefused\tlock=%s\t%s\n", op, nm, resp); return 1; }
    }
    if (flow_root_env(root)) { lk_drop(root); return 2; }
    memset(&o, 0, sizeof o);
    r = ff_run(fop, b.p, &o);
    if (tmpf[0]) sy_unlink(tmpf);
    lk_drop(root);
    if (snprintf(ev, sizeof ev, "0\tf.%s\t%s\t%ld\t%d\t%.200s %.120s", op, r ? "fail" : "ok", sy_now_ms() - t0, r ? (o.rc ? o.rc : 1) : 0, path, r ? o.why : o.sha) > 0) flow_emit(root, ev);
    if (o.ccnote && snprintf(ev, sizeof ev, "0\tf.%s\t%s\t%ld\t0\towner=%s %.200s", o.ccnote == 1 ? "compile-skipped" : o.ccnote == 2 ? "compile-undecided" : o.ccnote == 3 ? "compile-context-skipped" : "compile-context-ok", "ok", sy_now_ms() - t0, fl_owner, path) > 0) flow_emit(root, ev);
    if (!r && (o.ccnote == 3 || o.ccnote == 4)) printf("%s\n", o.ccmsg);
    if (r && !strcmp(o.err, "ECOMPILE")) {
        fprintf(stderr, "F\t%s\trefused-compile\t%s\n", op, o.why);
        if (o.buf && o.n > 0) fwrite(o.buf, 1, (size_t)o.n, stderr);
        ff_out_free(&o); return 1;
    }
    if (r) { fprintf(stderr, "F\t%s\tfail\t%s\n", op, o.why); ff_out_free(&o); return 1; }
    if (!wr) {
        if (o.buf && o.n > 0) fwrite(o.buf, 1, (size_t)o.n, stdout);
        fflush(stdout);
        fprintf(stderr, "F\tread\tok\tsha=%s\tlines=%ld\tbytes=%ld\n", o.sha, o.lines, o.n);
    } else printf("F\t%s\tok\tsha=%s\tlines=%ld\tcount=%ld\tvia=%s\tlocks=%d\n", op, o.sha, o.lines, nedit ? (long)nedit : o.count, svc_on ? "svc" : "local", svc_on ? 1 : 0);
    ff_out_free(&o);
    return 0;
}

/* ---- doc:按 Markdown 标题节操作配置表 doc 行声明的文档(cxlib.flowdoc)。写操作内部取锁 doc:<文件>,调用者不感知;
   库内 expect_sha 兜底。doc OP FILE SECTION [k=v | k@=PATH ...] [--from F](set 的 content) [--expect-sha X] ---- */
static int doc_glob(const char *g, const char *s) {
    if (!*g) return !*s;
    if (*g == '*') { for (;;) { if (doc_glob(g + 1, s)) return 1; if (!*s || *s == '/') return 0; s++; } }
    return *s && *g == *s && doc_glob(g + 1, s + 1);
}
static int cmd_doc(const char *root, int argc, char **argv) {
    AB b = {0, 0, 0}; ff_out o; char fop[24], nm[64]; const char *op, *path, *xs, *src; int r, i, ok = 0, wr;
    if (argc < 2) return 2;
    op = argv[0]; path = argv[1];
    if (!strcmp(op, "create")) {   /* doc create FILE TITLE:新建,已存在拒绝;内容为一行一级标题;取锁 doc:<文件> */
        char full[PW], body[1024], lk[64]; int ex, got = 0; unsigned char *dummy = 0; (void)dummy;
        for (i = 0; i < cfg.ndoc; i++) if (doc_glob(cfg.docpat[i], path)) ok = 1;
        if (argc < 3 || !argv[2][0]) return 2;
        if (!ok || strstr(path, "..") || path[0] == '/') { fprintf(stderr, "DOC\tcreate\trefused\tEDOC: %s is not a doc of the repo table\n", path); return 1; }
        set_owner(argc, argv);
        if ((svc_on = wr_svc(root, 1)) < 0) return 1;
        if (svc_on) {
            F(lk, sizeof lk, "doc:%s", path);
            r = lk_take(root, lk, 60, 30000);
            if (r == 3 && local_writes_ok()) svc_on = 0;
            else if (r == 3) { fprintf(stderr, "devsvc: REFUSE writes-need-service: instance lost; nothing written\n"); return 1; }
            else if (r) { chomp(resp); fprintf(stderr, "DOC\tcreate\trefused\tlock=%s\t%s\n", lk, resp); return 1; }
            else got = 1;
        }
        F(full, sizeof full, "%s/%s", root, path);
        ex = sy_exists(full);
        if (ex != 0) { fprintf(stderr, "DOC\tcreate\trefused\tEEXIST: %s %s\n", path, ex == 1 ? "already exists" : "cannot be checked"); if (got) lk_drop(root); return 1; }
        F(body, sizeof body, "# %s\n", argv[2]);
        r = sy_write_atomic(full, body, (int64_t)strlen(body), 0644);
        if (got) lk_drop(root);
        if (r) { fprintf(stderr, "DOC\tcreate\tfail\twrite rc=%d\n", r); return 1; }
        printf("DOC\tcreate\tok\tlines=1\n");
        return 0;
    }
    if (strcmp(op, "get") && strcmp(op, "set") && strcmp(op, "append") && strcmp(op, "remove") && strcmp(op, "list") && strcmp(op, "mermaid") && strcmp(op, "repair")) return 2;
    for (i = 0; i < cfg.ndoc; i++) if (doc_glob(cfg.docpat[i], path)) ok = 1;
    if (!ok || strstr(path, "..")) { fprintf(stderr, "DOC\t%s\trefused\tEDOC: %s is not a doc of the repo table\n", op, path); return 1; }
    wr = strcmp(op, "get") && strcmp(op, "list");
    F(fop, sizeof fop, "doc.%s", op);
    ab_kv(&b, "path", path, strlen(path));
    if (argc >= 3 && argv[2][0] != '-') ab_kv(&b, "section", argv[2], strlen(argv[2]));
    for (i = 3; i < argc; i++) {
        const char *eq = strchr(argv[i], '=');
        if (argv[i][0] == '-') { if (i + 1 < argc && strcmp(argv[i], "--all") && strcmp(argv[i], "--body")) i++; continue; }
        if (!eq || eq == argv[i]) return 2;
        if (eq[-1] == '@') {
            char k[64]; unsigned char *t = 0; int64_t tn = 0;
            if (eq - argv[i] - 1 >= (long)sizeof k) return 2;
            for (r = 0; r < eq - argv[i] - 1; r++) k[r] = argv[i][r];
            k[r] = 0;
            if (sy_read_file(eq + 1, &t, &tn, 1 << 26)) { fprintf(stderr, "DOC\t%s\tfail\tEARG: cannot read %s\n", op, eq + 1); return 1; }
            ab_kv(&b, k, t ? (char *)t : "", (long)tn);
            if (t) free(t);
        } else {
            char k[64];
            if (eq - argv[i] >= (long)sizeof k) return 2;
            for (r = 0; r < eq - argv[i]; r++) k[r] = argv[i][r];
            k[r] = 0;
            ab_kv(&b, k, eq + 1, strlen(eq + 1));
        }
    }
    src = opt(argc, argv, "--from", "");
    if (*src) {
        unsigned char *t = 0; int64_t tn = 0;
        if (sy_read_file(src, &t, &tn, 1 << 26)) { fprintf(stderr, "DOC\t%s\tfail\tEARG: cannot read %s\n", op, src); return 1; }
        ab_kv(&b, !strcmp(op, "set") ? "content" : "line", t ? (char *)t : "", (long)tn);
        if (t) free(t);
    }
    if (flag(argc, argv, "--body")) ab_kv(&b, "body", "1", 1);   /* get --body: section body only, set --from takes it back */
    xs = opt(argc, argv, "--expect-sha", "");
    if (*xs) ab_kv(&b, "expect_sha", xs, strlen(xs));
    if (ovf || !b.p) return 2;
    set_owner(argc, argv);
    if ((svc_on = wr_svc(root, wr)) < 0) return 1;
    if (wr && svc_on) {
        F(nm, sizeof nm, "doc:%s", path);
        r = lk_take(root, nm, 60, 30000);
        if (r == 3 && local_writes_ok()) svc_on = 0;
        else if (r == 3) { fprintf(stderr, "devsvc: REFUSE writes-need-service: instance lost; nothing written\n"); return 1; }
        else if (r) { chomp(resp); fprintf(stderr, "DOC\t%s\trefused\tlock=%s\t%s\n", op, nm, resp); return 1; }
    }
    if (flow_root_env(root)) { lk_drop(root); return 2; }
    memset(&o, 0, sizeof o);
    r = fd_run(fop, b.p, &o);
    lk_drop(root);
    if (r) { fprintf(stderr, "DOC\t%s\tfail\t%s\n", op, o.why); ff_out_free(&o); return 1; }
    if (!wr) {
        if (o.buf && o.n > 0) fwrite(o.buf, 1, (size_t)o.n, stdout);
        fflush(stdout);
        fprintf(stderr, "DOC\t%s\tok\tsha=%s\n", op, o.sha);
    } else printf("DOC\t%s\tok\tsha=%s\tlines=%ld\n", op, o.sha, o.lines);
    ff_out_free(&o);
    return 0;
}

/* ---- git 整合与自动取锁包装:调用方不需要显式取锁。服务按路径判定要取的锁,排队等待(至多 50 s),成败都放锁。
   属主取自 $DEVSVC_OWNER,缺省 auto-<pid>。写域到锁名的映射取自配置表 lock 行第三列(lock_for);devtask 单的写域未接。 ---- */
/* 缺省属主顺序(K6):$DEVSVC_OWNER -> $CLAUDE_JOB_ID(至多 40 字节,只含字母数字与连字符,否则丢弃) -> 有 $TMUX 时
   $TMUX_PANE(形如 %N,记 pane-N;不起 tmux 子进程取窗口名) -> auto-<pid>。只读这几个变量名,值只用作属主标识。 */
static int owner_tok(const char *s, int dash) {
    long n = s ? (long)strlen(s) : 0, i;
    if (n <= 0 || n > 40) return 0;
    for (i = 0; i < n; i++) if (!((s[i] >= 'a' && s[i] <= 'z') || (s[i] >= 'A' && s[i] <= 'Z') || (s[i] >= '0' && s[i] <= '9') || (dash && s[i] == '-'))) return 0;
    return 1;
}
static const char *auto_owner(void) {
    static char o[64]; const char *e = getenv("DEVSVC_OWNER"), *j = getenv("CLAUDE_JOB_ID"), *t = getenv("TMUX"), *p = getenv("TMUX_PANE");
    if (e && okname(e)) F(o, sizeof o, "%s", e);
    else if (owner_tok(j, 1)) F(o, sizeof o, "%s", j);
    else if (t && *t && p && p[0] == '%' && owner_tok(p + 1, 0)) F(o, sizeof o, "pane-%s", p + 1);
    else F(o, sizeof o, "auto-%d", sy_pid());
    return o;
}
static char commit_class[24];   /* git commit 失败类别:取自 commit-own stderr 的 COMMIT_OWN_FAIL<TAB>class=;完成事件带 class= */
static char commit_range[180] = "old=-\tnew=-\tpaths=unknown";
/* Count changes between the two observed worktree HEADs. Paths containing
 * newlines are a single NUL-delimited entry. Observation cannot fail a commit. */
static void commit_range_note(const char *cwd, char *old, char *now) {
    char count[32] = "unknown";
    if (*old && *now) {
        if (!strcmp(old, now)) count[0] = '0', count[1] = 0;
        else {
            char *v[] = {"git", "diff-tree", "--no-commit-id", "-r", "--no-renames", "--name-only", "-z", old, now, "--", 0};
            np_result res; char why[128]; long paths = 0; size_t i;
            if (!np_run(v, cwd, 0, 2, &res, why, sizeof why)) {
                if (!res.rc) {
                    for (i = 0; i < res.outn; i++) if (!res.out[i]) paths++;
                    (void)cx_fmt(count, sizeof count, "%ld", paths);
                }
                np_free(&res);
            }
        }
    }
    (void)cx_fmt(commit_range, sizeof commit_range, "old=%s\tnew=%s\tpaths=%s", *old ? old : "-", *now ? now : "-", count);
}
static void commit_class_from(const char *path) {
    unsigned char *b = 0; int64_t n = 0; long i, k;
    if (!path[0] || sy_read_file(path, &b, &n, 1 << 24) || !b) return;
    for (i = 0; i + 21 <= n; i++) if (!memcmp(b + i, "COMMIT_OWN_FAIL\tclass=", 21) && (i == 0 || b[i - 1] == '\n' || b[i - 1] == '\t')) {   /* 作业 out 里经 GIT_COMMIT_ERR<TAB> 转出 */
        for (k = 0; k < (long)sizeof commit_class - 1 && i + 21 + k < n && b[i + 21 + k] != '\n' && b[i + 21 + k] != '\t'; k++) commit_class[k] = (char)b[i + 21 + k];
        commit_class[k] = 0;
    }
    free(b);
}
static const char *lock_for(const char *p) {   /* 路径 -> 锁名;无匹配返回 0 */
    int i; long pn = (long)strlen(p);
    for (i = 0; i < cfg.nlockname; i++) {
        const char *s = cfg.lockpfx[i];
        while (*s) {
            const char *c = strchr(s, ','); long l = c ? c - s : (long)strlen(s);
            if (l > 0 && (s[l - 1] == '/' ? !strncmp(p, s, l) : (pn == l && !strncmp(p, s, l)))) return cfg.lockname[i];
            s += l; if (*s) s++;
        }
    }
    return 0;
}
static int auto_lock(const char *root, const char *name, const char *ow) {
    char req[320], pt[96]; long end = sy_now_ms() + 50000; int rc;
    pi_self_tag(0, pt, sizeof pt);
    F(req, sizeof req, "lock-acquire\t%s\t%s\t120\t%s", name, ow, pt);
    for (;;) {
        rc = request(root, req, 1);
        if (rc == 0) return 0;
        if (rc != 1 || strncmp(resp, "ERR\theld", 8) || sy_now_ms() >= end) return rc;
        sy_sleep_ms(100);
    }
}
/* cwd 非空时作业在该目录跑(git commit --cwd:版本工作树),工具相对路径按该目录解析 */
static int tool_locked_cwd(const char *root, const char *lock, const char *tool, const char *cwd, int argc, char **argv);
static int tool_locked(const char *root, const char *lock, const char *tool, int argc, char **argv) { return tool_locked_cwd(root, lock, tool, 0, argc, argv); }
static int tool_locked_cwd(const char *root, const char *lock, const char *tool, const char *cwd, int argc, char **argv) {
    char prod[PW], req[200]; char *v[FL_MAX_ARGV + 10]; int n = 0, i, rc; const char *ow = auto_owner();
    if (argc + 10 > FL_MAX_ARGV) return 2;
    F(prod, sizeof prod, "%s/%s", root, cfg.product);
    v[n++] = "--par"; v[n++] = "1";
    if (cwd) { v[n++] = "--cwd"; v[n++] = (char *)cwd; }
    v[n++] = "--"; v[n++] = "sh"; v[n++] = prod; v[n++] = (char *)tool; v[n++] = "--";
    for (i = 0; i < argc; i++) v[n++] = argv[i];
    int mine = 0;
    if (lock && (rc = auto_lock(root, lock, ow))) { chomp(resp); fprintf(stderr, "devsvc: REFUSE lock %s: %s\n", lock, rn ? resp : "no instance"); return rc == 3 ? 3 : 1; }
    if (lock) mine = !strncmp(resp, "OK\tacquired", 11);   /* 应答 renewed 表示调用方已持有($DEVSVC_OWNER),不代放 */
    rc = cmd_x(root, n, v);
    if (lock && mine) { F(req, sizeof req, "lock-release\t%s\t%s", lock, ow); request(root, req, 0); }
    else if (lock) { F(req, sizeof req, "lock-acquire\t%s\t%s\t120", lock, ow); request(root, req, 0); }   /* 长操作后为调用方续租 */
    return rc;
}
/* derive:--check(缺省)走并发版 tools/derive-flow.cx(约 14 s);--write 仍转串行 tools/derive.cx(持 derive 锁,保留失败快照还原)。
 * 并发版 rc 2(flow 装载或 --plan 失败)或缺失时回退串行。首行 DEVSVC_DERIVE via=flow|serial|serial-fallback 说明实际路径;
 * DEVSVC_DERIVE_DRY=1 只打印所选工具(plan=)不执行,供检查用;DEVSVC_DERIVE_FLOW 覆盖并发版路径(检查回退用)。 */
static int cmd_derive(const char *root, int argc, char **argv) {
    const char *dry = getenv("DEVSVC_DERIVE_DRY"), *ft = getenv("DEVSVC_DERIVE_FLOW"); char fp[PW]; int rc;
    if (!ft || !ft[0]) ft = "tools/derive-flow.cx";
    if (flag(argc, argv, "--write")) {
        if (dry && dry[0] == '1') { printf("DEVSVC_DERIVE\tplan=tools/derive.cx\tlock=derive\n"); return 0; }
        printf("DEVSVC_DERIVE\tvia=serial\n"); fflush(stdout);
        return tool_locked(root, "derive", "tools/derive.cx", argc, argv);
    }
    if (dry && dry[0] == '1') { printf("DEVSVC_DERIVE\tplan=%s\tfallback=tools/derive.cx\n", ft); return 0; }
    F(fp, sizeof fp, "%s/%s", root, ft);
    if (access(fp, R_OK) == 0) {
        printf("DEVSVC_DERIVE\tvia=flow\n"); fflush(stdout);
        rc = tool_locked(root, 0, ft, argc, argv);
        if (rc != 2) return rc;
    }
    printf("DEVSVC_DERIVE\tvia=serial-fallback\tflow=%s\n", ft); fflush(stdout);
    return tool_locked(root, 0, "tools/derive.cx", argc, argv);
}
static int git_status(const char *root) {
    static char out[1 << 18], ll[1 << 17];   /* 与 resp 同大 */ char *v[] = {"git", "status", "--porcelain", 0}; char *s, *e, *p, *q; int dirty = 0, orphan = 0;
    if (runcap(v, out, sizeof out) != 0) { fprintf(stderr, "devsvc: git status failed or output too large\n"); return 1; }
    ll[0] = 0; if (request(root, "lock-list", 0) == 0) F(ll, sizeof ll, "%s", resp);
    for (s = out; (e = strchr(s, '\n')); s = e + 1) {
        char nm[64], ow[64], own[64] = ""; const char *lf;
        *e = 0; if (e - s < 4) continue;
        p = s + 3; if ((q = strstr(p, " -> "))) p = q + 4;
        for (q = strchr(ll, '\n'); q && q[1]; q = strchr(q + 1, '\n'))
            if (sscanf(q + 1, "%63[^\t\n]\t%63[^\t\n]", nm, ow) == 2 && (!strcmp(nm, p) || ((lf = lock_for(p)) && !strcmp(nm, lf)))) F(own, sizeof own, "%s", ow);
        dirty++; if (!own[0]) orphan++;
        printf("PATH\t%.2s\t%s\t%s\n", s, own[0] ? own : "orphan", p);
    }
    printf("GIT_STATUS\tdirty=%d\torphan=%d\n", dirty, orphan);
    return 0;
}
/* git commit 参数严格解析:必须 -m MSG 与至少一个路径来源(--whole/--keyed/--registered);未知选项、--help 一律 rc 2、不提交;
 * 说明首行不得为空、不得以署名行(Co-Authored-By:、Signed-off-by:)开头。路径与 KEY 是不以 - 开头的位置参数,只在来源选项之后出现。 */
static int git_ci_prefix(const char *s, const char *pre) {
    for (; *pre; s++, pre++) { char c = *s; if (c >= 'A' && c <= 'Z') c = (char)(c + 32); if (c != *pre) return 0; }
    return 1;
}
static int git_commit_check(int argc, char **argv) {
    int i, has_m = 0, has_src = 0; const char *msg = 0;
    for (i = 1; i < argc; i++) {
        const char *a = argv[i];
        if (!strcmp(a, "-m")) { if (i + 1 >= argc) { fprintf(stderr, "devsvc: git commit: -m needs a message\n"); return 2; } msg = argv[++i]; has_m = 1; continue; }
        if (!strcmp(a, "--push") || !strcmp(a, "--dry-run") || !strcmp(a, "--bg") || !strcmp(a, "--derive")) continue;   /* --derive: commit-own recomputes the derived tables the commit feeds */
        if (!strcmp(a, "--cwd")) { if (i + 1 >= argc || !argv[i + 1][0]) { fprintf(stderr, "devsvc: git commit: --cwd needs a work tree directory\n"); return 2; } i++; continue; }
        if (!strcmp(a, "--keyed") && i+3 < argc && argv[i+1][0]!='-' && argv[i+2][0]!='-' && argv[i+3][0]!='-') {
            fprintf(stderr,"devsvc: REFUSE keys-need-comma-separated: use --keyed TABLE KEY1,KEY2\n");
            return 2;
        }
        if (!strcmp(a, "--whole") || !strcmp(a, "--keyed") || !strcmp(a, "--registered") || !strcmp(a, "--merge-continue")) { has_src = 1; continue; }   /* --merge-continue: commit-own co_mergecont (whole staged merge, two parents) */
        if (!strcmp(a, "--")) { fprintf(stderr, "devsvc: REFUSE paths-need-whole-or-keyed: use --whole PATH or --keyed TABLE KEY, not -- PATH (nothing committed)\n"); return 2; }
        if (a[0] == '-' && a[1]) { fprintf(stderr, "devsvc: git commit: unknown option %s (nothing committed)\n", a); return 2; }
        if (!has_src) { fprintf(stderr, "devsvc: git commit: argument %s before any --whole/--keyed/--registered (nothing committed)\n", a); return 2; }
    }
    if (!has_m) { fprintf(stderr, "devsvc: git commit: -m MSG is required (nothing committed)\n"); return 2; }
    if (!has_src) { fprintf(stderr, "devsvc: git commit: need a path source: --whole PATH... | --keyed PATH KEYS | --registered ID... (nothing committed)\n"); return 2; }
    {   const char *s = msg; while (*s == ' ' || *s == '\t' || *s == '\r') s++;
        if (!*s || *s == '\n') { fprintf(stderr, "devsvc: git commit: empty message (nothing committed)\n"); return 2; }
        if (git_ci_prefix(s, "co-authored-by:") || git_ci_prefix(s, "signed-off-by:")) {
            fprintf(stderr, "devsvc: git commit: 说明首行必须是正文,署名放最后空行后 (first line must be the body; put Co-Authored-By after the last blank line)\n"); return 2; } }
    return 0;
}
/* 合并冲突处理。冲突文件全部是 exec/facts/derive.tsv 登记的 outputs(派生表;末尾带 / 的目录只管其下一层)时自动解决:
   逐个取本侧(checkout --ours),derive --write --only 受影响名,再 derive --check --only 同名须无漂移,git add -A 这些行的
   outputs 后提交合并(说明第二段写明自动解决了哪些表与 derive 名),末行 GIT_MERGE rc=0 ... auto_resolved=N derive=名,...。
   混有非派生文件冲突、derive 拒绝、需 bump(layer-api 的 NEEDS_BUMP)或 check 仍漂移时停下:逐行 MERGE_CONFLICT<TAB>文件,
   MERGE_HINT<TAB>原因<TAB>具名提示,末行 GIT_MERGE rc=1 conflicts=N,rc 1。不自己 merge --abort:abort 遇他人未提交改动
   会报 Entry not uptodate 失败,由调用方核过后自行处理。 */
#define MG_MAX 64
/* path 落在清单某行 outputs 里:name 填该行名,outs 填该行 outputs 字段,返回 1 */
static int mg_row_for(const char *man, const char *path, char *name, int ncap, char *outs, int ocap) {
    const char *s = man, *e;
    for (; *s; s = *e ? e + 1 : e) {
        const char *f[6]; int k = 0; const char *p;
        e = strchr(s, '\n'); if (!e) e = s + strlen(s);
        if (*s == '#' || e == s) continue;
        f[0] = s; for (p = s; p < e && k < 5; p++) if (*p == '\t') f[++k] = p + 1;
        if (k < 5) continue;
        {   const char *o = f[4], *oe = memchr(o, '\t', e - o) ? (const char *)memchr(o, '\t', e - o) : e, *t = o;
            while (t < oe) {
                const char *te = t; long tl, pl = (long)strlen(path);
                while (te < oe && *te != ' ') te++;
                tl = te - t;
                if (tl > 0 && ((tl == pl && !strncmp(t, path, tl)) || (t[tl - 1] == '/' && pl > tl && !strncmp(t, path, tl) && !strchr(path + tl, '/')))) {
                    long nl = f[1] - f[0] - 1, ol = oe - o;
                    if (nl <= 0 || nl >= ncap || ol >= ocap) return 0;
                    mm_copy(name, (size_t)ncap, f[0], nl); name[nl] = 0; mm_copy(outs, (size_t)ocap, o, ol); outs[ol] = 0;
                    return 1;
                }
                t = te; while (t < oe && *t == ' ') t++;
            } }
    }
    return 0;
}
static void mg_stop(char **fl, int nf, const char *rd, const char *cur, const char *why, const char *hint) {
    int i;
    for (i = 0; i < nf; i++) printf("MERGE_CONFLICT\t%s\n", fl[i]);
    printf("MERGE_HINT\t%s\t%s;工作树停在合并中,核过他人未提交改动后自行 git -C %s merge --abort(abort 报 Entry not uptodate 表示有未提交改动挡路,先由其所有者提交或移开;本服务不自动 abort)\n", why, hint, rd);
    printf("GIT_MERGE\trc=1\tconflicts=%d\tbranch=%s\tcwd=%s\n", nf, cur, rd);
}
/* 在 rd 里跑 derive(经仓根 unisacc.com),输出末 600 字节放 tail */
static int mg_derive(const char *root, const char *rd, const char *mode, const char *names, char *tail, int tcap) {
    char com[PW + 16]; np_result r; char why[200]; int rc; long n, off;
    F(com, sizeof com, "%s/%s", root, cfg.product);
    {   char *v[] = {"sh", com, "tools/derive.cx", "--", (char *)mode, "--only", (char *)names, 0};
        tail[0] = 0; if (np_run(v, rd, 0, 55, &r, why, sizeof why)) { F(tail, tcap, "start failed: %s", why); return -1; } }
    rc = r.rc; n = (long)r.outn; off = n > tcap - 1 ? n - (tcap - 1) : 0;
    if (n - off > 0) { mm_copy(tail, (size_t)tcap, r.out + off, n - off); tail[n - off] = 0; }
    np_free(&r); clean(tail);
    return rc;
}
/* 版本号 x.y.z 按段数值比较:a>b 返回 1,相等 0,小于 -1;段数不同时缺段按 0 */
static int mg_vcmp(const char *a, long an, const char *b, long bn) {
    const char *ae = a + an, *be = b + bn;
    while (a < ae || b < be) {
        long x = 0, y = 0;
        while (a < ae && *a >= '0' && *a <= '9') x = x * 10 + (*a++ - '0');
        while (b < be && *b >= '0' && *b <= '9') y = y * 10 + (*b++ - '0');
        if (x != y) return x > y ? 1 : -1;
        if (a < ae) a++;
        if (b < be) b++;
    }
    return 0;
}
/* build/tlib-packages.tsv 冲突的单调字段:已取本侧后,逐包(第一列)比较本侧与对侧(索引第 3 段)的 version(第二列),
   对侧较大时只把该行 version 换成对侧值,其它列仍取本侧(随后 derive 按本侧接口重算,只会再升不会降);版本相同或本侧较大
   保持本侧整行(原行为);只在对侧有的包不补(原行为)。逐个改动打 MERGE_VERSION_MAX 行。成功 0,读写失败 -1。 */
static int mg_tlib_max(const char *rd, const char *path) {
    static char th[1 << 17], ob[1 << 17], nb[1 << 17]; char fp[PW + 64]; unsigned char *mb = 0; int64_t mn = 0; long on, nn = 0; const char *s, *e;
    {   char spec[600]; F(spec, sizeof spec, ":3:%s", path);
        char *v[] = {"git", "-C", (char *)rd, "show", spec, 0};
        if (ovf || runcap(v, th, sizeof th) != 0) return -1; }
    F(fp, sizeof fp, "%s/%s", rd, path);
    if (ovf || sy_read_file(fp, &mb, &mn, sizeof ob - 1) || !mb) { free(mb); return -1; }
    mm_copy(ob, sizeof ob, mb, (size_t)mn); ob[mn] = 0; on = (long)mn; free(mb);
    for (s = ob; s < ob + on; s = e) {
        const char *t1, *t2, *ts, *te, *u1, *u2; long pl;
        e = memchr(s, '\n', ob + on - s); e = e ? e + 1 : ob + on;
        t1 = memchr(s, '\t', e - s); t2 = t1 ? memchr(t1 + 1, '\t', e - t1 - 1) : 0;
        if (*s == '#' || !t1 || !t2) goto copy;
        pl = t1 - s;
        for (ts = th; *ts; ts = *te ? te + 1 : te) {
            te = strchr(ts, '\n'); if (!te) te = ts + strlen(ts);
            if (*ts == '#' || te - ts <= pl || strncmp(ts, s, pl) || ts[pl] != '\t') continue;
            u1 = ts + pl; u2 = memchr(u1 + 1, '\t', te - u1 - 1);
            if (u2 && mg_vcmp(u1 + 1, u2 - u1 - 1, t1 + 1, t2 - t1 - 1) > 0) {
                long need = (t1 + 1 - s) + (u2 - u1 - 1) + (e - t2);
                if (nn + need >= (long)sizeof nb) return -1;
                printf("MERGE_VERSION_MAX\t%.*s\t%.*s -> %.*s\n", (int)pl, s, (int)(t2 - t1 - 1), t1 + 1, (int)(u2 - u1 - 1), u1 + 1);
                mm_copy(nb + nn, sizeof nb - nn, s, t1 + 1 - s); nn += t1 + 1 - s;
                mm_copy(nb + nn, sizeof nb - nn, u1 + 1, u2 - u1 - 1); nn += u2 - u1 - 1;
                mm_copy(nb + nn, sizeof nb - nn, t2, e - t2); nn += e - t2;
                goto next;
            }
            break;
        }
    copy:
        if (nn + (e - s) >= (long)sizeof nb) return -1;
        mm_copy(nb + nn, sizeof nb - nn, s, e - s); nn += e - s;
    next:;
    }
    return sy_write_atomic(fp, nb, (size_t)nn, 0644) ? -1 : 0;
}
static int merge_conflicts(const char *root, const char *rd, const char *br, const char *cur) {
    static char lst[1 << 15], buf[1 << 15], names[1024], outs[MG_MAX][700], tail[700], mp[PW + 64], msg[4096], tabs[2048], sha[128];
    char *fl[MG_MAX]; int nf = 0, nd = 0, i, j, rc; unsigned char *mb = 0; int64_t mn = 0; char *man = 0;
    {   char *uv[] = {"git", "-C", (char *)rd, "diff", "--name-only", "--diff-filter=U", 0}; char *s, *e;
        if (runcap(uv, lst, sizeof lst) != 0) lst[0] = 0;   /* fl 指进 lst;buf 之后被 runcap 反复清空,不能共用 */
        for (s = lst; *s; s = e) { e = strchr(s, '\n'); if (e) *e++ = 0; else e = s + strlen(s); if (*s && nf < MG_MAX) fl[nf++] = s; } }
    F(mp, sizeof mp, "%s/exec/facts/derive.tsv", rd);
    if (!sy_read_file(mp, &mb, &mn, 1 << 20) && mb && (man = malloc((size_t)mn + 1))) { mm_copy(man, (size_t)mn + 1, mb, (size_t)mn); man[mn] = 0; }
    free(mb);
    names[0] = 0; tabs[0] = 0;
    for (i = 0; i < nf && man; i++) {
        char nm[64];
        if (!mg_row_for(man, fl[i], nm, sizeof nm, outs[nd], sizeof outs[nd])) continue;
        for (j = 0; j < nd; j++) if (!strcmp(outs[j], outs[nd])) break;
        if (j == nd) { char t[1024]; F(t, sizeof t, "%s%s%s", names, names[0] ? "," : "", nm); F(names, sizeof names, "%s", t); }
        {   char t[2048]; F(t, sizeof t, "%s%s%s", tabs, tabs[0] ? " " : "", fl[i]); F(tabs, sizeof tabs, "%s", t); }
        nd++;
    }
    free(man);
    if (nf == 0 || nd != nf || ovf) { mg_stop(fl, nf, rd, cur, nf == 0 ? "merge-failed-no-conflict-files" : "non-derived-conflict", "冲突里有非派生文件,须人工解决"); return 1; }
    for (i = 0; i < nf; i++) {
        char *cv[] = {"git", "-C", (char *)rd, "checkout", "--ours", "--", fl[i], 0};
        if (runcap(cv, buf, sizeof buf) != 0) { mg_stop(fl, nf, rd, cur, "checkout-ours-failed", fl[i]); return 1; }
        /* 包版本单调:tlib-packages 取本侧后逐包抬到两侧较大版本,再派生;合入后任何包版本不低于任一侧 */
        if (!strcmp(fl[i], "build/tlib-packages.tsv") && mg_tlib_max(rd, fl[i])) { mg_stop(fl, nf, rd, cur, "tlib-version-max-failed", fl[i]); return 1; }
    }
    rc = mg_derive(root, rd, "--write", names, tail, sizeof tail);
    if (rc != 0) {
        char h[1200];
        if (strstr(tail, "NEEDS_BUMP")) F(h, sizeof h, "layer-api 接口变了:先 sh ./unisacc.com tools/layer-api.cx -- --bump PKG(PKG 取 derive 输出所指包)再 derive --write --only %s;derive 末行 %s", names, tail);
        else F(h, sizeof h, "derive --write --only %s rc=%d;末行 %s", names, rc, tail);
        mg_stop(fl, nf, rd, cur, strstr(tail, "NEEDS_BUMP") ? "needs-bump" : "derive-write-failed", h); return 1;
    }
    rc = mg_derive(root, rd, "--check", names, tail, sizeof tail);
    if (rc != 0) { char h[1200]; F(h, sizeof h, "derive --check --only %s rc=%d;末行 %s", names, rc, tail); mg_stop(fl, nf, rd, cur, "derive-check-drift", h); return 1; }
    {   char *av[FL_MAX_ARGV]; int n = 0, k; char ob[MG_MAX][700];
        av[n++] = "git"; av[n++] = "-C"; av[n++] = (char *)rd; av[n++] = "add"; av[n++] = "-A"; av[n++] = "--";
        for (k = 0; k < nd; k++) {
            char *t = ob[k];
            for (j = 0; j < k; j++) if (!strcmp(outs[j], outs[k])) break;
            if (j < k) continue;
            F(ob[k], sizeof ob[k], "%s", outs[k]);
            while (*t && n < FL_MAX_ARGV - 1) {
                while (*t == ' ') *t++ = 0;
                if (!*t) break;
                av[n++] = t; while (*t && *t != ' ') t++;
            }
        }
        av[n] = 0;
        if (runcap(av, buf, sizeof buf) != 0) { mg_stop(fl, nf, rd, cur, "git-add-failed", tabs); return 1; } }
    F(msg, sizeof msg, "Merge branch '%s' into %s\n\n自动解决派生表冲突: %s(取本侧后 derive --write --only %s,derive --check 无漂移)", br, cur, tabs, names);
    {   char *mv[] = {"git", "-C", (char *)rd, "commit", "-q", "--no-verify", "-m", msg, 0};
        if (ovf || runcap(mv, buf, sizeof buf) != 0) { mg_stop(fl, nf, rd, cur, "merge-commit-failed", tabs); return 1; } }
    {   char *hv[] = {"git", "-C", (char *)rd, "rev-parse", "HEAD", 0}; if (runcap(hv, sha, sizeof sha) == 0) chomp(sha); else sha[0] = 0; }
    for (i = 0; i < nf; i++) printf("MERGE_AUTO\t%s\n", fl[i]);
    printf("GIT_MERGE\trc=0\tcommit=%s\tbranch=%s\tcwd=%s\tauto_resolved=%d\tderive=%s\n", sha, cur, rd, nf, names);
    return 0;
}
/* git merge BRANCH [--cwd WORKTREE]:在工作树(缺省共享检出)当前分支上 git merge --no-edit BRANCH。
   冲突见上 merge_conflicts:全为派生表时自动解决并完成合并,否则 MERGE_CONFLICT 清单、MERGE_HINT、rc 1。
   无冲突:GIT_MERGE rc=0 commit=SHA branch=当前分支。参数错 rc 2。 */
static int git_argerr;   /* cmd_git 及其子命令在参数解析处退出(尚未启动任何 git 动作)时置 1;入口只在此时贴 usage。
                            git 子进程、commit-own 的真实 rc 2 与具名 REFUSE 的 rc 2 原样返回,不贴 usage(仿 x_ran) */
static const char *commit_outcome(int rc) {
    return rc == 0 ? "ok" : rc == 124 ? "timeout" : commit_class[0] ? commit_class : git_argerr ? "args" : "other";
}
/* K2/K5 私有索引合并与快进:不经共享索引与工作区算结果,ref 以 update-ref NEW OLD 比较并交换落地(HEAD 被他人移动则重做,至多 3 次),
   落地后 cxlib.gitsync gs_sync 只同步"索引与工作区都等于旧 HEAD"的路径,其余原样保留并逐行报 <前缀>\tSYNC_KEPT path= reason=。
   本机 git 2.34 无 merge-tree --write-tree:GIT_INDEX_FILE 私有索引里 read-tree OURS 后 read-tree -m --aggressive BASE OURS THEIRS,
   剩余三阶段齐全的普通文件逐个 git merge-file(临时目录内)再 hash-object -w 与 update-index --cacheinfo 收口;仍有冲突即报冲突。
   不用 stash、reset、clean、checkout、read-tree -u、checkout-index。 */
static char mg_idx[PW], mg_tmp[PW];
typedef struct { char path[PW]; char mode[3][8]; char sha[3][48]; int has[3]; } mg_ent;
#define MG_UMAX 128
static mg_ent mg_u[MG_UMAX];
/* env GIT_INDEX_FILE=<私有索引> git -C rd ARGS... */
static int mg_git(const char *rd, char **args, char *out, int cap) {
    char *v[24]; char ev[PW + 32]; int n = 0, i;
    F(ev, sizeof ev, "GIT_INDEX_FILE=%s", mg_idx); if (ovf) return -3;
    v[n++] = "env"; v[n++] = ev; v[n++] = "git"; v[n++] = "-C"; v[n++] = (char *)rd;
    for (i = 0; args[i] && n < 23; i++) v[n++] = args[i];
    if (args[i]) return -3;
    v[n] = 0;
    return runcap(v, out, cap);
}
static int mg_rev(const char *rd, const char *spec, char *sha, int cap) {
    char *v[] = {"git", "-C", (char *)rd, "rev-parse", "-q", "--verify", (char *)spec, 0};
    if (runcap(v, sha, cap) != 0) { sha[0] = 0; return -1; }
    chomp(sha); return sha[0] ? 0 : -1;
}
static int mg_anc(const char *rd, const char *a, const char *b) {   /* a 是 b 的祖先(含相等) */
    char o[64]; char *v[] = {"git", "-C", (char *)rd, "merge-base", "--is-ancestor", (char *)a, (char *)b, 0};
    return runcap(v, o, sizeof o) == 0;
}
/* 解析 ls-files -u(非 -z,core.quotepath=off)行 "MODE SHA STAGE\tPATH",按路径归并;逐字节扫描 */
static int mg_parse_u(const char *b) {
    int k = -1; const char *s = b;
    while (*s) {
        const char *e = s, *t; char md[8], sh[48]; int st; long pl;
        while (*e && *e != '\n') e++;
        for (t = s; t < e && *t != '\t'; t++) ;
        if (t < e && sscanf(s, "%7s %47s %d", md, sh, &st) == 3 && st >= 1 && st <= 3) {
            pl = e - t - 1;
            if (pl <= 0 || pl >= PW) return -1;
            if (k < 0 || (long)strlen(mg_u[k].path) != pl || memcmp(mg_u[k].path, t + 1, (size_t)pl)) {
                if (++k >= MG_UMAX) return -1;
                memset(&mg_u[k], 0, sizeof mg_u[k]); mm_copy(mg_u[k].path, sizeof mg_u[k].path, t + 1, (size_t)pl); mg_u[k].path[pl] = 0;
            }
            F(mg_u[k].mode[st - 1], sizeof mg_u[k].mode[st - 1], "%s", md); F(mg_u[k].sha[st - 1], sizeof mg_u[k].sha[st - 1], "%s", sh); mg_u[k].has[st - 1] = 1;
        }
        s = *e ? e + 1 : e;
    }
    return k + 1;
}
static int mg_blob(const char *rd, const char *sha, const char *dst) {
    np_result r; char why[200]; int t;
    char *v[] = {"git", "-C", (char *)rd, "cat-file", "blob", (char *)sha, 0};
    if (np_run(v, 0, 0, 55, &r, why, sizeof why)) return -1;
    t = r.rc != 0 || r.outn > (64u << 20) || sy_write_atomic(dst, r.out, r.outn, 0600) ? -1 : 0;
    np_free(&r); return t;
}
/* 三阶段齐全且两侧都是普通文件的路径做文本三方合并;成功 0(私有索引里收口为 stage 0),冲突 1,出错 -1 */
static int mg_file(const char *rd, mg_ent *u) {
    char o[PW + 16], b[PW + 16], t[PW + 16], sha[128], ci[PW + 160], buf[256]; const char *md; int rc;
    if (!u->has[0] || !u->has[1] || !u->has[2]) return 1;
    if (strncmp(u->mode[1], "100", 3) || strncmp(u->mode[2], "100", 3)) return 1;
    md = strcmp(u->mode[1], u->mode[0]) ? u->mode[1] : u->mode[2];
    F(o, sizeof o, "%s/o", mg_tmp); F(b, sizeof b, "%s/b", mg_tmp); F(t, sizeof t, "%s/t", mg_tmp);
    if (ovf || mg_blob(rd, u->sha[1], o) || mg_blob(rd, u->sha[0], b) || mg_blob(rd, u->sha[2], t)) return -1;
    {   char *v[] = {"git", "merge-file", "-q", o, b, t, 0}; rc = runcap(v, buf, sizeof buf); }
    if (rc > 0) return 1;
    if (rc < 0) return -1;
    {   char *v[] = {"git", "-C", (char *)rd, "hash-object", "-w", "--", o, 0}; if (runcap(v, sha, sizeof sha) != 0) return -1; chomp(sha); }
    F(ci, sizeof ci, "%s,%s,%s", md, sha, u->path); if (ovf) return -1;
    {   char *a[] = {"update-index", "--cacheinfo", ci, 0}; return mg_git(rd, a, buf, sizeof buf) == 0 ? 0 : -1; }
}
/* 私有索引三方合并:0 无冲突(tree 填合并树),1 冲突(mg_u 前 *nu 项为冲突路径),-1 出错(why) */
static int mg_try(const char *rd, const char *ours, const char *theirs, char *tree, int tcap, int *nu, char *why, int wcap) {
    static char ub[1 << 16]; char base[128], buf[512]; int n, i, k = 0, r;
    {   char *v[] = {"git", "-C", (char *)rd, "merge-base", (char *)ours, (char *)theirs, 0};
        if (runcap(v, base, sizeof base) != 0) F(base, sizeof base, "4b825dc642cb6eb9a060e54bf8d69288fbee4904"); else chomp(base); }
    {   char *v[] = {"rm", "-f", mg_idx, 0}; (void)runcap(v, buf, sizeof buf); }
    /* 私有索引从空开始:先 read-tree OURS 再 -m 会拿工作区 stat 校验(Entry not uptodate),空索引的三树合并不看工作区 */
    {   char *a[] = {"read-tree", "-m", "--aggressive", base, (char *)ours, (char *)theirs, 0};
        if (mg_git(rd, a, buf, sizeof buf) != 0) { F(why, wcap, "read-tree-3way"); return -1; } }
    {   char *a[] = {"-c", "core.quotepath=off", "ls-files", "-u", 0}; if (mg_git(rd, a, ub, sizeof ub) != 0) { F(why, wcap, "ls-files-u"); return -1; } }
    n = mg_parse_u(ub);
    if (n < 0) { F(why, wcap, "too-many-unmerged"); return -1; }
    for (i = 0; i < n; i++) {
        r = mg_file(rd, &mg_u[i]);
        if (r < 0) { F(why, wcap, "merge-file %s", mg_u[i].path); return -1; }
        if (r == 1) { if (k != i) mg_u[k] = mg_u[i]; k++; }
    }
    *nu = k;
    if (k) return 1;
    {   char *a[] = {"write-tree", 0}; if (mg_git(rd, a, tree, tcap) != 0) { F(why, wcap, "write-tree"); return -1; } chomp(tree); }
    return 0;
}
/* 冲突且不动共享索引与工作区与 ref:逐路径 MERGE_CONFLICT<TAB>path<TAB>stages=base+ours+theirs<TAB>last=最近改动者 */
static void mg_report(const char *rd, const char *cur, int nu, const char *why) {
    int i;
    for (i = 0; i < nu; i++) {
        char st[40], who[200]; char *v[] = {"git", "-C", (char *)rd, "log", "-1", "--format=%an", "--", mg_u[i].path, 0};
        F(st, sizeof st, "%s%s%s%s%s", mg_u[i].has[0] ? "base" : "", mg_u[i].has[0] && (mg_u[i].has[1] || mg_u[i].has[2]) ? "+" : "",
          mg_u[i].has[1] ? "ours" : "", mg_u[i].has[1] && mg_u[i].has[2] ? "+" : "", mg_u[i].has[2] ? "theirs" : "");
        if (runcap(v, who, sizeof who) != 0) who[0] = 0; chomp(who); clean(who);
        printf("MERGE_CONFLICT\t%s\tstages=%s\tlast=%s\n", mg_u[i].path, st, who[0] ? who : "-");
    }
    printf("MERGE_HINT\t%s\t共享索引、工作区与 HEAD 均未改动;冲突须由路径最近改动者在其分支上解决后再合并\n", why);
    printf("GIT_MERGE\trc=1\tconflicts=%d\tbranch=%s\tcwd=%s\n", nu, cur, rd);
}
/* 经 tools/gitsync-run.cx 子进程(55 秒上限)调 gs_sync;SYNC_KEPT 行加前缀原样输出。同一编译单元不能 use cxlib.gitsync(np_buf 重定义) */
static const char *mg_root;   /* git_merge/git_pull 入口设为仓根 */
static int mg_sync(const char *rd, const char *old, const char *new_, const char *pre, int *synced, int *kept) {
    np_result r; char why[200], com[PW + 16]; const char *s, *e, *end; int ok = 0;
    F(com, sizeof com, "%s/unisacc.com", mg_root); if (ovf) return -1;   /* lint:allow R1-product gitsync-run runs under the installed product of ROOT, as devsvc itself does */
    {   char *v[] = {"sh", com, "tools/gitsync-run.cx", "--", (char *)rd, (char *)old, (char *)new_, 0};
        if (np_run(v, mg_root, 0, 55, &r, why, sizeof why)) { printf("%s\tSYNC_FAIL\t%s\n", pre, why); return -1; } }
    end = r.out ? r.out + r.outn : 0;
    for (s = r.out; s && s < end; s = e < end ? e + 1 : end) {
        for (e = s; e < end && *e != '\n'; e++) ;
        if (e - s > 8 && !memcmp(s, "GITSYNC\t", 8)) { if (r.rc == 0 && sscanf(s, "GITSYNC\trc=0\tchanged=%*d\tsynced=%d\tkept=%d", synced, kept) == 2) ok = 1; }
        else if (e > s) printf("%s\t%.*s\n", pre, (int)(e - s), s);
    }
    if (!ok) printf("%s\tSYNC_FAIL\trc=%d\n", pre, r.rc);
    np_free(&r);
    return ok ? 0 : -1;
}
static int mg_setup(void) {
    char buf[64];
    F(mg_tmp, sizeof mg_tmp, "/tmp/devsvc-merge-%d-%ld", (int)sy_pid(), sy_now_ms()); F(mg_idx, sizeof mg_idx, "%s/index", mg_tmp);
    if (ovf) return -1;
    {   char *v[] = {"mkdir", "-p", mg_tmp, 0}; return runcap(v, buf, sizeof buf) == 0 ? 0 : -1; }
}
static void mg_teardown(void) { char buf[64]; char *v[] = {"rm", "-rf", mg_tmp, 0}; if (mg_tmp[0]) (void)runcap(v, buf, sizeof buf); }
/* 落地窗口锁 git-land:只覆盖 update-ref 加 gs_sync,合并计算不持锁。租期 60 秒,等待至多 MG_LOCK_WAIT_MS(3 秒),
   他人持有则按名拒绝(MERGE_LOCK_HELD 行加重试提示),rc 1;无实例时照跑不取锁(同 f/x/flow)。 */
#define MG_LOCK "git-land"
#define MG_LOCK_WAIT_MS 3000
static int mg_locked;
static int mg_lock(const char *root) {
    char req[320], pt[96]; long end = sy_now_ms() + MG_LOCK_WAIT_MS; int rc; const char *ow = auto_owner();
    mg_locked = 0;
    pi_self_tag(0, pt, sizeof pt);
    F(req, sizeof req, "lock-acquire\t%s\t%s\t60\t%s", MG_LOCK, ow, pt); if (ovf) return 1;
    for (;;) {
        rc = request(root, req, 1);
        if (rc == 0) { mg_locked = !strncmp(resp, "OK\tacquired", 11); return 0; }
        if (rc == 3) return 0;
        if (rc != 1 || strncmp(resp, "ERR\theld", 8) || sy_now_ms() >= end) break;
        sy_sleep_ms(100);
    }
    chomp(resp); clean(resp);
    printf("MERGE_LOCK_HELD\tlock=%s\t%s\t他人正在落地 git 写入;稍后重试同一命令(锁租期至多 60 秒)\n", MG_LOCK, rn ? resp : "-");
    printf("GIT_MERGE\trc=1\treason=lock-held\tlock=%s\n", MG_LOCK);
    return 1;
}
static void mg_unlock(const char *root) {
    char req[200];
    if (!mg_locked) return;
    F(req, sizeof req, "lock-release\t%s\t%s", MG_LOCK, auto_owner()); if (!ovf) request(root, req, 0);
    mg_locked = 0;
}
/* 共享索引与工作区(已跟踪部分)与 HEAD 一致 */
static int mg_clean_tree(const char *rd) {
    static char st[1 << 12]; char *v[] = {"git", "-C", (char *)rd, "status", "--porcelain", "-uno", 0};
    return runcap(v, st, sizeof st) == 0 && st[0] == 0;
}
/* git merge BRANCH [-m MSG] [--cwd WORKTREE]:私有索引合并,见上。HEAD 是 BRANCH 祖先则快进;已包含则 up_to_date=1。
   冲突:工作树与索引干净时沿用旧路径(git merge 加 merge_conflicts:派生表冲突自动解、否则停在合并中);否则什么都不动,
   报 MERGE_CONFLICT 清单与 MERGE_HINT,rc 1。成功末行 GIT_MERGE rc=0 commit=SHA branch= cwd= ff= synced= kept=。参数错 rc 2。 */
/* Only prepare material in the worktree whose ref moved. The foreground
 * transaction never waits for the build or consumes a readiness verdict. */
static int pin_prepare_child(void *arg) {
    char *v[] = {"sh", cfg.product, "tools/devsvc.cx", "--", "prebuild-self", 0};
    sy_spawn_t o; sy_exit_t ex;
    sy_unsetenv("DEVSVC_REPO_TABLE");
    sy_unsetenv("DEVSVC_REPO_TABLE_PIN");
    sy_unsetenv("DEVSVC_SELF_BIN");
    sy_spawn_init(&o); o.cwd = arg; o.argv = v; o.deadline_ms = 55000;
    o.pgroup = -1; o.in_fd = o.out_fd = o.err_fd = SY_STDIO_NULL;
    return sy_proc_run(&o, &ex) ? 1 : sy_exit_code(&ex);
}
static void pin_prepare_kick(const char *root) {
    int fds[2]; char launcher[PW];
    if (snprintf(launcher, sizeof launcher, "%s/tools/devsvc.cx", root) >= (int)sizeof launcher || sy_exists(launcher) != 1) return;
    if (sy_fork_session(pin_prepare_child, (void *)root, fds) >= 0) {
        sy_close(fds[0]); sy_close(fds[1]);
    }
}
static int git_merge(const char *root, int argc, char **argv) {
    const char *br = 0, *d = root, *msg = 0; char rd[PW], top[PW], cur[200], buf[1 << 15], theirs[128], old[128], nw[128], tree[128], dm[600], why[PW + 32];
    int i, rc, att, nu = 0, ff = 0, sy = 0, kp = 0;
    mg_root = root;
    for (i = 1; i < argc; i++) {
        if (!strcmp(argv[i], "--cwd") && i + 1 < argc) d = argv[++i];
        else if (!strcmp(argv[i], "-m") && i + 1 < argc) msg = argv[++i];
        else if (argv[i][0] == '-' || br) { fprintf(stderr, "devsvc: git merge BRANCH [-m MSG] [--cwd WORKTREE]: unexpected %s\n", argv[i]); git_argerr = 1; return 2; }
        else br = argv[i];
    }
