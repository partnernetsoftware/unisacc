                        strcmp(argv[k - 1], "--merged") && strcmp(argv[k - 1], "--no-merged") && strcmp(argv[k - 1], "--points-at") &&
                        strcmp(argv[k - 1], "--format") && strcmp(argv[k - 1], "--sort") && strcmp(argv[k - 1], "-l") && strcmp(argv[k - 1], "--list")) {
                        fprintf(stderr, "devsvc: REFUSE git branch %s: creating or mutating branches is not allowed\n", ba);
                        return 2;
