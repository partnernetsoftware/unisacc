    git_argerr = 0;
    if (argc < 1) { git_argerr = 1; return 2; }
    if (!strcmp(argv[0], "status") && argc == 1) return git_status(root);
    {   /* 只读子命令透传:不取锁,stdout 上限 GIT_RO_CAP 字节,超出打截断标记 */
        static const char *ro[] = {"log", "diff", "show", "status", "blame", "ls-files", "rev-parse", "merge-base", "rev-list", "branch", "archive", "grep", "ls-tree", "cat-file", "describe", "for-each-ref", "shortlog", 0};
        int j; for (j = 0; ro[j]; j++) if (!strcmp(argv[0], ro[j])) {
            np_result r; char why[200]; long cap = !strcmp(argv[0], "archive") ? (16 << 20) : (1 << 20), k;
            const char *ce = getenv("DEVSVC_GIT_RO_CAP");
            if (ce && atol(ce) >= 4096) cap = atol(ce);
            if (argc + 2 > FL_MAX_ARGV) { fprintf(stderr, "devsvc: git %s: too many arguments (max %d)\n", argv[0], FL_MAX_ARGV - 2); git_argerr = 1; return 2; }
