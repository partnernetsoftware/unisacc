                    const char *ba = argv[k];
                    if (!strcmp(ba, "-d") || !strcmp(ba, "-D") || !strcmp(ba, "--delete") ||
                        !strcmp(ba, "-m") || !strcmp(ba, "-M") || !strcmp(ba, "--move") ||
                        !strcmp(ba, "-c") || !strcmp(ba, "-C") || !strcmp(ba, "--copy") ||
                        !strcmp(ba, "-f") || !strcmp(ba, "--force") ||
                        !strncmp(ba, "--set-upstream", 14) || !strcmp(ba, "--unset-upstream") || !strcmp(ba, "--edit-description")) {
                        fprintf(stderr, "devsvc: REFUSE git branch %s: mutating branch option is not allowed\n", ba);
                        return 2;
