    i = mg_sync(rd, old, up, "GIT_PULL_SYNC", &sy, &kp); mg_unlock(root);
    pin_prepare_kick(rd);
    if (i) { printf("GIT_PULL\trc=1\tcommit=%s\tsync=failed\n", up); return 1; }
    printf("GIT_PULL\trc=0\tcommit=%s\tfrom=%s\tbranch=%s\tcwd=%s\tsynced=%d\tkept=%d\n", up, old, cur, rd, sy, kp);
