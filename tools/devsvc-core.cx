    mg_teardown();
    if (att >= 4) { printf("MERGE_HINT\thead-moving\tHEAD 连续被他人移动,重试 3 次仍未落地\nGIT_MERGE\trc=1\tconflicts=0\tbranch=%s\tcwd=%s\n", cur, rd); return 1; }
    rc = mg_sync(rd, old, nw, "GIT_MERGE_SYNC", &sy, &kp); mg_unlock(root);
