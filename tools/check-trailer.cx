/* tools/check-trailer.cx -- tools/cxlib/trailer.cx tr_strip units (project owner 2026-11-20: commits carry no attribution
 * lines). The hook and real-commit cases are in tools/check-commit-msg.cx. Last line CHECK_TRAILER ok=N failed=M. */
#pragma unisa use sys.io
#pragma unisa use cxlib.trailer
static int npass, nfail;
static void unit(const char *in, const char *want, int wn, const char *name) {
    char b[512]; int n, ok;
    if (cx_fmt(b, sizeof b, "%s", in)) { printf("FAIL\ttrailer.%s\n", name); nfail++; return; }
    n = tr_strip(b); ok = n == wn && !strcmp(b, want);
    printf("%s\ttrailer.%s\n", ok ? "PASS" : "FAIL", name); if (ok) npass++; else nfail++;
    if (!ok) fprintf(stderr, "check-trailer: %s: got n=%d [%s]\n", name, n, b);
}
int main(void) {
    unit("t\n\nbody\n\nCo-Authored-By: A <a@b>\n", "t\n\nbody\n", 1, "trailer-and-blank-dropped");
    unit("t\n\nbody\n\nco-authored-by: A\nSIGNED-OFF-BY: B\n\n  Generated with [claude code](u)\n", "t\n\nbody\n", 3, "case-insensitive-all-three");
    unit("t\n\nSigned-off-by: B\n\nmore body", "t\n\nmore body", 1, "middle-keeps-one-separator");
    unit("t\n\nsee Co-Authored-By: in docs\n", "t\n\nsee Co-Authored-By: in docs\n", 0, "non-line-start-untouched");
    unit("strip Generated with [Claude Code] lines\n", "strip Generated with [Claude Code] lines\n", 0, "mention-in-body-untouched");
    unit("t\n\n\xf0\x9f\xa4\x96 Generated with [Claude Code](u)\n", "t\n", 1, "emoji-led-tool-line-dropped");
    unit("t\nno attribution\n\n", "t\nno attribution\n\n", 0, "no-attribution-byte-identical");
    unit("Co-Authored-By: A\n", "", 1, "only-attribution-empties");
    printf("CHECK_TRAILER\tok=%d\tfailed=%d\n", npass, nfail);
    return nfail ? 1 : 0;
}
