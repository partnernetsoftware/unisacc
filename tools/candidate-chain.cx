/* tools/candidate-chain.cx -- G0 一条命令编排 chain-step 全链。
 *
 *   sh ./unisacc.com tools/candidate-chain.cx -- --plan
 *   sh ./unisacc.com tools/candidate-chain.cx -- --rev REV --out DIR [--resume] [--parallel N] [--cc PATH]
 *
 * 子进程一律 tools/bound 55。131 作业:start-job 与 finish-job 分两次调用;
 * 每波作业数按上一波 wall_ms 自适应(目标每次 <55s),超时按作业粒度 --resume。
 * --resume 跳过 checkpoint.tsv 已 DONE 相位。编排只在本 .cx 内,不经 .sh。
 */
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.sha
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use mem.heap

static void die(const char *a, const char *b) {
    fprintf(stderr, "candidate-chain: %s%s%s\n", a, b ? ": " : "", b ? b : "");
    exit(2);
}
static long fsize(const char *p) {
    sy_stat_t st;
    if (sy_stat(p, &st)) return -1;
    return st.size;
}
static int runv_secs(char **v, int secs) {
    char *out = 0;
    size_t n = 0;
    int rc = cx_runv_timeout(v, secs, &out, &n);
    if (out && n) sy_write_all(1, out, n);
    free(out);
    return rc;
}
static int bound_sh_secs(const char *root, char **rest, int secs) {
    char bound[4400], com[4400], secbuf[8];
    char *v[72];
    int n = 0, i = 0;
    if (secs < 1 || secs > 60) die("bound secs", "1..60");
    if (cx_fmt(bound, sizeof bound, "%s/tools/bound", root)) die("path", "bound");
    if (cx_fmt(com, sizeof com, "%s/unisacc.com", root)) die("path", "com");
    if (cx_fmt(secbuf, sizeof secbuf, "%d", secs)) die("fmt", "secs");
    v[n++] = bound;
    v[n++] = secbuf;
    v[n++] = (char *)"sh";
    v[n++] = com;
    while (rest[i] && n + 1 < 72) {
        v[n++] = rest[i];
        i++;
    }
    v[n] = 0;
    return runv_secs(v, secs);
}
static int bound_sh(const char *root, char **rest) { return bound_sh_secs(root, rest, 55); }
static int bound_ctor_eb(const char *snap, const char *ctor, const char *ebt, const char *pkg, const char *gout, const char *target) {
    char bound[4400], secbuf[8];
    char *v[24];
    int n = 0;
    if (sy_chmod(ctor, 0755)) die("chmod ctor", ctor);
    if (cx_fmt(bound, sizeof bound, "%s/tools/bound", snap)) die("path", "bound");
    if (cx_fmt(secbuf, sizeof secbuf, "%d", 55)) die("fmt", "secs");
    v[n++] = bound;
    v[n++] = secbuf;
    v[n++] = (char *)"sh";
    v[n++] = (char *)ctor;
    v[n++] = (char *)ebt;
    v[n++] = (char *)"--";
    v[n++] = (char *)snap;
    v[n++] = (char *)pkg;
    v[n++] = (char *)gout;
    v[n++] = (char *)ctor;
    v[n++] = (char *)"--o1-drivers";
    v[n++] = (char *)"--target";
    v[n++] = (char *)target;
    v[n++] = 0;
    return runv_secs(v, 55);
}
static int step_secs(const char *root, char **args, int secs) {
    char tool[4400];
    char *v[64];
    int n = 0, i = 0;
    if (cx_fmt(tool, sizeof tool, "%s/tools/chain-step.cx", root)) die("path", "chain-step");
    v[n++] = tool;
    v[n++] = (char *)"--";
    while (args[i] && n + 1 < 64) {
        v[n++] = args[i];
        i++;
    }
    v[n] = 0;
    return bound_sh_secs(root, v, secs);
}
static int step(const char *root, char **args) { return step_secs(root, args, 55); }
static char chain_work[4400];
/* 0.0.49 非 Linux 片: front 0/32, 32/32, 64/21, merge, stub. 不跑 image-build(Mac 合同禁止). */
static int wf_fronts(const char *root, const char *outdir, const char *helper, const char *target, const char *slug) {
    char wft[4400], prep[4400], p0[4400], p1[4400], p2[4400], phase[4400], dest[4400], tag[80];
    const char *offs[3] = {"0", "32", "64"};
    const char *cnts[3] = {"32", "32", "21"};
    char *parts[3];
    int i;
    if (cx_fmt(wft, sizeof wft, "%s/tools/whole-front.cx", root)) die("path", "wf");
    if (cx_fmt(prep, sizeof prep, "%s/wf-prep", chain_work)) die("path", "prep");
    if (cx_fmt(p0, sizeof p0, "%s/gen1/%s-front0", chain_work, slug)) die("path", "p0");
    if (cx_fmt(p1, sizeof p1, "%s/gen1/%s-front1", chain_work, slug)) die("path", "p1");
    if (cx_fmt(p2, sizeof p2, "%s/gen1/%s-front2", chain_work, slug)) die("path", "p2");
    if (cx_fmt(phase, sizeof phase, "%s/gen1/%s-merged", chain_work, slug)) die("path", "phase");
    if (cx_fmt(dest, sizeof dest, "%s/gen1/%s-stub", chain_work, slug)) die("path", "stub");
    parts[0] = p0; parts[1] = p1; parts[2] = p2;
    if (sy_setenv("UNISACC_IDENTITY_HELPER", helper, 1)) die("env", "helper");
    for (i = 0; i < 3; i++) {
        char *v[12];
        int n = 0;
        if (cx_fmt(tag, sizeof tag, "gen1-%s-front%d", slug, i)) die("fmt", slug);
        if (ck_done(outdir, tag)) { sy_printf("RESUME\t%s\n", tag); continue; }
        v[n++] = wft; v[n++] = (char *)"--";
        v[n++] = (char *)"front"; v[n++] = prep; v[n++] = (char *)target; v[n++] = parts[i];
        v[n++] = (char *)offs[i]; v[n++] = (char *)cnts[i]; v[n++] = 0;
        if (bound_sh_secs(root, v, 45)) die(tag, parts[i]);
        mark(outdir, tag, 0);
    }
    if (cx_fmt(tag, sizeof tag, "gen1-%s-merge", slug)) die("fmt", slug);
    if (!ck_done(outdir, tag)) {
        char *v[16];
        int n = 0;
        v[n++] = wft; v[n++] = (char *)"--";
        v[n++] = (char *)"merge"; v[n++] = prep; v[n++] = (char *)target; v[n++] = phase;
        v[n++] = p0; v[n++] = p1; v[n++] = p2; v[n++] = 0;
        if (bound_sh_secs(root, v, 45)) die(tag, phase);
        mark(outdir, tag, 0);
    } else sy_printf("RESUME\t%s\n", tag);
    if (cx_fmt(tag, sizeof tag, "gen1-%s-stub", slug)) die("fmt", slug);
    if (!ck_done(outdir, tag)) {
        char *v[12];
        int n = 0;
        v[n++] = wft; v[n++] = (char *)"--";
        v[n++] = (char *)"stub"; v[n++] = prep; v[n++] = (char *)target; v[n++] = phase; v[n++] = dest; v[n++] = 0;
        if (bound_sh_secs(root, v, 45)) die(tag, dest);
        mark(outdir, tag, 0);
    } else sy_printf("RESUME\t%s\n", tag);
    return 0;
}

static const char *g_phases[26] = {
    "snap", "build", "ctx", "host", "list",
    "jobs-tool", "jobs-gen", "jobs-tbl", "jobs-net", "final",
    "routes", "p3", "gen1-lnx-x86_64", "gen1-lnx-arm64",
    "gen1-osx-x86_64", "gen1-osx-arm64", "gen1-win-x86_64", "gen1-win-arm64",
    "g2-lnx-x86_64", "g2-lnx-arm64", "g3-lnx-x86_64", "g3-lnx-arm64",
    "kernels-g2", "kernels-g3", "compare", "pack"
};
static void plan(void) {
    int i;
    sy_printf("CANDIDATE_CHAIN\tplan\tphases=26\n");
    for (i = 0; i < 26; i++)
        sy_printf("PHASE\t%d\t%s\tchild_bound=55\n", i, g_phases[i]);
    sy_printf("NOTE\tgen1 six slices PREPARED before g2; g2/g3 linux objects then link\n");
    sy_printf("NOTE\tosx=whole-front A1/A2/B; win=st_span three phases; Mac B serial\n");
}

static int hex40(const char *s) {
    int i;
    if (!s) return 0;
    for (i = 0; i < 40; i++) {
        char c = s[i];
        int ok = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
        if (!ok) return 0;
    }
    return s[40] == 0;
}

static int ck_done(const char *dir, const char *phase) {
    char p[4400], needle[256];
    size_t n = 0;
    char *b;
    int hit;
    if (cx_fmt(p, sizeof p, "%s/checkpoint.tsv", dir)) die("path", dir);
    if (fsize(p) < 0) return 0;
    b = cx_read(p, &n);
    if (!b) return 0;
    if (cx_fmt(needle, sizeof needle, "DONE\t%s\t", phase)) {
        free(b);
        die("fmt", phase);
    }
    hit = tx_find(b, (long)n, needle, tx_len(needle, 200)) >= 0;
    free(b);
    return hit;
}
static void mark(const char *dir, const char *phase, long wall) {
    char p[4400], line[800];
    int fd;
    if (cx_fmt(p, sizeof p, "%s/checkpoint.tsv", dir)) die("path", dir);
    if (cx_fmt(line, sizeof line, "DONE\t%s\twall_ms=%ld\tsha=-\n", phase, wall)) die("fmt", phase);
    fd = sy_open(p, O_WRONLY | O_CREAT | O_APPEND, 0644);
    if (fd < 0 || sy_write_all(fd, line, tx_len(line, 800)) || sy_close(fd)) die("checkpoint", p);
    sy_printf("RECEIPT\t%s\twall_ms=%ld\n", phase, wall);
}

static int sjw(const char *s, const char *ctx, const char *b, const char *phase, int first, int count, const char *act) {
    char tool[4400], firsts[16], counts[16];
    char *v[12];
    int n = 0;
    if (cx_fmt(tool, sizeof tool, "%s/tools/source-job-wave.cx", s)) die("path", "sjw");
    if (cx_fmt(firsts, sizeof firsts, "%d", first)) die("fmt", "first");
    if (cx_fmt(counts, sizeof counts, "%d", count)) die("fmt", "count");
    v[n++] = tool;
    v[n++] = (char *)"--";
    v[n++] = (char *)s;
    v[n++] = (char *)ctx;
    v[n++] = (char *)b;
    v[n++] = (char *)"wave";
    v[n++] = (char *)phase;
    v[n++] = firsts;
    v[n++] = counts;
    v[n++] = (char *)act;
    v[n++] = 0;
    return bound_sh(s, v);
}
static int wave_phase(const char *outdir, const char *s, const char *ctx, const char *b,
                      const char *phase, int total, int resume) {
    int first = 0, count = total > 8 ? 8 : total;
    if (total == 5) count = 5;
    while (first < total) {
        char tag[80];
        long t0, wall;
        if (first + count > total) count = total - first;
        if (cx_fmt(tag, sizeof tag, "jobs-%s-%d-%d", phase, first, count)) die("fmt", phase);
        if (resume && ck_done(outdir, tag)) {
            sy_printf("RESUME\t%s\n", tag);
            first += count;
            continue;
        }
        t0 = sy_now_ms();
        if (sjw(s, ctx, b, phase, first, count, "start-job")) die("start-job", tag);
        if (sjw(s, ctx, b, phase, first, count, "finish-job")) die("finish-job", tag);
        wall = sy_now_ms() - t0;
        mark(outdir, tag, wall);
        sy_printf("WAVE_ADAPT\t%s\tfirst=%d\tcount=%d\twall_ms=%ld\n", phase, first, count, wall);
        first += count;
        if (wall > 40000 && count > 1) {
            count = count / 2;
            if (count < 1) count = 1;
        } else if (wall < 25000 && count < 16) {
            count = count + 4;
            if (count > 16) count = 16;
        }
    }
    return 0;
}
static int jobs_ok(const char *ctx) {
    char jobs[4400], p[4400], stpath[4400];
    DIR *d;
    struct dirent *e;
    int n = 0;
    if (cx_fmt(jobs, sizeof jobs, "%s/jobs", ctx)) die("path", "jobs");
    d = opendir(jobs);
    if (!d) die("opendir", jobs);
    while ((e = readdir(d))) {
        size_t nst = 0;
        char *st;
        if (e->d_name[0] == '.') continue;
        if (cx_fmt(p, sizeof p, "%s/%s/record.tsv", jobs, e->d_name)) die("path", "record");
        if (fsize(p) < 1) { closedir(d); die("missing record", p); }
        if (cx_fmt(stpath, sizeof stpath, "%s/%s/command.status", jobs, e->d_name)) die("path", "status");
        st = cx_read(stpath, &nst);
        if (!st || nst != 5 || st[0] != 'r' || st[1] != 'c' || st[2] != '\t' || st[3] != '0' || st[4] != '\n') {
            free(st); closedir(d); die("job command.status", stpath);
        }
        free(st);
        n++;
    }
    closedir(d);
    if (n != 131) die("job count not 131", jobs);
    sy_printf("FINAL\tjobs=131\tcommand_rc=0\trecords=present\n");
    return 0;
}
static int json_quoted(const char *j, size_t n, const char *key, char *dst, int want) {
    char pat[80];
    long at, i;
    if (cx_fmt(pat, sizeof pat, "\"%s\": \"", key)) return 1;
    at = tx_find(j, (long)n, pat, tx_len(pat, 80));
    if (at < 0) return 1;
    at += tx_len(pat, 80);
    for (i = 0; i < want; i++) {
        char c;
        if (at + i >= (long)n) return 1;
        c = j[at + i];
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return 1;
        dst[i] = c;
    }
    dst[want] = 0;
    return 0;
}
static int git_is_ancestor(const char *oldc, const char *newc) {
    char *v[6];
    char *o = 0;
    size_t n = 0;
    int rc;
    v[0] = "git"; v[1] = "merge-base"; v[2] = "--is-ancestor";
    v[3] = (char *)oldc; v[4] = (char *)newc; v[5] = 0;
    rc = cx_runv_timeout(v, 8, &o, &n);
    free(o);
    return rc == 0;
}
static int snap_ok(const char *dir, const char *rev, const char *helper) {
    char mark[4400], js[4400], ape[4400], h[65], commit[41], sid[65], dig[65], live[65];
    size_t mn = 0, jn = 0, an = 0, hn = 0;
    char *m, *j, *a, *text = 0;
    int rc, k;
    if (!helper || !helper[0]) die("REFUSE identity-helper required", dir);
    if (cx_fmt(mark, sizeof mark, "%s/.release-rev", dir)) die("path", "revmark");
    if (cx_fmt(js, sizeof js, "%s/unisacc.com.build.json", dir)) die("path", "json");
    if (cx_fmt(ape, sizeof ape, "%s/unisacc.com", dir)) die("path", "ape");
    m = cx_read(mark, &mn);
    if (!m || mn < 40 || !hex40(rev)) { free(m); die("REFUSE snap rev marker", mark); }
    if (mn > 40 && m[40] != '\n' && m[40] != 0) { free(m); die("REFUSE snap rev marker", mark); }
    m[40] = 0;
    if (!hex40(m) || !tx_eqz(m, rev)) { free(m); die("REFUSE snap rev mismatch", mark); }
    free(m);
    j = cx_read(js, &jn);
    if (!j) die("REFUSE snap receipt", js);
    if (json_quoted(j, jn, "commit", commit, 40)) { free(j); die("REFUSE snap receipt commit", js); }
    if (json_quoted(j, jn, "sources_sha256", sid, 64)) { free(j); die("REFUSE snap receipt SID", js); }
    if (json_quoted(j, jn, "product_digest", dig, 64)) { free(j); die("REFUSE snap receipt digest", js); }
    free(j);
    a = cx_read(ape, &an);
    if (!a) die("REFUSE snap product", ape);
    if (sy_sha256_hex(a, (long)an, h)) { free(a); die("sha", ape); }
    free(a);
    if (!tx_eqz(h, dig)) die("REFUSE snap product SHA mismatch", ape);
    if (!tx_eqz(commit, rev)) {
        if (!git_is_ancestor(commit, rev)) die("REFUSE snap receipt commit not ancestor", commit);
        sy_printf("BOOTSTRAP_FROM\tcommit=%s\tbootstrap_product=%s\n", commit, dig);
    }
    {
        char *v[3];
        v[0] = (char *)helper; v[1] = (char *)dir; v[2] = 0;
        rc = cx_runv_timeout(v, 8, &text, &hn);
        if (rc || !text || hn != 65 || text[64] != '\n') { free(text); die("REFUSE live source SID", helper); }
        for (k = 0; k < 64; k++) {
            char c = text[k];
            if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) { free(text); die("REFUSE live source SID", helper); }
            live[k] = c;
        }
        live[64] = 0;
        free(text);
    }
    sy_printf("SNAP_OK\trev=%s\trecord_sid=%.16s\tlive_sid=%.16s\tproduct=%.16s\tbytes=%lu\n", rev, sid, live, dig, (unsigned long)an);
    return 0;
}

static int parse_par(const char *s) {
    int n = 0, i;
    if (!s || !s[0]) return -1;
    for (i = 0; s[i]; i++) {
        if (s[i] < '0' || s[i] > '9') return -1;
        n = n * 10 + (s[i] - '0');
        if (n > 16) return -1;
    }
    if (n < 1) return -1;
    return n;
}
static void worker_nm_ok(const char *obj) {
    char *v[4];
    char *text = 0;
    size_t n = 0;
    long at;
    v[0] = "nm"; v[1] = "-u"; v[2] = (char *)obj; v[3] = 0;
    if (cx_runv_timeout(v, 8, &text, &n) || !text) { free(text); die("nm", obj); }
    at = tx_find(text, (long)n, "setpgid", 7);
    free(text);
    if (at >= 0) die("REFUSE worker.o libc setpgid", obj);
}

int main(int argc, char **argv) {
    const char *rev = 0, *outdir = 0, *cc = "/usr/bin/x86_64-linux-gnu-gcc-11";
    const char *vs_dir = 0, *vs_rev = 0, *idhelp = 0, *cm64 = 0, *cmarm = 0, *boot = 0, *wnm = 0;
    int resume = 0, parallel = 0, i, plan_only = 0;
    char root[4400], snap[4400], build[4400], ctx[4400], routes[4400], pkg[4400], fp[4400], gen1[4400], helper[4400];
    if (sy_realpath(".", root, sizeof root) < 0) die("cwd", ".");
    for (i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--plan")) { plan_only = 1; continue; }
        if (tx_eqz(argv[i], "--worker-nm") && i + 1 < argc) { wnm = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--resume")) { resume = 1; continue; }
        if (tx_eqz(argv[i], "--verify-snap") && i + 2 < argc) { vs_dir = argv[++i]; vs_rev = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--identity-helper") && i + 1 < argc) { idhelp = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--rev") && i + 1 < argc) { rev = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--out") && i + 1 < argc) { outdir = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--cc") && i + 1 < argc) { cc = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--cache-manager-osx") && i + 2 < argc) { cm64 = argv[++i]; cmarm = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--bootstrap") && i + 1 < argc) { boot = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--parallel") && i + 1 < argc) {
            parallel = parse_par(argv[++i]);
            if (parallel < 1) die("REFUSE parallel 1..16", argv[i]);
            continue;
        }
        die("REFUSE unknown/duplicate option", argv[i]);
    }
    if (wnm) { worker_nm_ok(wnm); sy_printf("WORKER_NM_OK\t%s\n", wnm); return 0; }
    if (vs_dir) {
        if (!vs_rev || !hex40(vs_rev)) die("REFUSE --rev 40-hex required", vs_rev);
        if (!idhelp) die("REFUSE --identity-helper required", vs_dir);
        return snap_ok(vs_dir, vs_rev, idhelp);
    }
    if (plan_only) {
        plan();
        return 0;
    }
    if (!rev || !hex40(rev)) die("REFUSE --rev 40-hex required", rev);
    if (!outdir || !*outdir) die("REFUSE --out required", 0);
    if (sy_mkdir(outdir, 0755) && fsize(outdir) < 0) die("mkdir", outdir);
    if (cx_fmt(snap, sizeof snap, "%s/out/release-snap-%.10s", root, rev)) die("path", "snap");
    {
        char mid[4400];
        if (cx_fmt(mid, sizeof mid, "%s/out", snap)) die("path", "snap-out");
        sy_mkdir(mid, 0755);
        if (cx_fmt(chain_work, sizeof chain_work, "%s/out/chain", snap)) die("path", "chain");
        if (sy_mkdir(chain_work, 0755) && fsize(chain_work) < 0) die("mkdir", chain_work);
    }
    if (cx_fmt(build, sizeof build, "%s/build", outdir)) die("path", "build");
    if (cx_fmt(ctx, sizeof ctx, "%s/ctx", outdir)) die("path", "ctx");
    if (cx_fmt(routes, sizeof routes, "%s/routes", outdir)) die("path", "routes");
    if (cx_fmt(pkg, sizeof pkg, "%s/compiler.p4.pkg", outdir)) die("path", "pkg");
    if (cx_fmt(fp, sizeof fp, "%s/fixedpoint", outdir)) die("path", "fp");
    if (cx_fmt(gen1, sizeof gen1, "%s/gen1/lnx-x86_64/candidate", outdir)) die("path", "gen1");
    if (cx_fmt(helper, sizeof helper, "%s/identity-helper", ctx)) die("path", "helper");

    sy_printf("CANDIDATE_CHAIN\trev=%s\tout=%s\tresume=%d\tparallel=%d\n", rev, outdir, resume, parallel);
    if (parallel > 1)
        sy_printf("G0b\tparallel=%d\tmac_B=serial\twrite_domains=per-target-dir\tderate=measured\n", parallel);

    if (!(resume && ck_done(outdir, "snap"))) {
        long t0 = sy_now_ms();
        char *a[4];
        a[0] = (char *)"snap"; a[1] = (char *)rev; a[2] = (char *)"out"; a[3] = 0;
        if (step(root, a)) die("snap", snap);
        mark(outdir, "snap", sy_now_ms() - t0);
    } else sy_printf("RESUME\tsnap\n");

    if (sy_mkdir(build, 0755) && fsize(build) < 0) die("mkdir", build);
    if (boot && boot[0]) {
        char dst[4400];
        size_t bn = 0;
        char *bb;
        if (cx_fmt(dst, sizeof dst, "%s/Root41-bootstrap.com", build)) die("path", "boot");
        bb = cx_read(boot, &bn);
        if (!bb || cx_write(dst, bb, bn)) { free(bb); die("install bootstrap", dst); }
        free(bb);
