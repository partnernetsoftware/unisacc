/* tools/candidate-chain.cx -- G0 一条命令编排 chain-step 全链。
 *
 *   sh ./unisacc.com tools/candidate-chain.cx -- --plan
 *   sh ./unisacc.com tools/candidate-chain.cx -- --rev REV --out DIR [--resume] [--parallel N] [--cc PATH]
 *
 * Each child is bounded to 90 seconds. Independent start/finish waves honor
 * --parallel (default 4) and retain per-job checkpoints. --jobs ROOT CTX BUILD
 * PHASE --job-index N runs one resumable job; --touch REL selects affected nets.
 * --baseline-ctx BASE accepts unchanged jobs only through verified adoption.
 * Final unions and P3 guards have individual --until phases. Frozen-run final
 * proofs rehash metadata and retain payload stat identity, not an ABA guarantee.
 */
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.sha
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use cxlib.procrun
#pragma unisa use cxlib.chainfacts
#pragma unisa use cxlib.shamemo
#pragma unisa use sys.posix
#pragma unisa use cxlib.limits

static void die(const char *a, const char *b) {
    fprintf(stderr, "candidate-chain: %s%s%s\n", a, b ? ": " : "", b ? b : "");
    exit(2);
}
/* Time bounds come from build/limits.tsv (cxlib.limits); an unknown id refuses. */
static int cc_lim(const char *id, const char *scope) {
    double v = lm_get(id, scope);
    if (v < 1) die("unknown limit id", id);
    return (int)v;
}
/* The default child/phase bound (phase.bound, scope *). */
/* A caller (chain-run) passes the phase's own bound in UNISACC_CHAIN_PHASE_BOUND_S; it must lie in 1..phase.bound max. */
static int cc_pb(void) {
    static int pb;
    if (!pb) {
        const char *e = getenv("UNISACC_CHAIN_PHASE_BOUND_S");
        pb = cc_lim("phase.bound", 0);
        if (e && *e) {
            char *end = 0; long v = strtol(e, &end, 10);
            if (*end || v < 1 || v > (long)lm_max("phase.bound", 0)) die("REFUSE phase bound from caller", e);
            pb = (int)v;
        }
    }
    return pb;
}
static long fsize(const char *p) {
    sy_stat_t st;
    if (sy_stat(p, &st)) return -1;
    return st.size;
}
/* Install bytes at dst: identical content (same length and bytes) is left untouched so inode/mtime
   stay put; otherwise write a sibling temp name and rename over dst atomically. Returns 0 or -1. */
static int install_if_changed(const char *dst, const char *bytes, size_t n, int mode) {
    size_t on = 0;
    char *old = cx_read(dst, &on);
    char tmp[4500];
    int same = old && on == n && !memcmp(old, bytes, n);
    free(old);
    if (same) return 0;
    if (cx_fmt(tmp, sizeof tmp, "%s.tmp-install", dst)) return -1;
    if (cx_write(tmp, bytes, n)) { sy_unlink(tmp); return -1; }
    if (mode) sy_chmod(tmp, mode);
    if (sy_rename(tmp, dst)) { sy_unlink(tmp); return -1; }
    return 0;
}
/* Child exit as the old cx_runv_timeout callers read it: the code, 128+signal, or 124 on a timeout
   (now also named on stderr by cxlib.procrun). stdout and stderr are echoed after the child ends. */
/* A segment contains many independently bounded children, never a longer child. */
static long jobs_segment_end;
static const char *jobs_segment_out;
static void segment_admit(int secs) {
    if (jobs_segment_end && sy_now_ms() + (long)secs * 1000 > jobs_segment_end) {
        char p[4400], hash[65]; size_t n = 0;
        const char *token = sy_env("UNISACC_CHAIN_SEGMENT_TOKEN");
        if (!token || !jobs_segment_out || cx_fmt(p, sizeof p, "%s/checkpoint.tsv", jobs_segment_out)) die("segment identity", 0);
        char *b = cx_read(p, &n);
        if (!b || sy_sha256_hex(b, (long)n, hash)) { free(b); die("segment checkpoint", p); }
        free(b);
        sy_printf("CANDIDATE_SEGMENT\t%s\t%s\n", token, hash);
        exit(75);
    }
}
/* A phase whose work is many bounded calls with its own committed progress (the fixedpoint root
   and closure objects: one call per batch of keys, each committed key recorded in .chain-steps)
   can need more than one attempt. Running into the attempt bound is a kill: the in-flight batch
   is lost and the runner counts a resume, of which a whole chain has three (0.0.58: g2 closure
   prepare was killed at the bound in every attempt and the chain stopped on resumes-exhausted
   with 38 of 44 root keys committed). The runner hands each attempt its end
   (UNISACC_CHAIN_ATTEMPT_END_MS) and a token; when the next call would not fit and this attempt
   has committed at least one batch, the candidate stops itself: it names the token and the
   checkpoint bytes it saw (length and sha256; the file only grows, so the prefix stays
   checkable while other lanes append) and exits 75. The runner verifies the line and runs the
   phase again without counting a resume. No progress in the attempt means no yield. */
static long attempt_end;
static void phase_yield(const char *why, long last_ms, long need_ms) {
    char p[4400], hash[65]; size_t n = 0;
    const char *token = sy_env("UNISACC_CHAIN_SEGMENT_TOKEN");
    if (!token || !jobs_segment_out || cx_fmt(p, sizeof p, "%s/checkpoint.tsv", jobs_segment_out)) die("yield identity", 0);
    char *b = cx_read(p, &n);
    if (!b || sy_sha256_hex(b, (long)n, hash)) { free(b); die("yield checkpoint", p); }
    free(b);
    sy_printf("PHASE_YIELD\t%s\tlast_ms=%ld\tneed_ms=%ld\n", why, last_ms, need_ms);
    sy_printf("CANDIDATE_YIELD\t%s\t%ld\t%s\n", token, (long)n, hash);
    exit(75);
}
static int pr_code_at(const char *label, char **v, const char *cwd, int secs) {
    segment_admit(secs);
    pr_result r;
    int t = pr_run(label, v, cwd, 0, secs, &r);
    if (t && r.timed_out) { fprintf(stderr, "candidate-chain: %s\n", r.why); return 124; }
    if (t) { fprintf(stderr, "candidate-chain: %s\n", r.why); return 127; }
    pr_echo(&r);
    t = r.rc < 0 ? 128 - r.rc : r.rc;
    pr_free(&r);
    return t;
}
static int pr_code(const char *label, char **v, int secs) { return pr_code_at(label, v, 0, secs); }
static int runv_secs(char **v, int secs) { return pr_code(v[0], v, secs); }
/* "sh ROOT/unisacc.com REST..." bounded by SECS: a thin call of pr_run, which owns the process
   group and kills it at the bound (the tools/bound wrapper this used to add is no longer needed). */
/* Locks live beside prepared directories, never inside a directory scrubbed by
 * preparation. Close-on-exec keeps ownership in the candidate parent. */
static long candidate_lock_wait_ms;
static void candidate_lock_fd(int fd, const char *path) {
    long start = sy_now_ms();
    for (;;) {
        int rc = sy_flock(fd, 2 | 4);
        if (!rc) break;
        if (rc != -EWOULDBLOCK && rc != -EAGAIN && rc != -EINTR) die("candidate lock", path);
        if (sy_now_ms() - start + candidate_lock_wait_ms >= cc_pb() * 1000L) die("candidate lock deadline", path);
        usleep(1000);
    }
    candidate_lock_wait_ms += sy_now_ms() - start;
}
static int candidate_lock(const char *base, const char *domain) {
    char p[4500];
    if (cx_fmt(p, sizeof p, "%s.candidate-%s.lock", base, domain)) die("lock path", base);
    int fd = sy_open(p, O_WRONLY | O_CREAT | O_CLOEXEC, 0644);
    if (fd < 0) die("candidate lock", p);
    candidate_lock_fd(fd, p);
    return fd;
}
static const char *step_out;
static const char *tool_pinned(const char *root, const char *tool, int secs, char *native, size_t cap);
static int bound_sh_secs(const char *root, char **rest, int secs) {
    char com[4400], pnative[4400];
    char *v[128+28];
    int n = 0, i = 0;
    const char *pname = 0;
    if (secs < 1 || secs > (int)lm_max("phase.bound", 0)) die("REFUSE bound secs above phase.bound max", 0);
    if (cx_fmt(com, sizeof com, "%s/unisacc.com", root)) die("path", "com");
    if (step_out && rest[0] && rest[1] && !strcmp(rest[1], "--")) pname = tool_pinned(root, rest[0], secs, pnative, sizeof pnative);
    if (pname) {
        /* 钉住的链工具:直接跑输出目录内那一份可执行体,不再读工作检出 */
        v[n++] = pnative;
        i = 2;
    } else {
        v[n++] = (char *)"sh";
        v[n++] = com;
    }
    while (rest[i] && n + 1 < 72) {
        v[n++] = rest[i];
        i++;
    }
    v[n] = 0;
    int lock = -1;
    if (rest[0] && strstr(rest[0], "/tools/whole-front.cx") && rest[1] && rest[2] && rest[3])
        lock = candidate_lock(!strcmp(rest[2], "prepare") ? rest[7] : rest[3], "prep");
    int budget = cc_pb() - (int)((candidate_lock_wait_ms + 999) / 1000);
    if (budget < 1) die("candidate lock/call deadline", rest[0]);
    if (secs > budget) secs = budget;
    int rc = pr_code(rest[0] ? rest[0] : "sh", v, secs);
    candidate_lock_wait_ms = 0;
    if (lock >= 0 && sy_close(lock)) die("candidate unlock", rest[0]);
    return rc;
}
static int bound_sh(const char *root, char **rest) { return bound_sh_secs(root, rest, cc_pb()); }
/* Run tools/preflight.cx at one hook point (entry, post-snap, pre-p3, post-p3) under --strict:
   only that hook's rules from build/preflight-rules.tsv; a variable the chain has produced by
   then but missing is a FAIL, and a SKIP is a failure too. Any failure stops the chain here,
   naming the hook; the PASS/FAIL lines are already on stdout. PKG and SNAP are passed always:
   the tool decides which hook needs them. */
static void preflight(const char *root, const char *hook, const char *rev, const char *build,
                      const char *snap, const char *pkg) {
    char tool[4400], rules[4400], a_root[4500], a_build[4500], a_snap[4500], a_rev[64], a_pkg[4500], a_hook[40];
    char *v[16];
    int n = 0;
    if (cx_fmt(tool, sizeof tool, "%s/tools/preflight.cx", root) ||
        cx_fmt(rules, sizeof rules, "%s/build/preflight-rules.tsv", root) ||
        cx_fmt(a_root, sizeof a_root, "ROOT=%s", root) ||
        cx_fmt(a_build, sizeof a_build, "BUILD=%s", build) ||
        cx_fmt(a_snap, sizeof a_snap, "SNAP=%s", snap) ||
        cx_fmt(a_rev, sizeof a_rev, "REV=%s", rev) ||
        cx_fmt(a_pkg, sizeof a_pkg, "PKG=%s", pkg) ||
        cx_fmt(a_hook, sizeof a_hook, "PHASE=%s", hook)) die("path", "preflight");
    v[n++] = tool; v[n++] = (char *)"--"; v[n++] = rules;
    v[n++] = a_root; v[n++] = a_build; v[n++] = a_snap; v[n++] = a_rev; v[n++] = a_pkg;
    v[n++] = a_hook; v[n++] = (char *)"--strict"; v[n] = 0;
    if (bound_sh_secs(root, v, cc_pb())) die("REFUSE preflight", hook);
    sy_printf("PREFLIGHT_HOOK\t%s\tok\n", hook);
}
/* Make CTOR executable (0755) only when its mode differs. An unconditional chmod moves the
   file's ctime on every resume even when nothing changes, and the constructor's translation
   cache is keyed on its identity: every tool it had already translated was then translated
   again in the next phase (measured on p3-opguard: about 21 of 53 seconds). */
static int ctor_exec(const char *ctor) {
    sy_stat_t st;
    if (!sy_stat(ctor, &st) && st.kind == 'f' && (st.mode & 07777) == 0755) return 0;
    return sy_chmod(ctor, 0755);
}
/* The watchdog of a constructor step is SNAP/tools/bound: a frozen input of the rev, with the
   range that rev was frozen with. A rev frozen before the temporary 55 -> 90 raise accepts
   1..60 and answers 90 with its usage line (0.0.58, gen1-lnx-arm64-objects: rc 2 in 0.4 s,
   nothing built). The chain asks the snapshot's own watchdog once whether it takes the step
   bound; if not, the step runs under 60, the largest value every frozen watchdog accepts.
   Never more than the step bound, and a watchdog that takes neither is a refusal. */
static int ctor_bound_secs(const char *bound, int want) {
    static int known;
    if (known) return known;
    char secbuf[8];
    char *probe[] = {(char *)bound, secbuf, (char *)"true", 0};
    if (cx_fmt(secbuf, sizeof secbuf, "%d", want)) die("fmt", "secs");
    if (!runv_secs(probe, 30)) return known = want;
    int frozen = cc_lim("ctor.frozen", 0);
    if (want <= frozen || cx_fmt(secbuf, sizeof secbuf, "%d", frozen) || runv_secs(probe, 30)) die("REFUSE snapshot watchdog accepts neither the step bound nor the frozen range", bound);
    sy_printf("CTOR_BOUND\tsnapshot-watchdog=%d\tstep-bound=%d\treason=frozen-range\n", frozen, want);
    return known = frozen;
}
static int bound_ctor_eb(const char *snap, const char *ctor, const char *ebt, const char *pkg, const char *gout, const char *target, const char *phase) {
    char bound[4400], secbuf[8];
    char *v[24];
    int n = 0;
    if (ctor_exec(ctor)) die("chmod ctor", ctor);
    if (cx_fmt(bound, sizeof bound, "%s/tools/bound", snap)) die("path", "bound");
    if (cx_fmt(secbuf, sizeof secbuf, "%d", ctor_bound_secs(bound, cc_pb()))) die("fmt", "secs");
    v[n++] = bound;
    v[n++] = secbuf;
    v[n++] = (char *)"sh";
    v[n++] = (char *)ctor;
    v[n++] = (char *)ebt;
    v[n++] = (char *)"--";
    v[n++] = (char *)snap;
    v[n++] = (char *)pkg;
    v[n++] = (char *)gout;
    v[n++] = (char *)ctor;
    v[n++] = (char *)"--o1-drivers";
    v[n++] = (char *)"--target";
    v[n++] = (char *)target;
    v[n++] = (char *)phase;
    v[n++] = 0;
    return runv_secs(v, cc_pb());
}
/* chain-step is the producer named in the seed-helper, controller and fixedpoint receipts
   (producer_sha/chain_sha = its own executable). Run from ROOT/tools/chain-step.cx on every call,
   that identity followed the working checkout: any edit of chain-step.cx or of a module it uses,
   made while a chain was running, changed the producer and the next resume refused its own
   receipts ("seed helper receipt mismatch", 0.0.58). The chain therefore pins one executable per
   output: OUT/chain-step.native, built once from ROOT, with OUT/chain-step.pin recording its
   sha256. Every later call of this output runs that file and refuses when its bytes no longer
   match the record; the checkout is not read again. A new output pins the tool anew. */
static char step_native[4400];
static void step_hash(const char *path, char hash[65]) {
    size_t n = 0; char *b = cx_read(path, &n);
    if (!b || sy_sha256_hex(b, (long)n, hash)) { free(b); die("REFUSE chain-step pin unreadable", path); }
    free(b);
}
static void step_pin(const char *root, int secs) {
    char pin[4400], tmp[4400], pintmp[4400], tool[4400], hash[65], text[4800];
    if (step_native[0]) return;
    if (cx_fmt(step_native, sizeof step_native, "%s/chain-step.native", step_out) || cx_fmt(pin, sizeof pin, "%s/chain-step.pin", step_out) ||
        cx_fmt(tmp, sizeof tmp, "%s.new", step_native) || cx_fmt(pintmp, sizeof pintmp, "%s.new", pin) ||
        cx_fmt(tool, sizeof tool, "%s/tools/chain-step.cx", root)) die("path", "chain-step pin");
    int lock = candidate_lock(step_native, "pin");
    size_t n = 0; char *old = cx_read(pin, &n);
    if (old) {
        step_hash(step_native, hash);
        if (cx_fmt(text, sizeof text, "chain-step-pin-v1\nnative_sha=%s\n", hash) || n != strlen(text) || memcmp(old, text, n)) die("REFUSE chain-step pin mismatch", pin);
        free(old);
    } else {
        /* No record: nothing of this output was produced by a pinned tool yet (a native without
           its record is what a killed attempt left and is replaced). */
        char *a[] = {tool, (char *)"-o", tmp, 0};
        if (bound_sh_secs(root, a, secs)) die("chain-step pin build", tool);
        step_hash(tmp, hash);
        if (cx_fmt(text, sizeof text, "chain-step-pin-v1\nnative_sha=%s\n", hash)) die("chain-step pin record", pin);
        if (sy_chmod(tmp, 0755) || sy_rename(tmp, step_native)) die("publish chain-step native", step_native);
        if (cx_write(pintmp, text, strlen(text)) || sy_rename(pintmp, pin)) die("publish chain-step pin", pin);
        sy_printf("CHAIN_STEP_PIN\tbuilt=%s\tsha=%s\n", step_native, hash);
    }
    if (sy_close(lock)) die("candidate unlock", step_native);
}
/* 同一机制推广到 whole-front、preflight、release-build、release-ape(0.0.59):每个输出目录内
   NAME.native 只构造一次,NAME.pin 记录工具名、输出目录、构造时源码 sha 与可执行体 sha256;之后每次
   (每进程首次)核对,可执行体字节变化拒绝 "REFUSE chain-tool pin mismatch",pin 被拷到别的输出目录
   拒绝 "REFUSE chain-tool pin dir mismatch"。检出内工具改动不影响本输出,与 chain-step 同。 */
static int pin_busy;
static const char *tool_pinned(const char *root, const char *tool, int secs, char *native, size_t cap) {
    static const char *names[] = {"whole-front", "preflight", "release-build", "release-ape", 0};
    static char done[4][4400];
    const char *name = 0;
    char want[4400], pin[4400], tmp[4400], pintmp[4400], hash[65], shash[65], text[9000];
    int k;
    size_t tl = strlen(tool);
    if (pin_busy) return 0;
    for (k = 0; names[k]; k++) {
        if (cx_fmt(want, sizeof want, "/tools/%s.cx", names[k])) die("path", "tool pin");
        if (tl > strlen(want) && !strcmp(tool + tl - strlen(want), want)) { name = names[k]; break; }
    }
    if (!name) return 0;
    if (cx_fmt(native, cap, "%s/%s.native", step_out, name) || cx_fmt(pin, sizeof pin, "%s/%s.pin", step_out, name) ||
        cx_fmt(tmp, sizeof tmp, "%s.new", native) || cx_fmt(pintmp, sizeof pintmp, "%s.new", pin)) die("path", "tool pin");
    if (!strcmp(done[k], native)) return name;
    int lock = candidate_lock(native, "pin");
    size_t n = 0; char *old = cx_read(pin, &n);
    if (old) {
        char *o = strstr(old, "\nout=");
        char outl[4500];
        if (cx_fmt(outl, sizeof outl, "\nout=%s\n", step_out) || !o || memcmp(o, outl, strlen(outl))) die("REFUSE chain-tool pin dir mismatch", pin);
        step_hash(native, hash);
        char nl2[200];
        if (cx_fmt(nl2, sizeof nl2, "\nnative_sha=%s\n", hash) || n < strlen(nl2) || memcmp(old + n - strlen(nl2), nl2, strlen(nl2))) die("REFUSE chain-tool pin mismatch", pin);
        free(old);
    } else {
        char *a[] = {(char *)tool, (char *)"-o", tmp, 0};
        pin_busy = 1;
        int rc = bound_sh_secs(root, a, secs);
        pin_busy = 0;
        if (rc) die("chain-tool pin build", tool);
        step_hash(tool, shash);
        step_hash(tmp, hash);
        if (cx_fmt(text, sizeof text, "chain-tool-pin-v1\ntool=%s\nout=%s\nsrc_sha=%s\nnative_sha=%s\n", name, step_out, shash, hash)) die("chain-tool pin record", pin);
        if (sy_chmod(tmp, 0755) || sy_rename(tmp, native)) die("publish chain-tool native", native);
        if (cx_write(pintmp, text, strlen(text)) || sy_rename(pintmp, pin)) die("publish chain-tool pin", pin);
        sy_printf("CHAIN_TOOL_PIN\ttool=%s\tbuilt=%s\tsha=%s\n", name, native, hash);
    }
    if (sy_close(lock)) die("candidate unlock", native);
    if (cx_fmt(done[k], sizeof done[k], "%s", native)) die("path", "tool pin");
    return name;
}
/* Only the fixture entries (--g2g3-fixture and the like) have no output directory: they trace the
   argv through a fake ROOT/unisacc.com ("TOOL -- ARGS") and produce no receipt. A chain run
   always has --out and runs the pinned executable directly. */
static int step_run(const char *root, char **v, int secs) {
    if (!step_out) return bound_sh_secs(root, v, secs);
    return pr_code("chain-step", v, secs);
}
static int step_secs(const char *root, char **args, int secs) {
    char tool[4400];
    char *v[64];
    int n = 0, i = 0;
    if (step_out) {
        step_pin(root, secs);
        v[n++] = step_native;
    } else {
        if (cx_fmt(tool, sizeof tool, "%s/tools/chain-step.cx", root)) die("path", "chain-step");
        v[n++] = tool;
        v[n++] = (char *)"--";
    }
    while (args[i] && n + 1 < 64) {
        v[n++] = args[i];
        i++;
    }
    v[n] = 0;
    return step_run(root, v, secs);
}
static int step(const char *root, char **args) { return step_secs(root, args, cc_pb()); }
static char chain_work[4400];
static int derived_shape(const char *snap, const char *extra, const char *extra_skip, char fp[65]);
/* 0.0.49: osx=front/merge/stub; win=front/merge then st_span units/e3/prune-elf. */
static char span_roots[128][4400];
static int load_span_roots(const char *prep) {
    char p[4400], line[4400];
    FILE *f;
    int i = 0;
    if (cx_fmt(p, sizeof p, "%s/roots.txt", prep)) die("path", "span-roots");
    f = fopen(p, "rb");
    if (!f) die("open", p);
    while (fgets(line, (int)sizeof line, f)) {
        if (i >= cf_root_count()) { fclose(f); die("span roots count", p); }
        size_t n = strlen(line);
        if (n && line[n - 1] == '\n') line[--n] = 0;
        if (!n || n >= sizeof span_roots[0]) { fclose(f); die("root line", p); }
        if (tx_copy(span_roots[i], sizeof span_roots[i], line, (long)n)) { fclose(f); die("root copy", p); }
        i++;
    }
    fclose(f);
    if (i != cf_root_count()) die("span roots count", p);
    return 0;
}
/* P1: gen1 Mac/Win 路由按代(gen=1..3)参数化。gen=1 的目录名、相位 tag、检查点名与参数化前逐字一致;
   gen>1 时 prepare 目录带代号(wf-prep-g2),因 prepare 绑构造器身份。其余路径与 tag 的 gen1 前缀换成 gen<N>。 */
static void check_gen(int gen) {
    if (gen < 1 || gen > 3) die("REFUSE gen must be 1..3", 0);
}
static void prep_dir(char *buf, long cap, int gen, const char *base) {
    check_gen(gen);
    if (gen == 1 ? cx_fmt(buf, cap, "%s/%s", chain_work, base) : cx_fmt(buf, cap, "%s/%s-g%d", chain_work, base, gen)) die("path", base);
}
static void span_prep_tag(char *buf, long cap, int gen) {
    check_gen(gen);
    if (gen == 1 ? cx_fmt(buf, cap, "wf-span-prep") : cx_fmt(buf, cap, "wf-span-prep-g%d", gen)) die("fmt", "span-prep-tag");
}
static void wf_scrub_dest(const char *outdir, const char *dest);
static const char *until_phase;
static const char *lane_phase;
/* part.tsv is the authority for partitioning: 32 units per child, WF_MAX=128 unchanged.
   Existing front0/1/2 names survive; a fourth child is scheduled only when total > 96. */
static int wf_total(const char *front0) {
    char pt[4400];
    size_t n = 0, i = 0;
    char *b;
    long total = -1;
    if (cx_fmt(pt, sizeof pt, "%s/part.tsv", front0)) die("path", "part.tsv");
    b = cx_read(pt, &n);
    if (!b) die("REFUSE front0 part.tsv unreadable", pt);
    while (i < n) {
        size_t e = i;
        while (e < n && b[e] != '\n') e++;
        if (e - i > 6 && b[i] == 't' && b[i + 1] == 'o' && b[i + 2] == 't' && b[i + 3] == 'a' && b[i + 4] == 'l' && b[i + 5] == '\t') {
            size_t k = i + 6;
            if (total >= 0) { free(b); die("REFUSE front0 part.tsv duplicate total", pt); }
            total = 0;
            while (k < e) {
                if (b[k] < '0' || b[k] > '9' || total > 100000) { free(b); die("REFUSE front0 part.tsv total", pt); }
                total = total * 10 + (b[k] - '0');
                k++;
            }
        }
        i = e + 1;
    }
    free(b);
    if (total < cf_root_count() || total > cf_wf_max()) die("REFUSE front total outside WF_MAX", pt);
    return (int)total;
}
static void wf_tail_count(const char *front0, int first, char *buf, long cap) {
    int total = wf_total(front0), count = total - first;
    if (first < 0 || first >= total) die("REFUSE front slice offset", front0);
    if (count > cf_front_slice()) count = cf_front_slice();
    if (cx_fmt(buf, cap, "%d", count)) die("fmt", "tail count");
    sy_printf("WF_TAIL\ttotal=%d\tfirst=%d\tcount=%d\n", total, first, count);
}
static int wf_inventory(const char *outdir, int gen, const char *slug, const char *front0, int want_stub) {
    char p[4400], bytes[2048];
    int total = wf_total(front0), slice = cf_front_slice();
    int used = snprintf(bytes, sizeof bytes, "# total\t%d\n", total);
    int slices = (total + slice - 1) / slice;
    for (int i = 0; i < slices; i++) {
        int count = total - i * slice;
        if (count > slice) count = slice;
        int n = snprintf(bytes + used, sizeof bytes - used, "gen%d-%s-front%d\t%d\t%d\n", gen, slug, i, i * slice, count);
        if (n < 0 || n >= (int)sizeof bytes - used) die("front inventory bound", slug);
        used += n;
    }
    int n = snprintf(bytes + used, sizeof bytes - used, "gen%d-%s-merge\t-1\t0\n", gen, slug);
    if (n < 0 || n >= (int)sizeof bytes - used) die("front inventory bound", slug);
    used += n;
    if (want_stub) {
        n = snprintf(bytes + used, sizeof bytes - used, "gen%d-%s-stub\t-1\t0\n", gen, slug);
        if (n < 0 || n >= (int)sizeof bytes - used) die("front inventory bound", slug);
        used += n;
    }
    if (cx_fmt(p, sizeof p, "%s/chain-front-gen%d-%s.tsv", outdir, gen, slug)) die("inventory path", slug);
    size_t oldn = 0; char *old = cx_read(p, &oldn);
    if (old && (oldn != (size_t)used || memcmp(old, bytes, oldn))) { free(old); die("REFUSE front inventory changed", p); }
    if (!old && install_if_changed(p, bytes, used, 0)) die("front inventory write", p);
    free(old);
    return slices;
}
static int known_front_phase(const char *root, const char *rev, const char *phase) {
    const char *slugs[] = {"osx-x86_64", "osx-arm64", "win-x86_64", "win-arm64"};
    char tag[80], p0[4400];
    for (int gen = 1; gen <= 3; gen++) for (int t = 0; t < 4; t++) {
        for (int i = 0; i < (cf_wf_max() + cf_front_slice() - 1) / cf_front_slice(); i++) {
            if (cx_fmt(tag, sizeof tag, "gen%d-%s-front%d", gen, slugs[t], i)) die("fmt", "front phase");
            if (strcmp(tag, phase)) continue;
            if (!i) return 1;
            if (cx_fmt(p0, sizeof p0, "%s/out/release-snap-%.10s/out/chain/gen%d/%s-front0", root, rev, gen, slugs[t])) die("path", "front phase");
            return i * cf_front_slice() < wf_total(p0);
        }
        if (cx_fmt(tag, sizeof tag, "gen%d-%s-merge", gen, slugs[t])) die("fmt", "merge phase");
        if (!strcmp(tag, phase)) return 1;
        if (t < 2) {
            if (cx_fmt(tag, sizeof tag, "gen%d-%s-stub", gen, slugs[t])) die("fmt", "stub phase");
            if (!strcmp(tag, phase)) return 1;
        }
    }
    return 0;
}
/* The stub step of one osx target. whole-front stub insists on making DEST and DEST.control
   itself; an attempt killed at its bound leaves both behind (0.0.58, gen1-osx-x86_64-stub: the
   retry was refused with "exclusive phase/control required" and the chain stopped). Like front
   and merge, an unfinished DEST is scrubbed before the step runs; a finished one (checkpoint
   row and a non-empty stub.c) is never touched. */
static void wf_stub(const char *root, const char *outdir, char *wft, char *prep, const char *target, char *phase, char *dest, const char *tag) {
    char sc[4400];
    char *v[12];
    int n = 0; long t0 = sy_now_ms();
    if (cx_fmt(sc, sizeof sc, "%s/stub.c", dest)) die("path", "stubc");
    if (ck_complete(outdir, tag, sc)) { sy_printf("RESUME\t%s\n", tag); if (until_phase && !strcmp(until_phase, tag)) exit(0); return; }
    wf_scrub_dest(outdir, dest);
    v[n++] = wft; v[n++] = (char *)"--";
    v[n++] = (char *)"stub"; v[n++] = prep; v[n++] = (char *)target; v[n++] = phase; v[n++] = dest; v[n++] = 0;
    if (bound_sh_secs(root, v, cc_lim("cmd.front", 0))) die(tag, dest);
    mark(outdir, tag, sy_now_ms() - t0);
}
static int wf_fronts(const char *root, const char *outdir, const char *helper, int gen, const char *target, const char *slug, int want_stub) {
    char wft[4400], prep[4400], phase[4400], dest[4400], tag[80];
    static char parts[128][4400]; /* physical WF_MAX capacity; logical slice count comes from chainfacts */
    char offset[32], amount[32];
    int i, slices = 1;
    if (cx_fmt(wft, sizeof wft, "%s/tools/whole-front.cx", root)) die("path", "wf");
    {
        char gd[4400];
        check_gen(gen);
        if (cx_fmt(gd, sizeof gd, "%s/gen%d", chain_work, gen)) die("path", "g1parent");
        sy_mkdir(gd, 0755);
    }
    prep_dir(prep, sizeof prep, gen, "wf-prep");
    for (i = 0; i < (cf_wf_max() + cf_front_slice() - 1) / cf_front_slice(); i++)
        if (cx_fmt(parts[i], sizeof parts[i], "%s/gen%d/%s-front%d", chain_work, gen, slug, i)) die("path", "front");
    if (cx_fmt(phase, sizeof phase, "%s/gen%d/%s-merged", chain_work, gen, slug)) die("path", "phase");
    if (cx_fmt(dest, sizeof dest, "%s/gen%d/%s-stub", chain_work, gen, slug)) die("path", "stub");
    if (sy_setenv("UNISACC_IDENTITY_HELPER", helper, 1)) die("env", "helper");
    for (i = 0; i < slices; i++) {
        char *v[12];
        int n = 0;
        if (cx_fmt(tag, sizeof tag, "gen%d-%s-front%d", gen, slug, i)) die("fmt", slug);
        if (i) wf_tail_count(parts[0], i * cf_front_slice(), amount, sizeof amount);
        else if (cx_fmt(amount, sizeof amount, "%d", cf_front_slice())) die("fmt", "front count");
        if (cx_fmt(offset, sizeof offset, "%d", i * cf_front_slice())) die("fmt", "front offset");
        if (ck_done(outdir, tag)) {
            sy_printf("RESUME\t%s\n", tag);
            if (!i) slices = wf_inventory(outdir, gen, slug, parts[0], want_stub);
            if (until_phase && !strcmp(until_phase, tag)) exit(0);
        } else {
            wf_scrub_dest(outdir, parts[i]);
            v[n++] = wft; v[n++] = (char *)"--";
            v[n++] = (char *)"front"; v[n++] = prep; v[n++] = (char *)target; v[n++] = parts[i];
            v[n++] = offset; v[n++] = amount; v[n++] = 0;
            if (bound_sh_secs(root, v, cc_lim("cmd.front", 0))) die(tag, parts[i]);
            if (!i) slices = wf_inventory(outdir, gen, slug, parts[0], want_stub);
            mark(outdir, tag, 0);
        }
    }
    if ((gen == 1 ? cx_fmt(tag, sizeof tag, "gen1-%s-merge", slug) : cx_fmt(tag, sizeof tag, "gen%d-%s-merge", gen, slug))) die("fmt", slug);
    if (!ck_done(outdir, tag)) {
        char *v[16];
        int n = 0;
        wf_scrub_dest(outdir, phase);
        v[n++] = wft; v[n++] = (char *)"--";
        v[n++] = (char *)"merge"; v[n++] = prep; v[n++] = (char *)target; v[n++] = phase;
        for (i = 0; i < slices; i++) v[n++] = parts[i];
        v[n++] = 0;
        if (bound_sh_secs(root, v, cc_lim("cmd.front", 0))) die(tag, phase);
        mark(outdir, tag, 0);
    } else { sy_printf("RESUME\t%s\n", tag); if (until_phase && !strcmp(until_phase, tag)) exit(0); }
    if (!want_stub) return 0;
    if ((gen == 1 ? cx_fmt(tag, sizeof tag, "gen1-%s-stub", slug) : cx_fmt(tag, sizeof tag, "gen%d-%s-stub", gen, slug))) die("fmt", slug);
    wf_stub(root, outdir, wft, prep, target, phase, dest, tag);
    return 0;
}
static int clean_phase_path(const char *outdir, const char *phase, const char *path, const char *receipt);
static int wf_span_prep(const char *root, const char *outdir, const char *helper, int gen, const char *snap, const char *pkg, const char *ctor, const char *objs) {
    char wft[4400], nout[4400], tmpl[4400], rec[4400], saved[4400], ptag[80];
    char *v[16];
    int n = 0;
    prep_dir(nout, sizeof nout, gen, "wf-span-prep");
    span_prep_tag(ptag, sizeof ptag, gen);
    if (cx_fmt(rec, sizeof rec, "%s/receipt.txt", nout)) die("path", "wsprec");
    if (ck_done(outdir, ptag) && fsize(rec) >= 0) { sy_printf("RESUME\t%s\n", ptag); return 0; }
    if (gen > 1) clean_phase_path(outdir, ptag, nout, rec);
    if (cx_fmt(wft, sizeof wft, "%s/tools/whole-front.cx", root)) die("path", "wf");
    if (cx_fmt(tmpl, sizeof tmpl, "%s/tools/templates/whole-win-span.cx.in", root)) die("path", "wtmpl");
    if (sy_setenv("UNISACC_IDENTITY_HELPER", helper, 1)) die("env", "helper");
    if (fsize(rec) < 0) {
        v[n++] = wft; v[n++] = (char *)"--";
        v[n++] = (char *)"prepare"; v[n++] = (char *)snap; v[n++] = (char *)pkg; v[n++] = (char *)ctor; v[n++] = (char *)objs; v[n++] = nout;
        v[n++] = (char *)"--template"; v[n++] = tmpl; v[n++] = 0;
        if (sy_realpath(".", saved, sizeof saved) < 0) die("cwd", ".");
        if (sy_chdir(snap)) die("chdir", snap);
        n = bound_sh_secs(root, v, cc_lim("cmd.front", 0));
        if (sy_chdir(saved)) die("chdir", saved);
        if (n) die("wf-span-prep", nout);
    } else sy_printf("WF_SPAN_PREP_EXISTING\t%s\n", rec);
    if (fsize(rec) < 0) die("wf-span-prep receipt", rec);
    mark(outdir, ptag, 0);
    return 0;
}
static int span_one_missing(const char *root, const char *outdir, const char *helper,
    const char *prep, const char *target, const char *input, const char *dest,
    const char *first, const char *last, const char *tag);

static int wf_win_span(const char *root, const char *outdir, const char *helper, int gen, const char *target, const char *slug) {
    char prep[4400], phase[4400], units[4400], e3[4400], img[4400], tag[80], slice[80];
    prep_dir(prep, sizeof prep, gen, "wf-span-prep");
    if (load_span_roots(prep)) die("roots", prep);
    if (cx_fmt(phase, sizeof phase, "%s/gen%d/%s-merged", chain_work, gen, slug)) die("path", "wphase");
    if (cx_fmt(units, sizeof units, "%s/gen%d/%s-units", chain_work, gen, slug)) die("path", "units");
    if (cx_fmt(e3, sizeof e3, "%s/gen%d/%s-e3", chain_work, gen, slug)) die("path", "e3");
    if (cx_fmt(img, sizeof img, "%s/gen%d/%s-image", chain_work, gen, slug)) die("path", "img");
    if ((gen == 1 ? cx_fmt(tag, sizeof tag, "gen1-%s-units", slug) : cx_fmt(tag, sizeof tag, "gen%d-%s-units", gen, slug))) die("fmt", slug);
    if (span_one_missing(root, outdir, helper, prep, target, phase, units, "units", "units", tag)) return 1;
    if ((gen == 1 ? cx_fmt(tag, sizeof tag, "gen1-%s-e3", slug) : cx_fmt(tag, sizeof tag, "gen%d-%s-e3", gen, slug))) die("fmt", slug);
    if (span_one_missing(root, outdir, helper, prep, target, units, e3, "e3", "e3", tag)) return 1;
    if ((gen == 1 ? cx_fmt(tag, sizeof tag, "gen1-%s-image", slug) : cx_fmt(tag, sizeof tag, "gen%d-%s-image", gen, slug))) die("fmt", slug);
    if (span_one_missing(root, outdir, helper, prep, target, e3, img, "prune", "elf", tag)) return 1;
    if ((gen == 1 ? cx_fmt(slice, sizeof slice, "gen1-%s", slug) : cx_fmt(slice, sizeof slice, "gen%d-%s", gen, slug))) die("fmt", slug);
    if (!ck_done(outdir, slice)) mark(outdir, slice, 0);
    else sy_printf("RESUME\t%s\n", slice);
    return 0;
}
static void wf_scrub_dest(const char *outdir, const char *dest) {
    char ctl[4400];
    if (!dest || !*dest) die("path", "dest");
    if (!under_dir(dest, outdir) && !(chain_work[0] && under_dir(dest, chain_work))) die("REFUSE dest", dest);
    if (cx_fmt(ctl, sizeof ctl, "%s.control", dest)) die("path", dest);
    if (fsize(dest) >= 0) { if (cx_rmtree(dest)) die("rm dest", dest); sy_printf("CLEANUP\t%s\n", dest); }
    if (fsize(ctl) >= 0) { if (cx_rmtree(ctl)) die("rm control", ctl); sy_printf("CLEANUP\t%s\n", ctl); }
}
/* The kernels step of generation G. chain-step runs kernel-route into FP/gG/kernel-route, copies
   the two kernels to FP/gG and writes FP/gG/phase-6.tsv last; an attempt killed at its bound
   leaves the directory (and possibly a copied kernel) without that record, and the retry is
   refused with "REFUSE unrecorded/existing phase" (0.0.58, kernels-g2 after rc 124). Without the
   record no later step has accepted them, so they are scrubbed before the step runs; with the
   record nothing is touched. */
static void kernels_scrub(const char *outdir, const char *fp, int g) {
    static const char *leaf[3] = {"kernel-route", "x86_64.kernel", "arm64.kernel"};
    char rec[4400], p[4400];
    int i;
    if (!fp || !*fp || (g != 2 && g != 3)) die("path", "kernels scrub");
    if (!under_dir(fp, outdir) && !(chain_work[0] && under_dir(fp, chain_work))) die("REFUSE fixedpoint", fp);
    if (cx_fmt(rec, sizeof rec, "%s/g%d/phase-6.tsv", fp, g)) die("path", fp);
    if (fsize(rec) >= 0) return;
    for (i = 0; i < 3; i++) {
        if (cx_fmt(p, sizeof p, "%s/g%d/%s", fp, g, leaf[i])) die("path", fp);
        if (fsize(p) < 0) continue;
        if (i ? sy_unlink(p) : cx_rmtree(p)) die("rm kernels residue", p);
        sy_printf("CLEANUP\t%s\n", p);
    }
}
static int span_one_missing(const char *root, const char *outdir, const char *helper,
    const char *prep, const char *target, const char *input, const char *dest,
    const char *first, const char *last, const char *tag) {
    char wft[4400], prod[4400];
    char *v[128+28];
    int n = 0, i;
    if (cx_fmt(prod, sizeof prod, "%s/body.bin", dest)) die("path", dest);
    if (ck_complete(outdir, tag, prod)) { sy_printf("RESUME\t%s\n", tag); if (until_phase && !strcmp(until_phase, tag)) exit(0); return 0; }
    wf_scrub_dest(outdir, dest);
    if (cx_fmt(wft, sizeof wft, "%s/tools/whole-front.cx", root)) die("path", "wf");
    if (sy_setenv("UNISACC_IDENTITY_HELPER", helper, 1)) die("env", "helper");
    v[n++] = wft; v[n++] = (char *)"--";
    v[n++] = (char *)"span"; v[n++] = (char *)prep; v[n++] = (char *)target;
    v[n++] = (char *)input; v[n++] = (char *)dest;
    v[n++] = (char *)first; v[n++] = (char *)last;
    for (i = 0; i < cf_root_count(); i++) v[n++] = span_roots[i];
    v[n] = 0;
    if (bound_sh_secs(root, v, cc_lim("cmd.front", 0))) die(tag, dest);
    mark(outdir, tag, 0);
    return 0;
}
static int span_one_fwd(const char *root, const char *outdir, const char *helper,
    const char *prep, const char *target, const char *input, const char *dest,
    const char *first, const char *last, const char *stub, const char *tag);

static int wf_mac_b(const char *root, const char *outdir, const char *helper, int gen, const char *target, const char *slug) {
    char prep[4400], phase[4400], stubdir[4400], stubp[4400], be3[4400], img[4400], tag[80], slice[80];
    char stub[4400];
    size_t sn = 0;
    char *sb;
    prep_dir(prep, sizeof prep, gen, "wf-span-prep");
    if (load_span_roots(prep)) die("roots", prep);
    if (cx_fmt(phase, sizeof phase, "%s/gen%d/%s-merged", chain_work, gen, slug)) die("path", "mph");
    if (cx_fmt(stubdir, sizeof stubdir, "%s/gen%d/%s-stub", chain_work, gen, slug)) die("path", "mst");
    if (cx_fmt(stubp, sizeof stubp, "%s/stub-path.txt", stubdir)) die("path", "msp");
    sb = cx_read(stubp, &sn);
    if (!sb || !sn || sn >= sizeof stub) { free(sb); die("stub-path", stubp); }
    if (sb[sn - 1] == '\n') sb[--sn] = 0;
    if (tx_copy(stub, sizeof stub, sb, (long)sn)) { free(sb); die("stub copy", stubp); }
    free(sb);
    /* A sibling Mac lane may have replaced the shared forward file since this
     * target's stub checkpoint. Restore its recorded bytes under mac-stub lock. */
    if (lane_phase) {
        char original_prep[4400], expected[4400], copy[4400]; size_t n = 0;
        prep_dir(original_prep, sizeof original_prep, gen, "wf-prep");
        if (cx_fmt(expected, sizeof expected, "%s/tmp/unisacc-forward-entry.c", original_prep) || strcmp(stub, expected) || cx_fmt(copy, sizeof copy, "%s/stub.c", stubdir)) die("REFUSE forward stub path", stub);
        char *bytes = cx_read(copy, &n);
        if (!bytes || !n || install_if_changed(stub, bytes, n, 0)) { free(bytes); die("restore forward stub", stub); }
        free(bytes);
    }
    if (cx_fmt(be3, sizeof be3, "%s/gen%d/%s-b-units-e3", chain_work, gen, slug)) die("path", "be3");
    if (cx_fmt(img, sizeof img, "%s/gen%d/%s-b2", chain_work, gen, slug)) die("path", "b2");
    if ((gen == 1 ? cx_fmt(tag, sizeof tag, "gen1-%s-b-units-e3", slug) : cx_fmt(tag, sizeof tag, "gen%d-%s-b-units-e3", gen, slug))) die("fmt", slug);
    if (span_one_fwd(root, outdir, helper, prep, target, phase, be3, "units", "e3", stub, tag)) return 1;
    if ((gen == 1 ? cx_fmt(tag, sizeof tag, "gen1-%s-b2", slug) : cx_fmt(tag, sizeof tag, "gen%d-%s-b2", gen, slug))) die("fmt", slug);
    if (span_one_fwd(root, outdir, helper, prep, target, be3, img, "prune", "elf", stub, tag)) return 1;
    if ((gen == 1 ? cx_fmt(slice, sizeof slice, "gen1-%s", slug) : cx_fmt(slice, sizeof slice, "gen%d-%s", gen, slug))) die("fmt", slug);
    if (!ck_done(outdir, slice)) mark(outdir, slice, 0);
    return 0;
}
static int span_one_fwd(const char *root, const char *outdir, const char *helper,
    const char *prep, const char *target, const char *input, const char *dest,
    const char *first, const char *last, const char *stub, const char *tag) {
    char wft[4400], prod[4400];
    char *v[128+28];
    int n = 0, i;
    if (cx_fmt(prod, sizeof prod, "%s/body.bin", dest)) die("path", dest);
    if (ck_complete(outdir, tag, prod)) { sy_printf("RESUME\t%s\n", tag); if (until_phase && !strcmp(until_phase, tag)) exit(0); return 0; }
    wf_scrub_dest(outdir, dest);
    if (cx_fmt(wft, sizeof wft, "%s/tools/whole-front.cx", root)) die("path", "wf");
    if (sy_setenv("UNISACC_IDENTITY_HELPER", helper, 1)) die("env", "helper");
    v[n++] = wft; v[n++] = (char *)"--";
    v[n++] = (char *)"span"; v[n++] = (char *)prep; v[n++] = (char *)target;
    v[n++] = (char *)input; v[n++] = (char *)dest;
    v[n++] = (char *)first; v[n++] = (char *)last;
    for (i = 0; i < cf_root_count(); i++) v[n++] = span_roots[i];
    v[n++] = (char *)"--forward-stub"; v[n++] = (char *)stub;
    v[n] = 0;
    if (bound_sh_secs(root, v, cc_lim("cmd.front", 0))) die(tag, dest);
    mark(outdir, tag, 0);
    return 0;
}


static void check_whole_front_template(const char *tmpl) {
    const char *want = "ca2c54a6938c498093e2962bbc1c19c24c6e730266b60d471265cbc6d43a3982";
    size_t tn = 0; char *tb = cx_read(tmpl, &tn), th[65];
    if (!tb || sy_sha256_hex(tb, (long)tn, th)) { free(tb); die("template sha", tmpl); }
    free(tb);
    if (!tx_eqz(th, want)) die("REFUSE template SHA != ba945f3238 tools/templates/whole-front.cx.in", th);
    sy_printf("TEMPLATE\tpath=%s\tsha=%s\tsource_commit=ba945f3238\tbytes=%lu\n", tmpl, th, (unsigned long)tn);
}
/* P2: g2/g3 的 Mac/Win 分相。构造器与对象目录取 fixedpoint/g<N>/lnx-x86_64(candidate 与 .o,
   与 chain-step 对 i>=2 的构造器选择一致);prepare 目录按代各建(wf-prep-g<N>、wf-span-prep-g<N>),不复用 gen1。 */
static const char *g_mt_target[4] = {"osx/x86_64", "osx/arm64", "win/x86_64", "win/arm64"};
static const char *g_mt_slug[4] = {"osx-x86_64", "osx-arm64", "win-x86_64", "win-arm64"};
/* pack 取 osx/win 切片:与 g 相位同址(osx 为 gen1/<slug>-b2/image,win 为 gen1/<slug>-image/image,均在 chain_work)。
   不用 outdir/gen1/<slug>/image:P1/P2 后该处不再产出。返回非 0 表示 slug 不是 osx/win 之一。 */
static int pack_slice(char *buf, long cap, const char *slug) {
    int ti;
    for (ti = 0; ti < 4; ti++) if (tx_eqz(slug, g_mt_slug[ti])) break;
    if (ti == 4) return 1;
    return cx_fmt(buf, cap, ti < 2 ? "%s/gen1/%s-b2/image" : "%s/gen1/%s-image/image", chain_work, slug);
}
static int wf_prepare_gen(const char *root, const char *outdir, const char *helper, int gen, const char *snap, const char *pkg, const char *ctor, const char *objs) {
    char wft[4400], nout[4400], tmpl[4400], rec[4400], saved[4400], ptag[80];
    char *v[16];
    int n = 0;
    prep_dir(nout, sizeof nout, gen, "wf-prep");
    if (gen == 1 ? cx_fmt(ptag, sizeof ptag, "wf-prepare") : cx_fmt(ptag, sizeof ptag, "wf-prep-g%d", gen)) die("fmt", "wf-prep-g");
    if (cx_fmt(rec, sizeof rec, "%s/receipt.txt", nout)) die("path", "wfgrec");
    if (ck_done(outdir, ptag) && fsize(rec) >= 0) { sy_printf("RESUME\t%s\n", ptag); return 0; }
    clean_phase_path(outdir, ptag, nout, rec);
    if (cx_fmt(wft, sizeof wft, "%s/tools/whole-front.cx", root)) die("path", "wf");
    if (cx_fmt(tmpl, sizeof tmpl, "%s/tools/templates/whole-front.cx.in", root)) die("path", "wtmpl");
    check_whole_front_template(tmpl);
    if (sy_setenv("UNISACC_IDENTITY_HELPER", helper, 1)) die("env", "helper");
    if (fsize(rec) < 0) {
        v[n++] = wft; v[n++] = (char *)"--";
        v[n++] = (char *)"prepare"; v[n++] = (char *)snap; v[n++] = (char *)pkg; v[n++] = (char *)ctor; v[n++] = (char *)objs; v[n++] = nout;
        v[n++] = (char *)"--template"; v[n++] = tmpl; v[n++] = 0;
        if (sy_realpath(".", saved, sizeof saved) < 0) die("cwd", ".");
        if (sy_chdir(snap)) die("chdir", snap);
        n = bound_sh_secs(root, v, cc_lim("cmd.front", 0));
        if (sy_chdir(saved)) die("chdir", saved);
        if (n) die(ptag, nout);
    }
    if (fsize(rec) < 0) die("wf-prep receipt", rec);
    mark(outdir, ptag, 0);
    return 0;
}
static void gen_slice_phase(const char *root, const char *outdir, const char *helper, const char *rev, const char *snap,
    const char *pkg, const char *gen1, const char *fp, int gen, int ti, int resume) {
    char ptag[80], objs[4400], ctor[4400], img[4400], phs[8];
    char *a[16];
    long t0 = sy_now_ms();
    check_gen(gen);
    if (gen < 2 || ti < 0 || ti > 3) die("REFUSE gen slice phase gen 2..3 target 0..3", 0);
    if (cx_fmt(ptag, sizeof ptag, "g%d-%s", gen, g_mt_slug[ti])) die("fmt", "gptag");
    if (resume && ck_done(outdir, ptag)) { sy_printf("RESUME\t%s\n", ptag); return; }
    if (cx_fmt(objs, sizeof objs, "%s/g%d/lnx-x86_64", fp, gen) || cx_fmt(ctor, sizeof ctor, "%s/candidate", objs)) die("path", ptag);
    if (fsize(ctor) < 0) die("REFUSE missing g-constructor", ctor);
    if (!lane_phase) {
        if (wf_prepare_gen(root, outdir, helper, gen, snap, pkg, ctor, objs)) die("wf-prep-gen", ptag);
        if (wf_span_prep(root, outdir, helper, gen, snap, pkg, ctor, objs)) die("wf-span-prep-gen", ptag);
    }
    if (wf_fronts(root, outdir, helper, gen, g_mt_target[ti], g_mt_slug[ti], ti < 2)) die(ptag, outdir);
    if (ti < 2) {
        if (wf_mac_b(root, outdir, helper, gen, g_mt_target[ti], g_mt_slug[ti])) die(ptag, outdir);
        if (cx_fmt(img, sizeof img, "%s/gen%d/%s-b2/image", chain_work, gen, g_mt_slug[ti])) die("path", ptag);
    } else {
        int wrc = wf_win_span(root, outdir, helper, gen, g_mt_target[ti], g_mt_slug[ti]);
        if (wrc) die(ptag, outdir);
        if (cx_fmt(img, sizeof img, "%s/gen%d/%s-image/image", chain_work, gen, g_mt_slug[ti])) die("path", ptag);
    }
    if (fsize(img) < 1) die("REFUSE missing slice image", img);
    if (cx_fmt(phs, sizeof phs, "g%d", gen)) die("fmt", "phs");
    clean_fp_phase(outdir, fp, ptag, gen, g_mt_slug[ti], ti + 2);
    a[0] = (char *)"fixedpoint"; a[1] = (char *)rev; a[2] = (char *)snap; a[3] = (char *)pkg; a[4] = (char *)gen1; a[5] = (char *)fp;
    a[6] = (char *)"--phase"; a[7] = phs; a[8] = (char *)"--target"; a[9] = (char *)g_mt_target[ti];
    a[10] = (char *)"--from-image"; a[11] = img; a[12] = (char *)"--identity-helper"; a[13] = (char *)helper; a[14] = 0;
    if (step(root, a)) die(ptag, fp);
    mark(outdir, ptag, sy_now_ms() - t0);
}

/* The build table is orchestration metadata, never a model fact input. */
static char g_phasebuf[512][80];
static const char *g_phases[512];
static int g_nphases;
static const char *phases_file;
static int chain_phase_index(const char *id) {
    for (int i = 0; i < g_nphases; i++) if (!strcmp(id, g_phases[i])) return i;
    return -1;
}
static void load_chain_phases(const char *root) {
    char path[4400]; size_t n = 0; char *s, *p;
    char *deps[512], *lanes[512], *domains[512];
    if (phases_file) { if (cx_fmt(path, sizeof path, "%s", phases_file)) die("path", "phases"); }
    else if (cx_fmt(path, sizeof path, "%s/build/chain-phases.tsv", root)) die("path", "phases");
    s = cx_read(path, &n);
    if (!s || !n || s[n - 1] != '\n' || memchr(s, 0, n) || memchr(s, '\r', n)) die("REFUSE chain-phases text", path);
    p = s; g_nphases = 0;
    while (*p) {
        char *e = strchr(p, '\n'), *v[7], *q; int fields = 1, j; char order[20];
        *e = 0;
        if (*p == '#') { p = e + 1; continue; }
        v[0] = p;
        for (q = p; *q; q++) if (*q == '\t') { *q = 0; if (fields == 7) die("REFUSE chain-phases fields", path); v[fields++] = q + 1; }
        if (fields != 7 || g_nphases == 512) die("REFUSE chain-phases fields/count", path);
        if (cx_fmt(order, sizeof order, "%d", g_nphases) || strcmp(v[0], order)) die("REFUSE chain-phases order", path);
        if (!*v[1] || strlen(v[1]) >= 80) die("REFUSE chain-phases id", path);
        for (q = v[1]; *q; q++) if (!((*q >= 'a' && *q <= 'z') || (*q >= '0' && *q <= '9') || *q == '-' || *q == '_')) die("REFUSE chain-phases id", path);
        for (j = 0; j < g_nphases; j++) if (!strcmp(g_phases[j], v[1])) die("REFUSE chain-phases duplicate", path);
        if (!*v[2] || strlen(v[2]) >= 80) die("REFUSE chain-phases exclusive_dir", path);
        { char want[16]; if (cx_fmt(want, sizeof want, "%d", cc_lim("phase.bound", v[1])) || strcmp(v[3], want)) die("REFUSE chain-phases timeout", path); }
        if (strcmp(v[6], "1") && strcmp(v[6], "2") && strcmp(v[6], "3") && strcmp(v[6], "4")) die("REFUSE chain-phases parallelism", path);
        if (!*v[4] || strlen(v[4]) >= 4400 || !*v[5] || strlen(v[5]) >= 80) die("REFUSE chain-phases deps/lane", path);
        deps[g_nphases] = v[4]; lanes[g_nphases] = v[5]; domains[g_nphases] = v[2];
        if (cx_fmt(g_phasebuf[g_nphases], 80, "%s", v[1])) die("phase id", path);
        g_phases[g_nphases] = g_phasebuf[g_nphases]; g_nphases++; p = e + 1;
    }
    for (int i = 0; i < g_nphases; i++) {
        if (strcmp(domains[i], "-") && strcmp(domains[i], "outer") && chain_phase_index(domains[i]) < 0) die("REFUSE chain-phases exclusive_dir", domains[i]);
        if (strcmp(lanes[i], "-") && chain_phase_index(lanes[i]) < 0) die("REFUSE chain-phases lane", lanes[i]);
        if (!strcmp(deps[i], "-")) continue;
        char *at = deps[i]; int seen[512] = {0};
        while (at) {
            char *end = strchr(at, ','); if (end) *end = 0;
            int d = chain_phase_index(at);
            if (d < 0 || d == i || seen[d]) die("REFUSE chain-phases dependency", at);
            seen[d] = 1;
            if (end) *end++ = ',';
            at = end;
        }
    }
    int visited[512] = {0}, left = g_nphases;
    while (left) {
        int progress = 0;
        for (int i = 0; i < g_nphases; i++) if (!visited[i]) {
            int ready = 1; char *at = deps[i];
            if (strcmp(at, "-")) while (at) {
                char *end = strchr(at, ','); if (end) *end = 0;
                if (!visited[chain_phase_index(at)]) ready = 0;
                if (end) *end++ = ',';
                at = end;
            }
            if (ready) { visited[i] = 1; left--; progress = 1; }
        }
        if (!progress) die("REFUSE chain-phases dependency cycle", path);
    }
    free(s); if (!g_nphases) die("REFUSE empty chain-phases", path);
}
static const char *until_phase;
static void plan(void) {
    int i;
    sy_printf("CANDIDATE_CHAIN\tplan\tphases=%d\n", g_nphases);
    for (i = 0; i < g_nphases; i++)
        sy_printf("PHASE\t%d\t%s\tchild_bound=%d\n", i, g_phases[i], cc_lim("phase.bound", g_phases[i]));
    sy_printf("NOTE\tgen1 six slices PREPARED before g2; g2/g3 linux objects then link\n");
    sy_printf("NOTE\tosx=whole-front A1/A2/B; win=st_span three phases; Mac B serial\n");
    sy_printf("DYNAMIC_PHASE\tg2-lnx-x86_64-closure-mN.o\tmanifest=fixedpoint/g2/lnx-x86_64.closures.tsv\tchild_bound=%d\n", cc_pb());
    sy_printf("DYNAMIC_PHASE\tg2-lnx-arm64-closure-mN.o\tmanifest=fixedpoint/g2/lnx-arm64.closures.tsv\tchild_bound=%d\n", cc_pb());
    sy_printf("DYNAMIC_PHASE\tg3-lnx-TARGET-closure-mN.o\tmanifest=fixedpoint/g3/TARGET.closures.tsv\tchild_bound=%d\n", cc_pb());
    sy_printf("DYNAMIC_PHASE\tgenN-TARGET-frontK\tmanifest=out/chain-front-genN-slug.tsv\tenumeration=after-front0-only\tstatic-table=not-complete-subphase-inventory\tchild_bound=%d\n", cc_lim("cmd.front", 0));
    sy_printf("FP_BATCH\tflag=--objects\troots=%d\tclosure_batch_max=256\tlink=--link-only\tchild_bound=%d\n", cf_root_count(), cc_pb());
    sy_printf("GEN1_ENTRY\tphase=objects\tflag=--objects-only\tcheckpoint=gen1-lnx-TARGET-objects\tchild_bound=%d\n", cc_pb());
    sy_printf("GEN1_ENTRY\tphase=link\tflag=--link-only\tcheckpoint=gen1-lnx-TARGET\tverify=all-object-cache-identities\tchild_bound=%d\n", cc_pb());
}

static int hex40(const char *s) {
    int i;
    if (!s) return 0;
    for (i = 0; i < 40; i++) {
        char c = s[i];
        int ok = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
        if (!ok) return 0;
    }
    return s[40] == 0;
}

static int ck_done(const char *dir, const char *phase) {
    char p[4400], needle[256];
    size_t n = 0;
    char *b;
    int hit;
    if (cx_fmt(p, sizeof p, "%s/checkpoint.tsv", dir)) die("path", dir);
    if (fsize(p) < 0) return 0;
    b = cx_read(p, &n);
    if (!b) return 0;
    if (cx_fmt(needle, sizeof needle, "DONE\t%s\t", phase)) { free(b); die("fmt", phase); }
    hit = tx_find(b, (long)n, needle, tx_len(needle, 200)) >= 0;
    free(b);
    return hit;
}
static int ck_complete(const char *dir, const char *phase, const char *product) {
    if (!ck_done(dir, phase)) return 0;
    if (product && *product && fsize(product) <= 0) return 0;
    return 1;
}
/* W2 heartbeat: append epoch<TAB>phase<TAB>pid<TAB>pgid<TAB>start|end to DIR/heartbeat.tsv.
   tools/chain-watch.cx reads the last row before it calls a chain STALLED and checks pid/pgid
   (HUNG when alive, DEAD when not).  mark() writes the end row of each phase and main writes
   "chain start" once --out exists; per-phase start rows are left to the H4 executor. */
static void hb(const char *dir, const char *phase, const char *ev) {
    char p[4400], line[800];
    int fd;
    if (lane_phase ? cx_fmt(p, sizeof p, "%s/heartbeat-%s.tsv", dir, lane_phase) : cx_fmt(p, sizeof p, "%s/heartbeat.tsv", dir)) die("path", dir);
    if (cx_fmt(line, sizeof line, "%ld\t%s\t%d\t%ld\t%s\n", sy_wall_s(), phase, sy_pid(), sy_getpgid(0), ev)) die("fmt", phase);
    fd = sy_open(p, O_WRONLY | O_CREAT | O_APPEND, 0644);
    if (fd < 0 || sy_write_all(fd, line, tx_len(line, 800)) || sy_close(fd)) die("heartbeat", p);
}
static void mark(const char *dir, const char *phase, long wall) {
    char p[4400], line[800];
    int fd;
    if (cx_fmt(p, sizeof p, "%s/checkpoint.tsv", dir)) die("path", dir);
    if (cx_fmt(line, sizeof line, "DONE\t%s\twall_ms=%ld\tsha=-\n", phase, wall)) die("fmt", phase);
    fd = sy_open(p, O_WRONLY | O_CREAT | O_APPEND, 0644);
    if (fd < 0) die("checkpoint", p);
    candidate_lock_fd(fd, p);
    if (sy_write_all(fd, line, tx_len(line, 800)) || sy_flock(fd, 8) || sy_close(fd)) die("checkpoint", p);
    hb(dir, phase, "end");
    sy_printf("RECEIPT\t%s\twall_ms=%ld\n", phase, wall);
    if (until_phase && tx_eqz(phase, until_phase)) {
        sy_printf("CANDIDATE_CHAIN\tstatus=UNTIL\tphase=%s\n", phase);
        exit(0);
    }
}
/* Object checkpoint is only scheduling evidence: link-only rechecks every
   object/cache and the raw input identity before it can create a candidate. */
static void gen1_entry(const char *outdir, const char *snap, const char *ctor,
                       const char *ebt, const char *pkg, const char *gout,
                       const char *target, const char *tag, int resume) {
    char objtag[100];
    if (cx_fmt(objtag, sizeof objtag, "%s-objects", tag)) die("path", tag);
    if (!(resume && ck_done(outdir, objtag))) {
        long t = sy_now_ms();
        hb(outdir, objtag, "start");
        if (bound_ctor_eb(snap, ctor, ebt, pkg, gout, target, "--objects-only")) die("gen1 objects", gout);
        mark(outdir, objtag, sy_now_ms() - t);
    } else {
        sy_printf("RESUME\t%s\n", objtag);
        if (until_phase && tx_eqz(objtag, until_phase)) exit(0);
    }
    hb(outdir, tag, "start");
    long t = sy_now_ms();
    if (bound_ctor_eb(snap, ctor, ebt, pkg, gout, target, "--link-only")) die("gen1 link", gout);
    mark(outdir, tag, sy_now_ms() - t);
}
/* 相位原子清理: 相位未 DONE 时,删除上次失败留下的独占输出(下游工具以目标不存在为前提)。
   只删调用方登记的路径;已 DONE 的相位不动;有完成收据(receipt 非空且存在)的不动;
   范围限定在 --out 目录与快照树 out/chain(chain_work)之内,越界或含 .. 即拒绝。 */
static int under_dir(const char *path, const char *dir) {
    long dn = tx_len(dir, 4400);
    if (dn < 1 || !tx_prefix(path, tx_len(path, 4400), dir, dn)) return 0;
    return path[dn] == '/' && path[dn + 1] != 0;
}
static int has_dotdot(const char *p) {
    long i, n = tx_len(p, 4400);
    for (i = 0; i + 1 < n; i++)
        if (p[i] == '.' && p[i + 1] == '.' && (i == 0 || p[i - 1] == '/') && (i + 2 == n || p[i + 2] == '/')) return 1;
    return 0;
}
static int clean_phase_path(const char *outdir, const char *phase, const char *path, const char *receipt) {
    if (!path || !*path) die("REFUSE cleanup empty path", phase);
    if (has_dotdot(path) || !(under_dir(path, outdir) || (chain_work[0] && under_dir(path, chain_work))))
        die("REFUSE cleanup path outside out/chain", path);
    if (ck_done(outdir, phase)) return 0;
    if (fsize(path) < 0) return 0;
    if (receipt && *receipt && fsize(receipt) >= 0) return 0;
    sy_printf("CLEANUP\t%s\t%s\n", phase, path);
    if (cx_rmtree(path)) die("cleanup failed", path);
    return 1;
}
/* fixedpoint g2/g3: 独占输出为 FP/gN/<target>,完成收据为 FP/gN/phase-<i>.tsv。 */
static void clean_fp_phase(const char *outdir, const char *fp, const char *phase, int g, const char *slug, int idx) {
    char d[4400], rc[4400];
    if (cx_fmt(d, sizeof d, "%s/g%d/%s", fp, g, slug) || cx_fmt(rc, sizeof rc, "%s/g%d/phase-%d.tsv", fp, g, idx)) die("path", phase);
    clean_phase_path(outdir, phase, d, rc);
}
/* Existing --objects API accepts at most 256 keys; checkpoints remain per key.
   Always re-enter chain-step on resume: it verifies provenance and completed
   object bytes before adopting them. --until truncates the batch, not coverage. */
static int fp_pending_limit(const char *root) {
    char path[4400],line[256];long values[4];int row=0;
    const char *names[]={"budget_ms","cold_key_ms","warm_key_ms","pending_keys"};
    if(cx_fmt(path,sizeof path,"%s/build/g2-budget.tsv",root))die("budget path",root);
    FILE *f=fopen(path,"rb");if(!f)die("budget open",path);
    while(fgets(line,sizeof line,f)){
        if(line[0]=='#')continue;if(row>=4)die("budget rows",path);
        char *p=strchr(line,'\t');if(!p)die("budget field",path);*p++=0;
        if(strcmp(line,names[row]))die("budget field",path);
        long n=0;if(*p<'0'||*p>'9')die("budget number",path);
        while(*p>='0'&&*p<='9'){if(n>1000000)die("budget bound",path);n=n*10+*p++-'0';}
        if(strcmp(p,"\n")||n<1)die("budget number",path);values[row++]=n;
    }
    if(ferror(f)||fclose(f)||row!=4||values[0]!=55000||values[1]>=values[0]||values[3]!=1+(values[0]-values[1]-1)/values[2])die("REFUSE derived budget",path);
    return values[3];
}
static void fp_call(const char *root,const char *rev,const char *snap,const char *pkg,
                    const char *gen1,const char *fp,const char *helper,
                    const char *target,const char *phase,const char *keys,int resume){
    char *a[18];int n=0;
    a[n++]="fixedpoint";a[n++]=(char *)rev;a[n++]=(char *)snap;a[n++]=(char *)pkg;a[n++]=(char *)gen1;a[n++]=(char *)fp;
    a[n++]="--phase";a[n++]=(char *)phase;a[n++]="--target";a[n++]=(char *)target;a[n++]="--identity-helper";a[n++]=(char *)helper;
    if(keys){a[n++]="--objects";a[n++]=(char *)keys;}else a[n++]="--link-only";
    if(resume)a[n++]="--resume";a[n]=0;if(step(root,a))die(keys?"fixedpoint objects":"fixedpoint link",phase);
}
/* One batch of uncommitted keys. Before it starts: if this attempt already committed a batch and
   the next one is not expected to fit before the attempt ends, yield (phase_yield). The estimate
   is twice the last batch of this attempt, at least 15 and at most 55 seconds (the measured
   budget of a batch, build/g2-budget.tsv). */
static int fp_committed; static long fp_last_ms;
static void fp_commit(const char *root,const char *rev,const char *snap,const char *pkg,
                      const char *gen1,const char *fp,const char *helper,
                      const char *target,const char *phase,const char *batch){
    if(attempt_end&&fp_committed){
        long need=fp_last_ms*2;if(need<15000)need=15000;if(need>55000)need=55000;
        if(sy_now_ms()+need>attempt_end)phase_yield("fixedpoint-batch",fp_last_ms,need);
    }
    long t0=sy_now_ms();
    fp_call(root,rev,snap,pkg,gen1,fp,helper,target,phase,batch,1);
    fp_last_ms=sy_now_ms()-t0;fp_committed++;
}
static void fp_batch(const char *root,const char *rev,const char *snap,const char *pkg,
                     const char *gen1,const char *fp,const char *helper,
                     const char *target,const char *phase,const char *keys,int resume){
    if(!keys){fp_call(root,rev,snap,pkg,gen1,fp,helper,target,phase,0,resume);return;}
    int limit=fp_pending_limit(root),pending=0,used=0;char batch[12288],path[4400],slug[80],first[160];size_t sn=0;
    const char *end=strchr(keys,',');int len=end?(int)(end-keys):(int)strlen(keys);
    if(cx_fmt(first,sizeof first,"%.*s",len,keys))die("first key",keys);
    /* Recover any in-flight key and validate the complete phase seal once,
     * before trusting its committed-key markers for budget accounting. The
     * first cold key is isolated, so its preparation can never crowd a batch. */
    fp_call(root,rev,snap,pkg,gen1,fp,helper,target,phase,first,resume);
    if(cx_fmt(slug,sizeof slug,"%s",target))die("batch target",target);for(int j=0;slug[j];j++)if(slug[j]=='/')slug[j]='-';
    if(cx_fmt(path,sizeof path,"%s/%s/%s/.chain-steps",fp,phase,slug))die("batch steps",fp);
    char *steps=cx_read(path,&sn);if(!steps)die("batch committed steps",path);
    const char *p=end?end+1:keys+len;
    while(*p){
        const char *e=strchr(p,',');len=e?(int)(e-p):(int)strlen(p);char needle[160];
        if(len<1||cx_fmt(needle,sizeof needle,"\n%.*s\t",len,p))die("batch key",p);
        if(!strstr(steps,needle)){
            if(pending==limit||pending==256){fp_commit(root,rev,snap,pkg,gen1,fp,helper,target,phase,batch);used=0;pending=0;}
            int z=snprintf(batch+used,sizeof batch-used,"%s%.*s",pending?",":"",len,p);
            if(z<0||z>=sizeof batch-used)die("batch buffer",p);used+=z;pending++;
        }
        p=e?e+1:p+len;
    }
    free(steps);if(pending)fp_commit(root,rev,snap,pkg,gen1,fp,helper,target,phase,batch);
}
static void g2_closures(const char *root, const char *outdir, const char *rev, const char *snap, const char *pkg,
                        const char *gen1, const char *ctor, const char *dest, const char *fp, const char *helper,
                        const char *target, const char *slug, int gen, int resume) {
    char tool[4400], com[4400], manifest[4400], prepare[80], group[80];
    if (cx_fmt(tool, sizeof tool, "%s/tools/entry-build.cx", snap) || cx_fmt(com, sizeof com, "%s/unisacc.com", root) || cx_fmt(manifest, sizeof manifest, "%s/g%d/%s.closures.tsv", fp, gen, slug) || cx_fmt(prepare, sizeof prepare, "g%d-%s-closure-prepare", gen, slug) || cx_fmt(group, sizeof group, "g%d-%s-closure", gen, slug)) die("path", slug);
    if (sy_setenv("UNISA_CONTAINER", pkg, 1)) die("env", "g2 package");
    char *list[] = {"sh", com, tool, "--", (char *)snap, (char *)pkg, (char *)dest, (char *)ctor, "--target", (char *)target, "--closure-list", 0};
    pr_result result; long began = sy_now_ms();
    /* T11: on a re-entry of a prepared closure the plan is recomputed only to be compared with
       the manifest. With the memo on, the earlier comparison is reused while the launcher, the
       package and the constructor hash the same (memoized per file) and every entry of the frozen
       snapshot (but its out/) has unchanged metadata, and only when the manifest bytes are still
       the plan that was compared. Anything else recomputes the plan as before. */
    char ckey[14000], h1[65], h2[65], h3[65], cshape[65], cwant[65], chave[65]; int cmemo = 0, reused = 0;
    memset(&result, 0, sizeof result);
    if (resume && ck_done(outdir, prepare) && sm_enabled() && !sm_sha(com, h1) && !sm_sha(pkg, h2) && !sm_sha(ctor, h3) &&
        !cx_fmt(ckey, sizeof ckey, "closure-list\n%s\n%s\n%s\n%s\n%s\n%s\n", h1, h2, h3, target, snap, dest) && !derived_shape(snap, 0, 0, cshape)) {
        cmemo = 1;
        if (!sm_value_get(ckey, cshape, cwant)) {
            size_t mn = 0; char *mt = cx_read(manifest, &mn);
            if (mt && mn && mt[mn - 1] == '\n' && !memchr(mt, 0, mn) && !sy_sha256_hex(mt, (long)mn, chave) && !strcmp(chave, cwant)) { result.out = mt; result.outn = mn; reused = 1; }
            else free(mt);
        }
    }
    if (reused) sy_printf("CLOSURE_PLAN\t%s\tmemo=unchanged-launcher-package-constructor-snapshot\n", prepare);
    else {
    if (pr_run(prepare, list, 0, 0, 55, &result) || result.rc || result.residue) { pr_echo(&result); pr_free(&result); die("closure list", slug); }
    if (result.outn && (!result.out || result.out[result.outn - 1] != '\n' || memchr(result.out, 0, result.outn))) { pr_free(&result); die("closure list text", slug); }
    }
    size_t oldn = 0; char *old = cx_read(manifest, &oldn);
    if (resume && ck_done(outdir, prepare)) {
        if (!old || oldn != result.outn || memcmp(old, result.out, oldn)) { free(old); pr_free(&result); die("REFUSE closure plan changed", manifest); }
        if (cmemo && !reused) { char again[65]; if (!derived_shape(snap, 0, 0, again) && !strcmp(again, cshape) && !sy_sha256_hex(result.out, (long)result.outn, chave)) sm_value_put(ckey, cshape, chave); }
    } else if (cx_write(manifest, result.out ? result.out : "", result.outn)) { free(old); pr_free(&result); die("closure manifest", manifest); }
    free(old);
    int count = 0, requested = 0;
    for (char *p = result.out; p && *p;) {
        char *e = strchr(p, '\n'), *tab = memchr(p, '\t', e - p), name[40], expected[40], tag[100];
        if (!tab || memchr(tab + 1, '\t', e - tab - 1) || tab == p || tab - p >= 40) { pr_free(&result); die("closure list fields", manifest); }
        if (mm_copy(name, sizeof name, p, (long)(tab - p))) die("closure name copy", manifest); name[tab - p] = 0;
        if (count >= 4096 || cx_fmt(expected, sizeof expected, "m%d.o", count) || strcmp(name, expected)) die("closure order", manifest);
        *e = 0;
        if (!under_dir(tab + 1, snap) || has_dotdot(tab + 1)) die("closure source outside snapshot", tab + 1);
        if (cx_fmt(tag, sizeof tag, "g%d-%s-closure-%s", gen, slug, name)) die("closure tag", name);
        if (until_phase && !strcmp(until_phase, tag)) requested = 1;
        *e = '\n'; count++; p = e + 1;
    }
    if (until_phase && !strncmp(until_phase, group, strlen(group)) && strcmp(until_phase, prepare) && strcmp(until_phase, group) && !requested) die("REFUSE closure phase absent from manifest", until_phase);
    if (!(resume && ck_done(outdir, prepare))) mark(outdir, prepare, sy_now_ms() - began);
    else if (until_phase && !strcmp(until_phase, prepare)) exit(0);
    for (char *p = result.out; p && *p;) {
        char keys[12288], tags[256][100]; int nk = 0, used = 0;
        long started = sy_now_ms();
        do {
            char *e = strchr(p, '\n'), *tab = strchr(p, '\t');
            int len = (int)(tab - p);
            if (cx_fmt(tags[nk], sizeof tags[nk], "g%d-%s-closure-%.*s", gen, slug, len, p)) die("closure tag", manifest);
            int n = snprintf(keys + used, sizeof keys - used, "%s%.*s", nk ? "," : "", len, p);
            if (n < 0 || n >= (int)sizeof keys - used) die("closure batch bound", manifest);
            used += n; nk++; p = e + 1;
            if (until_phase && !strcmp(until_phase, tags[nk - 1])) break;
        } while (*p && nk < 256);
        fp_batch(root, rev, snap, pkg, gen1, fp, helper, target, gen == 2 ? "g2" : "g3", keys, 1);
        for (int j = 0; j < nk; j++) {
            if (!(resume && ck_done(outdir, tags[j]))) mark(outdir, tags[j], sy_now_ms() - started);
            else if (until_phase && !strcmp(until_phase, tags[j])) exit(0);
        }
    }
    pr_free(&result);
    if (!(resume && ck_done(outdir, group))) mark(outdir, group, 0);
    else if (until_phase && !strcmp(until_phase, group)) exit(0);
}
static int known_closure_phase(const char *outdir, const char *phase) {
    const char *slugs[] = {"lnx-x86_64", "lnx-arm64"};
    if (!outdir) return 0;
    for (int gen = 2; gen <= 3; gen++) for (int i = 0; i < 2; i++) {
        char prefix[80], file[4400], needle[48]; struct stat st;
        if (cx_fmt(prefix, sizeof prefix, "g%d-%s-closure-", gen, slugs[i])) die("phase", phase);
        size_t z = strlen(prefix); if (strncmp(phase, prefix, z)) continue;
        const char *name = phase + z, *p = name + 1; int index = 0;
        if (*name != 'm' || strlen(name) >= 40 || *p < '0' || *p > '9' || (*p == '0' && p[1] != '.')) return 0;
        while (*p >= '0' && *p <= '9') { if (index > 4095) return 0; index = index * 10 + *p++ - '0'; }
        if (index > 4095 || strcmp(p, ".o")) return 0;
        if (cx_fmt(file, sizeof file, "%s/fixedpoint/g%d/%s.closures.tsv", outdir, gen, slugs[i]) || cx_fmt(needle, sizeof needle, "m%d.o\t", index)) die("path", phase);
        if (lstat(file, &st)) { if (errno == ENOENT) return 0; die("closure manifest stat", file); }
        size_t n = 0; char *text = cx_read(file, &n); if (!text || !n || text[n - 1] != '\n' || memchr(text, 0, n)) { free(text); die("closure manifest text", file); }
        int found = 0; char *at = text;
        while ((at = strstr(at, needle))) { if (at == text || at[-1] == '\n') { found = 1; break; } at++; }
        free(text); return found;
    }
    return 0;
}
static void run_g2_lnx(const char *root, const char *outdir, const char *rev, const char *snap,
    const char *pkg, const char *gen1, const char *fp, const char *helper,
    const char *target, const char *slug, int gen, int resume) {
    char dest[4400], tag[80], objtag[80], ctor[4400], keys[2048]; int used = 0, count = cf_root_count();
    const char *phase = gen == 2 ? "g2" : "g3";
    if (cx_fmt(dest, sizeof dest, "%s/g%d/%s", fp, gen, slug) ||
        cx_fmt(tag, sizeof tag, "g%d-%s", gen, slug) || cx_fmt(objtag, sizeof objtag, "%s-objects", tag) ||
        (gen == 2 ? cx_fmt(ctor, sizeof ctor, "%s", gen1) : cx_fmt(ctor, sizeof ctor, "%s/g2/lnx-x86_64/candidate", fp))) die("path", slug);
    sy_mkdir(fp, 0755);
    if (gen == 3 && !resume) clean_fp_phase(outdir, fp, tag, gen, slug, !strcmp(slug, "lnx-arm64"));
    long began = sy_now_ms();
    for (int i = 0; i < cf_root_count(); i++) {
        char one[80];
        if (cx_fmt(one, sizeof one, "g2-%s-obj-%d", slug, i)) die("phase", slug);
        int n = snprintf(keys + used, sizeof keys - used, "%s%s", i ? "," : "", cf_root_key(i));
        if (n < 0 || n >= (int)sizeof keys - used) die("root batch bound", slug);
        used += n;
        if (gen == 2 && until_phase && !strcmp(until_phase, one)) { count = i + 1; break; }
    }
    hb(outdir, objtag, "start");
    fp_batch(root, rev, snap, pkg, gen1, fp, helper, target, phase, keys, fsize(dest) >= 0);
    if (gen == 2) for (int i = 0; i < count; i++) {
        char one[80]; if (cx_fmt(one, sizeof one, "g2-%s-obj-%d", slug, i)) die("phase", slug);
        if (!(resume && ck_done(outdir, one))) mark(outdir, one, sy_now_ms() - began);
        else if (until_phase && !strcmp(until_phase, one)) exit(0);
    }
    g2_closures(root, outdir, rev, snap, pkg, gen1, ctor, dest, fp, helper, target, slug, gen, resume);
    if (!(resume && ck_done(outdir, objtag))) mark(outdir, objtag, sy_now_ms() - began);
    else { sy_printf("RESUME\t%s\n", objtag); if (until_phase && !strcmp(until_phase, objtag)) exit(0); }
    long started = sy_now_ms(); hb(outdir, tag, "start");
    fp_batch(root, rev, snap, pkg, gen1, fp, helper, target, phase, 0, 1);
    if (!(resume && ck_done(outdir, tag))) mark(outdir, tag, sy_now_ms() - started);
    else { sy_printf("RESUME\t%s\n", tag); if (until_phase && !strcmp(until_phase, tag)) exit(0); }
}
static int job_has_record(const char *ctx, const char *id) {
    char rec[4400];
    if (cx_fmt(rec, sizeof rec, "%s/jobs/%s/record.tsv", ctx, id)) die("path", id);
    return fsize(rec) >= 0;
}
static int clean_stale_job(const char *outdir, const char *ctx, const char *build, const char *id) {
    char jobd[4400], p[4400], fst[4400];
    static const char *kind[2] = {"start-job", "finish-job"};
    static const char *suf[5] = {"argv.tsv", "env", "status", "stderr", "stdout"};
    int k, s, n = 0;
    if (!id || !*id || has_dotdot(id) || strchr(id, '/')) die("REFUSE job id", id);
    if (cx_fmt(fst, sizeof fst, "%s/outer/finish-job-%s.status", build, id)) die("path", id);
    if (job_has_record(ctx, id) && fsize(fst) >= 0) return 0;
    if (job_has_record(ctx, id)) {
        for (s = 0; s < 5; s++) {
            if (cx_fmt(p, sizeof p, "%s/outer/finish-job-%s.%s", build, id, suf[s])) die("path", id);
            if (fsize(p) >= 0) n += clean_phase_path(outdir, id, p, 0);
        }
        return n;
    }
    for (k = 0; k < 2; k++) for (s = 0; s < 5; s++) {
        if (cx_fmt(p, sizeof p, "%s/outer/%s-%s.%s", build, kind[k], id, suf[s])) die("path", id);
        if (fsize(p) >= 0) n += clean_phase_path(outdir, id, p, 0);
    }
    if (cx_fmt(jobd, sizeof jobd, "%s/jobs/%s", ctx, id)) die("path", id);
    if (fsize(jobd) >= 0) n += clean_phase_path(outdir, id, jobd, 0);
    return n;
}
static void scrub_wave_jobs(const char *outdir, const char *ctx, const char *build, const char *phase) {
    char jobs[4400], prefix[32];
    DIR *d; struct dirent *e;
    if (cx_fmt(jobs, sizeof jobs, "%s/jobs", ctx) || cx_fmt(prefix, sizeof prefix, "%s-", phase)) die("path", phase);
    d = opendir(jobs);
    if (!d) return;
    while ((e = readdir(d))) {
        if (e->d_name[0] == '.') continue;
        if (strncmp(e->d_name, prefix, strlen(prefix))) continue;
        clean_stale_job(outdir, ctx, build, e->d_name);
    }
    closedir(d);
}
static int warmup_tools(const char *root) {
    static const char *w[] = {
        "tools/chain-step.cx", "tools/release-build.cx", "tools/whole-front.cx",
        "tools/source-job-wave.cx", "tools/preflight.cx", "tools/entry-build.cx",
        "tools/release-ape.cx", 0
    };
    int i;
    for (i = 0; w[i]; i++) {
        char p[4400];
        char *a[3];
        if (cx_fmt(p, sizeof p, "%s/%s", root, w[i])) die("path", w[i]);
        a[0] = p; a[1] = (char *)"-c"; a[2] = 0;
        if (bound_sh_secs(root, a, cc_pb())) die("warmup", w[i]);
        sy_printf("WARMUP\t%s\n", w[i]);
    }
    return 0;
}

static int sjw(const char *s, const char *ctx, const char *b, const char *phase, int first, int count, const char *act) {
    char tool[4400], firsts[16], counts[16];
    char *v[12];
    int n = 0;
    if (cx_fmt(tool, sizeof tool, "%s/source-job-wave-O2.elf", b)) die("path", "sjw");
    if (cx_fmt(firsts, sizeof firsts, "%d", first)) die("fmt", "first");
    if (cx_fmt(counts, sizeof counts, "%d", count)) die("fmt", "count");
    v[n++] = tool;
    v[n++] = (char *)s;
    v[n++] = (char *)ctx;
    v[n++] = (char *)b;
    v[n++] = (char *)"wave";
    v[n++] = (char *)phase;
    v[n++] = firsts;
    v[n++] = counts;
    v[n++] = (char *)act;
    v[n++] = 0;
    return pr_code_at("source-job-wave",v,s,cc_pb());
}
/* --touch paths are repository-relative dependency inputs, not output selectors. */
static const char *touches[48];
static int ntouch, nselected;
static int jobs_parallel = 4;
static int jobs_index = -1;
static const char *baseline_ctx;
static char selected[64][128];
static void select_nets(const char *s) {
    char com[4400], toolpath[4400]; char *v[60]; int n = 0;
    if (!ntouch) return;
    if (cx_fmt(com, sizeof com, "%s/unisacc.com", s) || cx_fmt(toolpath, sizeof toolpath, "%s/tools/net-deps.cx", s)) die("path", "net-deps");
    v[n++] = "sh"; v[n++] = com; v[n++] = toolpath; v[n++] = "--"; v[n++] = "--root"; v[n++] = (char *)s; v[n++] = "--touch";
    for (int i = 0; i < ntouch; i++) v[n++] = (char *)touches[i];
    v[n] = 0; pr_result r;
    if (pr_run("net-deps-touch", v, 0, 0, cc_pb(), &r) || r.rc) die("REFUSE net-deps --touch", s);
    if (!r.out || !r.outn || r.out[r.outn - 1] != '\n' || memchr(r.out, 0, r.outn) || memchr(r.out, '\r', r.outn)) die("REFUSE net-deps wire", s);
    char *p = r.out; int footer = 0; nselected = 0;
    while (*p) {
        char *e = strchr(p, '\n'); *e = 0;
        if (!strncmp(p, "AFFECTED\t", 9) && !footer) {
            char *id = p + 9, *tab = strchr(id, '\t');
            if (!tab || !tab[1] || strchr(tab + 1, '\t') || nselected == 64) die("REFUSE affected row", p);
            *tab = 0;
            if (!*id || strlen(id) >= 128 || strchr(id, '/') || strstr(id, "..")) die("REFUSE affected id", id);
            for (int j = 0; j < nselected; j++) if (!strcmp(selected[j], id)) die("REFUSE affected duplicate", id);
            if (cx_fmt(selected[nselected++], 128, "%s", id)) die("affected id", id);
        } else {
            char want[100];
            if (cx_fmt(want, sizeof want, "AFFECTED_SUMMARY\tnets=%d\ttotal=%d", nselected, cf_net_count()) || strcmp(p, want) || footer || e[1]) die("REFUSE affected summary", p);
            footer = 1;
        }
        p = e + 1;
    }
    if (!footer) die("REFUSE affected missing summary", s);
    pr_free(&r);
}
static int net_selected(const char *id) {
    if (!ntouch) return 1;
    for (int i = 0; i < nselected; i++) if (!strcmp(selected[i], id)) return 1;
    return 0;
}
/* Only a successful canonical batch in this process can populate this set. */
#define SEGMENT_JOB_CAP 512
static char segment_verified[SEGMENT_JOB_CAP][160];
static int segment_verified_count;
static void verify_segment_jobs(const char *outdir,const char *s,const char *ctx,const char *build) {
    if (!jobs_segment_end) return;
    char path[4400],list[SEGMENT_JOB_CAP*161],controller[4400],seen[SEGMENT_JOB_CAP][160];size_t n=0;int used=0,count=0,indices[4]={0};
    int total=cf_tool_count()+3*cf_net_count();if(total>SEGMENT_JOB_CAP)die("segment job capacity",0);
    if(cx_fmt(path,sizeof path,"%s/outer/list.stdout",build))die("segment job list",build);
    char *wire=cx_read(path,&n);
    if(!wire||!n||wire[n-1]!='\n'||memchr(wire,0,n))die("REFUSE segment job list",path);
    for(char *p=wire;*p;) {
        char *e=strchr(p,'\n'),*tab=memchr(p,'\t',e-p);
        if(!tab)die("REFUSE segment job row",path);
        if(p==wire&&!strncmp(p,"JOB\t",4)){p=e+1;continue;}
        *tab=0;const char *phases[]={"tool","gen","tbl","net"};int found=0;
        for(int k=0;k<4;k++) {size_t z=strlen(phases[k]);if(strncmp(p,phases[k],z)||p[z]!='-')continue;
            found=1;if(count>=total||strlen(p)>=160)die("REFUSE segment job extent",p);
            for(int j=0;j<count;j++)if(!strcmp(seen[j],p))die("REFUSE duplicate segment job",p);
            if(cx_fmt(seen[count],160,"%s",p))die("segment job id",p);
            char tag[80];if(cx_fmt(tag,sizeof tag,"jobs-%s-%d-finish",phases[k],indices[k]++))die("segment phase",p);
            if(ck_done(outdir,tag)) {
                if(segment_verified_count>=total||cx_fmt(segment_verified[segment_verified_count],160,"%s",p))die("segment job extent",p);
                for(int j=0;j<segment_verified_count;j++)if(!strcmp(segment_verified[j],p))die("REFUSE duplicate segment job",p);
                int z=snprintf(list+used,sizeof list-used,"%s\n",p);if(z<0||(size_t)z>=sizeof list-used)die("segment list bound",p);used+=z;segment_verified_count++;
            }
            break;
        }
        /* The authoritative list also declares planned routes/package rows. Like wave_phase,
           project only the four executable job kinds; their exact extents remain mandatory. */
        if(!found&&strncmp(tab+1,"PLANNED_NOT_READY\t",18)&&strncmp(tab+1,"PLANNED_NOT_READY\n",18)&&strcmp(p,"NOT_CLAIMED"))die("REFUSE unknown executable job kind",p);
        if(found)count++;p=e+1;
    }
    free(wire);if(count!=cf_tool_count()+3*cf_net_count()||indices[0]!=cf_tool_count()||indices[1]!=cf_net_count()||indices[2]!=cf_net_count()||indices[3]!=cf_net_count())die("REFUSE segment job count",path);
    if(!segment_verified_count)return;
    if(cx_fmt(path,sizeof path,"%s/segment-verify.ids",outdir)||cx_write(path,list,used)||cx_fmt(controller,sizeof controller,"%s/source-package-O2.elf",build))die("segment verify list",outdir);
    char *v[]={controller,"reuse-batch",(char *)s,(char *)ctx,path,0};long began=sy_now_ms();
    if(pr_code_at("segment-reuse-batch",v,s,cc_pb()))die("REFUSE segment job identity/bytes",path);
    sy_printf("SEGMENT_VERIFY\tjobs=%d\twall_ms=%ld\tscope=process-only\n",segment_verified_count,sy_now_ms()-began);
}
static void verify_reuse(const char *s, const char *ctx, const char *b, const char *id) {
    for(int i=0;i<segment_verified_count;i++)if(!strcmp(segment_verified[i],id)){sy_printf("REUSED\t%s\tverified-in-this-process\n",id);return;}
    char controller[4400];
    if (cx_fmt(controller, sizeof controller, "%s/source-package-O2.elf", b)) die("path", id);
    if (baseline_ctx && !job_has_record(ctx, id)) {
        char *a[] = {controller, "adopt-job", (char *)s, (char *)ctx, (char *)baseline_ctx, (char *)id, 0};
        if (pr_code_at("adopt-job", a, s, cc_pb())) die("REFUSE adoption identity/bytes", id);
        return; /* adopt-job already performs the canonical final verification. */
    }
    char *v[] = {controller, "reuse-job", (char *)s, (char *)ctx, (char *)id, 0};
    if (pr_code_at("reuse-job", v, s, cc_pb())) die("REFUSE unchanged job identity/bytes", id);
    sy_printf("REUSED\t%s\tidentity-and-bytes-verified\n", id);
}
static void invalidate_job(const char *outdir, const char *ctx, const char *b, const char *id) {
    char p[4400];
    if (cx_fmt(p, sizeof p, "%s/jobs/%s", ctx, id)) die("path", id);
    if (!under_dir(p, ctx)) die("REFUSE job path", p);
    if (fsize(p) >= 0 && cx_rmtree(p)) die("remove invalidated job", p);
    const char *actions[] = {"start-job", "finish-job"};
    const char *suffix[] = {"argv.tsv", "env", "status", "stderr", "stdout", "error"};
    for (int a = 0; a < 2; a++) for (int j = 0; j < 6; j++) {
        if (cx_fmt(p, sizeof p, "%s/outer/%s-%s.%s", b, actions[a], id, suffix[j])) die("path", id);
        if (fsize(p) >= 0 && sy_unlink(p)) die("remove invalidated evidence", p);
    }
}
static int wave_phase(const char *outdir, const char *s, const char *ctx, const char *b,
                      const char *phase, int total, int resume) {
    char list[4400], ids[128][160]; size_t bytes = 0; char *wire;
    int count = 0, chosen[128];
    if (cx_fmt(list, sizeof list, "%s/outer/list.stdout", b)) die("path", phase);
    wire = cx_read(list, &bytes);
    if (!wire || !bytes || wire[bytes - 1] != '\n' || memchr(wire, 0, bytes)) die("REFUSE authoritative jobs list", list);
    for (char *p = wire; *p;) {
        char *e = strchr(p, '\n'), *tab; *e = 0; tab = strchr(p, '\t');
        if (tab) {
            *tab = 0;
            if (!strncmp(p, phase, strlen(phase)) && p[strlen(phase)] == '-') {
                if (count >= total || count >= cf_net_count() || cx_fmt(ids[count], 160, "%s", p)) die("REFUSE job list extent", phase);
                chosen[count] = !strcmp(phase, "tool") ? !ntouch : net_selected(p + strlen(phase) + 1);
                count++;
            }
        }
        p = e + 1;
    }
    free(wire);
    if (count != total) die("REFUSE job list count", phase);
    if (jobs_index >= total) die("REFUSE job index outside phase", phase);
    for (int first = 0; first < total;) {
        if (jobs_index >= 0 && first != jobs_index) { first++; continue; }
        if (!chosen[first]) {
            char start[80], finish[80];
            if (cx_fmt(start, sizeof start, "jobs-%s-%d-start", phase, first) || cx_fmt(finish, sizeof finish, "jobs-%s-%d-finish", phase, first)) die("phase", phase);
            if (!(resume && ck_done(outdir, finish))) {
                long began = sy_now_ms();
                verify_reuse(s, ctx, b, ids[first]);
                if (!(resume && ck_done(outdir, start))) mark(outdir, start, 0);
                mark(outdir, finish, sy_now_ms() - began);
            } else {
                /* Final canonical unions revalidate every checkpoint before routes consume it. */
                sy_printf("RESUME\t%s\tcanonical-final-required\n", finish);
                if (until_phase && (!strcmp(start, until_phase) || !strcmp(finish, until_phase))) exit(0);
            }
            first++; continue;
        }
        int end = first + 1;
        while (jobs_index < 0 && end < total && chosen[end] && end - first < jobs_parallel) end++;
        /* Both actions retain per-job receipts; a failed wave never marks DONE. */
        if (ntouch && !resume) for (int j = first; j < end; j++) invalidate_job(outdir, ctx, b, ids[j]);
        for (int action = 0; action < 2; action++) {
            int at = first;
            while (at < end) {
                char tag[80];
                if (cx_fmt(tag, sizeof tag, "jobs-%s-%d-%s", phase, at, action ? "finish" : "start")) die("phase", phase);
                if (resume && ck_done(outdir, tag)) {
                    if (action) verify_reuse(s, ctx, b, ids[at]);
                    sy_printf("RESUME\t%s\n", tag);
                    if (until_phase && !strcmp(tag, until_phase)) exit(0);
                    at++; continue;
                }
                int stop = at + 1;
                while (stop < end) {
                    char next[80];
                    if (cx_fmt(next, sizeof next, "jobs-%s-%d-%s", phase, stop, action ? "finish" : "start")) die("phase", phase);
                    if (resume && ck_done(outdir, next)) break;
                    stop++;
                }
                if (!action) for (int j = at; j < stop; j++) clean_stale_job(outdir, ctx, b, ids[j]);
                long t0 = sy_now_ms();
                if (sjw(s, ctx, b, phase, at, stop - at, action ? "finish-job" : "start-job")) die("job action", tag);
                long wall = sy_now_ms() - t0;
                for (int j = at; j < stop; j++) {
                    if (cx_fmt(tag, sizeof tag, "jobs-%s-%d-%s", phase, j, action ? "finish" : "start")) die("phase", phase);
                    mark(outdir, tag, wall);
                }
                at = stop;
            }
        }
        first = end;
    }
    return 0;
}
/* T11 memo gate. chain-run hands the memo (file and identity) to every phase except compare
   and pack. This process uses it, and lets chain-step inherit it, only for a bounded --until
   call that is neither of those two; in every other case both variables are removed, so the
   re-check before compare and before pack reads and hashes every byte. */
static int derived_on;
/* VALUE of row KEY in CTX/context.tsv ("KEY<TAB>VALUE"), 0 or -1. */
static int context_value(const char *ctx, const char *key, char *out, long cap) {
    char path[4400], needle[80]; size_t n = 0;
    if (cx_fmt(path, sizeof path, "%s/context.tsv", ctx) || cx_fmt(needle, sizeof needle, "%s\t", key)) return -1;
    char *text = cx_read(path, &n), *at = text; int rc = -1;
    while (at && *at) {
        char *e = strchr(at, 0x0a);
        if (!e) break;
        if (!strncmp(at, needle, strlen(needle))) { *e = 0; rc = cx_fmt(out, cap, "%s", at + strlen(needle)) ? -1 : 0; break; }
        at = e + 1;
    }
    free(text); return rc;
}
static void chain_memo_off(const char *reason) {
    sm_close(); derived_on = 0;
    if (!sy_env("UNISACC_CHAIN_SHAMEMO") && !sy_env("UNISACC_CHAIN_SHAMEMO_ID")) return;
    if (sy_unsetenv("UNISACC_CHAIN_SHAMEMO") || sy_unsetenv("UNISACC_CHAIN_SHAMEMO_ID") || sy_env("UNISACC_CHAIN_SHAMEMO") || sy_env("UNISACC_CHAIN_SHAMEMO_ID"))
        die("REFUSE sha memo not removable", reason);
    sy_printf("SHAMEMO\tchain\toff\treason=%s\n", reason);
}
/* --recheck-only (compare or pack): walk every earlier re-check with the memo removed, build
   nothing, stop in front of the phase and leave a receipt bound to the checkpoint bytes and the
   memo identity. The phase call that follows may use the memo for its own walk only when that
   receipt is still current (no checkpoint row since) and it consumes it: one full re-check
   authorizes one compare or pack call. Without a current receipt the call itself is the full,
   memo-less re-check, exactly as before. */
static int recheck_only;
static int recheck_text(const char *outdir, const char *until, const char *id, char *text, long cap) {
    char cp[4400], hash[65]; size_t n = 0;
    if (cx_fmt(cp, sizeof cp, "%s/checkpoint.tsv", outdir)) return -1;
    char *b = cx_read(cp, &n);
    if (!b || sy_sha256_hex(b, (long)n, hash)) { free(b); return -1; }
    free(b);
    return cx_fmt(text, cap, "recheck-v1\tbefore=%s\tcheckpoint=%s\tmemo=%s\n", until, hash, id && id[0] ? id : "-");
}
static void recheck_leave(const char *outdir, const char *until) {
    char file[4400], tmp[4500], text[400];
    if (!recheck_only || !until_phase || !tx_eqz(until, until_phase)) return;
    if (cx_fmt(file, sizeof file, "%s/recheck-%s.receipt", outdir, until) || cx_fmt(tmp, sizeof tmp, "%s.new", file) ||
        recheck_text(outdir, until, sy_env("UNISACC_CHAIN_RECHECK_ID"), text, sizeof text) ||
        cx_write(tmp, text, strlen(text)) || sy_rename(tmp, file)) die("recheck receipt", until);
    sy_printf("RECHECK\tbefore=%s\tfull=1\tmemo=off\tbuilt=0\n", until);
    exit(0);
}
static int recheck_consume(const char *outdir, const char *until, const char *id) {
    char file[4400], used[4500], want[400]; size_t n = 0;
    if (cx_fmt(file, sizeof file, "%s/recheck-%s.receipt", outdir, until) || cx_fmt(used, sizeof used, "%s.used", file) || recheck_text(outdir, until, id, want, sizeof want)) return 0;
    char *have = cx_read(file, &n);
    int ok = have && n == strlen(want) && !memcmp(have, want, n);
    free(have);
    if (fsize(file) >= 0 && sy_rename(file, used)) die("recheck receipt consume", file);
    return ok;
}
static void chain_memo(const char *until, const char *outdir) {
    const char *file = sy_env("UNISACC_CHAIN_SHAMEMO"), *id = sy_env("UNISACC_CHAIN_SHAMEMO_ID");
    if (recheck_only) { chain_memo_off("recheck-only"); return; }
    if (!file && !id) return;
    if (!file || !file[0] || !id || !id[0]) { chain_memo_off("incomplete-memo-environment"); return; }
    if (!until) { chain_memo_off("unbounded-call"); return; }
    if ((tx_eqz(until, "compare") || tx_eqz(until, "pack")) && !recheck_consume(outdir, until, id)) { chain_memo_off("no-current-full-recheck-before-compare-or-pack"); return; }
    if (sm_open(file, id)) { chain_memo_off("memo-unavailable"); return; }
    /* The two derived memos (verify-context verdict, closure-list plan) are off unless the runner
       asks for them: both tools also depend on host state the listing cannot see (see docs). */
    derived_on = sy_env("UNISACC_CHAIN_SHAMEMO_DERIVED") && tx_eqz(sy_env("UNISACC_CHAIN_SHAMEMO_DERIVED"), "1");
    sy_printf("SHAMEMO\tchain\ton\tuntil=%s\tderived=%d\n", until, derived_on);
}
/* A derived check memoized over whole-tree metadata: KEY names the tool bytes and arguments,
   the fingerprint lists every entry of the frozen snapshot (all but its out/) and of EXTRA (all
   but EXTRA_SKIP). 0 with FP set when the trees can be fingerprinted, else 1 (run the tool). */
static int derived_shape(const char *snap, const char *extra, const char *extra_skip, char fp[65]) {
    char a[65], b[65], text[200];
    if (!sm_enabled() || !derived_on || sm_tree_meta(snap, "out", a)) return 1;
    if (extra) { if (sm_tree_meta(extra, extra_skip, b)) return 1; } else if (cx_fmt(b, sizeof b, "-")) return 1;
    if (cx_fmt(text, sizeof text, "%s\n%s\n", a, b) || sy_sha256_hex(text, (long)strlen(text), fp)) return 1;
    return 0;
}
static void final_hash(const char *path, char hash[65]) {
    if (sm_enabled() && !sm_sha(path, hash)) return;
    size_t n = 0; char *p = cx_read(path, &n);
    if (!p || sy_sha256_hex(p, (long)n, hash)) { free(p); die("final hash", path); }
    free(p);
}
static int final_name_cmp(const void *a, const void *b) { return strcmp((const char *)a, (const char *)b); }
/* Same frozen-run boundary as the incremental rehearsal: small metadata is
 * rehashed, payloads retain physical stat identity. Not an ABA guarantee. */
static void final_fingerprint(const char *ctx, const char *net, char out[131072]) {
    const char *tools[] = {"tool-gen","tool-tbl","tool-net","tool-compilerpack","tool-pack"};
    const char *prefix[] = {"gen","tbl","net"}; int used = 0;
    for (int j = 0; j < cf_tool_count() + 3; j++) {
        char job[160], dir[4400], names[64][256]; int count = 0;
        if (j < cf_tool_count() ? cx_fmt(job, sizeof job, "%s", tools[j]) : cx_fmt(job, sizeof job, "%s-%s", prefix[j - cf_tool_count()], net)) die("final job", net);
        if (cx_fmt(dir, sizeof dir, "%s/jobs/%s", ctx, job)) die("path", job);
        DIR *d = opendir(dir); struct dirent *e;
        if (!d) die("final job directory", dir);
        while ((e = readdir(d))) {
            if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
            if (count == 64 || cx_fmt(names[count++], 256, "%s", e->d_name)) { closedir(d); die("final entries", dir); }
        }
        closedir(d); qsort(names, count, sizeof names[0], final_name_cmp);
        for (int k = 0; k < count; k++) {
            char path[4400], hash[65] = "-"; struct stat st;
            if (cx_fmt(path, sizeof path, "%s/%s", dir, names[k]) || lstat(path, &st) || !S_ISREG(st.st_mode)) die("final regular file", dir);
            if (strncmp(names[k], "result.", 7)) final_hash(path, hash);
            int n = snprintf(out + used, 131072 - used, "FILE\t%s/%s\t%lu\t%lu\t%ld\t%ld\t%ld\t%s\n", job, names[k], (unsigned long)st.st_dev, (unsigned long)st.st_ino, (long)st.st_size, (long)st.st_mtime, (long)st.st_ctime, hash);
            if (n < 0 || n >= 131072 - used) die("final fingerprint bound", dir);
            used += n;
        }
    }
    out[used] = 0;
}
static void final_job_id(const char *build, int index, char id[160]) {
    char path[4400]; size_t n = 0; int at = 0;
    if (cx_fmt(path, sizeof path, "%s/outer/list.stdout", build)) die("path", "final list");
    char *text = cx_read(path, &n);
    if (!text || !n || text[n - 1] != '\n' || memchr(text, 0, n)) die("final list", path);
    for (char *p = text; *p;) {
        char *e = strchr(p, '\n');
        if (!strncmp(p, "net-", 4)) {
            char *tab = memchr(p, '\t', e - p);
            if (!tab || tab - p >= 160) die("final list row", path);
            if (at++ == index) { *tab = 0; if (cx_fmt(id, 160, "%s", p)) die("final id", path); free(text); return; }
        }
        p = e + 1;
    }
    free(text); die("final net index", path);
}
static void final_binding(const char *root, const char *ctx, const char *build, const char *outdir, const char *id, char header[20000]) {
    char context[4400], controller[4400], ch[65], th[65];
    if (cx_fmt(context, sizeof context, "%s/context.tsv", ctx) || cx_fmt(controller, sizeof controller, "%s/source-package-O2.elf", build)) die("path", "final");
    final_hash(context, ch); final_hash(controller, th);
    if (cx_fmt(header, 20000, "FINAL_NET\trun=%s\troot=%s\tctx=%s\tjob=%s\tcontext_sha=%s\tcontroller_sha=%s\n", outdir, root, ctx, id, ch, th)) die("final header", id);
}
static void final_proof(const char *root, const char *ctx, const char *build, const char *outdir, int index, int reuse) {
    char id[160], header[20000], before[131072], after[131072], file[4400], idsfile[4400], controller[4400];
    final_job_id(build, index, id); final_binding(root, ctx, build, outdir, id, header);
    final_fingerprint(ctx, id + 4, before);
    if (cx_fmt(file, sizeof file, "%s/final-net-%d.proof", outdir, index) || cx_fmt(idsfile, sizeof idsfile, "%s/final-net-%d.ids", outdir, index) || cx_fmt(controller, sizeof controller, "%s/source-package-O2.elf", build)) die("path", id);
    if (reuse) {
        size_t n = 0; char *saved = cx_read(file, &n); size_t hn = strlen(header);
        if (!saved || n <= hn || memcmp(saved, header, hn)) { free(saved); die("REFUSE final proof binding", file); }
        char *footer = strstr(saved + hn, "FINAL_PROOF_SHA\t"), hash[65];
        if (!footer || (footer > saved && footer[-1] != '\n') || n != (size_t)(footer - saved) + 81 || strlen(footer) != 81 || sy_sha256_hex(saved, (long)(footer - saved), hash) || memcmp(footer + 16, hash, 64) || footer[80] != '\n') { free(saved); die("REFUSE final proof digest", file); }
        *footer = 0;
        char *end = strchr(saved + hn, '\n');
        if (strncmp(saved + hn, "VERIFY_JOBS\t", 12) || !end || strcmp(end + 1, before)) { free(saved); die("REFUSE final frozen evidence changed", file); }
        free(saved); return;
    }
    char line[256]; if (cx_fmt(line, sizeof line, "%s\n%s", id, index == 0 ? "tool-compilerpack\ntool-pack\n" : "") || cx_write(idsfile, line, strlen(line))) die("final ids", idsfile);
    char *v[] = {controller, "verify-jobs", (char *)root, (char *)ctx, idsfile, 0}; pr_result r;
    if (pr_run("final net verification", v, root, 0, cc_pb(), &r) || r.rc || r.timed_out || r.residue) { pr_echo(&r); pr_free(&r); die("final canonical verification", id); }
    if (!r.out || strncmp(r.out, "VERIFY_JOBS\t", 12) || !strchr(r.out, '\n') || strchr(r.out, '\n')[1]) { pr_free(&r); die("final verification wire", id); }
    final_fingerprint(ctx, id + 4, after);
    if (strcmp(before, after)) { pr_free(&r); die("final artifacts changed during verification", id); }
    size_t hn = strlen(header), rn = strlen(r.out), fn = strlen(after);
    char *proof = malloc(hn + rn + fn + 96);
    if (!proof) { pr_free(&r); die("allocation", id); }
    if (mm_copy(proof, (long)(hn + rn + fn + 96), header, (long)hn) || mm_copy(proof + hn, (long)(rn + fn + 96), r.out, (long)rn) || mm_copy(proof + hn + rn, (long)(fn + 96), after, (long)fn)) { free(proof); pr_free(&r); die("final proof copy", file); }
    char hash[65]; if (sy_sha256_hex(proof, (long)(hn + rn + fn), hash)) { free(proof); pr_free(&r); die("final proof hash", file); }
    int tail = snprintf(proof + hn + rn + fn, 96, "FINAL_PROOF_SHA\t%s\n", hash);
    if (tail != 81 || cx_write(file, proof, hn + rn + fn + (size_t)tail)) { free(proof); pr_free(&r); die("final proof write", file); }
    free(proof); pr_free(&r);
}
static int jobs_ok(const char *root, const char *ctx, const char *build, const char *outdir, int resume) {
    char controller[4400];
    if (cx_fmt(controller, sizeof controller, "%s/source-package-O2.elf", build)) die("path", "final");
    char *v[] = {controller, "--verify-context", (char *)root, (char *)ctx, 0};
    /* T11: the controller's verdict is reused only while the controller bytes, every entry of the
       frozen snapshot (but its out/) and every entry of CTX (but its jobs/) carry unchanged
       metadata; otherwise, and always in the full re-check before compare and pack, it runs. */
    char vkey[9200], vhash[65], vshape[65], vgot[65]; int vmemo = 0;
    char verified[65];   /* the stored verdict token: sha256 of the line a live run prints */
    if (sy_sha256_hex("VERIFIED\tsource-package-context-v2", 34, verified)) die("verdict token", ctx);
    /* Also keyed: the bytes of the context compiler and of the bootstrap product with its build
       record, which the controller hashes but which live outside both listings. */
    char ccp[4400], bsp[4400], bsr[4500], cch[65], bsh[65], brh[65] = "-";
    if (sm_enabled() && derived_on && !context_value(ctx, "cc", ccp, sizeof ccp) && !context_value(ctx, "bootstrap", bsp, sizeof bsp) &&
        !cx_fmt(bsr, sizeof bsr, "%s.build.json", bsp) && !sm_sha(ccp, cch) && !sm_sha(bsp, bsh) && (fsize(bsr) < 0 || !sm_sha(bsr, brh)) &&
        !sm_sha(controller, vhash) && !cx_fmt(vkey, sizeof vkey, "verify-context\n%s\n%s\n%s\n%s\n%s\n%s\n", vhash, root, ctx, cch, bsh, brh) && !derived_shape(root, ctx, "jobs", vshape)) vmemo = 1;
    if (vmemo && !sm_value_get(vkey, vshape, vgot) && !strcmp(vgot, verified)) sy_printf("VERIFIED\tsource-package-context-v2\tmemo=unchanged-controller-snapshot-context\n");
    else {
        if (pr_code_at("final context", v, root, cc_pb())) die("final current SID/context", ctx);
        char again[65];
        if (vmemo && !derived_shape(root, ctx, "jobs", again) && !strcmp(again, vshape)) sm_value_put(vkey, vshape, verified); else vmemo = 0;
    }
    for (int i = 0; i < cf_net_count(); i++) {
        char tag[80]; if (cx_fmt(tag, sizeof tag, "final-net-%d", i)) die("phase", "final");
        long started = sy_now_ms(); int reuse = resume && ck_done(outdir, tag);
        final_proof(root, ctx, build, outdir, i, reuse);
        if (!reuse) mark(outdir, tag, sy_now_ms() - started);
        else if (until_phase && !strcmp(tag, until_phase)) exit(0);
    }
    {   /* The closing bracket is the same question: a hit needs the same key and the listing as it is now. */
        char after[65];
        if (vmemo && !derived_shape(root, ctx, "jobs", after) && !sm_value_get(vkey, after, vgot) && !strcmp(vgot, verified)) sy_printf("VERIFIED\tsource-package-context-v2\tmemo=unchanged-controller-snapshot-context\n");
        else if (pr_code_at("final context", v, root, cc_pb())) die("final current SID/context changed", ctx);
    }
    sy_printf("FINAL\tmodels=%d\tidentity=current-SID-and-canonical-job-unions\tscope=frozen-run-stat-not-ABA\n", cf_net_count());
    return 0;
}
static int json_quoted(const char *j, size_t n, const char *key, char *dst, int want) {
    char pat[80];
    long at, i;
    if (cx_fmt(pat, sizeof pat, "\"%s\": \"", key)) return 1;
    at = tx_find(j, (long)n, pat, tx_len(pat, 80));
    if (at < 0) return 1;
    at += tx_len(pat, 80);
    for (i = 0; i < want; i++) {
        char c;
        if (at + i >= (long)n) return 1;
        c = j[at + i];
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return 1;
        dst[i] = c;
    }
    dst[want] = 0;
    return 0;
}
static int git_is_ancestor(const char *oldc, const char *newc) {
    char *v[6];
    char *o = 0;
    size_t n = 0;
    int rc;
    v[0] = "git"; v[1] = "merge-base"; v[2] = "--is-ancestor";
    v[3] = (char *)oldc; v[4] = (char *)newc; v[5] = 0;
    rc = cx_runv_timeout(v, 8, &o, &n);
    free(o);
    return rc == 0;
}
static int snap_ok(const char *dir, const char *rev, const char *helper) {
    char mark[4400], js[4400], ape[4400], h[65], commit[41], sid[65], dig[65], live[65];
    size_t mn = 0, jn = 0, an = 0, hn = 0;
    char *m, *j, *a, *text = 0;
    int rc, k;
    if (!helper || !helper[0]) die("REFUSE identity-helper required", dir);
    if (cx_fmt(mark, sizeof mark, "%s/.release-rev", dir)) die("path", "revmark");
    if (cx_fmt(js, sizeof js, "%s/unisacc.com.build.json", dir)) die("path", "json");
    if (cx_fmt(ape, sizeof ape, "%s/unisacc.com", dir)) die("path", "ape");
    m = cx_read(mark, &mn);
    if (!m || mn < 40 || !hex40(rev)) { free(m); die("REFUSE snap rev marker", mark); }
    if (mn > 40 && m[40] != '\n' && m[40] != 0) { free(m); die("REFUSE snap rev marker", mark); }
    m[40] = 0;
    if (!hex40(m) || !tx_eqz(m, rev)) { free(m); die("REFUSE snap rev mismatch", mark); }
    free(m);
    j = cx_read(js, &jn);
    if (!j) die("REFUSE snap receipt", js);
    if (json_quoted(j, jn, "commit", commit, 40)) { free(j); die("REFUSE snap receipt commit", js); }
    if (json_quoted(j, jn, "sources_sha256", sid, 64)) { free(j); die("REFUSE snap receipt SID", js); }
    if (json_quoted(j, jn, "product_digest", dig, 64)) { free(j); die("REFUSE snap receipt digest", js); }
    free(j);
    a = cx_read(ape, &an);
    if (!a) die("REFUSE snap product", ape);
    if (sy_sha256_hex(a, (long)an, h)) { free(a); die("sha", ape); }
    free(a);
    if (!tx_eqz(h, dig)) die("REFUSE snap product SHA mismatch", ape);
    if (!tx_eqz(commit, rev)) {
        if (!git_is_ancestor(commit, rev)) die("REFUSE snap receipt commit not ancestor", commit);
        sy_printf("BOOTSTRAP_FROM\tcommit=%s\tbootstrap_product=%s\n", commit, dig);
    }
    {
        char *v[3];
        v[0] = (char *)helper; v[1] = (char *)dir; v[2] = 0;
        rc = cx_runv_timeout(v, 8, &text, &hn);
        if (rc || !text || hn != 65 || text[64] != '\n') { free(text); die("REFUSE live source SID", helper); }
        for (k = 0; k < 64; k++) {
            char c = text[k];
            if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) { free(text); die("REFUSE live source SID", helper); }
            live[k] = c;
        }
        live[64] = 0;
        free(text);
    }
    sy_printf("SNAP_OK\trev=%s\trecord_sid=%.16s\tlive_sid=%.16s\tproduct=%.16s\tbytes=%lu\n", rev, sid, live, dig, (unsigned long)an);
    return 0;
}

static int parse_par(const char *s) {
    int n = 0, i;
    if (!s || !s[0]) return -1;
    for (i = 0; s[i]; i++) {
        if (s[i] < '0' || s[i] > '9') return -1;
        n = n * 10 + (s[i] - '0');
        if (n > 16) return -1;
    }
    if (n < 1) return -1;
    return n;
}
static void worker_nm_ok(const char *obj) {
    char *v[4];
    char *text = 0;
    size_t n = 0;
    long at;
    v[0] = "nm"; v[1] = "-u"; v[2] = (char *)obj; v[3] = 0;
    if (cx_runv_timeout(v, 8, &text, &n) || !text) { free(text); die("nm", obj); }
    at = tx_find(text, (long)n, "setpgid", 7);
    free(text);
    if (at >= 0) die("REFUSE worker.o libc setpgid", obj);
}

/* 链内单元前端缓存必须关:在 DIR 里用 ROOT/unisacc.com 带 RR_TIME 编一个两单元夹具,
   stderr 不得出现 unitcache result=hit|miss|store。返回 0 通过,非 0 为出现的行数或跑不起来(-1)。 */
static int uc_guard(const char *root, const char *dir) {
    char a[4400], b[4400], err[4400], cmd[14000]; char *e; size_t en = 0; int n = 0, k; long at;
    static const char *pat[3] = {"unitcache\tresult=hit", "unitcache\tresult=miss", "unitcache\tresult=store"};
    if (cx_fmt(a, sizeof a, "%s/uc-guard-a.c", dir) || cx_fmt(b, sizeof b, "%s/uc-guard-b.c", dir) || cx_fmt(err, sizeof err, "%s/uc-guard.err", dir)) return -1;
    static const char sa[] = "int bf(int);\nint main(void){ return bf(1) - 2; }\n", sb[] = "int bf(int x){ return x + 1; }\n";
    if (cx_write(a, sa, sizeof sa - 1) || cx_write(b, sb, sizeof sb - 1)) return -1;
    if (cx_fmt(cmd, sizeof cmd, "UNISACC_RR_TIME=1 UNISACC_E3CACHE='%s/uc-guard-cache' sh '%s/unisacc.com' '%s' '%s' -o '%s/uc-guard.bin' 2>'%s'", dir, root, a, b, dir, err)) return -1;
    { char *v[] = {"sh", "-c", cmd, 0}; if (runv_secs(v, cc_pb())) return -1; }
    e = cx_read(err, &en);
    if (!e) return -1;
    for (k = 0; k < 3; k++) {
        at = 0;
        while (at < (long)en) { int p = tx_find(e + at, (int)((long)en - at), pat[k], tx_len(pat[k], 64)); if (p < 0) break; n++; at += p + 1; }
    }
    free(e);
    /* 守卫只留结论:删掉自己写的四个文件与私有缓存目录里的条目(逐名 unlink,目录用 rmdir) */
    {
        char p[4400], names[16384]; int fd, cnt, j; long off = 0;
        sy_unlink(a); sy_unlink(b); sy_unlink(err);
        if (!cx_fmt(p, sizeof p, "%s/uc-guard.bin", dir)) sy_unlink(p);
        if (!cx_fmt(cmd, 4400, "%s/uc-guard-cache", dir) && (fd = sy_open_read(cmd)) >= 0) {
            cnt = sy_dir_names(fd, names, (int)sizeof names);
            sy_close(fd);
            for (j = 0; j < cnt; j++) {
                if (!cx_fmt(p, sizeof p, "%s/%s", cmd, names + off)) sy_unlink(p);
                off += tx_len(names + off, (long)sizeof names - off) + 1;
            }
            sy_rmdir(cmd);
        }
    }
    return n;
}

/* A lane never prepares inputs or visits sibling targets. Each whole-front call
 * locks its prepared TMPDIR; the two Mac lanes also share a generation-specific
 * stub lock across front/stub/B, because the real forward stub lives in prep/tmp. */
static void lane_need(const char *outdir, const char *phase, const char *product) {
    if (!ck_complete(outdir, phase, product)) die("REFUSE lane dependency incomplete", phase);
}
static int run_lane(const char *root, const char *outdir, const char *rev,
    const char *snap, const char *build, const char *pkg, const char *gen1,
    const char *fp, const char *helper, int resume) {
    const char *slugs[] = {"lnx-x86_64", "lnx-arm64", "osx-x86_64", "osx-arm64", "win-x86_64", "win-arm64"};
    const char *targets[] = {"lnx/x86_64", "lnx/arm64", "osx/x86_64", "osx/arm64", "win/x86_64", "win/arm64"};
    char tag[100], dep[100], product[4400], prep[4400], tmp[4400];
    int gen = 0, ti = -1;
    if (!resume || ntouch || jobs_index >= 0) die("REFUSE lane requires --resume without touch/job-index", lane_phase);
    int prepare_gen = 0, span_prepare = 0;
    for (int g = 1; g <= 3; g++) {
        if (g == 1 ? cx_fmt(tag, sizeof tag, "wf-prepare") : cx_fmt(tag, sizeof tag, "wf-prep-g%d", g)) die("prepare lane", lane_phase);
        if (!strcmp(tag, lane_phase)) prepare_gen = g;
        span_prep_tag(tag, sizeof tag, g);
        if (!strcmp(tag, lane_phase)) { prepare_gen = g; span_prepare = 1; }
    }
    if (prepare_gen) {
        char objs[4400], ctor[4400];
        if (until_phase && strcmp(until_phase, lane_phase)) die("REFUSE prepare lane until", lane_phase);
        lane_need(outdir, "p3", pkg);
        if (prepare_gen == 1) {
            if (cx_fmt(dep, sizeof dep, "gen1-lnx-x86_64") || cx_fmt(objs, sizeof objs, "%s/gen1/lnx-x86_64", outdir)) die("prepare dependency", lane_phase);
        } else if (cx_fmt(dep, sizeof dep, "g%d-lnx-x86_64", prepare_gen) || cx_fmt(objs, sizeof objs, "%s/g%d/lnx-x86_64", fp, prepare_gen)) die("prepare dependency", lane_phase);
        if (cx_fmt(ctor, sizeof ctor, "%s/candidate", objs)) die("prepare constructor", lane_phase);
        lane_need(outdir, dep, ctor);
        prep_dir(prep, sizeof prep, prepare_gen, span_prepare ? "wf-span-prep" : "wf-prep");
        int lock = candidate_lock(prep, "prepare-owner");
        int rc = span_prepare ? wf_span_prep(root, outdir, helper, prepare_gen, snap, pkg, ctor, objs) : wf_prepare_gen(root, outdir, helper, prepare_gen, snap, pkg, ctor, objs);
        if (sy_close(lock)) die("prepare unlock", prep);
        return rc;
    }
    for (int g = 1; g <= 3; g++) for (int t = 0; t < 6; t++) {
        if (g == 1 ? cx_fmt(tag, sizeof tag, "gen1-%s", slugs[t]) : cx_fmt(tag, sizeof tag, "g%d-%s", g, slugs[t])) die("lane tag", lane_phase);
        if (!strcmp(tag, lane_phase)) { gen = g; ti = t; }
    }
    if (!gen) die("REFUSE unknown lane", lane_phase);
    if (until_phase && strcmp(until_phase, lane_phase)) {
        /* WF subphases use genN, even when the outer lane uses gN. */
        if (cx_fmt(tag, sizeof tag, "gen%d-%s-", gen, slugs[ti]) || cx_fmt(dep, sizeof dep, "%s-", lane_phase)) die("lane prefix", lane_phase);
        if (strncmp(until_phase, tag, strlen(tag)) && strncmp(until_phase, dep, strlen(dep))) die("REFUSE until outside lane", until_phase);
    }
    lane_need(outdir, "p3", pkg);
    if (fsize(helper) <= 0) die("REFUSE missing lane identity helper", helper);
    if (gen == 1 && ti < 2) {
        lane_need(outdir, "build", "");
        if (cx_fmt(product, sizeof product, "%s/Root41-bootstrap.com", build)) die("lane ctor", build);
        if (fsize(product) <= 0) die("REFUSE missing bootstrap constructor", product);
    } else {
        int cg = gen == 1 ? 1 : ti < 2 ? gen - 1 : gen;
        if (cg == 1) {
            if (cx_fmt(dep, sizeof dep, "gen1-lnx-x86_64") || cx_fmt(product, sizeof product, "%s", gen1)) die("lane dependency", lane_phase);
        } else if (cx_fmt(dep, sizeof dep, "g%d-lnx-x86_64", cg) || cx_fmt(product, sizeof product, "%s/g%d/lnx-x86_64/candidate", fp, cg)) die("lane dependency", lane_phase);
        lane_need(outdir, dep, product);
        if (gen == 3) {
            if (cx_fmt(dep, sizeof dep, "g2-%s", slugs[ti])) die("lane previous target", lane_phase);
            lane_need(outdir, dep, "");
        }
        if (ti >= 2) {
            prep_dir(prep, sizeof prep, gen, "wf-prep");
            if (cx_fmt(product, sizeof product, "%s/receipt.txt", prep)) die("lane prep", prep);
            if (gen == 1 ? cx_fmt(dep, sizeof dep, "wf-prepare") : cx_fmt(dep, sizeof dep, "wf-prep-g%d", gen)) die("lane prep", prep);
            lane_need(outdir, dep, product);
            prep_dir(prep, sizeof prep, gen, "wf-span-prep");
            span_prep_tag(dep, sizeof dep, gen);
            if (cx_fmt(product, sizeof product, "%s/receipt.txt", prep)) die("lane prep", prep);
            lane_need(outdir, dep, product);
        }
    }
    if (cx_fmt(tmp, sizeof tmp, "%s/tmp-%s", outdir, lane_phase)) die("lane tmp", lane_phase);
    if (sy_mkdir(tmp, 0700) && fsize(tmp) < 0) die("lane tmp", tmp);
    if (sy_setenv("TMPDIR", tmp, 1) || sy_setenv("UNISACC_IDENTITY_HELPER", helper, 1)) die("lane environment", lane_phase);
    hb(outdir, lane_phase, "start");
    int mac_lock = -1;
    if (ti == 2 || ti == 3) {
        prep_dir(prep, sizeof prep, gen, "wf-prep");
        mac_lock = candidate_lock(prep, "mac-stub");
    }
    if (gen == 1 && ti < 2) {
        char gout[4400], parent[4400], ctor[4400], ebt[4400];
        if (cx_fmt(parent, sizeof parent, "%s/gen1", outdir) || cx_fmt(gout, sizeof gout, "%s/%s", parent, slugs[ti]) || cx_fmt(ctor, sizeof ctor, "%s/Root41-bootstrap.com", build) || cx_fmt(ebt, sizeof ebt, "%s/tools/entry-build.cx", snap)) die("lane entry", lane_phase);
        sy_mkdir(parent, 0755);
        if (sy_mkdir(gout, 0755) && fsize(gout) < 0) die("lane output", gout);
        if (sy_setenv("UNISACC_CTOR", ctor, 1) || sy_setenv("UNISA_CONTAINER", pkg, 1) || sy_chdir(snap)) die("lane entry environment", snap);
        gen1_entry(outdir, snap, ctor, ebt, pkg, gout, targets[ti], lane_phase, resume);
    } else if (ti < 2) {
        run_g2_lnx(root, outdir, rev, snap, pkg, gen1, fp, helper, targets[ti], slugs[ti], gen, resume);
    } else if (gen == 1) {
        if (wf_fronts(root, outdir, helper, gen, targets[ti], slugs[ti], ti < 4)) die("lane fronts", lane_phase);
        if (ti < 4) {
            if (wf_mac_b(root, outdir, helper, gen, targets[ti], slugs[ti])) die("lane Mac B", lane_phase);
        } else if (wf_win_span(root, outdir, helper, gen, targets[ti], slugs[ti])) die("lane Windows span", lane_phase);
    } else gen_slice_phase(root, outdir, helper, rev, snap, pkg, gen1, fp, gen, ti - 2, resume);
    if (mac_lock >= 0 && sy_close(mac_lock)) die("lane Mac unlock", lane_phase);
    return 0;
}

/* Read-only path query and execution use the same derivation. Fixtures consume
 * this entry instead of duplicating the snapshot layout below their own OUT. */
static void chain_paths(const char *root, const char *rev, char *snap) {
    if (strlen(rev) != 40) die("revision hex", rev);
    for (int i=0;i<40;i++) if (!((rev[i]>='0'&&rev[i]<='9')||(rev[i]>='a'&&rev[i]<='f'))) die("revision hex",rev);
    if (cx_fmt(snap,4400,"%s/out/release-snap-%.10s",root,rev) ||
        cx_fmt(chain_work,sizeof chain_work,"%s/out/chain",snap)) die("path","chain workspace");
}

int main(int argc, char **argv) {
    const char *rev = 0, *outdir = 0, *cc = "/usr/bin/x86_64-linux-gnu-gcc-11";
    const char *vs_dir = 0, *vs_rev = 0, *idhelp = 0, *cm64 = 0, *cmarm = 0, *boot = 0, *wnm = 0;
    const char *jobs_root = 0, *jobs_ctx = 0, *jobs_build = 0, *jobs_phase = 0;
    int resume = 0, parallel = 0, i, plan_only = 0;
    char root[4400], snap[4400], build[4400], ctx[4400], routes[4400], pkg[4400], fp[4400], gen1[4400], helper[4400];
    if (sy_realpath(".", root, sizeof root) < 0) die("cwd", ".");
    if (argc == 4 && tx_eqz(argv[1], "--chain-work")) {
        if (sy_realpath(argv[2], root, sizeof root) < 0) die("workspace root", argv[2]);
        chain_paths(root, argv[3], snap);
        sy_printf("%s\n", chain_work);
        return 0;
    }
    /* 链内产物不得依赖单元前端缓存(plans/unit-frontcache.md):强制关,子进程继承;设不上或读回不是 0 即拒绝 */
    {   const char *ae = sy_env("UNISACC_CHAIN_ATTEMPT_END_MS");
        if (ae && *ae) {
            long value = 0;
            for (const char *q = ae; *q; q++) { if (*q < '0' || *q > '9' || value > 4000000000000L) die("REFUSE attempt end", ae); value = value * 10 + (*q - '0'); }
            attempt_end = value;
        }
    }
    if (sy_setenv("UNISACC_UNIT_CACHE", "0", 1) || !sy_env("UNISACC_UNIT_CACHE") || !tx_eqz(sy_env("UNISACC_UNIT_CACHE"), "0"))
        die("REFUSE unit cache not forced off", "UNISACC_UNIT_CACHE");
    /* Test seam: explicit paths, no snapshot preparation or real construction. */
    if (argc == 6 && tx_eqz(argv[1], "--segment-jobs-fixture")) {
        jobs_segment_end=sy_now_ms()+(cc_lim("segment", 0)-3)*1000L;
        verify_segment_jobs(argv[3],argv[2],argv[4],argv[5]);
        for(int i=0;i<segment_verified_count;i++) {
            verify_reuse(argv[2],argv[4],argv[5],segment_verified[i]);
            verify_reuse(argv[2],argv[4],argv[5],segment_verified[i]);
        }
        sy_printf("SEGMENT_JOBS_FIXTURE\tverified=%d\n",segment_verified_count);return 0;
    }
    if (argc == 6 && tx_eqz(argv[1], "--partition-fixture")) {
        if (tx_copy(chain_work, sizeof chain_work, argv[4], strlen(argv[4]))) die("fixture path", argv[4]);
        until_phase = tx_eqz(argv[5], "-") ? 0 : argv[5];
        return wf_fronts(argv[2], argv[3], "fixture-helper", 1, "osx/x86_64", "osx-x86_64", 1);
    }
    if (argc == 5 && tx_eqz(argv[1], "--kernels-scrub-fixture")) {
        /* OUT FP G: only the scrub that precedes the kernels step. */
        kernels_scrub(argv[2], argv[3], tx_eqz(argv[4], "3") ? 3 : 2);
        return 0;
    }
    if (argc == 9 && tx_eqz(argv[1], "--wf-stub-fixture")) {
        /* ROOT OUT PREP TARGET PHASE DEST TAG: the stub step alone, against a fake ROOT/unisacc.com. */
        char wft[4400];
        if (cx_fmt(wft, sizeof wft, "%s/tools/whole-front.cx", argv[2])) die("path", "wf");
        wf_stub(argv[2], argv[3], wft, argv[4], argv[5], argv[6], argv[7], argv[8]);
        return 0;
    }
    if (argc == 11 && tx_eqz(argv[1], "--gen1-entry-fixture")) {
        until_phase = tx_eqz(argv[10], "-") ? 0 : argv[10];
        gen1_entry(argv[2], argv[3], argv[4], argv[5], argv[6], argv[7],
                   argv[8], "gen1-lnx-fixture", tx_eqz(argv[9], "resume"));
        return 0;
    }
    if (argc == 5 && tx_eqz(argv[1], "--tool-pin-fixture")) {
        /* 夹具入口: --tool-pin-fixture ROOT OUT TOOL.cx,只做钉住并打印可执行体路径 */
        char nat[4400];
        step_out = argv[3];
        const char *nm = tool_pinned(argv[2], argv[4], 50, nat, sizeof nat);
        if (!nm) die("REFUSE not a pinned chain tool", argv[4]);
        sy_printf("TOOL_PIN\t%s\t%s\n", nm, nat);
        return 0;
    }
    if (argc == 9 && tx_eqz(argv[1], "--g2g3-fixture")) {
        until_phase = tx_eqz(argv[8], "-") ? 0 : argv[8];
        jobs_segment_out = argv[3];
        run_g2_lnx(argv[2], argv[3], "23a873aaa156440b99c25ef48c2d94f6ca32e858", argv[4],
                   "package", "constructor", argv[5], "identity-helper", "lnx/x86_64", "lnx-x86_64",
                   tx_eqz(argv[6], "g3") ? 3 : 2, tx_eqz(argv[7], "resume"));
        return 0;
    }
    for (i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--lane") && i + 1 < argc) { if (lane_phase) die("REFUSE duplicate lane", 0); lane_phase = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--plan")) { plan_only = 1; sy_printf("ENV\tUNISACC_UNIT_CACHE=0\n"); continue; }
        if (tx_eqz(argv[i], "--uc-guard") && i + 1 < argc) {
            /* 夹具入口: --uc-guard DIR,在本进程已强制的环境下跑一次守卫 */
            int g = uc_guard(root, argv[i + 1]);
            sy_printf("UC_GUARD\t%s\tlines=%d\n", g == 0 ? "ok" : "REFUSE", g);
            return g == 0 ? 0 : 3;
        }
        if (tx_eqz(argv[i], "--memo-gate") && i + 2 < argc) {
            /* 夹具入口: --memo-gate UNTIL|- OUT [recheck],对当前环境跑一次备忘门(与正式入口同一函数),打印结论;
               第四个词为 recheck 时改走 --recheck-only 的收据落盘(同一函数),不走任何复核或构造 */
            const char *gu = tx_eqz(argv[i + 1], "-") ? 0 : argv[i + 1];
            if (i + 3 < argc && tx_eqz(argv[i + 3], "recheck")) { recheck_only = 1; until_phase = gu; chain_memo(gu, argv[i + 2]); recheck_leave(argv[i + 2], gu ? gu : "-"); return 3; }
            chain_memo(gu, argv[i + 2]);
            sy_printf("MEMO_GATE\tuntil=%s\tenabled=%d\tderived=%d\tinherit=%d\n", argv[i + 1], sm_enabled(), derived_on,
                      sy_env("UNISACC_CHAIN_SHAMEMO") != 0 || sy_env("UNISACC_CHAIN_SHAMEMO_ID") != 0);
            return 0;
        }
        if (tx_eqz(argv[i], "--recheck-only")) { recheck_only = 1; continue; }
        if (tx_eqz(argv[i], "--jobs-segment-s") && i + 1 < argc) {
            const char *p = argv[++i]; char *end = 0; long secs = strtol(p, &end, 10);
            if (!*p || *end || secs < cc_pb() || secs > cc_lim("segment", 0) - 3) die("REFUSE jobs segment phase.bound..segment-3", p);
            jobs_segment_end = sy_now_ms() + secs * 1000; continue;
        }
        if (tx_eqz(argv[i], "--phases") && i + 1 < argc) { phases_file = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--baseline-ctx") && i + 1 < argc) { baseline_ctx = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--job-index") && i + 1 < argc) {
            const char *p = argv[++i]; int value = 0;
            if (!*p) die("REFUSE job index", p);
            for (const char *q = p; *q; q++) {
                if (*q < '0' || *q > '9' || value > 41) die("REFUSE job index", p);
                value = value * 10 + *q - '0';
            }
            if (value > 41) die("REFUSE job index", p);
            jobs_index = value; continue;
        }
        if (tx_eqz(argv[i], "--touch") && i + 1 < argc) {
            if (ntouch == 48 || argv[i + 1][0] == '/' || strstr(argv[i + 1], "..") || strpbrk(argv[i + 1], "\t\r\n")) die("REFUSE touch path", argv[i + 1]);
            touches[ntouch++] = argv[++i]; continue;
        }
        if (tx_eqz(argv[i], "--jobs") && i + 4 < argc) { jobs_root = argv[++i]; jobs_ctx = argv[++i]; jobs_build = argv[++i]; jobs_phase = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--worker-nm") && i + 1 < argc) { wnm = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--resume")) { resume = 1; continue; }
        if (tx_eqz(argv[i], "--slice-path") && i + 2 < argc) {
            /* 夹具入口: --slice-path WORK SLUG,打印 pack 取用的 osx/win 切片路径;文件缺失即拒绝 */
            char sb[4400];
            tx_copy(chain_work, (long)sizeof chain_work, argv[i + 1], tx_len(argv[i + 1], 4000));
            if (pack_slice(sb, sizeof sb, argv[i + 2])) die("REFUSE unknown slice slug", argv[i + 2]);
            if (fsize(sb) < 1) die("REFUSE missing slice image", sb);
            sy_printf("SLICE_PATH\t%s\n", sb);
            return 0;
        }
        if (tx_eqz(argv[i], "--prep-path") && i + 3 < argc) {
            /* 夹具入口: --prep-path WORK GEN BASE,打印该代 prepare 目录;gen 越界即拒绝 */
            char pb[4400];
            tx_copy(chain_work, (long)sizeof chain_work, argv[i + 1], tx_len(argv[i + 1], 4000));
            prep_dir(pb, sizeof pb, argv[i + 2][0] >= '0' && argv[i + 2][0] <= '9' ? argv[i + 2][0] - '0' : 0, argv[i + 3]);
            sy_printf("PREP_PATH\t%s\n", pb);
            return 0;
        }
        if (tx_eqz(argv[i], "--clean-phase") && i + 5 < argc) {
            /* 夹具入口: --clean-phase OUT WORK PHASE PATH RECEIPT(- 为无) */
            tx_copy(chain_work, (long)sizeof chain_work, argv[i + 2], tx_len(argv[i + 2], 4000));
            return clean_phase_path(argv[i + 1], argv[i + 3], argv[i + 4], tx_eqz(argv[i + 5], "-") ? 0 : argv[i + 5]) ? 0 : 3;
        }
        if (tx_eqz(argv[i], "--clean-job") && i + 5 < argc) {
            tx_copy(chain_work, (long)sizeof chain_work, argv[i + 2], tx_len(argv[i + 2], 4000));
            clean_stale_job(argv[i + 1], argv[i + 3], argv[i + 4], argv[i + 5]);
            return 0;
        }
        if (tx_eqz(argv[i], "--ck-done") && i + 2 < argc) {
            const char *prod = (i + 3 < argc) ? argv[i + 3] : "";
            sy_printf("CK_DONE\t%s\t%s\n", argv[i + 2], ck_complete(argv[i + 1], argv[i + 2], prod) ? "yes" : "no");
            return 0;
        }
        if (tx_eqz(argv[i], "--clean-wf-dest") && i + 4 < argc) {
            char prod[4400];
            tx_copy(chain_work, (long)sizeof chain_work, argv[i + 2], tx_len(argv[i + 2], 4000));
            if (cx_fmt(prod, sizeof prod, "%s/body.bin", argv[i + 3])) die("path", argv[i + 3]);
            if (ck_complete(argv[i + 1], argv[i + 4], prod)) { sy_printf("WF_DEST_KEPT\t%s\n", argv[i + 3]); return 0; }
            wf_scrub_dest(argv[i + 1], argv[i + 3]);
            return 0;
        }
        if (tx_eqz(argv[i], "--check-template") && i + 1 < argc) {
            /* 夹具:g2/g3 prepare 与 gen1 共用的模板钉;负例改一字节应 REFUSE */
            check_whole_front_template(argv[i + 1]);
            sy_printf("WF_PREP_G2_TEMPLATE_OK\t%s\n", argv[i + 1]);
            return 0;
        }
        if (tx_eqz(argv[i], "--install-file") && i + 2 < argc) {
            /* 夹具:对 install_if_changed 的独立入口(同内容不重写、异内容原子替换) */
            size_t fn = 0;
            char *fb = cx_read(argv[i + 1], &fn);
            if (!fb || install_if_changed(argv[i + 2], fb, fn, 0755)) { free(fb); die("install-file", argv[i + 2]); }
            free(fb);
            sy_printf("INSTALL_FILE_OK\t%s\n", argv[i + 2]);
            return 0;
        }
        if (tx_eqz(argv[i], "--verify-snap") && i + 2 < argc) { vs_dir = argv[++i]; vs_rev = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--identity-helper") && i + 1 < argc) { idhelp = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--rev") && i + 1 < argc) { rev = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--out") && i + 1 < argc) { outdir = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--cc") && i + 1 < argc) { cc = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--cache-manager-osx") && i + 2 < argc) { cm64 = argv[++i]; cmarm = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--bootstrap") && i + 1 < argc) { boot = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--until") && i + 1 < argc) { until_phase = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--parallel") && i + 1 < argc) {
            parallel = parse_par(argv[++i]);
            if (parallel < 1) die("REFUSE parallel 1..16", argv[i]);
            continue;
        }
        die("REFUSE unknown/duplicate option", argv[i]);
    }
    if (jobs_index >= 0 && !jobs_root) die("REFUSE --job-index requires --jobs", 0);
    jobs_parallel = parallel ? parallel : 4;
    if (wnm) { worker_nm_ok(wnm); sy_printf("WORKER_NM_OK\t%s\n", wnm); return 0; }
    if (vs_dir) {
        if (!vs_rev || !hex40(vs_rev)) die("REFUSE --rev 40-hex required", vs_rev);
        if (!idhelp) die("REFUSE --identity-helper required", vs_dir);
        return snap_ok(vs_dir, vs_rev, idhelp);
    }
    load_chain_phases(root);
    if (jobs_root) {
        if (!strcmp(jobs_phase, "final")) {
            if (!outdir || !*outdir) die("REFUSE final --out required", 0);
            if (plan_only) { sy_printf("FINAL_PLAN\tmodels=%d\tchild_bound=%d\n", cf_net_count(), cc_pb()); return 0; }
            if (sy_mkdir(outdir, 0755) && fsize(outdir) < 0) die("mkdir", outdir);
            if (jobs_index >= 0) {
                char tag[80]; if (cx_fmt(tag, sizeof tag, "final-net-%d", jobs_index)) die("phase", "final");
                long started = sy_now_ms(); int done = resume && ck_done(outdir, tag);
                final_proof(jobs_root, jobs_ctx, jobs_build, outdir, jobs_index, done);
                if (!done) mark(outdir, tag, sy_now_ms() - started);
                return 0;
            }
            return jobs_ok(jobs_root, jobs_ctx, jobs_build, outdir, resume);
        }
        int total = !strcmp(jobs_phase, "tool") ? cf_tool_count() : cf_net_count();
        if (strcmp(jobs_phase, "tool") && strcmp(jobs_phase, "gen") && strcmp(jobs_phase, "tbl") && strcmp(jobs_phase, "net")) die("REFUSE jobs phase", jobs_phase);
        select_nets(jobs_root);
        if (plan_only) { sy_printf("JOBS_PLAN\tphase=%s\taffected=%d\ttotal=%d\n", jobs_phase, ntouch ? nselected : cf_net_count(), cf_net_count()); return 0; }
        if (outdir && sy_mkdir(outdir, 0755) && fsize(outdir) < 0) die("mkdir", outdir);
        return wave_phase(outdir ? outdir : jobs_build, jobs_root, jobs_ctx, jobs_build, jobs_phase, total, resume);
    }
    if (plan_only) {
        plan();
        return 0;
    }
    if (!rev || !hex40(rev)) die("REFUSE --rev 40-hex required", rev);
    if (until_phase) {
        int u = lane_phase && !strcmp(lane_phase, until_phase), pi;
        for (pi = 0; pi < g_nphases; pi++) if (tx_eqz(g_phases[pi], until_phase)) u = 1;
        if (!u && !known_closure_phase(outdir, until_phase) && !known_front_phase(root, rev, until_phase)) die("REFUSE --until unknown phase; closure names require a prepared manifest", until_phase);
    }
    if (!outdir || !*outdir) die("REFUSE --out required", 0);
    jobs_segment_out = outdir;
    step_out = outdir;
    if (jobs_segment_end && (!resume || !until_phase || (strcmp(until_phase,"jobs-tool") && strcmp(until_phase,"jobs-gen") && strcmp(until_phase,"jobs-tbl") && strcmp(until_phase,"jobs-net")))) die("REFUSE jobs segment target", until_phase);
    if (sy_mkdir(outdir, 0755) && fsize(outdir) < 0) die("mkdir", outdir);
    if (recheck_only) {
        /* Only for the two phases that require it, only when everything before them is complete:
           the walk below then re-checks and cannot construct. */
        int limit = until_phase ? chain_phase_index(until_phase) : -1;
        if (!resume || lane_phase || ntouch || !until_phase || (!tx_eqz(until_phase, "compare") && !tx_eqz(until_phase, "pack")) || limit < 0)
            die("REFUSE --recheck-only needs --resume --until compare|pack", until_phase);
        for (int pi = 0; pi < limit; pi++) if (!ck_done(outdir, g_phases[pi])) die("REFUSE --recheck-only before an unfinished phase", g_phases[pi]);
    }
    chain_memo(until_phase, outdir);
    if (!lane_phase && uc_guard(root, outdir)) die("REFUSE unit cache active inside the chain", "uc_guard");
    if (!lane_phase) hb(outdir, "chain", "start");
    chain_paths(root, rev, snap);
    if (cx_fmt(build, sizeof build, "%s/build", outdir)) die("path", "build");
    if (cx_fmt(ctx, sizeof ctx, "%s/ctx", outdir)) die("path", "ctx");
    if (cx_fmt(routes, sizeof routes, "%s/routes", outdir)) die("path", "routes");
    if (cx_fmt(pkg, sizeof pkg, "%s/compiler.p4.pkg", outdir)) die("path", "pkg");
    if (cx_fmt(fp, sizeof fp, "%s/fixedpoint", outdir)) die("path", "fp");
    if (cx_fmt(gen1, sizeof gen1, "%s/gen1/lnx-x86_64/candidate", outdir)) die("path", "gen1");
    if (cx_fmt(helper, sizeof helper, "%s/identity-helper", ctx)) die("path", "helper");
    if (lane_phase) return run_lane(root, outdir, rev, snap, build, pkg, gen1, fp, helper, resume);

    sy_printf("CANDIDATE_CHAIN\trev=%s\tout=%s\tresume=%d\tparallel=%d\n", rev, outdir, resume, parallel);
    if (parallel > 1)
        sy_printf("G0b\tparallel=%d\tmac_B=serial\twrite_domains=per-target-dir\tderate=measured\n", parallel);

    if (!(resume && ck_done(outdir, "snap"))) preflight(root, "entry", rev, build, snap, pkg);
    if (!(resume && ck_done(outdir, "snap"))) {
        long t0 = sy_now_ms();
        char *a[4];
        a[0] = (char *)"snap"; a[1] = (char *)rev; a[2] = (char *)"out"; a[3] = 0;
        if (step(root, a)) die("snap", snap);
        mark(outdir, "snap", sy_now_ms() - t0);
    } else sy_printf("RESUME\tsnap\n");
    {
        char mid[4400];
        if (cx_fmt(mid, sizeof mid, "%s/out", snap)) die("path", "snap-out");
        if (sy_mkdir(mid, 0755) && fsize(mid) < 0) die("mkdir", mid);
        if (sy_mkdir(chain_work, 0755) && fsize(chain_work) < 0) die("mkdir", chain_work);
    }

    if (sy_mkdir(build, 0755) && fsize(build) < 0) die("mkdir", build);
    if (!boot || !boot[0]) {
        static char defboot[4400];
        if (cx_fmt(defboot, sizeof defboot, "%s/unisacc.com", root)) die("path", "defboot");
        if (fsize(defboot) < 0) die("REFUSE default bootstrap missing", defboot);
        boot = defboot;
        sy_printf("BOOTSTRAP_FROM\tdefault=%s\n", defboot);
    }
    if (boot && boot[0]) {
        char dst[4400];
        size_t bn = 0;
        char *bb;
        if (cx_fmt(dst, sizeof dst, "%s/Root41-bootstrap.com", build)) die("path", "boot");
        bb = cx_read(boot, &bn);
        if (!bb || install_if_changed(dst, bb, bn, 0755)) { free(bb); die("install bootstrap", dst); }
        free(bb);
        /* The epoch record travels with the product: ctx records its sha (bootstrap-build-record-sha)
           and source-wave refuses a list whose record changed, so install it before ctx, not after. */
        {   char srec[4400], drec[4400];
            if (cx_fmt(srec, sizeof srec, "%s.build.json", boot) || cx_fmt(drec, sizeof drec, "%s.build.json", dst)) die("path", "boot-record");
            bb = cx_read(srec, &bn);
            if (!bb || install_if_changed(drec, bb, bn, 0)) { free(bb); die("install bootstrap record", drec); }
            free(bb);
        }
        sy_printf("BOOTSTRAP\t%s\n", dst);
    }
    {   /* rule 6 (verify-snap) accepts a receipt commit other than REV only when BOOTSTRAP_FROM
           names it; snap_ok already accepts an ancestor, so declare it here the same way it does. */
        char js[4400], commit[41];
        size_t jn = 0;
        char *j;
        if (cx_fmt(js, sizeof js, "%s/unisacc.com.build.json", snap)) die("path", "json");
        j = cx_read(js, &jn);
        if (j && !json_quoted(j, jn, "commit", commit, 40) && !tx_eqz(commit, rev) && git_is_ancestor(commit, rev)) {
            if (sy_setenv("BOOTSTRAP_FROM", commit, 1)) { free(j); die("env", "BOOTSTRAP_FROM"); }
            sy_printf("BOOTSTRAP_FROM\tdeclared=%s\n", commit);
        }
        free(j);
    }
    preflight(root, "post-snap", rev, build, snap, pkg);

    /* ctx/identity-helper only exists after ctx (phase 5); the controller phases before it use
       the seed helper built from the same seed/ident.c, CC and flags under its own receipt, and
       ctx later refuses any controller receipt whose source_sha differs from its SID. */
    {
        char seed[4400];
        if (cx_fmt(seed, sizeof seed, "%s/identity-helper", build)) die("path", "seed helper");
        char *a[] = {"seed-helper", (char *)rev, snap, build, (char *)cc, 0};
        if (step(root, a)) die("seed-helper", seed);
        if (sy_setenv("UNISACC_IDENTITY_HELPER", seed, 1)) die("env", "controller identity helper");
    }
    /* Independent receipts recover child success before the outer mark. */
    if (!(resume && ck_done(outdir,"build-objects"))) {
        long t0=sy_now_ms();
        char *a[]={"build-objects",(char *)rev,snap,build,0};
        if(step(root,a))die("build-objects",build);
        mark(outdir,"build-objects",sy_now_ms()-t0);
    } else {sy_printf("RESUME\tbuild-objects\n");if(until_phase && !strcmp(until_phase,"build-objects"))exit(0);}
    /* The controller image no longer fits one 90 second phase from source: build-front stops at
       the bootstrap's phase checkpoint under its own receipt, build finishes from it. */
    if (!(resume && ck_done(outdir,"build-front"))) {
        long t0=sy_now_ms();
        char *a[]={"build-front",(char *)rev,snap,build,0};
        if(step(root,a))die("build-front",build);
        mark(outdir,"build-front",sy_now_ms()-t0);
    } else {sy_printf("RESUME\tbuild-front\n");if(until_phase && !strcmp(until_phase,"build-front"))exit(0);}
    if (!(resume && ck_done(outdir,"build"))) {
        long t0 = sy_now_ms();
        char *a[5];
        a[0] = (char *)"build"; a[1] = (char *)rev; a[2] = snap; a[3] = build; a[4] = 0;
        if (step(root, a)) die("build", build);
        mark(outdir,"build",sy_now_ms()-t0);
    } else {sy_printf("RESUME\tbuild\n");if(until_phase && !strcmp(until_phase,"build"))exit(0);}

    const char *wave_builds[]={"wave-objects","wave-runner"};
    for(int wi=0;wi<2;wi++){
        const char *tag=wave_builds[wi];
        if(!(resume && ck_done(outdir,tag))){
            long began=sy_now_ms();char *a[]={(char *)tag,(char *)rev,snap,build,0};
            if(step(root,a))die(tag,build);mark(outdir,tag,sy_now_ms()-began);
        }else {sy_printf("RESUME\t%s\n",tag);if(until_phase&&!strcmp(until_phase,tag))exit(0);}
    }
    if (!(resume && ck_done(outdir, "ctx"))) {
        long t0 = sy_now_ms();
        char *a[7];
        char context_record[4400];
        if(cx_fmt(context_record,sizeof context_record,"%s/context.tsv",ctx))die("path","context record");
        if(fsize(context_record)<0)clean_phase_path(outdir,"ctx",ctx,0);
        a[0] = (char *)"ctx"; a[1] = (char *)rev; a[2] = snap; a[3] = build; a[4] = ctx; a[5] = (char *)cc; a[6] = 0;
        if (step(root, a)) die("ctx", ctx);
        mark(outdir, "ctx", sy_now_ms() - t0);
    } else sy_printf("RESUME\tctx\n");

    if (!(resume && ck_done(outdir, "host"))) {
        long t0 = sy_now_ms();
        char *a[5];
        a[0] = (char *)"host"; a[1] = snap; a[2] = ctx; a[3] = build; a[4] = 0;
        if (step(root, a)) die("host", "host");
        mark(outdir, "host", sy_now_ms() - t0);
    } else sy_printf("RESUME\thost\n");

    if (!(resume && ck_done(outdir, "list"))) {
        long t0 = sy_now_ms();
        char *a[5];
        char louter[4400];
        if (cx_fmt(louter, sizeof louter, "%s/outer", build)) die("path", "louter");
        clean_phase_path(outdir, "list", louter, 0);
        a[0] = (char *)"list"; a[1] = snap; a[2] = ctx; a[3] = build; a[4] = 0;
        if (step(root, a)) die("list", "list");
        mark(outdir, "list", sy_now_ms() - t0);
    } else sy_printf("RESUME\tlist\n");

    if (!(resume && ck_done(outdir, "warmup"))) {
        long t0 = sy_now_ms();
        if (warmup_tools(root)) die("warmup", "compile");
        mark(outdir, "warmup", sy_now_ms() - t0);
    } else sy_printf("RESUME\twarmup\n");

    select_nets(snap);
    verify_segment_jobs(outdir,snap,ctx,build);
    if (ntouch || !(resume && ck_done(outdir, "jobs-tool"))) {
        long t0 = sy_now_ms();
        if (wave_phase(outdir, snap, ctx, build, "tool", cf_tool_count(), resume)) die("jobs-tool", "wave");
        mark(outdir, "jobs-tool", 0);
    } else sy_printf("RESUME\tjobs-tool\n");

    if (ntouch || !(resume && ck_done(outdir, "jobs-gen"))) {
        long t0 = sy_now_ms();
        if (wave_phase(outdir, snap, ctx, build, "gen", cf_net_count(), resume)) die("jobs-gen", "wave");
        mark(outdir, "jobs-gen", 0);
    } else sy_printf("RESUME\tjobs-gen\n");

    if (ntouch || !(resume && ck_done(outdir, "jobs-tbl"))) {
        long t0 = sy_now_ms();
        if (wave_phase(outdir, snap, ctx, build, "tbl", cf_net_count(), resume)) die("jobs-tbl", "wave");
        mark(outdir, "jobs-tbl", 0);
    } else sy_printf("RESUME\tjobs-tbl\n");

    if (ntouch || !(resume && ck_done(outdir, "jobs-net"))) {
        long t0 = sy_now_ms();
        if (wave_phase(outdir, snap, ctx, build, "net", cf_net_count(), resume)) die("jobs-net", "wave");
        mark(outdir, "jobs-net", 0);
    } else sy_printf("RESUME\tjobs-net\n");

    {
        int done = resume && ck_done(outdir, "final");
        if (jobs_ok(snap, ctx, build, outdir, resume)) die("final", "jobs");
        if (!done) mark(outdir, "final", 0);
        else sy_printf("RESUME\tfinal\tidentity-rechecked\n");
    }

    if (!(resume && ck_done(outdir, "routes"))) {
        long t0 = sy_now_ms();
        char jobs[4400];
        char *a[6];
        if (cx_fmt(jobs, sizeof jobs, "%s/jobs", ctx)) die("path", "jobs");
        {
            char kr[4400], aso[4400];
            if (cx_fmt(kr, sizeof kr, "%s/kernel-route", routes) || cx_fmt(aso, sizeof aso, "%s/kernel-route/asm-source/OUTPUT.s", routes)) die("path", "kr");
            clean_phase_path(outdir, "routes", aso, 0);
            clean_phase_path(outdir, "routes", kr, 0);
            clean_phase_path(outdir, "routes", routes, 0);
        }
        a[0] = (char *)"routes"; a[1] = (char *)rev; a[2] = snap; a[3] = jobs; a[4] = routes; a[5] = 0;
        if (step(root, a)) die("routes", routes);
        mark(outdir, "routes", sy_now_ms() - t0);
    } else sy_printf("RESUME\troutes\n");

    if (!(resume && ck_done(outdir, "p3"))) {
        long t0 = sy_now_ms();
        char nets[4400], rts[4400], srcpkg[4400], rbt[4400];
        char *v[16];
        int n = 0;
        if (snap_ok(snap, rev, helper)) die("snap", snap);
        if (cx_fmt(nets, sizeof nets, "%s/jobs", ctx)) die("path", "nets");
        if (cx_fmt(rts, sizeof rts, "%s/declaration/routes.tsv", routes)) die("path", "rts");
        if (cx_fmt(srcpkg, sizeof srcpkg, "%s/compiler.pkg", routes)) die("path", "srcpkg");
        if (cx_fmt(rbt, sizeof rbt, "%s/tools/release-build.cx", root)) die("path", "rb");
        {
            char ctor[4400], ch[65];
            size_t cn = 0; char *cb;
            if (cx_fmt(ctor, sizeof ctor, "%s/Root41-bootstrap.com", build)) die("path", "ctor");
            if (ctor_exec(ctor)) die("chmod ctor", ctor);
            if (sy_setenv("UNISACC_CTOR", ctor, 1)) die("env", "UNISACC_CTOR");
            cb = cx_read(ctor, &cn);
            if (!cb || sy_sha256_hex(cb, (long)cn, ch)) { free(cb); die("ctor sha", ctor); }
            free(cb);
            sy_printf("P3_CTOR\tpath=%s\tsha=%s\tbytes=%lu\n", ctor, ch, (unsigned long)cn);
            preflight(root, "pre-p3", rev, build, snap, pkg);
        }
        {
            char run[4400], phaseout[4400], stage[40], tag[80];
            if (cx_fmt(run, sizeof run, "%s/p3-run", outdir) || cx_fmt(phaseout, sizeof phaseout, "%s/compiler.p4.pkg", run)) die("path", "p3-run");
            if (sy_mkdir(run, 0755) && fsize(run) < 0) die("mkdir", run);
            for (int pi = 0; pi < cf_p3_count(); pi++) {
                if (cx_fmt(stage, sizeof stage, "%s", cf_p3_phase(pi))) die("phase", "p3");
                if (cx_fmt(tag, sizeof tag, "p3-%s", stage)) die("phase", "p3");
                if (resume && ck_done(outdir, tag)) {
                    sy_printf("RESUME\t%s\n", tag);
                    if (until_phase && tx_eqz(tag, until_phase)) exit(0);
                    continue;
                }
                char *a[] = {rbt, "--", "p3", snap, srcpkg, phaseout, "--nets", nets, "--routes", rts, "--phase", stage, "--run", run, 0};
                long started = sy_now_ms();
                if (bound_sh(root, a)) die(tag, run);
                mark(outdir, tag, sy_now_ms() - started);
            }
            size_t pn = 0; char *pb = cx_read(phaseout, &pn);
            if (!pb || !pn || cx_write(pkg, pb, pn)) { free(pb); die("p3 publish", pkg); }
            free(pb);
        }
        mark(outdir, "p3", 0);
    } else sy_printf("RESUME\tp3\n");
    preflight(root, "post-p3", rev, build, snap, pkg);

    if (!(resume && ck_done(outdir, "gen1-lnx-x86_64"))) {
        char gout[4400], p[4400], ctor[4400], ebt[4400], saved[4400];
        if (cx_fmt(p, sizeof p, "%s/gen1", outdir)) die("path", "g1d");
        if (cx_fmt(gout, sizeof gout, "%s/gen1/lnx-x86_64", outdir)) die("path", "g1");
        if (cx_fmt(ctor, sizeof ctor, "%s/Root41-bootstrap.com", build)) die("path", "ctor");
        if (cx_fmt(ebt, sizeof ebt, "%s/tools/entry-build.cx", snap)) die("path", "eb");
        sy_mkdir(p, 0755);
        if (sy_mkdir(gout, 0755) && fsize(gout) < 0) die("mkdir", gout);
        if (snap_ok(snap, rev, helper)) die("snap", snap);
        if (sy_setenv("UNISACC_CTOR", ctor, 1)) die("env", "UNISACC_CTOR");
        if (sy_setenv("UNISA_CONTAINER", pkg, 1)) die("env", "UNISA_CONTAINER");
        {
            size_t cn = 0; char *cb = cx_read(ctor, &cn), ch[65];
            if (!cb || sy_sha256_hex(cb, (long)cn, ch)) { free(cb); die("ctor sha", ctor); }
            free(cb);
            sy_printf("GEN1_CTOR\tpath=%s\tsha=%s\tbytes=%lu\tsource=c49-gen1-lnx-x86_64/receipt.txt\n", ctor, ch, (unsigned long)cn);
        }
        if (sy_realpath(".", saved, sizeof saved) < 0) die("cwd", ".");
        if (sy_chdir(snap)) die("chdir", snap);
        gen1_entry(outdir, snap, ctor, ebt, pkg, gout, "lnx/x86_64", "gen1-lnx-x86_64", resume);
        if (sy_chdir(saved)) die("chdir", saved);
    } else sy_printf("RESUME\tgen1-lnx-x86_64\n");

    if (!(resume && ck_done(outdir, "gen1-lnx-arm64"))) {
        char gout[4400], p[4400], ctor[4400], ebt[4400], saved[4400];
        if (cx_fmt(p, sizeof p, "%s/gen1", outdir)) die("path", "g1d");
        if (cx_fmt(gout, sizeof gout, "%s/gen1/lnx-arm64", outdir)) die("path", "g1a");
        if (cx_fmt(ctor, sizeof ctor, "%s/Root41-bootstrap.com", build)) die("path", "ctor");
        if (cx_fmt(ebt, sizeof ebt, "%s/tools/entry-build.cx", snap)) die("path", "eb");
        sy_mkdir(p, 0755);
        if (sy_mkdir(gout, 0755) && fsize(gout) < 0) die("mkdir", gout);
        if (snap_ok(snap, rev, helper)) die("snap", snap);
        if (sy_setenv("UNISACC_CTOR", ctor, 1)) die("env", "UNISACC_CTOR");
        if (sy_setenv("UNISA_CONTAINER", pkg, 1)) die("env", "UNISA_CONTAINER");
        if (sy_realpath(".", saved, sizeof saved) < 0) die("cwd", ".");
        if (sy_chdir(snap)) die("chdir", snap);
        gen1_entry(outdir, snap, ctor, ebt, pkg, gout, "lnx/arm64", "gen1-lnx-arm64", resume);
        if (sy_chdir(saved)) die("chdir", saved);
    } else sy_printf("RESUME\tgen1-lnx-arm64\n");

    if (!(resume && ck_done(outdir, "wf-prepare"))) {
        long t0 = sy_now_ms();
        char wft[4400], objs[4400], nout[4400], ctor[4400], tmpl[4400];
        char *v[16];
        int n = 0;
        if (cx_fmt(wft, sizeof wft, "%s/tools/whole-front.cx", root)) die("path", "wf");
        if (cx_fmt(objs, sizeof objs, "%s/gen1/lnx-x86_64", outdir)) die("path", "objs");
        if (cx_fmt(nout, sizeof nout, "%s/wf-prep", chain_work)) die("path", "wfp");
        {
            char wrc[4400];
            if (cx_fmt(wrc, sizeof wrc, "%s/receipt.txt", nout)) die("path", "wrc");
            clean_phase_path(outdir, "wf-prepare", nout, wrc);
        }
        if (cx_fmt(ctor, sizeof ctor, "%s/gen1/lnx-x86_64/candidate", outdir)) die("path", "wctor");
        if (cx_fmt(tmpl, sizeof tmpl, "%s/tools/templates/whole-front.cx.in", root)) die("path", "tmpl");
        check_whole_front_template(tmpl);
        if (sy_setenv("UNISACC_IDENTITY_HELPER", helper, 1)) die("env", "helper");
        {
            char rec[4400], saved[4400];
            if (cx_fmt(rec, sizeof rec, "%s/receipt.txt", nout) || fsize(rec) < 0) {
                v[n++] = wft; v[n++] = (char *)"--";
                v[n++] = (char *)"prepare"; v[n++] = snap; v[n++] = pkg; v[n++] = ctor; v[n++] = objs; v[n++] = nout;
                v[n++] = (char *)"--template"; v[n++] = tmpl; v[n++] = 0;
                if (sy_realpath(".", saved, sizeof saved) < 0) die("cwd", ".");
                if (sy_chdir(snap)) die("chdir", snap);
                n = bound_sh_secs(root, v, cc_lim("cmd.front", 0));
                if (sy_chdir(saved)) die("chdir", saved);
                if (n) die("wf-prepare", nout);
            } else sy_printf("WF_PREP_EXISTING\t%s\n", rec);
        }
        mark(outdir, "wf-prepare", sy_now_ms() - t0);
        {
            char wo[4400];
            if (cx_fmt(wo, sizeof wo, "%s/worker.o", nout)) die("path", "wo");
            worker_nm_ok(wo);
        }
    } else sy_printf("RESUME\twf-prepare\n");

    if (wf_fronts(root, outdir, helper, 1, "osx/x86_64", "osx-x86_64", 1)) die("osx-x86_64", outdir);
    {
        char objs[4400];
        if (cx_fmt(objs, sizeof objs, "%s/gen1/lnx-x86_64", outdir)) die("path", "wobjs");
        if (wf_span_prep(root, outdir, helper, 1, snap, pkg, gen1, objs)) die("wf-span-prep", objs);
    }
    if (wf_mac_b(root, outdir, helper, 1, "osx/x86_64", "osx-x86_64")) die("osx-x86-b2", outdir);
    if (wf_fronts(root, outdir, helper, 1, "osx/arm64", "osx-arm64", 1)) die("osx-arm64", outdir);
    if (wf_mac_b(root, outdir, helper, 1, "osx/arm64", "osx-arm64")) die("osx-arm-b2", outdir);
    if (wf_fronts(root, outdir, helper, 1, "win/x86_64", "win-x86_64", 0)) die("win-x86_64", outdir);
    if (wf_win_span(root, outdir, helper, 1, "win/x86_64", "win-x86_64")) die("win-x86_64-span", outdir);
    if (wf_fronts(root, outdir, helper, 1, "win/arm64", "win-arm64", 0)) die("win-arm64", outdir);
    if (wf_win_span(root, outdir, helper, 1, "win/arm64", "win-arm64")) die("win-arm64-span", outdir);

    if (!ck_done(outdir, "gen1-osx-x86_64") || !ck_done(outdir, "gen1-osx-arm64")
        || !ck_done(outdir, "gen1-win-x86_64") || !ck_done(outdir, "gen1-win-arm64"))
        die("REFUSE gen1 six slices incomplete", "Y0-SETPGID-REGRESSION: do not patch worker; scene kept");

    run_g2_lnx(root, outdir, rev, snap, pkg, gen1, fp, helper, "lnx/x86_64", "lnx-x86_64", 2, resume);
    run_g2_lnx(root, outdir, rev, snap, pkg, gen1, fp, helper, "lnx/arm64", "lnx-arm64", 2, resume);
    run_g2_lnx(root, outdir, rev, snap, pkg, gen1, fp, helper, "lnx/x86_64", "lnx-x86_64", 3, resume);
    run_g2_lnx(root, outdir, rev, snap, pkg, gen1, fp, helper, "lnx/arm64", "lnx-arm64", 3, resume);

    if (!(resume && ck_done(outdir, "kernels-g2"))) {
        long t0 = sy_now_ms();
        char *a[11];
        a[0] = (char *)"fixedpoint"; a[1] = (char *)rev; a[2] = snap; a[3] = pkg; a[4] = gen1; a[5] = fp;
        a[6] = (char *)"--phase"; a[7] = (char *)"kernels-g2"; a[8] = (char *)"--identity-helper"; a[9] = helper; a[10] = 0;
        kernels_scrub(outdir, fp, 2);
        if (step(root, a)) die("kernels-g2", fp);
        mark(outdir, "kernels-g2", sy_now_ms() - t0);
    } else sy_printf("RESUME\tkernels-g2\n");

    if (!(resume && ck_done(outdir, "kernels-g3"))) {
        long t0 = sy_now_ms();
        char *a[11];
        a[0] = (char *)"fixedpoint"; a[1] = (char *)rev; a[2] = snap; a[3] = pkg; a[4] = gen1; a[5] = fp;
        a[6] = (char *)"--phase"; a[7] = (char *)"kernels-g3"; a[8] = (char *)"--identity-helper"; a[9] = helper; a[10] = 0;
        kernels_scrub(outdir, fp, 3);
        if (step(root, a)) die("kernels-g3", fp);
        mark(outdir, "kernels-g3", sy_now_ms() - t0);
    } else sy_printf("RESUME\tkernels-g3\n");

    {   /* P2: g2 四个 Mac/Win 目标,再 g3 四个;每目标一个相位,Mac B 在 wf_mac_b 内串行 */
        int pg, pt;
        for (pg = 2; pg <= 3; pg++)
            for (pt = 0; pt < 4; pt++)
                gen_slice_phase(root, outdir, helper, rev, snap, pkg, gen1, fp, pg, pt, resume);
    }

    /* From here on nothing may rest on the memo: compare and pack are full re-checks. */
    recheck_leave(outdir, "compare");
    if (!sm_enabled() || !until_phase || !tx_eqz(until_phase, "pack")) chain_memo_off("reached-compare");
    if (!(resume && ck_done(outdir, "compare"))) {
        long t0 = sy_now_ms();
        char *a[11];
        a[0] = (char *)"fixedpoint"; a[1] = (char *)rev; a[2] = snap; a[3] = pkg; a[4] = gen1; a[5] = fp;
        a[6] = (char *)"--phase"; a[7] = (char *)"compare"; a[8] = (char *)"--identity-helper"; a[9] = helper; a[10] = 0;
        if (step(root, a)) die("compare", fp);
        mark(outdir, "compare", sy_now_ms() - t0);
    } else sy_printf("RESUME\tcompare\n");

    recheck_leave(outdir, "pack");
    chain_memo_off("reached-pack");
    if (!(resume && ck_done(outdir, "pack"))) {
        long t0 = sy_now_ms();
        char ape_tool[4400], packed[4400], win64[4400], lnx64[4400], lnxarm[4400], osx64[4400], osxarm[4400], winarm[4400];
        char *v[24];
        int n = 0;
        if (!cm64 || !cmarm) die("REFUSE pack needs --cache-manager-osx X64 ARM64 (borrowed until in-chain)", 0);
        if (cx_fmt(ape_tool, sizeof ape_tool, "%s/tools/release-ape.cx", root)) die("path", "ape");
        if (cx_fmt(packed, sizeof packed, "%s/ape-final", outdir)) die("path", "packed");
        if (pack_slice(win64, sizeof win64, "win-x86_64")) die("path", "w64");
        if (cx_fmt(lnx64, sizeof lnx64, "%s/fixedpoint/g3/lnx-x86_64/entry.elf", outdir)) die("path", "l64");
        if (cx_fmt(lnxarm, sizeof lnxarm, "%s/fixedpoint/g2/lnx-arm64/entry.elf", outdir)) die("path", "larm");
        if (pack_slice(osx64, sizeof osx64, "osx-x86_64")) die("path", "o64");
        if (pack_slice(osxarm, sizeof osxarm, "osx-arm64")) die("path", "oarm");
        if (pack_slice(winarm, sizeof winarm, "win-arm64")) die("path", "warm");
        if (fsize(win64) < 0 || fsize(lnx64) < 0 || fsize(osx64) < 0) die("pack missing slice", win64);
        sy_mkdir(packed, 0755);
        if (chdir(snap)) die("chdir snap for pack version", snap);
        v[n++] = ape_tool; v[n++] = (char *)"--";
        v[n++] = (char *)"pack"; v[n++] = (char *)"--cache-manager-osx"; v[n++] = (char *)cm64; v[n++] = (char *)cmarm;
        v[n++] = packed; v[n++] = pkg; v[n++] = win64; v[n++] = lnx64; v[n++] = lnxarm;
        v[n++] = osx64; v[n++] = osxarm; v[n++] = winarm; v[n++] = 0;
        if (bound_sh_secs(root, v, cc_pb())) die("pack", packed);
        if (chdir(root)) die("chdir root", root);
        mark(outdir, "pack", sy_now_ms() - t0);
    } else sy_printf("RESUME\tpack\n");

    sy_printf("CANDIDATE_CHAIN\tstatus=PREPARED\tnot=PASS\trev=%s\n", rev);
    return 0;
}
