/* tools/check-precommit-toolsloc.cx -- real indexed hook checks, in independent bounded batches.
 * Run --loc, --source and --symlink separately; every batch uses its own real git repository.
 * The real hook still runs the complete real ratchets from the caller's repository.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
static int npass,nfail;
static char hook[300];
static void ck(int ok,const char *n){printf("%s\t%s\n",ok?"PASS":"FAIL",n);if(ok)npass++;else nfail++;}
static int fixture_run(char **v,const char *cwd){
    np_result r; char why[400]; int ok;
    if(np_run(v,cwd,0,40,&r,why,sizeof why)){fprintf(stderr,"fixture command %s in %s: %s\n",v[0],cwd,why);return 0;}
    ok=r.rc==0;
    if(!ok){fprintf(stderr,"fixture command in %s (rc=%d):",cwd,r.rc);for(int i=0;v[i];i++)fprintf(stderr," %s",v[i]);fprintf(stderr,"\n");if(r.errn)fwrite(r.err,1,r.errn,stderr);}
    np_free(&r); return ok;
}
static int fixture_write(const char *td,const char *name,const char *text){
    char path[500]; FILE *f;
    if(cx_fmt(path,sizeof path,"%s/%s",td,name)) return 0;
    f=fopen(path,"wb"); if(!f) return 0;
    {int ok=fputs(text,f)>=0; return fclose(f)==0&&ok;}
}
static void fixture_hook(const char *td,int rc,const char *text,const char *label,const char *forbidden){
    char gd[500],why[400]; np_result r; char *p[]={hook,0};
    if(cx_fmt(gd,sizeof gd,"%s/.git",td)){ck(0,label);return;}
    setenv("GIT_DIR",gd,1); setenv("GIT_WORK_TREE",td,1);
    if(np_run(p,".",0,40,&r,why,sizeof why)){ck(0,label);if(forbidden)ck(0,"retired-baseline-diagnostic-absent");}
    else {
        int good=(r.rc==rc)&&(!text||(r.errn&&strstr(r.err,text)));
        ck(good,label);
        if(!good&&r.errn)fwrite(r.err,1,r.errn,stderr);
        if(forbidden)ck(!r.errn||!strstr(r.err,forbidden),"retired-baseline-diagnostic-absent");
        np_free(&r);
    }
    unsetenv("GIT_DIR"); unsetenv("GIT_WORK_TREE");
}
static int stage(const char *td,const char *name){char *v[]={"git","add","--",(char *)name,0};return fixture_run(v,td);}
/* Keep the indexed registrations real; each added ordinary tool has its own check entry. */
static int fixture_registry(const char *td,int shebang,int newtool){
    char batches[5000],coverage[2000];
    const char *bh="id\timplementation\tlayer\tsource\tmode\tplatform\tbudget_seconds\tmaterials\tentry\targs\tcoverage\texpect\theaders\n";
    const char *ch="id\tlayer\timplementation\texpected_or_gap\tsource\n";
    if(cx_fmt(batches,sizeof batches,"%ssource\tIMPLEMENTED\tinterfaces\ttools/check-source.cx\tSOURCE\tlnx/x86_64\t10\t-\ttools/check-source.cx\t-\tinterfaces.source\trc0:FIXTURE_CHECK\tproduct\n%s%s",bh,
        shebang?"shebang\tIMPLEMENTED\tinterfaces\ttools/check-_cx_shebang.cx\tSOURCE\tlnx/x86_64\t10\t-\ttools/check-_cx_shebang.cx\t-\tinterfaces.shebang\trc0:FIXTURE_CHECK\tproduct\n":"",
        newtool?"new\tIMPLEMENTED\tinterfaces\ttools/check-new.cx\tSOURCE\tlnx/x86_64\t10\t-\ttools/check-new.cx\t-\tinterfaces.new\trc0:FIXTURE_CHECK\tproduct\n":""))return 0;
    if(cx_fmt(coverage,sizeof coverage,"%sinterfaces.source\tinterfaces\tIMPLEMENTED_SEPARATE_BATCH\tfixture source\ttools/source.cx tools/check-source.cx\n%s%s",ch,
        shebang?"interfaces.shebang\tinterfaces\tIMPLEMENTED_SEPARATE_BATCH\tfixture shebang\ttools/_cx_shebang.cx tools/check-_cx_shebang.cx\n":"",
        newtool?"interfaces.new\tinterfaces\tIMPLEMENTED_SEPARATE_BATCH\tfixture new\ttools/new.cx tools/check-new.cx\n":""))return 0;
    return fixture_write(td,"tests/batches.tsv",batches)&&fixture_write(td,"tests/coverage.tsv",coverage)&&stage(td,"tests");
}
static void fixture(const char *mode){
    char td[200],path[500]; int ok;
    if(cx_fmt(td,sizeof td,"%s/pc-link-XXXXXX",getenv("TMPDIR")?getenv("TMPDIR"):"/tmp")||!mkdtemp(td)){ck(0,"symlink-fixture-create");return;}
    {char *v[]={"git","init","-q",0};ok=fixture_run(v,td);}
    {char *v[]={"mkdir","tools","tests",0};ok=fixture_run(v,td)&&ok;}
    ok=fixture_write(td,"tools/source.cx","int x;")&&ok;
    ok=fixture_write(td,"tools/check-source.cx","int main(void){printf(\"FIXTURE_CHECK\\n\");return 0;}\n")&&ok;
    ok=fixture_write(td,"tests/toolsloc.tsv","TOTAL\t1\n")&&fixture_registry(td,0,0)&&ok;
    if(cx_fmt(path,sizeof path,"%s/tools/alias.cx",td)||symlink("source.cx",path)) ok=0;
    ok=stage(td,"tools")&&ok;
    ck(ok,"symlink-fixture-real-index");
    if(ok&&strcmp(mode,"--loc")==0){
        ok=fixture_write(td,"tools/source.cx","int x;\nint y;\n")&&stage(td,"tools/source.cx");
        ck(ok,"over-historical-baseline-real-index");
        if(ok)fixture_hook(td,0,0,"over-historical-baseline-not-blocked","先写基线+理由");
    }
    if(ok&&strcmp(mode,"--source")==0){
        ok=fixture_write(td,"tools/_untracked_huge.cx","int untracked;\n");
        if(ok){FILE *f;cx_fmt(path,sizeof path,"%s/tools/_untracked_huge.cx",td);f=fopen(path,"ab");if(f){for(int k=0;k<400;k++)fputs("int x;\n",f);ok=fclose(f)==0;}else ok=0;}
        ck(ok,"untracked-huge-fixture-write");
        if(ok)fixture_hook(td,0,0,"untracked-huge-not-gated",0);
        ok=fixture_write(td,"tools/_bash_fake.cx","#!/usr/bin/env bash\necho x\n")&&stage(td,"tools/_bash_fake.cx");
        ck(ok,"bash-fake-real-index");
        if(ok)fixture_hook(td,1,".cx 只放 cx 源码","bash-fake-cx-refused",0);
        {char *v[]={"git","rm","-f","-q","--","tools/_bash_fake.cx",0};ok=fixture_run(v,td);}
        ok=fixture_write(td,"tools/_cx_shebang.cx","#!/usr/bin/env unisacc.com -run\nint main(void){return 0;}\n")&&stage(td,"tools/_cx_shebang.cx")&&ok;
        ok=fixture_write(td,"tools/check-_cx_shebang.cx","int main(void){printf(\"FIXTURE_CHECK\\n\");return 0;}\n")&&stage(td,"tools/check-_cx_shebang.cx")&&fixture_registry(td,1,0)&&ok;
        ck(ok,"unisacc-shebang-checked-registered-real-index");
        if(ok)fixture_hook(td,0,0,"unisacc-shebang-allowed",0);else ck(0,"unisacc-shebang-allowed");
    }
    if(ok&&strcmp(mode,"--symlink")==0){
        fixture_hook(td,0,0,"symlink-alias-without-separate-check-allowed-no-final-lf",0);
        ok=fixture_write(td,"tools/source.cx","int x;\nint y;\n");
        ck(ok,"symlink-fixture-worktree-write");
        if(ok)fixture_hook(td,0,0,"unstaged-regular-growth-not-gated",0);
        ok=fixture_write(td,"tools/new.cx","int z;\n")&&stage(td,"tools/new.cx");
        ck(ok,"new-tool-without-check-real-index");
        if(ok)fixture_hook(td,1,"missing check-*.cx","new-tool-without-check-and-registration-refused",0);
        ok=fixture_write(td,"tools/check-new.cx","int main(void){printf(\"FIXTURE_CHECK\\n\");return 0;}\n")&&stage(td,"tools/check-new.cx");
        ck(ok,"new-tool-with-check-real-index");
        if(ok)fixture_hook(td,1,"check missing batch registration","new-tool-with-check-without-registration-refused",0);
        ok=fixture_registry(td,0,1);
        ck(ok,"new-tool-check-batch-real-index");
        if(ok)fixture_hook(td,0,0,"new-checked-registered-tool-allowed",0);
    }
    {char *v[]={"rm","-rf","--",td,0};ck(fixture_run(v,"."),"symlink-fixture-cleanup");}
}
int main(int argc,char **argv){
    char td[200];
    if(argc!=2||(strcmp(argv[1],"--loc")&&strcmp(argv[1],"--source")&&strcmp(argv[1],"--symlink"))){fprintf(stderr,"usage: check-precommit-toolsloc --loc | --source | --symlink (run all three batches)\n");return 2;}
    if(cx_fmt(td,sizeof td,"%s/pc-ts-XXXXXX",getenv("TMPDIR")?getenv("TMPDIR"):"/tmp")||!mkdtemp(td))return 2;
    if(cx_fmt(hook,sizeof hook,"%s/precommit",td))return 2;
    {char *v[]={"sh","./unisacc.com","tools/precommit.cx","-o",hook,0};int ok=fixture_run(v,".");ck(ok,"build-real-precommit-once");if(!ok)return 2;}
    fixture(argv[1]);
    unlink(hook);rmdir(td);
    printf("PRECOMMIT_TOOLSLOC\tbatch=%s\tpass=%d\tfail=%d\n",argv[1],npass,nfail);
    return nfail?1:0;
}
