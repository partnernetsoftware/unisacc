        if(ok)BOUND(14,td,0,0,"unisacc-shebang-allowed",0);else ck(0,"unisacc-shebang-allowed"); ok=fixture_write(td,"tests/batches.tsv","id\timplementation\tlayer\tsource\tmode\tplatform\tbudget_seconds\tmaterials\tentry\targs\tcoverage\texpect\theaders\ncli\tIMPLEMENTED\tinterfaces\ttools/_cx_shebang.cx\tSOURCE\tlnx/x86_64\t45\t-\ttools/other.cx\t-\tfixture.cli\trc0\tproduct\ncheck\tIMPLEMENTED\tinterfaces\ttools/check-_cx_shebang.cx\tSOURCE\tlnx/x86_64\t45\t-\ttools/other.cx\t-\tfixture.check\trc0\tproduct\n")&&stage(td,"tests/batches.tsv")&&ok; if(ok)BOUND(15,td,0,0,"source-only-registration-allowed",0);else ck(0,"source-only-registration-allowed"); ok=fixture_write(td,"tests/batches.tsv","id\timplementation\tlayer\tsource\tmode\tplatform\tbudget_seconds\tmaterials\tentry\targs\tcoverage\texpect\theaders\ncli\tIMPLEMENTED\tinterfaces\ttools/other.cx\tSOURCE\tlnx/x86_64\t45\t-\ttools/_cx_shebang.cx\t-\tfixture.cli\trc0\tproduct\ncheck\tIMPLEMENTED\tinterfaces\ttools/other.cx\tSOURCE\tlnx/x86_64\t45\t-\ttools/check-_cx_shebang.cx\t-\tfixture.check\trc0\tproduct\n")&&stage(td,"tests/batches.tsv")&&ok; if(ok)BOUND(16,td,0,0,"entry-only-registration-allowed",0);else ck(0,"entry-only-registration-allowed");
