int main(int argc,char **argv){
    char td[200];
    target=-1;if(argc==2)for(int i=0;i<(int)(sizeof modes/sizeof modes[0]);i++)if(!strcmp(argv[1],modes[i]))target=i;if(target<0){fprintf(stderr,"usage: check-precommit-toolsloc MODE (run every registered boundary separately)\n");return 2;}
    /* Fixture git commands select their own cwd/index, even under commit-own. */
    unsetenv("GIT_DIR");unsetenv("GIT_WORK_TREE");unsetenv("GIT_INDEX_FILE");
    if(cx_fmt(td,sizeof td,"%s/pc-ts-XXXXXX",getenv("TMPDIR")?getenv("TMPDIR"):"/tmp")||!mkdtemp(td))return 2;
    if(cx_fmt(hook,sizeof hook,"%s/precommit",td))return 2;
    {char *v[]={"sh","./unisacc.com","tools/precommit.cx","-o",hook,0};int ok=fixture_run(v,".");ck(ok,"build-real-precommit-once");if(!ok)return 2;}
    fixture();
    unlink(hook);rmdir(td);
    printf("PRECOMMIT_TOOLSLOC\tbatch=%s\tpass=%d\tfail=%d\n",argv[1],npass,nfail);
    return nfail?1:0;
}
