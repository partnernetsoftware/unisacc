/* tools/check-qsort-intro.cx -- include/stdlib.h qsort (introsort with heap sort fallback) correctness.
 *
 *   sh ./unisacc.com tools/check-qsort-intro.cx [-- ROOT]
 *
 * Compiles tests/qsort-intro/prog.c with the product, `-I ROOT/include`: an explicit -I directory is
 * searched before the embedded table (see check-include-shadow.cx observation 6), so <stdlib.h> is the
 * WORKSPACE header, not the product's embedded copy (which stays the old heap sort until the product is
 * rebuilt).  The auto trim closure is computed from the embedded header's table, which does not know the
 * new helper names, so the compile also passes -D__UNISA_FTRIM_LIBC=0 (untrimmed header).  prog.c fails to
 * compile on a header without _unisa_qintro, so a silently ignored -I cannot pass.
 * prog.c runs sizes 1,2,3,4,5,7,8,12,16,24,33,100 x nmemb 0..64 x 9 input distributions x 3 base
 * alignments, large n (300/1000/5000/20000), n0/n1/sz0, and the McIlroy quicksort adversary, each
 * against a merge-sort reference on keys plus an order-free whole-element multiset hash and bounds checks.
 * This tool relays the PASS/FAIL lines and counts them. */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.sig
#pragma unisa use text.text
#pragma unisa use mem.heap
static void die(const char *s) { sy_eprintf("check-qsort-intro: REFUSE %s\n", s); sy_exit(2); }

static int starts(const char *s, long n, const char *p) {
    long i, pl = tx_len(p, 64);
    if (n < pl) return 0;
    for (i = 0; i < pl; i = i + 1) if (s[i] != p[i]) return 0;
    return 1;
}

int main(int argc, char **argv) {
    char root[4096], com[4400], bound[4400], inc[4400], src[4400], img[4400], work[4400], dopt[64];
    char *v[16]; char why[512];
    np_result r;
    long i, ls, npass = 0, nfail = 0, total = -1;
    int i2;
    if (argc >= 2 && (tx_len(argv[1], 4400) == 0 || argv[1][0] != '/')) die("root");
    if (argc >= 2) { if (tx_copy(root, 4096, argv[1], tx_len(argv[1], 4096))) die("root"); }
    else if (sy_cwd(root, 4096) < 0) die("cwd");
    if (cx_fmt(com, sizeof com, "%s/unisacc.com", root)) die("com");
    if (cx_fmt(bound, sizeof bound, "%s/tools/bound", root)) die("bound");
    if (cx_fmt(inc, sizeof inc, "%s/include", root)) die("inc");
    if (cx_fmt(src, sizeof src, "%s/tests/qsort-intro/prog.c", root)) die("src");
    if (sy_mkdtemp(sy_tmpdir(), "cqi-", work, (int)sizeof work)) die("work");
    if (cx_fmt(img, sizeof img, "%s/prog.img", work)) die("img");
    if (cx_fmt(dopt, sizeof dopt, "-D__UNISA_FTRIM_LIBC=0")) die("dopt");

    i2 = 0;
    v[i2++] = bound; v[i2++] = "50"; v[i2++] = com;
    v[i2++] = "-b"; v[i2++] = "lnx/x86_64";
    v[i2++] = dopt; v[i2++] = "-I"; v[i2++] = inc;
    v[i2++] = "-o"; v[i2++] = img; v[i2++] = src; v[i2] = 0;
    if (np_run(v, root, 0, 55, &r, why, sizeof why)) die(why);
    if (r.rc != 0) {
        printf("FAIL\tcompile-with-workspace-header\n");
        if (r.err) printf("%.*s\n", (int)(r.errn > 600 ? 600 : r.errn), r.err);
        printf("QSORT_INTRO\tFAIL compile rc=%d\n", r.rc);
        np_free(&r);
        return 1;
    }
    np_free(&r);
    printf("PASS\tcompile-with-workspace-header\n");
    npass = 1;

    v[0] = bound; v[1] = "50"; v[2] = img; v[3] = 0;
    if (np_run(v, root, 0, 55, &r, why, sizeof why)) die(why);
    ls = 0;
    for (i = 0; i <= (long)r.outn; i = i + 1) {
        if (i == (long)r.outn || r.out[i] == '\n') {
            const char *l = r.out + ls; long n = i - ls;
            if (starts(l, n, "PASS\t")) { npass = npass + 1; printf("%.*s\n", (int)n, l); }
            else if (starts(l, n, "FAIL\t") || starts(l, n, "# bad")) { nfail = nfail + 1; printf("%.*s\n", (int)n, l); }
            else if (starts(l, n, "TOTAL\t")) { long k; total = 0; for (k = 6; k < n && l[k] >= '0' && l[k] <= '9'; k = k + 1) total = total * 10 + (l[k] - '0'); }
            ls = i + 1;
        }
    }
    if (r.rc != 0) nfail = nfail + 1;
    if (total < 20) nfail = nfail + 1;
    printf("QSORT_INTRO\t%s assertions=%ld failed=%ld prog_total=%ld prog_rc=%d\n", nfail ? "FAIL" : "PASS", npass + nfail, nfail, total, r.rc);
    np_free(&r);
    return nfail ? 1 : 0;
}
