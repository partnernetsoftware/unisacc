/* tools/opt-corpus-gen.cx -- optimization matrix corpus/closure/CLI cells (tests/optimization-domain-matrix.tsv) with
 * literal and classic-reference-differential oracles.
 *   sh ./unisacc.com tools/opt-corpus-gen.cx -- ROOT ABS_OUT GROUP [REF]
 * GROUP (each stays under the 60 s rule; a compile costs about 0.13 s):
 *   corpus-N : one program each (a compile costs about 0.35 s; 72 product + 72 reference compiles per program):
 *              0 corpus.int64-edges, 1 corpus.float-double, 2 corpus.calls-abi, 3 corpus.switch-dense,
 *              4 corpus.pointer-memory, 5 corpus.large-frame, 6 corpus.multi-tu, 7 corpus.varargs,
 *              8 corpus.deep-recursion, 9 corpus.float-mixed (e4.sem.corpus-breadth)
 *   closure  : closure.reference-tape (product -O1/-O2 -S tape == REF tape, whole corpus), default.native-image
 *              (no-flag image == -O0 image bytes and executes to the literal)
 *   cli      : refusal.other-spellings (-Og, -Ofast, -O-1, -O4, -O5: named refusal, rc 1, no image); REF's behaviour
 *              on the same spellings is recorded as INFO (measured 2026-10-28: the classic reference accepts them silently)
 * Per corpus program and each of the six flags (-O0 -O1 -O -O2 -O3 -Os): the lnx/x86_64 image executes to the
 * hand-derived literal (stdout and exit code), and with REF the product image equals the reference image byte for
 * byte on all six targets (the arm64/osx/win encodings). Non-vacuity guard per program: the -O0 tape differs from the
 * -O2 tape, else VACUOUS. REF is the classic reference (`make ref` from the frozen export); without it the six-target
 * rows are UNVERIFIED and only the lnx execution is asserted. determinism.repeat-bytes and closure.o2-idempotence are
 * the same observations as tools/properties-cases-gen.cx det/meta and are not repeated here.
 * Programs are UB-free C99 (no signed overflow, no shifts of negative values beyond implementation-defined >>). */
#pragma unisa use cxlib.netpack

static char root[4096], outdir[4096], work[4200], bound[4400], product[4400], ref[4096];
static FILE *res; static int npass, nfail, nvac, nnotrun;
static void die(const char *s) { fprintf(stderr, "opt-corpus: REFUSE %s errno=%d\n", s, errno); exit(2); }
static void path(char *p, size_t cap, const char *a, const char *b) { int n = snprintf(p, cap, "%s/%s", a, b); if (n < 0 || (size_t)n >= cap) die("path"); }
static void saved(const char *p, const char *s, size_t n) { int f = open(p, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600); if (f < 0) die("exclusive create"); while (n) { ssize_t k = write(f, s, n); if (k <= 0) die("write"); s += k; n -= (size_t)k; } if (close(f)) die("close"); }
static int shafile(const char *p, char h[65]) { size_t n; char *s = cx_read(p, &n); if (!s) { if (errno != ENOENT) die("read for digest"); return 0; } cx_sha256_hex(s, n, h); free(s); return 1; }
static int same_file(const char *a, const char *b) { size_t na, nb; char *x = cx_read(a, &na), *y = cx_read(b, &nb); int ok = x && y && na == nb && !memcmp(x, y, na); free(x); free(y); return ok; }
static void row(const char *state, const char *cell, const char *label, const char *detail) { fprintf(res, "%s\t%s\t%s\t%s\n", state, cell, label, detail); if (!strcmp(state, "PASS")) npass++; else if (!strcmp(state, "FAIL")) nfail++; else if (!strcmp(state, "VACUOUS")) nvac++; else if (!strcmp(state, "NOT_RUN")) nnotrun++; }
static void check(int ok, const char *cell, const char *label, const char *detail) { row(ok ? "PASS" : "FAIL", cell, label, detail); }
static int run(char *const argv[], int secs, np_result *r) { char why[1024]; char *v[64]; int n = 0; v[n++] = bound; char s[16]; snprintf(s, sizeof s, "%d", secs); v[n++] = s; for (int i = 0; argv[i]; i++) { if (n >= 62) die("argv bound"); v[n++] = argv[i]; } v[n] = 0; char *env[] = { 0 }; return np_run(v, root, env, secs + 2, r, why, sizeof why); }
static const char *targets[6] = { "lnx/x86_64", "lnx/arm64", "osx/x86_64", "osx/arm64", "win/x86_64", "win/arm64" };
static const char *tslug[6] = { "lnx-x86_64", "lnx-arm64", "osx-x86_64", "osx-arm64", "win-x86_64", "win-arm64" };
static const char *flags[6] = { "-O0", "-O1", "-O", "-O2", "-O3", "-Os" };
static const char *fslug[6] = { "O0", "O1", "O", "O2", "O3", "Os" };

typedef struct { const char *cell, *name, *src, *src2, *stdout_want; int exit_want; } Prog;
static const Prog progs[] = {
    { "corpus.int64-edges", "int64-edges",
      "#include <stdio.h>\nint main(void){long long a=-9223372036854775807LL-1;unsigned long long u=18446744073709551615ULL;long long m=9223372036854775807LL;\n"
      " unsigned long long w=u+1;int r=(int)((a>>63)&1)+(int)w+(int)((m>>62)&3)+(int)((1u<<31)>>31)+(int)(u>>63);\n"
      " printf(\"%lld %llu %lld %llu\\n\",a,u,m,w);return r;}\n", 0, "-9223372036854775808 18446744073709551615 9223372036854775807 0\n", 4 },
    { "corpus.float-double", "float-double",
      "#include <stdio.h>\nint main(void){double d=1.5;float f=2.25f;int i=(int)(d*4);int j=(int)(f*4);double s=d+f;int k=(int)((double)7/2*2);\n"
      " printf(\"%d %d %d %d\\n\",i,j,(int)(s*4),k);return i+j;}\n", 0, "6 9 15 7\n", 15 },
    { "corpus.calls-abi", "calls-abi",
      "#include <stdio.h>\nstruct P{int x;int y;};\nstruct P mk(int a,int b){struct P p;p.x=a;p.y=b;return p;}\nint add(struct P p){return p.x+p.y;}\n"
      "int inc(int v){return v+1;}\nint twice(int (*f)(int),int v){return f(f(v));}\n"
      "int main(void){struct P p=mk(3,4);int (*fp)(int)=inc;printf(\"%d %d\\n\",add(p),twice(fp,5));return add(mk(1,2))+twice(inc,0);}\n", 0, "7 7\n", 5 },
    { "corpus.switch-dense", "switch-dense",
      "#include <stdio.h>\nint f(int x){switch(x){case 0:return 10;case 1:return 11;case 2:return 12;case 3:return 13;case 4:return 14;case 5:return 15;case 6:return 16;case 7:return 17;case 100:return 1;case 1000:return 2;default:return 99;}}\n"
      "int main(void){int s=f(3)+f(100)+f(1000)+f(50)+f(7);printf(\"%d %d %d\\n\",f(0),f(7),f(-1));return s;}\n", 0, "10 17 99\n", 132 },
    { "corpus.pointer-memory", "pointer-memory",
      "#include <stdio.h>\nstatic int g[8];\nstatic void fill(int *p,int n){int i;for(i=0;i<n;i++)p[i]=i*3;}\nstatic int sum(const int *p,const int *e){int s=0;while(p<e){s+=*p;p++;}return s;}\n"
      "int main(void){int loc[4];fill(g,8);fill(loc,4);printf(\"%d %d %d\\n\",sum(g,g+8),sum(loc,loc+4),(int)(&g[5]-&g[2]));return sum(g,g+8)+sum(loc,loc+4)+(int)(&g[5]-&g[2]);}\n", 0, "84 18 3\n", 105 },
    { "corpus.large-frame", "large-frame",
      "#include <stdio.h>\nint main(void){char buf[1024];int i,s=0;for(i=0;i<1024;i++)buf[i]=(char)(i%5);for(i=0;i<1024;i++)s+=buf[i];printf(\"%d\\n\",s);return s%256;}\n", 0, "2046\n", 254 },
    { "corpus.multi-tu", "multi-tu",
      "#include <stdio.h>\nint helper(int);\nstatic int hidden(void){return 7;}\nint main(void){printf(\"%d\\n\",helper(5)+hidden());return 7;}\n",
      "static int hidden(void){return 100;}\nint helper(int x){return x*hidden();}\n", "507\n", 7 },
    /* corpus-7..9 (2026-10-28): stream-e4 cell e4.sem.corpus-breadth (varargs, deep recursion with struct return and
       pointer arithmetic, mixed float/double with a sparse switch); same oracles as corpus-0..6 */
    { "corpus.varargs", "varargs",
      "#include <stdio.h>\n#include <stdarg.h>\nstatic int sum(int n,...){va_list ap;int i,s=0;va_start(ap,n);for(i=0;i<n;i++)s+=va_arg(ap,int);va_end(ap);return s;}\n"
      "static double avg(int n,...){va_list ap;int i;double s=0;va_start(ap,n);for(i=0;i<n;i++)s+=va_arg(ap,double);va_end(ap);return s/n;}\n"
      "int main(void){int a=sum(3,1,2,3),b=sum(0),c=sum(6,10,20,30,40,50,60);int d=(int)(avg(4,1.0,2.0,3.0,4.0)*2);printf(\"%d %d %d %d\\n\",a,b,c,d);return a+b+d;}\n", 0, "6 0 210 5\n", 11 },
    { "corpus.deep-recursion", "deep-recursion",
      "#include <stdio.h>\nstruct R{int lo;int hi;};\nstatic int fib(int n){return n<2?n:fib(n-1)+fib(n-2);}\nstatic int depth(int n){return n==0?0:n+depth(n-1);}\n"
      "static int ack(int m,int n){return m==0?n+1:n==0?ack(m-1,1):ack(m-1,ack(m,n-1));}\nstatic struct R span(const int *p,int n){struct R r;r.lo=p[0];r.hi=p[n-1];return r;}\n"
      "int main(void){int v[5]={4,8,15,16,23};struct R r=span(v+1,3);printf(\"%d %d %d %d %d\\n\",fib(20),depth(5000),ack(2,3),r.lo,r.hi);return (fib(20)+ack(2,3)+r.hi-r.lo)%256;}\n", 0, "6765 12502500 9 8 16\n", 126 },
    { "corpus.float-mixed", "float-mixed",
      "#include <stdio.h>\nstatic int cls(int x){switch(x){case -5:return 1;case 17:return 2;case 300:return 3;case 65536:return 4;default:return 0;}}\n"
      "int main(void){double a=-2.75;float b=2.75f;long long big=(long long)1e10;int c=(int)a+(int)b;int d=(a<b)+(b>0)+(a==-2.75);double e=(double)big/4;\n"
      " printf(\"%d %d %lld %d %d\\n\",(int)a,(int)b,big,d,(int)(e/1e9));return c+cls(-5)+cls(17)+cls(300)+cls(65536)+cls(5);}\n", 0, "-2 2 10000000000 3 2\n", 10 },
};
#define NPROG ((int)(sizeof progs / sizeof *progs))

/* write the program's source file(s) into work and return the primary path; src2 goes to NAME-b.c */
static void sources(const Prog *p, char *a, size_t ac, char *b, size_t bc) {
    snprintf(a, ac, "%s/%s.c", work, p->name); saved(a, p->src, strlen(p->src)); b[0] = 0;
    if (p->src2) { snprintf(b, bc, "%s/%s-b.c", work, p->name); saved(b, p->src2, strlen(p->src2)); }
}
static int compile_with(const char *tool, const char *a, const char *b, const char *flag, const char *target, const char *out, np_result *r) {
    char *v[16]; int n = 0; if (!strcmp(tool, "product")) { v[n++] = "sh"; v[n++] = product; } else v[n++] = (char *)tool;
    v[n++] = (char *)a; if (b[0]) v[n++] = (char *)b; if (flag) v[n++] = (char *)flag;
    if (target) { v[n++] = "-b"; v[n++] = (char *)target; } else v[n++] = "-S";
    v[n++] = "-o"; v[n++] = (char *)out; v[n] = 0; return run(v, 20, r);
}
static int exact(const np_result *r, const char *s, int rc) { size_t n = strlen(s); return r->rc == rc && !r->errn && r->outn == n && !memcmp(r->out, s, n); }

static void corpus_program(const Prog *p) {
    char a[4400], b[4400], t0[4400], t2[4400], lab[200]; np_result r; sources(p, a, sizeof a, b, sizeof b);
    snprintf(t0, sizeof t0, "%s/%s.O0.tape", work, p->name); snprintf(t2, sizeof t2, "%s/%s.O2.tape", work, p->name);
    if (compile_with("product", a, b, "-O0", 0, t0, &r) || r.rc) { row("NOT_RUN", p->cell, "O0-tape", "compile failed"); np_free(&r); return; } np_free(&r);
    if (compile_with("product", a, b, "-O2", 0, t2, &r) || r.rc) { row("NOT_RUN", p->cell, "O2-tape", "compile failed"); np_free(&r); return; } np_free(&r);
    if (same_file(t0, t2)) { row("VACUOUS", p->cell, "guard", "O0 tape == O2 tape: nothing for the flags to differ on"); return; }
    for (int f = 0; f < 6; f++) for (int t = 0; t < 6; t++) {
        char img[4400]; snprintf(img, sizeof img, "%s/%s.%s.%s", work, p->name, fslug[f], tslug[t]); snprintf(lab, sizeof lab, "%s.%s", fslug[f], tslug[t]);
        if (compile_with("product", a, b, flags[f], targets[t], img, &r) || r.rc) { row("NOT_RUN", p->cell, lab, "product compile failed"); np_free(&r); continue; } np_free(&r);
        if (t == 0) { char *v[] = { img, 0 }; char d[200]; if (run(v, 3, &r)) row("NOT_RUN", p->cell, lab, "image did not run"); else { snprintf(d, sizeof d, "exit %d, stdout literal", p->exit_want); char l2[220]; snprintf(l2, sizeof l2, "%s.executes", lab); check(exact(&r, p->stdout_want, p->exit_want), p->cell, l2, exact(&r, p->stdout_want, p->exit_want) ? d : "stdout or exit differs from literal"); np_free(&r); } }
        if (ref[0]) { char rimg[4400]; snprintf(rimg, sizeof rimg, "%s.ref", img); char l2[220]; snprintf(l2, sizeof l2, "%s.image-equals-reference", lab);
            if (compile_with(ref, a, b, flags[f], targets[t], rimg, &r) || r.rc) row("NOT_RUN", p->cell, l2, "reference compile failed"); else check(same_file(img, rimg), p->cell, l2, "byte equality"); np_free(&r); }
    }
    if (!ref[0]) { snprintf(lab, sizeof lab, "%s.six-targets", p->name); fprintf(res, "UNVERIFIED\t%s\t%s\tno REF: foreign-target images not compared\n", p->cell, lab); }
}

static void group_closure(void) {
    for (int i = 0; i < NPROG; i++) { const Prog *p = &progs[i]; char a[4400], b[4400]; np_result r; sources(p, a, sizeof a, b, sizeof b);
        for (int f = 0; f < 2; f++) { const char *fl = f ? "-O2" : "-O1"; char pt[4400], rt[4400], lab[200]; snprintf(pt, sizeof pt, "%s/%s.%s.tape", work, p->name, fl + 1); snprintf(rt, sizeof rt, "%s/%s.%s.ref.tape", work, p->name, fl + 1); snprintf(lab, sizeof lab, "%s.%s.tape-equals-reference", p->name, fl + 1);
            if (!ref[0]) { fprintf(res, "UNVERIFIED\tclosure.reference-tape\t%s\tno REF\n", lab); continue; }
            if (compile_with("product", a, b, fl, 0, pt, &r) || r.rc) { row("NOT_RUN", "closure.reference-tape", lab, "product tape failed"); np_free(&r); continue; } np_free(&r);
            if (compile_with(ref, a, b, fl, 0, rt, &r) || r.rc) { row("NOT_RUN", "closure.reference-tape", lab, "reference tape failed"); np_free(&r); continue; } np_free(&r);
            check(same_file(pt, rt), "closure.reference-tape", lab, "byte equality"); }
        { char nf[4400], o0[4400], lab[200]; snprintf(nf, sizeof nf, "%s/%s.noflag.img", work, p->name); snprintf(o0, sizeof o0, "%s/%s.O0.img", work, p->name);
          if (compile_with("product", a, b, 0, targets[0], nf, &r) || r.rc) { row("NOT_RUN", "default.native-image", p->name, "no-flag compile failed"); np_free(&r); continue; } np_free(&r);
          if (compile_with("product", a, b, "-O0", targets[0], o0, &r) || r.rc) { row("NOT_RUN", "default.native-image", p->name, "-O0 compile failed"); np_free(&r); continue; } np_free(&r);
          snprintf(lab, sizeof lab, "%s.noflag-equals-O0-bytes", p->name); check(same_file(nf, o0), "default.native-image", lab, "byte equality");
          char *v[] = { nf, 0 }; snprintf(lab, sizeof lab, "%s.noflag-executes", p->name); if (run(v, 3, &r)) row("NOT_RUN", "default.native-image", lab, "image did not run"); else { check(exact(&r, p->stdout_want, p->exit_want), "default.native-image", lab, "literal stdout and exit"); np_free(&r); } } }
}

static void group_cli(void) {
    const Prog *p = &progs[0]; char a[4400], b[4400]; np_result r; sources(p, a, sizeof a, b, sizeof b);
    const char *sp[] = { "-Og", "-Ofast", "-O-1", "-O4", "-O5", "-O1x" };
    for (size_t i = 0; i < sizeof sp / sizeof *sp; i++) { char img[4400], lab[200]; snprintf(img, sizeof img, "%s/cli-%zu.img", work, i); snprintf(lab, sizeof lab, "%s.named-refusal", sp[i]);
        if (compile_with("product", a, b, sp[i], targets[0], img, &r)) { row("NOT_RUN", "refusal.other-spellings", lab, "product did not run"); continue; }
        struct stat st; int noimg = stat(img, &st) && errno == ENOENT; int ok = r.rc == 1 && !r.outn && r.errn && strstr(r.err, "option not migrated") && noimg;
        char d[200]; snprintf(d, sizeof d, "rc=%d stderr names 'option not migrated', no image", r.rc); check(ok, "refusal.other-spellings", lab, ok ? d : "refusal shape differs"); np_free(&r);
        if (ref[0]) { char rimg[4400]; snprintf(rimg, sizeof rimg, "%s/cli-%zu.ref", work, i); if (!compile_with(ref, a, b, sp[i], targets[0], rimg, &r)) { struct stat s2; fprintf(res, "INFO\trefusal.other-spellings\t%s.reference\trc=%d image=%s stderr=%zu bytes\n", sp[i], r.rc, stat(rimg, &s2) ? "no" : "yes", r.errn); np_free(&r); } } }
}

int main(int argc, char **argv) {
    if ((argc != 4 && argc != 5) || !realpath(argv[1], root) || argv[2][0] != '/' || (argc == 5 && !realpath(argv[4], ref))) { fputs("usage: ROOT ABS_OUT corpus-0..corpus-9|closure|cli [REF]\n", stderr); return 2; }
    const char *group = argv[3]; int gp = -1, gl = !strcmp(group, "closure"), gi = !strcmp(group, "cli");
    if (!strncmp(group, "corpus-", 7) && group[7] >= '0' && group[7] < '0' + NPROG && !group[8]) gp = group[7] - '0';
    if (gp < 0 && !gl && !gi) die("group");
    snprintf(outdir, sizeof outdir, "%s", argv[2]); if (mkdir(outdir, 0700) && errno != EEXIST) die("out dir"); path(work, sizeof work, outdir, group); if (mkdir(work, 0700)) die("group dir must be absent");
    path(bound, sizeof bound, root, "tools/bound"); path(product, sizeof product, root, "unisacc.com");
    char rp[4400]; snprintf(rp, sizeof rp, "%s/results-%s.tsv", outdir, group); res = fopen(rp, "wbx"); if (!res) die("results exclusive");
    { char hp[65], hr[65]; if (!shafile(product, hp)) die("product"); fprintf(res, "IDENTITY\tproduct=%s\n", hp); if (ref[0]) { if (!shafile(ref, hr)) die("ref"); fprintf(res, "IDENTITY\tref=%s\n", hr); } }
    if (gp >= 0) corpus_program(&progs[gp]);
    else if (gl) group_closure(); else group_cli();
    fprintf(res, "SUMMARY\tgroup=%s\tpass=%d\tfail=%d\tvacuous=%d\tnot_run=%d\n", group, npass, nfail, nvac, nnotrun); fclose(res);
    printf("OPT_CORPUS\tgroup=%s\tpass=%d\tfail=%d\tvacuous=%d\tnot_run=%d\n", group, npass, nfail, nvac, nnotrun);
    return nfail || nvac || nnotrun ? 1 : 0;
}
