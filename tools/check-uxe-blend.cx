#pragma unisa use chrome_dom
/* tools/check-uxe-blend.cx -- UXE 直通混合.
 * sh ./unisacc.com tools/check-uxe-blend.cx --
 */
static int failed;
static void ck(int ok, const char *lab) {
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", lab);
    if (!ok) failed++;
}
int main(void) {
    char cwd[512], url[700];
    const char *pre = "file://";
    const char *suf = "/ujs/practice/uxe/test/uxe-blend.html";
    const char *fin[3];
    int retries = 0, rc, n, i;
    if (!getcwd(cwd, sizeof cwd)) return 2;
    n = 0;
    while (pre[n]) { url[n] = pre[n]; n++; }
    for (i = 0; cwd[i] && n < 500; i++) url[n++] = cwd[i];
    for (i = 0; suf[i] && n < 640; i++) url[n++] = suf[i];
    url[n] = 0;
    fin[0] = "BLEND_OK";
    fin[1] = "BLEND_FAIL";
    fin[2] = "BLEND_ERR";
    rc = chd_dump_expect("/usr/bin/google-chrome", url, "BLEND_OK", fin, 3, "uxe-blend", 6, 25, &retries);
    if (rc == 3) { printf("BLEND_UNMEASURED\tno-chrome\n"); return 2; }
    ck(rc == 0, "uxe-blend");
    printf("CHECK_UXE_BLEND\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
