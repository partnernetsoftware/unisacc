/* tools/symindex.cx -- per-file symbol facts, content-addressed, with a stat prefilter
   (plans/symindex-design-2026-10-30.md).  From the repo root:

     sh ./unisacc.com tools/symindex.cx -- [--index DIR] [--in LIST] COMMAND ...

   COMMAND
     update [--verify]        refresh the index; prints SYMINDEX files=N reparsed=K hashed=H elapsed_ms=T
     def NAME                 every top-level definition (D) and prototype (P) of NAME
     calls NAME[,NAME...] [--tracked | FILE...]
                              the same rows and format as `tools/refactor.cx -- sites`: FILE:LINE<TAB>call
     uses FILE / users FILE   forward / reverse transitive `#pragma unisa use` closure, by realpath
     undeclared (--tracked | FILE...)
                              calls of a function that some module defines (non-static D) while the caller
                              neither uses that module directly nor declares the name itself; DANGER when
                              the function is variadic or returns double/float (plans/indirect-proto-2026-
                              10-30.md), else INFO.  One row per caller and name: KIND FILE:LINE NAME
                              sites=K def=FILE:LINE why=.. reach=transitive|none (transitive: the module is
                              in the caller's use closure, the miscompiled case; none: not visible through
                              uses at all), then UNDECLARED danger= info= transitive= callers= scanned=;
                              rc 1 when any DANGER
     dump FILE                the file's facts

   The file set is every tracked .cx file (git ls-files -s, mode 120000 symlinks skipped), or the paths in
   LIST (one per line) with --in; files named on the command line are added.  The index lives in DIR
   (default out/symindex/v1): manifest.tsv (path size mtime_s ino dev sha256) and one shard per content,
   SHA256.tsv.  update lstat()s every file: when (size, mtime, ino, dev) all equal the manifest row, its
   sha256 is reused without reading the file; otherwise the file is read and hashed.  A shard is parsed
   and written only when no shard of that sha256 exists.  mtime has whole-second granularity here (sy_stat_t
   carries seconds only), so a same-size rewrite within the same second, or one whose mtime was put back,
   passes the prefilter; --verify re-hashes every file, prints STALE<TAB>path<TAB>old<TAB>new for each such
   file and repairs the manifest.  An update that reaches 45 s stops, prints DEFERRED<TAB>n and keeps what it
   did (run it again to finish); a query on an unfinished index exits 3.  Every query first does the update
   (its SYMINDEX line goes to stderr).

   Shard rows (TSV; TAB, newline and backslash inside a field written as \t \n \\):
     M name                    #pragma unisa module
     U text                    #pragma unisa use, as written
     D name line site static variadic ret tail     top-level definition: IDENT ( ... ) {
     P name line site static variadic ret tail     top-level prototype:  IDENT ( ... ) ;
     T name line               typedef name; struct/union/enum tag followed by {
     X name line params        #define (params 1 when '(' follows the name directly)
     C name line site tail     any other IDENT ( outside comments and literals (C keywords not recorded)
   tail is the raw text from the end of the name through the matching ')'; site is 1 when
   refactor.cx sites would list the occurrence (no comment inside the parentheses, at most 9 arguments).
   The lexer is refactor.cx find_file's: comments, string and character literals skipped, an identifier
   followed by optional whitespace and '(' is an occurrence, scanning goes on inside its arguments.
   D/P: at brace and paren depth 0, outside preprocessor lines, not in a typedef or after '=', with a
   non-empty return-type text since the previous top-level ';', function-body '}' or preprocessor line.
   rc: 0, 1 (undeclared found DANGER), 2 usage or I/O, 3 the index is unfinished (DEFERRED). */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.time
#pragma unisa use sys.sha
#pragma unisa use mem.arena
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use text.text
#pragma unisa use text.num

#define CAP (1L << 24)
#define MAXE 16384
#define HASHN 65536
#define DEADLINE_MS 45000

static int arena;
static void die(const char *s) { fprintf(stderr, "symindex: %s\n", s); exit(2); }
static void die2(const char *s, const char *t) { fprintf(stderr, "symindex: %s: %s\n", s, t); exit(2); }
static char *keep(const char *s, long n) { char *p = ar_dup(arena, s, n); if (!p) die("out of memory"); p[n] = 0; return p; }
static char *zkeep(const char *s) { return keep(s, tx_len(s, CAP)); }

/* ---------- growable heap buffer ---------- */
typedef struct { char *p; long n, cap; } Buf;
static void put(Buf *b, const char *s, long n) {
    if (b->n + n + 1 > b->cap) {
        long c = (b->n + n + 1) * 2; char *t = mm_grow(b->p, c);
        if (!t) die("out of memory");
        b->p = t; b->cap = c;
    }
    if (n > 0 && mm_copy(b->p + b->n, b->cap - b->n, s, n)) die("buffer copy");
    b->n += n; b->p[b->n] = 0;
}
static void puts_(Buf *b, const char *s) { put(b, s, tx_len(s, CAP)); }
static void putl(Buf *b, long v) { char num[32]; if (cx_fmt(num, sizeof num, "%ld", v)) die("format"); puts_(b, num); }
static void putesc(Buf *b, const char *s, long n) {
    long i, a = 0;
    for (i = 0; i < n; i++) {
        const char *r = s[i] == '\t' ? "\\t" : s[i] == '\n' ? "\\n" : s[i] == '\\' ? "\\\\" : 0;
        if (r) { put(b, s + a, i - a); put(b, r, 2); a = i + 1; }
    }
    put(b, s + a, n - a);
}

/* ---------- the lexer (refactor.cx find_file's rules) ---------- */
static int is_id(int c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || (c >= '0' && c <= '9'); }
static long skip_ws(const char *b, long i, long n) { while (i < n && (b[i] == ' ' || b[i] == '\t' || b[i] == '\n' || b[i] == '\r')) i++; return i; }
static long skip_ws_back(const char *b, long i) { while (i >= 0 && (b[i] == ' ' || b[i] == '\t' || b[i] == '\n' || b[i] == '\r')) i--; return i; }
static int word_is(const char *s, long n, const char *w) { return tx_same(s, n, w, tx_len(w, 64)); }

/* refactor.cx parse_args, kept only for its verdict: 1 when sites would accept the '(' at P */
static int sites_ok(const char *b, long p, long n) {
    long i = p + 1, start = i; int depth = 0, na = 0;
    while (i < n) {
        char c = b[i];
        if (c == '/' && i + 1 < n && (b[i + 1] == '*' || b[i + 1] == '/')) return 0;
        if (c == '"' || c == '\'') {
            char q = c; i++;
            while (i < n && b[i] != q) { if (b[i] == '\\') i++; i++; }
            i++; continue;
        }
        if (c == '(' || c == '[' || c == '{') depth++;
        else if (c == ')' || c == ']' || c == '}') {
            if (depth == 0) {
                if (c != ')') return 0;
                if (i > start || na > 0) { if (na == 9) return 0; na++; }
                return 1;
            }
            depth--;
        } else if (c == ',' && depth == 0) {
            if (na == 9) return 0;
            na++; start = i + 1;
        }
        i++;
    }
    return 0;
}
/* the ')' matching the '(' at P, comments and literals skipped; -1 when unbalanced */
static long match_close(const char *b, long p, long n) {
    long i = p + 1; int depth = 0;
    while (i < n) {
        char c = b[i];
        if (c == '/' && i + 1 < n && b[i + 1] == '/') { while (i < n && b[i] != '\n') i++; continue; }
        if (c == '/' && i + 1 < n && b[i + 1] == '*') {
            long e = tx_find(b + i + 2, n - i - 2, "*/", 2);
            if (e < 0) return -1;
            i += e + 4; continue;
        }
        if (c == '"' || c == '\'') {
            char q = c; i++;
            while (i < n && b[i] != q) { if (b[i] == '\\') i++; i++; }
            i++; continue;
        }
        if (c == '(' || c == '[' || c == '{') depth++;
        else if (c == ')' || c == ']' || c == '}') {
            if (depth == 0) return c == ')' ? i : -1;
            depth--;
        }
        i++;
    }
    return -1;
}
/* past whitespace, comments and __attribute__((...)) / __asm__(...) from I */
static long skip_trailer(const char *b, long i, long n) {
    for (;;) {
        i = skip_ws(b, i, n);
        if (i + 1 < n && b[i] == '/' && b[i + 1] == '/') { while (i < n && b[i] != '\n') i++; continue; }
        if (i + 1 < n && b[i] == '/' && b[i + 1] == '*') {
            long e = tx_find(b + i + 2, n - i - 2, "*/", 2);
            if (e < 0) return n;
            i += e + 4; continue;
        }
        if (i < n && is_id((unsigned char)b[i])) {
            long a = i, j, c;
            while (i < n && is_id((unsigned char)b[i])) i++;
            if (!word_is(b + a, i - a, "__attribute__") && !word_is(b + a, i - a, "__asm__") && !word_is(b + a, i - a, "asm")) return a;
            j = skip_ws(b, i, n);
            if (j >= n || b[j] != '(' || (c = match_close(b, j, n)) < 0) return a;
            i = c + 1; continue;
        }
        return i;
    }
}
/* B[0..N) with comments dropped and whitespace runs as one space, trimmed */
static void normalize(Buf *o, const char *b, long n) {
    long i = 0; int sp = 0;
    while (i < n) {
        char c = b[i];
        if (c == '/' && i + 1 < n && b[i + 1] == '/') { while (i < n && b[i] != '\n') i++; sp = 1; continue; }
        if (c == '/' && i + 1 < n && b[i + 1] == '*') {
            long e = tx_find(b + i + 2, n - i - 2, "*/", 2);
            i = e < 0 ? n : i + e + 4; sp = 1; continue;
        }
        if (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f' || c == '\\') { sp = 1; i++; continue; }
        if (sp && o->n) put(o, " ", 1);
        sp = 0; put(o, &c, 1); i++;
    }
}
/* the whole token W inside S[0..N) */
static int has_word(const char *s, long n, const char *w) {
    long wl = tx_len(w, 64), i;
    for (i = 0; i + wl <= n; i++)
        if (tx_same(s + i, wl, w, wl) && (i == 0 || !is_id((unsigned char)s[i - 1])) && (i + wl == n || !is_id((unsigned char)s[i + wl]))) return 1;
    return 0;
}
static const char *ckw[] = {"if", "while", "for", "switch", "return", "sizeof", "do", "else", "case", "void", "char", "short", "int",
    "long", "float", "double", "signed", "unsigned", "const", "volatile", "struct", "union", "enum", "static", "extern", "register",
    "auto", "inline", "restrict", "_Bool", 0};
static int is_ckw(const char *s, long n) { int k; for (k = 0; ckw[k]; k++) if (word_is(s, n, ckw[k])) return 1; return 0; }

static long dir_word(const char *b, long i, long n, const char *w) {
    long wl = tx_len(w, 64);
    if (i + wl <= n && tx_prefix(b + i, n - i, w, wl) && (i + wl == n || !is_id((unsigned char)b[i + wl]))) return i + wl;
    return -1;
}
static long skip_blank(const char *b, long i, long n) { while (i < n && (b[i] == ' ' || b[i] == '\t')) i++; return i; }
/* the preprocessor line at B[i] ('#'): X, M and U rows */
static void directive(Buf *o, const char *b, long i, long n, long line) {
    long j, a;
    i = skip_blank(b, i + 1, n);
    if ((j = dir_word(b, i, n, "define")) >= 0) {
        i = skip_blank(b, j, n); a = i;
        while (i < n && is_id((unsigned char)b[i])) i++;
        if (i == a) return;
        put(o, "X\t", 2); put(o, b + a, i - a); put(o, "\t", 1); putl(o, line);
        puts_(o, i < n && b[i] == '(' ? "\t1\n" : "\t0\n");
    } else if ((j = dir_word(b, i, n, "pragma")) >= 0) {
        int mod;
        i = skip_blank(b, j, n);
        if ((j = dir_word(b, i, n, "unisa")) < 0) return;
        i = skip_blank(b, j, n);
        if ((j = dir_word(b, i, n, "module")) >= 0) mod = 1;
        else if ((j = dir_word(b, i, n, "use")) >= 0) mod = 0;
        else return;
        i = skip_blank(b, j, n); a = i;
        while (i < n && (is_id((unsigned char)b[i]) || b[i] == '.')) i++;
        if (i == a) return;
        put(o, mod ? "M\t" : "U\t", 2); putesc(o, b + a, i - a); put(o, "\n", 1);
    }
}

static void row_t(Buf *o, const char *s, long n, long line) {
    put(o, "T\t", 2); put(o, s, n); put(o, "\t", 1); putl(o, line); put(o, "\n", 1);
}

/* every fact of B[0..N) into O */
static void parse(Buf *o, const char *b, long n) {
    long i = 0, line = 1, st = 0, k;
    int mode = 0, brace = 0, paren = 0, pp = 0, ls = 1, body = 0, pend = 0;
    int st_tok = 0, st_eq = 0, st_td = 0;
    long td_a = 0, td_n = 0, td_line = 0, fp_a = 0, fp_n = 0, fp_line = 0;
    Buf ret = {0, 0, 0};
    put(o, "#symindex\tv1\n", 13);
    while (i < n) {
        char c = b[i];
        if (c == '\n') line++;
        if (mode == 1 || (mode == 0 && c == '\n')) {
            if (c == '\n') {
                mode = 0; ls = 1;
                if (pp && !(i > 0 && b[i - 1] == '\\')) { pp = 0; if (!brace && !paren && !st_tok) st = i + 1; }
            }
            i++; continue;
        }
        if (mode == 2) { if (c == '*' && i + 1 < n && b[i + 1] == '/') { mode = 0; i += 2; continue; } i++; continue; }
        if (mode == 3 || mode == 4) {
            if (c == '\\' && i + 1 < n) { i += 2; continue; }   /* as find_file: an escaped newline is not counted */
            if ((mode == 3 && c == '"') || (mode == 4 && c == '\'')) mode = 0;
            i++; continue;
        }
        if (c == '/' && i + 1 < n && b[i + 1] == '/') { mode = 1; i += 2; continue; }
        if (c == '/' && i + 1 < n && b[i + 1] == '*') { mode = 2; i += 2; continue; }
        if (c == ' ' || c == '\t' || c == '\r' || c == '\f') { i++; continue; }
        if (c == '#' && ls && !pp) { pp = 1; ls = 0; directive(o, b, i, n, line); i++; continue; }
        ls = 0;
        if (c == '"') { mode = 3; i++; continue; }
        if (c == '\'') { mode = 4; i++; continue; }
        if (is_id((unsigned char)c) && !(c >= '0' && c <= '9') && (i == 0 || !is_id((unsigned char)b[i - 1]))) {
            long a = i, j, nl;
            while (i < n && is_id((unsigned char)b[i])) i++;
            nl = i - a;
            j = skip_ws(b, i, n);
            if (!pp && !brace) {
                if (!paren) {
                    if (!st_tok && word_is(b + a, nl, "typedef")) st_td = 1;
                    st_tok = 1;
                    if (st_td) { td_a = a; td_n = nl; td_line = line; }
                    if (word_is(b + a, nl, "struct") || word_is(b + a, nl, "union") || word_is(b + a, nl, "enum")) {
                        long t = skip_trailer(b, i, n), te = t, q;
                        while (te < n && is_id((unsigned char)b[te])) te++;
                        if (te > t && !(b[t] >= '0' && b[t] <= '9')) {
                            long tl = line;
                            for (q = i; q < t; q++) if (b[q] == '\n') tl++;
                            q = skip_trailer(b, te, n);
                            if (q < n && b[q] == '{') row_t(o, b + t, te - t, tl);
                        }
                    }
                } else if (paren == 1 && st_td && !fp_n) {   /* typedef R (*NAME)(...) */
                    long p = skip_ws_back(b, a - 1);
                    if (p >= 0 && b[p] == '*' && (p = skip_ws_back(b, p - 1)) >= 0 && b[p] == '(') { fp_a = a; fp_n = nl; fp_line = line; }
                }
            }
            if (j < n && b[j] == '(' && !is_ckw(b + a, nl)) {
                long close = match_close(b, j, n);
                int site = close >= 0 && sites_ok(b, j, n);
                char kind = 'C';
                ret.n = 0;
                if (!pp && !brace && !paren && !st_eq && !st_td && close >= 0) {
                    long q = skip_trailer(b, close + 1, n);
                    normalize(&ret, b + st, a - st);
                    if (ret.n && q < n && (b[q] == '{' || b[q] == ';' || b[q] == ',')) kind = b[q] == '{' ? 'D' : 'P';
                }
                put(o, &kind, 1); put(o, "\t", 1); put(o, b + a, nl); put(o, "\t", 1); putl(o, line);
                puts_(o, site ? "\t1\t" : "\t0\t");
                if (kind != 'C') {
                    puts_(o, has_word(ret.p, ret.n, "static") ? "1\t" : "0\t");
                    puts_(o, close >= 0 && tx_find(b + j, close - j, "...", 3) >= 0 ? "1\t" : "0\t");
                    putesc(o, ret.p, ret.n); put(o, "\t", 1);
                    if (kind == 'D') pend = 1;
                }
                if (close >= 0) putesc(o, b + i, close + 1 - i);
                put(o, "\n", 1);
                for (k = i; k <= j; k++) if (b[k] == '\n') line++;   /* as sites: go on inside the arguments */
                i = j + 1;
                if (!pp) paren++;
            }
            continue;
        }
        if (!pp) {
            if (c == '(') paren++;
            else if (c == ')') { if (paren) paren--; }
            else if (c == '{') { if (!brace && !paren) { body = pend; pend = 0; } brace++; }
            else if (c == '}') {
                if (brace) brace--;
                if (!brace && !paren && body) { body = 0; st = i + 1; st_tok = st_eq = st_td = 0; td_n = fp_n = 0; }
            } else if (c == ';' && !brace && !paren) {
                if (st_td) { if (fp_n) row_t(o, b + fp_a, fp_n, fp_line); else if (td_n) row_t(o, b + td_a, td_n, td_line); }
                st = i + 1; st_tok = st_eq = st_td = 0; td_n = fp_n = 0; pend = 0;
            } else if (c == '=' && !brace && !paren) st_eq = 1;
        }
        i++;
    }
    mm_free(ret.p);
}

/* ---------- entries and the manifest ---------- */
typedef struct {
    char *path;              /* as listed or named; repo-relative under the root */
    char *real;              /* realpath, once asked for */
    long size, mtime, ino; unsigned long dev;
    char sha[65];
    int ok;                  /* 1 indexed this run, -1 missing or unreadable, 0 not yet */
    int listed;              /* in the file set, not only reached through a use */
    char *shard; long shn;   /* loaded facts */
    int *use; int nuse, uses_done, mark;
} Entry;
static Entry ent[MAXE];
static int nent, hpath[HASHN], hreal[HASHN];
typedef struct { char *path, *sha; long size, mtime, ino; unsigned long dev; int used; } Man;
static Man man[MAXE];
static int nman, hman[HASHN];
static char idx[4096], root[4096];
static long root_n;
static long t0, n_hashed, n_reparsed, n_stale, n_deferred, n_missing;
static int dirty, verify;

static unsigned long hash(const char *s) { unsigned long h = 1469598103934665603UL; while (*s) { h ^= (unsigned char)*s++; h *= 1099511628211UL; } return h; }
/* slot of KEY in table T (entries keyed by K), -1 absent; with ADD, insert value V */
static int tab_find(int *t, const char *key, int which, int add, int v) {
    unsigned long h = hash(key) & (HASHN - 1);
    while (t[h]) {
        const char *k = which == 0 ? ent[t[h] - 1].path : which == 1 ? ent[t[h] - 1].real : man[t[h] - 1].path;
        if (tx_eqz(k, key)) return t[h] - 1;
        h = (h + 1) & (HASHN - 1);
    }
    if (add) t[h] = v + 1;
    return -1;
}

static void load_manifest(void) {
    char mp[4400]; size_t n; char *b; long i = 0;
    if (cx_fmt(mp, sizeof mp, "%s/manifest.tsv", idx)) die("path too long");
    b = cx_read(mp, &n);
    if (!b) return;
    while (i < (long)n) {
        char *line = b + i, *e = line, *f[6]; int k = 0;
        while (*e && *e != '\n') e++;
        i = (long)(e - b) + 1; *e = 0;
        if (!*line || *line == '#') continue;
        f[k++] = line;
        for (char *p = line; *p && k < 6; p++) if (*p == '\t') { *p = 0; f[k++] = p + 1; }
        if (k != 6 || tx_len(f[5], 80) != 64 || nman == MAXE) { dirty = 1; continue; }
        if (tab_find(hman, f[0], 2, 0, 0) >= 0) { dirty = 1; continue; }
        man[nman].path = f[0]; man[nman].size = tx_strtol(f[1], 0, 10); man[nman].mtime = tx_strtol(f[2], 0, 10);
        man[nman].ino = tx_strtol(f[3], 0, 10); man[nman].dev = tx_strtoul(f[4], 0, 10); man[nman].sha = f[5];
        tab_find(hman, f[0], 2, 1, nman);
        nman++;
    }
}
static int write_atomic(const char *path, const char *s, long n) {
    char tmp[4500]; int fd, bad;
    if (cx_fmt(tmp, sizeof tmp, "%s.tmp.%d", path, sy_pid())) return -1;
    fd = sy_open(tmp, O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (fd < 0) return -1;
    bad = sy_write_all(fd, s, n) != 0;
    if (sy_close(fd) != 0 || bad) { sy_unlink(tmp); return -1; }
    if (sy_rename(tmp, path) != 0) { sy_unlink(tmp); return -1; }
    return 0;
}
static void save_manifest(void) {
    Buf o = {0, 0, 0}; char mp[4400]; int e, m;
    if (!dirty) return;
    puts_(&o, "# symindex v1 manifest: path size mtime_s ino dev sha256\n");
    for (e = 0; e < nent; e++) {
        Entry *E = &ent[e]; char num[160];
        if (E->ok != 1) continue;
        putesc(&o, E->path, tx_len(E->path, CAP));
        if (cx_fmt(num, sizeof num, "\t%ld\t%ld\t%ld\t%lu\t", E->size, E->mtime, E->ino, E->dev)) die("format");
        puts_(&o, num); puts_(&o, E->sha); put(&o, "\n", 1);
    }
    if (n_deferred) for (m = 0; m < nman; m++) {   /* not reached this time: kept for the next call */
        Man *M = &man[m]; char num[160]; int ei = tab_find(hpath, M->path, 0, 0, 0);
        if (ei >= 0 && ent[ei].ok == 1) continue;
        puts_(&o, M->path);
        if (cx_fmt(num, sizeof num, "\t%ld\t%ld\t%ld\t%lu\t", M->size, M->mtime, M->ino, M->dev)) die("format");
        puts_(&o, num); puts_(&o, M->sha); put(&o, "\n", 1);
    }
    if (cx_fmt(mp, sizeof mp, "%s/manifest.tsv", idx)) die("path too long");
    if (write_atomic(mp, o.p, o.n) != 0) die2("cannot write", mp);
    mm_free(o.p);
}
static void shard_path(char *dst, long cap, const char *sha) {
    if (cx_fmt(dst, cap, "%s/%s.tsv", idx, sha)) die("path too long");
}

static int add_entry(const char *path, int listed) {
    int e = tab_find(hpath, path, 0, 0, 0);
    if (e >= 0) { if (listed) ent[e].listed = 1; return e; }
    if (nent == MAXE) die("too many files");
    e = nent++;
    ent[e].path = zkeep(path); ent[e].listed = listed;
    tab_find(hpath, ent[e].path, 0, 1, e);
    return e;
}

static void hash_of(const char *b, long n, char *hex) {
    if (n >= 65536 && sy_sha256_hex(b, n, hex) == 0) return;
    cx_sha256_hex(b, (size_t)n, hex);
}

/* bring entry E up to date: stat prefilter, hash when needed, parse when its shard is missing */
static void index_one(int e) {
    Entry *E = &ent[e]; sy_stat_t st; int r, m; char sp[4500]; char *b = 0; size_t n = 0;
    if (E->ok) return;
    r = sy_lstat(E->path, &st);
    if (r == 0 && st.kind == 'l') r = sy_stat(E->path, &st);
    if (r < 0 || st.kind != 'f') {
        fprintf(stderr, "NOTE\t%s\t%s\terr=%d\n", r == -ENOENT ? "missing" : "unreadable", E->path, r < 0 ? r : 0);
        E->ok = -1; n_missing++; dirty = 1; return;
    }
    E->size = st.size; E->mtime = st.mtime; E->ino = st.ino; E->dev = st.dev;
    m = tab_find(hman, E->path, 2, 0, 0);
    if (m >= 0) man[m].used = 1;
    if (m >= 0 && !verify && man[m].size == st.size && man[m].mtime == st.mtime && man[m].ino == st.ino && man[m].dev == st.dev) {
        tx_copy(E->sha, sizeof E->sha, man[m].sha, 64);
    } else {
        b = cx_read(E->path, &n);
        if (!b) { fprintf(stderr, "NOTE\tunreadable\t%s\n", E->path); E->ok = -1; n_missing++; dirty = 1; return; }
        hash_of(b, (long)n, E->sha); n_hashed++;
        if (m < 0 || !tx_eqz(man[m].sha, E->sha) || man[m].size != st.size || man[m].mtime != st.mtime || man[m].ino != st.ino || man[m].dev != st.dev) dirty = 1;
        if (verify && m >= 0 && !tx_eqz(man[m].sha, E->sha) && man[m].size == st.size && man[m].mtime == st.mtime && man[m].ino == st.ino && man[m].dev == st.dev) {
            printf("STALE\t%s\t%s\t%s\n", E->path, man[m].sha, E->sha); n_stale++;
        }
    }
    shard_path(sp, sizeof sp, E->sha);
    r = sy_exists(sp);
    if (r < 0) die2("cannot stat a shard", sp);
    if (r == 0) {
        Buf o = {0, 0, 0}; char h2[65];
        if (!b) {
            b = cx_read(E->path, &n);
            if (!b) { fprintf(stderr, "NOTE\tunreadable\t%s\n", E->path); E->ok = -1; n_missing++; dirty = 1; return; }
            hash_of(b, (long)n, h2); n_hashed++;
            if (!tx_eqz(h2, E->sha)) {   /* the manifest was wrong: name the shard by what is there */
                tx_copy(E->sha, sizeof E->sha, h2, 64); dirty = 1;
                shard_path(sp, sizeof sp, E->sha);
            }
        }
        parse(&o, b, (long)n);
        if (write_atomic(sp, o.p, o.n) != 0) die2("cannot write", sp);
        E->shard = keep(o.p, o.n); E->shn = o.n;
        mm_free(o.p); n_reparsed++;
    }
    E->ok = 1;
}
static void load_shard(int e) {
    Entry *E = &ent[e]; char sp[4500]; size_t n;
    if (E->shard) return;
    if (E->ok == 0) index_one(e);
    if (E->ok != 1) { E->shard = ""; E->shn = 0; return; }
    shard_path(sp, sizeof sp, E->sha);
    E->shard = cx_read(sp, &n);
    if (!E->shard) die2("cannot read a shard", sp);
    E->shn = (long)n;
}

/* ---------- the file set ---------- */
static void set_tracked(void) {
    char *gv[] = {"git", "ls-files", "-s", "-z", "--", "*.cx", 0}, chunk[65536]; int ofd, pid; long r, at = 0;
    Buf list = {0, 0, 0};
    pid = sy_spawn_pipe(gv, 0, 0, &ofd, 0);
    if (pid < 0) die("cannot run git ls-files");
    while ((r = sy_read(ofd, chunk, sizeof chunk)) > 0) put(&list, chunk, r);
    sy_close(ofd); sy_wait_status(pid, 0, 0, 0, 0);
    while (at < list.n) {   /* "MODE SHA STAGE\tPATH\0" */
        char *e = list.p + at; long ln = tx_len(e, list.n - at), tab = tx_chr(e, ln, '\t');
        if (tab > 0 && !tx_prefix(e, ln, "120000", 6)) add_entry(e + tab + 1, 1);
        at += ln + 1;
    }
    mm_free(list.p);
}
static void set_list(const char *lp) {
    size_t n; char *b = cx_read(lp, &n); long i = 0;
    if (!b) die2("cannot read the list", lp);
    while (i < (long)n) {
        char *line = b + i, *e = line;
        while (*e && *e != '\n') e++;
        i = (long)(e - b) + 1; *e = 0;
        if (*line && *line != '#') add_entry(line, 1);
    }
}
/* index every listed entry, under the deadline */
static void update_all(void) {
    int e;
    for (e = 0; e < nent; e++) {
        if (ent[e].ok) continue;
        if (sy_now_ms() - t0 > DEADLINE_MS) { n_deferred = nent - e; break; }
        index_one(e);
    }
}
static void report(int out) {
    char line[256]; int e, files = 0;
    for (e = 0; e < nent; e++) if (ent[e].ok == 1) files++;
    if (cx_fmt(line, sizeof line, "SYMINDEX\tfiles=%d\treparsed=%ld\thashed=%ld\tstale=%ld\tmissing=%ld\telapsed_ms=%ld\n",
               files, n_reparsed, n_hashed, n_stale, n_missing, sy_now_ms() - t0)) die("format");
    if (out) printf("%s", line); else fprintf(stderr, "%s", line);
    if (n_deferred) { if (out) printf("DEFERRED\t%ld\n", n_deferred); else fprintf(stderr, "DEFERRED\t%ld\n", n_deferred); }
}

/* ---------- rows ---------- */
static char row[1 << 20];   /* one split row at a time */
/* split the row at S (up to a newline) into fields; returns the count; the row is copied into ROW */
static int fields(const char *s, const char *end, char *row, long cap, char **f, int maxf) {
    long n = 0; int k = 0;
    while (s + n < end && s[n] != '\n') n++;
    if (n + 1 > cap) return 0;
    if (n && mm_copy(row, cap, s, n)) return 0;
    row[n] = 0;
    f[k++] = row;
    for (long q = 0; q < n && k < maxf; q++) if (row[q] == '\t') { row[q] = 0; f[k++] = row + q + 1; }
    return k;
}
static const char *next_row(const char *s, const char *end) { while (s < end && *s != '\n') s++; return s < end ? s + 1 : end; }
/* the field FI (0-based) of the row at S, as pointer and length */
static long field_at(const char *s, const char *end, int fi, const char **out) {
    const char *p = s, *q;
    while (fi > 0 && p < end && *p != '\n') { if (*p == '\t') fi--; p++; }
    q = p; while (q < end && *q != '\t' && *q != '\n') q++;
    *out = p; return (long)(q - p);
}

/* ---------- realpath and uses ---------- */
static const char *real_of(int e) {
    Entry *E = &ent[e]; char rp[4096]; int r;
    if (E->real) return E->real;
    r = sy_realpath(E->path, rp, sizeof rp);
    E->real = r >= 0 ? zkeep(rp) : E->path;
    if (tab_find(hreal, E->real, 1, 0, 0) < 0) tab_find(hreal, E->real, 1, 1, e);
    return E->real;
}
/* the entry for PATH (its realpath shared with any listed spelling), created as reached */
static int entry_for(const char *path, int listed) {
    char rp[4096]; int r, e;
    e = tab_find(hpath, path, 0, 0, 0);
    if (e >= 0) { if (listed) ent[e].listed = 1; return e; }
    r = sy_realpath(path, rp, sizeof rp);
    if (r >= 0 && (e = tab_find(hreal, rp, 1, 0, 0)) >= 0) { if (listed) ent[e].listed = 1; return e; }
    if (r >= 0 && tx_prefix(rp, r, root, root_n) && rp[root_n] == '/') e = add_entry(rp + root_n + 1, listed);
    else e = add_entry(path, listed);
    real_of(e);
    return e;
}
static void resolve_uses(int e) {
    Entry *E; const char *s, *end; char *f[4];
    load_shard(e);
    E = &ent[e];
    if (E->uses_done) return;
    E->uses_done = 1;
    E->use = ar_alloc(arena, 64 * (long)sizeof(int));
    if (!E->use) die("out of memory");
    s = E->shard; end = E->shard + E->shn;
    for (; s < end; s = next_row(s, end)) {
        char rel[8192], name[300]; long dl, k, nl; int d, j, dup = 0;
        if (*s != 'U' || fields(s, end, row, sizeof row, f, 4) != 2) continue;
        nl = tx_len(f[1], 300);
        if (nl >= 299 || word_is(f[1], nl, "std") || word_is(f[1], nl, "std.cx") || tx_prefix(f[1], nl, "std.", 4)) continue;
        for (k = 0; k < nl; k++) name[k] = f[1][k] == '.' ? '/' : f[1][k];
        name[nl] = 0;
        E = &ent[e];
        dl = tx_len(E->path, 4095);
        while (dl > 0 && E->path[dl - 1] != '/') dl--;
        if (cx_fmt(rel, sizeof rel, "%.*s%s.cx", (int)dl, E->path, name)) die("path too long");
        if (sy_exists(rel) != 1) { fprintf(stderr, "NOTE\tunresolved\t%s\tin=%s\n", f[1], E->path); continue; }
        d = entry_for(rel, 0);
        E = &ent[e];
        for (j = 0; j < E->nuse; j++) if (E->use[j] == d) dup = 1;
        if (dup) continue;
        if (E->nuse == 64) die("more than 64 uses in one file");
        E->use[E->nuse++] = d;
    }
}
static int epoch;
static void closure(int e) {
    int k;
    if (ent[e].mark == epoch) return;
    ent[e].mark = epoch;
    resolve_uses(e);
    for (k = 0; k < ent[e].nuse; k++) closure(ent[e].use[k]);
}
static void real_all(void) { int e; for (e = 0; e < nent; e++) real_of(e); }

/* ---------- queries ---------- */
static int nnames; static char *names[64]; static long namel[64];
static int name_hit(const char *s, long n) { int k; for (k = 0; k < nnames; k++) if (tx_same(s, n, names[k], namel[k])) return 1; return 0; }

static void calls_of(Buf *out, int e) {
    const char *s, *end; Entry *E;
    load_shard(e);
    E = &ent[e]; s = E->shard; end = E->shard + E->shn;
    for (; s < end; s = next_row(s, end)) {
        const char *nm, *site, *tail; long nn, tl; int tf;
        if (*s != 'C' && *s != 'D' && *s != 'P') continue;
        nn = field_at(s, end, 1, &nm);
        if (!name_hit(nm, nn)) continue;
        field_at(s, end, 3, &site);
        if (*site != '1') continue;
        tf = *s == 'C' ? 4 : 7;
        tl = field_at(s, end, tf, &tail);
        {   const char *ln; long lnn = field_at(s, end, 2, &ln);
            putesc(out, E->path, tx_len(E->path, CAP)); put(out, ":", 1); put(out, ln, lnn); put(out, "\t", 1);
            put(out, nm, nn); put(out, tail, tl); put(out, "\n", 1);
        }
    }
}

static int cmd_def(const char *name) {
    int e, hits = 0; Buf out = {0, 0, 0};
    for (e = 0; e < nent; e++) {
        const char *s, *end; char *f[9];
        if (!ent[e].listed) continue;
        load_shard(e);
        s = ent[e].shard; end = s + ent[e].shn;
        for (; s < end; s = next_row(s, end)) {
            if ((*s != 'D' && *s != 'P') || fields(s, end, row, sizeof row, f, 9) != 8 || !tx_eqz(f[1], name)) continue;
            putesc(&out, ent[e].path, tx_len(ent[e].path, CAP)); put(&out, ":", 1); puts_(&out, f[2]);
            put(&out, "\t", 1); puts_(&out, f[0]); puts_(&out, "\tstatic="); puts_(&out, f[4]);
            puts_(&out, "\tvariadic="); puts_(&out, f[5]); put(&out, "\t", 1);
            puts_(&out, f[6]); put(&out, " ", 1); puts_(&out, f[1]); puts_(&out, f[7]); put(&out, "\n", 1);
            hits++;
        }
    }
    printf("%sDEF\tname=%s\tcount=%d\n", out.p ? out.p : "", name, hits);
    return 0;
}

static int cmd_dump(int e) {
    load_shard(e);
    if (ent[e].ok != 1) die2("cannot index", ent[e].path);
    {   Buf o = {0, 0, 0}; const char *s = ent[e].shard, *end = s + ent[e].shn;
        puts_(&o, "FILE\t"); puts_(&o, ent[e].path); put(&o, "\t", 1); puts_(&o, ent[e].sha); put(&o, "\n", 1);
        for (; s < end; s = next_row(s, end)) if (*s != '#') put(&o, s, (long)(next_row(s, end) - s));
        return sy_write_all(1, o.p, o.n) == 0 ? 0 : 2;
    }
}

static const char *shown(int e) { return ent[e].path; }
static int cmd_uses(int e) {
    int k, cnt = 0;
    real_all();
    epoch++; closure(e);
    for (k = 0; k < nent; k++) if (k != e && ent[k].mark == epoch) { printf("USE\t%s\n", shown(k)); cnt++; }
    printf("USES\tfile=%s\tcount=%d\n", shown(e), cnt);
    return 0;
}
static int cmd_users(int t) {
    int e, cnt = 0, nl = nent;
    real_all();
    for (e = 0; e < nl; e++) {
        if (!ent[e].listed || e == t) continue;
        epoch++; closure(e);
        if (ent[t].mark == epoch) { printf("USER\t%s\n", shown(e)); cnt++; }
    }
    printf("USERS\tfile=%s\tcount=%d\n", shown(t), cnt);
    return 0;
}

/* undeclared: non-static D in module files, by name */
typedef struct { const char *name; long nl; int e; long line; int danger; int next; } Def;
static Def *defs; static int ndefs, defcap, hdef[HASHN];
static unsigned long hashn(const char *s, long n) { unsigned long h = 1469598103934665603UL; long i; for (i = 0; i < n; i++) { h ^= (unsigned char)s[i]; h *= 1099511628211UL; } return h; }
static int def_head(const char *s, long n) {
    unsigned long h = hashn(s, n) & (HASHN - 1);
    while (hdef[h]) { Def *D = &defs[hdef[h] - 1]; if (tx_same(D->name, D->nl, s, n)) return hdef[h] - 1; h = (h + 1) & (HASHN - 1); }
    return -1;
}
static void def_add(const char *s, long n, int e, long line, int danger) {
    unsigned long h = hashn(s, n) & (HASHN - 1); int head = def_head(s, n);
    if (ndefs == defcap) {
        defcap = defcap ? defcap * 2 : 4096;
        defs = mm_grow(defs, (long)defcap * (long)sizeof *defs);
        if (!defs) die("out of memory");
    }
    defs[ndefs].name = s; defs[ndefs].nl = n; defs[ndefs].e = e; defs[ndefs].line = line; defs[ndefs].danger = danger;
    defs[ndefs].next = -1;
    if (head >= 0) { defs[ndefs].next = defs[head].next; defs[head].next = ndefs; }
    else { while (hdef[h]) h = (h + 1) & (HASHN - 1); hdef[h] = ndefs + 1; }
    ndefs++;
}
static void collect_defs(int e) {
    const char *s, *end; int module = 0; char *f[9];
    load_shard(e);
    s = ent[e].shard; end = s + ent[e].shn;
    for (; s < end; s = next_row(s, end)) if (*s == 'M') module = 1;
    if (!module) return;
    for (s = ent[e].shard; s < end; s = next_row(s, end)) {
        const char *nm; long nn;
        if (*s != 'D' || fields(s, end, row, sizeof row, f, 9) != 8 || f[4][0] == '1') continue;
        nn = field_at(s, end, 1, &nm);
        {   long rl = tx_len(f[6], CAP);
            int dbl = (has_word(f[6], rl, "double") || has_word(f[6], rl, "float")) && tx_chr(f[6], rl, '*') < 0;
            def_add(nm, nn, e, tx_strtol(f[2], 0, 10), (f[5][0] == '1') | (dbl << 1));
        }
    }
}
/* 1 when caller E itself has a D, P or X named S */
static int declares(int e, const char *s, long n) {
    const char *p = ent[e].shard, *end = p + ent[e].shn;
    for (; p < end; p = next_row(p, end)) {
        const char *nm; long nn;
        if (*p != 'D' && *p != 'P' && *p != 'X') continue;
        nn = field_at(p, end, 1, &nm);
        if (tx_same(nm, nn, s, n)) return 1;
    }
    return 0;
}
typedef struct { const char *name; long nl; long line; int sites; int d; } Hit;
static int cmd_undeclared(int *callers, int nc) {
    int c, e, danger = 0, info = 0, transitive = 0, files = 0, nl;
    static Hit hits[16384];
    real_all();
    for (c = 0; c < nc; c++) { epoch++; closure(callers[c]); }   /* reach every module the callers can see */
    nl = nent;
    for (e = 0; e < nl; e++) if (ent[e].listed || ent[e].mark) collect_defs(e);
    for (c = 0; c < nc; c++) {
        int ce = callers[c], nh = 0, h, any = 0; const char *s, *end;
        load_shard(ce); resolve_uses(ce);
        s = ent[ce].shard; end = s + ent[ce].shn;
        for (; s < end; s = next_row(s, end)) {
            const char *nm, *ln; long nn; int d, j, seen = 0, dd = -1;
            if (*s != 'C') continue;
            nn = field_at(s, end, 1, &nm);
            if ((d = def_head(nm, nn)) < 0) continue;
            for (h = 0; h < nh; h++) if (tx_same(hits[h].name, hits[h].nl, nm, nn)) { hits[h].sites++; seen = 1; break; }
            if (seen) continue;
            if (declares(ce, nm, nn)) dd = -2;
            else for (j = d; j >= 0; j = defs[j].next) {
                int k, direct = defs[j].e == ce;
                for (k = 0; k < ent[ce].nuse && !direct; k++) if (ent[ce].use[k] == defs[j].e) direct = 1;
                if (direct) { dd = -2; break; }
                if (dd == -1 || defs[j].danger > defs[dd].danger) dd = j;
            }
            if (nh == 16384) die("too many module-defined names called in one file");
            field_at(s, end, 2, &ln);
            hits[nh].name = nm; hits[nh].nl = nn; hits[nh].line = tx_strtol(ln, 0, 10); hits[nh].sites = 1; hits[nh].d = dd; nh++;
        }
        if (nh) { epoch++; closure(ce); }
        for (h = 0; h < nh; h++) {
            Def *D; const char *why; int tr;
            if (hits[h].d < 0) continue;   /* declared by the caller or reached through a direct use */
            D = &defs[hits[h].d];
            why = D->danger == 3 ? "variadic+double" : D->danger == 1 ? "variadic" : D->danger == 2 ? "double" : "-";
            tr = ent[D->e].mark == epoch;
            printf("%s\t%s:%ld\t%.*s\tsites=%d\tdef=%s:%ld\twhy=%s\treach=%s\n", D->danger ? "DANGER" : "INFO",
                   ent[ce].path, hits[h].line, (int)hits[h].nl, hits[h].name, hits[h].sites, ent[D->e].path, D->line, why,
                   tr ? "transitive" : "none");
            if (D->danger) danger++; else info++;
            transitive += tr;
            any = 1;
        }
        files += any;
    }
    printf("UNDECLARED\tdanger=%d\tinfo=%d\ttransitive=%d\tcallers=%d\tscanned=%d\n", danger, info, transitive, files, nc);
    return danger ? 1 : 0;
}

static void usage(void) {
    fprintf(stderr, "usage: symindex.cx [--index DIR] [--in LIST] (update [--verify] | def NAME | calls NAME[,NAME...] [--tracked | FILE...]"
                    " | uses FILE | users FILE | undeclared (--tracked | FILE...) | dump FILE)\n");
    exit(2);
}

int main(int argc, char **argv) {
    int a = 1, r; const char *list = 0, *cmd;
    t0 = sy_now_ms();
    arena = ar_new(1L << 32);
    if (!arena) die("cannot create the arena");
    if (cx_fmt(idx, sizeof idx, "out/symindex/v1")) die("path");
    while (a < argc && argv[a][0] == '-' && argv[a][1] == '-') {
        if (tx_eqz(argv[a], "--index") && a + 1 < argc) { if (cx_fmt(idx, sizeof idx, "%s", argv[a + 1])) die("path too long"); a += 2; }
        else if (tx_eqz(argv[a], "--in") && a + 1 < argc) { list = argv[a + 1]; a += 2; }
        else usage();
    }
    if (a >= argc) usage();
    cmd = argv[a++];
    if ((r = sy_realpath(".", root, sizeof root)) < 0) die("cannot resolve the root");
    root_n = r;
    {   /* the index directory, parents included */
        char d[4096]; long n = tx_len(idx, 4095), k; int m;
        for (k = 1; k <= n; k++) if (k == n || idx[k] == '/') {
            if (tx_copy(d, sizeof d, idx, k)) die("path too long");
            m = sy_mkdir(d, 0755);
            if (m != 0 && m != -EEXIST) die2("cannot make the index directory", d);
        }
    }
    load_manifest();
    if (list) set_list(list); else set_tracked();
    if (tx_eqz(cmd, "update")) {
        if (a < argc && tx_eqz(argv[a], "--verify")) { verify = 1; a++; }
        if (a != argc) usage();
        update_all(); save_manifest(); report(1);
        return n_deferred ? 3 : 0;
    }
    {   /* every query: the files it names join the set first, then the incremental update */
        int named[4096], nn = 0, k, all = 0;
        if (tx_eqz(cmd, "def")) { if (argc - a != 1) usage(); }
        else if (tx_eqz(cmd, "calls")) {
            char *p;
            if (argc - a < 1) usage();
            p = zkeep(argv[a++]);
            while (*p) {
                char *s = p; while (*p && *p != ',') p++;
                if (*p) *p++ = 0;
                if (!*s) continue;
                if (nnames == 64) die("too many names");
                names[nnames] = s; namel[nnames] = tx_len(s, 256); nnames++;
            }
            if (a == argc || (argc - a == 1 && tx_eqz(argv[a], "--tracked"))) all = 1;
            else for (; a < argc; a++) { if (nn == 4096) die("too many files"); named[nn++] = entry_for(argv[a], 0); }
        } else if (tx_eqz(cmd, "uses") || tx_eqz(cmd, "users") || tx_eqz(cmd, "dump")) {
            if (argc - a != 1) usage();
            named[nn++] = entry_for(argv[a], 0);
        } else if (tx_eqz(cmd, "undeclared")) {
            if (argc - a < 1) usage();
            if (argc - a == 1 && tx_eqz(argv[a], "--tracked")) all = 1;
            else for (; a < argc; a++) { if (nn == 4096) die("too many files"); named[nn++] = entry_for(argv[a], 0); }
        } else usage();
        update_all();
        for (k = 0; k < nn; k++) index_one(named[k]);
        save_manifest(); report(0);
        if (n_deferred) { fprintf(stderr, "symindex: the index is unfinished; run update again\n"); return 3; }
        if (tx_eqz(cmd, "def")) return cmd_def(argv[a]);
        if (tx_eqz(cmd, "dump")) return cmd_dump(named[0]);
        if (tx_eqz(cmd, "uses")) return cmd_uses(named[0]);
        if (tx_eqz(cmd, "users")) return cmd_users(named[0]);
        if (tx_eqz(cmd, "calls")) {
            Buf out = {0, 0, 0}; int e;
            if (all) { for (e = 0; e < nent; e++) if (ent[e].listed) calls_of(&out, e); }
            else for (k = 0; k < nn; k++) calls_of(&out, named[k]);
            return sy_write_all(1, out.p ? out.p : "", out.n) == 0 ? 0 : 2;
        }
        {   int *callers = mm_alloc((long)(nent + 1) * (long)sizeof(int)), nc = 0, e;
            if (!callers) die("out of memory");
            if (all) { for (e = 0; e < nent; e++) if (ent[e].listed && ent[e].ok == 1) callers[nc++] = e; }
            else for (k = 0; k < nn; k++) callers[nc++] = named[k];
            return cmd_undeclared(callers, nc);
        }
    }
}
