/* tools/check-team-pulse.cx -- fixture tests for tools/team-pulse.cx (no real tmux).
 *
 *   sh ./unisacc.com tools/check-team-pulse.cx
 *
 * Feeds realistic capture samples: FILTERED curly apostrophe + cybersecurity care line;
 * Codex/omp/Claude context bars; commit STALLED vs analysis IDLE_LONG; mutant-no-stall.
 * Ends with CHECK_TEAM_PULSE. */
#pragma unisa use cxlib.ckassert
#pragma unisa use cxlib.ckrun
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use sys.posix
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

static char out[1 << 16];
static char root[900], fx[950], tab[950], cwd[800];

static int run_tp(const char *extra) {
    char cmd[2400];
    if (cx_fmt(cmd, sizeof cmd,
        "sh '%s/unisacc.com' '%s/tools/team-pulse.cx' -- --windows-table '%s' --fixture '%s' %s",
        cwd, cwd, tab, fx, extra && extra[0] ? extra : "")) return -1;
    return ckk_sh_t("check-team-pulse", cmd, out, (int)sizeof out, 55);
}

/* write fixture bytes (includes U+2019) via sy_write_file */
static int write_fixture(void) {
    /* real-shaped samples */
    static const char body[] =
        "=== PANE w-work ===\n"
        "doing tools\n"
        "Working...\n"
        "esc to cancel\n"
        "Context 42% left · Context 58% used\n"
        "=== PANE w-idle ===\n"
        "done.\n"
        ">\n"
        "=== PANE w-filt ===\n"
        "We take extra care with some cybersecurity requests.\n"
        "This content can\xe2\x80\x99t be shown\n"
        "=== PANE w-wait ===\n"
        "Waiting for input\n"
        "Do you want to continue?\n"
        "=== PANE w-codex ===\n"
        ">\n"
        "Context 11% left · Context 89% used\n"
        "=== PANE w-omp ===\n"
        ">\n"
        "\xe2\x96\xb6\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80" "8%\n"
        "=== PANE w-claude ===\n"
        "Working...\n"
        "esc to cancel\n"
        "ctx 51%\n"
        "=== PANE w-anal ===\n"
        "reviewing\n"
        ">\n";
    return sy_write_file(fx, body, (int64_t)(sizeof body - 1), 0600);
}

int main(void) {
    char cmd[3200]; int rc; long now;
    const char *td = sy_env("TMPDIR");
    if (!td || !td[0]) td = "/tmp";
    if (ckk_sh_t("check-team-pulse", "pwd", out, (int)sizeof out, 20) != 0) return 2;
    cx_fmt(cwd, sizeof cwd, "%s", out);
    { long n = tx_len(cwd, sizeof cwd); while (n > 0 && cwd[n - 1] == '\n') cwd[--n] = 0; }
    now = sy_wall_s();
    if (cx_fmt(root, sizeof root, "%s/tp-check-%ld", td, now % 1000000000)) return 2;
    if (cx_fmt(fx, sizeof fx, "%s/fixture.txt", root) || cx_fmt(tab, sizeof tab, "%s/wins.tsv", root)) return 2;
    sy_remove_all(root);
    if (sy_mkdir_all(root, 0700)) return 2;

    if (cx_fmt(cmd, sizeof cmd,
        "printf 'window\\tmodel\\tlane\\twrite_prefix\\tkind\\n"
        "w-work\\tm\\tmain\\ttools/\\tcommit\\n"
        "w-idle\\tm\\tmain\\ttools/\\tcommit\\n"
        "w-filt\\tm\\tmain\\ttools/\\tcommit\\n"
        "w-wait\\tm\\tmain\\ttools/\\tcommit\\n"
        "w-codex\\tm\\tmain\\ttools/\\tcommit\\n"
        "w-omp\\tm\\tmain\\ttools/\\tcommit\\n"
        "w-claude\\tm\\tmain\\ttools/\\tcommit\\n"
        "w-anal\\tm\\tmain\\ttools/\\tanalysis\\n' > '%s'", tab)) return 2;
    ck(ckk_sh_t("check-team-pulse", cmd, out, (int)sizeof out, 10) == 0, "seed-table");
    ck(write_fixture() == 0, "seed-fixture");

    rc = run_tp("--stall-min 99999");
    ck(rc == 0, "run-rc");
    ck(ckk_has(out, (int)sizeof out, "PULSE\tw-work\tWORKING\tleft=42(codex-left)\t"), "status-working-codex-left");
    ck(ckk_has(out, (int)sizeof out, "PULSE\tw-idle\tIDLE\t"), "status-idle");
    ck(ckk_has(out, (int)sizeof out, "PULSE\tw-filt\tFILTERED\t"), "status-filtered-curly");
    ck(ckk_has(out, (int)sizeof out, "PULSE\tw-wait\tWAITING_INPUT\t"), "status-waiting");
    ck(ckk_has(out, (int)sizeof out, "PULSE\tw-codex\tIDLE\tleft=11(codex-left)\t"), "ctx-codex-left11");
    ck(ckk_has(out, (int)sizeof out, "PULSE\tw-omp\tIDLE\tleft=92(omp-used)\t"), "ctx-omp-bar-used");
    ck(ckk_has(out, (int)sizeof out, "PULSE\tw-claude\tWORKING\tleft=49(claude-used)\t"), "ctx-claude-used");
    ck(ckk_has(out, (int)sizeof out, "CTX_LOW"), "flag-ctx-low");
    ck(ckk_has(out, (int)sizeof out, "TEAM_PULSE\twindows=8\t"), "summary");

    {
        char extra[220];
        if (cx_fmt(extra, sizeof extra, "--stall-min 1 --now %ld", now + 86400 * 365)) return 2;
        rc = run_tp(extra);
        ck(rc == 0 && ckk_has(out, (int)sizeof out, "PULSE\tw-idle\tIDLE\t") &&
           ckk_has(out, (int)sizeof out, "STALLED"), "stalled-commit-idle");
        ck(rc == 0 && ckk_has(out, (int)sizeof out, "PULSE\tw-anal\tIDLE\t") &&
           ckk_has(out, (int)sizeof out, "IDLE_LONG"), "idle-long-analysis");
        if (cx_fmt(extra, sizeof extra, "--stall-min 1 --now %ld --mutant-no-stall", now + 86400 * 365)) return 2;
        rc = run_tp(extra);
        ck(rc == 0 && !ckk_has(out, (int)sizeof out, "STALLED") &&
           !ckk_has(out, (int)sizeof out, "IDLE_LONG"), "mutant-no-stall");
    }

    if (cx_fmt(cmd, sizeof cmd,
        "printf 'window\\tmodel\\tlane\\twrite_prefix\\tkind\\nmiss\\tm\\tmain\\ttools/\\tcommit\\n' > '%s'", tab)) return 2;
    ck(ckk_sh_t("check-team-pulse", cmd, out, (int)sizeof out, 10) == 0, "seed-miss-table");
    rc = run_tp("--stall-min 99999");
    ck(rc == 0 && ckk_has(out, (int)sizeof out, "PULSE\tmiss\tUNKNOWN\t"), "missing-pane-unknown");

    sy_remove_all(root);
    {
        int failed = ck_failures();
        int total = ck_assertions();
        printf("TEAM_PULSE_SUMMARY\tfailed=%d\tpassed=%d\n", failed, total - failed);
        if (!failed) printf("CHECK_TEAM_PULSE\n");
        return failed ? 1 : 0;
    }
}
