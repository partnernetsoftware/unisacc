/* tools/check-team-pulse.cx -- fixture tests for tools/team-pulse.cx (no real tmux).
 *
 * Real-shaped captures: Codex Ask/Working, omp ╰─/spinner, Cursor Auto/Running,
 * Claude ❯ idle, FILTERED curly+care, exclusive write_prefix "-", analysis IDLE_LONG,
 * Gemini agy ● Bash duration WORKING, 回报发 cc WAITING_CC footer, mutants must red.
 * Ends with CHECK_TEAM_PULSE. */
#pragma unisa use cxlib.ckassert
#pragma unisa use cxlib.ckrun
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use sys.posix
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

static char out[1 << 16];
static char root[900], fx[950], tab[950], cwd[800];

static int run_tp(const char *extra) {
    char cmd[2400];
    if (cx_fmt(cmd, sizeof cmd,
        "sh '%s/unisacc.com' '%s/tools/team-pulse.cx' -- --windows-table '%s' --fixture '%s' %s",
        cwd, cwd, tab, fx, extra && extra[0] ? extra : "")) return -1;
    return ckk_sh_t("check-team-pulse", cmd, out, (int)sizeof out, 55);
}

static int write_fixture(void) {
    /* Real capture shapes from tmux 2026-11-23 (incl. live agyneon/agy-flow tails) */
    static const char body[] =
        "=== PANE w-codex-idle ===\n"
        "last reply\n"
        "\xe2\x80\xba Ask Codex to do anything\n"
        "Context 11% left \xc2\xb7 Context 89% used\n"
        "=== PANE w-codex-busy ===\n"
        "\xe2\x80\xa2 Working (15s \xe2\x80\xa2 esc to interrupt)\n"
        "Context 40% left \xc2\xb7 Context 60% used\n"
        "=== PANE w-omp-idle ===\n"
        "\xe2\x95\xb0\xe2\x94\x80\n"
        "\xe2\x96\xb6\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80" "8%\n"
        "=== PANE w-omp-done ===\n"
        "\xe5\xbd\x93\xe5\x89\x8d\xe8\xaf\xb7\xe6\xb1\x82\xe5\xb7\xb2\xe4\xbb\x85\xe5\x9b\x9e\xe6\x89\xa7\xe7\xbb\x93\xe6\x9d\x9f\n"
        "\xe2\x95\xb0\xe2\x94\x80\n"
        "=== PANE w-omp-busy ===\n"
        "\xe2\xa0\xbb 17m\n"
        "=== PANE w-csr ===\n"
        "Auto \xc2\xb7 41.7%\n"
        ">\n"
        "=== PANE w-csr-busy ===\n"
        "\xe2\xa0\x80\xe2\xa0\x9f Running  22k tokens\n"
        "ctrl+c to stop\n"
        "Auto \xc2\xb7 17.2%\n"
        "=== PANE w-claude ===\n"
        "\xe2\x9c\xbb Brewed for 13s \xc2\xb7 done 1:48 AM\n"
        "\xe2\x9d\xaf\xc2\xa0\n"
        "ctx 69%\n"
        "=== PANE w-filt ===\n"
        "We take extra care with some cybersecurity requests.\n"
        "This content can\xe2\x80\x99t be shown\n"
        "=== PANE w-anal ===\n"
        "\xe2\x80\xba Ask Codex to do anything\n"
        "=== PANE w-none ===\n"
        "random noise without markers\n"
        /* agy: long bash, footer only auto·model (no esc to cancel) -> WORKING */
        "=== PANE w-agy-busy ===\n"
        "\xe2\x97\x8f Bash(sh ./unisacc.com tools/check-precommit-derive.cx) 2m 14s\n"
        "  running in background\n"
        ">\n"
        "auto \xc2\xb7 Gemini 4 Neon \xc2\xb7 medium\n"
        /* live-shaped: spinner + Running command + esc to cancel */
        "=== PANE w-agy-run ===\n"
        "\xe2\x97\x8f Edited 1 file (check-release-prep.cx)\n"
        "\xe2\x97\x8b Running (CC=/usr/bin/cc ./tools/bound 55 sh ./unisacc.com tools/check-x.cx) (ctrl+o to expand)\n"
        "\xe2\xa0\xbb  Running command...\n"
        ">\n"
        "esc to cancel                                                                                                                       auto \xc2\xb7 Gemini 4 Argon \xc2\xb7 high\n"
        /* true idle agy */
        "=== PANE w-agy-idle ===\n"
        "done\n"
        ">\n"
        "auto \xc2\xb7 Gemini 4 Neon \xc2\xb7 medium\n"
        /* wait for cc */
        "=== PANE w-agy-wait ===\n"
        "\xe6\x94\xb9\xe5\xae\x8c\xe6\x8f\x90\xe4\xba\xa4\xef\xbc\x8c\xe8\xb4\xb4\xe5\x8e\x9f\xe8\xa1\x8c\xe3\x80\x82\xe6\x8a\xa5\xe5\x91\x8a\xe5\x8f\x91 cc\xe3\x80\x82\n"
        "  [ReplyCmd] bin/mux envelope \"1:cc\" \"<title>\" \"<body>\"\n"
        ">\n"
        "auto \xc2\xb7 Gemini 4 Neon \xc2\xb7 medium\n";
    return sy_write_file(fx, body, (int64_t)(sizeof body - 1), 0600);
}

int main(void) {
    char cmd[5200]; int rc; long now;
    const char *td = sy_env("TMPDIR");
    if (!td || !td[0]) td = "/tmp";
    if (ckk_sh_t("check-team-pulse", "pwd", out, (int)sizeof out, 20) != 0) return 2;
    cx_fmt(cwd, sizeof cwd, "%s", out);
    { long n = tx_len(cwd, sizeof cwd); while (n > 0 && cwd[n - 1] == '\n') cwd[--n] = 0; }
    now = sy_wall_s();
    if (cx_fmt(root, sizeof root, "%s/tp-check-%ld", td, now % 1000000000)) return 2;
    if (cx_fmt(fx, sizeof fx, "%s/fixture.txt", root) || cx_fmt(tab, sizeof tab, "%s/wins.tsv", root)) return 2;
    sy_remove_all(root);
    if (sy_mkdir_all(root, 0700)) return 2;

    if (cx_fmt(cmd, sizeof cmd,
        "printf 'window\\tmodel\\tlane\\twrite_prefix\\tkind\\tgit_ref\\n"
        "w-codex-idle\\tgpt-sol\\tmain\\t-\\tanalysis\\t-\\n"
        "w-codex-busy\\tgpt-sol\\tmain\\t-\\tanalysis\\t-\\n"
        "w-omp-idle\\tsonnet\\tmain\\ttools/team-pulse.cx\\tcommit\\t-\\n"
        "w-omp-done\\tdeepseek-flash\\tmain\\ttools/team-pulse.cx\\tcommit\\t-\\n"
        "w-omp-busy\\tsonnet\\tmain\\ttools/team-pulse.cx\\tcommit\\t-\\n"
        "w-csr\\tcursor-auto\\tmain\\ttools/team-pulse.cx\\tcommit\\t-\\n"
        "w-csr-busy\\tcursor-auto\\tmain\\ttools/team-pulse.cx\\tcommit\\t-\\n"
        "w-claude\\tdeepseek-eco\\tmain\\tcx/sys/proc\\tcommit\\tv0.0.96\\n"
        "w-filt\\tcursor-auto\\tmain\\ttools/team-pulse.cx\\tcommit\\t-\\n"
        "w-anal\\tgpt-sol\\tmain\\ttools/team-pulse.cx\\tanalysis\\t-\\n"
        "w-none\\tsonnet\\tmain\\ttools/team-pulse.cx\\tcommit\\t-\\n"
        "w-agy-busy\\tgemini-neon\\tmain\\ttools/team-pulse.cx\\tcommit\\t-\\n"
        "w-agy-run\\tgemini-argon\\tmain\\ttools/team-pulse.cx\\tcommit\\t-\\n"
        "w-agy-idle\\tgemini-neon\\tmain\\ttools/team-pulse.cx\\tcommit\\t-\\n"
        "w-agy-wait\\tgemini-neon\\tmain\\ttools/team-pulse.cx\\tcommit\\t-\\n' > '%s'", tab)) return 2;
    ck(ckk_sh_t("check-team-pulse", cmd, out, (int)sizeof out, 10) == 0, "seed-table");
    ck(write_fixture() == 0, "seed-fixture");

    rc = run_tp("--stall-min 99999 --wait-cc-min 99999");
    ck(rc == 0, "run-rc");
    ck(ckk_has(out, (int)sizeof out, "PULSE\tw-codex-idle\tIDLE\tleft=11(codex-left)\t-\t"), "codex-idle-ask");
    ck(ckk_has(out, (int)sizeof out, "PULSE\tw-codex-busy\tWORKING\tleft=40(codex-left)\t-\t"), "codex-busy-working");
    ck(ckk_has(out, (int)sizeof out, "PULSE\tw-omp-idle\tIDLE\tleft=92(omp-used)\t"), "omp-idle-box");
    ck(ckk_has(out, (int)sizeof out, "PULSE\tw-omp-done\tIDLE\t"), "omp-idle-receipt");
    ck(ckk_has(out, (int)sizeof out, "PULSE\tw-omp-busy\tWORKING\t"), "omp-busy-spinner");
    ck(ckk_has(out, (int)sizeof out, "PULSE\tw-csr\tIDLE\t-\t"), "csr-no-ctx-auto");
    ck(ckk_has(out, (int)sizeof out, "PULSE\tw-csr-busy\tWORKING\t-\t"), "csr-running");
    ck(ckk_has(out, (int)sizeof out, "PULSE\tw-claude\tIDLE\t"), "claude-prompt-idle");
    ck(ckk_has(out, (int)sizeof out, "PULSE\tw-filt\tFILTERED\t"), "filtered-curly");
    ck(ckk_has(out, (int)sizeof out, "PULSE\tw-anal\tIDLE\t-\t-\t"), "anal-no-commit");
    ck(ckk_has(out, (int)sizeof out, "PULSE\tw-none\tUNKNOWN\t"), "unknown-only-noise");
    ck(ckk_has(out, (int)sizeof out, "PULSE\tw-agy-busy\tWORKING\t"), "agy-bash-duration-working");
    ck(ckk_has(out, (int)sizeof out, "PULSE\tw-agy-run\tWORKING\t"), "agy-running-command");
    ck(ckk_has(out, (int)sizeof out, "PULSE\tw-agy-idle\tIDLE\t"), "agy-true-idle");
    ck(ckk_has(out, (int)sizeof out, "PULSE\tw-agy-wait\tIDLE\t"), "agy-wait-still-idle-when-fresh");
    {
        const char *p = out; int csr_low = 0;
        while ((p = strstr(p, "PULSE\tw-csr\t"))) {
            const char *e = strchr(p, '\n');
            if (e && tx_find(p, (long)(e - p), "CTX_LOW", 7) >= 0) csr_low = 1;
            break;
        }
        ck(!csr_low, "csr-not-ctx-low");
    }

    {
        char extra[320];
        if (cx_fmt(extra, sizeof extra, "--stall-min 1 --wait-cc-min 1 --now %ld", now + 86400 * 365)) return 2;
        rc = run_tp(extra);
        ck(rc == 0 && ckk_has(out, (int)sizeof out, "PULSE\tw-omp-idle\tIDLE\t") &&
           ckk_has(out, (int)sizeof out, "STALLED"), "stalled-commit-idle");
        ck(rc == 0 && ckk_has(out, (int)sizeof out, "PULSE\tw-anal\tIDLE\t") &&
           ckk_has(out, (int)sizeof out, "IDLE_LONG"), "idle-long-analysis");
        ck(rc == 0 && ckk_has(out, (int)sizeof out, "PULSE\tw-agy-wait\tWAITING_CC\t"), "waiting-cc-status");
        ck(rc == 0 && ckk_has(out, (int)sizeof out, "WAITING_CC\tw-agy-wait"), "waiting-cc-footer");
        ck(rc == 0 && ckk_has(out, (int)sizeof out, "waiting_cc=1"), "waiting-cc-summary");
        /* busy bash must not become STALLED while WORKING */
        ck(rc == 0 && ckk_has(out, (int)sizeof out, "PULSE\tw-agy-busy\tWORKING\t"), "agy-busy-not-stalled");
        if (cx_fmt(extra, sizeof extra, "--stall-min 1 --wait-cc-min 1 --now %ld --mutant-no-stall", now + 86400 * 365)) return 2;
        rc = run_tp(extra);
        ck(rc == 0 && !ckk_has(out, (int)sizeof out, "STALLED") &&
           !ckk_has(out, (int)sizeof out, "IDLE_LONG"), "mutant-no-stall");
        if (cx_fmt(extra, sizeof extra, "--stall-min 99999 --wait-cc-min 99999 --mutant-no-running-shell")) return 2;
        rc = run_tp(extra);
        ck(rc == 0 && !ckk_has(out, (int)sizeof out, "PULSE\tw-agy-busy\tWORKING\t"), "mutant-no-running-shell");
        if (cx_fmt(extra, sizeof extra, "--stall-min 1 --wait-cc-min 1 --now %ld --mutant-no-wait-cc", now + 86400 * 365)) return 2;
        rc = run_tp(extra);
        ck(rc == 0 && !ckk_has(out, (int)sizeof out, "PULSE\tw-agy-wait\tWAITING_CC\t") &&
           !ckk_has(out, (int)sizeof out, "WAITING_CC\tw-agy-wait"), "mutant-no-wait-cc");
    }

    sy_remove_all(root);
    {
        int failed = ck_failures();
        int total = ck_assertions();
        printf("TEAM_PULSE_SUMMARY\tfailed=%d\tpassed=%d\n", failed, total - failed);
        if (!failed) printf("CHECK_TEAM_PULSE\n");
        return failed ? 1 : 0;
    }
}
