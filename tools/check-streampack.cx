/* streampack keeps the source package version and the resource row width.
 * The writer used to stamp "P 3" on every output while copying the resource
 * section verbatim, so a six-word P4 row ended up inside a package declared
 * P3: unreadable by every reader and silently unsigned-by-structure.  These
 * cases pin both directions on synthetic packages: P3 output is byte-for-byte
 * the old header plus the copied model block and resource section, P4 output
 * keeps six-word rows under a P4 header, and the product decoders accept it.
 * Local Linux host only; no foreign target claim.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use runtime.package_decode
#pragma unisa use runtime.packagestruct
#pragma unisa use runtime.package_lifetime
#pragma unisa use runtime.model_number
#pragma unisa use compiler.bindstage
#pragma unisa use text.text
static int failed;
static void *al(void *ctx, size_t n) { (void)ctx; return malloc(n ? n : 1); }
static void fr(void *p) { free(p); }
static void ck(int ok, const char *n) { printf("%s\t%s\n", ok ? "PASS" : "FAIL", n); if (!ok) failed++; }
static void die(const char *s) { fprintf(stderr, "check-streampack: %s\n", s); exit(2); }
static char *slurp(const char *p, size_t *n) { char *s = cx_read(p, n); if (!s) die(p); return s; }
static void copy(char *d, size_t *at, const char *s, size_t n) { size_t i; for (i = 0; i < n; i++) d[(*at)++] = s[i]; }
static void app(char *d, size_t cap, size_t *at, const char *s) {
    size_t n = strlen(s);
    if (*at + n >= cap) die("builder capacity");
    copy(d, at, s, n);
}
/* 与 tools/cxlib/streampack.cx 的 NAMES 同序同数：units 是第八条网络流，
 * 路由在 /multi/ 下（writer 只从 multi 路由取它）。 */
static const char *names[8] = {"e2", "e1", "units", "e3", "e4", "prune", "lower", "elf"};
/* build(ver): synthetic source package; fills block offsets and resource offset */
static size_t build(char *buf, size_t cap, int ver, size_t *model_at, size_t *res_at) {
    size_t at = 0; int i; char t[256];
    cx_fmt(t, sizeof t, "P %d 8 8 2\n", ver); app(buf, cap, &at, t);
    for (i = 0; i < 8; i++) {
        const char *route = strcmp(names[i], "units") ? "lnx/x86_64/image/O2" : "lnx/x86_64/multi/run/O2";
        cx_fmt(t, sizeof t, "D %s %s t t %d\n", route, names[i], i); app(buf, cap, &at, t);
    }
    for (i = 0; i < 8; i++) {
        model_at[i] = at;
        if (cx_fmt(t, sizeof t, "M 1 1 1 0\n%c", 'A' + i)) die("format");
        app(buf, cap, &at, t);
    }
    *res_at = at;
    if (ver >= 4) app(buf, cap, &at, "F 1 1 1 0 0\nkvF 1 1 1 0 0\njw");
    else app(buf, cap, &at, "F 1 1\nkvF 1 1\njw");
    return at;
}
/* package bytes of stream k from the produced product: base + package + footer */
static char *out_pkg(const char *file, size_t bn, size_t *pn) {
    size_t n; char *s = slurp(file, &n), *p;
    if (n < bn + 16 || memcmp(s + n - 16, "UNIPKG1\n", 8)) die("output footer");
    *pn = n - bn - 16;
    if (*pn < 4 || s[bn] != 'P' || s[bn + 1] != ' ') die("output package start");
    p = malloc(*pn); if (!p) die("alloc"); { size_t k = 0; copy(p, &k, s + bn, *pn); } free(s); return p;
}
int main(int argc, char **argv) {
    static char src[8192]; size_t model_at[8], res_at, srcn, bn, pn, i; char p[4096], t[256];
    CxPackageDecode d = {0}; d.allocate = al; d.release = fr;
    char root[4096], work[4096], pkgroot[4096];
    np_subreaper();
    if (argc == 3) { cx_fmt(root, sizeof root, "%s", argv[1]); cx_fmt(work, sizeof work, "%s", argv[2]); }
    else if (argc == 1) {
        if (!getcwd(root, sizeof root)) die("getcwd");
        cx_fmt(work, sizeof work, "%s/streampack-%d", sy_tmpdir(), (int)getpid());
    } else die("usage ROOT OUTDIR");
    if (mkdir(work, 0700)) die("work directory must be new");
    { size_t n; char *b = slurp("/bin/true", &n); (void)b; bn = n; free(b); }
    for (int pass = 3; pass <= 4; pass += 1) {
        char outdir[4096], pkgpath[4096], comfile[4096]; char *pkg; size_t at = 0;
        srcn = build(src, sizeof src, pass, model_at, &res_at);
        cx_fmt(pkgpath, sizeof pkgpath, "%s/source-p%d.pkg", work, pass); 
        int fd = open(pkgpath, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
        if (fd < 0) die("source package create");
        if (write(fd, src, srcn) != (ssize_t)srcn) die("source package write");
        close(fd);
        cx_fmt(outdir, sizeof outdir, "%s/out-p%d", work, pass);
        { np_result r; char why[512];
          char *av[] = {"./tools/bound", "30", "sh", "./unisacc.com", "tools/stream-pack.cx",
                        "/bin/true", pkgpath, outdir, "lnx/x86_64", "O2", 0};
          if (np_run(av, root, 0, 40, &r, why, sizeof why)) die(why);
          cx_fmt(t, sizeof t, "p%d.writer-rc", pass);
          ck(r.rc == 0 && r.residue == 0, t);
          if (r.rc) fputs(r.err ? r.err : "", stderr);
          np_free(&r); }
        for (i = 0; i < 8; i++) {
            size_t hn, blen = (size_t)(model_at[i + 1 < 8 ? i + 1 : 8] - model_at[i]);
            if (i == 7) blen = res_at - model_at[7];
            cx_fmt(comfile, sizeof comfile, "%s/unisacc-stream%zu.com", outdir, i + 1);
            pkg = out_pkg(comfile, bn, &pn);
            cx_fmt(t, sizeof t, "P %d 1 1 2\nD stream %s t t 0\n", pass, names[i]);
            hn = strlen(t);
            at = 0;
            { char *want = malloc(hn + blen + (srcn - res_at)); if (!want) die("alloc");
              { size_t k = 0; copy(want, &k, t, hn); copy(want, &k, src + model_at[i], blen); copy(want, &k, src + res_at, srcn - res_at); }
              { char label[128]; cx_fmt(label, sizeof label, "p%d.stream%zu-byte-exact", pass, i + 1);
                ck(pn == hn + blen + (srcn - res_at) && !memcmp(pkg, want, pn), label); }
              free(want); }
            free(pkg);
        }
        cx_fmt(comfile, sizeof comfile, "%s/unisacc-stream1.com", outdir);
        pkg = out_pkg(comfile, bn, &pn);
        { int v = 9, rc = cxps_audit((const unsigned char *)pkg, (long)pn, &v);
          cx_fmt(t, sizeof t, "p%d.audit-accepts", pass); ck(rc == 0 && v == pass, t); }
        d = (CxPackageDecode){0}; d.allocate = al; d.release = fr;
        { int rc = cxpk_decode(&d, (const unsigned char *)pkg, (long)pn);
          cx_fmt(t, sizeof t, "p%d.decode-accepts", pass); ck(rc == 0 && d.package.ver == pass && d.package.nr == 2, t); if (rc || d.package.ver != pass || d.package.nr != 2) fprintf(stderr, "decode rc=%d ver=%d nr=%d why=%s\n", rc, d.package.ver, d.package.nr, d.why ? d.why : "-");
          cx_fmt(t, sizeof t, "p%d.decode-resource-rows", pass);
          ck(d.package.res[0].codec == 0 && d.package.res[0].rawlen == 1 && d.package.res[0].len == 1, t);
          cxpl_release(&d.package, fr); }
        free(pkg);
        printf("PREPARED\tstreampack-p%d\tno-foreign-target\n", pass);
    }
    (void)p;
    /* Leave nothing behind: the writer's own outputs and source packages. */
    { int left = 0, pass, i; char p[8192], q[8192];
      for (pass = 3; pass <= 4; pass++) {
          if (!cx_fmt(p, sizeof p, "%s/source-p%d.pkg", work, pass)) left += sy_unlink(p) != 0;
          if (!cx_fmt(p, sizeof p, "%s/out-p%d", work, pass)) {
              if (!cx_fmt(q, sizeof q, "%s/streams.json", p)) left += sy_unlink(q) != 0;
              for (i = 1; i <= 8; i++) { if (!cx_fmt(q, sizeof q, "%s/unisacc-stream%d.com", p, i)) left += sy_unlink(q) != 0; }
              left += sy_rmdir(p) != 0;
          }
      }
      left += sy_rmdir(work) != 0;
      ck(left == 0, "A: work directory and outputs removed"); }
    printf("CHECK_STREAMPACK\tfailed=%d\n", failed);
    printf("NOT_CLAIMED\tforeign-target-gold-same-candidate-model\n");
    return failed ? 1 : 0;
}
