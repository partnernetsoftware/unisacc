/* check-mutation-gate.cx -- tools/mutation-gate.cx tells a strong check from a weak one.
 *
 *   sh ./unisacc.com tools/check-mutation-gate.cx
 *   sh ./unisacc.com tools/check-mutation-gate.cx -- --quality-fixture [NATIVE_GATE]
 *
 * A private git repo (mkdtemp under $TMPDIR or /tmp) holds tools/fx.cx; the fixture patch adds a small
 * function with comparisons, a condition, constants, a string and a return.  Cases:
 *   strong-high      exact-output check: score >= 0.6, verdict PASS, rc 0
 *   weak-zero        constant-PASS check (echo failed=0): score 0/N, verdict FAIL, rc 1, survivors listed
 *   weak-coverage    --coverage-check with the constant check reports uncovered >= 1
 *   default-min-0.6 / explicit-min-overrides   default threshold 0.60, --min-score on report wins over conf
 *   uncovered-default-fail   report --min-score 0 on the weak run: uncovered > 0 still FAIL, MG_UNCOVERED blocking
 *   allow-uncovered-pass     same with --allow-uncovered listing both functions: PASS
 *   adjudicated-none / adjudicated-changes-score   --adjudicated with one survivor moves adjudicated off 0
 *   adjudicated-bad-verdict-refused   a verdict word other than equivalent/out-of-scope is rc 2
 *   red-baseline    a check that is red on the unmutated tree is refused, rc 2
 *   reclaim-after-verdict     slots are gone once report wrote a verdict; SUMMARY and session.tsv stay
 *   keep-slots-without-verdict  prep'd dir without SUMMARY keeps its slots
 *   empty-summary-keeps-slots an EMPTY SUMMARY is not a verdict: slots stay, reason=no-summary
 *   foreign-dir-not-mine      a dir with a verdict-looking SUMMARY and slot trees but no conf.tsv/session.tsv
 *                             is named reason=not-mine and nothing is deleted
 *   conf-without-session-not-mine  conf.tsv without session.tsv is not-mine
 *   session-without-conf-not-mine  session.tsv without conf.tsv is not-mine too (the mirror case: flipping
 *                             the conf test to always-true must not stay green)
 *   empty-registration-not-mine    EMPTY conf.tsv + EMPTY session.tsv is not proof of ownership
 *   session-without-state-not-mine a session.tsv with no `state<TAB>VALUE` line is not ours either
 *   reentry-names-paths       a second prep on the same dir refuses, names conf.tsv/session.tsv/slot-N, and
 *                             says reclaim needs a verdict first (reentry-does-not-promise-reclaim)
 *   reclaim-keeps-summary     SUMMARY survives the slot deletion
 *   derive-out-prep / -registered   no --out: <TMPDIR>/unisacc-session-mutation-gate-<stem>-<sha8>, state
 *                             prepared in session.tsv, conf.tsv written -- for an explicit --out as well
 *   derive-out-distinct-per-patch   different patch bytes never share a dir
 *   derive-out-same-stem-distinct-bytes  same file name, different bytes: the content hash separates them
 * Every derived-dir case runs under its own TMPDIR inside the fixture root, so two copies of this check can
 * run at once without seeing each other's sessions.
 * Output: CHECK_MUTATION_GATE<TAB>ok=N<TAB>failed=M (the batch marker needs a TAB after the name); rc 1 on any failure.  Only the scratch is written. */
#pragma unisa use cxlib.ckrun
#pragma unisa use text.text
#pragma unisa use mem.heap

static int ok, failed;
static void ck(int c, const char *n) { if (c) ok++; else { failed++; printf("FAIL %s\n", n); } }

static char T[512];

static void quality_file(const char *relative, const char *body) {
    char path[1024];
    if (cx_fmt(path, sizeof path, "%s/%s", T, relative) || cx_write(path, body, strlen(body)))
        exit(2);
}

static int quality_fixture(const char *native) {
    char script[4096], out[4096], data[1024], path[1024];
    char quoted[1024];
    if (native && (strchr(native, '\'') || cx_fmt(quoted, sizeof quoted, "'%s'", native))) return 2;
    const char *entry = native ? quoted : "sh ./unisacc.com tools/mutation-gate.cx --";
    cx_fmt(script, sizeof script, "mkdir -p '%s'/slot-0 '%s'/m && cp ./unisacc.com '%s'/slot-0/", T, T, T);
    if (ckk_sh_t("check-mutation-gate", script, out, sizeof out, 10)) return 2;
    quality_file("slot-0/probe.c", "int main(void) { return 0; }\n");
    quality_file("slot-0/check.sh",
                 "#!/bin/sh\n"
                 "if grep -q 'return 0;' probe.c; then printf 'FAIL deliberate\n'; exit 1; fi\n"
                 "if grep -q 'return 1;' probe.c; then printf 'FAIL deliberate\n'; exec timeout 0.1 sleep 1; fi\n"
                 "if grep -q 'return 2;' probe.c; then printf 'FAIL deliberate\n'; exit 127; fi\n"
                 "if grep -q 'return 3;' probe.c; then printf 'FAIL deliberate\n'; exit 1; fi\n"
                 "if grep -q 'return 4;' probe.c; then printf 'FAIL deliberate-extra\n'; exit 1; fi\n"
                 "if grep -q 'return 6;' probe.c; then exit 17; fi\n"
                 "if grep -q 'return 7;' probe.c; then printf 'REFUSE fixture setup\nFAIL deliberate\n'; exit 2; fi\n"
                 "if grep -q 'return 8;' probe.c; then kill -SEGV $$; fi\n"
                 "exit 0\n");
    quality_file("conf.tsv", "par\t1\nmax\t12\nmin\t0.6\ncov\t1\nquality\t1\n"
                 "check\tsh check.sh\nexpect-name\tdeliberate\nexpect-rc\t17\n");
    quality_file("mutants.tsv",
                 "0\tprobe.c\t1\tint\tsame\n1\tprobe.c\t1\tint\tdeadline\n2\tprobe.c\t1\tint\tnot-found\n"
                 "3\tprobe.c\t1\tint\tnamed\n4\tprobe.c\t1\tint\tprefix\n5\tprobe.c\t1\tint\tsurvived\n"
                 "6\tprobe.c\t1\tint\texpected-rc\n7\tprobe.c\t1\tint\trefuse\n8\tprobe.c\t1\tint\tsignal\n"
                 "9\tprobe.c\t2\tint\toutside\n10\tprobe.c\t1\tint\tcompile-fail\n"
                 "11\tprobe.c\t2\tcov\tabort at entry of int main(void)\n");
    for (int i = 0; i < 12; i++) {
        cx_fmt(path, sizeof path, "m/%d.line", i);
        if (i == 10) quality_file(path, "@@ deliberately broken @@");
        else {
            cx_fmt(data, sizeof data, "int main(void) { return %d; }", i);
            quality_file(path, data);
        }
    }
    cx_fmt(script, sizeof script, "%s worker --out '%s' --slot 0 2>&1", entry, T);
    int rc = ckk_sh_t("check-mutation-gate", script, out, sizeof out, 45);
    ck(rc == 0 && ckk_has(out, sizeof out, "rows=12"), "quality-worker-complete");
    if (rc) puts(out);
    cx_fmt(path, sizeof path, "%s/res-0.tsv", T);
    FILE *receipt = fopen(path, "r");
    if (receipt) {
        for (int i = 0; i < 2 && fgets(data, sizeof data, receipt); i++) printf("QUALITY_WORKER_ROW\t%s", data);
        fclose(receipt);
    }
    cx_fmt(script, sizeof script, "%s --report --out '%s' 2>&1", entry, T);
    ckk_sh_t("check-mutation-gate", script, out, sizeof out, 10);
    puts(out);
    ck(ckk_has(out, sizeof out, "named=2 weak=1 unknown=5 invalid=2 survived=1"), "quality-counts");
    ck(ckk_has(out, sizeof out, "lower=2/9 upper=8/9 min=0.60 status=INCONCLUSIVE"), "quality-interval-keeps-unknown");
    ck(ckk_has(out, sizeof out, "missing=1") && ckk_has(out, sizeof out, "verdict=FAIL"), "quality-invalid-coverage-blocks");
    cx_fmt(path, sizeof path, "%s/mutation-quality.tsv", T);
    size_t n = 0;
    char *rows = cx_read(path, &n);
    ck(rows && strstr(rows, "0\tprobe.c\t1\tint\tINVALID\t"), "quality-noop-invalid");
    ck(rows && strstr(rows, "9\tprobe.c\t2\tint\tINVALID\t"), "quality-out-of-range-invalid");
    ck(rows && strstr(rows, "1\tprobe.c\t1\tint\tUNKNOWN\t124\t"), "quality-timeout-overrides-name");
    ck(rows && strstr(rows, "2\tprobe.c\t1\tint\tUNKNOWN\t127\t"), "quality-missing-command-overrides-name");
    ck(rows && strstr(rows, "3\tprobe.c\t1\tint\tKILL-named\t1\t"), "quality-exact-name");
    ck(rows && strstr(rows, "4\tprobe.c\t1\tint\tKILL-weak\t1\t"), "quality-unrelated-name-weak");
    ck(rows && strstr(rows, "6\tprobe.c\t1\tint\tKILL-named\t17\t"), "quality-explicit-exit");
    ck(rows && strstr(rows, "7\tprobe.c\t1\tint\tUNKNOWN\t2\t"), "quality-setup-refusal");
    ck(rows && strstr(rows, "8\tprobe.c\t1\tint\tUNKNOWN\t139\t"), "quality-signal");
    ck(rows && strstr(rows, "10\tprobe.c\t1\tint\tUNKNOWN\t"), "quality-compile-refused");
    if (rows) free(rows);
    return 0;
}

static int gate(const char *name, const char *check, const char *extra, char *out, int cap) {
    char sc[4096];
    cx_fmt(sc, sizeof sc, "sh ./unisacc.com tools/mutation-gate.cx -- run --repo %s/repo --base base --patch %s/fx.patch "
           "--check '%s' --out %s/%s --par 4 --max 12 --deadline-s 45 %s 2>&1", T, T, check, T, name, extra);
    return ckk_sh_t("check-mutation-gate", sc, out, cap, 55);
}

int main(int argc, char **argv) {
    static char out[65536], sc[8192]; int rc;
    if (argc >= 2 && (strcmp(argv[1], "--quality-fixture") || argc > 3)) return 2;
    rc = ckk_sh_t("check-mutation-gate", "mktemp -d \"${TMPDIR:-/tmp}/mg-check.XXXXXX\"", T, sizeof T, 10);
    { int n = (int)tx_len(T, sizeof T); while (n > 0 && (T[n - 1] == '\n' || T[n - 1] == ' ')) T[--n] = 0; }
    if (rc != 0 || !T[0]) { printf("CHECK_MUTATION_GATE\tok=0\tfailed=1\n"); return 1; }
    if (argc >= 2) {
        rc = quality_fixture(argc == 3 ? argv[2] : 0);
        cx_fmt(sc, sizeof sc, "rm -rf -- '%s'", T);
        ckk_sh_t("check-mutation-gate", sc, 0, 0, 20);
        printf("CHECK_MUTATION_GATE_QUALITY\tok=%d\tfailed=%d\n", ok, failed);
        return rc ? rc : failed != 0;
    }
    cx_fmt(sc, sizeof sc,
        "set -e; cd %s; mkdir -p repo/tools; cd repo; git init -q; git config user.email t@t; git config user.name t;\n"
        "printf '%%s\\n' 'int main(void) {' '    printf(\"start\\n\");' '    return 0;' '}' > tools/fx.cx\n"
        "git add tools/fx.cx; git commit -q -m base; git tag base\n"
        "printf '%%s\\n' 'static int clampadd(int a, int b, int lim) {' '    int s = a + b;' '    if (s > lim) return lim * 2;' "
        "'    if (a < 0 && b < 0) return -1;' '    return s;' '}' 'int main(void) {' '    printf(\"start\\n\");' "
        "'    printf(\"R=%%d %%d %%d %%d %%d\\n\", clampadd(2, 3, 10), clampadd(7, 8, 10), clampadd(-1, -2, 10), clampadd(5, 5, 10), clampadd(0, -2, 10));' "
        "'    return 0;' '}' > tools/fx.cx\n"
        "git diff > ../fx.patch; git checkout -q tools/fx.cx", T);
    rc = ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 30);
    ck(rc == 0, "fixture-repo");
    if (rc != 0) { printf("%s\nCHECK_MUTATION_GATE\tok=%d\tfailed=%d\n", out, ok, failed); return 1; }

    /* Five lexical facts a line-oriented or first-character test cannot see.  The fixture file, by line:
       5  a block comment opens and names a number
       6  its continuation is plain prose (no leading asterisk) and names 4096, 8192 and `a < b`
       7  the comment closes and the same line carries code with a second number
       8  a line comment that itself contains a block opener
       9  a #define whose value is a number
       10 code after all of that
       Red on the older tool: it took line 6 for code (first non-blank is a letter), so the prose numbers became
       candidates, and it masked line 7 from comment state 0, so it rewrote the comment's 7003 and left 60 alone.
       Lines 8 and 9 pin no-regression instead: stopping at a line comment and skipping a directive must keep
       holding, or a note would swallow the next line and a #define value would score as a kill. */
    cx_fmt(sc, sizeof sc,
        "set -e; cd %s; mkdir -p repo2; cd repo2; git init -q; git config user.email t@t; git config user.name t;\n"
        "printf '%%s\\n' 'int main(void) {' '    return 0;' '}' > tools2.cx; git add tools2.cx; git commit -q -m base; git tag base\n"
        "printf '%%s\\n' 'int main(void) {' '    return 0;' '}' 'static int addone(int v) {' '    /* adds one and 7001 is an example,' '       so 4096 and 8192 and a < b are prose, never a mutant' '       ends at 7003 */ int u = 60;' '    // note 5005 /* and 6006 too' '#define K 4096' '    return v + 1 + u;' '}' > tools2.cx; git diff > ../fx2.patch; git checkout -q tools2.cx", T);
    rc = ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 30);
    ck(rc == 0, "block-comment-fixture-repo");
    cx_fmt(sc, sizeof sc, "sh ./unisacc.com tools/mutation-gate.cx -- prep --repo %s/repo2 --base base --patch %s/fx2.patch "
           "--check 'echo CHECK ok=1 failed=0' --out %s/bc --par 1 --max 60 2>&1", T, T, T);
    rc = ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 55);
    ck(rc == 0 && ckk_has(out, sizeof out, "MG_PREP_DONE"), "block-comment-prep");
    /* mutants.tsv is `id <TAB> file <TAB> line <TAB> kind <TAB> description`; the line column pins each case. */
    cx_fmt(sc, sizeof sc, "cut -f3 %s/bc/mutants.tsv | grep -cx 10", T);
    rc = ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 10);
    ck(rc == 0 && atoi(out) > 0, "block-comment-code-after-comment-still-mutated");
    cx_fmt(sc, sizeof sc, "cut -f3 %s/bc/mutants.tsv | grep -cE '^(6|8|9)$'", T);
    rc = ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 10);
    ck(rc != 0, "block-comment-prose-line-comment-and-define-not-mutated");
    cx_fmt(sc, sizeof sc, "cut -f5 %s/bc/mutants.tsv | grep -cx 'col 32 60 -> 61'", T);
    rc = ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 10);
    ck(rc == 0 && atoi(out) == 1, "block-comment-close-takes-code-not-prose");
    cx_fmt(sc, sizeof sc, "grep -c 7003 %s/bc/mutants.tsv", T);
    rc = ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 10);
    ck(rc != 0, "block-comment-close-prose-number-not-mutated");
    rc = gate("strong", "o=$(sh ./unisacc.com tools/fx.cx) && test \"$o\" = \"$(printf \"start\\nR=5 20 -1 10 -2\")\"", "--report --expect-rc 1", out, sizeof out);
    ck(rc == 0 && ckk_has(out, sizeof out, "verdict=PASS") && !ckk_has(out, sizeof out, " mutants=0 "), "strong-high");
    const char *strong_quality = strstr(out, "MUTATION_QUALITY named=");
    ck(strong_quality && atoi(strong_quality + sizeof("MUTATION_QUALITY named=") - 1) > 0, "strong-persisted-exit-contract");
    if (!(rc == 0)) printf("%.1500s\n", out);

    rc = gate("weak", "echo CHECK ok=1 failed=0", "--coverage-check", out, sizeof out);
    ck(rc == 1 && ckk_has(out, sizeof out, " killed=0 ") && ckk_has(out, sizeof out, "score=0/") && ckk_has(out, sizeof out, "verdict=FAIL"), "weak-zero");
    ck(ckk_has(out, sizeof out, "MUTATION_COVERAGE") && !ckk_has(out, sizeof out, "uncovered=0"), "weak-coverage");
    if (rc != 1) printf("%.1500s\n", out);
    cx_fmt(sc, sizeof sc, "test $(wc -l < %s/weak/survivors.tsv) -ge 3 && grep -q '^MUTATION_GATE mutants=' %s/weak/SUMMARY", T, T);
    ck(ckk_sh_t("check-mutation-gate", sc, 0, 0, 10) == 0, "summary-file");

    /* default threshold is 0.6; an explicit --min-score overrides the value saved by prep */
    ck(ckk_has(out, sizeof out, " min=0.60 "), "default-min-0.6");
    cx_fmt(sc, sizeof sc, "sh ./unisacc.com tools/mutation-gate.cx -- report --out %s/weak --min-score 0.7 2>&1", T);
    ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 30);
    ck(ckk_has(out, sizeof out, " min=0.70 "), "explicit-min-overrides");

    /* uncovered > 0 fails by default even when the score gate is open; the reviewer list releases it */
    cx_fmt(sc, sizeof sc, "sh ./unisacc.com tools/mutation-gate.cx -- report --out %s/weak --min-score 0 2>&1", T);
    rc = ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 30);
    ck(rc == 1 && ckk_has(out, sizeof out, "verdict=FAIL") && ckk_has(out, sizeof out, "MG_UNCOVERED tools/fx.cx clampadd blocking"), "uncovered-default-fail");
    if (rc != 1) printf("%.1500s\n", out);
    cx_fmt(sc, sizeof sc, "printf 'tools/fx.cx\\tclampadd\\tfixture\\ntools/fx.cx\\tmain\\tfixture\\n' > %s/allow.tsv && "
           "sh ./unisacc.com tools/mutation-gate.cx -- report --out %s/weak --min-score 0 --allow-uncovered %s/allow.tsv 2>&1", T, T, T);
    rc = ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 30);
    ck(rc == 0 && ckk_has(out, sizeof out, "verdict=PASS") && ckk_has(out, sizeof out, "MG_UNCOVERED tools/fx.cx clampadd allowed") && !ckk_has(out, sizeof out, " blocking "), "allow-uncovered-pass");
    if (rc != 0) printf("%.1500s\n", out);

    /* adjudicated survivors leave the denominator: raw and adjudicated scores both shown */
    cx_fmt(sc, sizeof sc, "sh ./unisacc.com tools/mutation-gate.cx -- report --out %s/weak 2>&1", T);
    ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 30);
    ck(ckk_has(out, sizeof out, " adjudicated=0 ") && ckk_has(out, sizeof out, " score_adj=0/"), "adjudicated-none");
    cx_fmt(sc, sizeof sc, "head -n 2 %s/weak/survivors.tsv | tail -n 1 | cut -f2,3,4 | tr -d '\\n' > %s/adj.tsv && printf '\\tequivalent\\tfixture\\n' >> %s/adj.tsv && "
           "sh ./unisacc.com tools/mutation-gate.cx -- report --out %s/weak --adjudicated %s/adj.tsv 2>&1", T, T, T, T, T);
    ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 30);
    ck(!ckk_has(out, sizeof out, " adjudicated=0 ") && ckk_has(out, sizeof out, " adjudicated="), "adjudicated-changes-score");
    cx_fmt(sc, sizeof sc, "printf 'tools/fx.cx\\t3\\tcmp\\tmaybe\\twhy\\n' > %s/adjbad.tsv && "
           "sh ./unisacc.com tools/mutation-gate.cx -- report --out %s/weak --adjudicated %s/adjbad.tsv 2>&1", T, T, T);
    rc = ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 30);
    ck(rc == 2 && ckk_has(out, sizeof out, "equivalent or out-of-scope"), "adjudicated-bad-verdict-refused");

    /* --- slot reclaim: only after a verdict, and a re-entry names the paths to delete --- */
    cx_fmt(sc, sizeof sc, "test ! -d %s/strong/slot-0 && test -s %s/strong/SUMMARY && grep -q '^state\tdone$' %s/strong/session.tsv", T, T, T);
    ck(ckk_sh_t("check-mutation-gate", sc, 0, 0, 10) == 0, "reclaim-after-verdict");
    cx_fmt(sc, sizeof sc, "sh ./unisacc.com tools/mutation-gate.cx -- prep --repo %s/repo --base base --patch %s/fx.patch "
           "--check 'echo CHECK ok=1 failed=0' --out %s/orphan --par 2 2>&1", T, T, T);
    ck(ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 55) == 0 && ckk_has(out, sizeof out, "MG_PREP_DONE"), "prep-orphan");
    if (!ckk_has(out, sizeof out, "MG_PREP_DONE")) printf("%.800s\n", out);
    cx_fmt(sc, sizeof sc, "sh ./unisacc.com tools/mutation-gate.cx -- reclaim --out %s/orphan 2>&1", T);
    rc = ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 20);
    cx_fmt(sc, sizeof sc, "test -d %s/orphan/slot-0 && test -d %s/orphan/slot-1", T, T);
    ck(rc == 0 && ckk_has(out, sizeof out, "MG_SLOTS_KEPT reason=no-summary")
       && ckk_sh_t("check-mutation-gate", sc, 0, 0, 10) == 0, "keep-slots-without-verdict");
    cx_fmt(sc, sizeof sc, "sh ./unisacc.com tools/mutation-gate.cx -- prep --repo %s/repo --base base --patch %s/fx.patch "
           "--check 'echo CHECK ok=1 failed=0' --out %s/orphan --par 2 2>&1", T, T, T);
    rc = ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 30);
    ck(rc == 2 && ckk_has(out, sizeof out, "out dir already prepared")
       && ckk_has(out, sizeof out, "reclaim --out clears slots only after a verdict")
       && ckk_has(out, sizeof out, "with a verdict there: sh ./unisacc.com tools/mutation-gate.cx -- reclaim --out")
       && ckk_has(out, sizeof out, "orphan/conf.tsv") && ckk_has(out, sizeof out, "orphan/session.tsv")
       && ckk_has(out, sizeof out, "orphan/slot-0"), "reentry-names-paths");
    /* F2: the first line must not promise that reclaim works here -- this dir has no verdict yet, so say
       what reclaim needs and what to delete by hand. A message that only says 'run reclaim' strands the
       operator: reclaim reports no-summary and the dir stays refused. */
    ck(!ckk_has(out, sizeof out, "reclaim with:"), "reentry-does-not-promise-reclaim");
    cx_fmt(sc, sizeof sc, "printf 'MUTATION_GATE mutants=1 killed=1 verdict=PASS\\n' > %s/orphan/SUMMARY && "
           "sh ./unisacc.com tools/mutation-gate.cx -- reclaim --out %s/orphan 2>&1", T, T);
    rc = ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 20);
    cx_fmt(sc, sizeof sc, "test ! -d %s/orphan/slot-0 && test ! -d %s/orphan/slot-1 && test -s %s/orphan/SUMMARY", T, T, T);
    ck(rc == 0 && ckk_has(out, sizeof out, "MG_SLOTS_RECLAIMED")
       && ckk_sh_t("check-mutation-gate", sc, 0, 0, 10) == 0, "reclaim-keeps-summary");

    /* empty SUMMARY is not a verdict: the slots stay, and the branch says which reason it took */
    cx_fmt(sc, sizeof sc, "mkdir -p %s/empty-sum/slot-0 %s/empty-sum/slot-1 && cp %s/orphan/conf.tsv %s/empty-sum/ && "
           "cp %s/orphan/session.tsv %s/empty-sum/ && : > %s/empty-sum/SUMMARY && "
           "sh ./unisacc.com tools/mutation-gate.cx -- reclaim --out %s/empty-sum 2>&1",
           T, T, T, T, T, T, T, T);
    rc = ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 20);
    cx_fmt(sc, sizeof sc, "test -d %s/empty-sum/slot-0 && test -d %s/empty-sum/slot-1", T, T);
    ck(rc == 0 && ckk_has(out, sizeof out, "MG_SLOTS_KEPT reason=no-summary")
       && ckk_sh_t("check-mutation-gate", sc, 0, 0, 10) == 0, "empty-summary-keeps-slots");

    /* a directory that is NOT ours: a verdict-looking SUMMARY and slot trees, no conf.tsv/session.tsv.
       Deleting these would destroy another window's run, so the gate names the reason and touches nothing. */
    cx_fmt(sc, sizeof sc, "mkdir -p %s/foreign/slot-3 %s/foreign/slot-63 && "
           "printf 'MUTATION_GATE mutants=1 killed=1 verdict=PASS\\n' > %s/foreign/SUMMARY && "
           "sh ./unisacc.com tools/mutation-gate.cx -- reclaim --out %s/foreign 2>&1", T, T, T, T);
    rc = ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 20);
    cx_fmt(sc, sizeof sc, "test -d %s/foreign/slot-3 && test -d %s/foreign/slot-63 && test -s %s/foreign/SUMMARY", T, T, T);
    ck(rc == 0 && ckk_has(out, sizeof out, "MG_SLOTS_KEPT reason=not-mine") && !ckk_has(out, sizeof out, "MG_SLOTS_RECLAIMED")
       && ckk_sh_t("check-mutation-gate", sc, 0, 0, 10) == 0, "foreign-dir-not-mine");
    cx_fmt(sc, sizeof sc, "mkdir -p %s/half/slot-0 && cp %s/orphan/conf.tsv %s/half/ && "
           "printf 'MUTATION_GATE mutants=1 killed=1 verdict=PASS\\n' > %s/half/SUMMARY && "
           "sh ./unisacc.com tools/mutation-gate.cx -- reclaim --out %s/half 2>&1", T, T, T, T, T);
    rc = ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 20);
    cx_fmt(sc, sizeof sc, "test -d %s/half/slot-0", T);
    ck(rc == 0 && ckk_has(out, sizeof out, "MG_SLOTS_KEPT reason=not-mine")
       && ckk_sh_t("check-mutation-gate", sc, 0, 0, 10) == 0, "conf-without-session-not-mine");

    /* F1, the mirror of the case above: a real session.tsv but NO conf.tsv. Deleting on session alone
       would make the conf check ornamental -- gatekeeper flipped `if (sy_exists(conf))` to `if (0)` and
       this dir was the one that stayed green. */
    cx_fmt(sc, sizeof sc, "mkdir -p %s/noconf/slot-0 %s/noconf/slot-1 && cp %s/orphan/session.tsv %s/noconf/ && "
           "printf 'MUTATION_GATE mutants=1 killed=1 verdict=PASS\\n' > %s/noconf/SUMMARY && "
           "sh ./unisacc.com tools/mutation-gate.cx -- reclaim --out %s/noconf 2>&1", T, T, T, T, T, T);
    rc = ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 20);
    cx_fmt(sc, sizeof sc, "test -d %s/noconf/slot-0 && test -d %s/noconf/slot-1", T, T);
    ck(rc == 0 && ckk_has(out, sizeof out, "MG_SLOTS_KEPT reason=not-mine")
       && !ckk_has(out, sizeof out, "MG_SLOTS_RECLAIMED")
       && ckk_sh_t("check-mutation-gate", sc, 0, 0, 10) == 0, "session-without-conf-not-mine");

    /* F3: the names alone are not proof. An EMPTY conf.tsv plus an EMPTY session.tsv (no `state` line)
       must not authorise deletion -- that pair is something any caller can create by touching two files. */
    cx_fmt(sc, sizeof sc, "mkdir -p %s/emptyreg/slot-0 && : > %s/emptyreg/conf.tsv && : > %s/emptyreg/session.tsv && "
           "printf 'MUTATION_GATE mutants=1 killed=1 verdict=PASS\\n' > %s/emptyreg/SUMMARY && "
           "sh ./unisacc.com tools/mutation-gate.cx -- reclaim --out %s/emptyreg 2>&1", T, T, T, T, T);
    rc = ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 20);
    cx_fmt(sc, sizeof sc, "test -d %s/emptyreg/slot-0", T);
    ck(rc == 0 && ckk_has(out, sizeof out, "MG_SLOTS_KEPT reason=not-mine")
       && ckk_sh_t("check-mutation-gate", sc, 0, 0, 10) == 0, "empty-registration-not-mine");
    /* ...and a session.tsv without a state line is not ours either, even when conf.tsv has bytes */
    cx_fmt(sc, sizeof sc, "mkdir -p %s/nostate/slot-0 && cp %s/orphan/conf.tsv %s/nostate/ && "
           "printf 'pid\\t1\\n' > %s/nostate/session.tsv && "
           "printf 'MUTATION_GATE mutants=1 killed=1 verdict=PASS\\n' > %s/nostate/SUMMARY && "
           "sh ./unisacc.com tools/mutation-gate.cx -- reclaim --out %s/nostate 2>&1", T, T, T, T, T, T);
    rc = ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 20);
    cx_fmt(sc, sizeof sc, "test -d %s/nostate/slot-0", T);
    ck(rc == 0 && ckk_has(out, sizeof out, "MG_SLOTS_KEPT reason=not-mine")
       && ckk_sh_t("check-mutation-gate", sc, 0, 0, 10) == 0, "session-without-state-not-mine");
    /* the state field is a FIELD: 'state\t' text inside another line's value is not the registration.
       Without this case a scanner that ignores line starts deletes a directory it does not own. */
    cx_fmt(sc, sizeof sc, "mkdir -p %s/midstate/slot-0 && cp %s/orphan/conf.tsv %s/midstate/ && "
           "printf 'pid\\t1\\nnote\\tstate\\tprepared\\n' > %s/midstate/session.tsv && "
           "printf 'MUTATION_GATE mutants=1 killed=1 verdict=PASS\\n' > %s/midstate/SUMMARY && "
           "sh ./unisacc.com tools/mutation-gate.cx -- reclaim --out %s/midstate 2>&1", T, T, T, T, T, T);
    rc = ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 20);
    cx_fmt(sc, sizeof sc, "test -d %s/midstate/slot-0", T);
    ck(rc == 0 && ckk_has(out, sizeof out, "MG_SLOTS_KEPT reason=not-mine")
       && ckk_sh_t("check-mutation-gate", sc, 0, 0, 10) == 0, "midline-state-not-mine");
    /* ...and an empty state VALUE ('state\t' then newline) is not a state either */
    cx_fmt(sc, sizeof sc, "mkdir -p %s/emptystate/slot-0 && cp %s/orphan/conf.tsv %s/emptystate/ && "
           "printf 'pid\\t1\\nstate\\t\\n' > %s/emptystate/session.tsv && "
           "printf 'MUTATION_GATE mutants=1 killed=1 verdict=PASS\\n' > %s/emptystate/SUMMARY && "
           "sh ./unisacc.com tools/mutation-gate.cx -- reclaim --out %s/emptystate 2>&1", T, T, T, T, T, T);
    rc = ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 20);
    cx_fmt(sc, sizeof sc, "test -d %s/emptystate/slot-0", T);
    ck(rc == 0 && ckk_has(out, sizeof out, "MG_SLOTS_KEPT reason=not-mine")
       && ckk_sh_t("check-mutation-gate", sc, 0, 0, 10) == 0, "empty-state-value-not-mine");
    /* a session.tsv whose FIRST line is the state must be recognised: searching from offset 1 would skip it
       (a scanner that starts past byte 0 is a scanner that misses a file written by another writer). */
    cx_fmt(sc, sizeof sc, "mkdir -p %s/firststate/slot-0 && cp %s/orphan/conf.tsv %s/firststate/ && "
           "printf 'state\\tprepared\\n' > %s/firststate/session.tsv && "
           "printf 'MUTATION_GATE mutants=1 killed=1 verdict=PASS\\n' > %s/firststate/SUMMARY && "
           "sh ./unisacc.com tools/mutation-gate.cx -- reclaim --out %s/firststate 2>&1", T, T, T, T, T, T);
    rc = ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 20);
    cx_fmt(sc, sizeof sc, "test ! -d %s/firststate/slot-0 && test -s %s/firststate/SUMMARY", T, T);
    ck(rc == 0 && ckk_has(out, sizeof out, "MG_SLOTS_RECLAIMED")
       && ckk_sh_t("check-mutation-gate", sc, 0, 0, 10) == 0, "state-on-first-line-reclaimed");

    /* --out absent: the dir is derived from the patch bytes, so prep/report/worker agree, and the
       registration file says prepared, for a derived and for an explicit --out alike. Two different
       patches must not land in one dir -- and two gates run at once must not either, which is why
       every derived-dir case below is given its own TMPDIR inside this fixture root instead of
       sharing the operator's. */
    cx_fmt(sc, sizeof sc, "mkdir -p %s/tmp-one %s/tmp-two %s/tmp-same %s/sameA %s/sameB && cp %s/fx.patch %s/one.patch && "
           "cp %s/fx.patch %s/two.patch && printf '\\n' >> %s/two.patch && cp %s/fx.patch %s/sameA/fx.patch && "
           "cp %s/fx.patch %s/sameB/fx.patch && printf '\\n' >> %s/sameB/fx.patch",
           T, T, T, T, T, T, T, T, T, T, T, T, T, T, T);
    ckk_sh_t("check-mutation-gate", sc, 0, 0, 10);
    cx_fmt(sc, sizeof sc, "TMPDIR=%s/tmp-one sh ./unisacc.com tools/mutation-gate.cx -- prep --repo %s/repo --base base "
           "--patch %s/one.patch --check 'echo CHECK ok=1 failed=0' --par 2 2>&1", T, T, T);
    ck(ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 55) == 0 && ckk_has(out, sizeof out, "MG_PREP_DONE"), "derive-out-prep");
    { const char *o = ckk_has(out, sizeof out, "out=") ? strstr(out, "out=") + 4 : 0;
      char a[1024] = "";
      if (o) for (int z = 0; o[z] && o[z] != '\n' && z < (int)sizeof a - 1; z++) a[z] = o[z];
      cx_fmt(sc, sizeof sc, "test -s '%s/session.tsv' && grep -q '^state\tprepared$' '%s/session.tsv' && "
             "test -s '%s/conf.tsv'", a, a, a);
      ck(a[0] && strstr(a, "unisacc-session-mutation-gate-one-") && strstr(a, "/tmp-one/")
         && ckk_sh_t("check-mutation-gate", sc, 0, 0, 10) == 0, "derive-out-registered");
      cx_fmt(sc, sizeof sc, "rm -rf -- '%s'", a); ckk_sh_t("check-mutation-gate", sc, 0, 0, 20);
    }
    cx_fmt(sc, sizeof sc, "TMPDIR=%s/tmp-two sh ./unisacc.com tools/mutation-gate.cx -- prep --repo %s/repo --base base "
           "--patch %s/two.patch --check 'echo CHECK ok=1 failed=0' --par 2 2>&1", T, T, T);
    ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 55);
    { const char *o = strstr(out, "out=");
      ck(o && !strstr(o, "one") && strstr(o, "two"), "derive-out-distinct-per-patch");
      if (o) { char a[1024] = ""; for (int z = 4; o[z] && o[z] != '\n' && z - 4 < (int)sizeof a - 1; z++) a[z - 4] = o[z];
        cx_fmt(sc, sizeof sc, "rm -rf -- '%s'", a); ckk_sh_t("check-mutation-gate", sc, 0, 0, 20); }
    }
    /* same base name, different bytes: the content hash, not the stem, is what separates the dirs */
    cx_fmt(sc, sizeof sc, "TMPDIR=%s/tmp-same sh ./unisacc.com tools/mutation-gate.cx -- prep --repo %s/repo --base base "
           "--patch %s/sameA/fx.patch --check 'echo CHECK ok=1 failed=0' --par 1 2>&1", T, T, T);
    ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 55);
    { char first[1024] = ""; const char *o = strstr(out, "out=");
      if (o) for (int z = 4; o[z] && o[z] != '\n' && z - 4 < (int)sizeof first - 1; z++) first[z - 4] = o[z];
      cx_fmt(sc, sizeof sc, "TMPDIR=%s/tmp-same sh ./unisacc.com tools/mutation-gate.cx -- prep --repo %s/repo --base base "
             "--patch %s/sameB/fx.patch --check 'echo CHECK ok=1 failed=0' --par 1 2>&1", T, T, T);
      int r2 = ckk_sh_t("check-mutation-gate", sc, out, sizeof out, 55);
      const char *o2 = strstr(out, "out=");
      char second[1024] = "";
      if (o2) for (int z = 4; o2[z] && o2[z] != '\n' && z - 4 < (int)sizeof second - 1; z++) second[z - 4] = o2[z];
      ck(first[0] && second[0] && strcmp(first, second) != 0 && strstr(first, "-fx-") && strstr(second, "-fx-"),
         "derive-out-same-stem-distinct-bytes");
      if (r2) printf("%.800s\n", out);
      if (first[0]) { cx_fmt(sc, sizeof sc, "rm -rf -- '%s'", first); ckk_sh_t("check-mutation-gate", sc, 0, 0, 20); }
      if (second[0]) { cx_fmt(sc, sizeof sc, "rm -rf -- '%s'", second); ckk_sh_t("check-mutation-gate", sc, 0, 0, 20); }
    }
    rc = gate("red", "echo CHECK ok=0 failed=1", "", out, sizeof out);
    ck(rc == 2 && ckk_has(out, sizeof out, "baseline check not green"), "red-baseline");

    ck(quality_fixture(0) == 0, "quality-fixture-ready");
    cx_fmt(sc, sizeof sc, "rm -rf -- '%s'", T); ckk_sh_t("check-mutation-gate", sc, 0, 0, 20);
    printf("CHECK_MUTATION_GATE\tok=%d\tfailed=%d\n", ok, failed);
    return failed ? 1 : 0;
}
