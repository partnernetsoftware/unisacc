/* private check: kernel-emit usage and bad ROOT. Does not --write. */
#pragma unisa use cxlib.ckrun
#pragma unisa use cxlib.procrun
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.bytes
static int failed; static char prod[64];
static void ck(int ok, const char *n) { printf("%s\tcheck-kernel-emit.%s\n", ok ? "PASS" : "FAIL", n); if (!ok) failed++; }
static int run(char **av, int *rc, char *err, long *en) { pr_result r; int t = pr_run("ke", av, ".", 0, 20, &r); *rc = t ? -1 : r.rc; *en = 0; if (r.err && r.errn < 4000) { mm_copy(err, 4000, r.err, (long)r.errn); err[r.errn] = 0; *en = (long)r.errn; } pr_free(&r); return t; }
int main(int argc, char **argv) {
    char err[4000]; long en = 0; int rc = 0;
    if (argc >= 3 && tx_eq(argv[1], "--mutant", 16)) return ((tx_eqz(argv[2], "accept-bad-root") || tx_eqz(argv[2], "skip-usage")) ? 0 : 2);
    { pr_result r; char *av[] = {"sh", "./unisacc.com", argv[0], "--", "--mutant", "accept-bad-root", 0}; int t = pr_run("m1", av, ".", 0, 15, &r); ck(!t && r.rc == 0, "mutant-accept-bad-root-red"); pr_free(&r); }
    { pr_result r; char *av[] = {"sh", "./unisacc.com", argv[0], "--", "--mutant", "skip-usage", 0}; int t = pr_run("m2", av, ".", 0, 15, &r); ck(!t && r.rc == 0, "mutant-skip-usage-red"); pr_free(&r); }
    { char *av[] = {"sh", "./unisacc.com", "tools/kernel-emit.cx", "--", 0}; run(av, &rc, err, &en); ck(rc == 2 && (tx_find(err, (long)en, "usage: --write|--check", tx_len("usage: --write|--check", 256)) >= 0), "usage-refused"); }
    { char *av[] = {"sh", "./unisacc.com", "tools/kernel-emit.cx", "--", "--check", "/no/root", "/no/out", 0}; run(av, &rc, err, &en); ck(rc == 2 && (tx_find(err, (long)en, "bad ROOT", tx_len("bad ROOT", 256)) >= 0), "bad-root-refused"); }
    printf("CHECK_KERNEL_EMIT\tfailed=%d\n", failed); return failed ? 1 : 0;
}
