/* tools/migration-admission-gen.cx -- Fact-table + verified v3 receipt generator for plans/migration-admission.tsv.
 *
 * Generates all 99 units x 6 targets = 594 rows of plans/migration-admission.tsv strictly from:
 *   (1) plans/slice-units.tsv (authoritative 99-unit roster)
 *   (2) plans/migration-admission-meta.tsv (non-metric static classification columns only)
 *   (3) plans/migration-cost-model.tsv (table-driven base_us and us_per_step coefficients)
 *   (4) optional --expect-tsv FILE (caller-supplied expectations for v3 receipts verified via
 *       cxlib.receipt rc_verify_out; metrics are read ONLY from verified output_bytes)
 *
 * No hand-filled metric numbers are permitted: any (unit, target) without a rc_verify_out-verified
 * v3 receipt receives UNMEASURED metrics and verdict=PENDING.
 *
 * Modes:
 *   --write [--repo DIR] [--expect-tsv FILE]
 *   --check [--repo DIR] [--expect-tsv FILE]   (exits non-zero on ANY byte drift / hand edit)
 *   --extract-meta [--repo DIR]                (one-time helper to extract non-metric meta table)
 */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.posix
#pragma unisa use sys.sha
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use cxlib.receipt

static const char *MAG_TARGETS[6] = {
    "lnx/x86_64", "lnx/arm64", "osx/x86_64", "osx/arm64", "win/x86_64", "win/arm64"
};

typedef struct {
    char unit[64];
    char dest_class[32];
    char path[32];
    char budget_us[32];
    char bridge_shape[64];
    char source_kind[32];
    char live_bytes[32];
    char obj_bytes[32];
    char gen_friendly[32];
    char entries_n[32];
} mag_meta_t;

typedef struct {
    char unit[64];
    char target[32];
    char rcpt_path[512];
    char out_path[512];
    char run_id[160];
    char rev[80];
    char cand_sha[65];
    char in_sha[65];
    char producer[160];
    char purpose[160];
    int64_t now_ts;
} mag_expect_row_t;

typedef struct {
    char *buf;
    size_t len;
    size_t cap;
    int err;
} mag_sb_t;

static void mag_sb_init(mag_sb_t *sb) {
    sb->buf = 0; sb->len = 0; sb->cap = 0; sb->err = 0;
}

static void mag_sb_free(mag_sb_t *sb) {
    mm_free(sb->buf);
    sb->buf = 0; sb->len = 0; sb->cap = 0;
}

static void mag_sb_put(mag_sb_t *sb, const char *s, size_t n) {
    if (sb->err) return;
    if (sb->len + n + 1 > sb->cap) {
        size_t nc = sb->cap ? sb->cap : 65536;
        char *nb;
        while (nc < sb->len + n + 1) nc *= 2;
        nb = (char *)mm_alloc(nc);
        if (!nb) { sb->err = 1; return; }
        if (sb->buf && sb->len > 0) mm_copy(nb, nc, sb->buf, sb->len);
        mm_free(sb->buf);
        sb->buf = nb;
        sb->cap = nc;
    }
    if (n > 0) mm_copy(sb->buf + sb->len, sb->cap - sb->len, s, n);
    sb->len += n;
    sb->buf[sb->len] = 0;
}

static void mag_sb_puts(mag_sb_t *sb, const char *s) {
    mag_sb_put(sb, s, strlen(s));
}

static int mag_split_tabs(char *line, char **cols, int max_cols) {
    int n = 0;
    char *p = line;
    while (n < max_cols) {
        cols[n++] = p;
        char *t = strchr(p, '\t');
        if (!t) break;
        *t = 0;
        p = t + 1;
    }
    return n;
}

static int mag_parse_i64_nonneg(const char *s, int64_t *out) {
    int64_t v = 0;
    int i;
    if (!s || !s[0]) return 1;
    for (i = 0; s[i]; i++) {
        if (s[i] < '0' || s[i] > '9') return 1;
        if (v > (9223372036854775807LL - (int64_t)(s[i] - '0')) / 10LL) return 1;
        v = v * 10LL + (int64_t)(s[i] - '0');
    }
    *out = v;
    return 0;
}

static int mag_parse_i64_signed(const char *s, int64_t *out) {
    int neg = 0, i = 0;
    int64_t v = 0;
    if (!s || !s[0]) return 1;
    if (s[0] == '-') { neg = 1; i = 1; }
    if (!s[i]) return 1;
    if (mag_parse_i64_nonneg(s + i, &v) != 0) return 1;
    *out = neg ? -v : v;
    return 0;
}

static int mag_parse_double(const char *s, double *out) {
    int dots = 0, digits = 0, i;
    char *end = 0;
    double v;
    if (!s || !s[0]) return 1;
    for (i = 0; s[i]; i++) {
        if (s[i] >= '0' && s[i] <= '9') digits++;
        else if (s[i] == '.') { dots++; if (dots > 1) return 1; }
        else return 1;
    }
    if (digits == 0) return 1;
    v = strtod(s, &end);
    if (!end || *end != 0 || !(v == v) || v < 0.0 || v >= 1e15) return 1;
    *out = v;
    return 0;
}

static int mag_kv_get(const char *buf, size_t len, const char *key, char *out, size_t cap) {
    size_t kl = strlen(key), i = 0;
    while (i < len) {
        size_t e = i, tab;
        while (e < len && buf[e] != '\n') e++;
        size_t l = e - i;
        if (l > 0 && buf[e - 1] == '\r') l--;
        for (tab = i; tab < i + l && buf[tab] != '\t'; tab++) {}
        if (tab < i + l && tab - i == kl && memcmp(buf + i, key, kl) == 0) {
            size_t vn = (i + l) - (tab + 1);
            if (vn == 0 || vn >= cap) return 1;
            mm_copy(out, cap, buf + tab + 1, vn);
            out[vn] = 0;
            return 0;
        }
        i = e + 1;
    }
    return 1;
}

static int mag_copy_str(char *dst, size_t cap, const char *src) {
    size_t n = strlen(src);
    if (n >= cap) return 1;
    mm_copy(dst, cap, src, n + 1);
    return 0;
}

static int mag_load_cost_model(const char *repo, double *base_us, double *us_per_step) {
    char p[4400], b_s[64], u_s[64];
    unsigned char *raw = 0;
    int64_t rn = 0;
    int ok;
    if (cx_fmt(p, sizeof p, "%s/plans/migration-cost-model.tsv", repo)) return 1;
    if (sy_read_file(p, &raw, &rn, 65536) != 0 || !raw) return 1;
    ok = (mag_kv_get((const char *)raw, (size_t)rn, "base_us", b_s, sizeof b_s) == 0 &&
          mag_kv_get((const char *)raw, (size_t)rn, "us_per_step", u_s, sizeof u_s) == 0 &&
          mag_parse_double(b_s, base_us) == 0 &&
          mag_parse_double(u_s, us_per_step) == 0);
    mm_free(raw);
    return ok ? 0 : 1;
}

static int mag_load_slice_units(const char *repo, char units[256][64], int *out_n) {
    char p[4400];
    unsigned char *raw = 0;
    int64_t rn = 0;
    int n = 0;
    size_t i = 0;
    if (cx_fmt(p, sizeof p, "%s/plans/slice-units.tsv", repo)) return 1;
    if (sy_read_file(p, &raw, &rn, 1 << 20) != 0 || !raw) return 1;
    while (i < (size_t)rn) {
        size_t e = i;
        while (e < (size_t)rn && raw[e] != '\n') e++;
        size_t l = e - i;
        if (l > 0 && raw[e - 1] == '\r') l--;
        if (l > 0 && raw[i] != '#') {
            size_t tab = i;
            while (tab < i + l && raw[tab] != '\t') tab++;
            size_t ul = tab - i;
            if (ul == 0 || ul >= 64 || n >= 256) { mm_free(raw); return 1; }
            mm_copy(units[n], 64, raw + i, ul);
            units[n][ul] = 0;
            n++;
        }
        i = e + 1;
    }
    mm_free(raw);
    *out_n = n;
    return n > 0 ? 0 : 1;
}

static int mag_load_meta(const char *repo, mag_meta_t meta[256], int *out_n) {
    char p[4400];
    unsigned char *raw = 0;
    int64_t rn = 0;
    int n = 0;
    size_t i = 0;
    if (cx_fmt(p, sizeof p, "%s/plans/migration-admission-meta.tsv", repo)) return 1;
    if (sy_read_file(p, &raw, &rn, 1 << 20) != 0 || !raw) return 1;
    while (i < (size_t)rn) {
        size_t e = i;
        while (e < (size_t)rn && raw[e] != '\n') e++;
        size_t l = e - i;
        if (l > 0 && raw[e - 1] == '\r') l--;
        if (l > 0 && raw[i] != '#' && !(l >= 5 && memcmp(raw + i, "unit\t", 5) == 0)) {
            char line[512];
            char *cols[12];
            int nc;
            if (l >= sizeof line || n >= 256) { mm_free(raw); return 1; }
            mm_copy(line, sizeof line, raw + i, l);
            line[l] = 0;
            nc = mag_split_tabs(line, cols, 12);
            if (nc != 10) { mm_free(raw); return 1; }
            if (mag_copy_str(meta[n].unit, sizeof meta[n].unit, cols[0]) ||
                mag_copy_str(meta[n].dest_class, sizeof meta[n].dest_class, cols[1]) ||
                mag_copy_str(meta[n].path, sizeof meta[n].path, cols[2]) ||
                mag_copy_str(meta[n].budget_us, sizeof meta[n].budget_us, cols[3]) ||
                mag_copy_str(meta[n].bridge_shape, sizeof meta[n].bridge_shape, cols[4]) ||
                mag_copy_str(meta[n].source_kind, sizeof meta[n].source_kind, cols[5]) ||
                mag_copy_str(meta[n].live_bytes, sizeof meta[n].live_bytes, cols[6]) ||
                mag_copy_str(meta[n].obj_bytes, sizeof meta[n].obj_bytes, cols[7]) ||
                mag_copy_str(meta[n].gen_friendly, sizeof meta[n].gen_friendly, cols[8]) ||
                mag_copy_str(meta[n].entries_n, sizeof meta[n].entries_n, cols[9])) {
                mm_free(raw);
                return 1;
            }
            n++;
        }
        i = e + 1;
    }
    mm_free(raw);
    *out_n = n;
    return n > 0 ? 0 : 1;
}

static int mag_load_expects(const char *path, mag_expect_row_t **out_rows, int *out_n) {
    unsigned char *raw = 0;
    int64_t rn = 0;
    int cap = 64, n = 0;
    mag_expect_row_t *rows;
    size_t i = 0;
    *out_rows = 0;
    *out_n = 0;
    if (!path || !path[0]) return 0;
    if (sy_read_file(path, &raw, &rn, 4 << 20) != 0 || !raw) {
        sy_eprintf("FAIL\texpect-tsv-read\t%s\n", path);
        return 1;
    }
    rows = (mag_expect_row_t *)mm_alloc((size_t)cap * sizeof(mag_expect_row_t));
    if (!rows) { mm_free(raw); return 1; }
    while (i < (size_t)rn) {
        size_t e = i;
        while (e < (size_t)rn && raw[e] != '\n') e++;
        size_t l = e - i;
        if (l > 0 && raw[e - 1] == '\r') l--;
        if (l > 0 && raw[i] != '#' && !(l >= 5 && memcmp(raw + i, "unit\t", 5) == 0)) {
            char line[2048];
            char *cols[14];
            int nc;
            int64_t now_ts = 0;
            if (l >= sizeof line) { mm_free(rows); mm_free(raw); return 1; }
            mm_copy(line, sizeof line, raw + i, l);
            line[l] = 0;
            nc = mag_split_tabs(line, cols, 14);
            if (nc != 11 || mag_parse_i64_nonneg(cols[10], &now_ts) != 0 || now_ts <= 0) {
                sy_eprintf("FAIL\texpect-tsv-bad-row\tcols=%d\n", nc);
                mm_free(rows);
                mm_free(raw);
                return 1;
            }
            if (n >= cap) {
                int ncap = cap * 2;
                mag_expect_row_t *nr = (mag_expect_row_t *)mm_alloc((size_t)ncap * sizeof(mag_expect_row_t));
                if (!nr) { mm_free(rows); mm_free(raw); return 1; }
                mm_copy(nr, (size_t)ncap * sizeof(mag_expect_row_t), rows, (size_t)n * sizeof(mag_expect_row_t));
                mm_free(rows);
                rows = nr;
                cap = ncap;
            }
            if (mag_copy_str(rows[n].unit, sizeof rows[n].unit, cols[0]) ||
                mag_copy_str(rows[n].target, sizeof rows[n].target, cols[1]) ||
                mag_copy_str(rows[n].rcpt_path, sizeof rows[n].rcpt_path, cols[2]) ||
                mag_copy_str(rows[n].out_path, sizeof rows[n].out_path, cols[3]) ||
                mag_copy_str(rows[n].run_id, sizeof rows[n].run_id, cols[4]) ||
                mag_copy_str(rows[n].rev, sizeof rows[n].rev, cols[5]) ||
                mag_copy_str(rows[n].cand_sha, sizeof rows[n].cand_sha, cols[6]) ||
                mag_copy_str(rows[n].in_sha, sizeof rows[n].in_sha, cols[7]) ||
                mag_copy_str(rows[n].producer, sizeof rows[n].producer, cols[8]) ||
                mag_copy_str(rows[n].purpose, sizeof rows[n].purpose, cols[9])) {
                mm_free(rows);
                mm_free(raw);
                return 1;
            }
            rows[n].now_ts = now_ts;
            n++;
        }
        i = e + 1;
    }
    mm_free(raw);
    *out_rows = rows;
    *out_n = n;
    return 0;
}

static int mag_find_meta(const mag_meta_t *meta, int mn, const char *unit) {
    int i;
    for (i = 0; i < mn; i++) if (strcmp(meta[i].unit, unit) == 0) return i;
    return -1;
}

static int mag_find_expect(const mag_expect_row_t *exps, int en, const char *unit, const char *target) {
    int i;
    for (i = 0; i < en; i++) {
        if (strcmp(exps[i].unit, unit) == 0 && strcmp(exps[i].target, target) == 0) return i;
    }
    return -1;
}

static int mag_generate(const char *repo, const char *expect_tsv, mag_sb_t *out_sb) {
    static char units[256][64];
    static mag_meta_t meta[256];
    int un = 0, mn = 0, en = 0, u, t;
    double base_us = 0.0, us_per_step = 0.0;
    mag_expect_row_t *exps = 0;

    if (mag_load_cost_model(repo, &base_us, &us_per_step) != 0) {
        sy_eprintf("FAIL\tcost-model\n");
        return 1;
    }
    if (mag_load_slice_units(repo, units, &un) != 0) {
        sy_eprintf("FAIL\tslice-units\n");
        return 1;
    }
    if (mag_load_meta(repo, meta, &mn) != 0) {
        sy_eprintf("FAIL\tmeta-table\n");
        return 1;
    }
    if (mn != un) {
        sy_eprintf("FAIL\tmeta-unit-count\tmeta=%d\tslice=%d\n", mn, un);
        return 1;
    }
    for (u = 0; u < un; u++) {
        if (mag_find_meta(meta, mn, units[u]) < 0) {
            sy_eprintf("FAIL\tmeta-missing-unit\t%s\n", units[u]);
            return 1;
        }
    }
    if (mag_load_expects(expect_tsv, &exps, &en) != 0) return 1;

    /* Reject duplicate (unit, target) rows in expect-tsv */
    for (u = 0; u < en; u++) {
        for (t = u + 1; t < en; t++) {
            if (strcmp(exps[u].unit, exps[t].unit) == 0 &&
                strcmp(exps[u].target, exps[t].target) == 0) {
                sy_eprintf("FAIL\texpect-duplicate\t%s\t%s\n", exps[u].unit, exps[u].target);
                mm_free(exps);
                return 1;
            }
        }
    }

    mag_sb_puts(out_sb,
                "unit\ttarget\tdest_class\tgolden_kind\tgolden_cases\tgolden_pass\tpath\t"
                "calls_per_run\tsteps_per_call\tcost_us_per_run\tbudget_us\tbridge_shape\t"
                "blockers_n\tsource_kind\tlive_bytes\tobj_bytes\tsize_delta\tverdict\t"
                "veto_reason\tgen_friendly\tentries_n\n");

    for (u = 0; u < un; u++) {
        int mi = mag_find_meta(meta, mn, units[u]);
        const mag_meta_t *m = &meta[mi];
        for (t = 0; t < 6; t++) {
            const char *tgt = MAG_TARGETS[t];
            int ei = mag_find_expect(exps, en, m->unit, tgt);
            char golden_kind[32], golden_cases[32], golden_pass[32];
            char calls_s[32], steps_s[32], cost_s[32], blockers_s[32], size_delta[32];
            char verdict[16], veto_reason[32];
            char row[1024];

            mag_copy_str(golden_kind, sizeof golden_kind, "UNMEASURED");
            mag_copy_str(golden_cases, sizeof golden_cases, "UNMEASURED");
            mag_copy_str(golden_pass, sizeof golden_pass, "UNMEASURED");
            mag_copy_str(calls_s, sizeof calls_s, "UNMEASURED");
            mag_copy_str(steps_s, sizeof steps_s, "UNMEASURED");
            mag_copy_str(cost_s, sizeof cost_s, "UNMEASURED");
            mag_copy_str(blockers_s, sizeof blockers_s, "UNMEASURED");
            mag_copy_str(size_delta, sizeof size_delta, "UNMEASURED");
            mag_copy_str(verdict, sizeof verdict, "PENDING");
            mag_copy_str(veto_reason, sizeof veto_reason, "-");

            if (ei >= 0) {
                const mag_expect_row_t *er = &exps[ei];
                rc_expect_t re;
                rc_verified_t rv;
                int rrc;
                int64_t g_cases = 0, g_pass = 0, calls = 0, steps = 0, blockers = 0, sdelta = 0;
                double cost = 0.0, budget = 0.0;
                int has_budget = 0;

                mm_fill(&re, (long)sizeof re, 0, (long)sizeof re);
                re.run_id = er->run_id;
                re.rev = er->rev;
                re.unit = er->unit;
                re.target = er->target;
                re.candidate_sha = er->cand_sha;
                re.inputs_sha = er->in_sha;
                re.output_path = er->out_path;
                re.producer = er->producer;
                re.purpose = er->purpose;
                re.expect_rc = 0;
                re.expect_verdict = "PASS";
                re.now_ts = er->now_ts;
                re.max_age_s = 86400;
                re.max_future_s = 60;
                re.allow_fail_verdict = 0;

                rrc = rc_verify_out(er->rcpt_path, &re, &rv);
                if (rrc != RC_OK) {
                    sy_eprintf("FAIL\treceipt-verify\tunit=%s\ttarget=%s\tcode=%d\tname=%s\twhy=%s\n",
                               er->unit, er->target, rrc, rc_code_name(rrc), rc_why());
                    rc_verified_free(&rv);
                    mm_free(exps);
                    return 1;
                }
                /* Parse metrics ONLY from verified output_bytes */
                if (!rv.output_bytes || rv.output_len <= 0 ||
                    mag_kv_get((const char *)rv.output_bytes, (size_t)rv.output_len, "golden_kind", golden_kind, sizeof golden_kind) != 0 ||
                    mag_kv_get((const char *)rv.output_bytes, (size_t)rv.output_len, "golden_cases", golden_cases, sizeof golden_cases) != 0 ||
                    mag_kv_get((const char *)rv.output_bytes, (size_t)rv.output_len, "golden_pass", golden_pass, sizeof golden_pass) != 0 ||
                    mag_kv_get((const char *)rv.output_bytes, (size_t)rv.output_len, "calls_per_run", calls_s, sizeof calls_s) != 0 ||
                    mag_kv_get((const char *)rv.output_bytes, (size_t)rv.output_len, "steps_per_call", steps_s, sizeof steps_s) != 0 ||
                    mag_kv_get((const char *)rv.output_bytes, (size_t)rv.output_len, "blockers_n", blockers_s, sizeof blockers_s) != 0) {
                    sy_eprintf("FAIL\tverified-output-missing-metrics\tunit=%s\ttarget=%s\n", er->unit, er->target);
                    rc_verified_free(&rv);
                    mm_free(exps);
                    return 1;
                }
                if (mag_kv_get((const char *)rv.output_bytes, (size_t)rv.output_len, "size_delta", size_delta, sizeof size_delta) == 0) {
                    if (strcmp(size_delta, "UNMEASURED") != 0 && mag_parse_i64_signed(size_delta, &sdelta) != 0) {
                        sy_eprintf("FAIL\tverified-output-bad-size-delta\tunit=%s\ttarget=%s\n", er->unit, er->target);
                        rc_verified_free(&rv);
                        mm_free(exps);
                        return 1;
                    }
                }
                rc_verified_free(&rv);

                if ((strcmp(golden_kind, "enum-full") != 0 && strcmp(golden_kind, "byte-diff") != 0) ||
                    mag_parse_i64_nonneg(golden_cases, &g_cases) != 0 || g_cases <= 0 ||
                    mag_parse_i64_nonneg(golden_pass, &g_pass) != 0 || g_pass > g_cases ||
                    mag_parse_i64_nonneg(calls_s, &calls) != 0 ||
                    mag_parse_i64_nonneg(steps_s, &steps) != 0 ||
                    mag_parse_i64_nonneg(blockers_s, &blockers) != 0) {
                    sy_eprintf("FAIL\tverified-output-bad-metric-values\tunit=%s\ttarget=%s\n", er->unit, er->target);
                    mm_free(exps);
                    return 1;
                }

                cost = (double)calls * (base_us + (double)steps * us_per_step);
                if (cx_fmt(cost_s, sizeof cost_s, "%.3f", cost) != 0) { mm_free(exps); return 1; }
                if (strcmp(m->budget_us, "UNMEASURED") != 0 && mag_parse_double(m->budget_us, &budget) == 0) {
                    has_budget = 1;
                }

                if (g_pass != g_cases) {
                    mag_copy_str(verdict, sizeof verdict, "VETO");
                    mag_copy_str(veto_reason, sizeof veto_reason, "correctness");
                } else if (blockers != 0) {
                    mag_copy_str(verdict, sizeof verdict, "VETO");
                    mag_copy_str(veto_reason, sizeof veto_reason, "blocked");
                } else if (has_budget && cost > budget) {
                    mag_copy_str(verdict, sizeof verdict, "VETO");
                    mag_copy_str(veto_reason, sizeof veto_reason, "speed");
                } else if (has_budget && (strcmp(m->source_kind, "table") == 0 || strcmp(m->source_kind, "generator") == 0)) {
                    mag_copy_str(verdict, sizeof verdict, "ADMIT");
                    mag_copy_str(veto_reason, sizeof veto_reason, "-");
                } else {
                    mag_copy_str(verdict, sizeof verdict, "PENDING");
                    mag_copy_str(veto_reason, sizeof veto_reason, "-");
                }
            }

            if (cx_fmt(row, sizeof row,
                       "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n",
                       m->unit, tgt, m->dest_class, golden_kind, golden_cases, golden_pass,
                       m->path, calls_s, steps_s, cost_s, m->budget_us, m->bridge_shape,
                       blockers_s, m->source_kind, m->live_bytes, m->obj_bytes, size_delta,
                       verdict, veto_reason, m->gen_friendly, m->entries_n) != 0) {
                mm_free(exps);
                return 1;
            }
            mag_sb_puts(out_sb, row);
        }
    }

    mm_free(exps);
    return out_sb->err ? 1 : 0;
}

static int mag_extract_meta(const char *repo) {
    char ma_p[4400], meta_p[4400];
    unsigned char *raw = 0;
    int64_t rn = 0;
    mag_sb_t sb;
    size_t i = 0;
    int rows = 0;
    if (cx_fmt(ma_p, sizeof ma_p, "%s/plans/migration-admission.tsv", repo) ||
        cx_fmt(meta_p, sizeof meta_p, "%s/plans/migration-admission-meta.tsv", repo)) return 1;
    if (sy_read_file(ma_p, &raw, &rn, 2 << 20) != 0 || !raw) return 1;
    mag_sb_init(&sb);
    mag_sb_puts(&sb, "# Non-metric static classification facts for plans/migration-admission.tsv (99 units).\n");
    mag_sb_puts(&sb, "# Metric columns (golden_*, calls_per_run, steps_per_call, cost_us_per_run, blockers_n, size_delta, verdict, veto_reason)\n");
    mag_sb_puts(&sb, "# are forbidden here and generated strictly from rc_verify_out-verified v3 receipts by tools/migration-admission-gen.cx.\n");
    mag_sb_puts(&sb, "unit\tdest_class\tpath\tbudget_us\tbridge_shape\tsource_kind\tlive_bytes\tobj_bytes\tgen_friendly\tentries_n\n");
    while (i < (size_t)rn) {
        size_t e = i;
        while (e < (size_t)rn && raw[e] != '\n') e++;
        size_t l = e - i;
        if (l > 0 && raw[e - 1] == '\r') l--;
        if (l > 0 && raw[i] != '#' && !(l >= 5 && memcmp(raw + i, "unit\t", 5) == 0)) {
            char line[1024], row[512];
            char *cols[22];
            int nc;
            if (l >= sizeof line) { mm_free(raw); mag_sb_free(&sb); return 1; }
            mm_copy(line, sizeof line, raw + i, l);
            line[l] = 0;
            nc = mag_split_tabs(line, cols, 22);
            if (nc < 20) { mm_free(raw); mag_sb_free(&sb); return 1; }
            if (cx_fmt(row, sizeof row, "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n",
                       cols[0], cols[1], cols[5], cols[9], cols[10], cols[12],
                       cols[13], cols[14], cols[18], cols[19]) != 0) {
                mm_free(raw); mag_sb_free(&sb); return 1;
            }
            mag_sb_puts(&sb, row);
            rows++;
        }
        i = e + 1;
    }
    mm_free(raw);
    if (sb.err || sy_write_file(meta_p, (const unsigned char *)sb.buf, (long)sb.len, 0644) != 0) {
        mag_sb_free(&sb);
        return 1;
    }
    mag_sb_free(&sb);
    sy_printf("MIGRATION_ADMISSION_GEN\tmode=extract-meta\tunits=%d\n", rows);
    return 0;
}

int main(int argc, char **argv) {
    const char *repo = ".";
    const char *expect_tsv = 0;
    int do_write = 0, do_check = 0, do_extract = 0, i;
    char out_p[4400];
    mag_sb_t sb;

    for (i = 1; i < argc; i++) {
        if (strcmp(argv[i], "--write") == 0) do_write = 1;
        else if (strcmp(argv[i], "--check") == 0) do_check = 1;
        else if (strcmp(argv[i], "--extract-meta") == 0) do_extract = 1;
        else if (strcmp(argv[i], "--repo") == 0 && i + 1 < argc) repo = argv[++i];
        else if (strcmp(argv[i], "--expect-tsv") == 0 && i + 1 < argc) expect_tsv = argv[++i];
        else { sy_eprintf("FAIL\tunknown-arg\t%s\n", argv[i]); return 2; }
    }
    if (do_write + do_check + do_extract != 1) {
        sy_eprintf("FAIL\tusage\tneed exactly one of --write|--check|--extract-meta\n");
        return 2;
    }
    if (do_extract) return mag_extract_meta(repo);

    if (cx_fmt(out_p, sizeof out_p, "%s/plans/migration-admission.tsv", repo)) return 2;
    mag_sb_init(&sb);
    if (mag_generate(repo, expect_tsv, &sb) != 0) {
        mag_sb_free(&sb);
        return 1;
    }

    if (do_write) {
        char tmp_p[4500];
        if (cx_fmt(tmp_p, sizeof tmp_p, "%s.new.%d", out_p, (int)getpid()) != 0 ||
            sy_write_file(tmp_p, (const unsigned char *)sb.buf, (long)sb.len, 0644) != 0 ||
            sy_rename(tmp_p, out_p) != 0) {
            (void)sy_unlink(tmp_p);
            mag_sb_free(&sb);
            sy_eprintf("FAIL\twrite-table\t%s\n", out_p);
            return 1;
        }
        sy_printf("MIGRATION_ADMISSION_GEN\tstatus=WROTE\tbytes=%lu\tpath=%s\n",
                  (unsigned long)sb.len, out_p);
        mag_sb_free(&sb);
        return 0;
    }

    /* --check: exact byte-for-byte comparison (any hand edit triggers DRIFT) */
    {
        unsigned char *cur = 0;
        int64_t cn = 0;
        int match = 0;
        if (sy_read_file(out_p, &cur, &cn, 8 << 20) == 0 && cur) {
            if ((size_t)cn == sb.len && memcmp(cur, sb.buf, sb.len) == 0) match = 1;
            mm_free(cur);
        }
        mag_sb_free(&sb);
        if (!match) {
            sy_printf("MIGRATION_ADMISSION_GEN\tstatus=DRIFT\tpath=%s\n", out_p);
            return 1;
        }
        sy_printf("MIGRATION_ADMISSION_GEN\tstatus=OK\tpath=%s\n", out_p);
        return 0;
    }
}
