/* tools/check-envtwin.cx -- contract check of tools/envtwin.cx on fixed fixture files in a private temp directory.
 * Cases: an array initializer element gains its other spelling right after it (UNISA_X gets UNISACC_X, UNISACC_X gets UNISA_X);
 * a pair already present in either order, a name outside the table (UNISA_LOCAL, UNISACC_OTHER), a longer name that starts like a
 * listed one (UNISA_JOBS_X), a literal that is not an array element and a literal passed as a call argument stay untouched; "env -u"
 * and "unset" strings gain the other spelling (KERNEL_SHA is not mistaken for KERNEL); --check lists without writing and answers
 * rc 1, --write changes the file, and a second run changes nothing (rc 0).
 * Last line CHECK_ENVTWIN<TAB>assertions=N<TAB>failed=M, rc 0 when M is 0. */
#pragma unisa use cxlib.ckrun
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.io
#pragma unisa use mem.heap
#pragma unisa use text.text

static int nas, failed;
static void ck(int ok, const char *name) {
    nas++;
    if (ok) sy_printf("PASS\tenvtwin.%s\n", name);
    else { failed++; sy_printf("FAIL\tenvtwin.%s\n", name); }
}

static void put(const char *dir, const char *name, const char *text) {
    char p[4400];
    { int cx_kept = snprintf(p, sizeof p, "%s/%s", dir, name); (void)cx_kept; }
    if (cx_write(p, text, strlen(text))) { sy_printf("FAIL\tenvtwin.fixture-%s\n", name); failed++; }
}

static char *get(const char *dir, const char *name) {
    char p[4400];
    size_t n;
    { int cx_kept = snprintf(p, sizeof p, "%s/%s", dir, name); (void)cx_kept; }
    return cx_read(p, &n);
}

static void run_tool(const char *dir, const char *mode, char *out, int cap, int *rc) {
    char sc[8192];
    { int cx_kept = snprintf(sc, sizeof sc, "cd %s && sh \"$OLDPWD/unisacc.com\" \"$OLDPWD/tools/envtwin.cx\" -- %s f1.c f2.c f3.c f4.c f5.c f6.c", dir, mode); (void)cx_kept; }
    *rc = ckk_sh("check-envtwin", sc, out, cap);
}

static int is(const char *t, const char *want) { return t && !strcmp(t, want); }

int main(void) {
    char dir[4200], sc[8192], out[8192], *t;
    int rc;
    { int cx_kept = snprintf(dir, sizeof dir, "%s/check-envtwin-XXXXXX", sy_env_or("TMPDIR", "/tmp")); (void)cx_kept; }
    if (!mkdtemp(dir)) return 2;
    put(dir, "f1.c", "static char *e[] = { \"UNISA_JOBS=1\", \"UNISA_LOCAL=1\", \"UNISA_JOBS_X=1\", 0 };\n");
    put(dir, "f2.c", "static char *e[] = { \"UNISA_JOBS=1\", \"UNISACC_JOBS=1\", 0 };\nstatic char *g[] = { \"UNISACC_KERNEL=k\", \"UNISA_KERNEL=k\", 0 };\n");
    put(dir, "f3.c", "const char *s = \"exec env -u UNISA_CONTAINER foo\"; const char *u = \"unset UNISA_KERNEL_SHA; x\";\n");
    put(dir, "f4.c", "int f(void) { const char *x = \"UNISA_JOBS=1\"; g(\"UNISA_JOBS=2\"); cx_fmt(b, n, \"UNISA_KERNEL=%s\", k); h(a, \"UNISA_KERNEL_SHA=%s\", s); static char *o[] = { \"UNISACC_OTHER=1\" }; }\n");
    put(dir, "f5.c", "const char *s = \"env -u UNISA_CONTAINER -u UNISACC_CONTAINER\"; const char *u = \"unset UNISACC_JOBS UNISA_JOBS\";\n");
    put(dir, "f6.c", "static char *e[] = { \"UNISACC_MAXSTEPS=5\", 0 }; const char *s = \"env -u UNISACC_CONTAINER x\";\n");
    run_tool(dir, "--check", out, sizeof out, &rc);
    ck(rc == 1, "check-mode-answers-1-when-a-twin-is-missing");
    ck(ckk_has(out, sizeof out, "f1.c\ta=1\tb=0") && ckk_has(out, sizeof out, "f3.c\ta=0\tb=2") && ckk_has(out, sizeof out, "f6.c\ta=1\tb=1"), "check-mode-counts-the-two-shapes-in-both-directions");
    ck(!ckk_has(out, sizeof out, "f2.c") && !ckk_has(out, sizeof out, "f4.c") && !ckk_has(out, sizeof out, "f5.c"), "paired-and-uncovered-files-are-not-listed");
    ck(ckk_has(out, sizeof out, "ENVTWIN\tfiles=3\ta=2\tb=3\tmode=check"), "summary-line");
    t = get(dir, "f1.c");
    ck(is(t, "static char *e[] = { \"UNISA_JOBS=1\", \"UNISA_LOCAL=1\", \"UNISA_JOBS_X=1\", 0 };\n"), "check-mode-writes-nothing");
    free(t);
    run_tool(dir, "--write", out, sizeof out, &rc);
    ck(rc == 0 && ckk_has(out, sizeof out, "mode=write"), "write-mode-answers-0");
    t = get(dir, "f1.c");
    ck(is(t, "static char *e[] = { \"UNISA_JOBS=1\", \"UNISACC_JOBS=1\", \"UNISA_LOCAL=1\", \"UNISA_JOBS_X=1\", 0 };\n"), "old-element-gains-the-new-spelling-right-after-it-others-stay");
    free(t);
    t = get(dir, "f6.c");
    ck(is(t, "static char *e[] = { \"UNISACC_MAXSTEPS=5\", \"UNISA_MAXSTEPS=5\", 0 }; const char *s = \"env -u UNISACC_CONTAINER -u UNISA_CONTAINER x\";\n"), "new-spelling-gains-the-old-one");
    free(t);
    t = get(dir, "f3.c");
    ck(is(t, "const char *s = \"exec env -u UNISA_CONTAINER -u UNISACC_CONTAINER foo\"; const char *u = \"unset UNISA_KERNEL_SHA UNISACC_KERNEL_SHA; x\";\n"), "strings-gain-the-other-name-whole");
    free(t);
    t = get(dir, "f2.c");
    ck(is(t, "static char *e[] = { \"UNISA_JOBS=1\", \"UNISACC_JOBS=1\", 0 };\nstatic char *g[] = { \"UNISACC_KERNEL=k\", \"UNISA_KERNEL=k\", 0 };\n"), "a-pair-in-either-order-is-not-doubled");
    free(t);
    t = get(dir, "f4.c");
    ck(is(t, "int f(void) { const char *x = \"UNISA_JOBS=1\"; g(\"UNISA_JOBS=2\"); cx_fmt(b, n, \"UNISA_KERNEL=%s\", k); h(a, \"UNISA_KERNEL_SHA=%s\", s); static char *o[] = { \"UNISACC_OTHER=1\" }; }\n"), "call-arguments-non-element-literals-and-unlisted-names-stay");
    free(t);
    run_tool(dir, "--check", out, sizeof out, &rc);
    ck(rc == 0 && ckk_has(out, sizeof out, "ENVTWIN\tfiles=0\ta=0\tb=0\tmode=check"), "second-run-changes-nothing");
    { int cx_kept = snprintf(sc, sizeof sc, "rm -rf %s", dir); (void)cx_kept; }
    ckk_sh("check-envtwin", sc, out, sizeof out);
    sy_printf("CHECK_ENVTWIN\tassertions=%d\tfailed=%d\n", nas, failed);
    return failed ? 1 : 0;
}
