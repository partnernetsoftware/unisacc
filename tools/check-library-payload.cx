/* End-to-end P3 payload refusals before library output creation. */
#pragma unisa use runtime.process
static int failed;
int main(void) {
    char root[4096], dir[4096], pkg[4200], out[4200], product[4200], tool[4200], bound[4200], why[1024];
    unsigned char b[]={1,9,0,246,255,'U','N','I','N','E','T','B','1','N'};
    if(!realpath(__FILE__,root)) return 2;
    { char *s=strrchr(root,'/'); if(!s)return 2; *s=0; s=strrchr(root,'/'); if(!s)return 2; *s=0; }
    if(cx_fmt(dir,sizeof dir,"/tmp/cx-payload-%ld",(long)getpid()) || mkdir(dir,0700)) return 2;
    if(cx_fmt(pkg,sizeof pkg,"%s/model.pkg",dir) || cx_fmt(out,sizeof out,"%s/library",dir) || cx_fmt(product,sizeof product,"%s/unisacc.com",root) || cx_fmt(tool,sizeof tool,"%s/tools/cx-library-build.cx",root) || cx_fmt(bound,sizeof bound,"%s/tools/bound",root)) return 2;
    for(int i=0;i<4;i++) {
        FILE *f=fopen(pkg,"wb"); np_result r={0}; struct stat st;
        const char *header=i==0 ? "P 3 1 1 0\nD route stage in out 0\nM 14 9 1 0\n" : i==2 ? "P 3 1 1 0\nD route stage in out 0\nM 14 9 1 118358510\n" : "P 3 1 1 0\nD route stage in out 0\nM 14 9 1 4131514041\n";
        b[0]=i==1?255:1; b[5]=i==2?'X':'U';
        if(!f || fputs(header,f)<0 || fwrite(b,1,sizeof b,f)!=sizeof b || fclose(f)) return 2;
        char *av[]={bound,"15","sh",product,tool,"--",pkg,out,"/usr/bin/x86_64-linux-gnu-gcc-11","/usr/bin/x86_64-linux-gnu-ar",0};
        if(np_run(av,root,0,18,&r,why,sizeof why)) return 2;
        int ok=r.rc==2 && r.err && strstr(r.err,"cx-library-build: package-model-payload") && lstat(out,&st)!=0 && errno==ENOENT;
        printf("%s\t%s\n",ok?"PASS":"FAIL",i==0?"crc":i==1?"deflate":i==2?"marker":"truncated-network");
        if(!ok) failed++; np_free(&r);
    }
    if(cx_rmtree(dir)) return 2;
    printf("CXLIBRARY_PAYLOAD\tfailed=%d\n",failed);
    return failed?1:0;
}
