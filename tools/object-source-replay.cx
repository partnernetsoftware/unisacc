/* Replay current frozen source inputs, never prove historical construction.
 * --inventory FILE --slice DIR --sources SEAL [--prepare | --out NEWDIR --start N --count N]
 * A seal is PREPARED evidence, not PASS. Replay always recompiles into a new directory.
 */
#pragma unisa use sys.fs
#pragma unisa use sys.time
#pragma unisa use sys.sha
#pragma unisa use sysx.process
#pragma unisa use text.text
#define OR_MAX 1024
static long began;
static char root[4400],ctor[4400],ctorsha[65],invsha[65],recsha[65],where[4400];
static int nu;
typedef struct {char *key,*sha,*src;long bytes;char source_sha[65];} Item;
static Item u[OR_MAX];
static void die(const char *s){fprintf(stderr,"object-source-replay: REFUSE %s: %s\n",where,s);exit(2);}
static void tick(void){if(sy_now_ms()-began>=49000)die("49 second deadline");}
static void path(char *p,const char *a,const char *b){if(cx_fmt(p,4400,"%s/%s",a,b))die("path bound");}
static char *or_dup(const char *s){char *p=strdup(s);if(!p)die("allocation");return p;}
static long num(const char *s){long n=0;if(!s||!*s)die("number");for(;*s;s++){if(*s<'0'||*s>'9'||n>100000000)die("number");n=n*10+*s-'0';}return n;}
static int hex(const char *s){if(!s||strlen(s)!=64)return 0;for(int i=0;i<64;i++)if(!strchr("0123456789abcdef",s[i]))return 0;return 1;}
static char *load(const char *p,size_t *n){tick();snprintf(where,sizeof where,"%s",p);struct stat st;if(stat(p,&st))die(errno==ENOENT?"missing":"stat error");if(!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>536870912)die("file extent/kind");char *b=cx_read(p,n);if(!b||*n!=(size_t)st.st_size)die("read extent");return b;}
static long digest(const char *p,char h[65]){size_t n;char *b=load(p,&n);if(sy_sha256_hex(b,(long)n,h))cx_sha256_hex(b,n,h);free(b);return (long)n;}
static char *line(char **p){char *s=*p;if(!*s)return 0;char *e=strchr(s,'\n');if(!e)die("final LF");*e=0;*p=e+1;return s;}
static int fields(char *s,char **v){int n=1;v[0]=s;for(;*s;s++)if(*s=='\t'){if(n==32)die("columns");*s=0;v[n++]=s+1;}return n;}
static char *kv(char **v,int n,const char *key){size_t k=strlen(key);for(int i=1;i<n;i++)if(!strncmp(v[i],key,k)&&v[i][k]=='=')return v[i]+k+1;return 0;}
static void safe(const char *s){if(!s||!*s||*s=='/'||strpbrk(s,"\\\t\r\n"))die("unsafe planned source");const char *a=s;for(;;){const char *e=strchr(a,'/');size_t n=e?(size_t)(e-a):strlen(a);if(!n||(n==1&&*a=='.')||(n==2&&!memcmp(a,"..",2)))die("unsafe planned source");if(!e)break;a=e+1;}}
static void source(char p[4400],const char *rel){safe(rel);char joined[4400];path(joined,root,rel);if(!realpath(joined,p))die("source realpath");size_t n=strlen(root);if(strncmp(p,root,n)||p[n]!='/')die("source escape");}
static int find(const char *key){for(int i=0;i<nu;i++)if(!strcmp(key,u[i].key))return i;return -1;}
static int o1(const char *s){return !strcmp(s,"drive.o")||!strcmp(s,"host.o")||!strcmp(s,"driveface.o")||!strcmp(s,"driveroute.o")||!strcmp(s,"cxmod.o")||!strcmp(s,"tapegate.o");}
int main(int argc,char **argv){began=sy_now_ms();const char *inventory=0,*slice=0,*seal=0,*out=0;int prepare=0,start=-1,count=-1;
 for(int i=1;i<argc;i++){if(!strcmp(argv[i],"--prepare")){prepare=1;continue;}if(i+1==argc)die("argument value");const char *k=argv[i],*v=argv[++i];if(!strcmp(k,"--inventory"))inventory=v;else if(!strcmp(k,"--slice"))slice=v;else if(!strcmp(k,"--sources"))seal=v;else if(!strcmp(k,"--out"))out=v;else if(!strcmp(k,"--start"))start=(int)num(v);else if(!strcmp(k,"--count"))count=(int)num(v);else die("argument");}
 if(!inventory||!slice||!seal||(prepare?(out||start>=0||count>=0):(!out||start<0||count<1)))die("usage");
 char p[4400],h[65];size_t n;path(p,slice,"receipt.txt");digest(p,recsha);char *r=load(p,&n),*at=r,*s=line(&at);if(!s||strcmp(s,"entry-build-v3"))die("receipt version");char *rp=0,*cp=0,*cs=0,*via=0;long cb=-1;int mode=-1,target=0;
 while((s=line(&at))){char *v[32];int nf=fields(s,v);if(nf==2&&!strcmp(v[0],"root")){if(rp)die("duplicate root");rp=or_dup(v[1]);}else if(nf==2&&!strcmp(v[0],"constructor")){if(cp)die("duplicate constructor");cp=or_dup(v[1]);}else if(nf==2&&!strcmp(v[0],"constructor_sha")){if(cs)die("duplicate constructor SHA");cs=or_dup(v[1]);}else if(nf==2&&!strcmp(v[0],"constructor_bytes"))cb=num(v[1]);else if(nf==2&&!strcmp(v[0],"via"))via=or_dup(v[1]);else if(!strcmp(v[0],"object_level")){char *m=kv(v,nf,"mode"),*t=kv(v,nf,"target");if(mode>=0||!m||!t||strcmp(t,"lnx/x86_64"))die("object flags/target");mode=!strcmp(m,"o1-drivers")?1:!strcmp(m,"default")?0:-1;if(mode<0)die("unsupported object mode");target=1;}else {size_t z=strlen(v[0]);if(z>2&&!strcmp(v[0]+z-2,".o")){if(nu==OR_MAX||find(v[0])>=0||strpbrk(v[0],"/\\"))die("object key");Item *a=&u[nu++];a->key=or_dup(v[0]);a->sha=or_dup(kv(v,nf,"sha")?kv(v,nf,"sha"):"");a->bytes=num(kv(v,nf,"bytes"));if(!hex(a->sha))die("object SHA");path(p,slice,a->key);if(digest(p,h)!=a->bytes||strcmp(h,a->sha))die("original object identity");}}}
 free(r);if(!rp||!cp||!hex(cs)||!via||cb<0||!target||!nu||!realpath(rp,root)||!realpath(cp,ctor))die("receipt identity");path(p,root,"unisacc.com");if(strcmp(p,ctor)||(strcmp(via,"sh")&&strcmp(via,"exec")))die("constructor route");if(digest(ctor,ctorsha)!=cb||strcmp(ctorsha,cs))die("constructor identity");
 digest(inventory,invsha);char *iv=load(inventory,&n);if(memchr(iv,0,n)||memchr(iv,'\r',n))die("inventory text");at=iv;int mapped=0,verified=0,id=0;
 while((s=line(&at))){char *v[32];int nf=fields(s,v);if(!strcmp(v[0],"INVENTORY_ID")){char *rr=kv(v,nf,"root"),*hh=kv(v,nf,"constructor_sha");if(id++||!rr||!hh||strcmp(rr,root)||strcmp(hh,ctorsha))die("inventory identity");}else if(!strcmp(v[0],"UNIT")){if(nf<4||mapped>=nu||strcmp(v[1],u[mapped].key)||num(v[3])!=u[mapped].bytes)die("inventory ordered mapping");u[mapped++].src=or_dup(v[2]);}else if(!strcmp(v[0],"SLICE_INVENTORY")){char *h0=kv(v,nf,"identity"),*uu=kv(v,nf,"units"),*mm=kv(v,nf,"mapped");if(verified++||!h0||strcmp(h0,"VERIFIED")||!uu||!mm||num(uu)!=nu||num(mm)!=nu)die("inventory verification");}}
 free(iv);if(id!=1||verified!=1||mapped!=nu)die("incomplete inventory verification");
 for(int i=0;i<nu;i++){source(p,u[i].src);digest(p,u[i].source_sha);}
 if(prepare){int fd=open(seal,O_WRONLY|O_CREAT|O_EXCL,0600);if(fd<0)die("new seal required");FILE *f=fdopen(fd,"wb");if(!f)die("seal stream");fprintf(f,"object-source-seal-v1\ninventory\t%s\nreceipt\t%s\nconstructor\t%s\n",invsha,recsha,ctorsha);for(int i=0;i<nu;i++)fprintf(f,"%s\t%s\t%s\n",u[i].key,u[i].src,u[i].source_sha);if(fclose(f))die("seal close");printf("OBJECT_SOURCE_SEAL\tstate=PREPARED\tunits=%d\n",nu);return 0;}
 char *sb=load(seal,&n);at=sb;s=line(&at);if(!s||strcmp(s,"object-source-seal-v1"))die("seal version");const char *labels[]={"inventory","receipt","constructor"};const char *hashes[]={invsha,recsha,ctorsha};for(int i=0;i<3;i++){char *v[32];s=line(&at);if(!s||fields(s,v)!=2||strcmp(v[0],labels[i])||strcmp(v[1],hashes[i]))die("seal input identity");}for(int i=0;i<nu;i++){char *v[32];s=line(&at);if(!s||fields(s,v)!=3||strcmp(v[0],u[i].key)||strcmp(v[1],u[i].src)||strcmp(v[2],u[i].source_sha))die("source SHA seal mismatch");}if(line(&at))die("extra seal row");free(sb);
 if(start>=nu||count>nu-start||count>32)die("batch range");if(mkdir(out,0700))die("new output directory required");
 for(int i=start;i<start+count;i++){tick();if(sy_now_ms()-began>40000)die("remaining child deadline");char src[4400],fresh[4400],original[4400];source(src,u[i].src);path(fresh,out,u[i].key);path(original,slice,u[i].key);char *opt=mode&&o1(u[i].key)?"-O1":"-O2";char *v[16];int k=0;if(!strcmp(via,"sh"))v[k++]="sh";v[k++]=ctor;v[k++]=opt;v[k++]="-c";v[k++]="-b";v[k++]="lnx/x86_64";v[k++]="-funit";v[k++]="-o";v[k++]=fresh;v[k++]=src;v[k]=0;
 np_result rr={0};char why[1024];if(unsetenv("UNISA_CONTAINER"))die("clear inherited container override");int tr=np_run(v,root,0,8,&rr,why,sizeof why);if(tr||rr.rc||rr.residue){if(rr.err)fwrite(rr.err,1,rr.errn,stderr);die("recompile child");}np_free(&rr);
 char nh[65],sh[65];long nb=digest(fresh,nh);digest(src,sh);if(strcmp(sh,u[i].source_sha))die("source changed during compile");if(digest(ctor,h)!=cb||strcmp(h,ctorsha))die("constructor changed during compile");size_t an,bn;char *a=load(original,&an),*b=load(fresh,&bn);int same=an==bn&&!memcmp(a,b,an);free(a);free(b);if(!same||nb!=u[i].bytes||strcmp(nh,u[i].sha))die("replayed object differs");printf("REPLAY\tindex=%d\tobject=%s\tsource=%s\tsource_sha=%s\toriginal_sha=%s\treplayed_sha=%s\tbytes=%ld\tflags=%s,-c,-b,lnx/x86_64,-funit\tcomparison=BYTE_IDENTICAL\n",i,u[i].key,u[i].src,sh,u[i].sha,nh,nb,opt);}
 char inputcheck[4400];path(inputcheck,slice,"receipt.txt");digest(inputcheck,h);if(strcmp(h,recsha))die("receipt changed during replay");digest(inventory,h);if(strcmp(h,invsha))die("inventory changed during replay");tick();printf("OBJECT_SOURCE_REPLAY\tstart=%d\tcount=%d\ttotal=%d\tstate=RECOMPILED_BYTE_IDENTICAL\thistorical_source_equivalence=NOT_CLAIMED\n",start,count,nu);return 0;
}
