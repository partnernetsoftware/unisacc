#pragma unisa use cxlib.kernelcontext
#pragma unisa use cxlib.corecompat
/* Refresh a pinned development baseline without reconstructing unchanged models.
 * This is a narrow source-equality migration plus one pinned runtime-only
 * empty-copy guard (corecompat), not a general model cache. All selected files
 * remain in model-inputs.tsv with their actual current hash; the exception is
 * explicit in package.tsv. Constructor/action definitions stay identical.
 * P3 model/directory bytes and non-kernel resources are preserved exactly.
 * Full source identity is recorded separately; this tool grants no test PASS.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use text.text
static const char *baseline_sha="7f709378fa84a36edac2fcf1c36a62a13d45c26d34e57f1f7b50af74b2de4d1a";
static char root[4096],oldroot[4096],work[4096];
static np_buf closure={0};static int checked,core_guarded;static char core_current[65],compat_helper[65];
static void die(const char *s){fprintf(stderr,"package-refresh: REFUSE %s\n",s);exit(2);}
static void path(char *p,size_t cap,const char *a,const char *b){int k=snprintf(p,cap,"%s/%s",a,b);if(k<0||(size_t)k>=cap)die("path bound");}
static char *load(const char *p,size_t *n){struct stat s;size_t z;if(lstat(p,&s)||!S_ISREG(s.st_mode)||s.st_size<0||s.st_size>268435456)die(p);char *b=cx_read(p,&z);if(!b||z!=(size_t)s.st_size)die("read/size changed");*n=z;return b;}
static void saved(const char *name,const char *b,size_t n){char p[4400];path(p,sizeof p,work,name);int f=open(p,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC|O_NOFOLLOW,0600);if(f<0)die("exclusive output");while(n){ssize_t k=write(f,b,n);if(k<0&&errno==EINTR)continue;if(k<=0)die("write; partial retained");b+=k;n-=(size_t)k;}if(fsync(f)||close(f))die("fsync/close");}
static int suffix(const char *p,const char *s){size_t n=strlen(p),k=strlen(s);return n>=k&&tx_eq(p+n-k, s, 1L << 20);}
static int source(const char *p){
 if(!strncmp(p,"exec/",5)){
  if(!strncmp(p,"exec/c/",7)||!strncmp(p,"exec/pipeline/",14))return 0;
  if(!strncmp(p,"exec/build/",11))return !strchr(p+11,'/')&&suffix(p,".py");
  return suffix(p,".tsv")||suffix(p,".json")||(suffix(p,".py")&&!suffix(p,"check.py"));
 }
 if(!strncmp(p,"seed/",5)){const char *s=p+5;return tx_eq(s, "gen.c", 1L << 20)||tx_eq(s, "facts.h", 1L << 20)||tx_eq(s, "json.h", 1L << 20)||tx_eq(s, "tbl.c", 1L << 20)||tx_eq(s, "net.c", 1L << 20)||tx_eq(s, "compilerpack.c", 1L << 20)||tx_eq(s, "pack.c", 1L << 20);}
 return suffix(p,".py")||suffix(p,".c")||suffix(p,".h")||suffix(p,".inc")||suffix(p,".tsv")||suffix(p,".json");
}
static void equal_file(const char *relative,int append){char a[4400],b[4400],h[65];size_t an,bn;path(a,sizeof a,root,relative);path(b,sizeof b,oldroot,relative);char *av=load(a,&an),*bv=load(b,&bn);if(tx_eq(relative, "exec/c/core.c", 1L << 20)){int old=cc_kind(bv,bn),now=cc_kind(av,an);if(old!=0||now<0)die("core-source-compat-unapproved");core_guarded=now;cx_sha256_hex(av,an,core_current);}else if(an!=bn||memcmp(av,bv,an))die(relative);if(append){cx_sha256_hex(av,an,h);np_puts(&closure,relative);np_puts(&closure,"\t");np_puts(&closure,h);np_puts(&closure,"\n");checked++;}free(av);free(bv);}
/* Compare both directory sets. A new or removed constructor input is refused.
 * Symlinks are excluded only where the selector excludes their suffix, e.g.
 * migrated CX test helpers; selected constructor symlinks are refused by load.
 */
static void walk(const char *relative,int reverse){char p[4400],sub[4400];struct stat st;if(tx_eq(relative, "exec/c", 1L << 20)||tx_eq(relative, "exec/pipeline", 1L << 20))return;path(p,sizeof p,reverse?oldroot:root,relative);if(lstat(p,&st))die(p);if(!strncmp(relative,"exec/build/",11)&&(S_ISDIR(st.st_mode)||!source(relative)))return;if(S_ISDIR(st.st_mode)){DIR *d=opendir(p);struct dirent *e;if(!d)die(p);while((e=readdir(d))){if(tx_eq(e->d_name, ".", 1L << 20)||tx_eq(e->d_name, "..", 1L << 20))continue;path(sub,sizeof sub,relative,e->d_name);walk(sub,reverse);}if(closedir(d))die("closedir");}else if(source(relative))equal_file(relative,!reverse);}
static void compare_sources(void){int i;const char *dirs[]={"exec","kernel","weights","include","seed","iterate/kernel"};for(i=0;i<6;i++)walk(dirs[i],0);for(i=0;i<6;i++)walk(dirs[i],1);equal_file("exec/c/core.h",1);equal_file("exec/c/core.c",1);}
typedef struct {const char *p;size_t n,at;} Reader;
static int line(Reader *r,char words[8][256]){size_t k=0;int n=0;if(r->at>=r->n)die("missing header");for(;;){if(r->at==r->n)die("truncated header");unsigned char c=r->p[r->at++];if(c=='\n'||c==' '){if(!k)die("empty header word");words[n++][k]=0;k=0;if(c=='\n')return n;if(n==8)die("header fields");}else{if(c<33||c>126||k==255)die("header word");words[n][k++]=(char)c;}}}
static size_t number(const char *p,size_t max){size_t v=0;if(!*p)die("empty number");while(*p){unsigned d=(unsigned)(*p++-'0');if(d>9||d>max||v>(max-d)/10)die("number range");v=v*10+d;}return v;}
static unsigned long long little(const char *p){unsigned long long n=0;int i;for(i=7;i>=0;i--)n=(n<<8)|(unsigned char)p[i];return n;}
static void kernel_context(const char *dir){char source_sha[65];kc_check(root,dir,source_sha);}

int main(int argc,char **argv){
 if(argc!=5){fputs("usage: ROOT FROZEN_BASELINE_ROOT KERNEL_GENERATION NEW_OUTDIR\n",stderr);return 2;}
 if(!realpath(argv[1],root)||!realpath(argv[2],oldroot)||argv[4][0]!='/'||strlen(argv[4])>=sizeof work)die("root/output");strcpy(work,argv[4]);
 char compat_path[4400];size_t compat_n;path(compat_path,sizeof compat_path,root,"tools/cxlib/corecompat.cx");char *compat_bytes=load(compat_path,&compat_n);cx_sha256_hex(compat_bytes,compat_n,compat_helper);free(compat_bytes);kernel_context(argv[3]);compare_sources();char p[4400],hash[65];size_t bn;path(p,sizeof p,oldroot,"unisacc.com");char *base=load(p,&bn);cx_sha256_hex(base,bn,hash);if(strcmp(hash,baseline_sha))die("baseline product identity");
 if(bn<16||memcmp(base+bn-16,"UNIPKG1\n",8))die("baseline package footer");unsigned long long z=little(base+bn-8);if(!z||z>bn-16)die("baseline package extent");Reader r={base+bn-16-(size_t)z,(size_t)z,0};char w[8][256];int fields=line(&r,w);if(fields!=5||strcmp(w[0],"P")||strcmp(w[1],"3"))die("P3 required");size_t models=number(w[2],65536),stages=number(w[3],65536),resources=number(w[4],65536),i;if(!models||!stages||resources<2)die("counts");
 for(i=0;i<stages;i++){if(line(&r,w)!=6||strcmp(w[0],"D"))die("stage directory");number(w[5],models-1);}
 for(i=0;i<models;i++){if(line(&r,w)!=5||strcmp(w[0],"M")||strcmp(w[3],"1"))die("model record");size_t n=number(w[1],r.n);if(!n||n>r.n-r.at||!number(w[2],2147483647))die("model extent");number(w[4],4294967295ULL);r.at+=n;}
 np_buf output={0};np_put(&output,r.p,r.at);size_t prefix=r.at;int replaced[2]={0,0};const char *arch[]={"arm64","x86_64"};char *kernels[2];size_t kn[2];char kh[2][65];
 for(i=0;i<2;i++){char rel[80];snprintf(rel,sizeof rel,"%s.kernel",arch[i]);path(p,sizeof p,argv[3],rel);kernels[i]=load(p,&kn[i]);if(kn[i]<48||memcmp(kernels[i],"UNIKERN1",8)||little(kernels[i]+8)!=i+1||little(kernels[i]+32)!=kn[i]-40||little(kernels[i]+16)>=kn[i]-40||little(kernels[i]+24)>kn[i]-48||little(kernels[i]+24)%8)die("kernel header");size_t slot=(size_t)little(kernels[i]+24);if(little(kernels[i]+40+slot))die("nonzero kernel service slot");cx_sha256_hex(kernels[i],kn[i],kh[i]);snprintf(rel,sizeof rel,"%s-kernel.sha256",arch[i]);path(p,sizeof p,argv[3],rel);size_t hn;char *h=load(p,&hn);if(hn!=64||memcmp(h,kh[i],64))die("kernel digest receipt");free(h);}
 size_t *keys=calloc(resources,sizeof *keys),*lengths=calloc(resources,sizeof *lengths);if(!keys||!lengths)die("resource index");
 for(i=0;i<resources;i++){size_t begin=r.at;if(line(&r,w)!=3||strcmp(w[0],"F"))die("resource header");size_t k=number(w[1],r.n),n=number(w[2],r.n);if(!k||k>r.n-r.at||n>r.n-r.at-k)die("resource extent");size_t j;for(j=0;j<i;j++)if(lengths[j]==k&&!memcmp(r.p+keys[j],r.p+r.at,k))die("duplicate resource");keys[i]=r.at;lengths[i]=k;int which=-1;for(j=0;j<2;j++){char key[80];snprintf(key,sizeof key,"kernel/%s",arch[j]);if(k==strlen(key)+1&&!r.p[r.at]&&!memcmp(r.p+r.at+1,key,k-1))which=(int)j;}
  if(which>=0){if(replaced[which]++)die("duplicate kernel");char header[100];int h=snprintf(header,sizeof header,"F %lu %lu\n",(unsigned long)k,(unsigned long)kn[which]);np_put(&output,header,(size_t)h);np_put(&output,r.p+r.at,k);np_put(&output,kernels[which],kn[which]);}else np_put(&output,r.p+begin,r.at-begin+k+n);r.at+=k+n;
 }
 if(r.at!=r.n||replaced[0]!=1||replaced[1]!=1)die("trailing bytes/missing kernels");
 /* No output before complete parsing and a second source comparison. */
 size_t before=closure.n;compare_sources();kernel_context(argv[3]);if(closure.n!=2*before||memcmp(closure.p,closure.p+before,before))die("source context changed during preparation");closure.n=before;closure.p[before]=0;
 /* Re-read the product and both blobs too; the context hashes their sources,
  * while these checks bind the exact carried payload bytes. */
 path(p,sizeof p,oldroot,"unisacc.com");size_t again_n;char *again=load(p,&again_n);cx_sha256_hex(again,again_n,hash);free(again);if(strcmp(hash,baseline_sha))die("baseline changed during preparation");
 for(i=0;i<2;i++){char rel[80];snprintf(rel,sizeof rel,"%s.kernel",arch[i]);path(p,sizeof p,argv[3],rel);again=load(p,&again_n);cx_sha256_hex(again,again_n,hash);free(again);if(strcmp(hash,kh[i]))die("kernel changed during preparation");}
 compat_bytes=load(compat_path,&compat_n);cx_sha256_hex(compat_bytes,compat_n,hash);free(compat_bytes);if(strcmp(hash,compat_helper))die("compat helper changed");
 if(mkdir(work,0700))die("new output directory required");saved("compiler.pkg",output.p,output.n);saved("model-inputs.tsv",closure.p,closure.n);cx_sha256_hex(output.p,output.n,hash);char toolhash[65];path(p,sizeof p,root,"tools/package-refresh.cx");again=load(p,&again_n);cx_sha256_hex(again,again_n,toolhash);free(again);char receipt[768];int n=snprintf(receipt,sizeof receipt,"PREPARED\tpackage-refresh\tno-test-result\nbaseline\t%s\npackage\t%s\nmodel-directory-prefix-bytes\t%lu\narm64-kernel\t%s\nx86_64-kernel\t%s\nchecked-source-files\t%d\nrefresh-tool\t%s\n",baseline_sha,hash,(unsigned long)prefix,kh[0],kh[1],checked/2,toolhash);if(n<0||(size_t)n>=sizeof receipt)die("receipt bound");np_buf final_receipt={0};np_put(&final_receipt,receipt,(size_t)n);if(core_guarded)cc_receipt(&final_receipt,core_current,compat_helper);saved("package.tsv",final_receipt.p,final_receipt.n);fwrite(final_receipt.p,1,final_receipt.n,stdout);free(final_receipt.p);
 free(base);free(kernels[0]);free(kernels[1]);free(keys);free(lengths);free(output.p);free(closure.p);return 0;
}
