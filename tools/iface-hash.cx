/* tools/iface-hash.cx -- per-package interface hash table from build/layer-api/*.tsv.
 *
 *   cx tools/iface-hash.cx -- --write|--check [--full] [--api DIR] [--table FILE]
 *
 * Run from the repo root. Facts in: every DIR/PKG.tsv (default build/layer-api), the authoritative export
 * list of a package: rows `name<TAB>signature<TAB>sig_sha<TAB>file`; `#` lines and blank lines are skipped.
 * The interface hash of a package is the sha256 of its rows sorted by name (byte order), each rendered as
 * `name<TAB>signature<LF>` with the signature's runs of blanks collapsed to one space and trimmed. A
 * function body is not in layer-api, so a body-only edit leaves the hash unchanged; a signature edit,
 * an added or removed export, or a rename changes it. Row order in the file does not matter. A package
 * with two identical rows (same name and same signature text) is refused (REFUSE, rc 2). An empty package hashes the empty string.
 * Per-package incremental row cache (keyed by file sha256, bypassed by --full) keeps output byte-identical to full run.
 * Table out: build/iface-hash.tsv (or --table FILE), four TAB fields `pkg iface_sha256 n_exports source`.
 * --check: rc 1 with DIFF lines unless the table equals what the facts give now. --write: writes it.
 * Prints IFACE_HASH<TAB>ok|FAIL|WROTE<TAB>packages=N. Exit 0 ok, 1 differs, 2 usage/unreadable/refused.
 * Nothing here is a test result; it is a fact table for later batch selection. Check: tools/check-iface-hash.cx. */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use sys.sha
#pragma unisa use sys.posix
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use cxlib.awpath
#pragma unisa use cxlib.genkit

typedef struct { char *b; long n, cap; int bad; } IhBuf;
static void ih_put(IhBuf *o, const char *s, long n) {
    if (o->bad || n <= 0) return;
    if (o->n + n + 1 > o->cap) {
        long nc = o->cap ? o->cap * 2 : 4096;
        while (nc < o->n + n + 1) nc *= 2;
        char *nb = (char *)mm_alloc((size_t)nc);
        if (!nb) { o->bad = 1; return; }
        if (o->b && o->n > 0) mm_copy(nb, nc, o->b, o->n);
        if (o->b) mm_free(o->b);
        o->b = nb; o->cap = nc;
    }
    mm_copy(o->b + o->n, o->cap - o->n, s, n);
    o->n += n;
    o->b[o->n] = 0;
}
static void ih_puts(IhBuf *o, const char *s) { ih_put(o, s, tx_len(s, 100000)); }

enum { MAXR = 4096, MAXP = 64 };
static long rn[MAXR], rl[MAXR];      /* per row: name offset/len */
static long sn[MAXR], sl[MAXR];      /* signature offset/len */
static int ord[MAXR];
static char names[MAXP][128];
static int ih_full = 0;

static int cmp_row(const char *t, int a, int b) {
    long la = rl[a], lb = rl[b], m = la < lb ? la : lb, i;
    for (i = 0; i < m; i++) {
        unsigned char x = (unsigned char)t[rn[a] + i], y = (unsigned char)t[rn[b] + i];
        if (x != y) return x < y ? -1 : 1;
    }
    if (la != lb) return la < lb ? -1 : 1;
    la = sl[a]; lb = sl[b]; m = la < lb ? la : lb;
    for (i = 0; i < m; i++) {
        unsigned char x = (unsigned char)t[sn[a] + i], y = (unsigned char)t[sn[b] + i];
        if (x != y) return x < y ? -1 : 1;
    }
    return la < lb ? -1 : la > lb ? 1 : 0;
}

/* The hash of one layer-api text. 0 ok, -1 duplicate name (*dup = row of the second one), -2 too many rows or bad row. */
static int iface_of(const char *t, long n, char hex[65], int *nex, int *dup) {
    IhBuf b = {0, 0, 0, 0};
    long i = 0, e, o, l, k;
    int r = 0, a, c, rc = 0;
    *nex = 0; *dup = -1;
    while (i < n) {
        e = i;
        while (e < n && t[e] != '\n') e++;
        if (e > i && t[i] != '#') {
            if (r >= MAXR || tx_field(t + i, e - i, '\t', 0, &o, &l) || l == 0) return -2;
            rn[r] = i + o; rl[r] = l;
            if (tx_field(t + i, e - i, '\t', 1, &o, &l)) { sn[r] = i; sl[r] = 0; } else { sn[r] = i + o; sl[r] = l; }
            ord[r] = r; r++;
        }
        i = e + 1;
    }
    for (a = 1; a < r; a++) {
        int v = ord[a];
        c = a - 1;
        while (c >= 0 && cmp_row(t, ord[c], v) > 0) { ord[c + 1] = ord[c]; c--; }
        ord[c + 1] = v;
    }
    for (a = 0; a < r && rc == 0; a++) {
        int w = ord[a];
        int inws = 0;
        if (a > 0 && cmp_row(t, ord[a - 1], w) == 0) { *dup = w; rc = -1; break; }
        ih_put(&b, t + rn[w], rl[w]);
        ih_put(&b, "\t", 1);
        for (k = 0; k < sl[w]; k++) {
            char ch = t[sn[w] + k];
            if (ch == ' ' || ch == '\t' || ch == '\r') inws = 1;
            else { if (inws && b.n > 0 && b.b[b.n - 1] != '\t') ih_put(&b, " ", 1); inws = 0; ih_put(&b, &ch, 1); }
        }
        ih_put(&b, "\n", 1);
    }
    if (rc == 0) {
        if (b.bad) rc = -2;
        else sy_sha256_hex(b.b ? (const char *)b.b : "", (long)b.n, hex);
    }
    *nex = r;
    mm_free(b.b);
    return rc;
}

static int zcmp(const char *a, const char *b) {
    while (*a && *a == *b) { a++; b++; }
    return (unsigned char)*a < (unsigned char)*b ? -1 : (unsigned char)*a > (unsigned char)*b ? 1 : 0;
}

static int sort_names(int np) {
    int a, c;
    for (a = 1; a < np; a++) {
        char tmp[128];
        tx_copy(tmp, sizeof tmp, names[a], tx_len(names[a], 128));
        c = a - 1;
        while (c >= 0 && zcmp(names[c], tmp) > 0) { tx_copy(names[c + 1], 128, names[c], tx_len(names[c], 128)); c--; }
        tx_copy(names[c + 1], 128, tmp, tx_len(tmp, 128));
    }
    return 0;
}

static int ih_cache_get(const char *fsha, char hex[65], int *nex) {
    char p[4400];
    if (ih_full || cx_fmt(p, sizeof p, "%s/unisacc-ih-inc/%s.row", sy_tmpdir(), fsha)) return 0;
    size_t n = 0;
    char *b = cx_read(p, &n);
    if (!b) return 0;
    int ok = 0;
    if (n > 66 && b[64] == '\t') {
        int good_hex = 1;
        for (int i = 0; i < 64; i++) {
            char c = b[i];
            if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) { good_hex = 0; break; }
        }
        if (good_hex) {
            int v = 0, dig = 0;
            for (size_t i = 65; i < n && b[i] != '\n'; i++) {
                if (b[i] < '0' || b[i] > '9') { dig = 0; break; }
                v = v * 10 + (b[i] - '0'); dig++;
            }
            if (dig > 0) {
                mm_copy(hex, 65, b, 64);
                hex[64] = 0;
                *nex = v;
                ok = 1;
            }
        }
    }
    mm_free(b);
    return ok;
}

static void ih_cache_put(const char *fsha, const char *hex, int nex) {
    char d[4400], p[4400], row[96];
    if (ih_full || cx_fmt(d, sizeof d, "%s/unisacc-ih-inc", sy_tmpdir()) || sy_mkdir_all(d, 0700)) return;
    if (cx_fmt(p, sizeof p, "%s/%s.row", d, fsha) || cx_fmt(row, sizeof row, "%s\t%d\n", hex, nex)) return;
    (void)sy_write_atomic(p, row, tx_len(row, sizeof row), 0600);
}

static int build(const char *root, const char *api, IhBuf *out) {
    sy_dir_t d;
    int np = 0, a;
    if (root) (void)gk_tracked_load(root);
    else gk_tracked_free();
    if (sy_dir_open(&d, api) < 0) { sy_eprintf("iface-hash: cannot open %s\n", api); return 2; }
    while (sy_dir_next(&d) > 0) {
        long n = d.name_n;
        char rela[256];
        if (n > 4 && n < 120 && tx_eqz(d.name + n - 4, ".tsv") && np < MAXP) {
            if (cx_fmt(rela, sizeof rela, "build/layer-api/%s", d.name) || !gk_tracked_has(rela)) continue;
            tx_copy(names[np], 128, d.name, n - 4);
            np++;
        }
    }
    sy_dir_close(&d);
    sort_names(np);
    ih_puts(out, "# iface-hash v1: sha256 of a package's layer-api rows sorted by name (name TAB blank-collapsed signature LF); tools/iface-hash.cx\n");
    ih_puts(out, "# pkg\tiface_sha256\tn_exports\tsource\n");
    for (a = 0; a < np; a++) {
        char path[4400], hex[65], fsha[65], num[24];
        size_t n = 0;
        int nex = 0, dup = -1, rc = 0;
        char *t;
        if (cx_fmt(path, sizeof path, "%s/%s.tsv", api, names[a])) return 2;
        t = cx_read(path, &n);
        if (!t) { sy_eprintf("iface-hash: unreadable %s\n", path); return 2; }
        fsha[0] = 0;
        if (!ih_full && !sy_sha256_hex(t, (long)n, fsha) && ih_cache_get(fsha, hex, &nex)) {
            mm_free(t);
        } else {
            rc = iface_of(t, (long)n, hex, &nex, &dup);
            if (rc == -1) {
                sy_printf("REFUSE\t%s\tduplicate-name\t%.*s\n", names[a], (int)rl[dup], t + rn[dup]);
                mm_free(t);
                return 2;
            }
            if (rc) { sy_eprintf("iface-hash: bad rows in %s\n", path); mm_free(t); return 2; }
            mm_free(t);
            if (fsha[0]) ih_cache_put(fsha, hex, nex);
        }
        cx_fmt(num, sizeof num, "%d", nex);
        ih_puts(out, names[a]); ih_put(out, "\t", 1); ih_puts(out, hex); ih_put(out, "\t", 1);
        ih_puts(out, num); ih_put(out, "\t", 1); ih_puts(out, path); ih_put(out, "\n", 1);
    }
    return out->bad ? 2 : 0;
}

int main(int argc, char **argv) {
    const char *api = "build/layer-api", *table = "build/iface-hash.tsv";
    int write = -1, k, rc, np = 0;
    long i;
    IhBuf b = {0, 0, 0, 0};
    for (k = 1; k < argc; k++) {
        if (tx_eqz(argv[k], "--write") && write < 0) write = 1;
        else if (tx_eqz(argv[k], "--check") && write < 0) write = 0;
        else if (tx_eqz(argv[k], "--full")) ih_full = 1;
        else if (tx_eqz(argv[k], "--api") && k + 1 < argc) api = argv[++k];
        else if (tx_eqz(argv[k], "--table") && k + 1 < argc) table = argv[++k];
        else { write = -1; break; }
    }
    if (write < 0) { sy_eprintf("iface-hash: usage: --write|--check [--full] [--api DIR] [--table FILE]\n"); return 2; }
    rc = build(tx_eqz(api, "build/layer-api") ? "." : 0, api, &b);
    if (rc) { mm_free(b.b); return rc; }
    for (i = 0; i < (long)b.n; i++) if (b.b[i] == '\n') np++;
    np -= 2;
    if (tx_eqz(table, "build/iface-hash.tsv")) {
        /* double write: the dev metadata copy (cxlib/awpath awp_devmeta) stays byte-identical to the default table */
        char dm[1024]; size_t dn = 0; char *dc;
        if (awp_devmeta(".", "iface-hash.tsv", write, dm, sizeof dm)) { sy_eprintf("iface-hash: devmeta path\n"); mm_free(b.b); return 2; }
        if (write) {
            if (cx_write(dm, b.b, (size_t)b.n)) { sy_eprintf("iface-hash: cannot write %s\n", dm); mm_free(b.b); return 2; }
        } else {
            dc = cx_read(dm, &dn);
            if (dc) {
                if (dn != b.n || !mm_same(dc, b.b, (long)dn)) sy_printf("MIRROR_STALE\t%s\thint=derive --write --only iface-hash\n", dm);
                mm_free(dc);
            }
        }
    }
    if (write) {
        if (cx_write(table, b.b, (size_t)b.n)) { sy_eprintf("iface-hash: cannot write %s\n", table); mm_free(b.b); return 2; }
        sy_printf("IFACE_HASH\tWROTE\tpackages=%d\n", np);
        mm_free(b.b);
        return 0;
    } else {
        size_t on = 0;
        char *old = cx_read(table, &on);
        if (!old) { sy_printf("DIFF\ttable-missing\t%s\n", table); sy_printf("IFACE_HASH\tFAIL\tpackages=%d\n", np); mm_free(b.b); return 1; }
        if (on != b.n || !mm_same(old, b.b, (long)on)) {
            sy_printf("DIFF\ttable-differs-from-source\t%s\n", table);
            sy_printf("IFACE_HASH\tFAIL\tpackages=%d\n", np);
            mm_free(old); mm_free(b.b);
            return 1;
        }
        sy_printf("IFACE_HASH\tok\tpackages=%d\n", np);
        mm_free(old); mm_free(b.b);
        return 0;
    }
}
