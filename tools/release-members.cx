/* Byte identity handoff only; this does not authenticate a signature. */
#pragma unisa use runtime.packagefooter
#pragma unisa use runtime.packagestruct
#pragma unisa use mem.bytes
static const char *roles[]={"ape","osx-arm64","osx-x86_64","cache-arm64","cache-x86_64"};
static char root[4400],names[5][256],hashes[5][65];
static struct stat identities[5];
static void die(const char*s){fprintf(stderr,"release-members: %s\n",s);exit(2);}
static int same(struct stat*a,struct stat*b){return a->st_dev==b->st_dev&&a->st_ino==b->st_ino&&a->st_size==b->st_size&&a->st_mtime==b->st_mtime&&a->st_ctime==b->st_ctime&&a->st_mode==b->st_mode;}
static char*readfile(const char*p,size_t*n,struct stat*identity,long cap){struct stat st,after,link;if(lstat(p,&link)||!S_ISREG(link.st_mode))die("regular non-symlink file required");int fd=open(p,O_RDONLY|O_NOFOLLOW|O_CLOEXEC);if(fd<0||fstat(fd,&st)||!same(&link,&st)||st.st_size<1||st.st_size>cap)die("bounded input extent");char*b=malloc(st.st_size+1);if(!b)die("allocation");long at=0;while(at<st.st_size){ssize_t z=read(fd,b+at,st.st_size-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("input read");at+=z;}char c;if(read(fd,&c,1)||fstat(fd,&after)||!same(&st,&after)||close(fd)||lstat(p,&link)||!same(&st,&link))die("input changed while reading");b[at]=0;*n=at;*identity=st;return b;}
static unsigned long u32(const unsigned char*b){return (unsigned long)b[0]|((unsigned long)b[1]<<8)|((unsigned long)b[2]<<16)|((unsigned long)b[3]<<24);}
static unsigned long long u64(const unsigned char*b){return (unsigned long long)u32(b)|((unsigned long long)u32(b+4)<<32);}
static int safe(const char*s){size_t n=strlen(s);if(!n||n>255||!((s[0]>='A'&&s[0]<='Z')||(s[0]>='a'&&s[0]<='z')||(s[0]>='0'&&s[0]<='9')))return 0;for(size_t i=0;i<n;i++)if(!((s[i]>='A'&&s[i]<='Z')||(s[i]>='a'&&s[i]<='z')||(s[i]>='0'&&s[i]<='9')||s[i]=='.'||s[i]=='_'||s[i]=='-'))return 0;return 1;}
static void macho(const unsigned char*b,size_t n,unsigned long cpu){if(n<32||u32(b)!=0xfeedfacfUL||u32(b+4)!=cpu||u32(b+12)!=2)die("thin MachO64 MH_EXECUTE CPU mismatch");unsigned long nc=u32(b+16),bytes=u32(b+20);if(!nc||nc>65536||bytes>n-32||nc>bytes/8)die("MachO command table extent");size_t at=32,end=32+bytes;for(unsigned long i=0;i<nc;i++){if(end-at<8)die("MachO command header");unsigned long cmd=u32(b+at),z=u32(b+at+4);if(z<8||z%8||z>end-at)die("MachO command boundary");if(cmd==0x19){if(z<72||u32(b+at+64)>(z-72)/80)die("MachO segment sections");unsigned long long off=u64(b+at+40),len=u64(b+at+48);if(off>n||len>n-off)die("MachO segment file extent");}if(cmd==0x1d){if(z!=16||u32(b+at+8)>n||u32(b+at+12)>n-u32(b+at+8))die("MachO signature blob extent");}at+=z;}if(at!=end)die("MachO command count mismatch");}
static void member(int i,int initial){char p[4700],h[65];if(cx_fmt(p,sizeof p,"%s/%s",root,names[i]))die("member path");size_t n;struct stat st;char*b=readfile(p,&n,&st,67108864);if(!i){PackageFooter f;int version=0;if(n<2||b[0]!='M'||b[1]!='Z'||!packagefooter_locate_bytes((unsigned char*)b,n,&f)||cxps_audit((unsigned char*)b+f.package_offset,f.package_length,&version)||version!=4)die("APE requires MZ and structurally valid P4 footer package");}else macho((unsigned char*)b,n,i==1||i==3?0x100000cUL:0x1000007UL);cx_sha256_hex(b,n,h);free(b);if(initial){if(mm_copy(hashes[i],65,h,65))die("SHA copy");identities[i]=st;}else if(strcmp(h,hashes[i])||!same(&st,&identities[i]))die("member identity changed or SHA mismatch");}
static void validate_names(void){for(int i=0;i<5;i++){if(!safe(names[i]))die("safe basename required");for(int j=0;j<i;j++)if(!strcmp(names[i],names[j]))die("distinct member basenames required");}}
static void verify(const char*manifest){size_t n;struct stat st;char*b=readfile(manifest,&n,&st,4096),manifest_hash[65];cx_sha256_hex(b,n,manifest_hash);if(memchr(b,0,n)||memchr(b,'\r',n))die("manifest text");char*p=b;for(int i=0;i<5;i++){char*e=strchr(p,'\n');if(!e)die("manifest exactly five complete lines");*e=0;char*t=strchr(p,'\t');if(!t)die("manifest role column");*t++=0;char*h=strchr(t,'\t');if(!h)die("manifest name column");*h++=0;if(strcmp(p,roles[i])||strchr(h,'\t')||strlen(h)!=64||!safe(t))die("canonical manifest role/name/SHA");for(int k=0;k<64;k++)if(!((h[k]>='0'&&h[k]<='9')||(h[k]>='a'&&h[k]<='f')))die("lowercase SHA64 required");if(mm_copy(names[i],256,t,strlen(t)+1)||mm_copy(hashes[i],65,h,65))die("manifest bound");p=e+1;}if(*p)die("extra manifest line");validate_names();for(int i=0;i<5;i++){char expected[65];if(mm_copy(expected,65,hashes[i],65))die("expected SHA");member(i,1);if(strcmp(expected,hashes[i]))die("manifest SHA mismatch");}for(int i=0;i<5;i++)member(i,0);free(b);struct stat after;char*h=readfile(manifest,&n,&after,4096);char hh[65];cx_sha256_hex(h,n,hh);free(h);if(!same(&st,&after)||strcmp(hh,manifest_hash))die("manifest changed during check");printf("RELEASE_MEMBERS\tstatus=PASS\tmembers=5\tmanifest_sha=%s\tscope=bytes-only\tsignature=NOT_CLAIMED\n",manifest_hash);}
int main(int argc,char**argv){int checking=argc==4&&!strcmp(argv[1],"--check");if(!checking&&argc!=8){fprintf(stderr,"usage: release-members DIR NEW_MANIFEST APE OSX_ARM OSX_X64 CACHE_ARM CACHE_X64 | --check DIR MANIFEST\n");return 2;}const char*dir=argv[checking?2:1],*manifest=argv[checking?3:2];if(!realpath(dir,root))die("DIR realpath");struct stat ds;if(stat(root,&ds)||!S_ISDIR(ds.st_mode))die("DIR directory");if(checking){verify(manifest);return 0;}for(int i=0;i<5;i++)if(mm_copy(names[i],256,argv[i+3],strlen(argv[i+3])+1))die("basename bound");validate_names();for(int i=0;i<5;i++)member(i,1);char data[4096];size_t at=0;for(int i=0;i<5;i++){if(cx_fmt(data+at,sizeof data-at,"%s\t%s\t%s\n",roles[i],names[i],hashes[i]))die("manifest output bound");at=strlen(data);}for(int i=0;i<5;i++)member(i,0);int fd=open(manifest,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive new manifest required");size_t done=0;while(done<at){ssize_t z=write(fd,data+done,at-done);if(z<0&&errno==EINTR)continue;if(z<=0)die("manifest write");done+=z;}if(fsync(fd)||close(fd))die("manifest close");verify(manifest);return 0;}
