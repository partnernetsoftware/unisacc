/* tools/gen-ffi-bridge.cx -- emit the FFI bridge byte table from an assembled bridge object (C44 FFI, §4).
 *   gen-ffi-bridge [--check] ARCH OBJ OUT
 * OBJ is the ELF64 relocatable object from the product assembler; its .text is taken by tools/formats-elf-text.cx
 * (run from the current directory = repository root), so no host objcopy is involved. A RAW input that does not
 * start with the ELF magic is still taken as already-extracted .text bytes (used by check-ffi-bridge-bytes). */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.proc
#pragma unisa use text.text

/* sy_run with a bound: ARGV runs under cx_runv_timeout (SECS, process group killed on expiry), stdout and stderr
   merged into OUT (CAP, NUL-terminated, *CUT set when it did not fit; CUT may be 0). */
static int bounded_run(char **argv, int secs, char *out, int cap, int *cut) {
    char *w[64], *b = 0;
    size_t n = 0, j;
    int k = 0, i, rc;
    if (cut) *cut = 0;
    if (!argv) return -EINVAL;
    w[k++] = "sh"; w[k++] = "-c"; w[k++] = "exec \"$@\" 2>&1"; w[k++] = "sh";
    for (i = 0; argv[i] && k < 63; i++) w[k++] = argv[i];
    if (argv[i]) return -E2BIG;
    w[k] = 0;
    rc = cx_runv_timeout(w, secs, &b, &n);
    if (cap > 0) {
        if (n > (size_t)cap - 1) { n = (size_t)cap - 1; if (cut) *cut = 1; }
        for (j = 0; b && j < n; j++) out[j] = b[j];
        out[b ? n : 0] = 0;
    }
    free(b);
    return rc;
}
/* prototype: genffi <arch> <raw.bin> <out.h> | genffi --check <arch> <raw.bin> <out.h> */
static int same(const char *a, const char *b) { long i = 0; if (!a || !b) return 0; while (a[i] && a[i] == b[i]) i++; return a[i] == b[i]; }
int main(int argc, char **argv) {
    int check = 0, i = 1;
    const char *arch, *raw, *out;
    size_t n = 0;
    unsigned char *b;
    char head[256], body[9000];
    long at = 0;
    if (argc > 1 && same(argv[1], "--check")) { check = 1; i = 2; }
    if (argc < i + 3) { printf("usage: genffi [--check] ARCH RAW OUT\n"); return 2; }
    arch = argv[i]; raw = argv[i+1]; out = argv[i+2];
    b = (unsigned char *)cx_read(raw, &n);
    if (!b || n == 0) { printf("genffi: cannot read %s\n", raw); return 2; }
    if (n >= 4 && b[0] == 0x7f && b[1] == 'E' && b[2] == 'L' && b[3] == 'F') {
        char tmp[4400], log[512];
        char *av[] = { "sh", "unisacc.com", "tools/formats-elf-text.cx", "--", (char *)raw, tmp, 0 };
        if (cx_fmt(tmp, sizeof tmp, "%s.text.tmp", out)) return 2;
        log[0] = 0;
        if (bounded_run(av, 50, log, (int)sizeof log, 0) != 0) { printf("genffi: .text extraction failed: %s\n", log); return 2; }
        free(b); n = 0;
        b = (unsigned char *)cx_read(tmp, &n);
        sy_unlink(tmp);
        if (!b || n == 0) { printf("genffi: cannot read extracted .text\n"); return 2; }
    }
    if (cx_fmt(head, sizeof head, "static const unsigned char ffi_bridge_%s[%ld] = {", arch, (long)n)) return 2;
    at = tx_len(head, sizeof head);
    for (size_t k = 0; k < n; k++) {
        char one[8];
        if (cx_fmt(one, sizeof one, "%s0x%02x", k ? "," : "", b[k])) return 2;
        long l = tx_len(one, sizeof one);
        if (at + l + 3 >= (long)sizeof body) return 2;
        for (long q = 0; q < l; q++) body[at++] = one[q];
    }
    body[at++] = '}'; body[at++] = ';'; body[at++] = '\n'; body[at] = 0;
    {   char full[9200];
        long f = 0;
        { long q; for (q = 0; head[q]; q++) full[f++] = head[q]; }
        { long q; for (q = 0; body[q]; q++) full[f++] = body[q]; }
        full[f] = 0;
        if (check) {
            size_t m = 0; char *old = cx_read(out, &m);
            if (!old || (long)m != f) { printf("genffi: CHECK FAIL (missing or size)\n"); return 1; }
            for (long q = 0; q < f; q++) if (old[q] != full[q]) { printf("genffi: CHECK FAIL at %ld\n", q); return 1; }
            printf("genffi: CHECK OK %s %ld bytes\n", arch, (long)n);
        } else {
            if (cx_write(out, full, (size_t)f)) return 2;
            printf("genffi: WROTE %s %ld bytes\n", out, (long)n);
        }
    }
    free(b);
    return 0;
}
