/* tools/stream-io-cases-gen.cx -- registered 2026-10-28 (batches stream-e4-io / stream-prune-io; first run in a granted
 * window, rerun 18:1x as light work). Original note: DRAFT (written 2026-10-28 without a run window; NOT executed: run it
 * first, fix what the run shows, then register). Stream I/O cells for one pinned stream container:
 *   e4/prune.det.file-vs-stdin, e4/prune.ref.non-regular-input, e4/prune.rec.after-refusal, e4.ref.step-budget
 *   sh ./unisacc.com tools/stream-io-cases-gen.cx -- ROOT STREAM_COM ABS_OUT e4|prune
 * Contract sources: tools/stream-runtime.c (INPUT "-" reads stdin; USLATTR1 framing; UNISA_ATTRIBUTES), exec/c/run.c
 * readfile(): `run: cannot open PATH[: ENOENT|ENOTDIR|EACCES]` then `cannot open input` (non-zero rc, empty stdout);
 * run.c: status 3 prints `step budget exhausted (budget N steps)` with UNISA_MAXSTEPS=N.
 * Oracles: the fixture tape has a hand-derived expected output (non-vacuous); the '-' route must equal the file route
 * byte for byte; each refusal must have rc != 0, empty stdout, stderr naming the path, with ENOENT/EACCES/ENOTDIR texts
 * pairwise different; after every refusal the fixture must reproduce its oracle; UNISA_MAXSTEPS=1 must give rc 3, the
 * declared text and empty stdout. A directory given as INPUT may open successfully on Linux and fail at read: the row
 * then records the observed refusal text as INFO instead of asserting a name (honest, not PASS). */
#pragma unisa use cxlib.netpack
#pragma unisa use text.text

static char root[4096], stream[4096], outdir[4096], inc[4400], bound[4400];
static FILE *res; static int npass, nfail, nnotrun; static const char *pfx;
static void die(const char *s) { fprintf(stderr, "stream-io-cases: REFUSE %s errno=%d\n", s, errno); exit(2); }
static void path(char *p, size_t cap, const char *a, const char *b) { int n = snprintf(p, cap, "%s/%s", a, b); if (n < 0 || (size_t)n >= cap) die("path"); }
static void saved(const char *p, const char *s, size_t n) { int f = open(p, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600); if (f < 0) die("exclusive create"); while (n) { ssize_t k = write(f, s, n); if (k <= 0) die("write"); s += k; n -= (size_t)k; } if (close(f)) die("close"); }
static void row(const char *state, const char *cell, const char *label, const char *detail) { fprintf(res, "%s\t%s.%s\t%s\t%s\n", state, pfx, cell, label, detail); if (tx_eqz(state, "PASS")) npass++; else if (tx_eqz(state, "FAIL")) nfail++; else if (tx_eqz(state, "NOT_RUN")) nnotrun++; }
static void check(int ok, const char *cell, const char *label, const char *detail) { row(ok ? "PASS" : "FAIL", cell, label, detail); }
/* run the container on INPUT (a path or "-" with stdin bytes), extra env, 12 s bound */
static int run_stream(const char *input, const char *stdin_bytes, size_t stdin_n, char *const extra_env[], np_result *r) {
    char *v[] = { bound, "12", stream, (char *)input, (char *)input, inc, 0 }; char *env[8]; int n = 0; env[n++] = "UNISA_ATTRIBUTES=";
    if (!extra_env) env[n++] = "UNISA_MAXSTEPS=200000000";              /* the caller's extra env replaces the default budget (no duplicate variable) */
    for (int i = 0; extra_env && extra_env[i]; i++) { if (n >= 6) die("env bound"); env[n++] = extra_env[i]; } env[n] = 0; char why[1024];
    if (stdin_bytes) { /* np_run has no stdin feed: route through sh with a here-string file */
        char fp[4400]; { if (cx_fmt(fp, sizeof fp, "%s/stdin.bytes", outdir)) { fprintf(stderr, "stream-io-cases-gen: text too long for fp\n"); exit(2); } } unlink(fp); saved(fp, stdin_bytes, stdin_n);
        char cmd[9000]; { if (cx_fmt(cmd, sizeof cmd, "exec %s 12 %s - - %s < %s", bound, stream, inc, fp)) { fprintf(stderr, "stream-io-cases-gen: text too long for cmd\n"); exit(2); } } char *sv[] = { "sh", "-c", cmd, 0 };
        return np_run(sv, root, env, 14, r, why, sizeof why); }
    return np_run(v, root, env, 14, r, why, sizeof why);
}
static int exact(const np_result *r, const char *want) { size_t n = strlen(want); return !r->rc && r->outn == n && !memcmp(r->out, want, n); }

int main(int argc, char **argv) {
    if (argc != 5 || !realpath(argv[1], root) || !realpath(argv[2], stream) || argv[3][0] != '/' || (strcmp(argv[4], "e4") && !tx_eqz(argv[4], "prune"))) { fputs("usage: ROOT STREAM_COM ABS_OUT e4|prune\n", stderr); return 2; }
    pfx = argv[4]; { if (cx_fmt(outdir, sizeof outdir, "%s", argv[3])) { fprintf(stderr, "stream-io-cases-gen: text too long for outdir\n"); exit(2); } } if (mkdir(outdir, 0700)) die("new out dir must be absent");
    path(inc, sizeof inc, root, "include"); path(bound, sizeof bound, root, "tools/bound");
    char rp[4400]; path(rp, sizeof rp, outdir, "results.tsv"); res = fopen(rp, "wbx"); if (!res) die("results");
    { size_t n; char *b = cx_read(stream, &n); if (!b) die("stream"); char h[65]; cx_sha256_hex(b, n, h); free(b); fprintf(res, "IDENTITY\tstream=%s\n", h); }
    /* fixture and its hand oracle: E4 O2 turns `imm r2, 0 / add64 r0, r1, r2` into `mov r0, r1`; prune drops `dead` */
    const char *fix = tx_eqz(pfx, "e4") ? "_start:\n  imm r2, 0\n  add64 r0, r1, r2\n  ret\n"
        : "_start:\n  call main\n  ret\nmain:\n  .frame 8\n  store64 [r7+0], r6\n  mov r6, r7\n  .frame 0\n  imm r0, 7\n  ret\ndead:\n  .frame 8\n  store64 [r7+0], r6\n  mov r6, r7\n  .frame 0\n  imm r0, 99\n  ret\n";
    const char *want = tx_eqz(pfx, "e4") ? "_start:\n  mov r0, r1\n  ret\n" : "_start:\n  call main\n  ret\nmain:\n  .frame 8\n  store64 [r7+0], r6\n  mov r6, r7\n  .frame 0\n  imm r0, 7\n  ret\n";
    char fp[4400]; path(fp, sizeof fp, outdir, "fixture.tape"); saved(fp, fix, strlen(fix)); np_result a, b;
    /* det.file-vs-stdin */
    if (run_stream(fp, 0, 0, 0, &a)) row("NOT_RUN", "det.file-vs-stdin", "file-route", "container did not run");
    else { check(exact(&a, want), "det.file-vs-stdin", "file-route.oracle", "hand oracle");
        if (run_stream("-", fix, strlen(fix), 0, &b)) row("NOT_RUN", "det.file-vs-stdin", "stdin-route", "container did not run");
        else { check(!b.rc && a.outn == b.outn && !memcmp(a.out, b.out, a.outn), "det.file-vs-stdin", "stdin-equals-file", "byte equality"); np_free(&b); }
        np_free(&a); }
    /* ref.non-regular-input + rec.after-refusal */
    char dirp[4400], unreadable[4400], notdir[4400], missing[4400]; path(dirp, sizeof dirp, outdir, "adir"); if (mkdir(dirp, 0700)) die("adir");
    path(unreadable, sizeof unreadable, outdir, "unreadable.tape"); saved(unreadable, fix, strlen(fix)); if (chmod(unreadable, 0)) die("chmod");
    { if (cx_fmt(notdir, sizeof notdir, "%s/x", fp)) { fprintf(stderr, "stream-io-cases-gen: text too long for notdir\n"); exit(2); } } path(missing, sizeof missing, outdir, "missing.tape");
    struct { const char *label, *in, *expect; int assert_name; } refs[4] = { { "missing", missing, "ENOENT", 1 }, { "unreadable", unreadable, "EACCES", 1 }, { "notdir", notdir, "ENOTDIR", 1 }, { "directory", dirp, "", 0 } };
    char texts[4][300]; int ntext = 0;
    for (int i = 0; i < 4; i++) { np_result r; char lab[160]; { if (cx_fmt(lab, sizeof lab, "%s.refused", refs[i].label)) { fprintf(stderr, "stream-io-cases-gen: text too long for lab\n"); exit(2); } }
        if (run_stream(refs[i].in, 0, 0, 0, &r)) { row("NOT_RUN", "ref.non-regular-input", lab, "container did not run"); continue; }
        int named = r.errn && strstr(r.err, "cannot open") && strstr(r.err, refs[i].in); int reason = !refs[i].assert_name || strstr(r.err, refs[i].expect) != 0;
        { if (cx_fmt(texts[ntext], sizeof texts[0], "%.*s", (int)(r.errn > 200 ? 200 : r.errn), r.err)) { fprintf(stderr, "stream-io-cases-gen: text too long for texts[ntext]\n"); exit(2); } } for (char *q = texts[ntext]; *q; q++) if (*q == '\n') *q = ' '; ntext++;
        if (refs[i].assert_name) { check(r.rc && !r.outn && named, "ref.non-regular-input", lab, "rc != 0, empty stdout, path named");
            char l2[200]; { if (cx_fmt(l2, sizeof l2, "%s.reason-word-%s", refs[i].label, refs[i].expect)) { fprintf(stderr, "stream-io-cases-gen: text too long for l2\n"); exit(2); } }
            if (reason) check(1, "ref.non-regular-input", l2, "reason word present");
            else fprintf(res, "UNVERIFIED\t%s.ref.non-regular-input\t%s\tcontainer prints no reason word: this pinned material predates run.c io_open_reason (ENOENT/ENOTDIR/EACCES distinction needs a container built from the current source)\n", pfx, l2); }
        else fprintf(res, "INFO\t%s.ref.non-regular-input\t%s\trc=%d stdout=%zu stderr=%s\n", pfx, lab, r.rc, r.outn, texts[ntext - 1]);
        np_free(&r);
        /* recovery right after this refusal */
        np_result c; { if (cx_fmt(lab, sizeof lab, "after-%s.fixture-reproduced", refs[i].label)) { fprintf(stderr, "stream-io-cases-gen: text too long for lab\n"); exit(2); } }
        if (run_stream(fp, 0, 0, 0, &c)) row("NOT_RUN", "rec.after-refusal", lab, "container did not run"); else { check(exact(&c, want), "rec.after-refusal", lab, "oracle reproduced"); np_free(&c); } }
    check(ntext >= 3 && !tx_eqz(texts[0], texts[1]) && !tx_eqz(texts[0], texts[2]) && !tx_eqz(texts[1], texts[2]), "ref.non-regular-input", "enoent-eacces-enotdir.distinct", "three refusal texts pairwise different");
    /* ref.step-budget (e4 only; prune's row is shared through resources) */
    if (tx_eqz(pfx, "e4")) { np_result r; char *env[] = { "UNISA_MAXSTEPS=1", 0 };
        if (run_stream(fp, 0, 0, env, &r)) row("NOT_RUN", "ref.step-budget", "maxsteps-1", "container did not run");
        else { int ok = r.rc == 3 && !r.outn && r.errn && strstr(r.err, "step budget exhausted (budget 1 steps)"); char d[120]; { if (cx_fmt(d, sizeof d, "rc=%d stdout=%zu", r.rc, r.outn)) { fprintf(stderr, "stream-io-cases-gen: text too long for d\n"); exit(2); } } check(ok, "ref.step-budget", "maxsteps-1.exit-3-declared-text", ok ? "rc 3, declared text, empty stdout" : d); np_free(&r); } }
    chmod(unreadable, 0600);
    fprintf(res, "SUMMARY\tpass=%d\tfail=%d\tnot_run=%d\n", npass, nfail, nnotrun); fclose(res);
    printf("STREAM_IO_CASES\tstream=%s\tpass=%d\tfail=%d\tnot_run=%d\n", pfx, npass, nfail, nnotrun);
    return nfail || nnotrun ? 1 : 0;
}
