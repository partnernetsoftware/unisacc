/* tools/check-precommit-flow.cx -- tools/precommit-flow.cx judges exactly like tools/precommit.cx.
 *
 *   sh ./unisacc.com tools/check-precommit-flow.cx          (repo root; four scenarios in parallel)
 *   sh ./unisacc.com tools/check-precommit-flow.cx -- one S TAG   (one scenario, used by the parent)
 *
 * Each scenario builds its own fixture /tmp/pcfck-TAG-S: git archive HEAD, the working copies of
 * tools/precommit.cx and tools/precommit-flow.cx, a ./unisacc.com symlink to the repo's, git init + one
 * commit; then appends one line to tools/flowrun.cx and stages it:
 *   pass   a comment                         expect blocked=0 rc 0
 *   trunc  a discarded memcpy (cxtrunc)      expect blocked=1 rc 1
 *   r2     sy_spawn with no bound (R2 lint)  expect blocked=1 rc 1
 *   r1     a "0.0.99" literal (R1, report)   expect blocked=0 rc 0 and a lint(report-only) line
 * and runs precommit.cx (no argument) and precommit-flow.cx: the PRECOMMIT line and rc must be equal,
 * match the expectation, and every "precommit:" line of the original must appear in the flow output.
 * Every command is bounded at 55 s.  The fixture path is fixed (/tmp/pcfck-fx-S) and rebuilt at the start
 * of each run, not removed: the compile cache is keyed by path, so a fresh path costs a cold compile of
 * every ratchet (about 60 s); two concurrent runs of this check would share it.
 * Last line CHECK_PRECOMMIT_FLOW<TAB>failed=N; rc 1 when N > 0. */
#pragma unisa use sys.time
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sysx.process
#pragma unisa use mem.bytes
#pragma unisa use mem.heap

static int nfail, ovf;
#define F(dst, cap, ...) do { int f_ = snprintf(dst, cap, __VA_ARGS__); if (f_ < 0 || f_ >= (int)(cap)) ovf++; } while (0)
static char root[1024], fx[200], out[1 << 15];

static int run(char **v, const char *cwd) {
    np_result r; char why[200]; int rc; long a, b;
    memset(out, 0, sizeof out);
    if (np_run(v, cwd, 0, 55, &r, why, sizeof why)) return -1;
    a = (long)r.outn; b = (long)r.errn; rc = r.rc;
    if (a + b > (long)sizeof out - 1 || (a > 0 && mm_copy(out, sizeof out, r.out, a)) || (b > 0 && mm_copy(out + a, sizeof out - a, r.err, b))) rc = -1;
    np_free(&r);
    return rc;
}
static int sh(const char *cmd, const char *cwd) { char *v[] = {"sh", "-c", (char *)cmd, 0}; return run(v, cwd); }
static void ck(int c, const char *s, const char *name) {
    printf("%s\tprecommit-flow.%s.%s\n", c ? "PASS" : "FAIL", s, name);
    if (!c) { printf("NOTE\tlast-output\t%.700s\n", out); nfail++; }
}
static void pcline(const char *o, char *dst, int cap) {   /* the PRECOMMIT line, or "" */
    const char *p = 0; int n = 0; long i;
    for (i = 0; o[i] && !p; i++) if ((i == 0 || o[i - 1] == '\n') && !strncmp(o + i, "PRECOMMIT\t", 10)) p = o + i;
    while (p && p[n] && p[n] != '\n' && n < cap - 1) { dst[n] = p[n]; n++; }
    dst[n] = 0;
}

static int one(const char *s, const char *tag) {
    static char o1[1 << 15]; char c[3000], l1[200], l2[200]; const char *add; int r1, r2, missing = 0, exp_b, exp_rc;
    if (!strcmp(s, "pass")) { add = "/* zz */"; exp_b = 0; }
    else if (!strcmp(s, "trunc")) { add = "static void zz(char *d, const char *s, int n) { memcpy(d, s, n); }"; exp_b = 1; }
    else if (!strcmp(s, "r2")) { add = "static void zz2(char **v) { sy_spawn(v); }"; exp_b = 1; }
    else if (!strcmp(s, "r1")) { add = "static const char *zz3 = \"0.0.99\";"; exp_b = 0; }
    else { printf("FAIL\tprecommit-flow.%s.unknown-scenario\n", s); return 1; }
    exp_rc = exp_b ? 1 : 0;
    (void)tag;   /* fixed path: the product's compile cache is keyed by path, a fresh path recompiles every ratchet */
    F(fx, sizeof fx, "/tmp/pcfck-fx-%s", s);
    F(c, sizeof c, "unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE; rm -rf %s && mkdir -p %s && git -C %s archive HEAD | tar -x -C %s"
                   " && cp %s/tools/precommit.cx %s/tools/precommit-flow.cx %s/tools/ && cd %s && ln -s %s/unisacc.com unisacc.com"
                   " && git init -q && git add -A && git -c user.name=pcf -c user.email=pcf@example.invalid commit -qm base"
                   " && printf '%%s\\n' '%s' >> tools/flowrun.cx && git add tools/flowrun.cx",
      fx, fx, root, fx, root, root, fx, fx, root, add);
    if (ovf || sh(c, 0) != 0) { ck(0, s, "fixture"); return 1; }
    r1 = sh("unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE; exec sh ./unisacc.com tools/precommit.cx", fx);
    memcpy(o1, out, sizeof o1); pcline(o1, l1, sizeof l1);
    r2 = sh("unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE; exec sh ./unisacc.com tools/precommit-flow.cx", fx);
    pcline(out, l2, sizeof l2);
    {   char want[100]; F(want, sizeof want, "PRECOMMIT\tstaged_cx=1\tblocked=%d", exp_b);
        ck(r1 == exp_rc && !strcmp(l1, want), s, "original-expected");
        ck(r2 == r1 && !strcmp(l1, l2) && l2[0], s, "flow-same-line-and-rc"); }
    {   char *p = o1;   /* every precommit: line of the original appears in the flow output */
        while ((p = strstr(p, "precommit: "))) {
            char ln[1200]; int n = 0;
            while (p[n] && p[n] != '\n' && n < (int)sizeof ln - 1) { ln[n] = p[n]; n++; }
            ln[n] = 0; if (!strstr(out, ln)) missing++;
            p += n;
        }
        ck(missing == 0, s, "flow-same-messages"); }
    if (!strcmp(s, "r1")) ck(strstr(o1, "lint(report-only):") != 0, s, "report-only-printed");
    return nfail ? 1 : 0;
}

int main(int argc, char **argv) {
    char c[2000], tag[40], p[300]; const char *sc[4] = {"pass", "trunc", "r2", "r1"}; int i; long t0 = sy_now_ms();
    if (argc == 4 && !strcmp(argv[1], "one")) { if (sy_cwd(root, sizeof root) < 0) return 2; return one(argv[2], argv[3]); }
    if (sy_cwd(root, sizeof root) < 0) return 2;
    F(tag, sizeof tag, "%d", sy_pid());
    F(c, sizeof c, "for s in pass trunc r2 r1; do sh ./unisacc.com tools/check-precommit-flow.cx -- one $s %s > /tmp/pcfck-%s-$s.log 2>&1 & done; wait", tag, tag);
    if (ovf) return 2;
    (void)sh(c, root);
    for (i = 0; i < 4; i++) {
        unsigned char *b = 0; int64_t n = 0; int any = 0; char *q;
        F(p, sizeof p, "/tmp/pcfck-%s-%s.log", tag, sc[i]);
        if (ovf || sy_read_file(p, &b, &n, 1 << 20) || !b) { printf("FAIL\tprecommit-flow.%s.no-log\n", sc[i]); nfail++; continue; }
        {   static char lg[1 << 20]; if (n >= (int64_t)sizeof lg) n = sizeof lg - 1;
            if (mm_copy(lg, sizeof lg, b, (size_t)n)) n = 0; lg[n] = 0; fwrite(lg, 1, (size_t)n, stdout);
            for (q = lg; (q = strstr(q, "FAIL\t")); q += 5) nfail++;
            for (q = lg; (q = strstr(q, "PASS\t")); q += 5) any++; }
        if (!any) { printf("FAIL\tprecommit-flow.%s.no-pass-line\n", sc[i]); nfail++; }
        free(b); sy_unlink(p);
    }
    printf("CHECK_PRECOMMIT_FLOW\tfailed=%d\twall_ms=%ld\n", nfail, sy_now_ms() - t0);
    return nfail ? 1 : 0;
}
