/* Verify independent literal text/binary fixture and retained action copies. */
#pragma unisa use runtime.process
static void die(const char *s){fprintf(stderr,"model-reference: %s\n",s);exit(2);}
static np_result call(char **v,const char *root){np_result r={0};char why[512];if(np_run(v,root,0,35,&r,why,sizeof why))die(why);return r;}
static void writefile(const char *p,const void *data,size_t n){FILE *f=fopen(p,"wb");if(!f||fwrite(data,1,n,f)!=n||fclose(f))die("fixture-write");}
int main(void){
 char root[4096],bound[4400],src[4400],exe[512],textpath[512],binpath[512];char tmp[]="/tmp/cx-model-ref-XXXXXX";
 if(!realpath(".",root)||!mkdtemp(tmp))die("setup");
 if(cx_fmt(bound,sizeof bound,"%s/tools/bound",root)||cx_fmt(src,sizeof src,"%s/tests/cases/model_decode_reference.c",root)||cx_fmt(exe,sizeof exe,"%s/ref",tmp)||cx_fmt(textpath,sizeof textpath,"%s/text",tmp)||cx_fmt(binpath,sizeof binpath,"%s/binary",tmp))die("path");
 const char *text="N 1 2 0 1 0 0\nS -\nQ 1 1 7\nC 0 1 0\nH 0 0 256 0 0 0\n";
 const unsigned char bin[]={'U','N','I','N','E','T','B','1','N',2,4,0,2,0,0,'S',0,'Q',2,2,14,'C',0,2,0,'H',0,0,128,4,0,0,0};
 writefile(textpath,text,strlen(text));writefile(binpath,bin,sizeof bin);
 char *cc="/usr/bin/x86_64-linux-gnu-gcc-11",*build[]={bound,"30",cc,"-O2","-w","-ffunction-sections","-fdata-sections","-Wl,--gc-sections",src,"-o",exe,0};
 np_result r=call(build,root);if(r.rc||r.errn)die("compile");np_free(&r);
 char *a[]={bound,"10",exe,textpath,0},*b[]={bound,"10",exe,binpath,0};np_result x=call(a,root),y=call(b,root);
 const char *want="model ns=1 nq=2 nrg=0 nstr=1 start=0 net=1 top=0 nqa=4\nstr 0 0\nq 0 0 1\nq 1 2 1\nqa 1 7 1 7\nstate 0 mode=0 count=0 lo=0 hi=256 bn=0 bq=0 ret=-1\n";size_t n=strlen(want);
 int ok=!x.rc&&!y.rc&&!x.errn&&!y.errn&&x.outn==n&&y.outn==n&&!memcmp(x.out,want,n)&&!memcmp(y.out,want,n);
 if(!ok){if(x.outn)fwrite(x.out,1,x.outn,stderr);if(y.outn)fwrite(y.out,1,y.outn,stderr);if(x.errn)fwrite(x.err,1,x.errn,stderr);if(y.errn)fwrite(y.err,1,y.errn,stderr);}
 printf("%s\ttext-binary-prefix-copy\n",ok?"PASS":"FAIL");
 np_free(&x);np_free(&y);
 const char *table="T 1 1 0 0 0\nQ 1 29 5\nR 0 0 -1 0\n";
 const unsigned char tablebin[]={'U','N','I','N','E','T','B','1','T',2,2,0,0,0,'Q',2,58,10,'R',0,0,1,0};
 writefile(textpath,table,strlen(table));writefile(binpath,tablebin,sizeof tablebin);
 x=call(a,root);y=call(b,root);
 want="model ns=1 nq=1 nrg=0 nstr=0 start=0 net=0 top=5 nqa=2\nq 0 0 1\nqa 29 5\nstate 0 mode=0 count=0 ret=-1\n";n=strlen(want);
 int tableok=!x.rc&&!y.rc&&!x.errn&&!y.errn&&x.outn==n&&y.outn==n&&!memcmp(x.out,want,n)&&!memcmp(y.out,want,n);
 if(!tableok){if(x.outn)fwrite(x.out,1,x.outn,stderr);if(y.outn)fwrite(y.out,1,y.outn,stderr);if(x.errn)fwrite(x.err,1,x.errn,stderr);if(y.errn)fwrite(y.err,1,y.errn,stderr);}
 printf("%s\ttext-binary-table-push\n",tableok?"PASS":"FAIL");
 np_free(&x);np_free(&y);
 struct Bad {const char *name,*data,*error;} bad[]={
  {"uppercase-hex","N 1 1 0 1 0 0\nS 4A\nQ 0\nH 0 0 256 0 0 0\n","run: bad hex string\n"},
  {"forward-prefix","N 1 1 0 0 0 0\nC 0 1 0\n","run: bad sequence prefix\n"},
  {"missing-operand","N 1 1 0 0 0 0\nQ 1 1\n","run: missing model number\n"},
  {"trailing","N 1 1 0 0 0 0\nQ 0\nH 0 0 256 0 0 0\nX","run: trailing model data\n"}
 };
 int errors=0;
 for(int i=0;i<4;i++){writefile(textpath,bad[i].data,strlen(bad[i].data));x=call(a,root);int good=x.rc==2&&!x.outn&&x.errn==strlen(bad[i].error)&&!memcmp(x.err,bad[i].error,x.errn);printf("%s\t%s\n",good?"PASS":"FAIL",bad[i].name);if(!good){errors++;if(x.errn)fwrite(x.err,1,x.errn,stderr);}np_free(&x);}
 printf("CXMODEL_REFERENCE\tfailed=%d\n",!ok+!tableok+errors);
 if(cx_rmtree(tmp))die("cleanup");return ok&&tableok&&!errors?0:1;
}
