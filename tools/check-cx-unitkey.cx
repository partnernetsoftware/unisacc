/* tools/check-cx-unitkey.cx -- 单元前端(e2/e1)缓存键字段实测(plans/unit-frontcache.md)。
 * 对同一单元用 `unisacc stream e2|e1 --multi --unit N` 逐项变化:单元序号、前序属性表、源标签、
 * include-dir、quote-dir、defines、传递头内容(直接头/二级头),比较输出字节 sha,
 * 每项给 AFFECTS / NO_EFFECT / UNMEASURED(stream 表达不了的)。
 * 断言只落在对照项:基线两次相同(确定性)、源文本变与头内容变必须 AFFECTS;其余项如实记录。
 *   sh ./unisacc.com tools/check-cx-unitkey.cx
 * 输出 KEY<TAB>字段<TAB>stage<TAB>结论<TAB>说明 与 CHECK_CX_UNITKEY<TAB>failed=N。 */
#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use sys.sha
#pragma unisa use sys.posix
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

static int failed;
static char W[320];

static void put(const char *name, const char *body) {
    char p[400];
    cx_fmt(p, sizeof p, "%s/%s", W, name);
    if (cx_write(p, body, tx_len(body, 100000))) failed++;
}
/* 运行 stream:返回 stdout+stderr 的 sha(hex)与 rc;输出原始字节另存 *ob/*on(调用方释放) */
static int run(char hex[65], char **ob, long *on, const char *stage, const char *flags, const char *infile) {
    char cmd[1400]; char *o = 0; size_t n = 0; int rc;
    cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com stream %s --multi %s < %s/%s 2>&1", stage, flags, W, infile);
    char *v[] = {"sh", "-c", cmd, 0};
    rc = cx_runv_timeout(v, 55, &o, &n);
    if (!o) { hex[0] = 0; return rc ? rc : -1; }
    sy_sha256_hex(o, (long)n, hex);
    if (ob) { *ob = o; *on = (long)n; }
    return rc;
}
static void row(const char *field, const char *stage, const char *verdict, const char *note) {
    sy_printf("KEY\t%s\t%s\t%s\t%s\n", field, stage, verdict, note);
}
static const char *BASEFLAGS_FMT = "--unit 0 --source a.c --res include-dir=%s/dir1";

/* 比较:flags 变体对基线;infile 为输入文件名(变体输入可不同);must 为 1 表示对照项必须 AFFECTS */
static void cmp(const char *field, const char *stage, const char *base_flags, const char *base_in,
                const char *var_flags, const char *var_in, int must, const char *note) {
    char h0[65], h1[65]; int r0, r1;
    r0 = run(h0, 0, 0, stage, base_flags, base_in);
    r1 = run(h1, 0, 0, stage, var_flags, var_in);
    if (!h0[0] || !h1[0]) { row(field, stage, "UNMEASURED", "run failed"); if (must) failed++; return; }
    if (r0 != 0) { row(field, stage, "UNMEASURED", "baseline rc!=0"); if (must) failed++; return; }
    int diff = !tx_same(h0, 64, h1, 64);
    row(field, stage, diff ? "AFFECTS" : "NO_EFFECT", note);
    if (must && !diff) { failed++; sy_printf("FAIL\tcheck-cx-unitkey.%s.%s\n", field, stage); }
}

int main(void) {
    char base[1000], f[1000], h0[65], h1[65]; char *o0 = 0, *o1 = 0; long n0 = 0, n1 = 0; int i;
    if (cx_fmt(W, sizeof W, "%s/cx-unitkey-XXXXXX", sy_tmpdir()) || !mkdtemp(W)) { sy_printf("FAIL\ttmpdir\n"); return 1; }
    char d[400];
    cx_fmt(d, sizeof d, "%s/inc", W); mkdir(d, 0700);
    cx_fmt(d, sizeof d, "%s/inc2", W); mkdir(d, 0700);
    cx_fmt(d, sizeof d, "%s/inc3", W); mkdir(d, 0700);
    put("a.c", "#include \"h.h\"\n#ifdef HV\nint hv = HV;\n#endif\nconst char *f = __FILE__;\nint main(void) { return H; }\n");
    put("a2.c", "#include \"h.h\"\n#ifdef HV\nint hv = HV;\n#endif\nconst char *f = __FILE__;\nint main(void) { return H + 1; }\n");
    put("inc/h.h", "#include \"h2.h\"\n#define H H2\n");
    put("inc/h2.h", "#define H2 5\n");
    put("inc2/h.h", "#include \"h2.h\"\n#define H H2\n");      /* 与 inc 字节相同的头,不同目录 */
    put("inc2/h2.h", "#define H2 5\n");
    put("inc3/h.h", "#include \"h2.h\"\n#define H H2\n");      /* 直接头同,二级头内容不同 */
    put("inc3/h2.h", "#define H2 6\n");
    /* 目录/define 资源文件:无尾 NUL(include-dir)、NAME=VALUE 加尾 NUL(defines) */
    cx_fmt(f, sizeof f, "%s/inc", W); put("dir1", f);
    cx_fmt(f, sizeof f, "%s/inc2", W); put("dir2", f);
    cx_fmt(f, sizeof f, "%s/inc3", W); put("dir3", f);
    { char p[400]; cx_fmt(p, sizeof p, "%s/def1", W); cx_write(p, "HV=1", 5); cx_fmt(p, sizeof p, "%s/def2", W); cx_write(p, "HV=2", 5); }  /* 记录含尾 NUL */
    /* 前序属性表载体 USLATTRT + LE32(长度) + [LE32 记录数 + 9 字节记录] 接在源文本前 */
    {
        char *src; size_t sn = 0; char *c; char p[400];
        cx_fmt(p, sizeof p, "%s/a.c", W); src = cx_read(p, &sn);
        c = mm_alloc((long)sn + 64);
        mm_copy(c, 8, "USLATTRT", 8);
        c[8] = 13; c[9] = 0; c[10] = 0; c[11] = 0;
        c[12] = 1; c[13] = c[14] = c[15] = 0;
        for (i = 0; i < 9; i++) c[16 + i] = (char)(i + 1);
        mm_copy(c + 25, (long)sn, src, (long)sn);
        cx_fmt(p, sizeof p, "%s/a-attr.c", W); cx_write(p, c, (long)sn + 25);
        c[16 + 4] = 99;     /* 另一张前序表(记录内容不同) */
        cx_fmt(p, sizeof p, "%s/a-attr2.c", W); cx_write(p, c, (long)sn + 25);
    }
    cx_fmt(base, sizeof base, BASEFLAGS_FMT, W);
    /* 基线确定性 */
    run(h0, 0, 0, "e2", base, "a.c"); run(h1, 0, 0, "e2", base, "a.c");
    if (!h0[0] || !tx_same(h0, 64, h1, 64)) { failed++; sy_printf("FAIL\tcheck-cx-unitkey.baseline-deterministic\n"); }
    /* e2 项:输入是源文本 */
    {
        const char *s = "e2";
        cmp("source-text", s, base, "a.c", base, "a2.c", 1, "单元源字节");
        cx_fmt(f, sizeof f, "--unit 3 --source a.c --res include-dir=%s/dir1", W);
        cmp("unit-ordinal", s, base, "a.c", f, "a.c", 0, "--unit 0 vs 3(nunit=1;st_nunit 由驱动设,stream 不设)");
        cx_fmt(f, sizeof f, "--unit 0 --source b/other.c --res include-dir=%s/dir1", W);
        cmp("source-label", s, base, "a.c", f, "a.c", 0, "源中带 __FILE__ 时标签进入输出");
    }
    /* include-dir:--res 的值是文件,其内容是目录路径文本。dir1/dir2 指向头字节相同的两个目录 */
    {
        const char *s = "e2";
        cx_fmt(f, sizeof f, "--unit 0 --source a.c --res include-dir=%s/dir2", W);
        cmp("include-dir-path-samebytes", s, base, "a.c", f, "a.c", 0, "dir1 与 dir2 头字节相同,仅目录路径不同");
        cx_fmt(f, sizeof f, "--unit 0 --source a.c --res include-dir=%s/dir3", W);
        cmp("transitive-header-content", s, base, "a.c", f, "a.c", 1, "二级头 h2.h 内容变(直接头同)");
        cx_fmt(f, sizeof f, "--unit 0 --source a.c --res include-dir=%s/dir1 --res quote-dir=%s/dir2", W, W);
        cmp("quote-dir-added", s, base, "a.c", f, "a.c", 0, "追加 quote-dir(头字节相同)");
        cx_fmt(f, sizeof f, "--unit 0 --source a.c --res include-dir=%s/dir1 --res defines=%s/def1", W, W);
        cmp("defines-added", s, base, "a.c", f, "a.c", 1, "追加 HV=1(源按 #ifdef HV 使用)");
        {
            char f2[1000];
            cx_fmt(f2, sizeof f2, "--unit 0 --source a.c --res include-dir=%s/dir1 --res defines=%s/def2", W, W);
            cmp("defines-value", s, f, "a.c", f2, "a.c", 1, "HV=1 -> HV=2");
        }
        cmp("prior-attributes-present", s, base, "a.c", base, "a-attr.c", 0, "输入前接 USLATTRT 载体");
        cmp("prior-attributes-content", s, base, "a-attr.c", base, "a-attr2.c", 0, "载体记录内容不同(输出含回带的载体)");
        {   /* --raw 去掉回带的载体,只比 e2 载荷本身 */
            char r[1100]; cx_fmt(r, sizeof r, "%s --raw", base);
            cmp("prior-attributes-payload", s, r, "a.c", r, "a-attr.c", 0, "--raw 只比载荷:前序表是否改变 e2 载荷");
            cmp("prior-attributes-payload-content", s, r, "a-attr.c", r, "a-attr2.c", 0, "--raw 只比载荷:前序表内容");
        }
    }
    /* e1:输入是 e2 的输出。先产 e2 基线输出,再逐项对 e1 直接变化(e1 自身读取的项) */
    cx_fmt(base, sizeof base, "--unit 0 --source a.c --res include-dir=%s/dir1", W);
    {
        char p[400]; run(h0, &o0, &n0, "e2", base, "a.c");
        cx_fmt(p, sizeof p, "%s/e2out", W);
        /* o0 含 stderr(合并);基线无诊断时即 e2 输出 */
        cx_write(p, o0, n0);
        (void)o1; (void)n1;
        const char *s = "e1";
        char h2[65]; int r;
        r = run(h2, 0, 0, s, "--unit 0 --source a.c", "e2out");
        if (r != 0) { row("e1-baseline", s, "UNMEASURED", "e1 on e2 output rc!=0"); failed++; }
        else {
            cmp("unit-ordinal", s, "--unit 0 --source a.c", "e2out", "--unit 3 --source a.c", "e2out", 0, "e1 直接变序号");
            cmp("source-label", s, "--unit 0 --source a.c", "e2out", "--unit 0 --source z/q.c", "e2out", 0, "e1 直接变标签");
            cx_fmt(f, sizeof f, "--unit 0 --source a.c --res defines=%s/def1", W);
            cmp("defines-added", s, "--unit 0 --source a.c", "e2out", f, "e2out", 0, "e1 直接加 defines");
            cx_fmt(f, sizeof f, "--unit 0 --source a.c --res include-dir=%s/dir2", W);
            cmp("include-dir-path", s, "--unit 0 --source a.c", "e2out", f, "e2out", 0, "e1 直接变 include-dir");
        }
    }
    row("nunit-rt-shared", "e2", "UNMEASURED", "st_nunit 由驱动 st_units 设;stream 不暴露(多单元且自己链接时 \\0cli/defines 带 RT-SHARED 宏)");
    row("hs-file-note", "e2", "UNMEASURED", "hs_file_note 单槽是运行期副作用(runcache 占用),stream 无入口");
    row("model-sha-target-abi", "e1", "UNMEASURED", "模型/目标/ABI 由键合同固定纳入,不在 stream 变量内(目标另见 --target)");
    { char cmd[400]; cx_fmt(cmd, sizeof cmd, "rm -rf '%s'", W); char *v[] = {"sh", "-c", cmd, 0}; char *o = 0; size_t on = 0; cx_runv_timeout(v, 20, &o, &on); }
    sy_printf("CHECK_CX_UNITKEY\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
