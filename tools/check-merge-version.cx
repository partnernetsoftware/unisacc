/* tools/check-merge-version.cx -- tools/merge-version.cx on a synthetic repository (preview, rules, gates are not run).
 *
 *   sh ./unisacc.com tools/check-merge-version.cx   (from the repo root)
 *
 * The repository: base commit B with derive.cx, table.tsv, trap.cx, del.cx, plan.md, unknown.txt; branch main edits
 * derive.cx line 3, appends a row to table.tsv, edits trap.cx, deletes del.cx and edits unknown.txt line 2; branch feat
 * (from B) edits derive.cx line 3 differently, appends another row, leaves trap.cx alone, edits del.cx and edits
 * unknown.txt line 2 differently.  Rules: derive.cx take-ours, table.tsv union, trap.cx and del.cx always take-theirs.
 *   run 1 (unknown.txt conflicts, no rule): derive.cx, table.tsv resolved by rule, trap.cx and del.cx forced to feat,
 *           unknown.txt needs-human, MERGE_VERSION verdict=NEEDS_HUMAN conflicts_left=1 tree=-, rc 1
 *   run 2 (feat resets unknown.txt): READY, conflicts_left=0, tree hash; the tree holds main's derive.cx line, both table
 *           rows, trap.cx as B had it (the silent trap closed), del.cx as feat has it; the shared index is untouched
 *   mutations: without the trap row trap.cx stays main's edit (what a plain merge does silently); without the derive.cx
 *           row derive.cx is needs-human; a branch glob that does not match leaves every rule out (all needs-human);
 *           an unknown action in the rules file is refused (rc 2)
 * Prints PASS/FAIL lines and CHECK_MERGE_VERSION TAB failed=N. */
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use cxlib.ckrun
#pragma unisa use cxlib.die

static char T[600], out[1 << 16], root[600];
static int failed;
static void ck_(int ok, const char *what) { printf("%s\tcheck-merge-version.%s\n", ok ? "PASS" : "FAIL", what); if (!ok) failed++; }
#define CK(c, w) do { int ok_ = (c); ck_(ok_, w); } while (0)
static int sh(const char *script) { return ckk_sh_t("check-merge-version", script, out, sizeof out, 50); }
static void put(const char *rel, const char *body) {
    char p[1100];
    cx_fmt(p, sizeof p, "%s/%s", T, rel);
    if (cx_write(p, body, strlen(body))) { printf("FAIL\twrite %s\n", rel); exit(1); }
}
static int has(const char *w) { return strstr(out, w) != 0; }
static int run_mv(const char *branch, const char *rules, const char *work) {
    char cmd[3000];
    cx_fmt(cmd, sizeof cmd, "cd %s && sh ./unisacc.com tools/merge-version.cx -- preview --repo %s/repo --base main --branch %s --rules %s/%s --work %s/%s 2>&1", root, T, branch, T, rules, T, work);
    return sh(cmd);
}
static int git_show(const char *tree, const char *path) {
    char cmd[1500];
    cx_fmt(cmd, sizeof cmd, "git -C %s/repo show %s:%s 2>&1", T, tree, path);
    return sh(cmd);
}
static void tree_of(char tree[64]) {
    const char *p = strstr(out, "tree=");
    tree[0] = 0;
    if (!p) return;
    p += 5;
    size_t n = 0;
    while (p[n] && p[n] != '\n' && n < 63) { tree[n] = p[n]; n++; }
    tree[n] = 0;
}

int main(void) {
    cx_fmt(root, sizeof root, ".");   /* the check runs from the repo root */
    if (sy_mkdtemp(sy_tmpdir(), "check-merge-version-", T, sizeof T)) { printf("FAIL\tmkdtemp\n"); return 1; }
    char cmd[6000];
    cx_fmt(cmd, sizeof cmd,
        "set -e; cd %s && mkdir repo && cd repo && git init -q -b main . && git config user.email t@t && git config user.name t && "
        "printf 'l1\\nl2\\nl3\\nl4\\nl5\\n' > derive.cx && printf 'h\\nrow0\\n' > table.tsv && printf 't1\\nt2\\nt3\\n' > trap.cx && printf 'd1\\nd2\\nd3\\n' > del.cx && printf 'p\\n' > plan.md && printf 'u1\\nu2\\nu3\\n' > unknown.txt && "
        "git add -A && git commit -q -m base && git branch feat && "
        "printf 'l1\\nl2\\nMAIN3\\nl4\\nl5\\n' > derive.cx && printf 'h\\nrow0\\nrowM\\n' > table.tsv && printf 't1\\nMAIN-T2\\nt3\\n' > trap.cx && git rm -q del.cx && printf 'u1\\nMAIN-U\\nu3\\n' > unknown.txt && "
        "git add -A && git commit -q -m main-side && "
        "git checkout -q feat && printf 'l1\\nl2\\nFEAT3\\nl4\\nl5\\n' > derive.cx && printf 'h\\nrow0\\nrowF\\n' > table.tsv && printf 'd1\\nFEAT-D2\\nd3\\n' > del.cx && printf 'u1\\nFEAT-U\\nu3\\n' > unknown.txt && "
        "git add -A && git commit -q -m feat-side && git checkout -q -b feat2 feat~0 && printf 'u1\\nu2\\nu3\\n' > unknown.txt && git add -A && git commit -q -m feat2-reset-unknown && git branch other feat2 && git checkout -q main && echo REPO_OK", T);
    int rc = sh(cmd);
    CK(rc == 0 && has("REPO_OK"), "synthetic-repo-built");
    const char *rules_head = "# id\tbranch\tpath\twhen\taction\tevidence\n";
    char rules[2000];
    cx_fmt(rules, sizeof rules, "%sr-derive\tfeat*\tderive.cx\tconflict\ttake-ours\tfixture\nr-table\t*\ttable.tsv\tconflict\tunion\tfixture\nr-trap\tfeat*\ttrap.cx\talways\ttake-theirs\tfixture\nr-del\tfeat*\tdel.cx\talways\ttake-theirs\tfixture\n", rules_head);
    put("rules.tsv", rules);
    char before[200];
    sh("true");
    cx_fmt(cmd, sizeof cmd, "git -C %s/repo status --short | wc -l; git -C %s/repo rev-parse main feat feat2 | tr '\\n' ' '", T, T);
    sh(cmd);
    cx_fmt(before, sizeof before, "%s", out);

    /* run 1: unknown.txt conflicts with no rule */
    rc = run_mv("feat", "rules.tsv", "w1");
    CK(rc == 1 && has("MERGE_VERSION\tverdict=NEEDS_HUMAN\tconflicts_left=1\tforced=2") && has("tree=-"), "unknown-conflict-needs-human-no-tree-rc1");
    CK(has("MERGE_PATH\tunknown.txt\tneeds-human") && has("MERGE_PATH\tderive.cx\tauto-resolved\ttake-ours\trule=r-derive") && has("MERGE_PATH\ttable.tsv\tauto-resolved\tunion\trule=r-table"), "rule-rows-settle-known-classes-unknown-left");
    CK(has("MERGE_PATH\ttrap.cx\tauto-resolved\tforce-branch\trule=r-trap") && has("MERGE_PATH\tdel.cx\tauto-resolved\tforce-branch\trule=r-del"), "always-rows-force-silent-trap-paths");

    /* run 2: feat2 resets unknown.txt: ready */
    rc = run_mv("feat2", "rules.tsv", "w2");
    char tree[64];
    tree_of(tree);
    CK(rc == 0 && has("verdict=READY\tconflicts_left=0") && strlen(tree) == 40, "ready-when-nothing-left-with-a-tree-hash");
    char tpath[200], cmd2[900];
    git_show(tree, "derive.cx");
    CK(has("MAIN3") && !has("FEAT3"), "take-ours-keeps-the-base-side");
    git_show(tree, "table.tsv");
    CK(has("rowM") && has("rowF") && has("row0"), "union-keeps-both-appended-rows");
    git_show(tree, "trap.cx");
    CK(has("t2") && !has("MAIN-T2"), "silent-trap-closed-trap-file-is-the-branch-version");
    git_show(tree, "del.cx");
    CK(has("FEAT-D2"), "base-deleted-file-comes-back-as-the-branch-has-it");
    cx_fmt(tpath, sizeof tpath, "%s", "x"); (void)tpath;
    cx_fmt(cmd2, sizeof cmd2, "git -C %s/repo status --short | wc -l; git -C %s/repo rev-parse main feat feat2 | tr '\\n' ' '", T, T);
    sh(cmd2);
    CK(!strcmp(out, before), "shared-index-and-refs-untouched");

    /* mutations */
    cx_fmt(rules, sizeof rules, "%sr-derive\tfeat*\tderive.cx\tconflict\ttake-ours\tfixture\nr-table\t*\ttable.tsv\tconflict\tunion\tfixture\nr-del\tfeat*\tdel.cx\talways\ttake-theirs\tfixture\n", rules_head);
    put("rules-no-trap.tsv", rules);
    rc = run_mv("feat2", "rules-no-trap.tsv", "w3");
    tree_of(tree);
    git_show(tree, "trap.cx");
    CK(has("MAIN-T2"), "mutation-no-trap-row-silently-keeps-the-other-side");
    cx_fmt(rules, sizeof rules, "%sr-table\t*\ttable.tsv\tconflict\tunion\tfixture\nr-trap\tfeat*\ttrap.cx\talways\ttake-theirs\tfixture\nr-del\tfeat*\tdel.cx\talways\ttake-theirs\tfixture\n", rules_head);
    put("rules-no-derive.tsv", rules);
    rc = run_mv("feat2", "rules-no-derive.tsv", "w4");
    CK(rc == 1 && has("MERGE_PATH\tderive.cx\tneeds-human") && has("verdict=NEEDS_HUMAN"), "mutation-no-derive-row-needs-human");
    rc = run_mv("other", "rules.tsv", "w5");
    CK(rc == 1 && has("MERGE_PATH\tderive.cx\tneeds-human") && !has("force-branch"), "mutation-branch-glob-excludes-rules");
    cx_fmt(rules, sizeof rules, "%sr-bad\t*\tx\tconflict\tsmash\tfixture\n", rules_head);
    put("rules-bad.tsv", rules);
    rc = run_mv("feat2", "rules-bad.tsv", "w6");
    CK(rc == 2 && has("unknown rule action"), "unknown-rule-action-refused-rc2");
    printf("CHECK_MERGE_VERSION\tfailed=%d\n", failed);
    sy_remove_all(T);
    return failed ? 1 : 0;
}
