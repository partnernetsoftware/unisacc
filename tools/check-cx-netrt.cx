#pragma unisa use compiler.netname
#pragma unisa use runtime.netname
#pragma unisa use sys.io
#pragma unisa use text.text
/* Generated by tools/netrt-gen.cx. Narrow check of runtime net names. */
int main(void) {
    const char *name;
    const char *other;
    const char **missing;
    int i;
    missing = 0;
    if (rnn_count() != 18) return 1;
    if (rnn_at(0, &name) || !tx_eqz(name, "pp")) return 1;
    if (rnn_at(1, &name) || !tx_eqz(name, "lex")) return 1;
    if (rnn_at(2, &name) || !tx_eqz(name, "parse")) return 1;
    if (rnn_at(3, &name) || !tx_eqz(name, "type")) return 1;
    if (rnn_at(4, &name) || !tx_eqz(name, "scope")) return 1;
    if (rnn_at(5, &name) || !tx_eqz(name, "irsel")) return 1;
    if (rnn_at(6, &name) || !tx_eqz(name, "enc")) return 1;
    if (rnn_at(7, &name) || !tx_eqz(name, "reloc")) return 1;
    if (rnn_at(8, &name) || !tx_eqz(name, "regmap")) return 1;
    if (rnn_at(9, &name) || !tx_eqz(name, "tyinfo")) return 1;
    if (rnn_at(10, &name) || !tx_eqz(name, "pfconv")) return 1;
    if (rnn_at(11, &name) || !tx_eqz(name, "peep")) return 1;
    if (rnn_at(12, &name) || !tx_eqz(name, "opinfo")) return 1;
    if (rnn_at(13, &name) || !tx_eqz(name, "prec")) return 1;
    if (rnn_at(14, &name) || !tx_eqz(name, "binsel")) return 1;
    if (rnn_at(15, &name) || !tx_eqz(name, "isel")) return 1;
    if (rnn_at(16, &name) || !tx_eqz(name, "abi")) return 1;
    if (rnn_at(17, &name) || !tx_eqz(name, "combo")) return 1;
    if (rnn_at(0, missing) != 4) return 1;
    if (rnn_at(-1, &name) != 2) return 1;
    if (rnn_at(18, &name) != 2) return 1;
    if (nn_count() != 18) return 1;
    if (nn_at(0, missing) != 4) return 1;
    if (nn_at(-1, &name) != 2) return 1;
    if (nn_at(18, &name) != 2) return 1;
    for (i = 0; i < rnn_count(); i++) {
        if (rnn_at(i, &name)) return 1;
        if (nn_at(i, &other)) return 1;
        if (!tx_eqz(name, other)) return 1;
    }
    sy_printf("CX_NETRT\tok=18\tfailed=0\n");
    return 0;
}
