/* 只读切片盘点。规则是机械候选，不是语义等价或内存安全证明。 */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.time
#pragma unisa use sys.sha
#pragma unisa use mem.bytes
#pragma unisa use sysx.process
#pragma unisa use text.text
#pragma unisa use cxlib.cxroot

#define SI_MAX 1024
#define SI_HASH 4096
#define SI_LIMIT 16777216
static long started;
static char root[4400],temp[4400],bound[4400],boundcache[4500],where[4400]="arguments";
static int nt;
typedef struct {char *key,*src,*claimed,*sha,*module,*facts;long bytes,lines;int dispatch,loops,io,env,external,executor,publics,sigbad,unknown,globals,assembly,tag,direct,users,iolen,execlen;char *ionames,*execnames;char reason[2048];} Unit;
static Unit units[SI_MAX];static int nu,nroots,nmodules;
static char *paths[SI_MAX];static int npaths,pathslots[SI_HASH];
static unsigned char edges[SI_MAX][SI_MAX],reach[SI_MAX][SI_MAX];
static void fail(const char *s){fprintf(stderr,"slice-inventory: REFUSE: %s: %s\n",where,s);exit(2);}
static void tick(void){if(sy_now_ms()-started>=45000)fail("45 second deadline");}
static void *grow(void *p,size_t n){void *q=realloc(p,n?n:1);if(!q)fail("allocation");return q;}
static char *part(const char *s,size_t n){char *p=grow(0,n+1);if(mm_copy(p,n+1,s,n))fail("copy bound");p[n]=0;return p;}
static char *si_dup(const char *s){return part(s,strlen(s));}
static void fit(char *d,size_t c,const char *s){if(strlen(s)>=c||mm_copy(d,c,s,strlen(s)+1))fail("copy bound");}
static void path(char *d,const char *a,const char *b){if(cx_fmt(d,4400,"%s/%s",a,b))fail("path bound");}
/* 保留bound原有缓存身份，不能因私有TMPDIR而让每个plan冷编译helper。 */
static void configure_bound(const char *tools){path(bound,tools,"tools/bound");const char *cache=getenv("BOUND_CACHE"),*base=getenv("TMPDIR");if(cache&&*cache){if(cx_fmt(boundcache,sizeof boundcache,"BOUND_CACHE=%s",cache))fail("bound cache environment bound");}else if(cx_fmt(boundcache,sizeof boundcache,"BOUND_CACHE=%s/unisacc-bound-%ld",base&&*base?base:"/tmp",(long)getuid()))fail("bound cache environment bound");}
static char *load(const char *p,size_t *n,long cap,int text){fit(where,sizeof where,p);tick();struct stat st;if(stat(p,&st)){if(errno==ENOENT)fail("missing");fail("stat error");}if(!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>cap)fail("file kind/extent bound");char *s=cx_read(p,n);if(!s||*n!=(size_t)st.st_size)fail("read extent");if(text&&(memchr(s,0,*n)||memchr(s,'\r',*n)))fail("NUL/CR in text");return s;}
static int hexok(const char *s){if(strlen(s)!=64)return 0;for(int i=0;i<64;i++)if(!strchr("0123456789abcdef",s[i]))return 0;return 1;}
static long number(const char *s){long n=0;if(!*s)fail("empty number");for(;*s;s++){if(*s<'0'||*s>'9'||n>1000000000)fail("number bound");n=n*10+*s-'0';}return n;}
static long hashfile(const char *p,const char *expected){size_t n;char *s=load(p,&n,536870912,0),h[65];if(!hexok(expected))fail("SHA schema");if(sy_sha256_hex(s,(long)n,h))cx_sha256_hex(s,n,h);free(s);if(strcmp(h,expected))fail("SHA mismatch");return (long)n;}
static int fields(char *s,char **v,int c){int n=1;v[0]=s;for(;*s;s++)if(*s=='\t'){if(n==c)fail("TSV columns");*s=0;v[n++]=s+1;}return n;}
static char *row(char **p){char *s=*p;if(!*s)return 0;char *z=strchr(s,'\n');if(!z)fail("missing final LF");*z=0;*p=z+1;return s;}
static char *field(char **v,int n,const char *k){size_t l=strlen(k);char *found=0;for(int i=1;i<n;i++)if(!strncmp(v[i],k,l)&&v[i][l]=='='){if(found)fail("duplicate receipt field");found=v[i]+l+1;}return found;}
static unsigned hash(const char *s){unsigned h=2166136261u;for(;*s;s++)h=(h^(unsigned char)*s)*16777619u;return h;}
static int pathid(const char *s,int add){unsigned i=hash(s)&(SI_HASH-1);while(pathslots[i]){int j=pathslots[i]-1;if(!strcmp(paths[j],s))return j;i=(i+1)&(SI_HASH-1);}if(!add)return -1;if(npaths==SI_MAX)fail("source graph bound 1024");paths[npaths]=si_dup(s);pathslots[i]=npaths+1;return npaths++;}
static char *canonical(const char *s){char p[4400],r[4400];if(*s=='/')fit(p,sizeof p,s);else path(p,root,s);fit(where,sizeof where,p);if(!realpath(p,r))fail(errno==ENOENT?"missing source":"source realpath error");size_t n=strlen(root);if(strncmp(r,root,n)||r[n]!='/')fail("source outside snapshot");if(strpbrk(r,"\t\n\r\\"))fail("unsafe source path");return si_dup(r);}
static char *capture(char **argv,const char *cwd,char **env){
 tick();long left=45000-(sy_now_ms()-started);int secs=(int)(left/1000);
 if(secs<=3)fail("remaining deadline below child plus cleanup budget");
 char budget[32];if(cx_fmt(budget,sizeof budget,"%d",secs-3))fail("bound budget format");
 char *wrapped[128];int n=0;wrapped[n++]=bound;wrapped[n++]=budget;
 for(int i=0;argv[i];i++){if(n>=127)fail("child argv bound");wrapped[n++]=argv[i];}wrapped[n]=0;
 char *childenv[16];n=0;if(env)for(int i=0;env[i];i++){if(n>=14)fail("child environment bound");childenv[n++]=env[i];}childenv[n++]=boundcache;childenv[n]=0;
 np_result r;char why[1400];int e=np_run(wrapped,cwd,childenv,secs,&r,why,sizeof why);
 if(e||r.rc||r.residue){fprintf(stderr,"slice-inventory: child %s: %s\n",argv[0],e?why:r.err?r.err:"");np_free(&r);fail("child failed");}
 if(r.outn>SI_LIMIT){np_free(&r);fail("child output bound");}
 char *s=part(r.out?r.out:"",r.outn);if(memchr(s,0,r.outn)||memchr(s,'\r',r.outn)){np_free(&r);fail("child text schema");}
 np_free(&r);tick();return s;
}
static void cleanup(void){if(!nt)return;char p[4400];DIR *d=opendir(temp);if(!d)return;struct dirent *e;while((e=readdir(d)))if(strcmp(e->d_name,".")&&strcmp(e->d_name,"..")){path(p,temp,e->d_name);unlink(p);}closedir(d);rmdir(temp);}
/* 有界词法器：注释跳过，字面量为单个token；根赋值按token而不是行读取。 */
typedef struct {char *s;size_t n,p;int kind;char t[4400];} Lex;
static int ident(int c){return (c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='_';}
static int token(Lex *l){size_t a;for(;;){while(l->p<l->n&&strchr(" \t\n\r",l->s[l->p]))l->p++;if(l->p+1<l->n&&l->s[l->p]=='/'&&l->s[l->p+1]=='/'){while(l->p<l->n&&l->s[l->p]!='\n')l->p++;continue;}if(l->p+1<l->n&&l->s[l->p]=='/'&&l->s[l->p+1]=='*'){l->p+=2;while(l->p+1<l->n&&(l->s[l->p]!='*'||l->s[l->p+1]!='/'))l->p++;if(l->p+1==l->n)fail("unclosed comment");l->p+=2;continue;}break;}if(l->p==l->n)return 0;a=l->p++;int c=l->s[a];l->kind=0;if(c=='"'||c=='\''){l->kind=c;size_t b=l->p;while(l->p<l->n&&l->s[l->p]!=c){if(l->s[l->p]=='\\'){l->p++;if(l->p==l->n)fail("literal escape");}l->p++;}if(l->p==l->n)fail("unclosed literal");size_t n=l->p-b;if(n>=sizeof l->t)fail("token bound");if(mm_copy(l->t,sizeof l->t,l->s+b,n))fail("token copy");l->t[n]=0;l->p++;return 1;}if(ident(c))while(l->p<l->n&&ident(l->s[l->p]))l->p++;size_t n=l->p-a;if(n>=sizeof l->t)fail("token bound");if(mm_copy(l->t,sizeof l->t,l->s+a,n))fail("token copy");l->t[n]=0;return 1;}
static void expect(Lex *l,const char *s){if(!token(l)||strcmp(l->t,s))fail("root assignment syntax");}
static void roots(char **keys,char **srcs){char p[4400];path(p,root,"tools/entry-build.cx");size_t n;char *s=load(p,&n,SI_LIMIT,1);Lex l={s,n,0,0,{0}};int count=-1;while(token(&l)){if(!l.kind&&!strcmp(l.t,"EB_OBJ")){Lex q=l;if(token(&q)&&q.t[0]>='0'&&q.t[0]<='9'){int v=(int)number(q.t);if(count>=0&&count!=v)fail("EB_OBJ conflict");count=v;}}int type=!l.kind&&!strcmp(l.t,"keys")?1:!l.kind&&!strcmp(l.t,"src_rel")?2:0;if(!type)continue;Lex q=l;if(!token(&q)||strcmp(q.t,"["))continue;if(!token(&q)||q.t[0]<'0'||q.t[0]>'9')continue;int i=(int)number(q.t);if(i>=SI_MAX)fail("root index bound");expect(&q,"]");if(!token(&q)||strcmp(q.t,"="))continue;if(!token(&q)||q.kind!='"'||strchr(q.t,'\\'))fail("root literal");char **v=type==1?keys:srcs;if(v[i]&&strcmp(v[i],q.t))fail("conflicting root assignment");v[i]=si_dup(q.t);l=q;}free(s);if(count<1||count>SI_MAX)fail("EB_OBJ missing/bound");nroots=count;for(int i=0;i<count;i++){if(!keys[i]||!srcs[i])fail("incomplete root table");srcs[i]=canonical(srcs[i]);if(pathid(srcs[i],1)!=i)fail("duplicate root realpath");}}
static int unitkey(const char *key){for(int i=0;i<nu;i++)if(!strcmp(units[i].key,key))return i;return -1;}
static void mapping(char **keys,char **srcs,const char *ctor,const char *p3,int sh){char envtext[8800],tmpenv[4500];if(cx_fmt(tmpenv,sizeof tmpenv,"TMPDIR=%s",temp))fail("temporary environment bound");if(cx_fmt(envtext,sizeof envtext,"UNISA_CONTAINER=%s",p3))fail("environment bound");char *env[]={envtext,tmpenv,0};for(int i=0;i<nroots;i++){char *v[6];int k=0;if(sh)v[k++]="sh";v[k++]=(char *)ctor;v[k++]="-cx-plan";v[k++]=srcs[i];v[k]=0;char *out=capture(v,root,env);if(strlen(out)>1048576)fail("plan bound 1MiB");char *at=out,*s;long seq=0;while((s=row(&at))){char *f[64];int n=fields(s,f,64);if(n<2||number(f[0])!=seq++)fail("plan sequence/schema");char *r=canonical(f[1]);pathid(r,1);free(r);}if(!seq)fail("empty plan");free(out);}nmodules=npaths-nroots;for(int j=0;j<npaths;j++){char key[64];const char *k;if(j<nroots)k=keys[j];else{if(cx_fmt(key,sizeof key,"m%d.o",j-nroots))fail("module key bound");k=key;}int i=unitkey(k);if(i<0)fail("receipt missing planned object");units[i].src=paths[j];if(units[i].claimed&&strcmp(units[i].claimed,"-")){char *r=canonical(units[i].claimed);if(strcmp(r,paths[j]))fail("receipt source disagrees with same-constructor plan");free(r);}}for(int i=0;i<nu;i++)if(!units[i].src)fail("object has no authoritative mapping");}
static void appendname(char **p,int *len,const char *s){size_t a=(size_t)*len,b=strlen(s);if(a+b+1>65534)fail("evidence name bound");if(!*p)*p=grow(0,65536);if(a)(*p)[a++]=',';if(mm_copy(*p+a,65536-a,s,b+1))fail("name copy");*len=(int)(a+b);}
static int member(const char *name,const char *list){size_t n=strlen(name);const char *s=list;while(*s){const char *e=strchr(s,',');size_t k=e?(size_t)(e-s):strlen(s);if(k==n&&!memcmp(s,name,n))return 1;if(!e)break;s=e+1;}return 0;}
/* PURE只认证函数体外没有分号声明的严格子集：包括未初始化对象也会阻止证明。 */
static int signature_ok(const char *ret,const char *tail){
 if(!member(ret,"int,unsigned int,long,unsigned long,short,unsigned short,size_t,ssize_t,char,unsigned char,signed char"))return 0;
 size_t n=strlen(tail);char *s=si_dup(tail);Lex l={s,n,0,0,{0}};int stars=0,byte=0,scalar=0,have=0,buffer=0,length=0,ok=1,names=0,opened=0;
 while(token(&l)){if(l.kind){ok=0;break;}if(!strcmp(l.t,"(")){if(opened++){ok=0;break;}continue;}if(!strcmp(l.t,",")||!strcmp(l.t,")")){if(!have||stars>1||(stars&&!byte)||(!stars&&!scalar)||names>1){ok=0;break;}buffer+=stars;length+=!stars;stars=byte=scalar=have=names=0;continue;}if(!strcmp(l.t,"*")){stars++;continue;}if(!strcmp(l.t,"char")){byte=1;scalar=1;have=1;}else if(member(l.t,"int,long,short,size_t,ssize_t")){scalar=1;have=1;}else if(member(l.t,"const,unsigned,signed"))continue;else if(!ident(l.t[0])||!strcmp(l.t,"struct")||!strcmp(l.t,"void")||!strcmp(l.t,"volatile")||!strcmp(l.t,"float")||!strcmp(l.t,"double")||!strcmp(l.t,"restrict")){ok=0;break;}else names++;}
 free(s);return ok&&buffer>0&&length>0;
}
static int io_name(const char *n){return !strncmp(n,"sy_",3)||!strncmp(n,"__syscall",9)||member(n,"syscall,cx_read,cx_write,cx_run,open,read,write,close,fopen,fread,fwrite,fprintf,printf,puts,putchar,fputs,system,exec,execve,execv,exit,_exit,unlink,rename,mkdir,rmdir,stat,lstat,realpath,popen,pclose");}
static int exec_name(const char *n){return strstr(n,"inflate")||strstr(n,"decompress")||strstr(n,"decode")||strstr(n,"execute")||strstr(n,"inference")||strstr(n,"forward")||strstr(n,"sha256")||strstr(n,"crc32")||strstr(n,"checksum");}
static char *unescape(char *s){char *a=s,*b=s;while(*a){if(*a=='\\'){a++;if(*a=='t')*b++='\t';else if(*a=='n')*b++='\n';else if(*a=='\\')*b++='\\';else fail("fact escape");if(!*a)fail("fact escape end");a++;}else *b++=*a++;}*b=0;return s;}
static void source_features(Unit *u){size_t n;char *s=load(u->src,&n,SI_LIMIT,1);for(size_t i=0;i<n;i++)if(s[i]=='\n')u->lines++;if(n&&s[n-1]!='\n')u->lines++;Lex l={s,n,0,0,{0}};int depth=0;char previous[4400]="";while(token(&l)){if(l.kind){fit(previous,sizeof previous,"literal");continue;}if(!strcmp(l.t,"#")){size_t end=l.p;while(end<n&&s[end]!='\n')end++;if(strncmp(s+l.p,"pragma unisa ",13)&&strncmp(s+l.p,"pragma unisa",12))u->assembly++;l.p=end;continue;}if(!strcmp(l.t,"(")&&(!ident(previous[0])||!strcmp(previous,"literal")))u->assembly++;if(!strcmp(l.t,"if")||!strcmp(l.t,"case")||!strcmp(l.t,"switch"))u->dispatch++;if(!strcmp(l.t,"for")||!strcmp(l.t,"while")||!strcmp(l.t,"do"))u->loops++;if(!strcmp(l.t,"static")||!strcmp(l.t,"asm")||!strcmp(l.t,"__asm__")||!strcmp(l.t,"__asm"))u->assembly++;if(!strcmp(l.t,"{"))depth++;else if(!strcmp(l.t,"}"))depth--;else if(!depth&&(!strcmp(l.t,"=")||!strcmp(l.t,";")))u->globals++;fit(previous,sizeof previous,l.t);}free(s);}
static char *defs[32768];static int ndefs;
static int hasdef(const char *unused,const char *name){(void)unused;unsigned k=hash(name)&32767;while(defs[k]){if(!strcmp(defs[k],name))return 1;k=(k+1)&32767;}return 0;}
static void definition(const char *name){unsigned k=hash(name)&32767;while(defs[k]){if(!strcmp(defs[k],name))return;k=(k+1)&32767;}if(++ndefs>16000)fail("definition index bound");defs[k]=si_dup(name);}
static void facts(Unit *u){for(int z=0;z<32768;z++){free(defs[z]);defs[z]=0;}ndefs=0;char *scan=si_dup(u->facts),*a=scan,*r;while((r=row(&a))){char *v[12];int n=fields(r,v,12);if(n==8&&!strcmp(v[0],"D"))definition(v[1]);}free(scan);char *copy=si_dup(u->facts),*at=copy,*s;while((s=row(&at))){char *f[12];int n=fields(s,f,12);for(int k=0;k<n;k++)unescape(f[k]);if(!strcmp(f[0],"M")&&n==2)u->module=si_dup(f[1]);else if(!strcmp(f[0],"D")&&n==8){if(!strcmp(f[4],"0")){u->publics++;if(strcmp(f[5],"0")||!signature_ok(f[6],f[7]))u->sigbad++;}if(exec_name(f[1])){u->executor++;appendname(&u->execnames,&u->execlen,f[1]);}}else if(!strcmp(f[0],"C")&&n==5){if(io_name(f[1])){u->io++;appendname(&u->ionames,&u->iolen,f[1]);}if(member(f[1],"getenv,setenv,unsetenv,putenv,secure_getenv"))u->env++;if(!hasdef(u->facts,f[1])&&!member(f[1],"memcpy,memmove,memset,memcmp,strlen,strcmp,strncmp,strchr,strrchr,memchr,sizeof,offsetof,va_start,va_end,va_arg,__builtin_va_start,__builtin_va_end"))u->external++;}else if(!strcmp(f[0],"U")&&n==2){size_t n0=strlen(f[1]);if(!strcmp(f[1],"std")||!strcmp(f[1],"std.cx")||!strncmp(f[1],"std.",4))continue;if(n0>=299){u->unknown++;continue;}char p[4400];if(cxr_path(u->src,f[1],(long)n0,p,sizeof p))fail("use resolver failed");struct stat st;if(stat(p,&st)){if(errno!=ENOENT)fail("use stat error");u->unknown++;continue;}char *r=canonical(p);int id=pathid(r,0),target=-1;for(int i=0;i<nu;i++)if(id>=0&&!strcmp(units[i].src,paths[id]))target=i;if(target<0)u->unknown++;else edges[u-units][target]=1;free(r);}}free(copy);}
static void index_all(const char *tools){char list[4400],script[4400],com[4400];path(list,temp,"sources.list");FILE *f=fopen(list,"wb");if(!f)fail("create private list");for(int i=0;i<nu;i++)if(fprintf(f,"%s\n",units[i].src)<0)fail("write list");if(fclose(f))fail("close list");path(script,tools,"tools/symindex.cx");path(com,tools,"unisacc.com");char *v[]={"sh",com,script,"--","--index",temp,"--in",list,"update","--verify",0};char tmpenv[4500];if(cx_fmt(tmpenv,sizeof tmpenv,"TMPDIR=%s",temp))fail("index temporary environment bound");char *env[]={tmpenv,0};char *o=capture(v,tools,env);if(strstr(o,"DEFERRED"))fail("symbol facts incomplete");free(o);char p[4400];path(p,temp,"manifest.tsv");size_t n;char *s=load(p,&n,SI_LIMIT,1),*at=s,*r;int found=0;while((r=row(&at))){if(*r=='#'||!*r)continue;char *a[8];if(fields(r,a,8)!=6||!hexok(a[5]))fail("manifest schema");unescape(a[0]);char *real=canonical(a[0]);int i;for(i=0;i<nu;i++)if(!strcmp(real,units[i].src))break;free(real);if(i==nu)fail("unexpected indexed source");if(units[i].facts)fail("duplicate manifest source");char leaf[80];if(cx_fmt(leaf,sizeof leaf,"%s.tsv",a[5]))fail("shard name");path(p,temp,leaf);units[i].facts=load(p,&n,SI_LIMIT,1);found++;}free(s);if(found!=nu)fail("missing symbol facts");for(int i=0;i<nu;i++){tick();source_features(&units[i]);facts(&units[i]);}}
static const char *tag(int t){return t==0?"PURE-BYTESTREAM":t==1?"TABLE-DRIVEN":t==2?"MIXED":t==3?"SYSCALL-IO":"EXECUTOR";}
static void classify(void){for(int i=0;i<nu;i++)for(int j=0;j<nu;j++)reach[i][j]=edges[i][j];for(int k=0;k<nu;k++){tick();for(int i=0;i<nu;i++)if(reach[i][k])for(int j=0;j<nu;j++)if(reach[k][j])reach[i][j]=1;}for(int i=0;i<nu;i++){Unit *u=&units[i];int effect=u->env,unknown=u->unknown,closureio=u->io;for(int j=0;j<nu;j++){if(i!=j){u->direct+=edges[j][i];u->users+=reach[j][i];}if(reach[i][j]){effect+=units[j].env;unknown+=units[j].unknown;closureio+=units[j].io;}}u->tag=u->executor?4:u->io?3:effect||unknown?2:u->dispatch>=4&&u->dispatch>=u->loops+u->external?1:!closureio&&!u->external&&!u->assembly&&!u->globals&&u->publics&&!u->sigbad?0:2;if(cx_fmt(u->reason,sizeof u->reason,"definitions_executor=%d;io_calls=%d;environment_calls=%d;closure_environment=%d;dispatch=%d;loops=%d;nonlocal_calls=%d;unresolved_use=%d;closure_io=%d;public_definitions=%d;purity_lexical_barriers=%d;top_level_declarations_or_initializers=%d;signature_failures=%d;PURE_requires_zero_nonlocal_calls_asm_file_declarations_and_closure_effects",u->executor,u->io,u->env,effect,u->dispatch,u->loops,u->external,unknown,closureio,u->publics,u->assembly,u->globals,u->sigbad))fail("reason bound");}}
static int order(const void *a,const void *b){Unit *x=*(Unit *const *)a,*y=*(Unit *const *)b;if(x->bytes!=y->bytes)return x->bytes>y->bytes?-1:1;if(x->tag!=y->tag)return x->tag-y->tag;if(x->users!=y->users)return x->users-y->users;return strcmp(x->key,y->key);}
static int namesort(const void *a,const void *b){return strcmp(*(char *const *)a,*(char *const *)b);}
static char *rev;
int main(int argc,char **argv){started=sy_now_ms();const char *slice=0,*tools=".";for(int i=1;i<argc;i++){if(!strcmp(argv[i],"--slice")&&i+1<argc)slice=argv[++i];else if(!strcmp(argv[i],"--tools-root")&&i+1<argc)tools=argv[++i];else fail("usage --slice DIR [--tools-root ROOT]");}if(!slice)fail("--slice required");char toolreal[4400];if(!realpath(tools,toolreal))fail("tools-root realpath");configure_bound(toolreal);char p[4400];path(p,slice,"receipt.txt");size_t n;char *receipt=load(p,&n,SI_LIMIT,1),*at=receipt,*s=row(&at);if(!s||strcmp(s,"entry-build-v3"))fail("receipt version");char *rp=0,*p3=0,*ps=0,*ctor=0,*cs=0,*via=0;long cb=-1;char *target=0;while((s=row(&at))){if(!*s)continue;char *f[32];int nf=fields(s,f,32);if(nf==2&&!strcmp(f[0],"root")){if(rp&&strcmp(rp,f[1]))fail("conflicting root");rp=f[1];}else if(nf==2&&!strcmp(f[0],"p3")){if(p3&&strcmp(p3,f[1]))fail("conflicting p3");p3=f[1];}else if(nf==2&&!strcmp(f[0],"p3_sha")){if(ps&&strcmp(ps,f[1]))fail("conflicting p3 SHA");ps=f[1];}else if(nf==2&&!strcmp(f[0],"constructor")){if(ctor&&strcmp(ctor,f[1]))fail("conflicting constructor");ctor=f[1];}else if(nf==2&&!strcmp(f[0],"constructor_sha")){if(cs&&strcmp(cs,f[1]))fail("conflicting constructor SHA");cs=f[1];}else if(nf==2&&!strcmp(f[0],"constructor_bytes")){long b=number(f[1]);if(cb>=0&&cb!=b)fail("conflicting constructor bytes");cb=b;}else if(nf==2&&!strcmp(f[0],"via")){if(via&&strcmp(via,f[1]))fail("conflicting via");via=f[1];}else if(nf==2&&!strcmp(f[0],"rev")){if(!*f[1])fail("empty rev");if(rev&&strcmp(rev,f[1]))fail("conflicting rev");rev=f[1];}else if(!strcmp(f[0],"object_level")){char *t=field(f,nf,"target");if(target)fail("duplicate/conflicting object target");if(!t||(strcmp(t,"lnx/x86_64")&&strcmp(t,"lnx/arm64")))fail("target must be lnx/x86_64 or lnx/arm64");target=t;}else{size_t l=strlen(f[0]);if(l>2&&!strcmp(f[0]+l-2,".o")){if(strpbrk(f[0],"/\\")||unitkey(f[0])>=0||nu==SI_MAX)fail("duplicate/unsafe object key or unit bound");Unit *u=&units[nu++];u->key=si_dup(f[0]);char *h=field(f,nf,"sha"),*b=field(f,nf,"bytes"),*src=field(f,nf,"src");if(!h||!b||!src)fail("object receipt fields");u->sha=si_dup(h);u->bytes=number(b);u->claimed=si_dup(src);path(p,slice,u->key);if(hashfile(p,u->sha)!=u->bytes)fail("object byte mismatch");}}}if(!rp||!p3||!ps||!ctor||!cs||!via||cb<0||!target||!nu)fail("incomplete input identity");if(strcmp(via,"sh")&&strcmp(via,"exec"))fail("constructor via");if(!realpath(rp,root))fail("snapshot realpath");if(hashfile(ctor,cs)!=cb)fail("constructor bytes mismatch");hashfile(p3,ps);char *keys[SI_MAX]={0},*srcs[SI_MAX]={0};roots(keys,srcs);char pattern[]="/tmp/slice-inventory-XXXXXX";char *td=mkdtemp(pattern);if(!td)fail("private temp");fit(temp,sizeof temp,td);nt=1;atexit(cleanup);mapping(keys,srcs,ctor,p3,!strcmp(via,"sh"));index_all(toolreal);classify();int unresolved=0;for(int i=0;i<nu;i++)unresolved+=units[i].unknown;tick();printf("INVENTORY_ID\ttarget=%s\troot=%s\trev=%s\tconstructor_sha=%s\tp3_sha=%s\tmapping=snapshot-token-roots+same-constructor-root-order-realpath-plan\trules=slice-inventory-v1\n",target,root,rev?rev:"unrecorded",cs,ps);printf("RULE\tPRIORITY\tEXECUTOR > SYSCALL-IO > environment/unresolved-use MIXED > TABLE-DRIVEN > PURE-BYTESTREAM > MIXED; conservative candidates only\nRULE\tEXECUTOR\tdefinition name contains inflate/decompress/decode/execute/inference/forward/sha256/crc32/checksum; FEATURE lists matches\nRULE\tSYSCALL-IO\tsy_* or __syscall* or enumerated legacy IO calls; FEATURE lists every matched occurrence\nRULE\tTABLE-DRIVEN\tdispatch(if/case/switch)>=4 and >=loops(for/while/do)+nonlocal calls; no closure environment or unresolved use\nRULE\tPURE-BYTESTREAM\tstrict subset: public integer-return byte-buffer and integer-length signatures; no file-scope declarations/initializers, unknown calls, static tokens, callback/parenthesized invocation syntax, non-unisa preprocessor directives, asm, closure IO/environment/unresolved uses; not memory safety proof\nRULE\tMIXED\tinsufficient proof or environment/unresolved closure; not evidence of impossible migration\nRULE\tSORT\tobject bytes descending; PURE,TABLE,MIXED,SYSCALL,EXECUTOR; reverse use closure ascending; key ascending\nRULE\tMEASURES\tsource lines=physical LF plus non-LF tail including comments/blanks; object bytes=whole object file not text or execution memory; users=reverse use closure not runtime frequency\nRULE\tIDENTITY\tidentity=VERIFIED only means the actual bytes/SHA of objects, constructor and container were checked and the in-order plan mapping was verified; it is not an independent reconstruction proving source and object history bytes are equivalent, and is not a product qualification\n");Unit *sorted[SI_MAX];for(int i=0;i<nu;i++){Unit *u=&units[i];sorted[i]=u;char *names[SI_MAX];int nn=0;for(int j=0;j<nu;j++)if(i!=j&&reach[j][i])names[nn++]=units[j].key;qsort(names,(size_t)nn,sizeof *names,namesort);printf("UNIT\t%s\t%s\t%ld\t%ld\t%d\t%d\t%s\t",u->key,u->src+strlen(root)+1,u->bytes,u->lines,u->direct,u->users,tag(u->tag));for(int j=0;j<nn;j++)printf("%s%s",j?",":"",names[j]);printf("\t%s\nFEATURE\t%s\tio=%s\texecutor_definitions=%s\n",u->reason,u->key,u->ionames?u->ionames:"-",u->execnames?u->execnames:"-");}qsort(sorted,(size_t)nu,sizeof *sorted,order);for(int i=0;i<nu&&i<15;i++){Unit *u=sorted[i];printf("TOP\t%d\t%s\t%ld\t%ld\t%d\t%s\t%s\n",i+1,u->key,u->bytes,u->lines,u->users,tag(u->tag),u->reason);}const char *hyp[]={"cxmod.o","driveroute.o"};for(int j=0;j<2;j++){int i=unitkey(hyp[j]);if(i<0)printf("HYPOTHESIS\t%s\tUNKNOWN\tunit absent\n",hyp[j]);else printf("HYPOTHESIS\t%s\t%s\twhole-unit rule classification=%s; %s; not a proof of migration impossibility\n",hyp[j],units[i].tag<=1?"SUPPORTED":units[i].env||units[i].io||units[i].executor?"REFUTED":"UNKNOWN",tag(units[i].tag),units[i].reason);}tick();printf("SLICE_INVENTORY\tunits=%d\troots=%d\tmodules=%d\tmapped=%d\tidentity=VERIFIED\tclosure=%s\tunresolved_uses=%d\trules=slice-inventory-v1\n",nu,nroots,nmodules,nu,unresolved?"PARTIAL":"COMPLETE",unresolved);if(ferror(stdout)||fflush(stdout))fail("stdout");return 0;}
