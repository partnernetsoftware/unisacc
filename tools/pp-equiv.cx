/* tools/pp-equiv.cx -- preprocessing equivalence oracle: the same installed APE run with two model packs
 * (--models A / --models B) over a frozen corpus; every item must come out identical.
 *
 *   sh ./unisacc.com tools/pp-equiv.cx -- manifest [--root DIR] [--strata S,..] [--modes M,..] [--out FILE]
 *   sh ./unisacc.com tools/pp-equiv.cx -- run --ape APE --models-a A --models-b B --manifest M --ledger DIR
 *                                           [--root DIR] [--budget-ms 45000] [--jobs N] [--side-secs 4]
 *                                           [--steps 1]   (e2 rows also record each side's step count, steps=A/B in the detail; E rows: n/a)
 *   sh ./unisacc.com tools/pp-equiv.cx -- status --manifest M --ledger DIR --models-a A --models-b B
 *                                           [--waivers FILE] [--today YYYY-MM-DD]
 *
 * manifest: rows  stratum TAB path TAB sha256 TAB mode  from git ls-files, one row per item and mode.
 *   headers  include/ headers alone and every unordered pair (path hdr:a.h or hdr:a.h+b.h, sha of the generated
 *            source "#include <a.h>\n#include <b.h>\nint tail;\n")
 *   c-tests  tests/*.c
 *   corners  tests/pp-equiv-corners/*.c (the include-edge group; its sub/ headers are inputs, not items)
 *   cx-unit  reserved: refused with "not implemented" until the closure feasibility probe has a verdict
 *   modes    e2 = "stream e2 --level 1" over stdin (the UNIPP2 frame), E = -E.  The -o mode is not in the default list.
 *   The manifest's own sha256 is part of every ledger row, so a frozen manifest cannot be re-sampled.
 *
 * run: per item both packs run with UNISACC_RUN_CACHE=0 and a per-side bound (--side-secs); the verdict is
 *   SAME          rc 0 both sides, stdout and stderr byte-equal (e2: a UNIPP2 frame of at least 31 bytes)
 *   REFUSE_PP     same non-zero rc, stdout and stderr byte-equal (a refusal both packs agree on)
 *   REFUSE_PRE    as REFUSE_PP but the router refused before preprocessing ("multiple preprocessing outputs
 *                 not migrated"): counted as unmeasured, reason route-multi-unit-pp
 *   DIFF          anything else that ran on both sides
 *   UNMEASURED    a side timed out, did not start, or the e2 frame was malformed; reason says which
 *   One ledger row is appended to DIR/STRATUM.tsv per finished item:
 *   PPEQ TAB manifest TAB stratum TAB mode TAB path TAB id-a TAB id-b TAB status TAB reason TAB detail
 *   (id = sha256 of the pack file, or - when no --models is passed).  A row with the same first six fields
 *   already in the ledger is skipped, so a run resumes.  --budget-ms stops starting new items; --jobs N runs N
 *   worker processes, each owning the manifest rows with index % N equal to its shard.
 *
 * status: PP_EQUIV manifest=SHA total=N same= refuse_pp= diff= unmeasured= waived= pending= COMPLETE=yes|no
 *   COMPLETE=yes needs pending=0, diff=0 and every unmeasured item covered by a valid waiver row of
 *   tests/pp-equiv-waivers.tsv:  stratum TAB mode TAB path-prefix TAB reason TAB expires TAB count TAB why.
 *   A waiver is valid only if it has not expired, its count equals the rows it covers, and every row under the
 *   prefix is SAME or has exactly the waived reason (a prefix wider than the refusal voids the waiver).
 * Check: tools/check-pp-equiv.cx. */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.sha
#pragma unisa use sys.time
#pragma unisa use sys.proc
#pragma unisa use sys.posix
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use cxlib.procrun
#pragma unisa use cxlib.ckrun
#pragma unisa use cxlib.e2steps

#define MAXROWS 16384
#define MAXPATH 480
#define MAXHDR 256
#define LEDSZ (1 << 16)

typedef struct { char stratum[12], mode[4], path[MAXPATH], sha[65]; } Row;
static Row rows[MAXROWS];
static int nrows;
static char msha[65];

typedef struct { const char *key; int klen; const char *status, *reason; int slen, rlen; } Led;
static Led led[LEDSZ];
static char *led_buf[16];
static int n_led_buf;

static void die(const char *why) { fprintf(stderr, "PP_EQUIV_ERROR\t%s\n", why); exit(2); }
static void need(int ok, const char *why) { if (!ok) die(why); }

#define FMT(buf, ...) need(!cx_fmt((buf), sizeof(buf), __VA_ARGS__), "format overflow")
#define FMTC(buf, cap, ...) need(!cx_fmt((buf), (cap), __VA_ARGS__), "format overflow")
#define starts(s, p) tx_prefix((s), (long)strlen(s), (p), (long)strlen(p))
#define has(h, w) ckk_has((h), (int)strlen(h) + 1, (w))
static void sha_of(const void *p, size_t n, char out[65]) {
    if (!n) p = "";
    need(!sy_sha256_hex(p, n, out), "sha256");
}
static const char *opt(int argc, char **argv, const char *name, const char *dflt) {
    for (int i = 0; i + 1 < argc; i++) if (!strcmp(argv[i], name)) return argv[i + 1];
    return dflt;
}
static int in_list(const char *list, const char *item) {
    size_t n = strlen(item);
    for (const char *p = list; *p;) {
        const char *e = p;
        while (*e && *e != ',') e++;
        if ((size_t)(e - p) == n && !strncmp(p, item, n)) return 1;
        p = *e ? e + 1 : e;
    }
    return 0;
}

/* ---- manifest ---- */
static char *git_ls(const char *root, const char *spec, size_t *n) {
    char *v[] = {"git", "-C", (char *)root, "ls-files", (char *)spec, 0};
    pr_result r;
    if (pr_run("git ls-files", v, 0, 0, 30, &r) || r.rc) die("git ls-files failed");
    *n = r.outn;
    return r.out;
}
static void add_row(const char *stratum, const char *path, const char *sha, const char *mode) {
    need(nrows < MAXROWS, "too many manifest rows");
    Row *r = &rows[nrows++];
    need(strlen(path) < MAXPATH, "path too long");
    FMT(r->stratum, "%s", stratum);
    FMT(r->mode, "%s", mode);
    FMT(r->path, "%s", path);
    FMT(r->sha, "%s", sha);
}
static void add_modes(const char *stratum, const char *path, const char *sha, const char *modes) {
    if (in_list(modes, "e2")) add_row(stratum, path, sha, "e2");
    if (in_list(modes, "E")) add_row(stratum, path, sha, "E");
}
static void hdr_source(const char *spec, char *out, size_t cap) {
    char a[MAXHDR], b[MAXHDR];
    const char *plus = strchr(spec, '+');
    if (!plus) { FMTC(out, cap, "#include <%s>\nint tail;\n", spec); return; }
    FMT(a, "%.*s", (int)(plus - spec), spec);
    FMT(b, "%s", plus + 1);
    FMTC(out, cap, "#include <%s>\n#include <%s>\nint tail;\n", a, b);
}
static void build_manifest(const char *root, const char *strata, const char *modes) {
    size_t n;
    char *out;
    nrows = 0;
    if (in_list(strata, "cx-unit")) die("stratum cx-unit is not implemented (waiting for the closure feasibility probe)");
    if (in_list(strata, "headers")) {
        static char names[128][MAXHDR];
        int cnt = 0;
        out = git_ls(root, "include", &n);
        for (char *p = out; p < out + n;) {
            char *e = memchr(p, '\n', (size_t)(out + n - p));
            if (!e) e = out + n;
            *e = 0;
            need(cnt < 128 && starts(p, "include/") && strlen(p + 8) < MAXHDR, "include list");
            FMTC(names[cnt++], MAXHDR, "%s", p + 8);
            p = e + 1;
        }
        for (int i = 0; i < cnt; i++)
            for (int j = i; j < cnt; j++) {
                char spec[2 * MAXHDR + 8], src[4 * MAXHDR], sha[65], path[MAXPATH];
                if (i == j) FMT(spec, "%s", names[i]);
                else FMT(spec, "%s+%s", names[i], names[j]);
                hdr_source(spec, src, sizeof src);
                sha_of(src, strlen(src), sha);
                FMT(path, "hdr:%s", spec);
                add_modes("headers", path, sha, modes);
            }
        pr_result rr = {0}; rr.out = out; pr_free(&rr);
    }
    if (in_list(strata, "c-tests") || in_list(strata, "corners")) {
        out = git_ls(root, "tests", &n);
        for (char *p = out; p < out + n;) {
            char *e = memchr(p, '\n', (size_t)(out + n - p));
            if (!e) e = out + n;
            *e = 0;
            size_t pl = strlen(p);
            int corner = starts(p, "tests/pp-equiv-corners/") && !strchr(p + 23, '/');
            int ctest = starts(p, "tests/") && !starts(p, "tests/pp-equiv-corners/") && pl > 2 && !strcmp(p + pl - 2, ".c");
            if (corner && pl > 2 && strcmp(p + pl - 2, ".c")) corner = 0;
            if ((corner && in_list(strata, "corners")) || (ctest && in_list(strata, "c-tests"))) {
                char full[MAXPATH + 600], sha[65];
                size_t fn;
                FMT(full, "%s/%s", root, p);
                char *body = cx_read(full, &fn);
                need(body != 0, "read corpus file");
                sha_of(body, fn, sha);
                mm_free(body);
                add_modes(corner ? "corners" : "c-tests", p, sha, modes);
            }
            p = e + 1;
        }
        pr_result rr = {0}; rr.out = out; pr_free(&rr);
    }
}
static int cmp_row(const void *x, const void *y) {
    const Row *a = x, *b = y;
    int c = strcmp(a->stratum, b->stratum);
    if (c) return c;
    c = strcmp(a->path, b->path);
    return c ? c : strcmp(a->mode, b->mode);
}
static int cmd_manifest(int argc, char **argv) {
    const char *root = opt(argc, argv, "--root", ".");
    const char *strata = opt(argc, argv, "--strata", "headers,c-tests,corners");
    const char *modes = opt(argc, argv, "--modes", "e2,E");
    const char *outp = opt(argc, argv, "--out", 0);
    static char text[MAXROWS * 640];
    size_t at = 0;
    build_manifest(root, strata, modes);
    qsort(rows, (size_t)nrows, sizeof rows[0], cmp_row);
    for (int i = 0; i < nrows; i++) {
        int k = snprintf(text + at, sizeof text - at, "%s\t%s\t%s\t%s\n", rows[i].stratum, rows[i].path, rows[i].sha, rows[i].mode);
        need(k > 0 && at + (size_t)k < sizeof text, "manifest too large");
        at += (size_t)k;
    }
    sha_of(text, at, msha);
    if (outp) need(!cx_write(outp, text, at), "write manifest");
    else fwrite(text, 1, at, stdout);
    fprintf(stderr, "PP_MANIFEST\tsha=%s\trows=%d\n", msha, nrows);
    return 0;
}

/* ---- manifest load, ledger ---- */
static void load_manifest(const char *file) {
    size_t n;
    char *text = cx_read(file, &n);
    need(text != 0, "read manifest");
    sha_of(text, n, msha);
    nrows = 0;
    for (char *p = text; p < text + n;) {
        char *e = memchr(p, '\n', (size_t)(text + n - p)), *f[4];
        int k = 0;
        if (!e) e = text + n;
        *e = 0;
        for (char *q = p; k < 4; k++) {
            f[k] = q;
            char *t = strchr(q, '\t');
            if (!t) break;
            *t = 0;
            q = t + 1;
        }
        need(k == 3 && strlen(f[0]) < sizeof rows[0].stratum && strlen(f[3]) < sizeof rows[0].mode, "manifest row");
        add_row(f[0], f[1], f[2], f[3]);
        p = e + 1;
    }
}
static unsigned long hash_of(const char *s, int n) {
    unsigned long h = 1469598103934665603UL;
    for (int i = 0; i < n; i++) h = (h ^ (unsigned char)s[i]) * 1099511628211UL;
    return h;
}
static void make_key(char *out, size_t cap, const Row *r, const char *ida, const char *idb) {
    need(snprintf(out, cap, "%s\t%s\t%s\t%s\t%s\t%s", msha, r->stratum, r->mode, r->path, ida, idb) < (int)cap, "key too long");
}
static Led *led_find(const char *key, int klen, int create) {
    unsigned long h = hash_of(key, klen) % LEDSZ;
    for (int probes = 0; probes < LEDSZ; probes++, h = (h + 1) % LEDSZ) {
        Led *l = &led[h];
        if (!l->key) { if (!create) return 0; l->key = key; l->klen = klen; return l; }
        if (l->klen == klen && !memcmp(l->key, key, (size_t)klen)) return l;
    }
    die("ledger table full");
    return 0;
}
static void load_ledger_file(const char *path) {
    size_t n;
    if (sy_is_reg(path) != 1) return;
    char *text = cx_read(path, &n);
    need(text != 0 && n_led_buf < 16, "read ledger");
    led_buf[n_led_buf++] = text;
    for (char *p = text; p < text + n;) {
        char *e = memchr(p, '\n', (size_t)(text + n - p));
        if (!e) e = text + n;
        *e = 0;
        if (starts(p, "PPEQ\t")) {
            char *k = p + 5, *t = k;
            int tabs = 0;
            while (*t && tabs < 6) { if (*t == '\t') tabs++; t++; }
            if (tabs == 6) {
                int klen = (int)(t - 1 - k);
                char *st = t, *tt = strchr(st, '\t');
                if (tt) {
                    char *rs = tt + 1, *re = strchr(rs, '\t');
                    Led *l = led_find(k, klen, 1);
                    l->status = st; l->slen = (int)(tt - st);
                    l->reason = rs; l->rlen = re ? (int)(re - rs) : (int)strlen(rs);
                }
            }
        }
        p = e + 1;
    }
}
static void load_ledger(const char *dir) {
    memset(led, 0, sizeof led);
    n_led_buf = 0;
    for (int i = 0; i < nrows; i++) {
        int seen = 0;
        for (int j = 0; j < i; j++) if (!strcmp(rows[j].stratum, rows[i].stratum)) { seen = 1; break; }
        if (seen) continue;
        char path[1024];
        FMT(path, "%s/%s.tsv", dir, rows[i].stratum);
        load_ledger_file(path);
    }
}
static void pack_id(const char *pack, char out[65]) {
    size_t n;
    if (!strcmp(pack, "-")) { FMTC(out, 65, "-"); return; }
    char *b = cx_read(pack, &n);
    need(b != 0, "read model pack");
    sha_of(b, n, out);
    mm_free(b);
}

/* ---- one item ---- */
typedef struct { int started; pr_result r; } Side;
static int g_rr;   /* --steps 1: ask each e2 side for its step count (RR_TIME on stderr); E mode has no steps */
static void side_run(const char *ape, const char *pack, const char *mode, const char *file, const char *root, int secs, Side *s) {
    char *av[40], src[1100];
    int n = 0;
    FMT(src, "PPEQ_SRC=%s", file);
    char *env[] = {"UNISACC_RUN_CACHE=0", src, "UNISACC_RR_TIME=1", 0};
    if (!(g_rr && !strcmp(mode, "e2"))) env[2] = 0;   /* the variable must be absent, not empty, when steps are not asked for */
    if (!strcmp(mode, "e2")) {
        av[n++] = "/bin/sh"; av[n++] = "-c"; av[n++] = "exec \"$@\" < \"$PPEQ_SRC\""; av[n++] = "sh";
        av[n++] = "/bin/sh"; av[n++] = (char *)ape; av[n++] = "stream"; av[n++] = "e2"; av[n++] = "--level"; av[n++] = "1";
        if (strcmp(pack, "-")) { av[n++] = "--models"; av[n++] = (char *)pack; }
        av[n++] = "--target"; av[n++] = "lnx/x86_64"; av[n++] = "--source"; av[n++] = (char *)file;
    } else {
        av[n++] = "/bin/sh"; av[n++] = (char *)ape;
        if (strcmp(pack, "-")) { av[n++] = "--models"; av[n++] = (char *)pack; }
        av[n++] = "-E"; av[n++] = (char *)file;
    }
    av[n] = 0;
    s->started = pr_run("pp-equiv side", av, root, env, secs, &s->r) == 0;
}
static int same_bytes(const char *a, size_t an, const char *b, size_t bn) { return an == bn && (!an || !memcmp(a, b, an)); }

static void item(const Row *r, const char *ape, const char *pa, const char *pb, const char *ida, const char *idb,
                 const char *root, const char *ledger, int secs, const char *tmpd) {
    char file[1100], key[1500], line[3000], detail[400];
    static char e1[1 << 20], e2[1 << 20];
    const char *status = "SAME", *reason = "-";
    Side x = {0}, y = {0};
    if (starts(r->path, "hdr:")) {
        char src[4 * MAXHDR];
        hdr_source(r->path + 4, src, sizeof src);
        FMT(file, "%s/%s.c", tmpd, r->sha);
        need(!cx_write(file, src, strlen(src)), "write header case");
    } else FMT(file, "%s", r->path);
    side_run(ape, pa, r->mode, file, root, secs, &x);
    side_run(ape, pb, r->mode, file, root, secs, &y);
    detail[0] = 0;
    if (!x.started || !y.started) {
        status = "UNMEASURED";
        reason = x.r.timed_out || y.r.timed_out ? "timeout" : "spawn";
        FMT(detail, "%s", x.started ? y.r.why : x.r.why);
        for (char *c = detail; *c; c++) if (*c == '\t' || *c == '\n') *c = ' ';
    } else {
        int rc_same = x.r.rc == y.r.rc;
        int out_same = same_bytes(x.r.out, x.r.outn, y.r.out, y.r.outn);
        int use_rr = g_rr && !strcmp(r->mode, "e2");
        long sa = -1, sb = -1;
        int err_same;
        if (use_rr) {   /* the step lines carry ns and must not decide the verdict */
            size_t n1 = e2s_err_norm(x.r.err, x.r.errn, e1, sizeof e1), n2 = e2s_err_norm(y.r.err, y.r.errn, e2, sizeof e2);
            err_same = same_bytes(e1, n1, e2, n2);
            sa = e2s_steps_of(x.r.err, x.r.errn); sb = e2s_steps_of(y.r.err, y.r.errn);
        } else err_same = same_bytes(x.r.err, x.r.errn, y.r.err, y.r.errn);
        char hx[65], hy[65];
        sha_of(x.r.out, x.r.outn, hx);
        sha_of(y.r.out, y.r.outn, hy);
        FMT(detail, "rc=%d/%d out=%zu/%zu err=%zu/%zu sha=%.12s/%.12s", x.r.rc, y.r.rc, x.r.outn, y.r.outn, x.r.errn, y.r.errn, hx, hy);
        if (use_rr && sa >= 0 && sb >= 0) { size_t dl = strlen(detail); FMTC(detail + dl, sizeof detail - dl, " steps=%ld/%ld", sa, sb); }
        if (!rc_same || !out_same || !err_same) {
            status = "DIFF";
            reason = !rc_same ? "rc" : !out_same ? "stdout" : "stderr";
        } else if (x.r.rc != 0) {
            if (x.r.err && has(x.r.err, "multiple preprocessing outputs not migrated")) { status = "REFUSE_PRE"; reason = "route-multi-unit-pp"; }
            else status = "REFUSE_PP";
        } else if (!strcmp(r->mode, "e2") && (x.r.outn < 31 || memcmp(x.r.out, "UNIPP2", 7))) {
            status = "UNMEASURED"; reason = "bad-e2-frame";
        }
    }
    make_key(key, sizeof key, r, ida, idb);
    int k = snprintf(line, sizeof line, "PPEQ\t%s\t%s\t%s\t%s\n", key, status, reason, detail);
    need(k > 0 && k < (int)sizeof line, "ledger line");
    char path[1024];
    FMT(path, "%s/%s.tsv", ledger, r->stratum);
    need(!sy_append_file(path, line, k, 0644), "append ledger");
    pr_free(&x.r);
    pr_free(&y.r);
}

static int cmd_run(int argc, char **argv) {
    const char *ape = opt(argc, argv, "--ape", 0), *pa = opt(argc, argv, "--models-a", 0), *pb = opt(argc, argv, "--models-b", 0);
    const char *mf = opt(argc, argv, "--manifest", 0), *ledger = opt(argc, argv, "--ledger", 0), *root = opt(argc, argv, "--root", ".");
    const char *xroot = opt(argc, argv, "--exec-root", ".");
    long budget = atol(opt(argc, argv, "--budget-ms", "45000")), jobs = atol(opt(argc, argv, "--jobs", "1"));
    int secs = atoi(opt(argc, argv, "--side-secs", "4")), shard = atoi(opt(argc, argv, "--shard", "0")), shards = atoi(opt(argc, argv, "--shards", "1"));
    g_rr = atoi(opt(argc, argv, "--steps", "0"));
    need(ape && pa && pb && mf && ledger, "run needs --ape --models-a --models-b --manifest --ledger");
    need(jobs >= 1 && jobs <= 32 && secs >= 1 && shards >= 1 && shard >= 0 && shard < shards, "bad numeric option");
    if (jobs > 1) {
        sy_child_t ch[32];
        char self[1100], rt[1100], js[16], sh[32][16];
        int rc = 0;
        FMT(self, "%s/tools/pp-equiv.cx", xroot);
        FMT(rt, "%s/unisacc.com", xroot);
        FMT(js, "%ld", jobs);
        for (int i = 0; i < jobs; i++) {
            sy_spawn_t o;
            char bud[32], ss[16];
            FMTC(sh[i], 16, "%d", i);
            FMT(bud, "%ld", budget);
            FMT(ss, "%d", secs);
            char *v[] = {"sh", rt, self, "--", "run", "--ape", (char *)ape, "--models-a", (char *)pa, "--models-b", (char *)pb, "--manifest", (char *)mf,
                         "--ledger", (char *)ledger, "--root", (char *)root, "--exec-root", (char *)xroot, "--budget-ms", bud, "--side-secs", ss, "--shard", sh[i], "--shards", js, "--steps", g_rr ? "1" : "0", 0};
            sy_spawn_init(&o);
            o.argv = v; o.cwd = xroot; o.pgroup = -1; o.deadline_ms = budget + 2L * secs * 1000 + 8000;
            need(sy_proc_spawn(&o, &ch[i]) == 0, "spawn worker");
        }
        for (int i = 0; i < jobs; i++) {
            sy_exit_t st;
            need(sy_proc_wait(&ch[i], &st) == 0, "wait worker");
            if (sy_exit_code(&st) != 0) rc = 1;
        }
        printf("PP_EQUIV_RUN\tworkers=%ld\trc=%d\n", jobs, rc);
        return rc;
    }
    long t0 = sy_now_ms();
    char ida[65], idb[65], tmpd[1024];
    int done = 0, skipped = 0, stopped = 0;
    load_manifest(mf);
    need(sy_mkdir_all(ledger, 0755) == 0, "ledger dir");
    load_ledger(ledger);
    pack_id(pa, ida);
    pack_id(pb, idb);
    need(sy_mkdtemp(sy_tmpdir(), "pp-equiv-", tmpd, sizeof tmpd) == 0, "tmp dir");
    for (int i = 0; i < nrows; i++) {
        char key[1500];
        if (i % shards != shard) continue;
        make_key(key, sizeof key, &rows[i], ida, idb);
        if (led_find(key, (int)strlen(key), 0)) { skipped++; continue; }
        if (sy_now_ms() - t0 >= budget) { stopped = 1; break; }
        item(&rows[i], ape, pa, pb, ida, idb, root, ledger, secs, tmpd);
        done++;
    }
    sy_remove_all(tmpd);
    printf("PP_EQUIV_RUN\tmanifest=%s\tshard=%d/%d\tdone=%d\tskipped=%d\tbudget_stop=%d\tms=%ld\n", msha, shard, shards, done, skipped, stopped, sy_now_ms() - t0);
    return 0;
}

/* ---- status ---- */
static void today_of(char out[11]) {
    long z = sy_now_ms() / 86400000L + 719468, era = (z >= 0 ? z : z - 146096) / 146097, doe = z - era * 146097;
    long yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365, y = yoe + era * 400, doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    long mp = (5 * doy + 2) / 153, d = doy - (153 * mp + 2) / 5 + 1, m = mp < 10 ? mp + 3 : mp - 9;
    FMTC(out, 11, "%04ld-%02ld-%02ld", m <= 2 ? y + 1 : y, m, d);
}
/* the ledger verdict of manifest row I: 0 pending, else the Led */
static const Led *row_led(int i, const char *ida, const char *idb) {
    char key[1500];
    make_key(key, sizeof key, &rows[i], ida, idb);
    return led_find(key, (int)strlen(key), 0);
}
static int led_is(const Led *l, const char *s) { return l && l->slen == (int)strlen(s) && !strncmp(l->status, s, (size_t)l->slen); }
static int led_reason_is(const Led *l, const char *s) { return l && l->rlen == (int)strlen(s) && !strncmp(l->reason, s, (size_t)l->rlen); }

static int cmd_status(int argc, char **argv) {
    const char *mf = opt(argc, argv, "--manifest", 0), *ledger = opt(argc, argv, "--ledger", 0);
    const char *pa = opt(argc, argv, "--models-a", 0), *pb = opt(argc, argv, "--models-b", 0);
    const char *wf = opt(argc, argv, "--waivers", "tests/pp-equiv-waivers.tsv"), *tod = opt(argc, argv, "--today", 0);
    char ida[65], idb[65], today[11];
    static char waived_row[MAXROWS];
    int same = 0, refuse_pp = 0, diff = 0, unmeasured = 0, waived = 0, pending = 0;
    need(mf && ledger && pa && pb, "status needs --manifest --ledger --models-a --models-b");
    load_manifest(mf);
    load_ledger(ledger);
    pack_id(pa, ida);
    pack_id(pb, idb);
    if (tod) FMT(today, "%s", tod);
    else today_of(today);
    if (sy_is_reg(wf) == 1) {
        size_t n;
        char *text = cx_read(wf, &n);
        need(text != 0, "read waivers");
        for (char *p = text; p < text + n;) {
            char *e = memchr(p, '\n', (size_t)(text + n - p)), *f[7];
            int k = 0;
            if (!e) e = text + n;
            *e = 0;
            if (*p && *p != '#') {
                for (char *q = p; k < 7; k++) {
                    f[k] = q;
                    char *t = strchr(q, '\t');
                    if (!t) { k++; break; }
                    *t = 0;
                    q = t + 1;
                }
                if (k < 7) { printf("WAIVER\tvoid\tmalformed-row\t%s\n", p); }
                else {
                    int covered = 0, bad = 0, i;
                    const char *why = "ok";
                    for (i = 0; i < nrows; i++) {
                        if (strcmp(rows[i].stratum, f[0]) || strcmp(rows[i].mode, f[1]) || !starts(rows[i].path, f[2])) continue;
                        const Led *l = row_led(i, ida, idb);
                        if (led_is(l, "SAME")) continue;
                        if (l && (led_is(l, "UNMEASURED") || led_is(l, "REFUSE_PRE")) && led_reason_is(l, f[3])) covered++;
                        else bad++;
                    }
                    if (bad) why = "prefix-wider-than-reason";
                    else if (strcmp(f[4], today) < 0) why = "expired";
                    else if (atoi(f[5]) != covered) why = "count-mismatch";
                    int valid = !strcmp(why, "ok");
                    if (valid)
                        for (i = 0; i < nrows; i++)
                            if (!strcmp(rows[i].stratum, f[0]) && !strcmp(rows[i].mode, f[1]) && starts(rows[i].path, f[2])) {
                                const Led *l = row_led(i, ida, idb);
                                if (!led_is(l, "SAME")) waived_row[i] = 1;
                            }
                    printf("WAIVER\t%s\t%s\t%s %s %s covers=%d declared=%s expires=%s\n", valid ? "valid" : "void", why, f[0], f[1], f[2], covered, f[5], f[4]);
                }
            }
            p = e + 1;
        }
    }
    for (int i = 0; i < nrows; i++) {
        const Led *l = row_led(i, ida, idb);
        if (!l) pending++;
        else if (led_is(l, "SAME")) same++;
        else if (led_is(l, "REFUSE_PP")) refuse_pp++;
        else if (led_is(l, "DIFF")) diff++;
        else if (waived_row[i]) waived++;
        else unmeasured++;
    }
    int complete = pending == 0 && diff == 0 && unmeasured == 0;
    if (atoi(opt(argc, argv, "--steps", "0"))) {   /* e2 rows only; E rows carry no step count */
        long acc[5] = {0, 0, 0, 0, 0};
        for (int i = 0; i < nrows; i++) {
            int dup = 0;
            for (int j = 0; j < i && !dup; j++) dup = !strcmp(rows[j].stratum, rows[i].stratum);
            if (dup) continue;
            char path[1024];
            FMT(path, "%s/%s.tsv", ledger, rows[i].stratum);
            if (sy_is_reg(path) != 1) continue;
            size_t n = 0;
            char *text = cx_read(path, &n);
            if (!text) continue;
            e2s_ledger_sum(text, n, acc);
            mm_free(text);
        }
        printf("STEPS_SUM\trows=%ld\tstep_moved=%ld\tstep_grew=%ld\tsteps_a=%ld\tsteps_b=%ld\n", acc[0], acc[1], acc[2], acc[3], acc[4]);
    }
    printf("PP_EQUIV\tmanifest=%s\ttotal=%d\tsame=%d\trefuse_pp=%d\tdiff=%d\tunmeasured=%d\twaived=%d\tpending=%d\tCOMPLETE=%s\n",
           msha, nrows, same, refuse_pp, diff, unmeasured, waived, pending, complete ? "yes" : "no");
    return complete ? 0 : 1;
}

int main(int argc, char **argv) {
    need(argc >= 2, "usage: pp-equiv.cx -- manifest|run|status ...");
    if (!strcmp(argv[1], "manifest")) return cmd_manifest(argc - 2, argv + 2);
    if (!strcmp(argv[1], "run")) return cmd_run(argc - 2, argv + 2);
    if (!strcmp(argv[1], "status")) return cmd_status(argc - 2, argv + 2);
    die("unknown subcommand");
    return 2;
}
