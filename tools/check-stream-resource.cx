#pragma unisa use runtime.stream_resource
#pragma unisa use text.text
static int failed;
static void check(int ok,const char *name){printf("%s\t%s\n",ok?"PASS":"FAIL",name);if(!ok)failed++;}
int main(void){
    unsigned char name[256];memset(name,0xa5,sizeof name);const char *path="unchanged";int n=7;
    check(cxsr_parse(0,name,sizeof name,&path,&n)==0&&!path&&!n&&name[0]==0xa5,"absent");
    const char *input="library/symbols=/tmp/a=b";
    check(cxsr_parse(input,name,sizeof name,&path,&n)==1&&n==16&&!name[0]&&!memcmp(name+1,"library/symbols",15)&&path==input+16&&tx_eqz(path, "/tmp/a=b"),"borrow-and-name");
    memset(name,0xa5,sizeof name);path="unchanged";n=7;
    check(cxsr_parse("=file",name,sizeof name,&path,&n)==2&&name[0]==0xa5&&n==7&&tx_eqz(path, "unchanged"),"empty-name");
    check(cxsr_parse("name=",name,sizeof name,&path,&n)==2&&name[0]==0xa5&&n==7,"empty-path");
    check(cxsr_parse("name",name,sizeof name,&path,&n)==2&&name[0]==0xa5&&n==7,"missing-equals");
    check(cxsr_parse("ab=x",name,2,&path,&n)==2&&name[0]==0xa5&&n==7,"short-buffer");
    char longname[258];memset(longname,'a',254);longname[254]='=';longname[255]='x';longname[256]=0;
    check(cxsr_parse(longname,name,255,&path,&n)==1&&n==255&&path==longname+255,"max-name");
    longname[254]='a';longname[255]='=';longname[256]='x';longname[257]=0;
    memset(name,0xa5,sizeof name);n=7;
    check(cxsr_parse(longname,name,sizeof name,&path,&n)==2&&n==7&&name[0]==0xa5,"oversize-name");
    unsigned char alias[]="a=b";path="unchanged";n=7;
    check(cxsr_parse((char *)alias,alias,sizeof alias,&path,&n)==2&&tx_eqz((char *)alias, "a=b")&&n==7&&tx_eqz(path, "unchanged"),"alias-rejected");
    check(cxsr_parse("x=y",0,1,&path,&n)==2&&cxsr_parse("x=y",name,1,0,&n)==2&&cxsr_parse("x=y",name,1,&path,0)==2,"null-outputs");
    printf("CXSTREAM_RESOURCE\tfailed=%d\n",failed);return failed?1:0;
}
