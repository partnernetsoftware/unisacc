#pragma unisa use chrome_dom
/* tools/check-gen-font.cx -- gen-font --check 与磁盘逐字节;篡改必红.
 */
static int failed;
static void ck(int ok, const char *lab) {
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", lab);
    if (!ok) failed++;
}
static int run_check(void) {
    char *av[6];
    char *out = 0;
    size_t on = 0;
    int rc;
    av[0] = "sh";
    av[1] = "./unisacc.com";
    av[2] = "tools/gen-font.cx";
    av[3] = "--";
    av[4] = "--check";
    av[5] = 0;
    rc = cx_runv_timeout(av, 20, &out, &on);
    if (out) { fwrite(out, 1, on, stdout); free(out); }
    return rc;
}
int main(void) {
    FILE *f;
    char buf[2048];
    int n = 0, rc, i;
    const char *path = "ujs/practice/uxe/test/font5x7.tsv";
    rc = run_check();
    ck(rc == 0, "gen-font-rc0");
    f = fopen(path, "rb");
    if (!f) { ck(0, "open-tsv"); printf("CHECK_GEN_FONT\tfailed=%d\n", failed); return 1; }
    n = (int)fread(buf, 1, sizeof buf, f);
    fclose(f);
    for (i = 0; i < n; i++) if (buf[i] == '6' && buf[i + 1] == '2') { buf[i + 1] = '3'; break; }
    f = fopen(path, "wb");
    if (f) { fwrite(buf, 1, n, f); fclose(f); }
    rc = run_check();
    ck(rc != 0, "tamper-diff");
    for (i = 0; i < n; i++) if (buf[i] == '6' && buf[i + 1] == '3') { buf[i + 1] = '2'; break; }
    f = fopen(path, "wb");
    if (f) { fwrite(buf, 1, n, f); fclose(f); }
    rc = run_check();
    ck(rc == 0, "restore-ok");
    {
        const char *jp = "ujs/practice/uxe/font5x7.js";
        char jb[4096];
        int jn = 0;
        f = fopen(jp, "rb");
        if (!f) { ck(0, "open-js"); }
        else {
            jn = (int)fread(jb, 1, sizeof jb, f);
            fclose(f);
            for (i = 0; i < jn - 1; i++) if (jb[i] == '6' && jb[i + 1] == '2') { jb[i + 1] = '3'; break; }
            f = fopen(jp, "wb");
            if (f) { fwrite(jb, 1, jn, f); fclose(f); }
            rc = run_check();
            ck(rc != 0, "tamper-js");
            for (i = 0; i < jn - 1; i++) if (jb[i] == '6' && jb[i + 1] == '3') { jb[i + 1] = '2'; break; }
            f = fopen(jp, "wb");
            if (f) { fwrite(jb, 1, jn, f); fclose(f); }
            rc = run_check();
            ck(rc == 0, "restore-js");
        }
    }
    printf("CHECK_GEN_FONT\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
