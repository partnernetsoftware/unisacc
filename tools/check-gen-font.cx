#pragma unisa use chrome_dom
/* tools/check-gen-font.cx -- 转调 gen-font --check.
 * sh ./unisacc.com tools/check-gen-font.cx --
 */
static int failed;
static void ck(int ok, const char *lab) {
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", lab);
    if (!ok) failed++;
}
int main(void) {
    char *av[6];
    char *out = 0;
    size_t on = 0;
    int rc, n = 0;
    const char *p;
    av[0] = "sh";
    av[1] = "./unisacc.com";
    av[2] = "tools/gen-font.cx";
    av[3] = "--";
    av[4] = "--check";
    av[5] = 0;
    rc = cx_runv_timeout(av, 20, &out, &on);
    if (out) {
        p = out;
        while (*p) {
            if (p[0] == 'F' && p[1] == 'O' && p[2] == 'N' && p[3] == 'T' && p[4] == '\t') {
                p += 5;
                if (p[0] == 'n' && p[1] == '=') {
                    p += 2;
                    n = 0;
                    while (*p >= '0' && *p <= '9') { n = n * 10 + *p - '0'; p++; }
                }
            } else p++;
        }
        fwrite(out, 1, on, stdout);
        free(out);
    }
    ck(rc == 0, "gen-font-rc0");
    ck(n >= 4, "glyphs>=4");
    printf("CHECK_GEN_FONT\tn=%d\tfailed=%d\n", n, failed);
    return failed ? 1 : 0;
}
