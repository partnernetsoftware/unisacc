/* Exact source-table construction for one 1- to 3-field classic net.
 * prepare ROOT NAME NEW_ABS_MAT | --verify ROOT NAME ABS_MAT.
 * Each full-domain key fires exactly one disjoint mask cube, with W2=1 for
 * every head. This is a construction, not a test result or product install. */
#pragma unisa use cxlib.netpack
#pragma unisa use text.text
#define ROWS 5000
#define FIELDS 3
#define HEADS 16
#define VALUES 128
#define CLASSES 512
static char root[4096],mat[4096],name[100],gold_path[4400],tool_path[4400],product_path[4400];
static char *fv[FIELDS][VALUES],*fn[FIELDS],*hv[HEADS][CLASSES],*hn[HEADS];
static int vn[FIELDS],cn[HEADS],labels[ROWS][HEADS],unit_label[ROWS][HEADS],nf,nh,nrows,nu;
typedef struct {unsigned long long lo,hi;} Bits;
static Bits mask[ROWS][FIELDS];
static Bits bit(int v){Bits b={0,0};if(v<64)b.lo=1ULL<<v;else b.hi=1ULL<<(v-64);return b;}
static Bits all(int n){Bits b={0,0};b.lo=n>=64?~0ULL:((1ULL<<n)-1);if(n>64)b.hi=n==128?~0ULL:((1ULL<<(n-64))-1);return b;}
static Bits bor(Bits a,Bits b){Bits c={a.lo|b.lo,a.hi|b.hi};return c;}
static int beq(Bits a,Bits b){return a.lo==b.lo&&a.hi==b.hi;}
static int has(Bits a,int v){return v<64?((a.lo>>v)&1):((a.hi>>(v-64))&1);}
static void die(const char *s){fprintf(stderr,"gold-partition-material: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void copy_fit(char *dst, size_t cap, const char *src){size_t i=0;if(cap==0)die("copy-bound");while(src[i]&&i+1<cap){dst[i]=src[i];i++;}if(src[i])die("copy-bound");dst[i]=0;}
static void path(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path-bound");}
static char *load(const char *p,size_t *n){struct stat a,b;errno=0;if(lstat(p,&a))die(errno==ENOENT?"input-absent":"input-stat");if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>16777216)die("bounded-regular-input");int fd=open(p,O_RDONLY|O_CLOEXEC|O_NONBLOCK|O_NOFOLLOW);if(fd<0)die("input-open");if(fstat(fd,&b)||!S_ISREG(b.st_mode)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size){close(fd);die("input-descriptor");}*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s){close(fd);die("allocation");}size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0){close(fd);die("input-extent");}at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int changed=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(z||changed||closed){free(s);die("input-changed-or-close");}s[*n]=0;return s;}
static void save(const char *p,const char *s,size_t n){int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive-output");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0){close(fd);die("output-write");}at+=(size_t)z;}int synced=fsync(fd),closed=close(fd);if(synced||closed)die("output-close");}
static void equal(const char *p,const np_buf *b){size_t n;char *s=load(p,&n);int ok=n==b->n&&!memcmp(s,b->p,n);free(s);if(!ok)die("material-content-mismatch");}
static void number(np_buf *b,int x){char s[40];int n=snprintf(s,sizeof s,"%d",x);if(n<0||n>=(int)sizeof s)die("number-bound");np_put(b,s,(size_t)n);}
static void qstr(np_buf *b,const char *s){np_puts(b,"\"");for(const char *p=s;*p;p++){if(*p=='\"'||*p=='\\')np_puts(b,"\\");if((unsigned char)*p<32)die("json-string-control");np_put(b,p,1);}np_puts(b,"\"");}
static void u64(np_buf *b,unsigned long long x,int n){char raw[8];for(int i=0;i<n;i++){raw[i]=(char)(x&255);x>>=8;}np_put(b,raw,(size_t)n);}
static int columns(char *s,char **out){int n=1;out[0]=s;if(!*s)die("empty-line");for(char *p=s;*p;p++)if(*p=='\t'){*p=0;if(!*out[n-1]||n>=520)die("empty-or-many-columns");out[n++]=p+1;}if(!*out[n-1])die("empty-final-column");return n;}
static int find(char **v,int n,const char *s){for(int i=0;i<n;i++)if(tx_eq(v[i], s, 1L << 20))return i;return -1;}
static int same(int a,int b){for(int h=0;h<nh;h++)if(labels[a][h]!=labels[b][h])return 0;return 1;}
static void parse(char *s,size_t n){if(memchr(s,0,n)||memchr(s,'\r',n)||!n||s[n-1]!='\n')die("gold-table-wire");char *line=s,*cells[520];int header=0,first=1;for(size_t at=0;at<n;at++)if(s[at]=='\n'){s[at]=0;int nc=columns(line,cells);if(first){char prefix[160];int z=snprintf(prefix,sizeof prefix,"# stage %s: ",name);if(z<0||z>=(int)sizeof prefix||strncmp(line,prefix,(size_t)z))die("gold-stage-header");first=0;}else if(tx_eq(cells[0], "#field", 1L << 20)){if(header||nh||nf==FIELDS||nc<3||nc-2>VALUES)die("field-schema");fn[nf]=cells[1];vn[nf]=nc-2;for(int v=0;v<vn[nf];v++){if(find(fv[nf],v,cells[v+2])>=0)die("duplicate-field-value");fv[nf][v]=cells[v+2];}nf++;}else if(tx_eq(cells[0], "#head", 1L << 20)){if(header||!nf||nh==HEADS||nc<4||nc-3>CLASSES)die("head-schema");hn[nh]=cells[1];cn[nh]=nc-3;for(int c=0;c<cn[nh];c++){if(find(hv[nh],c,cells[c+3])>=0)die("duplicate-class-value");hv[nh][c]=cells[c+3];}nh++;}else if(!header){if(!nf||!nh||nc!=nf+nh)die("column-header-count");for(int f=0;f<nf;f++)if(!tx_eq(cells[f], fn[f], 1L << 20))die("column-field-name");for(int h=0;h<nh;h++){char want[100];int z=snprintf(want,sizeof want,"=> %s",hn[h]);if(z<0||z>=(int)sizeof want||!tx_eq(cells[nf+h], want, 1L << 20))die("column-head-name");}header=1;}else{if(nc!=nf+nh||nrows>=ROWS)die("data-row-count");int id=nrows;for(int f=nf-1;f>=0;f--){int v=id%vn[f];id/=vn[f];if(!tx_eq(cells[f], fv[f][v], 1L << 20))die("noncanonical-or-incomplete-key-order");}if(id)die("key-product-exceeded");for(int h=0;h<nh;h++){int c=find(hv[h],cn[h],cells[nf+h]);if(c<0)die("unknown-class");labels[nrows][h]=c;}nrows++;}line=s+at+1;}int product=1;for(int f=0;f<nf;f++)product*=vn[f];if(!header||nrows!=product)die("incomplete-Cartesian-gold");}
static Bits tail_group(int row,int prefix,const int used[ROWS],int last){Bits got={0,0};for(int v=0;v<last;v++){int id=prefix*last+v;if(!used[id]&&same(row,id))got=bor(got,bit(v));}return got;}
static Bits middle_group(int row,int x,Bits tail,const int used[ROWS],int last){Bits got={0,0};for(int y=0;y<vn[1];y++){int prefix=x*vn[1]+y;if(beq(tail_group(row,prefix,used,last),tail))got=bor(got,bit(y));}return got;}
static void construct(void){
 int used[ROWS]={0},last=vn[nf-1],prefixes=nrows/last;
 for(int a=0;a<prefixes;a++)for(int b=0;b<last;b++){
  int r=a*last+b;if(used[r])continue;
  Bits tail=tail_group(r,a,used,last),m0={0,0},m1={0,0};
  if((!tail.lo&&!tail.hi)||nu>=ROWS||nu>=4096)die("cube-construction-capacity");
  if(nf==1){m0=bit(0);mask[nu][0]=tail;}
  else if(nf==2){for(int x=0;x<prefixes;x++)if(beq(tail_group(r,x,used,last),tail))m0=bor(m0,bit(x));mask[nu][0]=m0;mask[nu][1]=tail;}
  else{int x=a/vn[1];m1=middle_group(r,x,tail,used,last);for(int xx=0;xx<vn[0];xx++)if(beq(middle_group(r,xx,tail,used,last),m1))m0=bor(m0,bit(xx));mask[nu][0]=m0;mask[nu][1]=m1;mask[nu][2]=tail;}
  if((!m0.lo&&!m0.hi)||(nf==3&&!m1.lo&&!m1.hi))die("prefix-group-empty");
  for(int h=0;h<nh;h++)unit_label[nu][h]=labels[r][h];
  if(nf==3){for(int x=0;x<vn[0];x++)if(has(m0,x))for(int y=0;y<vn[1];y++)if(has(m1,y))for(int v=0;v<last;v++)if(has(tail,v))used[(x*vn[1]+y)*last+v]=1;}
  else{for(int x=0;x<prefixes;x++)if(has(m0,x))for(int v=0;v<last;v++)if(has(tail,v))used[x*last+v]=1;}
  nu++;
 }
 for(int r=0;r<nrows;r++){
  if(!used[r])die("uncovered-key");int key[FIELDS]={0,0,0},id=r;
  for(int f=nf-1;f>=0;f--){key[f]=id%vn[f];id/=vn[f];}
  int hits=0,answer=-1;for(int j=0;j<nu;j++){int yes=1;for(int f=0;f<nf;f++)if(!has(mask[j][f],key[f]))yes=0;if(yes){hits++;answer=j;}}
  if(hits!=1||answer<0)die("non-disjoint-or-missing-key");
  for(int h=0;h<nh;h++)if(unit_label[answer][h]!=labels[r][h])die("constructed-label-mismatch");
 }
}
static np_buf weights(void){np_buf b={0};int mw=1;for(int f=0;f<nf;f++)if(vn[f]>64)mw=2;for(int j=0;j<nu;j++)for(int f=0;f<nf;f++){Bits v=beq(mask[j][f],all(vn[f]))?(Bits){0,0}:mask[j][f];u64(&b,v.lo,8);if(mw==2)u64(&b,v.hi,8);}u64(&b,(unsigned long long)(nu*nh),4);for(int h=0;h<nh;h++)for(int j=0;j<nu;j++){u64(&b,(unsigned long long)j,2);u64(&b,(unsigned long long)h,1);u64(&b,(unsigned long long)unit_label[j][h],2);u64(&b,1,2);}return b;}
static np_buf model_json(void){np_buf b={0};np_puts(&b,"{\"H\":");number(&b,nu);np_puts(&b,",\"b1\":[");for(int j=0;j<nu;j++){if(j)np_puts(&b,",");int lit=0;for(int f=0;f<nf;f++)if(!beq(mask[j][f],all(vn[f])))lit++;number(&b,1-lit);}np_puts(&b,"],\"feeds\":[");for(int f=0;f<nf;f++)for(int v=0;v<vn[f];v++){if(f||v)np_puts(&b,",");np_puts(&b,"[");int first=1;for(int j=0;j<nu;j++)if(!beq(mask[j][f],all(vn[f]))&&has(mask[j][f],v)){if(!first)np_puts(&b,",");number(&b,j);first=0;}np_puts(&b,"]");}np_puts(&b,"],\"heads\":[");for(int h=0;h<nh;h++){if(h)np_puts(&b,",");np_puts(&b,"[");qstr(&b,hn[h]);np_puts(&b,",[");for(int c=0;c<cn[h];c++){if(c)np_puts(&b,",");qstr(&b,hv[h][c]);}np_puts(&b,"]]");}np_puts(&b,"],\"maxlogit\":1,\"offs\":[");int off=0;for(int f=0;f<nf;f++){if(f)np_puts(&b,",");number(&b,off);off+=vn[f];}np_puts(&b,"],\"stage\":");qstr(&b,name);np_puts(&b,",\"w2\":{");for(int h=0;h<nh;h++){if(h)np_puts(&b,",");qstr(&b,hn[h]);np_puts(&b,": [");for(int j=0;j<nu;j++){if(j)np_puts(&b,",");np_puts(&b,"[[");number(&b,unit_label[j][h]);np_puts(&b,",1]]");}np_puts(&b,"]");}np_puts(&b,"}}");return b;}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN gold-partition-material requires Linux/x86_64 LP64\n",stderr);return 3;
#endif
 int verify=argc==5&&tx_eq(argv[1], "--verify", 1L << 20);if(argc!=5||(!verify&&!tx_eq(argv[1], "prepare", 1L << 20))||sizeof(long)!=8||!realpath(argv[2],root)||strlen(argv[3])>=sizeof name||argv[4][0]!='/'||strlen(argv[4])>=sizeof mat||strpbrk(argv[3],"/\\\r\n\t")||strpbrk(argv[4],"\r\n\t"))die("usage-prepare-or-verify-ROOT-NAME-ABS-MAT");copy_fit(name,sizeof name,argv[3]);copy_fit(mat,sizeof mat,argv[4]);char rel[200];int z=snprintf(rel,sizeof rel,"weights/gold/%s.tsv",name);if(z<0||z>=(int)sizeof rel)die("gold-path");path(gold_path,root,rel);path(tool_path,root,"tools/gold-partition-material.cx");path(product_path,root,"unisacc.com");size_t gn,tn,pn;char *gold=load(gold_path,&gn),*tool=load(tool_path,&tn),*product=load(product_path,&pn);char gh[65],th[65],ph[65];cx_sha256_hex(gold,gn,gh);cx_sha256_hex(tool,tn,th);cx_sha256_hex(product,pn,ph);free(tool);free(product);parse(gold,gn);construct();np_buf wb=weights(),jb=model_json();char wh[65],jh[65];cx_sha256_hex(wb.p,wb.n,wh);cx_sha256_hex(jb.p,jb.n,jh);np_buf rec={0};np_puts(&rec,"gold-partition-material-v1\nstatus\tPREPARED\nscope\tcomplete-one-to-three-field-gold-to-disjoint-integer-net-no-product-install\nstage\t");np_puts(&rec,name);np_puts(&rec,"\ngold-sha256\t");np_puts(&rec,gh);np_puts(&rec,"\ntool-sha256\t");np_puts(&rec,th);np_puts(&rec,"\nproduct-sha256\t");np_puts(&rec,ph);np_puts(&rec,"\nweights-sha256\t");np_puts(&rec,wh);np_puts(&rec,"\nmodel-json-sha256\t");np_puts(&rec,jh);np_puts(&rec,"\nkeys\t");number(&rec,nrows);np_puts(&rec,"\nunits\t");number(&rec,nu);np_puts(&rec,"\nheads\t");number(&rec,nh);np_puts(&rec,"\n");if(!verify&&mkdir(mat,0700))die("fresh-material-required");const char *files[]={"weights.bin","model.json","material.tsv"};const np_buf *buf[]={&wb,&jb,&rec};for(int i=0;i<3;i++){char p[4400];path(p,mat,files[i]);if(verify)equal(p,buf[i]);else save(p,buf[i]->p,buf[i]->n);}size_t after_n;char *after=load(gold_path,&after_n);char after_h[65];cx_sha256_hex(after,after_n,after_h);free(after);if(!tx_eq(gh, after_h, 1L << 20))die("gold-changed-during-construction");free(gold);free(wb.p);free(jb.p);free(rec.p);printf("%s\tgold-partition-material\tstage=%s\tkeys=%d\tunits=%d\theads=%d\tweights=%s\n",verify?"VERIFIED":"PREPARED",name,nrows,nu,nh,wh);return 0;
}
