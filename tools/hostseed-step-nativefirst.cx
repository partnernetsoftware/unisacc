/* Explicit fixed-P3 driver lineage with native-first source measurement.
 * This is not complete host-seed/N22; the host compiler and P3 NN/ASM binary
 * inputs remain declared dependencies. V1 receipts stay with hostseed-step.cx.
 * --bootstrap-ident ROOT NEW_CONTEXT CC PRIOR_NATIVE_HELPER
 * --bootstrap-ident-cx ROOT NEW_CONTEXT CC PRIOR_NATIVE_HELPER
 * The CX form records both the pinned legacy measurement and its projection,
 * and separately binds the CX-inclusive source measurement. This is an
 * endpoint observation, not a full identity-algorithm migration certificate.
 * --bootstrap-host ROOT CONTEXT
 * ROOT CONTEXT native|ape BUILDER MODELS PAYLOAD STAGE slice-OS/ARCH|wrap
 * --verify-chain ROOT CONTEXT MODELS PAYLOAD STAGE1 STAGE2 STAGE3
 * One mutation step per caller-owned tools/bound 55 command. NN and packaged
 * ASM kernels remain declared binary trust inputs, never claimed rebuilt.
 */
#pragma unisa use cxlib.netpack
static char root[4096],ctx[4096],ccpath[4096],prior_helper[4096],bound[4400],helper[4400],host[4400],self[4400];
