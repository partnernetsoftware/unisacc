static const char *host_flags="modules:-O2 -x c -include include/cx.h -c;link:-O2 -Wall -Wextra compiler.c output-host.o deps-host.o input-host.o path-host.o args-host.o cli-host.o compat-host.o environment-host.o archive-host.o route-host.o codec-host.o footer-host.o attrframe-host.o modelnumber-host.o lifetime-host.o modeldecode-host.o packagelifetime-host.o packagedecode-host.o transition-host.o execution-host.o alu-host.o stack-host.o coreoutput-host.o sparse-host.o bytes-host.o sourceframe-host.o tapelink-host.o asmtext-host.o fwdstub-host.o;decode:-include exec/c/model_decode_host.h;package-decode:-include exec/c/package_decode_host.h;execution:-O2 -x c -include include/cx.h -c";
static const char *wrap_libz_path="/usr/lib/x86_64-linux-gnu/libz.so.1.2.11";
static const char *wrap_libz_pin="64c206f0146cc58bbddc4f22054436f4ff278f5a554aa3ce6921ddf7e9133370";
static const char *targets[]={"win/x86_64","lnx/x86_64","lnx/arm64","osx/x86_64","osx/arm64"};
static const char *files[]={"slice-win-x86_64","slice-lnx-x86_64","slice-lnx-arm64","slice-osx-x86_64","slice-osx-arm64"};
static void boundary(void){puts("NOT_CLAIMED\thermetic-host-build-NN-or-ASM-kernel-source-rebuild-complete-N22-or-foreign-hosts");}
typedef struct {char *s;size_t n;char hash[65];char *schema,*key[32],*value[32];int count;} HsRecord;
static void die(const char *reason){fprintf(stderr,"hostseed-step: REFUSE %s errno=%d\n",reason,errno);exit(2);}
static void copy_fit(char *dst,size_t cap,const char *src){size_t i=0;if(!cap)die("copy-bound");while(src[i]&&i+1<cap){dst[i]=src[i];i++;}if(src[i])die("copy-bound");dst[i]=0;}
static void path(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path-bound");}
static void clean(const char *p){if(!p[0]||strpbrk(p,"\r\n\t"))die("unclean-path");}
static char *load(const char *p,size_t *n){struct stat a,b;errno=0;if(lstat(p,&a))die(errno==ENOENT?"input-absent":"input-stat");if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>134217728)die("bounded-regular-input");int fd=open(p,O_RDONLY|O_CLOEXEC|O_NOFOLLOW|O_NONBLOCK);if(fd<0||fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size)die("input-descriptor");*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s)die("allocation");size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("read-extent");at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int bad=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(z||bad||closed)die("input-changed");s[*n]=0;return s;}
static void hash(const char *p,char h[65]){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,h);free(s);}
static void wrap_deps(void){
 const char *paths[]={"/usr/include/node/zlib.h","/usr/include/node/zconf.h",wrap_libz_path};
 const char *pins[]={"71e0dcf4cacb6b1674550a3d9407344746d27cdce739e6e25189d0b620b005ed","3f928c8266fadd24f1f351422e68d2dfb8944ae35d8a8c51b7d591ab9ec962ef",wrap_libz_pin};
 for(int i=0;i<3;i++){char h[65];hash(paths[i],h);if(strcmp(h,pins[i]))die("self-wrap-zlib-input-changed");}
}
static void absent(const char *p){struct stat st;errno=0;if(!lstat(p,&st)||errno!=ENOENT)die("exclusive-output-required");}
static void save(const char *p,const char *s,size_t n){int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive-record");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("record-write");at+=(size_t)z;}int synced=fsync(fd),closed=close(fd);if(synced||closed)die("record-close");}
static void wrap_links(const char *dir,int create){char p[4400],link[4400],actual[4400],value[4400];path(p,dir,"wrap-link");if(create&&mkdir(p,0700))die("exclusive-wrap-link-directory");struct stat st;if(lstat(p,&st)||!S_ISDIR(st.st_mode)||((st.st_mode&0777)!=0700))die("wrap-link-directory");const char *names[]={"libz.so","libz.so.1"};for(int i=0;i<2;i++){path(link,p,names[i]);if(create&&symlink(wrap_libz_path,link))die("wrap-link-symlink");if(lstat(link,&st)||!S_ISLNK(st.st_mode))die("wrap-link-kind");ssize_t n=readlink(link,value,sizeof value-1);if(n<0||(size_t)n>=sizeof value-1)die("wrap-link-target-size");value[n]=0;if(strcmp(value,wrap_libz_path)||!realpath(link,actual)||strcmp(actual,wrap_libz_path))die("wrap-link-target");}DIR *d=opendir(p);if(!d)die("wrap-link-open");int seen=0;for(;;){errno=0;struct dirent *e=readdir(d);if(!e){int err=errno,closed=closedir(d);if(err||closed)die("wrap-link-read-or-close");break;}if(!strcmp(e->d_name,".")||!strcmp(e->d_name,".."))continue;int match=-1;for(int i=0;i<2;i++)if(!strcmp(e->d_name,names[i]))match=i;if(match<0||(seen&(1<<match)))die("wrap-link-extra-or-duplicate");seen|=1<<match;}if(seen!=3)die("wrap-link-missing");}
static void wrap_trace_check(const char *dir,const char *s,size_t n){if(!n||n>65536||memchr(s,0,n))die("wrap-loader-trace-bounds");char a[4400],b[4400];path(a,dir,"wrap-link/libz.so");path(b,dir,"wrap-link/libz.so.1");size_t at=0;int hits=0;while(at<n){size_t end=at;while(end<n&&s[end]!='\n')end++;size_t len=end-at;if(len>=8192)die("wrap-loader-trace-line-bound");char line[8192];{size_t i=0;while(i<len){line[i]=s[at+i];i++;}line[len]=0;}char *p=strstr(line,"calling init: ");if(p&&strstr(p,"libz.so")){p+=strlen("calling init: ");while(*p==' '||*p=='\t')p++;char *stop=p+strlen(p);while(stop>p&&(stop[-1]==' '||stop[-1]=='\t'||stop[-1]=='\r'))*--stop=0;char actual[4400];if((strcmp(p,a)&&strcmp(p,b))||!realpath(p,actual)||strcmp(actual,wrap_libz_path))die("wrap-loader-libz-path-not-pinned");hits++;}at=end<n?end+1:end;}if(hits!=1)die("wrap-loader-libz-trace-count");}
static void wrap_observation(const char *dir,char trace_sha[65]){char p[4400],libz[65];wrap_deps();wrap_links(dir,0);hash(wrap_libz_path,libz);if(strcmp(libz,wrap_libz_pin))die("wrap-libz-content-changed");path(p,dir,"wrap-libz.trace");size_t n;char *s=load(p,&n);wrap_trace_check(dir,s,n);cx_sha256_hex(s,n,trace_sha);free(s);}
static void equal_record(const char *p,const np_buf *expected){size_t n;char *s=load(p,&n);int ok=n==expected->n&&!memcmp(s,expected->p,n);free(s);if(!ok)die("receipt-bytes-mismatch");}
static HsRecord read_record(const char *p,const char *schema){HsRecord r={0};r.s=load(p,&r.n);cx_sha256_hex(r.s,r.n,r.hash);if(!r.n||r.s[r.n-1]!='\n'||memchr(r.s,0,r.n)||memchr(r.s,'\r',r.n))die("receipt-wire");char *line=r.s,*end=strchr(line,'\n');*end=0;r.schema=line;if(strcmp(line,schema))die("receipt-schema");line=end+1;while(*line){end=strchr(line,'\n');if(!end||r.count==32)die("receipt-row");*end=0;char *tab=strchr(line,'\t');if(!tab||strchr(tab+1,'\t')||tab==line||!tab[1])die("receipt-field");*tab=0;for(int i=0;i<r.count;i++)if(!strcmp(r.key[i],line))die("receipt-duplicate");r.key[r.count]=line;r.value[r.count++]=tab+1;line=end+1;}return r;}
static const char *field(const HsRecord *r,const char *key){for(int i=0;i<r->count;i++)if(!strcmp(r->key[i],key))return r->value[i];die("receipt-missing-field");return "";}
static void row(np_buf *b,const char *k,const char *v){np_puts(b,k);np_puts(b,"\t");np_puts(b,v);np_puts(b,"\n");}
static np_result call(char **v,int seconds){char why[1024];if(unsetenv("UNISACC_RF_CAPTURE")||unsetenv("UNISA_ATTRIBUTES"))die("clear-ambient-resource-state");np_result r;if(np_run(v,root,0,seconds+2,&r,why,sizeof why))die(why);return r;}
static void command(char **v,int seconds,const char *evidence){char p[4600];np_buf command_identity={0};for(int i=0;v[i];i++){clean(v[i]);char index[40];{int iz=snprintf(index,sizeof index,"arg-%d",i);if(iz<0||(size_t)iz>=sizeof index)die("evidence-path");}row(&command_identity,index,v[i]);}int az=snprintf(p,sizeof p,"%s.argv.tsv",evidence);if(az<0||(size_t)az>=sizeof p)die("evidence-path");save(p,command_identity.p,command_identity.n);free(command_identity.p);np_result r=call(v,seconds);int n=snprintf(p,sizeof p,"%s.stdout",evidence);if(n<0||(size_t)n>=sizeof p)die("evidence-path");save(p,r.out,r.outn);n=snprintf(p,sizeof p,"%s.stderr",evidence);if(n<0||(size_t)n>=sizeof p)die("evidence-path");save(p,r.err,r.errn);char status[40];n=snprintf(status,sizeof status,"rc\t%d\n",r.rc);{int zn=snprintf(p,sizeof p,"%s.status",evidence);if(zn<0||(size_t)zn>=sizeof p)die("evidence-path");}save(p,status,(size_t)n);if(r.errn)fwrite(r.err,1,r.errn,stderr);int rc=r.rc;np_free(&r);if(rc)die("child-step-failed");}
static void wrap_command(char **v,const char *dir,const char *evidence){char p[4600],link_dir[4400],libz_before[65],libz_after[65];wrap_deps();wrap_links(dir,1);path(link_dir,dir,"wrap-link");hash(wrap_libz_path,libz_before);np_buf identity={0};for(int i=0;v[i];i++){clean(v[i]);char index[40];{int iz=snprintf(index,sizeof index,"arg-%d",i);if(iz<0||(size_t)iz>=sizeof index)die("evidence-path");}row(&identity,index,v[i]);}int z=snprintf(p,sizeof p,"%s.argv.tsv",evidence);if(z<0||(size_t)z>=sizeof p)die("evidence-path");save(p,identity.p,identity.n);free(identity.p);const char *clear[]={"LIBRARY_PATH","LD_LIBRARY_PATH","LD_PRELOAD","LD_AUDIT","LD_DEBUG","LD_DEBUG_OUTPUT"};for(int i=0;i<6;i++)if(unsetenv(clear[i]))die("wrap-clear-ambient-loader");if(setenv("LIBRARY_PATH",link_dir,1)||setenv("LD_LIBRARY_PATH",link_dir,1)||setenv("LD_DEBUG","libs",1))die("wrap-controlled-loader");np_result r=call(v,40);for(int i=0;i<6;i++)if(unsetenv(clear[i]))die("wrap-clear-controlled-loader");z=snprintf(p,sizeof p,"%s.stdout",evidence);if(z<0||(size_t)z>=sizeof p)die("evidence-path");save(p,r.out,r.outn);char status[40];z=snprintf(status,sizeof status,"rc\t%d\n",r.rc);if(z<0||(size_t)z>=sizeof status)die("wrap-status-bound");{int zn=snprintf(p,sizeof p,"%s.status",evidence);if(zn<0||(size_t)zn>=sizeof p)die("evidence-path");}save(p,status,(size_t)z);if(r.rc){{int zn=snprintf(p,sizeof p,"%s.stderr",evidence);if(zn<0||(size_t)zn>=sizeof p)die("evidence-path");}save(p,r.err,r.errn);if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);die("child-step-failed");}wrap_trace_check(dir,r.err,r.errn);path(p,dir,"wrap-libz.trace");save(p,r.err,r.errn);{int zn=snprintf(p,sizeof p,"%s.stderr",evidence);if(zn<0||(size_t)zn>=sizeof p)die("evidence-path");}save(p,"",0);np_free(&r);hash(wrap_libz_path,libz_after);if(strcmp(libz_before,libz_after)||strcmp(libz_after,wrap_libz_pin))die("wrap-libz-content-changed");char trace_sha[65];wrap_observation(dir,trace_sha);}
static void measure(char h[65],const char *native){char product[4400],ident[4400];path(product,root,"unisacc.com");path(ident,root,"seed/ident.c");char *v[10];int n=0;v[n++]=bound;v[n++]=native?"6":"12";if(native)v[n++]=(char *)native;else{v[n++]="sh";v[n++]=product;v[n++]=ident;v[n++]="--";}v[n++]=root;v[n]=0;np_result r=call(v,native?6:12);int ok=!r.rc&&!r.errn&&r.outn==65&&r.out[64]=='\n';if(ok){memcpy(h,r.out,64);h[64]=0;for(int i=0;i<64;i++)if(!((h[i]>='0'&&h[i]<='9')||(h[i]>='a'&&h[i]<='f')))ok=0;}np_free(&r);if(!ok)die("source-identity-measurement");}
static void measure_projection(char h[65]){char *v[]={bound,"6",helper,root,"legacy-projection",0};np_result r=call(v,6);int ok=!r.rc&&!r.errn&&r.outn==65&&r.out[64]=='\n';if(ok){memcpy(h,r.out,64);h[64]=0;for(int i=0;i<64;i++)if(!((h[i]>='0'&&h[i]<='9')||(h[i]>='a'&&h[i]<='f')))ok=0;}np_free(&r);if(!ok)die("legacy-projection-measurement");}
static np_result version(void){char *v[]={bound,"2",ccpath,"--version",0};np_result r=call(v,2);if(r.rc||r.errn||!r.outn||r.outn>65536)die("host-CC-version");return r;}
static void resolve_cc(const char *arg){clean(arg);if(arg[0]!='/'||!realpath(arg,ccpath))die("explicit-absolute-CC-realpath-required");clean(ccpath);if(access(ccpath,X_OK))die("CC-not-executable");hash(ccpath,cc_sha);np_result r=version();cx_sha256_hex(r.out,r.outn,cc_version_sha);np_free(&r);}
static void setup(const char *r,const char *c){if(!realpath(r,root))die("root-realpath");clean(root);clean(c);if(c[0]!='/'||strlen(c)>=sizeof ctx)die("absolute-context-required");copy_fit(ctx,sizeof ctx,c);path(bound,root,"tools/bound");path(helper,ctx,"identity-helper");path(host,ctx,"HOST");path(self,root,"tools/hostseed-step-nativefirst.cx");hash(self,tool_sha);}
static np_buf ident_record(void){np_buf b={0};np_puts(&b,identity_bridge?"hostseed-ident-v4\n":"hostseed-ident-v3\n");row(&b,"source",source_sha);if(identity_bridge){row(&b,"source-algorithm","cx-source-v2");row(&b,"legacy-source",legacy_source_sha);row(&b,"legacy-algorithm","pinned-prior-v1");}row(&b,"cc",ccpath);row(&b,"cc-sha",cc_sha);row(&b,"cc-version-sha",cc_version_sha);row(&b,"prior-helper-path",prior_helper);row(&b,"prior-helper-sha",prior_helper_sha);row(&b,"helper",helper_sha);row(&b,"helper-source",helper_source_sha);row(&b,"flags",ident_flags);row(&b,"measurement-bootstrap",bootstrap_sha);row(&b,"measurement-bootstrap-kind",identity_bridge?"prior-v1-projection-and-fresh-v2-APE-confirmation":"prior-native-baseline-fresh-native-and-APE-confirmation");row(&b,"tool",tool_sha);row(&b,"CC-subtools-and-system-libraries","DECLARED-HOST-DEPENDENCIES-NOT-INDEPENDENTLY-HASHED");return b;}
static void prior(const char *p){char actual[4096];clean(p);if(p[0]!='/'||strlen(p)>=sizeof prior_helper||!realpath(p,actual)||strcmp(p,actual))die("prior-helper-canonical-path");copy_fit(prior_helper,sizeof prior_helper,p);hash(prior_helper,prior_helper_sha);if(strcmp(prior_helper_sha,prior_helper_pin))die("prior-helper-content-pin");}
static void bootstrap_ident(const char *cc,const char *oldhelper){char before[65],after[65],fresh_before[65],p[4400],evidence[4400];resolve_cc(cc);prior(oldhelper);path(p,root,"seed/ident.c");hash(p,helper_source_sha);path(p,root,"unisacc.com");hash(p,bootstrap_sha);measure(before,prior_helper);if(identity_bridge){copy_fit(legacy_source_sha,sizeof legacy_source_sha,before);measure(fresh_before,0);}else copy_fit(source_sha,sizeof source_sha,before);if(mkdir(ctx,0700))die("new-context-required");np_result ver=version();cx_sha256_hex(ver.out,ver.outn,after);if(strcmp(after,cc_version_sha))die("CC-version-changed-before-ident-build");path(p,ctx,"cc.version");save(p,ver.out,ver.outn);np_free(&ver);path(p,root,"seed/ident.c");path(evidence,ctx,"bootstrap-ident");char *v[]={bound,"15",ccpath,"-std=c99","-D_POSIX_C_SOURCE=200809L","-O2","-w",p,"-o",helper,0};absent(helper);command(v,15,evidence);hash(helper,helper_sha);measure(after,helper);if(identity_bridge){if(strcmp(fresh_before,after))die("cx-source-changed-during-ident-build");copy_fit(source_sha,sizeof source_sha,after);measure_projection(after);if(strcmp(before,after))die("identity-algorithm-projection-mismatch");}else if(strcmp(before,after))die("source-changed-during-ident-build");measure(after,0);if(strcmp(source_sha,after))die("native-vs-installed-source-identity");measure(after,prior_helper);if(strcmp(before,after))die("prior-source-changed-during-ident-build");path(p,root,"seed/ident.c");hash(p,after);if(strcmp(after,helper_source_sha))die("identity-helper-source-changed");hash(ccpath,after);if(strcmp(after,cc_sha))die("CC-changed");hash(prior_helper,after);if(strcmp(after,prior_helper_sha))die("prior-helper-changed");ver=version();cx_sha256_hex(ver.out,ver.outn,after);np_free(&ver);if(strcmp(after,cc_version_sha))die("CC-version-changed");hash(self,after);if(strcmp(after,tool_sha))die("tool-changed");path(p,root,"unisacc.com");hash(p,after);if(strcmp(after,bootstrap_sha))die("measurement-bootstrap-changed");np_buf b=ident_record();path(p,ctx,"context.tsv");save(p,b.p,b.n);free(b.p);puts(identity_bridge?"PREPARED\thostseed-ident-v4\tlegacy-projection-and-CX-native-APE\tno-test-result":"PREPARED\thostseed-ident\tprior-native-baseline-fresh-native-and-APE-confirmation\tno-test-result");}
static void check_context(void){char p[4400],now[65],before[65],confirmed[65];wrap_deps();path(p,ctx,"context.tsv");size_t wire_n;char *wire=load(p,&wire_n);identity_bridge=wire_n>=18&&!memcmp(wire,"hostseed-ident-v4\n",18);free(wire);HsRecord r=read_record(p,identity_bridge?"hostseed-ident-v4":"hostseed-ident-v3");if(r.count!=(identity_bridge?16:13))die("context-shape");const char *s=field(&r,"cc");if(strlen(s)>=sizeof ccpath||s[0]!='/')die("context-CC-path");copy_fit(ccpath,sizeof ccpath,s);prior(field(&r,"prior-helper-path"));copy_fit(context_sha,sizeof context_sha,r.hash);hash(ccpath,cc_sha);hash(helper,helper_sha);path(p,root,"seed/ident.c");hash(p,helper_source_sha);path(p,ctx,"cc.version");hash(p,cc_version_sha);path(p,root,"unisacc.com");hash(p,bootstrap_sha);measure(before,prior_helper);measure(source_sha,helper);measure(confirmed,0);if(identity_bridge){copy_fit(legacy_source_sha,sizeof legacy_source_sha,before);measure_projection(now);if(strcmp(before,now))die("identity-algorithm-projection-mismatch");if(strcmp(source_sha,confirmed))die("fresh-and-installed-source-disagree");}else if(strcmp(before,source_sha)||strcmp(before,confirmed))die("prior-fresh-and-installed-source-disagree");np_buf expected=ident_record();path(p,ctx,"context.tsv");equal_record(p,&expected);free(expected.p);free(r.s);hash(self,now);if(strcmp(now,tool_sha))die("tool-changed");}
static np_buf host_record(void){np_buf b={0};np_puts(&b,"hostseed-host-v1\n");row(&b,"source",source_sha);row(&b,"context",context_sha);row(&b,"cc",cc_sha);row(&b,"cc-version",cc_version_sha);row(&b,"flags",host_flags);row(&b,"artifact",host_sha);row(&b,"core","C-core-no-UNISA_CORE_BLOB-no-ASM-defines");return b;}
static void check_host(void){hash(host,host_sha);np_buf b=host_record();char p[4400];path(p,ctx,"host.tsv");equal_record(p,&b);hash(p,host_record_sha);free(b.p);}
