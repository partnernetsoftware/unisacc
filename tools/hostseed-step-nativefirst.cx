 else die("unknown-step");path(evidence,dir,label);command(v,40,evidence);
completed:;
 char after_m[65],after_p[65],after_b[65],after_ps[65],after_parent[4400],after_observation[65],after_anchor[65];check_context();check_host();if(strcmp(before,source_sha))die("source-changed-during-stage");parent_anchor(after_anchor);if(strcmp(anchor,after_anchor))die("stage-anchor-changed");fixed_payload(models,payload,after_m,after_p);parent_receipt(kind,builder,models,payload,after_m,after_p,after_b,after_ps,after_parent,after_observation);if(strcmp(mh,after_m)||strcmp(ph,after_p)||strcmp(bh,after_b)||strcmp(ps,after_ps)||strcmp(parent,after_parent)||strcmp(observation,after_observation))die("stage-input-changed");np_buf final=stage_record(kind,builder,models,payload,mh,ph,bh,parent,ps);path(p,dir,"stage.tsv");equal_record(p,&final);free(final.p);if(!strcmp(step,"wrap")){for(int i=0;i<5;i++){char s[80];{int zn=snprintf(s,sizeof s,"slice-%s",targets[i]);if(zn<0||(size_t)zn>=sizeof s)die("step-label");}path(p,dir,files[i]);artifact(p,stsha,s,bh,ps,1);}}artifact(output,stsha,step,bh,ps,0);printf("PREPARED\thostseed-step\t%s\tfixed-P3-declared-kernel-input\tno-test-result\n",step);
}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN hostseed-step draft supports Linux/x86_64 host only\n",stderr);return 3;
#endif
 if(argc==6&&!strcmp(argv[1],"--bootstrap-ident")){setup(argv[2],argv[3]);bootstrap_ident(argv[4],argv[5]);boundary();return 0;}if(argc==4&&!strcmp(argv[1],"--bootstrap-host")){setup(argv[2],argv[3]);bootstrap_host();boundary();return 0;}
 if(argc==6&&!strcmp(argv[1],"--bootstrap-ident-cx")){identity_bridge=1;setup(argv[2],argv[3]);bootstrap_ident(argv[4],argv[5]);boundary();return 0;}
 if(argc==9&&!strcmp(argv[1],"--verify-chain")){setup(argv[2],argv[3]);clean(argv[4]);clean(argv[5]);if(argv[4][0]!='/'||argv[5][0]!='/')die("absolute-models-and-payload-required");check_context();check_host();char before[65];copy_fit(before,sizeof before,source_sha);const char *builder=host,*kind="native";char parent[4400];for(int i=6;i<9;i++){clean(argv[i]);if(argv[i][0]!='/')die("absolute-stage-required");stage(kind,builder,argv[4],argv[5],argv[i],"",1);path(parent,argv[i],"unisacc-seed.com");builder=parent;kind="ape";}check_context();check_host();if(strcmp(before,source_sha))die("source-changed-during-chain-verification");puts("VERIFIED\thostseed-fixed-P3-chain\tstages=3\tno-N22-no-test-result");boundary();return 0;}
 if(argc!=9)die("usage bootstrap-ident|bootstrap-host or ROOT CONTEXT KIND BUILDER MODELS PAYLOAD STAGE STEP");setup(argv[1],argv[2]);for(int i=4;i<=7;i++){clean(argv[i]);if(argv[i][0]!='/')die("absolute-input-and-stage-required");}check_context();check_host();stage(argv[3],argv[4],argv[5],argv[6],argv[7],argv[8],0);boundary();return 0;
}
