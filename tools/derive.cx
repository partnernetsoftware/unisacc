/* tools/derive.cx -- 派生物总闸:按 exec/facts/derive.tsv 清单对各生成器跑 --check(同 order 并发)或 --write(串行,失败还原)。
 *
 *   sh ./unisacc.com tools/derive.cx -- --check|--write [--only NAME,...] [--changed PATH...] [--index] [--manifest FILE] [--full] [--input-facts FILE] [--cache-dir DIR]
 * --write uses content identities from tools/derive-inputs.tsv in addition to the manifest input globs.
 * Unchanged inputs and all current output bytes produce IDENTICAL (artifact identity, never a cached test PASS).
 * Generator/runtime/closure versions are part of the key. Unknown closures always rebuild. --full forces a write;
 * --check always recomputes all selected generators and never consumes or writes the identity cache.
 *
 * 清单列(8 列,制表符分隔,# 行为注释):name generator check_argv write_argv outputs inputs_glob order bound_s。
 *   check_argv/write_argv 以空格分词,write_argv 为 - 表示不自动写(只报 NEEDS_BUMP;仓内清单已无此类行:
 *   layer-api 行的 write_argv 是 layer-api.cx --bump-pending,回写 build/tlib-packages.tsv 的 version、api_sha、frozen,
 *   所以一次接口变更的修复就是 git add 包源后一条 derive.cx -- --write;破坏性变更被 layer-api 拒写,本轮全部还原,rc 2);
 *   outputs 以空格分隔,末尾带 / 的是目录(只管其下一层文件);inputs_glob 以空格分隔,* 匹配任意字符(含 /);
 *   bound_s 为 - 时取 30。每个子进程都经 ./tools/bound bound_s 启动。
 * --check   只读。order 相同的行并发(最多 4 路),order 小的先跑。生成器 rc 0 记 OK,1 记 DRIFT,142(bound 超时)记 TIMEOUT,其它记 REFUSED。
 * --write   按 order 串行。先快照该行登记的 outputs,生成器非 0 就把本轮已写的全部还原(原本不存在的文件删掉)并 rc 2,其后的行记 NOTRUN;
 *           write_argv 为 - 的行改跑 check_argv,有漂移记 NEEDS_BUMP。只碰清单登记的 outputs。
 * --only    只跑列出的名字;--changed 只跑 inputs_glob 命中任一 PATH 的行;--index 额外选中 tool-index 行。未选中的记 SKIPPED,不记 OK。
 * 输出:每行一条 DERIVE<TAB>name<TAB>status<TAB>ms[<TAB>rc=N<TAB>生成器末行],末行
 *   DERIVE_SUMMARY<TAB>ok=<TAB>drift=<TAB>refused=<TAB>skipped=<TAB>elapsed_ms=
 * 退出码:0 全清;1 有漂移(--check 的 DRIFT,或 --write 后仍有 NEEDS_BUMP);2 生成器拒绝或超时(DERIVE 行指名)、清单坏行(REFUSE<TAB>清单<TAB>line=N<TAB>原因)或用法错。
 * precommit 对接(设计说明,本工具不改 tools/precommit.cx):提交前由 precommit 以暂存路径调用
 *   derive.cx -- --check --changed <暂存路径...>,只跑输入被改到的生成器;rc 1 提示先 derive --write --only NAME 再提交,rc 2 直接拦下;
 *   新增或删除 tools/ 下文件时加 --index。全量 --check 留给慢车道与 CI。
 * Check: tools/check-derive.cx. */
#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.poll
#pragma unisa use sys.time
#pragma unisa use sys.posix
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use sys.sha
#pragma unisa use sys.env

#define MAXR 64
#define MAXTOK 40
#define MAXSNAP 512
enum { ST_SKIPPED, ST_OK, ST_DRIFT, ST_REFUSED, ST_TIMEOUT, ST_WROTE, ST_NEEDS_BUMP, ST_NOTRUN, ST_IDENTICAL };
static const char *stname[] = {"SKIPPED", "OK", "DRIFT", "REFUSED", "TIMEOUT", "WROTE", "NEEDS_BUMP", "NOTRUN", "IDENTICAL"};
typedef struct {
    char name[64], gen[200], chk[500], wr[500], outs[700], ins[700];
    int order, bound, sel, pid, fd, rc, status, done;
    char *out; long n, cap, t0, ms;
} Row;
static Row rows[MAXR]; static int nr, ord[MAXR];
typedef struct { char path[700]; char *data; long n; int existed; } Snap;
static Snap snaps[MAXSNAP]; static int nsnap;
static char *snapdirs[MAXR * 4]; static int nsnapdir;

static int seq(const char *a, const char *b) { long n = tx_len(a, 4096); return n == tx_len(b, 4096) && mm_same(a, b, n); }
static int glob(const char *g, long gn, const char *s, long sn) {
    while (gn > 0) {
        if (g[0] == '*') { long k; for (k = 0; k <= sn; k++) if (glob(g + 1, gn - 1, s + k, sn - k)) return 1; return 0; }
        if (sn <= 0 || g[0] != s[0]) return 0;
        g++; gn--; s++; sn--;
    }
    return sn == 0;
}
/* Build artifacts only: no check verdict is stored or reused. --check always recomputes.
 * A hit requires the current input closure AND every output byte to match a completed write.
 * Unmodelled generators, unreadable paths and unsupported directory links rebuild normally. */
typedef struct {char name[64], ins[2048], outs[512];int git;} CacheFact;
static CacheFact cf[MAXR+1];static int ncf;
static const char *cache_dir, *input_facts="tools/derive-inputs.tsv";
static char *cache_facts_bytes;static int cache_full;
static char *hp[32768];static int nhp,hbad,houtputs;static char hbytes[8<<20];static long hn;
static char hstack[128][4400];static int hdepth;
static void hput(const char*s){long n=strlen(s);char len[40];int k=snprintf(len,sizeof len,"%ld:",n);if(k<0||k>=(int)sizeof len||hn+n+k+2>=(long)sizeof hbytes){hbad=1;return;}if(mm_copy(hbytes+hn,sizeof hbytes-hn,len,k)){hbad=1;return;}hn+=k;if(mm_copy(hbytes+hn,sizeof hbytes-hn,s,n)){hbad=1;return;}hn+=n;hbytes[hn++]='\n';hbytes[hn]=0;}
static void hadd(const char*p){if(nhp==32768){hbad=1;return;}long n=strlen(p)+1;hp[nhp]=mm_alloc(n);if(!hp[nhp]){hbad=1;return;}if(mm_copy(hp[nhp],n,p,n))hbad=1;nhp++;}
static void hwalk(const char*p,const char*pattern){sy_stat_t st;int rc=sy_lstat(p,&st);
    if(rc==-ENOENT)return;if(rc){sy_eprintf("DERIVE_IDENTITY_UNAVAILABLE\t%s\terrno=%d\n",p,rc);hbad=1;return;}
    if(st.kind=='l'){sy_stat_t target;char real[4400];if(sy_stat(p,&target)||sy_realpath(p,real,sizeof real)<0){hbad=1;return;}if(target.kind=='d'){hadd(p);hwalk(real,0);}else if(target.kind=='f'&&(!pattern||glob(pattern,strlen(pattern),p,strlen(p))))hadd(p);else if(target.kind!='f')hbad=1;return;}
    if(st.kind=='d'){sy_dir_t d;char real[4400];if(hdepth==128||sy_realpath(p,real,sizeof real)<0){hbad=1;return;}for(int i=0;i<hdepth;i++)if(!strcmp(real,hstack[i]))return;
        if(mm_copy(hstack[hdepth],sizeof hstack[hdepth],real,strlen(real)+1)){hbad=1;return;}hdepth++;hadd(p);if(sy_dir_open(&d,p)){hdepth--;hbad=1;return;}int next;
        while((next=sy_dir_next(&d))==1){if(!strcmp(d.name,".")||!strcmp(d.name,".."))continue;char q[4400];if(cx_fmt(q,sizeof q,"%s/%s",p,d.name)){hbad=1;break;}hwalk(q,pattern);if(hbad)break;}if(next<0)hbad=1;sy_dir_close(&d);hdepth--;
    }else if(!pattern||glob(pattern,strlen(pattern),p,strlen(p))){if(st.kind!='f'){hbad=1;return;}hadd(p);}
}
static void hrootglob(const char*pattern){char*o=0;size_t n=0;char*v[]={"git","ls-files","-z","--cached","--others","--exclude-standard",0};if(cx_runv_timeout(v,20,&o,&n)||!o){hbad=1;free(o);return;}for(size_t i=0;i<n;){size_t j=i;while(j<n&&o[j])j++;if(j==n){hbad=1;break;}if(glob(pattern,strlen(pattern),o+i,j-i))hwalk(o+i,0);i=j+1;}free(o);}
static void hwords(const char*words){const char*p=words;while(*p){while(*p==' ')p++;const char*e=p;while(*e&&*e!=' ')e++;if(e==p)break;char w[4400],base[4400];if(e-p>=(long)sizeof w){hbad=1;return;}if(mm_copy(w,sizeof w,p,e-p)){hbad=1;return;}w[e-p]=0;p=e;if(!strcmp(w,"-"))continue;hput(w);
        char*star=strchr(w,'*');if(star){long n=star-w;while(n>0&&w[n-1]!='/')n--;if(!n){hrootglob(w);continue;}else{if(mm_copy(base,sizeof base,w,n)){hbad=1;return;}base[n]=0;if(n>1)base[n-1]=0;}hwalk(base,w);}
        else {sy_stat_t st;int rc=sy_lstat(w,&st);if(rc==-ENOENT){hput("ENOENT");if(houtputs)hbad=1;continue;}if(rc){hbad=1;continue;}hwalk(w,0);}
    }}
static int hcmp(const void*a,const void*b){return strcmp(*(char*const*)a,*(char*const*)b);}
static int hfinish(char hex[65]){qsort(hp,nhp,sizeof hp[0],hcmp);for(int i=0;i<nhp;i++){if(i&& !strcmp(hp[i],hp[i-1]))continue;sy_stat_t st;if(sy_lstat(hp[i],&st)){hbad=1;break;}hput(hp[i]);if(st.kind=='d'){hput("DIR");continue;}if(st.kind=='l'){char link[4400];long k=sy_readlink(hp[i],link,sizeof link-1);if(k<0||k>=(long)sizeof link-1){hbad=1;break;}link[k]=0;hput("LINK");hput(link);if(sy_stat(hp[i],&st)){hbad=1;break;}if(st.kind=='d')continue;}if(st.kind!='f'){hbad=1;break;}size_t n=0;char*b=cx_read(hp[i],&n),fh[65];if(!b||sy_sha256_hex(b,n,fh)){hbad=1;free(b);break;}hput(fh);free(b);}int rc=hbad||sy_sha256_hex(hbytes,hn,hex);for(int i=0;i<nhp;i++)mm_free(hp[i]);nhp=0;hn=0;hbad=0;hdepth=0;return rc;}
static int cf_load(void){cache_facts_bytes=cx_read(input_facts,0);if(!cache_facts_bytes){sy_stat_t st;int rc=sy_lstat(input_facts,&st);if(rc==-ENOENT)return 0;sy_eprintf("DERIVE_IDENTITY_UNAVAILABLE\t%s\terrno=%d\n",input_facts,rc);return 2;}long bn=strlen(cache_facts_bytes)+1;char*b=mm_alloc(bn);if(!b||mm_copy(b,bn,cache_facts_bytes,bn))return 2;
    for(char*p=b;*p;){char*e=strchr(p,'\n');if(e)*e=0;if(*p&&*p!='#'){char*f[4];f[0]=p;int k=1;for(char*q=p;*q;q++)if(*q=='\t'){*q=0;if(k==4)return 2;f[k++]=q+1;}if(k!=4||ncf==MAXR+1||strlen(f[0])>=sizeof cf[0].name||strlen(f[1])>=sizeof cf[0].ins||strlen(f[2])>=sizeof cf[0].outs||(*f[3]&&strcmp(f[3],"git")&&strcmp(f[3],"-")))return 2;
        for(int j=0;j<ncf;j++)if(!strcmp(cf[j].name,f[0]))return 2;if(mm_copy(cf[ncf].name,sizeof cf[ncf].name,f[0],strlen(f[0])+1)||mm_copy(cf[ncf].ins,sizeof cf[ncf].ins,f[1],strlen(f[1])+1)||mm_copy(cf[ncf].outs,sizeof cf[ncf].outs,f[2],strlen(f[2])+1))return 2;cf[ncf++].git=!strcmp(f[3],"git");}if(!e)break;p=e+1;}mm_free(b);return 0;
}
static CacheFact*cf_find(const char*n){for(int i=0;i<ncf;i++)if(!strcmp(cf[i].name,n))return &cf[i];return 0;}
static int identity(Row*r,const char*mf,int output,char hex[65]){CacheFact*f=cf_find(r->name),*common=cf_find("*");if(!f||!common)return 1;houtputs=output;hput("derive-content-v1");hput(r->name);
    if(output){hwords(r->outs);const char*p=f->outs;while(*p){while(*p==' ')p++;const char*e=p;while(*e&&*e!=' ')e++;if(e==p)break;if(!(e-p==1&&*p=='-')){char q[4400];const char*dm=getenv("UNISACC_DEVMETA_DIR");if(cx_fmt(q,sizeof q,"%s/%.*s",dm&&*dm?dm:".devsvc",(int)(e-p),p)){hbad=1;break;}hwords(q);}p=e;}}
    else {hput(cache_facts_bytes);hwords(mf);hwords(common->ins);hwords(r->gen);hwords(r->ins);hwords(f->ins);hput(r->chk);hput(r->wr);
        const char*dm=getenv("UNISACC_DEVMETA_DIR");if(dm&&*dm){char pat[4400];if(cx_fmt(pat,sizeof pat,"%s/*",dm))hbad=1;else hwords(pat);}
        /* Literal command files are generator dependencies too (including fixture scripts). */
        const char*p=r->wr;while(*p){while(*p==' ')p++;const char*e=p;while(*e&&*e!=' ')e++;char w[600];if(e-p>0&&e-p<(long)sizeof w){if(mm_copy(w,sizeof w,p,e-p)){hbad=1;break;}w[e-p]=0;if(sy_is_reg(w)==1)hwords(w);}if(e==p)break;p=e;}
        if(f->git){char*o=0;size_t n=0;char*v[]={"git","ls-files","--stage",0};int rc=cx_runv_timeout(v,20,&o,&n);if(rc||!o)hbad=1;else hput(o);free(o);o=0;char*hv[]={"git","ls-tree","-r","HEAD","--","cx","ext","tools/cxlib","build/tlib-packages.tsv",0};rc=cx_runv_timeout(hv,20,&o,&n);if(rc||!o)hbad=1;else hput(o);free(o);}
    }return hfinish(hex);
}
static int cache_path(Row*r,const char*mf,char*out,long cap){char root[4400],hex[65],key[5000];if(sy_cwd(root,sizeof root)<0||cx_fmt(key,sizeof key,"%s\n%s\n%s",root,mf,r->name)||sy_sha256_hex(key,strlen(key),hex))return 1;
    char dir[4400];if(cache_dir){if(cx_fmt(dir,sizeof dir,"%s",cache_dir))return 1;}else if(cx_fmt(dir,sizeof dir,"%s/unisacc-derive-cache",sy_tmpdir()))return 1;
    if(sy_mkdir_all(dir,0700))return 1;return cx_fmt(out,cap,"%s/%s",dir,hex);
}
static int cache_hit(Row*r,const char*mf){char p[4500],in[65],out[65],want[200];if(cache_full||cache_path(r,mf,p,sizeof p)||identity(r,mf,0,in)||identity(r,mf,1,out))return 0;
    char*b=cx_read(p,0);int n=snprintf(want,sizeof want,"DERIVE_CONTENT_V1\n%s\n%s\n",in,out);int hit=b&&n>0&&!strcmp(b,want);free(b);if(hit)sy_printf("DERIVE_IDENTITY\t%s\tinputs=%s\toutputs=%s\tverified=1\n",r->name,in,out);return hit;
}
static void cache_store(Row*r,const char*mf){char p[4500],in[65],out[65],b[200];if(cache_path(r,mf,p,sizeof p)||identity(r,mf,0,in)||identity(r,mf,1,out))return;int n=snprintf(b,sizeof b,"DERIVE_CONTENT_V1\n%s\n%s\n",in,out);if(n>0&&n<(int)sizeof b)(void)sy_write_atomic(p,b,n,0600);}
static int copy_field(char *dst, long cap, const char *s, long n) {
    if (n <= 0 || n >= cap) return 1;
    mm_copy(dst, cap, s, n); dst[n] = 0;
    return 0;
}
static int to_int(const char *s, long n, int *v) {
    long k; int x = 0;
    if (n <= 0 || n > 6) return 1;
    for (k = 0; k < n; k++) { if (s[k] < '0' || s[k] > '9') return 1; x = x * 10 + (s[k] - '0'); }
    *v = x;
    return 0;
}
static int refuse(const char *mf, int line, const char *why) { sy_printf("REFUSE\t%s\tline=%d\t%s\n", mf, line, why); return 2; }

static int load(const char *mf) {
    size_t n = 0; char *b = cx_read(mf, &n); long at = 0; int line = 0, i;
    if (!b) { sy_printf("REFUSE\t%s\tline=0\tunreadable\n", mf); return 2; }
    while (at < (long)n) {
        long e = tx_chr(b + at, (long)n - at, '\n'), ln = e < 0 ? (long)n - at : e, fs[9], k; int nf = 0; Row *r;
        const char *l = b + at;
        at += ln + 1; line++;
        if (ln == 0 || l[0] == '#') continue;
        fs[0] = 0;
        for (k = 0; k < ln; k++) if (l[k] == '\t') { if (nf >= 7) return refuse(mf, line, "field-count"); fs[++nf] = k + 1; }
        if (nf != 7) return refuse(mf, line, "field-count");
        fs[8] = ln + 1;
        if (nr >= MAXR) return refuse(mf, line, "too-many-rows");
        r = &rows[nr];
        if (copy_field(r->name, sizeof r->name, l + fs[0], fs[1] - fs[0] - 1) || copy_field(r->gen, sizeof r->gen, l + fs[1], fs[2] - fs[1] - 1) ||
            copy_field(r->chk, sizeof r->chk, l + fs[2], fs[3] - fs[2] - 1) || copy_field(r->wr, sizeof r->wr, l + fs[3], fs[4] - fs[3] - 1) ||
            copy_field(r->outs, sizeof r->outs, l + fs[4], fs[5] - fs[4] - 1) || copy_field(r->ins, sizeof r->ins, l + fs[5], fs[6] - fs[5] - 1))
            return refuse(mf, line, "empty-or-long-field");
        for (k = 0; r->name[k]; k++) if (!((r->name[k] >= 'a' && r->name[k] <= 'z') || (r->name[k] >= '0' && r->name[k] <= '9') || r->name[k] == '-')) return refuse(mf, line, "bad-name");
        for (i = 0; i < nr; i++) if (seq(rows[i].name, r->name)) return refuse(mf, line, "duplicate-name");
        if (to_int(l + fs[6], fs[7] - fs[6] - 1, &r->order) || r->order < 1 || r->order > 99) return refuse(mf, line, "bad-order");
        if (fs[8] - fs[7] - 1 == 1 && l[fs[7]] == '-') r->bound = 30;
        else if (to_int(l + fs[7], fs[8] - fs[7] - 1, &r->bound) || r->bound < 1 || r->bound > 300) return refuse(mf, line, "bad-bound");
        if (seq(r->chk, "-")) return refuse(mf, line, "no-check-argv");
        nr++;
    }
    if (!nr) return refuse(mf, line, "no-rows");
    for (i = 0; i < nr; i++) ord[i] = i;
    for (i = 1; i < nr; i++) {   /* 稳定插入排序:order 升序,同 order 保持清单行序 */
        int k = ord[i], j;
        for (j = i - 1; j >= 0 && rows[ord[j]].order > rows[k].order; j--) ord[j + 1] = ord[j];
        ord[j + 1] = k;
    }
    return 0;
}

static int start(Row *r, const char *argv_s) {
    static char buf[600], num[16]; char *v[MAXTOK + 4]; int c = 0; long k = 0, n = tx_len(argv_s, 500);
    if (!strncmp(argv_s, "query-only ", 11)) { argv_s += 11; n -= 11; }
    mm_copy(buf, sizeof buf, argv_s, n); buf[n] = 0;
    cx_fmt(num, sizeof num, "%d", r->bound);
    v[c++] = "./tools/bound"; v[c++] = num;
    while (k < n && c < MAXTOK + 2) {
        while (k < n && buf[k] == ' ') k++;
        if (k >= n) break;
        v[c++] = buf + k;
        while (k < n && buf[k] != ' ') k++;
        if (k < n) buf[k++] = 0;
    }
    v[c] = 0;
    r->cap = 1 << 14; r->out = mm_alloc(r->cap); r->n = 0; r->done = 0; r->rc = -1;
    r->t0 = sy_now_ms();
    r->pid = sy_spawn_pipe(v, 0, 0, &r->fd, 0);
    if (r->pid < 0 || !r->out) { r->done = 1; r->rc = 127; r->ms = 0; return 1; }
    return 0;
}
/* 读到 EOF 后收尸;返回 1 表示该行结束 */
static int pump(Row *r) {
    long g;
    if (r->n + 4096 >= r->cap) { char *nb = mm_grow(r->out, r->cap * 2); if (nb) { r->out = nb; r->cap *= 2; } else r->n = 0; }
    g = sy_read_once(r->fd, r->out + r->n, r->cap - 1 - r->n);
    if (g > 0) { r->n += g; return 0; }
    {   int ex = 0, code = 0, sig = 0;
        sy_close(r->fd);
        r->rc = sy_wait_status(r->pid, 0, &ex, &code, &sig) == r->pid && ex ? code : 128;
        r->ms = sy_now_ms() - r->t0; r->done = 1; r->out[r->n] = 0;
    }
    return 1;
}
static void run_group(Row **g, int ng) {
    sy_pollfd_t pf[4]; int i, live = 0;
    for (i = 0; i < ng; i++) if (!start(g[i], g[i]->status == ST_WROTE ? g[i]->wr : g[i]->chk)) live++;
    while (live > 0) {
        int np = 0, map[4];
        for (i = 0; i < ng; i++) if (!g[i]->done) { pf[np].fd = g[i]->fd; pf[np].events = 1; pf[np].revents = 0; map[np++] = i; }
        if (sy_poll(pf, np, 1000) < 0) { for (i = 0; i < np; i++) pf[i].revents = 1; }
        for (i = 0; i < np; i++) if (pf[i].revents && pump(g[map[i]])) live--;
    }
}
static void report(Row *r) {
    long e = r->n, s;
    if (r->status == ST_SKIPPED || r->status == ST_NOTRUN || r->status == ST_IDENTICAL) { sy_printf("DERIVE\t%s\t%s\t0\n", r->name, stname[r->status]); return; }
    if (r->status == ST_OK || r->status == ST_WROTE) { sy_printf("DERIVE\t%s\t%s\t%ld\n", r->name, stname[r->status], r->ms); return; }
    while (e > 0 && (r->out[e - 1] == '\n' || r->out[e - 1] == ' ')) e--;
    s = e;
    while (s > 0 && r->out[s - 1] != '\n') s--;
    { long k; for (k = s; k < e; k++) if (r->out[k] == '\t') r->out[k] = ' '; }
    if (e - s > 300) e = s + 300;
    sy_printf("DERIVE\t%s\t%s\t%ld\trc=%d\t%.*s%s\n", r->name, stname[r->status], r->ms, r->rc, (int)(e - s), r->out ? r->out + s : "",
              r->status == ST_NEEDS_BUMP || (r->status == ST_DRIFT && seq(r->wr, "-")) ? "\tnote=interface-changed-needs-bump" : "");
}
static int classify(int rc) { return rc == 0 ? ST_OK : rc == 1 ? ST_DRIFT : rc == 142 ? ST_TIMEOUT : ST_REFUSED; }

static int snap_file(const char *path) {
    Snap *s; int rg = sy_is_reg(path); size_t n = 0;
    if (nsnap >= MAXSNAP || tx_len(path, 700) >= 699) return 1;
    s = &snaps[nsnap];
    mm_copy(s->path, sizeof s->path, path, tx_len(path, 700) + 1);
    if (rg == -ENOENT) { s->existed = 0; s->data = 0; s->n = 0; nsnap++; return 0; }
    if (rg != 1) return 1;
    s->data = cx_read(path, &n);
    if (!s->data) return 1;
    s->n = (long)n; s->existed = 1; nsnap++;
    return 0;
}
static int snapped(const char *path) { int i; for (i = 0; i < nsnap; i++) if (seq(snaps[i].path, path)) return 1; return 0; }
static int snap_outputs(Row *r) {
    long k = 0, n = tx_len(r->outs, 700);
    while (k < n) {
        long s; char p[700];
        while (k < n && r->outs[k] == ' ') k++;
        s = k;
        while (k < n && r->outs[k] != ' ') k++;
        if (k == s) break;
        mm_copy(p, sizeof p, r->outs + s, k - s); p[k - s] = 0;
        if (p[k - s - 1] == '/') {
            sy_dir_t d; char *keep;
            p[k - s - 1] = 0;
            keep = mm_alloc(k - s);
            if (!keep) return 1;
            mm_copy(keep, k - s, p, k - s); snapdirs[nsnapdir++] = keep;
            if (sy_dir_open(&d, p)) continue;   /* 目录不存在:还原时也无新文件可删 */
            while (sy_dir_next(&d) == 1) {
                char f[700];
                if (d.kind != 'f') continue;
                if (cx_fmt(f, sizeof f, "%s/%s", p, d.name) || snap_file(f)) { sy_dir_close(&d); return 1; }
            }
            sy_dir_close(&d);
        } else if (!snapped(p) && snap_file(p)) return 1;
    }
    return 0;
}
static void restore(void) {
    int i;
    for (i = 0; i < nsnapdir; i++) {   /* 目录型 outputs 下本轮新出现的文件删掉 */
        sy_dir_t d;
        if (sy_dir_open(&d, snapdirs[i])) continue;
        while (sy_dir_next(&d) == 1) {
            char f[700];
            if (d.kind != 'f' || cx_fmt(f, sizeof f, "%s/%s", snapdirs[i], d.name)) continue;
            if (!snapped(f)) { sy_unlink(f); sy_printf("DERIVE_RESTORED\t%s\tremoved\n", f); }
        }
        sy_dir_close(&d);
    }
    for (i = 0; i < nsnap; i++) {
        Snap *s = &snaps[i];
        if (!s->existed) { if (sy_is_reg(s->path) == 1) { sy_unlink(s->path); sy_printf("DERIVE_RESTORED\t%s\tremoved\n", s->path); } continue; }
        {   size_t n = 0; char *now = cx_read(s->path, &n);
            if (now && (long)n == s->n && mm_same(now, s->data, s->n)) continue;
            if (cx_write(s->path, s->data, s->n)) sy_printf("DERIVE_RESTORE_FAILED\t%s\n", s->path);
            else sy_printf("DERIVE_RESTORED\t%s\trewritten\n", s->path);
        }
    }
}

/* 汇总(串行与 --from-run 共用这一份) */
static int summary(long t0) {
    int i, ok = 0, drift = 0, refused = 0, skipped = 0;
    for (i = 0; i < nr; i++) {
        int s = rows[i].status;
        if (s == ST_OK || s == ST_WROTE || s == ST_IDENTICAL) ok++;
        else if (s == ST_DRIFT || s == ST_NEEDS_BUMP) drift++;
        else if (s == ST_REFUSED || s == ST_TIMEOUT) refused++;
        else skipped++;
    }
    sy_printf("DERIVE_SUMMARY\tok=%d\tdrift=%d\trefused=%d\tskipped=%d\telapsed_ms=%ld\n", ok, drift, refused, skipped, sy_now_ms() - t0);
    return refused ? 2 : drift ? 1 : 0;
}
/* 词表 A 中某词与词表 B 中某词相交:任一方作 glob 匹配另一方(目录型 outputs 以 / 结尾,glob 的 * 可覆盖) */
static int word_hit(const char *a, const char *b) {
    long i = 0, na = tx_len(a, 700), nb = tx_len(b, 700);
    while (i < na) {
        long s, j = 0;
        while (i < na && a[i] == ' ') i++;
        s = i; while (i < na && a[i] != ' ') i++;
        if (i == s) break;
        j = 0;
        while (j < nb) {
            long t;
            while (j < nb && b[j] == ' ') j++;
            t = j; while (j < nb && b[j] != ' ') j++;
            if (j == t) break;
            if (glob(a + s, i - s, b + t, j - t) || glob(b + t, j - t, a + s, i - s)) return 1;
            if (a[i - 1] == '/' && j - t >= i - s && mm_same(a + s, b + t, i - s)) return 1;
            if (b[j - 1] == '/' && i - s >= j - t && mm_same(a + s, b + t, j - t)) return 1;
        }
    }
    return 0;
}
/* 读写冲突才连边:前者 outputs 与后者 inputs(写后读)、前者 inputs 与后者 outputs(读后写)、两者 outputs(写后写);
 * 方向按原派生顺序。--check 只读,冲突边照样给出(保守,与 --write 同图)。 */
static int conflict(Row *x, Row *y) { return word_hit(x->outs, y->ins) || word_hit(x->ins, y->outs) || word_hit(x->outs, y->outs); }
static int print_plan(int mode) {
    int i, j;
    for (i = 0; i < nr; i++) {
        Row *r = &rows[ord[i]]; int first = 1;
        if (!r->sel) continue;
        sy_printf("PLAN\t%s\t", r->name);
        for (j = 0; mode == 2 && j < i; j++) if (rows[ord[j]].sel && conflict(&rows[ord[j]], r)) { sy_printf("%s%s", first ? "" : ",", rows[ord[j]].name); first = 0; }
        sy_printf("%s\t./tools/bound %d %s\t%s\n", first ? "-" : "", r->bound, mode == 2 && !seq(r->wr, "-") ? r->wr : r->chk, r->outs);
    }
    return 0;
}
/* --from-run:读 flow 运行目录 DIR/events.tsv 的终态行与 DIR/out/<name>.out。0 有终态,1 无(skip 或未跑) */
static int from_run(Row *r, const char *dir) {
    char p[800]; size_t n = 0; char *b; long at = 0, nl = tx_len(r->name, 64); int got = 0;
    if (cx_fmt(p, sizeof p, "%s/events.tsv", dir) || !(b = cx_read(p, &n))) return 1;
    while (at < (long)n) {   /* EVT seq id state ms rc summary */
        long e = tx_chr(b + at, (long)n - at, '\n'), ln = e < 0 ? (long)n - at : e, f[8], k; int nf = 0;
        const char *l = b + at;
        at += ln + 1; f[0] = 0;
        for (k = 0; k < ln && nf < 6; k++) if (l[k] == '\t') f[++nf] = k + 1;
        if (nf < 6 || f[3] - f[2] - 1 != nl || !mm_same(l + f[2], r->name, nl)) continue;
        if (mm_same(l + f[3], "ok\t", 3) || mm_same(l + f[3], "fail\t", 5) || mm_same(l + f[3], "timeout\t", 8)) {
            long v = 0, q; int neg = 0;
            for (q = f[4]; q < f[5] - 1; q++) v = v * 10 + (l[q] - '0');
            r->ms = v; v = 0;
            for (q = f[5]; q < f[6] - 1; q++) { if (l[q] == '-') neg = 1; else v = v * 10 + (l[q] - '0'); }
            r->rc = neg ? -(int)v : (int)v;
            if (mm_same(l + f[3], "timeout\t", 8)) r->rc = 142;
            got = 1;
        }
    }
    if (!got) return 1;
    if (cx_fmt(p, sizeof p, "%s/out/%s.out", dir, r->name)) return 1;
    n = 0; r->out = cx_read(p, &n);
    if (!r->out) { r->out = mm_alloc(1); if (r->out) r->out[0] = 0; n = 0; }
    r->n = (long)n;
    /* 串行版子进程 stdout 与 stderr 同一管道(sy_spawn_pipe err_fd=0);flow 分写 .out/.err,这里把 .err 接在后面 */
    if (!cx_fmt(p, sizeof p, "%s/out/%s.err", dir, r->name)) {
        size_t en = 0; char *eb = cx_read(p, &en);
        if (eb && en > 0) {
            char *nb = mm_alloc(r->n + (long)en + 1);
            if (nb) { mm_copy(nb, r->n + en + 1, r->out, r->n); mm_copy(nb + r->n, en + 1, eb, en); r->n += (long)en; nb[r->n] = 0; r->out = nb; }
        }
    }
    return 0;
}
static int query_only(Row *r) { return !strncmp(r->wr, "query-only ", 11); }
static int usage(void) { sy_printf("usage: derive.cx -- --check|--write [--only NAME,...] [--changed PATH...] [--index] [--manifest FILE] [--full] [--input-facts FILE] [--cache-dir DIR]\n"); return 2; }

int main(int argc, char **argv) {
    const char *mf = "exec/facts/derive.tsv", *only = 0; char **changed = 0; int nchanged = 0, has_changed = 0, index = 0, mode = 0;
    int a, i, rc, plan = 0; const char *fromrun = 0; long t0 = sy_now_ms();
    for (a = 1; a < argc; a++) {
        if (seq(argv[a], "--check")) mode = 1;
        else if (seq(argv[a], "--full")) cache_full = 1;
        else if (seq(argv[a], "--cache-dir") && a + 1 < argc) cache_dir = argv[++a];
        else if (seq(argv[a], "--input-facts") && a + 1 < argc) input_facts = argv[++a];
        else if (seq(argv[a], "--write")) mode = 2;
        else if (seq(argv[a], "--plan")) plan = 1;
        else if (seq(argv[a], "--from-run") && a + 1 < argc) fromrun = argv[++a];
        else if (seq(argv[a], "--index")) index = 1;
        else if (seq(argv[a], "--only") && a + 1 < argc) only = argv[++a];
        else if (seq(argv[a], "--manifest") && a + 1 < argc) mf = argv[++a];
        else if (seq(argv[a], "--changed")) {
            has_changed = 1; changed = argv + a + 1;
            while (a + 1 < argc && !(argv[a + 1][0] == '-' && argv[a + 1][1] == '-')) { a++; nchanged++; }
        } else return usage();
    }
    if (!mode && plan) mode = 1;
    if (!mode) return usage();
    if ((rc = load(mf)) != 0) return rc;
    if(cf_load()){sy_printf("REFUSE\t%s\tinvalid-input-closure-facts\n",input_facts);return 2;}
    for(i=0;i<nr;i++){CacheFact*f=cf_find(rows[i].name),*c=cf_find("*");if(f&&c){char merged[700];if(cx_fmt(merged,sizeof merged,"%s %s %s %s",rows[i].ins,c->ins,f->ins,rows[i].gen)||mm_copy(rows[i].ins,sizeof rows[i].ins,merged,strlen(merged)+1))return refuse(input_facts,i+1,"input-closure-too-long");}}
    if (only) {   /* --only 的每个名字都必须在清单里 */
        long k = 0, n = tx_len(only, 4096);
        while (k <= n) {
            long s = k; int hit = 0;
            while (k < n && only[k] != ',') k++;
            for (i = 0; i < nr; i++) if (tx_len(rows[i].name, 64) == k - s && mm_same(rows[i].name, only + s, k - s)) hit = 1;
            if (!hit) { sy_printf("REFUSE\tonly\tunknown-name\t%.*s\n", (int)(k - s), only + s); return 2; }
            k++;
        }
    }
    for (i = 0; i < nr; i++) {
        Row *r = &rows[i]; int sel = 1;
        if (only) {
            long k = 0, n = tx_len(only, 4096), nn = tx_len(r->name, 64);
            sel = 0;
            while (k <= n) { long s = k; while (k < n && only[k] != ',') k++; if (k - s == nn && mm_same(only + s, r->name, nn)) sel = 1; k++; }
        }
        if (sel && has_changed) {
            long k = 0, n = tx_len(r->ins, 700); int c;
            sel = 0;
            while (k < n && !sel) {
                long s;
                while (k < n && r->ins[k] == ' ') k++;
                s = k;
                while (k < n && r->ins[k] != ' ') k++;
                for (c = 0; c < nchanged && !sel; c++) if (k > s && glob(r->ins + s, k - s, changed[c], tx_len(changed[c], 4096))) sel = 1;
            }
        }
        if (index && seq(r->name, "tool-index")) sel = 1;
        /* Query rows participate in explicit checks, never automatic writes. */
        if (mode == 2 && !only && query_only(r)) sel = 0;
        r->sel = sel; r->status = ST_SKIPPED;
    }
    if (plan) return print_plan(mode);
    if (fromrun) {
        for (i = 0; i < nr; i++) {
            Row *r = &rows[ord[i]];
            if (!r->sel) { report(r); continue; }
            if (from_run(r, fromrun)) { r->status = ST_NOTRUN; report(r); continue; }
            if (mode == 1) r->status = classify(r->rc);
            else if (seq(r->wr, "-")) { r->status = classify(r->rc); if (r->status == ST_DRIFT) r->status = ST_NEEDS_BUMP; }
            else r->status = r->rc == 0 ? ST_WROTE : r->rc == 142 ? ST_TIMEOUT : ST_REFUSED;
            report(r);
        }
        return summary(t0);
    }
    if (mode == 1) {
        i = 0;
        while (i < nr) {
            Row *g[4]; int ng = 0, j = i, o = rows[ord[i]].order, first = i;
            while (j < nr && rows[ord[j]].order == o && ng < 4) { if (rows[ord[j]].sel) g[ng++] = &rows[ord[j]]; j++; }
            run_group(g, ng);
            for (a = 0; a < ng; a++) g[a]->status = classify(g[a]->rc);
            for (a = first; a < j; a++) report(&rows[ord[a]]);
            i = j;
        }
    } else {
        int failed_at = -1;
        for (i = 0; i < nr; i++) {
            Row *r = &rows[ord[i]], *g[1];
            if (!r->sel) { report(r); continue; }
            if (failed_at >= 0) { r->status = ST_NOTRUN; report(r); continue; }
            if(cache_hit(r,mf)){r->status=ST_IDENTICAL;report(r);continue;}
            g[0] = r;
            if (seq(r->wr, "-")) {
                run_group(g, 1);
                r->status = classify(r->rc);
                if (r->status == ST_DRIFT) r->status = ST_NEEDS_BUMP;
            } else {
                if (snap_outputs(r)) { r->status = ST_REFUSED; r->rc = 2; r->out = mm_alloc(64); r->n = 0; if (r->out) { cx_fmt(r->out, 64, "snapshot-failed"); r->n = 15; } report(r); failed_at = i; restore(); continue; }
                r->status = ST_WROTE;
                run_group(g, 1);
                if (r->rc != 0) { r->status = r->rc == 142 ? ST_TIMEOUT : ST_REFUSED; failed_at = i; }
            }
            report(r);
            if (failed_at >= 0) restore();
        }
        if(failed_at<0)for(i=0;i<nr;i++)if(rows[i].status==ST_WROTE)cache_store(&rows[i],mf);
    }
    return summary(t0);
}
