static void pc_file(char p[4400],const char *name){path(p,pc,name);}
static void job_file(char p[4400],const char *context,const char *phase,const char *id,const char *leaf){char n[200],d[4400];int z=snprintf(n,sizeof n,"jobs/%s-%s",phase,id);if(z<0||z>=sizeof n)die("job-name-bound");path(d,context,n);path(p,d,leaf);}
static void file_row(np_buf *b,const char *label,const char *p){char h[65];digest(p,h);row(b,label,p);row(b,"content-sha",h);}
static void ctor_code(np_buf *b){np_puts(b,"source-package-mixed-code-v1\n");const char *deps[]={"seed/gen.c","seed/json.h","seed/facts.h","seed/tbl.c","seed/net.c","exec/c/core.h","seed/compilerpack.c","seed/sha256.h","include/unisa_safedel.h","seed/pack.c"};for(int i=0;i<10;i++){char a[4400],z[4400],h[65];path(a,root,deps[i]);path(z,snapshot,deps[i]);size_t n,m;char *x=load(a,&n),*y=load(z,&m);if(n!=m||memcmp(x,y,n))die("current-origin-constructor-C-closure-differs");hash_bytes(x,n,h);free(x);free(y);row(b,deps[i],h);}for(int i=0;i<3;i++){char a[4400],z[4400],h[65],g[65];job_file(a,newctx,"tool",constructor_names[i],"result.exe");job_file(z,origin_ctx,"tool",constructor_names[i],"result.exe");digest(a,h);digest(z,g);if(strcmp(h,g)||strcmp(h,constructor_pins[i]))die("measured-constructor-native-raw-mismatch");row(b,constructor_names[i],h);}
