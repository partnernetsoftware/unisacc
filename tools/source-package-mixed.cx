 if(transport||rc)die("actual-native-phase-failed-evidence-retained");np_buf report={0};char h[65];np_puts(&report,"source-package-mixed-native-start-v2\n");row(&report,"phase",packing?"pack":"declare");row(&report,"status","EXECUTED-requires-independent-finish-no-test-result");hash_bytes(before_inputs.p,before_inputs.n,h);row(&report,"inputs-sha",h);stdout_bytes(&report);free(report.p);free(before_inputs.p);endpoint_free(a);
}
