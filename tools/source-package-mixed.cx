typedef struct {char *line;} SpTreeEntry;static SpTreeEntry tree_entries[8192];static int tree_count;
static int tree_compare(const void *a,const void *b){return strcmp(((const SpTreeEntry *)a)->line,((const SpTreeEntry *)b)->line);}
static void tree_walk(const char *base,const char *relative,const char *label,int depth){if(depth>32||tree_count==8192)die("inventory-bound");char p[4400],key[4400],h[65],line[5000];if(*relative){path(p,base,relative);path(key,label,relative);}else{strcpy(p,base);strcpy(key,label);}struct stat st;errno=0;if(lstat(p,&st))die(errno==ENOENT?"inventory-missing":"inventory-stat");if(S_ISDIR(st.st_mode))strcpy(h,"-");else if(S_ISREG(st.st_mode))digest(p,h);else die("inventory-special-or-symlink");int n=snprintf(line,sizeof line,"%s\t%s\t%o\t%s\n",S_ISDIR(st.st_mode)?"DIR":"FILE",key,(unsigned)(st.st_mode&07777),h);if(n<0||(size_t)n>=sizeof line)die("inventory-line-bound");tree_entries[tree_count++].line=strdup(line);if(!tree_entries[tree_count-1].line)die("allocation");if(!S_ISDIR(st.st_mode))return;DIR *d=opendir(p);if(!d)die("inventory-opendir");for(;;){errno=0;struct dirent *e=readdir(d);if(!e){int saved=errno,closed=closedir(d);if(saved||closed)die("inventory-readdir-or-close");break;}if(!strcmp(e->d_name,".")||!strcmp(e->d_name,".."))continue;if(strpbrk(e->d_name,"\t\r\n"))die("inventory-name-wire");char next[4400];if(*relative)path(next,relative,e->d_name);else{if(strlen(e->d_name)>=sizeof next)die("inventory-name-bound");strcpy(next,e->d_name);}tree_walk(base,next,label,depth+1);}}
static void tree_append(np_buf *b,const char *base,const char *label){canonical(base);tree_count=0;tree_walk(base,"",label,0);qsort(tree_entries,(size_t)tree_count,sizeof *tree_entries,tree_compare);for(int i=0;i<tree_count;i++){np_puts(b,tree_entries[i].line);free(tree_entries[i].line);tree_entries[i].line=0;}tree_count=0;}

static void controller_state(np_buf *b){char p[4400],h[65],boot_h[65],record_h[65];size_t n;char *s=load(bootstrap,&n);size_t boot_n=n;hash_bytes(s,n,boot_h);free(s);int z=snprintf(p,sizeof p,"%s.build.json",bootstrap);if(z<0||(size_t)z>=sizeof p)die("bootstrap-record-path");s=load(p,&n);hash_bytes(s,n,record_h);bootstrap_record(s,n,boot_h,boot_n);char bootstrap_source[65];if(json_string(s,"sources_sha256",bootstrap_source,sizeof bootstrap_source,0)!=1||strcmp(bootstrap_source,origin_expected)||strcmp(boot_h,saved_bootstrap_pin)||strcmp(record_h,saved_record_pin))die("saved-bootstrap-329-raw-original-record-role-pin");free(s);row(b,"bootstrap",bootstrap);row(b,"bootstrap-sha",boot_h);row(b,"bootstrap-record-sha",record_h);row(b,"controller-source-path",self);digest(self,h);row(b,"controller-source",h);ssize_t en=readlink("/proc/self/exe",self_elf,sizeof self_elf-1);if(en<1||en>=(ssize_t)sizeof self_elf-1)die("actualself-ELF-readlink");self_elf[en]=0;canonical(self_elf);if(!within(self_elf,root)||within(self_elf,snapshot))die("actualself-ELF-role");struct stat proc,actual;if(stat("/proc/self/exe",&proc)||lstat(self_elf,&actual)||proc.st_dev!=actual.st_dev||proc.st_ino!=actual.st_ino)die("actualself-ELF-inode");s=load(self_elf,&n);if(n<64||memcmp(s,"\177ELF",4)||(unsigned char)s[4]!=2||(unsigned char)s[5]!=1||(unsigned char)s[18]!=62||s[19]||(n>=16&&!memcmp(s+n-16,"UNIPKG1\n",8))||access(self_elf,X_OK))die("actualself-native-ELF64-x64-required");hash_bytes(s,n,h);free(s);row(b,"controller-ELF-path",self_elf);row(b,"controller-ELF",h);row(b,"controller-target","lnx/x86_64");char package[4096],flags[9000];s=load(origin_profile,&n);field(s,n,"compiler-package",package,sizeof package);free(s);canonical(package);if(!within(package,root)||within(package,snapshot))die("compiler-package-current-root-role");digest(package,h);row(b,"controller-model-package",package);row(b,"controller-model-package-sha",h);z=snprintf(flags,sizeof flags,"--models %s -I %s/include -O2 -b lnx/x86_64",package,root);if(z<0||(size_t)z>=sizeof flags)die("controller-flags-bound");row(b,"controller-flags",flags);const char *mods[]={"tools/cxlib/sourcepackage.cx","tools/cxlib/netpack.cx","tools/cxlib/kernelsha.cx","tools/bound","tools/bound.c","seed/ident.c"};for(int i=0;i<6;i++){path(p,root,mods[i]);digest(p,h);if(i==2&&strcmp(h,ks_pin))die("kernelsha-module-pin");row(b,mods[i],h);}path(p,kgen,"identity-helper");row(b,"identity-helper-path",p);digest(p,h);row(b,"identity-helper-sha",h);}


