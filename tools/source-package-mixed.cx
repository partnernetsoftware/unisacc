typedef struct {int n;char text[48][4400];char *v[49];} Args;
static void arg(Args *a,const char *s){if(a->n==48||!s||!*s||strlen(s)>=4400||strpbrk(s,"\r\n\t"))die("native-argv-bound");strcpy(a->text[a->n],s);a->v[a->n]=a->text[a->n];a->n++;a->v[a->n]=0;}
static Args *native_args(int packing){Args *a=calloc(1,sizeof *a);if(!a)die("allocation");char p[4400];arg(a,bound);arg(a,"40");job_file(p,origin_ctx,"tool",packing?"pack":"compilerpack","result.exe");arg(a,p);if(!packing){pc_file(p,"declaration");arg(a,p);arg(a,"--o1");pc_file(p,"models/shared-o1.net");arg(a,p);arg(a,"--e2");pc_file(p,"models/shared-e2.net");arg(a,p);arg(a,"--nativeabi");pc_file(p,"models/shared-nativeabi.net");arg(a,p);arg(a,"--models");pc_file(p,"models");arg(a,p);arg(a,"--kernels");pc_file(p,"kernels");arg(a,p);arg(a,"--audit-dir");pc_file(p,"audit");arg(a,p);for(int i=0;i<6;i++){char name[100];snprintf(name,sizeof name,"routes/%s.tsv",targets[i]);pc_file(p,name);arg(a,p);}}else{arg(a,"--compressed");arg(a,"-o");pc_file(p,"compiler.pkg");arg(a,p);arg(a,"--mount");arg(a,"006864722f");path(p,root,"include");arg(a,p);arg(a,"--mount");arg(a,"006b65726e656c2f");pc_file(p,"kernels");arg(a,p);arg(a,"--mount");arg(a,"00707265646566696e65732f");pc_file(p,"declaration/predefines");arg(a,p);pc_file(p,"declaration/routes.tsv");arg(a,p);}return a;}
static np_buf argv_record(const Args *a){np_buf b={0};for(int i=0;i<a->n;i++){char k[40];snprintf(k,sizeof k,"arg-%d",i);row(&b,k,a->v[i]);}return b;}
