#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN source-package-mixed requires Linux/x86_64 LP64 native\n",stderr);return 3;
#else
 if(sizeof(long)!=8||sizeof(void *)!=8)die("LP64-required");clean_environment();if(argc==12&&!strcmp(argv[1],"prepare")){char *dest[]={root,snapshot,logical_root,logical_pc,newctx,kgen,bootstrap,origin_elf,origin_profile,pc};for(int i=0;i<10;i++){lexical(argv[i+2]);strcpy(dest[i],argv[i+2]);}setup_common();prepare();return 0;}if(argc==4&&(!strcmp(argv[1],"declare")||!strcmp(argv[1],"pack")||!strcmp(argv[1],"seal")||!strcmp(argv[1],"--verify")||!strcmp(argv[1],"--snapshot")||!strcmp(argv[1],"--verify-prepared")||!strcmp(argv[1],"declare-finish")||!strcmp(argv[1],"pack-finish"))){lexical(argv[2]);strcpy(root,argv[2]);restore_context(argv[3]);if(!strcmp(argv[1],"--verify-prepared"))prepared_view();else if(!strcmp(argv[1],"declare"))execute_phase(0);else if(!strcmp(argv[1],"pack"))execute_phase(1);else if(!strcmp(argv[1],"declare-finish"))finish_phase(0);else if(!strcmp(argv[1],"pack-finish"))finish_phase(1);else if(!strcmp(argv[1],"--snapshot"))snapshot_stage();else final_stage(!strcmp(argv[1],"--verify"));return 0;}die("usage prepare ROOT SNAPROOT LOGICAL_ROOT LOGICAL_PC NEW_CTX KGEN ABS_SAVED_BOOTSTRAP ORIGIN_ELF ORIGIN_PROFILE NEW_PC | declare|pack|seal|--verify|--snapshot ROOT PC");return 2;
