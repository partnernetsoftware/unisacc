/* Independent mixed-v1 code-material producer, CURRENT-SOURCE DRAFT.
 * prepare ROOT SNAPROOT LOGICAL_ROOT LOGICAL_PC NEW_CTX KGEN
 *         ABS_SAVED_BOOTSTRAP ORIGIN_ELF ORIGIN_PROFILE NEW_PC
 * declare|pack|seal|--verify|--snapshot ROOT PC; outer55 remains mandatory.
 * Each endpoint: fresh current/origin sources, full old107 origin DAG,
 * actual34 gen JSON byte comparisons, dynamic current union37+2k and full
 * current kernel construction. Same JSON reuses old verified tbl/net; changed
 * JSON requires current real gen/tbl/net closure. No hardcoded changed set.
 * Current/origin constructor raw bytes and all ten C dependencies must match.
 * Reexecute verified native compilerpack then native compressed pack; neither
 * declaration nor audit nor package comes from an old result. New independent
 * unsigned schema, no mutation of old receipts or claim of historical execution,
 * NN evaluation, source-package-v1 compatibility or test PASS.
 * Explicit reviewed execution pins bind the current module and origin executor;
 * all current material endpoints still require actual construction and verification.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.kernelsha
#pragma unisa use cxlib.sourcepackage

