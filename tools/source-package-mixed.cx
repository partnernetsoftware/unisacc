row(b,"tool-provenance","gen-tbl-net-current-and-origin-raw-identical;compilerpack-pack-old-full107-verified-code-cache-reexecuted-current-inputs;no-new-compilation-history");}
static np_buf select_models(int changed[34],int *changed_count){np_buf b={0};np_puts(&b,"source-package-mixed-selection-v1\n");*changed_count=0;for(int i=0;i<34;i++){char a[4400],z[4400],h[65],g[65];job_file(a,newctx,"gen",recipe_ids[i],"result.json");job_file(z,origin_ctx,"gen",recipe_ids[i],"result.json");size_t n,m;char *x=load(a,&n),*y=load(z,&m);if(!n||!m)die("empty-generator-JSON");changed[i]=n!=m||(n&&memcmp(x,y,n));if(changed[i])(*changed_count)++;hash_bytes(x,n,h);hash_bytes(y,m,g);free(x);free(y);row(&b,"recipe",recipe_ids[i]);row(&b,"current-gen",a);row(&b,"current-gen-sha",h);row(&b,"origin-gen",z);row(&b,"origin-gen-sha",g);number_row(&b,"current-gen-bytes",(long long)n);number_row(&b,"origin-gen-bytes",(long long)m);row(&b,"model-operation",changed[i]?"EXECUTED-current-gen-tbl-net":"ADOPTED-origin-tbl-net-after-actual-equal-current-gen-JSON");}return b;}
static void union_observe(MixedEndpoint *e){char storage[37][160];const char *leaves[37];strcpy(storage[0],"tool-gen");strcpy(storage[1],"tool-tbl");strcpy(storage[2],"tool-net");for(int i=0;i<34;i++)snprintf(storage[i+3],sizeof storage[i+3],"%s-%s",e->changed[i]?"net":"gen",recipe_ids[i]);for(int i=0;i<37;i++)leaves[i]=storage[i];char why[1800]={0};if(sp_verify_jobs_snapshot(root,newctx,leaves,37,e->current_source,12,&e->union_result,why,sizeof why)){fprintf(stderr,"%s\n",why);die("current-union-DAG-refused");}sp_result *r=&e->union_result;if(strcmp(r->source,current_expected)||strcmp(r->foundation,basis_pin)||strcmp(r->verifier,current_sp_pin)||strcmp(r->digest_module,ks_pin)||r->jobs!=37+2*e->changed_count||r->models!=e->changed_count||r->physical_reads<1)die("current-union-identity-counts");np_puts(&e->current,"source-package-mixed-current-union-v1\n");const char *keys[]={"source","artifact","manifest","receipt","witness","epoch-artifact","epoch-record","epoch-path","producer","foundation","verifier","digest-module"};const char *values[]={r->source,r->artifact,r->manifest,r->receipt,r->witness,r->epoch_artifact,r->epoch_record,r->epoch_path,r->producer,r->foundation,r->verifier,r->digest_module};for(int i=0;i<12;i++)row(&e->current,keys[i],values[i]);number_row(&e->current,"jobs",r->jobs);number_row(&e->current,"models",r->models);number_row(&e->current,"physical-reads",r->physical_reads);}
static np_buf projected_route(int t){char name[180],p[4400],oldprefix[4400],newprefix[4400];snprintf(name,sizeof name,"routes/%s.tsv",targets[t]);path(p,physical_pc,name);path(oldprefix,logical_pc,"models");path(newprefix,pc,"models");size_t n;char *s=load(p,&n);if(!n||n>8388608||s[n-1]!='\n'||memchr(s,0,n)||memchr(s,'\r',n))die("origin-route-wire");np_buf b={0};size_t at=0,pre=strlen(oldprefix);int rows=0;while(at<n){size_t end=at;while(end<n&&s[end]!='\n')end++;size_t last=0;int tabs=0;for(size_t i=at;i<end;i++)if(s[i]=='\t'){tabs++;last=i;}if(tabs!=4||last==at)die("route-exact-five-columns");size_t a=last+1,z=end-a;if(z<=pre+1||memcmp(s+a,oldprefix,pre)||s[a+pre]!='/')die("route-old-model-prefix");const char *leaf=s+a+pre+1;size_t ln=z-pre-1;int found=0;for(int i=0;i<34;i++){size_t k=strlen(recipe_ids[i]);if(ln==k+4&&!memcmp(leaf,recipe_ids[i],k)&&!memcmp(leaf+k,".net",4))found++;}if(found!=1)die("route-unknown-model");np_put(&b,s+at,last+1-at);np_puts(&b,newprefix);np_put(&b,s+a+pre,z-pre);np_puts(&b,"\n");rows++;at=end+1;}free(s);if(!rows)die("empty-route");return b;}
static MixedEndpoint *endpoint(void){long long start=now_ns();own_reads=0;MixedEndpoint *e=calloc(1,sizeof *e);if(!e)die("allocation");identity(root,e->current_source);if(strcmp(e->current_source,current_expected))die("current-source-outside-reviewed-mixed-domain");identity(snapshot,e->origin_source);if(strcmp(e->origin_source,origin_expected))die("origin-source-outside-reviewed-domain");strcpy(sid,e->origin_source);origin_observe(&e->origin_report,&e->origin);strcpy(sid,e->current_source);ctor_code(&e->code);e->selection=select_models(e->changed,&e->changed_count);union_observe(e);int again[34],count;np_buf check=select_models(again,&count);same(&e->selection,&check,"JSON-selection-changed-during-current-union");free(check.p);if(count!=e->changed_count||memcmp(again,e->changed,sizeof again))die("dynamic-selection-changed");kernel_state_observe(&e->kernel);strcpy(e->kernel_context,kernel_context_sha);char p[4400];path(p,root,"include");tree_append(&e->headers,p,"CARRIED_HEADERS");for(int i=0;i<6;i++)e->routes[i]=projected_route(i);
np_buf *c=&e->context;np_puts(c,"source-package-mixed-context-v1\n");row(c,"status","MIXED-current-and-adopted-inputs-native-declare-pack-pending-no-test-result");row(c,"environment-policy",environment_policy);row(c,"root",root);row(c,"snapshot-root",snapshot);row(c,"logical-root",logical_root);row(c,"logical-package",logical_pc);row(c,"physical-package",physical_pc);row(c,"origin-context",origin_ctx);row(c,"source-context",newctx);row(c,"kernel-generation",kgen);row(c,"pack-context",pc);row(c,"source",e->current_source);row(c,"origin-source",e->origin_source);row(c,"origin-verifier-ELF-path",origin_elf);row(c,"origin-profile-path",origin_profile);row(c,"foundation",basis_pin);row(c,"origin-consumer",producer_pin);row(c,"origin-spec",spec_pin);controller_state(c);char h[65];np_buf *parts[]={&e->origin,&e->selection,&e->current,&e->kernel,&e->headers,&e->code};const char *names[]={"origin.tsv","selection.tsv","current-union.tsv","kernel-state.tsv","headers.tsv","code.tsv"};for(int i=0;i<6;i++){hash_bytes(parts[i]->p,parts[i]->n,h);row(c,names[i],h);}for(int i=0;i<6;i++){char name[100];snprintf(name,sizeof name,"routes/%s.tsv",targets[i]);hash_bytes(e->routes[i].p,e->routes[i].n,h);row(c,name,h);}number_row(c,"current-net-models",e->changed_count);number_row(c,"adopted-net-models",34-e->changed_count);number_row(c,"current-union-jobs",e->union_result.jobs);row(c,"declaration","EXECUTE-verified-native-compilerpack-fresh-model-kernel-route-inputs");row(c,"scope","unsigned-consistency-not-history-hermetic-CC-NN-functional-test-or-PASS");e->own_physical_reads=own_reads;e->elapsed_ns=now_ns()-start;if(e->elapsed_ns<0)die("clock-backwards");return e;}
static void endpoint_equal(const MixedEndpoint *a,const MixedEndpoint *z){same(&a->context,&z->context,"mixed-complete-endpoint-changed");}
static void endpoint_free(MixedEndpoint *e){if(!e)return;np_buf *v[]={&e->context,&e->origin,&e->selection,&e->current,&e->kernel,&e->headers,&e->code};for(int i=0;i<7;i++)free(v[i]->p);for(int i=0;i<6;i++)free(e->routes[i].p);free(e);}
static void selected_model(char p[4400],const MixedEndpoint *e,int i,int net){job_file(p,e->changed[i]?newctx:origin_ctx,net?"net":"tbl",recipe_ids[i],net?"result.net":"result.tbl");}
static void copy_exact(const char *src,const char *dst){size_t n,m;char *s=load(src,&n);write_new(dst,s,n);char *v=load(dst,&m);if(n!=m||memcmp(s,v,n))die("private-copy-bytes");free(s);free(v);}
static void compare_file(const char *a,const char *b){size_t n,m;char *x=load(a,&n),*y=load(b,&m);if(n!=m||memcmp(x,y,n))die("selected-private-bytes-mismatch");free(x);free(y);}
static void exact_names(const char *dir,const char *const *names,int count){directory(dir);DIR *d=opendir(dir);if(!d)die("private-directory-open");unsigned char seen[80]={0};int total=0;for(;;){errno=0;struct dirent *v=readdir(d);if(!v){int saved=errno,closed=closedir(d);if(saved||closed)die("private-directory-read-close");break;}if(!strcmp(v->d_name,".")||!strcmp(v->d_name,".."))continue;int found=-1;for(int i=0;i<count;i++)if(!strcmp(names[i],v->d_name))found=i;if(found<0||seen[found])die("private-directory-extra-or-duplicate");seen[found]=1;total++;char p[4400];path(p,dir,v->d_name);canonical(p);struct stat st;if(lstat(p,&st)||!S_ISREG(st.st_mode))die("private-nonregular-leaf");}if(total!=count)die("private-directory-missing-leaf");}
static void verify_prepared(const MixedEndpoint *e){char p[4400];np_buf *parts[]={ (np_buf *)&e->context,(np_buf *)&e->origin,(np_buf *)&e->selection,(np_buf *)&e->current,(np_buf *)&e->kernel,(np_buf *)&e->headers,(np_buf *)&e->code};const char *names[]={"context.tsv","origin.tsv","selection.tsv","current-union.tsv","kernel-state.tsv","headers.tsv","code.tsv"};for(int i=0;i<7;i++){pc_file(p,names[i]);equal(p,parts[i]);}
char storage[68][180];const char *leaves[68];for(int i=0;i<34;i++)for(int j=0;j<2;j++){char src[4400],name[200];int k=i*2+j;snprintf(storage[k],sizeof storage[k],"%s.%s",recipe_ids[i],j?"net":"tbl");leaves[k]=storage[k];snprintf(name,sizeof name,"models/%s",storage[k]);pc_file(p,name);selected_model(src,e,i,j);compare_file(src,p);}pc_file(p,"models");exact_names(p,leaves,68);
char route_names[6][100];const char *rl[6];for(int i=0;i<6;i++){char name[140];snprintf(route_names[i],sizeof route_names[i],"%s.tsv",targets[i]);rl[i]=route_names[i];snprintf(name,sizeof name,"routes/%s",rl[i]);pc_file(p,name);equal(p,&e->routes[i]);}pc_file(p,"routes");exact_names(p,rl,6);
const char *arches[]={"arm64","x86_64"};for(int i=0;i<2;i++){char src[4400],name[100];snprintf(name,sizeof name,"%s.kernel",arches[i]);path(src,kgen,name);snprintf(name,sizeof name,"kernels/%s",arches[i]);pc_file(p,name);compare_file(src,p);}pc_file(p,"kernels");exact_names(p,arches,2);}
