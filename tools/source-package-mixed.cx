static void execute_phase(int packing){
 MixedEndpoint *a=endpoint();verify_prepared(a);
 np_buf before_inputs=phase_inputs(a,packing);if(packing)verify_phase(a,0,&before_inputs);
 char p[4400],dir[4400];pc_file(dir,packing?"phases/pack":"phases/declare");absent(dir);
 if(packing){pc_file(p,"compiler.pkg");absent(p);}else{pc_file(p,"declaration");absent(p);pc_file(p,"audit");absent(p);}
 if(mkdir(dir,0700))die("exclusive-native-phase");phase_file(p,packing,"inputs.tsv");write_new(p,before_inputs.p,before_inputs.n);
