/* tools/chain-preflight.cx -- unified pre-chain preflight table runner and root/snap-cache file-type checks (unit M2).
 * Usage:
 *   sh ./unisacc.com tools/chain-preflight.cx [-- [--root DIR] [--snap-base DIR] [--rev REV] [--table FILE] [--events-file FILE] [--strict]]
 *   sh ./unisacc.com tools/chain-preflight.cx -- --item root-types|snap-cache-types [--root DIR] [--snap-base DIR] [--rev REV]
 *   sh ./unisacc.com tools/chain-preflight.cx -- --check-table [--table FILE]
 * Shadow mode (default): validates tools/flows/chain-preflight.tsv, runs all preflight nodes, prints PREFLIGHT_ITEM lines
 * and CHAIN_PREFLIGHT<TAB>rev=..<TAB>verdict=PASS|FAIL<TAB>failed=..<TAB>nodes=..<TAB>ms=..<TAB>mode=shadow, exits 0. */
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use text.text
#pragma unisa use cxlib.ckrun

typedef struct {
    char name[64];
    char patterns[256];
    char cmd[512];
    int timeout_s;
} PfNode;

static int classify_path(const char *p, const char **actual) {
    sy_stat_t st, st2;
    if (sy_lstat(p, &st) != 0) {
        *actual = "missing";
        return 0;
    }
    if (st.kind == 'l') {
        if (sy_stat(p, &st2) != 0) *actual = "dangling-symlink";
        else *actual = "symlink";
        return 0;
    }
    if (st.kind == 'd') {
        *actual = "directory";
        return 0;
    }
    if (st.kind != 'f') {
        *actual = "not-regular";
        return 0;
    }
    *actual = "regular";
    return 1;
}

static int item_root_types(const char *root) {
    static const char *files[2] = { "unisacc.com", "unisacc.com.build.json" };
    char p[2048];
    const char *actual = "missing";
    int bad = 0;
    for (int i = 0; i < 2; i++) {
        if (cx_fmt(p, sizeof p, "%s/%s", root, files[i])) return 1;
        if (!classify_path(p, &actual)) {
            printf("PREFLIGHT_ITEM\troot-types\tFAIL\tpath=%s\texpected=regular\tactual=%s\n", p, actual);
            bad++;
        }
    }
    if (!bad) {
        printf("PREFLIGHT_ITEM\troot-types\tPASS\troot=%s\texpected=regular\tchecked=2\n", root);
    }
    return bad ? 1 : 0;
}

static int item_snap_cache_types(const char *snap_base, const char *rev) {
    static const char *files[2] = { "unisacc.com", "unisacc.com.build.json" };
    sy_stat_t bst;
    char p[2048], ep[2048];
    const char *actual = "missing";
    int bad = 0, checked = 0;
    if (sy_lstat(snap_base, &bst) != 0) {
        printf("PREFLIGHT_ITEM\tsnap-cache-types\tPASS\tsnap_base=%s\texpected=regular\tchecked=0\n", snap_base);
        return 0;
    }
    if (bst.kind != 'd') {
        printf("PREFLIGHT_ITEM\tsnap-cache-types\tFAIL\tpath=%s\texpected=directory\tactual=not-directory\n", snap_base);
        return 1;
    }
    sy_dir_t d;
    if (sy_dir_open(&d, snap_base) != 0) return 1;
    size_t rlen = rev ? strlen(rev) : 0;
    while (sy_dir_next(&d) == 1) {
        if (d.name[0] == '.') continue;
        if (rlen >= 10) {
            if (d.name_n <= 11 || memcmp(d.name, rev, 10) != 0 || d.name[10] != '-') continue;
        }
        if (cx_fmt(ep, sizeof ep, "%s/%s", snap_base, d.name)) continue;
        sy_stat_t est;
        if (sy_lstat(ep, &est) != 0 || est.kind != 'd') {
            printf("PREFLIGHT_ITEM\tsnap-cache-types\tFAIL\tpath=%s\texpected=directory\tactual=not-directory\n", ep);
            bad++;
            continue;
        }
        for (int i = 0; i < 2; i++) {
            if (cx_fmt(p, sizeof p, "%s/%s", ep, files[i])) continue;
            checked++;
            if (!classify_path(p, &actual)) {
                printf("PREFLIGHT_ITEM\tsnap-cache-types\tFAIL\tpath=%s\texpected=regular\tactual=%s\n", p, actual);
                bad++;
            }
        }
    }
    sy_dir_close(&d);
    if (!bad) {
        printf("PREFLIGHT_ITEM\tsnap-cache-types\tPASS\tsnap_base=%s\texpected=regular\tchecked=%d\n", snap_base, checked);
    }
    return bad ? 1 : 0;
}

static int load_table(const char *tpath, PfNode *nodes, int max_nodes, int *out_n) {
    unsigned char *b = 0;
    int64_t n = 0;
    *out_n = 0;
    if (sy_read_file(tpath, &b, &n, 1 << 20) || !b || n <= 0) {
        if (b) mm_free(b);
        printf("PREFLIGHT_TABLE\tstatus=FAIL\treason=unreadable\n");
        return 2;
    }
    int saw_hdr = 0, has_root = 0, has_snap = 0, cnt = 0;
    int64_t pos = 0;
    while (pos < n) {
        int64_t ls = pos;
        while (pos < n && b[pos] != '\n') pos++;
        int64_t le = pos;
        if (pos < n) pos++;
        if (le > ls && b[le - 1] == '\r') le--;
        long len = (long)(le - ls);
        const char *line = (const char *)b + ls;
        if (len <= 0 || line[0] == '#') continue;
        if (!saw_hdr) {
            const char *want_hdr = "name\tpatterns\tcmd\ttimeout_s";
            if (len != (long)strlen(want_hdr) || memcmp(line, want_hdr, (size_t)len) != 0) {
                mm_free(b);
                printf("PREFLIGHT_TABLE\tstatus=FAIL\treason=bad-header\n");
                return 2;
            }
            saw_hdr = 1;
            continue;
        }
        const char *cols[6];
        long clens[6];
        int nc = 0;
        long q = 0;
        while (nc < 6 && q <= len) {
            long cs = q;
            while (q < len && line[q] != '\t') q++;
            cols[nc] = line + cs;
            clens[nc] = q - cs;
            nc++;
            q++;
        }
        if (nc != 4 || clens[0] <= 0 || clens[0] >= 63 || clens[1] <= 0 || clens[1] >= 255 ||
            clens[2] <= 0 || clens[2] >= 511 || clens[3] <= 0 || clens[3] >= 15 || cnt >= max_nodes) {
            mm_free(b);
            printf("PREFLIGHT_TABLE\tstatus=FAIL\treason=bad-columns\n");
            return 2;
        }
        PfNode *nd = &nodes[cnt];
        mm_copy(nd->name, sizeof nd->name, cols[0], (size_t)clens[0]); nd->name[clens[0]] = 0;
        mm_copy(nd->patterns, sizeof nd->patterns, cols[1], (size_t)clens[1]); nd->patterns[clens[1]] = 0;
        mm_copy(nd->cmd, sizeof nd->cmd, cols[2], (size_t)clens[2]); nd->cmd[clens[2]] = 0;
        char ts[16];
        mm_copy(ts, sizeof ts, cols[3], (size_t)clens[3]); ts[clens[3]] = 0;
        nd->timeout_s = atoi(ts);
        if (nd->timeout_s < 1 || nd->timeout_s > 55) {
            mm_free(b);
            printf("PREFLIGHT_TABLE\tstatus=FAIL\treason=timeout-out-of-range\tnode=%s\n", nd->name);
            return 2;
        }
        for (int j = 0; j < cnt; j++) {
            if (tx_eqz(nodes[j].name, nd->name)) {
                mm_free(b);
                printf("PREFLIGHT_TABLE\tstatus=FAIL\treason=duplicate-name\tnode=%s\n", nd->name);
                return 2;
            }
        }
        if (tx_eqz(nd->name, "root-types")) has_root = 1;
        if (tx_eqz(nd->name, "snap-cache-types")) has_snap = 1;
        cnt++;
    }
    mm_free(b);
    if (!saw_hdr || cnt < 2 || !has_root || !has_snap) {
        printf("PREFLIGHT_TABLE\tstatus=FAIL\treason=missing-mandatory-m2-rows\n");
        return 2;
    }
    *out_n = cnt;
    return 0;
}

int main(int argc, char **argv) {
    const char *root = ".", *snap_base = 0, *rev = "none", *tpath = "tools/flows/chain-preflight.tsv";
    const char *item = 0, *ev_file = 0;
    int check_table = 0, strict = 0;
    char dflt_snap[2048];
    const char *home = sy_env("HOME");
    if (home && home[0] && !cx_fmt(dflt_snap, sizeof dflt_snap, "%s/.cache/unisacc/chains/snap", home)) {
        snap_base = dflt_snap;
    } else {
        snap_base = "/nonexistent-snap-cache";
    }

    for (int i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--")) continue;
        else if (tx_eqz(argv[i], "--root") && i + 1 < argc) root = argv[++i];
        else if (tx_eqz(argv[i], "--snap-base") && i + 1 < argc) snap_base = argv[++i];
        else if (tx_eqz(argv[i], "--rev") && i + 1 < argc) rev = argv[++i];
        else if (tx_eqz(argv[i], "--table") && i + 1 < argc) tpath = argv[++i];
        else if (tx_eqz(argv[i], "--item") && i + 1 < argc) item = argv[++i];
        else if (tx_eqz(argv[i], "--events-file") && i + 1 < argc) ev_file = argv[++i];
        else if (tx_eqz(argv[i], "--check-table")) check_table = 1;
        else if (tx_eqz(argv[i], "--strict")) strict = 1;
        else {
            fprintf(stderr, "chain-preflight: bad argument: %s\n", argv[i]);
            return 2;
        }
    }

    if (item) {
        if (tx_eqz(item, "root-types")) return item_root_types(root);
        if (tx_eqz(item, "snap-cache-types")) return item_snap_cache_types(snap_base, rev);
        fprintf(stderr, "chain-preflight: unknown item: %s\n", item);
        return 2;
    }

    PfNode nodes[32];
    int nnodes = 0;
    long t0 = sy_now_ms();
    if (load_table(tpath, nodes, 32, &nnodes) != 0) return 2;
    if (check_table) {
        printf("PREFLIGHT_TABLE\tstatus=OK\trows=%d\n", nnodes);
        return 0;
    }

    char failed_list[512] = {0};
    int nfailed = 0;
    for (int i = 0; i < nnodes; i++) {
        int rc = 0;
        if (tx_eqz(nodes[i].name, "root-types")) {
            rc = item_root_types(root);
        } else if (tx_eqz(nodes[i].name, "snap-cache-types")) {
            rc = item_snap_cache_types(snap_base, rev);
        } else {
            char out[2048];
            rc = ckk_sh_t("CHAIN_PREFLIGHT", nodes[i].cmd, out, sizeof out, nodes[i].timeout_s);
        }
        if (rc != 0) {
            size_t fl = strlen(failed_list);
            cx_fmt(failed_list + fl, sizeof failed_list - fl, "%s%s", nfailed ? "," : "", nodes[i].name);
            nfailed++;
        }
    }

    long elapsed = sy_now_ms() - t0;
    const char *verdict = nfailed ? "FAIL" : "PASS";
    const char *flist = nfailed ? failed_list : "-";
    printf("CHAIN_PREFLIGHT\trev=%s\tverdict=%s\tfailed=%s\tnodes=%d\tms=%ld\tmode=%s\n",
           rev, verdict, flist, nnodes, elapsed, strict ? "strict" : "shadow");
    if (ev_file && ev_file[0]) {
        char evline[1024];
        if (!cx_fmt(evline, sizeof evline, "chain.preflight\trev=%s verdict=%s failed=%s ms=%ld\n",
                    rev, verdict, flist, elapsed)) {
            sy_write_file(ev_file, evline, (int64_t)strlen(evline), 0600);
        }
    }
    return strict ? (nfailed ? 1 : 0) : 0;
}
