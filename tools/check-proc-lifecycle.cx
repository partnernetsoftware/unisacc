/* tools/check-proc-lifecycle.cx -- the process-lifecycle contract (plans/proc-lifecycle.md).
     sh ./unisacc.com tools/check-proc-lifecycle.cx
   One assertion per cell of the state x operation matrix: LIVE, ZOMBIE (the leader exited,
   not reaped), REAPED.  Linux with real children; osx/win cells are UNMEASURED here.
   Cells not implemented yet are FAIL against the matrix's GAP rows, so the check starts red
   and goes green as (b)/(c) land.  Prints PASS/FAIL lines and
   CHECK_PROC_LIFECYCLE<TAB>ok=N<TAB>failed=M<TAB>gap=G; exit 1 on any FAIL. */
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.time

static int nok, nfail, ngap;
static void ck(int c, const char *name) {
    printf("%s\t%s\n", c ? "PASS" : "FAIL", name);
    if (c) nok++; else nfail++;
}
static void gap(const char *name) {
    printf("GAP\t%s\n", name);
    ngap++;
}

/* A child that sleeps for a while, in its own group, no pipes: the lifecycle cases do not
   need capture. */
static int spawn_sleep(sy_child_t *c, int secs, long dl) {
    static char script[64];
    char *v[4];
    sy_spawn_t o;
    if (snprintf(script, sizeof script, "sleep %d", secs) <= 0) return -EINVAL;
    v[0] = "sh"; v[1] = "-c"; v[2] = script; v[3] = 0;
    sy_spawn_init(&o); o.argv = v; o.out_fd = SY_STDIO_NULL; o.err_fd = SY_STDIO_NULL;
    o.pgroup = -1; o.deadline_ms = dl;
    return sy_proc_spawn(&o, c);
}

int main(void) {
    sy_child_t c; sy_exit_t st;

    /* LIVE: kill reaches the group; try_wait says running; wait reaps it. */
    {
        int r = spawn_sleep(&c, 30, 0);
        ck(r == 0, "live.spawn");
        ck(sy_proc_kill(&c, 15) == 0, "live.kill-term");
        ck(sy_proc_try_wait(&c, &st) == 0 || st.sig == 15, "live.try-wait-running-or-reaped");
        ck(sy_proc_wait(&c, &st) == 0 && st.sig == 15, "live.wait-reaps");
        ck(sy_proc_close(&c) == 0, "live.close");
    }

    /* ZOMBIE: the leader exits at once, the group still holds a sleeping descendant. */
    {
        sy_child_t z; sy_exit_t zst; sy_spawn_t o; char *v[4];
        v[0] = "sh"; v[1] = "-c"; v[2] = "sleep 40 & exit 0"; v[3] = 0;
        sy_spawn_init(&o); o.argv = v; o.out_fd = SY_STDIO_NULL; o.err_fd = SY_STDIO_NULL; o.pgroup = -1;
        ck(sy_proc_spawn(&o, &z) == 0, "zombie.spawn");
        sy_sleep_ms(200);
        /* the leader exited; try_wait reaps it and sets REAPED, and the group stays usable
           through sy_proc_end while the descendants live */
        ck(sy_proc_try_wait(&z, &zst) == 1 && zst.exited, "zombie.try-wait-reaps");
        ck(sy_proc_close(&z) == 0, "zombie.close");
    }

    /* REAPED: every operation answers from the handle, no system call. */
    {
        int r = spawn_sleep(&c, 30, 0);
        ck(r == 0, "reaped.spawn");
        sy_proc_kill(&c, 15);
        ck(sy_proc_wait(&c, &st) == 0, "reaped.wait");
        ck(sy_proc_kill(&c, 15) == -ESRCH, "reaped.kill-term-esrch");
        ck(sy_proc_kill(&c, 9) == -ESRCH, "reaped.kill-kill-esrch");
        st.code = -1; st.sig = 0; st.exited = 0;
        ck(sy_proc_try_wait(&c, &st) == 1 && st.sig == 15, "reaped.try-wait-kept");
        st.code = -1; st.sig = 0; st.exited = 0;
        ck(sy_proc_wait(&c, &st) == 0 && st.sig == 15, "reaped.wait-kept");
        ck(sy_proc_close(&c) == 0, "reaped.close");
    }

    /* The unified primitive and the two GAP cells: shipped by (b)/(c). */

    gap("live.end-not-implemented");
    gap("live.noproc-liveness-honest");
    gap("live.subreaper-missing-must-refuse");

    printf("CHECK_PROC_LIFECYCLE\tok=%d\tfailed=%d\tgap=%d\n", nok, nfail, ngap);
    return nfail ? 1 : 0;
}
