/* tools/check-proc-lifecycle.cx -- the process-lifecycle contract (plans/proc-lifecycle.md).
     sh ./unisacc.com tools/check-proc-lifecycle.cx
   One assertion per cell of the state x operation matrix: LIVE, ZOMBIE (the leader exited,
   not reaped), REAPED.  Linux with real children; osx/win cells are UNMEASURED here.
   Cells not implemented yet are FAIL against the matrix's GAP rows, so the check starts red
   and goes green as (b)/(c) land.  Prints PASS/FAIL lines and
   CHECK_PROC_LIFECYCLE<TAB>ok=N<TAB>failed=M<TAB>gap=G; exit 1 on any FAIL. */
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.time
#pragma unisa use mem.grow

static int nok, nfail, ngap;
static void ck(int c, const char *name) {
    printf("%s\t%s\n", c ? "PASS" : "FAIL", name);
    if (c) nok++; else nfail++;
}
/* 1 when PID has a /proc entry (live or zombie). */
static int proc_alive(int pid) {
    char p[64];
    sy_stat_t st;
    if (pid <= 0) return 0;
    if (snprintf(p, sizeof p, "/proc/%d", pid) <= 0) return 0;
    return sy_stat(p, &st) == 0;
}

/* Capture a sh -c script with a deadline, one stream split off. */
static int run1(const char *script, long cap_bytes, long dl, sy_capture_t *cap, sy_exit_t *st) {
    char *a[4];
    sy_spawn_t o;
    a[0] = "sh"; a[1] = "-c"; a[2] = (char *)script; a[3] = 0;
    sy_spawn_init(&o); o.argv = a; o.deadline_ms = dl;
    mg_init(&cap->out); mg_init(&cap->err); cap->split = 1;
    return sy_proc_capture(&o, st, cap, cap_bytes);
}

static void gap(const char *name) {
    printf("GAP\t%s\n", name);
    ngap++;
}

/* A child that sleeps for a while, in its own group, no pipes: the lifecycle cases do not
   need capture. */
static int spawn_sleep(sy_child_t *c, int secs, long dl) {
    static char script[64];
    char *v[4];
    sy_spawn_t o;
    if (snprintf(script, sizeof script, "sleep %d", secs) <= 0) return -EINVAL;
    v[0] = "sh"; v[1] = "-c"; v[2] = script; v[3] = 0;
    sy_spawn_init(&o); o.argv = v; o.out_fd = SY_STDIO_NULL; o.err_fd = SY_STDIO_NULL;
    o.pgroup = -1; o.deadline_ms = dl;
    return sy_proc_spawn(&o, c);
}

/* Anchoring, observed in a private PID namespace (plans/proc-lifecycle.md rule 2).  The check is
   launched under `unshare -U -r -p -f` (user + pid, no root -- the same way cdx's
   tools/check-reaper.cx --reaped-root-pidns gets one), so sy_pid() == 1 here.  Drive the exact
   pid a reaped leader had to a sentinel that makes its own group, then prove sy_proc_end sends it
   nothing.  A REAPED handle that still fell through to kill(-pgid)/kill(pid) -- the "early reap"
   mutation -- would signal this sentinel and turn the assertion red. */
static int anchor_pidns(void) {
    int root, sentinel, st, w, fd, n, res;
    char pid_text[32];
    sy_child_t c;
    sy_exit_t e;
    if (sy_pid() != 1) return 2;   /* not in the namespace: the caller records it as a skip */
    {
        sy_spawn_t o; char *v[4];
        v[0] = "sh"; v[1] = "-c"; v[2] = "exit 0"; v[3] = 0;
        sy_spawn_init(&o); o.argv = v; o.out_fd = SY_STDIO_NULL; o.err_fd = SY_STDIO_NULL; o.pgroup = -1;
        if (sy_proc_spawn(&o, &c) != 0) return 2;
    }
    root = c.pid;
    res = sy_proc_end(&c, 100, &e);
    if (res != 0) { sy_proc_close(&c); return 2; }
    /* the leader's pid is free now; point ns_last_pid so the next fork reuses exactly ROOT */
    n = snprintf(pid_text, sizeof pid_text, "%d\n", root - 1);
    fd = sy_open("/proc/sys/kernel/ns_last_pid", O_WRONLY, 0);
    if (fd < 0) { sy_proc_close(&c); return 2; }
    if (sy_write_all(fd, pid_text, n) != 0) { sy_close(fd); sy_proc_close(&c); return 2; }
    sy_close(fd);
    sentinel = fork();
    if (sentinel < 0) { sy_proc_close(&c); return 2; }
    if (sentinel == 0) { sy_setpgid(0, 0); sy_sleep_ms(2000); _exit(0); }
    sy_setpgid(sentinel, sentinel);
    ck(sentinel == root, "anchor.sentinel-reuses-leader-pid");
    /* the handle is REAPED: a no-op that must reach the sentinel with nothing */
    ck(sy_proc_end(&c, 100, &e) == -ESRCH, "anchor.reaped-handle-returns-esrch");
    ck(sy_proc_kill(&c, 15) == -ESRCH, "anchor.reaped-handle-kill-esrch");
    w = waitpid(sentinel, &st, WNOHANG | WUNTRACED);
    ck(w == 0, "anchor.sentinel-not-signalled");
    /* POSITIVE CONTROL: this fixture CAN observe "the sentinel was signalled".  The test now
       signals -sentinel itself (no sy_proc_* involved) and must see the death.  Without this,
       "sentinel not signalled" proves nothing -- a blind fixture passes it either way. */
    kill(-sentinel, 9);
    w = waitpid(sentinel, &st, 0);
    ck(w == sentinel && WIFSIGNALED(st) && WTERMSIG(st) == 9, "anchor.positive-control-observes-kill");
    sy_proc_close(&c);
    return 0;
}
int main(void) {
    sy_child_t c; sy_exit_t st;

    /* LIVE: kill reaches the group; try_wait says running; wait reaps it. */
    {
        int r = spawn_sleep(&c, 30, 0);
        ck(r == 0, "live.spawn");
        ck(sy_proc_kill(&c, 15) == 0, "live.kill-term");
        ck(sy_proc_try_wait(&c, &st) == 0 || st.sig == 15, "live.try-wait-running-or-reaped");
        ck(sy_proc_wait(&c, &st) == 0 && st.sig == 15, "live.wait-reaps");
        ck(sy_proc_close(&c) == 0, "live.close");
    }

    /* ZOMBIE: the leader exits at once, the group still holds a sleeping descendant. */
    {
        sy_child_t z; sy_exit_t zst; sy_spawn_t o; char *v[4];
        v[0] = "sh"; v[1] = "-c"; v[2] = "sleep 40 & exit 0"; v[3] = 0;
        sy_spawn_init(&o); o.argv = v; o.out_fd = SY_STDIO_NULL; o.err_fd = SY_STDIO_NULL; o.pgroup = -1;
        ck(sy_proc_spawn(&o, &z) == 0, "zombie.spawn");
        sy_sleep_ms(200);
        /* the leader exited; try_wait reaps it and sets REAPED, and the group stays usable
           through sy_proc_end while the descendants live */
        ck(sy_proc_try_wait(&z, &zst) == 1 && zst.exited, "zombie.try-wait-reaps");
        ck(sy_proc_close(&z) == 0, "zombie.close");
    }

    /* REAPED: every operation answers from the handle, no system call. */
    {
        int r = spawn_sleep(&c, 30, 0);
        ck(r == 0, "reaped.spawn");
        sy_proc_kill(&c, 15);
        ck(sy_proc_wait(&c, &st) == 0, "reaped.wait");
        ck(sy_proc_kill(&c, 15) == -ESRCH, "reaped.kill-term-esrch");
        ck(sy_proc_kill(&c, 9) == -ESRCH, "reaped.kill-kill-esrch");
        st.code = -1; st.sig = 0; st.exited = 0;
        ck(sy_proc_try_wait(&c, &st) == 1 && st.sig == 15, "reaped.try-wait-kept");
        st.code = -1; st.sig = 0; st.exited = 0;
        ck(sy_proc_wait(&c, &st) == 0 && st.sig == 15, "reaped.wait-kept");
        ck(sy_proc_close(&c) == 0, "reaped.close");
    }

    /* The unified primitive and the two GAP cells: shipped by (b)/(c). */

    /* sy_proc_end is implemented and covered by the c16-* cells above. */
    gap("live.noproc-liveness-honest");
    gap("live.subreaper-missing-must-refuse");

    /* Anchoring (rule 2) and the cleaning primitive (rule 4), proved through behaviour:
       a leader that exits while a descendant ignores TERM is cleaned by sy_proc_end with the
       KILL upgrade; the descendant must be gone and the handle REAPED afterwards.  Removing the
       KILL upgrade or dropping the REAPED marking turns these red. */
    {
        int r2, pid = 0; long i;
        sy_capture_t cap2; sy_exit_t st2;
        /* the descendant ignores TERM: only the KILL upgrade can finish the group */
        r2 = run1("sh -c 'trap \"\" TERM; sleep 42' & echo $!; exit 0", 1 << 20, 500, &cap2, &st2);
        for (i = 0; i < cap2.out.len; i++) { unsigned char dg2 = cap2.out.data[i]; if (dg2 >= 48 && dg2 <= 57) pid = pid * 10 + (dg2 - 48); }
        ck(r2 == -ETIMEDOUT, "c16-rc");
        ck(pid > 0, "c16-descendant-pid-read");
        sy_sleep_ms(300);
        ck(pid > 0 && !proc_alive(pid), "c16-term-ignored-descendant-killed");
        if (pid > 0 && proc_alive(pid)) sy_kill(pid);
        mg_free(&cap2.out); mg_free(&cap2.err);
    }
    /* sy_proc_end on a LIVE leader: 0, REAPED, no signal later (rule 3/4). */
    {
        sy_child_t c2; sy_exit_t st2;
        int r2 = spawn_sleep(&c2, 30, 0);
        ck(r2 == 0, "c16-end-spawn");
        ck(sy_proc_end(&c2, 200, &st2) == 0, "c16-end-returns-0");
        ck(c2.state == SY_CHILD_REAPED, "c16-end-sets-reaped");
        ck(sy_proc_kill(&c2, 15) == -ESRCH, "c16-end-then-kill-esrch");
        ck(sy_proc_end(&c2, 200, &st2) == -ESRCH, "c16-end-again-esrch");
        sy_proc_close(&c2);
    }
    /* Anchoring: the leader is NOT reaped while its group may still be alive.  A leader that
       exited at once stays unreaped inside the call (its status is collected once, at the end),
       which is what keeps the pid from being reused before the group kill.  Observable form: the
       descendant above was killed, so the group kill saw a live group after leader exit. */
    {
        sy_exit_t st2; sy_child_t c2; sy_spawn_t o2; char *v2[4];
        v2[0] = "sh"; v2[1] = "-c"; v2[2] = "sleep 40 & exit 0"; v2[3] = 0;
        sy_spawn_init(&o2); o2.argv = v2; o2.out_fd = SY_STDIO_NULL; o2.err_fd = SY_STDIO_NULL; o2.pgroup = -1;
        ck(sy_proc_spawn(&o2, &c2) == 0, "c16-anchor-spawn");
        sy_sleep_ms(200);
        ck(sy_proc_end(&c2, 200, &st2) == 0 && c2.state == SY_CHILD_REAPED, "c16-anchor-end-after-leader-exit");
        sy_proc_close(&c2);
    }

    /* anchoring: real in a private PID namespace, a recorded skip otherwise */
    if (anchor_pidns() == 2) gap("anchor.needs-pid-namespace");

    return nfail ? 1 : 0;
}
