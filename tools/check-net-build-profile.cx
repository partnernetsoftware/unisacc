/* Summary fixtures are statistics consistency checks, not fabricated build evidence. */
#pragma unisa use sys.fs
#pragma unisa use sysx.process
static char nc_root[4096],nc_com[8192],nc_tool[8192],nc_bin[8192],nc_dir[4096],nc_file[8192],nc_other[8192];static int nc_tests,nc_bad;
static void nc_die(const char *s){fprintf(stderr,"net-build-profile-check: %s\n",s);exit(2);}
static void nc_ck(int yes,const char *s){nc_tests++;nc_bad+=!yes;printf("%s\t%s\n",yes?"PASS":"FAIL",s);}
static np_result nc_call(char **v){np_result r={0};char why[300]={0};if(np_run(v,nc_root,0,8,&r,why,sizeof why)||r.residue)nc_die(why);return r;}
static void nc_fixture(int mode){char h[65],b[4000];memset(h,'a',64);h[64]=0;int n=snprintf(b,sizeof b,"NET_BUILD_PROFILE\tversion=1\trecipe_sha=%s\tinputs_sha=%s\tgen_sha=%s\ttbl_sha=%s\tnet_sha=%s\tstart=0\tcount=3\n",h,h,h,h,h);const char *ids[]={"a","b","c"};long ms[]={2,4,10};for(int i=0;i<3;i++)n+=snprintf(b+n,sizeof b-n,"NET\t%s\tgen_ms=%ld\ttbl_ms=%ld\tnet_ms=%ld\tbytes=1\tgen_sha=%s\ttbl_sha=%s\tnet_sha=%s\trc=%d\n",ids[i],ms[i],ms[i],ms[i],h,h,h,mode==2&&i==1?1:0);if(mode!=1)n+=snprintf(b+n,sizeof b-n,"PROFILE_COMPLETE\tmodels=3\tfull_key_validation=NOT_EXECUTED\n");if(cx_write(nc_file,b,n))nc_die("fixture write");}
int main(void){if(!realpath(".",nc_root))nc_die("root");snprintf(nc_com,sizeof nc_com,"%s/unisacc.com",nc_root);snprintf(nc_tool,sizeof nc_tool,"%s/tools/net-build-profile.cx",nc_root);strcpy(nc_dir,"/tmp/net-build-profile-check-XXXXXX");if(!mkdtemp(nc_dir))nc_die("mkdtemp");snprintf(nc_file,sizeof nc_file,"%s/profile.tsv",nc_dir);
 /* Default-run compilation exceeded the eight-second functional child budget.
    Prepare one private executable; this caches compilation, never test results. */
 snprintf(nc_bin,sizeof nc_bin,"%s/profile-tool",nc_dir);char *compile[]={"sh",nc_com,"-o",nc_bin,nc_tool,0};np_result prep={0};char why[300]={0};if(np_run(compile,nc_root,0,40,&prep,why,sizeof why)||prep.residue||prep.rc)nc_die("private executable preparation");np_free(&prep);
 char *list[]={nc_bin,"--root",nc_root,"--list",0};np_result r=nc_call(list);int count=0;if(r.out)for(char *p=r.out;(p=strstr(p,"\nRECIPE\t"));p++)count++;nc_ck(!r.rc&&count==42,"actual canonical recipe table enumerates exactly42");np_free(&r);
 char *sum[]={nc_bin,"--summary",nc_file,0};nc_fixture(0);r=nc_call(sum);nc_ck(!r.rc&&r.out&&strstr(r.out,"models=3\tcumulative_ms=48\tp50_ms=12\tp90_ms=30\tp95_ms=30\tmax_ms=30\tlongest=c"),"nearest-rank and cumulative construction phases exact");nc_ck(r.out&&strstr(r.out,"full_key_validation=NOT_EXECUTED"),"timing never claims full-key validation");np_free(&r);
 nc_fixture(1);r=nc_call(sum);nc_ck(r.rc==2&&!r.outn,"missing completion rejects");np_free(&r);nc_fixture(2);r=nc_call(sum);nc_ck(r.rc==2&&!r.outn,"failed constructor row rejects");np_free(&r);
 char *invalid[]={nc_bin,"--start","-1",0};r=nc_call(invalid);nc_ck(r.rc==2&&!r.outn,"invalid range rejected before construction");np_free(&r);
 char *empty[]={nc_bin,"--summary",0};r=nc_call(empty);nc_ck(r.rc==2&&!r.outn,"empty summary rejected");np_free(&r);
 nc_fixture(0);char *dup[]={nc_bin,"--summary",nc_file,nc_file,0};r=nc_call(dup);nc_ck(r.rc==2&&!r.outn,"duplicate recipes across profile files reject");np_free(&r);
 snprintf(nc_other,sizeof nc_other,"%s/other.tsv",nc_dir);size_t z=0;char *b=cx_read(nc_file,&z);if(!b)nc_die("read fixture");char *p=strstr(b,"inputs_sha=");if(!p)nc_die("fixture identity");p[11]='b';if(cx_write(nc_other,b,z))nc_die("mixed fixture write");free(b);char *mixed[]={nc_bin,"--summary",nc_file,nc_other,0};r=nc_call(mixed);nc_ck(r.rc==2&&!r.outn&&r.err&&strstr(r.err,"mixed build identities"),"mixed input identities reject before duplicate rows");np_free(&r);
 if(unlink(nc_other)||unlink(nc_bin)||unlink(nc_file)||rmdir(nc_dir))nc_die("owned fixture cleanup");printf("NET_BUILD_PROFILE_CHECK\tchecks=%d\tfailed=%d\n",nc_tests,nc_bad);return nc_bad?1:0;}
