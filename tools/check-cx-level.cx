#pragma unisa use compiler.levelname
#pragma unisa use runtime.levelname
#pragma unisa use sys.io
#pragma unisa use text.text
/* Generated by tools/level-gen.cx. Narrow check of the three suffix levels. */
int main(void) {
    const char *name;
    const char **missing;
    missing = 0;
    if (lvn_count() != 3) return 1;
    if (rlv_count() != 3) return 1;
    if (lvn_at(0, &name) || !tx_eqz(name, "O0")) return 1;
    if (rlv_at(0, &name) || !tx_eqz(name, "O0")) return 1;
    if (lvn_at(1, &name) || !tx_eqz(name, "O1")) return 1;
    if (rlv_at(1, &name) || !tx_eqz(name, "O1")) return 1;
    if (lvn_at(2, &name) || !tx_eqz(name, "O2")) return 1;
    if (rlv_at(2, &name) || !tx_eqz(name, "O2")) return 1;
    if (lvn_at(0, missing) != 4) return 1;
    if (rlv_at(0, missing) != 4) return 1;
    if (lvn_at(-1, &name) != 2) return 1;
    if (lvn_at(3, &name) != 2) return 1;
    if (rlv_at(-1, &name) != 2) return 1;
    if (rlv_at(3, &name) != 2) return 1;
    sy_printf("CX_LEVEL\tok=3\tfailed=0\n");
    return 0;
}
