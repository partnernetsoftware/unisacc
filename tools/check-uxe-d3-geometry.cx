#pragma unisa use chrome_dom
#pragma unisa use text.fmt

/* Independent pinhole projection. Each point is inside a visible face or
   aperture, not on its rasterized edge. The page receives only pixel addresses. */
typedef struct { const char *name; double x,y,z; int material; } Probe;
enum { SKY, STONE, BARREL, PLASTER, LEAF, GRASS, ROOF, ABUTMENT, LINE };
static Probe points[16] = {
    {"west-opening",-8,2.5,1,SKY}, {"middle-opening",0,2.6,1,SKY},
    {"east-opening",8,2.6,1,SKY}, {"middle-vault",0,5,0.7,BARREL},
    {"sunlit-pier",-4,3.0,2.5,STONE}, {"east-pier-behind-tree",4,2,2.5,LEAF},
    {"house-wall",-14,8,1,PLASTER}, {"roof",-12.82,9.72,-1,ROOF},
    {"west-abutment",-14,4,2.5,ABUTMENT}, {"near-meadow",0,-2,9,GRASS}
};
static double center_deck, center_base;
/* Read survey dimensions in millimetres. Inspect the middle bay, where both
   the front lip and the shaded intrados immediately behind it are visible. */
static int survey(void) {
    size_t bytes=0;
    char *data=cx_read("ujs/practice/uxe/test/d3-arch.tsv",&bytes);
    int i, bay, found=0;
    char *line=data?strchr(data,'\n'):0;
    for(bay=0;line && line[1];bay++) {
        int col[9];
        line++;
        if(sscanf(line,"%d %d %d %d %d %d %d %d %d",&col[0],&col[1],&col[2],
            &col[3],&col[4],&col[5],&col[6],&col[7],&col[8])!=9) break;
        if(col[2]<=0 || col[3]<=col[4] || col[8]<12 || col[8]>16 || bay>=3) break;
        points[bay].x=col[0]/1000.0;
        points[bay].y=(col[1]+col[2]*0.20)/1000;
        points[bay].z=(col[3]+col[4])/2000.0;
        if(bay==1) {
            center_deck=col[6]/1000.0;
            center_base=col[7]/1000.0;
            double r=col[2]/1000.0, spring=col[1]/1000.0;
            double front=col[3]/1000.0;
            points[3].x=col[0]/1000.0;
            points[3].y=spring+r;
            points[3].z=front-(col[3]-col[4])*.0006;
            for(i=0;i<3;i++) {
                int j, k=10+2*i;
                double dx=r*i*.25, root=r;
                for(j=0;j<8;j++) root=(root+(r*r-dx*dx)/root)*.5;
                points[k].name=i?"arc-below":"crown-midpoint-below";
                points[k].x=points[3].x+dx;
                points[k].z=front;
                points[k].y=spring+root-.10;
                points[k].material=BARREL;
                points[k+1]=points[k];
                points[k+1].name=i?"arc-above":"crown-midpoint-above";
                points[k+1].y=spring+root+.10;
                points[k+1].material=STONE;
            }
            found=1;
        }
        line=strchr(line,'\n');
    }
    if(data) free(data);
    return bay==3 && found;
}
/* Mesh shading is ambient .82 plus a positive, bounded directional term.
   Classify by chromaticity, invariant to this scalar. Sky bypasses shading. */
static int base[][3] = {{88,160,218},{211,184,140},{119,113,106},
    {246,222,183},{50,110,62},{140,160,73},{72,91,110},{151,129,108}};
static int classify(int r,int g,int b) {
    int k, nearest=-1; double best=1;
    int sum=r+g+b;
    if (sum < 45) return -1;
    for (k=0;k<8;k++) {
        int norm=base[k][0]+base[k][1]+base[k][2];
        double dr=(double)r/sum-(double)base[k][0]/norm;
        double dg=(double)g/sum-(double)base[k][1]/norm;
        double db=(double)b/sum-(double)base[k][2]/norm;
        double distance=dr*dr+dg*dg+db*db;
        if (distance<best) { best=distance; nearest=k; }
    }
    return best < 0.00035 ? nearest : -1;
}
#define LEAF_W 104
#define LEAF_H 84
static unsigned char leaf_tiles[LEAF_W*LEAF_H];
static int queue[LEAF_W*LEAF_H];

static int inspect_leaves(void) {
    int i, edges=0, leaf=0, dark=0, patches=0, failed=0;
    for(i=0;i<LEAF_W*LEAF_H;i++) {
        int shown=leaf_tiles[i]!=0;
        leaf+=shown;
        dark+=leaf_tiles[i]==2;
        if(i%LEAF_W) edges+=shown!=(leaf_tiles[i-1]!=0);
        if(i>=LEAF_W) edges+=shown!=(leaf_tiles[i-LEAF_W]!=0);
    }
    for(i=0;i<LEAF_W*LEAF_H;i++) if(leaf_tiles[i]==2) {
        int count=1, read;
        leaf_tiles[i]=1; queue[0]=i;
        for(read=0;read<count;read++) {
            int p=queue[read], j;
            int neighbors[]={p%LEAF_W?p-1:-1,p%LEAF_W<LEAF_W-1?p+1:-1,p-LEAF_W,p+LEAF_W};
            for(j=0;j<4;j++) {
                int q=neighbors[j];
                if(q>=0 && q<LEAF_W*LEAF_H && leaf_tiles[q]==2) {
                    leaf_tiles[q]=1; queue[count++]=q;
                }
            }
        }
        patches+=count>=3;
    }
    failed+=edges<1100;
    failed+=patches<5 || patches>36;
    failed+=leaf<1600 || dark*100<leaf*12 || dark*100>leaf*55;
    printf("D3_LEAF_SHAPE\tedges=%d dark_patches=%d dark=%d/%d failed=%d\n",edges,patches,dark,leaf,failed);
    return failed;
}

static int rounded_mm(double x) {
    int n=(int)(x+.5);
    return n>x+.5?n-1:n;
}

static int check_u1(const char *mutation) {
    char cwd[1024],url[20000],profile[128],option[160],*out=0;
    char *av[]={"google-chrome","--headless=new","--use-angle=swiftshader","--enable-unsafe-swiftshader",
        "--allow-file-access-from-files","--disable-background-networking","--window-size=1280,807",
        "--virtual-time-budget=5000","--dump-dom",option,url,0};
    char scenes[8][8],names[8][48],line[160];
    int regions[8][4],n=0,scene,i,j,x,y,failed=0;
    FILE *facts=fopen("ujs/practice/uxe/test/u1-light.tsv","r");
    if(!facts) return 2;
    if(!fgets(line,sizeof line,facts)) { fclose(facts); return 2; }
    while(n<8 && fgets(line,sizeof line,facts)) {
        if(sscanf(line,"%7s %47s %d %d %d %d",scenes[n],names[n],
            &regions[n][0],&regions[n][1],&regions[n][2],&regions[n][3])!=6 ||
            regions[n][0]<0 || regions[n][0]>1216 || regions[n][1]<0 || regions[n][1]>656) {
            fclose(facts); return 2;
        }
        n++;
    }
    fclose(facts);
    if(n!=5 || !getcwd(cwd,sizeof cwd)) return 2;
    for(scene=3;scene<=4;scene++) {
        int at,queued=0,seen=0,rc;
        size_t size=0;
        const char *p;
        at=tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/%s.html?style=study&render-u1=1&%s&pixels=",
            cwd,scene==3?"d3-bridge":"d4-skeleton",mutation);
        for(i=0;i<n;i++) if(scenes[i][1]=='0'+scene) {
            int *box=regions[i];
            for(y=box[1];y<box[1]+64;y+=4) for(x=box[0];x<box[0]+64;x+=4) {
                int w=tx_snprintf(url+at,sizeof url-at,"%s%d,%d",queued?";":"",x,y);
                if(w<0 || w>=(int)sizeof url-at) return 2;
                at+=w; queued++;
            }
        }
        if(!queued) return 2;
        tx_snprintf(profile,sizeof profile,"/tmp/chrome-dom-u1-%d-%d",(int)getpid(),scene);
        tx_snprintf(option,sizeof option,"--user-data-dir=%s",profile);
        out=0;
        rc=cx_runv_timeout(av,14,&out,&size);
        chd_wipe(profile);
        p=out?strstr(out,"<output id=\"pixels\">"):0;
        if(rc || !p) { free(out); return 2; }
        p+=strlen("<output id=\"pixels\">");
        for(i=0;i<n;i++) if(scenes[i][1]=='0'+scene) {
            int sum=0,luma,delta;
            for(j=0;j<256;j++) {
                int r,g,b,used=0;
                if(sscanf(p,"%d,%d,%d%n",&r,&g,&b,&used)!=3 || used==0 ||
                    r<0 || r>255 || g<0 || g>255 || b<0 || b>255) { free(out); return 2; }
                p+=used;
                if(++seen<queued && *p++!=';') { free(out); return 2; }
                sum+=(30*r+59*g+11*b+50)/100;
            }
            luma=(sum+128)/256;
            delta=abs(luma-regions[i][2]);
            failed+=delta>regions[i][3];
            printf("UXE_U1 scene=d%d region=%s luma=%d reference=%d delta=%d limit=%d\n",
                scene,names[i],luma,regions[i][2],delta,regions[i][3]);
        }
        rc=strncmp(p,"</output>",9)!=0;
        free(out);
        if(rc) return 2;
    }
    printf("CHECK_UXE_U1 regions=%d failed=%d\n",n,failed);
    return failed!=0;
}

static double study_root(double n) {
    double x=n;
    int i;
    for(i=0;i<20;i++) x=(x+n/x)*.5;
    return x;
}

static void study_box(const double *eye,const double *target,double focal,
    const double *lo,const double *hi,int *out) {
    double x=target[0]-eye[0],y=target[1]-eye[1],z=target[2]-eye[2];
    double h=study_root(x*x+z*z),len=study_root(h*h+y*y);
    double min[2]={1280,720},max[2]={0,0};
    int i,j;
    for(i=0;i<8;i++) {
        double dx=((i&1)?hi[0]:lo[0])-eye[0];
        double dy=((i&2)?hi[1]:lo[1])-eye[1];
        double dz=((i&4)?hi[2]:lo[2])-eye[2];
        double along=(dx*x+dz*z)/h, depth=(along*h+dy*y)/len;
        double xy[2]={640+focal*(-dx*z+dz*x)/(h*depth),
            360-focal*(dy*h-along*y)/(len*depth)};
        for(j=0;j<2;j++) {
            double viewport=j?720:1280;
            double v=xy[j]<0?0:xy[j]>viewport?viewport:xy[j];
            if(v<min[j]) min[j]=v;
            if(v>max[j]) max[j]=v;
        }
    }
    for(j=0;j<2;j++) out[j]=(int)((max[j]-min[j])*1000/(j?720:1280)+.5);
}

static int check_u2b(const char *mutation) {
    char cwd[1024],url[4096],profile[128],option[160],*doc=0,*data,*row;
    char *av[]={"google-chrome","--headless=new","--use-angle=swiftshader","--enable-unsafe-swiftshader",
        "--allow-file-access-from-files","--disable-background-networking","--window-size=1280,807",
        "--virtual-time-budget=6500","--dump-dom",option,url,0};
    const double eye3[]={15,4,29},target3[]={3,9,-5},eye4[]={14,11.8,22},target4[]={0,9.4,0};
    int arches,bay,recede,x,w,h,d,scale,deck,tower,wing,towers,domes,puffs;
    int expected3[3],expected4[7],scene,failed=0;
    size_t size=0;
    data=cx_read("ujs/practice/uxe/test/uxe-u2b.tsv",&size);
    row=data?strchr(data,'\n'):0;
    if(!row || sscanf(row+1,"d3 %d %d %d %d %d %d %d d4 %d %d %d %d %d %d %d",
        &arches,&bay,&recede,&x,&w,&h,&d,&scale,&deck,&tower,&wing,&towers,&domes,&puffs)!=14) {
        free(data); return 1;
    }
    free(data);
    if(arches<5 || bay<=0 || recede<=0 || w<=0 || h<=0 || d<=0 || scale<1200 ||
        deck<=0 || tower*5<deck*4 || wing*2<tower || towers<3 || domes<2 || puffs<18) return 1;
    {
        int spring,radius,front,back,half,deck3,base;
        double rise,bottom,shift=(-1.0-20*recede/1000.0),lo[3],hi[3];
        data=cx_read("ujs/practice/uxe/test/d3-arch.tsv",&size);
        row=data?strchr(data,'\n'):0;
        if(!row || sscanf(row+1,"%*d %d %d %d %d %d %d %d",
            &spring,&radius,&front,&back,&half,&deck3,&base)!=7) { free(data); return 2; }
        free(data);
        data=cx_read("ujs/practice/uxe/test/d3-composition.tsv",&size);
        row=data?strchr(data,'\n'):0;
        if(!row || sscanf(row+1,"%*d %*d %*d %d",&scale)!=1) { free(data); return 2; }
        free(data);
        rise=(deck3-base)*scale/1000000.0;
        bottom=base/1000.0+rise;
        lo[0]=(x-w*.5)/1000; lo[1]=bottom; lo[2]=shift-d*.0005;
        hi[0]=(x+w*.5)/1000; hi[1]=bottom+h*.001; hi[2]=shift+d*.0005;
        expected3[0]=arches;
        study_box(eye3,target3,640,lo,hi,expected3+1);
    }
    {
        double lo[]={-deck*.0005,6.37,-3.35},hi[]={deck*.0005,6.37+tower*.001,3.35};
        expected4[0]=tower; expected4[1]=wing; expected4[2]=towers;
        expected4[3]=domes; expected4[4]=puffs;
        study_box(eye4,target4,360/.34,lo,hi,expected4+5);
    }
    if(!getcwd(cwd,sizeof cwd)) return 2;
    for(scene=3;scene<=4;scene++) {
        int got[7]={0},count=scene==3?3:7,used=0,i,rc,bad=0;
        const int *expected=scene==3?expected3:expected4;
        const char *p;
        tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/%s.html?scale-u2b&u2b-probe&%s",
            cwd,scene==3?"d3-bridge":"d4-skeleton",mutation);
        tx_snprintf(profile,sizeof profile,"/tmp/chrome-dom-u2b-%d-%d",(int)getpid(),scene);
        tx_snprintf(option,sizeof option,"--user-data-dir=%s",profile);
        rc=cx_runv_timeout(av,15,&doc,&size);
        chd_wipe(profile);
        p=doc?strstr(doc,"<output id=\"pixels\">"):0;
        if(!rc && p) {
            p+=strlen("<output id=\"pixels\">");
            for(i=0;i<count;i++) {
                char delimiter=i+1<count?',':'<';
                if(sscanf(p,"%d%n",got+i,&used)!=1 || p[used]!=delimiter) { bad=1; break; }
                p+=used+1;
                if(got[i]!=expected[i]) bad=1;
            }
        } else bad=1;
        free(doc); doc=0;
        if(scene==3) {
            bad|=got[0]<5 || got[1]<150;
            printf("D3 arches=%d house=%d x %d per mille expected=%d,%d,%d failed=%d\n",
                got[0],got[1],got[2],expected[0],expected[1],expected[2],bad);
        } else {
            bad|=got[0]*5<deck*4 || got[1]*2<got[0] || got[2]<3 || got[3]<2 ||
                got[4]<18 || got[5]<365 || got[6]<590;
            printf("D4 tower=%d deck=%d wings=%d towers=%d domes=%d smoke=%d box=%d x %d per mille expected box=%d,%d failed=%d\n",
                got[0],deck,got[1],got[2],got[3],got[4],got[5],got[6],expected[5],expected[6],bad);
        }
        failed+=bad;
    }
    return failed?1:0;
}

static int check_v1(const char *mutation,int published) {
    enum { W=160,H=90,N=W*H };
    unsigned char cells[N];
    int queue[N],tier[4]={0},lum[3]={0},area[3]={0},largest=0,depth=0,used=0,i,rc;
    char cwd[1024],url[4096],profile[128],option[160],*doc=0;
    char *av[]={"google-chrome","--headless=new","--use-angle=swiftshader","--enable-unsafe-swiftshader",
        "--allow-file-access-from-files","--disable-background-networking","--window-size=1280,807",
        "--virtual-time-budget=6500","--dump-dom",option,url,0};
    size_t bytes=0;
    const char *p;
    if(!getcwd(cwd,sizeof cwd)) return 2;
    tx_snprintf(url,sizeof url,"file://%s/%s?v1-probe&%s",cwd,
        published?"docs/uxe/ink-walk/index.html":"ujs/practice/uxe/test/d3-bridge-v1.html",mutation);
    tx_snprintf(profile,sizeof profile,"/tmp/chrome-dom-v1-%d",(int)getpid());
    tx_snprintf(option,sizeof option,"--user-data-dir=%s",profile);
    rc=cx_runv_timeout(av,18,&doc,&bytes);
    chd_wipe(profile);
    p=doc?strstr(doc,"<output id=\"pixels\">"):0;
    if(rc || !p) { free(doc); return 2; }
    p+=strlen("<output id=\"pixels\">");
    if(sscanf(p,"%d|%n",&depth,&used)!=1 || !used || strlen(p+used)<N*7+9 || p[used+N*7]!='<') {
        free(doc); return 2;
    }
    p+=used;
    for(i=0;i<N;i++) {
        int code=p[i*7]-'0';
        if(code!=0 && code!=1 && code!=2 && code!=4 && code!=5) { free(doc); return 2; }
        cells[i]=(unsigned char)code;
        if(code==5) tier[3]++;
        else if(code) {
            int j=code==4?2:code-1;
            unsigned r,g,b;
            if(sscanf(p+i*7+1,"%2x%2x%2x",&r,&g,&b)!=3) { free(doc); return 2; }
            tier[j]++;
            lum[j]+=(30*r+59*g+11*b)/100;
        }
    }
    free(doc);
    for(i=0;i<N;i++) {
        int color=cells[i],len=1,j;
        if(!color || color==5) continue;
        queue[0]=i; cells[i]=0;
        for(j=0;j<len;j++) {
            int at=queue[j],k;
            int adjacent[]={at%W?at-1:-1,at%W+1<W?at+1:-1,at-W,at+W};
            for(k=0;k<4;k++) {
                int next=adjacent[k];
                if(next<0 || next>=N || cells[next]!=color) continue;
                cells[next]=0; queue[len++]=next;
            }
        }
        area[len<5?0:len<25?1:2]++;
        if(len>largest) largest=len;
    }
    for(i=0;i<3;i++) if(tier[i]) lum[i]/=tier[i];
    printf("V1 depth_mm=%d shades=%d,%d,%d luma=%d,%d,%d vines=%d components=%d,%d,%d largest=%d\n",
        depth,tier[0],tier[1],tier[2],lum[0],lum[1],lum[2],tier[3],area[0],area[1],area[2],largest);
    return depth<9000 || tier[0]<120 || tier[1]<120 || tier[2]<45 || tier[3]<30 ||
        lum[1]-lum[0]<15 || lum[2]-lum[1]<15 || area[1]<10 || area[2]<3 || largest<50;
}

static int check_v2(const char *mutation,int published) {
    enum { N=213*120 };
    int heights[64]={0},pixels[8]={0},span=0,roofs=0,levels=0,first=32000,last=0,i,used=0,rc;
    char cwd[1024],url[4096],profile[128],option[160],*doc=0;
    char *av[]={"google-chrome","--headless=new","--use-angle=swiftshader","--enable-unsafe-swiftshader",
        "--allow-file-access-from-files","--disable-background-networking","--window-size=1280,807",
        "--virtual-time-budget=6500","--dump-dom",option,url,0};
    size_t bytes=0;
    const char *p;
    if(!getcwd(cwd,sizeof cwd)) return 2;
    tx_snprintf(url,sizeof url,"file://%s/%s?v2-probe&%s",cwd,
        published?"docs/uxe/oneshot/index.html":"ujs/practice/uxe/test/d4-skeleton-v2.html",mutation);
    tx_snprintf(profile,sizeof profile,"/tmp/chrome-dom-v2-%d",(int)getpid());
    tx_snprintf(option,sizeof option,"--user-data-dir=%s",profile);
    rc=cx_runv_timeout(av,17,&doc,&bytes);
    chd_wipe(profile);
    p=doc?strstr(doc,"<output id=\"pixels\">"):0;
    if(rc || !p) { free(doc); return 2; }
    p+=strlen("<output id=\"pixels\">");
    if(sscanf(p,"%d%n",&span,&used)!=1 || !used) { free(doc); return 2; }
    p+=used;
    while(*p==',') {
        int h=0;
        if(++roofs>60 || sscanf(p+1,"%d%n",&h,&used)!=1 || h<0 || h>=32000) { free(doc); return 2; }
        heights[h/500]++;
        if(h<first) first=h;
        if(h>last) last=h;
        p+=used+1;
    }
    if(*p++!='|' || strlen(p)<N+9 || p[N]!='<') { free(doc); return 2; }
    for(i=0;i<N;i++) {
        int code=p[i]-'0';
        if(code<0 || code>7 || code==6 || code==7) { free(doc); return 2; }
        pixels[code]++;
    }
    free(doc);
    for(i=0;i<64;i++) levels+=heights[i]>=2;
    printf("V2 roofs=%d levels=%d range_mm=%d wings_mm=%d clock=%d rails=%d flags=%d hoops=%d rust=%d\n",
        roofs,levels,last-first,span,pixels[1],pixels[2],pixels[4],pixels[3],pixels[5]);
    return roofs<40 || levels<5 || last-first<3500 || span<7400 ||
        pixels[1]<18 || pixels[2]<25 || pixels[4]<7 || pixels[3]<18 || pixels[5]<8;
}

static int check_audit_town(const char *mutation,int smoke) {
    const int ticks[]={0,60,170};
    char cwd[1024],url[4096],profile[128],option[160],*doc=0;
    char *av[]={"google-chrome","--headless=new","--use-angle=swiftshader","--enable-unsafe-swiftshader",
        "--allow-file-access-from-files","--disable-background-networking","--window-size=1280,807",
        "--virtual-time-budget=6500","--dump-dom",option,url,0};
    int i,j,rc,failed=0,previous=-10000;
    size_t bytes=0;
    const char *p;
    if(!getcwd(cwd,sizeof cwd)) return 2;
    tx_snprintf(url,sizeof url,
        "file://%s/ujs/practice/uxe/test/%s?audit-check&%s",cwd,
        smoke==2?"d4-belly-x3.html":smoke?"d4-smoke-w2.html":"d4-skeleton-audit.html",mutation);
    tx_snprintf(profile,sizeof profile,"/tmp/chrome-dom-audit-town-%d",(int)getpid());
    tx_snprintf(option,sizeof option,"--user-data-dir=%s",profile);
    rc=cx_runv_timeout(av,18,&doc,&bytes);
    chd_wipe(profile);
    p=doc?strstr(doc,"<output id=\"pixels\">"):0;
    if(rc || !p) { free(doc); return 2; }
    p+=strlen("<output id=\"pixels\">");
    for(i=0;i<3;i++) {
        int got[12],tick=ticks[i],travel=tick*24,bad;
        double distance=travel>=4000?1.0:travel/4000.0;
        double blend=3*distance*distance-2*distance*distance*distance;
        int camera[]={rounded_mm(14000+travel+3000*blend),rounded_mm(11800+800*blend),
            rounded_mm(22000+15000*blend),rounded_mm(9400-2250*blend)};
        for(j=0;j<12;j++) {
            int n=0,term=j<11?',':i<2?';':'<';
            if(sscanf(p,"%d%n",got+j,&n)!=1 || !n || p[n]!=term) { free(doc); return 2; }
            p+=n+1;
        }
        bad=got[0]!=tick || got[5]<180 || got[5]>1100 || got[6]<180 || got[6]>550 || got[7]<=previous;
        for(j=0;j<4;j++) bad|=abs(got[j+1]-camera[j])>1;
        if(i==2) {
            bad|=got[7]<30;
            for(j=8;j<12;j++) bad|=got[j]<360 || got[j]>690;
        }
        previous=got[7];
        printf("AUDIT_D4 tick=%d eye=%d,%d,%d deck=%d,%d margin=%d feet_y=%d,%d,%d,%d failed=%d\n",
            got[0],got[1],got[2],got[3],got[5],got[6],got[7],got[8],got[9],got[10],got[11],bad);
        failed+=bad;
    }
    free(doc);
    return failed?1:0;
}

static double smoke_cos(double x) {
    const double pi=3.141592653589793;
    double sum=1,term=1;
    int n;
    while(x>pi) x-=2*pi;
    for(n=1;n<=11;n++) {
        term*=-x*x/((2*n-1)*(2*n));
        sum+=term;
    }
    return sum;
}

typedef struct { int visible,width,height,bottom; } GearPixels;

static int main_gear_pixels(const char *variant,GearPixels *result) {
    enum { ROWS=300, WIDTH=520 };
    char cwd[1024],url[4096],profile[128],option[160],*out=0;
    char *av[]={"google-chrome","--headless=new","--allow-file-access-from-files","--disable-background-networking",
        "--use-angle=swiftshader","--enable-unsafe-swiftshader","--virtual-time-budget=5500","--dump-dom",option,url,0};
    size_t size=0;
    if(!getcwd(cwd,sizeof cwd)) return 2;
    tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/d4-belly-x3.html?main-gear-check&%s",cwd,variant);
    tx_snprintf(profile,sizeof profile,"/tmp/chrome-dom-d4-main-gear-%d",(int)getpid());
    tx_snprintf(option,sizeof option,"--user-data-dir=%s",profile);
    int rc=cx_runv_timeout(av,15,&out,&size);
    chd_wipe(profile);
    const char *p=out?strstr(out,"<output id=\"pixels\">"):0;
    if(rc || !p) { free(out); return 2; }
    p+=strlen("<output id=\"pixels\">");
    int min_x=WIDTH,max_x=-1,min_y=ROWS,max_y=-1;
    result->visible=0;
    for(int row=0;row<ROWS;row++) {
        int lit,left,right,used=0;
        if(sscanf(p,"%d,%d,%d%n",&lit,&left,&right,&used)!=3 || lit<0 || lit>WIDTH ||
            (lit && (left<0 || right>=WIDTH || right-left+1<lit)) ||
            p[used]!=(row+1<ROWS?';':'<')) { free(out); return 2; }
        result->visible+=lit;
        if(lit) {
            if(left<min_x) min_x=left;
            if(right>max_x) max_x=right;
            if(row<min_y) min_y=row;
            max_y=row;
        }
        p+=used+1;
    }
    result->width=result->visible?max_x-min_x+1:0;
    result->height=result->visible?max_y-min_y+1:0;
    result->bottom=result->visible?min_y:0;
    free(out);
    return 0;
}

static int check_main_gear(const char *mutation) {
    enum { P7_VISIBLE_PIXELS=7114 };
    GearPixels baseline={0},visible={0};
    if(main_gear_pixels("bare-belly",&baseline) || main_gear_pixels(mutation,&visible)) return 2;
    int area=baseline.visible?1000*visible.visible/baseline.visible:0;
    int ratio=visible.height?1000*visible.width/visible.height:0;
    int bad=baseline.visible<P7_VISIBLE_PIXELS || 1000*visible.visible<900*baseline.visible ||
        1000*visible.visible>1300*baseline.visible || !visible.height || visible.bottom<3 ||
        1000*visible.width<850*visible.height || 1000*visible.width>1150*visible.height;
    printf("D4_MAIN_GEAR p7_pixels=%d candidate_pixels=%d area_permille=%d box=%dx%d ratio_permille=%d bottom_px=%d bad=%d\n",
        baseline.visible,visible.visible,area,visible.width,visible.height,ratio,visible.bottom,bad);
    return bad;
}

static int check_belly(const char *mutation) {
    char cwd[1024],url[4096],profile[128],option[160],*out=0;
    char *av[]={"google-chrome","--headless=new","--allow-file-access-from-files","--disable-background-networking",
        "--use-angle=swiftshader","--enable-unsafe-swiftshader","--virtual-time-budget=5500","--dump-dom",option,url,0};
    size_t bytes=0;
    if(!getcwd(cwd,sizeof cwd)) return 2;
    tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/d4-belly-x3.html?belly-check&%s",cwd,mutation);
    tx_snprintf(profile,sizeof profile,"/tmp/chrome-dom-d4-belly-%d",(int)getpid());
    tx_snprintf(option,sizeof option,"--user-data-dir=%s",profile);
    int rc=cx_runv_timeout(av,20,&out,&bytes);
    chd_wipe(profile);
    const char *p=out?strstr(out,"<output id=\"pixels\">"):0;
    if(rc || !p) { free(out); return 2; }
    p+=strlen("<output id=\"pixels\">");
    int upright=0,brace=0,rails=0,teeth=0,axles=0,span=0;
    int inner=0,core=0,outer=0;
    while(*p!='<') {
        char role[16];
        int x,y,z,w,h,d,used=0;
        if(sscanf(p,"%15[^,],%d,%d,%d,%d,%d,%d%n",role,&x,&y,&z,&w,&h,&d,&used)!=7 ||
            (p[used]!=';' && p[used]!='<') || w<=0 || h<=0 || d<=0) { free(out); return 2; }
        if(!strcmp(role,"upright") && h>=1700) { upright++; inner=z; }
        if(!strcmp(role,"brace") && h>=1200) brace++;
        if(!strcmp(role,"rail") && w>=9000) { rails++; outer=z; span=w; }
        if(!strcmp(role,"tooth")) { teeth++; core=z; }
        if(!strcmp(role,"axle")) axles++;
        p+=used+(p[used]==';');
    }
    int bad=upright<5 || brace<5 || rails<2 || teeth<60 || axles<6 || core-inner<350 || outer-core<200;
    printf("D4_BELLY inner=%d core=%d outer=%d span=%d upright=%d braces=%d rails=%d teeth=%d axles=%d bad=%d\n",
        inner,core,outer,span,upright,brace,rails,teeth,axles,bad);
    free(out);
    return bad;
}

static int check_w2(const char *mutation,int published) {
    const double sx[]={-4.9,.65,4.7},sy[]={11.90,14.20,11.44},winds[]={-.90,1.60,3.15};
    const double sizes[]={.20,.48,.77};
    char cwd[1024],url[4096],profile[128],option[160],*doc=0;
    char *av[]={"google-chrome","--headless=new","--use-angle=swiftshader","--enable-unsafe-swiftshader",
        "--allow-file-access-from-files","--disable-background-networking","--window-size=1280,807",
        "--virtual-time-budget=6500","--dump-dom",option,url,0};
    int i,n,failed=0,stack_read[3]={0};
    size_t bytes=0;
    const char *p;
    if(!getcwd(cwd,sizeof cwd)) return 2;
    tx_snprintf(url,sizeof url,"file://%s/%s?w2-check&%s",cwd,
        published==2?"ujs/practice/uxe/test/d4-belly-x3.html":
        published?"docs/uxe/oneshot/index.html":"ujs/practice/uxe/test/d4-smoke-w2.html",mutation);
    tx_snprintf(profile,sizeof profile,"/tmp/chrome-dom-w2-%d",(int)getpid());
    tx_snprintf(option,sizeof option,"--user-data-dir=%s",profile);
    int rc=cx_runv_timeout(av,16,&doc,&bytes);
    chd_wipe(profile);
    p=doc?strstr(doc,"<output id=\"pixels\">"):0;
    if(rc || !p) { free(doc); return 2; }
    p+=strlen("<output id=\"pixels\">");
    for(i=0;i<2;i++) {
        int tick,travel,count,used=0,bad=0,behind=0,small=0,medium=0,large=0;
        if(sscanf(p,"%d,%d,%d%n",&tick,&travel,&count,&used)!=3 || count<1 || count>45) { free(doc); return 2; }
        p+=used;
        bad=tick!=60*i || travel!=1440*i || count!=45;
        for(n=0;n<count;n++) {
            int x,y,size,stack=n/15,j=n%15,age_ticks=(60*i+8*j+37*stack)%120;
            int tier=j%5==4?0:j%5==2?1:2,emission=60*i-age_ticks;
            double age=age_ticks/120.0,release=emission>0?emission*.024:0;
            double fade_in=.25+9*age,fade_out=9*(1-age);
            double fade=fade_in<fade_out?fade_in:fade_out;
            if(fade>1) fade=1;
            double drift=age*winds[stack]+smoke_cos(j*2.4+stack*.61)*age*(tier==0?1.08:.56);
            double lift=age*(2.65+.82*age);
            double ex=1000*(sx[stack]+release+drift),ey=1000*(sy[stack]-.45+lift);
            double es=1000*sizes[tier]*(.75+.88*age)*fade;
            if(sscanf(p,",%d,%d,%d%n",&x,&y,&size,&used)!=3) { free(doc); return 2; }
            p+=used;
            bad|=x<ex-1 || x>ex+1 || y<ey-1 || y>ey+1 || size<es-1 || size>es+1;
            if(i) {
                behind+=1000*(sx[stack]+drift)+travel-x>=350;
                stack_read[stack]+=y>1000*(sy[stack]+1);
            }
            small+=tier==0 && size<350;
            medium+=tier==1 && size>=350 && size<690;
            large+=tier==2 && size>=690;
        }
        if(*p++!=(i==0?';':'|')) { free(doc); return 2; }
        bad|=small<8 || medium<5 || large<9 || (i && behind<24);
        printf("W2 tick=%d smoke=%d tiers=%d,%d,%d trailing=%d columns=%d,%d,%d failed=%d\n",
            tick,count,small,medium,large,behind,stack_read[0],stack_read[1],stack_read[2],bad);
        failed+=bad;
    }
    int pixels[8]={0};
    if(strlen(p)<256*70+1 || p[256*70]!='<') { free(doc); return 2; }
    for(i=0;i<256*70;i++) {
        int color=p[i]-'0';
        if(color<0 || color>7) { free(doc); return 2; }
        pixels[color]++;
    }
    printf("W2 visible_smoke=%d,%d,%d\n",pixels[1],pixels[2],pixels[4]);
    free(doc);
    return failed || stack_read[0]<5 || stack_read[1]<5 || stack_read[2]<5 ||
        (pixels[1]>=16)+(pixels[2]>=16)+(pixels[4]>=16)<2;
}

static int check_w3(const char *mutation,int published) {
    enum { SAMPLES=256*88 };
    const int ticks[]={0,18,38};
    char cwd[1024],url[4096],profile[128],option[160],*doc=0;
    char *av[]={"google-chrome","--headless=new","--use-angle=swiftshader","--enable-unsafe-swiftshader",
        "--allow-file-access-from-files","--disable-background-networking","--window-size=1280,807",
        "--virtual-time-budget=6500","--dump-dom",option,url,0};
    int phase,roll[3],seen[8]={0},used=0,i,failed=0,rc;
    size_t bytes=0;
    const char *p;
    if(!getcwd(cwd,sizeof cwd)) return 2;
    tx_snprintf(url,sizeof url,"file://%s/%s?w3-check&%s",cwd,
        published?"docs/uxe/ink-walk/index.html":"ujs/practice/uxe/test/d3-deck-w3.html",mutation);
    tx_snprintf(profile,sizeof profile,"/tmp/chrome-dom-w3-%d",(int)getpid());
    tx_snprintf(option,sizeof option,"--user-data-dir=%s",profile);
    rc=cx_runv_timeout(av,18,&doc,&bytes);
    chd_wipe(profile);
    p=doc?strstr(doc,"<output id=\"pixels\">"):0;
    if(rc || !p) { free(doc); return 2; }
    p+=strlen("<output id=\"pixels\">");
    if(sscanf(p,"%d,%d,%d,%d|%n",&phase,roll,roll+1,roll+2,&used)!=4 || !used ||
        strlen(p+used)<SAMPLES+1 || p[used+SAMPLES]!='<') { free(doc); return 2; }
    p+=used;
    for(i=0;i<3;i++) {
        int t=(ticks[i]+phase+480)%48;
        int bend=t<24?t-12:36-t;
        int expected=-169+bend*6;
        failed+=abs(roll[i]-expected)>1 || roll[i]>=0;
    }
    for(i=0;i<SAMPLES;i++) {
        int c=p[i]-'0';
        if(c<0 || c>7) { free(doc); return 2; }
        seen[c]++;
    }
    free(doc);
    failed+=seen[1]<70 || seen[2]<600 || seen[4]<20;
    printf("W3 grass_roll_mrad=%d,%d,%d deck_seams=%d slab=%d wear=%d failed=%d\n",
        roll[0],roll[1],roll[2],seen[1],seen[2],seen[4],failed);
    return failed!=0;
}

static int check_d4_play(const char *mutation) {
    char cwd[1024],url[4096],profile[128],option[160],*doc=0;
    char *av[]={"google-chrome","--headless=new","--use-angle=swiftshader","--enable-unsafe-swiftshader",
        "--allow-file-access-from-files","--disable-background-networking","--window-size=1280,807",
        "--virtual-time-budget=6500","--dump-dom",option,url,0};
    int i,rc,failed=0;
    size_t bytes=0;
    const char *p;
    if(!getcwd(cwd,sizeof cwd)) return 2;
    tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/d4-skeleton.html?play-check&%s",cwd,mutation);
    tx_snprintf(profile,sizeof profile,"/tmp/chrome-dom-d4-play-%d",(int)getpid());
    tx_snprintf(option,sizeof option,"--user-data-dir=%s",profile);
    rc=cx_runv_timeout(av,18,&doc,&bytes);
    chd_wipe(profile);
    p=doc?strstr(doc,"<output id=\"pixels\">"):0;
    if(rc || !p) { free(doc); return 2; }
    p+=strlen("<output id=\"pixels\">");
    for(i=0;i<5;i++) {
        int got[4],used=0,tick=i*40;
        int move=(i==2 || i==3)?40*20*12/10:0;
        int lift=4570+((tick%120)*1650+60)/120;
        int bad;
        if(sscanf(p,"%d,%d,%d,%d%n",got,got+1,got+2,got+3,&used)!=4 ||
            p[used]!=(i==4?'<':';')) { free(doc); return 2; }
        p+=used+1;
        bad=got[0]!=tick || got[1]!=move || got[2]!=14000+move || got[3]<lift-1 || got[3]>lift+1;
        failed+=bad;
        printf("D4 tick=%d deck=%d eye=%d smoke relative=%d expected=%d,%d,%d failed=%d\n",
            got[0],got[1],got[2],got[3],move,14000+move,lift,bad);
    }
    free(doc);
    return failed?1:0;
}

static int check_u2c(const char *mutation) {
    char cwd[1024],url[4096],profile[128],option[160],*doc=0;
    const char *region="&region=236,244,39,28,4";
    char *av[]={"google-chrome","--headless=new","--use-angle=swiftshader","--enable-unsafe-swiftshader",
        "--allow-file-access-from-files","--disable-background-networking","--window-size=1280,807",
        "--virtual-time-budget=6500","--dump-dom",option,url,0};
    int scene,failed=0;
    size_t bytes=0;
    if(!getcwd(cwd,sizeof cwd)) return 2;
    for(scene=3;scene<=4;scene++) {
        int n=scene==3?39*28:128*72,i,used,rc,bins[32]={0},shades=0,warm=0,plume=0,area=0;
        long sum=0,squares=0;
        const char *p;
        tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/%s.html?finish-u2c&u2c-probe&%s%s",
            cwd,scene==3?"d3-bridge":"d4-skeleton",mutation,scene==3?region:"");
        tx_snprintf(profile,sizeof profile,"/tmp/chrome-dom-u2c-%d-%d",(int)getpid(),scene);
        tx_snprintf(option,sizeof option,"--user-data-dir=%s",profile);
        rc=cx_runv_timeout(av,15,&doc,&bytes);
        chd_wipe(profile);
        p=doc?strstr(doc,"<output id=\"pixels\">"):0;
        if(rc || !p) { free(doc); return 2; }
        p+=strlen("<output id=\"pixels\">");
        for(i=0;i<n;i++) {
            int r,g,b,luma;
            if(sscanf(p,"%d,%d,%d%n",&r,&g,&b,&used)!=3 || p[used]!=(i+1==n?'<':';') ||
                r<0 || r>255 || g<0 || g>255 || b<0 || b>255) { free(doc); return 2; }
            p+=used+1;
            luma=(30*r+59*g+11*b)/100;
            if(scene==3 && r>=g+5 && g>=b+7 && luma>=90) {
                bins[luma/8]++;
                warm++;
                sum+=luma;
                squares+=luma*luma;
            }
            if(scene==4 && i%128>=32 && i%128<116 && i/128<19) {
                area++;
                plume+=luma>=176 && b-r>=-13 && b-r<=35 && g-r>=-8 && g-r<=23;
            }
        }
        free(doc); doc=0;
        if(scene==3) {
            int variance=warm?(int)((squares*warm-sum*sum)/((long)warm*warm)):0;
            for(i=0;i<32;i++) shades+=bins[i]>=4;
            printf("D3 warm=%d shades=%d wall variance=%d\n",warm,shades,variance);
            failed+=warm<250 || shades<7 || variance<80;
        } else {
            int ratio=plume*1000/area;
            printf("D4 upper plumes=%d/%d area per mille=%d\n",plume,area,ratio);
            failed+=ratio<90;
        }
    }
    return failed?1:0;
}

static int check_u2(const char *mutation) {
    char cwd[1024],url[5000],profile[128],option[160],*out=0,*spec;
    char *av[]={"google-chrome","--headless=new","--use-angle=swiftshader","--enable-unsafe-swiftshader",
        "--allow-file-access-from-files","--disable-background-networking","--window-size=1280,807",
        "--virtual-time-budget=5000","--dump-dom",option,url,0};
    const char *p;
    int houses=0,gears=1,pipes=0,scene,failed=0;
    size_t size=0;
    spec=cx_read("ujs/practice/uxe/test/d4-dense-town.tsv",&size);
    p=spec?strchr(spec,'\n'):0;
    while(p && p[1]) {
        p++;
        houses+=!strncmp(p,"house-",6);
        gears+=!strncmp(p,"gear\t",5);
        pipes+=!strncmp(p,"pipe\t",5);
        p=strchr(p,'\n');
    }
    free(spec);
    if(houses<40 || gears<6 || pipes<10 || !getcwd(cwd,sizeof cwd)) return 2;
    for(scene=3;scene<=4;scene++) {
        int x0=scene==3?704:642,y0=scene==3?192:231;
        int n=0,at,x,y,i,counts[7]={0},sum=0,sum2=0,edge=0,last=0,variance;
        at=tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/%s.html?dense-u2=1&u2-probe=1&%s&pixels=",
            cwd,scene==3?"d3-bridge":"d4-skeleton",mutation);
        for(y=y0;y<y0+64;y+=4) for(x=x0;x<x0+64;x+=4) {
            int w=tx_snprintf(url+at,sizeof url-at,"%s%d,%d",n?";":"",x,y);
            if(w<0 || w>=(int)sizeof url-at) return 2;
            at+=w; n++;
        }
        tx_snprintf(profile,sizeof profile,"/tmp/chrome-dom-u2-%d-%d",(int)getpid(),scene);
        tx_snprintf(option,sizeof option,"--user-data-dir=%s",profile);
        out=0;
        at=cx_runv_timeout(av,14,&out,&size);
        chd_wipe(profile);
        p=out?strstr(out,"<output id=\"pixels\">"):0;
        if(at || !p) { free(out); return 2; }
        p+=strlen("<output id=\"pixels\">");
        for(i=0;i<(scene==3?2:7);i++) {
            int used=0,term=i+1<(scene==3?2:7)?',':'|';
            if(sscanf(p,"%d%n",counts+i,&used)!=1 || used==0 || p[used]!=term) {
                free(out); return 2;
            }
            p+=used+1;
        }
        for(i=0;i<n;i++) {
            int r,g,b,used=0,luma;
            if(sscanf(p,"%d,%d,%d%n",&r,&g,&b,&used)!=3 || used==0 ||
                r<0 || r>255 || g<0 || g>255 || b<0 || b>255) { free(out); return 2; }
            p+=used;
            if(i+1<n && *p++!=';') { free(out); return 2; }
            luma=(30*r+59*g+11*b+50)/100;
            sum+=luma; sum2+=luma*luma;
            if(i%16) edge+=(luma-last)*(luma-last);
            last=luma;
        }
        at=strncmp(p,"</output>",9)!=0;
        free(out);
        if(at) return 2;
        variance=(int)(((long)sum2*n-(long)sum*sum)/(n*n));
        if(scene==3) {
            failed+=counts[0]<1200 || counts[1]<1600 || edge/240<750 || variance<500;
            printf("UXE_U2_D3 tree_patches=%d grass=%d stone_variance=%d stroke_variance=%d\n",
                counts[0],counts[1],variance,edge/240);
        } else {
            failed+=counts[0]!=houses || counts[1]<170 || counts[2]!=houses || counts[3]<25 ||
                counts[4]<12 || counts[5]!=gears || counts[6]!=pipes || variance<5500;
            printf("UXE_U2_D4 houses=%d windows=%d eaves=%d chimneys=%d arcades=%d gears=%d pipes=%d facade_variance=%d\n",
                counts[0],counts[1],counts[2],counts[3],counts[4],counts[5],counts[6],variance);
        }
    }
    printf("CHECK_UXE_U2 failed=%d\n",failed);
    return failed!=0;
}

static int check_bridge_walk(const char *mutation,int audit) {
    static const int ticks[]={0,60,146,310,340};
    char cwd[1024],url[1700],profile[128],option[160],*out=0,*facts;
    char *av[]={"google-chrome","--headless=new","--use-angle=swiftshader","--enable-unsafe-swiftshader",
        "--allow-file-access-from-files","--disable-background-networking","--window-size=1280,807",
        "--virtual-time-budget=5000","--dump-dom",option,url,0};
    const char *p;
    int route[12][7],n=0,i,j,k,at,advance=0,previous=0,path_fail=0,wind_fail=0,image_changes=0;
    int old[9]={0};
    size_t size=0;
    if(!getcwd(cwd,sizeof cwd)) return 2;
    facts=cx_read(audit?"ujs/practice/uxe/test/d3-walk-audit.tsv":"ujs/practice/uxe/test/d3-walk.tsv",&size);
    p=facts?strchr(facts,'\n'):0;
    while(p && p[1] && n<12) {
        int *row=route[n];
        p++;
        if(sscanf(p,"%d %d %d %d %d %d %d",row,row+1,row+2,row+3,row+4,row+5,row+6)!=7 ||
            (n && row[0]<=route[n-1][0])) { free(facts); return 2; }
        n++;
        p=strchr(p,'\n');
    }
    free(facts);
    if(n<2 || route[0][0]!=0) return 2;
    tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/%s?walk-check=1&%s",
        cwd,audit==2?"d3-deck-w3.html":audit?"d3-bridge-audit.html":"d3-bridge.html",mutation);
    tx_snprintf(profile,sizeof profile,"/tmp/chrome-dom-d3-walk-%d",(int)getpid());
    tx_snprintf(option,sizeof option,"--user-data-dir=%s",profile);
    at=cx_runv_timeout(av,18,&out,&size);
    chd_wipe(profile);
    p=out?strstr(out,"<output id=\"pixels\">"):0;
    if(at || !p) { free(out); return 2; }
    p+=strlen("<output id=\"pixels\">");
    for(i=0;i<5;i++) {
        int frame[15],visible=0,path[4];
        for(j=0;j<15;j++) {
            int consumed=0;
            if(sscanf(p,"%d%n",frame+j,&consumed)!=1 || consumed==0) { free(out); return 2; }
            p+=consumed;
            if(j<14 && *p++!=',') { free(out); return 2; }
        }
        if(i<4 && *p++!=';') { free(out); return 2; }
        advance+=(i==4?-180:180)*(ticks[i]-previous);
        previous=ticks[i];
        if(advance>route[n-1][0]) advance=route[n-1][0];
        if(advance<0) advance=0;
        for(k=1;k<n-1 && route[k][0]<advance;k++) {}
        path[0]=advance;
        for(j=1;j<4;j++)
            path[j]=rounded_mm(route[k-1][j]+(route[k][j]-route[k-1][j])*
                (double)(advance-route[k-1][0])/(route[k][0]-route[k-1][0]));
        for(j=0;j<4;j++) path_fail+=abs(frame[j]-path[j])>1;
        wind_fail+=abs(frame[4]-(audit==2?241:168))>2 || abs(frame[5]-96)>2;
        for(j=0;j<9;j++) {
            visible|=abs(frame[6+j]-old[j])>10;
            old[j]=frame[6+j];
        }
        image_changes+=i>0 && visible;
        printf("D3_WALK tick=%d distance=%d eye=%d,%d,%d grass=%d leaves=%d\n",ticks[i],
            frame[0],frame[1],frame[2],frame[3],frame[4],frame[5]);
    }
    at=strncmp(p,"</output>",9)!=0;
    free(out);
    if(at) return 2;
    printf("D3_WALK_CHECK path_fail=%d wind_fail=%d picture_changes=%d\n",path_fail,wind_fail,image_changes);
    return path_fail || wind_fail || image_changes<3;
}

enum { PAPER_W=960, PAPER_H=540, PAPER_TILE=60 };

static unsigned char *paper_pixels(char *file,int reference) {
    char *out=0;
    size_t size=0;
    char *av[]={"convert",file,"-crop",reference?"960x485+8+8":"1280x720+0+0",
        "+repage","-resize","960x540!","-alpha","off","-colorspace","Gray","-depth","8","gray:-",0};
    if(cx_runv_timeout(av,8,&out,&size) || size!=PAPER_W*PAPER_H) {
        fprintf(stderr,"UXE_U3 image read failed: %s (%zu bytes)\n",file,size);
        free(out);
        return 0;
    }
    return (unsigned char *)out;
}

static void paper_block(const unsigned char *image,int x0,int y0,int *contrast,int *texture) {
    long sum=0,squares=0,grain=0;
    int x,y,n=PAPER_TILE*PAPER_TILE;
    for(y=y0;y<y0+PAPER_TILE;y++) for(x=x0;x<x0+PAPER_TILE;x++) {
        int i=y*PAPER_W+x,v=image[i];
        sum+=v;
        squares+=v*v;
        if(x>x0 && y>y0) {
            int d=abs(2*v-image[i-1]-image[i-PAPER_W]);
            grain+=d<12?d:12;
        }
    }
    *contrast=(int)((squares*n-sum*sum)/(n*n));
    *texture=(int)(grain*100/((PAPER_TILE-1)*(PAPER_TILE-1)));
}

static int compare_paper(char **paths) {
    char *refs[]={"ujs/plans/demo-v2/ref/d3/frames/04.png","ujs/plans/demo-v2/ref/d4/frames/13.png"};
    int scene,failed=0;
    puts("scene\tx\ty\tref_variance\tplain_variance\tpaper_variance\tref_texture\tplain_texture\tpaper_texture\tpaper_delta");
    for(scene=0;scene<2;scene++) {
        unsigned char *ref=paper_pixels(refs[scene],1);
        unsigned char *plain=paper_pixels(paths[2*scene],0);
        unsigned char *paper=paper_pixels(paths[2*scene+1],0);
        int x,y,edited=0,texture_gain=0,contrast_gap[2]={0},texture_gap[2]={0};
        if(!ref || !plain || !paper) { free(ref); free(plain); free(paper); return 2; }
        for(y=0;y<PAPER_H;y+=PAPER_TILE) for(x=0;x<PAPER_W;x+=PAPER_TILE) {
            int c[3],t[3],u,v,delta=0;
            paper_block(ref,x,y,c,t);
            paper_block(plain,x,y,c+1,t+1);
            paper_block(paper,x,y,c+2,t+2);
            for(v=y;v<y+PAPER_TILE;v++) for(u=x;u<x+PAPER_TILE;u++) {
                int i=v*PAPER_W+u;
                delta+=abs(plain[i]-paper[i]);
            }
            delta=delta*100/(PAPER_TILE*PAPER_TILE);
            edited+=delta>=65 && delta<=380;
            texture_gain+=t[2]>=t[1]+20;
            for(u=0;u<2;u++) {
                contrast_gap[u]+=abs(c[0]-c[u+1]);
                texture_gap[u]+=abs(t[0]-t[u+1]);
            }
            printf("D%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\n",
                scene+3,x,y,c[0],c[1],c[2],t[0],t[1],t[2],delta);
        }
        free(ref); free(plain); free(paper);
        failed+=edited<120 || texture_gain<75 || contrast_gap[1]>contrast_gap[0]*102/100;
        printf("UXE_U3_D%d blocks=144 edited=%d texture_gain=%d texture_gap_plain=%d texture_gap_paper=%d contrast_gap_plain=%d contrast_gap_paper=%d\n",
            scene+3,edited,texture_gain,texture_gap[0],texture_gap[1],contrast_gap[0],contrast_gap[1]);
    }
    printf("CHECK_UXE_U3 failed=%d\n",failed);
    return failed?1:0;
}

int main(int argc,char **argv) {
    if((argc==2 || argc==3) && (!strcmp(argv[1],"w3") || !strcmp(argv[1],"published-w3")))
        return check_w3(argc==3?argv[2]:"",argv[1][0]=='p');
    if((argc==2 || argc==3) && !strcmp(argv[1],"w3-path")) return check_bridge_walk(argc==3?argv[2]:"",2);
    if(argc==2 && !strcmp(argv[1],"main-gear")) return check_main_gear("");
    if(argc==2 && (!strcmp(argv[1],"no-main-gear") || !strcmp(argv[1],"recessed-main-gear") || !strcmp(argv[1],"tilted-main-gear")))
        return check_main_gear(argv[1]);
    if(argc==2 && !strcmp(argv[1],"belly")) return check_belly("");
    if(argc==2 && (!strcmp(argv[1],"bare-belly") || !strcmp(argv[1],"flat-belly"))) return check_belly(argv[1]);
    if(argc==2 && !strcmp(argv[1],"belly-smoke")) return check_w2("",2);
    if(argc==2 && !strcmp(argv[1],"belly-camera")) return check_audit_town("",2);
    if((argc==2 || argc==3) && (!strcmp(argv[1],"w2") || !strcmp(argv[1],"published-w2")))
        return check_w2(argc==3?argv[2]:"",argv[1][0]=='p');
    if((argc==2 || argc==3) && (!strcmp(argv[1],"audit-town") || !strcmp(argv[1],"w2-camera")))
        return check_audit_town(argc==3?argv[2]:"",argv[1][0]=='w');
    if(argc>=2 && argc<=3 && (!strcmp(argv[1],"v2") || !strcmp(argv[1],"published-v2")))
        return check_v2(argc==3?argv[2]:"",argv[1][0]=='p');
    if(argc>=2 && argc<=3 && (!strcmp(argv[1],"v1") || !strcmp(argv[1],"published-v1")))
        return check_v1(argc==3?argv[2]:"",argv[1][0]=='p');
    if(argc>=2 && argc<=3 && !strcmp(argv[1],"d4-play")) return check_d4_play(argc==3?argv[2]:"");
    if(argc>=2 && argc<=3 && !strcmp(argv[1],"finish-u2c")) return check_u2c(argc==3?argv[2]:"");
    if(argc>=2 && argc<=3 && !strcmp(argv[1],"scale-u2b")) return check_u2b(argc==3?argv[2]:"");
    if(argc==6 && !strcmp(argv[1],"paper-u3")) return compare_paper(argv+2);
    if(argc==2 && !strcmp(argv[1],"dense-u2")) return check_u2("");
    if(argc==2 && (!strcmp(argv[1],"thin-u2-town") || !strcmp(argv[1],"plain-u2-bricks") ||
        !strcmp(argv[1],"thin-u2-plant") || !strcmp(argv[1],"no-u2-fittings"))) return check_u2(argv[1]);
    if(argc==2 && !strcmp(argv[1],"render-u1")) return check_u1("");
    if(argc==2 && (!strcmp(argv[1],"no-u1-shadow") || !strcmp(argv[1],"no-u1-grade") ||
        !strcmp(argv[1],"no-u1-fog"))) return check_u1(argv[1]);
    if((argc==2 || argc==3) && !strcmp(argv[1],"audit-walk")) return check_bridge_walk(argc==3?argv[2]:"",1);
    if(argc==2 && !strcmp(argv[1],"walk")) return check_bridge_walk("",0);
    if(argc==2 && (!strcmp(argv[1],"frozen-path") || !strcmp(argv[1],"still-wind"))) return check_bridge_walk(argv[1],0);
    char cwd[1024],url[2200],profile[128],option[160],*out=0;
    size_t size=0;
    char *av[]={"google-chrome","--headless=new","--use-angle=swiftshader",
        "--enable-unsafe-swiftshader","--allow-file-access-from-files",
        "--window-size=1280,807","--virtual-time-budget=3000","--no-first-run",option,"--dump-dom",url,0};
    int i, rc, failed=0, used, n=sizeof points/sizeof points[0];
    const char *mode=argc==1 ? "normal" : argv[1], *p;
    int sky=!strcmp(mode,"sky") || !strcmp(mode,"cloudless");
    int crowns=!strcmp(mode,"crowns") || !strcmp(mode,"sparse");
    int canopy=!strcmp(mode,"canopy") || !strcmp(mode,"thin-canopy");
    int rails=!strcmp(mode,"rails") || !strcmp(mode,"no-rails");
    int warm=!strcmp(mode,"leaf-light") || !strcmp(mode,"no-leaf-light");
    int palette=warm || !strcmp(mode,"palette") || !strcmp(mode,"old-palette");
    int feather=!strcmp(mode,"cloud-edge") || !strcmp(mode,"hard-cloud-edge");
    int leaf_shape=!strcmp(mode,"leaf-shape") || !strcmp(mode,"angular-leaf");
    int volume=!strcmp(mode,"cloud-volume") || !strcmp(mode,"flat-cloud");
    int paint[7][3]={{0}};
    int composition=rails || !strcmp(mode,"composition") || !strcmp(mode,"short-composition");
    int layout[8]={0};
    int ground=!strcmp(mode,"ground") || !strcmp(mode,"flat-ground");
    if(argc>2 || (!sky && !crowns && !canopy && !ground && !composition && !palette && !leaf_shape && !volume && !feather && strcmp(mode,"normal") && strcmp(mode,"sealed") && strcmp(mode,"bare") && strcmp(mode,"low-crown"))) return 2;
    if(!survey()) { printf("FAIL D3_SURVEY\n"); return 2; }
    if(!getcwd(cwd,sizeof cwd)) return 2;
    used=tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/d3-bridge.html?mode=%s&pixels=",cwd,mode);
    if(used<0 || used>=(int)sizeof url) return 2;
    if(composition) {
        size_t bytes=0;
        char *data=cx_read("ujs/practice/uxe/test/d3-composition.tsv",&bytes);
        char *line=data?strchr(data,'\n'):0;
        double deck;
        int fields=line?sscanf(line+1,"%d %d %d %d %d %d %d %d",
            &layout[0],&layout[1],&layout[2],&layout[3],&layout[4],&layout[5],&layout[6],&layout[7]):0;
        if(data) free(data);
        if(fields!=8 || layout[1]>500 || layout[2]>=19000 || layout[3]<1500 ||
            layout[3]>2000 || layout[5]<5500 || layout[6]<4000 || layout[7]<3500) return 2;
        deck=center_base+(center_deck-center_base)*layout[3]/1000.0;
        n=4;
        points[0].name="tall-fascia"; points[0].x=0; points[0].y=deck-.55;
        points[0].z=2.5; points[0].material=STONE;
        points[1].name="upper-opening"; points[1].x=0; points[1].y=deck-3.3;
        points[1].z=1; points[1].material=SKY;
        for(i=2;i<4;i++) {
            points[i].name=i==2?"house-upper-wall":"house-wide-wall";
            points[i].x=layout[4]/1000.0-(i==2?0:layout[5]*.00032);
            points[i].y=deck+layout[6]*.00072;
            points[i].z=-1+layout[7]/2000.0;
            points[i].material=PLASTER;
        }
        if(rails) {
            n=10;
            for(i=0;i<9;i++) {
                int column=i/3, part=i%3;
                points[i].name=part==0?"post-center":part==1?"beside-post":"stone-face";
                points[i].x=-3+column*3+(part==1?.27:0);
                points[i].y=deck+(part==2?-.44:.32);
                points[i].z=part==2?2.5:2.34;
                points[i].material=part==0?LINE:part==1?SKY:STONE;
            }
            points[9].name="right-rail-in-frame";
            points[9].x=12; points[9].y=deck+.52; points[9].z=2.34; points[9].material=LINE;
        }
    }
    if(sky) {
        n=4;
        if(tx_snprintf(url+used,sizeof url-used,"600,40;600,220;220,125;220,243") >= (int)sizeof url-used) return 2;
    }
    if(crowns || canopy) {
        n=120;
        for(i=0;i<n;i++) {
            int x=canopy?615+i%12*52:765+i%12*14;
            int y=canopy?404+i/12*30:387+i/12*15;
            int w=tx_snprintf(url+used,sizeof url-used,"%s%d,%d",i?";":"",x,y);
            if(w<0 || w>=(int)sizeof url-used) return 2;
            used+=w;
        }
    }
    if(ground) {
        n=144;
        for(i=0;i<n;i++) {
            int j=i%72;
            int x=(i<72?215:355)+j%12*(i<72?34:8);
            int y=(i<72?576:424)+j/12*(i<72?23:25);
            int w=tx_snprintf(url+used,sizeof url-used,"%s%d,%d",i?";":"",x,y);
            if(w<0 || w>=(int)sizeof url-used) return 2;
            used+=w;
        }
    }
    if(palette) {
        size_t bytes=0;
        char *data=cx_read("ujs/practice/uxe/test/d3-palette.tsv",&bytes);
        char *line=data?strchr(data,'\n'):0;
        static const char *roles[]={"skyTop","skyHorizon","leafLight","leafDark","stone","barrel","leaf.light"};
        for(i=0;line && i<7;i++) {
            char role[32];
            if(sscanf(line+1,"%31s %d %d %d",role,&paint[i][0],&paint[i][1],&paint[i][2])!=4 ||
                strcmp(role,roles[i])) break;
            line=strchr(line+1,'\n');
        }
        if(data) free(data);
        if(i!=7) return 2;
        n=122;
        for(i=0;i<n;i++) {
            int j=i-2;
            int x=i==0?600:i==1?35:155+j%12*96;
            int y=i==0?40:i==1?315:188+j/12*53;
            int w=tx_snprintf(url+used,sizeof url-used,"%s%d,%d",i?";":"",x,y);
            if(w<0 || w>=(int)sizeof url-used) return 2;
            used+=w;
        }
    }
    if(leaf_shape) {
        n=LEAF_W*LEAF_H;
        if(tx_snprintf(url+used,sizeof url-used,"&region=755,337,%d,%d,4",LEAF_W,LEAF_H)>=(int)sizeof url-used) return 2;
    }
    if(volume) {
        n=216;
        if(tx_snprintf(url+used,sizeof url-used,"&region=110,100,18,12,13") >= (int)sizeof url-used) return 2;
    }
    if(feather) {
        n=240;
        for(i=0;i<n;i++) {
            int written=tx_snprintf(url+used,sizeof url-used,"%s%d,%d",i?";":"",152+(i/80)*54,53+i%80);
            if(written<0 || written>=(int)sizeof url-used) return 2;
            used+=written;
        }
    }
    for(i=0;!sky && !crowns && !canopy && !ground && !palette && !leaf_shape && !volume && !feather && i<n;i++) {
        double x=points[i].x-10, y=points[i].y-1, z=points[i].z-19;
        double across=.8*x-.6*z, ground=.6*x+.8*z;
        double depth=(9*y-40*ground)/41;
        double up=(40*y+9*ground)/41;
        if(composition) {
            x=points[i].x-layout[0]/1000.0;
            y=points[i].y-layout[1]/1000.0;
            z=points[i].z-layout[2]/1000.0;
            across=(12*x-5*z)/13;
            ground=(5*x+12*z)/13;
            depth=(5*y-12*ground)/13;
            up=(12*y+5*ground)/13;
        }
        int px=(int)(640+640*across/depth), py=(int)(360-640*up/depth);
        int w;
        if(depth<=0 || px<0 || px>=1280 || py<0 || py>=720) return 2;
        w=tx_snprintf(url+used,sizeof url-used,"%s%d,%d",i?";":"",px,py);
        if(w<0 || w>=(int)sizeof url-used) return 2;
        used+=w;
    }
    if(tx_snprintf(profile,sizeof profile,"/tmp/chrome-dom-d3-%d",(int)getpid())>=(int)sizeof profile) return 2;
    if(tx_snprintf(option,sizeof option,"--user-data-dir=%s",profile)>=(int)sizeof option) return 2;
    rc=cx_runv_timeout(av,30,&out,&size);
    chd_wipe(profile);
    p=out?strstr(out,"<output id=\"pixels\">"):0;
    if(rc || !p) { printf("FAIL D3_BROWSER rc=%d\n",rc); return 2; }
    p+=strlen("<output id=\"pixels\">");
    {
    int sky_red[4]={0}, leaves=0,dark=0,grass=0,rock=0,paint_hits[7]={0},cloud_bands[3]={0};
    int max_step=0,previous=0,range_min=255,range_max=0;
    for(i=0;i<n;i++) {
        int c[3], j, observed, want;
        for(j=0;j<3;j++) {
            if(*p<'0'||*p>'9') return 2;
            c[j]=0;
            while(*p>='0'&&*p<='9') { c[j]=10*c[j]+*p++-'0'; if(c[j]>255) return 2; }
            if(j<2 && *p++!=',') return 2;
        }
        if(i+1<n && *p++!=';') return 2;
        if(feather) {
            int step=abs(c[0]-previous);
            if(i%80 && step>max_step) max_step=step;
            if(c[0]<range_min) range_min=c[0];
            if(c[0]>range_max) range_max=c[0];
            previous=c[0];
            continue;
        }
        if(leaf_shape) {
            int blue=c[2]>c[1]+20 && c[0]<55 && c[1]<90 && c[2]<130;
            int green=c[1]>c[0]+22 && c[1]>c[2]+10 && c[0]<115;
            leaf_tiles[i]=blue && c[1]<51?2:blue||green?1:0;
            continue;
        }
        if(volume) {
            if(c[2]>c[0] && c[2]-c[0]<=22 && c[0]>=145)
                cloud_bands[c[0]<182?0:c[0]<218?1:2]++;
            continue;
        }
        if(sky) {
            sky_red[i]=c[0];
            if(i<2) failed+=c[2]<=c[0]+50;
            else failed+=c[2]>c[0]+25 || c[0]<175;
            continue;
        }
        if(palette) {
            if(i<2) {
                int row=i==0?5:39;
                for(j=0;j<3;j++) {
                    int expected=paint[0][j]+(paint[1][j]-paint[0][j])*row/89;
                    if(abs(c[j]-expected)>5) failed++;
                }
                printf("D3_GRADIENT\t%d\t%d,%d,%d\n",row,c[0],c[1],c[2]);
            } else if(c[1]>40) {
                int k;
                for(k=2;k<7;k++) {
                    int drift_r=abs(c[0]*paint[k][1]-c[1]*paint[k][0]);
                    int drift_b=abs(c[2]*paint[k][1]-c[1]*paint[k][2]);
                    if(drift_r*100<c[1]*paint[k][1]*4 && drift_b*100<c[1]*paint[k][1]*4)
                        paint_hits[k]++;
                }
            }
            continue;
        }
        if(crowns || canopy) {
            if(c[1]>c[0]+22 && c[1]>c[2]+20 && c[0]<110) {
                leaves++;
                dark+=c[1]<86;
            }
            continue;
        }
        if(ground) {
            if(i<72) grass+=c[1]>c[0]+23 && c[0]<106 && c[2]<65;
            else rock+=c[2]>c[1] && c[1]>c[0] && c[2]-c[0]<42;
            continue;
        }
        want=points[i].material;
        observed=classify(c[0],c[1],c[2]);
        if(rails && want==SKY && (c[2]-c[0]>=45 || (c[0]>175 && c[2]>c[0]))) observed=SKY;
        if(rails && want==LINE && c[0]<65 && c[1]<75 && c[2]<85) observed=LINE;
        if(composition && want==SKY && c[2]-c[0]>=50) observed=SKY;
        if(!strcmp(mode,"bare") && want==LEAF) want=STONE;
        printf("%s %s rgb=%d,%d,%d want=%d got=%d\n",observed==want?"PASS":"FAIL",points[i].name,c[0],c[1],c[2],want,observed);
        failed+=observed!=want;
    }
    if(leaf_shape) failed+=inspect_leaves();
    if(feather) {
        failed+=max_step>16 || range_max-range_min<100;
        printf("D3_FEATHER\tmax_step=%d range=%d failed=%d\n",max_step,range_max-range_min,failed);
    }
    if(volume) {
        failed+=cloud_bands[0]<12;
        failed+=cloud_bands[1]<24;
        failed+=cloud_bands[2]<35;
        printf("D3_CLOUD_VOLUME\tshadow=%d middle=%d light=%d failed=%d\n",
            cloud_bands[0],cloud_bands[1],cloud_bands[2],failed);
    }
    if(sky) {
        failed+=sky_red[1]-sky_red[0]<15;
        failed+=sky_red[2]-sky_red[3]<12;
        printf("D3_SKY\tblue=%d,%d cloud=%d,%d failed=%d\n",sky_red[0],sky_red[1],sky_red[2],sky_red[3],failed);
    }
    if(crowns) {
        size_t length=0;
        char *spec=cx_read("ujs/practice/uxe/test/d3-crowns.tsv",&length);
        int rows=0;
        if(spec) {
            size_t j;
            for(j=0;j<length;j++) rows+=spec[j]=='\n';
            free(spec);
        }
        failed+=rows!=10;
        failed+=leaves<43;
        failed+=dark*100<leaves*25 || dark*100>leaves*60;
        printf("D3_CROWNS\tlobes_per_tree=%d leaves=%d dark=%d failed=%d\n",rows-1,leaves,dark,failed);
    }
    if(canopy) {
        failed+=leaves*100<n*35 || leaves*100>n*85;
        failed+=dark*100<leaves*20 || dark*100>leaves*75;
        printf("D3_CANOPY\tcoverage=%d/%d dark=%d/%d failed=%d\n",leaves,n,dark,leaves,failed);
    }
    if(ground) {
        failed+=grass<8;
        failed+=rock<10;
        printf("D3_GROUND\tgrass=%d rock=%d failed=%d\n",grass,rock,failed);
    }
    if(palette) {
        for(i=2;i<6;i++) failed+=paint_hits[i]<3;
        if(warm) {
            int known=paint_hits[2]+paint_hits[3]+paint_hits[6];
            failed+=known<20 || paint_hits[6]*100<known*7 || paint_hits[6]*100>known*38;
            printf("D3_WARM_LEAF\thighlights=%d/%d\n",paint_hits[6],known);
        }
        printf("D3_PALETTE\tlight-leaf=%d dark-leaf=%d stone=%d barrel=%d failed=%d\n",
            paint_hits[2],paint_hits[3],paint_hits[4],paint_hits[5],failed);
    }
    }
    if(strncmp(p,"</output>",9)) return 2;
    free(out);
    printf("CHECK_UXE_D3_GEOMETRY\tn=%d failed=%d mode=%s\n",n,failed,mode);
    if(!failed && argc==1) {
        int rc=check_u1("");
        return rc?rc:check_u2("");
    }
    return failed?1:0;
}
