/* ROOT OUT GCC TCC [SEED]: exclusive evidence directory, 100 defined C99 integer expressions. */
#pragma unisa use cxlib.netpack
static char dir[4096];
static void save(const char *name,const char *s,size_t n){char p[8192];if(cx_fmt(p,sizeof p,"%s/%s",dir,name))exit(2);if(np_writefile(p,s,n)){fprintf(stderr,"write: %s\n",p);exit(2);}}
static int run(char **v,const char *root,const char *tag,np_buf *out){np_result r={0};char why[800]={0},name[100],status[100];int e=np_run(v,root,0,5,&r,why,sizeof why);if(cx_fmt(name,sizeof name,"%s.stdout",tag))exit(2);save(name,r.out?r.out:"",r.outn);if(cx_fmt(name,sizeof name,"%s.stderr",tag))exit(2);save(name,r.err?r.err:"",r.errn);if(cx_fmt(status,sizeof status,"transport=%d rc=%d residue=%d\n",e,r.rc,r.residue))exit(2);if(cx_fmt(name,sizeof name,"%s.status",tag))exit(2);save(name,status,strlen(status));if(e){if(cx_fmt(name,sizeof name,"%s.error",tag))exit(2);save(name,why,strlen(why));}if(out)np_put(out,r.out?r.out:"",r.outn);int bad=e||r.rc||r.residue;np_free(&r);return bad;}
int main(int argc,char **argv){
    unsigned long long seed=47,state,a,b;char *end,src[8192],exe[8192],line[1024],sha[65];np_buf c={0},out[2]={{0}},diff={0};int bad=0;
    if(argc<5||argc>6||argv[1][0]!='/'||argv[2][0]!='/'||strlen(argv[2])>=sizeof dir)return 2;
    if(argc==6){errno=0;seed=strtoull(argv[5],&end,10);if(errno||!*argv[5]||*end||argv[5][0]=='-'||seed>4294967295ULL)return 2;}
    if(cx_fmt(dir,sizeof dir,"%s",argv[2]))exit(2);if(mkdir(dir,0700)){perror(dir);return 2;}state=seed;np_puts(&c,"#include <stdio.h>\nint main(void){\n");
    for(int i=0;i<100;i++){state=(state*1664525ULL+1013904223ULL)&4294967295ULL;a=i<4?(i%2?4294967295ULL:0):state;state=(state*1664525ULL+1013904223ULL)&4294967295ULL;b=state;char x[128],y[128];if(cx_fmt(x,sizeof x,"%lluULL",a))exit(2);if(cx_fmt(y,sizeof y,"%lluULL",b))exit(2);const char *op[]={"+","-","*","^","&","|","/","%","<<",">>"};if(i%10==6||i%10==7)if(cx_fmt(y,sizeof y,"(%lluULL|1ULL)",b))exit(2);if(i%10>=8)if(cx_fmt(y,sizeof y,"%d",i<20?0:31))exit(2);if(cx_fmt(line,sizeof line,"printf(\"%%llu\\n\",(unsigned long long)((%s%s%s)&4294967295ULL));\n",x,op[i%10],y))exit(2);np_puts(&c,line);}
    np_puts(&c,"return 0;}\n");save("input.c",c.p,c.n);cx_sha256_hex(c.p,c.n,sha);if(cx_fmt(line,sizeof line,"seed=%llu\nexpressions=100\nsha256=%s\ngcc=%s\ntcc=%s\n",seed,sha,argv[3],argv[4]))exit(2);save("manifest.txt",line,strlen(line));if(cx_fmt(src,sizeof src,"%s/input.c",dir))exit(2);
    for(int i=0;i<2;i++){const char *tag=i?"tcc":"gcc";char *v[]={argv[3+i],"-v",0};if(cx_fmt(line,sizeof line,"%s.identity",tag))exit(2);if(run(v,argv[1],line,0)){bad=1;continue;}if(cx_fmt(exe,sizeof exe,"%s/%s.bin",dir,tag))exit(2);char *cc[]={argv[3+i],"-std=c99",src,"-o",exe,0};if(cx_fmt(line,sizeof line,"%s.compile",tag))exit(2);if(run(cc,argv[1],line,0)){bad=1;continue;}char *exec[]={exe,0};if(cx_fmt(line,sizeof line,"%s.run",tag))exit(2);if(run(exec,argv[1],line,&out[i]))bad=1;if(np_count(out[i].p,out[i].n,"\n",1)!=100)bad=1;}
    if(!bad){char *p=out[0].p,*q=out[1].p;for(int i=0;i<100;i++){char *pe=strchr(p,'\n'),*qe=strchr(q,'\n');if(pe-p!=qe-q||memcmp(p,q,(size_t)(pe-p))){if(cx_fmt(line,sizeof line,"expression=%d gcc=%.*s tcc=%.*s\n",i,(int)(pe-p),p,(int)(qe-q),q))exit(2);np_puts(&diff,line);bad=1;}p=pe+1;q=qe+1;}}
    save("differences.txt",diff.p?diff.p:"",diff.n);if(cx_fmt(line,sizeof line,"RANDOM_EXPR seed=%llu count=100 status=%s\n",seed,bad?"FAIL":"PASS"))exit(2);save("result.txt",line,strlen(line));fputs(line,stdout);free(c.p);free(out[0].p);free(out[1].p);free(diff.p);return bad?1:0;
}
