/* tools/check-graph-check.cx -- fixtures for tools/graph-check.cx (run from the repo root).
 *
 *   sh ./unisacc.com tools/check-graph-check.cx
 *
 * Writes small graphs, a fake chain-step.cx (the three six-target constants) and a hardwire table
 * under sy_tmpdir()/graph-check-PID/, runs tools/graph-check.cx on each (bounded 50 s) and asserts
 * exit code and summary fields: consistent graph -> rc 0 / order_mismatch=0; a cycle, a dangling
 * dependency, budget_s 61, an unknown kind -> rc 1 with the matching FAIL row; a chain-step copy
 * in another order -> rc 1 / order_mismatch=1; a hardwire hit is counted.  Finally the real
 * build/graph.tsv against the real tools/chain-step.cx: structure must pass (no FAIL row,
 * cycles=0, nodes=206); order_mismatch and hardwire are only RECORDED, not asserted, in this step.
 * Route cases (--route): a fixture chain source with a gated route function, a second route function
 * and an inline mark against a fixture graph -> route_mismatch=0; the same with the gate passed 1
 * (stub run but not declared), with the two calls swapped (order), and with a declared phase the
 * chain never runs -> one named ROUTE_MISMATCH row each.  The real build/graph.tsv against the real
 * tools/candidate-chain.cx must give route_mismatch=0, and against a copy whose two Win targets are
 * routed like Mac (stub on, st_span calls gone: the 2026-11-10 defect) route_mismatch=8 with the
 * stub and units rows named.  Old cases run with --no-route.
 * Prints CHECK_GRAPH_CHECK<TAB>passed=N<TAB>failed=M; exit 0 only when failed=0. */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use mem.heap

static char dir[4096], chain_ok[4400], chain_bad[4400], hard[4400], hit[4400];
static int passed, failed;

static int put(const char *name, const char *body, char *path, int cap) {
    int fd;
    if (cx_fmt(path, cap, "%s/%s", dir, name)) return -1;
    fd = sy_open_new(path, 0644);
    if (fd < 0) return -1;
    if (sy_write_all(fd, body, tx_len(body, 1 << 20))) { sy_close(fd); return -1; }
    return sy_close(fd);
}
static const char *HDR = "node_id\tkind\ttarget\tdepends_on\tcommand\tinputs\toutputs\tobserved_wall_s\tbudget_s\tevidence_path\tnote\troot_dependent\tsplit_dim\tsplit_min\n";
/* six slice rows in the canonical order, each depending on PREV */
static const char *SIX =
    "freeze\tfreeze\tshared\t-\tc\ti\to\t1\t60\te\tsplit:none single process\tyes\tnone\t1\n"
    "s.lnx-x86_64\tslice-phase\tlnx-x86_64\tfreeze\tc\ti\to\t1\t45\te\tsplit:none single process\tyes\tnone\t1\n"
    "s.lnx-arm64\tslice-phase\tlnx-arm64\tfreeze\tc\ti\to\t1\t45\te\tsplit:none single process\tno\tnone\t1\n"
    "s.osx-x86_64\tslice-phase\tosx-x86_64\ts.lnx-x86_64\tc\ti\to\t1\t45\te\t-\tno\tstages\t1\n"
    "s.osx-arm64\tslice-phase\tosx-arm64\ts.lnx-x86_64\tc\ti\to\t1\t45\te\t-\tno\tstages\t1\n"
    "s.win-x86_64\tslice-phase\twin-x86_64\ts.lnx-x86_64\tc\ti\to\t1\t45\te\t-\tno\tstages\t1\n"
    "s.win-arm64\tslice-phase\twin-arm64\ts.lnx-x86_64\tc\ti\to\t1\t45\te\t-\tno\tstages\t1\n"
    "job:a\tgen\tshared\tfreeze\tc\ti\to\t1\t40\te\t-\tno\tjobs\t1\n"
    "job:b\ttbl\tshared\tjob:a\tc\ti\to\t1\t40\te\t-\tno\tjobs\t1\n"
    "pack\tpack\tall\ts.*,job:*\tc\ti\to\t1\t60\te\tsplit:none single process\tno\tnone\t1\n";
static const char *CHAIN_OK =
    "static const char *cs_target[6] = {\"lnx-x86_64\", \"lnx-arm64\", \"osx-x86_64\", \"osx-arm64\", \"win-x86_64\", \"win-arm64\"};\n"
    "static const char *cs_fp_slices[6] = {\"lnx-x86_64/candidate\", \"lnx-arm64/candidate\",\n"
    "  \"osx-x86_64/slice-osx-x86_64\", \"osx-arm64/slice-osx-arm64\", \"win-x86_64/slice-win-x86_64\", \"win-arm64/slice-win-arm64\"};\n"
    "x = kernel ? \"kernel-route\" : i == 0 ? \"lnx-x86_64\" : i == 1 ? \"lnx-arm64\" : i == 2 ? \"osx-x86_64\" : i == 3 ? \"osx-arm64\" : i == 4 ? \"win-x86_64\" : \"win-arm64\";\n";
static const char *CHAIN_BAD =
    "static const char *cs_target[6] = {\"lnx-arm64\", \"lnx-x86_64\", \"osx-arm64\", \"osx-x86_64\", \"win-arm64\", \"win-x86_64\"};\n"
    "static const char *cs_fp_slices[6] = {\"lnx-x86_64/candidate\", \"lnx-arm64/candidate\",\n"
    "  \"osx-x86_64/slice-osx-x86_64\", \"osx-arm64/slice-osx-arm64\", \"win-x86_64/slice-win-x86_64\", \"win-arm64/slice-win-arm64\"};\n"
    "x = kernel ? \"kernel-route\" : i == 0 ? \"lnx-x86_64\" : i == 1 ? \"lnx-arm64\" : i == 2 ? \"osx-x86_64\" : i == 3 ? \"osx-arm64\" : i == 4 ? \"win-x86_64\" : \"win-arm64\";\n";

/* run graph-check; returns rc (or -1), copies stdout into *out.  ROUTE 0 = --no-route */
static const char *domains = 0;   /* 0: a path that does not exist (strict mode) */
static int run(const char *graph, const char *chain, const char *hardwire, const char *route, char **out, size_t *n) {
    char *v[] = {"sh", "./unisacc.com", "tools/graph-check.cx", "--", "--graph", (char *)graph, "--chain", (char *)chain, "--hardwire", (char *)hardwire,
                 "--domains", (char *)(domains ? domains : "/nonexistent/order-domains.tsv"), route ? "--route" : "--no-route", (char *)route, 0};
    int rc = cx_runv_timeout(v, 50, out, n);
    if (!*out) return -1;
    return rc;
}
static long field(const char *out, size_t n, const char *key) {
    long at = tx_find(out, (long)n, key, tx_len(key, 64)), v = 0, i;
    if (at < 0) return -1;
    for (i = at + tx_len(key, 64); i < (long)n && out[i] >= '0' && out[i] <= '9'; i++) v = v * 10 + (out[i] - '0');
    return v;
}
static void expect(const char *name, const char *body, const char *chain, int want_rc, const char *want_row, long want_mism) {
    char p[4400]; char *out = 0; size_t n = 0; int rc; long m; int ok;
    if (put(name, body, p, sizeof p)) { printf("FAIL\t%s\twrite\n", name); failed++; return; }
    rc = run(p, chain, hard, 0, &out, &n);
    m = out ? field(out, n, "order_mismatch=") : -1;
    ok = out && (rc != 0) == (want_rc != 0) && m == want_mism && tx_contains(out, (long)n, "GRAPH_CHECK\t", 12)
         && (!want_row || tx_contains(out, (long)n, want_row, tx_len(want_row, 128)));
    if (ok) { printf("PASS\t%s\trc=%d\torder_mismatch=%ld\n", name, rc, m); passed++; }
    else { printf("FAIL\t%s\twant rc%s %s order_mismatch=%ld, got rc=%d order_mismatch=%ld\n", name, want_rc ? "!=0" : "=0", want_row ? want_row : "-", want_mism, rc, m); failed++; }
    if (out) mm_free(out);
    sy_unlink(p);
}
/* ---- route fixtures ---- */
static const char *ROUTE_FN =
    "static int rf(const char *t, const char *slug, int want_stub) {\n"
    "    fmt(tag, \"gen1-%s-front%d\", slug, 0);\n"
    "    fmt(tag, \"gen1-%s-merge\", slug);\n"
    "    if (!want_stub) return 0;\n"
    "    fmt(tag, \"gen1-%s-stub\", slug);\n"
    "    return 0;\n"
    "}\n"
    "static int rs(const char *t, const char *slug);\n"
    "static int rs(const char *t, const char *slug) { fmt(tag, \"gen1-%s-units\", slug); return 0; }\n";
static const char *ROUTE_GRAPH =
    "gen1.win-x86_64.prep\tslice-phase\twin-x86_64\tfreeze\tprepare\ti\to\t1\t44\te\t-\tno\tstages\t1\n"
    "gen1.win-x86_64.front0\tslice-phase\twin-x86_64\tfreeze\tfront 0\ti\to\t1\t44\te\t-\tno\tstages\t1\n"
    "gen1.win-x86_64.front1\tslice-phase\twin-x86_64\tfreeze\tfront 1\ti\to\t1\t44\te\t-\tno\tstages\t1\n"
    "gen1.win-x86_64.merge\tslice-phase\twin-x86_64\tfreeze\tmerge\ti\to\t1\t44\te\t-\tno\tstages\t1\n"
    "gen1.win-x86_64.units\tslice-phase\twin-x86_64\tfreeze\tspan units\ti\to\t1\t44\te\t-\tno\tstages\t1\n"
    "gen1.osx-arm64.merge\tslice-phase\tosx-arm64\tfreeze\tmerge\ti\to\t1\t44\te\t-\tno\tstages\t1\n";
static void route_expect(const char *name, const char *graph, const char *route, long want_rm, const char *row1, const char *row2) {
    char *out = 0; size_t n = 0; int rc; long m; int ok;
    rc = run(graph, chain_ok, hard, route, &out, &n);
    m = out ? field(out, n, "route_mismatch=") : -1;
    ok = out && m == want_rm && (rc != 0) == (want_rm != 0)
         && (!row1 || tx_contains(out, (long)n, row1, tx_len(row1, 256))) && (!row2 || tx_contains(out, (long)n, row2, tx_len(row2, 256)));
    if (ok) { printf("PASS\t%s\trc=%d\troute_mismatch=%ld\n", name, rc, m); passed++; }
    else { printf("FAIL\t%s\twant route_mismatch=%ld %s %s, got rc=%d route_mismatch=%ld\n%s\n", name, want_rm, row1 ? row1 : "-", row2 ? row2 : "-", rc, m, out ? out : "(none)"); failed++; }
    if (out) mm_free(out);
}
/* one summary field of graph-check run on GRAPH with chain source ROUTE; -1 when it did not run */
static long route_field(const char *graph, const char *route, const char *key) {
    char *out = 0; size_t n = 0; long m;
    run(graph, chain_ok, hard, route, &out, &n);
    m = out ? field(out, n, key) : -1;
    if (out) mm_free(out);
    return m;
}
/* overwrite every FROM in b[0..n) by TO (same length); the number of hits */
static int swap_all(char *b, long n, const char *from, const char *to) {
    long fl = tx_len(from, 128), i = 0; int hits = 0;
    if (fl != tx_len(to, 128)) return -1;
    for (;;) { long at = tx_find(b + i, n - i, from, fl), k; if (at < 0) break; at += i; for (k = 0; k < fl; k++) b[at + k] = to[k]; i = at + fl; hits++; }
    return hits;
}
/* ---- order domains ---- */
static const char *DOM_HDR = "constant\tfile\tline_hint\tdomain\tfrozen_order\treason\tevidence\n";
static const char *FROZEN6 = "lnx-arm64,lnx-x86_64,osx-arm64,osx-x86_64,win-arm64,win-x86_64";
/* run with domains file DP (0 = strict) and CHAIN; true when rc/ORDER fields/rows match */
static void dom_expect(const char *name, const char *dp, const char *chain, int want_rc, long want_mism, long want_frozen, const char *row) {
    char gp[4400], gbuf[1 << 12]; char *out = 0; size_t n = 0; int rc, ok; long m, fz;
    if (cx_fmt(gbuf, sizeof gbuf, "%s%s", HDR, SIX) || put("dom-graph.tsv", gbuf, gp, sizeof gp)) { printf("FAIL\t%s\twrite\n", name); failed++; return; }
    domains = dp; rc = run(gp, chain, hard, 0, &out, &n); domains = 0;
    m = out ? field(out, n, "order_mismatch=") : -1;
    fz = out ? field(out, n, "frozen=") : -1;
    ok = out && (rc != 0) == (want_rc != 0) && m == want_mism && (want_frozen < 0 || fz == want_frozen)
         && (!row || tx_contains(out, (long)n, row, tx_len(row, 128)));
    if (ok) { printf("PASS\t%s\trc=%d\torder_mismatch=%ld\tfrozen=%ld\n", name, rc, m, fz); passed++; }
    else { printf("FAIL\t%s\twant rc%s order_mismatch=%ld frozen=%ld %s, got rc=%d order_mismatch=%ld frozen=%ld\n%s\n", name, want_rc ? "!=0" : "=0", want_mism, want_frozen, row ? row : "-", rc, m, fz, out ? out : "(none)"); failed++; }
    if (out) mm_free(out);
    sy_unlink(gp);
}
static void domain_cases(void) {
    char dp[4400], dp2[4400], dp3[4400], chain_fp[4400], body[1 << 11];
    /* frozen cs_target + the other two declared graph-order; the fixture graph has lnx-x86_64 first */
    if (cx_fmt(body, sizeof body, "%scs_target\tf\t1\tctx-manifest-order\t%s\tr\te\ncs_fp_slices\tf\t2\tgraph-order\t-\tr\t-\nphase-ternary\tf\t3\tgraph-order\t-\tr\t-\n", DOM_HDR, FROZEN6)
        || put("dom-ok.tsv", body, dp, sizeof dp)
        || cx_fmt(body, sizeof body, "%scs_target\tf\t1\tctx-manifest-order\tlnx-x86_64,lnx-arm64,osx-x86_64,osx-arm64,win-x86_64,win-arm64\tr\te\n", DOM_HDR)
        || put("dom-other.tsv", body, dp2, sizeof dp2)
        || cx_fmt(body, sizeof body, "%scs_target\tf\t1\tctx-manifest-order\t%s\tr\te\n", DOM_HDR, FROZEN6)
        || put("dom-only-cs.tsv", body, dp3, sizeof dp3)
        || put("chain-fpbad.cx", "static const char *cs_target[6] = {\"lnx-arm64\", \"lnx-x86_64\", \"osx-arm64\", \"osx-x86_64\", \"win-arm64\", \"win-x86_64\"};\n"
               "static const char *cs_fp_slices[6] = {\"lnx-arm64/candidate\", \"lnx-x86_64/candidate\",\n"
               "  \"osx-x86_64/slice-osx-x86_64\", \"osx-arm64/slice-osx-arm64\", \"win-x86_64/slice-win-x86_64\", \"win-arm64/slice-win-arm64\"};\n"
               "x = kernel ? \"kernel-route\" : i == 0 ? \"lnx-x86_64\" : i == 1 ? \"lnx-arm64\" : i == 2 ? \"osx-x86_64\" : i == 3 ? \"osx-arm64\" : i == 4 ? \"win-x86_64\" : \"win-arm64\";\n", chain_fp, sizeof chain_fp)) {
        printf("FAIL\tdomain-fixtures\twrite\n"); failed++; return; }
    /* (a-fixture) frozen cs_target in the pinned order passes though it differs from the graph; frozen=1 */
    dom_expect("domain-frozen-ok", dp, chain_bad, 0, 0, 1, "ORDER_DOMAINS\tdeclared=3\tfrozen=1");
    /* (b) cs_target in another order than the pin -> FROZEN_ORDER_CHANGED (chain_ok has x86_64 first) */
    dom_expect("domain-frozen-changed", dp, chain_ok, 1, 1, 1, "FROZEN_ORDER_CHANGED\t");
    /* (c) an undeclared constant (cs_fp_slices) differing from the graph is a plain mismatch even with a table */
    dom_expect("domain-undeclared-strict", dp3, chain_fp, 1, 1, 1, "ORDER_MISMATCH\t");
    /* (d) table missing: strict, all three compared with the graph (cs_target arm64 first is one mismatch) */
    dom_expect("domain-table-missing", 0, chain_bad, 1, 1, 0, "ORDER_DOMAINS\tdeclared=0\tfrozen=0");
    /* a pin in another order than the graph also holds exactly: pin = graph order, chain_bad then changes */
    dom_expect("domain-pin-is-exact", dp2, chain_bad, 1, 1, 1, "FROZEN_ORDER_CHANGED\t");
    sy_unlink(dp); sy_unlink(dp2); sy_unlink(dp3); sy_unlink(chain_fp);
    /* (a) the real tree: order_mismatch=0 and frozen=1 */
    {   char *out = 0; size_t n = 0; int rc; domains = "build/order-domains.tsv";
        rc = run("build/graph.tsv", "tools/chain-step.cx", "build/hardwire.tsv", 0, &out, &n); domains = 0;
        if (out && field(out, n, "order_mismatch=") == 0 && field(out, n, "frozen=") == 1 && tx_contains(out, (long)n, "ORDER_DOMAINS\tdeclared=3\tfrozen=1", 30))
            { printf("PASS\tdomain-real\trc=%d\torder_mismatch=0\tfrozen=1\n", rc); passed++; }
        else { printf("FAIL\tdomain-real\trc=%d\n%s\n", rc, out ? out : "(none)"); failed++; }
        if (out) mm_free(out); }
}
static void route_cases(void) {
    static char g[1 << 14], src[1 << 13]; char gp[4400], gp2[4400], rp[4400];
    if (cx_fmt(g, sizeof g, "%s%s%s", HDR, SIX, ROUTE_GRAPH) || put("route.tsv", g, gp, sizeof gp)
        || cx_fmt(g, sizeof g, "%s%s%sgen1.osx-arm64.image\tslice-phase\tosx-arm64\tfreeze\tprune + image\ti\to\t1\t44\te\t-\tno\tstages\t1\n", HDR, SIX, ROUTE_GRAPH)
        || put("route-extra.tsv", g, gp2, sizeof gp2)) { printf("FAIL\troute-fixtures\twrite\n"); failed++; return; }
    /* consistent: gate 0 keeps stub out, prep is not a chain phase, the inline mark counts */
    if (cx_fmt(src, sizeof src, "%sint main(void) {\n    if (rf(\"win/x86_64\", \"win-x86_64\", 0)) return 1;\n    if (rs(\"win/x86_64\", \"win-x86_64\")) return 1;\n    mark(outdir, \"gen1-osx-arm64-merge\", 0);\n    mark(outdir, \"gen1-osx-arm64\", 0);\n}\n", ROUTE_FN)
        || put("route-ok.cx", src, rp, sizeof rp)) { printf("FAIL\troute-ok\twrite\n"); failed++; return; }
    route_expect("route-ok", gp, rp, 0, 0, 0);
    route_expect("route-declared-not-run", gp2, rp, 1, "ROUTE_MISMATCH\tosx-arm64\timage\tgraph=gen1.osx-arm64.image (", "command: prune + image\tchain=absent (");
    sy_unlink(rp);
    /* the gate passed 1: the chain runs a stub the graph does not declare */
    if (cx_fmt(src, sizeof src, "%sint main(void) {\n    if (rf(\"win/x86_64\", \"win-x86_64\", 1)) return 1;\n    if (rs(\"win/x86_64\", \"win-x86_64\")) return 1;\n    mark(outdir, \"gen1-osx-arm64-merge\", 0);\n}\n", ROUTE_FN)
        || put("route-stub.cx", src, rp, sizeof rp)) { printf("FAIL\troute-stub\twrite\n"); failed++; return; }
    route_expect("route-run-not-declared", gp, rp, 1, "ROUTE_MISMATCH\twin-x86_64\tstub\tgraph=absent (no slice-phase node gen1.win-x86_64.stub)\tchain=runs it (", ":11 via rf)");
    sy_unlink(rp);
    /* same phases, units before front/merge */
    if (cx_fmt(src, sizeof src, "%sint main(void) {\n    if (rs(\"win/x86_64\", \"win-x86_64\")) return 1;\n    if (rf(\"win/x86_64\", \"win-x86_64\", 0)) return 1;\n    mark(outdir, \"gen1-osx-arm64-merge\", 0);\n}\n", ROUTE_FN)
        || put("route-order.cx", src, rp, sizeof rp)) { printf("FAIL\troute-order\twrite\n"); failed++; return; }
    route_expect("route-order", gp, rp, 1, "ROUTE_MISMATCH\twin-x86_64\t(order)\tgraph=front,merge,units (", "chain=units,front,merge (");
    sy_unlink(rp);
    /* a chain source with no "gen1-%s-" tag at all (a rewritten driver): named, exit != 0, never "0 mismatches" */
    {   char *out = 0; size_t n = 0; int rc, ok;
        if (put("route-notags.cx", "static int go(const char *t) { return run_table(t); }\nint main(void) {\n    if (go(\"win/x86_64\")) return 1;\n    mark(outdir, \"done\", 0);\n}\n", rp, sizeof rp)) { printf("FAIL\troute-unrecognized\twrite\n"); failed++; return; }
        rc = run(gp, chain_ok, hard, rp, &out, &n);
        ok = out && rc != 0 && rc != -1 && tx_contains(out, (long)n, "ROUTE_UNRECOGNIZED\t", 19) && tx_contains(out, (long)n, "route-notags.cx\tno function holds a \"gen1-%s-PHASE\" tag", 55)
             && field(out, n, "route_fns=") == 0;
        if (ok) { printf("PASS\troute-unrecognized\trc=%d\troute_fns=0\n", rc); passed++; }
        else { printf("FAIL\troute-unrecognized\twant rc!=0 with a ROUTE_UNRECOGNIZED row and route_fns=0, got rc=%d\n%s\n", rc, out ? out : "(none)"); failed++; }
        if (out) mm_free(out);
        sy_unlink(rp);
    }
    sy_unlink(gp); sy_unlink(gp2);
    /* the real graph against the real chain driver: what is recognised, then that nothing differs, then a
       copy that routes Win like Mac.  The copy's count is the real count plus 8, so a difference that is
       already in the tree is reported once (by route-real), not twice. */
    {   long fns = route_field("build/graph.tsv", "tools/candidate-chain.cx", "route_fns="), evs = route_field("build/graph.tsv", "tools/candidate-chain.cx", "route_events=");
        if (fns >= 2 && evs >= 12) { printf("PASS\troute-real-recognized\troute_fns=%ld\troute_events=%ld\n", fns, evs); passed++; }
        else { printf("FAIL\troute-real-recognized\twant route_fns>=2 route_events>=12, got %ld %ld\n", fns, evs); failed++; } }
    route_expect("route-real", "build/graph.tsv", "tools/candidate-chain.cx", 0, 0, 0);
    {   size_t n = 0; char *b = cx_read("tools/candidate-chain.cx", &n); int h1, h2, h3;
        if (!b) { printf("FAIL\troute-real-win-as-mac\tcannot read tools/candidate-chain.cx\n"); failed++; return; }
        h1 = swap_all(b, (long)n, "\"win-x86_64\", 0)", "\"win-x86_64\", 1)");
        h2 = swap_all(b, (long)n, "\"win-arm64\", 0)", "\"win-arm64\", 1)");
        h3 = swap_all(b, (long)n, "(wf_win_span(root, outdir", "(wf_win_skip(root, outdir");
        if (h1 != 1 || h2 != 1 || h3 != 2 || cx_fmt(rp, sizeof rp, "%s/chain-win-as-mac.cx", dir) || cx_write(rp, b, n)) {
            printf("FAIL\troute-real-win-as-mac\tanchors moved in tools/candidate-chain.cx (hits %d %d %d, want 1 1 2) or write failed\n", h1, h2, h3); failed++; free(b); return;
        }
        free(b);
        {   long base = route_field("build/graph.tsv", "tools/candidate-chain.cx", "route_mismatch=");
            route_expect("route-real-win-as-mac", "build/graph.tsv", rp, base + 8, "ROUTE_MISMATCH\twin-x86_64\tstub\tgraph=absent (", "ROUTE_MISMATCH\twin-arm64\tunits\tgraph=gen1.win-arm64.units (build/graph.tsv:"); }
        sy_unlink(rp);
    }
}

int main(void) {
    char g[1 << 14]; long k;
    if (cx_fmt(dir, sizeof dir, "%s/graph-check-%d", sy_tmpdir(), sy_pid()) || sy_mkdir(dir, 0700)) {
        fprintf(stderr, "check-graph-check: cannot create scratch dir\n"); return 2;
    }
    if (put("chain-ok.cx", CHAIN_OK, chain_ok, sizeof chain_ok) || put("chain-bad.cx", CHAIN_BAD, chain_bad, sizeof chain_bad)
        || put("hit.txt", "a\nsh unisacc.com x\nb\n", hit, sizeof hit)) { fprintf(stderr, "check-graph-check: fixtures\n"); return 2; }
    if (cx_fmt(g, sizeof g, "id\tfile\tpattern\tnote\nX1\t%s\tunisacc.com\tfixture\n", hit) || put("hardwire.tsv", g, hard, sizeof hard)) return 2;

    /* 1 consistent */
    if (cx_fmt(g, sizeof g, "# c\n%s%s", HDR, SIX)) return 2;
    expect("ok.tsv", g, chain_ok, 0, "HARDWIRE\t", 0);
    { char *out = 0; size_t n = 0; char p[4400]; int rc;
      if (put("ok2.tsv", g, p, sizeof p)) return 2;
      rc = run(p, chain_ok, hard, 0, &out, &n);
      if (rc == 0 && out && field(out, n, "hardwire=") == 1 && field(out, n, "nodes=") == 10 && field(out, n, "edges=") == 16 && field(out, n, "cycles=") == 0)
          { printf("PASS\tok-counts\tnodes=10 edges=16 hardwire=1\n"); passed++; }
      else { printf("FAIL\tok-counts\trc=%d out=%s\n", rc, out ? out : "(none)"); failed++; }
      if (out) mm_free(out); sy_unlink(p); }
    /* 2 cycle: freeze depends on pack */
    k = tx_chr(SIX, tx_len(SIX, 4096), '\n') + 1;   /* SIX without its first (freeze) row */
    if (cx_fmt(g, sizeof g, "%sfreeze\tfreeze\tshared\tpack\tc\ti\to\t1\t60\te\tsplit:none single process\tyes\tnone\t1\n%s", HDR, SIX + k)) return 2;
    expect("cycle.tsv", g, chain_ok, 1, "FAIL\tstructure\t", 0);
    { char *out = 0; size_t n = 0; char p[4400]; int rc;
      if (put("cycle2.tsv", g, p, sizeof p)) return 2;
      rc = run(p, chain_ok, hard, 0, &out, &n);
      if (rc != 0 && out && field(out, n, "cycles=") >= 1 && tx_contains(out, (long)n, "\tcycle\t", 7)) { printf("PASS\tcycle-row\n"); passed++; }
      else { printf("FAIL\tcycle-row\t%s\n", out ? out : "(none)"); failed++; }
      if (out) mm_free(out); sy_unlink(p); }
    /* 3 dangling */
    if (cx_fmt(g, sizeof g, "%s%sorphan\ttool\tshared\tnope,job:zz*\tc\ti\to\t1\t60\te\tsplit:none x\tno\tnone\t1\n", HDR, SIX)) return 2;
    expect("dangling.tsv", g, chain_ok, 1, "\tdepends_on\tnope", 0);
    /* 4 budget 61 */
    if (cx_fmt(g, sizeof g, "%s%sslow\ttool\tshared\tfreeze\tc\ti\to\t1\t61\te\tsplit:none x\tno\tnone\t1\n", HDR, SIX)) return 2;
    expect("budget61.tsv", g, chain_ok, 1, "\tbudget_s\t61", 0);
    /* 5 unknown kind */
    if (cx_fmt(g, sizeof g, "%s%sodd\tmagic\tshared\tfreeze\tc\ti\to\t1\t60\te\tsplit:none x\tno\tnone\t1\n", HDR, SIX)) return 2;
    expect("kind.tsv", g, chain_ok, 1, "\tkind\tmagic", 0);
    /* 5b negative control: a product node (kernel) marked root_dependent=yes */
    if (cx_fmt(g, sizeof g, "%s%sk\tkernel\tshared\tfreeze\tc\ti\to\t1\t60\te\tsplit:none x\tyes\tnone\t1\n", HDR, SIX)) return 2;
    expect("rootdep-product.tsv", g, chain_ok, 1, "\troot_dependent\tproduct node marked yes", 0);
    /* 5c root_dependent outside yes|no */
    if (cx_fmt(g, sizeof g, "%s%sk\tkernel\tshared\tfreeze\tc\ti\to\t1\t60\te\tsplit:none x\tmaybe\tnone\t1\n", HDR, SIX)) return 2;
    expect("rootdep-value.tsv", g, chain_ok, 1, "\troot_dependent\tmaybe", 0);
    /* 6 order mismatch in cs_target only */
    if (cx_fmt(g, sizeof g, "%s%s", HDR, SIX)) return 2;
    expect("order.tsv", g, chain_bad, 1, "ORDER_MISMATCH\t", 1);
    domain_cases();
    /* 6b split_dim enumeration, budget>=45 none needs a reason, split_min integer >= 1 */
    if (cx_fmt(g, sizeof g, "%s%sbad\ttool\tshared\tfreeze\tc\ti\to\t1\t30\te\t-\tno\tslices\t1\n", HDR, SIX)) return 2;
    expect("dim.tsv", g, chain_ok, 1, "\tsplit_dim\tslices", 0);
    if (cx_fmt(g, sizeof g, "%s%sbad\ttool\tshared\tfreeze\tc\ti\to\t1\t45\te\tno reason\tno\tnone\t1\n", HDR, SIX)) return 2;
    expect("none-noreason.tsv", g, chain_ok, 1, "\tsplit_dim\tbudget_s>=45", 0);
    if (cx_fmt(g, sizeof g, "%s%sok\ttool\tshared\tfreeze\tc\ti\to\t1\t44\te\tno reason needed under 45\tno\tnone\t1\n", HDR, SIX)) return 2;
    expect("none-under45.tsv", g, chain_ok, 0, 0, 0);
    if (cx_fmt(g, sizeof g, "%s%sbad\ttool\tshared\tfreeze\tc\ti\to\t1\t30\te\t-\tno\tjobs\t0\n", HDR, SIX)) return 2;
    expect("min0.tsv", g, chain_ok, 1, "\tsplit_min\t0", 0);
    /* 7 real graph: structure must pass; order/hardwire recorded */
    { char *out = 0; size_t n = 0; int rc;
      rc = run("build/graph.tsv", "tools/chain-step.cx", "build/hardwire.tsv", 0, &out, &n);
      if (out && !tx_contains(out, (long)n, "FAIL\tstructure\t", 15) && field(out, n, "cycles=") == 0 && field(out, n, "nodes=") == 206) {
          printf("PASS\treal-structure\tnodes=206 cycles=0\n"); passed++;
          printf("RECORD\treal\trc=%d\torder_mismatch=%ld\thardwire=%ld\tedges=%ld\n", rc, field(out, n, "order_mismatch="), field(out, n, "hardwire="), field(out, n, "edges="));
      } else { printf("FAIL\treal-structure\trc=%d\n", rc); failed++; }
      if (out) mm_free(out); }
    route_cases();

    sy_unlink(chain_ok); sy_unlink(chain_bad); sy_unlink(hit); sy_unlink(hard); sy_rmdir(dir);
    printf("CHECK_GRAPH_CHECK\tpassed=%d\tfailed=%d\n", passed, failed);
    return failed ? 1 : 0;
}
