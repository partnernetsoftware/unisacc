 reg.b[3].platform="osx/arm64";reg.b[6].platform="win/x86_64";reg.b[9].platform="lnx/arm64";select_inputs(7,tier_args);for(int i=0;i<reg.nb;i++)if(selected[i]!=(i==0||i==12))bad++;make_plan();int scoped_seen[15]={0};for(int k=0;k<nslices;k++)for(int i=0;i<reg.nb;i++)if(as_inlist(slices[k].ids,ids[i]))scoped_seen[i]++;for(int i=0;i<reg.nb;i++)if(scoped_seen[i]!=(i==0||i==12))bad++;as_state failed={0};failed.attempts=1;failed.last='F';failed.fail=1;if(!selected[0]||!commit_member(0)||!state_bad(&failed))bad++;printf("S9_CONTROL\tcommit-host-scope-no-loss-no-fail-filter\tchecked=1\n");
