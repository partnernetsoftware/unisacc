 {char *rel_args[]={"driver","init","root","run","-","--tier","release"};select_inputs(7,rel_args);for(int i=0;i<reg.nb;i++)if(selected[i]!=(tiers[i]==2))bad++;make_plan();for(int k=0;k<nslices;k++)if(slices[k].tier!=2)bad++;printf("S9_CONTROL\trelease-selection-only\tchecked=1\n");}
