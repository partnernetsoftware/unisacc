 if(second_fill>=0){pending[second_fill]=0;slices[second_fill].pid=1;}
 if(choose_slice(pending,3,0,&queue)>=0)bad++;
 if(first_fill>=0)slices[first_fill].pid=0;
 if(choose_slice(pending,2,0,&queue)>=0||queue.quota!=0)bad++;
 if(second_fill>=0)slices[second_fill].pid=0;
 if(choose_slice(pending,1,0,&queue)>=0)bad++;
