static int operate(int argc,char **argv){
 width_from_env();bounded();if(argc==2&&!strcmp(argv[1],"controls"))return controls();if(argc<4)fail("usage: init|prepare|step|aggregate|retry ROOT RUN ...");
 /* Shard arguments are validated before any session is opened, so a malformed shard request is refused by name and never by a side effect. */
 if(!strcmp(argv[1],"aggregate")&&argc>4){long long a,b;int ok=(argc==7&&!strcmp(argv[4],"--part")&&!as_digits(argv[5],&a)&&!as_digits(argv[6],&b)&&b>=1&&b<=64&&a<b)||(argc==6&&!strcmp(argv[4],"--merge")&&!as_digits(argv[5],&b)&&b>=1&&b<=64);if(!ok)fail("aggregate [--part K N | --merge N]");}
 int init=!strcmp(argv[1],"init"),is_child=!strcmp(argv[1],"child");initializing=init;setup(argv[2],argv[3],init);
 if(is_child){if(argc!=6)fail("child-usage");child(argv[4],argv[5]);return 2;}
 if(!strcmp(argv[1],"list-tier")){if(argc!=5)fail("list-tier ROOT RUN commit|release");int rel=!strcmp(argv[4],"release");if(!rel&&strcmp(argv[4],"commit"))fail("list-tier");for(int i=0;i<reg.nb;i++)if(rel?release_member(i):commit_member(i))printf("S9_LIST_TIER\tid=%s\ttier=%s\n",reg.b[i].id,argv[4]);return 0;}
 if(!strcmp(argv[1],"prepare")){
  if(argc!=5&&!(argc==6&&!strcmp(argv[4],"material")))fail("prepare: checker|executor-all-waves|executor-run-batch|executor|driver|selection|material NAME");char p[4400],checker[4400];path(checker,sd,"checker");
  if(!strcmp(argv[4],"checker")){int lock=as_lock(sd,1,sw,sizeof sw);if(lock<0)fail("run-busy");if(present(checker))fail("checker-already-prepared");as_manifest m;as_ident live;if(as_load(sd,&m,sw,sizeof sw)||as_identity(sr,0,&live,sw,sizeof sw)||as_ident_diff(&live,&m.ident))fail("checker-source-identity");char source[4400];path(source,sr,"tools/all-waves.cx");char *v[]={sb,"25","sh",sc,source,"-o",checker,0};int rc=command(v,0,27);if(rc){as_free(&m);close(lock);return rc;}if(as_identity(sr,0,&live,sw,sizeof sw)||as_ident_diff(&live,&m.ident))fail("checker-source-changed");char h[66];if(as_sha_file(checker,0,h,0,sw,sizeof sw))fail("checker-sha");np_buf provenance={0};checker_provenance(&m,h,&provenance);path(p,sd,"checker.identity");save(p,provenance.p,provenance.n);free(provenance.p);char ih[66];if(as_sha_file(p,0,ih,0,sw,sizeof sw))fail("checker-identity-sha");ih[64]='\n';ih[65]=0;path(p,sd,"checker.identity.sha256");save(p,ih,65);h[64]='\n';h[65]=0;path(p,sd,"checker.sha256");save(p,h,65);as_free(&m);freeze_check();close(lock);return 0;}
  if(!present(checker))fail("prepare-checker-required");freeze_check();
  if(!strcmp(argv[4],"executor-all-waves"))return copy_checker_executor(checker);
  if(!strcmp(argv[4],"material")){if(argc!=6)fail("material-name");return aw("material",sd,argv[5],0);}
  if(!strcmp(argv[4],"executor-run-batch")||!strcmp(argv[4],"executor")){char *part=!strcmp(argv[4],"executor-run-batch")?"run-batch":"seal";char *v[]={sb,L_CMD(),checker,"executor",sr,sd,part,0};return command(v,0,L_WAIT());}
  if(!strcmp(argv[4],"driver")){char source[4400];path(source,sr,"tools/s9-shards.cx");path(p,sd,"driver");char *v[]={sb,L_CMD(),"sh",sc,source,"-o",p,0};int rc=command(v,0,L_WAIT());if(!rc){char h[66],hp[4400];if(as_sha_file(p,0,h,0,sw,sizeof sw))fail("driver-sha");h[64]='\n';h[65]=0;path(hp,sd,"driver.sha256");save(hp,h,65);}return rc;}
  if(!strcmp(argv[4],"selection")){path(p,sd,"selection.tsv");size_t n;char *s=as_read(p,0,&n,sw,sizeof sw);if(!s)fail("selection");char *args[S9_MAX];int count=5;size_t at=0;while(at<n){size_t e=at;while(e<n&&s[e]!='\n')e++;if(e==n||count==S9_MAX)fail("selection-wire");s[e]=0;args[count++]=s+at;at=e+1;}select_inputs(count,args);write_plan();free(s);char h[66];path(p,sd,"plan.tsv");if(as_sha_file(p,0,h,0,sw,sizeof sw))fail("plan-sha");h[64]='\n';h[65]=0;path(p,sd,"plan.tsv.sha256");save(p,h,65);return 0;}
  fail("prepare-mode");
 }
 if(!strcmp(argv[1],"retry")){if(argc!=5)fail("retry ROOT RUN SLICE");return retry_slice(argv[4]);}
 if(!init&&!strcmp(argv[1],"aggregate")&&argc>4){long long a,b;
  if(argc==7&&!strcmp(argv[4],"--part")&&!as_digits(argv[5],&a)&&!as_digits(argv[6],&b)&&b>=1&&b<=64&&a<b)return aggregate((int)a,(int)b,0);
  if(argc==6&&!strcmp(argv[4],"--merge")&&!as_digits(argv[5],&b)&&b>=1&&b<=64)return aggregate(0,(int)b,1);
  fail("aggregate [--part K N | --merge N]");}
 if(!init){if(argc!=4)fail("usage");if(!strcmp(argv[1],"step"))return step();if(!strcmp(argv[1],"aggregate"))return aggregate(0,0,0);fail("mode");}
 if(argc<5)fail("map-required");
 int commit=argc==7&&!strcmp(argv[5],"--tier")&&!strcmp(argv[6],"commit");int rel=argc==7&&!strcmp(argv[5],"--tier")&&!strcmp(argv[6],"release");for(int i=5;i<argc;i++)if(!strcmp(argv[i],"--tier")&&!commit&&!rel)fail("init --tier commit|release cannot combine selection flags");
 {char awelf[4400];int has=aw_native(awelf,sizeof awelf);if(has){char *v[]={sb,L_CMD(),awelf,"init",sr,sd,sc,argv[4],0};if(command(v,0,L_WAIT()))fail("parent-init");}else{char *v[]={sb,L_CMD(),"sh",sc,"tools/all-waves.cx","--","init",sr,sd,sc,argv[4],0};if(command(v,0,L_WAIT()))fail("parent-init");}}
 char p[4400],nonce[66];unsigned char random[32];int fd=open("/dev/urandom",O_RDONLY|O_CLOEXEC);if(fd<0||read(fd,random,32)!=32)fail("nonce");close(fd);cx_sha256_hex(random,32,nonce);nonce[64]='\n';nonce[65]=0;path(p,sd,"nonce");save(p,nonce,65);
 np_buf args={0};for(int i=5;i<argc;i++){if(strchr(argv[i],'\n'))fail("selection-wire");np_puts(&args,argv[i]);np_puts(&args,"\n");}path(p,sd,"selection.tsv");save(p,args.p,args.n);free(args.p);path(p,sd,"mode");save(p,commit?"COMMIT_ONLY\n":rel?"RELEASE_ONLY\n":argc>5?"REGRESSION_ONLY\n":"FULL\n",commit?12:rel?13:argc>5?16:5);path(p,sd,"tier");save(p,commit?"commit\n":rel?"release\n":"all\n",commit?7:rel?8:4);
 size_t n;char *inputs=input_snapshot(&n);path(p,sd,"inputs");save(p,inputs,n);free(inputs);
 const char *metadata[]={"mode","tier","nonce","selection.tsv","inputs"};for(size_t i=0;i<sizeof metadata/sizeof metadata[0];i++){char h[66],hp[4400];path(p,sd,metadata[i]);if(as_sha_file(p,0,h,0,sw,sizeof sw))fail("metadata-sha");h[64]='\n';h[65]=0;int z=snprintf(hp,sizeof hp,"%s.sha256",p);if(z<0||(size_t)z>=sizeof hp)fail("hash-path");save(hp,h,65);}
 printf("S9\tINITIALIZED\tjobs_max=15\tqualification=NOT_EXECUTED\n");return 3;
}
int main(int argc,char **argv){
 if(sy_sig_handle(SIGINT,stop_requested)||sy_sig_handle(SIGTERM,stop_requested))fail("kernel-signal-handler");
 /* The internal supervisor is independent of tools/bound. It freezes and
    kills this operation's whole descendant tree, not another live step. */
 int seconds=argc>1&&(!strcmp(argv[1],"init")||!strcmp(argv[1],"prepare"))?60:300;
 long long begin=as_now();double deadline=(double)begin/1e9+seconds-2;const char *outer=getenv("UNISACC_BOUND_DEADLINE_MONO");if(outer){char *e=0;double inherited=strtod(outer,&e);if(!e||*e||!(inherited>(double)begin/1e9))fail("outer-deadline");if(inherited-2<deadline)deadline=inherited-2;}if(rp_subreaper())fail("subreaper");fflush(0);pid_t worker=fork();if(worker<0)fail("supervisor-fork");
 if(!worker){setpgid(0,0);char d[80];if(cx_fmt(d,sizeof d,"%.9f",deadline-1))fail("deadline-bound");if(setenv("UNISACC_BOUND_DEADLINE_MONO",d,1))fail("deadline-env");exit(operate(argc,argv));}
 setpgid(worker,worker);int status;
 for(;;){long long exited=proc_number(worker,52,1,0);if(exited>=0&&!interrupted){status=(int)exited;char residue[4096];int survived=rp_kill_tree(worker,1500,0,0,residue,sizeof residue);if(survived){printf("S9\tUNKNOWN\treason=descendant-residue\tresidue=%d\n",survived);return 3;}return WIFEXITED(status)?WEXITSTATUS(status):128+WTERMSIG(status);}
  if(interrupted||(double)as_now()/1e9>=deadline){char residue[4096];int survived=rp_kill_tree(worker,1500,0,0,residue,sizeof residue);waitpid(worker,&status,0);printf("S9\tUNKNOWN\treason=%s\tresidue=%d\tsurvived=%s\n",interrupted?"operation-interrupted":"operation-deadline",survived,survived>0?residue:"-");return 3;}usleep(10000);
 }
}
