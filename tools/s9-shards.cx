/* s9 same-run qualification, no cross-run result cache.
 * sh ./unisacc.com tools/s9-shards.cx -- init ROOT NEW_RUN MAP|- [--tier commit|--files FILE...|--since REV]
 * Prepare separately: checker, executor-all-waves, executor-run-batch, executor, driver, selection.
 * prepare ROOT RUN material NAME for each mapped material needed by a batch.
 * RUN/driver step ROOT RUN
 * RUN/driver aggregate ROOT RUN
 * Step returns 3 PENDING, never PASS, while any slice has no DONE. Started but
 * interrupted slices remain UNKNOWN and are never silently re-executed.
 */
#pragma unisa use cxlib.allsession
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.testplan
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use sys.proc
#pragma unisa use sys.sig
#pragma unisa use sysx.reaper
#define S9_MAX 2048
#define S9_WIDTH 5
static char sr[4096],sd[4096],sb[4400],sc[4400],se[4400],sw[1700];
static as_registry reg;
static int tiers[S9_MAX],selected[S9_MAX],exclusive[S9_MAX];
typedef struct {char leaf[80],ids[1024];int tier,alone;pid_t pid;long long start;} s9_slice;
static s9_slice slices[S9_MAX];static int nslices;
static int initializing;
static volatile sig_atomic_t interrupted;
static void stop_requested(int signal_number){interrupted=signal_number;}
static double outer_end;
static void fail(const char *s){fprintf(stderr,"s9: REFUSE %s %s\n",s,sw);exit(2);}
static void path(char *p,const char *a,const char *b){if(as_join(p,4400,a,b))fail("path");}
static void save(const char *p,const char *s,size_t n){if(as_save_new(p,s,n,sw,sizeof sw))fail("exclusive-write");}
static void bounded(void){const char *s=getenv("UNISACC_BOUND_DEADLINE_MONO");char *e=0;if(!s)fail("supervisor-deadline-required");outer_end=strtod(s,&e);double left=outer_end-(double)as_now()/1e9;if(!e||*e||left<=0||left>300.5)fail("outer-budget-300");}
static int present(const char *p){struct stat st;if(!lstat(p,&st))return 1;if(errno==ENOENT)return 0;fail("stat");return 0;}
static void visit_batch(const tp_batch_view *v,void *ctx){(void)ctx;for(int i=0;i<reg.nb;i++)if(!strcmp(v->id,reg.b[i].id))tiers[i]=!strcmp(v->tier,"commit")?0:!strcmp(v->tier,"daily")?1:2;}
static void visit_cov(const tp_coverage_view *v,void *ctx){(void)v;(void)ctx;}
static void setup(const char *root,const char *dir,int fresh){
 char real[4096],out[4400],parent[4400];if(root[0]!='/'||!realpath(root,sr)||strcmp(root,sr))fail("canonical-root");
 if(dir[0]!='/'||strlen(dir)>=sizeof sd)fail("run-path");if(cx_fmt(sd,sizeof sd,"%s",dir))fail("copy-bound");path(out,sr,"out");
 if(strncmp(sd,out,strlen(out))||sd[strlen(out)]!='/')fail("run-below-out");if(cx_fmt(parent,sizeof parent,"%s",sd))fail("copy-bound");char *q=strrchr(parent,'/');if(!q||!q[1]||strstr(q+1,".."))fail("run-leaf");*q=0;
 if(!realpath(parent,real)||strcmp(real,parent))fail("run-parent");if(!fresh&&(!realpath(sd,real)||strcmp(real,sd)))fail("canonical-run");
 path(sb,sr,"tools/bound");path(sc,sr,"unisacc.com");path(se,sd,"executor/all-waves");if(as_registry_load(sr,&reg,sw,sizeof sw)||reg.nb>S9_MAX)fail("registry");
 char p[4400];size_t rn,cn;path(p,sr,"tests/batches.tsv");char *r=as_read(p,0,&rn,sw,sizeof sw);path(p,sr,"tests/coverage.tsv");char *c=as_read(p,0,&cn,sw,sizeof sw);tp_summary summary;tp_observer ob={visit_batch,visit_cov,0};
 if(!r||!c||tp_visit(sr,r,rn,c,cn,&ob,&summary,sw,sizeof sw))fail("tiers");free(r);free(c);
 path(p,sr,"tests/wave-domains.tsv");size_t n;char *d=as_read(p,0,&n,sw,sizeof sw);if(!d)fail("domains");
 for(int i=0;i<reg.nb;i++){size_t at=0,z=strlen(reg.b[i].id);while(at<n){size_t e=at;while(e<n&&d[e]!='\n')e++;if(e-at>z&&d[at]!='#'&&!memcmp(d+at,reg.b[i].id,z)&&d[at+z]=='\t')exclusive[i]=1;at=e+1;}}free(d);
}
static int command(char **v,const char *log,int seconds){np_result r={0};if(np_run(v,sr,0,seconds,&r,sw,sizeof sw))fail("command-transport");if(log){np_buf b={0};np_put(&b,r.out,r.outn);np_put(&b,r.err,r.errn);save(log,b.p,b.n);free(b.p);}else if(r.rc){if(r.outn)fwrite(r.out,1,r.outn,stdout);if(r.errn)fwrite(r.err,1,r.errn,stderr);}int rc=r.rc;np_free(&r);return rc;}
static int aw(const char *cmd,const char *session,const char *arg,const char *tail){char *v[]={sb,"55",se,(char *)cmd,sr,(char *)session,(char *)arg,(char *)tail,0};if(!arg)v[6]=0;else if(!tail)v[7]=0;return command(v,0,57);}
/* Full-input snapshot also catches already dirty edits, removals and link targets.
   The snapshot is supplied by the same all-waves implementation as each wave. */
static char *input_snapshot(size_t *n){
 char checkpath[4400];path(checkpath,sd,"checker");if(!initializing&&!present(checkpath))fail("prepare-checker-required");
 char checker[4400],hp[4400],h[65];path(checker,sd,"checker");int ready=present(checker);if(ready){path(hp,sd,"checker.sha256");size_t hn;char *want=as_read(hp,0,&hn,sw,sizeof sw);if(!want||hn!=65||want[64]!='\n'||as_sha_file(checker,0,h,0,sw,sizeof sw)||memcmp(want,h,64))fail("checker-identity");free(want);}char *native[]={sb,"55",checker,"inputs",sr,0};char *source[]={sb,"55","sh",sc,"tools/all-waves.cx","--","inputs",sr,0};np_result r={0};int transport=np_run(ready?native:source,sr,0,57,&r,sw,sizeof sw);if(transport||r.rc){if(r.outn)fwrite(r.out,1,r.outn,stdout);if(r.errn)fwrite(r.err,1,r.errn,stderr);fprintf(stderr,"s9: inputs transport=%d rc=%d\n",transport,r.rc);np_free(&r);fail("inputs");}char *s=malloc(r.outn+1);if(!s)fail("allocation");if(mm_copy(s,r.outn+1,r.out,r.outn))fail("copy-bound");s[r.outn]=0;*n=r.outn;np_free(&r);return s;
}
static void checker_wire(const as_manifest *m,const char *source,const char *nonce,const char *binary,np_buf *b){np_puts(b,"S9_CHECKER\t");np_puts(b,sr);np_puts(b,"\t");np_puts(b,sd);np_puts(b,"\t");np_putll(b,m->created);np_puts(b,"\t");np_puts(b,m->ident.candidate_kind);np_puts(b,"\t");np_puts(b,m->ident.candidate);np_puts(b,"\t");np_puts(b,m->ident.harness);np_puts(b,"\t");np_puts(b,source);np_puts(b,"\t");np_put(b,nonce,64);np_puts(b,"\t");np_puts(b,binary);np_puts(b,"\n");}
static void checker_provenance(const as_manifest *m,const char *binary,np_buf *b){char p[4400],source[65];path(p,sr,"tools/all-waves.cx");if(as_sha_file(p,0,source,0,sw,sizeof sw))fail("checker-source-sha");path(p,sd,"nonce");size_t n;char *nonce=as_read(p,0,&n,sw,sizeof sw);if(!nonce||n!=65||nonce[64]!='\n')fail("checker-nonce");checker_wire(m,source,nonce,binary,b);free(nonce);}
static int checker_matches(const np_buf *expected,const char *wire,size_t n){return n==expected->n&&!memcmp(wire,expected->p,n);}
static void freeze_check(void){
 as_manifest m;as_ident live;if(as_load(sd,&m,sw,sizeof sw)||as_identity(sr,1,&live,sw,sizeof sw)||as_ident_diff(&live,&m.ident))fail("frozen-input-changed");
 char p[4400],h[65];path(p,sd,"materials.tsv");if(as_sha_file(p,0,h,0,sw,sizeof sw)||strcmp(h,m.map_sha))fail("map-changed");
 for(int i=0;i<m.nmaterial;i++){if(as_material_fp(&m.material[i],h,sw,sizeof sw)||strcmp(h,m.material[i].fingerprint))fail("frozen-material-changed");}
 if(m.has_executor){path(p,sd,"executor/all-waves");if(as_sha_file(p,0,h,0,sw,sizeof sw)||strcmp(h,m.exec_sha))fail("executor-changed");path(p,sd,"executor/run-batch");if(as_sha_file(p,0,h,0,sw,sizeof sw)||strcmp(h,m.runner_sha))fail("runner-changed");}
 const char *sealed[]={"driver","plan.tsv","mode","tier","nonce","selection.tsv","inputs","checker.identity"};for(size_t i=0;i<sizeof sealed/sizeof sealed[0];i++){path(p,sd,sealed[i]);if(!present(p))continue;char hp[4400];int z=snprintf(hp,sizeof hp,"%s.sha256",p);if(z<0||(size_t)z>=sizeof hp)fail("hash-path");size_t hn;char *want=as_read(hp,0,&hn,sw,sizeof sw);if(!want||hn!=65||as_sha_file(p,0,h,0,sw,sizeof sw)||memcmp(want,h,64))fail("sealed-artifact-changed");free(want);}
 path(p,sd,"inputs");size_t a,b;char *old=as_read(p,0,&a,sw,sizeof sw),*now=input_snapshot(&b);if(!old||a!=b||memcmp(old,now,a))fail("frozen-input-changed");free(old);free(now);as_free(&m);
}
static int copy_checker_executor(const char *checker){
 int lock=as_lock(sd,1,sw,sizeof sw);if(lock<0)fail("run-busy");as_manifest m;as_ident live;if(as_load(sd,&m,sw,sizeof sw)||m.has_executor||as_identity(sr,0,&live,sw,sizeof sw)||as_ident_diff(&live,&m.ident))fail("checker-copy-parent");char hash[65],p[4400],dest[4400],record[4400];if(as_sha_file(checker,0,hash,0,sw,sizeof sw))fail("checker-copy-sha");np_buf expected={0};checker_provenance(&m,hash,&expected);path(p,sd,"checker.identity");size_t n;char *wire=as_read(p,0,&n,sw,sizeof sw);if(!wire||!checker_matches(&expected,wire,n))fail("checker-copy-provenance");free(wire);
 path(p,sd,"executor");if(mkdir(p,0700)){struct stat st;if(errno!=EEXIST||lstat(p,&st)||!S_ISDIR(st.st_mode))fail("executor-dir");}path(dest,p,"all-waves");path(record,p,"all-waves.stage");char *bytes=as_read(checker,0,&n,sw,sizeof sw);if(!bytes)fail("checker-copy-read");save(dest,bytes,n);free(bytes);if(chmod(dest,0700))fail("checker-copy-mode");char copied[65];if(as_sha_file(dest,0,copied,0,sw,sizeof sw)||strcmp(hash,copied))fail("checker-copy-changed");if(as_identity(sr,0,&live,sw,sizeof sw)||as_ident_diff(&live,&m.ident))fail("checker-copy-source-changed");np_buf post={0};checker_provenance(&m,copied,&post);if(!checker_matches(&expected,post.p,post.n))fail("checker-copy-identity-changed");free(post.p);
 np_buf stage={0};np_puts(&stage,copied);np_puts(&stage,"\t0\t");np_puts(&stage,sd);np_puts(&stage,"\t");np_putll(&stage,m.created);np_puts(&stage,"\n");save(record,stage.p,stage.n);free(stage.p);path(record,p,"all-waves.copy");np_buf audit={0};np_puts(&audit,"COPY_VERIFIED_SAME_RUN\tcompile_ns=0\n");np_put(&audit,expected.p,expected.n);save(record,audit.p,audit.n);free(audit.p);free(expected.p);printf("EXECUTOR_PART\tname=all-waves\tsha256=%s\torigin=COPY_VERIFIED_SAME_RUN\tcompile_ns=0\tstate=PREPARED-not-registered\n",copied);as_free(&m);close(lock);return 0;
}
static int state_bad(const as_state *s){return s->attempts&&(s->last!='P'||s->fail||s->refused);}
/* A validated receipt cannot make an interrupted or unsealed slice PASS. */
static void close_slice_state(as_state *state,int started,int complete,long long begin,long long end,long long rc){if(started&&(!complete||end-begin>300000000000LL||(rc!=0&&rc!=1)))state->last='U';}
static int commit_member(int i){return tiers[i]==0&&!strcmp(reg.b[i].impl,"IMPLEMENTED")&&as_wave_platform_allowed(reg.b[i].platform);}
static int report_commit_scope(void){int count=0,not_applicable=0,not_available=0;for(int i=0;i<reg.nb;i++)if(tiers[i]==0){const as_batch *b=&reg.b[i];if(!as_wave_platform_allowed(b->platform)){not_applicable++;printf("S9_SCOPE\tNOT_APPLICABLE\tid=%s\tplatform=%s\thost_scope=lnx/x86_64\n",b->id,b->platform);}else if(strcmp(b->impl,"IMPLEMENTED")){not_available++;printf("S9_SCOPE\tNOT_AVAIL\tid=%s\timplementation=%s\tplatform=%s\n",b->id,b->impl,b->platform);}else if(commit_member(i))count++;}printf("S9_SCOPE\tCOMMIT_ONLY\thost_scope=lnx/x86_64\tselected=%d\tnot_applicable=%d\tnot_available=%d\tqualification=NOT_FULL\n",count,not_applicable,not_available);return count;}
static void select_inputs(int argc,char **argv){
 if(argc==7&&!strcmp(argv[5],"--tier")){if(strcmp(argv[6],"commit"))fail("tier: commit required");int count=0;for(int i=0;i<reg.nb;i++){selected[i]=commit_member(i);count+=selected[i];}report_commit_scope();if(!count)fail("commit-tier-empty");printf("S9_SELECTION\tCOMMIT_ONLY\ttier=commit\thost_scope=lnx/x86_64\tselected=%d\tqualification=NOT_FULL\n",count);return;}
 for(int i=0;i<reg.nb;i++)selected[i]=1;if(argc==5)return;
 if(argc<7||(strcmp(argv[5],"--files")&&strcmp(argv[5],"--since")))fail("selection-usage");if(!strcmp(argv[5],"--since")&&argc!=7)fail("since-usage");
 char *v[S9_MAX+16];int n=0;v[n++]=sb;v[n++]="55";v[n++]="sh";v[n++]=sc;v[n++]="tools/affected.cx";v[n++]="--";if(argc>S9_MAX)fail("selection-bound");for(int i=5;i<argc;i++)v[n++]=argv[i];v[n++]="--list-only";v[n]=0;
 char p[4400];path(p,sd,"affected.log");pid_t child=fork();if(child<0)fail("select-fork");if(!child)exit(command(v,p,57));
 char *g[]={sb,"55","sh",sc,"tools/net-deps.cx","--","--check-table-deps",0};path(p,sd,"net-deps.log");int grc=command(g,p,57),status;if(waitpid(child,&status,0)!=child)fail("select-wait");int rc=WIFEXITED(status)?WEXITSTATUS(status):2;
 /* affected consumes the checked table-deps map and already unions every
    named recipe consumer. Keep the independent net touch set as provenance;
    any missing/unknown graph makes the selection conservative ALL. */
 char *touch[S9_MAX+12];int tn=0;touch[tn++]=sb;touch[tn++]="55";touch[tn++]="sh";touch[tn++]=sc;touch[tn++]="tools/net-deps.cx";touch[tn++]="--";touch[tn++]="--touch";
 if(!strcmp(argv[5],"--files"))for(int i=6;i<argc;i++)if(!strncmp(argv[i],"exec/",5))touch[tn++]=argv[i];touch[tn]=0;
 if(tn>7){path(p,sd,"net-touch.log");if(command(touch,p,57))grc=2;}
 int fallback=rc||grc||strcmp(argv[5],"--files");
 for(int i=6;i<argc;i++){const char *f=argv[i];size_t z=strlen(f);int known=(z>3&&!strcmp(f+z-3,".cx")&&(!strncmp(f,"tools/",6)||!strncmp(f,"tests/",6)))||(z>4&&!strcmp(f+z-4,".tsv")&&!strncmp(f,"exec/",5));if(!known||strstr(f,".."))fallback=1;}
 if(!fallback){
  path(p,sd,"affected.log");size_t size;char *wire=as_read(p,0,&size,sw,sizeof sw);if(!wire)fail("affected-output");for(int i=0;i<reg.nb;i++)selected[i]=0;
  size_t at=0;int summary=0;while(at<size){size_t e=at;while(e<size&&wire[e]!='\n')e++;
   if(e-at>9&&!memcmp(wire+at,"AFFECTED\t",9)){size_t t=at+9;while(t<e&&wire[t]!='\t')t++;int found=0;for(int i=0;i<reg.nb;i++)if(strlen(reg.b[i].id)==t-at-9&&!memcmp(reg.b[i].id,wire+at+9,t-at-9)){selected[i]=1;found=1;}if(!found)fallback=1;}
   if(e-at>=17&&!memcmp(wire+at,"AFFECTED_SUMMARY\t",17))summary=1;at=e+1;
  }if(!summary)fallback=1;free(wire);
 }
 if(fallback)for(int i=0;i<reg.nb;i++)selected[i]=1;
 printf("S9_SELECTION\tREGRESSION_ONLY\tconservative=%s\taffected_rc=%d\tgraph_rc=%d\n",fallback?"ALL":"STATIC_UNION",rc,grc);
}
static void make_plan(void){
 nslices=0;for(int t=0;t<3;t++){int current=-1,width=0;for(int i=0;i<reg.nb;i++)if(selected[i]&&tiers[i]==t&&!strcmp(reg.b[i].impl,"IMPLEMENTED")){
  if(current<0||width==S9_WIDTH||exclusive[i]||slices[current].alone){current=nslices++;if(nslices>S9_MAX)fail("slice-limit");s9_slice *s=&slices[current];memset(s,0,sizeof *s);s->tier=t;s->alone=exclusive[i];if(cx_fmt(s->leaf,sizeof s->leaf,"slice-%d-%d",t,current))fail("format-bound");width=0;}
  s9_slice *s=&slices[current];size_t used=strlen(s->ids);if(cx_fmt(s->ids+used,sizeof s->ids-used,"%s%s",width?",":"",reg.b[i].id))fail("ids-bound");width++;
 }}
}
static int commit_tier(void){char p[4400];size_t n;path(p,sd,"tier");char *s=as_read(p,0,&n,sw,sizeof sw);if(!s)fail("tier-missing");int commit=n==7&&!memcmp(s,"commit\n",7);if(!commit&&(n!=4||memcmp(s,"all\n",4)))fail("tier-wire");free(s);return commit;}
static void load_plan(void){
 char p[4400];path(p,sd,"plan.tsv");size_t n;char *s=as_read(p,0,&n,sw,sizeof sw);if(!s||(n&&s[n-1]!='\n'))fail("plan");size_t at=0;nslices=0;int seen[S9_MAX]={0};
 int commit=commit_tier();
 while(at<n){size_t e=at;while(e<n&&s[e]!='\n')e++;s[e]=0;char *f[4];if(as_split(s+at,f,4)!=4||nslices==S9_MAX)fail("plan-wire");s9_slice *x=&slices[nslices++];memset(x,0,sizeof *x);if(!as_relok(f[0])||strchr(f[0],'/')||strlen(f[0])>=sizeof x->leaf||strlen(f[3])>=sizeof x->ids)fail("plan-path");if(cx_fmt(x->leaf,sizeof x->leaf,"%s",f[0]))fail("copy-bound");if(cx_fmt(x->ids,sizeof x->ids,"%s",f[3]))fail("copy-bound");long long t,a;if(as_digits(f[1],&t)||t>2||as_digits(f[2],&a)||a>1)fail("plan-tier");x->tier=(int)t;x->alone=(int)a;int count=0;for(int i=0;i<reg.nb;i++)if(as_inlist(x->ids,reg.b[i].id)){if(seen[i]++||tiers[i]!=x->tier||(exclusive[i]&&!x->alone))fail("plan-assignment");count++;}if(!count||count>S9_WIDTH||(x->alone&&count!=1))fail("plan-width");if(commit){int listed=1;for(const char *q=x->ids;*q;q++)if(*q==',')listed++;if(listed!=count)fail("commit-plan-unknown-or-duplicate-id");}at=e+1;}free(s);
 if(commit){for(int i=0;i<nslices;i++)if(slices[i].tier!=0)fail("commit-plan-tier");for(int i=0;i<reg.nb;i++)if(seen[i]!=commit_member(i))fail("commit-plan-coverage");}
 for(int i=0;i<nslices;i++){char leaf[128];if(cx_fmt(leaf,sizeof leaf,"%s.retry",slices[i].leaf))fail("format-bound");path(p,sd,leaf);if(!present(p))continue;size_t rn;char *r=as_read(p,0,&rn,sw,sizeof sw);char expected[80];int z=snprintf(expected,sizeof expected,"%s-retry",slices[i].leaf);if(z<0||(size_t)z>=sizeof expected||!r||!rn||r[rn-1]!='\n'||nslices==S9_MAX)fail("retry-record");r[rn-1]=0;char *f[2];if(as_split(r,f,2)!=2||strcmp(f[0],expected)||strlen(f[1])>=sizeof slices[0].ids)fail("retry-record");const char *first=strstr(slices[i].leaf,"-retry");if(first&&strstr(first+6,"-retry"))fail("retry-limit");for(int j=0;j<reg.nb;j++)if(as_inlist(f[1],reg.b[j].id)&&!as_inlist(slices[i].ids,reg.b[j].id))fail("retry-assignment");slices[nslices]=slices[i];if(cx_fmt(slices[nslices].leaf,sizeof slices[nslices].leaf,"%s",expected))fail("copy-bound");if(cx_fmt(slices[nslices].ids,sizeof slices[nslices].ids,"%s",f[1]))fail("copy-bound");nslices++;free(r);}
}
static void slice_path(char *p,const s9_slice *s,const char *suffix){char leaf[128];if(cx_fmt(leaf,sizeof leaf,"%s.%s",s->leaf,suffix))fail("format-bound");path(p,sd,leaf);}
static void bind_nonce(const char *session){char p[4400];size_t n;path(p,sd,"nonce");char *s=as_read(p,0,&n,sw,sizeof sw);if(!s||n!=65)fail("nonce");path(p,session,"run-nonce");save(p,s,n);free(s);}
/* /proc starttime disambiguates PID reuse. */
static long long proc_number(pid_t pid,int wanted,int terminal,int *group){
 char p[80],s[8192];if(cx_fmt(p,sizeof p,"/proc/%d/stat",(int)pid))fail("format-bound");int fd=open(p,O_RDONLY|O_CLOEXEC);if(fd<0){if(errno==ENOENT)return terminal?-1:0;fail("proc-stat");}ssize_t n=read(fd,s,sizeof s-1);close(fd);if(n<=0)fail("proc-read");s[n]=0;char *q=strrchr(s,')');if(!q)fail("proc-wire");q+=2;int dead=*q=='Z'||*q=='X';if(terminal&&!dead)return -1;if(!terminal&&dead)return 0;
 for(int field=3;field<wanted;field++){char *end=strchr(q,' ');if(!end)fail("proc-fields");if(field==5&&group){char keep=*end;*end=0;long long g;if(as_digits(q,&g))fail("proc-group");*group=(int)g;*end=keep;}q=end+1;}
 char *end=strchr(q,' ');if(!end)end=strchr(q,'\n');if(end)*end=0;long long number;if(as_digits(q,&number))fail("proc-number");return number;
}
static long long proc_start(pid_t pid){return proc_number(pid,22,0,0);}
static int running(const s9_slice *s){
 char p[4400];slice_path(p,s,"start");size_t n;char *text=as_read(p,0,&n,sw,sizeof sw);if(!text)return 0;if(!n||text[n-1]!='\n')fail("start-wire");text[n-1]=0;char *f[5];if(as_split(text,f,5)!=5)fail("start-wire");long long pid,pgid,tick,start;if(as_digits(f[0],&pid)||as_digits(f[1],&pgid)||as_digits(f[2],&tick)||as_digits(f[4],&start)||pid!=pgid||pid<=1)fail("start-identity");
 char np[4400];path(np,sd,"nonce");size_t nn;char *nonce=as_read(np,0,&nn,sw,sizeof sw);if(!nonce||nn!=65||strlen(f[3])!=64||memcmp(f[3],nonce,64))fail("start-nonce");free(nonce);int group=0;int alive=proc_number((pid_t)pid,22,0,&group)==tick&&group==(int)pgid;free(text);return alive;
}
static int retry_slice(const char *leaf){
 freeze_check();load_plan();int lock=as_lock(sd,1,sw,sizeof sw);if(lock<0)fail("run-busy");s9_slice *s=0;for(int i=0;i<nslices;i++)if(!strcmp(leaf,slices[i].leaf))s=&slices[i];if(!s)fail("retry-id");
 const char *a=strstr(leaf,"-retry");if(a&&strstr(a+6,"-retry"))fail("retry-limit");char p[4400];slice_path(p,s,"start");if(!present(p)||running(s))fail("retry-not-terminal");
 char session[4400],ids[1024]={0};path(session,sd,s->leaf);as_manifest m;int loaded=!as_load(session,&m,sw,sizeof sw);
 int sealed=0;slice_path(p,s,"done");size_t dn;char *done=as_read(p,0,&dn,sw,sizeof sw);if(done&&dn&&done[dn-1]=='\n'){done[dn-1]=0;char *f[4];long long begin,end,rc;if(as_split(done,f,4)==4&&!as_digits(f[0],&begin)&&!as_digits(f[1],&end)&&!as_digits(f[2],&rc)&&end>=begin&&end-begin<=300000000000LL&&(rc==0||rc==1))sealed=1;}free(done);
 for(int i=0;i<reg.nb;i++)if(as_inlist(s->ids,reg.b[i].id)){int passed=0;
  if(loaded)for(int j=0;j<m.nref;j++)if(!strcmp(reg.b[i].id,m.ref[j].id)){const char *v;char why[200];if(as_check_receipt(sr,session,&m,&m.ref[j],&reg.b[i],&m.ident,&v,why))fail("retry-receipt");if(!strcmp(v,"FAIL"))fail("sticky-fail");passed=sealed&&!strcmp(v,"PASS");}
  if(!passed){size_t used=strlen(ids);if(cx_fmt(ids+used,sizeof ids-used,"%s%s",used?",":"",reg.b[i].id))fail("ids-bound");}
 }if(loaded)as_free(&m);if(!*ids)fail("retry-already-pass");np_buf next={0};np_puts(&next,s->leaf);np_puts(&next,"-retry\t");np_puts(&next,ids);np_puts(&next,"\n");slice_path(p,s,"retry");save(p,next.p,next.n);free(next.p);close(lock);printf("S9\tPENDING\treason=explicit-unknown-retry\n");return 3;
}
static void child(const char *session,const char *ids){
 char map[4400];path(map,sd,"materials.tsv");if(aw("init",session,sc,map))exit(2);bind_nonce(session);
 char names[S9_MAX][128];int nn=0;as_manifest parent;if(as_load(sd,&parent,sw,sizeof sw))fail("parent");
 for(int i=0;i<reg.nb;i++)if(as_inlist(ids,reg.b[i].id)){const char *q=reg.b[i].materials;tp_material_decl d;while(tp_material_next(&q,&d)>0){int seen=0;for(int k=0;k<nn;k++)if(!strcmp(names[k],d.name))seen=1;if(!seen){const as_material *expected=as_find_material(&parent,d.name);char h[65];if(!expected){printf("S9\tNOT_AVAIL\tmaterial=%s\n",d.name);exit(2);}if(expected->kind!=d.kind||as_material_fp(expected,h,sw,sizeof sw)||strcmp(h,expected->fingerprint))fail("frozen-material-changed");if(nn==S9_MAX||strlen(d.name)>=sizeof names[0])fail("material-bound");if(cx_fmt(names[nn++],sizeof names[0],"%s",d.name))fail("copy-bound");if(aw("material",session,d.name,0))exit(2);}}}as_free(&parent);
 /* The native S9 supervisor owns this whole descendant tree and the inherited
    remaining deadline. Only run-batch, not identity/receipt closure, gets 55 s. */
 char copy[1024];if(strlen(ids)>=sizeof copy)fail("ids");if(cx_fmt(copy,sizeof copy,"%s",ids))fail("copy-bound");char *v[32];int n=0;v[n++]=se;v[n++]="wave";v[n++]=sr;v[n++]=(char *)session;v[n++]="--s9-supervised";v[n++]="--heavy";char *q=copy;while(q&&*q){char *e=strchr(q,',');if(e)*e=0;v[n++]=q;q=e?e+1:0;}v[n]=0;char p[4400];path(p,session,"wave.log");int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC,0600);if(fd<0||dup2(fd,1)<0||dup2(fd,2)<0)fail("wave-log");close(fd);execv(se,v);fail("wave-exec");
}
static int aggregate(void){
 freeze_check();load_plan();as_manifest parent;if(as_load(sd,&parent,sw,sizeof sw))fail("parent");as_state *states=calloc((size_t)reg.nb,sizeof *states);if(!states)fail("allocation");
 char p[4400];size_t nn;path(p,sd,"nonce");char *nonce=as_read(p,0,&nn,sw,sizeof sw);if(!nonce||nn!=65)fail("nonce");path(p,sd,"mode");size_t mode_n;char *mode=as_read(p,0,&mode_n,sw,sizeof sw);int regression=mode&&mode_n==16&&!memcmp(mode,"REGRESSION_ONLY\n",16),commit=commit_tier();if(commit){if(!mode||mode_n!=12||memcmp(mode,"COMMIT_ONLY\n",12))fail("mode-tier");}else if(!regression&&(!mode||mode_n!=5||memcmp(mode,"FULL\n",5)))fail("mode");
 int pending=0,waves=0,selected_bad=0;
 for(int k=0;k<nslices;k++){s9_slice *s=&slices[k];slice_path(p,s,"done");size_t dn;char *d=as_read(p,0,&dn,sw,sizeof sw);int complete=d!=0;
  char h[65];long long begin=0,end=0,rc=142;int started; slice_path(p,s,"start");started=present(p);int live=started&&running(s);if(!complete&&(!started||live))pending++;
  if(complete){if(!dn||d[dn-1]!='\n')fail("done-wire");d[dn-1]=0;char *f[4];if(as_split(d,f,4)!=4||as_digits(f[0],&begin)||as_digits(f[1],&end)||as_digits(f[2],&rc)||end<begin||strlen(f[3])>=sizeof h)fail("done-wire");if(cx_fmt(h,sizeof h,"%s",f[3]))fail("copy-bound");}
  char session[4400];path(session,sd,s->leaf);as_manifest m;int loaded=!as_load(session,&m,sw,sizeof sw);
  if(loaded){if(strcmp(m.root,sr)||as_ident_diff(&m.ident,&parent.ident)||strcmp(m.map_sha,parent.map_sha)||m.created<parent.created)fail("foreign-child");char hash[65];path(p,session,"session.tsv");if(complete&&(as_sha_file(p,0,hash,0,sw,sizeof sw)||strcmp(hash,h)))fail("child-manifest-changed");
   path(p,session,"run-nonce");size_t n;char *x=as_read(p,0,&n,sw,sizeof sw);if(!x||n!=nn||memcmp(x,nonce,nn))fail("child-nonce");free(x);
   if(as_material_bind(session,&m,sw,sizeof sw))fail("child-map");for(int j=0;j<m.nmaterial;j++){const as_material *expected=as_find_material(&parent,m.material[j].name);if(!expected||expected->kind!=m.material[j].kind||strcmp(expected->path,m.material[j].path)||strcmp(expected->content,m.material[j].content)||strcmp(expected->fingerprint,m.material[j].fingerprint))fail("foreign-child-material");if(as_material_fp(&m.material[j],hash,sw,sizeof sw)||strcmp(hash,m.material[j].fingerprint))fail("child-material");}
   for(int j=0;j<m.nref;j++)if(!as_inlist(s->ids,m.ref[j].id))fail("unassigned-receipt");waves+=m.nwave;
  }
  for(int i=0;i<reg.nb;i++)if(as_inlist(s->ids,reg.b[i].id)){as_state *state=&states[i];if(started){state->attempts++;state->last='U';state->unknown++;}
   if(loaded){for(int j=0;j<m.nref;j++)if(!strcmp(m.ref[j].id,reg.b[i].id)){const char *v;char why[200];if(as_check_receipt(sr,session,&m,&m.ref[j],&reg.b[i],&parent.ident,&v,why)){state->refused++;state->last='R';continue;}if(!strcmp(v,"FAIL")){state->fail++;state->last='F';}else if(!strcmp(v,"PASS")&&!state->fail)state->last='P';else if(!state->fail)state->last='U';}for(int j=0;j<m.nwave;j++)if(m.wave[j].changed)state->refused++;}
   close_slice_state(state,started,complete,begin,end,rc);
  }if(loaded)as_free(&m);free(d);
 }
 parent.nwave=waves;int result;for(int i=0;i<reg.nb;i++)if(state_bad(&states[i])||(commit&&commit_member(i)&&!states[i].attempts))selected_bad++;
 if(commit){int scope_count=report_commit_scope();printf("S9\tCOMMIT_ONLY\ttier=commit\thost_scope=lnx/x86_64\tselected=%d\tstatus=%s\tfailed_or_unknown=%d\tpending=%d\tqualification=NOT_FULL\n",scope_count,pending?"PENDING":selected_bad?"FAIL":"PASS",selected_bad,pending);result=pending?3:selected_bad?1:0;}else if(regression){printf("S9\tREGRESSION_ONLY\tfailed_or_unknown=%d\tpending=%d\tqualification=NOT_QUALIFIED\n",selected_bad,pending);result=pending?3:selected_bad?1:0;}else if(pending){printf("S9\tPENDING\tslices=%d\tqualification=NOT_QUALIFIED\n",pending);result=3;}else result=as_report_states(reg,parent,states);
 free(nonce);free(mode);free(states);as_free(&parent);return result;
}
static int can_launch(int writer,int active,int writer_active){return active<3&&!writer_active&&(!writer||!active);}
static int choose_slice(const int *pending,int active,int writer_active,int *drain){
 if(active>=3||writer_active||*drain)return -1;int busy[3]={0},first[3]={-1,-1,-1};for(int i=0;i<nslices;i++){if(slices[i].pid)busy[slices[i].tier]++;if(pending[i]&&first[slices[i].tier]<0)first[slices[i].tier]=i;}int chosen=-1;for(int t=0;t<3;t++)if(first[t]>=0&&(chosen<0||busy[t]<busy[slices[chosen].tier]))chosen=first[t];if(chosen>=0&&!can_launch(slices[chosen].alone,active,writer_active)){*drain=1;return -1;}return chosen;
}
static int step(void){
 freeze_check();load_plan();char p[4400],driver[4400];path(driver,sd,"driver");int lock=as_lock(sd,1,sw,sizeof sw);if(lock<0)fail("run-busy");int active=0,alone=0,drain=0;
 for(int i=0;i<nslices;i++)if(running(&slices[i])){close(lock);printf("S9\tPENDING\treason=live-prior-attempt\n");return 3;}
 for(;;){
  if(!active)drain=0;
  double left=outer_end-(double)as_now()/1e9;
  if(left>75){int pending[S9_MAX]={0};for(int i=0;i<nslices;i++){slice_path(p,&slices[i],"start");pending[i]=!slices[i].pid&&!present(p);}for(;;){int next=choose_slice(pending,active,alone,&drain);if(next<0)break;s9_slice *s=&slices[next];pending[next]=0;
    slice_path(p,s,"start");
    s->start=as_now();char session[4400];path(session,sd,s->leaf);int gate[2];if(pipe(gate))fail("start-pipe");
    pid_t pid=fork();if(pid<0)fail("fork");if(!pid){close(lock);close(gate[1]);setpgid(0,0);char go;if(read(gate[0],&go,1)!=1)_exit(2);close(gate[0]);char log[4400];slice_path(log,s,"log");int fd=open(log,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC,0600);if(fd<0||dup2(fd,1)<0||dup2(fd,2)<0)_exit(2);close(fd);char *v[]={driver,"child",sr,sd,session,s->ids,0};execv(driver,v);_exit(2);}
    close(gate[0]);setpgid(pid,pid);long long tick=proc_start(pid);if(!tick)fail("child-starttime");char np[4400];size_t nn;path(np,sd,"nonce");char *nonce=as_read(np,0,&nn,sw,sizeof sw);if(!nonce||nn!=65)fail("nonce");np_buf start={0};np_putll(&start,pid);np_puts(&start,"\t");np_putll(&start,pid);np_puts(&start,"\t");np_putll(&start,tick);np_puts(&start,"\t");np_put(&start,nonce,64);np_puts(&start,"\t");np_putll(&start,s->start);np_puts(&start,"\n");save(p,start.p,start.n);free(start.p);free(nonce);if(write(gate[1],"G",1)!=1)fail("start-release");close(gate[1]);s->pid=pid;active++;alone=s->alone;
  }}
  if(!active)break;int status;pid_t pid;do{pid=waitpid(-1,&status,0);}while(pid<0&&errno==EINTR);if(pid<0)fail("wait");
  for(int i=0;i<nslices;i++)if(slices[i].pid==pid){s9_slice *s=&slices[i];char session[4400],h[65];path(session,sd,s->leaf);path(p,session,"session.tsv");if(as_sha_file(p,0,h,0,sw,sizeof sw))if(cx_fmt(h,sizeof h,"%s","ABSENT"))fail("copy-bound");np_buf b={0};np_putll(&b,s->start);np_puts(&b,"\t");np_putll(&b,as_now());np_puts(&b,"\t");np_putll(&b,WIFEXITED(status)?WEXITSTATUS(status):128+WTERMSIG(status));np_puts(&b,"\t");np_puts(&b,h);np_puts(&b,"\n");slice_path(p,s,"done");save(p,b.p,b.n);free(b.p);s->pid=0;active--;alone=0;}
 }
 close(lock);printf("S9\tSTEP_FINISHED\tqualification=NOT_DECIDED_HERE\n");return 3;
}
static void write_plan(void){
 make_plan();np_buf plan={0};char p[4400];for(int i=0;i<nslices;i++){s9_slice *s=&slices[i];np_puts(&plan,s->leaf);np_puts(&plan,"\t");np_putll(&plan,s->tier);np_puts(&plan,"\t");np_putll(&plan,s->alone);np_puts(&plan,"\t");np_puts(&plan,s->ids);np_puts(&plan,"\n");}path(p,sd,"plan.tsv");save(p,plan.p,plan.n);free(plan.p);
}
static int controls(void){
 int bad=0;char tmp[]="/tmp/s9-controls-XXXXXX";if(!mkdtemp(tmp))fail("controls-temp");if(cx_fmt(sd,sizeof sd,"%s",tmp))fail("copy-bound");
 reg.nb=15;reg.b=calloc((size_t)reg.nb,sizeof *reg.b);if(!reg.b)fail("allocation");char ids[15][32];
 for(int i=0;i<reg.nb;i++){if(cx_fmt(ids[i],sizeof ids[i],"fixture-%d",i))fail("format-bound");reg.b[i].id=ids[i];reg.b[i].impl="IMPLEMENTED";reg.b[i].platform="lnx/x86_64";tiers[i]=i%3;selected[i]=1;exclusive[i]=i==4;}
 make_plan();int seen[15]={0};for(int k=0;k<nslices;k++){int width=0;for(int i=0;i<reg.nb;i++)if(as_inlist(slices[k].ids,ids[i])){seen[i]++;width++;if(tiers[i]!=slices[k].tier)bad++;if(exclusive[i]&&!slices[k].alone)bad++;}if(width>S9_WIDTH||(slices[k].alone&&width!=1))bad++;}for(int i=0;i<15;i++)if(seen[i]!=1)bad++;
 if(can_launch(1,1,0)||can_launch(0,1,1)||!can_launch(1,0,0)||!can_launch(0,2,0))bad++;
 char p[4400],nonce[66];memset(nonce,'0',64);nonce[64]='\n';nonce[65]=0;path(p,sd,"nonce");save(p,nonce,65);s9_slice x={0};if(cx_fmt(x.leaf,sizeof x.leaf,"%s","attempt"))fail("copy-bound");slice_path(p,&x,"start");if(present(p))bad++;
 as_manifest cm={0};cm.created=1;np_buf identity={0};checker_wire(&cm,"source",nonce,"binary",&identity);if(!checker_matches(&identity,identity.p,identity.n))bad++;for(int field=0;field<9;field++){char saved=sd[strlen(sd)-1];if(field==1)cm.ident.candidate[0]='x';if(field==2)nonce[0]='1';if(field==3)cm.created=2;if(field==5)sr[0]='x';if(field==6)sd[strlen(sd)-1]=saved=='x'?'y':'x';if(field==7)cm.ident.harness[0]='x';if(field==8)cm.ident.candidate_kind[0]='x';np_buf changed={0};checker_wire(&cm,field==0?"other":"source",nonce,field==4?"other":"binary",&changed);if(checker_matches(&identity,changed.p,changed.n))bad++;free(changed.p);cm.ident.candidate[0]=0;nonce[0]='0';cm.created=1;sr[0]=0;sd[strlen(sd)-1]=saved;cm.ident.harness[0]=0;cm.ident.candidate_kind[0]=0;}free(identity.p);printf("S9_CONTROL\tchecker-copy-binds-source-candidate-nonce-run-created-binary\tchecked=1\n");
 for(int i=0;i<reg.nb;i++){tiers[i]=0;exclusive[i]=0;selected[i]=1;}make_plan();if(nslices!=3)bad++;int one_seen[15]={0},pending[S9_MAX]={0},drain=0;for(int k=0;k<nslices;k++){pending[k]=1;for(int i=0;i<reg.nb;i++)if(as_inlist(slices[k].ids,ids[i]))one_seen[i]++;}for(int i=0;i<reg.nb;i++)if(one_seen[i]!=1)bad++;for(int active=0;active<3;active++){int k=choose_slice(pending,active,0,&drain);if(k<0){bad++;break;}pending[k]=0;slices[k].pid=1;}if(choose_slice(pending,3,0,&drain)>=0)bad++;printf("S9_CONTROL\tsingle-tier-three-slots\tchecked=1\n");
 for(int i=0;i<reg.nb;i++)tiers[i]=i%3;make_plan();int fair_seen[15]={0},tier_seen[3]={0};drain=0;for(int k=0;k<S9_MAX;k++)pending[k]=k<nslices;for(int active=0;active<3;active++){int k=choose_slice(pending,active,0,&drain);if(k<0){bad++;break;}if(tier_seen[slices[k].tier]++)bad++;pending[k]=0;slices[k].pid=1;for(int i=0;i<reg.nb;i++)if(as_inlist(slices[k].ids,ids[i]))fair_seen[i]++;}for(int t=0;t<3;t++)if(tier_seen[t]!=1)bad++;for(int i=0;i<reg.nb;i++)if(fair_seen[i]!=1)bad++;if(choose_slice(pending,0,0,&drain)>=0)bad++;printf("S9_CONTROL\tthree-tier-fair-no-duplicates-no-loss\tchecked=1\n");
 for(int k=0;k<nslices;k++)slices[k].pid=0;pending[0]=1;slices[0].alone=1;drain=0;if(choose_slice(pending,1,0,&drain)>=0||!drain)bad++;drain=0;if(choose_slice(pending,0,1,&drain)>=0)bad++;if(choose_slice(pending,0,0,&drain)!=0)bad++;
 char *tier_args[]={"driver","init","root","run","-","--tier","commit"};select_inputs(7,tier_args);for(int i=0;i<reg.nb;i++)if(selected[i]!=(tiers[i]==0))bad++;make_plan();for(int k=0;k<nslices;k++)if(slices[k].tier!=0)bad++;printf("S9_CONTROL\tcommit-selection-only\tchecked=1\n");
 const char *other_platforms[]={"lnx/arm64","osx/x86_64","osx/arm64","win/x86_64","win/arm64","all-six"};if(!as_wave_platform_allowed("lnx/x86_64"))bad++;for(int i=0;i<6;i++)if(as_wave_platform_allowed(other_platforms[i]))bad++;
 reg.b[3].platform="osx/arm64";reg.b[6].platform="win/x86_64";reg.b[9].platform="lnx/arm64";select_inputs(7,tier_args);for(int i=0;i<reg.nb;i++)if(selected[i]!=(i==0||i==12))bad++;make_plan();int scoped_seen[15]={0};for(int k=0;k<nslices;k++)for(int i=0;i<reg.nb;i++)if(as_inlist(slices[k].ids,ids[i]))scoped_seen[i]++;for(int i=0;i<reg.nb;i++)if(scoped_seen[i]!=(i==0||i==12))bad++;as_state failed={0};failed.attempts=1;failed.last='F';failed.fail=1;if(!selected[0]||!commit_member(0)||!state_bad(&failed))bad++;printf("S9_CONTROL\tcommit-host-scope-no-loss-no-fail-filter\tchecked=1\n");
 as_state receipt={0};receipt.attempts=1;receipt.last='P';close_slice_state(&receipt,1,1,0,60000000000LL,0);if(state_bad(&receipt))bad++;printf("S9_CONTROL\tcompleted-receipt-after-55s-retains-pass\tchecked=1\n");
 receipt.last='P';close_slice_state(&receipt,1,1,0,60000000000LL,142);if(!state_bad(&receipt)||receipt.last!='U')bad++;receipt.last='P';close_slice_state(&receipt,1,0,0,0,0);if(!state_bad(&receipt)||receipt.last!='U')bad++;receipt.last='P';close_slice_state(&receipt,1,1,0,300000000001LL,0);if(!state_bad(&receipt)||receipt.last!='U')bad++;receipt.last='U';close_slice_state(&receipt,1,1,0,60000000000LL,0);if(!state_bad(&receipt))bad++;receipt.last='F';receipt.fail=1;close_slice_state(&receipt,1,1,0,60000000000LL,1);if(!state_bad(&receipt))bad++;printf("S9_CONTROL\ttimeout-unsealed-missing-failed-receipts-never-pass\tchecked=1\n");
 np_buf b={0};np_putll(&b,getpid());np_puts(&b,"\t");np_putll(&b,getpid());np_puts(&b,"\t");np_putll(&b,proc_start(getpid()));np_puts(&b,"\t");np_put(&b,nonce,64);np_puts(&b,"\t1\n");save(p,b.p,b.n);free(b.p);if(!present(p)||!running(&x))bad++;
 /* Resume must not duplicate START; PID reuse must not look in-flight. */
 if(unlink(p))fail("control-unlink");np_buf stale={0};np_putll(&stale,getpid());np_puts(&stale,"\t");np_putll(&stale,getpid());np_puts(&stale,"\t1\t");np_put(&stale,nonce,64);np_puts(&stale,"\t1\n");save(p,stale.p,stale.n);free(stale.p);if(running(&x))bad++;
 if(unlink(p))fail("control-clean");path(p,sd,"nonce");if(unlink(p)||rmdir(sd))fail("control-clean");free(reg.b);printf("S9_CONTROLS\tfailed=%d\n",bad);return bad?1:0;
}
static int operate(int argc,char **argv){
 bounded();if(argc==2&&!strcmp(argv[1],"controls"))return controls();if(argc<4)fail("usage: init|prepare|step|aggregate|retry ROOT RUN ...");
 int init=!strcmp(argv[1],"init"),is_child=!strcmp(argv[1],"child");initializing=init;setup(argv[2],argv[3],init);
 if(is_child){if(argc!=6)fail("child-usage");child(argv[4],argv[5]);return 2;}
 if(!strcmp(argv[1],"prepare")){
  if(argc!=5&&!(argc==6&&!strcmp(argv[4],"material")))fail("prepare: checker|executor-all-waves|executor-run-batch|executor|driver|selection|material NAME");char p[4400],checker[4400];path(checker,sd,"checker");
  if(!strcmp(argv[4],"checker")){int lock=as_lock(sd,1,sw,sizeof sw);if(lock<0)fail("run-busy");if(present(checker))fail("checker-already-prepared");as_manifest m;as_ident live;if(as_load(sd,&m,sw,sizeof sw)||as_identity(sr,0,&live,sw,sizeof sw)||as_ident_diff(&live,&m.ident))fail("checker-source-identity");char source[4400];path(source,sr,"tools/all-waves.cx");char *v[]={sb,"25","sh",sc,source,"-o",checker,0};int rc=command(v,0,27);if(rc){as_free(&m);close(lock);return rc;}if(as_identity(sr,0,&live,sw,sizeof sw)||as_ident_diff(&live,&m.ident))fail("checker-source-changed");char h[66];if(as_sha_file(checker,0,h,0,sw,sizeof sw))fail("checker-sha");np_buf provenance={0};checker_provenance(&m,h,&provenance);path(p,sd,"checker.identity");save(p,provenance.p,provenance.n);free(provenance.p);char ih[66];if(as_sha_file(p,0,ih,0,sw,sizeof sw))fail("checker-identity-sha");ih[64]='\n';ih[65]=0;path(p,sd,"checker.identity.sha256");save(p,ih,65);h[64]='\n';h[65]=0;path(p,sd,"checker.sha256");save(p,h,65);as_free(&m);freeze_check();close(lock);return 0;}
  if(!present(checker))fail("prepare-checker-required");freeze_check();
  if(!strcmp(argv[4],"executor-all-waves"))return copy_checker_executor(checker);
  if(!strcmp(argv[4],"material")){if(argc!=6)fail("material-name");return aw("material",sd,argv[5],0);}
  if(!strcmp(argv[4],"executor-run-batch")||!strcmp(argv[4],"executor")){char *part=!strcmp(argv[4],"executor-run-batch")?"run-batch":"seal";char *v[]={sb,"55",checker,"executor",sr,sd,part,0};return command(v,0,57);}
  if(!strcmp(argv[4],"driver")){char source[4400];path(source,sr,"tools/s9-shards.cx");path(p,sd,"driver");char *v[]={sb,"55","sh",sc,source,"-o",p,0};int rc=command(v,0,57);if(!rc){char h[66],hp[4400];if(as_sha_file(p,0,h,0,sw,sizeof sw))fail("driver-sha");h[64]='\n';h[65]=0;path(hp,sd,"driver.sha256");save(hp,h,65);}return rc;}
  if(!strcmp(argv[4],"selection")){path(p,sd,"selection.tsv");size_t n;char *s=as_read(p,0,&n,sw,sizeof sw);if(!s)fail("selection");char *args[S9_MAX];int count=5;size_t at=0;while(at<n){size_t e=at;while(e<n&&s[e]!='\n')e++;if(e==n||count==S9_MAX)fail("selection-wire");s[e]=0;args[count++]=s+at;at=e+1;}select_inputs(count,args);write_plan();free(s);char h[66];path(p,sd,"plan.tsv");if(as_sha_file(p,0,h,0,sw,sizeof sw))fail("plan-sha");h[64]='\n';h[65]=0;path(p,sd,"plan.tsv.sha256");save(p,h,65);return 0;}
  fail("prepare-mode");
 }
 if(!strcmp(argv[1],"retry")){if(argc!=5)fail("retry ROOT RUN SLICE");return retry_slice(argv[4]);}
 if(!init){if(argc!=4)fail("usage");if(!strcmp(argv[1],"step"))return step();if(!strcmp(argv[1],"aggregate"))return aggregate();fail("mode");}
 if(argc<5)fail("map-required");
 int commit=argc==7&&!strcmp(argv[5],"--tier")&&!strcmp(argv[6],"commit");for(int i=5;i<argc;i++)if(!strcmp(argv[i],"--tier")&&!commit)fail("init --tier commit cannot combine selection flags");
 char *v[]={sb,"55","sh",sc,"tools/all-waves.cx","--","init",sr,sd,sc,argv[4],0};if(command(v,0,57))fail("parent-init");
 char p[4400],nonce[66];unsigned char random[32];int fd=open("/dev/urandom",O_RDONLY|O_CLOEXEC);if(fd<0||read(fd,random,32)!=32)fail("nonce");close(fd);cx_sha256_hex(random,32,nonce);nonce[64]='\n';nonce[65]=0;path(p,sd,"nonce");save(p,nonce,65);
 np_buf args={0};for(int i=5;i<argc;i++){if(strchr(argv[i],'\n'))fail("selection-wire");np_puts(&args,argv[i]);np_puts(&args,"\n");}path(p,sd,"selection.tsv");save(p,args.p,args.n);free(args.p);path(p,sd,"mode");save(p,commit?"COMMIT_ONLY\n":argc>5?"REGRESSION_ONLY\n":"FULL\n",commit?12:argc>5?16:5);path(p,sd,"tier");save(p,commit?"commit\n":"all\n",commit?7:4);
 size_t n;char *inputs=input_snapshot(&n);path(p,sd,"inputs");save(p,inputs,n);free(inputs);
 const char *metadata[]={"mode","tier","nonce","selection.tsv","inputs"};for(size_t i=0;i<sizeof metadata/sizeof metadata[0];i++){char h[66],hp[4400];path(p,sd,metadata[i]);if(as_sha_file(p,0,h,0,sw,sizeof sw))fail("metadata-sha");h[64]='\n';h[65]=0;int z=snprintf(hp,sizeof hp,"%s.sha256",p);if(z<0||(size_t)z>=sizeof hp)fail("hash-path");save(hp,h,65);}
 printf("S9\tINITIALIZED\tjobs_max=15\tqualification=NOT_EXECUTED\n");return 3;
}
int main(int argc,char **argv){
 if(sy_sig_handle(SIGINT,stop_requested)||sy_sig_handle(SIGTERM,stop_requested))fail("kernel-signal-handler");
 /* The internal supervisor is independent of tools/bound. It freezes and
    kills this operation's whole descendant tree, not another live step. */
 int seconds=argc>1&&(!strcmp(argv[1],"init")||!strcmp(argv[1],"prepare"))?60:300;
 long long begin=as_now();double deadline=(double)begin/1e9+seconds-2;const char *outer=getenv("UNISACC_BOUND_DEADLINE_MONO");if(outer){char *e=0;double inherited=strtod(outer,&e);if(!e||*e||!(inherited>(double)begin/1e9))fail("outer-deadline");if(inherited-2<deadline)deadline=inherited-2;}if(rp_subreaper())fail("subreaper");fflush(0);pid_t worker=fork();if(worker<0)fail("supervisor-fork");
 if(!worker){setpgid(0,0);char d[80];if(cx_fmt(d,sizeof d,"%.9f",deadline-1))fail("deadline-bound");if(setenv("UNISACC_BOUND_DEADLINE_MONO",d,1))fail("deadline-env");exit(operate(argc,argv));}
 setpgid(worker,worker);int status;
 for(;;){long long exited=proc_number(worker,52,1,0);if(exited>=0&&!interrupted){status=(int)exited;char residue[4096];int survived=rp_kill_tree(worker,1500,0,0,residue,sizeof residue);if(survived){printf("S9\tUNKNOWN\treason=descendant-residue\tresidue=%d\n",survived);return 3;}return WIFEXITED(status)?WEXITSTATUS(status):128+WTERMSIG(status);}
  if(interrupted||(double)as_now()/1e9>=deadline){char residue[4096];int survived=rp_kill_tree(worker,1500,0,0,residue,sizeof residue);waitpid(worker,&status,0);printf("S9\tUNKNOWN\treason=%s\tresidue=%d\tsurvived=%s\n",interrupted?"operation-interrupted":"operation-deadline",survived,survived>0?residue:"-");return 3;}usleep(10000);
 }
}
