/* tools/check-piece-d-driveargs.cx -- lnx/x86_64 S3 gate for Batch A piece D (driveargs).
 *
 * Evidence split:
 *   Default (LOCAL): runs LOCAL evidence against real tapemode.so x86_64 asm executor, real
 *     product functions, real callers, and real compiled src/drive.cx + src/driveargs_m1.cx:
 *     (1) Static routing & guest authority (build/chain-facts.tsv -> cxlib.chainfacts)
 *     (2) Real entry-build --only driveargs.o compilation (zero fake ELF, asserts rc==0):
 *         - lnx/x86_64 produces real ELF driveargs.o referencing da_m1_dv_word / da_m1_parse_args
 *         - lnx/arm64 produces real ELF driveargs.o with native dv_word and NO da_m1_dv_word
 *     (3) Real product-entry dual link using REAL product callbacks (driver.cli cxc_step/cxc_default_run
 *         and driver.compat cxp_step, compiler.cxmod cxm_flag, formal dv_fail returning exit code 1):
 *           native_probe: links real src/driveargs.cx
 *           s3_probe:     links real src/driveargs_m1.cx (+ cx/driver/driveargs_m1_impl.cx)
 *         byte-comparing FULL dv_word + dv_parse_args outputs and whole-struct CxcState sha256 across
 *         28 words, 650B paths, real disk shebangs, and 7 dv_parse_args vectors (including -cx-plan /
 *         -cx-interface cxm_flag and 257-source DV_MAXU=256 too-many-sources);
 *     (4) Real compiled src/drive.cx entry (drive_real linking real src/drive.cx + src/driveargs_m1.cx):
 *         driven with CRC-tampered P4 container, missing container, and G4 env override; asserts real
 *         src/drive.cx:474 dv_fail text + process exit code 1 (deleting src/drive.cx:474 falls through
 *         to cxc_default_run -> rc 42 and turns red);
 *     (5) Real candidate-chain.cx m53 guest (--emit-m53-guest -> m53.tapeslice) co-exists in the same
 *         P4 container and passes cxsa_valid_s1 vectors;
 *     (6) Inverted driveargs slice divergence proof via s3_probe (proves zero native fallback);
 *     (7) Exact boundary: 65535 B passes (== 20) and 65536 B refuses (== -2);
 *     (8) --chain-ape PATH --chain-receipt PATH (FORMAL_CHAIN_PREGATE): verifies ape_sha against the
 *         chain receipt (refusing on mismatch) and runs the formal negative controls against the real
 *         chain APE with per-case named reasons and carrier/variant identities bound to ape_sha;
 *     (9) --produce RUN_ID EVIDENCE_PATH and --judge RUN_ID EVIDENCE_PATH for mutation-gate execution.
 *
 * Marker: CHECK_PIECE_D_DRIVEARGS. */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.posix
#pragma unisa use sys.sha
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use cxlib.procrun
#pragma unisa use cxlib.chainfacts
#pragma unisa use cxlib.receipt
#pragma unisa use runtime.packagefooter

static int n_ok, failed;
static char g_last_bin_sha[65], g_last_carrier_sha[65];
static void ck_v(int cond, const char *mode, const char *name, const char *variant, const char *reason) {
    if (cond) { n_ok++; sy_printf("PASS\t%s\t%s\tvariant=%s\treason=%s\n", mode, name, variant, reason); }
    else { failed++; sy_printf("FAIL\t%s\t%s\tvariant=%s\treason=%s\n", mode, name, variant, reason); }
}
static void ck(int cond, const char *name) {
    ck_v(cond, "LOCAL", name, "local-fixture", cond ? "ok" : "assertion-failed");
}

static void check_product_routing(void) {
    static const char *const other5[5] = {"lnx/arm64", "osx/x86_64", "osx/arm64", "win/x86_64", "win/arm64"};
    int da_idx = -1;
    char miss[512];
    for (int i = 0; i < cf_root_count(); i++) {
        if (tx_eqz(cf_root_key(i), "driveargs.o")) { da_idx = i; break; }
    }
    int ok = (da_idx >= 0 &&
              tx_eqz(cf_root_source_for(da_idx, "lnx/x86_64"), "src/driveargs_m1.cx") &&
              cf_tu_for("lnx/x86_64", "driveargs.o") != 0 &&
              tx_eqz(cf_tu_for("lnx/x86_64", "driveargs.o"), "driveargs") &&
              cf_check_routed_guests(".", miss, sizeof miss) >= 2);
    for (int t = 0; ok && t < 5; t++) {
        if (!tx_eqz(cf_root_source_for(da_idx, other5[t]), "src/driveargs.cx")) ok = 0;
        if (cf_tu_for(other5[t], "driveargs.o") != 0) ok = 0;
    }
    ck(ok, "product-routing-and-tape-unit-authority");
}

static int run_sh(const char *cmd, char *out, long cap) {
    char *av[] = {"sh", "-c", (char *)cmd, 0};
    pr_result r;
    int t = pr_run("piece-d-da", av, ".", 0, 55, &r);
    long n = 0;
    if (out && cap > 0) {
        if (r.out && r.outn > 0) {
            long m = (long)r.outn < cap - 1 ? (long)r.outn : cap - 1;
            mm_copy(out, cap, r.out, m);
            n += m;
        }
        if (r.err && r.errn > 0 && n < cap - 1) {
            long m = (long)r.errn < cap - 1 - n ? (long)r.errn : cap - 1 - n;
            mm_copy(out + n, cap - n, r.err, m);
            n += m;
        }
        out[n] = 0;
    }
    int rc = t ? -1 : r.rc;
    pr_free(&r);
    return rc;
}

static int parse_u64_sep(const unsigned char *p, long n, long *pos, unsigned long *out, char sep) {
    long i = *pos;
    unsigned long v = 0;
    if (i >= n || p[i] < '0' || p[i] > '9') return -1;
    while (i < n && p[i] >= '0' && p[i] <= '9') { v = v * 10UL + (unsigned long)(p[i] - '0'); i++; }
    if (i >= n || p[i] != (unsigned char)sep) return -1;
    *pos = i + 1;
    *out = v;
    return 0;
}

static int locate_p4_span(const unsigned char *b, long n, long *out_off, long *out_end) {
    PackageFooter pf;
    if (packagefooter_locate_bytes(b, n, &pf) &&
        pf.package_offset >= 0 && pf.package_length >= 10 &&
        pf.package_offset + pf.package_length <= n &&
        memcmp(b + pf.package_offset, "P 4 ", 4) == 0) {
        *out_off = pf.package_offset;
        *out_end = pf.package_offset + pf.package_length;
        return 0;
    }
    if (n >= 16 && memcmp(b + n - 16, "UNIPKG1\n", 8) == 0) return 1;
    if (n >= 10 && memcmp(b, "P 4 ", 4) == 0) {
        *out_off = 0;
        *out_end = n;
        return 0;
    }
    return 1;
}

static int make_crc_tampered_p4_key(const char *src_p4, const char *dst_p4, const char *target_key, char sha_out[65]) {
    unsigned char *b = 0;
    int64_t n = 0;
    long pkg_off = 0, pkg_end = 0, pos = 0, nl_k = tx_len(target_key, 128);
    unsigned long pm = 0, ps = 0, nr = 0;
    int patched = 0;
    if (sha_out) sha_out[0] = 0;
    if (sy_read_file(src_p4, &b, &n, 256L << 20) != 0 || !b || n < 10) { mm_free(b); return 1; }
    if (locate_p4_span(b, (long)n, &pkg_off, &pkg_end) != 0) { mm_free(b); return 1; }
    pos = pkg_off + 4;
    if (parse_u64_sep(b, pkg_end, &pos, &pm, ' ') ||
        parse_u64_sep(b, pkg_end, &pos, &ps, ' ') ||
        parse_u64_sep(b, pkg_end, &pos, &nr, '\n')) { mm_free(b); return 1; }
    for (unsigned long di = 0; di < ps; di++) {
        if (pos + 2 > pkg_end || b[pos] != 'D' || b[pos + 1] != ' ') { mm_free(b); return 1; }
        while (pos < pkg_end && b[pos] != '\n') pos++;
        if (pos >= pkg_end) { mm_free(b); return 1; }
        pos++;
    }
    for (unsigned long mi = 0; mi < pm; mi++) {
        unsigned long mb = 0, mr = 0, mc = 0, mk = 0;
        if (pos + 2 > pkg_end || b[pos] != 'M' || b[pos + 1] != ' ') { mm_free(b); return 1; }
        pos += 2;
        if (parse_u64_sep(b, pkg_end, &pos, &mb, ' ') || parse_u64_sep(b, pkg_end, &pos, &mr, ' ') ||
            parse_u64_sep(b, pkg_end, &pos, &mc, ' ') || parse_u64_sep(b, pkg_end, &pos, &mk, '\n') ||
            mb > (unsigned long)(pkg_end - pos)) { mm_free(b); return 1; }
        pos += (long)mb;
    }
    for (unsigned long ri = 0; ri < nr; ri++) {
        unsigned long kl = 0, dl = 0, rl = 0, co = 0, cr = 0;
        if (pos + 2 > pkg_end || b[pos] != 'F' || b[pos + 1] != ' ') { mm_free(b); return 1; }
        pos += 2;
        if (parse_u64_sep(b, pkg_end, &pos, &kl, ' ') || parse_u64_sep(b, pkg_end, &pos, &dl, ' ') ||
            parse_u64_sep(b, pkg_end, &pos, &rl, ' ') || parse_u64_sep(b, pkg_end, &pos, &co, ' ') ||
            parse_u64_sep(b, pkg_end, &pos, &cr, '\n')) { mm_free(b); return 1; }
        long crc_last = pos - 2;
        if ((long)kl == nl_k && pos + (long)kl <= pkg_end && memcmp(b + pos, target_key, (size_t)nl_k) == 0) {
            b[crc_last] = (b[crc_last] == '0') ? '1' : '0';
            patched = 1;
            break;
        }
        if (kl + dl > (unsigned long)(pkg_end - pos)) { mm_free(b); return 1; }
        pos += (long)(kl + dl);
    }
    if (patched && sha_out) sy_sha256_hex(b, n, sha_out);
    int rc = patched ? sy_write_file(dst_p4, b, (long)n, 0755) : 1;
    mm_free(b);
    return rc;
}

static int make_stripped_ape(const char *src_ape, const char *dst_ape, char sha_out[65]) {
    unsigned char *b = 0;
    int64_t n = 0;
    long pkg_off = 0, pkg_end = 0;
    if (sha_out) sha_out[0] = 0;
    if (sy_read_file(src_ape, &b, &n, 256L << 20) != 0 || !b || n < 16) { mm_free(b); return 1; }
    if (locate_p4_span(b, (long)n, &pkg_off, &pkg_end) != 0 || pkg_off <= 0) { mm_free(b); return 1; }
    if (sha_out) sy_sha256_hex(b, (int64_t)pkg_off, sha_out);
    int rc = sy_write_file(dst_ape, b, pkg_off, 0755);
    mm_free(b);
    return rc;
}

