/* Fixture-only preparation shared by checks of tools/commit-own.cx and tools/precommit.cx.
 * Creates declared tools and their complete registration facts; never qualifies a product. */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.sig
#pragma unisa use sys.io
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use text.text
#pragma unisa use text.fmt
static void die(const char*s){sy_eprintf("fixture-gate-tool: REFUSE %s\n",s);sy_exit(2);}
static void pcg_fixture_guard(void) {
    size_t n=0;char *marker=cx_read(".commit-gate-fixture",&n);
    const char *expected="UNISACC_GATE_FIXTURE_V1\n";
    int valid=marker&&n==strlen(expected)&&!memcmp(marker,expected,n);
    mm_free(marker);if(!valid)die("fixture-root-required");
}
static void pcg_fixture_append(const char *path,const char *row) {
    size_t n=0;char *old=cx_read(path,&n);if(!old)die("fixture-table-read");
    size_t rn=strlen(row);char *next=mm_alloc(n+rn+2);
    if(!next||(n&&old[n-1]!='\n')||mm_copy(next,n+rn+2,old,n)||
       mm_copy(next+n,rn+2,row,rn))die("fixture-table-copy");
    next[n+rn]='\n';next[n+rn+1]=0;
    if(sy_write_atomic(path,next,n+rn+1,0644))die("fixture-table-write");
    mm_free(old);mm_free(next);
}
/* Project three real fact rows into a complete fixture registration set.
 * The independent check byte-compares this projection with real register output. */
static char *pcg_fact_row(const char *table, const char *key) {
    size_t n = 0, kn = strlen(key); char *b = cx_read(table, &n), *answer = 0;
    if (!b) die("fixture-fact-read");
    for (char *p = b; *p;) {
        char *e = strchr(p, '\n'); if (!e) die("fixture-fact-newline");
        if ((size_t)(e-p) > kn && !memcmp(p,key,kn) && p[kn]=='\t') {
            if (answer) die("fixture-fact-duplicate");
            size_t m = (size_t)(e-p); answer = mm_alloc(m+1);
            if (!answer || mm_copy(answer,m+1,p,m)) die("fixture-fact-copy");
            answer[m] = 0;
        }
        p=e+1;
    }
    mm_free(b); return answer;
}
/* Project the current shard-000 facts; the real tools-compile gate remains
 * the independent oracle. The fixture protocol currently uses eight sources. */
#define FG_SHARD_SIZE 8
static char *fg_field(const char *row,int col,int want) {
    char *copy=strdup(row),*fields[14];if(!copy||want>14)die("fixture-fact-shape");
    int n=1;fields[0]=copy;for(char*p=copy;*p;p++)if(*p=='\t'){*p=0;if(n==14)die("fixture-fact-shape");fields[n++]=p+1;}
    if(n!=want||col<0||col>=n)die("fixture-fact-shape");
    char *answer=strdup(fields[col]);mm_free(copy);if(!answer)die("fixture-memory");return answer;
}
static char *fg_edit(const char *row,int col,const char *value,int want) {
    char *copy=strdup(row),*fields[14];if(!copy||want>14)die("fixture-fact-shape");
    int n=1;fields[0]=copy;for(char*p=copy;*p;p++)if(*p=='\t'){*p=0;if(n==14)die("fixture-fact-shape");fields[n++]=p+1;}
    if(n!=want||col<0||col>=n)die("fixture-fact-shape");
    fields[col]=(char *)value;size_t size=strlen(row)+strlen(value)+2,at=0;char*out=mm_alloc(size);
    if(!out)die("fixture-memory");for(int i=0;i<n;i++){size_t k=strlen(fields[i]);if(mm_copy(out+at,size-at,fields[i],k))die("fixture-fact-bound");at+=k;if(i+1<n)out[at++]='\t';}out[at]=0;mm_free(copy);return out;
}
static int pcg_fixture_register(const char *source) {
    pcg_fixture_guard();size_t source_n=strlen(source);
    if(source_n<10||strncmp(source,"tools/",6)||strcmp(source+source_n-3,".cx")||
       strspn(source,"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-/." )!=source_n||
       tx_find(source,(long)source_n,"..",2)>=0)die("fixture-tool-path");
    if(sy_exists(source)!=1)die("fixture-tool-unavailable");
    size_t n=0;char *inventory=cx_read("tests/tools-compile-sources.tsv",&n);if(!inventory)die("fixture-inventory-read");
    int rows=0,found=0;for(char*p=inventory;*p;){char*e=strchr(p,'\n');if(!e)die("fixture-inventory-newline");
        if(e>p&&*p!='#'){char*t=memchr(p,'\t',(size_t)(e-p));if(!t||memchr(t+1,'\t',(size_t)(e-t-1)))die("fixture-inventory-shape");
            if((size_t)(t-p)==source_n&&!memcmp(p,source,source_n))found++;rows++;}
        p=e+1;}
    if(found>1)die("fixture-inventory-duplicate");
    if(!found){char line[4096];if(cx_fmt(line,sizeof line,"%s\tregular",source))die("fixture-inventory-bound");pcg_fixture_append("tests/tools-compile-sources.tsv",line);rows++;}
    int shards=rows/FG_SHARD_SIZE+(rows%FG_SHARD_SIZE!=0);
    char *template=pcg_fact_row("tests/batches.tsv","tools-compile-000");
    char *pkg_template=pcg_fact_row("build/batch-packages.tsv","batch\ttools-compile-000");
    if(!template||!pkg_template)die("fixture-shard-template");
    char *args=fg_field(template,9,14),*coverage_key=fg_field(template,10,14);
    char *coverage=pcg_fact_row("tests/coverage.tsv",coverage_key),*tail=strrchr(args,';');
    if(!coverage||!tail||strcmp(tail+1,"0"))die("fixture-shard-template-contract");
    tail[1]=0;
    for(int i=0;i<shards;i++){
        char id[128];if(cx_fmt(id,sizeof id,"tools-compile-%03d",i))die("fixture-shard-id");
        char *existing=pcg_fact_row("tests/batches.tsv",id);
        if(existing){mm_free(existing);continue;}
        char arguments[4096],manifest[4096],data[24576];
        if(cx_fmt(arguments,sizeof arguments,"%s%d",args,i)||
           cx_fmt(manifest,sizeof manifest,"tests/manifests/%s.tsv",id))die("fixture-shard-bound");
        char *named=fg_edit(template,0,id,14),*batch=fg_edit(named,9,arguments,14),*packages=fg_edit(pkg_template,1,id,9);
        pcg_fixture_append("tests/batches.tsv",batch);pcg_fixture_append("build/batch-packages.tsv",packages);
        if(cx_fmt(data,sizeof data,"batch\t%s\ncoverage\t%s\npackages\t%s\n",batch,coverage,packages)||
           sy_write_atomic(manifest,data,strlen(data),0644))die("fixture-shard-manifest");
        sy_printf("--registered %s\n",id);mm_free(named);mm_free(batch);mm_free(packages);
    }
    mm_free(inventory);mm_free(template);mm_free(pkg_template);mm_free(args);mm_free(coverage_key);mm_free(coverage);return 0;
}


/* A complete working-tree fixture; index selection stays with each test. */
static int pcg_fixture_batch(const char *id,const char *family) {
    pcg_fixture_guard();
    if(strncmp(id,"zz",2)||strspn(id,"abcdefghijklmnopqrstuvwxyz0123456789-")!=strlen(id))die("fixture-batch-id");
    int own=tx_eqz(family,"commit-own");
    if(!own&&!tx_eqz(family,"precommit"))die("fixture-family");
    char source[4096],manifest[4096],body[8192],batch[8192],coverage[8192],packages[8192],data[24576];
    if(cx_fmt(source,sizeof source,"tools/check-%s.cx",id)||
       cx_fmt(manifest,sizeof manifest,"tests/manifests/%s.tsv",id))die("fixture-batch-path");
    int exists=sy_exists(source);if(exists<0)die("fixture-source-stat");if(exists)die("fixture-source-exists");
    if(cx_fmt(body,sizeof body,"/* Checks tools/%s.cx %s. */\n%s\n",
        own?"commit-own":"precommit",own?"registered derivation":"batch registration",
        own?"int main(void){return 0;}":"int main(void) { return 0; }"))die("fixture-source-bound");
    if(sy_write_atomic(source,body,strlen(body),0644))die("fixture-source-write");
    if(cx_fmt(batch,sizeof batch,"%s\tIMPLEMENTED\tinterfaces\t%s\tSOURCE\tlnx/x86_64\t55\t-\t%s\t-\tinterfaces.%s\trc0:X\tproduct\tcommit",id,source,source,id)||
       cx_fmt(coverage,sizeof coverage,"interfaces.%s\tinterfaces\tIMPLEMENTED_SEPARATE_BATCH\tfixture\t%s",id,source)||
       cx_fmt(packages,sizeof packages,"batch\t%s\tall\t-\t-\t-\t-\t-\t-",id)||
       cx_fmt(data,sizeof data,"batch\t%s\ncoverage\t%s\npackages\t%s\n",batch,coverage,packages))die("fixture-batch-bound");
    pcg_fixture_append("tests/batches.tsv",batch);
    pcg_fixture_append("tests/coverage.tsv",coverage);
    pcg_fixture_append("build/batch-packages.tsv",packages);
    if(sy_write_atomic(manifest,data,strlen(data),0644))die("fixture-batch-manifest");
    return pcg_fixture_register(source);
}

int main(int argc,char**argv){if(argc==3&&tx_eqz(argv[1],"--fixture-register-tool"))return pcg_fixture_register(argv[2]);if(argc==4&&tx_eqz(argv[1],"--fixture-batch"))return pcg_fixture_batch(argv[2],argv[3]);sy_eprintf("usage: fixture-gate-tool --fixture-register-tool SOURCE | --fixture-batch ID commit-own|precommit\n");return 2;}
