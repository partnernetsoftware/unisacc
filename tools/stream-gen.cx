#pragma unisa use sys.io
#pragma unisa use text.text
/* Project exec/pipeline/image-stages.tsv onto cx/compiler/streamname.cx.
   sh ./unisacc.com tools/stream-gen.cx -- --check
   sh ./unisacc.com tools/stream-gen.cx -- --write
   --write-src is refused: src/stream.cx waits until after install.
   The fact table is the only name list. This file does not copy the seven
   official names. A row is five tab fields, a name charset, and a model
   file of stage + ".net". Exactly seven data rows. No libc and no include. */
#define TSV "exec/pipeline/image-stages.tsv"
#define OUT "cx/compiler/streamname.cx"
#define NSTREAM 7
#define NAMEMAX 32
#define GENCAP 8192

typedef struct {
    char stage[NAMEMAX];
    char official[NAMEMAX];
} Row;

static Row rows[NSTREAM];
static int nrows;

static int fail(const char *why) {
    sy_eprintf("stream-gen\tFAIL\t%s\n", why);
    return 1;
}

static int field_ok(const char *s, int n) {
    int i;
    if (n < 1 || n >= NAMEMAX) return 0;
    for (i = 0; i < n; i++) {
        char c = s[i];
        if (c >= 'a' && c <= 'z') continue;
        if (c >= '0' && c <= '9') continue;
        if (c == '.' || c == '_') continue;
        return 0;
    }
    return 1;
}

static void copy_field(char *dst, const char *s, int n) {
    int i;
    for (i = 0; i < n; i++) dst[i] = s[i];
    dst[n] = 0;
}

static int model_ok(const char *model, int mn, const char *stage, int sn) {
    int i;
    if (mn != sn + 4) return 0;
    for (i = 0; i < sn; i++) if (model[i] != stage[i]) return 0;
    return model[sn] == '.' && model[sn + 1] == 'n' && model[sn + 2] == 'e'
        && model[sn + 3] == 't';
}

static int take_row(const char *line, int n) {
    const char *f[5];
    int len[5];
    int i, k, start;
    if (nrows >= NSTREAM) return fail("stream-count");
    k = 0;
    start = 0;
    for (i = 0; i <= n; i++) {
        if (i == n || line[i] == '\t') {
            if (k >= 5) return fail("row-fields");
            f[k] = line + start;
            len[k] = i - start;
            k++;
            start = i + 1;
        }
    }
    if (k != 5) return fail("row-fields");
    for (i = 0; i < 5; i++) if (!field_ok(f[i], len[i])) return fail("row-charset");
    if (!model_ok(f[3], len[3], f[0], len[0])) return fail("model-name");
    copy_field(rows[nrows].stage, f[0], len[0]);
    copy_field(rows[nrows].official, f[4], len[4]);
    nrows++;
    return 0;
}

static int parse(char *b, size_t n) {
    size_t i = 0;
    int saw = 0;
    if (n == 0 || b[n - 1] != '\n') return fail("tsv-newline");
    while (i < n) {
        size_t e = i;
        while (e < n && b[e] != '\n') e++;
        b[e] = 0;
        if (e == i) return fail("blank-line");
        if (!saw) {
            if (!tx_eqz(b + i, "# stage\tinput format\toutput format\tmodel file\tofficial"))
                return fail("header");
            saw = 1;
        } else if (b[i] == '#') {
            return fail("extra-comment");
        } else if (take_row(b + i, (int)(e - i))) {
            return 1;
        }
        i = e + 1;
    }
    if (nrows != NSTREAM) return fail("stream-count");
    return 0;
}

static int unique_names(void) {
    int i, j;
    for (i = 0; i < nrows; i++) {
        for (j = i + 1; j < nrows; j++) {
            if (tx_eqz(rows[i].stage, rows[j].stage)) return fail("stage-dup");
            if (tx_eqz(rows[i].official, rows[j].official)) return fail("official-dup");
        }
    }
    return 0;
}

static int app(char *dst, int cap, int *n, const char *s) {
    int i = 0;
    while (s[i]) {
        if (*n + 1 >= cap) return -1;
        dst[*n] = s[i];
        *n += 1;
        i++;
    }
    dst[*n] = 0;
    return 0;
}

static int app_digit(char *dst, int cap, int *n, int d) {
    char s[2];
    if (d < 0 || d > 9) return -1;
    s[0] = (char)('0' + d);
    s[1] = 0;
    return app(dst, cap, n, s);
}

static int emit(char *dst, int cap, int *n) {
    int i;
    *n = 0;
    dst[0] = 0;
    if (app(dst, cap, n, "#pragma unisa module streamname\n")) return -1;
    if (app(dst, cap, n, "/* Generated by tools/stream-gen.cx from exec/pipeline/image-stages.tsv.\n")) return -1;
    if (app(dst, cap, n, "   Do not edit by hand. Official is the official column.\n")) return -1;
    if (app(dst, cap, n, "   Code is the stage column. A null out-pointer returns 4.\n")) return -1;
    if (app(dst, cap, n, "   An index outside 0..count-1 returns 2. No libc and no include. */\n")) return -1;
    if (app(dst, cap, n, "int sn_count(void) {\n    return ")) return -1;
    if (app_digit(dst, cap, n, nrows)) return -1;
    if (app(dst, cap, n, ";\n}\n")) return -1;
    if (app(dst, cap, n, "int sn_at(int index, const char **official, const char **code) {\n")) return -1;
    if (app(dst, cap, n, "    if (!official || !code) return 4;\n")) return -1;
    for (i = 0; i < nrows; i++) {
        if (app(dst, cap, n, "    if (index == ")) return -1;
        if (app_digit(dst, cap, n, i)) return -1;
        if (app(dst, cap, n, ") { *official = \"")) return -1;
        if (app(dst, cap, n, rows[i].official)) return -1;
        if (app(dst, cap, n, "\"; *code = \"")) return -1;
        if (app(dst, cap, n, rows[i].stage)) return -1;
        if (app(dst, cap, n, "\"; return 0; }\n")) return -1;
    }
    if (app(dst, cap, n, "    return 2;\n}\n")) return -1;
    return 0;
}

static int same_bytes(const char *a, size_t an, const char *b, size_t bn) {
    size_t i;
    if (an != bn) return 0;
    for (i = 0; i < an; i++) if (a[i] != b[i]) return 0;
    return 1;
}

int main(int argc, char **argv) {
    size_t n = 0, on = 0;
    char *b, *cur;
    char gen[GENCAP];
    int gn = 0, dowrite = 0;
    if (argc == 2 && tx_eqz(argv[1], "--write-src"))
        return fail("src/stream.cx waits until after install");
    if (argc != 2 || (!tx_eqz(argv[1], "--check") && !tx_eqz(argv[1], "--write"))) {
        sy_eprintf("stream-gen\tusage\t--check|--write\n");
        return 2;
    }
    dowrite = tx_eqz(argv[1], "--write");
    b = cx_read(TSV, &n);
    if (!b) return fail("tsv-read");
    if (parse(b, n)) return 1;
    if (unique_names()) return 1;
    if (emit(gen, GENCAP, &gn)) return fail("emit");
    if (dowrite) {
        if (cx_write(OUT, gen, (size_t)gn)) return fail("write");
        sy_printf("STREAM_GEN\tWROTE\t%s\tbytes=%d\n", OUT, gn);
        return 0;
    }
    cur = cx_read(OUT, &on);
    if (!cur) return fail("out-read");
    if (!same_bytes(cur, on, gen, (size_t)gn)) return fail("check-difference");
    sy_printf("STREAM_GEN\tCHECK\trows=%d\tbytes=%d\n", nrows, gn);
    return 0;
}
