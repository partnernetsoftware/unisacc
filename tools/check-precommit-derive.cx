/* tools/check-precommit-derive.cx -- fixed-fixture & real-commit flow checks for the precommit derive_gate.
 *   sh ./unisacc.com tools/check-precommit-derive.cx
 * Builds a private mini git repo under $TMPDIR with exec/facts/derive.tsv (links row), tests/batches.tsv,
 * build/links.tsv, notes.txt and a real .git/hooks/pre-commit wired to tools/precommit-flow.cx, and verifies 10 contracts:
 *   1. unrelated-file-passes              staging notes.txt -> rc 0, derive gate not triggered
 *   2. input-changed-no-recompute-blocked staging tests/batches.tsv without recomputing links -> rc 1 BLOCKED + fix cmd
 *   3. recomputed-but-unstaged-blocked    recomputing build/links.tsv in worktree without staging it -> rc 1 BLOCKED
 *   4. recomputed-and-staged-passes       staging recomputed build/links.tsv with batches.tsv -> rc 0 blocked=0
 *   5. waiver-active-and-expired          future waiver allows rc 0; expired waiver blocks rc 1
 *   6. flow-plan-and-from-run-blocked     precommit-flow.cx (--plan + flowexec + --from-run) runs derive node and blocks rc 1
 *   7. real-commit-after-recompute-ok     real `git commit` via pre-commit hook blocked when stale, succeeds after recompute
 *   8. real-commit-unrelated-zero-overhead real `git commit` on notes.txt succeeds with no derive node planned
 *   9. fail-safe-unavailable-allows       broken tools/derive.cx prints DERIVE_GATE_UNAVAILABLE warning and allows commit (rc 0)
 *  10. table-index-new-tool-real-commit   real `git commit` adding tools/ with ignored build/product-map.tsv: check- tool passes, reader tool blocks until table-index recomputed and staged
 * Last line: CHECK_PRECOMMIT_DERIVE<TAB>ok=N<TAB>failed=M<TAB>ms=T (rc 0 only when failed=0). */
#pragma unisa use cxlib.ckassert
#pragma unisa use cxlib.ckrun
#pragma unisa use sys.fs
#pragma unisa use sys.time
#pragma unisa use sys.env
#pragma unisa use mem.heap
#pragma unisa use text.text

#define CPD_PW 4400
#define CPD_OUT 16384

static void cpd_abort(const char *why) {
    fprintf(stderr, "check-precommit-derive: REFUSE %s\n", why);
    exit(2);
}

static void cpd_mk(const char *p) {
    if (mkdir(p, 0700) != 0 && errno != EEXIST) cpd_abort("mkdir");
}

static void cpd_sh(const char *cmd, char *out) {
    if (ckk_sh("check-precommit-derive", cmd, out, CPD_OUT) != 0) {
        fprintf(stderr, "check-precommit-derive: setup failed:\n%s\n", out);
        cpd_abort("setup-sh");
    }
}

int main(void) {
    long t0 = sy_now_ms();
    char out[CPD_OUT], cwd[CPD_PW], work[CPD_PW], repo[CPD_PW], repo2[CPD_PW], cmd[8192], p[CPD_PW];
    const char *td = sy_tmpdir();
    const char *base_td = (td && td[0] == '/') ? td : "/tmp";

    if (!getcwd(cwd, sizeof cwd)) cpd_abort("cwd");
    if (cx_fmt(work, sizeof work, "%s/check-precommit-derive-%d", base_td, (int)getpid())) cpd_abort("work");
    cpd_mk(work);
    if (cx_fmt(repo, sizeof repo, "%s/repo", work)) cpd_abort("repo");
    cpd_mk(repo);

    if (cx_fmt(p, sizeof p, "%s/exec", repo)) cpd_abort("p1"); cpd_mk(p);
    if (cx_fmt(p, sizeof p, "%s/exec/facts", repo)) cpd_abort("p2"); cpd_mk(p);
    if (cx_fmt(p, sizeof p, "%s/tests", repo)) cpd_abort("p3"); cpd_mk(p);
    if (cx_fmt(p, sizeof p, "%s/build", repo)) cpd_abort("p4"); cpd_mk(p);

    if (cx_fmt(cmd, sizeof cmd,
        "ln -s '%s/unisacc.com' '%s/unisacc.com' && ln -sn '%s/tools' '%s/tools' && ln -sn '%s/cx' '%s/cx' && ln -sn '%s/ext' '%s/ext' && ln -s '%s/cxroot.tsv' '%s/cxroot.tsv'",
        cwd, repo, cwd, repo, cwd, repo, cwd, repo, cwd, repo)) cpd_abort("ln-cmd");
    cpd_sh(cmd, out);

    {
        const char *der = "# name\tgenerator\tcheck_argv\twrite_argv\toutputs\tinputs_glob\torder\tbound_s\n"
                          "links\ttools/links-gen.cx\tcmp -s tests/batches.tsv build/links.tsv\tcp tests/batches.tsv build/links.tsv\tbuild/links.tsv\texec/facts/derive.tsv tests/batches.tsv tools/links-gen.cx\t5\t20\n";
        const char *bat = "# id\timplementation\tlayer\tsource\tmode\tplatform\tbudget\tmaterials\tentry\targs\tcoverage\texpect\theaders\ttier\n"
                          "b1\tIMPLEMENTED\tcontract\ttools/b1.cx\tSOURCE\tlnx/x86_64\t30\t-\ttools/b1.cx\t-\tcontract.b1\trc0:B1\tproduct\tcommit\n";
        if (cx_fmt(p, sizeof p, "%s/exec/facts/derive.tsv", repo)) cpd_abort("f1");
        if (cx_write(p, der, strlen(der))) cpd_abort("w1");
        if (cx_fmt(p, sizeof p, "%s/tests/batches.tsv", repo)) cpd_abort("f2");
        if (cx_write(p, bat, strlen(bat))) cpd_abort("w2");
        if (cx_fmt(p, sizeof p, "%s/notes.txt", repo)) cpd_abort("f3");
        if (cx_write(p, "hello\n", 6)) cpd_abort("w3");
    }

    if (cx_fmt(cmd, sizeof cmd,
        "cd '%s' && sh ./unisacc.com tools/derive.cx -- --write --only links && git init -q && "
        "git add exec/facts/derive.tsv tests/batches.tsv build/links.tsv notes.txt && "
        "git -c user.name=t -c user.email=t@t commit -q -m init", repo)) cpd_abort("init-cmd");
    cpd_sh(cmd, out);

    /* 1. Unrelated file staged -> rc 0, no derive block */
    if (cx_fmt(p, sizeof p, "%s/notes.txt", repo)) cpd_abort("n1");
    if (cx_write(p, "hello2\n", 7)) cpd_abort("wn1");
    if (cx_fmt(cmd, sizeof cmd, "cd '%s' && git add notes.txt && UNISACC_PRECOMMIT_SERIAL=1 sh ./unisacc.com tools/precommit.cx", repo)) cpd_abort("c1");
    {
        int rc = ckk_sh("check-precommit-derive", cmd, out, sizeof out);
        ck(rc == 0 && ckk_has(out, CPD_OUT, "PRECOMMIT\tstaged_cx=0\tblocked=0") && !ckk_has(out, CPD_OUT, "BLOCKED derived-table"),
            "unrelated-file-passes: notes.txt staged -> rc=0 blocked=0");
    }

    /* 2. Edit tests/batches.tsv without recomputing build/links.tsv -> rc 1 BLOCKED with fix hint */
    {
        const char *bat2 = "# id\timplementation\tlayer\tsource\tmode\tplatform\tbudget\tmaterials\tentry\targs\tcoverage\texpect\theaders\ttier\n"
                           "b1\tIMPLEMENTED\tcontract\ttools/b1.cx\tSOURCE\tlnx/x86_64\t30\t-\ttools/b1.cx\t-\tcontract.b1\trc0:B1\tproduct\tcommit\n"
                           "b2\tIMPLEMENTED\tcontract\ttools/b2.cx\tSOURCE\tlnx/x86_64\t30\t-\ttools/b2.cx\t-\tcontract.b2\trc0:B2\tproduct\tcommit\n";
        if (cx_fmt(p, sizeof p, "%s/tests/batches.tsv", repo)) cpd_abort("b2p");
        if (cx_write(p, bat2, strlen(bat2))) cpd_abort("wb2");
    }
    if (cx_fmt(cmd, sizeof cmd, "cd '%s' && git reset -q && git add tests/batches.tsv && UNISACC_PRECOMMIT_SERIAL=1 sh ./unisacc.com tools/precommit.cx", repo)) cpd_abort("c2");
    {
        int rc = ckk_sh("check-precommit-derive", cmd, out, sizeof out);
        ck(rc == 1 && ckk_has(out, CPD_OUT, "BLOCKED derived-table-drift name=links") && ckk_has(out, CPD_OUT, "tools/derive.cx -- --write --only links"),
            "input-changed-no-recompute-blocked: batches.tsv changed without links -> rc=1 BLOCKED with fix cmd");
    }

    /* 3. Recompute build/links.tsv in worktree but forget to stage it -> rc 1 BLOCKED unstaged */
    if (cx_fmt(cmd, sizeof cmd, "cd '%s' && sh ./unisacc.com tools/derive.cx -- --write --only links && UNISACC_PRECOMMIT_SERIAL=1 sh ./unisacc.com tools/precommit.cx", repo)) cpd_abort("c3");
    {
        int rc = ckk_sh("check-precommit-derive", cmd, out, sizeof out);
        ck(rc == 1 && ckk_has(out, CPD_OUT, "BLOCKED derived-table-unstaged name=links"),
            "recomputed-but-unstaged-blocked: recomputed links not staged -> rc=1 BLOCKED unstaged");
    }

    /* 4. Stage recomputed build/links.tsv with tests/batches.tsv -> rc 0 */
    if (cx_fmt(cmd, sizeof cmd, "cd '%s' && git add build/links.tsv && UNISACC_PRECOMMIT_SERIAL=1 sh ./unisacc.com tools/precommit.cx", repo)) cpd_abort("c4");
    {
        int rc = ckk_sh("check-precommit-derive", cmd, out, sizeof out);
        ck(rc == 0 && ckk_has(out, CPD_OUT, "PRECOMMIT\tstaged_cx=0\tblocked=0"),
            "recomputed-and-staged-passes: recomputed links staged with batches.tsv -> rc=0 blocked=0");
    }

    /* 5. Active waiver in HEAD allows; staged self-waiver in same commit blocks; expired waiver blocks */
    {
        const char *bat3 = "# id\timplementation\tlayer\tsource\tmode\tplatform\tbudget\tmaterials\tentry\targs\tcoverage\texpect\theaders\ttier\n"
                           "b1\tIMPLEMENTED\tcontract\ttools/b1.cx\tSOURCE\tlnx/x86_64\t30\t-\ttools/b1.cx\t-\tcontract.b1\trc0:B1\tproduct\tcommit\n"
                           "b2\tIMPLEMENTED\tcontract\ttools/b2.cx\tSOURCE\tlnx/x86_64\t30\t-\ttools/b2.cx\t-\tcontract.b2\trc0:B2\tproduct\tcommit\n"
                           "b3\tIMPLEMENTED\tcontract\ttools/b3.cx\tSOURCE\tlnx/x86_64\t30\t-\ttools/b3.cx\t-\tcontract.b3\trc0:B3\tproduct\tcommit\n";
        if (cx_fmt(p, sizeof p, "%s/tests/batches.tsv", repo)) cpd_abort("b3p");
        if (cx_write(p, bat3, strlen(bat3))) cpd_abort("wb3");
        if (cx_fmt(p, sizeof p, "%s/tests/derive-gate-waivers.tsv", repo)) cpd_abort("wp");
        if (cx_write(p, "links\t2099-12-31\ttemporary-test-waiver\n", 39)) cpd_abort("ww1");
        /* 5a: HEAD has no waiver -> staging derive-gate-waivers.tsv in same commit as drifted batches.tsv must NOT self-waive */
        if (cx_fmt(cmd, sizeof cmd, "cd '%s' && git reset -q && git checkout -q -- build/links.tsv && git add tests/derive-gate-waivers.tsv tests/batches.tsv && UNISACC_PRECOMMIT_SERIAL=1 sh ./unisacc.com tools/precommit.cx", repo)) cpd_abort("c5self");
        int rc_self = ckk_sh("check-precommit-derive", cmd, out, sizeof out);
        ck(rc_self == 1 && ckk_has(out, CPD_OUT, "BLOCKED derived-table-drift name=links"),
            "staged-self-waiver-in-same-commit-blocked: staging new waiver in same commit does not self-waive");

        /* 5b: While worktree batches.tsv is drifted, a standalone commit staging ONLY derive-gate-waivers.tsv must pass precommit (rc 0);
         *     then staging drifted batches.tsv is allowed (rc 0); expiring waiver in staged index blocks (rc 1) */
        if (cx_fmt(cmd, sizeof cmd,
            "cd '%s' && git reset -q && git add tests/derive-gate-waivers.tsv && "
            "UNISACC_PRECOMMIT_SERIAL=1 sh ./unisacc.com tools/precommit.cx", repo)) cpd_abort("c5wonly");
        int rc_wonly = ckk_sh("check-precommit-derive", cmd, out, sizeof out);
        int wonly_ok = (rc_wonly == 0 && ckk_has(out, CPD_OUT, "PRECOMMIT\tstaged_cx=0\tblocked=0"));
        if (cx_fmt(cmd, sizeof cmd,
            "cd '%s' && git -c user.name=t -c user.email=t@t commit -q -m add-head-waiver", repo)) cpd_abort("c5hw");
        cpd_sh(cmd, out);
        if (cx_fmt(p, sizeof p, "%s/tests/batches.tsv", repo)) cpd_abort("b3p2");
        if (cx_write(p, bat3, strlen(bat3))) cpd_abort("wb32");
        if (cx_fmt(cmd, sizeof cmd, "cd '%s' && git add tests/batches.tsv && UNISACC_PRECOMMIT_SERIAL=1 sh ./unisacc.com tools/precommit.cx", repo)) cpd_abort("c5a");
        int rc_act = ckk_sh("check-precommit-derive", cmd, out, sizeof out);

        if (cx_fmt(p, sizeof p, "%s/tests/derive-gate-waivers.tsv", repo)) cpd_abort("wp2");
        if (cx_write(p, "links\t2020-01-01\texpired-test-waiver\n", 37)) cpd_abort("ww2");
        if (cx_fmt(cmd, sizeof cmd, "cd '%s' && git add tests/derive-gate-waivers.tsv tests/batches.tsv && UNISACC_PRECOMMIT_SERIAL=1 sh ./unisacc.com tools/precommit.cx", repo)) cpd_abort("c5b");
        int rc_exp = ckk_sh("check-precommit-derive", cmd, out, sizeof out);
        int exp_blk = (rc_exp == 1 && ckk_has(out, CPD_OUT, "BLOCKED derived-table-drift name=links"));
        if (cx_fmt(cmd, sizeof cmd,
            "cd '%s' && git reset -q && git rm -qf tests/derive-gate-waivers.tsv && "
            "git -c user.name=t -c user.email=t@t commit -q -m rm-head-waiver && git add tests/batches.tsv", repo)) cpd_abort("c5rm");
        cpd_sh(cmd, out);
        ck(wonly_ok && rc_act == 0 && exp_blk,
            "waiver-active-and-expired: standalone waiver commit passes under drift; HEAD active waiver rc=0; expired waiver rc=1 BLOCKED");
    }

    /* 6, 7 & 8. Real git commit through .git/hooks/pre-commit (precommit-flow.cx: --plan + flowexec + --from-run) */
    {
        char hp[CPD_PW];
        const char *hook = "#!/bin/sh\nexec sh ./unisacc.com tools/precommit-flow.cx\n";
        if (cx_fmt(hp, sizeof hp, "%s/.git/hooks/pre-commit", repo)) cpd_abort("hp");
        if (cx_write(hp, hook, strlen(hook))) cpd_abort("whp");
        (void)chmod(hp, 0755);

        /* 6: precommit-flow executes derive node (no rc=-1) and blocks stale real commit */
        if (cx_fmt(cmd, sizeof cmd, "cd '%s' && git -c user.name=t -c user.email=t@t commit -q -m should-fail", repo)) cpd_abort("c6");
        int rc_blk = ckk_sh("check-precommit-derive", cmd, out, sizeof out);
        int blk_ok = (rc_blk != 0 && ckk_has(out, CPD_OUT, "BLOCKED derived-table-drift name=links") &&
                      !ckk_has(out, CPD_OUT, "from-run node derive rc=-1"));
        ck(blk_ok, "flow-plan-and-from-run-blocked: precommit-flow executes derive node and blocks rc=1");

        /* 7: real commit succeeds after recompute + stage */
        if (cx_fmt(cmd, sizeof cmd,
            "cd '%s' && sh ./unisacc.com tools/derive.cx -- --write --only links && git add build/links.tsv && "
            "git -c user.name=t -c user.email=t@t commit -q -m recomputed-ok", repo)) cpd_abort("c7");
        int rc_ok = ckk_sh("check-precommit-derive", cmd, out, sizeof out);
        ck(blk_ok && rc_ok == 0 && ckk_has(out, CPD_OUT, "PRECOMMIT\tstaged_cx=0\tblocked=0"),
            "real-commit-after-recompute-ok: real git commit blocked when stale, succeeds after recompute");

        /* 8: unrelated file real commit succeeds with no derive node */
        if (cx_fmt(p, sizeof p, "%s/notes.txt", repo)) cpd_abort("n8");
        if (cx_write(p, "hello3\n", 7)) cpd_abort("wn8");
        if (cx_fmt(cmd, sizeof cmd,
            "cd '%s' && git add notes.txt && git -c user.name=t -c user.email=t@t commit -q -m unrelated-ok", repo)) cpd_abort("c8");
        int rc_un = ckk_sh("check-precommit-derive", cmd, out, sizeof out);
        ck(rc_un == 0 && ckk_has(out, CPD_OUT, "PRECOMMIT\tstaged_cx=0\tblocked=0") && !ckk_has(out, CPD_OUT, "DERIVE_GATE_UNAVAILABLE"),
            "real-commit-unrelated-zero-overhead: unrelated git commit succeeds cleanly");
    }

    /* 9. Fail-safe: broken tools/derive.cx prints DERIVE_GATE_UNAVAILABLE and allows commit (rc 0) */
    if (cx_fmt(repo2, sizeof repo2, "%s/repo-broken", work)) cpd_abort("r2");
    cpd_mk(repo2);
    if (cx_fmt(p, sizeof p, "%s/exec", repo2)) cpd_abort("r2p1"); cpd_mk(p);
    if (cx_fmt(p, sizeof p, "%s/exec/facts", repo2)) cpd_abort("r2p2"); cpd_mk(p);
    if (cx_fmt(p, sizeof p, "%s/tests", repo2)) cpd_abort("r2p3"); cpd_mk(p);
    if (cx_fmt(p, sizeof p, "%s/build", repo2)) cpd_abort("r2p4"); cpd_mk(p);
    if (cx_fmt(p, sizeof p, "%s/tools", repo2)) cpd_abort("r2p5"); cpd_mk(p);
    if (cx_fmt(cmd, sizeof cmd,
        "ln -s '%s/unisacc.com' '%s/unisacc.com' && ln -sn '%s/cx' '%s/cx' && ln -sn '%s/ext' '%s/ext' && ln -s '%s/cxroot.tsv' '%s/cxroot.tsv' && "
        "ln -s '%s/tools/precommit.cx' '%s/tools/precommit.cx' && ln -sn '%s/tools/cxlib' '%s/tools/cxlib'",
        cwd, repo2, cwd, repo2, cwd, repo2, cwd, repo2, cwd, repo2, cwd, repo2)) cpd_abort("r2ln");
    cpd_sh(cmd, out);
    {
        const char *der = "# name\tgenerator\tcheck_argv\twrite_argv\toutputs\tinputs_glob\torder\tbound_s\n"
                          "links\ttools/links-gen.cx\tchk\twr\tbuild/links.tsv\ttests/batches.tsv\t5\t20\n";
        if (cx_fmt(p, sizeof p, "%s/exec/facts/derive.tsv", repo2)) cpd_abort("r2f1");
        if (cx_write(p, der, strlen(der))) cpd_abort("r2w1");
        if (cx_fmt(p, sizeof p, "%s/tests/batches.tsv", repo2)) cpd_abort("r2f2");
        if (cx_write(p, "b1\n", 3)) cpd_abort("r2w2");
        if (cx_fmt(p, sizeof p, "%s/tools/derive.cx", repo2)) cpd_abort("r2f3");
        if (cx_write(p, "int main(void){return 99;}\n", 27)) cpd_abort("r2w3");
    }
    if (cx_fmt(cmd, sizeof cmd,
        "cd '%s' && git init -q && git add exec/facts/derive.tsv tests/batches.tsv && "
        "git -c user.name=t -c user.email=t@t commit -q -m init && "
        "printf 'b2\\n' >> tests/batches.tsv && git add tests/batches.tsv && "
        "UNISACC_PRECOMMIT_SERIAL=1 sh ./unisacc.com tools/precommit.cx", repo2)) cpd_abort("c9");
    {
        int rc = ckk_sh("check-precommit-derive", cmd, out, sizeof out);
        ck(rc == 0 && ckk_has(out, CPD_OUT, "DERIVE_GATE_UNAVAILABLE") && ckk_has(out, CPD_OUT, "PRECOMMIT\tstaged_cx=0\tblocked=0"),
            "fail-safe-unavailable-allows: broken derive.cx warns DERIVE_GATE_UNAVAILABLE and allows rc=0");
    }

    /* 10. Real git commit adding tools/*.cx with ignored build/product-map.tsv present vs absent:
     *     (a) ignored build/product-map.tsv is excluded from build/table-index.tsv;
     *     (b) adding tools/check-newdemo.cx does not change table-index -> real git commit passes rc=0;
     *     (c) adding tools/newreader.cx referencing build/links.tsv changes readers_count -> blocked until recomputed & staged. */
    {
        char repo3[CPD_PW], hp[CPD_PW];
        const char *der = "# name\tgenerator\tcheck_argv\twrite_argv\toutputs\tinputs_glob\torder\tbound_s\n"
                          "table-index\ttools/tool-index.cx\tsh ./unisacc.com tools/tool-index.cx -- --check-tables\tsh ./unisacc.com tools/tool-index.cx -- --tables\tbuild/table-index.tsv\ttools/* tests/batches.tsv build/*\t7\t30\n";
        const char *bat = "# id\timplementation\tlayer\tsource\tmode\tplatform\tbudget\tmaterials\tentry\targs\tcoverage\texpect\theaders\ttier\n"
                          "demo1\tIMPLEMENTED\tcontract\ttools/check-newdemo.cx\tSOURCE\tlnx/x86_64\t30\t-\ttools/check-newdemo.cx\t-\tcontract.d1\trc0:D1\tproduct\tcommit\n"
                          "demo2\tIMPLEMENTED\tcontract\ttools/check-newreader.cx\tSOURCE\tlnx/x86_64\t30\t-\ttools/check-newreader.cx\t-\tcontract.d2\trc0:D2\tproduct\tcommit\n";
        const char *hook = "#!/bin/sh\nUNISACC_PRECOMMIT_SERIAL=1 exec sh ./unisacc.com tools/precommit.cx\n";
        if (cx_fmt(repo3, sizeof repo3, "%s/repo-tidx", work)) cpd_abort("r3");
        cpd_mk(repo3);
        if (cx_fmt(p, sizeof p, "%s/exec", repo3)) cpd_abort("r3p1"); cpd_mk(p);
        if (cx_fmt(p, sizeof p, "%s/exec/facts", repo3)) cpd_abort("r3p2"); cpd_mk(p);
        if (cx_fmt(p, sizeof p, "%s/tests", repo3)) cpd_abort("r3p3"); cpd_mk(p);
        if (cx_fmt(p, sizeof p, "%s/build", repo3)) cpd_abort("r3p4"); cpd_mk(p);
        if (cx_fmt(p, sizeof p, "%s/tools", repo3)) cpd_abort("r3p5"); cpd_mk(p);
        if (cx_fmt(cmd, sizeof cmd,
            "ln -s '%s/unisacc.com' '%s/unisacc.com' && ln -sn '%s/cx' '%s/cx' && ln -sn '%s/ext' '%s/ext' && ln -s '%s/cxroot.tsv' '%s/cxroot.tsv' && "
            "ln -s '%s/tools/precommit.cx' '%s/tools/precommit.cx' && ln -s '%s/tools/derive.cx' '%s/tools/derive.cx' && "
            "ln -s '%s/tools/tool-index.cx' '%s/tools/tool-index.cx' && ln -s '%s/tools/bound' '%s/tools/bound' && ln -s '%s/tools/bound.c' '%s/tools/bound.c' && ln -sn '%s/tools/cxlib' '%s/tools/cxlib'",
            cwd, repo3, cwd, repo3, cwd, repo3, cwd, repo3,
            cwd, repo3, cwd, repo3, cwd, repo3, cwd, repo3, cwd, repo3, cwd, repo3)) cpd_abort("r3ln");
        cpd_sh(cmd, out);
        if (cx_fmt(p, sizeof p, "%s/.gitignore", repo3)) cpd_abort("r3g");
        if (cx_write(p, "/build/product-map.tsv\n/.devsvc/\n", 33)) cpd_abort("r3gw");
        if (cx_fmt(p, sizeof p, "%s/exec/facts/derive.tsv", repo3)) cpd_abort("r3f1");
        if (cx_write(p, der, strlen(der))) cpd_abort("r3w1");
        if (cx_fmt(p, sizeof p, "%s/tests/batches.tsv", repo3)) cpd_abort("r3f2");
        if (cx_write(p, bat, strlen(bat))) cpd_abort("r3w2");
        if (cx_fmt(p, sizeof p, "%s/build/links.tsv", repo3)) cpd_abort("r3f3");
        if (cx_write(p, "# links\na\tb\n", 12)) cpd_abort("r3w3");
        if (cx_fmt(p, sizeof p, "%s/build/product-map.tsv", repo3)) cpd_abort("r3f4");
        if (cx_write(p, "ignored\tlocal\n", 14)) cpd_abort("r3w4");
        if (cx_fmt(p, sizeof p, "%s/tools/check-newreader.cx", repo3)) cpd_abort("r3f5");
        if (cx_write(p, "int main(void){return 0;}\n", 26)) cpd_abort("r3w5");

        if (cx_fmt(cmd, sizeof cmd,
            "cd '%s' && git init -q && "
            "git add .gitignore exec/facts/derive.tsv tests/batches.tsv build/links.tsv tools/check-newreader.cx && "
            "sh ./unisacc.com tools/derive.cx -- --write --only table-index && git add build/table-index.tsv && "
            "git -c user.name=t -c user.email=t@t commit -q -m init", repo3)) cpd_abort("r3init");
        cpd_sh(cmd, out);
        if (cx_fmt(hp, sizeof hp, "%s/.git/hooks/pre-commit", repo3)) cpd_abort("r3hp");
        if (cx_write(hp, hook, strlen(hook))) cpd_abort("r3whp");
        (void)chmod(hp, 0755);

        /* Verify build/table-index.tsv excludes ignored product-map.tsv */
        int no_pmap = 0;
        {
            size_t tin = 0;
            char *tib;
            if (cx_fmt(p, sizeof p, "%s/build/table-index.tsv", repo3)) cpd_abort("r3ti");
            tib = (char *)cx_read(p, &tin);
            no_pmap = (tib != 0 && !ckk_has(tib, (long)tin, "product-map.tsv"));
            if (tib) mm_free(tib);
        }

        /* (a) Add tools/check-newdemo.cx (does not change table-index), remove untracked product-map.tsv to mimic clean hook sandbox -> commit passes */
        if (cx_fmt(p, sizeof p, "%s/tools/check-newdemo.cx", repo3)) cpd_abort("r3nd");
        if (cx_write(p, "int main(void){return 0;}\n", 26)) cpd_abort("r3wnd");
        if (cx_fmt(p, sizeof p, "%s/build/product-map.tsv", repo3)) cpd_abort("r3pm");
        (void)sy_unlink(p);
        if (cx_fmt(cmd, sizeof cmd,
            "cd '%s' && git add tools/check-newdemo.cx && git -c user.name=t -c user.email=t@t commit -q -m add-check", repo3)) cpd_abort("r3c1");
        int rc_chk_ok = ckk_sh("check-precommit-derive", cmd, out, sizeof out);

        /* (b) Add tools/newreader.cx referencing build/links.tsv -> blocked without table-index recompute, passes after recompute + stage */
        if (cx_fmt(p, sizeof p, "%s/tools/newreader.cx", repo3)) cpd_abort("r3nr");
        if (cx_write(p, "/* reads build/links.tsv */\nint main(void){return 0;}\n", 54)) cpd_abort("r3wnr");
        if (cx_fmt(cmd, sizeof cmd,
            "cd '%s' && git add tools/newreader.cx && git -c user.name=t -c user.email=t@t commit -q -m add-reader-stale", repo3)) cpd_abort("r3c2");
        int rc_rd_blk = ckk_sh("check-precommit-derive", cmd, out, sizeof out);
        int rd_blk_ok = (rc_rd_blk != 0 && ckk_has(out, CPD_OUT, "BLOCKED derived-table-drift name=table-index"));

        if (cx_fmt(cmd, sizeof cmd,
            "cd '%s' && sh ./unisacc.com tools/derive.cx -- --write --only table-index && git add build/table-index.tsv && "
            "git -c user.name=t -c user.email=t@t commit -q -m add-reader-ok", repo3)) cpd_abort("r3c3");
        int rc_rd_ok = ckk_sh("check-precommit-derive", cmd, out, sizeof out);

        ck(no_pmap && rc_chk_ok == 0 && rd_blk_ok && rc_rd_ok == 0,
            "table-index-new-tool-real-commit: excludes ignored product-map.tsv; check- tool passes, reader tool blocks until recomputed");

        /* (c) Modify existing tools/newreader.cx (M, not AD) dropping build/links.tsv reference -> must block until table-index recomputed & staged */
        if (cx_fmt(p, sizeof p, "%s/tools/newreader.cx", repo3)) cpd_abort("r3m1");
        if (cx_write(p, "/* no table ref now */\nint main(void){return 0;}\n", 49)) cpd_abort("r3wm1");
        if (cx_fmt(cmd, sizeof cmd,
            "cd '%s' && git add tools/newreader.cx && git -c user.name=t -c user.email=t@t commit -q -m mod-reader-stale", repo3)) cpd_abort("r3c4");
        int rc_mod_blk = ckk_sh("check-precommit-derive", cmd, out, sizeof out);
        int mod_blk_ok = (rc_mod_blk != 0 && ckk_has(out, CPD_OUT, "BLOCKED derived-table-drift name=table-index"));

        if (cx_fmt(cmd, sizeof cmd,
            "cd '%s' && sh ./unisacc.com tools/derive.cx -- --write --only table-index && git add build/table-index.tsv && "
            "git -c user.name=t -c user.email=t@t commit -q -m mod-reader-ok", repo3)) cpd_abort("r3c5");
        int rc_mod_ok = ckk_sh("check-precommit-derive", cmd, out, sizeof out);

        ck(mod_blk_ok && rc_mod_ok == 0,
            "table-index-modified-tool-real-commit: modifying existing tool table references blocks until table-index recomputed");
    }

    /* 11. (a) Invoking precommit from a subdirectory and real git commit hook from a version worktree subdirectory (.claude/worktrees/v0.0.99/tests);
     *     (b) Staged deletion of derive.tsv / derive.cx / reg-manifest.cx / tables-gen.cx refused with named error instead of silent skip. */
    {
        char hp[CPD_PW], repo4[CPD_PW];
        const char *wthook = "#!/bin/sh\nroot=$(cd \"$(git rev-parse --git-common-dir)/..\" && pwd -P)\nUNISACC_PRECOMMIT_SERIAL=1 exec sh \"$root/unisacc.com\" \"$root/tools/precommit.cx\"\n";
        if (cx_fmt(hp, sizeof hp, "%s/.git/hooks/pre-commit", repo)) cpd_abort("hp11");
        if (cx_write(hp, wthook, strlen(wthook))) cpd_abort("whp11");
        (void)chmod(hp, 0755);

        /* 11a-1: Direct invocation from repo/tests subdirectory with drifted tests/batches.tsv */
        if (cx_fmt(cmd, sizeof cmd,
            "cd '%s/tests' && printf 'b4\\tIMPLEMENTED\\tcontract\\ttools/b4.cx\\tSOURCE\\tlnx/x86_64\\t30\\t-\\ttools/b4.cx\\t-\\tcontract.b4\\trc0:B4\\tproduct\\tcommit\\n' >> batches.tsv && "
            "git add batches.tsv && UNISACC_PRECOMMIT_SERIAL=1 sh '%s/unisacc.com' '%s/tools/precommit.cx'",
            repo, repo, repo)) cpd_abort("c11a1");
        int rc_sub = ckk_sh("check-precommit-derive", cmd, out, sizeof out);
        int sub_ok = (rc_sub == 1 && ckk_has(out, CPD_OUT, "BLOCKED derived-table-drift name=links") &&
                      !ckk_has(out, CPD_OUT, "DERIVE_GATE_UNAVAILABLE"));
        ck(sub_ok, "subdir-direct-precommit-blocks-drift: invoking precommit from repo/tests subdirectory finds unisacc.com and blocks drift");

        /* 11a-2: Real git commit triggering .git/hooks/pre-commit from version worktree subdirectory (.claude/worktrees/v0.0.99/tests) */
        if (cx_fmt(cmd, sizeof cmd,
            "cd '%s' && git reset -q && git checkout -q -- tests/batches.tsv && "
            "git worktree add -q -b v0.0.99 .claude/worktrees/v0.0.99 && "
            "cd .claude/worktrees/v0.0.99/tests && "
            "printf 'b5\\tIMPLEMENTED\\tcontract\\ttools/b5.cx\\tSOURCE\\tlnx/x86_64\\t30\\t-\\ttools/b5.cx\\t-\\tcontract.b5\\trc0:B5\\tproduct\\tcommit\\n' >> batches.tsv && "
            "git add batches.tsv && git -c user.name=t -c user.email=t@t commit -q -m wt-subdir-should-fail",
            repo)) cpd_abort("c11a2");
        int rc_wt_blk = ckk_sh("check-precommit-derive", cmd, out, sizeof out);
        int wt_blk_ok = (rc_wt_blk != 0 && ckk_has(out, CPD_OUT, "BLOCKED derived-table-drift name=links") &&
                         !ckk_has(out, CPD_OUT, "DERIVE_GATE_UNAVAILABLE"));

        if (cx_fmt(cmd, sizeof cmd,
            "cd '%s/.claude/worktrees/v0.0.99/tests' && cp batches.tsv ../build/links.tsv && git add ../build/links.tsv && "
            "git -c user.name=t -c user.email=t@t commit -q -m wt-subdir-recomputed-ok",
            repo)) cpd_abort("c11a3");
        int rc_wt_ok = ckk_sh("check-precommit-derive", cmd, out, sizeof out);
        ck(wt_blk_ok && rc_wt_ok == 0,
            "version-worktree-subdir-hook-blocks-and-passes: real git commit in .claude/worktrees/v0.0.99/tests blocks drift and passes after recompute");

        /* 11b: Staged deletion of all 6 core gate files (derive.tsv, derive.cx, reg-manifest.cx, tables-gen.cx, gen-all-check.cx, ledger-add.cx) refused with named error */
        if (cx_fmt(repo4, sizeof repo4, "%s/repo-del", work)) cpd_abort("r4");
        cpd_mk(repo4);
        if (cx_fmt(p, sizeof p, "%s/exec", repo4)) cpd_abort("r4p1"); cpd_mk(p);
        if (cx_fmt(p, sizeof p, "%s/exec/facts", repo4)) cpd_abort("r4p2"); cpd_mk(p);
        if (cx_fmt(p, sizeof p, "%s/tests", repo4)) cpd_abort("r4p3"); cpd_mk(p);
        if (cx_fmt(p, sizeof p, "%s/tools", repo4)) cpd_abort("r4p4"); cpd_mk(p);
        if (cx_fmt(cmd, sizeof cmd,
            "ln -s '%s/unisacc.com' '%s/unisacc.com' && ln -sn '%s/cx' '%s/cx' && ln -sn '%s/ext' '%s/ext' && "
            "ln -s '%s/cxroot.tsv' '%s/cxroot.tsv' && ln -sn '%s/tools/cxlib' '%s/tools/cxlib' && "
            "ln -s '%s/tools/precommit.cx' '%s/tools/precommit.cx' && "
            "printf '# derive\\n' > '%s/exec/facts/derive.tsv' && "
            "printf 'int main(void){return 0;}\\n' > '%s/tools/derive.cx' && "
            "printf 'int main(void){return 0;}\\n' > '%s/tools/reg-manifest.cx' && "
            "printf 'int main(void){return 0;}\\n' > '%s/tools/tables-gen.cx' && "
            "printf 'int main(void){return 0;}\\n' > '%s/tools/gen-all-check.cx' && "
            "printf 'int main(void){return 0;}\\n' > '%s/tools/ledger-add.cx' && "
            "printf '# batches\\n' > '%s/tests/batches.tsv' && "
            "cd '%s' && git init -q && git add exec/facts/derive.tsv tools/derive.cx tools/reg-manifest.cx tools/tables-gen.cx tools/gen-all-check.cx tools/ledger-add.cx tests/batches.tsv && "
            "git -c user.name=t -c user.email=t@t commit -q -m init",
            cwd, repo4, cwd, repo4, cwd, repo4, cwd, repo4, cwd, repo4, cwd, repo4,
            repo4, repo4, repo4, repo4, repo4, repo4, repo4, repo4)) cpd_abort("r4init");
        cpd_sh(cmd, out);

        if (cx_fmt(cmd, sizeof cmd,
            "cd '%s' && git rm -qf exec/facts/derive.tsv && UNISACC_PRECOMMIT_SERIAL=1 sh ./unisacc.com tools/precommit.cx", repo4)) cpd_abort("r4d1");
        int rc_d1 = ckk_sh("check-precommit-derive", cmd, out, sizeof out);
        int ok_d1 = (rc_d1 == 1 && ckk_has(out, CPD_OUT, "BLOCKED derive-gate-deleted path=exec/facts/derive.tsv"));

        if (cx_fmt(cmd, sizeof cmd,
            "cd '%s' && git reset -q && git checkout -q -- exec/facts/derive.tsv && "
            "git rm -qf tools/derive.cx && UNISACC_PRECOMMIT_SERIAL=1 sh ./unisacc.com tools/precommit.cx", repo4)) cpd_abort("r4d2");
        int rc_d2 = ckk_sh("check-precommit-derive", cmd, out, sizeof out);
        int ok_d2 = (rc_d2 == 1 && ckk_has(out, CPD_OUT, "BLOCKED derive-gate-deleted path=tools/derive.cx"));

        if (cx_fmt(cmd, sizeof cmd,
            "cd '%s' && git reset -q && git checkout -q -- tools/derive.cx && "
            "git rm -qf tools/reg-manifest.cx && UNISACC_PRECOMMIT_SERIAL=1 sh ./unisacc.com tools/precommit.cx", repo4)) cpd_abort("r4d3");
        int rc_d3 = ckk_sh("check-precommit-derive", cmd, out, sizeof out);
        int ok_d3 = (rc_d3 == 1 && ckk_has(out, CPD_OUT, "BLOCKED manifest-gate-deleted path=tools/reg-manifest.cx"));

        if (cx_fmt(cmd, sizeof cmd,
            "cd '%s' && git reset -q && git checkout -q -- tools/reg-manifest.cx && "
            "git rm -qf tools/tables-gen.cx && UNISACC_PRECOMMIT_SERIAL=1 sh ./unisacc.com tools/precommit.cx", repo4)) cpd_abort("r4d4");
        int rc_d4 = ckk_sh("check-precommit-derive", cmd, out, sizeof out);
        int ok_d4 = (rc_d4 == 1 && ckk_has(out, CPD_OUT, "BLOCKED tables-gate-deleted path=tools/tables-gen.cx"));

        if (cx_fmt(cmd, sizeof cmd,
            "cd '%s' && git reset -q && git checkout -q -- tools/tables-gen.cx && "
            "git rm -qf tools/gen-all-check.cx && UNISACC_PRECOMMIT_SERIAL=1 sh ./unisacc.com tools/precommit.cx", repo4)) cpd_abort("r4d5");
        int rc_d5 = ckk_sh("check-precommit-derive", cmd, out, sizeof out);
        int ok_d5 = (rc_d5 == 1 && ckk_has(out, CPD_OUT, "BLOCKED genall-gate-deleted path=tools/gen-all-check.cx"));

        if (cx_fmt(cmd, sizeof cmd,
            "cd '%s' && git reset -q && git checkout -q -- tools/gen-all-check.cx && "
            "git rm -qf tools/ledger-add.cx && UNISACC_PRECOMMIT_SERIAL=1 sh ./unisacc.com tools/precommit.cx", repo4)) cpd_abort("r4d6");
        int rc_d6 = ckk_sh("check-precommit-derive", cmd, out, sizeof out);
        int ok_d6 = (rc_d6 == 1 && ckk_has(out, CPD_OUT, "BLOCKED ledger-gate-deleted path=tools/ledger-add.cx"));

        ck(ok_d1 && ok_d2 && ok_d3 && ok_d4 && ok_d5 && ok_d6,
            "staged-delete-core-gate-files-blocked: staging deletion of all 6 core gate files is refused");

        /* 11c: ENOTDIR (only ENOENT is treated as absent) and ledger_gate missing HEAD baseline must block instead of silent return 0 */
        if (cx_fmt(cmd, sizeof cmd,
            "cd '%s' && git reset -q && git checkout -q -- tools/ledger-add.cx && "
            "mkdir -p archive/agentwork-retire-2026-11 && printf 'a\\tb\\n' > archive/agentwork-retire-2026-11/ledger.tsv && "
            "git add archive/agentwork-retire-2026-11/ledger.tsv && "
            "UNISACC_PRECOMMIT_SERIAL=1 sh ./unisacc.com tools/precommit.cx", repo4)) cpd_abort("r4l1");
        int rc_l1 = ckk_sh("check-precommit-derive", cmd, out, sizeof out);
        int ok_l1 = (rc_l1 == 1 && ckk_has(out, CPD_OUT, "BLOCKED ledger: cannot read HEAD:build/ledger-format-baseline.tsv"));

        if (cx_fmt(cmd, sizeof cmd,
            "cd '%s' && git reset -q && rm -rf exec/facts && printf 'not-a-dir\\n' > exec/facts && "
            "printf '# b2\\n' >> tests/batches.tsv && git add tests/batches.tsv && "
            "UNISACC_PRECOMMIT_NO_ISOLATE=1 UNISACC_PRECOMMIT_SERIAL=1 sh ./unisacc.com tools/precommit.cx", repo4)) cpd_abort("r4en");
        int rc_en = ckk_sh("check-precommit-derive", cmd, out, sizeof out);
        int ok_en = (rc_en == 1 && ckk_has(out, CPD_OUT, "BLOCKED derive-unreadable path=exec/facts/derive.tsv"));

        ck(ok_l1 && ok_en,
            "enotdir-and-ledger-missing-baseline-blocked: ENOTDIR and missing ledger HEAD baseline refuse instead of silent pass");
    }

    {
        char *rmv[] = {"rm", "-rf", work, 0};
        (void)ck_run(rmv, out, sizeof out);
    }

    printf("CHECK_PRECOMMIT_DERIVE\tok=%d\tfailed=%d\tms=%ld\n", ck_assertions() - ck_failures(), ck_failures(), sy_now_ms() - t0);
    return ck_failures() ? 1 : 0;
}
