#pragma unisa use sys.proc
#pragma unisa use sys.io
/* Narrow check: cx/compiler/streamname.cx is the bytes tools/stream-gen.cx
   emits from exec/pipeline/image-stages.tsv. The seven names are not listed
   again here.
   sh ./unisacc.com tools/check-stream-name.cx */
int main(void) {
    char *av[] = {"sh", "./unisacc.com", "tools/stream-gen.cx", "--", "--check", 0};
    char buf[4096];
    int cut = 0;
    int rc = sy_run(av, buf, (int)sizeof buf, &cut);
    if (rc != 0 || cut) {
        sy_printf("%s", buf);
        sy_printf("CX_STREAM_NAME\tfailed=1\trc=%d\tcut=%d\n", rc, cut);
        return 1;
    }
    sy_printf("%s", buf);
    sy_printf("CX_STREAM_NAME\tfailed=0\n");
    return 0;
}
