#pragma unisa use compiler.streamname
#pragma unisa use text.text
#pragma unisa use sys.io
/* Narrow check for compiler.streamname.
   sh ./unisacc.com tools/check-stream-name.cx */
static int bad;
static void ok(int c, const char *n) {
    sy_printf("%s\t%s\n", c ? "PASS" : "FAIL", n);
    if (!c) bad = 1;
}
int main(void) {
    const char *official;
    const char *code;
    ok(sn_count() == 7, "count");
    ok(sn_at(0, 0, &code) == 4, "null-official");
    ok(sn_at(0, &official, 0) == 4, "null-code");
    ok(sn_at(-1, &official, &code) == 2, "low");
    ok(sn_at(7, &official, &code) == 2, "high");
    ok(sn_at(0, &official, &code) == 0 && tx_eqz(official, "preprocess") && tx_eqz(code, "e2"), "preprocess");
    ok(sn_at(1, &official, &code) == 0 && tx_eqz(official, "lex") && tx_eqz(code, "e1"), "lex");
    ok(sn_at(2, &official, &code) == 0 && tx_eqz(official, "parse") && tx_eqz(code, "e3"), "parse");
    ok(sn_at(3, &official, &code) == 0 && tx_eqz(official, "opt") && tx_eqz(code, "e4"), "opt");
    ok(sn_at(4, &official, &code) == 0 && tx_eqz(official, "prune") && tx_eqz(code, "prune"), "prune");
    ok(sn_at(5, &official, &code) == 0 && tx_eqz(official, "lowering") && tx_eqz(code, "lower"), "lowering");
    ok(sn_at(6, &official, &code) == 0 && tx_eqz(official, "encode") && tx_eqz(code, "elf"), "encode");
    sy_printf("CX_STREAM_NAME\tfailed=%d\n", bad);
    return bad;
}
