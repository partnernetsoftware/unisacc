/* Read-only census. Bytes/physical lines/branch tokens are proxies, never semantic decision shares.
 * --sources ROOT | --slice TARGET FILE | --ape FILE. Can combine modes.
 * Final-image provenance is absent: module attribution remains explicitly UNKNOWN. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sysx.process
#pragma unisa use runtime.codec
#pragma unisa use text.text
#pragma unisa use runtime.package_decode
#pragma unisa use runtime.package_lifetime
#pragma unisa use compiler.bindstage
#pragma unisa use runtime.model_number
#pragma unisa use runtime.packagefooter
static void fail(const char *s){fprintf(stderr,"logic-distribution REFUSE %s\n",s);exit(2);}
static unsigned long rd(const unsigned char *s,int k){unsigned long v=0;for(int i=k-1;i>=0;i--)v=v*256+s[i];return v;}
static char *load(const char *p,size_t *n){char *s=cx_read(p,n);if(!s)fail(p);return s;}
static int suffix(const char *s,const char *t){size_t a=strlen(s),b=strlen(t);return a>=b&&!strcmp(s+a-b,t);}
static long branches(const char *s,size_t n){long count=0;size_t i=0;while(i<n){if(i+1<n&&s[i]=='/'&&s[i+1]=='/'){while(i<n&&s[i]!='\n')i++;continue;}if(i+1<n&&s[i]=='/'&&s[i+1]=='*'){i+=2;while(i+1<n&&!(s[i]=='*'&&s[i+1]=='/'))i++;i+=2;continue;}if(s[i]=='\''||s[i]=='"'){int q=s[i++];while(i<n){if(s[i]=='\\'&&i+1<n){i+=2;continue;}if(s[i++]==q)break;}continue;}if((s[i]>='a'&&s[i]<='z')||(s[i]>='A'&&s[i]<='Z')||s[i]=='_'){size_t a=i++;while(i<n&&((s[i]>='a'&&s[i]<='z')||(s[i]>='A'&&s[i]<='Z')||(s[i]>='0'&&s[i]<='9')||s[i]=='_'))i++;if((i-a==2&&!memcmp(s+a,"if",2))||(i-a==4&&!memcmp(s+a,"case",4))||(i-a==6&&!memcmp(s+a,"switch",6)))count++;}else{if(s[i]=='?')count++;i++;}}return count;}
static int category(const char *p){if(suffix(p,".tsv"))return 0;if(suffix(p,".net")||suffix(p,".tbl")||suffix(p,".rows"))return 2;if(strstr(p,"-gen.cx")||!strcmp(p,"seed/gen.c")||!strncmp(p,"seed/gold_",10))return 1;return 3;}
static void sources(const char *root){char *v[]={"git","ls-files","--","src","cx","exec","seed","weights","tools",0};np_result r={0};char why[512]={0};long files[4]={0},bytes[4]={0},lines[4]={0},br[4]={0},rows[4]={0},total=0;const char *names[]={"TABLE","GENERATOR","NETWORK_REPRESENTATION","CLASSIC_MECHANISM"};if(np_run(v,root,0,20,&r,why,sizeof why)||r.rc||r.residue)fail("git tracked inventory");char *at=r.out;while(at&&*at){char *e=strchr(at,'\n');if(e)*e=0;if(suffix(at,".cx")||suffix(at,".c")||suffix(at,".h")||suffix(at,".inc")||suffix(at,".tsv")||suffix(at,".net")||suffix(at,".tbl")||suffix(at,".rows")){char p[4400];if(cx_fmt(p,sizeof p,"%s/%s",root,at))fail("path");struct stat st;if(lstat(p,&st))fail("inventory stat");if(S_ISREG(st.st_mode)){size_t n;char *s=load(p,&n);int c=category(at);long nl=0,nr=0;for(size_t j=0;j<n;j++){if(s[j]=='\n')nl++;if((j==0||s[j-1]=='\n')&&s[j]!='#'&&s[j]!='\n'&&s[j]!='\r')nr++;}if(n&&s[n-1]!='\n')nl++;files[c]++;bytes[c]+=n;lines[c]+=nl;rows[c]+=nr;if(c==1||c==3)br[c]+=branches(s,n);total+=n;printf("SOURCE\t%s\t%s\tbytes=%ld\tlines=%ld\n",names[c],at,(long)n,nl);free(s);}}if(!e)break;at=e+1;}for(int i=0;i<4;i++)printf("CATEGORY\t%s\tfiles=%ld\tbytes=%ld\tlines=%ld\tbranch_tokens=%ld\tnoncomment_rows=%ld\tbyte_share_ppm=%ld\n",names[i],files[i],bytes[i],lines[i],br[i],rows[i],total?bytes[i]*1000000/total:0);printf("DENOMINATOR\ttracked_regular_source_bytes=%ld\troots=src,cx,exec,seed,weights,tools\tsemantic_decision_share=UNKNOWN\tgenerated_artifacts_overlap_facts=YES\tbranch_tokens=if,case,switch,question;comments+strings_skipped;not_runtime_frequency\n",total);np_free(&r);}
static void image(const char *target,const unsigned char *s,long n,const char *origin){char h[65];const char *format="UNKNOWN";if(n>=4&&!memcmp(s,"\177ELF",4))format="ELF";if(n>=4&&rd(s,4)==0xfeedfacfUL)format="MACHO";if(n>=2&&s[0]=='M'&&s[1]=='Z')format="PE";if(!strcmp(format,"UNKNOWN"))fail("slice format");if(sy_sha256_hex(s,n,h))cx_sha256_hex(s,n,h);printf("SLICE\t%s\tformat=%s\tbytes=%ld\tsha256=%s\torigin=%s\n",target,format,n,h,origin);printf("MODULE\t%s\tUNATTRIBUTED\tbytes=%ld\treason=final_image_has_no_unit_provenance\n",target,n);printf("CONSERVATION\t%s\ttotal=%ld\tattributed=0\tunattributed=%ld\tsum=%ld\tstatus=EXACT\n",target,n,n,n);}
static void outer_pe(const unsigned char *s,long n,const char *p){if(n<64)fail("PE header");long pe=rd(s+60,4);if(pe<0||pe>n-24||memcmp(s+pe,"PE\0\0",4))fail("PE signature");long ns=rd(s+pe+6,2),op=rd(s+pe+20,2),tab=pe+24+op,end=tab+40*ns;if(ns<1||ns>96||tab<0||end>n)fail("PE sections");for(long i=0;i<ns;i++){long a=tab+40*i,len=rd(s+a+16,4),off=rd(s+a+20,4);if(off<0||len<0||off>n-len)fail("PE section extent");if(off+len>end)end=off+len;}image("win/x86_64",s,end,p);printf("NOTE\twin/x86_64 outer PE includes APE shell/version metadata; not original bare slice bytes\n");}
static void ape(const char *p){size_t n;unsigned char *s=(unsigned char *)load(p,&n);const char *keys[]={"Linuxx86_64) o=","Linuxaarch64|Linuxarm64) o=","Darwinx86_64) o=","Darwinarm64) o=","Windowsarm64) o="};const char *targets[]={"lnx/x86_64","lnx/arm64","osx/x86_64","osx/arm64","win/arm64"};int found=0;outer_pe(s,n,p);for(int i=0;i<5;i++){char head[8193];size_t hn=n>8192?8192:n;memcpy(head,s,hn);for(size_t j=0;j<hn;j++)if(!head[j])head[j]=' ';head[hn]=0;char *a=strstr(head,keys[i]);if(!a)continue;a+=strlen(keys[i]);long off=atol(a)-1;a=strstr(a," n=");if(!a)fail("APE length");long len=atol(a+3);if(off<0||len<18||off>(long)n-len||memcmp(s+off,"\037\213\010\000",4))fail("APE gzip extent/header");long raw=rd(s+off+len-4,4);if(raw<=0||raw>64*1024*1024)fail("inflate bound");unsigned char *b=malloc(raw);if(!b)fail("alloc");if(cxcodec_inflate(b,raw,s+off+10,len-18))fail("inflate");CxCodecCrc ctx;uint32_t crc;cxcodec_crc_init(&ctx);if(cxcodec_crc(&ctx,(char *)b,raw,&crc)||crc!=rd(s+off+len-8,4))fail("gzip crc");image(targets[i],b,raw,p);free(b);found++;}printf("APE_SLICES\tdecoded=%d\twin_x86_64=OUTER_PE_REQUIRES_BARE_SLICE\tmissing_slice=UNKNOWN\n",found);free(s);if(!found)fail("no embedded slices");}
static void *ld_alloc(void *old,size_t n){return realloc(old,n);}
static void package(const char *path){size_t n;unsigned char *s=(unsigned char *)load(path,&n);PackageFooter f;CxPackageDecode d={0};if(!packagefooter_locate_bytes(s,n,&f))fail("package footer");d.allocate=ld_alloc;d.release=free;if(cxpk_decode(&d,s+f.package_offset,f.package_length))fail(d.why?d.why:"package decode");for(int i=0;i<d.package.s;i++)printf("PACK_ROUTE\t%s\t%s\tmodel=%d\n",d.package.stages[i].route,d.package.stages[i].name,d.package.stages[i].model);long models=0,resources=0;for(int i=0;i<d.package.m;i++){models+=d.package.len[i];printf("PACK_MODEL\t%d\tstored=%d\traw=%d\n",i,d.package.len[i],d.package.raw[i]);}for(int i=0;i<d.package.nr;i++){CxPackageResource *r=&d.package.res[i];resources+=r->len;printf("PACK_RESOURCE\t%.*s\tstored=%d\traw=%d\n",r->n,s+f.package_offset+r->name,r->len,r->rawlen);}printf("PACK_TOTAL\tpackage_bytes=%ld\tmodels_stored=%ld\tresources_stored=%ld\tmetadata=%ld\tsemantic_decisions=UNKNOWN\n",f.package_length,models,resources,f.package_length-models-resources);d.package.file=0;cxpl_release(&d.package,free);free(s);}
int main(int argc,char **argv){int modes=0;for(int i=1;i<argc;i++){if(!strcmp(argv[i],"--selfcheck")){if(branches("if(x) /* if ? */ switch(x){case 1: puts(\"if?\");} x?1:0;",strlen("if(x) /* if ? */ switch(x){case 1: puts(\"if?\");} x?1:0;"))!=4||category("weights/a.tsv")!=0||category("tools/a-gen.cx")!=1||category("exec/a.net")!=2||category("src/a.cx")!=3)fail("census classifier");printf("CENSUS_SELFTEST PASS\n");modes++;}else if(!strcmp(argv[i],"--package")&&i+1<argc){package(argv[++i]);modes++;}else if(!strcmp(argv[i],"--sources")&&i+1<argc){sources(argv[++i]);modes++;}else if(!strcmp(argv[i],"--ape")&&i+1<argc){ape(argv[++i]);modes++;}else if(!strcmp(argv[i],"--slice")&&i+2<argc){const char *t=argv[++i],*p=argv[++i];size_t n;unsigned char *s=(unsigned char *)load(p,&n);image(t,s,n,p);free(s);modes++;}else fail("usage --sources ROOT | --ape FILE | --slice TARGET FILE");}if(!modes)fail("mode required");printf("LOGIC_DISTRIBUTION\tmodes=%d\tsemantic_decision_share=UNKNOWN\tmodule_attribution=UNATTRIBUTED\n",modes);return 0;}
