#pragma unisa use chrome_dom
/* tools/check-uxe-points-proj.cx -- 转调 uxe-points-proj.cx.
 */
int main(void) {
    char *av[5];
    char *out = 0;
    size_t on = 0;
    int rc;
    av[0] = "sh";
    av[1] = "./unisacc.com";
    av[2] = "tools/uxe-points-proj.cx";
    av[3] = "--";
    av[4] = 0;
    rc = cx_runv_timeout(av, 20, &out, &on);
    if (out) {
        fwrite(out, 1, on, stdout);
        free(out);
    }
    printf("CHECK_UXE_POINTS_PROJ\trc=%d\n", rc);
    return rc == 0 ? 0 : 1;
}

