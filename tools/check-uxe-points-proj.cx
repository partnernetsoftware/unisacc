#pragma unisa use cxlib.ckassert
#pragma unisa use chrome_dom
/* tools/check-uxe-points-proj.cx -- 加法黑底 + 直通非黑底像素中心.
 * sh ./unisacc.com tools/check-uxe-points-proj.cx --
 */
static int failed;
static int iabs(int x) { return x < 0 ? -x : x; }
static int clamp255(int x) { if (x < 0) return 0; if (x > 255) return 255; return x; }

static int dump4(char *url, char *tmpdir, int *sx, int *sy, int *r, int *g, int *b) {
    char *av[12];
    char *out = 0;
    size_t on = 0;
    int rc, ns = 0;
    const char *p;
    av[0] = "/usr/bin/google-chrome";
    av[1] = "--headless=new";
    av[2] = "--enable-unsafe-swiftshader";
    av[3] = "--allow-file-access-from-files";
    av[4] = "--disable-web-security";
    av[5] = "--no-first-run";
    av[6] = tmpdir;
    av[7] = "--virtual-time-budget=20000";
    av[8] = "--dump-dom";
    av[9] = url;
    av[10] = 0;
    rc = cx_runv_timeout(av, 25, &out, &on);
    if (rc == 127) { if (out) free(out); return -1; }
    p = out ? strstr(out, "samples") : 0;
    if (!p) p = out;
    if (p) {
        while (*p && ns < 4) {
            if (p[0] == '[' && p[1] >= '0' && p[1] <= '9') {
                int vx = 0, vy = 0, vr = 0, vg = 0, vb = 0, va = 0;
                p++;
                while (*p >= '0' && *p <= '9') { vx = vx * 10 + *p - '0'; p++; }
                if (*p == ',') p++;
                while (*p >= '0' && *p <= '9') { vy = vy * 10 + *p - '0'; p++; }
                if (*p == ',') p++;
                while (*p >= '0' && *p <= '9') { vr = vr * 10 + *p - '0'; p++; }
                if (*p == ',') p++;
                while (*p >= '0' && *p <= '9') { vg = vg * 10 + *p - '0'; p++; }
                if (*p == ',') p++;
                while (*p >= '0' && *p <= '9') { vb = vb * 10 + *p - '0'; p++; }
                if (*p == ',') p++;
                while (*p >= '0' && *p <= '9') { va = va * 10 + *p - '0'; p++; }
                sx[ns] = vx; sy[ns] = vy; r[ns] = vr; g[ns] = vg; b[ns] = vb;
                ns++;
            } else p++;
        }
    }
    if (out) free(out);
    return ns;
}
int main(void) {
    char cwd[512], url[700], url2[700];
    const char *pre = "file://";
    const char *suf = "/ujs/practice/uxe/test/uxe-points-oracle.html";
    const char *suf2 = "/ujs/practice/uxe/test/uxe-points-alpha.html";
    int n, i, ns, okn, ns2, okn2;
    double scale = 1.6, cam_d = 8.0, W = 64.0, H = 64.0;
    double half = 0.5463024898437905;
    double R, cx, cy;
    int sx[4], sy[4], r[4], g[4], b[4];
    int sx2[4], sy2[4], r2[4], g2[4], b2[4];
    double dr = 80.0, dg = 120.0, db = 60.0;
    R = ((scale * 0.5) / cam_d) / half * (W * 0.5);
    cx = W * 0.5;
    cy = H * 0.5;
    if (!getcwd(cwd, sizeof cwd)) return 2;
    n = 0;
    while (pre[n]) { url[n] = pre[n]; n++; }
    for (i = 0; cwd[i] && n < 500; i++) url[n++] = cwd[i];
    for (i = 0; suf[i] && n < 640; i++) url[n++] = suf[i];
    url[n] = 0;
    n = 0;
    while (pre[n]) { url2[n] = pre[n]; n++; }
    for (i = 0; cwd[i] && n < 500; i++) url2[n++] = cwd[i];
    for (i = 0; suf2[i] && n < 640; i++) url2[n++] = suf2[i];
    url2[n] = 0;
    ns = dump4(url, "--user-data-dir=/tmp/uxe-pts-proj", sx, sy, r, g, b);
    if (ns < 0) { printf("POINTS_PROJ_UNMEASURED\n"); return 2; }
    ck_record(&failed, ns >= 4, "add-samples>=4");
    okn = 0;
    for (i = 0; i < ns && i < 4; i++) {
        double dx = ((double)sx[i] + 0.5) - cx;
        double dy = ((double)sy[i] + 0.5) - cy;
        double t2 = (dx * dx + dy * dy) / (R * R);
        double a;
        int er, eg, eb;
        a = 1.0 - t2;
        if (a < 0.0) a = 0.0;
        a = a * a;
        er = clamp255((int)(80.0 + 220.0 * a + 0.5));
        eg = clamp255((int)(120.0 + 10.0 * a + 0.5));
        eb = clamp255((int)(60.0 + 30.0 * a + 0.5));

        printf("ADD\t%d\t%d\tgot=%d,%d,%d\texp=%d,%d,%d\n", sx[i], sy[i], r[i], g[i], b[i], er, eg, eb);
        if (iabs(r[i] - er) <= 1 && iabs(g[i] - eg) <= 1 && iabs(b[i] - eb) <= 1) okn++;
    }
    ck_record(&failed, okn == 4, "add-pixel-match");
    ns2 = dump4(url2, "--user-data-dir=/tmp/uxe-pts-alpha", sx2, sy2, r2, g2, b2);
    if (ns2 < 0) { printf("POINTS_ALPHA_UNMEASURED\n"); return 2; }
    ck_record(&failed, ns2 >= 4, "alpha-samples>=4");
    okn2 = 0;
    for (i = 0; i < ns2 && i < 4; i++) {
        double dx = ((double)sx2[i] + 0.5) - cx;
        double dy = ((double)sy2[i] + 0.5) - cy;
        double t2 = (dx * dx + dy * dy) / (R * R);
        double a;
        int er, eg, eb;
        a = 1.0 - t2;
        if (a < 0.0) a = 0.0;
        a = a * a;
        er = (int)(220.0 * a + dr * (1.0 - a) + 0.5);
        eg = (int)(10.0 * a + dg * (1.0 - a) + 0.5);
        eb = (int)(30.0 * a + db * (1.0 - a) + 0.5);
        printf("ALPHA\t%d\t%d\tgot=%d,%d,%d\texp=%d,%d,%d\n", sx2[i], sy2[i], r2[i], g2[i], b2[i], er, eg, eb);
        if (iabs(r2[i] - er) <= 1 && iabs(g2[i] - eg) <= 1 && iabs(b2[i] - eb) <= 1) okn2++;
    }
    ck_record(&failed, okn2 == 4, "alpha-pixel-match");
    printf("CHECK_UXE_POINTS_PROJ\tadd=%d\talpha=%d\tfailed=%d\n", okn, okn2, failed);
    return failed ? 1 : 0;
}
