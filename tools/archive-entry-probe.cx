#pragma unisa use cxlib.netpack
static char base[4096],bound[4400];
static void put(const char *p,const char *s){FILE *f=fopen(p,"wx");if(!f||fwrite(s,1,strlen(s),f)!=strlen(s)||fclose(f))exit(2);}
static int call(const char *dir,const char *tag,char **argv){np_result r={0};char why[1024];int transport=np_run(argv,dir,0,10,&r,why,sizeof why);printf("OBSERVE\t%s\trc=%d\ttransport=%d\n",tag,r.rc,transport);char p[4400];snprintf(p,sizeof p,"%s/%s.stdout",dir,tag);FILE *f=fopen(p,"wx");if(!f)exit(2);fwrite(r.out,1,r.outn,f);fclose(f);snprintf(p,sizeof p,"%s/%s.stderr",dir,tag);f=fopen(p,"wx");if(!f)exit(2);fwrite(r.err,1,r.errn,f);fclose(f);int rc=transport?255:r.rc;np_free(&r);return rc;}
int main(int argc,char **argv){if(argc!=5||mkdir(argv[4],0700))return 2;snprintf(bound,sizeof bound,"%s/tools/bound",argv[1]);const char *names[]={"m","h","p"};const char *src[]={"int main(void){return 7;}\n","int h(void){return 1;}\n","int main(void);int h(void){return 1;}\n"};for(int driver=2;driver<=3;driver++){char dir[4400],path[4400];snprintf(dir,sizeof dir,"%s/%s",argv[4],driver==2?"old":"new");if(mkdir(dir,0700))return 2;size_t n;char *bytes=cx_read(argv[driver],&n),sha[65];if(!bytes)return 2;cx_sha256_hex(bytes,n,sha);free(bytes);printf("PRODUCT\t%s\t%s\n",driver==2?"old":"new",sha);for(int i=0;i<3;i++){char c[20],o[20],tag[30];snprintf(c,sizeof c,"%s.c",names[i]);snprintf(o,sizeof o,"%s.o",names[i]);snprintf(path,sizeof path,"%s/%s",dir,c);put(path,src[i]);snprintf(tag,sizeof tag,"compile-%s",names[i]);char *v[]={"sh",argv[driver],"-c","-b","lnx/x86_64","-funit","-o",o,c,0};if(call(dir,tag,v))return 3;}char *a[]={"sh",argv[driver],"ar","rcs","libm.a","m.o",0};char *b[]={"sh",argv[driver],"ar","rcs","libh.a","h.o",0};if(call(dir,"archive-main",a)||call(dir,"archive-helper",b))return 3;const char *cases[]={"archive-only","helper-archive","explicit-main","prototype-only"};for(int k=0;k<4;k++){char *v[]={"sh",argv[driver],"-o",(char *)cases[k],k==0?"libm.a":k==1?"h.o":k==2?"m.o":"p.o",k==1?"libm.a":k==2?"libh.a":0,0};int rc=call(dir,cases[k],v);if(!rc){snprintf(path,sizeof path,"%s/%s",dir,cases[k]);char tag[50];snprintf(tag,sizeof tag,"run-%s",cases[k]);char *run[]={bound,"5",path,0};call(dir,tag,run);}}}return 0;}
