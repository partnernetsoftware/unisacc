/* Checks the gid, rdev, mtime_ns, ctime_ns fields and kind 'c'/'b' of sy_stat_t (cx/sys/fs.cx):
     sh ./unisacc.com tools/check-l0-mtime-ns.cx
   Prints PASS/FAIL lines and L0_MTIME_NS<TAB>ok=N<TAB>failed=N; exit 1 on any FAIL. */
#pragma unisa use sys.fs
#pragma unisa use sys.env

static int nok, nfail;
static void ck(int c, const char *name) {
    printf("%s\tstat.%s\n", c ? "PASS" : "FAIL", name);
    if (c) nok++; else nfail++;
}

int main(void) {
    sy_stat_t s, d;
    ck(sy_stat("/dev/null", &s) == 0, "stat_devnull");
    ck(s.kind == 'c', "devnull_is_char");
    ck(s.rdev != 0, "devnull_rdev_nonzero");
    ck(sy_stat("tools/check-l0-mtime-ns.cx", &d) == 0, "stat_self");
    ck(sizeof d.mtime_ns == 8 && sizeof d.ctime_ns == 8, "nanoseconds-width");
    ck(d.mtime_ns / 1000000000LL == d.mtime, "mtime_ns_matches_seconds");
    ck(d.mtime_ns >= 0 && d.ctime_ns / 1000000000LL == d.ctime, "ctime_ns_matches_seconds");
    ck(d.kind == 'f' && d.rdev == 0, "regular_rdev_zero");
    ck(d.gid >= 0, "gid_nonneg");
    printf("L0_MTIME_NS\tok=%d\tfailed=%d\n", nok, nfail);
    return nfail ? 1 : 0;
}
