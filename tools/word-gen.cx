#pragma unisa use sys.io
#pragma unisa use text.text
/* Project exec/facts/pp-init.tsv onto the compiler and runtime word tables.
   sh ./unisacc.com tools/word-gen.cx -- --check
   sh ./unisacc.com tools/word-gen.cx -- --write
   Thirteen rows, file order. A row is word, kind, and arg.
   A null out-pointer returns 4. An index outside 0..count-1 returns 2.
   These words are not the standard macros.
   No libc and no include. */
#define TSV "exec/facts/pp-init.tsv"
#define NROW 13
#define NAMEMAX 32
#define FILECAP 8192
#define CHECKCAP 16384
#define HEAD1 "# word\tkind\targ"
#define HEAD2 "# source: src/front_pp.c reserved spellings; kind dir = W[DIRB+id] gets arg, intern = id register arg"

typedef struct {
    char word[NAMEMAX];
    char kind[NAMEMAX];
    char arg[NAMEMAX];
} Row;

static Row rows[NROW];
static int nrows;

static int fail(const char *why) {
    sy_eprintf("word-gen\tFAIL\t%s\n", why);
    return 1;
}

static int ident_ok(const char *s, int n) {
    int i;
    char c;
    if (n < 1 || n >= NAMEMAX) return 0;
    c = s[0];
    if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '_')) return 0;
    for (i = 1; i < n; i++) {
        c = s[i];
        if (c >= 'A' && c <= 'Z') continue;
        if (c >= 'a' && c <= 'z') continue;
        if (c >= '0' && c <= '9') continue;
        if (c == '_') continue;
        return 0;
    }
    return 1;
}

static int word_ok(const char *s, int n) {
    int i;
    if (n < 1 || n >= NAMEMAX) return 0;
    if (s[0] != '"') return ident_ok(s, n);
    if (n < 3 || s[n - 1] != '"') return 0;
    for (i = 1; i < n - 1; i++) {
        char c = s[i];
        if (c >= '0' && c <= '9') continue;
        if (c >= 'A' && c <= 'Z') continue;
        if (c >= 'a' && c <= 'z') continue;
        if (c == '_') continue;
        return 0;
    }
    return 1;
}

static int kind_ok(const char *s, int n) {
    int i;
    if (n < 1 || n >= NAMEMAX) return 0;
    for (i = 0; i < n; i++) if (s[i] < 'a' || s[i] > 'z') return 0;
    return 1;
}

static int arg_ok(const char *s, int n) {
    int i;
    if (n < 1 || n >= NAMEMAX) return 0;
    if (s[0] >= '0' && s[0] <= '9') {
        for (i = 0; i < n; i++) if (s[i] < '0' || s[i] > '9') return 0;
        return 1;
    }
    if (n < 4 || s[0] != 'I' || s[1] != 'D' || s[2] != '_') return 0;
    for (i = 3; i < n; i++) {
        char c = s[i];
        if (c >= 'A' && c <= 'Z') continue;
        if (c >= '0' && c <= '9') continue;
        if (c == '_') continue;
        return 0;
    }
    return 1;
}

static void copy_field(char *dst, const char *s, int n) {
    int i;
    for (i = 0; i < n; i++) dst[i] = s[i];
    dst[n] = 0;
}

static int take_row(const char *line, int n) {
    const char *f[3];
    int len[3];
    int i, k, start;
    if (nrows >= NROW) return fail("word-count");
    k = 0;
    start = 0;
    for (i = 0; i <= n; i++) {
        if (i == n || line[i] == '\t') {
            if (k >= 3) return fail("row-fields");
            f[k] = line + start;
            len[k] = i - start;
            k++;
            start = i + 1;
        }
    }
    if (k != 3) return fail("row-fields");
    if (!word_ok(f[0], len[0])) return fail("word-charset");
    if (!kind_ok(f[1], len[1])) return fail("kind-charset");
    if (!arg_ok(f[2], len[2])) return fail("arg-charset");
    copy_field(rows[nrows].word, f[0], len[0]);
    copy_field(rows[nrows].kind, f[1], len[1]);
    copy_field(rows[nrows].arg, f[2], len[2]);
    if (!tx_eqz(rows[nrows].kind, "dir") && !tx_eqz(rows[nrows].kind, "intern"))
        return fail("kind-value");
    nrows++;
    return 0;
}

static int parse_tsv(char *b, size_t n) {
    size_t i = 0;
    int saw = 0;
    if (n == 0 || b[n - 1] != '\n') return fail("tsv-newline");
    while (i < n) {
        size_t e = i;
        while (e < n && b[e] != '\n') e++;
        b[e] = 0;
        if (e == i) return fail("tsv-blank");
        if (saw == 0) {
            if (!tx_eqz(b + i, HEAD1)) return fail("tsv-header");
            saw = 1;
        } else if (saw == 1) {
            if (!tx_eqz(b + i, HEAD2)) return fail("tsv-header");
            saw = 2;
        } else if (b[i] == '#') {
            return fail("tsv-comment");
        } else if (take_row(b + i, (int)(e - i))) {
            return 1;
        }
        i = e + 1;
    }
    if (nrows != NROW) return fail("word-count");
    return 0;
}

static int unique_rows(void) {
    int i, j, nd, ni;
    nd = 0;
    ni = 0;
    for (i = 0; i < nrows; i++) {
        for (j = i + 1; j < nrows; j++) {
            if (tx_eqz(rows[i].word, rows[j].word)) return fail("word-dup");
        }
        if (tx_eqz(rows[i].kind, "dir")) nd++;
        else ni++;
    }
    if (nd != 3 || ni != 10) return fail("kind-count");
    return 0;
}

static int app(char *dst, int cap, int *n, const char *s) {
    int i = 0;
    while (s[i]) {
        if (*n + 1 >= cap) return -1;
        dst[*n] = s[i];
        *n += 1;
        i++;
    }
    dst[*n] = 0;
    return 0;
}

static int app_int(char *dst, int cap, int *n, int d) {
    char s[16];
    char one[2];
    int i = 0;
    if (d < 0) return -1;
    if (d == 0) return app(dst, cap, n, "0");
    while (d) {
        if (i >= 16) return -1;
        s[i] = (char)('0' + (d % 10));
        i++;
        d = d / 10;
    }
    one[1] = 0;
    while (i > 0) {
        i--;
        one[0] = s[i];
        if (app(dst, cap, n, one)) return -1;
    }
    return 0;
}

static int app_cstr(char *dst, int cap, int *n, const char *s) {
    int i;
    char one[2];
    if (app(dst, cap, n, "\"")) return -1;
    one[1] = 0;
    for (i = 0; s[i]; i++) {
        if (s[i] == '\\' || s[i] == '"') {
            if (app(dst, cap, n, "\\")) return -1;
        }
        one[0] = s[i];
        if (app(dst, cap, n, one)) return -1;
    }
    return app(dst, cap, n, "\"");
}

static int emit_mod(char *dst, int cap, const char *prefix) {
    int n = 0, i;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa module wordname\n")) return -1;
    if (app(dst, cap, &n, "/* Generated by tools/word-gen.cx from exec/facts/pp-init.tsv.\n")) return -1;
    if (app(dst, cap, &n, "   Do not edit by hand. A row is word, kind, and arg.\n")) return -1;
    if (app(dst, cap, &n, "   A null out-pointer returns 4. An index outside 0..count-1 returns 2.\n")) return -1;
    if (app(dst, cap, &n, "   No libc and no include. */\n")) return -1;
    if (app(dst, cap, &n, "int ")) return -1;
    if (app(dst, cap, &n, prefix)) return -1;
    if (app(dst, cap, &n, "_count(void) {\n    return ")) return -1;
    if (app_int(dst, cap, &n, nrows)) return -1;
    if (app(dst, cap, &n, ";\n}\n")) return -1;
    if (app(dst, cap, &n, "int ")) return -1;
    if (app(dst, cap, &n, prefix)) return -1;
    if (app(dst, cap, &n, "_at(int index, const char **word, const char **kind, const char **arg) {\n")) return -1;
    if (app(dst, cap, &n, "    if (!word || !kind || !arg) return 4;\n")) return -1;
    for (i = 0; i < nrows; i++) {
        if (app(dst, cap, &n, "    if (index == ")) return -1;
        if (app_int(dst, cap, &n, i)) return -1;
        if (app(dst, cap, &n, ") { *word = ")) return -1;
        if (app_cstr(dst, cap, &n, rows[i].word)) return -1;
        if (app(dst, cap, &n, "; *kind = ")) return -1;
        if (app_cstr(dst, cap, &n, rows[i].kind)) return -1;
        if (app(dst, cap, &n, "; *arg = ")) return -1;
        if (app_cstr(dst, cap, &n, rows[i].arg)) return -1;
        if (app(dst, cap, &n, "; return 0; }\n")) return -1;
    }
    if (app(dst, cap, &n, "    return 2;\n}\n")) return -1;
    return n;
}

static int emit_check(char *dst, int cap) {
    int n = 0, i;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa use compiler.wordname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use runtime.wordname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use compiler.stdname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use runtime.stdname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use sys.io\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use text.text\n")) return -1;
    if (app(dst, cap, &n, "/* Generated by tools/word-gen.cx. Narrow check of the thirteen reserved words. */\n")) return -1;
    if (app(dst, cap, &n, "int main(void) {\n")) return -1;
    if (app(dst, cap, &n, "    const char *w; const char *k; const char *a; const char *ow; const char *ok; const char *oa;\n")) return -1;
    if (app(dst, cap, &n, "    const char *name; const char *value; const char **missing;\n")) return -1;
    if (app(dst, cap, &n, "    int i; int j; int nd; int ni;\n")) return -1;
    if (app(dst, cap, &n, "    missing = 0;\n")) return -1;
    if (app(dst, cap, &n, "    if (wrd_count() != 13 || rwd_count() != 13) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (sdn_count() != 3 || rsd_count() != 3) return 1;\n")) return -1;
    for (i = 0; i < nrows; i++) {
        if (app(dst, cap, &n, "    if (wrd_at(")) return -1;
        if (app_int(dst, cap, &n, i)) return -1;
        if (app(dst, cap, &n, ", &w, &k, &a) || !tx_eqz(w, ")) return -1;
        if (app_cstr(dst, cap, &n, rows[i].word)) return -1;
        if (app(dst, cap, &n, ") || !tx_eqz(k, ")) return -1;
        if (app_cstr(dst, cap, &n, rows[i].kind)) return -1;
        if (app(dst, cap, &n, ") || !tx_eqz(a, ")) return -1;
        if (app_cstr(dst, cap, &n, rows[i].arg)) return -1;
        if (app(dst, cap, &n, ")) return 1;\n")) return -1;
        if (app(dst, cap, &n, "    if (rwd_at(")) return -1;
        if (app_int(dst, cap, &n, i)) return -1;
        if (app(dst, cap, &n, ", &ow, &ok, &oa) || !tx_eqz(ow, w) || !tx_eqz(ok, k) || !tx_eqz(oa, a)) return 1;\n")) return -1;
    }
    if (app(dst, cap, &n, "    nd = 0; ni = 0;\n")) return -1;
    if (app(dst, cap, &n, "    for (i = 0; i < wrd_count(); i++) {\n")) return -1;
    if (app(dst, cap, &n, "        if (wrd_at(i, &w, &k, &a)) return 1;\n")) return -1;
    if (app(dst, cap, &n, "        if (tx_eqz(k, \"dir\")) nd++;\n")) return -1;
    if (app(dst, cap, &n, "        else if (tx_eqz(k, \"intern\")) ni++;\n")) return -1;
    if (app(dst, cap, &n, "        else return 1;\n")) return -1;
    if (app(dst, cap, &n, "        for (j = 0; j < sdn_count(); j++) {\n")) return -1;
    if (app(dst, cap, &n, "            if (sdn_at(j, &name, &value) || tx_eqz(w, name)) return 1;\n")) return -1;
    if (app(dst, cap, &n, "            if (rsd_at(j, &name, &value) || tx_eqz(w, name)) return 1;\n")) return -1;
    if (app(dst, cap, &n, "        }\n")) return -1;
    if (app(dst, cap, &n, "    }\n")) return -1;
    if (app(dst, cap, &n, "    if (nd != 3 || ni != 10) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (wrd_at(0, missing, &k, &a) != 4) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (wrd_at(0, &w, missing, &a) != 4) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (wrd_at(0, &w, &k, missing) != 4) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rwd_at(0, missing, &k, &a) != 4) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (wrd_at(-1, &w, &k, &a) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (wrd_at(13, &w, &k, &a) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rwd_at(-1, &w, &k, &a) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rwd_at(13, &w, &k, &a) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    sy_printf(\"CX_WORD\\tok=13\\tdir=3\\tintern=10\\tstd=3\\tfailed=0\\n\");\n")) return -1;
    if (app(dst, cap, &n, "    return 0;\n}\n")) return -1;
    return n;
}

static int same_bytes(const char *a, size_t an, const char *b, int bn) {
    int i;
    if (an != (size_t)bn) return 0;
    for (i = 0; i < bn; i++) if (a[i] != b[i]) return 0;
    return 1;
}

static int one_file(int dowrite, const char *path, const char *body, int n) {
    size_t on = 0;
    char *cur;
    if (dowrite) {
        if (cx_write(path, body, (size_t)n)) return fail("write");
        return 0;
    }
    cur = cx_read(path, &on);
    if (!cur) return fail(path);
    if (!same_bytes(cur, on, body, n)) return fail(path);
    return 0;
}

int main(int argc, char **argv) {
    size_t nb = 0;
    char *b;
    char file[FILECAP], check[CHECKCAP];
    int dowrite, fn, cn;
    if (argc != 2 || (!tx_eqz(argv[1], "--check") && !tx_eqz(argv[1], "--write"))) {
        sy_eprintf("word-gen\tusage\t--check|--write\n");
        return 2;
    }
    dowrite = tx_eqz(argv[1], "--write");
    b = cx_read(TSV, &nb);
    if (!b) return fail("tsv-read");
    if (parse_tsv(b, nb)) return 1;
    if (unique_rows()) return 1;
    cn = emit_check(check, CHECKCAP);
    if (cn < 0) return fail("emit-check");
    fn = emit_mod(file, FILECAP, "wrd");
    if (fn < 0) return fail("emit-compiler");
    if (one_file(dowrite, "cx/compiler/wordname.cx", file, fn)) return 1;
    fn = emit_mod(file, FILECAP, "rwd");
    if (fn < 0) return fail("emit-runtime");
    if (one_file(dowrite, "cx/runtime/wordname.cx", file, fn)) return 1;
    if (one_file(dowrite, "tools/check-cx-word.cx", check, cn)) return 1;
    if (dowrite) sy_printf("WORD_GEN\tWROTE\trows=%d\n", nrows);
    else sy_printf("WORD_GEN\tCHECK\trows=%d\n", nrows);
    return 0;
}
