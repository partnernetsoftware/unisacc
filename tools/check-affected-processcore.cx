/* Checks tools/affected.cx selection of transitive process-module runtime consumers. */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.env
static int has(const char*s,const char*id){char line[250];int n=snprintf(line,sizeof line,"AFFECTED\t%s\t",id);if(n<0||(size_t)n>=sizeof line)return 0;for(const char*p=s;*p;){if(!strncmp(p,line,(size_t)n))return 1;const char*e=strchr(p,'\n');if(!e)break;p=e+1;}return 0;}
int main(void){
 const char*product=sy_env_or("UNISACC","./unisacc.com"); /* lint:allow R1-product Same-candidate tool launcher, overridden by the harness through UNISACC. */
 const char*ids[]={"lower-prefix-base3","lower-prefix-base4","cx-reaper","cx-netpack","cx-npfault","procrun-tool","process-deadline","bound-rc142"};int failed=0;np_result r={0};char why[400];
 char*v[]={"sh",(char*)product,"tools/affected.cx","--","--files","ext/sysx/processcore.cx",0};int tr=np_run(v,0,0,25,&r,why,sizeof why);if(tr||r.rc){fprintf(stderr,"selection failed %s %s\n",tr?why:"",r.err?r.err:"");np_free(&r);return 1;}
 for(int i=0;i<8;i++){int ok=has(r.out,ids[i]);printf("CHECK\tprocesscore-selection\tid=%s\tstatus=%s\n",ids[i],ok?"PASS":"FAIL");if(!ok)failed++;}np_free(&r);
 char*negative[]={"sh",(char*)product,"tools/affected.cx","--","--files","__processcore_unrelated_missing_source__.cx",0};tr=np_run(negative,0,0,25,&r,why,sizeof why);int ok=!tr&&!r.rc&&strstr(r.out,"\tbatches=0\t");printf("CHECK\tprocesscore-unrelated\tstatus=%s\n",ok?"PASS":"FAIL");if(!ok)failed++;np_free(&r);
 printf("CHECK_AFFECTED_PROCESSCORE\tfailed=%d\n",failed);return failed?1:0;
}
