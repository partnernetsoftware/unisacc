/* tools/check-freeze-day.cx -- contract check for tools/freeze-day.cx (batch freeze-day).
 * Synthetic git repo verifies live values (candidate.tsv, branch SHA, merge_tree, templates),
 * READY vs BLOCKED gating, read-only guarantee, and check subcommand pass/fail/refuse paths.
 * Final line: CHECK_FREEZE_DAY\tpass=N\tfail=0
 */
#pragma unisa use fsx.fs
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.proc
#pragma unisa use sys.posix
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use cxlib.netpack

static int g_pass, g_fail;
static char g_root[4096];

static void ck(int ok, const char *name) {
    if (ok) { g_pass++; printf("PASS\t%s\n", name); }
    else { g_fail++; printf("FAIL\t%s\n", name); }
}

static int run_sh(const char *cwd, const char *cmd, int timeout_s, np_result *r) {
    char *av[4];
    char why[256];
    av[0] = "sh"; av[1] = "-c"; av[2] = (char *)cmd; av[3] = 0;
    mm_fill(r, sizeof *r, 0, sizeof *r);
    if (np_run(av, cwd, 0, timeout_s, r, why, sizeof why) != 0) return -1;
    return r->rc;
}

static int has(const np_result *r, const char *lit) {
    long ll = tx_len(lit, 512);
    if (r->out && r->outn > 0 && tx_find(r->out, (long)r->outn, lit, ll) >= 0) return 1;
    if (r->err && r->errn > 0 && tx_find(r->err, (long)r->errn, lit, ll) >= 0) return 1;
    return 0;
}

static int run_fd(const char *args, np_result *r) {
    char cmd[4096];
    if (cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/freeze-day.cx' -- %s", g_root, g_root, args)) return -1;
    return run_sh(g_root, cmd, 30, r);
}

int main(void) {
    if (sy_realpath(".", g_root, sizeof g_root) < 0) return 2;
    int sc = 0;
    if (fsx_scratch(&sc, "check-fday-") != 0) return 2;
    const char *dir = fsx_scratch_dir(sc);
    if (!dir) return 2;

    char repo[1024], rdp[1024], rdf[1024], shcmd[4096];
    cx_fmt(repo, sizeof repo, "%s/synrepo", dir);
    cx_fmt(rdp, sizeof rdp, "%s/rd-pass.sh", dir);
    cx_fmt(rdf, sizeof rdf, "%s/rd-fail.sh", dir);

    cx_fmt(shcmd, sizeof shcmd,
        "set -e; mkdir -p '%s/release/evidence/9.9.9'; cd '%s'; "
        "git init -q; git config user.name test; git config user.email t@local; "
        "printf 'repo\\ttag\\tcommit\\tversion\\tworkflow\\tworkflow_ref\\tci_run_id\\tape\\n"
        "org/repo\\tv9.9.8\\t11223344556677889900aabbccddeeff00112233\\t9.9.8\\tcandidate-native.yml\\tv9.9.8\\t1\\tunisacc.com\\n' > release/candidate.tsv; "
        "printf '# Notes 9.9.9\\n' > release/notes-9.9.9.md; "
        "printf 'rollback 9.9.9\\n' > release/rollback.txt; "
        "printf 'decision 9.9.9\\n' > release/decision.txt; "
        "git add -A; git commit -qm init; git branch -M main; "
        "git checkout -qb v9.9.9; printf 'br\\n' > br.txt; git add br.txt; git commit -qm br; "
        "git checkout -q main; git rev-parse --short v9.9.9",
        repo, repo);
    np_result r;
    int rc = run_sh(g_root, shcmd, 20, &r);
    char br_sha[64];
    br_sha[0] = 0;
    if (rc == 0 && r.out && r.outn > 0) {
        long ln = (long)r.outn;
        while (ln > 0 && (r.out[ln - 1] == '\n' || r.out[ln - 1] == '\r')) ln--;
        if (ln >= (long)sizeof br_sha) ln = (long)sizeof br_sha - 1;
        mm_copy(br_sha, sizeof br_sha, r.out, ln); br_sha[ln] = 0;
    }
    np_free(&r);
    if (rc != 0 || !br_sha[0]) { fsx_scratch_drop(sc); return 2; }

    const char *rd_pass_body =
        "#!/bin/sh\n"
        "printf 'FR_ITEM\\tdevsvc-freeze\\tpass\\tok\\tdone\\tcc\\t-\\t-\\tPASS\\n'\n"
        "printf 'FR_ITEM\\thardlink-trees\\tpass\\tok\\tdone\\tcc\\t-\\t-\\tPASS\\n'\n"
        "printf 'FR_ITEM\\tdirty-freeze-domain\\tpass\\tok\\tdone\\tcc\\t-\\t-\\tPASS\\n'\n"
        "printf 'FR_ITEM\\tcx-mode-drift\\tpass\\tok\\tdone\\tcc\\t-\\t-\\tPASS\\n'\n"
        "printf 'FR_ITEM\\tmerge-s0-tree\\tpass\\ttree=deadbeef1234\\tdone\\tcc\\t-\\t-\\tPASS\\n'\n"
        "printf 'FR_ITEM\\tahead-origin\\tpass\\tok\\tdone\\tcc\\t-\\t-\\tPASS\\n'\n"
        "printf 'FR_ITEM\\tchain-1rev\\tpass\\tok\\tdone\\tcc\\t-\\t-\\tPASS\\n'\n"
        "printf 'FR_ITEM\\tverseq\\tpass\\tok\\tdone\\tcc\\t-\\t-\\tPASS\\n'\n"
        "printf 'FR_ITEM\\tplan-freeze-at\\tpass\\tok\\tdone\\tcc\\t-\\t-\\tPASS\\n'\n"
        "printf 'FR_ITEM\\trelease-prep-notes\\tpass\\tok\\tdone\\tcc\\t-\\t-\\tPASS\\n'\n"
        "printf 'FR_ITEM\\trelease-prep-rollback\\tpass\\tok\\tdone\\tcc\\t-\\t-\\tPASS\\n'\n"
        "printf 'FREEZE_READINESS\\tready=yes\\tblockers=0\\n'\n";
    const char *rd_fail_body =
        "#!/bin/sh\n"
        "printf 'FR_ITEM\\tdevsvc-freeze\\tfail\\tno-lock\\topen\\tcc\\t-\\t-\\tFAIL\\n'\n"
        "printf 'FR_ITEM\\tdirty-freeze-domain\\tfail\\tdirty\\topen\\tcc\\t-\\t-\\tFAIL\\n'\n"
        "printf 'FR_ITEM\\tverseq\\tfail\\tdrift\\topen\\tcc\\t-\\t-\\tFAIL\\n'\n"
        "printf 'FR_ITEM\\trelease-prep-notes\\tfail\\ttbd\\topen\\tcc\\t-\\t-\\tFAIL\\n'\n"
        "printf 'FREEZE_READINESS\\tready=no\\tblockers=4\\n'\n"
        "exit 1\n";
    sy_write_file(rdp, rd_pass_body, tx_len(rd_pass_body, 8192), 0700);
    sy_write_file(rdf, rd_fail_body, tx_len(rd_fail_body, 8192), 0700);

    /* (1) All-green plan on synthetic repo */
    char args[2048];
    cx_fmt(args, sizeof args, "plan --version 9.9.9 --branch v9.9.9 --repo '%s' --owner integ --readiness-bin '%s'", repo, rdp);
    rc = run_fd(args, &r);
    ck(rc == 0 && has(&r, "FREEZE_DAY\tplan\tsteps=15\tblocked=0"), "plan-all-green-steps15-blocked0");
    char want_sha[96];
    cx_fmt(want_sha, sizeof want_sha, "branch_sha=%s", br_sha);
    ck(has(&r, "prev_version=9.9.8") && has(&r, "prev_commit=11223344556677889900aabbccddeeff00112233") &&
       has(&r, want_sha) && has(&r, "merge_tree=deadbeef1234") && has(&r, "owner=integ") &&
       has(&r, "notes-9.9.9.md") && has(&r, "tools/prerun-inputs.cx") &&
       has(&r, "tools/freeze-broadcast.cx") && has(&r, "tools/release-post.cx"),
       "plan-values-from-synthetic-repo");
    np_free(&r);

    /* (2) Blocked plan via readiness failures */
    cx_fmt(args, sizeof args, "plan --version 9.9.9 --branch v9.9.9 --repo '%s' --owner integ --readiness-bin '%s'", repo, rdf);
    rc = run_fd(args, &r);
    ck(rc == 0 && has(&r, "FREEZE_DAY\tplan\tsteps=15\tblocked=4") &&
       has(&r, "id=S0-lock\twho=integrator\tbudget_s=60\tgate=BLOCKED\treason=devsvc-freeze") &&
       has(&r, "id=S0-merge\twho=integrator\tbudget_s=300\tgate=BLOCKED\treason=dirty-freeze-domain") &&
       has(&r, "id=S1\twho=integrator\tbudget_s=180\tgate=BLOCKED\treason=verseq") &&
       has(&r, "id=S3c\twho=docs\tbudget_s=600\tgate=BLOCKED\treason=release-prep-notes"),
       "plan-readiness-blocks-exact-steps");
    np_free(&r);

    /* (3) Missing branch and missing notes template */
    char notesp[1024];
    cx_fmt(notesp, sizeof notesp, "%s/release/notes-9.9.9.md", repo);
    sy_unlink(notesp);
    cx_fmt(args, sizeof args, "plan --version 9.9.9 --branch v-no-such --repo '%s' --no-readiness", repo);
    rc = run_fd(args, &r);
    ck(rc == 0 && has(&r, "FREEZE_DAY\tplan\tsteps=15\tblocked=6") &&
       has(&r, "reason=branch-missing") && has(&r, "reason=missing-notes-template"),
       "plan-missing-branch-and-template-blocked");
    np_free(&r);

    /* (4) Read-only guarantee: repo HEAD and branch unchanged */
    cx_fmt(shcmd, sizeof shcmd, "git -C '%s' rev-parse --short v9.9.9", repo);
    rc = run_sh(g_root, shcmd, 10, &r);
    ck(rc == 0 && has(&r, br_sha), "plan-readonly-branch-unchanged");
    np_free(&r);

    /* (5) check subcommand: PASS / FAIL / S10 PASS / unknown step / missing log */
    char log_ok[1024], log_bad[1024], log_s10[1024], log_abs[1024];
    cx_fmt(log_ok, sizeof log_ok, "%s/s0.ok.log", dir);
    cx_fmt(log_bad, sizeof log_bad, "%s/s0.bad.log", dir);
    cx_fmt(log_s10, sizeof log_s10, "%s/s10.ok.log", dir);
    cx_fmt(log_abs, sizeof log_abs, "%s/no-such.log", dir);
    sy_write_file(log_ok, "step output\nGIT_COMMIT\trc=0\tcommit=abc\n", 38, 0600);
    sy_write_file(log_bad, "step output\nGIT_COMMIT\trc=1\treason=blocked\n", 43, 0600);
    sy_write_file(log_s10, "POST_STEP\t1\tmark\tOK\nRELEASE_POST\tstatus=DONE\n", 45, 0600);

    cx_fmt(args, sizeof args, "check --step S0-merge --log '%s'", log_ok);
    rc = run_fd(args, &r);
    ck(rc == 0 && has(&r, "FREEZE_DAY\tcheck\tstep=S0-merge\tstatus=PASS"), "check-s0-merge-pass");
    np_free(&r);

    cx_fmt(args, sizeof args, "check --step S0-merge --log '%s'", log_bad);
    rc = run_fd(args, &r);
    ck(rc == 1 && has(&r, "FREEZE_DAY\tcheck\tstep=S0-merge\tstatus=FAIL"), "check-s0-merge-fail");
    np_free(&r);

    cx_fmt(args, sizeof args, "check --step S10 --log '%s'", log_s10);
    rc = run_fd(args, &r);
    ck(rc == 0 && has(&r, "FREEZE_DAY\tcheck\tstep=S10\tstatus=PASS"), "check-s10-pass");
    np_free(&r);

    cx_fmt(args, sizeof args, "check --step NO-STEP --log '%s'", log_ok);
    rc = run_fd(args, &r);
    ck(rc == 2 && has(&r, "REFUSE"), "check-unknown-step-refused");
    np_free(&r);

    cx_fmt(args, sizeof args, "check --step S1 --log '%s'", log_abs);
    rc = run_fd(args, &r);
    ck(rc == 2 && has(&r, "REFUSE"), "check-missing-log-refused");
    np_free(&r);

    rc = run_fd("plan", &r);
    ck(rc == 2 && has(&r, "REFUSE"), "plan-missing-version-refused");
    np_free(&r);

    rc = run_fd("bogus", &r);
    ck(rc == 2 && has(&r, "REFUSE"), "unknown-subcommand-refused");
    np_free(&r);

    fsx_scratch_drop(sc);
    printf("CHECK_FREEZE_DAY\tpass=%d\tfail=%d\n", g_pass, g_fail);
    return g_fail ? 1 : 0;
}
