/* Derive a conservative pending-key bound from measured cold/warm calls.
 * Keep the measured cold key in every batch: cold preparation may recur. */
#pragma unisa use sys.fs
#pragma unisa use mem.bytes
int main(int argc,char **argv){
    const char *facts="build/g2-budget-facts.tsv",*dst="build/g2-budget.tsv";
    if(argc<2||argc>4||(strcmp(argv[1],"--check")&&strcmp(argv[1],"--write")))return 2;
    if(argc>2)facts=argv[2];if(argc>3)dst=argv[3];
    FILE *f=fopen(facts,"rb");char line[1024];long v[3];int row=0;
    const char *names[]={"budget_ms","cold_key_ms","warm_key_ms"};
    if(!f)return 2;
    while(fgets(line,sizeof line,f)){
        if(line[0]=='#')continue;
        if(row>=3)return 2;char *p=strchr(line,'\t');if(!p)return 2;*p++=0;
        if(strcmp(line,names[row]))return 2;
        long n=0;if(*p<'0'||*p>'9'){fprintf(stderr,"g2-budget-gen: REFUSE nonpositive or malformed measurement %s\n",names[row]);return 2;}
        while(*p>='0'&&*p<='9'){if(n>1000000)return 2;n=n*10+*p++-'0';}
        if(*p!='\t'||!strchr(p,'\n')||n<1){fprintf(stderr,"g2-budget-gen: REFUSE nonpositive or malformed measurement %s\n",names[row]);return 2;}v[row++]=n;
    }
    if(ferror(f)||fclose(f)||row!=3||v[0]!=55000){fprintf(stderr,"g2-budget-gen: REFUSE malformed or non-55s budget\n");return 2;}
    if(v[1]>=v[0]){fprintf(stderr,"g2-budget-gen: REFUSE cold key reaches deadline; split preparation before batching\n");return 2;}
    /* Strictly below the deadline; no hidden batch-count constant. */
    long count=1+(v[0]-v[1]-1)/v[2];
    char out[512];int n=snprintf(out,sizeof out,"# generated by tools/g2-budget-gen.cx --write\nbudget_ms\t%ld\ncold_key_ms\t%ld\nwarm_key_ms\t%ld\npending_keys\t%ld\n",v[0],v[1],v[2],count);
    if(n<0||n>=sizeof out)return 2;
    if(!strcmp(argv[1],"--write")){if(cx_write(dst,out,n))return 2;}
    else{size_t z=0;char *b=cx_read(dst,&z);int same=b&&z==n&&!memcmp(b,out,n);free(b);if(!same){fprintf(stderr,"g2-budget-gen: DIFF measured budget\n");return 1;}}
    printf("G2_BUDGET\t%s\tpending_keys=%ld\tcold_ms=%ld\twarm_ms=%ld\n",argv[1],count,v[1],v[2]);return 0;
}
