/* Derive a conservative pending-key bound from measured calls.
 * One batch is one chain-step call: a per-call fixed cost plus a per-key
 * marginal cost. Keep the measured cold key in every batch: cold preparation
 * may recur. The bound is clamped to stage_max_keys, the number of keys one
 * shared entry-build call stages (CS_FP_STAGE_MAX in tools/chain-step.cx;
 * check-g2-budget-gen compares the two). */
#pragma unisa use sys.fs
#pragma unisa use mem.bytes
int main(int argc,char **argv){
    const char *facts="build/g2-budget-facts.tsv",*dst="build/g2-budget.tsv";
    if(argc<2||argc>4||(strcmp(argv[1],"--check")&&strcmp(argv[1],"--write")))return 2;
    if(argc>2)facts=argv[2];if(argc>3)dst=argv[3];
    FILE *f=fopen(facts,"rb");char line[1024];long v[5];int row=0;
    const char *names[]={"budget_ms","cold_key_ms","fixed_call_ms","marginal_key_ms","stage_max_keys"};
    if(!f)return 2;
    while(fgets(line,sizeof line,f)){
        if(line[0]=='#')continue;
        if(row>=5)return 2;char *p=strchr(line,'\t');if(!p)return 2;*p++=0;
        if(strcmp(line,names[row]))return 2;
        long n=0;if(*p<'0'||*p>'9'){fprintf(stderr,"g2-budget-gen: REFUSE nonpositive or malformed measurement %s\n",names[row]);return 2;}
        while(*p>='0'&&*p<='9'){if(n>1000000)return 2;n=n*10+*p++-'0';}
        if(*p!='\t'||!strchr(p,'\n')||n<1){fprintf(stderr,"g2-budget-gen: REFUSE nonpositive or malformed measurement %s\n",names[row]);return 2;}v[row++]=n;
    }
    if(ferror(f)||fclose(f)||row!=5||v[0]!=55000){fprintf(stderr,"g2-budget-gen: REFUSE malformed or non-55s budget\n");return 2;}
    if(v[1]>=v[0]){fprintf(stderr,"g2-budget-gen: REFUSE cold key reaches deadline; split preparation before batching\n");return 2;}
    if(v[4]>256){fprintf(stderr,"g2-budget-gen: REFUSE stage_max_keys over the 256-key call bound\n");return 2;}
    /* Strictly below the deadline; a cold key plus one call's fixed cost that
       already reaches it leaves one key per call. */
    long room=v[0]-v[1]-v[2]-1,count=room<0?1:1+room/v[3];
    if(count>v[4])count=v[4];
    char out[512];int n=snprintf(out,sizeof out,"# generated by tools/g2-budget-gen.cx --write\nbudget_ms\t%ld\ncold_key_ms\t%ld\nfixed_call_ms\t%ld\nmarginal_key_ms\t%ld\nstage_max_keys\t%ld\npending_keys\t%ld\n",v[0],v[1],v[2],v[3],v[4],count);
    if(n<0||n>=sizeof out)return 2;
    if(!strcmp(argv[1],"--write")){if(cx_write(dst,out,n))return 2;}
    else{size_t z=0;char *b=cx_read(dst,&z);int same=b&&z==n&&!memcmp(b,out,n);free(b);if(!same){fprintf(stderr,"g2-budget-gen: DIFF measured budget\n");return 1;}}
    printf("G2_BUDGET\t%s\tpending_keys=%ld\tcold_ms=%ld\tfixed_ms=%ld\tmarginal_ms=%ld\tstage_max=%ld\n",argv[1],count,v[1],v[2],v[3],v[4]);return 0;
}
