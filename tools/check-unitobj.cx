/* Check for cx/driver/unitobj.cx (v0.0.75 R2 W1, USE35 unit object key and store).
   Run: sh ./unisacc.com tools/check-unitobj.cx
   Writes an embedded probe unit to a /tmp session dir and runs it together with
   cx/driver/unitobj.cx as one multi-source -run (cold caches: UNISACC_RUN_CACHE=0,
   UNISACC_UNIT_CACHE=0). The probe asserts:
   key stable on identical input; each key field changed alone changes the key
   (candidate, target, level, mode, preprocessed bytes, header set); header set is
   order independent; moving a field boundary changes the key; store then load
   returns identical bytes; missing object is a miss; one flipped byte in the body
   or the magic, or a truncated object, is refused (rc 2), dropped, and does not
   crash; store leaves no temp file. Expected PASS count is fixed below. */
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use mem.heap
#pragma unisa use text.text
#pragma unisa use cxlib.netpack

#define UO_EXPECT 21

static const char *probe_src =
"/* probe lives outside the tree, so it declares the few runtime entries it uses */\n"
"int printf(const char *, ...);\n"
"void *cx_read(const char *, unsigned long *);\n"
"int cx_write(const char *, const void *, unsigned long);\n"
"int uo_key(char key[65], const char *cand, const char *target, int level, int mode,\n"
"           const unsigned char *pp, long ppn, const char *const *hdr, int nh);\n"
"int uo_path(char *dst, int cap, const char *dir, const char key[65]);\n"
"int uo_store(const char *dir, const char key[65], const unsigned char *obj, long n);\n"
"int uo_load(const char *dir, const char key[65], unsigned char **obj, long *n);\n"
"void uo_free(void *p);\n"
"static int pass, fail;\n"
"static void note(int ok, const char *name) { printf(\"%s\\t%s\\n\", ok ? \"PASS\" : \"FAIL\", name); if (ok) pass++; else fail++; }\n"
"static int same(const char *a, const char *b) { int i; for (i = 0; i < 64; i++) if (a[i] != b[i]) return 0; return 1; }\n"
"/* two synthetic candidate digests, built at run time, differing in the first nibble */\n"
"static char C[65], C2[65];\n"
"static const unsigned char PP[] = \"int f(void){return 1;}\\n\";\n"
"static const unsigned char PQ[] = \"int f(void){return 2;}\\n\";\n"
"static int k(char *o, const char *c, const char *t, int l, int m, const unsigned char *p, const char *const *h, int nh) {\n"
"    long n = 0; while (p[n]) n++; return uo_key(o, c, t, l, m, p, n, h, nh); }\n"
"int main(int argc, char **argv) {\n"
"    const char *h1[2] = { \"h1sha\", \"h2sha\" };\n"
"    const char *h1r[2] = { \"h2sha\", \"h1sha\" };\n"
"    const char *h2[2] = { \"h1sha\", \"h3sha\" };\n"
"    const char *ba[2] = { \"ab\", \"c\" };\n"
"    const char *bb[2] = { \"a\", \"bc\" };\n"
"    char a[65], b[65], path[1024];\n"
"    unsigned char *got; long gn; unsigned long fn, dn; unsigned char *f; int r, i, hex;\n"
"    const char *dir;\n"
"    if (argc < 2) return 2;\n"
"    for (i = 0; i < 64; i++) { C[i] = 'a'; C2[i] = 'a'; } C2[0] = 'b';\n"
"    dir = argv[1];\n"
"    note(k(a, C, \"lnx/x86_64\", 2, 1, PP, h1, 2) == 0 && k(b, C, \"lnx/x86_64\", 2, 1, PP, h1, 2) == 0 && same(a, b), \"key-stable\");\n"
"    hex = a[64] == 0; for (i = 0; i < 64; i++) if (!((a[i] >= '0' && a[i] <= '9') || (a[i] >= 'a' && a[i] <= 'f'))) hex = 0;\n"
"    note(hex, \"key-hex64\");\n"
"    k(b, C2, \"lnx/x86_64\", 2, 1, PP, h1, 2); note(!same(a, b), \"field-candidate\");\n"
"    k(b, C, \"lnx/aarch64\", 2, 1, PP, h1, 2); note(!same(a, b), \"field-target\");\n"
"    k(b, C, \"lnx/x86_64\", 0, 1, PP, h1, 2); note(!same(a, b), \"field-level\");\n"
"    k(b, C, \"lnx/x86_64\", 2, 0, PP, h1, 2); note(!same(a, b), \"field-mode\");\n"
"    k(b, C, \"lnx/x86_64\", 2, 1, PQ, h1, 2); note(!same(a, b), \"field-preprocessed\");\n"
"    k(b, C, \"lnx/x86_64\", 2, 1, PP, h2, 2); note(!same(a, b), \"field-headers\");\n"
"    k(b, C, \"lnx/x86_64\", 2, 1, PP, h1, 1); note(!same(a, b), \"field-header-count\");\n"
"    k(b, C, \"lnx/x86_64\", 2, 1, PP, h1r, 2); note(same(a, b), \"headers-set-order\");\n"
"    { char x[65], y[65]; k(x, \"x\", \"yz\", 2, 1, PP, h1, 2); k(y, \"xy\", \"z\", 2, 1, PP, h1, 2); note(!same(x, y), \"boundary-cand-target\"); }\n"
"    { char x[65], y[65]; k(x, C, \"lnx/x86_64\", 2, 1, PP, ba, 2); k(y, C, \"lnx/x86_64\", 2, 1, PP, bb, 2); note(!same(x, y), \"boundary-headers\"); }\n"
"    { char x[65], y[65]; uo_key(x, C, \"ab\", 2, 1, (const unsigned char *)\"c\", 1, 0, 0); uo_key(y, C, \"a\", 2, 1, (const unsigned char *)\"bc\", 2, 0, 0); note(!same(x, y), \"boundary-target-pp\"); }\n"
"    r = uo_load(dir, a, &got, &gn); note(r == 1 && got == 0, \"load-miss\");\n"
"    r = uo_store(dir, a, PP, 23); note(r == 0, \"store\");\n"
"    r = uo_load(dir, a, &got, &gn);\n"
"    { int ok = r == 0 && got && gn == 23; for (i = 0; ok && i < 23; i++) if (got[i] != PP[i]) ok = 0; note(ok, \"load-roundtrip\"); if (got) uo_free(got); }\n"
"    uo_path(path, 1024, dir, a);\n"
"    f = (unsigned char *)cx_read(path, &fn);\n"
"    if (f && fn > 1) { f[fn - 1] = (unsigned char)(f[fn - 1] ^ 1); cx_write(path, f, fn); }\n"
"    r = uo_load(dir, a, &got, &gn); note(r == 2 && got == 0, \"tamper-body-refused\");\n"
"    note(cx_read(path, &dn) == 0, \"tamper-dropped\");\n"
"    uo_store(dir, a, PP, 23);\n"
"    if (f) { f[fn - 1] = (unsigned char)(f[fn - 1] ^ 1); f[0] = (unsigned char)(f[0] ^ 1); cx_write(path, f, fn); }\n"
"    r = uo_load(dir, a, &got, &gn); note(r == 2 && got == 0, \"tamper-magic-refused\");\n"
"    uo_store(dir, a, PP, 23);\n"
"    if (f) { f[0] = (unsigned char)(f[0] ^ 1); cx_write(path, f, fn - 5); }\n"
"    r = uo_load(dir, a, &got, &gn); note(r == 2 && got == 0, \"truncated-refused\");\n"
"    k(b, C2, \"lnx/x86_64\", 2, 1, PQ, h2, 2); uo_store(dir, b, PQ, 23); r = uo_load(dir, a, &got, &gn);\n"
"    note(r == 1, \"other-key-miss\");\n"
"    printf(\"SUMMARY\\tpass=%d\\tfail=%d\\n\", pass, fail);\n"
"    return fail ? 1 : 0;\n"
"}\n";

static int count_pass(const char *s, size_t n) {
    size_t i;
    int c = 0;
    for (i = 0; i + 5 <= n; i++)
        if ((i == 0 || s[i - 1] == '\n') && s[i] == 'P' && s[i + 1] == 'A' && s[i + 2] == 'S' && s[i + 3] == 'S' && s[i + 4] == '\t') c++;
    return c;
}

static int no_tmp_left(const char *dir) {
    /* every name in the probe dir must be a 64-hex object, never a .tmp */
    np_result r;
    char why[600];
    char *v[4];
    int bad = 0;
    size_t i;
    v[0] = "ls"; v[1] = (char *)dir; v[2] = 0;
    if (np_run(v, "/", 0, 10, &r, why, sizeof why)) return 0;
    if (r.rc != 0) bad = 1;
    for (i = 0; i + 4 <= r.outn; i++)
        if (r.out[i] == '.' && r.out[i + 1] == 't' && r.out[i + 2] == 'm' && r.out[i + 3] == 'p') bad = 1;
    np_free(&r);
    return !bad;
}

int main(void) {
    char root[4096];
    char dir[512];
    char probe[640];
    char objdir[640];
    char why[1400];
    char *v[8];
    char *envadd[3];
    np_result r;
    const char *product;
    int rc, n, fails = 0;
    if (sy_cwd(root, sizeof root)) { printf("FAIL\tcwd\n"); return 2; }
    if (cx_fmt(dir, sizeof dir, "/tmp/unisacc-check-unitobj-%ld", (long)sy_pid())) return 2;
    if (cx_fmt(probe, sizeof probe, "%s/probe.cx", dir)) return 2;
    if (cx_fmt(objdir, sizeof objdir, "%s/obj", dir)) return 2;
    if (sy_mkdir_all(objdir, 0700)) { printf("FAIL\tmkdir %s\n", objdir); return 2; }
    if (cx_write(probe, probe_src, (size_t)tx_len(probe_src, 1L << 20))) { printf("FAIL\twrite probe\n"); return 2; }
    product = sy_env_or("UNISACC", "./unisacc.com"); /* lint:allow R1-product Same-candidate probe launcher; UNISACC overrides it. */
    v[0] = "sh"; v[1] = (char *)product; v[2] = "cx/driver/unitobj.cx"; v[3] = probe; v[4] = "--"; v[5] = objdir; v[6] = 0;
    envadd[0] = "UNISACC_RUN_CACHE=0"; envadd[1] = "UNISACC_UNIT_CACHE=0"; envadd[2] = 0;
    if (np_run(v, root, envadd, 55, &r, why, sizeof why)) { printf("FAIL\tspawn %s\n", why); return 1; }
    rc = r.rc;
    if (r.outn) fwrite(r.out, 1, r.outn, stdout);
    if (r.errn) fwrite(r.err, 1, r.errn, stderr);
    n = count_pass(r.out ? r.out : "", r.outn);
    np_free(&r);
    if (rc != 0) { printf("FAIL\tprobe-rc=%d\n", rc); fails++; }
    if (n != UO_EXPECT) { printf("FAIL\tprobe-pass-count=%d expect=%d\n", n, UO_EXPECT); fails++; }
    if (no_tmp_left(objdir)) printf("PASS\tno-temp-left\n"); else { printf("FAIL\tno-temp-left\n"); fails++; }
    printf("check-unitobj: %s\n", fails ? "FAIL" : "PASS");
    if (!fails) printf("UNITOBJ_OK\tchecks=%d\n", n + 1);
    return fails ? 1 : 0;
}
