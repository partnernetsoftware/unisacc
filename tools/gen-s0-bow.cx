#pragma unisa use cxlib.uxeimage
#pragma unisa use chrome_dom
/* tools/gen-s0-bow.cx -- 概念稿船头弧形舷边 520x252.
 * sh ./unisacc.com tools/gen-s0-bow.cx -- --write|--check
 */
#define CW 540
#define CH 284


#define OX 80
#define OY 396

static unsigned char cpix[CH][CW][4];
static double hx[96], hy[96];
static int hn;
static void qbez(double x0, double y0, double cx, double cy, double x1, double y1) {
    int i;
    for (i = 1; i <= 32; i++) {
        double t = (double)i / 32.0, u = 1.0 - t;
        hx[hn] = u * u * x0 + 2 * u * t * cx + t * t * x1;
        hy[hn] = u * u * y0 + 2 * u * t * cy + t * t * y1;
        hn++;
    }
}
static double dseg(double x, double y, double ax, double ay, double bx, double by) {
    double dx = bx - ax, dy = by - ay, t, px, py;
    double den = dx * dx + dy * dy;
    if (den < 1e-9) { px = x - ax; py = y - ay; return px * px + py * py; }
    t = ((x - ax) * dx + (y - ay) * dy) / den;
    if (t < 0) t = 0;
    if (t > 1) t = 1;
    px = x - (ax + t * dx); py = y - (ay + t * dy);
    return px * px + py * py;
}
static double dqbez(double x, double y, double x0, double y0, double cx, double cy, double x1, double y1) {
    int i;
    double best = 1e12, px0 = x0, py0 = y0, px1, py1, t, u, d;
    for (i = 1; i <= 24; i++) {
        t = (double)i / 24.0; u = 1.0 - t;
        px1 = u * u * x0 + 2 * u * t * cx + t * t * x1;
        py1 = u * u * y0 + 2 * u * t * cy + t * t * y1;
        d = dseg(x, y, px0, py0, px1, py1);
        if (d < best) best = d;
        px0 = px1; py0 = py1;
    }
    return best;
}
static void fill_bow(void) {
    int y, x, i;
    hn = 0;
    hx[hn] = 90; hy[hn] = 680; hn++;
    qbez(90, 680, 220, 430, 430, 430);
    qbez(430, 430, 560, 500, 610, 680);
    for (y = 0; y < CH; y++) for (x = 0; x < CW; x++) {
        double wx = (double)(OX + x), wy = (double)(OY + y);
        int a = 0, r = 42, g = 24, b = 16;
        if (uxe_polygon_contains(hx,hy,hn,wx, wy)) {
            a = 255;
            if (dqbez(wx, wy, 120, 640, 300, 450, 560, 640) < 16.0) {
                r = 74; g = 48; b = 32;
            }
            for (i = 0; i < 6; i++) {
                double ax = 140 + i * 70, ay = 670, bx = 200 + i * 60, by = 500;
                if (dseg(wx, wy, ax, ay, bx, by) < 2.25) {
                    r = (r * 6 + 90) / 7; g = (g * 6 + 60) / 7; b = (b * 6 + 40) / 7;
                }
            }
        }
        cpix[y][x][0] = (unsigned char)r;
        cpix[y][x][1] = (unsigned char)g;
        cpix[y][x][2] = (unsigned char)b;
        cpix[y][x][3] = (unsigned char)a;
    }
}
static unsigned char outb[CH * (1 + CW * 4) + (CH * (1 + CW * 4) / 65535 + 1) * 5 + 63];
int main(int argc, char **argv) {
    int write = 0, check = 0, i, oi, failed = 0;
    FILE *f;
    uxe_crc_init();
    for (i = 1; i < argc; i++) {
        if (argv[i][0] == '-' && argv[i][2] == 'w') write = 1;
        if (argv[i][0] == '-' && argv[i][2] == 'c') check = 1;
    }
    if (!write && !check) { printf("GEN_S0_BOW\tdry\n"); return 0; }
    fill_bow();
    oi = uxe_encode_rgba_png(outb,sizeof outb,&cpix[0][0][0],CW,CH);
    if(oi<=0) return 2;
    if (write) {
        f = fopen("ujs/plans/demo-v2/look-dev/bow-hull.png", "wb");
        if (!f) return 1;
        fwrite(outb, 1, oi, f);
        fclose(f);
        printf("WROTE\tbow-hull.png\t%d\n", oi);
    }
    if (check) {
        if (uxe_check_png("ujs/plans/demo-v2/look-dev/bow-hull.png", outb, oi)) {
            printf("DIFF\tbow-hull.png\n");
            failed = 1;
        } else printf("MATCH\tbow-hull.png\n");
    }
    printf("GEN_S0_BOW\tok\n");
    return failed;
}
