#pragma unisa use cxlib.uxeimage
#pragma unisa use chrome_dom
/* tools/gen-s0-cloud.cx -- 概念稿分形云 1120x180.
 * hash/vnoise/fbm 与 water-keeps-s0.html 同常数.
 * sh ./unisacc.com tools/gen-s0-cloud.cx -- --write|--check
 */
#define CW 1120
#define CH 180
static unsigned char cpix[CH][CW][4];
static int write_mode;
static int ifloor(double x) {
    int i = (int)x;
    if (x < 0 && (double)i != x) i--;
    return i;
}
static double cl_sin(double x) {
    double pi = 3.141592653589793;
    double twopi = 6.283185307179586;
    double t, x2, s, term;
    t = x / twopi;
    t = t - (double)ifloor(t);
    x = t * twopi;
    if (x > pi) x -= twopi;
    x2 = x * x;
    s = x;
    term = x;
    term = term * (-x2) / 6.0; s += term;
    term = term * (-x2) / 20.0; s += term;
    term = term * (-x2) / 42.0; s += term;
    term = term * (-x2) / 72.0; s += term;
    term = term * (-x2) / 110.0; s += term;
    return s;
}
static double cl_hash(double x, double y) {
    double n = cl_sin(x * 127.1 + y * 311.7) * 43758.5453;
    return n - (double)ifloor(n);
}
static double vnoise(double x, double y) {
    int x0 = ifloor(x), y0 = ifloor(y);
    double fx = x - (double)x0, fy = y - (double)y0;
    double a = cl_hash((double)x0, (double)y0);
    double b = cl_hash((double)(x0 + 1), (double)y0);
    double c = cl_hash((double)x0, (double)(y0 + 1));
    double d = cl_hash((double)(x0 + 1), (double)(y0 + 1));
    double ux = fx * fx * (3.0 - 2.0 * fx);
    double uy = fy * fy * (3.0 - 2.0 * fy);
    return a + (b - a) * ux + (c - a) * uy + (a - b - c + d) * ux * uy;
}
static double fbm(double x, double y) {
    double a = 0, amp = 0.5, f = 1;
    int i;
    for (i = 0; i < 5; i++) {
        a += amp * vnoise(x * f, y * f);
        f *= 2;
        amp *= 0.5;
    }
    return a;
}
static void fill_cloud(void) {
    int y, x;
    for (y = 0; y < CH; y++) for (x = 0; x < CW; x++) {
        double wx = (double)(80 + x);
        double wy = (double)(y - 40);
        double n = fbm(wx * 0.006, wy * 0.035);
        int ai;
        n = n * n;
        cpix[y][x][0] = 244;
        cpix[y][x][1] = 224;
        cpix[y][x][2] = 168;
        /* A broad bank of sunlit mist beneath the denser fractal lobes. */
        double ad = 0.24 + 1.8 * n;
        if (ad > 0.9) ad = 0.9;
        ai = (int)(ad * 255.0 + 0.5);
        double along = (2.0*x + 1.0)/CW - 1.0;
        double center = 78.0 + 34.0*(vnoise(wx*0.009, 3.0)-0.5);
        double across = (y-center)/82.0;
        double edge = (1.0-along*along-across*across)*2.3;
        if (edge < 0.0) edge = 0.0;
        if (edge > 1.0) edge = 1.0;
        ai = (int)(ai*edge*edge*(3.0-2.0*edge));
        cpix[y][x][3] = (unsigned char)ai;

    }
}
static unsigned char outb[CH * (1 + CW * 4) + (CH * (1 + CW * 4) / 65535 + 1) * 5 + 63];
int main(int argc, char **argv) {
    int write = 0, check = 0, i, oi, failed = 0;
    FILE *f;
    uxe_crc_init();
    for (i = 1; i < argc; i++) {
        if (argv[i][0] == '-' && argv[i][2] == 'w') write = 1;
        if (argv[i][0] == '-' && argv[i][2] == 'c') check = 1;
    }
    if (!write && !check) { printf("GEN_S0_CLOUD\tdry\n"); return 0; }
    write_mode = write;
    fill_cloud();
    oi = uxe_encode_rgba_png(outb,sizeof outb,&cpix[0][0][0],CW,CH);
    if(oi<=0) return 2;
    if (write) {
        f = fopen("ujs/plans/demo-v2/look-dev/cloud-soft.png", "wb");
        if (!f) return 1;
        fwrite(outb, 1, oi, f);
        fclose(f);
        printf("WROTE\tcloud-soft.png\t%d\n", oi);
    }
    if (check) {
        if (uxe_check_png("ujs/plans/demo-v2/look-dev/cloud-soft.png", outb, oi)) {
            printf("DIFF\tcloud-soft.png\n");
            failed = 1;
        } else printf("MATCH\tcloud-soft.png\n");
    }
    printf("GEN_S0_CLOUD\tok\n");
    return failed;
}
