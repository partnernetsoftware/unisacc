/* Pure-read material qualification, independent of a producer's old terminal
 * status. No construction, output directories, receipt edits or test results.
 * Each endpoint physically rereads the job closure in a fresh snapshot child.
 * Two observations are not an atomic filesystem snapshot or ABA protection.
 * Budget: identity 8 + snapshot 16, twice = 48; caller outer bound remains 55.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.sourcepackage
#pragma unisa use text.text

static void sjv_fail(const char *reason) {
    fprintf(stderr,"source-job-verify: %s\n",reason);
    exit(2);
}

#if defined(__linux__) && defined(__x86_64__)
static long long sjv_clock(void) {
    struct timespec t={0};
    long rc=__syscall6(228,1,(long)&t,0,0,0);
    if(_unisa_ret(rc)||t.tv_sec<0||t.tv_nsec<0||t.tv_nsec>=1000000000L||
       (unsigned long long)t.tv_sec>(unsigned long long)(LLONG_MAX-t.tv_nsec)/1000000000ULL)
        sjv_fail("monotonic-clock");
    return (long long)t.tv_sec*1000000000LL+t.tv_nsec;
}

static void sjv_join(char *out,size_t cap,const char *base,const char *leaf) {
    int n=snprintf(out,cap,"%s/%s",base,leaf);
    if(n<0||(size_t)n>=cap) sjv_fail("path-bound");
}

static void sjv_identity(const char *root_arg,const char *context,char sid_out[65],long long *elapsed) {
    char watchdog[4400],helper_path[4400],why[1024];
    sjv_join(watchdog,sizeof watchdog,root_arg,"tools/bound");
    sjv_join(helper_path,sizeof helper_path,context,"identity-helper");
    char *argv[]={watchdog,"8",helper_path,(char *)root_arg,0};
    np_result result={0};
    long long start=sjv_clock();
    int failed=np_run(argv,root_arg,0,8,&result,why,sizeof why);
    long long end=sjv_clock();
    if(end<start) sjv_fail("monotonic-clock-regressed");
    *elapsed=end-start;
    if(failed) {
        np_free(&result);
        sjv_fail(why);
    }
    int valid=!result.rc&&!result.errn&&result.outn==65&&result.out[64]=='\n';
    if(valid) for(int i=0;i<64;i++)
        if(!((result.out[i]>='0'&&result.out[i]<='9')||(result.out[i]>='a'&&result.out[i]<='f'))) valid=0;
    if(!valid) {
        fprintf(stderr,"source-job-verify: fresh-source rc=%d stdout-bytes=%lu stderr-bytes=%lu\n",
                result.rc,(unsigned long)result.outn,(unsigned long)result.errn);
        if(result.errn) fwrite(result.err,1,result.errn,stderr);
        np_free(&result);
        sjv_fail("fresh-source-observation");
    }
    memcpy(sid_out,result.out,64);sid_out[64]=0;
    np_free(&result);
}

static void sjv_same(const sp_result *a,const sp_result *b) {
    /* Compare fields, never padding or the independently measured elapsed time. */
    if(!tx_eqz(a->source, b->source)||!tx_eqz(a->artifact, b->artifact)||
       !tx_eqz(a->manifest, b->manifest)||!tx_eqz(a->receipt, b->receipt)||
       !tx_eqz(a->witness, b->witness)||!tx_eqz(a->epoch_artifact, b->epoch_artifact)||
       !tx_eqz(a->epoch_record, b->epoch_record)||!tx_eqz(a->epoch_path, b->epoch_path)||
       !tx_eqz(a->producer, b->producer)||!tx_eqz(a->foundation, b->foundation)||
       !tx_eqz(a->verifier, b->verifier)||a->jobs!=b->jobs||a->models!=b->models||
       a->physical_reads!=b->physical_reads) sjv_fail("endpoint-material-or-physical-view-changed");
}
#endif

int main(int argc,char **argv) {
    if(argc!=4) sjv_fail("usage: ROOT SOURCE_CTX JOB_ID");
#if !defined(__linux__) || !defined(__x86_64__)
    fprintf(stderr,"NOT_RUN source-job-verify requires Linux/x86_64-LP64\n");
    return 3;
#else
    if(sizeof(long)!=8||sizeof(void *)!=8) sjv_fail("LP64-required");
    char root_arg[4096],context[4096];
    if(!realpath(argv[1],root_arg)||!realpath(argv[2],context)) sjv_fail("root-or-context-realpath");
    if(!argv[3][0]||strpbrk(argv[3],"/\r\n\t")) sjv_fail("job-id");
    sp_result observations[2];char fresh[2][65],why[2048];
    long long identity_ns[2];long long begin=sjv_clock();
    for(int i=0;i<2;i++) {
        sjv_identity(root_arg,context,fresh[i],&identity_ns[i]);
        if(sp_verify_job_snapshot(root_arg,context,argv[3],fresh[i],16,&observations[i],why,sizeof why))
            sjv_fail(why);
    }
    if(!tx_eqz(fresh[0], fresh[1])) sjv_fail("fresh-source-changed");
    sjv_same(&observations[0],&observations[1]);
    long long end=sjv_clock();if(end<begin) sjv_fail("monotonic-clock-regressed");
    const sp_result *r=&observations[1];
    printf("VERIFIED\tmaterial-only-no-test-result\tjob=%s\tsource=%s\n",argv[3],r->source);
    printf("artifact\t%s\nmanifest\t%s\nreceipt\t%s\nwitness\t%s\n",r->artifact,r->manifest,r->receipt,r->witness);
    printf("epoch-artifact\t%s\nepoch-record\t%s\nepoch-path\t%s\n",r->epoch_artifact,r->epoch_record,r->epoch_path);
    printf("producer\t%s\nfoundation\t%s\nverifier\t%s\n",r->producer,r->foundation,r->verifier);
    printf("jobs\t%d\nmodels\t%d\nphysical-reads-per-endpoint\t%d\n",r->jobs,r->models,r->physical_reads);
    printf("elapsed-ns\tidentity-before=%lld\tsnapshot-before=%lld\tidentity-after=%lld\tsnapshot-after=%lld\ttotal=%lld\n",
           identity_ns[0],observations[0].elapsed_ns,identity_ns[1],observations[1].elapsed_ns,end-begin);
    puts("scope\tread-only-double-observation;no-atomic-snapshot-or-ABA-proof;no-construction;no-old-producer-status-rewrite");
    int output_failed=ferror(stdout);
    if(fflush(stdout)) output_failed=1;
    return output_failed?2:0;
#endif
}
