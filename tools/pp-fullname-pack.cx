/* Private fast-lane package: replace exactly three PP model paths (or the
 * two routed parse2 recipes with --aggregate-return) in a
 * verified base PC declaration; preserve all other compressed M records and
 * the complete F resource section. Never installs or produces admission. */
#pragma unisa use cxlib.netpack
typedef struct {char *p;size_t n,at,model_at,resources;int models,stages;size_t *mstart,*mend;int *changed;} Package;
static const char *names[]={"shared-e2","warnpp-shared","tokenpp"};
static void die(const char *s){fprintf(stderr,"pp-fullname-pack: %s errno=%d\n",s,errno);exit(2);}
static void join(char p[4400],const char *a,const char *b){if(cx_path_join(p,4400,a,b))die("path");}
static char *load(const char *p,size_t *n){char *s=cx_read(p,n);if(!s)die(p);return s;}
static void save(const char *p,const void *s,size_t n){if(cx_write(p,s,n))die("write");}
static char *line(Package *p){if(p->at>=p->n)die("package-line");size_t start=p->at;while(p->at<p->n&&p->p[p->at]!='\n')p->at++;if(p->at==p->n)die("package-line-end");return p->p+start;}
static unsigned number(char **at,char *end){unsigned long n=0;char *p=*at;if(p>=end||*p<'0'||*p>'9')die("package-number");while(p<end&&*p>='0'&&*p<='9'){n=n*10+(unsigned)(*p++-'0');if(n>268435456)die("package-number-bound");}if(p<end&&*p==' ')p++;*at=p;return (unsigned)n;}
static void parse(Package *p){char *l=line(p),*end=p->p+p->at;if(end-l<6||memcmp(l,"P 3 ",4))die("canonical-P3");char *a=l+4;p->models=(int)number(&a,end);p->stages=(int)number(&a,end);number(&a,end);if(a!=end||p->models<1||p->models>65536||p->stages<1)die("package-header");p->at++;for(int i=0;i<p->stages;i++){l=line(p);if(l[0]!='D'||l[1]!=' ')die("D-record");p->at++;}p->model_at=p->at;p->mstart=calloc((size_t)p->models,sizeof *p->mstart);p->mend=calloc((size_t)p->models,sizeof *p->mend);p->changed=calloc((size_t)p->models,sizeof *p->changed);if(!p->mstart||!p->mend||!p->changed)die("allocation");for(int i=0;i<p->models;i++){p->mstart[i]=p->at;l=line(p);end=p->p+p->at;if(l[0]!='M'||l[1]!=' ')die("M-record");a=l+2;unsigned bytes=number(&a,end);p->at++;if(bytes>p->n-p->at)die("M-extent");p->at+=bytes;p->mend[i]=p->at;}p->resources=p->at;}
static void identity(np_buf *b,const char *kind,const char *path){size_t n;char *s=load(path,&n),hash[65];cx_sha256_hex(s,n,hash);free(s);np_puts(b,kind);np_puts(b,"\t");np_puts(b,path);np_puts(b,"\t");np_puts(b,hash);np_puts(b,"\n");}
int main(int argc,char **argv){
 int aggregate=argc==7&&!strcmp(argv[6],"--aggregate-return");if(argc!=6&&!aggregate)die("usage PRODUCT BASE_PC NATIVE_PACK NEW_MODELS NEW_ABS_OUT [--aggregate-return]");if(aggregate){names[0]="warnparse";names[1]="errorparse";}char product[4096],pc[4096],pack[4096],models[4096],root[4096],out[4400];if(!realpath(argv[1],product)||!realpath(argv[2],pc)||!realpath(argv[3],pack)||!realpath(argv[4],models)||argv[5][0]!='/')die("canonical-inputs");strcpy(root,product);char *slash=strrchr(root,'/');if(!slash)die("product-parent");*slash=0;strcpy(out,argv[5]);if(mkdir(out,0700))die("exclusive-output");
 char basepath[4400],routepath[4400],newroute[4400],newpkg[4400],bound[4400],headers[4400],kernels[4400],predefines[4400],file[4400];join(basepath,pc,"compiler.pkg");join(routepath,pc,"declaration/routes.tsv");join(newroute,out,"routes.tsv");join(newpkg,out,"compiler.pkg");join(bound,root,"tools/bound");join(headers,root,"include");join(kernels,pc,"kernels");join(predefines,pc,"declaration/predefines");
 Package old={0},fresh={0};old.p=load(basepath,&old.n);size_t pn;char *prod=load(product,&pn);if(pn<16||memcmp(prod+pn-16,"UNIPKG1\n",8))die("product-footer");unsigned long extent=0;for(int i=7;i>=0;i--)extent=(extent<<8)|(unsigned char)prod[pn-8+i];if(extent!=old.n||extent>pn-16||memcmp(prod+pn-16-extent,old.p,old.n))die("base-PC-not-installed-candidate");free(prod);parse(&old);
 size_t rn;char *routes=load(routepath,&rn);np_buf rewritten={0},ids={0};np_puts(&ids,aggregate?"PRIVATE_NON_ADMITTED\taggregate-return\n":"PRIVATE_NON_ADMITTED\tpp-fullname\n");identity(&ids,"PRODUCT",product);identity(&ids,"BASE",basepath);identity(&ids,"PACK",pack);int touched[3]={0};char *at=routes;size_t d=0;size_t da=0;while(da<old.model_at&&old.p[da]!='\n')da++;da++;
 while(at<routes+rn){char *end=memchr(at,'\n',(size_t)(routes+rn-at));if(!end)die("routes-newline");if(*at=='#'||at==end){np_put(&rewritten,at,(size_t)(end-at+1));at=end+1;continue;}char *last=end;while(last>at&&last[-1]!='\t')last--;if(last==at)die("route-fields");int selected=-1;for(int k=0;k<(aggregate?2:3);k++){char expected[4400],leaf[100];snprintf(leaf,sizeof leaf,"models/%s.net",names[k]);join(expected,pc,leaf);if((size_t)(end-last)==strlen(expected)&&!memcmp(last,expected,(size_t)(end-last)))selected=k;}
  size_t dend=da;while(dend<old.model_at&&old.p[dend]!='\n')dend++;if(dend==old.model_at||d>=(size_t)old.stages)die("route-D-order");if(selected>=0){char *idx=old.p+dend;while(idx>old.p+da&&idx[-1]!=' ')idx--;char *ie=idx;unsigned index=number(&ie,old.p+dend);if(ie!=old.p+dend||index>=(unsigned)old.models)die("route-model-index");old.changed[index]=1;char target[4400],leaf[100];snprintf(leaf,sizeof leaf,"%s.net",names[selected]);join(target,models,leaf);np_put(&rewritten,at,(size_t)(last-at));np_puts(&rewritten,target);np_puts(&rewritten,"\n");touched[selected]++;}else np_put(&rewritten,at,(size_t)(end-at+1));d++;da=dend+1;at=end+1;
 }if(d!=(size_t)old.stages)die("route-stage-count");for(int k=0;k<(aggregate?2:3);k++)if(!touched[k])die("unused-selected-replacement");save(newroute,rewritten.p,rewritten.n);free(rewritten.p);free(routes);
 char *v[]={bound,"40",pack,"--compressed","-o",newpkg,"--mount","006864722f",headers,"--mount","006b65726e656c2f",kernels,"--mount","00707265646566696e65732f",predefines,newroute,0};np_result result={0};char why[1200];if(np_run(v,root,0,43,&result,why,sizeof why))die(why);join(file,out,"pack.stdout");save(file,result.out,result.outn);join(file,out,"pack.stderr");save(file,result.err,result.errn);if(result.rc){if(result.errn)fwrite(result.err,1,result.errn,stderr);die("native-pack");}np_free(&result);
 fresh.p=load(newpkg,&fresh.n);parse(&fresh);if(old.models!=fresh.models||old.stages!=fresh.stages||old.model_at!=fresh.model_at||memcmp(old.p,fresh.p,old.model_at))die("route-or-model-index-drift");int changed=0,preserved=0;for(int i=0;i<old.models;i++){size_t a=old.mend[i]-old.mstart[i],b=fresh.mend[i]-fresh.mstart[i];int equal=a==b&&!memcmp(old.p+old.mstart[i],fresh.p+fresh.mstart[i],a);if(old.changed[i]){if(equal)die("replacement-not-changed");changed++;}else{if(!equal)die("unrequested-model-changed");preserved++;}}
 if(changed!=(aggregate?2:3)||old.n-old.resources!=fresh.n-fresh.resources||memcmp(old.p+old.resources,fresh.p+fresh.resources,old.n-old.resources))die("resource-or-replacement-count");identity(&ids,"PRIVATE_PACKAGE",newpkg);join(file,out,"identity.tsv");save(file,ids.p,ids.n);printf("%s\tPREPARED_NON_ADMITTED\tchanged=%d\tpreserved=%d\tresources-byte-identical\t%s\n",aggregate?"PRIVATE_AGGREGATE_PACKAGE":"PRIVATE_PP_PACKAGE",changed,preserved,newpkg);return 0;
}
