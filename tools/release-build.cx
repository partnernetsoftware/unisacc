/* Release chain for one slice at a time.
   sh ./unisacc.com tools/release-build.cx -- [--rev REV] p3 ROOT SRC_PKG OUT_PKG
   sh ./unisacc.com tools/release-build.cx -- [--rev REV] slice ROOT PKG OUT [entry-build flags]

   REV defaults to HEAD. Sources and include/ come from `git archive` of that
   commit (out/release-snap-<sha10>/, reused when the marker matches), not from
   the shared worktree. The installed ROOT/unisacc.com is copied in as the
   generation-1 constructor. The receipt records the full rev.

   p3 keeps the model bytes of SRC_PKG and replaces every \0hdr/ resource with
   the files under the snapshot's include/ (seed/pack.c mount order). The
   resource \0hdr/cx-flat.h must then match that include/cx-flat.h byte for
   byte. Models are not rebuilt and package-refresh is not called.

   slice runs one entry-build invocation. lnx/x86_64 stays the 33-object
   route. osx and win are refused here until the whole -o route is wired.
   Pass --only / --link-only through so one invocation stays inside the
   per-compile bound. This does not install and does not wrap. */
#pragma unisa use runtime.package_decode
#pragma unisa use runtime.package_lifetime
#pragma unisa use runtime.packagefooter
#pragma unisa use runtime.model_number
#pragma unisa use compiler.bindstage
#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.proc
#pragma unisa use sys.io
#pragma unisa use sys.sig
#pragma unisa use sys.time
#pragma unisa use text.text

#define RB_FILES 128
#define RB_REL 192
#define RB_FULL 512

typedef struct { unsigned char *p; long n, cap; } RbBuf;
typedef struct { char rel[RB_REL]; char full[RB_FULL]; } RbFile;

static RbFile rb_files[RB_FILES];
static int rb_nfiles;

static void rb_die(const char *s) {
    sy_eprintf("release-build: %s\n", s);
    sy_exit(1);
}

static void *rb_alloc(void *p, size_t n) { return mm_grow(p, (long)n); }
static void rb_drop(void *p) { mm_free(p); }

static void rb_put(RbBuf *b, const void *s, long n) {
    long c;
    unsigned char *g;
    if (n < 0 || (n > 0 && !s)) rb_die("put");
    if (n == 0) return;
    if (b->n > 2147483647L - n) rb_die("put");
    c = b->cap;
    while (c < b->n + n) {
        if (c > 1073741823L) rb_die("put");
        c = c ? c * 2 : 4096;
    }
    if (c != b->cap) {
        g = (unsigned char *)mm_grow(b->p, c);
        if (!g) rb_die("out of memory");
        b->p = g;
        b->cap = c;
    }
    if (mm_copy(b->p + b->n, b->cap - b->n, s, n)) rb_die("put");
    b->n += n;
}

static long long rb_span(const sy_ts_t *a, const sy_ts_t *b) {
    return (long long)(b->sec - a->sec) * 1000000000LL + (long long)(b->nsec - a->nsec);
}

static void rb_cat(char *dst, int cap, const char *a, int slash, const char *b) {
    int i = 0, j = 0;
    if (!a || !b) rb_die("path");
    while (a[i]) {
        if (i + 1 >= cap) rb_die("path");
        dst[i] = a[i];
        i++;
    }
    if (slash) {
        if (i + 1 >= cap) rb_die("path");
        dst[i++] = '/';
    }
    while (b[j]) {
        if (i + 1 >= cap) rb_die("path");
        dst[i++] = b[j++];
    }
    dst[i] = 0;
}

static int rb_cmp(const char *a, const char *b) {
    for (;;) {
        int ea = !*a || *a == '/';
        int eb = !*b || *b == '/';
        unsigned char ca, cb;
        if (ea && eb) {
            if (!*a && !*b) return 0;
            if (!*a) return -1;
            if (!*b) return 1;
            a++;
            b++;
            continue;
        }
        if (ea) return -1;
        if (eb) return 1;
        ca = (unsigned char)*a;
        cb = (unsigned char)*b;
        if (ca != cb) return ca < cb ? -1 : 1;
        a++;
        b++;
    }
}

static void rb_sort(void) {
    int i, j;
    for (i = 1; i < rb_nfiles; i++) {
        RbFile key = rb_files[i];
        j = i;
        while (j > 0 && rb_cmp(rb_files[j - 1].rel, key.rel) > 0) {
            rb_files[j] = rb_files[j - 1];
            j--;
        }
        rb_files[j] = key;
    }
}

static void rb_add(const char *full, const char *rel) {
    long n;
    if (rb_nfiles == RB_FILES) rb_die("include tree");
    n = tx_len(rel, RB_REL);
    if (n < 0) rb_die("include name");
    rb_cat(rb_files[rb_nfiles].rel, RB_REL, rel, 0, "");
    rb_cat(rb_files[rb_nfiles].full, RB_FULL, full, 0, "");
    rb_nfiles++;
}

static void rb_walk(const char *full, const char *rel, int depth) {
    char names[8192];
    char child_full[RB_FULL], child_rel[RB_REL];
    int fd, count, i, at;
    sy_stat_t st;
    if (depth > 8) rb_die("include depth");
    fd = sy_open(full, O_RDONLY, 0);
    if (fd < 0) rb_die("include open");
    count = sy_dir_names(fd, names, (int)sizeof names);
    if (sy_close(fd)) rb_die("include close");
    if (count < 0) rb_die("include names");
    at = 0;
    for (i = 0; i < count; i++) {
        long n = tx_len(names + at, 256);
        if (n < 0) rb_die("include name");
        rb_cat(child_full, RB_FULL, full, 1, names + at);
        rb_cat(child_rel, RB_REL, rel, rel[0] ? 1 : 0, names + at);
        if (sy_lstat(child_full, &st)) rb_die("include stat");
        if (st.kind == 'd') rb_walk(child_full, child_rel, depth + 1);
        else if (st.kind == 'f') rb_add(child_full, child_rel);
        at += (int)n + 1;
    }
}

static int rb_hdr(const unsigned char *name, int n) {
    static const unsigned char p[5] = {0, 'h', 'd', 'r', '/'};
    return n >= 5 && mm_same(name, p, 5);
}

static int rb_flat_key(const unsigned char *name, int n) {
    static const unsigned char k[14] = {
        0, 'h', 'd', 'r', '/', 'c', 'x', '-', 'f', 'l', 'a', 't', '.', 'h'
    };
    return n == 14 && mm_same(name, k, 14);
}

static long rb_res_at(const unsigned char *b, const CxPackage *p) {
    int name, i;
    if (p->nr <= 0) return p->n;
    name = p->res[0].name;
    if (name < 2 || b[name - 1] != 10) return -1;
    i = name - 2;
    while (i >= 0 && b[i] >= '0' && b[i] <= '9') i--;
    if (i < 0 || b[i] != ' ') return -1;
    i--;
    while (i >= 0 && b[i] >= '0' && b[i] <= '9') i--;
    if (i < 0 || b[i] != ' ') return -1;
    i--;
    if (i < 0 || b[i] != 'F') return -1;
    return i;
}

static void rb_emit(RbBuf *o, const unsigned char *name, long nlen, const unsigned char *data, long dlen) {
    char line[64];
    long n;
    if (cx_fmt(line, sizeof line, "F %ld %ld\n", nlen, dlen)) rb_die("resource line");
    n = tx_len(line, 64);
    if (n < 0) rb_die("resource line");
    rb_put(o, line, n);
    rb_put(o, name, nlen);
    if (dlen) rb_put(o, data, dlen);
}

static void rb_say(const char *kind, const char *sha, long bytes, long long ns) {
    char line[160];
    if (cx_fmt(line, sizeof line, "release-build\t%s\tsha=%s\tbytes=%ld\tns=%lld\n", kind, sha, bytes, ns))
        rb_die("report");
    sy_printf("%s", line);
}

static int rb_p3(int argc, char **argv) {
    size_t zn, fn;
    char *file, *flat, *inc;
    unsigned char *src;
    PackageFooter foot;
    CxPackageDecode dec, chk;
    CxPackage *pkg;
    RbBuf out;
    sy_ts_t t0, t1;
    char line[64], sha[65], incdir[RB_FULL];
    const unsigned char *body;
    long line_end, res_at, kept, i, pack_n;
    int fd, nr;
    unsigned char tail[16];
    if (argc != 5) rb_die("usage: p3 ROOT SRC_PKG OUT_PKG");
    if (sy_mono(&t0)) rb_die("clock");
    file = cx_read(argv[3], &zn);
    if (!file || zn > 2147483647UL) rb_die("read package");
    src = (unsigned char *)file;
    if (!packagefooter_locate_bytes(src, (long)zn, &foot)) rb_die("package footer");
    if (foot.package_offset < 0 || foot.package_length <= 0) rb_die("package span");
    if (src[foot.package_offset] != 'P') rb_die("package mark");
    dec.bytes = 0;
    dec.length = 0;
    dec.at = 0;
    dec.allocate = rb_alloc;
    dec.release = rb_drop;
    dec.why = 0;
    mm_fill(&dec.package, (long)sizeof dec.package, 0, (long)sizeof dec.package);
    if (cxpk_decode(&dec, src + foot.package_offset, foot.package_length)) rb_die(dec.why ? dec.why : "decode");
    pkg = &dec.package;
    body = src + foot.package_offset;
    line_end = 0;
    while (line_end < pkg->n && body[line_end] != 10) line_end++;
    if (line_end >= pkg->n || line_end < 2 || body[0] != 'P') rb_die("package head");
    line_end++;
    res_at = rb_res_at(body, pkg);
    if (res_at < line_end || body[line_end] != 'D') rb_die("package body");
    rb_cat(incdir, RB_FULL, argv[2], 1, "include");
    rb_nfiles = 0;
    rb_walk(incdir, "", 0);
    if (!rb_nfiles) rb_die("empty include");
    rb_sort();
    kept = 0;
    for (i = 0; i < pkg->nr; i++) if (!rb_hdr(body + pkg->res[i].name, pkg->res[i].n)) kept++;
    nr = (int)kept + rb_nfiles;
    if (cx_fmt(line, sizeof line, "P %d %d %d %d\n", pkg->ver, pkg->m, pkg->s, nr)) rb_die("package head");
    out.p = 0;
    out.n = 0;
    out.cap = 0;
    {
        long hn = tx_len(line, 64);
        if (hn < 0) rb_die("package head");
        rb_put(&out, line, hn);
    }
    rb_put(&out, body + line_end, res_at - line_end);
    for (i = 0; i < pkg->nr; i++) {
        if (rb_hdr(body + pkg->res[i].name, pkg->res[i].n)) continue;
        rb_emit(&out, body + pkg->res[i].name, pkg->res[i].n, body + pkg->res[i].data, pkg->res[i].len);
    }
    for (i = 0; i < rb_nfiles; i++) {
        unsigned char key[5 + RB_REL];
        char *bytes;
        long reln = tx_len(rb_files[i].rel, RB_REL);
        static const unsigned char pre[5] = {0, 'h', 'd', 'r', '/'};
        if (reln < 0 || 5 + reln > (long)sizeof key) rb_die("include name");
        if (mm_copy(key, (long)sizeof key, pre, 5)) rb_die("include name");
        if (reln && mm_copy(key + 5, (long)sizeof key - 5, rb_files[i].rel, reln)) rb_die("include name");
        bytes = cx_read(rb_files[i].full, &fn);
        if (!bytes) rb_die("include read");
        rb_emit(&out, key, 5 + reln, (const unsigned char *)bytes, (long)fn);
        mm_free(bytes);
    }
    cxpl_release(pkg, rb_drop);
    chk.bytes = 0;
    chk.length = 0;
    chk.at = 0;
    chk.allocate = rb_alloc;
    chk.release = rb_drop;
    chk.why = 0;
    mm_fill(&chk.package, (long)sizeof chk.package, 0, (long)sizeof chk.package);
    if (cxpk_decode(&chk, out.p, out.n)) rb_die(chk.why ? chk.why : "redecode");
    rb_cat(incdir, RB_FULL, argv[2], 1, "include/cx-flat.h");
    flat = cx_read(incdir, &fn);
    if (!flat) rb_die("cx-flat.h");
    {
        int found = 0;
        CxPackage *c = &chk.package;
        for (i = 0; i < c->nr; i++) {
            if (!rb_flat_key(out.p + c->res[i].name, c->res[i].n)) continue;
            found = 1;
            if ((long)fn != c->res[i].len || !mm_same(out.p + c->res[i].data, flat, (long)fn))
                rb_die("cx-flat.h mismatch");
        }
        if (!found) rb_die("cx-flat.h missing");
    }
    mm_free(flat);
    cxpl_release(&chk.package, rb_drop);
    pack_n = out.n;
    tail[0] = 'U'; tail[1] = 'N'; tail[2] = 'I'; tail[3] = 'P';
    tail[4] = 'K'; tail[5] = 'G'; tail[6] = '1'; tail[7] = 10;
    for (i = 0; i < 8; i++) tail[8 + i] = (unsigned char)((pack_n >> (8 * i)) & 255);
    rb_put(&out, tail, 16);
    fd = sy_open(argv[4], O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (fd < 0) rb_die("write package");
    if (sy_write_all(fd, out.p, out.n) || sy_close(fd)) rb_die("write package");
    cx_sha256_hex(out.p, (size_t)out.n, sha);
    mm_free(out.p);
    mm_free(file);
    if (sy_mono(&t1)) rb_die("clock");
    rb_say("p3", sha, out.n, rb_span(&t0, &t1));
    return 0;
}

static char rb_rev_full[48];
static char rb_snap[RB_FULL];
static char rb_out_abs[RB_FULL];

static int rb_pipe(char **argv, const char *cwd, char *out, int cap) {
    int fd, pid, exited, code, bad, n;
    bad = 0;
    n = 0;
    pid = sy_spawn_pipe(argv, cwd, 0, &fd, 0);
    if (pid < 0) return -1;
    if (out && cap > 0) out[0] = 0;
    for (;;) {
        char tmp[512];
        long k, i;
        k = sy_read(fd, tmp, 512);
        if (k < 0) { bad = 1; break; }
        if (k == 0) break;
        if (out) {
            for (i = 0; i < k && n + 1 < cap; i++) out[n++] = tmp[i];
        }
    }
    if (out && cap > 0) {
        while (n > 0 && (out[n - 1] == 10 || out[n - 1] == 13)) n--;
        out[n] = 0;
    }
    if (sy_close(fd)) bad = 1;
    if (sy_wait_status(pid, 0, &exited, &code, 0) < 0) return -1;
    if (bad || !exited || code) return -1;
    return 0;
}

/* Replace *ROOT with the absolute snapshot of REV. Sources are that commit. */
static void rb_freeze(const char *rev, char **root_slot) {
    char root[RB_FULL], spec[96], dir[RB_FULL], mark[RB_FULL], cmd[2048], got[80], brief[11];
    char *vp[5], *sh[4];
    size_t mn;
    char *marker;
    int i, n;
    if (!rev || !rev[0] || !root_slot || !*root_slot) rb_die("rev");
    if (sy_realpath(*root_slot, root, RB_FULL) < 0) rb_die("root");
    if (cx_fmt(spec, sizeof spec, "%s^{commit}", rev)) rb_die("rev");
    vp[0] = "git";
    vp[1] = "rev-parse";
    vp[2] = "--verify";
    vp[3] = spec;
    vp[4] = 0;
    if (rb_pipe(vp, root, got, 80)) rb_die("rev");
    n = 0;
    while (got[n]) n++;
    if (n != 40) rb_die("rev");
    for (i = 0; i < 40; i++) {
        char c = got[i];
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) rb_die("rev");
        rb_rev_full[i] = c;
    }
    rb_rev_full[40] = 0;
    for (i = 0; i < 10; i++) brief[i] = rb_rev_full[i];
    brief[10] = 0;
    if (cx_fmt(dir, sizeof dir, "%s/out/release-snap-%s", root, brief)) rb_die("path");
    if (cx_fmt(mark, sizeof mark, "%s/.release-rev", dir)) rb_die("path");
    marker = cx_read(mark, &mn);
    if (!(marker && mn >= 40 && mm_same(marker, rb_rev_full, 40))) {
        if (marker) mm_free(marker);
        if (sy_exists(dir)) rb_die("snapshot exists without a matching rev marker");
        if (sy_mkdir(dir, 0755)) rb_die("snapshot mkdir");
        if (cx_fmt(cmd, sizeof cmd, "git archive %s | tar -x -C %s", rb_rev_full, dir)) rb_die("path");
        sh[0] = "sh";
        sh[1] = "-c";
        sh[2] = cmd;
        sh[3] = 0;
        if (rb_pipe(sh, root, 0, 0)) rb_die("git archive");
        {
            int fd = sy_open(mark, O_WRONLY | O_CREAT | O_TRUNC, 0644);
            if (fd < 0 || sy_write_all(fd, rb_rev_full, 40) || sy_close(fd)) rb_die("snapshot marker");
        }
    } else {
        mm_free(marker);
    }
    if (cx_fmt(cmd, sizeof cmd, "cp %s/unisacc.com %s/unisacc.com", root, dir)) rb_die("path");
    sh[0] = "sh";
    sh[1] = "-c";
    sh[2] = cmd;
    sh[3] = 0;
    if (rb_pipe(sh, root, 0, 0)) rb_die("copy compiler");
    n = 0;
    while (dir[n]) {
        if (n + 1 >= RB_FULL) rb_die("path");
        rb_snap[n] = dir[n];
        n++;
    }
    rb_snap[n] = 0;
    *root_slot = rb_snap;
    if (cx_fmt(cmd, sizeof cmd, "release-build\trev\t%s\tsnap=%s\n", rb_rev_full, rb_snap)) rb_die("report");
    sy_printf("%s", cmd);
}

static int rb_target_ok(int argc, char **argv) {
    int i;
    for (i = 5; i < argc; i++) {
        if (tx_eqz(argv[i], "--target")) {
            if (i + 1 >= argc || !tx_eqz(argv[i + 1], "lnx/x86_64")) rb_die("slice target");
        }
    }
    return 0;
}

static int rb_slice(int argc, char **argv) {
    char *v[80];
    char bound[RB_FULL], tool[RB_FULL];
    RbBuf cap;
    sy_ts_t t0, t1;
    int n, i, fd, pid, exited, code;
    char sha_line[160];
    if (argc < 5) rb_die("usage: slice ROOT PKG OUT [entry-build flags]");
    if (argc - 5 > 66) rb_die("argv");
    rb_target_ok(argc, argv);
    sy_mkdir(argv[4], 0755);
    if (sy_realpath(argv[4], rb_out_abs, RB_FULL) < 0) rb_die("out");
    argv[4] = rb_out_abs;
    if (sy_mono(&t0)) rb_die("clock");
    rb_cat(bound, RB_FULL, argv[2], 1, "tools/bound");
    rb_cat(tool, RB_FULL, argv[2], 1, "tools/entry-build.cx");
    n = 0;
    v[n++] = bound;
    v[n++] = "55";
    v[n++] = "sh";
    v[n++] = "unisacc.com";
    v[n++] = tool;
    v[n++] = "--";
    v[n++] = argv[2];
    v[n++] = argv[3];
    v[n++] = argv[4];
    for (i = 5; i < argc; i++) v[n++] = argv[i];
    v[n] = 0;
    pid = sy_spawn_pipe(v, argv[2], SY_SPAWN_NO_PATH, &fd, 0);
    if (pid < 0) rb_die("spawn");
    cap.p = 0;
    cap.n = 0;
    cap.cap = 0;
    for (;;) {
        char tmp[4096];
        long k = sy_read(fd, tmp, 4096);
        if (k < 0) rb_die("read child");
        if (k == 0) break;
        rb_put(&cap, tmp, k);
    }
    if (sy_close(fd)) rb_die("close child");
    if (sy_wait_status(pid, 0, &exited, &code, 0) < 0) rb_die("wait");
    rb_put(&cap, "", 1);
    sy_printf("%s", (char *)cap.p);
    mm_free(cap.p);
    if (sy_mono(&t1)) rb_die("clock");
    if (!exited || code) rb_die("entry-build");
    if (cx_fmt(sha_line, sizeof sha_line, "release-build\tslice\tns=%lld\trc=0\n", rb_span(&t0, &t1)))
        rb_die("report");
    sy_printf("%s", sha_line);
    {
        char rec[RB_FULL], line[80];
        int rfd;
        long ln;
        rb_cat(rec, RB_FULL, argv[4], 1, "receipt.txt");
        if (cx_fmt(line, sizeof line, "rev\t%s\n", rb_rev_full)) rb_die("report");
        ln = tx_len(line, 80);
        if (ln < 0) rb_die("report");
        rfd = sy_open(rec, O_WRONLY | O_CREAT | O_APPEND, 0644);
        if (rfd < 0 || sy_write_all(rfd, line, ln) || sy_close(rfd)) rb_die("receipt rev");
    }
    return 0;
}

int main(int argc, char **argv) {
    const char *rev = "HEAD";
    int i;
    if (argc >= 3 && tx_eqz(argv[1], "--rev")) {
        rev = argv[2];
        for (i = 1; i + 2 < argc; i++) argv[i] = argv[i + 2];
        argc -= 2;
        argv[argc] = 0;
    }
    if (argc >= 2 && (tx_eqz(argv[1], "p3") || tx_eqz(argv[1], "slice"))) {
        if (argc < 3) rb_die("root");
        rb_freeze(rev, &argv[2]);
    }
    if (argc >= 2 && tx_eqz(argv[1], "p3")) return rb_p3(argc, argv);
    if (argc >= 2 && tx_eqz(argv[1], "slice")) return rb_slice(argc, argv);
    sy_eprintf("usage: [--rev REV] p3 ROOT SRC_PKG OUT_PKG | slice ROOT PKG OUT [entry-build flags]\n");
    return 2;
}
