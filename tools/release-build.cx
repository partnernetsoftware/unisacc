/* Release chain for one slice at a time.
   sh ./unisacc.com tools/release-build.cx -- [--rev REV] p3 ROOT SRC_PKG OUT_PKG
   sh ./unisacc.com tools/release-build.cx -- [--rev REV] slice ROOT PKG OUT [--target TARGET] [--whole-phase A|B]

   p3 writes P 4 by default (every \0hdr/ header deflated, 2.04MB -> 1.44MB,
   46.33s vs 46.98s); --no-compress-resources writes the input's version
   unchanged (P3, raw F rows) for the fixed-P3 consumers in tests/batches.tsv.
   --no-compress-flat keeps cx-flat.h raw while the rest still compresses.

   REV defaults to HEAD. Sources and include/ come from `git archive` of that
   commit (out/release-snap-<sha10>/, reused when the marker matches), not from
   the shared worktree. The installed ROOT/unisacc.com is copied in as the
   generation-1 constructor. The receipt records the full rev.

   p3 keeps the model bytes of SRC_PKG and replaces every \0hdr/ resource with
   the files under the snapshot's include/ (seed/pack.c mount order). The
   resource \0hdr/cx-flat.h must then match that include/cx-flat.h byte for
   byte. Models are not rebuilt and package-refresh is not called.

   slice has two routes. whole-o (osx, win) defaults to one child under an
   internal 60s watchdog. Explicit --whole-phase A|B runs exactly one child:
   A has 45s to write native frames, B has 50s to write the image. Both require
   UNISACC_CTOR and UNISACC_IDENTITY_HELPER (native CTX F-v2 helper: ROOT ->
   64 lowercase hex digits plus LF). UNISA_CONTAINER is the supplied PKG.
   OUT/slice-<os>-<arch>.phase is unchanged compiler-native data. Its successful
   A.receipt binds frame/package/constructor/helper SHA, target, physical root,
   frozen revision and F-v2 source identities; B recomputes them before use.
   Per-target A/B receipts record actual child ns and SHA. A never writes the
   final slice; failed phases remove partial images and failed A invalidates
   its frames/readiness. objects (lnx) retains the entry-build route and receipt.
   This does not install and does not wrap. */
#pragma unisa use runtime.package_decode
#pragma unisa use runtime.package_lifetime
#pragma unisa use cxlib.packagefooter
#pragma unisa use runtime.model_number
#pragma unisa use compiler.bindstage
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sys.io
#pragma unisa use sys.sig
#pragma unisa use sys.time
#pragma unisa use sysx.poll
#pragma unisa use text.text
#pragma unisa use text.deflate
#pragma unisa use runtime.codec
#pragma unisa use cxlib.netwire
#pragma unisa use cxlib.productpkg

#define RB_FILES 128
#define RB_REL 192
#define RB_FULL 512
/* objects route whole-run hang ceiling (ms). entry-build already bounds each
   child (compile 55, link 45, plan 50); this is only the outer "the whole
   entry-build never finishes" guard, not a per-job limit. */
#define RB_OBJ_DEADLINE_MS 240000
/* Complete 44-root whole-o job: at most 60s, including child output capture.
   The dispatcher owns this watchdog and kills/reaps the child's process group
   before removing a partial image. Test overrides can only shorten the cap. */
#define RB_WHOLE_DEADLINE_MS 60000

/* The whole-o ceiling is overridable only so a test can shrink it and watch the
   timeout path actually fire; a production run never sets it. */
static long rb_whole_deadline(void) {
    const char *v = sy_env("UNISACC_RB_WHOLE_MS");
    long ms = 0;
    const char *p;
    if (!v || !v[0]) return RB_WHOLE_DEADLINE_MS;
    for (p = v; *p >= '0' && *p <= '9'; p++) ms = ms * 10 + (*p - '0');
    if (*p || ms < 1 || ms > RB_WHOLE_DEADLINE_MS) return RB_WHOLE_DEADLINE_MS;
    return ms;
}

typedef struct { unsigned char *p; long n, cap; } RbBuf;
typedef struct { char rel[RB_REL]; char full[RB_FULL]; } RbFile;

static RbFile rb_files[RB_FILES];
static int rb_nfiles;

static char rb_phase_cleanup_image[RB_FULL], rb_phase_cleanup_ready[RB_FULL], rb_phase_cleanup_frame[RB_FULL];
static void rb_die(const char *s) {
    if (rb_phase_cleanup_image[0]) sy_unlink(rb_phase_cleanup_image);
    if (rb_phase_cleanup_ready[0]) sy_unlink(rb_phase_cleanup_ready);
    if (rb_phase_cleanup_frame[0]) sy_unlink(rb_phase_cleanup_frame);
    sy_eprintf("release-build: %s\n", s);
    sy_exit(1);
}

static void *rb_alloc(void *p, size_t n) { return mm_grow(p, (long)n); }
static void rb_drop(void *p) { mm_free(p); }

static void rb_put(RbBuf *b, const void *s, long n) {
    long c;
    unsigned char *g;
    if (n < 0 || (n > 0 && !s)) rb_die("put");
    if (n == 0) return;
    if (b->n > 2147483647L - n) rb_die("put");
    c = b->cap;
    while (c < b->n + n) {
        if (c > 1073741823L) rb_die("put");
        c = c ? c * 2 : 4096;
    }
    if (c != b->cap) {
        g = (unsigned char *)mm_grow(b->p, c);
        if (!g) rb_die("out of memory");
        b->p = g;
        b->cap = c;
    }
    if (mm_copy(b->p + b->n, b->cap - b->n, s, n)) rb_die("put");
    b->n += n;
}

static long long rb_span(const sy_ts_t *a, const sy_ts_t *b) {
    return (long long)(b->sec - a->sec) * 1000000000LL + (long long)(b->nsec - a->nsec);
}

static void rb_cat(char *dst, int cap, const char *a, int slash, const char *b) {
    int i = 0, j = 0;
    if (!a || !b) rb_die("path");
    while (a[i]) {
        if (i + 1 >= cap) rb_die("path");
        dst[i] = a[i];
        i++;
    }
    if (slash) {
        if (i + 1 >= cap) rb_die("path");
        dst[i++] = '/';
    }
    while (b[j]) {
        if (i + 1 >= cap) rb_die("path");
        dst[i++] = b[j++];
    }
    dst[i] = 0;
}

static int rb_cmp(const char *a, const char *b) {
    for (;;) {
        int ea = !*a || *a == '/';
        int eb = !*b || *b == '/';
        unsigned char ca, cb;
        if (ea && eb) {
            if (!*a && !*b) return 0;
            if (!*a) return -1;
            if (!*b) return 1;
            a++;
            b++;
            continue;
        }
        if (ea) return -1;
        if (eb) return 1;
        ca = (unsigned char)*a;
        cb = (unsigned char)*b;
        if (ca != cb) return ca < cb ? -1 : 1;
        a++;
        b++;
    }
}

static void rb_sort(void) {
    int i, j;
    for (i = 1; i < rb_nfiles; i++) {
        RbFile key = rb_files[i];
        j = i;
        while (j > 0 && rb_cmp(rb_files[j - 1].rel, key.rel) > 0) {
            rb_files[j] = rb_files[j - 1];
            j--;
        }
        rb_files[j] = key;
    }
}

static void rb_add(const char *full, const char *rel) {
    long n;
    if (rb_nfiles == RB_FILES) rb_die("include tree");
    n = tx_len(rel, RB_REL);
    if (n < 0) rb_die("include name");
    rb_cat(rb_files[rb_nfiles].rel, RB_REL, rel, 0, "");
    rb_cat(rb_files[rb_nfiles].full, RB_FULL, full, 0, "");
    rb_nfiles++;
}

static void rb_walk(const char *full, const char *rel, int depth) {
    char names[8192];
    char child_full[RB_FULL], child_rel[RB_REL];
    int fd, count, i, at;
    sy_stat_t st;
    if (depth > 8) rb_die("include depth");
    fd = sy_open(full, O_RDONLY, 0);
    if (fd < 0) rb_die("include open");
    count = sy_dir_names(fd, names, (int)sizeof names);
    if (sy_close(fd)) rb_die("include close");
    if (count < 0) rb_die("include names");
    at = 0;
    for (i = 0; i < count; i++) {
        long n = tx_len(names + at, 256);
        if (n < 0) rb_die("include name");
        rb_cat(child_full, RB_FULL, full, 1, names + at);
        rb_cat(child_rel, RB_REL, rel, rel[0] ? 1 : 0, names + at);
        if (sy_lstat(child_full, &st)) rb_die("include stat");
        if (st.kind == 'd') rb_walk(child_full, child_rel, depth + 1);
        else if (st.kind == 'f') rb_add(child_full, child_rel);
        at += (int)n + 1;
    }
}

static int rb_hdr(const unsigned char *name, int n) {
    static const unsigned char p[5] = {0, 'h', 'd', 'r', '/'};
    return n >= 5 && mm_same(name, p, 5);
}

static int rb_flat_key(const unsigned char *name, int n) {
    static const unsigned char k[14] = {
        0, 'h', 'd', 'r', '/', 'c', 'x', '-', 'f', 'l', 'a', 't', '.', 'h'
    };
    return n == 14 && mm_same(name, k, 14);
}

static long rb_res_at(const unsigned char *b, const CxPackage *p) {
    int name, i;
    if (p->nr <= 0) return p->n;
    name = p->res[0].name;
    if (name < 2 || b[name - 1] != 10) return -1;
    i = name - 2;
    while (i >= 0 && b[i] >= '0' && b[i] <= '9') i--;
    if (i < 0 || b[i] != ' ') return -1;
    i--;
    while (i >= 0 && b[i] >= '0' && b[i] <= '9') i--;
    if (i < 0 || b[i] != ' ') return -1;
    i--;
    if (i < 0 || b[i] != 'F') return -1;
    return i;
}

/* 3-word F row (raw): copy an existing resource verbatim. */
static void rb_emit_raw(RbBuf *o, const unsigned char *name, long nlen, const unsigned char *data, long dlen) {
    char line[64];
    long n;
    if (cx_fmt(line, sizeof line, "F %ld %ld\n", nlen, dlen)) rb_die("resource line");
    n = tx_len(line, 64);
    if (n < 0) rb_die("resource line");
    rb_put(o, line, n);
    rb_put(o, name, nlen);
    if (dlen) rb_put(o, data, dlen);
}

/* 5-word F row verbatim: carry an existing resource's rawlen/codec/crc unchanged. */
static void rb_emit_verbatim(RbBuf *o, const unsigned char *name, long nlen, const unsigned char *data, long dlen, long rawlen, int codec, unsigned crc) {
    char line[96];
    long n;
    if (cx_fmt(line, sizeof line, "F %ld %ld %ld %d %u\n", nlen, dlen, rawlen, codec, crc)) rb_die("resource line");
    n = tx_len(line, sizeof line);
    if (n < 0) rb_die("resource line");
    rb_put(o, line, n);
    rb_put(o, name, nlen);
    if (dlen) rb_put(o, data, dlen);
}

/* 5-word F row (raw or deflated). pack==1 deflates DATA via dz_deflate and writes
   codec=1 with the CRC32; otherwise writes codec=0, rawlen=dlen, crc=0. When
   deflate does not shrink (fixed overhead), it falls back to raw. */
static void rb_emit_packed(RbBuf *o, const unsigned char *name, long nlen, const unsigned char *data, long dlen, int pack) {
    char line[96];
    unsigned char *comp = 0;
    long cap, cn = -1, n;
    unsigned long crc = 0;
    if (pack && dlen > 0) {
        cap = dz_bound(dlen);
        comp = mm_alloc(cap);
        if (!comp) rb_die("deflate alloc");
        cn = dz_deflate(data, dlen, comp, cap);
        if (cn < 0) { mm_free(comp); rb_die("deflate"); }
        if (cn <= 0 || cn >= dlen) { mm_free(comp); comp = 0; cn = -1; }
        else crc = dz_crc32(0, data, dlen);
    }
    if (cn > 0) { if (cx_fmt(line, sizeof line, "F %ld %ld %ld 1 %lu\n", nlen, cn, dlen, crc)) rb_die("resource line"); }
    else        { if (cx_fmt(line, sizeof line, "F %ld %ld %ld 0 0\n", nlen, dlen, dlen)) rb_die("resource line"); }
    n = tx_len(line, sizeof line);
    if (n < 0) rb_die("resource line");
    rb_put(o, line, n);
    rb_put(o, name, nlen);
    rb_put(o, cn > 0 ? comp : data, cn > 0 ? cn : dlen);
    if (comp) mm_free(comp);
}

static void rb_say(const char *kind, const char *sha, long bytes, long long ns) {
    char line[160];
    if (cx_fmt(line, sizeof line, "release-build\t%s\tsha=%s\tbytes=%ld\tns=%lld\n", kind, sha, bytes, ns))
        rb_die("report");
    sy_printf("%s", line);
}
/* P3-OPGUARD: a net that uses an action the packaged kernel base predates (index >= RB_BASE_OPS,
   SBLOAD first) only enters the package when every \0kernel/<isa> resource equals what
   tools/kernel-route.cx assembles from this snapshot's exec/c/asm.  Arities come from the
   snapshot's exec/facts/core-ops.tsv (op index arity), the one source; nothing is copied here. */
#define RB_BASE_OPS 56
static int rb_ar[128], rb_nar;
static void rb_arity_load(const char *root) {
    char p[RB_FULL], *t; size_t n, i = 0; long f[3]; int nf;
    if (cx_fmt(p, sizeof p, "%s/exec/facts/core-ops.tsv", root)) rb_die("core-ops.tsv");
    if (!(t = cx_read(p, &n))) { if (sy_exists(p)) rb_die("core-ops.tsv"); return; }   /* older snapshot: executor has only the base ops */
    while (i < n) {
        if (t[i] == '#') { while (i < n && t[i] != '\n') i++; i++; continue; }
        while (i < n && t[i] != '\t' && t[i] != '\n') i++;            /* name */
        for (nf = 0; nf < 2 && i < n && t[i] == '\t'; nf++) { f[nf] = 0; i++; while (i < n && t[i] >= '0' && t[i] <= '9') f[nf] = f[nf] * 10 + (t[i++] - '0'); }
        if (nf == 2) { if (f[0] != rb_nar || rb_nar >= 128) rb_die("core-ops.tsv order"); rb_ar[rb_nar++] = (int)f[1]; }
        while (i < n && t[i] != '\n') i++; i++;
    }
    mm_free(t);
    if (rb_nar <= RB_BASE_OPS) rb_die("core-ops.tsv short");
}
static int rb_ops_known(void) { return rb_nar > 0; }
static long rb_num(const char *t, size_t n, size_t *i) {
    long v = 0; int neg = 0;
    while (*i < n && t[*i] == ' ') (*i)++;
    if (*i < n && t[*i] == '-') { neg = 1; (*i)++; }
    while (*i < n && t[*i] >= '0' && t[*i] <= '9') v = v * 10 + (t[(*i)++] - '0');
    return neg ? -v : v;
}
/* 1 when some Q action's opcode is >= RB_BASE_OPS. */
static int rb_net_new_op(const char *t, size_t n) {
    size_t i = 0;
    while (i < n) {
        if (i + 2 < n && t[i] == 'Q' && t[i + 1] == ' ' && t[i + 2] != 'C') {
            long c, a, op, k; i += 2; c = rb_num(t, n, &i); if (c < 0) c = -c;
            for (a = 0; a < c; a++) {
                op = rb_num(t, n, &i);
                if (op < 0 || op >= rb_nar) rb_die("net opcode outside core-ops.tsv");
                if (op >= RB_BASE_OPS) return 1;
                for (k = 0; k < rb_ar[op]; k++) (void)rb_num(t, n, &i);
            }
        }
        while (i < n && t[i] != '\n') i++; i++;
    }
    return 0;
}
static int rb_need_base;
static const char *rb_root;
/* Every \0kernel/<isa> resource of PKG must equal tools/kernel-route.cx's output from ROOT. */
static void rb_base_check(const char *root, const unsigned char *body, const CxPackage *pkg) {
    static const char *isa[2] = {"x86_64", "arm64"};
    char out[RB_FULL], bnd[RB_FULL], kf[RB_FULL]; int j, i; long nk;
    if (cx_fmt(out, sizeof out, "%s/out", root) || (sy_mkdir(out, 0755) && !sy_exists(out))) rb_die("opguard out");
    if (cx_fmt(out, sizeof out, "%s/out/p3-opguard-%d", root, sy_pid()) || cx_fmt(bnd, sizeof bnd, "%s/tools/bound", root)) rb_die("opguard path");
    { char *d[14] = {"sh", bnd, "55", "sh", "unisacc.com", "tools/kernel-route.cx", "--", (char *)root, out, "--isa", "x86_64", "--isa", "arm64", 0};
      if (rb_pipe(d, root, 0, 0)) rb_die("opguard kernel-route"); }
    for (j = 0; j < 2; j++) {
        size_t kn; char *kb; int hit = 0;
        if (cx_fmt(kf, sizeof kf, "%s/%s.kernel", out, isa[j]) || !(kb = cx_read(kf, &kn))) rb_die("opguard kernel read");
        nk = 8 + (long)strlen(isa[j]);
        for (i = 0; i < pkg->nr; i++) {
            const unsigned char *nm = body + pkg->res[i].name;
            if (pkg->res[i].n != nk || nm[0] || !mm_same(nm + 1, "kernel/", 7) || !mm_same(nm + 8, isa[j], nk - 8)) continue;
            hit = 1;
            if (pkg->res[i].codec || pkg->res[i].len != (long)kn || !mm_same(body + pkg->res[i].data, kb, (long)kn))
                rb_die("a net uses an action newer than the packaged kernel base; rebuild kernel/ (kernel-build) first");
        }
        mm_free(kb);
        if (!hit) rb_die("opguard: package has no kernel base");
    }
}

/* --nets 来源校验: <nets> 是 <ctx>/jobs; ctx 的 context.tsv 记 source SID,
   现测(bound 6 <ctx>/identity-helper <快照>)必须相同, 否则网来自已漂移的作业链。 */
static char rb_t1[RB_FULL];
static void rb_nets_guard(const char *nets, const char *root) {
    char ctx[RB_FULL], conf[RB_FULL], helper[RB_FULL], bnd[RB_FULL], got[80] = {0}, want[80] = {0};
    char *text, *v[6];
    size_t tn;
    long i, j;
    for (i = (long)strlen(nets); i > 1 && nets[i - 1] != '/'; i--) ;
    if (i <= 1 || i >= RB_FULL) rb_die("--nets path");
    if (mm_copy(ctx, RB_FULL, nets, i - 1)) rb_die("--nets path");
    ctx[i - 1] = 0;
    if (cx_fmt(conf, sizeof conf, "%s/context.tsv", ctx) || !(text = cx_read(conf, &tn))) rb_die("--nets context.tsv");
    for (i = 0; i + 7 < (long)tn; i++) {
        if ((i && text[i - 1] != '\n') || memcmp(text + i, "source\t", 7)) continue;
        for (j = 0, i += 7; i < (long)tn && text[i] != '\n' && j < 64; i++) want[j++] = text[i];
        want[j] = 0;
        break;
    }
    mm_free(text);
    if (tx_len(want, 80) != 64) rb_die("--nets context source");
    if (ctx[0] != '/') { long z = 0; char abs[RB_FULL]; if (sy_realpath(ctx, abs, RB_FULL) < 0) rb_die("--nets ctx"); while (abs[z] && z + 1 < RB_FULL) { ctx[z] = abs[z]; z++; } ctx[z] = 0; }
    if (cx_fmt(helper, sizeof helper, "%s/identity-helper", ctx)) rb_die("--nets path");
    if (cx_fmt(bnd, sizeof bnd, "%s/tools/bound", root)) rb_die("--nets path");
    v[0] = "sh"; v[1] = bnd; v[2] = "6"; v[3] = helper; v[4] = (char *)root; v[5] = 0;
    if (rb_pipe(v, root, got, 80)) rb_die("--nets sid probe");
    if (tx_len(got, 80) < 64 || memcmp(got, want, 64)) rb_die("--nets SID mismatch");
    /* T1: every net that enters the package is checked key by key against its own table. */
    if (cx_fmt(rb_t1, sizeof rb_t1, "%s.t1-net-check", ctx)) rb_die("--nets path");
    { char *c[9] = {"sh", bnd, "55", "sh", "unisacc.com", "tools/lab-loader/net-check.cx", "-o", rb_t1, 0};
      if (rb_pipe(c, root, 0, 0)) rb_die("--nets T1 checker build"); }
}

/* 从包内 D 段与 routes 表推出 model 索引 -> net 名。D 行是
   "D <route> <stage> <in> <out> <model>", routes.tsv 的 (route, stage) 指向网文件。
   两者同源, 故不另存静态表(静态表与 routes 漂移就是新的陈旧源)。 */
static int rb_route_names(const char *routes, const unsigned char *body, long ds, long de,
                          int m, char names[64][64]) {
    char *t, *q;
    size_t tn;
    long k, a;
    t = cx_read(routes, &tn);
    if (!t) return -1;
    {   long s0 = 0;
        while (s0 < (long)tn) { if (t[s0] == 10) t[s0] = 0; s0++; }
        t[tn] = 0;
    }
    for (k = ds; k < de; k = a + 1) {
        char d[512], rt[192], st[64], i1[64], i2[64];
        long mi = -1;
        for (a = k; a < de && body[a] != 10; a++) ;
        if (a - k >= (long)sizeof d) { mm_free(t); return -1; }
        if (mm_copy(d, (long)sizeof d, body + k, a - k)) { mm_free(t); return -1; }
        d[a - k] = 0;
        if (d[0] != 'D' || sscanf(d, "D %191s %63s %63s %63s %ld", rt, st, i1, i2, &mi) != 5) continue;
        if (mi < 0 || mi >= m) continue;
        for (q = t; q < t + tn; ) {
            char *f[5], *z = q;
            int nf = 0;
            while (*z && nf < 5) {
                f[nf++] = z;
                while (*z && *z != '\t') z++;
                if (*z) *z++ = 0;
            }
            if (nf == 5 && !strcmp(f[0], rt) && !strcmp(f[1], st)) {
                char *b2 = strrchr(f[4], '/');
                long n2 = 0;
                b2 = b2 ? b2 + 1 : f[4];
                while (b2[n2] && b2[n2] != '.' && n2 < 63) n2++;
                if (mm_copy(names[mi], 64, b2, n2)) { mm_free(t); return -1; }
                names[mi][n2] = 0;
                break;
            }
            while (q < t + tn && *q) q++;
            q++;
        }
        if (q >= t + tn) { mm_free(t); return -1; }
    }
    mm_free(t);
    return 0;
}

static void rb_emit_models(RbBuf *out, const unsigned char *body, const CxPackage *pkg,
                           long d_start, long m_start, const char *nets, const char *routes) {
    static char names[64][64];
    long at = m_start, i, k = d_start;
    if (pkg->m != 40 || pkg->m > 64) rb_die("--nets expects 40 model records");
    /* model 索引 -> net 名取自包内 D 段 + routes 表(两处同源), 不另存静态表。 */
    if (rb_route_names(routes, body, d_start, m_start, pkg->m, names)) rb_die("--nets routes");
    for (i = 0; i < pkg->m; i++) if (!names[i][0]) rb_die("--nets unbound model");
    for (i = 0; i < pkg->m; i++) {
        char path[RB_FULL], why[200], head[96];
        size_t tn, bn = 0;
        long cap, cn, rawlen, hs;
        unsigned long crc, stored = 0;
        char *text, *bin;
        unsigned char *comp;
        {   char tp[RB_FULL], np[RB_FULL], *c[4];
            if (cx_fmt(tp, sizeof tp, "%s/tbl-%s/result.tbl", nets, names[i]) || cx_fmt(np, sizeof np, "%s/net-%s/result.net", nets, names[i])) rb_die("nets path");
            c[0] = rb_t1; c[1] = tp; c[2] = np; c[3] = 0;
            if (rb_pipe(c, ".", 0, 0)) rb_die(np); }
        if (cx_fmt(path, sizeof path, "%s/net-%s/result.net", nets, names[i])) rb_die("nets path");
        text = cx_read(path, &tn);
        if (!text) rb_die(path);
        if (rb_ops_known() && rb_net_new_op(text, tn)) rb_need_base = 1;
        bin = nw_binary_net(text, tn, &bn, why, sizeof why);
        mm_free(text);
        if (!bin) rb_die(why[0] ? why : "net encode");
        rawlen = (long)bn;
        comp = mm_alloc(dz_bound(rawlen));
        if (!comp) rb_die("deflate alloc");
        cn = dz_deflate((const unsigned char *)bin, rawlen, comp, cap = dz_bound(rawlen));
        crc = dz_crc32(0, (const unsigned char *)bin, rawlen);
        mm_free(bin);
        if (cn <= 0) rb_die("deflate");
        if (cx_fmt(head, sizeof head, "M %ld %ld 1 %lu\n", cn, rawlen, crc)) rb_die("model line");
        rb_put(out, head, (long)strlen(head));
        rb_put(out, comp, cn);
        mm_free(comp);
        {   long k;
            for (hs = at; hs < pkg->n && body[hs] != 10; hs++) ;
            for (k = at; k < hs && k - at + 1 < (long)sizeof head; k++) head[k - at] = (char)body[k];
            head[k - at] = 0;
            if (hs >= pkg->n || sscanf(head, "M %lu", &stored) != 1 || stored <= 0) rb_die("model head");
            at = hs + 1 + (long)stored;
        }
    }
    if (rb_need_base) rb_base_check(rb_root, body, pkg);
}

static int rb_p3(int argc, char **argv) {
    size_t zn, fn;
    char *file, *flat, *inc;
    unsigned char *src;
    PackageFooter foot;
    CxPackageDecode dec, chk;
    CxPackage *pkg;
    RbBuf out;
    sy_ts_t t0, t1;
    char line[64], sha[65], incdir[RB_FULL];
    const unsigned char *body;
    long line_end, res_at, kept, i, pack_n;
    int fd, nr, compress, compress_flat, out_ver;
    const char *nets = 0, *routes = 0;
    unsigned char tail[16];
    compress = 1;
    /* Default packs every @hdr header including cx-flat.h (P4 is smaller and
       reads faster: 46.33s vs 46.98s wall, 2.04MB -> 1.44MB);
       --no-compress-resources falls back to P3, --no-compress-flat to
       non-flat only. */
    compress_flat = 1;
    {
        int ai;
        for (ai = 5; ai < argc; ai++) {
            if (tx_eqz(argv[ai], "--no-compress-resources")) { compress = 0; continue; }
            /* Accepted for scripts written before the default changed; a no-op now. */
            if (tx_eqz(argv[ai], "--compress-resources")) { compress = 1; continue; }
            if (tx_eqz(argv[ai], "--compress-flat")) { compress_flat = 1; continue; }
            if (tx_eqz(argv[ai], "--no-compress-flat")) { compress_flat = 0; continue; }
            if (tx_eqz(argv[ai], "--nets") && ai + 1 < argc) { nets = argv[++ai]; continue; }
            if (tx_eqz(argv[ai], "--routes") && ai + 1 < argc) { routes = argv[++ai]; continue; }
            rb_die("usage: p3 ROOT SRC_PKG OUT_PKG [--nets CTX_JOBS_DIR] [--no-compress-resources] [--no-compress-flat]");
        }
    }
    if (argc < 5) rb_die("usage: p3 ROOT SRC_PKG OUT_PKG [--no-compress-resources] [--no-compress-flat]");
    if (sy_mono(&t0)) rb_die("clock");
    file = cx_read(argv[3], &zn);
    if (!file || zn > 2147483647UL) rb_die("read package");
    src = (unsigned char *)file;
    if (!packagefooter_locate_bytes(src, (long)zn, &foot)) {
        /* Bare package: starts "P 3 " / "P 4 " with no UNIPKG1 footer. The
           whole file is the package; the output still gets a footer below. */
        if (zn < 4 || src[0] != 'P' || src[1] != ' ' ||
            !((src[2] == '3' || src[2] == '4') && src[3] == ' ')) rb_die("package footer");
        foot.file_size = (long)zn;
        foot.footer_offset = (long)zn;
        foot.package_offset = 0;
        foot.package_length = (long)zn;
        foot.certificate_offset = 0;
        foot.certificate_length = 0;
        foot.padding = 0;
    }
    if (foot.package_offset < 0 || foot.package_length <= 0) rb_die("package span");
    if (src[foot.package_offset] != 'P') rb_die("package mark");
    dec.bytes = 0;
    dec.length = 0;
    dec.at = 0;
    dec.allocate = rb_alloc;
    dec.release = rb_drop;
    dec.why = 0;
    mm_fill(&dec.package, (long)sizeof dec.package, 0, (long)sizeof dec.package);
    if (cxpk_decode(&dec, src + foot.package_offset, foot.package_length)) rb_die(dec.why ? dec.why : "decode");
    pkg = &dec.package;
    body = src + foot.package_offset;
    line_end = 0;
    while (line_end < pkg->n && body[line_end] != 10) line_end++;
    if (line_end >= pkg->n || line_end < 2 || body[0] != 'P') rb_die("package head");
    line_end++;
    res_at = rb_res_at(body, pkg);
    if (res_at < line_end || body[line_end] != 'D') rb_die("package body");
    rb_cat(incdir, RB_FULL, argv[2], 1, "include");
    rb_nfiles = 0;
    rb_walk(incdir, "", 0);
    if (!rb_nfiles) rb_die("empty include");
    rb_sort();
    kept = 0;
    for (i = 0; i < pkg->nr; i++) if (!rb_hdr(body + pkg->res[i].name, pkg->res[i].n)) kept++;
    nr = (int)kept + rb_nfiles;
    out_ver = compress ? 4 : pkg->ver;
    /* P4 means "supports the codec field", not "every row is compressed":
       the include/ headers below are deflated, but resources already in the
       package are carried verbatim (see the emit loop), so a P4 file can hold
       codec=0 rows. Default writes P4; --no-compress-resources keeps the
       input version for the fixed-P3 consumers in tests/batches.tsv. */
    if (cx_fmt(line, sizeof line, "P %d %d %d %d\n", out_ver, pkg->m, pkg->s, nr)) rb_die("package head");
    out.p = 0;
    out.n = 0;
    out.cap = 0;
    {
        long hn = tx_len(line, 64);
        if (hn < 0) rb_die("package head");
        rb_put(&out, line, hn);
    }
    if (nets) {
        if (!routes) rb_die("--nets needs --routes");
        /* D 段原样拷贝到 M 段起点, M 段由 rb_emit_models 重建. */
        long m_at = line_end;
        while (m_at < res_at && m_at < pkg->n && !(body[m_at] == 'M' && m_at + 1 < pkg->n && body[m_at + 1] == ' ')) m_at++;
        if (m_at >= res_at || body[m_at] != 'M') rb_die("--nets M section");
        rb_put(&out, body + line_end, m_at - line_end);
        rb_nets_guard(nets, argv[2]);
        rb_root = argv[2];
        rb_arity_load(argv[2]);
        rb_emit_models(&out, body, pkg, line_end, m_at, nets, routes);
    } else rb_put(&out, body + line_end, res_at - line_end);
    for (i = 0; i < pkg->nr; i++) {
        if (rb_hdr(body + pkg->res[i].name, pkg->res[i].n)) continue;
        /* Resources already in the package are carried as they are. P3->P4 only
           deflates the include/ headers this tool rewrites; an existing F row
           keeps codec 0 here, so a P4 package is not "every row compressed". */
        if (pkg->ver >= 4)
            rb_emit_verbatim(&out, body + pkg->res[i].name, pkg->res[i].n, body + pkg->res[i].data, pkg->res[i].len,
                             pkg->res[i].rawlen, pkg->res[i].codec, pkg->res[i].crc);
        else if (out_ver >= 4)
            rb_emit_packed(&out, body + pkg->res[i].name, pkg->res[i].n, body + pkg->res[i].data, pkg->res[i].len, 0);
        else
            rb_emit_raw(&out, body + pkg->res[i].name, pkg->res[i].n, body + pkg->res[i].data, pkg->res[i].len);
    }
    for (i = 0; i < rb_nfiles; i++) {
        unsigned char key[5 + RB_REL];
        char *bytes;
        long reln = tx_len(rb_files[i].rel, RB_REL);
        static const unsigned char pre[5] = {0, 'h', 'd', 'r', '/'};
        if (reln < 0 || 5 + reln > (long)sizeof key) rb_die("include name");
        if (mm_copy(key, (long)sizeof key, pre, 5)) rb_die("include name");
        if (reln && mm_copy(key + 5, (long)sizeof key - 5, rb_files[i].rel, reln)) rb_die("include name");
        bytes = cx_read(rb_files[i].full, &fn);
        if (!bytes) rb_die("include read");
        /* --no-compress-resources writes P3, whose F rows have no codec field:
           emit the header raw then. Otherwise pack (or fall back to raw when
           deflate does not shrink). */
        if (!compress)
            rb_emit_raw(&out, key, 5 + reln, (const unsigned char *)bytes, (long)fn);
        else
            rb_emit_packed(&out, key, 5 + reln, (const unsigned char *)bytes, (long)fn, fn > 0 && (compress_flat || !rb_flat_key(key, 5 + reln)));
        mm_free(bytes);
    }
    cxpl_release(pkg, rb_drop);
    chk.bytes = 0;
    chk.length = 0;
    chk.at = 0;
    chk.allocate = rb_alloc;
    chk.release = rb_drop;
    chk.why = 0;
    mm_fill(&chk.package, (long)sizeof chk.package, 0, (long)sizeof chk.package);
    if (cxpk_decode(&chk, out.p, out.n)) rb_die(chk.why ? chk.why : "redecode");
    rb_cat(incdir, RB_FULL, argv[2], 1, "include/cx-flat.h");
    flat = cx_read(incdir, &fn);
    if (!flat) rb_die("cx-flat.h");
    {
        int found = 0;
        CxPackage *c = &chk.package;
        for (i = 0; i < c->nr; i++) {
            if (!rb_flat_key(out.p + c->res[i].name, c->res[i].n)) continue;
            found = 1;
            if (c->res[i].codec == 1) {
                unsigned char *rb_raw;
                if (c->res[i].rawlen != (int)fn) rb_die("cx-flat.h mismatch");
                rb_raw = mm_alloc((long)fn);
                if (!rb_raw) rb_die("cx-flat.h alloc");
                if (cxcodec_inflate(rb_raw, (unsigned long)fn, out.p + c->res[i].data, (unsigned long)c->res[i].len)) {
                    mm_free(rb_raw);
                    rb_die("cx-flat.h inflate");
                }
                if (!mm_same(rb_raw, flat, (long)fn)) {
                    mm_free(rb_raw);
                    rb_die("cx-flat.h mismatch");
                }
                mm_free(rb_raw);
            } else {
                if ((long)fn != c->res[i].len || !mm_same(out.p + c->res[i].data, flat, (long)fn))
                    rb_die("cx-flat.h mismatch");
            }
        }
        if (!found) rb_die("cx-flat.h missing");
    }
    mm_free(flat);
    cxpl_release(&chk.package, rb_drop);
    pack_n = out.n;
    tail[0] = 'U'; tail[1] = 'N'; tail[2] = 'I'; tail[3] = 'P';
    tail[4] = 'K'; tail[5] = 'G'; tail[6] = '1'; tail[7] = 10;
    for (i = 0; i < 8; i++) tail[8 + i] = (unsigned char)((pack_n >> (8 * i)) & 255);
    rb_put(&out, tail, 16);
    fd = sy_open(argv[4], O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (fd < 0) rb_die("write package");
    if (sy_write_all(fd, out.p, out.n) || sy_close(fd)) rb_die("write package");
    cx_sha256_hex(out.p, (size_t)out.n, sha);
    mm_free(out.p);
    mm_free(file);
    if (sy_mono(&t1)) rb_die("clock");
    rb_say("p3", sha, out.n, rb_span(&t0, &t1));
    return 0;
}

static char rb_rev_full[48];
static char rb_snap[RB_FULL];
static char rb_out_abs[RB_FULL];
static char rb_pkg_abs[RB_FULL];
static char rb_physical_root[RB_FULL];

static int rb_pipe(char **argv, const char *cwd, char *out, int cap) {
    int fd, pid, exited, code, bad, n;
    bad = 0;
    n = 0;
    pid = sy_spawn_pipe(argv, cwd, 0, &fd, 0);
    if (pid < 0) return -1;
    if (out && cap > 0) out[0] = 0;
    for (;;) {
        char tmp[512];
        long k, i;
        k = sy_read(fd, tmp, 512);
        if (k < 0) { bad = 1; break; }
        if (k == 0) break;
        if (out) {
            for (i = 0; i < k && n + 1 < cap; i++) out[n++] = tmp[i];
        }
    }
    if (out && cap > 0) {
        while (n > 0 && (out[n - 1] == 10 || out[n - 1] == 13)) n--;
        out[n] = 0;
    }
    if (sy_close(fd)) bad = 1;
    if (sy_wait_status(pid, 0, &exited, &code, 0) < 0) return -1;
    if (bad || !exited || code) return -1;
    return 0;
}

/* Replace *ROOT with the absolute snapshot of REV. Sources are that commit. */
static void rb_freeze(const char *rev, char **root_slot) {
    char root[RB_FULL], spec[96], dir[RB_FULL], mark[RB_FULL], cmd[2048], got[80], brief[11];
    char *vp[5], *sh[4];
    size_t mn;
    char *marker;
    int i, n;
    if (!rev || !rev[0] || !root_slot || !*root_slot) rb_die("rev");
    if (sy_realpath(*root_slot, root, RB_FULL) < 0) rb_die("root");
    rb_cat(rb_physical_root, RB_FULL, root, 0, "");
    if (cx_fmt(spec, sizeof spec, "%s^{commit}", rev)) rb_die("rev");
    vp[0] = "git";
    vp[1] = "rev-parse";
    vp[2] = "--verify";
    vp[3] = spec;
    vp[4] = 0;
    if (rb_pipe(vp, root, got, 80)) rb_die("rev");
    n = 0;
    while (got[n]) n++;
    if (n != 40) rb_die("rev");
    for (i = 0; i < 40; i++) {
        char c = got[i];
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) rb_die("rev");
        rb_rev_full[i] = c;
    }
    rb_rev_full[40] = 0;
    for (i = 0; i < 10; i++) brief[i] = rb_rev_full[i];
    brief[10] = 0;
    if (cx_fmt(dir, sizeof dir, "%s/out/release-snap-%s", root, brief)) rb_die("path");
    if (cx_fmt(mark, sizeof mark, "%s/.release-rev", dir)) rb_die("path");
    marker = cx_read(mark, &mn);
    if (!(marker && mn >= 40 && mm_same(marker, rb_rev_full, 40))) {
        if (marker) mm_free(marker);
        if (sy_exists(dir)) rb_die("snapshot exists without a matching rev marker");
        if (sy_mkdir(dir, 0755)) rb_die("snapshot mkdir");
        if (cx_fmt(cmd, sizeof cmd, "git archive %s | tar -x -C %s", rb_rev_full, dir)) rb_die("path");
        sh[0] = "sh";
        sh[1] = "-c";
        sh[2] = cmd;
        sh[3] = 0;
        if (rb_pipe(sh, root, 0, 0)) rb_die("git archive");
        {
            int fd = sy_open(mark, O_WRONLY | O_CREAT | O_TRUNC, 0644);
            if (fd < 0 || sy_write_all(fd, rb_rev_full, 40) || sy_close(fd)) rb_die("snapshot marker");
        }
    } else {
        mm_free(marker);
    }
    /* Copy either the self-contained APE or the receipt-listed split product.
       The root-epoch record must retain the bytes matching THIS launcher;
       git archive carries neither the product nor its build record. */
    if (pp_copy_product(root, dir)) rb_die("copy compiler");
    if (cx_fmt(cmd, sizeof cmd, "cp %s/unisacc.com.build.json %s/unisacc.com.build.json", root, dir)) rb_die("path");
    sh[0] = "sh";
    sh[1] = "-c";
    sh[2] = cmd;
    sh[3] = 0;
    if (rb_pipe(sh, root, 0, 0)) rb_die("copy compiler");
    n = 0;
    while (dir[n]) {
        if (n + 1 >= RB_FULL) rb_die("path");
        rb_snap[n] = dir[n];
        n++;
    }
    rb_snap[n] = 0;
    *root_slot = rb_snap;
    if (cx_fmt(cmd, sizeof cmd, "release-build\trev\t%s\tsnap=%s\n", rb_rev_full, rb_snap)) rb_die("report");
    sy_printf("%s", cmd);
}

/* One entry per object entry-build compiles; keep the two lists equal. */
#define RB_WHOLE_SRC 44
static const char *rb_whole_src[RB_WHOLE_SRC] = {
    "src/unisacc.cx",
    "src/host.cx",
    "src/stages.cx",
    "src/runtime/routestep.cx",
    "src/runtime/stagehandoff.cx",
    "src/runtime/runexec.cx",
    "src/runtime/attribute_frame.cx",
    "src/bind.cx",
    "src/driver/cli.cx",
    "src/driver/compat.cx",
    "src/driver/route.cx",
    "src/driver/deps.cx",
    "src/driver/input.cx",
    "src/driver/args.cx",
    "src/driver/path.cx",
    "src/entrybind.cx",
    "src/runtime/memlayout.cx",
    "src/driveface.cx",
    "src/driveroute.cx",
    "src/compiler/cxmod.cx",
    "src/compiler/tapegate.cx",
    "src/compiler/fwdstub.cx",
    "src/executor.cx",
    "src/core/transition.cx",
    "src/runtime/codec.cx",
    "src/runtime/model_decode.cx",
    "src/runtime/model_number.cx",
    "src/packmodel.cx",
    "src/runtime/modelload.cx",
    "src/runtime/compiler/bindstage.cx",
    "src/entryexec.cx",
    "src/hostnative.cx",
    "src/compiler/tapelink.cx",
    /* entry-build compiles 44 objects (keys 0..43); whole-o must list the same
       set or the link misses symbols such as hs_file_note_set. Keep equal. */
    "src/drivelink.cx", "src/drivetapebin.cx", "src/driveargs.cx",
    "src/driveplan.cx", "src/driveutil.cx", "src/driveunits.cx",
    "src/driverun.cx", "src/hostout.cx", "src/hostres.cx",
    "src/runtime/rescache.cx", "src/drivestream.cx"
};

static int rb_is_whole(const char *t) {
    return tx_eqz(t, "osx/x86_64") || tx_eqz(t, "osx/arm64") || tx_eqz(t, "win/x86_64") || tx_eqz(t, "win/arm64");
}

/* lnx slices use the entry-build object route (67 objects, entry-build caps at 160 link inputs).
   osx/win stay whole-o; UNITOK2 cap is now 128 (9c8c45f366). */
static int rb_is_objects(const char *t) {
    return tx_eqz(t, "lnx/x86_64") || tx_eqz(t, "lnx/arm64");
}

static const char *rb_whole_slug(const char *t) {
    if (tx_eqz(t, "osx/x86_64")) return "slice-osx-x86_64";
    if (tx_eqz(t, "osx/arm64")) return "slice-osx-arm64";
    if (tx_eqz(t, "win/x86_64")) return "slice-win-x86_64";
    if (tx_eqz(t, "win/arm64")) return "slice-win-arm64";
    if (tx_eqz(t, "lnx/x86_64")) return "slice-lnx-x86_64";
    if (tx_eqz(t, "lnx/arm64")) return "slice-lnx-arm64";
    return 0;
}

/* --target value, or lnx/x86_64 when the flag is absent. */
static const char *rb_slice_target(int argc, char **argv) {
    const char *t = "lnx/x86_64";
    int i, seen = 0;
    for (i = 5; i < argc; i++) {
        if (!tx_eqz(argv[i], "--target")) continue;
        if (seen || i + 1 >= argc) rb_die("slice target");
        t = argv[i + 1];
        seen = 1;
    }
    return t;
}

static const char *rb_phase_option(int argc, char **argv) {
    const char *phase = 0;
    int i;
    for (i = 5; i < argc; i++) {
        if (tx_eqz(argv[i], "--target")) { i++; continue; }
        if (!tx_eqz(argv[i], "--whole-phase") || phase || i + 1 >= argc) rb_die("slice flags");
        phase = argv[++i];
        if (!tx_eqz(phase, "A") && !tx_eqz(phase, "B")) rb_die("whole phase A|B required");
    }
    return phase;
}
static void rb_whole_flags(int argc, char **argv) {
    int i;
    for (i = 5; i < argc; i++) {
        if (tx_eqz(argv[i], "--target") || tx_eqz(argv[i], "--whole-phase")) {
            if (i + 1 >= argc) rb_die("slice target");
            i++;
            continue;
        }
        rb_die("slice target");
    }
}

static void rb_wline(int fd, const char *s) {
    long n = tx_len(s, 240);
    if (n < 0 || sy_write_all(fd, s, n)) rb_die("receipt");
}

/* Read a child's stdout until it exits or the wall clock expires. Both routes
   that spawn a bounded child (whole-o and the objects route) use this one loop:
   poll, drain, reaped-check, deadline. On expiry the child's whole process group
   dies (sy_kill kills -pid then pid) and *timed_out is set; the caller decides
   what to unlink and what to print. Returns 0 on a clean exit, 1 on timeout. */
static int rb_wait_child(int pid, int fd, RbBuf *cap, long deadline_ms,
                         int *exited, int *code) {
    long long t0_ms = sy_now_ms();
    for (;;) {
        sy_pollfd_t pfd;
        long k;
        pfd.fd = fd;
        pfd.events = 1;   /* readable */
        pfd.revents = 0;
        if (sy_poll(&pfd, 1, 200) < 0) rb_die("poll");
        if (pfd.revents & 1) {
            char tmp[4096];
            k = sy_read(fd, tmp, 4096);
            if (k > 0) rb_put(cap, tmp, k);
            /* k==0 (EOF) or EAGAIN/EINTR: fall through to the reaped check */
        }
        *exited = 0;
        if (sy_wait_status(pid, 1, exited, code, 0) < 0) rb_die("wait");
        if (*exited) return 0;
        if (sy_now_ms() - t0_ms > deadline_ms) {
            sy_kill(pid);
            return 1;
        }
    }
}

/* One complete whole -o with the internal 60s watchdog. No P3 splicing. */
static int rb_whole(int argc, char **argv, const char *target) {
    char *v[2 + 2 + 4 + RB_WHOLE_SRC + 1];
    char bound[RB_FULL], image[RB_FULL], rec[RB_FULL], line[240];
    char srcs[RB_WHOLE_SRC][RB_FULL];
    char sha[65];
    const char *slug;
    RbBuf cap;
    sy_ts_t t0, t1;
    int n, i, fd, pid, exited, code, rfd;
    long bytes;
    size_t zn;
    char *img;
    slug = rb_whole_slug(target);
    if (!slug) rb_die("slice target");
    if (!argv[3] || !argv[3][0] || !sy_exists(argv[3])) rb_die("pkg");
    rb_whole_flags(argc, argv);
    /* whole-o compiles with the package this run just built, not the snapshot's
       launcher: without this the child resolves models from the frozen
       unisacc.com.dev package and e3 rejects on the first real source. */
    {   char wcont[RB_FULL];
        if (sy_realpath(argv[3], wcont, RB_FULL) < 0) rb_die("pkg");
        if (sy_setenv("UNISA_CONTAINER", wcont, 1)) rb_die("env");
    }
    sy_mkdir(argv[4], 0755);
    if (sy_realpath(argv[4], rb_out_abs, RB_FULL) < 0) rb_die("out");
    argv[4] = rb_out_abs;
    rb_cat(image, RB_FULL, argv[4], 1, slug);
    rb_cat(bound, RB_FULL, argv[2], 1, "tools/bound");
    if (sy_mono(&t0)) rb_die("clock");
    n = 0;
    /* The internal watchdog bounds the whole child and drains its output;
       timeout cleanup removes any partial image before reporting refusal. */
    /* osx/win whole-o must be able to compile with a generation candidate, not
     * only the installed root product: UNISACC_CTOR (the same variable the lnx
     * object route uses) names the compiler binary; unset keeps the historical
     * `sh unisacc.com` behaviour. */
    {
        const char *ctor = sy_env("UNISACC_CTOR");
        if (ctor && ctor[0]) {
            v[n++] = (char *)ctor;
        } else {
            v[n++] = "/bin/sh";
            v[n++] = "unisacc.com";
        }
    }
    v[n++] = "-b";
    v[n++] = (char *)target;
    v[n++] = "-o";
    v[n++] = image;
    for (i = 0; i < RB_WHOLE_SRC; i++) {
        rb_cat(srcs[i], RB_FULL, argv[2], 1, rb_whole_src[i]);
        v[n++] = srcs[i];
    }
    v[n] = 0;
    pid = sy_spawn_pipe(v, argv[2], SY_SPAWN_NO_PATH, &fd, 0);
    if (pid < 0) rb_die("spawn");
    if (sy_fd_nonblock(fd, 1)) rb_die("nonblock");
    cap.p = 0;
    cap.n = 0;
    cap.cap = 0;
    if (rb_wait_child(pid, fd, &cap, rb_whole_deadline(), &exited, &code)) {
        /* The child's whole group is dead. Say what happened first, then drop
           whatever half image it left behind (ENOENT is the normal case: the
           child was killed before it wrote the image). */
        int urc;
        sy_close(fd);
        if (cx_fmt(line, sizeof line, "release-build\twhole-o\ttarget=%s\ttimeout after %ldms\trc=1\n",
                   target, rb_whole_deadline()))
            rb_die("report");
        sy_printf("%s", line);
        urc = sy_unlink(image);
        if (urc && urc != -ENOENT) rb_die("timeout unlink");
        rb_die("whole-o timeout");
    }
    if (sy_close(fd)) rb_die("close child");
    rb_put(&cap, "", 1);
    sy_printf("%s", (char *)cap.p);
    mm_free(cap.p);
    if (sy_mono(&t1)) rb_die("clock");
    if (!exited || code) rb_die("whole-o");
    img = cx_read(image, &zn);
    if (!img || zn > 2147483647UL) rb_die("image");
    cx_sha256_hex(img, zn, sha);
    bytes = (long)zn;
    mm_free(img);
    rb_cat(rec, RB_FULL, argv[4], 1, "receipt.txt");
    rfd = sy_open(rec, O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (rfd < 0) rb_die("receipt");
    if (cx_fmt(line, sizeof line, "route\twhole-o\n")) rb_die("receipt");
    rb_wline(rfd, line);
    if (cx_fmt(line, sizeof line, "target\t%s\n", target)) rb_die("receipt");
    rb_wline(rfd, line);
    if (cx_fmt(line, sizeof line, "rev\t%s\n", rb_rev_full)) rb_die("receipt");
    rb_wline(rfd, line);
    if (cx_fmt(line, sizeof line, "image\t%s\n", slug)) rb_die("receipt");
    rb_wline(rfd, line);
    if (cx_fmt(line, sizeof line, "sha\t%s\n", sha)) rb_die("receipt");
    rb_wline(rfd, line);
    if (cx_fmt(line, sizeof line, "bytes\t%ld\n", bytes)) rb_die("receipt");
    rb_wline(rfd, line);
    if (cx_fmt(line, sizeof line, "ns\t%lld\n", rb_span(&t0, &t1))) rb_die("receipt");
    rb_wline(rfd, line);
    if (cx_fmt(line, sizeof line, "rc\t0\n")) rb_die("receipt");
    rb_wline(rfd, line);
    if (sy_close(rfd)) rb_die("receipt");
    if (cx_fmt(line, sizeof line, "release-build\twhole-o\ttarget=%s\tsha=%s\tbytes=%ld\tns=%lld\trc=0\n",
               target, sha, bytes, rb_span(&t0, &t1)))
        rb_die("report");
    sy_printf("%s", line);
    return 0;
}

/* The compiler owns native phase frames; receipts bind their actual bytes. */
static void rb_phase_hash(const char *path, char sha[65]) {
    size_t n;
    char *p = cx_read(path, &n);
    if (!p || !n) rb_die("phase identity file missing/empty");
    cx_sha256_hex(p, n, sha); mm_free(p);
}

static void rb_phase_source(const char *helper, const char *root, char sid[65]) {
    char before[65], after[65];
    char *v[3];
    RbBuf cap = {0, 0, 0};
    int pid, fd, exited = 0, code = 1, i, timed;
    rb_phase_hash(helper, before);
    v[0] = (char *)helper; v[1] = (char *)root; v[2] = 0;
    pid = sy_spawn_pipe(v, root, SY_SPAWN_NO_PATH, &fd, 0);
    if (pid < 0) rb_die("identity helper spawn");
    if (sy_fd_nonblock(fd, 1)) { sy_kill(pid); rb_die("identity helper pipe"); }
    timed = rb_wait_child(pid, fd, &cap, 8000, &exited, &code);
    if (sy_close(fd)) rb_die("identity helper close");
    rb_phase_hash(helper, after);
    if (timed || !exited || code || !tx_eqz(before, after) || cap.n != 65 || cap.p[64] != 10) rb_die("REFUSE F-v2 source identity");
    for (i = 0; i < 64; i++) {
        char c = cap.p[i];
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) rb_die("REFUSE source SID wire");
        sid[i] = c;
    }
    sid[64] = 0; mm_free(cap.p);
}

static void rb_phase_identity(char *text, int size, const char *root, const char *pkg,
                              const char *ctor, const char *helper, const char *target) {
    char source[65], physical[65], ph[65], ch[65], hh[65];
    rb_phase_source(helper, root, source); rb_phase_source(helper, rb_physical_root, physical);
    rb_phase_hash(pkg, ph); rb_phase_hash(ctor, ch); rb_phase_hash(helper, hh);
    if (cx_fmt(text, size, "whole-phase-v1\nroot\t%s\nsnapshot\t%s\nrev\t%s\ntarget\t%s\nsource_sid\t%s\nphysical_sid\t%s\npkg\t%s\npkg_sha\t%s\nctor\t%s\nctor_sha\t%s\nhelper\t%s\nhelper_sha\t%s\n",
               rb_physical_root, root, rb_rev_full, target, source, physical, pkg, ph, ctor, ch, helper, hh)) rb_die("phase identity overflow");
}

static int rb_phase(int argc, char **argv, const char *target) {
    char *v[RB_WHOLE_SRC + 6];
    char image[RB_FULL], frame[RB_FULL], ready[RB_FULL], rec[RB_FULL];
    char ctor[RB_FULL], helper[RB_FULL], srcs[RB_WHOLE_SRC][RB_FULL];
    char identity[4096], after[4096], record[4608], sha[65], frame_sha[65];
    const char *phase = rb_phase_option(argc, argv), *env;
    RbBuf cap = {0, 0, 0};
    sy_ts_t t0, t1;
    size_t zn, oldn;
    char *old, *img;
    long prefix, k;
    int n = 0, i, pid, fd, exited = 0, code = 1, timed, rfd, is_a = tx_eqz(phase, "A");
    rb_whole_flags(argc, argv);
    sy_mkdir(argv[4], 0755);
    if (sy_realpath(argv[4], rb_out_abs, RB_FULL) < 0) rb_die("out");
    rb_cat(image, RB_FULL, rb_out_abs, 1, rb_whole_slug(target));
    if (cx_fmt(frame, sizeof frame, "%s.phase", image) || cx_fmt(ready, sizeof ready, "%s.A.receipt", image) || cx_fmt(rec, sizeof rec, "%s.%s.receipt", image, phase)) rb_die("phase path");
    rb_cat(rb_phase_cleanup_image, RB_FULL, image, 0, "");
    rb_cat(rb_phase_cleanup_ready, RB_FULL, rec, 0, "");
    if (sy_unlink(image) && sy_exists(image)) rb_die("remove previous image");
    if (is_a) {
        rb_cat(rb_phase_cleanup_ready, RB_FULL, ready, 0, "");
        rb_cat(rb_phase_cleanup_frame, RB_FULL, frame, 0, "");
        if ((sy_unlink(ready) && sy_exists(ready)) || (sy_unlink(frame) && sy_exists(frame))) rb_die("invalidate phase A");
    } else if (sy_unlink(rec) && sy_exists(rec)) rb_die("invalidate phase B");
    env = sy_env("UNISACC_CTOR");
    if (!env || !env[0] || sy_realpath(env, ctor, RB_FULL) < 0) rb_die("explicit UNISACC_CTOR required");
    env = sy_env("UNISACC_IDENTITY_HELPER");
    if (!env || !env[0] || sy_realpath(env, helper, RB_FULL) < 0) rb_die("explicit UNISACC_IDENTITY_HELPER required");
    if (sy_realpath(argv[3], rb_pkg_abs, RB_FULL) < 0) rb_die("pkg");
    rb_phase_identity(identity, sizeof identity, argv[2], rb_pkg_abs, ctor, helper, target);
    if (!is_a) {
        rb_phase_hash(frame, frame_sha);
        if (cx_fmt(record, sizeof record, "%sframe_sha\t%s\nrc\t0\nns\t", identity, frame_sha)) rb_die("phase record");
        prefix = tx_len(record, sizeof record); old = cx_read(ready, &oldn);
        if (!old || oldn <= (size_t)(prefix + 1) || !mm_same(old, record, prefix)) rb_die("REFUSE phase A identity receipt");
        for (k = prefix; k < (long)oldn - 1; k++) if (old[k] < '0' || old[k] > '9') rb_die("REFUSE phase A wall evidence");
        if (old[oldn - 1] != 10) rb_die("REFUSE phase A receipt terminator");
        mm_free(old);
    }
    if (sy_setenv("UNISA_CONTAINER", rb_pkg_abs, 1) || sy_setenv("UNISACC_RUN_CACHE", "0", 1) || sy_setenv("UNISACC_PHASE", phase, 1)) rb_die("phase env");
    if (is_a) {
        if (sy_setenv("UNISACC_PHASE_OUT", frame, 1) || sy_unsetenv("UNISACC_PHASE_IN")) rb_die("phase env");
    } else if (sy_setenv("UNISACC_PHASE_IN", frame, 1) || sy_unsetenv("UNISACC_PHASE_OUT")) rb_die("phase env");
    v[n++] = ctor; v[n++] = "-b"; v[n++] = (char *)target; v[n++] = "-o"; v[n++] = image;
    for (i = 0; i < RB_WHOLE_SRC; i++) { rb_cat(srcs[i], RB_FULL, argv[2], 1, rb_whole_src[i]); v[n++] = srcs[i]; }
    v[n] = 0;
    if (sy_mono(&t0)) rb_die("clock");
    pid = sy_spawn_pipe(v, argv[2], SY_SPAWN_NO_PATH, &fd, 0);
    if (pid < 0) rb_die("phase spawn");
    if (sy_fd_nonblock(fd, 1)) { sy_kill(pid); rb_die("phase nonblock"); }
    timed = rb_wait_child(pid, fd, &cap, is_a ? 45000 : 50000, &exited, &code);
    if (sy_mono(&t1)) rb_die("clock");
    if (rb_span(&t0, &t1) > (is_a ? 45000000000LL : 50000000000LL)) timed = 1;
    if (sy_close(fd)) rb_die("phase close");
    rb_put(&cap, "", 1); sy_printf("%s", (char *)cap.p); mm_free(cap.p);
    sy_printf("release-build\twhole-phase\tphase=%s\ttarget=%s\tns=%lld\trc=%d\n", phase, target, rb_span(&t0, &t1), timed ? 124 : code);
    if (timed || !exited || code) rb_die("whole phase failed");
    rb_phase_identity(after, sizeof after, argv[2], rb_pkg_abs, ctor, helper, target);
    if (!tx_eqz(identity, after)) rb_die("phase inputs changed");
    rb_phase_hash(frame, sha);
    if (!is_a && !tx_eqz(sha, frame_sha)) rb_die("phase frame changed");
    if (is_a && sy_exists(image)) rb_die("phase A wrote final image");
    if (cx_fmt(record, sizeof record, "%sframe_sha\t%s\nrc\t0\nns\t%lld\n", identity, sha, rb_span(&t0, &t1))) rb_die("phase record");
    if (!is_a) {
        img = cx_read(image, &zn); if (!img || !zn) rb_die("phase image");
        cx_sha256_hex(img, zn, sha); mm_free(img);
        k = tx_len(record, sizeof record);
        if (cx_fmt(record + k, sizeof record - k, "image_sha\t%s\nbytes\t%ld\n", sha, (long)zn)) rb_die("phase image record");
    }
    rfd = sy_open(rec, O_WRONLY | O_CREAT | O_TRUNC, 0644); k = tx_len(record, sizeof record);
    if (rfd < 0 || sy_write_all(rfd, record, k) || sy_close(rfd)) rb_die("phase receipt write");
    rb_phase_cleanup_image[0] = rb_phase_cleanup_ready[0] = rb_phase_cleanup_frame[0] = 0;
    sy_printf("release-build\twhole-phase\tphase=%s\tsha=%s\tns=%lld\trc=0\n", phase, sha, rb_span(&t0, &t1));
    return 0;
}


static int rb_slice(int argc, char **argv) {
    char *v[80];
    char bound[RB_FULL], tool[RB_FULL];
    RbBuf cap;
    sy_ts_t t0, t1;
    int n, i, fd, pid, exited, code, is_elf = 0;
    char sha_line[160];
    const char *target;
    if (argc < 5) rb_die("usage: slice ROOT PKG OUT [--target TARGET]");
    if (argc - 5 > 66) rb_die("argv");
    target = rb_slice_target(argc, argv);
    if (rb_is_whole(target)) {
        if (rb_phase_option(argc, argv)) return rb_phase(argc, argv, target);
        return rb_whole(argc, argv, target);
    }
    for (i = 5; i < argc; i++) if (tx_eqz(argv[i], "--whole-phase")) rb_die("whole phase requires osx/win target");
    if (!rb_is_objects(target)) rb_die("slice target");
    if (sy_realpath(argv[3], rb_pkg_abs, RB_FULL) < 0) rb_die("pkg");
    argv[3] = rb_pkg_abs;
    sy_mkdir(argv[4], 0755);
    if (sy_realpath(argv[4], rb_out_abs, RB_FULL) < 0) rb_die("out");
    argv[4] = rb_out_abs;
    if (sy_mono(&t0)) rb_die("clock");
    rb_cat(tool, RB_FULL, argv[2], 1, "tools/entry-build.cx");
    {
        const char *ctor = sy_env("UNISACC_CTOR");
        unsigned char hdr[4];
        int cfd;
        if (!ctor || !ctor[0]) rb_die("UNISACC_CTOR (a constructor that links 96 inputs, e.g. the M4 candidate) is required for the lnx object route");
        cfd = sy_open(ctor, O_RDONLY, 0);
        if (cfd < 0) rb_die("UNISACC_CTOR open");
        if (sy_read_full(cfd, hdr, 4) || sy_close(cfd)) rb_die("UNISACC_CTOR read");
        is_elf = hdr[0] == 0x7f && hdr[1] == 'E' && hdr[2] == 'L' && hdr[3] == 'F';
        n = 0;
        if (!is_elf) v[n++] = "sh";
        v[n++] = (char *)ctor;
    }
    v[n++] = tool;
    v[n++] = "--";
    v[n++] = argv[2];
    v[n++] = argv[3];
    v[n++] = argv[4];
    /* pass the same constructor as entry-build's explicit constructor (its 4th
       positional arg) so the link itself runs under the 96-cap product, not
       the frozen 83343ec1 copy. */
    v[n++] = (char *)sy_env("UNISACC_CTOR");
    for (i = 5; i < argc; i++) v[n++] = argv[i];
    v[n] = 0;
    /* A bare-ELF constructor has no embedded package, so it finds one through UNISA_CONTAINER.
       entry-build's own children must use the package this run is building, not the installed
       one: set it here or the grandchild reports "package no package at <entry.elf>". */
    if (sy_setenv("UNISA_CONTAINER", argv[3], 1)) rb_die("env");
    /* APE constructors invoke sh through PATH; only direct ELF execution forbids lookup. */
    pid = sy_spawn_pipe(v, argv[2], is_elf ? SY_SPAWN_NO_PATH : 0, &fd, 0);
    if (pid < 0) rb_die("spawn");
    if (sy_fd_nonblock(fd, 1)) rb_die("nonblock");
    cap.p = 0;
    cap.n = 0;
    cap.cap = 0;
    if (rb_wait_child(pid, fd, &cap, RB_OBJ_DEADLINE_MS, &exited, &code)) {
        sy_close(fd);
        rb_die("objects route: entry-build deadline exceeded (hang)");
    }
    if (sy_close(fd)) rb_die("close child");
    /* the loop already reaped pid (nohang) and set exited/code on break */
    rb_put(&cap, "", 1);
    sy_printf("%s", (char *)cap.p);
    mm_free(cap.p);
    if (sy_mono(&t1)) rb_die("clock");
    if (!exited || code) rb_die("entry-build");
    if (cx_fmt(sha_line, sizeof sha_line, "release-build\tslice\tns=%lld\trc=0\n", rb_span(&t0, &t1)))
        rb_die("report");
    sy_printf("%s", sha_line);
    {
        char rec[RB_FULL], line[80];
        int rfd;
        long ln;
        rb_cat(rec, RB_FULL, argv[4], 1, "receipt.txt");
        if (cx_fmt(line, sizeof line, "rev\t%s\n", rb_rev_full)) rb_die("report");
        ln = tx_len(line, 80);
        if (ln < 0) rb_die("report");
        rfd = sy_open(rec, O_WRONLY | O_CREAT | O_APPEND, 0644);
        if (rfd < 0 || sy_write_all(rfd, line, ln) || sy_close(rfd)) rb_die("receipt rev");
    }
    return 0;
}

int main(int argc, char **argv) {
    const char *rev = "HEAD";
    int i;
    if (argc >= 3 && tx_eqz(argv[1], "--rev")) {
        rev = argv[2];
        for (i = 1; i + 2 < argc; i++) argv[i] = argv[i + 2];
        argc -= 2;
        argv[argc] = 0;
    }
    if (argc >= 2 && (tx_eqz(argv[1], "p3") || tx_eqz(argv[1], "slice"))) {
        if (argc < 3) rb_die("root");
        rb_freeze(rev, &argv[2]);
    }
    if (argc >= 2 && tx_eqz(argv[1], "p3")) return rb_p3(argc, argv);
    if (argc >= 2 && tx_eqz(argv[1], "slice")) return rb_slice(argc, argv);
    sy_eprintf("usage: [--rev REV] p3 ROOT SRC_PKG OUT_PKG | slice ROOT PKG OUT [entry-build flags]\n");
    return 2;
}
