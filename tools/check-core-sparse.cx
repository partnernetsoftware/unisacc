#pragma unisa use core.sparse
void core_host_panic(const char *s){fprintf(stderr,"unexpected panic: %s\n",s);exit(2);}
int main(void){
 CxSparse m={0};int failed=0;if(core_memory_get(&m,7)!=0)failed++;
 core_memory_set(&m,7,0);if(m.n!=1||m.cap!=65536||core_memory_get(&m,7)!=0)failed++;
 core_memory_set(&m,7,12);if(m.n!=1||core_memory_get(&m,7)!=12)failed++;
 core_memory_set(&m,-1,-9);if(m.n!=2||core_memory_get(&m,-1)!=-9)failed++;
 free(m.keys);free(m.values);free(m.used);printf("CXCORE_SPARSE failed=%d\n",failed);return failed?1:0;
}
