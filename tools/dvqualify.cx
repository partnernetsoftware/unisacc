/* dvqualify: strict evidence for one candidate APE in one command (devsvc qualify routes here).
 *   dvqualify ROOT --candidate APE [--set sample|product-qualification] [--ids A,B,..]
 *             [--out FILE | --resume FILE] [--jobs N] [--seed N] [--segment-batches N] [--list]
 *             (native runner preparation is opt-in via DVQUALIFY_NATIVE_RUN_BATCH=1)
 * (1) Precheck: APE is a regular file, its sha256, and `sh APE --version` actually run.
 * (2) Independent local layout per full candidate SHA and frozen HEAD under TMPDIR. One
 *     builder unpacks the named commit; each invocation has its own logs. unisacc.com is a real
 *     copy of APE (not a link), then `git init` plus one private commit so the git inventory of
 *     tests/tools-compile.cx works (v0.0.73 found rc 2 "git inventory failed" in a bare archive).
 *     A kit window timeout flushes a pending-batch checkpoint and permits one
 *     more material window under the same evidence lock before batches launch.
 *     Cold preparation can take up to two producer builds plus two 55 s windows.
 *     A caller capped at 55-58 s may interrupt the second attempt. Its flushed
 *     checkpoint permits --resume after process exit; it is not fsynced for power loss.
 * (3) Batch set: sample = the 12 named batches of the v0.0.73 strict evidence plus 10 random
 *     tools-compile shards (the seed is written to the evidence); product-qualification = every
 *     id of tests/batch-domain-index.tsv in that domain; --ids replaces the set. --list prints
 *     the set with its 55 s window number and runs nothing.
 * (4) Every batch is actually run in the layout root by
 *     `sh ./unisacc.com tools/affected.cx -- --ids ID --prepare-materials --run -j 1`
 *     (affected -> tests/run-batch.cx, default material path, product = ROOT/unisacc.com),
 *     outer limit 60 s per batch, at most --jobs (default 2) at once, launch waits (bounded
 *     120 s) while load1 > 6. The BATCH_RUN line is kept verbatim. candidate= must equal the APE
 *     sha256, else the batch is INVALID (evidence validity, not a product rejection). A batch
 *     without a BATCH_RUN line (timeout, crash) is UNKNOWN and is rerun once after load1 < 3
 *     (bounded wait 60 s) when the segment has retry budget. Each segment stops launching
 *     after 240 s and drains its active 60 s windows. Unresolved rows can be retried with
 *     --resume. Only a terminal row and its matching raw BATCH_RUN for this APE authorize
 *     skipping that batch. Use the same --seed to resume the same random sample.
 * (5) Evidence TSV to --out (default stdout): batch, domain, status, rc, candidate, ms, load1,
 *     retries, note; RAW rows follow their batch. Segment boundaries flush the file.
 *     A complete run writes SUMMARY. A time-limited partial run writes CHECKPOINT. With
 *     DEVSVC_SOCK set, each batch and the total emit a devsvc timing phase event (cmd=qualify).
 * Exit 0 when every batch has a valid PASS/FAIL result, 1 when any is UNKNOWN or INVALID,
 * 2 for usage or setup errors.
 * Check: tools/check-dvqualify.cx. */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use sys.proc
#pragma unisa use sys.posix
#pragma unisa use sys.sha
#pragma unisa use sys.net
#pragma unisa use sys.netraw
#pragma unisa use sysx.process
#pragma unisa use mem.bytes
#pragma unisa use cxlib.loadavg
#pragma unisa use cxlib.toolprep
#pragma unisa use cxlib.tlibpkg

#define MAXB 1024
#define WINDOW_S 60

typedef struct {
    char id[96], domain[48], status[16], cand[72], load[16], note[256], raw[600];
    int rc, retries; long ms;
} Batch;
static Batch bs[MAXB];
static int nb;
static int resumed[MAXB];
static char root[4096], lay[4096], ape[4096], sha[65], version[256], head[64], outlog[4200];
static const char *sockp, *job_id;
static char jobbuf[64];

/* The default native recipe erases these calls before compilation. The
 * instrumented recipe is selected once by the qualify client. */
#ifdef DVQUALIFY_S2_TAP
static int s2_fd = -1;
static unsigned s2_dropped;
static sy_addr_t s2_to;
static void s2_open(void) {
    int saved=errno;
    s2_to.family=SY_AF_UNIX;
    if(sockp && !strcmp(sy_env_or("DEVSVC_S2_SHADOW",""),"1") &&
       !cx_fmt(s2_to.path,sizeof s2_to.path,"%s.s2",sockp))
        s2_fd=sy_sock_open(sy_sock_num(SY_SN_AF_UNIX),sy_sock_num(SY_SN_SOCK_DGRAM)|O_NONBLOCK);
    errno=saved;
}
static void s2_emit(const char *kind,const Batch *b,int attempt,int pid,long now,double load) {
    int saved=errno;
    char wire[448];
    if(s2_fd>=0 && !cx_fmt(wire,sizeof wire,"kind=%s\tjob=%s\tid=%s\tcandidate=%s\tattempt=%d\tpid=%d\tms=%ld\tload1=%.2f\tdropped=%u",
                           kind,job_id,b->id,sha,attempt,pid,now,load,s2_dropped)){
        long n=strlen(wire);
        if(sy_udp_send_to(s2_fd,wire,n,&s2_to)==n){s2_dropped=0;errno=saved;return;}
    }
    if(s2_dropped!=UINT_MAX)s2_dropped++;
    errno=saved;
}
#endif

static const char *sample_ids[] = {"c-negative","pp-negative","pp-differential","pp-cli-targets",
    "pp-cli-macros","pp-cli-includes","pp-header-locations","pp-targets-lines","c99-whitespace",
    "unit-frontcache-budget","run-warm","cx-driver-cli",0};

static int die(const char *a, const char *b) { fprintf(stderr, "QUALIFY_FAIL\t%s%s\n", a, b ? b : ""); return 2; }
#ifdef DVQUALIFY_GATE_FIXTURE
/* Only the separately compiled test image supplies scripted observations. */
static double gate_load(void) {
    static int samples;
    const char *scenario=sy_env_or("QG_CASE","");
    samples++;
    if (!strcmp(scenario,"boundary")) return 6.0;
    if (!strcmp(scenario,"drops") && samples>1) return 5.0;
    if (!strcmp(scenario,"retry") && samples==1) return 0.0;
    if (!strcmp(scenario,"retry-boundary")) return samples==1?0.0:3.0;
    return 9.0;
}
static long gate_time(long now) { return now*3000L; }
#else
#define gate_load() tool_load1()
#define gate_time(now) (now)
#endif
static int run(char **v, const char *cwd, int secs, char *out, int cap) {
    np_result r = {0}; char why[300];
    if (np_run(v, cwd, 0, secs, &r, why, sizeof why)) { fprintf(stderr, "QUALIFY_EXEC\t%s\t%s\n", v[0], why); return -1; }
    if (out && cap > 0) { long k = (long)r.outn < cap - 1 ? (long)r.outn : cap - 1; if (k > 0) mm_copy(out, cap, r.out, k); out[k > 0 ? k : 0] = 0; }
    if (r.rc) fprintf(stderr, "QUALIFY_STEP\t%s rc=%d\t%.*s\n", v[0], r.rc, (int)(r.errn > 300 ? 300 : r.errn), r.err ? r.err : "");
    int rc = r.rc; np_free(&r); return rc;
}
static void field(const char *line, const char *key, char *dst, int cap) {
    char k[40]; cx_fmt(k, sizeof k, "\t%s=", key); dst[0] = 0;
    const char *p = strstr(line, k); if (!p) return; p += strlen(k);
    long n = 0; while (p[n] && p[n] != '\t' && p[n] != '\n') n++;
    if (n >= cap) n = cap - 1; mm_copy(dst, cap, p, n); dst[n] = 0;
}
static void add(const char *id) {
    for (int i = 0; i < nb; i++) if (!strcmp(bs[i].id, id)) return;
    if (nb < MAXB && strlen(id) < sizeof bs[0].id) { memset(&bs[nb], 0, sizeof bs[nb]); cx_fmt(bs[nb].id, sizeof bs[nb].id, "%s", id); cx_fmt(bs[nb].domain, sizeof bs[nb].domain, "-"); nb++; }
}
/* Walk a TSV under ROOT; call fn(col0, col1) for each data row. */
static int each_row(const char *rel, void (*fn)(char *, char *, void *), void *ud) {
    char p[4300]; unsigned char *b = 0; int64_t n = 0;
    if (cx_fmt(p, sizeof p, "%s/%s", root, rel) || sy_read_file(p, &b, &n, 64L << 20) || !b) return 1;
    char *s = (char *)b, *end = s + n;
    while (s < end) {
        char *e = memchr(s, '\n', end - s); if (!e) e = end; *e = 0;
        if (*s && *s != '#') { char *t = strchr(s, '\t'), *c1 = ""; if (t) { *t = 0; c1 = t + 1; char *t2 = strchr(c1, '\t'); if (t2) *t2 = 0; } fn(s, c1, ud); }
        s = e + 1;
    }
    free(b); return 0;
}
static char shards[512][96]; static int nshard;
static void take_shard(char *id, char *c1, void *ud) {
    (void)c1; (void)ud; long n = strlen(id);
    if (n > 14 && !strncmp(id, "tools-compile-", 14) && nshard < 512) { for (long i = 14; i < n; i++) if (id[i] < '0' || id[i] > '9') return; cx_fmt(shards[nshard++], 96, "%s", id); }
}
static void take_domain(char *id, char *c1, void *ud) { if (!strcmp(c1, (const char *)ud) && strcmp(id, "id")) add(id); }
static void set_domain(char *id, char *c1, void *ud) {
    (void)ud; for (int i = 0; i < nb; i++) if (!strcmp(bs[i].id, id)) cx_fmt(bs[i].domain, sizeof bs[i].domain, "%s", c1);
}
static void emit(const char *phase, long ms, int rc, const char *ld) {
    if (!sockp || !*sockp) return;
    char msg[600]; int n = snprintf(msg, sizeof msg, "emit\tphase\tcmd=qualify\tphase=%s\tms=%ld\tinput=%s\trc=%d\tload1=%s\tjob=%s\n", phase, ms, head[0] ? head : "unknown", rc, ld, job_id);
    if (n <= 0 || n >= (int)sizeof msg) return;
    int fd = sy_unix_connect(sockp, 250); if (fd < 0) return;
    sy_send(fd, msg, n); char r[64]; sy_recv(fd, r, sizeof r); sy_close(fd);
}

/* Classify one finished attempt from its captured output. */
static void classify(Batch *b, const char *path, int timed_out, int code) {
    unsigned char *buf = 0; int64_t n = 0; char want[120], rundir[1024] = "";
    b->raw[0] = 0; b->rc = code; b->cand[0] = 0;
    cx_fmt(want, sizeof want, "BATCH_RUN\tid=%s\t", b->id);
    if (!sy_read_file(path, &buf, &n, 16L << 20) && buf) {
        char *s = (char *)buf, *end = s + n;
        while (s < end) {
            char *e = memchr(s, '\n', end - s); if (!e) e = end; *e = 0;
            if (!strncmp(s, want, strlen(want))) cx_fmt(b->raw, sizeof b->raw, "%s", s);
            if (!strncmp(s, "RUN_DIR\t", 8)) { char *t = strchr(s + 8, '\t'); long k = t ? t - (s + 8) : (long)strlen(s + 8); if (k < (long)sizeof rundir) { mm_copy(rundir, sizeof rundir, s + 8, k); rundir[k] = 0; } }
            s = e + 1;
        }
    }
    free(buf);
    b->note[0] = 0;
    if (!b->raw[0]) { cx_fmt(b->status, sizeof b->status, "UNKNOWN"); cx_fmt(b->note, sizeof b->note, timed_out ? "outer-timeout-60s" : "no-BATCH_RUN rc=%d", code); return; }
    char st[16], rc[16]; field(b->raw, "status", st, sizeof st); field(b->raw, "rc", rc, sizeof rc); field(b->raw, "candidate", b->cand, sizeof b->cand);
    b->rc = atoi(rc);
    if (strcmp(b->cand, sha)) { cx_fmt(b->status, sizeof b->status, "INVALID"); cx_fmt(b->note, sizeof b->note, "candidate-mismatch expected=%s", sha); return; }
    cx_fmt(b->status, sizeof b->status, "%s", st[0] ? st : "UNKNOWN");
    if (!strcmp(b->status, "UNKNOWN")) {
        char transport[16];
        field(b->raw, "transport", transport, sizeof transport);
        if (!strcmp(transport, "-1")) {
            cx_fmt(b->note, sizeof b->note, "transport-failed-raw-neg1");
            return;
        }
    }
    if (rundir[0]) {   /* case counts the batch printed (TAG<TAB>pass=N<TAB>fail=M), kept as a note only */
        char lp[1200]; unsigned char *lb = 0; int64_t ln = 0;
        if (!cx_fmt(lp, sizeof lp, "%s/%s.log", rundir, b->id) && !sy_read_file(lp, &lb, &ln, 16L << 20) && lb) {
            char *s = (char *)lb, *end = s + ln, pass[16] = "", fail[16] = "";
            while (s < end) { char *e = memchr(s, '\n', end - s); if (!e) e = end; *e = 0;
                char *t = strstr(s, "\tpass="); if (t && strstr(t, "\tfail=")) { field(t, "pass", pass, sizeof pass); field(t, "fail", fail, sizeof fail); }
                s = e + 1; }
            if (pass[0]) cx_fmt(b->note, sizeof b->note, "count=%s/%s", pass, fail);
        }
        free(lb);
    }
}

typedef struct { sy_child_t c; int idx; long t0; int fd; } Slot;
static int use_native;
static char layout_product[4400];
static char prepared_affected[4400];
static char *argvs[MAXB][13];
static int launch(Slot *s, int idx, int attempt) {
    Batch *b = &bs[idx];
    b->raw[0]=0;b->note[0]=0;b->cand[0]=0;b->ms=0;
    char path[4400]; cx_fmt(path, sizeof path, "%s/%s.%d.out", outlog, b->id, attempt);
    int fd = sy_open_new(path, 0600);
    if (fd < 0) { b->rc=fd;cx_fmt(b->note,sizeof b->note,"log-open-failed rc=%d",fd);return 1; }
    char **v = argvs[idx]; int n = 0;
    if(prepared_affected[0])v[n++]=prepared_affected;
    else {v[n++] = "sh"; v[n++] = layout_product; v[n++] = "tools/affected.cx"; v[n++] = "--";}
    v[n++] = "--ids"; v[n++] = b->id;
    if(use_native) v[n++]="--native-run-batch";
    v[n++] = "--prepare-materials"; v[n++] = "--run"; v[n++] = "-j"; v[n++] = "1"; v[n] = 0;
    sy_spawn_t o; sy_spawn_init(&o); o.argv = v; o.cwd = lay; o.in_fd = SY_STDIO_NULL; o.out_fd = fd; o.err_fd = fd;
    o.pgroup = -1; o.deadline_ms = WINDOW_S * 1000L;
    cx_fmt(b->load, sizeof b->load, "%.2f", tool_load1());
    s->idx = idx; s->t0 = sy_now_ms(); s->fd = fd;
    int sr=sy_proc_spawn(&o,&s->c);
    if (sr) { sy_close(fd);b->rc=sr;cx_fmt(b->note,sizeof b->note,"spawn-failed rc=%d",sr);return 1; }
    return 0;
}

/* Material preparation is bounded separately from the first measured batch.
 * Only an explicitly selected native route calls this; every batch still runs. */
static void prepare_first(const int *pending,int count,int jobs){
    if(!use_native || !count)return;
    char src[4400],why[512],ids[1800]="";
    long selector_start=sy_now_ms();
    if(cx_fmt(src,sizeof src,"%s/tools/affected.cx",lay) ||
       cx_fmt(prepared_affected,sizeof prepared_affected,"%s/affected",outlog) ||
       tq_native(lay,src,prepared_affected,why,sizeof why)){
        prepared_affected[0]=0;use_native=0;
        fprintf(stderr,"NATIVE_RUNBATCH_FALLBACK\treason=selector-preparation\n");return;
    }
    /* tq_native validates the image bytes under the key for the candidate
     * compiler and the resolved source closure. This image serves all slots. */
    fprintf(stderr,"QUALIFY_SELECTOR_PREP\tms=%ld\treused=%d\n",
            sy_now_ms()-selector_start,tq_last_state()==1);
    for(int i=0;i<count && i<jobs;i++){
        size_t n=strlen(ids);if(cx_fmt(ids+n,sizeof ids-n,"%s%s",n?",":"",bs[pending[i]].id))return;
    }
    char *v[]={prepared_affected,"--ids",ids,"--native-run-batch","--prep-only",0};
    char receipt[16384];long started=sy_now_ms(); int rc=run(v,lay,55,receipt,sizeof receipt);
    fprintf(stderr,"QUALIFY_PREP\tfirst=%s\trc=%d\tms=%ld\n",ids,rc,sy_now_ms()-started);
    if(rc || !strstr(receipt,"PREPARED\tnative-run-batch\t")){
        use_native=0;
        fprintf(stderr,"NATIVE_RUNBATCH_FALLBACK\treason=runner-preparation\n");
    }
}
/* Run the given indices, at most jobs at once. */
static int run_set(int *idx, int count, int jobs, int attempt, long deadline) {
    Slot slot[16]; int busy[16] = {0}, next = 0, live = 0;
    if (jobs > 16) jobs = 16;
    long admitting_since = 0;
    while ((next < count && sy_now_ms() < deadline) || live) {
        long now = sy_now_ms();
        int admit=0;
#ifdef DVQUALIFY_S2_TAP
        double observed_load=-1;
#endif
        if (next<count && live<jobs && now<deadline) {
            double load=gate_load();
#ifdef DVQUALIFY_S2_TAP
            observed_load=load;
#endif
            admit=attempt ? load<3.0 : load<=6.0;
#ifdef DVQUALIFY_S2_TAP
            if (!admit && !admitting_since) s2_emit("wait",&bs[idx[next]],attempt,0,now,load);
#endif
            if (!admit && !admitting_since) admitting_since=gate_time(now);
            if (!admit && gate_time(now)-admitting_since >= (attempt?60000L:120000L)) {
                while(next<count) {
                    Batch *b=&bs[idx[next++]];
#ifdef DVQUALIFY_S2_TAP
                    s2_emit("wait-timeout",b,attempt,0,now,load);
#endif
                    cx_fmt(b->status,sizeof b->status,"UNKNOWN");
                    cx_fmt(b->note,sizeof b->note,"load-wait-timeout");
                    cx_fmt(b->load,sizeof b->load,"%.2f",load);
                    b->ms=0;b->rc=-1;b->raw[0]=0;b->cand[0]=0;
                    fprintf(stderr,"QUALIFY_BATCH\t%s\tUNKNOWN\tload-wait-timeout\n",b->id);
                }
            }
        }
        for (int k = 0; admit && k < jobs && next < count; k++) if (!busy[k]) {
            int i = idx[next++];
            if(attempt)bs[i].retries=1;
            if (launch(&slot[k], i, attempt)) { cx_fmt(bs[i].status, sizeof bs[i].status, "UNKNOWN");
#ifdef DVQUALIFY_S2_TAP
                s2_emit("launch-failed",&bs[i],attempt,0,now,observed_load);
#endif
                continue; }
#ifdef DVQUALIFY_S2_TAP
            s2_emit("launch",&bs[i],attempt,slot[k].c.pid,slot[k].t0,observed_load);
#endif
            if (admitting_since && gate_time(now)-admitting_since>=2000L)
                cx_fmt(bs[i].note,sizeof bs[i].note,"load_wait>%d",attempt?3:6);
            busy[k] = 1; live++;
        }
        if(admit)admitting_since=0;
        for (int k = 0; k < jobs; k++) if (busy[k]) {
            sy_exit_t st; memset(&st, 0, sizeof st); Slot *s = &slot[k];
            int r = sy_proc_try_wait(&s->c, &st), timed = 0;
            if (r == 0 && sy_now_ms() - s->t0 >= WINDOW_S * 1000L) { sy_proc_kill(&s->c, 9); sy_proc_wait(&s->c, &st); timed = 1; r = 1; }
            if (r == 0) continue;
            sy_close(s->fd); busy[k] = 0; live--;
            Batch *b = &bs[s->idx]; char keep[256]; cx_fmt(keep, sizeof keep, "%s", b->note);
            b->ms = sy_now_ms() - s->t0;
            char path[4400]; cx_fmt(path, sizeof path, "%s/%s.%d.out", outlog, b->id, attempt);
            classify(b, path, timed || st.timed_out, r < 0 ? -1 : sy_exit_code(&st));
#ifdef DVQUALIFY_S2_TAP
            s2_emit("finish",b,attempt,s->c.pid,s->t0+b->ms,-1);
#endif
            if (keep[0]) { long n = strlen(b->note); cx_fmt(b->note + n, sizeof b->note - n, "%s%s", n ? ";" : "", keep); }
            char ph[140]; cx_fmt(ph, sizeof ph, "batch:%s", b->id);
            emit(ph, b->ms, !strcmp(b->status, "PASS") ? 0 : 1, b->load);
            fprintf(stderr, "QUALIFY_BATCH\t%s\t%s\tms=%ld\n", b->id, b->status, b->ms);
        }
        sy_sleep_ms(50);
    }
    return next;
}

static int populate_layout(void) {
    char tar[4400], out[256];
    if (cx_fmt(tar, sizeof tar, "%s/frozen.tar", outlog)) return die("archive path ", outlog);
    char *ar[] = {"git", "-C", root, "archive", "--format=tar", "-o", tar, head, 0}; if (run(ar, 0, 60, 0, 0)) return die("git archive ", root);
    char *x[] = {"tar", "-xf", tar, "-C", lay, 0}; if (run(x, 0, 60, 0, 0)) return die("tar ", tar);
    char *rt[] = {"rm", "-f", tar, 0}; run(rt, 0, 10, 0, 0);
    char dst[4200];sy_stat_t prior;
    if(cx_fmt(dst,sizeof dst,"%s/unisacc.com",lay) || sy_lstat(dst,&prior)!=-ENOENT ||
       sy_copy(ape,dst,0755))return die("install real candidate copy ",lay);
    char *gi[] = {"git", "-C", lay, "init", "-q", 0}; if (run(gi, 0, 30, 0, 0)) return die("git init ", lay);
    char *ga[] = {"git", "-C", lay, "add", "-Af", "--", ".", ":(exclude)unisacc.com", 0}; if (run(ga, 0, 60, 0, 0)) return die("git add (private layout) ", lay);
    char *gc[] = {"git", "-C", lay, "-c", "user.name=devsvc-qualify", "-c", "user.email=qualify@localhost", "-c", "commit.gpgsign=false",
                  "commit", "-q", "-m", "devsvc qualify layout", 0};
    if (run(gc, 0, 60, out, sizeof out)) return die("git commit (private layout) ", lay);
    return 0;
}

/* A new generation is published only after its real APE and private git tree
 * have been verified. Existing readers retain their generation directory. */
static int layout_ok(const char *snapshot) {
    char image[4300], actual[65], tree[64], extra[8];
    unsigned char *bytes=0; int64_t n=0; sy_stat_t st;
    if (cx_fmt(image,sizeof image,"%s/unisacc.com",lay) || sy_lstat(image,&st) || st.kind!='f' ||
        sy_read_file(image,&bytes,&n,256L<<20)) return 0;
    int match=!sy_sha256_hex(bytes,n,actual) && !strcmp(actual,sha); free(bytes);
    char *identity[]={"git","rev-parse","HEAD^{tree}",0};
    char *clean[]={"git","diff","--quiet","HEAD","--",0};
    char *others[]={"git","ls-files","--others","--",":(exclude)unisacc.com",0};
    return match && !cx_fmt(layout_product,sizeof layout_product,"%s",image) &&
           !run(identity,lay,10,tree,sizeof tree) && !strcmp(snapshot,tree) &&
           !run(clean,lay,30,0,0) && !run(others,lay,15,extra,sizeof extra) && !extra[0];
}
static int build_layout(void) {
    const char *td=sy_env("TMPDIR"); if (!td || !*td) td="/tmp";
    char cache[4200], lock[4300], receipt[4300], tree[64], row[180]; sy_stat_t st;
    if (sy_mkdtemp(td,"qualify-log-",outlog,sizeof outlog) ||
        cx_fmt(cache,sizeof cache,"%s/unisacc-qualify-%s-%s",td,sha,head) ||
        (sy_mkdir(cache,0700) && (sy_lstat(cache,&st) || st.kind!='d' || st.mode!=0700 || st.uid!=sy_uid())) ||
        cx_fmt(lock,sizeof lock,"%s/prepare.lock",cache) ||
        cx_fmt(receipt,sizeof receipt,"%s/ready",cache)) return die("private cache ",td);
    int fd=open(lock,O_RDWR|O_CREAT|O_CLOEXEC|O_NOFOLLOW,0600);
    if(fd<0)return die("cannot open preparation lock ",cache);
    long until=sy_now_ms()+55000;
    while(sy_flock(fd,6)) {
        if(sy_now_ms()>=until){sy_close(fd);return die("layout preparation deadline ",cache);}
        sy_sleep_ms(100);
    }
    size_t n=0;char *record=cx_read(receipt,&n); int reused=0;
    if(record && n<sizeof row && n>41){
        char *tab=strchr(record,'\t');
        if(tab){*tab=0;
            if(!strncmp(record,"tree-",5) && !strchr(record,'/') &&
               !cx_fmt(lay,sizeof lay,"%s/%s",cache,record))reused=layout_ok(tab+1);}
    }
    free(record);
    if(!reused){
        if(sy_mkdtemp(cache,"tree-",lay,sizeof lay) || populate_layout()) {sy_close(fd);return 2;}
        char *identity[]={"git","rev-parse","HEAD^{tree}",0};
        if(run(identity,lay,10,tree,sizeof tree) || !layout_ok(tree) ||
           cx_fmt(row,sizeof row,"%s\t%s",strrchr(lay,'/')+1,tree) ||
           sy_write_atomic(receipt,row,strlen(row),0600)){sy_close(fd);return die("layout verification ",lay);}
    }
    sy_close(fd);
    fprintf(stderr,"QUALIFY_LAYOUT_MATERIAL\t%s\tsource=%s\tcandidate=%s\n",reused?"reused":"prepared",head,sha);
    return 0;
}

/* Run the layout's producer once, before any batch window starts. It verifies
 * the shared kit and publishes complete material under tp_kit_key. */
static int prepare_kit(void) {
    char table[4400],source[4400],key[65],why[512]="";
    sy_stat_t st;
    if(cx_fmt(table,sizeof table,"%s/build/tlib-packages.tsv",lay) ||
       cx_fmt(source,sizeof source,"%s/tools/tlib.cx",lay))return die("kit path",0);
    int ts=sy_stat(table,&st),ss=sy_stat(source,&st);
    if(ts==-ENOENT && ss==-ENOENT)return 0; /* standalone registry without tlib */
    unsigned char *bytes=0;int64_t length=0;
    if(ts||ss||sy_read_file(table,&bytes,&length,16L<<20))return die("kit inputs ",table);
    int failed=sy_sha256_hex(bytes,length,key);
    free(bytes);
    if(failed)return die("kit package hash ",table);
    char kit[4400],producer[4400];
    if(tp_kit_dir(lay,kit,sizeof kit))return die("kit identity ",table);
    const char *kit_key=strrchr(kit,'/');
    if(!kit_key || strlen(kit_key+1)!=64)return die("kit identity ",table);
    /* Compile the producer as a separate material step. The subsequent lock wait
       and the producer execution share a single monotonic deadline. */
    if(cx_fmt(producer,sizeof producer,"%s/kit-producer",outlog) ||
       tq_native(lay,source,producer,why,sizeof why))return die("kit producer preparation ",why);
    char lock[4400];
    if(cx_fmt(lock,sizeof lock,"%s/.git/qualify-kit.lock",lay))return die("kit lock path",0);
    int fd=open(lock,O_RDWR|O_CREAT|O_CLOEXEC|O_NOFOLLOW,0600);
    if(fd<0)return die("kit lock ",lock);
#ifdef DVQUALIFY_GATE_FIXTURE
    long limit=sy_now_ms()+2500; /* Exercise actual producer cancellation in the bounded fixture. */
#else
    long limit=sy_now_ms()+55000;
#endif
    for(;;){
        int lk=sy_flock(fd,6);
        if(!lk)break;
        if(lk!=-EAGAIN){sy_close(fd);return die("kit lock unavailable ",lock);}
        if(sy_now_ms()>=limit){sy_close(fd);return 1;}
        sy_sleep_ms(100);
    }
    char *v[]={producer,"kit","--jobs","4",0};
    np_result r={0};long start=sy_now_ms();
    int remaining=(int)((limit-start)/1000);
    if(remaining<1){sy_close(fd);return 1;}
    int transport=np_run(v,lay,0,remaining,&r,why,sizeof why);
    sy_close(fd);
    int tampered=r.err && strstr(r.err,"tlib: TAMPERED\t");
    int prepared=!transport && !r.rc && !tampered && r.out && strstr(r.out,"PREPARED\ttlib-kit\t");
    fprintf(stderr,"QUALIFY_KIT\t%s\tcandidate=%s\tpackages=%s\tkit_key=%s\trc=%d\tms=%ld\n",
            prepared?"PREPARED":"REFUSED",sha,key,kit_key+1,transport?-1:r.rc,sy_now_ms()-start);
    if(!prepared && r.errn)fwrite(r.err,1,r.errn,stderr);
    int timed_out=r.timed_out;
    np_free(&r);
    if(tampered)return die("kit-tampered ",table);
    if(timed_out)return 1;
    if(!prepared)return die("kit-preparation ",why);
    return 0;
}

static int load_receipts(FILE *file) {
    char line[2048], id[96], domain[48], status[16], candidate[72];
    static int eligible[MAXB];
    while (fgets(line, sizeof line, file)) {
        int rc;
        if (!strncmp(line, "RAW\tBATCH_RUN\t", 14) && strchr(line, '\n')) {
            char raw_rc[24], expected_rc[24];
            field(line, "id", id, sizeof id);
            field(line, "status", status, sizeof status);
            field(line, "candidate", candidate, sizeof candidate);
            field(line, "rc", raw_rc, sizeof raw_rc);
            for (int i = 0; i < nb; i++) {
                if (!eligible[i] || strcmp(id, bs[i].id)) continue;
                cx_fmt(expected_rc, sizeof expected_rc, "%d", bs[i].rc);
                resumed[i] = !strcmp(candidate, sha) && !strcmp(status, bs[i].status) && !strcmp(raw_rc, expected_rc);
                break;
            }
            continue;
        }
        if (!strchr(line, '\n') ||
            sscanf(line, "%95[^\t]\t%47[^\t]\t%15[^\t]\t%d\t%71[^\t]", id, domain, status, &rc, candidate) != 5) continue;
        for (int i = 0; i < nb; i++) if (!strcmp(id, bs[i].id)) {
            resumed[i] = 0;
            eligible[i] = !strcmp(candidate, sha) && (!strcmp(status, "PASS") || !strcmp(status, "FAIL"));
            bs[i].rc=rc;
            if (eligible[i]) cx_fmt(bs[i].status, sizeof bs[i].status, "%s", status);
            break;
        }
    }
    for (int i=0;i<nb;i++) if (!resumed[i]) bs[i].status[0]=0;
    return ferror(file);
}

static void write_batch(FILE *f, const Batch *b) {
    fprintf(f, "%s\t%s\t%s\t%d\t%s\t%ld\t%s\t%d\t%s\n", b->id, b->domain, b->status, b->rc,
            b->cand[0] ? b->cand : "-", b->ms, b->load[0] ? b->load : "-", b->retries, b->note[0] ? b->note : "-");
    if (b->raw[0]) fprintf(f, "RAW\t%s\n", b->raw);
}

int main(int argc, char **argv) {
    use_native=!strcmp(sy_env_or("DVQUALIFY_NATIVE_RUN_BATCH","0"),"1");
    const char *set = "sample", *ids = 0, *outp = 0, *resume = 0;
    int jobs = 2, list = 0, segment = 0;
    long seed = -1;
    if (argc < 2 || sy_realpath(argv[1], root, sizeof root) < 0) return die("usage: devsvc qualify --candidate APE [--set sample|product-qualification] [--ids A,B] [--out FILE|--resume FILE] [--jobs N] [--segment-batches N] [--seed N] [--list]", 0);
    for (int i = 2; i < argc; i++) {
        if (!strcmp(argv[i], "--candidate") && i + 1 < argc) { if (sy_realpath(argv[++i], ape, sizeof ape) < 0) return die("candidate not found: ", argv[i]); }
        else if (!strcmp(argv[i], "--set") && i + 1 < argc) set = argv[++i];
        else if (!strcmp(argv[i], "--ids") && i + 1 < argc) ids = argv[++i];
        else if (!strcmp(argv[i], "--out") && i + 1 < argc) outp = argv[++i];
        else if (!strcmp(argv[i], "--resume") && i + 1 < argc) resume = argv[++i];
        else if (!strcmp(argv[i], "--segment-batches") && i + 1 < argc) {
            segment = atoi(argv[++i]);
            if (segment < 1 || segment > MAXB) return die("invalid --segment-batches", 0);
        }
        else if (!strcmp(argv[i], "--jobs") && i + 1 < argc) { jobs = atoi(argv[++i]); if (jobs < 1 || jobs > 16) return die("--jobs must be 1..16", 0); }
        else if (!strcmp(argv[i], "--seed") && i + 1 < argc) seed = atol(argv[++i]);
        else if (!strcmp(argv[i], "--list")) list = 1;
        else return die("unknown argument ", argv[i]);
    }
    if (strcmp(set, "sample") && strcmp(set, "product-qualification")) return die("--set must be sample or product-qualification: ", set);
    if (seed < 0) seed = sy_wall_s() % 1000000;
    /* (3) batch set */
    if (ids) { char t[8192]; cx_fmt(t, sizeof t, "%s", ids); for (char *p = strtok(t, ","); p; p = strtok(0, ",")) add(p); }
    else if (!strcmp(set, "sample")) {
        for (int i = 0; sample_ids[i]; i++) add(sample_ids[i]);
        if (each_row("tests/batches.tsv", take_shard, 0) || nshard < 10) return die("tools-compile shards not found in tests/batches.tsv", 0);
        unsigned long x = (unsigned long)seed * 2654435761UL + 1;
        for (int k = 0; k < 10; k++) {
            int left = nshard - k; x = x * 6364136223846793005UL + 1442695040888963407UL;
            int j = k + (int)((x >> 33) % (unsigned long)left);
            char tmp[96]; mm_copy(tmp, 96, shards[k], 96); mm_copy(shards[k], 96, shards[j], 96); mm_copy(shards[j], 96, tmp, 96);
        }
        for (int a = 0; a < 10; a++) for (int c = a + 1; c < 10; c++) if (strcmp(shards[a], shards[c]) > 0) { char tmp[96]; mm_copy(tmp, 96, shards[a], 96); mm_copy(shards[a], 96, shards[c], 96); mm_copy(shards[c], 96, tmp, 96); }
        for (int k = 0; k < 10; k++) add(shards[k]);
    } else each_row("tests/batch-domain-index.tsv", take_domain, "product-qualification");
    if (!nb) return die("empty batch set", 0);
    each_row("tests/batch-domain-index.tsv", set_domain, 0);
    if (list) {
        for (int i = 0; i < nb; i++) printf("QUALIFY_LIST\t%s\t%s\twindow=%d\n", bs[i].id, bs[i].domain, i / jobs + 1);
        printf("QUALIFY_LIST_SUMMARY\tset=%s\tbatches=%d\tjobs=%d\twindows=%d\twindow_s=55\tseed=%ld\n", ids ? "ids" : set, nb, jobs, (nb + jobs - 1) / jobs, seed);
        return 0;
    }
    if (!ape[0]) return die("--candidate APE is required", 0);
    if (resume && outp && strcmp(resume, outp)) return die("--resume appends to its evidence file", 0);
    if (resume) outp = resume;
    /* (1) precheck */
    long t0 = sy_now_ms();
    sockp = sy_env("DEVSVC_SOCK"); cx_fmt(jobbuf, sizeof jobbuf, "qualify-%ld-%d", t0, sy_pid()); job_id = jobbuf;
    { sy_stat_t st; if (sy_stat(ape, &st) || st.kind != 'f') return die("candidate is not a regular file: ", ape); }
    { unsigned char *b = 0; int64_t n = 0; if (sy_read_file(ape, &b, &n, 256L << 20) || !b || sy_sha256_hex(b, (long)n, sha)) return die("cannot hash ", ape); free(b); }
    { char *v[] = {"sh", ape, "--version", 0}; char o[256]; if (run(v, 0, 30, o, sizeof o)) return die("candidate --version failed: ", ape);
      long k = 0; while (o[k] && o[k] != '\n' && k < (long)sizeof version - 1) { version[k] = o[k]; k++; } version[k] = 0; if (!k) return die("candidate --version printed nothing", 0); }
    { char *v[] = {"git", "-C", root, "rev-parse", "HEAD", 0}; char o[64]; if (run(v, 0, 10, o, sizeof o)) return die("git rev-parse HEAD", 0); cx_fmt(head, sizeof head, "%.40s", o); }
    fprintf(stderr, "QUALIFY_PRECHECK\tsha256=%s\tversion=%s\tsource=%s\tbatches=%d\n", sha, version, head, nb);
    /* Open without truncation. Alias paths contend on the same inode;
       every read, truncate and append below uses this one descriptor. */
    FILE *f=stdout;
    int evidence_fd=-1;
    if(outp){
        int flags=resume ? O_RDWR|O_APPEND : O_WRONLY|O_CREAT;
        evidence_fd=sy_open(outp,flags|O_CLOEXEC|O_NONBLOCK,0666);
        if(evidence_fd<0)return die(resume?"cannot read evidence ":"cannot write evidence ",outp);
        sy_stat_t evidence_stat;
        if(sy_fstat(evidence_fd,&evidence_stat) || evidence_stat.kind!='f'){
            sy_close(evidence_fd);return die("expected regular evidence file ",outp);
        }
        int locked=sy_flock(evidence_fd,2|4);
        if(locked){
            sy_close(evidence_fd);
            return die(locked==-EWOULDBLOCK?"evidence-writer-busy ":"cannot lock evidence ",outp);
        }
        f=fdopen(evidence_fd,resume?"a+":"w");
        if(!f){sy_close(evidence_fd);return die("cannot open evidence stream ",outp);}
        if(resume && (fseek(f,0,SEEK_SET) || load_receipts(f) || fseek(f,0,SEEK_END))){
            fclose(f);return die("cannot read evidence ",outp);
        }
    }
    /* (2) layout root */
    long tl = sy_now_ms();
    if (build_layout()){if(outp)fclose(f);return 2;}
    long layout_ms = sy_now_ms() - tl;
    emit("layout", layout_ms, 0, "-");
    fprintf(stderr, "QUALIFY_LAYOUT\t%s\tms=%ld\n", lay, layout_ms);
    if(outp && !resume && sy_truncate(evidence_fd,0)){
        fclose(f);return die("cannot truncate evidence ",outp);
    }
    if (resume) fputc('\n', f);
    else fprintf(f, "# devsvc qualify: strict evidence bound to candidate APE bytes.\nbatch\tdomain\tstatus\trc\tcandidate\tms\tload1\tretries\tnote\n");
    fprintf(f, "# source=%s layout=%s set=%s seed=%ld jobs=%d window_s=55 outer_s=60 ape_sha256=%s\n",head,lay,ids?"ids":set,seed,jobs,sha);
    if (!segment) segment = 5 * jobs;
    static int pending[MAXB], retry[MAXB];
    int count = 0, completed = 0, number = 0;
    for (int i = 0; i < nb; i++) if (!resumed[i]) pending[count++] = i;
    for(int attempt=1;count && attempt<=2;attempt++){
        int kit_state=prepare_kit();
        if(!kit_state)break;
        if(kit_state==1){
            fprintf(f,"# UNKNOWN kit-window\nCHECKPOINT\tremaining=%d\tape_sha256=%s\n",count,sha);
            if(fflush(f) || ferror(f)){if(outp)fclose(f);return die("cannot flush kit checkpoint ",outp?outp:"stdout");}
            fprintf(stderr,"QUALIFY_KIT\tUNKNOWN\treason=kit-window\tremaining=%d\tresume=%s\n",count,outp?outp:"-");
            if(attempt==1){
                fprintf(stderr,"QUALIFY_KIT\tRETRY\tattempt=2\tcandidate=%s\n",sha);
                continue;
            }
        }
        if(outp)fclose(f);
        return kit_state;
    }
    prepare_first(pending,count,jobs);
#ifdef DVQUALIFY_S2_TAP
    s2_open();
#endif
    long stop = t0 + 1720000L;
    while (completed < count && sy_now_ms() < stop) {
        long began = sy_now_ms();
        int size = count - completed;
        if (size > segment) size = segment;
        int *idx = pending + completed;
        long segment_stop = began + 240000L;
        size = run_set(idx, size, jobs, 0, segment_stop < stop ? segment_stop : stop);
        if (!size) break;
        int nu = 0;
        for (int i = 0; i < size; i++) {
            Batch *b = &bs[idx[i]];
            write_batch(f, b);
            if (!strcmp(b->status, "UNKNOWN") && strcmp(b->note,"load-wait-timeout")) retry[nu++] = idx[i];
        }
        fprintf(f, "# segment=%d batches=%d\n", ++number, size);
        if (fflush(f)) return die("cannot flush evidence ", outp);
        long retry_stop = segment_stop < stop ? segment_stop : stop;
        if (nu && sy_now_ms() + 60000L < retry_stop) {
            int retried=run_set(retry,nu,1,1,retry_stop);
            for (int i = 0; i < retried; i++) {
                write_batch(f, &bs[retry[i]]);
                if (fflush(f)) return die("cannot flush evidence ", outp);
            }
        }
        emit("segment", sy_now_ms() - began, 0, "-");
        completed += size;
    }
    if (completed < count) fprintf(stderr, "QUALIFY_CHECKPOINT\tremaining=%d\tresume=%s\n", count-completed, outp ? outp : "-");
    /* (5) evidence */
    long total = sy_now_ms() - t0;
    int cp = 0, cf = 0, cu = 0, ci = 0, remaining = count - completed;
    for (int i = 0; i < nb; i++) { const char *s = bs[i].status; if (!s[0]) continue; if (!strcmp(s, "PASS")) cp++; else if (!strcmp(s, "FAIL")) cf++; else if (!strcmp(s, "INVALID")) ci++; else cu++; }
    if (remaining) fprintf(f, "# PLANNED=%d\n", remaining);
    fprintf(f, "%s\tbatches=%d\tPASS=%d\tFAIL=%d\tUNKNOWN=%d\tINVALID=%d\ttotal_ms=%ld\tlayout_ms=%ld\tape_sha256=%s\tversion=%s\n", remaining ? "CHECKPOINT" : "SUMMARY", nb, cp, cf, cu, ci, total, layout_ms, sha, version);
    if (fflush(f) || (outp && fclose(f))) return die("cannot finish evidence ", outp);
    emit("total", total, (remaining || cu || ci) ? 1 : 0, "-");
    fprintf(stderr, "QUALIFY_DONE\tbatches=%d\tPASS=%d\tFAIL=%d\tUNKNOWN=%d\tINVALID=%d\ttotal_ms=%ld\tout=%s\n", nb, cp, cf, cu, ci, total, outp ? outp : "-");
    return (remaining || cu || ci) ? 1 : 0;
}
