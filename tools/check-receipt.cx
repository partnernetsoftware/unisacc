/* check-receipt: cxlib.receipt fixtures (input identity recorded; adoption = one comparison).
 *   sh ./unisacc.com tools/check-receipt.cx
 * Builds a throwaway tree under a temp dir: same inputs adopt; one src byte, one table byte, an upstream
 * phase output each make STALE; missing receipt, missing row, unknown token, empty glob, missing upstream
 * receipt all fail closed; the atomic write leaves no .new. Does not wire chain tools. */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use cxlib.receipt
static int bad, total;
static void ok(int cond, const char *what) {
    total++;
    if (!cond) { bad++; fprintf(stderr, "FAIL\t%s\n", what); }
}
static char root[400], rd[460], tb[460], rec[500], rec1[500];
static void put(const char *rel, const char *s) {
    char p[600]; cx_fmt(p, sizeof p, "%s/%s", root, rel);
    if (cx_write(p, s, strlen(s))) { fprintf(stderr, "check-receipt: cannot write %s\n", p); exit(2); }
}
static int hash(const char *ph, char h[65]) { return rc_hash_inputs(root, rd, tb, ph, h); }
int main(int argc, char **argv) {
    const char *opt_run_id = 0, *opt_out = 0;
    for (int ai = 1; ai < argc; ai++) {
        if (!strcmp(argv[ai], "--judge-receipt") && ai + 2 < argc) {
            const char *jid = argv[ai + 1], *jpath = argv[ai + 2];
            if (sy_exists(jpath) != 1) { printf("FAIL\treceipt-missing\n"); return 1; }
            if (rc_fresh(jpath, jid) == 0 && rc_need(jpath, "rc", "int") == 0) { printf("PASS\treceipt-result\n"); return 0; }
            printf("FAIL\treceipt-stale\n");
            return 1;
        }
        if (!strcmp(argv[ai], "--run-id") && ai + 1 < argc) opt_run_id = argv[++ai];
        else if (!strcmp(argv[ai], "--out") && ai + 1 < argc) opt_out = argv[++ai];
    }
    char h0[65], h1[65], up[65], t[500]; int i;
    char d[400];
    if (sy_mkdtemp(sy_tmpdir(), "recfix-", d, sizeof d)) { fprintf(stderr, "check-receipt: no tmpdir\n"); return 2; }
    cx_fmt(root, sizeof root, "%s", d);
    cx_fmt(t, sizeof t, "%s/src", root); sy_mkdir(t, 0755);
    cx_fmt(t, sizeof t, "%s/rec", root); sy_mkdir(t, 0755);
    cx_fmt(rd, sizeof rd, "%s/rec", root);
    cx_fmt(tb, sizeof tb, "%s/sidetable.tsv", root);
    cx_fmt(rec, sizeof rec, "%s/rec/b.receipt", root);
    cx_fmt(rec1, sizeof rec1, "%s/rec/a.receipt", root);
    put("src/x.txt", "alpha\n"); put("src/y.txt", "beta\n"); put("t.tsv", "k\tv\n");
    put("sidetable.tsv", "# id\tinputs\na\tsrc:src/**,table:t.tsv\nb\tphase:a,table:t.tsv\nbad1\tsrc:nothere/**\nbad2\tfoo:bar\nbad3\tsrc:src/*.txt\nbad4\tphase:zzz\n");
    memset(up, 'c', 64); up[64] = 0;
    ok(!hash("a", h0), "hash a");
    ok(!hash("a", h1) && !strcmp(h0, h1), "hash deterministic");
    ok(rc_adopt_ok(rec1, "a", h0) == 1 && !strncmp(rc_why(), "missing", 7), "missing receipt STALE reason=missing");
    ok(!rc_write(rec1, "a", h0, up), "write a");
    { char n[600]; cx_fmt(n, sizeof n, "%s.new", rec1); ok(sy_exists(n) != 1, "atomic write leaves no .new"); }
    ok(rc_adopt_ok(rec1, "a", h0) == 0, "same inputs adopt");
    ok(rc_adopt_ok(rec1, "b", h0) == 1 && !strncmp(rc_why(), "phase", 5), "phase id mismatch STALE");
    put("src/x.txt", "alphb\n");
    ok(!hash("a", h1) && strcmp(h0, h1), "src byte changes hash");
    ok(rc_adopt_ok(rec1, "a", h1) == 1 && !strncmp(rc_why(), "mismatch", 8), "src byte change STALE");
    put("src/x.txt", "alpha\n");
    ok(!hash("a", h1) && !strcmp(h0, h1), "restored src adopts again");
    put("t.tsv", "k\tw\n");
    ok(!hash("a", h1) && strcmp(h0, h1) && rc_adopt_ok(rec1, "a", h1) == 1, "table change STALE");
    put("t.tsv", "k\tv\n");
    ok(!hash("a", h0), "rehash a");
    ok(!hash("b", h1), "hash b with upstream");
    ok(!rc_write(rec, "b", h1, up), "write b");
    ok(rc_adopt_ok(rec, "b", h1) == 0, "b adopt");
    ok(!rc_write(rec1, "a", h0, "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"), "a output changes");
    ok(!hash("b", t) && strcmp(t, h1) && rc_adopt_ok(rec, "b", t) == 1, "upstream output change STALE");
    for (i = 0; i < 4; i++) {
        static const char *id[4] = {"bad1", "bad2", "bad3", "bad4"};
        ok(hash(id[i], t) == 1 && t[0] == 0, id[i]);
    }
    ok(hash("nosuch", t) == 1 && !strncmp(rc_why(), "no-row", 6), "missing declaration fails closed");
    ok(rc_adopt_ok(rec, "b", "short") == 1, "bad current hash STALE");
    put("rec/old.receipt", "phase\told\n");
    { char o[600]; cx_fmt(o, sizeof o, "%s/rec/old.receipt", root);
      ok(rc_adopt_ok(o, "old", h0) == 1 && !strncmp(rc_why(), "no-inputs_sha", 13), "legacy receipt without inputs_sha STALE"); }
    /* v2 receipt: rc_write2, rc_need, rc_fresh */
    {
        char rec2[600], rec2n[600], cand[65], prod[65];
        cx_fmt(rec2, sizeof rec2, "%s/rec/v2.receipt", root);
        cx_fmt(rec2n, sizeof rec2n, "%s.new", rec2);
        memset(cand, 'a', 64); cand[64] = 0;
        memset(prod, 'b', 64); prod[64] = 0;
        ok(rc_write2(rec2, "", cand, h0, up, prod, 0) != 0, "rc_write2 rejects empty run_id");
        ok(rc_write2(rec2, "run-1", "short", h0, up, prod, 0) != 0, "rc_write2 rejects bad hex64");
        ok(!rc_write2(rec2, "run-1", cand, h0, up, prod, 0), "rc_write2 writes valid v2 receipt");
        ok(sy_exists(rec2n) != 1, "rc_write2 atomic write leaves no .new");
        ok(rc_need(rec2, "run_id", "id") == 0, "rc_need run_id id ok");
        ok(rc_need(rec2, "candidate_sha", "hex64") == 0, "rc_need candidate_sha hex64 ok");
        ok(rc_need(rec2, "inputs_sha", "hex64") == 0, "rc_need inputs_sha hex64 ok");
        ok(rc_need(rec2, "output_sha", "hex64") == 0, "rc_need output_sha hex64 ok");
        ok(rc_need(rec2, "producer_sha", "hex64") == 0, "rc_need producer_sha hex64 ok");
        ok(rc_need(rec2, "rc", "int") == 0, "rc_need rc int ok");
        ok(rc_need(rec2, "missing_key", "id") == 2, "rc_need missing key refuses rc=2");
        ok(rc_need(rec2, "rc", "hex64") == 2, "rc_need malformed hex64 refuses rc=2");
        ok(rc_need(rec2, "run_id", "int") == 2, "rc_need malformed int refuses rc=2");
        ok(rc_need(rec2, "run_id", "unknown") == 2, "rc_need unknown kind refuses rc=2");
        ok(rc_fresh(rec2, "run-1") == 0, "rc_fresh matching run_id ok");
        ok(rc_fresh(rec2, "run-0") == 2, "rc_fresh feed-previous-output refuses rc=2");
        {
            char rec_del[600];
            cx_fmt(rec_del, sizeof rec_del, "%s/rec/deleted.receipt", root);
            ok(rc_need(rec_del, "run_id", "id") == 2, "rc_need delete-run-step missing file refuses rc=2");
            ok(rc_fresh(rec_del, "run-1") == 2, "rc_fresh delete-run-step missing file refuses rc=2");
        }
        {
            char rec_dup[600], rec_noterm[600], rec_nul[600], nulb[32];
            cx_fmt(rec_dup, sizeof rec_dup, "%s/rec/dup.receipt", root);
            cx_fmt(rec_noterm, sizeof rec_noterm, "%s/rec/noterm.receipt", root);
            cx_fmt(rec_nul, sizeof rec_nul, "%s/rec/nul.receipt", root);
            cx_write(rec_dup, "run_id\ta\nrun_id\tb\n", 18);
            cx_write(rec_noterm, "run_id\ta", 8);
            memcpy(nulb, "run_id\ta\0b\n", 11);
            cx_write(rec_nul, nulb, 11);
            ok(rc_need(rec_dup, "run_id", "id") == 2, "rc_need duplicate key refuses rc=2");
            ok(rc_need(rec_noterm, "run_id", "id") == 2, "rc_need unterminated line refuses rc=2");
            ok(rc_need(rec_nul, "run_id", "id") == 2, "rc_need embedded NUL refuses rc=2");
            {
                char rec_sw[600], sw_buf[512];
                cx_fmt(rec_sw, sizeof rec_sw, "%s/rec/swapped.receipt", root);
                cx_fmt(sw_buf, sizeof sw_buf,
                       "run_id\trun-2\ncandidate_sha\t%s\ninputs_sha\t%s\noutput_sha\t%s\nproducer_sha\t%s\nrc\t0\nbinding_sha\t%s\n",
                       cand, h0, up, prod, cand);
                cx_write(rec_sw, sw_buf, strlen(sw_buf));
                ok(rc_fresh(rec_sw, "run-2") == 2, "rc_fresh swapped run_id without binding_sha refuses rc=2");
            }
        }
    }
    if (opt_run_id && opt_out) {
        char c64[65]; memset(c64, 'e', 64); c64[64] = 0;
        (void)rc_write2(opt_out, opt_run_id, c64, h0, up, c64, bad ? 1 : 0);
    }
    cx_rmtree(d);
    printf("CHECK_RECEIPT\ttotal=%d\tfailed=%d\n", total, bad);
    return bad ? 1 : 0;
}
