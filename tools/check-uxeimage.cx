/* Fixture checks of tools/cxlib/uxeimage.cx: PNG sizing, checksum bytes, and polygon parity. */
#pragma unisa use cxlib.uxeimage

int main(void) {
    static const unsigned char rgba[]={1,2,3,4};
    static const unsigned char scanline[]={0,1,2,3,4};
    static const double x[]={0,4,4,0},y[]={0,0,4,4};
    unsigned char bytes[74]={0};
    int n,failed=0;
    uxe_crc_init();
    n=uxe_encode_rgba_png(bytes,72,rgba,1,1);
    failed+=n!=0 || bytes[0]!=0;
    bytes[73]=55;
    n=uxe_encode_rgba_png(bytes,73,rgba,1,1);
    failed+=n!=73 || bytes[0]!=137 || bytes[73]!=55;
    failed+=bytes[16]!=0 || bytes[19]!=1 || bytes[23]!=1 || bytes[25]!=6;
    failed+=bytes[36]!=16 || bytes[41]!=0x78 || bytes[43]!=1 || bytes[44]!=5 || bytes[48]!=0 || bytes[52]!=4;
    failed+=uxe_adler(scanline,5)!=0x0019000bu || bytes[53]!=0 || bytes[54]!=25 || bytes[56]!=11;
    failed+=bytes[69]!=0xae || bytes[70]!=0x42 || bytes[71]!=0x60 || bytes[72]!=0x82;
    failed+=!uxe_polygon_contains(x,y,4,2,2) || uxe_polygon_contains(x,y,4,5,2);
    printf("CHECK_UXEIMAGE\tbytes=%d failed=%d\n",n,failed);
    return failed!=0;
}
