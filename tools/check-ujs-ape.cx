#pragma unisa use cxlib.ckassert
/* tools/check-ujs-ape.cx -- refuse a single-target ujs.com.
 *
 * sh ./unisacc.com tools/check-ujs-ape.cx --
 *
 * Asserts ujs/ujs.com is a five-slice APE: MZ head, four gzip members
 * (lnx/osx x86_64/arm64), size above the historic 386146 ELF.
 * Last line UJS_APE_OK assertions=N failed=M
 */




int main(int argc, char **argv) {
    FILE *f;
    unsigned char *b;
    long n, i, gz;
    (void)argc;
    (void)argv;
    f = fopen("ujs/ujs.com", "rb");
    if (!f) {
        fprintf(stderr, "check-ujs-ape: cannot open ujs/ujs.com\n");
        return 2;
    }
    if (fseek(f, 0, SEEK_END) != 0) {
        fclose(f);
        return 2;
    }
    n = ftell(f);
    if (n < 0 || n > 64 * 1024 * 1024) {
        fclose(f);
        return 2;
    }
    if (fseek(f, 0, SEEK_SET) != 0) {
        fclose(f);
        return 2;
    }
    b = (unsigned char *)malloc((size_t)n);
    if (!b) {
        fclose(f);
        return 2;
    }
    if ((long)fread(b, 1, (size_t)n, f) != n) {
        free(b);
        fclose(f);
        return 2;
    }
    fclose(f);
    ck(n > 1000000, "size-above-single-elf");
    ck(n >= 2 && b[0] == 'M' && b[1] == 'Z', "mz-head");
    gz = 0;
    for (i = 0; i + 1 < n; i++) {
        if (b[i] == 0x1f && b[i + 1] == 0x8b) gz++;
    }
    ck(gz >= 4, "gzip-slices-ge-4");
    printf("note\tsize=%ld\tgzip=%ld\n", n, gz);
    free(b);
    printf("UJS_APE_OK\tassertions=%d\tfailed=%d\n", ck_assertions(), ck_failures());
    return ck_failures() ? 1 : 0;
}
