/* Independent hand-built transcript/standard ELF fixture, not a simulator run. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sysx.process
static char target[4400],cfg[4400],watch[4400],image[4400],com[4400],tool[4400];static int checks,bad;
static const char *configuration="LW.i\tnpc,ws,we\nWRITE\tnpc,endo,memory_mode,host_dyn,target_os\nWR.nx\tq\nLIB.imagebegin\tendo,npc,lib_present\nEH.r821\ttext_blob,endo\nEI.pad\tendo\n";
static const char *source="ret form=x86\nret form=x86\n";
static const char *ds="bcf30b2297085486f8aff96a10242b7e91c2d1b2e7260d96abc2d560f67fba98";
static void ck(int v,const char *s){checks++;printf("%s\t%s\n",v?"PASS":"FAIL",s);if(!v)bad++;}
static void die(void){fprintf(stderr,"encoder fixture IO\n");exit(2);}

static int bundle_checks,bundle_split=1,bundle_damage;
static char bundle_path[4400];
static const char *bundle_watch(void){
 if(!bundle_checks)return watch;
 char packer[4400],directory[4400],split[32];size_t z=strlen(com);if(z<12||strcmp(com+z-12,"/unisacc.com"))die();snprintf(packer,sizeof packer,"%.*s/tools/check-watch-bundle.cx",(int)(z-12),com);snprintf(directory,sizeof directory,"%s.bundle-%d",watch,checks);snprintf(split,sizeof split,"%d",bundle_split);
 char *args[]={"sh",com,packer,"--","--fixture-from-watch",watch,directory,split,0};np_result r={0};char why[256]={0};int tr=np_run(args,0,0,10,&r,why,sizeof why);if(tr||r.residue||r.rc){fprintf(stderr,"bundle fixture preparation rc=%d %s %s\n",r.rc,why,r.err?r.err:"");np_free(&r);die();}np_free(&r);snprintf(bundle_path,sizeof bundle_path,"%s/manifest.tsv",directory);if(bundle_damage){char missing[4400];snprintf(missing,sizeof missing,"%s/execution.tsv",directory);if(unlink(missing))die();}return bundle_path;
}
static int bundle_result(const char *out){if(!bundle_checks)return 1;if(!out)return 0;size_t n;char *m=cx_read(bundle_path,&n),h[65],key[80];if(!m)die();cx_sha256_hex(m,n,h);free(m);snprintf(key,sizeof key,"watch_sha=%s",h);return strstr(out,key)&&strstr(out,"watch_transport=watch-bundle-v1");}
static void bundle_insert(char **v){if(!bundle_checks)return;int n=0;while(v[n])n++;for(int i=n;i>=4;i--)v[i+1]=v[i];v[4]="--watch-bundle";}
static void put(unsigned char *s,int at,unsigned long long n,int width){for(int i=0;i<width;i++){s[at+i]=n&255;n>>=8;}}
static void fixture_image(void){unsigned char b[178]={0};memcpy(b,"\177ELF\2\1\1",7);put(b,16,2,2);put(b,18,62,2);put(b,20,1,4);put(b,24,4194304+176,8);put(b,32,64,8);put(b,52,64,2);put(b,54,56,2);put(b,56,2,2);put(b,64,1,4);put(b,68,5,4);put(b,80,4194304,8);put(b,96,178,8);put(b,104,178,8);put(b,112,4096,8);put(b,120,1,4);put(b,124,6,4);put(b,128,178,8);b[176]=195;b[177]=195;if(cx_write(image,b,sizeof b))die();}
static void transcript(int mode,int longform){
 size_t n;char *im=cx_read(image,&n),th[65],ch[65],ih[65];if(!im)die();cx_sha256_hex(source,strlen(source),th);cx_sha256_hex(configuration,strlen(configuration),ch);cx_sha256_hex(im,n,ih);free(im);
 FILE *f=fopen(watch,"wb");if(!f)die();fprintf(f,"WRITE_EVENTS\tversion=1\tdelta_sha=%s\tinput_sha=%s\toutput_sha=%s\toutput_bytes=178\tclaim=STATE_OBSERVATION_ONLY\tconfig_sha=%s%s\n",ds,th,ih,ch,longform?"":"\twatch_format=compact-v1");
 long seq=0;if(!longform)fprintf(f,"FRAME\t%ld\t1\t%s\t26\n",++seq,th);
 int slots[8]={0,0,1,2,2,3,4,5};long cursors[8]={3,16,26,26,26,26,26,26},outs[8]={0,0,0,1,2,2,176,178};
 long values[8][5]={{0,0,3},{1,13,16},{2,2,0,0,1},{0},{1},{2,2,0},{1,2},{2}};
 if(mode==1)values[1][0]=0;if(mode==3)values[4][0]=0;if(mode==5)outs[6]=175;if(mode==6)values[2][1]=3;if(mode==7)values[2][3]=1;
 const char *hex[6]={"4c572e69","5752495445","57522e6e78","4c49422e696d616765626567696e","45482e72383231","45492e706164"};int arity[6]={3,5,1,3,2,1};const char *names[6][5]={{"npc","ws","we"},{"npc","endo","memory_mode","host_dyn","target_os"},{"q"},{"endo","npc","lib_present"},{"text_blob","endo"},{"endo"}};
 for(int i=0;i<8;i++){
  if((mode==2&&i==1)||(mode==4&&i==4))continue;int slot=slots[i];
  if(longform)fprintf(f,"WATCH\t%ld\tstate_hex=%s\tframe_instance=1\tframe_sha=%s\tcursor=%ld\tframe_end=26\toutput_generation=0\toutput_len=%ld\tscratch_generation=0\tscratch_len=0",++seq,hex[slot],th,cursors[i],outs[i]);
  else fprintf(f,"WATCHC\t%ld\t%d\t1\t%ld\t0\t%ld\t0\t0",++seq,slot,cursors[i],outs[i]);
  for(int j=0;j<arity[slot];j++){if(longform)fprintf(f,"\tvalue:%s=%ld",names[slot][j],values[i][j]);else fprintf(f,"\t%ld",values[i][j]);}fputc('\n',f);
 }
 fprintf(f,"COMPLETE\tevents=%ld\n",seq);if(fclose(f))die();
}
static void run(int expected,const char *label){const char *bw=bundle_watch();char *v[16]={"sh",com,tool,"--",target,cfg,(char *)bw,image,0};bundle_insert(v);np_result r={0};char why[256]={0};int e=np_run(v,0,0,10,&r,why,sizeof why);int ok=!e&&!r.residue&&r.rc==expected;if(expected==0)ok=ok&&strstr(r.out,"RECORD\t0\ttarget_lo=0\ttarget_hi=13\ttext_lo=0\ttext_hi=1\tfile_lo=176\tfile_hi=177")&&strstr(r.out,"RECORD\t1\ttarget_lo=13\ttarget_hi=26\ttext_lo=1\ttext_hi=2\tfile_lo=177\tfile_hi=178");else ok=ok&&r.outn==0;if(!expected)ok=ok&&bundle_result(r.out);ck(ok,label);if(!ok)fprintf(stderr,"transport%d rc%d %s %s\n",e,r.rc,why,r.err?r.err:"");np_free(&r);}
static const char *foreign_profile;
static const char *foreign_cfg(int mac){if(foreign_profile&&!strcmp(foreign_profile,"win/x86_64-forward"))return "LW.i\tnpc,ws,we\nWRITE\tnpc,endo,memory_mode,host_dyn,target_os\nWR.nx\tq\nLIB.imagebegin\tendo,npc,lib_present\nPE.r1023\ttext_blob,endo\nPE.copy\tendo\tframe-edges\nPE.r1143\tpe_rlsize\nPE.r1144\tpe_rlsize\nPE.header.forward\tpe_rd,pe_rf,pe_df,pe_dt,pe_cookie,pe_relf,pe_rlsize,pe_cookie_shift\nPE.imports.forward\tpe_rd,pe_rf,pe_df,pe_cookie\n";return mac?"LW.i\tnpc,ws,we\nWRITE\tnpc,endo,memory_mode,host_dyn,target_os\nWR.nx\tq\nLIB.imagebegin\tendo,npc,lib_present\nMH.text\ttext_blob,endo\nMH.copy\tendo\tframe-edges\nMH.r945\tmh_sigoff\nMH.r946\tmh_sigoff\n":"LW.i\tnpc,ws,we\nWRITE\tnpc,endo,memory_mode,host_dyn,target_os\nWR.nx\tq\nLIB.imagebegin\tendo,npc,lib_present\nPE.r1023\ttext_blob,endo\nPE.copy\tendo\tframe-edges\nPE.r1143\tpe_rlsize\nPE.r1144\tpe_rlsize\n";}
