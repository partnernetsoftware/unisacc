static void forward_fixture(int badfield){
 format_fixture(0,badfield==1);size_t n;char *old=cx_read(image,&n);unsigned char b[4608]={0};if(!old||n!=2048)die();memcpy(b,old,1536);free(old);
 long o=152,rd=8192,rf=1536,df=3072,dt=12288;unsigned long long cookie=5368709120ULL+dt+128;
 put(b,134,4,2);put(b,o+4,512,4);put(b,o+56,20480,4);put(b,o+70,33088,2);put(b,o+120,badfield==2?rd+1:rd,4);put(b,o+124,40,4);put(b,o+152,16384,4);put(b,o+156,12,4);put(b,o+192,rd+936,4);put(b,o+196,320,4);put(b,o+208,rd+256,4);put(b,o+212,216,4);
 memset(b+432,0,120);long a=432;memcpy(b+a,".rdata",6);put(b,a+8,1256,4);put(b,a+12,rd,4);put(b,a+16,1536,4);put(b,a+20,rf,4);put(b,a+36,1073741888,4);
 a+=40;memcpy(b+a,".data",5);put(b,a+8,128,4);put(b,a+12,dt,4);put(b,a+16,1024,4);put(b,a+20,df,4);put(b,a+36,3221225536ULL,4);
 a+=40;memcpy(b+a,".reloc",6);put(b,a+8,12,4);put(b,a+12,16384,4);put(b,a+16,512,4);put(b,a+20,4096,4);put(b,a+36,1107296320,4);
 put(b,rf,rd+40,4);put(b,rf+12,rd+916,4);put(b,rf+16,rd+256,4);memcpy(b+rf+916,"KERNEL32.dll",13);put(b,rf+936,320,4);put(b,rf+1024,cookie,8);
 const int names[26]={472,488,500,512,526,540,554,572,588,606,620,644,662,676,690,708,730,752,772,788,808,830,852,868,886,900};for(int i=0;i<26;i++){put(b,rf+40+i*8,rd+names[i],8);put(b,rf+256+i*8,rd+names[i],8);}if(badfield==3)b[rf+256]++;
 put(b,4096,16384,4);put(b,4100,12,4);if(cx_write(image,b,sizeof b))die();
}

static void foreign_transcript(int mac,int bad){
 int fw=foreign_profile&&!strcmp(foreign_profile,"win/x86_64-forward");int macdynamic=foreign_profile&&!strcmp(foreign_profile,"osx/x86_64-forward");
 const char *c=foreign_cfg(mac);if(cx_write(cfg,c,strlen(c)))die();size_t n;char *im=cx_read(image,&n),th[65],ch[65],ih[65],a[65],b[65];if(!im)die();long H=mac?1020:1024,P=(mac||fw)?4096:1536,L=mac?4096:12;cx_sha256_hex(source,26,th);cx_sha256_hex(c,strlen(c),ch);cx_sha256_hex(im,n,ih);cx_sha256_hex(im+H,2,a);cx_sha256_hex(im+(mac?0:P),L,b);free(im);
 FILE *f=fopen(watch,"wb");if(!f)die();fprintf(f,"WRITE_EVENTS\tversion=1\tdelta_sha=%s\tinput_sha=%s\toutput_sha=%s\toutput_bytes=%ld\tclaim=STATE_OBSERVATION_ONLY\tconfig_sha=%s\twatch_format=compact-v1\n",mac?"14e7172dc3ea4df12013cc9095fae820b85ffa8fa8f8431a0e4fb1749bfd87c0":"ed5f89c5bcaf876ffd3301f7f096ea1ece484b1811ff3b7695aaf6d61e376b09",th,ih,(long)n,ch);
 long seq=1;fprintf(f,"FRAME\t1\t1\t%s\t26\n",th);
 fprintf(f,"WATCHC\t%ld\t0\t1\t3\t0\t0\t0\t0\t0\t0\t3\n",++seq);fprintf(f,"WATCHC\t%ld\t0\t1\t16\t0\t0\t0\t0\t1\t13\t16\n",++seq);
 fprintf(f,"WATCHC\t%ld\t1\t1\t26\t0\t0\t0\t0\t2\t2\t0\t%d\t%d\n",++seq,(fw||macdynamic)&&(bad!=6),mac?2:3);
 for(int i=0;i<2;i++)fprintf(f,"WATCHC\t%ld\t2\t1\t26\t0\t%d\t0\t0\t%d\n",++seq,i+1,i);
 fprintf(f,"WATCHC\t%ld\t3\t1\t26\t0\t2\t0\t0\t2\t2\t0\n",++seq);if(fw&&bad!=5)fprintf(f,"WATCHC\t%ld\t8\t1\t26\t0\t0\t0\t0\t8192\t1536\t3072\t12288\t5368721536\t4096\t12\t128\n",++seq);fprintf(f,"WATCHC\t%ld\t4\t1\t26\t0\t%ld\t0\t0\t1\t2\n",++seq,H+(bad==1));
 fprintf(f,"FRAME\t%ld\t2\t%s\t2\n",++seq,a);for(int i=0;i<2;i++)fprintf(f,"WATCHC\t%ld\t5\t2\t%d\t0\t%ld\t0\t0\t2\n",++seq,i*2,H+i*2);
 if(fw)fprintf(f,"WATCHC\t%ld\t9\t1\t26\t0\t1536\t0\t0\t8192\t1536\t3072\t5368721536\n",++seq);
 fprintf(f,"WATCHC\t%ld\t6\t1\t26\t0\t%ld\t0\t0\t%ld\n",++seq,P,L);fprintf(f,"FRAME\t%ld\t3\t%s\t%ld\n",++seq,b,L);
 for(int i=0;i<2;i++)fprintf(f,"WATCHC\t%ld\t5\t%d\t%ld\t0\t%ld\t0\t0\t2\n",++seq,bad==3?2:3,i*L,(mac?0:P)+i*L);
 fprintf(f,"WATCHC\t%ld\t7\t1\t26\t0\t%ld\t0\t0\t%ld\n",++seq,(mac?0:P)+L,L);fprintf(f,"COMPLETE\tevents=%ld\n",seq);if(fclose(f))die();
}
static void foreign_run(int rc,int wrong,const char *label){const char *bw=bundle_watch();char *v[16]={"sh",com,tool,"--","--profile",(char *)(wrong?(!strcmp(foreign_profile,"osx/x86_64")?"win/x86_64":"osx/x86_64"):foreign_profile),target,cfg,(char *)bw,image,0};bundle_insert(v);np_result r={0};char why[256]={0};int e=np_run(v,0,0,10,&r,why,sizeof why);int ok=!e&&!r.residue&&r.rc==rc;if(rc==0)ok=ok&&r.out&&strstr(r.out,"ENCODER_RECORD_ORIGIN\trecords=2\ttext_bytes=2")!=0;else ok=ok&&!r.outn;if(!rc)ok=ok&&bundle_result(r.out);ck(ok,label);if(!ok)fprintf(stderr,"rc%d transport%d %s %s\n",r.rc,e,why,r.err?r.err:"");np_free(&r);}
static void foreign_checks(void){int mac=!strncmp(foreign_profile,"osx/",4),macdynamic=!strcmp(foreign_profile,"osx/x86_64-forward");int fw=!strcmp(foreign_profile,"win/x86_64-forward");if(!mac&&!fw&&strcmp(foreign_profile,"win/x86_64"))die();if(fw)forward_fixture(0);else format_fixture(mac,0);foreign_transcript(mac,0);foreign_run(0,0,"hand-built standard-format/transcript consistency (not simulator evidence)");foreign_transcript(mac,1);foreign_run(2,0,"foreign wrong H refuses");if(fw)forward_fixture(1);else format_fixture(mac,1);foreign_transcript(mac,0);foreign_run(2,0,"foreign wrong text section refuses");if(fw)forward_fixture(0);else format_fixture(mac,0);foreign_transcript(mac,0);foreign_run(2,1,"foreign wrong profile refuses");foreign_transcript(mac,3);foreign_run(2,0,"foreign crossed copy frame refuses");if(macdynamic){foreign_transcript(mac,6);foreign_run(2,0,"dynamic Mach requires host_dyn one");}if(fw){forward_fixture(2);foreign_transcript(0,0);foreign_run(2,0,"forward import directory mutation refuses");forward_fixture(3);foreign_transcript(0,0);foreign_run(2,0,"forward IAT mutation refuses");forward_fixture(0);foreign_transcript(0,5);foreign_run(2,0,"forward missing header branch refuses");foreign_transcript(0,6);foreign_run(2,0,"forward static WRITE refuses");}}

int main(int argc,char **argv){if(argc>1&&!strcmp(argv[1],"--bundle-checks")){bundle_checks=1;for(int i=1;i+1<argc;i++)argv[i]=argv[i+1];argc--;}if(argc==3&&!strcmp(argv[1],"--profile-checks"))foreign_profile=argv[2];else if(argc!=1)die();char root[4400],dir[]="/tmp/encoder-origin-XXXXXX";if(!realpath(".",root)||!mkdtemp(dir))die();cx_fmt(com,sizeof com,"%s/unisacc.com",root);cx_fmt(tool,sizeof tool,"%s/tools/encoder-record-origin.cx",root);cx_fmt(target,sizeof target,"%s/target",dir);cx_fmt(cfg,sizeof cfg,"%s/config",dir);cx_fmt(watch,sizeof watch,"%s/watch",dir);cx_fmt(image,sizeof image,"%s/image",dir);if(cx_write(target,source,strlen(source))||cx_write(cfg,configuration,strlen(configuration)))die();fixture_image();
 if(bundle_checks){if(foreign_profile){int mac=!strncmp(foreign_profile,"osx/",4),fw=!strcmp(foreign_profile,"win/x86_64-forward");if(fw)forward_fixture(0);else format_fixture(mac,0);foreign_transcript(mac,0);foreign_run(0,0,"bundle foreign FRAME dictionary across parts");bundle_split=10;foreign_transcript(mac,0);foreign_run(0,0,"bundle copy transaction across parts");foreign_transcript(mac,3);foreign_run(2,0,"bundle crossed copy frame refuses");if(!strcmp(foreign_profile,"osx/x86_64-forward")){foreign_transcript(mac,6);foreign_run(2,0,"bundle dynamic Mach rejects static WRITE");}bundle_damage=1;foreign_transcript(mac,0);foreign_run(2,0,"bundle missing execution refuses before certificate");}else{transcript(0,0);run(0,"bundle FRAME to WATCH crosses parts");bundle_split=5;transcript(0,0);run(0,"bundle q interval state crosses parts");transcript(3,0);run(2,"bundle duplicate q still refuses");bundle_damage=1;transcript(0,0);run(2,"bundle missing execution refuses before certificate");}printf("ENCODER_BUNDLE_CHECK\tchecks=%d\tfailed=%d\n",checks,bad);return bad?1:0;}
 if(foreign_profile){foreign_checks();unlink(target);unlink(cfg);unlink(watch);unlink(image);rmdir(dir);printf("ENCODER_PROFILE_CHECK\tprofile=%s\tchecks=%d\tfailed=%d\n",foreign_profile,checks,bad);return bad?1:0;}
 transcript(0,0);run(0,"independent compact two-ret fixture exact intervals");transcript(0,1);run(0,"independent long fixture same exact intervals");
 const char *labels[7]={"duplicate LW refuses","missing LW refuses","duplicate q refuses","missing q refuses","changed H refuses","changed T refuses","nonstatic refuses"};for(int i=1;i<=7;i++){transcript(i,0);run(2,labels[i-1]);}
 transcript(0,0);if(cx_write(target,"ret form=x85\nret form=x86\n",26))die();run(2,"changed target identity refuses");if(cx_write(target,source,strlen(source))||cx_write(cfg,"wrong\n",6))die();run(2,"wrong config refuses");
 unlink(target);unlink(cfg);unlink(watch);unlink(image);rmdir(dir);printf("ENCODER_RECORD_CHECK\tchecks=%d\tfailed=%d\n",checks,bad);return bad?1:0;}
