  put(b,184,2147483688ULL,4);put(b,188,24,4);put(b,192,1020,8);put(b,208,29,4);put(b,212,16,4);put(b,216,4096,4);put(b,220,12,4);
  long a=224;for(int i=0;i<9;i++){long z=i==8?64:72;put(b,a,12,4);put(b,a+4,z,4);put(b,a+8,24,4);memcpy(b+a+24,"/lib/fixture.dylib",18);a+=z;}b[1020]=195;b[1021]=195;b[4096]=250;b[4097]=222;b[4098]=12;b[4099]=192;b[4103]=12;
 }else{
  memcpy(b,"MZ",2);put(b,60,128,4);put(b,128,17744,4);put(b,132,34404,2);put(b,134,3,2);put(b,148,240,2);put(b,150,34,2);put(b,152,523,2);put(b,168,4096,4);put(b,176,5368709120ULL,8);put(b,184,4096,4);put(b,188,512,4);put(b,208,16384,4);put(b,212,1024,4);put(b,220,3,2);put(b,260,16,4);
  long a=392;memcpy(b+a,".text",5);put(b,a+8,bad?3:2,4);put(b,a+12,4096,4);put(b,a+16,512,4);put(b,a+20,1024,4);put(b,a+36,1610612768,4);a+=40;memcpy(b+a,".data",5);put(b,a+8,8,4);put(b,a+12,8192,4);put(b,a+20,1536,4);a+=40;memcpy(b+a,".reloc",6);put(b,a+8,12,4);put(b,a+12,12288,4);put(b,a+16,512,4);put(b,a+20,1536,4);b[1024]=195;b[1025]=195;put(b,1536,8192,4);put(b,1540,12,4);
