/* tools/check-enosys-sites.cx -- tools/enosys-sites.cx 的检查:夹具目录里验证行口径、函数、目标推断、named 判定、范围、排序、篡改检测,并核对仓内表一致。
 *
 *   sh ./unisacc.com tools/check-enosys-sites.cx
 */
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.posix
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.bytes
#pragma unisa use mem.heap

static int failed, nok;
static char dir[320];
static void ck(int ok, const char *name) {
    if (ok) { nok++; sy_printf("PASS\tcheck-enosys-sites.%s\n", name); }
    else { failed++; sy_printf("FAIL\tcheck-enosys-sites.%s\n", name); }
}
static void mk(const char *rel) { char p[500]; cx_fmt(p, sizeof p, "%s/%s", dir, rel); mkdir(p, 0700); }
static void put(const char *rel, const char *body) {
    char p[500];
    cx_fmt(p, sizeof p, "%s/%s", dir, rel);
    cx_write(p, body, tx_len(body, 100000));
}
static int run(const char *root, const char *mode, char *out, long cap) {
    char cmd[900]; char *o = 0; size_t n = 0; int rc;
    cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com tools/enosys-sites.cx -- %s --root %s", mode, root);
    char *v[] = {"sh", "-c", cmd, 0};
    rc = cx_runv_timeout(v, 50, &o, &n);
    out[0] = 0; if (o && (long)n < cap) { mm_copy(out, cap, o, n); out[n] = 0; }
    return rc;
}
static int rowcount(const char *t, long n, const char *row) {
    long rl = tx_len(row, 1000), i = 0; int c = 0;
    while (i < n) {
        long e = i;
        while (e < n && t[e] != '\n') e++;
        if (e - i == rl && mm_same(t + i, row, rl)) c++;
        i = e + 1;
    }
    return c;
}
static long rowpos(const char *t, long n, const char *row) {
    long rl = tx_len(row, 1000), i = 0;
    while (i < n) {
        long e = i;
        while (e < n && t[e] != '\n') e++;
        if (e - i == rl && mm_same(t + i, row, rl)) return i;
        i = e + 1;
    }
    return -1;
}
static int lines(const char *t, long n) { long i; int c = 0; for (i = 0; i < n; i++) c += t[i] == '\n'; return c; }
static int hasl(const char *h, const char *lit) {
    long hn = tx_len(h, 100000), ln = tx_len(lit, 4096), i;
    for (i = 0; i + ln <= hn; i++) if (h[i] == lit[0] && mm_same(h + i, lit, ln)) return 1;
    return 0;
}

int main(void) {
    char out[8192]; long n = 0; char *t; char p[500];
    int rc;
    if (cx_fmt(dir, sizeof dir, "%s/enosys-check-XXXXXX", sy_tmpdir()) || !mkdtemp(dir)) { ck(0, "tmpdir"); return 1; }
    mk("cx"); mk("cx/sys"); mk("cx/os"); mk("ext"); mk("ext/a"); mk("ext/b"); mk("ext/net"); mk("ext/.hidden"); mk("tools"); mk("tools/cxlib"); mk("tools/other"); mk("build");
    put("cx/sys/foo_osx.cx", "int osx_open(void) {\n    return -ENOSYS;   // osx has no such call\n}\n");
    put("cx/os/plain.cx", "int plain_fn(int x) {\n    if (x) return 1;\n    return ENOSYS;\n}\n");
    put("ext/net/win_thing.cx", "long w_call(void) {\n    return SY_ENOSYS_NET;\n}\n");
    put("ext/a/mix.cx", "int mix(void) {\n    int os = sy_os_name();\n    if (os == OS_OSX) return -1;\n    if (os == OS_WIN) return -ENOSYS;\n    return 0;\n}\n");
    put("ext/a/two.cx", "int two(void) { return ENOSYS + ENOSYS; }\n");
    put("ext/b/lin.cx", "int lin(void) {\n    const char *p = \"linux\";\n    return -ENOSYS;\n}\n");
    put("ext/.hidden/x.cx", "int hid(void) { return ENOSYS; }\n");
    put("tools/cxlib/h.cx", "/* header */\nint h(void){return ENOSYS;}\n");
    put("tools/other/x.cx", "int other(void) { return ENOSYS; }\n");
    put("cx/os/cmt.cx", "// ENOSYS note only\n/* multi\n   ENOSYS inside */\nconst char *s = \"ENOSYS\";\nint cm(void) {\n    return -ENOSYS; /* ENOSYS: refuse x */\n}\n");
    put("cx/sys/README.md", "line one\nENOSYS means none\n");
    put("cx/sys/none.cx", "int nothing(void) { return 0; }\n");
    rc = run(dir, "--write", out, sizeof out);
    ck(rc == 0 && hasl(out, "WROTE\trows=9\tnamed=4\tfiles=10"), "write-summary");
    rc = run(dir, "--check", out, sizeof out);
    ck(rc == 0 && hasl(out, "OK\tbuild/enosys-sites.tsv"), "check-ok");
    cx_fmt(p, sizeof p, "%s/build/enosys-sites.tsv", dir);
    { size_t m = 0; t = cx_read(p, &m); n = (long)m; }
    if (!t) { ck(0, "read-output"); return 1; }
    ck(rowpos(t, n, "# file\tline\tfunction\ttarget\tnamed") == 0, "header-first");
    ck(rowcount(t, n, "cx/sys/foo_osx.cx\t2\tosx_open\tosx\tyes") == 1, "path-osx-comment-named");
    ck(rowcount(t, n, "cx/os/plain.cx\t3\tplain_fn\tunknown\tno") == 1, "unknown-target-unnamed");
    ck(rowcount(t, n, "ext/net/win_thing.cx\t2\tw_call\twin\tyes") == 1, "path-win-prefixed-constant-named");
    ck(rowcount(t, n, "ext/a/mix.cx\t4\tmix\tall\tno") == 1, "window-two-families-all");
    ck(rowcount(t, n, "ext/a/two.cx\t1\ttwo\tunknown\tno") == 1, "two-hits-one-row");
    ck(rowcount(t, n, "ext/b/lin.cx\t3\tlin\tlnx\tno") == 1, "window-linux");
    ck(rowcount(t, n, "tools/cxlib/h.cx\t2\th\tunknown\tyes") == 1, "previous-line-comment-named");
    ck(rowcount(t, n, "cx/sys/README.md\t2\t-\tunknown\tno") == 1, "non-code-file-function-dash");
    ck(!hasl(t, "hid") && !hasl(t, ".hidden"), "hidden-dir-skipped");
    ck(!hasl(t, "tools/other"), "out-of-scope-dir-skipped");
    ck(!hasl(t, "none.cx"), "file-without-hit-no-row");
    ck(lines(t, n) == 10, "row-count");
    ck(rowcount(t, n, "cx/os/cmt.cx\t6\tcm\tunknown\tyes") == 1, "trailing-comment-is-named-reason");
    ck(!hasl(t, "cx/os/cmt.cx\t1\t") && !hasl(t, "cx/os/cmt.cx\t3\t"), "pure-comment-lines-not-sites");
    ck(!hasl(t, "cx/os/cmt.cx\t4\t"), "string-literal-not-site");
    ck(rowcount(t, n, "cx/os/cmt.cx\t2\t-\tunknown\tno") == 0, "block-comment-opener-not-site");
    ck(rowpos(t, n, "cx/os/plain.cx\t3\tplain_fn\tunknown\tno") < rowpos(t, n, "cx/sys/foo_osx.cx\t2\tosx_open\tosx\tyes"), "sorted-bytewise");
    ck(rowpos(t, n, "cx/sys/README.md\t2\t-\tunknown\tno") < rowpos(t, n, "cx/sys/foo_osx.cx\t2\tosx_open\tosx\tyes"), "uppercase-sorts-first");
    put("build/enosys-sites.tsv", "tampered\n");
    rc = run(dir, "--check", out, sizeof out);
    ck(rc == 1 && hasl(out, "DIFF\tbuild/enosys-sites.tsv"), "tamper-detected");
    rc = run(dir, "--bogus", out, sizeof out);
    ck(rc == 2, "usage-rc2");
    rc = run(".", "--check", out, sizeof out);
    ck(rc == 0, "repo-table-current");
    sy_printf("ENOSYS_SITES\tok=%d\tfailed=%d\n", nok, failed);
    return failed ? 1 : 0;
}
