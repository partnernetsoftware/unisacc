#pragma unisa module ownernorm

/* Shared freeze-owner identity: trim ASCII blanks and lowercase printable bytes. */
int norm_owner(const char *raw, char *out, size_t cap) {
    const char *s, *e; size_t n = 0;
    if (!raw || !out || cap < 2) return 0;
    s = raw;
    while (*s == ' ' || *s == '\t' || *s == '\r' || *s == '\n') s++;
    e = s + strlen(s);
    while (e > s && (e[-1] == ' ' || e[-1] == '\t' || e[-1] == '\r' || e[-1] == '\n')) e--;
    if (e <= s || (size_t)(e - s) >= 64 || (size_t)(e - s) >= cap) return 0;
    for (const char *p = s; p < e; p++) {
        unsigned char c = (unsigned char)*p;
        if (c < 0x21 || c == 0x7f) return 0;
        if (c >= 'A' && c <= 'Z') c = (unsigned char)(c + 32);
        out[n++] = (char)c;
    }
    out[n] = 0;
    return n > 0;
}
