/* tools/preflight.cx -- candidate-chain phase preflight: refuse known hidden input preconditions up front.
 *
 *   sh ./unisacc.com tools/preflight.cx -- RULES.tsv [ROOT=DIR] [BUILD=DIR] [SNAP=DIR] [REV=SHA40] [PKG=FILE]
 *                                            [PHASE=entry|post-snap|pre-p3|post-p3] [--strict]
 *
 * RULES is build/preflight-rules.tsv: a header row, then one rule per row with eight TAB fields
 * phase check evidence_file_line positive_example negative_example error_text assert hook.  Only the
 * assert field is executed; the others are the human contract and error_text is printed on FAIL.
 * The assert field is one operator followed by space separated arguments; $ROOT $BUILD $SNAP $REV $PKG
 * expand from the command line, and a rule that names an unset variable is SKIP (not PASS).
 * hook is the candidate-chain point the rule runs at.  PHASE=H runs only rules whose hook is H and
 * first requires every variable the chain has produced by H (entry: ROOT REV BUILD; post-snap and
 * pre-p3: also SNAP; post-p3: also PKG); a missing one is a FAIL line "var NAME".  --strict makes
 * any SKIP exit 1, so a chain run cannot pass a rule it did not check.
 *
 *   absent P...            every P is absent (only ENOENT counts as absent; other errors FAIL)
 *   present P...           every P exists
 *   exec-if-present P...   every P that exists is a regular file with the owner execute bit
 *   epoch-canonical R      R/unisacc.com.build.json passes pp_execution_record_error (production consumer)
 *   release-rev S REV      S/.release-rev is REV; S/unisacc.com.build.json commit is REV, or the
 *                          environment BOOTSTRAP_FROM equals that commit and it is an ancestor of REV
 *   src-has F TEXT...      file F contains TEXT (the rest of the field, spaces kept)
 *   src-lacks F TEXT...    file F does not contain TEXT (a removed hazard must stay removed)
 *   pkg-headers P          P4 package P names the embedded headers hdr/cx.h and hdr/cx-flat.h;
 *                          detail carries the package bytes and sha256 as evidence
 *   env-set NAME VALUE     environment NAME is set and equals VALUE (unset or different FAILs)
 *   receipt-if-present D F D absent, or D exists and holds F (a leftover exclusive output dir without
 *                          its receipt blocks the producer that refuses an existing NEW_OUT)
 *   dir-not-symlink P       P exists as a real directory; a symlink is refused
 * Prints PASS|FAIL|SKIP<TAB>row<TAB>phase<TAB>assert[<TAB>detail<TAB>error_text] per rule and
 * PREFLIGHT<TAB>failed=N<TAB>skipped=M<TAB>passed=K.  Exit 0 when failed=0, 1 when a rule failed,
 * 2 on usage or a malformed table.  Reads only; no command it runs exceeds a few seconds. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sys.env
#pragma unisa use cxlib.netpack
#pragma unisa use text.text
#pragma unisa use cxlib.productpkg
#pragma unisa use mem.bytes

static const char *v_root, *v_build, *v_snap, *v_rev, *v_pkg;
static int failed, skipped, passed;
static char detail[4600];

static void die(const char *s) { fprintf(stderr, "preflight: %s\n", s); exit(2); }

/* Expand one $VAR token prefix into OUT; 0 ok, 1 unset variable, -1 too long. */
static int expand(const char *tok, char *out, int cap) {
    const char *name[] = {"$ROOT", "$BUILD", "$SNAP", "$REV", "$PKG"};
    const char *val[5];
    int k;
    val[0] = v_root; val[1] = v_build; val[2] = v_snap; val[3] = v_rev; val[4] = v_pkg;
    for (k = 0; k < 5; k++) {
        size_t l = strlen(name[k]);
        if (!strncmp(tok, name[k], l) && (tok[l] == 0 || tok[l] == '/')) {
            if (!val[k] || !val[k][0]) return 1;
            return cx_fmt(out, cap, "%s%s", val[k], tok + l) ? -1 : 0;
        }
    }
    return cx_fmt(out, cap, "%s", tok) ? -1 : 0;
}

static int hex40(const char *s) {
    int i;
    for (i = 0; i < 40; i++) if (!((s[i] >= '0' && s[i] <= '9') || (s[i] >= 'a' && s[i] <= 'f'))) return 0;
    return 1;
}

/* "commit": "X" from a JSON record into C[41]; 0 ok. */
static int json_commit(const char *s, char c[41]) {
    const char *p = strstr(s, "\"commit\": \"");
    if (!p) return -1;
    p += 11;
    if (!hex40(p) || p[40] != '"') return -1;
    if (mm_copy(c, 41, p, 40)) return -1;
    c[40] = 0;
    return 0;
}

static int op_absent(char **a, int n) {
    int i;
    for (i = 0; i < n; i++) {
        sy_stat_t st;
        int r = sy_lstat(a[i], &st);
        if (r == 0) { cx_fmt(detail, sizeof detail, "present: %s", a[i]); return 0; }
        if (r != -ENOENT) { cx_fmt(detail, sizeof detail, "stat errno=%d: %s", -r, a[i]); return 0; }
    }
    return 1;
}

static int op_present(char **a, int n) {
    int i;
    for (i = 0; i < n; i++) {
        sy_stat_t st;
        int r = sy_lstat(a[i], &st);
        if (r) { cx_fmt(detail, sizeof detail, "missing errno=%d: %s", -r, a[i]); return 0; }
    }
    return 1;
}

static int op_exec(char **a, int n) {
    int i;
    for (i = 0; i < n; i++) {
        sy_stat_t st;
        int r = sy_stat(a[i], &st);
        if (r == -ENOENT) continue;
        if (r) { cx_fmt(detail, sizeof detail, "stat errno=%d: %s", -r, a[i]); return 0; }
        if (st.kind != 'f' || !(st.mode & 0100)) {
            cx_fmt(detail, sizeof detail, "not owner-executable mode=%o: %s", st.mode, a[i]);
            return 0;
        }
    }
    return 1;
}

static int op_epoch(const char *root) {
    char path[4400], com[4400], digest[65];
    size_t n = 0;
    sy_stat_t st;
    char *b;
    const char *why;
    int dr;
    if (cx_fmt(path, sizeof path, "%s/unisacc.com.build.json", root) ||
        cx_fmt(com, sizeof com, "%s/unisacc.com", root)) { cx_fmt(detail, sizeof detail, "path"); return 0; }
    if (sy_stat(com, &st) || st.kind != 'f') { cx_fmt(detail, sizeof detail, "no launcher: %s", com); return 0; }
    b = cx_read(path, &n);
    if (!b) { cx_fmt(detail, sizeof detail, "no record: %s", path); return 0; }
    dr = pp_product_digest(root, digest);
    why = pp_execution_record_error(b, n, (size_t)st.size, pp_identity_kind(root), dr ? 0 : digest);
    free(b);
    if (!why) return 1;
    cx_fmt(detail, sizeof detail, "%s: %s", why, path);
    return 0;
}

static int op_rev(const char *snap, const char *rev) {
    char mark[4400], js[4400], c[41];
    size_t n = 0;
    char *m, *j;
    const char *boot;
    int rc;
    if (!hex40(rev) || rev[40]) { cx_fmt(detail, sizeof detail, "REV not 40 hex: %s", rev); return 0; }
    if (cx_fmt(mark, sizeof mark, "%s/.release-rev", snap) || cx_fmt(js, sizeof js, "%s/unisacc.com.build.json", snap)) {
        cx_fmt(detail, sizeof detail, "path"); return 0;
    }
    m = cx_read(mark, &n);
    if (!m || n < 40 || (n > 40 && m[40] != '\n') || strncmp(m, rev, 40)) {
        free(m); cx_fmt(detail, sizeof detail, "REFUSE snap rev mismatch: %s", mark); return 0;
    }
    free(m);
    j = cx_read(js, &n);
    if (!j || json_commit(j, c)) { free(j); cx_fmt(detail, sizeof detail, "REFUSE snap receipt: %s", js); return 0; }
    free(j);
    if (tx_eqz(c, rev)) return 1;
    boot = sy_env("BOOTSTRAP_FROM");
    if (!boot || !tx_eqz(boot, c)) {
        cx_fmt(detail, sizeof detail, "receipt commit %s != rev and BOOTSTRAP_FROM unset or different", c);
        return 0;
    }
    {
        np_result r = {0}; char why[512] = {0};
        char *av[] = {"git", "-C", (char *)v_root, "merge-base", "--is-ancestor", c, (char *)rev, 0};
        if (!v_root || !v_root[0]) av[2] = ".";
        rc = np_run(av, ".", 0, 20, &r, why, sizeof why) ? -1 : r.rc;
        np_free(&r);
    }
    if (rc == 0) return 1;
    cx_fmt(detail, sizeof detail, "receipt commit %s is not an ancestor of %s (git rc=%d)", c, rev, rc);
    return 0;
}

static int op_has(const char *file, const char *text) {
    size_t n = 0;
    char *s = cx_read(file, &n);
    int ok;
    if (!s) { cx_fmt(detail, sizeof detail, "unreadable: %s", file); return 0; }
    ok = strstr(s, text) != 0;
    free(s);
    if (!ok) cx_fmt(detail, sizeof detail, "text absent in %s: %s", file, text);
    return ok;
}

static int op_lacks(const char *file, const char *text) {
    size_t n = 0;
    char *s = cx_read(file, &n);
    int ok;
    if (!s) { cx_fmt(detail, sizeof detail, "unreadable: %s", file); return 0; }
    ok = strstr(s, text) == 0;
    free(s);
    if (!ok) cx_fmt(detail, sizeof detail, "text present in %s: %s", file, text);
    return ok;
}

static int op_receipt(const char *dir, const char *name) {
    char p[4400];
    sy_stat_t st;
    int r = sy_lstat(dir, &st);
    if (r == -ENOENT) return 1;
    if (r) { cx_fmt(detail, sizeof detail, "stat errno=%d: %s", -r, dir); return 0; }
    if (cx_fmt(p, sizeof p, "%s/%s", dir, name)) { cx_fmt(detail, sizeof detail, "path"); return 0; }
    r = sy_lstat(p, &st);
    if (r == 0 && st.kind == 'f') return 1;
    cx_fmt(detail, sizeof detail, "leftover without %s: %s", name, dir);
    return 0;
}
static int op_dir_not_symlink(const char *p) {
    sy_stat_t st;
    int r = sy_lstat(p, &st);
    if (r) { cx_fmt(detail, sizeof detail, "missing errno=%d: %s", -r, p); return 0; }
    if (st.kind == 'l') { cx_fmt(detail, sizeof detail, "REFUSE release snapshot path: symlink %s", p); return 0; }
    if (st.kind != 'd') { cx_fmt(detail, sizeof detail, "REFUSE release snapshot path: not a directory %s", p); return 0; }
    return 1;
}
static int op_env(const char *name, const char *want) {
    const char *v = sy_env(name);
    if (!v || !v[0]) { cx_fmt(detail, sizeof detail, "%s unset (want %s)", name, want); return 0; }
    if (!tx_eqz(v, want)) { cx_fmt(detail, sizeof detail, "%s=%s (want %s)", name, v, want); return 0; }
    return 1;
}

/* The embedded header members are named in the P4 index; a package built without them
   (0.0.50 Y-0 p3, 1534381 bytes) makes the downstream ctor fail on "no such file cx.h". */
static int op_pkg(const char *pkg) {
    size_t n = 0;
    char *s = cx_read(pkg, &n), sha[65];
    const char *want[] = {"hdr/cx.h", "hdr/cx-flat.h"};
    int k;
    if (!s) { cx_fmt(detail, sizeof detail, "unreadable: %s", pkg); return 0; }
    if (sy_sha256_hex(s, (long)n, sha)) { free(s); cx_fmt(detail, sizeof detail, "sha: %s", pkg); return 0; }
    for (k = 0; k < 2; k++) {
        if (tx_find(s, (long)n, want[k], (long)strlen(want[k])) < 0) {
            free(s);
            cx_fmt(detail, sizeof detail, "missing %s: %s bytes=%lu sha256=%s", want[k], pkg, (unsigned long)n, sha);
            return 0;
        }
    }
    free(s);
    return 1;
}

/* Run one assert field; 1 PASS, 0 FAIL, -1 SKIP (unset variable). */
static int run_assert(char *f, int row) {
    static char buf[16][4400];
    char *tok[16], *rest = 0, *p = f, *op;
    int n = 0, k, r;
    while (*p == ' ') p++;
    op = p;
    while (*p && *p != ' ') p++;
    if (*p) *p++ = 0;
    if (tx_eqz(op, "src-has") || tx_eqz(op, "src-lacks")) {
        while (*p == ' ') p++;
        tok[0] = p;
        while (*p && *p != ' ') p++;
        if (*p) *p++ = 0;
        rest = p;
        n = 1;
    } else {
        while (*p) {
            while (*p == ' ') p++;
            if (!*p) break;
            if (n >= 16) die("too many arguments");
            tok[n++] = p;
            while (*p && *p != ' ') p++;
            if (*p) *p++ = 0;
        }
    }
    for (k = 0; k < n; k++) {
        r = expand(tok[k], buf[k], sizeof buf[k]);
        if (r < 0) die("argument too long");
        if (r > 0) { cx_fmt(detail, sizeof detail, "unset variable in %s", tok[k]); return -1; }
        tok[k] = buf[k];
    }
    detail[0] = 0;
    if (tx_eqz(op, "absent") && n) return op_absent(tok, n);
    if (tx_eqz(op, "present") && n) return op_present(tok, n);
    if (tx_eqz(op, "exec-if-present") && n) return op_exec(tok, n);
    if (tx_eqz(op, "epoch-canonical") && n == 1) return op_epoch(tok[0]);
    if (tx_eqz(op, "release-rev") && n == 2) return op_rev(tok[0], tok[1]);
    if (tx_eqz(op, "src-has") && n == 1 && rest && *rest) return op_has(tok[0], rest);
    if (tx_eqz(op, "src-lacks") && n == 1 && rest && *rest) return op_lacks(tok[0], rest);
    if (tx_eqz(op, "pkg-headers") && n == 1) return op_pkg(tok[0]);
    if (tx_eqz(op, "env-set") && n == 2) return op_env(tok[0], tok[1]);
    if (tx_eqz(op, "receipt-if-present") && n == 2) return op_receipt(tok[0], tok[1]);
    if (tx_eqz(op, "dir-not-symlink") && n == 1) return op_dir_not_symlink(tok[0]);
    fprintf(stderr, "preflight: row %d: unknown or malformed assert: %s\n", row, op);
    exit(2);
}

/* Variables a hook point must have: by then the chain has produced them (phase table of
   tools/candidate-chain.cx), so a missing one is a broken chain state, not a SKIP. */
static int hook_vars(const char *hook) {
    struct { const char *name; const char **v; const char *hooks; } need[] = {
        {"ROOT", &v_root, "entry post-snap pre-p3 post-p3"},
        {"REV", &v_rev, "entry post-snap pre-p3 post-p3"},
        {"BUILD", &v_build, "entry post-snap pre-p3 post-p3"},
        {"SNAP", &v_snap, "post-snap pre-p3 post-p3"},
        {"PKG", &v_pkg, "post-p3"},
    };
    int k, bad = 0;
    for (k = 0; k < 5; k++) {
        if (!strstr(need[k].hooks, hook)) continue;
        if (!*need[k].v || !(*need[k].v)[0]) {
            printf("FAIL\t0\t%s\tvar %s\tunset at hook %s\n", hook, need[k].name, hook);
            bad++;
        }
    }
    return bad;
}

int main(int argc, char **argv) {
    size_t n = 0;
    char *s, *line;
    const char *phase = 0;
    int i, row = 0, strict = 0, hooks_ok = 0;
    if (argc < 2) die("usage: RULES.tsv [ROOT=DIR] [BUILD=DIR] [SNAP=DIR] [REV=SHA40] [PKG=FILE] [PHASE=entry|post-snap|pre-p3|post-p3] [--strict]");
    for (i = 2; i < argc; i++) {
        if (!strncmp(argv[i], "ROOT=", 5)) v_root = argv[i] + 5;
        else if (!strncmp(argv[i], "BUILD=", 6)) v_build = argv[i] + 6;
        else if (!strncmp(argv[i], "SNAP=", 5)) v_snap = argv[i] + 5;
        else if (!strncmp(argv[i], "REV=", 4)) v_rev = argv[i] + 4;
        else if (!strncmp(argv[i], "PKG=", 4)) v_pkg = argv[i] + 4;
        else if (!strncmp(argv[i], "PHASE=", 6)) phase = argv[i] + 6;
        else if (tx_eqz(argv[i], "--strict")) strict = 1;
        else die("unknown argument (expected ROOT= BUILD= SNAP= REV= PKG= PHASE= --strict)");
    }
    if (phase && !tx_eqz(phase, "entry") && !tx_eqz(phase, "post-snap") && !tx_eqz(phase, "pre-p3") && !tx_eqz(phase, "post-p3"))
        die("PHASE must be entry, post-snap, pre-p3 or post-p3");
    if (phase) failed += hook_vars(phase);
    s = cx_read(argv[1], &n);
    if (!s || !n || s[n - 1] != '\n' || memchr(s, 0, n) || memchr(s, '\r', n)) die("rules table unreadable or not LF text");
    for (line = s; *line; ) {
        char *end = strchr(line, '\n'), *f[8], *p;
        int k, r;
        *end = 0;
        p = line;
        for (k = 0; k < 8; k++) {
            f[k] = p;
            p = strchr(p, '\t');
            if (k < 7) { if (!p) die("rules row needs eight TAB fields"); *p++ = 0; }
            else if (p) die("rules row has more than eight fields");
        }
        if (row == 0) {
            if (!tx_eqz(f[0], "phase") || !tx_eqz(f[5], "error_text") || !tx_eqz(f[6], "assert") || !tx_eqz(f[7], "hook")) die("rules header");
        } else if (!tx_eqz(f[7], "entry") && !tx_eqz(f[7], "post-snap") && !tx_eqz(f[7], "pre-p3") && !tx_eqz(f[7], "post-p3")) {
            fprintf(stderr, "preflight: row %d: unknown hook %s\n", row, f[7]);
            exit(2);
        } else if (!phase || tx_eqz(phase, f[7])) {
            char shown[4400];
            hooks_ok++;
            cx_fmt(shown, sizeof shown, "%s", f[6]);
            r = run_assert(f[6], row);
            if (r > 0) { passed++; printf("PASS\t%d\t%s\t%s\n", row, f[0], shown); }
            else if (r < 0) { skipped++; printf("SKIP\t%d\t%s\t%s\t%s\n", row, f[0], shown, detail); }
            else { failed++; printf("FAIL\t%d\t%s\t%s\t%s\t%s\n", row, f[0], shown, detail, f[5]); }
        }
        row++;
        line = end + 1;
    }
    free(s);
    if (row < 2) die("rules table has no rules");
    if (phase && !hooks_ok) die("no rule carries this hook");
    printf("PREFLIGHT\tfailed=%d\tskipped=%d\tpassed=%d%s\n", failed, skipped, passed, strict ? "\tstrict=1" : "");
    return failed || (strict && skipped) ? 1 : 0;
}
