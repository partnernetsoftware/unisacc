/* Check unit-limit literals in the product driver and module planner. */
#pragma unisa use text.text
static int literal(const char *s) {
    int i;
    for (i = 0; s[i]; i++) if ((i == 0 || !(s[i-1] >= '0' && s[i-1] <= '9')) &&
        (!strncmp(s+i,"63",2) || !strncmp(s+i,"64",2) || !strncmp(s+i,"96",2) || !strncmp(s+i,"128",3))) {
        int n = s[i] == '1' ? 3 : 2;
        if (!(s[i+n] >= '0' && s[i+n] <= '9')) return 1;
    }
    return 0;
}
static int check(const char *path) {
    FILE *f = fopen(path,"r"); char line[4096]; int no = 0, bad = 0;
    if (!f) { fprintf(stderr,"unit-limit: cannot read %s\n",path); return 1; }
    while (fgets(line,sizeof line,f)) {
        int relevant; no++;
        relevant = strstr(line,"dv_srcv[") || strstr(line,"*nsrc >") || strstr(line,"nsrc >") ||
                   strstr(line,"*nu >") || strstr(line,"cxm_n >=") || strstr(line,"u >= CXM_MAXU") ||
                   strstr(line,"#define CXM_MAXU") || strstr(line,"#define DV_MAXU") ||
                   (strstr(line,"units in one program") && strstr(line,"more than"));
        if (strstr(line, "too many sources (limit 128)") && strstr(line, ">= DV_MAXU")) relevant = 0;
        if (relevant && literal(line)) {
            fprintf(stderr,"unit-limit: %s:%d: bare unit limit\n",path,no); bad++;
        }
    }
    fclose(f); return bad;
}
static int walk(const char *dir, int depth) {
    DIR *d; struct dirent *e; int bad = 0;
    if (depth > 32 || !(d = opendir(dir))) { fprintf(stderr, "unit-limit: cannot open %s\n", dir); return 1; }
    for (;;) {
        char path[4096]; struct stat st; int n; size_t z;
        errno = 0; e = readdir(d);
        if (!e) { if (errno) { fprintf(stderr, "unit-limit: cannot read %s\n", dir); bad++; } break; }
        if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
        n = snprintf(path, sizeof path, "%s/%s", dir, e->d_name);
        if (n < 0 || n >= (int)sizeof path || lstat(path, &st)) { fprintf(stderr, "unit-limit: stat %s\n", dir); bad++; continue; }
        if (S_ISDIR(st.st_mode)) bad += walk(path, depth + 1);
        else if (S_ISREG(st.st_mode)) { z = strlen(path); if (z >= 3 && !strcmp(path + z - 3, ".cx")) bad += check(path); }
    }
    if (closedir(d)) { fprintf(stderr, "unit-limit: close %s\n", dir); bad++; }
    return bad;
}
int main(int argc,char **argv) {
    int i, bad = 0;
    if (argc > 1) { for (i=1;i<argc;i++) bad += check(argv[i]); }
    else { bad += walk("src", 0); bad += walk("cx/compiler", 0); bad += walk("cx/driver", 0); }
    printf("UNIT_LIMIT\tviolations=%d\n",bad); return bad ? 1 : 0;
}
