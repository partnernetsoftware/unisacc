/* Check unit-limit literals in the product driver and module planner. */
#pragma unisa use text.text

static int is_ident_ch(unsigned char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
}

static int is_space_ch(unsigned char c) {
    return c == ' ' || c == '\t';
}

static int is_int_suf(unsigned char c) {
    return c == 'u' || c == 'U' || c == 'l' || c == 'L';
}

static int is_lim_tok(const char *s, size_t idx) {
    const char *q = s + idx;
    size_t n = 0, k = 0;
    if (idx > 0 && is_ident_ch((unsigned char)s[idx - 1])) return 0;
    if (!strncmp(q, "63", 2) || !strncmp(q, "64", 2) || !strncmp(q, "96", 2)) n = 2;
    else if (!strncmp(q, "128", 3)) n = 3;
    else return 0;
    while (k < 3 && is_int_suf((unsigned char)q[n + k])) k++;
    if (is_ident_ch((unsigned char)q[n + k])) return 0;
    return 1;
}

static const char *find_sub(const char *s, const char *pat) {
    size_t i, pl = strlen(pat);
    for (i = 0; s[i]; i++) if (!strncmp(s + i, pat, pl)) return s + i;
    return 0;
}

static void strip_line(const char *raw, char *code, size_t ccap, char *nocom, size_t ncap, int *in_blk) {
    size_t i = 0, ci = 0, ni = 0;
    int in_str = 0, in_chr = 0;
    while (raw[i]) {
        char ch = raw[i];
        if (*in_blk) {
            if (ch == '*' && raw[i + 1] == '/') {
                *in_blk = 0;
                if (ci + 1 < ccap) code[ci++] = ' ';
                if (ni + 1 < ncap) nocom[ni++] = ' ';
                i += 2;
                continue;
            }
            if (ci + 1 < ccap) code[ci++] = ' ';
            if (ni + 1 < ncap) nocom[ni++] = ' ';
            i++;
            continue;
        }
        if (in_str) {
            if (ch == '\\' && raw[i + 1]) {
                if (ci + 1 < ccap) code[ci++] = ' ';
                if (ni + 2 < ncap) { nocom[ni++] = ch; nocom[ni++] = raw[i + 1]; }
                i += 2;
                continue;
            }
            if (ch == '"') in_str = 0;
            if (ci + 1 < ccap) code[ci++] = (ch == '"') ? '"' : ' ';
            if (ni + 1 < ncap) nocom[ni++] = ch;
            i++;
            continue;
        }
        if (in_chr) {
            if (ch == '\\' && raw[i + 1]) {
                if (ci + 1 < ccap) code[ci++] = ' ';
                if (ni + 2 < ncap) { nocom[ni++] = ch; nocom[ni++] = raw[i + 1]; }
                i += 2;
                continue;
            }
            if (ch == '\'') in_chr = 0;
            if (ci + 1 < ccap) code[ci++] = (ch == '\'') ? '\'' : ' ';
            if (ni + 1 < ncap) nocom[ni++] = ch;
            i++;
            continue;
        }
        if (ch == '/' && raw[i + 1] == '/') break;
        if (ch == '/' && raw[i + 1] == '*') {
            *in_blk = 1;
            if (ci + 1 < ccap) code[ci++] = ' ';
            if (ni + 1 < ncap) nocom[ni++] = ' ';
            i += 2;
            continue;
        }
        if (ch == '"') in_str = 1;
        else if (ch == '\'') in_chr = 1;
        if (ci + 1 < ccap) code[ci++] = ch;
        if (ni + 1 < ncap) nocom[ni++] = ch;
        i++;
    }
    code[ci] = 0;
    nocom[ni] = 0;
}

static int match_ident_op_lit(const char *code, const char *ident, int need_star, char op) {
    size_t il = strlen(ident);
    const char *p;
    for (p = find_sub(code, ident); p; p = find_sub(p + il, ident)) {
        size_t off = (size_t)(p - code);
        size_t q = off + il;
        if (off > 0 && is_ident_ch((unsigned char)code[off - 1])) continue;
        if (is_ident_ch((unsigned char)code[q])) continue;
        if (need_star) {
            size_t b = off;
            while (b > 0 && is_space_ch((unsigned char)code[b - 1])) b--;
            if (b == 0 || code[b - 1] != '*') continue;
        }
        while (is_space_ch((unsigned char)code[q])) q++;
        if (op == '>') {
            if (code[q] != '>') continue;
            q++;
            if (code[q] == '>') continue;
            if (code[q] == '=') q++;
        } else if (op == '[') {
            if (code[q] != '[') continue;
            q++;
        } else if (op == '=') {
            if (code[q] != '=' || code[q + 1] == '=') continue;
            q++;
        } else {
            continue;
        }
        while (is_space_ch((unsigned char)code[q])) q++;
        if (is_lim_tok(code, q)) return 1;
    }
    return 0;
}

static int match_define_lit(const char *code, const char *macro) {
    size_t q = 0, ml = strlen(macro);
    while (is_space_ch((unsigned char)code[q])) q++;
    if (code[q] != '#') return 0;
    q++;
    while (is_space_ch((unsigned char)code[q])) q++;
    if (strncmp(code + q, "define", 6) != 0) return 0;
    q += 6;
    if (!is_space_ch((unsigned char)code[q])) return 0;
    while (is_space_ch((unsigned char)code[q])) q++;
    if (strncmp(code + q, macro, ml) != 0) return 0;
    q += ml;
    if (!is_space_ch((unsigned char)code[q])) return 0;
    while (is_space_ch((unsigned char)code[q])) q++;
    return is_lim_tok(code, q);
}

static int match_prose_lit(const char *nocom) {
    const char *p;
    if (!find_sub(nocom, "units in one program")) return 0;
    for (p = find_sub(nocom, "more than"); p; p = find_sub(p + 9, "more than")) {
        size_t q = (size_t)(p - nocom) + 9;
        if (!is_space_ch((unsigned char)nocom[q])) continue;
        while (is_space_ch((unsigned char)nocom[q])) q++;
        if (is_lim_tok(nocom, q)) return 1;
    }
    return 0;
}

static int line_bad_state(const char *line, int *in_blk) {
    char code[4096], nocom[4096];
    int relevant;
    strip_line(line, code, sizeof code, nocom, sizeof nocom, in_blk);
    if (find_sub(nocom, "too many sources (limit %d)") && find_sub(code, "DV_MAXU")) return 0;
    relevant = match_ident_op_lit(code, "dv_srcv", 0, '[') ||
               match_ident_op_lit(code, "nsrc", 1, '>') ||
               match_ident_op_lit(code, "nsrc", 0, '>') ||
               match_ident_op_lit(code, "nu", 1, '>') ||
               match_ident_op_lit(code, "cxm_n", 0, '>') ||
               match_define_lit(code, "CXM_MAXU") ||
               match_define_lit(code, "DV_MAXU") ||
               match_ident_op_lit(code, "CXM_MAXU", 0, '=') ||
               match_ident_op_lit(code, "DV_MAXU", 0, '=') ||
               match_prose_lit(nocom);
    return relevant ? 1 : 0;
}

static int line_bad(const char *line) {
    int in_blk = 0;
    return line_bad_state(line, &in_blk);
}

static int selftest(void) {
    static const char *pos[] = {
        "        ((fwd || nsrc > 1) && ((cxt_text(tgt, 0, nsrc > 1 ? nsrc : 2, warn, lvl, r2, 96, why2, 128) == 0 && cxn_probe_route(pm_along, r2, preason, 128)) ||\n",
        "        (mode2 == 3 && nsrc > 1 && cxt_text(tgt, 5, 1, warn, lvl, r2, 96, why2, 128) == 0 && cxn_probe_route(pm_along, r2, preason, 128)))) ||\n",
        "        ((fwd || nsrc > 1) && tgt && (tl = tx_len(tgt, 80)) > 0 && tl + 6 <= 96 && !tx_copy(ur, 96, tgt, tl) && !tx_copy(ur + tl, 96 - tl, \"/unit\", 5) && cxn_probe_route(pm_along, ur, preason, 128))) : 0;\n",
        "if (*nu > 62) return 1;\n",
        "if (*nsrc >= 65) return 1;\n",
        "#define CXM_MAXU 95\n",
        "#define CXM_MAXU 97\n",
        "static const char *dv_srcv[127];\n",
        "if (nsrc >= 129) return 1;\n",
        "enum { CXM_MAXU = 256, DV_MAXU = CXM_MAXU };\n",
        "if (xnsrc >= 64) return 1;\n",
        "if (nsrc >= 0x64) return 1;\n",
        "if (u >= CXM_MAXU) { char buf[96]; return 1; }\n",
        "// if (nsrc >= 64) return 1;\n",
        "/* #define CXM_MAXU 96 */\n",
        "const char *s = \"nsrc >= 64\";\n",
        0
    };
    static const char *neg[] = {
        "if (*nu > 63) return 1;\n",
        "if (*nsrc >= 64) return 1;\n",
        "#define CXM_MAXU 96\n",
        "static const char *dv_srcv[128];\n",
        "if (nsrc >= 128) return 1;\n",
        "if (nsrc>=64) return 1;\n",
        "if (*nu>63) return 1;\n",
        "if (cxm_n>=96) return 1;\n",
        "static const char *dv_srcv [ 128 ];\n",
        "#define\tDV_MAXU\t64\n",
        "enum { CXM_MAXU = 96 };\n",
        "cxm_m(\"more than 64 units in one program\");\n",
        "if (nsrc >= 64) /* ok */ return 1;\n",
        0
    };
    int i, bad = 0, blk = 0;
    for (i = 0; pos[i]; i++) if (line_bad(pos[i])) { fprintf(stderr, "unit-limit: selftest-pos:%d: false positive\n", i + 1); bad++; }
    for (i = 0; neg[i]; i++) if (!line_bad(neg[i])) { fprintf(stderr, "unit-limit: selftest-neg:%d: missed violation\n", i + 1); bad++; }
    if (line_bad_state("/* start\n", &blk)) { fprintf(stderr, "unit-limit: selftest-blk:1: false positive\n"); bad++; }
    if (line_bad_state("if (*nu > 63) return 1;\n", &blk)) { fprintf(stderr, "unit-limit: selftest-blk:2: false positive\n"); bad++; }
    if (line_bad_state("end */ if (nsrc >= 64) return 1;\n", &blk) == 0) { fprintf(stderr, "unit-limit: selftest-blk:3: missed violation\n"); bad++; }
    return bad;
}

static int check(const char *path) {
    FILE *f = fopen(path,"r"); char line[4096]; int no = 0, bad = 0, in_blk = 0;
    if (!f) { fprintf(stderr,"unit-limit: cannot read %s\n",path); return 1; }
    while (fgets(line,sizeof line,f)) {
        no++;
        if (line_bad_state(line, &in_blk)) {
            fprintf(stderr,"unit-limit: %s:%d: bare unit limit\n",path,no); bad++;
        }
    }
    fclose(f); return bad;
}

static int walk(const char *dir, int depth) {
    DIR *d; struct dirent *e; int bad = 0;
    if (depth > 32 || !(d = opendir(dir))) { fprintf(stderr, "unit-limit: cannot open %s\n", dir); return 1; }
    for (;;) {
        char path[4096]; struct stat st; size_t z;
        errno = 0; e = readdir(d);
        if (!e) { if (errno) { fprintf(stderr, "unit-limit: cannot read %s\n", dir); bad++; } break; }
        if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
        if (cx_fmt(path, sizeof path, "%s/%s", dir, e->d_name) || lstat(path, &st)) { fprintf(stderr, "unit-limit: stat %s\n", dir); bad++; continue; }
        if (S_ISDIR(st.st_mode)) bad += walk(path, depth + 1);
        else if (S_ISREG(st.st_mode)) { z = strlen(path); if (z >= 3 && !strcmp(path + z - 3, ".cx")) bad += check(path); }
    }
    if (closedir(d)) { fprintf(stderr, "unit-limit: close %s\n", dir); bad++; }
    return bad;
}

int main(int argc,char **argv) {
    int i, bad = 0;
    if (argc == 2 && !strcmp(argv[1], "--self-test")) {
        bad = selftest();
        printf("UNIT_LIMIT_SELFTEST\tpos=16\tneg=13\tblk=3\tviolations=%d\n", bad);
        return bad ? 1 : 0;
    }
    if (argc > 1) { for (i=1;i<argc;i++) bad += check(argv[i]); }
    else { bad += selftest(); bad += walk("src", 0); bad += walk("cx/compiler", 0); bad += walk("cx/driver", 0); }
    printf("UNIT_LIMIT\tviolations=%d\n",bad); return bad ? 1 : 0;
}
