                    cx_fmt(link, sizeof link, "%s/build-work", rdir) || sy_symlink(elsewhere, link) || cx_fmt(lfile, sizeof lfile, "%s/b-2.tmp", rdir) || cx_write(lfile, "t\n", 2)) return 2;
                krc = sh(kcmd, out, sizeof out);
                ck(krc != 0 && has(out, "REFUSE residue link outside output") && !has(out, "CLEANUP\t") && sy_exists(victim) == 1 && sy_exists(lfile) == 1, "residue-link-outside-output-refused-nothing-removed");
                /* outside the output dir: the listed directory is reached through a link that leaves it */
                if (cx_fmt(lout, sizeof lout, "%s/rl-out", td) || sy_mkdir(lout, 0755) || cx_fmt(ldir, sizeof ldir, "%s/stage", lout) || sy_symlink(elsewhere, ldir) ||
                    cx_fmt(lg, sizeof lg, "%s/build-work", elsewhere) || sy_mkdir(lg, 0755) || cx_fmt(lfile, sizeof lfile, "%s/b-3.tmp", elsewhere) || cx_write(lfile, "t\n", 2) ||
