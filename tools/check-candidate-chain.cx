/* tools/check-candidate-chain.cx -- candidate-chain 负控夹具，不跑全链。
 *   sh ./unisacc.com tools/check-candidate-chain.cx
 */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sys.io
#pragma unisa use sys.sha
#pragma unisa use text.text
#pragma unisa use mem.bytes

static int failed;
static void ck(int ok, const char *n) {
    if (ok) sy_printf("PASS\tcheck-candidate-chain.%s\n", n);
    else { failed++; sy_printf("FAIL\tcheck-candidate-chain.%s\n", n); }
}
static int sh(const char *cmd, char *out, size_t cap) {
    char *v[] = {"sh", "-c", (char *)cmd, 0};
    char *o = 0;
    size_t n = 0;
    int rc = cx_runv_timeout(v, 50, &o, &n);
    if (out) {
        out[0] = 0;
        if (o && n < cap) { mm_copy(out, cap, o, n); out[n] = 0; }
    }
    free(o);
    return rc;
}
static int has(const char *h, const char *n) {
    return tx_find(h, tx_len(h, 100000), n, tx_len(n, 80)) >= 0;
}

int main(void) {
    char cwd[400], com[500], tool[500], out[8192], *o = 0;
    size_t n = 0;
    const char *rev = "979b56e4d918894670a71080970149112499d223";
    { char *v[] = {"pwd", 0};
      if (cx_runv_timeout(v, 10, &o, &n) != 0 || n < 2 || n >= sizeof cwd) { ck(0, "cwd"); return 1; }
      mm_copy(cwd, sizeof cwd, o, n); cwd[n] = 0;
      { size_t i; for (i = 0; cwd[i]; i++) if (cwd[i] == '\n') cwd[i] = 0; }
    }
    if (cx_fmt(com, sizeof com, "%s/unisacc.com", cwd) || cx_fmt(tool, sizeof tool, "%s/tools/candidate-chain.cx", cwd)) {
        ck(0, "path"); return 1;
    }
    { char cmd[1800];
      if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- --plan 2>&1", com, tool)) { ck(0, "fmt"); return 1; }
      ck(sh(cmd, out, sizeof out) == 0 && has(out, "phases=35") && has(out, "g2-osx-x86_64") && has(out, "g3-win-arm64") && has(out, "warmup") && has(out, "gen1-lnx-arm64") && has(out, "child_bound=55"), "plan"); }
    { char cmd[1800];
      if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- 2>&1", com, tool)) { ck(0, "fmt"); return 1; }
      ck(sh(cmd, out, sizeof out) != 0 && has(out, "REFUSE") && has(out, "--rev"), "missing-rev"); }
    { char cmd[1800];
      if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- --rev not-a-rev --out /tmp/cc-x 2>&1", com, tool)) { ck(0, "fmt"); return 1; }
      ck(sh(cmd, out, sizeof out) != 0 && has(out, "REFUSE"), "bad-rev"); }
    { char cmd[1800];
      if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- --rev 979b56e4d918894670a71080970149112499d223 --out /tmp/cc-x --bogus 2>&1", com, tool)) { ck(0, "fmt"); return 1; }
      ck(sh(cmd, out, sizeof out) != 0 && has(out, "unknown"), "unknown-opt"); }
    { char cmd[1800];
      if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- --rev 979b56e4d918894670a71080970149112499d223 --out /tmp/cc-x --parallel 99 2>&1", com, tool)) { ck(0, "fmt"); return 1; }
      ck(sh(cmd, out, sizeof out) != 0 && has(out, "parallel"), "parallel-range"); }
    {
      char td[320], ape[400], js[400], mk[400], srcp[400], hp[400], hash[65], sidh[65], json[800], cmd[2400];
      const char *payload = "product-input\n";
      const char *srcbody = "src-a\n";
      const char *helptxt = "#!/bin/sh\nset -- `sha256sum \"$1/src/a.cx\"`\nprintf '%s\\n' \"$1\"\n";
      long pn = tx_len(payload, 32), sn = tx_len(srcbody, 16);
      if (cx_fmt(td, sizeof td, "%s/cc-snap-XXXXXX", sy_tmpdir()) || !mkdtemp(td)) { ck(0, "tmpdir"); return 1; }
      if (cx_fmt(ape, sizeof ape, "%s/unisacc.com", td) || cx_fmt(js, sizeof js, "%s/unisacc.com.build.json", td)
          || cx_fmt(mk, sizeof mk, "%s/.release-rev", td) || cx_fmt(srcp, sizeof srcp, "%s/src/a.cx", td)
          || cx_fmt(hp, sizeof hp, "%s/ident-helper", td)) { ck(0, "fmt"); return 1; }
      { char sd[400]; if (cx_fmt(sd, sizeof sd, "%s/src", td) || sy_mkdir(sd, 0755)) { ck(0, "mkdirsrc"); return 1; } }
      if (cx_write(ape, payload, pn) || cx_write(mk, rev, 40) || cx_write(srcp, srcbody, sn) || cx_write(hp, helptxt, tx_len(helptxt, 200))) { ck(0, "write"); return 1; }
      if (sy_sha256_hex(payload, pn, hash) || sy_sha256_hex(srcbody, sn, sidh)) { ck(0, "sha"); return 1; }
      if (cx_fmt(json, sizeof json,
          "{\n  \"bytes\": %ld,\n  \"commit\": \"%s\",\n  \"schema\": 1,\n  \"settings\": {},\n  \"sources_sha256\": \"%s\",\n  \"product_kind\": \"ape1\",\n  \"product_digest\": \"%s\"\n}\n",
          pn, rev, sidh, hash)) { ck(0, "json"); return 1; }
      if (cx_write(js, json, tx_len(json, 800))) { ck(0, "jsonw"); return 1; }
      if (cx_fmt(cmd, sizeof cmd, "chmod +x '%s' && sh '%s' '%s' -- --verify-snap '%s' %s --identity-helper '%s' 2>&1", hp, com, tool, td, rev, hp)) { ck(0, "fmt"); return 1; }
      ck(sh(cmd, out, sizeof out) == 0 && has(out, "SNAP_OK") && has(out, "live_sid=") && has(out, "record_sid="), "snap-ok");
      if (cx_write(srcp, "src-a-tampered\n", 15)) { ck(0, "tamper-src"); return 1; }
      ck(sh(cmd, out, sizeof out) == 0 && has(out, "SNAP_OK"), "snap-source-sid-diff-ok");
      if (cx_write(srcp, srcbody, sn) || cx_write(ape, "tampered-product-input\n", 23)) { ck(0, "tamper-ape"); return 1; }
      ck(sh(cmd, out, sizeof out) != 0 && has(out, "REFUSE") && has(out, "SHA"), "snap-tamper-refuse");
      if (cx_write(ape, payload, pn)) { ck(0, "restore-ape"); return 1; }
      if (cx_fmt(json, sizeof json,
          "{\n  \"bytes\": %ld,\n  \"commit\": \"%s\",\n  \"schema\": 1,\n  \"settings\": {},\n  \"sources_sha256\": \"%s\",\n  \"product_kind\": \"ape1\",\n  \"product_digest\": \"%s\"\n}\n",
          pn, "0000000000000000000000000000000000000000", sidh, hash)) { ck(0, "json-anc"); return 1; }
      if (cx_write(js, json, tx_len(json, 800))) { ck(0, "jsonw-anc"); return 1; }
      ck(sh(cmd, out, sizeof out) != 0 && has(out, "REFUSE") && has(out, "ancestor"), "snap-commit-not-ancestor-refuse");
    }
    {
      char tp[500], *tb, th[65], td[500], bad[600], cmd[2400];
      size_t tn = 0;
      const char *want = "ca2c54a6938c498093e2962bbc1c19c24c6e730266b60d471265cbc6d43a3982";
      if (cx_fmt(tp, sizeof tp, "%s/tools/templates/whole-front.cx.in", cwd)) { ck(0, "tmplpath"); return 1; }
      tb = cx_read(tp, &tn);
      ck(tb && !sy_sha256_hex(tb, (long)tn, th) && tx_eqz(th, want), "template-ca2c54a6");
      if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- --check-template '%s' 2>&1", com, tool, tp)) { ck(0, "fmt"); return 1; }
      ck(sh(cmd, out, sizeof out) == 0 && has(out, "WF_PREP_G2_TEMPLATE_OK"), "g2-prepare-template-ok");
      if (cx_fmt(td, sizeof td, "%s/cc-tmpl-XXXXXX", sy_tmpdir()) || !mkdtemp(td) || cx_fmt(bad, sizeof bad, "%s/whole-front.cx.in", td)) { ck(0, "tmpl-tmp"); return 1; }
      if (!tb || !tn) { ck(0, "tmpl-copy"); return 1; }
      tb[0] = (char)(tb[0] ^ 1);
      if (cx_write(bad, tb, tn)) { ck(0, "tmpl-write"); return 1; }
      if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- --check-template '%s' 2>&1", com, tool, bad)) { ck(0, "fmt"); return 1; }
      ck(sh(cmd, out, sizeof out) != 0 && has(out, "REFUSE") && has(out, "template SHA"), "g2-prepare-template-byte-refuse");
      free(tb);
    }
    {
      char td[500], bad[600], good[600], bo[600], go[600], sc[900], cmd[2400];
      const char *env;
      const char *bs = ".text\n.globl foo\nfoo:\ncall setpgid\n";
      const char *gs = ".text\n.globl foo\nfoo:\ncall sy_foo\n";
      if (cx_fmt(td, sizeof td, "%s/cc-nm-XXXXXX", sy_tmpdir()) || !mkdtemp(td)) { ck(0, "nm-tmpdir"); return 1; }
      if (cx_fmt(bad, sizeof bad, "%s/bad.s", td) || cx_fmt(good, sizeof good, "%s/good.s", td)
          || cx_fmt(bo, sizeof bo, "%s/bad.o", td) || cx_fmt(go, sizeof go, "%s/good.o", td)) { ck(0, "nm-path"); return 1; }
      if (cx_write(bad, bs, tx_len(bs, 80)) || cx_write(good, gs, tx_len(gs, 80))) { ck(0, "nm-src"); return 1; }
      if (cx_fmt(sc, sizeof sc, "as -o '%s' '%s' && as -o '%s' '%s'", bo, bad, go, good)) { ck(0, "nm-as"); return 1; }
      if (sh(sc, out, sizeof out)) { ck(0, "nm-as-run"); return 1; }
      if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- --worker-nm '%s' 2>&1", com, tool, bo)) { ck(0, "fmt"); return 1; }
      ck(sh(cmd, out, sizeof out) != 0 && has(out, "setpgid"), "worker-nm-setpgid-refuse");
      if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- --worker-nm '%s' 2>&1", com, tool, go)) { ck(0, "fmt"); return 1; }
      ck(sh(cmd, out, sizeof out) == 0 && has(out, "WORKER_NM_OK"), "worker-nm-sy-ok");
      env = getenv("CHAIN_WORKER_O_GOOD");
      if (!env || !env[0]) sy_printf("SKIP\tcheck-candidate-chain.worker-nm-good-env\n");
      else {
        if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- --worker-nm '%s' 2>&1", com, tool, env)) { ck(0, "fmt"); return 1; }
        ck(sh(cmd, out, sizeof out) == 0 && has(out, "WORKER_NM_OK"), "worker-nm-good-env");
      }
    }
    {
        char td[400], o[500], w[500], ckf[600], d1[600], d2[600], d3[600], rc[600], outside[500], cmd[3000];
        const char *done = "DONE\tdoneph\twall_ms=1\tsha=-\n";
        if (cx_fmt(td, sizeof td, "%s/cc-clean-XXXXXX", sy_tmpdir()) || !mkdtemp(td)) { ck(0, "clean-tmpdir"); return 1; }
        if (cx_fmt(o, sizeof o, "%s/o", td) || cx_fmt(w, sizeof w, "%s/w", td) || cx_fmt(ckf, sizeof ckf, "%s/checkpoint.tsv", o)
            || cx_fmt(d1, sizeof d1, "%s/build/outer", o) || cx_fmt(d2, sizeof d2, "%s/done-dir", o)
            || cx_fmt(d3, sizeof d3, "%s/wf-prep", w) || cx_fmt(rc, sizeof rc, "%s/receipt.txt", d3)
            || cx_fmt(outside, sizeof outside, "%s/outside", td)) { ck(0, "clean-fmt"); return 1; }
        if (cx_fmt(cmd, sizeof cmd, "mkdir -p '%s/x' '%s/x' '%s' '%s' '%s' && : > '%s/x/f'", d1, d2, d3, w, outside, d1)) { ck(0, "clean-fmt"); return 1; }
        if (sh(cmd, out, sizeof out) || cx_write(ckf, done, tx_len(done, 100))) { ck(0, "clean-setup"); return 1; }
        /* 未 DONE 相位的残留被清理并打印 CLEANUP */
        if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- --clean-phase '%s' '%s' list '%s' - 2>&1; test ! -e '%s'", com, tool, o, w, d1, d1)) { ck(0, "fmt"); return 1; }
        ck(sh(cmd, out, sizeof out) == 0 && has(out, "CLEANUP\tlist\t"), "clean-undone-removed");
        /* 已 DONE 相位不动 */
        if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- --clean-phase '%s' '%s' doneph '%s' - 2>&1; test -d '%s/x'", com, tool, o, w, d2, d2)) { ck(0, "fmt"); return 1; }
        ck(sh(cmd, out, sizeof out) == 0 && !has(out, "CLEANUP"), "clean-done-kept");
        /* 快照树 out/chain 内、有完成收据的不动;无收据则清理 */
        if (cx_write(rc, "r\n", 2)) { ck(0, "clean-rc"); return 1; }
        if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- --clean-phase '%s' '%s' wf-prepare '%s' '%s' 2>&1; test -d '%s'", com, tool, o, w, d3, rc, d3)) { ck(0, "fmt"); return 1; }
        ck(sh(cmd, out, sizeof out) == 0 && !has(out, "CLEANUP"), "clean-receipt-kept");
        if (cx_fmt(cmd, sizeof cmd, "rm -f '%s'; sh '%s' '%s' -- --clean-phase '%s' '%s' wf-prepare '%s' '%s' 2>&1; test ! -e '%s'", rc, com, tool, o, w, d3, rc, d3)) { ck(0, "fmt"); return 1; }
        ck(sh(cmd, out, sizeof out) == 0 && has(out, "CLEANUP\twf-prepare\t"), "clean-workdir-removed");
        /* 越界与含 .. 的路径具名拒绝,目录不被动 */
        if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- --clean-phase '%s' '%s' list '%s' - 2>&1", com, tool, o, w, outside)) { ck(0, "fmt"); return 1; }
        ck(sh(cmd, out, sizeof out) != 0 && has(out, "REFUSE cleanup path outside") && has(out, outside), "clean-outside-refused");
        if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- --clean-phase '%s' '%s' list '%s/../outside' - 2>&1; test -d '%s'", com, tool, o, w, o, outside)) { ck(0, "fmt"); return 1; }
        ck(has(out, "REFUSE cleanup path outside") && sh("true", 0, 0) == 0, "clean-dotdot-refused");
        if (cx_fmt(cmd, sizeof cmd, "test -d '%s/x' -o -d '%s'", d2, outside)) { ck(0, "fmt"); return 1; }
        ck(sh(cmd, 0, 0) == 0, "clean-refused-untouched");
        cx_rmtree(td);
    }
    {
        char cmd[1800];
        if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- --prep-path /w 1 wf-prep 2>&1", com, tool)) { ck(0, "fmt"); return 1; }
        ck(sh(cmd, out, sizeof out) == 0 && has(out, "PREP_PATH\t/w/wf-prep\n"), "gen1-prep-path-unchanged");
        if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- --prep-path /w 2 wf-span-prep 2>&1", com, tool)) { ck(0, "fmt"); return 1; }
        ck(sh(cmd, out, sizeof out) == 0 && has(out, "PREP_PATH\t/w/wf-span-prep-g2\n"), "gen2-prep-path-tagged");
        if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- --prep-path /w 4 wf-prep 2>&1", com, tool)) { ck(0, "fmt"); return 1; }
        ck(sh(cmd, out, sizeof out) != 0 && has(out, "REFUSE gen must be 1..3"), "gen-out-of-range-refused");
    }
    sy_printf("CHECK_CANDIDATE_CHAIN\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
