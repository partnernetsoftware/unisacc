        ck(sh(cmd, out, sizeof out) == 0 && has(out, "PREP_PATH\t/w/wf-prep\n"), "gen1-prep-path-unchanged");
        if (cx_fmt(cmd, sizeof cmd, "'%s' --prep-path /w 2 wf-span-prep 2>&1", native_tool)) { ck(0, "fmt"); return 1; }
        ck(sh(cmd, out, sizeof out) == 0 && has(out, "PREP_PATH\t/w/wf-span-prep-g2\n"), "gen2-prep-path-tagged");
        if (cx_fmt(cmd, sizeof cmd, "'%s' --prep-path /w 4 wf-prep 2>&1", native_tool)) { ck(0, "fmt"); return 1; }
        ck(sh(cmd, out, sizeof out) != 0 && has(out, "REFUSE gen must be 1..3"), "gen-out-of-range-refused");
    }
    {
        char td[4400], fp[4500], gd[4500], manifest[4500], cmd[14000];
        const char *row = "m1.o\t/tmp/unused-phase-parser-source.cx\n";
        if (cx_fmt(td, sizeof td, "%s/cc-dynamic-phase-XXXXXX", sy_tmpdir()) || !mkdtemp(td) || cx_fmt(fp, sizeof fp, "%s/fixedpoint", td) || cx_fmt(gd, sizeof gd, "%s/g2", fp) || cx_fmt(manifest, sizeof manifest, "%s/lnx-x86_64.closures.tsv", gd)) { ck(0, "dynamic-phase-path"); return 1; }
        if (sy_mkdir(fp, 0755) || sy_mkdir(gd, 0755) || cx_write(manifest, row, strlen(row))) { ck(0, "dynamic-phase-setup"); return 1; }
        if (cx_fmt(cmd, sizeof cmd, "'%s' --rev 0000000000000000000000000000000000000000 --out '%s' --until g2-lnx-x86_64-closure-m01.o 2>&1", native_tool, td)) { ck(0, "dynamic-phase-command"); return 1; }
        ck(sh(cmd, out, sizeof out) != 0 && has(out, "REFUSE --until unknown phase"), "dynamic-closure-leading-zero-refused");
        cx_rmtree(td);
    }
    {
        /* pack 切片取址: 只在新位置(chain_work/gen1/...)时找得到;缺失仍拒绝;旧位置不被接受 */
        char cmd[2400], w[600], expected[900];
        if (cx_fmt(w, sizeof w, "%s/cc-slice-XXXXXX", argv[1]) || !mkdtemp(w)) { ck(0, "slice-dir"); return 1; }
        if (cx_fmt(cmd, sizeof cmd, "mkdir -p '%s/gen1/osx-x86_64-b2' '%s/gen1/win-arm64-image' '%s/gen1/osx-arm64' && echo x > '%s/gen1/osx-x86_64-b2/image' && echo y > '%s/gen1/win-arm64-image/image' && echo z > '%s/gen1/osx-arm64/image'", w, w, w, w, w, w)) { ck(0, "fmt"); return 1; }
        if (sh(cmd, out, sizeof out)) { ck(0, "slice-setup"); return 1; }
        if (cx_fmt(cmd, sizeof cmd, "'%s' --slice-path %s osx-x86_64 2>&1", native_tool, w)) { ck(0, "fmt"); return 1; }
        if (cx_fmt(expected, sizeof expected, "SLICE_PATH\t%s/gen1/osx-x86_64-b2/image", w)) return 1;
        ck(sh(cmd, out, sizeof out) == 0 && has(out, expected), "pack-slice-osx-new-location");
        if (cx_fmt(cmd, sizeof cmd, "'%s' --slice-path %s win-arm64 2>&1", native_tool, w)) { ck(0, "fmt"); return 1; }
        if (cx_fmt(expected, sizeof expected, "SLICE_PATH\t%s/gen1/win-arm64-image/image", w)) return 1;
        ck(sh(cmd, out, sizeof out) == 0 && has(out, expected), "pack-slice-win-new-location");
        if (cx_fmt(cmd, sizeof cmd, "'%s' --slice-path %s osx-arm64 2>&1", native_tool, w)) { ck(0, "fmt"); return 1; }
        ck(sh(cmd, out, sizeof out) != 0 && has(out, "REFUSE missing slice image"), "pack-slice-old-location-refused");
        if (cx_fmt(cmd, sizeof cmd, "'%s' --slice-path %s win-x86_64 2>&1", native_tool, w)) { ck(0, "fmt"); return 1; }
        ck(sh(cmd, out, sizeof out) != 0 && has(out, "REFUSE missing slice image"), "pack-slice-missing-refused");
        cx_rmtree(w);
    }
    {
        char td[500], file[600], cmd[2400];
        const char *bad[] = {"1\tsnap\t-\t90\t-\t-\t1\t-\t-\t-\n", "0\tsnap\t-\t91\t-\t-\t1\t-\t-\t-\n", "0\tsnap\t-\t90\t-\t-\t1\t-\t-\t-\n1\tsnap\t-\t90\t-\t-\t1\t-\t-\t-\n", "0\tsnap\t-\t90\t-\t-\t1\t-\t-\t-", "0\tsnap\t-\t90\t-\t-\t1\t-\t-\t-\textra\n", "0\tsnap\t-\t90\t-\t-\t1\n"};
        const char *names[] = {"phase-order-refused", "phase-bound-refused", "phase-duplicate-refused", "phase-missing-lf-refused", "phase-extra-field-refused", "phase-seven-column-table-refused"};
        const char *reasons[] = {"chain-phases order", "chain-phases timeout", "chain-phases duplicate", "chain-phases text", "chain-phases fields", "chain-phases fields"};
        if (cx_fmt(td, sizeof td, "%s/cc-phases-XXXXXX", sy_tmpdir()) || !mkdtemp(td) || cx_fmt(file, sizeof file, "%s/phases.tsv", td)) { ck(0, "phase-tmp"); return 1; }
        for (int j = 0; j < 6; j++) {
            if (cx_write(file, bad[j], strlen(bad[j])) || cx_fmt(cmd, sizeof cmd, "'%s' --plan --phases '%s' 2>&1", native_tool, file)) { ck(0, "phase-fixture"); return 1; }
            ck(sh(cmd, out, sizeof out) != 0 && has(out, reasons[j]), names[j]);
        }
        const char *ordered = "0\tbuild\t-\t90\t-\t-\t1\t-\t-\t-\n1\tsnap\t-\t90\tbuild\t-\t1\t-\t-\t-\n";
        if (cx_write(file, ordered, strlen(ordered)) || cx_fmt(cmd, sizeof cmd, "'%s' --plan --phases '%s' 2>&1", native_tool, file)) { ck(0, "phase-fixture"); return 1; }
        ck(sh(cmd, out, sizeof out) == 0 && has(out, "PHASE\t0\tbuild") && has(out, "PHASE\t1\tsnap"), "phase-order-consumed");
        cx_rmtree(td);
    }
    {
        char cmd[2400];
        if (cx_fmt(cmd, sizeof cmd, "'%s' --check 2>&1", native_generator)) { ck(0, "phase-generator-path"); return 1; }
        ck(sh(cmd, out, sizeof out) == 0 && has(out, "CHAIN_PHASES\tstatus=CHECK"), "phase-generated-table-current");
    }
    {   /* 引导安装:同内容不重写(inode/mtime 不变),异内容重写,无残留临时文件 */
        char td[500], src[600], dst[600], tmpf[700], cmd[2400], a[200], b[200], c[200];
        if (cx_fmt(td, sizeof td, "%s/cc-inst-XXXXXX", sy_tmpdir()) || !mkdtemp(td)
            || cx_fmt(src, sizeof src, "%s/src", td) || cx_fmt(dst, sizeof dst, "%s/dst", td)
            || cx_fmt(tmpf, sizeof tmpf, "%s.tmp-install", dst)) { ck(0, "install-tmp"); return 1; }
        if (cx_write(src, "boot-A\n", 7)) { ck(0, "install-fixture"); return 1; }
        if (cx_fmt(cmd, sizeof cmd, "'%s' --install-file '%s' '%s' 2>&1 && stat -c '%%i %%Y' '%s'", native_tool, src, dst, dst)) { ck(0, "fmt"); return 1; }
        ck(sh(cmd, a, sizeof a) == 0 && has(a, "INSTALL_FILE_OK"), "install-first");
        sh("sleep 1.1", 0, 0);
        ck(sh(cmd, b, sizeof b) == 0 && tx_find(a, tx_len(a, 200), "\n", 1) >= 0 && tx_find(b, tx_len(b, 200), a + tx_find(a, tx_len(a, 200), "\n", 1) + 1, tx_len(a, 200) - tx_find(a, tx_len(a, 200), "\n", 1) - 1) >= 0, "install-same-sha-no-rewrite");
        if (cx_write(src, "boot-B\n", 7)) { ck(0, "install-fixture2"); return 1; }
        ck(sh(cmd, c, sizeof c) == 0 && !has(c, a + tx_find(a, tx_len(a, 200), "\n", 1) + 1), "install-changed-rewritten");
        { size_t dn = 0; char *d = cx_read(dst, &dn); ck(d && dn == 7 && !memcmp(d, "boot-B\n", 7), "install-new-content"); free(d); }
        { sy_stat_t st; ck(sy_stat(tmpf, &st) != 0, "install-no-temp-residue"); }
        cx_rmtree(td);
    }
    sy_printf("CHECK_CANDIDATE_CHAIN\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
