                        "0\tsnap\touter\t90\t-\t-\t1\tscrub\tstage/snap.done\tstage/../../elsewhere\n",
                        "0\tsnap\touter\t90\t-\t-\t1\tscrub\tstage/snap.done\t/tmp/x\n",
