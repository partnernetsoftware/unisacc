            size_t tn = 0; char *tr = cx_read(ytrace, &tn);
            int calls = 0; for (const char *q = tr ? find_sub(tr, "--objects\t") : 0; q; q = find_sub(q + 1, "--objects\t")) calls++;
            ck(yrc == 75 && has(out, "PHASE_YIELD\tfixedpoint-batch") && has(out, want) && !has(out, "status=UNTIL") && calls == 2, "fixedpoint-batches-yield-before-the-attempt-ends");
            free(tr);
            if (cx_fmt(endms, sizeof endms, "%ld", sy_now_ms() + 600000) || sy_setenv("UNISACC_CHAIN_ATTEMPT_END_MS", endms, 1)) return 2;
            if (cx_fmt(ycmd, sizeof ycmd, "'%s' --g2g3-fixture '%s' '%s' '%s' '%s' g2 resume g2-lnx-x86_64-objects 2>&1", candidate, yd, yd, yd, yfp)) return 2;
            yrc = sh(ycmd, out, sizeof out);
