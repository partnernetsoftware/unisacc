                cx_fmt(ycp, sizeof ycp, "%s/checkpoint.tsv", yd) || sy_mkdir(yd, 0755) || sy_mkdir(yfp, 0755)) return 2;
            if (cx_fmt(ypath, sizeof ypath, "%s/g2", yfp) || sy_mkdir(ypath, 0755) || cx_fmt(ypath, sizeof ypath, "%s/build", yd) || sy_mkdir(ypath, 0755) ||
                cx_fmt(ypath, sizeof ypath, "%s/build/g2-budget.tsv", yd) || cx_write(ypath, budget, bn) ||
