/* tools/check-candidate-chain.cx -- candidate-chain 负控夹具，不跑全链。
 *   sh ./unisacc.com tools/check-candidate-chain.cx -- ABS_OUT ABS_CACHE
 */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sys.io
#pragma unisa use sys.sha
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use cxlib.chainfacts
#pragma unisa use sys.posix
#pragma unisa use cxlib.runnerprep

static int failed;
static void ck(int ok, const char *n) {
    if (ok) sy_printf("PASS\tcheck-candidate-chain.%s\n", n);
    else { failed++; sy_printf("FAIL\tcheck-candidate-chain.%s\n", n); }
}
static int sh(const char *cmd, char *out, size_t cap) {
    char *v[] = {"sh", "-c", (char *)cmd, 0};
    char *o = 0;
    size_t n = 0;
    int rc = cx_runv_timeout(v, 50, &o, &n);
    if (out) {
        out[0] = 0;
        if (o && n < cap) { mm_copy(out, cap, o, n); out[n] = 0; }
    }
    free(o);
    return rc;
}
static const char *find_sub(const char *h, const char *n) {
    size_t hl, nl, i;
    if (!h || !n) return 0;
    hl = (size_t)tx_len(h, 100000);
    nl = (size_t)tx_len(n, 256);
    if (!nl) return h;
    if (hl < nl) return 0;
    for (i = 0; i + nl <= hl; i++) if (!memcmp(h + i, n, nl)) return h + i;
    return 0;
}
static int has(const char *h, const char *n) {
    return find_sub(h, n) != 0;
}

int main(int argc, char **argv) {
    char cwd[400], out[65536], *o = 0;
    char native_tool[4400], native_generator[4400];
    size_t n = 0;
    const char *rev = "979b56e4d918894670a71080970149112499d223";
    if (argc == 4 && tx_eqz(argv[1], "--lane-split")) {
        char td[4400], run[4500], phases[4500], candidate[4500], cmd[24000], p[4500], checkpoint[4500], work[4500];
        const char *revision = "979b56e4d918894670a71080970149112499d223";
        if (sy_mkdir(argv[2], 0700) && !sy_exists(argv[2])) return 2;
        if (sy_realpath(".", cwd, sizeof cwd) < 0 || cx_fmt(td, sizeof td, "%s/lane-split-XXXXXX", argv[2]) || !mkdtemp(td) ||
            sy_realpath(td, p, sizeof p) < 0 || tx_copy(td, sizeof td, p, strlen(p)) ||
            cx_fmt(run, sizeof run, "%s/run", td) || sy_mkdir(run, 0755) || cx_fmt(checkpoint, sizeof checkpoint, "%s/checkpoint.tsv", run) ||
            cx_fmt(phases, sizeof phases, "%s/build/chain-phases.tsv", cwd) || sy_realpath(argv[3], candidate, sizeof candidate) < 0) return 2;
        if (cx_fmt(cmd,sizeof cmd,"'%s' --chain-work '%s' %s",candidate,td,revision) || sh(cmd,out,sizeof out)) return 2;
        size_t work_n=strlen(out);
        if (!work_n || out[work_n-1]!='\n' || strchr(out,'\n')!=out+work_n-1 || tx_copy(work,sizeof work,out,work_n-1)) return 2;
        if (cx_fmt(cmd, sizeof cmd, "cd '%s' && '%s' --phases '%s' --rev %s --out '%s' --lane gen1-lnx-arm64 --until gen1-lnx-arm64 --resume 2>&1", td, candidate, phases, revision, run)) return 2;
        ck(sh(cmd, out, sizeof out) != 0 && has(out, "lane dependency incomplete: p3") && !has(out, "PREFLIGHT"), "lane-missing-p3-no-preparation");
        if (cx_fmt(p, sizeof p, "%s/compiler.p4.pkg", run) || cx_write(p, "package", 7) || cx_write(checkpoint, "DONE\tp3\tx\n", 10)) return 2;
        if (cx_fmt(p, sizeof p, "%s/ctx", run) || sy_mkdir(p, 0755) || cx_fmt(p, sizeof p, "%s/ctx/identity-helper", run) || cx_write(p, "helper", 6)) return 2;
        ck(sh(cmd, out, sizeof out) != 0 && has(out, "lane dependency incomplete: build") && !has(out, "RECEIPT"), "lane-does-not-fill-missing-build");
        if (cx_fmt(cmd, sizeof cmd, "mkdir -p '%s/gen1/lnx-x86_64' '%s/wf-prep' '%s/wf-span-prep' '%s/wf-prep-g2' '%s/wf-span-prep-g2' '%s/wf-prep-g3' '%s/wf-span-prep-g3' '%s/fixedpoint/g2/lnx-x86_64' '%s/fixedpoint/g3/lnx-x86_64'", run, work, work, work, work, work, work, run, run) || sh(cmd, out, sizeof out)) return 2;
        const char *rows = "DONE\tp3\tx\nDONE\tgen1-lnx-x86_64\tx\nDONE\tg2-lnx-x86_64\tx\nDONE\tg3-lnx-x86_64\tx\nDONE\twf-prepare\tx\nDONE\twf-span-prep\tx\nDONE\twf-prep-g2\tx\nDONE\twf-span-prep-g2\tx\nDONE\twf-prep-g3\tx\nDONE\twf-span-prep-g3\tx\n";
        if (cx_write(checkpoint, rows, strlen(rows))) return 2;
        for (int g = 1; g <= 3; g++) {
            if (g == 1 ? cx_fmt(p, sizeof p, "%s/gen1/lnx-x86_64/candidate", run) : cx_fmt(p, sizeof p, "%s/fixedpoint/g%d/lnx-x86_64/candidate", run, g)) return 2;
            if (cx_write(p, "constructor", 11)) return 2;
            for (int span = 0; span < 2; span++) {
                char lane[80], prep[4500], lock[4600];
                const char *base = span ? "wf-span-prep" : "wf-prep";
                if (g == 1 ? cx_fmt(prep, sizeof prep, "%s/%s", work, base) : cx_fmt(prep, sizeof prep, "%s/%s-g%d", work, base, g)) return 2;
                if (g == 1 ? cx_fmt(lane, sizeof lane, "%s", span ? "wf-span-prep" : "wf-prepare") : cx_fmt(lane, sizeof lane, "%s-g%d", base, g)) return 2;
                if (cx_fmt(p, sizeof p, "%s/receipt.txt", prep) || cx_write(p, "prepared", 8) || cx_fmt(lock, sizeof lock, "%s.candidate-prepare-owner.lock", prep)) return 2;
                if (cx_fmt(cmd, sizeof cmd, "cd '%s' && '%s' --phases '%s' --rev %s --out '%s' --lane %s --until %s --resume 2>&1", td, candidate, phases, revision, run, lane, lane)) return 2;
                ck(sh(cmd, out, sizeof out) == 0 && has(out, "RESUME\t") && !has(out, "RECEIPT"), "prepare-lane-only-resumes-own-node");
                ck(sy_exists(lock), "prepare-lane-uses-shared-owner-lock");
                int fd = sy_open(lock, O_WRONLY | O_CLOEXEC, 0);
                ck(fd >= 0 && !sy_flock(fd, 2 | 4), "prepare-lock-released-after-invocation");
                if (fd >= 0) sy_close(fd);
            }
        }
        size_t saved_n = 0; char *saved = cx_read(checkpoint, &saved_n);
        ck(saved && saved_n == strlen(rows) && !memcmp(saved, rows, saved_n), "lane-no-sibling-checkpoints"); free(saved);
        if (cx_fmt(p, sizeof p, "%s/heartbeat.tsv", run)) return 2;
        ck(!sy_exists(p), "lane-does-not-touch-global-heartbeat");
        /* First prepare uses a fake launcher, not a completed prepare checkpoint. */
        if (cx_fmt(cmd, sizeof cmd, "mkdir -p '%s/tools/templates'", td) || sh(cmd, out, sizeof out)) return 2;
        size_t template_n = 0; char *template_bytes = cx_read("tools/templates/whole-front.cx.in", &template_n);
        if (!template_bytes || cx_fmt(p, sizeof p, "%s/tools/templates/whole-front.cx.in", td) || cx_write(p, template_bytes, template_n)) return 2;
        free(template_bytes);
        /* 钉住记录源码 sha:夹具根需要有该工具源文件(桩编译器不读它) */
        if (cx_fmt(p, sizeof p, "%s/tools/whole-front.cx", td) || cx_write(p, "int main(void){return 0;}\n", 26)) return 2;
        const char *fake_prepare = "#!/bin/sh\n"
            /* whole-front 按输出目录钉住:钉住构造调用 TOOL -o OUT,桩写出同样行为的可执行体(其参数不含 TOOL 与 --) */
            "if [ \"$2\" = -o ]; then printf '#!/bin/sh\\n[ \"$1\" = prepare ] || exit 91\\nmkdir -p \"$6\" || exit 92\\nprintf prepared > \"$6/receipt.txt\"\\n' > \"$3\"; exit 0; fi\n"
            "[ \"$3\" = prepare ] || exit 91\nmkdir -p \"$8\" || exit 92\nprintf prepared > \"$8/receipt.txt\"\n";
        if (cx_fmt(p, sizeof p, "%s/unisacc.com", td) || cx_write(p, fake_prepare, strlen(fake_prepare))) return 2;
        if (cx_fmt(p, sizeof p, "%s/wf-prep/receipt.txt", work) || sy_unlink(p)) return 2;
        const char *initial_rows = "DONE\tp3\tx\nDONE\tgen1-lnx-x86_64\tx\n";
        if (cx_write(checkpoint, initial_rows, strlen(initial_rows)) || cx_fmt(cmd, sizeof cmd, "cd '%s' && '%s' --phases '%s' --rev %s --out '%s' --lane wf-prepare --until wf-prepare --resume 2>&1", td, candidate, phases, revision, run)) return 2;
        ck(sh(cmd, out, sizeof out) == 0 && has(out, "RECEIPT\twf-prepare\t") && has(out, "status=UNTIL"), "gen1-first-prepare-publishes-canonical-tag");
        saved = cx_read(checkpoint, &saved_n);
        ck(saved && has(saved, "DONE\twf-prepare\t") && !has(saved, "wf-prep-g1") && !has(saved, "gen1-osx"), "gen1-first-prepare-no-alias-or-sibling-mark");
        free(saved);
        const char *bad_tables[] = {
            "0\ta\touter\t90\tmissing\t-\t1\t-\t-\t-\n",
            "0\ta\touter\t90\ta\t-\t1\t-\t-\t-\n",
            "0\ta\touter\t90\t-\tmissing\t1\t-\t-\t-\n",
            "0\ta\touter\t90\t-\t-\t5\t-\t-\t-\n",
            "0\ta\tbogus\t90\t-\t-\t1\t-\t-\t-\n",
            "0\ta\touter\t90\tb\t-\t1\t-\t-\t-\n1\tb\touter\t90\ta\t-\t1\t-\t-\t-\n",
            "0\ta\touter\t90\t-\t-\t1\t-\t-\t-\n1\tb\touter\t90\ta,a\t-\t1\t-\t-\t-\n",
            "0\ta\touter\t120\t-\t-\t1\t-\t-\t-\n"  /* 120 is only the kernels-* override row, never a default row */
        };
        if (cx_fmt(p, sizeof p, "%s/bad-phases.tsv", td) || cx_fmt(cmd, sizeof cmd, "'%s' --phases '%s' --plan 2>&1", candidate, p)) return 2;
        for (int i = 0; i < 8; i++) {
            if (cx_write(p, bad_tables[i], strlen(bad_tables[i]))) return 2;
            ck(sh(cmd, out, sizeof out) != 0 && has(out, "REFUSE chain-phases"), "seven-column-invalid-fields-refused");
        }
        /* The per-phase bound is handed down by the caller (chain-run) in UNISACC_CHAIN_PHASE_BOUND_S:
           within 1..phase.bound max it is used, above the max it is refused, never silently the default. */
        {   char pcmd[9000];
            if (cx_fmt(pcmd, sizeof pcmd, "UNISACC_CHAIN_PHASE_BOUND_S=100 '%s' --phases '%s' --plan 2>&1", candidate, phases)) return 2;
            ck(sh(pcmd, out, sizeof out) == 0 && has(out, "child_bound=100"), "caller-phase-bound-used");
            if (cx_fmt(pcmd, sizeof pcmd, "UNISACC_CHAIN_PHASE_BOUND_S=121 '%s' --phases '%s' --plan 2>&1", candidate, phases)) return 2;
            ck(sh(pcmd, out, sizeof out) != 0 && has(out, "REFUSE phase bound from caller"), "caller-phase-bound-above-max-refused");
            /* grouped call: the variable carries the group budget (segment remainder); each job inside keeps the single-job value */
            if (cx_fmt(pcmd, sizeof pcmd, "UNISACC_CHAIN_PHASE_BOUND_S=227 '%s' --phases '%s' --jobs-segment-s 227 --plan 2>&1", candidate, phases)) return 2;
            ck(sh(pcmd, out, sizeof out) == 0 && has(out, "child_bound=90") && !has(out, "child_bound=227"), "group-bound-227-accepted-per-job-90");
            if (cx_fmt(pcmd, sizeof pcmd, "UNISACC_CHAIN_PHASE_BOUND_S=268 '%s' --phases '%s' --jobs-segment-s 227 --plan 2>&1", candidate, phases)) return 2;
            ck(sh(pcmd, out, sizeof out) != 0 && has(out, "REFUSE phase bound from caller"), "group-bound-above-segment-cap-refused");
            if (cx_fmt(pcmd, sizeof pcmd, "UNISACC_CHAIN_PHASE_BOUND_S=227 '%s' --phases '%s' --plan 2>&1", candidate, phases)) return 2;
            ck(sh(pcmd, out, sizeof out) != 0 && has(out, "REFUSE phase bound from caller"), "single-bound-227-still-refused");
            /* all-phase-kinds-accept-exported-bound: every distinct (domain, timeout, group) kind of the real table */
            {   size_t tn = 0; char *tb = cx_read(phases, &tn); char seen[64][80]; int ns = 0, bad = 0, kinds = 0;
                for (char *ln = tb; tb && ln && *ln;) {
                    char *nl = strchr(ln, '\n'); if (nl) *nl = 0;
                    if (*ln != '#' && *ln) {
                        char *f[5] = {0}; int k = 0; char *q = ln; f[k++] = q;
                        while (*q && k < 5) if (*q++ == '\t') { q[-1] = 0; f[k++] = q; }
                        if (k >= 4) {
                            int grp = !strcmp(f[1], "jobs-tool") || !strcmp(f[1], "jobs-gen") || !strcmp(f[1], "jobs-tbl") || !strcmp(f[1], "jobs-net");
                            char key[80]; int dup = 0;
                            if (cx_fmt(key, sizeof key, "%s/%s/%d", f[2], f[3], grp)) bad++;
                            for (int s = 0; s < ns; s++) if (!strcmp(seen[s], key)) dup = 1;
                            if (!dup && ns < 64) {
                                tx_copy(seen[ns++], 80, key, strlen(key)); kinds++;
                                /* bound chain-run exports in a fresh segment: group -> segment-3 remainder, single -> row timeout */
                                if (cx_fmt(pcmd, sizeof pcmd, "UNISACC_CHAIN_PHASE_BOUND_S=%s '%s' --phases '%s' %s --plan 2>&1", grp ? "267" : f[3], candidate, phases, grp ? "--jobs-segment-s 267" : "")) bad++;
                                else if (sh(pcmd, out, sizeof out) != 0 || has(out, "REFUSE")) bad++;
                            }
                        }
                    }
                    ln = nl ? nl + 1 : 0;
                }
                free(tb);
                ck(tb && kinds >= 2 && !bad, "all-phase-kinds-accept-exported-bound");
            }
        }
        /* The constructor step's watchdog is the snapshot's own tools/bound, frozen with the rev.
           0.0.58: the step bound had been raised to 90 while the frozen watchdog still took 1..60,
           so gen1 objects died on its usage line. Three fake snapshots: one takes 1..60 (the step
           must run under 60), one takes 1..95 (the step bound itself), one takes 1..30 (refused). */
        {
            static const int limits[3] = {60, 95, 30};
            char ctorp[4600], wtrace[4600], script[1200], gcmd[14000];
            const char *fakector = "#!/bin/sh\ncase \"$*\" in *--objects-only*) exit 0;; esac\nexit 99\n";
            if (cx_fmt(ctorp, sizeof ctorp, "%s/wd-ctor", td) || cx_write(ctorp, fakector, strlen(fakector))) return 2;
            for (int i = 0; i < 3; i++) {
                char snapd[4600], toolsd[4600], boundp[4600], outd[4600], want[40];
                if (cx_fmt(snapd, sizeof snapd, "%s/wd-snap-%d", td, limits[i]) || cx_fmt(toolsd, sizeof toolsd, "%s/tools", snapd) ||
                    cx_fmt(boundp, sizeof boundp, "%s/bound", toolsd) || cx_fmt(outd, sizeof outd, "%s/wd-out-%d", td, limits[i]) ||
                    cx_fmt(wtrace, sizeof wtrace, "%s/wd-trace-%d", td, limits[i]) ||
                    sy_mkdir(snapd, 0755) || sy_mkdir(toolsd, 0755) || sy_mkdir(outd, 0755)) return 2;
                if (cx_fmt(script, sizeof script,
                        "#!/bin/sh\nif [ \"$1\" -gt %d ]; then echo 'usage: bound SECONDS(1..%d) COMMAND' >&2; exit 2; fi\nprintf '%%s\\n' \"$1\" >> '%s'\nshift\nexec \"$@\"\n",
                        limits[i], limits[i], wtrace) || cx_write(boundp, script, strlen(script)) || sy_chmod(boundp, 0755)) return 2;
                if (cx_fmt(gcmd, sizeof gcmd, "'%s' --gen1-entry-fixture '%s' '%s' '%s' unused package '%s' lnx/arm64 fresh gen1-lnx-fixture-objects 2>&1",
                           candidate, outd, snapd, ctorp, outd)) return 2;
                int grc = sh(gcmd, out, sizeof out);
                size_t wn = 0; char *w = cx_read(wtrace, &wn);
                if (limits[i] == 60) ck(grc == 0 && has(out, "status=UNTIL") && has(out, "CTOR_BOUND\tsnapshot-watchdog=60") && w && wn == 6 && !memcmp(w, "60\n60\n", 6), "ctor-step-under-frozen-watchdog-range");
                else if (limits[i] == 95) { if (cx_fmt(want, sizeof want, "90\n90\n")) return 2; ck(grc == 0 && has(out, "status=UNTIL") && !has(out, "CTOR_BOUND") && w && wn == strlen(want) && !memcmp(w, want, wn), "ctor-step-bound-when-watchdog-takes-it"); }
                else ck(grc != 0 && has(out, "REFUSE snapshot watchdog accepts neither the step bound nor the frozen range") && !w, "ctor-watchdog-below-60-refused");
                free(w);
            }
        }
        /* A stub attempt killed at its bound leaves DEST and DEST.control; whole-front refuses to
           run over them. The step must scrub the unfinished DEST, run once, and reuse it after. */
        {
            char wroot[4600], wout[4600], wdest[4600], wctl[4600], wtrace[4600], wpath[4700], script[1500], gcmd[14000];
            if (cx_fmt(wroot, sizeof wroot, "%s/wfs-root", td) || cx_fmt(wout, sizeof wout, "%s/wfs-out", td) || cx_fmt(wdest, sizeof wdest, "%s/x-stub", wout) ||
                cx_fmt(wctl, sizeof wctl, "%s.control", wdest) || cx_fmt(wtrace, sizeof wtrace, "%s/wfs-trace", td) ||
                sy_mkdir(wroot, 0755) || sy_mkdir(wout, 0755) || sy_mkdir(wdest, 0755) || sy_mkdir(wctl, 0755)) return 2;
            if (cx_fmt(wpath, sizeof wpath, "%s/replay.phase", wdest) || cx_write(wpath, "partial\n", 8)) return 2;
            if (cx_fmt(script, sizeof script,
                    "#!/bin/sh\nif [ -e \"$7\" ] || [ -e \"$7.control\" ]; then echo 'whole-front: REFUSE exclusive phase/control required' >&2; exit 2; fi\n"
                    "mkdir \"$7\" \"$7.control\" || exit 3\nprintf 'stub\\n' > \"$7/stub.c\"\nprintf '%%s\\n' \"$3\" >> '%s'\n", wtrace) ||
                cx_fmt(wpath, sizeof wpath, "%s/unisacc.com", wroot) || cx_write(wpath, script, strlen(script))) return 2;
            if (cx_fmt(gcmd, sizeof gcmd, "'%s' --wf-stub-fixture '%s' '%s' '%s/wfs-prep' osx/x86_64 '%s/wfs-merged' '%s' gen1-fixture-stub 2>&1",
                       candidate, wroot, wout, td, td, wdest)) return 2;
            int grc = sh(gcmd, out, sizeof out);
            size_t wn = 0; char *w = cx_read(wtrace, &wn);
            if (cx_fmt(wpath, sizeof wpath, "%s/replay.phase", wdest)) return 2;
            ck(grc == 0 && has(out, "CLEANUP\t") && !has(out, "REFUSE exclusive") && w && wn == 5 && !memcmp(w, "stub\n", 5) && sy_exists(wpath) == 0, "killed-stub-residue-scrubbed-before-retry");
            free(w);
            grc = sh(gcmd, out, sizeof out);
            w = cx_read(wtrace, &wn);
            ck(grc == 0 && has(out, "RESUME\tgen1-fixture-stub") && !has(out, "CLEANUP\t") && w && wn == 5, "finished-stub-reused-not-scrubbed");
            free(w);
        }
        /* A kernels attempt killed at its bound leaves g2/kernel-route (and possibly a copied
           kernel) without phase-6.tsv; chain-step then refuses the retry. The rule is a row of the
           phase table (facts build/chain-residue.tsv), here the real table's kernels-g2 row: the
           unrecorded residue is scrubbed before the step; a recorded phase is never touched. */
        {
            char kout[4600], kfp[4600], kg[4600], kdir[4700], ksub[4800], kk[4700], ka[4700], kother[4700], kkeep[4700], krec[4700], kcp[4700], kcmd[14000];
            if (cx_fmt(kout, sizeof kout, "%s/ks-out", td) || cx_fmt(kfp, sizeof kfp, "%s/fixedpoint", kout) || cx_fmt(kg, sizeof kg, "%s/g2", kfp) ||
                cx_fmt(kdir, sizeof kdir, "%s/kernel-route", kg) || cx_fmt(ksub, sizeof ksub, "%s/x86_64", kdir) || cx_fmt(kk, sizeof kk, "%s/x86_64.kernel", kg) ||
                cx_fmt(ka, sizeof ka, "%s/arm64.kernel", kg) || cx_fmt(kother, sizeof kother, "%s/lnx-x86_64", kg) || cx_fmt(kkeep, sizeof kkeep, "%s/phase-2.tsv", kg) ||
                cx_fmt(krec, sizeof krec, "%s/phase-6.tsv", kg) || cx_fmt(kcp, sizeof kcp, "%s/checkpoint.tsv", kout) ||
                sy_mkdir(kout, 0755) || sy_mkdir(kfp, 0755) || sy_mkdir(kg, 0755) || sy_mkdir(kdir, 0755) || sy_mkdir(ksub, 0755) || sy_mkdir(kother, 0755) ||
                cx_write(kk, "partial\n", 8) || cx_write(ka, "partial\n", 8) || cx_write(kkeep, "other phase\n", 12)) return 2;
            if (cx_fmt(kcmd, sizeof kcmd, "'%s' --residue-fixture '%s' '%s' kernels-g2 2>&1", candidate, phases, kout)) return 2;
            int krc = sh(kcmd, out, sizeof out);
            ck(krc == 0 && has(out, "CLEANUP\t") && has(out, "RESIDUE_RULE\tkernels-g2\tapplied") && sy_exists(kdir) == 0 && sy_exists(kk) == 0 && sy_exists(kg) == 1, "killed-kernels-residue-scrubbed-before-retry");
            ck(krc == 0 && sy_exists(ka) == 0 && sy_exists(kother) == 1 && sy_exists(kkeep) == 1, "residue-scrub-only-table-paths-of-the-phase");
            krc = sh(kcmd, out, sizeof out);
            ck(krc == 0 && !has(out, "CLEANUP\t") && has(out, "RESIDUE_RULE\tkernels-g2\tapplied"), "residue-rule-nothing-left-proceeds");
            if (sy_mkdir(kdir, 0755) || cx_write(kk, "kernel\n", 7) || cx_write(krec, "recorded\n", 9)) return 2;
            krc = sh(kcmd, out, sizeof out);
            ck(krc == 0 && !has(out, "CLEANUP\t") && sy_exists(kdir) == 1 && sy_exists(kk) == 1 && sy_exists(krec) == 1, "recorded-kernels-phase-not-scrubbed");
            /* A checkpoint row is a recorded success too, even when the record file is gone. */
            if (sy_unlink(krec) || cx_write(kcp, "DONE\tkernels-g2\t1\n", 19)) return 2;
            krc = sh(kcmd, out, sizeof out);
            ck(krc == 0 && !has(out, "CLEANUP\t") && sy_exists(kdir) == 1 && sy_exists(kk) == 1, "checkpointed-phase-not-scrubbed");
            if (sy_unlink(kcp)) return 2;
            /* A phase without a row has no rule: nothing is touched. */
            if (cx_fmt(kcmd, sizeof kcmd, "'%s' --residue-fixture '%s' '%s' compare 2>&1", candidate, phases, kout)) return 2;
            krc = sh(kcmd, out, sizeof out);
            ck(krc == 0 && !has(out, "CLEANUP\t") && has(out, "RESIDUE_RULE\tcompare\tnone") && sy_exists(kdir) == 1 && sy_exists(kk) == 1, "phase-without-row-untouched");
            /* The same table drives any phase: a fixture table with a refuse row and a scrub row. */
            {
                char tbl[4700], rout[4700], rdir[4800], rsub[4900], rfile[5000], rrec[4900], elsewhere[4700], victim[4800], link[4900], lout[4700], ldir[4800], lg[4900], lfile[5000];
                static const char *rows =
                    "0\tsnap\touter\t90\t-\t-\t1\trefuse\tstage/snap.done\tstage/snap-work\n"
                    "1\tbuild\touter\t90\tsnap\t-\t1\tscrub\tstage/build.done\tstage/build-work,stage/b-*.tmp\n";
                if (cx_fmt(tbl, sizeof tbl, "%s/residue-phases.tsv", td) || cx_write(tbl, rows, strlen(rows)) || cx_fmt(rout, sizeof rout, "%s/rs-out", td) ||
                    cx_fmt(rdir, sizeof rdir, "%s/stage", rout) || cx_fmt(rsub, sizeof rsub, "%s/snap-work", rdir) || cx_fmt(rfile, sizeof rfile, "%s/part", rsub) ||
                    cx_fmt(rrec, sizeof rrec, "%s/snap.done", rdir) || sy_mkdir(rout, 0755) || sy_mkdir(rdir, 0755) || sy_mkdir(rsub, 0755) || cx_write(rfile, "partial\n", 8)) return 2;
                if (cx_fmt(kcmd, sizeof kcmd, "'%s' --residue-fixture '%s' '%s' snap 2>&1", candidate, tbl, rout)) return 2;
                krc = sh(kcmd, out, sizeof out);
                ck(krc != 0 && has(out, "REFUSE unrecorded residue of phase") && !has(out, "CLEANUP\t") && sy_exists(rfile) == 1, "refuse-policy-unrecorded-residue-refused-untouched");
                if (cx_write(rrec, "recorded\n", 9)) return 2;
                krc = sh(kcmd, out, sizeof out);
                ck(krc == 0 && !has(out, "CLEANUP\t") && sy_exists(rfile) == 1, "refuse-policy-recorded-phase-proceeds-untouched");
                /* scrub row of another phase: its directory and its glob go, the neighbour's stay */
                if (cx_fmt(rsub, sizeof rsub, "%s/build-work", rdir) || sy_mkdir(rsub, 0755) || cx_fmt(victim, sizeof victim, "%s/b-1.tmp", rdir) || cx_write(victim, "t\n", 2) ||
                    cx_fmt(link, sizeof link, "%s/c-1.tmp", rdir) || cx_write(link, "t\n", 2) ||
                    cx_fmt(kcmd, sizeof kcmd, "'%s' --residue-fixture '%s' '%s' build 2>&1", candidate, tbl, rout)) return 2;
                krc = sh(kcmd, out, sizeof out);
                ck(krc == 0 && has(out, "CLEANUP\t") && sy_exists(rsub) == 0 && sy_exists(victim) == 0 && sy_exists(link) == 1 && sy_exists(rfile) == 1 && sy_exists(rrec) == 1, "killed-residue-cleared-per-phase-row");
                /* outside the output dir: a listed entry that is a link to an outside directory */
