/* tools/check-candidate-chain.cx -- candidate-chain 负控夹具，不跑全链。
 *   sh ./unisacc.com tools/check-candidate-chain.cx
 */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sys.io
#pragma unisa use sys.sha
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use cxlib.chainfacts
#pragma unisa use sys.posix

static int failed;
static void ck(int ok, const char *n) {
    if (ok) sy_printf("PASS\tcheck-candidate-chain.%s\n", n);
    else { failed++; sy_printf("FAIL\tcheck-candidate-chain.%s\n", n); }
}
static int sh(const char *cmd, char *out, size_t cap) {
    char *v[] = {"sh", "-c", (char *)cmd, 0};
    char *o = 0;
    size_t n = 0;
    int rc = cx_runv_timeout(v, 50, &o, &n);
    if (out) {
        out[0] = 0;
        if (o && n < cap) { mm_copy(out, cap, o, n); out[n] = 0; }
    }
    free(o);
    return rc;
}
static int has(const char *h, const char *n) {
    return tx_find(h, tx_len(h, 100000), n, tx_len(n, 80)) >= 0;
}

int main(int argc, char **argv) {
    char cwd[400], com[500], tool[500], out[65536], *o = 0;
    size_t n = 0;
    const char *rev = "979b56e4d918894670a71080970149112499d223";
    if (argc == 4 && tx_eqz(argv[1], "--lane-split")) {
        char td[4400], run[4500], phases[4500], candidate[4500], cmd[24000], p[4500], checkpoint[4500], work[4500];
        const char *revision = "979b56e4d918894670a71080970149112499d223";
        if (sy_mkdir(argv[2], 0700) && !sy_exists(argv[2])) return 2;
        if (sy_realpath(".", cwd, sizeof cwd) < 0 || cx_fmt(td, sizeof td, "%s/lane-split-XXXXXX", argv[2]) || !mkdtemp(td) ||
            sy_realpath(td, p, sizeof p) < 0 || tx_copy(td, sizeof td, p, strlen(p)) ||
            cx_fmt(run, sizeof run, "%s/run", td) || sy_mkdir(run, 0755) || cx_fmt(checkpoint, sizeof checkpoint, "%s/checkpoint.tsv", run) ||
            cx_fmt(phases, sizeof phases, "%s/build/chain-phases.tsv", cwd) || sy_realpath(argv[3], candidate, sizeof candidate) < 0) return 2;
        if (cx_fmt(cmd,sizeof cmd,"'%s' --chain-work '%s' %s",candidate,td,revision) || sh(cmd,out,sizeof out)) return 2;
        size_t work_n=strlen(out);
        if (!work_n || out[work_n-1]!='\n' || strchr(out,'\n')!=out+work_n-1 || tx_copy(work,sizeof work,out,work_n-1)) return 2;
        if (cx_fmt(cmd, sizeof cmd, "cd '%s' && '%s' --phases '%s' --rev %s --out '%s' --lane gen1-lnx-arm64 --until gen1-lnx-arm64 --resume 2>&1", td, candidate, phases, revision, run)) return 2;
        ck(sh(cmd, out, sizeof out) != 0 && has(out, "lane dependency incomplete: p3") && !has(out, "PREFLIGHT"), "lane-missing-p3-no-preparation");
        if (cx_fmt(p, sizeof p, "%s/compiler.p4.pkg", run) || cx_write(p, "package", 7) || cx_write(checkpoint, "DONE\tp3\tx\n", 10)) return 2;
        if (cx_fmt(p, sizeof p, "%s/ctx", run) || sy_mkdir(p, 0755) || cx_fmt(p, sizeof p, "%s/ctx/identity-helper", run) || cx_write(p, "helper", 6)) return 2;
        ck(sh(cmd, out, sizeof out) != 0 && has(out, "lane dependency incomplete: build") && !has(out, "RECEIPT"), "lane-does-not-fill-missing-build");
        if (cx_fmt(cmd, sizeof cmd, "mkdir -p '%s/gen1/lnx-x86_64' '%s/wf-prep' '%s/wf-span-prep' '%s/wf-prep-g2' '%s/wf-span-prep-g2' '%s/wf-prep-g3' '%s/wf-span-prep-g3' '%s/fixedpoint/g2/lnx-x86_64' '%s/fixedpoint/g3/lnx-x86_64'", run, work, work, work, work, work, work, run, run) || sh(cmd, out, sizeof out)) return 2;
        const char *rows = "DONE\tp3\tx\nDONE\tgen1-lnx-x86_64\tx\nDONE\tg2-lnx-x86_64\tx\nDONE\tg3-lnx-x86_64\tx\nDONE\twf-prepare\tx\nDONE\twf-span-prep\tx\nDONE\twf-prep-g2\tx\nDONE\twf-span-prep-g2\tx\nDONE\twf-prep-g3\tx\nDONE\twf-span-prep-g3\tx\n";
        if (cx_write(checkpoint, rows, strlen(rows))) return 2;
        for (int g = 1; g <= 3; g++) {
            if (g == 1 ? cx_fmt(p, sizeof p, "%s/gen1/lnx-x86_64/candidate", run) : cx_fmt(p, sizeof p, "%s/fixedpoint/g%d/lnx-x86_64/candidate", run, g)) return 2;
            if (cx_write(p, "constructor", 11)) return 2;
            for (int span = 0; span < 2; span++) {
                char lane[80], prep[4500], lock[4600];
                const char *base = span ? "wf-span-prep" : "wf-prep";
                if (g == 1 ? cx_fmt(prep, sizeof prep, "%s/%s", work, base) : cx_fmt(prep, sizeof prep, "%s/%s-g%d", work, base, g)) return 2;
                if (g == 1 ? cx_fmt(lane, sizeof lane, "%s", span ? "wf-span-prep" : "wf-prepare") : cx_fmt(lane, sizeof lane, "%s-g%d", base, g)) return 2;
                if (cx_fmt(p, sizeof p, "%s/receipt.txt", prep) || cx_write(p, "prepared", 8) || cx_fmt(lock, sizeof lock, "%s.candidate-prepare-owner.lock", prep)) return 2;
                if (cx_fmt(cmd, sizeof cmd, "cd '%s' && '%s' --phases '%s' --rev %s --out '%s' --lane %s --until %s --resume 2>&1", td, candidate, phases, revision, run, lane, lane)) return 2;
                ck(sh(cmd, out, sizeof out) == 0 && has(out, "RESUME\t") && !has(out, "RECEIPT"), "prepare-lane-only-resumes-own-node");
                ck(sy_exists(lock), "prepare-lane-uses-shared-owner-lock");
                int fd = sy_open(lock, O_WRONLY | O_CLOEXEC, 0);
                ck(fd >= 0 && !sy_flock(fd, 2 | 4), "prepare-lock-released-after-invocation");
                if (fd >= 0) sy_close(fd);
            }
        }
        size_t saved_n = 0; char *saved = cx_read(checkpoint, &saved_n);
        ck(saved && saved_n == strlen(rows) && !memcmp(saved, rows, saved_n), "lane-no-sibling-checkpoints"); free(saved);
        if (cx_fmt(p, sizeof p, "%s/heartbeat.tsv", run)) return 2;
        ck(!sy_exists(p), "lane-does-not-touch-global-heartbeat");
        /* First prepare uses a fake launcher, not a completed prepare checkpoint. */
        if (cx_fmt(cmd, sizeof cmd, "mkdir -p '%s/tools/templates'", td) || sh(cmd, out, sizeof out)) return 2;
        size_t template_n = 0; char *template_bytes = cx_read("tools/templates/whole-front.cx.in", &template_n);
        if (!template_bytes || cx_fmt(p, sizeof p, "%s/tools/templates/whole-front.cx.in", td) || cx_write(p, template_bytes, template_n)) return 2;
        free(template_bytes);
        const char *fake_prepare = "#!/bin/sh\n[ \"$3\" = prepare ] || exit 91\nmkdir -p \"$8\" || exit 92\nprintf prepared > \"$8/receipt.txt\"\n";
        if (cx_fmt(p, sizeof p, "%s/unisacc.com", td) || cx_write(p, fake_prepare, strlen(fake_prepare))) return 2;
        if (cx_fmt(p, sizeof p, "%s/wf-prep/receipt.txt", work) || sy_unlink(p)) return 2;
        const char *initial_rows = "DONE\tp3\tx\nDONE\tgen1-lnx-x86_64\tx\n";
        if (cx_write(checkpoint, initial_rows, strlen(initial_rows)) || cx_fmt(cmd, sizeof cmd, "cd '%s' && '%s' --phases '%s' --rev %s --out '%s' --lane wf-prepare --until wf-prepare --resume 2>&1", td, candidate, phases, revision, run)) return 2;
        ck(sh(cmd, out, sizeof out) == 0 && has(out, "RECEIPT\twf-prepare\t") && has(out, "status=UNTIL"), "gen1-first-prepare-publishes-canonical-tag");
        saved = cx_read(checkpoint, &saved_n);
        ck(saved && has(saved, "DONE\twf-prepare\t") && !has(saved, "wf-prep-g1") && !has(saved, "gen1-osx"), "gen1-first-prepare-no-alias-or-sibling-mark");
        free(saved);
        const char *bad_tables[] = {
            "0\ta\touter\t55\tmissing\t-\t1\n",
            "0\ta\touter\t55\ta\t-\t1\n",
            "0\ta\touter\t55\t-\tmissing\t1\n",
            "0\ta\touter\t55\t-\t-\t5\n",
            "0\ta\tbogus\t55\t-\t-\t1\n",
            "0\ta\touter\t55\tb\t-\t1\n1\tb\touter\t55\ta\t-\t1\n",
            "0\ta\touter\t55\t-\t-\t1\n1\tb\touter\t55\ta,a\t-\t1\n"
        };
        if (cx_fmt(p, sizeof p, "%s/bad-phases.tsv", td) || cx_fmt(cmd, sizeof cmd, "'%s' --phases '%s' --plan 2>&1", candidate, p)) return 2;
        for (int i = 0; i < 7; i++) {
            if (cx_write(p, bad_tables[i], strlen(bad_tables[i]))) return 2;
            ck(sh(cmd, out, sizeof out) != 0 && has(out, "REFUSE chain-phases"), "seven-column-invalid-fields-refused");
        }
        printf("LANE_SPLIT\tfailed=%d\tfixture=%s\n", failed, td);
        return failed ? 1 : 0;
    }
    if (argc == 4 && tx_eqz(argv[1], "--g2g3-split")) {
        char td[4400], fake[4500], trace[4500], fp[4500], cmd[20000], toolpath[4500], dir[4500];
        const char *script = "#!/bin/sh\ncase \"$*\" in *--closure-list*) i=0; while [ $i -lt ${BATCH_CLOSURES:-3} ]; do printf 'm%s.o\\t%s/src/unit%s.cx\\n' \"$i\" \"$BATCH_SNAP\" \"$i\"; i=$((i+1)); done; exit 0;; esac\nprintf '%s\\t' \"$@\" >> \"$BATCH_TRACE\"\nprintf '\\n' >> \"$BATCH_TRACE\"\nphase=; keys=; while [ $# -gt 0 ]; do case \"$1\" in --phase) shift; phase=$1;; --objects) shift; keys=$1;; esac; shift; done\nif [ -n \"$keys\" ]; then [ ${BATCH_OBJECT_RC:-0} -eq 0 ] || exit $BATCH_OBJECT_RC; dest=\"$BATCH_FP/$phase/lnx-x86_64\"; mkdir -p \"$dest\"; old=$IFS; IFS=,; for key in $keys; do printf '\\n%s\\t1\\n' \"$key\" >> \"$dest/.chain-steps\"; done; IFS=$old; exit 0; fi\nexit ${BATCH_LINK_RC:-0}\n";
        if (sy_realpath(".", cwd, sizeof cwd) < 0 || cx_fmt(td, sizeof td, "%s/g2g3-split-XXXXXX", argv[2]) || !mkdtemp(td) ||
            cx_fmt(fake, sizeof fake, "%s/unisacc.com", td) || cx_fmt(trace, sizeof trace, "%s/trace", td) ||
            cx_fmt(fp, sizeof fp, "%s/fixedpoint", td) || cx_fmt(toolpath, sizeof toolpath, "%s/tools/candidate-chain.cx", cwd)) return 2;
        if (cx_write(fake, script, strlen(script)) || sy_mkdir(fp, 0755) || sy_setenv("BATCH_TRACE", trace, 1) || sy_setenv("BATCH_SNAP", td, 1)) return 2;
        if(sy_setenv("BATCH_FP",fp,1)||cx_fmt(dir,sizeof dir,"%s/build",td)||sy_mkdir(dir,0755))return 2;
        char budget[4500];size_t budget_n=0;char *budget_b=cx_read("build/g2-budget.tsv",&budget_n);
        if(!budget_b||cx_fmt(budget,sizeof budget,"%s/build/g2-budget.tsv",td)||cx_write(budget,budget_b,budget_n))return 2;
        char *limit_row=strstr(budget_b,"\npending_keys\t");int limit=limit_row?atoi(limit_row+14):0;free(budget_b);if(limit<1)return 2;
        for (int g = 2; g <= 3; g++) {
            if (cx_fmt(dir, sizeof dir, "%s/g%d", fp, g) || sy_mkdir(dir, 0755)) return 2;
        }
        if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- --g2g3-fixture '%s' '%s' '%s' '%s' g2 fresh g2-lnx-x86_64-objects 2>&1", argv[3], toolpath, td, td, td, fp)) return 2;
        ck(sh(cmd, out, sizeof out) == 0 && has(out, "status=UNTIL"), "g2-batch-objects-until");
        size_t zn; char *z = cx_read(trace, &zn);
        char *first = z ? strstr(z, "--objects\t") : 0;
        int calls=0,bounded=1;for(char *p=first;p;p=strstr(p+1,"--objects\t")){char *q=p+10;int nk=1;while(*q&&*q!='\t'&&*q!='\n'){if(*q==',')nk++;q++;}if(nk>limit)bounded=0;calls++;}
        ck(first&&bounded&&calls==2+(cf_root_count()-1+limit-1)/limit+(3-1+limit-1)/limit&&!has(z,"--object\t")&&!has(z,"--link-only"),"g2-measured-batches-full-roots-and-closures");
        int covered = 0;
        for (int i = 0; i < cf_root_count(); i++) {
            char key[96];
            const char *name = cf_root_key(i);
            if (cx_fmt(key,sizeof key,"%s",name))return 2;
            for(char *p=first;p;p=strstr(p+1,"--objects\t")){char *q=p+10,*end=strchr(q,'\t');size_t n=strlen(key);for(char *at=q;end&&at<end;){char *e=memchr(at,',',end-at);if(!e)e=end;if((size_t)(e-at)==n&&!memcmp(at,key,n)){covered++;break;}at=e+1;}}
        }
        ck(covered == cf_root_count(), "g2-all-root-keys-covered"); free(z);
        if (cx_write(trace, "", 0) || cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- --g2g3-fixture '%s' '%s' '%s' '%s' g3 fresh g3-lnx-x86_64-objects 2>&1", argv[3], toolpath, td, td, td, fp)) return 2;
        ck(sh(cmd, out, sizeof out) == 0 && has(out, "status=UNTIL"), "g3-objects-until");
        z = cx_read(trace, &zn);
        ck(z && has(z, "--phase\tg3") && has(z, "--objects\t") && has(z, "m0.o") && has(z,"m1.o") && has(z,"m2.o") && !has(z, "--link-only"), "g3-objects-before-link"); free(z);
        if (cx_write(trace, "", 0) || cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- --g2g3-fixture '%s' '%s' '%s' '%s' g3 resume - 2>&1", argv[3], toolpath, td, td, td, fp)) return 2;
        ck(sh(cmd, out, sizeof out) == 0 && has(out, "RESUME\tg3-lnx-x86_64-objects") && has(out, "RECEIPT\tg3-lnx-x86_64\t"), "g3-resume-links");
        z = cx_read(trace, &zn);
        ck(z && has(z, "--objects\t") && has(z, "--resume") && has(z, "--link-only"), "g3-resume-reenters-identity-verifier"); free(z);
        sy_setenv("BATCH_LINK_RC", "37", 1);
        ck(sh(cmd, out, sizeof out) != 0 && has(out, "fixedpoint link"), "g3-link-failure-propagates");
        sy_setenv("BATCH_LINK_RC", "0", 1); sy_setenv("BATCH_OBJECT_RC", "38", 1);
        if (cx_write(trace, "", 0)) return 2;
        ck(sh(cmd, out, sizeof out) != 0 && has(out, "fixedpoint objects"), "g3-object-failure-propagates");
        z = cx_read(trace, &zn); ck(z && !has(z, "--link-only"), "g3-object-failure-stops-link"); free(z);
        sy_setenv("BATCH_OBJECT_RC", "0", 1); sy_setenv("BATCH_CLOSURES", "257", 1);
        if(cx_fmt(dir,sizeof dir,"%s/g2/lnx-x86_64/.chain-steps",fp)||cx_write(dir,"",0))return 2;
        if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- --g2g3-fixture '%s' '%s' '%s' '%s' g2 fresh g2-lnx-x86_64-closure-m256.o 2>&1", argv[3], toolpath, td, td, td, fp) || cx_write(trace, "", 0)) return 2;
        ck(sh(cmd, out, sizeof out) == 0 && has(out, "status=UNTIL"), "dynamic-257-closures-until");
        z = cx_read(trace, &zn);
        int closure_seen=0;bounded=1;for(char *p=z?strstr(z,"--objects\t"):0;p;p=strstr(p+1,"--objects\t")){char *q=p+10;int nk=1;while(*q&&*q!='\t'&&*q!='\n'){if(*q==',')nk++;q++;}if(nk>limit)bounded=0;}
        for(int i=0;i<257;i++){char key[48];if(cx_fmt(key,sizeof key,"m%d.o",i))return 2;for(char *p=z?strstr(z,"--objects\t"):0;p;p=strstr(p+1,"--objects\t")){char *q=p+10,*end=strchr(q,'\t');for(char *at=q;end&&at<end;){char *e=memchr(at,',',end-at);if(!e)e=end;if((size_t)(e-at)==strlen(key)&&!memcmp(at,key,e-at)){closure_seen++;break;}at=e+1;}}}
        ck(z&&bounded&&closure_seen==257&&has(z,"--objects\tm256.o\t")&&!has(z,"--link-only"),"dynamic-257-closures-measured-budget-full-coverage");free(z);
        printf("G2G3_SPLIT\tfailed=%d\tfixture=%s\n", failed, td);
        return failed ? 1 : 0;
    }
    if (argc == 4 && tx_eqz(argv[1], "--gen1-split")) {
        char td[4400], ctor[4500], trace[4500], cmd[16000], toolpath[4500];
        const char *fake = "#!/bin/sh\nprintf '%s\\n' \"$@\" >> \"$GEN1_TRACE\"\ncase \"$*\" in *--objects-only*) exit ${GEN1_OBJECT_RC:-0};; *--link-only*) exit ${GEN1_LINK_RC:-0};; esac\nexit 99\n";
        if (sy_realpath(".", cwd, sizeof cwd) < 0 || cx_fmt(td, sizeof td, "%s/gen1-split-XXXXXX", argv[2]) || !mkdtemp(td) ||
            cx_fmt(ctor, sizeof ctor, "%s/ctor", td) || cx_fmt(trace, sizeof trace, "%s/trace", td) ||
            cx_fmt(toolpath, sizeof toolpath, "%s/tools/candidate-chain.cx", cwd)) return 2;
        if (cx_write(ctor, fake, strlen(fake)) || sy_setenv("GEN1_TRACE", trace, 1)) return 2;
        if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- --gen1-entry-fixture '%s' '%s' '%s' unused package '%s' lnx/arm64 fresh gen1-lnx-fixture-objects 2>&1", argv[3], toolpath, td, cwd, ctor, td)) return 2;
        ck(sh(cmd, out, sizeof out) == 0 && has(out, "status=UNTIL"), "gen1-objects-until");
        size_t zn; char *z = cx_read(trace, &zn);
        ck(z && has(z, "--objects-only") && !has(z, "--link-only") && has(z, "lnx/arm64"), "gen1-object-command-no-link"); free(z);
        if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- --gen1-entry-fixture '%s' '%s' '%s' unused package '%s' lnx/arm64 resume - 2>&1", argv[3], toolpath, td, cwd, ctor, td)) return 2;
        ck(sh(cmd, out, sizeof out) == 0 && has(out, "RESUME\tgen1-lnx-fixture-objects") && has(out, "RECEIPT\tgen1-lnx-fixture\t"), "gen1-resume-links");
        z = cx_read(trace, &zn);
        char *first = z ? strstr(z, "--objects-only") : 0;
        ck(first && !strstr(first + 1, "--objects-only") && has(z, "--link-only"), "gen1-resume-does-not-recompile"); free(z);
        sy_setenv("GEN1_LINK_RC", "37", 1);
        ck(sh(cmd, out, sizeof out) != 0 && has(out, "gen1 link"), "gen1-link-failure-propagates");
        sy_setenv("GEN1_LINK_RC", "0", 1); sy_setenv("GEN1_OBJECT_RC", "38", 1);
        if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- --gen1-entry-fixture '%s' '%s' '%s' unused package '%s' lnx/x86_64 fresh - 2>&1", argv[3], toolpath, td, cwd, ctor, td)) return 2;
        ck(sh(cmd, out, sizeof out) != 0 && has(out, "gen1 objects"), "gen1-object-failure-propagates");
        printf("GEN1_SPLIT\tfailed=%d\tfixture=%s\n", failed, td);
        return failed ? 1 : 0;
    }
    { char *v[] = {"pwd", 0};
      if (cx_runv_timeout(v, 10, &o, &n) != 0 || n < 2 || n >= sizeof cwd) { ck(0, "cwd"); return 1; }
      mm_copy(cwd, sizeof cwd, o, n); cwd[n] = 0;
      { size_t i; for (i = 0; cwd[i]; i++) if (cwd[i] == '\n') cwd[i] = 0; }
    }
    if (cx_fmt(com, sizeof com, "%s/unisacc.com", cwd) || cx_fmt(tool, sizeof tool, "%s/tools/candidate-chain.cx", cwd)) {
        ck(0, "path"); return 1;
    }
    { char cmd[1800];
      if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- --plan 2>&1", com, tool)) { ck(0, "fmt"); return 1; }
      ck(sh(cmd, out, sizeof out) == 0 && has(out, "phases=") && has(out, "g2-osx-x86_64") && has(out, "g3-win-arm64") && has(out, "warmup") && has(out, "gen1-lnx-arm64") && has(out, "child_bound=55") && has(out, "p3-models") && has(out, "g2-lnx-x86_64-obj-0") && has(out, "g2-lnx-arm64-obj-43") && has(out, "jobs-net-41-finish"), "plan"); }
    /* 链内单元前端缓存强制关:plan 首行声明;守卫夹具在调用方把开关设成 1 时仍读到 0 且 RR_TIME 无 unitcache 命中/未命中/存储行。
       守卫目录建在批次的 {out} 下,守卫自己清掉它写的文件,事后目录能被 rmdir 即无残留 */
    { char cmd[1800];
      if (cx_fmt(cmd, sizeof cmd, "UNISACC_UNIT_CACHE=1 sh '%s' '%s' -- --plan 2>&1", com, tool)) { ck(0, "fmt"); return 1; }
      ck(sh(cmd, out, sizeof out) == 0 && has(out, "ENV\tUNISACC_UNIT_CACHE=0"), "plan-unit-cache-forced-off"); }
    { char cmd[1800], gd[700];
      if (argc > 1) sy_mkdir(argv[1], 0755);   /* 批次传 {out};不带参数时退回临时目录 */
      if (cx_fmt(gd, sizeof gd, "%s/cc-ucguard-XXXXXX", argc > 1 ? argv[1] : sy_tmpdir()) || !mkdtemp(gd)) { ck(0, "ucguard-dir"); return 1; }
      if (cx_fmt(cmd, sizeof cmd, "UNISACC_UNIT_CACHE=1 sh '%s' '%s' -- --uc-guard '%s' 2>&1", com, tool, gd)) { ck(0, "fmt"); return 1; }
      ck(sh(cmd, out, sizeof out) == 0 && has(out, "UC_GUARD\tok\tlines=0"), "chain-no-unitcache-lines");
      ck(sy_rmdir(gd) == 0, "chain-guard-leaves-nothing"); }
    { char cmd[1800];
      if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- 2>&1", com, tool)) { ck(0, "fmt"); return 1; }
      ck(sh(cmd, out, sizeof out) != 0 && has(out, "REFUSE") && has(out, "--rev"), "missing-rev"); }
    { char cmd[1800];
      if (cx_fmt(cmd, sizeof cmd, "sh '%s' '%s' -- --rev not-a-rev --out /tmp/cc-x 2>&1", com, tool)) { ck(0, "fmt"); return 1; }
