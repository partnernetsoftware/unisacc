                cx_fmt(endms, sizeof endms, "%ld", sy_now_ms() + 5000) || sy_setenv("UNISACC_CHAIN_ATTEMPT_END_MS", endms, 1)) return 2;
            if (cx_fmt(ycmd, sizeof ycmd, "'%s' --g2g3-fixture '%s' '%s' '%s' '%s' g2 fresh g2-lnx-x86_64-objects 2>&1", candidate, yd, yd, yd, yfp)) return 2;
            int yrc = sh(ycmd, out, sizeof out);
            char *cb = cx_read(ycp, &cn);
            if (!cb) return 2;
            if (sy_sha256_hex(cb, (long)cn, hex)) return 2;
            free(cb);
