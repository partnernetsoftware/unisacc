/* tools/check-diag-census.cx -- checks tools/diag-census.cx (v0.0.73 S0 census).
 *
 *   sh ./unisacc.com tools/check-diag-census.cx
 *
 * (1) --self-test ends DIAG_CENSUS_SELFTEST failed=0 with rc 0.
 * (2) fixture root (a fresh `git init` under /tmp, files added to the index): src/a.cx declares int t2[0] and
 *     static extern int b16 (two candidates), tools/b.cx holds the same text only inside a string literal and a
 *     block comment (zero), tests/neg-x/c.c holds void f(int a, int a) (a negative fixture: skipped, not counted).
 *     Expect zero-array-size hits_src=1 HAS_CANDIDATES phase 0.0.74 with location src/a.cx:1,
 *     multiple-storage-classes hits_src=1, duplicate-parameter 0 ZERO_CANDIDATES phase 0.0.73,
 *     assign-to-const UNMEASURED phase 0.0.74, last line files=2 fixtures_skipped=1 classes=17 unmeasured=8.
 * (3) negative control: removing src/a.cx from the index turns zero-array-size into ZERO_CANDIDATES phase 0.0.73.
 * (4) an unknown option exits 2.
 * Ends with CHECK_DIAG_CENSUS<TAB>failed=N. */
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.heap

static int failed;
static char out[1 << 16];
static char root[300];
static void ck(int ok, const char *name) { if (!ok) failed++; printf("%s\tdiag-census.%s\n", ok ? "PASS" : "FAIL", name); }
static int got(const char *needle) { return strstr(out, needle) != 0; }
static int run(char *a1, char *a2, char *a3) {
    char *v[] = { "./tools/bound", "50", "sh", "./unisacc.com", "tools/diag-census.cx", "--", a1, a2, a3, 0 };
    int fd, pid, ex = 0, code = 0, sig = 0; long n = 0, r;
    pid = sy_spawn_pipe(v, 0, 0, &fd, 0);
    if (pid < 0) return -1;
    while ((r = sy_read(fd, out + n, (long)sizeof out - 1 - n)) > 0) n += r;
    out[n] = 0; sy_close(fd);
    if (sy_wait_status(pid, 0, &ex, &code, &sig) != pid || !ex) return -1;
    return code;
}
static void put(const char *rel, const char *s) { char p[700]; if (!cx_fmt(p, sizeof p, "%s/%s", root, rel)) cx_write(p, s, strlen(s)); }
static int shell(const char *line) { return system(line); }

int main(void) {
    ck(run("--self-test", 0, 0) == 0 && got("DIAG_CENSUS_SELFTEST\tfailed=0"), "self-test");
    cx_fmt(root, sizeof root, "/tmp/check-diag-census-%d", sy_pid());
    char cmd[1200];
    cx_fmt(cmd, sizeof cmd, "rm -rf '%s' && mkdir -p '%s/src' '%s/tools' '%s/tests/neg-x' && git -C '%s' init -q", root, root, root, root, root);
    ck(shell(cmd) == 0, "fixture-init");
    put("src/a.cx", "int t2[0];\nstatic extern int b16;\n");
    put("tools/b.cx", "const char *s = \"int t2[0]; static extern int b16;\";\n/* int t3[0];\nstatic extern int b17; */\n");
    put("tests/neg-x/c.c", "void f(int a, int a){}\n");
    cx_fmt(cmd, sizeof cmd, "git -C '%s' add src/a.cx tools/b.cx tests/neg-x/c.c", root);
    ck(shell(cmd) == 0, "fixture-add");
    ck(run("--root", root, 0) == 0, "fixture-rc0");
    ck(got("zero-array-size\tc\tH\t1\t0\t0\t0\t0\tHAS_CANDIDATES\t-\t-\t0.0.74\tsrc/a.cx:1\n"), "zero-array-candidate");
    ck(got("multiple-storage-classes\tc\tH\t1\t0\t0\t0\t0\tHAS_CANDIDATES\t-\t-\t0.0.74\tsrc/a.cx:2\n"), "storage-candidate");
    ck(got("duplicate-parameter\tc\tH\t0\t0\t0\t0\t0\tZERO_CANDIDATES\t-\t-\t0.0.73\t-\n"), "fixture-skipped-dup-zero");
    ck(got("assign-to-const\tc\tU\t0\t0\t0\t0\t0\tUNMEASURED\t-\t-\t0.0.74\t"), "unmeasured-never-selected");
    ck(got("DIAG_CENSUS\tfiles=2\tfixtures_skipped=1\tclasses=17\tzero=7\thas=2\tunmeasured=8\tselected=6\n"), "summary");
    cx_fmt(cmd, sizeof cmd, "git -C '%s' rm -q --cached src/a.cx", root);
    ck(shell(cmd) == 0, "negctl-unindex");
    ck(run("--root", root, 0) == 0 && got("zero-array-size\tc\tH\t0\t0\t0\t0\t0\tZERO_CANDIDATES\t-\t-\t0.0.73\t-\n")
       && got("selected=8\n"), "negctl-zero-after-removal");
    ck(run("--bogus", 0, 0) == 2, "unknown-option-rc2");
    cx_fmt(cmd, sizeof cmd, "rm -rf '%s'", root);
    shell(cmd);
    printf("CHECK_DIAG_CENSUS\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
