/* devsvc tool selfcheck: verify capacity observations against private procfs and cgroup fixtures. */
#pragma unisa use sys.fs
#pragma unisa use text.text
#pragma unisa use cxlib.netpack
static char base[4096];
static int failed, passed;
static void observe(const char *name,const char *a,const char *ta,const char *b,const char *tb,const char *want){
    char *v[]={"sh","./unisacc.com","tools/dvshadow.cx","--","occupancy-replay",(char*)a,(char*)ta,(char*)b,(char*)tb,"41:100,42:105","400",0};
    np_result r;char why[160];int rc=np_run(v,0,0,20,&r,why,sizeof why);
    int ok=!rc&&!r.rc&&r.out&&strstr(r.out,want);
    if(!rc)np_free(&r);
    printf("%s\t%s\n",ok?"PASS":"FAIL",name);if(ok)passed++;else failed++;
}
static void file(const char *name,const char *value){
    char path[4400];if(cx_fmt(path,sizeof path,"%s/%s",base,name))exit(2);
    if(sy_write_atomic(path,value,strlen(value),0600))exit(2);
}
static void sample(const char *label,const char *expected){
    char *argv[]={"sh","./unisacc.com","tools/dvshadow.cx","--","sample","--root",base,0};
    np_result r;char why[160];
    int rc=np_run(argv,0,0,20,&r,why,sizeof why);
    int ok=!rc && !r.rc && r.outn==strlen(expected) && !memcmp(r.out,expected,r.outn);
    if(!rc)np_free(&r);
    printf("%s\t%s\n",ok?"PASS":"FAIL",label);if(ok)passed++;else failed++;
}
int main(void){
    if(sy_mkdtemp(getenv("TMPDIR")?getenv("TMPDIR"):"/tmp","s2-capacity-",base,sizeof base))return 2;
    const char *dirs[]={"proc","proc/self","cg","cg/group","cg/group/job",0};
    for(int i=0;dirs[i];i++){char path[4400];if(cx_fmt(path,sizeof path,"%s/%s",base,dirs[i])||sy_mkdir(path,0700))return 2;}
    file("proc/self/status","Cpus_allowed_list:\t0-2,7,12\n");
    file("proc/self/cgroup","0::/tenant/group/job\n");
    file("proc/self/mountinfo","32 26 0:30 /tenant /cg rw - cgroup2 cgroup rw\n");
    file("proc/meminfo","MemTotal: 4096 kB\nMemAvailable: 700 kB\n");
    file("cg/group/cpuset.cpus.effective","1-2,5,7\n");
    file("cg/group/cpu.max","150000 100000\n");file("cg/group/job/cpu.max","max 100000\n");
    sample("sparse-intersection-parent-quota","S2_CAPACITY\tallowed_cpus=3\tquota_mcpu=1500\tcapacity_mcpu=1500\tmem_available_kb=700\n");
    file("cg/group/cpu.max","max 100000\n");
    sample("explicit-unlimited","S2_CAPACITY\tallowed_cpus=3\tquota_mcpu=max\tcapacity_mcpu=3000\tmem_available_kb=700\n");
    file("cg/group/job/cpuset.cpus.effective","0-2,7,12\n");
    sample("parent-set-is-tighter","S2_CAPACITY\tallowed_cpus=3\tquota_mcpu=max\tcapacity_mcpu=3000\tmem_available_kb=700\n");
    char *mv[]={"sh","./unisacc.com","tools/dvshadow.cx","--","sample","--root",base,"--need-kb","701",0};
    np_result mr;char merr[160];int mt=np_run(mv,0,0,20,&mr,merr,sizeof merr);
    int mok=!mt&&!mr.rc&&strstr(mr.out,"\twould_admit=no\treason=insufficient-memory\n");
    if(!mt)np_free(&mr);printf("%s\tfree-cpu-low-memory\n",mok?"PASS":"FAIL");if(mok)passed++;else failed++;
    char a[4400],b[4400];if(cx_fmt(a,sizeof a,"%s/cg/group/cpu.max",base)||cx_fmt(b,sizeof b,"%s/cg/group/job/cpu.max",base)||sy_unlink(a)||sy_unlink(b))return 2;
    sample("missing-quota-unmeasured","S2_CAPACITY\tallowed_cpus=3\tquota_mcpu=UNMEASURED\tcapacity_mcpu=UNMEASURED\tmem_available_kb=700\n");
    file("cg/group/job/cpu.max","1 0\n");file("proc/meminfo","MemAvailable: -1 kB\n");
    sample("bad-period-and-memory-unmeasured","S2_CAPACITY\tallowed_cpus=3\tquota_mcpu=UNMEASURED\tcapacity_mcpu=UNMEASURED\tmem_available_kb=UNMEASURED\n");
    file("cg/group/job/cpu.max","max 100000\n");file("proc/self/status","Cpus_allowed_list: 7-2\n");
    sample("bad-affinity-unmeasured","S2_CAPACITY\tallowed_cpus=UNMEASURED\tquota_mcpu=max\tcapacity_mcpu=UNMEASURED\tmem_available_kb=UNMEASURED\n");
    file("proc/self/cgroup","2:cpu,cpuacct:/legacy\n");
    sample("v1-capacity-unmeasured","S2_CAPACITY\tallowed_cpus=UNMEASURED\tquota_mcpu=UNMEASURED\tcapacity_mcpu=UNMEASURED\tmem_available_kb=UNMEASURED\n");
    char first[4096],second[4096];
    if(tx_copy(first,sizeof first,base,strlen(base))||cx_fmt(second,sizeof second,"%s/next",first))return 2;
    for(int snap=0;snap<2;snap++){
        if(snap){if(sy_mkdir(second,0700)||tx_copy(base,sizeof base,second,strlen(second)))return 2;
            for(int i=0;dirs[i];i++){char dir[4400];if(cx_fmt(dir,sizeof dir,"%s/%s",base,dirs[i])||sy_mkdir(dir,0700))return 2;}}
        file("proc/self/status","Cpus_allowed_list: 0\n");file("proc/self/cgroup","0::/tenant/group/job\n");
        file("proc/self/mountinfo","32 26 0:30 /tenant /cg rw - cgroup2 cgroup rw\n");file("cg/group/cpuset.cpus.effective","0\n");
        file("proc/stat",snap?"cpu0 20 0 10 80 0 0 0 0 0 0\n":"cpu0 10 0 0 60 0 0 0 0 0 0\n");
        for(int k=0;k<3;k++){
            char dir[4400],rel[96],row[360];int pid=41+k;
            if(cx_fmt(dir,sizeof dir,"%s/proc/%d",base,pid)||sy_mkdir(dir,0700))return 2;
            if(cx_fmt(rel,sizeof rel,"proc/%d/stat",pid)||cx_fmt(row,sizeof row,"%d (has ) space) S %d 0 0 0 0 0 0 0 0 0 %d 0 0 0 0 0 1 0 %d 1000 1\n",pid,k==1?41:1,10+(snap?(k==2?10:5):0),100+k*5))return 2;
            file(rel,row);if(cx_fmt(rel,sizeof rel,"proc/%d/status",pid))return 2;file(rel,"VmRSS: 90 kB\n");
        }
    }
    observe("overlapping-roots-counted-once",first,"1000",second,"1400","host_busy_mcpu=500\tmanaged_mcpu=250\texternal_mcpu=250\trss_now_kb=180\trss_estimate_kb=400");
    observe("first-sample-unmeasured",first,"0",second,"1400","reason=first-sample");
    observe("monotonic-clock-regressed",first,"1401",second,"1400","reason=invalid-interval");
    observe("stale-interval-unmeasured",first,"1000",second,"61000","reason=stale-interval");
    observe("cpu-counters-regressed",second,"1000",first,"1400","reason=counter-regressed");
    file("proc/42/stat","42 (reused) S 41 0 0 0 0 0 0 0 0 0 15 0 0 0 0 0 1 0 555 1000 1\n");
    observe("reused-pid-unmeasured",first,"1000",second,"1400","managed_mcpu=UNMEASURED");
    if(cx_rmtree(first))return 2;
    printf("CHECK_DVSHADOW\tpassed=%d\tfailed=%d\n",passed,failed);return failed?1:0;
}
