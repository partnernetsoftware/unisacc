#pragma unisa use sys.io
#pragma unisa use text.text
/* Project the two declared gold tables onto compiler and runtime skeletons.
   sh ./unisacc.com tools/declared-gen.cx -- --check
   sh ./unisacc.com tools/declared-gen.cx -- --write
   weights/gold/lexcls.tsv and lexword.tsv say DECLARED and not gold-export.
   They stay outside the eighteen nets. The step returns 0.
   The stage accessor returns the name in the gold header.
   No libc and no include. */
#define NDECL 2
#define NAMEMAX 32
#define FILECAP 1024
#define CHECKCAP 4096
#define LINEMAX 1024

static const char *paths[NDECL] = {
    "weights/gold/lexcls.tsv",
    "weights/gold/lexword.tsv"
};

typedef struct { char name[NAMEMAX]; } Row;

static Row rows[NDECL];
static int nrows;

static int fail(const char *why) {
    sy_eprintf("declared-gen\tFAIL\t%s\n", why);
    return 1;
}

static int ident(const char *s, int n) {
    int i;
    if (n < 1 || n >= NAMEMAX) return 0;
    if (s[0] < 'a' || s[0] > 'z') return 0;
    for (i = 1; i < n; i++) {
        char c = s[i];
        if (c >= 'a' && c <= 'z') continue;
        if (c >= '0' && c <= '9') continue;
        if (c == '_') continue;
        return 0;
    }
    return 1;
}

static int has_phrase(const char *s, int n, const char *phrase) {
    int pn = 0, i, j;
    while (phrase[pn]) pn++;
    if (pn < 1 || n < pn) return 0;
    for (i = 0; i + pn <= n; i++) {
        for (j = 0; j < pn; j++) if (s[i + j] != phrase[j]) break;
        if (j == pn) return 1;
    }
    return 0;
}

static void copy_field(char *dst, const char *s, int n) {
    int i;
    for (i = 0; i < n; i++) dst[i] = s[i];
    dst[n] = 0;
}

static int stem_of(const char *path, char *dst) {
    int i = 0, slash = -1, dot = -1;
    while (path[i]) i++;
    while (i > 0) {
        i--;
        if (path[i] == '/' && slash < 0) slash = i;
        if (path[i] == '.' && dot < 0) dot = i;
    }
    if (slash < 0 || dot < 0 || dot <= slash + 1) return fail("path-stem");
    if (!ident(path + slash + 1, dot - slash - 1)) return fail("path-stem");
    copy_field(dst, path + slash + 1, dot - slash - 1);
    return 0;
}

static int take_header(const char *b, size_t n, const char *path) {
    char stem[NAMEMAX];
    int i, start, len;
    const char *mark = "# stage ";
    if (nrows >= NDECL) return fail("decl-count");
    if (stem_of(path, stem)) return 1;
    for (i = 0; i < (int)n && b[i] != '\n'; i++) ;
    if (i == (int)n || i >= LINEMAX) return fail("header-line");
    for (start = 0; mark[start]; start++) if (b[start] != mark[start]) return fail("header-mark");
    len = start;
    while (len < i && b[len] != ':') len++;
    if (len == i || len == start) return fail("header-name");
    if (!ident(b + start, len - start)) return fail("header-name");
    if (!has_phrase(b, i, "DECLARED here (not exported by gold-export)"))
        return fail("header-declared");
    {
        char stage[NAMEMAX];
        copy_field(stage, b + start, len - start);
        if (!tx_eqz(stem, stage)) return fail("header-stem");
        copy_field(rows[nrows].name, stage, len - start);
    }
    nrows++;
    return 0;
}

static int unique_names(void) {
    int i, j;
    for (i = 0; i < nrows; i++) {
        for (j = i + 1; j < nrows; j++) {
            if (tx_eqz(rows[i].name, rows[j].name)) return fail("name-dup");
        }
    }
    return 0;
}

static int app(char *dst, int cap, int *n, const char *s) {
    int i = 0;
    while (s[i]) {
        if (*n + 1 >= cap) return -1;
        dst[*n] = s[i];
        *n += 1;
        i++;
    }
    dst[*n] = 0;
    return 0;
}

static int emit_mod(char *dst, int cap, const char *name, const char *prefix) {
    int n = 0;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa module ")) return -1;
    if (app(dst, cap, &n, name)) return -1;
    if (app(dst, cap, &n, "\n/* Generated by tools/declared-gen.cx. Declared gold stage.\n")) return -1;
    if (app(dst, cap, &n, "   Not one of the eighteen gold-export nets.\n")) return -1;
    if (app(dst, cap, &n, "   The step returns 0. The stage name comes from the gold header.\n")) return -1;
    if (app(dst, cap, &n, "   Do not edit by hand. No libc and no include. */\n")) return -1;
    if (app(dst, cap, &n, "int ")) return -1;
    if (app(dst, cap, &n, prefix)) return -1;
    if (app(dst, cap, &n, "_")) return -1;
    if (app(dst, cap, &n, name)) return -1;
    if (app(dst, cap, &n, "(void) {\n    return 0;\n}\n")) return -1;
    if (app(dst, cap, &n, "const char *")) return -1;
    if (app(dst, cap, &n, prefix)) return -1;
    if (app(dst, cap, &n, "_")) return -1;
    if (app(dst, cap, &n, name)) return -1;
    if (app(dst, cap, &n, "_stage(void) {\n    return \"")) return -1;
    if (app(dst, cap, &n, name)) return -1;
    if (app(dst, cap, &n, "\";\n}\n")) return -1;
    return n;
}

static int emit_check(char *dst, int cap) {
    int n = 0, i;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa use compiler.netname\n")) return -1;
    for (i = 0; i < nrows; i++) {
        if (app(dst, cap, &n, "#pragma unisa use compiler.net.")) return -1;
        if (app(dst, cap, &n, rows[i].name)) return -1;
        if (app(dst, cap, &n, "\n")) return -1;
        if (app(dst, cap, &n, "#pragma unisa use runtime.net.")) return -1;
        if (app(dst, cap, &n, rows[i].name)) return -1;
        if (app(dst, cap, &n, "\n")) return -1;
    }
    if (app(dst, cap, &n, "#pragma unisa use sys.io\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use text.text\n")) return -1;
    if (app(dst, cap, &n, "/* Generated by tools/declared-gen.cx. Narrow check of the declared stages. */\n")) return -1;
    if (app(dst, cap, &n, "int main(void) {\n")) return -1;
    if (app(dst, cap, &n, "    const char *name;\n")) return -1;
    if (app(dst, cap, &n, "    int i;\n")) return -1;
    if (app(dst, cap, &n, "    if (nn_count() != 18) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    for (i = 0; i < 18; i++) {\n")) return -1;
    if (app(dst, cap, &n, "        if (nn_at(i, &name)) return 1;\n")) return -1;
    for (i = 0; i < nrows; i++) {
        if (app(dst, cap, &n, "        if (tx_eqz(name, \"")) return -1;
        if (app(dst, cap, &n, rows[i].name)) return -1;
        if (app(dst, cap, &n, "\")) return 1;\n")) return -1;
    }
    if (app(dst, cap, &n, "    }\n")) return -1;
    for (i = 0; i < nrows; i++) {
        if (app(dst, cap, &n, "    if (skd_")) return -1;
        if (app(dst, cap, &n, rows[i].name)) return -1;
        if (app(dst, cap, &n, "()) return 1;\n")) return -1;
        if (app(dst, cap, &n, "    if (!tx_eqz(skd_")) return -1;
        if (app(dst, cap, &n, rows[i].name)) return -1;
        if (app(dst, cap, &n, "_stage(), \"")) return -1;
        if (app(dst, cap, &n, rows[i].name)) return -1;
        if (app(dst, cap, &n, "\")) return 1;\n")) return -1;
        if (app(dst, cap, &n, "    if (rtd_")) return -1;
        if (app(dst, cap, &n, rows[i].name)) return -1;
        if (app(dst, cap, &n, "()) return 1;\n")) return -1;
        if (app(dst, cap, &n, "    if (!tx_eqz(rtd_")) return -1;
        if (app(dst, cap, &n, rows[i].name)) return -1;
        if (app(dst, cap, &n, "_stage(), \"")) return -1;
        if (app(dst, cap, &n, rows[i].name)) return -1;
        if (app(dst, cap, &n, "\")) return 1;\n")) return -1;
    }
    if (app(dst, cap, &n, "    sy_printf(\"CX_DECLARED\\tok=2\\tfailed=0\\n\");\n")) return -1;
    if (app(dst, cap, &n, "    return 0;\n}\n")) return -1;
    return n;
}

static int same_bytes(const char *a, size_t an, const char *b, int bn) {
    int i;
    if (an != (size_t)bn) return 0;
    for (i = 0; i < bn; i++) if (a[i] != b[i]) return 0;
    return 1;
}

static int one_file(int dowrite, const char *path, const char *body, int n) {
    size_t on = 0;
    char *cur;
    if (dowrite) {
        if (cx_write(path, body, (size_t)n)) return fail("write");
        return 0;
    }
    cur = cx_read(path, &on);
    if (!cur) return fail(path);
    if (!same_bytes(cur, on, body, n)) return fail(path);
    return 0;
}

int main(int argc, char **argv) {
    char file[FILECAP], check[CHECKCAP], path[160];
    int dowrite, i, fn, cn;
    size_t nb;
    char *b;
    if (argc != 2 || (!tx_eqz(argv[1], "--check") && !tx_eqz(argv[1], "--write"))) {
        sy_eprintf("declared-gen\tusage\t--check|--write\n");
        return 2;
    }
    dowrite = tx_eqz(argv[1], "--write");
    for (i = 0; i < NDECL; i++) {
        nb = 0;
        b = cx_read(paths[i], &nb);
        if (!b) return fail(paths[i]);
        if (take_header(b, nb, paths[i])) return 1;
    }
    if (nrows != NDECL) return fail("decl-count");
    if (unique_names()) return 1;
    cn = emit_check(check, CHECKCAP);
    if (cn < 0) return fail("emit-check");
    for (i = 0; i < nrows; i++) {
        fn = emit_mod(file, FILECAP, rows[i].name, "skd");
        if (fn < 0) return fail("emit-compiler");
        if (cx_fmt(path, sizeof path, "cx/compiler/net/%s.cx", rows[i].name)) return fail("path");
        if (one_file(dowrite, path, file, fn)) return 1;
        fn = emit_mod(file, FILECAP, rows[i].name, "rtd");
        if (fn < 0) return fail("emit-runtime");
        if (cx_fmt(path, sizeof path, "cx/runtime/net/%s.cx", rows[i].name)) return fail("path");
        if (one_file(dowrite, path, file, fn)) return 1;
    }
    if (one_file(dowrite, "tools/check-cx-declared.cx", check, cn)) return 1;
    if (dowrite) sy_printf("DECLARED_GEN\tWROTE\trows=%d\n", nrows);
    else sy_printf("DECLARED_GEN\tCHECK\trows=%d\n", nrows);
    return 0;
}
