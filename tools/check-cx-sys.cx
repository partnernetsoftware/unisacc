/* Checks cx/sys (env, fs, proc, time, net, posix, sha): sh ./unisacc.com tools/check-cx-sys.cx
   (from the repo root: the posix cases re-run this file as a child, "-- child MODE ...", for what
   must happen in another process: setsid, and a record lock held by someone else).
   Each case runs for real in a scratch directory under $TMPDIR or /tmp.
   Prints "  ok    name" / "  FAIL  name", then CHECK_CX_SYS PASS|FAIL ok=N fail=M; exit 1 on any FAIL.
   An L3 tool: no #include and no direct libc call (cx/sys, cx/text and the cx_* prelude only). */
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.time
#pragma unisa use sys.net
#pragma unisa use sys.posix
#pragma unisa use sys.sha
#pragma unisa use text.text
static int n_ok, n_bad;
static void ok(int c, const char *name) { printf("  %s  %s\n", c ? "ok  " : "FAIL", name); if (c) n_ok++; else n_bad++; }
static int has(const char *s, const char *needle) { return tx_find(s, tx_len(s, 65536), needle, tx_len(needle, 256)) >= 0; }
/* Child modes, run as a separate process by the posix cases. Exit 0 when the expectation holds. */
static int child(const char *mode, const char *arg) {
    if (tx_eq(mode, "setsid", 16)) {
        long s = sy_setsid();
        return s > 0 && s == (long)sy_pid() && sy_getpgid(0) == s ? 0 : 1;
    }
    if (tx_eq(mode, "leader-setsid", 16)) {
        setpgid(0, 0);   /* become a group leader: setsid must then refuse */
        return sy_setsid() == -EPERM ? 0 : 1;
    }
    if (tx_eq(mode, "tty-pgrp", 16)) {
        /* under script(1): stdin is a tty and this process is in its foreground group */
        long fg = sy_tcgetpgrp(0);
        return fg > 0 && fg == sy_getpgid(0) && sy_tcsetpgrp(0, (int)fg) == 0 ? 0 : 1;
    }
    if (tx_eq(mode, "pgrp", 16)) {
        /* started by sy_spawn_inherit: write this process group into the kept fd ARG */
        char line[32];
        int fd = 0, i;
        for (i = 0; arg[i] >= '0' && arg[i] <= '9'; i++) fd = fd * 10 + arg[i] - '0';
        { if (cx_fmt(line, sizeof line, "%ld\n", sy_getpgid(0))) { fprintf(stderr, "check-cx-sys: text too long for line\n"); exit(2); } }
        return sy_write_all(fd, line, tx_len(line, 32)) == 0 ? 0 : 1;
    }
    if (tx_eq(mode, "tty-modes", 16)) {
        /* under script(1): save, put back with and without flush, read again: the same modes */
        static sy_tty_t zero;   /* all zero: a real terminal's modes are not */
        sy_tty_t a, b, c;
        return sy_tty_get(0, &a) == 0 && !sy_tty_same(&a, &zero) && sy_tty_set(0, &a, 1) == 0 && sy_tty_get(0, &b) == 0 &&
               sy_tty_set(0, &b, 0) == 0 && sy_tty_get(0, &c) == 0 && sy_tty_same(&a, &b) && sy_tty_same(&b, &c) ? 0 : 1;
    }
    if (tx_eq(mode, "lockf-held", 16) || tx_eq(mode, "lockf-free", 16)) {
        int fd = sy_openat(sy_at_fdcwd(), arg, O_RDWR, 0), r = fd >= 0 ? sy_lockf(fd, 1, 0) : fd;
        return tx_eq(mode, "lockf-held", 16) ? (r == -EAGAIN || r == -EACCES ? 0 : 1) : (r == 0 ? 0 : 1);
    }
    return 2;
}

/* sy_fork_session's fn: 7 when this process leads its own session and group
   (setsid again must be -EPERM), after one line on stdout and one on stderr. */
static int fs_child(void *ud) {
    (void)ud;
    sy_write_all(1, "out\n", 4);
    sy_write_all(2, "err\n", 4);
    return sy_getpgid(0) == (long)sy_pid() && sy_setsid() == -EPERM ? 7 : 1;
}

/* This file's own path (argv[0] under -run), so a child run works from any cwd. */
static const char *self = "tools/check-cx-sys.cx";

/* Run this check file again as a child in MODE; its exit status. */
static int run_child(const char *mode, const char *arg) {
    const char *u = sy_env_or("UNISACC", "./unisacc.com");
    char *av[] = { "sh", (char *)u, "-run", (char *)self, "--", "child", (char *)mode, (char *)(arg ? arg : "-"), 0 };
    char out[256];
    int cut;
    return sy_run(av, out, sizeof out, &cut);
}

int main(int argc, char **argv) {
    char root[512], d[600], f[600], under[700], out[256], tiny[4];
    if (argc == 4 && tx_eq(argv[1], "child", 8)) return child(argv[2], argv[3]);
    if (argc > 0 && argv[0] && argv[0][0]) self = argv[0];
    const char *tmp = sy_env_or("TMPDIR", "/tmp");
    sy_stat_t s;
    int rc, cut, pid;

    /* env */
    ok(sy_env("PATH") != 0 && sy_env("PATH")[0] == '/', "env: PATH is set and absolute");
    ok(sy_env("CX_SYS_SURELY_UNSET_7f3a") == 0, "env: an unset name is 0");
    ok(sy_env("") == 0 && sy_env(0) == 0, "env: empty and null names are 0");
    ok(tx_eq(sy_env_or("CX_SYS_SURELY_UNSET_7f3a", "fb"), "fb", 8), "env_or: fallback when unset");

    /* fs */
    { if (cx_fmt(root, sizeof root, "%s/cx-sys-check-%d", tmp, sy_pid())) { fprintf(stderr, "check-cx-sys: text too long for root\n"); exit(2); } }
    ok(sy_mkdir(root, 0700) == 0, "mkdir: a new directory");
    ok(sy_mkdir(root, 0700) == -EEXIST, "mkdir: an existing one is -EEXIST");
    ok(sy_mkdir("", 0700) == -EINVAL && sy_chmod(0, 0600) == -EINVAL, "mkdir/chmod: empty or null path is -EINVAL");
    { if (cx_fmt(d, sizeof d, "%s/no/such/parent", root)) { fprintf(stderr, "check-cx-sys: text too long for d\n"); exit(2); } }
    ok(sy_mkdir(d, 0700) == -ENOENT, "mkdir: missing parent is -ENOENT");
    ok(sy_stat(root, &s) == 0 && s.kind == 'd' && s.mode == 0700 && s.ino > 0, "stat: directory kind, mode 0700, inode");
    { if (cx_fmt(f, sizeof f, "%s/file", root)) { fprintf(stderr, "check-cx-sys: text too long for f\n"); exit(2); } }
    ok(cx_write(f, "hello", 5) == 0 && sy_stat(f, &s) == 0 && s.kind == 'f' && s.size == 5 && s.mtime > 0, "stat: regular file, size 5, mtime");
    ok(sy_chmod(f, 0640) == 0 && sy_stat(f, &s) == 0 && s.mode == 0640, "chmod: 0640 reads back");
    ok(sy_exists(f) == 1 && sy_exists(root) == 1, "exists: file and directory are 1");
    { if (cx_fmt(d, sizeof d, "%s/absent", root)) { fprintf(stderr, "check-cx-sys: text too long for d\n"); exit(2); } }
    ok(sy_exists(d) == 0 && sy_stat(d, &s) == -ENOENT, "exists: absent is 0 (stat -ENOENT)");
    { if (cx_fmt(under, sizeof under, "%s/under", f)) { fprintf(stderr, "check-cx-sys: text too long for under\n"); exit(2); } }
    ok(sy_exists(under) == -ENOTDIR, "exists: a path under a file is -ENOTDIR, not absent");

    /* proc */
    {
        char *av[] = { "sh", "-c", "echo out; echo err >&2; exit 3", 0 };
        rc = sy_run(av, out, sizeof out, &cut);
        ok(rc == 3 && has(out, "out\n") && has(out, "err\n") && !cut, "run: exit code 3, stdout and stderr captured");
    }
    {
        char *av[] = { "sh", "-c", "echo 0123456789", 0 };
        rc = sy_run(av, tiny, sizeof tiny, &cut);
        ok(rc == 0 && cut && tx_eq(tiny, "012", 4), "run: output cut at the buffer, *cut set");
    }
    {
        char *av[] = { "cx-sys-no-such-program-7f3a", 0 };
        ok(sy_run(av, out, sizeof out, &cut) == 127, "run: a missing program exits 127");
    }
    {
        char *av[] = { "sh", "-c", "kill -TERM $$", 0 };
        ok(sy_run(av, out, sizeof out, &cut) == 128 + 15, "run: death by SIGTERM is 128+15");
    }
    ok(sy_run(0, out, sizeof out, &cut) == -EINVAL, "run: null argv is -EINVAL");
    {
        char *av[] = { "sh", "-c", "exit 5", 0 };
        pid = sy_spawn(av);
        ok(pid > 0 && sy_wait(pid, 0) == 5, "spawn + wait: exit 5");
    }
    {
        /* a child that would outlive us, with a grandchild in its process group */
        char *av[] = { "sh", "-c", "sleep 31.73 & sleep 31.73", 0 };   /* a duration nothing else uses, for the pgrep below */
        pid = sy_spawn(av);
        ok(pid > 0 && sy_wait(pid, 1) == -EAGAIN, "wait nohang: a running child is -EAGAIN");
        ok(sy_kill(pid) == 128 + 9, "kill: the group is killed, status 128+9");
        ok(sy_wait(pid, 0) == -ECHILD, "wait: a reaped pid is -ECHILD");
    }
    {
        char *av[] = { "sh", "-c", "pgrep -f 'sleep 31[.]73' >/dev/null && echo alive || echo gone", 0 };
        sy_run(av, out, sizeof out, &cut);
        ok(has(out, "gone"), "kill: the background grandchild died with the group");
    }
    ok(sy_pid() > 0, "pid: positive");
    {
        /* spawn_inherit: same process group, the kept fd reaches the exec'd child */
        int sv[2], n = 0;
        char fdtext[16], line[64], want[32];
        const char *u = sy_env_or("UNISACC", "./unisacc.com");
        char *av[] = { "/bin/sh", (char *)u, "-run", (char *)self, "--", "child", "pgrp", fdtext, 0 };
        char *bad[] = { "/cx-sys-no-such-program-7f3a", 0 };
        long got;
        ok(sy_socketpair(sv) == 0, "spawn_inherit: a socketpair for the child");
        { if (cx_fmt(fdtext, sizeof fdtext, "%d", sv[1])) { fprintf(stderr, "check-cx-sys: text too long for fdtext\n"); exit(2); } }
        pid = sy_spawn_inherit(av, sv[1]);
        sy_close(sv[1]);
        rc = pid > 0 ? sy_wait(pid, 0) : pid;
        while (sy_readable(sv[0], 0) == 1 && (got = sy_recv(sv[0], line + n, (long)sizeof line - 1 - n)) > 0) n += (int)got;
        line[n] = 0;
        { if (cx_fmt(want, sizeof want, "%ld\n", sy_getpgid(0))) { fprintf(stderr, "check-cx-sys: text too long for want\n"); exit(2); } }
        ok(pid > 0 && rc == 0 && tx_eq(line, want, 32), "spawn_inherit: the child writes on the kept fd and is in our process group");
        sy_close(sv[0]);
        ok(sy_spawn_inherit(bad, -1) == -ENOENT, "spawn_inherit: a missing program is -ENOENT (the exec errno)");
        ok(sy_spawn_inherit(0, -1) == -EINVAL, "spawn_inherit: null argv is -EINVAL");
    }
    {
        int fds[2], no = 0, ne = 0;
        char o[64], e[64];
        long got;
        pid = sy_fork_session(fs_child, 0, fds);
        rc = pid > 0 ? sy_wait(pid, 0) : pid;
        while (pid > 0 && (got = sy_read(fds[0], o + no, (long)sizeof o - 1 - no)) > 0) no += (int)got;
        while (pid > 0 && (got = sy_read(fds[1], e + ne, (long)sizeof e - 1 - ne)) > 0) ne += (int)got;
        o[no] = 0; e[ne] = 0;
        ok(pid > 0 && rc == 7, "fork_session: the child exits with fn's value (7: it led a new session and group)");
        ok(tx_eq(o, "out\n", 8) && tx_eq(e, "err\n", 8), "fork_session: stdout and stderr come back on their own pipes");
        if (pid > 0) { sy_close(fds[0]); sy_close(fds[1]); }
        ok(sy_fork_session(0, 0, fds) == -EINVAL, "fork_session: a null fn is -EINVAL");
    }
    {
        char *av[] = { "sh", "-c", "sleep 31.77", 0 };
        pid = sy_spawn(av);
        ok(pid > 0 && sy_signal(pid, 15) == 0 && sy_wait(pid, 0) == 128 + 15, "signal: SIGTERM to one pid, status 128+15");
        ok(sy_signal(0, 15) == -EINVAL && sy_signal(pid, 0) == -ESRCH, "signal: refuses pid 0; a reaped pid is -ESRCH");
    }

    /* time */
    {
        long t0 = sy_now_ms(), t1, w = sy_wall_s();
        ok(t0 >= 0 && sy_sleep_ms(120) == 0 && (t1 = sy_now_ms()) - t0 >= 110 && t1 - t0 < 1000, "sleep 120ms: the monotonic clock moves 110..1000ms");
        ok(w > 1700000000L, "wall clock: seconds after 2023");
        ok(sy_sleep_ms(0) == 0 && sy_sleep_ms(-5) == 0, "sleep 0 and negative return at once");
        { if (cx_fmt(f, sizeof f, "%s/timed", root)) { fprintf(stderr, "check-cx-sys: text too long for f\n"); exit(2); } }
        ok(cx_write(f, "t", 1) == 0 && sy_set_mtime(f, 1700000100L) == 0 && sy_stat(f, &s) == 0 && s.mtime == 1700000100L, "set_mtime: stat reads the time back");
        { if (cx_fmt(d, sizeof d, "%s/absent", root)) { fprintf(stderr, "check-cx-sys: text too long for d\n"); exit(2); } }
        ok(sy_set_mtime(d, 1L) == -ENOENT && sy_set_mtime("", 1L) == -EINVAL, "set_mtime: absent is -ENOENT, empty -EINVAL");
    }

    /* net */
    {
        int lfd = sy_tcp_listen(0, 4), port = lfd >= 0 ? sy_tcp_port(lfd) : -1, cfd, afd;
        char buf[64];
        long got = 0, t0;
        ok(lfd >= 0 && port > 0, "listen: port 0 gives a free port");
        t0 = sy_now_ms();
        ok(sy_tcp_accept(lfd, 100) == -ETIMEDOUT && sy_now_ms() - t0 >= 90, "accept: nothing connects within 100ms -> -ETIMEDOUT");
        ok(sy_readable(lfd, 0) == 0, "readable: an idle listener is 0");
        cfd = sy_tcp_connect(port);
        afd = cfd >= 0 ? sy_tcp_accept(lfd, 1000) : -1;
        ok(cfd >= 0 && afd >= 0, "connect + accept on loopback");
        ok(sy_send_all(cfd, "ping", 4) == 0 && sy_readable(afd, 1000) == 1 && (got = sy_recv(afd, buf, sizeof buf - 1)) == 4 && (buf[got] = 0, tx_eq(buf, "ping", 8)), "send_all + recv: 4 bytes arrive intact");
        ok(sy_close(cfd) == 0 && sy_recv(afd, buf, sizeof buf) == 0, "recv: 0 at end of stream after the peer closes");
        {
            /* the peer is gone: a write must be -EPIPE (or -ECONNRESET), and this process must live */
            int r = 0, k;
            for (k = 0; k < 50 && r == 0; k++) r = sy_send_all(afd, "xxxxxxxxxxxxxxxx", 16);
            ok(r == -EPIPE || r == -ECONNRESET, "send_all to a closed peer is an error, not SIGPIPE");
        }
        sy_close(afd);
        ok(sy_wait_port(port, 500) == 0, "wait_port: an open listener answers");
        sy_close(lfd);
        t0 = sy_now_ms();
        ok(sy_wait_port(port, 200) == -ETIMEDOUT && sy_now_ms() - t0 >= 190, "wait_port: a closed port times out after 200ms");
        ok(sy_tcp_connect(port) == -ECONNREFUSED, "connect: nothing listening is -ECONNREFUSED");
        ok(sy_close(lfd) == -EBADF, "close: a closed fd is -EBADF");
    }

    /* posix: the calls the carried runtime lacks on 0.0.43, made from system calls */
    {
        int sv[2], fd, fd2, dfd, p;
        char buf[8], g[700], h[700];
        long got;
        ok(sy_getpgid(0) > 0 && sy_getpgid(0) == (long)getpgrp(), "getpgid(0) is this process group");
        ok(sy_getpgid(999999) == -ESRCH, "getpgid of no such pid is -ESRCH");
        ok(run_child("setsid", 0) == 0, "setsid in a child: session and group become its pid");
        ok(run_child("leader-setsid", 0) == 0, "setsid as a group leader is -EPERM");
        {
            char *av[] = { "sh", "-c", "sleep 31.79 & sleep 31.79", 0 };
            long end;
            int r;
            p = sy_spawn(av);
            sy_sleep_ms(100);
            ok(p > 0 && sy_killpg(p, 9) == 0 && sy_wait(p, 0) == 128 + 9, "killpg kills a spawned group");
            end = sy_now_ms() + 2000;   /* the killed grandchild may linger as a zombie of the group */
            while ((r = sy_killpg(p, 0)) == 0 && sy_now_ms() < end) sy_sleep_ms(20);
            ok(r == -ESRCH, "killpg of a gone group is -ESRCH");
            ok(sy_killpg(0, 9) == -EINVAL && sy_killpg(1, 0) == -EINVAL, "killpg refuses 0 and 1 (my group, everything)");
        }
        ok(sy_socketpair(sv) == 0 && sy_send_all(sv[0], "z", 1) == 0 && sy_recv(sv[1], buf, 1) == 1 && buf[0] == 'z'
           && sy_send_all(sv[1], "w", 1) == 0 && sy_recv(sv[0], buf, 1) == 1 && buf[0] == 'w', "socketpair carries bytes both ways");
        ok(sy_tcgetpgrp(sv[0]) == -ENOTTY, "tcgetpgrp on a socket is -ENOTTY");
        {
            sy_tty_t t;
            ok(sy_tty_get(sv[0], &t) == -ENOTTY && sy_tty_set(sv[0], &t, 1) == -ENOTTY, "tty_get/tty_set on a socket are -ENOTTY");
        }
        {
            /* on a real tty: script(1) (util-linux, -e returns the child's status) gives the child a pty */
            char *probe[] = { "sh", "-c", "script -qec true /dev/null >/dev/null 2>&1", 0 };
            if (sy_run(probe, out, sizeof out, &cut) == 0) {
                char cmd[700];
                char *av[] = { "sh", "-c", cmd, 0 };
                { if (cx_fmt(cmd, sizeof cmd, "script -qec 'sh %s -run %s -- child tty-pgrp -' /dev/null >/dev/null 2>&1",
                         sy_env_or("UNISACC", "./unisacc.com"), self)) { fprintf(stderr, "check-cx-sys: text too long for cmd\n"); exit(2); } }
                ok(sy_run(av, out, sizeof out, &cut) == 0, "tcgetpgrp/tcsetpgrp on a pty: the foreground group is the child's own");
                { if (cx_fmt(cmd, sizeof cmd, "script -qec 'sh %s -run %s -- child tty-modes -' /dev/null >/dev/null 2>&1",
                         sy_env_or("UNISACC", "./unisacc.com"), self)) { fprintf(stderr, "check-cx-sys: text too long for cmd\n"); exit(2); } }
                ok(sy_run(av, out, sizeof out, &cut) == 0, "tty_get/tty_set on a pty: modes put back (flush and now) read back the same");
            } else printf("  note  tcgetpgrp on a pty: UNMEASURED (no util-linux script(1) here)\n");
        }
        { if (cx_fmt(f, sizeof f, "%s/a", root)) { fprintf(stderr, "check-cx-sys: text too long for f\n"); exit(2); } }
        fd = sy_openat(sy_at_fdcwd(), f, O_RDWR | O_CREAT, 0600);
        ok(fd >= 0 && sy_stat(f, &s) == 0 && s.mode == 0600, "openat(AT_FDCWD, absolute, O_CREAT) creates with the mode");
        dfd = sy_openat(sy_at_fdcwd(), root, O_RDONLY, 0);
        ok(dfd >= 0 && sy_openat(dfd, "a", O_RDONLY, 0) >= 0, "openat relative to a directory fd");
        ok(sy_openat(dfd, "missing", O_RDONLY, 0) == -ENOENT && sy_openat(dfd, "", O_RDONLY, 0) == -EINVAL, "openat: missing name -ENOENT, empty -EINVAL");
        { if (cx_fmt(g, sizeof g, "%s/b", root)) { fprintf(stderr, "check-cx-sys: text too long for g\n"); exit(2); } }
        ok(sy_linkat(dfd, "a", dfd, "b", 0) == 0 && sy_stat(g, &s) == 0 && s.ino > 0, "linkat makes a second name");
        ok(sy_linkat(dfd, "a", dfd, "b", 0) == -EEXIST, "linkat over an existing name is -EEXIST");
        ok(sy_linkat(dfd, "missing", dfd, "c", 0) == -ENOENT, "linkat of a missing source is -ENOENT");
        { if (cx_fmt(h, sizeof h, "%s/lock", root)) { fprintf(stderr, "check-cx-sys: text too long for h\n"); exit(2); } }
        fd = sy_openat(sy_at_fdcwd(), h, O_RDWR | O_CREAT, 0600);
        fd2 = sy_openat(sy_at_fdcwd(), h, O_RDWR, 0);
        ok(fd >= 0 && fd2 >= 0 && sy_flock(fd, 2 | 4) == 0, "flock exclusive, not waiting");
        ok(sy_flock(fd2, 2 | 4) == -EWOULDBLOCK, "flock: a second open file is refused (-EWOULDBLOCK)");
        ok(sy_flock(fd, 8) == 0 && sy_flock(fd2, 2 | 4) == 0 && sy_flock(fd2, 8) == 0, "flock: after unlock the second one gets it");
        ok(sy_lockf(fd, 1, 0) == 0, "lockf: an exclusive record lock");
        ok(run_child("lockf-held", h) == 0, "lockf: another process is refused while it is held");
        ok(sy_unlockf(fd) == 0, "lockf: unlock");
        ok(run_child("lockf-free", h) == 0, "lockf: after unlock another process gets it");
        got = sy_at_fdcwd();
        ok(got < 0, "at_fdcwd is the negative AT_FDCWD of this target");
        {
            char names[256];
            int n, seen_a = 0, seen_b = 0, seen_sub = 0, seen_lock = 0, other = 0, i = 0, k;
            ok(sy_mkdirat(dfd, "sub", 0700) == 0 && sy_stat(root, &s) == 0, "mkdirat makes a directory in a directory fd");
            ok(sy_mkdirat(dfd, "sub", 0700) == -EEXIST, "mkdirat over an existing name is -EEXIST");
            n = sy_dir_names(dfd, names, sizeof names);
            /* exactly N names, NUL after each: what follows the last one is not the function's */
            for (k = 0; k < n && i < (int)sizeof names; k++, i += (int)tx_len(names + i, (long)sizeof names - i) + 1) {
                if (tx_eq(names + i, "a", 8)) seen_a++;
                else if (tx_eq(names + i, "b", 8)) seen_b++;
                else if (tx_eq(names + i, "sub", 8)) seen_sub++;
                else if (tx_eq(names + i, "lock", 8)) seen_lock++;
                else if (!tx_eq(names + i, "file", 8) && !tx_eq(names + i, "timed", 8)) other++;
            }
            ok(n >= 4 && seen_a == 1 && seen_b == 1 && seen_sub == 1 && seen_lock == 1 && !other, "dir_names lists each entry once, without . and ..");
            ok(sy_dir_names(dfd, names, sizeof names) == n, "dir_names twice gives the same count (the offset is rewound)");
            ok(sy_dir_names(dfd, names, 4) == -ENOSPC, "dir_names into a too-small buffer is -ENOSPC");
            ok(sy_dir_names(fd, names, sizeof names) == -ENOTDIR, "dir_names on a file fd is -ENOTDIR");
            ok(sy_unlinkat(dfd, "b", 0) == 0 && sy_exists(g) == 0, "unlinkat removes a file name");
            ok(sy_unlinkat(dfd, "sub", 0) == -EISDIR || sy_unlinkat(dfd, "sub", 0) == -EPERM, "unlinkat of a directory without the dir flag is refused");
            ok(sy_unlinkat(dfd, "sub", 1) == 0, "unlinkat with the dir flag removes an empty directory");
            ok(sy_unlinkat(dfd, "missing", 0) == -ENOENT, "unlinkat of a missing name is -ENOENT");
        }
    }

    /* sha. 64 KiB and above is the kernel hash. A shorter block keeps
       cx_sha256_hex, the same cut as rr_hash_file and rc_hex_file. */
    {
        static unsigned char big[65536];
        char af[65], soft[65];
        const char *empty = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
        const char *abc = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
        unsigned long x = 0xC0FFEEU;
        int i, af_rc;
        for (i = 0; i < 65536; i++) {
            x = x * 1664525u + 1013904223u;
            big[i] = (unsigned char)(x >> 24);
        }
        af_rc = sy_sha256_hex(big, 65536, af);
        cx_sha256_hex(big, 65536, soft);
        ok(af_rc == 0 && af[64] == 0 && tx_eq(af, soft, 65), "sha: 64KiB random, AF_ALG matches cx_sha256_hex");
        af_rc = sy_sha256_hex("", 0, af);
        cx_sha256_hex("", 0, soft);
        ok(af_rc == 0 && tx_eq(af, soft, 65) && tx_eq(af, empty, 65), "sha: empty input matches cx_sha256_hex");
        {
            const char *msg = "abc";
            const char *picked;
            long n = 3;
            af_rc = sy_sha256_hex(msg, n, af);
            cx_sha256_hex(msg, 3, soft);
            picked = (n < 65536 || af_rc != 0) ? soft : af;
            ok(n < 65536 && picked == soft && tx_eq(picked, abc, 65) && (af_rc != 0 || tx_eq(af, abc, 65)),
               "sha: under 64KiB the digest is the software fallback");
        }
    }

    ok(cx_rmtree(root) == 0 && sy_exists(root) == 0, "cleanup: scratch removed through the deletion guard");
    printf("CHECK_CX_SYS\t%s\tok=%d\tfail=%d\n", n_bad ? "FAIL" : "PASS", n_ok, n_bad);
    return n_bad ? 1 : 0;
}
