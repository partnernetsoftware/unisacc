/* tools/flowrun.cx -- run a flow file: concurrent exec and file nodes in dependency order.
 *
 *   sh ./unisacc.com tools/flowrun.cx -- run FLOW.tsv [--jobs N] [--run DIR] [--deadline-ms N] [--dry]
 *
 * The engine is tools/cxlib/flowexec.cx (node format, exec args, event format are in its header);
 * file.read/file.write/file.edit are tools/cxlib/flowfile.cx.  This file is only the command line:
 * it holds no repo path, so the engine can be imported elsewhere (devsvc) as is.
 *   --jobs N         nodes at once; default the core count, max 32
 *   --run DIR        run directory (events.tsv, out/<id>.out, out/<id>.err); default
 *                    $TMPDIR/flow-run-<ms>-<pid>
 *   --deadline-ms N  whole-run bound (default 300000, max 3600000): at the bound every running
 *                    node's process group is killed (timeout) and the rest are skip
 *   --dry            print ORDER lines (topological order) and FLOW_DRY, run nothing
 * Output: one EVT line per node event, then
 *   FLOW_RUN<TAB>nodes=N<TAB>ok=N<TAB>fail=N<TAB>timeout=N<TAB>skip=N<TAB>wall_ms=N<TAB>peak=N<TAB>jobs=N<TAB>run=DIR
 * rc 0 every node ok, 1 some node not ok, 2 refused (unknown dep, cycle, bad line, bad option:
 * named on stderr as `flowrun: REFUSE ...`).  Nothing is cached: every run executes every node.
 * (tools/flow.cx is a different tool: changed files -> blast radius.)
 * Check: tools/check-flowrun.cx. */
#pragma unisa use cxlib.flowexec
#pragma unisa use cxlib.flowfile
#pragma unisa use sysx.process
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.sig
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use mem.heap

static void die(const char *s) { sy_eprintf("flowrun: REFUSE %s\n", s); sy_exit(2); }
static long f_num(const char *s) { long n = 0; if (!*s) return -1; while (*s >= '0' && *s <= '9') { n = n * 10 + (*s++ - '0'); if (n > 100000000L) return -1; } return *s ? -1 : n; }

int main(int argc, char **argv) {
    fl_flow f; fl_sum s; char why[1024], dir[2048]; const char *file = 0, *rdir = 0;
    int a, jobs = 0, dry = 0, echo = 0, r, *ord, i, j; long dl = 0;
    if (argc < 2 || !tx_eqz(argv[1], "run")) die("usage: run FLOW.tsv [--jobs N] [--run DIR] [--deadline-ms N] [--dry]");
    for (a = 2; a < argc; a++) {
        if (tx_eqz(argv[a], "--dry")) dry = 1;
        else if (tx_eqz(argv[a], "--echo")) echo = 1;
        else if (tx_eqz(argv[a], "--jobs") && a + 1 < argc) { long v = f_num(argv[++a]); if (v < 1) die("--jobs wants a number >= 1"); jobs = v > 32 ? 32 : (int)v; }
        else if (tx_eqz(argv[a], "--run") && a + 1 < argc) rdir = argv[++a];
        else if (tx_eqz(argv[a], "--deadline-ms") && a + 1 < argc) { dl = f_num(argv[++a]); if (dl < 1 || dl > 3600000L) die("--deadline-ms outside 1..3600000"); }
        else if (argv[a][0] == '-' && argv[a][1] == '-') die("unknown option");
        else if (!file) file = argv[a];
        else die("one flow file");
    }
    if (!file) die("usage: run FLOW.tsv [--jobs N] [--run DIR] [--deadline-ms N] [--dry]");
    if (tx_eqz(file, "-")) file = "/dev/stdin";
    if (fl_load(file, &f, why, (int)sizeof why)) die(why);
    if (dry) {
        ord = mm_alloc((long)(f.count + 1) * (long)sizeof(int));
        if (!ord) die("out of memory");
        r = fl_order(&f, ord);
        for (i = 0; i < r; i++) {
            fl_node *nd = &f.n[ord[i]];
            sy_printf("ORDER\t%d\t%s\t%s\t", i + 1, nd->id, nd->op);
            if (!nd->ndeps) sy_printf("-");
            for (j = 0; j < nd->ndeps; j++) sy_printf("%s%s", j ? "," : "", f.n[nd->deps[j]].id);
            sy_printf("\n");
        }
        sy_printf("FLOW_DRY\tnodes=%d\n", f.count);
        mm_free(ord); fl_free(&f);
        return 0;
    }
    if (jobs < 1) { jobs = sy_ncpu(); if (jobs < 1) jobs = 4; if (jobs > 32) jobs = 32; }
    if (!rdir) {
        if (cx_fmt(dir, sizeof dir, "%s/flow-run-%ld-%d", sy_tmpdir(), sy_now_ms(), (int)getpid())) die("run dir too long");
        rdir = dir;
    }
    r = fl_run(&f, rdir, jobs, dl, 1, &s);
    if (r < 0) { sy_eprintf("flowrun: REFUSE run dir %s unusable (%d)\n", rdir, r); return 2; }
    sy_printf("FLOW_RUN\tnodes=%d\tok=%d\tfail=%d\ttimeout=%d\tskip=%d\twall_ms=%ld\tpeak=%d\tjobs=%d\trun=%s\n",
              f.count, s.ok, s.fail, s.timeout, s.skip, s.wall_ms, s.max_running, jobs, rdir);
    if (echo) for (i = 0; i < f.count; i++) {
        char ea[2400]; ff_out eo;
        if (cx_fmt(ea, sizeof ea, "path=%s/out/%s.out", rdir, f.n[i].id)) continue;
        if (ff_run("file.read", ea, &eo) == 0) { sy_printf("ECHO\t%s\tbytes=%ld\n", f.n[i].id, eo.n); if (eo.n) sy_printf("%.*s%s", (int)eo.n, eo.buf, eo.buf[eo.n - 1] == '\n' ? "" : "\n"); }
        else sy_printf("ECHO\t%s\tbytes=-\n", f.n[i].id);
        ff_out_free(&eo);
    }
    fl_free(&f);
    return r;
}
