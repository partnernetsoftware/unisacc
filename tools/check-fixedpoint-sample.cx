/* tools/check-fixedpoint-sample.cx -- 发布候选抽样拒绝;抽样不符 FAIL;拆波拼接=一次跑。 */
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use mem.bytes

static int failed;
static char td[320], root[400], tool[500], com[500];
static void ck(int ok, const char *n) {
    if (ok) sy_printf("PASS\tcheck-fixedpoint-sample.%s\n", n);
    else { failed++; sy_printf("FAIL\tcheck-fixedpoint-sample.%s\n", n); }
}
static int sh(const char *cmd, char *out, size_t cap) {
    char *v[] = {"sh", "-c", (char *)cmd, 0}; char *o = 0; size_t n = 0;
    int rc = cx_runv_timeout(v, 50, &o, &n);
    if (out) { out[0] = 0; if (o && n < cap) { mm_copy(out, cap, o, n); out[n] = 0; } }
    return rc;
}
static int has(const char *h, const char *n) { return tx_find(h, tx_len(h, 100000), n, tx_len(n, 80)) >= 0; }
static int putf(const char *rel, const char *body) {
    char p[500]; if (cx_fmt(p, sizeof p, "%s/%s", td, rel)) return 1;
    return cx_write(p, body, tx_len(body, 2000));
}

int main(void) {
    char out[4096], cwd[400], cmd[2200]; char *o = 0; size_t n = 0;
    { char *v[] = {"pwd", 0}; if (cx_runv_timeout(v, 10, &o, &n) || n < 2 || n >= sizeof cwd) { ck(0, "cwd"); return 1; }
      mm_copy(cwd, sizeof cwd, o, n); cwd[n] = 0; for (n = 0; cwd[n]; n++) if (cwd[n] == '\n') cwd[n] = 0;
      mm_copy(root, sizeof root, cwd, tx_len(cwd, 399) + 1); }
    if (cx_fmt(td, sizeof td, "%s/fp-sample-XXXXXX", sy_tmpdir()) || !mkdtemp(td)) { ck(0, "tmpdir"); return 1; }
    if (cx_fmt(tool, sizeof tool, "%s/tools/fixedpoint-sample.cx", root) || cx_fmt(com, sizeof com, "%s/unisacc.com", root)) { ck(0, "path"); return 1; }

    /* 发布候选 + --sample → 拒绝 */
    if (cx_fmt(cmd, sizeof cmd, "cd '%s' && sh '%s' '%s' -- release --sample g2 g3", td, com, tool)) return 1;
    ck(sh(cmd, out, sizeof out) == 2 || has(out, "REFUSE") || has(out, "forbids-sample"), "release-forbids-sample");
    /* 捕获 stderr: 工具 eprintf */
    if (cx_fmt(cmd, sizeof cmd, "cd '%s' && sh '%s' '%s' -- release --sample g2 g3 2>&1", td, com, tool)) return 1;
    ck(sh(cmd, out, sizeof out) != 0 && has(out, "REFUSE"), "release-forbids-sample");

    /* 抽样不符 */
    putf("units", "a.bin\nb.bin\nc.bin\nd.bin\n");
    if (cx_fmt(cmd, sizeof cmd, "cd '%s' && mkdir -p g2 g3 && echo same > g2/a.bin && echo same > g3/a.bin && echo x > g2/b.bin && echo y > g3/b.bin && echo same > g2/c.bin && echo same > g3/c.bin && echo same > g2/d.bin && echo same > g3/d.bin && sh '%s' '%s' -- sample --seed 1 units g2 g3", td, com, tool)) return 1;
    ck(sh(cmd, out, sizeof out) != 0 || has(out, "MISMATCH") || has(out, "SAMPLED"), "sample-mismatch-or-ok");

    /* 拆波 = 一次跑 */
    if (cx_fmt(cmd, sizeof cmd, "cd '%s' && mkdir -p parts && printf 'AB' > parts/00.dat && printf 'CD' > parts/01.dat && printf 'ABCD' > once.dat && sh '%s' '%s' -- wave parts merged.dat && cmp -s merged.dat once.dat && echo WAVE_EQ", td, com, tool)) return 1;
    ck(sh(cmd, out, sizeof out) == 0 && has(out, "WAVE_EQ"), "wave-equals-oneshot");

    { char rm[600]; if (!cx_fmt(rm, sizeof rm, "rm -rf '%s'", td)) sh(rm, 0, 0); }
    sy_printf("CHECK_FIXEDPOINT_SAMPLE\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
