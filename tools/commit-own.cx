                        char *v[] = {"git", "update-index", "--force-remove", "--", (char *)path[k], 0}; char nb[48], nm[8];
                        if (tries) sy_sleep_ms(150 + 100 * tries);
                        run(v, out, sizeof out);
                        entry(0, path[k], nb, nm);
                        good = !nb[0];
                    }
                    if (!good) { lost++; fprintf(stderr, "COMMIT_OWN_INDEX_UNSYNCED\tpath=%s\twant=absent\thave=%s\trun: sh ./unisacc.com tools/devsvc.cx -- git add %s\n", path[k], ib, path[k]); }
                    else if (!tx_eqz(ib, old[k])) sy_printf("NOTE\t%s\tthe shared index held a staged version that was never committed (blob %s); the commit deletes the path, the entry is removed; the old content: git cat-file -p %s\n", path[k], ib, ib);
                }
                continue;
            }
            if (ib[0] && tx_eqz(ib, blob[k])) continue;   /* already the committed blob */
            {   int uniq = ib[0] && !tx_eqz(ib, old[k]) && !committed_before(path[k], ib);
                if (tx_snprintf(info, sizeof info, "%s,%s,%s", link[k] ? "120000" : (im[0] ? im : "100644"), blob[k], path[k]) >= (int)sizeof info) {
                    lost++; fprintf(stderr, "COMMIT_OWN_INDEX_UNSYNCED\tpath=%s\twant=%s\thave=%s\trun: sh ./unisacc.com tools/devsvc.cx -- git add %s\n", path[k], blob[k], ib[0] ? ib : "absent", path[k]);
                    continue; }
                /* git update-index fails when another git process holds .git/index.lock (an agent's git status
                   refreshes the index): retry, then check the entry really is the committed blob.  Ignoring the
                   failure left new files staged as deletions (penoff, macbyt: the last paths of a batch). */
                {   int tries, good = 0;
                    for (tries = 0; tries < 12 && !good; tries++) {
                        char *v[] = {"git", "update-index", "--add", "--cacheinfo", info, 0}; char nb[48], nm[8];
                        if (tries) sy_sleep_ms(150 + 100 * tries);
                        run(v, out, sizeof out);
                        entry(0, path[k], nb, nm);
                        good = nb[0] && tx_eqz(nb, blob[k]);
                    }
                    if (!good) { lost++; fprintf(stderr, "COMMIT_OWN_INDEX_UNSYNCED\tpath=%s\twant=%s\thave=%s\tafter 12 tries (index.lock?)\trun: sh ./unisacc.com tools/devsvc.cx -- git add %s\n", path[k], blob[k], ib[0] ? ib : "absent", path[k]); }
                    else if (uniq) sy_printf("NOTE\t%s\tthe shared index held a staged version that was never committed (blob %s); this commit owns the path, the entry now is the committed blob; the old content: git cat-file -p %s\n", path[k], ib, ib);
                }
            }
        }
        {   char *v[] = {"git", "diff", "--cached", "--name-only", 0};
            if (run(v, out, sizeof out) == 0) {
                if (!out[0]) sy_printf("CACHED_QUIET\n");
                else {
                    long at = 0, nout = tx_len(out, sizeof out); int alien = 0;
                    while (at < nout) {
                        long e = tx_chr(out + at, nout - at, '\n'), ln = e < 0 ? nout - at : e; int mine = 0;
                        for (k = 0; k < np; k++) if (ln == tx_len(path[k], 4000) && tx_same(out + at, ln, path[k], ln)) mine = 1;
                        if (!mine && ln > 0) { alien++; sy_printf("NOTE\tcached-foreign\t%.*s\n", (int)ln, out + at); }
                        at += ln + (e >= 0);
                    }
                    if (!alien) sy_printf("CACHED_QUIET\n");
                }
            }
        }
        co_pending_collect();
        printf(CO_PHASE, t_sel, t_pend, t_regm, t_commit, att + 1);
        printf("COMMIT_OWN\tcommit=%s\tpaths=%d\tforeign_kept=%d\tindex_unsynced=%d\n", newc, np, kept, lost);
        if (lost) {   /* committed, but the shared index does not show the committed state for these paths: loud, with the remedy */
            fprintf(stderr, "COMMIT_OWN_FAIL\tclass=index-unsynced\n");
            fprintf(stderr, "commit-own: commit %s LANDED, but %d shared index entr%s could not be synced (COMMIT_OWN_INDEX_UNSYNCED lines above name each path); "
                            "do not commit again -- run the git add command of each line, then git status must show nothing staged for them\n", newc, lost, lost == 1 ? "y" : "ies");
            return 1; }
    }
    return 0;
}
