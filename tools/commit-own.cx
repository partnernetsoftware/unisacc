/* tools/commit-own.cx -- commit only your own files and your own lines of shared files, in a shared checkout.
 *
 *   sh ./unisacc.com tools/commit-own.cx -- -m MSG [--whole PATH...] [--keyed PATH KEY[,KEY...]]...
 *
 * --whole PATH: the working-tree file as it is.  --keyed PATH KEYS: only the lines of PATH you changed, i.e.
 * the changed lines that contain one of the comma-separated KEYs (tools/own-diff.cx --emit); lines other agents
 * appended or removed in the working tree stay out of the commit and stay in the working tree.  --keyed given
 * several times for one PATH is one entry with the union of the keys (each once); a KEY that no line of PATH
 * (work tree or HEAD) carries as a whole TAB field refuses with exit 2 (COMMIT_OWN_MISSING_KEY<TAB>path=<TAB>key=).
 * The commit is built in a private index (out/commit-own-PID.idx: read-tree HEAD, the blobs above), so other
 * agents' staged entries in the shared index are neither committed nor dropped.  Afterwards each committed
 * path's entry in the shared index is moved to the committed blob, whatever was staged there: the request owns
 * its paths.  A staged version that was never committed (not the old HEAD blob, not a blob of the path's last 50
 * commits) is named in a NOTE with its blob id before it is replaced; paths outside the request keep their staged
 * entries.  An entry that cannot be moved after 12 tries prints COMMIT_OWN_INDEX_UNSYNCED<TAB>path=..<TAB>run: CMD
 * and COMMIT_OWN_FAIL<TAB>class=index-unsynced on stderr, exit 1 (the commit has landed).  An entry that already is the new blob
 * 收尾: 绝不 git read-tree HEAD 覆盖默认索引。只对刚提交路径补 cacheinfo。
 * 然后 git diff --cached --name-only: 空则 CACHED_QUIET; 含非本批路径则 NOTE 保留(负控:不吞别人暂存)。
 * --registered ID...: the registration set of each batch ID as one unit: tests/manifests/ID.tsv whole, and in
 * tests/batches.tsv / tests/coverage.tsv the keyed lines (batch id, the manifest's
 * coverage id; whole fields). build/links.tsv and build/table-index.tsv are keyed too
 * (batch id, tool and check path and their basenames) and taken only when that yields a change.  Every selected
 * changed line prints SELECT<TAB>PATH<TAB>+|-LINE.  An added line of either registry table that is not
 * byte-for-byte a manifest row (a whole-field match on someone else's row) refuses with exit 1, nothing committed.
 * Before the commit, tools/reg-manifest.cx --check --index runs against the private index -- the same verdict the
 * precommit registration-manifest gate takes -- and any MISSING/MISMATCH line refuses with exit 1.
 * --dry-run: everything up to and including the pre-commit hook on the private index, no commit, the shared index
 * untouched; prints COMMIT_OWN_DRY<TAB>rc=N.  --help: the usage, exit 0.  A --whole/--keyed of a table that
 * --registered owns is dropped with a NOTE (the set's keyed rows are taken).  When git reports that HEAD moved
 * under the commit and none of the commit's paths changed in the new HEAD, the private index is rebuilt there and
 * the whole pass (gates included) replayed, at most 3 times; a path that did change there is named on stderr
 * (COMMIT_OWN_CONFLICT<TAB>path=..<TAB>by=..) and the class stays head-moved.  The pre-commit hook is not run by git commit:
 * the private index is checked out under TMP/commit-own-PID.root and the hook runs with that root as cwd and work
 * tree, so every gate reads the tree being committed, never the shared index or the shared work tree; the commit
 * is then write-tree, commit-tree and one git update-ref HEAD NEW OLD (see CO_GATE_SH and co_land).  Every run prints COMMIT_OWN_PHASE (select/pending/regm/commit ms, attempts); every
 * refusal prints COMMIT_OWN_FAIL<TAB>class=... on stderr one line before its reason.
 * Cost (2026-11-15, one --registered set in a fresh clone, 54.6 s before): every keyed path goes through one
 * tools/own-diff.cx --batch process; own-diff, reg-manifest and on-change run through DEVSVC_SELF_BIN run --local
 * (content-keyed native images) when devsvc launched this tool, because the product's -run cache is keyed by path and
 * is cold in every new root; the pending hint asks on-change for --derive-only.  See co_tool and co_owndiff.
 * Prints COMMIT_OWN<TAB>commit=SHA<TAB>paths=N<TAB>foreign_kept=M<TAB>index_unsynced=U.  Exit 0, 1 when git refuses or
 * the shared index could not be synced (U > 0: retried 12 times against index.lock), 2 on usage.
 * --derive (off by default): the derived tables the commit's paths feed are recomputed on the commit's own tree and
 * go into the same commit.  The private index is checked out under TMP/commit-own-dN.root (four flock slots, the
 * -run cache stays warm; no flock or all busy: a PID root), tools/derive.cx --write --changed PATHS runs there (only
 * the rows whose inputs_glob a path hits, see exec/facts/derive.tsv, closed over outputs that feed further rows via
 * derive --write --plan, one --write in manifest order), every file it changed is git add-ed into the private index, then derive --check --only NAME runs on that same
 * root for every row a --write wrote, all at once (read-only; one process per row, so the wall time is the
 * slowest row, not the sum: measured tool-index alone 29.5 s write+serial check before, see COMMIT_OWN_DERIVE ms).  A --write that leaves NEEDS_BUMP or a --check with DRIFT refuses (class derive-drift),
 * a generator that fails or times out refuses (class derive-failed); nothing committed.  Each derived file prints
 * DERIVED<TAB>PATH.  Generators read only the committed tree, so other agents' uncommitted rows never enter.  After
 * the commit the shared work-tree copy of a derived file gets only the recomputed lines: per line, with counts
 * O (HEAD), N (committed), W (work tree), the file keeps N + max(0, W - max(O,N)) - max(0, min(O,N) - W) copies --
 * other agents' added or removed rows stay as they were (an added row lands after its work-tree predecessor).  The
 * shared index entry moves as for any committed path.  COMMIT_OWN_DERIVE<TAB>rc=<TAB>stage=<TAB>files=<TAB>ms= is
 * printed.  UNISACC_COMMIT_OWN_DERIVE_MANIFEST=FILE passes --manifest FILE to derive.cx (tests).
 * --derive-selected (opt-in, off by default; --derive is unchanged): the same private root, but the table set comes from
 * derive.cx --touched (git diff --cached --name-status HEAD of the commit's paths, so A/D reach pathset rows; real read
 * sets plus the outputs -> inputs closure inside derive.cx), one --write --touched, and --check --only NAME for EVERY
 * selected table (not only the ones a --write wrote), so a cache-identical row is still checked. */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use sys.io
#pragma unisa use sys.poll
#pragma unisa use mem.heap
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.bytes
#pragma unisa use sys.sha

#define CO_MAX 64

/* every refusal names its class on stderr (COMMIT_OWN_FAIL<TAB>class=...) one line before the reason, so the
   devsvc event history can be classified without reading prose: args, setup, registered-foreign-row,
   reg-manifest, derive-drift, derive-failed, precommit, head-moved, index-lock, nothing-to-commit, git-or-hook,
   index-unsynced (the commit landed; the shared index entries named by COMMIT_OWN_INDEX_UNSYNCED lines did not move) */
static void co_die(const char *a, const char *b) {
    fprintf(stderr, "COMMIT_OWN_FAIL\tclass=%s\n", (tx_eqz(a, "usage") || tx_eqz(a, "no such file") || tx_eqz(a, "no registration manifest")) ? "args" : "setup");
    fprintf(stderr, "commit-own: %s%s%s\n", a, b ? ": " : "", b ? b : ""); exit(2); }
#define CO_USAGE "-m MSG [--whole PATH...] [--keyed PATH KEY[,KEY...]]... [--registered ID...] [--derive|--derive-selected] [--dry-run]"
#define CO_PHASE "COMMIT_OWN_PHASE\tselect_ms=%ld\tpending_ms=%ld\tregm_ms=%ld\tcommit_ms=%ld\tattempts=%d\n"
/* Live progress: `COMMIT_PHASE<TAB>name=N<TAB>state=begin` when a phase starts and
   `COMMIT_PHASE<TAB>name=N<TAB>state=end<TAB>ms=M` when it ends, flushed at once, so a job tail (devsvc git commit
   --status) shows the phase in flight and a timeout leaves the last begin without an end.  The precommit hook's
   gates write the same lines into this process's stdout through UNISACC_COMMIT_PHASE_LOG (/proc/PID/fd/1). */
static long co_ph_t0;
static void co_phase(const char *name, int begin) {
    if (begin) { co_ph_t0 = sy_now_ms(); sy_printf("COMMIT_PHASE\tname=%s\tstate=begin\n", name); }
    else sy_printf("COMMIT_PHASE\tname=%s\tstate=end\tms=%ld\n", name, sy_now_ms() - co_ph_t0);
    fflush(stdout);
}

/* run ARGV; its stdout (trimmed of the final newline) into OUT; the exit code or -1 */
static long g_bound_s = 30;   /* 30 s for plain git calls; the git commit call (runs the precommit hook) raises it */
static int run(char **argv, char *out, long cap) {
    char *o = 0; size_t on = 0; long n; int code;
    code = cx_runv_timeout(argv, (int)g_bound_s, &o, &on);   /* bound in seconds; stdout captured, stderr inherited */
    out[0] = 0;
    if (code < 0) { if (o) mm_free(o); return -1; }
    n = o ? (long)on : 0;
    if (n > cap - 1) n = cap - 1;
    if (n > 0) tx_copy(out, (size_t)cap, o, n);
    while (n > 0 && (out[n - 1] == '\n' || out[n - 1] == '\r')) n--;
    out[n] = 0;
    if (o) mm_free(o);
    return code;
}

/* the argv prefix that runs TOOL (v[n..], returns the new n): through the devsvc image that launched this commit
   (DEVSVC_SELF_BIN run --local --quiet: its content-keyed native cache -- the tool's use closure and the product, by
   sha) when the launcher handed one down, else the product's own -run.  The product's run cache is keyed by path, so
   in a fresh root (a clone, a work tree, a check fixture) every `sh ./unisacc.com tool.cx` first compiles for about
   5 s (measured: own-diff 5.6 s cold, 0.11 s warm, same bytes); the native cache is keyed by content and shared by
   every root.  A build artifact only: the same source runs with the same arguments and judges for itself every time.
   UNISACC_COMMIT_OWN_RUN=1 forces -run. */
static int co_via_devsvc;
static char co_product[4400];
static char *co_product_path(void){if(!co_product[0]&&sy_realpath("unisacc.com",co_product,sizeof co_product)<0)co_die("product path",0);return co_product;}
static int co_tool(char **v, int n, const char *tool) {
    const char *sb = getenv("DEVSVC_SELF_BIN"), *force = getenv("UNISACC_COMMIT_OWN_RUN");
    co_via_devsvc = sb && sb[0] == '/' && sy_exists(sb) == 1 && !(force && force[0] == '1');
    if (co_via_devsvc) { v[n++] = (char *)sb; v[n++] = "run"; v[n++] = "--local"; v[n++] = "--quiet"; v[n++] = (char *)tool; v[n++] = "--"; }
    else { v[n++] = "sh"; v[n++] = co_product_path(); v[n++] = (char *)tool; v[n++] = "--"; }
    return n;
}
/* every keyed path of the commit through ONE own-diff process (--field --batch LIST): the emitted own-only file of
   path k is co_part[k] and its foreign count co_foreign[k].  A symlink or an absent path gets no entry (the caller
   commits the link itself, or the deletion, or refuses).  Each table used to be its own process: six for one
   registered set, and each key list was cut at 1000 bytes and 54 keys; the list file has neither limit. */
static char co_part[CO_MAX][420]; static int co_foreign[CO_MAX];
/* --keyed PATH KEYS given more than once for one PATH: one entry, its keys the union (in order, each key once).
   Each --keyed used to be its own entry; the private index took the blob of the last one, so only the last
   key's lines were committed (2026-11-16: two tool-index rows given as two --keyed, one landed). */
static char co_ukey[CO_MAX][8192];
static int co_ukey_has(const char *list, const char *s, long n) {
    const char *p = list;
    while (*p) { const char *e = p; while (*e && *e != ',') e++;
        if (e - p == n && tx_same(p, n, s, n)) return 1; p = *e ? e + 1 : e; }
    return 0;
}
static void co_ukey_add(int k, const char *keys) {
    const char *p = keys;
    while (*p) {
        const char *e = p; long have = tx_len(co_ukey[k], sizeof co_ukey[k]);
        while (*e && *e != ',') e++;
        if (e > p && !co_ukey_has(co_ukey[k], p, (long)(e - p))) {
            if (have + (long)(e - p) + 2 >= (long)sizeof co_ukey[k]) co_die("keys too long", keys);
            if (have) co_ukey[k][have++] = ',';
            tx_copy(co_ukey[k] + have, sizeof co_ukey[k] - have, p, (long)(e - p));
            co_ukey[k][have + (e - p)] = 0;
        }
        p = *e ? e + 1 : e;
    }
}
/* 1 when some line of BUF[0..n) has a whole TAB field equal to KEY[0..kn) (own-diff --field's match) */
static int co_has_field(const char *b, long n, const char *key, long kn) {
    long i = 0, st = 0;
    if (!b) return 0;
    for (; i <= n; i++) if (i == n || b[i] == '\t' || b[i] == '\n') {
        long fl = i - st; if (fl > 0 && b[st + fl - 1] == '\r') fl--;
        if (fl == kn && tx_same(b + st, kn, key, kn)) return 1;
        st = i + 1;
    }
    return 0;
}
/* a --keyed KEY that no line of PATH (work tree or HEAD) carries as a whole field: named, nothing committed */
static void co_ukey_check(const char *path, const char *keys) {
    char spec[400], *h = 0, *w = 0; size_t hn = 0, wn = 0; char *hv[] = {"git", "show", spec, 0}; const char *p = keys; int miss = 0;
    sy_stat_t st;
    if ((sy_lstat(path, &st) == 0 && st.kind == 'l') || sy_exists(path) != 1) return;
    if (cx_fmt(spec, sizeof spec, "HEAD:%s", path)) co_die("path", path);
    if (cx_runv_timeout(hv, 30, &h, &hn) != 0) { if (h) mm_free(h); h = 0; hn = 0; }
    w = (char *)cx_read(path, &wn);
    while (*p) {
        const char *e = p; while (*e && *e != ',') e++;
        if (e > p && !co_has_field(w, (long)wn, p, (long)(e - p)) && !co_has_field(h, (long)hn, p, (long)(e - p))) {
            if (!miss) fprintf(stderr, "COMMIT_OWN_FAIL\tclass=args\n");
            fprintf(stderr, "COMMIT_OWN_MISSING_KEY\tpath=%s\tkey=%.*s\n", path, (int)(e - p), p); miss++;
        }
        p = *e ? e + 1 : e;
    }
    if (w) mm_free(w);
    if (h) mm_free(h);
    if (miss) { fprintf(stderr, "commit-own: REFUSE --keyed %s: %d key(s) not found as a whole field in the file; nothing committed\n", path, miss); exit(2); }
}
static void co_owndiff(const char **path, const char **keys, int np) {
    static char lst[CO_MAX * 5200]; char lpath[420], *o = 0, *ov[12]; size_t on = 0; long ln = 0, at = 0; int k, nb = 0, rc, got = 0, n;
    for (k = 0; k < np; k++) {
        sy_stat_t st; const char *p; int w;
        co_part[k][0] = 0; co_foreign[k] = 0;
        if (!keys[k] || (sy_lstat(path[k], &st) == 0 && st.kind == 'l') || !sy_exists(path[k])) continue;
        if (tx_snprintf(co_part[k], sizeof co_part[k], "%s/commit-own-%d-%d.part", sy_tmpdir(), sy_pid(), k) >= (int)sizeof co_part[k]) co_die("path", 0);
        w = tx_snprintf(lst + ln, sizeof lst - (size_t)ln, "%s\t%s", co_part[k], path[k]);
        if (w < 0 || w >= (int)(sizeof lst - (size_t)ln)) co_die("keys too long", path[k]);
        ln += w;
        for (p = keys[k]; *p; ) {
            const char *e = p;
            while (*e && *e != ',') e++;
            if (e > p) {
                if (ln + (long)(e - p) + 3 >= (long)sizeof lst) co_die("keys too long", path[k]);
                lst[ln++] = '\t';
                while (p < e) lst[ln++] = *p++;
            }
            p = *e ? e + 1 : e;
        }
        if (ln + 2 >= (long)sizeof lst) co_die("keys too long", path[k]);
        lst[ln++] = '\n'; nb++;
    }
    if (!nb) return;
    if (tx_snprintf(lpath, sizeof lpath, "%s/commit-own-%d.batch", sy_tmpdir(), sy_pid()) >= (int)sizeof lpath || cx_write(lpath, lst, (size_t)ln)) co_die("cannot write the own-diff batch list", 0);
    n = co_tool(ov, 0, "tools/own-diff.cx"); ov[n++] = "--field"; ov[n++] = "--batch"; ov[n++] = lpath; ov[n] = 0;
    rc = cx_runv_timeout(ov, 30, &o, &on);   /* 30 s for the whole batch (it was 30 s per table) */
    sy_unlink(lpath);
    if (rc != 0 && rc != 1) { if (o) mm_free(o); co_die("own-diff failed", "tools/own-diff.cx --batch"); }
    k = 0;
    while (o && at < (long)on) {
        long e = tx_chr(o + at, (long)on - at, '\n'), l = e < 0 ? (long)on - at : e;
        if (e >= 0 && tx_prefix(o + at, l, "OWN_DIFF\town=", 13)) {
            long f = tx_find(o + at, l, "\tforeign=", 9);
            while (k < np && !co_part[k][0]) k++;
            if (k < np && f >= 0) { co_foreign[k] = (int)strtol(o + at + f + 9, 0, 10); k++; got++; }
        }
        at += l + 1;
    }
    if (o) mm_free(o);
    if (got != nb) co_die("own-diff failed", "the batch did not report every keyed path");
}

#define CO_REPLAY 3   /* replays when HEAD moved under the commit and none of its paths changed there */
/* $0 = the private gate root (TMP/commit-own-PID.root).  The tree of the private index (archive/ left out: 5400
   files no gate reads) is checked out there; top-level entries git does not track (unisacc.com, out/, archive)
   are symlinked from the shared checkout (.git too: hooks that keep state under a relative .git/ path still work).  The pre-commit hook git would run (core.hooksPath honoured) then runs
   with that root as cwd and work tree; an absent hook is a pass and no root is built.  The root is removed.
   The root's path is one of eight slots, TMP/commit-own-s0..7.root, held by flock(1) on TMP/commit-own-sN.lock for
   the length of the gate run (the kernel drops the lock with the process, so a killed commit leaves no stale slot;
   the hook does not inherit the descriptor).  The product's -run cache is keyed by path: under the old
   TMP/commit-own-PID.root every gate tool compiled cold in every commit (measured 31.8 s of gates for one registered
   set); a slot path makes the second commit warm.  No flock, or all eight slots busy: the PID root as before. */
#define CO_GATE_SH \
    "h=$(git rev-parse --git-path hooks/pre-commit) || exit 1; [ -x \"$h\" ] || exit 0; " \
    "case \"$h\" in /*) ;; *) h=\"$PWD/$h\" ;; esac; " \
    "case \"$GIT_INDEX_FILE\" in /*) ;; *) GIT_INDEX_FILE=\"$PWD/$GIT_INDEX_FILE\"; export GIT_INDEX_FILE ;; esac; " \
    "g=$(git rev-parse --absolute-git-dir) || exit 1; r=; " \
    "if command -v flock >/dev/null 2>&1; then for s in 0 1 2 3 4 5 6 7; do c=\"${0%/*}/commit-own-s$s\"; " \
    "( : >>\"$c.lock\" ) 2>/dev/null || break; exec 9>>\"$c.lock\"; if flock -n 9; then r=\"$c.root\"; break; fi; done; fi; " \
    "[ -n \"$r\" ] || { exec 9>&-; r=\"$0\"; }; " \
    "case \"$r\" in */commit-own-*.root) ;; *) echo 'commit-own: bad private gate root'; exit 1 ;; esac; " \
    "rm -rf \"$r\"; mkdir -p \"$r\" || { echo 'commit-own: cannot create the private gate root'; exit 1; }; " \
    "git ls-files -z -- . ':(exclude)archive' | git checkout-index -z --stdin --prefix=\"$r/\" || { rm -rf \"$r\"; echo 'commit-own: cannot check the private index out for the gates'; exit 1; }; " \
    "for e in * .[!.]*; do [ \"$e\" = .devsvc ] || [ -e \"$r/$e\" ] || [ -L \"$r/$e\" ] || [ ! -e \"$e\" ] || ln -s \"$PWD/$e\" \"$r/$e\"; done; " \
    "( cd \"$r\" && UNISACC_DEVMETA_DIR=\"$r/.devsvc\" GIT_DIR=\"$g\" GIT_WORK_TREE=\"$r\" \"$h\" ) 9>&- 2>&1; rc=$?; rm -rf \"$r\"; exit $rc"
/* --derive: $0 = TMP, "$@" = the commit's paths, GIT_INDEX_FILE = the private index (absolute).  See the header.
   Last line CO_DERIVE<TAB>rc=N<TAB>stage=plan|write|add|check|ok|setup; DERIVED<TAB>PATH per derived file and
   derive.cx's own DERIVE lines before it.  The root is removed; fd 8 (the slot lock) is not inherited.  The changed
   set is closed first with derive --write --plan (no generator runs: the selected rows' outputs join the set until
   it stops growing, at most 6 rounds), then ONE --write runs in manifest order, so a row whose input another row
   writes runs after it, once (the earlier second --write reran tool-index and links: about 10 s). */
#define CO_DERIVE_SH CO_DERIVE_SETUP CO_DERIVE_CHANGED
#define CO_DERIVE_SEL_SH CO_DERIVE_SETUP CO_DERIVE_TOUCHED
/* --derive-selected: touched list with A/M/D from the private index, one plan (PLAN outputs, SELECT names), one
   --write --touched, then --check --only for every selected name (ws = sel), the rest shared with --derive. */
#define CO_DERIVE_TOUCHED \
    "git diff --cached --name-status --no-renames HEAD -- $cs >\"$o.t\" || fin 2 plan; [ -s \"$o.t\" ] || printf '%s\\n' $cs >\"$o.t\"; " \
    "sh ./unisacc.com tools/derive.cx -- --write --plan $m --touched \"$o.t\" 8>&- >\"$o.p\" || fin 2 plan; cat \"$o.p\" | grep '^SELECT'; " \
    "po=$(while IFS='\t' read -r a b c d e; do [ \"$a\" = PLAN ] && echo \"$e\"; done <\"$o.p\"); " \
    "sel=$(while IFS='\t' read -r a b c; do [ \"$a\" = SELECT ] && echo \"$b\"; done <\"$o.p\"); " \
    "bt=$(git write-tree) || fin 2 setup; " \
    "sh ./unisacc.com tools/derive.cx -- --write $m --touched \"$o.t\" 8>&- >\"$o.w1\"; w=$?; cat \"$o.w1\"; [ $w = 0 ] || fin $w write; " \
    CO_DERIVE_ADD "ws=$sel; " CO_DERIVE_CHECK
#define CO_DERIVE_SETUP \
    "fin(){ [ -z \"$r\" ] || { cd /; rm -rf \"$r\" \"$r.out\".*; }; printf 'CO_DERIVE\\trc=%s\\tstage=%s\\n' \"$1\" \"$2\"; exit \"$1\"; }; r=; " \
    "case \"$GIT_INDEX_FILE\" in /*) ;; *) fin 2 setup ;; esac; " \
    "g=$(git rev-parse --absolute-git-dir) || fin 2 setup; " \
    "if command -v flock >/dev/null 2>&1; then for s in 0 1 2 3; do c=\"$0/commit-own-d$s\"; " \
    "( : >>\"$c.lock\" ) 2>/dev/null || break; exec 8>>\"$c.lock\"; if flock -n 8; then r=\"$c.root\"; break; fi; done; fi; " \
    "[ -n \"$r\" ] || { exec 8>&-; r=\"$0/commit-own-d$$.root\"; }; " \
    "rm -rf \"$r\"; mkdir -p \"$r\" || fin 2 setup; " \
    "git ls-files -z -- . ':(exclude)archive' | git checkout-index -z --stdin --prefix=\"$r/\" || fin 2 setup; " \
    "for e in * .[!.]*; do [ \"$e\" = .devsvc ] || [ -e \"$r/$e\" ] || [ -L \"$r/$e\" ] || [ ! -e \"$e\" ] || ln -s \"$PWD/$e\" \"$r/$e\"; done; " \
    "[ -f \"$r/tools/derive.cx\" ] || fin 2 setup; " \
    "cd \"$r\" || fin 2 setup; GIT_DIR=\"$g\"; GIT_WORK_TREE=\"$r\"; UNISACC_DEVMETA_DIR=\"$r/.devsvc\"; export GIT_DIR GIT_WORK_TREE UNISACC_DEVMETA_DIR; " \
    "m=; [ -z \"$UNISACC_COMMIT_OWN_DERIVE_MANIFEST\" ] || m=\"--manifest $UNISACC_COMMIT_OWN_DERIVE_MANIFEST\"; " \
    "o=\"$r.out\"; rm -f \"$o\".*; " \
    "cs=$(printf '%s\\n' \"$@\" | sort -u | tr '\\n' ' '); "
#define CO_DERIVE_CHANGED \
    "for i in 1 2 3 4 5 6; do po=$(sh ./unisacc.com tools/derive.cx -- --write --plan $m --changed $cs 8>&- | while IFS='\t' read -r a b c d e; do [ \"$a\" = PLAN ] && echo \"$e\"; done) || fin 2 plan; " \
    "nc=$(printf '%s\\n' $cs $po | sort -u | tr '\\n' ' '); [ \"$nc\" = \"$cs\" ] && break; cs=$nc; done; " \
    "bt=$(git write-tree) || fin 2 setup; " \
    "sh ./unisacc.com tools/derive.cx -- --write $m --changed $cs 8>&- >\"$o.w1\"; w=$?; cat \"$o.w1\"; [ $w = 0 ] || fin $w write; " \
    CO_DERIVE_ADD \
    "ws=$(cat \"$o\".w* | while IFS='\t' read -r a b c d; do [ \"$a\" = DERIVE ] && [ \"$c\" = WROTE ] && echo \"$b\"; done | sort -u); " \
    CO_DERIVE_CHECK
#define CO_DERIVE_ADD \
    "n=$(git diff --name-only -- . ':(exclude)archive'); " \
    "[ -z \"$n\" ] || git add -- $n || fin 2 add; " \
    "for p in $po; do [ ! -e \"$p\" ] || git add -- \"$p\" || fin 2 add; done; " \
    "n=$(git diff --cached --name-only \"$bt\" -- . ':(exclude)archive'); "
#define CO_DERIVE_CHECK \
    "ps=; for x in $ws; do sh ./unisacc.com tools/derive.cx -- --check $m --only $x 8>&- >\"$o.c.$x\" & ps=\"$ps $!\"; done; " \
    "w=0; for p in $ps; do wait $p; c=$?; [ $c -le $w ] || w=$c; done; " \
    "for x in $ws; do grep '^DERIVE\t' \"$o.c.$x\" | grep -v '\tSKIPPED\t'; done; [ $w = 0 ] || fin $w check; " \
    "for p in $n; do printf 'DERIVED\\t%s\\n' \"$p\"; done; fin 0 ok"
static int run(char **argv, char *out, long cap);
/* --derive, after the commit: the shared work-tree copy of PATH gets only the recomputed lines (see the header for
   the count rule).  OLDB = the HEAD blob ("" = new file), NEWB = the committed blob.  0 written or nothing to do. */
typedef struct { const char *p; long n; } CoLn;
static long co_split(const char *b, long n, CoLn *v, long cap) {
    long at = 0, k = 0;
    while (at < n && k < cap) { long e = tx_chr(b + at, n - at, '\n'), l = e < 0 ? n - at : e; v[k].p = b + at; v[k].n = l; k++; at += l + 1; }
    return k;
}
static long co_cnt(const CoLn *v, long nv, const CoLn *x) {
    long i, c = 0; for (i = 0; i < nv; i++) if (v[i].n == x->n && tx_same(v[i].p, v[i].n, x->p, x->n)) c++; return c;
}
static char *co_blob(const char *b, long *n) {
    char *v[] = {"git", "cat-file", "blob", (char *)b, 0}, *o = 0; size_t on = 0;
    *n = 0; if (!b[0]) { o = mm_alloc(1); if (o) o[0] = 0; return o; }
    if (cx_runv_timeout(v, 30, &o, &on) != 0) { if (o) mm_free(o); return 0; }
    *n = (long)on; return o;
}
static int co_merge(const char *path, const char *oldb, const char *newb) {
    long no, nn, nw, lo, ln_, lw, i, j, k, m = 0, cap; size_t wn = 0; char *ob = co_blob(oldb, &no), *nb = co_blob(newb, &nn), *wb = cx_read(path, &wn), *res;
    CoLn *O, *N, *W, *R; int rc = 1;
    if (!ob || !nb) goto out;
    if (!wb) { rc = cx_write(path, nb, (size_t)nn) ? 1 : 0; goto out; }   /* gone from the work tree: the committed copy */
    nw = (long)wn;
    cap = no + nn + nw + 3;
    O = mm_alloc(cap * (long)sizeof(CoLn) * 4); if (!O) goto out;
    N = O + cap; W = N + cap; R = W + cap;
    lo = co_split(ob, no, O, cap); ln_ = co_split(nb, nn, N, cap); lw = co_split(wb, nw, W, cap);
    /* the committed lines, less one copy per line someone removed from the work tree (min(O,N) - W > 0) */
    for (i = 0; i < ln_; i++) {
        long co = co_cnt(O, lo, &N[i]), cn = co_cnt(N, ln_, &N[i]), cw = co_cnt(W, lw, &N[i]), lo2 = co < cn ? co : cn, drop = lo2 - cw, have = co_cnt(R, m, &N[i]);
        if (drop < 0) drop = 0;
        if (have < cn - drop) R[m++] = N[i];
    }
    /* plus the work tree's extra copies (W - max(O,N) > 0), each after its work-tree predecessor */
    for (i = 0; i < lw; i++) {
        long co = co_cnt(O, lo, &W[i]), cn = co_cnt(N, ln_, &W[i]), cw = co_cnt(W, lw, &W[i]), hi = co > cn ? co : cn, have = co_cnt(R, m, &W[i]);
        long want = cn + (cw - hi > 0 ? cw - hi : 0), at = m;
        if (have >= want || cw - hi <= 0) continue;
        for (j = i - 1; j >= 0; j--) { for (k = m - 1; k >= 0; k--) if (R[k].n == W[j].n && tx_same(R[k].p, R[k].n, W[j].p, W[j].n)) break; if (k >= 0) { at = k + 1; break; } }
        if (j < 0) at = 0;
        for (k = m; k > at; k--) R[k] = R[k - 1];
        R[at] = W[i]; m++;
    }
    {   long tot = 0, w = 0; for (i = 0; i < m; i++) tot += R[i].n + 1;
        res = mm_alloc(tot + 1);
        if (res) { for (i = 0; i < m; i++) { if (R[i].n) mm_copy(res + w, tot + 1 - w, R[i].p, R[i].n); w += R[i].n; res[w++] = '\n'; }
            if (w && nn && nb[nn - 1] != '\n' && m) w--;   /* keep the committed file's missing final newline */
            rc = cx_write(path, res, (size_t)w) ? 1 : 0; mm_free(res); } }
    mm_free(O);
out:
    if (ob) mm_free(ob); if (nb) mm_free(nb); if (wb) mm_free(wb);
    return rc;
}
/* the commit itself, after the gates passed on the private tree: write-tree of the private index, commit-tree on
   BASE, then one compare-and-swap of HEAD (git update-ref HEAD NEW BASE).  No hook runs here and nothing is locked
   by us; a HEAD that moved meanwhile fails the swap with git's "cannot lock ref 'HEAD'" and the caller replays the
   whole pass (gates included) on the new HEAD or reports the conflict.  1 with the reason in OUT on failure. */
static int co_land(const char *msg, const char *basec, char *newfull, char *out, long cap) {
    char tree[64], btree[64], spec[64];
    char *wv[] = {"git", "write-tree", 0}, *bv[] = {"git", "rev-parse", spec, 0};
    newfull[0] = 0;
    if (tx_snprintf(spec, sizeof spec, "%s^{tree}", basec) >= (int)sizeof spec) return 1;
    if (run(wv, tree, sizeof tree) != 0 || run(bv, btree, sizeof btree) != 0 || tx_len(tree, sizeof tree) != 40) { tx_snprintf(out, (size_t)cap, "git write-tree failed on the private index"); return 1; }
    if (tx_eqz(tree, btree)) { tx_snprintf(out, (size_t)cap, "nothing to commit: the selected paths equal HEAD"); return 1; }
    {   char *cv[] = {"sh", "-c", "exec \"$@\" 2>&1", "sh", "git", "commit-tree", tree, "-p", (char *)basec, "-m", (char *)msg, 0};
        if (run(cv, out, cap) != 0 || tx_len(out, cap) != 40) return 1;
        tx_copy(newfull, 64, out, 40); newfull[40] = 0; }
    {   char *uv[] = {"sh", "-c", "exec \"$@\" 2>&1", "sh", "git", "update-ref", "-m", "commit (commit-own)", "HEAD", newfull, (char *)basec, 0};
        return run(uv, out, cap) != 0; }
}
/* HEAD moved and PATH differs there from the base this commit was built on: name the path and the commit */
static void co_conflict(const char *path, const char *basec) {
    char range[80], by[200]; char *v[] = {"git", "log", "-1", "--format=%h %s", range, "--", (char *)path, 0};
    by[0] = 0;
    if (tx_snprintf(range, sizeof range, "%s..HEAD", basec) < (int)sizeof range) run(v, by, sizeof by);
    fprintf(stderr, "COMMIT_OWN_CONFLICT\tpath=%s\tby=%s\n", path, by[0] ? by : "unknown");
}
/* the blob of PATH at TREE ("HEAD") or in the shared index (tree 0), and its mode; "" when absent */
static void entry(const char *tree, const char *path, char *blob, char *mode) {
    char out[8192];
    blob[0] = 0; mode[0] = 0;
    if (tree) { char *v[] = {"git", "ls-tree", (char *)tree, "--", (char *)path, 0}; if (run(v, out, sizeof out) != 0) return; }
    else { char *v[] = {"git", "ls-files", "-s", "--", (char *)path, 0}; if (run(v, out, sizeof out) != 0) return; }
    /* ls-tree: "MODE blob SHA\tPATH"; ls-files -s: "MODE SHA STAGE\tPATH" */
    if (tx_len(out, sizeof out) < 50) return;
    tx_copy(mode, 8, out, 6);
    if (tree) tx_copy(blob, 41, out + 12, 40); else tx_copy(blob, 41, out + 7, 40);
}

/* 1 when BLOB is PATH's content in one of the last 50 commits that touched it: an already-committed version left
   in the shared index (e.g. a `git add` before an earlier commit-own), not anyone's unique staged work */
static int committed_before(const char *path, const char *blob) {
    char out[8192], b[48], m[8]; long at = 0, n;
    char *v[] = {"git", "log", "-n", "50", "--format=%H", "--", (char *)path, 0};
    if (run(v, out, sizeof out) != 0) return 0;
    n = tx_len(out, sizeof out);
    while (at + 40 <= n) {
        char sha[41]; tx_copy(sha, sizeof sha, out + at, 40);
        entry(sha, path, b, m);
        if (b[0] && tx_eqz(b, blob)) return 1;
        at += 41;
    }
    return 0;
}

/* --registered: authoritative registry tables, then links and the table catalog. */
#define CO_REGT 4
static const char *CO_REG_TABLE[CO_REGT] = {"tests/batches.tsv", "tests/coverage.tsv",
                                            "build/links.tsv", "build/table-index.tsv"};
static const char *CO_REG_KIND[2] = {"batch", "coverage"};
static char co_regkeys[CO_REGT][4096];   /* comma-separated keys per table */
static char *co_regrows[2];              /* manifest rows per registry table, '\n'-joined (each row once) */
static long co_regrown[2];
static int co_reg_of[CO_MAX];            /* table index of path k, -1 when not a --registered table */
static char co_manpath[CO_MAX][300];

static void co_addkey(int t, const char *s, long n) {
    if(t<0||t>=CO_REGT)co_die("registration table index",0);
    long have = tx_len(co_regkeys[t], sizeof co_regkeys[t]);
    if (n <= 0) return;
    if (have + n + 2 >= (long)sizeof co_regkeys[t]) co_die("too many --registered keys", CO_REG_TABLE[t]);
    if (have) co_regkeys[t][have++] = ',';
    tx_copy(co_regkeys[t] + have, sizeof co_regkeys[t] - have, s, n);
    co_regkeys[t][have + n] = 0;
}
static void co_addrow(int t, const char *s, long n) {
    char *g = mm_alloc(co_regrown[t] + n + 2);
    if (!g) co_die("out of memory", 0);
    if (co_regrown[t]) tx_copy(g, co_regrown[t] + 1, co_regrows[t], co_regrown[t]);
    tx_copy(g + co_regrown[t], n + 1, s, n); g[co_regrown[t] + n] = '\n'; g[co_regrown[t] + n + 1] = 0;
    if (co_regrows[t]) mm_free(co_regrows[t]);
    co_regrows[t] = g; co_regrown[t] += n + 1;
}
/* field F (0-based) of the TAB line S[0..n) */
static long co_field(const char *s, long n, int f, long *len) {
    long i = 0, st = 0; int c = 0;
    for (;; i++) {
        if (i == n || s[i] == '\t') { if (c == f) { *len = i - st; return st; } c++; st = i + 1; if (i == n) break; }
    }
    *len = 0; return -1;
}
/* Read manifest keys for the selected tables. */
static void co_manifest(const char *id, char *mpath, long mcap) {
    size_t n = 0; char *m; long at = 0;
    if (cx_fmt(mpath, mcap, "tests/manifests/%s.tsv", id)) co_die("manifest path", id);
    m = (char *)cx_read(mpath, &n);
    if (!m) co_die("no registration manifest", mpath);
    co_addkey(0, id, tx_len(id, 256)); co_addkey(2, id, tx_len(id, 256));
    co_addkey(3, id, tx_len(id, 256));
    while (at < (long)n) {
        long e = tx_chr(m + at, (long)n - at, '\n'), ln = e < 0 ? (long)n - at : e, tab = tx_chr(m + at, ln, '\t'); int t;
        for (t = 0; t < 2 && tab > 0; t++)
            if (tab == tx_len(CO_REG_KIND[t], 16) && tx_same(m + at, tab, CO_REG_KIND[t], tab)) {
                const char *row = m + at + tab + 1; long rl = ln - tab - 1, fl, fs;
                co_addrow(t, row, rl);
                if (t == 0) {
                    if ((fs = co_field(row, rl, 10, &fl)) >= 0 && fl > 1) co_addkey(1, row + fs, fl);
                    {   int f; for (f = 3; f <= 8; f += 5) if ((fs = co_field(row, rl, f, &fl)) >= 0 && fl > 1) {
                            long b = fl; while (b > 0 && row[fs + b - 1] != '/') b--;
                            co_addkey(2, row + fs, fl); co_addkey(3, row + fs, fl);
                            if (b > 0) { co_addkey(2, row + fs + b, fl - b); co_addkey(3, row + fs + b, fl - b); }
                        } }
                }
            }
        at += ln + (e >= 0);
    }
    mm_free(m);
}
/* 1 when LINE[0..n) is one of the manifest rows of registry table T */
static int co_isrow(int t, const char *s, long n) {
    long at = 0;
    while (at < co_regrown[t]) { long e = tx_chr(co_regrows[t] + at, co_regrown[t] - at, '\n');
        if (e == n && tx_same(co_regrows[t] + at, n, s, n)) return 1; at += e + 1; }
    return 0;
}
/* list the changed lines of SRC (the emitted file) vs HEAD:PATH as SELECT lines; for a registry table (T < 2)
   an added line that is not a manifest row is counted and returned (the caller refuses the commit) */
static int co_select(const char *path, const char *src, int t, int *changed) {
    char spec[400], *h = 0; size_t hn = 0, wn = 0; char *w; char *hv[] = {"git", "show", spec, 0};
    long at, nh = 0, i, from = 0; long *hs, *hl; char *used; int bad = 0;
    *changed = 0;
    if (cx_fmt(spec, sizeof spec, "HEAD:%s", path)) co_die("path", path);
    if (cx_runv_timeout(hv, 30, &h, &hn) != 0) { if (h) mm_free(h); h = 0; hn = 0; }
    w = (char *)cx_read(src, &wn);
    if (!w) co_die("cannot read the selection", src);
    for (at = 0; at < (long)hn; ) { long e = tx_chr(h + at, (long)hn - at, '\n'); nh++; if (e < 0) break; at += e + 1; }
    hs = mm_alloc((nh + 1) * (long)sizeof(long)); hl = mm_alloc((nh + 1) * (long)sizeof(long)); used = mm_alloc(nh + 1);
    if (!hs || !hl || !used) co_die("out of memory", 0);
    for (at = 0, i = 0; at < (long)hn && i < nh; i++) { long e = tx_chr(h + at, (long)hn - at, '\n'), ln = e < 0 ? (long)hn - at : e; hs[i] = at; hl[i] = ln; used[i] = 0; at += ln + 1; }
    for (at = 0; at < (long)wn; ) {
        long e = tx_chr(w + at, (long)wn - at, '\n'), ln = e < 0 ? (long)wn - at : e, j, hit = -1;
        for (j = 0; j < nh; j++) {   /* scan from just after the last hit: unchanged lines are in order */
            long q = (from + j) % nh;
            if (!used[q] && hl[q] == ln && tx_same(h + hs[q], ln, w + at, ln)) { hit = q; break; }
        }
        if (hit >= 0) { used[hit] = 1; from = hit + 1 < nh ? hit + 1 : 0; }
        else {
            int ok = t >= 2 || co_isrow(t, w + at, ln);
            sy_printf("SELECT\t%s\t+%.*s%s\n", path, (int)ln, w + at, ok ? "" : "\t<- not a manifest row");
            (*changed)++; if (!ok) bad++;
        }
        if (e < 0) break; at += e + 1;
    }
    for (i = 0; i < nh; i++) if (!used[i]) { sy_printf("SELECT\t%s\t-%.*s\n", path, (int)hl[i], h + hs[i]); (*changed)++; }
    mm_free(hs); mm_free(hl); mm_free(used); mm_free(w); if (h) mm_free(h);
    return bad;
}

/* the pending-derived hint: tools/on-change.cx --dry-run is started before the commit and read when the commit is
   over (run in line it was 5.2 s of a 19 s commit).  Read-only; never blocks, never changes the exit code; a
   failed start or a 30 s overrun is skipped silently (the child is killed and reaped). */
static int co_pend_pid = -1, co_pend_fd = -1;
static void co_pending_collect(void) {
    static char oc[16384]; char seen[1024]; long no = 0, at = 0, r, deadline = sy_now_ms() + 30000; int ex = 0, code = 0, sig = 0;
    if (co_pend_pid < 0) return;
    for (;;) {
        sy_pollfd_t pf; long left = deadline - sy_now_ms();
        pf.fd = co_pend_fd; pf.events = SY_POLLIN; pf.revents = 0;
        if (left <= 0 || sy_poll(&pf, 1, left) <= 0) { sy_close(co_pend_fd); sy_kill(co_pend_pid); sy_wait_status(co_pend_pid, 0, &ex, &code, &sig); co_pend_pid = -1; return; }
        r = sy_read(co_pend_fd, oc + no, (long)sizeof oc - 1 - no);
        if (r <= 0) break;
        no += r;
        if (no + 1 >= (long)sizeof oc) break;
    }
    sy_close(co_pend_fd);
    sy_wait_status(co_pend_pid, 0, &ex, &code, &sig); co_pend_pid = -1;
    oc[no] = 0; seen[0] = 0;
    while (at < no) {
        long e = tx_chr(oc + at, no - at, '\n'), ln = e < 0 ? no - at : e, p = tx_find(oc + at, ln, " pending=", 9);
        if (p >= 0) {
            long s = at + p + 9, q = s;
            while (q < at + ln && oc[q] != ' ') q++;
            while (s < q) {
                long c = s, w; char item[128];
                while (c < q && oc[c] != ',') c++;
                w = c - s;
                if (w > 0 && !(w == 1 && oc[s] == '-') && w < (long)sizeof item) {
                    char key[136];
                    tx_copy(item, sizeof item, oc + s, w); item[w] = 0;
                    if (tx_snprintf(key, sizeof key, ",%s,", item) < (int)sizeof key && tx_find(seen, tx_len(seen, sizeof seen), key, tx_len(key, 136)) < 0) {
                        long sl = tx_len(seen, sizeof seen);
                        if (sl + w + 2 < (long)sizeof seen) tx_snprintf(seen + sl, sizeof seen - sl, "%s", key);
                        sy_printf("COMMIT_OWN pending-derived=%s run: sh ./unisacc.com tools/derive.cx -- --write --only %s\n", item, item);
                    }
                }
                s = c + 1;
            }
        }
        at += ln + (e >= 0);
    }
}

int main(int argc, char **argv) {
    const char *msg = 0, *path[CO_MAX], *keys[CO_MAX]; int np = 0, k, a = 1, kept = 0, lost = 0, nreg = 0, refused = 0;
    int dry = 0, att = 0, derive = 0, derive_sel = 0, np0 = 0, nder = 0; long t_der = 0;
    const char *prepare = 0, *receipt = 0, *receipt_id = 0;
    static char dpath[CO_MAX][400];   /* --derive: the derived files appended after the commit's own paths */ long t0 = sy_now_ms(), t_sel = 0, t_pend = 0, t_regm = 0, t_commit = 0, tc0; const char *fcls = "git-or-hook";
    char gatef[400] = "", idx[400], blob[CO_MAX][64], out[8192], root[4096];
    char link[CO_MAX];   /* 1 when --whole PATH is a symlink: commit 120000, blob = the target string */
    char skip[CO_MAX];   /* 1 when a --registered derived table yields no change: left out of the commit */
    char del[CO_MAX];    /* 1 when --whole PATH is in HEAD but gone from the work tree (git rm): commit the deletion */
    for (k = 0; k < CO_MAX; k++) { co_reg_of[k] = -1; skip[k] = 0; del[k] = 0; }
    while (a < argc) {
        if (tx_eqz(argv[a], "--help") || tx_eqz(argv[a], "-h")) { sy_printf("commit-own: usage: " CO_USAGE "\n"); return 0; }
        else if (tx_eqz(argv[a], "--derive")) { derive = 1; a++; }
        else if (tx_eqz(argv[a], "--derive-selected")) { derive = 1; derive_sel = 1; a++; }
        else if (tx_eqz(argv[a], "--derive-prepare") && a + 1 < argc) { prepare = argv[a + 1]; derive = 1; a += 2; }
        else if (tx_eqz(argv[a], "--derive-receipt") && a + 1 < argc) { receipt = argv[a + 1]; derive = 1; a += 2; }
        else if (tx_eqz(argv[a], "--derive-id") && a + 1 < argc) { receipt_id = argv[a + 1]; a += 2; }
        else if (tx_eqz(argv[a], "--dry-run")) { dry = 1; a++; }   /* everything up to and including the pre-commit hook, on the private index; no commit */
        else if (tx_eqz(argv[a], "-m") && a + 1 < argc) { msg = argv[a + 1]; a += 2; }
        else if (tx_eqz(argv[a], "--registered")) {
            a++;
            while (a < argc && argv[a][0] != '-') {
                if (np == CO_MAX) co_die("too many paths", 0);
                co_manifest(argv[a], co_manpath[np], sizeof co_manpath[np]);
                path[np] = co_manpath[np]; keys[np] = 0; np++; nreg++; a++;
            }
        }
        else if (tx_eqz(argv[a], "--whole")) {
            a++;
            while (a < argc && argv[a][0] != '-') { if (np == CO_MAX) co_die("too many paths", 0); path[np] = argv[a]; keys[np] = 0; np++; a++; }
        } else if (tx_eqz(argv[a], "--keyed") && a + 2 < argc) {
            int j;   /* at parse time only a --keyed entry has keys: merge a repeated PATH into its first entry */
            for (j = 0; j < np; j++) if (keys[j] && tx_eqz(path[j], argv[a + 1])) break;
            if (j == np) {
                if (np == CO_MAX) co_die("too many paths", 0);
                co_ukey[np][0] = 0; path[np] = argv[a + 1]; keys[np] = co_ukey[np]; np++;
            }
            co_ukey_add(j, argv[a + 2]);
            if (!co_ukey[j][0]) co_die("usage", "--keyed PATH needs at least one non-empty KEY");
            a += 3;
        } else co_die("usage", CO_USAGE);
    }
    if (nreg) {
        int t;
        for (t = 0; t < CO_REGT; t++) {
            if (!co_regkeys[t][0] || sy_exists(CO_REG_TABLE[t]) != 1) continue;
            /* a --whole/--keyed of a table this set owns is dropped, not refused (5 of the 20 failed devsvc commits
               were this refusal): the set's keyed rows are the narrower selection, other rows stay in the work tree */
            for (k = 0; k < np; k++) if (tx_eqz(path[k], CO_REG_TABLE[t])) {
                int j;
