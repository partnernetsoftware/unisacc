/* tools/commit-own.cx -- commit only your own files and your own lines of shared files, in a shared checkout.
 *
 *   sh ./unisacc.com tools/commit-own.cx -- -m MSG [--whole PATH...] [--keyed PATH KEY[,KEY...]]...
 *
 * --whole PATH: the working-tree file as it is.  --keyed PATH KEYS: only the lines of PATH you changed, i.e.
 * the changed lines that contain one of the comma-separated KEYs (tools/own-diff.cx --emit); lines other agents
 * appended or removed in the working tree stay out of the commit and stay in the working tree.  --keyed given
 * several times for one PATH is one entry with the union of the keys (each once); a KEY that no line of PATH
 * (work tree or HEAD) carries as a whole TAB field refuses with exit 2 (COMMIT_OWN_MISSING_KEY<TAB>path=<TAB>key=).
 * The commit is built in a private index (out/commit-own-PID.idx: read-tree HEAD, the blobs above), so other
 * agents' staged entries in the shared index are neither committed nor dropped.  Afterwards each committed
 * path's entry in the shared index is moved to the committed blob, whatever was staged there: the request owns
 * its paths.  A staged version that was never committed (not the old HEAD blob, not a blob of the path's last 50
 * commits) is named in a NOTE with its blob id before it is replaced; paths outside the request keep their staged
 * entries.  An entry that cannot be moved after 12 tries prints COMMIT_OWN_INDEX_UNSYNCED<TAB>path=..<TAB>run: CMD
 * and COMMIT_OWN_FAIL<TAB>class=index-unsynced on stderr, exit 1 (the commit has landed).  An entry that already is the new blob
 * 收尾: 绝不 git read-tree HEAD 覆盖默认索引。只对刚提交路径补 cacheinfo。
 * 然后 git diff --cached --name-only: 空则 CACHED_QUIET; 含非本批路径则 NOTE 保留(负控:不吞别人暂存)。
 * --registered ID...: the registration set of each batch ID as one unit: tests/manifests/ID.tsv whole, and in
 * tests/batches.tsv / tests/coverage.tsv the keyed lines (batch id, the manifest's
 * coverage id; whole fields). build/links.tsv and build/table-index.tsv are keyed too
 * (batch id, tool and check path and their basenames) and taken only when that yields a change.  Every selected
 * changed line prints SELECT<TAB>PATH<TAB>+|-LINE.  An added line of either registry table that is not
 * byte-for-byte a manifest row (a whole-field match on someone else's row) refuses with exit 1, nothing committed.
 * Before the commit, tools/reg-manifest.cx --check --index runs against the private index -- the same verdict the
 * precommit registration-manifest gate takes -- and any MISSING/MISMATCH line refuses with exit 1.
 * --dry-run: everything up to and including the pre-commit hook on the private index, no commit, the shared index
 * untouched; prints COMMIT_OWN_DRY<TAB>rc=N.  --help: the usage, exit 0.  A --whole/--keyed of a table that
 * --registered owns is dropped with a NOTE (the set's keyed rows are taken).  When git reports that HEAD moved
 * under the commit and none of the commit's paths changed in the new HEAD, the private index is rebuilt there and
 * the whole pass (gates included) replayed with jitter within the original 55-second replay window; a path that did change there is named on stderr
 * (COMMIT_OWN_CONFLICT<TAB>path=..<TAB>by=..) and the class stays head-moved.  The pre-commit hook is not run by git commit:
 * the private index is checked out under TMP/commit-own-PID.root and the hook runs with that root as cwd and work
 * tree, so every gate reads the tree being committed, never the shared index or the shared work tree; the commit
 * is then write-tree, commit-tree and one git update-ref HEAD NEW OLD (see CO_GATE_SH and co_land).  Every run prints COMMIT_OWN_PHASE (select/pending/regm/commit ms, attempts); every
 * refusal prints COMMIT_OWN_FAIL<TAB>class=... on stderr one line before its reason.
 * Cost (2026-11-15, one --registered set in a fresh clone, 54.6 s before): every keyed path goes through one
 * tools/own-diff.cx --batch process; own-diff, reg-manifest and on-change run through DEVSVC_SELF_BIN run --local
 * (content-keyed native images) when devsvc launched this tool, because the product's -run cache is keyed by path and
 * is cold in every new root; the pending hint asks on-change for --derive-only.  See co_tool and co_owndiff.
 * Prints COMMIT_OWN<TAB>commit=SHORT<TAB>paths=N<TAB>foreign_kept=M<TAB>index_unsynced=U<TAB>full=SHA. Exit 0, 1 when git refuses or
 * the shared index could not be synced (U > 0: retried 12 times against index.lock), 2 on usage.
 * --derive (off by default): the derived tables the commit's paths feed are recomputed on the commit's own tree and
 * go into the same commit.  The private index is checked out under TMP/commit-own-dN.root (four flock slots, the
 * -run cache stays warm; no flock or all busy: a PID root), tools/derive.cx --write --changed PATHS runs there (only
 * the rows whose inputs_glob a path hits, see exec/facts/derive.tsv, closed over outputs that feed further rows via
 * derive --write --plan, one --write in manifest order), every file it changed is git add-ed into the private index, then derive --check --only NAME runs on that same
 * root for every row a --write wrote, all at once (read-only; one process per row, so the wall time is the
 * slowest row, not the sum: measured tool-index alone 29.5 s write+serial check before, see COMMIT_OWN_DERIVE ms).  A --write that leaves NEEDS_BUMP or a --check with DRIFT refuses (class derive-drift),
 * a generator that fails or times out refuses (class derive-failed); nothing committed.  Each derived file prints
 * DERIVED<TAB>PATH.  Generators read only the committed tree, so other agents' uncommitted rows never enter.  After
 * the commit the shared work-tree copy of a derived file gets only the recomputed lines: per line, with counts
 * O (HEAD), N (committed), W (work tree), the file keeps N + max(0, W - max(O,N)) - max(0, min(O,N) - W) copies --
 * other agents' added or removed rows stay as they were (an added row lands after its work-tree predecessor).  The
 * shared index entry moves as for any committed path.  COMMIT_OWN_DERIVE<TAB>rc=<TAB>stage=<TAB>files=<TAB>ms= is
 * printed.  UNISACC_COMMIT_OWN_DERIVE_MANIFEST=FILE passes --manifest FILE to derive.cx (tests).
 * --derive-selected (opt-in, off by default; --derive is unchanged): the same private root, but the table set comes from
 * derive.cx --touched (git diff --cached --name-status HEAD of the commit's paths, so A/D reach pathset rows; real read
 * sets plus the outputs -> inputs closure inside derive.cx), one --write --touched, and --check --only NAME for EVERY
 * selected table (not only the ones a --write wrote), so a cache-identical row is still checked. */
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use sys.io
#pragma unisa use sys.poll
#pragma unisa use mem.heap
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.bytes
#pragma unisa use sys.sha
#pragma unisa use cxlib.trailer
#pragma unisa use dv.procid

#define CO_MAX 64

/* every refusal names its class on stderr (COMMIT_OWN_FAIL<TAB>class=...) one line before the reason, so the
   devsvc event history can be classified without reading prose: args, setup, registered-foreign-row,
   reg-manifest, derive-drift, derive-failed, precommit, head-moved, index-lock, nothing-to-commit, git-or-hook,
   index-unsynced (the commit landed; the shared index entries named by COMMIT_OWN_INDEX_UNSYNCED lines did not move) */
static void co_die(const char *a, const char *b) {
    fprintf(stderr, "COMMIT_OWN_FAIL\tclass=%s\n", (tx_eqz(a, "usage") || tx_eqz(a, "no such file") || tx_eqz(a, "no registration manifest")) ? "args" : "setup");
    fprintf(stderr, "commit-own: %s%s%s\n", a, b ? ": " : "", b ? b : ""); exit(2); }
#define CO_USAGE "-m MSG [--whole PATH...] [--keyed PATH KEY[,KEY...]]... [--registered ID...] [--derive|--derive-selected] [--dry-run]"
#define CO_PHASE "COMMIT_OWN_PHASE\tselect_ms=%ld\tpending_ms=%ld\tregm_ms=%ld\tcommit_ms=%ld\tattempts=%d\n"
/* Live progress: `COMMIT_PHASE<TAB>name=N<TAB>state=begin` when a phase starts and
   `COMMIT_PHASE<TAB>name=N<TAB>state=end<TAB>ms=M` when it ends, flushed at once, so a job tail (devsvc git commit
   --status) shows the phase in flight and a timeout leaves the last begin without an end.  The precommit hook's
   gates write the same lines into this process's stdout through UNISACC_COMMIT_PHASE_LOG (/proc/PID/fd/1). */
static long co_ph_t0;
static void co_phase(const char *name, int begin) {
    if (begin) { co_ph_t0 = sy_now_ms(); sy_printf("COMMIT_PHASE\tname=%s\tstate=begin\n", name); }
    else sy_printf("COMMIT_PHASE\tname=%s\tstate=end\tms=%ld\n", name, sy_now_ms() - co_ph_t0);
    fflush(stdout);
}

/* run ARGV; its stdout (trimmed of the final newline) into OUT; the exit code or -1 */
static long g_bound_s = 30;   /* 30 s for plain git calls; the git commit call (runs the precommit hook) raises it */
static int64_t co_replay_end;
static int run(char **argv, char *out, long cap) {
    char *o = 0; size_t on = 0; long n; int code;
    int bound = (int)g_bound_s;
    out[0] = 0;
    if (co_replay_end) {
        int64_t now = sy_mono_ns();
        if (now < 0 || co_replay_end - now < 1000000000LL) return -1;
        int seconds = (int)((co_replay_end - now) / 1000000000LL);
        if (seconds < bound) bound = seconds;
    }
    code = cx_runv_timeout(argv, bound, &o, &on);
    if (code < 0) { if (o) mm_free(o); return -1; }
    n = o ? (long)on : 0;
    if (n > cap - 1) n = cap - 1;
    if (n > 0) tx_copy(out, (size_t)cap, o, n);
    while (n > 0 && (out[n - 1] == '\n' || out[n - 1] == '\r')) n--;
    out[n] = 0;
    if (o) mm_free(o);
    return code;
}

/* the argv prefix that runs TOOL (v[n..], returns the new n): through the devsvc image that launched this commit
   (DEVSVC_SELF_BIN run --local --quiet: its content-keyed native cache -- the tool's use closure and the product, by
   sha) when the launcher handed one down, else the product's own -run.  The product's run cache is keyed by path, so
   in a fresh root (a clone, a work tree, a check fixture) every `sh ./unisacc.com tool.cx` first compiles for about
   5 s (measured: own-diff 5.6 s cold, 0.11 s warm, same bytes); the native cache is keyed by content and shared by
   every root.  A build artifact only: the same source runs with the same arguments and judges for itself every time.
   UNISACC_COMMIT_OWN_RUN=1 forces -run. */
static int co_via_devsvc;
static char co_product[4400];
static char *co_product_path(void){if(!co_product[0]&&sy_realpath("unisacc.com",co_product,sizeof co_product)<0)co_die("product path",0);return co_product;}
static int co_tool(char **v, int n, const char *tool) {
    const char *sb = getenv("DEVSVC_SELF_BIN"), *force = getenv("UNISACC_COMMIT_OWN_RUN");
    co_via_devsvc = sb && sb[0] == '/' && sy_exists(sb) == 1 && !(force && force[0] == '1');
    if (co_via_devsvc) { v[n++] = (char *)sb; v[n++] = "run"; v[n++] = "--local"; v[n++] = "--quiet"; v[n++] = (char *)tool; v[n++] = "--"; }
    else { v[n++] = "sh"; v[n++] = co_product_path(); v[n++] = (char *)tool; v[n++] = "--"; }
    return n;
}
/* every keyed path of the commit through ONE own-diff process (--field --batch LIST): the emitted own-only file of
   path k is co_part[k] and its foreign count co_foreign[k].  A symlink or an absent path gets no entry (the caller
   commits the link itself, or the deletion, or refuses).  Each table used to be its own process: six for one
   registered set, and each key list was cut at 1000 bytes and 54 keys; the list file has neither limit. */
static char co_part[CO_MAX][420]; static int co_foreign[CO_MAX];
/* --keyed PATH KEYS given more than once for one PATH: one entry, its keys the union (in order, each key once).
   Each --keyed used to be its own entry; the private index took the blob of the last one, so only the last
   key's lines were committed (2026-11-16: two tool-index rows given as two --keyed, one landed). */
static char co_ukey[CO_MAX][8192];
static int co_ukey_has(const char *list, const char *s, long n) {
    const char *p = list;
    while (*p) { const char *e = p; while (*e && *e != ',') e++;
        if (e - p == n && tx_same(p, n, s, n)) return 1; p = *e ? e + 1 : e; }
    return 0;
}
static void co_ukey_add(int k, const char *keys) {
    const char *p = keys;
    while (*p) {
        const char *e = p; long have = tx_len(co_ukey[k], sizeof co_ukey[k]);
        while (*e && *e != ',') e++;
        if (e > p && !co_ukey_has(co_ukey[k], p, (long)(e - p))) {
            if (have + (long)(e - p) + 2 >= (long)sizeof co_ukey[k]) co_die("keys too long", keys);
            if (have) co_ukey[k][have++] = ',';
            tx_copy(co_ukey[k] + have, sizeof co_ukey[k] - have, p, (long)(e - p));
            co_ukey[k][have + (e - p)] = 0;
        }
        p = *e ? e + 1 : e;
    }
}
/* 1 when some line of BUF[0..n) has a whole TAB field equal to KEY[0..kn) (own-diff --field's match) */
static int co_has_field(const char *b, long n, const char *key, long kn) {
    long i = 0, st = 0;
    if (!b) return 0;
    for (; i <= n; i++) if (i == n || b[i] == '\t' || b[i] == '\n') {
        long fl = i - st; if (fl > 0 && b[st + fl - 1] == '\r') fl--;
        if (fl == kn && tx_same(b + st, kn, key, kn)) return 1;
        st = i + 1;
    }
    return 0;
}
/* a --keyed KEY that no line of PATH (work tree or HEAD) carries as a whole field: named, nothing committed */
static void co_ukey_check(const char *path, const char *keys) {
    char spec[400], *h = 0, *w = 0; size_t hn = 0, wn = 0; char *hv[] = {"git", "show", spec, 0}; const char *p = keys; int miss = 0;
    sy_stat_t st;
    if ((sy_lstat(path, &st) == 0 && st.kind == 'l') || sy_exists(path) != 1) return;
    if (cx_fmt(spec, sizeof spec, "HEAD:%s", path)) co_die("path", path);
    if (cx_runv_timeout(hv, 30, &h, &hn) != 0) { if (h) mm_free(h); h = 0; hn = 0; }
    w = (char *)cx_read(path, &wn);
    while (*p) {
        const char *e = p; while (*e && *e != ',') e++;
        if (e > p && !co_has_field(w, (long)wn, p, (long)(e - p)) && !co_has_field(h, (long)hn, p, (long)(e - p))) {
            if (!miss) fprintf(stderr, "COMMIT_OWN_FAIL\tclass=args\n");
            fprintf(stderr, "COMMIT_OWN_MISSING_KEY\tpath=%s\tkey=%.*s\n", path, (int)(e - p), p); miss++;
        }
        p = *e ? e + 1 : e;
    }
    if (w) mm_free(w);
    if (h) mm_free(h);
    if (miss) { fprintf(stderr, "commit-own: REFUSE --keyed %s: %d key(s) not found as a whole field in the file; nothing committed\n", path, miss); exit(2); }
}
static void co_owndiff(const char **path, const char **keys, int np) {
    static char lst[CO_MAX * 5200]; char lpath[420], *o = 0, *ov[12]; size_t on = 0; long ln = 0, at = 0; int k, nb = 0, rc, got = 0, n;
    for (k = 0; k < np; k++) {
        sy_stat_t st; const char *p; int w;
        co_part[k][0] = 0; co_foreign[k] = 0;
        if (!keys[k] || (sy_lstat(path[k], &st) == 0 && st.kind == 'l') || !sy_exists(path[k])) continue;
        if (tx_snprintf(co_part[k], sizeof co_part[k], "%s/commit-own-%d-%d.part", sy_tmpdir(), sy_pid(), k) >= (int)sizeof co_part[k]) co_die("path", 0);
        w = tx_snprintf(lst + ln, sizeof lst - (size_t)ln, "%s\t%s", co_part[k], path[k]);
        if (w < 0 || w >= (int)(sizeof lst - (size_t)ln)) co_die("keys too long", path[k]);
        ln += w;
        for (p = keys[k]; *p; ) {
            const char *e = p;
            while (*e && *e != ',') e++;
            if (e > p) {
                if (ln + (long)(e - p) + 3 >= (long)sizeof lst) co_die("keys too long", path[k]);
                lst[ln++] = '\t';
                while (p < e) lst[ln++] = *p++;
            }
            p = *e ? e + 1 : e;
        }
        if (ln + 2 >= (long)sizeof lst) co_die("keys too long", path[k]);
        lst[ln++] = '\n'; nb++;
    }
    if (!nb) return;
    if (tx_snprintf(lpath, sizeof lpath, "%s/commit-own-%d.batch", sy_tmpdir(), sy_pid()) >= (int)sizeof lpath || cx_write(lpath, lst, (size_t)ln)) co_die("cannot write the own-diff batch list", 0);
    n = co_tool(ov, 0, "tools/own-diff.cx"); ov[n++] = "--field"; ov[n++] = "--batch"; ov[n++] = lpath; ov[n] = 0;
    rc = cx_runv_timeout(ov, 30, &o, &on);   /* 30 s for the whole batch (it was 30 s per table) */
    sy_unlink(lpath);
    if (rc != 0 && rc != 1) { if (o) mm_free(o); co_die("own-diff failed", "tools/own-diff.cx --batch"); }
    k = 0;
    while (o && at < (long)on) {
        long e = tx_chr(o + at, (long)on - at, '\n'), l = e < 0 ? (long)on - at : e;
        if (e >= 0 && tx_prefix(o + at, l, "OWN_DIFF\town=", 13)) {
            long f = tx_find(o + at, l, "\tforeign=", 9);
            while (k < np && !co_part[k][0]) k++;
            if (k < np && f >= 0) { co_foreign[k] = (int)strtol(o + at + f + 9, 0, 10); k++; got++; }
        }
        at += l + 1;
    }
    if (o) mm_free(o);
    if (got != nb) co_die("own-diff failed", "the batch did not report every keyed path");
}

static int co_replay_wait(int64_t deadline, int attempt) {
    int64_t now = sy_mono_ns();
    if (now < 0 || deadline - now <= 1000000000LL) return 0;
    unsigned spread = 29u + (unsigned)((uint64_t)now ^ (unsigned)sy_pid() ^ (unsigned)attempt * 2654435761u) % 173u;
    if (deadline - now <= (1000LL + spread) * 1000000LL) return 0;
    sy_sleep_ms(spread);
    co_replay_end = deadline;
    return 1;
}
/* $0 = the private gate root (TMP/commit-own-PID.root).  The tree of the private index (archive/ left out: 5400
   files no gate reads) is checked out there; top-level entries git does not track (unisacc.com, out/, archive)
   are symlinked from the shared checkout (.git too: hooks that keep state under a relative .git/ path still work).  The pre-commit hook git would run (core.hooksPath honoured) then runs
   with that root as cwd and work tree; an absent hook is a pass and no root is built.  The root is removed.
   The root's path is one of eight slots, TMP/commit-own-s0..7.root, held by flock(1) on TMP/commit-own-sN.lock for
   the length of the gate run (the kernel drops the lock with the process, so a killed commit leaves no stale slot;
   the hook does not inherit the descriptor).  The product's -run cache is keyed by path: under the old
   TMP/commit-own-PID.root every gate tool compiled cold in every commit (measured 31.8 s of gates for one registered
   set); a slot path makes the second commit warm.  No flock, or all eight slots busy: the PID root as before. */
#define CO_SLOT_SYNC \
    "_co_sync(){ " \
    "_r=$1 _g=$2 _pw=$3 _m=${1%.root}.meta _si=${1%.root}.idx _nt=$(git write-tree) || return 1; " \
    "for _lk in \"$_si.lock\" \"$_si.next.lock\"; do if [ -e \"$_lk\" ]; then printf 'COMMIT_OWN_STALE_LOCK\\tpath=%s\\treason=slot-flock-held\\n' \"$_lk\" >&2; rm -f \"$_lk\"; fi; done; " \
    "_oi=$GIT_INDEX_FILE _ok=0 _ot= _og= _op=; " \
    "if [ -d \"$_r\" ] && [ -f \"$_m\" ] && [ -f \"$_si\" ]; then " \
    "{ IFS= read -r _og; IFS= read -r _op; IFS= read -r _ot; } <\"$_m\"; " \
    "if [ \"$_og\" = \"$_g\" ] && [ \"$_op\" = \"$_pw\" ] && [ -n \"$_ot\" ]; then " \
    "rm -rf \"$_r/.devsvc\"; " \
    "if GIT_DIR=\"$_g\" GIT_WORK_TREE=\"$_r\" GIT_INDEX_FILE=\"$_si\" git -C \"$_r\" clean -fdxq -e '/.git' >/dev/null 2>&1; then " \
    "_df=$(GIT_DIR=\"$_g\" GIT_WORK_TREE=\"$_r\" GIT_INDEX_FILE=\"$_si\" git -C \"$_r\" diff-files --name-only -- . ':(exclude)archive' 2>/dev/null) || _ot=; " \
    "if [ -n \"$_ot\" ] && [ -n \"$_df\" ]; then " \
    "printf '%s\\n' \"$_df\" | GIT_DIR=\"$_g\" GIT_WORK_TREE=\"$_r\" GIT_INDEX_FILE=\"$_si\" git -C \"$_r\" checkout-index -f --stdin --prefix=\"$_r/\" >/dev/null 2>&1 && " \
    "printf '%s\\n' \"$_df\" | GIT_DIR=\"$_g\" GIT_WORK_TREE=\"$_r\" GIT_INDEX_FILE=\"$_si\" git -C \"$_r\" update-index --add --stdin >/dev/null 2>&1 || _ot=; fi; " \
    "if [ -n \"$_ot\" ] && [ \"$_ot\" = \"$_nt\" ]; then _ok=1; " \
    "elif [ -n \"$_ot\" ]; then " \
    "_dt=$(git diff-tree --no-commit-id -r --raw --no-renames \"$_ot\" \"$_nt\" 2>/dev/null) || _ot=; " \
    "if [ -n \"$_ot\" ] && cp \"$_si\" \"$_si.next\" 2>/dev/null; then " \
    "_nl='\n'; _add=; _del=; _arch=; _chg=; " \
    "printf '%s\\n' \"$_dt\" >\"$_si.dt\"; " \
    "while IFS= read -r _ln; do " \
    "[ -n \"$_ln\" ] || continue; " \
    "_mt=${_ln%%\t*} _p=${_ln#*\t}; " \
    "_r1=${_mt#* } _nm=${_r1%% *} _r2=${_r1#* } _r3=${_r2#* } _ns=${_r3%% *} _st=${_r3#* }; " \
    "case \"$_p\" in " \
    "archive/*) case \"$_st\" in D) _arch=\"${_arch}0 0000000000000000000000000000000000000000\t${_p}${_nl}\" ;; *) _arch=\"${_arch}${_nm} ${_ns}\t${_p}${_nl}\" ;; esac ;; " \
    "*) _chg=\"${_chg}${_p}${_nl}\"; case \"$_st\" in D) _del=\"${_del}${_p}${_nl}\" ;; *) _add=\"${_add}${_p}${_nl}\" ;; esac ;; " \
    "esac; " \
    "done <\"$_si.dt\"; rm -f \"$_si.dt\"; " \
    "if [ -n \"$_arch\" ]; then printf '%s' \"$_arch\" | GIT_INDEX_FILE=\"$_si.next\" git update-index --index-info >/dev/null 2>&1 || _ot=; fi; " \
    "if [ -n \"$_ot\" ] && [ -n \"$_del\" ]; then printf '%s' \"$_del\" | while IFS= read -r _dp; do [ -z \"$_dp\" ] || { rm -rf \"$_r/$_dp\"; rmdir -p \"$_r/${_dp%/*}\" 2>/dev/null || true; }; done; fi; " \
    "if [ -n \"$_ot\" ] && [ -n \"$_add\" ]; then printf '%s' \"$_add\" | GIT_INDEX_FILE=\"$_oi\" git checkout-index -f --stdin --prefix=\"$_r/\" >/dev/null 2>&1 || _ot=; fi; " \
    "if [ -n \"$_ot\" ] && [ -n \"$_chg\" ]; then printf '%s' \"$_chg\" | GIT_DIR=\"$_g\" GIT_WORK_TREE=\"$_r\" GIT_INDEX_FILE=\"$_si.next\" git -C \"$_r\" update-index --add --remove --stdin >/dev/null 2>&1 || _ot=; fi; " \
    "if [ -n \"$_ot\" ] && [ \"$(GIT_INDEX_FILE=\"$_si.next\" git write-tree 2>/dev/null)\" = \"$_nt\" ]; then " \
    "mv \"$_si.next\" \"$_si\" && printf '%s\\n%s\\n%s\\n' \"$_g\" \"$_pw\" \"$_nt\" >\"$_m\" && _ok=1; " \
    "else rm -f \"$_si.next\"; fi; " \
    "fi; fi; fi; fi; fi; " \
    "if [ \"$_ok\" != 1 ]; then " \
    "rm -rf \"$_r\" \"$_m\" \"$_si\" \"$_si.next\" \"$_si.lock\" \"$_si.next.lock\" && mkdir -p \"$_r\" || return 1; " \
    "GIT_INDEX_FILE=\"$_si\" git read-tree \"$_nt\" && " \
    "GIT_INDEX_FILE=\"$_si\" git ls-files -z -- . ':(exclude)archive' | GIT_INDEX_FILE=\"$_si\" git checkout-index -f -z --stdin --prefix=\"$_r/\" && " \
    "GIT_DIR=\"$_g\" GIT_WORK_TREE=\"$_r\" GIT_INDEX_FILE=\"$_si\" git -C \"$_r\" update-index -q --refresh && " \
    "printf '%s\\n%s\\n%s\\n' \"$_g\" \"$_pw\" \"$_nt\" >\"$_m\" || { rm -rf \"$_r\" \"$_m\" \"$_si\"; return 1; }; " \
    "fi; " \
    "for _e in * .[!.]*; do [ \"$_e\" = .devsvc ] || [ -e \"$_r/$_e\" ] || [ -L \"$_r/$_e\" ] || [ ! -e \"$_e\" ] || ln -s \"$_pw/$_e\" \"$_r/$_e\"; done; " \
    "mkdir -p \"$_r/.devsvc\"; for _t in table-index tool-index links iface-hash product-map libc-decls; do [ ! -f \"$_r/build/$_t.tsv\" ] || cp -p \"$_r/build/$_t.tsv\" \"$_r/.devsvc/$_t.tsv\" 2>/dev/null || true; done; " \
    "return 0; }; "
#define CO_GATE_SH \
    "h=$(git rev-parse --git-path hooks/pre-commit) || exit 1; [ -x \"$h\" ] || exit 0; " \
    "case \"$h\" in /*) ;; *) h=\"$PWD/$h\" ;; esac; " \
    "case \"$GIT_INDEX_FILE\" in /*) ;; *) GIT_INDEX_FILE=\"$PWD/$GIT_INDEX_FILE\"; export GIT_INDEX_FILE ;; esac; " \
    "g=$(git rev-parse --absolute-git-dir) || exit 1; r=; _slot=0; _ow=; " \
    "if command -v flock >/dev/null 2>&1; then for s in 0 1 2 3 4 5 6 7; do c=\"${0%/*}/commit-own-s$s\"; " \
    "( : >>\"$c.lock\" ) 2>/dev/null || break; exec 9>>\"$c.lock\"; if flock -n 9; then r=\"$c.root\"; _slot=1; _ow=\"$c.owner\"; break; fi; done; fi; " \
    "[ -n \"$r\" ] || { exec 9>&-; r=\"$0\"; }; " \
    "if [ -n \"$_ow\" ]; then _bt=0; if [ -r /proc/stat ]; then while read -r _k _v _; do [ \"$_k\" = btime ] && { _bt=\"$_v\"; break; }; done </proc/stat; fi; printf 'pid=%s\\tbtime=%s\\tdeadline_s=%s\\n' \"$$\" \"$_bt\" \"$(($(date +%s)+180))\" >\"$_ow\"; fi; " \
    "case \"$r\" in */commit-own-*.root) ;; *) [ -z \"$_ow\" ] || rm -f \"$_ow\"; echo 'commit-own: bad private gate root'; exit 1 ;; esac; " \
    CO_SLOT_SYNC \
    "_co_sync \"$r\" \"$g\" \"$PWD\" || { [ -z \"$_ow\" ] || rm -f \"$_ow\"; rm -rf \"$r\" \"${r%.root}.meta\" \"${r%.root}.idx\" \"${r%.root}.idx.lock\"; echo 'commit-own: cannot check the private index out for the gates'; exit 1; }; " \
    "( cd \"$r\" && UNISACC_PRECOMMIT_IN_TREE=1 UNISACC_DEVMETA_DIR=\"$r/.devsvc\" GIT_DIR=\"$g\" GIT_WORK_TREE=\"$r\" \"$h\" ) 9>&- 2>&1; rc=$?; " \
    "[ -z \"$_ow\" ] || rm -f \"$_ow\"; " \
    "if [ \"$_slot\" != 1 ]; then rm -rf \"$r\" \"${r%.root}.meta\" \"${r%.root}.idx\" \"${r%.root}.idx.lock\"; else rm -rf \"$r/.devsvc\"; fi; exit $rc"
/* --derive: $0 = TMP, "$@" = the commit's paths, GIT_INDEX_FILE = the private index (absolute).  See the header.
   Last line CO_DERIVE<TAB>rc=N<TAB>stage=plan|write|add|check|ok|setup; DERIVED<TAB>PATH per derived file and
   derive.cx's own DERIVE lines before it.  The root is kept per flock slot (fd 8 not inherited); fallback PID roots are removed.  The changed
   set is closed first with derive --write --plan (no generator runs: the selected rows' outputs join the set until
   it stops growing, at most 6 rounds), then ONE --write runs in manifest order, so a row whose input another row
   writes runs after it, once (the earlier second --write reran tool-index and links: about 10 s). */
#define CO_DERIVE_SH CO_DERIVE_SETUP CO_DERIVE_CHANGED
#define CO_DERIVE_SEL_SH CO_DERIVE_SETUP CO_DERIVE_TOUCHED
/* --derive-selected: touched list with A/M/D from the private index, one plan (PLAN outputs, SELECT names), one
   --write --touched, then --check --only for every selected name (ws = sel), the rest shared with --derive. */
#define CO_DERIVE_TOUCHED \
    "git diff --cached --name-status --no-renames HEAD -- $cs >\"$o.t\" || fin 2 plan; [ -s \"$o.t\" ] || printf '%s\\n' $cs >\"$o.t\"; " \
    "sh ./unisacc.com tools/derive.cx -- --write --plan $m --touched \"$o.t\" 8>&- >\"$o.p\" || fin 2 plan; cat \"$o.p\" | grep '^SELECT'; " \
    "po=$(while IFS='\t' read -r a b c d e; do [ \"$a\" = PLAN ] && echo \"$e\"; done <\"$o.p\"); " \
    "sel=$(while IFS='\t' read -r a b c; do [ \"$a\" = SELECT ] && echo \"$b\"; done <\"$o.p\"); " \
    "bt=$(git write-tree) || fin 2 setup; " \
    "sh ./unisacc.com tools/derive.cx -- --write $m --touched \"$o.t\" 8>&- >\"$o.w1\"; w=$?; cat \"$o.w1\"; [ $w = 0 ] || fin $w write; " \
    CO_DERIVE_ADD "if [ -n \"$m\" ]; then ws=$sel; else ws=; fi; " CO_DERIVE_CHECK
#define CO_DERIVE_SETUP \
    "fin(){ [ -z \"$_ow\" ] || rm -f \"$_ow\"; [ -z \"$r\" ] || { cd /; rm -rf \"$r.out\".*; if [ \"$_slot\" != 1 ]; then rm -rf \"$r\" \"${r%.root}.meta\" \"${r%.root}.idx\" \"${r%.root}.idx.lock\"; else rm -rf \"$r/.devsvc\"; fi; }; printf 'CO_DERIVE\\trc=%s\\tstage=%s\\n' \"$1\" \"$2\"; exit \"$1\"; }; r=; _slot=0; _ow=; " \
    "case \"$GIT_INDEX_FILE\" in /*) ;; *) fin 2 setup ;; esac; " \
    "g=$(git rev-parse --absolute-git-dir) || fin 2 setup; " \
    "if command -v flock >/dev/null 2>&1; then for s in 0 1 2 3; do c=\"$0/commit-own-d$s\"; " \
    "( : >>\"$c.lock\" ) 2>/dev/null || break; exec 8>>\"$c.lock\"; if flock -n 8; then r=\"$c.root\"; _slot=1; _ow=\"$c.owner\"; break; fi; done; fi; " \
    "[ -n \"$r\" ] || { exec 8>&-; r=\"$0/commit-own-d$$.root\"; }; " \
    "if [ -n \"$_ow\" ]; then _bt=0; if [ -r /proc/stat ]; then while read -r _k _v _; do [ \"$_k\" = btime ] && { _bt=\"$_v\"; break; }; done </proc/stat; fi; printf 'pid=%s\\tbtime=%s\\tdeadline_s=%s\\n' \"$$\" \"$_bt\" \"$(($(date +%s)+180))\" >\"$_ow\"; fi; " \
    CO_SLOT_SYNC \
    "_co_sync \"$r\" \"$g\" \"$PWD\" || fin 2 setup; " \
    "[ -f \"$r/tools/derive.cx\" ] || fin 2 setup; " \
    "cd \"$r\" || fin 2 setup; GIT_DIR=\"$g\"; GIT_WORK_TREE=\"$r\"; UNISACC_DEVMETA_DIR=\"$r/.devsvc\"; export GIT_DIR GIT_WORK_TREE UNISACC_DEVMETA_DIR; " \
    "m=; [ -z \"$UNISACC_COMMIT_OWN_DERIVE_MANIFEST\" ] || m=\"--manifest $UNISACC_COMMIT_OWN_DERIVE_MANIFEST\"; " \
    "o=\"$r.out\"; rm -f \"$o\".*; " \
    "cs=$(printf '%s\\n' \"$@\" | sort -u | tr '\\n' ' '); "
#define CO_DERIVE_CHANGED \
    "for i in 1 2 3 4 5 6; do po=$(sh ./unisacc.com tools/derive.cx -- --write --plan $m --changed $cs 8>&- | while IFS='\t' read -r a b c d e; do [ \"$a\" = PLAN ] && echo \"$e\"; done) || fin 2 plan; " \
    "nc=$(printf '%s\\n' $cs $po | sort -u | tr '\\n' ' '); [ \"$nc\" = \"$cs\" ] && break; cs=$nc; done; " \
    "for p in $UNISACC_REPLAY_OUTPUTS; do ok=0; for oplan in $po; do " \
    "[ \"$p\" != \"$oplan\" ] || { ok=1; break; }; " \
    "case \"$oplan\" in */) case \"$p\" in \"$oplan\"*) ok=1; break ;; esac ;; esac; done; " \
    "[ $ok = 1 ] || { printf 'REPLAY_OUTPUT_UNPLANNED\\t%s\\n' \"$p\"; fin 2 plan; }; done; " \
    "bt=$(git write-tree) || fin 2 setup; " \
    "sh ./unisacc.com tools/derive.cx -- --write $m --changed $cs 8>&- >\"$o.w1\"; w=$?; cat \"$o.w1\"; [ $w = 0 ] || fin $w write; " \
    CO_DERIVE_ADD \
    "if [ -n \"$m\" ]; then ws=$(cat \"$o\".w* | while IFS='\t' read -r a b c d; do [ \"$a\" = DERIVE ] && [ \"$c\" = WROTE ] && echo \"$b\"; done | sort -u); else ws=; fi; " \
    CO_DERIVE_CHECK
#define CO_DERIVE_ADD \
    "n=$(git diff --name-only -- . ':(exclude)archive'); " \
    "[ -z \"$n\" ] || git add -- $n || fin 2 add; " \
    "for p in $po; do [ ! -e \"$p\" ] || git add -- \"$p\" || fin 2 add; done; " \
    "n=$(git diff --cached --name-only \"$bt\" -- . ':(exclude)archive'); "
#define CO_DERIVE_CHECK \
    "ps=; for x in $ws; do sh ./unisacc.com tools/derive.cx -- --check $m --only $x 8>&- >\"$o.c.$x\" & ps=\"$ps $!\"; done; " \
    "w=0; for p in $ps; do wait $p; c=$?; [ $c -le $w ] || w=$c; done; " \
    "for x in $ws; do grep '^DERIVE\t' \"$o.c.$x\" | grep -v '\tSKIPPED\t'; done; [ $w = 0 ] || fin $w check; " \
    "for p in $n; do printf 'DERIVED\\t%s\\n' \"$p\"; done; fin 0 ok"
static int run(char **argv, char *out, long cap);

/* Reclaim stale commit-own slot index locks (TMP/commit-own-s0..7.idx.lock, d0..3.idx.lock, *.idx.next.lock)
 * whose holder is gone, from an older host boot (btime mismatch), past deadline, or unheld on slot .lock.
 * Never removes a lock whose live holder matches current btime and is within deadline. */
static int co_slot_flock_free(const char *slot_lock) {
    char *fv[] = { "sh", "-c", "command -v flock >/dev/null 2>&1 || exit 0; exec 9>>\"$1\" && flock -n 9", "co-flock", (char *)slot_lock, 0 };
    char out[64];
    return run(fv, out, sizeof out) == 0;
}

static void co_reclaim_one_slot(const char *base) {
    char lk1[512], lk2[512], owp[512], slk[512];
    if (tx_snprintf(lk1, sizeof lk1, "%s.idx.lock", base) >= (int)sizeof lk1 ||
        tx_snprintf(lk2, sizeof lk2, "%s.idx.next.lock", base) >= (int)sizeof lk2 ||
        tx_snprintf(owp, sizeof owp, "%s.owner", base) >= (int)sizeof owp ||
        tx_snprintf(slk, sizeof slk, "%s.lock", base) >= (int)sizeof slk) return;
    int has1 = (sy_exists(lk1) == 1), has2 = (sy_exists(lk2) == 1);
    if (!has1 && !has2) return;

    const char *reason = 0;
    unsigned char *ob = 0;
    int64_t on = 0;
    if (sy_read_file(owp, &ob, &on, 512) == 0 && ob && on > 0) {
        char t[512];
        size_t cp = (size_t)on < sizeof t - 1 ? (size_t)on : sizeof t - 1;
        mm_copy(t, sizeof t, ob, cp); t[cp] = 0;
        mm_free(ob);
        int pid = 0;
        unsigned long long bt = 0ULL;
        long dl = 0;
        long p_pos = tx_find(t, (long)cp, "pid=", 4);
        if (p_pos >= 0) pid = atoi(t + p_pos + 4);
        long b_pos = tx_find(t, (long)cp, "btime=", 6);
        if (b_pos >= 0) {
            const char *s = t + b_pos + 6;
            while (*s >= '0' && *s <= '9') { bt = bt * 10ULL + (unsigned long long)(*s - '0'); s++; }
        }
        long d_pos = tx_find(t, (long)cp, "deadline_s=", 11);
        if (d_pos >= 0) dl = atol(t + d_pos + 11);

        unsigned long long cur_bt = pi_host_btime();
        long now_s = sy_wall_s();
        if (bt > 0ULL && cur_bt > 0ULL && bt != cur_bt) reason = "btime-mismatch";
        else if (dl > 0 && now_s > dl) reason = "expired";
        else if (pid > 0 && sy_signal(pid, 0) == -ESRCH) reason = "holder-dead";
        else return; /* active holder */
    } else {
        if (ob) mm_free(ob);
        if (co_slot_flock_free(slk)) reason = "no-holder";
        else return; /* active flock holder */
    }

    if (has1 && sy_unlink(lk1) == 0) fprintf(stderr, "COMMIT_OWN_STALE_LOCK\tpath=%s\treason=%s\n", lk1, reason);
    if (has2 && sy_unlink(lk2) == 0) fprintf(stderr, "COMMIT_OWN_STALE_LOCK\tpath=%s\treason=%s\n", lk2, reason);
    (void)sy_unlink(owp);
}

/* U6: return 1 if any live git process has cwd inside worktree WT (live-lock negative control). */
static int co_active_git_in_cwd(const char *wt) {
    sy_dir_t d;
    long wlen = tx_len(wt, 4096);
    int me = (int)sy_pid(), found = 0;
    if (!wlen || sy_dir_open(&d, "/proc") != 0) return 0;
    while (sy_dir_next(&d) == 1) {
        int pid = 0;
        long i;
        if (d.name_n <= 0 || d.name_n > 12) continue;
        for (i = 0; i < (long)d.name_n; i++) {
            if (d.name[i] < '0' || d.name[i] > '9') { pid = -1; break; }
            pid = pid * 10 + (d.name[i] - '0');
        }
        if (pid <= 0 || pid == me) continue;
        char cp[64], lp[64], cwd[4096], cb[64];
        if (tx_snprintf(cp, sizeof cp, "/proc/%d/comm", pid) >= (int)sizeof cp) continue;
        int cfd = sy_open(cp, O_RDONLY, 0);
        if (cfd < 0) continue;
        long cn = sy_read(cfd, cb, sizeof cb - 1);
        sy_close(cfd);
        if (cn <= 0) continue;
        while (cn > 0 && (cb[cn - 1] == '\n' || cb[cn - 1] == '\r')) cn--;
        if (!(cn == 3 && cb[0] == 'g' && cb[1] == 'i' && cb[2] == 't')) continue;
        if (tx_snprintf(lp, sizeof lp, "/proc/%d/cwd", pid) >= (int)sizeof lp) continue;
        long rn = sy_readlink(lp, cwd, (long)sizeof cwd - 1);
        if (rn <= 0) continue;
        cwd[rn] = 0;
        if (rn >= wlen && !memcmp(cwd, wt, (size_t)wlen) && (rn == wlen || cwd[wlen] == '/')) { found = 1; break; }
    }
    sy_dir_close(&d);
    return found;
}

/* U6: reclaim stale .git/index.lock when mtime > 60 s and no live git process has cwd in this worktree. */
static void co_reclaim_git_index_lock(void) {
    char gdir[4096], wt[4096], lk[4200];
    char *gv[] = {"git", "rev-parse", "--absolute-git-dir", 0};
    char *wv[] = {"git", "rev-parse", "--show-toplevel", 0};
    sy_stat_t st;
    if (run(gv, gdir, sizeof gdir) != 0 || !gdir[0]) return;
    if (run(wv, wt, sizeof wt) != 0 || !wt[0]) return;
    if (tx_snprintf(lk, sizeof lk, "%s/index.lock", gdir) >= (int)sizeof lk) return;
    if (sy_stat(lk, &st) != 0) return;
    long now_s = sy_wall_s();
    if (now_s - (long)st.mtime < 60L) return;
    if (co_active_git_in_cwd(wt)) return;
    if (sy_unlink(lk) == 0) fprintf(stderr, "COMMIT_OWN_STALE_LOCK\tpath=%s\treason=index-lock-expired\n", lk);
}

static void co_reclaim_stale_locks(const char *tdir) {
    char base[480];
    if (!tdir || !tdir[0]) return;
    for (int s = 0; s < 8; s++) {
        if (tx_snprintf(base, sizeof base, "%s/commit-own-s%d", tdir, s) < (int)sizeof base)
            co_reclaim_one_slot(base);
    }
    for (int d = 0; d < 4; d++) {
        if (tx_snprintf(base, sizeof base, "%s/commit-own-d%d", tdir, d) < (int)sizeof base)
            co_reclaim_one_slot(base);
    }
    co_reclaim_git_index_lock();
}
/* --derive, after the commit: the shared work-tree copy of PATH gets only the recomputed lines (see the header for
   the count rule).  OLDB = the HEAD blob ("" = new file), NEWB = the committed blob.  0 written or nothing to do. */
typedef struct { const char *p; long n; } CoLn;
static long co_split(const char *b, long n, CoLn *v, long cap) {
    long at = 0, k = 0;
    while (at < n && k < cap) { long e = tx_chr(b + at, n - at, '\n'), l = e < 0 ? n - at : e; v[k].p = b + at; v[k].n = l; k++; at += l + 1; }
    return k;
}
static long co_cnt(const CoLn *v, long nv, const CoLn *x) {
    long i, c = 0; for (i = 0; i < nv; i++) if (v[i].n == x->n && tx_same(v[i].p, v[i].n, x->p, x->n)) c++; return c;
}
static char *co_blob(const char *b, long *n) {
    char *v[] = {"git", "cat-file", "blob", (char *)b, 0}, *o = 0; size_t on = 0;
    *n = 0; if (!b[0]) { o = mm_alloc(1); if (o) o[0] = 0; return o; }
    if (cx_runv_timeout(v, 30, &o, &on) != 0) { if (o) mm_free(o); return 0; }
    *n = (long)on; return o;
}
static int co_merge(const char *path, const char *oldb, const char *newb) {
    long no, nn, nw, lo, ln_, lw, i, j, k, m = 0, cap; size_t wn = 0; char *ob = co_blob(oldb, &no), *nb = co_blob(newb, &nn), *wb = cx_read(path, &wn), *res;
    CoLn *O, *N, *W, *R; int rc = 1;
    if (!ob || !nb) goto out;
    if (!wb) { rc = cx_write(path, nb, (size_t)nn) ? 1 : 0; goto out; }   /* gone from the work tree: the committed copy */
    nw = (long)wn;
    cap = no + nn + nw + 3;
    O = mm_alloc(cap * (long)sizeof(CoLn) * 4); if (!O) goto out;
    N = O + cap; W = N + cap; R = W + cap;
    lo = co_split(ob, no, O, cap); ln_ = co_split(nb, nn, N, cap); lw = co_split(wb, nw, W, cap);
    /* the committed lines, less one copy per line someone removed from the work tree (min(O,N) - W > 0) */
    for (i = 0; i < ln_; i++) {
        long co = co_cnt(O, lo, &N[i]), cn = co_cnt(N, ln_, &N[i]), cw = co_cnt(W, lw, &N[i]), lo2 = co < cn ? co : cn, drop = lo2 - cw, have = co_cnt(R, m, &N[i]);
        if (drop < 0) drop = 0;
        if (have < cn - drop) R[m++] = N[i];
    }
    /* plus the work tree's extra copies (W - max(O,N) > 0), each after its work-tree predecessor */
    for (i = 0; i < lw; i++) {
        long co = co_cnt(O, lo, &W[i]), cn = co_cnt(N, ln_, &W[i]), cw = co_cnt(W, lw, &W[i]), hi = co > cn ? co : cn, have = co_cnt(R, m, &W[i]);
        long want = cn + (cw - hi > 0 ? cw - hi : 0), at = m;
        if (have >= want || cw - hi <= 0) continue;
        for (j = i - 1; j >= 0; j--) { for (k = m - 1; k >= 0; k--) if (R[k].n == W[j].n && tx_same(R[k].p, R[k].n, W[j].p, W[j].n)) break; if (k >= 0) { at = k + 1; break; } }
        if (j < 0) at = 0;
        for (k = m; k > at; k--) R[k] = R[k - 1];
        R[at] = W[i]; m++;
    }
    {   long tot = 0, w = 0; for (i = 0; i < m; i++) tot += R[i].n + 1;
        res = mm_alloc(tot + 1);
        if (res) { for (i = 0; i < m; i++) { if (R[i].n) mm_copy(res + w, tot + 1 - w, R[i].p, R[i].n); w += R[i].n; res[w++] = '\n'; }
            if (w && nn && nb[nn - 1] != '\n' && m) w--;   /* keep the committed file's missing final newline */
            rc = cx_write(path, res, (size_t)w) ? 1 : 0; mm_free(res); } }
    mm_free(O);
out:
    if (ob) mm_free(ob); if (nb) mm_free(nb); if (wb) mm_free(wb);
    return rc;
}
/* the commit itself, after the gates passed on the private tree: write-tree of the private index, commit-tree on
   BASE, then one compare-and-swap of HEAD (git update-ref HEAD NEW BASE).  No hook runs here and nothing is locked
   by us; a HEAD that moved meanwhile fails the swap with git's "cannot lock ref 'HEAD'" and the caller replays the
   whole pass (gates included) on the new HEAD or reports the conflict.  1 with the reason in OUT on failure. */
static long co_ref_ms;
static int co_ref_rc;
static int co_land(const char *msg, const char *basec, char *newfull, char *out, long cap) {
    char tree[64], btree[64], spec[64];
    char *wv[] = {"git", "write-tree", 0}, *bv[] = {"git", "rev-parse", spec, 0};
    newfull[0] = 0;
    if (tx_snprintf(spec, sizeof spec, "%s^{tree}", basec) >= (int)sizeof spec) return 1;
    if (run(wv, tree, sizeof tree) != 0 || run(bv, btree, sizeof btree) != 0 || tx_len(tree, sizeof tree) != 40) { tx_snprintf(out, (size_t)cap, "git write-tree failed on the private index"); return 1; }
    if (tx_eqz(tree, btree)) { tx_snprintf(out, (size_t)cap, "nothing to commit: the selected paths equal HEAD"); return 1; }
    {   char *cv[] = {"sh", "-c", "exec \"$@\" 2>&1", "sh", "git", "commit-tree", tree, "-p", (char *)basec, "-m", (char *)msg, 0};
        if (run(cv, out, cap) != 0 || tx_len(out, cap) != 40) return 1;
        tx_copy(newfull, 64, out, 40); newfull[40] = 0; }
    {   char *uv[] = {"sh", "-c", "exec \"$@\" 2>&1", "sh", "git", "update-ref", "-m", "commit (commit-own)", "HEAD", newfull, (char *)basec, 0};
        long begin=sy_now_ms();
        co_ref_rc=run(uv,out,cap);
        co_ref_ms=sy_now_ms()-begin;
        return co_ref_rc != 0; }
}
/* HEAD moved and PATH differs there from the base this commit was built on: name the path and the commit */
static void co_conflict(const char *path, const char *basec) {
    char range[80], by[200]; char *v[] = {"git", "log", "-1", "--format=%h %s", range, "--", (char *)path, 0};
    by[0] = 0;
    if (tx_snprintf(range, sizeof range, "%s..HEAD", basec) < (int)sizeof range) run(v, by, sizeof by);
    fprintf(stderr, "COMMIT_OWN_CONFLICT\tpath=%s\tby=%s\n", path, by[0] ? by : "unknown");
}
/* the blob of PATH at TREE ("HEAD") or in the shared index (tree 0), and its mode; "" when absent */
static void entry(const char *tree, const char *path, char *blob, char *mode) {
    char out[8192];
    blob[0] = 0; mode[0] = 0;
    if (tree) { char *v[] = {"git", "ls-tree", (char *)tree, "--", (char *)path, 0}; if (run(v, out, sizeof out) != 0) return; }
    else { char *v[] = {"git", "ls-files", "-s", "--", (char *)path, 0}; if (run(v, out, sizeof out) != 0) return; }
    /* ls-tree: "MODE blob SHA\tPATH"; ls-files -s: "MODE SHA STAGE\tPATH" */
    if (tx_len(out, sizeof out) < 50) return;
    tx_copy(mode, 8, out, 6);
    if (tree) tx_copy(blob, 41, out + 12, 40); else tx_copy(blob, 41, out + 7, 40);
}
static int co_entry_same(const char *before, const char *after, const char *path) {
    char out[160];
    char *v[] = {"git", "--literal-pathspecs", "diff", "--quiet", "--no-renames", (char *)before, (char *)after, "--", (char *)path, 0};
    return run(v, out, sizeof out) == 0;
}

static int co_build_idx(const char *idx, const char *basec, const char **path, int np, const char *link, const char *del, char blob[][64], char *out, long ocap, const char **err_why, const char **err_path) {
    int k;
    sy_setenv("GIT_INDEX_FILE", idx, 1);
    {   char *v[] = {"git", "read-tree", (char *)basec, 0};
        if (run(v, out, ocap) != 0) { *err_why = "git read-tree failed"; *err_path = 0; return -1; } }
    for (k = 0; k < np; k++) {
        char info[4400], hb[48], hm[8];
        entry(basec, path[k], hb, hm);
        if (del[k]) {
            char *v[] = {"git", "update-index", "--force-remove", "--", (char *)path[k], 0};
            if (run(v, out, ocap) != 0) { *err_why = "git update-index --force-remove failed"; *err_path = path[k]; return -1; }
            continue;
        }
        if (tx_snprintf(info, sizeof info, "%s,%s,%s", link[k] ? "120000" : (hm[0] ? hm : "100644"), blob[k], path[k]) >= (int)sizeof info) {
            *err_why = "path too long"; *err_path = path[k]; return -1;
        }
        {   char *v[] = {"git", "update-index", "--add", "--cacheinfo", info, 0};
            if (run(v, out, ocap) != 0) { *err_why = "git update-index failed"; *err_path = path[k]; return -1; } }
    }
    return 0;
}

static int co_diff_z(const char *a, const char *b, int with_status, char **out_buf, long *out_len) {
    char *v[] = {"git", "diff-tree", "--no-commit-id", "-r", "--no-renames", "-z", (char *)(with_status ? "--name-status" : "--name-only"), (char *)a, (char *)b, "--", 0};
    size_t sz = 0; char *o = 0;
    *out_buf = 0; *out_len = 0;
    if (cx_runv_timeout(v, (int)g_bound_s, &o, &sz) != 0) { if (o) mm_free(o); return -1; }
    *out_buf = o; *out_len = (long)sz;
    return 0;
}

static int co_is_path(const char *p, long l, const char *exact) {
    long el = tx_len(exact, 4096);
    return l == el && tx_same(p, l, exact, el);
}

static int co_is_dirpref_n(const char *p, long pl, const char *dir, long dl) {
    if (pl == dl && tx_same(p, pl, dir, dl)) return 1;
    return pl > dl && p[dl] == '/' && tx_prefix(p, pl, dir, dl);
}

static int co_is_dirpref(const char *p, long l, const char *dir) {
    return co_is_dirpref_n(p, l, dir, tx_len(dir, 4096));
}

static int co_has_path(const char *p, long l, const char **arr, int n) {
    int i;
    for (i = 0; i < n; i++) if (co_is_path(p, l, arr[i])) return 1;
    return 0;
}

static int co_spec_hit(const char *p, long pl, const char *s, long sl) {
    long star = -1, i;
    if (sl <= 0 || pl <= 0) return 0;
    for (i = 0; i < sl; i++) {
        if (s[i] == '[' || s[i] == '?' || s[i] == ':') return 1;
        if (s[i] == '*' && star < 0) star = i;
    }
    if (star < 0) return sl < 4096 ? co_is_dirpref_n(p, pl, s, sl) : 1;
    for (i = star + 1; i < sl; i++) if (s[i] == '*' || s[i] == '/') return 1;
    if (star == 0) {
        long extl = sl - 1;
        return extl == 0 || (pl >= extl && tx_suffix(p, pl, s + 1, extl));
    }
    if (star >= 2 && s[star - 1] == '/') {
        long extl = sl - star - 1;
        return co_is_dirpref_n(p, pl, s, star - 1) && (extl == 0 || (pl >= extl && tx_suffix(p, pl, s + star + 1, extl)));
    }
    return 1;
}

static int co_specs_hit(const char *p, long pl, const char *specs, long slen) {
    long i = 0;
    while (i < slen) {
        long st;
        while (i < slen && specs[i] == ' ') i++;
        if (i >= slen) break;
        st = i;
        while (i < slen && specs[i] != ' ') i++;
        if (co_spec_hit(p, pl, specs + st, i - st)) return 1;
    }
    return 0;
}

static int co_std_precommit_hook(void) {
    char hp[1200]; char *hv[] = {"git", "rev-parse", "--git-path", "hooks/pre-commit", 0};
    size_t hn = 0; char *hb; int ok;
    if (sy_exists("tools/precommit.cx") != 1 || sy_exists("tests/precommit-gates.tsv") != 1 || sy_exists("tools/ratchets.cx") != 1) return 0;
    if (run(hv, hp, sizeof hp) != 0 || !hp[0]) return 0;
    hb = (char *)cx_read(hp, &hn);
    if (!hb) return 0;
    ok = tx_find(hb, (long)hn, "tools/precommit.cx", 18) >= 0;
    mm_free(hb);
    return ok;
}

static int co_cas_rebase_on(void) {
    const char *e = sy_env("UNISACC_COMMIT_CAS_REBASE");
    return e && tx_eqz(e, "1");
}

/* 1 iff tests/precommit-gates.tsv is valid (all known gates present, no unknown gates), all triggered gates'
   runtime read sets (table pathspecs + generators + cx/ext/tools/cxlib + ratchets scope) are disjoint from
   basec..new_head, and all path[0..np) stayed untouched */
static int co_gates_disjoint(const char *basec, const char *new_head, const char **path, int np, const char *del, int nreg, char old[][48]) {
    static const char * const GNAMES[7] = {"manifest", "tables", "toolsreg", "runlist", "facts", "ledger", "cx"};
    size_t gtn = 0; char *gt = 0; long gat = 0;
    long sp_off[7] = {0}, sp_len[7] = {0}; int seen[7] = {0};
    unsigned trig = 0;
    int k, i;
    char *dbuf = 0; long dlen = 0, at = 0;
    if (!co_std_precommit_hook()) return 0;
    for (k = 0; k < np; k++) {
        char nb[48], nm[8];
        entry(new_head, path[k], nb, nm);
        if (!tx_eqz(nb, old[k])) return 0;
    }
    gt = (char *)cx_read("tests/precommit-gates.tsv", &gtn);
    if (!gt || gtn == 0 || gtn > (1 << 20)) { if (gt) mm_free(gt); return 0; }
    while (gat < (long)gtn) {
        long e = tx_chr(gt + gat, (long)gtn - gat, '\n'), l = e < 0 ? (long)gtn - gat : e;
        if (l > 0 && gt[gat] != '#') {
            long go = 0, gl = 0, fo = 0, fl = 0, so = 0, sl = 0; int gi = -1;
            if (tx_field(gt + gat, l, '\t', 0, &go, &gl) || tx_field(gt + gat, l, '\t', 1, &fo, &fl) ||
                tx_field(gt + gat, l, '\t', 2, &so, &sl) || gl <= 0 || fl <= 0 || sl <= 0) {
                mm_free(gt); return 0;
            }
            for (i = 0; i < 7; i++) if (co_is_path(gt + gat + go, gl, GNAMES[i])) { gi = i; break; }
            if (gi < 0 || seen[gi]) { mm_free(gt); return 0; }   /* unknown or duplicate gate: fail closed */
            seen[gi] = 1; sp_off[gi] = gat + so; sp_len[gi] = sl;
        }
        gat += l + (e >= 0);
    }
    for (i = 0; i < 7; i++) if (!seen[i]) { mm_free(gt); return 0; }
    for (k = 0; k < np; k++) {
        const char *p = path[k]; long pl = tx_len(p, 4096);
        for (i = 0; i < 7; i++) {
            if (i == 2 && !(del[k] || !old[k][0])) continue;   /* toolsreg gates A/D/R/T on tools/*.cx */
            if (co_specs_hit(p, pl, gt + sp_off[i], sp_len[i])) trig |= (1u << i);
        }
    }
    if (trig & (1u << 1)) trig |= (1u << 2);   /* precommit.cx: tables hit also runs toolsreg */
    if (nreg > 0) trig |= (1u << 0) | (1u << 1) | (1u << 2) | (1u << 3);
    if (co_diff_z(basec, new_head, 0, &dbuf, &dlen) != 0) { mm_free(gt); return 0; }
    while (at < dlen) {
        const char *d = dbuf + at; long dl = tx_len(d, dlen - at);
        if (dl <= 0) break;
        at += dl + 1;
        if (co_has_path(d, dl, path, np)) { mm_free(dbuf); mm_free(gt); return 0; }
        /* global gate infra and runtime libraries read by every .cx gate/generator */
        if (co_is_path(d, dl, "tools/precommit.cx") || co_is_path(d, dl, "tools/precommit-flow.cx") ||
            co_is_path(d, dl, "tests/precommit-gates.tsv") || co_is_path(d, dl, "tools/check-precommit-gates.cx") ||
            co_is_path(d, dl, "unisacc.com") || co_is_path(d, dl, "cxroot.tsv") ||
            co_is_path(d, dl, "build/freeze.tsv") || co_is_path(d, dl, "build/tlib-packages.tsv") ||
            co_is_dirpref(d, dl, "cx") || co_is_dirpref(d, dl, "ext") || co_is_dirpref(d, dl, "tools/cxlib")) {
            mm_free(dbuf); mm_free(gt); return 0;
        }
        for (i = 0; i < 7; i++) {
            if (!(trig & (1u << i))) continue;
            if (co_specs_hit(d, dl, gt + sp_off[i], sp_len[i])) { mm_free(dbuf); mm_free(gt); return 0; }
        }
        if ((trig & (1u << 0)) && (co_is_path(d, dl, "tools/reg-manifest.cx") ||
            co_is_path(d, dl, "tools/batch-packages-gen.cx") || co_is_dirpref(d, dl, "build/layer-api") ||
            co_is_path(d, dl, "build/batch-packages.tsv"))) { mm_free(dbuf); mm_free(gt); return 0; }
        if ((trig & (1u << 1)) && (co_is_dirpref(d, dl, "tests") || co_is_path(d, dl, "tools/tables-gen.cx") ||
            co_is_path(d, dl, "build/batch-packages.tsv"))) { mm_free(dbuf); mm_free(gt); return 0; }
        if ((trig & (1u << 2)) && (co_is_dirpref(d, dl, "tools") || co_is_dirpref(d, dl, "tests"))) {
            mm_free(dbuf); mm_free(gt); return 0;
        }
        if ((trig & (1u << 3)) && (co_is_dirpref(d, dl, "tests") || co_is_dirpref(d, dl, "tools") ||
            co_is_path(d, dl, "build/batch-packages.tsv"))) { mm_free(dbuf); mm_free(gt); return 0; }
        if ((trig & (1u << 4)) && (co_is_dirpref(d, dl, "include") || co_is_dirpref(d, dl, "exec") ||
            co_is_dirpref(d, dl, "src") || co_is_path(d, dl, "tools/facts-gen.cx") ||
            co_is_path(d, dl, "tools/pp-autoinc-gen.cx"))) { mm_free(dbuf); mm_free(gt); return 0; }
        if ((trig & (1u << 5)) && (co_is_path(d, dl, "archive/agentwork-retire-2026-11/ledger.tsv") ||
            co_is_path(d, dl, "tools/ledger-add.cx"))) { mm_free(dbuf); mm_free(gt); return 0; }
        if ((trig & (1u << 6)) && ((dl >= 3 && tx_suffix(d, dl, ".cx", 3)) ||
            (dl >= 2 && tx_suffix(d, dl, ".c", 2)) || (dl >= 2 && tx_suffix(d, dl, ".h", 2)) ||
            (dl >= 4 && tx_suffix(d, dl, ".tsv", 4)) ||
            co_is_dirpref(d, dl, "include") || co_is_dirpref(d, dl, "exec") || co_is_dirpref(d, dl, "src") ||
            co_is_dirpref(d, dl, "build") || co_is_dirpref(d, dl, "tests") || co_is_dirpref(d, dl, "tools") ||
            co_is_dirpref(d, dl, "kernel") || co_is_dirpref(d, dl, "weights") ||
            co_is_dirpref(d, dl, "apps") || co_is_dirpref(d, dl, "ujs"))) { mm_free(dbuf); mm_free(gt); return 0; }
    }
    mm_free(dbuf);
    mm_free(gt);
    return 1;
}

/* 1 iff derive rows triggered in dout have read sets & outputs disjoint from rb..basec */
static int co_derive_disjoint(const char *rb, const char *basec, const char *dout, const char **path, int np0, char dpath[][400], int nd) {
    static const char * const RNAMES[14] = {
        "batch-domains", "tables-gen", "layer-api", "iface-hash", "batch-packages-gen", "product-map", "tool-index",
        "table-index", "cx0-three-source", "st-gap", "chain-phases", "links", "libc-decls", "doc-links"
    };
    const char *mf = getenv("UNISACC_COMMIT_OWN_DERIVE_MANIFEST");
    unsigned mask = 0; long at = 0, dn = tx_len(dout, 32768);
    char *dbuf = 0; long dlen = 0, dp = 0;
    if (mf && mf[0]) return 0;
    while (at < dn) {
        long e = tx_chr(dout + at, dn - at, '\n'), l = e < 0 ? dn - at : e;
        if (tx_prefix(dout + at, l, "DERIVE\t", 7) && tx_find(dout + at, l, "\tSKIPPED\t", 9) < 0) {
            long ns = 7, ne = ns; int found = -1, i;
            while (ne < l && dout[at + ne] != '\t') ne++;
            for (i = 0; i < 14; i++) if (co_is_path(dout + at + ns, ne - ns, RNAMES[i])) { found = i; break; }
            if (found < 0) return 0;
            mask |= (1u << found);
        }
        at += l + (e >= 0);
    }
    if ((mask & (1u << 4)) || (mask & (1u << 13))) return 0;   /* batch-packages-gen (*, git) and doc-links (*, pathset) */
    if (co_diff_z(rb, basec, 1, &dbuf, &dlen) != 0) return 0;
    while (dp < dlen) {
        long sl = tx_len(dbuf + dp, dlen - dp), dl; const char *d; int j;
        if (sl <= 0) break;
        dp += sl + 1;
        if (dp >= dlen) { mm_free(dbuf); return 0; }
        d = dbuf + dp; dl = tx_len(d, dlen - dp);
        if (dl <= 0) break;
        dp += dl + 1;
        if (co_has_path(d, dl, path, np0)) { mm_free(dbuf); return 0; }
        for (j = 0; j < nd; j++) if (co_is_path(d, dl, dpath[j])) { mm_free(dbuf); return 0; }
        for (at = 0; at < dn; ) {
            long e2 = tx_chr(dout + at, dn - at, '\n'), l2 = e2 < 0 ? dn - at : e2;
            if (tx_prefix(dout + at, l2, "DERIVED\t", 8) && l2 - 8 == dl && tx_same(dout + at + 8, dl, d, dl)) {
                mm_free(dbuf); return 0;
            }
            at += l2 + (e2 >= 0);
        }
        /* global * inputs */
        if (co_is_path(d, dl, "cxroot.tsv") || co_is_path(d, dl, "tools/derive.cx") ||
            co_is_path(d, dl, "tools/cxlib/globspan.cx") || co_is_path(d, dl, "tools/derive-inputs.tsv") ||
            co_is_path(d, dl, "exec/facts/derive.tsv") || co_is_path(d, dl, "unisacc.com")) { mm_free(dbuf); return 0; }
        if (mask && (co_is_dirpref(d, dl, "cx") || co_is_dirpref(d, dl, "ext") || co_is_dirpref(d, dl, "tools/cxlib"))) { mm_free(dbuf); return 0; }
        if ((mask & (1u << 0)) && (co_is_dirpref(d, dl, "tools") || co_is_dirpref(d, dl, "tests") || co_is_dirpref(d, dl, "cx"))) { mm_free(dbuf); return 0; }
        if ((mask & (1u << 1)) && (co_is_dirpref(d, dl, "tests") || co_is_path(d, dl, "tools/tables-gen.cx"))) { mm_free(dbuf); return 0; }
        if ((mask & (1u << 2)) && (co_is_dirpref(d, dl, "cx") || co_is_dirpref(d, dl, "ext") ||
            co_is_path(d, dl, "build/tlib-packages.tsv") || co_is_dirpref(d, dl, "build/layer-api") ||
            co_is_path(d, dl, "tools/layer-api.cx"))) { mm_free(dbuf); return 0; }
        if ((mask & (1u << 3)) && (co_is_dirpref(d, dl, "build/layer-api") || co_is_path(d, dl, "build/iface-hash.tsv") ||
            co_is_path(d, dl, "tools/iface-hash.cx"))) { mm_free(dbuf); return 0; }
        if ((mask & (1u << 5)) && (co_is_dirpref(d, dl, "src") || co_is_dirpref(d, dl, "cx") ||
            co_is_dirpref(d, dl, "ext") || co_is_dirpref(d, dl, "exec") || co_is_dirpref(d, dl, "tools") ||
            co_is_dirpref(d, dl, "weights") || co_is_dirpref(d, dl, "kernel") || co_is_dirpref(d, dl, "seed") ||
            co_is_dirpref(d, dl, "iterate") || co_is_dirpref(d, dl, "build") || co_is_path(d, dl, "prd_productmap.md"))) { mm_free(dbuf); return 0; }
        if ((mask & (1u << 6)) && (co_is_dirpref(d, dl, "tools") || co_is_dirpref(d, dl, "tests") || co_is_path(d, dl, "build/tool-index.tsv"))) { mm_free(dbuf); return 0; }
        if ((mask & (1u << 7)) && (co_is_dirpref(d, dl, "tools") || co_is_dirpref(d, dl, "tests") || co_is_dirpref(d, dl, "build"))) { mm_free(dbuf); return 0; }
        if ((mask & (1u << 8)) && (co_is_path(d, dl, "cx/cx0/plan.cx") || co_is_path(d, dl, "cx/compiler/cxmod.cx") ||
            co_is_path(d, dl, "src/cxmod.c") || co_is_path(d, dl, "tools/cx0-diff.cx") ||
            co_is_path(d, dl, ".gitattributes") || co_is_path(d, dl, "build/cx0-three-source-diff.tsv"))) { mm_free(dbuf); return 0; }
        if ((mask & (1u << 9)) && (co_is_path(d, dl, "exec/facts/st-gap.tsv") || co_is_path(d, dl, "tools/st-gap-gen.cx") ||
            co_is_path(d, dl, "build/st-gap.tsv") || co_is_path(d, dl, "build/st-gap-chain.txt"))) { mm_free(dbuf); return 0; }
        if ((mask & (1u << 10)) && (co_is_path(d, dl, "build/chain-facts.tsv") || co_is_path(d, dl, "build/chain-residue.tsv") ||
            co_is_path(d, dl, "build/chain-phase-outputs.tsv") || co_is_path(d, dl, "build/chain-phases.tsv") ||
            co_is_path(d, dl, "build/chain-phase-inputs.tsv") || co_is_path(d, dl, "build/chain-phase-fallthrough.tsv") ||
            co_is_path(d, dl, "tools/chain-phases-gen.cx"))) { mm_free(dbuf); return 0; }
        if ((mask & (1u << 11)) && (co_is_path(d, dl, "exec/facts/derive.tsv") || co_is_path(d, dl, "tests/batches.tsv") ||
            co_is_path(d, dl, "tools/links-gen.cx") || co_is_path(d, dl, "build/links.tsv"))) { mm_free(dbuf); return 0; }
        if ((mask & (1u << 12)) && (co_is_dirpref(d, dl, "include") || co_is_path(d, dl, "exec/facts/libc99posix.tsv") ||
            co_is_path(d, dl, "tools/libc-decl-scan.cx") || co_is_path(d, dl, "build/libc-decls.tsv"))) { mm_free(dbuf); return 0; }
    }
    mm_free(dbuf);
    return 1;
}

static int co_apply_derive_diff(const char *ri, const char *rt) {
    char *dv[] = {"git", "diff-tree", "--no-commit-id", "-r", "--raw", "--no-renames", (char *)ri, (char *)rt, "--", 0};
    char *dt = 0; size_t dtn = 0; long at = 0; int rc = 0;
    if (cx_runv_timeout(dv, (int)g_bound_s, &dt, &dtn) != 0) { if (dt) mm_free(dt); return -1; }
    while (at < (long)dtn) {
        long e = tx_chr(dt + at, (long)dtn - at, '\n'), l = e < 0 ? (long)dtn - at : e;
        if (l > 0) {
            long tb = tx_chr(dt + at, l, '\t');
            char nmode[16], nsha[48], stc = 0, opout[2048];
            const char *m = dt + at; long sp = 0, f = 0, i = 0;
            if (tb <= 0 || tb + 1 >= l) { rc = -1; break; }
            for (i = 0; i <= tb; i++) {
                if (i == tb || m[i] == ' ') {
                    long fl = i - sp;
                    if (f == 1 && fl > 0 && fl < 15) { tx_copy(nmode, sizeof nmode, m + sp, fl); nmode[fl] = 0; }
                    else if (f == 3 && fl == 40) { tx_copy(nsha, sizeof nsha, m + sp, 40); nsha[40] = 0; }
                    else if (f == 4 && fl >= 1) stc = m[sp];
                    f++; sp = i + 1;
                }
            }
            if (f < 5 || !stc) { rc = -1; break; }
            {   long pl = l - (tb + 1); char dpath_buf[4096], info[4200];
                if (pl <= 0 || pl >= (long)sizeof dpath_buf) { rc = -1; break; }
                tx_copy(dpath_buf, sizeof dpath_buf, dt + at + tb + 1, pl); dpath_buf[pl] = 0;
                if (stc == 'D') {
                    char *uv[] = {"git", "update-index", "--force-remove", "--", dpath_buf, 0};
                    if (run(uv, opout, sizeof opout) != 0) { rc = -1; break; }
                } else {
                    if (tx_snprintf(info, sizeof info, "%s,%s,%s", nmode, nsha, dpath_buf) >= (int)sizeof info) { rc = -1; break; }
                    {   char *uv[] = {"git", "update-index", "--add", "--cacheinfo", info, 0};
                        if (run(uv, opout, sizeof opout) != 0) { rc = -1; break; } }
                }
            }
        }
        at += l + (e >= 0);
    }
    if (dt) mm_free(dt);
    return rc;
}

/* 1 when BLOB is PATH's content in one of the last 50 commits that touched it: an already-committed version left
   in the shared index (e.g. a `git add` before an earlier commit-own), not anyone's unique staged work */
static int committed_before(const char *path, const char *blob) {
    char out[8192], b[48], m[8]; long at = 0, n;
    char *v[] = {"git", "log", "-n", "50", "--format=%H", "--", (char *)path, 0};
    if (run(v, out, sizeof out) != 0) return 0;
    n = tx_len(out, sizeof out);
    while (at + 40 <= n) {
        char sha[41]; tx_copy(sha, sizeof sha, out + at, 40);
        entry(sha, path, b, m);
        if (b[0] && tx_eqz(b, blob)) return 1;
        at += 41;
    }
    return 0;
}

/* --registered: authoritative registry tables, then links and the table catalog. */
#define CO_REGT 4
static const char *CO_REG_TABLE[CO_REGT] = {"tests/batches.tsv", "tests/coverage.tsv",
                                            "build/links.tsv", "build/table-index.tsv"};
static const char *CO_REG_KIND[2] = {"batch", "coverage"};
static char co_regkeys[CO_REGT][4096];   /* comma-separated keys per table */
static char *co_regrows[2];              /* manifest rows per registry table, '\n'-joined (each row once) */
static long co_regrown[2];
static int co_reg_of[CO_MAX];            /* table index of path k, -1 when not a --registered table */
static char co_manpath[CO_MAX][300];

static void co_addkey(int t, const char *s, long n) {
    if(t<0||t>=CO_REGT)co_die("registration table index",0);
    long have = tx_len(co_regkeys[t], sizeof co_regkeys[t]);
    if (n <= 0) return;
    if (have + n + 2 >= (long)sizeof co_regkeys[t]) co_die("too many --registered keys", CO_REG_TABLE[t]);
    if (have) co_regkeys[t][have++] = ',';
    tx_copy(co_regkeys[t] + have, sizeof co_regkeys[t] - have, s, n);
    co_regkeys[t][have + n] = 0;
}
static void co_addrow(int t, const char *s, long n) {
    char *g = mm_alloc(co_regrown[t] + n + 2);
    if (!g) co_die("out of memory", 0);
    if (co_regrown[t]) tx_copy(g, co_regrown[t] + 1, co_regrows[t], co_regrown[t]);
    tx_copy(g + co_regrown[t], n + 1, s, n); g[co_regrown[t] + n] = '\n'; g[co_regrown[t] + n + 1] = 0;
    if (co_regrows[t]) mm_free(co_regrows[t]);
    co_regrows[t] = g; co_regrown[t] += n + 1;
}
/* field F (0-based) of the TAB line S[0..n) */
static long co_field(const char *s, long n, int f, long *len) {
    long i = 0, st = 0; int c = 0;
    for (;; i++) {
        if (i == n || s[i] == '\t') { if (c == f) { *len = i - st; return st; } c++; st = i + 1; if (i == n) break; }
    }
    *len = 0; return -1;
}
/* Read manifest keys for the selected tables. */
static void co_manifest(const char *id, char *mpath, long mcap) {
    size_t n = 0; char *m; long at = 0;
    if (cx_fmt(mpath, mcap, "tests/manifests/%s.tsv", id)) co_die("manifest path", id);
    m = (char *)cx_read(mpath, &n);
    if (!m) co_die("no registration manifest", mpath);
    co_addkey(0, id, tx_len(id, 256)); co_addkey(2, id, tx_len(id, 256));
    co_addkey(3, id, tx_len(id, 256));
    while (at < (long)n) {
        long e = tx_chr(m + at, (long)n - at, '\n'), ln = e < 0 ? (long)n - at : e, tab = tx_chr(m + at, ln, '\t'); int t;
        for (t = 0; t < 2 && tab > 0; t++)
            if (tab == tx_len(CO_REG_KIND[t], 16) && tx_same(m + at, tab, CO_REG_KIND[t], tab)) {
                const char *row = m + at + tab + 1; long rl = ln - tab - 1, fl, fs;
                co_addrow(t, row, rl);
                if (t == 0) {
                    if ((fs = co_field(row, rl, 10, &fl)) >= 0 && fl > 1) co_addkey(1, row + fs, fl);
                    {   int f; for (f = 3; f <= 8; f += 5) if ((fs = co_field(row, rl, f, &fl)) >= 0 && fl > 1) {
                            long b = fl; while (b > 0 && row[fs + b - 1] != '/') b--;
                            co_addkey(2, row + fs, fl); co_addkey(3, row + fs, fl);
                            if (b > 0) { co_addkey(2, row + fs + b, fl - b); co_addkey(3, row + fs + b, fl - b); }
                        } }
                }
            }
        at += ln + (e >= 0);
    }
    mm_free(m);
}
/* 1 when LINE[0..n) is one of the manifest rows of registry table T */
static int co_isrow(int t, const char *s, long n) {
    long at = 0;
    while (at < co_regrown[t]) { long e = tx_chr(co_regrows[t] + at, co_regrown[t] - at, '\n');
        if (e == n && tx_same(co_regrows[t] + at, n, s, n)) return 1; at += e + 1; }
    return 0;
}
/* list the changed lines of SRC (the emitted file) vs HEAD:PATH as SELECT lines; for a registry table (T < 2)
   an added line that is not a manifest row is counted and returned (the caller refuses the commit) */
static int co_select(const char *path, const char *src, int t, int *changed) {
    char spec[400], *h = 0; size_t hn = 0, wn = 0; char *w; char *hv[] = {"git", "show", spec, 0};
    long at, nh = 0, i, from = 0; long *hs, *hl; char *used; int bad = 0;
    *changed = 0;
    if (cx_fmt(spec, sizeof spec, "HEAD:%s", path)) co_die("path", path);
    if (cx_runv_timeout(hv, 30, &h, &hn) != 0) { if (h) mm_free(h); h = 0; hn = 0; }
    w = (char *)cx_read(src, &wn);
    if (!w) co_die("cannot read the selection", src);
    for (at = 0; at < (long)hn; ) { long e = tx_chr(h + at, (long)hn - at, '\n'); nh++; if (e < 0) break; at += e + 1; }
    hs = mm_alloc((nh + 1) * (long)sizeof(long)); hl = mm_alloc((nh + 1) * (long)sizeof(long)); used = mm_alloc(nh + 1);
    if (!hs || !hl || !used) co_die("out of memory", 0);
    for (at = 0, i = 0; at < (long)hn && i < nh; i++) { long e = tx_chr(h + at, (long)hn - at, '\n'), ln = e < 0 ? (long)hn - at : e; hs[i] = at; hl[i] = ln; used[i] = 0; at += ln + 1; }
    for (at = 0; at < (long)wn; ) {
        long e = tx_chr(w + at, (long)wn - at, '\n'), ln = e < 0 ? (long)wn - at : e, j, hit = -1;
        for (j = 0; j < nh; j++) {   /* scan from just after the last hit: unchanged lines are in order */
            long q = (from + j) % nh;
            if (!used[q] && hl[q] == ln && tx_same(h + hs[q], ln, w + at, ln)) { hit = q; break; }
        }
        if (hit >= 0) { used[hit] = 1; from = hit + 1 < nh ? hit + 1 : 0; }
        else {
            int ok = t >= 2 || co_isrow(t, w + at, ln);
            sy_printf("SELECT\t%s\t+%.*s%s\n", path, (int)ln, w + at, ok ? "" : "\t<- not a manifest row");
            (*changed)++; if (!ok) bad++;
        }
        if (e < 0) break; at += e + 1;
    }
    for (i = 0; i < nh; i++) if (!used[i]) { sy_printf("SELECT\t%s\t-%.*s\n", path, (int)hl[i], h + hs[i]); (*changed)++; }
    mm_free(hs); mm_free(hl); mm_free(used); mm_free(w); if (h) mm_free(h);
    return bad;
}

/* the pending-derived hint: tools/on-change.cx --dry-run is started before the commit and read when the commit is
   over (run in line it was 5.2 s of a 19 s commit).  Read-only; never blocks, never changes the exit code; a
   failed start or a 30 s overrun is skipped silently (the child is killed and reaped). */
static int co_pend_pid = -1, co_pend_fd = -1;
static void co_pending_collect(void) {
    static char oc[16384]; char seen[1024]; long no = 0, at = 0, r, deadline = sy_now_ms() + 30000; int ex = 0, code = 0, sig = 0;
    if (co_pend_pid < 0) return;
    for (;;) {
        sy_pollfd_t pf; long left = deadline - sy_now_ms();
        pf.fd = co_pend_fd; pf.events = SY_POLLIN; pf.revents = 0;
        if (left <= 0 || sy_poll(&pf, 1, left) <= 0) { sy_close(co_pend_fd); sy_kill(co_pend_pid); sy_wait_status(co_pend_pid, 0, &ex, &code, &sig); co_pend_pid = -1; return; }
        r = sy_read(co_pend_fd, oc + no, (long)sizeof oc - 1 - no);
        if (r <= 0) break;
        no += r;
        if (no + 1 >= (long)sizeof oc) break;
    }
    sy_close(co_pend_fd);
    sy_wait_status(co_pend_pid, 0, &ex, &code, &sig); co_pend_pid = -1;
    oc[no] = 0; seen[0] = 0;
    while (at < no) {
        long e = tx_chr(oc + at, no - at, '\n'), ln = e < 0 ? no - at : e, p = tx_find(oc + at, ln, " pending=", 9);
        if (p >= 0) {
            long s = at + p + 9, q = s;
            while (q < at + ln && oc[q] != ' ') q++;
            while (s < q) {
                long c = s, w; char item[128];
                while (c < q && oc[c] != ',') c++;
                w = c - s;
                if (w > 0 && !(w == 1 && oc[s] == '-') && w < (long)sizeof item) {
                    char key[136];
                    tx_copy(item, sizeof item, oc + s, w); item[w] = 0;
                    if (tx_snprintf(key, sizeof key, ",%s,", item) < (int)sizeof key && tx_find(seen, tx_len(seen, sizeof seen), key, tx_len(key, 136)) < 0) {
                        long sl = tx_len(seen, sizeof seen);
                        if (sl + w + 2 < (long)sizeof seen) tx_snprintf(seen + sl, sizeof seen - sl, "%s", key);
                        sy_printf("COMMIT_OWN pending-derived=%s run: sh ./unisacc.com tools/derive.cx -- --write --only %s\n", item, item);
                    }
                }
                s = c + 1;
            }
        }
        at += ln + (e >= 0);
    }
}

static int co_path_in_lines(const char *buf, const char *p) {
    if (!buf || !buf[0] || !p || !p[0]) return 0;
    size_t pl = strlen(p);
    const char *s = buf;
    while (*s) {
        const char *nl = strchr(s, '\n');
        size_t len = nl ? (size_t)(nl - s) : strlen(s);
        while (len > 0 && s[len - 1] == '\r') len--;
        /* For `git ls-files -u`, path follows the TAB character; for `git diff --name-only`, full line is path. */
        const char *tb = (const char *)memchr(s, '\t', len);
        const char *entry = tb ? tb + 1 : s;
        size_t elen = tb ? len - (size_t)(tb - s) - 1 : len;
        if (elen == pl && memcmp(entry, p, pl) == 0) return 1;
        s = nl ? nl + 1 : s + strlen(s);
    }
    return 0;
}

/* A merge in progress (MERGE_HEAD present):
 * - Without --merge-continue: compute the merge touch set (git diff --name-only HEAD MERGE_HEAD plus
 *   unmerged entries from git ls-files -u). When all requested paths are disjoint from the touch set,
 *   allow the path commit to proceed via private index + CAS update-ref + cacheinfo sync (preserving MERGE_HEAD).
 *   When any requested path intersects the touch set (or np == 0 / git fails), refuse by name
 *   (COMMIT_MERGE_IN_PROGRESS, exit 2, nothing committed).
 * - With --merge-continue: require MERGE_HEAD and no unmerged entry, take no paths, run plain git commit
 *   (two parents: HEAD and MERGE_HEAD) and verify both parents afterwards. */
static int co_mergecont(int mcont, const char *msg, int np, const char **paths, int dry) {
    char mp[4400], mh[64], out[8192], par[200];
    char *pv[] = {"git", "rev-parse", "--git-path", "MERGE_HEAD", 0}, *hv[] = {"git", "rev-parse", "-q", "--verify", "MERGE_HEAD", 0};
    if (run(pv, mp, sizeof mp) != 0 || !mp[0]) { if (!mcont) return -1; co_die("setup", "git rev-parse --git-path MERGE_HEAD failed"); }
    if (sy_exists(mp) != 1) {
        if (!mcont) return -1;
        fprintf(stderr, "COMMIT_OWN_FAIL\tclass=args\ncommit-own: COMMIT_MERGE_NONE: --merge-continue needs a merge in progress (no MERGE_HEAD; nothing committed)\n"); return 2; }
    if (!mcont) {
        if (np <= 0 || !paths) {
            fprintf(stderr, "COMMIT_OWN_FAIL\tclass=args\ncommit-own: COMMIT_MERGE_IN_PROGRESS: MERGE_HEAD is present and no paths given (nothing committed)\n"); return 2;
        }
        char *dv[] = {"git", "diff", "--name-only", "HEAD", "MERGE_HEAD", 0};
        char *uv[] = {"git", "ls-files", "-u", 0};
        char *dbuf = (char *)mm_alloc(262144), *ubuf = (char *)mm_alloc(262144);
        int rc1 = dbuf ? run(dv, dbuf, 262144) : -1;
        int rc2 = ubuf ? run(uv, ubuf, 262144) : -1;
        if (rc1 != 0 || rc2 != 0) {
            if (dbuf) mm_free(dbuf);
            if (ubuf) mm_free(ubuf);
            fprintf(stderr, "COMMIT_OWN_FAIL\tclass=args\ncommit-own: COMMIT_MERGE_IN_PROGRESS: MERGE_HEAD is present and touch set unreadable (nothing committed)\n");
            return 2;
        }
        for (int i = 0; i < np; i++) {
            if (co_path_in_lines(dbuf, paths[i]) || co_path_in_lines(ubuf, paths[i])) {
                fprintf(stderr, "COMMIT_OWN_FAIL\tclass=args\ncommit-own: COMMIT_MERGE_IN_PROGRESS: path=%s intersects MERGE_HEAD touch set. Resolve, stage, then: devsvc git commit -m MSG --merge-continue (nothing committed)\n", paths[i]);
                mm_free(dbuf); mm_free(ubuf);
                return 2;
            }
        }
        mm_free(dbuf); mm_free(ubuf);
        sy_printf("COMMIT_MERGE_DISJOINT\tpaths=%d\tallowed=1\n", np);
        return -1;
    }
    if (np) { fprintf(stderr, "COMMIT_OWN_FAIL\tclass=args\ncommit-own: COMMIT_MERGE_PATHS: --merge-continue commits the whole staged merge result and takes no --whole/--keyed/--registered (nothing committed)\n"); return 2; }
    {   char *uv[] = {"git", "ls-files", "-u", 0};
        if (run(uv, out, sizeof out) != 0) co_die("setup", "git ls-files -u failed");
        if (out[0]) { fprintf(stderr, "COMMIT_OWN_FAIL\tclass=args\ncommit-own: COMMIT_MERGE_UNRESOLVED: unmerged entries remain (git ls-files -u not empty; nothing committed)\n"); return 2; } }
    if (run(hv, mh, sizeof mh) != 0 || tx_len(mh, sizeof mh) < 40) co_die("setup", "git rev-parse MERGE_HEAD failed");
    mh[40] = 0;
    if (dry) { sy_printf("COMMIT_OWN_DRY\trc=0\tmerge_head=%s\n", mh); return 0; }
    g_bound_s = 55;
    {   char *cv[] = {"sh", "-c", "exec \"$@\" 2>&1", "sh", "git", "commit", "-q", "-m", (char *)msg, 0};
        if (run(cv, out, sizeof out) != 0) { fprintf(stderr, "COMMIT_OWN_FAIL\tclass=git-or-hook\ncommit-own: git commit (merge) failed: %s\n", out); return 1; } }
    g_bound_s = 30;
    {   char *rv[] = {"git", "rev-list", "--parents", "-n", "1", "HEAD", 0};
        if (run(rv, par, sizeof par) != 0 || tx_len(par, sizeof par) < 122 || !tx_eqz(par + 82, mh)) {
            fprintf(stderr, "COMMIT_OWN_FAIL\tclass=git-or-hook\ncommit-own: COMMIT_MERGE_PARENTS: HEAD parents are not (old HEAD, %s): %s\n", mh, par); return 1; } }
    if (sy_exists(mp) == 1) { fprintf(stderr, "COMMIT_OWN_FAIL\tclass=git-or-hook\ncommit-own: COMMIT_MERGE_STATE: MERGE_HEAD still present after the commit\n"); return 1; }
    sy_printf("COMMIT_MERGE\tcommit=%.40s\tparents=2\tsecond=%s\n", par, mh);
    return 0;
}
/* Used by devsvc push against a detached private Git directory. Read the
   proposed tree from its index and leave all refs and work trees alone. */
static int co_replay_index(int argc, char **argv) {
    char head[64], ref[64], gate_root[420], tree[64], out[32768];
    const char *idx = getenv("GIT_INDEX_FILE");
    char *hv[] = {"git", "rev-parse", "HEAD", 0};
    char *sym[] = {"git", "symbolic-ref", "-q", "HEAD", 0};
    if (argc < 6 || argc > CO_MAX + 5 || !idx || idx[0] != '/' ||
        run(sym, ref, sizeof ref) != 1 || run(hv, head, sizeof head) || !tx_eqz(head, argv[2])) {
        fprintf(stderr, "COMMIT_REPLAY_REFUSE\treason=private-base-required\n");
        return 2;
    }
    char *dv[CO_MAX + 6] = {"sh", "-c", CO_DERIVE_SH, (char *)sy_tmpdir()};
    char outputs[16384] = "";
    int n = 4, sep = 4, used = 0;
    for (; sep < argc && !tx_eqz(argv[sep],"--outputs"); sep++) dv[n++] = argv[sep];
    if (sep < 5 || sep == argc) return 2;
    for (int k=sep+1;k<argc;k++) {
        int len=snprintf(outputs+used,sizeof outputs-used,"%s\n",argv[k]);
        if(len<0||(size_t)len>=sizeof outputs-(size_t)used)return 2;
        used+=len;
    }
    if(sy_setenv("UNISACC_REPLAY_OUTPUTS",outputs,1))return 2;
    dv[n] = 0;
    g_bound_s = 55;
    int rc = run(dv, out, sizeof out);
    sy_unsetenv("UNISACC_REPLAY_OUTPUTS");
    if (out[0]) puts(out);
    if (rc) {
        fprintf(stderr, "COMMIT_REPLAY_REFUSE\treason=derive-failed\trc=%d\n", rc);
        return 1;
    }
    if (cx_fmt(gate_root, sizeof gate_root, "%s/commit-own-%d.root", sy_tmpdir(), sy_pid())) return 2;
    char *gv[] = {"sh", "-c", CO_GATE_SH, gate_root, 0};
    rc = run(gv, out, sizeof out);
    if (out[0]) puts(out);
    if (rc) {
        fprintf(stderr, "COMMIT_REPLAY_REFUSE\treason=precommit\trc=%d\n", rc);
        return 1;
    }
    char *wv[] = {"git", "write-tree", 0};
    if (run(wv, tree, sizeof tree) || strlen(tree) != 40) return 2;
    char base_tree[64];
    char *bv[] = {"git", "rev-parse", "HEAD^{tree}", 0};
    if (run(bv, base_tree, sizeof base_tree) || strlen(base_tree) != 40) return 2;
    if (tx_eqz(tree, base_tree)) {
        printf("COMMIT_REPLAY_IDENTICAL\tbase=%s\n", head);
        printf("COMMIT_REPLAY\tfull=%s\tbase=%s\n", head, head);
        return 0;
    }
    char *cv[] = {"git", "commit-tree", tree, "-p", head, "-m", argv[3], 0};
    if (run(cv, out, sizeof out) || strlen(out) != 40) return 2;
    printf("COMMIT_REPLAY\tfull=%s\tbase=%s\n", out, head);
    return 0;
}
int main(int argc, char **argv) {
    if (argc > 1 && tx_eqz(argv[1], "--replay-index")) return co_replay_index(argc, argv);
    int64_t replay_deadline = sy_mono_ns();
    if (replay_deadline >= 0) replay_deadline += 55000000000LL;
    const char *msg = 0, *path[CO_MAX], *keys[CO_MAX]; int np = 0, k, a = 1, kept = 0, lost = 0, nreg = 0, refused = 0, mcont = 0;
    int dry = 0, att = 0, derive = 0, derive_sel = 0, np0 = 0, nder = 0; long t_der = 0;
    const char *prepare = 0, *receipt = 0, *receipt_id = 0;
    static char dpath[CO_MAX][400];   /* --derive: the derived files appended after the commit's own paths */ long t0 = sy_now_ms(), t_sel = 0, t_pend = 0, t_regm = 0, t_commit = 0, tc0; const char *fcls = "git-or-hook";
    char gatef[400] = "", idx[400], blob[CO_MAX][64], out[8192], root[4096];
    char link[CO_MAX];   /* 1 when --whole PATH is a symlink: commit 120000, blob = the target string */
    char skip[CO_MAX];   /* 1 when a --registered derived table yields no change: left out of the commit */
    char del[CO_MAX];    /* 1 when --whole PATH is in HEAD but gone from the work tree (git rm): commit the deletion */
    for (k = 0; k < CO_MAX; k++) { co_reg_of[k] = -1; skip[k] = 0; del[k] = 0; }
    while (a < argc) {
        if (tx_eqz(argv[a], "--help") || tx_eqz(argv[a], "-h")) { sy_printf("commit-own: usage: " CO_USAGE "\n"); return 0; }
        else if (tx_eqz(argv[a], "--derive")) { derive = 1; a++; }
        else if (tx_eqz(argv[a], "--derive-selected")) { derive = 1; derive_sel = 1; a++; }
        else if (tx_eqz(argv[a], "--derive-prepare") && a + 1 < argc) { prepare = argv[a + 1]; derive = 1; a += 2; }
        else if (tx_eqz(argv[a], "--derive-receipt") && a + 1 < argc) { receipt = argv[a + 1]; derive = 1; a += 2; }
        else if (tx_eqz(argv[a], "--derive-id") && a + 1 < argc) { receipt_id = argv[a + 1]; a += 2; }
        else if (tx_eqz(argv[a], "--merge-continue")) { mcont = 1; a++; }   /* see co_mergecont */
        else if (tx_eqz(argv[a], "--dry-run")) { dry = 1; a++; }   /* everything up to and including the pre-commit hook, on the private index; no commit */
        else if (tx_eqz(argv[a], "-m") && a + 1 < argc) {   /* attribution lines are dropped (tools/cxlib/trailer.cx, owner 2026-11-20) */
            const char *s; msg = argv[a + 1];
            if (tr_strip(argv[a + 1])) { for (s = msg; *s == ' ' || *s == '\t' || *s == '\r' || *s == '\n'; s++) ; if (!*s) co_die("usage", "empty message after dropping attribution lines"); }
            a += 2; }
        else if (tx_eqz(argv[a], "--registered")) {
            a++;
            while (a < argc && argv[a][0] != '-') {
                if (np == CO_MAX) co_die("too many paths", 0);
                co_manifest(argv[a], co_manpath[np], sizeof co_manpath[np]);
                path[np] = co_manpath[np]; keys[np] = 0; np++; nreg++; a++;
            }
        }
        else if (tx_eqz(argv[a], "--whole")) {
            a++;
            while (a < argc && argv[a][0] != '-') { if (np == CO_MAX) co_die("too many paths", 0); path[np] = argv[a]; keys[np] = 0; np++; a++; }
        } else if (tx_eqz(argv[a], "--keyed") && a + 2 < argc) {
            int j;   /* at parse time only a --keyed entry has keys: merge a repeated PATH into its first entry */
            for (j = 0; j < np; j++) if (keys[j] && tx_eqz(path[j], argv[a + 1])) break;
            if (j == np) {
                if (np == CO_MAX) co_die("too many paths", 0);
                co_ukey[np][0] = 0; path[np] = argv[a + 1]; keys[np] = co_ukey[np]; np++;
            }
            co_ukey_add(j, argv[a + 2]);
            if (!co_ukey[j][0]) co_die("usage", "--keyed PATH needs at least one non-empty KEY");
            a += 3;
        } else if (tx_eqz(argv[a], "--keyed")) co_die("usage", "--keyed requires TABLE and comma-separated KEYS");
        else if (tx_eqz(argv[a], "-m")) co_die("usage", "-m requires a commit message");
        else co_die("usage", CO_USAGE);
    }
    if (nreg) {
        int t;
        for (t = 0; t < CO_REGT; t++) {
            if (!co_regkeys[t][0] || sy_exists(CO_REG_TABLE[t]) != 1) continue;
            /* a --whole/--keyed of a table this set owns is dropped, not refused (5 of the 20 failed devsvc commits
               were this refusal): the set's keyed rows are the narrower selection, other rows stay in the work tree */
            for (k = 0; k < np; k++) if (tx_eqz(path[k], CO_REG_TABLE[t])) {
                int j;
                sy_printf("NOTE\t%s\t--registered owns this table; its --keyed/--whole is dropped (only the registered set's rows are taken)\n", path[k]);
                for (j = k; j + 1 < np; j++) { path[j] = path[j + 1]; keys[j] = keys[j + 1]; co_reg_of[j] = co_reg_of[j + 1]; }
                np--; co_reg_of[np] = -1; k--;
            }
            if (np == CO_MAX) co_die("too many paths", 0);
            path[np] = CO_REG_TABLE[t]; keys[np] = co_regkeys[t]; co_reg_of[np] = t; np++;
        }
    }
