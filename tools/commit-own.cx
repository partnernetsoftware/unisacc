                if (cas_skipped)
                    sy_printf("COMMIT_TIMING\tgates_ms=%ld\tgates=skipped-by-disjoint-readset\tbase=%s\tcas_ms=%ld\tcas_rc=%d\n",
                        gate_ms, orig_basec, co_ref_ms, co_ref_rc);
                else
                    sy_printf("COMMIT_TIMING\tgates_ms=%ld\tgates_rc=%d\tcas_ms=%ld\tcas_rc=%d\n",
                        gate_ms, gate_rc, co_ref_ms, co_ref_rc);
            }
            t_commit += sy_now_ms() - tc0;
            co_phase("gates", 0);
            sy_unsetenv("UNISACC_COMMIT_PHASE_LOG");
            g_bound_s = 30; }
        sy_unsetenv("GIT_INDEX_FILE");
        sy_unlink(idx);
        co_replay_end = 0;
        if (gatef[0]) { sy_unsetenv("UNISACC_GATE_REUSE"); sy_unlink(gatef); gatef[0] = 0; }
        {   long on = tx_len(out, sizeof out);
            if (dry) fcls = tx_find(out, on, "precommit", 9) >= 0 ? "precommit" : "git-or-hook";
            else if (tx_find(out, on, "cannot lock ref 'HEAD'", 22) >= 0) fcls = "head-moved";
            else if (tx_find(out, on, "index.lock", 10) >= 0) fcls = "index-lock";
            else if (tx_find(out, on, "nothing to commit", 17) >= 0 || tx_find(out, on, "nothing added to commit", 23) >= 0) fcls = "nothing-to-commit";
            else if (tx_find(out, on, "precommit", 9) >= 0 || tx_find(out, on, "PRECOMMIT", 9) >= 0) fcls = "precommit";
            else fcls = "git-or-hook"; }
        if (dry) {
            co_pending_collect();
            if (out[0]) fprintf(stderr, "%s\n", out);
            if (rc != 0) fprintf(stderr, "COMMIT_OWN_FAIL\tclass=%s\n", fcls);
            sy_printf(CO_PHASE, t_sel, t_pend, t_regm, t_commit, att + 1);
            sy_printf("COMMIT_OWN_DRY\trc=%d\tpaths=%d\tforeign_kept=%d\tnothing committed, the shared index is untouched\n", rc, np, kept);
            return rc ? 1 : 0;
        }
        if (rc != 0 && tx_eqz(fcls, "head-moved")) {
            char *rev[] = {"git", "rev-parse", "HEAD", 0};
            if(replay_deadline>0)co_replay_end=replay_deadline;
            int captured = !run(rev, retry_base, sizeof retry_base) && tx_len(retry_base, sizeof retry_base) == 40;
            int same = 1;
            for (k = 0; captured && k < np0; k++) {
                if (!co_entry_same(basec, retry_base, path[k])) { same = 0; co_conflict(path[k], basec); }
            }
            if (captured && same && co_replay_wait(replay_deadline, att)) {
                att++;
                sy_printf("COMMIT_OWN_REPLAY\tattempt=%d\tstate=HEAD moved\n", att);
                goto again;
            }
            co_replay_end=0;
            if (!captured || same) fcls = "replay-deadline";
        }
        if (rc != 0) {   /* last line: the first non-empty line of git's merged output is the reason */
            char *s = out, *e; while (*s == '\n' || *s == ' ') s++;
            co_pending_collect();
            fprintf(stderr, "COMMIT_OWN_FAIL\tclass=%s\n", fcls);
            fprintf(stderr, CO_PHASE, t_sel, t_pend, t_regm, t_commit, att + 1);
            e = strchr(s, '\n');
            if (e && e[1]) fprintf(stderr, "%s\n", out);
            if (e) *e = 0;
            fprintf(stderr, "commit-own: git commit refused (rc %d): %s\n", rc, *s ? s : "(git printed nothing)");
            return 1; }
        {   char *v[] = {"git", "rev-parse", "--short=10", newfull, 0}; if (run(v, newc, sizeof newc) != 0) newc[0] = 0; }
        for (k = np0; k < np; k++)   /* --derive: the shared work-tree copies get only the recomputed lines */
            if (co_merge(path[k], old[k], blob[k])) { sy_printf("NOTE\t%s\tthe work-tree copy could not be merged with the derived lines; run: sh ./unisacc.com tools/derive.cx -- --write --changed %s\n", path[k], path[k]); }
        for (k = 0; k < np0; k++) {   /* a commit path that derive also rewrote (blob differs from the work tree) */
            int j; for (j = 0; j < nder; j++) if (tx_eqz(path[k], dpath[j])) { char ob[48], om[8]; entry(basec, path[k], ob, om); co_merge(path[k], ob, blob[k]); }
        }
        co_reclaim_git_index_lock();
        for (k = 0; k < np; k++) {   /* the shared index: move the entry only where nobody had staged the path */
            char ib[48], im[8], info[200];
            entry(0, path[k], ib, im);
            /* The request owns its paths: after the commit the shared entry IS the committed state, whatever was
               staged there.  A staged version that was never committed (not the old HEAD blob, not one of the
               path's last 50 commits) used to be "left as it is": git status then showed MM with the work tree
               equal to HEAD, derive --check reported drift and the next --derive commit was refused, until someone
               ran git add by hand (2026-11-16, three times in one day).  The dropped blob id is printed, the object
               stays in the store.  Paths outside the request are never touched (cached-foreign below). */
            if (del[k]) {
                if (ib[0]) {
                    int tries, good = 0;
                    for (tries = 0; tries < 12 && !good; tries++) {
                        char *v[] = {"git", "update-index", "--force-remove", "--", (char *)path[k], 0}; char nb[48], nm[8];
                        if (tries) sy_sleep_ms(150 + 100 * tries);
                        run(v, out, sizeof out);
                        entry(0, path[k], nb, nm);
                        good = !nb[0];
                    }
                    if (!good) { lost++; fprintf(stderr, "COMMIT_OWN_INDEX_UNSYNCED\tpath=%s\twant=absent\thave=%s\trun: sh ./unisacc.com tools/devsvc.cx -- git add %s\n", path[k], ib, path[k]); }
                    else if (!tx_eqz(ib, old[k])) sy_printf("NOTE\t%s\tthe shared index held a staged version that was never committed (blob %s); the commit deletes the path, the entry is removed; the old content: git cat-file -p %s\n", path[k], ib, ib);
                }
                continue;
            }
            if (ib[0] && tx_eqz(ib, blob[k])) continue;   /* already the committed blob */
            {   int uniq = ib[0] && !tx_eqz(ib, old[k]) && !committed_before(path[k], ib);
                if (tx_snprintf(info, sizeof info, "%s,%s,%s", link[k] ? "120000" : (im[0] ? im : "100644"), blob[k], path[k]) >= (int)sizeof info) {
                    lost++; fprintf(stderr, "COMMIT_OWN_INDEX_UNSYNCED\tpath=%s\twant=%s\thave=%s\trun: sh ./unisacc.com tools/devsvc.cx -- git add %s\n", path[k], blob[k], ib[0] ? ib : "absent", path[k]);
                    continue; }
                /* git update-index fails when another git process holds .git/index.lock (an agent's git status
                   refreshes the index): retry, then check the entry really is the committed blob.  Ignoring the
                   failure left new files staged as deletions (penoff, macbyt: the last paths of a batch). */
                {   int tries, good = 0;
                    for (tries = 0; tries < 12 && !good; tries++) {
                        char *v[] = {"git", "update-index", "--add", "--cacheinfo", info, 0}; char nb[48], nm[8];
                        if (tries) sy_sleep_ms(150 + 100 * tries);
                        run(v, out, sizeof out);
                        entry(0, path[k], nb, nm);
                        good = nb[0] && tx_eqz(nb, blob[k]);
                    }
                    if (!good) { lost++; fprintf(stderr, "COMMIT_OWN_INDEX_UNSYNCED\tpath=%s\twant=%s\thave=%s\tafter 12 tries (index.lock?)\trun: sh ./unisacc.com tools/devsvc.cx -- git add %s\n", path[k], blob[k], ib[0] ? ib : "absent", path[k]); }
                    else if (uniq) sy_printf("NOTE\t%s\tthe shared index held a staged version that was never committed (blob %s); this commit owns the path, the entry now is the committed blob; the old content: git cat-file -p %s\n", path[k], ib, ib);
                }
            }
        }
        {   char *v[] = {"git", "diff", "--cached", "--name-only", 0};
            if (run(v, out, sizeof out) == 0) {
                if (!out[0]) sy_printf("CACHED_QUIET\n");
                else {
                    long at = 0, nout = tx_len(out, sizeof out); int alien = 0;
                    while (at < nout) {
                        long e = tx_chr(out + at, nout - at, '\n'), ln = e < 0 ? nout - at : e; int mine = 0;
                        for (k = 0; k < np; k++) if (ln == tx_len(path[k], 4000) && tx_same(out + at, ln, path[k], ln)) mine = 1;
                        if (!mine && ln > 0) { alien++; sy_printf("NOTE\tcached-foreign\t%.*s\n", (int)ln, out + at); }
                        at += ln + (e >= 0);
                    }
                    if (!alien) sy_printf("CACHED_QUIET\n");
                }
            }
        }
        co_pending_collect();
        printf(CO_PHASE, t_sel, t_pend, t_regm, t_commit, att + 1);
        if (cas_skipped) printf("COMMIT_OWN\tcommit=%s\tpaths=%d\tforeign_kept=%d\tindex_unsynced=%d\tgates=skipped-by-disjoint-readset\tbase=%s\tfull=%s\n", newc, np, kept, lost, orig_basec, newfull);
        else printf("COMMIT_OWN\tcommit=%s\tpaths=%d\tforeign_kept=%d\tindex_unsynced=%d\tfull=%s\n", newc, np, kept, lost, newfull);
        if (lost) {   /* committed, but the shared index does not show the committed state for these paths: loud, with the remedy */
            fprintf(stderr, "COMMIT_OWN_FAIL\tclass=index-unsynced\n");
            fprintf(stderr, "commit-own: commit %s LANDED, but %d shared index entr%s could not be synced (COMMIT_OWN_INDEX_UNSYNCED lines above name each path); "
                            "do not commit again -- run the git add command of each line, then git status must show nothing staged for them\n", newc, lost, lost == 1 ? "y" : "ies");
            return 1; }
    }
    return 0;
}
