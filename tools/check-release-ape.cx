/* Independent binary fixtures: repacking preserves bytes, never proves signing. */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sys.time
#pragma unisa use mem.bytes
#pragma unisa use cxlib.releaseversion
static char base[4096],exe[4400],f[10][4400],out[4400];
static int checks,bad;
static long deadline;
static void die(const char *s){fprintf(stderr,"check-release-ape: %s\n",s);exit(2);}
static void ck(int yes,const char *s){printf("%s\t%s\n",yes?"PASS":"FAIL",s);checks++;if(!yes)bad++;}
static void path(char *p,const char *n){if(cx_fmt(p,4400,"%s/%s",base,n))die("path");}
static void put(const char *p,const void *b,long n){if(cx_write(p,b,n))die("write fixture");}
static void w32(unsigned char *p,unsigned long n){for(int i=0;i<4;i++)p[i]=n>>(i*8);}
static np_result run(char **v){np_result r={0};char why[1024];long left=deadline-sy_now_ms();int sec=left/1000;if(sec>40)sec=40;if(sec<1)die("deadline");if(np_run(v,0,0,sec,&r,why,sizeof why)){fprintf(stderr,"%s\n",why);die("transport");}return r;}
/* ape-pack forces version stamping (SPEED-049-F): every win/posix slice of the unisacc product needs exactly one 32-byte slot. */
static const char SLOT[32]="UNISACC_VERSION_SLOT_0000000000";
static char rel_ver[24];
static void put_slot(const char *p,const void *b,long n,int copies){unsigned char t[2048];if(n+32*copies>(long)sizeof t)die("slot fixture size");if(mm_copy(t,sizeof t,b,n))die("copy");for(int i=0;i<copies;i++)if(mm_copy(t+n+32*i,32,SLOT,32))die("copy slot");put(p,t,n+32*copies);}
static void macho(const char *p,unsigned long cpu,int tag){unsigned char b[80]={0};w32(b,0xfeedfacfUL);w32(b+4,cpu);w32(b+8,3);w32(b+12,2);w32(b+16,1);w32(b+20,16);w32(b+32,0x1d);w32(b+36,16);w32(b+40,48);w32(b+44,32);for(int i=48;i<80;i++)b[i]=tag+i;put(p,b,sizeof b);}
/* Stamped Mach-O fixture (256 bytes): header, LC_CODE_SIGNATURE(sig=128,size=128), tag bytes, one version slot at 96, then an ad-hoc
 * superblob with one CodeDirectory page slot, the structure resign_macho requires. The hash starts zeroed; ape-pack regenerates it. */
static void macho_signed(const char *p,unsigned long cpu,int tag){unsigned char b[256]={0};w32(b,0xfeedfacfUL);w32(b+4,cpu);w32(b+8,3);w32(b+12,2);w32(b+16,1);w32(b+20,16);w32(b+32,0x1d);w32(b+36,16);w32(b+40,128);w32(b+44,128);for(int i=48;i<96;i++)b[i]=tag+i;if(mm_copy(b+96,32,SLOT,32))die("slot");
 unsigned char *s=b+128,*cd=s+20;s[0]=0xfa;s[1]=0xde;s[2]=0x0c;s[3]=0xc0;s[7]=128;s[11]=1;s[19]=20;cd[0]=0xfa;cd[1]=0xde;cd[2]=0x0c;cd[3]=0x02;cd[7]=108;cd[9]=2;cd[10]=4;cd[14]=0;cd[15]=2;cd[16]=0;cd[17]=0;cd[18]=0;cd[19]=76;cd[31]=1;cd[34]=0;cd[35]=128;cd[36]=32;cd[37]=2;cd[39]=12;put(p,b,sizeof b);}
/* Expected post-stamp bytes of macho_signed: regenerate the page hash over [0,128). */
static void macho_rehash(unsigned char *e){char hex[65];cx_sha256_hex(e,128,hex);for(int j=0;j<32;j++){int a=hex[2*j],c=hex[2*j+1];e[128+20+76+j]=(unsigned char)((a<='9'?a-'0':a-'a'+10)*16+(c<='9'?c-'0':c-'a'+10));}}
static int pack(int six,int replace,int mode){char name[64];if(cx_fmt(name,sizeof name,"pack-%d-%d-%d",six,replace,mode))die("name");path(out,name);char *v[28];int n=0;v[n++]=exe;v[n++]="pack";v[n++]="--cache-manager-osx";v[n++]=f[6];v[n++]=f[7];if(replace){v[n++]="--osx-slices";v[n++]=mode==1?f[9]:mode==2?"/definitely-missing-release-ape-slice":f[4];v[n++]=f[5];}v[n++]=out;v[n++]=f[0];v[n++]=f[1];v[n++]=f[2];v[n++]=f[3];v[n++]=f[8];v[n++]=f[9];if(six)v[n++]=f[1];/* WIN_ARM64 must be a PE; the PE fixture carries the version slot */v[n]=0;np_result r=run(v);int rc=r.rc;if(rc&&mode==0)fprintf(stderr,"%s\n%s",r.out?r.out:"",r.err?r.err:"");np_free(&r);return rc;}
static int member(const char *ape,const char *line,const char *expected,int manager){size_t an,en;char *a=cx_read(ape,&an),*e=cx_read(expected,&en);if(!a||!e)die("read member");/* forced stamping rewrites the slot to the zero-padded release version; expected bytes are the input with exactly that span changed */for(size_t i=0;i+32<=en;i++)if(!memcmp(e+i,SLOT,32)){char padded[32]={0};if(cx_fmt(padded,sizeof padded,"%s",rel_ver))die("version");if(mm_copy(e+i,32,padded,32))die("stamp expected");if(en==256&&(unsigned char)e[0]==0xcf)macho_rehash((unsigned char*)e);break;}char *s=0;size_t ln=strlen(line);for(size_t i=0;i+ln<=an;i++)if(!memcmp(a+i,line,ln)){s=a+i;break;}long o,n,h,z;char key[32];if(!s||sscanf(s+ln," o=%ld n=%ld k=%16s h=%ld z=%ld",&o,&n,key,&h,&z)!=5)die("dispatcher");if(manager){o=h;n=z;}if(o<1||n<1||o-1>(long)an||n>(long)an-o+1)die("member extent");char p[4400];path(p,"member.gz");put(p,a+o-1,n);char *v[]={"gzip","-dc",p,0};np_result r=run(v);int yes=!r.rc&&r.outn==en&&!memcmp(r.out,e,en);np_free(&r);free(a);free(e);return yes;}
static void digest(const char *p,char h[65]){size_t n;char *b=cx_read(p,&n);if(!b)die("digest");cx_sha256_hex(b,n,h);free(b);}
int main(void){deadline=sy_now_ms()+52000;char pattern[]="/tmp/check-release-ape-XXXXXX";if(!mkdtemp(pattern)||!realpath(pattern,base))die("private root");path(exe,"release-ape");char *build[]={"sh","./unisacc.com","tools/release-ape.cx","-o",exe,0};np_result r=run(build);ck(r.rc==0,"compile current release packer once");if(r.rc){fprintf(stderr,"%s",r.err?r.err:"");return 1;}np_free(&r);
for(int i=0;i<10;i++){char name[30];if(cx_fmt(name,sizeof name,"input-%d",i))die("name");path(f[i],name);}
unsigned char p4[22]={'P',' ','4',' ','\n',0};if(mm_copy(p4+6,16,"UNIPKG1\n",8))die("copy footer");p4[14]=6;put(f[0],p4,sizeof p4);
unsigned char pe[1536]={0};pe[0]='M';pe[1]='Z';w32(pe+60,64);pe[64]='P';pe[65]='E';pe[68]=0x64;pe[69]=0x86;pe[70]=1;pe[84]=240;pe[88]=0x0b;pe[89]=2;w32(pe+120,4096);w32(pe+124,512);w32(pe+144,8192);w32(pe+148,1024);w32(pe+196,16);if(mm_copy(pe+328,sizeof pe-328,".text",5))die("section");w32(pe+336,16);w32(pe+340,4096);w32(pe+344,512);w32(pe+348,1024);if(mm_copy(pe+600,32,SLOT,32))die("pe slot");put(f[1],pe,sizeof pe);put_slot(f[2],"linux-one",9,1);put_slot(f[3],"linux-two",9,1);
if(rv_load("release/candidate.tsv",rel_ver))die("release version");macho_signed(f[4],0x1000007UL,41);macho_signed(f[5],0x100000cUL,42);macho(f[6],0x1000007UL,43);macho(f[7],0x100000cUL,44);macho_signed(f[8],0x1000007UL,1);macho_signed(f[9],0x100000cUL,2);
char before[10][65];for(int i=0;i<10;i++)digest(f[i],before[i]);
ck(pack(0,1,0)==0,"five-slice explicit replacement pack succeeds");char ape[4400],rec[4400];if(cx_fmt(ape,sizeof ape,"%s/unisacc-next.com",out)||cx_fmt(rec,sizeof rec,"%s/ape-receipt.txt",out))die("output path");
ck(member(ape,"Darwinx86_64)",f[4],0),"replacement x64 bytes including opaque signature suffix survive");ck(member(ape,"Darwinarm64)",f[5],0),"replacement ARM bytes including opaque signature suffix survive");ck(member(ape,"Darwinx86_64)",f[6],1)&&member(ape,"Darwinarm64)",f[7],1),"explicit managers survive without reconstruction");
size_t rn;char *receipt=cx_read(rec,&rn);ck(receipt&&strstr(receipt,"source/osx/x86_64\t")&&strstr(receipt,"replacement/osx/arm64\t")&&strstr(receipt,"EXPLICIT_INPUTS")&&strstr(receipt,"NOT_SIGNATURE_VERIFICATION"),"receipt distinguishes source replacement and trust boundary");
for(int i=4;i<8;i++){char field[100];if(cx_fmt(field,sizeof field,"sha=%s\tbytes=%d\n",before[i],i<6?256:80))die("receipt field");ck(receipt&&strstr(receipt,field),"receipt records actual member full SHA and byte count");}free(receipt);
ck(pack(1,1,0)==0,"six-slice replacement remains supported");ck(pack(0,0,0)==0,"legacy five positional inputs with explicit managers remain supported");if(cx_fmt(ape,sizeof ape,"%s/unisacc-next.com",out))die("path");ck(member(ape,"Darwinx86_64)",f[8],0)&&member(ape,"Darwinarm64)",f[9],0),"without replacement flag original Mac slices are used");
ck(pack(1,0,0)==0,"legacy six positional inputs remain supported");
for(int bad_slot=0;bad_slot<2;bad_slot++){char bs[4400],bo[4400];path(bs,bad_slot?"dup-slot":"no-slot");path(bo,bad_slot?"dup-slot-out":"no-slot-out");if(bad_slot)put_slot(bs,"linux-one",9,2);else put(bs,"linux-one",9);char *bv[]={exe,"pack","--cache-manager-osx",f[6],f[7],bo,f[0],f[1],bs,f[3],f[8],f[9],0};r=run(bv);ck(r.rc==2&&r.err&&strstr(r.err,"missing/duplicate version slot"),bad_slot?"duplicate version slot rejected by forced stamping":"missing version slot rejected by forced stamping");np_free(&r);}
char *no_manager[]={exe,"pack","--osx-slices",f[4],f[5],out,f[0],f[1],f[2],f[3],f[8],f[9],0};r=run(no_manager);ck(r.rc==2&&r.err&&strstr(r.err,"requires explicit"),"replacement cannot silently reconstruct managers");np_free(&r);
char *duplicate[]={exe,"pack","--osx-slices",f[4],f[5],"--osx-slices",f[4],f[5],0};r=run(duplicate);ck(r.rc==2&&r.err&&strstr(r.err,"duplicate"),"duplicate replacement option rejected");np_free(&r);
ck(pack(0,1,1)==2,"wrong replacement CPU rejected");ck(pack(0,1,2)==2,"missing replacement rejected");for(int i=0;i<10;i++){char h[65];digest(f[i],h);ck(!strcmp(h,before[i]),"original and replacement inputs remain unchanged");}
printf("RELEASE_APE_CHECK\tchecks=%d\tfailed=%d\tretained=%s\tclaim=BYTE_PRESERVATION_ONLY\n",checks,bad,base);return bad?1:0;}
