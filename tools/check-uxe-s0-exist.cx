#pragma unisa use chrome_dom
#pragma unisa use sys.sha
/* tools/check-uxe-s0-exist.cx -- 13 元素包围盒内外色差;规格列哈希锁.
 */

static int failed;
static void ck(int ok, const char *lab) {
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", lab);
    if (!ok) failed++;
}
int main(void) {
    char cwd[512], url[800], line[256], ids[16][32];
    char spec[4096], hex[65], want[80];
    int xmin[16], ymin[16], md[16], mstd[16], er[16], nels = 0, i, n, rc, sl = 0;

    FILE *tf, *hf;
    char *av[12];
    char *out = 0;
    size_t on = 0;
    const char *pre = "file://";
    const char *suf = "/ujs/plans/demo-v2/look-dev/water-keeps-s0-uxe.html";
    const char *p, *q;
    if (!getcwd(cwd, sizeof cwd)) return 2;
    tf = fopen("ujs/plans/demo-v2/look-dev/s0-elements.tsv", "r");
    if (!tf) { printf("S0_EXIST_NO_TSV\n"); return 2; }
    while (fgets(line, sizeof line, tf) && nels < 16) {
        char *s = line, *last = 0, *t;
        int k = 0, skip, d = 0;
        t = line;
        while (*t && *t != '\n' && *t != '\r') { if (*t == '\t') last = t; t++; }
        if (last && sl < 4000) {
            s = line;
            while (s < last && sl < 4000) spec[sl++] = *s++;
            spec[sl++] = '\n';
        }
        if (line[0] == 'i' && line[1] == 'd') continue;
        s = line;
        while (*s && *s != '\t' && k < 31) { ids[nels][k++] = *s++; }
        ids[nels][k] = 0;
        if (*s == '\t') s++;
        for (skip = 0; skip < 9; skip++) {
            while (*s && *s != '\t') s++;
            if (*s == '\t') s++;
        }
        d = atoi(s);
        md[nels] = d;
        while (*s && *s != '\t') s++;
        if (*s == '\t') s++;
        mstd[nels] = atoi(s);
        while (*s && *s != '\t') s++;
        if (*s == '\t') s++;
        er[nels] = atoi(s);
        nels++;

    }
    fclose(tf);
    hf = fopen("ujs/plans/demo-v2/look-dev/s0-spec.sha256", "r");
    if (!hf) { printf("FAIL\t规格被改,请走规格变更提交\n"); return 1; }
    if (!fgets(want, sizeof want, hf)) { fclose(hf); printf("FAIL\t规格被改,请走规格变更提交\n"); return 1; }
    fclose(hf);
    for (i = 0; want[i]; i++) if (want[i] == '\n' || want[i] == '\r') want[i] = 0;
    sy_sha256_any_hex(spec, sl, hex);
    if (strcmp(hex, want) != 0) {
        printf("FAIL\t规格被改,请走规格变更提交\n");
        printf("got=%s\nwant=%s\n", hex, want);
        return 1;
    }
    ck(1, "spec-sha");

    n = 0;
    while (pre[n]) { url[n] = pre[n]; n++; }
    for (i = 0; cwd[i] && n < 600; i++) url[n++] = cwd[i];
    for (i = 0; suf[i] && n < 780; i++) url[n++] = suf[i];
    url[n] = 0;
    av[0] = "/usr/bin/google-chrome";
    av[1] = "--headless=new";
    av[2] = "--enable-unsafe-swiftshader";
    av[3] = "--allow-file-access-from-files";
    av[4] = "--disable-web-security";
    av[5] = "--no-first-run";
    av[6] = "--user-data-dir=/tmp/uxe-s0-exist";
    av[7] = "--virtual-time-budget=20000";
    av[8] = "--dump-dom";
    av[9] = url;
    av[10] = 0;
    rc = cx_runv_timeout(av, 25, &out, &on);
    if (rc == 127) { if (out) free(out); printf("S0_EXIST_UNMEASURED\n"); return 2; }
    p = out ? strstr(out, "<pre id=\"hud\">") : 0;
    if (p) p = strchr(p, '{');
    ck(p != 0, "hud");
    for (i = 0; i < nels; i++) {
        char key[40], ks[44];
        int got = -1, gstd = -1, k2 = 0, green;
        key[k2++] = '"';
        { int j = 0; while (ids[i][j] && k2 < 36) key[k2++] = ids[i][j++]; }
        key[k2++] = '"'; key[k2++] = ':'; key[k2] = 0;
        q = p ? strstr(p, key) : 0;
        if (q) got = atoi(q + k2);
        { int j = 0; k2 = 0; ks[k2++] = '"'; while (ids[i][j] && k2 < 36) ks[k2++] = ids[i][j++]; ks[k2++] = '_'; ks[k2++] = 's'; ks[k2++] = 't'; ks[k2++] = 'd'; ks[k2++] = '"'; ks[k2++] = ':'; ks[k2] = 0; }
        q = p ? strstr(p, ks) : 0;
        if (q) gstd = atoi(q + k2);
        green = got >= md[i];
        if (mstd[i] > 0) green = green && gstd >= mstd[i];
        if (er[i] == 0) {
            ck(green, ids[i]);
        } else {
            if (green) {
                printf("FAIL\t%s\t已绿请清标记\n", ids[i]);
                failed++;
            } else {
                printf("PASS\t%s\twip-red\n", ids[i]);
            }
        }
        printf("EL\t%s\tgot=%d\tmin=%d\tstd=%d\tmin_std=%d\ter=%d\n", ids[i], got, md[i], gstd, mstd[i], er[i]);
    }

    {
        int fill = -1;
        q = p ? strstr(p, "\"fill\":") : 0;
        if (q) fill = atoi(q + 7);
        ck(fill == 1, "frame-fill");
        printf("EL\tframe-fill\tgot=%d\tmin=1\n", fill);
    }
    if (out) free(out);

    {
        char u2[820];
        int bi = -1, gotb = -1, gots = -1;
        for (i = 0; i < nels; i++) if (ids[i][0]=='b' && ids[i][1]=='o' && ids[i][2]=='w' && ids[i][3]==0) bi = i;
        n = 0; while (url[n]) { u2[n] = url[n]; n++; }
        u2[n++] = '#'; u2[n++] = 'n'; u2[n++] = 'o'; u2[n++] = 'b'; u2[n++] = 'o'; u2[n++] = 'w'; u2[n] = 0;
        av[6] = "--user-data-dir=/tmp/uxe-s0-nobow";
        av[9] = u2;
        out = 0; on = 0;
        rc = cx_runv_timeout(av, 25, &out, &on);
        p = out ? strstr(out, "<pre id=\"hud\">") : 0;
        if (p) p = strchr(p, '{');
        if (p && bi >= 0) {
            q = strstr(p, "\"bow\":"); if (q) gotb = atoi(q + 6);
            q = strstr(p, "\"sky\":"); if (q) gots = atoi(q + 6);
        }
        ck(gotb < (bi>=0?md[bi]:48), "nobow-bow-red");
        ck(gots >= 29, "nobow-sky");
        printf("EL\tnobow-bow\tgot=%d\n", gotb);
        if (out) free(out);
    }
    {

        char u2[820];
        int ci = -1, gstd = -1, gots = -1, gotc = -1;
        for (i = 0; i < nels; i++) if (ids[i][0]=='c' && ids[i][1]=='l' && ids[i][2]=='o' && ids[i][3]=='u' && ids[i][4]=='d' && ids[i][5]==0) ci = i;
        n = 0; while (url[n]) { u2[n] = url[n]; n++; }
        u2[n++] = '#'; u2[n++] = 'n'; u2[n++] = 'o'; u2[n++] = 'c'; u2[n++] = 'l'; u2[n++] = 'o'; u2[n++] = 'u'; u2[n++] = 'd'; u2[n] = 0;
        av[6] = "--user-data-dir=/tmp/uxe-s0-nocloud";
        av[9] = u2;
        out = 0; on = 0;
        rc = cx_runv_timeout(av, 25, &out, &on);
        p = out ? strstr(out, "<pre id=\"hud\">") : 0;
        if (p) p = strchr(p, '{');
        if (p && ci >= 0) {
            q = strstr(p, "\"cloud_std\":"); if (q) gstd = atoi(q + 12);
            q = strstr(p, "\"sky\":"); if (q) gots = atoi(q + 6);
            q = strstr(p, "\"cloud\":"); if (q) gotc = atoi(q + 8);
        }
        ck(gstd < (ci>=0?mstd[ci]:3), "nocloud-cloud-std");
        ck(gots >= 29, "nocloud-sky");
        printf("EL\tnocloud-cloud\tstd=%d\tdelta=%d\n", gstd, gotc);
        if (out) free(out);
    }

    printf("CHECK_UXE_S0_EXIST\tn=%d\tfailed=%d\n", nels, failed);
    return failed ? 1 : 0;


}

