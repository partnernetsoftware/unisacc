/* tools/lane-inputs-gen.cx -- generate and check build/lane-inputs.tsv.
 * Single source of truth for lane classification (union of all APE/model-package inputs):
 *   lane A (sid-list-current): exact physical paths returned by `seed/ident.c ROOT list-current` (SID).
 *   lane A (model-tree):       all remaining product-input files in tools/candidate-trigger-inputs.tsv
 *                              (src cx ext include exec weights seed kernel + iterate/kernel/typekw.tsv,
 *                              minus exclude rules and minus pure-B ext paths) that can affect APE/model bytes.
 *   lane B (ext-non-sid):      ext/ source files (.cx/.c/.h) not in SID (pure extension packages, never in APE).
 *   lane C (non-product-tree): non-product top-level trees (apps, archive, build, examples, plans, tests, tools, ujs).
 *
 * Usage:
 *   sh ./unisacc.com tools/lane-inputs-gen.cx -- --check [ROOT]
 *   sh ./unisacc.com tools/lane-inputs-gen.cx -- --write [ROOT]
 * Check: tools/check-lane-inputs-gen.cx (batch lane-key-probes)
 */
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.env
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use text.text
#pragma unisa use cxlib.netpack

static void die(const char *m) {
    fprintf(stderr, "lane-inputs-gen: REFUSE %s\n", m);
    exit(2);
}

typedef struct {
    char **v;
    int n;
    int cap;
} StrVec;

static void sv_push(StrVec *s, const char *p, size_t n) {
    if (s->n == s->cap) {
        int nc = s->cap ? s->cap * 2 : 256;
        char **nv = (char **)mm_alloc((long)nc * (long)sizeof(char *));
        if (!nv) die("oom");
        if (s->v) {
            mm_copy(nv, (long)nc * (long)sizeof(char *), s->v, (long)s->n * (long)sizeof(char *));
            mm_free(s->v);
        }
        s->v = nv;
        s->cap = nc;
    }
    char *copy = (char *)mm_alloc((long)n + 1);
    if (!copy) die("oom");
    if (n) mm_copy(copy, (long)n + 1, p, (long)n);
    copy[n] = 0;
    s->v[s->n++] = copy;
}

static void sv_free(StrVec *s) {
    for (int i = 0; i < s->n; i++) mm_free(s->v[i]);
    if (s->v) mm_free(s->v);
    s->v = 0; s->n = 0; s->cap = 0;
}

static int sv_cmp(const void *a, const void *b) {
    const char *sa = *(const char *const *)a;
    const char *sb = *(const char *const *)b;
    return strcmp(sa, sb);
}

static int sv_has_sorted(const StrVec *s, const char *key) {
    int lo = 0, hi = s->n - 1;
    while (lo <= hi) {
        int mid = lo + (hi - lo) / 2;
        int c = strcmp(s->v[mid], key);
        if (c == 0) return 1;
        if (c < 0) lo = mid + 1; else hi = mid - 1;
    }
    return 0;
}

static void sv_sort_uniq(StrVec *s) {
    if (s->n <= 1) return;
    qsort(s->v, (size_t)s->n, sizeof(char *), sv_cmp);
    int w = 1;
    for (int i = 1; i < s->n; i++) {
        if (strcmp(s->v[i], s->v[w - 1]) != 0) s->v[w++] = s->v[i];
        else mm_free(s->v[i]);
    }
    s->n = w;
}

static void walk_ext(const char *root, const char *rel, int depth, StrVec *out) {
    if (depth > 32) die("ext-depth");
    char full[4400];
    if (cx_fmt(full, sizeof full, "%s/%s", root, rel)) die("path-bound");
    sy_stat_t st;
    int rc = sy_lstat(full, &st);
    if (rc == -ENOENT) return;
    if (rc) die("ext-lstat");
    if (st.kind == 'f') {
        sv_push(out, rel, strlen(rel));
        return;
    }
    if (st.kind != 'd') return;
    sy_dir_t d;
    if (sy_dir_open(&d, full)) die("ext-opendir");
    int next;
    while ((next = sy_dir_next(&d)) == 1) {
        if (tx_eqz(d.name, ".") || tx_eqz(d.name, "..")) continue;
        char sub[4400];
        if (cx_fmt(sub, sizeof sub, "%s/%s", rel, d.name)) die("path-bound");
        walk_ext(root, sub, depth + 1, out);
    }
    sy_dir_close(&d);
    if (next < 0) die("ext-readdir");
}

typedef struct {
    char kind[16];
    char path[256];
} CandRule;

static CandRule c_rules[64];
static int c_nrules;

static int under_prefix(const char *rel, const char *pre) {
    size_t pl = strlen(pre);
    if (strncmp(rel, pre, pl) != 0) return 0;
    return rel[pl] == 0 || rel[pl] == '/';
}

static int cand_listed(const char *rel) {
    int in = 0;
    for (int i = 0; i < c_nrules; i++) {
        if (tx_eqz(c_rules[i].kind, "exclude") && under_prefix(rel, c_rules[i].path)) return 0;
        if ((tx_eqz(c_rules[i].kind, "tree") && under_prefix(rel, c_rules[i].path)) ||
            (tx_eqz(c_rules[i].kind, "file") && tx_eqz(rel, c_rules[i].path))) in = 1;
    }
    return in;
}

static void load_cand_rules(const char *root) {
    char mp[4400];
    if (cx_fmt(mp, sizeof mp, "%s/tools/candidate-trigger-inputs.tsv", root)) die("cand-manifest-path");
    size_t mn = 0;
    char *mb = cx_read(mp, &mn);
    if (!mb) die("cand-manifest-read");
    c_nrules = 0;
    char *cur = mb, *end = mb + mn;
    while (cur < end) {
        char *nl = (char *)memchr(cur, '\n', (size_t)(end - cur));
        size_t ll = nl ? (size_t)(nl - cur) : (size_t)(end - cur);
        if (ll > 0 && cur[ll - 1] == '\r') ll--;
        if (ll > 0 && cur[0] != '#') {
            char line[512];
            if (ll >= sizeof line) die("cand-manifest-line");
            mm_copy(line, sizeof line, cur, (long)ll);
            line[ll] = 0;
            char *f[4];
            int nf = 0;
            f[nf++] = line;
            for (char *q = line; *q && nf < 4; q++) if (*q == '\t') { *q = 0; f[nf++] = q + 1; }
            if (nf < 3 || c_nrules >= 64) die("cand-manifest-shape");
            if (cx_fmt(c_rules[c_nrules].kind, sizeof c_rules[0].kind, "%s", f[0]) ||
                cx_fmt(c_rules[c_nrules].path, sizeof c_rules[0].path, "%s", f[2])) die("cand-manifest-bound");
            c_nrules++;
        }
        cur = nl ? nl + 1 : end;
    }
    free(mb);
    if (!c_nrules) die("cand-manifest-empty");
}

static void walk_cand(const char *root, const char *rel, int depth, StrVec *out) {
    if (depth > 64) die("cand-depth");
    char full[4400];
    if (cx_fmt(full, sizeof full, "%s/%s", root, rel)) die("path-bound");
    sy_stat_t st;
    int rc = sy_lstat(full, &st);
    if (rc == -ENOENT) return;
    if (rc) die("cand-lstat");
    if (st.kind != 'd') {
        if (cand_listed(rel)) sv_push(out, rel, strlen(rel));
        return;
    }
    sy_dir_t d;
    if (sy_dir_open(&d, full)) die("cand-opendir");
    int next;
    while ((next = sy_dir_next(&d)) == 1) {
        if (tx_eqz(d.name, ".") || tx_eqz(d.name, "..")) continue;
        char sub[4400];
        if (cx_fmt(sub, sizeof sub, "%s/%s", rel, d.name)) die("path-bound");
        walk_cand(root, sub, depth + 1, out);
    }
    sy_dir_close(&d);
    if (next < 0) die("cand-readdir");
}

static void generate_tsv(const char *root, np_buf *out) {
    char prod[4400], ident[4400], why[512];
    if (cx_fmt(prod, sizeof prod, "%s/unisacc.com", root) ||
        cx_fmt(ident, sizeof ident, "%s/seed/ident.c", root)) die("path-bound");

    /* 1. Run seed/ident.c ROOT list-current via unisacc.com */
    char *av[] = { "sh", prod, ident, "--", (char *)root, "list-current", 0 };
    np_result r = {0};
    if (np_run(av, root, 0, 50, &r, why, sizeof why) || r.rc != 0 || !r.out || !r.outn) {
        if (r.err && r.errn) fprintf(stderr, "%.*s\n", (int)r.errn, r.err);
        np_free(&r);
        die("sid-list-current-failed");
    }

    StrVec lane_a_sid = {0};
    char *cur = r.out, *end = r.out + r.outn;
    while (cur < end) {
        char *nl = (char *)memchr(cur, '\n', (size_t)(end - cur));
        size_t len = nl ? (size_t)(nl - cur) : (size_t)(end - cur);
        if (len > 0) {
            char *tab = (char *)memchr(cur, '\t', len);
            size_t plen = tab ? (size_t)(tab - cur) : len;
            if (plen > 0) sv_push(&lane_a_sid, cur, plen);
        }
        cur = nl ? nl + 1 : end;
    }
    np_free(&r);
    sv_sort_uniq(&lane_a_sid);
    if (lane_a_sid.n == 0) die("empty-sid-list");

    /* 1b. Verify every real unit in build/core-closure.tsv is covered by lane_a_sid (I2) */
    {
        char cp[4400];
        if (cx_fmt(cp, sizeof cp, "%s/build/core-closure.tsv", root)) die("closure-path");
        size_t cn = 0;
        char *cb = cx_read(cp, &cn);
        if (!cb || !cn) die("core-closure-missing");
        char *p = cb, *ce = cb + cn;
        while (p < ce) {
            char *nl = (char *)memchr(p, '\n', (size_t)(ce - p));
            size_t ll = nl ? (size_t)(nl - p) : (size_t)(ce - p);
            if (ll > 0 && p[0] != '#') {
                char *t1 = (char *)memchr(p, '\t', ll);
                char *t2 = t1 ? (char *)memchr(t1 + 1, '\t', (size_t)(p + ll - (t1 + 1))) : 0;
                if (t2) {
                    char *r0 = t2 + 1;
                    char *t3 = (char *)memchr(r0, '\t', (size_t)(p + ll - r0));
                    size_t rl = t3 ? (size_t)(t3 - r0) : (size_t)(p + ll - r0);
                    if (rl > 0 && rl < 300) {
                        char rp[304];
                        mm_copy(rp, sizeof rp, r0, (long)rl);
                        rp[rl] = 0;
                        if (strcmp(rp, "UNMEASURED") && !sv_has_sorted(&lane_a_sid, rp)) {
                            fprintf(stderr, "lane-inputs-gen: missing closure unit in SID: %s\n", rp);
                            free(cb);
                            die("closure-unit-missing-from-sid");
                        }
                    }
                }
            }
            p = nl ? nl + 1 : ce;
        }
        free(cb);
    }

    /* 2. Pure-B extension library sources: ext/ files not in SID */
    StrVec ext_all = {0};
    walk_ext(root, "ext", 0, &ext_all);
    sv_sort_uniq(&ext_all);

    StrVec lane_b = {0};
    for (int i = 0; i < ext_all.n; i++) {
        if (!sv_has_sorted(&lane_a_sid, ext_all.v[i])) sv_push(&lane_b, ext_all.v[i], strlen(ext_all.v[i]));
    }
    sv_free(&ext_all);
    sv_sort_uniq(&lane_b);

    /* 3. Remaining APE/model-package inputs from tools/candidate-trigger-inputs.tsv (minus SID and pure-B) */
    load_cand_rules(root);
    StrVec cand_all = {0};
    char gitp[4400];
    sy_stat_t gst;
    if (cx_fmt(gitp, sizeof gitp, "%s/.git", root)) die("git-path");
    if (sy_lstat(gitp, &gst) == 0) {
        char *gv[] = { "git", "-C", (char *)root, "ls-files", "-z", 0 };
        np_result gr = {0};
        if (np_run(gv, root, 0, 30, &gr, why, sizeof why) || gr.rc != 0 || !gr.out) {
            np_free(&gr);
            die("git-ls-files-failed");
        }
        for (size_t at = 0; at < gr.outn; ) {
            size_t kl = strlen(gr.out + at);
            if (kl > 0 && cand_listed(gr.out + at)) sv_push(&cand_all, gr.out + at, kl);
            at += kl + 1;
        }
        np_free(&gr);
    } else {
        for (int i = 0; i < c_nrules; i++) {
            if (!tx_eqz(c_rules[i].kind, "exclude")) walk_cand(root, c_rules[i].path, 0, &cand_all);
        }
    }
    sv_sort_uniq(&cand_all);

    StrVec lane_a_model = {0};
    for (int i = 0; i < cand_all.n; i++) {
        if (!sv_has_sorted(&lane_a_sid, cand_all.v[i]) && !sv_has_sorted(&lane_b, cand_all.v[i])) {
            sv_push(&lane_a_model, cand_all.v[i], strlen(cand_all.v[i]));
        }
    }
    sv_free(&cand_all);

    np_puts(out, "# Generated by tools/lane-inputs-gen.cx from seed/ident.c list-current + candidate-trigger-inputs.tsv. Do not edit by hand.\n");
    np_puts(out, "# path\tlane\tsource\n");
    /* Emit all lane A entries sorted by path (merged sid-list-current + model-tree) */
    int ia = 0, im = 0;
    while (ia < lane_a_sid.n || im < lane_a_model.n) {
        int take_sid = (im >= lane_a_model.n) || (ia < lane_a_sid.n && strcmp(lane_a_sid.v[ia], lane_a_model.v[im]) <= 0);
        if (take_sid) {
            np_puts(out, lane_a_sid.v[ia++]);
            np_puts(out, "\tA\tsid-list-current\n");
        } else {
            np_puts(out, lane_a_model.v[im++]);
            np_puts(out, "\tA\tmodel-tree\n");
        }
    }
    for (int i = 0; i < lane_b.n; i++) {
        np_puts(out, lane_b.v[i]);
        np_puts(out, "\tB\text-non-sid\n");
    }
    static const char *const lane_c[] = {
        "apps", "archive", "build", "examples", "plans", "tests", "tools", "ujs", 0
    };
    for (int i = 0; lane_c[i]; i++) {
        np_puts(out, lane_c[i]);
        np_puts(out, "\tC\tnon-product-tree\n");
    }
    sv_free(&lane_a_sid);
    sv_free(&lane_a_model);
    sv_free(&lane_b);
}

int main(int argc, char **argv) {
    int do_check = 0, do_write = 0;
    const char *root_arg = ".";
    for (int i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--")) continue;
        else if (tx_eqz(argv[i], "--check")) do_check = 1;
        else if (tx_eqz(argv[i], "--write")) do_write = 1;
        else if (argv[i][0] != '-') root_arg = argv[i];
        else die("usage: --check|--write [ROOT]");
    }
    if (do_check + do_write != 1) die("usage: --check|--write [ROOT]");

    char root[4096], target[4400];
    if (sy_realpath(root_arg, root, sizeof root) < 0) die("root-realpath");
    if (cx_fmt(target, sizeof target, "%s/build/lane-inputs.tsv", root)) die("target-bound");

    np_buf gen = {0};
    generate_tsv(root, &gen);

    if (do_write) {
        if (sy_write_atomic(target, gen.p, gen.n, 0644)) {
            free(gen.p);
            die("write-failed");
        }
        printf("LANE_INPUTS_GEN\tWROTE\tbytes=%zu\tpath=build/lane-inputs.tsv\n", gen.n);
        free(gen.p);
        return 0;
    }

    size_t en = 0;
    char *eb = cx_read(target, &en);
    if (!eb) {
        free(gen.p);
        fprintf(stderr, "LANE_INPUTS_GEN\tDIFF\tmissing build/lane-inputs.tsv (run --write)\n");
        return 1;
    }
    int same = (en == gen.n && (!en || !memcmp(eb, gen.p, en)));
    free(eb);
    free(gen.p);
    if (!same) {
        fprintf(stderr, "LANE_INPUTS_GEN\tDIFF\tbuild/lane-inputs.tsv out of date (run --write)\n");
        return 1;
    }
    printf("LANE_INPUTS_GEN\tSAME\tbytes=%zu\tpath=build/lane-inputs.tsv\n", en);
    return 0;
}
