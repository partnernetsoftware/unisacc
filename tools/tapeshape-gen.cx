#pragma unisa use sys.io
#pragma unisa use text.text
/* Project exec/facts/tape-shape.tsv onto cx/compiler/tapeshape.cx.
   sh ./unisacc.com tools/tapeshape-gen.cx -- --check
   sh ./unisacc.com tools/tapeshape-gen.cx -- --write
   The fact table is the only opcode/shape list. A row is two tab fields:
   op name and operand shape. The shape uses commas ("r,i"); the generated
   table stores it comma-free ("ri") to match tapegate's tb2_oshape and the
   encoder's matcher. Exactly 72 data rows (opset 1, never reordered; new
   ops append at the end). No libc and no include. */
#define TSV "exec/facts/tape-shape.tsv"
#define OUT "cx/compiler/tapeshape.cx"
#define NSHAPE 72
#define NAMEMAX 40
#define SHAPEMAX 24
#define GENCAP 32768

typedef struct {
    char name[NAMEMAX];
    char shape[SHAPEMAX];
} Row;

static Row rows[NSHAPE];
static int nrows;

static int fail(const char *why) {
    sy_eprintf("tapeshape-gen\tFAIL\t%s\n", why);
    return 1;
}

static int name_ok(const char *s, int n) {
    int i;
    if (n < 1 || n >= NAMEMAX) return 0;
    for (i = 0; i < n; i++) {
        char c = s[i];
        if (c >= 'a' && c <= 'z') continue;
        if (c >= '0' && c <= '9') continue;
        if (c == '.' || c == '_') continue;
        return 0;
    }
    return 1;
}

/* shape chars must be r i L s only, empty allowed (ret/nop), <= 8 (longest .libraryaddr). */
static int shape_ok(const char *s, int n) {
    int i;
    if (n < 0 || n > 8) return 0;
    for (i = 0; i < n; i++) {
        char c = s[i];
        if (c == 'r' || c == 'i' || c == 'L' || c == 's') continue;
        return 0;
    }
    return 1;
}

static int take_row(const char *line, int n) {
    int tab, i, j;
    if (nrows >= NSHAPE) return fail("shape-count");
    tab = -1;
    for (i = 0; i < n; i++) if (line[i] == '\t') { tab = i; break; }
    if (tab <= 0 || tab + 1 > n) return fail("row-fields");
    if (!name_ok(line, tab)) return fail("row-name");
    /* copy name */
    for (i = 0; i < tab; i++) rows[nrows].name[i] = line[i];
    rows[nrows].name[tab] = 0;
    /* copy shape, dropping commas */
    j = 0;
    for (i = tab + 1; i < n; i++) {
        if (line[i] == ',') continue;
        rows[nrows].shape[j] = line[i];
        j++;
    }
    rows[nrows].shape[j] = 0;
    if (!shape_ok(rows[nrows].shape, j)) return fail("row-shape");
    nrows++;
    return 0;
}

static int parse(char *b, size_t n) {
    size_t i = 0;
    int saw = 0;
    if (n == 0 || b[n - 1] != '\n') return fail("tsv-newline");
    while (i < n) {
        size_t e = i;
        while (e < n && b[e] != '\n') e++;
        b[e] = 0;
        if (e == i) return fail("blank-line");
        if (!saw) {
            if (!tx_eqz(b + i, "# op\tshape")) return fail("header");
            saw = 1;
        } else if (b[i] == '#') {
            /* provenance comments are not data; skip them */
        } else if (take_row(b + i, (int)(e - i))) {
            return 1;
        }
        i = e + 1;
    }
    if (nrows != NSHAPE) return fail("shape-count");
    return 0;
}

static int app(char *dst, int cap, int *n, const char *s) {
    int i = 0;
    while (s[i]) {
        if (*n + 1 >= cap) return -1;
        dst[*n] = s[i];
        *n += 1;
        i++;
    }
    dst[*n] = 0;
    return 0;
}

static int app_digit(char *dst, int cap, int *n, int d) {
    char s[2];
    if (d < 0 || d > 9) return -1;
    s[0] = (char)('0' + d);
    s[1] = 0;
    return app(dst, cap, n, s);
}

static int app_num(char *dst, int cap, int *n, int v) {
    char s[16];
    int i = 0, j;
    if (v < 0) return -1;
    if (v == 0) return app_digit(dst, cap, n, 0);
    while (v > 0 && i < 15) { s[i] = (char)('0' + (v % 10)); v = v / 10; i++; }
    for (j = i - 1; j >= 0; j--) if (app_digit(dst, cap, n, s[j] - '0')) return -1;
    return 0;
}

static int emit(char *dst, int cap, int *n) {
    int i;
    *n = 0;
    dst[0] = 0;
    if (app(dst, cap, n, "#pragma unisa module tapeshape\n")) return -1;
    if (app(dst, cap, n, "/* Generated by tools/tapeshape-gen.cx from exec/facts/tape-shape.tsv -- do not edit. */\n")) return -1;
    if (app(dst, cap, n, "static const char *ts_names[")) return -1;
    if (app_num(dst, cap, n, nrows)) return -1;
    if (app(dst, cap, n, "] = {")) return -1;
    for (i = 0; i < nrows; i++) {
        if (i) { if (app(dst, cap, n, ", ")) return -1; }
        if (app(dst, cap, n, "\"")) return -1;
        if (app(dst, cap, n, rows[i].name)) return -1;
        if (app(dst, cap, n, "\"")) return -1;
    }
    if (app(dst, cap, n, "};\n")) return -1;
    if (app(dst, cap, n, "static const char *ts_shapes[")) return -1;
    if (app_num(dst, cap, n, nrows)) return -1;
    if (app(dst, cap, n, "] = {")) return -1;
    for (i = 0; i < nrows; i++) {
        if (i) { if (app(dst, cap, n, ", ")) return -1; }
        if (app(dst, cap, n, "\"")) return -1;
        if (app(dst, cap, n, rows[i].shape)) return -1;
        if (app(dst, cap, n, "\"")) return -1;
    }
    if (app(dst, cap, n, "};\n")) return -1;
    if (app(dst, cap, n, "const char *tape_shape_name(int op) {\n    if (op < 0 || op >= ")) return -1;
    if (app_num(dst, cap, n, nrows)) return -1;
    if (app(dst, cap, n, ") return 0;\n    return ts_names[op];\n}\n")) return -1;
    if (app(dst, cap, n, "const char *tape_shape(int op) {\n    if (op < 0 || op >= ")) return -1;
    if (app_num(dst, cap, n, nrows)) return -1;
    if (app(dst, cap, n, ") return 0;\n    return ts_shapes[op];\n}\n")) return -1;
    return 0;
}

static int same_bytes(const char *a, size_t an, const char *b, size_t bn) {
    size_t i;
    if (an != bn) return 0;
    for (i = 0; i < an; i++) if (a[i] != b[i]) return 0;
    return 1;
}

int main(int argc, char **argv) {
    size_t n = 0, on = 0;
    char *b, *cur;
    char gen[GENCAP];
    int gn = 0, dowrite = 0;
    if (argc != 2 || (!tx_eqz(argv[1], "--check") && !tx_eqz(argv[1], "--write"))) {
        sy_eprintf("tapeshape-gen\tusage\t--check|--write\n");
        return 2;
    }
    dowrite = tx_eqz(argv[1], "--write");
    b = cx_read(TSV, &n);
    if (!b) return fail("tsv-read");
    if (parse(b, n)) return 1;
    if (emit(gen, GENCAP, &gn)) return fail("emit");
    if (dowrite) {
        if (cx_write(OUT, gen, (size_t)gn)) return fail("write");
        sy_printf("TAPESHAPE_GEN\tWROTE\t%s\tbytes=%d\n", OUT, gn);
        return 0;
    }
    cur = cx_read(OUT, &on);
    if (!cur) return fail("out-read");
    if (!same_bytes(cur, on, gen, (size_t)gn)) return fail("check-difference");
    sy_printf("TAPESHAPE_GEN\tCHECK\trows=%d\tbytes=%d\n", nrows, gn);
    return 0;
}
