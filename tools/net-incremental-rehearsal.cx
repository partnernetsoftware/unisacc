/* Resumable BASE6 orchestration. Constructors and exhaustive comparison remain
 * the existing net-build-profile / lab-loader net-check implementations. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sys.time
#pragma unisa use sysx.process
#pragma unisa use mem.bytes
static char repo[8192];
static void die(const char *s){fprintf(stderr,"NET_INCREMENTAL_REHEARSAL REFUSE %s errno=%d\n",s,errno);exit(2);}
static void path(char p[16384],const char *a,const char *b){if(cx_fmt(p,16384,"%s/%s",a,b))die("path");}
static void parents(const char *file){char p[16384];if(cx_fmt(p,sizeof p,"%s",file))die("path");for(char *q=p+1;*q;q++)if(*q=='/'){*q=0;struct stat st;if(lstat(p,&st)){if(errno!=ENOENT||mkdir(p,0700))die("parent mkdir");}else if(!S_ISDIR(st.st_mode))die("parent not directory");*q='/';}}
static void save(const char *file,const void *s,size_t n){parents(file);int fd=sy_open_new(file,0600);if(fd<0||sy_write_all(fd,s,n)||sy_close(fd))die("exclusive save");}
static char *load(const char *file,size_t *n){struct stat st;if(lstat(file,&st)||!S_ISREG(st.st_mode))die("regular input");char *s=cx_read(file,n);if(!s)die("read");return s;}
static void hash(const void *s,size_t n,char h[65]){if(sy_sha256_hex(s,n,h)&&cx_sha256_hex(s,n,h))die("hash");}
static void cp(const char *src,const char *dst){size_t n;char *s=load(src,&n);save(dst,s,n);struct stat st;if(lstat(src,&st)||chmod(dst,st.st_mode&0777))die("copy mode");free(s);}
static np_result run(char **args,const char *cwd,int limit){np_result r={0};char why[300];if(np_run(args,cwd,0,limit,&r,why,sizeof why)||r.residue)die("child bound");if(r.rc){fprintf(stderr,"%s\n",r.err?r.err:"");die("child rc");}return r;}
static long num(const char *s){if(!*s||(s[0]=='0'&&s[1]))die("number");long n=0;for(;*s;s++){if(*s<'0'||*s>'9'||n>100000000)die("number");n=n*10+*s-'0';}return n;}
static int split(char *s,char **v){int n=1;v[0]=s;for(;*s;s++)if(*s=='\t'){*s=0;if(n==16)die("fields");v[n++]=s+1;}return n;}
static char *value(char *s,const char *key){long n=strlen(key);if(strncmp(s,key,n)||s[n]!='=')die("key/order");return s+n+1;}
static void hex(const char *s){if(strlen(s)!=64)die("SHA length");for(int i=0;i<64;i++)if(!((s[i]>='0'&&s[i]<='9')||(s[i]>='a'&&s[i]<='f')))die("SHA syntax");}
static void text(const char *s,size_t n){if(!n||s[n-1]!='\n'||memchr(s,0,n)||memchr(s,'\r',n))die("text");}
static char *line(char **p){char *s=*p,*e=strchr(s,'\n');if(!e)die("line");*e=0;*p=e+1;return s;}
typedef struct {char *id;char digest[65];char tool[65];} D;
static void digests(const char *file,D d[42],char h[65]){size_t n;char *s=load(file,&n);text(s,n);hash(s,n,h);char *p=s,*v[16];int i=0;while(*p){if(i==42||split(line(&p),v)!=9||strcmp(v[0],"NET_DIGEST")||strcmp(v[1],"version=1")||strcmp(v[8],"closure=static-upper-bound"))die("digest schema");char *id=value(v[2],"net");if(!*id||strchr(id,'/')||strstr(id,".."))die("net id");for(int j=0;j<i;j++)if(!strcmp(d[j].id,id))die("duplicate net");d[i].id=id;value(v[3],"stage");char *dh=value(v[4],"sha256"),*tool=value(v[7],"tool_sha");hex(dh);hex(tool);(cx_fmt(d[i].digest, sizeof d[i].digest, "%s", dh) ? exit(2) : (void)0);(cx_fmt(d[i].tool, sizeof d[i].tool, "%s", tool) ? exit(2) : (void)0);num(value(v[5],"files"));num(value(v[6],"bytes"));i++;}if(i!=42)die("42 digests required");}
static int affected(const char *id){return !strcmp(id,"shared-e2")||!strcmp(id,"tokenpp")||!strcmp(id,"warnpp-shared");}
static void plan(const char *before,const char *after,const char *output){D a[42]={0},b[42]={0};char ah[65],bh[65];digests(before,a,ah);digests(after,b,bh);int changed=0;for(int i=0;i<42;i++){if(strcmp(a[i].id,b[i].id)||strcmp(a[i].tool,b[i].tool))die("digest net/tool identity");int delta=strcmp(a[i].digest,b[i].digest)!=0;if(delta!=affected(a[i].id))die("expected exactly three pp changes");changed+=delta;}if(changed!=3)die("change count");char out[32768];int z=snprintf(out,sizeof out,"INCREMENTAL_PLAN\tversion=1\tbefore_sha=%s\tafter_sha=%s\tchanged=3\ttotal=42\tclaim=PREPARED\n",ah,bh);for(int i=0;i<42;i++){int k=snprintf(out+z,sizeof out-z,"MODEL\t%d\t%s\t%s\n",i,a[i].id,affected(a[i].id)?"BUILD":"REUSE");if(k<0||k>=(int)sizeof out-z)die("plan size");z+=k;}z+=snprintf(out+z,sizeof out-z,"PLAN_COMPLETE\tmodels=42\tbuild=3\treuse=39\n");save(output,out,z);printf("INCREMENTAL_PLAN_READY\tchanged=3\ttotal=42\tstate=PREPARED\n");}
static void prepare(const char *source,const char *out){char sourceabs[16384];parents(out);if(!realpath(source,sourceabs)||mkdir(out,0700))die("new run/source");char root[16384];path(root,out,"root");if(mkdir(root,0700))die("root mkdir");char *args[]={"git","-C",sourceabs,"ls-files","-z","--","exec","seed","include/unisa_safedel.h",0};np_result r=run(args,repo,12);long count=0;for(size_t at=0;at<r.outn;){char *rel=r.out+at;size_t n=strlen(rel);if(n>=r.outn-at||strpbrk(rel,"\r\n\t")||*rel=='/'||strstr(rel,".."))die("tracked path");at+=n+1;char a[16384],b[16384];path(a,sourceabs,rel);struct stat st;if(lstat(a,&st))die("tracked stat");if(!S_ISREG(st.st_mode))continue;path(b,root,rel);cp(a,b);count++;}np_free(&r);const char *extras[]={"tools/bound","tools/bound.c","tools/cxlib/sourcepackage.cx",0};for(int i=0;extras[i];i++){char a[16384],b[16384];path(a,sourceabs,extras[i]);path(b,root,extras[i]);cp(a,b);}char *init[]={"git","-C",root,"init","-q",0};r=run(init,repo,8);np_free(&r);char *add[]={"git","-C",root,"add","--","exec","seed",0};r=run(add,repo,12);np_free(&r);char f[16384],record[32768];path(f,out,"material.tsv");int z=snprintf(record,sizeof record,"INCREMENTAL_MATERIAL\tversion=1\tsource=%s\troot=%s\ttracked_regular=%ld\tstate=PREPARED\n",sourceabs,root,count);save(f,record,z);fwrite(record,1,z,stdout);}
static void snapshot(const char *dir,const char *name){char root[16384],file[16384],com[16384],tool[16384];path(root,dir,"root");path(file,dir,name);path(com,repo,"unisacc.com");path(tool,repo,"tools/net-digest.cx");char *a[]={"sh",com,tool,"--","--root",root,"--all",0};np_result r=run(a,repo,40);save(file,r.out,r.outn);np_free(&r);printf("DIGEST_SNAPSHOT\t%s\tstate=PREPARED\n",name);}
static void mutate(const char *dir){char file[16384],marker[16384];path(marker,dir,"mutation.tsv");struct stat st;if(!lstat(marker,&st)||errno!=ENOENT)die("mutation already exists/stat");path(file,dir,"root/exec/pp/location-byte.tsv");size_t n;char *s=load(file,&n);const char *needle="unreachable",*replacement="BASE6-probe-unreachable";char *last=0;for(char *p=s;(p=strstr(p,needle));p+=strlen(needle))last=p;if(!last||strstr(s,"BASE6-probe-unreachable"))die("mutation anchor");char *ls=last;while(ls>s&&ls[-1]!='\n')ls--;char *le=strchr(last,'\n');if(!le)die("last anchor line");char saved=*le;*le=0;int reject=strstr(ls,"REJECT")!=0;*le=saved;if(!reject)die("last anchor not REJECT");size_t z=n+strlen(replacement)-strlen(needle);char *b=malloc(z+1);if(!b)die("allocation");long at=last-s;mm_copy(b, at, s, at);mm_copy(b+at, strlen(replacement), replacement, strlen(replacement));mm_copy(b+at+strlen(replacement), n-at-strlen(needle), last+strlen(needle), n-at-strlen(needle));char ah[65],bh[65];hash(s,n,ah);hash(b,z,bh);if(cx_write(file,b,z))die("private mutation");char rec[500];int len=snprintf(rec,sizeof rec,"MUTATION\tpath=exec/pp/location-byte.tsv\tbefore_sha=%s\tafter_sha=%s\told=unreachable\tnew=BASE6-probe-unreachable\tstate=PREPARED\n",ah,bh);save(marker,rec,len);free(s);free(b);fwrite(rec,1,len,stdout);}
static void model(const char *dir,int index,char id[160]){char f[16384];path(f,dir,"plan.tsv");size_t n;char *s=load(f,&n);text(s,n);char *p=s,*v[16];if(strncmp(line(&p),"INCREMENTAL_PLAN\t",17))die("plan header");int found=0,count=0;while(*p){int k=split(line(&p),v);if(k==4&&!strcmp(v[0],"MODEL")){if(num(v[1])!=count++||strcmp(v[3],affected(v[2])?"BUILD":"REUSE"))die("plan order/action");if(count-1==index){if(strlen(v[2])>=160||strchr(v[2],'/')||strstr(v[2],".."))die("plan id");(cx_fmt(id, sizeof id, "%s", v[2]) ? exit(2) : (void)0);found=1;}}else if(k!=4||strcmp(v[0],"PLAN_COMPLETE")||strcmp(v[1],"models=42")||strcmp(v[2],"build=3")||strcmp(v[3],"reuse=39")||*p)die("plan footer");}if(count!=42||!found)die("plan index");free(s);}
static void filehash(const char *p,char h[65]){size_t n;char *s=load(p,&n);hash(s,n,h);free(s);}
static char *keycopy(const char *s,const char *key){char pattern[100];(cx_fmt(pattern, sizeof pattern, "\t%s=", key) ? exit(2) : (void)0);const char *p=strstr(s,pattern);if(!p)die("receipt field");p+=strlen(pattern);const char *e=p;while(*e&&*e!='\t'&&*e!='\n')e++;char *out=malloc(e-p+1);if(!out)die("allocation");mm_copy(out, e-p, p, e-p);out[e-p]=0;return out;}
static void cache(const char *dir,const char *stem){const char *rel=!strcmp(stem,"profile")?"tools/net-build-profile.cx":!strcmp(stem,"checker")?"tools/lab-loader/net-check.cx":0;if(!rel)die("cache kind");char source[16384],com[16384],exe[16384],receipt[16384],leaf[100];path(source,repo,rel);path(com,repo,"unisacc.com");(cx_fmt(leaf, sizeof leaf, "%s.exe", stem) ? exit(2) : (void)0);path(exe,dir,leaf);(cx_fmt(leaf, sizeof leaf, "%s-cache.tsv", stem) ? exit(2) : (void)0);path(receipt,dir,leaf);struct stat st;if(!lstat(exe,&st)||errno!=ENOENT)die("cache exists/stat");char sh[65],ch[65],eh[65],after[65];filehash(source,sh);filehash(com,ch);long start=sy_now_ms();char *a[]={"sh",com,source,"-o",exe,0};np_result r=run(a,repo,35);np_free(&r);filehash(source,after);if(strcmp(sh,after))die("cache source changed");filehash(com,after);if(strcmp(ch,after))die("cache product changed");filehash(exe,eh);char record[1000];int n=snprintf(record,sizeof record,"REHEARSAL_CACHE\tkind=%s\tsource_sha=%s\tproduct_sha=%s\texe_sha=%s\tcompile_ms=%ld\tstate=PREPARED\n",stem,sh,ch,eh,sy_now_ms()-start);save(receipt,record,n);fwrite(record,1,n,stdout);}
static void cached(const char *dir,const char *stem,char exe[16384]){char leaf[100],p[16384],source[16384],com[16384];(cx_fmt(leaf, sizeof leaf, "%s.exe", stem) ? exit(2) : (void)0);path(exe,dir,leaf);(cx_fmt(leaf, sizeof leaf, "%s-cache.tsv", stem) ? exit(2) : (void)0);path(p,dir,leaf);size_t n;char *s=load(p,&n);text(s,n);if(strncmp(s,"REHEARSAL_CACHE\t",16))die("cache receipt");char *kind=keycopy(s,"kind");if(strcmp(kind,stem))die("cache kind identity");path(source,repo,!strcmp(stem,"profile")?"tools/net-build-profile.cx":"tools/lab-loader/net-check.cx");path(com,repo,"unisacc.com");const char *paths[]={source,com,exe};const char *keys[]={"source_sha","product_sha","exe_sha"};for(int i=0;i<3;i++){char h[65];filehash(paths[i],h);char *want=keycopy(s,keys[i]);if(strcmp(h,want))die("cache actual identity");free(want);}free(kind);free(s);}
static void configure(const char *dir,const char *baseline,const char *gen,const char *tbl,const char *net){char abs[16384],bins[3][16384],hs[3][65];if(!realpath(baseline,abs))die("baseline root");const char *in[]={gen,tbl,net};for(int i=0;i<3;i++){if(!realpath(in[i],bins[i]))die("constructor path");filehash(bins[i],hs[i]);}char out[65536];int used=snprintf(out,sizeof out,"BASELINE_INDEX\tversion=1\troot=%s\tgen=%s\ttbl=%s\tnet=%s\tgen_sha=%s\ttbl_sha=%s\tnet_sha=%s\tstate=PREPARED\n",abs,bins[0],bins[1],bins[2],hs[0],hs[1],hs[2]);int count=0;for(int batch=0;batch<42;batch+=6){char leaf[100],profile[16384],pdir[16384];(cx_fmt(leaf, sizeof leaf, "batch-%02d", batch) ? exit(2) : (void)0);path(pdir,abs,leaf);path(profile,pdir,"profile.tsv");size_t n;char *s=load(profile,&n);text(s,n);char ph[65];hash(s,n,ph);char *p=s,*v[16];char *header=line(&p);if(strncmp(header,"NET_BUILD_PROFILE\t",18))die("baseline profile header");const char *keys[]={"gen_sha","tbl_sha","net_sha"};for(int k=0;k<3;k++){char *h=keycopy(header,keys[k]);if(strcmp(h,hs[k]))die("baseline constructor identity");free(h);}int rows=0,closed=0;while(*p){int fields=split(line(&p),v);if(fields==10&&!strcmp(v[0],"NET")){if(closed||count>=42)die("baseline rows");char id[160];model(dir,count,id);if(strcmp(id,v[1]))die("baseline recipe order");char *gh=value(v[6],"gen_sha"),*th=value(v[7],"tbl_sha"),*nh=value(v[8],"net_sha");hex(gh);hex(th);hex(nh);if(strcmp(v[9],"rc=0"))die("baseline rc");int z=snprintf(out+used,sizeof out-used,"BASELINE\t%d\t%s\tdir=%s\tgen_sha=%s\ttbl_sha=%s\tnet_sha=%s\tprofile_sha=%s\n",count,id,pdir,gh,th,nh,ph);if(z<0||z>=(int)sizeof out-used)die("index size");used+=z;count++;rows++;}else if(fields==3&&!strcmp(v[0],"PROFILE_COMPLETE")&&!strcmp(v[1],"models=6")&&!strcmp(v[2],"full_key_validation=NOT_EXECUTED")&&!*p)closed=1;else die("baseline profile row");}free(s);if(rows!=6||!closed)die("baseline profile incomplete");}used+=snprintf(out+used,sizeof out-used,"BASELINE_COMPLETE\tmodels=42\tstate=PREPARED\n");char file[16384];path(file,dir,"baseline-index.tsv");save(file,out,used);printf("BASELINE_INDEX_READY\tmodels=42\tstate=PREPARED\n");}
static char *indexrow(const char *dir,int index){char p[16384];path(p,dir,"baseline-index.tsv");size_t n;char *s=load(p,&n);text(s,n);char marker[100];(cx_fmt(marker, sizeof marker, "\nBASELINE\t%d\t", index) ? exit(2) : (void)0);char *q=strstr(s,marker);if(!q)die("baseline row missing");q++;char *e=strchr(q,'\n');if(!e)die("baseline row LF");*e=0;return q;}
static void configured(const char *dir,char g[16384],char t[16384],char n[16384]){char p[16384];path(p,dir,"baseline-index.tsv");size_t z;char *s=load(p,&z);text(s,z);char *end=strchr(s,'\n');*end=0;char *a[]={g,t,n};const char *keys[]={"gen","tbl","net"},*hk[]={"gen_sha","tbl_sha","net_sha"};for(int i=0;i<3;i++){char *v=keycopy(s,keys[i]);if(strlen(v)>=16384)die("constructor path size");(cx_fmt(a[i], sizeof a[i], "%s", v) ? exit(2) : (void)0);free(v);char h[65];filehash(a[i],h);v=keycopy(s,hk[i]);if(strcmp(h,v))die("configured constructor changed");free(v);}free(s);}
static void validationstamp(const char *out,const char *table,const char *network,const char *checker,const char *raw,size_t n){char th[65],nh[65],eh[65],rh[65];filehash(table,th);filehash(network,nh);filehash(checker,eh);hash(raw,n,rh);char p[16384],b[700];path(p,out,"validation-bind.tsv");int z=snprintf(b,sizeof b,"FULL_KEY_BIND\ttable_sha=%s\tnet_sha=%s\tchecker_sha=%s\treceipt_sha=%s\trc=0\tclaim=table-equals-network\n",th,nh,eh,rh);save(p,b,z);}
static void requirevalidation(const char *dir,const char *job,const char *table,const char *network){char checker[16384];cached(dir,"checker",checker);char p[16384],h[65];path(p,job,"validation-bind.tsv");size_t n;char *s=load(p,&n);text(s,n);const char *paths[]={table,network,checker};const char *keys[]={"table_sha","net_sha","checker_sha"};for(int i=0;i<3;i++){filehash(paths[i],h);char *v=keycopy(s,keys[i]);if(strcmp(h,v))die("validation artifact changed");free(v);}path(p,job,"full-key.tsv");char *r=load(p,&n);if(!strstr(r,"NET_CHECK\tobservations=")||!strstr(r,"mode=table-equals-network"))die("validation marker");hash(r,n,h);char *v=keycopy(s,"receipt_sha");if(strcmp(h,v)||!strstr(s,"\trc=0\tclaim=table-equals-network\n"))die("validation receipt changed");free(r);free(v);free(s);}
static long elapsed(const char *dir,const char *file){char p[16384];path(p,dir,file);size_t n;char *s=load(p,&n);text(s,n);if(!strstr(s,"\trc=0\n"))die("phase rc");char *v=keycopy(s,"elapsed_ms");long ms=num(v);free(v);free(s);return ms;}
static void profileproof(const char *job,const char *id,char h[3][65],long ms[3]){char p[16384];path(p,job,"profile.tsv");size_t n;char *s=load(p,&n);text(s,n);if(strncmp(s,"NET_BUILD_PROFILE\t",18)||!strstr(s,"\nPROFILE_COMPLETE\tmodels=1\tfull_key_validation=NOT_EXECUTED\n"))die("completed one-model profile");char *row=strstr(s,"\nNET\t");if(!row||strstr(row+1,"\nNET\t"))die("profile NET uniqueness");row++;char *end=strchr(row,'\n');if(!end)die("profile NET LF");*end=0;char *v[16];if(split(row,v)!=10||strcmp(v[0],"NET")||strcmp(v[1],id)||strcmp(v[9],"rc=0"))die("profile model identity");const char *timing[]={"gen_ms","tbl_ms","net_ms"},*sha[]={"gen_sha","tbl_sha","net_sha"};for(int i=0;i<3;i++){ms[i]=num(value(v[i+2],timing[i]));if(strcmp(value(v[i+6],sha[i]),h[i]))die("profile artifact SHA");}free(s);}
/* A comparison proof is specific to this frozen run and this controller binary.
 * Aggregation rechecks small metadata and artifact stat identities, not gigabytes
 * of payload again. The caller must keep the run immutable between these stages. */
static char self_exe[16384];
static long wide(const char *s){if(!*s||(s[0]=='0'&&s[1]))die("proof integer");long n=0;for(;*s;s++){if(*s<'0'||*s>'9'||n>(9223372036854775807L-(*s-'0'))/10)die("proof integer range");n=n*10+*s-'0';}return n;}
static void statfile(const char *p,struct stat *s){if(lstat(p,s)||!S_ISREG(s->st_mode)||s->st_size<0)die("proof regular artifact");}
static int samestat(const struct stat *a,const struct stat *b){return a->st_dev==b->st_dev&&a->st_ino==b->st_ino&&a->st_size==b->st_size&&a->st_mtime==b->st_mtime&&a->st_ctime==b->st_ctime;}
static void window(const char *dir,char root[16384],char digest[65],char ah[65],char bh[65],char ph[65]){
 if(!realpath(dir,root)||strpbrk(root,"\t\r\n"))die("canonical run path");char profile[16384],checker[16384];cached(dir,"profile",profile);cached(dir,"checker",checker);
 const char *names[]={"before.tsv","after.tsv","plan.tsv","baseline-index.tsv","material.tsv","mutation.tsv","profile-cache.tsv","checker-cache.tsv","profile.exe","checker.exe",0};char data[8192],p[16384],h[65];int used=snprintf(data,sizeof data,"FROZEN_RUN_COMPARE_V1\nrun=%s\n",root);for(int i=0;names[i];i++){path(p,dir,names[i]);filehash(p,h);if(i==0)(cx_fmt(ah, sizeof ah, "%s", h) ? exit(2) : (void)0);if(i==1)(cx_fmt(bh, sizeof bh, "%s", h) ? exit(2) : (void)0);if(i==2)(cx_fmt(ph, sizeof ph, "%s", h) ? exit(2) : (void)0);int z=snprintf(data+used,sizeof data-used,"%s=%s\n",names[i],h);if(z<0||z>=(int)sizeof data-used)die("window bound");used+=z;}
 path(p,repo,"tools/net-incremental-rehearsal.cx");filehash(p,h);used+=snprintf(data+used,sizeof data-used,"controller_source=%s\n",h);filehash(self_exe,h);used+=snprintf(data+used,sizeof data-used,"controller_exe=%s\n",h);if(used>=(int)sizeof data)die("window bound");hash(data,used,digest);
 path(p,dir,"plan.tsv");size_t n;char *s=load(p,&n),*a=keycopy(s,"before_sha"),*b=keycopy(s,"after_sha");if(strcmp(a,ah)||strcmp(b,bh))die("window plan identity");free(a);free(b);free(s);
}
typedef struct {char bytes[65536];long n;} Part;
static void stamp(Part *p,const char *tag,const char *file,const char *sha){struct stat s;statfile(file,&s);int z=snprintf(p->bytes+p->n,sizeof p->bytes-p->n,"%s\tpath=%s\tsha=%s\tdev=%lu\tino=%lu\tbytes=%ld\tmtime=%ld\tctime=%ld\n",tag,file,sha,(unsigned long)s.st_dev,(unsigned long)s.st_ino,(long)s.st_size,(long)s.st_mtime,(long)s.st_ctime);if(z<0||z>=(int)sizeof p->bytes-p->n)die("part size");p->n+=z;}
static void metadata(Part *p,const char *file){char h[65];filehash(file,h);stamp(p,"META",file,h);}
static void locations(const char *root,int index,char id[160],char full[16384],char left[16384],char **baseline){model(root,index,id);char leaf[100];(cx_fmt(leaf, sizeof leaf, "full-%02d", index) ? exit(2) : (void)0);path(full,root,leaf);*baseline=indexrow(root,index);char identity[300];(cx_fmt(identity, sizeof identity, "BASELINE\t%d\t%s\t", index, id) ? exit(2) : (void)0);if(strncmp(*baseline,identity,strlen(identity)))die("baseline model identity");if(affected(id)){(cx_fmt(leaf, sizeof leaf, "incremental-%02d", index) ? exit(2) : (void)0);path(left,root,leaf);}else{char *d=keycopy(*baseline,"dir");if(strlen(d)>=16384)die("baseline path");(cx_fmt(left, sizeof left, "%s", d) ? exit(2) : (void)0);free(d);}}
static int metapaths(const char *full,const char *left,int changed,char paths[10][16384]){const char *names[]={"profile.tsv","full-key.tsv","validation-bind.tsv","build-time.tsv","validation-time.tsv"};int n=0;for(int j=0;j<5;j++)path(paths[n++],full,names[j]);if(changed)for(int j=0;j<5;j++)path(paths[n++],left,names[j]);else path(paths[n++],left,"profile.tsv");return n;}
static void compare_one(const char *dir,int index){
 char root[16384],w[65],ah[65],bh[65],ph[65];window(dir,root,w,ah,bh,ph);char id[160],full[16384],left[16384],*row;locations(root,index,id,full,left,&row);int changed=affected(id);Part out={0};out.n=snprintf(out.bytes,sizeof out.bytes,"COMPARE_PART\tversion=1\tindex=%d\tnet=%s\tmode=%s\twindow_sha=%s\tclaim=frozen-run-stage-proof\n",index,id,changed?"rebuilt":"reused",w);
 char lh[3][65],rh[3][65],lp[3][16384],rp[3][16384],leaf[300];const char *kind[]={"gen","tbl","net"},*ext[]={"json","tbl","net"},*keys[]={"gen_sha","tbl_sha","net_sha"};struct stat ls[3],rs[3];
 for(int j=0;j<3;j++){(cx_fmt(leaf, sizeof leaf, "%s-%s/result.%s", kind[j], id, ext[j]) ? exit(2) : (void)0);path(lp[j],left,leaf);path(rp[j],full,leaf);statfile(lp[j],ls+j);statfile(rp[j],rs+j);size_t ln,rn;char *l=load(lp[j],&ln),*r=load(rp[j],&rn);if(ln!=rn||memcmp(l,r,ln))die("shard bytes differ");hash(l,ln,lh[j]);hash(r,rn,rh[j]);if(strcmp(lh[j],rh[j]))die("shard SHA mismatch");free(l);free(r);if(!changed){char *h=keycopy(row,keys[j]);if(strcmp(lh[j],h))die("baseline artifact changed");free(h);}}
 long fp[3],ip[3]={0};profileproof(full,id,rh,fp);requirevalidation(root,full,rp[1],rp[2]);if(changed){profileproof(left,id,lh,ip);requirevalidation(root,left,lp[1],lp[2]);}
 for(int side=0;side<2;side++)for(int j=0;j<3;j++){const char *p=side?rp[j]:lp[j];struct stat now;statfile(p,&now);if(!samestat(&now,side?rs+j:ls+j))die("artifact changed during comparison");char tag[100];(cx_fmt(tag, sizeof tag, "ARTIFACT\t%s\t%s", side?"right":"left", kind[j]) ? exit(2) : (void)0);stamp(&out,tag,p,side?rh[j]:lh[j]);}
 char mp[10][16384];int nm=metapaths(full,left,changed,mp);for(int j=0;j<nm;j++){if(!changed&&j==5){char h[65];filehash(mp[j],h);char *expected=keycopy(row,"profile_sha");if(strcmp(h,expected))die("baseline profile changed");free(expected);}metadata(&out,mp[j]);}
 long ib=changed?elapsed(left,"build-time.tsv"):0,iv=changed?elapsed(left,"validation-time.tsv"):0,fb=elapsed(full,"build-time.tsv"),fv=elapsed(full,"validation-time.tsv");int z=snprintf(out.bytes+out.n,sizeof out.bytes-out.n,"TIMING\tinc_build=%ld\tinc_validate=%ld\tfull_build=%ld\tfull_validate=%ld\tinc_gen=%ld\tinc_tbl=%ld\tinc_net=%ld\tfull_gen=%ld\tfull_tbl=%ld\tfull_net=%ld\n",ib,iv,fb,fv,ip[0],ip[1],ip[2],fp[0],fp[1],fp[2]);if(z<0||z>=(int)sizeof out.bytes-out.n)die("part timing size");out.n+=z;char body[65];hash(out.bytes,out.n,body);z=snprintf(out.bytes+out.n,sizeof out.bytes-out.n,"COMPARE_COMPLETE\tindex=%d\tartifacts=6\tmetadata=%d\tbody_sha=%s\tstate=BYTE_EQUAL_FULLKEY_BOUND\n",index,nm,body);if(z<0||z>=(int)sizeof out.bytes-out.n)die("part footer size");out.n+=z;char final[16384];(cx_fmt(leaf, sizeof leaf, "compare-%02d.tsv", index) ? exit(2) : (void)0);path(final,root,leaf);save(final,out.bytes,out.n);printf("COMPARE_SAVED\tindex=%d\tnet=%s\twindow_sha=%s\tstate=BYTE_EQUAL_FULLKEY_BOUND\n",index,id,w);
}
static void checkstamp(char **v,int n,int offset,const char *expected,int rehash,char h[65]){if(n!=offset+7)die("proof stamp fields");if(strcmp(value(v[offset],"path"),expected))die("proof artifact path");char *want=value(v[offset+1],"sha");hex(want);(cx_fmt(h, sizeof h, "%s", want) ? exit(2) : (void)0);struct stat s;statfile(expected,&s);if(wide(value(v[offset+2],"dev"))!=(long)s.st_dev||wide(value(v[offset+3],"ino"))!=(long)s.st_ino||wide(value(v[offset+4],"bytes"))!=(long)s.st_size||wide(value(v[offset+5],"mtime"))!=(long)s.st_mtime||wide(value(v[offset+6],"ctime"))!=(long)s.st_ctime)die("frozen artifact stat changed");if(rehash){char actual[65];filehash(expected,actual);if(strcmp(actual,want))die("proof metadata SHA");}}
static void report(const char *dir,const char *output){
 char root[16384],w[65],ah[65],bh[65],ph[65];window(dir,root,w,ah,bh,ph);char *result=malloc(65536);if(!result)die("allocation");long used=0,total[10]={0};struct stat proofstats[42];
 for(int i=0;i<42;i++){
  char id[160],full[16384],left[16384],*row,leaf[300],file[16384];locations(root,i,id,full,left,&row);int changed=affected(id);(cx_fmt(leaf, sizeof leaf, "compare-%02d.tsv", i) ? exit(2) : (void)0);path(file,root,leaf);statfile(file,proofstats+i);for(int j=0;j<i;j++)if(proofstats[j].st_dev==proofstats[i].st_dev&&proofstats[j].st_ino==proofstats[i].st_ino)die("duplicate proof inode");size_t n;char *s=load(file,&n);if(n>65536)die("proof size");text(s,n);char proofsha[65];hash(s,n,proofsha);char *footer=strstr(s,"\nCOMPARE_COMPLETE\t");if(!footer)die("proof footer missing");footer++;char body[65];hash(s,footer-s,body);char *p=s,*v[16];int count=split(line(&p),v);if(count!=7||strcmp(v[0],"COMPARE_PART")||strcmp(v[1],"version=1")||num(value(v[2],"index"))!=i||strcmp(value(v[3],"net"),id)||strcmp(value(v[4],"mode"),changed?"rebuilt":"reused")||strcmp(value(v[5],"window_sha"),w)||strcmp(v[6],"claim=frozen-run-stage-proof"))die("proof run/index/tool identity");
  const char *kind[]={"gen","tbl","net"},*ext[]={"json","tbl","net"};char hashes[2][3][65];for(int side=0;side<2;side++)for(int j=0;j<3;j++){count=split(line(&p),v);if(count!=10||strcmp(v[0],"ARTIFACT")||strcmp(v[1],side?"right":"left")||strcmp(v[2],kind[j]))die("proof artifact order");(cx_fmt(leaf, sizeof leaf, "%s-%s/result.%s", kind[j], id, ext[j]) ? exit(2) : (void)0);path(file,side?full:left,leaf);checkstamp(v,count,3,file,0,hashes[side][j]);if(side&&strcmp(hashes[0][j],hashes[1][j]))die("proof equality");}
  char mp[10][16384],h[65];int nm=metapaths(full,left,changed,mp);for(int j=0;j<nm;j++){count=split(line(&p),v);if(count!=8||strcmp(v[0],"META"))die("proof metadata order");checkstamp(v,count,1,mp[j],1,h);}
  const char *timing[]={"inc_build","inc_validate","full_build","full_validate","inc_gen","inc_tbl","inc_net","full_gen","full_tbl","full_net"};count=split(line(&p),v);if(count!=11||strcmp(v[0],"TIMING"))die("proof timing schema");for(int j=0;j<10;j++){long t=wide(value(v[j+1],timing[j]));if(!changed&&(j==0||j==1||j==4||j==5||j==6)&&t)die("reused timing");if(t>1000000000||total[j]>9223372036854775807L-t)die("timing bound");total[j]+=t;}
  count=split(line(&p),v);if(count!=6||strcmp(v[0],"COMPARE_COMPLETE")||num(value(v[1],"index"))!=i||strcmp(v[2],"artifacts=6")||num(value(v[3],"metadata"))!=nm||strcmp(value(v[4],"body_sha"),body)||strcmp(v[5],"state=BYTE_EQUAL_FULLKEY_BOUND")||*p)die("proof complete/trailing");struct stat after;(cx_fmt(leaf, sizeof leaf, "compare-%02d.tsv", i) ? exit(2) : (void)0);path(file,root,leaf);statfile(file,&after);if(!samestat(proofstats+i,&after))die("proof changed during aggregation");
  int z=snprintf(result+used,65536-used,"MATCH\t%d\t%s\tmode=%s\tgen_sha=%s\ttbl_sha=%s\tnet_sha=%s\tproof_sha=%s\tfull_key=FROZEN_RUN_STAGE_BOUND\n",i,id,changed?"rebuilt":"reused",hashes[1][0],hashes[1][1],hashes[1][2],proofsha);if(z<0||z>=65536-used)die("report size");used+=z;free(s);
 }
 char header[1500];int hn=snprintf(header,sizeof header,"INCREMENTAL_REPORT\tversion=2\tbefore_sha=%s\tafter_sha=%s\tplan_sha=%s\twindow_sha=%s\tcomparison=frozen-run-shards-v1\tincremental_models=3\tfull_models=42\treused_models=39\n",ah,bh,ph,w);char tail[1000];int tn=snprintf(tail,sizeof tail,"REHEARSAL_COMPLETE\tmodels=42\tbyte_equal=42\tincremental_build_ms=%ld\tfull_build_ms=%ld\tincremental_validate_ms=%ld\tfull_validate_ms=%ld\tincremental_gen_ms=%ld\tincremental_tbl_ms=%ld\tincremental_net_ms=%ld\tfull_gen_ms=%ld\tfull_tbl_ms=%ld\tfull_net_ms=%ld\tstate=VERIFIED_FROZEN_RUN_SHARDS\n",total[0],total[2],total[1],total[3],total[4],total[5],total[6],total[7],total[8],total[9]);if(hn<0||hn>=(int)sizeof header||tn<0||tn>=(int)sizeof tail)die("report text size");char *all=malloc(hn+used+tn);if(!all)die("allocation");mm_copy(all, hn, header, hn);mm_copy(all+hn, used, result, used);mm_copy(all+hn+used, tn, tail, tn);save(output,all,hn+used+tn);fwrite(tail,1,tn,stdout);free(all);free(result);
}

static void batch(const char *dir,const char *mode,int index,const char *gen,const char *tbl,const char *net,int validate){if(strcmp(mode,"full")&&strcmp(mode,"incremental"))die("mode");char id[160];model(dir,index,id);if(!strcmp(mode,"incremental")&&!affected(id))die("incremental only changed nets");char root[16384],out[16384],leaf[300],com[16384],tool[16384];path(root,dir,"root");(cx_fmt(leaf, sizeof leaf, "%s-%02d", mode, index) ? exit(2) : (void)0);path(out,dir,leaf);path(com,repo,"unisacc.com");long start=sy_now_ms();np_result r;
 if(!validate){char cg[16384],ct[16384],cn[16384];configured(dir,cg,ct,cn);if(strcmp(gen,cg)||strcmp(tbl,ct)||strcmp(net,cn))die("build constructor configuration");cached(dir,"profile",tool);char numbuf[30];(cx_fmt(numbuf, sizeof numbuf, "%d", index) ? exit(2) : (void)0);char *a[]={tool,"--root",root,"--out",out,"--gen",(char *)gen,"--tbl",(char *)tbl,"--net",(char *)net,"--start",numbuf,"--count","1",0};r=run(a,repo,40);}
 else{char table[16384],network[16384];(cx_fmt(leaf, sizeof leaf, "tbl-%s/result.tbl", id) ? exit(2) : (void)0);path(table,out,leaf);(cx_fmt(leaf, sizeof leaf, "net-%s/result.net", id) ? exit(2) : (void)0);path(network,out,leaf);cached(dir,"checker",tool);char *a[]={tool,table,network,0};r=run(a,repo,40);if(!r.out||!strstr(r.out,"NET_CHECK\tobservations=")||!strstr(r.out,"mode=table-equals-network"))die("full-key marker");char receipt[16384];path(receipt,out,"full-key.tsv");save(receipt,r.out,r.outn);validationstamp(out,table,network,tool,r.out,r.outn);}
 long elapsed=sy_now_ms()-start;char receipt[16384],record[1000];path(receipt,out,validate?"validation-time.tsv":"build-time.tsv");int n=snprintf(record,sizeof record,"REHEARSAL_PHASE\tmode=%s\tindex=%d\tnet=%s\tphase=%s\telapsed_ms=%ld\trc=0\n",mode,index,id,validate?"full-key":"build",elapsed);save(receipt,record,n);np_free(&r);fwrite(record,1,n,stdout);}
int main(int argc,char **argv){if(!realpath(".",repo))die("repository");if(!realpath(argv[0],self_exe))die("controller executable path");if(argc==4&&!strcmp(argv[1],"compare")){compare_one(argv[2],num(argv[3]));return 0;}if(argc==4&&!strcmp(argv[1],"cache")){cache(argv[2],argv[3]);return 0;}if(argc==7&&!strcmp(argv[1],"configure")){configure(argv[2],argv[3],argv[4],argv[5],argv[6]);return 0;}if(argc==4&&!strcmp(argv[1],"report")){report(argv[2],argv[3]);return 0;}if(argc==5&&!strcmp(argv[1],"build")){char g[16384],t[16384],n[16384];configured(argv[2],g,t,n);batch(argv[2],argv[3],num(argv[4]),g,t,n,0);return 0;}if(argc==4&&!strcmp(argv[1],"prepare")){prepare(argv[2],argv[3]);return 0;}if(argc==4&&!strcmp(argv[1],"snapshot")){if(strcmp(argv[3],"before")&&strcmp(argv[3],"after"))die("snapshot phase");snapshot(argv[2],!strcmp(argv[3],"before")?"before.tsv":"after.tsv");return 0;}if(argc==3&&!strcmp(argv[1],"mutate")){mutate(argv[2]);return 0;}if(argc==5&&!strcmp(argv[1],"plan")){plan(argv[2],argv[3],argv[4]);return 0;}if(argc==8&&!strcmp(argv[1],"build")){batch(argv[2],argv[3],num(argv[4]),argv[5],argv[6],argv[7],0);return 0;}if(argc==5&&!strcmp(argv[1],"validate")){batch(argv[2],argv[3],num(argv[4]),0,0,0,1);return 0;}die("prepare SOURCE NEW_RUN | snapshot RUN before|after | mutate RUN | plan BEFORE AFTER NEW_PLAN | build RUN MODE INDEX GEN TBL NET | validate RUN MODE INDEX");return 2;}
