/* tools/check-textx-isotime.cx -- ext/textx/isotime.cx: tm_iso8601_ms (toISOString text) and tm_parse_iso8601.
 *   sh ./unisacc.com tools/check-textx-isotime.cx [-- --cases fixed;prop;jsdiff;mutc;mut1;mut2;mut3]
 *   fixed   hand-written expectations from the ES rules and known JS values (0, 1700000000000, -1, the
 *           +-8.64e15 limits, years 0 / -1 / 9999 / 10000, the 1900 / 2000 / 2100 leap rule, cap and NUL
 *           handling, ERANGE) and parse accept / reject cases (zone forms, fraction digits, 24:00, ranges)
 *   prop    no JS needed: 20000 seeded random epochs round-trip parse(fmt(x)) == x; adjacent epochs inside
 *           years 0..9999 give strictly increasing strings (strcmp); leap days 1600..2400 exist exactly by the
 *           Gregorian rule and the day after Feb 28 is 1 or 2 days later
 *   jsdiff  byte comparison against reference text produced by JavaScript, read from
 *           tests/fixtures/textx-isotime/format.tsv (EPOCHMS<TAB>toISOString() or RANGEERR) and parse.tsv
 *           (ISO text<TAB>Date.parse() epoch ms or NaN). The check never starts bun or node. When the fixture
 *           is absent the group prints UNMEASURED and FAILS (no batch is registered for it until it exists).
 *   mut1-3  a private copy of ext/textx/isotime.cx with one line mutated (century rule, floor of negative
 *           ms, extended year sign) must make the fixed group fail on the named case; the unmutated copy must
 *           pass (control: case mutc).
 * Prints PASS/FAIL per case and CHECK_TEXTX_ISOTIME<TAB>failed=N; exit 0 only when N is 0. */
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use text.text
#pragma unisa use text.num
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use testx.check
#pragma unisa use cxlib.muthelp
#pragma unisa use textx.isotime

#define TMAX 8640000000000000LL
static char o1[64], o2[64];
static unsigned long long rs = 20261121ULL;
static unsigned long long rnd(void) { rs ^= rs << 13; rs ^= rs >> 7; rs ^= rs << 17; return rs; }
static long long rn(long long n) { return (long long)(rnd() % (unsigned long long)n); }

static void fmt_is(long long ms, const char *want, const char *name) {
    int r; int n = (int)strlen(want);
    memset(o1, 0xEE, sizeof o1);
    r = tm_iso8601_ms(o1, 40, ms);
    if (!tk_ok(r == n && !memcmp(o1, want, (size_t)n) && o1[n] == 0, name)) {
        if (r >= 0) { o1[r] = 0; printf("  got %s want %s\n", o1, want); } else printf("  got rc=%d want %s\n", r, want);
    }
}
static void parse_is(const char *s, long long want, int bad, const char *name) {
    long long v = 12345; int r = tm_parse_iso8601(s, &v);
    int ok = bad ? (r == -EINVAL && v == 12345) : (r == 0 && v == want);
    if (!tk_ok(ok, name)) printf("  s=%s rc=%d got=%lld want=%lld\n", s, r, v, bad ? 0LL : want);
}
/* parse S, format back, the text must equal S */
static void rt_is(const char *s, const char *name) {
    long long v = 0; int r = tm_parse_iso8601(s, &v);
    int n = r == 0 ? tm_iso8601_ms(o1, 40, v) : -1;
    if (!tk_ok(r == 0 && n == (int)strlen(s) && !memcmp(o1, s, (size_t)n), name)) printf("  s=%s rc=%d\n", s, r);
}

static void group_fixed(void) {
    int r, i; long long v;
    fmt_is(0, "1970-01-01T00:00:00.000Z", "fmt-0");
    fmt_is(1700000000000LL, "2023-11-14T22:13:20.000Z", "fmt-1700000000000");
    fmt_is(-1, "1969-12-31T23:59:59.999Z", "fmt-neg-1ms");
    fmt_is(-86400001LL, "1969-12-30T23:59:59.999Z", "fmt-neg-day-1ms");
    fmt_is(1, "1970-01-01T00:00:00.001Z", "fmt-1");
    fmt_is(TMAX, "+275760-09-13T00:00:00.000Z", "fmt-ext-year-max");
    fmt_is(-TMAX, "-271821-04-20T00:00:00.000Z", "fmt-ext-year-min");
    fmt_is(-62167219200000LL, "0000-01-01T00:00:00.000Z", "fmt-year-0");
    fmt_is(-62167219200001LL, "-000001-12-31T23:59:59.999Z", "fmt-ext-year");
    fmt_is(253402300799999LL, "9999-12-31T23:59:59.999Z", "fmt-year-9999-end");
    fmt_is(253402300800000LL, "+010000-01-01T00:00:00.000Z", "fmt-ext-year-10000");
    fmt_is(951782400000LL, "2000-02-29T00:00:00.000Z", "fmt-2000-leap-day");
    fmt_is(951868800000LL, "2000-03-01T00:00:00.000Z", "fmt-2000-mar1");
    fmt_is(-2203977600000LL, "1900-02-28T00:00:00.000Z", "fmt-1900-feb28");
    fmt_is(-2203891200000LL, "1900-03-01T00:00:00.000Z", "fmt-1900-mar1-no-leap");
    fmt_is(4107542400000LL, "2100-03-01T00:00:00.000Z", "fmt-2100-mar1-no-leap");
    r = tm_iso8601_ms(o1, 40, TMAX + 1); tk_ok(r == -ERANGE, "fmt-range-high");
    r = tm_iso8601_ms(o1, 40, -TMAX - 1); tk_ok(r == -ERANGE, "fmt-range-low");
    r = tm_iso8601_ms(o1, 40, (long long)0x7FFFFFFFFFFFFFFFULL); tk_ok(r == -ERANGE, "fmt-range-int64-max");
    memset(o1, 0xEE, sizeof o1);
    r = tm_iso8601_ms(o1, 23, 0); tk_ok(r == -ENOSPC && (unsigned char)o1[0] == 0xEE, "fmt-cap-23-nospc");
    r = tm_iso8601_ms(o1, 24, 0); tk_ok(r == 24 && (unsigned char)o1[24] == 0xEE, "fmt-cap-24-no-nul");
    r = tm_iso8601_ms(o1, 25, 0); tk_ok(r == 24 && o1[24] == 0, "fmt-cap-25-nul");
    r = tm_iso8601_ms(o1, 26, TMAX); tk_ok(r == -ENOSPC, "fmt-ext-cap-26-nospc");
    r = tm_iso8601_ms(o1, 27, TMAX); tk_ok(r == 27, "fmt-ext-cap-27");
    r = tm_iso8601_ms(0, 40, 0); tk_ok(r == -ENOSPC, "fmt-null-out");

    parse_is("1970", 0, 0, "parse-year");
    parse_is("1970-01", 0, 0, "parse-year-month");
    parse_is("1970-01-01", 0, 0, "parse-date-utc");
    parse_is("2023-11-14T22:13:20Z", 1700000000000LL, 0, "parse-sec-z");
    parse_is("2023-11-14T22:13:20.000Z", 1700000000000LL, 0, "parse-ms-z");
    parse_is("2023-11-14T22:13Z", 1699999980000LL, 0, "parse-min-z");
    parse_is("2023-11-14T23:13:20+01:00", 1700000000000LL, 0, "parse-plus-zone");
    parse_is("2023-11-14T16:43:20-05:30", 1700000000000LL, 0, "parse-minus-zone");
    parse_is("1970-01-01T00:00:00.5Z", 500, 0, "parse-frac-1");
    parse_is("1970-01-01T00:00:00.12Z", 120, 0, "parse-frac-2");
    parse_is("1970-01-01T00:00:00.123456Z", 123, 0, "parse-frac-6-truncated");
    parse_is("1970-01-01T24:00Z", 86400000, 0, "parse-24-00");
    parse_is("1970-01-01T24:00:00.000Z", 86400000, 0, "parse-24-00-00-000");
    parse_is("1969-12-31T23:59:59.999Z", -1, 0, "parse-neg-1ms");
    parse_is("+275760-09-13T00:00:00.000Z", TMAX, 0, "parse-ext-max");
    parse_is("-271821-04-20T00:00:00.000Z", -TMAX, 0, "parse-ext-min");
    parse_is("+001970-01-01", 0, 0, "parse-ext-form-1970");
    parse_is("0000-01-01T00:00:00Z", -62167219200000LL, 0, "parse-year-0");
    parse_is("+275760-09-13T00:00:00.001Z", 0, 1, "parse-over-max");
    parse_is("-271821-04-19T23:59:59.999Z", 0, 1, "parse-under-min");
    parse_is("-000000-01-01T00:00:00Z", 0, 1, "parse-minus-zero-year");
    parse_is("2023-02-30", 0, 1, "parse-feb-30");
    parse_is("2023-02-29", 0, 1, "parse-feb-29-non-leap");
    parse_is("2023-13-01", 0, 1, "parse-month-13");
    parse_is("2023-00-10", 0, 1, "parse-month-0");
    parse_is("2023-01-00", 0, 1, "parse-day-0");
    parse_is("2023-04-31", 0, 1, "parse-apr-31");
    parse_is("1970-01-01T00:00:00", 0, 1, "parse-time-no-zone");
    parse_is("1970-01-01T00:00", 0, 1, "parse-time-hm-no-zone");
    parse_is("1970-01-01Z", 0, 1, "parse-date-zone");
    parse_is("1970-01-01T25:00Z", 0, 1, "parse-hour-25");
    parse_is("1970-01-01T24:00:01Z", 0, 1, "parse-24-00-01");
    parse_is("1970-01-01T24:00:00.001Z", 0, 1, "parse-24-00-00-001");
    parse_is("1970-01-01T10:60Z", 0, 1, "parse-minute-60");
    parse_is("1970-01-01T10:00:60Z", 0, 1, "parse-second-60");
    parse_is("1970-01-01T10:00:00.Z", 0, 1, "parse-frac-empty");
    parse_is("1970-01-01T10:00+24:00", 0, 1, "parse-zone-24");
    parse_is("1970-01-01T10:00+05:60", 0, 1, "parse-zone-min-60");
    parse_is("1970-01-01T10:00+0530", 0, 1, "parse-zone-no-colon");
    parse_is("1970-01-01t00:00z", 0, 1, "parse-lowercase");
    parse_is("1970-01-01 00:00Z", 0, 1, "parse-space-sep");
    parse_is(" 1970", 0, 1, "parse-leading-space");
    parse_is("1970-01-01 ", 0, 1, "parse-trailing-space");
    parse_is("1970-01-01T00:00Zx", 0, 1, "parse-trailing-byte");
    parse_is("197", 0, 1, "parse-short-year");
    parse_is("19700", 0, 1, "parse-5-digit-year");
    parse_is("1970-1-1", 0, 1, "parse-1-digit-fields");
    parse_is("", 0, 1, "parse-empty");
    parse_is("T10:00Z", 0, 1, "parse-time-only");
    parse_is("1970-01-01T", 0, 1, "parse-empty-time");
    parse_is("+1970-01-01", 0, 1, "parse-4-digit-signed-year");
    r = tm_parse_iso8601(0, &v); tk_ok(r == -EINVAL, "parse-null-s");
    r = tm_parse_iso8601("1970", 0); tk_ok(r == -EINVAL, "parse-null-out");

    parse_is("2000-02-29", 951782400000LL, 0, "leap-2000");
    parse_is("2024-02-29", 1709164800000LL, 0, "leap-2024");
    parse_is("1900-02-29", 0, 1, "leap-century-1900");
    parse_is("2100-02-29", 0, 1, "leap-century-2100");
    rt_is("0000-01-01T00:00:00.000Z", "rt-year-0");
    rt_is("-000001-01-01T00:00:00.000Z", "rt-year-minus-1");
    rt_is("+010000-12-31T23:59:59.999Z", "rt-year-10000");
    rt_is("-000400-02-29T12:34:56.789Z", "rt-year-minus-400-leap");
    rt_is("9999-12-31T23:59:59.999Z", "rt-year-9999");
    i = 0; (void)i;
}

static int leap(int y) { return (y % 4 == 0 && y % 100 != 0) || y % 400 == 0; }

static void group_prop(void) {
    long long i, bad = 0, first = -1, x, y, v; int n, r;
    char a[40], b[40];
    for (i = 0; i < 20000; i++) {
        long long k = rn(5);
        if (k == 0) x = rn(2 * TMAX + 1) - TMAX;
        else if (k == 1) x = rn(200000000000000LL) - 100000000000000LL;
        else if (k == 2) x = rn(8000000000LL) - 4000000000LL;
        else if (k == 3) x = (rn(2) ? 1 : -1) * (rn(3000) * 86400000LL + rn(3) - 1);
        else x = rn(20000000000000LL) - 10000000000000LL;
        n = tm_iso8601_ms(o1, 40, x);
        r = n > 0 ? tm_parse_iso8601(o1, &v) : -1;
        if (n < 24 || r != 0 || v != x) { bad++; if (first < 0) first = i; }
    }
    printf("PROP\troundtrip\tn=20000\tbad=%lld\n", bad);
    tk_ok(bad == 0, "prop-roundtrip-20000");
    bad = 0;
    for (i = 0; i < 20000; i++) {
        x = rn(253402300799999LL + 62167219200000LL) - 62167219200000LL;
        y = x + 1 + (rn(2) ? rn(2000) : rn(1000000000000LL));
        if (y > 253402300799999LL) y = 253402300799999LL;
        if (y <= x) continue;
        tm_iso8601_ms(a, 40, x); tm_iso8601_ms(b, 40, y);
        if (strcmp(a, b) >= 0) bad++;
    }
    printf("PROP\tmonotone\tbad=%lld\n", bad);
    tk_ok(bad == 0, "prop-monotone-strings");
    bad = 0;
    for (i = 1600; i <= 2400; i++) {
        long long f28, m1; int has;
        cx_fmt(a, sizeof a, "%04lld-02-29", i); has = tm_parse_iso8601(a, &v) == 0;
        cx_fmt(a, sizeof a, "%04lld-02-28", i); tm_parse_iso8601(a, &f28);
        cx_fmt(a, sizeof a, "%04lld-03-01", i); tm_parse_iso8601(a, &m1);
        if (has != leap((int)i) || m1 - f28 != (leap((int)i) ? 2 : 1) * 86400000LL) bad++;
    }
    printf("PROP\tleapdays\tbad=%lld\n", bad);
    tk_ok(bad == 0, "prop-leap-days-1600-2400");
}

static long long atoll_(const char *s, const char *e) {
    long long v = 0; int neg = 0;
    if (s < e && *s == '-') { neg = 1; s++; }
    for (; s < e; s++) v = v * 10 + (*s - '0');
    return neg ? -v : v;
}

static void group_jsdiff(void) {
    static const char *fp = "tests/fixtures/textx-isotime/format.tsv", *pp = "tests/fixtures/textx-isotime/parse.tsv";
    size_t n = 0, i; char *src; long cnt = 0, bad = 0;
    if (sy_exists(fp) != 1 || sy_exists(pp) != 1) {
        printf("UNMEASURED\tjsdiff\tfixture absent: %s, %s\n", fp, pp);
        tk_ok(0, "jsdiff-fixture-present");
        return;
    }
    src = cx_read(fp, &n);
    for (i = 0; src && i < n; ) {
        size_t e = i, t = i; long long ms; int r;
        while (e < n && src[e] != '\n') e++;
        while (t < e && src[t] != '\t') t++;
        if (t >= e) break;
        ms = atoll_(src + i, src + t);
        r = tm_iso8601_ms(o1, 40, ms);
        cnt++;
        if (e - t - 1 == 8 && !memcmp(src + t + 1, "RANGEERR", 8)) { if (r != -ERANGE) { if (!bad++) printf("  first diff ms=%lld want RANGEERR\n", ms); } }
        else if (r != (int)(e - t - 1) || memcmp(o1, src + t + 1, (size_t)r)) { if (!bad++) printf("  first diff ms=%lld\n", ms); }
        i = e + 1;
    }
    printf("JSDIFF\tformat\tn=%ld\tdiff=%ld\n", cnt, bad);
    tk_ok(src && cnt >= 1000 && bad == 0, "jsdiff-format");
    src = cx_read(pp, &n); cnt = 0; bad = 0;
    for (i = 0; src && i < n; ) {
        size_t e = i, t = i; long long v = 12345, want; int r, isnan; char s[256];
        while (e < n && src[e] != '\n') e++;
        while (t < e && src[t] != '\t') t++;
        if (t >= e || t - i >= sizeof s) break;
        if (mm_copy(s, sizeof s, src + i, (long)(t - i))) break; s[t - i] = 0;
        isnan = (e - t - 1 == 3 && !memcmp(src + t + 1, "NaN", 3));
        want = isnan ? 0 : atoll_(src + t + 1, src + e);
        r = tm_parse_iso8601(s, &v);
        cnt++;
        if (isnan ? (r != -EINVAL) : (r != 0 || v != want)) { if (!bad++) printf("  first diff s=%s want=%s%lld rc=%d got=%lld\n", s, isnan ? "NaN" : "", want, r, v); }
        i = e + 1;
    }
    printf("JSDIFF\tparse\tn=%ld\tdiff=%ld\n", cnt, bad);
    tk_ok(src && cnt >= 200 && bad == 0, "jsdiff-parse");
}

/* ---- mutation: private copy of the package source with one line changed ---- */
static char work[4096], com[4400], root[4096];
static int setup(const char *old, const char *nw) {
    char lk[4400], p[4400]; char *src, *dst; size_t n, i, k = 0, ln;
    if (!mh_put_mut(root, work, "ext/textx/isotime.cx", old, nw)) return 0;
    if (!mh_put_mut(root, work, "tools/check-textx-isotime.cx", "", "")) return 0;
    if (cx_fmt(lk, sizeof lk, "%s/r", work)) return 0;
    if (sy_exists(lk) != 1 && sy_symlink(root, lk)) return 0;
    if (cx_fmt(p, sizeof p, "%s/cxroot.tsv", root)) return 0;
    src = cx_read(p, &n);
    if (!src || !(dst = mm_alloc((long)n * 2 + 64))) return 0;
    i = 0;
    while (i < n) {   /* each line; R rows other than textx get the r/ link prefix on DIR */
        size_t e = i, t1 = 0, t2 = 0;
        while (e < n && src[e] != '\n') { if (src[e] == '\t') { if (!t1) t1 = e; else if (!t2) t2 = e; } e++; }
        ln = e - i;
        if (ln > 2 && src[i] == 'R' && src[i + 1] == '\t' && t2 && !(t2 - (i + 2) == 5 && !memcmp(src + i + 2, "textx", 5))) {
            mh_copy(dst + k, src + i, (long)(t2 + 1 - i)); k += t2 + 1 - i;
            dst[k++] = 'r'; dst[k++] = '/';
            mh_copy(dst + k, src + t2 + 1, (long)(e - t2 - 1)); k += e - t2 - 1;
        } else { mh_copy(dst + k, src + i, (long)ln); k += ln; }
        if (e < n) dst[k++] = '\n';
        i = e + 1;
    }
    dst[k] = 0;
    return tk_write(work, "cxroot.tsv", dst) == 0;
}
static int child(void) {
    char probe[4400]; char *av[] = { "sh", com, probe, "--", "--cases", "fixed", 0 };
    if (cx_fmt(probe, sizeof probe, "%s/tools/check-textx-isotime.cx", work)) return -1;
    return tk_run(av, 0, 55000);
}
static void group_mut(int part) {
    int rc;
    if (tk_scratch("check-textx-isotime", work, sizeof work)) { tk_ok(0, "mut-scratch"); return; }
    if (part == 0) {
        if (setup("", "")) { rc = child(); tk_ok(rc == 0 && tk_has(tk_out(), "PASS\tfmt-0"), "mut-control-unmutated-passes"); }
        else tk_ok(0, "mut-control-setup");
    }
    if (part == 1) {
        if (setup("if (y % 100 == 0) return 0;", "if (y % 100 == 1) return 0;")) {
            rc = child(); tk_ok(rc == 1 && tk_has(tk_out(), "FAIL\tleap-century-1900"), "mut-century-rule-detected");
        } else tk_ok(0, "mut-century-setup");
    }
    if (part == 2) {
        if (setup("if ((a % b) != 0 && ((a < 0) != (b < 0))) q--;", "if (0) q--;")) {
            rc = child(); tk_ok(rc == 1 && tk_has(tk_out(), "FAIL\tfmt-neg-1ms"), "mut-negative-floor-detected");
        } else tk_ok(0, "mut-floor-setup");
    }
    if (part == 3) {
        if (setup("out[at++] = y < 0 ? '-' : '+';", "out[at++] = '+';")) {
            rc = child(); tk_ok(rc == 1 && tk_has(tk_out(), "FAIL\tfmt-ext-year-min"), "mut-ext-year-sign-detected");
        } else tk_ok(0, "mut-extyear-setup");
    }
}

int main(int argc, char **argv) {
    tk_begin("");
    tk_cases_init(argc, argv);
    if (sy_cwd(root, sizeof root) < 0 || cx_fmt(com, sizeof com, "%s/unisacc.com", root)) return 2;
    if (tk_case("fixed")) group_fixed();
    if (tk_case("prop")) group_prop();
    if (tk_case("jsdiff")) group_jsdiff();
    if (tk_case("mutc")) group_mut(0);
    if (tk_case("mut1")) group_mut(1);
    if (tk_case("mut2")) group_mut(2);
    if (tk_case("mut3")) group_mut(3);
    return tk_end("CHECK_TEXTX_ISOTIME", 0);
}
