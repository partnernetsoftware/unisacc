/* check-ape-need.cx -- the launcher that tools/ape-pack.cx writes must refuse a too small address space by name.
 *
 *   sh ./unisacc.com tools/check-ape-need.cx --          (repo root; batch form, builds everything it needs)
 *
 * ape-pack --need KB adds a ulimit -v precheck to the shell head. It has two heads: the plain one and the
 * managed one (--cache-manager-osx, the one every released unisacc.com carries). From 2026-11-08 the managed
 * head left with a bare "exit 2", so a product under ulimit -v 40000 exited 2 with an empty stderr and the
 * run-reserve and compile-as-limit batches lost their "run: out of memory" line. This check packs both heads
 * around a tiny product-built program and runs them.
 *
 *   A1 both packs are written.
 *   A2 both shell heads carry the named refusal next to the exit.
 *   A3 under ulimit -v 40000 (below --need 53248): exit 2, empty stdout, stderr has "run: out of memory".
 *   A4 under ulimit -v 60000 and with no limit: the slice runs (exit 7) and stderr has no refusal.
 *
 * The launcher cache is pointed at the work directory (XDG_CACHE_HOME); nothing is written elsewhere.
 * Last line CHECK_APE_NEED assertions=N failed=M; any FAIL exits 1.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.env
#pragma unisa use sys.posix

static int ck_failed, ck_asserts;
static char ck_root[4096];

static void ck_die(const char *s) { fprintf(stderr, "check-ape-need: %s\n", s); exit(2); }

static void ck_ck(int ok, const char *label) {
    ck_asserts++;
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", label);
    if (!ok) ck_failed++;
}

static int ck_contains(const char *hay, size_t n, const char *needle) {
    size_t m = strlen(needle), i;
    if (!m || n < m) return 0;
    for (i = 0; i + m <= n; i++) if (!memcmp(hay + i, needle, m)) return 1;
    return 0;
}

static void ck_path(char *out, size_t cap, const char *dir, const char *name) {
    if (snprintf(out, cap, "%s/%s", dir, name) >= (int)cap) ck_die("path");
}

/* run argv in the repo root; rc 0 wanted */
static void ck_build(char **av, const char *label) {
    np_result r;
    char why[1024];
    if (np_run(av, ck_root, 0, 55, &r, why, sizeof why)) ck_die(why);
    if (r.rc != 0) fprintf(stderr, "--- %s rc=%d ---\n%.*s", label, r.rc, (int)r.errn, r.err ? r.err : "");
    ck_ck(r.rc == 0, label);
    np_free(&r);
}

/* run PACK through sh with the launcher cache in CACHE, after "ulimit -v LIMIT" when LIMIT is given */
static void ck_launch(const char *pack, const char *cache, const char *limit, np_result *r) {
    char script[256], why[1024];
    char *av[6];
    if (limit) { if (snprintf(script, sizeof script, "ulimit -v %s; XDG_CACHE_HOME=\"$1\"; export XDG_CACHE_HOME; exec sh \"$0\"", limit) >= (int)sizeof script) ck_die("script"); }
    else if (snprintf(script, sizeof script, "XDG_CACHE_HOME=\"$1\"; export XDG_CACHE_HOME; exec sh \"$0\"") >= (int)sizeof script) ck_die("script");
    av[0] = "sh"; av[1] = "-c"; av[2] = script; av[3] = (char *)pack; av[4] = (char *)cache; av[5] = 0;
    if (np_run(av, ck_root, 0, 55, r, why, sizeof why)) ck_die(why);
}

static void ck_pack_cases(const char *kind, const char *pack, const char *cache) {
    char label[128];
    np_result r;
    size_t n = 0;
    char *text = cx_read(pack, &n);
    if (snprintf(label, sizeof label, "A1.%s.pack-written", kind) >= (int)sizeof label) ck_die("label");
    ck_ck(text && n > 0, label);
    if (snprintf(label, sizeof label, "A2.%s.head-names-the-refusal", kind) >= (int)sizeof label) ck_die("label");
    ck_ck(text && ck_contains(text, n, "echo \"run: out of memory\" >&2; exit 2;"), label);
    free(text);

    ck_launch(pack, cache, "40000", &r);
    if (snprintf(label, sizeof label, "A3.%s.low-named-refusal", kind) >= (int)sizeof label) ck_die("label");
    if (!(r.rc == 2 && !r.outn && r.errn && ck_contains(r.err, r.errn, "run: out of memory")))
        fprintf(stderr, "note\t%s low: rc=%d outn=%ld err=[%.*s]\n", kind, r.rc, (long)r.outn, (int)r.errn, r.err ? r.err : "");
    ck_ck(r.rc == 2 && !r.outn && r.errn && ck_contains(r.err, r.errn, "run: out of memory"), label);
    np_free(&r);

    ck_launch(pack, cache, "60000", &r);
    if (snprintf(label, sizeof label, "A4.%s.above-need-runs", kind) >= (int)sizeof label) ck_die("label");
    if (!(r.rc == 7 && !ck_contains(r.err ? r.err : "", r.errn, "out of memory")))
        fprintf(stderr, "note\t%s 60000: rc=%d err=[%.*s]\n", kind, r.rc, (int)r.errn, r.err ? r.err : "");
    ck_ck(r.rc == 7 && !ck_contains(r.err ? r.err : "", r.errn, "out of memory"), label);
    np_free(&r);

    ck_launch(pack, cache, 0, &r);
    if (snprintf(label, sizeof label, "A4.%s.unlimited-runs", kind) >= (int)sizeof label) ck_die("label");
    if (!(r.rc == 7 && !ck_contains(r.err ? r.err : "", r.errn, "out of memory")))
        fprintf(stderr, "note\t%s unlimited: rc=%d err=[%.*s]\n", kind, r.rc, (int)r.errn, r.err ? r.err : "");
    ck_ck(r.rc == 7 && !ck_contains(r.err ? r.err : "", r.errn, "out of memory"), label);
    np_free(&r);
}

int main(int argc, char **argv) {
    char work[4096], src[4400], elf[4400], pe[4400], dummy[4400], managed[4400], plain[4400], cache[4400];
    (void)argv;
    if (argc != 1) ck_die("usage: no arguments (repo root)");
    if (!getcwd(ck_root, sizeof ck_root)) ck_die("getcwd");
    if (snprintf(work, sizeof work, "%s/unisacc-affected-apeneed-%d", sy_tmpdir(), (int)getpid()) >= (int)sizeof work) ck_die("path");
    if (mkdir(work, 0700)) ck_die("work directory must be new");
    ck_path(src, sizeof src, work, "seven.c"); ck_path(elf, sizeof elf, work, "seven"); ck_path(pe, sizeof pe, work, "seven.exe");
    ck_path(dummy, sizeof dummy, work, "dummy.bin"); ck_path(managed, sizeof managed, work, "managed.com");
    ck_path(plain, sizeof plain, work, "plain.com"); ck_path(cache, sizeof cache, work, "cache");
    if (cx_write(src, "int main(void){return 7;}\n", 26)) ck_die("write seven.c");
    if (cx_write(dummy, "dummy\n", 6)) ck_die("write dummy.bin");
    if (mkdir(cache, 0700)) ck_die("cache directory");

    {   char *av[] = {"sh", "./unisacc.com", "-O1", src, "-o", elf, 0};
        ck_build(av, "A0a.build-lnx-slice");
    }
    {   char *av[] = {"sh", "./unisacc.com", "-b", "win/x86_64", src, "-o", pe, 0};
        ck_build(av, "A0b.build-win-slice");
    }
    {   char *av[] = {"sh", "./unisacc.com", "tools/ape-pack.cx", "--", "--cache-manager-osx", dummy, dummy, "--tool", "unisacc",
                      "--need", "53248", "--deflate", managed, pe, elf, dummy, dummy, dummy, 0};
        ck_build(av, "A0c.pack-managed-head");
    }
    {   char *av[] = {"sh", "./unisacc.com", "tools/ape-pack.cx", "--", "--tool", "unisacc",
                      "--need", "53248", "--deflate", plain, pe, elf, dummy, dummy, dummy, 0};
        ck_build(av, "A0d.pack-plain-head");
    }
    ck_pack_cases("managed", managed, cache);
    ck_pack_cases("plain", plain, cache);

    if (sy_remove_all(work)) fprintf(stderr, "note\twork directory not removed: %s\n", work);
    printf("CHECK_APE_NEED\tassertions=%d\tfailed=%d\n", ck_asserts, ck_failed);
    return ck_failed ? 1 : 0;
}
