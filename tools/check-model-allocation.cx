/* Exhaustive allocation-failure injection for one minimal model load. */
#pragma unisa use runtime.process
static void die(const char *s){fprintf(stderr,"model-allocation: %s\n",s);exit(2);}
static np_result call(char **v,const char *root){np_result r={0};char why[512];if(np_run(v,root,0,35,&r,why,sizeof why))die(why);return r;}
int main(void){
 char root[4096],bound[4400],src[4400],mod[4400],num[4400],inc[4400],old[512],fresh[512],both[512],obj[512],nobj[512];
 char tmp[]="/tmp/cx-model-alloc-XXXXXX";if(!realpath(".",root)||!mkdtemp(tmp))die("setup");
 if(cx_fmt(bound,sizeof bound,"%s/tools/bound",root)||cx_fmt(src,sizeof src,"%s/tests/cases/model_allocation_failure.c",root)||cx_fmt(mod,sizeof mod,"%s/cx/runtime/model_lifetime.cx",root)||cx_fmt(num,sizeof num,"%s/cx/runtime/model_number.cx",root)||cx_fmt(inc,sizeof inc,"%s/include/cx.h",root)||cx_fmt(old,sizeof old,"%s/old",tmp)||cx_fmt(fresh,sizeof fresh,"%s/fresh",tmp)||cx_fmt(both,sizeof both,"%s/both",tmp)||cx_fmt(obj,sizeof obj,"%s/lifetime.o",tmp)||cx_fmt(nobj,sizeof nobj,"%s/number.o",tmp))die("path");
 char *cc="/usr/bin/x86_64-linux-gnu-gcc-11";
 char *a[]={bound,"30",cc,"-O2","-x","c","-include",inc,"-c",mod,"-o",obj,0};np_result r=call(a,root);if(r.rc||r.errn)die("module-build");np_free(&r);
 char *b[]={bound,"30",cc,"-O0","-w","-ffunction-sections","-fdata-sections","-Wl,--gc-sections",src,"-o",old,0};r=call(b,root);if(r.rc||r.errn)die("c-build");np_free(&r);
 char *c[]={bound,"30",cc,"-O0","-w","-ffunction-sections","-fdata-sections","-Wl,--gc-sections","-DUNISA_CX_MODEL_LIFETIME",src,obj,"-o",fresh,0};r=call(c,root);if(r.rc||r.errn)die("cx-build");np_free(&r);
 char *d[]={bound,"30",cc,"-O2","-x","c","-include",inc,"-c",num,"-o",nobj,0};r=call(d,root);if(r.rc||r.errn)die("number-build");np_free(&r);
 char *e[]={bound,"30",cc,"-O0","-w","-ffunction-sections","-fdata-sections","-Wl,--gc-sections","-DUNISA_CX_MODEL_LIFETIME","-DUNISA_CX_MODEL_NUMBER",src,obj,nobj,"-o",both,0};r=call(e,root);if(r.rc||r.errn)die("combined-build");np_free(&r);
 char *x[]={bound,"10",old,0},*y[]={bound,"10",fresh,0};np_result p=call(x,root),q=call(y,root);
 const char *want="MODEL_ALLOCATION_FAILURE failures=0 complete=1 injected=20\n";size_t n=strlen(want);
 int ok=!p.rc&&!q.rc&&!p.errn&&!q.errn&&p.outn==n&&q.outn==n&&!memcmp(p.out,want,n)&&!memcmp(q.out,want,n);
 char *z[]={bound,"10",both,0};np_result t=call(z,root);ok=ok&&!t.rc&&!t.errn&&t.outn==n&&!memcmp(t.out,want,n);if(!ok&&t.outn)fwrite(t.out,1,t.outn,stderr);np_free(&t);
 if(!ok){if(p.outn)fwrite(p.out,1,p.outn,stderr);if(q.outn)fwrite(q.out,1,q.outn,stderr);}
 printf("%s\tpartial-allocation-cleanup\nCXMODEL_ALLOCATION\tfailed=%d\n",ok?"PASS":"FAIL",!ok);
 np_free(&p);np_free(&q);if(cx_rmtree(tmp))die("cleanup");return ok?0:1;
}
