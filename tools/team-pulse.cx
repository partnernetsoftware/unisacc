/* tools/team-pulse.cx -- read-only stall/context pulse over orchestrated agent windows.
 *
 *   sh ./unisacc.com tools/team-pulse.cx -- [--windows-table PATH] [--stall-min N]
 *       [--fixture FILE] [--tail-lines K] [--mutant-no-stall]
 *
 * Windows table (default skills/unisacc-orch-supervise/team-windows.tsv):
 *   window model lane write_prefix   (write_prefix may be comma-separated path prefixes)
 *
 * Live: tmux capture-pane -p -t WINDOW. Fixture: === PANE NAME === panels (observe-agents style).
 * tmux missing/fail -> status UNKNOWN. Read-only: no mail, no window mutation.
 *
 * Output: PULSE<TAB>window<TAB>status<TAB>ctx_pct<TAB>commit<TAB>age_min<TAB>flags
 * then TEAM_PULSE<TAB>windows=W<TAB>stalled=S<TAB>ctx_low=C<TAB>filtered=F */
#pragma unisa use cxlib.ckrun
#pragma unisa use cxlib.procrun
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.time
#pragma unisa use sys.env
#pragma unisa use text.text
#pragma unisa use text.num
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use sys.posix

#define TP_MAXW 32
#define TP_CAP (1 << 16)

typedef struct {
    char window[64], model[64], lane[32], prefix[512];
} Win;
static Win g_w[TP_MAXW];
static int g_nw, g_stall_min = 45, g_tail = 80, g_mutant;
static char g_table[1100], g_fix[1100];
static long g_now;
static int g_n_stalled, g_n_ctxlow, g_n_filtered;

static int die(const char *m) { fprintf(stderr, "team-pulse: %s\n", m); return 2; }

static int load_table(const char *path) {
    unsigned char *b; int64_t n; long i = 0, row = 0;
    if (sy_read_file(path, &b, &n, 1 << 20) < 0 || !b) return die("read windows-table");
    while (i < n && g_nw < TP_MAXW) {
        long s = i, e, c1 = -1, c2 = -1, c3 = -1, j;
        while (i < n && b[i] != '\n') i++;
        e = i; if (i < n) i++;
        if (e > s && b[s] == '#') continue;
        if (e == s) continue;
        row++;
        if (row == 1) continue;
        for (j = s; j < e; j++) {
            if (b[j] != '\t') continue;
            if (c1 < 0) c1 = j;
            else if (c2 < 0) c2 = j;
            else if (c3 < 0) { c3 = j; break; }
        }
        if (c1 < 0 || c2 < 0 || c3 < 0) { mm_free(b); return die("bad windows-table row"); }
        if (c1 - s >= (long)sizeof g_w[0].window || c2 - c1 >= (long)sizeof g_w[0].model ||
            c3 - c2 >= (long)sizeof g_w[0].lane || e - c3 >= (long)sizeof g_w[0].prefix) {
            mm_free(b); return die("windows-table field too long");
        }
        mm_copy(g_w[g_nw].window, (long)sizeof g_w[0].window, b + s, c1 - s); g_w[g_nw].window[c1 - s] = 0;
        mm_copy(g_w[g_nw].model, (long)sizeof g_w[0].model, b + c1 + 1, c2 - c1 - 1); g_w[g_nw].model[c2 - c1 - 1] = 0;
        mm_copy(g_w[g_nw].lane, (long)sizeof g_w[0].lane, b + c2 + 1, c3 - c2 - 1); g_w[g_nw].lane[c3 - c2 - 1] = 0;
        mm_copy(g_w[g_nw].prefix, (long)sizeof g_w[0].prefix, b + c3 + 1, e - c3 - 1); g_w[g_nw].prefix[e - c3 - 1] = 0;
        g_nw++;
    }
    mm_free(b);
    return g_nw > 0 ? 0 : die("windows-table empty");
}

static long tail_text(const char *src, long sn, int k, char *dst, long cap) {
    long i, cuts = 0, start;
    if (sn < 0) sn = 0;
    for (i = sn; i > 0 && cuts < k; ) { i--; if (src[i] == '\n') cuts++; }
    start = (cuts >= k) ? i + 1 : 0;
    if (sn - start >= cap) sn = start + cap - 1;
    if (sn > start) mm_copy(dst, cap, src + start, sn - start);
    dst[sn - start] = 0;
    return sn - start;
}

static int has_ci(const char *s, long n, const char *needle) {
    long nl = tx_len(needle, 128), i, j;
    if (nl <= 0 || n < nl) return 0;
    for (i = 0; i + nl <= n; i++) {
        for (j = 0; j < nl; j++) {
            char a = s[i + j], b = needle[j];
            if (a >= 'A' && a <= 'Z') a = (char)(a - 'A' + 'a');
            if (b >= 'A' && b <= 'Z') b = (char)(b - 'A' + 'a');
            if (a != b) break;
        }
        if (j == nl) return 1;
    }
    return 0;
}

static const char *classify(const char *text, long n, int *ctx_pct) {
    char t[TP_CAP]; long tn, i;
    *ctx_pct = -1;
    tn = tail_text(text, n, g_tail, t, sizeof t);
    for (i = 0; i + 2 < tn; i++) {
        if (t[i] >= '0' && t[i] <= '9') {
            long j = i, v = 0;
            while (j < tn && t[j] >= '0' && t[j] <= '9') { v = v * 10 + (t[j] - '0'); j++; if (v > 100) break; }
            if (j < tn && t[j] == '%' && v <= 100) {
                long b = i > 40 ? i - 40 : 0;
                if (has_ci(t + b, i - b, "context") || has_ci(t + b, i - b, "left")) { *ctx_pct = (int)v; break; }
            }
        }
    }
    if (has_ci(t, tn, "this content can not be shown") || has_ci(t, tn, "content filtered") ||
        has_ci(t, tn, "content can not be shown")) return "FILTERED";
    if (has_ci(t, tn, "esc to cancel") || has_ci(t, tn, "working")) return "WORKING";
    if (has_ci(t, tn, "waiting for input") || has_ci(t, tn, "do you want to")) return "WAITING_INPUT";
    {
        long at = 0; int saw_prompt = 0;
        while (at < tn) {
            long s = at, e, k;
            while (at < tn && t[at] != '\n') at++;
            e = at; if (at < tn) at++;
            k = s; while (k < e && (t[k] == ' ' || t[k] == '\t')) k++;
            if (k < e && t[k] == '>' && k + 1 == e) saw_prompt = 1;
        }
        if (saw_prompt) return "IDLE";
    }
    return "UNKNOWN";
}

static int capture_tmux(const char *window, char *out, long cap, long *outn) {
    char *av[] = {"tmux", "capture-pane", "-p", "-t", (char *)window, "-S", "-80", 0};
    pr_result r; int rc;
    *outn = 0; out[0] = 0;
    rc = pr_run("team-pulse-tmux", av, 0, 0, 15, &r);
    if (rc != 0 || r.rc != 0) { pr_free(&r); return -1; }
    if (r.outn > 0 && r.out) {
        long n = (long)r.outn < cap - 1 ? (long)r.outn : cap - 1;
        mm_copy(out, cap, r.out, n); out[n] = 0; *outn = n;
    }
    pr_free(&r);
    return 0;
}

static int fixture_get(const char *path, const char *window, char *out, long cap, long *outn) {
    unsigned char *b; int64_t n; long i = 0; char mark[120];
    *outn = 0; out[0] = 0;
    if (cx_fmt(mark, sizeof mark, "=== PANE %s ===", window)) return -1;
    if (sy_read_file(path, &b, &n, 1 << 22) < 0 || !b) return -1;
    while (i < n) {
        long s = i, e, ml = tx_len(mark, sizeof mark);
        while (i < n && b[i] != '\n') i++;
        e = i; if (i < n) i++;
        if (e - s == ml && tx_same((const char *)b + s, e - s, mark, ml)) {
            long body = i, end = n, j;
            for (j = i; j < n; ) {
                long ls = j, le;
                while (j < n && b[j] != '\n') j++;
                le = j; if (j < n) j++;
                if (le - ls >= 10 && tx_prefix((const char *)b + ls, le - ls, "=== PANE ", 9)) { end = ls; break; }
            }
            if (end - body >= cap) end = body + cap - 1;
            if (end > body) mm_copy(out, cap, b + body, end - body);
            out[end - body] = 0; *outn = end - body;
            mm_free(b); return 0;
        }
    }
    mm_free(b); return -1;
}

static int latest_commit(const char *prefixes, char *hash, long hcap, long *age_min) {
    char pref[512]; long best_ct = -1; char best_h[80]; char *p;
    hash[0] = 0; *age_min = -1; best_h[0] = 0;
    if (cx_fmt(pref, sizeof pref, "%s", prefixes)) return -1;
    for (p = pref; ; ) {
        char *tok = p, script[1400], out[400]; int rc; long ct = 0;
        while (*p && *p != ',') p++;
        if (*p) { *p = 0; p++; } else p = 0;
        while (*tok == ' ') tok++;
        if (tok[0]) {
            char h[80]; long i = 0, j = 0;
            if (cx_fmt(script, sizeof script, "git log -1 --format='%%H %%ct' -- '%s' 2>/dev/null", tok)) return -1;
            out[0] = 0;
            rc = ckk_sh_t("team-pulse-git", script, out, (int)sizeof out, 20);
            if (rc == 0 && out[0]) {
                while (out[i] && out[i] != ' ' && out[i] != '\t' && j + 1 < (long)sizeof h) h[j++] = out[i++];
                h[j] = 0;
                while (out[i] == ' ' || out[i] == '\t') i++;
                ct = 0; while (out[i] >= '0' && out[i] <= '9') { ct = ct * 10 + (out[i] - '0'); i++; }
                if (h[0] && ct > best_ct) { best_ct = ct; if (cx_fmt(best_h, sizeof best_h, "%s", h)) return -1; }
            }
        }
        if (!p) break;
    }
    if (best_ct < 0 || !best_h[0]) return 0;
    if (cx_fmt(hash, hcap, "%s", best_h)) return -1;
    *age_min = g_now > best_ct ? (g_now - best_ct) / 60 : 0;
    return 0;
}

static void flags_add(char *flags, long cap, int *nflag, const char *f) {
    if (*nflag) {
        if (*nflag + 1 < cap) { flags[*nflag] = ','; (*nflag)++; flags[*nflag] = 0; }
    }
    { long fl = tx_len(f, 32); long room = cap - 1 - *nflag; if (fl > room) fl = room;
      if (fl > 0) { mm_copy(flags + *nflag, cap - *nflag, f, fl); *nflag += fl; flags[*nflag] = 0; } }
}

static void pulse_one(Win *w) {
    char capbuf[TP_CAP], hash[80], flags[80], ctxs[16], ages[24];
    long n = 0, age = -1; int ctx = -1, nflag = 0;
    const char *st;
    if (g_fix[0]) {
        if (fixture_get(g_fix, w->window, capbuf, sizeof capbuf, &n)) {
            printf("PULSE\t%s\tUNKNOWN\t-\t-\t-\t-\n", w->window); return;
        }
    } else if (capture_tmux(w->window, capbuf, sizeof capbuf, &n)) {
        printf("PULSE\t%s\tUNKNOWN\t-\t-\t-\t-\n", w->window); return;
    }
    st = classify(capbuf, n, &ctx);
    latest_commit(w->prefix, hash, sizeof hash, &age);
    flags[0] = 0;
    if (!g_mutant && tx_eqz(st, "IDLE") && age >= 0 && age >= g_stall_min) {
        flags_add(flags, sizeof flags, &nflag, "STALLED"); g_n_stalled++;
    }
    if (ctx >= 0 && ctx < 15) { flags_add(flags, sizeof flags, &nflag, "CTX_LOW"); g_n_ctxlow++; }
    if (tx_eqz(st, "FILTERED")) { flags_add(flags, sizeof flags, &nflag, "FILTERED"); g_n_filtered++; }
    if (!flags[0]) { flags[0] = '-'; flags[1] = 0; }
    if (ctx >= 0) cx_fmt(ctxs, sizeof ctxs, "%d", ctx); else cx_fmt(ctxs, sizeof ctxs, "-");
    if (age >= 0) cx_fmt(ages, sizeof ages, "%ld", age); else cx_fmt(ages, sizeof ages, "-");
    printf("PULSE\t%s\t%s\t%s\t%s\t%s\t%s\n", w->window, st, ctxs, hash[0] ? hash : "-", ages, flags);
}

int main(int argc, char **argv) {
    int i, a = 1;
    g_table[0] = 0; g_fix[0] = 0;
    g_now = sy_wall_s();
    while (a < argc) {
        if (tx_eqz(argv[a], "--windows-table") && a + 1 < argc) {
            if (cx_fmt(g_table, sizeof g_table, "%s", argv[++a])) return die("table path");
        } else if (tx_eqz(argv[a], "--fixture") && a + 1 < argc) {
            if (cx_fmt(g_fix, sizeof g_fix, "%s", argv[++a])) return die("fixture path");
        } else if (tx_eqz(argv[a], "--stall-min") && a + 1 < argc) {
            g_stall_min = (int)tx_strtol(argv[++a], 0, 10); if (g_stall_min < 1) return die("stall-min");
        } else if (tx_eqz(argv[a], "--tail-lines") && a + 1 < argc) {
            g_tail = (int)tx_strtol(argv[++a], 0, 10); if (g_tail < 5 || g_tail > 500) return die("tail-lines");
        } else if (tx_eqz(argv[a], "--mutant-no-stall")) g_mutant = 1;
        else if (tx_eqz(argv[a], "--now") && a + 1 < argc) g_now = tx_strtol(argv[++a], 0, 10);
        else return die("usage: [--windows-table P] [--stall-min N] [--fixture F] [--tail-lines K] [--mutant-no-stall]");
        a++;
    }
    if (!g_table[0]) {
        if (cx_fmt(g_table, sizeof g_table, "skills/unisacc-orch-supervise/team-windows.tsv")) return die("default table");
    }
    if (load_table(g_table)) return 2;
    for (i = 0; i < g_nw; i++) pulse_one(&g_w[i]);
    printf("TEAM_PULSE\twindows=%d\tstalled=%d\tctx_low=%d\tfiltered=%d\n", g_nw, g_n_stalled, g_n_ctxlow, g_n_filtered);
    return 0;
}
