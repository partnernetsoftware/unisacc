/* Build the self-contained entry candidate.
   usage: ROOT P3 OUT [CONSTRUCTOR] [--o1-drivers] [--target T] [--only KEY]... [--link-only]
   ROOT is the tree. P3 is a file whose trailer is the package to append
   (the installed unisacc.com is the usual source). OUT is a directory.
   CONSTRUCTOR defaults to ROOT/unisacc.com and is started with sh.
   An explicit CONSTRUCTOR is executed directly.
   Default compile level is -O1 for drive.o, host.o, driveface.o,
   driveroute.o, cxmod.o and tapegate.o, and -O2 for every other object.
   --o1-drivers is accepted and selects the same six. --target sets
   the compiler -b value. Omitted, it stays lnx/x86_64. --only KEY
   (repeatable) compiles just those objects and does not link.
   --objects-only compiles all roots and planned closures without linking;
   follow it with --link-only against the same frozen inputs and OUT.
   --closure-list prints the exact mN.o/source plan without compiling/linking.
   --closure-only KEY (repeatable) compiles only those planned mN.o objects.
   --link-only never compiles: every root and closure must have a matching
   OUT/KEY.cache (conservative raw source/header tree, compiler/package, flags,
   SHA and bytes). Missing or stale entries are refused by object name.
   Full builds and split invocations use the same plan; keep inputs frozen.
   Identity seals raw include/src/cx/ext trees once before and after each
   phase; no preprocessing subprocess is used. Split/thin launchers are
   refused: use a bare native constructor with P3 or a packaged constructor.
   Listing does not alter receipt.txt; closure shards append to that receipt.
   Each compile and the link runs under ROOT/tools/bound. The candidate
   is OUT/candidate. The receipt is OUT/receipt.txt. This does not replace
   ROOT/unisacc.com and does not call the old construction scripts.
   One object per small closure. drive is src/unisacc.cx.
   -funit now compiles only the command-line unit; each root's `use`
   closure is planned with -cx-plan, deduplicated by sy_realpath and
   compiled once as its own -O2 object, then all objects are linked.
   This depends on the constructor's per-unit -funit semantics.
   UNISACC_RR_TIME=1. Each step keeps stderr in OUT/<name>.rr. The receipt
   records wall time and the slowest RR_TIME line (inference, inflate, or other). */
#pragma unisa use sysx.process
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.proc
#pragma unisa use sysx.poll
#pragma unisa use sys.env
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use runtime.packagefooter
#pragma unisa use sys.time
#pragma unisa use cxlib.chainfacts

/* Compile parallelism (EB_JOBS children at once). Plan and link stay serial.
   The curve measured 4.16x at 8; 16 saturates and fights the link for cores. */
#define EB_JOBS 8
#define EB_JOBS_MAX 16

static char eb_rr_env[] = "UNISACC_RR_TIME=1";

static void eb_die(const char *s) {
    fprintf(stderr, "entry-build: %s\n", s);
    exit(1);
}

static long long eb_ns(void) {
    sy_ts_t ts;
    if (sy_mono(&ts)) eb_die("clock");
    return (long long)ts.sec * 1000000000LL + (long long)ts.nsec;
}

static void eb_join(char *dst, int cap, const char *a, const char *b) {
    int n;
    n = snprintf(dst, (size_t)cap, "%s/%s", a, b);
    if (n < 0 || n >= cap) eb_die("path");
}

static void eb_sha(const char *path, char h[65], long *n) {
    size_t zn;
    char *b;
    b = cx_read(path, &zn);
    if (!b) eb_die("read");
    cx_sha256_hex(b, zn, h);
    *n = (long)zn;
    free(b);
}

static void eb_copy_tok(char *dst, int cap, const char *s) {
    int i;
    if (!dst || cap <= 0) return;
    if (!s) s = "-";
    i = 0;
    while (s[i] && i + 1 < cap) {
        char c;
        c = s[i];
        if (c == '\t' || c == '\n' || c == '\r') c = ' ';
        dst[i] = c;
        i = i + 1;
    }
    dst[i] = 0;
}

static const char *eb_find(const char *s, const char *w) {
    int i;
    int k;
    if (!s || !w) return 0;
    i = 0;
    while (s[i]) {
        k = 0;
        while (w[k] && s[i + k] == w[k]) k = k + 1;
        if (!w[k]) return s + i;
        i = i + 1;
    }
    return 0;
}

static void eb_slow(const char *path, char *kind, int kcap, char *line, int lcap, long long *ns) {
    FILE *f;
    char buf[768];
    eb_copy_tok(kind, kcap, "UNMEASURED");
    eb_copy_tok(line, lcap, "-");
    *ns = -1;
    if (!path) return;
    f = fopen(path, "rb");
    if (!f) return;
    while (fgets(buf, (int)sizeof buf, f)) {
        const char *p;
        const char *k;
        long long v;
        if (!eb_find(buf, "RR_TIME")) continue;
        p = eb_find(buf, "ns=");
        if (!p) continue;
        p = p + 3;
        if (*p == '-') p = p + 1;
        if (*p < '0' || *p > '9') continue;
        v = 0;
        while (*p >= '0' && *p <= '9') {
            v = v * 10 + (long long)(*p - '0');
            p = p + 1;
        }
        if (v <= *ns) continue;
        *ns = v;
        if (eb_find(buf, "inflate")) k = "inflate";
        else if (eb_find(buf, "inference")) k = "inference";
        else k = "other";
        eb_copy_tok(kind, kcap, k);
        eb_copy_tok(line, lcap, buf);
    }
    if (fclose(f)) eb_die("rr close");
}

/* Child bound: never below the stand-alone default dflt; when the chain exports
   UNISACC_CHAIN_PHASE_BOUND_S (valid 6..90) it is raised to bound-5 so a loaded
   phase is ended by the phase kill, not by a tighter inner bound. */
static int eb_secs(int dflt) {
    const char *e = sy_env("UNISACC_CHAIN_PHASE_BOUND_S");
    long v = 0;
    if (!e || !*e) return dflt;
    for (; *e; e++) {
        if (*e < '0' || *e > '9' || v > 1000) return dflt;
        v = v * 10 + (*e - '0');
    }
    if (v < 6 || v > 90) return dflt;
    return (int)(v - 5) > dflt ? (int)(v - 5) : dflt;
}

static int eb_run(char **argv, const char *cwd, int secs, long long *dt, char *why, int wl, const char *errpath) {
    np_result r;
    secs = eb_secs(secs);
    long long t0;
    int pr;
    char *envadd[2];
    FILE *ef;
    t0 = eb_ns();
    envadd[0] = eb_rr_env;
    envadd[1] = 0;
    pr = np_run(argv, cwd, envadd, secs, &r, why, (size_t)wl);
    *dt = eb_ns() - t0;
    if (!pr && errpath && r.err && r.errn) {
        ef = fopen(errpath, "wb");
        if (ef) {
            fwrite(r.err, 1, r.errn, ef);
            if (fclose(ef)) eb_die("rr close");
        }
    }
    if (pr) return -1;
    if (r.rc) {
        if (r.err && r.errn) fwrite(r.err, 1, r.errn, stderr);
        np_free(&r);
        return r.rc;
    }
    np_free(&r);
    return 0;
}

/* One -cx-plan per root, run in parallel (EB_JOBS children), then merged in
   root-index order. This keeps the closure discovery order identical to the
   serial per-root loop, unlike one -cx-plan over all roots (whose output puts
   every root first and reorders the closure). */
static int eb_plan_parallel(const char *bound, const char *ctor, int via_sh, const char **srcs, int nsrc,
                            const char *cwd, char *buf, int cap, char *why, int wl) {
    int pid[EB_JOBS_MAX];
    int fd[EB_JOBS_MAX];
    int slot_of[EB_JOBS_MAX];
    char *errb[EB_JOBS_MAX];
    long errn[EB_JOBS_MAX], errcap[EB_JOBS_MAX];
    char **outs;
    long *outn;
    int running;
    int next;
    int done;
    int i;
    int j;
    long total;
    if (nsrc < 0) return -1;
    if (nsrc == 0) return 0;
    outs = mm_alloc((long)nsrc * (long)sizeof(char *));
    outn = mm_alloc((long)nsrc * (long)sizeof(long));
    if (!outs || !outn) return -1;
    for (i = 0; i < nsrc; i++) { outs[i] = 0; outn[i] = 0; }
    for (i = 0; i < EB_JOBS_MAX; i++) { pid[i] = -1; fd[i] = -1; errb[i] = 0; errn[i] = 0; errcap[i] = 0; }
    running = 0;
    next = 0;
    done = 0;
    while (done < nsrc) {
        while (running < EB_JOBS && next < nsrc) {
            int s = -1;
            int n = 0;
            char *v[8];
            for (i = 0; i < EB_JOBS_MAX; i++) if (pid[i] < 0) { s = i; break; }
            if (s < 0) eb_die("slot");
            v[n++] = (char *)bound;
            v[n++] = "50";
            if (via_sh) v[n++] = "sh";
            v[n++] = (char *)ctor;
            v[n++] = "-cx-plan";
            v[n++] = (char *)srcs[next];
            v[n] = 0;
            {
                int ofd = -1;
                int efd = -1;
                int pr = sy_spawn_pipe(v, cwd, SY_SPAWN_NO_PATH | SY_SPAWN_STDERR_SPLIT, &ofd, &efd);
                if (pr < 0) { why[0] = 0; return -1; }
                pid[s] = pr;
                sy_close(efd);   /* drop stderr */
                fd[s] = ofd;
                if (sy_fd_nonblock(fd[s], 1)) return -1;
            }
            slot_of[s] = next;
            errn[s] = 0;
            next = next + 1;
            running = running + 1;
        }
        {
            sy_pollfd_t pf[EB_JOBS_MAX];
            int np = 0;
            int map[EB_JOBS_MAX];
            for (i = 0; i < EB_JOBS_MAX; i++) if (pid[i] >= 0) { pf[np].fd = fd[i]; pf[np].events = 1; pf[np].revents = 0; map[np] = i; np = np + 1; }
            {
                int pr = sy_poll(pf, np, 100);
                if (pr < 0) { for (i = 0; i < EB_JOBS_MAX; i++) if (pid[i] >= 0) sy_kill(pid[i]); return -1; }
            }
            for (j = 0; j < np; j++) {
                int s = map[j];
                int job = slot_of[s];
                if (pf[j].revents & 1) {
                    for (;;) {
                        char tmp[4096];
                        long k = sy_read(fd[s], tmp, 4096);
                        if (k <= 0) break;   /* EOF or EAGAIN: stop draining this round */
                        {
                            long oc = outn[job];
                            if (oc + k + 1 > 262144) { for (i = 0; i < EB_JOBS_MAX; i++) if (pid[i] >= 0) sy_kill(pid[i]); return 2; }
                            {
                                char *g = mm_alloc(oc + k + 1);
                                if (!g) { for (i = 0; i < EB_JOBS_MAX; i++) if (pid[i] >= 0) sy_kill(pid[i]); return -1; }
                                if (oc) mm_copy(g, oc + k + 1, outs[job], oc);
                                mm_copy(g + oc, k + 1, tmp, k);
                                mm_free(outs[job]);
                                outs[job] = g;
                                outn[job] = oc + k;
                            }
                        }
                    }
                }
            }
        }
        for (i = 0; i < EB_JOBS_MAX; i++) {
            int ex = 0, code = 0;
            if (pid[i] < 0) continue;
            ex = 0;
            if (sy_wait_status(pid[i], 1, &ex, &code, 0) < 0) continue;
            if (!ex) continue;
            if (code) {
                if (errb[i] && errn[i]) fwrite(errb[i], 1, (size_t)errn[i], stderr);
                for (j = 0; j < EB_JOBS_MAX; j++) if (pid[j] >= 0) sy_kill(pid[j]);
                why[0] = 0;
                return code;
            }
            /* drain any last bytes the child wrote before it exited */
            {
                int job = slot_of[i];
                for (;;) {
                    char tmp[4096];
                    long k = sy_read(fd[i], tmp, 4096);
                    if (k <= 0) break;
                    {
                        long oc = outn[job];
                        if (oc + k + 1 > 262144) { for (j = 0; j < EB_JOBS_MAX; j++) if (pid[j] >= 0) sy_kill(pid[j]); return 2; }
                        {
                            char *g = mm_alloc(oc + k + 1);
                            if (!g) { for (j = 0; j < EB_JOBS_MAX; j++) if (pid[j] >= 0) sy_kill(pid[j]); return -1; }
                            if (oc) mm_copy(g, oc + k + 1, outs[job], oc);
                            mm_copy(g + oc, k + 1, tmp, k);
                            mm_free(outs[job]);
                            outs[job] = g;
                            outn[job] = oc + k;
                        }
                    }
                }
            }
            mm_free(errb[i]);
            errb[i] = 0;
            errn[i] = 0;
            errcap[i] = 0;
            sy_close(fd[i]);
            fd[i] = -1;
            pid[i] = -1;
            running = running - 1;
            done = done + 1;
        }
    }
    /* merge in root-index order */
    total = 0;
    for (i = 0; i < nsrc; i++) total = total + outn[i];
    if (total >= cap) { for (i = 0; i < nsrc; i++) mm_free(outs[i]); mm_free(outs); mm_free(outn); return 2; }
    {
        long at = 0;
        for (i = 0; i < nsrc; i++) {
            if (outn[i]) { mm_copy(buf + at, cap - at, outs[i], outn[i]); at = at + outn[i]; }
            mm_free(outs[i]);
        }
        buf[at] = 0;
    }
    mm_free(outs);
    mm_free(outn);
    return 0;
}

/* Six drive units that run once per build are -O1. --o1-drivers selects
   the same six. Inflate, model decode and the executor stay at -O2: -O0
   made that code about 45% slower at run time. */
static long long eb_sha_total;
static long long eb_rec_total;
static int eb_same(const char *a, const char *b) {
    int i;
    if (!a || !b) return 0;
    i = 0;
    while (a[i] && a[i] == b[i]) i = i + 1;
    return a[i] == 0 && b[i] == 0;
}

static int eb_target_ok(const char *s) {
    return eb_same(s, "lnx/x86_64") || eb_same(s, "lnx/arm64") || eb_same(s, "osx/x86_64") ||
           eb_same(s, "osx/arm64") || eb_same(s, "win/x86_64");
}

static int eb_o1_driver(const char *key) {
    return eb_same(key, "drive.o") || eb_same(key, "host.o") || eb_same(key, "driveface.o") ||
           eb_same(key, "driveroute.o") || eb_same(key, "cxmod.o") || eb_same(key, "tapegate.o");
}

/* One stdio/env state per program: drive.o (it holds main) supplies the tables, every
   other object only refers to them.  Without this each object carries a private stdout
   buffer and exit flushes only the caller's (SPEED-17 lost -cx-plan output that way). */
static int eb_have_drive;
static const char *eb_rt_for(const char *key) {
    if (!eb_have_drive) return "-DRT_DEFAULT=1";
    return eb_same(key, "drive.o") ? "-DRT_UNIT" : "-DRT_EXTERN";
}

static const char *eb_opt_for(const char *key, int o1_drivers) {
    if (o1_drivers && eb_o1_driver(key)) return "-O1";
    return "-O2";
}

static int eb_wanted(const char *key, const char **only, int only_n) {
    int k;
    if (only_n == 0) return 1;
    k = 0;
    while (k < only_n) {
        if (eb_same(key, only[k])) return 1;
        k = k + 1;
    }
    return 0;
}

static int eb_compile(const char *bound, const char *ctor, int via_sh, const char *opt, const char *triple, const char *src, const char *obj, const char *cwd, const char *errpath, long long *dt, char *why, int wl) {
    char *v[14];
    int n;
    n = 0;
    v[n++] = (char *)bound;
    v[n++] = "55";
    if (via_sh) v[n++] = "sh";
    v[n++] = (char *)ctor;
    v[n++] = (char *)opt;
    v[n++] = "-c";
    v[n++] = "-b";
    v[n++] = (char *)triple;
    v[n++] = "-funit";
    v[n++] = "-o";
    v[n++] = (char *)obj;
    v[n++] = (char *)src;
    if (n >= 14) eb_die("argv");
    v[n] = 0;
    return eb_run(v, cwd, 58, dt, why, wl, errpath);
}

/* One parallel compile job: its argv (bound 55 [sh] ctor opt -c -b triple -funit
   -o obj src), the rr path for its stderr, and where to record dt/sha/bytes. */
typedef struct eb_job {
    const char *opt;
    const char *src;
    const char *obj;
    const char *rr;
    const char *key;
    long long *dt;
    char *sha_out;
    long *bytes_out;
} eb_job;

/* Cache identity is separate from the append-only timing receipt. The
   conservative raw-tree seal covers source and header bytes, including
   comment-only changes, without relying on constructor preprocessing APIs. */
static const char *eb_package;
static char eb_plan_identity[65];
static char eb_inputs_identity[65];
static const char *eb_input_root;
static void eb_cache_fail(const char *key, const char *reason) {
    fprintf(stderr, "entry-build: REFUSE %s %s\n", key, reason);
    exit(1);
}
/* Entry-local buffer: bootstrap process helpers do not export append APIs. */
typedef struct eb_buffer { char *p; size_t n; size_t cap; } eb_buffer;
static void eb_put(eb_buffer *b, const char *s, size_t n) {
    size_t need = b->n + n + 1;
    if (need <= b->n) eb_die("identity buffer size");
    if (need > b->cap) {
        size_t cap = b->cap ? b->cap : 1024;
        char *p;
        while (cap < need) {
            if (cap > 1073741824UL) eb_die("identity buffer cap");
            cap *= 2;
        }
        p = realloc(b->p, cap);
        if (!p) eb_die("identity buffer allocation");
        b->p = p; b->cap = cap;
    }
    if (n && mm_copy(b->p + b->n, b->cap - b->n, s, n)) eb_die("identity buffer copy");
    b->n += n; b->p[b->n] = 0;
}
static void eb_puts(eb_buffer *b, const char *s) { eb_put(b, s, strlen(s)); }
#define np_put eb_put
#define np_puts eb_puts
static int eb_namecmp(const void *a, const void *b) {
    return strcmp(*(const char *const *)a, *(const char *const *)b);
}
/* Conservative raw header seal independent of optional -E line markers.
   Sort directory entries so filesystem enumeration order cannot alter it. */
static void eb_headers(eb_buffer *b, const char *path, int depth, const char *key) {
    struct stat st;
    DIR *d;
    struct dirent *e;
    char **names;
    int count = 0, cap = 32, i;
    if (depth > 48) eb_cache_fail(key, "header directory depth");
    if (lstat(path, &st)) {
        if (depth == 0 && errno == ENOENT) { eb_puts(b, path); eb_puts(b, " absent\n"); return; }
        eb_cache_fail(key, "header stat");
    }
    if (S_ISLNK(st.st_mode)) {
        char literal[2048], real[2048];
        const char *trees[4] = {"include", "src", "cx", "ext"};
        int ti, sealed = 0;
        long len = sy_readlink(path, literal, sizeof literal - 1);
        if (len < 0 || len >= (long)sizeof literal - 1 || !realpath(path, real) || stat(path, &st))
            eb_cache_fail(key, "unresolved/cyclic input symlink");
        literal[len] = 0;
        for (ti = 0; ti < 4; ti++) {
            char base[1600]; size_t n;
            eb_join(base, sizeof base, eb_input_root, trees[ti]); n = strlen(base);
            if (!strncmp(real, base, n) && (real[n] == '/' || !real[n])) sealed = 1;
        }
        if (!sealed) eb_cache_fail(key, "input symlink outside sealed trees");
        eb_puts(b, "link\n"); eb_puts(b, path); eb_puts(b, "\n");
        eb_puts(b, literal); eb_puts(b, "\n"); eb_puts(b, real); eb_puts(b, "\n");
        /* The canonical directory is already traversed by its owning tree.
           Recording aliases avoids duplicate walks and directory cycles. */
        if (S_ISDIR(st.st_mode)) return;
    }
    if (S_ISREG(st.st_mode)) {
        /* Include files need not end in .h: seal every regular input in
           the four source/header trees, not only conventional suffixes. */
        {
            char sha[65]; long bytes;
            eb_sha(path, sha, &bytes); eb_puts(b, path); eb_puts(b, "\n"); eb_puts(b, sha);
        }
        return;
    }
    if (!S_ISDIR(st.st_mode)) eb_cache_fail(key, "header nonregular input");
    d = opendir(path); if (!d) eb_cache_fail(key, "header directory open");
    names = malloc((size_t)cap * sizeof(char *)); if (!names) eb_die("header names");
    for (;;) {
        errno = 0; e = readdir(d);
        if (!e) { if (errno) eb_cache_fail(key, "header directory read"); break; }
        if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
        if (count == cap) {
            char **p; cap *= 2;
            if (cap > 65536) eb_cache_fail(key, "header directory cap");
            p = realloc(names, (size_t)cap * sizeof(char *)); if (!p) eb_die("header names"); names = p;
        }
        names[count] = strdup(e->d_name); if (!names[count]) eb_die("header name"); count++;
    }
    if (closedir(d)) eb_cache_fail(key, "header directory close");
    qsort(names, (size_t)count, sizeof(char *), eb_namecmp);
    for (i = 0; i < count; i++) {
        char child[2048]; eb_join(child, sizeof child, path, names[i]);
        eb_headers(b, child, depth + 1, key); free(names[i]);
    }
    free(names);
}
static void eb_snapshot(const char *root, const char *ctor, char h[65]) {
    eb_buffer b = {0};
    const char *trees[4] = {"include", "src", "cx", "ext"};
    int i;
    char sha[65]; long bytes;
    for (i = 0; i < 4; i++) {
        char dir[1600]; eb_join(dir, sizeof dir, root, trees[i]); eb_headers(&b, dir, 0, "inputs");
    }
    {
        char mapping[1600]; eb_join(mapping, sizeof mapping, root, "cxroot.tsv");
        eb_sha(mapping, sha, &bytes); eb_puts(&b, sha);
    }
    eb_sha(ctor, sha, &bytes); eb_puts(&b, sha);
    eb_sha(eb_package, sha, &bytes); eb_puts(&b, sha);
    eb_sha(__FILE__, sha, &bytes); eb_puts(&b, sha);
    cx_sha256_hex(b.p, b.n, h); free(b.p);
}
static void eb_stable(const char *ctor, const char *key) {
    char after[65]; eb_snapshot(eb_input_root, ctor, after);
    if (!eb_same(after, eb_inputs_identity)) eb_cache_fail(key, "inputs changed during phase");
}
static void eb_identity(const char *bound, const char *ctor, int via_sh,
                        const char *triple, const char *cwd, const char *key,
                        const char *src, const char *opt, char h[65]) {
    eb_buffer b = {0};
    eb_puts(&b, "entry-cache-v2-raw-tree\n");
    eb_puts(&b, cwd); eb_puts(&b, "\n");
    eb_puts(&b, key); eb_puts(&b, "\n");
    eb_puts(&b, src); eb_puts(&b, "\n");
    eb_puts(&b, triple); eb_puts(&b, "\n");
    eb_puts(&b, opt); eb_puts(&b, "\n-c -funit\n"); eb_puts(&b, eb_rt_for(key)); eb_puts(&b, "\n");
    eb_puts(&b, via_sh ? "sh\n" : "exec\n");
    eb_puts(&b, eb_plan_identity); eb_puts(&b, eb_inputs_identity);
    cx_sha256_hex(b.p, b.n, h); free(b.p);
}
static void eb_cache(const char *obj, const char *key, const char *identity, int save, const char *compiled_sha, long compiled_bytes) {
    char side[640], sha[65], expected[256];
    size_t n, on;
    char *old, *object;
    int len = snprintf(side, sizeof side, "%s.cache", obj);
    if (len < 0 || len >= (int)sizeof side) eb_die("cache path");
    object = cx_read(obj, &on);
    if (!object) eb_cache_fail(key, "missing object");
    cx_sha256_hex(object, on, sha); free(object);
    if (save && (!compiled_sha || compiled_bytes < 0 || on != (size_t)compiled_bytes || !eb_same(sha, compiled_sha)))
        eb_cache_fail(key, "object changed before cache commit");
    len = snprintf(expected, sizeof expected, "entry-cache-v1\nidentity=%s\nobject=%s\nbytes=%lu\n", identity, sha, (unsigned long)on);
    if (len < 0 || len >= (int)sizeof expected) eb_die("cache format");
    if (save) {
        if (cx_write(side, expected, (size_t)len)) eb_cache_fail(key, "cache write");
    } else {
        old = cx_read(side, &n);
        if (!old) eb_cache_fail(key, "missing cache identity");
        if (n != (size_t)len || memcmp(old, expected, n)) eb_cache_fail(key, "cache identity/object mismatch");
        free(old);
    }
}

/* Run up to EB_JOBS children at once; each child is still `bound 55`. Collect
   each stderr into its rr, sha the object, and record the receipt line in the
   parent. On any failure, group-kill every live child (sy_kill) and name it. */
static int eb_compile_parallel(eb_job *jobs, int njobs, const char *bound, const char *ctor,
                               int via_sh, const char *triple, const char *cwd,
                               char *why, int wl, FILE *rf, const char *line_extra) {
    int pid[EB_JOBS_MAX];
    int fd[EB_JOBS_MAX];
    int slot_of[EB_JOBS_MAX];
    long long t0[EB_JOBS_MAX];
    char *errb[EB_JOBS_MAX];
    long errn[EB_JOBS_MAX], errcap[EB_JOBS_MAX];
    int running;
    int next;
    int done;
    int i;
    int j;
    char identities[128][65];
    if (njobs < 0) return -1;
    if (njobs == 0) return 0;
    if (njobs > 128) eb_die("identity cap");
    eb_have_drive = 0;
    for (i = 0; i < njobs; i++) if (eb_same(jobs[i].key, "drive.o")) eb_have_drive = 1;
    for (i = 0; i < njobs; i++) {
        char side[640];
        eb_identity(bound, ctor, via_sh, triple, cwd, jobs[i].key, jobs[i].src, jobs[i].opt, identities[i]);
        if (cx_fmt(side, sizeof side, "%s.cache", jobs[i].obj)) eb_cache_fail(jobs[i].key, "cache path");
        if (unlink(side) && errno != ENOENT) eb_cache_fail(jobs[i].key, "cache invalidate");
    }
    for (i = 0; i < EB_JOBS_MAX; i++) { pid[i] = -1; fd[i] = -1; errb[i] = 0; errn[i] = 0; errcap[i] = 0; }
    running = 0;
    next = 0;
    done = 0;
    while (done < njobs) {
        /* spawn until the cap, then reap one round */
        while (running < EB_JOBS && next < njobs) {
            int s = -1;
            int n = 0;
            char *v[16];
            for (i = 0; i < EB_JOBS_MAX; i++) if (pid[i] < 0) { s = i; break; }
            if (s < 0) eb_die("slot");
            v[n++] = (char *)bound;
            v[n++] = "55";
            if (via_sh) v[n++] = "sh";
            v[n++] = (char *)ctor;
            v[n++] = (char *)jobs[next].opt;
            v[n++] = "-c";
            v[n++] = "-b";
            v[n++] = (char *)triple;
            v[n++] = "-funit";
            v[n++] = (char *)eb_rt_for(jobs[next].key);
            v[n++] = "-o";
            v[n++] = (char *)jobs[next].obj;
            v[n++] = (char *)jobs[next].src;
            v[n] = 0;
            {
                int ofd = -1;
                int efd = -1;
                int pr = sy_spawn_pipe(v, cwd, SY_SPAWN_NO_PATH | SY_SPAWN_STDERR_SPLIT, &ofd, &efd);
                if (pr < 0) { why[0] = 0; return -1; }
                pid[s] = pr;
                sy_close(ofd);   /* stdout is dropped */
                fd[s] = efd;
                if (sy_fd_nonblock(fd[s], 1)) return -1;
            }
            slot_of[s] = next;
            t0[s] = eb_ns();
            errn[s] = 0;
            next = next + 1;
            running = running + 1;
        }
        /* poll all live children */
        {
            sy_pollfd_t pf[EB_JOBS_MAX];
            int np = 0;
            int map[EB_JOBS_MAX];
            for (i = 0; i < EB_JOBS_MAX; i++) if (pid[i] >= 0) { pf[np].fd = fd[i]; pf[np].events = 1; pf[np].revents = 0; map[np] = i; np = np + 1; }
            if (sy_poll(pf, np, 100) < 0) { for (i = 0; i < EB_JOBS_MAX; i++) if (pid[i] >= 0) sy_kill(pid[i]); return -1; }
            for (j = 0; j < np; j++) {
                int s = map[j];
                if (pf[j].revents & 1) {
                    char tmp[4096];
                    long k = sy_read(fd[s], tmp, 4096);
                    if (k > 0) {
                        if (errn[s] + k + 1 > errcap[s]) {
                            long nc = errcap[s] ? errcap[s] * 2 : 4096;
                            char *g = mm_alloc(nc);
                            if (!g) { for (i = 0; i < EB_JOBS_MAX; i++) if (pid[i] >= 0) sy_kill(pid[i]); return -1; }
                            if (errn[s]) mm_copy(g, nc, errb[s], errn[s]);
                            mm_free(errb[s]);
                            errb[s] = g;
                            errcap[s] = nc;
                        }
                        mm_copy(errb[s] + errn[s], errcap[s] - errn[s], tmp, k);
                        errn[s] = errn[s] + k;
                    }
                }
            }
        }
        /* reap any finished child, record it, spawn the next */
        for (i = 0; i < EB_JOBS_MAX; i++) {
            int ex = 0, code = 0;
            if (pid[i] < 0) continue;
            ex = 0;
            if (sy_wait_status(pid[i], 1, &ex, &code, 0) < 0) continue;
            if (!ex) continue;
            {
                int s = i;
                int job = slot_of[s];
                long long dt = eb_ns() - t0[s];
                FILE *ef;
                if (jobs[job].dt) *(jobs[job].dt) = dt;
                if (errb[s] && errn[s]) {
                    ef = fopen(jobs[job].rr, "wb");
                    if (ef) { fwrite(errb[s], 1, (size_t)errn[s], ef); fclose(ef); }
                }
                mm_free(errb[s]);
                errb[s] = 0;
                errn[s] = 0;
                errcap[s] = 0;
                sy_close(fd[s]);
                fd[s] = -1;
                pid[s] = -1;
                running = running - 1;
                done = done + 1;
                if (code) {
                    if (errb[s]) { }
                    for (j = 0; j < EB_JOBS_MAX; j++) if (pid[j] >= 0) sy_kill(pid[j]);
                    {
                        char nm[64];
                        cx_fmt(nm, sizeof nm, "%s", jobs[job].key);
                        eb_fail_close(rf, nm, jobs[job].rr, code, dt, why);
                    }
                    return 1;
                }
                {
                    long long tsha = eb_ns();
                    eb_sha(jobs[job].obj, jobs[job].sha_out, jobs[job].bytes_out);
                    eb_sha_total += eb_ns() - tsha;
                }
                /* Sidecars are committed together only after the phase's
                   raw input seal has been remeasured below. */
                {
                    long long trec = eb_ns();
                    eb_line_slow(rf, jobs[job].key, jobs[job].sha_out, *(jobs[job].bytes_out), dt, jobs[job].rr, line_extra);
                    if (fflush(rf)) eb_die("receipt");
                    eb_rec_total += eb_ns() - trec;
                }
            }
        }
    }
    eb_stable(ctor, jobs[0].key);
    for (i = 0; i < njobs; i++)
        eb_cache(jobs[i].obj, jobs[i].key, identities[i], 1, jobs[i].sha_out, *(jobs[i].bytes_out));
    return 0;
}

static int eb_link(const char *bound, const char *ctor, int via_sh, const char *triple, char **objs, int nobj, const char *elf, const char *cwd, const char *errpath, long long *dt, char *why, int wl) {
    char *v[160];
    int n;
    int i;
    if (nobj < 0 || nobj + 8 >= 160) {
        why[0] = 0;
        return -1;
    }
    n = 0;
    v[n++] = (char *)bound;
    v[n++] = "40";
    if (via_sh) v[n++] = "sh";
    v[n++] = (char *)ctor;
    v[n++] = "-b";
    v[n++] = (char *)triple;
    v[n++] = "-o";
    v[n++] = (char *)elf;
    i = 0;
    while (i < nobj) {
        if (n >= 159) eb_die("argv");
        v[n++] = objs[i];
        i = i + 1;
    }
    v[n] = 0;
    return eb_run(v, cwd, 45, dt, why, wl, errpath);
}

static void eb_splice(const char *elf, const char *p3, const char *dst, long *poff, long *plen, long long *dt) {
    size_t en;
    size_t pn;
    char *e;
    char *p;
    PackageFooter foot;
    long end;
    FILE *f;
    long long t0;
    t0 = eb_ns();
    e = cx_read(elf, &en);
    p = cx_read(p3, &pn);
    if (!e || !p) eb_die("read");
    if (pn > 2147483647UL || !packagefooter_locate_bytes((const unsigned char *)p, (long)pn, &foot)) eb_die("p3 footer");
    end = foot.footer_offset + 16;
    if (foot.package_offset < 0 || end < foot.package_offset || end > (long)pn) eb_die("p3 span");
    if (p[foot.package_offset] != 'P') eb_die("p3 mark");
    f = fopen(dst, "wb");
    if (!f) eb_die("open candidate");
    if (fwrite(e, 1, en, f) != en || fwrite(p + foot.package_offset, 1, (size_t)(end - foot.package_offset), f) != (size_t)(end - foot.package_offset) || fclose(f)) eb_die("write candidate");
    if (chmod(dst, 0755)) eb_die("chmod candidate");
    *poff = foot.package_offset;
    *plen = end - foot.package_offset;
    free(e);
    free(p);
    *dt = eb_ns() - t0;
}

static void eb_line_slow(FILE *f, const char *k, const char *sha, long n, long long ns, const char *rr, const char *src) {
    char kind[32];
    char line[512];
    long long sn;
    eb_slow(rr, kind, 32, line, 512, &sn);
    fprintf(f, "%s\tsha=%s\tbytes=%ld\tns=%lld\tslow_kind=%s\tslow_ns=%lld\tslow_line=%s\tsrc=%s\n", k, sha, n, ns, kind, sn, line, src ? src : "-");
}

/* Receipt head is written once. On an append open, an existing identical head
   is kept as is; a differing head (or any nonempty non-head content) is refused. */
static char eb_head_buf[4096];
static char *eb_prev_receipt;
static void eb_open_head(FILE *rf, const char *root, const char *p3, const char *hp, const char *ctor, const char *hc, long nk, int via_sh) {
    int hn = snprintf(eb_head_buf, sizeof eb_head_buf, "entry-build-v3\nroot\t%s\np3\t%s\np3_sha\t%s\nconstructor\t%s\nconstructor_sha\t%s\nconstructor_bytes\t%ld\nvia\t%s\n",
            root, p3, hp, ctor, hc, nk, via_sh ? "sh" : "exec");
    if (hn < 0 || hn >= (int)sizeof eb_head_buf) eb_die("receipt head bound");
    if (eb_prev_receipt && eb_prev_receipt[0]) {
        if (strncmp(eb_prev_receipt, eb_head_buf, (size_t)hn)) eb_die("receipt head mismatch: existing receipt head differs from this run");
        return;
    }
    fputs(eb_head_buf, rf);
    if (fflush(rf)) eb_die("receipt");
}

static void eb_fail_close(FILE *rf, const char *phase, const char *rr, int rc, long long ns, const char *why) {
    char kind[32];
    char line[512];
    long long sn;
    const char *cls;
    eb_slow(rr, kind, 32, line, 512, &sn);
    cls = (rc == 142 || rc < 0) ? "TIMEOUT" : "FAIL";
    fprintf(rf, "failed_phase\t%s\nfailed_class\t%s\nfailed_rc\t%d\nfailed_ns\t%lld\nfailed_slow_kind\t%s\nfailed_slow_ns\t%lld\nfailed_slow_line\t%s\n",
            phase, cls, rc, ns, kind, sn, line);
    if (fclose(rf)) eb_die("receipt close");
    fprintf(stderr, "entry-build: %s %s rc %d\n", phase, cls, rc);
    if (why && why[0]) fprintf(stderr, "%s\n", why);
}

/* Closure modules planned for the roots: one object each, deduplicated by
   sy_realpath. The cap is a refusal, not an assumption. */
#define EB_OBJ cf_root_count()
#define EB_MAXC 128
#define EB_REALW 1024
static char eb_csrc[EB_MAXC][576];
static char eb_cobj[EB_MAXC][576];
static char eb_crr[EB_MAXC][576];
static char eb_ckey[EB_MAXC][64];
static char eb_csha[EB_MAXC][65];
static char eb_creal[EB_MAXC][EB_REALW];
static char eb_rootreal[128][EB_REALW];
static char eb_pbuf[262144];
static long long eb_cns[EB_MAXC];
static long eb_cbytes[EB_MAXC];

static void eb_real(const char *p, char *dst, int cap) {
    if (sy_realpath(p, dst, cap) >= 0) return;
    eb_copy_tok(dst, cap, p);
}

int main(int argc, char **argv) {
    char root[512];
    char p3[512];
    char out[512];
    char ctor[576];
    char bound[576];
    char srcs_b[128][576];
    char objs_b[128][576];
    char rrs_b[128][576];
    char elf[576];
    char cand[576];
    char receipt[576];
    char rr_link[576];
    char why[512];
    char shas[128][65];
    char hf[65], hc[65], hp[65], hk[65];
    const char *keys[128];
    const char *src_rel[128];
    const char *only_keys[128];
    const char *rmode;
    const char *target;
    char *objp[128];
    char *objall[128 + EB_MAXC];
    long nbytes[128];
    long nf, nc, np, nk, ncl;
    long poff, plen;
    long long nss[128];
    long long tl, ts, tpar_wall;
    int via_sh, rc, i, j, na, o1_drivers, link_only, only_n, w, a, found, k, target_set;
    FILE *rf;
    target = "lnx/x86_64";
    target_set = 0;
    /* per-invocation accumulators (--only batches must not carry over) */
    eb_sha_total = 0;
    eb_rec_total = 0;
    o1_drivers = 1;
    link_only = 0;
    int objects_only = 0;
    only_n = 0;
    int closure_list = 0, closure_n = 0;
    const char *closure_keys[128];
    if (EB_OBJ > 128) eb_die("root capacity");
    w = 1;
    a = 1;
    while (a < argc) {
        if (eb_same(argv[a], "--closure-list")) { closure_list = 1; a++; continue; }
        if (eb_same(argv[a], "--objects-only")) { objects_only = 1; a++; continue; }
        if (eb_same(argv[a], "--closure-only")) {
            if (a + 1 >= argc || closure_n >= 128) eb_die("closure-only");
            closure_keys[closure_n++] = argv[a + 1]; a += 2; continue;
        }
        if (eb_same(argv[a], "--o1-drivers")) {
            o1_drivers = 1;
            a = a + 1;
            continue;
        }
        if (eb_same(argv[a], "--link-only")) {
            link_only = 1;
            a = a + 1;
            continue;
        }
        if (eb_same(argv[a], "--target")) {
            if (target_set || a + 1 >= argc) eb_die("target");
            a = a + 1;
            target = argv[a];
            target_set = 1;
            a = a + 1;
            continue;
        }
        if (eb_same(argv[a], "--only")) {
            if (a + 1 >= argc || only_n >= EB_OBJ) eb_die("only");
            a = a + 1;
            only_keys[only_n] = argv[a];
            only_n = only_n + 1;
            a = a + 1;
            continue;
        }
        if (argv[a][0] == '-' && argv[a][1] == '-') eb_die("flag");
        argv[w] = argv[a];
        w = w + 1;
        a = a + 1;
    }
    argc = w;
    if (link_only && only_n) eb_die("flags");
    if (objects_only && (link_only || only_n || closure_list || closure_n)) eb_die("flags");
    if ((closure_list && (link_only || only_n || closure_n)) ||
        (closure_n && (link_only || only_n))) eb_die("flags");
    if (!eb_target_ok(target)) eb_die("target");
    if (argc != 4 && argc != 5) {
        fputs("usage: ROOT P3 OUT [CONSTRUCTOR] [--o1-drivers] [--target T] [--only KEY]... [--link-only]\n", stderr);
        return 2;
    }
    via_sh = argc == 4;
    if (!realpath(argv[1], root) || !realpath(argv[2], p3)) eb_die("realpath");
    if (!via_sh && !realpath(argv[4], ctor)) eb_die("realpath constructor");
    if (mkdir(argv[3], 0755) && errno != EEXIST) eb_die("mkdir");
    if (!realpath(argv[3], out)) eb_die("realpath out");
    /* A thin head (via_sh) and a self-contained APE both supply their own package; a bare ELF/Mach-O
       constructor does not, and without UNISA_CONTAINER it looks for a package inside itself and
       refuses with "no package at <entry.elf>". Give it the package this build was handed. */
    if (via_sh) sy_unsetenv("UNISA_CONTAINER");
    else {
        unsigned char hdr[4];
        int cfd = sy_open(ctor, O_RDONLY, 0);
        int is_bare = 0;
        if (cfd >= 0) {
            if (sy_read_full(cfd, hdr, 4) == 0) is_bare = (hdr[0] == 0x7f && hdr[1] == 'E' && hdr[2] == 'L' && hdr[3] == 'F') || (hdr[0] == 0xcf && hdr[1] == 0xfa && hdr[2] == 0xed && hdr[3] == 0xfe);
            sy_close(cfd);
        }
        if (is_bare) sy_setenv("UNISA_CONTAINER", p3, 1); else sy_unsetenv("UNISA_CONTAINER");
    }
    eb_join(bound, 576, root, "tools/bound");
    if (via_sh) eb_join(ctor, 576, root, "unisacc.com");
    for (i = 0; i < EB_OBJ; i++) {
        keys[i] = cf_root_key(i); src_rel[i] = cf_root_source(i);
    }
    i = 0;
    while (i < EB_OBJ) {
        int rn;
        eb_join(srcs_b[i], 576, root, src_rel[i]);
        eb_join(objs_b[i], 576, out, keys[i]);
        rn = snprintf(rrs_b[i], 576, "%s/%s.rr", out, keys[i]);
        if (rn < 0 || rn >= 576) eb_die("path");
        objp[i] = objs_b[i];
        i = i + 1;
    }
    eb_join(elf, 576, out, "entry.elf");
    eb_join(cand, 576, out, "candidate");
    eb_join(receipt, 576, out, "receipt.txt");
    eb_join(rr_link, 576, out, "entry.elf.rr");
    eb_sha(p3, hp, &np);
    eb_sha(ctor, hk, &nk);
    eb_package = p3;
    {
        size_t cn;
        char *cb = cx_read(ctor, &cn);
        PackageFooter cf;
        int bare = cb && cn >= 4 &&
            (((unsigned char)cb[0] == 0x7f && cb[1] == 'E' && cb[2] == 'L' && cb[3] == 'F') ||
             ((unsigned char)cb[0] == 0xcf && (unsigned char)cb[1] == 0xfa && (unsigned char)cb[2] == 0xed && (unsigned char)cb[3] == 0xfe));
        if (!cb || (!bare && !packagefooter_locate_bytes((const unsigned char *)cb, (long)cn, &cf)))
            eb_cache_fail("constructor", "split/thin launcher unsupported; supply self-contained constructor");
        free(cb);
    }
    k = 0;
    while (k < only_n) {
        found = 0;
        i = 0;
        while (i < EB_OBJ) {
            if (eb_same(only_keys[k], keys[i])) found = 1;
            i = i + 1;
        }
        if (!found) eb_die("only");
        k = k + 1;
    }
    rmode = (only_n || closure_n || link_only) ? "ab" : "wb";
    {
        struct stat rst;
        eb_prev_receipt = 0;
        if (!closure_list && rmode[0] == 'a') {
            if (stat(receipt, &rst)) {
                if (errno != ENOENT) eb_die("receipt stat");
            } else {
                size_t pn;
                eb_prev_receipt = cx_read(receipt, &pn);
                if (!eb_prev_receipt && rst.st_size) eb_die("receipt read");
            }
        }
    }
    rf = closure_list ? tmpfile() : fopen(receipt, rmode);
    if (!rf) eb_die("receipt");
    eb_open_head(rf, root, p3, hp, ctor, hk, nk, via_sh);
    {
        char ol[1024];
        int on;
        if (o1_drivers)
            on = snprintf(ol, sizeof ol, "object_level\tmode=o1-drivers\tdrive.o=-O1\thost.o=-O1\tdriveface.o=-O1\tdriveroute.o=-O1\tcxmod.o=-O1\ttapegate.o=-O1\tother=-O2\ttarget=%s\n", target);
        else
            on = snprintf(ol, sizeof ol, "object_level\tmode=default\tall=-O2\ttarget=%s\n", target);
        if (on < 0 || on >= (int)sizeof ol) eb_die("object_level bound");
        if (eb_prev_receipt && eb_prev_receipt[0]) {
            if (strstr(eb_prev_receipt, ol)) on = 0;
            else if (strstr(eb_prev_receipt, "\nobject_level\t")) eb_die("receipt object_level mismatch");
        }
        if (on) fputs(ol, rf);
    }
    tpar_wall = eb_ns();
    eb_input_root = root;
    eb_snapshot(root, ctor, eb_inputs_identity);
    ncl = 0;
    {
        const char *roots[128];
        int ri;
        i = 0;
        while (i < EB_OBJ) { eb_real(srcs_b[i], eb_rootreal[i], EB_REALW); i = i + 1; }
        for (ri = 0; ri < EB_OBJ; ri++) roots[ri] = srcs_b[ri];
        {
            int p;
            why[0] = 0;
            rc = eb_plan_parallel(bound, ctor, via_sh, roots, EB_OBJ, root, eb_pbuf, (int)sizeof eb_pbuf, why, (int)sizeof why);
            if (rc) {
                eb_fail_close(rf, "cx-plan", rrs_b[0], rc, 0, why);
                return 1;
            }
            p = 0;
            while (eb_pbuf[p]) {
                int at, e, f2, g, len, k2, dup, rn2, z;
                char rel[576];
                char full[576];
                char rp[EB_REALW];
                at = p;
                while (eb_pbuf[p] && eb_pbuf[p] != '\n') p = p + 1;
                e = p;
                if (eb_pbuf[p] == '\n') p = p + 1;
                f2 = at;
                while (f2 < e && eb_pbuf[f2] != '\t') f2 = f2 + 1;
                if (f2 >= e) continue;
                f2 = f2 + 1;
                g = f2;
                while (g < e && eb_pbuf[g] != '\t') g = g + 1;
                len = g - f2;
                if (len <= 0 || len >= 576) continue;
                k2 = 0;
                while (k2 < len) { rel[k2] = eb_pbuf[f2 + k2]; k2 = k2 + 1; }
                rel[len] = 0;
                if (rel[0] == '/') rn2 = cx_fmt(full, sizeof full, "%s", rel);
                else rn2 = cx_fmt(full, sizeof full, "%s/%s", root, rel);
                if (rn2 < 0 || rn2 >= (int)sizeof full) eb_die("plan-path");
                eb_real(full, rp, EB_REALW);
                dup = 0;
                k2 = 0;
                while (k2 < EB_OBJ && !dup) {
                    if (eb_same(rp, eb_rootreal[k2])) dup = 1;
                    k2 = k2 + 1;
                }
                k2 = 0;
                while (k2 < ncl && !dup) {
                    if (eb_same(rp, eb_creal[k2])) dup = 1;
                    k2 = k2 + 1;
                }
                if (dup) continue;
                if (ncl >= EB_MAXC) eb_die("closure-cap");
                z = 0;
                while (full[z] && z < 575) { eb_csrc[ncl][z] = full[z]; z = z + 1; }
                eb_csrc[ncl][z] = 0;
                z = 0;
                while (rp[z] && z < EB_REALW - 1) { eb_creal[ncl][z] = rp[z]; z = z + 1; }
                eb_creal[ncl][z] = 0;
                cx_fmt(eb_ckey[ncl], sizeof eb_ckey[ncl], "m%ld.o", (long)ncl);
                eb_join(eb_cobj[ncl], 576, out, eb_ckey[ncl]);
                z = cx_fmt(eb_crr[ncl], 576, "%s/%s.rr", out, eb_ckey[ncl]);
                if (z < 0 || z >= 576) eb_die("path");
                ncl = ncl + 1;
            }
        }
        {
            eb_buffer inputs = {0};
            char sha[65]; long bytes;
            np_puts(&inputs, eb_pbuf);
            for (i = 0; i < EB_OBJ; i++) {
                eb_sha(srcs_b[i], sha, &bytes); np_puts(&inputs, sha);
            }
            for (i = 0; i < ncl; i++) {
                eb_sha(eb_csrc[i], sha, &bytes); np_puts(&inputs, sha);
            }
            cx_sha256_hex(inputs.p, inputs.n, eb_plan_identity); free(inputs.p);
        }
        eb_stable(ctor, "cx-plan");
        if (closure_list) {
            for (j = 0; j < ncl; j++) printf("%s\t%s\n", eb_ckey[j], eb_csrc[j]);
            if (fclose(rf)) eb_die("receipt close");
            return 0;
        }
        for (k = 0; k < closure_n; k++) {
            found = 0;
            for (j = 0; j < ncl; j++) if (eb_same(closure_keys[k], eb_ckey[j])) found = 1;
            if (!found) eb_cache_fail(closure_keys[k], "unknown closure key");
        }
    {
        eb_job jobs[128];
        int nj = 0;
        i = 0;
        while (i < EB_OBJ) {
            if (link_only || closure_list || closure_n || !eb_wanted(keys[i], only_keys, only_n)) {
                nss[i] = 0;
                i = i + 1;
                continue;
            }
            jobs[nj].opt = eb_opt_for(keys[i], o1_drivers);
            jobs[nj].src = srcs_b[i];
            jobs[nj].obj = objs_b[i];
            jobs[nj].rr = rrs_b[i];
            jobs[nj].key = keys[i];
            jobs[nj].dt = &nss[i];
            jobs[nj].sha_out = shas[i];
            jobs[nj].bytes_out = &nbytes[i];
            nj = nj + 1;
            i = i + 1;
        }
        if (nj) {
            why[0] = 0;
            if (eb_compile_parallel(jobs, nj, bound, ctor, via_sh, target, root, why, (int)sizeof why, rf, 0)) {
                return 1;
            }
        }
    }
        {
            eb_job cjobs[EB_MAXC];
            int cnj = 0;
            j = 0;
            while (j < ncl) {
                if (link_only || only_n || (closure_n && !eb_wanted(eb_ckey[j], closure_keys, closure_n))) { j++; continue; }
                cjobs[cnj].opt = "-O2";
                cjobs[cnj].src = eb_csrc[j];
                cjobs[cnj].obj = eb_cobj[j];
                cjobs[cnj].rr = eb_crr[j];
                cjobs[cnj].key = eb_ckey[j];
                cjobs[cnj].dt = &eb_cns[j];
                cjobs[cnj].sha_out = eb_csha[j];
                cjobs[cnj].bytes_out = &eb_cbytes[j];
                cnj = cnj + 1;
                j = j + 1;
            }
            if (cnj) {
                why[0] = 0;
                if (eb_compile_parallel(cjobs, cnj, bound, ctor, via_sh, target, root, why, (int)sizeof why, rf, 0)) {
                    return 1;
                }
            }
        }
    }
    tpar_wall = eb_ns() - tpar_wall;
    if (!objects_only && !only_n && !closure_n) {
        /* Link consumes objects only. No compile fallback is permitted. */
        char identity[65];
        for (i = 0; i < EB_OBJ; i++) {
            eb_identity(bound, ctor, via_sh, target, root, keys[i], srcs_b[i], eb_opt_for(keys[i], o1_drivers), identity);
            eb_cache(objs_b[i], keys[i], identity, 0, 0, 0);
        }
        for (i = 0; i < ncl; i++) {
            eb_identity(bound, ctor, via_sh, target, root, eb_ckey[i], eb_csrc[i], "-O2", identity);
            eb_cache(eb_cobj[i], eb_ckey[i], identity, 0, 0, 0);
        }
        na = 0;
        i = 0;
        while (i < EB_OBJ) { objall[na] = objp[i]; na = na + 1; i = i + 1; }
        i = 0;
        while (i < ncl) { objall[na] = eb_cobj[i]; na = na + 1; i = i + 1; }
        why[0] = 0;
        eb_stable(ctor, "link");
        rc = eb_link(bound, ctor, via_sh, target, objall, na, elf, root, rr_link, &tl, why, (int)sizeof why);
        if (rc) {
            eb_fail_close(rf, "entry.elf", rr_link, rc, tl, why);
            return 1;
        }
        eb_stable(ctor, "link");
        eb_splice(elf, p3, cand, &poff, &plen, &ts);
        eb_sha(elf, hf, &nf);
        eb_sha(cand, hc, &nc);
        fprintf(rf, "package_offset\t%ld\npackage_bytes\t%ld\n", poff, plen);
        eb_line_slow(rf, "entry.elf", hf, nf, tl, rr_link, 0);
        eb_line_slow(rf, "candidate", hc, nc, ts, 0, 0);
    }
    fprintf(rf, "ENTRY_BUILD_PARALLEL\tjobs=%d\twall_ns=%lld\n", EB_JOBS, tpar_wall);
    fprintf(rf, "ENTRY_BUILD_SHA\tsha_ns=%lld\trec_ns=%lld\n", eb_sha_total, eb_rec_total);
    if (fclose(rf)) eb_die("receipt close");
    if (objects_only) printf("entry-build phase=objects objects=%d closure_objects=%d\n", EB_OBJ, ncl);
    else if (only_n || closure_n) printf("entry-build objects=%d closure_objects=%d\n", only_n, closure_n);
    else printf("entry-build candidate=%s bytes=%ld\n", hc, nc);
    return 0;
}
