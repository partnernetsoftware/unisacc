/* Build the self-contained entry candidate.
   usage: ROOT P3 OUT [CONSTRUCTOR] [--o1-drivers] [--target T] [--only KEY]... [--link-only]
   ROOT is the tree. P3 is a file whose trailer is the package to append
   (the installed unisacc.com is the usual source). OUT is a directory.
   CONSTRUCTOR defaults to ROOT/unisacc.com and is started with sh.
   An explicit CONSTRUCTOR is executed directly.
   Default compile level is -O1 for drive.o, host.o, driveface.o,
   driveroute.o, cxmod.o and tapegate.o, and -O2 for every other object.
   --o1-drivers is accepted and selects the same six. --target sets
   the compiler -b value. Omitted, it stays lnx/x86_64. --only KEY
   (repeatable) compiles just those objects and does not link.
   --link-only links the objects already in OUT and appends P3. A full
   build can be split across those invocations. Each invocation reads
   this same source. Do not edit this file between split batches.
   Each compile and the link runs under ROOT/tools/bound. The candidate
   is OUT/candidate. The receipt is OUT/receipt.txt. This does not replace
   ROOT/unisacc.com and does not call the old construction scripts.
   One object per small closure. drive is src/unisacc.cx.
   -funit now compiles only the command-line unit; each root's `use`
   closure is planned with -cx-plan, deduplicated by sy_realpath and
   compiled once as its own -O2 object, then all objects are linked.
   This depends on the constructor's per-unit -funit semantics.
   UNISACC_RR_TIME=1. Each step keeps stderr in OUT/<name>.rr. The receipt
   records wall time and the slowest RR_TIME line (inference, inflate, or other). */
#pragma unisa use sys.process
#pragma unisa use sys.fs
#pragma unisa use runtime.packagefooter
#pragma unisa use sys.time

static char eb_rr_env[] = "UNISACC_RR_TIME=1";

static void eb_die(const char *s) {
    fprintf(stderr, "entry-build: %s\n", s);
    exit(1);
}

static long long eb_ns(void) {
    sy_ts_t ts;
    if (sy_mono(&ts)) eb_die("clock");
    return (long long)ts.sec * 1000000000LL + (long long)ts.nsec;
}

static void eb_join(char *dst, int cap, const char *a, const char *b) {
    int n;
    n = snprintf(dst, (size_t)cap, "%s/%s", a, b);
    if (n < 0 || n >= cap) eb_die("path");
}

static void eb_sha(const char *path, char h[65], long *n) {
    size_t zn;
    char *b;
    b = cx_read(path, &zn);
    if (!b) eb_die("read");
    cx_sha256_hex(b, zn, h);
    *n = (long)zn;
    free(b);
}

static void eb_copy_tok(char *dst, int cap, const char *s) {
    int i;
    if (!dst || cap <= 0) return;
    if (!s) s = "-";
    i = 0;
    while (s[i] && i + 1 < cap) {
        char c;
        c = s[i];
        if (c == '\t' || c == '\n' || c == '\r') c = ' ';
        dst[i] = c;
        i = i + 1;
    }
    dst[i] = 0;
}

static const char *eb_find(const char *s, const char *w) {
    int i;
    int k;
    if (!s || !w) return 0;
    i = 0;
    while (s[i]) {
        k = 0;
        while (w[k] && s[i + k] == w[k]) k = k + 1;
        if (!w[k]) return s + i;
        i = i + 1;
    }
    return 0;
}

static void eb_slow(const char *path, char *kind, int kcap, char *line, int lcap, long long *ns) {
    FILE *f;
    char buf[768];
    eb_copy_tok(kind, kcap, "UNMEASURED");
    eb_copy_tok(line, lcap, "-");
    *ns = -1;
    if (!path) return;
    f = fopen(path, "rb");
    if (!f) return;
    while (fgets(buf, (int)sizeof buf, f)) {
        const char *p;
        const char *k;
        long long v;
        if (!eb_find(buf, "RR_TIME")) continue;
        p = eb_find(buf, "ns=");
        if (!p) continue;
        p = p + 3;
        if (*p == '-') p = p + 1;
        if (*p < '0' || *p > '9') continue;
        v = 0;
        while (*p >= '0' && *p <= '9') {
            v = v * 10 + (long long)(*p - '0');
            p = p + 1;
        }
        if (v <= *ns) continue;
        *ns = v;
        if (eb_find(buf, "inflate")) k = "inflate";
        else if (eb_find(buf, "inference")) k = "inference";
        else k = "other";
        eb_copy_tok(kind, kcap, k);
        eb_copy_tok(line, lcap, buf);
    }
    if (fclose(f)) eb_die("rr close");
}

static int eb_run(char **argv, const char *cwd, int secs, long long *dt, char *why, int wl, const char *errpath) {
    np_result r;
    long long t0;
    int pr;
    char *envadd[2];
    FILE *ef;
    t0 = eb_ns();
    envadd[0] = eb_rr_env;
    envadd[1] = 0;
    pr = np_run(argv, cwd, envadd, secs, &r, why, (size_t)wl);
    *dt = eb_ns() - t0;
    if (!pr && errpath && r.err && r.errn) {
        ef = fopen(errpath, "wb");
        if (ef) {
            fwrite(r.err, 1, r.errn, ef);
            if (fclose(ef)) eb_die("rr close");
        }
    }
    if (pr) return -1;
    if (r.rc) {
        if (r.err && r.errn) fwrite(r.err, 1, r.errn, stderr);
        np_free(&r);
        return r.rc;
    }
    np_free(&r);
    return 0;
}

/* Run the constructor's -cx-plan on one root and keep stdout. A plan path is
   relative to ROOT (the workspace cwd) unless it is absolute. */
static int eb_plan(const char *bound, const char *ctor, int via_sh, const char *src, const char *cwd, char *buf, int cap, char *why, int wl) {
    char *v[8];
    int n;
    int pr;
    np_result r;
    n = 0;
    v[n++] = (char *)bound;
    v[n++] = "50";
    if (via_sh) v[n++] = "sh";
    v[n++] = (char *)ctor;
    v[n++] = "-cx-plan";
    v[n++] = (char *)src;
    v[n] = 0;
    pr = np_run(v, cwd, 0, 50, &r, why, (size_t)wl);
    if (pr) return -1;
    if (r.rc) {
        if (r.err && r.errn && sy_write_all(2, r.err, (long)r.errn) < 0) {
            np_free(&r);
            return -1;
        }
        np_free(&r);
        return r.rc;
    }
    if (r.outn < 0 || r.outn >= cap) {
        np_free(&r);
        return 2;
    }
    if (r.outn) {
        int k;
        k = 0;
        while (k < (int)r.outn) { buf[k] = r.out[k]; k = k + 1; }
    }
    buf[r.outn] = 0;
    np_free(&r);
    return 0;
}

/* Six drive units that run once per build are -O1. --o1-drivers selects
   the same six. Inflate, model decode and the executor stay at -O2: -O0
   made that code about 45% slower at run time. */
static int eb_same(const char *a, const char *b) {
    int i;
    if (!a || !b) return 0;
    i = 0;
    while (a[i] && a[i] == b[i]) i = i + 1;
    return a[i] == 0 && b[i] == 0;
}

static int eb_target_ok(const char *s) {
    return eb_same(s, "lnx/x86_64") || eb_same(s, "lnx/arm64") || eb_same(s, "osx/x86_64") ||
           eb_same(s, "osx/arm64") || eb_same(s, "win/x86_64");
}

static int eb_o1_driver(const char *key) {
    return eb_same(key, "drive.o") || eb_same(key, "host.o") || eb_same(key, "driveface.o") ||
           eb_same(key, "driveroute.o") || eb_same(key, "cxmod.o") || eb_same(key, "tapegate.o");
}

static const char *eb_opt_for(const char *key, int o1_drivers) {
    if (o1_drivers && eb_o1_driver(key)) return "-O1";
    return "-O2";
}

static int eb_wanted(const char *key, const char **only, int only_n) {
    int k;
    if (only_n == 0) return 1;
    k = 0;
    while (k < only_n) {
        if (eb_same(key, only[k])) return 1;
        k = k + 1;
    }
    return 0;
}

static int eb_compile(const char *bound, const char *ctor, int via_sh, const char *opt, const char *triple, const char *src, const char *obj, const char *cwd, const char *errpath, long long *dt, char *why, int wl) {
    char *v[14];
    int n;
    n = 0;
    v[n++] = (char *)bound;
    v[n++] = "55";
    if (via_sh) v[n++] = "sh";
    v[n++] = (char *)ctor;
    v[n++] = (char *)opt;
    v[n++] = "-c";
    v[n++] = "-b";
    v[n++] = (char *)triple;
    v[n++] = "-funit";
    v[n++] = "-o";
    v[n++] = (char *)obj;
    v[n++] = (char *)src;
    if (n >= 14) eb_die("argv");
    v[n] = 0;
    return eb_run(v, cwd, 58, dt, why, wl, errpath);
}

static int eb_link(const char *bound, const char *ctor, int via_sh, const char *triple, char **objs, int nobj, const char *elf, const char *cwd, const char *errpath, long long *dt, char *why, int wl) {
    char *v[160];
    int n;
    int i;
    if (nobj < 0 || nobj + 8 >= 160) {
        why[0] = 0;
        return -1;
    }
    n = 0;
    v[n++] = (char *)bound;
    v[n++] = "40";
    if (via_sh) v[n++] = "sh";
    v[n++] = (char *)ctor;
    v[n++] = "-b";
    v[n++] = (char *)triple;
    v[n++] = "-o";
    v[n++] = (char *)elf;
    i = 0;
    while (i < nobj) {
        if (n >= 159) eb_die("argv");
        v[n++] = objs[i];
        i = i + 1;
    }
    v[n] = 0;
    return eb_run(v, cwd, 45, dt, why, wl, errpath);
}

static void eb_splice(const char *elf, const char *p3, const char *dst, long *poff, long *plen, long long *dt) {
    size_t en;
    size_t pn;
    char *e;
    char *p;
    PackageFooter foot;
    long end;
    FILE *f;
    long long t0;
    t0 = eb_ns();
    e = cx_read(elf, &en);
    p = cx_read(p3, &pn);
    if (!e || !p) eb_die("read");
    if (pn > 2147483647UL || !packagefooter_locate_bytes((const unsigned char *)p, (long)pn, &foot)) eb_die("p3 footer");
    end = foot.footer_offset + 16;
    if (foot.package_offset < 0 || end < foot.package_offset || end > (long)pn) eb_die("p3 span");
    if (p[foot.package_offset] != 'P') eb_die("p3 mark");
    f = fopen(dst, "wb");
    if (!f) eb_die("open candidate");
    if (fwrite(e, 1, en, f) != en || fwrite(p + foot.package_offset, 1, (size_t)(end - foot.package_offset), f) != (size_t)(end - foot.package_offset) || fclose(f)) eb_die("write candidate");
    if (chmod(dst, 0755)) eb_die("chmod candidate");
    *poff = foot.package_offset;
    *plen = end - foot.package_offset;
    free(e);
    free(p);
    *dt = eb_ns() - t0;
}

static void eb_line_slow(FILE *f, const char *k, const char *sha, long n, long long ns, const char *rr, const char *src) {
    char kind[32];
    char line[512];
    long long sn;
    eb_slow(rr, kind, 32, line, 512, &sn);
    fprintf(f, "%s\tsha=%s\tbytes=%ld\tns=%lld\tslow_kind=%s\tslow_ns=%lld\tslow_line=%s\tsrc=%s\n", k, sha, n, ns, kind, sn, line, src ? src : "-");
}

static void eb_open_head(FILE *rf, const char *root, const char *p3, const char *hp, const char *ctor, const char *hc, long nk, int via_sh) {
    fprintf(rf, "entry-build-v3\nroot\t%s\np3\t%s\np3_sha\t%s\nconstructor\t%s\nconstructor_sha\t%s\nconstructor_bytes\t%ld\nvia\t%s\n",
            root, p3, hp, ctor, hc, nk, via_sh ? "sh" : "exec");
    if (fflush(rf)) eb_die("receipt");
}

static void eb_fail_close(FILE *rf, const char *phase, const char *rr, int rc, long long ns, const char *why) {
    char kind[32];
    char line[512];
    long long sn;
    const char *cls;
    eb_slow(rr, kind, 32, line, 512, &sn);
    cls = (rc == 142 || rc < 0) ? "TIMEOUT" : "FAIL";
    fprintf(rf, "failed_phase\t%s\nfailed_class\t%s\nfailed_rc\t%d\nfailed_ns\t%lld\nfailed_slow_kind\t%s\nfailed_slow_ns\t%lld\nfailed_slow_line\t%s\n",
            phase, cls, rc, ns, kind, sn, line);
    if (fclose(rf)) eb_die("receipt close");
    fprintf(stderr, "entry-build: %s %s rc %d\n", phase, cls, rc);
    if (why && why[0]) fprintf(stderr, "%s\n", why);
}

/* Closure modules planned for the roots: one object each, deduplicated by
   sy_realpath. The cap is a refusal, not an assumption. */
#define EB_MAXC 128
#define EB_REALW 1024
static char eb_csrc[EB_MAXC][576];
static char eb_cobj[EB_MAXC][576];
static char eb_crr[EB_MAXC][576];
static char eb_ckey[EB_MAXC][64];
static char eb_csha[EB_MAXC][65];
static char eb_creal[EB_MAXC][EB_REALW];
static char eb_rootreal[33][EB_REALW];
static char eb_pbuf[262144];
static long long eb_cns[EB_MAXC];
static long eb_cbytes[EB_MAXC];

static void eb_real(const char *p, char *dst, int cap) {
    if (sy_realpath(p, dst, cap) >= 0) return;
    eb_copy_tok(dst, cap, p);
}

int main(int argc, char **argv) {
    char root[512];
    char p3[512];
    char out[512];
    char ctor[576];
    char bound[576];
    char srcs_b[33][576];
    char objs_b[33][576];
    char rrs_b[33][576];
    char elf[576];
    char cand[576];
    char receipt[576];
    char rr_link[576];
    char why[512];
    char shas[33][65];
    char hf[65], hc[65], hp[65], hk[65];
    const char *keys[33];
    const char *src_rel[33];
    const char *only_keys[33];
    const char *rmode;
    const char *target;
    char *objp[33];
    char *objall[160];
    long nbytes[33];
    long nf, nc, np, nk, ncl;
    long poff, plen;
    long long nss[33];
    long long tl, ts;
    int via_sh, rc, i, j, na, o1_drivers, link_only, only_n, w, a, found, k, target_set;
    FILE *rf;
    target = "lnx/x86_64";
    target_set = 0;
    o1_drivers = 1;
    link_only = 0;
    only_n = 0;
    w = 1;
    a = 1;
    while (a < argc) {
        if (eb_same(argv[a], "--o1-drivers")) {
            o1_drivers = 1;
            a = a + 1;
            continue;
        }
        if (eb_same(argv[a], "--link-only")) {
            link_only = 1;
            a = a + 1;
            continue;
        }
        if (eb_same(argv[a], "--target")) {
            if (target_set || a + 1 >= argc) eb_die("target");
            a = a + 1;
            target = argv[a];
            target_set = 1;
            a = a + 1;
            continue;
        }
        if (eb_same(argv[a], "--only")) {
            if (a + 1 >= argc || only_n >= 33) eb_die("only");
            a = a + 1;
            only_keys[only_n] = argv[a];
            only_n = only_n + 1;
            a = a + 1;
            continue;
        }
        if (argv[a][0] == '-' && argv[a][1] == '-') eb_die("flag");
        argv[w] = argv[a];
        w = w + 1;
        a = a + 1;
    }
    argc = w;
    if (link_only && only_n) eb_die("flags");
    if (!eb_target_ok(target)) eb_die("target");
    if (argc != 4 && argc != 5) {
        fputs("usage: ROOT P3 OUT [CONSTRUCTOR] [--o1-drivers] [--target T] [--only KEY]... [--link-only]\n", stderr);
        return 2;
    }
    via_sh = argc == 4;
    if (!realpath(argv[1], root) || !realpath(argv[2], p3)) eb_die("realpath");
    if (!via_sh && !realpath(argv[4], ctor)) eb_die("realpath constructor");
    if (mkdir(argv[3], 0755) && errno != EEXIST) eb_die("mkdir");
    if (!realpath(argv[3], out)) eb_die("realpath out");
    unsetenv("UNISA_CONTAINER");
    eb_join(bound, 576, root, "tools/bound");
    if (via_sh) eb_join(ctor, 576, root, "unisacc.com");
    keys[0] = "drive.o"; src_rel[0] = "src/unisacc.cx";
    keys[1] = "host.o"; src_rel[1] = "src/host.cx";
    keys[2] = "stages.o"; src_rel[2] = "src/stages.cx";
    keys[3] = "routestep.o"; src_rel[3] = "src/runtime/routestep.cx";
    keys[4] = "stagehandoff.o"; src_rel[4] = "src/runtime/stagehandoff.cx";
    keys[5] = "runexec.o"; src_rel[5] = "src/runtime/runexec.cx";
    keys[6] = "attributeframe.o"; src_rel[6] = "src/runtime/attribute_frame.cx";
    keys[7] = "bind.o"; src_rel[7] = "src/bind.cx";
    keys[8] = "cli.o"; src_rel[8] = "src/driver/cli.cx";
    keys[9] = "compat.o"; src_rel[9] = "src/driver/compat.cx";
    keys[10] = "route.o"; src_rel[10] = "src/driver/route.cx";
    keys[11] = "deps.o"; src_rel[11] = "src/driver/deps.cx";
    keys[12] = "input.o"; src_rel[12] = "src/driver/input.cx";
    keys[13] = "args.o"; src_rel[13] = "src/driver/args.cx";
    keys[14] = "path.o"; src_rel[14] = "src/driver/path.cx";
    keys[15] = "entrybind.o"; src_rel[15] = "src/entrybind.cx";
    keys[16] = "memlayout.o"; src_rel[16] = "src/runtime/memlayout.cx";
    keys[17] = "driveface.o"; src_rel[17] = "src/driveface.cx";
    keys[18] = "driveroute.o"; src_rel[18] = "src/driveroute.cx";
    keys[19] = "cxmod.o"; src_rel[19] = "src/compiler/cxmod.cx";
    keys[20] = "tapegate.o"; src_rel[20] = "src/compiler/tapegate.cx";
    keys[21] = "fwdstub.o"; src_rel[21] = "src/compiler/fwdstub.cx";
    keys[22] = "executor.o"; src_rel[22] = "src/executor.cx";
    keys[23] = "transition.o"; src_rel[23] = "src/core/transition.cx";
    keys[24] = "codec.o"; src_rel[24] = "src/runtime/codec.cx";
    keys[25] = "modeldecode.o"; src_rel[25] = "src/runtime/model_decode.cx";
    keys[26] = "modelnumber.o"; src_rel[26] = "src/runtime/model_number.cx";
    keys[27] = "packmodel.o"; src_rel[27] = "src/packmodel.cx";
    keys[28] = "modelload.o"; src_rel[28] = "src/runtime/modelload.cx";
    keys[29] = "bindstage.o"; src_rel[29] = "src/runtime/compiler/bindstage.cx";
    keys[30] = "entryexec.o"; src_rel[30] = "src/entryexec.cx";
    keys[31] = "hostnative.o"; src_rel[31] = "src/hostnative.cx";
    keys[32] = "tapelink.o"; src_rel[32] = "src/compiler/tapelink.cx";
    i = 0;
    while (i < 33) {
        int rn;
        eb_join(srcs_b[i], 576, root, src_rel[i]);
        eb_join(objs_b[i], 576, out, keys[i]);
        rn = snprintf(rrs_b[i], 576, "%s/%s.rr", out, keys[i]);
        if (rn < 0 || rn >= 576) eb_die("path");
        objp[i] = objs_b[i];
        i = i + 1;
    }
    eb_join(elf, 576, out, "entry.elf");
    eb_join(cand, 576, out, "candidate");
    eb_join(receipt, 576, out, "receipt.txt");
    eb_join(rr_link, 576, out, "entry.elf.rr");
    eb_sha(p3, hp, &np);
    eb_sha(ctor, hk, &nk);
    k = 0;
    while (k < only_n) {
        found = 0;
        i = 0;
        while (i < 33) {
            if (eb_same(only_keys[k], keys[i])) found = 1;
            i = i + 1;
        }
        if (!found) eb_die("only");
        k = k + 1;
    }
    rmode = (only_n || link_only) ? "ab" : "wb";
    rf = fopen(receipt, rmode);
    if (!rf) eb_die("receipt");
    eb_open_head(rf, root, p3, hp, ctor, hk, nk, via_sh);
    if (o1_drivers)
        fprintf(rf, "object_level\tmode=o1-drivers\tdrive.o=-O1\thost.o=-O1\tdriveface.o=-O1\tdriveroute.o=-O1\tcxmod.o=-O1\ttapegate.o=-O1\tother=-O2\ttarget=%s\n", target);
    else
        fprintf(rf, "object_level\tmode=default\tall=-O2\ttarget=%s\n", target);
    i = 0;
    while (i < 33) {
        if (link_only || !eb_wanted(keys[i], only_keys, only_n)) {
            nss[i] = 0;
            i = i + 1;
            continue;
        }
        why[0] = 0;
        rc = eb_compile(bound, ctor, via_sh, eb_opt_for(keys[i], o1_drivers), target, srcs_b[i], objs_b[i], root, rrs_b[i], &nss[i], why, (int)sizeof why);
        if (rc) {
            eb_fail_close(rf, keys[i], rrs_b[i], rc, nss[i], why);
            return 1;
        }
        eb_sha(objs_b[i], shas[i], &nbytes[i]);
        eb_line_slow(rf, keys[i], shas[i], nbytes[i], nss[i], rrs_b[i], 0);
        if (fflush(rf)) eb_die("receipt");
        i = i + 1;
    }
    ncl = 0;
    if (!only_n) {
        i = 0;
        while (i < 33) { eb_real(srcs_b[i], eb_rootreal[i], EB_REALW); i = i + 1; }
        i = 0;
        while (i < 33) {
            int p;
            why[0] = 0;
            rc = eb_plan(bound, ctor, via_sh, srcs_b[i], root, eb_pbuf, (int)sizeof eb_pbuf, why, (int)sizeof why);
            if (rc) {
                eb_fail_close(rf, "cx-plan", rrs_b[i], rc, 0, why);
                return 1;
            }
            p = 0;
            while (eb_pbuf[p]) {
                int at, e, f2, g, len, k2, dup, rn2, z;
                char rel[576];
                char full[576];
                char rp[EB_REALW];
                at = p;
                while (eb_pbuf[p] && eb_pbuf[p] != '\n') p = p + 1;
                e = p;
                if (eb_pbuf[p] == '\n') p = p + 1;
                f2 = at;
                while (f2 < e && eb_pbuf[f2] != '\t') f2 = f2 + 1;
                if (f2 >= e) continue;
                f2 = f2 + 1;
                g = f2;
                while (g < e && eb_pbuf[g] != '\t') g = g + 1;
                len = g - f2;
                if (len <= 0 || len >= 576) continue;
                k2 = 0;
                while (k2 < len) { rel[k2] = eb_pbuf[f2 + k2]; k2 = k2 + 1; }
                rel[len] = 0;
                if (rel[0] == '/') rn2 = cx_fmt(full, sizeof full, "%s", rel);
                else rn2 = cx_fmt(full, sizeof full, "%s/%s", root, rel);
                if (rn2 < 0 || rn2 >= (int)sizeof full) eb_die("plan-path");
                eb_real(full, rp, EB_REALW);
                dup = 0;
                k2 = 0;
                while (k2 < 33 && !dup) {
                    if (eb_same(rp, eb_rootreal[k2])) dup = 1;
                    k2 = k2 + 1;
                }
                k2 = 0;
                while (k2 < ncl && !dup) {
                    if (eb_same(rp, eb_creal[k2])) dup = 1;
                    k2 = k2 + 1;
                }
                if (dup) continue;
                if (ncl >= EB_MAXC) eb_die("closure-cap");
                z = 0;
                while (full[z] && z < 575) { eb_csrc[ncl][z] = full[z]; z = z + 1; }
                eb_csrc[ncl][z] = 0;
                z = 0;
                while (rp[z] && z < EB_REALW - 1) { eb_creal[ncl][z] = rp[z]; z = z + 1; }
                eb_creal[ncl][z] = 0;
                cx_fmt(eb_ckey[ncl], sizeof eb_ckey[ncl], "m%ld.o", (long)ncl);
                eb_join(eb_cobj[ncl], 576, out, eb_ckey[ncl]);
                z = cx_fmt(eb_crr[ncl], 576, "%s/%s.rr", out, eb_ckey[ncl]);
                if (z < 0 || z >= 576) eb_die("path");
                ncl = ncl + 1;
            }
            i = i + 1;
        }
        j = 0;
        while (j < ncl) {
            why[0] = 0;
            rc = eb_compile(bound, ctor, via_sh, "-O2", target, eb_csrc[j], eb_cobj[j], root, eb_crr[j], &eb_cns[j], why, (int)sizeof why);
            if (rc) {
                eb_fail_close(rf, eb_ckey[j], eb_crr[j], rc, eb_cns[j], why);
                return 1;
            }
            eb_sha(eb_cobj[j], eb_csha[j], &eb_cbytes[j]);
            eb_line_slow(rf, eb_ckey[j], eb_csha[j], eb_cbytes[j], eb_cns[j], eb_crr[j], eb_csrc[j]);
            j = j + 1;
        }
    }
    if (!only_n) {
        na = 0;
        i = 0;
        while (i < 33) { objall[na] = objp[i]; na = na + 1; i = i + 1; }
        i = 0;
        while (i < ncl) { objall[na] = eb_cobj[i]; na = na + 1; i = i + 1; }
        why[0] = 0;
        rc = eb_link(bound, ctor, via_sh, target, objall, na, elf, root, rr_link, &tl, why, (int)sizeof why);
        if (rc) {
            eb_fail_close(rf, "entry.elf", rr_link, rc, tl, why);
            return 1;
        }
        eb_splice(elf, p3, cand, &poff, &plen, &ts);
        eb_sha(elf, hf, &nf);
        eb_sha(cand, hc, &nc);
        fprintf(rf, "package_offset\t%ld\npackage_bytes\t%ld\n", poff, plen);
        eb_line_slow(rf, "entry.elf", hf, nf, tl, rr_link, 0);
        eb_line_slow(rf, "candidate", hc, nc, ts, 0, 0);
    }
    if (fclose(rf)) eb_die("receipt close");
    if (only_n) printf("entry-build objects=%d\n", only_n);
    else printf("entry-build candidate=%s bytes=%ld\n", hc, nc);
    return 0;
}
