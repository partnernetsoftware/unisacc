/* Build the self-contained entry candidate.
   usage: ROOT P3 OUT [CONSTRUCTOR]
   ROOT is the tree. P3 is a file whose trailer is the package to append
   (the installed unisacc.com is the usual source). OUT is a directory.
   CONSTRUCTOR defaults to ROOT/unisacc.com and is started with sh.
   An explicit CONSTRUCTOR is executed directly.
   Each compile and the link runs under ROOT/tools/bound. The candidate
   is OUT/candidate. The receipt is OUT/receipt.txt. This does not replace
   ROOT/unisacc.com and does not call the old construction scripts. */
#pragma unisa use runtime.process
#pragma unisa use runtime.packagefooter

struct eb_ts { long sec; long nsec; };

static void eb_die(const char *s) {
    fprintf(stderr, "entry-build: %s\n", s);
    exit(1);
}

static long long eb_ns(void) {
    struct eb_ts ts;
    int clock_gettime(int, struct eb_ts *);
    if (clock_gettime(1, &ts)) eb_die("clock");
    return (long long)ts.sec * 1000000000LL + (long long)ts.nsec;
}

static void eb_join(char *dst, int cap, const char *a, const char *b) {
    int n;
    n = snprintf(dst, (size_t)cap, "%s/%s", a, b);
    if (n < 0 || n >= cap) eb_die("path");
}

static void eb_sha(const char *path, char h[65], long *n) {
    size_t zn;
    char *b;
    b = cx_read(path, &zn);
    if (!b) eb_die("read");
    cx_sha256_hex(b, zn, h);
    *n = (long)zn;
    free(b);
}

static int eb_run(char **argv, const char *cwd, int secs, long long *dt, char *why, int wl) {
    np_result r;
    long long t0;
    int pr;
    t0 = eb_ns();
    pr = np_run(argv, cwd, 0, secs, &r, why, (size_t)wl);
    *dt = eb_ns() - t0;
    if (pr) return -1;
    if (r.rc) {
        if (r.err && r.errn) fwrite(r.err, 1, r.errn, stderr);
        np_free(&r);
        return r.rc;
    }
    np_free(&r);
    return 0;
}

static int eb_compile(const char *bound, const char *ctor, int via_sh, const char *src, const char *obj, const char *cwd, long long *dt, char *why, int wl) {
    char *v[14];
    int n;
    n = 0;
    v[n++] = (char *)bound;
    v[n++] = "55";
    if (via_sh) v[n++] = "sh";
    v[n++] = (char *)ctor;
    v[n++] = "-O2";
    v[n++] = "-c";
    v[n++] = "-b";
    v[n++] = "lnx/x86_64";
    v[n++] = "-funit";
    v[n++] = "-o";
    v[n++] = (char *)obj;
    v[n++] = (char *)src;
    v[n] = 0;
    return eb_run(v, cwd, 58, dt, why, wl);
}

static int eb_link(const char *bound, const char *ctor, int via_sh, const char *drive, const char *execo, const char *native, const char *elf, const char *cwd, long long *dt, char *why, int wl) {
    char *v[13];
    int n;
    n = 0;
    v[n++] = (char *)bound;
    v[n++] = "40";
    if (via_sh) v[n++] = "sh";
    v[n++] = (char *)ctor;
    v[n++] = "-b";
    v[n++] = "lnx/x86_64";
    v[n++] = "-o";
    v[n++] = (char *)elf;
    v[n++] = (char *)drive;
    v[n++] = (char *)execo;
    v[n++] = (char *)native;
    v[n] = 0;
    return eb_run(v, cwd, 45, dt, why, wl);
}

static void eb_splice(const char *elf, const char *p3, const char *dst, long *poff, long *plen, long long *dt) {
    size_t en;
    size_t pn;
    char *e;
    char *p;
    PackageFooter foot;
    long end;
    FILE *f;
    long long t0;
    t0 = eb_ns();
    e = cx_read(elf, &en);
    p = cx_read(p3, &pn);
    if (!e || !p) eb_die("read");
    if (pn > 2147483647UL || !packagefooter_locate_bytes((const unsigned char *)p, (long)pn, &foot)) eb_die("p3 footer");
    end = foot.footer_offset + 16;
    if (foot.package_offset < 0 || end < foot.package_offset || end > (long)pn) eb_die("p3 span");
    if (p[foot.package_offset] != 'P') eb_die("p3 mark");
    f = fopen(dst, "wb");
    if (!f) eb_die("open candidate");
    if (fwrite(e, 1, en, f) != en || fwrite(p + foot.package_offset, 1, (size_t)(end - foot.package_offset), f) != (size_t)(end - foot.package_offset) || fclose(f)) eb_die("write candidate");
    if (chmod(dst, 0755)) eb_die("chmod candidate");
    *poff = foot.package_offset;
    *plen = end - foot.package_offset;
    free(e);
    free(p);
    *dt = eb_ns() - t0;
}

static void eb_line(FILE *f, const char *k, const char *sha, long n, long long ns) {
    fprintf(f, "%s\tsha=%s\tbytes=%ld\tns=%lld\n", k, sha, n, ns);
}

static void eb_open_head(FILE *rf, const char *root, const char *p3, const char *hp, const char *ctor, const char *hc, long nk, int via_sh) {
    fprintf(rf, "entry-build-v2\nroot\t%s\np3\t%s\np3_sha\t%s\nconstructor\t%s\nconstructor_sha\t%s\nconstructor_bytes\t%ld\nvia\t%s\n",
            root, p3, hp, ctor, hc, nk, via_sh ? "sh" : "exec");
}

static void eb_obj(FILE *rf, const char *key, const char *path, long long ns) {
    char h[65];
    long n;
    if (!key) return;
    eb_sha(path, h, &n);
    eb_line(rf, key, h, n, ns);
}

static void eb_fail(const char *path, const char *root, const char *p3, const char *hp, const char *ctor, const char *hc, long nk, int via_sh,
                    const char *k0, const char *p0, long long n0,
                    const char *k1, const char *p1, long long n1,
                    const char *k2, const char *p2, long long n2,
                    const char *phase, int rc, long long ns, const char *why) {
    FILE *rf;
    const char *kind;
    rf = fopen(path, "wb");
    if (!rf) eb_die("receipt");
    eb_open_head(rf, root, p3, hp, ctor, hc, nk, via_sh);
    eb_obj(rf, k0, p0, n0);
    eb_obj(rf, k1, p1, n1);
    eb_obj(rf, k2, p2, n2);
    kind = (rc == 142 || rc < 0) ? "TIMEOUT" : "FAIL";
    fprintf(rf, "failed_phase\t%s\nfailed_class\t%s\nfailed_rc\t%d\nfailed_ns\t%lld\n", phase, kind, rc, ns);
    if (fclose(rf)) eb_die("receipt close");
    fprintf(stderr, "entry-build: %s %s rc %d\n", phase, kind, rc);
    if (why && why[0]) fprintf(stderr, "%s\n", why);
}

int main(int argc, char **argv) {
    char root[512];
    char p3[512];
    char out[512];
    char ctor[576];
    char bound[576];
    char src_drive[576];
    char src_exec[576];
    char src_native[576];
    char drive[576];
    char execo[576];
    char native[576];
    char elf[576];
    char cand[576];
    char receipt[576];
    char why[512];
    char hd[65], he[65], hn[65], hf[65], hc[65], hp[65], hk[65];
    long nd, ne, nn, nf, nc, np, nk;
    long poff, plen;
    long long td, te, tn, tl, ts;
    int via_sh, rc;
    FILE *rf;
    if (argc != 4 && argc != 5) {
        fputs("usage: ROOT P3 OUT [CONSTRUCTOR]\n", stderr);
        return 2;
    }
    via_sh = argc == 4;
    if (!realpath(argv[1], root) || !realpath(argv[2], p3)) eb_die("realpath");
    if (!via_sh && !realpath(argv[4], ctor)) eb_die("realpath constructor");
    if (mkdir(argv[3], 0755) && errno != EEXIST) eb_die("mkdir");
    if (!realpath(argv[3], out)) eb_die("realpath out");
    unsetenv("UNISA_CONTAINER");
    eb_join(bound, 576, root, "tools/bound");
    if (via_sh) eb_join(ctor, 576, root, "unisacc.com");
    eb_join(src_drive, 576, root, "src/unisacc.cx");
    eb_join(src_exec, 576, root, "src/entryexec.cx");
    eb_join(src_native, 576, root, "src/hostnative.cx");
    eb_join(drive, 576, out, "drive.o");
    eb_join(execo, 576, out, "exec.o");
    eb_join(native, 576, out, "hostnative.o");
    eb_join(elf, 576, out, "entry.elf");
    eb_join(cand, 576, out, "candidate");
    eb_join(receipt, 576, out, "receipt.txt");
    eb_sha(p3, hp, &np);
    eb_sha(ctor, hk, &nk);
    why[0] = 0;
    rc = eb_compile(bound, ctor, via_sh, src_drive, drive, root, &td, why, (int)sizeof why);
    if (rc) { eb_fail(receipt, root, p3, hp, ctor, hk, nk, via_sh, 0, 0, 0, 0, 0, 0, 0, 0, 0, "drive.o", rc, td, why); return 1; }
    why[0] = 0;
    rc = eb_compile(bound, ctor, via_sh, src_exec, execo, root, &te, why, (int)sizeof why);
    if (rc) { eb_fail(receipt, root, p3, hp, ctor, hk, nk, via_sh, "drive.o", drive, td, 0, 0, 0, 0, 0, 0, "exec.o", rc, te, why); return 1; }
    why[0] = 0;
    rc = eb_compile(bound, ctor, via_sh, src_native, native, root, &tn, why, (int)sizeof why);
    if (rc) { eb_fail(receipt, root, p3, hp, ctor, hk, nk, via_sh, "drive.o", drive, td, "exec.o", execo, te, 0, 0, 0, "hostnative.o", rc, tn, why); return 1; }
    why[0] = 0;
    rc = eb_link(bound, ctor, via_sh, drive, execo, native, elf, root, &tl, why, (int)sizeof why);
    if (rc) { eb_fail(receipt, root, p3, hp, ctor, hk, nk, via_sh, "drive.o", drive, td, "exec.o", execo, te, "hostnative.o", native, tn, "entry.elf", rc, tl, why); return 1; }
    eb_splice(elf, p3, cand, &poff, &plen, &ts);
    eb_sha(drive, hd, &nd);
    eb_sha(execo, he, &ne);
    eb_sha(native, hn, &nn);
    eb_sha(elf, hf, &nf);
    eb_sha(cand, hc, &nc);
    rf = fopen(receipt, "wb");
    if (!rf) eb_die("receipt");
    eb_open_head(rf, root, p3, hp, ctor, hk, nk, via_sh);
    fprintf(rf, "package_offset\t%ld\npackage_bytes\t%ld\n", poff, plen);
    eb_line(rf, "drive.o", hd, nd, td);
    eb_line(rf, "exec.o", he, ne, te);
    eb_line(rf, "hostnative.o", hn, nn, tn);
    eb_line(rf, "entry.elf", hf, nf, tl);
    eb_line(rf, "candidate", hc, nc, ts);
    if (fclose(rf)) eb_die("receipt close");
    printf("entry-build candidate=%s bytes=%ld\n", hc, nc);
    return 0;
}
