#pragma unisa use runtime.stream_attributes
static int failed;
static void check(int ok,const char *name){printf("%s\t%s\n",ok?"PASS":"FAIL",name);if(!ok)failed++;}
int main(void){
    unsigned char b[14]={0};
    check(cxsa_valid(b,4),"zero-records");
    check(!cxsa_valid(0,4)&&!cxsa_valid(b,-1)&&!cxsa_valid(b,3),"short-or-null");
    b[0]=1;check(cxsa_valid(b,13),"one-record");
    check(!cxsa_valid(b,12)&&!cxsa_valid(b,14),"exact-extent");
    b[0]=0x41;b[1]=0x42;b[2]=0x0f;b[3]=0;
    check(!cxsa_valid(b,4),"too-many-records");
    unsigned char *big=malloc(9000004);if(!big)return 2;
    big[0]=0x40;big[1]=0x42;big[2]=0x0f;big[3]=0;
    check(cxsa_valid(big,9000004),"maximum-records");free(big);
    printf("CXSTREAM_ATTRIBUTES\tfailed=%d\n",failed);return failed?1:0;
}
