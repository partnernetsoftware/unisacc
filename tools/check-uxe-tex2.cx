#pragma unisa use chrome_dom
/* tools/check-uxe-tex2.cx -- host_asset PNG 解码.
 * sh ./unisacc.com tools/check-uxe-tex2.cx --
 */
static int failed;
static void ck(int ok, const char *lab) {
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", lab);
    if (!ok) failed++;
}
static int dump(const char *url, const char *want, const char *lab) {
    const char *fin[4];
    int retries = 0, rc;
    fin[0] = "ASSET_OK";
    fin[1] = "ASSET_MISS";
    fin[2] = "ASSET_BAD";
    fin[3] = "ASSET_FAIL";
    rc = chd_dump_expect("/usr/bin/google-chrome", url, want, fin, 4, "uxe-tex2", 6, 25, &retries);


    if (rc == 3) { printf("TEX2_UNMEASURED\tno-chrome\n"); return 2; }
    ck(rc == 0, lab);
    return rc == 3 ? 2 : 0;
}
int main(void) {
    char cwd[512], url[700], u2[720], u3[720], u4[720];
    const char *pre = "file://";
    const char *suf = "/ujs/practice/uxe/test/uxe-tex2.html";
    int n, i, k;
    FILE *f = fopen("ujs/practice/uxe/test/tex16.expected.rgba", "rb");
    if (!f) { printf("FAIL\tno-expected-rgba\n"); return 1; }
    fclose(f);
    if (!getcwd(cwd, sizeof cwd)) return 2;
    n = 0;
    while (pre[n]) { url[n] = pre[n]; n++; }
    for (i = 0; cwd[i] && n < 500; i++) url[n++] = cwd[i];
    for (i = 0; suf[i] && n < 640; i++) url[n++] = suf[i];
    url[n] = 0;
    for (i = 0; url[i]; i++) { u2[i] = url[i]; u3[i] = url[i]; u4[i] = url[i]; }
    u2[i] = 0; u3[i] = 0; u4[i] = 0;
    {
        const char *q1 = "?miss=1";
        const char *q2 = "?bad=1";
        const char *q3 = "?tamper=1";
        for (k = 0; q1[k]; k++) u2[i + k] = q1[k];
        u2[i + k] = 0;
        for (k = 0; q2[k]; k++) u3[i + k] = q2[k];
        u3[i + k] = 0;
        for (k = 0; q3[k]; k++) u4[i + k] = q3[k];
        u4[i + k] = 0;
    }
    if (dump(url, "ASSET_OK", "tex2-ok")) return 2;
    if (dump(u2, "ASSET_MISS", "tex2-miss")) return 2;
    if (dump(u3, "ASSET_BAD", "tex2-bad")) return 2;
    if (dump(u4, "ASSET_BAD", "tex2-tamper")) return 2;
    printf("CHECK_UXE_TEX2\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
