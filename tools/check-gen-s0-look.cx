#pragma unisa use cxlib.ckassert
#pragma unisa use chrome_dom
static int failed;
int main(void) {
    FILE *f = fopen("ujs/plans/demo-v2/look-dev/s0-look-concept.tsv", "r");
    char line[128];
    int n = 0;
    if (!f) { printf("FAIL\tno-tsv\n"); return 1; }
    if (!fgets(line, sizeof line, f)) { fclose(f); return 1; }
    while (fgets(line, sizeof line, f)) n++;
    fclose(f);
    ck_record(&failed, n == 3600, "rows");
    printf("CHECK_GEN_S0_LOOK\trows=%d\tfailed=%d\n", n, failed);
    return failed ? 1 : 0;
}
