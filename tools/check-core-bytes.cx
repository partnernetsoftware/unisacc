#pragma unisa use core.bytes
static int calls;
void core_host_panic(const char *s){fprintf(stderr,"unexpected panic: %s\n",s);exit(2);}
int core_host_fetch(const unsigned char *p,int n,unsigned char **out,int *len){static unsigned char value[]={1,0,2};calls++;*out=0;*len=0;if(n==1&&p[0]=='x'){*out=value;*len=3;return 1;}return 0;}
int main(void){
 CxBlobs b={0};CxResources r={0};CxIntern t={0};unsigned char empty[]={0};int failed=0;
 if(core_blob_add(&b,0,0)!=0||b.n!=1||!b.entries[0].b)failed++;
 int id=core_resource_find(&r,&b,(const unsigned char *)"x",1);if(id!=1||b.entries[id].n!=3||memcmp(b.entries[id].b,"\1\0\2",3))failed++;
 if(core_resource_find(&r,&b,(const unsigned char *)"x",1)!=id||calls!=1)failed++;
 if(core_resource_find(&r,&b,(const unsigned char *)"z",1)!=0||core_resource_find(&r,&b,(const unsigned char *)"z",1)!=0||calls!=2)failed++;
 int64_t a=core_string_intern(&t,empty,0),c=core_string_intern(&t,empty,0);if(a!=1||a!=c||t.n!=1)failed++;
 for(int i=0;i<r.n;i++)free(r.entries[i].p);free(r.entries);for(int i=0;i<b.n;i++)free(b.entries[i].b);free(b.entries);
 for(size_t i=0;i<t.cap;i++)free(t.entries[i].b);free(t.entries);printf("CXCORE_BYTES failed=%d\n",failed);return failed?1:0;
}
