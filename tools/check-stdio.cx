#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.sig
#pragma unisa use text.text
#pragma unisa use mem.heap
/* Does a failed write to a standard stream reach ferror/fflush/puts? (C44-STDIO-01)
 *
 *   sh ./unisacc.com tools/check-stdio.cx -- ROOT
 *
 * Before the fix stdout/stderr write failures were swallowed: the raw write
 * returned a short count without setting an error bit, and the standard streams
 * build no FILE slot, so ferror(stdout) always read a fresh zero. /dev/full
 * showed puts=0 fflush=0 ferror=0 - a program that cannot tell it lost its
 * output. The contract now is the C one, and this check states it once, end to
 * end: compile a program with the product, run it with stdout on /dev/full, and
 * read the answer out of its exit code.
 *
 * The program returns one bit per observation, so a single run reports all four
 * without four compiles:
 *   1  puts returned EOF          2  fflush returned EOF
 *   4  ferror(stdout) is set      8  clearerr(stdout) clears it
 * Under /dev/full the exit code must be 15; on a normal stdout only bit 8 is
 * reachable, so a healthy run exits 8.
 */
static int g_fail;
static void die(const char *s) { sy_eprintf("stdio: REFUSE %s\n", s); sy_exit(2); }
static void ck(int ok, const char *name) {
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", name);
    if (!ok) g_fail = g_fail + 1;
}

/* one bit per stream-contract observation; see the table above */
static const char *case_src =
    "int main(void) {\n"
    "    int a = puts(\"x\");\n"
    "    int b = fflush(stdout);\n"
    "    int c = ferror(stdout);\n"
    "    clearerr(stdout);\n"
    "    int d = ferror(stdout);\n"
    "    return (a == -1 ? 1 : 0) + (b == -1 ? 2 : 0) + (c != 0 ? 4 : 0) + (d == 0 ? 8 : 0);\n"
    "}\n";

int main(int argc, char **argv) {
    char root[4096], com[4400], bound[4400], work[4400];
    char sp[4400], img[4400], cmd[9200];
    char *v[12];
    char why[512];
    np_result r;
    int i;
    if (argc >= 2 && argv[1][0] == '/' && argv[1][1] == 0) die("root");
    if (argc >= 2 && argv[1][0] == '/' && (tx_len(argv[1], 4400) == 0)) die("root");
    if (argc >= 2 && argv[1][0] == '/' ) { if (tx_copy(root, 4096, argv[1], tx_len(argv[1], 4096))) die("root"); }
    else if (sy_cwd(root, 4096) < 0) die("cwd");
    if (cx_fmt(com, sizeof com, "%s/unisacc.com", root)) die("com");
    if (cx_fmt(bound, sizeof bound, "%s/tools/bound", root)) die("bound");
    if (cx_fmt(work, sizeof work, "%s/out/check-stdio", root)) die("work");
    (void)sy_mkdir(work, 0755);
    if (cx_fmt(sp, sizeof sp, "%s/case.c", work)) die("case");
    if (cx_fmt(img, sizeof img, "%s/case.img", work)) die("img");
    { int fd = sy_open(sp, O_WRONLY | O_CREAT | O_TRUNC, 0644);
      if (fd < 0) die("write case");
      if (sy_write_all(fd, case_src, tx_len(case_src, 4096))) die("write case");
      sy_close(fd); }

    i = 0;
    v[i++] = bound; v[i++] = "50"; v[i++] = com;
    v[i++] = "-b"; v[i++] = "lnx/x86_64"; v[i++] = "-o"; v[i++] = img; v[i++] = sp; v[i] = 0;
    if (np_run(v, root, 0, 50, &r, why, sizeof why)) die(why);
    ck(r.rc == 0, "compile");
    np_free(&r);
    ck(sy_exists(img) == 1, "image-written");

    /* stdout on /dev/full: every write must fail and be visible */
    if (cx_fmt(cmd, sizeof cmd, "exec '%s' > /dev/full", img)) die("cmd");
    i = 0;
    v[i++] = "sh"; v[i++] = "-c"; v[i++] = cmd; v[i] = 0;
    if (np_run(v, root, 0, 30, &r, why, sizeof why)) die(why);
    ck(r.rc == 15, "/dev/full-all-four");
    ck((r.rc & 1) == 1, "/dev/full-puts-eof");
    ck((r.rc & 2) == 2, "/dev/full-fflush-eof");
    ck((r.rc & 4) == 4, "/dev/full-ferror-set");
    ck((r.rc & 8) == 8, "/dev/full-clearerr-clears");
    if (r.rc != 15) sy_printf("NOTE\texit\t%d\n", r.rc);
    np_free(&r);

    /* a normal stdout must set no error bit: only bit 8 is reachable */
    i = 0;
    v[i++] = img; v[i] = 0;
    if (np_run(v, root, 0, 30, &r, why, sizeof why)) die(why);
    ck(r.rc == 8, "normal-stdout-clean");
    if (r.rc != 8) sy_printf("NOTE\texit\t%d\n", r.rc);
    np_free(&r);

    printf("CHECK_STDIO\tfailed=%d\n", g_fail);
    return g_fail ? 1 : 0;
}
