/* tools/dev-product.cx -- one command from a source tree to a LOCAL development product.  NOT_RELEASE: the
 * result is LOCAL evidence only, never candidate evidence; nothing is installed, the installed product and the
 * release roots under ~/.cache/unisacc are not written (the launcher keeps its own run cache under OUT).
 *
 * usage: sh ./unisacc.com tools/dev-product.cx -- --tree ABS_TREE --out ABS_DIR [--git ABS_REPO] [--wait SECS]
 *                                                 [--par N] [--status] [--hdr-only ABS_PKG]
 *   ABS_TREE  the source tree (a `git archive` of main, or a checkout); it must hold unisacc.com (a symlink to
 *             the shared launcher is enough) -- the installed product is the bootstrap compiler of every step.
 *   ABS_DIR   product directory; created; every step keeps its state under ABS_DIR/state.
 *   --git     repository holding the installed COMMIT (cx-dev needs `git archive` of it); default ABS_TREE.
 *   --wait    seconds this call may wait for a background step (0..50, default 45).
 *   --status  print the step table and do not start anything.
 *   --hdr-only ABS_PKG  only the hdr step, on ABS_PKG (any file ending in a package, the installed launcher
 *             included) instead of cxdev/pkg.bin; ends with DEV_HDR<TAB>path=OUT/pkg-hdr.bin<TAB>sha=..<TAB>scope=LOCAL.
 *             No build, reload, entry or launcher; the result is a package, not a product.
 *
 * Steps (recipe: plans/local-product-0.0.71.md), each skipped when its recorded input identity and product
 * sha256 still match (the product is re-hashed on every call; a mismatch redoes the step):
 *   build   cx-dev --build with CXDEV_HOME=OUT/cxdev, CXDEV_WT=TREE           foreground, bound 55 s
 *   reload  OUT/cxdev/cx-dev --reload: private nets from TREE -> cxdev/pkg.bin background (cx-dev bounds each
 *           of its own steps to 55 s; whole stage capped at 240 s)
 *   entry   tools/entry-build.cx TREE cxdev/pkg.bin OUT/entry cxdev/base.bin   background (each compile runs
 *           under tools/bound; whole stage capped at 280 s); the constructor is the bare native slice
 *   hdr     p3-explode cxdev/pkg.bin, swap TREE/include/{cx-flat.h,stdio.h,stdlib.h} into the hdr resources
 *           (stored, method 0; F record, payload sha and packlen recomputed here), p3-implode -> pkg-hdr.bin
 *   seal    OUT/unisacc.com (sh launcher: candidate + pkg-hdr.bin), OUT/NOT_RELEASE, OUT/receipt.tsv
 * A background step still running when --wait runs out ends the call with
 *   DEV_PRODUCT_PENDING<TAB>step=..<TAB>pid=..<TAB>next=rerun the same command          exit 3
 * and the same command resumes.  Success ends with
 *   DEV_PRODUCT<TAB>path=OUT/unisacc.com<TAB>sha=..<TAB>scope=LOCAL                       exit 0
 * sha = sha256 of "entry-sha\npkg-sha\n".  A failed step: DEV_PRODUCT_FAIL<TAB>step=..<TAB>log=.., exit 1.
 * The tree identity is a stat fingerprint (path, size, mtime of include src cx exec seed), not a content hash.
 * Only lnx/x86_64.  Check: tools/check-dev-product-build.cx
 * (tools/check-dev-product.cx is an older, unrelated check: "is a product file installable"). */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sys.time
#pragma unisa use cxlib.netpack
#pragma unisa use mem.bytes

#define PW 4400
static char tree[PW], out[PW], gitroot[PW], treeid[65], hdr_pkg[PW];
static int wait_s = 45, par = 3, status_only;
static long long t_start;

static void die(const char *why, const char *arg) { fprintf(stderr, "dev-product: REFUSE %s%s%s\n", why, arg ? " " : "", arg ? arg : ""); exit(2); }
static void pj(char *o, const char *a, const char *b) { if (cx_fmt(o, PW, "%s/%s", a, b)) die("path-too-long", b); }
static int isfile(const char *p) { struct stat st; return !stat(p, &st) && S_ISREG(st.st_mode); }
static int isdir(const char *p) { struct stat st; return !stat(p, &st) && S_ISDIR(st.st_mode); }
static long long now_ms(void) { sy_ts_t ts; if (sy_mono(&ts)) die("clock", 0); return (long long)ts.sec * 1000 + ts.nsec / 1000000; }
static int file_sha(const char *p, char h[65]) { size_t n; char *b = cx_read(p, &n); if (!b) return 1; cx_sha256_hex(b, n, h); free(b); return 0; }
static void put(const char *p, const char *s) { char t[PW + 16]; if (cx_fmt(t, sizeof t, "%s.tmp", p) || cx_write(t, s, strlen(s)) || rename(t, p)) die("write", p); }
/* first line of a small state file, without the newline; "" when absent */
static void get(const char *p, char *o, size_t cap) {
    size_t n, i; char *b = cx_read(p, &n);
    o[0] = 0; if (!b) return;
    for (i = 0; i < n && i + 1 < cap && b[i] != '\n'; i++) o[i] = b[i];
    o[i] = 0; free(b);
}
static void sp(char *o, const char *step, const char *ext) { char r[200]; if (cx_fmt(r, sizeof r, "state/%s.%s", step, ext)) die("path-too-long", step); pj(o, out, r); }
static void lp(char *o, const char *step) { char r[200]; if (cx_fmt(r, sizeof r, "log/%s.log", step)) die("path-too-long", step); pj(o, out, r); }

/* a step is done when rc is 0, its input identity matches and its product still hashes to the recorded sha */
static int done(const char *step, const char *id, const char *product) {
    char p[PW], v[400], h[65];
    sp(p, step, "rc"); get(p, v, sizeof v); if (strcmp(v, "0")) return 0;
    sp(p, step, "id"); get(p, v, sizeof v); if (strcmp(v, id)) return 0;
    sp(p, step, "sha"); get(p, v, sizeof v); if (file_sha(product, h) || strcmp(v, h)) return 0;
    return 1;
}
static void seal_step(const char *step, const char *id, const char *product, long long ms) {
    char p[PW], h[65], m[64];
    if (file_sha(product, h)) die("product-missing", product);
    sp(p, step, "id"); put(p, id); sp(p, step, "sha"); put(p, h); sp(p, step, "rc"); put(p, "0");
    sp(p, step, "ms");
    if (ms >= 0) { if (cx_fmt(m, sizeof m, "%lld", ms)) die("fmt", 0); put(p, m); }
    else { get(p, m, sizeof m); if (m[0]) ms = atoll(m); }   /* a background step wrote its own wall time */
    printf("DEV_STEP\t%s\tDONE\tms=%lld\tsha=%.16s\n", step, ms, h);
}
static void fail(const char *step) { char l[PW]; lp(l, step); printf("DEV_PRODUCT_FAIL\tstep=%s\tlog=%s\n", step, l); exit(1); }

/* foreground, bounded; stdout+stderr to the step log */
static int fg(const char *step, char **av, const char *cwd, int secs) {
    np_result r = {0}; char why[1024], l[PW]; np_buf b = {0}; int rc;
    why[0] = 0; lp(l, step);
    if (np_run(av, cwd, 0, secs, &r, why, sizeof why)) { cx_write(l, why, strlen(why)); return 1; }
    np_put(&b, r.out, r.outn); np_put(&b, r.err, r.errn); cx_write(l, b.p ? b.p : "", b.n); free(b.p);
    rc = r.rc;
    if (rc) { fprintf(stderr, "dev-product: step %s rc=%d log=%s\n", step, rc, l); if (r.err && r.errn) fwrite(r.err, 1, r.errn < 400 ? r.errn : 400, stderr); }
    np_free(&r); return rc ? 1 : 0;
}
/* background: its own session, capped by timeout(1); writes state/STEP.rc and state/STEP.ms when it ends.
   Returns 0 when the step ended inside the wait budget (rc in *rc), 1 when still running (PENDING). */
static int bg(const char *step, const char *cmd, int cap_s, const char *id, int *rc) {
    char prc[PW], ppid[PW], pid_s[64], prun[PW], v[400], l[PW], pms[PW], sh[3 * PW]; long long dl; pid_t p; int alive = 0;
    sp(prc, step, "rc"); sp(ppid, step, "pid"); sp(prun, step, "runid"); sp(pms, step, "ms"); lp(l, step);
    get(ppid, pid_s, sizeof pid_s); get(prun, v, sizeof v);
    if (pid_s[0] && !strcmp(v, id) && !kill((pid_t)atol(pid_s), 0)) alive = 1;
    if (!alive && !(pid_s[0] && !strcmp(v, id) && isfile(prc))) {
        if (status_only) return 1;
        unlink(prc); put(prun, id);
        if (cx_fmt(sh, sizeof sh, "t0=$(date +%%s%%N); timeout %d %s > '%s' 2>&1; r=$?; t1=$(date +%%s%%N); echo $(( (t1 - t0) / 1000000 )) > '%s'; echo $r > '%s'", cap_s, cmd, l, pms, prc)) die("command-too-long", step);
        fflush(stdout); fflush(stderr);
        p = fork();
        if (p < 0) die("fork", step);
        if (!p) { char *av[] = {"/bin/sh", "-c", "exec setsid /bin/sh -c \"$0\"", sh, 0}; close(0); close(1); close(2); open("/dev/null", O_RDWR); dup(0); dup(0); execv(av[0], av); _exit(127); }
        if (cx_fmt(pid_s, sizeof pid_s, "%ld", (long)p)) die("fmt", 0);
        put(ppid, pid_s);
        printf("DEV_STEP\t%s\tSTARTED\tpid=%s\tcap_s=%d\n", step, pid_s, cap_s);
    }
    dl = t_start + (long long)wait_s * 1000;
    for (;;) {
        if (isfile(prc)) { get(prc, v, sizeof v); *rc = atoi(v); waitpid((pid_t)atol(pid_s), 0, WNOHANG); return 0; }
        waitpid((pid_t)atol(pid_s), 0, WNOHANG);
        if (status_only || now_ms() >= dl) return 1;
        sy_sleep_ms(200);
    }
}

/* hdr step: explode PKG, swap the three headers as stored resources, recompute F/sha/packlen, implode */
static int swap_headers(const char *pkg, const char *dst) {
    static const char *H[3] = {"cx-flat.h", "stdio.h", "stdlib.h"};
    char dir[PW], mf[PW], p[PW], ex[PW], im[PW], com[PW]; size_t n, i, a; char *m; np_buf o = {0}; int hit[3] = {0, 0, 0}, k; long long delta = 0, packlen = -1;
    pj(dir, out, "p3x"); pj(com, tree, "unisacc.com"); pj(ex, tree, "tools/p3-explode.cx"); pj(im, tree, "tools/p3-implode.cx"); /* lint:allow R1-product the tree's launcher is the bootstrap compiler of this step */
    { char *av[] = {"rm", "-rf", "--", dir, 0}; if (fg("hdr-clean", av, out, 30)) return 1; }
    { char *av[] = {"sh", com, ex, "--", (char *)pkg, dir, 0}; if (fg("hdr-explode", av, tree, 55)) return 1; }
    pj(mf, dir, "manifest.tsv");
    if (!(m = cx_read(mf, &n))) return 1;
    for (a = 0; a < n; a = i + 1) {
        char *f[6]; int nf = 0; size_t s = a, e;
        for (i = a; i < n && m[i] != '\n'; i++) ;
        e = i;
        if (e - a > 9 && !memcmp(m + a, "resource\t", 9)) {
            char line[9000], key[300], want[64]; size_t kn; char *kb; size_t j;
            if (e - s >= sizeof line) die("manifest-line-too-long", 0);
            if (mm_copy(line, (long)sizeof line, m + s, (long)(e - s))) die("copy-bound", 0); line[e - s] = 0;
            for (f[nf++] = line, j = 0; line[j]; j++) if (line[j] == '\t') { line[j] = 0; if (nf < 6) f[nf++] = line + j + 1; else die("manifest-resource-fields", 0); }
            if (nf != 6) die("manifest-resource-fields", 0);
            pj(p, dir, f[2]); if (!(kb = cx_read(p, &kn))) die("key-unreadable", f[2]);
            if (kn >= sizeof key) kn = sizeof key - 1;
            if (mm_copy(key, (long)sizeof key, kb, (long)kn)) die("copy-bound", 0); key[kn] = 0; free(kb);
            for (k = 0; k < 3; k++) { if (cx_fmt(want, sizeof want, "hdr/%s", H[k])) die("fmt", 0); if (kn == strlen(want) + 1 && !key[0] && !memcmp(key + 1, want, kn - 1)) break; }   /* key bytes: NUL, then the name */
            if (k < 3) {
                long long nlen, stored; char src[PW], rel[80], nf_line[200], h[65]; size_t hn; char *hb;
                if (sscanf(f[1], "F %lld %lld", &nlen, &stored) != 2) die("manifest-F-record", f[1]);
                if (cx_fmt(rel, sizeof rel, "include/%s", H[k])) die("fmt", 0);
                pj(src, tree, rel); if (!(hb = cx_read(src, &hn))) die("header-unreadable", src);
                pj(p, dir, f[4]); if (cx_write(p, hb, hn)) die("write", p);
                cx_sha256_hex(hb, hn, h); free(hb);
                if (cx_fmt(nf_line, sizeof nf_line, "F %lld %lld %lld 0 0", nlen, (long long)hn, (long long)hn)) die("fmt", 0);
                delta += (long long)hn - stored + (long long)strlen(nf_line) - (long long)strlen(f[1]);
                np_puts(&o, "resource\t"); np_puts(&o, nf_line); np_puts(&o, "\t"); np_puts(&o, f[2]); np_puts(&o, "\t"); np_puts(&o, f[3]);
                np_puts(&o, "\t"); np_puts(&o, f[4]); np_puts(&o, "\t"); np_puts(&o, h); np_puts(&o, "\n");
                hit[k]++; continue;
            }
        } else if (e - a > 8 && !memcmp(m + a, "packlen\t", 8)) {
            char num[64], nl[96]; size_t l = e - a - 8;
            if (l >= sizeof num) die("manifest-packlen", 0);
            if (mm_copy(num, (long)sizeof num, m + a + 8, (long)l)) die("copy-bound", 0); num[l] = 0; packlen = atoll(num);
            if (cx_fmt(nl, sizeof nl, "packlen\t%lld\n", packlen + delta)) die("fmt", 0);
            np_puts(&o, nl); continue;
        }
        np_put(&o, m + a, e - a); if (i < n) np_put(&o, "\n", 1);
    }
    free(m);
    for (k = 0; k < 3; k++) if (hit[k] != 1) die("hdr-resource-not-found-exactly-once", H[k]);
    if (packlen < 0) die("manifest-packlen-missing", 0);
    if (cx_write(mf, o.p, o.n)) die("write", mf);
    free(o.p);
    unlink(dst);
    { char *av[] = {"sh", com, im, "--", dir, (char *)dst, 0}; if (fg("hdr-implode", av, tree, 55)) return 1; }
    return !isfile(dst);
}

int main(int argc, char **argv) {
    char p[PW], cxdev[PW], loader[PW], pkg[PW], base[PW], entry[PW], cand[PW], pkgh[PW], launch[PW], com[PW], id[400], cmd[3 * PW], h1[65], h2[65], h3[65], fin[65], buf[2 * PW];
    int i, rc = 0, pend = 0; long long t0;
    for (i = 1; i < argc; i++) {
        if (!strcmp(argv[i], "--tree") && i + 1 < argc) { if (cx_fmt(tree, PW, "%s", argv[++i])) die("path-too-long", 0); }
        else if (!strcmp(argv[i], "--out") && i + 1 < argc) { if (cx_fmt(out, PW, "%s", argv[++i])) die("path-too-long", 0); }
        else if (!strcmp(argv[i], "--git") && i + 1 < argc) { if (cx_fmt(gitroot, PW, "%s", argv[++i])) die("path-too-long", 0); }
        else if (!strcmp(argv[i], "--wait") && i + 1 < argc) wait_s = atoi(argv[++i]);
        else if (!strcmp(argv[i], "--par") && i + 1 < argc) par = atoi(argv[++i]);
        else if (!strcmp(argv[i], "--status")) status_only = 1;
        else if (!strcmp(argv[i], "--hdr-only") && i + 1 < argc) { if (cx_fmt(hdr_pkg, PW, "%s", argv[++i])) die("path-too-long", 0); }
        else die("usage --tree ABS_TREE --out ABS_DIR [--git ABS_REPO] [--wait SECS] [--par N] [--status]", 0);
    }
    if (tree[0] != '/' || out[0] != '/') die("usage --tree ABS_TREE --out ABS_DIR (absolute paths)", 0);
    if (strchr(tree, '\'') || strchr(out, '\'') || strchr(gitroot, '\'')) die("quote-in-path", 0);
    if (wait_s < 0 || wait_s > 50) die("--wait 0..50", 0);
    if (par < 1 || par > 3) die("--par 1..3", 0);
    if (!gitroot[0] && cx_fmt(gitroot, PW, "%s", tree)) die("path-too-long", 0);
    pj(com, tree, "unisacc.com"); if (!isfile(com)) die("tree-has-no-unisacc.com", com); /* lint:allow R1-product the tree's launcher is the bootstrap compiler of every step */
    pj(p, tree, "tools/entry-build.cx"); if (!isfile(p)) die("tree-has-no-entry-build", p);
    t_start = now_ms();
    if (!status_only) {
        if (mkdir(out, 0755) && errno != EEXIST) die("mkdir", out);
        pj(p, out, "state"); if (mkdir(p, 0755) && errno != EEXIST) die("mkdir", p);
        pj(p, out, "log"); if (mkdir(p, 0755) && errno != EEXIST) die("mkdir", p);
        pj(p, out, "NOT_RELEASE"); put(p, "NOT_RELEASE\tdev-product-v1\tscope=LOCAL\tlnx/x86_64 only; not installed; not candidate evidence\n");
    } else if (!isdir(out)) die("out-missing", out);
    printf("NOT_RELEASE\tdev-product-v1\n");
    pj(cxdev, out, "cxdev"); pj(loader, cxdev, "cx-dev"); pj(pkg, cxdev, "pkg.bin"); pj(base, cxdev, "base.bin");
    pj(entry, out, "entry"); pj(cand, entry, "candidate"); pj(pkgh, out, "pkg-hdr.bin"); pj(launch, out, "unisacc.com");

    /* --hdr-only PKG: just the header swap of PKG into OUT/pkg-hdr.bin (the light real path the check walks) */
    if (hdr_pkg[0]) {
        char hid[400], a[65], b[65], c[65];
        if (hdr_pkg[0] != '/' || status_only) die("--hdr-only ABS_PKG (not with --status)", 0);
        if (file_sha(hdr_pkg, h1)) die("package-unreadable", hdr_pkg);
        pj(p, tree, "include/cx-flat.h"); if (file_sha(p, a)) die("header-unreadable", p);
        pj(p, tree, "include/stdio.h"); if (file_sha(p, b)) die("header-unreadable", p);
        pj(p, tree, "include/stdlib.h"); if (file_sha(p, c)) die("header-unreadable", p);
        if (cx_fmt(hid, sizeof hid, "hdr:%.16s:%.16s:%.16s:%.16s", h1, a, b, c)) die("fmt", 0);
        if (done("hdr", hid, pkgh)) printf("DEV_STEP\thdr\tSKIP\n");
        else { t0 = now_ms(); if (swap_headers(hdr_pkg, pkgh)) fail("hdr"); seal_step("hdr", hid, pkgh, now_ms() - t0); }
        if (file_sha(pkgh, h3)) die("product-missing", pkgh);
        printf("DEV_HDR\tpath=%s\tsha=%s\tscope=LOCAL\n", pkgh, h3);
        return 0;
    }

    /* tree identity: stat fingerprint */
    {   np_result r = {0}; char why[512]; char *av[] = {"sh", "-c", "find include src cx exec seed -type f -printf '%p %s %T@\\n' | LC_ALL=C sort", 0};
        why[0] = 0; if (np_run(av, tree, 0, 50, &r, why, sizeof why) || r.rc || !r.outn) die("tree-fingerprint", why);
        cx_sha256_hex(r.out, r.outn, treeid); np_free(&r);
    }
    printf("DEV_INPUT\ttree=%s\ttree_fp=%.16s\tout=%s\n", tree, treeid, out);

    /* build */
    if (cx_fmt(id, sizeof id, "build:%s", gitroot)) die("fmt", 0);
    if (done("build", id, loader) && isfile(base)) printf("DEV_STEP\tbuild\tSKIP\n");
    else if (status_only) { printf("DEV_STEP\tbuild\tTODO\n"); return 3; }
    else {
        char e1[PW + 32], e2[PW + 32], e3[PW + 32], e4[64], cx[PW];
        char *av[] = {"env", e1, e2, e3, e4, "sh", com, cx, "--", "--build", 0};
        pj(cx, tree, "tools/cx-dev.cx");
        if (cx_fmt(e1, sizeof e1, "CXDEV_ROOT=%s", gitroot) || cx_fmt(e2, sizeof e2, "CXDEV_HOME=%s", cxdev) || cx_fmt(e3, sizeof e3, "CXDEV_WT=%s", tree) || cx_fmt(e4, sizeof e4, "CXDEV_PAR=%d", par)) die("path-too-long", 0);
        t0 = now_ms();
        if (fg("build", av, tree, 55) || !isfile(loader) || !isfile(base)) fail("build");
        seal_step("build", id, loader, now_ms() - t0);
    }

    /* reload (background) */
    if (cx_fmt(id, sizeof id, "reload:%s", treeid)) die("fmt", 0);
    if (done("reload", id, pkg)) printf("DEV_STEP\treload\tSKIP\n");
    else {
        if (cx_fmt(cmd, sizeof cmd, "env CXDEV_HOME='%s' CXDEV_WT='%s' CXDEV_PAR=%d '%s' --reload", cxdev, tree, par, loader)) die("command-too-long", 0);
        if (bg("reload", cmd, 240, id, &rc)) { sp(p, "reload", "pid"); get(p, buf, 64); printf("DEV_PRODUCT_PENDING\tstep=reload\tpid=%s\tnext=rerun the same command\n", buf); return 3; }
        if (rc) fail("reload");
        seal_step("reload", id, pkg, -1);
    }

    /* entry (background) and hdr (foreground) both depend on reload only */
    if (file_sha(pkg, h1) || file_sha(base, h2)) die("bundle-incomplete", cxdev);
    if (cx_fmt(id, sizeof id, "entry:%.16s:%.16s:%.16s", treeid, h1, h2)) die("fmt", 0);
    if (done("entry", id, cand)) printf("DEV_STEP\tentry\tSKIP\n");
    else {
        int w = wait_s; wait_s = 0;   /* start it, do hdr meanwhile, then wait */
        if (cx_fmt(cmd, sizeof cmd, "sh -c 'cd \"$0\" && exec sh ./unisacc.com tools/entry-build.cx -- \"$0\" \"$1\" \"$2\" \"$3\"' '%s' '%s' '%s' '%s'", tree, pkg, entry, base)) die("command-too-long", 0);
        pend = bg("entry", cmd, 280, id, &rc); wait_s = w;
        if (!pend && rc) fail("entry");
    }
    {   char hid[400], a[65], b[65], c[65];
        pj(p, tree, "include/cx-flat.h"); if (file_sha(p, a)) die("header-unreadable", p);
        pj(p, tree, "include/stdio.h"); if (file_sha(p, b)) die("header-unreadable", p);
        pj(p, tree, "include/stdlib.h"); if (file_sha(p, c)) die("header-unreadable", p);
        if (cx_fmt(hid, sizeof hid, "hdr:%.16s:%.16s:%.16s:%.16s", h1, a, b, c)) die("fmt", 0);
        if (done("hdr", hid, pkgh)) printf("DEV_STEP\thdr\tSKIP\n");
        else if (status_only) { printf("DEV_STEP\thdr\tTODO\n"); return 3; }
        else { t0 = now_ms(); if (swap_headers(pkg, pkgh)) fail("hdr"); seal_step("hdr", hid, pkgh, now_ms() - t0); }
    }
    if (!done("entry", id, cand)) {
        sp(p, "entry", "rc");
        if (pend && bg("entry", cmd, 280, id, &rc)) { sp(p, "entry", "pid"); get(p, buf, 64); printf("DEV_PRODUCT_PENDING\tstep=entry\tpid=%s\tnext=rerun the same command\n", buf); return 3; }
        if (rc || !isfile(cand)) fail("entry");
        seal_step("entry", id, cand, -1);
    }

    /* seal */
    if (file_sha(cand, h2) || file_sha(pkgh, h3)) die("product-missing", out);
    if (cx_fmt(buf, sizeof buf, "%s\n%s\n", h2, h3)) die("fmt", 0);
    cx_sha256_hex(buf, strlen(buf), fin);
    if (!status_only) {
        if (cx_fmt(buf, sizeof buf, "#!/bin/sh\n# NOT_RELEASE dev-product-v1 scope=LOCAL (tools/dev-product.cx); lnx/x86_64 only\nexec env UNISA_CONTAINER='%s' UNISACC_LOCAL=1 UNISACC_CACHE_DIR=\"${DEV_PRODUCT_CACHE:-%s/runcache}\" '%s' \"$@\"\n", pkgh, out, cand)) die("path-too-long", 0);
        put(launch, buf); if (chmod(launch, 0755)) die("chmod", launch);
        pj(p, out, "runcache"); if (mkdir(p, 0700) && errno != EEXIST) die("mkdir", p);
        if (cx_fmt(buf, sizeof buf, "NOT_RELEASE\tdev-product-v1\ntree\t%s\ntree_fp\t%s\nentry\t%s\t%s\npkg\t%s\t%s\nnets_pkg\t%s\t%s\nproduct\t%s\t%s\nscope\tLOCAL\n", tree, treeid, cand, h2, pkgh, h3, pkg, h1, launch, fin)) die("path-too-long", 0);
        pj(p, out, "receipt.tsv"); put(p, buf);
    } else if (!isfile(launch)) { printf("DEV_STEP\tseal\tTODO\n"); return 3; }
    printf("DEV_PRODUCT_PARTS\tentry=%.16s\tpkg=%.16s\tnets_pkg=%.16s\twall_ms=%lld\n", h2, h3, h1, now_ms() - t_start);
    printf("DEV_PRODUCT\tpath=%s\tsha=%s\tscope=LOCAL\n", launch, fin);
    return 0;
}
