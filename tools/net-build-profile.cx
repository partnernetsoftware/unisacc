/* Actual sourcepackage job argv, bounded batches; construction is not full-key validation. */
#pragma unisa use cxlib.sourcepackage
#pragma unisa use sys.time
#pragma unisa use sys.fs
#pragma unisa use cxlib.netpack
static const char *nb_root=".",*nb_out,*nb_gen,*nb_tbl,*nb_net;
static char nb_ids[128][160];static int nb_n;
static void nb_die(const char *s){fprintf(stderr,"net-build-profile: %s\n",s);exit(2);}
static char *nb_load(const char *p,size_t *n){char *b=cx_read(p,n);if(!b)nb_die("read input");return b;}
static void nb_save(const char *dir,const char *name,const void *p,long n){char path[8192];if(snprintf(path,sizeof path,"%s/%s",dir,name)>=(int)sizeof path)nb_die("path");int fd=open(path,O_WRONLY|O_CREAT|O_EXCL,0600);if(fd<0)nb_die("new output required");if(sy_write_all(fd,p,n)||close(fd))nb_die("write");}
static void nb_sha(const char *p,char h[65]){size_t n;char *b=nb_load(p,&n);cx_sha256_hex(b,n,h);free(b);}
static np_result nb_run(char **v,const char *cwd,int sec){np_result r={0};char why[300]={0};if(np_run(v,cwd,0,sec,&r,why,sizeof why)||r.residue){fprintf(stderr,"net-build-profile: child %s\n",why);np_free(&r);nb_die("child transport");}return r;}
static char *nb_recipes(char sha[65]){char path[8192];snprintf(path,sizeof path,"%s/tools/cxlib/sourcepackage.cx",nb_root);size_t n;char *b=nb_load(path,&n);cx_sha256_hex(b,n,sha);char *a=strstr(b,"static const SpModel recipes[]={"),*end=a?strstr(a,"\n};"):0;if(!a||!end)nb_die("recipe table syntax");int depth=0,want=0;for(char *p=strchr(a,'\n')+1;p<end;p++){if(*p=='{'){depth++;if(depth==1)want=1;}else if(*p=='}')depth--;else if(*p=='"'){char *e=strchr(p+1,'"');if(!e||e>=end||memchr(p+1,'\\',e-p-1))nb_die("recipe string");if(depth==1&&want){if(nb_n==128||e-p-1>=160)nb_die("recipe id");memcpy(nb_ids[nb_n],p+1,e-p-1);nb_ids[nb_n++][e-p-1]=0;want=0;}p=e;}}if(depth||nb_n!=sp_model_count())nb_die("recipe count mismatch");return b;}
static char *nb_inputs(char hash[65],long *length){char *v[]={"git","-C",(char *)nb_root,"ls-files","-z","--cached","--others","--exclude-standard","--","exec","seed",0};np_result r=nb_run(v,0,8);if(r.rc)nb_die("git inputs");np_buf b={0};for(long at=0;at<r.outn;){char *p=r.out+at;long z=strlen(p);if(z>=r.outn-at||strpbrk(p,"\r\n\t"))nb_die("input path");at+=z+1;char full[8192];snprintf(full,sizeof full,"%s/%s",nb_root,p);struct stat st;if(lstat(full,&st))nb_die("input stat");if(!S_ISREG(st.st_mode))continue;char h[65];nb_sha(full,h);np_puts(&b,p);np_puts(&b,"\t");np_puts(&b,h);np_puts(&b,"\n");}np_free(&r);cx_sha256_hex(b.p,b.n,hash);*length=b.n;return b.p;}
static int nb_cmp_long(const void *a,const void *b){long x=*(const long *)a,y=*(const long *)b;return x<y?-1:x>y;}
static int nb_hex(const char *h){if(strlen(h)!=64)return 0;for(int i=0;i<64;i++)if(!((h[i]>='0'&&h[i]<='9')||(h[i]>='a'&&h[i]<='f')))return 0;return 1;}
static void nb_compact(const char *dir){char p[8192];snprintf(p,sizeof p,"%s/profile.tsv",dir);size_t n;char *b=nb_load(p,&n);if(!strstr(b,"\nPROFILE_COMPLETE\t"))nb_die("compact requires completed profile");int count=0;for(char *s=b;(s=strstr(s,"\nNET\t"));s++){char id[160],gh[65],th[65],nh[65];long gm,tm,nm,bytes;int rc;if(sscanf(s+1,"NET\t%159s\tgen_ms=%ld\ttbl_ms=%ld\tnet_ms=%ld\tbytes=%ld\tgen_sha=%64s\ttbl_sha=%64s\tnet_sha=%64s\trc=%d",id,&gm,&tm,&nm,&bytes,gh,th,nh,&rc)!=9||rc||strchr(id,'/')||strstr(id,"..")||!nb_hex(gh)||!nb_hex(th)||!nb_hex(nh))nb_die("compact row");const char *ph[]={"gen","tbl","net"},*ex[]={"json","tbl","net"},*hs[]={gh,th,nh};for(int i=0;i<3;i++){snprintf(p,sizeof p,"%s/%s-%s/result.%s",dir,ph[i],id,ex[i]);struct stat st;if(lstat(p,&st)||!S_ISREG(st.st_mode))nb_die("compact artifact");char h[65];nb_sha(p,h);if(strcmp(h,hs[i])||unlink(p))nb_die("compact SHA/unlink");snprintf(p,sizeof p,"%s/%s-%s",dir,ph[i],id);if(rmdir(p))nb_die("compact unexpected files");}count++;}free(b);printf("PROFILE_COMPACT\tmodels=%d\tretained=profile+commands+inputs\tartifacts=SHA_CHECKED_REMOVED\n",count);}
static void nb_summary(int argc,char **argv,int first){long times[128],sum=0;int n=0;char longest[160]="";long maximum=-1;for(int k=first;k<argc;k++){size_t z;char *b=nb_load(argv[k],&z);if(memchr(b,0,z)||!z||b[z-1]!='\n'||strncmp(b,"NET_BUILD_PROFILE\t",18))nb_die("profile shape");for(char *p=b;(p=strstr(p,"\nNET\t"));){char id[160],gh[65],th[65],nh[65];long gm,tm,nm,bytes;int rc;if(sscanf(p+1,"NET\t%159s\tgen_ms=%ld\ttbl_ms=%ld\tnet_ms=%ld\tbytes=%ld\tgen_sha=%64s\ttbl_sha=%64s\tnet_sha=%64s\trc=%d",id,&gm,&tm,&nm,&bytes,gh,th,nh,&rc)!=9||gm<0||tm<0||nm<0||bytes<0||rc||n==128)nb_die("profile row");long t=gm+tm+nm;times[n++]=t;sum+=t;if(t>maximum){maximum=t;strcpy(longest,id);}p++;}if(!strstr(b,"\nPROFILE_COMPLETE\t"))nb_die("incomplete profile");free(b);}if(!n)nb_die("no rows");qsort(times,n,sizeof(long),nb_cmp_long);printf("NET_BUILD_SUMMARY\tmodels=%d\tcumulative_ms=%ld\tp50_ms=%ld\tp90_ms=%ld\tp95_ms=%ld\tmax_ms=%ld\tlongest=%s\tpercentile=nearest-rank\tfull_key_validation=NOT_EXECUTED\n",n,sum,times[(n*50+99)/100-1],times[(n*90+99)/100-1],times[(n*95+99)/100-1],maximum,longest);}
static void nb_summary_checked(int argc,char **argv){char common[5][65]={{0}},ids[128][160];int total=0;const char *keys[]={"recipe_sha","inputs_sha","gen_sha","tbl_sha","net_sha"};for(int k=2;k<argc;k++){size_t z;char *b=nb_load(argv[k],&z),*head=strchr(b,'\n');if(!head)nb_die("summary header");*head=0;for(int j=0;j<5;j++){char key[80],h[65];snprintf(key,sizeof key,"\t%s=",keys[j]);char *p=strstr(b,key);if(!p||strlen(p+strlen(key))<64)nb_die("summary identity");p+=strlen(key);memcpy(h,p,64);h[64]=0;if(!nb_hex(h)||(p[64]&&p[64]!='\t'))nb_die("summary SHA");if(k==2)strcpy(common[j],h);else if(strcmp(common[j],h))nb_die("mixed build identities");}*head='\n';int count=0;for(char *p=b;(p=strstr(p,"\nNET\t"));p++){char id[160],gh[65],th[65],nh[65];long a,d,n,bytes;int rc;if(sscanf(p+1,"NET\t%159s\tgen_ms=%ld\ttbl_ms=%ld\tnet_ms=%ld\tbytes=%ld\tgen_sha=%64s\ttbl_sha=%64s\tnet_sha=%64s\trc=%d",id,&a,&d,&n,&bytes,gh,th,nh,&rc)!=9||!nb_hex(gh)||!nb_hex(th)||!nb_hex(nh)||a<0||d<0||n<0||a>60000||d>60000||n>60000||rc||total==128)nb_die("summary row");for(int j=0;j<total;j++)if(!strcmp(ids[j],id))nb_die("duplicate recipe timing");strcpy(ids[total++],id);count++;}char *tail=strstr(b,"\nPROFILE_COMPLETE\tmodels=");int declared;if(!tail||sscanf(tail+1,"PROFILE_COMPLETE\tmodels=%d",&declared)!=1||declared!=count)nb_die("completion count");free(b);}nb_summary(argc,argv,2);}
int main(int argc,char **argv){if(argc==3&&!strcmp(argv[1],"--compact")){nb_compact(argv[2]);return 0;}if(argc>1&&!strcmp(argv[1],"--summary")){nb_summary_checked(argc,argv);return 0;}int start=0,count=1,list=0;for(int i=1;i<argc;i++){const char *a=argv[i];if(!strcmp(a,"--list"))list=1;else if(i+1<argc){const char *v=argv[++i];if(!strcmp(a,"--root"))nb_root=v;else if(!strcmp(a,"--out"))nb_out=v;else if(!strcmp(a,"--gen"))nb_gen=v;else if(!strcmp(a,"--tbl"))nb_tbl=v;else if(!strcmp(a,"--net"))nb_net=v;else if(!strcmp(a,"--start")||!strcmp(a,"--count")){char *e;long z=strtol(v,&e,10);if(!*v||*e||z<0||z>128)nb_die("range");if(!strcmp(a,"--start"))start=z;else count=z;}else nb_die("option");}else nb_die("argument");}char rootbuf[8192];if(!realpath(nb_root,rootbuf))nb_die("root");nb_root=rootbuf;char recipe_sha[65];char *recipe=nb_recipes(recipe_sha);free(recipe);if(list){printf("RECIPE_SOURCE\tsha=%s\tcount=%d\n",recipe_sha,nb_n);for(int i=0;i<nb_n;i++)printf("RECIPE\t%d\t%s\n",i,nb_ids[i]);return 0;}if(!nb_out||!nb_gen||!nb_tbl||!nb_net||count<1||start>=nb_n||count>nb_n-start)nb_die("require tools/out and valid start/count");char out[8192],g[8192],t[8192],n[8192];if(!realpath(nb_gen,g)||!realpath(nb_tbl,t)||!realpath(nb_net,n))nb_die("constructors");const char *bins[]={g,t,n};char bh[3][65];for(int i=0;i<3;i++)nb_sha(bins[i],bh[i]);if(mkdir(nb_out,0700)||!realpath(nb_out,out))nb_die("new directory");char inputs_sha[65];long il;char *inputs=nb_inputs(inputs_sha,&il);nb_save(out,"inputs.tsv",inputs,il);free(inputs);np_buf report={0},commands={0};char line[1800];snprintf(line,sizeof line,"NET_BUILD_PROFILE\tversion=1\troot=%s\trecipe_sha=%s\tinputs_sha=%s\tgen_sha=%s\ttbl_sha=%s\tnet_sha=%s\tstart=%d\tcount=%d\tsource_scope=exec+seed-regular-nonignored\tfull_key_validation=NOT_EXECUTED\n",nb_root,recipe_sha,inputs_sha,bh[0],bh[1],bh[2],start,count);np_puts(&report,line);long begin=sy_now_ms();char bound[8192];snprintf(bound,sizeof bound,"%s/tools/bound",nb_root);
 for(int i=start;i<start+count;i++){long ms[3];char oh[3][65];long bytes=0;for(int phase=0;phase<3;phase++){if(sy_now_ms()-begin>45000)nb_die("batch 45s deadline; resume smaller batch");const char *prefix=phase==0?"gen":phase==1?"tbl":"net";char job[200],dir[8192];snprintf(job,sizeof job,"%s-%s",prefix,nb_ids[i]);snprintf(dir,sizeof dir,"%s/%s",out,job);if(mkdir(dir,0700))nb_die("job directory");char *a[24];int ac;if(sp_job_command(nb_root,out,"cc",bound,job,a,&ac)||ac<5)nb_die("official argv");a[2]=(char *)bins[phase];char *clean[36]={"env","-i","PATH=/usr/bin:/bin"};for(int k=0;k<=ac;k++)clean[k+3]=a[k];for(int k=0;k<ac;k++){snprintf(line,sizeof line,"ARG\t%s\t%d\t%s\n",job,k,a[k]);np_puts(&commands,line);}long before=sy_now_ms();long remaining=45000-(sy_now_ms()-begin);if(remaining<1000)nb_die("batch 45s deadline");int seconds=(int)(remaining/1000);if(seconds>42)seconds=42;np_result r=nb_run(clean,nb_root,seconds);ms[phase]=sy_now_ms()-before;if(r.rc){fprintf(stderr,"job %s rc%d %s\n",job,r.rc,r.err?r.err:"");np_free(&r);nb_die("constructor rejected");}np_free(&r);const char *op=a[phase==0?4:4];struct stat st;if(stat(op,&st)||!S_ISREG(st.st_mode))nb_die("output");bytes=st.st_size;nb_sha(op,oh[phase]);}snprintf(line,sizeof line,"NET\t%s\tgen_ms=%ld\ttbl_ms=%ld\tnet_ms=%ld\tbytes=%ld\tgen_sha=%s\ttbl_sha=%s\tnet_sha=%s\trc=0\n",nb_ids[i],ms[0],ms[1],ms[2],bytes,oh[0],oh[1],oh[2]);np_puts(&report,line);}
 char after[65];long al;char *ab=nb_inputs(after,&al);free(ab);char now[65];char rp[8192];snprintf(rp,sizeof rp,"%s/tools/cxlib/sourcepackage.cx",nb_root);nb_sha(rp,now);if(strcmp(after,inputs_sha)||strcmp(now,recipe_sha))nb_die("inputs changed");for(int i=0;i<3;i++){nb_sha(bins[i],now);if(strcmp(now,bh[i]))nb_die("constructor changed");}snprintf(line,sizeof line,"PROFILE_COMPLETE\tmodels=%d\tfull_key_validation=NOT_EXECUTED\n",count);np_puts(&report,line);nb_save(out,"profile.tsv",report.p,report.n);nb_save(out,"commands.tsv",commands.p,commands.n);fwrite(report.p,1,report.n,stdout);return 0;}
