/* Independent byte gold for the shared historical compiler-header inventory encoder. */
#pragma unisa use cxlib.libneedheaders
static int assertions,failed;
static void ck(int ok,const char *name){assertions++;if(!ok)failed++;printf("%s\tlibneedheaders.%s\n",ok?"PASS":"FAIL",name);}
int main(void){
 np_buf a={0},b={0};lh_header_begin(&a);lh_header_row(&a,"include",0775,1,0,"");lh_header_row(&a,"include/a.h",0644,0,3,"abc");
 const char *gold="compiler-historical-include-inventory-v1\ndirectory\tinclude\t509\nheader-input\tinclude/a.h\t420\t3\tabc\n";
 ck(a.n==strlen(gold)&&!memcmp(a.p,gold,a.n),"entire-independent-gold");
 lh_header_begin(&b);lh_header_row(&b,"include",0775,1,0,"ignored");lh_header_row(&b,"include/a.h",0644,0,3,"abc");ck(a.n==b.n&&!memcmp(a.p,b.p,a.n),"directory-has-no-file-fields");free(b.p);b=(np_buf){0};
 lh_header_begin(&b);lh_header_row(&b,"include/empty.h",0400,0,0,"empty");const char *empty="compiler-historical-include-inventory-v1\nheader-input\tinclude/empty.h\t256\t0\tempty\n";ck(b.n==strlen(empty)&&!memcmp(b.p,empty,b.n),"zero-byte-file-and-mode-retained");
 free(a.p);free(b.p);printf("CHECK_LIBNEEDHEADERS\tassertions=%d\tfailed=%d\n",assertions,failed);return failed?1:0;
}
