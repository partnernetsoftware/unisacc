/* Prepare the actual deployed integer kernel as a private CX module. No weights
 * are constructed and no test outcomes are cached. ROOT NEW_OUTDIR | --verify ROOT OUTDIR */
#pragma unisa use cxlib.netpack
typedef struct {char *path;char sha[65];} NetDep;
static NetDep deps[128];static int ndeps;
static char root[4096],out[4096];static np_buf module,manifest,checker;
static const char *names[]={"pp","lex","parse","type","scope","irsel","enc","reloc","regmap","tyinfo","pfconv","peep","opinfo","prec","binsel","isel","abi","combo"};
static void die(const char *s){fprintf(stderr,"net-material: %s\n",s);exit(2);}
static void join(char *p,size_t cap,const char *a,const char *b){int n=snprintf(p,cap,"%s/%s",a,b);if(n<0||(size_t)n>=cap)die("path too long");}
static int found(const char *p){int i;for(i=0;i<ndeps;i++)if(!strcmp(deps[i].path,p))return i;return -1;}
static char *input(const char *relative,size_t *n){char p[4400],sha[65];struct stat st;join(p,sizeof p,root,relative);if(stat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>16777216)die("input must be a bounded regular file");char *s=cx_read(p,n);if(!s||*n!=(size_t)st.st_size)die(p);cx_sha256_hex(s,*n,sha);int at=found(relative);if(at>=0){if(strcmp(sha,deps[at].sha))die("input drift");}else{if(ndeps==128)die("too many dependencies");deps[ndeps].path=strdup(relative);if(!deps[ndeps].path)die("allocation");strcpy(deps[ndeps++].sha,sha);}return s;}
static int quoted(char *s,size_t n,char *name){size_t i=0,k;while(i<n&&(s[i]==' '||s[i]=='\t'))i++;if(n-i<9||memcmp(s+i,"#include",8))return 0;i+=8;if(s[i]!=' '&&s[i]!='\t')return 0;while(i<n&&(s[i]==' '||s[i]=='\t'))i++;if(i==n||s[i++]!='"')return 0;k=0;while(i<n&&s[i]!='"'){if(k==199||s[i]=='/'||s[i]=='\\')die("unexpected kernel include path");name[k++]=s[i++];}if(i==n||!k)die("invalid include");name[k]=0;i++;while(i<n&&(s[i]==' '||s[i]=='\t'||s[i]=='\r'))i++;return i==n;}
static void emit_line(const char *s,size_t n){
 int decl=(n>=6&&!memcmp(s,"char *",6))||(n>=4&&!memcmp(s,"int ",4))||(n>=5&&!memcmp(s,"long ",5));
 if(decl)np_puts(&module,"static ");
 size_t i=0,at=0;while(decl&&i+6<=n){if(!memcmp(s+i,"; int ",6)){np_put(&module,s+at,i-at);np_puts(&module,"; static int ");i+=6;at=i;}else i++;}
 np_put(&module,s+at,n-at);np_puts(&module,"\n");
}
static void expand(const char *relative,int depth){if(depth>8)die("kernel include depth");if(found(relative)>=0)return;size_t n,i=0,end;char *s=input(relative,&n);if(memchr(s,0,n))die("NUL in kernel source");while(i<n){end=i;while(end<n&&s[end]!='\n')end++;char name[200],p[240];if(quoted(s+i,end-i,name)){snprintf(p,sizeof p,"kernel/%s",name);expand(p,depth+1);}else{emit_line(s+i,end-i);}i=end<n?end+1:end;}free(s);}
static void upper(char *out,const char *s,size_t n){size_t i;if(n>79)die("symbol too long");for(i=0;i<n;i++){char c=s[i];if(!((c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='_'))die("invalid semantic symbol");out[i]=c>='a'&&c<='z'?c-32:c;}out[n]=0;}
static void tuple(const char *src,const char *name,const char *dest){char needle[100];snprintf(needle,sizeof needle,"\n%s = (",name);const char *p=strstr(src,needle);if(!p||strstr(p+1,needle))die("canonical tuple not unique");p+=strlen(needle);np_puts(&module,"static const char *");np_puts(&module,dest);np_puts(&module,"=\"");int count=0;for(;;){while(*p==' '||*p=='\n'||*p=='\t'||*p==',')p++;if(*p==')')break;if(*p!='"')die("canonical tuple syntax");p++;while(*p&&*p!='"'){if(!((*p>='a'&&*p<='z')||(*p>='A'&&*p<='Z')||(*p>='0'&&*p<='9')||*p=='_'))die("tuple value syntax");np_put(&module,p,1);p++;}if(*p!='"')die("truncated tuple");p++;np_puts(&module,"\\000");count++;if(count>512)die("tuple too large");}if(!count)die("empty tuple");np_puts(&module,"\";\n");}
static void wrappers(void){
 const char *base[]={"DIRV", "NK_DEFINED", "NK_CHARC", "NK_CHARC", "NTV", "TOKV", "TYSV", "TOPSV", "TYSV", "SCTXV", "SKINDV", "IRFAMV", "IRFLAV"};
 const char *heads[]={"PPACTV","ACTV","PRODV","TYOUTV","SACTV","IRRECV"};
 np_buf fields={0},classes={0};char row[400],path[200],sym[100],uname[100];int s,f,h,idx=0;size_t n;
 for(s=0;s<18;s++){
  snprintf(path,sizeof path,"weights/gold/%s.tsv",names[s]);char *gold=input(path,&n);if(memchr(gold,0,n))die("NUL in gold");f=h=0;char *line=gold,*end;
  while((end=strchr(line,'\n'))){size_t len=end-line;
   if(len>7&&!memcmp(line,"#field\t",7)){if(f==4)die("too many fields");if(s<6){if(idx==13)die("field alias overflow");snprintf(sym,sizeof sym,"%s",base[idx++]);}else{upper(uname,s==17?"abi":names[s],strlen(s==17?"abi":names[s]));snprintf(sym,sizeof sym,"BF_%s_%d",uname,f);}snprintf(row,sizeof row,"if(s==%d&&f==%d)return nk_item(%s,i);\n",s,f,sym);np_puts(&fields,row);f++;}
   if(len>6&&!memcmp(line,"#head\t",6)){char *tab=memchr(line+6,'\t',len-6);if(!tab||h==16)die("bad head schema");if(s<6)snprintf(sym,sizeof sym,"%s",heads[s]);else if(s==17&&h<2)snprintf(sym,sizeof sym,"BH_ISEL_%s",h?"SYMBOL":"FORM");else{char hname[80];upper(hname,line+6,(size_t)(tab-line-6));upper(uname,s==17?"abi":names[s],strlen(s==17?"abi":names[s]));snprintf(sym,sizeof sym,"BH_%s_%s",uname,hname);}snprintf(row,sizeof row,"if(s==%d&&h==%d)return nk_item(%s,c);\n",s,h,sym);np_puts(&classes,row);h++;}
   line=end+1;
  }free(gold);if(!f||!h)die("missing gold schema");
 }
 np_puts(&module,"static int nk_ready,nk_last_s=-1,nk_last_h=-1;\nint nk_init(void){model_dims();nk_ready=1;nk_last_s=-1;return 0;}\nconst char *nk_name(int s){static const char *n[]={\"pp\",\"lex\",\"parse\",\"type\",\"scope\",\"irsel\",\"enc\",\"reloc\",\"regmap\",\"tyinfo\",\"pfconv\",\"peep\",\"opinfo\",\"prec\",\"binsel\",\"isel\",\"abi\",\"combo\"};return s>=0&&s<18?n[s]:0;}\nint nk_fields(int s){return nk_ready&&s>=0&&s<18?STAGE_M[s]:-1;}\nint nk_heads(int s){return nk_ready&&s>=0&&s<18?STAGE_NH[s]:-1;}\nint nk_values(int s,int f){return f>=0&&f<nk_fields(s)?STAGE_VN[s*4+f]:-1;}\nint nk_classes(int s,int h){return h>=0&&h<nk_heads(s)?STAGE_NCLS[s*16+h]:-1;}\nint nk_predict(int s,int a,int b,int c,int d,int h){int key[4],r;nk_last_s=-1;if(h<0||h>=nk_heads(s))return -2;key[0]=a;key[1]=b;key[2]=c;key[3]=d;r=infer(s,key,h);if(r>=0){nk_last_s=s;nk_last_h=h;}return r;}\nint nk_score(int s,int h,int c){if(s!=nk_last_s||h!=nk_last_h||c<0||c>=nk_classes(s,h))return -2147483647-1;return z[c];}\nstatic const char *nk_item(const char *p,int i){while(i>0){if(!*p)return 0;p+=strlen(p)+1;i--;}return *p?p:0;}\nconst char *nk_field_text(int s,int f,int i){if(i<0||i>=nk_values(s,f))return 0;\n");
 np_put(&module,fields.p,fields.n);np_puts(&module,"return 0;}\nconst char *nk_class_text(int s,int h,int c){if(c<0||c>=nk_classes(s,h))return 0;\n");np_put(&module,classes.p,classes.n);np_puts(&module,"return 0;}\n");free(fields.p);free(classes.p);
}
static void same(const char *name,np_buf *b){char p[4400];size_t n;join(p,sizeof p,out,name);char *s=cx_read(p,&n);if(!s||n!=b->n||memcmp(s,b->p,n))die("prepared material differs; regenerate");free(s);}
static void save(const char *name,np_buf *b){char p[4400];join(p,sizeof p,out,name);int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC,0600);if(fd<0)die("exclusive output create");size_t at=0;while(at<b->n){ssize_t k=write(fd,b->p+at,b->n-at);if(k<0&&errno==EINTR)continue;if(k<=0)die("write");at+=(size_t)k;}if(fsync(fd)||close(fd))die("sync/close");}
int main(int argc,char **argv){int verify=argc==4&&!strcmp(argv[1],"--verify"),i;if(verify){argc--;argv++;}if(argc!=3){fprintf(stderr,"usage: [--verify] ROOT OUTDIR\n");return 2;}if(!realpath(argv[1],root))die("root");if(argv[2][0]!='/'||strlen(argv[2])>=sizeof out)die("absolute output required");strcpy(out,argv[2]);
 np_puts(&module,"#pragma unisa module netcore\n");expand("kernel/unisa_core.c",0);size_t n;char *s=input("unisa/gold.py",&n);tuple(s,"CHARC","NK_CHARC");tuple(s,"DEFINED","NK_DEFINED");free(s);wrappers();
 s=input("tests/nets.cx",&n);np_put(&checker,s,n);free(s);const char *extra[]={"tools/net-material.cx","tools/cxlib/netpack.cx","iterate/kernel/order.tsv","iterate/kernel/vocab.tsv","unisacc.com"};for(i=0;i<5;i++){s=input(extra[i],&n);free(s);}
 np_puts(&manifest,"unisacc-net-material-v1\n");for(i=0;i<ndeps;i++){np_puts(&manifest,"input\t");np_puts(&manifest,deps[i].sha);np_puts(&manifest,"\t");np_puts(&manifest,deps[i].path);np_puts(&manifest,"\n");}
 char sha[65];cx_sha256_hex(module.p,module.n,sha);np_puts(&manifest,"module\t");np_puts(&manifest,sha);np_puts(&manifest,"\tnetcore.cx\n");cx_sha256_hex(checker.p,checker.n,sha);np_puts(&manifest,"batch\t");np_puts(&manifest,sha);np_puts(&manifest,"\tnets.cx\n");
 for(i=0;i<ndeps;i++){s=input(deps[i].path,&n);free(s);}
 if(verify){same("netcore.cx",&module);same("nets.cx",&checker);same("material.tsv",&manifest);puts("VERIFIED\tnet-material\tno-test-result");}else{if(mkdir(out,0700))die("output directory must not exist");save("netcore.cx",&module);save("nets.cx",&checker);save("material.tsv",&manifest);puts("PREPARED\tnet-material\tweights-reused\tno-test-result");}return 0;
}
