/* tools/check-textx-json-emit.cx -- ext/textx/json.cx serializer: js_emit and js_emit_pretty.
 *   sh ./unisacc.com tools/check-textx-json-emit.cx [-- --cases fixed;prop;jsdiff;mutc;mut1;mut2;mut3]
 *   fixed   expected texts written by hand from the JSON.stringify rules: number forms (0 -0 1 -1 0.1 0.5 1e21
 *           1e-7 max double, 5e-324, 2^53, 2^53+2, 123456789012345680000, 1e-6, 1e20, NaN, infinities), string
 *           escapes, 0x7f, UTF-8 and emoji pass-through, lone surrogate bytes, key order, duplicate keys, empty
 *           containers, nesting, pretty layout, cap exact / one short with a canary / zero, bad arguments
 *   prop    no JS needed: 2400 doubles (seeded random bit patterns, integers, short decimals) must read back to
 *           the same bits through tx_strtod, no text with one digit fewer may read back, and the exponent form is
 *           used exactly outside [1e-6, 1e21); 500 seeded random nested documents: emit -> parse gives the same
 *           tree, emit is a fixed point, pretty -> parse gives the same tree, pretty minus layout equals compact
 *   jsdiff  byte comparison against reference texts produced by JavaScript, read from
 *           tests/fixtures/textx-json-emit/numbers.tsv (BITS16HEX<TAB>JSON.stringify(x)) and structs.txt (per
 *           record: JSON.stringify(v), JSON.stringify(v,null,2), a line "%%"). The check never starts bun or
 *           node. When the fixture is absent the group prints UNMEASURED and FAILS (not registered as a batch
 *           until the fixture exists). One-off generator (bun or node; DIR = the fixture directory):
 *             bun gen.js DIR      with gen.js =
 *   let s=20261121;const R=()=>{s=s+0x6D2B79F5|0;let t=Math.imul(s^s>>>15,1|s);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296};
 *   const I=n=>Math.floor(R()*n),dv=new DataView(new ArrayBuffer(8));
 *   const hex=x=>{dv.setFloat64(0,x);return dv.getBigUint64(0).toString(16).padStart(16,"0")};
 *   const bits=()=>{dv.setUint32(0,I(4294967296));dv.setUint32(4,I(4294967296));return dv.getFloat64(0)};
 *   const ulp=(x,d)=>{dv.setFloat64(0,x);dv.setBigUint64(0,dv.getBigUint64(0)+BigInt(d));return dv.getFloat64(0)};
 *   const N=[0,-0,NaN,Infinity,-Infinity];
 *   for(let i=0;i<900;i++)N.push(bits());
 *   for(let i=0;i<400;i++)N.push((R()<.5?-1:1)*Math.floor(R()*10**I(23)));
 *   for(let i=0;i<400;i++)N.push(Number((R()*10**(I(40)-20)).toPrecision(1+I(17))));
 *   for(let e=-324;e<=308;e++){const x=Number("1e"+e);N.push(x);if(e>=-25&&e<=25)N.push(ulp(x,1),ulp(x,-1))}
 *   for(let k=-1074;k<=1023;k+=7){const x=2**k;N.push(x,ulp(x,1));if(k>-1074)N.push(ulp(x,-1))}
 *   const CH=["a","b","z","Q","0"," ","\"","\\","/","\b","\f","\n","\r","\t","\u0000","\u0001","\u001f","\u007f","\u0080","\u00e9","\u4e2d","\u2028","\uffff","\u{1F600}","\u{1D11E}"];
 *   const S=()=>{let n=I(9),o="";while(n--)o+=CH[I(CH.length)];return o};
 *   const NUM=()=>{const k=I(4);return k==0?I(2001)-1000:k==1?Number((R()*1e3).toFixed(I(6))):k==2?N[I(N.length)]:bits()};
 *   const V=d=>{const k=I(d>3?6:10);if(k==0)return null;if(k==1)return R()<.5;if(k<4)return NUM();if(k<6)return S();const n=I(5);if(k<8){const a=[];for(let i=0;i<n;i++)a.push(V(d+1));return a}const o={};for(let i=0;i<n;i++)o["k"+i+"_"+S()]=V(d+1);return o};
 *   let a="",b="";for(const x of N)a+=hex(x)+"\t"+JSON.stringify(x)+"\n";
 *   for(let i=0;i<600;i++){let v;do v=V(0);while(typeof v!="object"||v===null);b+=JSON.stringify(v)+"\n"+JSON.stringify(v,null,2)+"\n%%\n"}
 *   const fs=require("fs");fs.writeFileSync(process.argv[2]+"/numbers.tsv",a);fs.writeFileSync(process.argv[2]+"/structs.txt",b);
 *   mut1-3  a private copy of ext/textx/json.cx with one line mutated (-0 keeps its sign; exponent threshold 20
 *           instead of 21; control characters 0x10..0x1f not escaped) must make the fixed group fail on the
 *           named case; the unmutated copy must pass (control: case mutc).
 * Prints PASS/FAIL per case and CHECK_TEXTX_JSON_EMIT<TAB>failed=N; exit 0 only when N is 0. */
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use text.text
#pragma unisa use text.num
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use testx.check
#pragma unisa use textx.json

#define OCAP 262144
static unsigned char o1[OCAP + 8], o2[OCAP + 8], o3[OCAP + 8];
static char gen[OCAP];

static void cp(void *d, const void *s, long n) { if (n > 0 && mm_copy(d, n, s, n)) exit(2); }
static double frombits(unsigned long long b) { double d; memcpy(&d, &b, 8); return d; }
static unsigned long long tobits(double d) { unsigned long long b; memcpy(&b, &d, 8); return b; }
static void numval(js_val *x, double d) { memset(x, 0, sizeof *x); x->kind = JS_NUM; x->num = d; }
/* emitted text of the double with BITS into o1, NUL-terminated; the length or a negative errno */
static long emitnum(unsigned long long bits) {
    js_val x; long r;
    numval(&x, frombits(bits));
    r = js_emit(&x, o1, OCAP);
    if (r >= 0) o1[r] = 0;
    return r;
}
static void num_is(unsigned long long bits, const char *want, const char *name) {
    long r = emitnum(bits);
    if (!tk_ok(r == (long)strlen(want) && !strcmp((char *)o1, want), name) && r >= 0) printf("  got %s want %s\n", (char *)o1, want);
}
/* parse TEXT, emit compact (PRETTY 0) or pretty, compare with WANT (N bytes) */
static void text_is(const char *text, int pretty, const char *want, const char *name) {
    char err[96]; js_val *v = js_parse(text, (long)strlen(text), err, sizeof err); long r, n = (long)strlen(want);
    if (!v) { printf("  parse: %s\n", err); tk_ok(0, name); return; }
    r = pretty ? js_emit_pretty(v, o1, OCAP) : js_emit(v, o1, OCAP);
    if (r >= 0) o1[r] = 0;
    if (!tk_ok(r == n && !memcmp(o1, want, (size_t)n), name) && r >= 0) printf("  got %s\n  want %s\n", (char *)o1, want);
    js_free(v);
}

static void group_fixed(void) {
    js_val x, *v; long r; char err[96];
    num_is(0x0000000000000000ULL, "0", "num-0");
    num_is(0x8000000000000000ULL, "0", "num--0");
    num_is(0x3FF0000000000000ULL, "1", "num-1");
    num_is(0xBFF0000000000000ULL, "-1", "num--1");
    num_is(0x3FB999999999999AULL, "0.1", "num-0.1");
    num_is(0x3FE0000000000000ULL, "0.5", "num-0.5");
    num_is(tobits(tx_strtod("1e21", 0)), "1e+21", "num-1e21");
    num_is(tobits(tx_strtod("1e-7", 0)), "1e-7", "num-1e-7");
    num_is(0x7FEFFFFFFFFFFFFFULL, "1.7976931348623157e+308", "num-max");
    num_is(0x0000000000000001ULL, "5e-324", "num-5e-324");
    num_is(0x0010000000000000ULL, "2.2250738585072014e-308", "num-min-normal");
    num_is(0x4340000000000000ULL, "9007199254740992", "num-2^53");
    num_is(0x4340000000000001ULL, "9007199254740994", "num-2^53+2");
    num_is(tobits(tx_strtod("123456789012345680000", 0)), "123456789012345680000", "num-123456789012345680000");
    num_is(tobits(tx_strtod("999999999999999900000", 0)), "999999999999999900000", "num-below-1e21");
    num_is(tobits(tx_strtod("1e20", 0)), "100000000000000000000", "num-1e20");
    num_is(tobits(tx_strtod("1e-6", 0)), "0.000001", "num-1e-6");
    num_is(tobits(tx_strtod("1.5e-7", 0)), "1.5e-7", "num-1.5e-7");
    num_is(tobits(tx_strtod("0.00000123", 0)), "0.00000123", "num-0.00000123");
    num_is(tobits(tx_strtod("123.456", 0)), "123.456", "num-123.456");
    num_is(tobits(tx_strtod("-1.5e300", 0)), "-1.5e+300", "num--1.5e300");
    num_is(tobits(tx_strtod("4.35", 0)), "4.35", "num-4.35");
    num_is(tobits(tx_strtod("1.0", 0)), "1", "num-1.0-no-point");
    num_is(tobits(tx_strtod("100", 0)), "100", "num-100");
    num_is(0x3FD5555555555555ULL, "0.3333333333333333", "num-third");
    num_is(0x7FF8000000000000ULL, "null", "num-nan");
    num_is(0x7FF0000000000000ULL, "null", "num-inf");
    num_is(0xFFF0000000000000ULL, "null", "num--inf");
    text_is("null", 0, "null", "lit-null");
    text_is("true", 0, "true", "lit-true");
    text_is("false", 1, "false", "lit-false-pretty");
    text_is("{}", 0, "{}", "empty-object");
    text_is("[]", 0, "[]", "empty-array");
    text_is(" { } ", 1, "{}", "empty-object-pretty");
    text_is("[ ]", 1, "[]", "empty-array-pretty");
    text_is("\"\"", 0, "\"\"", "str-empty");
    text_is("\"\\u0022\\\\\\b\\f\\n\\r\\t\\u0000\\u0001\\u000b\\u001f\\/\"", 0,
            "\"\\\"\\\\\\b\\f\\n\\r\\t\\u0000\\u0001\\u000b\\u001f/\"", "str-escapes");
    text_is("\"a\\u007fb\"", 0, "\"a\x7f" "b\"", "str-7f-raw");
    text_is("\"\\u00e9\\u4e2d\\u2028\\uffff\"", 0, "\"\xC3\xA9\xE4\xB8\xAD\xE2\x80\xA8\xEF\xBF\xBF\"", "str-unicode-raw");
    text_is("\"\xF0\x9F\x98\x80\\ud83d\\ude00\\ud834\\udd1e\"", 0, "\"\xF0\x9F\x98\x80\xF0\x9F\x98\x80\xF0\x9D\x84\x9E\"", "str-emoji-raw");
    memset(&x, 0, sizeof x); x.kind = JS_STR; x.s = "a\xED\xA0\x80z\xED\xBF\xBF"; x.slen = 8;
    r = js_emit(&x, o1, OCAP);
    tk_ok(r == 16 && !memcmp(o1, "\"a\\ud800z\\udfff\"", 16), "str-lone-surrogate-bytes");
    text_is("{\"b\":1,\"a\":2,\"c\":3,\"10\":4,\"2\":5}", 0, "{\"b\":1,\"a\":2,\"c\":3,\"10\":4,\"2\":5}", "key-order-kept");
    text_is("{\"a\":1,\"a\":2}", 0, "{\"a\":1,\"a\":2}", "key-duplicates-kept");
    text_is("{\"k\\n\\u0001\":[1,[2,[3,{\"x\":null}]],true,false]}", 0, "{\"k\\n\\u0001\":[1,[2,[3,{\"x\":null}]],true,false]}", "nested-compact");
    text_is("{\"b\":1,\"a\":[],\"c\":{\"z\":{},\"y\":[1,\"s\",null,[true]]}}", 1,
            "{\n  \"b\": 1,\n  \"a\": [],\n  \"c\": {\n    \"z\": {},\n    \"y\": [\n      1,\n      \"s\",\n      null,\n      [\n        true\n      ]\n    ]\n  }\n}", "nested-pretty");
    text_is("[1]", 1, "[\n  1\n]", "pretty-array-one");
    text_is("{\"a\":\"x: y, z\"}", 1, "{\n  \"a\": \"x: y, z\"\n}", "pretty-colon-space-once");
    /* cap */
    v = js_parse("[1,\"ab\",{\"k\":0.5}]", 18, err, sizeof err);
    memset(o1, 0xEE, 64);
    r = js_emit(v, o1, 18);
    tk_ok(r == 18 && !memcmp(o1, "[1,\"ab\",{\"k\":0.5}]", 18) && o1[18] == 0xEE, "cap-exact");
    memset(o1, 0xEE, 64);
    r = js_emit(v, o1, 17);
    tk_ok(r == -ENOSPC && o1[17] == 0xEE, "cap-short-by-one");
    memset(o1, 0xEE, 64);
    r = js_emit(v, o1, 0);
    tk_ok(r == -ENOSPC && o1[0] == 0xEE, "cap-zero");
    r = js_emit(v, 0, 0);
    tk_ok(r == -ENOSPC, "cap-zero-null-out");
    memset(o1, 0xEE, 64);
    r = js_emit_pretty(v, o1, 20);
    tk_ok(r == -ENOSPC && o1[20] == 0xEE, "cap-pretty-short");
    r = js_emit_pretty(v, o1, 64);
    tk_ok(r == 37 && o1[37] == 0xEE && !memcmp(o1, "[\n  1,\n  \"ab\",\n  {\n    \"k\": 0.5\n  }\n]", 37), "cap-pretty-length");
    tk_ok(js_emit(0, o1, 64) == -EINVAL && js_emit(v, o1, -1) == -EINVAL && js_emit(v, 0, 8) == -EINVAL, "bad-arguments");
    js_free(v);
    {   /* depth: 128 parses and emits, a hand-built chain of 130 is refused */
        js_val ch[130], *it[130]; int i;
        for (i = 0; i < 128; i++) gen[i] = '[';
        for (i = 0; i < 128; i++) gen[128 + i] = ']';
        v = js_parse(gen, 256, err, sizeof err);
        r = v ? js_emit(v, o1, OCAP) : -1;
        tk_ok(r == 256 && !memcmp(o1, gen, 256), "depth-128-ok");
        js_free(v);
        for (i = 0; i < 130; i++) { memset(&ch[i], 0, sizeof ch[i]); ch[i].kind = JS_ARR; if (i < 129) { it[i] = &ch[i + 1]; ch[i].items = &it[i]; ch[i].n = 1; } }
        tk_ok(js_emit(&ch[0], o1, OCAP) == -EINVAL, "depth-130-refused");
    }
}

static unsigned long long seed = 20261121ULL;
static unsigned long long rnd(void) { seed = seed * 6364136223846793005ULL + 1442695040888963407ULL; return seed >> 11; }
static long rn(long n) { return (long)(rnd() % (unsigned long long)n); }

/* significant digits of the emitted number text T into D (no leading/trailing zeros), *PK = point position
   (value = 0.D * 10^*PK); the digit count */
static int digits_of(const char *t, char *d, int *pk) {
    int n = 0, before = 0, seen = 0, ex = 0, lead = 0; const char *p = t;
    if (*p == '-') p++;
    for (; *p && *p != 'e'; p++) {
        if (*p == '.') { seen = 1; continue; }
        if (!seen) before++;
        if (n == 0 && *p == '0') { lead++; continue; }
        d[n++] = *p;
    }
    if (*p == 'e') ex = (int)tx_strtol(p + 1, 0, 10);
    while (n > 0 && d[n - 1] == '0') n--;
    d[n] = 0;
    *pk = before - lead + ex;
    return n;
}
static int reads_as(const char *digs, int n, int k, int neg, unsigned long long want) {
    char b[64];
    if (cx_fmt(b, sizeof b, "%s0.%.*se%d", neg ? "-" : "", n, digs, k)) return -1;
    return tobits(tx_strtod(b, 0)) == want;
}
/* 0 when the text for BITS satisfies the Number.prototype.toString properties, else a reason code */
static int prop_num(unsigned long long bits) {
    char d[32], c[32]; int n, k, i, neg = (int)(bits >> 63), hase; long r = emitnum(bits); double ax;
    const char *t = (const char *)o1;
    if (r <= 0) return 1;
    if (tobits(tx_strtod(t, 0)) != bits) return 2;
    n = digits_of(t, d, &k);
    if (n < 1 || n > 17) return 3;
    if (n > 1) {
        cp(c, d, n);
        if (reads_as(c, n - 1, k, neg, bits) != 0) return 4;
        for (i = n - 2; i >= 0 && c[i] == '9'; i--) c[i] = '0';
        if (i >= 0) { c[i]++; if (reads_as(c, n - 1, k, neg, bits) != 0) return 5; }
        else if (reads_as("1", 1, k + 1, neg, bits) != 0) return 5;
    }
    ax = frombits(bits & 0x7FFFFFFFFFFFFFFFULL);
    hase = strchr(t, 'e') != 0;
    if (hase != (ax >= tx_strtod("1e21", 0) || ax < tx_strtod("1e-6", 0))) return 6;
    if (hase && k - 1 != (int)tx_strtol(strchr(t, 'e') + 1, 0, 10)) return 7;
    if (hase && strchr(t, 'e')[1] != '+' && strchr(t, 'e')[1] != '-') return 8;
    if (strchr(t, '.') && (hase ? strchr(t, 'e')[-1] : t[r - 1]) == '0') return 9;
    return 0;
}

static int eq(const js_val *a, const js_val *b) {
    long i;
    if (js_kind(a) != js_kind(b)) return 0;
    switch (js_kind(a)) {
    case JS_BOOL: return js_bool(a) == js_bool(b);
    case JS_NUM: return tobits(js_num(a)) == tobits(js_num(b));
    case JS_STR: return js_str_len(a) == js_str_len(b) && !memcmp(js_str(a), js_str(b), (size_t)js_str_len(a));
    case JS_ARR: case JS_OBJ:
        if (js_len(a) != js_len(b)) return 0;
        for (i = 0; i < js_len(a); i++) {
            if (js_kind(a) == JS_OBJ && (a->klens[i] != b->klens[i] || memcmp(a->keys[i], b->keys[i], (size_t)a->klens[i]))) return 0;
            if (!eq(js_at(a, i), js_at(b, i))) return 0;
        }
        return 1;
    }
    return 1;
}
static long gw;
static void gs(const char *s) { while (*s) gen[gw++] = *s++; }
static void gstr(void) {
    static const char *ch[] = { "a", "b", "Z", "0", " ", "\\\"", "\\\\", "/", "\\/", "\\b", "\\f", "\\n", "\\r", "\\t", "\\u0000", "\\u0001", "\\u001F",
                                "\x7f", "\\u007f", "\xC2\x80", "\xC3\xA9", "\\u4e2d", "\xE2\x80\xA8", "\\uffff", "\xF0\x9F\x98\x80", "\\ud834\\udd1e", ":", ",", "{", "]" };
    long n = rn(9);
    gs("\"");
    while (n-- > 0) gs(ch[rn(30)]);
    gs("\"");
}
static void gnum(void) {
    char b[64]; long k = rn(5);
    if (k == 0) cx_fmt(b, sizeof b, "%ld", rn(2001) - 1000);
    else if (k == 1) cx_fmt(b, sizeof b, "%ld.%ld", rn(1000), rn(100000));
    else if (k == 2) cx_fmt(b, sizeof b, "-%ld.%lde%ld", rn(10), rn(1000000), rn(60) - 30);
    else if (k == 3) cx_fmt(b, sizeof b, "%ld%09ld%09ld", rn(999) + 1, rn(1000000000), rn(1000000000));
    else cx_fmt(b, sizeof b, "%ld.%09ld%07ldE%s%ld", rn(9) + 1, rn(1000000000), rn(10000000), rn(2) ? "-" : "+", rn(300));
    gs(b);
}
static void gval(int d) {
    long k = rn(d > 3 ? 6 : 10), n, i;
    if (k == 0) gs("null");
    else if (k == 1) gs(rn(2) ? "true" : "false");
    else if (k < 4) gnum();
    else if (k < 6) gstr();
    else {
        int obj = k >= 8;
        n = rn(5);
        gs(obj ? "{" : "[");
        for (i = 0; i < n; i++) {
            if (i) gs(rn(3) ? "," : " ,\n ");
            if (obj) { gstr(); gs(rn(2) ? ":" : " : "); }
            gval(d + 1);
        }
        gs(obj ? "}" : "]");
    }
}
/* P (N bytes) with layout whitespace outside strings removed, into o3; the length */
static long unlayout(const unsigned char *p, long n) {
    long i, w = 0; int ins = 0;
    for (i = 0; i < n; i++) {
        unsigned char c = p[i];
        if (ins) { o3[w++] = c; if (c == '\\') o3[w++] = p[++i]; else if (c == '"') ins = 0; continue; }
        if (c == '\n' || c == ' ') continue;
        if (c == '"') ins = 1;
        o3[w++] = c;
    }
    return w;
}
static void group_prop(void) {
    long i, bad = 0, first = -1, cnt = 0; int why = 0; unsigned long long fb = 0; char err[96];
    for (i = 0; i < 2400; i++) {
        unsigned long long b; int rc;
        if (i < 1200) { b = (rnd() << 11) ^ rnd(); if (((b >> 52) & 0x7FF) == 0x7FF) b &= 0xBFFFFFFFFFFFFFFFULL; }
        else if (i < 1600) { char t[40]; cx_fmt(t, sizeof t, "%s%ld%09ld%09ld", rn(2) ? "-" : "", rn(99999) + 1, rn(1000000000), rn(1000000000)); t[1 + rn(22)] = 0; b = tobits(tx_strtod(t[0] == '-' && !t[1] ? "7" : t, 0)); }
        else if (i < 2000) { char t[48]; cx_fmt(t, sizeof t, "%ld.%0*lde%ld", rn(10), (int)rn(9) + 1, rn(10), rn(41) - 20); b = tobits(tx_strtod(t, 0)); }
        else if (i < 2200) b = (unsigned long long)(rn(2046) + 1) << 52 | (unsigned long long)(rn(3) == 0 ? 0 : rn(2) ? 1 : 0xFFFFFFFFFFFFFULL);
        else b = rnd() & 0xFFFFFFFFFFFFFULL;
        if ((b & 0x7FFFFFFFFFFFFFFFULL) == 0) b = 1;
        rc = prop_num(b);
        cnt++;
        if (rc) { bad++; if (first < 0) { first = i; why = rc; fb = b; } }
    }
    printf("PROP\tnumbers\tn=%ld\tbad=%ld\n", cnt, bad);
    if (bad) { emitnum(fb); printf("  first i=%ld reason=%d bits=%016llx text=%s\n", first, why, fb, (char *)o1); }
    tk_ok(bad == 0 && cnt == 2400, "prop-numbers-2400-roundtrip-shortest-form");
    bad = 0; first = -1; cnt = 0;
    for (i = 0; i < 500; i++) {
        js_val *v, *v2 = 0, *v3 = 0; long a, b2, p, u; int rc = 0;
        gw = 0;
        if (rn(2)) { gs("["); gval(0); gs(","); gval(0); gs(","); gval(1); gs("]"); } else { gs("{\"r\":"); gval(0); gs(",\"q\":"); gval(0); gs("}"); }
        v = js_parse(gen, gw, err, sizeof err);
        if (!v) rc = 1;
        else {
            a = js_emit(v, o1, OCAP);
            p = js_emit_pretty(v, o2, OCAP);
            if (a <= 0 || p < a) rc = 2;
            else {
                v2 = js_parse((char *)o1, a, err, sizeof err);
                v3 = js_parse((char *)o2, p, err, sizeof err);
                if (!v2 || !eq(v, v2)) rc = 3;
                else if (!v3 || !eq(v, v3)) rc = 4;
                else {
                    u = unlayout(o2, p);
                    if (u != a || memcmp(o3, o1, (size_t)a)) rc = 5;
                    else { b2 = js_emit(v2, o3, OCAP); if (b2 != a || memcmp(o3, o1, (size_t)a)) rc = 6; }
                }
                if (!rc && (o2[p - 1] == '\n' || memchr(o1, '\n', (size_t)a))) rc = 7;
            }
        }
        js_free(v); js_free(v2); js_free(v3);
        cnt++;
        if (rc) { bad++; if (first < 0) { first = i; why = rc; gen[gw] = 0; printf("  first i=%ld reason=%d err=%s\n  text=%s\n", i, rc, err, gen); } }
    }
    printf("PROP\tnested\tn=%ld\tbad=%ld\n", cnt, bad);
    tk_ok(bad == 0 && cnt == 500, "prop-nested-500-roundtrip-fixedpoint-pretty");
}

static void group_jsdiff(void) {
    static const char *np = "tests/fixtures/textx-json-emit/numbers.tsv", *sp = "tests/fixtures/textx-json-emit/structs.txt";
    size_t n = 0, i; char *src; long cnt = 0, bad = 0; char err[96];
    if (sy_exists(np) != 1 || sy_exists(sp) != 1) {
        printf("UNMEASURED\tjsdiff\tfixture absent: %s, %s (see the generator in the header)\n", np, sp);
        tk_ok(0, "jsdiff-fixture-present");
        return;
    }
    src = cx_read(np, &n);
    for (i = 0; src && i + 17 < n; ) {
        size_t e = i + 17; unsigned long long b; long r; char hx[17];
        while (e < n && src[e] != '\n') e++;
        memcpy(hx, src + i, 16); hx[16] = 0;
        b = tx_strtoul(hx, 0, 16);
        r = emitnum(b);
        cnt++;
        if (r != (long)(e - i - 17) || memcmp(o1, src + i + 17, (size_t)r)) { if (!bad++) printf("  first diff bits=%s got=%s\n", hx, r >= 0 ? (char *)o1 : "?"); }
        i = e + 1;
    }
    printf("JSDIFF\tnumbers\tn=%ld\tdiff=%ld\n", cnt, bad);
    tk_ok(src && cnt >= 2000 && bad == 0, "jsdiff-numbers");
    src = cx_read(sp, &n); cnt = 0; bad = 0;
    for (i = 0; src && i < n; ) {
        size_t e = i, q; js_val *v; long a, p; int d = 0;
        while (e < n && src[e] != '\n') e++;
        q = e + 1;
        while (q + 3 < n && !(src[q] == '\n' && src[q + 1] == '%' && src[q + 2] == '%' && src[q + 3] == '\n')) q++;
        if (q + 3 >= n) break;
        v = js_parse(src + i, (long)(e - i), err, sizeof err);
        if (!v) d = 1;
        else {
            a = js_emit(v, o1, OCAP); p = js_emit_pretty(v, o2, OCAP);
            if (a != (long)(e - i) || memcmp(o1, src + i, (size_t)a)) d = 2;
            else if (p != (long)(q - e - 1) || memcmp(o2, src + e + 1, (size_t)p)) d = 3;
        }
        js_free(v);
        cnt++;
        if (d && !bad++) printf("  first diff record=%ld reason=%d\n", cnt, d);
        i = q + 4;
    }
    printf("JSDIFF\tnested\tn=%ld\tdiff=%ld\n", cnt, bad);
    tk_ok(src && cnt >= 500 && bad == 0, "jsdiff-nested");
}

/* ---- mutation: private copy of the package source with one line changed ---- */
static char work[4096], com[4400], root[4096];
static long find_at(const char *h, long hn, const char *nd, long nn) {
    long i;
    for (i = 0; i + nn <= hn; i++) if (!strncmp(h + i, nd, (size_t)nn)) return i;
    return -1;
}
static int put_mut(const char *rel, const char *old, const char *nw) {
    char path[4400]; size_t n, k, ol = strlen(old), nl = strlen(nw); char *src, *dst; long at;
    if (cx_fmt(path, sizeof path, "%s/%s", root, rel)) return 0;
    src = cx_read(path, &n);
    if (!src) return 0;
    if (!old[0]) return tk_write(work, rel, src) == 0;
    at = find_at(src, (long)n, old, (long)ol);
    if (at < 0) { printf("mutation anchor missing: %s in %s\n", old, rel); return 0; }
    if (find_at(src + at + 1, (long)n - at - 1, old, (long)ol) >= 0) { printf("mutation anchor not unique: %s\n", old); return 0; }
    dst = mm_alloc((long)(n + nl + 8));
    if (!dst) return 0;
    k = (size_t)at;
    cp(dst, src, (long)k); cp(dst + k, nw, (long)nl); cp(dst + k + nl, src + k + ol, (long)(n - k - ol));
    dst[n - ol + nl] = 0;
    return tk_write(work, rel, dst) == 0;
}
static int setup(const char *old, const char *nw) {
    char lk[4400], p[4400]; char *src, *dst; size_t n, i, k = 0, ln;
    if (!put_mut("ext/textx/json.cx", old, nw)) return 0;
    if (!put_mut("tools/check-textx-json-emit.cx", "", "")) return 0;
    if (cx_fmt(lk, sizeof lk, "%s/r", work)) return 0;
    if (sy_exists(lk) != 1 && sy_symlink(root, lk)) return 0;
    if (cx_fmt(p, sizeof p, "%s/cxroot.tsv", root)) return 0;
    src = cx_read(p, &n);
    if (!src || !(dst = mm_alloc((long)n * 2 + 64))) return 0;
    i = 0;
    while (i < n) {   /* each line; R rows other than textx get the r/ link prefix on DIR */
        size_t e = i, t1 = 0, t2 = 0;
        while (e < n && src[e] != '\n') { if (src[e] == '\t') { if (!t1) t1 = e; else if (!t2) t2 = e; } e++; }
        ln = e - i;
        if (ln > 2 && src[i] == 'R' && src[i + 1] == '\t' && t2 && !(t2 - (i + 2) == 5 && !strncmp(src + i + 2, "textx", 5))) {
            cp(dst + k, src + i, (long)(t2 + 1 - i)); k += t2 + 1 - i;
            dst[k++] = 'r'; dst[k++] = '/';
            cp(dst + k, src + t2 + 1, (long)(e - t2 - 1)); k += e - t2 - 1;
        } else { cp(dst + k, src + i, (long)ln); k += ln; }
        if (e < n) dst[k++] = '\n';
        i = e + 1;
    }
    dst[k] = 0;
    return tk_write(work, "cxroot.tsv", dst) == 0;
}
static int child(void) {
    char probe[4400]; char *av[] = { "sh", com, probe, "--", "--cases", "fixed", 0 };
    if (cx_fmt(probe, sizeof probe, "%s/tools/check-textx-json-emit.cx", work)) return -1;
    return tk_run(av, 0, 55000);
}
static void group_mut(int part) {
    int rc;
    if (tk_scratch("check-textx-json-emit", work, sizeof work)) { tk_ok(0, "mut-scratch"); return; }
    if (part == 0) {
        if (setup("", "")) { rc = child(); tk_ok(rc == 0 && tk_has(tk_out(), "PASS\tnum--0"), "mut-control-unmutated-passes"); }
        else tk_ok(0, "mut-control-setup");
    }
    if (part == 1) {
        if (setup("if (neg && bits != 0) js_wc(w, '-');", "if (neg) js_wc(w, '-');")) {
            rc = child(); tk_ok(rc == 1 && tk_has(tk_out(), "FAIL\tnum--0"), "mut-negative-zero-sign-detected");
        } else tk_ok(0, "mut-negzero-setup");
    }
    if (part == 2) {
        if (setup("JS_EXP_HI = 21", "JS_EXP_HI = 20")) {
            rc = child(); tk_ok(rc == 1 && tk_has(tk_out(), "FAIL\tnum-123456789012345680000") && tk_has(tk_out(), "FAIL\tnum-below-1e21"), "mut-exponent-threshold-detected");
        } else tk_ok(0, "mut-threshold-setup");
    }
    if (part == 3) {
        if (setup("else if (c <= 0x1f) {", "else if (c <= 0x0f) {")) {
            rc = child(); tk_ok(rc == 1 && tk_has(tk_out(), "FAIL\tstr-escapes"), "mut-control-char-escape-detected");
        } else tk_ok(0, "mut-escape-setup");
    }
}

int main(int argc, char **argv) {
    tk_begin("");
    tk_cases_init(argc, argv);
    if (sy_cwd(root, sizeof root) < 0 || cx_fmt(com, sizeof com, "%s/unisacc.com", root)) return 2;
    if (tk_case("fixed")) group_fixed();
    if (tk_case("prop")) group_prop();
    if (tk_case("jsdiff")) group_jsdiff();
    if (tk_case("mutc")) group_mut(0);
    if (tk_case("mut1")) group_mut(1);
    if (tk_case("mut2")) group_mut(2);
    if (tk_case("mut3")) group_mut(3);
    return tk_end("CHECK_TEXTX_JSON_EMIT", 0);
}
