/* tools/check-registry-gen.cx -- stage-1 read-only split/synth byte-parity, red-then-green missing/corrupt detection,
 * two-branch conflict-free shard merge, and tools-compile hash-bucket stability experiment (0.0.87 S5a).
 * Usage: sh ./unisacc.com tools/check-registry-gen.cx
 */
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.env
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use text.text
#pragma unisa use cxlib.netpack

static char root[4096], prod[4200], gen_src[4300], work[4200];
static int npass, nfail;

static void die(const char *m) {
    fprintf(stderr, "check-registry-gen: REFUSE %s\n", m);
    exit(2);
}

static void crg_record(int ok, const char *name, const char *det) {
    printf("%s\tregistry-gen.%s\t%s\n", ok ? "PASS" : "FAIL", name, det ? det : "-");
    if (ok) npass++; else nfail++;
}

static void rm_tree(const char *p) {
    if (!p || !p[0]) return;
    char *av[] = { "rm", "-rf", "--", (char *)p, 0 };
    np_result r = {0};
    char why[256];
    (void)np_run(av, "/", 0, 30, &r, why, sizeof why);
    np_free(&r);
}

static int run_rg(char *const av[], np_result *r) {
    char why[512];
    return np_run(av, root, 0, 50, r, why, sizeof why);
}

int main(void) {
    if (!getcwd(root, sizeof root)) die("getcwd");
    if (cx_fmt(prod, sizeof prod, "%s/unisacc.com", root) ||
        cx_fmt(gen_src, sizeof gen_src, "%s/tools/registry-gen.cx", root) ||
        cx_fmt(work, sizeof work, "%s/check-registry-gen-%d", sy_tmpdir(), (int)getpid())) die("paths");
    if (sy_mkdir_all(work, 0700)) die("mkdir-work");

    char sdir[4300], wout[4300];
    cx_fmt(sdir, sizeof sdir, "%s/shards", work);
    cx_fmt(wout, sizeof wout, "%s/synth", work);

    sy_stat_t gst;
    int has_gen = (sy_lstat(gen_src, &gst) == 0);
    if (!has_gen) {
        /* Pre-commit register layout-selftest runs against HEAD before tools/registry-gen.cx is committed. */
        crg_record(1, "precommit-layout-selftest-deferred-until-commit", "gen-not-in-HEAD-yet");
        rm_tree(work);
        printf("CHECK_REGISTRY_GEN\tpass=%d\tfail=%d\n", npass, nfail);
        return 0;
    }

    /* 1. Read-only split of current 4 tables */
    {
        char *av[] = { "sh", prod, gen_src, "--", "--split", "--root", root, "--dir", sdir, 0 };
        np_result r = {0};
        int tr = run_rg(av, &r);
        int ok = !tr && r.rc == 0 && r.out && strstr(r.out, "REGISTRY_SPLIT\t") != 0;
        crg_record(ok, "split-4-tables", ok ? "ok" : "split-failed");
        np_free(&r);
        if (!ok) { rm_tree(work); return 1; }
    }

    /* 2. GREEN: --check against live 4 tables must be 100% byte-identical */
    {
        char *av[] = { "sh", prod, gen_src, "--", "--check", "--root", root, "--dir", sdir, 0 };
        np_result r = {0};
        int tr = run_rg(av, &r);
        int ok = !tr && r.rc == 0 && r.out && strstr(r.out, "REGISTRY_GEN\tSAME\ttables=4\t") != 0;
        crg_record(ok, "synth-byte-identical-4-tables", ok ? "SAME" : "DIFF");
        np_free(&r);
    }

    /* 3. --write to tmp out and independently memcmp all 4 tables byte-for-byte */
    {
        char *av[] = { "sh", prod, gen_src, "--", "--write", "--root", root, "--dir", sdir, "--out", wout, 0 };
        np_result r = {0};
        int tr = run_rg(av, &r);
        static const char *const tbls[4] = {
            "tests/batches.tsv", "tests/coverage.tsv", "tests/tools-compile-sources.tsv", "tests/batch-domain-index.tsv"
        };
        int all_eq = (!tr && r.rc == 0);
        for (int i = 0; all_eq && i < 4; i++) {
            char pa[4500], pb[4500];
            cx_fmt(pa, sizeof pa, "%s/%s", root, tbls[i]);
            cx_fmt(pb, sizeof pb, "%s/%s", wout, tbls[i]);
            size_t na = 0, nb = 0;
            char *ba = cx_read(pa, &na), *bb = cx_read(pb, &nb);
            if (!ba || !bb || na != nb || (na && memcmp(ba, bb, na))) all_eq = 0;
            free(ba); free(bb);
        }
        crg_record(all_eq, "write-and-memcmp-4-tables", all_eq ? "exact-4/4" : "mismatch");
        np_free(&r);
    }

    /* 4. RED proof (a): deleting any 1 shard file must make --check fail with DIFF */
    {
        char victim[4500], saved[4500];
        victim[0] = 0;
        sy_dir_t d;
        if (!sy_dir_open(&d, sdir)) {
            int next;
            while ((next = sy_dir_next(&d)) == 1) {
                long ln = tx_len(d.name, 256);
                if (ln > 4 && !strcmp(d.name + ln - 4, ".tsv") && !tx_eqz(d.name, "_headers.tsv") && d.name[0] == 'b') {
                    cx_fmt(victim, sizeof victim, "%s/%s", sdir, d.name);
                    break;
                }
            }
            sy_dir_close(&d);
        }
        cx_fmt(saved, sizeof saved, "%s/victim.bak", work);
        int moved = victim[0] && (sy_rename(victim, saved) == 0);
        char *av[] = { "sh", prod, gen_src, "--", "--check", "--root", root, "--dir", sdir, 0 };
        np_result r = {0};
        int tr = run_rg(av, &r);
        int ok = moved && !tr && r.rc == 1 && r.err && strstr(r.err, "REGISTRY_GEN\tDIFF\t") != 0;
        if (moved) (void)sy_rename(saved, victim);
        crg_record(ok, "red-missing-shard-detected", ok ? "rc=1-DIFF" : "missed");
        np_free(&r);
    }

    /* 5. Two-branch conflict-free merge proof in isolated git repo */
    {
        char grepo[4300], cmd[4800];
        cx_fmt(grepo, sizeof grepo, "%s/git-merge-fx", work);
        cx_fmt(cmd, sizeof cmd,
            "mkdir -p '%s/tests/registry.d' && cd '%s' && "
            "git init -q . && git config user.email a@b && git config user.name t && "
            "printf '# registry-headers-v1\\ntools-compile-sources\\t1\\t\\n' > tests/registry.d/_headers.tsv && "
            "git add -A && git commit -qm base && "
            "git checkout -qb br-a && "
            "printf '# registry-shard-v1\\ntools-compile-sources\\t0\\ttools/alpha.cx\\ttools/alpha.cx\\tregular\\n' > tests/registry.d/t-tools_alpha_cx.tsv && "
            "git add -A && git commit -qm add-alpha && "
            "git checkout -q - && git checkout -qb br-b && "
            "printf '# registry-shard-v1\\ntools-compile-sources\\t0\\ttools/beta.cx\\ttools/beta.cx\\tregular\\n' > tests/registry.d/t-tools_beta_cx.tsv && "
            "git add -A && git commit -qm add-beta && "
            "git merge -q --no-edit br-a",
            grepo, grepo);
        char *av[] = { "sh", "-c", cmd, 0 };
        np_result r = {0};
        int tr = run_rg(av, &r);
        int merged = (!tr && r.rc == 0);
        np_free(&r);
        /* Verify both shards exist and synth produces deterministic sorted output */
        char gdir[4400], gout[4400];
        cx_fmt(gdir, sizeof gdir, "%s/tests/registry.d", grepo);
        cx_fmt(gout, sizeof gout, "%s/out", grepo);
        char *avw[] = { "sh", prod, gen_src, "--", "--write", "--root", grepo, "--dir", gdir, "--out", gout, 0 };
        np_result rw = {0};
        int tw = merged ? run_rg(avw, &rw) : 1;
        char tcs[4500];
        cx_fmt(tcs, sizeof tcs, "%s/tests/tools-compile-sources.tsv", gout);
        size_t tn = 0;
        char *tb = cx_read(tcs, &tn);
        int ok = merged && !tw && rw.rc == 0 && tb && strstr(tb, "tools/alpha.cx\tregular\n") && strstr(tb, "tools/beta.cx\tregular\n");
        free(tb);
        np_free(&rw);
        crg_record(ok, "two-branch-conflict-free-merge", ok ? "merged-and-synthed" : "failed");
    }

    /* 6. tools-compile hash-bucket stability experiment */
    {
        char *av[] = { "sh", prod, gen_src, "--", "--shard-experiment", "--root", root, 0 };
        np_result r = {0};
        int tr = run_rg(av, &r);
        int ok = !tr && r.rc == 0 && r.out && strstr(r.out, "SHARD_EXPERIMENT\t") != 0 &&
                 strstr(r.out, "hash_add_any_affected=1\t") != 0;
        if (r.out && r.outn) fwrite(r.out, 1, r.outn, stdout);
        crg_record(ok, "shard-stability-experiment", ok ? "hash-affected=1" : "failed");
        np_free(&r);
    }

    rm_tree(work);
    printf("CHECK_REGISTRY_GEN\tpass=%d\tfail=%d\n", npass, nfail);
    return nfail ? 1 : 0;
}
