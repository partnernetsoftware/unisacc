#pragma unisa use cxlib.codec
#pragma unisa use cxlib.packagefooter
#pragma unisa use cxlib.netpack
static int failures;
static void check(int ok, const char *name) { printf("%s\t%s\n", ok ? "PASS" : "FAIL", name); if (!ok) failures++; }
static int number(const unsigned char *p, size_t n, size_t *at, unsigned long *out) {
    unsigned long v=0; int digits=0;
    while (*at<n && p[*at]>='0' && p[*at]<='9') { unsigned d=p[*at]-'0'; if(v>(ULONG_MAX-d)/10)return 0; v=v*10+d; (*at)++; digits=1; }
    *out=v; return digits;
}
static int delimiter(const unsigned char *p,size_t n,size_t *at,int ch) { if(*at>=n||p[*at]!=ch)return 0; (*at)++; return 1; }
static int real_member(CxCodecCrc *crc) {
    size_t n=0, at; unsigned char *file=(unsigned char *)cx_read("unisacc.com",&n), *raw=0; PackageFooter f;
    unsigned long models, stages, resources, packed, unpacked, format, expected; int ok=0;
    if(!file||n>2147483647||!packagefooter_locate_bytes(file,(long)n,&f))goto done;
    const unsigned char *p=file+f.package_offset; n=(size_t)f.package_length; at=4;
    if(n<4||memcmp(p,"P 3 ",4)||!number(p,n,&at,&models)||!delimiter(p,n,&at,' ')||
       !number(p,n,&at,&stages)||!delimiter(p,n,&at,' ')||!number(p,n,&at,&resources)||!delimiter(p,n,&at,'\n')||!models)goto done;
    for(unsigned long i=0;i<stages;i++){while(at<n&&p[at]!='\n')at++;if(!delimiter(p,n,&at,'\n'))goto done;}
    for(unsigned long i=0;i<models;i++) {
        if(!delimiter(p,n,&at,'M')||!delimiter(p,n,&at,' ')||!number(p,n,&at,&packed)||!delimiter(p,n,&at,' ')||
           !number(p,n,&at,&unpacked)||!delimiter(p,n,&at,' ')||!number(p,n,&at,&format)||!delimiter(p,n,&at,' ')||
           !number(p,n,&at,&expected)||!delimiter(p,n,&at,'\n')||format!=1||packed>n-at||unpacked>2147483647UL)goto done;
        raw=malloc(unpacked?unpacked:1); if(!raw)goto done;
        if(cxcodec_inflate(raw,unpacked,p+at,packed) || cxcodec_crc(crc,(char *)raw,(int)unpacked)!=expected || unpacked<9 || memcmp(raw,"UNINETB1N",9))goto done;
        free(raw); raw=0; at+=packed;
    }
    ok=1;
done: free(raw); free(file); return ok;
}
int main(void) {
    CxCodecCrc a, b; unsigned char out[6] = {0};
    const unsigned char compressed[] = {0xcb,0x48,0xcd,0xc9,0xc9,0x07,0x00};
    const unsigned char extended[] = {0xcb,0x48,0xcd,0xc9,0xc9,0x07,0x00,0x00};
    check(!cxcodec_crc_init(&a) && !cxcodec_crc_init(&b), "independent-tables");
    check(cxcodec_crc(&a, "123456789", 9) == 0xcbf43926U && cxcodec_crc(&b, "", 0) == 0, "crc32-vectors");
    check(!cxcodec_inflate(out, 5, compressed, sizeof compressed) && !memcmp(out, "hello", 5), "inflate-known");
    check(cxcodec_inflate(out, 5, compressed, sizeof compressed - 1) != 0, "truncated-rejected");
    check(cxcodec_inflate(out, 5, extended, sizeof extended) != 0, "trailing-rejected");
    check(cxcodec_inflate(out, 4, compressed, sizeof compressed) != 0, "short-output-rejected");
    check(cxcodec_inflate(0, 5, compressed, sizeof compressed) != 0, "null-output-rejected");
    check(real_member(&a), "installed-p3-all-members-inflate-crc");
    printf("CXCODEC\tfailed=%d\n", failures); return failures ? 1 : 0;
}
