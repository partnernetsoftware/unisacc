/* Independent CX0 stage CLI. Caller owns a <=60s process-tree watchdog.
 * plan|interface EXISTING_INTERFACE_DIRECTORY SOURCE [SOURCE ...] */
#pragma unisa use cx0.plan
int main(int argc,char **argv){
 if(argc<4||(strcmp(argv[1],"plan")&&strcmp(argv[1],"interface"))){fputs("usage: plan|interface INTERFACE_DIRECTORY SOURCE [SOURCE ...]\n",stderr);return 2;}
 cx0_result r=cx0_plan(!strcmp(argv[1],"interface"),argv+3,argc-3,0,0,argv[2]);
 int rc=r.status;if(r.bytes&&fwrite(r.text,1,r.bytes,stdout)!=r.bytes)rc=2;
 if(r.diagnostic_bytes&&fwrite(r.diagnostic,1,r.diagnostic_bytes,stderr)!=r.diagnostic_bytes)rc=2;
 cx0_release(&r);return rc;
}
