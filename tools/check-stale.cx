/* Checks tools/stale.cx: sh ./unisacc.com tools/check-stale.cx   (from the repo root)
   Over tools/stale/fixture/: a-target-stale.md is named by b-refers-stale.md (refs=1, not listed at the
   default --refs-max 0); b-refers-stale.md and c-orphan-stale.md are named by nobody (listed, refs=0);
   --refs-max 1 lists all three; --days 100000 lists none.  The fixture must be committed (stale reads
   git ls-files).  Prints PASS/FAIL lines and CHECK_STALE<TAB>failed=N. */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use text.text

static int failed;
static void ck(int ok, const char *name) { if (!ok) failed++; printf("%s\tstale.%s\n", ok ? "PASS" : "FAIL", name); }

static int st(char **args, char *out, long cap) {
    char *argv[12]; int i = 0, k, ofd, pid, ex = 0, code = 0, sig = 0; long n = 0, r; char junk[4096];
    argv[i++] = "sh"; argv[i++] = "./unisacc.com"; argv[i++] = "tools/stale.cx"; argv[i++] = "--";
    for (k = 0; args[k] && i < 11; k++) argv[i++] = args[k];
    argv[i] = 0;
    pid = sy_spawn_pipe(argv, 0, 0, &ofd, 0);
    if (pid < 0) return -1;
    while ((r = sy_read(ofd, out + n, cap - 1 - n)) > 0) n += r;
    out[n] = 0;
    while (sy_read(ofd, junk, sizeof junk) > 0) {}
    sy_close(ofd);
    if (sy_wait_status(pid, 0, &ex, &code, &sig) != pid || !ex) return -1;
    return code;
}
static int has(const char *o, const char *s) { return tx_find(o, tx_len(o, 1 << 16), s, tx_len(s, 256)) >= 0; }

int main(void) {
    static char o[1 << 16]; int rc;
    {   char *a[] = {"tools/stale/fixture/", 0}; rc = st(a, o, sizeof o); }
    ck(rc == 0 && has(o, "refs=0\t") && has(o, "\ttools/stale/fixture/b-refers-stale.md\t") && has(o, "\ttools/stale/fixture/c-orphan-stale.md\t")
       && !has(o, "a-target-stale.md\t") && has(o, "STALE\tcandidates=3\tlisted=2\t"), "orphans-listed-referenced-not");
    {   char *a[] = {"--refs-max", "1", "tools/stale/fixture/", 0}; rc = st(a, o, sizeof o); }
    ck(rc == 0 && has(o, "refs=1\t") && has(o, "\ttools/stale/fixture/a-target-stale.md\ttools/stale/fixture/b-refers-stale.md\n") && has(o, "listed=3\t"), "refs-max-1-names-the-referrer");
    {   char *a[] = {"--days", "100000", "tools/stale/fixture/", 0}; rc = st(a, o, sizeof o); }
    ck(rc == 0 && has(o, "listed=0\t"), "days-filter");
    printf("CHECK_STALE\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
