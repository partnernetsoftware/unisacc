/* tools/check-migration-admission-gen.cx -- Self-contained verification for tools/migration-admission-gen.cx.
 *
 * Verifies:
 *   (1) Real repo plans/migration-admission.tsv passes formal --check (594 rows = 99 x 6, target col)
 *   (2) Hand-edit detection: mutating any metric or verdict in migration-admission.tsv makes --check RED
 *   (3) Independent expect-table producer (--build-expect from chain candidate receipt + CI run record +
 *       plans/migration-approved-producers.tsv) -> rc_verify_out -> ADMIT + exact derived cost 49.800
 *   (4) Formal refusal of unapproved and synthetic producers (both in --build-expect and in --check)
 *   (5) Strict parsing negative controls:
 *       - embedded NUL in verified output_bytes -> refused (embedded-nul)
 *       - duplicate metric key in verified output_bytes -> refused (duplicate-metric-key, no first-match)
 *       - missing/bad header in expect-tsv -> refused (expect-tsv-bad-header)
 *       - embedded NUL in expect-tsv -> refused (embedded-nul)
 *       - unknown unit in expect-tsv -> refused (expect-unknown-unit, not silently ignored)
 *       - unknown target in expect-tsv -> refused (expect-unknown-target, not silently ignored)
 *   (6) Receipt verification negative controls:
 *       - tampered output, tampered target, wrong candidate_sha, stale ts, v2 legacy receipt -> all refused
 */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.io
#pragma unisa use sys.posix
#pragma unisa use sys.sha
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use cxlib.procrun
#pragma unisa use cxlib.receipt

static int g_pass = 0;
static int g_fail = 0;

static void ck(int cond, const char *name) {
    if (cond) { g_pass++; sy_printf("PASS\tcheck-migration-admission-gen.%s\n", name); }
    else { g_fail++; sy_printf("FAIL\tcheck-migration-admission-gen.%s\n", name); }
}

static int run_av(char **av, char *out, long cap) {
    int cut = 0;
    int rc = pr_run_merged(av, 30, out, (int)cap, &cut);
    return cut ? -1 : rc;
}

static int write_str(const char *path, const char *s) {
    return sy_write_file(path, (const unsigned char *)s, (long)strlen(s), 0644);
}

static int setup_mini_repo(const char *dir) {
    char p[1024];
    (void)sy_mkdir(dir, 0755);
    cx_fmt(p, sizeof p, "%s/plans", dir); (void)sy_mkdir(p, 0755);
    cx_fmt(p, sizeof p, "%s/plans/migration-cost-model.tsv", dir);
    if (write_str(p, "base_us\t10.68\nus_per_step\t0.00177\n") != 0) return 1;
    cx_fmt(p, sizeof p, "%s/plans/slice-units.tsv", dir);
    if (write_str(p,
                  "# key\tsource\n"
                  "m53.o\tcx/runtime/stream_attributes.cx\n"
                  "m25.o\tcx/driver/driveargs.cx\n") != 0) return 1;
    cx_fmt(p, sizeof p, "%s/plans/migration-admission-meta.tsv", dir);
    if (write_str(p,
                  "unit\tdest_class\tpath\tbudget_us\tbridge_shape\tsource_kind\tlive_bytes\tobj_bytes\tgen_friendly\tentries_n\n"
                  "m53.o\ttape VM\thot\t500.0\tbin2\tgenerator\t20723\t29410\tbase-only\t1\n"
                  "m25.o\ttable\tstartup\t100.0\tdriveargs\ttable\t1200\t9405\tyes\t1\n") != 0) return 1;
    cx_fmt(p, sizeof p, "%s/plans/migration-approved-producers.tsv", dir);
    if (write_str(p,
                  "unit\ttarget\tproducer\tpurpose\tformal\n"
                  "m53.o\tosx/arm64\tosx-m53-s1-parity\ts1-parity\tyes\n"
                  "m53.o\twin/arm64\tsynthetic-helper\ts1-parity\tno\n") != 0) return 1;
    return 0;
}

int main(void) {
    char tmp[512], gen_bin[600], repo[600], ma_p[600], rcpt_p[600], out_p[600], exp_p[600];
    char chain_p[600], ci_p[600], bad_ci[600], bad_rcpt[600], bad_out[600], bad_exp[600];
    char out[16384];
    char cand_sha[65], in_sha[65], out_sha[65];
    const char *rev = "ce72dabc80000000000000000000000000000000";
    const char *exp_hdr = "unit\ttarget\treceipt_path\toutput_path\trun_id\trev\tcandidate_sha\tinputs_sha\tproducer\tpurpose\tnow_ts\n";

    if (sy_mkdtemp(sy_tmpdir(), "chk-mag-", tmp, sizeof tmp) != 0) {
        sy_printf("CHECK_MIGRATION_ADMISSION_GEN\tpassed=0\tfailed=1\n");
        return 1;
    }
    cx_fmt(gen_bin, sizeof gen_bin, "%s/mag_bin", tmp);
    cx_fmt(repo, sizeof repo, "%s/repo", tmp);
    cx_fmt(ma_p, sizeof ma_p, "%s/plans/migration-admission.tsv", repo);
    cx_fmt(rcpt_p, sizeof rcpt_p, "%s/m53_osx_arm64.rcpt", tmp);
    cx_fmt(out_p, sizeof out_p, "%s/m53_osx_arm64.out", tmp);
    cx_fmt(exp_p, sizeof exp_p, "%s/expect.tsv", tmp);
    cx_fmt(chain_p, sizeof chain_p, "%s/chain.rcpt", tmp);
    cx_fmt(ci_p, sizeof ci_p, "%s/ci.rec", tmp);
    cx_fmt(bad_ci, sizeof bad_ci, "%s/bad_ci.rec", tmp);
    cx_fmt(bad_rcpt, sizeof bad_rcpt, "%s/bad.rcpt", tmp);
    cx_fmt(bad_out, sizeof bad_out, "%s/bad.out", tmp);
    cx_fmt(bad_exp, sizeof bad_exp, "%s/bad_expect.tsv", tmp);

    /* Compile generator once for fast repeated invocations */
    {
        char *av_c[] = {"sh", "./unisacc.com", "tools/migration-admission-gen.cx", "-o", gen_bin, 0}; /* lint:allow R1-product compiles generator binary */
        ck(run_av(av_c, out, sizeof out) == 0 && sy_exists(gen_bin) == 1, "compile-generator");
    }

    if (sy_exists(gen_bin) == 1) {
        /* 1. Real repo --check + row count = 594 (99 x 6) + target column */
        {
            char *av[] = {gen_bin, "--check", "--repo", ".", 0};
            int rc = run_av(av, out, sizeof out);
            unsigned char *raw = 0; int64_t rn = 0;
            int rows = 0, has_hdr = 0;
            if (sy_read_file("plans/migration-admission.tsv", &raw, &rn, 4 << 20) == 0 && raw) {
                long i = 0;
                has_hdr = (strncmp((const char *)raw, "unit\ttarget\tdest_class\t", 23) == 0);
                while (i < rn) {
                    long e = i;
                    while (e < rn && raw[e] != '\n') e++;
                    if (e > i && raw[i] != '#' && !(i == 0 && has_hdr)) rows++;
                    i = e + 1;
                }
                mm_free(raw);
            }
            ck(rc == 0 && strstr(out, "status=OK") != 0 && has_hdr && rows == 594, "real-repo-check-594-rows");
        }

        if (setup_mini_repo(repo) == 0) {
            char *av_w[] = {gen_bin, "--write", "--repo", repo, 0};
            char *av_k[] = {gen_bin, "--check", "--repo", repo, 0};
            ck(run_av(av_w, out, sizeof out) == 0 && run_av(av_k, out, sizeof out) == 0 && strstr(out, "status=OK") != 0,
               "mini-write-and-check-ok");

            /* 2. Hand-edit -> --check RED */
            {
                unsigned char *mb = 0; int64_t mn = 0;
                int drift_ok = 0;
                if (sy_read_file(ma_p, &mb, &mn, 1 << 20) == 0 && mb) {
                    char *pos = strstr((char *)mb, "PENDING");
                    if (pos) {
                        mm_copy(pos, 7, "ADMIT  ", 7);
                        (void)sy_write_file(ma_p, mb, (long)mn, 0644);
                        drift_ok = (run_av(av_k, out, sizeof out) != 0 && strstr(out, "status=DRIFT") != 0);
                    }
                    mm_free(mb);
                }
                ck(drift_ok, "hand-edit-causes-check-red");
            }

            /* 3. Independent --build-expect (chain receipt + CI run record + approved-producers) -> rc_verify_out -> ADMIT */
            {
                const char *metric_out =
                    "golden_kind\tenum-full\n"
                    "golden_cases\t288\n"
                    "golden_pass\t288\n"
                    "calls_per_run\t4\n"
                    "steps_per_call\t1000\n"
                    "blockers_n\t0\n"
                    "size_delta\t-8687\n";
                rc_v3_t rec;
                char chain_buf[512], ci_buf[512], exp_buf[2048];
                (void)write_str(out_p, metric_out);
                sy_sha256_hex((const unsigned char *)"real-candidate-ape-v019", 23, cand_sha);
                sy_sha256_hex((const unsigned char *)"real-inputs-bundle-v019", 23, in_sha);
                sy_sha256_hex((const unsigned char *)metric_out, (int64_t)strlen(metric_out), out_sha);

                cx_fmt(chain_buf, sizeof chain_buf, "PROMOTE_CHECK rev=%s ape_sha=%s\n", rev, cand_sha);
                (void)write_str(chain_p, chain_buf);
                cx_fmt(ci_buf, sizeof ci_buf,
                       "unit\tm53.o\ntarget\tosx/arm64\nrun_id\tci-1001-osx-arm64\n"
                       "producer\tosx-m53-s1-parity\npurpose\ts1-parity\nnow_ts\t1764200060\n");
                (void)write_str(ci_p, ci_buf);

                rec.run_id = "ci-1001-osx-arm64";
                rec.rev = rev;
                rec.unit = "m53.o";
                rec.target = "osx/arm64";
                rec.producer = "osx-m53-s1-parity";
                rec.purpose = "s1-parity";
                rec.candidate_sha = cand_sha;
                rec.inputs_sha = in_sha;
                rec.output_sha = out_sha;
                rec.rc = 0;
                rec.verdict = "PASS";
                rec.ts = 1764200000;
                ck(rc_write3(rcpt_p, &rec) == 0, "write-v3-receipt");

                {
                    char *av_be[] = {gen_bin, "--build-expect", "--repo", repo, "--chain-receipt", chain_p,
                                     "--ci-record", ci_p, "--receipt-file", rcpt_p, "--output-file", out_p,
                                     "--inputs-sha", in_sha, "--out", exp_p, 0};
                    int rb = run_av(av_be, out, sizeof out);
                    ck(rb == 0 && strstr(out, "mode=build-expect") != 0 && sy_exists(exp_p) == 1,
                       "independent-build-expect");
                }

                {
                    char *av_we[] = {gen_bin, "--write", "--repo", repo, "--expect-tsv", exp_p, 0};
                    char *av_ke[] = {gen_bin, "--check", "--repo", repo, "--expect-tsv", exp_p, 0};
                    int r1 = run_av(av_we, out, sizeof out);
                    int r2 = run_av(av_ke, out, sizeof out);
                    unsigned char *mb = 0; int64_t mn = 0;
                    int has_admit = 0, other_pending = 0;
                    if (sy_read_file(ma_p, &mb, &mn, 1 << 20) == 0 && mb) {
                        has_admit = (strstr((const char *)mb, "m53.o\tosx/arm64\ttape VM\tenum-full\t288\t288\thot\t4\t1000\t49.800\t500.0\tbin2\t0\tgenerator\t20723\t29410\t-8687\tADMIT\t-") != 0);
                        other_pending = (strstr((const char *)mb, "m53.o\twin/arm64\ttape VM\tUNMEASURED\tUNMEASURED\tUNMEASURED\thot\tUNMEASURED\tUNMEASURED\tUNMEASURED\t500.0\tbin2\tUNMEASURED\tgenerator\t20723\t29410\tUNMEASURED\tPENDING\t-") != 0);
                        mm_free(mb);
                    }
                    ck(r1 == 0 && r2 == 0 && has_admit && other_pending, "verified-v3-receipt-generates-admit-and-derived-cost");
                }

                /* 4. Unapproved & synthetic producer refusal */
                {
                    cx_fmt(ci_buf, sizeof ci_buf,
                           "unit\tm53.o\ntarget\twin/arm64\nrun_id\tci-1002\n"
                           "producer\tsynthetic-helper\npurpose\ts1-parity\nnow_ts\t1764200060\n");
                    (void)write_str(bad_ci, ci_buf);
                    char *av_be[] = {gen_bin, "--build-expect", "--repo", repo, "--chain-receipt", chain_p,
                                     "--ci-record", bad_ci, "--receipt-file", rcpt_p, "--output-file", out_p,
                                     "--inputs-sha", in_sha, "--out", bad_exp, 0};
                    ck(run_av(av_be, out, sizeof out) != 0 && strstr(out, "expect-unapproved-producer") != 0,
                       "build-expect-refuses-synthetic-producer");
                }
                {
                    cx_fmt(exp_buf, sizeof exp_buf,
                           "%sm53.o\tosx/arm64\t%s\t%s\tci-1001-osx-arm64\t%s\t%s\t%s\tunapproved-prod\ts1-parity\t1764200060\n",
                           exp_hdr, rcpt_p, out_p, rev, cand_sha, in_sha);
                    (void)write_str(bad_exp, exp_buf);
                    char *av[] = {gen_bin, "--check", "--repo", repo, "--expect-tsv", bad_exp, 0};
                    ck(run_av(av, out, sizeof out) != 0 && strstr(out, "expect-unapproved-producer") != 0,
                       "gen-refuses-unapproved-producer");
                }

                /* 5. Strict parse negative controls: embedded NUL & duplicate metric key in verified output */
                {
                    unsigned char nul_out[128];
                    const char *prefix = "golden_kind\tenum-full\ngolden_cases\t10\ngolden_pass\t10\n";
                    long pl = (long)strlen(prefix);
                    mm_copy(nul_out, sizeof nul_out, prefix, pl);
                    nul_out[pl] = 0;
                    nul_out[pl + 1] = '\n';
                    (void)sy_write_file(bad_out, nul_out, pl + 2, 0644);
                    sy_sha256_hex(nul_out, (int64_t)(pl + 2), out_sha);
                    rec.output_sha = out_sha;
                    (void)rc_write3(bad_rcpt, &rec);
                    cx_fmt(exp_buf, sizeof exp_buf,
                           "%sm53.o\tosx/arm64\t%s\t%s\tci-1001-osx-arm64\t%s\t%s\t%s\tosx-m53-s1-parity\ts1-parity\t1764200060\n",
                           exp_hdr, bad_rcpt, bad_out, rev, cand_sha, in_sha);
                    (void)write_str(bad_exp, exp_buf);
                    char *av[] = {gen_bin, "--check", "--repo", repo, "--expect-tsv", bad_exp, 0};
                    ck(run_av(av, out, sizeof out) != 0 && strstr(out, "embedded-nul") != 0, "refuse-output-embedded-nul");
                }
                {
                    const char *dup_out =
                        "golden_kind\tenum-full\n"
                        "golden_cases\t288\n"
                        "golden_pass\t288\n"
                        "golden_pass\t0\n"
                        "calls_per_run\t4\n"
                        "steps_per_call\t1000\n"
                        "blockers_n\t0\n";
                    (void)write_str(bad_out, dup_out);
                    sy_sha256_hex((const unsigned char *)dup_out, (int64_t)strlen(dup_out), out_sha);
                    rec.output_sha = out_sha;
                    (void)rc_write3(bad_rcpt, &rec);
                    cx_fmt(exp_buf, sizeof exp_buf,
                           "%sm53.o\tosx/arm64\t%s\t%s\tci-1001-osx-arm64\t%s\t%s\t%s\tosx-m53-s1-parity\ts1-parity\t1764200060\n",
                           exp_hdr, bad_rcpt, bad_out, rev, cand_sha, in_sha);
                    (void)write_str(bad_exp, exp_buf);
                    char *av[] = {gen_bin, "--check", "--repo", repo, "--expect-tsv", bad_exp, 0};
                    ck(run_av(av, out, sizeof out) != 0 && strstr(out, "duplicate-metric-key") != 0, "refuse-output-duplicate-metric");
                }

                /* 6. Strict expect-tsv negative controls: bad header, embedded NUL, unknown unit, unknown target */
                {
                    cx_fmt(exp_buf, sizeof exp_buf,
                           "m53.o\tosx/arm64\t%s\t%s\tci-1001-osx-arm64\t%s\t%s\t%s\tosx-m53-s1-parity\ts1-parity\t1764200060\n",
                           rcpt_p, out_p, rev, cand_sha, in_sha);
                    (void)write_str(bad_exp, exp_buf);
                    char *av[] = {gen_bin, "--check", "--repo", repo, "--expect-tsv", bad_exp, 0};
                    ck(run_av(av, out, sizeof out) != 0 && strstr(out, "expect-tsv-bad-header") != 0, "refuse-expect-missing-header");
                }
                {
                    unsigned char nexp[256];
                    long hl = (long)strlen(exp_hdr);
                    mm_copy(nexp, sizeof nexp, exp_hdr, hl);
                    nexp[hl] = 0; nexp[hl + 1] = '\n';
                    (void)sy_write_file(bad_exp, nexp, hl + 2, 0644);
                    char *av[] = {gen_bin, "--check", "--repo", repo, "--expect-tsv", bad_exp, 0};
                    ck(run_av(av, out, sizeof out) != 0 && strstr(out, "embedded-nul") != 0, "refuse-expect-embedded-nul");
                }
                {
                    cx_fmt(exp_buf, sizeof exp_buf,
                           "%sghost.o\tosx/arm64\t%s\t%s\tci-1001-osx-arm64\t%s\t%s\t%s\tosx-m53-s1-parity\ts1-parity\t1764200060\n",
                           exp_hdr, rcpt_p, out_p, rev, cand_sha, in_sha);
                    (void)write_str(bad_exp, exp_buf);
                    char *av[] = {gen_bin, "--check", "--repo", repo, "--expect-tsv", bad_exp, 0};
                    ck(run_av(av, out, sizeof out) != 0 && strstr(out, "expect-unknown-unit") != 0, "refuse-expect-unknown-unit");
                }
                {
                    cx_fmt(exp_buf, sizeof exp_buf,
                           "%sm53.o\tbsd/x86_64\t%s\t%s\tci-1001-osx-arm64\t%s\t%s\t%s\tosx-m53-s1-parity\ts1-parity\t1764200060\n",
                           exp_hdr, rcpt_p, out_p, rev, cand_sha, in_sha);
                    (void)write_str(bad_exp, exp_buf);
                    char *av[] = {gen_bin, "--check", "--repo", repo, "--expect-tsv", bad_exp, 0};
                    ck(run_av(av, out, sizeof out) != 0 && strstr(out, "expect-unknown-target") != 0, "refuse-expect-unknown-target");
                }

                /* 7. Receipt verification negative controls: tampered output, tampered target, wrong candidate, stale ts, v2 legacy */
                {
                    (void)write_str(bad_out, "golden_kind\tenum-full\ngolden_cases\t999\n");
                    cx_fmt(exp_buf, sizeof exp_buf,
                           "%sm53.o\tosx/arm64\t%s\t%s\tci-1001-osx-arm64\t%s\t%s\t%s\tosx-m53-s1-parity\ts1-parity\t1764200060\n",
                           exp_hdr, rcpt_p, bad_out, rev, cand_sha, in_sha);
                    (void)write_str(bad_exp, exp_buf);
                    char *av[] = {gen_bin, "--check", "--repo", repo, "--expect-tsv", bad_exp, 0};
                    ck(run_av(av, out, sizeof out) != 0 && strstr(out, "output-mismatch") != 0, "refuse-tampered-output");
                }
                {
                    unsigned char *rb = 0; int64_t rn = 0;
                    int tok = 0;
                    if (sy_read_file(rcpt_p, &rb, &rn, 65536) == 0 && rb) {
                        char *pos = strstr((char *)rb, "target\tosx/arm64");
                        if (pos) {
                            mm_copy(pos, 16, "target\twin/arm64", 16);
                            (void)sy_write_file(bad_rcpt, rb, (long)rn, 0644);
                            cx_fmt(exp_buf, sizeof exp_buf,
                                   "%sm53.o\tosx/arm64\t%s\t%s\tci-1001-osx-arm64\t%s\t%s\t%s\tosx-m53-s1-parity\ts1-parity\t1764200060\n",
                                   exp_hdr, bad_rcpt, out_p, rev, cand_sha, in_sha);
                            (void)write_str(bad_exp, exp_buf);
                            char *av[] = {gen_bin, "--check", "--repo", repo, "--expect-tsv", bad_exp, 0};
                            tok = (run_av(av, out, sizeof out) != 0 &&
                                   (strstr(out, "bad-binding") != 0 || strstr(out, "target-mismatch") != 0));
                        }
                        mm_free(rb);
                    }
                    ck(tok, "refuse-tampered-target");
                }
                {
                    char wrong_sha[65];
                    sy_sha256_hex((const unsigned char *)"wrong-candidate", 15, wrong_sha);
                    cx_fmt(exp_buf, sizeof exp_buf,
                           "%sm53.o\tosx/arm64\t%s\t%s\tci-1001-osx-arm64\t%s\t%s\t%s\tosx-m53-s1-parity\ts1-parity\t1764200060\n",
                           exp_hdr, rcpt_p, out_p, rev, wrong_sha, in_sha);
                    (void)write_str(bad_exp, exp_buf);
                    char *av[] = {gen_bin, "--check", "--repo", repo, "--expect-tsv", bad_exp, 0};
                    ck(run_av(av, out, sizeof out) != 0 && strstr(out, "candidate-mismatch") != 0, "refuse-wrong-candidate-sha");
                }
                {
                    cx_fmt(exp_buf, sizeof exp_buf,
                           "%sm53.o\tosx/arm64\t%s\t%s\tci-1001-osx-arm64\t%s\t%s\t%s\tosx-m53-s1-parity\ts1-parity\t1764400000\n",
                           exp_hdr, rcpt_p, out_p, rev, cand_sha, in_sha);
                    (void)write_str(bad_exp, exp_buf);
                    char *av[] = {gen_bin, "--check", "--repo", repo, "--expect-tsv", bad_exp, 0};
                    ck(run_av(av, out, sizeof out) != 0 && strstr(out, "ts-policy") != 0, "refuse-stale-ts");
                }
                {
                    (void)write_str(bad_rcpt,
                                    "run_id\tci-1001-osx-arm64\n"
                                    "candidate_sha\t1111111111111111111111111111111111111111111111111111111111111111\n"
                                    "inputs_sha\t2222222222222222222222222222222222222222222222222222222222222222\n"
                                    "output_sha\t3333333333333333333333333333333333333333333333333333333333333333\n"
                                    "producer_sha\t4444444444444444444444444444444444444444444444444444444444444444\n"
                                    "rc\t0\n"
                                    "binding_sha\t5555555555555555555555555555555555555555555555555555555555555555\n");
                    cx_fmt(exp_buf, sizeof exp_buf,
                           "%sm53.o\tosx/arm64\t%s\t%s\tci-1001-osx-arm64\t%s\t%s\t%s\tosx-m53-s1-parity\ts1-parity\t1764200060\n",
                           exp_hdr, bad_rcpt, out_p, rev, cand_sha, in_sha);
                    (void)write_str(bad_exp, exp_buf);
                    char *av[] = {gen_bin, "--check", "--repo", repo, "--expect-tsv", bad_exp, 0};
                    ck(run_av(av, out, sizeof out) != 0 && strstr(out, "v2-legacy") != 0, "refuse-v2-legacy-receipt");
                }
            }
        }
    }

    (void)sy_remove_all(tmp);
    sy_printf("CHECK_MIGRATION_ADMISSION_GEN\tpassed=%d\tfailed=%d\n", g_pass, g_fail);
    return g_fail ? 1 : 0;
}
