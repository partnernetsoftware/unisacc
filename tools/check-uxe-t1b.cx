#pragma unisa use cxlib.ckassert
#pragma unisa use chrome_dom
static int failed;
int main(void) {
    char cwd[512], url[700];
    const char *pre = "file://", *suf = "/ujs/practice/uxe/test/uxe-t1b-filter.html";
    char *av[12], *out = 0;
    size_t on = 0;
    int n, i, rc, nr = -1, lr = -1;
    const char *p;
    if (!getcwd(cwd, sizeof cwd)) return 2;
    n = 0;
    while (pre[n]) { url[n] = pre[n]; n++; }
    for (i = 0; cwd[i] && n < 500; i++) url[n++] = cwd[i];
    for (i = 0; suf[i] && n < 640; i++) url[n++] = suf[i];
    url[n] = 0;
    av[0] = "/usr/bin/google-chrome";
    av[1] = "--headless=new";
    av[2] = "--enable-unsafe-swiftshader";
    av[3] = "--allow-file-access-from-files";
    av[4] = "--disable-web-security";
    av[5] = "--no-first-run";
    av[6] = "--user-data-dir=/tmp/uxe-t1b";
    av[7] = "--virtual-time-budget=15000";
    av[8] = "--dump-dom";
    av[9] = url;
    av[10] = 0;
    rc = cx_runv_timeout(av, 25, &out, &on);
    if (rc == 127) { if (out) free(out); return 2; }
    p = out ? strstr(out, "\"n\":[") : 0;
    if (p) nr = atoi(p + 5);
    p = out ? strstr(out, "\"lin\":[") : 0;
    if (p) lr = atoi(p + 7);
    ck_record(&failed, nr != lr, "n-ne-lin");
    ck_record(&failed, lr > 80 && lr < 180, "lin-mid");
    if (out) free(out);
    printf("CHECK_UXE_T1B\tnr=%d\tlr=%d\tfailed=%d\n", nr, lr, failed);
    return failed ? 1 : 0;
}
