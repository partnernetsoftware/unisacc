/* tools/entry-link-material.cx -- Stepwise content-keyed lnx/x86_64 full-link material producer.
 *
 * Contract:
 *   sh ./unisacc.com tools/entry-link-material.cx -- ROOT OUTDIR --step
 *     Performs only the next missing stage (each <= 55 s):
 *       stage 1 (eb-bin):      compile OUTDIR/entry_build.bin
 *       stage 2 (roots):       compile all root objects via UNISACC_EB_PLAN_MEMO=OUTDIR/plan.memo
 *       stage 3 (closure1):    compile closure objects part 1 (odd + m55.o)
 *       stage 4 (closure2):    compile closure objects part 2 (even except m55.o)
 *       stage 5 (link-verify): --link-only + pure-.cx verification + write OUTDIR/material.tsv
 *     Exit 0 = complete (verified), 3 = more stages remain, anything else = failure/refusal.
 *
 *   sh ./unisacc.com tools/entry-link-material.cx -- ROOT OUTDIR --verify
 *     Pure-.cx verification of tree_id.sha, root.path, material.tsv, every *.o listed in
 *     receipt.txt against its .o.cache (object= + bytes=), entry.elf, candidate (nofollow).
 *     Exit 0 = verified, 2 = refused/tampered/stale.
 *
 * A receipt/material is never a PASS. */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.posix
#pragma unisa use sys.sha
#pragma unisa use sys.time
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use text.text
#pragma unisa use cxlib.procrun
#pragma unisa use cxlib.chainfacts
#pragma unisa use cxlib.receipt

static int is_hex64(const char *s) {
    int i;
    if (!s) return 0;
    for (i = 0; i < 64; i++) {
        char c = s[i];
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return 0;
    }
    return s[64] == 0 ? 1 : 0;
}

static int run_sh_cmd(const char *cmd, char *out, long cap) {
    char *av[] = {"sh", "-c", (char *)cmd, 0};
    int cut = 0;
    int rc = pr_run_merged(av, 52, out, (int)cap, &cut);
    return cut ? -1 : rc;
}

static int read_regular_nofollow(const char *path, unsigned char **out_buf, int64_t *out_len, int64_t max_bytes) {
    int dfd, fd;
    sy_stat_t st;
    unsigned char *buf;
    int64_t cap, len = 0;
    const char *sl, *leaf;
    char pdir[4400];
    *out_buf = 0;
    *out_len = 0;
    if (!path || !path[0]) return 1;
    sl = strrchr(path, '/');
    if (sl) {
        long dl = (long)(sl - path);
        if (dl == 0) { pdir[0] = '/'; pdir[1] = 0; }
        else if (dl >= (long)sizeof pdir) return 1;
        else { mm_copy(pdir, (long)sizeof pdir, path, dl); pdir[dl] = 0; }
        leaf = sl + 1;
    } else {
        pdir[0] = '.'; pdir[1] = 0;
        leaf = path;
    }
    if (!leaf[0]) return 1;
    dfd = sy_open_read(pdir);
    if (dfd < 0) return 1;
    fd = sy_openat_read_nofollow(dfd, leaf);
    sy_close(dfd);
    if (fd < 0) return 1;
    if (sy_fstat(fd, &st) != 0 || st.kind != 'f' || st.size < 0 || st.size > max_bytes) {
        sy_close(fd);
        return 1;
    }
    cap = st.size > 0 ? st.size : 1;
    buf = (unsigned char *)mm_alloc((size_t)(cap + 1));
    if (!buf) { sy_close(fd); return 1; }
    while (len < st.size) {
        long r = sy_read(fd, buf + len, (long)(st.size - len));
        if (r <= 0) { mm_free(buf); sy_close(fd); return 1; }
        len += r;
    }
    sy_close(fd);
    buf[len] = 0;
    *out_buf = buf;
    *out_len = len;
    return 0;
}

static int compute_tree_sha(const char *root, char tree_sha[65]) {
    char cmd[2048], out[256];
    cx_fmt(cmd, sizeof cmd,
           "cd '%s' && ({ for f in ./unisacc.com cxroot.tsv build/chain-facts.tsv tools/entry-build.cx "
           "tools/cxlib/chainfacts.cx tools/cxlib/procrun.cx tools/cxlib/receipt.cx "
           "tools/bound tools/entry-link-material.cx; do "
           "test -f \"$f\" && printf '%%s\\n' \"$f\"; done; "
           "for d in include src cx ext exec; do "
           "test -d \"$d\" && LC_ALL=C find \"$d\" -type f; done; } | "
           "LC_ALL=C sort -u | xargs sha256sum) | sha256sum | awk '{print $1}'",
           root);
    if (run_sh_cmd(cmd, out, sizeof out) != 0) return 1;
    {
        long ol = (long)strlen(out);
        while (ol > 0 && (out[ol - 1] == '\n' || out[ol - 1] == '\r')) out[--ol] = 0;
    }
    if (!is_hex64(out)) return 1;
    mm_copy(tree_sha, 65, out, 64);
    tree_sha[64] = 0;
    return 0;
}

static int verify_obj_cache_cx(const char *dir, const char *fn, const char *receipt_sha) {
    char objp[4400], cachep[4420], obj_sha[65], want_sha[65];
    int64_t obj_sz = 0, want_sz = -1;
    unsigned char *cb = 0;
    int64_t cn = 0;
    long pos = 0;
    int got_sha = 0, got_sz = 0;
    if (!fn || !fn[0]) return 1;
    for (const char *p = fn; *p; p++) {
        if (*p == '/' || (p[0] == '.' && p[1] == '.')) return 1;
    }
    cx_fmt(objp, sizeof objp, "%s/%s", dir, fn);
    cx_fmt(cachep, sizeof cachep, "%s/%s.cache", dir, fn);
    if (rc_regular_sha256_size(objp, obj_sha, &obj_sz, 32 << 20) != 0) return 1;
    if (!tx_eqz(obj_sha, receipt_sha)) return 1;
    if (read_regular_nofollow(cachep, &cb, &cn, 4096) != 0 || !cb || cn <= 0) {
        if (cb) mm_free(cb);
        return 1;
    }
    while (pos < (long)cn) {
        long e = pos;
        char line[256];
        while (e < (long)cn && cb[e] != '\n') e++;
        if (e - pos < (long)sizeof line) {
            long l = e - pos;
            while (l > 0 && cb[pos + l - 1] == '\r') l--;
            mm_copy(line, (long)sizeof line, cb + pos, l);
            line[l] = 0;
            if (strncmp(line, "object=", 7) == 0 && is_hex64(line + 7)) {
                mm_copy(want_sha, 65, line + 7, 64); want_sha[64] = 0;
                got_sha = 1;
            } else if (strncmp(line, "bytes=", 6) == 0 && rc_parse_u64_exact(line + 6, &want_sz) == 0) {
                got_sz = 1;
            }
        }
        pos = (e < (long)cn) ? (e + 1) : (long)cn;
    }
    mm_free(cb);
    return (got_sha && got_sz && tx_eqz(obj_sha, want_sha) && obj_sz == want_sz) ? 0 : 1;
}

static int verify_identity_dir(const char *root, const char *dir, const char *tree_sha, int allow_init) {
    char idp[4400], rp[4400], got[65], stored_root[4096];
    unsigned char *b = 0;
    int64_t n = 0;
    cx_fmt(idp, sizeof idp, "%s/tree_id.sha", dir);
    cx_fmt(rp, sizeof rp, "%s/root.path", dir);
    if (read_regular_nofollow(idp, &b, &n, 256) == 0 && b && n >= 64) {
        mm_copy(got, 65, b, 64); got[64] = 0;
        mm_free(b); b = 0;
        if (!tx_eqz(got, tree_sha)) return 2;
        if (read_regular_nofollow(rp, &b, &n, 4090) != 0 || !b || n <= 0) {
            if (b) mm_free(b);
            return 2;
        }
        {
            long rl = (long)n;
            while (rl > 0 && (b[rl - 1] == '\n' || b[rl - 1] == '\r')) rl--;
            mm_copy(stored_root, sizeof stored_root, b, rl);
            stored_root[rl] = 0;
            mm_free(b);
        }
        return tx_eqz(stored_root, root) ? 0 : 2;
    }
    if (b) mm_free(b);
    if (!allow_init) return 2;
    (void)sy_mkdir(dir, 0700);
    {
        char line[80], rline[4120];
        cx_fmt(line, sizeof line, "%s\n", tree_sha);
        cx_fmt(rline, sizeof rline, "%s\n", root);
        if (sy_write_file(idp, (const unsigned char *)line, (long)strlen(line), 0644) != 0 ||
            sy_write_file(rp, (const unsigned char *)rline, (long)strlen(rline), 0644) != 0) return 2;
    }
    return 0;
}

static int verify_complete_dir(const char *root, const char *dir, const char *tree_sha,
                               char cand_sha_out[65], char elf_sha_out[65], char rcpt_sha_out[65]) {
    char candp[4400], cshap[4400], rcptp[4400], matp[4400], ap[4400];
    char actual_cand[65], want_cand[65], got_sha[65], elf_sha[65], rcpt_sha[65];
    unsigned char *b = 0, *rb = 0;
    int64_t n = 0, rn = 0;
    long pos = 0;
    int n_objs = 0, seen_elf = 0, seen_cand = 0;

    if (verify_identity_dir(root, dir, tree_sha, 0) != 0) {
        sy_printf("FAIL\tENTRY_LINK_MATERIAL\treason=tree-id-or-root-mismatch\n");
        return 2;
    }
    cx_fmt(candp, sizeof candp, "%s/candidate", dir);
    cx_fmt(cshap, sizeof cshap, "%s/candidate.sha", dir);
    cx_fmt(rcptp, sizeof rcptp, "%s/receipt.txt", dir);
    cx_fmt(matp, sizeof matp, "%s/material.tsv", dir);
    if (rc_regular_sha256_size(candp, actual_cand, 0, 64 << 20) != 0 ||
        read_regular_nofollow(cshap, &b, &n, 256) != 0 || !b || n < 64) {
        if (b) mm_free(b);
        sy_printf("FAIL\tENTRY_LINK_MATERIAL\treason=material-artifact-missing\n");
        return 2;
    }
    mm_copy(want_cand, 65, b, 64); want_cand[64] = 0;
    mm_free(b);
    if (!tx_eqz(actual_cand, want_cand)) {
        sy_printf("FAIL\tENTRY_LINK_MATERIAL\treason=candidate-sha-mismatch\n");
        return 2;
    }
    if (read_regular_nofollow(rcptp, &rb, &rn, 4 << 20) != 0 || !rb || rn <= 0) {
        if (rb) mm_free(rb);
        sy_printf("FAIL\tENTRY_LINK_MATERIAL\treason=receipt-missing-or-symlink\n");
        return 2;
    }
    if (sy_sha256_hex(rb, rn, rcpt_sha) != 0) {
        mm_free(rb);
        return 2;
    }
    elf_sha[0] = 0;
    while (pos < (long)rn) {
        long e = pos;
        char line[1024];
        while (e < (long)rn && rb[e] != '\n') e++;
        if (e - pos > 0 && e - pos < (long)sizeof line) {
            long l = e - pos;
            char *t1, *p, *rsha = 0;
            while (l > 0 && rb[pos + l - 1] == '\r') l--;
            mm_copy(line, (long)sizeof line, rb + pos, l);
            line[l] = 0;
            t1 = strchr(line, '\t');
            if (t1) {
                *t1 = 0;
                p = t1 + 1;
                while (*p) {
                    char *nt = strchr(p, '\t');
                    if (nt) *nt = 0;
                    if (strncmp(p, "sha=", 4) == 0 && is_hex64(p + 4)) rsha = p + 4;
                    if (!nt) break;
                    p = nt + 1;
                }
                {
                    long fnl = (long)strlen(line);
                    if (fnl > 2 && line[fnl - 2] == '.' && line[fnl - 1] == 'o') {
                        if (!rsha || verify_obj_cache_cx(dir, line, rsha) != 0) {
                            mm_free(rb);
                            sy_printf("FAIL\tENTRY_LINK_MATERIAL\treason=object-cache-mismatch\n");
                            return 2;
                        }
                        n_objs++;
                    } else if (tx_eqz(line, "entry.elf") || tx_eqz(line, "candidate")) {
                        cx_fmt(ap, sizeof ap, "%s/%s", dir, line);
                        if (!rsha || rc_regular_sha256_size(ap, got_sha, 0, 64 << 20) != 0 || !tx_eqz(got_sha, rsha)) {
                            mm_free(rb);
                            sy_printf("FAIL\tENTRY_LINK_MATERIAL\treason=receipt-artifact-mismatch\n");
                            return 2;
                        }
                        if (tx_eqz(line, "entry.elf")) { seen_elf = 1; mm_copy(elf_sha, 65, got_sha, 65); }
                        if (tx_eqz(line, "candidate")) seen_cand = 1;
                    }
                }
            }
        }
        pos = (e < (long)rn) ? (e + 1) : (long)rn;
    }
    mm_free(rb);
    if (n_objs < cf_root_count() || !seen_elf || !seen_cand) {
        sy_printf("FAIL\tENTRY_LINK_MATERIAL\treason=receipt-incomplete\n");
        return 2;
    }
    if (cand_sha_out) mm_copy(cand_sha_out, 65, actual_cand, 65);
    if (elf_sha_out) mm_copy(elf_sha_out, 65, elf_sha, 65);
    if (rcpt_sha_out) mm_copy(rcpt_sha_out, 65, rcpt_sha, 65);
    return 0;
}

static int mark_done(const char *dir, int step) {
    char p[4400];
    cx_fmt(p, sizeof p, "%s/stage.%d.done", dir, step);
    return sy_write_file(p, (const unsigned char *)"done\n", 5, 0644);
}

static int is_done(const char *dir, int step) {
    char p[4400];
    cx_fmt(p, sizeof p, "%s/stage.%d.done", dir, step);
    return sy_exists(p) == 1 ? 1 : 0;
}

int main(int argc, char **argv) {
    char root[4096], dir[4096], tree_sha[65];
    char eb[4400], matp[4400], cmd[8192], out[16384];
    int mode_step = 0, mode_verify = 0;
    long t0;

    if (argc == 3 && tx_eqz(argv[1], "--fingerprint")) {
        if (argv[2][0] != '/' || sy_realpath(argv[2], root, sizeof root) < 0) return 2;
        if (compute_tree_sha(root, tree_sha) != 0) return 2;
        sy_printf("%s\n", tree_sha);
        return 0;
    }
    if (argc != 4) {
        sy_eprintf("entry-link-material: usage: ROOT OUTDIR --step|--verify | --fingerprint ROOT\n");
        return 2;
    }
    if (tx_eqz(argv[3], "--step")) mode_step = 1;
    else if (tx_eqz(argv[3], "--verify")) mode_verify = 1;
    else {
        sy_eprintf("entry-link-material: unknown flag %s\n", argv[3]);
        return 2;
    }
    if (argv[1][0] != '/' || argv[2][0] != '/' || sy_realpath(argv[1], root, sizeof root) < 0) {
        sy_eprintf("entry-link-material: ROOT and OUTDIR must be absolute paths\n");
        return 2;
    }
    cx_fmt(dir, sizeof dir, "%s", argv[2]);
    if (compute_tree_sha(root, tree_sha) != 0) {
        sy_eprintf("entry-link-material: failed to compute tree_sha\n");
        return 2;
    }

    if (mode_verify) {
        char csha[65], esha[65], rsha[65], msha[65];
        cx_fmt(matp, sizeof matp, "%s/material.tsv", dir);
        if (rc_regular_sha256_size(matp, msha, 0, 65536) != 0) {
            sy_printf("FAIL\tENTRY_LINK_MATERIAL\treason=material-tsv-missing\n");
            return 2;
        }
        if (verify_complete_dir(root, dir, tree_sha, csha, esha, rsha) != 0) return 2;
        sy_printf("ENTRY_LINK_MATERIAL\tstatus=VERIFIED\tdir=%s\ttree_sha=%s\tcandidate_sha=%s\n", dir, tree_sha, csha);
        return 0;
    }

    (void)mode_step;
    (void)sy_mkdir(dir, 0700);
    {
        char lkp[4400];
        int lkfd;
        cx_fmt(lkp, sizeof lkp, "%s/.step.lock", dir);
        lkfd = open(lkp, O_RDWR | O_CREAT | O_NOFOLLOW | O_CLOEXEC, 0600);
        if (lkfd < 0) return 2;
        if (sy_flock(lkfd, 6) != 0) { /* LOCK_EX | LOCK_NB: concurrent caller owns step */
            sy_close(lkfd);
            return 3;
        }
        /* Lock held for process lifetime; kernel releases on exit. */
    }
    if (verify_identity_dir(root, dir, tree_sha, 1) != 0) {
        sy_printf("FAIL\tENTRY_LINK_MATERIAL\treason=tree-id-or-root-mismatch\n");
        return 2;
    }
    cx_fmt(eb, sizeof eb, "%s/entry_build.bin", dir);
    cx_fmt(matp, sizeof matp, "%s/material.tsv", dir);

    /* Already complete? Re-verify on every hit. */
    if (sy_exists(matp) == 1 && is_done(dir, 1) && is_done(dir, 2) && is_done(dir, 3) && is_done(dir, 4)) {
        char csha[65], esha[65], rsha[65];
        if (verify_complete_dir(root, dir, tree_sha, csha, esha, rsha) != 0) return 2;
        sy_printf("PREPARED\tentry-link\tdir=%s\ttree_sha=%s\tcandidate_sha=%s\n", dir, tree_sha, csha);
        return 0;
    }

    t0 = sy_now_ms();
    /* Stage 1: compile entry_build.bin */
    if (!is_done(dir, 1) || sy_exists(eb) != 1) {
        cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/entry-build.cx' -o '%s'", root, root, eb);
        if (run_sh_cmd(cmd, out, sizeof out) != 0 || sy_exists(eb) != 1) {
            sy_eprintf("%s\n", out);
            sy_printf("FAIL\tENTRY_LINK_STEP\tstep=1\tstage=eb-bin\n");
            return 1;
        }
        if (mark_done(dir, 1) != 0) return 1;
        sy_printf("ENTRY_LINK_STEP\tstep=1\tstage=eb-bin\tstatus=DONE\tms=%ld\n", sy_now_ms() - t0);
        return 3;
    }

    /* Stage 2: compile all root objects via plan.memo */
    if (!is_done(dir, 2)) {
        long off;
        cx_fmt(cmd, sizeof cmd, "UNISACC_EB_PLAN_MEMO='%s/plan.memo' '%s' '%s' '%s/unisacc.com' '%s' --target lnx/x86_64",
               dir, eb, root, root, dir);
        off = (long)strlen(cmd);
        for (int i = 0; i < cf_root_count(); i++) {
            const char *k = cf_root_key(i);
            if (k && off + 16 + (long)strlen(k) < (long)sizeof cmd) {
                cx_fmt(cmd + off, sizeof cmd - (size_t)off, " --only '%s'", k);
                off += (long)strlen(cmd + off);
            }
        }
        if (run_sh_cmd(cmd, out, sizeof out) != 0) {
            sy_eprintf("%s\n", out);
            sy_printf("FAIL\tENTRY_LINK_STEP\tstep=2\tstage=roots\n");
            return 1;
        }
        if (mark_done(dir, 2) != 0) return 1;
        sy_printf("ENTRY_LINK_STEP\tstep=2\tstage=roots\tstatus=DONE\tms=%ld\n", sy_now_ms() - t0);
        return 3;
    }

    /* Stage 3: closure part 1 */
    if (!is_done(dir, 3)) {
        cx_fmt(cmd, sizeof cmd,
               "args=$(UNISACC_EB_PLAN_MEMO='%s/plan.memo' '%s' '%s' '%s/unisacc.com' '%s' --target lnx/x86_64 --closure-list | "
               "awk -F'\\t' '(NR %% 2 == 1 || $1 == \"m55.o\") {printf \" --closure-only %%s\", $1}') && "
               "UNISACC_EB_PLAN_MEMO='%s/plan.memo' '%s' '%s' '%s/unisacc.com' '%s' --target lnx/x86_64 $args",
               dir, eb, root, root, dir, dir, eb, root, root, dir);
        if (run_sh_cmd(cmd, out, sizeof out) != 0) {
            sy_eprintf("%s\n", out);
            sy_printf("FAIL\tENTRY_LINK_STEP\tstep=3\tstage=closure1\n");
            return 1;
        }
        if (mark_done(dir, 3) != 0) return 1;
        sy_printf("ENTRY_LINK_STEP\tstep=3\tstage=closure1\tstatus=DONE\tms=%ld\n", sy_now_ms() - t0);
        return 3;
    }

    /* Stage 4: closure part 2 */
    if (!is_done(dir, 4)) {
        cx_fmt(cmd, sizeof cmd,
               "args=$(UNISACC_EB_PLAN_MEMO='%s/plan.memo' '%s' '%s' '%s/unisacc.com' '%s' --target lnx/x86_64 --closure-list | "
               "awk -F'\\t' '(NR %% 2 == 0 && $1 != \"m55.o\") {printf \" --closure-only %%s\", $1}') && "
               "UNISACC_EB_PLAN_MEMO='%s/plan.memo' '%s' '%s' '%s/unisacc.com' '%s' --target lnx/x86_64 $args",
               dir, eb, root, root, dir, dir, eb, root, root, dir);
        if (run_sh_cmd(cmd, out, sizeof out) != 0) {
            sy_eprintf("%s\n", out);
            sy_printf("FAIL\tENTRY_LINK_STEP\tstep=4\tstage=closure2\n");
            return 1;
        }
        if (mark_done(dir, 4) != 0) return 1;
        sy_printf("ENTRY_LINK_STEP\tstep=4\tstage=closure2\tstatus=DONE\tms=%ld\n", sy_now_ms() - t0);
        return 3;
    }

    /* Stage 5: link-only + pure-.cx verification + write candidate.sha + material.tsv */
    {
        char candp[4400], cshap[4400], logp[4400], csha[65], esha[65], rsha[65], matbuf[1024], line[80];
        cx_fmt(candp, sizeof candp, "%s/candidate", dir);
        cx_fmt(cshap, sizeof cshap, "%s/candidate.sha", dir);
        cx_fmt(logp, sizeof logp, "%s/link.out", dir);
        cx_fmt(cmd, sizeof cmd,
               "UNISACC_EB_PLAN_MEMO='%s/plan.memo' '%s' '%s' '%s/unisacc.com' '%s' --target lnx/x86_64 --link-only",
               dir, eb, root, root, dir);
        if (run_sh_cmd(cmd, out, sizeof out) != 0 || strstr(out, "multiple definitions") != 0) {
            sy_eprintf("%s\n", out);
            sy_printf("FAIL\tENTRY_LINK_STEP\tstep=5\tstage=link-verify\n");
            return 1;
        }
        (void)sy_write_file(logp, (const unsigned char *)out, (long)strlen(out), 0644);
        if (rc_regular_sha256_size(candp, csha, 0, 64 << 20) != 0) return 1;
        cx_fmt(line, sizeof line, "%s\n", csha);
        if (sy_write_file(cshap, (const unsigned char *)line, (long)strlen(line), 0644) != 0) return 1;
        if (verify_complete_dir(root, dir, tree_sha, csha, esha, rsha) != 0) return 2;
        cx_fmt(matbuf, sizeof matbuf,
               "entry-link-material-v1\n"
               "status\tPREPARED\n"
               "target\tlnx/x86_64\n"
               "tree_sha\t%s\n"
               "root\t%s\n"
               "candidate_sha\t%s\n"
               "entry_elf_sha\t%s\n"
               "receipt_sha\t%s\n",
               tree_sha, root, csha, esha, rsha);
        if (sy_write_file(matp, (const unsigned char *)matbuf, (long)strlen(matbuf), 0644) != 0) return 1;
        sy_printf("ENTRY_LINK_STEP\tstep=5\tstage=link-verify\tstatus=DONE\tms=%ld\n", sy_now_ms() - t0);
        sy_printf("PREPARED\tentry-link\tdir=%s\ttree_sha=%s\tcandidate_sha=%s\n", dir, tree_sha, csha);
        return 0;
    }
}
