#pragma unisa use compiler.modelname
#pragma unisa use runtime.modelname
#pragma unisa use sys.io
#pragma unisa use text.text
/* Generated by tools/model-gen.cx. Narrow check of the seven model file names. */
int main(void) {
    const char *name;
    const char **missing;
    missing = 0;
    if (pmn_count() != 7) return 1;
    if (rmn_count() != 7) return 1;
    if (pmn_at(0, &name) || !tx_eqz(name, "e2.net")) return 1;
    if (rmn_at(0, &name) || !tx_eqz(name, "e2.net")) return 1;
    if (pmn_at(1, &name) || !tx_eqz(name, "e1.net")) return 1;
    if (rmn_at(1, &name) || !tx_eqz(name, "e1.net")) return 1;
    if (pmn_at(2, &name) || !tx_eqz(name, "e3.net")) return 1;
    if (rmn_at(2, &name) || !tx_eqz(name, "e3.net")) return 1;
    if (pmn_at(3, &name) || !tx_eqz(name, "e4.net")) return 1;
    if (rmn_at(3, &name) || !tx_eqz(name, "e4.net")) return 1;
    if (pmn_at(4, &name) || !tx_eqz(name, "prune.net")) return 1;
    if (rmn_at(4, &name) || !tx_eqz(name, "prune.net")) return 1;
    if (pmn_at(5, &name) || !tx_eqz(name, "lower.net")) return 1;
    if (rmn_at(5, &name) || !tx_eqz(name, "lower.net")) return 1;
    if (pmn_at(6, &name) || !tx_eqz(name, "elf.net")) return 1;
    if (rmn_at(6, &name) || !tx_eqz(name, "elf.net")) return 1;
    if (pmn_at(0, missing) != 4) return 1;
    if (rmn_at(0, missing) != 4) return 1;
    if (pmn_at(-1, &name) != 2) return 1;
    if (pmn_at(7, &name) != 2) return 1;
    if (rmn_at(-1, &name) != 2) return 1;
    if (rmn_at(7, &name) != 2) return 1;
    sy_printf("CX_MODEL\tok=7\tfailed=0\n");
    return 0;
}
