/* tools/check-use-path.cx -- tools/use-path.cx rewrites exactly the module path of `#pragma unisa use` lines.
 *
 *   sh ./unisacc.com tools/check-use-path.cx        (from the repo root; works in out/check-use-path/)
 *
 * Fixtures are written under out/check-use-path/ and the real tool runs on them with the installed
 * product, so the check covers the shipped code path and not a copy of its logic:
 *   plain    `use core.kernel` becomes `use sys.kernel`;
 *   alias    `use core.kernel::core_run as cr` keeps `::core_run as cr`;
 *   prefix   `use core.kernels` is a different module and stays untouched;
 *   opaque   a comment and a string literal that spell the old path stay untouched;
 *   spacing  a non-canonical `#pragma unisa  use core.kernel` is refused with rc 2 and the file is
 *            left byte-identical;
 *   count    USE-PATH reports changed=1 for the plain case.
 * Prints PASS/FAIL per case and CHECK_USE_PATH<TAB>failed=N; exit 1 when N > 0, 2 on setup failure. */
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.io
#pragma unisa use sys.sig
#pragma unisa use text.text

/* sy_run with a bound: ARGV runs under cx_runv_timeout (SECS, process group killed on expiry), stdout and stderr
   merged into OUT (CAP, NUL-terminated, *CUT set when it did not fit; CUT may be 0). */
static int bounded_run(char **argv, int secs, char *out, int cap, int *cut) {
    char *w[64], *b = 0;
    size_t n = 0, j;
    int k = 0, i, rc;
    if (cut) *cut = 0;
    if (!argv) return -EINVAL;
    w[k++] = "sh"; w[k++] = "-c"; w[k++] = "exec \"$@\" 2>&1"; w[k++] = "sh";
    for (i = 0; argv[i] && k < 63; i++) w[k++] = argv[i];
    if (argv[i]) return -E2BIG;
    w[k] = 0;
    rc = cx_runv_timeout(w, secs, &b, &n);
    if (cap > 0) {
        if (n > (size_t)cap - 1) { n = (size_t)cap - 1; if (cut) *cut = 1; }
        for (j = 0; b && j < n; j++) out[j] = b[j];
        out[b ? n : 0] = 0;
    }
    free(b);
    return rc;
}

static char upw[4400];
#define UPW upw
#define OLD "core.kernel"
#define NEW "sys.kernel"

static int failed;
static void ck(int ok, const char *name) { if (ok) sy_printf("PASS\tcheck-use-path.%s\n", name); else { failed++; sy_printf("FAIL\tcheck-use-path.%s\n", name); } }
static void die(const char *s) { sy_eprintf("check-use-path: REFUSE %s\n", s); sy_exit(2); }

/* Write S as fixture NAME, run the real tool on it, and leave its bytes in OUT. Returns the tool's rc. */
static int run(const char *name, const char *s, char *out, int cap) {
    char path[256], got[1024];
    char *av[] = {"sh", "./unisacc.com", "tools/use-path.cx", "--", OLD, NEW, path, 0};
    size_t n = 0;
    int rc;
    long sl = tx_len(s, 1L << 16);
    char *b;
    if (cx_fmt(path, sizeof path, "%s/%s", upw, name)) die("path");
    if (cx_write(path, s, (size_t)sl) < 0) die("cannot write the fixture");
    rc = bounded_run(av, 50, got, (int)sizeof got, 0);
    b = cx_read(path, &n);                          /* the tool rewrote the file in place */
    if (!b) die("cannot read the fixture back");
    if (n >= (size_t)cap) die("fixture grew past the buffer");
    for (size_t i = 0; i < n; i++) out[i] = b[i];
    out[n] = 0;
    return rc;
}

int main(void) {
    char out[8192], got[8192], mkbuf[4600], path[4600];
    char *mk[] = {"sh", "-c", mkbuf, 0};
    size_t n;
    if (cx_fmt(upw, sizeof upw, "%s/check-use-path-%d", sy_tmpdir(), sy_pid()) || cx_fmt(path, sizeof path, "%s/plain.cx", upw) || cx_fmt(mkbuf, sizeof mkbuf, "rm -rf %s && mkdir -p %s", upw, upw)) die("path");
    if (bounded_run(mk, 50, got, (int)sizeof got, 0) != 0) die("cannot prepare the fixture directory");

    ck(run("plain.cx", "#pragma unisa use " OLD "\nint main(void){return 0;}\n", out, sizeof out) == 0
       && tx_eqz(out, "#pragma unisa use " NEW "\nint main(void){return 0;}\n"), "plain");

    ck(run("alias.cx", "#pragma unisa use " OLD "::core_run\n", out, sizeof out) == 0
       && tx_eqz(out, "#pragma unisa use " NEW "::core_run\n"), "alias");

    ck(run("pref.cx", "#pragma unisa use " OLD "s\n", out, sizeof out) == 0
       && tx_eqz(out, "#pragma unisa use " OLD "s\n"), "prefix");

    ck(run("opaque.cx", "/* #pragma unisa use " OLD " */\nchar *s = \"#pragma unisa use " OLD "\";\n", out, sizeof out) == 0
       && tx_eqz(out, "/* #pragma unisa use " OLD " */\nchar *s = \"#pragma unisa use " OLD "\";\n"), "opaque");

    ck(run("spacing.cx", "#pragma unisa  use " OLD "\n", out, sizeof out) == 2
       && tx_eqz(out, "#pragma unisa  use " OLD "\n"), "spacing");

    /* The summary line of the plain case says changed=1, so a no-op run is not mistaken for a rewrite. */
    {   char *av[] = {"sh", "./unisacc.com", "tools/use-path.cx", "--", OLD, NEW, path, 0};
        if (bounded_run(av, 50, got, (int)sizeof got, 0) != 0) die("cannot run the tool on the plain fixture");
        n = tx_len(got, sizeof got);
        ck(tx_find(got, (long)n, "changed=0", 9) >= 0, "count"); }   /* already rewritten: nothing left to change */

    sy_printf("CHECK_USE_PATH\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
