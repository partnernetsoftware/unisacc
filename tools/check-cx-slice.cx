/* Checks cx/mem/slice.cx: sh ./unisacc.com tools/check-cx-slice.cx; exit 1 on any FAIL. */
#pragma unisa use mem.slice
#pragma unisa use mem.grow
static int bad;
static void ok(int c, const char *n) { printf("%s\t%s\n", c ? "PASS" : "FAIL", n); if (!c) bad = 1; }
int main(void) {
    mg_buf b;
    mg_init(&b);
    mg_append(&b, "hello world", 11);
    {
        ms_slice s = ms_of(&b);
        ok(ms_len(&s) == 11, "of-len");
        ok(s.p[0] == 'h' && s.p[10] == 'd', "of-content");
        {
            ms_slice w; long i;
            ok(ms_at(&s, 6, 5, &w) == 0 && ms_len(&w) == 5 && w.p[0] == 'w', "at-sub");
            ok(ms_eq(&w, &(ms_slice){ (const unsigned char *)"world", 5 }), "at-sub-eq");
            ok(ms_at(&s, 6, 6, &w) == -1, "at-out-of-range");
            ok(ms_at(&s, -1, 1, &w) == -1, "at-neg-off");
            i = ms_find(&s, &(ms_slice){ (const unsigned char *)"world", 5 });
            ok(i == 6, "find-world");
            i = ms_find(&s, &(ms_slice){ (const unsigned char *)"xyz", 3 });
            ok(i == -1, "find-absent");
            ok(ms_find(&s, &(ms_slice){ 0, 0 }) == 0, "find-empty");
            ok(ms_rfind(&s, &(ms_slice){ (const unsigned char *)"o", 1 }) == 7, "rfind-last-o");
            ok(ms_rfind(&s, &(ms_slice){ (const unsigned char *)"z", 1 }) == -1, "rfind-absent");
            ok(ms_rfind(&s, &(ms_slice){ 0, 0 }) == s.n, "rfind-empty-at-end");
            ok(ms_contains(&s, &(ms_slice){ (const unsigned char *)"world", 5 }), "contains-world");
            ok(!ms_contains(&s, &(ms_slice){ (const unsigned char *)"xyz", 3 }), "contains-absent");
            ok(ms_contains(&s, &(ms_slice){ 0, 0 }), "contains-empty");
            ok(!ms_contains(0, &(ms_slice){ (const unsigned char *)"a", 1 }), "contains-null-s");
            ok(ms_starts_with(&s, &(ms_slice){ (const unsigned char *)"hello", 5 }), "starts-with-hello");
            ok(!ms_starts_with(&s, &(ms_slice){ (const unsigned char *)"world", 5 }), "starts-with-not");
            ok(ms_ends_with(&s, &(ms_slice){ (const unsigned char *)"world", 5 }), "ends-with-world");
            ok(!ms_ends_with(&s, &(ms_slice){ (const unsigned char *)"hello", 5 }), "ends-with-not");
            ok(ms_starts_with(&s, &(ms_slice){ 0, 0 }) && ms_ends_with(&s, &(ms_slice){ 0, 0 }), "empty-prefix-suffix-match");
        }
    }
    {
        ms_slice e = ms_span(0, 0);
        ok(ms_len(&e) == 0, "span-empty");
        ok(ms_span(0, 1).p == 0, "span-null-nonzero-rejected");
        ok(ms_span(0, -1).n == 0, "span-neg-rejected");
    }
    {
        /* mutable borrow: fill and copy back, all bounds-checked */
        ms_slice_mut m = ms_mut_of(&b);
        ok(ms_mut_len(&m) == 11, "mut-of-len");
        ok(ms_mut_fill(&m, 'x') == 0 && b.data[0] == 'x' && b.data[10] == 'x', "mut-fill");
        {
            ms_slice s = ms_of(&b);
            ms_slice_mut sub;
            ok(ms_mut_at(&m, 0, 5, &sub) == 0 && ms_mut_fill(&sub, 'y') == 0 && b.data[0] == 'y' && b.data[4] == 'y' && b.data[5] == 'x', "mut-at-fill");
            ok(ms_mut_at(&m, 11, 1, &sub) == -1, "mut-at-out-of-range");
            {
                /* copy an immutable slice back into a mutable one */
                ms_slice src = ms_span((const unsigned char *)"abcde", 5);
                ms_slice_mut dst;
                ok(ms_mut_at(&m, 0, 5, &dst) == 0 && ms_mut_copy(&dst, &src) == 0 && b.data[0] == 'a' && b.data[4] == 'e', "mut-copy");
                ok(ms_mut_copy(&dst, &(ms_slice){ (const unsigned char *)"xy", 2 }) == -1, "mut-copy-len-mismatch");
            }
            (void)s;
        }
    }
    mg_free(&b);
    printf("CX_SLICE\tfailed=%d\n", bad);
    return bad;
}
