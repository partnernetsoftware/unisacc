/* Checks cx/mem/slice.cx: sh ./unisacc.com tools/check-cx-slice.cx; exit 1 on any FAIL. */
#pragma unisa use mem.slice
#pragma unisa use mem.grow
static int bad;
static void ok(int c, const char *n) { printf("%s\t%s\n", c ? "PASS" : "FAIL", n); if (!c) bad = 1; }
int main(void) {
    mg_buf b;
    mg_init(&b);
    mg_append(&b, "hello world", 11);
    {
        ms_slice s = ms_of(&b);
        ok(ms_len(&s) == 11, "of-len");
        ok(s.p[0] == 'h' && s.p[10] == 'd', "of-content");
        {
            ms_slice w; long i;
            ok(ms_at(&s, 6, 5, &w) == 0 && ms_len(&w) == 5 && w.p[0] == 'w', "at-sub");
            ok(ms_eq(&w, &(ms_slice){ (const unsigned char *)"world", 5 }), "at-sub-eq");
            ok(ms_at(&s, 6, 6, &w) == -1, "at-out-of-range");
            ok(ms_at(&s, -1, 1, &w) == -1, "at-neg-off");
            i = ms_find(&s, &(ms_slice){ (const unsigned char *)"world", 5 });
            ok(i == 6, "find-world");
            i = ms_find(&s, &(ms_slice){ (const unsigned char *)"xyz", 3 });
            ok(i == -1, "find-absent");
            ok(ms_find(&s, &(ms_slice){ 0, 0 }) == 0, "find-empty");
        }
    }
    {
        ms_slice e = ms_span(0, 0);
        ok(ms_len(&e) == 0, "span-empty");
        ok(ms_span(0, 1).p == 0, "span-null-nonzero-rejected");
        ok(ms_span(0, -1).n == 0, "span-neg-rejected");
    }
    mg_free(&b);
    printf("CX_SLICE\tfailed=%d\n", bad);
    return bad;
}
