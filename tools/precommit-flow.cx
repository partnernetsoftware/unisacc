/* tools/precommit-flow.cx -- tools/precommit.cx with its gate subprocesses run as one concurrent flow.
 *
 *   sh ./unisacc.com tools/precommit-flow.cx [-- --run DIR] [-- --jobs N]
 *
 * (1) sh ./unisacc.com tools/precommit.cx -- --plan DIR prints PLAN<TAB>id<TAB>argv... for every gate the
 *     current index needs (manifest, tables, runlist, facts, tlibfrozen, lint, lintr1, ratchets) and stages
 *     the lint blobs into DIR/lintdir;
 * (2) those gates become exec nodes of DIR/flow.tsv (no deps, stderr merged into stdout as precommit's own
 *     spawn does) and run at once through cxlib.flowexec fl_run into DIR;
 * (3) sh ./unisacc.com tools/precommit.cx -- --from-run DIR judges from DIR/out/<id>.out and DIR/events.tsv.
 * Its stdout/stderr and exit code are precommit's, so the PRECOMMIT line and rc are the original's; the
 * judgement code exists only in tools/precommit.cx.  FLOWPC<TAB>... timing goes to stderr.
 * Check: tools/check-precommit-flow.cx (next batch). */
#pragma unisa use cxlib.flowexec
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use sys.poll
#pragma unisa use sysx.process
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

enum { PLAN_MS = 60000 };

static char *slurp(char **argv, long *n) {   /* stdout+stderr merged, bounded by PLAN_MS */
    int ofd, pid; long cap = 1 << 16, r, deadline; char *b = mm_alloc(cap);
    *n = 0;
    if (!b) return 0;
    pid = sy_spawn_pipe(argv, 0, 0, &ofd, 0);
    if (pid < 0) { mm_free(b); return 0; }
    deadline = sy_now_ms() + PLAN_MS;
    for (;;) {
        sy_pollfd_t pf; long left = deadline - sy_now_ms();
        pf.fd = ofd; pf.events = SY_POLLIN; pf.revents = 0;
        if (left <= 0 || sy_poll(&pf, 1, left) <= 0) { sy_close(ofd); sy_kill(pid); mm_free(b); return 0; }
        r = sy_read(ofd, b + *n, cap - 1 - *n);
        if (r <= 0) break;
        *n += r;
        if (*n + 1 >= cap) { char *g = mm_grow(b, cap * 2); if (!g) { mm_free(b); return 0; } b = g; cap *= 2; }
    }
    { int ex = 0, code = 0, sig = 0; sy_close(ofd); sy_wait_status(pid, 0, &ex, &code, &sig); }
    b[*n] = 0;
    return b;
}

static int put(int fd, const char *s, long n) { return sy_write_all(fd, s, n); }

static int put_val(int fd, const char *s, long n) {   /* flow arg value: %XX for ; % TAB newline */
    long i; char h[4];
    for (i = 0; i < n; i++) {
        unsigned char c = (unsigned char)s[i];
        if (c == ';' || c == '%' || c == '\t' || c == '\n' || c == '\r') {
            h[0] = '%'; h[1] = "0123456789ABCDEF"[c >> 4]; h[2] = "0123456789ABCDEF"[c & 15];
            if (put(fd, h, 3)) return -1;
        } else if (put(fd, s + i, 1)) return -1;
    }
    return 0;
}

int main(int argc, char **argv) {
    char dir[1200], fp[1300], why[1024], *plan, *pv[7], *jv[7]; const char *rdir = 0;
    long nbn = 0; int rkx = 0;
    long pn, at, t0 = sy_now_ms(), t1, t2; int a, jobs = 0, fd, nodes = 0, pid, ex = 0, code = 1, sig = 0, r = 0;
    fl_flow f; fl_sum s;
    for (a = 1; a < argc; a++) {
        if (tx_eqz(argv[a], "--run") && a + 1 < argc) rdir = argv[++a];
        else if (tx_eqz(argv[a], "--jobs") && a + 1 < argc) { const char *q = argv[++a]; jobs = 0; while (*q >= '0' && *q <= '9' && jobs < 100) jobs = jobs * 10 + (*q++ - '0'); if (*q || jobs < 1 || jobs > 32) jobs = 0; }
        else { sy_eprintf("precommit-flow: usage: precommit-flow.cx [-- --run DIR] [--jobs N]\n"); return 2; }
    }
    if (rdir) { if (tx_copy(dir, sizeof dir, rdir, tx_len(rdir, 1100))) return 2; }
    else if (cx_fmt(dir, sizeof dir, "%s/precommit-flow-%d-%ld", sy_tmpdir(), sy_pid(), sy_now_ms())) return 2;
    if (sy_mkdir(dir, 0700) && sy_exists(dir) != 1) { sy_eprintf("precommit-flow: cannot make %s\n", dir); return 2; }
    pv[0] = "sh"; pv[1] = "./unisacc.com"; pv[2] = "tools/precommit.cx"; pv[3] = "--"; pv[4] = "--plan"; pv[5] = dir; pv[6] = 0;
    plan = slurp(pv, &pn);
    if (!plan) { sy_eprintf("precommit-flow: precommit --plan did not run\n"); return 1; }
    if (cx_fmt(fp, sizeof fp, "%s/flow.tsv", dir)) return 2;
    sy_unlink(fp);
    fd = sy_open_new(fp, 0600);
    if (fd < 0) { sy_eprintf("precommit-flow: cannot write %s\n", fp); return 2; }
    {   /* the ratchets gate becomes its thirteen ratchets (tools/ratchets.cx --plan), judged after the run */
        long rn; char *rp, *nb;
        if (tx_find(plan, pn, "PLAN\tratchets\t", 14) >= 0) {
            char *rv[] = {"sh", "./unisacc.com", "tools/ratchets.cx", "--", "--plan", 0};
            rp = slurp(rv, &rn);
            if (!rp || tx_find(rp, rn, "PLAN\trk-", 8) < 0) { sy_eprintf("precommit-flow: ratchets --plan did not run\n"); return 1; }
            nb = mm_alloc(pn + rn + 1);
            if (!nb) return 2;
            for (at = 0; at < pn; ) {   /* copy every plan line except the ratchets one, then the ratchet lines */
                long e = tx_chr(plan + at, pn - at, '\n'), l = e < 0 ? pn - at : e;
                if (!tx_prefix(plan + at, l, "PLAN\tratchets\t", 14)) { mm_copy(nb + nbn, pn + rn + 1 - nbn, plan + at, l); nbn += l; nb[nbn++] = '\n'; }
                at += l + 1;
            }
            mm_copy(nb + nbn, pn + rn + 1 - nbn, rp, rn); nbn += rn; nb[nbn] = 0;
            mm_free(plan); mm_free(rp); plan = nb; pn = nbn; rkx = 1;
        }
    }
    for (at = 0; at < pn; ) {
        long e = tx_chr(plan + at, pn - at, '\n'), l = e < 0 ? pn - at : e, k, nf;
        const char *ln = plan + at;
        if (tx_prefix(ln, l, "PLAN\t", 5) && (nf = tx_fields(ln, l, '\t')) >= 3) {
            long io, il, ao, al; char key[16];
            tx_field(ln, l, '\t', 1, &io, &il);
            put(fd, ln + io, il);
            { static const char hd[] = "\texec\t-\ta0=sh;a1=-c;a2=exec \"$@\" 2>&1;a3=precommit-gate";
              if (put(fd, hd, (long)sizeof hd - 1)) { sy_close(fd); return 2; } }
            for (k = 2; k < nf; k++) {
                tx_field(ln, l, '\t', k, &ao, &al);
                if (cx_fmt(key, sizeof key, ";a%ld=", k + 2)) { sy_close(fd); return 2; }
                put(fd, key, tx_len(key, 16)); put_val(fd, ln + ao, al);
            }
            put(fd, ";timeout_ms=60000\n", 18);
            nodes++;
        }
        at += l + 1;
    }
    sy_close(fd); mm_free(plan);
    t1 = sy_now_ms();
    if (nodes) {
        if (fl_load(fp, &f, why, (int)sizeof why)) { sy_eprintf("precommit-flow: REFUSE %s\n", why); return 2; }
        if (jobs < 1) { jobs = sy_ncpu(); if (jobs < 1) jobs = 4; if (jobs > 32) jobs = 32; }
        r = fl_run(&f, dir, jobs, 0, 0, &s);
        fl_free(&f);
        if (r < 0) { sy_eprintf("precommit-flow: run dir %s unusable (%d)\n", dir, r); return 2; }
    }
    if (rkx) {   /* ratchets --from-run DIR -> DIR/out/ratchets.out and an ok/fail event for the gate */
        char *xv[] = {"sh", "./unisacc.com", "tools/ratchets.cx", "--", "--from-run", dir, 0}, ev[256]; long xn, tr = sy_now_ms();
        char *xo = slurp(xv, &xn); int xrc = -1;
        if (xo && tx_find(xo, xn, "RATCHETS\tok=", 12) >= 0) xrc = tx_find(xo, xn, "\tfail=0\t", 8) >= 0 ? 0 : 1;
        if (cx_fmt(fp, sizeof fp, "%s/out/ratchets.out", dir) || (xo && cx_write(fp, xo, xn))) { sy_eprintf("precommit-flow: cannot write %s\n", fp); return 2; }
        if (cx_fmt(fp, sizeof fp, "%s/events.tsv", dir)) return 2;
        cx_fmt(ev, sizeof ev, "EVT\t%d\tratchets\t%s\t%ld\t%d\tfrom-run\n", 99999, xrc == 0 ? "ok" : "fail", sy_now_ms() - tr, xrc);
        {   size_t on = 0; char *old = (char *)cx_read(fp, &on); long el = tx_len(ev, 256); char *nv = mm_alloc((long)on + el + 1);
            if (!nv) return 2;
            if (old && on) mm_copy(nv, (long)on + el + 1, old, (long)on);
            mm_copy(nv + on, el + 1, ev, el);
            if (cx_write(fp, nv, (long)on + el)) { sy_eprintf("precommit-flow: cannot append %s\n", fp); return 2; }
            if (old) mm_free(old); mm_free(nv);
        }
        if (xo) mm_free(xo);
    }
    t2 = sy_now_ms();
    jv[0] = "/bin/sh"; jv[1] = "./unisacc.com"; jv[2] = "tools/precommit.cx"; jv[3] = "--"; jv[4] = "--from-run"; jv[5] = dir; jv[6] = 0;
    pid = sy_spawn_inherit(jv, -1);
    if (pid < 0 || sy_wait_status(pid, 0, &ex, &code, &sig) != pid || !ex) { sy_eprintf("precommit-flow: precommit --from-run did not run\n"); return 1; }
    sy_eprintf("FLOWPC\tnodes=%d\tplan_ms=%ld\tflow_ms=%ld\tjudge_ms=%ld\trun=%s\n", nodes, t1 - t0, t2 - t1, sy_now_ms() - t2, dir);
    return code;
}
