/* tools/precommit-flow.cx -- tools/precommit.cx with its gate subprocesses run as one concurrent flow.
 *
 *   sh ./unisacc.com tools/precommit-flow.cx [-- --run DIR] [-- --jobs N]
 *
 * (1) sh ./unisacc.com tools/precommit.cx -- --plan DIR prints PLAN<TAB>id<TAB>argv... for every gate the
 *     current index needs (manifest, tables, runlist, facts, tlibfrozen, lint, lintr1, ratchets) and stages
 *     the lint blobs into DIR/lintdir;
 * (2) those gates become exec nodes of DIR/flow.tsv (no deps, stderr merged into stdout as precommit's own
 *     spawn does) and run at once through cxlib.flowexec fl_run into DIR;
 * (3) sh ./unisacc.com tools/precommit.cx -- --from-run DIR judges from DIR/out/<id>.out and DIR/events.tsv.
 * Its stdout/stderr and exit code are precommit's, so the PRECOMMIT line and rc are the original's; the
 * judgement code exists only in tools/precommit.cx.  FLOWPC<TAB>... timing goes to stderr.
 * Check: tools/check-precommit-flow.cx (next batch). */
#pragma unisa use cxlib.flowexec
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use sys.poll
#pragma unisa use sysx.process
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use sys.posix
#pragma unisa use sys.sig
#pragma unisa use cxlib.pretimes
#pragma unisa use cxlib.sessionroot

enum { PLAN_MS = 60000 };

static char pcf_own_dir[1200];
static volatile int pcf_active_child_pid = 0;
static volatile int pcf_in_sig = 0;
static int pcf_owner_pid = 0;
static fl_flow *pcf_active_flow = 0;

static int pcf_owner_dead(void) {
    return (pcf_owner_pid >= 2 && sy_signal(pcf_owner_pid, 0) == -ESRCH);
}

static void pcf_cleanup(void) {
    if (pcf_active_child_pid > 0) {
        int cpid = pcf_active_child_pid;
        pcf_active_child_pid = 0;
        (void)sy_kill(cpid);
    }
    if (pcf_active_flow) {
        int i;
        for (i = 0; i < pcf_active_flow->count; i++) {
            if (pcf_active_flow->n[i].state == FL_RUNNING)
                (void)sy_proc_kill(&pcf_active_flow->n[i].child, 9);
        }
    }
    if (pcf_own_dir[0]) {
        (void)sy_chdir("/");
        (void)sy_remove_all(pcf_own_dir);
        pcf_own_dir[0] = 0;
    }
}

static void pcf_sig_cleanup(int sig) {
    if (pcf_in_sig) {
        (void)sy_sig_default(sig);
        (void)sy_raise(sig);
        _exit(128 + sig);
    }
    pcf_in_sig = 1;
    pcf_cleanup();
    (void)sy_sig_default(sig);
    (void)sy_raise(sig);
    _exit(128 + sig);
}

static int pcf_sig_hex_mask(const char *buf, long n, const char *key, long kl, unsigned long long *out) {
    long at = 0;
    while (at < n) {
        long e = tx_chr(buf + at, n - at, '\n');
        long ln = e < 0 ? n - at : e;
        if (ln > kl && tx_prefix(buf + at, ln, key, kl)) {
            long j = kl;
            unsigned long long v = 0;
            int got = 0;
            while (j < ln && (buf[at + j] == ' ' || buf[at + j] == '\t')) j++;
            while (j < ln) {
                char c = buf[at + j];
                unsigned long long d;
                if (c >= '0' && c <= '9') d = (unsigned long long)(c - '0');
                else if (c >= 'a' && c <= 'f') d = (unsigned long long)(c - 'a' + 10);
                else if (c >= 'A' && c <= 'F') d = (unsigned long long)(c - 'A' + 10);
                else break;
                v = (v << 4) | d;
                got = 1;
                j++;
            }
            if (got) { *out = v; return 0; }
        }
        at += ln + 1;
    }
    return -1;
}

static int pcf_is_default_sig(int sig) {
    unsigned char *raw = 0;
    int64_t n = 0;
    unsigned long long ign = 0, cgt = 0;
    int ok;
    if (sig <= 0 || sig > 64) return 0;
    if (sy_read_file("/proc/self/status", &raw, &n, 65536) != 0 || !raw || n <= 0) {
        if (raw) mm_free(raw);
        return 0;
    }
    ok = (pcf_sig_hex_mask((const char *)raw, (long)n, "SigIgn:", 7, &ign) == 0 &&
          pcf_sig_hex_mask((const char *)raw, (long)n, "SigCgt:", 7, &cgt) == 0);
    mm_free(raw);
    if (!ok) return 0;
    return (((ign | cgt) >> (unsigned)(sig - 1)) & 1ULL) == 0;
}

static void pcf_register_cleanup_hooks(void) {
    static const int sigs[6] = { 1, 2, 3, 13, 14, 15 };
    int k;
    (void)sy_atexit(pcf_cleanup);
    for (k = 0; k < 6; k++) {
        if (pcf_is_default_sig(sigs[k]))
            (void)sy_sig_handle(sigs[k], pcf_sig_cleanup);
    }
}
/* Observation only (nothing here changes a verdict): the slowest gate nodes of the run, read back from DIR/events.tsv, whose lines are
 * EVT<TAB>seq<TAB>id<TAB>state<TAB>ms<TAB>rc<TAB>info.  A node counts when its state is not "start".  One line on stderr:
 *   FLOWPC_NODES<TAB>top=id:ms,... (at most 6, slowest first)<TAB>sum_ms=N<TAB>packed_ms=N/ncpu<TAB>flow_ms=N
 * sum_ms / ncpu is the floor the flow could reach with perfect packing: flow_ms far above it means one long node (split it), flow_ms close
 * to it means the machine is the limit (queueing; splitting nodes does not help). */
static void pcf_report_nodes(const char *dir, long flow_ms, int judge_rc) {
    char fp[1300], top[600]; size_t en = 0; char *ev; long at = 0, sum = 0, cpu = sy_ncpu(), tl = 0;
    char id[256][40]; long ms[256]; int n = 0, i, j, used[256];
    if (cx_fmt(fp, sizeof fp, "%s/events.tsv", dir)) return;
    ev = (char *)cx_read(fp, &en);
    if (!ev || !en) { sy_eprintf("FLOWPC_NODES\tunavailable=events.tsv-missing-or-empty\n"); if (ev) mm_free(ev); return; }
    while (at < (long)en && n < 256) {
        long e = tx_chr(ev + at, (long)en - at, '\n'), l = e < 0 ? (long)en - at : e, io, il, so, sl, mo, ml;
        const char *ln = ev + at;
        if (tx_prefix(ln, l, "EVT\t", 4) && tx_fields(ln, l, '\t') >= 5) {
            tx_field(ln, l, '\t', 2, &io, &il); tx_field(ln, l, '\t', 3, &so, &sl); tx_field(ln, l, '\t', 4, &mo, &ml);
            if (!(sl == 5 && tx_same(ln + so, 5, "start", 5)) && il > 0 && il < 40 && ml > 0 && ml < 12) {
                long v = 0, k;
                for (k = 0; k < ml; k++) { char c = ln[mo + k]; if (c < '0' || c > '9') { v = -1; break; } v = v * 10 + (c - '0'); }
                if (v >= 0 && !mm_copy(id[n], 40, ln + io, il)) {
                    const char *verd = (sl == 2 && tx_same(ln + so, 2, "ok", 2)) ? "PASS" : ((sl == 4 && tx_same(ln + so, 4, "fail", 4)) ? "FAIL" : "RAN");
                    id[n][il] = 0; ms[n] = v; sum += v; pt_row(id[n], v, verd); n++;
                }
            }
        }
        at += l + 1;
    }
    mm_free(ev);
    top[0] = 0;
    for (i = 0; i < 256; i++) used[i] = 0;
    for (i = 0; i < 6 && i < n; i++) {   /* selection of the slowest, ties keep file order */
        int best = -1; char item[80];
        for (j = 0; j < n; j++) if (!used[j] && (best < 0 || ms[j] > ms[best])) best = j;
        used[best] = 1;
        if (cx_fmt(item, sizeof item, "%s%s:%ld", i ? "," : "", id[best], ms[best])) return;
        if (tl + tx_len(item, 80) < (long)sizeof top - 1 && !mm_copy(top + tl, (long)sizeof top - tl, item, tx_len(item, 80) + 1)) tl += tx_len(item, 80);
    }
    sy_eprintf("FLOWPC_NODES\ttop=%s\tsum_ms=%ld\tpacked_ms=%ld\tflow_ms=%ld\tevents=%d\n", top, sum, cpu > 0 ? sum / cpu : sum, flow_ms, n);
    pt_row("flow", flow_ms, judge_rc == 0 ? "PASS" : "FAIL");
}

static char *slurp(char **argv, long *n) {   /* stdout+stderr merged, bounded by PLAN_MS */
    int ofd, pid; long cap = 1 << 16, r, deadline; char *b = mm_alloc(cap);
    *n = 0;
    if (!b) return 0;
    pid = sy_spawn_pipe(argv, 0, 0, &ofd, 0);
    if (pid < 0) { mm_free(b); return 0; }
    pcf_active_child_pid = pid;
    deadline = sy_now_ms() + PLAN_MS;
    for (;;) {
        sy_pollfd_t pf; long left = deadline - sy_now_ms(), slice; int pr;
        pf.fd = ofd; pf.events = SY_POLLIN; pf.revents = 0;
        if (left <= 0 || pcf_owner_dead()) { pcf_active_child_pid = 0; sy_close(ofd); sy_kill(pid); mm_free(b); return 0; }
        slice = left > 100 ? 100 : left;
        pr = sy_poll(&pf, 1, slice);
        if (pr == 0) continue;
        if (pr < 0) { pcf_active_child_pid = 0; sy_close(ofd); sy_kill(pid); mm_free(b); return 0; }
        r = sy_read(ofd, b + *n, cap - 1 - *n);
        if (r <= 0) break;
        *n += r;
        if (*n + 1 >= cap) { char *g = mm_grow(b, cap * 2); if (!g) { pcf_active_child_pid = 0; sy_close(ofd); sy_kill(pid); mm_free(b); return 0; } b = g; cap *= 2; }
    }
    { int ex = 0, code = 0, sig = 0; sy_close(ofd); pcf_active_child_pid = 0; sy_wait_status(pid, 0, &ex, &code, &sig); }
    b[*n] = 0;
    return b;
}

static int put(int fd, const char *s, long n) { return sy_write_all(fd, s, n); }

static int put_val(int fd, const char *s, long n) {   /* flow arg value: %XX for ; % TAB newline */
    long i; char h[4];
    for (i = 0; i < n; i++) {
        unsigned char c = (unsigned char)s[i];
        if (c == ';' || c == '%' || c == '\t' || c == '\n' || c == '\r') {
            h[0] = '%'; h[1] = "0123456789ABCDEF"[c >> 4]; h[2] = "0123456789ABCDEF"[c & 15];
            if (put(fd, h, 3)) return -1;
        } else if (put(fd, s + i, 1)) return -1;
    }
    return 0;
}

int main(int argc, char **argv) {
    char dir[1200], fp[1300], why[1024], *plan, *pv[7], *jv[7]; const char *rdir = 0, *vfile = 0;
    long nbn = 0; int rkx = 0;
    long pn, at, t0 = sy_now_ms(), t1, t2; int a, jobs = 0, fd, nodes = 0, pid, ex = 0, code = 1, sig = 0, r = 0;
    fl_flow f; fl_sum s;
    if (argc == 2 && tx_eqz(argv[1], "--times-selftest")) {
        char tdir[500], tpath[700];
        sy_unsetenv("UNISACC_PRECOMMIT_TIMES");
        pt_row("flow", 3, "FAIL");
        pt_row("gate", 4, "PASS");
        if (sr_default("precommit", tdir, sizeof tdir) || cx_fmt(tpath, sizeof tpath, "%s/precommit-times.tsv", tdir)) return 2;
        sy_printf("TIMES_PATH\t%s\n", tpath);
        return 0;
    }
    if (argc == 3 && tx_eqz(argv[1], "--nodes-selftest")) {
        sy_setenv("UNISACC_PRECOMMIT_TIMES", "off", 1);
        pcf_report_nodes(argv[2], 0, 0);
        return 0;
    }
    for (a = 1; a < argc; a++) {
        if (tx_eqz(argv[a], "--run") && a + 1 < argc) rdir = argv[++a];
        else if (tx_eqz(argv[a], "--jobs") && a + 1 < argc) { const char *q = argv[++a]; jobs = 0; while (*q >= '0' && *q <= '9' && jobs < 100) jobs = jobs * 10 + (*q++ - '0'); if (*q || jobs < 1 || jobs > 32) jobs = 0; }
        else if (tx_eqz(argv[a], "--verdict") && a + 1 < argc) vfile = argv[++a];   /* written once the judge pass has run: tools/precommit.cx flow_route tells a verdict from a flow that never got there */
        else { sy_eprintf("precommit-flow: usage: precommit-flow.cx [-- --run DIR] [--jobs N] [--verdict FILE]\n"); return 2; }
    }
    {
        const char *op = sy_env("UNISACC_PRECOMMIT_OWNER_PID");
        if (op && *op >= '1' && *op <= '9') {
            long v = 0;
            while (*op >= '0' && *op <= '9' && v < 2147483647L) v = v * 10 + (*op++ - '0');
            if (!*op && v >= 2 && v != sy_pid()) pcf_owner_pid = (int)v;
        }
    }
    pcf_register_cleanup_hooks();
    if (rdir) { if (tx_copy(dir, sizeof dir, rdir, tx_len(rdir, 1100))) return 2; }
    else {
        if (cx_fmt(dir, sizeof dir, "%s/precommit-flow-%d-%ld", sy_tmpdir(), sy_pid(), sy_now_ms())) return 2;
        (void)tx_copy(pcf_own_dir, sizeof pcf_own_dir, dir, tx_len(dir, 1100));
    }
    if (sy_mkdir(dir, 0700) && sy_exists(dir) != 1) { sy_eprintf("precommit-flow: cannot make %s\n", dir); return 2; }
    pv[0] = "sh"; pv[1] = "./unisacc.com"; pv[2] = "tools/precommit.cx"; pv[3] = "--"; pv[4] = "--plan"; pv[5] = dir; pv[6] = 0;
    plan = slurp(pv, &pn);
    if (!plan) { sy_eprintf("precommit-flow: precommit --plan did not run\n"); return 1; }
    if (cx_fmt(fp, sizeof fp, "%s/flow.tsv", dir)) return 2;
    sy_unlink(fp);
    fd = sy_open_new(fp, 0600);
    if (fd < 0) { sy_eprintf("precommit-flow: cannot write %s\n", fp); return 2; }
    {   /* the ratchets gate becomes its thirteen ratchets (tools/ratchets.cx --plan), judged after the run */
        long rn; char *rp, *nb;
        if (tx_find(plan, pn, "PLAN\tratchets\t", 14) >= 0) {
            char *rv[] = {"sh", "./unisacc.com", "tools/ratchets.cx", "--", "--plan", 0};
            rp = slurp(rv, &rn);
            if (!rp || tx_find(rp, rn, "PLAN\trk-", 8) < 0) { sy_eprintf("precommit-flow: ratchets --plan did not run\n"); return 1; }
            nb = mm_alloc(pn + rn + 1);
            if (!nb) return 2;
            for (at = 0; at < pn; ) {   /* copy every plan line except the ratchets one, then the ratchet lines */
                long e = tx_chr(plan + at, pn - at, '\n'), l = e < 0 ? pn - at : e;
                if (!tx_prefix(plan + at, l, "PLAN\tratchets\t", 14)) { mm_copy(nb + nbn, pn + rn + 1 - nbn, plan + at, l); nbn += l; nb[nbn++] = '\n'; }
                at += l + 1;
            }
            mm_copy(nb + nbn, pn + rn + 1 - nbn, rp, rn); nbn += rn; nb[nbn] = 0;
            mm_free(plan); mm_free(rp); plan = nb; pn = nbn; rkx = 1;
        }
    }
    for (at = 0; at < pn; ) {
        long e = tx_chr(plan + at, pn - at, '\n'), l = e < 0 ? pn - at : e, k, nf;
        const char *ln = plan + at;
        if (tx_prefix(ln, l, "PLAN\t", 5) && (nf = tx_fields(ln, l, '\t')) >= 3) {
            long io, il, ao, al; char key[16];
            tx_field(ln, l, '\t', 1, &io, &il);
            put(fd, ln + io, il);
            { static const char hd[] = "\texec\t-\ta0=sh;a1=-c;a2=exec \"$@\" 2>&1;a3=precommit-gate";
              if (put(fd, hd, (long)sizeof hd - 1)) { sy_close(fd); return 2; } }
            for (k = 2; k < nf; k++) {
                tx_field(ln, l, '\t', k, &ao, &al);
                if (cx_fmt(key, sizeof key, ";a%ld=", k + 2)) { sy_close(fd); return 2; }
                put(fd, key, tx_len(key, 16)); put_val(fd, ln + ao, al);
            }
            if (il == 7 && tx_same(ln + io, 7, "coveval", 7)) put(fd, ";timeout_ms=30000\n", 18);   /* cov_eval's own 30 s bound */
            else put(fd, ";timeout_ms=60000\n", 18);
            nodes++;
        }
        at += l + 1;
    }
    sy_close(fd); mm_free(plan);
    t1 = sy_now_ms();
    if (nodes) {
        if (fl_load(fp, &f, why, (int)sizeof why)) { sy_eprintf("precommit-flow: REFUSE %s\n", why); return 2; }
        if (jobs < 1) { jobs = sy_ncpu(); if (jobs < 1) jobs = 4; if (jobs > 32) jobs = 32; }
        fl_set_cancel(pcf_owner_dead);
        pcf_active_flow = &f;
        r = fl_run(&f, dir, jobs, 0, 0, &s);
        pcf_active_flow = 0;
        fl_set_cancel(0);
        fl_free(&f);
        if (pcf_owner_dead()) return 143;
        if (r < 0) { sy_eprintf("precommit-flow: run dir %s unusable (%d)\n", dir, r); return 2; }
    }
    if (rkx) {   /* ratchets --from-run DIR -> DIR/out/ratchets.out and an ok/fail event for the gate */
        char *xv[] = {"sh", "./unisacc.com", "tools/ratchets.cx", "--", "--from-run", dir, 0}, ev[256]; long xn, tr = sy_now_ms();
        char *xo = slurp(xv, &xn); int xrc = -1;
        if (xo && tx_find(xo, xn, "RATCHETS\tok=", 12) >= 0) xrc = tx_find(xo, xn, "\tfail=0\t", 8) >= 0 ? 0 : 1;
        if (cx_fmt(fp, sizeof fp, "%s/out/ratchets.out", dir) || (xo && cx_write(fp, xo, xn))) { sy_eprintf("precommit-flow: cannot write %s\n", fp); return 2; }
        if (cx_fmt(fp, sizeof fp, "%s/events.tsv", dir)) return 2;
        cx_fmt(ev, sizeof ev, "EVT\t%d\tratchets\t%s\t%ld\t%d\tfrom-run\n", 99999, xrc == 0 ? "ok" : "fail", sy_now_ms() - tr, xrc);
        {   size_t on = 0; char *old = (char *)cx_read(fp, &on); long el = tx_len(ev, 256); char *nv = mm_alloc((long)on + el + 1);
            if (!nv) return 2;
            if (old && on) mm_copy(nv, (long)on + el + 1, old, (long)on);
            mm_copy(nv + on, el + 1, ev, el);
            if (cx_write(fp, nv, (long)on + el)) { sy_eprintf("precommit-flow: cannot append %s\n", fp); return 2; }
            if (old) mm_free(old); mm_free(nv);
        }
        if (xo) mm_free(xo);
    }
    if (pcf_owner_dead()) return 143;
    t2 = sy_now_ms();
    jv[0] = "/bin/sh"; jv[1] = "./unisacc.com"; jv[2] = "tools/precommit.cx"; jv[3] = "--"; jv[4] = "--from-run"; jv[5] = dir; jv[6] = 0;
    pid = sy_spawn_inherit(jv, -1);
    pcf_active_child_pid = pid > 0 ? pid : 0;
    if (pid < 0 || sy_wait_status(pid, 0, &ex, &code, &sig) != pid || !ex) { pcf_active_child_pid = 0; sy_eprintf("precommit-flow: precommit --from-run did not run\n"); return 1; }
    pcf_active_child_pid = 0;
    sy_eprintf("FLOWPC\tnodes=%d\tplan_ms=%ld\tflow_ms=%ld\tjudge_ms=%ld\trun=%s\n", nodes, t1 - t0, t2 - t1, sy_now_ms() - t2, dir);
    pcf_report_nodes(dir, t2 - t1, code);
    if (vfile) { char vb[40]; if (cx_fmt(vb, sizeof vb, "RC\t%d\n", code) || cx_write(vfile, vb, tx_len(vb, 40))) { sy_eprintf("precommit-flow: cannot write %s\n", vfile); return 2; } }
    return code;
}
