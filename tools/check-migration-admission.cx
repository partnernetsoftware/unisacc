/* tools/check-migration-admission.cx -- migration admission gate (owner directive + fable ruling).
 * Checks plans/migration-admission.tsv against plans/slice-units.tsv and prd_mempalace.md.
 * Modes:
 *   default / --repo DIR   validate repository migration admission state
 *   --selftest             run 8 self-tests (valid + 7 refusal mutations)
 *   --produce ID PATH      run selftest and write run-id bound evidence
 *   --judge ID PATH        verify run-id bound evidence for mutation-gate execution
 */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.posix
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use fsx.fs

static char *cma_read_file(const char *path, size_t *out_len) {
    FILE *f = fopen(path, "rb");
    if (!f) return 0;
    if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return 0; }
    long sz = ftell(f);
    if (sz < 0) { fclose(f); return 0; }
    rewind(f);
    char *buf = (char *)mm_alloc((size_t)sz + 1);
    if (!buf) { fclose(f); return 0; }
    size_t nr = sz > 0 ? fread(buf, 1, (size_t)sz, f) : 0;
    fclose(f);
    buf[nr] = 0;
    if (out_len) *out_len = nr;
    return buf;
}

static int cma_write_file(const char *path, const char *buf, size_t len) {
    FILE *f = fopen(path, "wb");
    if (!f) return -1;
    size_t nw = len > 0 ? fwrite(buf, 1, len, f) : 0;
    fclose(f);
    return nw == len ? 0 : -1;
}

static int cma_parse_i64(const char *s, int64_t *out) {
    if (!s || !s[0]) return -1;
    char *end = 0;
    long long v = strtoll(s, &end, 10);
    if (!end || *end != 0) return -1;
    *out = (int64_t)v;
    return 0;
}

static int cma_parse_double(const char *s, double *out) {
    if (!s || !s[0]) return -1;
    char *end = 0;
    double v = strtod(s, &end);
    if (!end || *end != 0) return -1;
    *out = v;
    return 0;
}

static int cma_count_data_lines(const char *buf, size_t len) {
    int count = 0;
    size_t i = 0;
    while (i < len) {
        size_t e = i;
        while (e < len && buf[e] != '\n') e++;
        size_t l = e - i;
        if (l > 0 && buf[e - 1] == '\r') l--;
        if (l > 0 && buf[i] != '#') count++;
        i = e + 1;
    }
    return count;
}

static int cma_split_tabs(char *line, char **cols, int max_cols) {
    int n = 0;
    char *p = line;
    while (n < max_cols) {
        cols[n++] = p;
        char *tab = strchr(p, '\t');
        if (!tab) break;
        *tab = 0;
        p = tab + 1;
    }
    return n;
}

static int check_repo(const char *repo_dir, int verbose, int *out_pass, int *out_fail) {
    int passed = 0, failed = 0;
    char su_path[4400], ma_path[4400], mp_path[4400];
    if (cx_fmt(su_path, sizeof su_path, "%s/plans/slice-units.tsv", repo_dir) ||
        cx_fmt(ma_path, sizeof ma_path, "%s/plans/migration-admission.tsv", repo_dir) ||
        cx_fmt(mp_path, sizeof mp_path, "%s/prd_mempalace.md", repo_dir)) {
        if (out_pass) *out_pass = 0;
        if (out_fail) *out_fail = 1;
        return 1;
    }

    int expected_units = 0;
    size_t su_len = 0;
    char *su = cma_read_file(su_path, &su_len);
    if (!su) {
        failed++;
        if (verbose) printf("FAIL\tslice-units-missing\tpath=%s\n", su_path);
    } else {
        expected_units = cma_count_data_lines(su, su_len);
        mm_free(su);
        if (expected_units > 0) {
            passed++;
            if (verbose) printf("PASS\tslice-units-count\tunits=%d\n", expected_units);
        } else {
            failed++;
            if (verbose) printf("FAIL\tslice-units-empty\n");
        }
    }

    size_t mp_len = 0;
    char *mp = cma_read_file(mp_path, &mp_len);
    if (!mp) {
        failed++;
        if (verbose) printf("FAIL\tprd-mempalace-missing\n");
    } else {
        const char *veto_txt = "\xe5\x8d\x95\xe5\x8d\x95\xe5\x85\x83\xe5\x87\x80\xe9\x99\x8d\xe4\xb8\x8d\xe8\xb6\xb3 2,000 B \xe5\x9b\x9e\xe9\x80\x80\xe5\x8e\x9f\xe7\x94\x9f";
        if (tx_find(mp, (long)mp_len, veto_txt, (long)strlen(veto_txt)) >= 0) {
            failed++;
            if (verbose) printf("FAIL\twithdrawn-size-veto-text-present\tfile=prd_mempalace.md\n");
        } else {
            passed++;
            if (verbose) printf("PASS\twithdrawn-size-veto-text-absent\n");
        }
        mm_free(mp);
    }

    size_t ma_len = 0;
    char *ma = cma_read_file(ma_path, &ma_len);
    if (!ma) {
        failed++;
        if (verbose) printf("FAIL\ttable-missing-or-incomplete\trows=0\texpected=%d\n", expected_units);
    } else {
        int rows = 0, measured_calls_n = 0;
        double startup_cost_sum = 0.0;
        size_t i = 0;
        while (i < ma_len) {
            size_t e = i;
            while (e < ma_len && ma[e] != '\n') e++;
            size_t l = e - i;
            if (l > 0 && ma[e - 1] == '\r') l--;
            if (l > 0 && ma[i] != '#' && !(l >= 5 && memcmp(ma + i, "unit\t", 5) == 0)) {
                char *line = (char *)mm_alloc(l + 1);
                if (!line) { failed++; break; }
                mm_copy(line, l + 1, ma + i, l);
                line[l] = 0;
                char *cols[20];
                int nc = cma_split_tabs(line, cols, 20);
                rows++;
                if (nc < 18) {
                    failed++;
                    if (verbose) printf("FAIL\trow-bad-columns\trow=%d\tcols=%d\n", rows, nc);
                } else {
                    const char *unit = cols[0];
                    const char *golden_kind = cols[2];
                    const char *golden_cases_s = cols[3];
                    const char *golden_pass_s = cols[4];
                    const char *path = cols[5];
                    const char *calls_s = cols[6];
                    const char *steps_s = cols[7];
                    const char *cost_s = cols[8];
                    const char *budget_s = cols[9];
                    const char *blockers_s = cols[11];
                    const char *source_kind = cols[12];
                    const char *verdict = cols[16];
                    const char *veto_reason = cols[17];
                    if (nc >= 20) {
                        const char *gen_friendly = cols[18];
                        const char *entries_n_s = cols[19];
                        if (strcmp(gen_friendly, "yes") != 0 && strcmp(gen_friendly, "no") != 0 &&
                            strcmp(gen_friendly, "base-only") != 0 && strcmp(gen_friendly, "extended-only") != 0 &&
                            strcmp(gen_friendly, "UNMEASURED") != 0 && strcmp(gen_friendly, "-") != 0) {
                            failed++;
                            if (verbose) printf("FAIL\tbad-gen-friendly\tunit=%s\tval=%s\n", unit, gen_friendly);
                        }
                        int64_t entries_n = 0;
                        if (strcmp(entries_n_s, "UNMEASURED") != 0 && strcmp(entries_n_s, "-") != 0 &&
                            (cma_parse_i64(entries_n_s, &entries_n) != 0 || entries_n < 0)) {
                            failed++;
                            if (verbose) printf("FAIL\tbad-entries-n\tunit=%s\tval=%s\n", unit, entries_n_s);
                        }
                    }

                    if (strcmp(veto_reason, "size") == 0) {
                        failed++;
                        if (verbose) printf("FAIL\tveto-reason-size-forbidden\tunit=%s\n", unit);
                    } else if (veto_reason[0] != 0 && strcmp(veto_reason, "-") != 0 &&
                               strcmp(veto_reason, "correctness") != 0 &&
                               strcmp(veto_reason, "speed") != 0 &&
                               strcmp(veto_reason, "maintain") != 0 &&
                               strcmp(veto_reason, "blocked") != 0) {
                        failed++;
                        if (verbose) printf("FAIL\tveto-reason-invalid\tunit=%s\treason=%s\n", unit, veto_reason);
                    }

                    if (strcmp(calls_s, "UNMEASURED") != 0) measured_calls_n++;

                    if (strcmp(verdict, "ADMIT") == 0) {
                        int row_ok = 1;
                        if (strcmp(golden_kind, "enum-full") != 0 && strcmp(golden_kind, "byte-diff") != 0) {
                            row_ok = 0;
                            if (verbose) printf("FAIL\tadmit-bad-golden-kind\tunit=%s\tkind=%s\n", unit, golden_kind);
                        }
                        int64_t g_cases = 0, g_pass = 0, calls = 0, steps = 0, blockers = -1;
                        double cost = 0.0, budget = 0.0;
                        if (cma_parse_i64(golden_cases_s, &g_cases) != 0 || cma_parse_i64(golden_pass_s, &g_pass) != 0 ||
                            g_cases <= 0 || g_pass != g_cases) {
                            row_ok = 0;
                            if (verbose) printf("FAIL\tadmit-golden-mismatch\tunit=%s\tpass=%s\tcases=%s\n", unit, golden_pass_s, golden_cases_s);
                        }
                        if (strcmp(path, "startup") != 0 && strcmp(path, "hot") != 0) {
                            row_ok = 0;
                            if (verbose) printf("FAIL\tadmit-bad-path\tunit=%s\tpath=%s\n", unit, path);
                        }
                        if (strcmp(calls_s, "UNMEASURED") == 0 || cma_parse_i64(calls_s, &calls) != 0 || calls < 0) {
                            row_ok = 0;
                            if (verbose) printf("FAIL\tadmit-calls-unmeasured\tunit=%s\n", unit);
                        }
                        if (cma_parse_i64(steps_s, &steps) != 0 || steps < 0) {
                            row_ok = 0;
                            if (verbose) printf("FAIL\tadmit-bad-steps\tunit=%s\n", unit);
                        }
                        if (cma_parse_double(cost_s, &cost) != 0 || cma_parse_double(budget_s, &budget) != 0) {
                            row_ok = 0;
                            if (verbose) printf("FAIL\tadmit-bad-cost-or-budget\tunit=%s\n", unit);
                        } else if (row_ok) {
                            double derived = (double)calls * (10.68 + (double)steps * 0.005);
                            double diff = cost > derived ? cost - derived : derived - cost;
                            double tol = derived * 0.05 + 0.5;
                            if (diff > tol) {
                                row_ok = 0;
                                if (verbose) printf("FAIL\tadmit-cost-not-derived\tunit=%s\tcost=%.2f\tderived=%.2f\n", unit, cost, derived);
                            }
                            if (cost > budget) {
                                row_ok = 0;
                                if (verbose) printf("FAIL\tadmit-over-budget\tunit=%s\tcost=%.2f\tbudget=%.2f\n", unit, cost, budget);
                            }
                            if (strcmp(path, "startup") == 0) startup_cost_sum += cost;
                        }
                        if (cma_parse_i64(blockers_s, &blockers) != 0 || blockers != 0) {
                            row_ok = 0;
                            if (verbose) printf("FAIL\tadmit-blockers-nonzero\tunit=%s\tblockers=%s\n", unit, blockers_s);
                        }
                        if (strcmp(source_kind, "table") != 0 && strcmp(source_kind, "generator") != 0) {
                            row_ok = 0;
                            if (verbose) printf("FAIL\tadmit-bad-source-kind\tunit=%s\tsource=%s\n", unit, source_kind);
                        }
                        if (!row_ok) failed++;
                    }
                }
                mm_free(line);
            }
            i = e + 1;
        }
        mm_free(ma);

        if (rows != expected_units || rows == 0) {
            failed++;
            if (verbose) printf("FAIL\ttable-missing-or-incomplete\trows=%d\texpected=%d\n", rows, expected_units);
        } else {
            passed++;
            if (verbose) printf("PASS\ttable-row-count\trows=%d\n", rows);
        }
        if (rows > 0 && measured_calls_n == 0) {
            failed++;
            if (verbose) printf("FAIL\tall-calls-unmeasured\n");
        } else if (rows > 0) {
            passed++;
            if (verbose) printf("PASS\tmeasured-calls-present\tcount=%d\n", measured_calls_n);
        }
        if (startup_cost_sum > 2000.0) {
            failed++;
            if (verbose) printf("FAIL\tstartup-budget-exceeded\tsum=%.2f\n", startup_cost_sum);
        }
    }

    if (out_pass) *out_pass = passed;
    if (out_fail) *out_fail = failed;
    return failed ? 1 : 0;
}

static int setup_mock_repo(const char *dir, const char *ma_row, const char *mp_text) {
    char p[4400], cmd[4600];
    if (cx_fmt(cmd, sizeof cmd, "%s/plans", dir)) return -1;
    sy_mkdir(dir, 0755);
    sy_mkdir(cmd, 0755);
    if (cx_fmt(p, sizeof p, "%s/plans/slice-units.tsv", dir)) return -1;
    const char *su_line = "m25.o\tcx/m25.cx\tm25\t-\t100\t0\t0\t-\tok\n";
    if (cma_write_file(p, su_line, strlen(su_line)) != 0) return -1;
    if (cx_fmt(p, sizeof p, "%s/prd_mempalace.md", dir)) return -1;
    if (cma_write_file(p, mp_text, strlen(mp_text)) != 0) return -1;
    if (ma_row) {
        if (cx_fmt(p, sizeof p, "%s/plans/migration-admission.tsv", dir)) return -1;
        if (cma_write_file(p, ma_row, strlen(ma_row)) != 0) return -1;
    }
    return 0;
}

static int run_selftest(int verbose) {
    int sc = 0, passed = 0, failed = 0;
    if (fsx_scratch(&sc, "cma-st-") != 0) return 2;
    const char *base = fsx_scratch_dir(sc);
    char d[4400];
    const char *ok_row = "m25.o\ttable\tenum-full\t10\t10\tstartup\t2\t100\t22.36\t100.0\tdriveargs\t0\ttable\t1200\t9405\t-8205\tADMIT\t-\n";

    /* 1. valid-admit-pass */
    cx_fmt(d, sizeof d, "%s/t1", base);
    setup_mock_repo(d, ok_row, "# clean\n");
    if (check_repo(d, 0, 0, 0) == 0) { passed++; if (verbose) printf("PASS\tvalid-admit-pass\n"); }
    else { failed++; if (verbose) printf("FAIL\tvalid-admit-pass\n"); }

    /* 2. mut-missing-table-refused */
    cx_fmt(d, sizeof d, "%s/t2", base);
    setup_mock_repo(d, 0, "# clean\n");
    if (check_repo(d, 0, 0, 0) != 0) { passed++; if (verbose) printf("PASS\tmut-missing-table-refused\n"); }
    else { failed++; if (verbose) printf("FAIL\tmut-missing-table-refused\n"); }

    /* 3. mut-withdrawn-size-veto-text-refused */
    cx_fmt(d, sizeof d, "%s/t3", base);
    setup_mock_repo(d, ok_row, "\xe5\x8d\x95\xe5\x8d\x95\xe5\x85\x83\xe5\x87\x80\xe9\x99\x8d\xe4\xb8\x8d\xe8\xb6\xb3 2,000 B \xe5\x9b\x9e\xe9\x80\x80\xe5\x8e\x9f\xe7\x94\x9f\n");
    if (check_repo(d, 0, 0, 0) != 0) { passed++; if (verbose) printf("PASS\tmut-withdrawn-size-veto-text-refused\n"); }
    else { failed++; if (verbose) printf("FAIL\tmut-withdrawn-size-veto-text-refused\n"); }

    /* 4. mut-veto-reason-size-refused */
    cx_fmt(d, sizeof d, "%s/t4", base);
    setup_mock_repo(d, "m25.o\ttable\tenum-full\t10\t10\tstartup\t2\t100\t22.36\t100.0\tdriveargs\t0\ttable\t1200\t9405\t-8205\tVETO\tsize\n", "# clean\n");
    if (check_repo(d, 0, 0, 0) != 0) { passed++; if (verbose) printf("PASS\tmut-veto-reason-size-refused\n"); }
    else { failed++; if (verbose) printf("FAIL\tmut-veto-reason-size-refused\n"); }

    /* 5. mut-admit-calls-unmeasured-refused */
    cx_fmt(d, sizeof d, "%s/t5", base);
    setup_mock_repo(d, "m25.o\ttable\tenum-full\t10\t10\tstartup\tUNMEASURED\t100\t22.36\t100.0\tdriveargs\t0\ttable\t1200\t9405\t-8205\tADMIT\t-\n", "# clean\n");
    if (check_repo(d, 0, 0, 0) != 0) { passed++; if (verbose) printf("PASS\tmut-admit-calls-unmeasured-refused\n"); }
    else { failed++; if (verbose) printf("FAIL\tmut-admit-calls-unmeasured-refused\n"); }

    /* 6. mut-golden-pass-lt-cases-refused */
    cx_fmt(d, sizeof d, "%s/t6", base);
    setup_mock_repo(d, "m25.o\ttable\tenum-full\t10\t9\tstartup\t2\t100\t22.36\t100.0\tdriveargs\t0\ttable\t1200\t9405\t-8205\tADMIT\t-\n", "# clean\n");
    if (check_repo(d, 0, 0, 0) != 0) { passed++; if (verbose) printf("PASS\tmut-golden-pass-lt-cases-refused\n"); }
    else { failed++; if (verbose) printf("FAIL\tmut-golden-pass-lt-cases-refused\n"); }

    /* 7. mut-hand-source-admit-refused */
    cx_fmt(d, sizeof d, "%s/t7", base);
    setup_mock_repo(d, "m25.o\ttable\tenum-full\t10\t10\tstartup\t2\t100\t22.36\t100.0\tdriveargs\t0\thand\t1200\t9405\t-8205\tADMIT\t-\n", "# clean\n");
    if (check_repo(d, 0, 0, 0) != 0) { passed++; if (verbose) printf("PASS\tmut-hand-source-admit-refused\n"); }
    else { failed++; if (verbose) printf("FAIL\tmut-hand-source-admit-refused\n"); }

    /* 8. mut-blockers-nonzero-admit-refused */
    cx_fmt(d, sizeof d, "%s/t8", base);
    setup_mock_repo(d, "m25.o\ttable\tenum-full\t10\t10\tstartup\t2\t100\t22.36\t100.0\tdriveargs\t1\ttable\t1200\t9405\t-8205\tADMIT\t-\n", "# clean\n");
    if (check_repo(d, 0, 0, 0) != 0) { passed++; if (verbose) printf("PASS\tmut-blockers-nonzero-admit-refused\n"); }
    else { failed++; if (verbose) printf("FAIL\tmut-blockers-nonzero-admit-refused\n"); }

    fsx_scratch_drop(sc);
    if (verbose) printf("CHECK_MIGRATION_ADMISSION_SELFTEST\tpassed=%d\tfailed=%d\n", passed, failed);
    return failed ? 1 : 0;
}

int main(int argc, char **argv) {
    if (argc >= 2 && strcmp(argv[1], "--selftest") == 0) {
        return run_selftest(1);
    }
    if (argc >= 4 && strcmp(argv[1], "--produce") == 0) {
        if (run_selftest(0) != 0) return 1;
        char buf[512];
        if (cx_fmt(buf, sizeof buf, "run_id=%s\nverdict=PASS\nfailed=0\n", argv[2])) return 2;
        return cma_write_file(argv[3], buf, strlen(buf)) == 0 ? 0 : 2;
    }
    if (argc >= 4 && strcmp(argv[1], "--judge") == 0) {
        const char *run_id = argv[2];
        const char *ev_path = argv[3];
        if (sy_exists(ev_path) != 1) {
            printf("FAIL\tmigration_admission_missing\n");
            return 1;
        }
        size_t evn = 0;
        char *ev = cma_read_file(ev_path, &evn);
        if (!ev) {
            printf("FAIL\tmigration_admission_missing\n");
            return 1;
        }
        char want[256];
        cx_fmt(want, sizeof want, "run_id=%s\n", run_id);
        int has_rid = (tx_find(ev, (long)evn, want, (long)strlen(want)) >= 0);
        int has_pass = (tx_find(ev, (long)evn, "verdict=PASS\n", 13) >= 0 &&
                        tx_find(ev, (long)evn, "failed=0\n", 9) >= 0);
        mm_free(ev);
        if (!has_rid) {
            printf("FAIL\tmigration_admission_stale\n");
            return 1;
        }
        if (!has_pass) {
            printf("FAIL\tmigration_admission_exec\n");
            return 1;
        }
        printf("PASS\tmigration_admission_exec\n");
        return 0;
    }

    const char *repo_dir = ".";
    if (argc >= 3 && strcmp(argv[1], "--repo") == 0) repo_dir = argv[2];
    int passed = 0, failed = 0;
    int rc = check_repo(repo_dir, 1, &passed, &failed);
    printf("CHECK_MIGRATION_ADMISSION\tverdict=%s\tpassed=%d\tfailed=%d\n",
           failed ? "RED" : "GREEN", passed, failed);
    return rc;
}
