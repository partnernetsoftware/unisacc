/* tools/e2stream-child.cx -- run one command through e2s_run; a timeout is e2s_raise (stderr, rc 1).
 *   sh ./unisacc.com tools/e2stream-child.cx -- CMD...
 * e2s_start() derives the repository root as realpath(dirname(__FILE__)/../..), a convention for checks two
 * directories deep (exec/pp); from tools/ it lands on the repository's parent.  e2s_run() never reads that
 * root -- the caller passes CWD explicitly -- so the driver stays in tools/ and hands its cwd through. */

#pragma unisa use cxlib.e2stream
int main(int argc, char **argv) {
    char *out = 0, *err = 0; size_t on = 0, en = 0; int rc;
    char r[4096], td[4400];
    if (argc < 2) return 2;
    e2s_start(__FILE__, "e2c-", r, sizeof r, td, sizeof td);
    rc = e2s_run(argv + 1, ".", 1.0, &out, &on, &err, &en);
    printf("rc=%d out=%.*s err=%.*s\n", rc, (int)on, out, (int)en, err);
    return 0;
}
