/* Install a locally qualified development candidate; no signing/publication.
 * Kernel context must still describe the current bootstrap and source tree.
 * The candidate's embedded package must exactly match the prepared package.
 * This records provenance; it does not infer functional PASS from logs. */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.kernelcontext
#pragma unisa use cxlib.rebuildcontext
#pragma unisa use cxlib.mixedprofiles
static void die(const char *s){fprintf(stderr,"candidate-install: REFUSE %s\n",s);exit(2);}
static void path(char *p,size_t cap,const char *a,const char *b){int n=snprintf(p,cap,"%s/%s",a,b);if(n<0||(size_t)n>=cap)die("path");}
static char *load(const char *p,size_t *n){struct stat st;if(lstat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>268435456)die(p);char *s=cx_read(p,n);if(!s||*n!=(size_t)st.st_size)die("read/size changed");return s;}
static void saved(const char *p,const char *s,size_t n,int mode){int f=open(p,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC|O_NOFOLLOW,mode);if(f<0)die("exclusive file");while(n){ssize_t k=write(f,s,n);if(k<0&&errno==EINTR)continue;if(k<=0)die("write; partial retained");s+=k;n-=(size_t)k;}if(fsync(f)||close(f))die("fsync/close");}
static unsigned long long little(const char *p){unsigned long long n=0;int i;for(i=7;i>=0;i--)n=(n<<8)|(unsigned char)p[i];return n;}
/* Missing/unknown side receipts are never inferred to be legacy P7. All
 * accepted schemas retain their own contracts; source-P3 has no fallback. */
static int package_mode(const char *file,char dir[4096]){if(strlen(file)>=4096)die("package path bound");strcpy(dir,file);char *slash=strrchr(dir,'/');if(!slash||slash==dir||!slash[1])die("package parent path");*slash=0;char p[4400];path(p,sizeof p,dir,"package.tsv");struct stat st;errno=0;if(lstat(p,&st)){if(errno==ENOENT)die("prepared-package-receipt-missing");die("prepared-package-receipt-stat");}if(!S_ISREG(st.st_mode))die("prepared-package-receipt-regular");size_t n;char *s=load(p,&n);const char *source="source-package-v1\n",*legacy="PREPARED\tpackage-refresh\tno-test-result\n",*adopt="source-package-adoption-v1\n",*mixed="source-package-mixed-v1\n",*mixed2="source-package-mixed-v2\n";int mode=(n>=strlen(mixed)&&!memcmp(s,mixed,strlen(mixed)))||(n>=strlen(mixed2)&&!memcmp(s,mixed2,strlen(mixed2)))?4:n>=strlen(adopt)&&!memcmp(s,adopt,strlen(adopt))?3:n>=strlen(source)&&!memcmp(s,source,strlen(source))?2:n>=strlen(legacy)&&!memcmp(s,legacy,strlen(legacy))?1:0;free(s);if(!mode)die("prepared-package-receipt-schema");{char expected[4400];path(expected,sizeof expected,dir,"compiler.pkg");if(strcmp(file,expected))die("prepared-package-canonical-compiler-pkg-required");}return mode;}
/* Canonical __FILE__ binds the selected source role only. It does not prove
 * executable bytes came from that source; external build evidence is required. */
static void consumer_source_role(const char *tool_root){char expected[4400],own[4096],canonical[4096];path(expected,sizeof expected,tool_root,"tools/candidate-install.cx");if(!realpath(expected,canonical)||strcmp(expected,canonical)||!realpath(__FILE__,own)||strcmp(own,expected))die("mixed-v2-consumer-source-role");}
static rb_result admit_candidate(const char *root,const char *generation,const char *packages,int mode){
 char bootstrap[4400],why[2048];path(bootstrap,sizeof bootstrap,root,"unisacc.com");rb_result r;int failed=mode==4?rb_verify_mixed_candidate(root,generation,packages,bootstrap,&r,why,sizeof why):mode==3?rb_verify_adopted_candidate(root,generation,packages,bootstrap,&r,why,sizeof why):mode==2?rb_verify_candidate(root,generation,packages,bootstrap,&r,why,sizeof why):rb_verify_legacy_candidate(root,generation,packages,bootstrap,&r,why,sizeof why);if(failed)die(why);if(r.package_kind!=mode)die("candidate-admission-schema-mismatch");
 if(mode==4&&mp_explicit_v2(r.mixed_profile)){consumer_source_role(r.mixed_tool_root);printf("MATERIAL_OBSERVATION\tsource-package-mixed-v2\tmaterial-profile=%s\tsource-root=%s\ttool-root=%s\texecutable-provenance=UNVERIFIED\tno-test-result\n",r.mixed_profile,root,r.mixed_tool_root);}return r;
}
static void same_admission(const rb_result *a,const rb_result *b){
 if(strcmp(a->mixed_tool_root,b->mixed_tool_root))die("candidate-admission-tool-root-changed");
 if((a->package_kind!=1&&a->package_kind!=2&&a->package_kind!=3&&a->package_kind!=4)||a->package_kind!=b->package_kind||strcmp(a->mixed_profile,b->mixed_profile)||strcmp(a->source,b->source)||strcmp(a->bootstrap,b->bootstrap)||strcmp(a->bootstrap_record_source,b->bootstrap_record_source)||strcmp(a->builder_record,b->builder_record)||strcmp(a->root_product,b->root_product)||a->root_has_native!=b->root_has_native||strcmp(a->root_native,b->root_native)||strcmp(a->product,b->product)||strcmp(a->package,b->package)||strcmp(a->kernel_context,b->kernel_context)||strcmp(a->product_context,b->product_context)||strcmp(a->package_epoch_artifact,b->package_epoch_artifact)||strcmp(a->package_epoch_record,b->package_epoch_record)||strcmp(a->package_epoch_source,b->package_epoch_source)||a->model_inputs!=b->model_inputs||a->source_jobs!=b->source_jobs||a->source_models!=b->source_models||strcmp(a->adoption_witness,b->adoption_witness))die("candidate-admission-endpoints-changed");
 /* Candidate build/native supplemental metadata is intentionally allowed to
  * become present between endpoints. The full schema-specific v1/v2/v3 contract
  * and all immutable inputs above
  * must match; both endpoints still validate any present metadata completely. */
}
static void expected_file_hash(const char *file,const char *expected,const char *reason){size_t n;char actual[65];char *s=load(file,&n);cx_sha256_hex(s,n,actual);free(s);if(strcmp(actual,expected))die(reason);}
static void prepared_wire(char *wire,size_t cap,const rb_result *r,const char *next_record,const char *root){
 char root_record[65],p[4400];size_t z;path(p,sizeof p,root,"unisacc.com.build.json");char *s=load(p,&z);cx_sha256_hex(s,z,root_record);free(s);
 int n=snprintf(wire,cap,"candidate-install-prepared-v1\nsource\t%s\nproduct\t%s\npackage\t%s\ncontext\t%s\nkernel\t%s\nbootstrap\t%s\nbuilder-record\t%s\nroot-record\t%s\nnext-record\t%s\n",r->source,r->product,r->package,r->product_context,r->kernel_context,r->root_product,r->builder_record,root_record,next_record);
 if(n<0||(size_t)n>=cap)die("prepared receipt bound");
}
static int finish_prepared(int argc,char **argv){
 if(argc!=6){fputs("usage: finish ROOT KERNEL_GENERATION CANDIDATE_COM PREPARED_PACKAGE\n",stderr);return 2;}
 char root[4096],gen[4096],candidate[4096],package_file[4096],package_dir[4096],p[4400],watch[4400],next[4400],nextrecord[4400],target[4400],targetrecord[4400],sid[65],record_hash[65],wire[1024],why[2048];
 if(!realpath(argv[2],root)||!realpath(argv[3],gen)||!realpath(argv[4],candidate)||!realpath(argv[5],package_file))die("finish paths");
 if(package_mode(package_file,package_dir)!=4)die("phased-install-requires-mixed-package");
 path(p,sizeof p,gen,"unisacc-next.com");if(strcmp(candidate,p))die("finish candidate path");
 path(next,sizeof next,root,".unisacc-c43-native.next");path(nextrecord,sizeof nextrecord,root,".unisacc-c43-native.next.build.json");
 size_t n;char *bytes=load(nextrecord,&n);cx_sha256_hex(bytes,n,record_hash);free(bytes);
 rb_result admitted=admit_candidate(root,gen,package_dir,4);
 prepared_wire(wire,sizeof wire,&admitted,record_hash,root);
 path(p,sizeof p,gen,"candidate-install-prepared.tsv");bytes=load(p,&n);if(n!=strlen(wire)||memcmp(bytes,wire,n))die("prepared admission endpoints changed");free(bytes);
 expected_file_hash(next,admitted.product,"staged candidate bytes changed");expected_file_hash(candidate,admitted.product,"generation candidate bytes changed");
 path(p,sizeof p,gen,"bootstrap-before-install.com");expected_file_hash(p,admitted.root_product,"saved root bytes changed");
 path(p,sizeof p,gen,"bootstrap-before-install.com.build.json");{char original[65];size_t z;char *s=load(p,&z);cx_sha256_hex(s,z,original);free(s);path(p,sizeof p,root,"unisacc.com.build.json");expected_file_hash(p,original,"root record changed");}
 path(p,sizeof p,root,"unisacc.com");expected_file_hash(p,admitted.root_product,"root builder changed");
 path(p,sizeof p,gen,"identity-helper");path(watch,sizeof watch,root,"tools/bound");char *v[]={watch,(char *)"15",p,root,0};np_result id={0};
 if(np_run(v,root,0,20,&id,why,sizeof why)||id.rc||id.errn||id.outn!=65||id.out[64]!='\n')die("fresh source during finish");memcpy(sid,id.out,64);sid[64]=0;np_free(&id);if(strcmp(sid,admitted.source))die("finish source changed");
 /* A frozen root may itself be the immutable package bootstrap. Verify the
  * identical final admission without overwriting it; promotion consumes the
  * staged bytes and this distinct receipt, never a fabricated install. */
 if(!strcmp(argv[1],"verify-prepared")){printf("VERIFIED\tstaged-development-candidate\tno-release-qualification\nartifact\t%s\nsource\t%s\nprevious\t%s\n",admitted.product,admitted.source,admitted.root_product);return 0;}
 path(target,sizeof target,root,"unisacc.com");path(targetrecord,sizeof targetrecord,root,"unisacc.com.build.json");
 if(rename(next,target))die("replace product");if(rename(nextrecord,targetrecord))die("product replaced but provenance rename failed; backup retained");
 int fd=open(root,O_RDONLY|O_DIRECTORY|O_CLOEXEC);if(fd<0||fsync(fd)||close(fd))die("directory fsync");
 printf("INSTALLED\tdevelopment-only\tno-release-qualification\nartifact\t%s\nsource\t%s\nprevious\t%s\n",admitted.product,admitted.source,admitted.root_product);return 0;
}
int main(int argc,char **argv){
 if(argc==6&&(!strcmp(argv[1],"finish")||!strcmp(argv[1],"verify-prepared")))return finish_prepared(argc,argv);
 int prepare_only=argc==6&&!strcmp(argv[1],"prepare");if(prepare_only){argc--;argv++;}
 if(argc!=5){fputs("usage: ROOT KERNEL_GENERATION CANDIDATE_COM PREPARED_PACKAGE\n",stderr);return 2;}char root[4096],generation[4096],package_file[4096],package_dir[4096],candidate[4096],sha[65],after[65],hash[65],oldhash[65],p[4400],helper[4400],watch[4400],why[1024];if(!realpath(argv[1],root)||!realpath(argv[2],generation)||!realpath(argv[3],candidate)||!realpath(argv[4],package_file))die("paths");int mode=package_mode(package_file,package_dir);rb_result admitted={0};{char expected[4400];path(expected,sizeof expected,generation,"unisacc-next.com");if(strcmp(candidate,expected))die("candidate-must-be-generation-unisacc-next-com");admitted=admit_candidate(root,generation,package_dir,mode);}kc_check(root,generation,sha);if(strcmp(sha,admitted.source))die("candidate-initial-source-changed");
 size_t cn,pn,on,rn;char *c=load(candidate,&cn),*pkg=load(package_file,&pn);if(cn<16||memcmp(c+cn-16,"UNIPKG1\n",8)||little(c+cn-8)!=pn||pn>cn-16||memcmp(c+cn-16-pn,pkg,pn))die("candidate/prepared package mismatch");char prepared_hash[65];cx_sha256_hex(pkg,pn,prepared_hash);free(pkg);cx_sha256_hex(c,cn,hash);if(strcmp(hash,admitted.product)||strcmp(prepared_hash,admitted.package))die("candidate-loaded-material-differs-from-admission");
 path(helper,sizeof helper,generation,"identity-helper");path(watch,sizeof watch,root,"tools/bound");char *v[]={watch,"15",helper,root,"write",candidate,sha,0};np_result r;if(np_run(v,root,0,20,&r,why,sizeof why))die(why);if(r.rc||r.errn)die("candidate provenance write");np_free(&r);int k=snprintf(p,sizeof p,"%s.build.json",candidate);if(k<0||(size_t)k>=sizeof p)die("record path");char *record=load(p,&rn);
 /* The legacy source identity enumerates ten support paths. Bind the newer
  * construction tools and exact code slices separately, without pretending
  * they were present in that older source-identity domain. */
 int explicit_mixed=mode==4&&mp_explicit_v2(admitted.mixed_profile);np_buf evidence={0};np_puts(&evidence,explicit_mixed?"native-development-construction-v2\nsource\t":"native-development-construction-v1\nsource\t");np_puts(&evidence,sha);np_puts(&evidence,"\nartifact\t");np_puts(&evidence,hash);np_puts(&evidence,"\n");if(explicit_mixed){np_puts(&evidence,"material-profile\t");np_puts(&evidence,admitted.mixed_profile);np_puts(&evidence,"\nsource-root\t");np_puts(&evidence,root);np_puts(&evidence,"\ntool-root\t");np_puts(&evidence,admitted.mixed_tool_root);np_puts(&evidence,"\n");}const char *support[]={"tools/package-refresh.cx","tools/cxlib/kernelcontext.cx","tools/candidate-install.cx","seed/ape.c"};int i;char h[65];size_t en;char *bytes;for(i=0;i<4;i++){path(p,sizeof p,explicit_mixed&&i<3?admitted.mixed_tool_root:root,support[i]);bytes=load(p,&en);cx_sha256_hex(bytes,en,h);free(bytes);np_puts(&evidence,support[i]);np_puts(&evidence,"\t");np_puts(&evidence,h);np_puts(&evidence,"\n");}
 const char *material[]={"context.sha256","slice-win-x86_64","slice-lnx-x86_64","slice-lnx-arm64","slice-osx-x86_64","slice-osx-arm64"};for(i=0;i<6;i++){path(p,sizeof p,generation,material[i]);bytes=load(p,&en);cx_sha256_hex(bytes,en,h);free(bytes);np_puts(&evidence,material[i]);np_puts(&evidence,"\t");np_puts(&evidence,h);np_puts(&evidence,"\n");}bytes=load(package_file,&en);cx_sha256_hex(bytes,en,h);free(bytes);np_puts(&evidence,"package\t");np_puts(&evidence,h);np_puts(&evidence,"\n");cx_sha256_hex(evidence.p,evidence.n,h);k=snprintf(p,sizeof p,"%s.native.tsv",candidate);if(k<0||(size_t)k>=sizeof p)die("native receipt path");saved(p,evidence.p,evidence.n,0600);free(evidence.p);
 if(rn<3||memcmp(record+rn-3,"\n}\n",3))die("provenance shape");np_buf extended={0};np_put(&extended,record,rn-3);np_puts(&extended,",\n  \"native_construction_sha256\": \"");np_puts(&extended,h);np_puts(&extended,"\"\n}\n");free(record);record=extended.p;rn=extended.n;
 path(p,sizeof p,root,"unisacc.com");char *old=load(p,&on);cx_sha256_hex(old,on,oldhash);path(p,sizeof p,generation,"bootstrap-before-install.com");saved(p,old,on,0700);free(old);path(p,sizeof p,root,"unisacc.com.build.json");old=load(p,&on);path(p,sizeof p,generation,"bootstrap-before-install.com.build.json");saved(p,old,on,0600);free(old);
 char next[4400],nextrecord[4400],target[4400],targetrecord[4400];path(next,sizeof next,root,".unisacc-c43-native.next");path(nextrecord,sizeof nextrecord,root,".unisacc-c43-native.next.build.json");saved(next,c,cn,0700);saved(nextrecord,record,rn,0600);char next_record_hash[65];cx_sha256_hex(record,rn,next_record_hash);free(c);free(record);kc_check(root,generation,after);if(strcmp(sha,after))die("source changed during installation");path(target,sizeof target,root,"unisacc.com");path(targetrecord,sizeof targetrecord,root,"unisacc.com.build.json");
 if(prepare_only){if(mode!=4)die("phased-install-requires-mixed-package");char wire[1024];prepared_wire(wire,sizeof wire,&admitted,next_record_hash,root);path(p,sizeof p,generation,"candidate-install-prepared.tsv");saved(p,wire,strlen(wire),0600);printf("PREPARED\tmixed-candidate-install\trequires-finish\tno-release-qualification\n");return 0;}
 {rb_result final=admit_candidate(root,generation,package_dir,mode);same_admission(&admitted,&final);if(strcmp(final.product,hash)||strcmp(final.package,prepared_hash)||strcmp(final.source,sha)||strcmp(final.source,after))die("candidate-final-material-source-changed");char backup[4400];path(backup,sizeof backup,generation,"bootstrap-before-install.com");expected_file_hash(backup,mode==4?admitted.root_product:admitted.bootstrap,"saved-builder-bytes-changed");path(backup,sizeof backup,generation,"bootstrap-before-install.com.build.json");if(mode==4){char original[65];size_t z;char *s=load(backup,&z);cx_sha256_hex(s,z,original);free(s);path(backup,sizeof backup,root,"unisacc.com.build.json");expected_file_hash(backup,original,"root-record-changed");}else expected_file_hash(backup,admitted.builder_record,"saved-builder-original-record-changed");if(strcmp(oldhash,admitted.root_product))die("saved-builder-differs-from-admission");expected_file_hash(next,hash,"staged-candidate-bytes-changed");expected_file_hash(nextrecord,next_record_hash,"staged-candidate-record-changed");}
 /* Atomic replacement of each regular file; exclusive backups are retained.
  * A failure between renames is an installation error, never reported success. */
 if(rename(next,target))die("replace product");if(rename(nextrecord,targetrecord))die("product replaced but provenance rename failed; backup retained");int fd=open(root,O_RDONLY|O_DIRECTORY|O_CLOEXEC);if(fd<0||fsync(fd)||close(fd))die("directory fsync");
 printf("INSTALLED\tdevelopment-only\tno-release-qualification\nartifact\t%s\nsource\t%s\nprevious\t%s\nbytes\t%lu\n",hash,sha,oldhash,(unsigned long)cn);return 0;
}
