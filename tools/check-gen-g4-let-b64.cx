/* tools/check-gen-g4-let-b64.cx
 * sh ./unisacc.com tools/check-gen-g4-let-b64.cx --
 */
int main(int argc, char **argv) {
    char *av[6];
    char *out = 0;
    size_t n = 0;
    int rc;
    FILE *f;
    long sz;
    int ch;
    const char *p = "ujs/practice/uxe/demo/g4-let/let-b64.js";
    (void)argc; (void)argv;
    av[0] = "sh";
    av[1] = "./unisacc.com";
    av[2] = "tools/gen-g4-let-b64.cx";
    av[3] = "--";
    av[4] = "--check";
    av[5] = 0;
    rc = cx_runv_timeout(av, 40, &out, &n);
    if (out && n) fwrite(out, 1, n, stdout);
    if (out) { free(out); out = 0; n = 0; }
    if (rc != 0) return 1;
    f = fopen(p, "rb+");
    if (!f) { fprintf(stderr, "no let-b64.js\n"); return 2; }
    if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return 2; }
    sz = ftell(f);
    if (sz < 40) { fclose(f); return 2; }
    if (fseek(f, 30, SEEK_SET) != 0) { fclose(f); return 2; }
    ch = fgetc(f);
    if (ch == EOF) { fclose(f); return 2; }
    if (fseek(f, 30, SEEK_SET) != 0) { fclose(f); return 2; }
    fputc(ch ^ 1, f);
    fclose(f);
    rc = cx_runv_timeout(av, 40, &out, &n);
    if (out && n) fwrite(out, 1, n, stdout);
    if (out) { free(out); out = 0; n = 0; }
    f = fopen(p, "rb+");
    if (!f) return 2;
    if (fseek(f, 30, SEEK_SET) != 0) { fclose(f); return 2; }
    fputc(ch, f);
    fclose(f);
    if (rc == 0) {
        fprintf(stderr, "gen-g4-let-b64 --check passed after tamper\n");
        return 1;
    }
    printf("PASS\ttamper-check-red\n");
    printf("UJS_GEN_G4_LET_B64_OK\n");
    return 0;
}
