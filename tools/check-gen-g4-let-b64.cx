/* tools/check-gen-g4-let-b64.cx
 * sh ./unisacc.com tools/check-gen-g4-let-b64.cx --
 */
int main(int argc, char **argv) {
    char *av[6];
    char *out = 0;
    size_t n = 0;
    int rc;
    (void)argc; (void)argv;
    av[0] = "sh";
    av[1] = "./unisacc.com";
    av[2] = "tools/gen-g4-let-b64.cx";
    av[3] = "--";
    av[4] = "--check";
    av[5] = 0;
    rc = cx_runv_timeout(av, 30, &out, &n);
    if (out && n) fwrite(out, 1, n, stdout);
    if (out) free(out);
    if (rc != 0) return 1;
    printf("UJS_GEN_G4_LET_B64_OK\n");
    return 0;
}
