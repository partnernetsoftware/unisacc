#pragma unisa use chrome_dom
/* tools/check-uxe-tex16.cx -- 16 texel;probes.js 由 proj --write.
 * sh ./unisacc.com tools/check-uxe-tex16.cx --
 */
static int failed;
static void ck(int ok, const char *lab) {
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", lab);
    if (!ok) failed++;
}
static int dump(const char *url, const char *want, const char *lab) {
    const char *fin[3];
    int retries = 0, rc;
    fin[0] = "TEX16_OK";
    fin[1] = "TEX16_FAIL";
    fin[2] = "TEX16_ERR";
    rc = chd_dump_expect("/usr/bin/google-chrome", url, want, fin, 3, lab, 3, 25, &retries);
    if (rc == 3) { printf("TEX16_UNMEASURED\tno-chrome\n"); return 2; }
    ck(rc == 0, lab);
    return rc == 3 ? 2 : 0;
}
int main(void) {
    char cwd[512], url[700], u2[720], u3[720];
    const char *pre = "file://";
    const char *suf = "/ujs/practice/uxe/test/uxe-tex16.html";
    int n, i;
    FILE *f = fopen("ujs/practice/uxe/test/tex16-probes.js", "rb");
    if (!f) { printf("FAIL\tno-probes-js\n"); return 1; }
    fclose(f);
    if (!getcwd(cwd, sizeof cwd)) return 2;
    n = 0;
    while (pre[n]) { url[n] = pre[n]; n++; }
    for (i = 0; cwd[i] && n < 500; i++) url[n++] = cwd[i];
    for (i = 0; suf[i] && n < 640; i++) url[n++] = suf[i];
    url[n] = 0;
    for (i = 0; url[i]; i++) { u2[i] = url[i]; u3[i] = url[i]; }
    u2[i] = 0; u3[i] = 0;
    {
        const char *q1 = "?tamper=flipy";
        const char *q2 = "?tamper=texel";
        int k;
        for (k = 0; q1[k]; k++) u2[i + k] = q1[k];
        u2[i + k] = 0;
        for (k = 0; q2[k]; k++) u3[i + k] = q2[k];
        u3[i + k] = 0;
    }
    if (dump(url, "TEX16_OK", "tex16-probes")) return 2;
    if (dump(u2, "TEX16_FAIL", "tex16-flipy")) return 2;
    if (dump(u3, "TEX16_FAIL", "tex16-texel")) return 2;

    printf("CHECK_UXE_TEX16\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
