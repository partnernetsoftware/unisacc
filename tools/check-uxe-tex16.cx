#pragma unisa use chrome_dom
/* tools/check-uxe-tex16.cx -- 16 texel 中心;期望在 tex16-probes.tsv.
 *
 * sh ./unisacc.com tools/check-uxe-tex16.cx --
 */
static int failed;
static void ck(int ok, const char *lab) {
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", lab);
    if (!ok) failed++;
}
int main(void) {
    char cwd[512], url[640];
    const char *pre = "file://";
    const char *suf = "/ujs/practice/uxe/test/uxe-tex16.html";
    const char *fin[3];
    int retries = 0, rc, n, i;
    FILE *f = fopen("ujs/practice/uxe/test/tex16-probes.tsv", "rb");
    if (!f) { printf("FAIL\tno-probes-tsv\n"); return 1; }
    fclose(f);
    if (!getcwd(cwd, sizeof cwd)) return 2;
    n = 0;
    while (pre[n]) { url[n] = pre[n]; n++; }
    for (i = 0; cwd[i] && n < 500; i++) url[n++] = cwd[i];
    for (i = 0; suf[i] && n < 630; i++) url[n++] = suf[i];
    url[n] = 0;
    fin[0] = "TEX16_OK";
    fin[1] = "TEX16_FAIL";
    fin[2] = "TEX16_ERR";
    rc = chd_dump_expect("/usr/bin/google-chrome", url, "TEX16_OK", fin, 3, "uxe-tex16", 3, 25, &retries);
    if (rc == 3) { printf("TEX16_UNMEASURED\tno-chrome\n"); return 2; }
    ck(rc == 0, "tex16-probes");
    printf("CHECK_UXE_TEX16\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
