/* tools/check-piece-m-m25-bounds.cx -- thin registered entry for piece-m-m25-bounds
 * (delegates to tools/check-piece-m-m25.cx -- --part=bounds).
 * Marker: CHECK_PIECE_M_M25. */
#pragma unisa use sys.io
#pragma unisa use cxlib.procrun

int main(void) {
    char *av[] = {"sh", "./unisacc.com", "tools/check-piece-m-m25.cx", "--", "--part=bounds", 0}; /* lint:allow R1-product */
    pr_result r;
    int t = pr_run("piece-m-bd", av, ".", 0, 50, &r);
    if (r.out && r.outn > 0) sy_printf("%.*s", (int)r.outn, (const char *)r.out);
    if (r.err && r.errn > 0) sy_eprintf("%.*s", (int)r.errn, (const char *)r.err);
    int rc = t ? 1 : r.rc;
    pr_free(&r);
    return rc;
}
