#pragma unisa use cxlib.toolselfpath
#pragma unisa use sys.hostid
/* Incremental local macOS sentinel preparation. No test verdict is inferred from preparation. */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.time
#pragma unisa use sys.fs
#pragma unisa use mem.bytes
static char root[4096],state[4096],lockpath[4400],logs[4400],why[1000];static long endtime;static int held,seq,lockfd=-1,fetching;
static void done(int rc){if(held&&close(lockfd)){fprintf(stderr,"osx-sentinel: unlock failed errno=%d\n",errno);exit(2);}exit(rc);}
static void die(const char*s){fprintf(stderr,"osx-sentinel: REFUSE %s errno=%d\n",s,errno);done(2);} /* lint:allow R3-die done() releases the lock then exits on every path */
static void path(char*p,size_t cap,const char*a,const char*b){if(cx_fmt(p,cap,"%s/%s",a,b))die("path bound");}
static int hex(const char*s,int n){if(!s||strlen(s)!=(size_t)n)return 0;for(int i=0;i<n;i++)if(!((s[i]>='0'&&s[i]<='9')||(s[i]>='a'&&s[i]<='f')))return 0;return 1;}
static char *readreg(const char*p,size_t*n,long limit){struct stat st;errno=0;if(lstat(p,&st))die(errno==ENOENT?"missing regular input":"input stat");if(!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>limit)die("bounded regular input");char*s=cx_read(p,n);if(!s)die("read input");return s;}
static void digest(const char*p,char h[65]){size_t n;char*s=readreg(p,&n,134217728);cx_sha256_hex(s,n,h);free(s);}
static void put(const char*p,const void*b,size_t n,int atomic){char tmp[4500];if(cx_fmt(tmp,sizeof tmp,"%s.next.%d",p,(int)getpid()))die("atomic path");const char*dst=atomic?tmp:p;int fd=open(dst,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive write");int bad=sy_write_all(fd,b,(long)n),closed=close(fd);if(bad||closed)die("write");if(atomic&&rename(tmp,p))die("atomic publish");}
static void copy(const char*a,const char*b){size_t n;char*s=readreg(a,&n,134217728);put(b,s,n,0);free(s);}
static np_result call(char**av);static void progress(const char*,const char*);static int missing(const char*);static long number(const char*,long);
static char inputsha[65],lanehash[65],lanesourcehash[65],selfhash[65],selfpath[4096];static char *commandenv[8];static char envcontainer[4500];static int commandcap=45;
static int value(const char*b,const char*key,char*dst,size_t cap){int found=0;size_t kn=strlen(key);for(const char*p=b;*p;){const char*e=strchr(p,'\n');if(!e)return 0;if((size_t)(e-p)>kn&&p[kn]=='\t'&&!memcmp(p,key,kn)){size_t z=(size_t)(e-p)-kn-1;if(found||z>=cap)return 0;for(size_t i=0;i<z;i++)dst[i]=p[kn+1+i];dst[z]=0;found=1;}p=e+1;}return found;}
static unsigned long self_word(const unsigned char*p){return (unsigned long)p[0]|((unsigned long)p[1]<<8)|((unsigned long)p[2]<<16)|((unsigned long)p[3]<<24);}
static void native_self(void){char reported[4096];if(ts_self_path(reported,sizeof reported)<1||!realpath(reported,selfpath))die("actual native process image unavailable");const char*host=tn_self();if(!host||strncmp(host,"osx/",4))die("sentinel requires native macOS controller");size_t n;char*b=readreg(selfpath,&n,134217728);unsigned long cpu=!strcmp(host,"osx/arm64")?0x100000cUL:!strcmp(host,"osx/x86_64")?0x1000007UL:0;if(n<32||!cpu||self_word((unsigned char*)b)!=0xfeedfacfUL||self_word((unsigned char*)b+4)!=cpu||self_word((unsigned char*)b+12)!=2||access(selfpath,X_OK))die("controller must be actual host CPU MH_EXECUTE");cx_sha256_hex(b,n,selfhash);free(b);}
static void check_inputs(void){char p[4400],a[4400],b[4400],wantroot[4096],boot[65],models[65],h[65];path(p,sizeof p,state,"config.tsv");size_t n;char*c=readreg(p,&n,16384);cx_sha256_hex(c,n,inputsha);if(strncmp(c,"OSX_SENTINEL_CONFIG1\n",21)||!value(c,"root",wantroot,sizeof wantroot)||strcmp(wantroot,root)||!value(c,"bootstrap_sha",boot,sizeof boot)||!value(c,"models_sha",models,sizeof models)||!hex(boot,64)||!hex(models,64))die("config identity");path(a,sizeof a,state,"bootstrap.com");path(b,sizeof b,state,"models.bin");digest(a,h);if(strcmp(h,boot))die("frozen bootstrap/models changed");digest(b,h);if(strcmp(h,models))die("frozen bootstrap/models changed");char controller[65];if(!value(c,"controller_sha",controller,sizeof controller)||strcmp(controller,selfhash))die("controller changed; initialize a new STATE");int have=value(c,"lane_sha",lanehash,sizeof lanehash);if(have){if(!hex(lanehash,64)||!value(c,"lane_source_sha",lanesourcehash,sizeof lanesourcehash)||!hex(lanesourcehash,64))die("lane config identity");path(p,sizeof p,state,"lane-native");digest(p,h);if(strcmp(h,lanehash))die("frozen lane executable changed");path(p,sizeof p,state,"lane-source.cx");digest(p,h);if(strcmp(h,lanesourcehash))die("frozen lane source changed");}else lanehash[0]=0;free(c);if(cx_fmt(envcontainer,sizeof envcontainer,"UNISA_CONTAINER=%s",b))die("container environment");commandenv[0]=envcontainer;commandenv[1]="UNISACC_CTOR=";commandenv[2]="UNISACC_TABLES=";commandenv[3]="UNISACC_RB_WHOLE_MS=55000";commandenv[4]="UNISACC_TIME_SCALE=1";commandenv[5]=0;}
static void window(int seconds){if(endtime-sy_now_ms()<(long)(seconds+1)*1000){puts("OSX_SENTINEL\tstatus=PENDING\treason=insufficient-complete-child-window");done(3);}commandcap=seconds;}
static void typed_map(const char*tree,const char*image,const char*models,char*map,size_t cap){char p[4400];path(p,sizeof p,tree,"tests/batches.tsv");size_t n;char*s=readreg(p,&n,8388608);unsigned needed=0;const char*names[]={"default-tape-dut","default-tape-models","prune-dut","prune-models"};char*row=strchr(s,'\n');if(!row)die("batch metadata header");row++;while(*row){char*end=strchr(row,'\n');if(!end)die("batch metadata tail");*end=0;char*fields[14];int count=0;char*a=row;for(;;){if(count==14)die("batch metadata columns");fields[count++]=a;char*t=strchr(a,'\t');if(!t)break;*t=0;a=t+1;}if(count!=14)die("batch metadata columns");if(!strncmp(fields[5],"osx/",4)||!strcmp(fields[0],"smoke")){char*mat=fields[7];while(*mat&&strcmp(mat,"-")){char*comma=strchr(mat,',');if(comma)*comma=0;for(int k=0;k<4;k++)if(!strcmp(mat,names[k]))needed|=1U<<k;if(!comma)break;mat=comma+1;}}row=end+1;}free(s);np_buf b={0};for(int k=0;k<4;k++)if(needed&(1U<<k)){np_puts(&b,names[k]);np_puts(&b,"\t");np_puts(&b,(k&1)?models:image);np_puts(&b,"\n");}if(b.n>=cap)die("typed MAP bound");if(mm_copy(map,(long)cap,b.p?b.p:"",(long)b.n))die("typed MAP copy");map[b.n]=0;free(b.p);}
static void after_build(const char*rev,const char*tree,const char*work){char p[4400],image[4400],rec[4400],sha[65],want[65],target[100],recordrev[41],bytes[40];path(image,sizeof image,tree,"out/slice/slice-osx-arm64");path(rec,sizeof rec,tree,"out/slice/receipt.txt");size_t n;char*r=readreg(rec,&n,16384);if(!value(r,"sha",want,sizeof want)||!hex(want,64)||!value(r,"target",target,sizeof target)||strcmp(target,"osx/arm64")||!value(r,"rev",recordrev,sizeof recordrev)||strcmp(recordrev,rev)||!value(r,"bytes",bytes,sizeof bytes))die("ARM build receipt identity");struct stat st;if(lstat(image,&st)||!S_ISREG(st.st_mode)||st.st_size<=0)die("ARM build image kind");char actualbytes[40];if(cx_fmt(actualbytes,sizeof actualbytes,"%lld",(long long)st.st_size)||strcmp(bytes,actualbytes))die("ARM receipt bytes");digest(image,sha);if(strcmp(sha,want))die("ARM build image SHA");free(r);char map[9000],models[4400];path(models,sizeof models,state,"models.bin");typed_map(tree,image,models,map,sizeof map);path(p,sizeof p,work,"materials.tsv");if(missing(p))put(p,map,strlen(map),0);else{size_t z;char*s=readreg(p,&z,16384);if(z!=strlen(map)||memcmp(s,map,z))die("MAP changed");free(s);}path(p,sizeof p,work,"build-receipt.sha256");digest(rec,sha);if(missing(p))put(p,sha,64,0);progress(rev,"LANE");}
static void verify_jobs(const char*s,const char*lane,long expected,const char*candidate,int failed){const char*headers[]={"OSX_LANE_QUEUE","status","selected","executed","identity_stable","candidate","source_sid","harness","registry","fail_id"};char ids[2048][128];int count=0,failures=0;for(const char*p=s;*p;){const char*e=strchr(p,'\n'),*tab=strchr(p,'\t');if(!e||!tab||tab>=e)die("receipt row");size_t kn=tab-p;int header=0;for(int k=0;k<10;k++)if(strlen(headers[k])==kn&&!memcmp(p,headers[k],kn))header=1;if(!header){if(count==2048||!kn||kn>=128||e-tab!=65)die("job receipt fields");for(size_t k=0;k<kn;k++){char c=p[k];if(!((c>='a'&&c<='z')||(c>='0'&&c<='9')||c=='-'))die("job ID");ids[count][k]=c;}ids[count][kn]=0;for(int k=0;k<count;k++)if(!strcmp(ids[k],ids[count]))die("duplicate job receipt");char expectedsha[65];for(int k=0;k<64;k++)expectedsha[k]=tab[1+k];expectedsha[64]=0;if(!hex(expectedsha,64))die("job SHA");np_buf b={0};const char*suffix[]={"stdout","stderr","status.tsv","verdict.tsv"};int jobrc=-1;for(int k=0;k<4;k++){char name[200],pathbuf[4400],len[60];if(cx_fmt(name,sizeof name,"job-%s.%s",ids[count],suffix[k]))die("job file name");path(pathbuf,sizeof pathbuf,lane,name);size_t n;char*raw=readreg(pathbuf,&n,67108864);if(k==0){char*mark=strstr(raw,"BATCH_RUN\tid="),id[128],status[20],marker[128],sha[65];int rc,tr;if(!mark||strstr(mark+1,"BATCH_RUN\tid=")||sscanf(mark,"BATCH_RUN\tid=%127s\tstatus=%19s\trc=%d\ttransport=%d\tmarker=%127s\tcandidate=%64s",id,status,&rc,&tr,marker,sha)!=6||strcmp(id,ids[count])||strcmp(sha,candidate)||tr)die("job BATCH identity");if(!strcmp(status,"PASS")&&!rc)jobrc=0;else if(!strcmp(status,"FAIL")&&rc){jobrc=1;failures++;}else die("job BATCH unknown status");}if(k==2){int pid,reaped,tr,rc,residue;long ms;char expectedstatus[600];if(sscanf(raw,"pid\t%d\nreaped\t%d\nelapsed_ms\t%ld\ntransport\t%d\nrc\t%d\nresidue\t%d\n",&pid,&reaped,&ms,&tr,&rc,&residue)!=6||pid<=0||reaped!=1||ms<0||tr||residue||rc!=jobrc||cx_fmt(expectedstatus,sizeof expectedstatus,"pid\t%d\nreaped\t%d\nelapsed_ms\t%ld\ntransport\t%d\nrc\t%d\nresidue\t%d\n",pid,reaped,ms,tr,rc,residue)||strlen(expectedstatus)!=n||memcmp(raw,expectedstatus,n))die("job actual waitpid status UNKNOWN");}if(k==3){char expectedverdict[300];if(cx_fmt(expectedverdict,sizeof expectedverdict,"%s\t%s\t%d\t0\t0\t",ids[count],jobrc?"FAIL":"LOCAL_PASS",jobrc)||strncmp(raw,expectedverdict,strlen(expectedverdict)))die("job verdict does not match actual status");}if(cx_fmt(len,sizeof len,"%zu:",n))die("job frame");np_puts(&b,name);np_puts(&b,"\n");np_puts(&b,len);np_put(&b,raw,n);free(raw);}char h[65];cx_sha256_hex(b.p,b.n,h);free(b.p);if(strcmp(h,expectedsha))die("job evidence content SHA mismatch");count++;}p=e+1;}if(count!=expected||(!failed&&failures)||(failed&&!failures))die("job receipts incomplete or FAIL mismatch");}
static void dispatch_lane(const char*rev,const char*tree,const char*work){char driver[4400],lane[4400],map[4400],p[4400],stdoutpath[4400],stderrpath[4400],wire[15000];path(driver,sizeof driver,state,"lane-native");path(lane,sizeof lane,tree,"out/lane-run");path(map,sizeof map,work,"materials.tsv");path(p,sizeof p,work,"lane-sequence");long serial=0;if(!missing(p)){size_t n;char*b=readreg(p,&n,30);char*end;serial=strtol(b,&end,10);if(*end!='\n'||end[1]||serial<1||serial>100000)die("lane sequence");free(b);}serial++;char number[40];if(cx_fmt(number,sizeof number,"%ld\n",serial))die("lane sequence format");put(p,number,strlen(number),1);if(cx_fmt(stdoutpath,sizeof stdoutpath,"%s/lane-%ld.stdout",work,serial)||cx_fmt(stderrpath,sizeof stderrpath,"%s/lane-%ld.stderr",work,serial))die("lane transcript paths");int fo=open(stdoutpath,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600),fe=open(stderrpath,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fo<0||fe<0)die("lane exclusive transcript");if(cx_fmt(wire,sizeof wire,"OSX_SENTINEL_HANDOFF1\nrevision\t%s\nlane_sha\t%s\nstdout\t%s\nstderr\t%s\npid\t%d\nexit_status\tUNOBSERVED_EXEC_HANDOFF\n",rev,lanehash,stdoutpath,stderrpath,(int)getpid()))die("lane handoff receipt");path(p,sizeof p,work,"lane-handoff.tsv");put(p,wire,strlen(wire),1);progress(rev,"LANE_COLLECT");fflush(stdout);size_t n=0;while(environ[n])n++;char**env=calloc(n+8,sizeof *env);if(!env)die("lane environment");size_t z=0;for(size_t k=0;k<n;k++){int keep=1;for(int j=0;commandenv[j];j++){size_t len=strcspn(commandenv[j],"=");if(!strncmp(environ[k],commandenv[j],len)&&environ[k][len]=='=')keep=0;}if(keep)env[z++]=environ[k];}for(int j=0;commandenv[j];j++)env[z++]=commandenv[j];env[z]=0;environ=env;int flags=fcntl(lockfd,F_GETFD);if(flags<0||fcntl(lockfd,F_SETFD,flags&~FD_CLOEXEC)||dup2(fo,1)<0||dup2(fe,2)<0||close(fo)||close(fe))die("lane exec handoff fds");char *v[]={driver,"--step",(char*)tree,lane,map,0};execv(driver,v);die("lane exec failed; no final status inferred");}
static void setturn(const char*);static void assessed(const char*,int);
static long number(const char*s,long max){if(!s||!*s)return -1;long v=0;for(size_t i=0;s[i];i++){if(s[i]<'0'||s[i]>'9'||v>(max-(s[i]-'0'))/10)return -1;v=v*10+s[i]-'0';}return v;}
static void runpaths(const char*rev,char*work,char*tree){char p[4400];path(p,sizeof p,state,"runs");path(work,4400,p,rev);path(tree,4400,work,"snapshot");}
static char* loadresult(const char*rev,int expected){char w[4400],t[4400],p[4400],want[65],status[20];runpaths(rev,w,t);path(p,sizeof p,w,"result.tsv");size_t n;char*s=readreg(p,&n,16384);if(!value(s,"generation",want,sizeof want)||strcmp(want,inputsha)||!value(s,"status",status,sizeof status)||strcmp(status,expected?"RED":"GREEN"))die("no same-generation proven result");return s;}
static void save_result(const char*rev,int failed,const char*candidate,const char*sid,const char*harness,const char*registry,const char*receiptsha,const char*queuesha){char w[4400],t[4400],p[4400],row[1300];runpaths(rev,w,t);if(cx_fmt(row,sizeof row,"OSX_SENTINEL_RESULT1\nrevision\t%s\ngeneration\t%s\nstatus\t%s\ncandidate\t%s\nsource_sid\t%s\nharness\t%s\nregistry\t%s\nreceipt_sha\t%s\nqueue_sha\t%s\nscope\tSOURCE-DRIVER-ONLY\n",rev,inputsha,failed?"RED":"GREEN",candidate,sid,harness,registry,receiptsha,queuesha))die("assessment bounds");path(p,sizeof p,w,"result.tsv");if(!missing(p)){size_t n;char*s=readreg(p,&n,16384);if(n!=strlen(row)||memcmp(s,row,n))die("assessment changed across revalidation");free(s);}else put(p,row,strlen(row),0);}
static void append_table(const char*name,const char*id,const char*row,const char*needle){char p[4400];path(p,sizeof p,root,name);int fd=open(p,O_RDWR|O_APPEND|O_NOFOLLOW|O_CLOEXEC);if(fd<0)die("required existing root table");struct flock lk={0};lk.l_type=F_WRLCK;lk.l_whence=SEEK_SET;struct stat st;if(fstat(fd,&st)||!S_ISREG(st.st_mode)||fcntl(fd,F_SETLK,&lk))die("root table lock");size_t n;char*s=readreg(p,&n,8388608);if(!n||s[n-1]!='\n')die("root table incomplete tail");const char*required=!strcmp(name,"agentwork/ledger.tsv")?"时间\tid\t事件\tcommit\t证据\t角色/模型\n":"id\tgoal\trole\tdomain\tgate\tcontext\tbudget_min\tdeps\tstate\towner\tcheck\n";if(strncmp(s,required,strlen(required)))die("root table schema");int ledger=!strcmp(name,"agentwork/ledger.tsv"),seen=0;for(char*a=strchr(s,'\n');a&&a[1];){a++;char*e=strchr(a,'\n');if(!e)die("table tail");char*key=a;if(ledger){key=strchr(a,'\t');if(!key||key>=e)die("ledger columns");key++;}char*end=strchr(key,'\t');if(!end||end>=e)die("table key");if((size_t)(end-key)==strlen(id)&&!memcmp(key,id,strlen(id))){seen++;*e=0;if(!strstr(a,needle)||(!ledger&&((size_t)(e-a)!=strlen(row)-1||memcmp(a,row,e-a))))die("same table key conflicts with current evidence");*e='\n';}a=e;}free(s);if(seen>1)die("duplicate table key");if(!seen){ssize_t z=write(fd,row,strlen(row));if(z!=(ssize_t)strlen(row)||fsync(fd))die("single exact table append");}if(close(fd))die("table close");}
static void complete_revision(const char*rev,const char*status){char w[4400],t[4400],p[4400],h[65],row[500];runpaths(rev,w,t);path(p,sizeof p,w,"result.tsv");if(!missing(p))digest(p,h);else cx_sha256_hex(status,strlen(status),h);if(cx_fmt(row,sizeof row,"OSX_SENTINEL_COMPLETE1\nrevision\t%s\nstatus\t%s\ngeneration\t%s\nresult_sha\t%s\n",rev,status,inputsha,h))die("complete bound");path(p,sizeof p,w,"complete.tsv");put(p,row,strlen(row),1);progress(rev,"IDLE");}
static void green_ledger(const char*rev){char*s=loadresult(rev,0),candidate[65],receipt[65];if(!value(s,"candidate",candidate,sizeof candidate)||!value(s,"receipt_sha",receipt,sizeof receipt))die("green evidence");free(s);char id[150],line[3000],needle[300],date[40];if(sy_local_fmt(date,sizeof date,"%Y-%m-%d",sy_wall_s())<0||cx_fmt(id,sizeof id,"OSX-SENTINEL-%s-%.16s",rev,inputsha)||cx_fmt(needle,sizeof needle,"generation=%s receipt=%s",inputsha,receipt)||cx_fmt(line,sizeof line,"%s\t%s\tLOCAL_PASS\t%s\t%s candidate=%s scope=SOURCE-DRIVER-ONLY evidence=%s/runs/%s/result.tsv\tosx-sentinel\n",date,id,rev,needle,candidate,state,rev))die("green ledger row");append_table("agentwork/ledger.tsv",id,line,needle);char p[4400],row[400];path(p,sizeof p,state,"lastgood.tsv");if(cx_fmt(row,sizeof row,"revision\t%s\ngeneration\t%s\n",rev,inputsha))die("lastgood bound");put(p,row,strlen(row),1);complete_revision(rev,"GREEN");}
static void bisect_save(const char*good,const char*bad,const char*head,const char*phase,const char*mid){char p[4400],row[700];path(p,sizeof p,state,"bisect.tsv");if(cx_fmt(row,sizeof row,"OSX_SENTINEL_BISECT1\ngeneration\t%s\ngood\t%s\nbad\t%s\nhead\t%s\nphase\t%s\nmid\t%s\n",inputsha,good,bad,head,phase,mid?mid:"-"))die("bisect state bounds");put(p,row,strlen(row),1);}
static char*bisect_load(char*good,char*bad,char*head,char*phase,char*mid){char p[4400],gen[65];path(p,sizeof p,state,"bisect.tsv");size_t n;char*s=readreg(p,&n,2000);if(!value(s,"generation",gen,sizeof gen)||strcmp(gen,inputsha)||!value(s,"good",good,41)||!hex(good,40)||!value(s,"bad",bad,41)||!hex(bad,40)||!value(s,"head",head,41)||!hex(head,40)||!value(s,"phase",phase,40)||!value(s,"mid",mid,41))die("bisect generation or schema");return s;}
static void comparable(const char*good,const char*bad){char *g=loadresult(good,0),*b=loadresult(bad,1),gh[65],bh[65];if(!value(g,"harness",gh,sizeof gh)||!value(b,"harness",bh,sizeof bh)||strcmp(gh,bh))die("NOT_COMPARABLE harness changed");if(!value(g,"registry",gh,sizeof gh)||!value(b,"registry",bh,sizeof bh)||strcmp(gh,bh))die("NOT_COMPARABLE registry changed");free(g);free(b);char gw[4400],gt[4400],bw[4400],bt[4400],p[4400];runpaths(good,gw,gt);runpaths(bad,bw,bt);path(p,sizeof p,gt,"out/lane-run/selection.tsv");size_t gn,bn;char*gs=readreg(p,&gn,1048576);path(p,sizeof p,bt,"out/lane-run/selection.tsv");char*bs=readreg(p,&bn,1048576);if(gn!=bn||memcmp(gs,bs,gn))die("NOT_COMPARABLE dynamic selected batch set");free(gs);free(bs);char *anc[]={"git","-C",root,"merge-base","--is-ancestor",(char*)good,(char*)bad,0};np_result r=call(anc);int rc=r.rc;np_free(&r);if(rc)die("REBASELINE ancestor proof absent");char *models[]={"git","-C",root,"diff","--quiet",(char*)good,(char*)bad,"--","seed","exec","kernel",0};r=call(models);rc=r.rc;np_free(&r);if(rc)die("NOT_COMPARABLE frozen model inputs changed");}
static void start_red(const char*rev){char p[4400],good[41],gen[65];path(p,sizeof p,state,"lastgood.tsv");if(missing(p)){complete_revision(rev,"BASELINE-RED");return;}size_t n;char*s=readreg(p,&n,1000);if(!value(s,"revision",good,sizeof good)||!hex(good,40)||!value(s,"generation",gen,sizeof gen)||strcmp(gen,inputsha)||!strcmp(good,rev))die("no qualified same-material green base");free(s);char*r=loadresult(good,0);free(r);bisect_save(good,rev,rev,"VERIFY_GOOD",0);progress(good,"REVALIDATE");}
static void assessed(const char*rev,int failed){char p[4400];path(p,sizeof p,state,"bisect.tsv");if(missing(p)){progress(rev,failed?"RED_PENDING_BASELINE":"GREEN_PENDING_LEDGER");done(failed?1:3);}char good[41],bad[41],head[41],phase[40],mid[41];char*s=bisect_load(good,bad,head,phase,mid);free(s);if(!strcmp(phase,"VERIFY_GOOD")){if(strcmp(rev,good)||failed)die("base not genuinely green on revalidation");bisect_save(good,bad,head,"VERIFY_BAD",0);progress(bad,"REVALIDATE");}else if(!strcmp(phase,"VERIFY_BAD")){if(strcmp(rev,bad)||!failed)die("head not genuinely red on revalidation");comparable(good,bad);bisect_save(good,bad,head,"PICK",0);progress(bad,"BISECT_PICK");}else if(!strcmp(phase,"EVALUATE")){if(strcmp(rev,mid))die("bisect midpoint identity");if(failed){if(cx_fmt(bad,sizeof bad,"%s",mid))die("bad bound");}else{if(cx_fmt(good,sizeof good,"%s",mid))die("good bound");}bisect_save(good,bad,head,"PICK",0);progress(bad,"BISECT_PICK");}else die("unexpected bisect assessment phase");done(3);}
static int declared(const char*csv,const char*name){size_t n=strlen(name);for(const char*p=csv;*p;){const char*e=strchr(p,',');if(!e)e=p+strlen(p);const char*t=memchr(p,':',e-p);const char*end=t?t:e;if((size_t)(end-p)==n&&!memcmp(p,name,n))return 1;if(!*e)break;p=e+1;}return 0;}
static void failed_materials(const char*tree,const char*id,char*csv,size_t cap){char p[4400];path(p,sizeof p,tree,"tests/batches.tsv");size_t n;char*s=readreg(p,&n,8388608);char*row=strchr(s,'\n');if(!row)die("failure metadata header");row++;int found=0;while(*row){char*end=strchr(row,'\n');if(!end)die("failure metadata tail");*end=0;char*fields[14];int count=0;char*a=row;for(;;){if(count==14)die("failure metadata columns");fields[count++]=a;char*t=strchr(a,'\t');if(!t)break;*t=0;a=t+1;}if(count!=14)die("failure metadata columns");if(!strcmp(fields[0],id)){if(found++||cx_fmt(csv,cap,"%s",fields[7]))die("failure metadata identity");}row=end+1;}free(s);if(found!=1)die("failure batch not in frozen registry");}
static void first_bad(const char*bad,const char*head){char w[4400],tree[4400],p[4400],fail[128];runpaths(bad,w,tree);path(p,sizeof p,tree,"out/lane-run/queue-result.tsv");size_t n;char*s=readreg(p,&n,1048576);if(!value(s,"fail_id",fail,sizeof fail)||!fail[0]||strpbrk(fail,"\t\r\n /"))die("first bad lacks exact failure batch");free(s);char needed[2000];failed_materials(tree,fail,needed,sizeof needed);np_buf args={0};const char*fixed[]={"tools/bound","55","sh","unisacc.com","tests/run-batch.cx","--"};for(int i=0;i<6;i++){if(i==0||i==3||i==4){char a[4400];path(a,sizeof a,tree,fixed[i]);np_puts(&args,a);}else np_puts(&args,fixed[i]);np_puts(&args,"\n");}np_puts(&args,tree);np_puts(&args,"\n");path(p,sizeof p,tree,"out/reproduce");np_puts(&args,p);np_puts(&args,"\n");np_puts(&args,fail);np_puts(&args,"\n");path(p,sizeof p,w,"materials.tsv");char*m=readreg(p,&n,32768);for(char*a=m;*a;){char*e=strchr(a,'\n'),*t=strchr(a,'\t');if(!e||!t||t>=e)die("repro MAP");*t=0;if(declared(needed,a)){*t='=';np_put(&args,a,e-a);np_puts(&args,"\n");}a=e+1;}free(m);path(p,sizeof p,w,"firstbad-argv.tsv");if(missing(p))put(p,args.p,args.n,0);free(args.p);char id[80],line[13000],needle[300];const char*owner=strstr(fail,"lnx")?"lnx-material":"osx";if(cx_fmt(id,sizeof id,"OSX-REGRESS-%s",bad)||cx_fmt(needle,sizeof needle,"generation=%s",inputsha)||cx_fmt(line,sizeof line,"%s\t同材料首坏批次%s\timplementer\tosx-source;%s\targv:%s\t%s head=%s logs=%s/out/lane-run/job-%s.stdout mkdir-repro-parent-required\t60\t-\tREADY\t%s\tSOURCE-DRIVER-ONLY;实际稳定FAIL及祖先区间证明\n",id,fail,owner,p,needle,head,tree,fail,owner))die("firstbad item row");append_table("agentwork/items.tsv",id,line,needle);char bf[4400];path(bf,sizeof bf,state,"bisect.tsv");char archived[4400];if(cx_fmt(archived,sizeof archived,"%s/bisect-complete-%s.tsv",state,bad)||rename(bf,archived))die("archive bisect");complete_revision(head,"FIRST_BAD_REPORTED");}
static void bisect_pick(void){char good[41],bad[41],head[41],phase[40],mid[41];char*s=bisect_load(good,bad,head,phase,mid);free(s);if(strcmp(phase,"PICK"))die("bisect pick phase");comparable(good,bad);char range[90];if(cx_fmt(range,sizeof range,"%s..%s",good,bad))die("range");char *list[]={"git","-C",root,"rev-list",range,0};np_result r=call(list);int count=0;for(size_t i=0;i<r.outn;i++)if(r.out[i]=='\n')count++;if(count<1||r.outn!=(size_t)count*41)die("ancestry interval shape");np_free(&r);if(count==1){first_bad(bad,head);return;}char*pick[]={"git","-C",root,"rev-list","--bisect",range,0};r=call(pick);if(r.rc||r.outn!=41||r.out[40]!='\n')die("bisect midpoint");r.out[40]=0;if(!hex(r.out,40)||!strcmp(r.out,good)||!strcmp(r.out,bad)||cx_fmt(mid,sizeof mid,"%s",r.out))die("nonprogressing midpoint");np_free(&r);char w[4400],t[4400],p[4400];runpaths(mid,w,t);path(p,sizeof p,w,"result.tsv");if(!missing(p))die("midpoint already assessed; explicit reuse requires revalidation");bisect_save(good,bad,head,"EVALUATE",mid);progress(mid,"DETECTED");}
static int choose_queued(char chosen[41]){char p[4400];path(p,sizeof p,state,"queue.tsv");size_t n;char*s=readreg(p,&n,8192);if(n%41)die("queued revisions wire");for(size_t i=0;i<n;i+=41){char rev[41];for(int k=0;k<40;k++)rev[k]=s[i+k];rev[40]=0;if(s[i+40]!='\n'||!hex(rev,40))die("queue commit");char w[4400],t[4400];runpaths(rev,w,t);path(p,sizeof p,w,"complete.tsv");if(missing(p)){if(cx_fmt(chosen,41,"%s",rev))die("queue choice");free(s);return 1;}size_t z;char*c=readreg(p,&z,2000),gen[65],want[65],actual[65],status[40];if(!value(c,"generation",gen,sizeof gen)||strcmp(gen,inputsha)||!value(c,"result_sha",want,sizeof want)||!value(c,"status",status,sizeof status))die("completed generation receipt");free(c);path(p,sizeof p,w,"result.tsv");if(!missing(p)){digest(p,actual);if(strcmp(actual,want))die("completed assessment changed");}else{cx_sha256_hex(status,strlen(status),actual);if(strcmp(actual,want))die("completed fallback receipt");}}free(s);return 0;}
static void lane_step(const char*rev,const char*tree,const char*work){char driver[4400],lane[4400],map[4400],receipt[4400],installed[4400],h[65];path(driver,sizeof driver,state,"lane-native");path(lane,sizeof lane,tree,"out/lane-run");path(map,sizeof map,work,"materials.tsv");path(receipt,sizeof receipt,work,"lane-handoff.tsv");size_t hn;char*handoff=readreg(receipt,&hn,16384);char observedrev[41],observeddriver[65],op[4400],ep[4400];if(!value(handoff,"revision",observedrev,sizeof observedrev)||strcmp(observedrev,rev)||!value(handoff,"lane_sha",observeddriver,sizeof observeddriver)||strcmp(observeddriver,lanehash)||!value(handoff,"stdout",op,sizeof op)||!value(handoff,"stderr",ep,sizeof ep))die("handoff identity");free(handoff);np_result r={0};r.out=readreg(op,&r.outn,67108864);r.err=readreg(ep,&r.errn,67108864);if(strstr(r.out,"OSX_LANE_STEP\tstatus=PENDING\t"))r.rc=3;else if(strstr(r.out,"OSX_LANE_STEP\tstatus=LOCAL_PASS\t"))r.rc=0;else if(strstr(r.out,"OSX_LANE_STEP\tstatus=FAIL\t"))r.rc=1;else r.rc=2;char*marker=r.out?strstr(r.out,"OSX_LANE_STEP\tstatus="):0;if(!marker||strstr(marker+1,"OSX_LANE_STEP\tstatus="))die("unique lane step marker");int rc=r.rc;if(rc==3){if(strncmp(marker,"OSX_LANE_STEP\tstatus=PENDING\t",29))die("lane pending marker");np_free(&r);progress(rev,"LANE");done(3);}if(rc!=0&&rc!=1){np_free(&r);puts("OSX_SENTINEL\tstatus=UNKNOWN\treason=lane-refused");done(2);}const char*expected=rc?"OSX_LANE_STEP\tstatus=FAIL\t":"OSX_LANE_STEP\tstatus=LOCAL_PASS\t";if(strncmp(marker,expected,strlen(expected)))die("lane status/exit mismatch");np_free(&r);char *verify[]={driver,"--verify-queue",(char*)tree,lane,map,0};window(45);np_result vr=call(verify);char *vm=vr.out?strstr(vr.out,"OSX_LANE_QUEUE_VERIFY\tstatus="):0;const char *vs=rc?"OSX_LANE_QUEUE_VERIFY\tstatus=FAIL\t":"OSX_LANE_QUEUE_VERIFY\tstatus=LOCAL_PASS\t";if(vr.rc!=rc||!vm||strstr(vm+1,"OSX_LANE_QUEUE_VERIFY\tstatus=")||strncmp(vm,vs,strlen(vs)))die("independent queue verifier UNKNOWN or mismatch");char verified_receipt[65],verified_candidate[65],verified_sid[65],verified_registry[65],verified_harness[65];int verified_selected,verified_executed;if(sscanf(vm,"OSX_LANE_QUEUE_VERIFY\tstatus=%*s\treceipt_sha=%64s\tcandidate=%64s\tsource_sid=%64s\tregistry=%64s\tharness=%64s\tselected=%d\texecuted=%d",verified_receipt,verified_candidate,verified_sid,verified_registry,verified_harness,&verified_selected,&verified_executed)!=7)die("verifier identity schema");np_free(&vr);path(receipt,sizeof receipt,lane,"queue.state");size_t qn;char*qraw=readreg(receipt,&qn,33554432);char queuesha[65],bodysha[65];if(qn<66||qraw[64]!='\n')die("queue state wire");cx_sha256_hex(qraw+65,qn-65,bodysha);if(memcmp(qraw,bodysha,64))die("queue state hash mismatch");cx_sha256_hex(qraw,qn,queuesha);free(qraw);path(receipt,sizeof receipt,lane,"queue-result.tsv");size_t n;char*s=readreg(receipt,&n,1048576);char status[40],selected[30],executed[30],stable[5],candidate[65],sid[65],harness[65],registry[65];if(strncmp(s,"OSX_LANE_QUEUE\t1\n",17)||!value(s,"status",status,sizeof status)||strcmp(status,rc?"FAIL":"LOCAL_PASS")||!value(s,"selected",selected,sizeof selected)||!value(s,"executed",executed,sizeof executed)||!value(s,"identity_stable",stable,sizeof stable)||strcmp(stable,"1")||!value(s,"candidate",candidate,sizeof candidate)||!hex(candidate,64)||!value(s,"source_sid",sid,sizeof sid)||!hex(sid,64)||!value(s,"harness",harness,sizeof harness)||!hex(harness,64)||!value(s,"registry",registry,sizeof registry)||!hex(registry,64))die("lane final receipt schema");long count=number(selected,2048),donecount=number(executed,2048);if(count<1||count>2048||donecount<1||donecount>count||(!rc&&strcmp(selected,executed)))die("lane incomplete final receipt");path(installed,sizeof installed,tree,"unisacc.com");digest(installed,h);if(strcmp(h,candidate))die("lane candidate binding");digest(receipt,h);if(strcmp(h,verified_receipt)||strcmp(candidate,verified_candidate)||strcmp(sid,verified_sid)||strcmp(registry,verified_registry)||strcmp(harness,verified_harness)||count!=verified_selected||donecount!=verified_executed)die("verifier differs from original receipt");char failid[128];if(rc&&!value(s,"fail_id",failid,sizeof failid))die("lane FAIL lacks batch identity");verify_jobs(s,lane,donecount,candidate,rc);free(s);digest(receipt,h);path(receipt,sizeof receipt,work,"lane-receipt.sha256");if(missing(receipt))put(receipt,h,64,0);else{size_t z;char*b=readreg(receipt,&z,64);if(z!=64||memcmp(b,h,64))die("terminal receipt changed");free(b);}save_result(rev,rc,candidate,sid,harness,registry,h,queuesha);assessed(rev,rc);done(2);}
static np_result call(char**av){long left=endtime-sy_now_ms();int seconds=(int)(left/1000);if(seconds>commandcap)seconds=commandcap;if(seconds<1)die("tick deadline before complete command");np_result r={0};long began=sy_now_ms();int tr=np_run(av,root,commandenv,seconds,&r,why,sizeof why);char p[4500],leaf[120],h[65],oh[65],eh[65],row[1800];cx_sha256_hex(r.out?r.out:"",r.outn,oh);cx_sha256_hex(r.err?r.err:"",r.errn,eh);if(cx_fmt(leaf,sizeof leaf,"%d-%d.stdout",(int)getpid(),seq))die("log name");path(p,sizeof p,logs,leaf);put(p,r.out?r.out:"",r.outn,0);if(cx_fmt(leaf,sizeof leaf,"%d-%d.stderr",(int)getpid(),seq))die("log name");path(p,sizeof p,logs,leaf);put(p,r.err?r.err:"",r.errn,0);np_buf args={0};for(int i=0;av[i];i++){np_puts(&args,av[i]);np_puts(&args,"\n");}cx_sha256_hex(args.p,args.n,h);if(cx_fmt(leaf,sizeof leaf,"%d-%d.argv",(int)getpid(),seq))die("log name");path(p,sizeof p,logs,leaf);put(p,args.p,args.n,0);free(args.p);if(cx_fmt(row,sizeof row,"transport\t%d\nrc\t%d\nresidue\t%d\nelapsed_ms\t%ld\nargv_sha256\t%s\nstdout_sha256\t%s\nstderr_sha256\t%s\ngeneration\t%s\nreason\t%s\n",tr,r.rc,r.residue,sy_now_ms()-began,h,oh,eh,inputsha,tr?why:"-"))die("status bound");if(cx_fmt(leaf,sizeof leaf,"%d-%d.status.tsv",(int)getpid(),seq++))die("log name");path(p,sizeof p,logs,leaf);put(p,row,strlen(row),0);if(tr||r.residue){np_free(&r);die("command failed; unchanged phase; logs retained");}return r;}
static void run(char**v){np_result r=call(v);int rc=r.rc;np_free(&r);if(rc)die("command nonzero; unchanged phase");}
static int missing(const char*p){struct stat st;errno=0;if(!lstat(p,&st))return 0;if(errno!=ENOENT)die("existence IO");return 1;}
static char *field(char*b,const char*name){size_t n=strlen(name);char*p=b;while(p&&*p){if(!strncmp(p,name,n)&&p[n]=='\t'){char*q=strchr(p+n+1,'\n');if(!q)die("config tail");*q=0;return p+n+1;}p=strchr(p,'\n');if(p)p++;}die("config field");return 0;}
static void setturn(const char*s){char p[4400];path(p,sizeof p,state,"turn");put(p,s,strlen(s),1);}
static void progress(const char*rev,const char*phase){setturn(fetching?"WORK\n":"FETCH\n");char p[4400],row[500];path(p,sizeof p,state,"active.tsv");if(cx_fmt(row,sizeof row,"OSX_SENTINEL1\nrevision\t%s\nphase\t%s\n",rev,phase))die("state bound");put(p,row,strlen(row),1);if(strcmp(phase,"IDLE"))printf("OSX_SENTINEL\trevision=%s\tphase=%s\tstatus=PENDING\tqualification=NOT_EXECUTED\n",rev,phase);}
int main(int argc,char**argv){if(argc<4||((strcmp(argv[1],"init")||(argc!=6&&argc!=8))&&(strcmp(argv[1],"tick")||argc!=4))){fputs("usage: osx-sentinel init ROOT NEW_STATE BOOTSTRAP MODELS [LANE_NATIVE LANE_SOURCE] | tick ROOT STATE\n",stderr);return 2;}if(argv[2][0]!='/'||!realpath(argv[2],root)||strcmp(root,argv[2])||strpbrk(root,"\t\r\n"))die("canonical ROOT");native_self();endtime=sy_now_ms()+59000;int init=!strcmp(argv[1],"init");if(argv[3][0]!='/'||strlen(argv[3])>=sizeof state||strpbrk(argv[3],"\t\r\n"))die("absolute STATE");if(init&&mkdir(argv[3],0700))die("new STATE");if(!realpath(argv[3],state)||strcmp(state,argv[3]))die("canonical STATE");path(lockpath,sizeof lockpath,state,"lock");lockfd=open(lockpath,O_RDWR|O_CREAT|O_NOFOLLOW|O_CLOEXEC,0600);struct flock lk={0};lk.l_type=F_WRLCK;lk.l_whence=SEEK_SET;if(lockfd<0||fcntl(lockfd,F_SETLK,&lk))die("STATE lock busy or lock IO");held=1;path(logs,sizeof logs,state,"logs");char p[4400],a[4400],b[4400],boot[65],models[65];if(init){if(mkdir(logs,0700))die("logs directory");path(p,sizeof p,state,"runs");if(mkdir(p,0700))die("runs directory");path(a,sizeof a,state,"bootstrap.com");path(b,sizeof b,state,"models.bin");copy(argv[4],a);copy(argv[5],b);digest(a,boot);digest(b,models);char row[9000];if(argc==8){path(p,sizeof p,state,"lane-native");copy(argv[6],p);if(chmod(p,0700))die("lane executable mode");digest(p,lanehash);path(p,sizeof p,state,"lane-source.cx");copy(argv[7],p);digest(p,lanesourcehash);if(cx_fmt(row,sizeof row,"OSX_SENTINEL_CONFIG1\nroot\t%s\nbootstrap_sha\t%s\nmodels_sha\t%s\ncontroller_sha\t%s\nlane_sha\t%s\nlane_source_sha\t%s\n",root,boot,models,selfhash,lanehash,lanesourcehash))die("lane config bound");}else if(cx_fmt(row,sizeof row,"OSX_SENTINEL_CONFIG1\nroot\t%s\nbootstrap_sha\t%s\nmodels_sha\t%s\ncontroller_sha\t%s\n",root,boot,models,selfhash))die("config bound");path(p,sizeof p,state,"config.tsv");put(p,row,strlen(row),0);setturn("FETCH\n");puts("OSX_SENTINEL\tstatus=PREPARED\tqualification=NOT_EXECUTED");done(0);}check_inputs();path(a,sizeof a,state,"bootstrap.com");path(b,sizeof b,state,"models.bin");digest(a,boot);digest(b,models);path(p,sizeof p,state,"turn");size_t n;char*turn=readreg(p,&n,6);fetching=!strcmp(turn,"FETCH\n");if(!fetching&&strcmp(turn,"WORK\n"))die("turn schema");free(turn);if(!fetching)goto work_phase;commandcap=20;endtime=sy_now_ms()+20000;char *fetch[]={"git","-C",root,"fetch","--no-tags","origin","main",0};run(fetch);char *resolve[]={"git","-C",root,"rev-parse","--verify","refs/remotes/origin/main^{commit}",0};np_result r=call(resolve);if(r.rc||!r.out||r.outn!=41||r.out[40]!='\n')die("remote full revision");r.out[40]=0;char rev[41];if(!hex(r.out,40)||cx_fmt(rev,sizeof rev,"%s",r.out))die("revision");np_free(&r);path(p,sizeof p,state,"queue.tsv");size_t qn=0;char*q=missing(p)?0:readreg(p,&qn,8192);if(qn%41)die("queue shape");int seen=0;for(size_t k=0;k<qn;k+=41){char h[41];for(int j=0;j<40;j++)h[j]=q[k+j];h[40]=0;if(q[k+40]!='\n'||!hex(h,40))die("queue revision");if(!strcmp(h,rev))seen=1;}if(!seen){if(qn>=128*41)die("queue full; no observations dropped");np_buf qb={0};if(q)np_put(&qb,q,qn);np_puts(&qb,rev);np_puts(&qb,"\n");put(p,qb.p,qb.n,1);free(qb.p);if(qn){char old[41];for(int j=0;j<40;j++)old[j]=q[qn-41+j];old[40]=0;char *anc[]={"git","-C",root,"merge-base","--is-ancestor",old,rev,0};np_result ar=call(anc);int ac=ar.rc;np_free(&ar);if(ac){char reason[300];if(cx_fmt(reason,sizeof reason,"OSX_SENTINEL\tstatus=%s\tprevious=%s\tobserved=%s\n",ac==1?"REBASELINE":"UNKNOWN",old,rev))die("rebaseline bound");path(p,sizeof p,state,"rebaseline.tsv");put(p,reason,strlen(reason),1);printf("%s",reason);free(q);done(ac==1?3:2);}}}free(q);path(p,sizeof p,state,"active.tsv");if(missing(p)){progress(rev,"DETECTED");done(3);}size_t an;char*ast=readreg(p,&an,1000);char ap[40];if(!value(ast,"phase",ap,sizeof ap))die("active queue phase");free(ast);if(!strcmp(ap,"IDLE")){char next[41];if(choose_queued(next)){progress(next,"DETECTED");done(3);}setturn("FETCH\n");done(0);}setturn("WORK\n");done(3);work_phase:path(p,sizeof p,state,"active.tsv");char *active=readreg(p,&n,1000),*active2=malloc(n+1);if(!active2||cx_fmt(active2,n+1,"%s",active))die("active copy");char *prior=field(active,"revision"),*phase=field(active2,"phase");if(!hex(prior,40))die("active revision");char frozen[41];if(cx_fmt(frozen,sizeof frozen,"%s",prior))die("frozen revision");char work[4400],meta[4400],tree[4400],tarfile[4400];path(p,sizeof p,state,"runs");path(work,sizeof work,p,frozen);path(meta,sizeof meta,work,"metadata");path(tree,sizeof tree,work,"snapshot");path(tarfile,sizeof tarfile,work,"snapshot.tar");if(!strcmp(phase,"DETECTED")){if(missing(work)&&mkdir(work,0700))die("revision workspace");if(!missing(meta))die("partial metadata exists; explicit recovery required");char *v[]={"git","clone","--shared","--no-checkout",root,meta,0};run(v);progress(frozen,"CLONED");done(3);}if(!strcmp(phase,"CLONED")){char *v[]={"git","-C",meta,"update-ref","refs/heads/main",frozen,0};run(v);char *head[]={"git","-C",meta,"symbolic-ref","HEAD","refs/heads/main",0};run(head);if(mkdir(tree,0700))die("fresh snapshot");char *archive[]={"git","-C",meta,"archive",frozen,"-o",tarfile,0};run(archive);char *unpack[]={"tar","-xf",tarfile,"-C",tree,0};run(unpack);char gitdir[4400],link[4400];path(gitdir,sizeof gitdir,meta,".git");path(link,sizeof link,tree,".git");if(symlink(gitdir,link))die("private metadata link");char *cw[]={"git","-C",meta,"config","core.worktree",tree,0};run(cw);progress(frozen,"SNAPSHOT");done(3);}if(!strcmp(phase,"SNAPSHOT")){path(p,sizeof p,tree,"unisacc.com");if(!missing(p)&&unlink(p))die("replace snapshot bootstrap");copy(a,p);path(p,sizeof p,tree,"sentinel-models.bin");copy(b,p);char receipt[9500];if(cx_fmt(receipt,sizeof receipt,"OSX_SENTINEL_INPUT1\nrevision\t%s\nsnapshot\t%s\nbootstrap_sha\t%s\nmodels_sha\t%s\nstatus\tPREPARED\nqualification\tNOT_EXECUTED\n",frozen,tree,boot,models))die("receipt bound");path(p,sizeof p,work,"inputs.tsv");put(p,receipt,strlen(receipt),0);progress(frozen,"WAIT_BUILD");done(3);}if(!strcmp(phase,"WAIT_BUILD")){if(!lanehash[0]){setturn("FETCH\n");free(active);free(active2);done(3);}char build[4400],src[4400],com[4400],dir[4400];path(dir,sizeof dir,tree,"out");if(missing(dir)&&mkdir(dir,0700))die("snapshot out");path(build,sizeof build,tree,"out/release-build");if(!missing(build))die("partial builder requires explicit recovery");path(src,sizeof src,tree,"tools/release-build.cx");path(com,sizeof com,tree,"unisacc.com");char *v[]={"sh",com,src,"-o",build,0};window(40);run(v);char hash[65];digest(build,hash);path(p,sizeof p,work,"builder.sha256");put(p,hash,64,0);progress(frozen,"BUILDER_READY");done(3);}if(!strcmp(phase,"BUILDER_READY")){char build[4400],slice[4400],hash[65];path(build,sizeof build,tree,"out/release-build");digest(build,hash);path(p,sizeof p,work,"builder.sha256");size_t z;char*h=readreg(p,&z,64);if(z!=64||memcmp(h,hash,64))die("builder executable changed");free(h);path(slice,sizeof slice,tree,"out/slice");if(!missing(slice))die("partial slice requires explicit recovery");char *v[]={build,"--rev",frozen,"slice",tree,b,slice,"--target","osx/arm64",0};window(57);run(v);after_build(frozen,tree,work);done(3);}if(!strcmp(phase,"LANE")){dispatch_lane(frozen,tree,work);done(2);}if(!strcmp(phase,"LANE_COLLECT")){lane_step(frozen,tree,work);done(2);}if(!strcmp(phase,"GREEN_PENDING_LEDGER")){green_ledger(frozen);done(0);}if(!strcmp(phase,"RED_PENDING_BASELINE")){start_red(frozen);done(3);}if(!strcmp(phase,"REVALIDATE")){lane_step(frozen,tree,work);done(2);}if(!strcmp(phase,"BISECT_PICK")){bisect_pick();done(3);}if(!strcmp(phase,"IDLE")){setturn("FETCH\n");done(0);}die("unknown phase");return 2;}
