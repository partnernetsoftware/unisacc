#pragma unisa use mem.heap
#pragma unisa use compiler.tapebin
#pragma unisa use compiler.tapegate
/* Current format contract: minor 2 preserves explicit source-name/empty-name
   frames (kind 8) and one terminal end (kind 9). Historical minor 0/1 are
   refusal fixtures, not an encoder implementation snapshot. Compile native:
   sh ./unisacc.com -O0 tools/check-tapebin.cx -o OUT/check-tapebin */
static int failed;
static void check(int ok, const char *name) {
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", name);
    if (!ok) failed++;
}
int main(void) {
    const char text[] = ".unit 0 3:412e63\n.unit 0 0:\n.end\n";
    const unsigned char records[] = {3, 8, 0, 3, 'A', '.', 'c', 8, 0, 0, 9};
    unsigned char *bin = 0, *again = 0;
    long n = 0, an = 0;
    int minor = -1, sections = 0, off[4], len[4], count[4], good = 1;
    size_t oldn = 0;
    unsigned char *old = (unsigned char *)cx_read("tests/fixtures/tapebin/return7.tapebin", &oldn);
    check(old && oldn >= 136 && old[10] == 0 && old[11] == 0, "historical-minor0-fixture");
    if (old && oldn >= 136) {
        check(tb2_carrier(old, (int)oldn) == 2 && tb2_fixed(old, (int)oldn, &minor) == 1, "minor0-refused");
        old[10] = 1;
        check(tb2_carrier(old, (int)oldn) == 2 && tb2_fixed(old, (int)oldn, &minor) == 1, "minor1-refused");
    }
    free(old);
    check(tb_encode(text, sizeof text - 1, 1, &bin, &n) > 0, "encode-minor2");
    if (!bin) return 1;
    check(!tb2_magic(bin, (int)n) && !tb2_fixed(bin, (int)n, &minor) && minor == 2
          && !tb2_nsec(bin, (int)n, &sections) && sections == 3, "minor2-header");
    int end = 64 + 24 * sections;
    for (int i = 0; i < sections && i < 4; i++) {
        long long at, bytes, rows;
        if (tb2_row(bin, (int)n, i, tb2_align(end), &at, &bytes, &rows)) { good = 0; break; }
        off[i] = (int)at; len[i] = (int)bytes; count[i] = (int)rows; end = (int)(at + bytes);
    }
    check(good && sections == 3 && end == n, "section-extents");
    check(good && sections == 3 && count[2] == 3 && len[2] == sizeof records
          && !memcmp(bin + off[2], records, sizeof records), "wire-kind8-name-empty-kind9-unique-terminal");
    char *decoded = 0; int decodedn = 0;
    int rc = good && sections == 3 ? tb2_text(bin, (int)n, minor, off, len, count, &decoded, &decodedn) : 1;
    check(!rc && decoded && decodedn == sizeof text - 1 && !memcmp(decoded, text, sizeof text - 1), "canonical-source-empty-end");
    check(!rc && decoded && tb_encode(decoded, decodedn, 1, &again, &an) > 0
          && an == n && !memcmp(again, bin, (size_t)n), "canonical-fixed-point");
    mm_free(decoded); mm_free(again); mm_free(bin);
    printf("TAPEBIN_ROUND\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
