/* Contract: checks tools/release-chain.cx (freeze to public as one resumable command) offline:
 * plan lists the five steps without side effects; a failing step names itself and prints the resume
 * command; done steps are skipped on resume while the stage commit is re-verified against HEAD;
 * usage errors refuse with rc 2. Layer: interfaces. Output: CHECK_RELEASE_CHAIN. */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.env
#pragma unisa use cxlib.sessionroot
static int passed, failed;
static void ck(int ok, const char *id) { printf("%s\t%s\n", ok ? "PASS" : "FAIL", id); if (ok) passed++; else failed++; }
static char tmp[4096], bin[4400];
static np_result actual(char **v) {
    np_result r = {0}; char why[512];
    if (np_run(v, 0, 0, 50, &r, why, sizeof why)) { fprintf(stderr, "check-release-chain: %s\n", why); exit(2); }
    return r;
}
static int has(np_result *r, const char *s) { return r->out && strstr(r->out, s); }
int main(int argc, char **argv) {
    char base[4096]; sy_stat_t st;
    if (sr_default("release-chain", base, sizeof base) || (sy_mkdir(base, 0700) && (sy_lstat(base, &st) || st.kind != 'd' || st.uid != sy_uid() || st.mode != 0700)) ||
        sy_mkdtemp(base, "check", tmp, sizeof tmp) || cx_fmt(bin, sizeof bin, "%s/tool", tmp)) return 2;
    char driver[4096]; if (sy_realpath("./unisacc.com", driver, sizeof driver) < 0) return 2;
    char *build[] = {"sh", driver, "tools/release-chain.cx", "-o", bin, 0};
    if (argc == 2) { if (sy_realpath(argv[1], bin, sizeof bin) < 0) return 2; }
    else { np_result b = actual(build); if (b.rc) { fprintf(stderr, "%s", b.err ? b.err : ""); return 2; } np_free(&b); }
    char inputs[4400], seg[4400], row[9200], state[4400], plan_state[4400];
    if (cx_fmt(inputs, sizeof inputs, "%s/inputs", tmp) || cx_fmt(seg, sizeof seg, "%s/seg", tmp) ||
        cx_fmt(state, sizeof state, "%s/state", tmp) || cx_fmt(plan_state, sizeof plan_state, "%s/plan-state", tmp) ||
        cx_write(seg, "x\n", 2) ||
        cx_fmt(row, sizeof row, "version\t0.0.99\ndate\t2026-01-01\nfreeze\t%s\nsegment\tinvalid\t%s\n", "0000000000000000000000000000000000000000", seg) ||
        cx_write(inputs, row, strlen(row))) return 2;
    /* (1) plan: five steps + post-publish + precheck warnings, no state written */
    char *plan[] = {bin, "plan", "--inputs", inputs, "--state", plan_state, "--layout", "/nonexistent-layout", 0};
    np_result r = actual(plan);
    ck(r.rc == 0 && has(&r, "CHAIN\tPRECHECK\tef-counts\t") && has(&r, "CHAIN\tCMD\t0a\tpack\t") && has(&r, "CHAIN\tCMD\t0b\twarm\t") &&
       has(&r, "CHAIN\tCMD\t1\tprep\t") && has(&r, "CHAIN\tCMD\t2\tstage-a\t") && has(&r, "CHAIN\tCMD\t3\tstage-commit\t") &&
       has(&r, "CHAIN\tCMD\t4\tstage-dry\t") && has(&r, "--strict release/evidence/v0.0.99-strict-2026-01-01.tsv") && has(&r, " --dry\n") &&
       has(&r, "CHAIN\tCMD\t5\texecute\t") && has(&r, "CHAIN\tCMD\t6\tpost-publish\t") && has(&r, "mark-version-seq --version 0.0.99") && has(&r, "version-metrics-gen.cx -- --write-history") && has(&r, "CHAIN\tRESULT\tPLAN\tversion=0.0.99"), "plan-lists-five-steps");
    ck(sy_exists(plan_state) == 0 && !has(&r, "CHAIN\tRUN\t"), "plan-runs-nothing");
    ck(has(&r, "CHAIN\tCMD\tP0\tprerun-plan\t") && has(&r, "--ids-file \"${PRERUN_IDS:?}\"") && has(&r, "--normal-jobs 4") &&
       has(&r, "CHAIN\tCMD\tP1\tprerun-start\t") && has(&r, "--resume --max-jobs 4 --keep-going") &&
       has(&r, "for attempt in 1 2; do") && has(&r, "&& exit 0; done; exit 1") &&
       has(&r, "supervise.log") && has(&r, "PRERUN_RUN status=DONE") &&
       has(&r, "CHAIN\tCMD\tP2\tprerun-merge\t") && has(&r, "CHAIN\tCMD\tP3\tprerun-archive\t") &&
       has(&r, "--repo . --version '0.0.99'"), "plan-prints-prerun-reentry-merge-and-archive");
    ck(has(&r, "CHAIN\tWARN\twarm\t"), "plan-warns-missing-warm");
    np_free(&r);
    /* (1b) unregistered UNISACC_* var: warned in plan, refused rc=1 in run; allowlisted var accepted */
    {
        char cmd[9200];
        cx_fmt(cmd, sizeof cmd, "UNISACC_STRAY_TEST=1 %s plan --inputs %s --state %s --layout /nonexistent-layout", bin, inputs, plan_state);
        char *vp[] = {"sh", "-c", cmd, 0};
        r = actual(vp);
        ck(r.rc == 0 && has(&r, "CHAIN\tWARN\tenv\tunregistered UNISACC_* var=UNISACC_STRAY_TEST"), "plan-warns-unregistered-env");
        np_free(&r);
        cx_fmt(cmd, sizeof cmd, "UNISACC_STRAY_TEST=1 %s run --inputs %s --state %s --layout /nonexistent-layout", bin, inputs, state);
        char *vr[] = {"sh", "-c", cmd, 0};
        r = actual(vr);
        ck(r.rc == 1 && has(&r, "CHAIN\tFAIL\t0\tenv-check\tunregistered UNISACC_* var=UNISACC_STRAY_TEST"), "run-refuses-unregistered-env");
        np_free(&r);
        cx_fmt(cmd, sizeof cmd, "UNISACC_IDENT_HELP=1 %s run --inputs %s --state %s --layout /nonexistent-layout", bin, inputs, state);
        char *vpfx[] = {"sh", "-c", cmd, 0};
        r = actual(vpfx);
        ck(r.rc == 1 && has(&r, "CHAIN\tFAIL\t0\tenv-check\tunregistered UNISACC_* var=UNISACC_IDENT_HELP"), "run-refuses-prefix-match-env");
        np_free(&r);
        cx_fmt(cmd, sizeof cmd, "UNISACC_IDENT_HELPER=/bin/true UNISACC_DEVSVC_DIR=/tmp/x %s plan --inputs %s --state %s --layout /nonexistent-layout", bin, inputs, plan_state);
        char *va[] = {"sh", "-c", cmd, 0};
        r = actual(va);
        ck(r.rc == 0 && !has(&r, "CHAIN\tWARN\tenv\t") && !has(&r, "CHAIN\tWARN\tident-helper\t"), "plan-allows-registered-env");
        np_free(&r);
        cx_fmt(cmd, sizeof cmd, "env -u UNISACC_IDENT_HELPER %s plan --inputs %s --state %s --layout /nonexistent-layout", bin, inputs, plan_state);
        char *vi[] = {"sh", "-c", cmd, 0};
        r = actual(vi);
        ck(r.rc == 0 && has(&r, "CHAIN\tWARN\tident-helper\tUNISACC_IDENT_HELPER unset"), "plan-warns-unset-ident-helper");
        np_free(&r);
    }
    /* (2) a failing first step names itself, prints the child refusal and the resume command */
    char *run[] = {bin, "run", "--inputs", inputs, "--state", state, "--layout", "/nonexistent-layout", 0, 0, 0};
    r = actual(run);
    ck(r.rc == 1 && has(&r, "CHAIN\tFAIL\t1\tprep\trc=2") && has(&r, "SEGMENT_IDENTITY") && has(&r, "NEXT\t1\t") && has(&r, " --from 1\n") &&
       !has(&r, "CHAIN\tRUN\t2\t"), "failed-step-named-with-resume");
    char marker[4500]; if (cx_fmt(marker, sizeof marker, "%s/prep.done", state)) return 2;
    ck(sy_exists(marker) == 0, "failed-step-not-marked-done");
    np_free(&r);
    /* (3) resume: done steps below --from are skipped, the stage commit is re-verified against HEAD */
    char m2[4500]; if (cx_fmt(m2, sizeof m2, "%s/stage-a.done", state) || cx_write(marker, "prep\trc=0\n", 10) || cx_write(m2, "stage-a\trc=0\n", 13)) return 2;
    run[8] = "--from"; run[9] = "3";
    r = actual(run);
    ck(r.rc == 1 && has(&r, "CHAIN\tSKIP\t1\tprep\tdone") && has(&r, "CHAIN\tSKIP\t2\tstage-a\tdone") &&
       has(&r, "CHAIN\tFAIL\t3\tstage-commit\tHEAD lacks the stage bytes of release/candidate.tsv") && has(&r, " --from 3\n") &&
       !has(&r, "CHAIN\tCMD\t4\t"), "resume-skips-done-and-reverifies-stage");
    np_free(&r);
    /* (4) --from 1 reruns a step even when marked done */
    run[9] = "1";
    r = actual(run);
    ck(r.rc == 1 && !has(&r, "CHAIN\tSKIP\t1\t") && has(&r, "CHAIN\tFAIL\t1\tprep\t"), "from-reruns-marked-step");
    np_free(&r);
    /* (4b) step 3 X_PUSHED check: committed to HEAD but not pushed to origin/main -> FAIL X_PUSHED; pushed -> PASS step 3 */
    {
        char cmd1[9200], cmd2[4096];
        cx_fmt(cmd1, sizeof cmd1,
            "T=%s/xpush; mkdir -p \"$T/repo/release/evidence/0.0.99\" \"$T/st/stage/release/evidence/0.0.99\" && "
            "git init -q --bare \"$T/origin.git\" && git init -q -b main \"$T/repo\" && "
            "git -C \"$T/repo\" config user.email t@t && git -C \"$T/repo\" config user.name t && "
            "git -C \"$T/repo\" remote add origin \"$T/origin.git\" && "
            "ln -s %s \"$T/repo/unisacc.com\" && "
            "printf 'init\\n' > \"$T/repo/README\" && git -C \"$T/repo\" add README && git -C \"$T/repo\" commit -qm init && "
            "git -C \"$T/repo\" push -q origin HEAD:main && "
            "printf 'cand\\n' > \"$T/st/stage/release/candidate.tsv\" && "
            "printf 'rat\\n' > \"$T/st/stage/release/evidence/0.0.99/ratchets.txt\" && "
            "printf 'ev\\n' > \"$T/st/stage/release/evidence/0.0.99/evidence-rows.tsv\" && "
            "cp -r \"$T/st/stage/release/.\" \"$T/repo/release/\" && "
            "git -C \"$T/repo\" add release && git -C \"$T/repo\" commit -qm stage-a && "
            "printf 'prep\\trc=0\\n' > \"$T/st/prep.done\" && printf 'stage-a\\trc=0\\n' > \"$T/st/stage-a.done\" && "
            "(cd \"$T/repo\" && %s run --inputs %s --state \"$T/st\" --layout /nonexistent-layout --from 3; echo RC1=$?)",
            tmp, driver, bin, inputs);
        char *vx1[] = {"sh", "-c", cmd1, 0};
        r = actual(vx1);
        ck(has(&r, "CHAIN\tFAIL\t3\tstage-commit\tHEAD not pushed to origin/main (X_PUSHED)") && !has(&r, "CHAIN\tPASS\t3\t") && has(&r, "RC1=1\n"), "stage-commit-refuses-unpushed-x");
        np_free(&r);
        cx_fmt(cmd2, sizeof cmd2,
            "T=%s/xpush; git -C \"$T/repo\" push -q origin HEAD:main && "
            "(cd \"$T/repo\" && %s run --inputs %s --state \"$T/st\" --layout /nonexistent-layout --from 3; echo RC2=$?); "
            "rm -rf \"$T\"",
            tmp, bin, inputs);
        char *vx2[] = {"sh", "-c", cmd2, 0};
        r = actual(vx2);
        ck(has(&r, "CHAIN\tPASS\t3\tstage-commit\tHEAD carries candidate.tsv, ratchets.txt, evidence-rows.tsv (X_PUSHED ok)") && !has(&r, "X_PUSHED)"), "stage-commit-passes-after-push");
        np_free(&r);
    }
    /* (5b) retry-ci: dry mode, real recovery with fake gh + fake evidence, idempotent rerun, non-draft refusal, bad run-id */
    {
        char cmd[9200];
        cx_fmt(cmd, sizeof cmd,
            "T=%s/rci; mkdir -p \"$T/ev\" && "
            "printf 'repo\\ttag\\tcommit\\tversion\\tworkflow\\tworkflow_ref\\tci_run_id\\tape\\n"
            "o/r\\tv0.0.99\\tabc\\t0.0.99\\tw.yml\\tv0.0.99\\t44772879607\\tu.com\\n' > \"$T/cand.tsv\" && "
            "printf 'j\\n' > \"$T/ev/ci-44772879607.json\" && printf 'l\\n' > \"$T/ev/ci-44772879607.log\" && "
            "printf 'd\\n' > \"$T/ev/draft-readback.txt\" && "
            "printf 'prefreeze-strict\\tt\\tPASS\\ts\\tn\\nexec-1-X-commit\\tt\\t-\\tx\\tn\\nexec-2-draft-readback\\tt\\tPASS\\td\\tn\\nexec-3-ci\\tt\\tFAIL\\t44772879607\\tn\\n' > \"$T/ev/INDEX.tsv\" && "
            "printf '#!/bin/sh\\necho \"$*\" >> \"%s/rci/gh.log\"\\n"
            "if [ \"$1\" = release ] && [ \"$2\" = view ]; then [ -f \"%s/rci/deleted\" ] && exit 1; printf \"{\\\\\"isDraft\\\\\":true}\\\\n\"; exit 0; fi\\n"
            "if [ \"$1\" = release ] && [ \"$2\" = delete ]; then : > \"%s/rci/deleted\"; exit 0; fi\\nexit 2\\n' > \"$T/gh-draft.sh\" && chmod +x \"$T/gh-draft.sh\" && "
            "printf '#!/bin/sh\\necho \"$*\" >> \"%s/rci/gh-pub.log\"\\n"
            "if [ \"$1\" = release ] && [ \"$2\" = view ]; then printf \"{\\\\\"isDraft\\\\\":false}\\\\n\"; exit 0; fi\\nexit 2\\n' > \"$T/gh-pub.sh\" && chmod +x \"$T/gh-pub.sh\" && "
            "%s retry-ci --version 0.0.99 --run-id 44772879607 --evidence-dir \"$T/ev\" --candidate \"$T/cand.tsv\" --gh \"$T/gh-draft.sh\" --dry; echo DRYRC=$?; "
            "grep -q '44772879607' \"$T/cand.tsv\" && echo DRY_KEPT=1; "
            "%s retry-ci --version 0.0.99 --run-id 44772879607 --evidence-dir \"$T/ev\" --candidate \"$T/cand.tsv\" --gh \"$T/gh-draft.sh\"; echo RUNRC=$?; "
            "grep -q '\t0\tu.com' \"$T/cand.tsv\" && echo CAND_ZERO=1; "
            "test -f \"$T/ev/ci-failed-44772879607.json\" && test -f \"$T/ev/ci-failed-44772879607.log\" && test -f \"$T/ev/draft-readback-failed-44772879607.txt\" && test -f \"$T/ev/index-failed-44772879607.tsv\" && test -f \"$T/ev/retry-ci-rollback-44772879607.txt\" && echo FILES_OK=1; "
            "! grep -q '^exec-' \"$T/ev/INDEX.tsv\" && grep -q '^prefreeze-strict' \"$T/ev/INDEX.tsv\" && echo IDX_OK=1; "
            "grep -q 'release delete v0.0.99 --yes' \"$T/gh.log\" && ! grep -q 'cleanup-tag' \"$T/gh.log\" && echo GH_OK=1; "
            "%s retry-ci --version 0.0.99 --run-id 44772879607 --evidence-dir \"$T/ev\" --candidate \"$T/cand.tsv\" --gh \"$T/gh-draft.sh\"; echo IDEMRC=$?; "
            "%s retry-ci --version 0.0.99 --run-id 44772879607 --evidence-dir \"$T/ev\" --candidate \"$T/cand.tsv\" --gh \"$T/gh-pub.sh\"; echo PUBRC=$?; "
            "! grep -q 'delete' \"$T/gh-pub.log\" && echo PUB_SAFE=1; "
            "%s retry-ci --version 0.0.99 --run-id abc --evidence-dir \"$T/ev\" --candidate \"$T/cand.tsv\" 2>&1; echo BADIDRC=$?; "
            "%s retry-ci --version 0.0.99 --run-id 7 --evidence-dir \"$T/ev\" --candidate \"$T/cand.tsv\" --gh \"$T/gh-draft.sh\" --dry; echo ONE_DIGIT_RC=$?; "
            "%s retry-ci --version 0.0.99 --evidence-dir \"$T/ev\" --candidate \"$T/cand.tsv\" 2>&1; echo NOIDRC=$?; "
            "%s retry-ci --version 0.0.99 --run-id 7 --evidence-dir \"$T/ev\" --candidate \"$T/missing.tsv\" 2>&1; echo MISSCANDRC=$?; "
            "printf 'repo\\tci_run_id\\n' > \"$T/hdr-only.tsv\"; %s retry-ci --version 0.0.99 --run-id 7 --evidence-dir \"$T/ev\" --candidate \"$T/hdr-only.tsv\" 2>&1; echo HDRONLYRC=$?; "
            "rm -rf \"$T\"",
            tmp, tmp, tmp, tmp, tmp, bin, bin, bin, bin, bin, bin, bin, bin, bin);
        char *vr[] = {"sh", "-c", cmd, 0};
        r = actual(vr);
        ck(has(&r, "DRYRC=0\n") && has(&r, "DRY_KEPT=1\n") && has(&r, "RETRY_CI\tDRAFT\tdry\twould-delete-draft"), "retry-ci-dry-no-mutation");
        ck(has(&r, "RUNRC=0\n") && has(&r, "CAND_ZERO=1\n") && has(&r, "FILES_OK=1\n") && has(&r, "IDX_OK=1\n") && has(&r, "GH_OK=1\n") && has(&r, "RETRY_CI\tDRAFT\tdeleted\ttag=v0.0.99\ttag_kept=1\n"), "retry-ci-recovers-and-archives");
        ck(has(&r, "IDEMRC=0\n") && has(&r, "RETRY_CI\tCANDIDATE\tskip\tci_run_id=0\n") && has(&r, "RETRY_CI\tINDEX\tskip\tno exec-1..3 rows\n") && has(&r, "RETRY_CI\tDRAFT\tskip\tabsent\t"), "retry-ci-idempotent-rerun");
        ck(has(&r, "PUBRC=1\n") && has(&r, "REFUSE non-draft release v0.0.99\n") && has(&r, "PUB_SAFE=1\n"), "retry-ci-refuses-published-release");
        ck(has(&r, "BADIDRC=2\n") && has(&r, "ONE_DIGIT_RC=0\n") && has(&r, "NOIDRC=2\n") &&
           has(&r, "MISSCANDRC=2\n") && has(&r, "candidate unreadable") &&
           has(&r, "HDRONLYRC=2\n") && has(&r, "candidate needs header + data row"), "retry-ci-bad-run-id-rc2");
        np_free(&r);
    }
    /* (5c) steps 0a/0b split + idempotency + check-ef-counts positive & negative controls */
    {
        char cmd[9200];
        cx_fmt(cmd, sizeof cmd,
            "T=%s/pre0; mkdir -p \"$T/st\" \"$T/pk\" && "
            "printf 'version\\t0.0.99\\ndate\\t2026-01-01\\npack\\t%s/pre0/pk\\nwarm\\t%s/pre0/w.tsv\\n' > \"$T/in-both.tsv\" && "
            "%s plan --inputs \"$T/in-both.tsv\" --state \"$T/st\" --layout /nonexistent-layout; echo PBOTH=$?; "
            "printf 'version\\t0.0.99\\ndate\\t2026-01-01\\npack\\t%s/pre0/pk\\n' > \"$T/in-nowarm.tsv\" && "
            "%s run --inputs \"$T/in-nowarm.tsv\" --state \"$T/st\" --layout /nonexistent-layout; echo NWRC=$?; "
            "printf '%s/pre0/warm-fake.tsv\\n' > \"$T/st/warm.done\" && "
            "%s run --inputs \"$T/in-nowarm.tsv\" --state \"$T/st\" --layout /nonexistent-layout; echo WDONE=$?; "
            "grep -q 'warm\t%s/pre0/warm-fake.tsv' \"$T/st/inputs-resolved.tsv\" && echo RESOLVED_OK=1; "
            "rm -f \"$T/st/inputs-resolved.tsv\"; "
            "%s run --inputs \"$T/in-nowarm.tsv\" --state \"$T/st\" --layout /nonexistent-layout --from 2; "
            "grep -qx 'warm\t%s/pre0/warm-fake.tsv' \"$T/st/inputs-resolved.tsv\" && echo FROM2_WARM=1; "
            "rm -f \"$T/st/inputs-resolved.tsv\"; "
            "%s run --inputs \"$T/in-nowarm.tsv\" --state \"$T/st\" --layout /nonexistent-layout --from 3; "
            "grep -qx 'warm\t%s/pre0/warm-fake.tsv' \"$T/st/inputs-resolved.tsv\" && echo FROM3_WARM=1; "
            "rm -rf \"$T\"",
            tmp, tmp, tmp, bin, tmp, bin, tmp, bin, tmp, bin, tmp, bin, tmp);
        char *vp[] = {"sh", "-c", cmd, 0};
        r = actual(vp);
        ck(has(&r, "PBOTH=0\n") && has(&r, "CHAIN\tSKIP\t0a\tpack\tprovided-in-inputs\n") && has(&r, "CHAIN\tSKIP\t0b\twarm\tprovided-in-inputs\n"), "plan-skips-provided-pack-and-warm");
        ck(has(&r, "NWRC=1\n") && has(&r, "CHAIN\tRUN\t0b\twarm\t") && has(&r, "CHAIN\tFAIL\t0b\twarm\t"), "run-executes-split-warm-step-before-prep");
        ck(has(&r, "WDONE=1\n") && has(&r, "CHAIN\tSKIP\t0b\twarm\tdone\n") && has(&r, "RESOLVED_OK=1\n"), "run-skips-done-warm-and-injects-resolved-inputs");
        ck(has(&r, "FROM2_WARM=1\n") && has(&r, "FROM3_WARM=1\n"), "resume-after-prep-restores-warm-input");
        np_free(&r);

        cx_fmt(cmd, sizeof cmd,
            "T=%s/efc; mkdir -p \"$T\" && "
            "%s check-ef-counts --expected-fail release/evidence/0.0.86/expected-fail.tsv --strict release/evidence/v0.0.86-strict-2026-11-20.tsv; echo REAL86=$?; "
            "printf 'int main(void){printf(\"FOO_BAR_COUNT\\tpass=%%d\\tfail=%%d\\n\",10,3);}\\n' > \"$T/foo-ok.cx\" && "
            "printf 'int main(void){return 1;}\\n' > \"$T/foo-bad.cx\" && "
            "printf 'foo-bar\\tIMPLEMENTED\\tinterfaces\\t%s/efc/foo-ok.cx\\nfoo-miss\\tIMPLEMENTED\\tinterfaces\\t%s/efc/foo-bad.cx\\n' > \"$T/batches.tsv\" && "
            "printf 'batch\\texpected\\treason\\nfoo-bar\\t10/3\\tok\\n' > \"$T/ef-ok.tsv\" && "
            "printf 'FOO_BAR_COUNT\\tpass=10\\tfail=3\\n' > \"$T/st-ok.tsv\" && "
            "printf 'RAW\\tBATCH_RUN\\tid=foo-bar\\tstatus=FAIL\\tcount=10/3\\n' > \"$T/st-raw.tsv\" && "
            "printf 'FOO_BAR_COUNT\\tpass=10\\tfail=4\\n' > \"$T/st-bad.tsv\" && "
            "printf 'batch\\texpected\\treason\\nfoo-miss\\t10/3\\tno-line\\n' > \"$T/ef-nosrc.tsv\" && "
            "printf 'batch\\texpected\\treason\\nno-such-batch\\t1/1\\tmissing\\n' > \"$T/ef-nobat.tsv\" && "
            "%s check-ef-counts --expected-fail \"$T/ef-ok.tsv\" --batches \"$T/batches.tsv\" --strict \"$T/st-ok.tsv\"; echo EFOK=$?; "
            "%s check-ef-counts --expected-fail \"$T/ef-ok.tsv\" --batches \"$T/batches.tsv\" --strict \"$T/st-raw.tsv\"; echo EFRAW=$?; "
            "%s check-ef-counts --expected-fail \"$T/ef-ok.tsv\" --batches \"$T/batches.tsv\" --strict \"$T/st-bad.tsv\"; echo EFMIS=$?; "
            "%s check-ef-counts --expected-fail \"$T/ef-nosrc.tsv\" --batches \"$T/batches.tsv\"; echo EFNOSRC=$?; "
            "%s check-ef-counts --expected-fail \"$T/ef-nobat.tsv\" --batches \"$T/batches.tsv\"; echo EFNOBAT=$?; "
            "rm -rf \"$T\"",
            tmp, bin, tmp, tmp, bin, bin, bin, bin, bin);
        char *ve[] = {"sh", "-c", cmd, 0};
        r = actual(ve);
        ck(has(&r, "REAL86=0\n") && has(&r, "EF_COUNT\tPASS\tenv-semantics\tmarker=ENV_SEMANTICS_COUNT\texpected=84/2\t"), "ef-counts-real-0.0.86-pass");
        ck(has(&r, "EFOK=0\n") && has(&r, "EFRAW=0\n") && has(&r, "EF_COUNT\tPASS\tfoo-bar\tmarker=FOO_BAR_COUNT\texpected=10/3\t"), "ef-counts-marker-pass");
        ck(has(&r, "EFMIS=1\n") && has(&r, "EF_COUNT\tFAIL\tfoo-bar\tcount-mismatch\twant=10/3\tgot=10/4\n"), "ef-counts-mismatch-refused");
        ck(has(&r, "EFNOSRC=1\n") && has(&r, "EF_COUNT\tFAIL\tfoo-miss\tmissing-count-line-in-source\t"), "ef-counts-missing-source-marker-refused");
        ck(has(&r, "EFNOBAT=1\n") && has(&r, "EF_COUNT\tFAIL\tno-such-batch\tmissing-batch-in-registry\n"), "ef-counts-missing-batch-refused");
        np_free(&r);
    }
    /* Freeze conflict policy: retire one query-only table, keep the rest staged as conflicts. */
    {
        char cmd[9200];
        cx_fmt(cmd, sizeof cmd,
            "T=%s/freeze; git init -q -b fixture \"$T\" && cd \"$T\" && "
            "git config user.name fixture && git config user.email freeze@example.invalid && "
            "mkdir -p build exec/facts && "
            "printf '# ignore\\n' > .gitignore && "
            "printf 'doc-links\\tgen\\tcheck\\tquery-only gen\\tbuild/doc-links.tsv\\tinputs\\t1\\t3\\n"
                   "links\\tgen\\tcheck\\tquery-only gen\\tbuild/links.tsv\\tinputs\\t1\\t3\\n"
                   "index\\tgen\\tcheck\\tgen --write\\tbuild/table-index.tsv\\tinputs\\t1\\t3\\n' > exec/facts/derive.tsv && "
            "printf 'base\\n' > build/doc-links.tsv && cp build/doc-links.tsv build/links.tsv && "
            "cp build/doc-links.tsv build/table-index.tsv && cp build/doc-links.tsv source.c && "
            "git add . && git commit -qm base && git branch side && "
            "printf 'main\\n' > build/doc-links.tsv && cp build/doc-links.tsv build/links.tsv && "
            "cp build/doc-links.tsv build/table-index.tsv && cp build/doc-links.tsv source.c && "
            "git commit -qam ours && B=$(git rev-parse HEAD) && git switch -q side && "
            "git rm -q build/doc-links.tsv build/links.tsv && "
            "printf '/build/doc-links.tsv\\n' >> .gitignore && printf 'side\\n' > source.c && cp source.c build/table-index.tsv && "
            "git commit -qam theirs && I=$(git rev-parse HEAD) && git switch -q fixture || exit 2; "
            "git merge --no-ff --no-commit side; [ \"$?\" = 1 ] || exit 2; "
            "%s freeze-conflicts --base \"$B\" --incoming \"$I\"; echo FPLAN=$?; "
            "test -n \"$(git ls-files -u -- build/doc-links.tsv)\" && echo PLAN_KEPT=1; "
            "%s freeze-conflicts --base \"$B\" --incoming \"$B\" --apply; echo FWRONG=$?; "
            "test -n \"$(git ls-files -u -- build/doc-links.tsv)\" && echo WRONG_KEPT=1; "
            "%s freeze-conflicts --base \"$B\" --incoming \"$I\" --apply; echo FAPPLY=$?; "
            "test -z \"$(git ls-files -u -- build/doc-links.tsv)\" && grep -qx main build/doc-links.tsv && echo RETIRED=1; "
            "test -n \"$(git ls-files -u -- build/links.tsv)\" && "
            "test -n \"$(git ls-files -u -- build/table-index.tsv)\" && "
            "test -n \"$(git ls-files -u -- source.c)\" && echo OTHER_KEPT=1",
            tmp, bin, bin, bin);
        char *fv[] = {"sh", "-c", cmd, 0};
        r = actual(fv);
        ck(has(&r, "FPLAN=1\n") && has(&r, "PLAN_KEPT=1\n") &&
           has(&r, "path=build/doc-links.tsv\taction=retire-index") &&
           has(&r, "path=build/table-index.tsv\taction=regenerate\tproducer=index") &&
           has(&r, "path=source.c\taction=manual"), "freeze-plan-classifies-without-moving-index");
        ck(has(&r, "FWRONG=2\n") && has(&r, "WRONG_KEPT=1\n") && r.err &&
           strstr(r.err, "merge-identity-mismatch"), "freeze-apply-refuses-wrong-incoming-identity");
        ck(has(&r, "FAPPLY=1\n") && has(&r, "RETIRED=1\n") && has(&r, "OTHER_KEPT=1\n") &&
           has(&r, "path=build/links.tsv\taction=manual"), "freeze-apply-only-removes-proven-retired-index-path");
        np_free(&r);
        char fixture[4400];
        if (cx_fmt(fixture, sizeof fixture, "%s/freeze", tmp) || sy_remove_all(fixture)) return 2;
    }
    /* (4b) mark-version-seq verifies tag + INDEX + readback before updating state atomically, is idempotent, and refuses missing preconditions */
    {
        char mrepo[4400], vseq[4400], idxdir[4400], idx99[4400], idx999[4400], gcmd[4800];
        if (cx_fmt(mrepo, sizeof mrepo, "%s/mrepo", tmp) ||
            cx_fmt(vseq, sizeof vseq, "%s/mrepo/build/version-seq.tsv", tmp) ||
            cx_fmt(idxdir, sizeof idxdir, "%s/mrepo/release/evidence/0.0.99", tmp) ||
            cx_fmt(idx99, sizeof idx99, "%s/mrepo/release/evidence/0.0.99/INDEX.tsv", tmp) ||
            cx_fmt(idx999, sizeof idx999, "%s/mrepo/release/evidence/0.0.999/INDEX.tsv", tmp)) return 2;
        if (sy_mkdir_all(idxdir, 0700) ||
            cx_fmt(gcmd, sizeof gcmd, "%s/mrepo/build", tmp) || sy_mkdir_all(gcmd, 0700) ||
            cx_fmt(gcmd, sizeof gcmd, "%s/mrepo/release/evidence/0.0.999", tmp) || sy_mkdir_all(gcmd, 0700)) return 2;
        const char *seed_vs = "slot\tversion\tclass\tstate\tnote\n1\t0.0.98\tc\t\xe5\xb7\xb2\xe5\x85\xac\xe5\xbc\x80\told\n2\t0.0.99\tc\t\xe8\xbf\x9b\xe8\xa1\x8c\xe4\xb8\xad\tnow\n";
        const char *seed_idx = "step\tts\tstatus\trc\tdesc\nexec-5-publish\t2026-11-21T00:00:00Z\tPASS\t0\tpublic release\n";
        if (cx_write(vseq, seed_vs, strlen(seed_vs)) || cx_write(idx999, seed_idx, strlen(seed_idx))) return 2;
        if (cx_fmt(gcmd, sizeof gcmd,
            "cd \"%s\" && git init -q -b main && git config user.name fx && git config user.email fx@example.invalid && "
            "git add . && git commit -qm init && git tag v0.0.999", mrepo)) return 2;
        char *gv[] = {"sh", "-c", gcmd, 0};
        r = actual(gv); np_free(&r);

        /* Precondition 1: missing git tag v0.0.99 is refused before touching version-seq.tsv */
        if (cx_write(idx99, seed_idx, strlen(seed_idx))) return 2;
        char *m1[] = {bin, "mark-version-seq", "--version", "0.0.99", "--repo", mrepo, "--table", vseq, 0};
        r = actual(m1);
        size_t rn = 0; char *rb = cx_read(vseq, &rn);
        ck(r.rc == 2 && r.err && strstr(r.err, "REFUSE VERSION_SEQ_MARK") != 0 && strstr(r.err, "missing-tag") != 0 &&
           rb && strstr(rb, "2\t0.0.99\tc\t\xe8\xbf\x9b\xe8\xa1\x8c\xe4\xb8\xad\tnow\n") != 0, "mark-version-seq-missing-tag-refused");
        free(rb); np_free(&r);

        /* Precondition 2: tag exists but INDEX.tsv lacks exec-5-publish PASS -> refused without touching version-seq.tsv */
        if (cx_fmt(gcmd, sizeof gcmd, "cd \"%s\" && git tag v0.0.99", mrepo)) return 2;
        r = actual(gv); np_free(&r);
        const char *bad_idx = "step\tts\tstatus\trc\tdesc\nprefreeze-strict\t2026-11-21T00:00:00Z\tPASS\t0\tpre\n";
        if (cx_write(idx99, bad_idx, strlen(bad_idx))) return 2;
        r = actual(m1);
        rb = cx_read(vseq, &rn);
        ck(r.rc == 2 && r.err && strstr(r.err, "REFUSE VERSION_SEQ_MARK") != 0 && strstr(r.err, "missing-publish-index") != 0 &&
           rb && strstr(rb, "2\t0.0.99\tc\t\xe8\xbf\x9b\xe8\xa1\x8c\xe4\xb8\xad\tnow\n") != 0, "mark-version-seq-missing-index-refused");
        free(rb); np_free(&r);

        /* Precondition 3 (M2): tag + exec-5-publish present, but git history lacks 'v0.0.99 Y2: public readback' commit -> refused */
        if (cx_write(idx99, seed_idx, strlen(seed_idx))) return 2;
        r = actual(m1);
        rb = cx_read(vseq, &rn);
        ck(r.rc == 2 && r.err && strstr(r.err, "REFUSE VERSION_SEQ_MARK") != 0 && strstr(r.err, "missing-y2-commit") != 0 &&
           rb && strstr(rb, "2\t0.0.99\tc\t\xe8\xbf\x9b\xe8\xa1\x8c\xe4\xb8\xad\tnow\n") != 0, "mark-version-seq-missing-y2-commit-refused");
        free(rb); np_free(&r);

        /* Create Y2 commit in mrepo; Precondition 4 (M2): forged exec-7-Y2-done SHA in INDEX.tsv is refused */
        if (cx_fmt(gcmd, sizeof gcmd, "cd \"%s\" && git commit --allow-empty -qm \"v0.0.99 Y2: public readback\"", mrepo)) return 2;
        r = actual(gv); np_free(&r);
        const char *forged_idx =
            "step\tts\tstatus\trc\tdesc\n"
            "exec-5-publish\t2026-11-21T00:00:00Z\tPASS\t0\tpublic release\n"
            "exec-7-Y2-done\t2026-11-21T00:01:00Z\t-\t0000000000000000000000000000000000000000\tY2 committed; this row rides with the next commit\n";
        if (cx_write(idx99, forged_idx, strlen(forged_idx))) return 2;
        r = actual(m1);
        ck(r.rc == 2 && r.err && strstr(r.err, "REFUSE VERSION_SEQ_MARK") != 0 && strstr(r.err, "y2-sha-mismatch") != 0,
           "mark-version-seq-forged-y2-sha-refused");
        np_free(&r);

        /* Preconditions satisfied: tag + INDEX exec-5-publish + Y2 commit -> updates version-seq, backfills exec-7-Y2-done, appends post-publish PASS */
        if (cx_write(idx99, seed_idx, strlen(seed_idx))) return 2;
        r = actual(m1);
        rb = cx_read(vseq, &rn);
        size_t irn = 0; char *irb = cx_read(idx99, &irn);
        ck(r.rc == 0 && has(&r, "VERSION_SEQ_MARK\tUPDATED\tversion=0.0.99") && rb &&
           strstr(rb, "2\t0.0.99\tc\t\xe5\xb7\xb2\xe5\x85\xac\xe5\xbc\x80\tnow\n") != 0 &&
           irb && strstr(irb, "\nexec-7-Y2-done\t") != 0 && strstr(irb, "\npost-publish\t") != 0 &&
           strstr(irb, "\tPASS\tbuild/version-seq.tsv\tversion=0.0.99 marked \xe5\xb7\xb2\xe5\x85\xac\xe5\xbc\x80") != 0,
           "mark-version-seq-updates-and-seals-index");
        free(rb); free(irb); np_free(&r);
        r = actual(m1);
        ck(r.rc == 0 && has(&r, "VERSION_SEQ_MARK\tALREADY_PUBLIC\tversion=0.0.99"), "mark-version-seq-idempotent");
        np_free(&r);

        /* Real 0.0.89 Y2 -> post-publish acceptance test: exact 0.0.89 INDEX.tsv rows + --commit atomic commit */
        {
            char m89[4400], vs89[4400], idxd89[4400], idx89[4400], cmd89[4800];
            if (cx_fmt(m89, sizeof m89, "%s/mrepo89", tmp) ||
                cx_fmt(vs89, sizeof vs89, "%s/mrepo89/build/version-seq.tsv", tmp) ||
                cx_fmt(idxd89, sizeof idxd89, "%s/mrepo89/release/evidence/0.0.89", tmp) ||
                cx_fmt(idx89, sizeof idx89, "%s/mrepo89/release/evidence/0.0.89/INDEX.tsv", tmp) ||
                sy_mkdir_all(idxd89, 0700) ||
                cx_fmt(cmd89, sizeof cmd89, "%s/mrepo89/build", tmp) || sy_mkdir_all(cmd89, 0700)) return 2;
            const char *vs89_txt =
                "slot\tversion\tclass\tstate\tnote\n"
                "23\t0.0.88\tcx-L0\t\xe5\xb7\xb2\xe5\x85\xac\xe5\xbc\x80\t2026-11-21 \xe5\x85\xac\xe5\xbc\x80\n"
                "24\t0.0.89\tA1a \xe5\x86\x85\xe5\xbb\xba\xe6\xa0\xb8\xe5\xbf\x83(U0-U3)\t\xe5\xbb\xba\xe8\xae\xae\t\xe7\xbc\x96\xe6\x8e\x92\xe8\x80\x85 2026-11-21 \xe8\xa3\x81\xe5\xae\x9a; \xe8\xae\xa1\xe5\x88\x92 plans/v0.0.89.md\n";
            const char *idx89_y2 =
                "exec-4-Y1\t2026-11-22 02:34:48 +0800\t-\tdb00056f102b7794c377b7819011678e058d23f3\tcandidate ci_run_id, evidence, decision, notes, rollback\n"
                "exec-4-Y1-frozen\t2026-11-22 02:34:48 +0800\t-\t70186331c381171d2d75227f8ca3fc42d96af389e2e651c03f8a054acd5f2328:fd4e65b23e779955b06fb88d7b30bfd6c4857400b75b60231b6112b39ed23a52\tsha256 of release/evidence.tsv:release/decision.txt at Y1; frozen until Y2\n"
                "exec-5-publish\t2026-11-22 02:34:52 +0800\t-\tv0.0.89\tisDraft=false, Latest\n"
                "exec-6-public-readback\t2026-11-22 02:35:10 +0800\tPASS\tpublic-readback.txt\tfresh download sha256 equals candidate, c47-1-readback rc 0\n"
                "exec-7-Y2\t2026-11-22 02:35:11 +0800\t-\tpending\tevidence INDEX and decision recomputed equal; Y2 commit follows\n";
            if (cx_write(vs89, vs89_txt, strlen(vs89_txt)) || cx_write(idx89, idx89_y2, strlen(idx89_y2))) return 2;
            if (cx_fmt(cmd89, sizeof cmd89,
                "cd \"%s\" && git init -q -b main && git config user.name fx && git config user.email fx@example.invalid && "
                "git add . && git commit -qm \"0.0.89 stage-a\" && git tag v0.0.89 && "
                "git commit --allow-empty -qm \"v0.0.89 Y2: public readback\"", m89)) return 2;
            char *gv89[] = {"sh", "-c", cmd89, 0};
            r = actual(gv89); np_free(&r);
            char *mc89[] = {bin, "mark-version-seq", "--version", "0.0.89", "--repo", m89, "--commit", 0};
            r = actual(mc89);
            ck(r.rc == 0 && has(&r, "VERSION_SEQ_MARK\tUPDATED\tversion=0.0.89") &&
               has(&r, "VERSION_SEQ_COMMIT\trc=0\tversion=0.0.89\ty2="), "mark-version-seq-0089-commit-lands");
            np_free(&r);
            if (cx_fmt(cmd89, sizeof cmd89,
                "cd \"%s\" && test -z \"$(git status --porcelain)\" && "
                "git log -1 --format=%%s | grep -q \"v0.0.89 post-publish\" && "
                "git show HEAD:build/version-seq.tsv | grep -q \"^24\t0.0.89\t.*\t\xe5\xb7\xb2\xe5\x85\xac\xe5\xbc\x80\t\" && "
                "[ \"$(git show HEAD:release/evidence/0.0.89/INDEX.tsv | grep -c '^exec-7-Y2-done\t')\" = 1 ] && "
                "[ \"$(git show HEAD:release/evidence/0.0.89/INDEX.tsv | grep -c '^post-publish\t.*\tPASS\tbuild/version-seq.tsv\t')\" = 1 ] && "
                "echo M89_HEAD_OK=1", m89)) return 2;
            r = actual(gv89);
            ck(r.rc == 0 && has(&r, "M89_HEAD_OK=1\n"), "mark-version-seq-0089-head-clean-and-sealed");
            np_free(&r);
            /* Second run with --commit is idempotent (no duplicate INDEX rows, no empty commit failure) */
            r = actual(mc89);
            ck(r.rc == 0 && has(&r, "VERSION_SEQ_MARK\tALREADY_PUBLIC\tversion=0.0.89"), "mark-version-seq-0089-commit-idempotent");
            np_free(&r);
            if (sy_remove_all(m89)) return 2;
        }

        /* Readback verification: if a later row in version-seq.tsv is already marked public, readback refuses */
        const char * disordered_vs = "slot\tversion\tclass\tstate\tnote\n1\t0.0.98\tc\t\xe5\xb7\xb2\xe5\x85\xac\xe5\xbc\x80\told\n2\t0.0.99\tc\t\xe8\xbf\x9b\xe8\xa1\x8c\xe4\xb8\xad\tnow\n3\t0.1.0\tc\t\xe5\xb7\xb2\xe5\x85\xac\xe5\xbc\x80\tlater\n";
        if (cx_write(vseq, disordered_vs, strlen(disordered_vs))) return 2;
        r = actual(m1);
        ck(r.rc == 2 && r.err && strstr(r.err, "REFUSE VERSION_SEQ_MARK") != 0 && strstr(r.err, "readback-verify-failed") != 0,
           "mark-version-seq-readback-not-last-public-refused");
        np_free(&r);

        if (cx_write(vseq, seed_vs, strlen(seed_vs))) return 2;
        if (cx_fmt(gcmd, sizeof gcmd, "cd \"%s\" && git commit --allow-empty -qm \"v0.0.999 Y2: public readback\"", mrepo)) return 2;
        r = actual(gv); np_free(&r);
        char *m2[] = {bin, "mark-version-seq", "--version", "0.0.999", "--repo", mrepo, "--table", vseq, 0};
        r = actual(m2);
        ck(r.rc == 2 && r.err && strstr(r.err, "REFUSE VERSION_SEQ_MARK") != 0, "mark-version-seq-missing-refused");
        np_free(&r);
        if (sy_remove_all(mrepo)) return 2;
    }
    /* (4c) R71 backup-evidence pre-gate: copies 7 chain+prerun artifacts to out-of-repo backup with sha256 manifest, and refuses execute (step 5) when missing or tampered */
    {
        char btest[4400], brepo[4400], bchain[4400], bpre[4400], bdir[4400], binrepo[4400], bst[4400], bcmd[8192];
        if (cx_fmt(btest, sizeof btest, "%s/bktest", tmp) ||
            cx_fmt(brepo, sizeof brepo, "%s/bktest/repo", tmp) ||
            cx_fmt(bchain, sizeof bchain, "%s/bktest/chain/1111111111111111111111111111111111111111", tmp) ||
            cx_fmt(bpre, sizeof bpre, "%s/bktest/prerun", tmp) ||
            cx_fmt(bdir, sizeof bdir, "%s/bktest/out-of-repo-backup", tmp) ||
            cx_fmt(binrepo, sizeof binrepo, "%s/bktest/repo/in-repo-backup", tmp) ||
            cx_fmt(bst, sizeof bst, "%s/bktest/state", tmp)) return 2;
        if (cx_fmt(bcmd, sizeof bcmd,
            "mkdir -p \"%s/release/evidence/0.0.99\" \"%s/stage/release/evidence/0.0.99\" \"%s/ape-final\" \"%s\" && "
            "cd \"%s\" && git init -q -b main && git config user.email t@t && git config user.name t && ln -s \"%s\" unisacc.com && "
            "printf 'cand\\n' > \"%s/stage/release/candidate.tsv\" && "
            "printf 'rat\\n' > \"%s/stage/release/evidence/0.0.99/ratchets.txt\" && "
            "printf 'ev\\n' > \"%s/stage/release/evidence/0.0.99/evidence-rows.tsv\" && "
            "cp -r \"%s/stage/release/.\" \"%s/release/\" && "
            "git add release && git commit -qm stage-a && "
            "printf 'hb\\n' > \"%s/heartbeat.tsv\" && "
            "printf 'cr\\n' > \"%s/chain-run.tsv\" && "
            "printf 'bg\\n' > \"%s/bg.log\" && "
            "printf 'ape\\n' > \"%s/ape-final/unisacc-next.com\" && "
            "printf 'sup\\n' > \"%s/supervise.log\" && "
            "printf 'st\\n' > \"%s/strict-final.tsv\" && "
            "printf 'prep\\trc=0\\n' > \"%s/prep.done\" && "
            "printf 'stage-a\\trc=0\\n' > \"%s/stage-a.done\" && "
            "printf 'stage-dry\\trc=0\\n' > \"%s/stage-dry.done\"",
            brepo, bst, bchain, bpre, brepo, driver,
            bst, bst, bst, bst, brepo,
            bchain, bchain, bchain, bchain, bpre, bpre, bst, bst, bst)) return 2;
        char *bv0[] = {"sh", "-c", bcmd, 0};
        r = actual(bv0); np_free(&r);

        /* 1. Missing required chain artifact (exit.tsv) -> refused rc=2 */
        char *bk_miss[] = {bin, "backup-evidence", "--version", "0.0.99", "--chain-dir", bchain, "--prerun-dir", bpre, "--backup-dir", bdir, "--repo", brepo, 0};
        r = actual(bk_miss);
        ck(r.rc == 2 && r.err && strstr(r.err, "REFUSE BACKUP_EVIDENCE") != 0 && strstr(r.err, "missing-chain-artifact") != 0,
           "backup-evidence-missing-artifact-refused");
        np_free(&r);

        /* Create exit.tsv; 2. Backup directory inside repo -> refused rc=2 */
        char exitf[4500];
        if (cx_fmt(exitf, sizeof exitf, "%s/exit.tsv", bchain) || cx_write(exitf, "rc=0\n", 5)) return 2;
        char *bk_in[] = {bin, "backup-evidence", "--version", "0.0.99", "--chain-dir", bchain, "--prerun-dir", bpre, "--backup-dir", binrepo, "--repo", brepo, 0};
        r = actual(bk_in);
        ck(r.rc == 2 && r.err && strstr(r.err, "REFUSE BACKUP_EVIDENCE") != 0 && strstr(r.err, "backup-inside-repo") != 0,
           "backup-evidence-inside-repo-refused");
        np_free(&r);

        /* 3. release-chain run --from 5 before backup-evidence -> refused before READY_TO_EXECUTE */
        if (cx_fmt(bcmd, sizeof bcmd, "cd \"%s\" && \"%s\" run --inputs \"%s\" --state \"%s\" --layout /nonexistent-layout --from 5",
            brepo, bin, inputs, bst)) return 2;
        r = actual(bv0);
        ck(r.rc == 1 && has(&r, "CHAIN\tFAIL\t5\tbackup-evidence\t") && !has(&r, "READY_TO_EXECUTE"),
           "run-from-5-refuses-missing-backup");
        np_free(&r);

        /* 4. Valid backup-evidence copies all 7 artifacts, writes sha256 manifest, and --verify passes */
        r = actual(bk_miss);
        char *bk_ver[] = {bin, "backup-evidence", "--verify", "--version", "0.0.99", "--repo", brepo, 0};
        np_result rv = actual(bk_ver);
        ck(r.rc == 0 && has(&r, "BACKUP_EVIDENCE\tOK\tversion=0.0.99\tfiles=7\t") &&
           rv.rc == 0 && has(&rv, "BACKUP_VERIFY\tPASS\tversion=0.0.99\tfiles=7\t"),
           "backup-evidence-copies-and-verifies-sha256");
        np_free(&r); np_free(&rv);

        /* 5. release-chain run --from 5 now passes backup gate and reaches READY_TO_EXECUTE */
        r = actual(bv0);
        ck(r.rc == 0 && has(&r, "CHAIN\tPASS\t5\tbackup-evidence\t") && has(&r, "CHAIN\tRESULT\tREADY_TO_EXECUTE\tversion=0.0.99"),
           "run-from-5-passes-with-valid-backup");
        np_free(&r);

        /* 6. Tampering with backed-up file causes --verify and run --from 5 to refuse */
        char tamp[4500];
        if (cx_fmt(tamp, sizeof tamp, "%s/chain/chain-run.tsv", bdir) || cx_write(tamp, "tampered\n", 9)) return 2;
        rv = actual(bk_ver);
        r = actual(bv0);
        ck(rv.rc == 2 && rv.err && strstr(rv.err, "sha256-mismatch") != 0 &&
           r.rc == 1 && has(&r, "CHAIN\tFAIL\t5\tbackup-evidence\t"),
           "backup-verify-tampered-file-refused");
        np_free(&rv); np_free(&r);
        if (sy_remove_all(btest)) return 2;
    }
    /* (5) usage */
    char *bad[] = {bin, "run", "--inputs", inputs, "--layout", "/x", 0};
    r = actual(bad); ck(r.rc == 2 && r.err && strstr(r.err, "REFUSE CHAIN_USAGE"), "missing-state-refused"); np_free(&r);
    char *rel[] = {bin, "run", "--inputs", inputs, "--state", "relative", "--layout", "/x", 0};
    r = actual(rel); ck(r.rc == 2, "relative-state-refused"); np_free(&r);
    if (cx_rmtree(tmp)) return 2;
    printf("CHECK_RELEASE_CHAIN\tpass=%d\tfail=%d\n", passed, failed);
    return failed != 0;
}
