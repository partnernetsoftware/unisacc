/* Checks tools/own-diff.cx: sh ./unisacc.com tools/check-own-diff.cx   (from the repo root)
   On tools/own-diff/base.tsv -> work.tsv with KEY "mine-": the added mine-1 row and both sides of the changed
   mine-2 row are own (3); the added theirs-1 row (+) and the removed theirs-2 row (-) are FOREIGN (2), exit 1.
   With keys "mine-" and "theirs-" nothing is foreign, exit 0.  A file compared with itself has own=0 foreign=0.
   Prints PASS/FAIL lines and CHECK_OWN_DIFF<TAB>failed=N. */
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use sys.time
#pragma unisa use sysx.poll
#pragma unisa use sys.posix

/* an unlinked spool file the drained output of a bounded child goes to */
static int spool_open(void) {
    char t[4096];
    int fd;
    if (cx_fmt(t, sizeof t, "%s/r2b-XXXXXX", sy_tmpdir())) return -1;
    fd = mkstemp(t);
    if (fd >= 0) sy_unlink(t);
    return fd;
}

/* sy_spawn_pipe with a 50 s deadline: the child's stdout (and stderr when EFD is given) is drained here with sy_poll
   into spool files; past the deadline its process group is killed.  OFD/EFD come back as the spool files, rewound,
   and the child is NOT reaped: the caller's sy_wait_status(pid) still reports its real status (128+9 when killed). */
static int spawn_pipe_bounded(char **argv, const char *cwd, int flags, int *ofd, int *efd) {
    int po = -1, pe = -1, pid, fo, fe = -1, open_o = 1, open_e = efd ? 1 : 0, killed = 0;
    long deadline = sy_now_ms() + 50000;
    char chunk[16384];
    pid = sy_spawn_pipe(argv, cwd, flags, &po, efd ? &pe : 0);
    if (pid < 0) return pid;
    fo = spool_open();
    if (efd) fe = spool_open();
    if (fo < 0 || (efd && fe < 0)) { sy_killpg(pid, 9); sy_signal(pid, 9); sy_close(po); if (efd) sy_close(pe); return -EIO; }
    while (open_o || open_e) {
        sy_pollfd_t p[2];
        int n = 0, io = -1, ie = -1, r;
        long left = deadline - sy_now_ms(), g;
        if (left <= 0) {
            if (killed) break;
            sy_killpg(pid, 9); sy_signal(pid, 9); killed = 1; deadline = sy_now_ms() + 2000;
            continue;
        }
        if (open_o) { io = n; p[n].fd = po; p[n].events = SY_POLLIN; p[n].revents = 0; n++; }
        if (open_e) { ie = n; p[n].fd = pe; p[n].events = SY_POLLIN; p[n].revents = 0; n++; }
        r = sy_poll(p, n, left > 200 ? 200 : left);
        if (r < 0) break;
        if (io >= 0 && p[io].revents) {
            g = sy_read(po, chunk, sizeof chunk);
            if (g > 0) { if (sy_write_all(fo, chunk, g)) break; } else open_o = 0;
        }
        if (ie >= 0 && p[ie].revents) {
            g = sy_read(pe, chunk, sizeof chunk);
            if (g > 0) { if (sy_write_all(fe, chunk, g)) break; } else open_e = 0;
        }
    }
    if (open_o || open_e) { sy_killpg(pid, 9); sy_signal(pid, 9); }
    sy_close(po);
    if (efd) sy_close(pe);
    sy_lseek(fo, 0, 0);
    *ofd = fo;
    if (efd) { sy_lseek(fe, 0, 0); *efd = fe; }
    return pid;
}

static int failed;
static void ck(int ok, const char *name) { if (!ok) failed++; printf("%s\town-diff.%s\n", ok ? "PASS" : "FAIL", name); }

static int od(char **args, char *out, long cap) {
    char *argv[12]; int i = 0, k, ofd, pid, ex = 0, code = 0, sig = 0; long n = 0, r; char junk[4096];
    argv[i++] = "sh"; argv[i++] = "./unisacc.com"; argv[i++] = "tools/own-diff.cx"; argv[i++] = "--";
    for (k = 0; args[k] && i < 11; k++) argv[i++] = args[k];
    argv[i] = 0;
    pid = spawn_pipe_bounded(argv, 0, 0, &ofd, 0);
    if (pid < 0) return -1;
    while ((r = sy_read(ofd, out + n, cap - 1 - n)) > 0) n += r;
    out[n] = 0;
    while (sy_read(ofd, junk, sizeof junk) > 0) {}
    sy_close(ofd);
    if (sy_wait_status(pid, 0, &ex, &code, &sig) != pid || !ex) return -1;
    return code;
}
static char o[1 << 16];   /* the captured stdout of the last od() call: the only text has() looks into */
static int has_o(const char *s) { return tx_find(o, tx_len(o, sizeof o), s, tx_len(s, 512)) >= 0; }
#define has(buf, s) has_o(s)

int main(void) {
    char *a1[] = {"--base", "tools/own-diff/base.tsv", "tools/own-diff/work.tsv", "mine-", 0};
    char *a2[] = {"--base", "tools/own-diff/base.tsv", "tools/own-diff/work.tsv", "mine-", "theirs-", 0};
    char *a3[] = {"--base", "tools/own-diff/work.tsv", "tools/own-diff/work.tsv", "mine-", 0};
    int rc = od(a1, o, sizeof o);
    ck(rc == 1 && has(o, "FOREIGN\t+\ttheirs-1\tadded\n") && has(o, "FOREIGN\t-\ttheirs-2\tgone\n") && !has(o, "FOREIGN\t+\tmine") && !has(o, "FOREIGN\t-\tmine")
       && has(o, "OWN_DIFF\town=3\tforeign=2\n"), "foreign-added-and-removed-reported");
    rc = od(a2, o, sizeof o);
    ck(rc == 0 && has(o, "OWN_DIFF\town=5\tforeign=0\n") && !has(o, "FOREIGN"), "all-keys-own");
    rc = od(a3, o, sizeof o);
    ck(rc == 0 && has(o, "OWN_DIFF\town=0\tforeign=0\n"), "no-change");
    {   /* an edited line: the old text lacks the key the new text carries; the old line is own (replaced), and
           --emit keeps only the new one, while another agent's added line stays out */
        char em[200], td[160]; size_t en; char *e;
        if (cx_fmt(td, sizeof td, "%s/check-own-diff-XXXXXX", sy_env_or("TMPDIR", "/tmp")) || !mkdtemp(td) || cx_fmt(em, sizeof em, "%s/e.emit", td)) return 2;
        {   char *a4[] = {"--emit", em, "--base", "tools/own-diff/edit-base.txt", "tools/own-diff/edit-work.txt", "KEY", 0};
            rc = od(a4, o, sizeof o);
        }
        e = cx_read(em, &en);
        ck(rc == 1 && has(o, "OWN_DIFF\town=2\tforeign=1\n") && has(o, "FOREIGN\t+\tother added\n") && !has(o, "FOREIGN\t-")
           && e && tx_same(e, (long)en, "a\nrow-x new text KEY\nz\n", 23), "edited-line-replaces-old-and-emit");
        sy_unlink(em); sy_rmdir(td);
    }
    {   /* --batch LIST: two entries in one process, each judged as its single call (FOREIGN lines, own-only emit), the
           OWN_DIFF line of each carrying its FILE: a tracked file equal to HEAD and an untracked one (empty base) */
        char td[160], lst[200], f2[200], e1[200], e2[200], e3[200], body[900]; size_t n1 = 0, n2 = 0, n3 = 0, wn = 0; char *b1, *b2, *b3, *w;
        if (cx_fmt(td, sizeof td, "%s/check-own-diff-XXXXXX", sy_env_or("TMPDIR", "/tmp")) || !mkdtemp(td) || cx_fmt(lst, sizeof lst, "%s/list", td) ||
            cx_fmt(f2, sizeof f2, "%s/new.tsv", td) || cx_fmt(e1, sizeof e1, "%s/e1", td) || cx_fmt(e2, sizeof e2, "%s/e2", td) || cx_fmt(e3, sizeof e3, "%s/e3", td) ||
            cx_fmt(body, sizeof body, "%s\ttools/own-diff/work.tsv\tmine-\n%s\t%s\tmine-\tzz-\n", e1, e2, f2)) return 2;
        if (cx_write(f2, "mine-1\tx\ntheirs-9\ty\n", 20) || cx_write(lst, body, strlen(body))) return 2;
        {   char *a8[] = {"--emit", e3, "tools/own-diff/work.tsv", "mine-", 0}; rc = od(a8, o, sizeof o); }
        w = cx_read(e3, &wn); sy_unlink(e3);   /* the single call's emit of the tracked file: what the batch entry must equal */
        {   char *a5[] = {"--batch", lst, 0}; rc = od(a5, o, sizeof o); }
        b1 = cx_read(e1, &n1); b2 = cx_read(e2, &n2);
        ck(rc == 1 && has(o, "OWN_DIFF\town=0\tforeign=0\ttools/own-diff/work.tsv\n") && has(o, "FOREIGN\t+\ttheirs-9\ty\nOWN_DIFF\town=1\tforeign=1\t")
           && b1 && w && n1 == wn && tx_same(b1, (long)n1, w, (long)wn) && b2 && tx_same(b2, (long)n2, "mine-1\tx\n", 9), "batch-two-entries-one-process");
        {   char *a6[] = {"--emit", e3, f2, "mine-", "zz-", 0}; rc = od(a6, o, sizeof o); }
        b3 = cx_read(e3, &n3);
        ck(rc == 1 && has(o, "OWN_DIFF\town=1\tforeign=1\n") && b2 && b3 && n2 == n3 && tx_same(b2, (long)n2, b3, (long)n3), "batch-emit-equals-single-call");
        {   char *a7[] = {"--batch", f2, 0}; rc = od(a7, o, sizeof o); }
        ck(rc == 2, "batch-bad-entry-refused");
        sy_unlink(e1); sy_unlink(e2); sy_unlink(e3); sy_unlink(f2); sy_unlink(lst); sy_rmdir(td);
    }
    printf("CHECK_OWN_DIFF\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
