/* Finite 6e73 -> b200 FIFO candidate material check. No installation or release. */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.kernelsha
static char root[4096],origin[4096],source[4096],candidate[4096],generated[4096],oldctx[4096],product[4400];
static np_buf evidence;
static void die(const char *s){fprintf(stderr,"fifo-candidate-check: REFUSE %s\n",s);exit(2);}
static void path(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path-bound");}
static char *readfile(const char *p,size_t *n){struct stat st;if(lstat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>268435456)die(p);char *s=cx_read(p,n);if(!s||*n!=(size_t)st.st_size)die("read-size");return s;}
static void digest(const char *p,char h[65]){size_t n;char *s=readfile(p,&n);if(ks_sha256_hex(s,n,h))die("sha256");free(s);}
static void row(const char *key,const char *value){np_puts(&evidence,key);np_puts(&evidence,"\t");np_puts(&evidence,value);np_puts(&evidence,"\n");}
static void pin(const char *p,const char *expected,const char *label){char h[65];digest(p,h);if(strcmp(h,expected))die(label);row(label,h);}
static void execute(char **v,const char *needle,int budget,const char *label){np_result r;char why[1400];if(np_run(v,root,0,budget,&r,why,sizeof why))die(why);if(r.rc||r.errn||!strstr(r.out,needle)){fprintf(stderr,"child %s rc=%d stderr=%.*s\n",label,r.rc,(int)r.errn,r.err);np_free(&r);die(label);}char h[65];if(ks_sha256_hex(r.out,r.outn,h))die("child-sha");row(label,h);np_free(&r);}
static void embedded(const char *p,const char **body,size_t *bytes,char **owned){size_t n;char *s=readfile(p,&n);if(n<16||memcmp(s+n-16,"UNIPKG1\n",8))die("package-footer");unsigned long long z=0;for(int i=7;i>=0;i--)z=(z<<8)|(unsigned char)s[n-8+i];if(!z||z>n-16)die("package-extent");*body=s+n-16-(size_t)z;*bytes=(size_t)z;*owned=s;}
int main(int argc,char **argv){
 if(argc!=7||!realpath(argv[1],root)||!realpath(argv[2],origin)||!realpath(argv[3],source)||!realpath(argv[4],candidate)||!realpath(argv[5],generated)||!realpath(argv[6],oldctx)||!strcmp(origin,source))die("usage TOOL_ROOT ORIGIN_ROOT SOURCE_ROOT CANDIDATE CURRENT_CONTEXT ORIGIN_CONTEXT");
 np_puts(&evidence,"fifo-candidate-material-check-v1\n");path(product,root,"unisacc.com");
 pin(product,"e955714e766f89e324c76812b02624bf0a6960270507c2feba802a977eacfd0f","executing-bootstrap");
 char baseline[4400],record[4400],helper[4400],delta[4400],compare[4400],jobs[4400];path(baseline,root,"unisacc.com");path(record,root,"unisacc.com.build.json");
 pin(baseline,"e955714e766f89e324c76812b02624bf0a6960270507c2feba802a977eacfd0f","origin-product");
 pin(record,"0fe8abb8b337825fc1b9f927adf668622528cbb10f94bd40f7ae14c11ecb8541","origin-record");
 pin(candidate,"8147f2e72dafeb6a0c367398a3eafff2c1b8c5c555e00eee9018cabf86abd63e","candidate");
 char candidate_record[4400];if(snprintf(candidate_record,sizeof candidate_record,"%s.build.json",candidate)>=(int)sizeof candidate_record)die("candidate-record-path");pin(candidate_record,"c493b97153c6a3f363bc5df2c0bb36e6c85a8f7a5364b259665fd8ed648d1be9","candidate-record");
 const char *a,*b;size_t an,bn;char *aa,*bb;embedded(baseline,&a,&an,&aa);embedded(candidate,&b,&bn,&bb);if(an!=bn||memcmp(a,b,an))die("embedded-package-changed");char ph[65];if(ks_sha256_hex(b,bn,ph)||strcmp(ph,"ff696253808d017b4ac81e353729c918eb5c96a7a78bf375f564baa2e40ef955"))die("package-pin");row("preserved-package",ph);free(aa);free(bb);
 path(helper,source,"out/epoch-context-01/identity-helper");pin(helper,"72c2ddb9a4c7ebee1caa057224f63830b489abf5f99d4d6841d07a14fc820918","identity-helper");
 char *oi[]={helper,origin,0},*si[]={helper,source,0};execute(oi,"6e7375f9aba84aba36c5ccbc5d705a911a1134e4660776ad22345c75b3602250\n",10,"origin-source");execute(si,"b2007a76e3fcb9b852dae5d8e28a058af5081ec6638a269373e01cb5fbfeaf7b\n",10,"candidate-source");
 path(delta,root,"tools/cxpack-source-delta.cx");path(compare,root,"tools/source-model-compare.cx");path(jobs,generated,"context.tsv");pin(jobs,"61d040c692914254eb00d930bb83007bc51d5ced8e4cd1ad1a53cbb585b9ab20","current-context");path(jobs,oldctx,"context.tsv");pin(jobs,"cce326a849ec5d73f3e2e5700bfa6f4c232abb011b0f63b0dec55150f4190623","origin-context");char dh[65],ch[65],after[65];digest(delta,dh);digest(compare,ch);row("delta-tool",dh);row("json-tool",ch);
 char *dv[]={"sh",product,delta,"--",origin,source,"fifo-v1",0};execute(dv,"witness=1f0a90a7ef74c19edfd26b452885844df3eb403f0508ef4e67c1d17914e063c5\n",20,"source-delta-observation");
 /* Source profile verifies all eight model/construction trees byte-for-byte;
  * no generator rerun is claimed for this driver-only change. */
 row("model-reuse-basis","fixed-two-driver-deltas-all-model-trees-identical");
 digest(delta,after);if(strcmp(dh,after))die("delta-tool-changed");digest(compare,after);if(strcmp(ch,after))die("json-tool-changed");
 execute(oi,"6e7375f9aba84aba36c5ccbc5d705a911a1134e4660776ad22345c75b3602250\n",10,"origin-source-after");execute(si,"b2007a76e3fcb9b852dae5d8e28a058af5081ec6638a269373e01cb5fbfeaf7b\n",10,"candidate-source-after");
 pin(product,"e955714e766f89e324c76812b02624bf0a6960270507c2feba802a977eacfd0f","executing-bootstrap-after");pin(record,"0fe8abb8b337825fc1b9f927adf668622528cbb10f94bd40f7ae14c11ecb8541","origin-record-after");
 pin(candidate,"8147f2e72dafeb6a0c367398a3eafff2c1b8c5c555e00eee9018cabf86abd63e","candidate-after");
 pin(candidate_record,"c493b97153c6a3f363bc5df2c0bb36e6c85a8f7a5364b259665fd8ed648d1be9","candidate-record-after");
 if(fwrite(evidence.p,1,evidence.n,stdout)!=evidence.n)die("stdout");free(evidence.p);puts("CHECKED\tfinite-material-applicability\tNOT_INSTALLED_NOT_RELEASE_QUALIFIED");return 0;
}
