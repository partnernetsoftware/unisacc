static char qt_root[4400],qt_fixture[4400],qt_exe[4400],qt_state[4400],qt_temp[4400];static char qt_testmap[4400],qt_material[4400];static int qt_want_fail;static long qt_deadline;static int qt_checks,qt_bad;
static void qt_die(const char*s){fprintf(stderr,"QUEUE_TERMINAL REFUSE %s\n",s);exit(2);}
static void qt_ck(int yes,const char*s){qt_checks++;qt_bad+=!yes;printf("%s\t%s\n",yes?"PASS":"FAIL",s);fflush(stdout);}
static void qt_path(char*p,const char*a,const char*b){if(cx_fmt(p,4400,"%s/%s",a,b))qt_die("path");}
static void qt_put(const char*p,const char*s,size_t n){if(cx_write(p,s,n))qt_die("write");}
static np_result qt_run(char**v){long left=qt_deadline-sy_now_ms();if(left<1000)qt_die("deadline");int cap=(int)(left/1000);if(cap>20)cap=20;np_result r={0};char why[1000];if(np_run(v,qt_root,0,cap,&r,why,sizeof why)||r.residue)qt_die(why);return r;}
static np_result qt_verify(const char*map){const char*selected=!strcmp(map,"-")&&qt_testmap[0]?qt_testmap:map;char*v[]={qt_exe,"--verify-queue",qt_fixture,qt_state,(char*)selected,0};return qt_run(v);}
static void qt_reject(const char*label){np_result r=qt_verify("-");qt_ck(r.rc==2&&r.out&&strstr(r.out,"OSX_LANE_QUEUE_VERIFY\tstatus=UNKNOWN")&&!strstr(r.out,"status=LOCAL_PASS"),label);np_free(&r);}
static char*qt_readfile(const char*p,size_t*n){char*s=cx_read(p,n);if(!s)qt_die("read");return s;}
int queue_terminal_check(int argc,char**argv){qt_want_fail=argc==5&&!strcmp(argv[4],"--fail");if((argc!=4&&!qt_want_fail)||!realpath(argv[1],qt_root)||!realpath(argv[2],qt_exe))qt_die("ROOT EXE ARCHIVE");qt_deadline=sy_now_ms()+50000;char pattern[]="/tmp/queue-terminal-XXXXXX";if(!mkdtemp(pattern)||!realpath(pattern,qt_temp))qt_die("temp");qt_path(qt_fixture,qt_temp,"root");if(mkdir(qt_fixture,0700))qt_die("root");char*tar[]={"tar","-xf",argv[3],"-C",qt_fixture,0};np_result r=qt_run(tar);if(r.rc)qt_die("archive");np_free(&r);char p[4400],q[4400],fixture_out[4400];qt_path(p,qt_root,"unisacc.com");qt_path(q,qt_fixture,"unisacc.com");size_t n;char*b=qt_readfile(p,&n);qt_put(q,b,n);free(b);if(chmod(q,0700))qt_die("bootstrap");qt_path(fixture_out,qt_fixture,"out");if(mkdir(fixture_out,0700))qt_die("out");qt_path(p,qt_fixture,"tests/tiny.cx");const char*tiny=qt_want_fail?"int main(void){puts(\"TINY\");return 1;}\n":"int main(void){puts(\"TINY\");return 0;}\n";qt_put(p,tiny,strlen(tiny));qt_path(p,qt_fixture,"tests/batches.tsv");const char*batch="id\timplementation\tlayer\tsource\tmode\tplatform\tbudget_seconds\tmaterials\tentry\targs\tcoverage\texpect\theaders\ttier\ntiny-queue\tIMPLEMENTED\tinterfaces\ttests/tiny.cx\tSOURCE\tosx/arm64\t5\tprune-models:path\ttests/tiny.cx\t-\tfixture.one\trc0:TINY\tproduct\tdaily\n";qt_put(p,batch,strlen(batch));qt_path(p,qt_fixture,"tests/coverage.tsv");const char*cov="id\tlayer\timplementation\texpected_or_gap\tsource\nfixture.one\tinterfaces\tIMPLEMENTED_SEPARATE_BATCH\tindependent queue terminal fixture\ttests/tiny.cx\n";qt_put(p,cov,strlen(cov));qt_path(qt_material,qt_temp,"material");if(mkdir(qt_material,0700))qt_die("material");qt_path(p,qt_material,"blob");qt_put(p,"before\n",7);qt_path(qt_testmap,fixture_out,"map.tsv");char binding[4500];if(cx_fmt(binding,sizeof binding,"prune-models\t%s\n",qt_material))qt_die("binding");qt_put(qt_testmap,binding,strlen(binding));qt_path(qt_state,fixture_out,"q");r=qt_verify("-");qt_ck(r.rc==2&&r.out&&strstr(r.out,"status=UNKNOWN"),"missing STATE stays UNKNOWN without initialization");np_free(&r);struct stat st;errno=0;qt_ck(lstat(qt_state,&st)&&errno==ENOENT,"read-only verify creates no STATE");
int terminal=-1;for(int tick=0;tick<12;tick++){char*v[]={qt_exe,"--step",qt_fixture,qt_state,qt_testmap,0};r=qt_run(v);printf("TICK\t%d\trc=%d\n%s%s",tick,r.rc,r.out?r.out:"",r.err?r.err:"");fflush(stdout);if(!tick)qt_ck(r.rc==3&&r.out&&strstr(r.out,"phase=PREPARED")&&!strstr(r.out,"LOCAL_PASS"),"initialization remains PREPARED");if(r.rc!=3){terminal=r.rc;np_free(&r);break;}np_free(&r);if(tick==1)qt_reject("partial identity STATE cannot verify LOCAL_PASS");}qt_ck(terminal==(qt_want_fail?1:0),"independent one-job queue reaches expected complete outcome");r=qt_verify("-");qt_ck(r.rc==(qt_want_fail?1:0)&&r.out&&strstr(r.out,qt_want_fail?"OSX_LANE_QUEUE_VERIFY\tstatus=FAIL":"OSX_LANE_QUEUE_VERIFY\tstatus=LOCAL_PASS")&&strstr(r.out,"selected=1\texecuted=1"),"read-only final verification recomputes complete one-job receipt");np_free(&r);
qt_path(p,qt_state,"job-tiny-queue.stdout");b=qt_readfile(p,&n);qt_put(p,"FAKE\n",5);qt_reject("raw stdout corruption refuses despite old success marker");qt_put(p,b,n);free(b);qt_path(p,qt_state,"queue-result.tsv");b=qt_readfile(p,&n);qt_put(p,"status\tLOCAL_PASS\n",18);qt_reject("marker-only final receipt refuses");qt_put(p,b,n);free(b);qt_path(p,qt_fixture,"tests/tiny.cx");qt_put(p,"int main(void){return 9;}\n",26);qt_reject("changed harness identity refuses");qt_put(p,tiny,strlen(tiny));qt_path(p,qt_material,"blob");qt_put(p,"after\n",6);qt_reject("changed material content refuses despite stable MAP");qt_put(p,"before\n",7);qt_path(p,fixture_out,"changed-map.tsv");qt_put(p,"# changed\n",10);r=qt_verify(p);qt_ck(r.rc==2&&r.out&&strstr(r.out,"status=UNKNOWN"),"changed explicit MAP refuses");np_free(&r);
int fd=open(qt_state,O_RDONLY|O_DIRECTORY|O_CLOEXEC);if(fd<0||sy_flock(fd,2))qt_die("lock");qt_reject("concurrent directory lock refuses read-only verifier");close(fd);printf("QUEUE_RECHECK_INPUT\troot=%s\texe=%s\tfixture=%s\tstate=%s\tmap=%s\texpected=%d\n",qt_root,qt_exe,qt_fixture,qt_state,qt_testmap,qt_want_fail?1:0);printf("QUEUE_TERMINAL_CHECK\tchecks=%d\tfailed=%d\tretained=%s\n",qt_checks,qt_bad,qt_temp);return qt_bad?1:0;}

static int queue_recheck(int argc,char**argv){if(argc!=7||!realpath(argv[1],qt_root)||!realpath(argv[2],qt_exe)||!realpath(argv[3],qt_fixture)||!realpath(argv[4],qt_state)||!realpath(argv[5],qt_testmap)||(strcmp(argv[6],"0")&&strcmp(argv[6],"1")))return 2;qt_deadline=sy_now_ms()+45000;int expected=argv[6][0]-'0';np_result r=qt_verify("-");qt_ck(r.rc==expected&&r.out&&strstr(r.out,expected?"OSX_LANE_QUEUE_VERIFY\tstatus=FAIL":"OSX_LANE_QUEUE_VERIFY\tstatus=LOCAL_PASS")&&!strstr(r.out,"receipt_sha=-"),"restored actual receipts and released lock verify again");if(r.out)fwrite(r.out,1,r.outn,stdout);if(r.err)fwrite(r.err,1,r.errn,stderr);np_free(&r);printf("QUEUE_RECHECK_CHECK\tchecks=%d\tfailed=%d\n",qt_checks,qt_bad);return qt_bad?1:0;}

int main(int argc,char **argv){if(argc>1&&!strcmp(argv[1],"--queue-recheck"))return queue_recheck(argc-1,argv+1);if(argc>1&&!strcmp(argv[1],"--queue-terminal"))return queue_terminal_check(argc-1,argv+1);if(argc>1&&!strcmp(argv[1],"--queue"))return queue_check(argc-1,argv+1);if(argc>1&&!strcmp(argv[1],"--scheduler"))return scheduler_check(argc-1,argv+1);if(argc>2)return 2;if(!realpath(argc==2?argv[1]:".",root))die("root");deadline=sy_now_ms()+45000;char tmp[]="/tmp/osx-lane-check-XXXXXX";if(!mkdtemp(tmp)||!realpath(tmp,base))die("physical temp");char p[4400],q[4400],com[4400],source[4400];path(exe,sizeof exe,base,"osx-lane");path(com,sizeof com,root,"unisacc.com");path(source,sizeof source,root,"tools/osx-lane.cx");char *build[]={"sh",com,"-o",exe,source,0};np_result r=run(build,30);ck(!r.rc,"compile current osx lane once");if(r.rc){if(r.errn)fwrite(r.err,1,r.errn,stderr);die("compile");}np_free(&r);path(fx,sizeof fx,base,"fixture");if(mkdir(fx,0700))die("fixture");path(p,sizeof p,fx,"tests");if(mkdir(p,0700))die("tests");path(p,sizeof p,fx,"tests/tiny.cx");put(p,"int main(void){puts(\"TINY\");return 0;}\n");path(p,sizeof p,fx,"tests/coverage.tsv");put(p,"id\tlayer\timplementation\texpected_or_gap\tsource\nfixture.one\tinterfaces\tIMPLEMENTED_SEPARATE_BATCH\tindependent metadata fixture only\ttests/tiny.cx\n");registry(0);char *v[]={exe,"inventory",fx,0};r=run(v,8);ck(!r.rc&&r.out&&strstr(r.out,"metadata_valid=1\tosx_rows=2\tselected=3\texecuted=0"),"both Mac platforms plus smoke selected dynamically");ck(r.out&&strstr(r.out,"SELECT\tmac-arm\t")&&strstr(r.out,"SELECT\tmac-x64\t"),"two distinct Mac rows retained");ck(r.out&&!strstr(r.out,"SELECT\tlinux-control\t"),"Linux control excluded");ck(r.out&&strstr(r.out,"qualification=NOT_EXECUTED")&&!strstr(r.out,"LOCAL_PASS"),"inventory never claims execution PASS");np_free(&r);v[1]="--inventory";expect(v,0,"osx_rows=2","inventory alias");v[1]="inventory";registry(1);expect(v,2,"no osx platform rows","empty osx set refuses despite smoke");registry(2);expect(v,2,"material","bad typed material schema rejected");registry(0);path(p,sizeof p,fx,"tests/batches.tsv");put(p,"bad\n");expect(v,2,"table-header","bad table header rejected");registry(0);path(p,sizeof p,base,"absent");v[2]=p;expect(v,2,"canonical ROOT","missing root rejected");path(q,sizeof q,base,"root-file");put(q,"file\n");v[2]=q;expect(v,2,"file","regular file ROOT rejected");v[2]=fx;char *none[]={exe,0};expect(none,2,"usage","missing arguments rejected");char *shortv[]={exe,"inventory",0};expect(shortv,2,"usage","missing ROOT rejected");char *extra[]={exe,"inventory",fx,"extra",0};expect(extra,2,"argument count","extra arguments rejected");printf("OSX_LANE_CHECK\tchecks=%d\tfailed=%d\tscope=independent-metadata-fixture-not-osx-full-run\tretained=%s\n",count,bad,base);return bad?1:0;}
