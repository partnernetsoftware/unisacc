/* Independent metadata fixtures only; this never runs the repository macOS lane. */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.time
static char root[4400],base[4400],fx[4400],exe[4400];static int count,bad;static long deadline;
static void die(const char *s){fprintf(stderr,"check-osx-lane: %s\n",s);exit(2);}
static void path(char *p,size_t cap,const char *a,const char *b){if(cx_fmt(p,cap,"%s/%s",a,b))die("path");}
static void put(const char *p,const char *s){if(cx_write(p,s,strlen(s)))die("write");}
static void ck(int yes,const char *label){count++;bad+=!yes;printf("%s\t%s\n",yes?"PASS":"FAIL",label);}
static np_result run(char **v,int seconds){long left=deadline-sy_now_ms();if(left<1500)die("overall deadline");if(seconds>left/1000)seconds=(int)(left/1000);np_result r={0};char why[1000]={0};if(np_run(v,root,0,seconds,&r,why,sizeof why)||r.residue){fprintf(stderr,"%s\n",why);die("bounded fixture child");}return r;}
static void expect(char **v,int rc,const char *needle,const char *label){np_result r=run(v,8);int yes=r.rc==rc&&((r.out&&strstr(r.out,needle))||(r.err&&strstr(r.err,needle)));ck(yes,label);if(!yes){fprintf(stderr,"rc=%d expected=%d\n%s%s",r.rc,rc,r.out?r.out:"",r.err?r.err:"");}np_free(&r);}
static const char *header="id\timplementation\tlayer\tsource\tmode\tplatform\tbudget_seconds\tmaterials\tentry\targs\tcoverage\texpect\theaders\ttier\n";
static void registry(int mode){char p[4400];np_buf b={0};np_puts(&b,header);const char *ids[]={"mac-arm","mac-x64","linux-control","smoke"};const char *platforms[]={"osx/arm64","osx/x86_64","lnx/x86_64","lnx/x86_64"};for(int i=0;i<4;i++){char row[1000];const char *platform=mode==1?"lnx/x86_64":platforms[i];if(cx_fmt(row,sizeof row,"%s\tIMPLEMENTED\tinterfaces\ttests/tiny.cx\tSOURCE\t%s\t5\t%s\ttests/tiny.cx\t-\tfixture.one\trc0:TINY\tproduct\tdaily\n",ids[i],platform,mode==2&&i==0?"key:unknown":"-"))die("row bound");np_puts(&b,row);}path(p,sizeof p,fx,"tests/batches.tsv");if(cx_write(p,b.p,b.n))die("registry");free(b.p);}
int main(int argc,char **argv){if(argc>2)return 2;if(!realpath(argc==2?argv[1]:".",root))die("root");deadline=sy_now_ms()+45000;char tmp[]="/tmp/osx-lane-check-XXXXXX";if(!mkdtemp(tmp)||!realpath(tmp,base))die("physical temp");char p[4400],q[4400],com[4400],source[4400];path(exe,sizeof exe,base,"osx-lane");path(com,sizeof com,root,"unisacc.com");path(source,sizeof source,root,"tools/osx-lane.cx");char *build[]={"sh",com,"-o",exe,source,0};np_result r=run(build,30);ck(!r.rc,"compile current osx lane once");if(r.rc){if(r.errn)fwrite(r.err,1,r.errn,stderr);die("compile");}np_free(&r);path(fx,sizeof fx,base,"fixture");if(mkdir(fx,0700))die("fixture");path(p,sizeof p,fx,"tests");if(mkdir(p,0700))die("tests");path(p,sizeof p,fx,"tests/tiny.cx");put(p,"int main(void){puts(\"TINY\");return 0;}\n");path(p,sizeof p,fx,"tests/coverage.tsv");put(p,"id\tlayer\timplementation\texpected_or_gap\tsource\nfixture.one\tinterfaces\tIMPLEMENTED_SEPARATE_BATCH\tindependent metadata fixture only\ttests/tiny.cx\n");registry(0);char *v[]={exe,"inventory",fx,0};r=run(v,8);ck(!r.rc&&r.out&&strstr(r.out,"metadata_valid=1\tosx_rows=2\tselected=3\texecuted=0"),"both Mac platforms plus smoke selected dynamically");ck(r.out&&strstr(r.out,"SELECT\tmac-arm\t")&&strstr(r.out,"SELECT\tmac-x64\t"),"two distinct Mac rows retained");ck(r.out&&!strstr(r.out,"SELECT\tlinux-control\t"),"Linux control excluded");ck(r.out&&strstr(r.out,"qualification=NOT_EXECUTED")&&!strstr(r.out,"LOCAL_PASS"),"inventory never claims execution PASS");np_free(&r);v[1]="--inventory";expect(v,0,"osx_rows=2","inventory alias");v[1]="inventory";registry(1);expect(v,2,"no osx platform rows","empty osx set refuses despite smoke");registry(2);expect(v,2,"material","bad typed material schema rejected");registry(0);path(p,sizeof p,fx,"tests/batches.tsv");put(p,"bad\n");expect(v,2,"table-header","bad table header rejected");registry(0);path(p,sizeof p,base,"absent");v[2]=p;expect(v,2,"canonical ROOT","missing root rejected");path(q,sizeof q,base,"root-file");put(q,"file\n");v[2]=q;expect(v,2,"file","regular file ROOT rejected");v[2]=fx;char *none[]={exe,0};expect(none,2,"usage","missing arguments rejected");char *shortv[]={exe,"inventory",0};expect(shortv,2,"usage","missing ROOT rejected");char *extra[]={exe,"inventory",fx,"extra",0};expect(extra,2,"argument count","extra arguments rejected");printf("OSX_LANE_CHECK\tchecks=%d\tfailed=%d\tscope=independent-metadata-fixture-not-osx-full-run\tretained=%s\n",count,bad,base);return bad?1:0;}
