/* tools/check-m1-g1-crc.cx -- offline red-first G1 gate check for cx/driver/stream_s1_m1.cx
 * (m53_m1_extract_tape):
 *   - B1: coexisting non-tape P4 codec=0 crc=0 record (e.g. include/cx-flat.h) still accepted;
 *   - T1a (M1a): crc^1 header-only tamper on k=0,1,2 refused with embed-pkg-decode-failed detail=k;
 *   - B2 data-byte flip: flipping 1 payload byte while keeping header crc refused with detail=k;
 *   - B2 codec=1: tape record with codec=1 refused with detail=20+k;
 *   - B2 ver<4: P3 downgrade package refused with detail=10;
 *   - B2 len==0: empty tape record (len=0, rawlen=0, crc=0) refused with detail=30+k;
 *   - B2 oversize: manifest.tsv > 65536 refused with detail=30.
 * Marker: CHECK_M1_G1_CRC. */
#pragma unisa use driver.stream_s1_m1
#pragma unisa use runtime.codec
#pragma unisa use runtime.model_number
#pragma unisa use compiler.bindstage
#pragma unisa use runtime.routestep
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

static int failed;
static void ck(int ok, const char *name) {
    if (!ok) { fprintf(stderr, "FAIL\t%s\n", name); failed++; }
    else printf("PASS\t%s\n", name);
}

static unsigned calc_crc(const char *p, int n) {
    CxCodecCrc c;
    uint32_t out = 0;
    if (cxcodec_crc_init(&c) || cxcodec_crc(&c, p, n, &out)) return 0;
    return out;
}

static long build_pkg(char *buf, long cap, int ver, int with_nontape_crc0,
                      int bad_crc_k, int flip_data_k, int codec1_k, int empty_k) {
    static const char *names[3] = {
        "tape/lnx-x86_64/manifest.tsv",
        "tape/lnx-x86_64/tapemode.so",
        "tape/lnx-x86_64/m53.tapeslice"
    };
    static const char *vals[3] = {
        "tapemode.so\t0000\t17\n",
        "ELF-tapemode-body",
        "UTAPEBIN-m53-body"
    };
    int nr = 3 + (with_nontape_crc0 ? 1 : 0);
    long pos = 0;
    if (ver >= 4) (void)cx_fmt(buf, (size_t)cap, "P 4 1 1 %d\nD r s in out 0\nM 1 1 1 0\nA", nr);
    else (void)cx_fmt(buf, (size_t)cap, "P 3 1 1 %d\nD r s in out 0\nM 1 1 1 0\nA", nr);
    pos = tx_len(buf, cap);
    if (with_nontape_crc0) {
        const char *nk = "include/cx-flat.h", *nv = "/* raw crc=0 */";
        int nl = (int)tx_len(nk, 64), vl = (int)tx_len(nv, 64);
        if (ver >= 4) (void)cx_fmt(buf + pos, (size_t)(cap - pos), "F %d %d %d 0 0\n%s%s", nl, vl, vl, nk, nv);
        else (void)cx_fmt(buf + pos, (size_t)(cap - pos), "F %d %d\n%s%s", nl, vl, nk, nv);
        pos += tx_len(buf + pos, cap - pos);
    }
    for (int k = 0; k < 3; k++) {
        int nl = (int)tx_len(names[k], 64);
        int vl = (empty_k == k) ? 0 : (int)tx_len(vals[k], 64);
        int codec = (codec1_k == k) ? 1 : 0;
        unsigned c = (vl > 0) ? calc_crc(vals[k], vl) : 0U;
        if (bad_crc_k == k) c ^= 1U;
        if (ver >= 4) (void)cx_fmt(buf + pos, (size_t)(cap - pos), "F %d %d %d %d %u\n%s", nl, vl, vl, codec, c, names[k]);
        else (void)cx_fmt(buf + pos, (size_t)(cap - pos), "F %d %d\n%s", nl, vl, names[k]);
        pos += tx_len(buf + pos, cap - pos);
        if (vl > 0) {
            mm_copy(buf + pos, cap - pos, vals[k], vl);
            if (flip_data_k == k) buf[pos] ^= 1;
            pos += vl;
        }
    }
    return pos;
}

int main(void) {
    char *buf = (char *)mm_alloc(131072);
    const unsigned char *tp[3];
    long tn[3];
    const char *why = 0;
    int det = -1, rc;
    if (!buf) return 2;

    /* (1) Positive control + B1 coexistence: valid 3 tape records + non-tape codec=0 crc=0 record */
    {
        long n = build_pkg(buf, 131072, 4, 1, -1, -1, -1, -1);
        rc = m53_m1_extract_tape((const unsigned char *)buf, n, tp, tn, &why, &det);
        ck(rc == 0 && tp[0] && tp[1] && tp[2] && tn[0] > 0 && tn[1] == 17 && tn[2] == 17,
           "B1-clean-p4-with-nontape-crc0-passes");
    }

    /* (2) T1a (M1a): crc^1 header-only tamper on each tape record k=0,1,2 */
    for (int k = 0; k < 3; k++) {
        char lbl[64];
        long n = build_pkg(buf, 131072, 4, 1, k, -1, -1, -1);
        rc = m53_m1_extract_tape((const unsigned char *)buf, n, tp, tn, &why, &det);
        (void)cx_fmt(lbl, sizeof lbl, "T1a-M1a-crc-only-tamper-k%d", k);
        ck(rc != 0 && why && tx_eqz(why, "embed-pkg-decode-failed") && det == k, lbl);
    }

    /* (3) B2: 1-byte data flip with unchanged header CRC on each tape record k=0,1,2 */
    for (int k = 0; k < 3; k++) {
        char lbl[64];
        long n = build_pkg(buf, 131072, 4, 1, -1, k, -1, -1);
        rc = m53_m1_extract_tape((const unsigned char *)buf, n, tp, tn, &why, &det);
        (void)cx_fmt(lbl, sizeof lbl, "B2-M1a-data-byte-flip-k%d", k);
        ck(rc != 0 && why && tx_eqz(why, "embed-pkg-decode-failed") && det == k, lbl);
    }

    /* (4) B2: codec=1 bypass refused */
    {
        long n = build_pkg(buf, 131072, 4, 0, -1, -1, 1, -1);
        rc = m53_m1_extract_tape((const unsigned char *)buf, n, tp, tn, &why, &det);
        ck(rc != 0 && why && tx_eqz(why, "embed-pkg-decode-failed") && det == 21, "B2-codec1-refused");
    }

    /* (5) B2: ver<4 (P3 downgrade) refused */
    {
        long n = build_pkg(buf, 131072, 3, 0, -1, -1, -1, -1);
        rc = m53_m1_extract_tape((const unsigned char *)buf, n, tp, tn, &why, &det);
        ck(rc != 0 && why && tx_eqz(why, "embed-pkg-decode-failed") && det == 10, "B2-ver3-downgrade-refused");
    }

    /* (6) B2: len==0 empty tape record refused */
    {
        long n = build_pkg(buf, 131072, 4, 0, -1, -1, -1, 2);
        rc = m53_m1_extract_tape((const unsigned char *)buf, n, tp, tn, &why, &det);
        ck(rc != 0 && why && tx_eqz(why, "embed-pkg-decode-failed") && det == 32, "B2-len0-empty-refused");
    }

    /* (7) B2: oversize manifest.tsv (> 65536) refused */
    {
        const long big = 65537;
        char *bigv = (char *)mm_alloc(big);
        if (!bigv) return 2;
        mm_fill(bigv, big, 'x', big);
        unsigned c = calc_crc(bigv, (int)big);
        long pos = 0;
        (void)cx_fmt(buf, 131072, "P 4 1 1 3\nD r s in out 0\nM 1 1 1 0\nAF 28 %ld %ld 0 %u\ntape/lnx-x86_64/manifest.tsv", big, big, c);
        pos = tx_len(buf, 131072);
        mm_copy(buf + pos, 131072 - pos, bigv, big);
        pos += big;
        mm_free(bigv);
        const char *v1 = "ELF-tapemode-body", *v2 = "UTAPEBIN-m53-body";
        (void)cx_fmt(buf + pos, (size_t)(131072 - pos), "F 27 17 17 0 %u\ntape/lnx-x86_64/tapemode.so%sF 29 17 17 0 %u\ntape/lnx-x86_64/m53.tapeslice%s",
                     calc_crc(v1, 17), v1, calc_crc(v2, 17), v2);
        pos += tx_len(buf + pos, 131072 - pos);
        rc = m53_m1_extract_tape((const unsigned char *)buf, pos, tp, tn, &why, &det);
        ck(rc != 0 && why && tx_eqz(why, "embed-pkg-decode-failed") && det == 30, "B2-oversize-manifest-refused");
    }

    mm_free(buf);
    printf("CHECK_M1_G1_CRC\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
