/* tools/check-preflight.cx -- tools/preflight.cx against positive and negative fixtures of every rule.
 *
 *   sh ./unisacc.com tools/check-preflight.cx        (from the repo root)
 *
 * Builds fixtures under sy_tmpdir()/check-preflight-PID from the positive/negative example columns of
 * build/preflight-rules.tsv and runs the real tool:
 *   neg   every one of the eleven rules must FAIL (stale outer/host-libz, a chain-step.cx that copies
 *         unisacc.com.dev unconditionally, APE-only root without the build record, non-canonical record,
 *         receipt commit != rev without BOOTSTRAP_FROM, a release-build.cx lacking both texts, a 0600
 *         constructor, a P4 package without the embedded headers, UNISACC_CTOR unset) and the exit is 1
 *   pos   rows 1-4 and 6-11 must PASS on a fixture root with a clean BUILD and an exact snap
 *   boot  ROOT is this checkout: row 5 (the production canonical-record consumer on the installed
 *         record) and row 6 under BOOTSTRAP_FROM=HEAD~1 with receipt commit HEAD~1 must PASS
 *   hook  PHASE=post-p3 runs row 10 only; PHASE=post-p3 without PKG is a "var PKG" FAIL; --strict turns
 *         a SKIP into exit 1 while the same run without --strict exits 0; an unknown PHASE exits 2
 * Prints PASS/FAIL per assertion and CHECK_PREFLIGHT<TAB>failed=N; exit 0 only when failed=0. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use text.text
#pragma unisa use text.deflate
#pragma unisa use sys.env
#pragma unisa use cxlib.netpack
#pragma unisa use mem.bytes
#pragma unisa use mem.heap

static int failed;
static char root[4096], work[4400], out[32768];
static int g_plain_hdr_key, g_corrupt_hdr_deflate;

static void die(const char *s) { fprintf(stderr, "check-preflight: %s\n", s); exit(2); }
static void ck(int ok, const char *name) { printf("%s\tcheck-preflight.%s\n", ok ? "PASS" : "FAIL", name); if (!ok) failed++; }

static unsigned cp_crc32(const char *p, long n) {
    unsigned c = 4294967295U;
    for (long i = 0; i < n; i++) {
        c ^= (unsigned)((unsigned char)p[i]);
        for (int j = 0; j < 8; j++) c = (c & 1U) ? ((c >> 1) ^ 3988292384U) : (c >> 1);
    }
    return c ^ 4294967295U;
}

static void write_p4_records(const char *rel, int nr, const char **keys, const char **vals,
                             const int *codecs, const unsigned *crc_xor, const char *prefix_sh) {
    char d[4400], body[16384], full[20480], hdr[128], rhdr[128];
    if (cx_fmt(d, sizeof d, "%s/%s", work, rel)) die("path");
    if (cx_fmt(hdr, sizeof hdr, "P 4 1 1 %d\nD r s in out 0\nM 1 1 1 0\nA", nr)) die("p4 header");
    long pos = (long)strlen(hdr);
    if (mm_copy(body, (long)sizeof body, hdr, pos)) die("p4 header copy");
    for (int i = 0; i < nr; i++) {
        int is_hdr = !strncmp(keys[i], "hdr/", 4);
        int use_nul = is_hdr && !g_plain_hdr_key;
        long kl = (long)strlen(keys[i]) + (use_nul ? 1L : 0L);
        long rawl = (long)strlen(vals[i]);
        int cd = codecs ? codecs[i] : (is_hdr ? 1 : 0);
        unsigned crc = cp_crc32(vals[i], rawl) ^ (crc_xor ? crc_xor[i] : 0U);
        unsigned char *comp = 0;
        const char *pay = vals[i];
        long vl = rawl;
        if (cd == 1) {
            if (g_corrupt_hdr_deflate) {
                static const char bad_def[6] = {0x7f, 0x7f, 0x7f, 0x7f, 0x7f, 0x7f};
                pay = bad_def;
                vl = (long)sizeof bad_def;
            } else {
                long cap = dz_bound(rawl);
                comp = (unsigned char *)mm_alloc(cap);
                if (!comp) die("deflate alloc");
                vl = dz_deflate((const unsigned char *)vals[i], rawl, comp, cap);
                if (vl <= 0) die("deflate");
                pay = (const char *)comp;
            }
        }
        if (cx_fmt(rhdr, sizeof rhdr, "F %ld %ld %ld %d %u\n", kl, vl, rawl, cd, crc)) die("p4 rec");
        long rl = (long)strlen(rhdr);
        if (pos + rl + kl + vl >= (long)sizeof body) die("p4 rec bound");
        if (mm_copy(body + pos, (long)sizeof body - pos, rhdr, rl)) die("p4 rec hdr copy");
        pos += rl;
        if (use_nul) {
            body[pos++] = 0;
            if (mm_copy(body + pos, (long)sizeof body - pos, keys[i], kl - 1)) die("p4 rec key0 copy");
            pos += kl - 1;
        } else {
            if (mm_copy(body + pos, (long)sizeof body - pos, keys[i], kl)) die("p4 rec key copy");
            pos += kl;
        }
        if (mm_copy(body + pos, (long)sizeof body - pos, pay, vl)) die("p4 rec val copy");
        pos += vl;
        if (comp) mm_free(comp);
    }
    if (prefix_sh && prefix_sh[0]) {
        long sl = (long)strlen(prefix_sh);
        if ((size_t)(sl + pos + 16) >= sizeof full) die("p4 ape full");
        if (mm_copy(full, (long)sizeof full, prefix_sh, sl) ||
            mm_copy(full + sl, (long)sizeof full - sl, body, pos) ||
            mm_copy(full + sl + pos, 16, "UNIPKG1\n", 8)) die("p4 ape copy");
        unsigned long plen = (unsigned long)pos;
        for (int k = 0; k < 8; k++) full[sl + pos + 8 + k] = (char)((plen >> (k * 8)) & 255UL);
        if (cx_write(d, full, (size_t)(sl + pos + 16)) || sy_chmod(d, 0755)) die(d);
    } else {
        if (cx_write(d, body, (size_t)pos) || sy_chmod(d, 0644)) die(d);
    }
}

static void p(char *dst, const char *rel) { if (cx_fmt(dst, 4400, "%s/%s", work, rel)) die("path"); }
static void mk(const char *rel) { char d[4400]; p(d, rel); if (sy_mkdir(d, 0700)) die(d); }
static void put(const char *rel, const char *s, int mode) {
    char d[4400]; p(d, rel);
    if (cx_write(d, s, strlen(s)) || sy_chmod(d, mode)) die(d);
}

static void git_rev(const char *spec, char c[41]) {
    np_result r = {0}; char why[512] = {0};
    char *av[] = {"git", "rev-parse", (char *)spec, 0};
    if (np_run(av, root, 0, 20, &r, why, sizeof why) || r.rc || r.outn < 40) die("git rev-parse");
    if (mm_copy(c, 41, r.out, 40)) die("copy"); c[40] = 0;
    np_free(&r);
}

/* Status word ("PASS"/"FAIL"/"SKIP") printed for rule ROW in the last run, or 0. */
static int row_is(int row, const char *word) {
    char want[32];
    const char *q = out;
    if (cx_fmt(want, sizeof want, "%s\t%d\t", word, row)) die("fmt");
    for (;;) {
        if (!strncmp(q, want, strlen(want))) return 1;
        q = strchr(q, '\n');
        if (!q) return 0;
        q++;
    }
}

/* CTOR non-null sets UNISACC_CTOR for row 11; otherwise it is removed so the parent's
   environment cannot make the negative run pass. S null omits SNAP=, PKG 0 omits PKG=;
   X1/X2 are extra arguments (PHASE=, --strict). Each run has its own 50s bound. */
static int run(const char *boot, const char *ctor, const char *r, const char *b, const char *s, const char *rev,
               int pkg, const char *x1, const char *x2) {
    char ra[4500], ba[4500], sa[4500], va[64], ea[80], pa[4500], ca[4500];
    np_result res = {0}; char why[512] = {0};
    int k = 0, rc = -1;
    long n;
    char *av[24];
    cx_fmt(ra, sizeof ra, "ROOT=%s", r); cx_fmt(ba, sizeof ba, "BUILD=%s", b);
    cx_fmt(va, sizeof va, "REV=%s", rev);
    av[k++] = "env"; av[k++] = "-u"; av[k++] = "UNISACC_CTOR";
    if (boot) { cx_fmt(ea, sizeof ea, "BOOTSTRAP_FROM=%s", boot); av[k++] = ea; }
    if (ctor) { cx_fmt(ca, sizeof ca, "UNISACC_CTOR=%s", ctor); av[k++] = ca; }
    av[k++] = "sh"; av[k++] = "./unisacc.com"; /* lint:allow R1-product 本检查的目的就是用已装产品实跑 tools/preflight.cx,产品路径是其合同而非第二真值源 */
    av[k++] = "tools/preflight.cx"; av[k++] = "--";
    av[k++] = "build/preflight-rules.tsv"; av[k++] = ra; av[k++] = ba; av[k++] = va;
    if (s) { cx_fmt(sa, sizeof sa, "SNAP=%s", s); av[k++] = sa; }
    if (pkg) { cx_fmt(pa, sizeof pa, "PKG=%s/compiler.p4.pkg", r); av[k++] = pa; }
    if (x1) av[k++] = (char *)x1;
    if (x2) av[k++] = (char *)x2;
    av[k] = 0;
    out[0] = 0;
    if (np_run(av, root, 0, 50, &res, why, sizeof why) == 0) {
        n = (long)res.outn; if (n > (long)sizeof out - 1) n = sizeof out - 1;
        if (n > 0 && mm_copy(out, (long)sizeof out, res.out, n)) die("copy");
        out[n] = 0;
        rc = res.rc;
    }
    np_free(&res);
    return rc;
}

int main(void) {
    char head[41], prev[41], json[512], d1[4400], d2[4400], d3[4400];
    int rc, row;
    if (sy_cwd(root, sizeof root) < 0) die("cwd");
    if (cx_fmt(work, sizeof work, "%s/check-preflight-%d", sy_tmpdir(), (int)getpid())) die("work");
    if (sy_exists(work) == 1 && cx_rmtree(work)) die("old work");
    if (sy_mkdir(work, 0700)) die("work mkdir");
    git_rev("HEAD", head);
    git_rev("HEAD~1", prev);

    /* negative fixtures */
    mk("nroot"); mk("nroot/tools"); mk("nbuild"); mk("nbuild/outer"); mk("nbuild/host-libz"); mk("nsnap");
    mk("nsnap/out"); mk("nsnap/out/chain"); mk("nsnap/out/chain/wf-prep");
    put("nroot/unisacc.com", "#!/bin/sh\n", 0755);
    put("nroot/tools/release-build.cx", "/* neither text */\n", 0644);
    put("nroot/tools/chain-step.cx", "cp unisacc.com %s && cp -a unisacc.com.dev %s/unisacc.com.dev\n", 0644);
    put("nbuild/source-package-O2.elf", "x", 0600);
    put("nroot/compiler.p4.pkg", "P4 index without embedded headers hdr/cx-nested.h\n", 0644);
    put("nsnap/.release-rev", head, 0644);
    cx_fmt(json, sizeof json, "{\n  \"commit\": \"%s\"\n}\n", prev);
    put("nsnap/unisacc.com.build.json", json, 0644);
    p(d1, "nroot"); p(d2, "nbuild"); p(d3, "nsnap");
    rc = run(0, 0, d1, d2, d3, head, 1, 0, 0);
    ck(rc == 1, "neg.exit1");
    for (row = 1; row <= 12; row++) {
        char name[64]; cx_fmt(name, sizeof name, "neg.row%d.FAIL", row);
        ck(row_is(row, "FAIL"), name);
    }
    /* row 13 (tools-compile launcher) passes here: the negative root has unisacc.com for rows 3-4 */
    ck(row_is(13, "PASS") && row_is(14, "PASS") && strstr(out, "PREFLIGHT\tfailed=12\tskipped=0\tpassed=2\n") != 0, "neg.summary");
    ck(strstr(out, "残留无收据 wf-prep 挡住 exclusive 输出") != 0 && strstr(out, "leftover without receipt.txt") != 0, "neg.row12.leftover");
    ck(strstr(out, "source-wave: exclusive host-libz directory errno=17") != 0, "neg.error_text");
    ck(strstr(out, "P4 缺嵌入头") != 0 && strstr(out, "missing hdr/cx.h") != 0 && strstr(out, "sha256=") != 0, "neg.row10.evidence");
    ck(strstr(out, "UNISACC_CTOR unset") != 0 && strstr(out, "release-build: opguard needs explicit UNISACC_CTOR") != 0, "neg.row11.unset");
    { char real[4400], link[4400]; p(real, "nsnap"); p(link, "nsnap-link"); if (sy_symlink(real, link)) die("nsnap-link");
      rc = run(0, 0, d1, d2, link, head, 1, "PHASE=post-snap", 0);
      ck(rc == 1 && row_is(14, "FAIL") && strstr(out, "release snapshot path") != 0, "neg.row14.symlink.FAIL"); }
    {   char e[4400]; mk("eroot"); p(e, "eroot");
        rc = run(0, 0, e, d2, d3, head, 1, "PHASE=entry", 0);
        ck(rc == 1 && row_is(13, "FAIL") && strstr(out, "cp /home/devali/repos/unisacc/unisacc.com ROOT/") != 0, "neg.row13.no-launcher.FAIL"); }

    /* the BUILD record is required by row 4; a non-canonical one is row 5's negative example.
       Without it row 5 fails on the missing record, so give it one and rerun only for the reason. */
    put("nroot/unisacc.com.build.json", "{\n  \"settings\": {\"opt\": 1}\n}\n", 0644);
    rc = run(0, 0, d1, d2, d3, head, 1, 0, 0);
    ck(row_is(5, "FAIL") && strstr(out, "root-epoch-record-shape") != 0, "neg.row5.noncanonical");

    /* positive fixtures */
    mk("proot"); mk("proot/tools"); mk("pbuild"); mk("psnap");
    put("proot/unisacc.com", "#!/bin/sh\n", 0755);
    put("proot/unisacc.com.build.json", "{}\n", 0644);
    put("proot/tools/chain-step.cx", "v[4] = \"--rev\"; v[6] = \"freeze\";\n", 0644);
    put("proot/tools/release-build.cx", "    if (*p || ms < 1 || ms > cap) return cap;\nsy_eprintf(\"release-build: %s timeout after %ld ms (child killed)\\n\", label, ms);\n", 0644);
    {
        const char *hdr_keys[2] = {"hdr/cx.h", "hdr/cx-flat.h"};
        const char *hdr_vals[2] = {"/* cx.h */\n", "/* cx-flat.h */\n"};
        write_p4_records("proot/compiler.p4.pkg", 2, hdr_keys, hdr_vals, 0, 0, 0);
    }
    put("pbuild/source-package-O2.elf", "x", 0700);
    put("psnap/.release-rev", head, 0644);
    cx_fmt(json, sizeof json, "{\n  \"commit\": \"%s\"\n}\n", head);
    put("psnap/unisacc.com.build.json", json, 0644);
    p(d1, "proot"); p(d2, "pbuild"); p(d3, "psnap");
    {   char ctor[4400]; p(ctor, "pbuild/Root41-bootstrap.com");
        rc = run(0, ctor, d1, d2, d3, head, 1, 0, 0); }
    for (row = 1; row <= 14; row++) {
        char name[64];
        if (row == 5) continue;
        cx_fmt(name, sizeof name, "pos.row%d.PASS", row);
        ck(row_is(row, "PASS"), name);
    }

    /* bootstrap: receipt commit HEAD~1, an ancestor of HEAD, declared by BOOTSTRAP_FROM */
    p(d3, "nsnap");
    rc = run(prev, 0, root, d2, d3, head, 1, 0, 0);
    ck(row_is(6, "PASS"), "boot.row6.ancestor.PASS");
    ck(row_is(5, "PASS"), "boot.row5.installed-record.PASS");

    /* row 12: a wf-prep that holds its receipt passes */
    put("nsnap/out/chain/wf-prep/receipt.txt", "ok\n", 0644);
    rc = run(0, 0, d1, d2, d3, head, 1, "PHASE=post-p3", 0);
    ck(row_is(12, "PASS"), "pos.row12.receipt-present.PASS");

    /* hook filter and strict */
    p(d1, "proot"); p(d2, "pbuild"); p(d3, "psnap");
    rc = run(0, 0, d1, d2, d3, head, 1, "PHASE=post-p3", "--strict");
    ck(rc == 0 && row_is(10, "PASS") && row_is(12, "PASS") && !row_is(1, "PASS") && !row_is(11, "FAIL") &&
       strstr(out, "PREFLIGHT\tfailed=0\tskipped=0\tpassed=2\tstrict=1\n") != 0, "hook.post-p3.only-rows10-12");
    rc = run(0, 0, d1, d2, d3, head, 0, "PHASE=post-p3", 0);
    ck(rc == 1 && strstr(out, "var PKG\tunset at hook post-p3") != 0, "hook.post-p3.missing-PKG.FAIL");
    rc = run(0, 0, d1, d2, 0, head, 1, "PHASE=post-snap", 0);
    ck(rc == 1 && strstr(out, "var SNAP\tunset at hook post-snap") != 0, "hook.post-snap.missing-SNAP.FAIL");
    {   char ctor[4400]; p(ctor, "pbuild/Root41-bootstrap.com");
        /* this checkout, no SNAP and no PKG: rows 6, 10, 12 SKIP and nothing fails */
        rc = run(0, ctor, root, d2, 0, head, 0, 0, 0);
        ck(rc == 0 && row_is(6, "SKIP") && row_is(10, "SKIP") && !strstr(out, "FAIL\t"), "strict.off.skip-exits0");
        rc = run(0, ctor, root, d2, 0, head, 0, "--strict", 0);
        ck(rc == 1 && row_is(6, "SKIP") && !strstr(out, "FAIL\t"), "strict.on.skip-exits1");
        rc = run(0, ctor, d1, d2, d3, head, 1, "PHASE=pre-p3", "--strict");
        ck(rc == 0 && row_is(11, "PASS") && row_is(9, "PASS"), "hook.pre-p3.pass");
        rc = run(0, ctor, d1, d2, d3, head, 1, "PHASE=post-snap", "--strict");
        ck(rc == 0 && row_is(6, "PASS") && row_is(14, "PASS"), "hook.post-snap.strict.pass");
    }
    rc = run(0, 0, d1, d2, d3, head, 1, "PHASE=nowhere", 0);
    ck(rc == 2, "hook.unknown.exit2");

    /* red-then-green: when SNAP has M1 tape tools, post-p3 decodes P4 and checks exact F records (no substring bypass) */
    mk("psnap/tools");
    put("psnap/tools/tape-sidecar-build.cx", "/* tape-sidecar-build */\n", 0644);
    put("psnap/tools/tapepack.cx", "/* tapepack */\n", 0644);
    rc = run(0, 0, d1, d2, d3, head, 1, "PHASE=post-p3", "--strict");
    ck(rc == 1 && row_is(10, "FAIL") && strstr(out, "missing tape/lnx-x86_64/manifest.tsv") != 0, "hook.post-p3.missing-tape-records.FAIL");
    {
        /* Substring bypass attempt: a valid P4 package with hdr/cx.h, hdr/cx-flat.h, and a dummy F record whose body contains all 3 tape keys */
        const char *sub_keys[3] = {"hdr/cx.h", "hdr/cx-flat.h", "other/notes.txt"};
        const char *sub_vals[3] = {
            "/* cx.h */\n",
            "/* cx-flat.h */\n",
            "tape/lnx-x86_64/manifest.tsv tape/lnx-x86_64/tapemode.so tape/lnx-x86_64/m53.tapeslice\n"
        };
        write_p4_records("proot/compiler.p4.pkg", 3, sub_keys, sub_vals, 0, 0, 0);
        rc = run(0, 0, d1, d2, d3, head, 1, "PHASE=post-p3", "--strict");
        ck(rc == 1 && row_is(10, "FAIL") && strstr(out, "missing tape/lnx-x86_64/manifest.tsv") != 0, "hook.post-p3.substring-only-fake-p4.FAIL");

        const char *so_v = "ELF-tapemode-so-payload";
        const char *sl_v = "UTAPEBIN-m53-tapeslice-payload";
        char so_sha[65], sl_sha[65], mf_v[512];
        if (sy_sha256_hex(so_v, (long)strlen(so_v), so_sha) ||
            sy_sha256_hex(sl_v, (long)strlen(sl_v), sl_sha) ||
            cx_fmt(mf_v, sizeof mf_v, "tapemode.so\t%s\t%lu\nm53.tapeslice\t%s\t%lu\n",
                   so_sha, (unsigned long)strlen(so_v), sl_sha, (unsigned long)strlen(sl_v))) die("mf fmt");
        const char *t_keys[5] = {
            "hdr/cx.h", "hdr/cx-flat.h",
            "tape/lnx-x86_64/manifest.tsv", "tape/lnx-x86_64/tapemode.so", "tape/lnx-x86_64/m53.tapeslice"
        };
        const char *t_vals[5] = {"/* cx.h */\n", "/* cx-flat.h */\n", mf_v, so_v, sl_v};

        /* Bad CRC on tapemode.so F record -> FAIL */
        unsigned bad_crc[5] = {0, 0, 0, 1U, 0};
        write_p4_records("proot/compiler.p4.pkg", 5, t_keys, t_vals, 0, bad_crc, 0);
        rc = run(0, 0, d1, d2, d3, head, 1, "PHASE=post-p3", "--strict");
        ck(rc == 1 && row_is(10, "FAIL") && strstr(out, "invalid F record tape/lnx-x86_64/tapemode.so") != 0, "hook.post-p3.bad-crc-tape-record.FAIL");

        /* Manifest SHA mismatch -> FAIL */
        const char *bad_vals[5] = {"/* cx.h */\n", "/* cx-flat.h */\n", "tapemode.so\t0000\t23\nm53.tapeslice\t1111\t30\n", so_v, sl_v};
        write_p4_records("proot/compiler.p4.pkg", 5, t_keys, bad_vals, 0, 0, 0);
        rc = run(0, 0, d1, d2, d3, head, 1, "PHASE=post-p3", "--strict");
        ck(rc == 1 && row_is(10, "FAIL") && strstr(out, "tape manifest SHA mismatch") != 0, "hook.post-p3.manifest-sha-mismatch.FAIL");

        /* Plain hdr/ keys without leading NUL -> FAIL (production requires exact \0hdr/cx.h and \0hdr/cx-flat.h) */
        g_plain_hdr_key = 1;
        write_p4_records("proot/compiler.p4.pkg", 5, t_keys, t_vals, 0, 0, 0);
        g_plain_hdr_key = 0;
        rc = run(0, 0, d1, d2, d3, head, 1, "PHASE=post-p3", "--strict");
        ck(rc == 1 && row_is(10, "FAIL") && strstr(out, "missing hdr/cx.h") != 0, "hook.post-p3.plain-hdr-key-without-leading-nul.FAIL");

        /* Corrupt deflated hdr/ record (codec=1 payload cannot inflate) -> FAIL */
        g_corrupt_hdr_deflate = 1;
        write_p4_records("proot/compiler.p4.pkg", 5, t_keys, t_vals, 0, 0, 0);
        g_corrupt_hdr_deflate = 0;
        rc = run(0, 0, d1, d2, d3, head, 1, "PHASE=post-p3", "--strict");
        ck(rc == 1 && row_is(10, "FAIL") && strstr(out, "missing hdr/cx.h") != 0, "hook.post-p3.corrupt-deflated-hdr.FAIL");

        /* Valid 3 tape F records -> PASS */
        write_p4_records("proot/compiler.p4.pkg", 5, t_keys, t_vals, 0, 0, 0);
        rc = run(0, 0, d1, d2, d3, head, 1, "PHASE=post-p3", "--strict");
        ck(rc == 0 && row_is(10, "PASS") && row_is(12, "PASS"), "hook.post-p3.with-tape-records.PASS");

        /* Candidate-chain p3 tape receipt binding + post-pack final APE verification red-first cases */
        mk("psnap/tools/tape"); mk("psnap/tools/tape/asm");
        put("psnap/tools/tape/asm/tape_x86_64.S", "/* tape_x86_64.S */\n", 0644);
        put("psnap/tools/tape/asm/hoststub_lnx_x86_64.S", "/* hoststub_lnx_x86_64.S */\n", 0644);
        /* Mock proot/unisacc.com that handles tape-sidecar-build.cx, -S guest compile, and tapepack.cx */
        put("proot/unisacc.com",
            "#!/bin/sh\n"
            "case \"$1\" in\n"
            "  *tape-sidecar-build.cx)\n"
            "    TDIR=\"$6\"\n"
            "    printf '%s' 'ELF-tapemode-so-payload' > \"$TDIR/tapemode.so\"\n"
            "    SHA=$(sha256sum \"$TDIR/tapemode.so\" | awk '{print $1}')\n"
            "    LEN=$(wc -c < \"$TDIR/tapemode.so\" | tr -d ' ')\n"
            "    printf 'tapemode.so\\t%s\\t%s\\n' \"$SHA\" \"$LEN\" > \"$TDIR/manifest.tsv\"\n"
            "    exit 0 ;;\n"
            "  *.m53_guest.cx)\n"
            "    printf '.text\\n' > \"$4\"\n"
            "    exit 0 ;;\n"
            "  *tapepack.cx)\n"
            "    printf '%s' 'UTAPEBIN-m53-tapeslice-payload' > \"$5\"\n"
            "    exit 0 ;;\n"
            "esac\n"
            "exit 0\n", 0755);

        char cout[4400];
        p(cout, "chain-dir");
        mk("chain-dir"); mk("chain-dir/p3-run"); mk("chain-dir/p3-run/tape"); mk("chain-dir/p3-run/tape/lnx-x86_64");
        put("chain-dir/p3-run/tape/lnx-x86_64/tapemode.so", so_v, 0644);
        put("chain-dir/p3-run/tape/lnx-x86_64/m53.tapeslice", sl_v, 0644);
        put("chain-dir/p3-run/tape/lnx-x86_64/manifest.tsv", mf_v, 0644);
        {
            np_result rr = {0}; char why[256] = {0};
            char *av[] = {"sh", "./unisacc.com", "tools/candidate-chain.cx", "--", "--p3-tape-fixture", d1, d3, cout, 0}; /* lint:allow R1-product invokes checkout product to test candidate-chain.cx fixture */
            int rrc = (np_run(av, root, 0, 50, &rr, why, sizeof why) == 0) ? rr.rc : -1;
            ck(rrc == 2 && rr.err && strstr(rr.err, "REFUSE p3 tape receipt mismatch") != 0, "cc.p3-tape.unreceipted-reuse.FAIL");
            np_free(&rr);
        }
        /* Remove unreceipted dir, let cc_ensure_p3_tape build and write receipt.tsv, then verify reuse */
        {
            char tdir_rm[4400];
            p(tdir_rm, "chain-dir/p3-run/tape/lnx-x86_64");
            if (cx_rmtree(tdir_rm)) die("rmtree unreceipted");
            np_result rr1 = {0}, rr2 = {0}; char why[256] = {0};
            char *av[] = {"sh", "./unisacc.com", "tools/candidate-chain.cx", "--", "--p3-tape-fixture", d1, d3, cout, 0}; /* lint:allow R1-product invokes checkout product to test candidate-chain.cx fixture */
            int rrc1 = (np_run(av, root, 0, 50, &rr1, why, sizeof why) == 0) ? rr1.rc : -1;
            int rrc2 = (np_run(av, root, 0, 50, &rr2, why, sizeof why) == 0) ? rr2.rc : -1;
            ck(rrc1 == 0 && rr1.out && strstr(rr1.out, "P3_TAPE_BUILD\t") != 0 &&
               rrc2 == 0 && rr2.out && strstr(rr2.out, "P3_TAPE_REUSE\t") != 0,
               "cc.p3-tape.build-and-receipt-reuse.PASS");
            np_free(&rr1); np_free(&rr2);
        }
        /* Mutate snapshot asm source -> reuse MUST refuse on receipt mismatch */
        put("psnap/tools/tape/asm/tape_x86_64.S", "/* mutated tape_x86_64.S */\n", 0644);
        {
            np_result rr = {0}; char why[256] = {0};
            char *av[] = {"sh", "./unisacc.com", "tools/candidate-chain.cx", "--", "--p3-tape-fixture", d1, d3, cout, 0}; /* lint:allow R1-product invokes checkout product to test candidate-chain.cx fixture */
            int rrc = (np_run(av, root, 0, 30, &rr, why, sizeof why) == 0) ? rr.rc : -1;
            ck(rrc == 2 && rr.err && strstr(rr.err, "REFUSE p3 tape receipt mismatch") != 0, "cc.p3-tape.mutated-source-reuse.FAIL");
            np_free(&rr);
        }
        /* Restore snapshot asm source and test post-pack final APE verification */
        put("psnap/tools/tape/asm/tape_x86_64.S", "/* tape_x86_64.S */\n", 0644);
        mk("chain-dir/ape-final");
        /* Red 1: compiler.p4.pkg has only substring keys -> --pack-verify-fixture MUST refuse */
        write_p4_records("chain-dir/compiler.p4.pkg", 3, sub_keys, sub_vals, 0, 0, 0);
        write_p4_records("chain-dir/ape-final/p3-package.body", 5, t_keys, t_vals, 0, 0, 0);
        write_p4_records("chain-dir/ape-final/unisacc-next.com", 5, t_keys, t_vals, 0, 0,
                         "#!/bin/sh\nprintf 'ok\\n'\nexit 0\n");
        {
            np_result rr = {0}; char why[256] = {0};
            char *av[] = {"sh", "./unisacc.com", "tools/candidate-chain.cx", "--", "--pack-verify-fixture", d1, d3, cout, 0}; /* lint:allow R1-product invokes checkout product to test candidate-chain.cx fixture */
            int rrc = (np_run(av, root, 0, 30, &rr, why, sizeof why) == 0) ? rr.rc : -1;
            ck(rrc == 2 && rr.err && strstr(rr.err, "REFUSE package missing embedded tape record") != 0, "cc.pack-verify.substring-bypass.FAIL");
            np_free(&rr);
        }
        /* Red 2: valid P4 packages in all 3 files, but final APE stream e3 outputs M53_M1_REFUSE -> MUST refuse */
        write_p4_records("chain-dir/compiler.p4.pkg", 5, t_keys, t_vals, 0, 0, 0);
        write_p4_records("chain-dir/ape-final/unisacc-next.com", 5, t_keys, t_vals, 0, 0,
                         "#!/bin/sh\nif [ \"$2\" = \"e3\" ]; then echo M53_M1_REFUSE >&2; exit 2; fi\nprintf 'tok\\n'\nexit 0\n");
        {
            np_result rr = {0}; char why[256] = {0};
            char *av[] = {"sh", "./unisacc.com", "tools/candidate-chain.cx", "--", "--pack-verify-fixture", d1, d3, cout, 0}; /* lint:allow R1-product invokes checkout product to test candidate-chain.cx fixture */
            int rrc = (np_run(av, root, 0, 30, &rr, why, sizeof why) == 0) ? rr.rc : -1;
            ck(rrc == 2 && rr.err && strstr(rr.err, "REFUSE final APE stream e3 post-pack check failed") != 0, "cc.pack-verify.stream-e3-fail.FAIL");
            np_free(&rr);
        }
        /* Green: all 3 packages valid and all 3 stream stages (e2, e1, e3) produce output with rc=0 */
        write_p4_records("chain-dir/ape-final/unisacc-next.com", 5, t_keys, t_vals, 0, 0,
                         "#!/bin/sh\nprintf 'stage-%s-ok\\n' \"$2\"\nexit 0\n");
        {
            np_result rr = {0}; char why[256] = {0};
            char *av[] = {"sh", "./unisacc.com", "tools/candidate-chain.cx", "--", "--pack-verify-fixture", d1, d3, cout, 0}; /* lint:allow R1-product invokes checkout product to test candidate-chain.cx fixture */
            int rrc = (np_run(av, root, 0, 30, &rr, why, sizeof why) == 0) ? rr.rc : -1;
            ck(rrc == 0 && rr.out && strstr(rr.out, "POST_PACK_TAPE_VERIFY\t") != 0, "cc.pack-verify.full-post-pack.PASS");
            np_free(&rr);
        }
        /* Bootstrap package verification (codec=1 \0hdr/* records with dlen != rawlen before 3 codec=0 tape records) */
        {
            char bpkg[4400];
            p(bpkg, "chain-dir/compiler.bootstrap.pkg");
            write_p4_records("chain-dir/compiler.bootstrap.pkg", 5, t_keys, t_vals, 0, 0, 0);
            np_result rr = {0}; char why[256] = {0};
            char *av[] = {"sh", "./unisacc.com", "tools/candidate-chain.cx", "--", "--pkg-tape-verify-fixture", d1, d3, cout, bpkg, 0}; /* lint:allow R1-product invokes checkout product to test candidate-chain.cx fixture */
            int rrc = (np_run(av, root, 0, 30, &rr, why, sizeof why) == 0) ? rr.rc : -1;
            ck(rrc == 0 && rr.out && strstr(rr.out, "PKG_TAPE_VERIFY\t") != 0, "cc.p3-bootstrap-pkg.codec1-hdr-plus-tape.PASS");
            np_free(&rr);
        }
        /* Live 8773b0e06 compiler.bootstrap.pkg reproduction when present on host */
        {
            const char *home = sy_env("HOME");
            char live_out[4400], live_snap[4400], live_pkg[4400];
            if (home && home[0] &&
                !cx_fmt(live_out, sizeof live_out, "%s/.cache/unisacc/chains/bg-b1/8773b0e0618d51764ec2d452f5862993fb625616", home) &&
                !cx_fmt(live_snap, sizeof live_snap, "%s/.cache/unisacc/chains/snap/8773b0e061-045c5a38", home) &&
                !cx_fmt(live_pkg, sizeof live_pkg, "%s/compiler.bootstrap.pkg", live_out) &&
                sy_exists(live_pkg) == 1 && sy_exists(live_snap) == 1) {
                np_result rr = {0}; char why[256] = {0};
                char *av[] = {"sh", "./unisacc.com", "tools/candidate-chain.cx", "--", "--pkg-tape-verify-fixture", live_snap, live_snap, live_out, live_pkg, 0}; /* lint:allow R1-product invokes checkout product to test candidate-chain.cx fixture */
                int rrc = (np_run(av, root, 0, 30, &rr, why, sizeof why) == 0) ? rr.rc : -1;
                ck(rrc == 0 && rr.out && strstr(rr.out, "PKG_TAPE_VERIFY\t") != 0, "cc.p3-bootstrap-pkg.live-8773b0e06.PASS");
                np_free(&rr);
            }
        }
    }

    if (cx_rmtree(work)) die("cleanup");
    printf("CHECK_PREFLIGHT\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
