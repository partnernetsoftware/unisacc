/* Local pp rule-to-deploy-NN construction; no Python interpreter or old weight
 * values. prepare ROOT NEW_ABS_MATERIAL | --verify ROOT MATERIAL.
 * Caller bounds: prepare55, verify20 (UNMEASURED until independently run).
 * Source measurements hash the whole existing source closure, including old
 * weight files; bootstrap is trusted. This is not a globally model-unread or
 * Python-source-free build. The six new cube values do not use those weights. */
#pragma unisa use cxlib.netpack
static char root[4096],mat[4096],product[4400],bound[4400],ident[4400],self[4096],paths[7][4400],hashes[7][65];
static const char *deps[]={"unisacc.com","tools/pp-gold-material.cx","unisa/gold.py","unisa/ckernel.py","tools/cxlib/netpack.cx","seed/ident.c","tools/bound"};
static const char *gold_v1="25721a152d0d1e4ad7ebc7d314890223e312ef45bf40d97c497d63db021e7b91";
static void die(const char *s){fprintf(stderr,"pp-gold-material: REFUSE %s errno=%d\n",s,errno);exit(2);}
static char *load(const char *p,size_t *n){struct stat a,b;errno=0;if(lstat(p,&a))die(errno==ENOENT?"input-absent":"input-stat");if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>16777216)die("bounded-regular-input");int fd=open(p,O_RDONLY|O_CLOEXEC|O_NONBLOCK|O_NOFOLLOW);if(fd<0)die("input-open");if(fstat(fd,&b)||!S_ISREG(b.st_mode)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size){close(fd);die("input-descriptor");}*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s){close(fd);die("allocation");}size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0){close(fd);free(s);die("input-extent");}at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int changed=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(z||changed||closed){free(s);die("input-changed-or-close");}s[*n]=0;return s;}
static void path(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path-bound");}
static void digest(const char *p,char h[65]){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,h);free(s);}
static void put(const char *name,const char *s,size_t n){char p[4400];path(p,mat,name);int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive-output");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0){close(fd);die("output-write");}at+=(size_t)z;}int synced=fsync(fd),closed=close(fd);if(synced||closed)die("output-close");}
static void equal(const char *name,const np_buf *expected){char p[4400];path(p,mat,name);size_t n;char *s=load(p,&n);int ok=n==expected->n&&!memcmp(s,expected->p,n);free(s);if(!ok)die("material-content-mismatch");}
static void row(np_buf *b,const char *key,const char *value){np_puts(b,key);np_puts(b,"\t");np_puts(b,value);np_puts(b,"\n");}
static void source(char h[65],const char *label,int evidence){if(unsetenv("UNISACC_RF_CAPTURE")||unsetenv("UNISA_ATTRIBUTES"))die("clear-ambient-resources");char *v[]={bound,"8","sh",product,ident,"--",root,0};np_result r;char why[1024];if(np_run(v,root,0,10,&r,why,sizeof why))die(why);if(evidence){char name[100],status[40];snprintf(name,sizeof name,"%s.stdout",label);put(name,r.out,r.outn);snprintf(name,sizeof name,"%s.stderr",label);put(name,r.err,r.errn);int n=snprintf(status,sizeof status,"rc\t%d\n",r.rc);snprintf(name,sizeof name,"%s.status",label);put(name,status,(size_t)n);}int ok=!r.rc&&!r.errn&&r.outn==65&&r.out[64]=='\n';if(ok){memcpy(h,r.out,64);h[64]=0;for(int i=0;i<64;i++)if(!((h[i]>='0'&&h[i]<='9')||(h[i]>='a'&&h[i]<='f')))ok=0;}if(!ok&&r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);if(!ok)die("full-source-identity");}
static void stable(void){char h[65];for(int i=0;i<7;i++){digest(paths[i],h);if(strcmp(h,hashes[i]))die("applicable-input-changed");}}
static np_buf math_body(char hash[65]){size_t n;char *s=load(paths[3],&n);if(memchr(s,0,n)||memchr(s,'\r',n))die("kernel-source-wire");const char *tag="\nKERNEL_BODY = r'''";char *a=strstr(s,tag);if(!a||strstr(a+1,tag))die("unique-kernel-source");a+=strlen(tag);char *end=strstr(a,"\n'''");if(!end)die("kernel-raw-string-end");const char *main_tag="\nint main(void) {";char *stop=strstr(a,main_tag);if(!stop||stop>=end||strstr(stop+1,main_tag))die("unique-kernel-main-boundary");if(strstr(a,"#include"))die("kernel-body-must-not-include-model");np_buf b={0};np_put(&b,a,(size_t)(stop-a));np_puts(&b,"\n");cx_sha256_hex(b.p,b.n,hash);free(s);return b;}
/* Header-free observer: thin private globals/admission + exact unmodified math
 * slice + observations. No golden labels or result verdict are emitted. */
static const char *observer_prefix="/* Generated PP observation harness. The math below is an exact source slice\n * of unisa/ckernel.py KERNEL_BODY before main. No old weights are included.\n * Reports actual infer results only: no expected labels and no PASS verdict. */\nstatic char *MODEL;\nstatic int STAGE_M[1]={2},STAGE_H[1]={6},STAGE_OFF[1]={0},STAGE_MW[1]={1};\nstatic int STAGE_VN[4]={9,2,0,0},STAGE_NCLS[16]={4};\nstatic int act[6],z[4],ready,last_valid;\n";
static const char *observer_suffix="\nstatic void obs_die(const char *s){fprintf(stderr,\"pp-observe: REFUSE %s errno=%d\\n\",s,errno);exit(90);}\nstatic unsigned long long little(const unsigned char *p,int n){unsigned long long v=0;for(int i=n-1;i>=0;i--)v=(v<<8)|p[i];return v;}\nstatic void pp_close(void){free(MODEL);MODEL=0;ready=last_valid=0;}\nstatic void pp_open(const char *path,const char *label){pp_close();struct stat a,b;errno=0;if(lstat(path,&a)||!S_ISREG(a.st_mode)||a.st_size!=142)obs_die(\"142-byte-regular-model\");int fd=open(path,O_RDONLY|O_NONBLOCK|O_NOFOLLOW|O_CLOEXEC);if(fd<0)obs_die(\"model-open\");if(fstat(fd,&b)||!S_ISREG(b.st_mode)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size){close(fd);obs_die(\"model-descriptor\");}MODEL=malloc(142);if(!MODEL){close(fd);obs_die(\"model-allocation\");}size_t at=0;while(at<142){ssize_t n=read(fd,MODEL+at,142-at);if(n<0&&errno==EINTR)continue;if(n<=0){close(fd);obs_die(\"model-extent\");}at+=(size_t)n;}char c;ssize_t n;do{n=read(fd,&c,1);}while(n<0&&errno==EINTR);int changed=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(n||changed||closed)obs_die(\"model-changed-or-close\");unsigned char *p=(unsigned char *)MODEL;for(int i=0;i<6;i++)if(little(p+i*16,8)>511||little(p+i*16+8,8)>3)obs_die(\"mask-bounds\");if(little(p+96,4)!=6)obs_die(\"six-sparse-entries\");for(int i=0;i<6;i++){unsigned char *e=p+100+i*7;unsigned long long w=little(e+5,2);if(little(e,2)!=(unsigned)i||e[2]||little(e+3,2)>=4||!w||w>16)obs_die(\"sparse-entry-bounds\");}ready=1;char hash[65];cx_sha256_hex(MODEL,142,hash);printf(\"MODEL\\t%s\\t%s\\t142\\n\",label,hash);}\nstatic int predict(int s,int d,int f,int head){last_valid=0;if(!ready||s!=0||head!=0)return -2;int key[4]={d,f,0,0};int got=infer(0,key,0);if(got>=0)last_valid=1;return got;}\nstatic int score(int c){return ready&&last_valid&&c>=0&&c<4?z[c]:(-2147483647-1);}\nstatic void observe(const char *tag,int a,int b,int c,int s,int d,int f,int head){int got=predict(s,d,f,head);printf(\"%s\\t%d\\t%d\\t%d\\t%d\\t%d\\t%d\\t%d\\t%d\\n\",tag,a,b,c,got,score(0),score(1),score(2),score(3));}\nint main(int argc,char **argv){\n#if !defined(__linux__) || !defined(__x86_64__)\n fputs(\"NOT_RUN pp-observe requires Linux/x86_64 LP64\\n\",stderr);return 3;\n#endif\n if(argc!=3||sizeof(long)!=8)return 2;\n pp_open(argv[1],\"base\");\n for(int d=0;d<9;d++)for(int f=0;f<2;f++)observe(\"ROW\",d,f,0,0,d,f,0);\n for(int field=0;field<2;field++){int other_count=field?9:2;for(int other=0;other<other_count;other++)for(int high=0;high<2;high++){int bad=high?(field?2:9):-1;observe(\"BOUND\",field,other,bad,0,field?other:bad,field?bad:other,0);observe(\"RECOVER\",field,other,bad,0,field?other:0,field?0:other,0);}}\n for(int i=0;i<4;i++){int s=i==0?-1:i==1?18:0,h=i==2?-1:i==3?1:0;observe(\"ADAPTER\",s,h,0,s,0,0,h);observe(\"RESTORE\",s,h,0,0,0,0,0);}\n pp_open(argv[2],\"changed\");\n observe(\"SENSITIVE\",0,1,0,0,0,1,0);\n pp_close();printf(\"CLOSED\\t%d\\t%d\\t%d\\t%d\\n\",score(0),score(1),score(2),score(3));return 0;\n}\n";
static np_buf observer(const np_buf *math){np_buf b={0};np_puts(&b,observer_prefix);np_put(&b,math->p,math->n);np_puts(&b,observer_suffix);return b;}
static void le(unsigned char *p,unsigned long long v,int n){for(int i=0;i<n;i++){p[i]=(unsigned char)(v&255);v>>=8;}}
static np_buf construct(void){
 /* Rule partition, not copied weights: DIRS=(ifdef,ifndef,if,elif,else,endif,
  * define,include,undef), DEFINED=(0,1), classes=(take,skip,pop,macro).
  * A={ifdef,if,elif,else}; ifndef reverses; endif pops; last three macro.
  * Six disjoint cubes, each contributes exactly one to its rule's class. */
 unsigned long long dm[6]={29,29,2,2,32,448},fm[6]={2,1,1,2,0,0};int cls[6]={0,1,0,1,2,3};unsigned char bytes[142]={0};
 for(int i=0;i<6;i++){le(bytes+i*16,dm[i],8);le(bytes+i*16+8,fm[i],8);}le(bytes+96,6,4);
 for(int i=0;i<6;i++){unsigned char *e=bytes+100+i*7;le(e,(unsigned)i,2);e[2]=0;le(e+3,(unsigned)cls[i],2);le(e+5,1,2);}
 np_buf b={0};np_put(&b,(const char *)bytes,sizeof bytes);return b;
}
static unsigned long long readle(const unsigned char *p,int n){unsigned long long v=0;for(int i=n-1;i>=0;i--)v=(v<<8)|p[i];return v;}
/* Pure admission of the fixed v1 recipe, not another weight construction.
 * Every byte has a field obligation: 96 mask bytes, 4 count bytes, 42 entries.
 * An altered NN plus a self-consistent unsigned receipt is still ineligible.
 * The observer separately admits private bounded weights for sensitivity. */
static void canonical_weights(const char *bytes,size_t n){
 if(n!=142)die("model-extent");const unsigned char *p=(const unsigned char *)bytes;
 static const unsigned long long masks[12]={29,2,29,1,2,1,2,2,32,0,448,0};
 static const unsigned classes[6]={0,1,0,1,2,3};
 for(int i=0;i<12;i++)if(readle(p+i*8,8)!=masks[i])die("canonical-six-cube-mask-mismatch");
 if(readle(p+96,4)!=6)die("canonical-six-cube-entry-count");
 for(int i=0;i<6;i++){const unsigned char *e=p+100+i*7;if(readle(e,2)!=(unsigned)i||e[2]||readle(e+3,2)!=classes[i]||readle(e+5,2)!=1)die("canonical-six-cube-unit-class-or-weight-mismatch");}
}
static np_buf record(const char *sid,const char *mh,const np_buf *obs){np_buf b={0};np_puts(&b,"pp-gold-material-v1\nstatus\tPREPARED\nscope\tpp-six-cube-source-construction-real-C-infer-no-test-result\n");row(&b,"root",root);row(&b,"source",sid);row(&b,"recipe","pp6-v1-disjoint-cubes-W2-one-142bytes");row(&b,"provenance-boundary","Python-files-read-as-source-text-no-interpreter;full-SID-hashes-old-weights;bootstrap-trusted;only-new-pp-values-independent");for(int i=0;i<7;i++)row(&b,deps[i],hashes[i]);row(&b,"math-body",mh);row(&b,"ABI","LP64;stage0;m2;H6;MW1;fields9,2;head0;classes4;LE-mask64+sparse-u16");char p[4400],h[65];size_t n;path(p,mat,"pp.weights");char *w=load(p,&n);canonical_weights(w,n);cx_sha256_hex(w,n,h);free(w);row(&b,"pp.weights",h);cx_sha256_hex(obs->p,obs->n,h);row(&b,"pp-observe.cx",h);return b;}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN pp-gold-material requires Linux/x86_64 LP64\n",stderr);return 3;
#endif
 int verify=argc==4&&!strcmp(argv[1],"--verify");if(argc!=4||(!verify&&strcmp(argv[1],"prepare"))||sizeof(long)!=8||!realpath(argv[2],root)||argv[3][0]!='/'||strlen(argv[3])>=sizeof mat||strpbrk(argv[3],"\r\n\t")||!realpath(__FILE__,self))die("usage-prepare-or-verify-ROOT-MATERIAL");strcpy(mat,argv[3]);path(product,root,"unisacc.com");path(bound,root,"tools/bound");path(ident,root,"seed/ident.c");for(int i=0;i<7;i++){path(paths[i],root,deps[i]);digest(paths[i],hashes[i]);}char actual_tool[65];digest(self,actual_tool);if(strcmp(actual_tool,hashes[1]))die("tool-source-not-root-recipe");if(strcmp(hashes[2],gold_v1))die("gold-v1-source-pin-changed");
 struct stat st;if(verify){if(lstat(mat,&st)||!S_ISDIR(st.st_mode))die("real-material-directory");}else if(mkdir(mat,0700))die("fresh-material-directory");
 char before[65],after[65],mh[65];source(before,"source-before",!verify);np_buf math=math_body(mh),obs=observer(&math);free(math.p);stable();
 if(verify)equal("pp-observe.cx",&obs);else{np_buf weights=construct();put("pp.weights",weights.p,weights.n);free(weights.p);put("pp-observe.cx",obs.p,obs.n);}
 np_buf expected=record(before,mh,&obs);if(verify)equal("material.tsv",&expected);
 source(after,"source-after",!verify);if(strcmp(before,after))die("source-endpoints-differ");stable();equal("pp-observe.cx",&obs);np_buf final=record(after,mh,&obs);if(expected.n!=final.n||memcmp(expected.p,final.p,expected.n))die("material-endpoints-differ");free(final.p);if(verify)equal("material.tsv",&expected);else put("material.tsv",expected.p,expected.n);
 free(expected.p);free(obs.p);puts(verify?"VERIFIED\tpp-gold-material\tno-test-result":"PREPARED\tpp-gold-material\tno-test-result");return 0;
}

