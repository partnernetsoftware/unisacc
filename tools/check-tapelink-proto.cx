/* tools/check-tapelink-proto.cx -- wrapper gate for tools/tapelink-proto.cx --check.
 *
 *   sh ./unisacc.com tools/check-tapelink-proto.cx --
 * Marker: CHECK_TAPELINK_PROTO. */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use cxlib.netpack

int main(void) {
    char *v[] = {"sh", "./unisacc.com", "tools/tapelink-proto.cx", "--", "--check", 0};
    np_result r = {0};
    char why[128] = {0};
    int tr = np_run(v, 0, 0, 30, &r, why, sizeof why);
    int ok = (tr == 0 && !r.residue && r.rc == 0 && r.out && r.outn > 0 &&
              tx_find(r.out, (long)r.outn, "TAPELINK_PROTO_CHECK\tpassed=4\tfailed=0", 38) >= 0);
    if (r.out && r.outn > 0) (void)sy_write_all(1, r.out, (long)r.outn);
    np_free(&r);
    sy_printf("%s\tcheck-tapelink-proto.self-check\n", ok ? "PASS" : "FAIL");
    sy_printf("CHECK_TAPELINK_PROTO\tfailed=%d\ttapemode_run=UNMEASURED\n", ok ? 0 : 1);
    return ok ? 0 : 1;
}
