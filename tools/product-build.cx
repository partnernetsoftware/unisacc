/* Native, bounded driver/container construction. Each requested step executes;
 * receipts bind material, never a saved functional PASS. */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.kernelcontext
static char root[4096],generation[4096],packages[4096],product[4400],bound[4400];
static const char *targets[]={"win/x86_64","lnx/x86_64","lnx/arm64","osx/x86_64","osx/arm64"};
static const char *files[]={"slice-win-x86_64","slice-lnx-x86_64","slice-lnx-arm64","slice-osx-x86_64","slice-osx-arm64"};
static void die(const char *s){fprintf(stderr,"product-build: REFUSE %s\n",s);exit(2);}
static void path(char *p,size_t cap,const char *a,const char *b){int n=snprintf(p,cap,"%s/%s",a,b);if(n<0||(size_t)n>=cap)die("path bound");}
static char *load(const char *p,size_t *n){struct stat st;if(lstat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>268435456)die(p);char *s=cx_read(p,n);if(!s||*n!=(size_t)st.st_size)die("read/size changed");return s;}
static void digest(const char *p,char *h){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,h);free(s);}
static void absent(const char *p){struct stat st;errno=0;if(lstat(p,&st)==0||errno!=ENOENT)die("output must not exist");}
static void saved(const char *p,const char *s,size_t n){int f=open(p,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC|O_NOFOLLOW,0600);if(f<0)die("exclusive receipt");while(n){ssize_t k=write(f,s,n);if(k<0&&errno==EINTR)continue;if(k<=0)die("write; partial retained");s+=k;n-=(size_t)k;}if(fsync(f)||close(f))die("fsync/close");}
static void context(char *h){char sid[65],p[4400],sha[65];kc_check(root,generation,sid);np_buf b={0};np_puts(&b,"native-product-construction-v1\n");np_puts(&b,sid);np_puts(&b,"\n");const char *inputs[]={"tools/product-build.cx","tools/package-refresh.cx","tools/cxlib/kernelcontext.cx","tools/cxlib/netpack.cx","seed/ape.c"};int i;for(i=0;i<5;i++){path(p,sizeof p,root,inputs[i]);digest(p,sha);np_puts(&b,inputs[i]);np_puts(&b,"\t");np_puts(&b,sha);np_puts(&b,"\n");}const char *material[]={"compiler.pkg","package.tsv","model-inputs.tsv"};for(i=0;i<3;i++){path(p,sizeof p,packages,material[i]);digest(p,sha);np_puts(&b,material[i]);np_puts(&b,"\t");np_puts(&b,sha);np_puts(&b,"\n");}cx_sha256_hex(b.p,b.n,h);free(b.p);}
static void receipt(const char *name,const char *input,int verify){char p[4400],rpath[4500],h[65],text[256];path(p,sizeof p,generation,name);digest(p,h);int n=snprintf(text,sizeof text,"PREPARED\tnative-product\tno-test-result\ncontext\t%s\nartifact\t%s\n",input,h);int k=snprintf(rpath,sizeof rpath,"%s.native-build.tsv",p);if(k<0||(size_t)k>=sizeof rpath)die("receipt path");if(verify){size_t rn;char *s=load(rpath,&rn);int ok=rn==(size_t)n&&!memcmp(s,text,rn);free(s);if(!ok)die("missing/stale slice receipt");}else saved(rpath,text,(size_t)n);}
static void call(char **v){np_result r;char why[1024];if(np_run(v,root,0,45,&r,why,sizeof why))die(why);if(r.outn)fwrite(r.out,1,r.outn,stdout);if(r.errn)fwrite(r.err,1,r.errn,stderr);int rc=r.rc;np_free(&r);if(rc)exit(rc<0?128-rc:rc);}
int main(int argc,char **argv){if(argc!=5||!realpath(argv[1],root)||!realpath(argv[2],generation)||!realpath(argv[3],packages)){fputs("usage: ROOT KERNEL_GENERATION PACKAGE_DIR slice-TARGET|wrap\n",stderr);return 2;}path(product,sizeof product,root,"unisacc.com");path(bound,sizeof bound,root,"tools/bound");char before[65],after[65],output[4400],source[4400],pkg[4400],slices[5][4400];context(before);int i,selected=-1;
 for(i=0;i<5;i++){char step[64];snprintf(step,sizeof step,"slice-%s",targets[i]);if(!strcmp(argv[4],step))selected=i;}
 const char *name;if(selected>=0){name=files[selected];path(output,sizeof output,generation,name);absent(output);path(source,sizeof source,root,"exec/c/asmcompiler.c");char *v[]={bound,"40","sh",product,"-O2","-b",(char *)targets[selected],source,"-o",output,0};call(v);
 }else if(!strcmp(argv[4],"wrap")){name="unisacc-next.com";path(output,sizeof output,generation,name);absent(output);for(i=0;i<5;i++){receipt(files[i],before,1);path(slices[i],sizeof slices[i],generation,files[i]);}path(pkg,sizeof pkg,packages,"compiler.pkg");path(source,sizeof source,root,"seed/ape.c");size_t n;char versionpath[4400];path(versionpath,sizeof versionpath,root,"src/version.h");char *text=load(versionpath,&n),version[40];const char *prefix="#define UNISACC_VERSION \"";char *v=strstr(text,prefix);if(!v||strstr(v+1,prefix))die("unique product version");v+=strlen(prefix);size_t j=0;while(v[j]&&v[j]!='\"'){if(j==sizeof version-1||!((v[j]>='0'&&v[j]<='9')||v[j]=='.'))die("product version");version[j]=v[j];j++;}if(!j||v[j]!='\"')die("product version extent");version[j]=0;free(text);
  char *args[]={bound,"40","sh",product,source,"--","--payload",pkg,"--product","Unisacc",version,output,slices[0],slices[1],slices[2],slices[3],slices[4],0};call(args);for(i=0;i<5;i++)receipt(files[i],before,1);
 }else die("unknown step");context(after);if(strcmp(before,after))die("inputs changed during construction");receipt(name,before,0);printf("PREPARED\t%s\tno-test-result\n",argv[4]);return 0;}
