/* Native, bounded driver/container construction. Each requested step executes;
 * receipts bind material, never a saved functional PASS. */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.kernelcontext
#pragma unisa use cxlib.rebuildcontext
#pragma unisa use cxlib.mixedprofiles
static char root[4096],generation[4096],packages[4096],product[4400],bound[4400];
static const char *targets[]={"win/x86_64","lnx/x86_64","lnx/arm64","osx/x86_64","osx/arm64"};
static const char *files[]={"slice-win-x86_64","slice-lnx-x86_64","slice-lnx-arm64","slice-osx-x86_64","slice-osx-arm64"};
static void die(const char *s){fprintf(stderr,"product-build: REFUSE %s\n",s);exit(2);}
static void path(char *p,size_t cap,const char *a,const char *b){int n=snprintf(p,cap,"%s/%s",a,b);if(n<0||(size_t)n>=cap)die("path bound");}
static char *load(const char *p,size_t *n){struct stat st;if(lstat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>268435456)die(p);char *s=cx_read(p,n);if(!s||*n!=(size_t)st.st_size)die("read/size changed");return s;}
static void digest(const char *p,char *h){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,h);free(s);}
static void absent(const char *p){struct stat st;errno=0;if(lstat(p,&st)==0||errno!=ENOENT)die("output must not exist");}
static void saved(const char *p,const char *s,size_t n){int f=open(p,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC|O_NOFOLLOW,0600);if(f<0)die("exclusive receipt");while(n){ssize_t k=write(f,s,n);if(k<0&&errno==EINTR)continue;if(k<=0)die("write; partial retained");s+=k;n-=(size_t)k;}if(fsync(f)||close(f))die("fsync/close");}
/* V1 is reproduced by rebuildcontext without changing its bytes. Source-P3
 * admission is the separate v2 domain, using actual SID from kc_check, a fresh
 * full material snapshot, original builder record and independent package epoch.
 * This does not extend the outer55 deadline: whole-DAG cost remains measured
 * separately; no cached receipt verdict substitutes for either endpoint. */
static int source_package_mode;
static int package_kind;
static const char *wrap_libz_path="/usr/lib/x86_64-linux-gnu/libz.so.1.2.11";
static char wrap_libz_sha[65],wrap_trace_sha[65];
static char **owned_environment;
static int forbidden_environment(const char *s){const char *keys[]={"SEED_GEN_GENERIC","SEED_GEN_TRACE","UNISACC_SEED_TRACE","UNISACC_RF_CAPTURE","UNISA_ATTRIBUTES","LIBRARY_PATH","LD_LIBRARY_PATH","LD_PRELOAD","LD_AUDIT","LD_DEBUG","LD_DEBUG_OUTPUT","UNISA_CONTAINER"};for(int i=0;i<12;i++){size_t n=strlen(keys[i]);if(!strncmp(s,keys[i],n)&&s[n]=='=')return 1;}return 0;}
static void clean_environment(void){size_t n=0;for(char **p=environ;*p;p++)n++;if(n>1048576)die("environment-entry-bound");char **next=malloc((n+1)*sizeof *next);if(!next)die("allocation");size_t at=0;for(char **p=environ;*p;p++)if(!forbidden_environment(*p))next[at++]=*p;next[at]=0;char **old=owned_environment;environ=next;owned_environment=next;free(old);for(char **p=environ;*p;p++)if(forbidden_environment(*p))die("environment-policy-not-applied-to-raw-environ");}
/* Optional saved builders are explicit known source-package construction roles.
 * Obtain current source through the generation's actual pinned native helper;
 * rb_build_context then validates kernel context against the selected builder,
 * rather than kc_check's implicit ROOT artifact role. Original builder JSON
 * is read and bound there; the current ROOT record is never substituted. */
static int explicit_saved_builder;
/* Schema selection only dispatches; rb_build_context still performs the full
 * schema-specific source/package/snapshot and product-context validation. */
static const char *source_schema(void){char p[4400];size_t n;path(p,sizeof p,packages,"package.tsv");char *s=load(p,&n);const char *known[]={"source-package-v1\n","source-package-adoption-v1\n","source-package-mixed-v1\n","source-package-mixed-v2\n"};const char *found=0;for(int i=0;i<4;i++)if(n>=strlen(known[i])&&!memcmp(s,known[i],strlen(known[i]))){found=known[i];break;}free(s);return found;}
/* __FILE__ checks the canonical source role, not executable-byte provenance.
 * External construction evidence must bind the executing ELF separately. */
static void consumer_source_role(const char *tool_root){char expected[4400],own[4096],canonical[4096];path(expected,sizeof expected,tool_root,"tools/product-build.cx");if(!realpath(expected,canonical)||strcmp(expected,canonical)||!realpath(__FILE__,own)||strcmp(own,expected))die("mixed-v2-consumer-source-role");}
/* Phase dispatch reads this role only; observe and finish independently run
 * full rb/mx validation before publishing a context or final receipt. */
static void selected_consumer_role(void){
 char p[4400],tool_root[4096];size_t n;path(p,sizeof p,packages,"context.tsv");char *s=load(p,&n);const char *schema="source-package-mixed-context-v2\n",*key="\ntool-root\t";
 if(n<strlen(schema)||memcmp(s,schema,strlen(schema))||memchr(s,0,n))die("mixed-v2-consumer-context-shape");
 char *at=strstr(s,key),*value=at?at+strlen(key):0,*end=value?strchr(value,'\n'):0;
 if(!value||!end||strstr(value,key)||end==value||(size_t)(end-value)>=sizeof tool_root)die("mixed-v2-consumer-tool-root-field");
 size_t z=(size_t)(end-value);memcpy(tool_root,value,z);tool_root[z]=0;free(s);if(tool_root[0]!='/'||strpbrk(tool_root,"\t\r\n"))die("mixed-v2-consumer-tool-root-shape");consumer_source_role(tool_root);
}
static void saved_builder_source(char sid[65]){char p[4400],helper[4400],expected[65],actual[65],why[1024];size_t n;if(!source_schema())die("saved-builder-requires-known-source-package-schema");path(helper,sizeof helper,generation,"identity-helper");digest(helper,actual);path(p,sizeof p,generation,"identity-helper.sha256");char *s=load(p,&n);if(n!=64||memcmp(s,actual,64))die("saved-builder-source-helper-digest");memcpy(expected,s,64);expected[64]=0;free(s);char *v[]={bound,"12",helper,root,0};np_result r;if(np_run(v,root,0,15,&r,why,sizeof why))die(why);int ok=!r.rc&&!r.errn&&r.outn==65&&r.out[64]=='\n';if(ok){memcpy(sid,r.out,64);sid[64]=0;for(int i=0;i<64;i++)if(!((sid[i]>='0'&&sid[i]<='9')||(sid[i]>='a'&&sid[i]<='f')))ok=0;}np_free(&r);if(!ok)die("saved-builder-fresh-source-observation");digest(helper,actual);if(strcmp(actual,expected))die("saved-builder-source-helper-changed");}
static void context(char *h){
 char sid[65],why[2048];if(explicit_saved_builder)saved_builder_source(sid);else kc_check(root,generation,sid);rb_result r;if(rb_build_context(root,generation,packages,product,sid,&r,why,sizeof why))die(why);
 package_kind=r.package_kind;source_package_mode=package_kind==2||package_kind==3||package_kind==4;int explicit_mixed=package_kind==4&&mp_explicit_v2(r.mixed_profile);if(explicit_mixed)consumer_source_role(r.mixed_tool_root);strcpy(h,r.product_context);
 if(source_package_mode)printf("MATERIAL_OBSERVATION\t%s\tjobs=%d\tmodels=%d\tphysical-reads=%d\telapsed-ns=%lld\tno-test-result\n",package_kind==4?(explicit_mixed?"source-package-mixed-v2":"source-package-mixed-v1"):package_kind==3?"source-package-adoption-v1":"source-package-v1",r.source_jobs,r.source_models,r.source_physical_reads,r.source_elapsed_ns);
 if(explicit_mixed)printf("MATERIAL_PROFILE\t%s\tsource-root=%s\ttool-root=%s\texecutable-provenance=UNVERIFIED\tno-test-result\n",r.mixed_profile,root,r.mixed_tool_root);
}
/* Mixed kind4 executes the explicit host wrapper and produces no private
 * loader trace. Keep the existing nonmixed source-wrapper trace contract. */
static void receipt(const char *name,const char *input,int verify){char p[4400],rpath[4500],h[65],text[512];path(p,sizeof p,generation,name);digest(p,h);int n=snprintf(text,sizeof text,"PREPARED\tnative-product\tno-test-result\ncontext\t%s\nartifact\t%s\n",input,h);if(n<0||(size_t)n>=sizeof text)die("receipt extent");if(source_package_mode&&package_kind!=4&&!strcmp(name,"unisacc-next.com")){if(!wrap_libz_sha[0]||!wrap_trace_sha[0])die("wrap libz receipt missing");int z=snprintf(text+n,sizeof text-(size_t)n,"libz-sha256\t%s\nloader-trace-sha256\t%s\n",wrap_libz_sha,wrap_trace_sha);if(z<0||(size_t)z>=sizeof text-(size_t)n)die("wrap receipt extent");n+=z;}int k=snprintf(rpath,sizeof rpath,"%s.native-build.tsv",p);if(k<0||(size_t)k>=sizeof rpath)die("receipt path");if(verify){size_t rn;char *s=load(rpath,&rn);int ok=rn==(size_t)n&&!memcmp(s,text,rn);free(s);if(!ok)die("missing/stale slice receipt");}else saved(rpath,text,(size_t)n);}
static void call(char **v){clean_environment();np_result r;char why[1024];if(np_run(v,root,0,45,&r,why,sizeof why))die(why);if(r.outn)fwrite(r.out,1,r.outn,stdout);if(r.errn)fwrite(r.err,1,r.errn,stderr);int rc=r.rc;np_free(&r);if(rc)exit(rc<0?128-rc:rc);}
static void wrap_trace_check(const char *s,size_t n){if(!n||memchr(s,0,n))die("wrap-loader-trace-bounds");char expected_so[4500],expected_soname[4500];path(expected_so,sizeof expected_so,generation,"wrap-link/libz.so");path(expected_soname,sizeof expected_soname,generation,"wrap-link/libz.so.1");size_t at=0;int hits=0;const char *needle="calling init: ";while(at<n){size_t end=at;while(end<n&&s[end]!='\n')end++;size_t len=end-at;if(len>=8192)die("wrap-loader-trace-line-bound");{char line[8192];size_t ci=0;while(ci<len){line[ci]=s[at+ci];ci++;}line[len]=0;char *p=strstr(line,needle);if(p&&strstr(p,"libz.so")){p+=strlen(needle);while(*p==' '||*p=='\t')p++;char *stop=p+strlen(p);while(stop>p&&(stop[-1]==' '||stop[-1]=='\t'||stop[-1]=='\r'))*--stop=0;char actual[4096];if((strcmp(p,expected_so)&&strcmp(p,expected_soname))||!realpath(p,actual)||strcmp(actual,wrap_libz_path))die("wrap-loader-libz-path-not-pinned");hits++;}}at=end<n?end+1:end;}if(hits!=1)die("wrap-loader-libz-trace-count");}
static void wrap_call(char **v){char dir[4400],link[4500],trace[4400],target[4096],why[1024];clean_environment();path(dir,sizeof dir,generation,"wrap-link");if(mkdir(dir,0700))die("exclusive-wrap-link-directory");path(link,sizeof link,dir,"libz.so");if(symlink(wrap_libz_path,link))die("wrap-link-symlink");if(!realpath(link,target)||strcmp(target,wrap_libz_path))die("wrap-link-target");path(link,sizeof link,dir,"libz.so.1");if(symlink(wrap_libz_path,link))die("wrap-soname-symlink");if(!realpath(link,target)||strcmp(target,wrap_libz_path))die("wrap-soname-target");digest(wrap_libz_path,wrap_libz_sha);if(setenv("LIBRARY_PATH",dir,1)||setenv("LD_LIBRARY_PATH",dir,1)||setenv("LD_DEBUG","libs",1))die("wrap-controlled-environment");np_result r;if(np_run(v,root,0,45,&r,why,sizeof why))die(why);if(r.outn)fwrite(r.out,1,r.outn,stdout);if(r.rc){if(r.errn)fwrite(r.err,1,r.errn,stderr);int rc=r.rc;np_free(&r);exit(rc<0?128-rc:rc);}if(r.errn>65536)die("wrap-loader-trace-bound");wrap_trace_check(r.err,r.errn);path(trace,sizeof trace,generation,"wrap-libz.trace");saved(trace,r.err,r.errn);cx_sha256_hex(r.err,r.errn,wrap_trace_sha);np_free(&r);char after[65];digest(wrap_libz_path,after);if(strcmp(after,wrap_libz_sha))die("wrap-libz-content-changed");unsetenv("LIBRARY_PATH");unsetenv("LD_LIBRARY_PATH");unsetenv("LD_DEBUG");}
static int mixed_schema(void){const char *kind=source_schema();if(kind&&!strcmp(kind,"source-package-mixed-v2\n")){selected_consumer_role();return 1;}return kind&&!strcmp(kind,"source-package-mixed-v1\n");}
static void mixed_context_path(char p[4400]){path(p,4400,generation,"product-mixed-context.sha256");}
static void mixed_read_context(char h[65]){char p[4400];size_t n;mixed_context_path(p);char *s=load(p,&n);if(n!=65||s[64]!='\n')die("mixed-observed-context-shape");for(int i=0;i<64;i++)if(!((s[i]>='0'&&s[i]<='9')||(s[i]>='a'&&s[i]<='f')))die("mixed-observed-context-hex");memcpy(h,s,64);h[64]=0;free(s);}
static void mixed_observe(void){char h[65],p[4400],wire[66];context(h);if(package_kind!=4)die("mixed-observe-package-kind");mixed_context_path(p);memcpy(wire,h,64);wire[64]='\n';wire[65]=0;saved(p,wire,65);printf("OBSERVED\tmixed-product-context\t%s\tno-test-result\n",h);}
static void mixed_pending(const char *name,const char *h){char p[4400],pending[4500],artifact[65],wire[220];path(p,sizeof p,generation,name);digest(p,artifact);int z=snprintf(pending,sizeof pending,"%s.pending.tsv",p);if(z<0||(size_t)z>=sizeof pending)die("mixed-pending-path");z=snprintf(wire,sizeof wire,"native-product-mixed-pending-v1\ncontext\t%s\nartifact\t%s\n",h,artifact);if(z<0||(size_t)z>=sizeof wire)die("mixed-pending-wire");saved(pending,wire,(size_t)z);printf("EXECUTED\tmixed-product-%s\trequires-finish\tno-test-result\n",name);}
static void mixed_finish(const char *step){const char *name=0;if(!strcmp(step,"wrap"))name="unisacc-next.com";else for(int i=0;i<5;i++){char expected[64];snprintf(expected,sizeof expected,"slice-%s",targets[i]);if(!strcmp(step,expected))name=files[i];}if(!name)die("mixed-finish-step");char before[65],after[65],p[4400],pending[4500],artifact[65],wire[220];mixed_read_context(before);context(after);if(package_kind!=4||strcmp(before,after))die("mixed-finish-material-context-changed");path(p,sizeof p,generation,name);digest(p,artifact);int z=snprintf(pending,sizeof pending,"%s.pending.tsv",p);if(z<0||(size_t)z>=sizeof pending)die("mixed-finish-pending-path");z=snprintf(wire,sizeof wire,"native-product-mixed-pending-v1\ncontext\t%s\nartifact\t%s\n",before,artifact);if(z<0||(size_t)z>=sizeof wire)die("mixed-finish-pending-wire");size_t n;char *s=load(pending,&n);int ok=n==(size_t)z&&!memcmp(s,wire,n);free(s);if(!ok)die("mixed-finish-output-or-context-changed");receipt(name,after,0);printf("PREPARED\tmixed-product-%s\tverified-context-and-output\tno-test-result\n",name);}
int main(int argc,char **argv){if((argc!=5&&argc!=6)||!realpath(argv[1],root)||!realpath(argv[2],generation)||!realpath(argv[3],packages)){fputs("usage: ROOT KERNEL_GENERATION PACKAGE_DIR slice-TARGET|wrap [ABS_SAVED_BUILDER]\n",stderr);return 2;}if(argc==6){if(argv[5][0]!='/'||strpbrk(argv[5],"\t\r\n")||!realpath(argv[5],product))die("absolute-saved-builder-realpath");explicit_saved_builder=1;}else path(product,sizeof product,root,"unisacc.com");path(bound,sizeof bound,root,"tools/bound");char before[65],after[65],output[4400],source[4400],pkg[4400],slices[5][4400];int mixed=mixed_schema();if(mixed&&!strcmp(argv[4],"observe")){mixed_observe();return 0;}if(mixed&&!strncmp(argv[4],"finish-",7)){mixed_finish(argv[4]+7);return 0;}if(mixed){mixed_read_context(before);source_package_mode=1;package_kind=4;}else context(before);int i,selected=-1;
 for(i=0;i<5;i++){char step[64];snprintf(step,sizeof step,"slice-%s",targets[i]);if(!strcmp(argv[4],step))selected=i;}
 /* A saved compiler carries its own historical library. Source-package
  * construction must explicitly compile both driver and wrapper with the
  * current source headers; the v2 context binds this directory and flags. */
 char headers[4400],driver_headers[4400];path(headers,sizeof headers,root,"include");path(driver_headers,sizeof driver_headers,root,"exec/c");
 char module[4400],deps_module[4400],input_module[4400],path_module[4400],args_module[4400],cli_module[4400],compat_module[4400],env_module[4400],archive_module[4400],route_module[4400],codec_module[4400],footer_module[4400],attrframe_module[4400];path(module,sizeof module,root,"cx/driver/output.cx");path(deps_module,sizeof deps_module,root,"cx/driver/deps.cx");path(input_module,sizeof input_module,root,"cx/driver/input.cx");path(path_module,sizeof path_module,root,"cx/driver/path.cx");path(args_module,sizeof args_module,root,"cx/driver/args.cx");path(cli_module,sizeof cli_module,root,"cx/driver/cli.cx");path(compat_module,sizeof compat_module,root,"cx/driver/compat.cx");path(env_module,sizeof env_module,root,"cx/driver/environment.cx");path(archive_module,sizeof archive_module,root,"cx/driver/archive.cx");path(route_module,sizeof route_module,root,"cx/driver/route.cx");path(codec_module,sizeof codec_module,root,"cx/runtime/codec.cx");path(footer_module,sizeof footer_module,root,"cx/runtime/packagefooter.cx");path(attrframe_module,sizeof attrframe_module,root,"cx/runtime/attribute_frame.cx");
 const char *name;if(selected>=0){name=files[selected];path(output,sizeof output,generation,name);absent(output);path(source,sizeof source,root,"exec/c/asmcompiler.c");char *v[]={bound,"40","sh",product,"-O2","-I",headers,"-iquote",driver_headers,"-b",(char *)targets[selected],source,module,deps_module,input_module,path_module,args_module,cli_module,compat_module,env_module,archive_module,route_module,codec_module,footer_module,attrframe_module,"-o",output,0};char *legacy[]={bound,"40","sh",product,"-O2","-b",(char *)targets[selected],source,module,deps_module,input_module,path_module,args_module,cli_module,compat_module,env_module,archive_module,route_module,codec_module,footer_module,attrframe_module,"-o",output,0};call(source_package_mode?v:legacy);
 }else if(!strcmp(argv[4],"wrap")){name="unisacc-next.com";path(output,sizeof output,generation,name);absent(output);for(i=0;i<5;i++){receipt(files[i],before,1);path(slices[i],sizeof slices[i],generation,files[i]);}path(pkg,sizeof pkg,packages,"compiler.pkg");path(source,sizeof source,root,"seed/ape.c");size_t n;char versionpath[4400];path(versionpath,sizeof versionpath,root,"src/version.h");char *text=load(versionpath,&n),version[40];const char *prefix="#define UNISACC_VERSION \"";char *v=strstr(text,prefix);if(!v||strstr(v+1,prefix))die("unique product version");v+=strlen(prefix);size_t j=0;while(v[j]&&v[j]!='\"'){if(j==sizeof version-1||!((v[j]>='0'&&v[j]<='9')||v[j]=='.'))die("product version");version[j]=v[j];j++;}if(!j||v[j]!='\"')die("product version extent");version[j]=0;free(text);
  char *args[]={bound,"40","sh",product,"-DAPE_ZLIB","-I/usr/include/node","-lz","-I",headers,source,"--","--payload",pkg,"--product","Unisacc",version,output,slices[0],slices[1],slices[2],slices[3],slices[4],0};char *legacy[]={bound,"40","sh",product,source,"--","--payload",pkg,"--product","Unisacc",version,output,slices[0],slices[1],slices[2],slices[3],slices[4],0};
  if(mixed){char hostwrap[4400];path(hostwrap,sizeof hostwrap,generation,"ape-wrap-host.elf");absent(hostwrap);char *cc[]={bound,"40","/usr/bin/x86_64-linux-gnu-gcc-11","-std=c99","-O2","-DAPE_ZLIB","-I/usr/include/node",source,"/usr/lib/x86_64-linux-gnu/libz.so.1.2.11","-o",hostwrap,0};call(cc);char *compressed[]={bound,"40",hostwrap,"--payload",pkg,"--product","Unisacc",version,output,slices[0],slices[1],slices[2],slices[3],slices[4],0};call(compressed);}
   else if(source_package_mode)wrap_call(args);else call(legacy);for(i=0;i<5;i++)receipt(files[i],before,1);
 }else die("unknown step");if(mixed){mixed_pending(name,before);return 0;}context(after);if(strcmp(before,after))die("inputs changed during construction");receipt(name,before,0);printf("PREPARED\t%s\tno-test-result\n",argv[4]);return 0;}
