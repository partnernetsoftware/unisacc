#pragma unisa use sys.io
#pragma unisa use crypto.der
#pragma unisa use crypto.bn
#pragma unisa use crypto.b64
#pragma unisa use text.text
/* Vectors for crypto/der: what a strict DER reader must accept, and the encodings it must refuse.

   The refusals are the point of the module: an indefinite length, a long form that should have been
   short, a multi-byte tag, a non-minimal or negative or zero INTEGER, a body that runs past the input,
   a BIT STRING with unused bits, a BOOLEAN that is neither 0x00 nor 0xFF.  Each of those has a BER or
   sloppy-DER reading, so accepting one would let two byte strings decode to the same value. */

static int bad;

static void ok(int c, const char *name) {
    sy_printf("%s\t%s\n", c ? "PASS" : "FAIL", name);
    if (!c) bad = 1;
}

static unsigned char buf[400];

/* Feed buf[0..n) to a fresh reader. */
static void rd(cs_der *in, long n) {
    in->p = buf;
    in->n = n;
}

/* The integer just read equals the big-endian value spelled by hex.  cs_bn_to_bytes always writes 32
   bytes, so the hex string is compared against the low end of that buffer. */
static int int_is(cs_der *in, const char *hex) {
    cs_bn v;
    unsigned char got[32], want[40];
    long n = tx_len(hex, 256), m, i;
    if (n < 0 || n % 2 != 0) return 0;
    m = n / 2;
    if (m > 32 || cs_hex_decode(hex, n, want, 40) != m) return 0;
    if (cs_der_int(in, &v)) return 0;
    cs_bn_to_bytes(&v, got, 32);
    for (i = 0; i < m; i++) if (got[32 - m + i] != want[i]) return 0;
    for (i = 0; i < 32 - m; i++) if (got[i] != 0) return 0;
    return 1;
}

int main(void) {
    cs_der in, seq, body;
    const unsigned char *bits;
    long n, len;
    int b;
    unsigned tag;
    cs_bn junk;

    /* SEQUENCE { INTEGER 01, INTEGER 02 } */
    buf[0] = 0x30; buf[1] = 0x06;
    buf[2] = 0x02; buf[3] = 0x01; buf[4] = 0x01;
    buf[5] = 0x02; buf[6] = 0x01; buf[7] = 0x02;
    rd(&in, 8);
    ok(cs_der_expect(&in, 0x30, &seq) == 0, "sequence");
    ok(cs_der_at_end(&in), "sequence consumes input");
    ok(int_is(&seq, "01"), "integer 1");
    ok(int_is(&seq, "02"), "integer 2");
    ok(cs_der_at_end(&seq), "sequence body ends");

    /* wrong tag */
    rd(&in, 8);
    ok(cs_der_expect(&in, 0x31, &body) != 0, "reject wrong tag");

    /* indefinite length */
    buf[0] = 0x30; buf[1] = 0x80; buf[2] = 0x00; buf[3] = 0x00;
    rd(&in, 4);
    ok(cs_der_next(&in, &tag, &body) != 0, "reject indefinite length");

    /* long form for a short body: 0x81 0x05 where 0x05 is already short form */
    buf[0] = 0x30; buf[1] = 0x81; buf[2] = 0x05;
    rd(&in, 3);
    ok(cs_der_skip(&in) != 0, "reject non-minimal length");

    /* multi-byte tag */
    buf[0] = 0x1f; buf[1] = 0x01; buf[2] = 0x00;
    rd(&in, 3);
    ok(cs_der_skip(&in) != 0, "reject multi-byte tag");

    /* body past the end */
    buf[0] = 0x30; buf[1] = 0x10;
    rd(&in, 2);
    ok(cs_der_skip(&in) != 0, "reject body past input");

    /* truncated header */
    buf[0] = 0x30;
    rd(&in, 1);
    ok(cs_der_skip(&in) != 0, "reject truncated header");

    /* long length whose value fits in four bytes but does not fit the input */
    buf[0] = 0x30; buf[1] = 0x84; buf[2] = 0xff; buf[3] = 0xff; buf[4] = 0xff; buf[5] = 0xff;
    rd(&in, 6);
    ok(cs_der_skip(&in) != 0, "reject huge length");

    /* long form that is legitimate: OCTET STRING of 128 bytes */
    buf[0] = 0x04; buf[1] = 0x81; buf[2] = 0x80;
    { long i; for (i = 0; i < 128; i++) buf[3 + i] = (unsigned char)i; }
    rd(&in, 131);
    ok(cs_der_octets(&in, &bits, &len) == 0 && len == 128 && bits[127] == 127,
       "accept minimal long form");
    ok(cs_der_at_end(&in), "octet string consumes input");

    /* INTEGERs */
    buf[0] = 0x02; buf[1] = 0x02; buf[2] = 0x00; buf[3] = 0x01;
    rd(&in, 4);
    ok(cs_der_int(&in, &junk) != 0, "reject non-minimal integer");
    buf[0] = 0x02; buf[1] = 0x01; buf[2] = 0x85;
    rd(&in, 3);
    ok(cs_der_int(&in, &junk) != 0, "reject negative integer");
    buf[0] = 0x02; buf[1] = 0x01; buf[2] = 0x00;
    rd(&in, 3);
    ok(cs_der_int(&in, &junk) != 0, "reject zero integer");
    buf[0] = 0x02; buf[1] = 0x00;
    rd(&in, 2);
    ok(cs_der_int(&in, &junk) != 0, "reject empty integer");
    buf[0] = 0x02; buf[1] = 0x02; buf[2] = 0x00; buf[3] = 0xff;
    rd(&in, 4);
    ok(int_is(&in, "ff"), "accept 00 ff for 255");
    buf[0] = 0x02; buf[1] = 0x03; buf[2] = 0x00; buf[3] = 0x00; buf[4] = 0x01;
    rd(&in, 5);
    ok(cs_der_int(&in, &junk) != 0, "reject two leading zeros");
    buf[0] = 0x02; buf[1] = 0x01; buf[2] = 0x7f;
    rd(&in, 3);
    ok(int_is(&in, "7f"), "accept 127");
    buf[0] = 0x02; buf[1] = 0x20;
    { long i; for (i = 0; i < 32; i++) buf[2 + i] = 0x11; }
    rd(&in, 34);
    ok(int_is(&in, "1111111111111111111111111111111111111111111111111111111111111111"),
       "accept 256-bit integer");

    /* BIT STRING */
    buf[0] = 0x03; buf[1] = 0x02; buf[2] = 0x00; buf[3] = 0xab;
    rd(&in, 4);
    ok(cs_der_bits(&in, &bits, &len) == 0 && len == 1 && bits[0] == 0xab, "accept bit string");
    buf[0] = 0x03; buf[1] = 0x02; buf[2] = 0x01; buf[3] = 0xab;
    rd(&in, 4);
    ok(cs_der_bits(&in, &bits, &len) != 0, "reject unused bits");
    buf[0] = 0x03; buf[1] = 0x00;
    rd(&in, 2);
    ok(cs_der_bits(&in, &bits, &len) != 0, "reject empty bit string");

    /* OID */
    buf[0] = 0x06; buf[1] = 0x03; buf[2] = 0x2a; buf[3] = 0x86; buf[4] = 0x48;
    rd(&in, 5);
    ok(cs_der_oid(&in, &bits, &len) == 0 && len == 3 && bits[0] == 0x2a, "accept oid");
    buf[0] = 0x06; buf[1] = 0x00;
    rd(&in, 2);
    ok(cs_der_oid(&in, &bits, &len) != 0, "reject empty oid");

    /* BOOLEAN */
    buf[0] = 0x01; buf[1] = 0x01; buf[2] = 0xff;
    rd(&in, 3);
    ok(cs_der_bool(&in, &b) == 0 && b == 1, "boolean true");
    buf[0] = 0x01; buf[1] = 0x01; buf[2] = 0x00;
    rd(&in, 3);
    ok(cs_der_bool(&in, &b) == 0 && b == 0, "boolean false");
    buf[0] = 0x01; buf[1] = 0x01; buf[2] = 0x01;
    rd(&in, 3);
    ok(cs_der_bool(&in, &b) != 0, "reject boolean 0x01");
    buf[0] = 0x01; buf[1] = 0x02; buf[2] = 0x00; buf[3] = 0xff;
    rd(&in, 4);
    ok(cs_der_bool(&in, &b) != 0, "reject long boolean");

    /* trailing bytes are visible, not silently dropped */
    buf[0] = 0x02; buf[1] = 0x01; buf[2] = 0x07; buf[3] = 0x00;
    rd(&in, 4);
    ok(cs_der_int(&in, &junk) == 0, "integer before trailing byte");
    ok(!cs_der_at_end(&in), "trailing byte reported");

    /* skip walks past a body of any tag */
    buf[0] = 0x04; buf[1] = 0x02; buf[2] = 0xaa; buf[3] = 0xbb;
    buf[4] = 0x02; buf[5] = 0x01; buf[6] = 0x00;
    rd(&in, 7);
    ok(cs_der_skip(&in) == 0 && in.n == 3 && in.p[0] == 0x02, "skip leaves the next element");

    sy_printf("CHECK_CRYPTO_DER\tfailed=%d\n", bad);
    return bad;
}
