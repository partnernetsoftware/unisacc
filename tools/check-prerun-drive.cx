           ckk_has(out, CPD_OUT, "PRERUN_PLAN\ttotal=2\twindows=2\t") &&
           ckk_has(out, CPD_OUT, "max_window_ms=40515\t") &&
           !ckk_has(out, CPD_OUT, "PRERUN_SPLIT_REQUIRED"),
           "times-file-pass-only-estimate: ignores 53s/54s FAIL/KILLED rows and uses 40515ms PASS estimate");

        /* Mutation gate: --mutate-times-use-nonpass must fail (triggers PRERUN_SPLIT_REQUIRED / non-PASS estimate) */
        if (cx_fmt(cmd, sizeof cmd,
            "sh '%s/unisacc.com' '%s' -- plan --ids-file '%s' --times-file '%s' --out '%s' --normal-jobs 4 --warmup 1 --mutate-times-use-nonpass",
            cwd, pd_path, ids15, tf15, o15m)) return 2;
        int rc15m = ckk_sh("check-prerun-drive", cmd, out, sizeof out);
        ck(rc15m != 0 &&
           ckk_has(out, CPD_OUT, "PRERUN_SPLIT_REQUIRED\tbatch=module-units\testimate_ms=54090\tlimit_ms=54000"),
           "mutant-killed-times-use-nonpass: including FAIL/KILLED rows in estimate triggers PRERUN_SPLIT_REQUIRED");
    }

