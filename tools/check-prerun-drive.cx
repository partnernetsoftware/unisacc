/* tools/check-prerun-drive.cx -- self-contained regression checks for tools/prerun-drive.cx.
 * Passes in single-commit shallow cold layouts (no git history, no CLAUDE_JOB_DIR, no external paths).
 * Covers:
 *   (1) plan on 421 synthetic ids (incl. real-commit, heavy, netregen): exact coverage, normal windows 8..12,
 *       warmup window, two-phase real-commit prebuild-self + heavy jobs=1;
 *   (2) run with mock runner: two-phase prebuild-self, --resume skips done windows, repeating failure stops
 *       after max-retries=2 with PRERUN_STOP and raw line;
 *   (3) merge: verbatim concatenation without editing lines, supersedes FAIL->PASS, writes expected-fail
 *       and expected-unmeasured drafts;
 *   (4) replay: matches merged summary and G1 dry counts (expected_fail=1, superseded=2).
 * Ends: CHECK_PRERUN_DRIVE<TAB>ok=N<TAB>failed=M<TAB>ms=T. */
#pragma unisa use cxlib.ckassert
#pragma unisa use cxlib.ckrun
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use text.text

#define CPD_PW 4400
#define CPD_OUT 32768

static int rows_have(const char *rows, long n, const char *want) {
    return rows && tx_find(rows, n, want, strlen(want)) >= 0;
}

int main(void) {
    long t0 = sy_now_ms();
    char cwd[CPD_PW], work[CPD_PW], cmd[8192], out[CPD_OUT];
    const char *td = sy_tmpdir();
    const char *base_td = (td && td[0] == '/') ? td : "/tmp";
    if (!getcwd(cwd, sizeof cwd)) return 2;
    if (cx_fmt(work, sizeof work, "%s/cpd-%d", base_td, (int)getpid())) return 2;
    if (mkdir(work, 0700) != 0 && errno != EEXIST) return 2;

    /* (1) plan on 421 synthetic ids */
    char ids421[CPD_PW], pdir[CPD_PW];
    if (cx_fmt(ids421, sizeof ids421, "%s/ids421.txt", work) ||
        cx_fmt(pdir, sizeof pdir, "%s/plan421", work)) return 2;
    {
        char *buf = (char *)mm_alloc(32768);
        size_t p = 0;
        const char *fixed[] = {"real-commit", "c-negative", "unit-frontcache-equiv3", "check-split-parents", "netregen-small-lnx-x86_64", 0};
        for (int i = 0; fixed[i]; i++) {
            char row[64]; cx_fmt(row, sizeof row, "%s\n", fixed[i]);
            mm_copy(buf + p, 32768 - p, row, strlen(row)); p += strlen(row);
        }
        for (int i = 0; i < 416; i++) {
            char row[64]; cx_fmt(row, sizeof row, "batch-%03d\n", i);
            mm_copy(buf + p, 32768 - p, row, strlen(row)); p += strlen(row);
        }
        if (cx_write(ids421, buf, p)) return 2;
        mm_free(buf);
    }
    if (cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- plan --ids-file '%s' --out '%s' --win-size 10 --warmup 4",
        cwd, cwd, ids421, pdir)) return 2;
    {
        int rc = ckk_sh("check-prerun-drive", cmd, out, sizeof out);
        char wp[CPD_PW]; size_t wn = 0;
        cx_fmt(wp, sizeof wp, "%s/windows.tsv", pdir);
        char *wb = (char *)cx_read(wp, &wn);
        ck(rc == 0 && ckk_has(out, CPD_OUT, "PRERUN_PLAN\ttotal=421\t") &&
           wb && tx_find(wb, (long)wn, "\tprebuild-self\t1\treal-commit\n", 27) >= 0 &&
           tx_find(wb, (long)wn, "\twarmup\t4\t", 9) >= 0 &&
           tx_find(wb, (long)wn, "\theavy\t1\treal-commit\n", 20) >= 0,
           "plan-421-windows: covers 421 ids with warmup, prebuild-self, heavy jobs=1, and 8..12 normal windows");
        free(wb);
    }

    /* (2) run with mock runner: prebuild-self + --resume + stop after 2 retries with raw line */
    char rdir[CPD_PW], mock[CPD_PW], sids[CPD_PW];
    if (cx_fmt(rdir, sizeof rdir, "%s/run-test", work) ||
        cx_fmt(mock, sizeof mock, "%s/mock.sh", work) ||
        cx_fmt(sids, sizeof sids, "%s/small.ids", work)) return 2;
    if (cx_write(sids, "alpha\nbeta\nreal-commit\n", 23)) return 2;
    {
        const char *ms =
            "#!/bin/sh\n"
            "mode=$1; wid=$2\n"
            "if [ \"$mode\" = prebuild-self ]; then echo PREBUILD_OK; exit 0; fi\n"
            "jobs=$3; ids=$4; out=$5; att=$6\n"
            "echo \"# devsvc qualify\" > \"$out\"\n"
            "printf 'batch\\tdomain\\tstatus\\trc\\tcandidate\\tms\\tload1\\tretries\\tnote\\n' >> \"$out\"\n"
            "if [ \"$ids\" = real-commit ]; then\n"
            "  printf 'real-commit\\tproduct-qualification\\tFAIL\\t1\\taaa\\t100\\t1.0\\t0\\tdeterministic-err\\n' >> \"$out\"\n"
            "  exit 1\n"
            "fi\n"
            "for id in $(printf '%s' \"$ids\" | tr ',' ' '); do\n"
            "  printf '%s\\tproduct-qualification\\tPASS\\t0\\taaa\\t50\\t1.0\\t0\\t-\\n' \"$id\" >> \"$out\"\n"
            "done\n"
            "exit 0\n";
        if (cx_write(mock, ms, strlen(ms))) return 2;
    }
    if (cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- plan --ids-file '%s' --out '%s' --win-size 8 --warmup 2",
        cwd, cwd, sids, rdir)) return 2;
    if (ckk_sh("check-prerun-drive", cmd, out, sizeof out) != 0) return 2;
    if (cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- run --root '%s' --out '%s' --mock-runner '%s' --max-retries 2",
        cwd, cwd, cwd, rdir, mock)) return 2;
    {
        int rc = ckk_sh("check-prerun-drive", cmd, out, sizeof out);
        ck(rc == 1 && ckk_has(out, CPD_OUT, "PRERUN_STOP\tbatch=real-commit\tretries=2\t") &&
           ckk_has(out, CPD_OUT, "deterministic-err"),
           "run-stops-after-2-retries: stops on repeating non-PASS batch and prints raw line");
    }
    /* Resume after fixing mock to pass real-commit: skips completed warmup & prebuild-self windows */
    {
        const char *ms_ok =
            "#!/bin/sh\n"
            "mode=$1; wid=$2; jobs=$3; ids=$4; out=$5\n"
            "echo \"# devsvc qualify\" > \"$out\"\n"
            "printf 'batch\\tdomain\\tstatus\\trc\\tcandidate\\tms\\tload1\\tretries\\tnote\\n' >> \"$out\"\n"
            "printf 'real-commit\\tproduct-qualification\\tPASS\\t0\\taaa\\t50\\t1.0\\t0\\t-\\n' >> \"$out\"\n"
            "exit 0\n";
        if (cx_write(mock, ms_ok, strlen(ms_ok))) return 2;
    }
    if (cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- run --root '%s' --out '%s' --mock-runner '%s' --resume",
        cwd, cwd, cwd, rdir, mock)) return 2;
    {
        int rc = ckk_sh("check-prerun-drive", cmd, out, sizeof out);
        ck(rc == 0 && ckk_has(out, CPD_OUT, "PRERUN_RUN\tstatus=DONE\tran=1\tskipped=2\t"),
           "run-resume-window-granularity: skips completed windows and runs only remaining window");
    }

    /* (3) & (4) merge + replay: verbatim lines, SUPERSEDED=2, FAIL=1, UNKNOWN=1, drafts & G1 dry match */
    char mdir[CPD_PW], mout[CPD_PW], expg[CPD_PW], rids[CPD_PW];
    if (cx_fmt(mdir, sizeof mdir, "%s/evid", work) || cx_fmt(mout, sizeof mout, "%s/mout", work) ||
        cx_fmt(expg, sizeof expg, "%s/g1dry.txt", work) || cx_fmt(rids, sizeof rids, "%s/rids.txt", work)) return 2;
    if (mkdir(mdir, 0700) != 0 && errno != EEXIST) return 2;
    {
        const char *w1 =
            "# devsvc qualify\n"
            "batch\tdomain\tstatus\trc\tcandidate\tms\tload1\tretries\tnote\n"
            "# source=abc ape_sha256=111\n"
            "b1\tproduct-qualification\tFAIL\t1\t111\t100\t1.0\t0\tflaky\n"
            "b2\tproduct-qualification\tFAIL\t1\t111\t100\t1.0\t0\tflaky2\n"
            "c-negative\tproduct-qualification\tFAIL\t1\t111\t200\t1.0\t0\tcount=53/9\n"
            "u1\tproduct-qualification\tUNKNOWN\t3\t-\t50\t1.0\t0\tno-producer\n"
            "SUMMARY\tbatches=4\n";
        const char *w2 =
            "# devsvc qualify\n"
            "batch\tdomain\tstatus\trc\tcandidate\tms\tload1\tretries\tnote\n"
            "# source=abc ape_sha256=111\n"
            "b1\tproduct-qualification\tPASS\t0\t111\t80\t1.0\t0\t-\n"
            "b2\tproduct-qualification\tPASS\t0\t111\t80\t1.0\t0\t-\n"
            "SUMMARY\tbatches=2\n";
        char p1[CPD_PW], p2[CPD_PW];
        cx_fmt(p1, sizeof p1, "%s/strict-W0000.tsv", mdir);
        cx_fmt(p2, sizeof p2, "%s/strict-W0001.tsv", mdir);
        if (cx_write(p1, w1, strlen(w1)) || cx_write(p2, w2, strlen(w2))) return 2;
        if (cx_write(rids, "b1\nb2\nc-negative\nu1\n", 20)) return 2;
        if (cx_write(expg, "GATE\t1\tSTRICT\tPASS\trows=4 expected_fail=1 superseded=2\n", 55)) return 2;
    }
    if (cx_fmt(cmd, sizeof cmd,
        "sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- replay --ids-file '%s' --evidence-dir '%s' --out '%s' --expected-g1dry '%s'",
        cwd, cwd, rids, mdir, mout, expg)) return 2;
    {
        int rc = ckk_sh("check-prerun-drive", cmd, out, sizeof out);
        char ef[CPD_PW], eu[CPD_PW]; size_t efn = 0, eun = 0;
        cx_fmt(ef, sizeof ef, "%s/expected-fail.draft.tsv", mout);
        cx_fmt(eu, sizeof eu, "%s/expected-unmeasured.draft.tsv", mout);
        char *efb = (char *)cx_read(ef, &efn);
        char *eub = (char *)cx_read(eu, &eun);
        ck(rc == 0 && ckk_has(out, CPD_OUT, "PRERUN_REPLAY\tstatus=MATCH\tplan_ids=4\tevid_batches=4\tPASS=2\tFAIL=1\tUNKNOWN=1\tSUPERSEDED=2") &&
           efb && tx_find(efb, (long)efn, "c-negative\tcount=53/9\t", 22) >= 0 &&
           eub && tx_find(eub, (long)eun, "u1\tno-producer\tu1-deferred.tsv\n", 31) >= 0,
           "merge-and-replay-exact: verbatim merge, drafts, and G1 dry counts match");
        free(efb);
        free(eub);
    }

    /* (5) the estimate sums the longest batch in each ordered wave. */
    {
        char tids[CPD_PW], tfile[CPD_PW], pfile[CPD_PW], tpdir[CPD_PW];
        if (cx_fmt(tids, sizeof tids, "%s/tids.txt", work) ||
            cx_fmt(tfile, sizeof tfile, "%s/times.tsv", work) ||
            cx_fmt(pfile, sizeof pfile, "%s/prio.tsv", work) ||
            cx_fmt(tpdir, sizeof tpdir, "%s/plan-tp", work)) return 2;
        const char *s_tids = "w1\nw2\nb1\nb2\nb3\nb4\nb5\nb6\nb7\nb8\nb9\nb10\n";
        const char *s_tfile =
            "w1\t7000\n"
            "w2\t8000\n"
            "1700000001\tb1\tPASS\t20000\t19500\tfallback\t1.0\trun-batch\n"
            "1700000002\tb2\tPASS\t20000\t19500\tfallback\t1.0\trun-batch\n"
            "1700000003\tb3\tPASS\t20000\t19500\tfallback\t1.0\trun-batch\n"
            "1700000004\tb4\tPASS\t20000\t19500\tfallback\t1.0\trun-batch\n"
            "1700000005\tb5\tPASS\t3000\t2900\tfallback\t1.0\trun-batch\n"
            "1700000006\tb6\tPASS\t3000\t2900\tfallback\t1.0\trun-batch\n"
            "1700000007\tb7\tPASS\t3000\t2900\tfallback\t1.0\trun-batch\n"
            "1700000008\tb8\tPASS\t3000\t2900\tfallback\t1.0\trun-batch\n"
            "1700000009\tb9\tFAIL\t15000\t14500\tfallback\t1.0\trun-batch\n"
            "1700000010\tb10\tFAIL\t18000\t17500\tfallback\t1.0\trun-batch\n";
        const char *s_pfile =
            "b1\tdom\tPASS\t0\taaa\t20000\t1.0\t0\t-\n"
            "b9\tdom\tFAIL\t1\taaa\t15000\t1.0\t0\terr\n"
            "b10\tdom\tUNKNOWN\t124\taaa\t18000\t1.0\t0\ttimeout\n";
        if (cx_write(tids, s_tids, strlen(s_tids)) ||
            cx_write(tfile, s_tfile, strlen(s_tfile)) ||
            cx_write(pfile, s_pfile, strlen(s_pfile))) return 2;
        if (cx_fmt(cmd, sizeof cmd,
            "sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- plan --ids-file '%s' --times-file '%s' --priority-file '%s' --out '%s' --win-size 8 --warmup 2",
            cwd, cwd, tids, tfile, pfile, tpdir)) return 2;
        int rc = ckk_sh("check-prerun-drive", cmd, out, sizeof out);
        char wp[CPD_PW]; size_t wn = 0;
        cx_fmt(wp, sizeof wp, "%s/windows.tsv", tpdir);
        char *wb = (char *)cx_read(wp, &wn);
        /* A 20 s wave cannot share a window with a 3 s tail at a 22 s budget. */
        int prior = ck_failures();
        ck(rc == 0 && wb &&
           tx_find(wb, (long)wn, "W0000\t1\twarmup\t2\tw1,w2\n", 23) >= 0 &&
           tx_find(wb, (long)wn, "W0001\t2\tnormal\t2\tb10,b9\n", 24) >= 0 &&
           rows_have(wb, wn, "W0002\t2\tnormal\t2\tb1,b2\n") &&
           rows_have(wb, wn, "W0003\t2\tnormal\t2\tb3,b4\n") &&
           rows_have(wb, wn, "W0004\t2\tnormal\t4\tb5,b6,b7,b8\n") &&
           ckk_has(out, CPD_OUT, "PRERUN_PLAN\ttotal=12\twindows=5\t"),
           "plan-times-and-priority: priority stays first and normal waves fit the 22s budget");
        if (ck_failures() != prior && wb) printf("PLAN_DETAIL\n%.*s", (int)wn, wb);
        free(wb);
    }

    /* (6) outer window timeout preserves already-completed PASS batches on disk and only retries remaining batches */
    {
        char tdir[CPD_PW], tmock[CPD_PW], tids2[CPD_PW];
        if (cx_fmt(tdir, sizeof tdir, "%s/timeout-keep", work) ||
            cx_fmt(tmock, sizeof tmock, "%s/tmock.sh", work) ||
            cx_fmt(tids2, sizeof tids2, "%s/tids2.txt", work)) return 2;
        if (cx_write(tids2, "p1\np2\np3\np4\n", 12)) return 2;
        const char *tms =
            "#!/bin/sh\n"
            "mode=$1; wid=$2; jobs=$3; ids=$4; out=$5; att=$6\n"
            "echo \"# devsvc qualify\" > \"$out\"\n"
            "printf 'batch\\tdomain\\tstatus\\trc\\tcandidate\\tms\\tload1\\tretries\\tnote\\n' >> \"$out\"\n"
            "if [ \"$att\" = 1 ]; then\n"
            "  printf 'p1\\tproduct-qualification\\tPASS\\t0\\taaa\\t50\\t1.0\\t0\\t-\\n' >> \"$out\"\n"
            "  printf 'RAW\\tBATCH_RUN\\tid=p1\\tstatus=PASS\\trc=0\\tcandidate=aaa\\n' >> \"$out\"\n"
            "  printf 'p2\\tproduct-qualification\\tPASS\\t0\\taaa\\t60\\t1.0\\t0\\t-\\n' >> \"$out\"\n"
            "  printf 'RAW\\tBATCH_RUN\\tid=p2\\tstatus=PASS\\trc=0\\tcandidate=aaa\\n' >> \"$out\"\n"
            "  exit 124\n"
            "fi\n"
            "if [ \"$ids\" != \"p3,p4\" ]; then\n"
            "  printf 'UNEXPECTED_IDS\\tproduct-qualification\\tFAIL\\t1\\taaa\\t10\\t1.0\\t0\\tgot=%s\\n' \"$ids\" >> \"$out\"\n"
            "  exit 1\n"
            "fi\n"
            "printf 'p3\\tproduct-qualification\\tPASS\\t0\\taaa\\t70\\t1.0\\t0\\t-\\n' >> \"$out\"\n"
            "printf 'RAW\\tBATCH_RUN\\tid=p3\\tstatus=PASS\\trc=0\\tcandidate=aaa\\n' >> \"$out\"\n"
            "printf 'p4\\tproduct-qualification\\tPASS\\t0\\taaa\\t80\\t1.0\\t0\\t-\\n' >> \"$out\"\n"
            "printf 'RAW\\tBATCH_RUN\\tid=p4\\tstatus=PASS\\trc=0\\tcandidate=aaa\\n' >> \"$out\"\n"
            "exit 0\n";
        if (cx_write(tmock, tms, strlen(tms))) return 2;
        if (cx_fmt(cmd, sizeof cmd,
            "sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- plan --ids-file '%s' --out '%s' --win-size 8 --warmup 0",
            cwd, cwd, tids2, tdir)) return 2;
        if (ckk_sh("check-prerun-drive", cmd, out, sizeof out) != 0) return 2;
        if (cx_fmt(cmd, sizeof cmd,
            "sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- run --root '%s' --out '%s' --mock-runner '%s' --max-retries 2",
            cwd, cwd, cwd, tdir, tmock)) return 2;
        int rc = ckk_sh("check-prerun-drive", cmd, out, sizeof out);
        char sp[CPD_PW]; size_t sn = 0;
        cx_fmt(sp, sizeof sp, "%s/strict-W0000.tsv", tdir);
        char *sb = (char *)cx_read(sp, &sn);
        ck(rc == 0 && ckk_has(out, CPD_OUT, "PRERUN_RUN\tstatus=DONE\tran=1\t") &&
           sb && tx_find(sb, (long)sn, "p1\tproduct-qualification\tPASS\t", 30) >= 0 &&
           tx_find(sb, (long)sn, "p2\tproduct-qualification\tPASS\t", 30) >= 0 &&
           tx_find(sb, (long)sn, "p3\tproduct-qualification\tPASS\t", 30) >= 0 &&
           tx_find(sb, (long)sn, "p4\tproduct-qualification\tPASS\t", 30) >= 0,
           "run-window-timeout-preserves-completed-batches: keeps p1,p2 on disk after rc=124 and retries only p3,p4");
        free(sb);
    }

    /* (7) prebuild-self window: invokes devsvc prebuild-self, and --keep-going writes done marker and continues past rc=2 instead of stopping */
    {
        char pbdir[CPD_PW], pbroot[CPD_PW], pbcom[CPD_PW], pbids[CPD_PW], out2[CPD_OUT];
        if (cx_fmt(pbdir, sizeof pbdir, "%s/pb-keep", work) ||
            cx_fmt(pbroot, sizeof pbroot, "%s/pbroot", work) ||
            cx_fmt(pbcom, sizeof pbcom, "%s/pbroot/unisacc.com", work) ||
            cx_fmt(pbids, sizeof pbids, "%s/pbids.txt", work)) return 2;
        if (mkdir(pbroot, 0700) != 0 && errno != EEXIST) return 2;
        if (cx_write(pbids, "alpha\nbeta\nreal-commit\n", 23)) return 2;
        const char *pb_launcher =
            "#!/bin/sh\n"
            "case \"$*\" in\n"
            "  *\"tools/devsvc.cx -- prebuild-self\"*) exit 2 ;;\n"
            "  *\"tools/check-real-commit.cx\"*) exit 99 ;;\n"
            "  *\"tools/dvqualify.cx\"*)\n"
            "    out=''; ids=''\n"
            "    while [ $# -gt 0 ]; do\n"
            "      if [ \"$1\" = \"--out\" ]; then out=\"$2\"; shift 2; continue; fi\n"
            "      if [ \"$1\" = \"--ids\" ]; then ids=\"$2\"; shift 2; continue; fi\n"
            "      shift\n"
            "    done\n"
            "    echo \"# devsvc qualify\" > \"$out\"\n"
            "    printf 'batch\\tdomain\\tstatus\\trc\\tcandidate\\tms\\tload1\\tretries\\tnote\\n' >> \"$out\"\n"
            "    for id in $(printf '%s' \"$ids\" | tr ',' ' '); do\n"
            "      printf '%s\\tproduct-qualification\\tPASS\\t0\\taaa\\t50\\t1.0\\t0\\t-\\n' \"$id\" >> \"$out\"\n"
            "    done\n"
            "    exit 0 ;;\n"
            "esac\n"
            "exit 1\n";
        if (cx_write(pbcom, pb_launcher, strlen(pb_launcher))) return 2;
        if (cx_fmt(cmd, sizeof cmd,
            "sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- plan --ids-file '%s' --out '%s' --win-size 8 --warmup 2",
            cwd, cwd, pbids, pbdir)) return 2;
        if (ckk_sh("check-prerun-drive", cmd, out, sizeof out) != 0) return 2;
        /* Without --keep-going: stops at W0001 prebuild-self rc=2 (proving tools/devsvc.cx -- prebuild-self was called, not check-real-commit which exits 99) */
        if (cx_fmt(cmd, sizeof cmd,
            "sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- run --root '%s' --candidate '%s' --out '%s'",
            cwd, cwd, pbroot, pbcom, pbdir)) return 2;
        int rc_stop = ckk_sh("check-prerun-drive", cmd, out, sizeof out);
        int ok_stop = (rc_stop == 1 && ckk_has(out, CPD_OUT, "PRERUN_STOP\twindow=W0001\tphase=prebuild-self\trc=2"));
        /* With --keep-going (and --resume): writes done.W0001 marker, emits PRERUN_KEEP_GOING, and completes W0002 real-commit */
        if (cx_fmt(cmd, sizeof cmd,
            "sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- run --root '%s' --candidate '%s' --out '%s' --resume --keep-going",
            cwd, cwd, pbroot, pbcom, pbdir)) return 2;
        int rc_kg = ckk_sh("check-prerun-drive", cmd, out, sizeof out);
        int rc_res = ckk_sh("check-prerun-drive", cmd, out2, sizeof out2);
        ck(ok_stop && rc_kg == 0 && rc_res == 0 &&
           ckk_has(out, CPD_OUT, "PRERUN_KEEP_GOING\tbatch=prebuild-self\tretries=1\twindow=W0001\traw=prebuild-self rc=2") &&
           ckk_has(out, CPD_OUT, "PRERUN_RUN\tstatus=DONE\tran=2\tskipped=1\t") &&
           ckk_has(out2, CPD_OUT, "PRERUN_RUN\tstatus=DONE\tran=0\tskipped=3\t"),
           "prebuild-self-devsvc-and-keep-going: calls devsvc prebuild-self and under --keep-going writes done marker and continues past rc=2");
    }

    {
        char ix[CPD_PW], times[CPD_PW], plan[CPD_PW], log[CPD_PW], windows[CPD_PW], archived[CPD_PW];
        const char *fixture_ids = "cold-a\ncold-b\nlong\nlong-b\nlong-c\nunknown-cost\n";
        const char *fixture_times = "cold-a\t12000\ncold-b\t12000\nlong\t42000\nlong-b\t41000\nlong-c\t37000\nlong\t500\n";
        const char *log_text = "PRERUN_SUPERVISE_DONE\trun_rc=0\tmerge_rc=0\n";
        if (cx_fmt(ix,sizeof ix,"%s/budget-ids",work) || cx_fmt(times,sizeof times,"%s/budget-times",work) ||
            cx_fmt(plan,sizeof plan,"%s/budget",work) || cx_fmt(log,sizeof log,"%s/supervise.log",plan) ||
            cx_fmt(windows,sizeof windows,"%s/windows.tsv",plan) ||
            cx_fmt(archived,sizeof archived,"%s/release/evidence/0.0.87/prerun-supervise.log",work))return 2;
        if (cx_write(ix,fixture_ids,strlen(fixture_ids)) || cx_write(times,fixture_times,strlen(fixture_times)))return 2;
        if (cx_fmt(cmd,sizeof cmd,"sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- plan --ids-file '%s' --times-file '%s' --out '%s' --warmup 2",cwd,cwd,ix,times,plan))return 2;
        int rc=ckk_sh("check-prerun-drive",cmd,out,sizeof out);
        size_t n=0;
        char *w=(char *)cx_read(windows,&n);
        ck(rc==0&&rows_have(w,n,"W0000\t1\twarmup\t1\tcold-a\n"),"timed-warmup-fits-serial-budget");
        ck(rc==0&&rows_have(w,n,"W0001\t1\tlong\t1\tlong\n")&&
           rows_have(w,n,"W0002\t1\tlong\t1\tlong-b\n")&&
           rows_have(w,n,"W0003\t1\tlong\t1\tlong-c\n")&&
           rows_have(w,n,"W0005\t2\tnormal\t1\tcold-b\n"),"long-batches-use-exclusive-windows-and-keep-max-observation");
        ck(rc==0&&rows_have(w,n,"W0004\t1\tlong\t1\tunknown-cost\n")&&
           ckk_has(out,CPD_OUT,"wave_ms=166000\tmax_window_ms=42000"),"unknown-cost-reserves-a-full-window");
        if(cx_fmt(cmd,sizeof cmd,"sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- run --root '%s' --out '%s' --mock-runner missing --max-jobs 1",cwd,cwd,work,plan))return 2;
        rc=ckk_sh("check-prerun-drive",cmd,out,sizeof out);
        ck(rc==2&&ckk_has(out,CPD_OUT,"reason=timed-plan-exceeds-max-jobs"),"timed-run-rejects-width-below-the-plan");
        const char *missing = "#!/bin/sh\nexit 124\n";
        char mock[CPD_PW], done[CPD_PW];
        if(cx_fmt(mock,sizeof mock,"%s/missing.sh",work)||cx_fmt(done,sizeof done,"%s/done.W0000",plan)||
           cx_write(mock,missing,strlen(missing)))return 2;
        if(cx_fmt(cmd,sizeof cmd,"sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- run --root '%s' --out '%s' --mock-runner '%s' --max-retries 1 --keep-going",cwd,cwd,work,plan,mock))return 2;
        rc=ckk_sh("check-prerun-drive",cmd,out,sizeof out);
        ck(rc==1&&ckk_has(out,CPD_OUT,"wall_ms=")&&ckk_has(out,CPD_OUT,"raw=timed-window-missing-evidence rc=124")&&sy_exists(done)==0,
           "timed-timeout-logs-attempt-and-leaves-unfinished-window-resumable");
        if(cx_write(log,log_text,strlen(log_text)))return 2;
        if(cx_fmt(cmd,sizeof cmd,"sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- archive --in-dir '%s' --repo '%s' --version 0.0.87",cwd,cwd,plan,work))return 2;
        rc=ckk_sh("check-prerun-drive",cmd,out,sizeof out);
        size_t ln=0,wn=0;
        char *l=(char *)cx_read(archived,&ln);
        if(cx_fmt(archived,sizeof archived,"%s/release/evidence/0.0.87/prerun-windows.tsv",work))return 2;
        char *a=(char *)cx_read(archived,&wn);
        ck(rc==0&&l&&tx_same(l,ln,log_text,strlen(log_text))&&w&&a&&tx_same(w,n,a,wn),"archive-preserves-window-plan-and-supervisor-log");
        free(l);free(a);free(w);
        if(cx_write(log,"changed\n",8))return 2;
        rc=ckk_sh("check-prerun-drive",cmd,out,sizeof out);
        if(cx_fmt(archived,sizeof archived,"%s/release/evidence/0.0.87/prerun-supervise.log",work))return 2;
        l=(char *)cx_read(archived,&ln);
        ck(rc==2&&ckk_has(out,CPD_OUT,"archive-destination-exists")&&l&&
           tx_same(l,ln,log_text,strlen(log_text)),"archive-refuses-overwrite-and-preserves-evidence");
        free(l);
        const char *other_home="root=/" "home/prerun-test-other/source\n";
        if(cx_write(log,other_home,strlen(other_home))||
           cx_fmt(cmd,sizeof cmd,"sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- archive --in-dir '%s' --repo '%s' --version 0.0.88",cwd,cwd,plan,work))return 2;
        rc=ckk_sh("check-prerun-drive",cmd,out,sizeof out);
        ck(rc==2&&ckk_has(out,CPD_OUT,"archive-unresolved-home-path"),"archive-refuses-foreign-personal-path");

        if(cx_write(times,"",0)||cx_fmt(cmd,sizeof cmd,"sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- plan --ids-file '%s' --times-file '%s' --out '%s'",cwd,cwd,ix,times,plan))return 2;
        rc=ckk_sh("check-prerun-drive",cmd,out,sizeof out);
        ck(rc==2&&ckk_has(out,CPD_OUT,"read-times-file"),"plan-refuses-empty-timings-file");
        char many[10000]; size_t used=0;
        for(int i=0;i<514;i++) {
            if(cx_fmt(many+used,sizeof many-used,"coverage-%d\n",i))return 2;
            used+=strlen(many+used);
        }
        if(cx_write(ix,many,used)||cx_write(times,"coverage-0\t1000\n",16))return 2;
        rc=ckk_sh("check-prerun-drive",cmd,out,sizeof out);
        ck(rc==2&&ckk_has(out,CPD_OUT,"window-plan-did-not-cover-every-batch"),"plan-refuses-unrepresented-batches");

        /* Default warmup with --times-file: picks 1 lightest batch into W0000 */
        {
            char wids[CPD_PW], wtimes[CPD_PW], wplan[CPD_PW], wwin[CPD_PW];
            const char *f_ids = "heavy-first\nmid-second\nlightest-third\n";
            const char *f_times = "heavy-first\t20000\nmid-second\t12000\nlightest-third\t900\n";
            if (cx_fmt(wids, sizeof wids, "%s/w1-ids.txt", work) ||
                cx_fmt(wtimes, sizeof wtimes, "%s/w1-times.tsv", work) ||
                cx_fmt(wplan, sizeof wplan, "%s/w1-plan", work) ||
                cx_fmt(wwin, sizeof wwin, "%s/windows.tsv", wplan) ||
                cx_write(wids, f_ids, strlen(f_ids)) ||
                cx_write(wtimes, f_times, strlen(f_times)) ||
                cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- plan --ids-file '%s' --times-file '%s' --out '%s'",
                       cwd, cwd, wids, wtimes, wplan)) return 2;
            int rc_w1 = ckk_sh("check-prerun-drive", cmd, out, sizeof out);
            size_t w1n = 0;
            char *w1b = (char *)cx_read(wwin, &w1n);
            ck(rc_w1 == 0 && rows_have(w1b, w1n, "W0000\t1\twarmup\t1\tlightest-third\n"),
               "timed-default-warmup-single-lightest: default warmup with times-file places 1 lightest batch in W0000");
            free(w1b);
        }

        /* S3: missing/empty --ids-file and nb >= release-prep MAXB(1024) refused before start */
        {
            char s3dir[CPD_PW], s3w[CPD_PW], s3ids[CPD_PW], out_1023[CPD_OUT], out_1024[CPD_OUT], out_1767[CPD_OUT], out_run[CPD_OUT];
            if (cx_fmt(s3dir, sizeof s3dir, "%s/s3-missing", work) ||
                cx_fmt(s3w, sizeof s3w, "%s/windows.tsv", s3dir) ||
                cx_fmt(s3ids, sizeof s3ids, "%s/s3-ids.txt", work)) return 2;
            if (cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- plan --out '%s'", cwd, cwd, s3dir)) return 2;
            int rc_no_ids = ckk_sh("check-prerun-drive", cmd, out, sizeof out);
            int has_no_ids = ckk_has(out, CPD_OUT, "plan-requires-ids-file");
            if (cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- plan --ids-file '' --out '%s'", cwd, cwd, s3dir)) return 2;
            int rc_empty_arg = ckk_sh("check-prerun-drive", cmd, out_1023, sizeof out_1023);
            ck(rc_no_ids == 2 && has_no_ids && rc_empty_arg == 2 && ckk_has(out_1023, CPD_OUT, "plan-requires-ids-file") && sy_exists(s3w) == 0,
               "plan-refuses-missing-or-empty-ids-file");

            char *big = (char *)mm_alloc(32768);
            if (!big) return 2;
            size_t bp2 = 0;
            for (int i = 0; i < 1023; i++) {
                char row[32]; cx_fmt(row, sizeof row, "b-%04d\n", i);
                mm_copy(big + bp2, 32768 - bp2, row, strlen(row)); bp2 += strlen(row);
            }
            if (cx_write(s3ids, big, bp2) ||
                cx_fmt(s3dir, sizeof s3dir, "%s/s3-1023", work) ||
                cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- plan --ids-file '%s' --out '%s'", cwd, cwd, s3ids, s3dir)) return 2;
            int rc_1023 = ckk_sh("check-prerun-drive", cmd, out_1023, sizeof out_1023);
            ck(rc_1023 == 0 && ckk_has(out_1023, CPD_OUT, "PRERUN_PLAN\ttotal=1023\t"),
               "plan-allows-1023-below-maxb");

            {
                char row[32]; cx_fmt(row, sizeof row, "b-1023\n");
                mm_copy(big + bp2, 32768 - bp2, row, strlen(row)); bp2 += strlen(row);
            }
            if (cx_write(s3ids, big, bp2) ||
                cx_fmt(s3dir, sizeof s3dir, "%s/s3-1024", work) ||
                cx_fmt(s3w, sizeof s3w, "%s/windows.tsv", s3dir) ||
                cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- plan --ids-file '%s' --out '%s'", cwd, cwd, s3ids, s3dir)) return 2;
            int rc_1024 = ckk_sh("check-prerun-drive", cmd, out_1024, sizeof out_1024);

            for (int i = 1024; i < 1767; i++) {
                char row[32]; cx_fmt(row, sizeof row, "b-%04d\n", i);
                mm_copy(big + bp2, 32768 - bp2, row, strlen(row)); bp2 += strlen(row);
            }
            char s3dir1767[CPD_PW], s3w1767[CPD_PW];
            if (cx_write(s3ids, big, bp2) ||
                cx_fmt(s3dir1767, sizeof s3dir1767, "%s/s3-1767", work) ||
                cx_fmt(s3w1767, sizeof s3w1767, "%s/windows.tsv", s3dir1767) ||
                cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- plan --ids-file '%s' --out '%s'", cwd, cwd, s3ids, s3dir1767)) return 2;
            int rc_1767 = ckk_sh("check-prerun-drive", cmd, out_1767, sizeof out_1767);
            ck(rc_1024 == 2 && ckk_has(out_1024, CPD_OUT, "PRERUN_MAXB_EXCEEDED\tbatches=1024\tmaxb=1024") &&
               ckk_has(out_1024, CPD_OUT, "reason=batch-count-reaches-release-prep-maxb-1024") && sy_exists(s3w) == 0 &&
               rc_1767 == 2 && ckk_has(out_1767, CPD_OUT, "PRERUN_MAXB_EXCEEDED\tbatches=1767\tmaxb=1024") &&
               ckk_has(out_1767, CPD_OUT, "reason=batch-count-reaches-release-prep-maxb-1024") && sy_exists(s3w1767) == 0,
               "plan-refuses-1024-at-maxb-and-1767-before-writing-windows");

            /* Also verify run refuses a pre-existing windows.tsv with >= 1024 batches before starting W0000 */
            char r1024[CPD_PW], rw1024[CPD_PW], rs0[CPD_PW];
            if (cx_fmt(r1024, sizeof r1024, "%s/s3-run1024", work) || sy_mkdir_all(r1024, 0700) ||
                cx_fmt(rw1024, sizeof rw1024, "%s/windows.tsv", r1024) ||
                cx_fmt(rs0, sizeof rs0, "%s/strict-W0000.tsv", r1024)) return 2;
            bp2 = 0;
            const char *wh = "# prerun-drive windows\nwindow\tjobs\tphase\tcount\tids\n";
            mm_copy(big, 32768, wh, strlen(wh)); bp2 = strlen(wh);
            for (int w = 0; w < 128; w++) {
                char row[160];
                cx_fmt(row, sizeof row, "W%04d\t2\tnormal\t8\tb%d_0,b%d_1,b%d_2,b%d_3,b%d_4,b%d_5,b%d_6,b%d_7\n", w, w, w, w, w, w, w, w, w);
                mm_copy(big + bp2, 32768 - bp2, row, strlen(row)); bp2 += strlen(row);
            }
            if (cx_write(rw1024, big, bp2) ||
                cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- run --root '%s' --out '%s' --mock-runner '%s'", cwd, cwd, work, r1024, mock)) return 2;
            int rc_run1024 = ckk_sh("check-prerun-drive", cmd, out_run, sizeof out_run);
            ck(rc_run1024 == 2 && ckk_has(out_run, CPD_OUT, "PRERUN_MAXB_EXCEEDED\tbatches=1024\tmaxb=1024") &&
               ckk_has(out_run, CPD_OUT, "reason=batch-count-reaches-release-prep-maxb-1024") && sy_exists(rs0) == 0,
               "run-refuses-windows-tsv-at-maxb-before-start");
            mm_free(big);
        }

        /* prebuild-self in a git repo warms candidate APE inside qualify layout's private .git, never root/unisacc.com */
        {
            char groot[CPD_PW], gwrong[CPD_PW], gcand[CPD_PW], gdir[CPD_PW], gids[CPD_PW], grec[CPD_PW], gtmp[CPD_PW];
            if (cx_fmt(groot, sizeof groot, "%s/groot", work) ||
                cx_fmt(gwrong, sizeof gwrong, "%s/groot/unisacc.com", work) ||
                cx_fmt(gcand, sizeof gcand, "%s/cand-ape.com", work) ||
                cx_fmt(gdir, sizeof gdir, "%s/gplan", work) ||
                cx_fmt(gids, sizeof gids, "%s/gids.txt", work) ||
                cx_fmt(grec, sizeof grec, "%s/prebuild-receipt.txt", work) ||
                cx_fmt(gtmp, sizeof gtmp, "%s/gtmp", work)) return 2;
            if (sy_mkdir_all(groot, 0700) || sy_mkdir_all(gtmp, 0700)) return 2;
            /* root/unisacc.com is the old installed product and must NEVER be invoked for prebuild-self when --candidate is gcand */
            const char *gwrong_s =
                "#!/bin/sh\n"
                "case \"$*\" in\n"
                "  *\"tools/devsvc.cx -- prebuild-self\"*) exit 99 ;;\n"
                "  *\"tools/dvqualify.cx\"*)\n"
                "    out=''\n"
                "    while [ $# -gt 0 ]; do\n"
                "      if [ \"$1\" = \"--out\" ]; then out=\"$2\"; shift 2; continue; fi\n"
                "      shift\n"
                "    done\n"
                "    echo \"# devsvc qualify\" > \"$out\"\n"
                "    printf 'batch\\tdomain\\tstatus\\trc\\tcandidate\\tms\\tload1\\tretries\\tnote\\n' >> \"$out\"\n"
                "    printf 'real-commit\\tproduct-qualification\\tPASS\\t0\\taaa\\t50\\t1.0\\t0\\t-\\n' >> \"$out\"\n"
                "    exit 0 ;;\n"
                "esac\n"
                "exit 99\n";
            if (cx_write(gwrong, gwrong_s, strlen(gwrong_s))) return 2;
            char cand_script[2048];
            if (cx_fmt(cand_script, sizeof cand_script,
                "#!/bin/sh\n"
                "# CANDIDATE_APE_MARKER_V088\n"
                "case \"$*\" in\n"
                "  *\"tools/devsvc.cx -- prebuild-self\"*)\n"
                "    gdir=$(git rev-parse --path-format=absolute --git-dir 2>/dev/null)\n"
                "    printf 'PWD=%%s\\nGITDIR=%%s\\nMARKER=' \"$(pwd)\" \"$gdir\" > '%s'\n"
                "    grep -o 'CANDIDATE_APE_MARKER_V088' ./unisacc.com >> '%s'\n"
                "    exit 0 ;;\n"
                "  *\"tools/dvqualify.cx\"*)\n"
                "    out=''\n"
                "    while [ $# -gt 0 ]; do\n"
                "      if [ \"$1\" = \"--out\" ]; then out=\"$2\"; shift 2; continue; fi\n"
                "      shift\n"
                "    done\n"
                "    echo \"# devsvc qualify\" > \"$out\"\n"
                "    printf 'batch\\tdomain\\tstatus\\trc\\tcandidate\\tms\\tload1\\tretries\\tnote\\n' >> \"$out\"\n"
                "    printf 'real-commit\\tproduct-qualification\\tPASS\\t0\\taaa\\t50\\t1.0\\t0\\t-\\n' >> \"$out\"\n"
                "    exit 0 ;;\n"
                "esac\n"
                "exit 1\n", grec, grec)) return 2;
            if (cx_write(gcand, cand_script, strlen(cand_script)) ||
                cx_write(gids, "real-commit\n", 12)) return 2;
            if (cx_fmt(cmd, sizeof cmd,
                "cd '%s' && mkdir -p tools && echo ok > tools/stub.txt && "
                "git init -q && git config user.name t && git config user.email t@t && git config commit.gpgsign false && "
                "git add tools/stub.txt && git commit -qm init", groot)) return 2;
            if (ckk_sh("check-prerun-drive", cmd, out, sizeof out) != 0) return 2;
            if (cx_fmt(cmd, sizeof cmd,
                "sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- plan --ids-file '%s' --out '%s' --warmup 0",
                cwd, cwd, gids, gdir)) return 2;
            if (ckk_sh("check-prerun-drive", cmd, out, sizeof out) != 0) return 2;
            if (cx_fmt(cmd, sizeof cmd,
                "TMPDIR='%s' sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- run --root '%s' --candidate '%s' --out '%s' && cat '%s'",
                gtmp, cwd, cwd, groot, gcand, gdir, grec)) return 2;
            int rc_gp = ckk_sh("check-prerun-drive", cmd, out, sizeof out);
            ck(rc_gp == 0 &&
               ckk_has(out, CPD_OUT, "/unisacc-qualify-") &&
               ckk_has(out, CPD_OUT, "/tree-") &&
               ckk_has(out, CPD_OUT, "/.git\n") &&
               ckk_has(out, CPD_OUT, "MARKER=CANDIDATE_APE_MARKER_V088"),
               "prebuild-self-uses-candidate-and-qualify-layout-git: warms candidate APE inside qualify layout private .git");
        }

        /* Early canary scheduling (ri-image-*, lane-key-probes in W0001 before heavy netregen) +
         * first product-qualification FAIL stops immediately even under --keep-going */
        {
            char cids[CPD_PW], ctimes[CPD_PW], cplan[CPD_PW], cwin[CPD_PW], cmock[CPD_PW], cw2[CPD_PW];
            const char *f_cids =
                "light-warm\n"
                "netregen-small-lnx-x86_64\n"
                "normal-late\n"
                "lane-key-probes\n"
                "ri-image-single\n"
                "ri-image-pem\n"
                "ri-image-multi\n";
            const char *f_ctimes =
                "light-warm\t800\n"
                "netregen-small-lnx-x86_64\t35000\n"
                "normal-late\t4000\n"
                "lane-key-probes\t3000\n"
                "ri-image-single\t2000\n"
                "ri-image-pem\t2000\n"
                "ri-image-multi\t2000\n";
            if (cx_fmt(cids, sizeof cids, "%s/can-ids.txt", work) ||
                cx_fmt(ctimes, sizeof ctimes, "%s/can-times.tsv", work) ||
                cx_fmt(cplan, sizeof cplan, "%s/can-plan", work) ||
                cx_fmt(cwin, sizeof cwin, "%s/windows.tsv", cplan) ||
                cx_fmt(cmock, sizeof cmock, "%s/can-mock.sh", work) ||
                cx_fmt(cw2, sizeof cw2, "%s/strict-W0002.tsv", cplan) ||
                cx_write(cids, f_cids, strlen(f_cids)) ||
                cx_write(ctimes, f_ctimes, strlen(f_ctimes))) return 2;
            if (cx_fmt(cmd, sizeof cmd,
                "sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- plan --ids-file '%s' --times-file '%s' --out '%s'",
                cwd, cwd, cids, ctimes, cplan)) return 2;
            int rc_cp = ckk_sh("check-prerun-drive", cmd, out, sizeof out);
            size_t cwn = 0;
            char *cwb = (char *)cx_read(cwin, &cwn);
            ck(rc_cp == 0 &&
               rows_have(cwb, cwn, "W0000\t1\twarmup\t1\tlight-warm\n") &&
               rows_have(cwb, cwn, "W0001\t2\tnormal\t4\tlane-key-probes,ri-image-single,ri-image-pem,ri-image-multi\n") &&
               rows_have(cwb, cwn, "W0002\t1\theavy\t1\tnetregen-small-lnx-x86_64\n"),
               "early-canary-before-heavy: schedules ri-image-* and lane-key-probes in W0001 ahead of heavy netregen");
            free(cwb);

            const char *cmock_s =
                "#!/bin/sh\n"
                "mode=$1; wid=$2; jobs=$3; ids=$4; out=$5\n"
                "echo \"# devsvc qualify\" > \"$out\"\n"
                "printf 'batch\\tdomain\\tstatus\\trc\\tcandidate\\tms\\tload1\\tretries\\tnote\\n' >> \"$out\"\n"
                "for id in $(printf '%s' \"$ids\" | tr ',' ' '); do\n"
                "  if [ \"$id\" = ri-image-single ]; then\n"
                "    printf 'ri-image-single\\tproduct-qualification\\tFAIL\\t2\\taaa\\t2000\\t1.0\\t0\\tcapture-ledger-write\\n' >> \"$out\"\n"
                "  else\n"
                "    printf '%s\\tproduct-qualification\\tPASS\\t0\\taaa\\t50\\t1.0\\t0\\t-\\n' \"$id\" >> \"$out\"\n"
                "  fi\n"
                "done\n"
                "case \"$ids\" in *ri-image-single*) exit 1 ;; esac\n"
                "exit 0\n";
            if (cx_write(cmock, cmock_s, strlen(cmock_s))) return 2;
            if (cx_fmt(cmd, sizeof cmd,
                "sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- run --root '%s' --out '%s' --mock-runner '%s' --max-jobs 2 --max-retries 1 --keep-going",
                cwd, cwd, work, cplan, cmock)) return 2;
            int rc_cr = ckk_sh("check-prerun-drive", cmd, out, sizeof out);
            ck(rc_cr == 1 &&
               ckk_has(out, CPD_OUT, "PRERUN_PRODUCT_RED_STOP\tbatch=ri-image-single\tdomain=product-qualification\tstatus=FAIL\trc=2\t") &&
               ckk_has(out, CPD_OUT, "PRERUN_STOP\tbatch=ri-image-single\t") &&
               sy_exists(cw2) == 0,
               "first-product-qualification-fail-stops-under-keep-going: halts at W0001 product FAIL without dispatching W0002");
        }

        /* (10d) warmup excludes expected-unmeasured (tools-default-regression, cx-booter-ape),
         *       and run pins frozen-source.rev + frozen-root so a mid-prerun commit to --root
         *       never changes # source= in subsequent windows (while actual drift fails closed). */
        {
            char u_ids[CPD_PW], u_times[CPD_PW], u_plan[CPD_PW], u_win[CPD_PW];
            char fgit[CPD_PW], fmock[CPD_PW], fdrift[CPD_PW];
            const char *s_uids =
                "tools-default-regression\n"
                "cx-booter-ape\n"
                "runnable-light\n"
                "runnable-two\n";
            const char *s_utimes =
                "tools-default-regression\t50\n"
                "cx-booter-ape\t60\n"
                "runnable-light\t200\n"
                "runnable-two\t500\n";
            if (cx_fmt(u_ids, sizeof u_ids, "%s/u-ids.txt", work) ||
                cx_fmt(u_times, sizeof u_times, "%s/u-times.tsv", work) ||
                cx_fmt(u_plan, sizeof u_plan, "%s/u-plan", work) ||
                cx_fmt(u_win, sizeof u_win, "%s/windows.tsv", u_plan) ||
                cx_fmt(fgit, sizeof fgit, "%s/fgit-repo", work) ||
                cx_fmt(fmock, sizeof fmock, "%s/fgit-mock.sh", work) ||
                cx_fmt(fdrift, sizeof fdrift, "%s/fgit-drift.sh", work) ||
                cx_write(u_ids, s_uids, strlen(s_uids)) ||
                cx_write(u_times, s_utimes, strlen(s_utimes))) return 2;
            if (cx_fmt(cmd, sizeof cmd,
                "sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- plan --ids-file '%s' --times-file '%s' --out '%s'",
                cwd, cwd, u_ids, u_times, u_plan)) return 2;
            int rc_up = ckk_sh("check-prerun-drive", cmd, out, sizeof out);
            size_t uwn = 0;
            char *uwb = (char *)cx_read(u_win, &uwn);
            ck(rc_up == 0 && rows_have(uwb, (long)uwn, "W0000\t1\twarmup\t1\trunnable-light\n"),
               "warmup-excludes-expected-unmeasured: skips tools-default-regression and cx-booter-ape for runnable-light");
            free(uwb);

            const char *fmock_s =
                "#!/bin/sh\n"
                "mode=$1; wid=$2; jobs=$3; ids=$4; out=$5\n"
                "cur_rev=$(git rev-parse HEAD)\n"
                "printf '# devsvc qualify\\n# source=%s\\nbatch\\tdomain\\tstatus\\trc\\tcandidate\\tms\\tload1\\tretries\\tnote\\n' \"$cur_rev\" > \"$out\"\n"
                "for id in $(printf '%s' \"$ids\" | tr ',' ' '); do\n"
                "  printf '%s\\tproduct-qualification\\tPASS\\t0\\taaa\\t50\\t1.0\\t0\\t-\\n' \"$id\" >> \"$out\"\n"
                "done\n"
                "if [ \"$wid\" = W0000 ] && [ -n \"$FGIT_ORIG_ROOT\" ]; then\n"
                "  printf 'mid-prerun\\n' >> \"$FGIT_ORIG_ROOT/a.txt\"\n"
                "  git -C \"$FGIT_ORIG_ROOT\" add a.txt && git -C \"$FGIT_ORIG_ROOT\" commit -q -m 'mid prerun commit'\n"
                "fi\n"
                "exit 0\n";
            const char *fdrift_s =
                "#!/bin/sh\n"
                "mode=$1; wid=$2; jobs=$3; ids=$4; out=$5\n"
                "printf '# devsvc qualify\\n# source=deadbeefdeadbeefdeadbeefdeadbeefdeadbeef\\nbatch\\tdomain\\tstatus\\trc\\tcandidate\\tms\\tload1\\tretries\\tnote\\n' > \"$out\"\n"
                "for id in $(printf '%s' \"$ids\" | tr ',' ' '); do\n"
                "  printf '%s\\tproduct-qualification\\tPASS\\t0\\taaa\\t50\\t1.0\\t0\\t-\\n' \"$id\" >> \"$out\"\n"
                "done\n"
                "exit 0\n";
            if (cx_write(fmock, fmock_s, strlen(fmock_s)) ||
                cx_write(fdrift, fdrift_s, strlen(fdrift_s))) return 2;
            if (cx_fmt(cmd, sizeof cmd,
                "mkdir -p '%s' && cd '%s' && git init -q && git config user.name ptest && git config user.email ptest@localhost && "
                "printf 'init\\n' > a.txt && git add a.txt && git commit -q -m init && "
                "REV_A=$(git rev-parse HEAD) && "
                "FGIT_ORIG_ROOT='%s' sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- run --root '%s' --out '%s' --mock-runner '%s' --max-jobs 2 && "
                "REV_B=$(git -C '%s' rev-parse HEAD) && [ \"$REV_A\" != \"$REV_B\" ] && "
                "grep -q \"^# source=$REV_A$\" '%s/strict-W0000.tsv' && "
                "grep -q \"^# source=$REV_A$\" '%s/strict-W0001.tsv' && "
                "echo FROZEN_SOURCE_STABLE_OK",
                fgit, fgit, fgit, cwd, cwd, fgit, u_plan, fmock, fgit, u_plan, u_plan)) return 2;
            int rc_fr = ckk_sh("check-prerun-drive", cmd, out, sizeof out);
            ck(rc_fr == 0 &&
               ckk_has(out, CPD_OUT, "PRERUN_FROZEN_SOURCE\trev=") &&
               ckk_has(out, CPD_OUT, "PRERUN_WARMUP_READY\twindow=W0000\tids=runnable-light\tlayout=ready\tkit=ready") &&
               ckk_has(out, CPD_OUT, "FROZEN_SOURCE_STABLE_OK"),
               "frozen-source-ignores-mid-prerun-shared-root-commit-and-verifies-warmup-ready");

            if (cx_fmt(cmd, sizeof cmd,
                "rm -f '%s'/done.W* '%s'/strict-W* && "
                "sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- run --root '%s' --out '%s' --mock-runner '%s' --max-jobs 2 --keep-going",
                u_plan, u_plan, cwd, cwd, fgit, u_plan, fdrift)) return 2;
            int rc_dr = ckk_sh("check-prerun-drive", cmd, out, sizeof out);
            ck(rc_dr == 1 &&
               ckk_has(out, CPD_OUT, "PRERUN_SOURCE_DRIFT\tstatus=FAIL\twindow=W0000\texpected=") &&
               ckk_has(out, CPD_OUT, "\tactual=deadbeefdeadbeefdeadbeefdeadbeefdeadbeef"),
               "window-source-drift-fails-closed: rejects window evidence whose source SHA differs from frozen-source.rev");
        }
    }

    {
        char plan[CPD_PW], windows[CPD_PW], mock[CPD_PW], allow[CPD_PW], merged[CPD_PW];
        const char *layout =
            "# prerun-drive windows\n# timing=wave-v1 jobs=2 budget_ms=22000\n"
            "window\tjobs\tphase\tcount\tids\n"
            "W0000\t2\tnormal\t4\tp1,p2,p3,p4\n"
            "W0001\t1\tlong\t1\tlater\n";
        const char *script =
            "#!/bin/sh\n"
            "if [ \"$3\" = 2 ]; then printf 'p1\\tdom\\tPASS\\t0\\taaa\\t5\\n' > \"$5\"; exit 124; fi\n"
            "if [ \"$4\" = p3 ] && [ ! -f allow-serial ]; then exit 124; fi\n"
            "if [ \"$4\" = p4 ]; then printf 'p4\\tdom\\tFAIL\\t1\\taaa\\t7\\n' > \"$5\"; exit 1; fi\n"
            "printf '%s\\tdom\\tPASS\\t0\\taaa\\t6\\n' \"$4\" > \"$5\"\n";
        if(cx_fmt(plan,sizeof plan,"%s/recovery",work)||sy_mkdir_all(plan,0700)||
           cx_fmt(windows,sizeof windows,"%s/windows.tsv",plan)||cx_write(windows,layout,strlen(layout))||
           cx_fmt(mock,sizeof mock,"%s/recover.sh",work)||cx_write(mock,script,strlen(script))||
           cx_fmt(allow,sizeof allow,"%s/allow-serial",work)||
           cx_fmt(merged,sizeof merged,"%s/strict-final.tsv",plan))return 2;
        if(cx_fmt(cmd,sizeof cmd,"sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- run --root '%s' --out '%s' --mock-runner '%s' --resume --max-retries 1 --keep-going",cwd,cwd,work,plan,mock))return 2;
        int rc=ckk_sh("check-prerun-drive",cmd,out,sizeof out);
        ck(rc==1&&ckk_has(out,CPD_OUT,"from_jobs=2\tto_jobs=1\tremaining=p2,p3,p4")&&
           ckk_has(out,CPD_OUT,"PRERUN_INCOMPLETE\tbatch=p3\twindow=W0000.z03")&&
           ckk_has(out,CPD_OUT,"PRERUN_KEEP_GOING\tbatch=p4\tretries=1\twindow=W0000.z04\traw=serial-recovery-FAIL")&&
           !ckk_has(out,CPD_OUT,"PRERUN_STOP\t")&&
           ckk_has(out,CPD_OUT,"window=W0000.z02\tphase=serial-recovery\tattempt=1\tjobs=1\trc=0")&&
           ckk_has(out,CPD_OUT,"window=W0001\tphase=long\tattempt=1\tjobs=1\trc=0")&&
           ckk_has(out,CPD_OUT,"PRERUN_RUN\tstatus=INCOMPLETE\tran=1\tskipped=0\tmissing_windows=1"),
           "parallel-timeout-splits-remaining-and-runs-later-windows");
        if(cx_write(allow,"ok\n",3))return 2;
        rc=ckk_sh("check-prerun-drive",cmd,out,sizeof out);
        ck(rc==0&&ckk_has(out,CPD_OUT,"window=W0000.z03\tphase=serial-recovery\tattempt=1\tjobs=1\trc=0")&&
           !ckk_has(out,CPD_OUT,"window=W0000.z02\tphase=serial-recovery")&&
           ckk_has(out,CPD_OUT,"PRERUN_RUN\tstatus=DONE\tran=1\tskipped=1"),
           "resume-only-runs-unfinished-serial-child");
        if(cx_fmt(cmd,sizeof cmd,"sh '%s/unisacc.com' '%s/tools/prerun-drive.cx' -- merge --in-dir '%s' --out '%s'",cwd,cwd,plan,plan))return 2;
        rc=ckk_sh("check-prerun-drive",cmd,out,sizeof out);
        size_t mn=0; char *m=(char *)cx_read(merged,&mn);
        ck(rc==0&&ckk_has(out,CPD_OUT,"batches=5\tPASS=4\tFAIL=1\tUNKNOWN=0")&&
           rows_have(m,mn,"p1\tdom\tPASS\t0\taaa\t5\n")&&rows_have(m,mn,"p3\tdom\tPASS\t0\taaa\t6\n"),
           "merge-preserves-original-and-recovered-batch-rows");
        free(m);
    }

    { char *rmv[] = {"rm", "-rf", work, 0}; (void)ck_run(rmv, out, sizeof out); }
    printf("CHECK_PRERUN_DRIVE\tok=%d\tfailed=%d\tms=%ld\n", ck_assertions() - ck_failures(), ck_failures(), sy_now_ms() - t0);
    return ck_failures() ? 1 : 0;
}
