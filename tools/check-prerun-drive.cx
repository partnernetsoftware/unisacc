            cx_fmt(o15m, sizeof o15m, "%s/out-mut", f15)) return 2;
        const char *s_ids15 = "w-fast\nmodule-units\n";
        const char *s_tf15 =
            "1795307628\tw-fast\tPASS\t1200\t1100\tfallback\t1.0\trun-batch\n"
            "1795307628\tmodule-units\tFAIL\t53106\t53026\tfallback\t6.48\trun-batch\n"
            "1795326253\tmodule-units\tFAIL\t54090\t53029\tfallback\t2.65\trun-batch\n"
            "1795326295\tmodule-units\tPASS\t40515\t40400\tfallback\t2.39\trun-batch\n"
            "1795334548\tmodule-units\tKILLED\t54090\t-1\t-\t-\taffected-kill\n";
        if (cx_write(ids15, s_ids15, strlen(s_ids15)) ||
            cx_write(tf15, s_tf15, strlen(s_tf15))) return 2;
        if (cx_fmt(cmd, sizeof cmd,
            "sh '%s/unisacc.com' '%s' -- plan --ids-file '%s' --times-file '%s' --out '%s' --normal-jobs 4 --warmup 1",
            cwd, pd_path, ids15, tf15, o15)) return 2;
