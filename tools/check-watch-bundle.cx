/* Independent container fixtures; these do not assert model execution. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sys.env
#pragma unisa use sysx.process
#pragma unisa use cxlib.watchbundle
#pragma unisa use mem.bytes
static void fx_die(const char *why){fprintf(stderr,"watch-bundle: %s\n",why);exit(2);}
static void *fx_alloc(size_t n){void *p=malloc(n?n:1);if(!p)fx_die("allocation");return p;}
static long fx_num(const char *s){if(!s||!*s||(s[0]=='0'&&s[1]))fx_die("noncanonical number");long n=0;for(;*s;s++){if(*s<'0'||*s>'9'||n>(9223372036854775807L-(*s-'0'))/10)fx_die("number range");n=n*10+*s-'0';}return n;}
static int fx_hex(const char *s){if(strlen(s)!=64)return 0;for(int i=0;i<64;i++)if(!((s[i]>='0'&&s[i]<='9')||(s[i]>='a'&&s[i]<='f')))return 0;return 1;}
static char *fx_value(char *s,const char *key){size_t n=strlen(key);if(strncmp(s,key,n)||s[n]!='=')fx_die("field order/name");return s+n+1;}
static long fx_nv(char *s,const char *key){return fx_num(fx_value(s,key));}
static char *fx_hv(char *s,const char *key){char *v=fx_value(s,key);if(!fx_hex(v))fx_die("SHA syntax");return v;}
static void fx_hash(const char *s,size_t n,char h[65]){if(sy_sha256_hex(s,n,h)&&cx_sha256_hex(s,n,h))fx_die("SHA failure");}
static void fx_text(const char *s,size_t n){if(!n||s[n-1]!='\n'||memchr(s,0,n)||memchr(s,'\r',n))fx_die("text framing");}
static int fx_fields(char *line,char **f,int cap){int n=1;f[0]=line;for(char *p=line;*p;p++)if(*p=='\t'){*p=0;if(n==cap)fx_die("field count");f[n++]=p+1;}return n;}
static void fx_same(const char *a,const char *b){if(strcmp(a,b))fx_die("identity mismatch");}
static char root[4096],com[8192],self[8192],base[8192];static int checks,failed;
static void ck(int yes,const char *name){checks++;failed+=!yes;printf("%s\t%s\n",yes?"PASS":"FAIL",name);}
static void save(const char *dir,const char *name,const char *s,size_t n){char p[16384];if(cx_fmt(p,sizeof p,"%s/%s",dir,name)||cx_write(p,s,n))fx_die("fixture write");}
static void material(const char *watch,const char *dir,long split,int mode){
 size_t n;char *w=cx_read(watch,&n);if(!w)fx_die("fixture read");fx_text(w,n);char *end=strchr(w,'\n');size_t hn=end-w;char *head=fx_alloc(hn+1);mm_copy(head, hn, w, hn);head[hn]=0;char *f[32];if(fx_fields(head,f,32)!=9)fx_die("fixture canonical header");fx_same(f[0],"WRITE_EVENTS");fx_same(f[1],"version=1");char d[65],in[65],out[65],cfg[65];(cx_fmt(d, sizeof d, "%s", fx_hv(f[2],"delta_sha")) ? exit(2) : (void)0);(cx_fmt(in, sizeof in, "%s", fx_hv(f[3],"input_sha")) ? exit(2) : (void)0);(cx_fmt(out, sizeof out, "%s", fx_hv(f[4],"output_sha")) ? exit(2) : (void)0);long outn=fx_nv(f[5],"output_bytes");fx_same(f[6],"claim=STATE_OBSERVATION_ONLY");(cx_fmt(cfg, sizeof cfg, "%s", fx_hv(f[7],"config_sha")) ? exit(2) : (void)0);fx_same(f[8],"watch_format=compact-v1");
 char *body=end+1,*p=body,*cut=0,*foot=0;long total=0;while(*p){char *lf=strchr(p,'\n');if(!lf)fx_die("fixture LF");if(!strncmp(p,"COMPLETE\t",9)){foot=p;break;}char *tab=strchr(p,'\t');if(!tab||tab>lf)fx_die("fixture seq");char *q=strchr(tab+1,'\t');if(!q||q>lf)fx_die("fixture seq");char keep=*q;*q=0;long seq=fx_num(tab+1);*q=keep;if(seq!=++total)fx_die("fixture global sequence");p=lf+1;if(total==split)cut=p;}
 if(!foot||!cut||cut==foot||split<1)fx_die("fixture split");char want[100];(cx_fmt(want, sizeof want, "COMPLETE\tevents=%ld\n", total) ? exit(2) : (void)0);fx_same(foot,want);
 if(sy_mkdir(dir,0700))fx_die("fixture directory exists");const char *execution="EXECUTION\tclaim=fixture-consistency-only\n";size_t en=strlen(execution);char eh[65];fx_hash(execution,en,eh);save(dir,"execution.tsv",execution,en);
 size_t lengths[2];char hashes[2][65];long counts[2]={split,total-split};char *starts[2]={body,cut};size_t bodies[2]={(size_t)(cut-body),(size_t)(foot-cut)};long first[2]={1,split+1},last[2]={split,total};
 for(int k=0;k<2;k++){char *s=fx_alloc(bodies[k]+4096);int z=snprintf(s,2048,"WATCH_SEGMENT\tversion=1\tpart=%d\tdelta_sha=%s\tinput_sha=%s\tconfig_sha=%s\toutput_sha=%s\toutput_bytes=%ld\twatch_format=compact-v1\tclaim=STATE_OBSERVATION_ONLY\n",k,d,in,cfg,out,outn);mm_copy(s+z, bodies[k], starts[k], bodies[k]);if(mode==3&&k==1){char *t=strchr(s+z,'\t');if(t)t[1]='9';}if(mode==8&&k==1)s[z]='X';if(mode==9&&k==1)s[z]=0;if(mode==10&&k==1)s[z]='\r';z+=bodies[k];z+=snprintf(s+z,500,"SEGMENT_COMPLETE\tpart=%d\tevents=%ld\tfirst_seq=%ld\tlast_seq=%ld\n",k,counts[k]+(mode==4&&k==1),first[k],last[k]);lengths[k]=z;fx_hash(s,z,hashes[k]);char name[40];(cx_fmt(name, sizeof name, "part-%d.tsv", k) ? exit(2) : (void)0);if(!(mode==2&&k==1))save(dir,name,s,z);free(s);}
 char rh[65];fx_hash(body,foot-body,rh);if(mode==1)hashes[1][0]=hashes[1][0]=='a'?'b':'a';if(mode==5)rh[0]=rh[0]=='a'?'b':'a';char *m=fx_alloc(8192);long B=mode==6?1:mode==7?(long)(lengths[0]+lengths[1]+100)/2:67108864;int z=snprintf(m,4096,"WATCH_BUNDLE\tversion=1\twatch_format=compact-v1\tclaim=STATE_OBSERVATION_ONLY\tdelta_sha=%s\tinput_sha=%s\tconfig_sha=%s\toutput_sha=%s\toutput_bytes=%ld\tpart_event_limit=1000000\tpart_byte_limit=%ld\tparts=2\texecution_sha=%s\texecution_bytes=%ld\n",d,in,cfg,out,outn,B,eh,(long)en);
 for(int k=0;k<2;k++)z+=snprintf(m+z,1000,"PART\t%d\tfile=%s\tsha=%s\tbytes=%ld\tevents=%ld\tfirst_seq=%ld\tlast_seq=%ld\n",k,mode==11&&k==1?"../part-1.tsv":k?"part-1.tsv":"part-0.tsv",hashes[k],(long)lengths[k],counts[k],first[k],last[k]);z+=snprintf(m+z,1000,"COMPLETE\tparts=2\tevents=%ld\tsegments_bytes=%ld\trecords_sha=%s\n",total,(long)(lengths[0]+lengths[1]),rh);if(mode==12)eh[0]='0';save(dir,"manifest.tsv",m,z);if(mode==12)save(dir,"execution.tsv","CHANGED\n",8);if(mode==13)save(dir,"execution.tsv","BAD\r\n",5);free(m);free(head);free(w);
}
int main(int argc,char **argv){
 if(argc==5&&!strcmp(argv[1],"--fixture-from-watch")){material(argv[2],argv[3],fx_num(argv[4]),0);printf("WATCH_BUNDLE_FIXTURE\tstatus=PREPARED\tclaim=fixture-consistency-only\n");return 0;}
 if(argc==3&&!strcmp(argv[1],"--read")){size_t n;char sha[65];char *s=wb_watch(argv[2],&n,sha);fwrite(s,1,n,stdout);free(s);return 0;}
 if(argc!=1)fx_die("arguments");if(!realpath(".",root)||cx_fmt(base,sizeof base,"%s/watch-bundle-check-XXXXXX",sy_tmpdir())||!mkdtemp(base)||cx_fmt(com,sizeof com,"%s/unisacc.com",root)||cx_fmt(self,sizeof self,"%s/tools/check-watch-bundle.cx",root))fx_die("test paths");
 char h[65];memset(h,'a',64);h[64]=0;char canonical[4096];int cn=snprintf(canonical,sizeof canonical,"WRITE_EVENTS\tversion=1\tdelta_sha=%s\tinput_sha=%s\toutput_sha=%s\toutput_bytes=2\tclaim=STATE_OBSERVATION_ONLY\tconfig_sha=%s\twatch_format=compact-v1\nFRAME\t1\t1\t%s\t2\nWATCHC\t2\t0\t1\t0\t0\t0\t0\t0\t7\nWATCHC\t3\t1\t1\t2\t0\t2\t0\t0\t9\nCOMPLETE\tevents=3\n",h,h,h,h,h);save(base,"canonical.tsv",canonical,cn);char watch[16384];cx_fmt(watch,sizeof watch,"%s/canonical.tsv",base);
 const char *labels[]={"cross-segment FRAME and original body exact","segment SHA","missing part","global sequence","segment footer","record SHA","part byte budget","manifest and execution total budget","unknown record","NUL text","CR text","basename traversal","execution SHA","execution CR"};
 for(int i=0;i<14;i++){char dir[16384],manifest[16384];cx_fmt(dir,sizeof dir,"%s/case-%d",base,i);material(watch,dir,1,i);cx_fmt(manifest,sizeof manifest,"%s/manifest.tsv",dir);char *v[]={argv[0],"--read",manifest,0};np_result r={0};char why[300]={0};int tr=np_run(v,root,0,8,&r,why,sizeof why);int yes=!tr&&!r.residue&&r.rc==(i?2:0);if(!i)yes=yes&&r.outn==(size_t)cn&&!memcmp(r.out,canonical,cn);ck(yes,labels[i]);if(!yes)fprintf(stderr,"case%d tr%d rc%d %s %s\n",i,tr,r.rc,why,r.err?r.err:"");np_free(&r);}
 printf("WATCH_BUNDLE_CHECK\tchecks=%d\tfailed=%d\n",checks,failed);return failed?1:0;
}
