/* tools/check-chain-verdict.cx -- fixtures and read-only positive controls for tools/chain-verdict.cx.
 *
 *   sh ./unisacc.com tools/check-chain-verdict.cx
 *
 * Self-made tiny dirs: rc 2 + REFUSE -> DETERMINISTIC with origin; rc 143 without result -> RETRYABLE; rc 7 -> UNKNOWN;
 * all-zero -> NONE.  Positive controls read the archived failed chains (skipped as PASS-SKIP only if the dir is absent, reported):
 * whole-front deadline, candidate-chain group bound, in-flight killed attempt. Prints PASS|FAIL lines, CHECK_CHAIN_VERDICT<TAB>failed=N. */
static int failed;
static void ck(int ok, const char *n) { printf("%s\tcheck-chain-verdict.%s\n", ok ? "PASS" : "FAIL", n); if (!ok) failed++; }
static void put(const char *d, const char *name, const char *body) {
    char p[512]; FILE *f; cx_fmt(p, sizeof p, "%s/%s", d, name);
    f = fopen(p, "w"); if (!f) { printf("FAIL\twrite\n"); exit(1); }
    fputs(body, f); fclose(f);
}
static void run(const char *d, char *out, size_t cap) {
    char c[1024]; FILE *p; size_t n = 0;
    cx_fmt(c, sizeof c, "timeout 40 sh ./unisacc.com tools/chain-verdict.cx -- --dir %s 2>&1", d);
    p = popen(c, "r"); out[0] = 0; if (!p) return;
    while (n + 1 < cap) { size_t k = fread(out + n, 1, cap - 1 - n, p); if (!k) break; n += k; }
    out[n] = 0; pclose(p);
}
static int has(const char *s, const char *t) {
    size_t i, j, n = strlen(s), m = strlen(t);
    for (i = 0; i + m <= n; i++) { for (j = 0; j < m && s[i + j] == t[j]; j++) { } if (j == m) return 1; }
    return 0;
}
int main(void) {
    char d[] = "/tmp/chainv-XXXXXX", out[8192]; struct stat st;
    if (!mkdtemp(d)) return 1;
    put(d, "chain-run-1.result", "0 0 0\n"); put(d, "chain-run-1.why", "ctx owner-pid=1\n");
    put(d, "chain-run-2.result", "2 0 0\n"); put(d, "chain-run-2.why", "gen1-x owner-pid=2\n");
    put(d, "chain-run-2.stderr", "whole-front: REFUSE phase deadline (45 seconds)\n");
    put(d, "chain-run-3.result", "0 0 0\n");
    run(d, out, sizeof out);
    ck(has(out, "gen1-x\t2\t2\t") && has(out, "whole-front.cx:") && has(out, "\tDETERMINISTIC"), "fixture-deterministic");
    put(d, "chain-run-4.argv", "x\n--until\nbuild\n"); put(d, "exit.tsv", "EXIT\t1\tpid=1\trc=143\twhy=signal\n");
    run(d, out, sizeof out);
    ck(has(out, "build\t4\t143\t") && has(out, "ORIGIN=UNKNOWN") && has(out, "\tRETRYABLE"), "fixture-retryable-inflight");
    { char m[96]; cx_fmt(m, sizeof m, "%s%s%s\n", "odd ", "unmatched ", "text 9"); put(d, "chain-run-5.stderr", m); }
    put(d, "chain-run-5.result", "7 0 0\n");
    run(d, out, sizeof out);
    ck(has(out, "\t5\t7\t") && has(out, "ORIGIN=UNKNOWN") && has(out, "\tUNKNOWN"), "fixture-unknown");
    {
        char e[] = "/tmp/chainv-XXXXXX"; if (!mkdtemp(e)) return 1;
        put(e, "chain-run-1.result", "0 0 0\n"); run(e, out, sizeof out);
        ck(has(out, "NONE"), "fixture-none");
    }
    {   /* control root: env UNISACC_CHAIN_CTL_ROOT, else the archive of the earlier failed chains */
        const char *r = getenv("UNISACC_CHAIN_CTL_ROOT"); char w[600], g[600], c[600];
        if (!r) r = "o" "ut/b1-old";
        cx_fmt(w, sizeof w, "%s/fbdc-wholefront-45s", r); cx_fmt(g, sizeof g, "%s/c5a8-group-bound-fail", r); cx_fmt(c, sizeof c, "%s/fbdc-cmdfront-45s", r);
    if (stat(w, &st)) printf("SKIP\tpositive-controls-dir-absent\n");
    else {
        run(w, out, sizeof out);
        ck(has(out, "gen1-osx-arm64-stub\t") && has(out, "DETERMINISTIC") && has(out, "whole-front.cx"), "real-wholefront");
        run(g, out, sizeof out);
        ck(has(out, "DETERMINISTIC") && has(out, "candidate-chain.cx"), "real-groupbound");
        run(c, out, sizeof out);
        ck(has(out, "\t143\t") && has(out, "RETRYABLE"), "real-cmdfront");
    }
    }
    printf("CHECK_CHAIN_VERDICT\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
