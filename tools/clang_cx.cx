#pragma unisa use cxcc
/* Compile one or more .cx files with clang from PATH, including Apple clang.
   Linux and OSX: sh ./clang_cx.com FILE.cx -o OUT [clang arguments]
   Windows: clang_cx.com FILE.cx -o OUT [clang arguments]
   tools/build-cxcc-host.cx writes the entry on that machine.
   It links src/cxmod.c and does not run unisacc.com. -o is this step.
   Blanks a leading #! and forces -std=c99 -x c -include include/cx.h.
   Expands `#pragma unisa use` inside the driver.
   Stock clang ignores #pragma unisa. Module lines are expanded here, then compiled by clang.
   The binary is ordinary C, not a checked .cx build.
   The driver calls posix_spawnp, waitpid, and mkstemp. On Windows those
   calls are tools/cxcc-hostinc/spawn.h. This tree ran the Linux entry.
   Windows and OSX were not executed.
*/
int cxcc_drive(int argc, char **argv, const char *compiler, const char *cmd);

int main(int argc, char **argv) {
    return cxcc_drive(argc, argv, "clang", "clang_cx");
}
