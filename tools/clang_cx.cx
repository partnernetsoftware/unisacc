#pragma unisa use cxcc
/* Compile one or more .cx files with the system clang, including Apple clang.
   sh ./clang_cx.com FILE.cx -o OUT [clang arguments]
   ./unisacc.com -run tools/clang_cx.cx -- FILE.cx -o OUT [clang arguments]
   Six-target APE: ./unisacc.com -run tools/build-cxcc-ape.cx
   Blanks a leading #! and forces -std=c99 -x c -include include/cx.h.
   Expands `#pragma unisa use` through unisacc.com -cx-plan.
   The binary is ordinary C, not a checked .cx build.
   The Windows slice spawns clang with posix_spawnp. It was not executed on Windows.
*/
int main(int argc, char **argv) {
    return cxcc_drive(argc, argv, "clang", "clang_cx");
}
