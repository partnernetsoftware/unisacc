/* tools/real-input-check.cx -- 真实输入验收(0.0.51 RA):对 tests/real-inputs.tsv 的每一行,
 * 用已装产品 ./unisacc.com 在真实输入上实跑工具,核退出码、输出片段与产物 SHA 前缀。
 *
 *   sh ./unisacc.com tools/real-input-check.cx -- [--table FILE] [--only ID] [--list]
 *
 * 表(TAB 七列,首行表头):
 *   id  args  expect_rc  expect_text  timeout_s  requires  post_sha
 *   args       分号分隔,逐项作为 `sh ./unisacc.com` 之后的 argv;{tmp} 替换为本次运行的私有临时目录
 *   expect_rc  期望退出码(整数)
 *   expect_text 须出现在 stdout+stderr 中的子串("-" 表示不核)
 *   timeout_s  单条命令上限,1..60
 *   requires   必须存在的真实输入路径("-" 无);缺失记 FAIL(不是 SKIP):清单声明的真实输入不在就是红
 *   post_sha   "PATH=HEXPREFIX":命令成功后 PATH 的 sha256 须以 HEXPREFIX 开头("-" 不核)
 * 只读真实输入:除 {tmp} 下的产物外不写任何文件。输出 REAL_INPUT<TAB>failed=N,N>0 退出 1。
 * 表头缺失/列数不符/超时范围非法/重复 id 均为表错误(退出 2)。 */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use sys.sha
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use cxlib.netpack

#define RI_COLS 7
#define RI_MAXARG 24

static int g_failed, g_rows;
static char g_root[4096], g_tmp[4400];

static void bad_table(const char *what, const char *id) {
    sy_eprintf("real-input-check: table error: %s%s%s\n", what, id ? ": " : "", id ? id : "");
    exit(2);
}
static int has(const char *b, long bn, const char *s) {
    long sl = tx_len(s, 4096);
    if (!b || bn <= 0 || sl < 0) return 0;
    return tx_find(b, bn, s, sl) >= 0;
}
static int starts(const char *s, const char *pre) {
    long i;
    for (i = 0; pre[i]; i++) if (s[i] != pre[i]) return 0;
    return 1;
}
static int is_hex(const char *s) {
    long i;
    if (!s[0]) return 0;
    for (i = 0; s[i]; i++) {
        char c = s[i];
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return 0;
    }
    return 1;
}
static long ri_atoi(const char *s, const char *id) {
    long n = 0, i;
    if (!s || !s[0]) bad_table("integer field empty", id);
    for (i = 0; s[i]; i++) {
        if (s[i] < '0' || s[i] > '9') bad_table("integer field not decimal", id);
        n = n * 10 + (s[i] - '0');
        if (n > 100000) bad_table("integer field too large", id);
    }
    return n;
}
/* 把 s 中的 {tmp} 替换后写入 dst */
static int subst(char *dst, size_t cap, const char *s) {
    size_t o = 0, i = 0, tl = (size_t)tx_len(g_tmp, sizeof g_tmp);
    while (s[i]) {
        if (s[i] == '{' && s[i + 1] == 't' && s[i + 2] == 'm' && s[i + 3] == 'p' && s[i + 4] == '}') {
            if (o + tl + 1 > cap) return 1;
            { size_t k; for (k = 0; k < tl; k++) dst[o++] = g_tmp[k]; }
            i += 5;
        } else {
            if (o + 2 > cap) return 1;
            dst[o++] = s[i++];
        }
    }
    dst[o] = 0;
    return 0;
}
static int exists(const char *p) {
    sy_stat_t st;
    return sy_stat(p, &st) == 0;
}
static void report(int ok, const char *id, const char *why) {
    g_rows++;
    if (!ok) g_failed++;
    sy_printf("%s\treal-input.%s%s%s\n", ok ? "PASS" : "FAIL", id, why && why[0] ? "\t" : "", why ? why : "");
}

static void run_row(const char *id, char *args, const char *rc_s, const char *text, const char *tmo_s,
                    const char *req, const char *post) {
    char *v[RI_MAXARG + 6];
    char argbuf[4400], reqp[4400], com[4400], why[256] = {0}, detail[600];
    char *argp[RI_MAXARG];
    int na = 0, n = 0, want_rc, tmo, rc;
    long i, at = 0;
    np_result r = {0};

    if (subst(argbuf, sizeof argbuf, args)) bad_table("args too long", id);
    /* 切分 ';' */
    argp[na++] = argbuf;
    for (i = 0; argbuf[i]; i++) {
        if (argbuf[i] == ';') {
            argbuf[i] = 0;
            if (na >= RI_MAXARG) bad_table("too many args", id);
            argp[na++] = argbuf + i + 1;
        }
    }
    want_rc = (int)ri_atoi(rc_s, id);
    tmo = (int)ri_atoi(tmo_s, id);
    if (tmo < 1 || tmo > 60) bad_table("timeout_s must be 1..60", id);

    if (!tx_eqz(req, "-")) {
        if (subst(reqp, sizeof reqp, req)) bad_table("requires too long", id);
        if (!exists(reqp)) {
            cx_fmt(detail, sizeof detail, "missing real input %s", reqp);
            report(0, id, detail);
            return;
        }
    }
    if (cx_fmt(com, sizeof com, "%s/unisacc.com", g_root)) bad_table("path", "com"); /* lint:allow R1-product 本工具的目的就是用已装产品对真实输入实跑,产品路径是其合同而非第二真值源 */
    v[n++] = (char *)"sh";
    v[n++] = com;
    for (i = 0; i < na; i++) v[n++] = argp[i];
    v[n] = 0;

    rc = np_run(v, g_root, 0, tmo, &r, why, sizeof why);
    if (rc != 0) {
        cx_fmt(detail, sizeof detail, "run failed (timeout/spawn): %s", why);
        report(0, id, detail);
        np_free(&r);
        return;
    }
    if (r.rc != want_rc) {
        cx_fmt(detail, sizeof detail, "rc=%d want %d", r.rc, want_rc);
        report(0, id, detail);
        np_free(&r);
        return;
    }
    if (!tx_eqz(text, "-")) {
        int f = has((const char *)r.out, (long)r.outn, text) || has((const char *)r.err, (long)r.errn, text);
        if (!f) {
            {
                char snip[200];
                long sn = 0, k;
                const char *e = r.err && r.errn ? r.err : (r.out ? r.out : "");
                for (k = 0; e[k] && sn < 160; k++) snip[sn++] = (e[k] == '\n' || e[k] == '\t') ? ' ' : e[k];
                snip[sn] = 0;
                cx_fmt(detail, sizeof detail, "output lacks \"%s\"; got: %s", text, snip);
            }
            report(0, id, detail);
            np_free(&r);
            return;
        }
    }
    np_free(&r);
    if (!tx_eqz(post, "-")) {
        char pb[4400], *eq, *data;
        char hex[65];
        size_t dn = 0;
        if (subst(pb, sizeof pb, post)) bad_table("post_sha too long", id);
        eq = 0;
        for (i = 0; pb[i]; i++) if (pb[i] == '=') { eq = pb + i; break; }
        if (!eq || !is_hex(eq + 1)) bad_table("post_sha must be PATH=HEXPREFIX", id);
        *eq = 0;
        data = cx_read(pb, &dn);
        if (!data) {
            cx_fmt(detail, sizeof detail, "post_sha: cannot read %s", pb);
            report(0, id, detail);
            return;
        }
        if (sy_sha256_hex(data, (long)dn, hex)) { mm_free(data); bad_table("sha256 failed", id); }
        mm_free(data);
        if (!starts(hex, eq + 1)) {
            cx_fmt(detail, sizeof detail, "sha256 %.16s lacks prefix %s", hex, eq + 1);
            report(0, id, detail);
            return;
        }
    }
    (void)at;
    report(1, id, "");
}

/* 按 TAB 拆一行到 f[0..RI_COLS-1],列数必须恰好 RI_COLS */
static int split_row(char *line, char **f) {
    int k = 0;
    long i;
    f[k++] = line;
    for (i = 0; line[i]; i++) {
        if (line[i] == '\t') {
            line[i] = 0;
            if (k >= RI_COLS) return 1;
            f[k++] = line + i + 1;
        }
    }
    return k != RI_COLS;
}

int main(int argc, char **argv) {
    const char *table = "tests/real-inputs.tsv", *only = 0;
    int list = 0, i;
    char *text, *p;
    size_t tn = 0;
    char seen[64][96];
    int nseen = 0, lineno = 0, hdr_seen = 0;

    for (i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--table") && i + 1 < argc) { table = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--only") && i + 1 < argc) { only = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--list")) { list = 1; continue; }
        sy_eprintf("usage: real-input-check.cx [--table FILE] [--only ID] [--list]\n");
        return 2;
    }
    if (sy_cwd(g_root, sizeof g_root)) return 2;
    if (cx_fmt(g_tmp, sizeof g_tmp, "%s/real-input-XXXXXX", sy_tmpdir()) || !mkdtemp(g_tmp)) return 2;

    text = cx_read(table, &tn);
    if (!text) bad_table("cannot read table", table);
    /* cx_read 末尾补 NUL 不保证:复制并终结 */
    {
        char *t2 = mm_alloc(tn + 1);
        long k;
        if (!t2) bad_table("alloc", 0);
        for (k = 0; k < (long)tn; k++) t2[k] = text[k];
        t2[tn] = 0;
        mm_free(text);
        text = t2;
    }
    p = text;
    while (*p) {
        char *line = p, *f[RI_COLS];
        long k;
        while (*p && *p != '\n') p++;
        if (*p) *p++ = 0;
        lineno++;
        if (!line[0] || line[0] == '#') continue;
        if (!hdr_seen) {
            hdr_seen = 1;
            if (!starts(line, "id\targs\texpect_rc\texpect_text\ttimeout_s\trequires\tpost_sha") ||
                tx_len(line, 512) != tx_len("id\targs\texpect_rc\texpect_text\ttimeout_s\trequires\tpost_sha", 512))
                bad_table("header must be the seven documented columns", table);
            continue;
        }
        if (split_row(line, f)) bad_table("row must have exactly 7 TAB fields", line);
        for (k = 0; k < nseen; k++) if (tx_eqz(seen[k], f[0])) bad_table("duplicate id", f[0]);
        if (nseen >= 64 || tx_len(f[0], 96) >= 96) bad_table("too many rows or id too long", f[0]);
        if (tx_copy(seen[nseen], sizeof seen[nseen], f[0], tx_len(f[0], 96))) bad_table("id copy", f[0]);
        nseen++;
        if (only && !tx_eqz(only, f[0])) continue;
        if (list) { sy_printf("ROW\t%s\n", f[0]); continue; }
        run_row(f[0], f[1], f[2], f[3], f[4], f[5], f[6]);
    }
    mm_free(text);
    if (only && !list && g_rows == 0) bad_table("--only id not in table", only);
    {
        char rmc[4600];
        char *v[4] = {(char *)"sh", (char *)"-c", rmc, 0};
        np_result q = {0};
        char w[128] = {0};
        if (!cx_fmt(rmc, sizeof rmc, "rm -rf '%s'", g_tmp)) { np_run(v, g_root, 0, 20, &q, w, sizeof w); np_free(&q); }
    }
    if (list) return 0;
    sy_printf("REAL_INPUT\tfailed=%d\n", g_failed);
    return g_failed ? 1 : 0;
}
