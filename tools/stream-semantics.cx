/* tools/stream-semantics.cx -- first run 2026-10-28 18:1x (fable: light work, machine idle).
 * Cells: e4.sem.stream-boundary (isolated E4 output, lowered and encoded by the pinned lower/elf streams, executes like
 * the E4 input) and prune.sem.execution-preserved (pruned and unpruned tapes execute identically).
 *   sh ./unisacc.com tools/stream-semantics.cx -- ROOT STREAMS_DIR ABS_OUT e4|prune
 * Chain A (subject): tape -> stream4|stream5 -> stream6 -> stream7 -> image -> execute.
 * Chain B (control): tape -> stream6 -> stream7 -> image -> execute.
 * Oracle: both images' stdout and exit code are equal and equal to the hand-derived literal (non-vacuous: the subject
 * stream must have changed the tape, else VACUOUS). Image bytes may differ (the subject stream rewrote instructions).
 * Fixtures (product `-S -O0` E3 tapes of small C programs; hand-written tapes proved invalid for lower/elf on the first
 * run): e4 -- `int a=42,b=0; return a+b;` (O2 must rewrite it; exit 42); prune -- a dead static function (exit 7).
 * Old note: e4 -- a tape whose O2 rewrite is known (`imm r2, 0 / add64 r0, r1, r2` -> `mov r0, r1`, with r1 set so the
 * exit code is observable); prune -- the dead-function fixture (exit 7, `dead` removed). Containers from STREAMS_DIR
 * (riroot-01 pins), each run bounded 12 s, images executed under tools/bound 5. */
#pragma unisa use cxlib.netpack

static char root[4096], streams[4096], outdir[4096], inc[4400], bound[4400];
static FILE *res; static int npass, nfail, nnotrun, nvac; static const char *pfx;
static void die(const char *s) { fprintf(stderr, "stream-semantics: REFUSE %s errno=%d\n", s, errno); exit(2); }
static void path(char *p, size_t cap, const char *a, const char *b) { int n = snprintf(p, cap, "%s/%s", a, b); if (n < 0 || (size_t)n >= cap) die("path"); }
static void saved(const char *p, const char *s, size_t n) { int f = open(p, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0700); if (f < 0) die("exclusive create"); while (n) { ssize_t k = write(f, s, n); if (k <= 0) die("write"); s += k; n -= (size_t)k; } if (close(f)) die("close"); }
static void row(const char *state, const char *label, const char *detail) { fprintf(res, "%s\t%s\t%s\t%s\n", state, pfx, label, detail); if (!strcmp(state, "PASS")) npass++; else if (!strcmp(state, "FAIL")) nfail++; else if (!strcmp(state, "VACUOUS")) nvac++; else nnotrun++; }
/* run container N on IN, save its stdout to OUT; returns 0 on rc 0 */
static int stage(int n, const char *in, const char *out) { char com[4400], leaf[64]; { if (cx_fmt(leaf, sizeof leaf, "unisacc-stream%d.com", n)) { fprintf(stderr, "stream-semantics: text too long for leaf\n"); exit(2); } } path(com, sizeof com, streams, leaf);
    char *v[] = { bound, "12", com, (char *)in, (char *)in, inc, 0 }; char *env[] = { "UNISA_ATTRIBUTES=", "UNISA_MAXSTEPS=200000000", 0 }; np_result r; char why[1024];
    if (np_run(v, root, env, 14, &r, why, sizeof why) || r.rc) { np_free(&r); return 1; } unlink(out); saved(out, r.out, r.outn); np_free(&r); return 0; }
static int execute(const char *img, np_result *r) { char *v[] = { bound, "5", (char *)img, 0 }; char *env[] = { 0 }; char why[1024]; return np_run(v, root, env, 7, r, why, sizeof why); }
static int same(const char *a, const char *b) { size_t na, nb; char *x = cx_read(a, &na), *y = cx_read(b, &nb); int ok = x && y && na == nb && !memcmp(x, y, na); free(x); free(y); return ok; }

int main(int argc, char **argv) {
    if (argc != 5 || !realpath(argv[1], root) || !realpath(argv[2], streams) || argv[3][0] != '/' || (strcmp(argv[4], "e4") && strcmp(argv[4], "prune"))) { fputs("usage: ROOT STREAMS_DIR ABS_OUT e4|prune\n", stderr); return 2; }
    pfx = argv[4]; { if (cx_fmt(outdir, sizeof outdir, "%s", argv[3])) { fprintf(stderr, "stream-semantics: text too long for outdir\n"); exit(2); } } if (mkdir(outdir, 0700)) die("new out dir must be absent");
    path(inc, sizeof inc, root, "include"); path(bound, sizeof bound, root, "tools/bound");
    char rp[4400]; path(rp, sizeof rp, outdir, "results.tsv"); res = fopen(rp, "wbx"); if (!res) die("results");
    int subject = !strcmp(pfx, "e4") ? 4 : 5; const char *cell = subject == 4 ? "e4.sem.stream-boundary" : "prune.sem.execution-preserved";
    /* fixture: the product's own -O0 E3 tape of a small C program (first run 2026-10-28 showed hand-written tapes are not
       a valid lower/elf input: both images crashed, and E4 left the hand tape unchanged); exit code carries the result */
    const char *csrc = subject == 4 ? "int main(void){int a=42,b=0;return a+b;}\n" : "static int dead(int x){return x*99;}\nint main(void){return 7;}\n";
    int want_rc = subject == 4 ? 42 : 7;
    char t0[4400], ta[4400], la[4400], ia[4400], lb[4400], ib[4400], cp[4400]; path(cp, sizeof cp, outdir, "in.c"); saved(cp, csrc, strlen(csrc)); path(t0, sizeof t0, outdir, "in.tape");
    { char prod[4400]; path(prod, sizeof prod, root, "unisacc.com"); char *v[] = { bound, "20", "sh", prod, "-S", "-O0", "-o", t0, cp, 0 }; char *env[] = { 0 }; np_result r; char why[1024]; if (np_run(v, root, env, 22, &r, why, sizeof why) || r.rc) { row("NOT_RUN", cell, "product -S -O0 of the fixture failed"); goto done; } np_free(&r); }
    path(ta, sizeof ta, outdir, "subject.tape"); path(la, sizeof la, outdir, "subject.target"); path(ia, sizeof ia, outdir, "subject.img");
    path(lb, sizeof lb, outdir, "control.target"); path(ib, sizeof ib, outdir, "control.img");
    if (stage(subject, t0, ta)) { row("NOT_RUN", cell, "subject stream failed"); goto done; }
    if (same(t0, ta)) { row("VACUOUS", cell, "subject stream left the tape unchanged"); goto done; }
    if (stage(6, ta, la) || stage(7, la, ia)) { row("NOT_RUN", cell, "lower/elf on the subject tape failed"); goto done; }
    if (stage(6, t0, lb) || stage(7, lb, ib)) { row("NOT_RUN", cell, "lower/elf on the control tape failed"); goto done; }
    { np_result a, b; if (execute(ia, &a) || execute(ib, &b)) { row("NOT_RUN", cell, "image did not run"); goto done; }
      char d[200]; { if (cx_fmt(d, sizeof d, "subject rc=%d control rc=%d want %d; stdout %zu/%zu bytes", a.rc, b.rc, want_rc, a.outn, b.outn)) { fprintf(stderr, "stream-semantics: text too long for d\n"); exit(2); } }
      row(a.rc == want_rc && b.rc == want_rc && a.outn == b.outn && !memcmp(a.out, b.out, a.outn) ? "PASS" : "FAIL", cell, d); np_free(&a); np_free(&b); }
done:
    fprintf(res, "SUMMARY\tpass=%d\tfail=%d\tvacuous=%d\tnot_run=%d\n", npass, nfail, nvac, nnotrun); fclose(res);
    printf("STREAM_SEMANTICS\tstream=%s\tpass=%d\tfail=%d\tvacuous=%d\tnot_run=%d\n", pfx, npass, nfail, nvac, nnotrun);
    return nfail || nvac || nnotrun ? 1 : 0;
}
