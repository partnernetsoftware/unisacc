#pragma unisa module refworkspace
#pragma unisa use cxlib.netpack
#pragma unisa use sys.sha
#pragma unisa use text.text

/* Canonical tar binds every exported name, type and byte, independent of
 * extraction time, uid and umask. The archive is never unpacked here. */
static const char *rw_headers="adb324f29b775428b994ddb28748c4746b4a35d0cadaffab4234d4a07be1b29d";
int rw_verify(const char *dir){
    char *v[]={"/usr/bin/env","-i","LC_ALL=C","/usr/bin/tar","--sort=name","--format=ustar",
        "--mtime=@0","--owner=0","--group=0","--numeric-owner","--mode=0644","-cf","-","include",0};
    char why[256],sha[65];np_result r={0};
    int ok=!np_run(v,dir,0,4,&r,why,sizeof why)&&!r.rc&&!r.residue&&
        !sy_sha256_any_hex(r.out,r.outn,sha)&&tx_eqz(sha,rw_headers);
    np_free(&r);return ok;
}
const char *rw_header_sha(void){return rw_headers;}
int rw_open(const char *root,const char *elf,char *dir,size_t cap){
    const char *slash=strrchr(elf,'/');
    if(!slash||slash==elf||tx_copy(dir,cap,elf,slash-elf))return 2;
    size_t n=strlen(root);
    if(!strncmp(dir,root,n)&&(!dir[n]||dir[n]=='/'||n==1)){
        fprintf(stderr,"REFUSE reference-cwd-in-product-root\n");return 2;
    }
    if(!rw_verify(dir)){fprintf(stderr,"REFUSE frozen-include-sha-mismatch\n");return 2;}
    return 0;
}
