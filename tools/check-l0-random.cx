/* tools/check-l0-random.cx -- verify sy_random fills buffers, varies across calls, rejects bad args. */
#pragma unisa use sys.syscall

static int rnd_pass, rnd_fail;
static void rnd_ck(int ok, const char *name) {
    printf("%s\tl0-random.%s\n", ok ? "PASS" : "FAIL", name);
    if (ok) rnd_pass++; else rnd_fail++;
}

int main(void) {
    unsigned char a[32], b[32], big[300];
    int i, nz_a = 0, diff = 0, nz_head = 0, nz_tail = 0;
    for (i = 0; i < 32; i++) { a[i] = 0; b[i] = 0; }
    for (i = 0; i < 300; i++) big[i] = 0;

    rnd_ck(sy_random(a, 32) == 0, "fill-32-ok");
    for (i = 0; i < 32; i++) if (a[i] != 0) nz_a++;
    rnd_ck(nz_a > 0, "fill-32-nonzero");

    rnd_ck(sy_random(b, 32) == 0, "fill-32-second-ok");
    for (i = 0; i < 32; i++) if (a[i] != b[i]) diff++;
    rnd_ck(diff > 0, "two-calls-differ");

    rnd_ck(sy_random(big, 300) == 0, "fill-300-multi-chunk-ok");
    for (i = 0; i < 64; i++) if (big[i] != 0) nz_head++;
    for (i = 256; i < 300; i++) if (big[i] != 0) nz_tail++;
    rnd_ck(nz_head > 0 && nz_tail > 0, "fill-300-head-and-tail-nonzero");

    rnd_ck(sy_random(a, 0) == 0, "zero-len-ok");
    rnd_ck(sy_random(0, 0) == 0, "null-zero-len-ok");
    rnd_ck(sy_random(a, -1) == -EINVAL, "neg-len-einval");
    rnd_ck(sy_random(0, 16) == -EINVAL, "null-buf-nonzero-len-einval");

    printf("CHECK_L0_RANDOM\tpassed=%d\tfailed=%d\n", rnd_pass, rnd_fail);
    return rnd_fail ? 1 : 0;
}
