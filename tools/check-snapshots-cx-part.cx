/* tools/check-snapshots-cx-part.cx -- snapshots-cx 慢批分片检查(--part core|alloc),断言并集与原批多重集相等。
 *   sh ./unisacc.com tools/check-snapshots-cx-part.cx -- --part core|alloc ROOT ABS_NEW_OUT
 * Runs either the core snapshot/fault assertions (core, 86 assertions + material verify)
 * or the full allocation-fault injection matrix (alloc, 179 assertions) on CX-wired ledger operations. */
#pragma unisa use cxlib.toolprep
#pragma unisa use sys.time
#pragma unisa use sys.fs
#pragma unisa use text.text

static void die(const char *s){fprintf(stderr,"snapshots-cx-part: %s\n",s);exit(2);}
static void scp_path(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path");}
static void call(char **v,int seconds,const char *out,const char *label){
    char *o=0;size_t on=0;char p[4400],name[128];
    int rc=cx_runv_timeout(v,seconds,&o,&on);
    if(cx_fmt(name,sizeof name,"%s.stdout",label))die("format-bound");
    scp_path(p,out,name);if(cx_write(p,o?o:"",on))die("stdout");
    if(on)fwrite(o,1,on,stdout);free(o);
    if(rc)exit(rc<0?2:rc);
}
static long find_bytes(const char *b,size_t n,const char *needle){
    size_t k=strlen(needle);
    if(k==0||k>n)return -1;
    for(size_t i=0;i+k<=n;i++)if(!memcmp(b+i,needle,k))return (long)i;
    return -1;
}

int main(int argc,char **argv){
    char root[4096],product[4400],bound[4400],tool[4400],toolbin[4400],ident[4400],material[4400],program[4400],wired[4400],wiredbin[4400],runtime[4400],link[4400],cases[4400],why[256];
    const char *part=0;
    int is_core=0;
    if(argc!=5||!tx_eqz(argv[1],"--part"))die("usage --part core|alloc ROOT ABS_NEW_OUT");
    part=argv[2];
    if(tx_eqz(part,"core"))is_core=1;
    else if(!tx_eqz(part,"alloc"))die("unknown part (want core|alloc)");
    if(!realpath(argv[3],root)||argv[4][0]!='/'||mkdir(argv[4],0700))die("usage --part core|alloc ROOT ABS_NEW_OUT");
    if(chdir(root))die("root");

    scp_path(product,root,"unisacc.com");scp_path(bound,root,"tools/bound");scp_path(tool,root,"tools/ledger-material.cx");
    scp_path(toolbin,argv[4],"ledger-material.native");scp_path(ident,root,"seed/ident.c");
    scp_path(material,argv[4],"material");scp_path(program,material,"snapshot.cx");
    scp_path(wired,argv[4],"snapshot-cx.cx");scp_path(wiredbin,argv[4],"snapshot-cx.native");
    scp_path(runtime,root,"cx/runtime");scp_path(link,argv[4],"runtime");scp_path(cases,argv[4],"cases");

    char *identity[]={"sh",product,ident,"--",root,0};
    int warm=tq_warm_start(root,15,identity);
    if(tq_native(root,tool,toolbin,why,sizeof why))die(why);
    tq_warm_join(warm);

    char *prep[]={bound,"18",toolbin,root,material,"tests/cases/snapshot.cx",0};
    call(prep,20,argv[4],"prepare");
    if(symlink(runtime,link))die("module link");

    size_t n;char *s=cx_read(program,&n);if(!s)die("prepared fixture");
    long core_pos=find_bytes(s,n,"r=write_snapshot(\"good\",blobs,3,good,err);");
    long split_pos=find_bytes(s,n,"static unsigned char keys[20][2];");
    long tail_pos=find_bytes(s,n,"puts(\"NOT_COVERED\\tsnapshot.Windows-no-replace-host-contract-and-cross-host-execution\");");
    if(core_pos<0||split_pos<=core_pos||tail_pos<=split_pos)die("snapshot fixture section markers not found");

    const char *prefix="#pragma unisa use runtime.source_frame\n#define UNISA_CX_SOURCE_FRAME\n";
    FILE *f=fopen(wired,"wb");
    if(!f)die("wired fixture open");
    if(fwrite(prefix,1,strlen(prefix),f)!=strlen(prefix))die("wired prefix");
    if(is_core){
        /* Keep core assertions [0, split_pos) and trailer [tail_pos, n); declare allocations=0 for summary. */
        const char *z="long allocations=0;\n";
        if(fwrite(s,1,(size_t)split_pos,f)!=(size_t)split_pos||
           fwrite(z,1,strlen(z),f)!=strlen(z)||
           fwrite(s+tail_pos,1,n-(size_t)tail_pos,f)!=n-(size_t)tail_pos)die("wired core write");
    }else{
        /* Keep declarations/init [0, core_pos) and allocation fault matrix [split_pos, n). */
        if(fwrite(s,1,(size_t)core_pos,f)!=(size_t)core_pos||
           fwrite(s+split_pos,1,n-(size_t)split_pos,f)!=n-(size_t)split_pos)die("wired alloc write");
    }
    if(fclose(f))die("wired close");
    free(s);

    {
        char *wb[]={"sh",product,wired,"-o",wiredbin,0};
        int wp=tq_warm_start(root,40,wb);
        if(is_core){
            char *verify[]={bound,"18",toolbin,"--verify",root,material,"tests/cases/snapshot.cx",0};
            call(verify,20,argv[4],"verify");
        }
        tq_warm_join(wp);
        if(sy_exists(wiredbin)!=1)die("wired image not built");
    }
    char *run[]={bound,"16",wiredbin,cases,0};
    call(run,18,argv[4],"execute");
    printf("SNAPSHOTS_CX_PART\tpart=%s\tscope=source-wired-CX-ledger-operations-linux-x86_64-not-installed-or-foreign\n",part);
    return 0;
}
