/* tools/cx0-diff.cx -- cxmod 三源差异表(prd_cx.md 10.5 的 T1,B1 的 54-1)。
 *   sh ./unisacc.com tools/cx0-diff.cx                      TSV 到标准输出(只读,不写盘)
 *   sh ./unisacc.com tools/cx0-diff.cx -- --check           同上,并断言:无「其他」块,语义=是 恰为 (e)(f)
 *   sh ./unisacc.com tools/cx0-diff.cx -- --pair A B        只比一对文件(夹具用)
 * 三对:plan.cx 对 cxmod.cx(产品)、plan.cx 对 src/cxmod.c、src/cxmod.c 对 cxmod.cx。
 * 块 = `git diff --no-index -U0` 的一个 hunk。类别依据 10.5 的六类:
 *   (a) 可见性(仅 static 前缀之差)  (b) 宿主接线头  (c) 临时目录与哈希来源  (d) 模块身份判同
 *   (e) 只在产品源的语义(cxm_checkcalls 一族)  (f) 上限 CXM_MAXU  (t) 尾部适配
 * 宿主差异 = a b c d t;语义分叉 = e f;其他 = 未归类。 */
#pragma unisa use sys.proc
#pragma unisa use cxlib.netpack
#pragma unisa use text.fmt
#pragma unisa use text.text

typedef struct { int as, al, bs, bl; char *rem; char *add; int rn, an; } d_block;
static int has(const char *h, const char *w) {
    int i, j;
    for (i = 0; h[i]; i++) {
        for (j = 0; w[j] && h[i + j] == w[j]; j++) {}
        if (!w[j]) return 1;
    }
    return 0;
}
static int line_of(const char *path, const char *w) {
    FILE *f = fopen(path, "r"); char b[2048]; int n = 0;
    if (!f) return 0;
    while (fgets(b, sizeof b, f)) { n++; if (has(b, w)) { fclose(f); return n; } }
    fclose(f); return 0;
}
static int num(const char *s, int *at) {
    int v = 0;
    while (s[*at] >= '0' && s[*at] <= '9') { v = v * 10 + (s[*at] - '0'); (*at)++; }
    return v;
}
/* 解析 "@@ -a[,b] +c[,d] @@",缺省长度为 1 */
static void head(const char *s, d_block *k) {
    int at = 4;
    k->as = num(s, &at); k->al = 1;
    if (s[at] == ',') { at++; k->al = num(s, &at); }
    at += 2;
    k->bs = num(s, &at); k->bl = 1;
    if (s[at] == ',') { at++; k->bl = num(s, &at); }
}
/* 去掉行首 "static " 后逐行比 */
static const char *unstatic(const char *s) {
    return (s[0] == 's' && s[1] == 't' && s[2] == 'a' && s[3] == 't' && s[4] == 'i' && s[5] == 'c' && s[6] == ' ') ? s + 7 : s;
}
static int line_end(const char *s) { int i = 0; while (s[i] && s[i] != '\n') i++; return i; }
static int nostatic(const char *s, char *o) {
    int n = 0, i = 0;
    while (s[i]) {
        if (s[i] == 's' && s[i + 1] == 't' && s[i + 2] == 'a' && s[i + 3] == 't' && s[i + 4] == 'i' && s[i + 5] == 'c' && s[i + 6] == ' ') { i += 7; continue; }
        o[n++] = s[i++];
    }
    o[n] = 0; return n;
}
static int vis_only(const char *r, const char *a) {
    char *x = malloc(tx_len(r, 1 << 20) + 1), *y = malloc(tx_len(a, 1 << 20) + 1); int nx, ny, i;
    if (!r[0] || !a[0]) return 0;
    nx = nostatic(r, x); ny = nostatic(a, y);
    if (nx != ny) return 0;
    for (i = 0; i < nx; i++) if (x[i] != y[i]) return 0;
    return 1;
}
/* 去掉注释(块首可能已在注释中)与全部空白,得到代码骨架 */
static int skeleton(const char *s, char *o) {
    int n = 0, i = 0, first = 1;
    while (s[i]) {
        if (first && s[i] == '*' && s[i + 1] == '/') { i += 2; first = 0; continue; }
        if (s[i] == '/' && s[i + 1] == '*') {
            i += 2;
            while (s[i] && !(s[i] == '*' && s[i + 1] == '/')) i++;
            if (s[i]) i += 2;
            first = 0; continue;
        }
        if (s[i] == '*' && s[i + 1] == '/') { n = 0; i += 2; continue; }
        if (s[i] != ' ' && s[i] != '\n' && s[i] != '\t') { o[n++] = s[i]; first = 0; }
        i++;
    }
    o[n] = 0; return n;
}
static int same_code(const char *r, const char *a) {
    char *x = malloc(tx_len(r, 1 << 20) + 1), *y = malloc(tx_len(a, 1 << 20) + 1); int nx = skeleton(r, x), ny = skeleton(a, y), i;
    if (nx != ny) return 0;
    for (i = 0; i < nx; i++) if (x[i] != y[i]) return 0;
    return 1;
}
/* 归类:返回 a b c d e f t 之一,0 为其他。defa/defb 为两侧 CXM_MAXU 定义行号 */
static char classify(const d_block *k, int defa, int defb) {
    char *t = malloc((size_t)(k->rn + k->an + 2)); int i;
    for (i = 0; i < k->rn; i++) t[i] = k->rem[i];
    t[k->rn] = '\n';
    for (i = 0; i < k->an; i++) t[k->rn + 1 + i] = k->add[i];
    t[k->rn + 1 + k->an] = 0;
    if (has(t, "cxm_checkcalls") || has(t, "cxm_locn") || has(t, "cxm_badcalls") || has(t, "cxm_funit") || has(t, "undeclared function")) return 'e';
    if (has(t, "DV_MAXU") || has(t, "more than 96") || has(t, "cxm_md(CXM_MAXU)") || has(t, "define CXM_MAXU") || has(t, "CXM_MAXU = ")) return 'f';
    if (has(t, "cx0_plan(") || has(t, "cx0_capture_plan") || has(t, "cx0_result cx0_")) return 't';
    if (k->as < defa || k->bs < defb) return 'b';
    if (has(t, "cx0_directory") || has(t, "cxm_tmpdir") || has(t, "sha256_hex") || has(t, "cxm_digest") || has(t, "TMPDIR")) return 'c';
    if (has(t, "cxm_samefile") || has(t, "cxm_reali") || has(t, "REALPATH") || has(t, "realpath")) return 'd';
    if (has(t, "char *td;")) return 'c';
    if (vis_only(k->rem, k->add)) return 'a';
    if (same_code(k->rem, k->add)) return 'g';
    return 'x';
}
/* g 注释或排版差异,x 六类之外的代码差异(候选语义分叉) */
static char *cat_of(char c) { return c == 'e' || c == 'f' ? "语义分叉" : c == 'x' ? "其他" : c == 'g' ? "其他" : "宿主差异"; }
static int nblk, nother, nsem_bad;
static FILE *sink;
static int diff_pair(const char *label, const char *fa, const char *fb) {
    char *av[8]; np_result r = {0}; char why[256]; int i, at = 0, defa = line_of(fa, "CXM_MAXU"), defb = line_of(fb, "CXM_MAXU");
    d_block k; int open = 0;
    av[0] = "git"; av[1] = "diff"; av[2] = "--no-index"; av[3] = "-U0"; av[4] = (char *)fa; av[5] = (char *)fb; av[6] = 0; /* lint:allow R1 git diff is the line-block oracle, read only */
    np_run(av, ".", 0, 20, &r, why, sizeof why);
    if (r.outn <= 0) { fprintf(stderr, "cx0-diff: no diff output for %s\n", label); return 1; }
    k.rem = malloc((size_t)r.outn + 1); k.add = malloc((size_t)r.outn + 1); k.rn = k.an = 0;
    while (at <= r.outn) {
        int e = at, fin = at >= r.outn;
        while (e < r.outn && r.out[e] != '\n') e++;
        if (fin || r.out[at] == '@') {
            if (open) {
                char c = classify(&k, defa, defb);
                fprintf(sink, "%s\t%d\t%d\t%d\t%d\t%c\t%s\t%s\n", label, k.as, k.al, k.bs, k.bl, c, cat_of(c), c == 'e' || c == 'f' ? "是" : c == 'x' ? "待核" : "否");
                nblk++; if (c == 'x') nother++;
            }
            k.rn = k.an = 0; open = 0;
            if (fin) break;
            if (r.out[at + 1] == '@') { head(r.out + at, &k); open = 1; }
        } else if (open && (r.out[at] == '-' || r.out[at] == '+')) {
            char *d = r.out[at] == '-' ? k.rem : k.add; int *n = r.out[at] == '-' ? &k.rn : &k.an;
            for (i = at + 1; i < e; i++) d[(*n)++] = r.out[i];
            d[(*n)++] = '\n'; d[*n] = 0;
        }
        at = e + 1;
    }
    np_free(&r); return 0;
}
int main(int argc, char **argv) {
    int check = 0, i, rc = 0;
    char *pa = 0, *pb = 0, *outp = 0, *verp = 0;
    sink = stdout;
    for (i = 1; i < argc; i++) {
        if (!strcmp(argv[i], "--check")) check = 1;
        else if (!strcmp(argv[i], "--out") && i + 1 < argc) outp = argv[++i];
        else if (!strcmp(argv[i], "--verify") && i + 1 < argc) verp = argv[++i];
        else if (!strcmp(argv[i], "--pair") && i + 2 < argc) { pa = argv[i + 1]; pb = argv[i + 2]; i += 2; }
        else { fprintf(stderr, "usage: cx0-diff [--check] [--pair A B]\n"); return 2; }
    }
    /* --out PATH 写表;--verify PATH 与现表逐字节比,不同 rc=1(derive 生成器合同,类 x 不拦) */
    if (outp || verp) sink = tmpfile();
    if (!sink) { fprintf(stderr, "cx0-diff: tmpfile failed\n"); return 2; }
    fprintf(sink, "pair\ta_start\ta_len\tb_start\tb_len\tclass\tcategory\tsemantic\n");
    if (pa) rc |= diff_pair("pair", pa, pb);
    else {
        rc |= diff_pair("plan-vs-prod", "cx/cx0/plan.cx", "cx/compiler/cxmod.cx");
        rc |= diff_pair("plan-vs-c", "cx/cx0/plan.cx", "src/cxmod.c");
        rc |= diff_pair("c-vs-prod", "src/cxmod.c", "cx/compiler/cxmod.cx");
    }
    fprintf(stderr, "CX0_DIFF blocks=%d other=%d\n", nblk, nother);
    if (outp || verp) {
        long n; char *nb, *ob = 0; FILE *g; int same;
        fflush(sink); n = ftell(sink); rewind(sink);
        nb = malloc((size_t)n + 1); if (fread(nb, 1, (size_t)n, sink) != (size_t)n) return 2;
        nb[n] = 0; fclose(sink);
        if (rc) return 2;
        if (outp) {
            g = fopen(outp, "w");
            if (!g || fwrite(nb, 1, (size_t)n, g) != (size_t)n) return 2;
            fclose(g); return 0;
        }
        g = fopen(verp, "r"); same = 0;
        if (g) {
            long m; fseek(g, 0, SEEK_END); m = ftell(g); rewind(g);
            ob = malloc((size_t)m + 1);
            if (fread(ob, 1, (size_t)m, g) == (size_t)m) { ob[m] = 0; same = (m == n && !memcmp(ob, nb, (size_t)n)); }
            fclose(g);
        }
        if (!same) { fprintf(stderr, "DIFF cx0-three-source-diff stale\n"); return 1; }
        return 0;
    }
    if (check && (rc || nother)) return 2;
    return rc;
}
