/* tools/executor-selection-gen.cx -- de-target slice identity from one facts table.
 *
 *   sh ./unisacc.com tools/executor-selection-gen.cx -- --write [--facts FILE] [--out FILE]
 *   sh ./unisacc.com tools/executor-selection-gen.cx -- --check [--facts FILE] [--out FILE]
 *
 * Facts: exec/facts/executor-selection.tsv, 11 TAB columns:
 *   target executor tape_dir manifest_key tapemode_key slice_prefix hoststub_bind_sym hoststub_sym run_sym abi_tag status
 * Generated: cx/driver/executor_selection_table.cx, an ExecutorSel table plus executor_sel(target).
 * Unknown target returns 0; callers must refuse rc 2, never fall back silently. status is only
 * UNMEASURED or PREPARED; no metric is filled here. */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.proc
#pragma unisa use sys.sig
#pragma unisa use text.text
#pragma unisa use mem.heap

#define ES_MAX 16
#define ES_COLS 11
#define ES_CAP (1 << 16)
typedef struct { char c[ES_COLS][128]; } EsRow;
static EsRow rows[ES_MAX];
static int nrow;
static char facts[4400], out[4400];
static char buf[ES_CAP]; static long bn;

static void die(const char *s) { sy_eprintf("executor-selection-gen: %s\n", s); sy_exit(2); }
static int same(const char *a, const char *b, size_t n) { size_t i; for (i = 0; i < n; i++) if (a[i] != b[i]) return 0; return 1; }
static void add(const char *s) { while (s && *s && bn < ES_CAP - 1) buf[bn++] = *s++; buf[bn] = 0; }
static int split(char *line, long len, const char **f, int *fl, int want) {
    long i, st = 0; int k = 0;
    for (i = 0; i <= len; i++) if (i == len || line[i] == '\t') {
        if (k >= want) return -1;
        f[k] = line + st; fl[k] = (int)(i - st); k++; st = i + 1;
    }
    return k == want ? 0 : -1;
}
static int cpy(char *d, int cap, const char *s, int n) { int i; if (n < 0 || n >= cap) return -1; for (i = 0; i < n; i++) d[i] = s[i]; d[n] = 0; return 0; }
static int load(void) {
    size_t n = 0; char *b = cx_read(facts, &n); long at = 0; int seen = 0;
    const char *head = "target\texecutor\ttape_dir\tmanifest_key\ttapemode_key\tslice_prefix\thoststub_bind_sym\thoststub_sym\trun_sym\tabi_tag\tstatus\n";
    if (!b) return -1;
    while (at < (long)n) {
        long e = at; while (e < (long)n && b[e] != '\n') e++; b[e] = 0;
        if (e > at && b[at] != '#') {
            const char *f[ES_COLS]; int fl[ES_COLS]; int i, j;
            if (!seen) {
                if ((e - at) != (long)tx_len(head, 4096) - 1 || !same(b + at, head, (size_t)(e - at))) { mm_free(b); return -1; }
                seen = 1;
            } else {
                if (nrow >= ES_MAX || split(b + at, e - at, f, fl, ES_COLS)) { mm_free(b); return -1; }
                for (i = 0; i < ES_COLS; i++) if (cpy(rows[nrow].c[i], 128, f[i], fl[i])) { mm_free(b); return -1; }
                if (!tx_eqz(rows[nrow].c[1], "asm") && !tx_eqz(rows[nrow].c[1], "portable")) { mm_free(b); return -1; }
                if (!tx_eqz(rows[nrow].c[10], "UNMEASURED") && !tx_eqz(rows[nrow].c[10], "PREPARED")) { mm_free(b); return -1; }
                if (tx_eqz(rows[nrow].c[1], "asm")) {
                    if (tx_eqz(rows[nrow].c[6], "-") || tx_eqz(rows[nrow].c[7], "-") || tx_eqz(rows[nrow].c[8], "tape_run_cx")) { mm_free(b); return -1; }
                } else if (!tx_eqz(rows[nrow].c[6], "-") || !tx_eqz(rows[nrow].c[7], "-") || !tx_eqz(rows[nrow].c[8], "tape_run_cx")) { mm_free(b); return -1; }
                for (j = 0; j < nrow; j++) if (tx_eqz(rows[j].c[0], rows[nrow].c[0])) { mm_free(b); return -1; }
                nrow++;
            }
        }
        at = e + 1;
    }
    mm_free(b);
    return nrow > 0 ? 0 : -1;
}
static void q(const char *s) { add("\""); add(s); add("\""); }
static void build(void) {
    int i;
    add("/* generated by tools/executor-selection-gen.cx; do not edit. */\n");
    add("#pragma unisa module executor_selection_table\n");
    add("#pragma unisa use text.text\n");
    add("typedef struct { const char *target, *executor, *tape_dir, *manifest_key, *tapemode_key, *slice_prefix, *hoststub_bind_sym, *hoststub_sym, *run_sym, *abi_tag, *status; } ExecutorSel;\n");
    add("static const ExecutorSel g_executor_sel[] = {\n");
    for (i = 0; i < nrow; i++) {
        int j; add("    {");
        for (j = 0; j < ES_COLS; j++) { if (j) add(", "); q(rows[i].c[j]); }
        add("},\n");
    }
    add("};\n");
    add("const ExecutorSel *executor_sel(const char *target) {\n");
    add("    int i; if (!target) return 0;\n");
    add("    for (i = 0; i < (int)(sizeof g_executor_sel / sizeof g_executor_sel[0]); i++) if (tx_eqz(target, g_executor_sel[i].target)) return &g_executor_sel[i];\n");
    add("    return 0;\n}\n");
    add("/* Lookup by a sys.hostid triple such as \"lnx/x86_64\"; the facts key replaces '/' with '-'. */\n");
    add("const ExecutorSel *executor_sel_triple(const char *triple) {\n");
    add("    char slug[32]; int i = 0;\n");
    add("    if (!triple) return 0;\n");
    add("    while (i < 31 && triple[i]) { slug[i] = triple[i] == '/' ? '-' : triple[i]; i++; }\n");
    add("    slug[i] = 0; return executor_sel(slug);\n}\n");
}
int main(int argc, char **argv) {
    int i, write = 0, check = 0;
    cx_fmt(facts, sizeof facts, "%s", "exec/facts/executor-selection.tsv");
    cx_fmt(out, sizeof out, "%s", "cx/driver/executor_selection_table.cx");
    for (i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--write")) write = 1;
        else if (tx_eqz(argv[i], "--check")) check = 1;
        else if (tx_eqz(argv[i], "--facts") && i + 1 < argc) cx_fmt(facts, sizeof facts, "%s", argv[++i]);
        else if (tx_eqz(argv[i], "--out") && i + 1 < argc) cx_fmt(out, sizeof out, "%s", argv[++i]);
        else die("usage: --write|--check [--facts FILE] [--out FILE]");
    }
    if (write + check != 1) die("usage: --write|--check");
    if (load()) die("facts table unreadable, malformed, duplicate target, or bad enum");
    build();
    if (write) { if (sy_write_file(out, buf, (size_t)bn, 0644)) die("write"); sy_printf("EXECUTOR_SELECTION\tWROTE\ttargets=%d\n", nrow); return 0; }
    { size_t n = 0; char *b = cx_read(out, &n);
      if (!b) { sy_printf("EXECUTOR_SELECTION\tFAIL\tmissing\t%s\n", out); return 1; }
      if ((long)n != bn || !same(b, buf, (size_t)bn)) { mm_free(b); sy_printf("EXECUTOR_SELECTION\tFAIL\tdrift\t%s\n", out); return 1; }
      mm_free(b); }
    sy_printf("EXECUTOR_SELECTION\tPASS\ttargets=%d\n", nrow); return 0;
}
