#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.posix
#pragma unisa use sys.time
#pragma unisa use text.text

/* sy_run with a bound: ARGV runs under cx_runv_timeout (SECS, process group killed on expiry), stdout and stderr
   merged into OUT (CAP, NUL-terminated, *CUT set when it did not fit; CUT may be 0). */
static int bounded_run(char **argv, int secs, char *out, int cap, int *cut) {
    char *w[64], *b = 0;
    size_t n = 0, j;
    int k = 0, i, rc;
    if (cut) *cut = 0;
    if (!argv) return -EINVAL;
    w[k++] = "sh"; w[k++] = "-c"; w[k++] = "exec \"$@\" 2>&1"; w[k++] = "sh";
    for (i = 0; argv[i] && k < 63; i++) w[k++] = argv[i];
    if (argv[i]) return -E2BIG;
    w[k] = 0;
    rc = cx_runv_timeout(w, secs, &b, &n);
    if (cap > 0) {
        if (n > (size_t)cap - 1) { n = (size_t)cap - 1; if (cut) *cut = 1; }
        for (j = 0; b && j < n; j++) out[j] = b[j];
        out[b ? n : 0] = 0;
    }
    free(b);
    return rc;
}
/* tools/procguard.cx -- fork-bomb guard for the unisacc test surface.

   sh ./unisacc.com tools/procguard.cx [--once] [--dry-run|--enforce]
        [--max N] [--tick-ms N] [--log PATH] [--only-parent PID]

   Every tick it lists /proc itself (sy_dir_names; no external ps), keeps only
   processes of this real uid whose command line names a .cx file, groups them
   by that file (last two path components) and, when one group holds more than
   MAX members, freezes every member with SIGSTOP and then SIGKILLs them.  No
   process-group or session kill is ever used: only the matching pids and
   their in-scope descendants (by ppid) are signalled.  Each scan line after
   an ENFORCE carries residue=KEY:N -- how many of that group the fresh scan
   still sees -- so "collected" is read off the log, not off the kill count.
   Independently, an unprotected same-uid .cx pid is a candidate for CPU >=90%
   averaged over its lifetime strictly >600 seconds, a cwd link ending in
   (deleted), or ppid=1 with age strictly >1800 seconds outside a tmux subtree.
   CPU/age use one validated getconf CLK_TCK observation at startup; unavailable
   clocks disable those two reasons, never the independent deleted-cwd reason.
   Each signal rechecks starttime identity, uid, command and live protections.
   --only-parent PID narrows both observation and signals to direct children.
   --classify AGE_TICKS CPU_TICKS HZ DELETED PPID TMUX and
   --identity SNAP_START NOW_START UID_MATCH PROTECTED HAS_CX are pure fixture
   observations: both exit before scanning or signalling any process.

   Two nets, different duties: the NOFLOW backstop stops a check from breeding
   at all (self-restart writing list: archive/research-2026-11d/plans/v0.0.44.md "自重启类检查写法清单",
   commit 8580058a48); procguard is the second net for what bred anyway --
   it cannot prevent a spawn, it can only collect it.

   Never touched: this process, its ancestors (walked through /proc stat), any
   process whose executable or argv[0] is tmux, byobu, claude, bun, omp,
   chrome, chromium, grok-bot, sshd, python, codex (or systemd/dbus), and any
   child of a tmux server (a pane's shell).

   Defaults: MAX 100 (env PG_MAX), tick 10000 ms (env PG_TICK_MS), dry-run
   (only explicit --enforce enables signals), log appended to
   $HOME/.cache/procguard/log (env PG_LOG).  --once scans once and exits; it
   skips the single-instance lock so a test or a drill can run beside the
   resident service.  The resident loop holds an exclusive flock on
   $HOME/.cache/procguard/lock.
   An L3 tool: no #include and no direct libc call (cx/sys, cx/text, cx_*). */

#define MAXKEYS 512
#define KEYLEN 192
#define MAXREC 8192
#define PATHLEN 4096
#define NAMEBUF 65536
#define O_RDONLY_ 0
#define O_WRONLY_ 1
#define O_CREAT_ 0100
#define O_APPEND_ 02000
#define SIGSTOP_ 19
#define SIGKILL_ 9
#define SIGCONT_ 18
#define LOCK_EX_NB (2 | 4)

typedef struct {
    int pid, ppid, uid, keyidx;
    char state;
    long start, cpu, age;
    int reason, tmux;
    char prot;      /* never signal this pid */
    char marked;    /* frozen as a descendant of a runaway key */
    char owned_stopped; /* 1: our STOP; 2: target was already stopped */
} Rec;

static Rec recs[MAXREC];
static int nrec;
static char keys[MAXKEYS][KEYLEN];
static int kcount[MAXKEYS];
static int nkeys, nover, killed_total;

static int max_procs = 100;
static long tick_ms = 10000;
static int enforce = 0, once = 0;
static char logpath[PATHLEN];
static int logfd = -1;
static int my_uid;
static int self_pid;
static int top_key = -1, top_n = 0;   /* largest group of the last scan */
static int anc[64];
static int nanc;
static long clock_ticks, uptime_ticks;
static int only_parent;

static int identity_safe(long before, long after, int uidmatch, int protected, int has_cx) {
    return before >= 0 && before == after && uidmatch == 1 && !protected && has_cx == 1;
}

/* After a successful STOP, reason drift is irrelevant; identity still is not.
   Bit 1 permits KILL; bit 2 permits undoing only a newly owned failed STOP. */
static int stopped_policy(int owned, int same, int protected, int has_cx, int failed, int stopped) {
    int action = owned > 0 && owned <= 2 && same && !protected && has_cx ? 1 : 0;
    if (owned == 1 && same && failed && stopped) action |= 2;
    return action;
}

static int parse_num(const char *s, long n, long *out) {
    long v = 0, i;
    if (n < 1 || n > 9) return -1;
    for (i = 0; i < n; i++) {
        if (s[i] < '0' || s[i] > '9') return -1;
        v = v * 10 + (s[i] - '0');
    }
    *out = v;
    return 0;
}

/* read at most CAP-1 bytes of PATH into BUF, NUL-terminated; the byte count, or -errno */
static int read_file(const char *path, char *buf, int cap) {
    int fd, n;
    if (cap < 1) return -EINVAL;
    fd = sy_open_read(path);
    if (fd < 0) return fd;
    n = (int)sy_read(fd, buf, cap - 1);
    sy_close(fd);
    if (n < 0) return n;
    buf[n] = 0;
    return n;
}

/* Parse fixed /proc stat fields; failures never manufacture an observation. */
static int stat_values(int pid, int *ppid, char *state, long *start, long *cpu) {
    char path[64], buf[PATHLEN];
    long n, i, close = -1, user = -1, sys = -1, born = -1;
    int field;
    if (cx_fmt(path, sizeof path, "/proc/%d/stat", pid)) return -EINVAL;
    n = read_file(path, buf, sizeof buf);
    if (n <= 0 || n == sizeof buf - 1) return -EIO;
    for (i = n - 1; i > 0; i--) if (buf[i] == ')') { close = i; break; }
    if (close < 0 || close + 4 >= n) return -EIO;
    if (state) *state = buf[close + 2];
    i = close + 4;
    for (field = 4; field <= 22; field++) {
        long v = 0, digits = 0;
        int neg = 0;
        if (buf[i] == '-') { neg = 1; i++; }
        while (i < n && buf[i] >= '0' && buf[i] <= '9') {
            if (v > (9223372036854775807L - (buf[i] - '0')) / 10) return -EIO;
            v = v * 10 + buf[i++] - '0'; digits++;
        }
        if (!digits || i >= n || buf[i] != ' ') return -EIO;
        if (field == 4 && ppid) *ppid = neg ? -1 : (int)v;
        if (field == 14) user = neg ? -1 : v;
        if (field == 15) sys = neg ? -1 : v;
        if (field == 22) born = neg ? -1 : v;
        while (i < n && buf[i] == ' ') i++;
    }
    if (user < 0 || sys < 0 || born < 0 || user > 9223372036854775807L - sys) return -EIO;
    if (start) *start = born;
    if (cpu) *cpu = user + sys;
    return 0;
}

static int proc_stat(int pid, int *ppid, char *state) {
    return stat_values(pid, ppid, state, 0, 0);
}

/* Pure classifier: seconds represented as ticks, preserving strict boundaries. */
static int classify(long age, long cpu, long hz, int deleted, int ppid, int tmux) {
    int reason = deleted ? 2 : 0;
    if (hz > 0 && hz <= 1000000 && age >= 0 && cpu >= 0) {
        if (age > 600 * hz && cpu >= age - age / 10) reason |= 1;
        if (age > 1800 * hz && ppid == 1 && !tmux) reason |= 4;
    }
    return reason;
}

static void load_clock(void) {
    char buf[64]; long n, v = 0;
    char *av[] = {"/usr/bin/getconf", "CLK_TCK", 0}; int cut = 0;
    clock_ticks = 0;
    if (bounded_run(av, 50, buf, sizeof buf, &cut) != 0 || cut) return;
    n = tx_len(buf, sizeof buf);
    if (n > 0 && buf[n - 1] == '\n') n--;
    if (parse_num(buf, n, &v) == 0 && v > 0 && v <= 1000000) clock_ticks = v;
}

static void load_uptime(void) {
    char buf[128]; long i = 0, seconds = 0, fraction = 0, scale = 1;
    uptime_ticks = -1;
    if (!clock_ticks || read_file("/proc/uptime", buf, sizeof buf) <= 0) return;
    while (buf[i] >= '0' && buf[i] <= '9') {
        if (seconds > 9223372036854L) return;
        seconds = seconds * 10 + buf[i++] - '0';
    }
    if (!i || buf[i++] != '.') return;
    while (buf[i] >= '0' && buf[i] <= '9') {
        if (scale < 1000000) { fraction = fraction * 10 + buf[i] - '0'; scale *= 10; }
        i++;
    }
    if (buf[i] != ' ') return;
    if (seconds > (9223372036854775807L - clock_ticks) / clock_ticks) return;
    uptime_ticks = seconds * clock_ticks + fraction * clock_ticks / scale;
}

static int is_prot_name(const char *base) {
    static const char *names[] = {"tmux", "byobu", "claude", "bun", "omp", "chrome", "chromium",
                                  "grok-bot", "sshd", "python", "codex", "systemd", "dbus"};
    int i;
    for (i = 0; i < (int)(sizeof names / sizeof names[0]); i++)
        if (tx_prefixz(base, names[i], tx_len(names[i], 64))) return 1;
    return 0;
}

static const char *base_of(const char *p) {
    const char *b = p;
    if (!p) return "";
    for (; *p; p++) if (*p == '/') b = p + 1;
    return b;
}

/* copy the word around the first ".cx" of CMD (NUL-separated, may hold spaces
   inside a shell -c string) into OUT, cut to its last two path components;
   1 when found */
static int key_from_cmd(const char *cmd, long n, char *out, int cap) {
    long i;
    for (i = 0; i + 2 < n; i++) {
        if (cmd[i] != '.' || cmd[i + 1] != 'c' || cmd[i + 2] != 'x') continue;
        if (i + 3 < n && ((cmd[i + 3] >= 'a' && cmd[i + 3] <= 'z') || (cmd[i + 3] >= '0' && cmd[i + 3] <= '9') || cmd[i + 3] == '_')) continue;
        {   long s = i, e = i + 3, last = -1, prev = -1, k, cut;
            while (s > 0 && cmd[s - 1] && cmd[s - 1] != ' ' && cmd[s - 1] != '"' && cmd[s - 1] != '\'' && cmd[s - 1] != '=') s--;
            while (e < n && cmd[e] && cmd[e] != ' ' && cmd[e] != '"' && cmd[e] != '\'' && cmd[e] != ';') e++;
            while (s + 1 < e && cmd[s] == '.' && cmd[s + 1] == '/') s += 2;
            for (k = s; k < e; k++) if (cmd[k] == '/') { prev = last; last = k; }
            if (last >= 0 && prev >= 0) s = prev + 1;   /* keep the last two components */
            cut = e - s;
            if (cut < 1 || cut >= cap) return 0;
            {   int c; for (c = 0; c < (int)cut; c++) out[c] = cmd[s + c]; out[cut] = 0; }
            return 1;
        }
    }
    return 0;
}

static int key_index(const char *key) {
    int i;
    for (i = 0; i < nkeys; i++) if (tx_eqz(keys[i], key)) return i;
    if (nkeys >= MAXKEYS) return -1;
    {   int k; for (k = 0; key[k] && k < KEYLEN - 1; k++) keys[nkeys][k] = key[k]; keys[nkeys][k] = 0; }
    kcount[nkeys] = 0;
    return nkeys++;
}

static void load_ancestors(void) {
    int pid = self_pid, guard = 0, ppid = 0;
    nanc = 0;
    while (pid > 1 && nanc < 63 && guard++ < 128) {
        anc[nanc++] = pid;
        if (proc_stat(pid, &ppid, 0) < 0) break;
        pid = ppid;
    }
    anc[nanc++] = 1;
}

/* Walk every ancestor, not merely .cx records: tmux servers seldom name .cx.
   Unknown ancestry is protected; a truncated walk cannot prove non-tmux. */
static int live_protection(int pid, int *in_tmux) {
    int at = pid, depth, prot = 0;
    *in_tmux = 0;
    for (depth = 0; depth < 128 && at > 1; depth++) {
        char path[64], exe[PATHLEN], cmd[PATHLEN];
        int pp = 0, k; long el, cl;
        if (proc_stat(at, &pp, 0) < 0 || pp < 1 || pp == at) return 1;
        if (cx_fmt(path, sizeof path, "/proc/%d/exe", at)) return 1;
        el = sy_readlink(path, exe, sizeof exe - 1);
        if (el <= 0 || el >= sizeof exe - 1) return 1;
        exe[el] = 0;
        if (cx_fmt(path, sizeof path, "/proc/%d/cmdline", at)) return 1;
        cl = read_file(path, cmd, sizeof cmd);
        if (cl <= 0 || cl >= sizeof cmd - 1) return 1;
        if (tx_prefixz(base_of(exe), "tmux", 4) || tx_prefixz(base_of(cmd), "tmux", 4)) {
            *in_tmux = 1;
            if (depth <= 1) prot = 1;
        }
        if (!depth) {
            if (is_prot_name(base_of(exe)) || is_prot_name(base_of(cmd))) prot = 1;
            for (k = 0; k < nanc; k++) if (anc[k] == pid) prot = 1;
        }
        at = pp;
    }
    if (at != 1) return 1;
    return prot;
}

static int deleted_cwd(int pid) {
    char path[64], cwd[PATHLEN]; long n;
    sy_stat_t target, named, again; int rc;
    if (cx_fmt(path, sizeof path, "/proc/%d/cwd", pid)) return 0;
    n = sy_readlink(path, cwd, sizeof cwd - 1);
    if (n <= 0 || n >= sizeof cwd - 1) return 0;
    cwd[n] = 0;
    if (n < 10 || !tx_eqz(cwd + n - 10, " (deleted)")) return 0;
    if (sy_stat(path, &target) < 0 || target.kind != 'd') return 0;
    rc = sy_stat(cwd, &named);
    if (rc == 0) {
        if (named.dev == target.dev && named.ino == target.ino) return 0;
        return 0; /* a different live directory is still ambiguous */
    }
    if (rc != -ENOENT) return 0;
    if (sy_stat(path, &again) < 0 || again.dev != target.dev || again.ino != target.ino) return 0;
    return 1;
}

static int checked_signal(Rec *r, int sig) {
    char path[64], cmd[PATHLEN], key[KEYLEN]; sy_stat_t st;
    long start, cpu; int pp, tmux; char state;
    if (r->prot || stat_values(r->pid, &pp, &state, &start, &cpu) < 0 || start != r->start || state == 'Z' || state == 'X') return -1;
    if (cx_fmt(path, sizeof path, "/proc/%d", r->pid) || sy_stat(path, &st) < 0 || (int)st.uid != my_uid) return -1;
    if (!identity_safe(r->start, start, (int)st.uid == my_uid, live_protection(r->pid, &tmux), 1)) return -1;
    if (cx_fmt(path, sizeof path, "/proc/%d/cmdline", r->pid)) return -1;
    { int n = read_file(path, cmd, sizeof cmd);
      if (n <= 0 || n >= sizeof cmd - 1 || !key_from_cmd(cmd, n, key, sizeof key) || !tx_eqz(key, keys[r->keyidx])) return -1; }
    if (stat_values(r->pid, &pp, &state, &start, &cpu) < 0 || start != r->start) return -1;
    if (only_parent && pp != only_parent) return -1;
    if (sig == SIGKILL_ && !(stopped_policy(r->owned_stopped, identity_safe(r->start, start, (int)st.uid == my_uid, 0, 1), 0, 1, 0, 1) & 1)) return -1;
    if (sig == SIGSTOP_ && !r->marked && kcount[r->keyidx] <= max_procs) {
        load_uptime();
        if (!classify(uptime_ticks >= start ? uptime_ticks - start : -1, cpu, clock_ticks, deleted_cwd(r->pid), pp, tmux)) return -1;
    }
    { int rc = sy_signal(r->pid, sig);
      if (rc >= 0 && sig == SIGSTOP_) r->owned_stopped = state == 'T' || state == 't' ? 2 : 1;
      return rc; }
}

static int safe_signal(Rec *r, int sig) {
    int rc;
    if (sig == SIGKILL_ && !r->owned_stopped) return -1;
    rc = checked_signal(r, sig);
    if (sig == SIGKILL_) {
        if (rc < 0 && r->owned_stopped == 1) {
            char path[64]; sy_stat_t st; long start; char state;
            /* Undo only our own STOP. Protection/argv can change after STOP;
               resuming the same uid+starttime is cleanup, not a kill decision. */
            if (!cx_fmt(path, sizeof path, "/proc/%d", r->pid) &&
                sy_stat(path, &st) >= 0 && (int)st.uid == my_uid &&
                stat_values(r->pid, 0, &state, &start, 0) == 0 &&
                (stopped_policy(r->owned_stopped, identity_safe(r->start, start, (int)st.uid == my_uid, 0, 1), 0, 1, 1, state == 'T' || state == 't') & 2)) {
                int resumed = sy_signal(r->pid, SIGCONT_);
                printf("procguard: skipped-kill pid=%d resume=%d\n", r->pid, resumed);
            } else printf("procguard: skipped-kill pid=%d resume=unknown-identity\n", r->pid);
        }
        r->owned_stopped = 0;
    }
    return rc;
}

static void scan(void) {
    char names[NAMEBUF];
    int dfd, n, i;
    nrec = 0; nkeys = 0; nover = 0;
    load_uptime();
    dfd = sy_open("/proc", O_RDONLY_, 0);
    if (dfd < 0) { printf("procguard: cannot open /proc: %d\n", dfd); return; }
    n = (int)sy_dir_names(dfd, names, sizeof names);
    sy_close(dfd);
    if (n < 0) { printf("procguard: cannot list /proc: %d\n", n); return; }
    {   int at = 0;
        for (i = 0; i < n && at < (int)sizeof names && nrec < MAXREC; i++) {
            const char *name = names + at;
            long nl = tx_len(name, 64), v = 0;
            at += (int)nl + 1;
            if (nl < 1 || nl > 9 || parse_num(name, nl, &v) < 0 || v <= 1) continue;
            {   int pid = (int)v, ppid = 0, keyidx, k;
                char state = '?', key[KEYLEN], path[64], cmd[PATHLEN], exe[PATHLEN];
                long cl, start = 0, cpu = 0;
                int prot = 0, tmux = 0;
                sy_stat_t st;
                if (stat_values(pid, &ppid, &state, &start, &cpu) < 0) continue;
                if (only_parent && ppid != only_parent) continue;
                if (state == 'Z' || state == 'X') continue;
                if (cx_fmt(path, sizeof path, "/proc/%d", pid)) continue;
                if (sy_stat(path, &st) < 0 || (int)st.uid != my_uid) continue;
                exe[0] = 0;
                if (!cx_fmt(path, sizeof path, "/proc/%d/exe", pid)) {
                    long el = sy_readlink(path, exe, sizeof exe - 1);
                    if (el > 0) exe[el] = 0; else exe[0] = 0;
                }
                if (!cx_fmt(path, sizeof path, "/proc/%d/cmdline", pid)) {
                    cl = read_file(path, cmd, sizeof cmd);
                } else cl = -1;
                if (cl <= 0) continue;
                if (!key_from_cmd(cmd, cl, key, sizeof key)) continue;
                keyidx = key_index(key);
                if (keyidx < 0) continue;
                if (pid == self_pid) prot = 1;
                for (k = 0; k < nanc; k++) if (anc[k] == pid) prot = 1;
                if (is_prot_name(base_of(exe))) prot = 1;
                if (is_prot_name(base_of(cmd))) prot = 1;
                prot |= live_protection(pid, &tmux);
                recs[nrec].pid = pid;
                recs[nrec].ppid = ppid;
                recs[nrec].uid = (int)st.uid;
                recs[nrec].state = state;
                recs[nrec].keyidx = keyidx;
                recs[nrec].prot = (char)prot;
                recs[nrec].marked = 0;
                recs[nrec].owned_stopped = 0;
                recs[nrec].start = start;
                recs[nrec].cpu = cpu;
                recs[nrec].age = uptime_ticks >= start ? uptime_ticks - start : -1;
                recs[nrec].tmux = tmux;
                recs[nrec].reason = classify(recs[nrec].age, cpu, clock_ticks, deleted_cwd(pid), ppid, tmux);
                nrec++;
                kcount[keyidx]++;
            }
        }
    }
    top_key = -1; top_n = 0;
    for (i = 0; i < nkeys; i++) {
        if (kcount[i] > max_procs) nover++;
        if (kcount[i] > top_n) { top_n = kcount[i]; top_key = i; }
    }
}

static void logline(const char *s) {
    if (logfd < 0) logfd = sy_open(logpath, O_WRONLY_ | O_CREAT_ | O_APPEND_, 0644);
    if (logfd >= 0) sy_write_all(logfd, s, tx_len(s, 4096));
}

/* ---- residue: what the last ENFORCE left behind -------------------------
   A kill is only proof when the next scan still cannot see the group. The
   keys enforced in one tick are kept in PENDING (a file next to the log, so a
   restarted or --once process sees them too) and the next scan line carries
   "residue=KEY:N" for each; N counts the survivors still carrying that key.
   A zombie has no cmdline and is not in the scan, so a killed-but-unreaped
   process cannot inflate N. */
#define PEND_MAX 8
static char pend[PEND_MAX][KEYLEN];
static int npend;
static char pendpath[PATHLEN];

static int app(char *b, int cap, const char *s) {   /* append; 1 on overflow */
    int i = tx_len(b, cap), j;
    for (j = 0; s[j]; j++) { if (i + j + 1 >= cap) return 1; b[i + j] = s[j]; }
    b[i + j] = 0;
    return 0;
}

static void pend_save(void) {
    int fd, i;
    if (!pendpath[0]) return;
    fd = sy_open(pendpath, O_WRONLY_ | O_CREAT_, 0644);
    if (fd < 0) return;
    sy_truncate(fd, 0L);
    for (i = 0; i < npend; i++) { sy_write_all(fd, pend[i], tx_len(pend[i], KEYLEN)); sy_write_all(fd, "\n", 1); }
    sy_close(fd);
}

static void pend_add(const char *key) {
    int i, c;
    for (i = 0; i < npend; i++) if (tx_eqz(pend[i], key)) return;
    if (npend == PEND_MAX) {
        for (i = 1; i < PEND_MAX; i++) for (c = 0; c < KEYLEN; c++) pend[i - 1][c] = pend[i][c];
        npend--;
    }
    for (c = 0; key[c] && c < KEYLEN - 1; c++) pend[npend][c] = key[c];
    pend[npend][c] = 0;
    npend++;
}

static void pend_load(void) {
    char buf[PEND_MAX * (KEYLEN + 1) + 64];
    int n, at = 0;
    npend = 0;
    if (!pendpath[0]) return;
    n = read_file(pendpath, buf, sizeof buf);
    if (n <= 0) return;
    while (at < n && npend < PEND_MAX) {
        int e = at, c;
        while (e < n && buf[e] != '\n') e++;
        if (e > at) {
            for (c = 0; c < e - at && c < KEYLEN - 1; c++) pend[npend][c] = buf[at + c];
            pend[npend][c] = 0;
            npend++;
        }
        at = e + 1;
    }
}

static int key_alive(const char *key) {
    int i, n = 0;
    for (i = 0; i < nrec; i++) if (!recs[i].prot && tx_eqz(keys[recs[i].keyidx], key)) n++;
    return n;
}

/* " residue=K:N,K:N" from the keys of the last ENFORCE; empty when none */
static void residue_text(char *res, int cap) {
    int i, first = 1;
    res[0] = 0;
    for (i = 0; i < npend; i++) {
        char t[KEYLEN + 24];
        if (cx_fmt(t, sizeof t, "%s%s:%d", first ? "" : ",", pend[i], key_alive(pend[i]))) continue;
        if (app(res, cap, first ? " residue=" : "") || app(res, cap, t)) return;
        first = 0;
    }
}

/* keep the append-only log bounded: one 8 MiB generation aside */
static void rotate_log(void) {
    sy_stat_t st;
    char bak[PATHLEN];
    if (sy_stat(logpath, &st) < 0 || st.size <= 8 * 1024 * 1024) return;
    if (logfd >= 0) { sy_close(logfd); logfd = -1; }
    if (cx_fmt(bak, sizeof bak, "%s.1", logpath)) return;
    sy_unlink(bak);
    sy_rename(logpath, bak);
}

static void act(void) {
    int k, i, pass;
    for (k = 0; k < nkeys; k++) {
        int n = 0, first = 0, hits = 0;
        char line[1024];
        if (kcount[k] <= max_procs) continue;
        for (i = 0; i < nrec; i++) if (recs[i].keyidx == k && !recs[i].prot) { n++; if (!first) first = recs[i].pid; }
        if (!enforce) {
            printf("procguard: DRY key=%s count=%d would-kill=%d root=%d\n", keys[k], kcount[k], n, first);
            if (!cx_fmt(line, sizeof line, "ts=%ld DRY key=%s count=%d would-kill=%d root=%d\n", sy_now_ms(), keys[k], kcount[k], n, first)) logline(line);
            continue;
        }
        /* members and their in-scope descendants (three ppid rounds) */
        for (i = 0; i < nrec; i++) if (recs[i].keyidx == k && !recs[i].prot) recs[i].marked = 1;
        for (pass = 0; pass < 3; pass++) {
            int added = 0;
            for (i = 0; i < nrec; i++) {
                int j;
                if (recs[i].marked || recs[i].prot) continue;
                for (j = 0; j < nrec; j++) if (recs[j].marked && recs[j].pid == recs[i].ppid) { recs[i].marked = 1; added++; break; }
            }
            if (!added) break;
        }
        /* freeze every member first, then kill: no member can fork in between */
        for (i = 0; i < nrec; i++) if (recs[i].marked && !recs[i].prot) {
            if (safe_signal(&recs[i], SIGSTOP_) < 0) recs[i].marked = 0;
        }
        for (i = 0; i < nrec; i++) if (recs[i].marked && !recs[i].prot) { if (safe_signal(&recs[i], SIGKILL_) >= 0) hits++; }
        for (i = 0; i < nrec; i++) recs[i].marked = 0;
        killed_total += hits;
        printf("procguard: ENFORCE key=%s count=%d killed=%d root=%d\n", keys[k], kcount[k], hits, first);
        if (!cx_fmt(line, sizeof line, "ts=%ld ENFORCE key=%s count=%d killed=%d root=%d\n", sy_now_ms(), keys[k], kcount[k], hits, first)) logline(line);
        pend_add(keys[k]);
        pend_save();
    }
    for (i = 0; i < nrec; i++) {
        Rec *r = &recs[i]; char line[1024]; int hits = 0;
        if (!r->reason || r->prot || kcount[r->keyidx] > max_procs) continue;
        if (enforce && safe_signal(r, SIGSTOP_) >= 0 && safe_signal(r, SIGKILL_) >= 0) { hits = 1; killed_total++; }
        if (!cx_fmt(line, sizeof line, "ts=%ld %s key=%s pid=%d reason=%d cpu=%d deleted-cwd=%d orphan=%d age_ticks=%ld cpu_ticks=%ld hz=%ld killed=%d\n",
                    sy_now_ms(), enforce ? "ENFORCE" : "DRY", keys[r->keyidx], r->pid, r->reason,
                    !!(r->reason & 1), !!(r->reason & 2), !!(r->reason & 4), r->age, r->cpu, clock_ticks, hits)) {
            printf("%s", line); logline(line);
        }
        if (hits) { pend_add(keys[r->keyidx]); pend_save(); }
    }
}

static void usage(void) {
    printf("sh ./unisacc.com tools/procguard.cx [--once] [--dry-run|--enforce] [--max N] [--tick-ms N] [--log PATH] [--only-parent PID]\n"
           "pure fixtures: --classify AGE_TICKS CPU_TICKS HZ DELETED PPID TMUX [...]; --identity SNAP_START NOW_START UID_MATCH PROTECTED HAS_CX [...]\n"
           "stop fixture: --stopped SNAP_START NOW_START UID_MATCH PROTECTED HAS_CX OWNED FAILED STOPPED CURRENT_REASON [...]\n"
           "env: PG_MAX (100), PG_TICK_MS (10000), PG_LOG ($HOME/.cache/procguard/log)\n");
}

int main(int argc, char **argv) {
    const char *home = sy_env_or("HOME", "/tmp");
    const char *e;
    char dir[PATHLEN], lockpath[PATHLEN], line[512];
    int i, lockfd = -1;
    long v;
    /* Observation fixtures are pure and exit before any /proc scan or signal. */
    if (argc > 1 && tx_eqz(argv[1], "--stopped")) {
        int at; long f[9];
        if (argc < 11 || (argc - 2) % 9) return 2;
        for (at = 2; at < argc; at += 9) {
            int policy;
            for (i = 0; i < 9; i++) if (parse_num(argv[at + i], tx_len(argv[at + i], 16), &f[i]) < 0) return 2;
            policy = stopped_policy((int)f[5], identity_safe(f[0], f[1], (int)f[2], 0, 1), (int)f[3], (int)f[4], (int)f[6], (int)f[7]);
            printf("kill=%d cont=%d\n", !!(policy & 1), !!(policy & 2));
        }
        return 0;
    }
    if (argc > 1 && (tx_eqz(argv[1], "--classify") || tx_eqz(argv[1], "--identity"))) {
        long f[6]; int count = tx_eqz(argv[1], "--classify") ? 6 : 5, r, at;
        if (argc < count + 2 || (argc - 2) % count) return 2;
        for (at = 2; at < argc; at += count) {
            for (i = 0; i < count; i++) if (parse_num(argv[at + i], tx_len(argv[at + i], 16), &f[i]) < 0) return 2;
            if (count == 6) {
                r = classify(f[0], f[1], f[2], (int)f[3], (int)f[4], (int)f[5]);
                printf("reason=%d cpu=%d deleted-cwd=%d orphan=%d\n", r, !!(r & 1), !!(r & 2), !!(r & 4));
            } else printf("safe=%d\n", identity_safe(f[0], f[1], (int)f[2], (int)f[3], (int)f[4]));
        }
        return 0;
    }
    self_pid = sy_pid();
    {   sy_stat_t st; if (sy_stat("/proc/self", &st) < 0) { printf("procguard: cannot stat /proc/self\n"); return 2; } my_uid = (int)st.uid; }
    e = sy_env_or("PG_MAX", ""); if (e[0] && parse_num(e, tx_len(e, 16), &v) == 0) max_procs = (int)v;
    e = sy_env_or("PG_TICK_MS", ""); if (e[0] && parse_num(e, tx_len(e, 16), &v) == 0) tick_ms = v;
    e = sy_env_or("PG_LOG", "");
    logpath[0] = 0;
    if (e[0] && cx_fmt(logpath, sizeof logpath, "%s", e)) logpath[0] = 0;
    for (i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--once")) once = 1;
        else if (tx_eqz(argv[i], "--dry-run")) enforce = 0;
        else if (tx_eqz(argv[i], "--enforce")) enforce = 1;
        else if (tx_eqz(argv[i], "--only-parent") && i + 1 < argc) { if (parse_num(argv[i + 1], tx_len(argv[i + 1], 16), &v) < 0 || v <= 1) return 2; only_parent = (int)v; i++; }
        else if (tx_eqz(argv[i], "--max") && i + 1 < argc) { if (parse_num(argv[i + 1], tx_len(argv[i + 1], 16), &v) < 0) { usage(); return 2; } max_procs = (int)v; i++; }
        else if (tx_eqz(argv[i], "--tick-ms") && i + 1 < argc) { if (parse_num(argv[i + 1], tx_len(argv[i + 1], 16), &v) < 0) { usage(); return 2; } tick_ms = v; i++; }
        else if (tx_eqz(argv[i], "--log") && i + 1 < argc) { if (cx_fmt(logpath, sizeof logpath, "%s", argv[i + 1])) return 2; i++; }
        else if (tx_eqz(argv[i], "--help") || tx_eqz(argv[i], "-h")) { usage(); return 0; }
        else { printf("procguard: unknown argument %s\n", argv[i]); usage(); return 2; }
    }
    if (max_procs < 1) max_procs = 1;
    if (tick_ms < 50) tick_ms = 50;
    if (!logpath[0] && cx_fmt(logpath, sizeof logpath, "%s/.cache/procguard/log", home)) return 2;
    if (cx_fmt(dir, sizeof dir, "%s/.cache", home)) return 2;
    {   int r = sy_mkdir(dir, 0755); if (r < 0 && r != -EEXIST) { printf("procguard: cannot make %s: %d\n", dir, r); return 3; } }
    if (cx_fmt(dir, sizeof dir, "%s/.cache/procguard", home)) return 2;
    {   int r = sy_mkdir(dir, 0755); if (r < 0 && r != -EEXIST) { printf("procguard: cannot make %s: %d\n", dir, r); return 3; } }
    load_ancestors();
    load_clock();
    if (!once) {
        if (cx_fmt(lockpath, sizeof lockpath, "%s/.cache/procguard/lock", home)) return 2;
        lockfd = sy_open(lockpath, 02 | O_CREAT_, 0644);
        if (lockfd < 0) { printf("procguard: cannot open lock: %d\n", lockfd); return 3; }
        if (sy_flock(lockfd, LOCK_EX_NB) < 0) { printf("procguard: another instance holds the lock; exiting\n"); return 0; }
    }
    if (cx_fmt(pendpath, sizeof pendpath, "%s.pending", logpath)) pendpath[0] = 0;
    for (;;) {
        char res[PEND_MAX * (KEYLEN + 24)];
        rotate_log();
        pend_load();
        scan();
        residue_text(res, sizeof res);
        if (!cx_fmt(line, sizeof line, "ts=%ld scan procs=%d keys=%d over=%d max=%d top=%s:%d mode=%s",
                    sy_now_ms(), nrec, nkeys, nover, max_procs, top_key >= 0 ? keys[top_key] : "-", top_n,
                    enforce ? "enforce" : "dry")) {
            app(line, sizeof line, res);
            logline(line);
        }
        if (res[0]) printf("procguard: scan residue%s\n", res);
        if (npend) { npend = 0; sy_unlink(pendpath); }   /* consumed by this scan line */
        act();
        if (once) { printf("procguard: once procs=%d keys=%d over=%d killed=%d mode=%s\n", nrec, nkeys, nover, killed_total, enforce ? "enforce" : "dry"); break; }
        sy_sleep_ms(tick_ms);
    }
    if (lockfd >= 0) sy_close(lockfd);
    return 0;
}
