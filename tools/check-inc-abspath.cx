#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use text.text
/* Table + Linux oracle. Changing exec/pp must: seed-gen pp --shared-predefines
   (tokenpp/warnpp-shared) rc0, then -E against a *new* pkg.bin (INC_ABSPATH_PKG),
   then slice. Installed -E does not use the new net. Missing pkg → NOT_RUN. */
static int bad;
static int fail(const char *w) {
    sy_eprintf("check-inc-abspath\tFAIL\t%s\n", w);
    bad = 1;
    return 1;
}

static int letter(int c) {
    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z');
}

static int drive_abs(int drive_letter, const char *p) {
    if (!p || !p[0] || !p[1] || !p[2]) return 0;
    if (!letter(p[0] & 255) || p[1] != ':') return 0;
    if (p[2] != '/' && p[2] != '\\') return 0;
    return drive_letter != 0;
}

static size_t slen(const char *s) { size_t i = 0; while (s[i]) i++; return i; }
static int has(const char *h, const char *n) {
    size_t i, k;
    if (!h) return 0;
    for (i = 0; h[i]; i++) {
        for (k = 0; n[k] && h[i + k] == n[k]; k++) ;
        if (!n[k]) return 1;
    }
    return 0;
}

/* Drive-letter probe: real directory named "C:" holding dh.h, src/dc.c includes "C:/dh.h".
   win must find it as an absolute path and expand DH; lnx must refuse it (relative lookup, no ./C: from src/).
   Package and entry come from INC_ABSPATH_PKG/INC_ABSPATH_ENTRY, else NOT_RUN. */
static void drive_probe(void) {
    static char cmd[4096], pkg[1024], ent[1024], dir[1024];
    char *av[5], *o = 0;
    size_t n = 0;
    const char *ep = getenv("INC_ABSPATH_PKG"), *ee = getenv("INC_ABSPATH_ENTRY");
    int k;
    if (ep && ep[0] && ee && ee[0]) {
        cx_fmt(pkg, sizeof pkg, "%s", ep); cx_fmt(ent, sizeof ent, "%s", ee);
    } else {
        sy_printf("INC_ABSPATH_DRIVE\tNOT_RUN\tset INC_ABSPATH_PKG and INC_ABSPATH_ENTRY (chain pkg.bin and ctrl entry.elf)\n");
        return;
    }
    cx_fmt(dir, sizeof dir, "%s/inc-abspath-probe.%d", getenv("TMPDIR") && getenv("TMPDIR")[0] ? getenv("TMPDIR") : "/tmp", (int)getpid());
    sy_mkdir(dir, 0755);
    cx_fmt(cmd, sizeof cmd, "%s/C:", dir); sy_mkdir(cmd, 0755);
    cx_fmt(cmd, sizeof cmd, "%s/src", dir); sy_mkdir(cmd, 0755);
    cx_fmt(cmd, sizeof cmd, "%s/C:/dh.h", dir);
    if (cx_write(cmd, "#define DH 7\n", slen("#define DH 7\n"))) { fail("probe-write"); return; }
    cx_fmt(cmd, sizeof cmd, "%s/src/dc.c", dir);
    if (cx_write(cmd, "#include \"C:/dh.h\"\nint main(void){return DH;}\n", slen("#include \"C:/dh.h\"\nint main(void){return DH;}\n"))) { fail("probe-write"); return; }
    for (k = 0; k < 2; k++) {
        const char *t = k ? "lnx/x86_64" : "win/x86_64";
        cx_fmt(cmd, sizeof cmd, "cd %s && UNISA_CONTAINER=%s %s -b %s -E src/dc.c 2>&1", dir, pkg, ent, t);
        av[0] = "sh"; av[1] = "-c"; av[2] = cmd; av[3] = 0;
        o = 0; n = 0;
        cx_runv_timeout(av, 30, &o, &n);
        if (k == 0 && !(has(o, "return") && has(o, "7"))) fail("win-drive-abs-not-found");
        if (k == 1 && (has(o, "return") || !o || !o[0])) fail("lnx-drive-abs-accepted");
        if (!bad) sy_printf("INC_ABSPATH_DRIVE\t%s\t%s\n", t, k ? "refused" : "expanded");
    }
    cx_rmtree(dir);
}

int main(void) {
    char *out;
    size_t n = 0;
    char *av[8];
    int rc;
    av[0] = "./tools/bound"; av[1] = "50"; av[2] = "sh"; av[3] = "./unisacc.com";
    av[4] = "tools/inc-abspath-gen.cx"; av[5] = "--"; av[6] = "--check"; av[7] = 0;
    rc = cx_runv_timeout(av, 55, &out, &n);
    if (rc != 0) return fail("gen-check");
    if (drive_abs(0, "C:/x.h")) return fail("lnx-abs");
    if (!drive_abs(1, "C:/x.h")) return fail("win-slash");
    if (!drive_abs(1, "C:\\x.h")) return fail("win-backslash");
    if (drive_abs(1, "C:x.h")) return fail("no-sep");
    if (!getenv("INC_ABSPATH_PKG") || !getenv("INC_ABSPATH_PKG")[0])
        sy_printf("INC_ABSPATH_PKG\tNOT_RUN\n");
    drive_probe();
    if (!bad) sy_printf("INC_ABSPATH\tok=1\tfailed=0\n");
    return bad;
}
