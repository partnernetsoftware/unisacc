/* Eight real layout contracts. Candidate hashes are independently generated by the legacy
 * packager in release/testdata/layout-candidate.tsv, never derived from this implementation. */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sys.sig
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.releasecandidate
#pragma unisa use text.text
#pragma unisa use text.fmt
static int assertions,failed;
static char root[4096],tmp[4096],table[4400];
static RcCandidate candidate;
static long length(const char *s){long n=tx_len(s,1<<20);if(n<0)sy_exit(2);return n;}
static void print(const char *s){if(sy_write_all(1,s,length(s)))sy_exit(2);}
static void ck(int ok,const char *s){assertions++;if(!ok)failed++;print(ok?"PASS\t":"FAIL\t");print(s);print("\n");}
static void path(char *p,const char *base,const char *name){int n=tx_snprintf(p,4400,"%s/%s",base,name);if(n<0||n>=4400)sy_exit(2);}
static int run(char **v,const char *cwd,char *out,int cap){np_result r={0};char why[512]={0};int rc;if(np_run(v,cwd,0,45,&r,why,sizeof why)){np_free(&r);return 125;}rc=r.rc;if(out&&tx_copy(out,cap,r.out,r.outn)){np_free(&r);sy_exit(2);}np_free(&r);return rc;}
static void writefile(const char *p,const char *s){int f=sy_open(p,O_WRONLY|O_CREAT|O_TRUNC,0600);if(f<0||sy_write_all(f,s,length(s))||sy_close(f))sy_exit(2);}
static int tool(const char *a,const char *b){char exe[4400],script[4400];char *v[]={"sh",exe,script,"--","--candidate",table,(char *)a,(char *)b,0};path(exe,root,"unisacc.com");path(script,root,"tools/release-layout.cx");return run(v,root,0,0);}
static int tool2(const char *tbl,const char *a,const char *b){char exe[4400],script[4400];char *v[]={"sh",exe,script,"--","--candidate",(char *)tbl,(char *)a,(char *)b,0};path(exe,root,"unisacc.com");path(script,root,"tools/release-layout.cx");return run(v,root,0,0);}
static void mktable(const char *dest,const RcCandidate *c,const char *ver,const char *zname,const char *zsha){
    char row[4400];int g,n,i;
    n=tx_snprintf(row,sizeof row,"repo\ttag\tcommit\tversion\tworkflow\tworkflow_ref\tci_run_id\tape\tape_sha256\tpackage\tpackage_sha256\twin_arm64\twin_arm64_sha256\trecord\trecord_sha256\tbuild_alias\tbuild_alias_sha256\tzip\tzip_sha256\tchecksums\tchecksums_sha256\n%s\t%s\t%s\t%s\t%s\t%s\t%s",c->repo,c->tag,c->commit,ver,c->workflow,c->workflow_ref,c->ci_run_id);
    if(n<0||n>=sizeof row)sy_exit(2);
    g=sy_open_new(dest,0600);if(g<0||sy_write_all(g,row,n))sy_exit(2);
    for(i=0;i<7;i++){const char *nm=i==5?zname:c->name[i],*sh=i==5?zsha:c->sha[i];n=tx_snprintf(row,sizeof row,"\t%s\t%s",nm,sh);if(n<0||n>=sizeof row||sy_write_all(g,row,n))sy_exit(2);}
    if(sy_write_all(g,"\n",1)||sy_close(g))sy_exit(2);
}
static int contains(const char *s,const char *needle){long i,n=length(s),m=length(needle);for(i=0;i+m<=n;i++)if(tx_same(s+i,m,needle,m))return 1;return 0;}
int main(void){char src[4400],out[4400],p[4400],q[4400],text[8192],why[512]={0};char *v[12];int i,n;
    if(sy_cwd(root,sizeof root)<0)return 2;path(table,root,"release/testdata/layout-candidate.tsv");if(rcand_load(table,&candidate,why,sizeof why))return 2;
    {const char *td=sy_env("TMPDIR");if(!td||!td[0])td="/tmp";for(i=0;i<100;i++){n=tx_snprintf(tmp,sizeof tmp,"%s/check-release-layout-%d-%d",td,sy_pid(),i);if(n<0||n>=sizeof tmp)return 2;if(!sy_mkdir(tmp,0700))break;}}if(i==100)return 2;
    path(src,tmp,"src");path(out,tmp,"out");if(sy_mkdir(src,0700))return 2;
    path(p,src,candidate.name[0]);writefile(p,"compiler fixture");path(p,src,candidate.name[1]);writefile(p,"package fixture");path(p,src,candidate.name[2]);writefile(p,"slice fixture");
    v[0]="sha256sum";v[1]="--";v[2]=candidate.name[0];v[3]=0;if(run(v,src,text,sizeof text)||length(text)<64)return 2;text[64]=0;n=tx_snprintf(q,sizeof q,"{\"product_digest\": \"%s\",\"schema\":1}\n",text);if(n<0||n>=sizeof q)return 2;path(p,src,candidate.name[3]);writefile(p,q);
    ck(tool(src,out)==0,"generate-layout");ck(tool("--check",out)==0,"check-layout");ck(tool(src,out)!=0,"refuse-existing-output");
    v[0]="sha256sum";v[1]="-c";v[2]=candidate.name[6];v[3]=0;ck(run(v,out,0,0)==0,"external-checksums");
    v[0]="unzip";v[1]="-Z1";v[2]=candidate.name[5];v[3]=0;ck(run(v,out,text,sizeof text)==0&&tx_eqz(text,"slice-win-arm64\npkg.bin\nrun.cmd\nREADME-win-arm64.txt\n"),"fixed-zip-members");
    v[0]="unzip";v[1]="-p";v[2]=candidate.name[5];v[3]="run.cmd";v[4]=0;ck(run(v,out,text,sizeof text)==0&&contains(text,"UNISA_CONTAINER=%~dp0pkg.bin")&&contains(text,"slice-win-arm64.exe\" %*")&&contains(text,"exit /b %errorlevel%"),"launcher-container-and-arguments");
    path(p,out,candidate.name[1]);writefile(p,"Package fixture");ck(tool("--check",out)!=0,"one-byte-package-corruption-refused");writefile(p,"package fixture");
    path(p,out,candidate.name[5]);{int f=sy_open(p,O_WRONLY|O_APPEND,0);if(f<0||sy_write_all(f,"X",1)||sy_close(f))return 2;}
    /* Re-pin a temporary candidate to all seven corrupted-layout assets, so this
       assertion exercises ZIP reconstruction rather than the candidate SHA gate. */
    path(p,out,candidate.name[6]);{int f=sy_open(p,O_WRONLY|O_TRUNC,0);if(f<0)return 2;for(i=0;i<6;i++){v[0]="sha256sum";v[1]="--";v[2]=candidate.name[i];v[3]=0;if(run(v,out,text,sizeof text)||sy_write_all(f,text,length(text)))return 2;}if(sy_close(f))return 2;}
    {
        int f=sy_open_read(table),g;long got,header;
        RcCandidate changed;
        if(f<0)return 2;got=sy_read(f,text,sizeof text);if(sy_close(f)||got<=0)return 2;
        header=tx_chr(text,got,'\n');if(header<0)return 2;
        path(table,tmp,"corrupted-candidate.tsv");g=sy_open_new(table,0600);
        if(g<0||sy_write_all(g,text,header+1))return 2;
        n=tx_snprintf(q,sizeof q,"%s\t%s\t%s\t%s\t%s\t%s\t%s",candidate.repo,candidate.tag,candidate.commit,candidate.version,candidate.workflow,candidate.workflow_ref,candidate.ci_run_id);
        if(n<0||n>=sizeof q||sy_write_all(g,q,n))return 2;
        for(i=0;i<7;i++){
            v[0]="sha256sum";v[1]="--";v[2]=candidate.name[i];v[3]=0;
            if(run(v,out,text,sizeof text)||length(text)<64)return 2;text[64]=0;
            n=tx_snprintf(q,sizeof q,"\t%s\t%s",candidate.name[i],text);
            if(n<0||n>=sizeof q||sy_write_all(g,q,n))return 2;
        }
        if(sy_write_all(g,"\n",1)||sy_close(g))return 2;
        if(rcand_load(table,&changed,why,sizeof why)||rcand_verify(&changed,out,7,why,sizeof why))return 2;
    }
    v[0]="sha256sum";v[1]="-c";v[2]=candidate.name[6];v[3]=0;i=run(v,out,0,0);ck(i==0&&tool("--check",out)!=0,"zip-corruption-refused-even-with-new-manifest");
    /* 0.0.63 contract: no win-arm64 zip. Cases above keep the 0.0.46 contract unchanged. */
    ck(rcand_has_zip("0.0.46")&&rcand_has_zip("0.0.62")&&!rcand_has_zip("0.0.63")&&!rcand_has_zip("0.0.100")&&!rcand_has_zip("0.1.0"),"zip-threshold-version-compare");
    {
        char t63[4400],t62[4400],tbad[4400],o63[4400],o62[4400],obad[4400];
        path(t63,tmp,"c63.tsv");path(t62,tmp,"c62dash.tsv");path(tbad,tmp,"c63zip.tsv");path(o63,tmp,"out63");path(o62,tmp,"out62");path(obad,tmp,"out63bad");
        mktable(t63,&candidate,"0.0.63","-","-");mktable(t62,&candidate,"0.0.62","-","-");mktable(tbad,&candidate,"0.0.63","unisacc-0.0.63-win-arm64.zip",candidate.sha[5]);
        ck(tool2(t63,src,o63)==0,"v63-generate-without-zip");
        {RcCandidate c63=candidate;int r;for(r=4;r<=6;r+=2){v[0]="sha256sum";v[1]="--";v[2]=c63.name[r];v[3]=0;if(run(v,o63,text,sizeof text)||length(text)<64)return 2;text[64]=0;tx_copy(c63.sha[r],65,text,64);}
         path(t63,tmp,"c63pinned.tsv");mktable(t63,&c63,"0.0.63","-","-");}
        ck(tool2(t63,"--check",o63)==0,"v63-check-without-zip");
        path(p,o63,"unisacc-0.0.63-win-arm64.zip");ck(sy_exists(p)!=1,"v63-no-zip-file-produced");
        path(p,o63,"SHA256SUMS");{int f=sy_open_read(p);long got=f<0?-1:sy_read(f,text,sizeof text-1);int lines=0;long k;if(f>=0)sy_close(f);for(k=0;k<got;k++)if(text[k]=='\n')lines++;text[got<0?0:got]=0;ck(got>0&&lines==5&&!contains(text,"zip"),"v63-sums-cover-five-files");}
        v[0]="sha256sum";v[1]="-c";v[2]="SHA256SUMS";v[3]=0;ck(run(v,o63,0,0)==0,"v63-external-checksums");
        path(p,o63,"unisacc-0.0.63-win-arm64.zip");writefile(p,"extra zip");ck(tool2(t63,"--check",o63)!=0,"v63-extra-zip-refused");
        ck(tool2(t62,src,o62)!=0,"v62-dash-zip-refused");
        ck(tool2(tbad,src,obad)!=0,"v63-named-zip-refused");
    }
    /* T1(a): table-driven asset count with backward-compatible optional extra sidecar columns. */
    {
        char t23[4400],t23d[4400],t23bad[4400],o23[4400],o23d[4400],so_sha[65],row[4400];
        RcCandidate c23;
        int g;
        path(p,src,"extra_sidecar.so");writefile(p,"tapemode sidecar fixture");
        v[0]="sha256sum";v[1]="--";v[2]="extra_sidecar.so";v[3]=0;
        if(run(v,src,text,sizeof text)||length(text)<64)return 2;
        tx_copy(so_sha,65,text,64);
        path(t23,tmp,"c23.tsv");path(t23d,tmp,"c23dash.tsv");path(t23bad,tmp,"c23bad.tsv");
        path(o23,tmp,"out23");path(o23d,tmp,"out23dash");
        /* 23-col table with populated extra_so */
        g=sy_open_new(t23,0600);if(g<0)return 2;
        n=tx_snprintf(row,sizeof row,"repo\ttag\tcommit\tversion\tworkflow\tworkflow_ref\tci_run_id\tape\tape_sha256\tpackage\tpackage_sha256\twin_arm64\twin_arm64_sha256\trecord\trecord_sha256\tbuild_alias\tbuild_alias_sha256\tzip\tzip_sha256\tchecksums\tchecksums_sha256\textra_so\textra_so_sha256\n%s\t%s\t%s\t0.1.5\t%s\t%s\t%s",candidate.repo,candidate.tag,candidate.commit,candidate.workflow,candidate.workflow_ref,candidate.ci_run_id);
        if(n<0||sy_write_all(g,row,n))return 2;
        for(i=0;i<7;i++){const char *nm=i==5?"-":candidate.name[i],*sh=i==5?"-":candidate.sha[i];n=tx_snprintf(row,sizeof row,"\t%s\t%s",nm,sh);if(n<0||sy_write_all(g,row,n))return 2;}
        n=tx_snprintf(row,sizeof row,"\textra_sidecar.so\t%s\n",so_sha);if(n<0||sy_write_all(g,row,n)||sy_close(g))return 2;
        ck(rcand_load(t23,&c23,why,sizeof why)==0&&c23.extra_n==1&&rcand_sums_count(&c23)==6&&rcand_upload_count(&c23)==7,"t1a-extra-col-loads-six-sums");
        ck(tool2(t23,src,o23)==0,"t1a-generate-layout-with-extra");
        {   RcCandidate cp=c23;int r;
            for(r=4;r<=6;r+=2){v[0]="sha256sum";v[1]="--";v[2]=cp.name[r];v[3]=0;if(run(v,o23,text,sizeof text)||length(text)<64)return 2;tx_copy(cp.sha[r],65,text,64);}
            path(t23,tmp,"c23pinned.tsv");g=sy_open_new(t23,0600);if(g<0)return 2;
            n=tx_snprintf(row,sizeof row,"repo\ttag\tcommit\tversion\tworkflow\tworkflow_ref\tci_run_id\tape\tape_sha256\tpackage\tpackage_sha256\twin_arm64\twin_arm64_sha256\trecord\trecord_sha256\tbuild_alias\tbuild_alias_sha256\tzip\tzip_sha256\tchecksums\tchecksums_sha256\textra_so\textra_so_sha256\n%s\t%s\t%s\t0.1.5\t%s\t%s\t%s",cp.repo,cp.tag,cp.commit,cp.workflow,cp.workflow_ref,cp.ci_run_id);
            if(n<0||sy_write_all(g,row,n))return 2;
            for(i=0;i<7;i++){const char *nm=i==5?"-":cp.name[i],*sh=i==5?"-":cp.sha[i];n=tx_snprintf(row,sizeof row,"\t%s\t%s",nm,sh);if(n<0||sy_write_all(g,row,n))return 2;}
            n=tx_snprintf(row,sizeof row,"\textra_sidecar.so\t%s\n",so_sha);if(n<0||sy_write_all(g,row,n)||sy_close(g))return 2;
        }
        ck(tool2(t23,"--check",o23)==0,"t1a-check-layout-with-extra");
        path(p,o23,"SHA256SUMS");{int f=sy_open_read(p);long got=f<0?-1:sy_read(f,text,sizeof text-1);int lines=0;long k;if(f>=0)sy_close(f);for(k=0;k<got;k++)if(text[k]=='\n')lines++;text[got<0?0:got]=0;ck(got>0&&lines==6&&contains(text,"extra_sidecar.so"),"t1a-sums-cover-six-files");}
        /* Negative control: corrupt extra_sidecar.so -> refused */
        path(p,o23,"extra_sidecar.so");writefile(p,"Tapemode sidecar fixture");
        ck(tool2(t23,"--check",o23)!=0,"t1a-extra-corruption-refused");
        /* 23-col table with dash extra stays at 5 sums */
        g=sy_open_new(t23d,0600);if(g<0)return 2;
        n=tx_snprintf(row,sizeof row,"repo\ttag\tcommit\tversion\tworkflow\tworkflow_ref\tci_run_id\tape\tape_sha256\tpackage\tpackage_sha256\twin_arm64\twin_arm64_sha256\trecord\trecord_sha256\tbuild_alias\tbuild_alias_sha256\tzip\tzip_sha256\tchecksums\tchecksums_sha256\ttape_so\ttape_so_sha256\n%s\t%s\t%s\t0.1.5\t%s\t%s\t%s",candidate.repo,candidate.tag,candidate.commit,candidate.workflow,candidate.workflow_ref,candidate.ci_run_id);
        if(n<0||sy_write_all(g,row,n))return 2;
        for(i=0;i<7;i++){const char *nm=i==5?"-":candidate.name[i],*sh=i==5?"-":candidate.sha[i];n=tx_snprintf(row,sizeof row,"\t%s\t%s",nm,sh);if(n<0||sy_write_all(g,row,n))return 2;}
        n=tx_snprintf(row,sizeof row,"\t-\t-\n");if(n<0||sy_write_all(g,row,n)||sy_close(g))return 2;
        ck(rcand_load(t23d,&c23,why,sizeof why)==0&&c23.extra_n==0&&rcand_sums_count(&c23)==5,"t1a-dash-extra-keeps-five");
        /* Negative control: mismatched extra header rejected */
        g=sy_open_new(t23bad,0600);if(g<0)return 2;
        n=tx_snprintf(row,sizeof row,"repo\ttag\tcommit\tversion\tworkflow\tworkflow_ref\tci_run_id\tape\tape_sha256\tpackage\tpackage_sha256\twin_arm64\twin_arm64_sha256\trecord\trecord_sha256\tbuild_alias\tbuild_alias_sha256\tzip\tzip_sha256\tchecksums\tchecksums_sha256\ttape_so\tbad_col\n%s\t%s\t%s\t0.1.5\t%s\t%s\t%s",candidate.repo,candidate.tag,candidate.commit,candidate.workflow,candidate.workflow_ref,candidate.ci_run_id);
        if(n<0||sy_write_all(g,row,n))return 2;
        for(i=0;i<7;i++){const char *nm=i==5?"-":candidate.name[i],*sh=i==5?"-":candidate.sha[i];n=tx_snprintf(row,sizeof row,"\t%s\t%s",nm,sh);if(n<0||sy_write_all(g,row,n))return 2;}
        n=tx_snprintf(row,sizeof row,"\t-\t-\n");if(n<0||sy_write_all(g,row,n)||sy_close(g))return 2;
        ck(rcand_load(t23bad,&c23,why,sizeof why)!=0,"t1a-bad-extra-header-refused");
        /* B1: duplicate extra column key or reusing core column key must be refused */
        {
            char tdup[4400],tcore[4400];
            path(tdup,tmp,"c25dup.tsv");path(tcore,tmp,"c23core.tsv");
            g=sy_open_new(tdup,0600);if(g<0)return 2;
            n=tx_snprintf(row,sizeof row,"repo\ttag\tcommit\tversion\tworkflow\tworkflow_ref\tci_run_id\tape\tape_sha256\tpackage\tpackage_sha256\twin_arm64\twin_arm64_sha256\trecord\trecord_sha256\tbuild_alias\tbuild_alias_sha256\tzip\tzip_sha256\tchecksums\tchecksums_sha256\ttape_so\ttape_so_sha256\ttape_so\ttape_so_sha256\n%s\t%s\t%s\t0.1.5\t%s\t%s\t%s",candidate.repo,candidate.tag,candidate.commit,candidate.workflow,candidate.workflow_ref,candidate.ci_run_id);
            if(n<0||sy_write_all(g,row,n))return 2;
            for(i=0;i<7;i++){const char *nm=i==5?"-":candidate.name[i],*sh=i==5?"-":candidate.sha[i];n=tx_snprintf(row,sizeof row,"\t%s\t%s",nm,sh);if(n<0||sy_write_all(g,row,n))return 2;}
            n=tx_snprintf(row,sizeof row,"\t-\t-\ttapemode.so\t%s\n",so_sha);if(n<0||sy_write_all(g,row,n)||sy_close(g))return 2;
            ck(rcand_load(tdup,&c23,why,sizeof why)!=0&&contains(why,"duplicate column name"),"t1a-b1-dup-extra-header-refused");

            g=sy_open_new(tcore,0600);if(g<0)return 2;
            n=tx_snprintf(row,sizeof row,"repo\ttag\tcommit\tversion\tworkflow\tworkflow_ref\tci_run_id\tape\tape_sha256\tpackage\tpackage_sha256\twin_arm64\twin_arm64_sha256\trecord\trecord_sha256\tbuild_alias\tbuild_alias_sha256\tzip\tzip_sha256\tchecksums\tchecksums_sha256\tape\tape_sha256\n%s\t%s\t%s\t0.1.5\t%s\t%s\t%s",candidate.repo,candidate.tag,candidate.commit,candidate.workflow,candidate.workflow_ref,candidate.ci_run_id);
            if(n<0||sy_write_all(g,row,n))return 2;
            for(i=0;i<7;i++){const char *nm=i==5?"-":candidate.name[i],*sh=i==5?"-":candidate.sha[i];n=tx_snprintf(row,sizeof row,"\t%s\t%s",nm,sh);if(n<0||sy_write_all(g,row,n))return 2;}
            n=tx_snprintf(row,sizeof row,"\ttapemode.so\t%s\n",so_sha);if(n<0||sy_write_all(g,row,n)||sy_close(g))return 2;
            ck(rcand_load(tcore,&c23,why,sizeof why)!=0&&contains(why,"duplicate column name"),"t1a-b1-core-extra-header-refused");
        }
        /* B2: c47-1-readback.cx step download + asset-sha + layout-generate must fetch and verify all extra assets */
        {
            char fbin[4400],ghp[4400],rbout[4400],rbscript[4400],exe[4400],pathenv[4600],ghs[2048];
            /* Restore clean extra_sidecar.so in o23 after negative test above */
            path(p,o23,"extra_sidecar.so");writefile(p,"tapemode sidecar fixture");
            path(fbin,tmp,"fbin");if(sy_mkdir(fbin,0700))return 2;
            path(ghp,fbin,"gh");
            n=tx_snprintf(ghs,sizeof ghs,"#!/bin/sh\nif [ \"$2\" = download ]; then\n  dir=\"\"\n  while [ $# -gt 0 ]; do\n    case \"$1\" in\n      --dir) dir=\"$2\"; shift 2;;\n      --pattern) mkdir -p \"$dir\"; cp '%s/'\"$2\" \"$dir/\" 2>/dev/null || exit 1; shift 2;;\n      *) shift;;\n    esac\n  done\n  exit 0\nfi\nexit 0\n",o23);
            if(n<0||n>=sizeof ghs)return 2;
            writefile(ghp,ghs);
            v[0]="chmod";v[1]="+x";v[2]=ghp;v[3]=0;if(run(v,root,0,0))return 2;
            n=tx_snprintf(pathenv,sizeof pathenv,"PATH=%s:/usr/bin:/bin",fbin);if(n<0||n>=sizeof pathenv)return 2;
            path(exe,root,"unisacc.com");path(rbscript,root,"release/tools/c47-1-readback.cx");
            path(rbout,tmp,"rb23");
            {char *rv[]={"env",pathenv,"sh",exe,rbscript,"--",root,t23,rbout,table,"true","--step","metadata",0};if(run(rv,root,text,sizeof text))return 2;}
            {char *rv[]={"env",pathenv,"sh",exe,rbscript,"--",root,t23,rbout,table,"true","--step","tag",0};if(run(rv,root,text,sizeof text))return 2;}
            {char *rv[]={"env",pathenv,"sh",exe,rbscript,"--",root,t23,rbout,table,"true","--step","download",0};
             ck(run(rv,root,text,sizeof text)==0&&contains(text,"READBACK_STEP download PASS"),"t1a-b2-c47-download-fetches-extra");}
            {char *rv[]={"env",pathenv,"sh",exe,rbscript,"--",root,t23,rbout,table,"true","--step","asset-sha",0};
             ck(run(rv,root,text,sizeof text)==0&&contains(text,"READBACK_SHA extra_sidecar.so"),"t1a-b2-c47-asset-sha-covers-extra");}
        }
        /* B3: release-run.cx step_layout_gen + step_backfill on 23-col table (both populated tape_so and dash -\t-) */
