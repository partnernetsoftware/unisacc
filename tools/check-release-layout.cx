/* Eight real layout contracts. Candidate hashes are independently generated by the legacy
 * packager in release/testdata/layout-candidate.tsv, never derived from this implementation. */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sys.sig
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.releasecandidate
#pragma unisa use text.text
#pragma unisa use text.fmt
static int assertions,failed;
static char root[4096],tmp[4096],table[4400];
static RcCandidate candidate;
static long length(const char *s){long n=tx_len(s,1<<20);if(n<0)sy_exit(2);return n;}
static void print(const char *s){if(sy_write_all(1,s,length(s)))sy_exit(2);}
static void ck(int ok,const char *s){assertions++;if(!ok)failed++;print(ok?"PASS\t":"FAIL\t");print(s);print("\n");}
static void path(char *p,const char *base,const char *name){int n=tx_snprintf(p,4400,"%s/%s",base,name);if(n<0||n>=4400)sy_exit(2);}
static int run(char **v,const char *cwd,char *out,int cap){np_result r={0};char why[512]={0};int rc;if(np_run(v,cwd,0,45,&r,why,sizeof why)){np_free(&r);return 125;}rc=r.rc;if(out&&tx_copy(out,cap,r.out,r.outn)){np_free(&r);sy_exit(2);}np_free(&r);return rc;}
static void writefile(const char *p,const char *s){int f=sy_open(p,O_WRONLY|O_CREAT|O_TRUNC,0600);if(f<0||sy_write_all(f,s,length(s))||sy_close(f))sy_exit(2);}
static int tool(const char *a,const char *b){char exe[4400],script[4400];char *v[]={"sh",exe,script,"--","--candidate",table,(char *)a,(char *)b,0};path(exe,root,"unisacc.com");path(script,root,"tools/release-layout.cx");return run(v,root,0,0);}
static int contains(const char *s,const char *needle){return tx_contains(s,length(s),needle,length(needle));}
int main(void){char src[4400],out[4400],p[4400],q[4400],text[8192],why[512]={0};char *v[12];int i,n;
    if(sy_cwd(root,sizeof root)<0)return 2;path(table,root,"release/testdata/layout-candidate.tsv");if(rcand_load(table,&candidate,why,sizeof why))return 2;
    for(i=0;i<100;i++){n=tx_snprintf(tmp,sizeof tmp,"/tmp/check-release-layout-%d-%d",sy_pid(),i);if(n<0||n>=sizeof tmp)return 2;if(!sy_mkdir(tmp,0700))break;}if(i==100)return 2;
    path(src,tmp,"src");path(out,tmp,"out");if(sy_mkdir(src,0700))return 2;
    path(p,src,candidate.name[0]);writefile(p,"compiler fixture");path(p,src,candidate.name[1]);writefile(p,"package fixture");path(p,src,candidate.name[2]);writefile(p,"slice fixture");
    v[0]="sha256sum";v[1]="--";v[2]=candidate.name[0];v[3]=0;if(run(v,src,text,sizeof text)||length(text)<64)return 2;text[64]=0;n=tx_snprintf(q,sizeof q,"{\"product_digest\": \"%s\",\"schema\":1}\n",text);if(n<0||n>=sizeof q)return 2;path(p,src,candidate.name[3]);writefile(p,q);
    ck(tool(src,out)==0,"generate-layout");ck(tool("--check",out)==0,"check-layout");ck(tool(src,out)!=0,"refuse-existing-output");
    v[0]="sha256sum";v[1]="-c";v[2]=candidate.name[6];v[3]=0;ck(run(v,out,0,0)==0,"external-checksums");
    v[0]="unzip";v[1]="-Z1";v[2]=candidate.name[5];v[3]=0;ck(run(v,out,text,sizeof text)==0&&tx_eqz(text,"slice-win-arm64\npkg.bin\nrun.cmd\nREADME-win-arm64.txt\n"),"fixed-zip-members");
    v[0]="unzip";v[1]="-p";v[2]=candidate.name[5];v[3]="run.cmd";v[4]=0;ck(run(v,out,text,sizeof text)==0&&contains(text,"UNISA_CONTAINER=%~dp0pkg.bin")&&contains(text,"slice-win-arm64.exe\" %*")&&contains(text,"exit /b %errorlevel%"),"launcher-container-and-arguments");
    path(p,out,candidate.name[1]);writefile(p,"Package fixture");ck(tool("--check",out)!=0,"one-byte-package-corruption-refused");writefile(p,"package fixture");
    path(p,out,candidate.name[5]);{int f=sy_open(p,O_WRONLY|O_APPEND,0);if(f<0||sy_write_all(f,"X",1)||sy_close(f))return 2;}
    /* Re-pin a temporary candidate to all seven corrupted-layout assets, so this
       assertion exercises ZIP reconstruction rather than the candidate SHA gate. */
    path(p,out,candidate.name[6]);{int f=sy_open(p,O_WRONLY|O_TRUNC,0);if(f<0)return 2;for(i=0;i<6;i++){v[0]="sha256sum";v[1]="--";v[2]=candidate.name[i];v[3]=0;if(run(v,out,text,sizeof text)||sy_write_all(f,text,length(text)))return 2;}if(sy_close(f))return 2;}
    {
        int f=sy_open_read(table),g;long got,header;
        RcCandidate changed;
        if(f<0)return 2;got=sy_read(f,text,sizeof text);if(sy_close(f)||got<=0)return 2;
        header=tx_chr(text,got,'\n');if(header<0)return 2;
        path(table,tmp,"corrupted-candidate.tsv");g=sy_open_new(table,0600);
        if(g<0||sy_write_all(g,text,header+1))return 2;
        n=tx_snprintf(q,sizeof q,"%s\t%s\t%s\t%s\t%s\t%s\t%s",candidate.repo,candidate.tag,candidate.commit,candidate.version,candidate.workflow,candidate.workflow_ref,candidate.ci_run_id);
        if(n<0||n>=sizeof q||sy_write_all(g,q,n))return 2;
        for(i=0;i<7;i++){
            v[0]="sha256sum";v[1]="--";v[2]=candidate.name[i];v[3]=0;
            if(run(v,out,text,sizeof text)||length(text)<64)return 2;text[64]=0;
            n=tx_snprintf(q,sizeof q,"\t%s\t%s",candidate.name[i],text);
            if(n<0||n>=sizeof q||sy_write_all(g,q,n))return 2;
        }
        if(sy_write_all(g,"\n",1)||sy_close(g))return 2;
        if(rcand_load(table,&changed,why,sizeof why)||rcand_verify(&changed,out,7,why,sizeof why))return 2;
    }
    v[0]="sha256sum";v[1]="-c";v[2]=candidate.name[6];v[3]=0;i=run(v,out,0,0);ck(i==0&&tool("--check",out)!=0,"zip-corruption-refused-even-with-new-manifest");
    v[0]="rm";v[1]="-rf";v[2]=tmp;v[3]=0;if(run(v,root,0,0))return 2;n=tx_snprintf(text,sizeof text,"RELEASE_LAYOUT_CHECK\tassertions=%d\tfailed=%d\n",assertions,failed);if(n<0||n>=sizeof text)return 2;print(text);return failed?1:0;
}
