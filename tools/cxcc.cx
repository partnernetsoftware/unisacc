#pragma unisa module cxcc
#pragma unisa use cxproc
/* Host driver behind gcc_cx and clang_cx.
   Blanks a leading #! line, then runs the system compiler with
   -std=c99 -x c -include <repo>/include/cx.h.
   Stock gcc and clang ignore `#pragma unisa`. A unit that contains
   `#pragma unisa use` is expanded in this process by src/cxmod.c.
   The host driver does not run unisacc.com. -o is the mode this builds.
   Each unit is compiled with that plan's own includes.
   An undeclared call is an error. Compiled units are reused from
   out/cxcc-cache when the compiler, flags, prelude, source, and the
   recorded header closure still match. A header included by an -include
   file is part of that closure. __FILE__ stays the original .cx path.
   This is ordinary C. It does not grant a checked .cx identity.
   The driver names tools/cxproc.cx. On Linux the caller passes environ, and a
   null environment is an empty list. On Windows the caller passes null, and
   CreateProcessA treats that as inherit. gcc and clang are names on PATH.
   On Windows, tools/cxcc-hostinc/spawn.h supplies posix_spawnp with
   CreateProcessA, because MinGW has no spawn.h. The compile line
   adds -I tools/cxcc-hostinc so <spawn.h> and <sys/wait.h> are these files
   and not the product headers. Set CX_ROOT when the repository
   is not found from the driver path or the working directory. */
enum { CXCC_ARGS = 96, CXCC_SRCS = 32, CXCC_PATH = 4096, CXCC_BYTES = 4194304 };

static int ends_with(const char *s, const char *suf) {
    size_t n, m;
    n = strlen(s);
    m = strlen(suf);
    return n >= m && memcmp(s + n - m, suf, m) == 0;
}

static int copy_str(char *dst, size_t cap, const char *src) {
    size_t n = strlen(src);
    if (n + 1 > cap) return -1;
    { void *cx_kept = memcpy(dst, src, n + 1); (void)cx_kept; }
    return 0;
}

static void cxcc_too_many(const char *cmd);
static int cxcc_samez(const char *a, const char *b);
static int is_repo(const char *dir) {
    char p[CXCC_PATH];
    int n = snprintf(p, sizeof p, "%s/include/cx.h", dir);
    if (n < 0 || n >= (int)sizeof p) return 0;
    return access(p, F_OK) == 0;
}

static void dirname_inplace(char *p) {
    char *sl = strrchr(p, '/');
    char *bs = strrchr(p, '\\');
    if (bs && (!sl || bs > sl)) sl = bs;
    if (!sl) {
        p[0] = '.';
        p[1] = 0;
        return;
    }
    if (sl == p) {
        p[1] = 0;
        return;
    }
    *sl = 0;
}

static int walk_up(char *dir) {
    char prev[CXCC_PATH];
    for (;;) {
        if (is_repo(dir)) return 0;
        if (copy_str(prev, sizeof prev, dir)) return -1;
        dirname_inplace(dir);
        if (cxcc_samez(prev, dir)) return -1;
    }
}

static int find_repo(const char *argv0, char *out, size_t cap) {
    const char *env = getenv("CX_ROOT");
    char buf[CXCC_PATH];
    if (env && env[0]) {
        size_t n;
        if (copy_str(buf, sizeof buf, env)) return -1;
        n = strlen(buf);
        while (n > 1 && (buf[n - 1] == '/' || buf[n - 1] == '\\')) buf[--n] = 0;
        if (!is_repo(buf)) return -2;
        return copy_str(out, cap, buf);
    }
    if (argv0 && argv0[0] && realpath(argv0, buf)) {
        dirname_inplace(buf);
        if (walk_up(buf) == 0) return copy_str(out, cap, buf);
    }
    if (!getcwd(buf, sizeof buf)) return -1;
    if (walk_up(buf) == 0) return copy_str(out, cap, buf);
    return -1;
}

static int takes_arg(const char *a) {
    return !strcmp(a, "-o") || !strcmp(a, "-I") || !strcmp(a, "-include") ||
           !strcmp(a, "-imacros") || !strcmp(a, "-isystem") || !strcmp(a, "-idirafter") ||
           !strcmp(a, "-D") || !strcmp(a, "-U") || !strcmp(a, "-L") || !strcmp(a, "-l") ||
           !strcmp(a, "-x") || !strcmp(a, "-MF") || !strcmp(a, "-MT") || !strcmp(a, "-MQ") ||
           !strcmp(a, "-b") || !strcmp(a, "-t") || !strcmp(a, "-B");
}

static int cxcc_eq(const unsigned char *s, size_t b, size_t e, const char *w) {
    size_t n = strlen(w);
    return e >= b && e - b == n && memcmp(s + b, w, n) == 0;
}

static size_t cxcc_word(const unsigned char *s, size_t n, size_t i, size_t *wb) {
    while (i < n && s[i] != '\n' && s[i] <= 32) i++;
    *wb = i;
    while (i < n && s[i] != '\n' && s[i] > 32) i++;
    return i;
}

/* Same shape as cxm_directive: '#' at the start of a line, then the words
   pragma, unisa. Any unisa pragma must go through cxm_plan, not only use:
   an unknown/module/position/conditional pragma is a checked refusal. */
static int has_unisa(const unsigned char *s, size_t n) {
    size_t i = 0, bol = 1, a, b;
    while (i < n) {
        if (s[i] == '\n') { bol = 1; i++; continue; }
        if (s[i] <= 32) { i++; continue; }
        if (bol && s[i] == '#') {
            b = cxcc_word(s, n, i + 1, &a);
            if (cxcc_eq(s, a, b, "pragma")) {
                b = cxcc_word(s, n, b, &a);
                if (cxcc_eq(s, a, b, "unisa") && (b >= n || s[b] == '\n' || s[b] <= 32)) return 1;
            }
            while (i < n && s[i] != '\n') i++;
            continue;
        }
        bol = 0;
        i++;
    }
    return 0;
}

static void blank_shebang(unsigned char *s, size_t n) {
    size_t i;
    if (n < 2 || s[0] != '#' || s[1] != '!') return;
    for (i = 0; i < n && s[i] != '\n'; i++) s[i] = ' ';
}

static int read_cap(const char *path, unsigned char **out, size_t *out_n) {
    FILE *f;
    long sz;
    unsigned char *buf;
    size_t n;
    f = fopen(path, "rb");
    if (!f) return 1;
    if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return 1; }
    sz = ftell(f);
    if (sz < 0 || sz > CXCC_BYTES) { fclose(f); return 2; }
    if (fseek(f, 0, SEEK_SET) != 0) { fclose(f); return 1; }
    buf = (unsigned char *)malloc((size_t)sz + 1);
    if (!buf) { fclose(f); return 1; }
    n = fread(buf, 1, (size_t)sz, f);
    fclose(f);
    if (n != (size_t)sz) { free(buf); return 1; }
    buf[n] = 0;
    *out = buf;
    *out_n = n;
    return 0;
}

#ifdef _WIN32
#ifndef CXCC_TEMP_TEMPLATE
/* Product slices do not include tools/cxcc-hostinc. The host Windows
   build defines CXCC_TEMP_TEMPLATE and keeps its own GetTempPathA body. */
static int cxcc_temp_template(char *dst, size_t cap) {
    const char *td;
    size_t i, n;
    const char *suf = "cxccXXXXXX";
    td = getenv("TMPDIR");
    if (!td || !td[0]) td = getenv("TEMP");
    if (!td || !td[0]) td = getenv("TMP");
    if (!td || !td[0]) td = ".";
    n = strlen(td);
    if (n + 16 >= cap) return -1;
    { void *cx_kept = memcpy(dst, td, n); (void)cx_kept; }
    i = n;
    if (i && dst[i - 1] != '\\' && dst[i - 1] != '/') dst[i++] = '\\';
    if (i + 11 >= cap) return -1;
    memcpy(dst + i, suf, 11);
    return 0;
}
#endif
#endif

static int write_temp(const unsigned char *s, size_t n, char *path, size_t path_cap) {
    char tmpl[CXCC_PATH];
    int fd;
    FILE *f;
#ifdef _WIN32
    if (cxcc_temp_template(tmpl, sizeof tmpl)) return -1;
#else
    if (copy_str(tmpl, sizeof tmpl, "/tmp/cxccXXXXXX")) return -1;
#endif
    fd = mkstemp(tmpl);
    if (fd < 0) return -1;
    if (close(fd) != 0) { unlink(tmpl); return -1; }
    f = fopen(tmpl, "wb");
    if (!f) { unlink(tmpl); return -1; }
    if (n && fwrite(s, 1, n, f) != n) { fclose(f); unlink(tmpl); return -1; }
    if (fclose(f) != 0) { unlink(tmpl); return -1; }
    if (copy_str(path, path_cap, tmpl)) { unlink(tmpl); return -1; }
    return 0;
}

/* Module expansion. src/cxmod.c is the resolver, linked into this driver.
   The driver does not run unisacc.com. Each unit keeps the includes from its
   own plan row. The result is ordinary C, not a checked build. */
#define CXCC_UNITS 64
#define CXCC_PLANARGS 256
#define CXCC_TMP 260

static int cxcc_exec(const char *cmd, const char *what, char **av) {
    int st = 0;
    int spr;
    extern int cxproc_run(char **argv, char **envp, int *status);
    spr = cxproc_run(av, environ, &st);
    if (spr == 127) {
        fprintf(stderr, "%s: cannot run %s\n", cmd, what);
        return 127;
    }
    if (spr != 0) {
        fprintf(stderr, "%s: lost %s\n", cmd, what);
        return 2;
    }
    return st;
}

static void cxcc_blank_paths(char paths[][CXCC_TMP], int n) {
    int i;
    for (i = 0; i < n; i++) paths[i][0] = 0;
}

static void cxcc_unlink_paths(char paths[][CXCC_TMP], int n) {
    int i;
    for (i = 0; i < n; i++) if (paths[i][0]) unlink(paths[i]);
}

static int cxcc_fields(char *line, char **f, int cap) {
    int n = 0;
    char *p;
    if (!line[0]) return 0;
    f[0] = line;
    n = 1;
    for (p = line; *p; p++) {
        if (*p == '\t') {
            if (n >= cap) return -1;
            *p = 0;
            f[n++] = p + 1;
        }
    }
    return n;
}

static int cxcc_linkish(const char *a, int *need) {
    *need = 0;
    if (!strcmp(a, "-o") || !strcmp(a, "-l") || !strcmp(a, "-L")) { *need = 1; return 1; }
    if (!strncmp(a, "-Wl,", 4)) return 1;
    if (a[0] == '-' && (a[1] == 'l' || a[1] == 'L') && a[2] != 0) return 1;
    if (!strcmp(a, "-shared") || !strcmp(a, "-static") || !strcmp(a, "-pie") ||
        !strcmp(a, "-static-libgcc") || !strcmp(a, "-s")) return 1;
    if (ends_with(a, ".o") || ends_with(a, ".a") || ends_with(a, ".so")) return 1;
    return 0;
}

static int cxcc_ensure_dir(const char *path) {
    struct stat st;
    if (mkdir(path, 0755) == 0) return 0;
    if (errno == EEXIST && stat(path, &st) == 0 && S_ISDIR(st.st_mode)) return 0;
    return -1;
}

static void cxcc_fold(unsigned char acc[32], const void *p, size_t n) {
    unsigned char one[32], cat[64];
    cx_sha256(p, n, one);
    memcpy(cat, acc, 32);
    memcpy(cat + 32, one, 32);
    cx_sha256(cat, 64, acc);
}

static void cxcc_fold_str(unsigned char acc[32], const char *s) {
    cxcc_fold(acc, s, strlen(s));
}

static int cxcc_fold_file(unsigned char acc[32], const char *path) {
    unsigned char *buf = 0;
    size_t n = 0;
    int rr = read_cap(path, &buf, &n);
    if (rr != 0) return -1;
    cxcc_fold(acc, buf, n);
    free(buf);
    return 0;
}

/* -include and -imacros name files. The cache key follows their bytes,
   so a later edit of that file cannot reuse the old object. */
static int cxcc_fold_cflags(unsigned char acc[32], char **cflags, int nc) {
    int i;
    const char *a, *path;
    for (i = 0; i < nc; i++) {
        a = cflags[i];
        path = 0;
        cxcc_fold_str(acc, a);
        if (!strcmp(a, "-include") || !strcmp(a, "-imacros")) {
            if (i + 1 >= nc) return -1;
            path = cflags[i + 1];
        } else if (!strncmp(a, "-include", 8) && a[8]) {
            path = a + 8;
        } else if (!strncmp(a, "-imacros", 8) && a[8]) {
            path = a + 8;
        }
        if (path && cxcc_fold_file(acc, path)) return -1;
    }
    return 0;
}

static void cxcc_hex32(const unsigned char md[32], char out[65]) {
    static const char *hexd = "0123456789abcdef";
    int i;
    for (i = 0; i < 32; i++) {
        out[i * 2] = hexd[md[i] >> 4];
        out[i * 2 + 1] = hexd[md[i] & 15];
    }
    out[64] = 0;
}

static char cxcc_cid[160];
static int cxcc_cid_set;

static int cxcc_compiler_tag(const char *compiler) {
    const char *env, *p, *q;
    char tryb[CXCC_PATH];
    char name[2][80];
    struct stat st;
    int n, k, clen, pass, npass;
    char sep;
    clen = (int)strlen(compiler);
    if (clen <= 0 || clen >= 60) return -1;
    if (cxcc_cid_set && strncmp(cxcc_cid, compiler, (size_t)clen) == 0 && cxcc_cid[clen] == '\n') return 0;
    { void *cx_kept = memcpy(name[0], compiler, (size_t)clen + 1); (void)cx_kept; }
    npass = 1;
#ifdef _WIN32
    sep = ';';
    if (!ends_with(compiler, ".exe") && !ends_with(compiler, ".EXE")) {
        k = snprintf(name[1], sizeof name[1], "%s.exe", compiler);
        if (k > 0 && k < (int)sizeof name[1]) npass = 2;
    }
#else
    sep = ':';
#endif
    env = getenv("PATH");
    if (!env) return -1;
    p = env;
    while (*p) {
        q = p;
        while (*q && *q != sep) q++;
        n = (int)(q - p);
        for (pass = 0; pass < npass; pass++) {
            if (n <= 0) k = snprintf(tryb, sizeof tryb, "./%s", name[pass]);
            else if (n < (int)sizeof tryb - 80) {
                { void *cx_kept = memcpy(tryb, p, (size_t)n); (void)cx_kept; }
                tryb[n] = 0;
                k = snprintf(tryb + n, sizeof tryb - (size_t)n, "/%s", name[pass]);
                if (k >= 0) k = n + k;
            } else k = -1;
#ifdef _WIN32
            if (k > 0 && k < (int)sizeof tryb && access(tryb, 0) == 0 &&
#else
            if (k > 0 && k < (int)sizeof tryb && access(tryb, X_OK) == 0 &&
#endif
                stat(tryb, &st) == 0 && S_ISREG(st.st_mode)) {
                k = snprintf(cxcc_cid, sizeof cxcc_cid, "%s\n%s\n%ld\n%ld",
                             compiler, tryb, (long)st.st_mtime, (long)st.st_size);
                if (k < 0 || k >= (int)sizeof cxcc_cid) { cxcc_cid_set = 0; return -1; }
                cxcc_cid_set = 1;
                return 0;
            }
        }
        if (*q == 0) break;
        p = q + 1;
    }
    return -1;
}

static int cxcc_copy_file(const char *from, const char *to) {
    FILE *in, *out;
    char buf[8192];
    char tmp[CXCC_PATH];
    size_t n;
    int k;
    k = snprintf(tmp, sizeof tmp, "%s.tmp", to);
    if (k < 0 || k >= (int)sizeof tmp) return -1;
    in = fopen(from, "rb");
    if (!in) return -1;
    out = fopen(tmp, "wb");
    if (!out) { fclose(in); return -1; }
    while ((n = fread(buf, 1, sizeof buf, in)) > 0) {
        if (fwrite(buf, 1, n, out) != n) {
            fclose(in); fclose(out); unlink(tmp); return -1;
        }
    }
    if (ferror(in)) { fclose(in); fclose(out); unlink(tmp); return -1; }
    fclose(in);
    if (fclose(out) != 0) { unlink(tmp); return -1; }
    if (rename(tmp, to) != 0) { unlink(tmp); return -1; }
    return 0;
}

static int cxcc_with_line(const char *path, const unsigned char *src, size_t sn,
                          unsigned char **out, size_t *out_n) {
    size_t plen, i, o, cap;
    unsigned char *b;
    plen = strlen(path);
    cap = sn + plen * 2 + 16;
    b = (unsigned char *)malloc(cap);
    if (!b) return -1;
    memcpy(b, "#line 1 \"", 9);
    o = 9;
    for (i = 0; i < plen; i++) {
        if (o + 2 >= cap) { free(b); return -1; }
        if (path[i] == '\\' || path[i] == '"') b[o++] = '\\';
        b[o++] = (unsigned char)path[i];
    }
    if (o + 2 + sn > cap) { free(b); return -1; }
    b[o++] = '"';
    b[o++] = '\n';
    if (sn) { void *cx_kept = memcpy(b + o, src, sn); (void)cx_kept; }
    *out = b;
    *out_n = o + sn;
    return 0;
}

static int cxcc_sibling(const char *obj, const char *suf, char *out, size_t cap) {
    size_t n = strlen(obj);
    size_t m = strlen(suf);
    if (n < 2 || obj[n - 2] != '.' || obj[n - 1] != 'o') return -1;
    if (n - 2 + m + 1 > cap) return -1;
    { void *cx_kept = memcpy(out, obj, n - 2); (void)cx_kept; }
    { void *cx_kept = memcpy(out + n - 2, suf, m + 1); (void)cx_kept; }
    return 0;
}

static int cxcc_write_atomic(const char *path, const void *p, size_t n) {
    char tmp[CXCC_PATH];
    FILE *f;
    int k;
    k = snprintf(tmp, sizeof tmp, "%s.tmp", path);
    if (k < 0 || k >= (int)sizeof tmp) return -1;
    f = fopen(tmp, "wb");
    if (!f) return -1;
    if (n && fwrite(p, 1, n, f) != n) { fclose(f); unlink(tmp); return -1; }
    if (fclose(f) != 0) { unlink(tmp); return -1; }
    if (rename(tmp, path) != 0) { unlink(tmp); return -1; }
    return 0;
}

/* gcc/clang -MMD: skip the target, keep every dependency except the temp source. */
static int cxcc_dep_list(const unsigned char *s, size_t n, const char *src, const char *obj,
                         char *list, size_t cap, size_t *outn) {
    size_t i = 0, o = 0;
    while (i < n) {
        if (s[i] == '\\' && i + 1 < n) { i += 2; continue; }
        if (s[i] == ':') { i++; break; }
        i++;
    }
    if (i >= n && (n == 0 || s[n - 1] != ':')) {
        /* colon may be the last byte */
    }
    if (n == 0) return -1;
    {
        size_t j, saw = 0;
        for (j = 0; j < n; j++) if (s[j] == ':') saw = 1;
        if (!saw) return -1;
    }
    while (i < n) {
        char tok[CXCC_PATH];
        size_t t = 0;
        unsigned char c;
        if (s[i] == '\\' && i + 1 < n && (s[i + 1] == '\n' || s[i + 1] == '\r')) {
            i += 2;
            continue;
        }
        if (s[i] <= 32) { i++; continue; }
        while (i < n && s[i] > 32) {
            c = s[i];
            if (c == '\\' && i + 1 < n && (s[i + 1] == '\n' || s[i + 1] == '\r')) break;
            if (c == '\\' && i + 1 < n) { i++; c = s[i]; }
            if (t + 1 >= sizeof tok) return -1;
            tok[t++] = (char)c;
            i++;
        }
        tok[t] = 0;
        if (t == 0) continue;
        if (src && !strcmp(tok, src)) continue;
        if (obj && !strcmp(tok, obj)) continue;
        if (o && o + 1 >= cap) return -1;
        if (o + t + 1 >= cap) return -1;
        if (o) list[o++] = '\n';
        { void *cx_kept = memcpy(list + o, tok, t); (void)cx_kept; }
        o += t;
    }
    *outn = o;
    return 0;
}

static int cxcc_stamp_list(const char *list, size_t n, unsigned char acc[32]) {
    size_t i = 0;
    memset(acc, 0, 32);
    while (i < n) {
        char path[CXCC_PATH];
        size_t e = i;
        while (e < n && list[e] != '\n') e++;
        if (e == i || e - i >= sizeof path) return -1;
        { void *cx_kept = memcpy(path, list + i, e - i); (void)cx_kept; }
        path[e - i] = 0;
        cxcc_fold_str(acc, path);
        if (cxcc_fold_file(acc, path)) return -1;
        i = e < n ? e + 1 : e;
    }
    return 0;
}

static int cxcc_deps_match(const char *obj) {
    char dep[CXCC_PATH], stamp_path[CXCC_PATH], got[65];
    unsigned char *list = 0, *st = 0;
    unsigned char acc[32];
    size_t ln = 0, sn = 0;
    if (cxcc_sibling(obj, ".d", dep, sizeof dep)) return 0;
    if (cxcc_sibling(obj, ".stamp", stamp_path, sizeof stamp_path)) return 0;
    if (read_cap(dep, &list, &ln) != 0) return 0;
    if (read_cap(stamp_path, &st, &sn) != 0) { free(list); return 0; }
    if (cxcc_stamp_list((char *)list, ln, acc) != 0 || sn < 64) {
        free(list);
        free(st);
        return 0;
    }
    cxcc_hex32(acc, got);
    if (memcmp(got, st, 64) != 0) { free(list); free(st); return 0; }
    free(list);
    free(st);
    return 1;
}

static int cxcc_deps_store(const char *obj, const char *depfile, const char *src) {
    char dest[CXCC_PATH], stamp_path[CXCC_PATH], hex[65];
    unsigned char *raw = 0;
    unsigned char acc[32];
    char *list;
    size_t rn = 0, ln = 0;
    int rr;
    list = (char *)malloc(CXCC_BYTES);
    if (!list) return -1;
    rr = read_cap(depfile, &raw, &rn);
    if (rr != 0) { free(list); return -1; }
    if (cxcc_dep_list(raw, rn, src, 0, list, CXCC_BYTES, &ln) != 0) {
        free(raw);
        free(list);
        return -1;
    }
    free(raw);
    if (cxcc_stamp_list(list, ln, acc) != 0) { free(list); return -1; }
    cxcc_hex32(acc, hex);
    if (cxcc_sibling(obj, ".d", dest, sizeof dest) ||
        cxcc_sibling(obj, ".stamp", stamp_path, sizeof stamp_path) ||
        cxcc_write_atomic(dest, list, ln) ||
        cxcc_write_atomic(stamp_path, hex, 64)) {
        free(list);
        return -1;
    }
    free(list);
    return 0;
}

/* 1: cached object exists and its header closure still matches.
   0: caller compiles, then may store `cached`.
   -1: cache unavailable. fields[0] is the plan index, fields[1] the source. */
static int cxcc_cache_open(const char *root, const char *compiler, const char *cxh,
                           char **cflags, int nc, char **fields, int nf,
                           const unsigned char *src, size_t sn,
                           char *cached, size_t cap) {
    unsigned char acc[32];
    char hex[65];
    char dir[CXCC_PATH];
    struct stat st;
    int i, k;
    cached[0] = 0;
    if (cxcc_compiler_tag(compiler) != 0) return -1;
    memset(acc, 0, sizeof acc);
    cxcc_fold_str(acc, cxcc_cid);
    cxcc_fold_str(acc, "-std=c99");
    cxcc_fold_str(acc, "-Werror=implicit-function-declaration");
    if (cxcc_fold_cflags(acc, cflags, nc)) return -1;
    if (cxcc_fold_file(acc, cxh)) return -1;
    k = snprintf(dir, sizeof dir, "%s/include/unisa_sha256.h", root);
    if (k < 0 || k >= (int)sizeof dir || cxcc_fold_file(acc, dir)) return -1;
    k = snprintf(dir, sizeof dir, "%s/include/unisa_safedel.h", root);
    if (k < 0 || k >= (int)sizeof dir || cxcc_fold_file(acc, dir)) return -1;
#ifdef _WIN32
    k = snprintf(dir, sizeof dir, "%s/tools/cxcc-hostinc/spawn.h", root);
    if (k < 0 || k >= (int)sizeof dir || cxcc_fold_file(acc, dir)) return -1;
    k = snprintf(dir, sizeof dir, "%s/tools/cxcc-hostinc/sys/wait.h", root);
    if (k < 0 || k >= (int)sizeof dir || cxcc_fold_file(acc, dir)) return -1;
    k = snprintf(dir, sizeof dir, "%s/tools/cxcc-hostinc/dirent.h", root);
    if (k < 0 || k >= (int)sizeof dir || cxcc_fold_file(acc, dir)) return -1;
#endif
    cxcc_fold(acc, src, sn);
    for (i = 2; i < nf; i++) {
        if (!fields[i][0] || !strcmp(fields[i], "cx.h")) continue;
        if (cxcc_fold_file(acc, fields[i])) return -1;
    }
    cxcc_hex32(acc, hex);
    k = snprintf(dir, sizeof dir, "%s/out", root);
    if (k < 0 || k >= (int)sizeof dir || cxcc_ensure_dir(dir)) return -1;
    k = snprintf(dir, sizeof dir, "%s/out/cxcc-cache", root);
    if (k < 0 || k >= (int)sizeof dir || cxcc_ensure_dir(dir)) return -1;
    k = snprintf(dir, sizeof dir, "%s/out/cxcc-cache/%s", root, compiler);
    if (k < 0 || k >= (int)sizeof dir || cxcc_ensure_dir(dir)) return -1;
    k = snprintf(cached, cap, "%s/%s.o", dir, hex);
    if (k < 0 || k >= (int)cap) { cached[0] = 0; return -1; }
    if (stat(cached, &st) == 0 && S_ISREG(st.st_mode) && st.st_size > 0 &&
        cxcc_deps_match(cached)) return 1;
    return 0;
}

/* Callbacks for src/cxmod.c. The plan text stays in this process. */
static char *cxcc_planbuf;
static size_t cxcc_plann, cxcc_plancap;
static int cxcc_planover;

/* Open without waiting for a FIFO writer, then fstat that same fd.
   stat followed by fopen can lose the race to a replacement.
   O_RDONLY is 0. O_NONBLOCK is 0x4 on Apple and 04000 on Linux.
   The export below stays free of #if so the module scan accepts it. */
#ifndef _WIN32
static int cxm_rd_os(char *path, char *buf, int cap) {
    int fd;
    int bad;
    int fl;
    struct stat st;
    size_t n;
    ssize_t z;
    if (!path || !buf || cap <= 0) return -3;
#ifdef __APPLE__
    fl = 0x4;
#else
    fl = 04000;
#endif
    fd = open(path, fl);
    if (fd < 0) return errno == ENOENT ? -1 : -3;
    if (fstat(fd, &st) != 0 || !S_ISREG(st.st_mode)) {
        close(fd);
        return -3;
    }
    n = 0;
    bad = 0;
    while (n < (size_t)cap) {
        z = read(fd, buf + n, (size_t)cap - n);
        if (z < 0 && errno == EINTR) continue;
        if (z < 0) { bad = 1; break; }
        if (z == 0) break;
        n += (size_t)z;
    }
    if (close(fd) != 0) bad = 1;
    if (bad) return -3;
    if (n >= (size_t)cap) return -2;
    buf[n] = 0;
    return (int)n;
}
#else
static int cxm_rd_os(char *path, char *buf, int cap) {
    FILE *f;
    int bad;
    size_t n;
    if (!path || !buf || cap < 0) return -3;
    f = fopen(path, "rb");
    if (!f) return errno == ENOENT ? -1 : -3;
    n = fread(buf, 1, (size_t)cap, f);
    bad = ferror(f);
    if (fclose(f)) bad = 1;
    if (bad) return -3;
    if (n >= (size_t)cap) return -2;
    if (n < (size_t)cap) buf[n] = 0;
    return (int)n;
}
#endif

int cxm_rd(char *path, char *buf, int cap) {
    return cxm_rd_os(path, buf, cap);
}

int cxm_wr(char *path, char *buf, int n) {
    FILE *f;
    if (!path || n < 0) return 1;
    f = fopen(path, "wb");
    if (!f) return 1;
    if (n > 0 && fwrite(buf, 1, (size_t)n, f) != (size_t)n) { fclose(f); return 1; }
    if (fclose(f) != 0) return 1;
    return 0;
}

int cxm_say(int fd, char *s, int n) {
    size_t k;
    if (n < 0) return 1;
    k = (size_t)n;
    if (fd == 2) {
        if (k > 0 && fwrite(s, 1, k, stderr) != k) return 1;
        return 0;
    }
    if (!cxcc_planbuf || cxcc_plann + k + 1 > cxcc_plancap) {
        cxcc_planover = 1;
        return 1;
    }
    if (k) { void *cx_kept = memcpy(cxcc_planbuf + cxcc_plann, s, k); (void)cx_kept; }
    cxcc_plann += k;
    cxcc_planbuf[cxcc_plann] = 0;
    return 0;
}

int cxm_plan(char **paths, int n);
int cxm_planprint(char **opt, int nopt);

/* Windows adds -I <repo>/tools/cxcc-hostinc before -include cx.h.
   -I, not -idirafter: <spawn.h> and <sys/wait.h> must not resolve to the
   product headers beside include/cx.h. hostinc must stay alive until the
   compiler process returns. */
static int cxcc_push_prelude(char **av, int n, int cap, char *hostinc, size_t hostcap,
                             const char *root, const char *cxh) {
#ifdef _WIN32
    int k;
    if (n + 4 >= cap) return -1;
    k = snprintf(hostinc, hostcap, "%s/tools/cxcc-hostinc", root);
    if (k < 0 || k >= (int)hostcap) return -1;
    av[n++] = "-I";
    av[n++] = hostinc;
#else
    (void)hostinc;
    (void)hostcap;
    (void)root;
    if (n + 2 >= cap) return -1;
#endif
    av[n++] = "-include";
    av[n++] = (char *)cxh;
    return n;
}

static int cxcc_expand(int argc, char **argv, const char *compiler, const char *cmd,
                       const char *root, const char *cxh, int *src_at, int nsrc) {
    char *paths[CXCC_SRCS];
    char *cflags[CXCC_PLANARGS];
    char *lflags[CXCC_PLANARGS];
    char srcs[CXCC_UNITS][CXCC_TMP];
    char objs[CXCC_UNITS][CXCC_TMP];
    char hostinc[CXCC_PATH];
    char *plan = 0;
    char *out_path = 0;
    size_t plan_n = 0;
    int nc = 0, nl = 0, want_c = 0, nunit = 0, i, rc, kn;
    for (i = 1; i < argc; i++) {
        int is_src = 0, si, need = 0;
        for (si = 0; si < nsrc; si++) if (src_at[si] == i) is_src = 1;
        if (is_src) continue;
        if (!strcmp(argv[i], "-c")) { want_c = 1; continue; }
        if (!strcmp(argv[i], "-pthread") || !strcmp(argv[i], "-fopenmp")) {
            if (nc + 1 >= CXCC_PLANARGS || nl + 1 >= CXCC_PLANARGS) {
                cxcc_too_many(cmd);
                return 2;
            }
            cflags[nc++] = argv[i];
            lflags[nl++] = argv[i];
            continue;
        }
        if (cxcc_linkish(argv[i], &need) || argv[i][0] != '-') {
            if (nl + 1 + need >= CXCC_PLANARGS || i + need >= argc) {
                cxcc_too_many(cmd);
                return 2;
            }
            lflags[nl++] = argv[i];
            if (need) {
                if (!strcmp(argv[i], "-o")) out_path = argv[i + 1];
                lflags[nl++] = argv[++i];
            }
            continue;
        }
        if (nc + 1 >= CXCC_PLANARGS) {
            cxcc_too_many(cmd);
            return 2;
        }
        cflags[nc++] = argv[i];
        if (takes_arg(argv[i])) {
            if (i + 1 >= argc || nc + 1 >= CXCC_PLANARGS) {
                cxcc_too_many(cmd);
                return 2;
            }
            cflags[nc++] = argv[++i];
        }
    }
    plan = (char *)malloc(1 << 20);
    if (!plan) {
        fprintf(stderr, "%s: out of memory\n", cmd);
        return 2;
    }
    if (nsrc > CXCC_SRCS) {
        free(plan);
        fprintf(stderr, "%s: too many .cx inputs\n", cmd);
        return 2;
    }
    for (i = 0; i < nsrc; i++) paths[i] = argv[src_at[i]];
    cxcc_planbuf = plan;
    cxcc_plann = 0;
    cxcc_plancap = 1 << 20;
    cxcc_planover = 0;
    plan[0] = 0;
    rc = cxm_plan(paths, nsrc);
    if (rc == 0) cxm_planprint(0, 0);
    plan_n = cxcc_plann;
    cxcc_planbuf = 0;
    if (rc != 0) {
        free(plan);
        return 1;
    }
    if (cxcc_planover) {
        free(plan);
        fprintf(stderr, "%s: module plan is too long\n", cmd);
        return 2;
    }
    if (plan_n == 0) {
        fprintf(stderr, "%s: empty module plan\n", cmd);
        free(plan);
        return 2;
    }
    cxcc_blank_paths(srcs, CXCC_UNITS);
    cxcc_blank_paths(objs, CXCC_UNITS);
    {
        char *p = plan;
        char *end = plan + plan_n;
        while (p < end) {
            char *line = p;
            char *fields[80];
            char *av[CXCC_PLANARGS];
            unsigned char *buf = 0;
            size_t bn = 0;
            int nf, rr, n, k;
            while (p < end && *p != '\n') p++;
            if (p < end) { *p = 0; p++; }
            if (!line[0]) continue;
            if (nunit >= CXCC_UNITS) {
                fprintf(stderr, "%s: too many module units\n", cmd);
                cxcc_unlink_paths(srcs, nunit);
                cxcc_unlink_paths(objs, nunit);
                free(plan);
                return 2;
            }
            nf = cxcc_fields(line, fields, 80);
            if (nf < 2) {
                fprintf(stderr, "%s: module plan line is not a unit\n", cmd);
                cxcc_unlink_paths(srcs, nunit);
                cxcc_unlink_paths(objs, nunit);
                free(plan);
                return 2;
            }
            rr = read_cap(fields[1], &buf, &bn);
            if (rr != 0) {
                fprintf(stderr, "%s: cannot read %s\n", cmd, fields[1]);
                cxcc_unlink_paths(srcs, nunit);
                cxcc_unlink_paths(objs, nunit);
                free(plan);
                return 2;
            }
            blank_shebang(buf, bn);
            {
                unsigned char *lined = 0;
                size_t ln = 0;
                char cached[CXCC_PATH];
                char dep[CXCC_TMP];
                int cache;
                if (cxcc_with_line(fields[1], buf, bn, &lined, &ln)) {
                    fprintf(stderr, "%s: out of memory\n", cmd);
                    free(buf);
                    cxcc_unlink_paths(srcs, nunit);
                    cxcc_unlink_paths(objs, nunit);
                    free(plan);
                    return 2;
                }
                free(buf);
                buf = lined;
                bn = ln;
                cache = cxcc_cache_open(root, compiler, cxh, cflags, nc, fields, nf,
                                        buf, bn, cached, sizeof cached);
                int reuse = 0;
                if (write_temp(buf, bn, srcs[nunit], CXCC_TMP)) {
                    fprintf(stderr, "%s: cannot write a temporary copy of %s\n", cmd, fields[1]);
                    free(buf);
                    cxcc_unlink_paths(srcs, nunit);
                    cxcc_unlink_paths(objs, nunit);
                    free(plan);
                    return 2;
                }
                free(buf);
                kn = snprintf(objs[nunit], CXCC_TMP, "%s.o", srcs[nunit]);
                if (kn < 0 || kn >= CXCC_TMP) {
                    fprintf(stderr, "%s: temporary path too long\n", cmd);
                    cxcc_unlink_paths(srcs, nunit + 1);
                    cxcc_unlink_paths(objs, nunit);
                    free(plan);
                    return 2;
                }
                if (cache == 1 && cxcc_copy_file(cached, objs[nunit]) == 0) reuse = 1;
                if (!reuse) {
                    n = 0;
                    av[n++] = (char *)compiler;
                    av[n++] = "-std=c99";
                    av[n++] = "-Werror=implicit-function-declaration";
                    n = cxcc_push_prelude(av, n, CXCC_PLANARGS, hostinc, sizeof hostinc, root, cxh);
                    if (n < 0) {
                        fprintf(stderr, "%s: prelude path too long\n", cmd);
                        cxcc_unlink_paths(srcs, nunit + 1);
                        cxcc_unlink_paths(objs, nunit + 1);
                        free(plan);
                        return 2;
                    }
                    for (k = 0; k < nc; k++) {
                        if (n + 8 >= CXCC_PLANARGS) {
                            cxcc_too_many(cmd);
                            cxcc_unlink_paths(srcs, nunit + 1);
                            cxcc_unlink_paths(objs, nunit + 1);
                            free(plan);
                            return 2;
                        }
                        av[n++] = cflags[k];
                    }
                    for (k = 2; k < nf; k++) {
                        if (!fields[k][0] || !strcmp(fields[k], "cx.h")) continue;
                        if (n + 8 >= CXCC_PLANARGS) {
                            cxcc_too_many(cmd);
                            cxcc_unlink_paths(srcs, nunit + 1);
                            cxcc_unlink_paths(objs, nunit + 1);
                            free(plan);
                            return 2;
                        }
                        av[n++] = "-include";
                        av[n++] = fields[k];
                    }
                    if (n + 12 >= CXCC_PLANARGS) {
                        cxcc_too_many(cmd);
                        cxcc_unlink_paths(srcs, nunit + 1);
                        cxcc_unlink_paths(objs, nunit + 1);
                        free(plan);
                        return 2;
                    }
                    kn = snprintf(dep, sizeof dep, "%s.d", srcs[nunit]);
                    if (kn < 0 || kn >= (int)sizeof dep) {
                        fprintf(stderr, "%s: temporary path too long\n", cmd);
                        cxcc_unlink_paths(srcs, nunit + 1);
                        cxcc_unlink_paths(objs, nunit + 1);
                        free(plan);
                        return 2;
                    }
                    av[n++] = "-MMD";
                    av[n++] = "-MF";
                    av[n++] = dep;
                    av[n++] = "-c";
                    av[n++] = "-x";
                    av[n++] = "c";
                    av[n++] = srcs[nunit];
                    av[n++] = "-o";
                    av[n++] = objs[nunit];
                    av[n] = 0;
                    rc = cxcc_exec(cmd, compiler, av);
                    if (rc != 0) {
                        fprintf(stderr, "%s: compile failed: %s\n", cmd, fields[1]);
                        unlink(dep);
                        cxcc_unlink_paths(srcs, nunit + 1);
                        cxcc_unlink_paths(objs, nunit + 1);
                        free(plan);
                        return rc;
                    }
                    if (cache == 0 && cached[0] &&
                        cxcc_deps_store(cached, dep, srcs[nunit]) == 0)
                        cxcc_copy_file(objs[nunit], cached);
                    unlink(dep);
                }
            }
            nunit++;
        }
    }
    free(plan);
    if (nunit == 0) {
        fprintf(stderr, "%s: empty module plan\n", cmd);
        return 2;
    }
    if (want_c) {
        if (nunit != 1 || !out_path) {
            fprintf(stderr, "%s: -c of a module program needs -o and one translation unit\n", cmd);
            cxcc_unlink_paths(srcs, nunit);
            cxcc_unlink_paths(objs, nunit);
            return 2;
        }
        if (rename(objs[0], out_path) != 0) {
            fprintf(stderr, "%s: cannot write %s\n", cmd, out_path);
            cxcc_unlink_paths(srcs, nunit);
            cxcc_unlink_paths(objs, nunit);
            return 2;
        }
        objs[0][0] = 0;
        cxcc_unlink_paths(srcs, nunit);
        return 0;
    }
    {
        char *av[CXCC_PLANARGS];
        int n = 0, u;
        if (nl + nunit + 2 >= CXCC_PLANARGS) {
            cxcc_too_many(cmd);
            cxcc_unlink_paths(srcs, nunit);
            cxcc_unlink_paths(objs, nunit);
            return 2;
        }
        av[n++] = (char *)compiler;
        for (u = 0; u < nl; u++) av[n++] = lflags[u];
        for (u = 0; u < nunit; u++) av[n++] = objs[u];
        av[n] = 0;
        rc = cxcc_exec(cmd, compiler, av);
    }
    cxcc_unlink_paths(srcs, nunit);
    cxcc_unlink_paths(objs, nunit);
    return rc;
}

static void usage(const char *cmd, const char *compiler) {
    fprintf(stderr, "%s: usage: %s FILE.cx [-o OUT] [extra %s arguments]\n", cmd, cmd, compiler);
    fprintf(stderr, "%s:        %s -run [compiler options] FILE.cx [compiler options] -- [program args]\n", cmd, cmd);
}

static int cxcc_later_input(int argc, char **argv, int from) {
    int j, skip;
    skip = 0;
    for (j = from + 1; j < argc; j++) {
        if (skip) { skip = 0; continue; }
        if (argv[j][0] == '-' && takes_arg(argv[j])) { skip = 1; continue; }
        if (argv[j][0] != '-') return 1;
    }
    return 0;
}

static int cxcc_drive_os(int argc, char **argv, const char *compiler, const char *cmd);

/* Helpers here keep the new -run path from adding libc call sites (tests/cxlibc). */
static int cxcc_samez(const char *a, const char *b) {
    while (*a && *a == *b) { a++; b++; }
    return *a == *b;
}
static int cxcc_startz(const char *a, const char *p) {
    while (*p) { if (*a++ != *p++) return 0; }
    return 1;
}
static void cxcc_say(const char *cmd, const char *m, const char *x) {
    fprintf(stderr, "%s: %s%s\n", cmd, m, x ? x : "");
}
static void cxcc_too_many(const char *cmd) { fprintf(stderr, "%s: too many arguments\n", cmd); }
static int cxcc_cat(char *dst, size_t cap, const char *a, const char *b, const char *c) {
    const char *part[3];
    size_t o = 0;
    int i;
    part[0] = a; part[1] = b; part[2] = c;
    for (i = 0; i < 3; i++) {
        const char *q = part[i];
        if (!q) continue;
        while (*q) { if (o + 1 >= cap) return -1; dst[o++] = *q++; }
    }
    dst[o] = 0;
    return 0;
}

static int cxcc_is_output_override(const char *a) {
    if (cxcc_samez(a, "-o")) return 1;
    if (a[0] == '-' && a[1] == 'o' && a[2]) return 1;          /* -oFILE */
    return 0;
}

static int cxcc_run_paths(char *dir, size_t dcap, char *exe, size_t ecap) {
    (void)dir; (void)dcap; (void)exe; (void)ecap;
#ifdef _WIN32
    /* No verified private temporary directory: the current shim ignores the
       mode and EEXIST would need an exclusive-create contract. -run refuses
       on Windows instead of reusing a directory it does not own. */
    return -1;
#else
    char tmpl[] = "/tmp/cxcc-runXXXXXX";
    if (!mkdtemp(tmpl)) return -1;
    if (copy_str(dir, dcap, tmpl)) { remove(tmpl); return -1; }
    return cxcc_cat(exe, ecap, dir, "/prog", "");
#endif
}

static void cxcc_run_cleanup(const char *cmd, const char *dir, const char *exe) {
    int bad = 0;
    if (exe[0]) remove(exe);           /* ENOENT is expected when compile failed early */
    if (remove(dir)) bad = 1;
    if (bad) cxcc_say(cmd, "-run cleanup could not remove ", dir);
}

static int cxcc_run_main(int argc, char **argv, int run_at, int dd, const char *compiler, const char *cmd) {
    char dir[CXCC_PATH], exe[CXCC_PATH];
    char *cargv[CXCC_ARGS];
    char *pargv[CXCC_ARGS];
    int cargc = 0, pargc = 0, nsrc = 0, nruns = 0, skip = 0, i, rc, kind = 0, code = 0, spr;
    int stop = dd >= 0 ? dd : argc;
    extern int cxproc_run_raw(char **argv, char **envp, int *kind, int *code);
    dir[0] = 0; exe[0] = 0;
    for (i = 1; i < stop; i++) {
        /* @ and -Wl/-Xlinker are refused anywhere before --, even when they
           would be the value of another option: gcc/clang expand @ before
           option parsing, so skipping them by parser state would still let
           them reach the host. */
        if (argv[i][0] == '@') {
            cxcc_say(cmd, "-run does not take response files before --: ", argv[i]);
            return 2;
        }
        if (cxcc_startz(argv[i], "-Wl") || cxcc_samez(argv[i], "-Xlinker")) {
            cxcc_say(cmd, "-run does not take linker options before --: ", argv[i]);
            return 2;
        }
        if (skip) { skip = 0; continue; }
        if (cxcc_is_output_override(argv[i])) {
            cxcc_say(cmd, "-run cannot be combined with an output override: ", argv[i]);
            return 2;
        }
        if (takes_arg(argv[i])) { skip = 1; continue; }
        if (cxcc_samez(argv[i], "-c") || cxcc_samez(argv[i], "-E") ||
            cxcc_samez(argv[i], "-S") || cxcc_samez(argv[i], "-shared")) {
            cxcc_say(cmd, "-run cannot be combined with ", argv[i]);
            return 2;
        }
        if (cxcc_samez(argv[i], "-run")) { nruns++; continue; }
        if (argv[i][0] != '-' && ends_with(argv[i], ".cx")) nsrc++;
    }
    if (nruns != 1) {
        cxcc_say(cmd, "-run may appear once before --", 0);
        return 2;
    }
    if (nsrc != 1) {
        cxcc_say(cmd, "-run takes exactly one .cx main file (found more than one or none)", 0);
        return 2;
    }
    if (cxcc_run_paths(dir, sizeof dir, exe, sizeof exe)) {
        cxcc_say(cmd, "-run failed to start: cannot create a temporary directory", 0);
        return 2;
    }
    cargv[cargc++] = argv[0];
    for (i = 1; i < stop; i++) {
        if (i == run_at) continue;
        if (cargc + 3 >= CXCC_ARGS) {
            cxcc_say(cmd, "-run has too many arguments", 0);
            cxcc_run_cleanup(cmd, dir, "");
            return 2;
        }
        cargv[cargc++] = argv[i];
    }
    cargv[cargc++] = "-o";
    cargv[cargc++] = exe;
    cargv[cargc] = 0;
    rc = cxcc_drive_os(cargc, cargv, compiler, cmd);
    if (rc != 0) { cxcc_run_cleanup(cmd, dir, exe); return rc; }
    if (access(exe, 0) != 0) {
        cxcc_say(cmd, "-run failed to start: no executable was produced", 0);
        cxcc_run_cleanup(cmd, dir, exe);
        return 2;
    }
    pargv[pargc++] = exe;
    if (dd >= 0) {
        for (i = dd + 1; i < argc; i++) {
            if (pargc + 1 >= CXCC_ARGS) {
                cxcc_say(cmd, "-run has too many program arguments", 0);
                cxcc_run_cleanup(cmd, dir, exe);
                return 2;
            }
            pargv[pargc++] = argv[i];
        }
    }
    pargv[pargc] = 0;
    spr = cxproc_run_raw(pargv, environ, &kind, &code);
    if (spr != 0) {
        cxcc_say(cmd, "-run failed to start", 0);
        cxcc_run_cleanup(cmd, dir, exe);
        return 2;
    }
    if (kind == 1) {
        fprintf(stderr, "%s: program killed by signal %d\n", cmd, code);
        rc = 128 + code;
    } else if (kind == 0) rc = code;
    else {
        cxcc_say(cmd, "-run failed to start: the program ended without an exit status", 0);
        rc = 2;
    }
    cxcc_run_cleanup(cmd, dir, exe);
    return rc;
}

static int cxcc_drive_os(int argc, char **argv, const char *compiler, const char *cmd) {
    char root[CXCC_PATH];
    char cxh[CXCC_PATH];
    char hostinc[CXCC_PATH];
    char temps[CXCC_SRCS][260];
    char *av[CXCC_ARGS];
    int src_at[CXCC_SRCS];
    int nsrc = 0;
    int i, n, rc, skip, repo;
    {
        int run_at = -1, dd = -1, q, skip = 0;
        for (q = 1; q < argc; q++) {
            if (!skip && cxcc_samez(argv[q], "--")) { dd = q; break; }
            if (!skip && cxcc_samez(argv[q], "-run") && run_at < 0) run_at = q;
            if (!skip && takes_arg(argv[q])) skip = 1;
            else skip = 0;
        }
        if (run_at >= 0) return cxcc_run_main(argc, argv, run_at, dd, compiler, cmd);
    }
    repo = find_repo(argc > 0 ? argv[0] : 0, root, sizeof root);
    if (repo == -2) {
        fprintf(stderr, "%s: CX_ROOT has no include/cx.h\n", cmd);
        return 2;
    }
    if (repo != 0) {
        fprintf(stderr, "%s: cannot find include/cx.h (set CX_ROOT to the repository)\n", cmd);
        return 2;
    }
    if (snprintf(cxh, sizeof cxh, "%s/include/cx.h", root) >= (int)sizeof cxh) {
        fprintf(stderr, "%s: prelude path too long\n", cmd);
        return 2;
    }
    skip = 0;
    for (i = 1; i < argc; i++) {
        if (skip) { skip = 0; continue; }
        if (argv[i][0] == '-' && takes_arg(argv[i])) { skip = 1; continue; }
        if (argv[i][0] != '-' && ends_with(argv[i], ".cx")) {
            if (nsrc >= CXCC_SRCS) {
                fprintf(stderr, "%s: too many .cx inputs\n", cmd);
                return 2;
            }
            src_at[nsrc++] = i;
        }
    }
    if (nsrc == 0) { usage(cmd, compiler); return 2; }
    {
        int any_use = 0;
        for (i = 0; i < nsrc; i++) {
            unsigned char *buf = 0;
            size_t bn = 0;
            int rr = read_cap(argv[src_at[i]], &buf, &bn);
            if (rr == 2) {
                fprintf(stderr, "%s: %s is too long\n", cmd, argv[src_at[i]]);
                return 2;
            }
            if (rr != 0) {
                fprintf(stderr, "%s: cannot read %s\n", cmd, argv[src_at[i]]);
                return 2;
            }
            if (has_unisa(buf, bn)) any_use = 1;
            free(buf);
        }
        if (any_use) return cxcc_expand(argc, argv, compiler, cmd, root, cxh, src_at, nsrc);
    }
    for (i = 0; i < nsrc; i++) {
        unsigned char *buf = 0;
        size_t bn = 0;
        int rr = read_cap(argv[src_at[i]], &buf, &bn);
        if (rr == 2) {
            fprintf(stderr, "%s: %s is too long\n", cmd, argv[src_at[i]]);
            return 2;
        }
        if (rr != 0) {
            fprintf(stderr, "%s: cannot read %s\n", cmd, argv[src_at[i]]);
            return 2;
        }
        if (has_unisa(buf, bn)) {
            fprintf(stderr, "%s: %s uses a module import; this driver does not expand it\n",
                    cmd, argv[src_at[i]]);
            free(buf);
            for (n = 0; n < i; n++) unlink(temps[n]);
            return 2;
        }
        blank_shebang(buf, bn);
        {
            unsigned char *lined = 0;
            size_t ln = 0;
            if (cxcc_with_line(argv[src_at[i]], buf, bn, &lined, &ln)) {
                fprintf(stderr, "%s: out of memory\n", cmd);
                free(buf);
                for (n = 0; n < i; n++) unlink(temps[n]);
                return 2;
            }
            free(buf);
            buf = lined;
            bn = ln;
        }
        if (write_temp(buf, bn, temps[i], sizeof temps[i])) {
            fprintf(stderr, "%s: cannot write a temporary copy of %s\n", cmd, argv[src_at[i]]);
            free(buf);
            for (n = 0; n < i; n++) unlink(temps[n]);
            return 2;
        }
        free(buf);
    }
    n = 0;
    av[n++] = (char *)compiler;
    av[n++] = "-std=c99";
    av[n++] = "-Werror=implicit-function-declaration";
    n = cxcc_push_prelude(av, n, CXCC_ARGS, hostinc, sizeof hostinc, root, cxh);
    if (n < 0) {
        fprintf(stderr, "%s: prelude path too long\n", cmd);
        for (i = 0; i < nsrc; i++) unlink(temps[i]);
        return 2;
    }
    skip = 0;
    for (i = 1; i < argc; i++) {
        int si;
        int is_src = 0;
        if (n + 6 >= CXCC_ARGS) {
            cxcc_too_many(cmd);
            for (si = 0; si < nsrc; si++) unlink(temps[si]);
            return 2;
        }
        if (!skip) {
            for (si = 0; si < nsrc; si++) if (src_at[si] == i) is_src = 1;
        }
        if (is_src) {
            int which = -1;
            for (si = 0; si < nsrc; si++) if (src_at[si] == i) which = si;
            if (which < 0) {
                fprintf(stderr, "%s: internal source list\n", cmd);
                for (si = 0; si < nsrc; si++) unlink(temps[si]);
                return 2;
            }
            av[n++] = "-x";
            av[n++] = "c";
            av[n++] = temps[which];
            if (cxcc_later_input(argc, argv, i)) {
                av[n++] = "-x";
                av[n++] = "none";
            }
        } else {
            av[n++] = argv[i];
            if (skip) skip = 0;
            else if (argv[i][0] == '-' && takes_arg(argv[i])) skip = 1;
        }
    }
    av[n] = 0;
    rc = cxcc_exec(cmd, compiler, av);
    for (i = 0; i < nsrc; i++) unlink(temps[i]);
    return rc;
}

int cxcc_drive(int argc, char **argv, const char *compiler, const char *cmd) {
    return cxcc_drive_os(argc, argv, compiler, cmd);
}
