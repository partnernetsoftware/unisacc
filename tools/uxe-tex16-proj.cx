/* tools/uxe-tex16-proj.cx -- 正视 XY 平面 16 texel 中心.
 * 相机 (0,0,d) 看原点;平面 z=0 面向 +Z;图像约定行 0 在上.
 * sh ./unisacc.com tools/uxe-tex16-proj.cx -- --write
 */
static int rgba[16][3] = {
    {255,0,0},{0,255,0},{0,0,255},{255,255,0},
    {255,0,255},{0,255,255},{128,0,0},{0,128,0},
    {0,0,128},{128,128,0},{128,0,128},{0,128,128},
    {64,64,64},{192,192,192},{255,128,0},{0,255,128}
};
int main(int argc, char **argv) {
    int write = 0, i, j, n;
    double s = 8.0, d = 8.0, fovy = 1.0, W = 128.0, H = 128.0;
    double half = 0.5463024898437905;
    FILE *f = 0;
    for (i = 1; i < argc; i++) if (argv[i][0] == '-' && argv[i][2] == 'w') write = 1;
    if (write) {
        f = fopen("ujs/practice/uxe/test/tex16-probes.tsv", "wb");
        if (!f) return 2;
        fprintf(f, "i\tj\tpx\tpy\tr\tg\tb\n");
    }
    n = 0;
    for (j = 0; j < 4; j++) {
        for (i = 0; i < 4; i++) {
            double x = -s / 2.0 + ((double)i + 0.5) * s / 4.0;
            double y = s / 2.0 - ((double)j + 0.5) * s / 4.0;
            double x_ndc = (x / d) / half;
            double y_ndc = (y / d) / half;
            int px = (int)((x_ndc * 0.5 + 0.5) * W);
            int py = (int)((1.0 - (y_ndc * 0.5 + 0.5)) * H);
            int k = j * 4 + i;
            printf("PROBE\t%d\t%d\t%d\t%d\t%d\t%d\t%d\n", i, j, px, py, rgba[k][0], rgba[k][1], rgba[k][2]);
            if (f) fprintf(f, "%d\t%d\t%d\t%d\t%d\t%d\t%d\n", i, j, px, py, rgba[k][0], rgba[k][1], rgba[k][2]);
            n++;
        }
    }
    if (f) fclose(f);
    printf("TEX16_PROJ\tn=%d\twrite=%d\n", n, write);
    return 0;
}
