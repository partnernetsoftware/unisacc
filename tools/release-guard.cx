/* tools/release-guard.cx -- C4p2: refuse short sha --target/commit= and tag-delete lines.
 *   sh ./unisacc.com tools/release-guard.cx -- FILE
 */
#pragma unisa use cxlib.relsha
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.sig
#pragma unisa use text.text
#pragma unisa use mem.heap

static void die(const char *w) {
    sy_eprintf("release-guard: REFUSE %s\n", w);
    sy_exit(2);
}
static int take_sha(const char *s, long n, long at, char *out) {
    long i;
    if (at + 40 > n) return 1;
    for (i = 0; i < 40; i++) out[i] = s[at + i];
    out[40] = 0;
    if (at + 40 < n) {
        char c = s[at + 40];
        if (c != 0 && c != 10 && c != 13 && c != 32 && c != 9) return 1;
    }
    return rs_sha40(out);
}
static int line_ok(const char *s, long n) {
    long p;
    char sha[41];
    if (rs_is_tag_delete(s)) return 1;
    p = tx_find(s, n, "--target ", 9);
    if (p >= 0 && take_sha(s, n, p + 9, sha)) return 1;
    p = tx_find(s, n, "commit=", 7);
    if (p >= 0 && take_sha(s, n, p + 7, sha)) return 1;
    return 0;
}
int main(int argc, char **argv) {
    char *buf;
    size_t n;
    long i, off, ln;
    if (argc < 2 || !argv[1] || !argv[1][0]) die("missing file");
    buf = (char *)cx_read(argv[1], &n);
    if (!buf) die("read");
    i = 0;
    while (i < (long)n) {
        off = i;
        while (i < (long)n && buf[i] != 10) i++;
        ln = i - off;
        if (i < (long)n && buf[i] == 10) i++;
        if (ln == 0) continue;
        {
            char z;
            z = buf[off + ln];
            buf[off + ln] = 0;
            if (line_ok(buf + off, ln)) { buf[off + ln] = z; mm_free(buf); die("cmd"); }
            buf[off + ln] = z;
        }
    }
    mm_free(buf);
    return 0;
}
