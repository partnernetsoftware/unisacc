/* tools/check-root-identity.cx -- plans/root-identity.md agrees with the installed product.
 *
 *   sh ./unisacc.com tools/check-root-identity.cx -- ROOT [--emit]
 *
 * The document used to carry three sha256 lines typed by hand, which nothing could check. It now
 * carries a block the machine reads and writes:
 *
 *   <!-- identity-begin -->
 *   product_kind<TAB>split1
 *   product_digest<TAB><hex>
 *   <member><TAB><sha256><TAB><bytes>
 *   ...
 *   <!-- identity-end -->
 *
 * That block carries facts only; the judgement prose stays outside it, because prose cannot be
 * compared line by line. This check is registered as a batch, so "the document can be disproved"
 * is a claim the suite actually runs -- a design intent that no batch executes is not a check.
 *
 *   default   compare the block with ROOT and print PASS/FAIL per line, marker ROOT_IDENTITY
 *   --emit    rewrite the block body from ROOT (nothing outside the markers is touched)
 *
 * Prints ROOT_IDENTITY<TAB>assertions=N<TAB>failed=M; exit 0 only when nothing failed. */
#pragma unisa use cxlib.productpkg
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

#define RI_MAX 16

static char root[4400], doc[4400];
static int assertions, failed, not_run;
static char ri_helper[4400], ri_sources[4400];

static void ok(int cond, const char *name) {
    assertions++;
    if (!cond) failed++;
    printf("%s\t%s\n", cond ? "PASS" : "FAIL", name);
}

static void die(const char *what) {
    fprintf(stderr, "check-root-identity: %s\n", what);
    exit(2);
}

/* offsets of the last occurrence of MARKER in S[0..N); -1 when absent */
static long find_marker(const char *s, long n, const char *marker) {
    long ml = tx_len(marker, 200), at = -1, i;
    for (i = 0; i + ml <= n; i++)
        if (!memcmp(s + i, marker, (size_t)ml)) at = i;
    return at;
}

/* The block body (facts only) for ROOT into OUT; 0, or -1. */
static int body(char *out, long cap, long *outn) {
    char names[RI_MAX][64], shas[RI_MAX][65];
    long bytes[RI_MAX];
    char line[256];
    int n, i, k;
    long at = 0;
    n = pp_member_list(root, names, shas, bytes, RI_MAX);
    if (n < 1) return -1;
    if (cx_fmt(line, sizeof line, "product_kind\t%s\n", pp_identity_kind(root))) return -1;
    k = tx_len(line, sizeof line);
    if (at + k >= cap) return -1;
    mm_copy(out + at, (size_t)k, line, (size_t)k); at += k;
    {   char dg[65];
        if (pp_product_digest(root, dg)) return -1;
        if (cx_fmt(line, sizeof line, "product_digest\t%s\n", dg)) return -1;
        k = tx_len(line, sizeof line);
        if (at + k >= cap) return -1;
        mm_copy(out + at, (size_t)k, line, (size_t)k); at += k;
    }
    for (i = 0; i < n; i++) {
        if (cx_fmt(line, sizeof line, "%s\t%s\t%ld\n", names[i], shas[i], bytes[i])) return -1;
        k = tx_len(line, sizeof line);
        if (at + k >= cap) return -1;
        mm_copy(out + at, (size_t)k, line, (size_t)k); at += k;
    }
    out[at] = 0;
    if (outn) *outn = at;
    return 0;
}

int main(int argc, char **argv) {
    char *bytes, want[4096];
    size_t sz = 0;
    long bn = 0, wn = 0;
    const char *begin = "<!-- identity-begin -->";
    const char *endmk = "<!-- identity-end -->";
    long bl, el;
    int emit = 0, i;
    for (i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--emit")) emit = 1;
        else if (i + 1 < argc && argv[i + 1][0] == '/' && tx_eqz(argv[i], "--identity-helper")) { if (tx_copy(ri_helper, sizeof ri_helper, argv[i + 1], tx_len(argv[i + 1], sizeof ri_helper))) die("helper"); i++; }
        else if (i + 1 < argc && argv[i + 1][0] == '/' && tx_eqz(argv[i], "--sources")) { if (tx_copy(ri_sources, sizeof ri_sources, argv[i + 1], tx_len(argv[i + 1], sizeof ri_sources))) die("sources"); i++; }
    }
    for (i = 1; i < argc && argv[i][0] != '/'; i++) ;
    if (i < argc && argv[i][0] == '/') { if (tx_copy(root, sizeof root, argv[i], tx_len(argv[i], sizeof root))) die("root"); }
    else if (sy_cwd(root, sizeof root) < 0) die("cwd");
    if (cx_fmt(doc, sizeof doc, "%s/plans/root-identity.md", root)) die("doc path");
    if (body(want, (long)sizeof want - 1, &wn)) die("no product identity");
    if (emit) {
        bytes = cx_read(doc, &sz);
        bn = (long)sz;
        if (!bytes) die("doc read");
        bl = find_marker(bytes, bn, begin);
        el = find_marker(bytes, bn, endmk);
        if (bl < 0 || el < 0 || el < bl) die("markers missing");
        {   long head = bl + tx_len(begin, 64) + 1, tail = el, at = 0;
            char *o = mm_alloc((size_t)(bn + wn + 16));
            if (!o) die("alloc");
            mm_copy(o, (size_t)head, bytes, (size_t)head);
            at = head;
            mm_copy(o + at, (size_t)wn, want, (size_t)wn); at += wn;
            mm_copy(o + at, (size_t)(bn - tail), bytes + tail, (size_t)(bn - tail)); at += bn - tail;
            if (cx_write(doc, o, (size_t)at)) die("doc write");
        }
        printf("ROOT_IDENTITY\temit=ok\tbytes=%ld\n", wn);
        return 0;
    }
    bytes = cx_read(doc, &sz);
        bn = (long)sz;
    if (!bytes) die("doc read");
    bl = find_marker(bytes, bn, begin);
    el = find_marker(bytes, bn, endmk);
    ok(bl >= 0 && el > bl, "identity-block-present");
    if (bl >= 0 && el > bl) {
        long at = bl + tx_len(begin, 64), len;
        while (at < el && (bytes[at] == '\n' || bytes[at] == '\r')) at++;   /* the newline after the marker */
        len = el - at;
        ok(len == wn && !memcmp(bytes + at, want, (size_t)wn), "identity-block-matches-product");
        if (!(len == wn && !memcmp(bytes + at, want, (size_t)wn))) {
            /* show the first differing line, so a red run says what to fix */
            long a1 = 0, a2 = 0;
            while (a1 < len && a2 < wn) {
                long e1 = a1, e2 = a2;
                while (e1 < len && bytes[at + e1] != '\n') e1++;
                while (e2 < wn && want[e2] != '\n') e2++;
                if ((e1 - a1) != (e2 - a2) || memcmp(bytes + at + a1, want + a2, (size_t)(e1 - a1))) {
                    printf("DIFF\tdoc=%.*s\nDIFF\tproduct=%.*s\n", (int)(e1 - a1), bytes + at + a1, (int)(e2 - a2), want + a2);
                    break;
                }
                a1 = e1 + 1; a2 = e2 + 1;
            }
        }
    }
    /* B5c: build.json must no longer carry an artifact_sha256 section.
       The product identity is the manifest (B5b), so a stale artifact field in the
       build record is exactly what made E0 step 8 refuse (root-epoch-record-shape).
       This assertion is written FIRST, while ident.c still writes the field, so a red
       run names the gap; ident.c's write/check paths are changed right after. */
    {
        char rec[4400];
        if (cx_fmt(rec, sizeof rec, "%s/unisacc.com.build.json", root)) die("record path");
        if (sy_exists(rec) != 1) {
            printf("BUILD_RECORD\tABSENT\t%s\n", rec);
            ok(0, "build-record-present");
        } else {
            size_t rn = 0;
            char *rb = cx_read(rec, &rn);
            int has = rb && rn > 0 && (memchr(rb, 0, rn) == 0) &&
                      (strstr(rb, "\"artifact_sha256\":") != 0);
            ok(rb && rn > 0, "build-record-readable");
            ok(!has, "build-record-has-no-artifact-section");
            ok(rb && strstr(rb, "\"sources_sha256\":") != 0, "build-record-keeps-sources");
            /* B5c follow-up: the record must carry the manifest identity fields that
               tools/source-package.cx root_epoch_execution_record rebuilds and compares
               byte for byte.  ident.c writes them; a record without them can never pass
               prepare-context (fields: product_kind, product_digest). */
            {
                char kind_pat[256], dg_pat[256], line[256];
                long i2;
                int has_kind = 0, has_dg = 0, kind_eq = 0, dg_eq = 0;
                char want_dg[65];
                const char *want_kind = pp_identity_kind(root);
                if (!want_kind) want_kind = "none";
                want_dg[0] = 0;
                if (pp_product_digest(root, want_dg)) want_dg[0] = 0;
                if (cx_fmt(kind_pat, sizeof kind_pat, "  \"product_kind\": \"%s\"", want_kind)) return 1;
                if (cx_fmt(dg_pat, sizeof dg_pat, "  \"product_digest\": \"%s\"", want_dg)) return 1;
                if (rb && rn > 0) {
                    for (i2 = 0; i2 < (long)rn; i2++) {
                        long e = i2, l2;
                        while (e < (long)rn && rb[e] != '\n') e++;
                        l2 = e - i2;
                        if (l2 > 0 && l2 < (long)sizeof line) {
                            memcpy(line, rb + i2, (size_t)l2); line[l2] = 0;
                            /* a field that is not last carries a trailing comma */
                            if (l2 > 1 && line[l2 - 1] == ',') line[l2 - 1] = 0;
                            if (!strcmp(line, kind_pat)) { has_kind = 1; kind_eq = 1; }

                            else if (strstr(line, "\"product_kind\":")) has_kind = 1;
                            if (!strcmp(line, dg_pat)) { has_dg = 1; dg_eq = 1; }
                            else if (strstr(line, "\"product_digest\":")) has_dg = 1;
                        }
                        i2 = e;
                    }
                }
                ok(has_kind, "build-record-has-product-kind");
                ok(has_dg, "build-record-has-product-digest");
                ok(kind_eq, "build-record-kind-matches-manifest");
                ok(dg_eq, "build-record-digest-matches-manifest");
            }
            /* the installed record must be the release asset of the candidate whose ape_sha256 is the installed
               APE (release/candidate.tsv): (a) such a row exists, (b) the record file's sha256 is the row's
               record_sha256, (c) its commit is the row's commit and its sources_sha256 equals the SID recomputed
               by the identity helper (--identity-helper H --sources DIR); without a helper (c-sid) is NOT_RUN. */
            {
                char com[4400], ctsv[4400], ahex[65], rhex[65], row_commit[65], row_rsha[65];
                size_t an = 0, tn = 0;
                char *ab, *tb;
                int found = 0, commit_eq = 0;
                row_commit[0] = row_rsha[0] = 0;
                if (cx_fmt(com, sizeof com, "%s/unisacc.com", root) || cx_fmt(ctsv, sizeof ctsv, "%s/release/candidate.tsv", root)) die("path");
                ab = cx_read(com, &an);
                if (ab) { cx_sha256_hex(ab, an, ahex); mm_free(ab); } else ahex[0] = 0;
                tb = cx_read(ctsv, &tn);
                if (tb && ahex[0]) {
                    long p = 0;
                    while (p < (long)tn) {
                        long e = p, f[24], nf = 0, q;
                        while (e < (long)tn && tb[e] != '\n') e++;
                        f[nf++] = p;
                        for (q = p; q < e && nf < 24; q++) if (tb[q] == '\t') f[nf++] = q + 1;
                        if (nf > 15 && f[9] - f[8] == 65 && !memcmp(tb + f[8], ahex, 64)) {
                            long a;
                            found = 1;
                            a = f[3] - 1 - f[2];
                            if (a < 0 || tx_copy(row_commit, sizeof row_commit, tb + f[2], a)) { found = 0; row_commit[0] = 0; }
                            if (f[15] - f[14] != 65 || tx_copy(row_rsha, sizeof row_rsha, tb + f[14], 64)) row_rsha[0] = 0;
                            break;
                        }
                        p = e + 1;
                    }
                    mm_free(tb);
                }
                ok(found, "build-record-installed-ape-in-candidate-tsv");
                cx_sha256_hex(rb ? rb : "", rb ? rn : 0, rhex);
                ok(found && rb && row_rsha[0] && tx_eqz(rhex, row_rsha), "build-record-sha256-matches-candidate");
                if (found && rb) {
                    char pat[160];
                    if (!cx_fmt(pat, sizeof pat, "\"commit\": \"%s\"", row_commit)) commit_eq = strstr(rb, pat) != 0;
                }
                ok(commit_eq, "build-record-commit-matches-candidate");
                if (!ri_helper[0] || !ri_sources[0]) {
                    not_run++;
                    printf("NOT_RUN\tbuild-record-sources-sha256-matches-recomputed\tno --identity-helper/--sources\n");
                } else {
                    char *out = 0, pat[160];
                    size_t on = 0;
                    int k, good, sid_eq = 0;
                    char *v[] = {ri_helper, ri_sources, 0};
                    good = cx_runv_timeout(v, 50, &out, &on) == 0 && out && on == 65 && out[64] == '\n';
                    for (k = 0; good && k < 64; k++) if (!((out[k] >= '0' && out[k] <= '9') || (out[k] >= 'a' && out[k] <= 'f'))) good = 0;
                    if (good) {
                        out[64] = 0;
                        if (rb && !cx_fmt(pat, sizeof pat, "\"sources_sha256\": \"%s\"", out)) sid_eq = strstr(rb, pat) != 0;
                        ok(sid_eq, "build-record-sources-sha256-matches-recomputed");
                    } else {
                        not_run++;
                        printf("NOT_RUN\tbuild-record-sources-sha256-matches-recomputed\thelper failed\n");
                    }
                    free(out);
                }
            }
            if (has) printf("BUILD_RECORD\tSTILL-HAS-artifact_sha256\t%s\n", rec);
            free(rb);
        }
    }

    /* the members the block must name, for a reader who only has the FAIL line */
    {   char names[RI_MAX][64], shas[RI_MAX][65];
        long bts[RI_MAX];
        int n = pp_member_list(root, names, shas, bts, RI_MAX);
        for (i = 0; i < n; i++) printf("MEMBER\t%s\t%s\t%ld\n", names[i], shas[i], bts[i]);
    }
    printf("ROOT_IDENTITY\tassertions=%d\tfailed=%d\tnot_run=%d\n", assertions, failed, not_run);
    return failed ? 1 : 0;
}
