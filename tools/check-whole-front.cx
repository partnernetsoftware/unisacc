/* 只证明分片合并的材料合同；产品阶段等价与真实 resume 需要另外的真实证据。
 * 全部检查在进程内使用微小独占 fixture，无编译或子进程，默认整体预算 55 秒。
 */
#pragma unisa use cxlib.wholefrontmerge
#pragma unisa use cxlib.pytempfile
#pragma unisa use cxlib.chainfacts
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use mem.bytes
static int failed,owned;
static char base[8192],part[2][8192];
static const unsigned char frame0[]={15,0,0,0,2,0,0,0,'/','a','U','N','I','T','O','K','1',0,'X'};
static const unsigned char frame1[]={15,0,0,0,2,0,0,0,'/','b','U','N','I','T','O','K','1',0,'Y'};
static const unsigned char attr0[]={1,0,0,0,0,0,0,0,3,0,0,0,1};
static const unsigned char attr1[]={1,0,0,0,1,0,0,0,4,0,0,0,2};
/* 独立手写 phase：不是调用生产编码器，也不从实际输出拼装期望。 */
static const unsigned char expected[]={
 38,0,0,0,22,0,0,0,
 15,0,0,0,2,0,0,0,'/','a','U','N','I','T','O','K','1',0,'X',
 15,0,0,0,2,0,0,0,'/','b','U','N','I','T','O','K','1',0,'Y',
 2,0,0,0,0,0,0,0,3,0,0,0,1,1,0,0,0,4,0,0,0,2
};
static void ck(int ok,const char *name){printf("%s\t%s\n",ok?"PASS":"FAIL",name);if(!ok)failed++;}
static int store(int k,const char *leaf,const void *bytes,size_t n){char p[8192];return cx_fmt(p,sizeof p,"%s/%s",part[k],leaf)||cx_write(p,bytes,n);}
static int manifest(int k,int first,int duplicate){char text[256];if(cx_fmt(text,sizeof text,"first\t%d\ncount\t1\ntotal\t2\n0\t/a\n1\t/%s\n",first,duplicate?"a":"b"))return 1;return store(k,"part.tsv",text,strlen(text));}
static int fixture(void){return manifest(0,0,0)||manifest(1,1,0)||store(0,"frames.bin",frame0,sizeof frame0)||store(1,"frames.bin",frame1,sizeof frame1)||store(0,"attrs.bin",attr0,sizeof attr0)||store(1,"attrs.bin",attr1,sizeof attr1);}
/* 独占创建探针证明路径确实未留下文件，不能仅把任意 open 失败当成 ENOENT。
 * 创建成功也证明父目录仍可写；探针立即关闭删除，不重复断言同一路径。 */
static int absent(const char *p){int fd=sy_open_new(p,0600);if(fd<0)return 0;int cl=sy_close(fd),rm=sy_unlink(p);return !cl&&!rm;}
static int exact(const char *p){size_t n=0;char *bytes=cx_read(p,&n);int ok=bytes&&n==sizeof expected&&!memcmp(bytes,expected,sizeof expected);free(bytes);return ok;}
static void one(int mode,const char *name){
 char out[8192],why[256]={0};const char *dirs[]={part[0],part[1]};int count=2;
 if(fixture()||cx_fmt(out,sizeof out,"%s/output-%d.phase",base,mode)){ck(0,"fixture-write");return;}
 unsigned char changed[32];int setup=0;
 if(mode==1)count=1;
 if(mode==2){dirs[0]=part[1];dirs[1]=part[0];}
 if(mode==3)setup=manifest(1,0,0);
 if(mode==4){setup=manifest(0,0,1)||manifest(1,1,1);memcpy(changed,frame1,sizeof frame1);changed[9]='a';setup=setup||store(1,"frames.bin",changed,sizeof frame1);}
 if(mode==5){memcpy(changed,attr1,sizeof attr1);changed[4]=0;setup=store(1,"attrs.bin",changed,sizeof attr1);}
 if(mode==6){memcpy(changed,frame1,sizeof frame1);changed[9]='z';setup=store(1,"frames.bin",changed,sizeof frame1);}
 if(mode==7)setup=store(1,"frames.bin",frame1,sizeof frame1-1);
 if(mode==8)setup=store(1,"attrs.bin",attr1,sizeof attr1-1);
 if(setup){ck(0,"mutation-write");return;}
 int rc=wf_merge_parts(dirs,count,out,why,sizeof why);
 int ok;if(!mode){ok=!rc&&exact(out);if(!rc&&sy_unlink(out))ok=0;}
 else {int missing=absent(out);ok=rc!=0&&why[0]&&missing;}
 ck(ok,name);if(!ok)fprintf(stderr,"case=%d rc=%d why=%s\n",mode,rc,why);
}
/* Deadline derivation fixtures: build the real tool once, drive its deadline-probe with a simulated clock (UNISACC_WF_TEST_SKEW_MS). */
static char wfd_bin[4400];
static int probe(const char *envs,const char *name,const char *want){char cmd[5600];if(cx_fmt(cmd,sizeof cmd,"env %s %s deadline-probe 2>&1",envs,wfd_bin))return 0;FILE *f=popen(cmd,"r");if(!f)return 0;char all[2048];size_t n=0,z;while(n<sizeof all-1&&(z=fread(all+n,1,sizeof all-1-n,f))>0)n+=z;all[n]=0;pclose(f);int ok=strstr(all,want)!=0;if(!ok)printf("got: %s\n",all);ck(ok,name);return ok;}
static void deadline_fixtures(void){
 {const char *td=getenv("TMPDIR");char bc[5000];if(!td||!*td)td="/tmp";if(cx_fmt(wfd_bin,sizeof wfd_bin,"%s/wfd-check-%d.bin",td,(int)getpid())||cx_fmt(bc,sizeof bc,"sh ./unisacc.com -o %s tools/whole-front.cx >/dev/null 2>&1",wfd_bin)||system(bc)){ck(0,"deadline-build");return;}}
 probe("UNISACC_CHAIN_PHASE_BOUND_S=90 UNISACC_WF_TEST_SKEW_MS=50000","deadline-bound90-50s-survives","DEADLINE_OK\t85");
 probe("UNISACC_CHAIN_PHASE_BOUND_S=90 UNISACC_WF_TEST_SKEW_MS=84000","deadline-bound90-84s-survives","DEADLINE_OK\t85");
 probe("UNISACC_CHAIN_PHASE_BOUND_S=90 UNISACC_WF_TEST_SKEW_MS=85000","deadline-bound90-85s-dies","phase deadline (85 seconds)");
 probe("UNISACC_CHAIN_PHASE_BOUND_S=60 UNISACC_WF_TEST_SKEW_MS=55000","deadline-bound60-55s-dies","phase deadline (55 seconds)");
 probe("UNISACC_WF_TEST_SKEW_MS=44000","deadline-absent-44s-survives","DEADLINE_OK\t45");
 probe("UNISACC_WF_TEST_SKEW_MS=45000","deadline-absent-45s-dies","phase deadline (45 seconds)");
 const char *bad[]={"0","91","x","5"};for(int i=0;i<4;i++){char e[200],nm[64];if(cx_fmt(e,sizeof e,"UNISACC_CHAIN_PHASE_BOUND_S=%s UNISACC_WF_TEST_SKEW_MS=45000",bad[i])||cx_fmt(nm,sizeof nm,"deadline-invalid-%s-falls-back-45",bad[i])){ck(0,"deadline-format");continue;}probe(e,nm,"invalid UNISACC_CHAIN_PHASE_BOUND_S, using 45 s deadline");}
}
 /* Check exact line suffix ending with newline in emitted roots/probe output. */
static int wf_has_line(const char *s,const char *suf){
 if(!s||!suf)return 0;size_t sl=strlen(suf);
 for(const char *p=s;*p;){const char *e=strchr(p,'\n');size_t ln=e?(size_t)(e-p):strlen(p);
  if(ln>=sl&&!memcmp(p+ln-sl,suf,sl))return 1;if(!e)break;p=e+1;}
 return 0;
}
 /* Check cf_root_source_for on non-lnx targets using a synthetic root_target override in an isolated fixture. */
static void wf_target_override_fixtures(void){
 char cwd[4096],root[4096],fx[4400],p[4600],q[4600],probe_src[4400],probe_bin[4400],wf_bin[4400];
 char pkg[4400],objs[4400],driveo[4400],prep_osx[4400],prep_def[4400],part_osx[4400],part_win[4400];
 char log_osx[4400],log_win[4400],cmd[10000];
 if(!getcwd(cwd,sizeof cwd)||sy_realpath(cwd,root,sizeof root)<0){ck(0,"synth-root");return;}
 if(cx_fmt(fx,sizeof fx,"%s/fx",base)||cx_fmt(probe_src,sizeof probe_src,"%s/probe.cx",fx)||
    cx_fmt(probe_bin,sizeof probe_bin,"%s/probe",base)||cx_fmt(wf_bin,sizeof wf_bin,"%s/wf-fx",base)||
    cx_fmt(pkg,sizeof pkg,"%s/fake.pkg",base)||cx_fmt(objs,sizeof objs,"%s/objects",base)||
    cx_fmt(driveo,sizeof driveo,"%s/drive.o",objs)||cx_fmt(prep_osx,sizeof prep_osx,"%s/prep-osx",base)||
    cx_fmt(prep_def,sizeof prep_def,"%s/prep-def",base)||cx_fmt(part_osx,sizeof part_osx,"%s/part-osx",base)||
    cx_fmt(part_win,sizeof part_win,"%s/part-win",base)||cx_fmt(log_osx,sizeof log_osx,"%s/log-osx.txt",base)||
    cx_fmt(log_win,sizeof log_win,"%s/log-win.txt",base)){ck(0,"synth-paths");return;}
 if(cx_fmt(p,sizeof p,"%s/build",fx)||sy_mkdir_all(p,0755)||
    cx_fmt(p,sizeof p,"%s/tools/cxlib",fx)||sy_mkdir_all(p,0755)||
    cx_fmt(p,sizeof p,"%s/tools/templates",fx)||sy_mkdir_all(p,0755)||
    cx_fmt(p,sizeof p,"%s/src/driver",fx)||sy_mkdir_all(p,0755)||
    cx_fmt(p,sizeof p,"%s/src/runtime/compiler",fx)||sy_mkdir_all(p,0755)||
    cx_fmt(p,sizeof p,"%s/src/core",fx)||sy_mkdir_all(p,0755)||
    cx_fmt(p,sizeof p,"%s/src/compiler",fx)||sy_mkdir_all(p,0755)||
    sy_mkdir_all(objs,0755)){ck(0,"synth-mkdirs");return;}
 {
  const char *links[]={"cx","ext","unisa","include","unisacc.com"};
  for(int i=0;i<5;i++){if(cx_fmt(p,sizeof p,"%s/%s",root,links[i])||cx_fmt(q,sizeof q,"%s/%s",fx,links[i])||sy_symlink(p,q)){ck(0,"synth-symlink");return;}}
 }
 {
  size_t zn=0;char *b;
  if(cx_fmt(p,sizeof p,"%s/cxroot.tsv",root)||!(b=cx_read(p,&zn))||cx_fmt(q,sizeof q,"%s/cxroot.tsv",fx)||cx_write(q,b,zn)){ck(0,"synth-cxroot");return;}free(b);
  if(cx_fmt(p,sizeof p,"%s/tools/whole-front.cx",root)||!(b=cx_read(p,&zn))||cx_fmt(q,sizeof q,"%s/tools/whole-front.cx",fx)||cx_write(q,b,zn)){ck(0,"synth-wf-copy");return;}free(b);
  if(cx_fmt(p,sizeof p,"%s/tools/cxlib/chainfacts.cx",root)||!(b=cx_read(p,&zn))||cx_fmt(q,sizeof q,"%s/tools/cxlib/chainfacts.cx",fx)||cx_write(q,b,zn)){ck(0,"synth-cf-copy");return;}free(b);
  if(cx_fmt(q,sizeof q,"%s/tools/templates/whole-front.cx.in",fx)||cx_write(q,"int main(void){return 0;}\n",25)){ck(0,"synth-tmpl");return;}
  if(cx_fmt(p,sizeof p,"%s/build/chain-facts.tsv",root)||!(b=cx_read(p,&zn))){ck(0,"synth-facts-read");return;}
  {const char *add="root_target\tosx/x86_64:driveargs.o\tsrc/driveargs_osx_synth.cx\n";
   size_t an=strlen(add);char *nb=malloc(zn+an);if(!nb||mm_copy(nb,(long)zn,b,(long)zn)||mm_copy(nb+zn,(long)an,add,(long)an)){free(nb);free(b);ck(0,"synth-oom");return;}
   int bad=cx_fmt(q,sizeof q,"%s/build/chain-facts.tsv",fx)||cx_write(q,nb,zn+an);free(nb);free(b);if(bad){ck(0,"synth-facts-write");return;}}
 }
 {
  if(cx_fmt(p,sizeof p,"%s/tools/cxlib",root)){ck(0,"synth-cxlib-dir");return;}
  DIR *d=opendir(p);struct dirent *e;if(!d){ck(0,"synth-cxlib-open");return;}
  while((e=readdir(d))){size_t zn=strlen(e->d_name);if(zn<4||strcmp(e->d_name+zn-3,".cx")||!strcmp(e->d_name,"chainfacts.cx"))continue;
   if(cx_fmt(p,sizeof p,"%s/tools/cxlib/%s",root,e->d_name)||cx_fmt(q,sizeof q,"%s/tools/cxlib/%s",fx,e->d_name)||sy_symlink(p,q)){closedir(d);ck(0,"synth-cxlib-link");return;}}
  closedir(d);
 }
 for(int i=0;i<cf_root_count();i++){if(cx_fmt(q,sizeof q,"%s/%s",fx,cf_root_source(i))||cx_write(q,"int r0(void){return 0;}\n",24)){ck(0,"synth-root-stubs");return;}}
 if(cx_fmt(q,sizeof q,"%s/src/driveargs_osx_synth.cx",fx)||cx_write(q,"int rs(void){return 1;}\n",24)){ck(0,"synth-override-file");return;}
 if(cx_fmt(q,sizeof q,"%s/src/drivestream_m1.cx",fx)||cx_write(q,"int rm(void){return 2;}\n",24)){ck(0,"synth-m1-file");return;}
 {
  const char *ps=
   "#pragma unisa use sys.fs\n#pragma unisa use sys.posix\n#pragma unisa use sys.env\n#pragma unisa use sys.io\n#pragma unisa use text.text\n#pragma unisa use mem.heap\n"
   "int main(int argc,char **argv){\n"
   " const char *lp=sy_env(\"WF_PROBE_LOG\");\n"
   " if(lp&&*lp){int fd=sy_open(lp,O_WRONLY|O_CREAT|O_APPEND,0644);if(fd>=0){for(int i=0;i<argc;i++){(void)sy_write_all(fd,argv[i],(long)strlen(argv[i]));(void)sy_write_all(fd,\"\\n\",1);}(void)sy_close(fd);}}\n"
   " if(argc==2&&argv[1][0]=='/'){sy_printf(\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\\n\");return 0;}\n"
   " if(argc>=7&&tx_eqz(argv[1],\"front\")){char f[4400],l[4600];int t=argc-7,fd;(void)sy_mkdir_all(argv[4],0755);"
   "  if(cx_fmt(f,sizeof f,\"%s/frames.bin\",argv[4])||cx_write(f,\"FR\",2)||cx_fmt(f,sizeof f,\"%s/attrs.bin\",argv[4])||cx_write(f,\"AT\",2)||cx_fmt(f,sizeof f,\"%s/part.tsv\",argv[4]))return 2;"
   "  fd=sy_open(f,O_WRONLY|O_CREAT|O_TRUNC,0644);if(fd<0)return 2;"
   "  if(cx_fmt(l,sizeof l,\"first\\t%s\\ncount\\t%d\\ntotal\\t%d\\n\",argv[5],t,t)||sy_write_all(fd,l,(long)strlen(l)))return 2;"
   "  for(int i=0;i<t;i++)if(cx_fmt(l,sizeof l,\"%d\\t%s\\n\",i,argv[7+i])||sy_write_all(fd,l,(long)strlen(l)))return 2;"
   "  if(sy_close(fd))return 2;return 0;}\n"
   " for(int i=1;i+1<argc;i++)if(tx_eqz(argv[i],\"-o\")){if(argc>=4&&tx_eqz(argv[1],\"-o\")&&!tx_eqz(argv[3],\"-b\")){size_t zn=0;char *s=cx_read(argv[0],&zn);if(!s||!zn||cx_write(argv[i+1],s,zn)||chmod(argv[i+1],0755))return 2;mm_free(s);}else if(cx_write(argv[i+1],\"OK\",2))return 2;return 0;}\n"
   " return 0;}\n";
  if(cx_write(probe_src,ps,strlen(ps))){ck(0,"synth-probe-write");return;}
 }
 {
  char psha[65],dsha[65],rf[4400],rec[2048];
  if(cx_write(pkg,"PKG",3)||cx_write(driveo,"DRV",3)){ck(0,"synth-pkg-obj");return;}
  if(sy_sha256_hex("PKG",3,psha)||sy_sha256_hex("DRV",3,dsha)||cx_fmt(rf,sizeof rf,"%s/receipt.txt",objs)){ck(0,"synth-sha");return;}
  if(cx_fmt(rec,sizeof rec,"root\t%s\np3\t%s\np3_sha\t%s\ndrive.o\tsha=%s\tbytes=3\n",fx,pkg,psha,dsha)||cx_write(rf,rec,strlen(rec))){ck(0,"synth-obj-receipt");return;}
 }
 if(cx_fmt(cmd,sizeof cmd,"cd \"%s\" && sh \"%s/unisacc.com\" \"%s/tools/chain-facts-gen.cx\" -- --write >/dev/null 2>&1",fx,root,root)||system(cmd)){ck(0,"synth-chainfacts-gen");return;}
 if(cx_fmt(cmd,sizeof cmd,"cd \"%s\" && sh \"%s/unisacc.com\" -o \"%s\" \"%s\" >/dev/null 2>&1",fx,root,probe_bin,probe_src)||system(cmd)){ck(0,"synth-probe-build");return;}
 {
  int compiled=(!cx_fmt(cmd,sizeof cmd,"cd \"%s\" && sh \"%s/unisacc.com\" -o \"%s\" \"%s/tools/whole-front.cx\" >/dev/null 2>&1",fx,root,wf_bin,fx)&&system(cmd)==0);
  ck(compiled,"synth-wf-compile");
  if(!compiled)return;
 }
 {
  int rc1=(!cx_fmt(cmd,sizeof cmd,"env UNISACC_IDENTITY_HELPER=\"%s\" TARGET=osx/x86_64 \"%s\" prepare \"%s\" \"%s\" \"%s\" \"%s\" \"%s\" >/dev/null 2>&1",probe_bin,wf_bin,fx,pkg,probe_bin,objs,prep_osx)&&system(cmd)==0);
  size_t zn=0;char *rt=0;
  if(rc1&&!cx_fmt(p,sizeof p,"%s/roots.txt",prep_osx))rt=cx_read(p,&zn);
  ck(rc1&&rt&&wf_has_line(rt,"/src/driveargs_osx_synth.cx")&&!wf_has_line(rt,"/src/drivestream_m1.cx"),"synth-prepare-osx-override-without-lnx-leak");
  free(rt);
 }
 {
  int rc2=(!cx_fmt(cmd,sizeof cmd,"env -u TARGET UNISACC_IDENTITY_HELPER=\"%s\" \"%s\" prepare \"%s\" \"%s\" \"%s\" \"%s\" \"%s\" >/dev/null 2>&1",probe_bin,wf_bin,fx,pkg,probe_bin,objs,prep_def)&&system(cmd)==0);
  size_t zn=0;char *rt=0;
  if(rc2&&!cx_fmt(p,sizeof p,"%s/roots.txt",prep_def))rt=cx_read(p,&zn);
  ck(rc2&&rt&&wf_has_line(rt,"/src/driveargs.cx")&&wf_has_line(rt,"/src/drivestream.cx")&&!wf_has_line(rt,"/src/drivestream_m1.cx"),"synth-prepare-unset-target-is-neutral");
  free(rt);
 }
 {
  int rc3=(!cx_fmt(cmd,sizeof cmd,"env -u TARGET UNISACC_IDENTITY_HELPER=\"%s\" WF_PROBE_LOG=\"%s\" \"%s\" front \"%s\" osx/x86_64 \"%s\" 0 45 >/dev/null 2>&1",probe_bin,log_osx,wf_bin,prep_def,part_osx)&&system(cmd)==0);
  size_t zn=0;char *lg=cx_read(log_osx,&zn);
  ck(rc3&&lg&&wf_has_line(lg,"/src/driveargs_osx_synth.cx")&&!wf_has_line(lg,"/src/drivestream_m1.cx"),"synth-front-osx-uses-override-from-neutral-prep");
  free(lg);
 }
 {
  int rc4=(!cx_fmt(cmd,sizeof cmd,"env -u TARGET UNISACC_IDENTITY_HELPER=\"%s\" WF_PROBE_LOG=\"%s\" \"%s\" front \"%s\" win/x86_64 \"%s\" 0 45 >/dev/null 2>&1",probe_bin,log_win,wf_bin,prep_def,part_win)&&system(cmd)==0);
  size_t zn=0;char *lg=cx_read(log_win,&zn);
  ck(rc4&&lg&&wf_has_line(lg,"/src/driveargs.cx")&&!wf_has_line(lg,"/src/driveargs_osx_synth.cx"),"synth-front-win-unaffected-by-osx-override");
  free(lg);
 }
}
int main(void){deadline_fixtures();
 if(!ptf_mkdtemp(0,"whole-front-check-",base,sizeof base))owned=1;
 if(!owned||cx_fmt(part[0],sizeof part[0],"%s/part0",base)||cx_fmt(part[1],sizeof part[1],"%s/part1",base)||sy_mkdir(part[0],0700)||sy_mkdir(part[1],0700)){
  ck(0,"exclusive-fixture");
 }else{
  wf_target_override_fixtures();
  one(0,"two-parts-independent-phase-bytes");
  one(1,"missing-part-no-output");
  one(2,"out-of-order-no-output");
  one(3,"overlap-no-output");
  one(4,"duplicate-unit-path-no-output");
  one(5,"cross-part-global-unit-attribute-no-output");
  one(6,"frame-name-manifest-mismatch-no-output");
  one(7,"truncated-frame-tail-no-output");
  one(8,"attribute-length-mismatch-no-output");
 }
 if(owned)ptf_rmtree(base);
 printf("CHECK_WHOLE_FRONT\tfailed=%d\n",failed);return failed?1:0;
}
