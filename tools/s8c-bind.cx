/* tools/s8c-bind.cx -- init a session then `all-waves material` every MAP name.
 *   sh ./unisacc.com tools/s8c-bind.cx -- ROOT SESSION CANDIDATE MAP
 * SESSION must be absent. Each material is its own tools/bound 55. PREPARED≠PASS. */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
static void die(const char *s){fprintf(stderr,"s8c-bind: %s\n",s);exit(2);}
static int run(char **v,const char *cwd){
    np_result r;char why[1200];
    if(np_run(v,cwd,0,55,&r,why,sizeof why)){fprintf(stderr,"s8c-bind: transport %s\n",why);np_free(&r);return 2;}
    int rc=r.rc;if(r.outn)fwrite(r.out,1,r.outn,stdout);if(r.errn)fwrite(r.err,1,r.errn,stderr);
    np_free(&r);return rc;
}
int main(int argc,char **argv){
    int a=argc>=2&&!strcmp(argv[1],"--")?2:1;
    if(argc-a!=4){fputs("usage: ROOT SESSION CANDIDATE MAP\n",stderr);return 2;}
    const char *R=argv[a],*S=argv[a+1],*C=argv[a+2],*M=argv[a+3];
    struct stat st;if(!lstat(S,&st))die("session-must-be-absent");
    {char *v[]={"tools/bound","55","sh","./unisacc.com","tools/all-waves.cx","--","init",(char*)R,(char*)S,(char*)C,(char*)M,0};
     int rc=run(v,R);if(rc)return rc;}
    FILE *f=fopen(M,"r");if(!f)die("map");
    char line[4400];
    while(fgets(line,sizeof line,f)){
        if(line[0]=='#'||line[0]=='\n')continue;
        char *tab=strchr(line,'\t');if(!tab)continue;*tab=0;
        char *v[]={"tools/bound","55","sh","./unisacc.com","tools/all-waves.cx","--","material",(char*)R,(char*)S,line,0};
        int rc=run(v,R);if(rc){fclose(f);return rc;}
    }
    fclose(f);puts("BIND_DONE");return 0;
}
