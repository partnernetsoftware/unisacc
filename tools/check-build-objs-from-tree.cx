/* tools/check-build-objs-from-tree.cx -- check for tools/build-objs-from-tree.cx. */
#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use cxlib.netpack
#pragma unisa use mem.bytes

int main(void) {
    char cwd[4096], why[128];
    if (sy_cwd(cwd, (int)sizeof cwd) != 0) return 2;
    np_result r1, r2;
    mm_fill(&r1, (long)sizeof r1, 0, (long)sizeof r1);
    mm_fill(&r2, (long)sizeof r2, 0, (long)sizeof r2);
    char *av1[] = {"sh", "./unisacc.com", "tools/build-objs-from-tree.cx", "--", "--self-test", 0};
    char *av2[] = {"sh", "./unisacc.com", "tools/build-objs-from-tree.cx", "--", 0};
    int t1 = np_run(av1, cwd, 0, 30, &r1, why, sizeof why);
    int t2 = np_run(av2, cwd, 0, 30, &r2, why, sizeof why);
    int ok = (t1 == 0 && r1.rc == 0 && t2 == 0 && r2.rc == 2);
    sy_printf("CHECK_BUILD_OBJS_FROM_TREE\tselftest_rc=%d\tmissing_args_rc=%d\tstatus=%s\n",
              t1 ? 124 : r1.rc, t2 ? 124 : r2.rc, ok ? "PASS" : "FAIL");
    np_free(&r1);
    np_free(&r2);
    return ok ? 0 : 1;
}
