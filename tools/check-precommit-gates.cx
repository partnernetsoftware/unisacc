/* tools/check-precommit-gates.cx -- tools/precommit.cx gate read sets (tests/precommit-gates.tsv) and the
 * within-one-commit reuse of a gate result (UNISACC_GATE_REUSE, written by tools/commit-own.cx).
 *
 *   sh ./unisacc.com tools/check-precommit-gates.cx -- --cases na|reuse|toolsreg-a|toolsreg-b|toolsreg-c|toolsreg-d   (six batches, each measured under 35 s)
 *   sh ./unisacc.com tools/check-precommit-gates.cx -- --cases toolsreg   (toolsreg-a, -b and -c in one run; not a batch)
 *   sh ./unisacc.com tools/check-precommit-gates.cx -- --bench before|after  (a measurement, not a batch)
 *
 * Fixture: a fixed private copy ~/.cache/unisacc/check-precommit-gates/fx-GROUP (git archive HEAD, the working
 * precommit.cx, commit-own.cx and tests/precommit-gates.tsv, unisacc.com symlinked) so the -run compile cache,
 * keyed by path, is reused across runs; a pid lock directory refuses a second concurrent run (rc 2).
 * tools/precommit-base.cx in the fixture is precommit.cx at PCG_BASE (the last version before read sets).
 * na:    --gates rows of the table equal the builtin fallback; a table missing a gate row fails closed;
 *        a staging disjoint from every read set prints not_affected=7, no PASS, and the same PRECOMMIT line
 *        and rc as the base; a staged .cx with an R2 lint finding is blocked exactly as by the base (line, rc,
 *        every "precommit: " message).
 * reuse: a staged manifest is judged as by the base; with a reuse record whose key matches (staged tree, gate,
 *        tool blob, argv) the recorded output is judged and reg-manifest does not run again (the record carries
 *        a marker row the real tool cannot print); a record with another tree is ignored and the gate reruns;
 *        commit-own --registered writes the record and the hook's precommit reuses it.
 * Last line CHECK_PRECOMMIT_GATES<TAB>failed=N; rc 1 when N > 0. */
#pragma unisa use cxlib.productpkg
#pragma unisa use sys.proc
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use text.text
#pragma unisa use sys.time

#define PCG_BASE "9a69f28dbc"       /* tools/precommit.cx before read sets */
#define PCG_BASE_CO "b94d1a83a2"    /* tools/commit-own.cx before the reuse record */
#define T "\t"
#define PCG_MK "mk(){ sh \"$COMMIT_GATE_FIXTURE_PRODUCT\" \"$COMMIT_GATE_FIXTURE_SOURCE\" -- --fixture-batch \"$1\" precommit > \"fixture-$1.out\"; }; "

static int failed;
static char root[2048], fx[2400], lockd[2500];
static void ck(int ok, const char *name) { if (ok) sy_printf("PASS\tcheck-precommit-gates.%s\n", name); else { failed++; sy_printf("FAIL\tcheck-precommit-gates.%s\n", name); } }
static void unlock(void) { char p[2600]; if (!lockd[0]) return; if (!cx_fmt(p, sizeof p, "%s/pid", lockd)) sy_unlink(p); sy_rmdir(lockd); }
static void die(const char *s) { sy_eprintf("check-precommit-gates: REFUSE %s\n", s); unlock(); exit(2); }
static int has(const char *o, const char *s) { return tx_find(o, tx_len(o, 1 << 20), s, tx_len(s, 4096)) >= 0; }

/* sh -c SCRIPT (cwd = the fixture when INFX); stdout+stderr into OUT; bounded */
static int sh(const char *script, char *out, int cap, int infx) {
    char *av[] = {"sh", "-c", 0, 0}, *o = 0; size_t on = 0; int rc; static char full[12000];
    if (cx_fmt(full, sizeof full, "unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE; %s%s%s { %s\n} 2>&1", infx ? "cd " : "", infx ? fx : "", infx ? " &&" : "", script)) die("script too long");
    av[2] = full;
    rc = cx_runv_timeout(av, 50, &o, &on);
    if (cap > 0) { size_t m = o ? on : 0; if (m > (size_t)cap - 1) m = (size_t)cap - 1; if (m) tx_copy(out, cap, o, (long)m); out[m] = 0; }
    if (o) mm_free(o);
    return rc;
}

/* Compatibility entrypoints delegate fixture construction to its own tool. */
static int pcg_fixture_forward(char **extra) {
    const char *product=sy_env("COMMIT_GATE_FIXTURE_PRODUCT"),*source=sy_env("COMMIT_GATE_FIXTURE_SOURCE");
    if(!product||!*product||!source||!*source)die("fixture-tool-not-prepared");
    char *args[12];int n=4;args[0]="sh";args[1]=(char *)product;args[2]=(char *)source;args[3]="--";
    for(int i=0;extra[i];i++){if(n==11)die("fixture-tool-argv");args[n++]=extra[i];}args[n]=0;
    sy_spawn_t options;sy_exit_t status;sy_spawn_init(&options);
    options.argv=args;options.deadline_ms=50000;
    int rc=sy_proc_run(&options,&status);return rc?2:sy_exit_code(&status);
}
static int pcg_fixture_register(const char *source) {
    char *args[]={"--fixture-register-tool",(char *)source,0};return pcg_fixture_forward(args);
}
static int pcg_fixture_batch(const char *id,const char *family) {
    char *args[]={"--fixture-batch",(char *)id,(char *)family,0};return pcg_fixture_forward(args);
}


static void setup(const char *group) {
    static char c[8000], out[4096]; const char *home = sy_env("HOME");
    if (sy_cwd(root, sizeof root) || !home || !home[0]) die("cwd or HOME");
    if (cx_fmt(fx, sizeof fx, "%s/.cache/unisacc/check-precommit-gates/fx-%s", home, group) || cx_fmt(lockd, sizeof lockd, "%s.lock", fx)) die("path");
    if (cx_fmt(c, sizeof c, "mkdir -p %s/.cache/unisacc/check-precommit-gates && if mkdir %s 2>/dev/null; then echo $PPID > %s/pid; echo LOCK_OK; "
                            "elif kill -0 \"$(cat %s/pid 2>/dev/null)\" 2>/dev/null; then echo LOCK_HELD; else echo $PPID > %s/pid; echo LOCK_OK; fi", home, lockd, lockd, lockd, lockd)) die("script");
    sh(c, out, sizeof out, 0);
    if (!has(out, "LOCK_OK")) { lockd[0] = 0; die("another check-precommit-gates run holds the fixture lock"); }
    if (cx_fmt(c, sizeof c, "rm -rf %s && mkdir -p %s && git -C %s archive HEAD | tar -x -C %s && cp %s/tools/precommit.cx %s/tools/commit-own.cx %s/tools/"
                            " && cp %s/tests/precommit-gates.tsv %s/tests/tools-compile.cx %s/tests/ && git -C %s show " PCG_BASE ":tools/precommit.cx > %s/tools/precommit-base.cx"
                            " && git -C %s show " PCG_BASE_CO ":tools/commit-own.cx > %s/tools/commit-own-base.cx"
                            " && cd %s && ln -s %s/unisacc.com unisacc.com && git init -q && git config user.name pcg && git config user.email pcg@example.invalid"
                            " && printf 'tools/commit-own-base.cx" T "regular\\ntools/precommit-base.cx" T "regular\\n' >> tests/tools-compile-sources.tsv"
                            /* the two base copies can push the inventory past a multiple of 8 (1088 -> 1090 needs shard 136):
                               register any shard the fixture inventory now needs, with the exact tools-compile batch contract */
                            " && n=$(grep -c . tests/tools-compile-sources.tsv) && i=$(grep -c '^tools-compile-' tests/batches.tsv) && while [ $i -lt $(( (n + 7) / 8 )) ]; do"
                            " printf 'tools-compile-%%03d" T "IMPLEMENTED" T "contract" T "tests/tools-compile.cx" T "SOURCE" T "lnx/x86_64" T "55" T "-" T "tests/tools-compile.cx" T "{root};{out};%%d" T "tools.compile-all" T "rc0:TOOLS_COMPILE" T "product" T "commit\\n' $i $i >> tests/batches.tsv; i=$((i + 1)); done"
                            " && git add -A && git commit -qm base && echo SETUP_OK",
               fx, fx, root, fx, root, root, fx, root, root, fx, root, fx, root, fx, fx, root)) die("script");
    sh(c, out, sizeof out, 0);
    if (!has(out, "SETUP_OK")) { sy_eprintf("%s\n", out); die("fixture setup"); }
    if (cx_fmt(c, sizeof c, "cp %s/tools/check-precommit-gates.cx %s/tools/", root, fx) || sh(c, out, sizeof out, 0)) die("fixture helper copy");
    { char marker[4096];const char *text="UNISACC_GATE_FIXTURE_V1\n";
      if(cx_fmt(marker,sizeof marker,"%s/.commit-gate-fixture",fx)||
         sy_write_atomic(marker,text,strlen(text),0600))die("fixture-marker-write"); }
    { char source[4096],product[4096];
      if(cx_fmt(source,sizeof source,"%s/tools/fixture-gate-tool.cx",root)||
         cx_fmt(product,sizeof product,"%s/unisacc.com",root)||
         sy_setenv("COMMIT_GATE_FIXTURE_SOURCE",source,1)||
         sy_setenv("COMMIT_GATE_FIXTURE_PRODUCT",product,1))die("fixture-tool-env"); }
}

static void group_na(void) {
    static char out[16384];
    sh("sh ./unisacc.com tools/precommit.cx -- --gates > g1.out; echo G1RC=$?; mv tests/precommit-gates.tsv gates.keep;"
       " sh ./unisacc.com tools/precommit.cx -- --gates > g2.out; echo G2RC=$?;"
       " grep -v '^facts' gates.keep > tests/precommit-gates.tsv; printf 'z\\n' > zz-na.txt; git add tests/precommit-gates.tsv zz-na.txt;"
       " sh ./unisacc.com tools/precommit.cx > m.out 2>&1; echo MRC=$?; grep -c 'gate facts has no read-set row' m.out | tr '\\n' ' '; echo norow;"
       " cp gates.keep tests/precommit-gates.tsv; git reset -q tests/precommit-gates.tsv;"
       " grep '^GATE" T "' g1.out > g1.rows; grep '^GATE" T "' g2.out > g2.rows; cmp -s g1.rows g2.rows && echo GATES_SAME; echo NROWS=$(grep -c . g1.rows); tail -1 g1.out; tail -1 g2.out", out, sizeof out, 1);
    ck(has(out, "G1RC=0\n") && has(out, "G2RC=0\n") && has(out, "GATES_SAME\n") && has(out, "NROWS=7\n") && has(out, "GATES\tsource=table\n") && has(out, "GATES\tsource=builtin\n"), "na.table-equals-builtin");
    ck(has(out, "MRC=1\n") && has(out, "1 norow\n"), "na.missing-row-fails-closed");
    sh("sh ./unisacc.com tools/precommit.cx > n.out 2> n.err; echo NRC=$?; sh ./unisacc.com tools/precommit-base.cx > b.out 2> b.err; echo BRC=$?;"
       " echo \"NL=$(grep '^PRECOMMIT" T "' n.out)\"; echo \"BL=$(grep '^PRECOMMIT" T "' b.out)\"; grep '^PRECOMMIT_GATES' n.out; echo PASSCNT=$(cat n.out n.err | grep -c PASS)", out, sizeof out, 1);
    ck(has(out, "PRECOMMIT_GATES\tnot_affected=7\tna=cx,manifest,tables,toolsreg,runlist,facts,ledger\tsource=table\n") && has(out, "PASSCNT=0\n"), "na.disjoint-not-affected-not-pass");
    ck(has(out, "NRC=0\n") && has(out, "BRC=0\n") && has(out, "NL=PRECOMMIT\tstaged_cx=0\tblocked=0\n") && has(out, "BL=PRECOMMIT\tstaged_cx=0\tblocked=0\n"), "na.disjoint-verdict-as-base");
    sh("printf '%s\\n' 'static void zz2(char **v) { sy_spawn(v); }' >> tools/flowrun.cx && git add tools/flowrun.cx;"
       " ( sh ./unisacc.com tools/precommit.cx > n.out 2> n.err; echo $? > n.rc ) & ( sh ./unisacc.com tools/precommit-base.cx > b.out 2> b.err; echo $? > b.rc ) & wait;"
       " echo NRC=$(cat n.rc); echo BRC=$(cat b.rc); echo \"NL=$(grep '^PRECOMMIT" T "' n.out)\"; echo \"BL=$(grep '^PRECOMMIT" T "' b.out)\"; grep '^PRECOMMIT_GATES' n.out;"
       " grep '^precommit: ' n.err | sort > n.msg; grep '^precommit: ' b.err | sort > b.msg; cmp -s n.msg b.msg && echo MSG_SAME; echo NMSG=$(grep -c 'blocked:lint:' b.msg)", out, sizeof out, 1);
    ck(has(out, "NRC=1\n") && has(out, "BRC=1\n") && has(out, "NL=PRECOMMIT\tstaged_cx=1\tblocked=1\n") && has(out, "BL=PRECOMMIT\tstaged_cx=1\tblocked=1\n"), "na.intersecting-verdict-as-base");
    ck(has(out, "MSG_SAME\n") && !has(out, "NMSG=0\n") && has(out, "NMSG="), "na.intersecting-messages-as-base");
    ck(has(out, "PRECOMMIT_GATES\tnot_affected=6\tna=manifest,tables,toolsreg,runlist,facts,ledger\tsource=table\n"), "na.intersecting-gate-not-counted");
    if (failed) sy_printf("%s\n", out);
}

static void group_reuse(void) {
    static char out[16384];
    sh(PCG_MK "mk zzg1; git add tests/manifests/zzg1.tsv; TR=$(git write-tree); H=$(git hash-object -- tools/reg-manifest.cx); A='sh ./unisacc.com tools/reg-manifest.cx -- --check --index';"
       " printf 'KEY" T "tree=%s" T "gate=manifest" T "tool=%s" T "argv=%s\\nRC" T "1\\nMISSING" T "zzfake" T "reuse-marker\\n' \"$TR\" \"$H\" \"$A\" > reuse-ok.txt;"
       " printf 'KEY" T "tree=%s" T "gate=manifest" T "tool=%s" T "argv=%s\\nRC" T "1\\nMISSING" T "zzfake" T "reuse-marker\\n' 0000000000000000000000000000000000000000 \"$H\" \"$A\" > reuse-bad.txt;"
       " ( sh ./unisacc.com tools/precommit.cx > dn.out 2>&1; echo $? > dn.rc ) & ( sh ./unisacc.com tools/precommit-base.cx > db.out 2>&1; echo $? > db.rc ) &"
       " ( UNISACC_GATE_REUSE=$PWD/reuse-ok.txt sh ./unisacc.com tools/precommit.cx > e.out 2>&1; echo $? > e.rc ) &"
       " ( UNISACC_GATE_REUSE=$PWD/reuse-bad.txt sh ./unisacc.com tools/precommit.cx > f.out 2>&1; echo $? > f.rc ) & wait;"
       " for x in dn db e f; do grep BLOCKED $x.out | sort > $x.blk; done;"
       " echo DRC=$(cat dn.rc)/$(cat db.rc); echo ERC=$(cat e.rc); echo FRC=$(cat f.rc); cmp -s dn.blk db.blk && echo D_SAME; cmp -s f.blk dn.blk && echo F_SAME;"
       " echo DREAL=$(grep -c 'registration manifest.*zzg1' dn.blk); echo EREAL=$(grep -c 'registration manifest.*zzg1' e.blk); echo EFAKE=$(grep -c 'registration manifest MISSING" T "zzfake' e.blk);"
       " echo FFAKE=$(grep -c zzfake f.out); echo EMSG=$(grep -c 'gate manifest reused' e.out); echo FMSG=$(grep -c 'gate manifest reuse: key mismatch, rerun' f.out);"
       " echo \"DL=$(grep '^PRECOMMIT" T "' dn.out)\"; echo \"BL=$(grep '^PRECOMMIT" T "' db.out)\"; grep '^PRECOMMIT_GATES' dn.out", out, sizeof out, 1);
    ck(has(out, "DRC=1/1\n") && has(out, "D_SAME\n") && !has(out, "DREAL=0\n") && has(out, "DREAL=") && has(out, "PRECOMMIT_GATES\tnot_affected=4\tna=cx,runlist,facts,ledger\tsource=table\n"), "reuse.manifest-verdict-as-base");
    {   const char *a = tx_find(out, tx_len(out, sizeof out), "DL=", 3) >= 0 ? out + tx_find(out, tx_len(out, sizeof out), "DL=", 3) + 3 : "", *b = tx_find(out, tx_len(out, sizeof out), "BL=", 3) >= 0 ? out + tx_find(out, tx_len(out, sizeof out), "BL=", 3) + 3 : "x";
        long al = tx_chr(a, tx_len(a, 400), '\n'), bl = tx_chr(b, tx_len(b, 400), '\n');
        ck(al > 10 && al == bl && tx_same(a, al, b, bl), "reuse.manifest-line-as-base"); }
    ck(has(out, "ERC=1\n") && has(out, "EMSG=1\n") && has(out, "EFAKE=1\n") && has(out, "EREAL=0\n"), "reuse.matching-key-judges-record-without-rerun");
    ck(has(out, "FRC=1\n") && has(out, "FMSG=1\n") && has(out, "FFAKE=0\n") && has(out, "F_SAME\n"), "reuse.other-tree-reruns");
    if (failed) sy_printf("%s\n", out);
    /* end to end: commit-own --registered runs reg-manifest once, the hook's precommit reuses it */
    /* since 8b61e66fe1 commit-own runs the hook with a private gate root as cwd and removes that root afterwards,
       so the hook's stderr goes to an absolute path in the fixture, not to a cwd-relative hook.err; and the hook's
       gates see only the private index, so the batch's check source is committed with its set (--whole), as a real
       registration must (the runlist gate refuses metadata-schema missing-implemented-source otherwise) */
    sh("git rm -q --cached tests/manifests/zzg1.tsv; printf '#!/bin/sh\\nexec sh ./unisacc.com tools/precommit.cx 2>>%s/hook.err\\n' \"$PWD\" > .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit;"
       " extra=$(cat fixture-zzg1.out) && "
       " sh ./unisacc.com tools/commit-own.cx -- -m zzg1 --registered zzg1 $extra --whole tools/check-zzg1.cx --whole tests/tools-compile-sources.tsv > co.out 2>&1; echo CORC=$?; grep -c '^COMMIT_OWN_PHASE' co.out | tr '\\n' ' '; echo phase;"
       " echo HREUSED=$(grep -c 'gate manifest reused' hook.err); echo SUBJ=$(git log -1 --format=%s); ls \"${TMPDIR:-/tmp}\"/commit-own-*.gate 2>/dev/null | wc -l | tr '\\n' ' '; echo leftover", out, sizeof out, 1);
    ck(has(out, "CORC=0\n") && has(out, "SUBJ=zzg1\n") && has(out, "HREUSED=1\n"), "reuse.commit-own-record-reused-by-hook");
    if (failed) sy_printf("%s\n", out);
}

/* toolsreg: a staged new tools/zzt.cx without its tools-compile-sources.tsv row is refused by name; with the row
 * staged it passes; the registry row left unstaged
 * is still refused (the gate judges the staged tables); a staged delete of a registered tool whose row stays is refused by name,
 * with the row removed it passes.  "Passes" means this gate: a bare new tool is still blocked by the cx gate's
 * new-tool rules (check and batch), which this group does not judge; deletes run no cx gate, so there rc 0. */
/* PART: 0 = every case (--cases toolsreg, not a batch), 1 = the unregistered add cases (toolsreg-a), 2 = the
 * registered add case (toolsreg-b), 3 = the delete cases (toolsreg-c).  toolsreg-b and toolsreg-c first bring the
 * fixture to the state the earlier steps leave (tools/zzt.cx and its row staged), without running precommit, so
 * their steps see the same index as in the whole run. */
static void group_toolsreg(int part) {
    static char out[16384], sa[2000], sr[1000], sb[2000];
    const char *pc = "sh ./unisacc.com tools/precommit.cx > p.out 2>&1; echo";
    const char *preb = "printf 'int main(void) { return 0; }\\n' > tools/zzt.cx; rm -f r1 r2; printf 'tools/zzt.cx" T "regular\\n' >> tests/tools-compile-sources.tsv;"
                       " git add tools/zzt.cx tests/tools-compile-sources.tsv;";
    char c[4000];
    if (cx_fmt(sa, sizeof sa,
       "printf 'int main(void) { return 0; }\\n' > tools/zzt.cx; rm -f r1 r2;"
       " git add tools/zzt.cx; %s ARC=$?; echo AMSG=$(grep -c 'BLOCKED tools-compile registry REFUSE added" T "tools/zzt.cx' p.out);"
       " echo AHINT=$(grep -c 'tools/register.cx -- --tool tools/NAME.cx' p.out);"
       " cp tools/zzt.cx zzt.keep; sh ./unisacc.com tests/tools-compile.cx -- --register . \"$PWD/tools/zzt.cx\" > tc.out 2>&1; echo TRC=$?;"
       " echo TMSG=$(grep -c 'REFUSE --register would overwrite existing.*tools/register.cx -- --tool' tc.out); cmp -s tools/zzt.cx zzt.keep && echo TKEEP=1;"
       " sh ./unisacc.com tests/tools-compile.cx -- --register . \"$PWD/tools/zzt.cx\" --force > tc.out 2>&1; echo FRC=$?; cmp -s tools/zzt.cx zzt.keep && echo FKEEP=1; rm -f zzt.keep tc.out;"
       " printf 'tools/zzt.cx" T "regular\\n' >> tests/tools-compile-sources.tsv; %s URC=$?; echo UMSG=$(grep -c 'BLOCKED tools-compile registry REFUSE added" T "tools/zzt.cx' p.out);",
       pc, pc)) die("script");
    if (cx_fmt(sr, sizeof sr,
       " git add tests/tools-compile-sources.tsv; %s BRC=$?; echo BMSG=$(grep -c 'BLOCKED tools' p.out); grep '^PRECOMMIT_GATES' p.out | sed 's/^/B_/';",
       pc)) die("script");
    if (cx_fmt(sb, sizeof sb,
       " git commit -qm zzt --no-verify; git rm -q tools/zzt.cx; %s CRC=$?; echo CMSG=$(grep -c 'BLOCKED tools-compile registry REFUSE removed" T "tools/zzt.cx' p.out);"
       " grep -v '^tools/zzt.cx' tests/tools-compile-sources.tsv > tcs.tmp; mv tcs.tmp tests/tools-compile-sources.tsv; git add tests/tools-compile-sources.tsv; %s DRC=$?; echo DMSG=$(grep -c 'BLOCKED tools' p.out)",
       pc, pc)) die("script");
    if (cx_fmt(c, sizeof c, "%s%s%s", part >= 2 ? preb : sa, part == 0 || part == 2 ? sr : "", part == 0 || part == 3 ? sb : "")) die("script");
    sh(c, out, sizeof out, 1);
    if (part == 0 || part == 1) {
        ck(has(out, "ARC=1\n") && has(out, "AMSG=1\n"), "toolsreg.added-unregistered-refused-by-name");
        ck(has(out, "URC=1\n") && has(out, "UMSG=1\n"), "toolsreg.unstaged-registry-row-judged-by-index");
        ck(has(out, "AHINT=") && !has(out, "AHINT=0\n"), "toolsreg.blocked-hint-names-register-tool");
        ck(has(out, "TRC=2\n") && has(out, "TMSG=1\n") && has(out, "TKEEP=1\n"), "toolsreg.tools-compile-register-refuses-existing-source");
        ck(has(out, "FRC=2\n") && has(out, "FKEEP=1\n"), "toolsreg.tools-compile-register-force-refuses-non-registry");
    }
    if (part == 0 || part == 2)
        ck(has(out, "BRC=") && has(out, "BMSG=0\n") && has(out, "B_PRECOMMIT_GATES") && !has(out, "toolsreg,") && !has(out, ",toolsreg\t"), "toolsreg.added-registered-passes");
    if (part == 0 || part == 3) {
        ck(has(out, "CRC=1\n") && has(out, "CMSG=1\n"), "toolsreg.deleted-still-registered-refused-by-name");
        ck(has(out, "DRC=0\n") && has(out, "DMSG=0\n"), "toolsreg.deleted-unregistered-passes");
    }
    if (failed) sy_printf("%s\n", out);
}

/* toolsreg-d: the gate judges the work-tree root, not the cwd.  A fixture repo (GIT_DIR/GIT_WORK_TREE at a scratch
 * repo with no tests/tools-compile.cx, hook run from this fixture whose cwd has one) with an unregistered new
 * tools/x.cx is not judged by toolsreg (TOOLSREG skipped=1, no BLOCKED tools-compile); the same unregistered add in
 * this fixture (its root has tests/tools-compile.cx) is still refused by name. */
static void group_toolsreg_d(void) {
    static char out[16384];
    sh("n=$(mktemp -d) && git -C \"$n\" init -q && mkdir \"$n/tools\" && printf 'int main(void) { return 0; }\\n' > \"$n/tools/x.cx\" && git -C \"$n\" add tools/x.cx;"
       " GIT_DIR=\"$n/.git\" GIT_WORK_TREE=\"$n\" sh ./unisacc.com tools/precommit.cx > p.out 2>&1; echo NRC=$?; rm -rf \"$n\";"
       " echo NSKIP=$(grep -c 'TOOLSREG skipped=1' p.out); echo NHARD=$(grep -c 'BLOCKED tools-compile' p.out);"
       " printf 'int main(void) { return 0; }\\n' > tools/x.cx; git add tools/x.cx; sh ./unisacc.com tools/precommit.cx > p.out 2>&1; echo RRC=$?;"
       " echo RMSG=$(grep -c 'BLOCKED tools-compile registry REFUSE added" T "tools/x.cx' p.out); echo RSKIP=$(grep -c 'TOOLSREG skipped' p.out)", out, sizeof out, 1);
    ck(has(out, "NSKIP=1\n") && has(out, "NHARD=0\n"), "toolsreg.fixture-repo-unregistered-add-not-judged");
    ck(has(out, "RRC=1\n") && has(out, "RMSG=1\n") && has(out, "RSKIP=0\n"), "toolsreg.real-repo-unregistered-add-still-refused");
    if (failed) sy_printf("%s\n", out);
}

static void bench(const char *which) {
    static char out[8192], c[6000]; int after = tx_eqz(which, "after"), i; long t0;
    static const char *name[5] = {"b1-whole-txt", "b2-whole-doc", "b3-whole-cx", "b4-registered-plus-whole-table", "b5-registered"};
    static const char *prep[5] = {"printf 'b\\n' > zz-b1.txt;", "printf 'zz bench\\n' >> plans/devsvc.md;", "printf '/* zz bench */\\n' >> tools/own-diff.cx;", "mk zzb4;", "mk zzb5;"};
    static const char *args[5] = {"-m b1 --whole zz-b1.txt", "-m b2 --whole plans/devsvc.md", "-m b3 --whole tools/own-diff.cx", "-m b4 --registered zzb4 --whole tests/batches.tsv", "-m b5 --registered zzb5"};
    if (cx_fmt(c, sizeof c, "printf '#!/bin/sh\\nexec sh ./unisacc.com tools/precommit%s.cx\\n' > .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit;"
                            " printf 'w\\n' > zz-warm.txt; sh ./unisacc.com tools/commit-own%s.cx -- -m warm --whole zz-warm.txt | tail -1; uptime", after ? "" : "-base", after ? "" : "-base")) die("script");
    sh(c, out, sizeof out, 1);
    sy_printf("BENCH\t%s\twarm\n%s\n", which, out);
    for (i = 0; i < 5; i++) {
        if (cx_fmt(c, sizeof c, "%s%s sh ./unisacc.com tools/commit-own%s.cx -- %s > bench.out 2>&1; echo RC=$?; grep '^COMMIT_OWN_PHASE' bench.out; grep -c 'reused' bench.out", PCG_MK, prep[i], after ? "" : "-base", args[i])) die("script");
        t0 = sy_now_ms();
        sh(c, out, sizeof out, 1);
        sy_printf("BENCH\t%s\t%s\tms=%ld\n%s\n", which, name[i], sy_now_ms() - t0, out);
    }
}

/* PC: commit gate evaluates staged tree only (immune to unstaged foreign edits in shared worktree). */
static void group_tree_isolate(void) {
    char out[16384], cmd[4096], root[2048], tmp[256];
    if (sy_realpath(".", root, sizeof root) < 0) { ck(0, "tree-isolate.realpath"); return; }
    if (cx_fmt(tmp, sizeof tmp, "%s/pc-iso-%d-%ld", sy_tmpdir(), sy_pid(), sy_now_ms() % 100000L)) { ck(0, "tree-isolate.tmp"); return; }
    if (cx_fmt(cmd, sizeof cmd,
        "mkdir -p '%s/repo/tools' '%s/repo/archive' '%s/isotmp' '%s/nogit' && "
        "sh '%s/unisacc.com' -o '%s/pc.bin' '%s/tools/precommit.cx' && "
        "git -C '%s/repo' init -q && git -C '%s/repo' config user.email t@t && git -C '%s/repo' config user.name t && "
        "ln -s '%s/unisacc.com' '%s/repo/unisacc.com' && "
        "printf 'int main(void){FILE*fa=fopen(\"archive/old.md\",\"r\");if(!fa){printf(\"  cxraw: a.cx archive-missing\\\\nRATCHETS\\\\tok=0\\\\tfail=1\\\\n\");return 1;}fclose(fa);FILE*f=fopen(\"other.cx\",\"r\");char b[256]={0};if(f){fread(b,1,255,f);fclose(f);}if(strstr(b,\"DIRTY_FOREIGN\")){printf(\"  cxraw: a.cx has dirty worktree bleed\\\\nRATCHETS\\\\tok=0\\\\tfail=1\\\\n\");return 1;}printf(\"RATCHETS\\\\tok=1\\\\tfail=0\\\\n\");return 0;}\\n' > '%s/repo/tools/ratchets.cx' && "
        "printf 'historical doc\\n' > '%s/repo/archive/old.md' && "
        "printf 'int ok(void){return 0;}\\n' > '%s/repo/a.cx' && "
        "printf 'int clean(void){return 1;}\\n' > '%s/repo/other.cx' && "
        "git -C '%s/repo' add a.cx other.cx archive/old.md tools/ratchets.cx && git -C '%s/repo' commit -q -m init && "
        "printf 'int ok(void){return 2;}\\n' > '%s/repo/a.cx' && git -C '%s/repo' add a.cx && "
        "printf '/* DIRTY_FOREIGN */\\n' > '%s/repo/other.cx' && "
        "(cd '%s/repo' && TMPDIR='%s/isotmp' UNISACC_PRECOMMIT_IN_TREE=0 UNISACC_PRECOMMIT_SERIAL=1 '%s/pc.bin' > '%s/g1.out' 2>&1; echo G1RC=$?; cat '%s/g1.out') && "
        "test -z \"$(ls -d '%s/isotmp'/precommit-tree.* 2>/dev/null)\" && echo ISO_CLEAN=0 || echo ISO_CLEAN=1 && "
        "(cd '%s/repo' && UNISACC_PRECOMMIT_NO_ISOLATE=1 UNISACC_PRECOMMIT_SERIAL=1 '%s/pc.bin' > '%s/n1.out' 2>&1; echo N1RC=$?; grep 'dirty worktree bleed' '%s/n1.out' || true) && "
        "(cd '%s/nogit' && UNISACC_PRECOMMIT_SERIAL=1 '%s/pc.bin' > '%s/ng.out' 2>&1; echo NGRC=$?; cat '%s/ng.out') && "
        "git -C '%s/repo' add other.cx && "
        "(cd '%s/repo' && UNISACC_PRECOMMIT_SERIAL=1 '%s/pc.bin' > '%s/s1.out' 2>&1; echo S1RC=$?; grep -E 'PRECOMMIT|PRECOMMIT_GATE_FAIL' '%s/s1.out' || true); "
        "rm -rf '%s'",
        tmp, tmp, tmp, tmp, root, tmp, root, tmp, tmp, tmp, root, tmp, tmp, tmp, tmp, tmp, tmp, tmp, tmp, tmp, tmp,
        tmp, tmp, tmp, tmp, tmp,
        tmp,
        tmp, tmp, tmp, tmp,
        tmp, tmp, tmp, tmp,
        tmp, tmp, tmp, tmp, tmp, tmp)) {
        ck(0, "tree-isolate.fmt"); return;
    }
    sh(cmd, out, sizeof out, 0);
    ck(has(out, "G1RC=0\n") && has(out, "PRECOMMIT\tstaged_cx=1\tblocked=0\n"), "tree-isolate.full-tree-with-archive-and-foreign-ignored");
    ck(has(out, "ISO_CLEAN=0\n"), "tree-isolate.temp-dir-cleaned");
    ck(has(out, "N1RC=1\n") && has(out, "dirty worktree bleed"), "tree-isolate.no-isolate-control-fails");
    ck(has(out, "NGRC=1\n") && has(out, "PRECOMMIT_GATE_FAIL\tgate=isolate\treason=staged-tree-setup\n"), "tree-isolate.non-git-fails-closed-with-gate");
    ck(has(out, "S1RC=1\n") && has(out, "PRECOMMIT\tstaged_cx=2\tblocked=1\n") &&
       has(out, "PRECOMMIT_GATE_FAIL\tgate=ratchets\treason=ratchet-over\n"), "tree-isolate.staged-dirty-blocked-with-gate-reason");
}

/* PC: commit-own reclaims stale slot index locks (0-byte no-holder, dead PID, btime mismatch, expired)
 * and never removes an active lock held by a live process within deadline. */
static void group_stale_lock(void) {
    char out[16384], cmd[2048], root[2048], tmp[256];
    if (sy_realpath(".", root, sizeof root) < 0) { ck(0, "stale-lock.realpath"); return; }
    if (cx_fmt(tmp, sizeof tmp, "%s/pc-slk-%d-%ld", sy_tmpdir(), sy_pid(), sy_now_ms() % 100000L)) { ck(0, "stale-lock.tmp"); return; }

    /* Setup repo + compile commit-own once */
    if (cx_fmt(cmd, sizeof cmd,
        "mkdir -p '%s/repo' '%s/t1' '%s/t2' '%s/t3' '%s/t4' '%s/t5' && "
        "sh '%s/unisacc.com' -o '%s/co.bin' '%s/tools/commit-own.cx' && "
        "git -C '%s/repo' init -q && git -C '%s/repo' config user.email t@t && git -C '%s/repo' config user.name t && "
        "ln -s '%s/unisacc.com' '%s/repo/unisacc.com' && "
        "printf 'int ok(void){return 0;}\\n' > '%s/repo/a.cx' && git -C '%s/repo' add a.cx && git -C '%s/repo' commit -q -m init && "
        "printf 'int ok(void){return 2;}\\n' > '%s/repo/a.cx' && "
        "printf '#!/bin/sh\\nexit 0\\n' > '%s/repo/.git/hooks/pre-commit' && chmod +x '%s/repo/.git/hooks/pre-commit'",
        tmp, tmp, tmp, tmp, tmp, tmp, root, tmp, root, tmp, tmp, tmp, root, tmp, tmp, tmp, tmp, tmp, tmp, tmp)) {
        ck(0, "stale-lock.setup-fmt"); return;
    }
    if (sh(cmd, out, sizeof out, 0) != 0) { ck(0, "stale-lock.setup"); return; }

    /* T1: 0-byte no-holder */
    cx_fmt(cmd, sizeof cmd,
        ": > '%s/t1/commit-own-s0.idx.lock' && "
        "(cd '%s/repo' && TMPDIR='%s/t1' UNISACC_COMMIT_OWN_RUN=1 '%s/co.bin' -m t1 --whole a.cx --dry-run > '%s/o1' 2>&1; echo T1RC=$?; cat '%s/o1')",
        tmp, tmp, tmp, tmp, tmp, tmp);
    sh(cmd, out, sizeof out, 0);
    ck(has(out, "T1RC=0\n") && has(out, "reason=no-holder\n"), "stale-lock.zero-byte-no-holder-reclaimed");

    /* T2: dead PID holder */
    cx_fmt(cmd, sizeof cmd,
        "BT=0; while read -r k v _; do [ \"$k\" = btime ] && { BT=\"$v\"; break; }; done </proc/stat; FUT=$(($(date +%%s)+300)); "
        ": > '%s/t2/commit-own-s0.idx.lock' && printf 'pid=999999\\tbtime=%%s\\tdeadline_s=%%s\\n' \"$BT\" \"$FUT\" > '%s/t2/commit-own-s0.owner' && "
        "(cd '%s/repo' && TMPDIR='%s/t2' UNISACC_COMMIT_OWN_RUN=1 '%s/co.bin' -m t2 --whole a.cx --dry-run > '%s/o2' 2>&1; echo T2RC=$?; cat '%s/o2')",
        tmp, tmp, tmp, tmp, tmp, tmp, tmp);
    sh(cmd, out, sizeof out, 0);
    ck(has(out, "T2RC=0\n") && has(out, "reason=holder-dead\n"), "stale-lock.dead-pid-reclaimed");

    /* T3: btime mismatch */
    cx_fmt(cmd, sizeof cmd,
        "FUT=$(($(date +%%s)+300)); "
        ": > '%s/t3/commit-own-s0.idx.lock' && printf 'pid=%%s\\tbtime=1\\tdeadline_s=%%s\\n' \"$$\" \"$FUT\" > '%s/t3/commit-own-s0.owner' && "
        "(cd '%s/repo' && TMPDIR='%s/t3' UNISACC_COMMIT_OWN_RUN=1 '%s/co.bin' -m t3 --whole a.cx --dry-run > '%s/o3' 2>&1; echo T3RC=$?; cat '%s/o3')",
        tmp, tmp, tmp, tmp, tmp, tmp, tmp);
    sh(cmd, out, sizeof out, 0);
    ck(has(out, "T3RC=0\n") && has(out, "reason=btime-mismatch\n"), "stale-lock.btime-mismatch-reclaimed");

    /* T4: expired deadline */
    cx_fmt(cmd, sizeof cmd,
        "BT=0; while read -r k v _; do [ \"$k\" = btime ] && { BT=\"$v\"; break; }; done </proc/stat; "
        ": > '%s/t4/commit-own-s0.idx.lock' && printf 'pid=%%s\\tbtime=%%s\\tdeadline_s=1\\n' \"$$\" \"$BT\" > '%s/t4/commit-own-s0.owner' && "
        "(cd '%s/repo' && TMPDIR='%s/t4' UNISACC_COMMIT_OWN_RUN=1 '%s/co.bin' -m t4 --whole a.cx --dry-run > '%s/o4' 2>&1; echo T4RC=$?; cat '%s/o4')",
        tmp, tmp, tmp, tmp, tmp, tmp, tmp);
    sh(cmd, out, sizeof out, 0);
    ck(has(out, "T4RC=0\n") && has(out, "reason=expired\n"), "stale-lock.expired-reclaimed");

    /* T5: active live holder preserved (commit-own skips s0, uses s1, keeps s0.idx.lock intact) */
    cx_fmt(cmd, sizeof cmd,
        "BT=0; while read -r k v _; do [ \"$k\" = btime ] && { BT=\"$v\"; break; }; done </proc/stat; FUT=$(($(date +%%s)+300)); "
        ": > '%s/t5/commit-own-s0.idx.lock' && "
        "(exec 9>>'%s/t5/commit-own-s0.lock'; flock -n 9; sleep 10) & HP=$!; sleep 0.2; "
        "printf 'pid=%%s\\tbtime=%%s\\tdeadline_s=%%s\\n' \"$HP\" \"$BT\" \"$FUT\" > '%s/t5/commit-own-s0.owner' && "
        "(cd '%s/repo' && TMPDIR='%s/t5' UNISACC_COMMIT_OWN_RUN=1 '%s/co.bin' -m t5 --whole a.cx --dry-run > '%s/o5' 2>&1; echo T5RC=$?; cat '%s/o5'); "
        "test -f '%s/t5/commit-own-s0.idx.lock' && echo T5_KEPT=1 || echo T5_KEPT=0; "
        "kill -9 $HP 2>/dev/null || true; wait $HP 2>/dev/null || true; "
        "rm -rf '%s'",
        tmp, tmp, tmp, tmp, tmp, tmp, tmp, tmp, tmp, tmp);
    sh(cmd, out, sizeof out, 0);
    ck(has(out, "T5RC=0\n") && has(out, "T5_KEPT=1\n"), "stale-lock.active-holder-preserved");
}

int main(int argc, char **argv) {
    if (argc == 3 && tx_eqz(argv[1], "--fixture-register-tool")) return pcg_fixture_register(argv[2]);
    if (argc == 4 && tx_eqz(argv[1], "--fixture-batch")) return pcg_fixture_batch(argv[2],argv[3]);
    if (argc == 4 && tx_eqz(argv[1], "--prepare")) {
        if (strspn(argv[2], "abcdefghijklmnopqrstuvwxyz-") != strlen(argv[2])) return 2;
        const char *command = tx_eqz(argv[3], "register") ?
            "sh ./unisacc.com tools/register.cx -- --tool tools/commit-own-base.cx" :
            tx_eqz(argv[3], "packages") ? "sh ./unisacc.com tools/batch-packages-gen.cx -- --write" : 0;
        if (!command) return 2;
        setup(argv[2]);
        char output[16384]; int prepared_rc = sh(command, output, sizeof output, 1);
        if (prepared_rc) sy_eprintf("%s", output);
        else sy_printf("PREPARED\tfixture=%s\ttool=%s\tno-test-result\n", argv[2], argv[3]);
        unlock(); return prepared_rc;
    }
    const char *group = 0, *bn = 0; int a; long t0 = sy_now_ms();
    for (a = 1; a < argc; a++) {
        if (tx_eqz(argv[a], "--cases") && a + 1 < argc) group = argv[++a];
        else if (tx_eqz(argv[a], "--bench") && a + 1 < argc) bn = argv[++a];
        else { sy_eprintf("check-precommit-gates: usage: check-precommit-gates.cx -- --cases na|reuse|toolsreg|toolsreg-a|toolsreg-b|toolsreg-c|toolsreg-d | --bench before|after\n"); return 2; }
    }
    if (bn && (tx_eqz(bn, "before") || tx_eqz(bn, "after"))) { setup("bench"); bench(bn); unlock(); return 0; }
    if (group && (tx_eqz(group, "tree-isolate") || tx_eqz(group, "stale-lock") || tx_eqz(group, "pc"))) {
        if (tx_eqz(group, "tree-isolate") || tx_eqz(group, "pc")) group_tree_isolate();
        if (tx_eqz(group, "stale-lock") || tx_eqz(group, "pc")) group_stale_lock();
        sy_printf("CHECK_PRECOMMIT_GATES\tgroup=%s\tfailed=%d\twall_ms=%ld\n", group, failed, sy_now_ms() - t0);
        return failed ? 1 : 0;
    }
    if (!group || (!tx_eqz(group, "na") && !tx_eqz(group, "reuse") && !tx_eqz(group, "toolsreg") && !tx_eqz(group, "toolsreg-a") && !tx_eqz(group, "toolsreg-b") && !tx_eqz(group, "toolsreg-c") && !tx_eqz(group, "toolsreg-d"))) { sy_eprintf("check-precommit-gates: usage: check-precommit-gates.cx -- --cases na|reuse|toolsreg|toolsreg-a|toolsreg-b|toolsreg-c|toolsreg-d|tree-isolate|stale-lock|pc | --bench before|after\n"); return 2; }
    setup(group);
    if (tx_eqz(group, "na")) group_na();
    else if (tx_eqz(group, "toolsreg")) group_toolsreg(0);
    else if (tx_eqz(group, "toolsreg-a")) group_toolsreg(1);
    else if (tx_eqz(group, "toolsreg-b")) group_toolsreg(2);
    else if (tx_eqz(group, "toolsreg-c")) group_toolsreg(3);
    else if (tx_eqz(group, "toolsreg-d")) group_toolsreg_d();
    else group_reuse();
    unlock();
    sy_printf("CHECK_PRECOMMIT_GATES\tgroup=%s\tfailed=%d\twall_ms=%ld\n", group, failed, sy_now_ms() - t0);
    return failed ? 1 : 0;
}
