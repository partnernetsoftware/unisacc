/* tools/tapebin-roundtrip.cx -- formats cell tapebin.roundtrip (prd.md:82, docs/tapebin-v1.md acceptance 1-3).
 *   sh ./unisacc.com tools/tapebin-roundtrip.cx -- ROOT ABS_OUT
 * Routes (exec/c/compiler.c:623,754,926,1415): `-S -o X.tape SRC.c`; `-S --tapebin -o X.tapebin X.tape` (origin 0 for a
 * tape input) or `... SRC.c` (origin = this target); `-S -o Y.tape X.tapebin` prints the canonical text (whitespace is
 * not preserved, docs/tapebin-v1.md "接入与兼容"), so text equality is asserted on the canonical form, not on the
 * original `-S` spelling. Per fixture (hand-derived exit code, checked by -run on the C source first):
 *   header: `UTAPEBIN`, major 1, opset 1 (docs/tapebin-v1.md 64-byte header);
 *   encode-stable: the same tape encoded twice gives identical bytes (acceptance 1);
 *   decode-stable: the same tapebin decoded twice gives identical canonical text;
 *   fixed-point: encode(decode(b)) == b (acceptance 3);
 *   canonical-closed: decode(encode(canonical)) == canonical;
 *   c-route-same-records: a tapebin encoded straight from the C source decodes to the same canonical text as the tape
 *     route (bytes may differ only in origin/SOURCE_SHA, which is recorded, not asserted);
 *   execution: -run on .tape, on the tape-route .tapebin and on the C-route .tapebin all exit with the hand value;
 *   refusal: a tapebin with a corrupted magic is refused with rc != 0, empty stdout and the declared diagnostic. */
#pragma unisa use cxlib.netpack

static char root[4096], outdir[4096], product[4400];
static int npass, nfail; static FILE *res;
static void die(const char *s) { fprintf(stderr, "tapebin-roundtrip: REFUSE %s errno=%d\n", s, errno); exit(2); }
static void path(char *p, size_t cap, const char *a, const char *b) { int n = snprintf(p, cap, "%s/%s", a, b); if (n < 0 || (size_t)n >= cap) die("path"); }
static void saved(const char *p, const char *s, size_t n) { int f = open(p, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600); if (f < 0) die("exclusive create"); while (n) { ssize_t k = write(f, s, n); if (k <= 0) die("write"); s += k; n -= (size_t)k; } if (close(f)) die("close"); }
static void check(int ok, const char *fx, const char *label, const char *detail) { fprintf(res, "%s\ttapebin.roundtrip.%s.%s\t%s\n", ok ? "PASS" : "FAIL", fx, label, detail); printf("%s\t%s.%s\n", ok ? "PASS" : "FAIL", fx, label); if (ok) npass++; else nfail++; }
/* product invocation, 20 s bound; returns transport failure */
static int prod(char *const extra[], np_result *r) { char *v[16]; int n = 0; v[n++] = "sh"; v[n++] = product; for (int i = 0; extra[i]; i++) { if (n >= 15) die("argv"); v[n++] = extra[i]; } v[n] = 0; char why[1024]; return np_run(v, root, 0, 20, r, why, sizeof why); }
static int same(const char *a, const char *b, size_t *na_out) { size_t na, nb; char *x = cx_read(a, &na), *y = cx_read(b, &nb); int ok = x && y && na == nb && !memcmp(x, y, na); if (na_out) *na_out = x ? na : 0; free(x); free(y); return ok; }
static int run_rc(const char *input, int *rc, size_t *outn) { char *v[] = { "-run", (char *)input, 0 }; np_result r; if (prod(v, &r)) return 1; *rc = r.rc; *outn = r.outn; np_free(&r); return 0; }
static int compile(const char *out, const char *in, int bin) { char *v[] = { "-S", bin ? "--tapebin" : "-o", bin ? "-o" : (char *)out, bin ? (char *)out : (char *)in, bin ? (char *)in : 0, 0 }; np_result r; if (prod(v, &r)) return 1; int rc = r.rc; np_free(&r); return rc; }

int main(int argc, char **argv) {
    if (argc != 3 || !realpath(argv[1], root) || argv[2][0] != '/') { fputs("usage: ROOT ABS_OUT\n", stderr); return 2; }
    snprintf(outdir, sizeof outdir, "%s", argv[2]); if (mkdir(outdir, 0700)) die("new out dir must be absent"); path(product, sizeof product, root, "unisacc.com");
    char rp[4400]; path(rp, sizeof rp, outdir, "results.tsv"); res = fopen(rp, "wbx"); if (!res) die("results");
    { size_t n; char *b = cx_read(product, &n); if (!b) die("product"); char h[65]; cx_sha256_hex(b, n, h); free(b); fprintf(res, "IDENTITY\tcandidate=%s\n", h); }
    struct { const char *name, *src; int want; } fx[4] = {
        { "arith", "int main(void){int a=3,b=4;return a*b-5;}\n", 7 },
        { "loop", "int main(void){int s=0;for(int i=1;i<=10;i++)s+=i;return s-50;}\n", 5 },
        { "call-str", "static int len(const char*s){int n=0;while(s[n])n++;return n;}\nint main(void){return len(\"tapebin\")+len(\"\");}\n", 7 },
        { "global-bss", "static int g[16];int main(void){g[3]=9;return g[3]+g[4];}\n", 9 } };
    for (int i = 0; i < 4; i++) { const char *fxn = fx[i].name; char c[4400], t[4400], b1[4400], b2[4400], y1[4400], y2[4400], bc[4400], yc[4400], yb[4400], bad[4400], leaf[128]; char d[400]; int rc; size_t on, n1, n2;
        snprintf(leaf, sizeof leaf, "%s.c", fxn); path(c, sizeof c, outdir, leaf); saved(c, fx[i].src, strlen(fx[i].src));
        snprintf(leaf, sizeof leaf, "%s.tape", fxn); path(t, sizeof t, outdir, leaf); snprintf(leaf, sizeof leaf, "%s.1.tapebin", fxn); path(b1, sizeof b1, outdir, leaf); snprintf(leaf, sizeof leaf, "%s.2.tapebin", fxn); path(b2, sizeof b2, outdir, leaf);
        snprintf(leaf, sizeof leaf, "%s.y1.tape", fxn); path(y1, sizeof y1, outdir, leaf); snprintf(leaf, sizeof leaf, "%s.y2.tape", fxn); path(y2, sizeof y2, outdir, leaf); snprintf(leaf, sizeof leaf, "%s.c.tapebin", fxn); path(bc, sizeof bc, outdir, leaf);
        snprintf(leaf, sizeof leaf, "%s.yc.tape", fxn); path(yc, sizeof yc, outdir, leaf); snprintf(leaf, sizeof leaf, "%s.y.tapebin", fxn); path(yb, sizeof yb, outdir, leaf); snprintf(leaf, sizeof leaf, "%s.bad.tapebin", fxn); path(bad, sizeof bad, outdir, leaf);
        /* hand oracle on the C source */
        if (run_rc(c, &rc, &on)) die("run c"); snprintf(d, sizeof d, "rc=%d want=%d", rc, fx[i].want); check(rc == fx[i].want && !on, fxn, "oracle.c-run", d); if (rc != fx[i].want) continue;
        if (compile(t, c, 0) || compile(b1, t, 1) || compile(b2, t, 1) || compile(y1, b1, 0) || compile(y2, b1, 0) || compile(bc, c, 1) || compile(yc, bc, 0) || compile(yb, y1, 1)) { check(0, fxn, "routes.compile", "a route returned non-zero"); continue; }
        { size_t bn, cn; char *b = cx_read(b1, &bn), *z = cx_read(bc, &cn); /* u16 major@8 minor@10 opset@12 flags@14; u32 target@16 header_bytes@24 origin@60 (docs/tapebin-v1.md, exec/c/tapebin.h:114) */
          int hdr = b && bn >= 64 && !memcmp(b, "UTAPEBIN", 8) && b[8] == 1 && !b[9] && !b[10] && !b[11] && b[12] == 1 && !b[13] && !b[14] && !b[15] && !b[16] && !b[17] && !b[18] && !b[19] && b[24] == 64 && !b[25] && !b[26] && !b[27];
          snprintf(d, sizeof d, "bytes=%zu major=%d minor=%d opset=%d flags=%d target=%d header_bytes=%d", bn, b && bn >= 64 ? b[8] : -1, b && bn >= 64 ? b[10] : -1, b && bn >= 64 ? b[12] : -1, b && bn >= 64 ? b[14] : -1, b && bn >= 64 ? b[16] : -1, b && bn >= 64 ? b[24] : -1); check(hdr, fxn, "header.magic-major-minor-opset-target", d);
          int org = b && z && bn >= 64 && cn >= 64 && !b[60] && !b[61] && !b[62] && !b[63] && z[60] == 1 && !z[61] && !z[62] && !z[63]; snprintf(d, sizeof d, "tape-route origin=%d c-route origin=%d (0 = tape input, 1 = lnx/x86_64)", b && bn >= 64 ? b[60] : -1, z && cn >= 64 ? z[60] : -1); check(org, fxn, "origin-target", d); free(b); free(z); }
        check(same(b1, b2, &n1), fxn, "encode-stable", "same tape encoded twice");
        check(same(y1, y2, &n2), fxn, "decode-stable", "same tapebin decoded twice");
        check(same(yb, b1, 0), fxn, "fixed-point.encode-decode-encode", "encode(decode(b)) == b");
        { char yy[4400]; snprintf(leaf, sizeof leaf, "%s.yy.tape", fxn); path(yy, sizeof yy, outdir, leaf); if (compile(yy, yb, 0)) check(0, fxn, "canonical-closed", "decode of re-encoded tapebin failed"); else check(same(yy, y1, 0), fxn, "canonical-closed", "decode(encode(canonical)) == canonical"); }
        { size_t nb, nc; char *x = cx_read(b1, &nb), *z = cx_read(bc, &nc); size_t first = 0; while (x && z && first < nb && first < nc && x[first] == z[first]) first++; snprintf(d, sizeof d, "tape-route %zu bytes, c-route %zu bytes, first differing byte %zu (origin/SOURCE_SHA, recorded)", nb, nc, first); fprintf(res, "INFO\ttapebin.roundtrip.%s.c-route-bytes\t%s\n", fxn, d); free(x); free(z); }
        check(same(yc, y1, 0), fxn, "c-route-same-records", "C-route tapebin decodes to the tape-route canonical text");
        { int r1 = -1, r2 = -1, r3 = -1; size_t o1 = 1, o2 = 1, o3 = 1; int tr = run_rc(t, &r1, &o1) || run_rc(b1, &r2, &o2) || run_rc(bc, &r3, &o3); snprintf(d, sizeof d, "tape rc=%d tapebin rc=%d c-tapebin rc=%d want=%d", r1, r2, r3, fx[i].want); check(!tr && r1 == fx[i].want && r2 == fx[i].want && r3 == fx[i].want && !o1 && !o2 && !o3, fxn, "execution.tape-tapebin-equal", d); }
        { size_t bn; char *b = cx_read(b1, &bn); if (!b) die("read b1"); b[0] = 'X'; saved(bad, b, bn); free(b); char *v[] = { "-S", "-o", "/dev/null", bad, 0 }; np_result r; if (prod(v, &r)) check(0, fxn, "refusal.bad-magic", "transport"); else { int ok = r.rc && !r.outn && r.errn && strstr(r.err, "invalid tapebin or origin target mismatch"); snprintf(d, sizeof d, "rc=%d stdout=%zu", r.rc, r.outn); check(ok, fxn, "refusal.bad-magic", ok ? "rc != 0, empty stdout, declared diagnostic" : d); np_free(&r); } }
    }
    fprintf(res, "SUMMARY\tpass=%d\tfail=%d\n", npass, nfail); fclose(res);
    printf("TAPEBIN_ROUNDTRIP\tpass=%d\tfail=%d\n", npass, nfail); return nfail ? 1 : 0;
}
