/* tools/check-hook-prose.cx -- 对拍 tools/hook-prose.cx 与原用户级 .ts 钩子的输出。
 * 夹具 tests/hook-cases/prose.tsv,每行 6 列:用例名、输入 JSON、期望 rc、期望标准输出、环境(VAR=值,可空)、transcript 内容(可空),
 * 文本列用 %XX 转义(只转 % 制表 换行 回车与控制字节)。输入里的 @AUX@ 换成临时 transcript 文件路径。
 * 期望值由 bun 跑原 .ts 得到;夹具要变先重跑原 .ts,不改期望值迎合实现。每例两种入口:文件参数、stdin 重定向;另测热耗时小于 300 ms。 */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.time
#pragma unisa use sys.posix
#pragma unisa use mem.heap
#pragma unisa use text.text

#define F(dst, cap, ...) do { if (snprintf(dst, cap, __VA_ARGS__) < 0) fputs("", stderr); } while (0)
#define TOOL "tools/hook-prose.cx"
#define FIX "tests/hook-cases/prose.tsv"
#define TMP "/tmp/hook-ck-prose"
static char out[1 << 16];
static int pass_n, fail_n;

static int sh(const char *cmd) {
    char *a[] = {"timeout", "20", "sh", "-c", (char *)cmd, 0};
    return sy_run(a, out, sizeof out, 0);
}
static void ok(const char *name, int cond) {
    printf("%s\t%s\n", cond ? "PASS" : "FAIL", name);
    if (cond) pass_n++; else fail_n++;
}
static int hexv(int c) { return c >= '0' && c <= '9' ? c - '0' : c >= 'A' && c <= 'F' ? c - 'A' + 10 : c >= 'a' && c <= 'f' ? c - 'a' + 10 : -1; }
/* 把 s[0..n) 的 %XX 还原到 dst,返回长度 */
static long unesc(const char *s, long n, char *dst) {
    long i, m = 0;
    for (i = 0; i < n; i++) {
        if (s[i] == '%' && i + 2 < n && hexv(s[i + 1]) >= 0 && hexv(s[i + 2]) >= 0) { dst[m++] = (char)(hexv(s[i + 1]) * 16 + hexv(s[i + 2])); i += 2; }
        else dst[m++] = s[i];
    }
    dst[m] = 0; return m;
}
static int put(const char *p, const char *s, long n) {
    return sy_write_atomic(p, s, n, 0644);
}
static char *rep_aux(const char *in, const char *path, char *dst, int cap) {
    const char *a = 0; long i, il = (long)strlen(in);
    for (i = 0; i + 5 <= il && !a; i++) if (in[i] == 0x40 && in[i + 1] == 0x41 && in[i + 2] == 0x55 && in[i + 3] == 0x58 && in[i + 4] == 0x40) a = in + i;
    if (!a) { F(dst, cap, "%s", in); return dst; }
    F(dst, cap, "%.*s%s%s", (int)(a - in), in, path, a + 5);
    return dst;
}
int main(void) {
    void *fb = 0; long fn = 0; char *p, *end; int cases = 0;
    static char inb[1 << 16], expb[1 << 16], aux[1 << 16], jin[1 << 16];
    sh("mkdir -p " TMP);
    if (sy_read_file(FIX, &fb, &fn, 1L << 24)) { printf("FAIL\topen-fixture\n"); return 1; }
    for (p = fb, end = (char *)fb + fn; p < end; ) {
        char *nl = memchr(p, '\n', end - p), *f[7]; int k = 0, want_rc, got; char env[256], cmd[1400], jf[256], af[256], name[160];
        char *q;
        if (!nl) nl = end;
        if (*p == '#' || nl == p) { p = nl + 1; continue; }
        f[0] = p;
        for (q = p; q < nl && k < 6; q++) if (*q == '\t') { f[++k] = q + 1; }
        if (k < 5) { ok("fixture-cols", 0); p = nl + 1; continue; }
        f[6] = nl + 1;
        F(name, sizeof name, "%.*s", (int)(f[1] - f[0] - 1), f[0]);
        F(jf, sizeof jf, TMP "/%s.json", name); F(af, sizeof af, TMP "/%s.jsonl", name);
        unesc(f[1], f[2] - f[1] - 1, inb); rep_aux(inb, af, jin, sizeof jin);
        put(jf, jin, (long)strlen(jin));
        want_rc = atoi(f[2]);
        unesc(f[3], f[4] - f[3] - 1, expb);
        { long el = f[5] - f[4] - 1; unesc(f[4], el, env); }
        { long al = f[6] - f[5] - 1; if (al > 0) { long m = unesc(f[5], al, aux); aux[m++] = '\n'; put(af, aux, m); } }
        F(cmd, sizeof cmd, "%s sh ./unisacc.com %s -- %s", env, TOOL, jf);
        got = sh(cmd);
        ok(name, got == want_rc && !strcmp(out, expb));
        F(cmd, sizeof cmd, "%s sh ./unisacc.com %s < %s", env, TOOL, jf);
        got = sh(cmd);
        { char nm[200]; F(nm, sizeof nm, "%s(stdin)", name); ok(nm, got == want_rc && !strcmp(out, expb)); }
        cases++; p = nl + 1;
    }
    ok("cases>=20", cases >= 20);
    {
        long t0, t1; char cmd[400];
        F(cmd, sizeof cmd, "sh ./unisacc.com %s -- %s/long.json >/dev/null", TOOL, TMP);
        sh(cmd); t0 = sy_now_ms(); sh(cmd); t1 = sy_now_ms();
        printf("HOT_MS\t%ld\n", t1 - t0);
        ok("hot<300ms", t1 - t0 < 300);
    }
    printf("total=%d failed=%d\n", pass_n + fail_n, fail_n);
    printf("%s\n", fail_n ? "HOOK_CHECK FAIL" : "HOOK_CHECK");
    return fail_n != 0;
}
