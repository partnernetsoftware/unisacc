/* tools/status.cx -- one-command status summary (git, chain, derive, batches, residue) as TSV rows.
 *
 *   sh ./unisacc.com tools/status.cx -- [--tsv OUT] [--fast] [--section git,chain,derive,batches,residue]
 *        [--root DIR] [--tmp DIR] [--no-fetch] [--git-bin PATH] [--git-secs N] [--pg-pat STR]
 *
 * Rows: section<TAB>key<TAB>value<TAB>age_s<TAB>source.  Last line: STATUS ok=N warn=N stale=N
 * (UNMEASURED items count as warn; age over the section's limit counts as stale).  Read-only: nothing is
 * deleted or repaired.  Every child process runs under np_run with a deadline.  Full mode (no --fast) also
 * runs tool-index, iface-hash, tables-gen --check in parallel, each under tools/bound 20. */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.time
#pragma unisa use sys.env
#pragma unisa use sys.posix
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use sysx.process

static int n_ok, n_warn, n_stale;
static FILE *tsv;
static const char *g_root = ".", *g_tmp, *g_git = "git", *g_pg = "candidate-chain.cx --rev", *g_secs_s;
static int g_git_secs = 8, g_fetch = 1;

static int streq(const char *a, const char *b) { while (*a && *a == *b) { a++; b++; } return *a == *b; }
static int starts(const char *s, const char *p) { while (*p) { if (*s != *p) return 0; s++; p++; } return 1; }
static long slen(const char *s) { long n = 0; while (s[n]) n++; return n; }
/* 1 when NEEDLE occurs in H[0..n) -- plain byte loop, no library search */
static int has(const char *h, long n, const char *nd) {
    long m = slen(nd), i, j;
    for (i = 0; i + m <= n; i++) { for (j = 0; j < m && h[i + j] == nd[j]; j++) ; if (j == m) return 1; }
    return 0;
}
static long count_of(const char *h, long n, const char *nd) {
    long m = slen(nd), i, j, c = 0;
    if (m == 0) return 0;
    for (i = 0; i + m <= n; ) { for (j = 0; j < m && h[i + j] == nd[j]; j++) ; if (j == m) { c++; i += m; } else i++; }
    return c;
}
static int line_count(const char *s, long n) { long i; int c = 0; for (i = 0; i < n; i++) if (s[i] == '\n') c++; if (n > 0 && s[n - 1] != '\n') c++; return c; }

/* cls 0 ok, 1 warn, 2 stale */
static void emit(const char *sec, const char *key, const char *val, long age, const char *src, int cls) {
    char v[600]; long i = 0;
    for (; val[i] && i < 590; i++) v[i] = (val[i] == '\t' || val[i] == '\n' || val[i] == '\r') ? ' ' : val[i];
    v[i] = 0;
    if (cls == 0) n_ok++; else if (cls == 1) n_warn++; else n_stale++;
    if (age >= 0) { printf("%s\t%s\t%s\t%ld\t%s\n", sec, key, v, age, src); if (tsv) fprintf(tsv, "%s\t%s\t%s\t%ld\t%s\n", sec, key, v, age, src); }
    else { printf("%s\t%s\t%s\t-\t%s\n", sec, key, v, src); if (tsv) fprintf(tsv, "%s\t%s\t%s\t-\t%s\n", sec, key, v, src); }
}
static void unmeasured(const char *sec, const char *key, const char *why, const char *src) {
    char b[300]; cx_fmt(b, sizeof b, "UNMEASURED: %s", why); emit(sec, key, b, -1, src, 1);
}

/* run ARGV under np_run; 0 on rc 0 with *out set (never NULL, caller frees via mm_free), else -1 */
static int runcap(char **argv, const char *cwd, int secs, char **out, long *outn) {
    np_result r = {0}; char why[256] = {0}; int tr = np_run(argv, cwd, 0, secs, &r, why, sizeof why), ok;
    ok = !tr && !r.residue && r.rc == 0;
    *out = mm_alloc((long)r.outn + 1); *outn = 0;
    if (*out) { long i; for (i = 0; i < (long)r.outn; i++) (*out)[i] = r.out[i]; (*out)[r.outn] = 0; *outn = (long)r.outn; }
    np_free(&r);
    return ok && *out ? 0 : -1;
}

static long file_age(const char *p, long *mt) {
    sy_stat_t st; long now = sy_wall_s();
    if (sy_stat(p, &st) != 0) return -1;
    if (mt) *mt = st.mtime;
    return now > st.mtime ? now - st.mtime : 0;
}
static char *slurp_file(const char *p, long *n) {
    size_t k = 0; char *b = cx_read(p, &k); *n = (long)k; return b;
}
static long first_digits(const char *b, long n) {   /* first line made only of digits, as a number; -1 if none */
    long at = 0;
    while (at < n) {
        long e = at, v = 0; int dig = 1;
        while (e < n && b[e] != '\n') { if (b[e] < '0' || b[e] > '9') dig = 0; else v = v * 10 + (b[e] - '0'); e++; }
        if (dig && e > at) return v;
        at = e + 1;
    }
    return -1;
}

/* ---------------- git ---------------- */
static void sec_git(void) {
    char *o; long n; char lock[4400], stp[4400], buf[300], cmd[8][300]; char *v[8]; int i;
    const char *S = "git";
    (void)cmd;
    if (g_fetch) {
        v[0] = (char *)g_git; v[1] = "fetch"; v[2] = "-q"; v[3] = 0;
        if (runcap(v, g_root, g_git_secs, &o, &n) != 0) unmeasured(S, "fetch", "git fetch -q failed or timed out", "git fetch -q");
        else emit(S, "fetch", "ok", -1, "git fetch -q", 0);
        mm_free(o);
    }
    v[0] = (char *)g_git; v[1] = "log"; v[2] = "--oneline"; v[3] = "HEAD..origin/main"; v[4] = 0;
    if (runcap(v, g_root, g_git_secs, &o, &n) != 0) unmeasured(S, "behind", "git log HEAD..origin/main failed or timed out", "git log HEAD..origin/main");
    else {
        int c = line_count(o, n); long e = 0; char first[200];
        while (e < n && o[e] != '\n' && e < 190) { first[e] = o[e]; e++; }
        first[e] = 0;
        cx_fmt(buf, sizeof buf, "%d%s%s", c, c ? " first: " : "", first);
        emit(S, "behind", buf, -1, "git log HEAD..origin/main", c ? 1 : 0);
    }
    mm_free(o);
    v[0] = (char *)g_git; v[1] = "rev-list"; v[2] = "--count"; v[3] = "origin/main..HEAD"; v[4] = 0;
    if (runcap(v, g_root, g_git_secs, &o, &n) != 0) unmeasured(S, "ahead", "git rev-list --count failed or timed out", "git rev-list --count origin/main..HEAD");
    else { while (n > 0 && (o[n - 1] == '\n' || o[n - 1] == ' ')) o[--n] = 0; emit(S, "ahead", o, -1, "git rev-list --count origin/main..HEAD", 0); }
    mm_free(o);
    v[0] = (char *)g_git; v[1] = "status"; v[2] = "--porcelain"; v[3] = 0;
    if (runcap(v, g_root, g_git_secs, &o, &n) != 0) unmeasured(S, "worktree", "git status --porcelain failed or timed out", "git status --porcelain");
    else {
        long at = 0; int st = 0, un = 0, ut = 0;
        while (at < n) {
            long e = at; while (e < n && o[e] != '\n') e++;
            if (e - at >= 2) {
                if (o[at] == '?' && o[at + 1] == '?') ut++;
                else { if (o[at] != ' ') st++; if (o[at + 1] != ' ') un++; }
            }
            at = e + 1;
        }
        cx_fmt(buf, sizeof buf, "staged=%d unstaged=%d untracked=%d", st, un, ut);
        emit(S, "worktree", buf, -1, "git status --porcelain", 0);
    }
    mm_free(o);
    (void)i;
    cx_fmt(lock, sizeof lock, "%s/.git/index.lock", g_root);
    {   long a = file_age(lock, 0);
        if (a >= 0) { cx_fmt(buf, sizeof buf, "present (report only, not removed)"); emit(S, "index.lock", buf, a, lock, a > 300 ? 2 : 1); }
        else emit(S, "index.lock", "absent", -1, lock, 0);
    }
    cx_fmt(stp, sizeof stp, "%s/.git/logs/refs/stash", g_root);
    {   sy_stat_t sst; int rc = sy_stat(stp, &sst);
        if (rc == -ENOENT) emit(S, "stash", "0", -1, stp, 0);
        else if (rc != 0) unmeasured(S, "stash", "cannot stat stash log", stp);
        else { long k; char *b = slurp_file(stp, &k); if (!b) unmeasured(S, "stash", "cannot read stash log", stp); else { cx_fmt(buf, sizeof buf, "%d", line_count(b, k)); emit(S, "stash", buf, -1, stp, 0); } }
    }
}

/* ---------------- tmp directory scan ---------------- */
#define MAXN 600
typedef struct { char name[120]; long mt; } Ent;
static Ent ents[MAXN];
static int nents;
static void scan(const char *dir, const char *prefix) {
    sy_dir_t d; nents = 0;
    if (sy_dir_open(&d, dir) != 0) return;
    while (sy_dir_next(&d) == 1 && nents < MAXN) {
        if (starts(d.name, prefix) && d.name_n < 118) {
            char p[4400]; sy_stat_t st;
            cx_fmt(p, sizeof p, "%s/%s", dir, d.name);
            if (sy_stat(p, &st) != 0) continue;
            { long i; for (i = 0; i <= d.name_n; i++) ents[nents].name[i] = d.name[i]; }
            ents[nents].mt = st.mtime; nents++;
        }
    }
    sy_dir_close(&d);
}
static void sort_newest(void) {   /* newest mtime first */
    int i, j;
    for (i = 0; i < nents; i++) for (j = i + 1; j < nents; j++) if (ents[j].mt > ents[i].mt) { Ent t = ents[i]; ents[i] = ents[j]; ents[j] = t; }
}

/* ---------------- chain ---------------- */
static void one_chain(const char *sessname, const char *logdir, const char *base, int pgn, int pgknown) {
    char p[4400], key[300], val[600], src[4400]; long n, now = sy_wall_s(), start = -1, end = -1, mt = 0, a;
    char *out; int hasrc = 0, rcv = -1, failed = 0;
    char *lastl = "", *failline = "";
    static char lastbuf[300], failbuf[300];
    cx_fmt(src, sizeof src, "%s/%s.out", logdir, base);
    out = slurp_file(src, &n);
    cx_fmt(key, sizeof key, "%s/%s", sessname, base);
    if (!out) { unmeasured("chain", key, "cannot read .out", src); return; }
    cx_fmt(p, sizeof p, "%s/%s.start", logdir, base);
    { long k; char *b = slurp_file(p, &k); if (b) start = first_digits(b, k); if (start < 0 && file_age(p, &mt) >= 0) start = mt; }
    cx_fmt(p, sizeof p, "%s/%s.end", logdir, base);
    { long k; char *b = slurp_file(p, &k); if (b) end = first_digits(b, k); if (end < 0 && file_age(p, &mt) >= 0) end = mt; }
    cx_fmt(p, sizeof p, "%s/%s.rc", logdir, base);
    { long k; char *b = slurp_file(p, &k); if (b) { long i; hasrc = 1; for (i = 0; i < k; i++) if (b[i] >= '0' && b[i] <= '9') { rcv = 0; while (i < k && b[i] >= '0' && b[i] <= '9') rcv = rcv * 10 + (b[i++] - '0'); break; } } }
    {   long at = 0; lastbuf[0] = 0; failbuf[0] = 0;
        while (at < n) {
            long e = at, i; while (e < n && out[e] != '\n') e++;
            if (e > at) {
                for (i = 0; i < e - at && i < 290; i++) lastbuf[i] = out[at + i];
                lastbuf[i] = 0;
                if (has(out + at, e - at, "REFUSE") || has(out + at, e - at, "FAIL")) { for (i = 0; i < e - at && i < 290; i++) failbuf[i] = out[at + i]; failbuf[i] = 0; failed = 1; }
            }
            at = e + 1;
        }
        lastl = lastbuf; failline = failbuf;
    }
    a = start >= 0 ? ((hasrc && end >= 0 ? end : now) - start) : -1;
    {   const char *state = hasrc ? "done" : (!pgknown ? "unknown" : pgn > 0 ? "running" : "stopped-no-rc");
        long fa = file_age(src, 0);
        cx_fmt(val, sizeof val, "state=%s pids=%d rc=%d elapsed_s=%ld G_LNX_PAIR=%ld last=%s fail=%s",
               state, pgknown ? pgn : -1, rcv, a, count_of(out, n, "G_LNX_PAIR"), lastl, failed ? failline : "-");
        emit("chain", key, val, fa, src, (hasrc && rcv != 0) || (!hasrc && pgknown && pgn == 0) ? 1 : 0);
    }
}
static void sec_chain(void) {
    int pgn = 0, pgknown = 0, s;
    char *o; long n; char *v[5];
    v[0] = "pgrep"; v[1] = "-f"; v[2] = (char *)g_pg; v[3] = 0;
    { np_result r = {0}; char why[256] = {0}; int tr = np_run(v, 0, 0, 5, &r, why, sizeof why);
      if (!tr && !r.residue && (r.rc == 0 || r.rc == 1)) { pgknown = 1; pgn = r.out ? line_count(r.out, (long)r.outn) : 0; }
      np_free(&r); }
    (void)o; (void)n;
    scan(g_tmp, "unisacc-session-build-lr");
    sort_newest();
    if (nents == 0) { unmeasured("chain", "sessions", "no unisacc-session-build-lr* directory", g_tmp); return; }
    for (s = 0; s < nents && s < 3; s++) {
        char ld[4400]; sy_dir_t d; static char names[64][40]; int nn = 0, i, j;
        cx_fmt(ld, sizeof ld, "%s/%s/log", g_tmp, ents[s].name);
        if (sy_dir_open(&d, ld) != 0) { unmeasured("chain", ents[s].name, "cannot open log directory", ld); continue; }
        while (sy_dir_next(&d) == 1 && nn < 64) {
            /* real<digits>.out */
            const char *nm = d.name; long L = d.name_n; int ok = starts(nm, "real") && L > 8 && L < 38 && nm[L - 4] == '.' && nm[L - 3] == 'o' && nm[L - 2] == 'u' && nm[L - 1] == 't';
            for (i = 4; ok && i < L - 4; i++) if (nm[i] < '0' || nm[i] > '9') ok = 0;
            if (ok) { for (i = 0; i < L - 4; i++) names[nn][i] = nm[i]; names[nn][L - 4] = 0; nn++; }
        }
        sy_dir_close(&d);
        for (i = 0; i < nn; i++) for (j = i + 1; j < nn; j++) { long a = slen(names[i]), b = slen(names[j]); int sw = a > b || (a == b && !(names[i][0] == 0) && 0); if (a == b) { int k = 0; while (names[i][k] && names[i][k] == names[j][k]) k++; sw = names[i][k] > names[j][k]; } if (sw) { char t[40]; int k; for (k = 0; k < 40; k++) { t[k] = names[i][k]; names[i][k] = names[j][k]; names[j][k] = t[k]; } } }
        for (i = 0; i < nn; i++) one_chain(ents[s].name, ld, names[i], pgn, pgknown);
    }
}

/* ---------------- derive ---------------- */
static void sec_derive(int fast) {
    char p[4400]; long n; char *b; long age;
    cx_fmt(p, sizeof p, "%s/unisacc-derive-last.tsv", g_tmp);
    b = slurp_file(p, &n); age = file_age(p, 0);
    (void)fast;   /* the full mode reads the same file: tools/derive.cx is not run from here */
    if (!b || age < 0) { unmeasured("derive", "last", "no unisacc-derive-last.tsv (tools/derive.cx not run)", p); return; }
    {   long at = 0; int rows = 0;
        while (at < n) {
            long e = at; while (e < n && b[e] != '\n') e++;
            if (e - at > 7 && starts(b + at, "DERIVE") && (b[at + 6] == '\t' || b[at + 6] == ' ')) {
                char nm[100], stt[100], ms[60]; long i = at + 7, k; int f;
                nm[0] = stt[0] = ms[0] = 0;
                for (f = 0; f < 3; f++) {
                    char *dst = f == 0 ? nm : f == 1 ? stt : ms; k = 0;
                    while (i < e && b[i] != '\t' && b[i] != ' ') { if (k < 90) dst[k++] = b[i]; i++; }
                    dst[k] = 0; while (i < e && (b[i] == '\t' || b[i] == ' ')) i++;
                }
                {   char val[300]; int good = streq(stt, "ok") || streq(stt, "OK") || streq(stt, "PASS") || streq(stt, "FRESH") || streq(stt, "fresh");
                    cx_fmt(val, sizeof val, "%s ms=%s", stt, ms[0] ? ms : "?");
                    emit("derive", nm, val, age, p, !good ? 1 : age > 3600 ? 2 : 0); rows++; }
            }
            at = e + 1;
        }
        if (!rows) unmeasured("derive", "last", "file has no DERIVE rows", p);
    }
}

/* ---------------- batches ---------------- */
static void sec_batches(void) {
    int s; scan(g_tmp, "unisacc-affected-"); sort_newest();
    if (nents == 0) { unmeasured("batches", "sessions", "no unisacc-affected-* directory", g_tmp); return; }
    for (s = 0; s < nents && s < 3; s++) {
        char dp[4400], val[300]; sy_dir_t d; long pass = 0, fail = 0, defer = 0, files = 0, newest = 0; char lastlog[4400];
        cx_fmt(dp, sizeof dp, "%s/%s", g_tmp, ents[s].name); lastlog[0] = 0;
        if (sy_dir_open(&d, dp) != 0) { unmeasured("batches", ents[s].name, "cannot open session directory", dp); continue; }
        while (sy_dir_next(&d) == 1 && files < 400) {
            if (d.name_n > 4 && d.kind == 'f' && d.name[d.name_n - 4] == '.' && d.name[d.name_n - 3] == 'l' && d.name[d.name_n - 2] == 'o' && d.name[d.name_n - 1] == 'g') {
                char fp[4400]; long n, at = 0, mt = 0; char *b; files++;
                cx_fmt(fp, sizeof fp, "%s/%s", dp, d.name);
                b = slurp_file(fp, &n); if (!b) continue;
                file_age(fp, &mt); if (mt >= newest) { newest = mt; cx_fmt(lastlog, sizeof lastlog, "%s", fp); }
                while (at < n) {
                    long e = at; while (e < n && b[e] != '\n') e++;
                    if (starts(b + at, "BATCH_RUN\t")) {
                        if (has(b + at, e - at, "status=PASS")) pass++;
                        else if (has(b + at, e - at, "status=FAIL")) fail++;
                        else if (has(b + at, e - at, "status=DEFERRED")) defer++;
                    }
                    at = e + 1;
                }
            }
        }
        sy_dir_close(&d);
        cx_fmt(val, sizeof val, "PASS=%ld FAIL=%ld DEFERRED=%ld logs=%ld", pass, fail, defer, files);
        emit("batches", ents[s].name, val, newest ? (sy_wall_s() - newest) : file_age(dp, 0), lastlog[0] ? lastlog : dp, fail ? 1 : 0);
    }
}

/* ---------------- residue ---------------- */
static void sec_residue(void) {
    static const char *pre[3] = {"unisacc-affected-", "wtgate-", "ua-cxif-"};
    int k; long now = sy_wall_s();
    for (k = 0; k < 3; k++) {
        char val[200]; long oldest = -1; int i;
        scan(g_tmp, pre[k]);
        for (i = 0; i < nents; i++) { long a = now - ents[i].mt; if (a > oldest) oldest = a; }
        cx_fmt(val, sizeof val, "count=%d oldest_s=%ld", nents, oldest < 0 ? 0 : oldest);
        emit("residue", pre[k], val, oldest, g_tmp, 0);
    }
}

/* ---------------- full-mode read-only checks ---------------- */
static void sec_checks(void) {
    static const char *nm[3] = {"tool-index", "iface-hash", "tables-gen"};
    int k, pid[3], fd[3];
    for (k = 0; k < 3; k++) {
        char sc[100]; char *v[8];
        cx_fmt(sc, sizeof sc, "tools/%s.cx", nm[k]);
        v[0] = "./tools/bound"; v[1] = "20"; v[2] = "sh"; v[3] = "./unisacc.com"; v[4] = sc; v[5] = "--"; v[6] = "--check"; v[7] = 0;
        pid[k] = sy_spawn_pipe(v, g_root, 0, &fd[k], 0);
    }
    for (k = 0; k < 3; k++) {
        char key[100], val[300]; int ex = 0, code = 0, sig = 0; long n = 0, r; char b[2048];
        if (pid[k] < 0) { cx_fmt(key, sizeof key, "%s --check", nm[k]); unmeasured("checks", key, "cannot start", nm[k]); continue; }
        while ((r = sy_read(fd[k], b, sizeof b - 1)) > 0) n += r;
        sy_close(fd[k]);
        code = -1;
        if (sy_wait_status(pid[k], 0, &ex, &code, &sig) != pid[k] || !ex) code = -1;
        cx_fmt(key, sizeof key, "%s --check", nm[k]);
        if (code == 0) emit("checks", key, "ok", -1, nm[k], 0);
        else if (code == -1 || code == 124 || code == 137 || code == 143) unmeasured("checks", key, "timed out or killed (bound 20 s)", nm[k]);
        else { cx_fmt(val, sizeof val, "FAIL rc=%d", code); emit("checks", key, val, -1, nm[k], 1); }
    }
}

static int want(const char *list, const char *name) {
    long m = slen(name), i = 0;
    if (!list) return 1;
    while (list[i]) {
        long j = i; while (list[j] && list[j] != ',') j++;
        if (j - i == m) { long k; for (k = 0; k < m && list[i + k] == name[k]; k++) ; if (k == m) return 1; }
        i = list[j] ? j + 1 : j;
    }
    return 0;
}

int main(int argc, char **argv) {
    const char *sec = 0, *tsvp = 0; int fast = 0, i;
    g_tmp = sy_tmpdir();
    for (i = 1; i < argc; i++) {
        if (streq(argv[i], "--fast")) fast = 1;
        else if (streq(argv[i], "--no-fetch")) g_fetch = 0;
        else if (i + 1 < argc && streq(argv[i], "--tsv")) tsvp = argv[++i];
        else if (i + 1 < argc && streq(argv[i], "--section")) sec = argv[++i];
        else if (i + 1 < argc && streq(argv[i], "--root")) g_root = argv[++i];
        else if (i + 1 < argc && streq(argv[i], "--tmp")) g_tmp = argv[++i];
        else if (i + 1 < argc && streq(argv[i], "--git-bin")) g_git = argv[++i];
        else if (i + 1 < argc && streq(argv[i], "--git-secs")) { g_secs_s = argv[++i]; g_git_secs = 0; { const char *q = g_secs_s; while (*q >= '0' && *q <= '9') g_git_secs = g_git_secs * 10 + (*q++ - '0'); } }
        else if (i + 1 < argc && streq(argv[i], "--pg-pat")) g_pg = argv[++i];
        else { fprintf(stderr, "usage: tools/status.cx [--tsv OUT] [--fast] [--section git,chain,derive,batches,residue]\n"); return 2; }
    }
    if (tsvp) { tsv = fopen(tsvp, "w"); if (!tsv) { fprintf(stderr, "status: cannot write %s\n", tsvp); return 2; } }
    if (want(sec, "git")) sec_git();
    if (want(sec, "chain")) sec_chain();
    if (want(sec, "derive")) sec_derive(fast);
    if (want(sec, "batches")) sec_batches();
    if (want(sec, "residue")) sec_residue();
    if (!fast && !sec) sec_checks();
    printf("STATUS ok=%d warn=%d stale=%d\n", n_ok, n_warn, n_stale);
    if (tsv) { fprintf(tsv, "STATUS ok=%d warn=%d stale=%d\n", n_ok, n_warn, n_stale); fclose(tsv); }
    return 0;
}
