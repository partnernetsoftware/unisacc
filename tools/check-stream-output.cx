#pragma unisa use runtime.stream_output
#pragma unisa use sys.proc
static int failed;
static void check(int ok,const char *name){printf("%s\t%s\n",ok?"PASS":"FAIL",name);if(!ok)failed++;}
int main(void){
    int p[2];char b[8]={0};
    check(!sy_pipe(p),"pipe-open");
    check(!cxs_write(p[1],"abc",3),"pipe-write");
    check(read(p[0],b,sizeof b)==3&&!memcmp(b,"abc",3),"pipe-content");
    close(p[0]);close(p[1]);
    char path[]="/tmp/cxs-output-XXXXXX";int fd=mkstemp(path);
    check(fd>=0,"fixture-open");if(fd<0)return 1;close(fd);
    check(!cxs_attributes(path,"xyz",3),"attributes-write");
    fd=open(path,O_RDONLY);memset(b,0,sizeof b);
    check(fd>=0&&read(fd,b,sizeof b)==3&&!memcmp(b,"xyz",3),"attributes-content");if(fd>=0)close(fd);
    check(!cxs_attributes(path,0,0),"empty-attributes-no-write");
    fd=open(path,O_RDONLY);check(fd>=0&&read(fd,b,sizeof b)==3&&!memcmp(b,"xyz",3),"empty-preserves-file");if(fd>=0)close(fd);
    check(cxs_attributes(path,0,1)==2&&cxs_write(1,0,1)==2&&cxs_write(1,"x",-1)==2,"invalid-spans");
    check(cxs_attributes("/proc/unisacc-no-such-parent/out","x",1)==2,"open-refusal");
    check(!unlink(path),"fixture-cleanup");
    printf("CXSTREAM_OUTPUT\tfailed=%d\n",failed);return failed?1:0;
}
