/* Real linter invocations: scope, references, fallback declarations and historical regressions. */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
#pragma unisa use text.text
static char scratch[4400],exe[4400],root[4096];
static int checks,bad;
static void die(const char *s){fprintf(stderr,"check-tsv-lint: %s\n",s);exit(2);}
static void path(char *p,const char *a,const char *b){if(cx_fmt(p,4400,"%s/%s",a,b))die("path bound");}
static void put(const char *p,const char *s){if(cx_write(p,s,strlen(s)))die("fixture write");}
static void ck(int yes,const char *label){checks++;printf("%s\t%s\n",yes?"PASS":"FAIL",label);if(!yes)bad++;}
static int invoke(const char *dir,int expected,const char *rule,const char *state){
 char *v[]={exe,"--case",(char *)dir,"--limit","100",0};np_result r={0};char why[512]={0};
 int tr=np_run(v,root,0,15,&r,why,sizeof why);
 int yes=!tr&&r.rc==expected&&!r.residue;
 if(rule)yes=yes&&r.out&&strstr(r.out,rule)!=0;
 if(state)yes=yes&&r.out&&strstr(r.out,state)!=0;
 if(!yes){if(r.outn)fwrite(r.out,1,r.outn,stderr);if(r.errn)fwrite(r.err,1,r.errn,stderr);if(tr)fprintf(stderr,"%s\n",why);}
 np_free(&r);return yes;
}
static void sample(const char *name,const char *manifest,const char *a,const char *b,const char *policy,int expected,const char *rule,const char *state){
 char dir[4400],p[4400];path(dir,scratch,name);if(mkdir(dir,0700))die("fixture mkdir");
 path(p,dir,"manifest.tsv");put(p,manifest);path(p,dir,"a.tsv");put(p,a);
 if(b){path(p,dir,"b.tsv");put(p,b);}if(policy){path(p,dir,"policy.tsv");put(p,policy);}
 ck(invoke(dir,expected,rule,state),name);
}
static void root_policy_sample(void){
 char dir[4400],base[4400],d[4400],p[4400];path(dir,scratch,"root-policy");if(mkdir(dir,0700))die("root fixture mkdir");
 path(base,dir,"exec");if(mkdir(base,0700))die("exec fixture mkdir");
 const char *parts[]={"pp","parse2"};
 for(int i=0;i<2;i++){
  path(d,base,parts[i]);if(mkdir(d,0700))die("stage fixture mkdir");
  path(p,d,"gen-manifest.tsv");put(p,"table\ta-byte.tsv\t-\t-\t-\t-\t-\t-\t{\"mode\":\"b\"}\n");
  path(p,d,"a-byte.tsv");put(p,i?"Q\t*\tHALT\t[]\n":"P\t0\tHALT\t[]\n");
 }
 path(d,dir,"tools");if(mkdir(d,0700))die("policy fixture mkdir");path(p,d,"tsv-lint-policy.tsv");put(p,"exec/pp\tP\tno-fallback\tOnly zero is admissible by this input-root contract\n");
 char *v[]={exe,"--root",dir,"--limit","10",0};np_result r={0};char why[512]={0};int tr=np_run(v,root,0,15,&r,why,sizeof why);
 ck(!tr&&!r.rc&&!r.residue&&r.out&&strstr(r.out,"errors=0")&&strstr(r.out,"unresolved=0"),"root-policy-is-independent-of-cwd");
 if(r.rc){if(r.outn)fwrite(r.out,1,r.outn,stderr);if(r.errn)fwrite(r.err,1,r.errn,stderr);}np_free(&r);
 if(unlink(p)||mkdir(p,0700))die("policy directory fixture");np_result q={0};char qwhy[512]={0};int qt=np_run(v,root,0,15,&q,qwhy,sizeof qwhy);int qok=!qt&&q.rc==2&&!q.residue;ck(qok,"policy-directory-is-not-absence");if(!qok){if(q.outn)fwrite(q.out,1,q.outn,stderr);if(q.errn)fwrite(q.err,1,q.errn,stderr);}np_free(&q);
}
