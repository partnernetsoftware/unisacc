  if(i==1||i==7||i==8||i==9||i==11)yes=yes&&r.out&&strstr(r.out,"undefined-state")&&strstr(r.out,"ABSENT");
  if(i==3||i==4||i==10||i==12||i==14)yes=yes&&r.out&&strstr(r.out,"unresolved=1\tstatus=PARTIAL");
  if(i==5||i==6||i==13)yes=yes&&r.out&&strstr(r.out,"unresolved=2\tstatus=PARTIAL");
