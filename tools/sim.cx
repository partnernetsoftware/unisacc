            default: die("unhandled action");
            }
            if(we_path){if(a->op==DL_SWAP)we_generation++;if(o.n!=we_on||a->op==DL_OFILL||a->op==DL_SWAP||a->op==DL_OCLR||a->op==DL_OCUT||a->op==DL_ODROP)we_event(st->name,key,we_top,ai,dl_opname(a->op),"output",we_gen,we_generation,we_on,o.n,we_frame,we_cur,we_end,we_lo,we_hi);if(e.n!=we_en)we_event(st->name,key,we_top,ai,dl_opname(a->op),"diagnostic",0,0,we_en,e.n,we_frame,we_cur,we_end,we_lo,we_hi);if(sb.n!=we_sn||a->op==DL_SBCLR)we_event(st->name,key,we_top,ai,dl_opname(a->op),"scratch",we_sgen,we_scratch_generation,we_sn,sb.n,we_frame,we_cur,we_end,we_lo,we_hi);}
        }
    }
done:
    if (covpath) {
        /* collect, sort, write */
        long cnt = 0; for (long i = 0; i < (long)D.ns * 257; i++) cnt += cov[i]; cnt += covt.n;
        char **lines = xmalloc((size_t)(cnt ? cnt : 1) * sizeof(char *)); long li = 0;
        for (int s = 0; s < D.ns; s++) for (int k = 0; k < 257; k++) if (cov[(long)s * 257 + k]) { size_t cap = strlen(D.s[s].name) + 16; char *l = xmalloc(cap); if (snprintf(l, cap, "%s\t%d", D.s[s].name, k) >= (int)cap) die("coverage line"); lines[li++] = l; }
        for (long i = 0; i < covt.cap; i++) if (covt.keys[i]) lines[li++] = covt.keys[i];
        for (long i = 1; i < li; i++) { char *t = lines[i]; long j = i - 1; while (j >= 0 && strcmp(lines[j], t) > 0) { lines[j + 1] = lines[j]; j--; } lines[j + 1] = t; }
        FILE *cf = fopen(covpath, "wb"); if (!cf) die("cannot write coverage"); for (long i = 0; i < li; i++) { fputs(lines[i], cf); fputc('\n', cf); } if (fclose(cf)) die("coverage write");
    }
    if (result == 0) { if(we_path)we_publish(&o); if (o.n) fwrite(o.s, 1, (size_t)o.n, stdout); if (e.n) fwrite(e.s, 1, (size_t)e.n, stderr); return 0; }
    if (rejname && *rejname) {
        if (laststate) fprintf(stderr, "AT\tstate=%s\tobs=%d\tcur=%ld\n", laststate, lastkey, fr->cur);
        fprintf(stderr, "reject: %s\n", rejname);
    }
    if (e.n) fwrite(e.s, 1, (size_t)e.n, stderr);
    return 1;
}
