/* tools/sim.cx -- the generic delta executor as a .cx diagnostic simulator with state-name coverage.
 *   sh ./unisacc.com tools/sim.cx -- DELTA.json INPUT [SRC_LABEL] [INCLUDE_DIR] [--cov COV.tsv] [--resource NAME=FILE]...
 * --resource supplies a named resource the way exec/c/run.c's RI table does: SBFIND of "\0NAME"
 * (e.g. NAME=cli/funit) finds FILE's bytes. At most 16; a name given twice is refused.
 * Runs the pre-network delta (seed-gen output, state names intact) on INPUT exactly as exec/pp/sim.py
 * and exec/c/run.c do: stdout = accepted output, stderr = diagnostics or "reject: NAME", rc 0/1/3(timeout).
 * --cov writes one "STATE\tKEY" line per distinct (state, observation) taken, sorted, so two runs can be
 * diffed (comm -13 A B) to find which states handled a byte in one run and not the other.
 * Semantics follow exec/pp/sim.py (docs/exec/e2-pp-delta.md): obs = byte at the top frame cursor (256 at
 * end) / result r / control-stack top; W is int64 with 32-bit wrap on ALU and 64-bit wrap on A64;
 * numeric W addresses (LDX/STX) live in a separate map from named registers, as Python's dict keeps
 * int and str keys distinct. The oracle for this tool is byte-equality with run.c and sim.py. */

#pragma unisa use cxlib.delta
#pragma unisa use text.text
#pragma unisa use sys.sha
#pragma unisa use sys.posix

enum { MAXSTACK = 4096, MAXFRAMES = 256 };
static void die(const char *s) { fprintf(stderr, "sim: %s\n", s); exit(2); }
static void *xmalloc(size_t n) { void *p = malloc(n ? n : 1); if (!p) die("out of memory"); return p; }
static void *xrealloc(void *p, size_t n) { p = realloc(p, n ? n : 1); if (!p) die("out of memory"); return p; }

/* ---- growable byte buffer ---- */
typedef struct { unsigned char *s; long n, cap; } Bytes;
static void bgrow(Bytes *b, long need) { if (b->n + need > b->cap) { long c = b->cap ? b->cap : 256; while (b->n + need > c) c *= 2; b->s = xrealloc(b->s, (size_t)c); b->cap = c; } }
static void bput(Bytes *b, const unsigned char *s, long n) { bgrow(b, n); { void *cx_kept = memcpy(b->s + b->n, s, (size_t)n); (void)cx_kept; } b->n += n; }
static void bputc(Bytes *b, int c) { bgrow(b, 1); b->s[b->n++] = (unsigned char)c; }
/* Opt-in write association only. No module ownership or causal completeness claim. */
static const char *we_path;
static long we_count,we_limit=100000,we_byte_limit=16777216,we_generation,we_scratch_generation,we_frame_serial=1,we_active_frame;
static const unsigned char *we_cached_frame;static long we_cached_n=-1;static char we_cached_sha[65];
static Bytes we_log;
static long we_fill_at,we_fill_width;
static char we_delta_sha[65],we_input_sha[65];
static void we_hash(const unsigned char *s,long n,char *out){if(sy_sha256_hex(s,n,out))cx_sha256_hex(s,n,out);}
static void we_frame_hash(const unsigned char *s,long n,char *out){if(s!=we_cached_frame||n!=we_cached_n){we_hash(s,n,we_cached_sha);we_cached_frame=s;we_cached_n=n;}memcpy(out,we_cached_sha,65);}
static long we_number(const char *s,long max){char *e;long v=strtol(s,&e,10);if(!*s||*e||v<1||v>max)die("write-events budget must be positive and within hard cap");return v;}
static void we_add(const char *s){long n=strlen(s);if(n>we_byte_limit-we_log.n)die("write-events file budget exceeded");bput(&we_log,(const unsigned char *)s,n);}
static void we_hex(const char *s,char *out,long cap){const char *hex="0123456789abcdef";long i=0;for(;*s;s++){if(i+2>=cap)die("write-events state/key length");out[i++]=hex[((unsigned char)*s)>>4];out[i++]=hex[((unsigned char)*s)&15];}out[i]=0;}
/* Identity edges do not infer ownership. Blob IDs distinguish equal content. */
static void we_edge(const char *state,int key,int ai,const char *op,const char *src,long generation,long lo,long hi,const char *dst,long id,const unsigned char *bytes,long n){char line[2048],st[1024],sha[65];long source_blob=!strcmp(src,"blob")?generation:-1;if(++we_count>we_limit)die("write-events event budget exceeded");we_hex(state,st,sizeof st);we_hash(bytes?bytes:(const unsigned char *)"",n,sha);int k=snprintf(line,sizeof line,"EDGE\t%ld\tstate_hex=%s\tkey=%d\taction_index=%d\taction=%s\tsource_buffer=%s\tsource_generation=%ld\tsource_blob_id=%ld\tsource_lo=%ld\tsource_hi=%ld\tsource_frame_instance=%ld\tdestination=%s\tdestination_id=%ld\tsha=%s\tbytes=%ld\tmodule=UNKNOWN\n",we_count,st,key,ai,op,src,source_blob>=0?0:generation,source_blob,lo,hi,we_active_frame,dst,id,sha,n);if(k<0||k>=sizeof line)die("write-events edge line bound");we_add(line);}
static void we_event(const char *state,int key,const char *top,int ai,const char *op,const char *buf,long generation,long aftergen,long before,long after,const char *frame,long cursor,long end,long lo,long hi){long dstlo=after>=before?before:after,dsthi=after>=before?after:before;if(!strcmp(op,"OFILL")){dstlo=we_fill_at;dsthi=we_fill_at+we_fill_width;}if(!strcmp(op,"SWAP")){dstlo=0;dsthi=before;}char line[4096],st[1024],tk[1024];if(++we_count>we_limit)die("write-events event budget exceeded");we_hex(state,st,sizeof st);we_hex(top?top:"",tk,sizeof tk);int n=snprintf(line,sizeof line,"EVENT\t%ld\tstate_hex=%s\tkey=%d\ttop_hex=%s\taction_index=%d\taction=%s\tbuffer=%s\tgeneration=%ld\tafter_generation=%ld\tbefore=%ld\tafter=%ld\tframe_sha=%s\tframe_instance=%ld\tcursor=%ld\tframe_end=%ld\tsource_lo=%ld\tsource_hi=%ld\tdst_lo=%ld\tdst_hi=%ld\tmodule=UNKNOWN\n",we_count,st,key,tk,ai,op,buf,generation,aftergen,before,after,frame,we_active_frame,cursor,end,lo,hi,dstlo,dsthi);if(n<0||n>=sizeof line)die("write-events event line bound");we_add(line);}
static void we_publish(const Bytes *o){char sha[65],line[512],tmp[4400];we_hash(o->s?o->s:(const unsigned char *)"",o->n,sha);if(snprintf(tmp,sizeof tmp,"%s.tmp.%d",we_path,getpid())>=sizeof tmp)die("write-events path bound");int fd=open(tmp,O_WRONLY|O_CREAT|O_EXCL,0600);if(fd<0)die("write-events create temp");snprintf(line,sizeof line,"WRITE_EVENTS\tversion=1\tdelta_sha=%s\tinput_sha=%s\toutput_sha=%s\toutput_bytes=%ld\tclaim=association-only\n",we_delta_sha,we_input_sha,sha,o->n);Bytes all={0};bput(&all,(unsigned char *)line,strlen(line));bput(&all,we_log.s,we_log.n);snprintf(line,sizeof line,"COMPLETE\tevents=%ld\n",we_count);bput(&all,(unsigned char *)line,strlen(line));if(all.n>we_byte_limit){close(fd);unlink(tmp);die("write-events file budget exceeded including metadata");}long at=0;while(at<all.n){long n=write(fd,all.s+at,all.n-at);if(n<=0){close(fd);unlink(tmp);die("write-events write");}at+=n;}if(close(fd)||sy_linkat(sy_at_fdcwd(),tmp,sy_at_fdcwd(),we_path,0)){unlink(tmp);die("write-events publish (target must not exist)");}if(unlink(tmp))die("write-events temp cleanup");free(all.s);}
typedef struct { long long *s; long n, cap; } Words;
static void wgrow(Words *w, long need) { if (w->n + need > w->cap) { long c = w->cap ? w->cap : 256; while (w->n + need > c) c *= 2; w->s = xrealloc(w->s, (size_t)c * sizeof(long long)); w->cap = c; } }
static void wput(Words *w, long long v) { wgrow(w, 1); w->s[w->n++] = v; }

/* ---- string-keyed and int-keyed maps (open addressing) ---- */
typedef struct { char **keys; long long *vals; long n, cap; } SMap;
static unsigned long shash(const char *s, long n) { unsigned long h = 1469598103934665603UL; for (long i = 0; i < n; i++) { h ^= (unsigned char)s[i]; h *= 1099511628211UL; } return h; }
static long sfind(SMap *m, const char *k, long n, int insert) {
    if (!m->cap || (insert && m->n * 2 >= m->cap)) {
        long oc = m->cap, nc = oc ? oc * 2 : 1024; char **ok = m->keys; long long *ov = m->vals;
        m->keys = xmalloc((size_t)nc * sizeof(char *)); m->vals = xmalloc((size_t)nc * sizeof(long long)); memset(m->keys, 0, (size_t)nc * sizeof(char *)); m->cap = nc; m->n = 0;
        for (long i = 0; i < oc; i++) if (ok[i]) { long j = sfind(m, ok[i], (long)strlen(ok[i]), 1); m->keys[j] = ok[i]; m->vals[j] = ov[i]; m->n++; }
        free(ok); free(ov);
    }
    long i = (long)(shash(k, n) & (unsigned long)(m->cap - 1));
    for (;;) {
        if (!m->keys[i]) { if (!insert) return -1; return i; }
        if ((long)strlen(m->keys[i]) == n && !memcmp(m->keys[i], k, (size_t)n)) return i;
        i = (i + 1) & (m->cap - 1);
    }
}
static long long sget(SMap *m, const char *k) { long i = m->cap ? sfind(m, k, (long)strlen(k), 0) : -1; return i < 0 ? 0 : m->vals[i]; }
static int shas(SMap *m, const unsigned char *k, long n, long long *out) { long i = m->cap ? sfind(m, (const char *)k, n, 0) : -1; if (i < 0) return 0; *out = m->vals[i]; return 1; }
static void sset(SMap *m, const unsigned char *k, long n, long long v) {
    long i = sfind(m, (const char *)k, n, 1);
    if (!m->keys[i]) { char *c = xmalloc((size_t)n + 1); { void *cx_kept = memcpy(c, k, (size_t)n); (void)cx_kept; } c[n] = 0; m->keys[i] = c; m->n++; }
    m->vals[i] = v;
}
static void ssets(SMap *m, const char *k, long long v) { sset(m, (const unsigned char *)k, (long)strlen(k), v); }
/* string keys may contain NUL (blob ids like "\0cli/source"): keep length-aware copies via a parallel length table */
typedef struct { unsigned char **keys; long *lens; long long *vals; long n, cap; } BMap;
static long bfind(BMap *m, const unsigned char *k, long n, int insert) {
    if (!m->cap || (insert && m->n * 2 >= m->cap)) {
        long oc = m->cap, nc = oc ? oc * 2 : 1024; unsigned char **ok = m->keys; long *ol = m->lens; long long *ov = m->vals;
        m->keys = xmalloc((size_t)nc * sizeof(unsigned char *)); m->lens = xmalloc((size_t)nc * sizeof(long)); m->vals = xmalloc((size_t)nc * sizeof(long long)); memset(m->keys, 0, (size_t)nc * sizeof(unsigned char *)); m->cap = nc; m->n = 0;
        for (long i = 0; i < oc; i++) if (ok[i]) { long j = bfind(m, ok[i], ol[i], 1); m->keys[j] = ok[i]; m->lens[j] = ol[i]; m->vals[j] = ov[i]; m->n++; }
        free(ok); free(ol); free(ov);
    }
    long i = (long)(shash((const char *)k, n) & (unsigned long)(m->cap - 1));
    for (;;) {
        if (!m->keys[i]) { if (!insert) return -1; return i; }
        if (m->lens[i] == n && !memcmp(m->keys[i], k, (size_t)n)) return i;
        i = (i + 1) & (m->cap - 1);
    }
}
static int bhas(BMap *m, const unsigned char *k, long n, long long *out) { long i = m->cap ? bfind(m, k, n, 0) : -1; if (i < 0) return 0; *out = m->vals[i]; return 1; }
static void bset(BMap *m, const unsigned char *k, long n, long long v) { long i = bfind(m, k, n, 1); if (!m->keys[i]) { unsigned char *c = xmalloc((size_t)n + 1); { void *cx_kept = memcpy(c, k, (size_t)n); (void)cx_kept; } c[n] = 0; m->keys[i] = c; m->lens[i] = n; m->n++; } m->vals[i] = v; }
typedef struct { long long *keys; long long *vals; unsigned char *used; long n, cap; } IMap;
static long ifind(IMap *m, long long k, int insert) {
    if (!m->cap || (insert && m->n * 2 >= m->cap)) {
        long oc = m->cap, nc = oc ? oc * 2 : 4096; long long *ok = m->keys, *ov = m->vals; unsigned char *ou = m->used;
        m->keys = xmalloc((size_t)nc * sizeof(long long)); m->vals = xmalloc((size_t)nc * sizeof(long long)); m->used = xmalloc((size_t)nc); memset(m->used, 0, (size_t)nc); m->cap = nc; m->n = 0;
        for (long i = 0; i < oc; i++) if (ou[i]) { long j = ifind(m, ok[i], 1); m->keys[j] = ok[i]; m->vals[j] = ov[i]; m->used[j] = 1; m->n++; }
        free(ok); free(ov); free(ou);
    }
    unsigned long long h = (unsigned long long)k * 11400714819323198485ULL; long i = (long)(h >> 20) & (m->cap - 1);
    for (;;) { if (!m->used[i]) { if (!insert) return -1; return i; } if (m->keys[i] == k) return i; i = (i + 1) & (m->cap - 1); }
}
static long long iget(IMap *m, long long k) { long i = m->cap ? ifind(m, k, 0) : -1; return i < 0 ? 0 : m->vals[i]; }
static void iset(IMap *m, long long k, long long v) { long i = ifind(m, k, 1); if (!m->used[i]) { m->used[i] = 1; m->keys[i] = k; m->n++; } m->vals[i] = v; }
/* Diagnostic write versions identify the last actual store, including zero writes. */
static IMap we_versions;
static long we_store_serial;
static void we_memory(const char *state,int key,int ai,const char *op,long long address,long long value,long version,long previous,long cursor){
 char line[2048],st[1024];if(++we_count>we_limit)die("write-events event budget exceeded");we_hex(state,st,sizeof st);
 int n=snprintf(line,sizeof line,"MEMORY\t%ld\tstate_hex=%s\tkey=%d\taction_index=%d\taction=%s\taddress=%lld\tvalue=%lld\tversion=%ld\tprevious_version=%ld\tframe_instance=%ld\tcursor=%ld\tmodule=UNKNOWN\n",we_count,st,key,ai,op,address,value,version,previous,we_active_frame,cursor);
 if(n<0||n>=sizeof line)die("write-events memory line bound");we_add(line);
}

/* ---- files (read-only dictionary; keys are the delta's path strings) ---- */
static const char *bundled;
static BMap filecache; static Bytes *filedata; static long nfiles, filecap;
static long file_get(const unsigned char *key, long n, const unsigned char **data, long *len) {   /* returns 1 found, 0 absent */
    long long idx; if (bhas(&filecache, key, n, &idx)) { if (idx < 0) return 0; *data = filedata[idx].s; *len = filedata[idx].n; return 1; }
    char path[8192]; long off = 0, pn = 0;
    if (n >= 7 && key[0] == 0 && (!memcmp(key + 1, "inc/q/", 6) || !memcmp(key + 1, "inc/a/", 6))) off = 7;
    else if (n >= 5 && key[0] == 0 && !memcmp(key + 1, "hdr/", 4)) { if (!bundled) die("\\0hdr/ path needs INCLUDE_DIR"); pn = (long)strlen(bundled); if (pn + 1 + n >= (long)sizeof path) die("path length"); { void *cx_kept = memcpy(path, bundled, (size_t)pn); (void)cx_kept; } path[pn++] = '/'; off = 5; }
    if (n - off + pn >= (long)sizeof path) die("path length"); { void *cx_kept = memcpy(path + pn, key + off, (size_t)(n - off)); (void)cx_kept; } path[pn + n - off] = 0;
    if (memchr(path, 0, (size_t)(pn + n - off))) { bset(&filecache, key, n, -1); return 0; }   /* a NUL inside the path: never a file (Python ValueError) */
    struct stat st; errno = 0;
    if (stat(path, &st)) { if (errno == ENOENT) { bset(&filecache, key, n, -1); return 0; } fprintf(stderr, "sim: cannot stat %s (errno %d)\n", path, errno); exit(2); }
    FILE *f = fopen(path, "rb"); if (!f) { fprintf(stderr, "sim: cannot open %s (errno %d)\n", path, errno); exit(2); }
    Bytes b = {0}; unsigned char chunk[65536]; size_t k; while ((k = fread(chunk, 1, sizeof chunk, f)) > 0) bput(&b, chunk, (long)k); if (ferror(f)) die("file read"); fclose(f);
    if (nfiles == filecap) { filecap = filecap ? filecap * 2 : 64; filedata = xrealloc(filedata, (size_t)filecap * sizeof(Bytes)); }
    filedata[nfiles] = b; bset(&filecache, key, n, nfiles); *data = b.s; *len = b.n; nfiles++; return 1;
}

/* ---- machine ---- */
typedef struct { const unsigned char *b; const long long *attr; long cur, end, diagnostic_id; } Frame;
static long long w32(long long v) { unsigned long long u = (unsigned long long)v & 0xFFFFFFFFULL; return (u & 0x80000000ULL) ? (long long)u - 0x100000000LL : (long long)u; }
static long long alu32(int op, long long a, long long b) {
    a = w32(a); b = w32(b);
    switch (op) {
    case DL_add: return w32(a + b); case DL_sub: return w32(a - b); case DL_mul: return w32(a * b);
    case DL_div: { if (b == 0) return 0; long long aa = a < 0 ? -a : a, bb = b < 0 ? -b : b, q = aa / bb; return w32((a < 0) == (b < 0) ? q : -q); }
    case DL_rem: { if (b == 0) return 0; long long q = alu32(DL_div, a, b); return w32(a - q * b); }
    case DL_and: return w32(a & b); case DL_or: return w32(a | b); case DL_xor: return w32(a ^ b);
    case DL_shl: return w32((long long)((unsigned long long)a << (b & 31)));
    case DL_sar: return w32(a >> (b & 31));
    default: die("ALU op not valid for 32-bit"); return 0;
    }
}
static long long w64(unsigned long long u) { return (long long)u; }
static long long alu64(int op, long long a, long long b, int *dz) {
    unsigned long long ua = (unsigned long long)a, ub = (unsigned long long)b; *dz = 0;
    switch (op) {
    case DL_sdiv: case DL_srem: case DL_udiv: case DL_urem: {
        if (b == 0) { *dz = 1; return 0; }
        if (op == DL_udiv) return w64(ua / ub); if (op == DL_urem) return w64(ua % ub);
        unsigned long long aa = a < 0 ? (unsigned long long)0 - ua : ua, bb = b < 0 ? (unsigned long long)0 - ub : ub, q = aa / bb;
        long long sq = ((a < 0) == (b < 0)) ? (long long)q : (long long)((unsigned long long)0 - q);
        if (op == DL_sdiv) return sq; return w64(ua - (unsigned long long)sq * ub);
    }
    case DL_add: return w64(ua + ub); case DL_sub: return w64(ua - ub); case DL_mul: return w64(ua * ub);
    case DL_and: return w64(ua & ub); case DL_or: return w64(ua | ub); case DL_xor: return w64(ua ^ ub); case DL_not: return w64(~ua);
    case DL_shl: return w64(ua << (b & 63)); case DL_shr: return w64(ua >> (b & 63)); case DL_sar: return a >> (b & 63);
    default: die("A64 op not valid"); return 0;
    }
}
typedef struct { unsigned char *s; long n; } Blob;

int main(int argc, char **argv) {
    const char *delta = 0, *input = 0, *srcpath = 0, *covpath = 0; int pos = 0;
    const char *resname[16], *respath[16]; int nres = 0;
    for (int i = 1; i < argc; i++) { if (tx_eqz(argv[i], "--resource") && i + 1 < argc) { const char *s = argv[++i], *eq = strchr(s, '='); if (!eq || eq == s || !eq[1] || nres == 16) die("--resource NAME=FILE (at most 16)"); char *nm = xmalloc((size_t)(eq - s) + 2); nm[0] = 0; { void *cx_kept = memcpy(nm + 1, s, (size_t)(eq - s)); (void)cx_kept; } nm[eq - s + 1] = 0; for (int r2 = 0; r2 < nres; r2++) if (tx_eqz(resname[r2] + 1, nm + 1)) die("--resource name given twice"); resname[nres] = nm; respath[nres] = eq + 1; nres++; } else if(tx_eqz(argv[i],"--write-events")&&i+1<argc)we_path=argv[++i]; else if(tx_eqz(argv[i],"--event-limit")&&i+1<argc)we_limit=we_number(argv[++i],1000000); else if(tx_eqz(argv[i],"--event-bytes")&&i+1<argc)we_byte_limit=we_number(argv[++i],67108864); else if (tx_eqz(argv[i], "--cov") && i + 1 < argc) covpath = argv[++i]; else if (pos == 0) delta = argv[i], pos++; else if (pos == 1) input = argv[i], pos++; else if (pos == 2) srcpath = argv[i], pos++; else if (pos == 3) bundled = argv[i], pos++; else die("usage: DELTA.json INPUT [SRC_LABEL] [INCLUDE_DIR] [--cov COV.tsv]"); }
    if (!delta || !input) { fputs("usage: sim DELTA.json INPUT [SRC_LABEL] [INCLUDE_DIR] [--cov COV.tsv]\n", stderr); return 2; }
    if (!srcpath) srcpath = input;
    if(we_path){struct stat ws;if(!lstat(we_path,&ws)||errno!=ENOENT)die("write-events target exists or stat error");size_t dn;unsigned char *db=(unsigned char *)cx_read(delta,&dn);if(!db)die("write-events delta read");we_hash(db,dn,we_delta_sha);free(db);}
    dl_delta D; dl_load(delta, &D);
    /* input */
    Bytes xin = {0}; { FILE *f = strcmp(input, "-") ? fopen(input, "rb") : stdin; if (!f) { fprintf(stderr, "sim: cannot open input %s\n", input); return 2; } unsigned char chunk[65536]; size_t k; while ((k = fread(chunk, 1, sizeof chunk, f)) > 0) bput(&xin, chunk, (long)k); if (f != stdin) fclose(f); }
    unsigned char *x = xin.s ? xin.s : (unsigned char *)""; long xn = xin.n;
    if(we_path)we_hash(x,xn,we_input_sha);
    long long *xattr = xmalloc((size_t)(xn ? xn : 1) * sizeof(long long)); memset(xattr, 0, (size_t)(xn ? xn : 1) * sizeof(long long));
    /* store */
    long long *W = xmalloc((size_t)(D.nreg + 1) * sizeof(long long)); memset(W, 0, (size_t)(D.nreg + 1) * sizeof(long long)); IMap WM = {0}; BMap intern = {0}, blobid = {0};
    Blob *blobs = xmalloc(1024 * sizeof(Blob)); long nblobs = 0, blobcap = 1024;
#define ADDBLOB(ptr, len) do { if (nblobs == blobcap) { blobcap *= 2; blobs = xrealloc(blobs, (size_t)blobcap * sizeof(Blob)); } blobs[nblobs].s = (unsigned char *)(ptr); blobs[nblobs].n = (len); nblobs++; } while (0)
    ADDBLOB("", 0); { long sl = (long)strlen(srcpath); unsigned char *c = xmalloc((size_t)sl + 1); { void *cx_kept = memcpy(c, srcpath, (size_t)sl + 1); (void)cx_kept; } ADDBLOB(c, sl); }
    { static const unsigned char k[] = "\0cli/source"; bset(&blobid, k, 11, 1); }
    for (int r2 = 0; r2 < nres; r2++) {
        Bytes rb = {0}; FILE *f = fopen(respath[r2], "rb"); if (!f) { fprintf(stderr, "sim: cannot open resource %s\n", respath[r2]); return 2; }
        unsigned char chunk[65536]; size_t k; while ((k = fread(chunk, 1, sizeof chunk, f)) > 0) bput(&rb, chunk, (long)k); if (ferror(f)) { fclose(f); fprintf(stderr, "sim: cannot read resource %s\n", respath[r2]); return 2; } fclose(f);
        unsigned char *c = xmalloc((size_t)rb.n + 1); if (rb.n) { void *cx_kept = memcpy(c, rb.s, (size_t)rb.n); (void)cx_kept; } ADDBLOB(c, rb.n);
        long kn = (long)strlen(resname[r2] + 1) + 1; bset(&blobid, (const unsigned char *)resname[r2], kn, nblobs - 1);
    }
    Frame frames[MAXFRAMES]; int nfr = 1; if(we_path)frames[0].diagnostic_id=we_frame_serial; frames[0].b = x; frames[0].attr = xattr; frames[0].cur = 0; frames[0].end = xn; Frame *fr = &frames[0];
    const char *stack[MAXSTACK]; int nst = 0;
    Bytes o = {0}, e = {0}, sb = {0}; Words oattr = {0}; int osel = 0; long long OT = 0; long long r = 0;
    int q = D.start; long long steps = 0;
    /* coverage: a flag per (state, key) for b/r, a set for t */
    unsigned char *cov = 0; SMap covt = {0}; if (covpath) { cov = xmalloc((size_t)D.ns * 257); memset(cov, 0, (size_t)D.ns * 257); }
    int result = -1; const char *rejname = 0; const char *laststate = 0; int lastkey = -1;
    int trace = 0;
    { int ti; for (ti = 1; ti < argc; ti++) if (tx_eqz(argv[ti], "--trace")) trace = 1; }
    for (;;) {
        steps++;
        dl_state *st = &D.s[q]; dl_edge *ed; int key;
        laststate = st->name;
        if (st->mode == 'b') { key = fr->cur < fr->end ? fr->b[fr->cur] : DL_EOF; ed = &st->byte[key]; }
        else if (st->mode == 't') { const char *top = nst ? stack[nst - 1] : "BOT"; ed = 0; for (int k = 0; k < st->tn; k++) if (tx_eqz(st->tkeys[k], top)) { ed = &st->tedges[k]; break; }
            if (!ed) { fprintf(stderr, "sim: state %s has no edge for stack top %s\n", st->name, top); return 2; }
            if (cov) { char kk[600]; { if (cx_fmt(kk, sizeof kk, "%s\t%s", st->name, top)) { fprintf(stderr, "sim: text too long for kk\n"); exit(2); } } ssets(&covt, kk, 1); } key = -1; }
        else { key = (r >= 0 && r <= 256) ? (int)r : 256; ed = &st->byte[key]; }
        if (key >= 0) { lastkey = key; if (trace) fprintf(stderr, "TRACE\t%s\t%d\tcur=%ld\n", st->name, key, fr->cur);
          if (ed->next < 0) { fprintf(stderr, "sim: state %s has no edge for key %d\n", st->name, key); return 2; } if (cov) cov[(long)q * 257 + key] = 1; }
        const char *we_observed_top=(we_path&&st->mode=='t')?(nst?stack[nst-1]:"BOT"):"";
        q = ed->next; dl_seq *sq = ed->seq;
        for (int ai = 0; ai < sq->n; ai++) {
            dl_act *a = &sq->a[ai];
            long we_on=0,we_en=0,we_sn=0,we_cur=0,we_end=0,we_lo=-1,we_hi=-1,we_gen=we_generation,we_sgen=we_scratch_generation;char we_frame[65]={0};const char *we_top="";
            if(we_path){we_fill_at=a->op==DL_OFILL?(long)W[a->r1]:-1;we_fill_width=(long)a->v;we_on=o.n;we_en=e.n;we_sn=sb.n;we_cur=fr->cur;we_end=fr->end;we_active_frame=fr->diagnostic_id;we_frame_hash(fr->b,fr->end,we_frame);we_top=we_observed_top;if(a->op==DL_COPY||a->op==DL_COPYT){we_lo=fr->cur;we_hi=fr->cur<fr->end?fr->cur+1:fr->cur;}if(a->op==DL_SPAN||a->op==DL_SPANT||a->op==DL_SPAN2||a->op==DL_SBSPAN){we_lo=(long)W[a->r1];if(we_lo<0)we_lo=0;we_hi=(a->op==DL_SPAN2||a->op==DL_SBSPAN)?(long)W[a->r2]:fr->cur;if(we_hi>fr->end)we_hi=fr->end;if(we_hi<we_lo)we_hi=we_lo;}}
            switch (a->op) {
            case DL_ADV: fr->cur++; break;
            case DL_MARK: W[a->r1] = fr->cur; break;
            case DL_JUMP: fr->cur = (long)W[a->r1]; break;
            case DL_COPYT: if (fr->cur < fr->end) { if (osel == 0) { bputc(&o, fr->b[fr->cur]); wput(&oattr, OT); } else bputc(&e, fr->b[fr->cur]); } break;
            case DL_COPY: if (fr->cur < fr->end) { if (osel == 0) { bputc(&o, fr->b[fr->cur]); wput(&oattr, fr->attr ? fr->attr[fr->cur] : OT); } else bputc(&e, fr->b[fr->cur]); } break;
            case DL_OUT: if (osel == 0) { bputc(&o, (int)a->v); wput(&oattr, OT); } else bputc(&e, (int)a->v); break;
            case DL_LDI: W[a->r1] = a->v; break;
            case DL_COPYW: W[a->r1] = W[a->r2]; break;
            case DL_ALU: W[a->r1] = alu32(a->alu, W[a->r2], W[a->r3]); break;
            case DL_ALUI: W[a->r1] = alu32(a->alu, W[a->r2], a->v); break;
            case DL_CMP: case DL_CMPI: { long long u = W[a->r1], v = a->op == DL_CMPI ? a->v : a->addr2 ? iget(&WM, a->v) : W[a->r2]; r = u < v ? 0 : u == v ? 1 : 2; } break;
            case DL_A64: case DL_A64I: { int dz; long long v = alu64(a->alu, W[a->r2], a->op == DL_A64 ? W[a->r3] : a->v, &dz); W[a->r1] = v; r = dz; } break;
            case DL_C64: case DL_C64U: { long long u = W[a->r1], v = W[a->r2]; if (a->op == DL_C64U) { unsigned long long uu = (unsigned long long)u, vv = (unsigned long long)v; r = uu < vv ? 0 : uu == vv ? 1 : 2; } else r = u < v ? 0 : u == v ? 1 : 2; } break;
            case DL_RLD: { long long v = W[a->r1]; r = (v >= 0 && v <= 256) ? v : 256; } break;
            case DL_LDX: { long long address=W[a->r2]+a->v;W[a->r1]=iget(&WM,address);if(we_path)we_memory(st->name,key,ai,"LDX",address,W[a->r1],(long)iget(&we_versions,address),0,fr->cur); } break;
            case DL_STX: { long long address=W[a->r1]+a->v,value=W[a->r2];iset(&WM,address,value);if(we_path){long prior=(long)iget(&we_versions,address),version=++we_store_serial;iset(&we_versions,address,version);we_memory(st->name,key,ai,"STX",address,value,version,prior,fr->cur);} } break;
            case DL_OUTW: { int c = (int)(W[a->r1] & 255); if (osel == 0) { bputc(&o, c); wput(&oattr, OT); } else bputc(&e, c); } break;
            case DL_SPAN: case DL_SPANT: case DL_SPAN2: { long s0 = (long)W[a->r1]; if (s0 < 0) s0 = 0; long s1 = a->op == DL_SPAN2 ? (long)W[a->r2] : fr->cur; if (s1 > fr->end) s1 = fr->end;
                if (s0 < s1) { if (osel == 1) bput(&e, fr->b + s0, s1 - s0); else { bput(&o, fr->b + s0, s1 - s0); for (long i = s0; i < s1; i++) wput(&oattr, (a->op == DL_SPANT || !fr->attr) ? OT : fr->attr[i]); } } } break;
            case DL_OLAST: r = o.n ? o.s[o.n - 1] : 256; break;
            case DL_ODROP: if (o.n) { o.n--; oattr.n--; } break;
            case DL_OLEN: W[a->r1] = o.n; break;
            case DL_OCUT: { long s0 = (long)W[a->r2]; if (s0 < 0) s0 = 0; if (s0 > o.n) s0 = o.n; long len = o.n - s0; unsigned char *c = xmalloc((size_t)len + 1); { void *cx_kept = memcpy(c, o.s + s0, (size_t)len); (void)cx_kept; } ADDBLOB(c, len); W[a->r1] = nblobs - 1;if(we_path)we_edge(st->name,key,ai,"OCUT","output",we_generation,s0,o.n,"blob",nblobs-1,c,len); o.n = s0; oattr.n = s0; } break;
            case DL_ORES: W[a->r1] = o.n; for (long long i = 0; i < a->v; i++) { bputc(&o, ' '); wput(&oattr, OT); } break;
            case DL_OFILL: { char t[32]; int tn = snprintf(t, sizeof t, "%lld", W[a->r2]); long wdt = (long)a->v, at = (long)W[a->r1]; if (at < 0 || at + wdt > o.n) die("fill past the reservation");
                if (tn <= wdt) { memset(o.s + at, ' ', (size_t)(wdt - tn)); { void *cx_kept = memcpy(o.s + at + wdt - tn, t, (size_t)tn); (void)cx_kept; } } else { result = 1; rejname = "field overflow"; goto done; } } break;
            case DL_OCLR: o.n = 0; oattr.n = 0; break;
            case DL_OSEL: osel = (int)a->v; break;
            case DL_SETOT: OT = W[a->r1]; break;
            case DL_XATTR: W[a->r1] = (fr->attr && fr->cur < fr->end) ? fr->attr[fr->cur] : 0; break;
            case DL_PUSH: if (nst == MAXSTACK) die("control stack overflow"); stack[nst++] = a->s1; break;
            case DL_POP: if (!nst) die("pop of an empty stack"); nst--; break;
            case DL_INTERN: case DL_SBINTERN: { const unsigned char *k; long kn; if (a->op == DL_INTERN) { long s0 = (long)W[a->r2], s1 = (long)W[a->r3]; if (s0 < 0) s0 = 0; if (s1 > fr->end) s1 = fr->end; k = fr->b + s0; kn = s0 < s1 ? s1 - s0 : 0; } else { k = sb.s ? sb.s : (const unsigned char *)""; kn = sb.n; }
                long long id; if (!bhas(&intern, k, kn, &id)) { id = intern.n + 1; bset(&intern, k, kn, id); } W[a->r1] = id;if(we_path){long lo=a->op==DL_INTERN?(long)(k-fr->b):0;we_edge(st->name,key,ai,dl_opname(a->op),a->op==DL_INTERN?"frame":"scratch",a->op==DL_INTERN?fr->diagnostic_id:we_scratch_generation,lo,lo+kn,"intern",(long)id,k,kn);} } break;
            case DL_BLOBSAVE: case DL_SBSAVE: { const unsigned char *k; long kn; if (a->op == DL_BLOBSAVE) { long s0 = (long)W[a->r2], s1 = (long)W[a->r3]; if (s0 < 0) s0 = 0; if (s1 > fr->end) s1 = fr->end; k = fr->b + s0; kn = s0 < s1 ? s1 - s0 : 0; } else { k = sb.s ? sb.s : (const unsigned char *)""; kn = sb.n; }
                unsigned char *c = xmalloc((size_t)kn + 1); { void *cx_kept = memcpy(c, k, (size_t)kn); (void)cx_kept; } ADDBLOB(c, kn); W[a->r1] = nblobs - 1;if(we_path){long lo=a->op==DL_BLOBSAVE?(long)(k-fr->b):0;we_edge(st->name,key,ai,dl_opname(a->op),a->op==DL_BLOBSAVE?"frame":"scratch",a->op==DL_BLOBSAVE?fr->diagnostic_id:we_scratch_generation,lo,lo+kn,"blob",nblobs-1,c,kn);} } break;
            case DL_INPUSH: { long long bi = W[a->r1]; if (bi < 0 || bi >= nblobs) die("INPUSH blob index"); if (nfr == MAXFRAMES) die("frame overflow"); if(we_path){frames[nfr].diagnostic_id=++we_frame_serial;we_edge(st->name,key,ai,"INPUSH","blob",(long)bi,0,blobs[bi].n,"frame",frames[nfr].diagnostic_id,blobs[bi].s,blobs[bi].n);}frames[nfr].b = blobs[bi].s; frames[nfr].attr = 0; frames[nfr].cur = 0; frames[nfr].end = blobs[bi].n; fr = &frames[nfr++]; } break;
            case DL_INPUSHX: case DL_INPUSHXE: { if (nfr == MAXFRAMES) die("frame overflow"); if(we_path)frames[nfr].diagnostic_id=++we_frame_serial;frames[nfr].b = x; frames[nfr].attr = xattr; frames[nfr].cur = (long)W[a->r1]; long end = xn; if (a->op == DL_INPUSHXE) { long long ee = W[a->r2]; if (ee < end) end = (long)ee; } frames[nfr].end = end; fr = &frames[nfr++]; } break;
            case DL_INPOP: if (nfr <= 1) die("INPOP of the base frame"); nfr--; fr = &frames[nfr - 1]; break;
            case DL_SBCLR: sb.n = 0;if(we_path)we_scratch_generation++; break;
            case DL_SBOUT: bputc(&sb, (int)a->v); break;
            case DL_SBSPAN: { long s0 = (long)W[a->r1], s1 = (long)W[a->r2]; if (s0 < 0) s0 = 0; if (s1 > fr->end) s1 = fr->end; if (s0 < s1) bput(&sb, fr->b + s0, s1 - s0); } break;
            case DL_SBBLOB: { long long bi = W[a->r1]; if (bi < 0 || bi >= nblobs) die("SBBLOB blob index"); bput(&sb, blobs[bi].s, blobs[bi].n); } break;
            case DL_SBFIND: { const unsigned char *k = sb.s ? sb.s : (const unsigned char *)""; long kn = sb.n; long long id; if (!bhas(&blobid, k, kn, &id)) { const unsigned char *d; long dn; if (file_get(k, kn, &d, &dn)) { ADDBLOB(d, dn); id = nblobs - 1; } else id = 0; bset(&blobid, k, kn, id); } W[a->r1] = id; } break;
            case DL_SBLOAD: { const char *s = a->s2 ? a->s2 : ""; long n = (long)strlen(s), k; unsigned char *c = xmalloc((size_t)n + 1);
                for (k = 0; k < n; k++) c[k] = (unsigned char)s[k]; c[n] = 0; ADDBLOB(c, n); W[a->r1] = nblobs - 1; } break;   /* the operand names the S line's text */
            case DL_BYTE: W[a->r1] = fr->cur < fr->end ? fr->b[fr->cur] : 0; break;
            case DL_XLEN: W[a->r1] = fr->end; break;
            case DL_BLEN: { long long bi = W[a->r2]; if (bi < 0 || bi >= nblobs) die("BLEN blob index"); W[a->r1] = blobs[bi].n; } break;
            case DL_DIVMOD10: { unsigned long long v = (unsigned long long)W[a->r1] & 0xFFFFFFFFULL; W[a->r1] = (long long)(v / 10); r = (long long)(v % 10) + (v / 10 == 0 ? 10 : 0); } break;
            case DL_INC: W[a->r1] = (long long)(((unsigned long long)W[a->r1] + 1) & 0xFFFFFFFFULL); break;   /* exec/c/core.c:300 */
            case DL_SWAP: { unsigned char *nx = xmalloc((size_t)o.n + 1); { void *cx_kept = memcpy(nx, o.s, (size_t)o.n); (void)cx_kept; } nx[o.n] = 0; long long *na = xmalloc((size_t)(o.n ? o.n : 1) * sizeof(long long)); { void *cx_kept = memcpy(na, oattr.s, (size_t)o.n * sizeof(long long)); (void)cx_kept; }
                x = nx; xn = o.n; xattr = na; o.s = 0; o.n = 0; o.cap = 0; oattr.s = 0; oattr.n = 0; oattr.cap = 0; nfr = 1; if(we_path){frames[0].diagnostic_id=++we_frame_serial;we_edge(st->name,key,ai,"SWAP","output",we_generation,0,xn,"frame",frames[0].diagnostic_id,x,xn);} frames[0].b = x; frames[0].attr = xattr; frames[0].cur = 0; frames[0].end = xn; fr = &frames[0]; } break;
