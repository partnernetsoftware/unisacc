/* Carried-header source exporter; caller bound55. No Python invocation.
 * prepare ROOT NEW_MAT LIBNEED_NATIVE | --verify ROOT MAT | install ROOT MAT
 * The native libneed executable is an explicit HOSTCC/nonhermetic trust input:
 * its bytes and the C reference source are bound, not a claimed compiler proof.
 * Every command reruns both old-header and current-header native table oracles.
 * PREPARED/VERIFIED is material consistency, never product/test qualification.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use text.text
typedef struct {char *name,*text;size_t n;char sha[65];} Header;
typedef struct {char *body[1024],*key[8192];int nb,nk;int *dep[8192],nd[8192],roots[1024],nr;} Table;
typedef struct {np_buf inputs,old,generated,old_table,new_table,receipt;char origin[4400],native_sha[65],tool_sha[65],c_sha[65];} Material;
static char root[4096],mat[4400],native[4400],bound[4400],target[4400],lockpath[4400],temp[4400];
static Header current[2048],previous[2048];static int nc,np,lockfd=-1,lock_owned,temp_owned,renamed;
static void die(const char *s){int e=errno;if(temp_owned&&!renamed)unlink(temp);if(lock_owned&&!renamed)unlink(lockpath);if(lockfd>=0)close(lockfd);fprintf(stderr,"carried-header-export: REFUSE %s errno=%d renamed=%d\n",s,e,renamed);exit(2);}
static void path(char p[4400],const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path-bound");}
static char *load(const char *p,size_t *n){struct stat a,b;if(lstat(p,&a)||!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>16777216)die("bounded-regular-input");int fd=open(p,O_RDONLY|O_CLOEXEC|O_NOFOLLOW|O_NONBLOCK);if(fd<0)die("input-open");if(fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size)die("input-descriptor");*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s)die("allocation");size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("input-extent");at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int changed=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(z||changed||closed)die("input-changed-or-close");s[*n]=0;return s;}
static void digest(const char *p,char h[65]){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,h);free(s);}
static int absent(const char *p){struct stat st;if(!lstat(p,&st))return 0;if(errno!=ENOENT)die("existence-stat");return 1;}
static void write_new(const char *p,const void *bytes,size_t n,int mode){int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC|O_NOFOLLOW,mode);if(fd<0)die("exclusive-output");if(tx_eq(p, temp, 1L << 20))temp_owned=1;const char *s=bytes;size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("output-write");at+=(size_t)z;}int bad=fsync(fd),closed=close(fd);if(bad||closed)die("output-sync-or-close");}
static void save(const char *name,const np_buf *b){char p[4400];path(p,mat,name);write_new(p,b->p,b->n,0600);}
static np_buf readmat(const char *name){char p[4400];size_t n;path(p,mat,name);char *s=load(p,&n);np_buf b={0};np_put(&b,s,n);free(s);return b;}
static void equal(const char *name,const np_buf *b){np_buf a=readmat(name);int ok=a.n==b->n&&!memcmp(a.p,b->p,a.n);free(a.p);if(!ok)die("material-or-receipt-mismatch");}
static void row(np_buf *b,const char *k,const char *v){np_puts(b,k);np_puts(b,"\t");np_puts(b,v);np_puts(b,"\n");}
static void number(np_buf *b,long long n){np_putll(b,n);}
static int safe_name(const char *s,int file){if(!s[0]||s[0]=='/'||strpbrk(s,"\t\r\n\\\""))return 0;const char *p=s;while(*p){const char *q=strchr(p,'/');size_t n=q?(size_t)(q-p):strlen(p);if(!n||(n==1&&p[0]=='.')||(n==2&&p[0]=='.'&&p[1]=='.'))return 0;for(size_t i=0;i<n;i++)if(!((p[i]>='a'&&p[i]<='z')||(p[i]>='A'&&p[i]<='Z')||(p[i]>='0'&&p[i]<='9')||p[i]=='_'||(file&&(p[i]=='.'||p[i]=='-'))))return 0;if(!q)break;p=q+1;}return file||!strchr(s,'/');}
static int hcmp(const void *a,const void *b){return strcmp(((const Header *)a)->name,((const Header *)b)->name);}
static void clear_headers(Header *h,int *n){for(int i=0;i<*n;i++){free(h[i].name);free(h[i].text);}*n=0;}
static void add_header(Header *h,int *count,const char *name,char *text,size_t n){size_t z=strlen(name);if(*count==2048||!safe_name(name,1)||z<3||!tx_eq(name+z-2, ".h", 1L << 20)||memchr(text,0,n)||memchr(text,'\r',n))die("header-name-or-text-contract");Header *v=&h[(*count)++];v->name=strdup(name);if(!v->name)die("allocation");v->text=text;v->n=n;cx_sha256_hex(text,n,v->sha);}
static void walk(const char *base,const char *rel,int depth,Header *h,int *n){if(depth>48)die("header-directory-depth");char p[4400];path(p,base,rel);struct stat st;if(lstat(p,&st))die("header-stat");if(S_ISREG(st.st_mode)){size_t z=strlen(rel);if(z>=2&&tx_eq(rel+z-2, ".h", 1L << 20)){size_t bytes;char *s=load(p,&bytes);add_header(h,n,rel,s,bytes);}return;}if(!S_ISDIR(st.st_mode))die("header-symlink-or-nonregular");DIR *d=opendir(p);if(!d)die("header-directory-open");for(;;){errno=0;struct dirent *e=readdir(d);if(!e){int saved=errno,closed=closedir(d);if(saved||closed)die("header-directory-read-or-close");break;}if(tx_eq(e->d_name, ".", 1L << 20)||tx_eq(e->d_name, "..", 1L << 20))continue;char child[4400];if(rel[0])path(child,rel,e->d_name);else{if(strlen(e->d_name)>=sizeof child)die("directory-name-bound");strcpy(child,e->d_name);}walk(base,child,depth+1,h,n);}}
static void sorted(Header *h,int n){qsort(h,(size_t)n,sizeof *h,hcmp);if(!n)die("empty-header-tree");for(int i=1;i<n;i++)if(strcmp(h[i-1].name,h[i].name)>=0)die("duplicate-header-name");}
static np_buf snapshot(void){clear_headers(current,&nc);char p[4400];path(p,root,"include");walk(p,"",0,current,&nc);sorted(current,nc);np_buf b={0};np_puts(&b,"carried-header-inputs-v1\nscope\tcomplete-include-h-tree-plus-explicit-support;not-full-product-SID\n");for(int i=0;i<nc;i++){np_puts(&b,"header\t");np_puts(&b,current[i].name);np_puts(&b,"\t");number(&b,(long long)current[i].n);np_puts(&b,"\t");np_puts(&b,current[i].sha);np_puts(&b,"\n");}const char *support[]={"tools/carried-header-export.cx","tools/cxlib/netpack.cx","seed/unisa_libneed.c","tools/bound","tools/bound.c","unisacc.com","unisacc.com.build.json"};for(int i=0;i<7;i++){char hash[65];path(p,root,support[i]);digest(p,hash);row(&b,support[i],hash);}return b;}
static void stable(const Material *m){np_buf b=snapshot();int ok=b.n==m->inputs.n&&!memcmp(b.p,m->inputs.p,b.n);free(b.p);if(!ok)die("applicable-inputs-changed");char h[65];digest(native,h);if(!tx_eq(h, m->native_sha, 1L << 20))die("native-artifact-changed");digest(m->origin,h);if(!tx_eq(h, m->native_sha, 1L << 20))die("native-origin-artifact-changed");}
static int body_index(const Table *t,const char *s){for(int i=0;i<t->nb;i++)if(tx_eq(t->body[i], s, 1L << 20))return i;die("table-unknown-body");return -1;}
static char *token(char **p){char *s=*p;if(!*s)die("missing-table-token");char *q=strchr(s,' ');if(q){*q=0;*p=q+1;if(!**p)die("table-trailing-space");}else *p=s+strlen(s);if(!safe_name(s,0))die("table-identifier");return s;}
static void parse_deps(Table *t,char *s,int **out,int *n){int *v=malloc(1024*sizeof *v);if(!v)die("allocation");char *last=0;*n=0;while(*s){char *name=token(&s);if(last&&strcmp(last,name)>=0)die("table-dependency-order-or-duplicate");if(*n==1024)die("table-dependency-bound");v[(*n)++]=body_index(t,name);last=name;}if(!*n)die("table-empty-closure");*out=v;}
static Table *table(const np_buf *bytes){if(!bytes->n||bytes->n>8388608||bytes->p[bytes->n-1]!='\n'||memchr(bytes->p,0,bytes->n)||memchr(bytes->p,'\r',bytes->n))die("table-wire");Table *t=calloc(1,sizeof *t);char *s=strdup(bytes->p);if(!t||!s)die("allocation");char *p=s,*e=strchr(p,'\n');*e=0;if(strncmp(p,"NAMES ",6))die("table-names-row");p+=6;while(*p){char *name=token(&p);if(t->nb==1024||(t->nb&&strcmp(t->body[t->nb-1],name)>=0))die("table-body-order-bound");t->body[t->nb++]=strdup(name);}p=e+1;int seen_roots=0;while(*p){e=strchr(p,'\n');if(!e)die("table-line");*e=0;if(!strncmp(p,"KEY ",4)){if(seen_roots||t->nk==8192)die("table-key-bound-order");char *q=p+4,*key=token(&q);if(!*q||(t->nk&&strcmp(t->key[t->nk-1],key)>=0))die("table-key-order");t->key[t->nk]=strdup(key);parse_deps(t,q,&t->dep[t->nk],&t->nd[t->nk]);t->nk++;}else if(!strncmp(p,"ROOTS_CLOSURE ",14)){if(seen_roots)die("duplicate-root-row");int *v,n;parse_deps(t,p+14,&v,&n);memcpy(t->roots,v,(size_t)n*sizeof *v);t->nr=n;free(v);seen_roots=1;}else die("unknown-table-row");p=e+1;}free(s);if(!seen_roots||!t->nk||!t->nb)die("incomplete-table");return t;}
static void free_table(Table *t){for(int i=0;i<t->nb;i++)free(t->body[i]);for(int i=0;i<t->nk;i++){free(t->key[i]);free(t->dep[i]);}free(t);}
static np_buf run_table(const char *include_dir){np_result r;char why[1400];char *v[]={bound,"12",native,"table",(char *)include_dir,0};if(np_run(v,root,0,15,&r,why,sizeof why))die(why);if(r.rc||r.errn){if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);die("native-libneed-table-failed");}np_buf b={0};np_put(&b,r.out,r.outn);np_free(&r);Table *t=table(&b);free_table(t);return b;}
static void names(np_buf *b,const char *var,char **v,int n){np_puts(b,"char *");np_puts(b,var);np_puts(b," = \"");for(int i=0;i<n;i++){np_puts(b,v[i]);np_puts(b,"\\000");}np_puts(b,"\";\n");}
static void define(np_buf *b,const char *name,int n){np_puts(b,"#define ");np_puts(b,name);np_puts(b," ");number(b,n);np_puts(b,"\n");}
static void array(np_buf *b,const char *name,const int *v,int n){np_puts(b,"long ");np_puts(b,name);np_puts(b,"[");number(b,n?n:1);np_puts(b,"] = {");if(!n)np_puts(b,"0");for(int i=0;i<n;i++){if(i)np_puts(b,", ");number(b,v[i]);}np_puts(b,"};\n");}
static np_buf render(Header *h,int n,const Table *t){np_buf b={0};char *hn[2048];for(int i=0;i<n;i++)hn[i]=h[i].name;names(&b,"HDR_NAMES",hn,n);define(&b,"NHDR",n);np_puts(&b,"\n");const char *hex="0123456789abcdef";for(int i=0;i<n;i++){np_puts(&b,"/* HDR_");number(&b,i);np_puts(&b,": include/");np_puts(&b,h[i].name);np_puts(&b,", verbatim */\nchar *HDR_");number(&b,i);np_puts(&b," =\n");size_t at=0;do{np_puts(&b,"  \"");size_t end=at+20;if(end>h[i].n)end=h[i].n;for(;at<end;at++){unsigned c=(unsigned char)h[i].text[at];char x[5]={'\\','x',hex[c>>4],hex[c&15],0};np_puts(&b,x);}np_puts(&b,at==h[i].n?"\";\n":"\"\n");}while(at<h[i].n);np_puts(&b,"\n");}np_puts(&b,"/* the i-th header's text */\nchar *hdr_text(int i) {\n");for(int i=0;i<n;i++){np_puts(&b,"  if (i == ");number(&b,i);np_puts(&b,") return HDR_");number(&b,i);np_puts(&b,";\n");}np_puts(&b,"  return 0;\n}\n\n/* LIBKEY k reaches carried bodies LIBKEY_DEP[LIBKEY_OFF[k]..LIBKEY_OFF[k+1]) */\n");names(&b,"LIBKEY_NAMES",(char **)t->key,t->nk);define(&b,"NLIBKEY",t->nk);int *offs=malloc((size_t)(t->nk+1)*sizeof *offs);if(!offs)die("allocation");offs[0]=0;for(int i=0;i<t->nk;i++){if(offs[i]>1048576-t->nd[i])die("dependency-total-bound");offs[i+1]=offs[i]+t->nd[i];}int total=offs[t->nk],*deps=malloc((size_t)(total?total:1)*sizeof *deps);if(!deps)die("allocation");for(int i=0;i<t->nk;i++)memcpy(deps+offs[i],t->dep[i],(size_t)t->nd[i]*sizeof *deps);array(&b,"LIBKEY_OFF",offs,t->nk+1);array(&b,"LIBKEY_DEP",deps,total);free(offs);free(deps);names(&b,"LIBBODY_NAMES",(char **)t->body,t->nb);define(&b,"NLIBBODY",t->nb);np_puts(&b,"/* bodies the compiler itself reaches (libneed.ROOTS), needed whenever pruning is on */\n");array(&b,"LIBROOT_DEP",t->roots,t->nr);define(&b,"NLIBROOT",t->nr);np_puts(&b,"\n");return b;}
static void expect(char **p,const char *s){size_t n=strlen(s);if(strncmp(*p,s,n))die("old-generated-grammar");*p+=n;}
static int hx(char c){if(c>='0'&&c<='9')return c-'0';if(c>='a'&&c<='f')return c-'a'+10;die("old-generated-hex");return 0;}
/* Decode every old name and every byte. The independently rerun native table
 * then rebuilds the ENTIRE suffix, including routing, key names, offsets,
 * dependencies, body names, roots and all counts. Exact suffix equality is a
 * complete canonical parse oracle; no numeric-array substring is ignored. */
static char *decode_old(const np_buf *old){if(!old->n||memchr(old->p,0,old->n)||memchr(old->p,'\r',old->n))die("old-generated-wire");char *start=strstr(old->p,"char *HDR_NAMES = \"");if(!start||strstr(start+1,"char *HDR_NAMES = \""))die("old-generated-unique-name-table");char *p=start;expect(&p,"char *HDR_NAMES = \"");clear_headers(previous,&np);while(strncmp(p,"\";\n",3)){char *end=strstr(p,"\\000");if(!end||end-p>4000)die("old-header-name-extent");size_t z=(size_t)(end-p);char name[4400];memcpy(name,p,z);name[z]=0;char *empty=malloc(1);if(!empty)die("allocation");empty[0]=0;add_header(previous,&np,name,empty,0);p=end+4;}expect(&p,"\";\n#define NHDR ");char num[40];snprintf(num,sizeof num,"%d\n\n",np);expect(&p,num);for(int i=0;i<np;i++){np_buf marker={0};np_puts(&marker,"/* HDR_");number(&marker,i);np_puts(&marker,": include/");np_puts(&marker,previous[i].name);np_puts(&marker,", verbatim */\nchar *HDR_");number(&marker,i);np_puts(&marker," =\n");expect(&p,marker.p);free(marker.p);np_buf text={0};for(;;){expect(&p,"  \"");int chars=0;while(*p!='\"'){expect(&p,"\\x");if(!p[0]||!p[1])die("old-byte-truncation");char c=(char)(hx(p[0])*16+hx(p[1]));np_put(&text,&c,1);p+=2;chars++;if(chars>20)die("old-byte-chunk-bound");}p++;if(*p==';'){expect(&p,";\n\n");break;}if(chars!=20)die("old-byte-chunk-size");expect(&p,"\n");}if(memchr(text.p,0,text.n)||memchr(text.p,'\r',text.n))die("old-header-text-contract");free(previous[i].text);previous[i].text=text.p;previous[i].n=text.n;cx_sha256_hex(text.p,text.n,previous[i].sha);}for(int i=1;i<np;i++)if(strcmp(previous[i-1].name,previous[i].name)>=0)die("old-header-name-order");return start;}
static void ensure_dirs(const char *base,const char *name){char tmp[4400];path(tmp,base,name);for(char *p=tmp+strlen(base)+1;*p;p++)if(*p=='/'){*p=0;struct stat st;if(lstat(tmp,&st)){if(errno!=ENOENT||mkdir(tmp,0700))die("oracle-directory-create");}else if(!S_ISDIR(st.st_mode))die("oracle-directory-type");*p='/';}}
static void oracle_tree(int create){char base[4400];path(base,mat,"oracle-include");if(create&&mkdir(base,0700))die("oracle-tree-create");for(int i=0;i<np;i++){char p[4400];if(create)ensure_dirs(base,previous[i].name);path(p,base,previous[i].name);if(create)write_new(p,previous[i].text,previous[i].n,0600);else{size_t n;char *s=load(p,&n);int ok=n==previous[i].n&&!memcmp(s,previous[i].text,n);free(s);if(!ok)die("oracle-header-copy-mismatch");}}Header *seen=calloc(2048,sizeof *seen);int ns=0;if(!seen)die("allocation");walk(base,"",0,seen,&ns);sorted(seen,ns);if(ns!=np)die("oracle-tree-extra-or-missing-header");for(int i=0;i<np;i++)if(!tx_eq(seen[i].name, previous[i].name, 1L << 20)||!tx_eq(seen[i].sha, previous[i].sha, 1L << 20))die("oracle-tree-content");clear_headers(seen,&ns);free(seen);}
static void generate(Material *m,int create){char *suffix=decode_old(&m->old);oracle_tree(create);char p[4400];path(p,mat,"oracle-include");m->old_table=run_table(p);Table *t=table(&m->old_table);np_buf rebuilt=render(previous,np,t);free_table(t);if(strlen(suffix)!=rebuilt.n||memcmp(suffix,rebuilt.p,rebuilt.n))die("complete-old-header-libneed-oracle-mismatch");free(rebuilt.p);path(p,root,"include");m->new_table=run_table(p);t=table(&m->new_table);np_buf body=render(current,nc,t);free_table(t);np_puts(&m->generated,"/* GENERATED -- do not edit. carried-header-export-v1.\n * producer tools/carried-header-export.cx sha256=");np_puts(&m->generated,m->tool_sha);np_puts(&m->generated,"\n * native libneed sha256=");np_puts(&m->generated,m->native_sha);np_puts(&m->generated,"\n * seed/unisa_libneed.c sha256=");np_puts(&m->generated,m->c_sha);np_puts(&m->generated,"\n * Fresh header bytes and native closures; HOSTCC/nonhermetic trust input.\n * Previous generated bytes/original producer retained in material; no test result.\n */\n\n");np_put(&m->generated,body.p,body.n);free(body.p);}
static np_buf receipt(Material *m){np_buf b={0};np_puts(&b,"carried-header-export-v1\nstatus\tPREPARED\nscope\tcarried-header-text-and-libneed-tables-only;not-NN-or-product-or-test-result\n");row(&b,"root",root);row(&b,"native-origin",m->origin);row(&b,"native-artifact",m->native_sha);row(&b,"native-C-source",m->c_sha);row(&b,"producer",m->tool_sha);row(&b,"trust","HOSTCC-native-artifact-and-C-source-byte-bindings-not-hermetic-or-build-lineage-proof");row(&b,"old-oracle","all-header-names-text-routing-plus-all-key-offset-dependency-body-root-counts-canonical-exact");const char *names[]={"inputs.tsv","previous-unisa_headers.inc","oracle-table.tsv","current-table.tsv","unisa_headers.inc"};const np_buf *bufs[]={&m->inputs,&m->old,&m->old_table,&m->new_table,&m->generated};for(int i=0;i<5;i++){char h[65];cx_sha256_hex(bufs[i]->p,bufs[i]->n,h);row(&b,names[i],h);}return b;}
static void check_material(Material *m){equal("inputs.tsv",&m->inputs);equal("previous-unisa_headers.inc",&m->old);equal("oracle-table.tsv",&m->old_table);equal("current-table.tsv",&m->new_table);equal("unisa_headers.inc",&m->generated);equal("material.tsv",&m->receipt);oracle_tree(0);}
static int target_kind(Material *m){size_t n;char *s=load(target,&n);int old=n==m->old.n&&!memcmp(s,m->old.p,n),now=n==m->generated.n&&!memcmp(s,m->generated.p,n);free(s);if(!old&&!now)die("target-not-previous-or-this-export");return now?1:0;}
static void field(const np_buf *b,const char *key,char out[4400]){np_buf tag={0};np_puts(&tag,"\n");np_puts(&tag,key);np_puts(&tag,"\t");char *p=strstr(b->p,tag.p);if(!p||strstr(p+1,tag.p))die("unique-material-field");p+=tag.n;char *e=strchr(p,'\n');if(!e||e==p||e-p>=4400)die("material-field-bound");memcpy(out,p,(size_t)(e-p));out[e-p]=0;free(tag.p);}
static void identity(Material *m){char p[4400];path(p,root,"tools/carried-header-export.cx");digest(p,m->tool_sha);char own[65];digest(__FILE__,own);if(!tx_eq(own, m->tool_sha, 1L << 20))die("producer-must-be-root-tool");path(p,root,"seed/unisa_libneed.c");digest(p,m->c_sha);size_t n;char *s=load(native,&n);int elf=n>=64&&!memcmp(s,"\177ELF",4)&&(unsigned char)s[4]==2&&(unsigned char)s[5]==1&&(unsigned char)s[18]==62&&s[19]==0;if(!elf)die("native-libneed-must-be-Linux-x86_64-ELF");cx_sha256_hex(s,n,m->native_sha);free(s);char h[65];digest(m->origin,h);if(!tx_eq(h, m->native_sha, 1L << 20))die("native-copy-origin-mismatch");}
static void sync_kernel(void){char p[4400];path(p,root,"kernel");int fd=open(p,O_RDONLY|O_DIRECTORY|O_CLOEXEC);if(fd<0)die("kernel-directory-open");int bad=fsync(fd),closed=close(fd);if(bad||closed)die("kernel-directory-sync");}
static void install(Material *m){char kernel[4400];path(kernel,root,"kernel");path(lockpath,kernel,".carried-header-export.lock");lockfd=open(lockpath,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(lockfd<0)die("exclusive-install-session");lock_owned=1;stable(m);check_material(m);if(target_kind(m))die("already-installed");char p[4400];path(p,mat,"installed.tsv");if(!absent(p))die("installed-receipt-exists");np_buf pending={0};np_puts(&pending,"carried-header-install-v1\nstatus\tPENDING\nscope\tsingle-generated-header-only-not-product-or-test-result\n");char h[65];cx_sha256_hex(m->receipt.p,m->receipt.n,h);row(&pending,"prepared-receipt",h);save("install.pending.tsv",&pending);free(pending.p);int n=snprintf(temp,sizeof temp,"%s/.carried-header-export-%ld.tmp",kernel,(long)getpid());if(n<0||n>=4400||!absent(temp))die("sibling-temp-path");struct stat st;if(lstat(target,&st)||!S_ISREG(st.st_mode))die("target-type");write_new(temp,m->generated.p,m->generated.n,(int)(st.st_mode&0777));size_t tn;char *ts=load(temp,&tn);int ok=tn==m->generated.n&&!memcmp(ts,m->generated.p,tn);free(ts);if(!ok)die("temporary-output-mismatch");stable(m);check_material(m);if(target_kind(m))die("target-changed-before-rename");if(rename(temp,target))die("generated-target-rename");temp_owned=0;renamed=1;sync_kernel();stable(m);check_material(m);if(!target_kind(m))die("installed-target-mismatch");np_buf done={0};np_puts(&done,"carried-header-install-v1\nstatus\tINSTALLED\nscope\tsingle-generated-header-only-not-product-or-test-result\n");row(&done,"prepared-receipt",h);cx_sha256_hex(m->generated.p,m->generated.n,h);row(&done,"artifact",h);save("installed.tsv",&done);free(done.p);if(close(lockfd))die("guard-close");lockfd=-1;if(unlink(lockpath))die("guard-remove");lock_owned=0;sync_kernel();puts("INSTALLED\tcarried-header-export\tno-product-or-test-result");}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN carried-header-export requires Linux/x86_64 LP64\n",stderr);return 3;
#endif
 int prep=argc>=2&&tx_eq(argv[1], "prepare", 1L << 20);if((prep?argc!=5:argc!=4)||(!prep&&!tx_eq(argv[1], "--verify", 1L << 20)&&!tx_eq(argv[1], "install", 1L << 20))||sizeof(long)!=8||!realpath(argv[2],root)||argv[3][0]!='/'||strlen(argv[3])>=sizeof mat||strpbrk(argv[3],"\r\n\t"))die("usage-prepare-ROOT-NEW_MAT-LIBNEED_NATIVE-or-verify-install-ROOT-MAT");strcpy(mat,argv[3]);path(bound,root,"tools/bound");path(target,root,"kernel/unisa_headers.inc");path(native,mat,"libneed-native");Material m={0};if(prep){if(!realpath(argv[4],m.origin)||strpbrk(m.origin,"\r\n\t"))die("native-origin-realpath");if(mkdir(mat,0700))die("fresh-material-directory");size_t n;char *s=load(m.origin,&n);write_new(native,s,n,0700);free(s);identity(&m);m.inputs=snapshot();s=load(target,&n);np_put(&m.old,s,n);free(s);generate(&m,1);stable(&m);m.receipt=receipt(&m);save("inputs.tsv",&m.inputs);save("previous-unisa_headers.inc",&m.old);save("oracle-table.tsv",&m.old_table);save("current-table.tsv",&m.new_table);save("unisa_headers.inc",&m.generated);save("material.tsv",&m.receipt);check_material(&m);stable(&m);if(target_kind(&m))die("prepare-target-unexpectedly-new");puts("PREPARED\tcarried-header-export\tcomplete-old-oracle-and-fresh-current-table\tHOSTCC-nonhermetic\tno-test-result");return 0;}struct stat st;if(lstat(mat,&st)||!S_ISDIR(st.st_mode))die("material-directory");np_buf recorded=readmat("material.tsv");field(&recorded,"native-origin",m.origin);identity(&m);m.inputs=snapshot();m.old=readmat("previous-unisa_headers.inc");generate(&m,0);m.receipt=receipt(&m);check_material(&m);stable(&m);target_kind(&m);if(tx_eq(argv[1], "install", 1L << 20)){install(&m);return 0;}puts("VERIFIED\tcarried-header-export\tcomplete-old-oracle-and-fresh-current-table\tHOSTCC-nonhermetic\tno-test-result");return 0;
}
