#pragma unisa use chrome_dom
static int failed;
static void ck(int ok, const char *lab) {
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", lab);
    if (!ok) failed++;
}
static int nrows(const char *p) {
    FILE *f = fopen(p, "r");
    char line[128];
    int n = 0;
    if (!f) return -1;
    if (!fgets(line, sizeof line, f)) { fclose(f); return -1; }
    while (fgets(line, sizeof line, f)) n++;
    fclose(f);
    return n;
}
int main(void) {
    ck(nrows("ujs/plans/demo-v2/look-dev/s0-sky-profile.tsv") == 288, "sky-288");
    ck(nrows("ujs/plans/demo-v2/look-dev/s0-water-profile.tsv") == 432, "water-432");
    printf("CHECK_GEN_S0_PROFILE\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
