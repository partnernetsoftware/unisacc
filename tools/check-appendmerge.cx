/* 纯合并库行为与历史模式回归；不执行Git驱动场景。 */
#pragma unisa use cxlib.appendmerge
#pragma unisa use cxlib.netpack
#pragma unisa use tsvx.merge3
static int failed,checks;
static void ck(int ok,const char *name){checks++;printf("%s\t%s\n",ok?"PASS":"FAIL",name);if(!ok)failed++;}
static char *table(int kind,const char *tail){np_buf b={0};np_puts(&b,am_header(kind));np_puts(&b,tail);return b.p;}
static const char *rows[]={"2026-11-09\tTASK\tA\t-\tevidence-A\tfixture\n","task\tgoal\timplementer\ttools/a.cx\tgate\tcontext\t1\t-\tREADY\tfixture\tcheck\n","batch\tIMPLEMENTED\tinterfaces\ttools/a.cx\tSOURCE\tlnx/x86_64\t55\t-\ttools/a.cx\t-\tcov\trc0:A\tproduct\tcommit\n","cov\tinterfaces\tIMPLEMENTED_SEPARATE_BATCH\tfirst\ttools/a.cx\n"};
static void contract(void){
 {const char *header="id\timplementation\tlayer\tsource\tmode\tplatform\tbudget_seconds\tmaterials\tentry\targs\tcoverage\texpect\theaders\n";const char *row="batch\tIMPLEMENTED\tinterfaces\ttools/a.cx\tSOURCE\tlnx/x86_64\t55\t-\ttools/a.cx\t-\tcov\trc0:A\tproduct\n";np_buf old={0},changed={0},out={0},err={0};np_puts(&old,header);np_puts(&old,row);char *modern=table(2,rows[2]);int rc=am_merge(2,old.p,old.n,old.p,old.n,modern,strlen(modern),&out,&err);ck(!rc&&out.n==strlen(modern)&&!memcmp(out.p,modern,out.n),"uncontested-legacy-batches-migration-exact");free(out.p);free(err.p);out=(np_buf){0};err=(np_buf){0};np_puts(&changed,old.p);np_puts(&changed,"other\tIMPLEMENTED\tinterfaces\ttools/b.cx\tSOURCE\tlnx/x86_64\t55\t-\ttools/b.cx\t-\tcov\trc0:A\tproduct\n");rc=am_merge(2,old.p,old.n,changed.p,changed.n,modern,strlen(modern),&out,&err);ck(rc==1&&!out.n,"competing-legacy-batches-migration-refused");free(err.p);err=(np_buf){0};char *bad=table(2,row);rc=am_merge(2,old.p,old.n,old.p,old.n,bad,strlen(bad),&out,&err);ck(rc==2&&!out.n,"migration-modern-short-row-refused");free(out.p);free(err.p);free(old.p);free(changed.p);free(modern);free(bad);}
 {const char *legacy="2026-11-04\told-five\tDONE\t-\tevidence\n2026-11-05\told-seven\tDONE\t\tcommit\tevidence\trole\n";char *b=table(0,legacy);np_buf o={0},t={0},out={0},err={0};np_puts(&o,b);np_puts(&o,rows[0]);np_puts(&t,b);np_puts(&t,"2026-11-09\tTASK\tB\t-\tevidence-B\tfixture\n");int rc=am_merge(0,b,strlen(b),o.p,o.n,t.p,t.n,&out,&err);ck(!rc&&out.p&&strstr(out.p,legacy)&&strstr(out.p,rows[0])&&strstr(out.p,"evidence-B"),"historical-ledger-five-seven-columns-preserved");free(out.p);free(err.p);out=(np_buf){0};err=(np_buf){0};char *empty=table(0,"");rc=am_merge(0,empty,strlen(empty),b,strlen(b),empty,strlen(empty),&out,&err);ck(rc==2&&!out.n,"new-malformed-ledger-columns-refused");free(empty);free(b);free(o.p);free(t.p);free(out.p);free(err.p);}
 for(int k=0;k<4;k++){char *base=table(k,rows[k]);np_buf o={0},t={0},out={0},err={0};np_puts(&o,base);np_puts(&t,base);const char *append=k==0?"2026-11-09\tTASK\tB\t-\tevidence-B\tfixture\n":k==1?"other\tg\timplementer\td\tg\tc\t1\t-\tREADY\to\tc\n":k==2?"other\tPLANNED\tinterfaces\ttools/a.cx\tSOURCE\tlnx/x86_64\t55\t-\ttools/a.cx\t-\tcov\trc0:A\tproduct\trelease\n":"other\tinterfaces\tDECLARED_DEPENDENCY\tother\ttools/a.cx\n";
  np_puts(&o,append);np_puts(&t,append);int rc=am_merge(k,base,strlen(base),o.p,o.n,t.p,t.n,&out,&err);ck(!rc&&out.n==o.n&&!memcmp(out.p,o.p,o.n),"same-append-idempotent");
  np_buf repeat={0},e2={0};rc=am_merge(k,base,strlen(base),out.p,out.n,t.p,t.n,&repeat,&e2);ck(!rc&&repeat.n==out.n&&!memcmp(repeat.p,out.p,out.n),"replay-idempotent");free(repeat.p);free(e2.p);free(out.p);out=(np_buf){0};
  rc=am_merge(k,base,strlen(base),base,strlen(base),am_header(k),strlen(am_header(k)),&out,&err);ck(!rc&&out.n==strlen(am_header(k)),"one-sided-delete");free(out.p);free(err.p);free(o.p);free(t.p);free(base);
 }
 char *b=table(3,"same\tinterfaces\tDECLARED_DEPENDENCY\tbase\ta\n"),*o=table(3,"same\tinterfaces\tDECLARED_DEPENDENCY\tours\ta\n"),*t=table(3,"same\tinterfaces\tDECLARED_DEPENDENCY\ttheirs\ta\n");np_buf out={0},err={0};int rc=am_merge(3,b,strlen(b),o,strlen(o),t,strlen(t),&out,&err);ck(rc==1&&!out.n&&err.p&&strstr(err.p,"ours")&&strstr(err.p,"theirs")&&strstr(err.p,"base"),"competing-change-preserves-three-sides");free(err.p);err=(np_buf){0};rc=am_merge(3,b,strlen(b),am_header(3),strlen(am_header(3)),t,strlen(t),&out,&err);ck(rc==1&&!out.n&&strstr(err.p,"<ABSENT>"),"delete-versus-modify-conflict");free(err.p);err=(np_buf){0};rc=am_merge(3,am_header(3),strlen(am_header(3)),o,strlen(o),t,strlen(t),&out,&err);ck(rc==1&&!out.n,"same-key-different-append-conflict");free(err.p);free(b);free(o);free(t);
 for(int k=0;k<4;k++){char *good=table(k,rows[k]);np_buf bad={0},e={0},r={0};np_puts(&bad,good);np_puts(&bad,"bad\tshort\n");int v=am_merge(k,good,strlen(good),bad.p,bad.n,good,strlen(good),&r,&e);ck(v==2&&!r.n,"strict-column-count");free(e.p);e=(np_buf){0};v=am_merge(k,good,strlen(good),good,strlen(good)-1,good,strlen(good),&r,&e);ck(v==2&&!r.n,"missing-tail-refused");free(e.p);free(r.p);free(bad.p);free(good);}
 {char *b=table(0,"date\told\tDONE\t-\tevidence\n"),*changed=table(0,"date\told\tDONE\t-\tchanged\n"),*shortbase=table(0,"date\told\tDONE\tevidence\n"),*empty=table(0,"");np_buf out={0},err={0};
  int rc=am_merge(0,b,strlen(b),b,strlen(b),b,strlen(b),&out,&err);ck(!rc&&out.n==strlen(b)&&!memcmp(out.p,b,out.n),"legacy-ledger-exact-base-inheritance");free(out.p);free(err.p);out=(np_buf){0};err=(np_buf){0};
  np_puts(&out,"sentinel");char *saved=out.p;rc=am_merge(0,b,strlen(b),changed,strlen(changed),b,strlen(b),&out,&err);ck(rc==2&&out.p==saved&&!strcmp(out.p,"sentinel"),"changed-five-column-ledger-not-inherited-no-publication");free(err.p);err=(np_buf){0};
  rc=am_merge(0,b,strlen(b),b,strlen(b),changed,strlen(changed),&out,&err);ck(rc==2&&out.p==saved&&!strcmp(out.p,"sentinel"),"theirs-new-five-column-ledger-refused");free(err.p);err=(np_buf){0};
  rc=am_merge(0,shortbase,strlen(shortbase),shortbase,strlen(shortbase),empty,strlen(empty),&out,&err);ck(rc==2&&out.p==saved,"base-ledger-under-five-columns-refused");free(err.p);err=(np_buf){0};
  tsm_buf generic={0},why={0};rc=tsm_merge(am_header(0),6,0,b,strlen(b),b,strlen(b),b,strlen(b),&generic,&why);ck(rc==2&&!generic.p,"generic-default-does-not-inherit-domain-exception");free(generic.p);free(why.p);free(out.p);free(err.p);free(b);free(changed);free(shortbase);free(empty);
 }
}
int main(void){contract();printf("APPENDMERGE_CHECK\tchecks=%d\tfailed=%d\n",checks,failed);return failed?1:0;}
