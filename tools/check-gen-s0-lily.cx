#pragma unisa use cxlib.ckassert
#pragma unisa use chrome_dom
static int failed;
int main(void) {
    char *av[6], *out = 0;
    size_t on = 0;
    int rc;
    FILE *f = fopen("ujs/plans/demo-v2/look-dev/lily-pad.png", "rb");
    unsigned char sig[8];
    ck_record(&failed, f != 0, "open");
    if (f) {
        ck_record(&failed, fread(sig, 1, 8, f) == 8 && sig[0] == 137 && sig[1] == 80, "sig");
        fclose(f);
    }
    av[0] = "sh"; av[1] = "./unisacc.com"; av[2] = "tools/gen-s0-lily.cx"; av[3] = "--"; av[4] = "--check"; av[5] = 0;
    rc = cx_runv_timeout(av, 20, &out, &on);
    if (out) { fwrite(out, 1, on, stdout); free(out); }
    ck_record(&failed, rc == 0, "gen-check");
    printf("CHECK_GEN_S0_LILY\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
