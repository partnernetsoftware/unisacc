/* Check for tools/cxlib/lebytes.cx: lb_rd reads N little-endian bytes at an offset (1, 2, 4 and 8 byte
 * widths, top bit set, nonzero offset) and leaves bytes outside the field unread.
 * Check: CHECK_LEBYTES. */
#pragma unisa use cxlib.lebytes

static int passed, failed;
static void check(const char *label, int yes) { if (yes) passed++; else failed++; printf("%s\t%s\tlebytes\n", yes ? "PASS" : "FAIL", label); }

int main(void) {
    static const unsigned char b[12] = {0xee, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x88, 0xee, 0xff, 0x7f};
    check("one-byte", lb_rd(b, 8, 1) == 0x88);
    check("two-byte", lb_rd(b, 1, 2) == 0x0201);
    check("four-byte", lb_rd(b, 1, 4) == 0x04030201);
    check("eight-byte-top-bit", lb_rd(b, 1, 8) == 0x8807060504030201UL);
    check("field-bounded", lb_rd(b, 10, 2) == 0x7fff);
    printf("CHECK_LEBYTES\tpassed=%d\tfailed=%d\n", passed, failed);
    return failed ? 1 : 0;
}
