/* Consumer regression: accepted execution, source/expectation tampering, genuine wrong-output classification. */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.env
static void put(const char *p,const char *s){if(np_writefile(p,s,strlen(s)))exit(2);}
static int invoke(char **v,np_result *r){char why[512]={0};return np_run(v,0,0,10,r,why,sizeof why);}
int main(void){char tmp[]="/tmp/check-ctestsuite-XXXXXX",root[4096],p[4400],mat[4400],out[4400],exe[4400],script[4400],hash[65],eh[65];int fail=0;np_buf manifest={0};np_result r={0};if(!mkdtemp(tmp)||sy_cwd(root,sizeof root)<0)return 2;
    if(cx_fmt(mat,sizeof mat,"%s/mat",tmp)||mkdir(mat,0700)||cx_fmt(p,sizeof p,"%s/tests",tmp)||mkdir(p,0700)||cx_fmt(p,sizeof p,"%s/tests/corpus-ctestsuite",tmp)||mkdir(p,0700)||cx_fmt(exe,sizeof exe,"%s/unisacc.com",root)||cx_fmt(p,sizeof p,"%s/unisacc.com",tmp)||symlink(exe,p))return 2;
    const char *source="int main(void){return 0;}\n";cx_sha256_hex(source,strlen(source),hash);cx_sha256_hex("",0,eh);np_puts(&manifest,"id\tsource\tsource_sha256\texpected\texpected_sha256\texpected_rc\torigin_tags_sha256\n");for(int i=1;i<=220;i++){char line[256];if(cx_fmt(line,sizeof line,"%05d\tcase.c\t%s\tcase.expected\t%s\t0\t-\n",i,hash,eh))return 2;np_puts(&manifest,line);}if(cx_fmt(p,sizeof p,"%s/tests/corpus-ctestsuite/manifest.tsv",tmp)||np_writefile(p,manifest.p,manifest.n)||cx_fmt(p,sizeof p,"%s/case.c",mat))return 2;put(p,source);if(cx_fmt(p,sizeof p,"%s/case.expected",mat))return 2;put(p,"");if(cx_fmt(script,sizeof script,"%s/tools/ctestsuite.cx",root))return 2;
    char *v[]={"sh",exe,script,"--",tmp,mat,out,"1","1",0};for(int i=0;i<3;i++){if(cx_fmt(out,sizeof out,"%s/run-%d",tmp,i))return 2;int e=invoke(v,&r);int expected=i?2:0;fail|=e||r.rc!=expected;if(i==0)fail|=!strstr(r.out?r.out:"","accepted=1")||!strstr(r.out?r.out:"","wrong=0");else fail|=!strstr(r.err?r.err:"","material sha mismatch");np_free(&r);if(i==0){if(cx_fmt(p,sizeof p,"%s/case.c",mat))return 2;put(p,"int main(void){return 7;}\n");}if(i==1){put(p,source);if(cx_fmt(p,sizeof p,"%s/case.expected",mat))return 2;put(p,"wrong");}}
    cx_sha256_hex("wrong",5,eh);free(manifest.p);manifest.p=0;manifest.n=manifest.cap=0;np_puts(&manifest,"id\tsource\tsource_sha256\texpected\texpected_sha256\texpected_rc\torigin_tags_sha256\n");for(int i=1;i<=220;i++){char line[256];if(cx_fmt(line,sizeof line,"%05d\tcase.c\t%s\tcase.expected\t%s\t0\t-\n",i,hash,eh))return 2;np_puts(&manifest,line);}if(cx_fmt(p,sizeof p,"%s/tests/corpus-ctestsuite/manifest.tsv",tmp)||np_writefile(p,manifest.p,manifest.n)||cx_fmt(out,sizeof out,"%s/wrong",tmp))return 2;free(manifest.p);fail|=invoke(v,&r)||r.rc!=1||!strstr(r.out?r.out:"","wrong=1");np_free(&r);
    {char *clean[]={"rm","-rf",tmp,0};fail|=invoke(clean,&r)||r.rc;np_free(&r);}printf("CHECK_CTESTSUITE\tchecks=4\tfailed=%d\n",fail);return fail?1:0;
}
