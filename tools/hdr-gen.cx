#pragma unisa use sys.io
#pragma unisa use text.text
/* Project exec/facts/pp-autoinc.tsv onto the compiler and runtime header tables.
   sh ./unisacc.com tools/hdr-gen.cx -- --check
   sh ./unisacc.com tools/hdr-gen.cx -- --write
   Six header names, file order. Each name is a lowercase stem, one dot, then h.
   A null out-pointer returns 4. An index outside 0..count-1 returns 2.
   These names are not pipeline formats.
   No libc and no include. */
#define TSV "exec/facts/pp-autoinc.tsv"
#define NROW 6
#define NAMEMAX 32
#define FILECAP 4096
#define CHECKCAP 4096
#define HEAD1 "# value"
#define HEAD2 "# source: src/front_pp.c autoinc() header order"

static char rows[NROW][NAMEMAX];
static int nrows;

static int fail(const char *why) {
    sy_eprintf("hdr-gen\tFAIL\t%s\n", why);
    return 1;
}

static int hdr_ok(const char *s, int n) {
    int i, dot = -1;
    if (n < 3 || n >= NAMEMAX) return 0;
    if (s[n - 2] != '.' || s[n - 1] != 'h') return 0;
    for (i = 0; i < n; i++) {
        if (s[i] == '.') {
            if (dot >= 0) return 0;
            dot = i;
            continue;
        }
        if (s[i] < 'a' || s[i] > 'z') return 0;
    }
    if (dot < 1) return 0;
    return 1;
}

static void copy_field(char *dst, const char *s, int n) {
    int i;
    for (i = 0; i < n; i++) dst[i] = s[i];
    dst[n] = 0;
}

static int take_row(const char *line, int n) {
    int i;
    if (nrows >= NROW) return fail("hdr-count");
    for (i = 0; i < n; i++) if (line[i] == '\t') return fail("row-fields");
    if (!hdr_ok(line, n)) return fail("hdr-charset");
    copy_field(rows[nrows], line, n);
    nrows++;
    return 0;
}

static int parse_tsv(char *b, size_t n) {
    size_t i = 0;
    int saw = 0;
    if (n == 0 || b[n - 1] != '\n') return fail("tsv-newline");
    while (i < n) {
        size_t e = i;
        while (e < n && b[e] != '\n') e++;
        b[e] = 0;
        if (e == i) return fail("tsv-blank");
        if (saw == 0) {
            if (!tx_eqz(b + i, HEAD1)) return fail("tsv-header");
            saw = 1;
        } else if (saw == 1) {
            if (!tx_eqz(b + i, HEAD2)) return fail("tsv-header");
            saw = 2;
        } else if (b[i] == '#') {
            return fail("tsv-comment");
        } else if (take_row(b + i, (int)(e - i))) {
            return 1;
        }
        i = e + 1;
    }
    if (nrows != NROW) return fail("hdr-count");
    return 0;
}

static int unique_rows(void) {
    int i, j;
    for (i = 0; i < nrows; i++) {
        for (j = i + 1; j < nrows; j++) {
            if (tx_eqz(rows[i], rows[j])) return fail("hdr-dup");
        }
    }
    return 0;
}

static int app(char *dst, int cap, int *n, const char *s) {
    int i = 0;
    while (s[i]) {
        if (*n + 1 >= cap) return -1;
        dst[*n] = s[i];
        *n += 1;
        i++;
    }
    dst[*n] = 0;
    return 0;
}

static int app_digit(char *dst, int cap, int *n, int d) {
    char s[2];
    if (d < 0 || d > 9) return -1;
    s[0] = (char)('0' + d);
    s[1] = 0;
    return app(dst, cap, n, s);
}

static int emit_mod(char *dst, int cap, const char *prefix) {
    int n = 0, i;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa module hdrname\n")) return -1;
    if (app(dst, cap, &n, "/* Generated by tools/hdr-gen.cx from exec/facts/pp-autoinc.tsv.\n")) return -1;
    if (app(dst, cap, &n, "   Do not edit by hand. Names are the autoinc header order.\n")) return -1;
    if (app(dst, cap, &n, "   A null out-pointer returns 4. An index outside 0..count-1 returns 2.\n")) return -1;
    if (app(dst, cap, &n, "   No libc and no include. */\n")) return -1;
    if (app(dst, cap, &n, "int ")) return -1;
    if (app(dst, cap, &n, prefix)) return -1;
    if (app(dst, cap, &n, "_count(void) {\n    return ")) return -1;
    if (app_digit(dst, cap, &n, nrows)) return -1;
    if (app(dst, cap, &n, ";\n}\n")) return -1;
    if (app(dst, cap, &n, "int ")) return -1;
    if (app(dst, cap, &n, prefix)) return -1;
    if (app(dst, cap, &n, "_at(int index, const char **name) {\n")) return -1;
    if (app(dst, cap, &n, "    if (!name) return 4;\n")) return -1;
    for (i = 0; i < nrows; i++) {
        if (app(dst, cap, &n, "    if (index == ")) return -1;
        if (app_digit(dst, cap, &n, i)) return -1;
        if (app(dst, cap, &n, ") { *name = \"")) return -1;
        if (app(dst, cap, &n, rows[i])) return -1;
        if (app(dst, cap, &n, "\"; return 0; }\n")) return -1;
    }
    if (app(dst, cap, &n, "    return 2;\n}\n")) return -1;
    return n;
}

static int emit_check(char *dst, int cap) {
    int n = 0, i;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa use compiler.hdrname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use runtime.hdrname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use compiler.formatname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use runtime.formatname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use sys.io\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use text.text\n")) return -1;
    if (app(dst, cap, &n, "/* Generated by tools/hdr-gen.cx. Narrow check of the six autoinc headers. */\n")) return -1;
    if (app(dst, cap, &n, "int main(void) {\n")) return -1;
    if (app(dst, cap, &n, "    const char *name; const char *other; const char *fmt; const char **missing;\n")) return -1;
    if (app(dst, cap, &n, "    int i; int j;\n")) return -1;
    if (app(dst, cap, &n, "    missing = 0;\n")) return -1;
    if (app(dst, cap, &n, "    if (hdr_count() != 6 || rhd_count() != 6) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (pft_count() != 6 || rpt_count() != 6) return 1;\n")) return -1;
    for (i = 0; i < nrows; i++) {
        if (app(dst, cap, &n, "    if (hdr_at(")) return -1;
        if (app_digit(dst, cap, &n, i)) return -1;
        if (app(dst, cap, &n, ", &name) || !tx_eqz(name, \"")) return -1;
        if (app(dst, cap, &n, rows[i])) return -1;
        if (app(dst, cap, &n, "\")) return 1;\n")) return -1;
        if (app(dst, cap, &n, "    if (rhd_at(")) return -1;
        if (app_digit(dst, cap, &n, i)) return -1;
        if (app(dst, cap, &n, ", &other) || !tx_eqz(other, name)) return 1;\n")) return -1;
    }
    if (app(dst, cap, &n, "    for (i = 0; i < hdr_count(); i++) {\n")) return -1;
    if (app(dst, cap, &n, "        if (hdr_at(i, &name)) return 1;\n")) return -1;
    if (app(dst, cap, &n, "        for (j = 0; j < pft_count(); j++) {\n")) return -1;
    if (app(dst, cap, &n, "            if (pft_at(j, &fmt) || tx_eqz(name, fmt)) return 1;\n")) return -1;
    if (app(dst, cap, &n, "            if (rpt_at(j, &fmt) || tx_eqz(name, fmt)) return 1;\n")) return -1;
    if (app(dst, cap, &n, "        }\n")) return -1;
    if (app(dst, cap, &n, "    }\n")) return -1;
    if (app(dst, cap, &n, "    if (hdr_at(0, missing) != 4) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rhd_at(0, missing) != 4) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (hdr_at(-1, &name) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (hdr_at(6, &name) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rhd_at(-1, &name) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rhd_at(6, &name) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    sy_printf(\"CX_HDR\\tok=6\\tformats=6\\tfailed=0\\n\");\n")) return -1;
    if (app(dst, cap, &n, "    return 0;\n}\n")) return -1;
    return n;
}

static int same_bytes(const char *a, size_t an, const char *b, int bn) {
    int i;
    if (an != (size_t)bn) return 0;
    for (i = 0; i < bn; i++) if (a[i] != b[i]) return 0;
    return 1;
}

static int one_file(int dowrite, const char *path, const char *body, int n) {
    size_t on = 0;
    char *cur;
    if (dowrite) {
        if (cx_write(path, body, (size_t)n)) return fail("write");
        return 0;
    }
    cur = cx_read(path, &on);
    if (!cur) return fail(path);
    if (!same_bytes(cur, on, body, n)) return fail(path);
    return 0;
}

int main(int argc, char **argv) {
    size_t nb = 0;
    char *b;
    char file[FILECAP], check[CHECKCAP];
    int dowrite, fn, cn;
    if (argc != 2 || (!tx_eqz(argv[1], "--check") && !tx_eqz(argv[1], "--write"))) {
        sy_eprintf("hdr-gen\tusage\t--check|--write\n");
        return 2;
    }
    dowrite = tx_eqz(argv[1], "--write");
    b = cx_read(TSV, &nb);
    if (!b) return fail("tsv-read");
    if (parse_tsv(b, nb)) return 1;
    if (unique_rows()) return 1;
    cn = emit_check(check, CHECKCAP);
    if (cn < 0) return fail("emit-check");
    fn = emit_mod(file, FILECAP, "hdr");
    if (fn < 0) return fail("emit-compiler");
    if (one_file(dowrite, "cx/compiler/hdrname.cx", file, fn)) return 1;
    fn = emit_mod(file, FILECAP, "rhd");
    if (fn < 0) return fail("emit-runtime");
    if (one_file(dowrite, "cx/runtime/hdrname.cx", file, fn)) return 1;
    if (one_file(dowrite, "tools/check-cx-hdr.cx", check, cn)) return 1;
    if (dowrite) sy_printf("HDR_GEN\tWROTE\trows=%d\n", nrows);
    else sy_printf("HDR_GEN\tCHECK\trows=%d\n", nrows);
    return 0;
}
