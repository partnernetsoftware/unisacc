/* Tool selfcheck for tools/refworkspace.cx. Workspace boundaries and missing
 * frozen headers are checked without requiring a built classic compiler. */
#pragma unisa use refworkspace
#pragma unisa use sys.fs
#pragma unisa use sys.env
int main(void){
    char temp[4096],root[4096],elf[4096],dir[4096];
    if(!getcwd(root,sizeof root)||sy_mkdtemp(sy_tmpdir(),"refworkspace-",temp,sizeof temp))return 2;
    if(cx_path_join(elf,sizeof elf,root,"ua_ref"))return 2;
    int bad=rw_open(root,elf,dir,sizeof dir)!=2;
    if(cx_path_join(elf,sizeof elf,root,"sub/ua_ref"))return 2;
    bad+=rw_open(root,elf,dir,sizeof dir)!=2;
    if(cx_path_join(elf,sizeof elf,temp,"ua_ref"))return 2;
    bad+=rw_open(root,elf,dir,sizeof dir)!=2;
    bad+=rw_verify(temp)!=0;
    if(sy_rmdir(temp))return 2;
    printf("CHECK_REFWORKSPACE\tchecks=4\tfailed=%d\n",bad);return bad?1:0;
}
