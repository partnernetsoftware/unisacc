#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use text.text
/* Project the eighteen gold-export nets onto cx/compiler/netname.cx.
   sh ./unisacc.com tools/net-gen.cx -- --check
   sh ./unisacc.com tools/net-gen.cx -- --write
   --write-src is refused: src/network.cx waits until after install.
   Order is exec/pipeline/gold-stages.tsv (the same indexes as nw_name).
   Membership is weights/gold/NAME.tsv: the first line must name that
   stage and say it was generated by gold-export. lexcls and lexword
   are declared beside those tables and are not part of the eighteen.
   No libc and no include. */
#define LIST "exec/pipeline/gold-stages.tsv"
#define OUT "cx/compiler/netname.cx"
#define GOLD "weights/gold"
#define NNET 18
#define NAMEMAX 32
#define GENCAP 8192

typedef struct {
    char name[NAMEMAX];
} Row;

static Row rows[NNET];
static int nrows;
static int nexport;
static const char *why;

static int fail(const char *w) {
    sy_eprintf("net-gen\tFAIL\t%s\n", w);
    return 1;
}

static int name_ok(const char *s, int n) {
    int i;
    if (n < 1 || n >= NAMEMAX) return 0;
    for (i = 0; i < n; i++) if (s[i] < 'a' || s[i] > 'z') return 0;
    return 1;
}

static void copy_field(char *dst, const char *s, int n) {
    int i;
    for (i = 0; i < n; i++) dst[i] = s[i];
    dst[n] = 0;
}

static int take_row(const char *line, int n) {
    int i;
    if (nrows >= NNET) return fail("net-count");
    for (i = 0; i < n; i++) if (line[i] == '\t') return fail("row-fields");
    if (!name_ok(line, n)) return fail("row-charset");
    copy_field(rows[nrows].name, line, n);
    nrows++;
    return 0;
}

static int parse(char *b, size_t n) {
    size_t i = 0;
    int saw = 0;
    if (n == 0 || b[n - 1] != '\n') return fail("tsv-newline");
    while (i < n) {
        size_t e = i;
        while (e < n && b[e] != '\n') e++;
        b[e] = 0;
        if (e == i) return fail("blank-line");
        if (!saw) {
            if (!tx_eqz(b + i, "# stage")) return fail("header");
            saw = 1;
        } else if (b[i] == '#') {
            return fail("extra-comment");
        } else if (take_row(b + i, (int)(e - i))) {
            return 1;
        }
        i = e + 1;
    }
    if (nrows != NNET) return fail("net-count");
    return 0;
}

static int unique_names(void) {
    int i, j;
    for (i = 0; i < nrows; i++)
        for (j = i + 1; j < nrows; j++)
            if (tx_eqz(rows[i].name, rows[j].name)) return fail("name-dup");
    return 0;
}

static int listed(const char *name) {
    int i;
    for (i = 0; i < nrows; i++) if (tx_eqz(rows[i].name, name)) return 1;
    return 0;
}

static int app(char *dst, int cap, int *n, const char *s) {
    int i = 0;
    while (s[i]) {
        if (*n + 1 >= cap) return -1;
        dst[*n] = s[i];
        *n += 1;
        i++;
    }
    dst[*n] = 0;
    return 0;
}

static int app_u(char *dst, int cap, int *n, int v) {
    char s[4];
    int i = 0;
    if (v < 0 || v > 99) return -1;
    if (v >= 10) s[i++] = (char)('0' + v / 10);
    s[i++] = (char)('0' + (v % 10));
    s[i] = 0;
    return app(dst, cap, n, s);
}

static int path_of(char *dst, int cap, const char *name) {
    int n = 0;
    dst[0] = 0;
    if (app(dst, cap, &n, GOLD "/")) return -1;
    if (app(dst, cap, &n, name)) return -1;
    if (app(dst, cap, &n, ".tsv")) return -1;
    return 0;
}

/* First line, without the newline. -1 on error, -2 when it does not fit. */
static int first_line(const char *path, char *dst, int cap) {
    char buf[512];
    int fd, n, i;
    long r;
    fd = sy_open_read(path);
    if (fd < 0) return -1;
    r = sy_read(fd, buf, (long)sizeof buf);
    sy_close(fd);
    if (r < 0) return -1;
    n = (int)r;
    i = 0;
    while (i < n && buf[i] != '\n') i++;
    if (i == n) return -2;
    if (i + 1 > cap) return -2;
    copy_field(dst, buf, i);
    return i;
}

static int header_ok(const char *line, int n, const char *name) {
    char prefix[64];
    int pn = 0;
    prefix[0] = 0;
    if (app(prefix, (int)sizeof prefix, &pn, "# stage ")) return 0;
    if (app(prefix, (int)sizeof prefix, &pn, name)) return 0;
    if (app(prefix, (int)sizeof prefix, &pn, ":")) return 0;
    if (n < pn || !tx_same(line, pn, prefix, pn)) return 0;
    if (tx_find(line, n, "generated by", 12) < 0) return 0;
    if (tx_find(line, n, "gold-export", 11) < 0) return 0;
    return 1;
}

static int check_named(void) {
    int i;
    char path[128], line[400];
    int n;
    for (i = 0; i < nrows; i++) {
        if (path_of(path, (int)sizeof path, rows[i].name)) return fail("path");
        n = first_line(path, line, (int)sizeof line);
        if (n == -2) return fail("header-line");
        if (n < 0) return fail("gold-read");
        if (!header_ok(line, n, rows[i].name)) return fail("gold-header");
    }
    return 0;
}

static int stem_of(const char *path, char *dst, int cap) {
    const char *s = path, *base = path;
    int n = 0, i;
    while (*s) {
        if (*s == '/') base = s + 1;
        s++;
    }
    while (base[n]) {
        if (base[n] == '.' && base[n + 1] == 't' && base[n + 2] == 's' && base[n + 3] == 'v' && base[n + 4] == 0)
            break;
        n++;
        if (n >= cap) return -1;
    }
    if (base[n] != '.') return -1;
    for (i = 0; i < n; i++) dst[i] = base[i];
    dst[n] = 0;
    return n;
}

static int on_gold(const char *path, void *ctx) {
    char name[NAMEMAX], line[400];
    int n, ln;
    (void)ctx;
    n = stem_of(path, name, NAMEMAX);
    if (n < 0) { why = "gold-file"; return 1; }
    ln = first_line(path, line, (int)sizeof line);
    if (ln == -2) { why = "header-line"; return 1; }
    if (ln < 0) { why = "gold-read"; return 1; }
    if (tx_find(line, ln, "generated by", 12) < 0) return 0;
    if (tx_find(line, ln, "gold-export", 11) < 0) return 0;
    nexport++;
    if (!listed(name)) { why = "extra-stage"; return 1; }
    return 0;
}

static int check_dir(void) {
    int rc;
    nexport = 0;
    why = 0;
    rc = cx_walk(GOLD, on_gold, 0);
    if (why) return fail(why);
    if (rc != 0) return fail("gold-walk");
    if (nexport != NNET) return fail("export-count");
    return 0;
}

static int emit(char *dst, int cap, int *n) {
    int i;
    *n = 0;
    dst[0] = 0;
    if (app(dst, cap, n, "#pragma unisa module netname\n")) return -1;
    if (app(dst, cap, n, "/* Generated by tools/net-gen.cx from exec/pipeline/gold-stages.tsv.\n")) return -1;
    if (app(dst, cap, n, "   Do not edit by hand. Each name is a gold-export table\n")) return -1;
    if (app(dst, cap, n, "   weights/gold/NAME.tsv. A null out-pointer returns 4.\n")) return -1;
    if (app(dst, cap, n, "   An index outside 0..count-1 returns 2. No libc and no include. */\n")) return -1;
    if (app(dst, cap, n, "int nn_count(void) {\n    return ")) return -1;
    if (app_u(dst, cap, n, nrows)) return -1;
    if (app(dst, cap, n, ";\n}\n")) return -1;
    if (app(dst, cap, n, "int nn_at(int index, const char **name) {\n")) return -1;
    if (app(dst, cap, n, "    if (!name) return 4;\n")) return -1;
    for (i = 0; i < nrows; i++) {
        if (app(dst, cap, n, "    if (index == ")) return -1;
        if (app_u(dst, cap, n, i)) return -1;
        if (app(dst, cap, n, ") { *name = \"")) return -1;
        if (app(dst, cap, n, rows[i].name)) return -1;
        if (app(dst, cap, n, "\"; return 0; }\n")) return -1;
    }
    if (app(dst, cap, n, "    return 2;\n}\n")) return -1;
    return 0;
}

static int same_bytes(const char *a, size_t an, const char *b, size_t bn) {
    size_t i;
    if (an != bn) return 0;
    for (i = 0; i < an; i++) if (a[i] != b[i]) return 0;
    return 1;
}

int main(int argc, char **argv) {
    size_t n = 0, on = 0;
    char *b, *cur;
    char gen[GENCAP];
    int gn = 0, dowrite = 0;
    if (argc == 2 && tx_eqz(argv[1], "--write-src"))
        return fail("src/network.cx waits until after install");
    if (argc != 2 || (!tx_eqz(argv[1], "--check") && !tx_eqz(argv[1], "--write"))) {
        sy_eprintf("net-gen\tusage\t--check|--write\n");
        return 2;
    }
    dowrite = tx_eqz(argv[1], "--write");
    b = cx_read(LIST, &n);
    if (!b) return fail("list-read");
    if (parse(b, n)) return 1;
    if (unique_names()) return 1;
    if (check_named()) return 1;
    if (check_dir()) return 1;
    if (emit(gen, GENCAP, &gn)) return fail("emit");
    if (dowrite) {
        if (cx_write(OUT, gen, (size_t)gn)) return fail("write");
        sy_printf("NET_GEN\tWROTE\t%s\tbytes=%d\n", OUT, gn);
        return 0;
    }
    cur = cx_read(OUT, &on);
    if (!cur) return fail("out-read");
    if (!same_bytes(cur, on, gen, (size_t)gn)) return fail("check-difference");
    sy_printf("NET_GEN\tCHECK\trows=%d\tbytes=%d\n", nrows, gn);
    return 0;
}
