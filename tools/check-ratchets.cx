/* Checks tools/ratchets.cx: sh ./unisacc.com tools/check-ratchets.cx   (from the repo root)
   --rows on tools/ratchets/sample.txt keeps exactly the four rows that name a file above or without a
   baseline (cxraw, cxinclude "module PATH", cxtrunc) or a whole-tree total above its baseline (srcshape
   "src/ total lines"), and drops the stale-row note, the FAIL summary and the boundary note; --only src/
   keeps only the cxinclude and the srcshape total row, --only apps/ only the cxraw row.  A full run prints
   seventeen RATCHET lines including net-deps (gate 14), notcovered, dup-census, no-home-path and ref-job-paths, excluding retired toolsloc, and a RATCHETS line whose ok+fail is 17, with
   exit 0 exactly when fail is 0.
   Prints PASS/FAIL lines and CHECK_RATCHETS<TAB>failed=N. */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use sys.time
#pragma unisa use sysx.run
#pragma unisa use sys.posix
#pragma unisa use sys.env

static int failed;
static void ck(int ok, const char *name) { if (!ok) failed++; printf("%s\tratchets.%s\n", ok ? "PASS" : "FAIL", name); }

static int run_argv(char **argv, char *out, long cap) {
    int ofd, pid, ex = 0, code = 0, sig = 0; long n = 0, r; char junk[4096];
    pid = px_spawn_spool(argv, 0, SY_SPAWN_ERR_TO_OUT, &ofd, 0);
    if (pid < 0) return -1;
    while ((r = sy_read(ofd, out + n, cap - 1 - n)) > 0) n += r;
    out[n] = 0;
    while (sy_read(ofd, junk, sizeof junk) > 0) {}
    sy_close(ofd);
    if (sy_wait_status(pid, 0, &ex, &code, &sig) != pid || !ex) return -1;
    return code;
}
static int run_script(char *script, char **args, char *out, long cap) {
    char *argv[12]; int i = 0, k;
    argv[i++] = "sh"; argv[i++] = "./unisacc.com"; argv[i++] = script; argv[i++] = "--";
    for (k = 0; args[k] && i < 11; k++) argv[i++] = args[k];
    argv[i] = 0;
    return run_argv(argv, out, cap);
}
static int run(char **args, char *out, long cap) { return run_script("tools/ratchets.cx", args, out, cap); }
/* tests/cxinclude.cx --wildcard-file A [B] */
static int wc_run(char *a, char *b, char *out, long cap) {
    char *args[4]; int i = 0;
    args[i++] = "--wildcard-file"; args[i++] = a; if (b) args[i++] = b;
    args[i] = 0;
    return run_script("tests/cxinclude.cx", args, out, cap);
}
static int lines(const char *s) { int c = 0; for (; *s; s++) if (*s == '\n') c++; return c; }
static long where(const char *out, long on, const char *s) {
    long sn = tx_len(s, 512), i, k;
    for (i = 0; i + sn <= on; i++) {
        for (k = 0; k < sn && out[i + k] == s[k]; k++) {}
        if (k == sn) return i;
    }
    return -1;
}
static int has(const char *out, const char *s) { return where(out, tx_len(out, 1 << 16), s) >= 0; }

int main(int argc, char **argv) {
    static char o[1 << 16];
    char *all[] = {"--rows", "tools/ratchets/sample.txt", 0};
    char *src[] = {"--rows", "tools/ratchets/sample.txt", "--only", "src/", 0};
    char *apps[] = {"--rows", "tools/ratchets/sample.txt", "--only", "apps/", 0};
    char *full[] = {0};
    int rc;
    if (argc == 2 && tx_eqz(argv[1], "--full")) goto full_run;
    if (argc > 2 || (argc == 2 && !tx_eqz(argv[1], "--rows-only"))) return 2;
    rc = run(all, o, sizeof o);
    ck(rc == 0 && lines(o) == 4 && has(o, "context_preview.cx has 102") && has(o, "module src/host.cx has 1") && has(o, "tools/new-tool.cx has 8")
       && has(o, "srcshape: src/ total lines 5352, baseline 5331")
       && !has(o, "stale row") && !has(o, "FAIL:") && !has(o, "boundary:"), "rows-keeps-four-offenders");
    rc = run(src, o, sizeof o);
    ck(rc == 0 && lines(o) == 2 && has(o, "module src/host.cx") && has(o, "src/ total lines 5352"), "only-src-through-module-word-and-total-row");
    rc = run(apps, o, sizeof o);
    ck(rc == 0 && lines(o) == 1 && has(o, "apps/csih/probes/context_preview.cx"), "only-apps");
    {   char d[4096], fb[4400], fg[4400], fc[4400]; char ob[1 << 14];
        const char *bad = "#pragma unisa use text.text\n#pragma unisa use sys.fs::*\nint x;\n";
        const char *good = "#pragma unisa use text.text\n#pragma unisa use sys.fs\n";
        const char *cmt = "// #pragma unisa use sys.fs::*\nint y; /* use m::* */\n";
        if (cx_fmt(d, sizeof d, "%s/wc-fixture-%d", sy_tmpdir(), (int)sy_pid()) || sy_mkdir(d, 0700) < 0) { ck(0, "wildcard-fixture-dir"); }
        else {
            cx_fmt(fb, sizeof fb, "%s/bad.cx", d); cx_fmt(fg, sizeof fg, "%s/good.cx", d); cx_fmt(fc, sizeof fc, "%s/cmt.cx", d);
            cx_write(fb, bad, tx_len(bad, 1 << 10)); cx_write(fg, good, tx_len(good, 1 << 10)); cx_write(fc, cmt, tx_len(cmt, 1 << 10));
            rc = wc_run(fb, 0, ob, sizeof ob);
            ck(rc == 1 && has(ob, "cx-wildcard-product") && has(ob, "bad.cx"), "wildcard-product-fixture-fails-with-named-rule");
            rc = wc_run(fg, 0, ob, sizeof ob);
            ck(rc == 0 && !has(ob, "cx-wildcard-product"), "named-import-fixture-passes");
            rc = wc_run(fc, 0, ob, sizeof ob);
            ck(rc == 0 && !has(ob, "cx-wildcard-product"), "wildcard-in-comment-is-not-a-use");
            rc = wc_run(fg, fb, ob, sizeof ob);
            ck(rc == 1 && has(ob, "bad.cx") && !has(ob, "good.cx"), "mixed-fixture-names-only-offender");
            sy_unlink(fb); sy_unlink(fg); sy_unlink(fc); sy_rmdir(d);
        }
    }
    {   /* --plan prints fifteen nodes; --from-run judges a synthetic flow run with one ratchet above baseline */
        static const char *nm[18] = {"cxraw", "cxinclude", "cxapis", "cxtrunc", "cxlibc", "cxplatform", "srcshape", "coreapi", "verwriter", "aluiwidth", "outdep", "check-literal", "net-deps", "notcovered", "dup-census", "no-home-path", "ref-job-paths", "tsv-lint"};
        char d[4096], od[4200], p[4400], ev[1 << 12], line[256], *pl[] = {"--plan", 0}, *fr[] = {"--from-run", d, 0}; long en = 0; int k;
        rc = run(pl, o, sizeof o);
        ck(rc == 0 && lines(o) == 18 && has(o, "PLAN\trk-tsv-lint\t./tools/bound\t55\tsh\t./unisacc.com\ttools/tsv-lint.cx\t--\t--check\n") && has(o, "PLAN\trk-ref-job-paths\t./tools/bound\t55\tsh\t./unisacc.com\ttools/ref-job-paths.cx\t--\t--check\n") && has(o, "PLAN\trk-no-home-path\t./tools/bound\t55\tsh\t./unisacc.com\ttools/no-home-path.cx\t--\t--check\n") &&has(o, "PLAN\trk-cxraw\t./tools/bound\t55\tsh\t./unisacc.com\ttests/cxraw.cx\t--\t--check\n") && has(o, "PLAN\trk-net-deps\t")
           && has(o, "PLAN\trk-notcovered\t./tools/bound\t55\tsh\t./unisacc.com\ttools/notcovered-census.cx\t--\t--check\n")
           && has(o, "PLAN\trk-dup-census\t./tools/bound\t55\tsh\t./unisacc.com\ttools/dup-census.cx\t--\t--check\n"), "plan-fifteen-nodes");
        if (cx_fmt(d, sizeof d, "%s/rk-fixture-%d", sy_tmpdir(), (int)sy_pid()) || cx_fmt(od, sizeof od, "%s/out", d) || sy_mkdir(d, 0700) < 0 || sy_mkdir(od, 0700) < 0) ck(0, "from-run-fixture-dir");
        else {
            for (k = 0; k < 18; k++) {
                const char *body = k == 0 ? "cxraw: apps/x.cx has 3 raw lines, baseline 1\ncxraw: FAIL: 1 file above baseline\n" : "r: ok: fine\n";
                cx_fmt(p, sizeof p, "%s/rk-%s.out", od, nm[k]); cx_write(p, body, tx_len(body, 256));
                cx_fmt(line, sizeof line, "EVT\t%d\trk-%s\tstart\t0\t0\texec\nEVT\t%d\trk-%s\t%s\t5\t%d\tout=1 err=0\n", 2 * k + 1, nm[k], 2 * k + 2, nm[k], k ? "ok" : "fail", k ? 0 : 1);
                if (en + tx_len(line, 256) < (long)sizeof ev) { long l = tx_len(line, 256); for (long j = 0; j < l; j++) ev[en + j] = line[j]; en += l; }
            }
            cx_fmt(p, sizeof p, "%s/events.tsv", d); cx_write(p, ev, en);
            rc = run(fr, o, sizeof o);
            ck(rc == 1 && has(o, "RATCHET\tcxraw\tFAIL\tcxraw: FAIL: 1 file above baseline\n") && has(o, "  cxraw: apps/x.cx has 3 raw lines, baseline 1\n")
               && has(o, "RATCHET\tnet-deps\tok\tr: ok: fine\n") && has(o, "RATCHET\tnotcovered\tok\tr: ok: fine\n") && has(o, "RATCHET\tdup-census\tok\tr: ok: fine\n") && has(o, "RATCHET\tno-home-path\tok\tr: ok: fine\n") && has(o, "RATCHET\tref-job-paths\tok\tr: ok: fine\n") && has(o, "RATCHET\ttsv-lint\tok\tr: ok: fine\n") && has(o, "RATCHETS\tok=17\tfail=1\t") && lines(o) == 20, "from-run-over-baseline-fixture");
            /* Z2 coreapi 5-symbol replay: ratchets --rows, ratchets --from-run, and precommit --from-run must block all 5 CORE-NEW rows */
            {
                const char *z2_core =
                    "CORE-NEW cx/sys/posix.cx\tsy_fchmod\tint (int fd,int mode)\n"
                    "CORE-NEW cx/sys/posix.cx\tsy_umask\tint (int mask)\n"
                    "CORE-NEW cx/sys/posix.cx\tsy_chown\tint (const char*path,int uid,int gid)\n"
                    "CORE-NEW cx/sys/posix.cx\tsy_pipe2_sys\tint (int fds[2],int flags)\n"
                    "CORE-NEW cx/sys/proc.cx\tsy_pipe2\tint (int fds[2],int flags)\n"
                    "CORE-SIG cx/mem/heap.cx\tmm_alloc\tbaseline void *(long n)\tnow void *(size_t n)\n"
                    "CORE-MISSING cx/text/text.cx\ttx_old\t(no non-static definition in any frozen module)\n"
                    "CORE-ALIAS-CALLERS cx/sys/fs.cx\tcx_read\tcaller files 12 > baseline 10\n"
                    "cxinclude: cx-wildcard-product: src/drive.cx uses a use X::* wildcard (product layer must name imports)\n"
                    "FAIL\texec/pp/start-result.tsv\t4 above 2\n"
                    "coreapi: FAIL: 37 modules, 256 exported symbols (baseline 251); new 5, missing 0, signature 0, alias callers 0 (--write ratchets down)\n"
                    "CORE_INTERFACE\tok=0\tnew=5\tmissing=0\tsignature=0\talias=0\n";
                char sf[4400], *ra[] = {"--rows", sf, 0}, *rp[] = {"--rows", sf, "--only", "cx/sys/posix.cx", 0};
                cx_fmt(sf, sizeof sf, "%s/z2-core.txt", d);
                cx_write(sf, z2_core, tx_len(z2_core, 4096));
                rc = run(ra, o, sizeof o);
                ck(rc == 0 && lines(o) == 10 && has(o, "CORE-NEW cx/sys/posix.cx\tsy_fchmod") && has(o, "CORE-NEW cx/sys/proc.cx\tsy_pipe2")
                   && has(o, "CORE-SIG cx/mem/heap.cx\tmm_alloc") && has(o, "CORE-MISSING cx/text/text.cx\ttx_old")
                   && has(o, "CORE-ALIAS-CALLERS cx/sys/fs.cx\tcx_read") && has(o, "cx-wildcard-product: src/drive.cx")
                   && has(o, "FAIL\texec/pp/start-result.tsv\t4 above 2") && !has(o, "coreapi: FAIL:"), "coreapi-and-extended-rows-kept");
                rc = run(rp, o, sizeof o);
                ck(rc == 0 && lines(o) == 4 && has(o, "sy_fchmod") && has(o, "sy_pipe2_sys") && !has(o, "cx/sys/proc.cx"), "coreapi-rows-only-posix");
                sy_unlink(sf);
            }
            /* Field/phrase delimiter extraction: paths with spaces + verwriter/outdep exact path (tools/a.cx.bak must not false-block tools/a.cx) */
            {
                const char *sp_txt =
                    "CORE-NEW cx/sys/my posix.cx\tsy_fchmod\tint (int fd,int mode)\n"
                    "cxtrunc: tools/my tool.cx has 2 calls and no baseline row (a new .cx must have 0)\n"
                    "verwriter: job-v1 has writer tools/a.cx.bak and no baseline row (one writer per record tag)\n"
                    "outdep: b1 has 1 out/ literals in tools/b.cx.bak, baseline 0\n"
                    "cxraw: move target src/drive.cx baseline 3 != move 2\n"
                    "cxlibc: move target cx/sys/posix.cx baseline 5 != move 4\n";
                char sf[4400];
                char *r_all[] = {"--rows", sf, 0};
                char *r_sp[] = {"--rows", sf, "--only", "cx/sys/my posix.cx", 0};
                char *r_vw[] = {"--rows", sf, "--only", "tools/a.cx.bak", 0};
                char *r_tag[] = {"--rows", sf, "--only", "job-v1", 0};
                char *r_mv[] = {"--rows", sf, "--only", "src/drive.cx", 0};
                cx_fmt(sf, sizeof sf, "%s/sp-vw.txt", d);
                cx_write(sf, sp_txt, tx_len(sp_txt, 4096));
                rc = run(r_all, o, sizeof o);
                ck(rc == 0 && lines(o) == 6 && has(o, "cxraw: move target src/drive.cx baseline 3 != move 2")
                   && has(o, "cxlibc: move target cx/sys/posix.cx baseline 5 != move 4"), "space-and-verwriter-outdep-move-rows-6");
                rc = run(r_sp, o, sizeof o);
                ck(rc == 0 && lines(o) == 1 && has(o, "CORE-NEW cx/sys/my posix.cx\tsy_fchmod"), "space-path-only-exact");
                rc = run(r_vw, o, sizeof o);
                ck(rc == 0 && lines(o) == 1 && has(o, "verwriter: job-v1 has writer tools/a.cx.bak"), "verwriter-only-matches-writer-path");
                rc = run(r_tag, o, sizeof o);
                ck(rc == 0 && lines(o) == 0, "verwriter-only-ignores-tag-field");
                rc = run(r_mv, o, sizeof o);
                ck(rc == 0 && lines(o) == 1 && has(o, "cxraw: move target src/drive.cx baseline 3 != move 2"), "move-target-mismatch-only-matches-target-path");
                sy_unlink(sf);
            }
            {
                const char *z2_out =
                    "CORE-NEW cx/sys/posix.cx\tsy_fchmod\tint (int fd,int mode)\n"
                    "CORE-NEW cx/sys/posix.cx\tsy_umask\tint (int mask)\n"
                    "CORE-NEW cx/sys/posix.cx\tsy_chown\tint (const char*path,int uid,int gid)\n"
                    "CORE-NEW cx/sys/posix.cx\tsy_pipe2_sys\tint (int fds[2],int flags)\n"
                    "CORE-NEW cx/sys/proc.cx\tsy_pipe2\tint (int fds[2],int flags)\n"
                    "coreapi: FAIL: 37 modules, 256 exported symbols (baseline 251); new 5, missing 0, signature 0, alias callers 0 (--write ratchets down)\n";
                en = 0;
                for (k = 0; k < 18; k++) {
                    const char *body = (k == 7) ? z2_out : "r: ok: fine\n";
                    int bad = (k == 7);
                    cx_fmt(p, sizeof p, "%s/rk-%s.out", od, nm[k]); cx_write(p, body, tx_len(body, 1024));
                    cx_fmt(line, sizeof line, "EVT\t%d\trk-%s\tstart\t0\t0\texec\nEVT\t%d\trk-%s\t%s\t5\t%d\tout=1 err=0\n",
                           2 * k + 1, nm[k], 2 * k + 2, nm[k], bad ? "fail" : "ok", bad ? 1 : 0);
                    if (en + tx_len(line, 256) < (long)sizeof ev) { long l = tx_len(line, 256); for (long j = 0; j < l; j++) ev[en + j] = line[j]; en += l; }
                }
                cx_fmt(p, sizeof p, "%s/events.tsv", d); cx_write(p, ev, en);
                rc = run(fr, o, sizeof o);
                ck(rc == 1 && has(o, "RATCHET\tcoreapi\tFAIL\tcoreapi: FAIL: 37 modules, 256 exported symbols")
                   && has(o, "  CORE-NEW cx/sys/posix.cx\tsy_fchmod\tint (int fd,int mode)\n")
                   && has(o, "  CORE-NEW cx/sys/proc.cx\tsy_pipe2\tint (int fds[2],int flags)\n")
                   && lines(o) == 24, "coreapi-z2-from-run-emits-5-indented-offenders");
                /* Save ratchets output as DIR/out/ratchets.out and judge via precommit.cx -- --from-run DIR with staged posix.cx & proc.cx */
                cx_fmt(p, sizeof p, "%s/rk-ratchets-save.out", od);
                {
                    char rout[4400], idx[4400], lintd[4400], lp1[4400], lp2[4400];
                    const char *ev_pc =
                        "EVT\t1\tlint\tstart\t0\t0\texec\nEVT\t2\tlint\tok\t5\t0\tout=1\n"
                        "EVT\t3\tlintr1\tstart\t0\t0\texec\nEVT\t4\tlintr1\tok\t5\t0\tout=1\n"
                        "EVT\t5\ttlibfrozen\tstart\t0\t0\texec\nEVT\t6\ttlibfrozen\tok\t5\t0\tout=1\n"
                        "EVT\t99999\tratchets\tfail\t5\t1\tfrom-run\n";
                    const char *lint_ok = "CX_LINT\tfiles=2\tfindings=0\telapsed_ms=1\n";
                    const char *tlib_ok = "TLIB_FAST\tchecked=1\tmismatch=0\n";
                    cx_fmt(rout, sizeof rout, "%s/ratchets.out", od); cx_write(rout, o, tx_len(o, sizeof o));
                    cx_fmt(p, sizeof p, "%s/lint.out", od); cx_write(p, lint_ok, tx_len(lint_ok, 128));
                    cx_fmt(p, sizeof p, "%s/lintr1.out", od); cx_write(p, lint_ok, tx_len(lint_ok, 128));
                    cx_fmt(p, sizeof p, "%s/tlibfrozen.out", od); cx_write(p, tlib_ok, tx_len(tlib_ok, 128));
                    cx_fmt(p, sizeof p, "%s/events.tsv", d); cx_write(p, ev_pc, tx_len(ev_pc, 1024));
                    cx_fmt(lintd, sizeof lintd, "%s/lintdir", d); sy_mkdir(lintd, 0700);
                    cx_fmt(lp1, sizeof lp1, "%s/cx", lintd); sy_mkdir(lp1, 0700);
                    cx_fmt(lp1, sizeof lp1, "%s/cx/sys", lintd); sy_mkdir(lp1, 0700);
                    cx_fmt(lp1, sizeof lp1, "%s/cx/sys/posix.cx", lintd); cx_write(lp1, "/* x */\n", 8);
                    cx_fmt(lp2, sizeof lp2, "%s/cx/sys/proc.cx", lintd); cx_write(lp2, "/* x */\n", 8);
                    cx_fmt(idx, sizeof idx, "%s/test.idx", d);
                    sy_setenv("GIT_INDEX_FILE", idx, 1);
                    {
                        char *rt[] = {"git", "read-tree", "HEAD", 0};
                        char *ci1[] = {"git", "update-index", "--cacheinfo", "100644,e69de29bb2d1d6434b8b29ae775ad8c2e48c5391,cx/sys/posix.cx", 0};
                        char *ci2[] = {"git", "update-index", "--cacheinfo", "100644,e69de29bb2d1d6434b8b29ae775ad8c2e48c5391,cx/sys/proc.cx", 0};
                        char *pc_fr[] = {"--from-run", d, 0};
                        (void)run_argv(rt, o, sizeof o);
                        (void)run_argv(ci1, o, sizeof o);
                        (void)run_argv(ci2, o, sizeof o);
                        rc = run_script("tools/precommit.cx", pc_fr, o, sizeof o);
                        sy_unsetenv("GIT_INDEX_FILE");
                        ck(rc == 1 && has(o, "precommit: blocked: CORE-NEW cx/sys/posix.cx\tsy_fchmod")
                           && has(o, "precommit: blocked: CORE-NEW cx/sys/proc.cx\tsy_pipe2")
                           && has(o, "PRECOMMIT\tstaged_cx=2\tblocked=5")
                           && has(o, "PRECOMMIT_GATE_FAIL\tgate=ratchets\treason=ratchet-over"),
                           "precommit-blocks-z2-coreapi-5-symbols");
                    }
                    /* Now verify verwriter/outdep src/drive.cx.bak does NOT false-block staged src/drive.cx, and space path IS blocked */
                    {
                        const char *vw_rat =
                            "RATCHET\tcoreapi\tFAIL\tcoreapi: FAIL: 1 new\n"
                            "  CORE-NEW apps/my dir/my probe.cx\tsy_fchmod\tint (int fd,int mode)\n"
                            "RATCHET\tverwriter\tFAIL\tverwriter: FAIL: 1 above\n"
                            "  verwriter: job-v1 has writer src/drive.cx.bak and no baseline row (one writer per record tag)\n"
                            "RATCHET\toutdep\tFAIL\toutdep: FAIL: 1 above\n"
                            "  outdep: b1 has 1 out/ literals in src/host.cx.bak, baseline 0\n"
                            "RATCHETS\tok=15\tfail=3\telapsed_ms=10\n";
                        char lt[4400], la[4400], lb[4400], lap[4400], lmd[4400], ls[4400];
                        cx_write(rout, vw_rat, tx_len(vw_rat, 2048));
                        cx_fmt(lt, sizeof lt, "%s/src", lintd); sy_mkdir(lt, 0700);
                        cx_fmt(la, sizeof la, "%s/src/drive.cx", lintd); cx_write(la, "/* a */\n", 8);
                        cx_fmt(lb, sizeof lb, "%s/src/host.cx", lintd); cx_write(lb, "/* b */\n", 8);
                        cx_fmt(lap, sizeof lap, "%s/apps", lintd); sy_mkdir(lap, 0700);
                        cx_fmt(lmd, sizeof lmd, "%s/apps/my dir", lintd); sy_mkdir(lmd, 0700);
                        cx_fmt(ls, sizeof ls, "%s/apps/my dir/my probe.cx", lintd); cx_write(ls, "/* s */\n", 8);
                        sy_setenv("GIT_INDEX_FILE", idx, 1);
                        {
                            char *rt[] = {"git", "read-tree", "HEAD", 0};
                            char *ca[] = {"git", "update-index", "--cacheinfo", "100644,e69de29bb2d1d6434b8b29ae775ad8c2e48c5391,src/drive.cx", 0};
                            char *cb[] = {"git", "update-index", "--cacheinfo", "100644,e69de29bb2d1d6434b8b29ae775ad8c2e48c5391,src/host.cx", 0};
                            char *cs[] = {"git", "update-index", "--add", "--cacheinfo", "100644,e69de29bb2d1d6434b8b29ae775ad8c2e48c5391,apps/my dir/my probe.cx", 0};
                            char *pc_fr[] = {"--from-run", d, 0};
                            (void)run_argv(rt, o, sizeof o);
                            (void)run_argv(ca, o, sizeof o);
                            (void)run_argv(cb, o, sizeof o);
                            rc = run_script("tools/precommit.cx", pc_fr, o, sizeof o);
                            ck(rc == 0 && has(o, "PRECOMMIT\tstaged_cx=2\tblocked=0") && !has(o, "drive.cx.bak") && !has(o, "host.cx.bak"),
                               "precommit-verwriter-outdep-bak-does-not-false-block-prefix");
                            (void)run_argv(cs, o, sizeof o);
                            rc = run_script("tools/precommit.cx", pc_fr, o, sizeof o);
                            ck(rc == 1 && has(o, "precommit: blocked: CORE-NEW apps/my dir/my probe.cx\tsy_fchmod")
                               && has(o, "PRECOMMIT\tstaged_cx=3\tblocked=1"),
                               "precommit-blocks-path-with-space");
                            {
                                const char *mv_rat =
                                    "RATCHET\tcxraw\tFAIL\tcxraw: FAIL: 1 move mismatch\n"
                                    "  cxraw: move target src/drive.cx baseline 3 != move 2\n"
                                    "RATCHET\tcxlibc\tFAIL\tcxlibc: FAIL: 1 move mismatch\n"
                                    "  cxlibc: move target src/host.cx baseline 5 != move 4\n"
                                    "RATCHETS\tok=16\tfail=2\telapsed_ms=10\n";
                                cx_write(rout, mv_rat, tx_len(mv_rat, 1024));
                                rc = run_script("tools/precommit.cx", pc_fr, o, sizeof o);
                                ck(rc == 1 && has(o, "precommit: blocked: cxraw: move target src/drive.cx baseline 3 != move 2")
                                   && has(o, "precommit: blocked: cxlibc: move target src/host.cx baseline 5 != move 4")
                                   && has(o, "PRECOMMIT\tstaged_cx=3\tblocked=2"),
                                   "precommit-blocks-cxraw-cxlibc-move-target-baseline-mismatch");
                            }
                            {
                                const char *gl_rat =
                                    "RATCHET\tsrcshape\tFAIL\tsrcshape: FAIL: 1 over baseline\n"
                                    "  srcshape: src/ total lines 5352, baseline 5331\n"
                                    "RATCHET\tnet-deps\tFAIL\tnet-deps: FAIL: 1 class over baseline\n"
                                    "  net-deps: pp has 15 affected nets of 42, baseline 12 of 42\n"
                                    "RATCHET\tdup-census\tFAIL\tdup-census: FAIL: 1 function over baseline\n"
                                    "  dup-census: tools total lines verbatim_redundant 500, baseline 400\n"
                                    "RATCHETS\tok=15\tfail=3\telapsed_ms=10\n";
                                cx_write(rout, gl_rat, tx_len(gl_rat, 1024));
                                rc = run_script("tools/precommit.cx", pc_fr, o, sizeof o);
                                ck(rc == 1 && has(o, "precommit: blocked: RATCHET srcshape FAIL (srcshape: FAIL: 1 over baseline)")
                                   && has(o, "precommit: blocked: RATCHET net-deps FAIL (net-deps: FAIL: 1 class over baseline)")
                                   && !has(o, "RATCHET dup-census FAIL")
                                   && has(o, "PRECOMMIT\tstaged_cx=3\tblocked=2"),
                                   "precommit-global-ceiling-blocks-when-readset-hit");
                                (void)run_argv(rt, o, sizeof o);
                                (void)run_argv(cs, o, sizeof o);
                                rc = run_script("tools/precommit.cx", pc_fr, o, sizeof o);
                                sy_unsetenv("GIT_INDEX_FILE");
                                ck(rc == 0 && has(o, "PRECOMMIT\tstaged_cx=1\tblocked=0"),
                                   "precommit-global-ceiling-ignores-unaffected-readset");
                            }
                        }
                        sy_unlink(la); sy_unlink(lb); sy_unlink(ls);
                        sy_rmdir(lmd); sy_rmdir(lap); sy_rmdir(lt);
                    }
                    sy_unlink(idx); sy_unlink(lp1); sy_unlink(lp2);
                    cx_fmt(lp1, sizeof lp1, "%s/cx/sys", lintd); sy_rmdir(lp1);
                    cx_fmt(lp1, sizeof lp1, "%s/cx", lintd); sy_rmdir(lp1);
                    sy_rmdir(lintd); sy_unlink(rout);
                    cx_fmt(p, sizeof p, "%s/lint.out", od); sy_unlink(p);
                    cx_fmt(p, sizeof p, "%s/lintr1.out", od); sy_unlink(p);
                    cx_fmt(p, sizeof p, "%s/tlibfrozen.out", od); sy_unlink(p);
                }
            }
            for (k = 0; k < 18; k++) { cx_fmt(p, sizeof p, "%s/rk-%s.out", od, nm[k]); sy_unlink(p); }
            cx_fmt(p, sizeof p, "%s/events.tsv", d); sy_unlink(p); sy_rmdir(od); sy_rmdir(d);
        }
    }
    if (argc == 2) { printf("CHECK_RATCHETS\tfailed=%d\n", failed); return failed ? 1 : 0; }
full_run:
    rc = run(full, o, sizeof o);
    {   int okn = -1, failn = -1; long at = where(o, tx_len(o, sizeof o), "RATCHETS\tok=");
        if (at >= 0) sscanf(o + at, "RATCHETS\tok=%d\tfail=%d", &okn, &failn);
        ck(has(o, "RATCHET\tcxraw\t") && has(o, "RATCHET\tcxinclude\t") && has(o, "RATCHET\tcxapis\t") && has(o, "RATCHET\tcxtrunc\t")
           && has(o, "RATCHET\tcxlibc\t") && has(o, "RATCHET\tcxplatform\t") && has(o, "RATCHET\tsrcshape\t") && has(o, "RATCHET\tcoreapi\t") && !has(o, "RATCHET\ttoolsloc\t")
           && has(o, "RATCHET\tverwriter\t") && has(o, "RATCHET\taluiwidth\t") && has(o, "RATCHET\toutdep\t") && has(o, "RATCHET\tcheck-literal\t") && has(o, "RATCHET\tnet-deps\t") && has(o, "RATCHET\tnotcovered\t") && has(o, "RATCHET\tdup-census\t") && has(o, "RATCHET\tno-home-path\t") && has(o, "RATCHET\tref-job-paths\t") && has(o, "RATCHET\ttsv-lint\t") && okn + failn == 18 && (rc == 0) == (failn == 0), "full-run-fifteen-with-gate14-notcovered-dup-census-without-toolsloc-and-exit");
    }
    printf("CHECK_RATCHETS\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
