/* Checks tools/ratchets.cx: sh ./unisacc.com tools/check-ratchets.cx   (from the repo root)
   --rows on tools/ratchets/sample.txt keeps exactly the four rows that name a file above or without a
   baseline (cxraw, cxinclude "module PATH", cxtrunc) or a whole-tree total above its baseline (srcshape
   "src/ total lines"), and drops the stale-row note, the FAIL summary and the boundary note; --only src/
   keeps only the cxinclude and the srcshape total row, --only apps/ only the cxraw row.  A full run prints
   thirteen RATCHET lines including net-deps (gate 14), excluding retired toolsloc, and a RATCHETS line whose ok+fail is 13, with
   exit 0 exactly when fail is 0.
   Prints PASS/FAIL lines and CHECK_RATCHETS<TAB>failed=N. */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use sys.time
#pragma unisa use sysx.poll
#pragma unisa use sys.posix
#pragma unisa use sys.env

/* an unlinked spool file the drained output of a bounded child goes to */
static int spool_open(void) {
    char t[4096];
    int fd;
    if (cx_fmt(t, sizeof t, "%s/r2b-XXXXXX", sy_tmpdir())) return -1;
    fd = mkstemp(t);
    if (fd >= 0) sy_unlink(t);
    return fd;
}

/* sy_spawn_pipe with a 50 s deadline: the child's stdout (and stderr when EFD is given) is drained here with sy_poll
   into spool files; past the deadline its process group is killed.  OFD/EFD come back as the spool files, rewound,
   and the child is NOT reaped: the caller's sy_wait_status(pid) still reports its real status (128+9 when killed). */
static int spawn_pipe_bounded(char **argv, const char *cwd, int flags, int *ofd, int *efd) {
    int po = -1, pe = -1, pid, fo, fe = -1, open_o = 1, open_e = efd ? 1 : 0, killed = 0;
    long deadline = sy_now_ms() + 50000;
    char chunk[16384];
    pid = sy_spawn_pipe(argv, cwd, flags, &po, efd ? &pe : 0);
    if (pid < 0) return pid;
    fo = spool_open();
    if (efd) fe = spool_open();
    if (fo < 0 || (efd && fe < 0)) { sy_killpg(pid, 9); sy_signal(pid, 9); sy_close(po); if (efd) sy_close(pe); return -EIO; }
    while (open_o || open_e) {
        sy_pollfd_t p[2];
        int n = 0, io = -1, ie = -1, r;
        long left = deadline - sy_now_ms(), g;
        if (left <= 0) {
            if (killed) break;
            sy_killpg(pid, 9); sy_signal(pid, 9); killed = 1; deadline = sy_now_ms() + 2000;
            continue;
        }
        if (open_o) { io = n; p[n].fd = po; p[n].events = SY_POLLIN; p[n].revents = 0; n++; }
        if (open_e) { ie = n; p[n].fd = pe; p[n].events = SY_POLLIN; p[n].revents = 0; n++; }
        r = sy_poll(p, n, left > 200 ? 200 : left);
        if (r < 0) break;
        if (io >= 0 && p[io].revents) {
            g = sy_read(po, chunk, sizeof chunk);
            if (g > 0) { if (sy_write_all(fo, chunk, g)) break; } else open_o = 0;
        }
        if (ie >= 0 && p[ie].revents) {
            g = sy_read(pe, chunk, sizeof chunk);
            if (g > 0) { if (sy_write_all(fe, chunk, g)) break; } else open_e = 0;
        }
    }
    if (open_o || open_e) { sy_killpg(pid, 9); sy_signal(pid, 9); }
    sy_close(po);
    if (efd) sy_close(pe);
    sy_lseek(fo, 0, 0);
    *ofd = fo;
    if (efd) { sy_lseek(fe, 0, 0); *efd = fe; }
    return pid;
}

static int failed;
static void ck(int ok, const char *name) { if (!ok) failed++; printf("%s\tratchets.%s\n", ok ? "PASS" : "FAIL", name); }

static int run_argv(char **argv, char *out, long cap) {
    int ofd, pid, ex = 0, code = 0, sig = 0; long n = 0, r; char junk[4096];
    pid = spawn_pipe_bounded(argv, 0, 0, &ofd, 0);
    if (pid < 0) return -1;
    while ((r = sy_read(ofd, out + n, cap - 1 - n)) > 0) n += r;
    out[n] = 0;
    while (sy_read(ofd, junk, sizeof junk) > 0) {}
    sy_close(ofd);
    if (sy_wait_status(pid, 0, &ex, &code, &sig) != pid || !ex) return -1;
    return code;
}
static int run_script(char *script, char **args, char *out, long cap) {
    char *argv[12]; int i = 0, k;
    argv[i++] = "sh"; argv[i++] = "./unisacc.com"; argv[i++] = script; argv[i++] = "--";
    for (k = 0; args[k] && i < 11; k++) argv[i++] = args[k];
    argv[i] = 0;
    return run_argv(argv, out, cap);
}
static int run(char **args, char *out, long cap) { return run_script("tools/ratchets.cx", args, out, cap); }
/* tests/cxinclude.cx --wildcard-file A [B] */
static int wc_run(char *a, char *b, char *out, long cap) {
    char *args[4]; int i = 0;
    args[i++] = "--wildcard-file"; args[i++] = a; if (b) args[i++] = b;
    args[i] = 0;
    return run_script("tests/cxinclude.cx", args, out, cap);
}
static int lines(const char *s) { int c = 0; for (; *s; s++) if (*s == '\n') c++; return c; }
static long where(const char *out, long on, const char *s) {
    long sn = tx_len(s, 512), i, k;
    for (i = 0; i + sn <= on; i++) {
        for (k = 0; k < sn && out[i + k] == s[k]; k++) {}
        if (k == sn) return i;
    }
    return -1;
}
static int has(const char *out, const char *s) { return where(out, tx_len(out, 1 << 16), s) >= 0; }

int main(int argc, char **argv) {
    static char o[1 << 16];
    char *all[] = {"--rows", "tools/ratchets/sample.txt", 0};
    char *src[] = {"--rows", "tools/ratchets/sample.txt", "--only", "src/", 0};
    char *apps[] = {"--rows", "tools/ratchets/sample.txt", "--only", "apps/", 0};
    char *full[] = {0};
    int rc;
    if (argc == 2 && tx_eqz(argv[1], "--full")) goto full_run;
    if (argc > 2 || (argc == 2 && !tx_eqz(argv[1], "--rows-only"))) return 2;
    rc = run(all, o, sizeof o);
    ck(rc == 0 && lines(o) == 4 && has(o, "context_preview.cx has 102") && has(o, "module src/host.cx has 1") && has(o, "tools/new-tool.cx has 8")
       && has(o, "srcshape: src/ total lines 5352, baseline 5331")
       && !has(o, "stale row") && !has(o, "FAIL:") && !has(o, "boundary:"), "rows-keeps-four-offenders");
    rc = run(src, o, sizeof o);
    ck(rc == 0 && lines(o) == 2 && has(o, "module src/host.cx") && has(o, "src/ total lines 5352"), "only-src-through-module-word-and-total-row");
    rc = run(apps, o, sizeof o);
    ck(rc == 0 && lines(o) == 1 && has(o, "apps/csih/probes/context_preview.cx"), "only-apps");
    {   char d[4096], fb[4400], fg[4400], fc[4400]; char ob[1 << 14];
        const char *bad = "#pragma unisa use text.text\n#pragma unisa use sys.fs::*\nint x;\n";
        const char *good = "#pragma unisa use text.text\n#pragma unisa use sys.fs\n";
        const char *cmt = "// #pragma unisa use sys.fs::*\nint y; /* use m::* */\n";
        if (cx_fmt(d, sizeof d, "%s/wc-fixture-%d", sy_tmpdir(), (int)sy_pid()) || sy_mkdir(d, 0700) < 0) { ck(0, "wildcard-fixture-dir"); }
        else {
            cx_fmt(fb, sizeof fb, "%s/bad.cx", d); cx_fmt(fg, sizeof fg, "%s/good.cx", d); cx_fmt(fc, sizeof fc, "%s/cmt.cx", d);
            cx_write(fb, bad, tx_len(bad, 1 << 10)); cx_write(fg, good, tx_len(good, 1 << 10)); cx_write(fc, cmt, tx_len(cmt, 1 << 10));
            rc = wc_run(fb, 0, ob, sizeof ob);
            ck(rc == 1 && has(ob, "cx-wildcard-product") && has(ob, "bad.cx"), "wildcard-product-fixture-fails-with-named-rule");
            rc = wc_run(fg, 0, ob, sizeof ob);
            ck(rc == 0 && !has(ob, "cx-wildcard-product"), "named-import-fixture-passes");
            rc = wc_run(fc, 0, ob, sizeof ob);
            ck(rc == 0 && !has(ob, "cx-wildcard-product"), "wildcard-in-comment-is-not-a-use");
            rc = wc_run(fg, fb, ob, sizeof ob);
            ck(rc == 1 && has(ob, "bad.cx") && !has(ob, "good.cx"), "mixed-fixture-names-only-offender");
            sy_unlink(fb); sy_unlink(fg); sy_unlink(fc); sy_rmdir(d);
        }
    }
    if (argc == 2) { printf("CHECK_RATCHETS\tfailed=%d\n", failed); return failed ? 1 : 0; }
full_run:
    rc = run(full, o, sizeof o);
    {   int okn = -1, failn = -1; long at = where(o, tx_len(o, sizeof o), "RATCHETS\tok=");
        if (at >= 0) sscanf(o + at, "RATCHETS\tok=%d\tfail=%d", &okn, &failn);
        ck(has(o, "RATCHET\tcxraw\t") && has(o, "RATCHET\tcxinclude\t") && has(o, "RATCHET\tcxapis\t") && has(o, "RATCHET\tcxtrunc\t")
           && has(o, "RATCHET\tcxlibc\t") && has(o, "RATCHET\tcxplatform\t") && has(o, "RATCHET\tsrcshape\t") && has(o, "RATCHET\tcoreapi\t") && !has(o, "RATCHET\ttoolsloc\t")
           && has(o, "RATCHET\tverwriter\t") && has(o, "RATCHET\taluiwidth\t") && has(o, "RATCHET\toutdep\t") && has(o, "RATCHET\tcheck-literal\t") && has(o, "RATCHET\tnet-deps\t") && okn + failn == 13 && (rc == 0) == (failn == 0), "full-run-thirteen-with-gate14-without-toolsloc-and-exit");
    }
    printf("CHECK_RATCHETS\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
