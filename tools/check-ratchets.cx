/* Checks tools/ratchets.cx: sh ./unisacc.com tools/check-ratchets.cx   (from the repo root)
   --rows on tools/ratchets/sample.txt keeps exactly the four rows that name a file above or without a
   baseline (cxraw, cxinclude "module PATH", cxtrunc) or a whole-tree total above its baseline (srcshape
   "src/ total lines"), and drops the stale-row note, the FAIL summary and the boundary note; --only src/
   keeps only the cxinclude and the srcshape total row, --only apps/ only the cxraw row.  A full run prints
   one RATCHET line per name from tools/ratchets.cx --list, excluding retired toolsloc; the roster count comes from that output, with
   exit 0 exactly when fail is 0.
   --only-paths aliases --only. When --from-run fails only on untracked
   no-baseline .cx, expects RATCHET_HINT foreign-untracked (no move tip).
   Prints PASS/FAIL lines and CHECK_RATCHETS<TAB>failed=N. */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use sys.time
#pragma unisa use sysx.run
#pragma unisa use sys.posix
#pragma unisa use sys.env
#pragma unisa use mem.heap

static int failed;
static const char *ratchets_bin;
static void ck(int ok, const char *name) { if (!ok) failed++; printf("%s\tratchets.%s\n", ok ? "PASS" : "FAIL", name); }

static int run_argv(char **argv, char *out, long cap) {
    int ofd, pid, ex = 0, code = 0, sig = 0; long n = 0, r; char junk[4096];
    pid = px_spawn_spool(argv, 0, SY_SPAWN_ERR_TO_OUT, &ofd, 0);
    if (pid < 0) return -1;
    while ((r = sy_read(ofd, out + n, cap - 1 - n)) > 0) n += r;
    out[n] = 0;
    while (sy_read(ofd, junk, sizeof junk) > 0) {}
    sy_close(ofd);
    if (sy_wait_status(pid, 0, &ex, &code, &sig) != pid || !ex) return -1;
    return code;
}
static int run_script(char *script, char **args, char *out, long cap) {
    char *argv[12]; int i = 0, k;
    argv[i++] = "sh"; argv[i++] = "./unisacc.com"; argv[i++] = script; argv[i++] = "--";
    for (k = 0; args[k] && i < 11; k++) argv[i++] = args[k];
    argv[i] = 0;
    return run_argv(argv, out, cap);
}
static int run(char **args, char *out, long cap) {
    if (ratchets_bin && ratchets_bin[0]) {
        char *argv[10]; int i = 0, k;
        argv[i++] = (char *)ratchets_bin;
        for (k = 0; args[k] && i < 9; k++) argv[i++] = args[k];
        argv[i] = 0;
        return run_argv(argv, out, cap);
    }
    return run_script("tools/ratchets.cx", args, out, cap);
}
/* tests/cxinclude.cx --wildcard-file A [B] */
static int wc_run(char *a, char *b, char *out, long cap) {
    char *args[4]; int i = 0;
    args[i++] = "--wildcard-file"; args[i++] = a; if (b) args[i++] = b;
    args[i] = 0;
    return run_script("tests/cxinclude.cx", args, out, cap);
}
static int lines(const char *s) { int c = 0; for (; *s; s++) if (*s == '\n') c++; return c; }
static long where(const char *out, long on, const char *s) {
    long sn = tx_len(s, 512), i, k;
    for (i = 0; i + sn <= on; i++) {
        for (k = 0; k < sn && out[i + k] == s[k]; k++) {}
        if (k == sn) return i;
    }
    return -1;
}
static int has(const char *out, const char *s) { return where(out, tx_len(out, 1 << 16), s) >= 0; }

/* Roster = the producer's own --list output; the count and names are never literals here. */
static int roster_names(char names[][64], int max) {
    char out[32768]; char *a[] = {"--list", 0}; long at = 0, on; int n = 0;
    if (run(a, out, sizeof out) != 0) return -1;
    on = tx_len(out, sizeof out);
    while (at < on && n < max) {
        long e = at; while (e < on && out[e] != '\n') e++;
        if (e - at > 14 && tx_prefix(out + at, e - at, "RATCHETS_LIST\t", 14)) {
            long s0 = at + 14, s1 = s0; int k = 0;
            while (s1 < e && out[s1] != '\t') s1++;
            while (s0 < s1 && k + 1 < 64) names[n][k++] = out[s0++];
            names[n][k] = 0;
            if (k > 0) n++;
        }
        at = e + 1;
    }
    return n;
}

/* three review cases: move plus a non-canonical number, allow-list growth, stdio FAIL blocking */
static int gate_hash(const char *file, char *sha, long cap) {
    char *v[] = {"git", "hash-object", "-w", (char *)file, 0};
    long n;
    if (run_argv(v, sha, cap)) return 1;
    n = tx_len(sha, cap);
    while (n > 0 && (sha[n - 1] == '\n' || sha[n - 1] == '\r')) sha[--n] = 0;
    return n < 8;
}

static int gate_review_cases(char *out, long cap, int *move_ok, int *allow_ok, int *fail_ok) {
    char dir[512], idx[540], fx[540], spec[640], sha[80], path[180], num[32];
    char *hb = 0; size_t hn = 0; long at = 0, tab = -1, pl = 0, nl = 0;
    char *rt[] = {"git", "read-tree", "HEAD", 0};
    char *mv[] = {"--ratchet-baseline-selftest", 0};
    char *al[] = {"--stdio-allow-selftest", 0};
    char *pc[] = {"--precommit", fx, spec, 0};
    const char *old = sy_env("GIT_INDEX_FILE");
    *move_ok = *allow_ok = *fail_ok = 0;
    if (cx_fmt(dir, sizeof dir, "%s/gate-review-%d", sy_tmpdir(), sy_pid())) return 1;
    sy_mkdir(dir, 0700);
    if (cx_fmt(idx, sizeof idx, "%s/index", dir)) return 1;
    sy_setenv("GIT_INDEX_FILE", idx, 1);
    if (run_argv(rt, out, cap)) { if (old) sy_setenv("GIT_INDEX_FILE", old, 1); else sy_unsetenv("GIT_INDEX_FILE"); return 1; }
    hb = (char *)cx_read("tests/cxlibc.tsv", &hn);
    if (!hb) { if (old) sy_setenv("GIT_INDEX_FILE", old, 1); else sy_unsetenv("GIT_INDEX_FILE"); return 1; }
    while (at < (long)hn) {
        long e = tx_chr(hb + at, (long)hn - at, '\n'), l = e < 0 ? (long)hn - at : e;
        if (l > 4 && tx_prefix(hb + at, l, "src/", 4)) { tab = tx_chr(hb + at, l, '\t'); if (tab > 0) { pl = tab; nl = l - tab - 1; break; } }
        at += l + 1;
    }
    if (tab > 0 && pl < (long)sizeof path && nl > 0 && nl < (long)sizeof num) {
        char body[512];
        tx_copy(path, sizeof path, hb + at, pl); path[pl] = 0;
        tx_copy(num, sizeof num, hb + at + pl + 1, nl); num[nl] = 0;
        if (!cx_fmt(fx, sizeof fx, "%s/plus.tsv", dir) &&
            !cx_fmt(body, sizeof body, "%s\t+%s\n", path, num) &&
            !cx_write(fx, body, (size_t)tx_len(body, sizeof body)) && !gate_hash(fx, sha, sizeof sha) &&
            !cx_fmt(spec, sizeof spec, "100644,%s,tests/cxlibc.tsv", sha)) {
            char *up[] = {"git", "update-index", "--cacheinfo", spec, 0};
            if (!run_argv(up, out, cap) && run_script("tools/precommit.cx", mv, out, cap) == 1 && has(out, "canonical decimal")) *move_ok = 1;
        }
        if (!cx_fmt(fx, sizeof fx, "%s/move.tsv", dir) &&
            !cx_fmt(body, sizeof body, "%s\t%s\nmove\t%s\tcx/new-via-move.cx\t%s\ncx/new-via-move.cx\t%s\n", path, num, path, num, num) &&
            !cx_write(fx, body, (size_t)tx_len(body, sizeof body)) && !gate_hash(fx, sha, sizeof sha) &&
            !cx_fmt(spec, sizeof spec, "100644,%s,tests/cxlibc.tsv", sha)) {
            char *up[] = {"git", "update-index", "--cacheinfo", spec, 0};
            int rc = run_argv(up, out, cap);
            if (!rc) rc = run_script("tools/precommit.cx", mv, out, cap);
            if (rc == 1 && has(out, "move add exceeds removed allowance") && has(out, "cx/new-via-move.cx")) *move_ok = *move_ok && 1; else *move_ok = 0;
        } else *move_ok = 0;
    }
    mm_free(hb);
    {
        size_t an = 0; char *ab = (char *)cx_read("build/stdio-copies-allow.tsv", &an);
        char grown[1 << 16];
        if (ab && an + 16 < sizeof grown) {
            long i; for (i = 0; i < (long)an; i++) grown[i] = ab[i];
            grown[an] = 'b'; grown[an + 1] = 'r'; grown[an + 2] = 'a'; grown[an + 3] = 'n'; grown[an + 4] = 'd'; grown[an + 5] = '-';
            grown[an + 6] = 'n'; grown[an + 7] = 'e'; grown[an + 8] = 'w'; grown[an + 9] = '.'; grown[an + 10] = 'o'; grown[an + 11] = '\n';
            if (!cx_fmt(fx, sizeof fx, "%s/allow.tsv", dir) && !cx_write(fx, grown, an + 12) && !gate_hash(fx, sha, sizeof sha) &&
                !cx_fmt(spec, sizeof spec, "100644,%s,build/stdio-copies-allow.tsv", sha)) {
                char *up[] = {"git", "update-index", "--cacheinfo", spec, 0};
                if (!run_argv(up, out, cap) && run_script("tools/precommit.cx", al, out, cap) == 1 && has(out, "stdio-allow-added unit=brand-new.o")) *allow_ok = 1;
            }
        }
        if (ab) mm_free(ab);
    }
    {
        char zpath[30];
        const char *row = "RATCHET\tstdio-copies\tFAIL\tstdio-copies: FAIL: unit outside allow\n";
        if (!cx_fmt(fx, sizeof fx, "%s/rows", dir) && !cx_fmt(spec, sizeof spec, "%s/paths", dir) &&
            !cx_write(fx, row, tx_len(row, 200))) {
            tx_copy(zpath, sizeof zpath, "build/stdio-copies-allow.tsv", 28); zpath[28] = 0;
            if (!cx_write(spec, zpath, 29)) {
                char *args[] = {"--precommit", fx, spec, 0};
                run_script("tools/ratchets.cx", args, out, cap);
                if (has(out, "RATCHETS_PRECOMMIT\tblocked=1") && has(out, "stdio-copies FAIL")) *fail_ok = 1;
            }
        }
    }
    if (old) sy_setenv("GIT_INDEX_FILE", old, 1); else sy_unsetenv("GIT_INDEX_FILE");
    return (*move_ok && *allow_ok && *fail_ok) ? 0 : 1;
}

static int gate_bypass_cases(char *out, long cap, int *canon_ok, int *once_ok) {
    char dir[512], idx[540], fx[540], spec[640], sha[80];
    char *rt[] = {"git", "read-tree", "HEAD", 0};
    char *mv[] = {"--ratchet-baseline-selftest", 0};
    const char *old = sy_env("GIT_INDEX_FILE");
    const char *space = "src/drive.cx\t 74\n";
    const char *pad = "src/drive.cx\t0000000000000000074\n";
    const char *two = "src/drive.cx\t63\nmove\tsrc/drive.cx\tcx/a-bypass.cx\t10\nmove\tsrc/drive.cx\tcx/b-bypass.cx\t10\ncx/a-bypass.cx\t10\ncx/b-bypass.cx\t10\n";
    *canon_ok = *once_ok = 0;
    if (cx_fmt(dir, sizeof dir, "%s/gate-bypass-%d", sy_tmpdir(), sy_pid())) return 1;
    sy_mkdir(dir, 0700);
    if (cx_fmt(idx, sizeof idx, "%s/index", dir)) return 1;
    sy_setenv("GIT_INDEX_FILE", idx, 1);
    if (run_argv(rt, out, cap)) { if (old) sy_setenv("GIT_INDEX_FILE", old, 1); else sy_unsetenv("GIT_INDEX_FILE"); return 1; }
    if (!cx_fmt(fx, sizeof fx, "%s/space.tsv", dir) && !cx_write(fx, space, tx_len(space, 80)) && !gate_hash(fx, sha, sizeof sha) &&
        !cx_fmt(spec, sizeof spec, "100644,%s,tests/cxlibc.tsv", sha)) {
        char *up[] = {"git", "update-index", "--cacheinfo", spec, 0};
        if (!run_argv(up, out, cap) && run_script("tools/precommit.cx", mv, out, cap) == 1 && has(out, "canonical decimal")) *canon_ok = 1;
    }
    if (!cx_fmt(fx, sizeof fx, "%s/two.tsv", dir) && !cx_write(fx, two, tx_len(two, 200)) && !gate_hash(fx, sha, sizeof sha) &&
        !cx_fmt(spec, sizeof spec, "100644,%s,tests/cxlibc.tsv", sha)) {
        char *up[] = {"git", "update-index", "--cacheinfo", spec, 0};
        if (!run_argv(up, out, cap) && run_script("tools/precommit.cx", mv, out, cap) == 1 && has(out, "cx/b-bypass.cx") && has(out, "move add exceeds")) *once_ok = 1;
    }
    if (old) sy_setenv("GIT_INDEX_FILE", old, 1); else sy_unsetenv("GIT_INDEX_FILE");
    return (*canon_ok && *once_ok) ? 0 : 1;
}

int main(int argc, char **argv) {
    static char o[1 << 16];
    char *all[] = {"--rows", "tools/ratchets/sample.txt", 0};
    char *src[] = {"--rows", "tools/ratchets/sample.txt", "--only", "src/", 0};
    char *apps[] = {"--rows", "tools/ratchets/sample.txt", "--only", "apps/", 0};
    char *full[] = {0};
    int rc, w = 1;
    for (int i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--tool") && i + 1 < argc) { ratchets_bin = argv[++i]; continue; }
        argv[w++] = argv[i];
    }
    argc = w;
    if (argc == 2 && tx_eqz(argv[1], "--full")) goto full_run;
    if (argc == 4 && tx_eqz(argv[1], "--gate-produce")) {
        int mv = 0, al = 0, fl = 0, cn = 0, on = 0; char rec[160];
        if (gate_review_cases(o, sizeof o, &mv, &al, &fl) || gate_bypass_cases(o, sizeof o, &cn, &on)) { printf("FAIL\tgate-review\n"); return 1; }
        if (cx_fmt(rec, sizeof rec, "run-id\t%s\n", argv[2]) || cx_write(argv[3], rec, (size_t)tx_len(rec, sizeof rec))) { printf("FAIL\tgate-review\n"); return 1; }
        printf("PASS\tgate-review\n");
        return 0;
    }
    if (argc == 4 && tx_eqz(argv[1], "--gate-judge")) {
        size_t n = 0; char *b = (char *)cx_read(argv[3], &n); char want[160];
        if (!b) { printf("FAIL\tgate-review-missing\n"); return 1; }
        if (cx_fmt(want, sizeof want, "run-id\t%s\n", argv[2]) || (long)n != tx_len(want, sizeof want) || !tx_same(b, (long)n, want, (long)n)) {
            mm_free(b); printf("FAIL\tgate-review-stale\n"); return 1;
        }
        mm_free(b); printf("PASS\tgate-review\n"); return 0;
    }
    if (argc > 2 || (argc == 2 && !tx_eqz(argv[1], "--rows-only"))) return 2;
    rc = run(all, o, sizeof o);
    ck(rc == 0 && lines(o) == 4 && has(o, "context_preview.cx has 102") && has(o, "module src/host.cx has 1") && has(o, "tools/new-tool.cx has 8")
       && has(o, "srcshape: src/ total lines 5352, baseline 5331")
       && !has(o, "stale row") && !has(o, "FAIL:") && !has(o, "boundary:"), "rows-keeps-four-offenders");
    rc = run(src, o, sizeof o);
    ck(rc == 0 && lines(o) == 2 && has(o, "module src/host.cx") && has(o, "src/ total lines 5352"), "only-src-through-module-word-and-total-row");
    rc = run(apps, o, sizeof o);
    ck(rc == 0 && lines(o) == 1 && has(o, "apps/csih/probes/context_preview.cx"), "only-apps");
    {   char *op[] = {"--rows", "tools/ratchets/sample.txt", "--only-paths", "src/", 0};
        rc = run(op, o, sizeof o);
        ck(rc == 0 && lines(o) == 2 && has(o, "module src/host.cx") && has(o, "src/ total lines 5352"), "only-paths-alias-src");
    }
    {   char d[4096], fb[4400], fg[4400], fc[4400]; char ob[1 << 14];
        const char *bad = "#pragma unisa use text.text\n#pragma unisa use sys.fs::*\nint x;\n";
        const char *good = "#pragma unisa use text.text\n#pragma unisa use sys.fs\n";
        const char *cmt = "// #pragma unisa use sys.fs::*\nint y; /* use m::* */\n";
        if (cx_fmt(d, sizeof d, "%s/wc-fixture-%d", sy_tmpdir(), (int)sy_pid()) || sy_mkdir(d, 0700) < 0) { ck(0, "wildcard-fixture-dir"); }
        else {
            cx_fmt(fb, sizeof fb, "%s/bad.cx", d); cx_fmt(fg, sizeof fg, "%s/good.cx", d); cx_fmt(fc, sizeof fc, "%s/cmt.cx", d);
            cx_write(fb, bad, tx_len(bad, 1 << 10)); cx_write(fg, good, tx_len(good, 1 << 10)); cx_write(fc, cmt, tx_len(cmt, 1 << 10));
            rc = wc_run(fb, 0, ob, sizeof ob);
            ck(rc == 1 && has(ob, "cx-wildcard-product") && has(ob, "bad.cx"), "wildcard-product-fixture-fails-with-named-rule");
            rc = wc_run(fg, 0, ob, sizeof ob);
            ck(rc == 0 && !has(ob, "cx-wildcard-product"), "named-import-fixture-passes");
            rc = wc_run(fc, 0, ob, sizeof ob);
            ck(rc == 0 && !has(ob, "cx-wildcard-product"), "wildcard-in-comment-is-not-a-use");
            rc = wc_run(fg, fb, ob, sizeof ob);
            ck(rc == 1 && has(ob, "bad.cx") && !has(ob, "good.cx"), "mixed-fixture-names-only-offender");
            sy_unlink(fb); sy_unlink(fg); sy_unlink(fc); sy_rmdir(d);
        }
    }
    {   /* --plan lists each gate; --from-run judges a synthetic flow run with one gate above baseline */
        char names[32][64]; int nfixtures = roster_names(names, 32), k; const char *nm[32];
        char d[4096], od[4200], p[4400], ev[1 << 12], line[256], *pl[] = {"--plan", 0}, *fr[] = {"--from-run", d, 0}; long en = 0; char exp_ok[64];
        cx_fmt(exp_ok, sizeof exp_ok, "RATCHETS\tok=%d\tfail=1\t", nfixtures - 1);
        for (k = 0; k < nfixtures; k++) nm[k] = names[k];
        rc = run(pl, o, sizeof o);
        ck(rc == 0 && lines(o) == nfixtures && has(o, "PLAN\trk-tsv-lint\t./tools/bound\t55\tsh\t./unisacc.com\ttools/tsv-lint.cx\t--\t--check\n") && has(o, "PLAN\trk-ref-job-paths\t./tools/bound\t55\tsh\t./unisacc.com\ttools/ref-job-paths.cx\t--\t--check\n") && has(o, "PLAN\trk-no-home-path\t./tools/bound\t55\tsh\t./unisacc.com\ttools/no-home-path.cx\t--\t--check\n") && has(o, "PLAN\trk-cxraw\t./tools/bound\t55\tsh\t./unisacc.com\ttests/cxraw.cx\t--\t--check\n") && has(o, "PLAN\trk-net-deps\t")
           && has(o, "PLAN\trk-notcovered\t./tools/bound\t55\tsh\t./unisacc.com\ttools/notcovered-census.cx\t--\t--check\n")
           && has(o, "PLAN\trk-reserved-names\t")
           && has(o, "PLAN\trk-host-surface\t./tools/bound\t55\tsh\t./unisacc.com\ttools/check-host-surface.cx\t--\t--check\n")
           && has(o, "PLAN\trk-dup-census\t./tools/bound\t55\tsh\t./unisacc.com\ttools/dup-census.cx\t--\t--check\n"), "plan-roster-nodes");
        if (cx_fmt(d, sizeof d, "%s/rk-fixture-%d", sy_tmpdir(), (int)sy_pid()) || cx_fmt(od, sizeof od, "%s/out", d) || sy_mkdir(d, 0700) < 0 || sy_mkdir(od, 0700) < 0) ck(0, "from-run-fixture-dir");
        else {
            for (k = 0; k < nfixtures; k++) {
                const char *body = k == 0 ? "cxraw: apps/x.cx has 3 raw lines, baseline 1\ncxraw: FAIL: 1 file above baseline\n" : "r: ok: fine\n";
                cx_fmt(p, sizeof p, "%s/rk-%s.out", od, nm[k]); cx_write(p, body, tx_len(body, 256));
                cx_fmt(line, sizeof line, "EVT\t%d\trk-%s\tstart\t0\t0\texec\nEVT\t%d\trk-%s\t%s\t5\t%d\tout=1 err=0\n", 2 * k + 1, nm[k], 2 * k + 2, nm[k], k ? "ok" : "fail", k ? 0 : 1);
                if (en + tx_len(line, 256) < (long)sizeof ev) { long l = tx_len(line, 256); for (long j = 0; j < l; j++) ev[en + j] = line[j]; en += l; }
            }
            cx_fmt(p, sizeof p, "%s/events.tsv", d); cx_write(p, ev, en);
            rc = run(fr, o, sizeof o);
            ck(rc == 1 && has(o, "RATCHET\tcxraw\tFAIL\tcxraw: FAIL: 1 file above baseline\n") && has(o, "  cxraw: apps/x.cx has 3 raw lines, baseline 1\n")
               && has(o, "RATCHET\tnet-deps\tok\tr: ok: fine\n") && has(o, "RATCHET\tnotcovered\tok\tr: ok: fine\n") && has(o, "RATCHET\tdup-census\tok\tr: ok: fine\n") && has(o, "RATCHET\tno-home-path\tok\tr: ok: fine\n") && has(o, "RATCHET\tref-job-paths\tok\tr: ok: fine\n") && has(o, "RATCHET\ttsv-lint\tok\tr: ok: fine\n") && has(o, "RATCHET\treserved-names\tok\tr: ok: fine\n") && has(o, "RATCHET\thost-surface\tok\tr: ok: fine\n") && has(o, exp_ok) && lines(o) == nfixtures + 2 && !has(o, "RATCHET_HINT"), "from-run-over-baseline-fixture");
            /* foreign-untracked tip: only cxtrunc no-baseline on our own untracked fixture path */
            {
                const char *fxp = "tools/zz-ratchets-hint-fixture.cx";
                const char *fxbody = "int zz_ratchets_hint_fixture(void) { return 0; }\n";
                const char *tip = "RATCHET_HINT\tforeign-untracked\t这些未跟踪文件不属于你,等所有者处理,或用 --only-paths 限定\ttools/zz-ratchets-hint-fixture.cx\n";
                char *frh[] = {"--from-run", d, 0}; long en2 = 0; char ev2[1 << 12], line2[320]; int k2;
                cx_write(fxp, fxbody, tx_len(fxbody, 128));
                for (k2 = 0; k2 < nfixtures; k2++) {
                    const char *body = k2 == 3
                        ? "cxtrunc: tools/zz-ratchets-hint-fixture.cx has 1 calls and no baseline row (a new .cx must have 0)\ncxtrunc: FAIL: 1 above baseline\n"
                        : "r: ok: fine\n";
                    cx_fmt(p, sizeof p, "%s/rk-%s.out", od, names[k2]); cx_write(p, body, tx_len(body, 256));
                    cx_fmt(line2, sizeof line2, "EVT\t%d\trk-%s\tstart\t0\t0\texec\nEVT\t%d\trk-%s\t%s\t5\t%d\tout=1 err=0\n", 2 * k2 + 1, names[k2], 2 * k2 + 2, names[k2], k2 == 3 ? "fail" : "ok", k2 == 3 ? 1 : 0);
                    if (en2 + tx_len(line2, 320) < (long)sizeof ev2) { long l = tx_len(line2, 320); for (long j = 0; j < l; j++) ev2[en2 + j] = line2[j]; en2 += l; }
                }
                cx_fmt(p, sizeof p, "%s/events.tsv", d); cx_write(p, ev2, en2);
                rc = run(frh, o, sizeof o);
