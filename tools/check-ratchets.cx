                                    char *ch2[] = {"git", "update-index", "--add", "--cacheinfo", "100644,e69de29bb2d1d6434b8b29ae775ad8c2e48c5391,cx/sys/no_tab_posix.cx", 0};
                                    char *ch3[] = {"git", "update-index", "--add", "--cacheinfo", "100644,e69de29bb2d1d6434b8b29ae775ad8c2e48c5391,src/a has b.cx", 0};
                                    cx_write(rout, hn_rat, tx_len(hn_rat, 1024));
                                    (void)run_argv(rt, o, sizeof o);
                                    (void)run_argv(ch1, o, sizeof o);
                                    (void)run_argv(ch2, o, sizeof o);
                                    (void)run_argv(ch3, o, sizeof o);
                                    rc = run_script("tools/precommit.cx", pc_fr, o, sizeof o);
                                    ck(rc == 1 && has(o, "precommit: blocked: cxraw: apps/my has dir/my has probe.cx has 3 raw lines, baseline 1")
                                       && has(o, "precommit: blocked: cxraw: move target src/a has b.cx baseline 3 != move 2")
                                       && has(o, "precommit: blocked: CORE-NEW cx/sys/no_tab_posix.cx")
                                       && has(o, "PRECOMMIT\tstaged_cx=3\tblocked=3"),
                                       "precommit-blocks-path-with-has-and-core-no-tab");
                                    /* Test 27: dup-census anti-collateral: when dup-census names specific offending function(s),
                                     * staging an unrelated tools/*.cx without that function passes (blocked=0), while staging
                                     * a tools/*.cx containing that function (or matching the named file) blocks (blocked=1). */
                                    {
                                        const char *dup_rat =
                                            "RATCHET\tdup-census\tFAIL\tdup-census: FAIL: 1 offending functions, redundant 500/400\n"
                                            "  dup-census: my_offending_dup_fn has 3 verbatim copies across 3 tools/*.cx files (15 redundant lines; see tools/other_offender.cx)\n"
                                            "  dup-census: tools total lines verbatim_redundant 500, baseline 400\n"
                                            "RATCHETS\tok=18\tfail=1\telapsed_ms=10\n";
                                        char f_clean[4400], f_dirty[4400], sha_clean[64], sha_dirty[64], ci_clean[200], ci_dirty[200];
                                        char *ho_c[] = {"git", "hash-object", "-w", f_clean, 0};
                                        char *ho_d[] = {"git", "hash-object", "-w", f_dirty, 0};
                                        long sl;
                                        cx_fmt(f_clean, sizeof f_clean, "%s/dup-clean.cx", d);
                                        cx_fmt(f_dirty, sizeof f_dirty, "%s/dup-dirty.cx", d);
                                        cx_write(f_clean, "/* clean tool */\nint main(void){return 0;}\n", 43);
                                        cx_write(f_dirty, "static void my_offending_dup_fn(void){}\nint main(void){return 0;}\n", 66);
                                        (void)run_argv(ho_c, sha_clean, sizeof sha_clean);
                                        sl = tx_len(sha_clean, sizeof sha_clean);
                                        while (sl > 0 && (sha_clean[sl - 1] == '\n' || sha_clean[sl - 1] == '\r')) sha_clean[--sl] = 0;
                                        (void)run_argv(ho_d, sha_dirty, sizeof sha_dirty);
                                        sl = tx_len(sha_dirty, sizeof sha_dirty);
                                        while (sl > 0 && (sha_dirty[sl - 1] == '\n' || sha_dirty[sl - 1] == '\r')) sha_dirty[--sl] = 0;
                                        cx_fmt(ci_clean, sizeof ci_clean, "100644,%s,tools/check-tsv-lint.cx", sha_clean);
                                        cx_fmt(ci_dirty, sizeof ci_dirty, "100644,%s,tools/check-tsv-lint.cx", sha_dirty);
                                        cx_write(rout, dup_rat, tx_len(dup_rat, 1024));
                                        {
                                            char *u_clean[] = {"git", "update-index", "--cacheinfo", ci_clean, 0};
                                            char *u_dirty[] = {"git", "update-index", "--cacheinfo", ci_dirty, 0};
                                            int rc_clean, rc_dirty, ok_clean, ok_dirty;
                                            (void)run_argv(rt, o, sizeof o);
                                            (void)run_argv(u_clean, o, sizeof o);
                                            rc_clean = run_script("tools/precommit.cx", pc_fr, o, sizeof o);
                                            ok_clean = (rc_clean == 0 && has(o, "PRECOMMIT\tstaged_cx=1\tblocked=0"));
                                            (void)run_argv(rt, o, sizeof o);
                                            (void)run_argv(u_dirty, o, sizeof o);
                                            rc_dirty = run_script("tools/precommit.cx", pc_fr, o, sizeof o);
                                            ok_dirty = (rc_dirty == 1 && has(o, "precommit: blocked: RATCHET dup-census FAIL") &&
                                                        has(o, "my_offending_dup_fn") &&
                                                        has(o, "PRECOMMIT\tstaged_cx=1\tblocked=1"));
                                            ck(ok_clean && ok_dirty,
                                               "precommit-dup-census-anti-collateral-blocks-only-offender");
                                        }
                                        sy_unlink(f_clean); sy_unlink(f_dirty);
                                    }
                                    /* Test 28: ratchet_baseline_gate: raising existing keys in tests/*.tsv or build/*-baseline.tsv
                                     * is refused with BLOCKED ratchet-baseline-raised, while lowering existing keys or adding new keys passes. */
                                    {
                                        const char *ok_rat = "RATCHETS\tok=19\tfail=0\telapsed_ms=10\n";
                                        char f_ss_up[4400], f_tl_up[4400], f_dc_up[4400], f_ss_dn[4400], f_tl_dn[4400];
                                        char s_ss_up[64], s_tl_up[64], s_dc_up[64], s_ss_dn[64], s_tl_dn[64];
                                        char c_ss_up[200], c_tl_up[200], c_dc_up[200], c_ss_dn[200], c_tl_dn[200];
                                        char *h1[] = {"git", "hash-object", "-w", f_ss_up, 0};
                                        char *h2[] = {"git", "hash-object", "-w", f_tl_up, 0};
                                        char *h3[] = {"git", "hash-object", "-w", f_dc_up, 0};
                                        char *h4[] = {"git", "hash-object", "-w", f_ss_dn, 0};
                                        char *h5[] = {"git", "hash-object", "-w", f_tl_dn, 0};
                                        long sl;
                                        cx_fmt(f_ss_up, sizeof f_ss_up, "%s/ss-up.tsv", d);
                                        cx_fmt(f_tl_up, sizeof f_tl_up, "%s/tl-up.tsv", d);
                                        cx_fmt(f_dc_up, sizeof f_dc_up, "%s/dc-up.tsv", d);
                                        cx_fmt(f_ss_dn, sizeof f_ss_dn, "%s/ss-dn.tsv", d);
                                        cx_fmt(f_tl_dn, sizeof f_tl_dn, "%s/tl-dn.tsv", d);
                                        cx_write(f_ss_up, "src/bind.cx\t999\t3\t0\n", 20);
                                        cx_write(f_tl_up, "unresolved\t99999\n", 17);
                                        cx_write(f_dc_up, "total\tverbatim_groups\t99999\n", 28);
                                        cx_write(f_ss_dn, "src/bind.cx\t1\t1\t0\nsrc/brand_new_unit.cx\t50\t20\t5\n", 48);
                                        cx_write(f_tl_dn, "unresolved\t100\nbrand_new_metric\t50\n", 35);
                                        (void)run_argv(h1, s_ss_up, sizeof s_ss_up); sl = tx_len(s_ss_up, 64); while (sl > 0 && (s_ss_up[sl - 1] == '\n' || s_ss_up[sl - 1] == '\r')) s_ss_up[--sl] = 0;
                                        (void)run_argv(h2, s_tl_up, sizeof s_tl_up); sl = tx_len(s_tl_up, 64); while (sl > 0 && (s_tl_up[sl - 1] == '\n' || s_tl_up[sl - 1] == '\r')) s_tl_up[--sl] = 0;
                                        (void)run_argv(h3, s_dc_up, sizeof s_dc_up); sl = tx_len(s_dc_up, 64); while (sl > 0 && (s_dc_up[sl - 1] == '\n' || s_dc_up[sl - 1] == '\r')) s_dc_up[--sl] = 0;
                                        (void)run_argv(h4, s_ss_dn, sizeof s_ss_dn); sl = tx_len(s_ss_dn, 64); while (sl > 0 && (s_ss_dn[sl - 1] == '\n' || s_ss_dn[sl - 1] == '\r')) s_ss_dn[--sl] = 0;
                                        (void)run_argv(h5, s_tl_dn, sizeof s_tl_dn); sl = tx_len(s_tl_dn, 64); while (sl > 0 && (s_tl_dn[sl - 1] == '\n' || s_tl_dn[sl - 1] == '\r')) s_tl_dn[--sl] = 0;
                                        cx_fmt(c_ss_up, sizeof c_ss_up, "100644,%s,tests/srcshape.tsv", s_ss_up);
                                        cx_fmt(c_tl_up, sizeof c_tl_up, "100644,%s,build/tsv-lint-baseline.tsv", s_tl_up);
                                        cx_fmt(c_dc_up, sizeof c_dc_up, "100644,%s,build/dup-census-baseline.tsv", s_dc_up);
                                        cx_fmt(c_ss_dn, sizeof c_ss_dn, "100644,%s,tests/srcshape.tsv", s_ss_dn);
                                        cx_fmt(c_tl_dn, sizeof c_tl_dn, "100644,%s,build/tsv-lint-baseline.tsv", s_tl_dn);
                                        cx_write(rout, ok_rat, tx_len(ok_rat, 256));
                                        {
                                            char *u1[] = {"git", "update-index", "--cacheinfo", c_ss_up, 0};
                                            char *u2[] = {"git", "update-index", "--cacheinfo", c_tl_up, 0};
                                            char *u3[] = {"git", "update-index", "--cacheinfo", c_dc_up, 0};
                                            char *u4[] = {"git", "update-index", "--cacheinfo", c_ss_dn, 0};
                                            char *u5[] = {"git", "update-index", "--cacheinfo", c_tl_dn, 0};
                                            int rc_up, rc_dn, ok_up, ok_dn;
                                            (void)run_argv(rt, o, sizeof o);
                                            (void)run_argv(u1, o, sizeof o);
                                            (void)run_argv(u2, o, sizeof o);
                                            (void)run_argv(u3, o, sizeof o);
                                            rc_up = run_script("tools/precommit.cx", pc_fr, o, sizeof o);
                                            ok_up = (rc_up == 1 &&
                                                     has(o, "BLOCKED ratchet-baseline-raised table=tests/srcshape.tsv key=src/bind.cx") &&
                                                     has(o, "BLOCKED ratchet-baseline-raised table=build/tsv-lint-baseline.tsv key=unresolved") &&
                                                     has(o, "BLOCKED ratchet-baseline-raised table=build/dup-census-baseline.tsv key=total/verbatim_groups"));
                                            (void)run_argv(rt, o, sizeof o);
                                            (void)run_argv(u4, o, sizeof o);
                                            (void)run_argv(u5, o, sizeof o);
                                            rc_dn = run_script("tools/precommit.cx", pc_fr, o, sizeof o);
                                            ok_dn = (rc_dn == 0 && has(o, "blocked=0"));
                                            ck(ok_up && ok_dn,
                                               "precommit-ratchet-baseline-only-goes-down-blocks-raise-allows-lower-and-new");
                                        }
                                        sy_unlink(f_ss_up); sy_unlink(f_tl_up); sy_unlink(f_dc_up);
                                        sy_unlink(f_ss_dn); sy_unlink(f_tl_dn);
                                    }
                                    /* Test 29: cxlibc hard precommit gate for src/ and cx/:
                                     * (1) staging a src/ or cx/ file that exceeds its tests/cxlibc.tsv row (e.g. src/driveroute.cx 27 > 26)
                                     *     or has libc/host calls with no baseline row (e.g. cx/driver/new_mod.cx) is HARD BLOCKED;
                                     * (2) raising src/driveroute.cx or adding a new src/ or cx/ allowance row in tests/cxlibc.tsv is
                                     *     HARD BLOCKED by ratchet_baseline_gate, while lowering src/driveroute.cx passes. */
                                    {
                                        const char *ok_rat2 = "RATCHETS\tok=20\tfail=0\telapsed_ms=10\n";
                                        const char *fail_libc =
                                            "RATCHET\tcxlibc\tFAIL\tcxlibc: FAIL: 459 .cx files, 3601 calls (baseline 3599); 2 above baseline, 0 below\n"
                                            "  cxlibc: src/driveroute.cx has 27 calls, baseline 26\n"
                                            "  cxlibc: cx/driver/deps.cx has 10 calls, baseline 9\n"
                                            "RATCHETS\tok=19\tfail=1\telapsed_ms=10\n";
                                        char f_cl_up[4400], f_cl_dn[4400], s_cl_up[64], s_cl_dn[64], c_cl_up[200], c_cl_dn[200];
                                        char l_dr[4400], l_dp[4400], l_cd[4400];
                                        char *h_up[] = {"git", "hash-object", "-w", f_cl_up, 0};
                                        char *h_dn[] = {"git", "hash-object", "-w", f_cl_dn, 0};
                                        char *c_dr[] = {"git", "update-index", "--cacheinfo", "100644,e69de29bb2d1d6434b8b29ae775ad8c2e48c5391,src/driveroute.cx", 0};
                                        char *c_dp[] = {"git", "update-index", "--cacheinfo", "100644,e69de29bb2d1d6434b8b29ae775ad8c2e48c5391,cx/driver/deps.cx", 0};
                                        long sl2;
                                        int rc_over, rc_tbl_up, rc_tbl_dn, ok_over, ok_tbl_up, ok_tbl_dn;
                                        cx_fmt(l_cd, sizeof l_cd, "%s/cx/driver", lintd); sy_mkdir(l_cd, 0700);
                                        cx_fmt(l_dr, sizeof l_dr, "%s/src/driveroute.cx", lintd); cx_write(l_dr, "/* dr */\n", 9);
                                        cx_fmt(l_dp, sizeof l_dp, "%s/cx/driver/deps.cx", lintd); cx_write(l_dp, "/* dp */\n", 9);
                                        cx_write(rout, fail_libc, tx_len(fail_libc, 1024));
                                        (void)run_argv(rt, o, sizeof o);
                                        (void)run_argv(c_dr, o, sizeof o);
                                        (void)run_argv(c_dp, o, sizeof o);
                                        rc_over = run_script("tools/precommit.cx", pc_fr, o, sizeof o);
                                        ok_over = (rc_over == 1 &&
                                                   has(o, "precommit: blocked: cxlibc: src/driveroute.cx has 27 calls, baseline 26") &&
                                                   has(o, "precommit: blocked: cxlibc: cx/driver/deps.cx has 10 calls, baseline 9") &&
                                                   has(o, "PRECOMMIT\tstaged_cx=2\tblocked=2"));
                                        cx_fmt(f_cl_up, sizeof f_cl_up, "%s/cxlibc-up.tsv", d);
                                        cx_fmt(f_cl_dn, sizeof f_cl_dn, "%s/cxlibc-dn.tsv", d);
                                        cx_write(f_cl_up, "src/driveroute.cx\t28\nsrc/brand_new_libc.cx\t1\ncx/driver/brand_new_libc.cx\t2\n", 75);
                                        cx_write(f_cl_dn, "src/driveroute.cx\t20\ncx/driver/deps.cx\t5\n", 41);
                                        (void)run_argv(h_up, s_cl_up, sizeof s_cl_up); sl2 = tx_len(s_cl_up, 64); while (sl2 > 0 && (s_cl_up[sl2 - 1] == '\n' || s_cl_up[sl2 - 1] == '\r')) s_cl_up[--sl2] = 0;
                                        (void)run_argv(h_dn, s_cl_dn, sizeof s_cl_dn); sl2 = tx_len(s_cl_dn, 64); while (sl2 > 0 && (s_cl_dn[sl2 - 1] == '\n' || s_cl_dn[sl2 - 1] == '\r')) s_cl_dn[--sl2] = 0;
                                        cx_fmt(c_cl_up, sizeof c_cl_up, "100644,%s,tests/cxlibc.tsv", s_cl_up);
                                        cx_fmt(c_cl_dn, sizeof c_cl_dn, "100644,%s,tests/cxlibc.tsv", s_cl_dn);
                                        cx_write(rout, ok_rat2, tx_len(ok_rat2, 256));
                                        {
                                            char *u_cl_up[] = {"git", "update-index", "--cacheinfo", c_cl_up, 0};
                                            char *u_cl_dn[] = {"git", "update-index", "--cacheinfo", c_cl_dn, 0};
                                            (void)run_argv(rt, o, sizeof o);
                                            (void)run_argv(u_cl_up, o, sizeof o);
                                            rc_tbl_up = run_script("tools/precommit.cx", pc_fr, o, sizeof o);
                                            ok_tbl_up = (rc_tbl_up == 1 &&
                                                         has(o, "BLOCKED ratchet-baseline-raised table=tests/cxlibc.tsv key=src/driveroute.cx") &&
                                                         has(o, "BLOCKED ratchet-baseline-raised table=tests/cxlibc.tsv key=src/brand_new_libc.cx col=1 head=0 staged=1") &&
                                                         has(o, "BLOCKED ratchet-baseline-raised table=tests/cxlibc.tsv key=cx/driver/brand_new_libc.cx col=1 head=0 staged=2"));
                                            (void)run_argv(rt, o, sizeof o);
                                            (void)run_argv(u_cl_dn, o, sizeof o);
                                            rc_tbl_dn = run_script("tools/precommit.cx", pc_fr, o, sizeof o);
                                            ok_tbl_dn = (rc_tbl_dn == 0 && has(o, "blocked=0"));
                                        }
                                        ck(ok_over && ok_tbl_up && ok_tbl_dn,
                                           "precommit-cxlibc-hard-gate-blocks-src-cx-over-and-new-or-raised-allowance-rows");
                                        sy_unlink(f_cl_up); sy_unlink(f_cl_dn);
                                        sy_unlink(l_dr); sy_unlink(l_dp); sy_rmdir(l_cd);
                                    }
                                    sy_unsetenv("GIT_INDEX_FILE");
                                }
                            }
                        }
                        sy_unlink(la); sy_unlink(lb); sy_unlink(ls);
                        sy_rmdir(lmd); sy_rmdir(lap); sy_rmdir(lt);
                    }
                    sy_unlink(idx); sy_unlink(lp1); sy_unlink(lp2);
                    cx_fmt(lp1, sizeof lp1, "%s/cx/sys", lintd); sy_rmdir(lp1);
                    cx_fmt(lp1, sizeof lp1, "%s/cx", lintd); sy_rmdir(lp1);
                    sy_rmdir(lintd); sy_unlink(rout);
                    cx_fmt(p, sizeof p, "%s/lint.out", od); sy_unlink(p);
                    cx_fmt(p, sizeof p, "%s/lintr1.out", od); sy_unlink(p);
                    cx_fmt(p, sizeof p, "%s/tlibfrozen.out", od); sy_unlink(p);
                    cx_fmt(p, sizeof p, "%s/facts.out", od); sy_unlink(p);
                    cx_fmt(p, sizeof p, "%s/affected-canary.out", od); sy_unlink(p);
                    cx_fmt(p, sizeof p, "%s/env-semantics.out", od); sy_unlink(p);
                }
            }
            for (k = 0; k < nfixtures; k++) { cx_fmt(p, sizeof p, "%s/rk-%s.out", od, nm[k]); sy_unlink(p); }
            cx_fmt(p, sizeof p, "%s/events.tsv", d); sy_unlink(p); sy_rmdir(od); sy_rmdir(d);
        }
    }
    { int mv = 0, al = 0, fl = 0; (void)gate_review_cases(o, sizeof o, &mv, &al, &fl);
      ck(mv, "gate-move-plus-blocks-uncovered-transfer");
      ck(al, "gate-allow-list-growth-blocked");
      ck(fl, "gate-stdio-fail-blocks-precommit");
      { int cn = 0, on = 0; (void)gate_bypass_cases(o, sizeof o, &cn, &on);
        ck(cn, "gate-noncanonical-allowance-refused");
        ck(on, "gate-deduction-consumed-once"); } }
    if (argc == 2) { printf("CHECK_RATCHETS\tfailed=%d\n", failed); return failed ? 1 : 0; }
full_run:
    rc = run(full, o, sizeof o);
    {   char names[32][64]; int okn = -1, failn = -1, nn = roster_names(names, 32), i, all = 1; long at = where(o, tx_len(o, sizeof o), "RATCHETS\tok=");
        if (at >= 0) sscanf(o + at, "RATCHETS\tok=%d\tfail=%d", &okn, &failn);
        if (nn < 1) all = 0;
        for (i = 0; i < nn; i++) { char want[96]; cx_fmt(want, sizeof want, "RATCHET\t%s\t", names[i]); if (!has(o, want)) all = 0; }
        ck(all && !has(o, "RATCHET\ttoolsloc\t") && okn + failn == nn && (rc == 0) == (failn == 0), "full-run-roster-without-toolsloc-and-exit");
    }
    {   /* --shard K/N: ratchet i runs when i % N == K-1, the others are counted skipped; bad specs are refused */
        char names[32][64]; char s1[16], s2[16], sbad[16], sb[1 << 14], skip[64], first[96], sk1[160], sk2[160];
        int nn = roster_names(names, 32);
        char *a1[] = {"--shard", s1, 0}, *a2[] = {"--shard", s2, 0}, *a0[] = {"--shard", "0/3", 0}, *a4[] = {"--shard", "4/3", 0}, *ax[] = {"--shard", sbad, 0};
        if (nn < 2) { ck(0, "shard-1-of-roster-runs-only-the-first-ratchet"); ck(0, "shard-2-of-roster-runs-only-the-second-ratchet"); ck(0, "bad-shard-specs-are-refused-rc2"); }
        else {
            cx_fmt(s1, sizeof s1, "1/%d", nn); cx_fmt(s2, sizeof s2, "2/%d", nn); cx_fmt(sbad, sizeof sbad, "1/%d", nn + 1);
            cx_fmt(skip, sizeof skip, "RATCHETS\tok=1\tfail=0\tskipped=%d", nn - 1);
            cx_fmt(first, sizeof first, "RATCHET\t%s\tok\t", names[0]);
            cx_fmt(sk1, sizeof sk1, "%s: ok: skipped (not in shard 1/%d)", names[1], nn);
            rc = run(a1, sb, sizeof sb);
            ck(rc == 0 && has(sb, skip) && has(sb, first) && has(sb, sk1), "shard-1-of-roster-runs-only-the-first-ratchet");
            cx_fmt(first, sizeof first, "RATCHET\t%s\tok\t", names[1]);
            cx_fmt(sk2, sizeof sk2, "%s: ok: skipped (not in shard 2/%d)", names[0], nn);
            rc = run(a2, sb, sizeof sb);
            ck(rc == 0 && has(sb, skip) && has(sb, sk2) && has(sb, first), "shard-2-of-roster-runs-only-the-second-ratchet");
            ck(run(a0, sb, sizeof sb) == 2 && run(a4, sb, sizeof sb) == 2 && run(ax, sb, sizeof sb) == 2, "bad-shard-specs-are-refused-rc2");
        }
    }
    printf("CHECK_RATCHETS\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
