#pragma unisa use text.build
#pragma unisa use text.text
/* practice-build.cx: a practice suite that drives the opaque String builder at
   its boundaries (empty cstr, NUL not counted, join, large append).  A real
   consumer of text.build beyond its own check.  usage: sh ./unisacc.com tools/practice-build.cx */
static int bad;
static void ok(int c, const char *n) { printf("%s\t%s\n", c ? "PASS" : "FAIL", n); if (!c) bad = 1; }
int main(void) {
    {
        /* sb_cstr on a fresh builder: empty, and it must not advance len */
        sb *b = sb_new();
        ok(b && sb_len(b) == 0, "fresh-empty");
        const char *s = sb_cstr(b);
        ok(s && s[0] == 0, "fresh-cstr-empty");
        ok(sb_len(b) == 0, "cstr-does-not-advance-len");
        sb_free(b);
    }
    {
        /* the NUL that sb_cstr writes is not part of the length */
        sb *b = sb_new();
        sb_puts(b, "abc");
        ok(sb_len(b) == 3, "three-before-cstr");
        const char *s = sb_cstr(b);
        ok(s && s[0] == 'a' && s[3] == 0, "cstr-nul-terminated");
        ok(sb_len(b) == 3, "cstr-keeps-len");
        sb_free(b);
    }
    {
        /* join produces exactly the separator-joined text */
        sb *b = sb_new();
        const char *three[] = {"a", "bb", "ccc"};
        ok(sb_join(b, three, 3, ",") == 0 && tx_eqz(sb_cstr(b), "a,bb,ccc"), "join-sep");
        sb_free(b);
    }
    {
        /* clear drops the text but keeps the buffer for reuse (String::clear) */
        sb *b = sb_new();
        sb_puts(b, "hello");
        ok(sb_clear(b) == 0 && sb_len(b) == 0, "clear-drops-text");
        sb_puts(b, "hi");
        ok(tx_eqz(sb_cstr(b), "hi"), "clear-then-reuse");
        sb_free(b);
    }
    {
        /* reserve grows capacity ahead of appends (String::reserve) */
        sb *b = sb_new();
        ok(sb_reserve(b, 4096) == 0 && sb_len(b) == 0, "reserve-keeps-len");
        sb_puts(b, "ab");
        ok(sb_len(b) == 2 && tx_eqz(sb_cstr(b), "ab"), "reserve-then-append");
        ok(sb_reserve(b, 3) == 0, "reserve-no-op-when-cap-enough");
        ok(sb_capacity(b) >= 4096, "capacity-at-least-reserved");
        sb_free(b);
    }
    {
        /* capacity grows by doubling and never shrinks on clear (String::capacity) */
        sb *b = sb_new(); long c0, c1;
        c0 = sb_capacity(b);
        ok(c0 == 0, "fresh-capacity-0");
        sb_puts(b, "hello world");
        c1 = sb_capacity(b);
        ok(c1 >= 11 && c1 < 32, "first-grow-doubles-to-small");
        sb_clear(b);
        ok(sb_capacity(b) == c1, "clear-keeps-capacity");
        sb_free(b);
    }
    {
        /* putc appends one byte at a time (String::push) */
        sb *b = sb_new();
        ok(sb_putc(b, 'a') == 0 && sb_putc(b, 'b') == 0 && sb_putc(b, 'c') == 0 && sb_len(b) == 3, "putc-appends-bytes");
        ok(tx_eqz(sb_cstr(b), "abc"), "putc-then-cstr");
        ok(sb_putc(b, 0) == 0 && sb_len(b) == 4, "putc-nul-byte-counts");
        sb_free(b);
    }
    {
        /* truncate shortens without shrinking (String::truncate) */
        sb *b = sb_new();
        sb_puts(b, "abcdef");
        ok(sb_truncate(b, 3) == 0 && sb_len(b) == 3, "truncate-shortens");
        ok(sb_truncate(b, 9) == -1 && sb_len(b) == 3, "truncate-over-refused");
        ok(tx_eqz(sb_cstr(b), "abc"), "truncate-keeps-prefix");
        sb_free(b);
    }
    printf("PRACTICE_BUILD\tfailed=%d\n", bad);
    return bad;
}
