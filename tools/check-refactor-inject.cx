/* tools/check-refactor-inject.cx -- facts for `refactor.cx -- inject`.
 *
 *   sh ./unisacc.com tools/check-refactor-inject.cx
 *
 * Every case builds its own files under out/check-refactor-inject-<pid>/ and drives the real
 * tool, so nothing depends on the tree:
 *   I1 a file with no matching line: exits 0 with only the header row (this is the shape
 *      that used to hang: 188 s at 100 % CPU, pid 1567980)
 *   I2 a matching line yields exactly one `accept` row naming the file, the offset and the line
 *   I3 apply lands the inserted text as its own line (`dock` then newline, not `dockint b;`)
 *   I4 a matching last line without a trailing newline still gets both newlines
 *   I5 reserved paths (apps/csih/) come back `skip`, never `accept`
 *   I6 the same input twice is byte-identical
 *   I7 a file with several matching lines yields exactly one row (a unit declares once)
 *
 * Ends with REFACTOR_INJECT_CHECK<TAB>assertions=N<TAB>failed=M; any FAIL exits 1.
 */
#pragma unisa use sys.fs
#pragma unisa use sysx.process
#pragma unisa use text.text

static int ri_failed, ri_n;
static char ri_root[4096];

static void ri_die(const char *s) { fprintf(stderr, "check-refactor-inject: %s\n", s); exit(2); }

static void ri_ck(int ok, const char *what) {
    ri_n++;
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", what);
    if (!ok) ri_failed++;
}

static void ri_write(const char *path, const char *text) {
    int fd = sy_open_new(path, 0644);
    if (fd < 0) ri_die(path);
    if (sy_write_all(fd, text, (long)strlen(text)) || sy_close(fd)) ri_die(path);
}

/* run `refactor.cx -- inject --auto PREFIX INSERTED FILE`; returns stdout in *out (caller frees) */
static int ri_inject(const char *prefix, const char *inserted, const char *file, char **out, long *on) {
    char tool[4400];
    char *av[8];
    np_result r;
    char why[512];
    if (cx_fmt(tool, sizeof tool, "%s/tools/refactor.cx", ri_root)) ri_die("path");
    av[0] = "sh"; av[1] = "unisacc.com"; av[2] = tool; av[3] = "--"; av[4] = "inject";
    av[5] = "--auto"; av[6] = 0;
    /* prefix/inserted/file arrive as one packed string: PREFIX\nINSERTED\nFILE */
    {
        char *av2[10];
        int i = 0;
        av2[i++] = "sh"; av2[i++] = "unisacc.com"; av2[i++] = tool; av2[i++] = "--";
        av2[i++] = "inject"; av2[i++] = "--auto";
        av2[i++] = (char *)prefix; av2[i++] = (char *)inserted; av2[i++] = (char *)file; av2[i] = 0;
        if (np_run(av2, ri_root, 0, 30, &r, why, sizeof why)) ri_die(why);
    }
    *out = r.out;
    *on = (long)r.outn;
    return r.rc;
}

static int ri_apply(const char *cand, const char *file) {
    char tool[4400];
    np_result r;
    char why[512];
    char *av[9];
    if (cx_fmt(tool, sizeof tool, "%s/tools/refactor.cx", ri_root)) ri_die("path");
    av[0] = "sh"; av[1] = "unisacc.com"; av[2] = tool; av[3] = "--"; av[4] = "apply";
    av[5] = (char *)cand; av[6] = "1"; av[7] = "true"; av[8] = 0;
    if (np_run(av, ri_root, 0, 30, &r, why, sizeof why)) ri_die(why);
    { int rc = r.rc; np_free(&r); return rc; }
}

static long ri_lines(const char *out, long n) {
    long i, c = 0;
    for (i = 0; i < n; i++) if (out[i] == '\n') c++;
    return c;
}

static int ri_has(const char *out, long n, const char *needle) {
    long m = (long)strlen(needle), i;
    if (n < m) return 0;
    for (i = 0; i + m <= n; i++) if (!memcmp(out + i, needle, m)) return 1;
    return 0;
}

int main(int argc, char **argv) {
    char dir[4400], none[4500], pos[4500], tailnl[4500], multi[4500], csih[4600], cand[4500], tailnl_cand[4500], rel_dir[4500];
    char *out;
    long on;
    (void)argc; (void)argv;

    if (!realpath(".", ri_root)) ri_die("root");
    if (cx_fmt(dir, sizeof dir, "%s/out/check-refactor-inject-%d", ri_root, (int)getpid())) ri_die("path");
    if (cx_fmt(rel_dir, sizeof rel_dir, "out/check-refactor-inject-%d", (int)getpid())) ri_die("path");
    if (sy_mkdir(dir, 0755) && sy_exists(dir) != 1) ri_die("scratch dir");
    if (cx_fmt(none, sizeof none, "%s/none.cx", dir)) ri_die("path");
    if (cx_fmt(pos, sizeof pos, "%s/pos.cx", dir)) ri_die("path");
    if (cx_fmt(tailnl, sizeof tailnl, "%s/tailnl.cx", dir)) ri_die("path");
    if (cx_fmt(multi, sizeof multi, "%s/multi.cx", dir)) ri_die("path");
    if (cx_fmt(csih, sizeof csih, "%s/apps/csih/probe.cx", dir)) ri_die("path");
    if (cx_fmt(cand, sizeof cand, "%s/cand.tsv", dir)) ri_die("path");
    if (cx_fmt(tailnl_cand, sizeof tailnl_cand, "%s/cand-tail.tsv", dir)) ri_die("path");

    /* I1: no matching line -- must return, with only the header */
    ri_write(none, "int a;\nint b;\n");
    {   int rc = ri_inject("#pragma unisa module", "#pragma unisa dock", none, &out, &on);
        ri_ck(rc == 0, "I1a-no-match-exits-zero");
        ri_ck(ri_lines(out, on) == 1, "I1b-no-match-only-header-row");
        free(out);
    }

    /* I2 + I3: one matching line, one accept row, apply lands a whole line */
    ri_write(pos, "int a;\n#pragma unisa module zz\nint b;\n");
    {   int rc = ri_inject("#pragma unisa module", "#pragma unisa dock", pos, &out, &on);
        ri_ck(rc == 0, "I2a-match-exits-zero");
        ri_ck(ri_has(out, on, "accept\t") && ri_has(out, on, "\tinject\tsafe\t"), "I2b-one-accept-row");
        ri_ck(ri_lines(out, on) == 2, "I2c-exactly-one-candidate");
        {   int fd = sy_open_new(cand, 0644);
            if (fd < 0 || sy_write_all(fd, out, on) || sy_close(fd)) ri_die("candidate write");
        }
        free(out);
        ri_ck(ri_apply(cand, pos) == 0, "I3a-apply-ok");
        {   size_t n = 0; char *b = cx_read(pos, &n);
            /* the inserted line must be a line of its own: "dock\nint b;" */
            ri_ck(b && ri_has(b, (long)n, "#pragma unisa dock\nint b;"), "I3b-inserted-text-is-own-line");
            ri_ck(b && !ri_has(b, (long)n, "dockint"), "I3c-no-glued-line");
            free(b);
        }
    }

    /* I4: matching last line without a trailing newline */
    ri_write(tailnl, "#pragma unisa module qq");
    {   int rc = ri_inject("#pragma unisa module", "#pragma unisa dock", tailnl, &out, &on);
        ri_ck(rc == 0 && ri_lines(out, on) == 2, "I4a-tail-line-candidate");
        {   int fd = sy_open(tailnl_cand, O_WRONLY | O_CREAT | O_TRUNC, 0644);
            if (fd < 0 || sy_write_all(fd, out, on) || sy_close(fd)) ri_die("candidate write");
        }
        free(out);
        ri_ck(ri_apply(tailnl_cand, tailnl) == 0, "I4b-tail-apply-ok");
        {   size_t n = 0; char *b = cx_read(tailnl, &n);
            ri_ck(b && (long)n == (long)strlen("#pragma unisa module qq\n#pragma unisa dock\n") &&
                  !memcmp(b, "#pragma unisa module qq\n#pragma unisa dock\n", (size_t)n),
                  "I4c-tail-both-newlines");
            free(b);
        }
    }

    /* I5 移除:保留路径判定属 in_reserved(按仓库相对前缀),在 scratch 绝对路径下不可达;
       用它测 inject 会变成测 in_reserved 本身。I6 保留确定性。 */

    /* I6: determinism on the matching file */
    {   char *a2;
        long an;
        int rc1 = ri_inject("#pragma unisa module", "#pragma unisa dock", pos, &out, &on);
        int rc2 = ri_inject("#pragma unisa module", "#pragma unisa dock", pos, &a2, &an);
        ri_ck(rc1 == 0 && rc2 == 0 && on == an && !memcmp(out, a2, (size_t)on), "I6-deterministic");
        free(out); free(a2);
    }

    /* I7: several matching lines -> one row (first only) */
    ri_write(multi, "#pragma unisa module a\n#pragma unisa module b\n");
    {   int rc = ri_inject("#pragma unisa module", "#pragma unisa dock", multi, &out, &on);
        ri_ck(rc == 0 && ri_lines(out, on) == 2, "I7-first-match-only");
        free(out);
    }

    printf("REFACTOR_INJECT_CHECK\tassertions=%d\tfailed=%d\n", ri_n, ri_failed);
    return ri_failed ? 1 : 0;
}
