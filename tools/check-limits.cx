/* 生成库 cxlib.limits 的直接 API 合同: 值等于当前字面量, 未知 id 返回 -1, 覆盖行(启用时)按 scope 前缀命中。 */
#pragma unisa use cxlib.limits
#pragma unisa use text.text
int main(void){int failed=0;
if(!(lm_get("phase.bound",0)==90&&lm_get("segment",0)==270&&lm_get("op.rule",0)==300&&lm_get("segment.margin",0)==30))failed++;
if(!(lm_get("resumes",0)==3&&lm_get("attempts",0)==4096&&lm_get("deadline.s",0)==5400&&lm_get("cmd.front",0)==45))failed++;
if(!(lm_get("ctor",0)==55&&lm_get("s9.cmd",0)==55&&lm_get("s9.outer",0)==300.5&&lm_get("bg.slack",0)==600&&lm_get("bg.keep",0)==3))failed++;
if(!(lm_get("no.such",0)==-1.0&&lm_max("no.such","x")==-1.0))failed++;
if(!(lm_max("phase.bound","kernels-g2")>=lm_get("phase.bound","kernels-g2")&&lm_max("phase.bound","kernels-g2")<=lm_get("segment",0)-3))failed++;
if(!(lm_count()>=13))failed++;
printf("CHECK_LIMITS\tfailed=%d\n",failed);return failed?1:0;}
