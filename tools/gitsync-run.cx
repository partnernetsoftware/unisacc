/* tools/gitsync-run.cx -- cxlib.gitsync gs_sync 的进程入口:ref 已由调用方从 OLD 比较并交换到 NEW 后,同步共享索引与工作区。
 *   sh ./unisacc.com tools/gitsync-run.cx -- REPO OLD NEW
 * 输出:gs_report 的 SYNC_KEPT 行原样,末行 GITSYNC<TAB>rc=0<TAB>changed=N<TAB>synced=N<TAB>kept=N<TAB>ms=N;失败 GITSYNC rc=1 why=..,rc 1。
 * 存在理由:devsvc-core 的 sysx.process 与 cxlib.procrun 经 cxlib.netpack 各定义 struct np_buf,不能同一编译单元 use;
 * 重名修复(转 cdx)后 devsvc-core 可直接 use cxlib.gitsync,届时可删除本文件与 tools/check-gitsync-run.cx。
 * devsvc git merge/pull 经此进程(有 deadline)调用。调用方持锁,本工具不取锁。检查:tools/check-devsvc-git.cx --cases e。 */
#pragma unisa use cxlib.gitsync

int main(int argc, char **argv) {
    gs_report r;
    if (argc != 4) { fprintf(stderr, "usage: gitsync-run.cx -- REPO OLD NEW\n"); return 2; }
    memset(&r, 0, sizeof r);
    if (gs_sync(argv[1], argv[2], argv[3], &r) != 0) { printf("GITSYNC\trc=1\twhy=%s\n", r.why); gs_report_free(&r); return 1; }
    if (r.kept_text && r.kept_len) fwrite(r.kept_text, 1, r.kept_len, stdout);
    printf("GITSYNC\trc=0\tchanged=%d\tsynced=%d\tkept=%d\tms=%ld\n", r.changed, r.synced, r.kept, r.ms);
    gs_report_free(&r);
    return 0;
}
