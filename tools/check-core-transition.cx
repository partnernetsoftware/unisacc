#pragma unisa use core.transition
static int failed;
static void check(CxTransitionModel *m,int key,int wantn,int wants,const char *want,const char *name){
 int n=99,s=99;const char *why=cxtn_transition(m,0,key,&n,&s);
 int ok=n==wantn&&s==wants&&((!want&&!why)||(want&&why&&!strcmp(want,why)));
 if(!ok){fprintf(stderr,"FAIL %s n=%d s=%d why=%s\n",name,n,s,why?why:"-");failed++;}else printf("PASS %s\n",name);
}
int main(void){
 int mode[]={1},count[]={3},keys0[]={0,2,4},next0[]={1,1,-1},seq0[]={1,0,1};
 int *keys[]={keys0},*next[]={next0},*seq[]={seq0},lo[]={0},hi[]={5},bn[]={0},bs[]={0},rets[]={1};
 unsigned char ret0[]={0,1,0},*retok[]={ret0};CxTransitionModel m={0};
 m.ns=3;m.nq=2;m.mode=mode;m.count=count;m.keys=keys;m.next=next;m.seq=seq;m.lo=lo;m.hi=hi;m.base_next=bn;m.base_seq=bs;m.ret_seq=rets;m.ret_ok=retok;
 check(&m,1,1,1,0,"return");check(&m,2,1,0,0,"keyed");check(&m,3,-1,0,0,"keyed-miss");
 mode[0]=0;check(&m,0,1,1,0,"direct");
 m.isnet=1;check(&m,-1,-1,0,"observation outside network domain","domain");
 check(&m,0,1,1,0,"threshold-1");check(&m,2,2,1,0,"threshold-2");check(&m,4,-1,0,"invalid network output","invalid-output");
 /* Failure retains the initialized outputs, not partial accumulated values. */
 printf("CXCORE_TRANSITION failed=%d\n",failed);return failed?1:0;
}
