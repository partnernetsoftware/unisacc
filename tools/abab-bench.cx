/* tools/abab-bench.cx -- ABAB interleaved A/B wall-clock bench.
 *
 *   sh ./unisacc.com tools/abab-bench.cx -- --n N --a CMD_A --b CMD_B [--label X] [--load-max L]
 *
 * Runs A B A B ... (N rounds, 2N runs) through `sh -c`, each run a sy_proc_run child with a 60 s deadline
 * (stdout/stderr discarded), records wall ms and load1 (/proc/loadavg) before each run.
 * Output: one RUN line per run (RUN<TAB>idx<TAB>side<TAB>ms<TAB>load1), SIDE lines (min/med/max/cv per side),
 * and the last line
 *   ABAB label=X n=N a_med=.. b_med=.. diff_pct=.. a_cv=.. b_cv=.. noisy=0|1
 * diff_pct = (b_med - a_med) / a_med * 100.  noisy=1 when either cv (percent) > 5 or max load1 >= L (default 6).
 * Exit 0 on success, 1 when a run timed out or exited non-zero, 2 on usage error. */
#pragma unisa use sys.proc
#pragma unisa use sys.time
#pragma unisa use sys.fs
#pragma unisa use mem.heap

static double load1(void) {
    char *b = 0; long n = 0; double v = 0;
    if (sy_read_file("/proc/loadavg", &b, &n, 4096) == 0 && b) { v = atof(b); mm_free(b); }
    return v;
}

static void sort_l(long *a, int n) {
    int i, j;
    for (i = 1; i < n; i++) { long k = a[i]; for (j = i - 1; j >= 0 && a[j] > k; j--) a[j + 1] = a[j]; a[j + 1] = k; }
}

static double med_of(long *a, int n) {
    long s[512]; int i;
    for (i = 0; i < n; i++) s[i] = a[i];
    sort_l(s, n);
    return (n & 1) ? (double)s[n / 2] : ((double)s[n / 2 - 1] + (double)s[n / 2]) / 2.0;
}

static double cv_of(long *a, int n) {
    double m = 0, v = 0, x, r; int i;
    for (i = 0; i < n; i++) m += (double)a[i];
    m /= n;
    if (m <= 0) return 0;
    for (i = 0; i < n; i++) { x = (double)a[i] - m; v += x * x; }
    v /= n;
    r = v > 0 ? v : 0;
    if (r > 0) { x = r; for (i = 0; i < 60; i++) x = 0.5 * (x + r / x); r = x; }
    return r / m * 100.0;
}

int main(int argc, char **argv) {
    const char *ca = 0, *cb = 0, *label = "-";
    double lmax = 6.0, lmaxseen = 0, am, bm, acv, bcv, diff;
    long ms[2][256], mn[2], mx[2];
    int n = 0, i, side, cnt[2] = {0, 0}, bad = 0, noisy;
    for (i = 1; i < argc; i++) {
        if (!strcmp(argv[i], "--n") && i + 1 < argc) n = atoi(argv[++i]);
        else if (!strcmp(argv[i], "--a") && i + 1 < argc) ca = argv[++i];
        else if (!strcmp(argv[i], "--b") && i + 1 < argc) cb = argv[++i];
        else if (!strcmp(argv[i], "--label") && i + 1 < argc) label = argv[++i];
        else if (!strcmp(argv[i], "--load-max") && i + 1 < argc) lmax = atof(argv[++i]);
        else { fprintf(stderr, "abab-bench: unknown arg %s\n", argv[i]); return 2; }
    }
    if (n < 1 || n > 250 || !ca || !cb) { fprintf(stderr, "usage: abab-bench --n N(1..250) --a CMD --b CMD [--label X] [--load-max L]\n"); return 2; }
    for (i = 0; i < 2 * n; i++) {
        sy_spawn_t o; sy_exit_t st; char *av[4]; long t0; double l; int r;
        side = i & 1;
        av[0] = "sh"; av[1] = "-c"; av[2] = (char *)(side ? cb : ca); av[3] = 0;
        l = load1();
        if (l > lmaxseen) lmaxseen = l;
        sy_spawn_init(&o); o.argv = av; o.pgroup = -1; o.deadline_ms = 60000;
        o.in_fd = SY_STDIO_NULL; o.out_fd = SY_STDIO_NULL; o.err_fd = SY_STDIO_NULL;
        t0 = sy_now_ms();
        r = sy_proc_run(&o, &st);
        ms[side][cnt[side]] = sy_now_ms() - t0;
        if (r || st.timed_out || sy_exit_code(&st) != 0) bad++;
        printf("RUN\t%d\t%c\t%ld\t%.2f\n", i, side ? 'B' : 'A', ms[side][cnt[side]], l);
        cnt[side]++;
    }
    for (side = 0; side < 2; side++) {
        mn[side] = mx[side] = ms[side][0];
        for (i = 1; i < n; i++) { if (ms[side][i] < mn[side]) mn[side] = ms[side][i]; if (ms[side][i] > mx[side]) mx[side] = ms[side][i]; }
        printf("SIDE\t%c\tmin=%ld\tmed=%.1f\tmax=%ld\tcv=%.2f\n", side ? 'B' : 'A', mn[side], med_of(ms[side], n), mx[side], cv_of(ms[side], n));
    }
    am = med_of(ms[0], n); bm = med_of(ms[1], n); acv = cv_of(ms[0], n); bcv = cv_of(ms[1], n);
    diff = am > 0 ? (bm - am) / am * 100.0 : 0;
    noisy = (acv > 5.0 || bcv > 5.0 || lmaxseen >= lmax) ? 1 : 0;
    printf("ABAB label=%s n=%d a_med=%.1f b_med=%.1f diff_pct=%.2f a_cv=%.2f b_cv=%.2f noisy=%d\n", label, n, am, bm, diff, acv, bcv, noisy);
    return bad ? 1 : 0;
}
