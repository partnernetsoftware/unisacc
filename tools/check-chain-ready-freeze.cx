/* tools/check-chain-ready-freeze.cx -- fixtures for chain-ready item 23-freeze-armed (R27 S2: the freeze commit F
 * is the chain start commit).  Every fixture is a private git repository with a private bare origin under the
 * system temp dir; the shared checkout is only read (tools/chain-ready.cx and its modules).
 *   cx tools/check-chain-ready-freeze.cx [-- [--no-mutants | --cases-only | --mutants-only | --mutant-index M | --mutant-range FROM COUNT | --merge-shards FILE...]]
 * Red cases, one per FAIL branch: no freeze row, expired row, malformed row, owner mismatch, PUSH-FREEZE without an
 * owner variable, HEAD behind origin/main, no origin/main, numbering commit after the freeze commit, uncommitted
 * numbering change.  Green cases: committed row with matching DEVSVC_OWNER, matching UNISACC_INTEGRATOR, numbering
 * inside the freeze commit, PUSH-FREEZE with an owner variable.
 * Mutants: a private tree (symlinks to cx, tools/cxlib, cxroot.tsv, the product) holds chain-ready.cx with one FAIL
 * branch disabled; the fixture aimed at that branch must turn from red to green-wrong, i.e. the check must see it.
 * Ends with CHAIN_READY_FREEZE passed=N failed=M; exit 0 only when failed=0. */
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use text.text
#pragma unisa use text.conv
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use sys.posix

#define UC "./unisacc.com" /* lint:allow R1 fixtures run tools/chain-ready.cx under the installed product */
static int passed, failed;
static char tmpd[300], cwd[4400], out[16384];
static const char *bound_s = "40";

static void fz_ck(int ok, const char *name) {
    if (ok) { passed++; printf("PASS\t%s\n", name); } else { failed++; printf("FAIL\t%s\t%.400s\n", name, out); }
}
static int fz_seen(const char *w) { return strstr(out, w) != 0; }
/* sh -c CMD in DIR (bounded by tools/bound BOUND_S seconds, 40 by default), stdout+stderr into out; the exit code or -1 */
static int sh_in(const char *dir, const char *cmd) {
    char b[4400]; int fd = -1, pid, ex = 0, code = 0, sig = 0; long n = 0, r;
    char *v[] = {"./tools/bound", (char *)bound_s, "sh", "-c", b, 0};
    out[0] = 0;
    if (cx_fmt(b, sizeof b, "cd '%s' && { %s; } 2>&1", dir, cmd)) return -1;
    pid = sy_spawn_pipe(v, 0, 0, &fd, 0);
    if (pid <= 0) return -1;
    while (n < (long)sizeof out - 1 && (r = sy_read(fd, out + n, sizeof out - 1 - (size_t)n)) > 0) n += r;
    out[n] = 0; sy_close(fd);
    return sy_wait_status(pid, 0, &ex, &code, &sig) == pid && ex ? code : -1;
}
#define G "git -c user.name=t -c user.email=t@t -c commit.gpgsign=false "
/* a fresh repo R with bare origin: numbering files committed and pushed (commit A) */
static void fresh(const char *r) {
    char c[2000];
    cx_fmt(c, sizeof c, "rm -rf '%s' '%s.git' && git init -q --bare '%s.git' && git init -q -b main '%s' && cd '%s' && "
           "mkdir -p build/layer-api && printf 'p\\t1\\n' > build/tlib-packages.tsv && printf 'h\\t1\\n' > build/iface-hash.tsv && "
           "printf 'a\\n' > build/layer-api/x.tsv && printf 'x\\n' > f.txt && " G "add -A && " G "commit -qm A && "
           "git remote add origin '%s.git' && git push -q origin main", r, r, r, r, r, r);
    if (sh_in(tmpd, c)) printf("SETUP\tfresh\t%.300s\n", out);
}
static void in_repo(const char *r, const char *cmd) { if (sh_in(r, cmd)) printf("SETUP\t%s\t%.300s\n", cmd, out); }
/* chain-ready --only 23-freeze-armed --repo R from TREE, with ENV ("env -u ... K=V" prefix, may be empty) */
static int ready(const char *tree, const char *r, const char *env) {
    char c[2000];
    cx_fmt(c, sizeof c, "env -u DEVSVC_OWNER -u UNISACC_INTEGRATOR %s sh " UC " tools/chain-ready.cx -- --repo '%s' --only 23-freeze-armed", env, r);
    return sh_in(tree, c);
}
#define ROW_OK "printf 'sid1\\tbase\\tcc\\t4102444800\\tsrc\\n' > build/freeze.tsv"
#define COMMIT_PUSH " && " G "add -A && " G "commit -qm step && git push -q origin main"

typedef struct { const char *name, *setup, *env, *want_rc_kind, *frag; } Case;
/* want: "FAIL" (rc 1 and the named reason) or "PASS" (rc 0 and the fragment) */
static const Case cases[] = {
    {"not-armed-no-row", "true", "DEVSVC_OWNER=cc", "FAIL", "FREEZE_NOT_ARMED"},
    {"expired-row", "printf 'sid1\\tbase\\tcc\\t1\\tsrc\\n' > build/freeze.tsv" COMMIT_PUSH, "DEVSVC_OWNER=cc", "FAIL", "FREEZE_NOT_ARMED"},
    {"malformed-row", "printf 'sid1\\tbase\\tcc\\tabc\\tsrc\\n' > build/freeze.tsv" COMMIT_PUSH, "DEVSVC_OWNER=cc", "FAIL", "FREEZE_TABLE_MALFORMED"},
    {"owner-mismatch", ROW_OK COMMIT_PUSH, "DEVSVC_OWNER=other", "FAIL", "FREEZE_OWNER_MISMATCH active freeze row owner=cc"},
    {"marker-without-owner-env", "touch .git/PUSH-FREEZE", "", "FAIL", "FREEZE_OWNER_MISMATCH PUSH-FREEZE"},
    {"behind-origin-main", ROW_OK COMMIT_PUSH " && git update-ref refs/remotes/origin/main $(" G "commit-tree HEAD^{tree} -p HEAD -m other)", "DEVSVC_OWNER=cc UNISACC_FREEZE_NO_FETCH=1", "FAIL", "FREEZE_BEHIND_MAIN behind=1"},
    {"no-origin-main", ROW_OK COMMIT_PUSH " && git update-ref -d refs/remotes/origin/main", "DEVSVC_OWNER=cc UNISACC_FREEZE_NO_FETCH=1", "FAIL", "FREEZE_ORIGIN_MAIN_UNKNOWN"},
    {"origin-advanced-fetch-behind", ROW_OK COMMIT_PUSH " && { O=$(git remote get-url origin); C=$(" G "commit-tree HEAD^{tree} -p HEAD -m remote-adv); git push -q \"$O\" \"$C\":refs/heads/main && git update-ref refs/remotes/origin/main HEAD; }", "DEVSVC_OWNER=cc", "FAIL", "FREEZE_BEHIND_MAIN behind=1"},
    {"fetch-failed-unknown", ROW_OK COMMIT_PUSH " && git remote set-url origin /nonexistent-freeze-origin-url", "DEVSVC_OWNER=cc", "FAIL", "FREEZE_ORIGIN_MAIN_UNKNOWN git fetch origin failed"},
    {"numbering-after-freeze", ROW_OK COMMIT_PUSH " && printf 'h\\t2\\n' > build/iface-hash.tsv" COMMIT_PUSH, "DEVSVC_OWNER=cc", "FAIL", "FREEZE_TLIB_AFTER_FREEZE numbering commit"},
    {"numbering-uncommitted", ROW_OK COMMIT_PUSH " && printf 'p\\t2\\n' > build/tlib-packages.tsv", "DEVSVC_OWNER=cc", "FAIL", "FREEZE_TLIB_AFTER_FREEZE uncommitted"},
    {"armed-owner", ROW_OK COMMIT_PUSH, "DEVSVC_OWNER=cc", "PASS", "armed: freeze.tsv sid=sid1 owner=cc"},
    {"armed-integrator", ROW_OK COMMIT_PUSH, "UNISACC_INTEGRATOR=CC", "PASS", "armed: freeze.tsv sid=sid1"},
    {"armed-numbering-in-freeze-commit", ROW_OK " && printf 'h\\t3\\n' > build/iface-hash.tsv" COMMIT_PUSH, "DEVSVC_OWNER=cc", "PASS", "numbering files unchanged after the freeze"},
    {"armed-uncommitted-row", ROW_OK, "DEVSVC_OWNER=cc", "PASS", "armed: freeze.tsv"},
    {"armed-marker-with-owner", "touch .git/PUSH-FREEZE", "UNISACC_INTEGRATOR=cc", "PASS", "armed: PUSH-FREEZE marker owner-env=cc"},
};
#define NCASES ((int)(sizeof cases / sizeof cases[0]))

/* run case K from TREE; 1 when the observed verdict matches the case's expectation */
static int run_case(const char *tree, int k) {
    char r[600]; int rc;
    cx_fmt(r, sizeof r, "%s/r%d", tmpd, k);
    fresh(r); in_repo(r, cases[k].setup);
    rc = ready(tree, r, cases[k].env);
    if (tx_eqz(cases[k].want_rc_kind, "FAIL")) return rc == 1 && fz_seen("23-freeze-armed\tFAIL") && fz_seen(cases[k].frag) && fz_seen("READY\tno");
    return rc == 0 && fz_seen("23-freeze-armed\tPASS") && fz_seen(cases[k].frag) && fz_seen("READY\tyes");
}

/* mutant: OLD (must occur exactly once in chain-ready.cx) replaced by NEW; CASE must then stop matching */
typedef struct { const char *name, *old, *neu, *kcase; } Mut;
static const Mut muts[] = {
    {"drop-not-armed", "if (!marker) { put_ev(ev, cap, \"FREEZE_NOT_ARMED", "if (0) { put_ev(ev, cap, \"FREEZE_NOT_ARMED", "not-armed-no-row"},
    {"drop-expiry", "if ((long)dl <= now) continue;", "(void)now;", "expired-row"},
    {"drop-malformed", "mm_free(ft); cx_fmt(ev, (size_t)cap, \"FREEZE_TABLE_MALFORMED", "continue; cx_fmt(ev, (size_t)cap, \"FREEZE_TABLE_MALFORMED", "malformed-row"},
    {"drop-owner-mismatch", "if (!matched && table_rows_owner_bad) {", "if (0 && table_rows_owner_bad) {", "owner-mismatch"},
    {"drop-marker-owner", "if (!(own && own[0]) && !(integ && integ[0])) { put_ev", "if (0) { put_ev", "marker-without-owner-env"},
    {"drop-behind", "if (behind > 0) {", "if (0) {", "behind-origin-main"},
    {"drop-fetch", "if (!(nofetch && nofetch[0] == '1')) {", "if (0) {", "origin-advanced-fetch-behind"},
    {"drop-tlib-dirty", "if (buf[0]) { cx_fmt(ev, (size_t)cap, \"FREEZE_TLIB_AFTER_FREEZE uncommitted", "if (0) { cx_fmt(ev, (size_t)cap, \"FREEZE_TLIB_AFTER_FREEZE uncommitted", "numbering-uncommitted"},
    {"drop-tlib-order", "if (r == 1) { cx_fmt(ev, (size_t)cap, \"FREEZE_TLIB_AFTER_FREEZE", "if (0) { cx_fmt(ev, (size_t)cap, \"FREEZE_TLIB_AFTER_FREEZE", "numbering-after-freeze"},
};
#define NMUTS ((int)(sizeof muts / sizeof muts[0]))

static int case_index(const char *n) { for (int k = 0; k < NCASES; k++) if (tx_eqz(cases[k].name, n)) return k; return -1; }
static long fz_locate(const char *s, long sl, const char *p, long pl) {
    if (pl <= 0 || pl > sl) return -1;
    for (long i = 0; i + pl <= sl; i++) {
        long j = 0;
        while (j < pl && s[i + j] == p[j]) j++;
        if (j == pl) return i;
    }
    return -1;
}

static void mutants(int from, int count) {
    char mt[600], c[4800], p[4500], warm[4400]; size_t sn = 0; char *src; int ok[NMUTS];
    int end = from + count;
    if (from < 0) from = 0;
    if (end > NMUTS) end = NMUTS;
    cx_fmt(p, sizeof p, "%s/tools/chain-ready.cx", cwd);
    src = cx_read(p, &sn);
    if (!src) {
        failed++;
        puts("FAIL\tmutant-source-unreadable");
        for (int m = from; m < end; m++) {
            printf("MUTANT_RESULT\tidx=%d\tname=%s\tcase=%s\tstatus=FAIL\trc=1\n", m, muts[m].name, muts[m].kcase);
        }
        return;
    }
    for (int m = from; m < end; m++) {
        const char *o = muts[m].old; long ol = (long)tx_len(o, 4096), nl = (long)tx_len(muts[m].neu, 4096);
        long at = fz_locate(src, (long)sn, o, ol);
        ok[m] = 0;
        if (at < 0 || fz_locate(src + at + ol, (long)sn - at - ol, o, ol) >= 0 || case_index(muts[m].kcase) < 0) {
            failed++;
            printf("FAIL\tmutant-%s\tanchor not found exactly once\n", muts[m].name);
            printf("MUTANT_RESULT\tidx=%d\tname=%s\tcase=%s\tstatus=FAIL\trc=1\n", m, muts[m].name, muts[m].kcase);
            continue;
        }
        cx_fmt(mt, sizeof mt, "%s/mut%d", tmpd, m);
        cx_fmt(c, sizeof c, "mkdir -p '%s/tools' && ln -sT '%s/cx' '%s/cx' && ln -s '%s/cxroot.tsv' '%s/cxroot.tsv' && ln -s '%s/unisacc.com' '%s/unisacc.com' && "
               "ln -sT '%s/tools/cxlib' '%s/tools/cxlib' && ln -s '%s/tools/bound' '%s/tools/bound' && { [ ! -e '%s/ext' ] || ln -sT '%s/ext' '%s/ext'; }",
               mt, cwd, mt, cwd, mt, cwd, mt, cwd, mt, cwd, mt, cwd, cwd, mt);
        if (sh_in(tmpd, c)) {
            failed++;
            printf("FAIL\tmutant-%s-tree\t%.300s\n", muts[m].name, out);
            printf("MUTANT_RESULT\tidx=%d\tname=%s\tcase=%s\tstatus=FAIL\trc=1\n", m, muts[m].name, muts[m].kcase);
            continue;
        }
        size_t mn = sn - (size_t)ol + (size_t)nl; char *mb = mm_alloc((long)mn + 1);
        if (!mb) {
            failed++;
            puts("FAIL\tmutant-alloc");
            printf("MUTANT_RESULT\tidx=%d\tname=%s\tcase=%s\tstatus=FAIL\trc=1\n", m, muts[m].name, muts[m].kcase);
            continue;
        }
        mm_copy(mb, (long)mn + 1, src, at);
        mm_copy(mb + at, (long)mn + 1 - at, muts[m].neu, nl);
        mm_copy(mb + at + nl, (long)mn + 1 - at - nl, src + at + ol, (long)sn - at - ol);
        cx_fmt(p, sizeof p, "%s/tools/chain-ready.cx", mt);
        int w = cx_write(p, mb, mn); mm_free(mb);
        if (w) {
            failed++;
            printf("FAIL\tmutant-%s\twrite\n", muts[m].name);
            printf("MUTANT_RESULT\tidx=%d\tname=%s\tcase=%s\tstatus=FAIL\trc=1\n", m, muts[m].name, muts[m].kcase);
            continue;
        }
        ok[m] = 1;
    }
    mm_free(src);
    /* Warm-compile at most 2 mutants per batch so each shard stays well below the 55 s budget on 2 cores. */
    for (int m = from; m < end; ) {
        long wn = 0; int batch = 0;
        warm[0] = 0;
        while (m < end && batch < 2) {
            if (ok[m]) {
                cx_fmt(mt, sizeof mt, "%s/mut%d", tmpd, m);
                if (cx_fmt(warm + wn, sizeof warm - (size_t)wn, "(cd '%s' && sh " UC " tools/chain-ready.cx -- --only 9-ledger >/dev/null 2>&1) & ", mt)) {
                    ok[m] = 0; failed++; puts("FAIL\tmutant-warm-capacity");
                    printf("MUTANT_RESULT\tidx=%d\tname=%s\tcase=%s\tstatus=FAIL\trc=1\n", m, muts[m].name, muts[m].kcase);
                } else {
                    wn = (long)tx_len(warm, sizeof warm);
                    batch++;
                }
            }
            m++;
        }
        if (wn && cx_fmt(warm + wn, sizeof warm - (size_t)wn, "wait") == 0) { bound_s = "48"; (void)sh_in(tmpd, warm); bound_s = "40"; }
    }
    for (int m = from; m < end; m++) {
        char nm[200]; if (!ok[m]) continue;
        cx_fmt(nm, sizeof nm, "mutant-%s-turns-%s", muts[m].name, muts[m].kcase);
        cx_fmt(mt, sizeof mt, "%s/mut%d", tmpd, m);
        /* the targeted fixture must no longer give its expected verdict under the mutant; a mutant that does not
           even start (no 23-freeze-armed row) proves nothing, so it fails the check too */
        int still = run_case(mt, case_index(muts[m].kcase));
        int ran = fz_seen("23-freeze-armed\t");
        if (!still && ran) {
            passed++;
            printf("PASS\t%s\n", nm);
            printf("MUTANT_RESULT\tidx=%d\tname=%s\tcase=%s\tstatus=PASS\trc=0\n", m, muts[m].name, muts[m].kcase);
        } else {
            failed++;
            printf("FAIL\t%s\t%s\n", nm, ran ? "mutant survived" : "mutant did not run");
            printf("MUTANT_RESULT\tidx=%d\tname=%s\tcase=%s\tstatus=FAIL\trc=1\n", m, muts[m].name, muts[m].kcase);
        }
    }
}

static int merge_shards(int nfiles, char **files) {
    int seen[NMUTS], stat_ok[NMUTS];
    int m_pass = 0, m_fail = 0, m_miss = 0, m_dup = 0;
    for (int i = 0; i < NMUTS; i++) { seen[i] = 0; stat_ok[i] = 0; }
    for (int f = 0; f < nfiles; f++) {
        size_t n = 0; char *b = cx_read(files[f], &n);
        if (!b) {
            printf("FAIL\tmerge-shard-unreadable\t%s\n", files[f]);
            printf("CHAIN_READY_FREEZE_MERGED\ttotal=%d\tpassed=0\tfailed=1\tmissing=%d\n", NMUTS, NMUTS);
            return 1;
        }
        long at = 0;
        while (at < (long)n) {
            long e = at;
            while (e < (long)n && b[e] != '\n') e++;
            long ln = e - at;
            const char *l = b + at;
            at = e + 1;
            if (ln > 14 && tx_prefix(l, ln, "MUTANT_RESULT\t", 14)) {
                char row[512];
                long cl = ln < (long)sizeof row - 1 ? ln : (long)sizeof row - 1;
                mm_copy(row, sizeof row, l, cl); row[cl] = 0;
                const char *ip = strstr(row, "\tidx=");
                const char *np = strstr(row, "\tname=");
                const char *sp = strstr(row, "\tstatus=");
                const char *rp = strstr(row, "\trc=");
                if (ip && np && sp && rp) {
                    int64_t idx = -1, mrc = -1;
                    long il = 0; while (ip[5 + il] >= '0' && ip[5 + il] <= '9') il++;
                    long rl = 0; while (rp[4 + rl] >= '0' && rp[4 + rl] <= '9') rl++;
                    if (il > 0 && !tx_to_i64(ip + 5, il, 10, &idx) && idx >= 0 && idx < NMUTS &&
                        rl > 0 && !tx_to_i64(rp + 4, rl, 10, &mrc)) {
                        long nl = (long)strlen(muts[idx].name);
                        int nmatch = (!strncmp(np + 6, muts[idx].name, (size_t)nl) && (np[6 + nl] == '\t' || np[6 + nl] == 0));
                        int ok_row = nmatch && (!strncmp(sp + 8, "PASS\t", 5) || tx_eqz(sp + 8, "PASS")) && mrc == 0;
                        if (seen[idx]) m_dup++;
                        seen[idx]++;
                        if (ok_row && stat_ok[idx] != -1) stat_ok[idx] = 1;
                        else stat_ok[idx] = -1;
                    }
                }
            }
        }
        mm_free(b);
    }
    for (int i = 0; i < NMUTS; i++) {
        if (!seen[i]) {
            m_miss++;
            printf("FAIL\tmerge-missing-mutant\tidx=%d\tname=%s\n", i, muts[i].name);
        } else if (stat_ok[i] == 1) {
            m_pass++;
        } else {
            m_fail++;
            printf("FAIL\tmerge-failed-mutant\tidx=%d\tname=%s\n", i, muts[i].name);
        }
    }
    printf("CHAIN_READY_FREEZE_MERGED\ttotal=%d\tpassed=%d\tfailed=%d\tmissing=%d\tdup=%d\n",
           NMUTS, m_pass, m_fail, m_miss, m_dup);
    return (m_fail || m_miss || m_pass != NMUTS) ? 1 : 0;
}

int main(int argc, char **argv) {
    int no_mut = 0, run_cases = 1, mfrom = 0, mcount = NMUTS, do_merge = 0;
    int merge_at = 0;
    for (int a = 1; a < argc; a++) {
        if (tx_eqz(argv[a], "--no-mutants") || tx_eqz(argv[a], "--cases-only")) no_mut = 1;
        else if (tx_eqz(argv[a], "--mutants-only")) run_cases = 0;
        else if (tx_eqz(argv[a], "--mutant-index") && a + 1 < argc) {
            int64_t idx = -1;
            if (tx_to_i64(argv[a + 1], (long)tx_len(argv[a + 1], 16), 10, &idx) || idx < 0 || idx >= NMUTS) {
                printf("FAIL\tbad-mutant-index\t%s\n", argv[a + 1]); return 2;
            }
            run_cases = 0; mfrom = (int)idx; mcount = 1; a++;
        } else if (tx_eqz(argv[a], "--mutant-range") && a + 2 < argc) {
            int64_t f = -1, c = -1;
            if (tx_to_i64(argv[a + 1], (long)tx_len(argv[a + 1], 16), 10, &f) ||
                tx_to_i64(argv[a + 2], (long)tx_len(argv[a + 2], 16), 10, &c) || f < 0 || c <= 0) {
                printf("FAIL\tbad-mutant-range\n"); return 2;
            }
            mfrom = (int)f; mcount = (int)c; a += 2;
        } else if (tx_eqz(argv[a], "--merge-shards") && a + 1 < argc) {
            do_merge = 1; merge_at = a + 1; break;
        } else {
            printf("FAIL\tbad-arg\t%s\n", argv[a]); return 2;
        }
    }
    if (do_merge) return merge_shards(argc - merge_at, argv + merge_at);
    if (sy_cwd(cwd, sizeof cwd)) { puts("FAIL\tcwd"); return 1; }
    if (sy_mkdtemp(sy_tmpdir(), "chain-ready-freeze-", tmpd, sizeof tmpd) != 0) { puts("FAIL\ttmpdir"); return 1; }
    if (run_cases) {
        for (int k = 0; k < NCASES; k++) { char nm[200]; cx_fmt(nm, sizeof nm, "%s-%s", cases[k].name, cases[k].want_rc_kind); fz_ck(run_case(cwd, k), nm); }
    }
    if (!no_mut) mutants(mfrom, mcount);
    if (sy_remove_all(tmpd)) fprintf(stderr, "check-chain-ready-freeze: cleanup failed %s\n", tmpd);
    printf("CHAIN_READY_FREEZE\tpassed=%d\tfailed=%d\n", passed, failed);
    return failed ? 1 : 0;
}
