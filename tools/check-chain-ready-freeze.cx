    {"armed-numbering-in-freeze-commit", ROW_OK " && printf 'h\\t3\\n' > build/iface-hash.tsv" COMMIT_PUSH, "DEVSVC_OWNER=cc", "PASS", "numbering files unchanged after the freeze"},
    {"armed-uncommitted-row", ROW_OK, "DEVSVC_OWNER=cc", "PASS", "armed: freeze.tsv"},
