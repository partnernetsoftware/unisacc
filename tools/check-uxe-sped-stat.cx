/* tools/check-uxe-sped-stat.cx -- 转调 uxe-sped-stat --check.
 *
 * sh ./unisacc.com tools/check-uxe-sped-stat.cx --
 */
int main(void) {
    char *av[6];
    char *out = 0;
    size_t n = 0;
    int rc;
    av[0] = "sh";
    av[1] = "./unisacc.com";
    av[2] = "tools/uxe-sped-stat.cx";
    av[3] = "--";
    av[4] = "--check";
    av[5] = 0;
    rc = cx_runv_timeout(av, 40, &out, &n);
    if (out && n) fwrite(out, 1, n, stdout);
    if (out) free(out);
    return rc == 0 ? 0 : 1;
}
