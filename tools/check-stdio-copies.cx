/* tools/check-stdio-copies.cx -- byte ratchet for inlined stdio copies in a chain.
 *
 *   sh ./unisacc.com tools/check-stdio-copies.cx -- CHAIN [--allow FILE]
 *   sh ./unisacc.com tools/check-stdio-copies.cx -- --obj-dir DIR [--allow FILE]
 *
 * CHAIN is a chain directory. For each fixedpoint/g2/<target>/*.o, nm -n sizes the
 * non-label t/T symbols _u_vfmt _u_ffmt _u_dexp fprintf vfprintf printf snprintf
 * vsnprintf fputs. A symbol's bytes are the address delta to the next different
 * address, or the .text section end for the last symbol. Same-address aliases count
 * once. __unisacc_L labels are skipped; __unisacc_R rewrites of those names count.
 * Prints UNIT lines for copies, then one SUMMARY per target that had objects.
 * A target with no .o is skipped. --target T scans only that target. The run
 * refuses only when no selected target has any objects.
 *
 * --obj-dir DIR scans a flat directory of .o (a priv-relink output, not a chain).
 * Every object is printed, including 0 B, so a unit that dropped its copy is visible.
 * The target column is obj-dir. --allow still fails only a unit whose bytes are > 0.
 *
 * --allow FILE is a unit list, one basename per line. Any unit outside the list
 * that carries a copy fails the ratchet (exit 1). Blank lines and # comments skip.
 *
 * No arguments: a fixture proves the delta and the allow refusal, then prints
 * STDIO_COPIES and two PASS lines. Exit 0 only when the fixture passes, or a scan
 * has no ratchet failure.

 */
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sys.io
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use cxlib.receipt

#define SC_MAX 4000
#define SC_LINE 256
static char sc_name[SC_MAX][64];
static char sc_tgt[SC_MAX][32];
static long sc_bytes[SC_MAX];
static int sc_n;
static int sc_fail;
static const char *sc_run_id;
static char sc_scanned[16][32];
static int sc_scanned_n;

static int sc_bare(const char *n) {
    return tx_eq(n, "_u_vfmt", 16) || tx_eq(n, "_u_ffmt", 16) || tx_eq(n, "_u_dexp", 16)
        || tx_eq(n, "fprintf", 16) || tx_eq(n, "vfprintf", 16) || tx_eq(n, "printf", 16)
        || tx_eq(n, "snprintf", 16) || tx_eq(n, "vsnprintf", 16) || tx_eq(n, "fputs", 16);
}

static int sc_want(const char *n) {
    if (sc_bare(n)) return 1;
    if (tx_prefixz(n, "__unisacc_R", 11) && sc_bare(n + 11)) return 1;
    return 0;
}

static int sc_label(const char *n) {
    return tx_prefixz(n, "__unisacc_L", 11);
}

static int sc_hex(const char *s, unsigned long long *o) {
    unsigned long long v = 0;
    int i = 0;
    if (!s || !s[0]) return 1;
    while (s[i]) {
        int c = s[i];
        int d;
        if (c >= '0' && c <= '9') d = c - '0';
        else if (c >= 'a' && c <= 'f') d = c - 'a' + 10;
        else if (c >= 'A' && c <= 'F') d = c - 'A' + 10;
        else return 1;
        v = (v << 4) + (unsigned long long)d;
        i = i + 1;
        if (i > 16) return 1;
    }
    *o = v;
    return 0;
}

static int sc_add(const char *tgt, const char *unit, long bytes, int keep0) {
    int i;
    if (bytes <= 0 && !keep0) return 0;
    if (bytes < 0) return 0;
    if (sc_n >= SC_MAX) return 1;
    i = sc_n;
    if (tx_copy(sc_tgt[i], 32, tgt, (long)tx_len(tgt, 31))) return 1;
    if (tx_copy(sc_name[i], 64, unit, (long)tx_len(unit, 63))) return 1;
    sc_bytes[i] = bytes;
    sc_n = sc_n + 1;
    return 0;
}

/* Parse one nm -n dump. Returns the copy bytes in this object. */
static long sc_parse(const char *text, long n, unsigned long long sect_end) {
    unsigned long long addr[8000];
    char sym[8000][64];
    int ns = 0;
    long at = 0;
    long sum = 0;
    int i;
    while (at < n) {
        char line[SC_LINE];
        char a[32], typ[8], name[64];
        long e = at;
        int f;
        unsigned long long av;
        while (e < n && text[e] != '\n') e = e + 1;
        if (e - at < SC_LINE && e > at) {
            if (tx_copy(line, SC_LINE, text + at, e - at)) return -1;
            f = 0;
            a[0] = typ[0] = name[0] = 0;
            {
                long p = 0, q;
                char *dst;
                int cap;
                while (p < e - at) {
                    while (p < e - at && (line[p] == ' ' || line[p] == '\t')) p = p + 1;
                    q = p;
                    while (q < e - at && line[q] != ' ' && line[q] != '\t') q = q + 1;
                    dst = f == 0 ? a : f == 1 ? typ : name;
                    cap = f == 0 ? 32 : f == 1 ? 8 : 64;
                    if (f < 3 && tx_copy(dst, cap, line + p, q - p)) { f = 9; break; }
                    f = f + 1;
                    p = q;
                }
            }
            if (f >= 3 && (typ[0] == 't' || typ[0] == 'T') && typ[1] == 0 && !sc_label(name) && name[63] == 0 && !sc_hex(a, &av)) {
                if (ns < 8000) {
                    addr[ns] = av;
                    if (tx_copy(sym[ns], 64, name, (long)tx_len(name, 63))) return -1;
                    ns = ns + 1;
                } else return -1;
            }
        }
        at = e + 1;
    }
    for (i = 0; i < ns; i = i + 1) {
        unsigned long long nxt;
        int j;
        if (!sc_want(sym[i])) continue;
        if (i > 0 && addr[i] == addr[i - 1] && sc_want(sym[i - 1])) continue;
        nxt = 0;
        for (j = i + 1; j < ns; j = j + 1) if (addr[j] > addr[i]) { nxt = addr[j]; break; }
        if (!nxt) {
            if (sect_end <= addr[i]) return -1;
            nxt = sect_end;
        }
        sum = sum + (long)(nxt - addr[i]);
    }
    return sum;
}

static int sc_nm(const char *path, const char *outp) {
    char *av[4];
    sy_spawn_t o;
    sy_exit_t st;
    int fd = sy_open(outp, O_WRONLY | O_CREAT | O_TRUNC, 0600);
    if (fd < 0) return 1;
    av[0] = "nm"; av[1] = "-n"; av[2] = (char *)path; av[3] = 0;
    sy_spawn_init(&o);
    o.argv = av; o.pgroup = -1; o.deadline_ms = 20000; o.out_fd = fd; o.err_fd = SY_STDIO_NULL;
    if (sy_proc_run(&o, &st) || st.timed_out || sy_exit_code(&st) != 0) { sy_close(fd); return 1; }
    sy_close(fd);
    return 0;
}
static int sc_text_end(const char *path, const char *outp, unsigned long long *end) {
    char *av[5];
    sy_spawn_t o;
    sy_exit_t st;
    unsigned char *b = 0;
    int64_t n = 0;
    long at = 0;
    int fd = sy_open(outp, O_WRONLY | O_CREAT | O_TRUNC, 0600);
    if (fd < 0) return 1;
    av[0] = "readelf"; av[1] = "-S"; av[2] = "-W"; av[3] = (char *)path; av[4] = 0;
    sy_spawn_init(&o);
    o.argv = av; o.pgroup = -1; o.deadline_ms = 20000; o.out_fd = fd; o.err_fd = SY_STDIO_NULL;
    if (sy_proc_run(&o, &st) || st.timed_out || sy_exit_code(&st) != 0) { sy_close(fd); return 1; }
    sy_close(fd);
    if (sy_read_file(outp, &b, &n, 1L << 20) || !b) return 1;
    while (at < (long)n) {
        long e = at, p, hit = -1;
        while (e < (long)n && b[e] != '\n') e = e + 1;
        p = at;
        while (p + 5 < e) {
            if (b[p] == '.' && b[p+1] == 't' && b[p+2] == 'e' && b[p+3] == 'x' && b[p+4] == 't' &&
                (p == at || b[p-1] == ' ') && (p + 5 == e || b[p+5] == ' ')) { hit = p + 5; break; }
            p = p + 1;
        }
        if (hit >= 0) {
            unsigned long long hexv[4];
            int nh = 0;
            p = hit;
            while (p < e && nh < 4) {
                while (p < e && b[p] == ' ') p = p + 1;
                if (p < e && ((b[p] >= '0' && b[p] <= '9') || (b[p] >= 'a' && b[p] <= 'f'))) {
                    char tok[32];
                    long q = p;
                    while (q < e && q - p < 31 && b[q] != ' ') q = q + 1;
                    if (tx_copy(tok, 32, (char *)b + p, q - p)) { mm_free(b); return 1; }
                    if (!sc_hex(tok, &hexv[nh])) nh = nh + 1;
                    p = q;
                } else {
                    while (p < e && b[p] != ' ') p = p + 1;
                }
            }
            if (nh >= 3) { *end = hexv[0] + hexv[2]; mm_free(b); return 0; }
        }
        at = e + 1;
    }
    mm_free(b);
    return 1;
}

static int sc_object(const char *path, const char *dump, long *bn) {
    unsigned char *b = 0;
    int64_t n = 0;
    unsigned long long end = 0;
    if (sc_nm(path, dump)) { fprintf(stderr, "stdio-copies: nm failed %s\n", path); return 2; }
    if (sc_text_end(path, dump, &end)) { fprintf(stderr, "stdio-copies: text end %s\n", path); return 2; }
    if (sc_nm(path, dump)) { fprintf(stderr, "stdio-copies: nm failed %s\n", path); return 2; }
    if (sy_read_file(dump, &b, &n, 8L << 20) || !b) { fprintf(stderr, "stdio-copies: nm read %s\n", path); return 2; }
    *bn = sc_parse((char *)b, (long)n, end);
    mm_free(b);
    if (*bn < 0) { fprintf(stderr, "stdio-copies: parse %s\n", path); return 2; }
    return 0;
}

static int sc_allowed(const char *unit, char **allow, int nallow) {
    int i;
    if (nallow < 0) return 1;
    for (i = 0; i < nallow; i = i + 1) if (tx_eq(unit, allow[i], 64)) return 1;
    return 0;
}

static int sc_load_allow(const char *path, char **allow, int *nallow) {
    unsigned char *b = 0;
    int64_t n = 0;
    long at = 0;
    *nallow = 0;
    if (sy_read_file(path, &b, &n, 1L << 20) || !b) return 1;
    while (at < (long)n && *nallow < 256) {
        long e = at;
        char *row;
        while (e < (long)n && b[e] != '\n') e = e + 1;
        if (e > at && b[at] != '#') {
            row = (char *)mm_alloc(e - at + 1);
            if (!row) { mm_free(b); return 1; }
            if (tx_copy(row, e - at + 1, (char *)b + at, e - at)) { mm_free(row); mm_free(b); return 1; }
            allow[*nallow] = row;
            *nallow = *nallow + 1;
        }
        at = e + 1;
    }
    mm_free(b);
    return 0;
}

static int sc_scan(const char *chain, char **allow, int nallow, const char *only) {
    char g2[1024], tp[1100], op[1200], dump[256];
    sy_dir_t td, od;
    int tr, orc;
    long pid = (long)sy_pid();
    if (cx_fmt(g2, sizeof g2, "%s/fixedpoint/g2", chain)) return 2;
    if (cx_fmt(dump, sizeof dump, "/tmp/stdio-copies-%ld.nm", pid)) return 2;
    if (sy_dir_open(&td, g2)) { fprintf(stderr, "stdio-copies: no %s\n", g2); return 2; }
    while ((tr = sy_dir_next(&td)) == 1) {
        if (td.kind != 'd') continue;
        if (cx_fmt(tp, sizeof tp, "%s/%s", g2, td.name)) return 2;
        int nobj = 0;
        if (only && !tx_eq(td.name, only, 32)) continue;
        if (sy_dir_open(&od, tp)) { fprintf(stderr, "stdio-copies: no %s\n", tp); return 2; }
        while ((orc = sy_dir_next(&od)) == 1) {
            long bn;
            int k, orc2;
            if (od.kind != 'f') continue;
            k = (int)od.name_n;
            if (k < 3 || od.name[k - 2] != '.' || od.name[k - 1] != 'o') continue;
            nobj = nobj + 1;
            if (cx_fmt(op, sizeof op, "%s/%s", tp, od.name)) return 2;
            orc2 = sc_object(op, dump, &bn);
            if (orc2) return orc2;
            if (sc_add(td.name, od.name, bn, 0)) return 2;
            if (bn > 0 && !sc_allowed(od.name, allow, nallow)) {
                fprintf(stderr, "STDIO_COPIES FAIL unit=%s target=%s bytes=%ld\n", od.name, td.name, bn);
                sc_fail = 1;
            }
        }
        if (orc < 0) { sy_dir_close(&od); return 2; }
        sy_dir_close(&od);
        if (nobj == 0) continue;
        if (sc_scanned_n >= 16) return 2;
        if (tx_copy(sc_scanned[sc_scanned_n], 32, td.name, (long)tx_len(td.name, 31))) return 2;
        sc_scanned_n = sc_scanned_n + 1;
    }
    sy_dir_close(&td);
    sy_unlink(dump);
    if (sc_scanned_n == 0) { fprintf(stderr, "stdio-copies: no target has objects\n"); return 2; }
    return tr < 0 ? 2 : 0;
}

static void sc_report(void) {
    int i;
    for (i = 0; i < sc_n; i = i + 1)
        printf("UNIT %s %s %ld\n", sc_tgt[i], sc_name[i], sc_bytes[i]);
    for (i = 0; i < sc_scanned_n; i = i + 1) {
        long b = 0;
        int n = 0, k;
        for (k = 0; k < sc_n; k = k + 1) if (tx_eq(sc_scanned[i], sc_tgt[k], 32)) { b = b + sc_bytes[k]; n = n + 1; }
        printf("SUMMARY %s units=%d bytes=%ld\n", sc_scanned[i], n, b);
    }
    if (sc_run_id) printf("STDIO_COPIES targets=%d run-id=%s\n", sc_scanned_n, sc_run_id);
    else printf("STDIO_COPIES targets=%d\n", sc_scanned_n);
}

static int sc_self(void) {
    const char *nm =
        "00000020 T _u_vfmt\n"
        "00000028 t __unisacc_Lmid.1\n"
        "00000030 t other\n"
        "00000040 T fprintf\n"
        "00000040 T __unisacc_Rfprintf\n"
        "00000050 t _u_ffmt\n"
        "00000060 T fputs\n";
    long b = sc_parse(nm, (long)tx_len(nm, 400), 0x70);
    if (b != 64) { fprintf(stderr, "stdio-copies: fixture %ld\n", b); return 1; }
    if (sc_parse(nm, (long)tx_len(nm, 400), 0x60) != -1) { fprintf(stderr, "stdio-copies: last\n"); return 1; }
    if (sc_add("lnx-x86_64", "extra.o", 16, 0)) return 1;
    if (sc_allowed("extra.o", 0, 0)) { fprintf(stderr, "stdio-copies: allow\n"); return 1; }
    printf("PASS\tstdio-copies.delta\n");
    printf("PASS\tstdio-copies.alias\n");
    printf("PASS\tstdio-copies.last\n");
    printf("PASS\tstdio-copies.allow\n");
    printf("STDIO_COPIES\tfixture\n");
    return 0;
}
static int sc_scan_dir(const char *dir, char **allow, int nallow) {
    char op[1200], dump[256];
    sy_dir_t od;
    int orc, nobj = 0;
    long pid = (long)sy_pid();
    if (cx_fmt(dump, sizeof dump, "/tmp/stdio-copies-%ld.nm", pid)) return 2;
    if (sy_dir_open(&od, dir)) { fprintf(stderr, "stdio-copies: no %s\n", dir); return 2; }
    while ((orc = sy_dir_next(&od)) == 1) {
        long bn;
        int k, orc2;
        if (od.kind != 'f') continue;
        k = (int)od.name_n;
        if (k < 3 || od.name[k - 2] != '.' || od.name[k - 1] != 'o') continue;
        nobj = nobj + 1;
        if (cx_fmt(op, sizeof op, "%s/%s", dir, od.name)) return 2;
        orc2 = sc_object(op, dump, &bn);
        if (orc2) return orc2;
        if (sc_add("obj-dir", od.name, bn, 1)) return 2;
        if (bn > 0 && !sc_allowed(od.name, allow, nallow)) {
            fprintf(stderr, "STDIO_COPIES FAIL unit=%s target=obj-dir bytes=%ld\n", od.name, bn);
            sc_fail = 1;
        }
    }
    sy_dir_close(&od);
    sy_unlink(dump);
    if (orc < 0) return 2;
    if (nobj == 0) { fprintf(stderr, "stdio-copies: zero objects %s\n", dir); return 2; }
    if (tx_copy(sc_scanned[0], 32, "obj-dir", 7)) return 2;
    sc_scanned_n = 1;
    return 0;
}


int main(int argc, char **argv) {
    const char *chain = 0;
    const char *only = 0;
    const char *objdir = 0;
    const char *allow_path = 0;
    const char *opt_out = 0;
    char *allow[256];
    int nallow = -1;
    int i, rc;
    for (i = 1; i < argc; i = i + 1) {
        if (tx_eq(argv[i], "--judge-receipt", 20) && i + 2 < argc) {
            if (sy_exists(argv[i + 2]) != 1) { printf("FAIL\treceipt-missing\n"); return 1; }
            if (rc_fresh(argv[i + 2], argv[i + 1]) == 0 && rc_need(argv[i + 2], "rc", "int") == 0) {
                printf("PASS\treceipt-result\n");
                return 0;
            }
            printf("FAIL\treceipt-stale\n");
            return 1;
        }
        if ((tx_eq(argv[i], "--allow", 16) || tx_eq(argv[i], "--obj-dir", 16) || tx_eq(argv[i], "--target", 16) || tx_eq(argv[i], "--run-id", 16) || tx_eq(argv[i], "--out", 16) || tx_eq(argv[i], "--judge-receipt", 20)) && i + 1 >= argc) {
            fprintf(stderr, "stdio-copies: missing value %s\n", argv[i]);
            return 2;
        }
        if (tx_eq(argv[i], "--allow", 16)) { allow_path = argv[i + 1]; i = i + 1; continue; }
        if (tx_eq(argv[i], "--obj-dir", 16)) { objdir = argv[i + 1]; i = i + 1; continue; }
        if (tx_eq(argv[i], "--target", 16)) { only = argv[i + 1]; i = i + 1; continue; }
        if (tx_eq(argv[i], "--run-id", 16)) { sc_run_id = argv[i + 1]; i = i + 1; continue; }
        if (tx_eq(argv[i], "--out", 16)) { opt_out = argv[i + 1]; i = i + 1; continue; }
        if (argv[i][0] != '-') chain = argv[i];
    }
    if (!chain && !objdir) return sc_self();
    if (allow_path) {
        nallow = 0;
        if (sc_load_allow(allow_path, allow, &nallow)) { fprintf(stderr, "stdio-copies: allow file\n"); return 2; }
    }
    if (objdir) rc = sc_scan_dir(objdir, allow, nallow);
    else rc = sc_scan(chain, allow, nallow, only);
    if (rc) return rc;
    sc_report();
    if (sc_run_id && opt_out) {
        char c64[65];
        int k;
        for (k = 0; k < 64; k = k + 1) c64[k] = 'a';
        c64[64] = 0;
        if (rc_write2(opt_out, sc_run_id, c64, c64, c64, c64, sc_fail ? 1 : 0)) return 2;
    }
    return sc_fail ? 1 : 0;
}
