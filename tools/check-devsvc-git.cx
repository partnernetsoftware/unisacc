/* tools/check-devsvc-git.cx -- 检查 devsvc 的 git 子命令(commit/status)与危险命令具名拒绝。
 *
 *   sh ./unisacc.com tools/check-devsvc-git.cx        (在仓根跑)
 *
 * 夹具:`git clone --local` 本仓到 /tmp/dvgit-<pid>,另建裸仓 /tmp/dvgit-<pid>-bare 作 origin,夹具内放入工作副本的 devsvc 三件并提交;
 *   不设 DV_PIN_DIR(与真仓同键共用 $HOME 固定版本缓存,冷构造约 55 s 仅首次);UNISACC_DEVSVC_DIR 指向 /tmp/dvgit-<pid>-* 临时目录,经固定版本启动器跑夹具 HEAD(冷构造一次后命中缓存)。每次命令 55 秒上限,结束清理夹具。
 * 断言:(a) commit --whole F --push 成功、裸仓收到提交、末行 GIT_COMMIT rc=0;(b) commit 失败后 lock list 无残留;
 *   (c) 两个并发 commit 都完成且无残留锁;(d) x -- git stash list、git -C . stash list、git push --force 均 rc 125 且 stderr 含 REFUSE;
 *   (e) git status 末行 GIT_STATUS 格式;(w) commit --cwd 夹具内版本工作树:落该工作树分支、推 refs/heads/该分支、main HEAD 不变,--cwd 不存在 rc 2。末行 CHECK_DEVSVC_GIT<TAB>failed=N;有 FAIL 则 rc 1。 */
#pragma unisa use cxlib.flowexec
#pragma unisa use sys.time
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sys.sha
#pragma unisa use sysx.process
#pragma unisa use mem.bytes
#pragma unisa use mem.heap

static int nfail, ovf; static long t_start;
#define F(dst, cap, ...) do { int f_ = snprintf(dst, cap, __VA_ARGS__); if (f_ < 0 || f_ >= (int)(cap)) ovf++; } while (0)
static char root[1024], fx[160], bare[160], pin[160], inst[160], out[1 << 15];
static char *envv[4];
static const char *fixture_cli;
static void ck(int c, const char *name) {
    printf("%s\tdevsvc-git.%s\tt_ms=%ld\n", c ? "PASS" : "FAIL", name, sy_now_ms() - t_start);
    if (!c) { printf("NOTE\tlast-output\t%.700s\n", out); nfail++; }
    fflush(stdout);
}
static int run(char **v, const char *cwd, char *const *env) {
    np_result r; char why[200]; int rc; long a, b;
    memset(out, 0, sizeof out);
    if (np_run(v, cwd, env, 55, &r, why, sizeof why)) return -1;
    a = (long)r.outn; b = (long)r.errn; rc = r.rc;
    if (a + b > (long)sizeof out - 1 || (a > 0 && mm_copy(out, sizeof out, r.out, a)) || (b > 0 && mm_copy(out + a, sizeof out - a, r.err, b))) rc = -1;
    np_free(&r);
    return rc;
}
static int has(const char *s) { return strstr(out, s) != 0; }
static int cli_args(char **v) {
    if (fixture_cli && *fixture_cli) { v[0] = (char *)fixture_cli; return 1; }
    v[0] = "sh"; v[1] = "./unisacc.com"; v[2] = "tools/devsvc.cx"; v[3] = "--";
    return 4;
}
/* 在夹具里跑 devsvc(--dev):参数以 0 结尾 */
static int dv(const char *a1, const char *a2, const char *a3, const char *a4, const char *a5, const char *a6, const char *a7, const char *a8) {
    char *v[24]; int n = cli_args(v); const char *xs[8]; int i;
    xs[0] = a1; xs[1] = a2; xs[2] = a3; xs[3] = a4; xs[4] = a5; xs[5] = a6; xs[6] = a7; xs[7] = a8;
    for (i = 0; i < 8 && xs[i]; i++) { v[n++] = (char *)xs[i]; if (i == 0 && !strcmp(xs[0], "x")) { v[n++] = "--par"; v[n++] = "1"; } }   /* x 必须显式 --par */
    v[n] = 0;
    return run(v, fx, envv);
}
static int sh(const char *cmd, const char *cwd) { char *v[] = {"sh", "-c", (char *)cmd, 0}; return run(v, cwd, 0); }
static int wfile(const char *rel, const char *txt) { char p[400]; F(p, sizeof p, "%s/%s", fx, rel); return ovf || sy_write_atomic(p, (char *)txt, strlen(txt), 0644); }
static void cleanup(void) {
    char c[700]; F(c, sizeof c, "rm -rf %s %s %s %s", fx, bare, pin, inst); if (!ovf) (void)sh(c, 0);
}

static void ensure_dvgit_exe(const char *rdir) {
    const char *cur = getenv("DVGIT_EXE");
    char cmd[2400], key[24];
    if (cur && cur[0] == '/' && sy_exists(cur) == 1) return;
    if (!getenv("DVGIT_CORE_FROM") &&
        sh("git diff --quiet HEAD -- tools/devsvc.cx tools/devsvc-core.cx tools/devsvc-repo.tsv tools/cxlib", root) == 0) {
        if (sh("sh ./unisacc.com tools/devsvc.cx -- prebuild-self", root) == 0 &&
            !strncmp(out, "PREPARED\tkey=", 13)) {
            int i;
            for (i = 0; i < 20 && ((out[13 + i] >= '0' && out[13 + i] <= '9') || (out[13 + i] >= 'a' && out[13 + i] <= 'f')); i++)
                key[i] = out[13 + i];
            key[i] = 0;
            if (i == 20) {
                F(cmd, sizeof cmd,
                  "if [ -n \"${DV_PIN_DIR:-}\" ] && [ -x \"$DV_PIN_DIR/%s/devsvc\" ]; then printf '%%s' \"$DV_PIN_DIR/%s/devsvc\"; "
                  "else for p in \"$HOME/.cache/unisacc/devsvc/pinned/repos\"/*/%s/devsvc; do [ -x \"$p\" ] && { printf '%%s' \"$p\"; break; }; done; fi",
                  key, key, key);
                if (!ovf && sh(cmd, root) == 0 && out[0] == '/' && sy_exists(out) == 1) {
                    (void)setenv("DVGIT_EXE", out, 1);
                    return;
                }
            }
        }
    }
    if (rdir && rdir[0]) {
        const char *csrc = getenv("DVGIT_CORE_FROM");
        char bin[1200];
        F(bin, sizeof bin, "%s/dvgit-work.bin", rdir);
        F(cmd, sizeof cmd, "sh '%s/unisacc.com' -o '%s' '%s%s%s'",
          root, bin, csrc ? "" : root, csrc ? "" : "/", csrc ? csrc : "tools/devsvc-core.cx");
        if (!ovf && sh(cmd, root) == 0 && sy_exists(bin) == 1)
            (void)setenv("DVGIT_EXE", bin, 1);
    }
}

static int run_flow_shards(const char *sel, long t0) {
    char rdir[512], ftsv[600], tsv[4096], why[512];
    fl_flow fl; fl_sum sum;
    int i, tlen = 0, r, total_fail = 0, nshards = 0;
    const char *shards[12];
    F(rdir, sizeof rdir, "%s/dvgit-flow-%d-%ld", sy_tmpdir(), (int)sy_pid(), sy_now_ms());
    F(ftsv, sizeof ftsv, "%s/flow.tsv", rdir);
    if (ovf || sy_mkdir_all(rdir, 0700) != 0) return 2;
    ensure_dvgit_exe(rdir);
    for (i = 0; sel[i] && nshards < 10; i++) {
        char g = sel[i];
        if (g == 'a') shards[nshards++] = "a";
        else if (g == 'b') shards[nshards++] = "b";
        else if (g == 'c') shards[nshards++] = "c";
        else if (g == 'd') shards[nshards++] = "d";
        else if (g == 'e') shards[nshards++] = "e";
        else if (g == 'f') { shards[nshards++] = "f1"; shards[nshards++] = "f2"; }
    }
    tlen = snprintf(tsv, sizeof tsv, "par %d\n", nshards > 0 && nshards <= 8 ? nshards : 6);
    for (i = 0; i < nshards; i++) {
        int w = snprintf(tsv + tlen, sizeof tsv - (size_t)tlen,
                         "g-%s\texec\t-\tcwd=%s;timeout_ms=55000;a0=sh;a1=./unisacc.com;a2=tools/check-devsvc-git.cx;a3=--;a4=--cases;a5=%s\n",
                         shards[i], root, shards[i]);
        if (w < 0 || (size_t)(tlen + w) >= sizeof tsv) { (void)sy_remove_all(rdir); return 2; }
        tlen += w;
    }
    if (sy_write_atomic(ftsv, tsv, (size_t)tlen, 0600) != 0 ||
        fl_load(ftsv, &fl, why, (int)sizeof why) != 0) {
        (void)sy_remove_all(rdir);
        return 2;
    }
    r = fl_run(&fl, rdir, nshards > 0 && nshards <= 8 ? nshards : 6, 55000, 0, &sum);
    for (i = 0; i < fl.count; i++) {
        char op[640]; unsigned char *b = 0; int64_t n = 0;
        int got_sum = 0, fail_i = 0;
        F(op, sizeof op, "%s/%s/%s.out", rdir, "out", fl.n[i].id);
        if (!sy_read_file(op, &b, &n, 1 << 20) && b) {
            long at = 0;
            while (at < n) {
                long e = at;
                while (e < n && b[e] != '\n') e++;
                long l = e - at;
                if (l >= 17 && !memcmp(b + at, "CHECK_DEVSVC_GIT\t", 17)) {
                    char ln[128];
                    long kl = l < 127 ? l : 127, k;
                    for (k = 0; k < kl; k++) ln[k] = (char)b[at + k];
                    ln[kl] = 0;
                    if (sscanf(ln, "CHECK_DEVSVC_GIT\tfailed=%d", &fail_i) == 1) {
                        got_sum = 1;
                        total_fail += fail_i;
                    }
                } else {
                    fwrite(b + at, 1, (size_t)(e < n ? l + 1 : l), stdout);
                }
                at = (e < n) ? e + 1 : n;
            }
            free(b);
        }
        if (!got_sum || (fl.n[i].state != FL_OK && fail_i == 0)) {
            printf("FAIL\tdevsvc-git.shard-%s\tstate=%d\trc=%d\n", fl.n[i].id, fl.n[i].state, fl.n[i].rc);
            total_fail++;
        }
    }
    printf("NOTE\tflow_shards\tnodes=%d\tok=%d\tfail=%d\twall_ms=%ld\n",
           fl.count, sum.ok, sum.fail + sum.timeout + sum.skip, sum.wall_ms);
    fl_free(&fl);
    (void)sy_remove_all(rdir);
    printf("NOTE\twall_ms\t%ld\n", sy_now_ms() - t0);
    printf("CHECK_DEVSVC_GIT\tfailed=%d\n", total_fail);
    return (total_fail || r != 0) ? 1 : 0;
}

int main(int argc, char **argv) {
    int A = 0, B = 0, C = 0, D = 0, E = 0, FF = 0, FF2 = 0;
    const char *sel = "abcdef";
    int single_f1 = 0, single_f2 = 0;
    if (argc >= 3 && !strcmp(argv[1], "--cases")) {
        if (!strcmp(argv[2], "all")) sel = "abcdef";
        else if (!strcmp(argv[2], "f1")) { sel = "f"; single_f1 = 1; }
        else if (!strcmp(argv[2], "f2")) { sel = "f"; single_f2 = 1; }
        else sel = argv[2];
    }
    else if (argc > 1) { fprintf(stderr, "usage: check-devsvc-git.cx [--cases a|b|c|d|e|f|f1|f2|ab|all]\n"); return 2; }
    {   const char *p;
        if (!sel[0]) { fprintf(stderr, "usage: check-devsvc-git.cx [--cases a|b|c|d|e|f|f1|f2|ab|all]\n"); return 2; }
        for (p = sel; *p; p++)
            if (*p < 'a' || *p > 'f') { fprintf(stderr, "usage: check-devsvc-git.cx [--cases a|b|c|d|e|f|f1|f2|ab|all]\n"); return 2; }
    }
    A = strchr(sel, 'a') != 0; B = strchr(sel, 'b') != 0; C = strchr(sel, 'c') != 0;
    D = strchr(sel, 'd') != 0; E = strchr(sel, 'e') != 0;
    FF = single_f1 || (!single_f2 && strchr(sel, 'f') != 0);
    FF2 = single_f2 || (!single_f1 && strchr(sel, 'f') != 0);
    char e1[220], e2[220]; char c[1400]; long t0 = sy_now_ms(); int rc, k; t_start = t0;
    if (sy_cwd(root, sizeof root) < 0) return 2;
    {   /* 剥掉调用方 shell 里的 DEVSVC_* 环境变量(如 DEVSVC_OWNER),夹具子进程不继承 */
        extern char **environ; char **e; char nm[80]; int i;
        for (e = environ; e && *e; ) {
            if (strncmp(*e, "DEVSVC_", 7) == 0) {
                for (i = 0; (*e)[i] && (*e)[i] != '=' && i < 78; i++) nm[i] = (*e)[i];
                nm[i] = 0; unsetenv(nm); e = environ;
            } else e++;
        } }
    if (strlen(sel) > 1 || (!single_f1 && !single_f2 && !strcmp(sel, "f"))) return run_flow_shards(sel, t0);
    ensure_dvgit_exe(0);
    {   /* 夹具路径按仓根哈希与组固定(不含 pid)并持 .lock 文件锁防并发互删,且共享真仓 $HOME 固定版本缓存目录 */
        unsigned long long hh = 1469598103934665603ULL; long q; const char *tag = single_f2 ? "f2" : A && B ? "ab" : A ? "a" : B ? "b" : C ? "c" : D ? "d" : E ? "e" : "f"; char c0[700], lkp[200], gdir[1100], gh[65]; const char *home = getenv("HOME"); int lfd, li;
        for (q = 0; root[q]; q++) { hh ^= (unsigned char)root[q]; hh *= 1099511628211ULL; }
        F(fx, sizeof fx, "/tmp/dvgit-%08llx-%s", hh & 0xffffffffULL, tag); F(bare, sizeof bare, "%s-bare", fx);
        F(pin, sizeof pin, "%s-pin", fx); F(inst, sizeof inst, "%s-inst", fx);
        F(lkp, sizeof lkp, "%s.lock", fx);
        lfd = sy_open(lkp, 2 | 64, 0600);
        if (lfd >= 0) {
            for (li = 0; li < 1100; li++) {
                if (sy_lockf(lfd, 1, 0) == 0) break;
                sy_sleep_ms(100);
            }
        }
        F(gdir, sizeof gdir, "%s/.git", root);
        if (home && home[0] && sy_sha256_hex(gdir, (long)strlen(gdir), gh) == 0) {
            char sp[1200];
            if (snprintf(sp, sizeof sp, "%s/.cache/unisacc/devsvc/pinned/repos/%s", home, gh) < (int)sizeof sp)
                (void)setenv("DV_PIN_DIR", sp, 1);
        }
        F(c0, sizeof c0, "rm -rf %s %s %s %s", fx, bare, pin, inst); if (!ovf) (void)sh(c0, 0); }
    F(e1, sizeof e1, "DV_PIN_DIR=%s", pin); F(e2, sizeof e2, "UNISACC_DEVSVC_DIR=%s", inst);
    envv[0] = e2; envv[1] = 0; (void)e1;
    fixture_cli = getenv("DVGIT_EXE");   /* 复核可在独立的有界步骤预编执行体。 */
    if (fixture_cli && (*fixture_cli != '/' || setenv("DEVSVC_SELF_BIN", fixture_cli, 1))) return 2;
    if (ovf) return 2;
    {   char *v[] = {"git", "clone", "-q", "--local", root, fx, 0}; if (run(v, 0, 0) != 0) { printf("FAIL\tdevsvc-git.fixture-clone\n"); cleanup(); return 1; } }
    /* 夹具起点与本仓所在分支无关:在版本分支(如 v0.0.72)或工作树里跑时克隆体 HEAD 不在 main,后续 checkout main 会从 origin/main 另建分支;
       这里把克隆体当前 HEAD 强制命名为 main 并跟踪 origin/main,与在 main 上跑时同形 */
    {   char *v[] = {"git", "-C", fx, "checkout", "-q", "-B", "main", 0}; char *u[] = {"git", "-C", fx, "branch", "-q", "--set-upstream-to=origin/main", "main", 0};
        if (run(v, 0, 0) != 0) { printf("FAIL\tdevsvc-git.fixture-main\n"); cleanup(); return 1; }
        (void)run(u, 0, 0); /* 本仓无 main 分支时无 origin/main 可跟踪,不算夹具失败 */ }
    {   const char *names[] = {"tools/devsvc.cx", "tools/devsvc-core.cx", "tools/devsvc-repo.tsv", "tools/commit-own.cx", "tools/cxlib/flowexec.cx", "tools/push-replay.cx", 0}; int i;
        for (i = 0; names[i]; i++) {
            char src[1200], dst[400]; unsigned char *b = 0; int64_t n = 0;
            F(src, sizeof src, "%s/%s", root, names[i]); F(dst, sizeof dst, "%s/%s", fx, names[i]);
            if (i == 1 && getenv("DVGIT_CORE_FROM")) F(src, sizeof src, "%s", getenv("DVGIT_CORE_FROM"));   /* 负控:换入旧核心,证明 e 组断言有效 */
            if (i == 5 && getenv("DVGIT_PUSH_FROM")) F(src, sizeof src, "%s", getenv("DVGIT_PUSH_FROM"));
            if (ovf || sy_read_file(src, &b, &n, 1 << 22) || !b || sy_write_atomic(dst, (char *)b, (size_t)n, 0644)) { printf("FAIL\tdevsvc-git.fixture-copy\t%s\n", names[i]); cleanup(); return 1; }
            free(b);
        }
        {   /* flowexec 工作副本若已 use 新模块(如 cxlib.flowadmit)而它尚未入 HEAD,一并带进夹具,否则固定版本构造失败回落旧执行体 */
            char src[1200], dst[400]; unsigned char *b = 0; int64_t n = 0;
            F(src, sizeof src, "%s/tools/cxlib/flowadmit.cx", root); F(dst, sizeof dst, "%s/tools/cxlib/flowadmit.cx", fx);
            if (!ovf && sy_exists(src) == 1 && !sy_read_file(src, &b, &n, 1 << 22) && b) { (void)sy_write_atomic(dst, (char *)b, (size_t)n, 0644); free(b); }
            b = 0; F(src, sizeof src, "%s/tools/gitsync-run.cx", root); F(dst, sizeof dst, "%s/tools/gitsync-run.cx", fx);   /* git merge/pull 的同步子进程 */
            if (!ovf && sy_exists(src) == 1 && !sy_read_file(src, &b, &n, 1 << 22) && b) { (void)sy_write_atomic(dst, (char *)b, (size_t)n, 0644); free(b); } } }
    F(c, sizeof c, "git clone -q --bare --local %s %s && git config user.name dvcheck && git config user.email dvcheck@example.invalid && git remote set-url origin %s"
                   " && git add tools/devsvc.cx tools/devsvc-core.cx tools/devsvc-repo.tsv tools/commit-own.cx tools/cxlib/flowexec.cx tools/push-replay.cx && { ! test -e tools/cxlib/flowadmit.cx || git add tools/cxlib/flowadmit.cx; } && { ! test -e tools/gitsync-run.cx || git add tools/gitsync-run.cx; } && { git commit -q -m fixture || git diff --cached --quiet; } && git push -q origin HEAD:main && ln -s %s/unisacc.com unisacc.com", root, bare, bare, root);
    if (ovf || sh(c, fx) != 0) { printf("FAIL\tdevsvc-git.fixture-setup\n"); printf("NOTE\tlast-output\t%.500s\n", out); cleanup(); return 1; }

    if (A) {
    /* (a) commit --whole --push */
    if (wfile("dvg-a.txt", "a\n")) { printf("FAIL\tdevsvc-git.fixture-write\n"); cleanup(); return 1; }
    rc = dv("git", "commit", "-m", "X", "--whole", "dvg-a.txt", "--push", 0);
    ck(rc == 0 && has("GIT_COMMIT\trc=0"), "commit-push-rc0");
    F(c, sizeof c, "[ \"$(git -C %s rev-parse main)\" = \"$(git rev-parse HEAD)\" ] && git -C %s log -1 --format=%%s main | grep -qx X", bare, bare);
    ck(sh(c, fx) == 0, "bare-origin-received-commit");

    /* (a2) 已 git rm 的删除可提交:HEAD 有、工作区无的 --whole 路径 */
    F(c, sizeof c, "git rm -q dvg-a.txt");
    ck(!ovf && sh(c, fx) == 0, "fixture-git-rm");
    rc = dv("git", "commit", "-m", "D", "--whole", "dvg-a.txt", 0, 0);
    ck(rc == 0 && has("GIT_COMMIT\trc=0") && has("DELETE\tdvg-a.txt"), "commit-deletion-rc0");
    F(c, sizeof c, "[ -z \"$(git ls-tree HEAD -- dvg-a.txt)\" ] && [ -z \"$(git ls-files -s -- dvg-a.txt)\" ] && git log -1 --format=%%s | grep -qx D");
    ck(!ovf && sh(c, fx) == 0, "commit-deletion-gone-from-head-and-index");

    /* (b) 失败的 commit 后无残留锁(登记路径会取 registry 锁) */
    rc = dv("git", "commit", "-m", "Y", "--whole", "tests/manifests/dvg-nonexistent.tsv", 0, 0);
    ck(rc != 0 && has("GIT_COMMIT\trc="), "failed-commit-reports-nonzero");
    ck(rc != 0 && has("GIT_COMMIT_ERR\t"), "failed-commit-prints-err-tail");
    /* 未产生新提交时回执不再把旧 HEAD 写进 commit=:commit=none 加 reason=(timeout|refused|blocked) */
    ck(rc != 0 && has("\tcommit=none\t") && (has("\treason=blocked") || has("\treason=refused") || has("\treason=timeout")), "failed-commit-says-none-with-reason");
    rc = dv("lock", "list", 0, 0, 0, 0, 0, 0);
    ck(rc == 0 && !has("registry") && !has("auto-"), "failed-commit-leaves-no-lock");

    /* (w) commit --cwd 版本工作树:夹具内 git worktree add .claude/worktrees/dvg-wt(分支 dvg-wt),提交落该分支、
       推 origin refs/heads/dvg-wt,夹具 main 的 HEAD 不变;--cwd 指向不存在目录 rc 2 不提交;验后 worktree remove */
    {   char mh[64] = "", wh[64] = "";
        F(c, sizeof c, "git rev-parse HEAD && git worktree add -q -b dvg-wt .claude/worktrees/dvg-wt HEAD && ln -s %s/unisacc.com .claude/worktrees/dvg-wt/unisacc.com && printf 'w\\n' > .claude/worktrees/dvg-wt/dvg-w.txt", root);
        ck(!ovf && sh(c, fx) == 0, "wt-fixture-add");
        if (sscanf(out, "%63s", mh) != 1) mh[0] = 0;
        rc = dv("git", "commit", "-m", "W", "--cwd", ".claude/worktrees/dvg-wt", "--whole", "dvg-w.txt");
        ck(rc == 0 && has("GIT_COMMIT\trc=0") && has("\tbranch=dvg-wt\t"), "wt-commit-rc0-branch");
        F(c, sizeof c, "git rev-parse HEAD && git log -1 --format=%%s dvg-wt | grep -qx W && git cat-file -e dvg-wt:dvg-w.txt && ! git cat-file -e HEAD:dvg-w.txt 2>/dev/null"
                       " && [ \"$(git -C .claude/worktrees/dvg-wt rev-parse HEAD)\" = \"$(git rev-parse dvg-wt)\" ] && [ -z \"$(git -C .claude/worktrees/dvg-wt status --porcelain -- dvg-w.txt)\" ]");
        ck(!ovf && sh(c, fx) == 0, "wt-commit-on-branch-index-synced");
        if (sscanf(out, "%63s", wh) != 1) wh[0] = 0;
        ck(mh[0] && !strcmp(mh, wh), "wt-commit-main-head-unchanged");
        F(c, sizeof c, "printf 'w2\\n' > .claude/worktrees/dvg-wt/dvg-w.txt");
