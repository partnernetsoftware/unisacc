/* tools/check-devsvc-git.cx -- 检查 devsvc 的 git 子命令(commit/status)与危险命令具名拒绝。
 *
 *   sh ./unisacc.com tools/check-devsvc-git.cx        (在仓根跑)
 *
 * 夹具:`git clone --local` 本仓到 /tmp/dvgit-<pid>,另建裸仓 /tmp/dvgit-<pid>-bare 作 origin,夹具内放入工作副本的 devsvc 三件并提交;
 *   不设 DV_PIN_DIR(与真仓同键共用 $HOME 固定版本缓存,冷构造约 55 s 仅首次);UNISACC_DEVSVC_DIR 指向 /tmp/dvgit-<pid>-* 临时目录,经固定版本启动器跑夹具 HEAD(冷构造一次后命中缓存)。每次命令 55 秒上限,结束清理夹具。
 * 断言:(a) commit --whole F --push 成功、裸仓收到提交、末行 GIT_COMMIT rc=0;(b) commit 失败后 lock list 无残留;
 *   (c) 两个并发 commit 都完成且无残留锁;(d) x -- git stash list、git -C . stash list、git push --force 均 rc 125 且 stderr 含 REFUSE;
 *   (e) git status 末行 GIT_STATUS 格式;(w) commit --cwd 夹具内版本工作树:落该工作树分支、推 refs/heads/该分支、main HEAD 不变,--cwd 不存在 rc 2。末行 CHECK_DEVSVC_GIT<TAB>failed=N;有 FAIL 则 rc 1。 */
#pragma unisa use sys.time
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sysx.process
#pragma unisa use mem.bytes
#pragma unisa use mem.heap

static int nfail, ovf; static long t_start;
#define F(dst, cap, ...) do { int f_ = snprintf(dst, cap, __VA_ARGS__); if (f_ < 0 || f_ >= (int)(cap)) ovf++; } while (0)
static char root[1024], fx[160], bare[160], pin[160], inst[160], out[1 << 15];
static char *envv[4];
static void ck(int c, const char *name) {
    printf("%s\tdevsvc-git.%s\tt_ms=%ld\n", c ? "PASS" : "FAIL", name, sy_now_ms() - t_start);
    if (!c) { printf("NOTE\tlast-output\t%.700s\n", out); nfail++; }
}
static int run(char **v, const char *cwd, char *const *env) {
    np_result r; char why[200]; int rc; long a, b;
    memset(out, 0, sizeof out);
    if (np_run(v, cwd, env, 55, &r, why, sizeof why)) return -1;
    a = (long)r.outn; b = (long)r.errn; rc = r.rc;
    if (a + b > (long)sizeof out - 1 || (a > 0 && mm_copy(out, sizeof out, r.out, a)) || (b > 0 && mm_copy(out + a, sizeof out - a, r.err, b))) rc = -1;
    np_free(&r);
    return rc;
}
static int has(const char *s) { return strstr(out, s) != 0; }
/* 在夹具里跑 devsvc(--dev):参数以 0 结尾 */
static int dv(const char *a1, const char *a2, const char *a3, const char *a4, const char *a5, const char *a6, const char *a7, const char *a8) {
    char *v[24]; int n = 0; const char *xs[8]; int i;
    v[n++] = "sh"; v[n++] = "./unisacc.com"; v[n++] = "tools/devsvc.cx"; v[n++] = "--";
    xs[0] = a1; xs[1] = a2; xs[2] = a3; xs[3] = a4; xs[4] = a5; xs[5] = a6; xs[6] = a7; xs[7] = a8;
    for (i = 0; i < 8 && xs[i]; i++) { v[n++] = (char *)xs[i]; if (i == 0 && !strcmp(xs[0], "x")) { v[n++] = "--par"; v[n++] = "1"; } }   /* x 必须显式 --par */
    v[n] = 0;
    return run(v, fx, envv);
}
static int sh(const char *cmd, const char *cwd) { char *v[] = {"sh", "-c", (char *)cmd, 0}; return run(v, cwd, 0); }
static int wfile(const char *rel, const char *txt) { char p[400]; F(p, sizeof p, "%s/%s", fx, rel); return ovf || sy_write_atomic(p, (char *)txt, strlen(txt), 0644); }
static void cleanup(void) {
    char c[700]; F(c, sizeof c, "rm -rf %s %s %s %s", fx, bare, pin, inst); if (!ovf) (void)sh(c, 0);
}

int main(int argc, char **argv) {
    int A = 1, B = 1, C = 0, D = 0;   /* --cases a:commit/push、删除、失败无残留锁;b:并发 commit、危险命令拒绝、status 格式;
                                 c:commit 回执取回、x --bg 作业 deadline 自退与进程组清理、git merge 无冲突与冲突报告、git add 拒绝路径;缺省跑 a 与 b,各组独立夹具 */
    if (argc >= 3 && !strcmp(argv[1], "--cases")) { A = strchr(argv[2], 'a') != 0; B = strchr(argv[2], 'b') != 0; C = strchr(argv[2], 'c') != 0; D = strchr(argv[2], 'd') != 0; }
    else if (argc > 1) { fprintf(stderr, "usage: check-devsvc-git.cx [--cases a|b|c|d|ab]\n"); return 2; }
    char e1[220], e2[220]; char c[1400]; long t0 = sy_now_ms(); int rc, k; t_start = t0;
    if (sy_cwd(root, sizeof root) < 0) return 2;
    {   /* 剥掉调用方 shell 里的 DEVSVC_* 环境变量(如 DEVSVC_OWNER),夹具子进程不继承 */
        extern char **environ; char **e; char nm[80]; int i;
        for (e = environ; e && *e; ) {
            if (strncmp(*e, "DEVSVC_", 7) == 0) {
                for (i = 0; (*e)[i] && (*e)[i] != '=' && i < 78; i++) nm[i] = (*e)[i];
                nm[i] = 0; unsetenv(nm); e = environ;
            } else e++;
        } }
    {   /* 夹具路径按仓根哈希与组固定(不含 pid):使启动器自身按源路径取键的产品 -run 编译缓存跨次命中;开头与收尾都清空 */
        unsigned long long hh = 1469598103934665603ULL; long q; const char *tag = A && B ? "ab" : A ? "a" : B ? "b" : C ? "c" : "d"; char c0[700];
        for (q = 0; root[q]; q++) { hh ^= (unsigned char)root[q]; hh *= 1099511628211ULL; }
        F(fx, sizeof fx, "/tmp/dvgit-%08llx-%s", hh & 0xffffffffULL, tag); F(bare, sizeof bare, "%s-bare", fx);
        F(pin, sizeof pin, "%s-pin", fx); F(inst, sizeof inst, "%s-inst", fx);
        F(c0, sizeof c0, "rm -rf %s %s %s %s", fx, bare, pin, inst); if (!ovf) (void)sh(c0, 0); }
    F(e1, sizeof e1, "DV_PIN_DIR=%s", pin); F(e2, sizeof e2, "UNISACC_DEVSVC_DIR=%s", inst);
    envv[0] = e2; envv[1] = 0; (void)e1;
    if (ovf) return 2;
    {   char *v[] = {"git", "clone", "-q", "--local", root, fx, 0}; if (run(v, 0, 0) != 0) { printf("FAIL\tdevsvc-git.fixture-clone\n"); cleanup(); return 1; } }
    {   const char *names[5] = {"tools/devsvc.cx", "tools/devsvc-core.cx", "tools/devsvc-repo.tsv", "tools/commit-own.cx", "tools/cxlib/flowexec.cx"}; int i;
        for (i = 0; i < 5; i++) {
            char src[1200], dst[400]; unsigned char *b = 0; int64_t n = 0;
            F(src, sizeof src, "%s/%s", root, names[i]); F(dst, sizeof dst, "%s/%s", fx, names[i]);
            if (ovf || sy_read_file(src, &b, &n, 1 << 22) || !b || sy_write_atomic(dst, (char *)b, (size_t)n, 0644)) { printf("FAIL\tdevsvc-git.fixture-copy\t%s\n", names[i]); cleanup(); return 1; }
            free(b);
        }
        {   /* flowexec 工作副本若已 use 新模块(如 cxlib.flowadmit)而它尚未入 HEAD,一并带进夹具,否则固定版本构造失败回落旧执行体 */
            char src[1200], dst[400]; unsigned char *b = 0; int64_t n = 0;
            F(src, sizeof src, "%s/tools/cxlib/flowadmit.cx", root); F(dst, sizeof dst, "%s/tools/cxlib/flowadmit.cx", fx);
            if (!ovf && sy_exists(src) == 1 && !sy_read_file(src, &b, &n, 1 << 22) && b) { (void)sy_write_atomic(dst, (char *)b, (size_t)n, 0644); free(b); } } }
    F(c, sizeof c, "git init -q --bare %s && git config user.name dvcheck && git config user.email dvcheck@example.invalid && git remote set-url origin %s"
                   " && git add tools/devsvc.cx tools/devsvc-core.cx tools/devsvc-repo.tsv tools/commit-own.cx tools/cxlib/flowexec.cx && { ! test -e tools/cxlib/flowadmit.cx || git add tools/cxlib/flowadmit.cx; } && { git commit -q -m fixture || git diff --cached --quiet; } && git push -q origin HEAD:main && ln -s %s/unisacc.com unisacc.com", bare, bare, root);
    if (ovf || sh(c, fx) != 0) { printf("FAIL\tdevsvc-git.fixture-setup\n"); printf("NOTE\tlast-output\t%.500s\n", out); cleanup(); return 1; }

    if (A) {
    /* (a) commit --whole --push */
    if (wfile("dvg-a.txt", "a\n")) { printf("FAIL\tdevsvc-git.fixture-write\n"); cleanup(); return 1; }
    rc = dv("git", "commit", "-m", "X", "--whole", "dvg-a.txt", "--push", 0);
    ck(rc == 0 && has("GIT_COMMIT\trc=0"), "commit-push-rc0");
    F(c, sizeof c, "[ \"$(git -C %s rev-parse main)\" = \"$(git rev-parse HEAD)\" ] && git -C %s log -1 --format=%%s main | grep -qx X", bare, bare);
    ck(sh(c, fx) == 0, "bare-origin-received-commit");

    /* (a2) 已 git rm 的删除可提交:HEAD 有、工作区无的 --whole 路径 */
    F(c, sizeof c, "git rm -q dvg-a.txt");
    ck(!ovf && sh(c, fx) == 0, "fixture-git-rm");
    rc = dv("git", "commit", "-m", "D", "--whole", "dvg-a.txt", 0, 0);
    ck(rc == 0 && has("GIT_COMMIT\trc=0") && has("DELETE\tdvg-a.txt"), "commit-deletion-rc0");
    F(c, sizeof c, "[ -z \"$(git ls-tree HEAD -- dvg-a.txt)\" ] && [ -z \"$(git ls-files -s -- dvg-a.txt)\" ] && git log -1 --format=%%s | grep -qx D");
    ck(!ovf && sh(c, fx) == 0, "commit-deletion-gone-from-head-and-index");

    /* (b) 失败的 commit 后无残留锁(登记路径会取 registry 锁) */
    rc = dv("git", "commit", "-m", "Y", "--whole", "tests/manifests/dvg-nonexistent.tsv", 0, 0);
    ck(rc != 0 && has("GIT_COMMIT\trc="), "failed-commit-reports-nonzero");
    ck(rc != 0 && has("GIT_COMMIT_ERR\t"), "failed-commit-prints-err-tail");
    rc = dv("lock", "list", 0, 0, 0, 0, 0, 0);
    ck(rc == 0 && !has("registry") && !has("auto-"), "failed-commit-leaves-no-lock");

    /* (w) commit --cwd 版本工作树:夹具内 git worktree add .claude/worktrees/dvg-wt(分支 dvg-wt),提交落该分支、
       推 origin refs/heads/dvg-wt,夹具 main 的 HEAD 不变;--cwd 指向不存在目录 rc 2 不提交;验后 worktree remove */
    {   char mh[64] = "", wh[64] = "";
        F(c, sizeof c, "git rev-parse HEAD && git worktree add -q -b dvg-wt .claude/worktrees/dvg-wt HEAD && ln -s %s/unisacc.com .claude/worktrees/dvg-wt/unisacc.com && printf 'w\\n' > .claude/worktrees/dvg-wt/dvg-w.txt", root);
        ck(!ovf && sh(c, fx) == 0, "wt-fixture-add");
        if (sscanf(out, "%63s", mh) != 1) mh[0] = 0;
        rc = dv("git", "commit", "-m", "W", "--cwd", ".claude/worktrees/dvg-wt", "--whole", "dvg-w.txt");
        ck(rc == 0 && has("GIT_COMMIT\trc=0") && has("\tbranch=dvg-wt\t"), "wt-commit-rc0-branch");
        F(c, sizeof c, "git rev-parse HEAD && git log -1 --format=%%s dvg-wt | grep -qx W && git cat-file -e dvg-wt:dvg-w.txt && ! git cat-file -e HEAD:dvg-w.txt 2>/dev/null"
                       " && [ \"$(git -C .claude/worktrees/dvg-wt rev-parse HEAD)\" = \"$(git rev-parse dvg-wt)\" ] && [ -z \"$(git -C .claude/worktrees/dvg-wt status --porcelain -- dvg-w.txt)\" ]");
        ck(!ovf && sh(c, fx) == 0, "wt-commit-on-branch-index-synced");
        if (sscanf(out, "%63s", wh) != 1) wh[0] = 0;
        ck(mh[0] && !strcmp(mh, wh), "wt-commit-main-head-unchanged");
        F(c, sizeof c, "printf 'w2\\n' > .claude/worktrees/dvg-wt/dvg-w.txt");
        (void)sh(c, fx);
        {   char *v[] = {"sh", "./unisacc.com", "tools/devsvc.cx", "--", "git", "commit", "-m", "W2", "--cwd", ".claude/worktrees/dvg-wt", "--push", "--whole", "dvg-w.txt", 0};
            rc = run(v, fx, envv); }
        ck(rc == 0 && has("pushed=1"), "wt-commit-push-rc0");
        F(c, sizeof c, "git -C %s log -1 --format=%%s refs/heads/dvg-wt | grep -qx W2 && git -C %s log -1 --format=%%s main | grep -qx X", bare, bare);
        ck(!ovf && sh(c, fx) == 0, "wt-commit-push-to-branch-not-main");
        rc = dv("git", "commit", "-m", "N", "--cwd", ".claude/worktrees/dvg-nope", "--whole", "dvg-w.txt");
        ck(rc == 2 && has("REFUSE git commit --cwd"), "wt-commit-missing-cwd-rc2");
        F(c, sizeof c, "git worktree remove --force .claude/worktrees/dvg-wt");
        ck(!ovf && sh(c, fx) == 0, "wt-fixture-remove");
    }

    }
    if (B) {
    /* (c) 两个并发 commit 串行完成,无残留锁 */
    if (wfile("tests/manifests/dvg-c1.tsv", "c1\n") || wfile("tests/manifests/dvg-c2.tsv", "c2\n")) { printf("FAIL\tdevsvc-git.fixture-write-c\n"); cleanup(); return 1; }
    F(c, sizeof c, "sh ./unisacc.com tools/devsvc.cx -- git commit -m C1 --whole tests/manifests/dvg-c1.tsv >/tmp/dvgit-%d-c1 2>&1 & "
                   "sh ./unisacc.com tools/devsvc.cx -- git commit -m C2 --whole tests/manifests/dvg-c2.tsv >/tmp/dvgit-%d-c2 2>&1 & wait; cat /tmp/dvgit-%d-c1 /tmp/dvgit-%d-c2; rm -f /tmp/dvgit-%d-c1 /tmp/dvgit-%d-c2",
      sy_pid(), sy_pid(), sy_pid(), sy_pid(), sy_pid(), sy_pid());
    (void)ovf; rc = -1;
    {   char *v[] = {"sh", "-c", c, 0}; rc = run(v, fx, envv); }
    { int n1 = 0; char *p = out; while ((p = strstr(p, "GIT_COMMIT\trc=0"))) { n1++; p++; } k = n1; }
    ck(rc == 0 && k == 2, "concurrent-commits-both-rc0");
    rc = dv("lock", "list", 0, 0, 0, 0, 0, 0);
    ck(rc == 0 && !has("registry") && !has("auto-"), "concurrent-commits-leave-no-lock");

    /* (d) 危险命令具名拒绝 */
    rc = dv("x", "--", "git", "stash", "list", 0, 0, 0);
    ck(rc == 125 && has("REFUSE"), "refuse-git-stash");
    rc = dv("x", "--", "git", "-C", ".", "stash", "list", 0, 0);
    ck(rc == 125 && has("REFUSE"), "refuse-git-C-stash");
    rc = dv("x", "--", "git", "push", "--force", 0, 0, 0);
    ck(rc == 125 && has("REFUSE"), "refuse-push-force");

    /* (d2) DCLI2:已启动的 git 动作保留真实 rc 与诊断,不贴 devsvc usage;只有参数解析错才贴 usage */
    ck(sh("printf 'ws \\n' > dvg-ws.txt && git add dvg-ws.txt", fx) == 0, "rc2-fixture");
    rc = dv("git", "diff", "--cached", "--check", 0, 0, 0, 0);
    ck(rc == 2 && has("dvg-ws.txt:1: trailing whitespace") && !has("usage: devsvc"), "diff-check-rc2-keeps-diag-no-usage");
    rc = dv("git", "diff", "--cached", "--exit-code", "--stat", 0, 0, 0);
    ck(rc == 1 && has("dvg-ws.txt") && !has("usage: devsvc"), "diff-exit-code-rc1-no-usage");
    rc = dv("git", "diff", "--cached", "--stat", 0, 0, 0, 0);
    ck(rc == 0 && has("dvg-ws.txt") && !has("usage: devsvc"), "diff-rc0-no-usage");
    rc = dv("git", "log", "--no-such-option-dvg", 0, 0, 0, 0, 0);
    ck(rc != 0 && rc != 2 && !has("usage: devsvc"), "log-git-own-error-rc-kept-no-usage");
    ck(sh("git rm -q --cached dvg-ws.txt && rm -f dvg-ws.txt", fx) == 0, "rc2-fixture-cleanup");
    rc = dv("git", "add", "out", 0, 0, 0, 0, 0);
    ck(rc == 2 && has("REFUSE git add out:") && !has("usage: devsvc"), "add-refuse-rc2-named-no-usage");
    rc = dv("git", "commit", "-m", "X", "--whole", "dvg-b1.txt", "--cwd", "dvg-no-such-dir");
    ck(rc == 2 && has("REFUSE git commit --cwd") && !has("usage: devsvc"), "commit-cwd-refuse-rc2-via-receipt-no-usage");
    {   char h0[64], h1[64];
        (void)sh("git rev-parse HEAD", fx); F(h0, sizeof h0, "%.60s", out);
        rc = dv("git", 0, 0, 0, 0, 0, 0, 0);
        ck(rc == 2 && has("usage: devsvc"), "git-no-subcommand-rc2-usage");
        rc = dv("git", "merge", 0, 0, 0, 0, 0, 0);
        ck(rc == 2 && has("missing BRANCH") && has("usage: devsvc"), "merge-missing-branch-rc2-usage");
        rc = dv("git", "merge", "--frob", 0, 0, 0, 0, 0);
        ck(rc == 2 && has("unexpected --frob") && has("usage: devsvc"), "merge-bad-option-rc2-usage");
        rc = dv("git", "add", 0, 0, 0, 0, 0, 0);
        ck(rc == 2 && has("need 1..") && has("usage: devsvc"), "add-no-path-rc2-usage");
        rc = dv("git", "commit", "--whole", "dvg-b1.txt", 0, 0, 0, 0);
        ck(rc == 2 && has("-m MSG is required") && has("usage: devsvc"), "commit-missing-m-rc2-usage");
        rc = dv("git", "commit", "-m", "X", "--frob", 0, 0, 0);
        ck(rc == 2 && has("unknown option --frob") && has("usage: devsvc"), "commit-bad-option-rc2-usage");
        rc = dv("git", "frobnicate", 0, 0, 0, 0, 0, 0);
        ck(rc == 125 && has("REFUSE git frobnicate") && !has("usage: devsvc"), "unknown-subcommand-named-refuse-rc125");
        (void)sh("git rev-parse HEAD", fx); F(h1, sizeof h1, "%.60s", out);
        ck(!ovf && h0[0] && !strcmp(h0, h1) && sh("[ -z \"$(git diff --cached --name-only)\" ]", fx) == 0, "bad-args-no-git-side-effect"); }

    /* (e) git status 末行格式 */
    rc = dv("git", "status", 0, 0, 0, 0, 0, 0);
    {   char *p = strstr(out, "GIT_STATUS\tdirty="); int d = -1, o = -1;
        ck(rc == 0 && p && sscanf(p, "GIT_STATUS\tdirty=%d\torphan=%d", &d, &o) == 2 && d >= 0 && o >= 0 && o <= d, "status-last-line-format"); }

    }
    if (C) {
    /* (r) 前台 commit 在作业里跑:输出含 JOB id,git commit --status JOB 取回 rc 与 commit 号 */
    {   char id[48] = "", hd[64] = "", *p;
        ck(wfile("dvg-r.txt", "r\n") == 0, "receipt-fixture");
        rc = dv("git", "commit", "-m", "R", "--whole", "dvg-r.txt", 0, 0);
        ck(rc == 0 && has("GIT_COMMIT\trc=0") && (p = strstr(out, "JOB\t")) && sscanf(p, "JOB\t%47s", id) == 1, "receipt-commit-runs-as-job");
        ck(sh("git rev-parse HEAD", fx) == 0 && sscanf(out, "%63s", hd) == 1, "receipt-head");
        rc = dv("git", "commit", "--status", id, 0, 0, 0, 0);
        {   char want[200]; F(want, sizeof want, "GIT_COMMIT\trc=0\tcommit=%s", hd);
            ck(rc == 0 && id[0] && has("COMMIT_RECEIPT\t") && has("\tdone\trc=0\t") && has(want) && has("dvg-r.txt"), "receipt-status-returns-rc-and-commit"); }
        rc = dv("git", "commit", "--status", "123-456", 0, 0, 0, 0);
        ck(rc == 2 && has("COMMIT_RECEIPTS\tn=0"), "receipt-status-unknown-job-rc2");
        rc = dv("git", "commit", "--status", "bad-id", 0, 0, 0, 0);
        ck(rc == 2 && has("bad job id"), "receipt-status-bad-id-rc2");
    }
    /* (j) x --bg:立即返回 JOB;作业 --timeout-ms 到点自退 rc 124,整个进程组被清理;wait 返回终态 */
    {   char id[48] = "", c2[300], *p; long t1 = sy_now_ms();
        F(c2, sizeof c2, "sleep 30 & echo $! > %s/bgpid; wait", fx);
        rc = dv("x", "--bg", "--timeout-ms", "1500", "--", "sh", "-c", c2);
        ck(rc == 0 && (p = strstr(out, "JOB\t")) && sscanf(p, "JOB\t%47s", id) == 1 && sy_now_ms() - t1 < 15000, "bg-returns-job-id");
        rc = dv("wait", id, "--timeout-ms", "20000", 0, 0, 0, 0);
        ck(rc == 124 && has("JOB_DONE\t") && has("rc=124"), "bg-deadline-self-exit-rc124");
        F(c2, sizeof c2, "! kill -0 $(cat bgpid) 2>/dev/null");
        ck(sh(c2, fx) == 0, "bg-deadline-kills-process-group");
    }
    /* (m) git merge:无冲突合入当前分支;冲突报文件清单 rc 1、不自动解决 */
    F(c, sizeof c, "git checkout -q -b dvm-a && printf 'a\\n' > dvm-a.txt && git add dvm-a.txt && git commit -q -m MA && git checkout -q - "
                   "&& git checkout -q -b dvm-b && printf 'b\\n' > dvm.txt && git add dvm.txt && git commit -q -m MB && git checkout -q - "
                   "&& printf 'main\\n' > dvm.txt && git add dvm.txt && git commit -q -m MM");
    ck(!ovf && sh(c, fx) == 0, "merge-fixture");
    rc = dv("git", "merge", "dvm-a", 0, 0, 0, 0, 0);
    ck(rc == 0 && has("GIT_MERGE\trc=0\tcommit=") && sh("git cat-file -e HEAD:dvm-a.txt", fx) == 0, "merge-clean-rc0");
    rc = dv("git", "merge", "dvm-b", 0, 0, 0, 0, 0);
    ck(rc == 1 && has("MERGE_CONFLICT\tdvm.txt\n") && has("GIT_MERGE\trc=1\tconflicts=1"), "merge-conflict-lists-files-rc1");
    ck(sh("git merge --abort", fx) == 0, "merge-conflict-left-for-caller");
    rc = dv("git", "merge", 0, 0, 0, 0, 0, 0);
    ck(rc == 2, "merge-missing-branch-rc2");
    /* (g) git add:out/、..、绝对、忽略路径拒绝 rc 2;普通路径同步进 index */
    ck(wfile("dvg-ign.log", "i\n") == 0 && sh("echo dvg-ign.log >> .git/info/exclude && printf 'g\\n' > dvg-add.txt", fx) == 0, "add-fixture");
    rc = dv("git", "add", "out", 0, 0, 0, 0, 0); ck(rc == 2 && has("REFUSE git add out:"), "add-refuse-out");
    rc = dv("git", "add", "../x", 0, 0, 0, 0, 0); ck(rc == 2 && has("REFUSE"), "add-refuse-dotdot");
    rc = dv("git", "add", "/etc/passwd", 0, 0, 0, 0, 0); ck(rc == 2 && has("REFUSE"), "add-refuse-absolute");
    rc = dv("git", "add", "dvg-add.txt", "dvg-ign.log", 0, 0, 0, 0); ck(rc == 2 && has("ignored path"), "add-refuse-ignored-nothing-added");
    ck(sh("[ -z \"$(git ls-files -s -- dvg-add.txt)\" ]", fx) == 0, "add-refused-adds-nothing");
    rc = dv("git", "add", "dvg-add.txt", 0, 0, 0, 0, 0);
    ck(rc == 0 && has("GIT_ADD\trc=0\tn=1") && sh("[ -n \"$(git ls-files -s -- dvg-add.txt)\" ]", fx) == 0, "add-syncs-index");
    }
    if (D) {
    /* (d) git merge 派生表冲突自动解决:夹具 exec/facts/derive.tsv 只留一行小生成器 dvd(两个输入表拼成 build/dvd.tsv),
       两侧各改一个输入并各自重算 -> 只有 build/dvd.tsv 冲突 -> 自动取本侧、derive --write/--check --only dvd、完成合并;
       另一分支同时改输入表 dvd-2.tsv(非派生)冲突 -> MERGE_CONFLICT 清单、MERGE_HINT non-derived-conflict、rc 1、留在合并中不自动 abort */
    static const char gen[] =
        "#pragma unisa use sys.fs\n#pragma unisa use mem.heap\n#pragma unisa use mem.bytes\n"
        "int main(int c, char **v) { unsigned char *a = 0, *b = 0, *o = 0; int64_t na = 0, nb = 0, no = 0; static char w[8192]; int n;\n"
        "  if (sy_read_file(\"exec/facts/dvd-1.tsv\", &a, &na, 4096) || sy_read_file(\"exec/facts/dvd-2.tsv\", &b, &nb, 4096)) return 2;\n"
        "  n = snprintf(w, sizeof w, \"# n=%d\\n%.*s%.*s\", (int)(na + nb), (int)na, (char *)a, (int)nb, (char *)b);\n"
        "  if (c > 1 && !strcmp(v[1], \"--write\")) return sy_write_atomic(\"build/dvd.tsv\", w, n, 0644) ? 2 : 0;\n"
        "  if (sy_read_file(\"build/dvd.tsv\", &o, &no, 8192) || !o) return 1;\n"
        "  return (no == n && !memcmp(o, w, n)) ? 0 : 1; }\n";
    static const char man[] =
        "# name\tgenerator\tcheck_argv\twrite_argv\toutputs\tinputs_glob\torder\tbound_s\n"
        "dvd\ttools/dvd-gen.cx\tsh ./unisacc.com tools/dvd-gen.cx -- --check\tsh ./unisacc.com tools/dvd-gen.cx -- --write\tbuild/dvd.tsv\texec/facts/dvd-*\t1\t30\n";
    ck(wfile("tools/dvd-gen.cx", gen) == 0 && wfile("exec/facts/derive.tsv", man) == 0 && wfile("exec/facts/dvd-1.tsv", "one\n") == 0
       && wfile("exec/facts/dvd-2.tsv", "two\n") == 0 && wfile("build/dvd.tsv", "# n=8\none\ntwo\n") == 0, "derived-fixture-write");
    F(c, sizeof c, "M=$(git symbolic-ref --short HEAD) && git add -f tools/dvd-gen.cx exec/facts/derive.tsv exec/facts/dvd-1.tsv exec/facts/dvd-2.tsv build/dvd.tsv && git commit -q -m DV0"
                   " && git checkout -q -b dvd-b && printf 'one\\nbb1\\n' > exec/facts/dvd-1.tsv && printf '# n=12\\none\\nbb1\\ntwo\\n' > build/dvd.tsv && git commit -q -am DB"
                   " && git checkout -q -b dvd-c HEAD~1 && printf 'two\\nc2\\n' > exec/facts/dvd-2.tsv && printf '# n=11\\none\\ntwo\\nc2\\n' > build/dvd.tsv && git commit -q -am DC"
                   " && git checkout -q \"$M\" && printf 'two\\nm2\\n' > exec/facts/dvd-2.tsv && printf '# n=11\\none\\ntwo\\nm2\\n' > build/dvd.tsv && git commit -q -am DM"
                   " && sh ./unisacc.com tools/dvd-gen.cx -- --check");
    ck(!ovf && sh(c, fx) == 0, "derived-fixture-branches");
    rc = dv("git", "merge", "dvd-b", 0, 0, 0, 0, 0);
    ck(rc == 0 && has("MERGE_AUTO\tbuild/dvd.tsv\n") && has("GIT_MERGE\trc=0\tcommit=") && has("\tauto_resolved=1\tderive=dvd"), "derived-conflict-auto-resolved-rc0");
    F(c, sizeof c, "[ \"$(cat build/dvd.tsv)\" = \"$(printf '# n=15\\none\\nbb1\\ntwo\\nm2')\" ] && [ -z \"$(git status --porcelain -uno)\" ] && ! test -e .git/MERGE_HEAD"
                   " && git rev-parse -q --verify HEAD^2 >/dev/null && git log -1 --format=%%B | grep -q '自动解决派生表冲突: build/dvd.tsv'");
    ck(!ovf && sh(c, fx) == 0, "derived-merge-regenerated-committed-message");
    ck(sh("sh ./unisacc.com tools/derive.cx -- --check --only dvd", fx) == 0, "derived-merge-derive-check-clean");
    rc = dv("git", "merge", "dvd-c", 0, 0, 0, 0, 0);
    ck(rc == 1 && has("MERGE_CONFLICT\texec/facts/dvd-2.tsv\n") && has("MERGE_CONFLICT\tbuild/dvd.tsv\n") && has("MERGE_HINT\tnon-derived-conflict\t")
       && has("merge --abort") && has("GIT_MERGE\trc=1\tconflicts=2") && !has("MERGE_AUTO"), "mixed-conflict-stops-lists-rc1");
    ck(sh("test -e .git/MERGE_HEAD && git merge --abort", fx) == 0, "mixed-conflict-left-in-merge-not-aborted");
    }
    (void)dv("stop", 0, 0, 0, 0, 0, 0, 0);
    cleanup();
    printf("NOTE\twall_ms\t%ld\n", sy_now_ms() - t0);
    printf("CHECK_DEVSVC_GIT\tfailed=%d\n", nfail);
    return nfail ? 1 : 0;
}
