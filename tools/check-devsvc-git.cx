            "#pragma unisa use sys.proc\n"
            "int main(void) {\n"
            "    char *o = 0; size_t n = 0;\n"
            "    char *v[] = {\"sh\", \"-c\", \"S0=$(git rev-parse HEAD) && FB=$(printf 'foreign- mid\\\\n' | git hash-object -w --stdin) && FT=$({ git ls-tree $S0; printf '100644 blob %s\\\\tforeign-mid.txt\\\\n' $FB; } | git mktree) && F=$(git commit-tree -p $S0 -m FOREIGN_MID $FT) && git update-ref HEAD $F $S0 && printf 'foreign- mid\\\\n' > foreign-mid.txt && git update-index --add --cacheinfo 100644,$FB,foreign-mid.txt && BL=$(git hash-object -w tlf-landed.txt) && T=$({ git ls-tree $F; printf '100755 blob %s\\\\ttlf-landed.txt\\\\n' $BL; } | git mktree) && C=$(git commit-tree -p $F -m TL $T) && git update-ref HEAD $C $F && printf 'COMMIT_LANDED\\\\tfull=%s\\\\tbase=%s\\\\n' $C $F\", 0};\n"
            "    cx_runv_timeout(v, 10, &o, &n);\n"
            "    if (o && n > 0) sy_write_all(1, o, (long)n);\n"
            "    return 124;\n"
            "}\n";
        ck(wfile("tlf-landed.txt", "#!/bin/sh\necho resolved-2\n") == 0 && sh("chmod 755 tlf-landed.txt", fx) == 0 && wfile("tools/commit-own.cx", landed_fake) == 0, "f-landed-timeout-fixture-write");
        rc = dv("git", "commit", "-m", "TL", "--whole", "tlf-landed.txt", 0, 0);
        ck(rc == 0 && has("GIT_COMMIT_RECOVERED\tcommit=") && has("GIT_COMMIT\trc=0\tcommit=") &&
           sh("git cat-file -e HEAD:tlf-landed.txt && [ -z \"$(git status --porcelain -- tlf-landed.txt)\" ] && [ \"$(git ls-files -s -- tlf-landed.txt | cut -c1-6)\" = 100755 ]", fx) == 0,
           "f-timeout-after-commit-landed-recovers-receipt-and-syncs-index");
        (void)sh("git checkout -q -- tools/commit-own.cx", fx);

        rc = dv("x", "--", "git", "add", "tlf-m.txt", 0, 0, 0);
        ck(rc == 125 && has("REFUSE x git add"), "f-refuse-x-git-add");
        rc = dv("git", "fetch", 0, 0, 0, 0, 0, 0);
        ck(rc == 0 && has("GIT_FETCH\trc=0\tremote=origin"), "f-git-fetch-origin-rc0");
        rc = dv("git", "rev-parse", "HEAD", 0, 0, 0, 0, 0);
        ck(rc == 0 && strlen(out) >= 40, "f-git-ro-rev-parse");

        {   char clk[256], cev[300], ltxt[256];
            F(clk, sizeof clk, "%s/chain-supervise.lock", fx);
            F(ltxt, sizeof ltxt, "pid=%d\tpgid=%d\towner=chain-v088\tout=%s\tstarted_s=%ld\trelease_at=%ld\n",
              (int)sy_pid(), (int)sy_pid(), fx, sy_wall_s(), sy_wall_s() + 1800);
            ck(wfile("chain-supervise.lock", ltxt) == 0, "f-chain-lock-live-write");
            F(cev, sizeof cev, "DEVSVC_CHAIN_LOCK_FILE=%s", clk);
            envv[1] = cev; envv[2] = 0;
            rc = dv("x", "--par", "1", "--owner", "other-win", "--", "echo", "heavy-blocked");
            ck(rc == 75 && has("DEVSVC_CHAIN_BUSY\tstatus=REFUSE\treason=active-release-chain\t"), "f-chain-busy-refuses-non-owner-heavy-rc75");
            envv[1] = 0;
            (void)sh("rm -f chain-supervise.lock", fx);
        }
    }
    }
    if (FF2 && !getenv("DVGIT_CORE_FROM")) {
        static const char tgen2[] = "int main(void) { return 0; }\n";
        static const char tman2[] =
            "# name\tgenerator\tcheck_argv\twrite_argv\toutputs\tinputs_glob\torder\tbound_s\n"
            "tlx\ttools/tlx-gen.cx\tsh ./unisacc.com tools/tlx-gen.cx -- --check\tsh ./unisacc.com tools/tlx-gen.cx -- --write\tbuild/tlib-packages.tsv\tbuild/tlib-packages.tsv\t1\t30\n";
        (void)wfile("tools/tlx-gen.cx", tgen2);
        (void)wfile("exec/facts/derive.tsv", tman2);
        (void)wfile("build/tlib-packages.tsv", "# pkg\tversion\tapi_sha\tnote\np.a\t0.1.0\tsa0\tA\np.b\t0.2.0\tsb0\tB\np.c\t1.0.0\tsc0\tC\n");
        (void)sh("git add -f tools/tlx-gen.cx exec/facts/derive.tsv build/tlib-packages.tsv && git commit -q -m TL2_0", fx);

        /* (g3) 守卫:共享检出 MERGE_HEAD 超过阈值(缺省 180 秒,DEVSVC_MERGE_WARN_AGE_S=0 测试)在 devsvc status 首行显示 MERGE_HEAD_WARN */
        ck(sh("git rev-parse HEAD > .git/MERGE_HEAD", fx) == 0, "g3-merge-head-warn-fixture");
        envv[1] = "DEVSVC_MERGE_WARN_AGE_S=0"; envv[2] = 0;
        rc = dv("status", 0, 0, 0, 0, 0, 0, 0);
        envv[1] = 0;
        ck(rc == 0 && !strncmp(out, "MERGE_HEAD_WARN\tstatus=WARN\t", 28), "g3-status-first-line-warns-stale-merge-head");
        (void)sh("rm -f .git/MERGE_HEAD", fx);

        /* (g4) 甲:devsvc git merge BRANCH --worktree:共享检出有他人暂存时在 .claude/worktrees/merge-BRANCH 按四类规则处理冲突 */
        F(c, sizeof c,
          "M=$(git symbolic-ref --short HEAD) && mkdir -p plans build tests && "
          "printf '# version\\n0.0.87\\tbase\\n' > build/version-seq.tsv && "
          "printf '# plan\\nbase-line\\n' > plans/v0.0.88.md && "
          "printf '# surface\\ns0\\n' > build/std-surface.tsv && "
          "git add -f build/version-seq.tsv plans/v0.0.88.md build/std-surface.tsv && git commit -q -m WT0 && "
          "git checkout -q -b tlf-wt1 && "
          "printf '# pkg\\tversion\\tapi_sha\\tnote\\np.a\\t0.2.0\\tsa1\\tA\\np.b\\t0.2.5\\tsb2\\tB\\np.c\\t1.0.10\\tsc2\\tC\\n' > build/tlib-packages.tsv && "
          "printf '# version\\n0.0.87\\tbase\\n0.0.89\\ttheirs\\n' > build/version-seq.tsv && "
          "printf '# plan\\nbase-line\\ntheirs-doc-line\\n' > plans/v0.0.88.md && "
          "git commit -q -am WT1B && "
          "git checkout -q \"$M\" && "
          "printf '# pkg\\tversion\\tapi_sha\\tnote\\np.a\\t0.1.9\\tsa0\\tA\\np.b\\t0.3.0\\tsb3\\tB\\np.c\\t1.0.10\\tsc2\\tC\\n' > build/tlib-packages.tsv && "
          "printf '# version\\n0.0.87\\tbase\\n0.0.88\\tours\\n' > build/version-seq.tsv && "
          "printf '# plan\\nbase-line\\nours-doc-line\\n' > plans/v0.0.88.md && "
          "git commit -q -am WT1M && "
          "printf 'foreign-staged\\n' > foreign.txt && git add foreign.txt");
        ck(!ovf && sh(c, fx) == 0, "g4-worktree-auto-fixture");
        rc = dv("git", "merge", "tlf-wt1", "--worktree", 0, 0, 0, 0);
        ck(rc == 0 &&
           has("MERGE_CLASS\tbuild/tlib-packages.tsv\tclass=generated\t") &&
           has("MERGE_CLASS\tbuild/version-seq.tsv\tclass=registry\taction=union-sort\tstatus=resolved") &&
           has("MERGE_CLASS\tplans/v0.0.88.md\tclass=doc\taction=union-both\tstatus=resolved") &&
           has("GIT_MERGE\trc=0\tcommit="),
           "g4-worktree-auto-resolves-generated-registry-doc-with-foreign-staged");
        ck(sh("[ \"$(git show :foreign.txt)\" = foreign-staged ] && "
              "git show HEAD:build/version-seq.tsv | grep -qx '0.0.88\tours' && "
              "git show HEAD:build/version-seq.tsv | grep -qx '0.0.89\ttheirs' && "
              "git show HEAD:plans/v0.0.88.md | grep -qx 'ours-doc-line' && "
              "git show HEAD:plans/v0.0.88.md | grep -qx 'theirs-doc-line' && "
              "git reflog show --format='%H\t%gs' -n 5 HEAD | grep -q \"^$(git rev-parse HEAD)\tdevsvc merge v1 [0-9a-f]\\{64\\} refs/heads/main$\"", fx) == 0,
           "g4-worktree-merged-tree-and-reflog-verified");

        /* (g5) 甲:含源表(build/std-surface.tsv)冲突时停在 .claude/worktrees/merge-tlf-wt2 -> 手合后 devsvc git merge --continue --cwd 回落 main */
        F(c, sizeof c,
          "git rm -q -f foreign.txt && M=$(git symbolic-ref --short HEAD) && "
          "git checkout -q -b tlf-wt2 && printf '# surface\\ns-theirs\\n' > build/std-surface.tsv && "
          "printf '# plan\\nwt2-theirs\\n' > plans/v0.0.88.md && git commit -q -am WT2B && "
          "git checkout -q \"$M\" && printf '# surface\\ns-ours\\n' > build/std-surface.tsv && "
          "printf '# plan\\nwt2-ours\\n' > plans/v0.0.88.md && git commit -q -am WT2M && "
          "printf 'foreign2\\n' > foreign2.txt && git add foreign2.txt");
        ck(!ovf && sh(c, fx) == 0, "g5-worktree-manual-fixture");
        rc = dv("git", "merge", "tlf-wt2", "--worktree", 0, 0, 0, 0);
        ck(rc == 1 &&
           has("MERGE_CLASS\tplans/v0.0.88.md\tclass=doc\taction=union-both\tstatus=resolved") &&
           has("MERGE_CLASS\tbuild/std-surface.tsv\tclass=source-table\taction=manual\tstatus=unresolved") &&
           has("MERGE_WORKTREE\tpath=") && has("\tbranch=merge/tlf-wt2\t") &&
           has("GIT_MERGE\trc=1\tconflicts=1\t"),
           "g5-worktree-stops-on-source-table-in-private-worktree");
        ck(sh("printf '# surface\\ns-hand-merged\\n' > .claude/worktrees/merge-tlf-wt2/build/std-surface.tsv && "
              "git -C .claude/worktrees/merge-tlf-wt2 add build/std-surface.tsv", fx) == 0,
           "g5-hand-resolve-source-table-in-worktree");
        rc = dv("git", "merge", "--continue", "--cwd", ".claude/worktrees/merge-tlf-wt2", 0, 0, 0);
        ck(rc == 0 && has("GIT_MERGE\trc=0\tcommit=") && has("\tcontinued=1\tfrom_worktree=") &&
           sh("! test -d .claude/worktrees/merge-tlf-wt2 && "
              "[ \"$(git show :foreign2.txt)\" = foreign2 ] && "
              "git show HEAD:build/std-surface.tsv | grep -qx 's-hand-merged' && "
              "git show HEAD:plans/v0.0.88.md | grep -qx 'wt2-ours' && "
              "git show HEAD:plans/v0.0.88.md | grep -qx 'wt2-theirs' && "
              "git reflog show --format='%H\t%gs' -n 5 HEAD | grep -q \"^$(git rev-parse HEAD)\tdevsvc merge v1 [0-9a-f]\\{64\\} refs/heads/main$\"", fx) == 0,
           "g5-worktree-continue-lands-back-to-main-and-cleans-worktree");
    }
    (void)dv("stop", 0, 0, 0, 0, 0, 0, 0);
    cleanup();
    printf("NOTE\twall_ms\t%ld\n", sy_now_ms() - t0);
    printf("CHECK_DEVSVC_GIT\tfailed=%d\n", nfail);
    return nfail ? 1 : 0;
}
