#pragma unisa use cxlib.uxeimage
#pragma unisa use chrome_dom
/* tools/gen-s0-reed.cx -- 概念稿竖条芦苇 320x480.
 * x=980+(i*17)%280, y=210+(i%7)*6, w=2+i%2, h=400, i=0..47
 * sh ./unisacc.com tools/gen-s0-reed.cx -- --write|--check
 */
#define CW 320
#define CH 480
#define OX 960
#define OY 200
static unsigned char cpix[CH][CW][4];
static void fill_reed(void) {
    int y, x, i, rx, ry, rw, hit;
    for (y = 0; y < CH; y++) for (x = 0; x < CW; x++) {
        int wx = OX + x, wy = OY + y;
        hit = 0;
        for (i = 0; i < 48; i++) {
            rx = 980 + (i * 17) % 280;
            ry = 210 + (i % 7) * 6;
            if (wx >= rx && wx < rx + 2 && wy >= ry && wy < ry + 200) hit = 1;
            rw = 2 + (i % 2);
            if (wx >= rx && wx < rx + rw && wy >= ry && wy < ry + 400) hit = 1;
        }
        if (hit) {
            cpix[y][x][0] = 16; cpix[y][x][1] = 32; cpix[y][x][2] = 8; cpix[y][x][3] = 255;
        } else {
            cpix[y][x][0] = 0; cpix[y][x][1] = 0; cpix[y][x][2] = 0; cpix[y][x][3] = 0;
        }

    }
}
static unsigned char outb[CH * (1 + CW * 4) + (CH * (1 + CW * 4) / 65535 + 1) * 5 + 63];
int main(int argc, char **argv) {
    int write = 0, check = 0, i, oi, failed = 0;
    FILE *f;
    uxe_crc_init();
    for (i = 1; i < argc; i++) {
        if (argv[i][0] == '-' && argv[i][2] == 'w') write = 1;
        if (argv[i][0] == '-' && argv[i][2] == 'c') check = 1;
    }
    if (!write && !check) { printf("GEN_S0_REED\tdry\n"); return 0; }
    fill_reed();
    oi = uxe_encode_rgba_png(outb,sizeof outb,&cpix[0][0][0],CW,CH);
    if(oi<=0) return 2;
    if (write) {
        f = fopen("ujs/plans/demo-v2/look-dev/reed-bank.png", "wb");
        if (!f) return 1;
        fwrite(outb, 1, oi, f);
        fclose(f);
        printf("WROTE\treed-bank.png\t%d\n", oi);
    }
    if (check) {
        if (uxe_check_png("ujs/plans/demo-v2/look-dev/reed-bank.png", outb, oi)) {
            printf("DIFF\treed-bank.png\n"); failed = 1;
        } else printf("MATCH\treed-bank.png\n");
    }
    printf("GEN_S0_REED\tok\n");
    return failed;
}
