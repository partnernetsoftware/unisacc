/* Bind 18 independently rerun material verifications, private emission, and
 * native selftest to one reviewable evidence record. This is not an install. */
#pragma unisa use cxlib.netpack
#pragma unisa use text.text
static const char *stages[18]={"pp","lex","parse","type","scope","irsel","enc","reloc","regmap","tyinfo","pfconv","peep","opinfo","prec","binsel","isel","abi","combo"};
static char root[4096],logs[4096],built[4096],dest[4096];
static void die(const char *s){fprintf(stderr,"classic18-private-evidence: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void copy_fit(char *dst, size_t cap, const char *src){size_t i=0;if(cap==0)die("copy-bound");while(src[i]&&i+1<cap){dst[i]=src[i];i++;}if(src[i])die("copy-bound");dst[i]=0;}
static void path(char p[4400],const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path-bound");}
static char *load(const char *p,size_t *n){struct stat a,b;errno=0;if(lstat(p,&a))die(errno==ENOENT?"input-absent":"input-stat");if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>16777216)die("bounded-regular-input");int fd=open(p,O_RDONLY|O_CLOEXEC|O_NONBLOCK|O_NOFOLLOW);if(fd<0)die("input-open");if(fstat(fd,&b)||!S_ISREG(b.st_mode)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size){close(fd);die("input-descriptor");}*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s){close(fd);die("allocation");}size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0){close(fd);die("input-extent");}at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int changed=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(z||changed||closed){free(s);die("input-changed-or-close");}s[*n]=0;return s;}
static void digest(const char *p,char hex[65]){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,hex);free(s);}
static void save(const char *p,const char *s,size_t n){int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive-output");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0){close(fd);die("output-write");}at+=(size_t)z;}int synced=fsync(fd),closed=close(fd);if(synced||closed)die("output-close");}
static void field(const char *s,const char *key,char *out,size_t cap){char tag[120];int z=snprintf(tag,sizeof tag,"\n%s\t",key);if(z<0||z>=(int)sizeof tag)die("field-key");const char *p=strstr(s,tag);if(!p||strstr(p+1,tag))die("field-missing-or-duplicate");p+=z;const char *e=strchr(p,'\n');if(!e||e==p||e-p>=(ptrdiff_t)cap)die("field-bound");{size_t i=0,n=(size_t)(e-p);while(i<n){out[i]=p[i];i++;}out[n]=0;}}
static void same_field(const char *s,const char *key,const char *want){char got[4096];field(s,key,got,sizeof got);if(!tx_eq(got, want, 1L << 20))die("field-mismatch");}
static void putfield(np_buf *b,const char *key,const char *value){np_puts(b,key);np_puts(b,"\t");np_puts(b,value);np_puts(b,"\n");}
static int nybble(char c){if(c>='0'&&c<='9')return c-'0';if(c>='a'&&c<='f')return c-'a'+10;return -1;}
static np_buf literal(const char *file){size_t n;char *s=load(file,&n);if(memchr(s,0,n))die("generated-literal-nul");char *p=strstr(s,"*/");if(!p)die("generated-literal-comment");p+=2;np_buf b={0};while(*p){while(*p==' '||*p=='\t'||*p=='\n'||*p=='\r')p++;if(!*p)break;if(*p!='"')die("generated-literal-quote");p++;while(*p&&*p!='"'){if(!p[1]||!p[2]||!p[3]||p[0]!='\\'||p[1]!='x'||nybble(p[2])<0||nybble(p[3])<0)die("generated-literal-hex");char c=(char)((nybble(p[2])<<4)|nybble(p[3]));np_put(&b,&c,1);p+=4;}if(*p!='"')die("generated-literal-close");p++;}free(s);return b;}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN classic18-private-evidence requires Linux/x86_64 LP64\n",stderr);return 3;
#endif
 if(argc!=41||sizeof(long)!=8||!realpath(argv[1],root)||!realpath(argv[2],logs)||!realpath(argv[3],built)||argv[4][0]!='/'||strlen(argv[4])>=sizeof dest)die("usage-ROOT-LOGS-BUILT-NEW-ABS-DEST-18-NAME-MATERIAL-pairs");copy_fit(dest,sizeof dest,argv[4]);
 char p[4400],want[4400],product[65],tool[65],evidence_tool[65],built_sha[65],receipt_sha[65],selftest_sha[65],binary_sha[65],source_sha[65];
 path(p,root,"unisacc.com");digest(p,product);path(p,root,"tools/gold-partition-material.cx");digest(p,tool);path(p,root,"tools/classic18-private-evidence.cx");digest(p,evidence_tool);
 path(p,built,"weights/built.json");digest(p,built_sha);path(p,built,"receipt.tsv");size_t rn;char *br=load(p,&rn);if(memchr(br,0,rn)||rn<21||strncmp(br,"net-built-private-v2\n",21)||br[rn-1]!='\n')die("built-receipt-wire");same_field(br,"status","PREPARED");same_field(br,"private-built.json",built_sha);cx_sha256_hex(br,rn,receipt_sha);
 path(p,built,"selftest.log");size_t sn;char *self=load(p,&sn);const char *selfwant="22694 decisions, 0 wrong\n";if(sn!=strlen(selfwant)||memcmp(self,selfwant,sn))die("native-selftest-result");cx_sha256_hex(self,sn,selftest_sha);free(self);
 path(p,built,"unisa-self");digest(p,binary_sha);char why[1400],bound[4400];path(bound,root,"tools/bound");char *v[]={bound,"20",p,0};np_result run;if(np_run(v,root,0,23,&run,why,sizeof why))die(why);int self_ok=!run.rc&&!run.errn&&run.outn==strlen(selfwant)&&!memcmp(run.out,selfwant,run.outn);np_free(&run);if(!self_ok)die("native-selftest-replay");path(p,built,"kernel/unisa_self.c");digest(p,source_sha);
 np_buf rec={0};np_puts(&rec,"classic18-private-evidence-v1\nstatus\tEVIDENCE_ONLY\nscope\tprivate-18-net-no-live-install-or-release-qualification\n");putfield(&rec,"product-sha256",product);putfield(&rec,"constructor-sha256",tool);putfield(&rec,"evidence-tool-sha256",evidence_tool);putfield(&rec,"private-built-json-sha256",built_sha);putfield(&rec,"private-emitter-receipt-sha256",receipt_sha);putfield(&rec,"native-source-sha256",source_sha);putfield(&rec,"native-binary-sha256",binary_sha);putfield(&rec,"native-selftest-sha256",selftest_sha);putfield(&rec,"pp-authority","gold-table-partition-7cbdb9ccef371dbcdb45fc60b612c2139292eafc81de3ceb15fcd7dcc37fca48");
 for(int i=0;i<18;i++){
  const char *stage=stages[i];if(!tx_eq(argv[5+2*i], stage, 1L << 20))die("stage-order");char mat[4096];if(!realpath(argv[6+2*i],mat))die("material-path");
  path(p,mat,"material.tsv");size_t mn;char *mr=load(p,&mn);if(memchr(mr,0,mn)||mn<27||strncmp(mr,"gold-partition-material-v1\n",27)||mr[mn-1]!='\n')die("material-wire");same_field(mr,"status","PREPARED");same_field(mr,"stage",stage);same_field(mr,"product-sha256",product);same_field(mr,"tool-sha256",tool);
  char gold[65],weight[65],model[65],keys[40],units[40],heads[40],mh[65],lh[65];int z=snprintf(want,sizeof want,"weights/gold/%s.tsv",stage);if(z<0||z>=(int)sizeof want)die("gold-path");path(p,root,want);digest(p,gold);same_field(mr,"gold-sha256",gold);
  path(p,mat,"weights.bin");size_t wn;char *w=load(p,&wn);cx_sha256_hex(w,wn,weight);same_field(mr,"weights-sha256",weight);if(i==0&&!tx_eq(weight, "7cbdb9ccef371dbcdb45fc60b612c2139292eafc81de3ceb15fcd7dcc37fca48", 1L << 20))die("pp-authority");path(p,mat,"model.json");digest(p,model);same_field(mr,"model-json-sha256",model);field(mr,"keys",keys,sizeof keys);field(mr,"units",units,sizeof units);field(mr,"heads",heads,sizeof heads);cx_sha256_hex(mr,mn,mh);free(mr);
  z=snprintf(want,sizeof want,"kernel/weight.%s.inc",stage);if(z<0||z>=(int)sizeof want)die("emitted-weight-path");path(p,built,want);np_buf emitted=literal(p);int weight_ok=emitted.n==wn&&!memcmp(emitted.p,w,wn);free(emitted.p);free(w);if(!weight_ok)die("emitted-weight-mismatch");
  z=snprintf(want,sizeof want,"kernel/dense.%s.inc",stage);if(z<0||z>=(int)sizeof want)die("emitted-dense-path");path(p,built,want);np_buf dense=literal(p);path(p,root,want);np_buf baseline=literal(p);int dense_ok=dense.n==baseline.n&&!memcmp(dense.p,baseline.p,dense.n);char dense_sha[65];cx_sha256_hex(dense.p,dense.n,dense_sha);free(dense.p);free(baseline.p);if(!dense_ok)die("emitted-dense-mismatch");
  z=snprintf(want,sizeof want,"\nstage\t%s\t%s\t%s\n",stage,weight,dense_sha);if(z<0||z>=(int)sizeof want||!strstr(br,want)||strstr(strstr(br,want)+1,want))die("emitter-stage-binding");
  z=snprintf(want,sizeof want,"verify-%s.log",stage);if(z<0||z>=(int)sizeof want)die("verify-path");path(p,logs,want);size_t ln;char *log=load(p,&ln);char expected[500];z=snprintf(expected,sizeof expected,"VERIFIED\tgold-partition-material\tstage=%s\tkeys=%s\tunits=%s\theads=%s\tweights=%s\n",stage,keys,units,heads,weight);if(z<0||z>=(int)sizeof expected||ln!=(size_t)z||memcmp(log,expected,ln))die("full-verifier-log-mismatch");cx_sha256_hex(log,ln,lh);free(log);
  np_puts(&rec,"stage\t");np_puts(&rec,stage);np_puts(&rec,"\t");np_puts(&rec,mh);np_puts(&rec,"\t");np_puts(&rec,lh);np_puts(&rec,"\n");
 }
 free(br);if(mkdir(dest,0700))die("fresh-evidence-directory");path(p,dest,"evidence.tsv");save(p,rec.p,rec.n);free(rec.p);printf("EVIDENCE_ONLY\tclassic18-private\tstages=18\tbuilt=%s\tselftest=22694/0\n",built_sha);return 0;
}
