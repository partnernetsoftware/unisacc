/* Independent source-P3 construction foundation, not P7 package refresh.
 * prepare-context ROOT SAVED_BOOTSTRAP /absolute/CC NEW_ABS_CONTEXT
 * --list ROOT CONTEXT | --verify-context ROOT CONTEXT
 * job ROOT CONTEXT JOB_ID
 * pack ROOT CONTEXT KERNEL_GENERATION | --verify ROOT CONTEXT: NOT_READY.
 * Caller bound55. A job is ONE native C command bound40; fresh native full-SID
 * observations bound6 before/after give52 explicit seconds, not a timing promise.
 * prepare-context: bootstrap SID8 + CC version2 + ident compile15 + native SID6.
 * No shell/Python algorithm, legacy aggregation, NN training or saved PASS.
 * The initial SID and this controller's compiler bootstrap remain trusted.
 * CC/system headers/linker/libraries/zlib are declared nonhermetic host inputs.
 * Full source observations still read existing .py/weight files as input bytes.
 * Planned routes/declaration/pack/sealing must be implemented and actually run
 * before any source-package-v1 package.tsv/model-inputs.tsv may be emitted.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.kernelsha
#pragma unisa use cxlib.productpkg
#pragma unisa use cxlib.sourcepackage
#pragma unisa use sysx.trace
#pragma unisa use text.text
typedef struct {const char *id,*stage,*flags[4];} SpModel;
static const SpModel recipes[]={
 {"shared-e2","pp",{"--shared-predefines",0}},
 {"shared-e1","lex",{"--typed",0}}, {"shared-e3","parse2",{"--locations",0}},
 {"shared-e4","opt",{"--o2",0}}, {"shared-o1","opt",{0}},
 {"shared-prune","prune",{0}}, {"shared-nativeabi","nativeabi",{0}},
 {"lnx-arm64-lower","lower",{"--full","--arm64",0}},
 {"lnx-arm64-elf","enc/arm",{"--elf",0}},
 {"lnx-x86_64-lower","lower",{"--full",0}},
 {"lnx-x86_64-elf","enc",{"--elf",0}},
 {"osx-arm64-lower","lower",{"--full","--osx","--arm64",0}},
 {"osx-arm64-elf","enc/arm",{"--macho",0}},
 {"osx-x86_64-lower","lower",{"--full","--osx",0}},
 {"osx-x86_64-elf","enc",{"--macho",0}},
 {"win-arm64-lower","lower",{"--full","--win","--arm64",0}},
 {"win-arm64-elf","enc/arm",{"--pe",0}},
 {"win-x86_64-lower","lower",{"--full","--win",0}},
 {"win-x86_64-elf","enc",{"--pe",0}},
 {"warnparse","parse2",{"--warnings","--errors",0}},
 {"errorparse","parse2",{"--errors",0}},
 {"warnunits","parse2/units",{"--locations",0}},
 {"warnlex","lex",{"--locations",0}}, {"tokenlex","lex",{0}},
 {"tokenpp","pp",{"--shared-predefines","--no-autoinc",0}},
 {"warnpp-shared","pp",{"--locations","--shared-predefines",0}},
 {"object-lower-arm64","lower",{"--full","--object","--arm64",0}},
 {"object-lower-x86_64","lower",{"--full","--object",0}},
 {"object-enc-arm64","enc/arm",{"--object",0}},
 {"object-enc-x86_64","enc",{"--object",0}},
 {"object-lower-osx-x86_64","lower",{"--full","--object","--osx",0}},
 {"object-lower-osx-arm64","lower",{"--full","--object","--osx","--arm64"}},
 {"object-lower-win-x86_64","lower",{"--full","--object","--win",0}},
 {"object-lower-win-arm64","lower",{"--full","--object","--win","--arm64"}},
 {"object-enc-osx-x86_64","enc/unitcontainer-osx-x86_64",{"--object",0}},
 {"object-enc-osx-arm64","enc/unitcontainer-osx-arm64",{"--object",0}},
 {"object-enc-win-x86_64","enc/unitcontainer-win-x86_64",{"--object",0}},
 {"object-enc-win-arm64","enc/unitcontainer-win-arm64",{"--object",0}},
 {"tapecheck","tapecheck",{0}}, {"hostsymbols","lower/hostsymbols",{0}},
 {"librarycontract","librarycontract/gen",{0}},
 {"librarypartition","librarypartition/gen",{0}}
};
static const char *tools[]={"gen","tbl","net","compilerpack","pack"};
static char root[4096],ctx[4096],bootstrap[4096],cc[4096],self[4096],product[4400],bound[4400],ident[4400],helper[4400],netpack[4400],bound_c[4400],jobs[4400];
static char sid[65],context_sha[65],cc_sha[65],cc_version_sha[65],helper_sha[65],bootstrap_sha[65],product_sha[65],self_sha[65],netpack_sha[65],bound_sha[65],bound_c_sha[65],ident_sha[65];
static const char *ident_flags="-std=c99 -D_POSIX_C_SOURCE=200809L -O2 -w";
static const char *environment_policy="raw-environ-remove-SEED_GEN_GENERIC-SEED_GEN_TRACE-UNISACC_SEED_TRACE-UNISACC_RF_CAPTURE-UNISA_ATTRIBUTES-v1";
static char **owned_environment;
static void die(const char *s){fprintf(stderr,"source-package: REFUSE %s errno=%d\n",s,errno);exit(2);}
/* Match np_run's proven direct environ handoff. getenv/unsetenv may consult
 * image-private state that does not reach execvp; an empty value also changes
 * seed-gen's getenv-presence branch. Delete complete NAME=value entries. */
static int forbidden_environment(const char *s){const char *keys[]={"SEED_GEN_GENERIC","SEED_GEN_TRACE","UNISACC_SEED_TRACE","UNISACC_RF_CAPTURE","UNISA_ATTRIBUTES"};for(int i=0;i<5;i++){size_t n=strlen(keys[i]);if(!strncmp(s,keys[i],n)&&s[n]=='=')return 1;}return 0;}
static void clean_environment(void){size_t n=0;for(char **p=environ;*p;p++)n++;if(n>1048576)die("environment-entry-bound");char **next=malloc((n+1)*sizeof *next);if(!next)die("allocation");size_t at=0;for(char **p=environ;*p;p++)if(!forbidden_environment(*p))next[at++]=*p;next[at]=0;char **old=owned_environment;environ=next;owned_environment=next;free(old);for(char **p=environ;*p;p++)if(forbidden_environment(*p))die("environment-policy-not-applied-to-raw-environ");}
static void path(char *p,const char *a,const char *b){if(sp_path_join(p,a,b))die("path-bound");}
static void clean(const char *p){if(!p[0]||strpbrk(p,"\r\n\t"))die("unclean-path");}
static void canonical(const char *p){char actual[4400];clean(p);if(p[0]!='/'||!realpath(p,actual)||!tx_eqz(p, actual))die("canonical-input-path-required");}
/* The consumer already declares this hybrid provider. Keep every observation
 * and byte comparison; only the implementation of SHA-256 changes. */
static void digest(const char *p,char h[65]){size_t n;char *s=load(p,&n);if(n>=1024){int rc=ks_sha256_hex(s,n,h);if(rc){fprintf(stderr,"source-package: kernel-sha256 rc=%d on %s\n",rc,p);die("digest-provider-failure");}}else cx_sha256_hex(s,n,h);free(s);}
static void absent(const char *p){struct stat st;errno=0;if(!lstat(p,&st)||errno!=ENOENT)die("exclusive-output-required");}
static void write_new(const char *p,const char *s,size_t n){int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive-record");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("record-write");at+=(size_t)z;}int synced=fsync(fd),closed=close(fd);if(synced||closed)die("record-close");}
static void row(np_buf *b,const char *k,const char *v){np_puts(b,k);np_puts(b,"\t");np_puts(b,v);np_puts(b,"\n");}
static void equal(const char *p,const np_buf *expected){if(sp_equal_bytes(p,expected))die("receipt-bytes-mismatch");}
static char *load(const char *p,size_t *n){char *s;if(sp_load_file(p,&s,n))die(errno==ENOENT?"input-absent":"input-stat");return s;}
static void optional_digest(const char *artifact,char out[65]){char p[4600];int n=snprintf(p,sizeof p,"%s.build.json",artifact);if(n<0||(size_t)n>=sizeof p)die("metadata-path");struct stat st;errno=0;if(lstat(p,&st)){if(errno!=ENOENT)die("metadata-stat");strcpy(out,"ABSENT");return;}digest(p,out);}
static int json_string(const char *s,const char *key,char *out,size_t cap,int optional){char needle[120];int z=snprintf(needle,sizeof needle,"\n  \"%s\": \"",key);if(z<0||(size_t)z>=sizeof needle)die("root-epoch-json-key");const char *a=strstr(s,needle);if(!a)return optional?0:-1;if(strstr(a+1,needle))return -1;a+=strlen(needle);const char *e=strchr(a,'"');if(!e||(size_t)(e-a)>=cap||memchr(a,'\\',(size_t)(e-a)))return -1;memcpy(out,a,(size_t)(e-a));out[e-a]=0;return 1;}
/* B5c: build records no longer carry artifact_sha256 -- the product identity is the
   manifest (B5b). A record that still has the field is refused by name, so a stale
   identity cannot pass this gate. Without that field E0 step 8 no longer refuses on
   root-epoch-record-shape. */
static void root_epoch_execution_record(const char *s,size_t n,const char *artifact,size_t bytes){char a[65];(void)artifact;int dr=pp_product_digest(root,a);const char *why=pp_execution_record_error(s,n,bytes,pp_identity_kind(root),dr?0:a);if(why)die(why);}
static void freeze_root_epoch_record(void){char live[4600],frozen[4400];int n=snprintf(live,sizeof live,"%s.build.json",product);if(n<0||(size_t)n>=sizeof live)die("live-root-record-path");path(frozen,ctx,"root-epoch.build.json");absent(frozen);struct stat st;if(lstat(product,&st)||!S_ISREG(st.st_mode)||st.st_size<0)die("root-epoch-product-stat");size_t zn;char *s=load(live,&zn);if(!zn)die("live-root-record-empty");root_epoch_execution_record(s,zn,product_sha,(size_t)st.st_size);write_new(frozen,s,zn);free(s);}
static void live_root_epoch_bind(void){char frozen[4400],live[4600],fs[65],ls[65];path(frozen,ctx,"root-epoch.build.json");int n=snprintf(live,sizeof live,"%s.build.json",product);if(n<0||(size_t)n>=sizeof live)die("live-root-record-path");struct stat st;if(lstat(product,&st)||!S_ISREG(st.st_mode)||st.st_size<0)die("root-epoch-product-stat");size_t bytes=(size_t)st.st_size,fn,ln;char *fb=load(frozen,&fn),*lb=load(live,&ln);root_epoch_execution_record(fb,fn,product_sha,bytes);root_epoch_execution_record(lb,ln,product_sha,bytes);if(json_string(fb,"sources_sha256",fs,sizeof fs,0)!=1||json_string(lb,"sources_sha256",ls,sizeof ls,0)!=1||!tx_eqz(fs, ls)){free(fb);free(lb);die("live-root-record-artifact-or-source-mismatch");}free(fb);free(lb);}
static void setup(const char *r,const char *c){if(!realpath(r,root))die("root-realpath");clean(root);clean(c);if(c[0]!='/'||strlen(c)>=sizeof ctx)die("absolute-context-required");strcpy(ctx,c);path(product,root,"unisacc.com");path(bound,root,"tools/bound");path(bound_c,root,"tools/bound.c");path(ident,root,"seed/ident.c");path(helper,ctx,"identity-helper");path(netpack,root,"tools/cxlib/netpack.cx");path(jobs,ctx,"jobs");if(!realpath(__FILE__,self))die("self-realpath");char expected[4400],actual[65];path(expected,root,"tools/source-package.cx");digest(self,self_sha);digest(expected,actual);if(!tx_eqz(self_sha, actual))die("controller-not-root-source");}
static np_result command(char **v,int secs,const char *evidence){np_buf b={0};for(int i=0;v[i];i++){clean(v[i]);char key[32];snprintf(key,sizeof key,"arg-%d",i);row(&b,key,v[i]);}char p[4600];int n=snprintf(p,sizeof p,"%s.argv.tsv",evidence);if(n<0||(size_t)n>=sizeof p)die("evidence-path");write_new(p,b.p,b.n);free(b.p);clean_environment();np_result r;char why[1024];if(sp_trace_run(v,root,secs+2,evidence,&r,why,sizeof why)){snprintf(p,sizeof p,"%s.error",evidence);write_new(p,why,strlen(why));snprintf(p,sizeof p,"%s.status",evidence);const char *s="rc\tUNAVAILABLE\n";write_new(p,s,strlen(s));die(why);}snprintf(p,sizeof p,"%s.stdout",evidence);write_new(p,r.out,r.outn);snprintf(p,sizeof p,"%s.stderr",evidence);write_new(p,r.err,r.errn);char status[40];n=snprintf(status,sizeof status,"rc\t%d\n",r.rc);snprintf(p,sizeof p,"%s.status",evidence);write_new(p,status,(size_t)n);return r;}
static void measure(char out[65],int initial,const char *evidence){char *v[9];int n=0;v[n++]=bound;v[n++]=initial?"8":"6";if(initial){v[n++]="sh";v[n++]=bootstrap;v[n++]=ident;v[n++]="--";}else v[n++]=helper;v[n++]=root;v[n]=0;np_result r;if(evidence)r=command(v,initial?8:6,evidence);else{char why[1024];clean_environment();if(np_run(v,root,0,initial?10:8,&r,why,sizeof why))die(why);}int ok=!r.rc&&!r.errn&&r.outn==65&&r.out[64]=='\n';if(ok){memcpy(out,r.out,64);out[64]=0;for(int i=0;i<64;i++)if(!((out[i]>='0'&&out[i]<='9')||(out[i]>='a'&&out[i]<='f')))ok=0;}if(!ok&&r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);if(!ok)die("fresh-full-source-measurement");}
static void observe_inputs(void){digest(cc,cc_sha);digest(helper,helper_sha);digest(bootstrap,bootstrap_sha);pp_product_digest(root,product_sha);digest(self,self_sha);digest(netpack,netpack_sha);digest(bound,bound_sha);digest(bound_c,bound_c_sha);digest(ident,ident_sha);char p[4400];path(p,ctx,"cc.version");digest(p,cc_version_sha);}
/* One writer for the context record: cxlib.sourcepackage (sp_context_record_for) observes the
 * hashes itself from the paths and the SID bound here; this file keeps no second copy. */
static np_buf context_record(void){np_buf b=sp_context_record_for(root,ctx,bootstrap,cc,self,sid);if(!b.n)die("context-record");return b;}
/* Extract paths only; reconstruct and exact-compare all context bytes using
 * fresh observations before trusting any previously completed job receipt. */
static void extract_path(const char *s,const char *key,char *dest,size_t cap){char needle[80];int z=snprintf(needle,sizeof needle,"\n%s\t",key);if(z<0||(size_t)z>=sizeof needle)die("context-key");const char *a=strstr(s,needle);if(!a||strstr(a+1,needle))die("unique-context-path");a+=strlen(needle);const char *e=strchr(a,'\n');if(!e||e==a||(size_t)(e-a)>=cap)die("context-path-bound");memcpy(dest,a,(size_t)(e-a));dest[e-a]=0;canonical(dest);}

/* Same-generation gate for this producer's own entry points: a context records
 * the root product identity it was built against, so a context from a different
 * generation must stop here, naming both digests, instead of surfacing later as
 * an unrelated receipt mismatch. */
static void require_live_generation(const char *r,const char *c){
 char p[4400],recorded[65],live[65];int zn=snprintf(p,sizeof p,"%s/context.tsv",c);if(zn<0||(size_t)zn>=sizeof p)die("context-path");
 size_t n;char *s=load(p,&n);if(!n||s[n-1]!='\n'||memchr(s,0,n)||memchr(s,'\r',n))die("context-wire");
 {char needle[80];int z=snprintf(needle,sizeof needle,"\nroot-product-sha\t");if(z<0||(size_t)z>=sizeof needle)die("ctx-root-key");const char *a=strstr(s,needle);if(!a||strstr(a+1,needle))die("ctx-root-key-unique");a+=strlen(needle);const char *e=strchr(a,'\n');if(!e||e==a||(size_t)(e-a)>=sizeof recorded)die("ctx-root-bound");memcpy(recorded,a,(size_t)(e-a));recorded[e-a]=0;}free(s);
 {int ok=1;for(int i=0;i<64;i++){char ch=recorded[i];if(!((ch>='0'&&ch<='9')||(ch>='a'&&ch<='f'))){ok=0;break;}}if(!ok||recorded[64])die("ctx-root-product-sha-shape");}
 if(pp_product_digest(r,live))die("live-root-product-digest");
 if(!tx_eqz(recorded, live)){fprintf(stderr,"source-package: REFUSE ctx-root-generation-mismatch ctx=%s live=%s\n",recorded,live);die("ctx-root-generation-mismatch");}
}
/* Name what actually differs between the recorded context and the freshly
 * observed one: the SID when that is the changed field, otherwise the first
 * differing line (key = recorded value vs live value). A bare
 * "receipt-bytes-mismatch" made two rounds of diagnosis guess wrong. */
static void context_mismatch(const char *path,const char *actual,size_t an,const np_buf *expected){
 size_t at=0;
 char rec_sid[72],live_sid[72];
 rec_sid[0]=live_sid[0]=0;
 while(at<an&&at<expected->n&&actual[at]==expected->p[at])at++;
 { const char *a=strstr(expected->p,"\nsource\t"); if(a){const char *e;size_t z;a+=8;e=strchr(a,'\n');z=e?(size_t)(e-a):strlen(a);if(z>=sizeof rec_sid)z=sizeof rec_sid-1;memcpy(rec_sid,a,z);rec_sid[z]=0;} }
 { const char *a=strstr(actual,"\nsource\t"); if(a){const char *e;size_t z;a+=8;e=strchr(a,'\n');z=e?(size_t)(e-a):strlen(a);if(z>=sizeof live_sid)z=sizeof live_sid-1;memcpy(live_sid,a,z);live_sid[z]=0;} }
 if(rec_sid[0]&&live_sid[0]&&strcmp(rec_sid,live_sid)){
  fprintf(stderr,"source-package: REFUSE source-sid-changed recorded=%s live=%s\n",rec_sid,live_sid);
  exit(2);
 }
 { size_t start=at;const char *key;size_t kz;
   while(start>0&&actual[start-1]!='\n')start--;
   key=actual+start;kz=0;while(start+kz<an&&actual[start+kz]!='\n')kz++;
   if(kz>96)kz=96;
   fprintf(stderr,"source-package: REFUSE context-record-changed path=%s byte=%lu key=%.*s\n",path,(unsigned long)at,(int)kz,key);
   exit(2); }
}
static void check_context_live(void){canonical(ctx);require_live_generation(root,ctx);char p[4400];path(p,ctx,"context.tsv");size_t n;char *s=load(p,&n);if(!n||s[n-1]!='\n'||memchr(s,0,n)||memchr(s,'\r',n))die("context-wire");extract_path(s,"cc",cc,sizeof cc);extract_path(s,"bootstrap",bootstrap,sizeof bootstrap);free(s);if(sp_bind_job_paths(root,jobs,cc,bound))die("job-path-bind");observe_inputs();measure(sid,0,0);np_buf expected=context_record();{ size_t actual; char *cur=load(p,&actual); int same=actual==expected.n&&!memcmp(cur,expected.p,actual);  if(!same){ context_mismatch(p,cur,actual,&expected); free(cur); exit(2); } free(cur); }cx_sha256_hex(expected.p,expected.n,context_sha);free(expected.p);sp_require_live_generation();live_root_epoch_bind();}
static void prepare_context(const char *bootstrap_arg,const char *cc_arg){if(!realpath(bootstrap_arg,bootstrap)||!realpath(cc_arg,cc)||bootstrap_arg[0]!='/'||cc_arg[0]!='/')die("absolute-bootstrap-and-CC-required");canonical(bootstrap);canonical(cc);char initial_s[65],initial_cc[65],initial_bootstrap[65],initial_product[65],initial_ident[65],initial_self[65],initial_netpack[65],initial_bound[65],initial_bound_c[65],p[4400];digest(cc,initial_cc);digest(bootstrap,initial_bootstrap);pp_product_digest(root,initial_product);digest(ident,initial_ident);digest(self,initial_self);digest(netpack,initial_netpack);digest(bound,initial_bound);digest(bound_c,initial_bound_c);if(mkdir(ctx,0700))die("new-context-required");canonical(ctx);if(mkdir(jobs,0700))die("new-jobs-directory");path(p,ctx,"initial-source");measure(initial_s,1,p);path(p,ctx,"CC-version");char *version[]={bound,"2",cc,"--version",0};np_result r=command(version,2,p);if(r.rc||!r.outn||r.outn>65536)die("CC-version-failed");path(p,ctx,"cc.version");write_new(p,r.out,r.outn);np_free(&r);path(p,ctx,"compile-ident");char *v[]={bound,"15",cc,"-std=c99","-D_POSIX_C_SOURCE=200809L","-O2","-w",ident,"-o",helper,0};absent(helper);r=command(v,15,p);int rc=r.rc;if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);if(rc)die("identity-helper-compile-failed");observe_inputs();path(p,ctx,"native-source-after");measure(sid,0,p);if(!tx_eqz(sid, initial_s)||!tx_eqz(cc_sha, initial_cc)||!tx_eqz(bootstrap_sha, initial_bootstrap)||!tx_eqz(product_sha, initial_product)||!tx_eqz(ident_sha, initial_ident)||!tx_eqz(self_sha, initial_self)||!tx_eqz(netpack_sha, initial_netpack)||!tx_eqz(bound_sha, initial_bound)||!tx_eqz(bound_c_sha, initial_bound_c))die("context-inputs-changed");freeze_root_epoch_record();np_buf b=context_record();path(p,ctx,"context.tsv");write_new(p,b.p,b.n);free(b.p);live_root_epoch_bind();puts("PREPARED\tsource-package-context-v2\tcontext-only-no-package-no-test-result");}
typedef struct {int tool,recipe,phase;} SpJob;
static SpJob find_job(const char *id){SpJob j={-1,-1,-1};for(int i=0;i<5;i++){char name[80];snprintf(name,sizeof name,"tool-%s",tools[i]);if(tx_eqz(id, name)){j.tool=i;return j;}}const char *phases[]={"gen-","tbl-","net-"};for(int p=0;p<3;p++)for(int m=0;m<(int)(sizeof recipes/sizeof *recipes);m++){char name[160];snprintf(name,sizeof name,"%s%s",phases[p],recipes[m].id);if(tx_eqz(id, name)){j.recipe=m;j.phase=p;return j;}}die("unknown-or-PLANNED-job");return j;}
/* The traced run writes <evidence>.reads.tsv; moving it beside the record is
 * cxlib.sourcepackage's sp_reads_install, the one implementation of that step. */
static void reads_install(const char *evidence,const char *dir){if(sp_reads_install(evidence,dir))die("job-reads-install");}
static void job_paths(const char *id,SpJob j,char dir[4400],char output[4400],char receipt[4400]){path(dir,jobs,id);path(output,dir,j.tool>=0?"result.exe":j.phase==0?"result.json":j.phase==1?"result.tbl":"result.net");path(receipt,dir,"record.tsv");}
/* The argv a job runs is decided in exactly one place: cxlib.sourcepackage's
 * job_command (exported as sp_job_command). A second copy here once omitted
 * pack's node include and pinned host libz path, so the verifier rebuilt a
 * different argv than the producer wrote and every candidate install refused
 * a receipt that was in fact correct. Keep this a thin forwarder. */
static int job_command(const char *id,SpJob j,char **v,char output[4400],char executable[4400],char source[4400],char include[4400],char dependency[4400]){char dir[4400],receipt[4400];job_paths(id,j,dir,output,receipt);int n=0;if(sp_job_command(root,jobs,cc,bound,id,v,&n))die("job-command-arguments");dependency[0]=0;include[0]=0;if(j.tool>=0){char name[100];snprintf(name,sizeof name,"seed/%s.c",tools[j.tool]);path(source,root,name);}else{snprintf(executable,sizeof((char[4400]){0}),"");char name[160],tool_dir[4400];snprintf(name,sizeof name,"tool-%s",tools[j.phase]);path(tool_dir,jobs,name);path(executable,tool_dir,"result.exe");if(j.phase){snprintf(name,sizeof name,"%s-%s",j.phase==1?"gen":"tbl",recipes[j.recipe].id);SpJob dj=find_job(name);char dd[4400],dr[4400];job_paths(name,dj,dd,dependency,dr);}}return n;}
static void verify_job(const char *id,int depth);
/* The dependency row names the ancestor's own record and output bytes; when the
 * ancestor does not verify the row says so, so the caller answers MISS rather
 * than killing the process on the first changed input. */
static void dependency(np_buf *b,const char *id,int depth){
 if(verify_job_verdict(id,depth+1)){np_puts(b,"dep-invalid\t");np_puts(b,id);np_puts(b,"\n");return;}
 SpJob j=find_job(id);char dir[4400],out[4400],receipt[4400],h[65];
 job_paths(id,j,dir,out,receipt);digest(receipt,h);row(b,id,h);digest(out,h);row(b,out,h);
}
/* Job identity is the command and every input it reads, not the context that
 * happened to run it: a job's bytes may not depend on which ctx produced them,
 * and keeping the context digest here made every context change (that is, every
 * source edit) invalidate all 131 jobs. See SPEED-02. */
/* A finished job's own record must verify, dependencies included; the verdict
 * comes from the one implementation in cxlib.sourcepackage. */
static int verify_job_verdict(const char *id,int depth){(void)depth;return sp_job_verified(id);}
static void verify_job(const char *id,int depth){if(verify_job_verdict(id,depth))die("job-not-verified");}
static int trace_off(void){const char *o=getenv("UNISACC_TRACE");return o&&!strcmp(o,"0");}
static void dependencies_only(SpJob j){if(trace_off()||j.tool>=0)return;char name[160];snprintf(name,sizeof name,"tool-%s",tools[j.phase]);verify_job(name,0);if(j.phase){snprintf(name,sizeof name,"%s-%s",j.phase==1?"gen":"tbl",recipes[j.recipe].id);verify_job(name,0);}}
static np_buf dependency_observation(SpJob j){np_buf b={0};np_puts(&b,"source-package-job-dependencies-v1\n");if(j.tool<0){char name[160];snprintf(name,sizeof name,"tool-%s",tools[j.phase]);dependency(&b,name,0);if(j.phase){snprintf(name,sizeof name,"%s-%s",j.phase==1?"gen":"tbl",recipes[j.recipe].id);dependency(&b,name,0);}}return b;}
static void run_job(const char *id){SpJob j=find_job(id);check_context_live();char before[65];strcpy(before,context_sha);dependencies_only(j);np_buf dependencies_before=dependency_observation(j);char dir[4400],out[4400],receipt[4400];job_paths(id,j,dir,out,receipt);absent(dir);if(mkdir(dir,0700))die("new-job-directory");char *v[20],exe[4400],src[4400],inc[4400],dep[4400],evidence[4400];job_command(id,j,v,out,exe,src,inc,dep);absent(out);path(evidence,dir,"command");np_result r=command(v,40,evidence);int rc=r.rc;{const char *off=getenv("UNISACC_TRACE");if(!(off&&!strcmp(off,"0")))reads_install(evidence,dir);}if(r.outn)fwrite(r.out,1,r.outn,stdout);if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);if(rc)die("actual-job-command-failed-partial-retained");check_context_live();if(!tx_eqz(before, context_sha))die("source-or-context-changed-during-job");dependencies_only(j);np_buf dependencies_after=dependency_observation(j);if(dependencies_before.n!=dependencies_after.n||memcmp(dependencies_before.p,dependencies_after.p,dependencies_before.n))die("transitive-job-inputs-changed");free(dependencies_before.p);free(dependencies_after.p);np_buf b=sp_job_record(id,j,0,0);write_new(receipt,b.p,b.n);free(b.p);verify_job(id,0);printf("PREPARED\tsource-package-job-v1\t%s\tno-test-result\n",id);}
static void list_jobs(void){puts("JOB\tSTATE\tDEPENDENCIES\tCHILD_BOUND\tOUTPUT");for(int i=0;i<5;i++)printf("tool-%s\tIMPLEMENTED_DRAFT_NOT_RUN\tcontext+CC+seed/%s.c+transitive-source-SID\t40\tresult.exe\n",tools[i],tools[i]);for(int i=0;i<(int)(sizeof recipes/sizeof *recipes);i++){printf("gen-%s\tIMPLEMENTED_DRAFT_NOT_RUN\ttool-gen+source-SID\t40\tresult.json\n",recipes[i].id);printf("tbl-%s\tIMPLEMENTED_DRAFT_NOT_RUN\ttool-tbl+gen-%s\t40\tresult.tbl\n",recipes[i].id,recipes[i].id);printf("net-%s\tIMPLEMENTED_DRAFT_NOT_RUN\ttool-net+tbl-%s\t40\tresult.net\n",recipes[i].id,recipes[i].id);}const char *targets[]={"lnx-arm64","lnx-x86_64","osx-arm64","osx-x86_64","win-arm64","win-x86_64"};for(int i=0;i<6;i++)printf("route-%s\tPLANNED_NOT_READY\tshared+target-net+image-stages.tsv\tUNMEASURED\troute.tsv\n",targets[i]);puts("declare-package\tPLANNED_NOT_READY\ttool-compilerpack+all-routes+15-extra-nets+declared-kernels\t40\troutes/predefines/audit");puts("pack\tPLANNED_NOT_READY\ttool-pack+declaration+headers+declared-kernels+zlib\t40\tcompiler.pkg");puts("seal\tPLANNED_NOT_READY\tall-job-receipts+kernel-context+fresh-source-endpoints\tUNMEASURED\tpackage.tsv+model-inputs.tsv(source-package-v1)");puts("NOT_CLAIMED\tcomplete-P3-material-functional-PASS-hermetic-hostdeps-zero-Python-chain-or-N22");}
/* Content-addressed job reuse. A finished job records, in its own directory,
 * everything that decides its bytes: the context digest, the source SID, the
 * exact argv, the observed seed source, and the sha of every transitive input
 * (dependencies.before.tsv), plus the sha of its own output. If a fresh
 * observation reproduces all of them and verify_job accepts the record, the
 * job's bytes cannot differ from what is already on disk, so running it again
 * would only burn wall clock. Nothing is trusted from the old record alone:
 * every dependency and the output are re-hashed here, and verify_job re-derives
 * the whole record and compares it. Exit 0 = reusable, 1 = must run. */
/* Batch reuse: read a newline-separated job-id list, then decide all of them in
 * one process. BATCH_MISSES counts the MISSes for the caller's exit code. */
/* Batch reuse: one process, one context verification, then every job decided
 * by the same reuse_verdict the single-job entry uses. Reads are still hashed
 * in full; sp_observe memoises a path within this process. */
static int batch_misses;
static void reuse_batch(const char *r,const char *c,const char *listpath){
 size_t n,at=0;char *s;int fd,count=0,hit=0,miss=0;
 char ids[1024][128];
 setup(r,c);
 fd=open(listpath,O_RDONLY|O_NOFOLLOW|O_CLOEXEC);
 if(fd<0)die("id-list-open");
 { struct stat st;if(fstat(fd,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>1048576)die("id-list-shape");n=(size_t)st.st_size; }
 s=malloc(n+1);
 if(!s)die("allocation");
 while(at<n){ssize_t z=read(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("id-list-read");at+=(size_t)z;}
 close(fd);s[n]=0;
 check_context_live();
 at=0;
 while(at<n&&count<1024){
  const char *a=s+at,*e;size_t z;
  while(at<n&&s[at]!='\n')at++;
  e=s+at;z=(size_t)(e-a);
  if(z){if(z>=sizeof ids[0])die("id-bound");memcpy(ids[count],a,z);ids[count][z]=0;count++;}
  if(at<n)at++;
 }
 free(s);
 for(int i=0;i<count;i++){
  if(reuse_verdict(ids[i]))miss++;else hit++;
 }
 printf("REUSE_BATCH\tjobs=%d\thit=%d\tmiss=%d\n",count,hit,miss);
 batch_misses=miss;
}
static int reuse_verdict(const char *id){SpJob j=find_job(id);char dir[4400],out[4400],receipt[4400],p[4400];
 job_paths(id,j,dir,out,receipt);
 struct stat st;errno=0;
 if(lstat(dir,&st)||!S_ISDIR(st.st_mode)){printf("REUSE\tmiss\t%s\tno-job-directory\n",id);return 1;}
 errno=0;if(lstat(receipt,&st)||!S_ISREG(st.st_mode)){printf("REUSE\tmiss\t%s\tno-record\n",id);return 1;}
 path(p,dir,"dependencies.before.tsv");
 np_buf before=dependency_observation(j);
 size_t n;char *s=load(p,&n);
 int same=n==before.n&&!memcmp(s,before.p,n);
 free(s);free(before.p);
 if(!same){printf("REUSE\tmiss\t%s\ttransitive-inputs-changed\n",id);return 1;}
 { char rp[4400];struct stat st;path(rp,dir,"job-reads.before.tsv");
   errno=0;
   if(lstat(rp,&st)||!S_ISREG(st.st_mode)){printf("REUSE\tmiss\t%s\tno-reads-record\n",id);return 1;} }
 /* The receipt and every ancestor it depends on are re-derived here: any
    difference is a MISS (run the job again), never an error exit. */
 { int verdict=sp_job_verified(id);
   if(verdict==1){printf("REUSE\tmiss\t%s\treads-or-record-changed\n",id);return 1;}
   if(verdict==2){printf("REUSE\tmiss\t%s\tdep=%s\n",id,sp_verify_dep_name()[0]?sp_verify_dep_name():"?");return 1;}
   if(verdict){printf("REUSE\tmiss\t%s\tunverified-%d\n",id,verdict);return 1;} }
 printf("REUSE\thit\t%s\tverified\n",id);
 return 0;
}
static int reuse_job(const char *id){check_context_live();return reuse_verdict(id);}
static void start_job(const char *id){
 SpJob j=find_job(id);check_context_live();dependencies_only(j);
 np_buf before=dependency_observation(j);char dir[4400],out[4400],receipt[4400],evidence[4400];
 job_paths(id,j,dir,out,receipt);absent(dir);if(mkdir(dir,0700))die("new-job-directory");
 path(evidence,dir,"dependencies.before.tsv");write_new(evidence,before.p,before.n);free(before.p);
 char *v[20],exe[4400],src[4400],inc[4400],dep[4400];job_command(id,j,v,out,exe,src,inc,dep);
 absent(out);path(evidence,dir,"command");np_result r=command(v,40,evidence);{const char *off=getenv("UNISACC_TRACE");if(!(off&&!strcmp(off,"0")))reads_install(evidence,dir);}
 int rc=r.rc;if(r.outn)fwrite(r.out,1,r.outn,stdout);if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);
 if(rc)die("actual-job-command-failed-partial-retained");
 puts("PREPARED\tsource-package-job-command-v1\tactual-rc0-finish-required\tno-test-result");
}
static void finish_job(const char *id){
 SpJob j=find_job(id);check_context_live();char before_context[65];strcpy(before_context,context_sha);
 dependencies_only(j);char dir[4400],out[4400],receipt[4400],p[4400];job_paths(id,j,dir,out,receipt);
 canonical(dir);absent(receipt);path(p,dir,"dependencies.before.tsv");
 np_buf before=dependency_observation(j);equal(p,&before);
 np_buf record=sp_job_record(id,j,0,0);check_context_live();if(!tx_eqz(before_context, context_sha))die("source-or-context-changed-during-finish");
 np_buf after=dependency_observation(j);if(before.n!=after.n||memcmp(before.p,after.p,before.n))die("transitive-job-inputs-changed");
 free(before.p);free(after.p);write_new(receipt,record.p,record.n);free(record.p);if(!trace_off())verify_job(id,0);
 printf("PREPARED\tsource-package-job-v1\t%s\tactual-split-command-and-finish\tno-test-result\n",id);
}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN source-package foundation requires Linux/x86_64\n",stderr);return 3;
#endif
 if(sizeof(long)!=8||sizeof(void *)!=8)die("LP64-process-required");
 if(argc==5&&tx_eqz(argv[1], "reuse-job")){setup(argv[2],argv[3]);return reuse_job(argv[4]);}
 if(argc==5&&tx_eqz(argv[1], "reuse-batch")){reuse_batch(argv[2],argv[3],argv[4]);return batch_misses?1:0;}

 if(argc==6&&tx_eqz(argv[1], "prepare-context")){setup(argv[2],argv[5]);prepare_context(argv[3],argv[4]);return 0;}
 if(argc==4&&(tx_eqz(argv[1], "--list")||tx_eqz(argv[1], "--verify-context"))){setup(argv[2],argv[3]);check_context_live();char before[65];strcpy(before,context_sha);if(tx_eqz(argv[1], "--list"))list_jobs();check_context_live();if(!tx_eqz(before, context_sha))die("context-changed-during-readonly-verification");if(tx_eqz(argv[1], "--verify-context"))puts("VERIFIED\tsource-package-context-v2\tcontext-only-no-package-no-test-result");return 0;}
 if(argc==5&&tx_eqz(argv[1], "job")){setup(argv[2],argv[3]);run_job(argv[4]);return 0;}
 if(argc==5&&tx_eqz(argv[1], "start-job")){setup(argv[2],argv[3]);start_job(argv[4]);return 0;}
 if(argc==5&&tx_eqz(argv[1], "finish-job")){setup(argv[2],argv[3]);finish_job(argv[4]);return 0;}
 if((argc==5&&tx_eqz(argv[1], "pack"))||(argc==4&&tx_eqz(argv[1], "--verify"))){fputs("NOT_READY source-package-v1 routes/declaration/pack/seal/full-package-verifier not implemented; no package receipts emitted\n",stderr);return 3;}
 die("usage prepare-context ROOT SAVED_BOOTSTRAP ABS_CC NEW_CTX | --list ROOT CTX | --verify-context ROOT CTX | job ROOT CTX JOB_ID | pack ROOT CTX KERNEL_GENERATION | --verify ROOT CTX");return 2;
}
