/* Independent source-P3 construction foundation, not P7 package refresh.
 * prepare-context ROOT SAVED_BOOTSTRAP /absolute/CC NEW_ABS_CONTEXT
 * --list ROOT CONTEXT | --verify-context ROOT CONTEXT
 * job ROOT CONTEXT JOB_ID
 * pack ROOT CONTEXT KERNEL_GENERATION | --verify ROOT CONTEXT: NOT_READY.
 * Caller bound55. A job is ONE native C command bound40; fresh native full-SID
 * observations bound6 before/after give52 explicit seconds, not a timing promise.
 * prepare-context: bootstrap SID8 + CC version2 + ident compile15 + native SID6.
 * No shell/Python algorithm, legacy aggregation, NN training or saved PASS.
 * The initial SID and this controller's compiler bootstrap remain trusted.
 * CC/system headers/linker/libraries/zlib are declared nonhermetic host inputs.
 * Full source observations still read existing .py/weight files as input bytes.
 * Planned routes/declaration/pack/sealing must be implemented and actually run
 * before any source-package-v1 package.tsv/model-inputs.tsv may be emitted.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.kernelsha
#pragma unisa use text.text
typedef struct {const char *id,*stage,*flags[4];} SpModel;
static const SpModel recipes[]={
 {"shared-e2","pp",{"--shared-predefines",0}},
 {"shared-e1","lex",{"--typed",0}}, {"shared-e3","parse2",{0}},
 {"shared-e4","opt",{"--o2",0}}, {"shared-o1","opt",{0}},
 {"shared-prune","prune",{0}}, {"shared-nativeabi","nativeabi",{0}},
 {"lnx-arm64-lower","lower",{"--full","--arm64",0}},
 {"lnx-arm64-elf","enc/arm",{"--elf",0}},
 {"lnx-x86_64-lower","lower",{"--full",0}},
 {"lnx-x86_64-elf","enc",{"--elf",0}},
 {"osx-arm64-lower","lower",{"--full","--osx","--arm64",0}},
 {"osx-arm64-elf","enc/arm",{"--macho",0}},
 {"osx-x86_64-lower","lower",{"--full","--osx",0}},
 {"osx-x86_64-elf","enc",{"--macho",0}},
 {"win-arm64-lower","lower",{"--full","--win","--arm64",0}},
 {"win-arm64-elf","enc/arm",{"--pe",0}},
 {"win-x86_64-lower","lower",{"--full","--win",0}},
 {"win-x86_64-elf","enc",{"--pe",0}},
 {"warnparse","parse2",{"--warnings","--errors",0}},
 {"errorparse","parse2",{"--errors",0}},
 {"warnunits","parse2/units",{"--locations",0}},
 {"warnlex","lex",{"--locations",0}}, {"tokenlex","lex",{0}},
 {"tokenpp","pp",{"--shared-predefines","--no-autoinc",0}},
 {"warnpp-shared","pp",{"--locations","--shared-predefines",0}},
 {"object-lower-arm64","lower",{"--full","--object","--arm64",0}},
 {"object-lower-x86_64","lower",{"--full","--object",0}},
 {"object-enc-arm64","enc/arm",{"--object",0}},
 {"object-enc-x86_64","enc",{"--object",0}},
 {"object-lower-osx-x86_64","lower",{"--full","--object","--osx",0}},
 {"object-lower-osx-arm64","lower",{"--full","--object","--osx","--arm64"}},
 {"object-lower-win-x86_64","lower",{"--full","--object","--win",0}},
 {"object-lower-win-arm64","lower",{"--full","--object","--win","--arm64"}},
 {"object-enc-osx-x86_64","enc/unitcontainer-osx-x86_64",{"--object",0}},
 {"object-enc-osx-arm64","enc/unitcontainer-osx-arm64",{"--object",0}},
 {"object-enc-win-x86_64","enc/unitcontainer-win-x86_64",{"--object",0}},
 {"object-enc-win-arm64","enc/unitcontainer-win-arm64",{"--object",0}},
 {"tapecheck","tapecheck",{0}}, {"hostsymbols","lower/hostsymbols",{0}},
 {"librarycontract","librarycontract/gen",{0}},
 {"librarypartition","librarypartition/gen",{0}}
};
static const char *tools[]={"gen","tbl","net","compilerpack","pack"};
static char root[4096],ctx[4096],bootstrap[4096],cc[4096],self[4096],product[4400],bound[4400],ident[4400],helper[4400],netpack[4400],bound_c[4400],jobs[4400];
static char sid[65],context_sha[65],cc_sha[65],cc_version_sha[65],helper_sha[65],bootstrap_sha[65],product_sha[65],self_sha[65],netpack_sha[65],bound_sha[65],bound_c_sha[65],ident_sha[65];
static const char *ident_flags="-std=c99 -D_POSIX_C_SOURCE=200809L -O2 -w";
static const char *environment_policy="raw-environ-remove-SEED_GEN_GENERIC-SEED_GEN_TRACE-UNISACC_SEED_TRACE-UNISACC_RF_CAPTURE-UNISA_ATTRIBUTES-v1";
static char **owned_environment;
static void die(const char *s){fprintf(stderr,"source-package: REFUSE %s errno=%d\n",s,errno);exit(2);}
/* Match np_run's proven direct environ handoff. getenv/unsetenv may consult
 * image-private state that does not reach execvp; an empty value also changes
 * seed-gen's getenv-presence branch. Delete complete NAME=value entries. */
static int forbidden_environment(const char *s){const char *keys[]={"SEED_GEN_GENERIC","SEED_GEN_TRACE","UNISACC_SEED_TRACE","UNISACC_RF_CAPTURE","UNISA_ATTRIBUTES"};for(int i=0;i<5;i++){size_t n=strlen(keys[i]);if(!strncmp(s,keys[i],n)&&s[n]=='=')return 1;}return 0;}
static void clean_environment(void){size_t n=0;for(char **p=environ;*p;p++)n++;if(n>1048576)die("environment-entry-bound");char **next=malloc((n+1)*sizeof *next);if(!next)die("allocation");size_t at=0;for(char **p=environ;*p;p++)if(!forbidden_environment(*p))next[at++]=*p;next[at]=0;char **old=owned_environment;environ=next;owned_environment=next;free(old);for(char **p=environ;*p;p++)if(forbidden_environment(*p))die("environment-policy-not-applied-to-raw-environ");}
static void path(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path-bound");}
static void clean(const char *p){if(!p[0]||strpbrk(p,"\r\n\t"))die("unclean-path");}
static void canonical(const char *p){char actual[4400];clean(p);if(p[0]!='/'||!realpath(p,actual)||!tx_eq(p, actual, 1L << 20))die("canonical-input-path-required");}
static char *load(const char *p,size_t *n){struct stat a,b;errno=0;if(lstat(p,&a))die(errno==ENOENT?"input-absent":"input-stat");if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>134217728)die("bounded-regular-input");int fd=open(p,O_RDONLY|O_NOFOLLOW|O_NONBLOCK|O_CLOEXEC);if(fd<0||fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size)die("input-descriptor");*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s)die("allocation");size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("input-extent");at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int bad=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(z||bad||closed)die("input-changed-or-close");s[*n]=0;return s;}
/* The consumer already declares this hybrid provider. Keep every observation
 * and byte comparison; only the implementation of SHA-256 changes. */
static void digest(const char *p,char h[65]){size_t n;char *s=load(p,&n);if(n>=1024){int rc=ks_sha256_hex(s,n,h);if(rc){fprintf(stderr,"source-package: kernel-sha256 rc=%d on %s\n",rc,p);die("digest-provider-failure");}}else cx_sha256_hex(s,n,h);free(s);}
static void absent(const char *p){struct stat st;errno=0;if(!lstat(p,&st)||errno!=ENOENT)die("exclusive-output-required");}
static void write_new(const char *p,const char *s,size_t n){int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive-record");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("record-write");at+=(size_t)z;}int synced=fsync(fd),closed=close(fd);if(synced||closed)die("record-close");}
static void row(np_buf *b,const char *k,const char *v){np_puts(b,k);np_puts(b,"\t");np_puts(b,v);np_puts(b,"\n");}
static void equal(const char *p,const np_buf *expected){size_t n;char *s=load(p,&n);int ok=n==expected->n&&!memcmp(s,expected->p,n);free(s);if(!ok)die("receipt-bytes-mismatch");}
static void optional_digest(const char *artifact,char out[65]){char p[4600];int n=snprintf(p,sizeof p,"%s.build.json",artifact);if(n<0||(size_t)n>=sizeof p)die("metadata-path");struct stat st;errno=0;if(lstat(p,&st)){if(errno!=ENOENT)die("metadata-stat");strcpy(out,"ABSENT");return;}digest(p,out);}
static int root_epoch_hex_n(const char *s,size_t n){if(strlen(s)!=n)return 0;for(size_t i=0;i<n;i++)if(!((s[i]>='0'&&s[i]<='9')||(s[i]>='a'&&s[i]<='f')))return 0;return 1;}
static int root_epoch_hex64(const char *s){return root_epoch_hex_n(s,64);}
static int json_string(const char *s,const char *key,char *out,size_t cap,int optional){char needle[120];int z=snprintf(needle,sizeof needle,"\n  \"%s\": \"",key);if(z<0||(size_t)z>=sizeof needle)die("root-epoch-json-key");const char *a=strstr(s,needle);if(!a)return optional?0:-1;if(strstr(a+1,needle))return -1;a+=strlen(needle);const char *e=strchr(a,'"');if(!e||(size_t)(e-a)>=cap||memchr(a,'\\',(size_t)(e-a)))return -1;memcpy(out,a,(size_t)(e-a));out[e-a]=0;return 1;}
static void root_epoch_execution_record(const char *s,size_t n,const char *artifact,size_t bytes){char a[65],source[65],commit[41],native[65],expected[1200];if(!n||n>=16384||memchr(s,0,n)||memchr(s,'\r',n)||json_string(s,"artifact_sha256",a,sizeof a,0)!=1||!tx_eq(a, artifact, 1L << 20)||json_string(s,"sources_sha256",source,sizeof source,0)!=1||!root_epoch_hex64(source)||json_string(s,"commit",commit,sizeof commit,0)!=1||!root_epoch_hex_n(commit,40))die("root-epoch-record-shape");int nh=json_string(s,"native_construction_sha256",native,sizeof native,1),z;if(nh<0||(nh&&!root_epoch_hex64(native)))die("root-epoch-native-record");if(nh)z=snprintf(expected,sizeof expected,"{\n  \"artifact_sha256\": \"%s\",\n  \"bytes\": %lu,\n  \"commit\": \"%s\",\n  \"schema\": 1,\n  \"settings\": {},\n  \"sources_sha256\": \"%s\",\n  \"native_construction_sha256\": \"%s\"\n}\n",a,(unsigned long)bytes,commit,source,native);else z=snprintf(expected,sizeof expected,"{\n  \"artifact_sha256\": \"%s\",\n  \"bytes\": %lu,\n  \"commit\": \"%s\",\n  \"schema\": 1,\n  \"settings\": {},\n  \"sources_sha256\": \"%s\"\n}\n",a,(unsigned long)bytes,commit,source);if(z<0||(size_t)z!=n||memcmp(expected,s,n))die("root-epoch-record-canonical");}
static void freeze_root_epoch_record(void){char live[4600],frozen[4400];int n=snprintf(live,sizeof live,"%s.build.json",product);if(n<0||(size_t)n>=sizeof live)die("live-root-record-path");path(frozen,ctx,"root-epoch.build.json");absent(frozen);struct stat st;if(lstat(product,&st)||!S_ISREG(st.st_mode)||st.st_size<0)die("root-epoch-product-stat");size_t zn;char *s=load(live,&zn);if(!zn)die("live-root-record-empty");root_epoch_execution_record(s,zn,product_sha,(size_t)st.st_size);write_new(frozen,s,zn);free(s);}
static void live_root_epoch_bind(void){char frozen[4400],live[4600],fs[65],ls[65];path(frozen,ctx,"root-epoch.build.json");int n=snprintf(live,sizeof live,"%s.build.json",product);if(n<0||(size_t)n>=sizeof live)die("live-root-record-path");struct stat st;if(lstat(product,&st)||!S_ISREG(st.st_mode)||st.st_size<0)die("root-epoch-product-stat");size_t bytes=(size_t)st.st_size,fn,ln;char *fb=load(frozen,&fn),*lb=load(live,&ln);root_epoch_execution_record(fb,fn,product_sha,bytes);root_epoch_execution_record(lb,ln,product_sha,bytes);if(json_string(fb,"sources_sha256",fs,sizeof fs,0)!=1||json_string(lb,"sources_sha256",ls,sizeof ls,0)!=1||!tx_eq(fs, ls, 1L << 20)){free(fb);free(lb);die("live-root-record-artifact-or-source-mismatch");}free(fb);free(lb);}
static void setup(const char *r,const char *c){if(!realpath(r,root))die("root-realpath");clean(root);clean(c);if(c[0]!='/'||strlen(c)>=sizeof ctx)die("absolute-context-required");strcpy(ctx,c);path(product,root,"unisacc.com");path(bound,root,"tools/bound");path(bound_c,root,"tools/bound.c");path(ident,root,"seed/ident.c");path(helper,ctx,"identity-helper");path(netpack,root,"tools/cxlib/netpack.cx");path(jobs,ctx,"jobs");if(!realpath(__FILE__,self))die("self-realpath");char expected[4400],actual[65];path(expected,root,"tools/source-package.cx");digest(self,self_sha);digest(expected,actual);if(!tx_eq(self_sha, actual, 1L << 20))die("controller-not-root-source");}
static np_result command(char **v,int secs,const char *evidence){np_buf b={0};for(int i=0;v[i];i++){clean(v[i]);char key[32];snprintf(key,sizeof key,"arg-%d",i);row(&b,key,v[i]);}char p[4600];int n=snprintf(p,sizeof p,"%s.argv.tsv",evidence);if(n<0||(size_t)n>=sizeof p)die("evidence-path");write_new(p,b.p,b.n);free(b.p);clean_environment();np_result r;char why[1024];if(np_run(v,root,0,secs+2,&r,why,sizeof why)){snprintf(p,sizeof p,"%s.error",evidence);write_new(p,why,strlen(why));snprintf(p,sizeof p,"%s.status",evidence);const char *s="rc\tUNAVAILABLE\n";write_new(p,s,strlen(s));die(why);}snprintf(p,sizeof p,"%s.stdout",evidence);write_new(p,r.out,r.outn);snprintf(p,sizeof p,"%s.stderr",evidence);write_new(p,r.err,r.errn);char status[40];n=snprintf(status,sizeof status,"rc\t%d\n",r.rc);snprintf(p,sizeof p,"%s.status",evidence);write_new(p,status,(size_t)n);return r;}
static void measure(char out[65],int initial,const char *evidence){char *v[9];int n=0;v[n++]=bound;v[n++]=initial?"8":"6";if(initial){v[n++]="sh";v[n++]=bootstrap;v[n++]=ident;v[n++]="--";}else v[n++]=helper;v[n++]=root;v[n]=0;np_result r;if(evidence)r=command(v,initial?8:6,evidence);else{char why[1024];clean_environment();if(np_run(v,root,0,initial?10:8,&r,why,sizeof why))die(why);}int ok=!r.rc&&!r.errn&&r.outn==65&&r.out[64]=='\n';if(ok){memcpy(out,r.out,64);out[64]=0;for(int i=0;i<64;i++)if(!((out[i]>='0'&&out[i]<='9')||(out[i]>='a'&&out[i]<='f')))ok=0;}if(!ok&&r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);if(!ok)die("fresh-full-source-measurement");}
static void observe_inputs(void){digest(cc,cc_sha);digest(helper,helper_sha);digest(bootstrap,bootstrap_sha);digest(product,product_sha);digest(self,self_sha);digest(netpack,netpack_sha);digest(bound,bound_sha);digest(bound_c,bound_c_sha);digest(ident,ident_sha);char p[4400];path(p,ctx,"cc.version");digest(p,cc_version_sha);}
static np_buf context_record(void){clean_environment();np_buf b={0};np_puts(&b,"source-package-context-v2\n");row(&b,"status","PREPARED_CONTEXT_ONLY");row(&b,"environment-policy",environment_policy);row(&b,"root",root);row(&b,"context",ctx);row(&b,"source",sid);row(&b,"bootstrap",bootstrap);row(&b,"bootstrap-sha",bootstrap_sha);char h[65];optional_digest(bootstrap,h);row(&b,"bootstrap-build-record-sha",h);row(&b,"root-product-sha",product_sha);{char frozen[4400];path(frozen,ctx,"root-epoch.build.json");digest(frozen,h);row(&b,"root-build-record-sha",h);row(&b,"root-epoch-record-path",frozen);}row(&b,"cc",cc);row(&b,"cc-sha",cc_sha);row(&b,"cc-version-sha",cc_version_sha);row(&b,"identity-helper",helper_sha);row(&b,"identity-source",ident_sha);row(&b,"identity-flags",ident_flags);row(&b,"controller",self_sha);row(&b,"netpack",netpack_sha);row(&b,"bound",bound_sha);row(&b,"bound.c",bound_c_sha);row(&b,"host-process","Linux/x86_64-LP64");row(&b,"host-dependencies","CC-subtools-system-headers-linker-libraries-and-zlib-DECLARED-NOT-HERMETICALLY-HASHED");row(&b,"reference-executable","NOT-INVOKED-by-native-seed-C-APIs");row(&b,"scope","root-assisted-initial-source-observation;bootstrap-trusted;no-test-result;no-complete-N22-or-zero-Python-chain-claim");return b;}
/* Extract paths only; reconstruct and exact-compare all context bytes using
 * fresh observations before trusting any previously completed job receipt. */
static void extract_path(const char *s,const char *key,char *dest,size_t cap){char needle[80];int z=snprintf(needle,sizeof needle,"\n%s\t",key);if(z<0||(size_t)z>=sizeof needle)die("context-key");const char *a=strstr(s,needle);if(!a||strstr(a+1,needle))die("unique-context-path");a+=strlen(needle);const char *e=strchr(a,'\n');if(!e||e==a||(size_t)(e-a)>=cap)die("context-path-bound");memcpy(dest,a,(size_t)(e-a));dest[e-a]=0;canonical(dest);}
static void check_context(void){canonical(ctx);char p[4400];path(p,ctx,"context.tsv");size_t n;char *s=load(p,&n);if(!n||s[n-1]!='\n'||memchr(s,0,n)||memchr(s,'\r',n))die("context-wire");extract_path(s,"cc",cc,sizeof cc);extract_path(s,"bootstrap",bootstrap,sizeof bootstrap);free(s);observe_inputs();measure(sid,0,0);np_buf expected=context_record();equal(p,&expected);cx_sha256_hex(expected.p,expected.n,context_sha);free(expected.p);live_root_epoch_bind();}
static void prepare_context(const char *bootstrap_arg,const char *cc_arg){if(!realpath(bootstrap_arg,bootstrap)||!realpath(cc_arg,cc)||bootstrap_arg[0]!='/'||cc_arg[0]!='/')die("absolute-bootstrap-and-CC-required");canonical(bootstrap);canonical(cc);char initial_s[65],initial_cc[65],initial_bootstrap[65],initial_product[65],initial_ident[65],initial_self[65],initial_netpack[65],initial_bound[65],initial_bound_c[65],p[4400];digest(cc,initial_cc);digest(bootstrap,initial_bootstrap);digest(product,initial_product);digest(ident,initial_ident);digest(self,initial_self);digest(netpack,initial_netpack);digest(bound,initial_bound);digest(bound_c,initial_bound_c);if(mkdir(ctx,0700))die("new-context-required");canonical(ctx);if(mkdir(jobs,0700))die("new-jobs-directory");path(p,ctx,"initial-source");measure(initial_s,1,p);path(p,ctx,"CC-version");char *version[]={bound,"2",cc,"--version",0};np_result r=command(version,2,p);if(r.rc||!r.outn||r.outn>65536)die("CC-version-failed");path(p,ctx,"cc.version");write_new(p,r.out,r.outn);np_free(&r);path(p,ctx,"compile-ident");char *v[]={bound,"15",cc,"-std=c99","-D_POSIX_C_SOURCE=200809L","-O2","-w",ident,"-o",helper,0};absent(helper);r=command(v,15,p);int rc=r.rc;if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);if(rc)die("identity-helper-compile-failed");observe_inputs();path(p,ctx,"native-source-after");measure(sid,0,p);if(!tx_eq(sid, initial_s, 1L << 20)||!tx_eq(cc_sha, initial_cc, 1L << 20)||!tx_eq(bootstrap_sha, initial_bootstrap, 1L << 20)||!tx_eq(product_sha, initial_product, 1L << 20)||!tx_eq(ident_sha, initial_ident, 1L << 20)||!tx_eq(self_sha, initial_self, 1L << 20)||!tx_eq(netpack_sha, initial_netpack, 1L << 20)||!tx_eq(bound_sha, initial_bound, 1L << 20)||!tx_eq(bound_c_sha, initial_bound_c, 1L << 20))die("context-inputs-changed");freeze_root_epoch_record();np_buf b=context_record();path(p,ctx,"context.tsv");write_new(p,b.p,b.n);free(b.p);live_root_epoch_bind();puts("PREPARED\tsource-package-context-v2\tcontext-only-no-package-no-test-result");}
typedef struct {int tool,recipe,phase;} SpJob;
static SpJob find_job(const char *id){SpJob j={-1,-1,-1};for(int i=0;i<5;i++){char name[80];snprintf(name,sizeof name,"tool-%s",tools[i]);if(tx_eq(id, name, 1L << 20)){j.tool=i;return j;}}const char *phases[]={"gen-","tbl-","net-"};for(int p=0;p<3;p++)for(int m=0;m<(int)(sizeof recipes/sizeof *recipes);m++){char name[160];snprintf(name,sizeof name,"%s%s",phases[p],recipes[m].id);if(tx_eq(id, name, 1L << 20)){j.recipe=m;j.phase=p;return j;}}die("unknown-or-PLANNED-job");return j;}
static void job_paths(const char *id,SpJob j,char dir[4400],char output[4400],char receipt[4400]){path(dir,jobs,id);path(output,dir,j.tool>=0?"result.exe":j.phase==0?"result.json":j.phase==1?"result.tbl":"result.net");path(receipt,dir,"record.tsv");}
static int job_command(const char *id,SpJob j,char **v,char output[4400],char executable[4400],char source[4400],char include[4400],char dependency[4400]){char dir[4400],receipt[4400];job_paths(id,j,dir,output,receipt);int n=0;v[n++]=bound;v[n++]="40";
 if(j.tool>=0){v[n++]=cc;v[n++]="-std=c99";v[n++]="-O2";v[n++]="-w";path(include,root,"seed");v[n++]="-I";v[n++]=include;if(j.tool==4){v[n++]="-I";v[n++]="/usr/include/node";}char name[100];snprintf(name,sizeof name,"seed/%s.c",tools[j.tool]);path(source,root,name);v[n++]=source;v[n++]="-o";v[n++]=output;if(j.tool==4)v[n++]="/usr/lib/x86_64-linux-gnu/libz.so.1.2.11";}
 else{char name[160],tool_dir[4400];snprintf(name,sizeof name,"tool-%s",tools[j.phase]);path(tool_dir,jobs,name);path(executable,tool_dir,"result.exe");v[n++]=executable;if(!j.phase){v[n++]=(char *)recipes[j.recipe].stage;v[n++]=output;for(int i=0;i<4&&recipes[j.recipe].flags[i];i++)v[n++]=(char *)recipes[j.recipe].flags[i];}else{snprintf(name,sizeof name,"%s-%s",j.phase==1?"gen":"tbl",recipes[j.recipe].id);SpJob dj=find_job(name);char dd[4400],dr[4400];job_paths(name,dj,dd,dependency,dr);v[n++]=dependency;v[n++]=output;}}
 v[n]=0;return n;
}
static void verify_job(const char *id,int depth);
static void dependency(np_buf *b,const char *id,int depth){verify_job(id,depth+1);SpJob j=find_job(id);char dir[4400],out[4400],receipt[4400],h[65];job_paths(id,j,dir,out,receipt);digest(receipt,h);row(b,id,h);digest(out,h);row(b,out,h);}
static np_buf job_record(const char *id,SpJob j,int depth){clean_environment();np_buf b={0};np_puts(&b,"source-package-job-v1\n");row(&b,"status","PREPARED-no-test-result");row(&b,"environment-policy",environment_policy);row(&b,"context",context_sha);row(&b,"source",sid);row(&b,"job",id);if(j.tool<0){char name[160];snprintf(name,sizeof name,"tool-%s",tools[j.phase]);dependency(&b,name,depth);if(j.phase){snprintf(name,sizeof name,"%s-%s",j.phase==1?"gen":"tbl",recipes[j.recipe].id);dependency(&b,name,depth);}}
 char *v[20],out[4400],exe[4400],src[4400],inc[4400],dep[4400];int n=job_command(id,j,v,out,exe,src,inc,dep);np_buf argv={0};for(int i=0;i<n;i++){char key[32];snprintf(key,sizeof key,"arg-%d",i);row(&b,key,v[i]);row(&argv,key,v[i]);}char h[65],dir[4400],receipt[4400],evidence[4400];job_paths(id,j,dir,out,receipt);path(evidence,dir,"command.argv.tsv");equal(evidence,&argv);free(argv.p);np_buf success={0};np_puts(&success,"rc\t0\n");path(evidence,dir,"command.status");equal(evidence,&success);free(success.p);const char *logs[]={"command.argv.tsv","command.stdout","command.stderr","command.status"};for(int i=0;i<4;i++){path(evidence,dir,logs[i]);digest(evidence,h);row(&b,logs[i],h);}if(j.tool>=0){digest(src,h);row(&b,"actual-seed-source",h);}else{digest(exe,h);row(&b,"actual-native-tool",h);}size_t z;char *bytes=load(out,&z);if(!z)die("empty-job-output");if(j.tool>=0){if(z<64||memcmp(bytes,"\177ELF",4)||(unsigned char)bytes[4]!=2||(unsigned char)bytes[5]!=1||(unsigned char)bytes[18]!=62||bytes[19]||access(out,X_OK))die("native-tool-not-executable-ELF64-x86_64");}cx_sha256_hex(bytes,z,h);free(bytes);row(&b,"output",out);row(&b,"output-sha",h);return b;
}
static void verify_job(const char *id,int depth){if(depth>12)die("job-dependency-depth");SpJob j=find_job(id);char dir[4400],out[4400],receipt[4400];job_paths(id,j,dir,out,receipt);canonical(dir);np_buf b=job_record(id,j,depth);equal(receipt,&b);free(b.p);}
static void dependencies_only(SpJob j){if(j.tool>=0)return;char name[160];snprintf(name,sizeof name,"tool-%s",tools[j.phase]);verify_job(name,0);if(j.phase){snprintf(name,sizeof name,"%s-%s",j.phase==1?"gen":"tbl",recipes[j.recipe].id);verify_job(name,0);}}
static np_buf dependency_observation(SpJob j){np_buf b={0};np_puts(&b,"source-package-job-dependencies-v1\n");if(j.tool<0){char name[160];snprintf(name,sizeof name,"tool-%s",tools[j.phase]);dependency(&b,name,0);if(j.phase){snprintf(name,sizeof name,"%s-%s",j.phase==1?"gen":"tbl",recipes[j.recipe].id);dependency(&b,name,0);}}return b;}
static void run_job(const char *id){SpJob j=find_job(id);check_context();char before[65];strcpy(before,context_sha);dependencies_only(j);np_buf dependencies_before=dependency_observation(j);char dir[4400],out[4400],receipt[4400];job_paths(id,j,dir,out,receipt);absent(dir);if(mkdir(dir,0700))die("new-job-directory");char *v[20],exe[4400],src[4400],inc[4400],dep[4400],evidence[4400];job_command(id,j,v,out,exe,src,inc,dep);absent(out);path(evidence,dir,"command");np_result r=command(v,40,evidence);int rc=r.rc;if(r.outn)fwrite(r.out,1,r.outn,stdout);if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);if(rc)die("actual-job-command-failed-partial-retained");check_context();if(!tx_eq(before, context_sha, 1L << 20))die("source-or-context-changed-during-job");dependencies_only(j);np_buf dependencies_after=dependency_observation(j);if(dependencies_before.n!=dependencies_after.n||memcmp(dependencies_before.p,dependencies_after.p,dependencies_before.n))die("transitive-job-inputs-changed");free(dependencies_before.p);free(dependencies_after.p);np_buf b=job_record(id,j,0);write_new(receipt,b.p,b.n);free(b.p);verify_job(id,0);printf("PREPARED\tsource-package-job-v1\t%s\tno-test-result\n",id);}
static void list_jobs(void){puts("JOB\tSTATE\tDEPENDENCIES\tCHILD_BOUND\tOUTPUT");for(int i=0;i<5;i++)printf("tool-%s\tIMPLEMENTED_DRAFT_NOT_RUN\tcontext+CC+seed/%s.c+transitive-source-SID\t40\tresult.exe\n",tools[i],tools[i]);for(int i=0;i<(int)(sizeof recipes/sizeof *recipes);i++){printf("gen-%s\tIMPLEMENTED_DRAFT_NOT_RUN\ttool-gen+source-SID\t40\tresult.json\n",recipes[i].id);printf("tbl-%s\tIMPLEMENTED_DRAFT_NOT_RUN\ttool-tbl+gen-%s\t40\tresult.tbl\n",recipes[i].id,recipes[i].id);printf("net-%s\tIMPLEMENTED_DRAFT_NOT_RUN\ttool-net+tbl-%s\t40\tresult.net\n",recipes[i].id,recipes[i].id);}const char *targets[]={"lnx-arm64","lnx-x86_64","osx-arm64","osx-x86_64","win-arm64","win-x86_64"};for(int i=0;i<6;i++)printf("route-%s\tPLANNED_NOT_READY\tshared+target-net+image-stages.tsv\tUNMEASURED\troute.tsv\n",targets[i]);puts("declare-package\tPLANNED_NOT_READY\ttool-compilerpack+all-routes+15-extra-nets+declared-kernels\t40\troutes/predefines/audit");puts("pack\tPLANNED_NOT_READY\ttool-pack+declaration+headers+declared-kernels+zlib\t40\tcompiler.pkg");puts("seal\tPLANNED_NOT_READY\tall-job-receipts+kernel-context+fresh-source-endpoints\tUNMEASURED\tpackage.tsv+model-inputs.tsv(source-package-v1)");puts("NOT_CLAIMED\tcomplete-P3-material-functional-PASS-hermetic-hostdeps-zero-Python-chain-or-N22");}
static void start_job(const char *id){
 SpJob j=find_job(id);check_context();dependencies_only(j);
 np_buf before=dependency_observation(j);char dir[4400],out[4400],receipt[4400],evidence[4400];
 job_paths(id,j,dir,out,receipt);absent(dir);if(mkdir(dir,0700))die("new-job-directory");
 path(evidence,dir,"dependencies.before.tsv");write_new(evidence,before.p,before.n);free(before.p);
 char *v[20],exe[4400],src[4400],inc[4400],dep[4400];job_command(id,j,v,out,exe,src,inc,dep);
 absent(out);path(evidence,dir,"command");np_result r=command(v,40,evidence);
 int rc=r.rc;if(r.outn)fwrite(r.out,1,r.outn,stdout);if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);
 if(rc)die("actual-job-command-failed-partial-retained");
 puts("PREPARED\tsource-package-job-command-v1\tactual-rc0-finish-required\tno-test-result");
}
static void finish_job(const char *id){
 SpJob j=find_job(id);check_context();char before_context[65];strcpy(before_context,context_sha);
 dependencies_only(j);char dir[4400],out[4400],receipt[4400],p[4400];job_paths(id,j,dir,out,receipt);
 canonical(dir);absent(receipt);path(p,dir,"dependencies.before.tsv");
 np_buf before=dependency_observation(j);equal(p,&before);
 np_buf record=job_record(id,j,0);check_context();if(!tx_eq(before_context, context_sha, 1L << 20))die("source-or-context-changed-during-finish");
 np_buf after=dependency_observation(j);if(before.n!=after.n||memcmp(before.p,after.p,before.n))die("transitive-job-inputs-changed");
 free(before.p);free(after.p);write_new(receipt,record.p,record.n);free(record.p);verify_job(id,0);
 printf("PREPARED\tsource-package-job-v1\t%s\tactual-split-command-and-finish\tno-test-result\n",id);
}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN source-package foundation requires Linux/x86_64\n",stderr);return 3;
#endif
 if(sizeof(long)!=8||sizeof(void *)!=8)die("LP64-process-required");
 if(argc==6&&tx_eq(argv[1], "prepare-context", 1L << 20)){setup(argv[2],argv[5]);prepare_context(argv[3],argv[4]);return 0;}
 if(argc==4&&(tx_eq(argv[1], "--list", 1L << 20)||tx_eq(argv[1], "--verify-context", 1L << 20))){setup(argv[2],argv[3]);check_context();char before[65];strcpy(before,context_sha);if(tx_eq(argv[1], "--list", 1L << 20))list_jobs();check_context();if(!tx_eq(before, context_sha, 1L << 20))die("context-changed-during-readonly-verification");if(tx_eq(argv[1], "--verify-context", 1L << 20))puts("VERIFIED\tsource-package-context-v2\tcontext-only-no-package-no-test-result");return 0;}
 if(argc==5&&tx_eq(argv[1], "job", 1L << 20)){setup(argv[2],argv[3]);run_job(argv[4]);return 0;}
 if(argc==5&&tx_eq(argv[1], "start-job", 1L << 20)){setup(argv[2],argv[3]);start_job(argv[4]);return 0;}
 if(argc==5&&tx_eq(argv[1], "finish-job", 1L << 20)){setup(argv[2],argv[3]);finish_job(argv[4]);return 0;}
 if((argc==5&&tx_eq(argv[1], "pack", 1L << 20))||(argc==4&&tx_eq(argv[1], "--verify", 1L << 20))){fputs("NOT_READY source-package-v1 routes/declaration/pack/seal/full-package-verifier not implemented; no package receipts emitted\n",stderr);return 3;}
 die("usage prepare-context ROOT SAVED_BOOTSTRAP ABS_CC NEW_CTX | --list ROOT CTX | --verify-context ROOT CTX | job ROOT CTX JOB_ID | pack ROOT CTX KERNEL_GENERATION | --verify ROOT CTX");return 2;
}
