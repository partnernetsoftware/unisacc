/* tools/freeze-plan.cx -- 由 ident 导出 freeze.tsv 草案并核覆盖。
 *
 *   sh ./unisacc.com tools/freeze-plan.cx -- plan ROOT OUTDIR [--ident BIN] [--ident-list F] [--alias-list F]
 *   sh ./unisacc.com tools/freeze-plan.cx -- check --ident-list FILE --draft FILE
 *   sh ./unisacc.com tools/freeze-plan.cx -- boot-list LIST
 *   sh ./unisacc.com tools/freeze-plan.cx -- head-delta ROOT BUILD_REV
 *
 * plan/check 拒收未归类的产品输入路径(UNCLASSIFIED);head-delta 判 HEAD 领先 BUILD_REV
 * 时差集是否只含明确的非产品路径(发布按身份而非 HEAD 绑定)。
 * 流式/堆扩容读取;超上限明确报错不截断。永不写 build/freeze.tsv。
 * 前缀由计入文件目录级合并(cx/xx、ext/xx 两段,其余首段);tools/tests/plans/agentwork 永不冻结。
 */
#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use sysx.poll
#pragma unisa use sys.posix
#pragma unisa use sys.env

/* an unlinked spool file the drained output of a bounded child goes to */
static int spool_open(void) {
    char t[4096];
    int fd;
    if (cx_fmt(t, sizeof t, "%s/r2b-XXXXXX", sy_tmpdir())) return -1;
    fd = mkstemp(t);
    if (fd >= 0) sy_unlink(t);
    return fd;
}

/* sy_spawn_pipe with a 50 s deadline: the child's stdout (and stderr when EFD is given) is drained here with sy_poll
   into spool files; past the deadline its process group is killed.  OFD/EFD come back as the spool files, rewound,
   and the child is NOT reaped: the caller's sy_wait_status(pid) still reports its real status (128+9 when killed). */
static int spawn_pipe_bounded(char **argv, const char *cwd, int flags, int *ofd, int *efd) {
    int po = -1, pe = -1, pid, fo, fe = -1, open_o = 1, open_e = efd ? 1 : 0, killed = 0;
    long deadline = sy_now_ms() + 50000;
    char chunk[16384];
    pid = sy_spawn_pipe(argv, cwd, flags, &po, efd ? &pe : 0);
    if (pid < 0) return pid;
    fo = spool_open();
    if (efd) fe = spool_open();
    if (fo < 0 || (efd && fe < 0)) { sy_killpg(pid, 9); sy_signal(pid, 9); sy_close(po); if (efd) sy_close(pe); return -EIO; }
    while (open_o || open_e) {
        sy_pollfd_t p[2];
        int n = 0, io = -1, ie = -1, r;
        long left = deadline - sy_now_ms(), g;
        if (left <= 0) {
            if (killed) break;
            sy_killpg(pid, 9); sy_signal(pid, 9); killed = 1; deadline = sy_now_ms() + 2000;
            continue;
        }
        if (open_o) { io = n; p[n].fd = po; p[n].events = SY_POLLIN; p[n].revents = 0; n++; }
        if (open_e) { ie = n; p[n].fd = pe; p[n].events = SY_POLLIN; p[n].revents = 0; n++; }
        r = sy_poll(p, n, left > 200 ? 200 : left);
        if (r < 0) break;
        if (io >= 0 && p[io].revents) {
            g = sy_read(po, chunk, sizeof chunk);
            if (g > 0) { if (sy_write_all(fo, chunk, g)) break; } else open_o = 0;
        }
        if (ie >= 0 && p[ie].revents) {
            g = sy_read(pe, chunk, sizeof chunk);
            if (g > 0) { if (sy_write_all(fe, chunk, g)) break; } else open_e = 0;
        }
    }
    if (open_o || open_e) { sy_killpg(pid, 9); sy_signal(pid, 9); }
    sy_close(po);
    if (efd) sy_close(pe);
    sy_lseek(fo, 0, 0);
    *ofd = fo;
    if (efd) { sy_lseek(fe, 0, 0); *efd = fe; }
    return pid;
}

#define FP_MAX_ENT 8192
#define FP_MAX_SLURP (8 * 1024 * 1024)

static char **files; static int nfiles, capf;
static char **prefs; static int npref, capp;
static char **aliases; static int nalias, capa;

static char *intern(const char *s, long n) {
    char *p;
    if (n < 0) n = tx_len(s, 800);
    p = (char *)mm_alloc((size_t)n + 1); if (!p) return 0;
    mm_copy(p, n + 1, s, n); p[n] = 0; return p;
}
static int grow(char ***arr, int *cap, int need) {
    char **n; int c, i;
    if (need <= *cap) return 0;
    if (need > FP_MAX_ENT) { sy_eprintf("freeze-plan: too many entries (max %d), not truncated\n", FP_MAX_ENT); return 1; }
    c = *cap ? *cap * 2 : 256; while (c < need) c *= 2; if (c > FP_MAX_ENT) c = FP_MAX_ENT;
    n = (char **)mm_alloc((size_t)c * sizeof(char *)); if (!n) return 1;
    for (i = 0; i < *cap; i++) n[i] = (*arr)[i];
    *arr = n; *cap = c; return 0;
}
static int under(const char *p, const char *b) {
    long n = tx_len(b, 80);
    return tx_prefix(p, tx_len(p, 800), b, n) && (!p[n] || p[n] == '/');
}
static int never_p(const char *p) {
    return under(p, "tools") || under(p, "tests") || under(p, "plans") || under(p, "agentwork");
}
/* Product-input classification, kept in step with seed/ident.c historical_identity:
   its directories, iterate/kernel/typekw.tsv and its tools/ support files are product;
   ext/ enters through aliases; unisacc.com is the bootstrap product.  Everything else
   must be listed as non-product explicitly, otherwise the path is UNCLASSIFIED. */
static const char *const fp_product_dirs[] = {"cx", "ext", "src", "include", "seed", "kernel", "exec", "weights", 0};
static const char *const fp_product_files[] = {"iterate/kernel/typekw.tsv", "unisacc.com", // lint:allow R1-product classification table entry, never an argv
    "tools/bound", "tools/bound.c", "tools/cxbin", "tools/safedel.cx", "tools/lib.sh", "tools/build_ref.sh",
    "tools/export_ref.sh", "tools/refshim.h", "tools/reffoot.h", "tools/sourceflat.cx", "tools/ape-pack.cx",
    "tools/release-ape.cx", "tools/cxlib/releaseversion.cx", 0};
static const char *const fp_other_dirs[] = {"tools", "tests", "plans", "agentwork", "archive", "research", "docs",
    "release", "build", "bench", "examples", "apps", "ujs", "skills", "scripts", ".github", 0};
static const char *const fp_other_files[] = {"AGENTS.md", "ARCHITECTURE.md", "CLAUDE.md", "README.md", "prd.md",
    "prd_cx.md", "prd_hist.md", "prd_release.md", "spec.md", "ape-receipt.txt", ".gitignore", ".gitattributes", 0};
/* 1 product input, 0 explicitly non-product, -1 unclassified */
static int fp_class(const char *p) {
    int i;
    for (i = 0; fp_product_files[i]; i++) if (tx_eqz(p, fp_product_files[i])) return 1;
    for (i = 0; fp_product_dirs[i]; i++) if (under(p, fp_product_dirs[i])) return 1;
    for (i = 0; fp_other_dirs[i]; i++) if (under(p, fp_other_dirs[i])) return 0;
    for (i = 0; fp_other_files[i]; i++) if (tx_eqz(p, fp_other_files[i])) return 0;
    return -1;
}
/* every ident-listed (product input) file must classify as product */
static int refuse_unclassified(void) {
    int i, bad = 0;
    for (i = 0; i < nfiles; i++) if (fp_class(files[i]) != 1) { sy_printf("UNCLASSIFIED\t%s\n", files[i]); bad++; }
    if (bad) sy_eprintf("freeze-plan: UNCLASSIFIED_PRODUCT_INPUT %d path(s) are neither product nor explicitly classified\n", bad);
    return bad;
}
static int covered(const char *f, const char *pr) {
    long fl = tx_len(f, 800), pl = tx_len(pr, 200);
    if (pl <= 0) return 0;
    if (fl == pl && tx_same(f, fl, pr, pl)) return 1;
    return fl > pl && f[pl] == '/' && tx_prefix(f, fl, pr, pl);
}
static int add_pref(const char *p) {
    int i; char *q;
    if (!p || !p[0]) return 0;
    for (i = 0; i < npref; i++) if (tx_eqz(prefs[i], p)) return 0;
    if (grow(&prefs, &capp, npref + 1)) return 1;
    q = intern(p, -1); if (!q) return 1;
    prefs[npref++] = q; return 0;
}
static int add_file(const char *p) {
    int i; char *q;
    for (i = 0; i < nfiles; i++) if (tx_eqz(files[i], p)) return 0;
    if (grow(&files, &capf, nfiles + 1)) return 1;
    q = intern(p, -1); if (!q) return 1;
    files[nfiles++] = q; return 0;
}
static void dir_pref(const char *path, char *out, long cap) {
    long i, sl1 = -1, sl2 = -1, n = tx_len(path, 800);
    out[0] = 0;
    if (never_p(path)) return;
    for (i = 0; i < n; i++) if (path[i] == '/') { if (sl1 < 0) sl1 = i; else { sl2 = i; break; } }
    if (sl2 > 0) { mm_copy(out, cap, path, sl2); out[sl2] = 0; return; }
    if (sl1 > 0) { mm_copy(out, cap, path, sl1); out[sl1] = 0; return; }
    mm_copy(out, cap, path, n + 1);
}
static int parse_ident_list(const char *b, long n) {
    long at = 0;
    while (at < n) {
        long e = tx_chr(b + at, n - at, '\n'), l = e < 0 ? n - at : e, tab;
        if (l > 0 && b[at] != '#') {
            tab = tx_chr(b + at, l, '\t'); if (tab < 0) tab = l;
            if (tab > 0 && tab < 400) {
                char p[400]; mm_copy(p, 400, b + at, tab); p[tab] = 0;
                if (add_file(p)) return 1;
            }
        }
        at += l + 1;
    }
    return 0;
}
static int parse_aliases(const char *b, long n) {
    long at = 0;
    while (at < n) {
        long e = tx_chr(b + at, n - at, '\n'), l = e < 0 ? n - at : e;
        if (l > 0 && b[at] != '#') {
            long f = 0, pos = 0; const char *cols[4]; long cl[4];
            char logi[200], tgt[200], row[400], d[200];
            while (pos <= l && f < 4) {
                long t = tx_chr(b + at + pos, l - pos, '\t'), len = t < 0 ? l - pos : t;
                cols[f] = b + at + pos; cl[f] = len; f++; if (t < 0) break; pos += len + 1;
            }
            if (f >= 3) {
                if (cl[1] >= 199 || cl[2] >= 199) { sy_eprintf("freeze-plan: alias path too long, not truncated\n"); return 1; }
                mm_copy(logi, 200, cols[1], cl[1]); logi[cl[1]] = 0;
                mm_copy(tgt, 200, cols[2], cl[2]); tgt[cl[2]] = 0;
                if (cx_fmt(row, sizeof row, "%s -> %s", logi, tgt)) return 1;
                if (grow(&aliases, &capa, nalias + 1)) return 1;
                aliases[nalias] = intern(row, -1); if (!aliases[nalias]) return 1; nalias++;
                dir_pref(tgt, d, 200); if (add_pref(d)) return 1;
                dir_pref(logi, d, 200); if (add_pref(d)) return 1;
            }
        }
        at += l + 1;
    }
    return 0;
}
static int merge_prefs(void) {
    int i; char d[200];
    for (i = 0; i < nfiles; i++) { dir_pref(files[i], d, 200); if (add_pref(d)) return 1; }
    return 0;
}
static int parse_draft_paths(const char *b, long n) {
    long at = 0; char line[4000];
    npref = 0;
    while (at < n) {
        long e = tx_chr(b + at, n - at, '\n'), l = e < 0 ? n - at : e;
        if (l > 0 && b[at] != '#') {
            char *f[6]; int nf = 0; char *p;
            if (l >= (long)sizeof line) { sy_eprintf("freeze-plan: draft line too long, not truncated\n"); return 1; }
            mm_copy(line, sizeof line, b + at, l); line[l] = 0;
            f[nf++] = line;
            for (p = line; *p && nf < 6; p++) if (*p == '\t') { *p = 0; f[nf++] = p + 1; }
            if (nf != 5) { sy_eprintf("freeze-plan: draft malformed (need 5 columns)\n"); return 1; }
            for (p = f[4]; *p; ) {
                char *s = p; long pl; char pr[200];
                while (*p && *p != ' ') p++;
                pl = p - s;
                if (pl > 0 && pl < 199) { mm_copy(pr, 200, s, pl); pr[pl] = 0; if (add_pref(pr)) return 1; }
                else if (pl >= 199) { sy_eprintf("freeze-plan: prefix too long, not truncated\n"); return 1; }
                while (*p == ' ') p++;
            }
            return 0;
        }
        at += l + 1;
    }
    sy_eprintf("freeze-plan: empty draft\n"); return 1;
}
static int do_check(void) {
    int i, j, bad = 0;
    for (i = 0; i < npref; i++) if (never_p(prefs[i])) { sy_printf("WIDE\t%s\n", prefs[i]); bad++; }
    for (i = 0; i < nfiles; i++) {
        int ok = 0;
        if (never_p(files[i])) continue;
        for (j = 0; j < npref; j++) if (covered(files[i], prefs[j])) { ok = 1; break; }
        if (!ok) { sy_printf("UNCOVERED\t%s\n", files[i]); bad++; }
    }
    sy_printf("FREEZE_PLAN_CHECK\tuncovered_or_wide=%d\tfiles=%d\tprefixes=%d\n", bad, nfiles, npref);
    return bad ? 1 : 0;
}
static int boot_list(const char *path) {
    size_t n = 0; char *b = (char *)cx_read(path, &n); long at = 0; int bad = 0, rows = 0;
    if (!b) { sy_eprintf("freeze-plan: boot-list missing %s\n", path); return 1; }
    while (at < (long)n) {
        long e = tx_chr(b + at, (long)n - at, '\n'), l = e < 0 ? (long)n - at : e;
        if (l > 0 && b[at] != '#') {
            char p[400];
            if (l >= 399) { sy_eprintf("freeze-plan: boot path too long, not truncated\n"); return 1; }
            mm_copy(p, 400, b + at, l); p[l] = 0; rows++;
            if (sy_exists(p) != 1) { sy_printf("MISSING\t%s\n", p); bad++; }
        }
        at += l + 1;
    }
    sy_printf("FREEZE_BOOT_LIST\tmissing=%d\trows=%d\n", bad, rows);
    return bad ? 1 : 0;
}
static int slurp_v(char **argv, char **out, long *n) {
    int ofd, pid; long cap = 262144, r; char *b;
    *n = 0; *out = 0;
    b = (char *)mm_alloc(cap); if (!b) return 1;
    pid = spawn_pipe_bounded(argv, 0, 0, &ofd, 0);
    if (pid < 0) return 1;
    for (;;) {
        if (*n + 4096 >= cap) {
            char *nb; long nc = cap * 2;
            if (nc > FP_MAX_SLURP) { sy_eprintf("freeze-plan: ident output exceeds %d, not truncated\n", FP_MAX_SLURP); sy_close(ofd); return 1; }
            nb = (char *)mm_alloc((size_t)nc); if (!nb) { sy_close(ofd); return 1; }
            mm_copy(nb, nc, b, *n); b = nb; cap = nc;
        }
        r = sy_read(ofd, b + *n, cap - 1 - *n);
        if (r < 0) { sy_close(ofd); return 1; }
        if (r == 0) break;
        *n += r;
    }
    { int ex = 0, code = 0, sig = 0; sy_close(ofd);
      if (sy_wait_status(pid, 0, &ex, &code, &sig) != pid || !ex || code != 0) return 1; }
    b[*n] = 0; *out = b; return 0;
}

/* head-delta ROOT BUILD_REV: may a checkout whose HEAD is ahead of BUILD_REV stand for it?
   BUILD_REV must be an ancestor of HEAD and every path changed between them must classify
   as explicitly non-product.  Prints PRODUCT/UNCLASSIFIED/NONPRODUCT rows, then one
   HEAD_DELTA verdict row; exit 0 OK, 1 REFUSE, 2 transport/usage. */
static int rev40(char *b, long n, char out[41]) {
    long i;
    while (n > 0 && (b[n - 1] == '\n' || b[n - 1] == '\r')) n--;
    if (n != 40) return 1;
    for (i = 0; i < 40; i++) { char c = b[i]; if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return 1; out[i] = c; }
    out[40] = 0; return 0;
}
static int head_delta(const char *root, const char *rev) {
    char head[41], want[41], spec[80], *o = 0; long n = 0, at = 0; int prod = 0, unc = 0, other = 0;
    if (cx_fmt(spec, sizeof spec, "%s^{commit}", rev)) return 2;
    { char *v[] = {"git", "-C", (char *)root, "rev-parse", "--verify", "-q", spec, 0};
      if (slurp_v(v, &o, &n) || rev40(o, n, want)) { sy_printf("HEAD_DELTA\tstatus=REFUSE\treason=BUILD_REV_UNKNOWN\tbuild_rev=%s\n", rev); return 1; } }
    { char *v[] = {"git", "-C", (char *)root, "rev-parse", "--verify", "HEAD", 0};
      if (slurp_v(v, &o, &n) || rev40(o, n, head)) { sy_eprintf("freeze-plan: head-delta cannot read HEAD of %s\n", root); return 2; } }
    if (tx_eqz(head, want)) { sy_printf("HEAD_DELTA\tstatus=OK\treason=SAME\tchanged=0\tbuild_rev=%s\thead=%s\n", want, head); return 0; }
    { char *v[] = {"git", "-C", (char *)root, "merge-base", "--is-ancestor", want, head, 0};
      if (slurp_v(v, &o, &n)) { sy_printf("HEAD_DELTA\tstatus=REFUSE\treason=NOT_ANCESTOR\tbuild_rev=%s\thead=%s\n", want, head); return 1; } }
    { char *v[] = {"git", "-C", (char *)root, "diff", "--name-only", "--no-renames", want, head, 0};
      if (slurp_v(v, &o, &n)) { sy_eprintf("freeze-plan: head-delta git diff failed\n"); return 2; } }
    while (at < n) {
        long e = tx_chr(o + at, n - at, '\n'), l = e < 0 ? n - at : e;
        if (l > 0) {
            char p[800]; int c;
            if (l >= (long)sizeof p) { sy_eprintf("freeze-plan: head-delta path too long, not truncated\n"); return 2; }
            mm_copy(p, sizeof p, o + at, l); p[l] = 0; c = fp_class(p);
            if (c == 1) { sy_printf("PRODUCT\t%s\n", p); prod++; }
            else if (c < 0) { sy_printf("UNCLASSIFIED\t%s\n", p); unc++; }
            else { sy_printf("NONPRODUCT\t%s\n", p); other++; }
        }
        at += l + 1;
    }
    sy_printf("HEAD_DELTA\tstatus=%s\treason=%s\tchanged=%d\tproduct=%d\tunclassified=%d\tbuild_rev=%s\thead=%s\n",
              prod || unc ? "REFUSE" : "OK", prod ? "PRODUCT_INPUT_CHANGED" : unc ? "UNCLASSIFIED_PATH" : "NONPRODUCT_ONLY",
              prod + unc + other, prod, unc, want, head);
    return prod || unc ? 1 : 0;
}

int main(int argc, char **argv) {
    int i, got_root = 0; const char *cmd = 0, *root = ".", *outdir = 0, *ident = 0, *sid = "PLAN-SID", *owner = "plan";
    const char *ident_list = 0, *alias_list = 0, *draft = 0, *boot = 0, *hd_root = 0, *hd_rev = 0;
    for (i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--")) continue;
        if (!cmd) { cmd = argv[i]; continue; }
        if (tx_eqz(argv[i], "--ident") && i + 1 < argc) { ident = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--sid") && i + 1 < argc) { sid = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--owner") && i + 1 < argc) { owner = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--ident-list") && i + 1 < argc) { ident_list = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--alias-list") && i + 1 < argc) { alias_list = argv[++i]; continue; }
        if (tx_eqz(argv[i], "--draft") && i + 1 < argc) { draft = argv[++i]; continue; }
        if (tx_eqz(cmd, "plan")) { if (!got_root) { root = argv[i]; got_root = 1; } else outdir = argv[i]; continue; }
        if (tx_eqz(cmd, "boot-list") && !boot) { boot = argv[i]; continue; }
        if (tx_eqz(cmd, "head-delta") && !hd_rev) { if (!hd_root) hd_root = argv[i]; else hd_rev = argv[i]; continue; }
        sy_eprintf("freeze-plan: bad argument %s\n", argv[i]); return 2;
    }
    if (!cmd) { sy_eprintf("usage: freeze-plan plan|check|boot-list\n"); return 2; }
    if (tx_eqz(cmd, "boot-list")) {
        if (!boot) { sy_eprintf("freeze-plan: boot-list LIST\n"); return 2; }
        return boot_list(boot);
    }
    if (tx_eqz(cmd, "head-delta")) {
        if (!hd_rev) { sy_eprintf("freeze-plan: head-delta ROOT BUILD_REV\n"); return 2; }
        return head_delta(hd_root, hd_rev);
    }
    if (tx_eqz(cmd, "check")) {
        if (ident_list) {
            size_t n = 0; char *b = (char *)cx_read(ident_list, &n);
            if (!b || parse_ident_list(b, (long)n)) { sy_eprintf("freeze-plan: ident-list\n"); return 1; }
        } else { sy_eprintf("freeze-plan: check needs --ident-list\n"); return 2; }
        if (alias_list) {
            size_t n = 0; char *b = (char *)cx_read(alias_list, &n);
            if (b && parse_aliases(b, (long)n)) return 1;
        }
        if (refuse_unclassified()) return 1;
        if (!draft) { sy_eprintf("freeze-plan: check needs --draft FILE\n"); return 2; }
        { size_t n = 0; char *b = (char *)cx_read(draft, &n); if (!b || parse_draft_paths(b, (long)n)) return 1; }
        return do_check();
    }
    if (tx_eqz(cmd, "plan")) {
        char commit[80], outp[400]; int k; long dl, n = 0, an = 0;
        const char *bin = ident ? ident : "./seed/ident";
        char *buf = 0, *abuf = 0, *pathrow; long prcap = 8192, used = 0;
        if (!outdir) outdir = sy_tmpdir();
        if (tx_find(outdir, tx_len(outdir, 400), "agentwork", 9) >= 0) {
            sy_eprintf("freeze-plan: refuse writing under agentwork/\n"); return 2;
        }
        if (ident_list) {
            size_t zn = 0; buf = (char *)cx_read(ident_list, &zn); n = (long)zn;
            if (!buf || parse_ident_list(buf, n)) { sy_eprintf("freeze-plan: ident-list\n"); return 1; }
        } else {
            char *av[] = {(char *)bin, (char *)root, "list-current", 0};
            if (slurp_v(av, &buf, &n) || parse_ident_list(buf, n)) {
                sy_eprintf("freeze-plan: ident list-current failed (pass --ident BIN)\n"); return 1;
            }
        }
        if (alias_list) {
            size_t zn = 0; abuf = (char *)cx_read(alias_list, &zn); an = (long)zn;
            if (abuf && parse_aliases(abuf, an)) return 1;
        } else if (!ident_list) {
            char *al[] = {(char *)bin, (char *)root, "list-aliases", 0};
            if (!slurp_v(al, &abuf, &an)) parse_aliases(abuf, an);
        }
        if (refuse_unclassified()) return 1;
        if (merge_prefs()) return 1;
        { char *gv[] = {"git", "rev-parse", "--short=10", "HEAD", 0}; long cn = 0; char *cb = 0;
          if (slurp_v(gv, &cb, &cn) == 0 && cb) {
              while (cn > 0 && (cb[cn - 1] == '\n' || cb[cn - 1] == '\r')) cb[--cn] = 0;
              mm_copy(commit, sizeof commit, cb, cn < 79 ? cn + 1 : 79);
          } else mm_copy(commit, sizeof commit, "unknown", 8); }
        if (sy_exists(outdir) != 1) sy_mkdir(outdir, 0755);
        if (cx_fmt(outp, sizeof outp, "%s/freeze.tsv", outdir)) return 1;
        pathrow = (char *)mm_alloc((size_t)prcap); if (!pathrow) return 1; pathrow[0] = 0;
        for (k = 0; k < npref; k++) {
            long pl = tx_len(prefs[k], 200);
            if (used + pl + 2 >= prcap) {
                char *np; long nc = prcap * 2;
                if (nc > 1024 * 1024) { sy_eprintf("freeze-plan: prefix row too large, not truncated\n"); return 1; }
                np = (char *)mm_alloc(nc); if (!np) return 1;
                mm_copy(np, nc, pathrow, used + 1); pathrow = np; prcap = nc;
            }
            if (used) { pathrow[used++] = ' '; pathrow[used] = 0; }
            mm_copy(pathrow + used, prcap - used, prefs[k], pl + 1); used += pl;
        }
        dl = sy_wall_s() + 14 * 24 * 3600;
        { char *row; long rc = used + 200;
          row = (char *)mm_alloc((size_t)rc); if (!row) return 1;
          if (cx_fmt(row, rc, "# candidate_sid\tbase_commit\towner\tdeadline_epoch_s\tpaths\n%s\t%s\t%s\t%ld\t%s\n",
                     sid, commit, owner, dl, pathrow[0] ? pathrow : "src")) return 1;
          if (cx_write(outp, row, (size_t)tx_len(row, rc))) return 1; }
        { int a; for (a = 0; a < nalias; a++) sy_printf("ALIAS\t%s\n", aliases[a]); }
        sy_printf("FREEZE_PLAN\tpath=%s\tprefixes=%d\tfiles=%d\taliases=%d\n", outp, npref, nfiles, nalias);
        return 0;
    }
    sy_eprintf("freeze-plan: unknown command\n"); return 2;
}
