/* tools/check-std-surface-v2.cx -- run tools/std-surface-v2.cx --check and assert exit 0.
 *
 *   sh ./unisacc.com tools/check-std-surface-v2.cx [-- ROOT]
 */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.heap

int main(int argc, char **argv) {
    const char *root = argc > 1 ? argv[1] : ".";
    char tool[4600], *out = 0;
    size_t outn = 0;
    int rc;
    char *v[8];
    if (tx_snprintf(tool, sizeof tool, "%s/tools/std-surface-v2.cx", root) < 0) {
        sy_eprintf("check-std-surface-v2\tpath\n");
        return 2;
    }
    v[0] = "sh";
    v[1] = "./unisacc.com";
    v[2] = tool;
    v[3] = "--";
    v[4] = "--check";
    v[5] = 0;
    if (!tx_eqz(root, ".")) {
        char table[4600];
        if (tx_snprintf(table, sizeof table, "%s/build/std-surface.tsv", root) < 0) return 2;
        v[5] = table;
        v[6] = 0;
    }
    rc = cx_runv_timeout(v, 55, &out, &outn);
    if (out && outn) sy_printf("%.*s", (int)outn, out);
    mm_free(out);
    if (rc != 0) {
        sy_printf("FAIL\tcheck-std-surface-v2\trc=%d\n", rc);
        return 1;
    }
    sy_printf("CHECK_STD_SURFACE_V2\tstatus=PASS\trc=0\n");
    return 0;
}
