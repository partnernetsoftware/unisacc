#pragma unisa use compiler.optname
#pragma unisa use runtime.optname
#pragma unisa use sys.io
#pragma unisa use text.text
/* Generated by tools/opt-gen.cx. Narrow check of the three optimiser names. */
int main(void) {
    const char *name;
    const char **missing;
    missing = 0;
    if (pon_count() != 3) return 1;
    if (ron_count() != 3) return 1;
    if (pon_at(0, &name) || !tx_eqz(name, "none")) return 1;
    if (ron_at(0, &name) || !tx_eqz(name, "none")) return 1;
    if (pon_at(1, &name) || !tx_eqz(name, "O1")) return 1;
    if (ron_at(1, &name) || !tx_eqz(name, "O1")) return 1;
    if (pon_at(2, &name) || !tx_eqz(name, "O2")) return 1;
    if (ron_at(2, &name) || !tx_eqz(name, "O2")) return 1;
    if (pon_at(0, missing) != 4) return 1;
    if (ron_at(0, missing) != 4) return 1;
    if (pon_at(-1, &name) != 2) return 1;
    if (pon_at(3, &name) != 2) return 1;
    if (ron_at(-1, &name) != 2) return 1;
    if (ron_at(3, &name) != 2) return 1;
    sy_printf("CX_OPT\tok=3\tfailed=0\n");
    return 0;
}
