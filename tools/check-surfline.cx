/* check-surfline: round trip and rejection contract of cxlib.surfline (SURF evidence line).
 *   sh ./unisacc.com tools/check-surfline.cx */
#pragma unisa use cxlib.surfline
static int bad;
static void need(int ok, const char *what) { if (!ok) { printf("FAIL\t%s\n", what); bad++; } }
int main(void) {
    char buf[512];
    sl_line l;
    int n = sl_make(buf, 512, "pkgA", "S1", "row1", "ok", "std-surface", "abc123");
    need(n > 0, "make");
    need(sl_parse(buf, n - 1, &l) == 1, "parse-roundtrip");
    need(!strcmp(l.pkg, "pkgA") && !strcmp(l.clause, "S1") && !strcmp(l.row, "row1") && !strcmp(l.result, "ok") && !strcmp(l.batch, "std-surface") && !strcmp(l.sha, "abc123"), "fields");
    need(sl_make(buf, 512, "p\tq", "S1", "r", "ok", "b", "s") < 0, "tab-refused");
    need(sl_make(buf, 512, "p", "S1", "", "ok", "b", "s") < 0, "empty-refused");
    need(sl_make(buf, 8, "pkgA", "S1", "row1", "ok", "b", "s") < 0, "overflow-refused");
    need(sl_parse("OTHER\tx", 7, &l) == 0, "non-surf-line");
    need(sl_parse("SURF\ta\tb\tc", 10, &l) == -1, "short-malformed");
    need(sl_parse("SURF\ta\tb\tc\td\te\tf\tg", 18, &l) == -1, "long-malformed");
    printf("CHECK_SURFLINE\tfailed=%d\n", bad);
    return bad != 0;
}
