/* Compile the actual transitional driver as one foreign unit. The result is
 * inspected locally; no foreign execution or ABI compatibility is claimed. */
#pragma unisa use cxlib.netpack
#pragma unisa use text.text
int main(int argc,char **argv){
    if(argc!=5){fputs("usage: DRIVER MODELS TARGET NEW_OUTDIR\n",stderr);return 2;}
    const char *targets[]={"osx/x86_64","osx/arm64","win/x86_64","win/arm64"};
    int target=-1;for(int i=0;i<4;i++)if(tx_eq(argv[3], targets[i], 1L << 20))target=i;
    if(target<0||mkdir(argv[4],0700)){fputs("invalid target or output directory\n",stderr);return 2;}
    char out[4096],why[512];int n=snprintf(out,sizeof out,"%s/driver.o",argv[4]);if(n<0||(size_t)n>=sizeof out)return 2;
    char *v[]={"tools/bound","50",argv[1],"--models",argv[2],"-O2","-I","include","-iquote","exec/c","-c","-funit","-b",argv[3],"exec/c/asmcompiler.c","-o",out,0};
    np_result r={0};int tr=np_run(v,0,0,52,&r,why,sizeof why);size_t z=0;char *s=tr?0:cx_read(out,&z);int format=0;
    if(s&&z>=8){const unsigned char *p=(const unsigned char *)s;
        if(target<2)format=p[0]==0xcf&&p[1]==0xfa&&p[2]==0xed&&p[3]==0xfe&&p[4]==(target?12:7)&&p[5]==0&&p[6]==0&&p[7]==1;
        else format=p[0]==0x64&&p[1]==(target==2?0x86:0xaa);
    }
    int ok=!tr&&!r.rc&&!r.errn&&format;printf("%s\t%s\tdriver-unit\n",ok?"PASS":"FAIL",argv[3]);
    if(!ok){if(tr)fprintf(stderr,"%s\n",why);else if(r.errn)fwrite(r.err,1,r.errn,stderr);}
    free(s);np_free(&r);return ok?0:1;
}
