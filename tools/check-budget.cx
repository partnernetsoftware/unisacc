#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.sig
#pragma unisa use text.text
#pragma unisa use mem.heap
/* Does UNISA_MAXSTEPS control the step budget of the model interpreter? (C44-BUDGET-01)
 *
 *   sh ./unisacc.com tools/check-budget.cx -- ROOT
 *
 * Scope: this budget bounds the model interpreter that compiles the program,
 * not the program itself. A native program that loops forever is not stopped
 * by it and is out of scope here.
 *
 * src/executor.cx passed 400000000000LL to core_run at both call sites, and
 * cx/runtime/runexec.cx carried ex_budget - parse, range check and the refusal
 * line - with no product caller, so the env var reached nothing:
 *   UNISA_MAXSTEPS=1000 sh ./unisacc.com ok.cx   -> rc 0, the source built
 *   UNISA_MAXSTEPS=abc  sh ./unisacc.com ok.cx   -> rc 0, the bad value passed
 * A budget below the steps a build needs must stop the build by name, and a
 * value that is not a positive decimal integer must be refused by name.
 *
 * Three observables: the small budget is exhausted and the line names it, the
 * bad value is refused with the documented text and status 2, and a run with
 * no budget still builds (so the first two cannot pass by everything failing).
 */
static int g_fail;
static void die(const char *s) { sy_eprintf("budget: REFUSE %s\n", s); sy_exit(2); }
static void ck(int ok, const char *name) {
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", name);
    if (!ok) g_fail = g_fail + 1;
}
static int has(const char *h, long n, const char *needle) {
    long i, k, m;
    m = tx_len(needle, 4096);
    if (!h || m == 0) return 0;
    i = 0;
    while (i + m <= n) {
        k = 0;
        while (k < m && h[i + k] == needle[k]) k = k + 1;
        if (k == m) return 1;
        i = i + 1;
    }
    return 0;
}

static const char *src_ok = "int main(void){return 0;}\n";

int main(int argc, char **argv) {
    char root[4096], com[4400], work[4400], sp[4400];
    char *v[8];
    char *e1[3], *e2[3], *e3[2];
    char why[512];
    np_result r;
    int fd, i;
    if (argc >= 2 && argv[1][0]) { if (cx_fmt(root, sizeof root, "%s", argv[1])) die("root"); }
    else if (sy_cwd(root, sizeof root) < 0) die("cwd");
    if (cx_fmt(com, sizeof com, "%s/unisacc.com", root)) die("com");
    if (sy_mkdtemp(sy_tmpdir(), "cbg-", work, (int)sizeof work)) die("work");
    if (cx_fmt(sp, sizeof sp, "%s/ok.cx", work)) die("src");

    fd = sy_open(sp, O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (fd < 0) die("write src");
    if (sy_write_all(fd, src_ok, tx_len(src_ok, 4096))) die("write src");
    sy_close(fd);

    i = 0;
    v[i++] = "sh"; v[i++] = com; v[i++] = sp; v[i] = 0;

    /* a budget below what a build needs must stop the build and name it */
    e1[0] = "UNISA_MAXSTEPS=1000"; e1[1] = "UNISACC_RUN_CACHE=0"; e1[2] = 0;
    if (np_run(v, root, e1, 30, &r, why, sizeof why)) die(why);
    ck(r.rc != 0 && has(r.err, (long)r.errn, "step budget exhausted (budget 1000 steps)"),
       "small-budget-exhausted");
    if (r.rc == 0) sy_printf("NOTE\tsmall\tnot-stopped\n");
    np_free(&r);

    /* a value that is not a positive decimal integer is refused by name */
    e2[0] = "UNISA_MAXSTEPS=abc"; e2[1] = "UNISACC_RUN_CACHE=0"; e2[2] = 0;
    if (np_run(v, root, e2, 30, &r, why, sizeof why)) die(why);
    ck(r.rc == 2 && has(r.err, (long)r.errn,
       "run: UNISA_MAXSTEPS must be a positive decimal integer <= 9223372036854775807"),
       "bad-value-refused");
    if (r.rc != 2) sy_printf("NOTE\tbad\texit\t%d\n", r.rc);
    np_free(&r);

    /* no budget: the same source still builds, so the cases above are not a
       blanket failure. Every run turns the run cache off, or a repeated source
       would be served from cache and the model would never run. */
    e3[0] = "UNISACC_RUN_CACHE=0"; e3[1] = 0;
    if (np_run(v, root, e3, 60, &r, why, sizeof why)) die(why);
    ck(r.rc == 0, "default-builds");
    if (r.rc != 0) sy_printf("NOTE\tdefault\texit\t%d\n", r.rc);
    np_free(&r);

    printf("CHECK_BUDGET\tfailed=%d\n", g_fail);
    return g_fail ? 1 : 0;
}
