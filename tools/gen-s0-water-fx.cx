#pragma unisa use cxlib.uxeimage
#pragma unisa use chrome_dom
/* tools/gen-s0-water-fx.cx -- 水面 0.22 桥/灯/船头镜像占位 1280x432.
 * sh ./unisacc.com tools/gen-s0-water-fx.cx -- --write|--check
 */
#define CW 1280
#define CH 432
#define OY 288
static unsigned char cpix[CH][CW][4];
static double hx[96], hy[96];
static int hn;
static void qbez(double x0, double y0, double cx, double cy, double x1, double y1) {
    int i;
    for (i = 1; i <= 24; i++) {
        double t = (double)i / 24.0, u = 1.0 - t;
        hx[hn] = u * u * x0 + 2 * u * t * cx + t * t * x1;
        hy[hn] = u * u * y0 + 2 * u * t * cy + t * t * y1;
        hn++;
    }
}
static void puta(int x, int y, int r, int g, int b, int a) {
    int cr, cg, cb, ca, oa, na;
    if (x < 0 || x >= CW || y < 0 || y >= CH) return;
    oa = cpix[y][x][3];
    if (oa == 0) {
        cpix[y][x][0] = (unsigned char)r;
        cpix[y][x][1] = (unsigned char)g;
        cpix[y][x][2] = (unsigned char)b;
        cpix[y][x][3] = (unsigned char)a;
        return;
    }
    na = a + oa * (255 - a) / 255;
    if (na < 1) na = 1;
    cr = (r * a + cpix[y][x][0] * oa * (255 - a) / 255) / na;
    cg = (g * a + cpix[y][x][1] * oa * (255 - a) / 255) / na;
    cb = (b * a + cpix[y][x][2] * oa * (255 - a) / 255) / na;
    ca = na;
    if (cr > 255) cr = 255;
    if (cg > 255) cg = 255;
    if (cb > 255) cb = 255;
    if (ca > 255) ca = 255;
    cpix[y][x][0] = (unsigned char)cr;
    cpix[y][x][1] = (unsigned char)cg;
    cpix[y][x][2] = (unsigned char)cb;
    cpix[y][x][3] = (unsigned char)ca;
}
static void fill_fx(void) {
    int y, x, i, dx, dy;
    hn = 0;
    hx[hn] = 90; hy[hn] = 680; hn++;
    qbez(90, 680, 220, 430, 430, 430);
    qbez(430, 430, 560, 500, 610, 680);
    for (y = 0; y < CH; y++) for (x = 0; x < CW; x++) {
        int wy = OY + y;
        cpix[y][x][0] = 0; cpix[y][x][1] = 0; cpix[y][x][2] = 0; cpix[y][x][3] = 0;
        if (x >= 40 && x < 808 && wy >= 288 && wy < 306)
            puta(x, y, 58, 36, 20, 56);
        if (uxe_polygon_contains(hx,hy,hn,(double)x, (double)wy))
            puta(x, y, 42, 24, 16, 56);
        dx = x - 300; dy = wy - 392;
        if (dx * dx + dy * dy <= 36 * 36)
            puta(x, y, 255, 232, 160, 40);
        if (dx * dx + dy * dy <= 64)
            puta(x, y, 255, 232, 160, 80);
    }
    (void)i;
}
static unsigned char outb[CH * (1 + CW * 4) + (CH * (1 + CW * 4) / 65535 + 1) * 5 + 63];
int main(int argc, char **argv) {
    int write = 0, check = 0, i, oi, failed = 0;
    FILE *f;
    uxe_crc_init();
    for (i = 1; i < argc; i++) {
        if (argv[i][0] == '-' && argv[i][2] == 'w') write = 1;
        if (argv[i][0] == '-' && argv[i][2] == 'c') check = 1;
    }
    if (!write && !check) { printf("GEN_S0_WATER_FX\tdry\n"); return 0; }
    fill_fx();
    oi = uxe_encode_rgba_png(outb,sizeof outb,&cpix[0][0][0],CW,CH);
    if(oi<=0) return 2;
    if (write) {
        f = fopen("ujs/plans/demo-v2/look-dev/water-fx.png", "wb");
        if (!f) return 1;
        fwrite(outb, 1, oi, f);
        fclose(f);
        printf("WROTE\twater-fx.png\t%d\n", oi);
    }
    if (check) {
        if (uxe_check_png("ujs/plans/demo-v2/look-dev/water-fx.png", outb, oi)) {
            printf("DIFF\twater-fx.png\n"); failed = 1;
        } else printf("MATCH\twater-fx.png\n");
    }
    printf("GEN_S0_WATER_FX\tok\n");
    return failed;
}
