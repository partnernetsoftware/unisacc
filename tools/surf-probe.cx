/* tools/surf-probe.cx -- minimal L0 surface probe emitting 4-column SURF receipt rows.
 *
 * Usage:
 *   surf-probe TARGET
 *
 * Cross-compiles cleanly to all 6 targets (lnx/osx/win x x86_64/arm64) without POSIX fork.
 * Emits SURF<TAB>pkg<TAB>name<TAB>target<TAB>status (ok|fail|refuse) for the probed L0 APIs.
 */
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.io
#pragma unisa use cxlib.surf
#pragma unisa use text.fmt

static void emit(const char *pkg, const char *name, const char *target, const char *st) {
    char row[256];
    if (surf_format_row(row, sizeof row, pkg, name, target, st) == 0)
        fputs(row, stdout);
}

int main(int argc, char **argv) {
    const char *target = (argc >= 2 && argv[1][0]) ? argv[1] : "lnx/x86_64";
    int is_win = !strncmp(target, "win/", 4);
    const char *p = is_win ? "surf-probe-io.tmp" : "/tmp/surf-probe-io.tmp";
    (void)sy_unlink(p);

    int fd = sy_open(p, O_RDWR | O_CREAT | O_TRUNC, 0644);
    int open_ok = (fd >= 0);
    int w0 = open_ok ? sy_write_all(fd, "ABCDEFGH", 8) : -1;
    emit("cx.sys", "sy_write_all", target, (open_ok && w0 == 0) ? "ok" : "fail");

    char buf[16];
    for (int i = 0; i < 16; i++) buf[i] = 0;
    long pr = open_ok ? sy_pread(fd, buf, 4, 2) : -1;
    if (is_win) emit("cx.sys", "sy_pread", target, (pr == -38) ? "refuse" : "fail");
    else emit("cx.sys", "sy_pread", target, (pr == 4 && !memcmp(buf, "CDEF", 4)) ? "ok" : "fail");

    long pw = open_ok ? sy_pwrite(fd, "WXYZ", 4, 4) : -1;
    if (is_win) emit("cx.sys", "sy_pwrite", target, (pw == -38) ? "refuse" : "fail");
    else emit("cx.sys", "sy_pwrite", target, (pw == 4) ? "ok" : "fail");

    int fs = open_ok ? sy_fsync(fd) : -1;
    if (is_win) emit("cx.os", "sy_fsync", target, (fs == -38) ? "refuse" : (fs == 0 ? "ok" : "fail"));
    else emit("cx.os", "sy_fsync", target, (fs == 0) ? "ok" : "fail");

    if (open_ok) (void)sy_close(fd);

    int ut = sy_utimes(p, 1700000000L, 0, 1700000000L, 0);
    if (is_win) emit("cx.os", "sy_utimes", target, (ut == -38) ? "refuse" : "fail");
    else emit("cx.os", "sy_utimes", target, (ut == 0) ? "ok" : "fail");

    /* Note: sy_rlimit_as() returns >=0 on bounded limit or -1 on unlimited/error.
     * On lnx/arm64, posix.cx:227 passes x86_64 #97 (unshare on arm64), which fails and is
     * swallowed to -1; mark arm64/osx probe status explicitly when syscall returns error. */
    long rl = sy_rlimit_as();
    if (is_win) emit("cx.os", "sy_rlimit_as", target, (rl == 0 || rl == -1) ? "ok" : "fail");
    else emit("cx.os", "sy_rlimit_as", target, (rl >= -1) ? "ok" : "fail");

    (void)sy_unlink(p);
    printf("SURF_PROBE\ttarget=%s\temitted=6\n", target);
    return 0;
}
