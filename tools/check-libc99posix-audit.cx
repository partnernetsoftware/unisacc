#pragma unisa use sys.io
#pragma unisa use text.text
/* tools/check-libc99posix-audit.cx -- inventory tool prints GAP rows and a total. */
static int fail(const char *w) { sy_eprintf("check-libc99posix-audit\tFAIL\t%s\n", w); return 1; }
int main(void) {
    char *out; size_t n = 0; char *av[6]; int rc;
    av[0] = "./tools/bound"; av[1] = "20"; av[2] = "sh"; av[3] = "./unisacc.com";
    av[4] = "tools/libc99posix-audit.cx"; av[5] = 0;
    rc = cx_runv_timeout(av, 25, &out, &n);
    if (rc != 0 || !out) return fail("run");
    if (!tx_contains(out, (int)n, "LIBC99POSIX_AUDIT\tgaps=", 23)) return fail("marker");
    if (!tx_contains(out, (int)n, "GAP\tunistd.h\twrite\tUCRT?", 24)) return fail("write-ucrt");
    if (!tx_contains(out, (int)n, "GAP\tstdio.h\tfopen\t-", 19)) return fail("fopen");
    sy_printf("CHECK_LIBC99POSIX_AUDIT\tfailed=0\n");
    return 0;
}
