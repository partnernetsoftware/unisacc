/* Independent mutation fixtures; compile the repeated child once in a fresh directory. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sys.env
#pragma unisa use sysx.process
static char base[4096],root[4096],exe[4400],fixture[4400];static int checks,failed;
static const char*fact="# name\tvalue\nAUT\t19000000\nAUD\t20000000\nUNUSED\t42\n";
static const char*manifest="rows\tautoscan\tauto\t-\tparse-constants\t-\t-\t-\t{\"bindmap\":{\"AUT\":\"parse-constants!.AUT\",\"AUD\":\"parse-constants!.AUD\"}}\n";
static void die(const char*s){fprintf(stderr,"DEP_SPLIT_CHECK REFUSE %s\n",s);exit(2);}
static void ck(int ok,const char*s){checks++;failed+=!ok;printf("%s\t%s\n",ok?"PASS":"FAIL",s);}
static void save(const char*leaf,const char*s){char p[8192];if(cx_fmt(p,sizeof p,"%s/%s",fixture,leaf)||cx_write(p,s,strlen(s)))die("fixture write");}
static void setup(int id,const char*f,const char*m){char p[8192];if(cx_fmt(fixture,sizeof fixture,"%s/case%d",base,id)||mkdir(fixture,0700))die("fixture directory");const char*dirs[]={"exec","exec/facts","exec/parse"};for(int i=0;i<3;i++)if(cx_fmt(p,sizeof p,"%s/%s",fixture,dirs[i])||mkdir(p,0700))die("fixture parents");save(".dep-split-isolated","DEP_SPLIT_ISOLATED_V1\n");save("exec/facts/parse-constants.tsv",f);save("exec/parse/autoscan-manifest.tsv",m);}
static np_result run(const char*fh,const char*mh){char*v[]={exe,"--autoscan",fixture,(char*)fh,(char*)mh,0};np_result r={0};char why[512];if(np_run(v,root,0,5,&r,why,sizeof why)||r.residue)die("child bound");return r;}
static int absent(void){char p[8192];struct stat st;if(cx_fmt(p,sizeof p,"%s/exec/facts/parse-autoscan-private.tsv",fixture))die("path");errno=0;int z=lstat(p,&st);if(z&&errno!=ENOENT)die("existence IO");return z&&errno==ENOENT;}
static void refused(const char*fh,const char*mh,const char*label){np_result r=run(fh,mh);ck(r.rc==2&&!r.outn&&absent(),label);np_free(&r);}
int main(int argc,char**argv){if(argc!=1)die("arguments");if(!realpath(".",root)||cx_fmt(base,sizeof base,"%s/dep-split-check-XXXXXX",sy_tmpdir())||!mkdtemp(base)||cx_fmt(exe,sizeof exe,"%s/probe.exe",base))die("paths");char com[4400],tool[4400];if(cx_fmt(com,sizeof com,"%s/unisacc.com",root)||cx_fmt(tool,sizeof tool,"%s/tools/dep-split-probe.cx",root))die("build paths");char*build[]={"sh",com,tool,"-o",exe,0};np_result b={0};char why[512];if(np_run(build,root,0,30,&b,why,sizeof why)||b.rc||b.residue)die("child compile");np_free(&b);char fh[65],mh[65];cx_sha256_hex(fact,strlen(fact),fh);cx_sha256_hex(manifest,strlen(manifest),mh);
setup(0,fact,manifest);np_result r=run(fh,mh);ck(!r.rc&&r.out&&strstr(r.out,"ACTUAL_CONSUMER_CHANGED_NOT_EQUIVALENCE"),"actual consumer rewrite");np_free(&r);char p[8192];size_t n;if(cx_fmt(p,sizeof p,"%s/exec/facts/parse-autoscan-private.tsv",fixture))die("path");char*s=cx_read(p,&n);ck(s&&!strcmp(s,"# name\tvalue\nAUT\t19000000\nAUD\t20000000\n"),"exact selected rows and order");free(s);if(cx_fmt(p,sizeof p,"%s/exec/parse/autoscan-manifest.tsv",fixture))die("path");s=cx_read(p,&n);ck(s&&!strstr(s,"parse-constants")&&strstr(s,"parse-autoscan-private!.AUD"),"actual binding and declaration migrated");free(s);r=run(fh,mh);ck(r.rc==2&&!r.outn,"existing view refuses");np_free(&r);
setup(1,fact,manifest);char bad[65];if(cx_fmt(bad,sizeof bad,"%s",fh))die("SHA copy");bad[0]=bad[0]=='0'?'1':'0';refused(bad,mh,"wrong source SHA refuses before output");setup(2,fact,manifest);refused(fh,bad,"wrong consumer SHA refuses before output");setup(3,fact,manifest);save(".dep-split-isolated","WRONG\n");refused(fh,mh,"missing isolation assertion refuses");setup(4,"# name\tvalue\nAUT\t1\n",manifest);size_t z;char*ff; if(cx_fmt(p,sizeof p,"%s/exec/facts/parse-constants.tsv",fixture))die("path");ff=cx_read(p,&z);if(!ff)die("read");cx_sha256_hex(ff,z,bad);free(ff);refused(bad,mh,"missing required AUD refuses");setup(5,fact,"rows\tx\n");cx_sha256_hex("rows\tx\n",7,bad);refused(fh,bad,"consumer shape mismatch refuses");printf("DEP_SPLIT_CHECK\tchecks=%d\tfailed=%d\n",checks,failed);return failed?1:0;}
