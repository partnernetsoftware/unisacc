/* tools/check-p4-embed.cx -- self-check for tools/p4-embed.cx (P4 F-record CRC32 injector).
 *
 *   sh ./unisacc.com tools/check-p4-embed.cx --
 *
 * Verifies:
 *   (1) Positive: embeds manifest.tsv, tapemode.so, m53.tapeslice with codec=0 and IEEE CRC32;
 *   (2) Fail-closed: duplicate tape resource and invalid/missing input refused non-zero.
 * Marker: CHECK_P4_EMBED. */
#pragma unisa use runtime.packagefooter
#pragma unisa use runtime.package_decode
#pragma unisa use runtime.package_lifetime
#pragma unisa use runtime.model_number
#pragma unisa use compiler.bindstage
#pragma unisa use runtime.routestep
#pragma unisa use runtime.codec
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.posix
#pragma unisa use sys.sha
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use cxlib.netpack

static int failed;

static void ck(int ok, const char *name) {
    if (!ok) {
        sy_eprintf("FAIL\tp4-embed.%s\n", name);
        failed++;
    } else {
        sy_printf("PASS\tp4-embed.%s\n", name);
    }
}

static void *pe_chk_alloc(void *prev, size_t n) {
    (void)prev;
    return mm_alloc((long)(n ? n : 1));
}

static void pe_chk_free(void *p) {
    if (p) mm_free(p);
}

static unsigned pe_chk_crc32(const char *p, int n) {
    CxCodecCrc c;
    uint32_t out = 0;
    if (cxcodec_crc_init(&c) || cxcodec_crc(&c, p, n, &out)) return 0;
    return out;
}

static char g_pe_bin[640];

static int run_embed(const char *in_p, const char *so_p, const char *sl_p, const char *out_p, char *log, long cap) {
    char *av[] = {g_pe_bin, (char *)in_p, (char *)so_p, (char *)sl_p, (char *)out_p, 0};
    np_result r = {0};
    char why[128] = {0};
    int tr = np_run(av, 0, 0, 40, &r, why, sizeof why);
    long n = 0;
    if (r.out && r.outn > 0) {
        long m = (long)r.outn < cap - 1 ? (long)r.outn : cap - 1;
        for (long i = 0; i < m; i++) log[n++] = r.out[i];
    }
    if (r.err && r.errn > 0 && n < cap - 1) {
        long m = (long)r.errn < (cap - 1 - n) ? (long)r.errn : (cap - 1 - n);
        for (long i = 0; i < m; i++) log[n++] = r.err[i];
    }
    log[n] = 0;
    int rc = (tr || r.residue) ? -1 : r.rc;
    np_free(&r);
    return rc;
}

int main(void) {
    char tmp[512], in_p4[640], so_p[640], sl_p[640], out_p4[640], dup_p4[640], bad_p[640], log[8192];
    const char *base_p4 = "P 4 1 1 1\nD r s in out 0\nM 1 1 1 0\nAF 4 4 4 0 3615426196\nkeepgood";
    const char *so_body = "ELF-tapemode-fixture";
    const char *sl_body = "UTAPEBIN-m53-fixture";

    if (sy_mkdtemp(sy_tmpdir(), "chk-pe-", tmp, sizeof tmp) != 0) return 2;
    if (cx_fmt(g_pe_bin, sizeof g_pe_bin, "%s/p4embed", tmp)) return 2;
    {
        char *bv[] = {"sh", "./unisacc.com", "tools/p4-embed.cx", "-o", g_pe_bin, 0};
        np_result br = {0}; char bwhy[128] = {0};
        int bt = np_run(bv, 0, 0, 45, &br, bwhy, sizeof bwhy);
        int brc = (bt || br.residue) ? -1 : br.rc;
        np_free(&br);
        if (brc != 0) { (void)sy_remove_all(tmp); sy_printf("CHECK_P4_EMBED\tfailed=1\n"); return 1; }
    }
    if (cx_fmt(in_p4, sizeof in_p4, "%s/in.p4", tmp) ||
        cx_fmt(so_p, sizeof so_p, "%s/tapemode.so", tmp) ||
        cx_fmt(sl_p, sizeof sl_p, "%s/m53.tapeslice", tmp) ||
        cx_fmt(out_p4, sizeof out_p4, "%s/out.p4", tmp) ||
        cx_fmt(dup_p4, sizeof dup_p4, "%s/dup.p4", tmp) ||
        cx_fmt(bad_p, sizeof bad_p, "%s/bad.p4", tmp)) return 2;
    if (cx_write(in_p4, base_p4, (size_t)tx_len(base_p4, 256)) ||
        cx_write(so_p, so_body, (size_t)tx_len(so_body, 128)) ||
        cx_write(sl_p, sl_body, (size_t)tx_len(sl_body, 128))) return 2;

    /* (1) Positive: embeds 3 records with valid IEEE CRC32 and codec=0 while keeping existing record */
    {
        int rc = run_embed(in_p4, so_p, sl_p, out_p4, log, sizeof log);
        size_t zn = 0;
        char *pb = cx_read(out_p4, &zn);
        CxPackageDecode dec;
        int ok = 0;
        if (rc == 0 && pb && zn > 16) {
            mm_fill(&dec, (long)sizeof dec, 0, (long)sizeof dec);
            dec.allocate = pe_chk_alloc;
            dec.release = pe_chk_free;
            if (cxpk_decode(&dec, (const unsigned char *)pb, (long)zn) == 0 && dec.package.ver == 4) {
                static const char *keys[3] = {
                    "tape/lnx-x86_64/manifest.tsv",
                    "tape/lnx-x86_64/tapemode.so",
                    "tape/lnx-x86_64/m53.tapeslice"
                };
                int hits = 0, keep = 0;
                for (int i = 0; i < dec.package.nr; i++) {
                    const CxPackageResource *r = &dec.package.res[i];
                    if (r->n == 4 && tx_same(pb + r->name, 4, "keep", 4)) keep = 1;
                    for (int k = 0; k < 3; k++) {
                        long kl = tx_len(keys[k], 64);
                        if (r->n == (int)kl && tx_same(pb + r->name, r->n, keys[k], kl)) {
                            unsigned crc = pe_chk_crc32(pb + r->data, r->len);
                            if (r->codec == 0 && r->rawlen == r->len && r->len > 0 && r->crc == crc) hits++;
                        }
                    }
                }
                ok = (dec.package.nr == 4 && hits == 3 && keep == 1);
                cxpl_release(&dec.package, pe_chk_free);
            }
        }
        if (pb) mm_free(pb);
        ck(ok, "positive-3-records-ieee-crc32");
    }

    /* (2a) Negative: duplicate tape resource refused */
    {
        int rc = run_embed(out_p4, so_p, sl_p, dup_p4, log, sizeof log);
        ck(rc != 0 && strstr(log, "duplicate-tape-resource") != 0, "refuse-duplicate-tape-resource");
    }

    /* (2b) Negative: bad P4 input refused */
    if (cx_write(bad_p, "NOTAP4", 6) == 0) {
        int rc = run_embed(bad_p, so_p, sl_p, dup_p4, log, sizeof log);
        ck(rc != 0, "refuse-invalid-p4-input");
    } else {
        ck(0, "refuse-invalid-p4-input");
    }

    /* (3) --extra positive + refusal fixtures (dup extra, reserved leaf, TSV/space/control chars) */
    {
        char ex1[640], ex2[640], ex_out[640];
        if (!cx_fmt(ex1, sizeof ex1, "%s/bind.tapeslice", tmp) &&
            !cx_fmt(ex2, sizeof ex2, "%s/m25.tapeslice", tmp) &&
            !cx_fmt(ex_out, sizeof ex_out, "%s/out_ex.p4", tmp) &&
            !cx_write(ex1, "UTAPEBIN-bind-fixture", 21) &&
            !cx_write(ex2, "UTAPEBIN-m25-fixture", 20)) {
            char *av_ok[] = {g_pe_bin, in_p4, so_p, sl_p, ex_out,
                             "--extra", "bind.tapeslice", ex1,
                             "--extra", "m25.tapeslice", ex2, 0};
            char *av_dup[] = {g_pe_bin, in_p4, so_p, sl_p, dup_p4,
                              "--extra", "bind.tapeslice", ex1,
                              "--extra", "bind.tapeslice", ex2, 0};
            char *av_res[] = {g_pe_bin, in_p4, so_p, sl_p, dup_p4,
                              "--extra", "tapemode.so", ex1, 0};
            char *av_tab[] = {g_pe_bin, in_p4, so_p, sl_p, dup_p4,
                              "--extra", "bad\tleaf.tapeslice", ex1, 0};
            char *av_spc[] = {g_pe_bin, in_p4, so_p, sl_p, dup_p4,
                              "--extra", "bad leaf.tapeslice", ex1, 0};
            np_result r = {0}; char why[128] = {0};
            int t0 = np_run(av_ok, 0, 0, 40, &r, why, sizeof why);
            int ex_ok = 0;
            if (!t0 && !r.residue && r.rc == 0 && r.out && strstr(r.out, "extra=2") != 0) {
                size_t en = 0;
                char *eb = cx_read(ex_out, &en);
                CxPackageDecode edec;
                if (eb && en > 16) {
                    mm_fill(&edec, (long)sizeof edec, 0, (long)sizeof edec);
                    edec.allocate = pe_chk_alloc;
                    edec.release = pe_chk_free;
                    if (cxpk_decode(&edec, (const unsigned char *)eb, (long)en) == 0 && edec.package.ver == 4 && edec.package.nr == 6) {
                        static const char *ekeys[5] = {
                            "tape/lnx-x86_64/manifest.tsv",
                            "tape/lnx-x86_64/tapemode.so",
                            "tape/lnx-x86_64/m53.tapeslice",
                            "tape/lnx-x86_64/bind.tapeslice",
                            "tape/lnx-x86_64/m25.tapeslice"
                        };
                        int hits[5] = {0, 0, 0, 0, 0}, keep = 0, tape_ns = 0;
                        const char *mf_p = 0; long mf_l = 0;
                        for (int i = 0; i < edec.package.nr; i++) {
                            const CxPackageResource *rr = &edec.package.res[i];
                            if (rr->n == 4 && tx_same(eb + rr->name, 4, "keep", 4)) keep++;
                            if (rr->n > 16 && tx_same(eb + rr->name, 16, "tape/lnx-x86_64/", 16)) tape_ns++;
                            for (int k = 0; k < 5; k++) {
                                long kl = tx_len(ekeys[k], 64);
                                if (rr->n == (int)kl && tx_same(eb + rr->name, rr->n, ekeys[k], kl)) {
                                    unsigned crc = pe_chk_crc32(eb + rr->data, rr->len);
                                    if (rr->codec == 0 && rr->rawlen == rr->len && rr->len > 0 && rr->crc == crc) {
                                        hits[k]++;
                                        if (k == 0) { mf_p = eb + rr->data; mf_l = (long)rr->len; }
                                    }
                                }
                            }
                        }
                        int mf_rows = 0, mf_bind = 0, mf_m25 = 0, mf_m53 = 0, mf_so = 0;
                        if (mf_p && mf_l > 0) {
                            long pos = 0;
                            while (pos < mf_l) {
                                long eol = pos;
                                while (eol < mf_l && mf_p[eol] != '\n') eol++;
                                long tab = pos;
                                while (tab < eol && mf_p[tab] != '\t') tab++;
                                long c0 = tab - pos;
                                if (c0 > 0 && mf_p[pos] != '#' && !(c0 == 4 && tx_same(mf_p + pos, 4, "leaf", 4))) {
                                    mf_rows++;
                                    if (c0 == 11 && tx_same(mf_p + pos, 11, "tapemode.so", 11)) mf_so++;
                                    else if (c0 == 13 && tx_same(mf_p + pos, 13, "m53.tapeslice", 13)) mf_m53++;
                                    else if (c0 == 14 && tx_same(mf_p + pos, 14, "bind.tapeslice", 14)) mf_bind++;
                                    else if (c0 == 13 && tx_same(mf_p + pos, 13, "m25.tapeslice", 13)) mf_m25++;
                                }
                                pos = eol + 1;
                            }
                        }
                        if (keep == 1 && tape_ns == 5 && mf_rows == 4 &&
                            mf_so == 1 && mf_m53 == 1 && mf_bind == 1 && mf_m25 == 1 &&
                            hits[0] == 1 && hits[1] == 1 && hits[2] == 1 && hits[3] == 1 && hits[4] == 1) {
                            ex_ok = 1;
                        }
                        cxpl_release(&edec.package, pe_chk_free);
                    }
                }
                if (eb) mm_free(eb);
            }
            ck(ex_ok, "positive-extra-2-slices-1to1-readback");
            np_free(&r);
            /* Orphan pre-existing tape/lnx-x86_64/* F record in input package must be refused */
            {
                char orph_in[640], orph_body[512];
                const char *ok_key = "tape/lnx-x86_64/orphan.tapeslice";
                const char *ok_val = "ORPHAN-SLICE";
                unsigned ocrc = pe_chk_crc32(ok_val, 12);
                if (!cx_fmt(orph_in, sizeof orph_in, "%s/orphan_in.p4", tmp) &&
                    !cx_fmt(orph_body, sizeof orph_body, "P 4 1 1 1\nD r s in out 0\nM 1 1 1 0\nAF %ld 12 12 0 %u\n%s%s",
                            (long)strlen(ok_key), ocrc, ok_key, ok_val) &&
                    !cx_write(orph_in, orph_body, strlen(orph_body))) {
                    int orc = run_embed(orph_in, so_p, sl_p, dup_p4, log, sizeof log);
                    ck(orc != 0 && strstr(log, "duplicate-tape-resource") != 0, "refuse-orphan-tape-namespace-input");
                } else {
                    ck(0, "refuse-orphan-tape-namespace-input");
                }
            }
            t0 = np_run(av_dup, 0, 0, 40, &r, why, sizeof why);
            ck(!t0 && !r.residue && r.rc != 0 && r.err && strstr(r.err, "duplicate --extra leaf") != 0, "refuse-duplicate-extra-leaf");
            np_free(&r);
            t0 = np_run(av_res, 0, 0, 40, &r, why, sizeof why);
            ck(!t0 && !r.residue && r.rc != 0 && r.err && strstr(r.err, "bad --extra leaf") != 0, "refuse-reserved-extra-leaf");
            np_free(&r);
            t0 = np_run(av_tab, 0, 0, 40, &r, why, sizeof why);
            ck(!t0 && !r.residue && r.rc != 0 && r.err && strstr(r.err, "bad --extra leaf") != 0, "refuse-tab-extra-leaf");
            np_free(&r);
            t0 = np_run(av_spc, 0, 0, 40, &r, why, sizeof why);
            ck(!t0 && !r.residue && r.rc != 0 && r.err && strstr(r.err, "bad --extra leaf") != 0, "refuse-space-extra-leaf");
            np_free(&r);
        } else {
            ck(0, "extra-fixture-setup");
        }
    }

    (void)sy_remove_all(tmp);
    sy_printf("CHECK_P4_EMBED\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
