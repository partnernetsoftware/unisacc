/* c-testsuite pinned materials: ROOT MATERIAL NEW_OUT START COUNT (1-based, <=20 per bounded invocation).
 * curl -fL the archive in tests/corpus-ctestsuite/upstream.tsv, verify archive_sha256, tar -xzf to MATERIAL.
 * No upstream sources redistributed; hashes verified before execution, compiler and runtime failures stay separate. */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use cxlib.netpack
static void die(const char *s){fprintf(stderr,"CTESTSUITE REFUSE %s\n",s);exit(2);}
static void path(char *p,const char *a,const char *b){if(cx_fmt(p,4400,"%s/%s",a,b))die("path");}
static char *slurp(const char *p,size_t *n){char *s=cx_read(p,n);if(!s)die(p);return s;}
static void save(const char *p,const char *s,size_t n){FILE *f=fopen(p,"wbx");if(!f||fwrite(s,1,n,f)!=n||fclose(f))die("save");}
static void verify(const char *p,const char *want){size_t n;char h[65],*s=slurp(p,&n);cx_sha256_hex(s,n,h);free(s);if(strcmp(h,want))die("material sha mismatch");}
static int run(char **v,const char *cwd,np_result *r){char why[512]={0};memset(r,0,sizeof *r);return np_run(v,cwd,0,5,r,why,sizeof why);}
int main(int argc,char **argv){char root[4096],mat[4096],out[4096],p[4400],product[4400],h[65];size_t n;char *manifest,*cursor;int first,count,index=0,accepted=0,wrong=0,rejected=0,unknown=0;FILE *report;
    if(argc!=6||!realpath(argv[1],root)||!realpath(argv[2],mat))die("ROOT MATERIAL NEW_OUT START COUNT");first=atoi(argv[4]);count=atoi(argv[5]);if(first<1||count<1||count>20||first+count>221)die("slice");if(mkdir(argv[3],0700)||!realpath(argv[3],out))die("new output");
    path(p,root,"tests/corpus-ctestsuite/manifest.tsv");manifest=slurp(p,&n);path(product,root,"unisacc.com");{char *s=slurp(product,&n);cx_sha256_hex(s,n,h);free(s);}path(p,out,"identity.txt");save(p,h,64);path(p,out,"results.tsv");report=fopen(p,"wbx");if(!report)die("report");fprintf(report,"id\tcompile\truntime\tstate\tfirst_error\n");
    cursor=strchr(manifest,'\n');if(!cursor)die("manifest header");cursor++;
    while(*cursor){char *end=strchr(cursor,'\n'),*f[7],*q;int col=0;np_result r;char source[4400],expected[4400],image[4400],name[128];size_t wantn;char *want;if(!end)die("manifest newline");*end=0;f[col++]=cursor;for(q=cursor;*q;q++)if(*q=='\t'){*q=0;if(col>=7)die("manifest columns");f[col++]=q+1;}if(col!=7)die("manifest columns");index++;if(index<first||index>=first+count){cursor=end+1;continue;}
        path(source,mat,f[1]);path(expected,mat,f[3]);verify(source,f[2]);verify(expected,f[4]);if(strcmp(f[5],"0"))die("expected rc");want=slurp(expected,&wantn);if(cx_fmt(name,sizeof name,"%s.bin",f[0]))die("image name");path(image,out,name);
        {char *v[]={"sh",product,source,"-o",image,0};int transport=run(v,root,&r),comp=r.rc,rr=-1;const char *state;char detail[512]={0};
            if(transport){state="UNKNOWN";unknown++;}else if(comp){state="REJECT";rejected++;}else{accepted++;np_free(&r);{char *rv[]={"sh",product,source,0};transport=run(rv,root,&r);}rr=r.rc;if(transport){state="UNKNOWN";unknown++;}else if(rr==0&&r.outn+r.errn==wantn&&!memcmp(r.out,want,r.outn)&&!memcmp(r.err,want+r.outn,r.errn)){state="PASS";}else{state="WRONG";wrong++;}}
            {size_t k=0;while(k<r.errn&&r.err[k]!='\n'&&k+1<sizeof detail){detail[k]=(r.err[k]=='\t'?' ':r.err[k]);k++;}detail[k]=0;}
            if(cx_fmt(name,sizeof name,"%s.stdout",f[0]))die("stdout name");path(p,out,name);save(p,r.out,r.outn);if(cx_fmt(name,sizeof name,"%s.stderr",f[0]))die("stderr name");path(p,out,name);save(p,r.err,r.errn);
            fprintf(report,"%s\t%d\t%d\t%s\t%s\n",f[0],comp,rr,state,detail);np_free(&r);
        }free(want);cursor=end+1;
    }free(manifest);if(index!=220)die("manifest must contain 220 cases");if(fclose(report))die("report close");printf("CTESTSUITE\tfirst=%d\tcount=%d\taccepted=%d\twrong=%d\trejected=%d\tunknown=%d\n",first,count,accepted,wrong,rejected,unknown);return wrong||rejected||unknown?1:0;
}
