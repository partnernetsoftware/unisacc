#pragma unisa use cxlib.ckassert
#pragma unisa use chrome_dom
/* tools/check-run-uxe-regress.cx -- 回归闸列出九条加 exist.
 * sh ./unisacc.com tools/check-run-uxe-regress.cx --
 */
static int failed;
int main(void) {
    FILE *f;
    char b[4096];
    long n;
    f = fopen("tools/run-uxe-regress.cx", "rb");
    if (!f) { printf("FAIL\tno-runner\n"); return 1; }
    n = fread(b, 1, 4095, f);
    fclose(f);
    if (n < 0) n = 0;
    b[n] = 0;
    ck_record(&failed, !!strstr(b, "check-ujs-gpu-tri.cx"), "gpu-tri");
    ck_record(&failed, !!strstr(b, "check-uxe-tex16.cx"), "tex16");
    ck_record(&failed, !!strstr(b, "check-uxe-tex2.cx"), "tex2");
    ck_record(&failed, !!strstr(b, "check-uxe-blend.cx"), "blend");
    ck_record(&failed, !!strstr(b, "check-uxep-v4.cx"), "v4");
    ck_record(&failed, !!strstr(b, "check-uxe-points-proj.cx"), "points-proj");
    ck_record(&failed, !!strstr(b, "check-uxe-font.cx"), "font");
    ck_record(&failed, !!strstr(b, "check-uxe-ss-tex.cx"), "ss-tex");
    ck_record(&failed, !!strstr(b, "check-gen-s0-assets.cx"), "gen-s0-assets");
    ck_record(&failed, !!strstr(b, "check-uxe-s0-exist.cx"), "s0-exist");
    printf("CHECK_RUN_UXE_REGRESS\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
