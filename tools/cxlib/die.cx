#pragma unisa module die
#pragma unisa use sys.io
#pragma unisa use sys.sig
/* The one failure exit for tools and checks: "TOOL: WHAT" or "TOOL: WHAT: DETAIL" (DETAIL may
 * be 0) on stderr, then exit RC.  It never returns.  The product has no _Noreturn, so that is
 * kept by tools/cx-lint.cx rule R3-die: every void function whose name ends in "die" must end
 * in an exit call, and a call to tool_die (or any other die) counts as one.
 * Not named cx_die: the cx_ prefix is reserved for the prelude (a product input). */
void tool_die(const char *tool, const char *what, const char *detail, int rc) {
    sy_eprintf("%s: %s%s%s\n", tool, what, detail ? ": " : "", detail ? detail : "");
    sy_exit(rc);
}
