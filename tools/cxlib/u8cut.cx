/* Cut points for text that is clipped at a byte count (a display width, a buffer cap, a tail size).  A cut that lands
 * on a UTF-8 continuation byte (0x80..0xBF) splits a character and leaves an invalid half sequence behind; these two
 * helpers move the cut to a character start.  They move cuts only: they never validate (cx/text/utf8.cx
 * tx_utf8_valid does), so a run of stray continuation bytes returns POS unchanged. */
#pragma unisa module u8cut

/* Largest C <= POS such that S[C] is not a continuation byte, i.e. S[0..C) never ends inside a character.
 * POS == N is always a boundary.  At most 3 bytes back.  -EINVAL for N < 0, null S with N > 0, POS outside 0..N. */
long u8c_floor(const char *s, long n, long pos) {
    long p = pos;
    if (n < 0 || (!s && n > 0) || pos < 0 || pos > n) return -EINVAL;
    if (pos == n) return pos;
    while (p > 0 && pos - p < 3 && ((unsigned char)s[p] & 0xC0) == 0x80) p--;
    return ((unsigned char)s[p] & 0xC0) == 0x80 ? pos : p;
}

/* Smallest C >= POS such that C == N or S[C] is not a continuation byte: where a tail that starts at byte offset POS
 * should begin so it does not start with half a character.  At most 3 bytes forward.  Errors as u8c_floor. */
long u8c_ceil(const char *s, long n, long pos) {
    long p = pos;
    if (n < 0 || (!s && n > 0) || pos < 0 || pos > n) return -EINVAL;
    while (p < n && p - pos < 3 && ((unsigned char)s[p] & 0xC0) == 0x80) p++;
    return p < n && ((unsigned char)s[p] & 0xC0) == 0x80 ? pos : p;
}
