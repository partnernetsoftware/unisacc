/* tools/cxlib/docslice.cx -- cut a Markdown document into retrieval slices (devsvc doc search T1).

   Interface (use cxlib.docslice):
     int  ds_slice(const char *path, const char *buf, size_t n, ds_out *out);   0 or a DS_E* code
     void ds_free(ds_out *out);
     const char *ds_errname(int rc);

   Pure: input is the file bytes, output the slice array.  No file IO, no lock, no text stored.

   Level-1 slice = one heading section: the heading line plus its own body up to the next heading of
   ANY level (child sections are their own slices).  Bytes before the first heading form the section
   "_preamble" (absent when empty).  A heading is 1..6 '#' then a space, outside ``` fences -- the same
   rule as cxlib.flowdoc (fd_level / fd_lines are static there, so the short rule is restated here).
   Section path: titles of the enclosing headings joined by '/', each title trimmed as flowdoc trims,
   '%' written %25 and '/' written %2F.

   Level-2 slicing: a section of more than DS_WIN code points is cut into windows.  Units (never split):
   a whole ``` fenced block, a run of table lines (first non-blank byte '|'), and otherwise sentences:
   a sentence ends after a full-width 。！？； , after ". " (the space is part of it), or at the end of
   the line (newline included).  Windows are filled greedily with whole units up to DS_WIN code points
   (one unit that is larger alone becomes its own oversize window).  The next window starts at the
   earliest unit boundary such that the overlap with the previous window is at most DS_OVL code points,
   and always after the previous window's start, so starts are strictly increasing and the union of
   windows covers the section with no gap.

   Each slice: id "PATH#SECPATH~WIN@SHA8" (SHA8 = first 8 hex of sha256 of the window bytes), section
   path, window number (0..), bytes [b0,b1), lines l0..l1 (1-based, inclusive), chars (code points).
   Errors by name: DS_EUTF8 (malformed UTF-8, offset in out->bad), DS_ENOMEM, DS_ETOOBIG (input over
   DS_MAXN bytes), DS_ELONG (path or section path over its bound). */
#pragma unisa module docslice
#pragma unisa use sys.sha
#pragma unisa use mem.heap
#pragma unisa use text.text

#define DS_WIN 512
#define DS_OVL 80
#define DS_MAXN (64L * 1024 * 1024)
#define DS_EUTF8 2
#define DS_ENOMEM 3
#define DS_ETOOBIG 4
#define DS_ELONG 5

typedef struct {
    char id[1600];
    char sec[1024];
    int win;
    long b0, b1, l0, l1, chars;
} ds_slice_t;

typedef struct {
    ds_slice_t *v;
    long n, cap;
    long bad;
} ds_out;

const char *ds_errname(int rc) {
    if (rc == 0) return "OK";
    if (rc == DS_EUTF8) return "EUTF8";
    if (rc == DS_ENOMEM) return "ENOMEM";
    if (rc == DS_ETOOBIG) return "ETOOBIG";
    if (rc == DS_ELONG) return "ELONG";
    return "EUNKNOWN";
}

void ds_free(ds_out *o) {
    if (o->v) mm_free(o->v);
    o->v = 0; o->n = 0; o->cap = 0;
}

/* -1 when [b,b+n) is valid UTF-8 (no overlong, no surrogate, max U+10FFFF), else the bad offset */
static long ds_utf8_bad(const unsigned char *b, long n) {
    long i = 0;
    while (i < n) {
        unsigned c = b[i];
        long k;
        unsigned lo = 0x80, hi = 0xBF;
        if (c < 0x80) { i++; continue; }
        else if (c >= 0xC2 && c <= 0xDF) k = 1;
        else if (c >= 0xE0 && c <= 0xEF) { k = 2; if (c == 0xE0) lo = 0xA0; if (c == 0xED) hi = 0x9F; }
        else if (c >= 0xF0 && c <= 0xF4) { k = 3; if (c == 0xF0) lo = 0x90; if (c == 0xF4) hi = 0x8F; }
        else return i;
        if (i + k >= n) return i;
        if (b[i + 1] < lo || b[i + 1] > hi) return i;
        for (long j = 2; j <= k; j++) if (b[i + j] < 0x80 || b[i + j] > 0xBF) return i;
        i += k + 1;
    }
    return -1;
}

static long ds_chars(const char *b, long s, long e) {
    long c = 0;
    for (long i = s; i < e; i++) if (((unsigned char)b[i] & 0xC0) != 0x80) c++;
    return c;
}

static int ds_level(const char *s, long n) {
    int l = 0;
    while (l < n && s[l] == '#') l++;
    if (l == 0 || l > 6 || l >= n || s[l] != ' ') return 0;
    return l;
}

typedef struct { long off, end; int lv, fence, fl, table; } ds_line;

/* off/end per line (end excludes '\n'); fl = fence line, fence = fence line or inside a fence */
static long ds_lines(const char *b, long n, ds_line **out) {
    long cnt = 1, k = 0, s = 0;
    for (long i = 0; i < n; i++) if (b[i] == '\n') cnt++;
    ds_line *L = (ds_line *)mm_alloc(sizeof(ds_line) * (cnt + 1));
    if (!L) return -1;
    int fence = 0;
    for (long i = 0; i <= n; i++) {
        if (i == n || b[i] == '\n') {
            if (i == n && s == n) break;
            long ln = i - s, a = 0;
            L[k].off = s; L[k].end = i; L[k].lv = 0; L[k].table = 0; L[k].fl = 0;
            if (ln >= 3 && b[s] == '`' && b[s + 1] == '`' && b[s + 2] == '`') { fence = !fence; L[k].fence = 1; L[k].fl = 1; }
            else {
                L[k].fence = fence;
                if (!fence) L[k].lv = ds_level(b + s, ln);
                while (a < ln && (b[s + a] == ' ' || b[s + a] == '\t')) a++;
                if (!fence && a < ln && b[s + a] == '|') L[k].table = 1;
            }
            k++;
            s = i + 1;
        }
    }
    *out = L;
    return k;
}

/* 1-based line of byte offset p */
static long ds_lineof(ds_line *L, long nl, long p) {
    long lo = 0, hi = nl - 1;
    while (lo < hi) {
        long m = (lo + hi + 1) / 2;
        if (L[m].off <= p) lo = m; else hi = m - 1;
    }
    return lo + 1;
}

/* append title of heading line (trimmed, % and / escaped) to d at *w; -1 on overflow */
static int ds_put_title(char *d, long cap, long *w, const char *s, long n, int lv) {
    long a = lv, b = n;
    while (a < b && (s[a] == ' ' || s[a] == '\t')) a++;
    while (b > a && (s[b - 1] == ' ' || s[b - 1] == '\t' || s[b - 1] == '\r' || s[b - 1] == '#')) b--;
    while (b > a && s[b - 1] == ' ') b--;
    for (long i = a; i < b; i++) {
        const char *rep = 0;
        if (s[i] == '/') rep = "%2F";
        else if (s[i] == '%') rep = "%25";
        long need = rep ? 3 : 1;
        if (*w + need >= cap) return -1;
        if (rep) { d[*w] = rep[0]; d[*w + 1] = rep[1]; d[*w + 2] = rep[2]; }
        else d[*w] = s[i];
        *w += need;
    }
    d[*w] = 0;
    return 0;
}

static int ds_push(ds_out *o, const char *path, const char *sec, int win, const char *b, long b0, long b1, ds_line *L, long nl) {
    if (o->n == o->cap) {
        long nc = o->cap ? o->cap * 2 : 16;
        ds_slice_t *nv = (ds_slice_t *)mm_alloc(sizeof(ds_slice_t) * nc);
        if (!nv) return DS_ENOMEM;
        for (long i = 0; i < o->n; i++) nv[i] = o->v[i];
        if (o->v) mm_free(o->v);
        o->v = nv; o->cap = nc;
    }
    ds_slice_t *x = &o->v[o->n];
    char hex[65];
    if (sy_sha256_hex(b + b0, b1 - b0, hex) != 0) return DS_ENOMEM;
    hex[8] = 0;
    long sl = tx_len(sec, (long)sizeof x->sec);
    if (sl >= (long)sizeof x->sec) return DS_ELONG;
    for (long i = 0; i <= sl; i++) x->sec[i] = sec[i];
    int f = snprintf(x->id, sizeof x->id, "%s#%s~%d@%s", path, sec, win, hex);
    if (f < 0 || f >= (int)sizeof x->id) return DS_ELONG;
    x->win = win; x->b0 = b0; x->b1 = b1;
    x->l0 = ds_lineof(L, nl, b0);
    x->l1 = ds_lineof(L, nl, b1 > b0 ? b1 - 1 : b0);
    x->chars = ds_chars(b, b0, b1);
    o->n++;
    return 0;
}

/* end of the sentence unit starting at p inside line content [p,e) */
static long ds_sent_end(const char *b, long p, long e) {
    for (long i = p; i < e; i++) {
        unsigned char c = (unsigned char)b[i];
        if (c == 0xE3 && i + 2 < e && (unsigned char)b[i + 1] == 0x80 && (unsigned char)b[i + 2] == 0x82) return i + 3;
        if (c == 0xEF && i + 2 < e && (unsigned char)b[i + 1] == 0xBC) {
            unsigned char t = (unsigned char)b[i + 2];
            if (t == 0x81 || t == 0x9F || t == 0x9B) return i + 3;
        }
        if (c == '.' && i + 1 < e && b[i + 1] == ' ') return i + 2;
    }
    return e;
}

/* unit starts of section lines [li,lj) into u (unit k = [u[k],u[k+1])); count or -1 */
static long ds_units(const char *b, ds_line *L, long li, long lj, long secend, long *u, long ucap) {
    long k = 0, i = li;
    while (i < lj) {
        if (k >= ucap) return -1;
        if (L[i].table) {
            u[k++] = L[i].off;
            while (i < lj && L[i].table) i++;
            continue;
        }
        if (L[i].fl) {
            u[k++] = L[i].off;
            long j = i + 1;
            while (j < lj && !L[j].fl) j++;
            i = j < lj ? j + 1 : lj;
            continue;
        }
        long le = i + 1 < lj ? L[i + 1].off : secend;
        long p = L[i].off;
        while (p < le) {
            if (k >= ucap) return -1;
            u[k++] = p;
            long q = ds_sent_end(b, p, L[i].end);
            p = q >= L[i].end ? le : q;
        }
        i++;
    }
    return k;
}

static int ds_section(ds_out *o, const char *path, const char *sec, const char *b, long n, ds_line *L, long nl, long li, long lj) {
    long s = L[li].off, e = lj < nl ? L[lj].off : n;
    if (e <= s) return 0;
    if (ds_chars(b, s, e) <= DS_WIN) return ds_push(o, path, sec, 0, b, s, e, L, nl);
    long ucap = (e - s) + 2;
    long *u = (long *)mm_alloc(sizeof(long) * (ucap + 1));
    if (!u) return DS_ENOMEM;
    long nu = ds_units(b, L, li, lj, e, u, ucap);
    if (nu <= 0) { mm_free(u); return DS_ENOMEM; }
    u[nu] = e;
    long u0 = 0;
    int win = 0, rc = 0;
    while (u0 < nu) {
        long k = u0 + 1;
        while (k < nu && ds_chars(b, u[u0], u[k + 1]) <= DS_WIN) k++;
        rc = ds_push(o, path, sec, win++, b, u[u0], u[k], L, nl);
        if (rc || k >= nu) break;
        long st = k;
        while (st - 1 > u0 && ds_chars(b, u[st - 1], u[k]) <= DS_OVL) st--;
        u0 = st;
    }
    mm_free(u);
    return rc;
}

int ds_slice(const char *path, const char *buf, size_t n, ds_out *o) {
    o->v = 0; o->n = 0; o->cap = 0; o->bad = -1;
    if (tx_len(path, 512) >= 512) return DS_ELONG;
    if ((long)n > DS_MAXN) return DS_ETOOBIG;
    long bad = ds_utf8_bad((const unsigned char *)buf, (long)n);
    if (bad >= 0) { o->bad = bad; return DS_EUTF8; }
    if (n == 0) return 0;
    ds_line *L = 0;
    long nl = ds_lines(buf, (long)n, &L);
    if (nl < 0) return DS_ENOMEM;
    char sp[1024];
    long tw[7];
    int rc = 0;
    long first = 0;
    for (int d = 0; d < 7; d++) tw[d] = -1;
    while (first < nl && !L[first].lv) first++;
    if (first > 0) rc = ds_section(o, path, "_preamble", buf, (long)n, L, nl, 0, first);
    for (long i = first; !rc && i < nl; i++) {
        if (!L[i].lv) continue;
        int lv = L[i].lv;
        long j = i + 1, w = 0;
        while (j < nl && !L[j].lv) j++;
        tw[lv] = i;
        for (int d = lv + 1; d <= 6; d++) tw[d] = -1;
        sp[0] = 0;
        for (int d = 1; d <= lv && !rc; d++) {
            long h = tw[d];
            if (h < 0) continue;
            if (w > 0) { if (w + 1 >= (long)sizeof sp) { rc = DS_ELONG; break; } sp[w++] = '/'; sp[w] = 0; }
            if (ds_put_title(sp, sizeof sp, &w, buf + L[h].off, L[h].end - L[h].off, d) < 0) rc = DS_ELONG;
        }
        if (!rc) rc = ds_section(o, path, sp, buf, (long)n, L, nl, i, j);
        i = j - 1;
    }
    mm_free(L);
    if (rc) ds_free(o);
    return rc;
}
