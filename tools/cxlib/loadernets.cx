/* Shared model-package receipt scanning. ln_select returns an owned complete M
 * record for the exact stage+route; callers free it. Malformed inputs refuse. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use mem.bytes
#pragma unisa use runtime.codec

typedef struct {char *p;size_t n,at;char text[2048];} ln_scan;
static void ln_die(const char *s){fprintf(stderr,"loadernets: %s\n",s);exit(2);}
char *ln_next(ln_scan *s){size_t start=s->at;while(s->at<s->n&&s->p[s->at]!='\n')s->at++;size_t z=s->at-start;if(s->at==s->n||!z||z>=sizeof s->text||mm_copy(s->text,sizeof s->text,s->p+start,(long)z))ln_die("receipt row");s->text[z]=0;s->at++;return s->text;}
void ln_digest(const char *path,char hash[65]){size_t n;char *b=cx_read(path,&n);if(!b)ln_die("digest input");cx_sha256_hex(b,n,hash);free(b);}
/* Return the owned file buffer, with scan positioned at the first D row. */
char *ln_package(const char *models,ln_scan *s,long *nm,long *ns){
 size_t n;char *b=cx_read(models,&n);if(!b||n<16||memcmp(b+n-16,"UNIPKG1\n",8))ln_die("models require UNIPKG1 footer");unsigned long long len=0;for(int i=7;i>=0;i--)len=(len<<8)|(unsigned char)b[n-8+i];if(!len||len>n-16)ln_die("models footer extent");s->p=b+n-16-(size_t)len;s->n=(size_t)len;s->at=0;
 long ver,nr;if(sscanf(ln_next(s),"P %ld %ld %ld %ld",&ver,nm,ns,&nr)!=4||*nm<=0||*nm>65536||*ns<=0||*ns>65536)ln_die("models header");return b;
}
void ln_select(const char *models,const char *stage,const char *route,long *index,size_t *recordn,char **record){
 ln_scan s={0};long nm,ns,wanted=-1,matched=-1;char *b=ln_package(models,&s,&nm,&ns);*record=0;*recordn=0;
 for(long i=0;i<ns;i++){char dr[512],ds[512],in[512],out[512];long di;if(sscanf(ln_next(&s),"D %511s %511s %511s %511s %ld",dr,ds,in,out,&di)!=5||di<0||di>=nm)ln_die("models directory");if(!strcmp(ds,stage)){if(wanted<0)wanted=di;if(!strcmp(dr,route)){if(matched>=0&&matched!=di)ln_die("route directory index mismatch");matched=di;}}}
 if(wanted<0)ln_die("stage directory missing");if(matched<0)ln_die("route directory missing");wanted=matched;
 for(long i=0;i<nm;i++){size_t start=s.at;long clen,raw,codec;unsigned long crc;if(sscanf(ln_next(&s),"M %ld %ld %ld %lu",&clen,&raw,&codec,&crc)!=4||clen<=0||(size_t)clen>s.n-s.at)ln_die("models M extent");size_t bytes=s.at-start+(size_t)clen;if(i==wanted){*record=malloc(bytes);if(!*record)ln_die("selected M allocation");if(mm_copy(*record,bytes,s.p+start,(long)bytes))ln_die("selected M copy");*recordn=bytes;}s.at+=(size_t)clen;}
 *index=wanted;free(b);
}

/* Deployment v2 binds eight member files and actual slice/package bytes,
 * never inherited environment. Inputs must remain frozen throughout seal or
 * verification. This is not a full source-closure certificate or a defense
 * against hostile concurrent filesystem changes. */
typedef struct {char root[4096],loader[4400],slice[4096],models[4096],swap[4400],target[64],version[128],receipt_sha[65];} LnDeployment;
static char *ln_d_read(const char *p,size_t *n){struct stat a,z;if(lstat(p,&a)||!S_ISREG(a.st_mode)||a.st_size<=0||a.st_size>16777216)ln_die("deployment regular bound");int fd=open(p,O_RDONLY|O_NOFOLLOW|O_NONBLOCK);if(fd<0||fstat(fd,&z)||a.st_dev!=z.st_dev||a.st_ino!=z.st_ino)ln_die("deployment descriptor");char *b=malloc(a.st_size+1);if(!b)ln_die("deployment allocation");size_t at=0;while(at<(size_t)a.st_size){ssize_t k=read(fd,b+at,a.st_size-at);if(k<0&&errno==EINTR)continue;if(k<=0)ln_die("deployment read");at+=k;}char tail;if(read(fd,&tail,1)||fstat(fd,&z)||a.st_size!=z.st_size||close(fd))ln_die("deployment changed");b[at]=0;*n=at;return b;}
static void ln_d_path(char *p,size_t cap,const char *a,const char *b){if(cx_fmt(p,cap,"%s/%s",a,b))ln_die("deployment path bound");}
static void ln_d_canonical(const char *p){char b[4096];if(!realpath(p,b)||strcmp(p,b)||strpbrk(p,"\t\r\n"))ln_die("deployment canonical path");}
static unsigned long ln_d_le(const unsigned char *p,int n){unsigned long v=0;for(int i=n-1;i>=0;i--)v=(v<<8)|p[i];return v;}
static size_t ln_d_package(const unsigned char *b,size_t n){if(n<16||memcmp(b+n-16,"UNIPKG1\n",8))ln_die("deployment footer");unsigned long long z=0;for(int i=7;i>=0;i--)z=(z<<8)|b[n-8+i];if(!z||z>n-16)ln_die("deployment package extent");size_t at=n-16-z;if(z<4||(memcmp(b+at,"P 3 ",4)&&memcmp(b+at,"P 4 ",4)))ln_die("deployment P3/P4");return at;}
static const char *ln_d_slot(const char *target){if(!strcmp(target,"lnx/x86_64"))return "Linuxx86_64) o=";if(!strcmp(target,"lnx/arm64"))return "Linuxaarch64|Linuxarm64) o=";if(!strcmp(target,"osx/x86_64"))return "Darwinx86_64) o=";if(!strcmp(target,"osx/arm64"))return "Darwinarm64) o=";ln_die("deployment target");return 0;}
static void ln_d_members(const unsigned char *candidate,size_t cn,const unsigned char *slice,size_t sn,const unsigned char *models,size_t mn,const char *target){int cpu_ok=0;if(sn>=64&&!memcmp(slice,"\177ELF\2\1",6)){unsigned long cpu=ln_d_le(slice+18,2);cpu_ok=(cpu==62&&!strcmp(target,"lnx/x86_64"))||(cpu==183&&!strcmp(target,"lnx/arm64"));}else if(sn>=32&&!memcmp(slice,"\317\372\355\376",4)){unsigned long cpu=ln_d_le(slice+4,4);cpu_ok=(cpu==16777223&&!strcmp(target,"osx/x86_64"))||(cpu==16777228&&!strcmp(target,"osx/arm64"));}if(!cpu_ok)ln_die("deployment slice CPU/target");size_t cp=ln_d_package(candidate,cn),mp=ln_d_package(models,mn);if(cn-cp!=mn-mp||memcmp(candidate+cp,models+mp,cn-cp))ln_die("deployment candidate package mismatch");if(cp==sn&&!memcmp(candidate,slice,sn))return;
 /* Reuse logic-distribution's launcher index + runtime.codec inflate/CRC.
  * Only the validated DOS stub is searched, with exactly one selected slot. */
 if(cn<64||memcmp(candidate,"MZ",2))ln_die("deployment native prefix mismatch");unsigned long pe=ln_d_le(candidate+60,4);if(pe<64||pe>65536||pe>cn-4||memcmp(candidate+pe,"PE\0\0",4))ln_die("deployment APE header");char *head=malloc(pe+1);if(!head||mm_copy(head,pe+1,candidate,pe))ln_die("deployment header copy");for(size_t i=0;i<pe;i++)if(!head[i])head[i]=' ';head[pe]=0;const char *slot=ln_d_slot(target);char *p=strstr(head,slot);if(!p||strstr(p+strlen(slot),slot)||(p>head&&p[-1]!=' '&&p[-1]!='\n'))ln_die("deployment slot uniqueness");p+=strlen(slot);char *e;errno=0;unsigned long off=strtoul(p,&e,10);if(errno||e==p||strncmp(e," n=",3)||off<1)ln_die("deployment slot offset");p=e+3;errno=0;unsigned long len=strtoul(p,&e,10);if(errno||e==p||strncmp(e," k=",3)||len<18||off-1>cp||len>cp-(off-1))ln_die("deployment slot length");free(head);const unsigned char *gz=candidate+off-1;if(memcmp(gz,"\037\213\010\000",4)||ln_d_le(gz+len-4,4)!=sn)ln_die("deployment gzip header/size");unsigned char *raw=malloc(sn?sn:1);if(!raw||cxcodec_inflate(raw,sn,gz+10,len-18))ln_die("deployment inflate");CxCodecCrc crc;uint32_t value;cxcodec_crc_init(&crc);if(cxcodec_crc(&crc,(char*)raw,sn,&value)||value!=ln_d_le(gz+len-8,4)||memcmp(raw,slice,sn))ln_die("deployment slice CRC/bytes");free(raw);}
static void ln_d_line(char *out,size_t *at,const char *key,const char *path){size_t n;char *b=ln_d_read(path,&n),h[65];if(sy_sha256_hex(b,n,h)&&cx_sha256_hex(b,n,h))ln_die("deployment SHA");free(b);if(cx_fmt(out+*at,65536-*at,"%s\t%s\t%s\t%lu\n",key,path,h,(unsigned long)n))ln_die("deployment receipt bound");*at+=strlen(out+*at);}
char *ln_deployment_record(const char *root,const char *dir,const char *candidate,const char *slice,const char *models,const char *target,const char *version,size_t *n){ln_d_canonical(root);ln_d_canonical(dir);ln_d_canonical(candidate);ln_d_canonical(slice);ln_d_canonical(models);ln_d_slot(target);if(!*version||strlen(version)>100||strspn(version,"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-")!=strlen(version))ln_die("deployment version");char expected[4400];ln_d_path(expected,sizeof expected,root,"unisacc.com");if(strcmp(candidate,expected))ln_die("deployment candidate/root");size_t cn,sn,mn;unsigned char *c=(unsigned char*)ln_d_read(candidate,&cn),*s=(unsigned char*)ln_d_read(slice,&sn),*m=(unsigned char*)ln_d_read(models,&mn);ln_d_members(c,cn,s,sn,m,mn,target);free(c);free(s);free(m);char *record=malloc(65536);if(!record)ln_die("deployment record allocation");if(cx_fmt(record,65536,"LOADER_DEPLOYMENT\t2\nroot\t%s\ntarget\t%s\nversion\t%s\n",root,target,version))ln_die("deployment metadata bound");size_t at=strlen(record);ln_d_line(record,&at,"candidate",candidate);ln_d_line(record,&at,"slice",slice);ln_d_line(record,&at,"models",models);char path[4400];ln_d_path(path,sizeof path,dir,"test-loader");ln_d_line(record,&at,"loader",path);ln_d_path(path,sizeof path,dir,"p3-swap");ln_d_line(record,&at,"swap",path);const char *sources[]={"tools/units-prepare.cx","tools/test-loader.cx","tools/lab-loader/p3-swap.cx"};for(int i=0;i<3;i++){ln_d_path(path,sizeof path,root,sources[i]);ln_d_line(record,&at,sources[i],path);}if(cx_fmt(record+at,65536-at,"COMPLETE\t8\n"))ln_die("deployment footer bound");*n=at+strlen(record+at);return record;}
static char *ln_d_row(char **at,const char *key){char *p=*at,*e=strchr(p,'\n');size_t k=strlen(key);if(!e||strncmp(p,key,k)||p[k]!='\t')ln_die("deployment row");*e=0;*at=e+1;return p+k+1;}
void ln_deployment_verify(const char *root,const char *dir,const char *candidate,const char *sha,LnDeployment *result){char file[4400];ln_d_path(file,sizeof file,dir,"loader6-bound.tsv");size_t n;char *original=ln_d_read(file,&n);if(n>65536||memchr(original,0,n)||memchr(original,'\r',n))ln_die("deployment manifest shape");char h[65];if(sy_sha256_hex(original,n,h)&&cx_sha256_hex(original,n,h))ln_die("deployment manifest SHA");if(strlen(sha)!=64||strcmp(sha,h))ln_die("deployment manifest identity");char *copy=malloc(n+1);if(!copy||mm_copy(copy,n+1,original,n+1))ln_die("deployment parse copy");char *at=copy;char *v=ln_d_row(&at,"LOADER_DEPLOYMENT");if(strcmp(v,"2"))ln_die("deployment version");v=ln_d_row(&at,"root");if(strcmp(v,root))ln_die("deployment root identity");char *target=ln_d_row(&at,"target"),*version=ln_d_row(&at,"version");const char *keys[]={"candidate","slice","models","loader","swap","tools/units-prepare.cx","tools/test-loader.cx","tools/lab-loader/p3-swap.cx"};char *paths[8];for(int i=0;i<8;i++){paths[i]=ln_d_row(&at,keys[i]);char *tab=strchr(paths[i],'\t');if(!tab)ln_die("deployment member row");*tab=0;}v=ln_d_row(&at,"COMPLETE");if(strcmp(v,"8")||*at||strcmp(paths[0],candidate))ln_die("deployment complete/candidate");size_t rn;char *rebuilt=ln_deployment_record(root,dir,candidate,paths[1],paths[2],target,version,&rn);if(rn!=n||memcmp(rebuilt,original,n))ln_die("deployment member identity");if(cx_fmt(result->root,sizeof result->root,"%s",root)||cx_fmt(result->slice,sizeof result->slice,"%s",paths[1])||cx_fmt(result->models,sizeof result->models,"%s",paths[2])||cx_fmt(result->target,sizeof result->target,"%s",target)||cx_fmt(result->version,sizeof result->version,"%s",version)||cx_fmt(result->receipt_sha,sizeof result->receipt_sha,"%s",h))ln_die("deployment result bound");ln_d_path(result->loader,sizeof result->loader,dir,"test-loader");ln_d_path(result->swap,sizeof result->swap,dir,"p3-swap");free(rebuilt);free(copy);free(original);}
