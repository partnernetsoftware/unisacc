   as_ref *g=realloc(m->ref,(size_t)(m->nref+1)*sizeof *g);if(!g){rc=as_bad(why,cap,"allocation","receipt",0);break;}m->ref=g;as_ref *r=&g[m->nref++];memset(r,0,sizeof *r);r->wave=w->wave;
