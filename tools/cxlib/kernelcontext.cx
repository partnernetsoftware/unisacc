#pragma unisa module kernelcontext
#pragma unisa use netpack
#pragma unisa use kernelinputs
/* CLI construction identity contract. All storage is invocation-owned; caller
 * borrows a 65-byte result buffer. Failure terminates the construction process.
 * This does not validate runtime behavior or claim a test result.
 *
 * source_sha is the full-tree SID (identity-helper), kept for external source
 * matching. The kernel context itself is the narrowed real-input identity: 24
 * kernel sources + 6 tools, no full-tree SID, no tests, no thin head. */
static void kc_die(const char *s){fprintf(stderr,"kernel-context: REFUSE %s\n",s);exit(2);}
static void kc_path(char *p,size_t cap,const char *a,const char *b){int n=snprintf(p,cap,"%s/%s",a,b);if(n<0||(size_t)n>=cap)kc_die("path bound");}
static char *kc_load(const char *p,size_t *n){struct stat st;if(lstat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>268435456)kc_die(p);char *s=cx_read(p,n);if(!s||*n!=(size_t)st.st_size)kc_die("read/size changed");return s;}
void kc_check(const char *root,const char *dir,char *source_sha){
 char p[4400],helper[4400],h[65],why[1024],bound[4400];size_t n;kc_path(helper,sizeof helper,dir,"identity-helper");char *s=kc_load(helper,&n);cx_sha256_hex(s,n,h);free(s);kc_path(p,sizeof p,dir,"identity-helper.sha256");s=kc_load(p,&n);if(n!=64||memcmp(s,h,64))kc_die("identity helper digest");free(s);
 kc_path(bound,sizeof bound,root,"tools/bound");char *v[]={bound,"15",helper,(char *)root,0};np_result r;if(np_run(v,root,0,20,&r,why,sizeof why))kc_die(why);if(r.rc||r.errn||r.outn!=65||r.out[64]!='\n')kc_die("source identity helper");memcpy(source_sha,r.out,64);source_sha[64]=0;np_free(&r);
 char file_sha[24][65];const char *fptrs[24];char tool_sha[6][65];const char *tptrs[6];char body[4096];long bn;int i;for(i=0;i<24;i++){kc_path(p,sizeof p,root,ki_kernel_source(i));s=kc_load(p,&n);cx_sha256_hex(s,n,file_sha[i]);free(s);fptrs[i]=file_sha[i];}char ksrc[65];ki_kernel_source_sha(fptrs,ksrc);for(i=0;i<6;i++){kc_path(p,sizeof p,root,ki_context_file(i));s=kc_load(p,&n);cx_sha256_hex(s,n,tool_sha[i]);free(s);tptrs[i]=tool_sha[i];}bn=ki_context_body(body,sizeof body,ksrc,tptrs);if(bn<0)kc_die("context body bound");cx_sha256_hex(body,(size_t)bn,h);
 kc_path(p,sizeof p,dir,"context.sha256");s=kc_load(p,&n);if(n!=65||memcmp(s,h,64)||s[64]!='\n')kc_die("kernel source/tool context changed");free(s);
}
