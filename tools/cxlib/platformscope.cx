/* Which batch platforms a wave may run on this host: shared by s9-shards (commit and
   release membership) and by tools/affected.cx when it decides what a change selects.
   A batch built for another native host is NOT_APPLICABLE here, never a failure.
   Kept dependency-free on purpose: a tool that already carries np_result (sysx.process
   and netpack both define it) can use this without pulling in a second definition. */
#pragma unisa use text.text
/* host_scope names the platform this process runs on; today only lnx/x86_64 is built. */
int psc_platform_allowed(const char *platform){return !strcmp(platform,"lnx/x86_64");}
const char *psc_host_scope(void){return "lnx/x86_64";}
