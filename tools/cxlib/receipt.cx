#pragma unisa module receipt
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.posix
#pragma unisa use sys.sha
#pragma unisa use sys.time
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
/* Unified phase receipt: input identity recorded, adoption by one comparison.
 * Receipt file (text, one "key<TAB>value" per line, backward compatible: readers that look up
 * single keys ignore the new lines):
 *   phase<TAB>ID / inputs_sha<TAB>HEX64 / output_sha<TAB>HEX64
 * rc_hash_inputs hashes the inputs declared for a phase in the side table build/chain-phase-inputs.tsv
 * (id<TAB>comma list of phase:ID | src:GLOB | table:PATH). src:git-tree is the git tree hash of HEAD,
 * src:DIR/** is every regular file under DIR (sorted walk, path + content sha), src:PATH one file,
 * table:PATH the file content, phase:ID the output_sha recorded in RECDIR/ID.receipt.
 * Anything that cannot be computed (missing row, unknown token, empty glob, unreadable file, upstream
 * receipt missing) fails: rc_adopt_ok then answers STALE, never optimistic.
 * rc_write is atomic (temp file + rename). No cache: every call re-reads and re-hashes. */
static char rc_why_buf[160];
static char *rc_acc;
static size_t rc_acc_n, rc_acc_cap;
static int rc_acc_fail;
static size_t rc_root_n;

static int rc_fail(const char *why, const char *detail) {
    cx_fmt(rc_why_buf, sizeof rc_why_buf, "%s:%s", why, detail ? detail : "");
    return 1;
}
const char *rc_why(void) { return rc_why_buf; }
static void rc_put(const char *s, size_t n) {
    if (rc_acc_n + n + 1 > rc_acc_cap) {
        size_t c = rc_acc_cap ? rc_acc_cap : 4096;
        char *g;
        while (c < rc_acc_n + n + 1) c *= 2;
        g = realloc(rc_acc, c);
        if (!g) { rc_acc_fail = 1; return; }
        rc_acc = g; rc_acc_cap = c;
    }
    if (mm_copy(rc_acc + rc_acc_n, rc_acc_cap - rc_acc_n, s, n)) { rc_acc_fail = 1; return; }
    rc_acc_n += n;
}
static int rc_file_line(const char *label, const char *path) {
    size_t n = 0; char *b = cx_read(path, &n); char h[65];
    if (!b) return rc_fail("unreadable", path);
    if (sy_sha256_hex(b, (long)n, h)) { free(b); return rc_fail("sha", path); }
    free(b);
    rc_put(label, strlen(label)); rc_put("\t", 1); rc_put(h, 64); rc_put("\n", 1);
    return 0;
}
static int rc_take(const char *path, void *ctx) {
    (void)ctx;
    if (rc_file_line(path + rc_root_n, path)) rc_acc_fail = 2;
    return rc_acc_fail ? 1 : 0;
}
/* value of key in a receipt text; 0 ok */
static int rc_field(const char *text, size_t n, const char *key, char *buf, size_t cap) {
    char pat[80]; size_t k, i, e;
    if (cx_fmt(pat, sizeof pat, "\n%s\t", key)) return 1;
    k = strlen(pat);
    for (i = 0; i + k <= n; i++) if (!memcmp(text + i, pat, k)) break;
    if (i + k > n) return 1;
    i += k;
    for (e = i; e < n && text[e] != '\n'; e++) {}
    if (e == i || e - i >= cap) return 1;
    if (mm_copy(buf, cap, text + i, e - i)) return 1;
    buf[e - i] = 0;
    return 0;
}
static int rc_get(const char *rec, const char *key, char *buf, size_t cap) {
    size_t n = 0; char *t = cx_read(rec, &n), *w; int rc;
    if (!t || !n) { free(t); return 1; }
    w = malloc(n + 2);
    if (!w) { free(t); return 1; }
    w[0] = '\n';
    if (mm_copy(w + 1, n + 1, t, n)) { free(w); free(t); return 1; }
    w[n + 1] = 0;
    rc = rc_field(w, n + 1, key, buf, cap);
    free(w); free(t);
    return rc;
}
static int rc_token(const char *root, const char *recdir, const char *tok, size_t tn) {
    char t[512], p[1100], v[80], h[65];
    if (tn == 0 || tn >= sizeof t) return rc_fail("token", "len");
    if (mm_copy(t, sizeof t, tok, tn)) return rc_fail("token", "copy");
    t[tn] = 0;
    if (!strncmp(t, "table:", 6)) {
        if (cx_fmt(p, sizeof p, "%s/%s", root, t + 6)) return rc_fail("path", t);
        return rc_file_line(t, p);
    }
    if (!strncmp(t, "phase:", 6)) {
        if (cx_fmt(p, sizeof p, "%s/%s.receipt", recdir, t + 6)) return rc_fail("path", t);
        if (rc_get(p, "output_sha", v, sizeof v) || strlen(v) != 64) return rc_fail("upstream", t + 6);
        rc_put(t, strlen(t)); rc_put("\t", 1); rc_put(v, 64); rc_put("\n", 1);
        return 0;
    }
    if (!strncmp(t, "src:", 4)) {
        const char *g = t + 4; size_t gl = strlen(g);
        if (!strcmp(g, "git-tree")) {
            char *out = 0; size_t on = 0; char cmd[600];
            if (cx_fmt(cmd, sizeof cmd, "git -C '%s' rev-parse 'HEAD^{tree}'", root)) return rc_fail("path", t);
            if (cx_run_timeout(cmd, 20, &out, &on) || on < 40) { free(out); return rc_fail("git-tree", root); }
            if (sy_sha256_hex(out, (long)on, h)) { free(out); return rc_fail("sha", t); }
            free(out);
            rc_put(t, strlen(t)); rc_put("\t", 1); rc_put(h, 64); rc_put("\n", 1);
            return 0;
        }
        if (gl > 3 && !strcmp(g + gl - 3, "/**")) {
            char d[1100]; size_t before = rc_acc_n;
            if (cx_fmt(d, sizeof d, "%s/%.*s", root, (int)(gl - 3), g)) return rc_fail("path", t);
            rc_root_n = strlen(root) + 1;
            rc_acc_fail = 0;
            if (cx_walk(d, rc_take, 0) || rc_acc_fail) return rc_fail("walk", g);
            if (rc_acc_n == before) return rc_fail("empty-glob", g);
            return 0;
        }
        if (strchr(g, '*')) return rc_fail("unsupported-glob", g);
        if (cx_fmt(p, sizeof p, "%s/%s", root, g)) return rc_fail("path", t);
        return rc_file_line(t, p);
    }
    return rc_fail("unknown-token", t);
}
/* 0 and hex[65] on success; 1 when the identity cannot be computed (reason in rc_why()). */
int rc_hash_inputs(const char *root, const char *recdir, const char *table, const char *phase, char hex[65]) {
    size_t n = 0, i = 0, pl = strlen(phase); char *t = cx_read(table, &n); int found = 0, rc = 0;
    hex[0] = 0;
    if (!t) return rc_fail("no-table", table);
    rc_acc_n = 0; rc_acc_fail = 0;
    while (i < n) {
        size_t e = i, tab, ee;
        while (e < n && t[e] != '\n') e++;
        if (t[i] != '#' && e - i > pl + 1 && !memcmp(t + i, phase, pl) && t[i + pl] == '\t') {
            found = 1; tab = i + pl + 1;
            while (tab < e) {
                for (ee = tab; ee < e && t[ee] != ','; ee++) {}
                if (rc_token(root, recdir, t + tab, ee - tab)) { rc = 1; break; }
                tab = ee + 1;
            }
            break;
        }
        i = e + 1;
    }
    free(t);
    if (rc) return 1;
    if (!found) return rc_fail("no-row", phase);
    if (rc_acc_fail || !rc_acc_n) return rc_fail("empty", phase);
    if (sy_sha256_hex(rc_acc, (long)rc_acc_n, hex)) return rc_fail("sha", phase);
    return 0;
}
/* atomic write: RECEIPT.new then rename */
int rc_write(const char *receipt, const char *phase, const char *inputs_sha, const char *output_sha) {
    char tmp[1100], body[400];
    if (strlen(inputs_sha) != 64 || strlen(output_sha) != 64) return rc_fail("hex", phase);
    if (cx_fmt(tmp, sizeof tmp, "%s.new", receipt)) return rc_fail("path", receipt);
    if (cx_fmt(body, sizeof body, "phase\t%s\ninputs_sha\t%s\noutput_sha\t%s\n", phase, inputs_sha, output_sha)) return rc_fail("fmt", phase);
    if (cx_write(tmp, body, strlen(body)) || sy_rename(tmp, receipt)) return rc_fail("write", receipt);
    return 0;
}
/* 0 adoptable; 1 STALE with rc_why() = "missing:" | "no-inputs_sha:" | "phase:" | "mismatch:" */
int rc_adopt_ok(const char *receipt, const char *phase, const char *cur_inputs_sha) {
    char got[80], ph[160];
    if (sy_exists(receipt) != 1) return rc_fail("missing", receipt);
    if (rc_get(receipt, "inputs_sha", got, sizeof got)) return rc_fail("no-inputs_sha", receipt);
    if (rc_get(receipt, "phase", ph, sizeof ph) || strcmp(ph, phase)) return rc_fail("phase", phase);
    if (strlen(cur_inputs_sha) != 64 || strcmp(got, cur_inputs_sha)) return rc_fail("mismatch", phase);
    return 0;
}
static int rc_is_hex64(const char *s) {
    size_t i;
    if (!s || strlen(s) != 64) return 0;
    for (i = 0; i < 64; i++) {
        char c = s[i];
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'))) return 0;
    }
    return 1;
}
static int rc_is_id(const char *s) {
    size_t i;
    if (!s || !s[0]) return 0;
    for (i = 0; s[i]; i++) {
        if (s[i] == '\n' || s[i] == '\r' || s[i] == '\t' || s[i] == ' ') return 0;
    }
    return 1;
}
static int rc_is_int(const char *s) {
    size_t i = 0;
    if (!s || !s[0]) return 0;
    if (s[0] == '-') i = 1;
    if (!s[i]) return 0;
    for (; s[i]; i++) if (s[i] < '0' || s[i] > '9') return 0;
    return 1;
}
static int rc_get_strict(const char *rec, const char *key, char *buf, size_t cap) {
    size_t n = 0, i = 0, kl = strlen(key); char *t = cx_read(rec, &n); int hits = 0;
    if (!t || !n || t[n - 1] != '\n') { free(t); return 1; }
    for (i = 0; i < n; i++) if (t[i] == 0) { free(t); return 1; }
    i = 0;
    while (i < n) {
        size_t e = i, tab;
        while (e < n && t[e] != '\n') e++;
        for (tab = i; tab < e && t[tab] != '\t'; tab++) {}
        if (tab >= e || tab == i) { free(t); return 1; }
        if (tab - i == kl && !memcmp(t + i, key, kl)) {
            size_t vn = e - (tab + 1);
            if (vn == 0 || vn >= cap) { free(t); return 1; }
            if (hits == 0) {
                if (mm_copy(buf, cap, t + tab + 1, vn)) { free(t); return 1; }
                buf[vn] = 0;
            }
            hits++;
        }
        i = e + 1;
    }
    free(t);
    return hits == 1 ? 0 : 1;
}
int rc_write2(const char *receipt, const char *run_id, const char *candidate_sha, const char *inputs_sha, const char *output_sha, const char *producer_sha, int rc) {
    char tmp[1100], body[768], bind_in[256], bind_sha[65];
    if (!rc_is_id(run_id)) return rc_fail("run_id", receipt);
    if (!rc_is_hex64(candidate_sha) || !rc_is_hex64(inputs_sha) || !rc_is_hex64(output_sha) || !rc_is_hex64(producer_sha)) return rc_fail("hex", run_id);
    if (cx_fmt(bind_in, sizeof bind_in, "%s\t%s\t%s", run_id, output_sha, inputs_sha)) return rc_fail("fmt", run_id);
    if (sy_sha256_hex(bind_in, (long)strlen(bind_in), bind_sha)) return rc_fail("sha", run_id);
    if (cx_fmt(tmp, sizeof tmp, "%s.new.%d", receipt, (int)getpid())) return rc_fail("path", receipt);
    if (cx_fmt(body, sizeof body, "run_id\t%s\ncandidate_sha\t%s\ninputs_sha\t%s\noutput_sha\t%s\nproducer_sha\t%s\nrc\t%d\nbinding_sha\t%s\n",
               run_id, candidate_sha, inputs_sha, output_sha, producer_sha, rc, bind_sha)) return rc_fail("fmt", run_id);
    if (cx_write(tmp, body, strlen(body)) || sy_rename(tmp, receipt)) { (void)sy_unlink(tmp); return rc_fail("write", receipt); }
    return 0;
}
int rc_need(const char *rec, const char *key, const char *kind) {
    char val[160];
    if (!rec || !key || !kind) { rc_fail("arg", key); return 2; }
    if (sy_exists(rec) != 1) { rc_fail("missing", rec); return 2; }
    if (rc_get_strict(rec, key, val, sizeof val)) { rc_fail("missing-field", key); return 2; }
    if (!strcmp(kind, "hex64")) { if (!rc_is_hex64(val)) { rc_fail("bad-hex64", key); return 2; } }
    else if (!strcmp(kind, "id")) { if (!rc_is_id(val)) { rc_fail("bad-id", key); return 2; } }
    else if (!strcmp(kind, "int")) { if (!rc_is_int(val)) { rc_fail("bad-int", key); return 2; } }
    else { rc_fail("bad-kind", kind); return 2; }
    return 0;
}
int rc_fresh(const char *rec, const char *run_id) {
    char got[160], out_sha[80], in_sha[80], bind_sha[80], bind_in[256], exp_bind[65];
    if (!rc_is_id(run_id)) { rc_fail("bad-run_id", rec); return 2; }
    if (sy_exists(rec) != 1) { rc_fail("missing", rec); return 2; }
    if (rc_get_strict(rec, "run_id", got, sizeof got)) { rc_fail("missing-run_id", rec); return 2; }
    if (strcmp(got, run_id)) { rc_fail("stale-run_id", run_id); return 2; }
    if (rc_get_strict(rec, "output_sha", out_sha, sizeof out_sha) || !rc_is_hex64(out_sha)) { rc_fail("bad-output_sha", rec); return 2; }
    if (rc_get_strict(rec, "inputs_sha", in_sha, sizeof in_sha) || !rc_is_hex64(in_sha)) { rc_fail("bad-inputs_sha", rec); return 2; }
    if (rc_get_strict(rec, "binding_sha", bind_sha, sizeof bind_sha) || !rc_is_hex64(bind_sha)) { rc_fail("bad-binding_sha", rec); return 2; }
    if (cx_fmt(bind_in, sizeof bind_in, "%s\t%s\t%s", run_id, out_sha, in_sha)) { rc_fail("fmt", run_id); return 2; }
    if (sy_sha256_hex(bind_in, (long)strlen(bind_in), exp_bind) || strcmp(bind_sha, exp_bind)) { rc_fail("binding-mismatch", run_id); return 2; }
    return 0;
}

/* ---------- v3 shared receipt API: rc_write3, rc_verify, rc_verify_out, rc_tamper ---------- */
enum {
    RC_OK = 0,
    RC_ERR_MISSING = 10,
    RC_ERR_V2_LEGACY = 11,
    RC_ERR_PRODUCER_PURPOSE = 12,
    RC_ERR_FORMAT = 13,
    RC_ERR_BINDING = 14,
    RC_ERR_RUN_ID = 15,
    RC_ERR_REV = 16,
    RC_ERR_UNIT = 17,
    RC_ERR_CANDIDATE = 18,
    RC_ERR_INPUTS = 19,
    RC_ERR_OUTPUT = 20,
    RC_ERR_VERDICT = 21,
    RC_ERR_TIMESTAMP = 22,
    RC_ERR_PLACEHOLDER = 23,
    RC_ERR_EXPECT_UNBOUND = 24,
    RC_ERR_TARGET = 25
};

typedef struct {
    const char *run_id;
    const char *rev;
    const char *unit;
    const char *target;
    const char *producer;
    const char *purpose;
    const char *candidate_sha;
    const char *inputs_sha;
    const char *output_sha;
    int rc;
    const char *verdict;
    int64_t ts;
} rc_v3_t;

typedef struct {
    const char *run_id;
    const char *rev;
    const char *unit;
    const char *target;
    const char *candidate_sha;
    const char *inputs_sha;
    const char *output_sha;
    const char *output_path;
    const char *producer;
    const char *purpose;
    int expect_rc;
    const char *expect_verdict;
    int64_t now_ts;
    int64_t max_age_s;
    int64_t max_future_s;
    int allow_fail_verdict;
} rc_expect_t;

typedef struct {
    char run_id[160];
    char rev[80];
    char unit[160];
    char target[64];
    char producer[160];
    char purpose[160];
    char candidate_sha[65];
    char inputs_sha[65];
    char output_sha[65];
    char binding_sha[65];
    int rc;
    char verdict[16];
    int64_t ts;
    unsigned char *output_bytes;
    long output_len;
} rc_verified_t;

void rc_verified_free(rc_verified_t *v) {
    if (!v) return;
    mm_free(v->output_bytes);
    mm_fill(v, (long)sizeof *v, 0, (long)sizeof *v);
}

const char *rc_code_name(int code) {
    if (code == RC_OK) return "ok";
    if (code == RC_ERR_MISSING) return "missing";
    if (code == RC_ERR_V2_LEGACY) return "v2-legacy";
    if (code == RC_ERR_PRODUCER_PURPOSE) return "producer-or-purpose-mismatch";
    if (code == RC_ERR_FORMAT) return "bad-format";
    if (code == RC_ERR_BINDING) return "bad-binding";
    if (code == RC_ERR_RUN_ID) return "run-id-mismatch";
    if (code == RC_ERR_REV) return "rev-mismatch";
    if (code == RC_ERR_UNIT) return "unit-mismatch";
    if (code == RC_ERR_CANDIDATE) return "candidate-mismatch";
    if (code == RC_ERR_INPUTS) return "inputs-mismatch";
    if (code == RC_ERR_OUTPUT) return "output-mismatch";
    if (code == RC_ERR_VERDICT) return "verdict-mismatch";
    if (code == RC_ERR_TIMESTAMP) return "ts-policy";
    if (code == RC_ERR_PLACEHOLDER) return "placeholder-sha";
    if (code == RC_ERR_EXPECT_UNBOUND) return "expect-unbound";
    if (code == RC_ERR_TARGET) return "target-mismatch";
    return "unknown";
}

static int rc_is_hex64_lower(const char *s) {
    size_t i;
    if (!s || strlen(s) != 64) return 0;
    for (i = 0; i < 64; i++) {
        char c = s[i];
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return 0;
    }
    return 1;
}

static int rc_is_placeholder(const char *s) {
    int p;
    if (!rc_is_hex64(s)) return 0;
    for (p = 1; p <= 8; p *= 2) {
        int i, same = 1;
        for (i = p; i < 64; i++) {
            char a = s[i], b = s[i % p];
            if (a >= 'A' && a <= 'F') a = (char)(a - 'A' + 'a');
            if (b >= 'A' && b <= 'F') b = (char)(b - 'A' + 'a');
            if (a != b) { same = 0; break; }
        }
        if (same) return 1;
    }
    return 0;
}

static int rc_parse_i64(const char *s, int64_t *out) {
    size_t i = 0;
    int neg = 0;
    unsigned long long acc = 0ULL, lim;
    if (!s || !s[0] || !out) return 1;
    if (s[0] == '-') { neg = 1; i = 1; }
    if (!s[i]) return 1;
    lim = neg ? 9223372036854775808ULL : 9223372036854775807ULL;
    for (; s[i]; i++) {
        unsigned int d;
        if (s[i] < '0' || s[i] > '9') return 1;
        d = (unsigned int)(s[i] - '0');
        if (acc > (lim - (unsigned long long)d) / 10ULL) return 1;
        acc = acc * 10ULL + (unsigned long long)d;
    }
    *out = neg ? (int64_t)(0ULL - acc) : (int64_t)acc;
    return 0;
}

static int rc_v3_binding(const rc_v3_t *r, char hex[65]) {
    char payload[2048];
    if (cx_fmt(payload, sizeof payload,
               "version\t3\nrun_id\t%s\nrev\t%s\nunit\t%s\ntarget\t%s\nproducer\t%s\npurpose\t%s\n"
               "candidate_sha\t%s\ninputs_sha\t%s\noutput_sha\t%s\nrc\t%d\nverdict\t%s\nts\t%lld\n",
               r->run_id, r->rev, r->unit, r->target, r->producer, r->purpose,
               r->candidate_sha, r->inputs_sha, r->output_sha,
               r->rc, r->verdict, (long long)r->ts)) {
        return rc_fail("fmt", "v3-binding");
    }
    if (sy_sha256_hex(payload, (long)strlen(payload), hex)) return rc_fail("sha", "v3-binding");
    return 0;
}

int rc_write3(const char *path, const rc_v3_t *rec) {
    char body[2304], bind_sha[65];
    if (!path || !path[0] || !rec) return rc_fail("arg", "rc_write3");
    /* Producer, purpose, and target are mandatory: never silently default empty authorization fields. */
    if (!rc_is_id(rec->run_id) || !rc_is_id(rec->rev) || !rc_is_id(rec->unit) ||
        !rc_is_id(rec->target) || strlen(rec->target) >= 64 ||
        !rc_is_id(rec->producer) || !rc_is_id(rec->purpose)) return rc_fail("bad-id", path);
    if (!rc_is_hex64_lower(rec->candidate_sha) || !rc_is_hex64_lower(rec->inputs_sha) ||
        !rc_is_hex64_lower(rec->output_sha)) return rc_fail("bad-hex64", path);
    if (rc_is_placeholder(rec->candidate_sha) || rc_is_placeholder(rec->inputs_sha) ||
        rc_is_placeholder(rec->output_sha)) return rc_fail("placeholder", path);
    /* Enforce write/read value-range parity: reject INT_MIN and contradictory rc/verdict pairs. */
    if (rec->rc < -2147483647 || rec->rc > 2147483647) return rc_fail("bad-rc", path);
    if (!rec->verdict || (strcmp(rec->verdict, "PASS") != 0 && strcmp(rec->verdict, "FAIL") != 0))
        return rc_fail("bad-verdict", path);
    if ((rec->rc == 0 && strcmp(rec->verdict, "PASS") != 0) ||
        (rec->rc != 0 && strcmp(rec->verdict, "FAIL") != 0))
        return rc_fail("rc-verdict-contradiction", path);
    if (rec->ts <= 0 || rec->ts > 4102444800LL) return rc_fail("bad-ts", path);
    if (rc_v3_binding(rec, bind_sha)) return 1;
    if (cx_fmt(body, sizeof body,
               "version\t3\nrun_id\t%s\nrev\t%s\nunit\t%s\ntarget\t%s\nproducer\t%s\npurpose\t%s\n"
               "candidate_sha\t%s\ninputs_sha\t%s\noutput_sha\t%s\nrc\t%d\nverdict\t%s\nts\t%lld\n"
               "binding_sha\t%s\n",
               rec->run_id, rec->rev, rec->unit, rec->target, rec->producer, rec->purpose,
               rec->candidate_sha, rec->inputs_sha, rec->output_sha,
               rec->rc, rec->verdict, (long long)rec->ts, bind_sha)) {
        return rc_fail("fmt", path);
    }
    if (sy_write_atomic(path, body, (int64_t)strlen(body), 0600) != 0) return rc_fail("write", path);
    return 0;
}

/* Read one bounded regular-file snapshot on a single O_NOFOLLOW descriptor and pin path identity
 * by confirming lstat(path) and fstat(fd) share the same (dev, ino) regular file.
 * Returns 0 on success, 1 on missing/symlink/non-regular/identity-mismatch/unreadable, 2 on empty or > max_bytes. */
static int rc_read_reg_snapshot(const char *path, long max_bytes, unsigned char **buf_out, long *len_out) {
    sy_stat_t lst, fst;
    int fd;
    unsigned char *b;
    unsigned char extra[1];
    long r;
    *buf_out = 0; *len_out = 0L;
    if (!path || !path[0]) return 1;
    fd = sy_openat_read_nofollow(sy_at_fdcwd(), path);
    if (fd < 0) return 1;
    if (sy_fstat(fd, &fst) != 0 || fst.kind != 'f') { (void)sy_close(fd); return 1; }
    if (sy_lstat(path, &lst) != 0 || lst.kind != 'f' || lst.dev != fst.dev || lst.ino != fst.ino) {
        (void)sy_close(fd);
        return 1;
    }
    {
        int nb = sy_fd_nonblock(fd, 0);
        if (nb != 0 && nb != -ENOSYS) { (void)sy_close(fd); return 1; }
    }
    if (fst.size <= 0 || fst.size > max_bytes) { (void)sy_close(fd); return 2; }
    b = (unsigned char *)mm_alloc((long)fst.size);
    if (!b) { (void)sy_close(fd); return 1; }
    if (sy_read_full(fd, b, (long)fst.size) != 0) { mm_free(b); (void)sy_close(fd); return 1; }
    r = sy_read_once(fd, extra, 1L);
    (void)sy_close(fd);
    if (r != 0L) { mm_free(b); return 1; }
    *buf_out = b;
    *len_out = (long)fst.size;
    return 0;
}

static int rc_copy_field(const char *src, size_t n, char *dst, size_t cap) {
    if (n == 0 || n >= cap) return 1;
    if (mm_copy(dst, cap, src, n)) return 1;
    dst[n] = 0;
    return 0;
}

/* Single bounded snapshot parser for v3 (and explicit v2 detection -> RC_ERR_V2_LEGACY). */
static int rc_parse_v3_snapshot(const unsigned char *buf, long n, rc_verified_t *got) {
    long i = 0;
    unsigned int mask = 0U;
    int saw_v2_prod = 0, saw_version = 0, bad_unknown = 0;
    char ver_s[32], rc_s[32], ts_s[48];
    int64_t rc_v = 0, ts_v = 0;
    ver_s[0] = 0; rc_s[0] = 0; ts_s[0] = 0;
    mm_fill(got, (long)sizeof *got, 0, (long)sizeof *got);
    if (n <= 0L || n > 65536L) { rc_fail("empty-or-large", "receipt"); return RC_ERR_FORMAT; }
    for (i = 0; i < n; i++) {
        if (buf[i] == 0) { rc_fail("embedded-nul", "receipt"); return RC_ERR_FORMAT; }
    }
    if (buf[n - 1] != '\n') { rc_fail("unterminated", "receipt"); return RC_ERR_FORMAT; }
    i = 0;
    while (i < n) {
        long e = i, tab = -1, k;
        const char *kp, *vp;
        size_t kl, vl;
        while (e < n && buf[e] != '\n') {
            if (buf[e] == '\r') { rc_fail("cr-byte", "receipt"); return RC_ERR_FORMAT; }
            if (buf[e] == '\t') {
                if (tab >= 0) { rc_fail("extra-col", "receipt"); return RC_ERR_FORMAT; }
                tab = e;
            }
            e++;
        }
        if (tab <= i || tab + 1 >= e) { rc_fail("bad-line", "receipt"); return RC_ERR_FORMAT; }
        kp = (const char *)(buf + i);
        kl = (size_t)(tab - i);
        vp = (const char *)(buf + tab + 1);
        vl = (size_t)(e - (tab + 1));
        k = -1;
        if (kl == 7 && !memcmp(kp, "version", 7)) {
            if (saw_version) { rc_fail("dup-key", "version"); return RC_ERR_FORMAT; }
            saw_version = 1;
            if (rc_copy_field(vp, vl, ver_s, sizeof ver_s)) { rc_fail("len", "version"); return RC_ERR_FORMAT; }
            k = 0;
        } else if (kl == 6 && !memcmp(kp, "run_id", 6)) {
            if (mask & (1U << 1)) { rc_fail("dup-key", "run_id"); return RC_ERR_FORMAT; }
            if (rc_copy_field(vp, vl, got->run_id, sizeof got->run_id)) { rc_fail("len", "run_id"); return RC_ERR_FORMAT; }
            k = 1;
        } else if (kl == 3 && !memcmp(kp, "rev", 3)) {
            if (mask & (1U << 2)) { rc_fail("dup-key", "rev"); return RC_ERR_FORMAT; }
            if (rc_copy_field(vp, vl, got->rev, sizeof got->rev)) { rc_fail("len", "rev"); return RC_ERR_FORMAT; }
            k = 2;
        } else if (kl == 4 && !memcmp(kp, "unit", 4)) {
            if (mask & (1U << 3)) { rc_fail("dup-key", "unit"); return RC_ERR_FORMAT; }
            if (rc_copy_field(vp, vl, got->unit, sizeof got->unit)) { rc_fail("len", "unit"); return RC_ERR_FORMAT; }
            k = 3;
        } else if (kl == 8 && !memcmp(kp, "producer", 8)) {
            if (mask & (1U << 4)) { rc_fail("dup-key", "producer"); return RC_ERR_FORMAT; }
            if (rc_copy_field(vp, vl, got->producer, sizeof got->producer)) { rc_fail("len", "producer"); return RC_ERR_FORMAT; }
            k = 4;
        } else if (kl == 7 && !memcmp(kp, "purpose", 7)) {
            if (mask & (1U << 5)) { rc_fail("dup-key", "purpose"); return RC_ERR_FORMAT; }
            if (rc_copy_field(vp, vl, got->purpose, sizeof got->purpose)) { rc_fail("len", "purpose"); return RC_ERR_FORMAT; }
            k = 5;
        } else if (kl == 13 && !memcmp(kp, "candidate_sha", 13)) {
            if (mask & (1U << 6)) { rc_fail("dup-key", "candidate_sha"); return RC_ERR_FORMAT; }
            if (rc_copy_field(vp, vl, got->candidate_sha, sizeof got->candidate_sha)) { rc_fail("len", "candidate_sha"); return RC_ERR_FORMAT; }
            k = 6;
        } else if (kl == 10 && !memcmp(kp, "inputs_sha", 10)) {
            if (mask & (1U << 7)) { rc_fail("dup-key", "inputs_sha"); return RC_ERR_FORMAT; }
            if (rc_copy_field(vp, vl, got->inputs_sha, sizeof got->inputs_sha)) { rc_fail("len", "inputs_sha"); return RC_ERR_FORMAT; }
            k = 7;
        } else if (kl == 10 && !memcmp(kp, "output_sha", 10)) {
            if (mask & (1U << 8)) { rc_fail("dup-key", "output_sha"); return RC_ERR_FORMAT; }
            if (rc_copy_field(vp, vl, got->output_sha, sizeof got->output_sha)) { rc_fail("len", "output_sha"); return RC_ERR_FORMAT; }
            k = 8;
        } else if (kl == 2 && !memcmp(kp, "rc", 2)) {
            if (mask & (1U << 9)) { rc_fail("dup-key", "rc"); return RC_ERR_FORMAT; }
            if (rc_copy_field(vp, vl, rc_s, sizeof rc_s)) { rc_fail("len", "rc"); return RC_ERR_FORMAT; }
            k = 9;
        } else if (kl == 7 && !memcmp(kp, "verdict", 7)) {
            if (mask & (1U << 10)) { rc_fail("dup-key", "verdict"); return RC_ERR_FORMAT; }
            if (rc_copy_field(vp, vl, got->verdict, sizeof got->verdict)) { rc_fail("len", "verdict"); return RC_ERR_FORMAT; }
            k = 10;
        } else if (kl == 2 && !memcmp(kp, "ts", 2)) {
            if (mask & (1U << 11)) { rc_fail("dup-key", "ts"); return RC_ERR_FORMAT; }
            if (rc_copy_field(vp, vl, ts_s, sizeof ts_s)) { rc_fail("len", "ts"); return RC_ERR_FORMAT; }
            k = 11;
        } else if (kl == 11 && !memcmp(kp, "binding_sha", 11)) {
            if (mask & (1U << 12)) { rc_fail("dup-key", "binding_sha"); return RC_ERR_FORMAT; }
            if (rc_copy_field(vp, vl, got->binding_sha, sizeof got->binding_sha)) { rc_fail("len", "binding_sha"); return RC_ERR_FORMAT; }
            k = 12;
        } else if (kl == 6 && !memcmp(kp, "target", 6)) {
            if (mask & (1U << 13)) { rc_fail("dup-key", "target"); return RC_ERR_FORMAT; }
            if (rc_copy_field(vp, vl, got->target, sizeof got->target)) { rc_fail("len", "target"); return RC_ERR_FORMAT; }
            k = 13;
        } else if (kl == 12 && !memcmp(kp, "producer_sha", 12)) {
            if (saw_v2_prod) { rc_fail("dup-key", "producer_sha"); return RC_ERR_FORMAT; }
            saw_v2_prod = 1;
        } else {
            bad_unknown = 1;
        }
        if (k >= 0) mask |= (1U << k);
        i = e + 1;
    }
    /* Explicit v2 detection: never downgrade. */
    if (saw_version && !strcmp(ver_s, "2")) {
        rc_fail("v2-legacy", "version=2");
        return RC_ERR_V2_LEGACY;
    }
    if (!saw_version && !bad_unknown && (mask & (1U << 1)) && (mask & (1U << 12)) &&
        (saw_v2_prod || !(mask & ((1U << 2) | (1U << 3) | (1U << 4) | (1U << 5) | (1U << 10) | (1U << 11) | (1U << 13))))) {
        rc_fail("v2-legacy", "no-version-v2-shape");
        return RC_ERR_V2_LEGACY;
    }
    if (bad_unknown || saw_v2_prod) { rc_fail("unknown-key", "receipt"); return RC_ERR_FORMAT; }
    if (!saw_version) { rc_fail("missing-version", "receipt"); return RC_ERR_FORMAT; }
    if (strcmp(ver_s, "3") != 0) { rc_fail("bad-version", ver_s); return RC_ERR_FORMAT; }
    if (mask != ((1U << 14) - 1U)) { rc_fail("missing-field", "receipt"); return RC_ERR_FORMAT; }
    if (!rc_is_id(got->run_id) || !rc_is_id(got->rev) || !rc_is_id(got->unit) ||
        !rc_is_id(got->target) || !rc_is_id(got->producer) || !rc_is_id(got->purpose)) {
        rc_fail("bad-id", "receipt");
        return RC_ERR_FORMAT;
    }
    if (!rc_is_hex64_lower(got->candidate_sha) || !rc_is_hex64_lower(got->inputs_sha) ||
        !rc_is_hex64_lower(got->output_sha) || !rc_is_hex64_lower(got->binding_sha)) {
        rc_fail("bad-hex64", "receipt");
        return RC_ERR_FORMAT;
    }
    if (rc_parse_i64(rc_s, &rc_v) || rc_v < -2147483647LL || rc_v > 2147483647LL) {
        rc_fail("bad-rc", rc_s);
        return RC_ERR_FORMAT;
    }
    if (strcmp(got->verdict, "PASS") != 0 && strcmp(got->verdict, "FAIL") != 0) {
        rc_fail("bad-verdict", got->verdict);
        return RC_ERR_FORMAT;
    }
    if (rc_parse_i64(ts_s, &ts_v)) {
        rc_fail("ts-overflow", ts_s);
        return RC_ERR_TIMESTAMP;
    }
    got->rc = (int)rc_v;
    got->ts = ts_v;
    return RC_OK;
}

int rc_verify_out(const char *path, const rc_expect_t *exp, rc_verified_t *out) {
    unsigned char *buf = 0, *ob = 0;
    long bn = 0L, on = 0L;
    rc_verified_t got;
    rc_v3_t v3;
    char exp_bind[65], actual_sha[65];
    int pr, rrc;
    int64_t now_ts;

    /* Always clear caller output struct first so no stale/unverified data is ever exposed on error. */
    if (out) mm_fill(out, (long)sizeof *out, 0, (long)sizeof *out);

    /* 1. Validate caller-supplied mandatory expectations (never read from receipt, no silent defaults). */
    if (!exp) { rc_fail("expect-null", path); return RC_ERR_EXPECT_UNBOUND; }
    if (!rc_is_id(exp->run_id)) { rc_fail("expect-unbound", "run_id"); return RC_ERR_EXPECT_UNBOUND; }
    if (!rc_is_id(exp->rev)) { rc_fail("expect-unbound", "rev"); return RC_ERR_EXPECT_UNBOUND; }
    if (!rc_is_id(exp->unit)) { rc_fail("expect-unbound", "unit"); return RC_ERR_EXPECT_UNBOUND; }
    if (!rc_is_id(exp->target) || strlen(exp->target) >= 64) { rc_fail("expect-unbound", "target"); return RC_ERR_EXPECT_UNBOUND; }
    if (!rc_is_id(exp->producer)) { rc_fail("expect-unbound", "producer"); return RC_ERR_EXPECT_UNBOUND; }
    if (!rc_is_id(exp->purpose)) { rc_fail("expect-unbound", "purpose"); return RC_ERR_EXPECT_UNBOUND; }
    if (!rc_is_hex64_lower(exp->candidate_sha)) { rc_fail("expect-unbound", "candidate_sha"); return RC_ERR_EXPECT_UNBOUND; }
    if (!rc_is_hex64_lower(exp->inputs_sha)) { rc_fail("expect-unbound", "inputs_sha"); return RC_ERR_EXPECT_UNBOUND; }
    if (!exp->output_path || !exp->output_path[0]) { rc_fail("expect-unbound", "output_path"); return RC_ERR_EXPECT_UNBOUND; }
    if (exp->output_sha && exp->output_sha[0] && !rc_is_hex64_lower(exp->output_sha)) {
        rc_fail("expect-unbound", "output_sha"); return RC_ERR_EXPECT_UNBOUND;
    }
    if (exp->expect_verdict && exp->expect_verdict[0] &&
        strcmp(exp->expect_verdict, "PASS") != 0 && strcmp(exp->expect_verdict, "FAIL") != 0) {
        rc_fail("expect-unbound", "expect_verdict"); return RC_ERR_EXPECT_UNBOUND;
    }
    /* Reject contradictory caller verdict policies instead of silently ignoring them. */
    if (!exp->allow_fail_verdict) {
        if (exp->expect_rc != 0 || (exp->expect_verdict && exp->expect_verdict[0] && strcmp(exp->expect_verdict, "PASS") != 0)) {
            rc_fail("expect-contradictory-policy", "pass-only"); return RC_ERR_EXPECT_UNBOUND;
        }
    } else {
        if (exp->expect_verdict && exp->expect_verdict[0]) {
            if ((exp->expect_rc == 0 && strcmp(exp->expect_verdict, "PASS") != 0) ||
                (exp->expect_rc != 0 && strcmp(exp->expect_verdict, "FAIL") != 0)) {
                rc_fail("expect-contradictory-policy", "allow-fail"); return RC_ERR_EXPECT_UNBOUND;
            }
        }
    }
    /* Explicit caller-supplied fixed reference clock and time-policy bounds required (no wall-clock fallback). */
    if (exp->now_ts <= 0 || exp->now_ts > 4102444800LL) {
        rc_fail("expect-unbound", "now_ts"); return RC_ERR_EXPECT_UNBOUND;
    }
    if (exp->max_age_s <= 0 || exp->max_age_s > 31536000LL) {
        rc_fail("expect-unbound", "max_age_s"); return RC_ERR_EXPECT_UNBOUND;
    }
    if (exp->max_future_s < 0 || exp->max_future_s > 86400LL) {
        rc_fail("expect-unbound", "max_future_s"); return RC_ERR_EXPECT_UNBOUND;
    }
    if (rc_is_placeholder(exp->candidate_sha) || rc_is_placeholder(exp->inputs_sha) ||
        (exp->output_sha && exp->output_sha[0] && rc_is_placeholder(exp->output_sha))) {
        rc_fail("placeholder", "expect"); return RC_ERR_PLACEHOLDER;
    }

    /* 2. Read one bounded regular-file snapshot on a single fd (no lstat/open TOCTOU). */
    rrc = rc_read_reg_snapshot(path, 65536L, &buf, &bn);
    if (rrc == 1) { rc_fail("missing", path ? path : "null"); return RC_ERR_MISSING; }
    if (rrc == 2) { rc_fail("empty-or-large", path); return RC_ERR_FORMAT; }

    /* 3. Strict single-pass parse (v2 -> 11, syntax/unknown -> 13). */
    pr = rc_parse_v3_snapshot(buf, bn, &got);
    mm_free(buf);
    if (pr != RC_OK) return pr;

    /* 4. Reject placeholder digests in receipt. */
    if (rc_is_placeholder(got.candidate_sha) || rc_is_placeholder(got.inputs_sha) ||
        rc_is_placeholder(got.output_sha) || rc_is_placeholder(got.binding_sha)) {
        rc_fail("placeholder", path); return RC_ERR_PLACEHOLDER;
    }

    /* 5. Verify full-field binding_sha (covers all 13 fields incl target, rc, verdict, ts). */
    v3.run_id = got.run_id; v3.rev = got.rev; v3.unit = got.unit; v3.target = got.target;
    v3.producer = got.producer; v3.purpose = got.purpose;
    v3.candidate_sha = got.candidate_sha; v3.inputs_sha = got.inputs_sha; v3.output_sha = got.output_sha;
    v3.rc = got.rc; v3.verdict = got.verdict; v3.ts = got.ts;
    if (rc_v3_binding(&v3, exp_bind) || strcmp(got.binding_sha, exp_bind) != 0) {
        rc_fail("binding-mismatch", path); return RC_ERR_BINDING;
    }

    /* 6. Cross-check every identity and contract field against caller expectations. */
    if (strcmp(got.run_id, exp->run_id) != 0) { rc_fail("run-id-mismatch", got.run_id); return RC_ERR_RUN_ID; }
    if (strcmp(got.rev, exp->rev) != 0) { rc_fail("rev-mismatch", got.rev); return RC_ERR_REV; }
    if (strcmp(got.unit, exp->unit) != 0) { rc_fail("unit-mismatch", got.unit); return RC_ERR_UNIT; }
    if (strcmp(got.target, exp->target) != 0) { rc_fail("target-mismatch", got.target); return RC_ERR_TARGET; }
    if (strcmp(got.producer, exp->producer) != 0) { rc_fail("producer-mismatch", got.producer); return RC_ERR_PRODUCER_PURPOSE; }
    if (strcmp(got.purpose, exp->purpose) != 0) { rc_fail("purpose-mismatch", got.purpose); return RC_ERR_PRODUCER_PURPOSE; }
    if (strcmp(got.candidate_sha, exp->candidate_sha) != 0) { rc_fail("candidate-mismatch", got.candidate_sha); return RC_ERR_CANDIDATE; }
    if (strcmp(got.inputs_sha, exp->inputs_sha) != 0) { rc_fail("inputs-mismatch", got.inputs_sha); return RC_ERR_INPUTS; }
    if (exp->output_sha && exp->output_sha[0] && strcmp(got.output_sha, exp->output_sha) != 0) {
        rc_fail("output-sha-mismatch", got.output_sha); return RC_ERR_OUTPUT;
    }

    /* 7. rc / verdict consistency and expected status. */
    if (got.rc == 0 && strcmp(got.verdict, "PASS") != 0) {
        rc_fail("verdict-fail-on-rc0", got.verdict); return RC_ERR_VERDICT;
    }
    if (got.rc != 0 && strcmp(got.verdict, "FAIL") != 0) {
        rc_fail("rc-nonzero-on-pass", got.verdict); return RC_ERR_VERDICT;
    }
    if (!exp->allow_fail_verdict) {
        if (got.rc != 0 || strcmp(got.verdict, "PASS") != 0) {
            rc_fail("verdict-not-pass", got.verdict); return RC_ERR_VERDICT;
        }
    } else {
        if (got.rc != exp->expect_rc) { rc_fail("rc-mismatch", got.verdict); return RC_ERR_VERDICT; }
        if (exp->expect_verdict && exp->expect_verdict[0] && strcmp(got.verdict, exp->expect_verdict) != 0) {
            rc_fail("verdict-mismatch", got.verdict); return RC_ERR_VERDICT;
        }
    }

    /* 8. Timestamp freshness and future-skew policy (strict caller-injected fixed now_ts). */
    if (got.ts <= 0 || got.ts > 4102444800LL) {
        rc_fail("ts-range-or-unit", "ts"); return RC_ERR_TIMESTAMP;
    }
    now_ts = exp->now_ts;
    if (now_ts > got.ts && (now_ts - got.ts) > exp->max_age_s) {
        rc_fail("ts-stale", "ts"); return RC_ERR_TIMESTAMP;
    }
    if (got.ts > now_ts && (got.ts - now_ts) > exp->max_future_s) {
        rc_fail("ts-future", "ts"); return RC_ERR_TIMESTAMP;
    }

    /* 9. Pin and verify the real artifact bytes on a single fd (full bytes incl after NUL);
     *    if caller passed `out`, transfer ownership of this exact verified snapshot to `out`. */
    if (rc_read_reg_snapshot(exp->output_path, 64L << 20, &ob, &on) != 0 || !ob || on <= 0L) {
        mm_free(ob);
        rc_fail("output-file-missing-or-empty", exp->output_path);
        return RC_ERR_OUTPUT;
    }
    if (sy_sha256_hex(ob, on, actual_sha) != 0 || strcmp(actual_sha, got.output_sha) != 0) {
        mm_free(ob);
        rc_fail("output-file-sha-mismatch", exp->output_path);
        return RC_ERR_OUTPUT;
    }

    if (out) {
        got.output_bytes = ob;
        got.output_len = on;
        *out = got;
    } else {
        mm_free(ob);
    }
    return RC_OK;
}

int rc_verify(const char *path, const rc_expect_t *exp) {
    return rc_verify_out(path, exp, 0);
}
