}
static int mx_impl(const char *root,const char *package,const char *fresh,int seconds,mx_result *out,char *why,size_t cap){MxContext c={0};MxObserved before={0},after={0};np_buf origin={0},necessary={0},kernel={0},stable={0},witness={0};np_result raw={0};mx_result result={0};MxRows *report=0;int rc=-1;long long start=mx_clock(&c);if(start<0)goto done;if(strlen(root)>=sizeof c.root||strlen(package)>=sizeof c.package){mx_bad(&c,"root-package-path-bound",0);goto done;}strcpy(c.root,root);strcpy(c.package,package);if(mx_canonical(&c,c.root,1)||mx_canonical(&c,c.package,1)||mx_path(&c,c.out,c.root,"out")||!mx_within(c.package,c.out)||!strcmp(c.package,c.out)||mx_path(&c,c.bound,c.root,"tools/bound")){mx_bad(&c,"canonical-independent-Root-out-package-role",package);goto done;}c.ctx=calloc(1,sizeof *c.ctx);report=calloc(1,sizeof *report);if(!c.ctx||!report){mx_bad(&c,"allocation",0);goto done;}if(mx_context(&c,fresh)||mx_observe(&c,&before,&origin,&necessary,&kernel))goto done;
 char time[16],message[1200];snprintf(time,sizeof time,"%d",seconds);char *v[]={c.bound,time,mx_cv(&c,"controller-ELF-path"),"--snapshot",c.root,c.package,0};char *env[]={"UNISACC_BOUND_CLEANUP_TRACE=","UNISACC_TIME_SCALE=1",0};int idle=seconds<=53?seconds+2:55;if(np_run(v,c.root,env,idle,&raw,message,sizeof message)){mx_bad(&c,message,0);goto done;}if(mx_report(&c,&raw,fresh,&before,&origin,&necessary,&kernel,report,&result,&stable)||mx_observe(&c,&after,0,0,0))goto done;if(before.manifest.n!=after.manifest.n||memcmp(before.manifest.p,after.manifest.p,before.manifest.n)){mx_bad(&c,"actual-package-code-or-source-changed-around-snapshot",0);goto done;}if(mx_hash(&c,before.manifest.p,before.manifest.n,result.observed_files))goto done;np_puts(&witness,"mixed-single-snapshot-wrapper-witness-v1\n");np_puts(&witness,c.root);np_puts(&witness,"\n");np_puts(&witness,c.package);np_puts(&witness,"\n");np_puts(&witness,result.reader_module);np_puts(&witness,"\n");np_puts(&witness,result.controller_source);np_puts(&witness,"\n");np_puts(&witness,result.controller_elf);np_puts(&witness,"\n");np_puts(&witness,result.report_identity);np_puts(&witness,"\n");np_puts(&witness,result.observed_files);np_puts(&witness,"\n");if(mx_hash(&c,witness.p,witness.n,result.witness))goto done;long long end=mx_clock(&c);if(end<start){mx_bad(&c,"wrapper-monotonic-clock-order",0);goto done;}result.own_physical_reads=c.reads;result.own_elapsed_ns=end-start;*out=result;rc=0;
done:if(rc)snprintf(why,cap,"%s",c.why[0]?c.why:"mixed-snapshot-reader-refused");free(c.ctx);free(report);free(before.manifest.p);free(after.manifest.p);free(origin.p);free(necessary.p);free(kernel.p);free(stable.p);free(witness.p);np_free(&raw);return rc;}
typedef struct {int rc;mx_result result;char why[1200];} MxPacket;
static int mx_platform_snapshot(const char *root,const char *package,const char *fresh,int seconds,mx_result *out,char *why,size_t cap){if(out)memset(out,0,sizeof *out);if(why&&cap)why[0]=0;
#if !defined(__linux__) || !defined(__x86_64__)
 if(why&&cap)snprintf(why,cap,"mixed-snapshot-requires-Linux-x86_64-LP64");return -1;
#endif
 if(!root||!package||!fresh||!out||!why||!cap||root[0]!='/'||package[0]!='/'||strpbrk(root,"\r\n\t")||strpbrk(package,"\r\n\t")||!mx_hex(fresh)||seconds<1||seconds>55||sizeof(long)!=8){if(why&&cap)snprintf(why,cap,"mixed-snapshot-arguments");return -1;}int channel[2];if(pipe(channel)){snprintf(why,cap,"mixed-snapshot-pipe errno=%d",errno);return -1;}if(fcntl(channel[1],F_SETFD,FD_CLOEXEC)<0){int e=errno;close(channel[0]);close(channel[1]);snprintf(why,cap,"mixed-snapshot-pipe-cloexec errno=%d",e);return -1;}pid_t pid=fork();if(pid<0){int e=errno;close(channel[0]);close(channel[1]);snprintf(why,cap,"mixed-snapshot-fork errno=%d",e);return -1;}if(!pid){close(channel[0]);if(dup2(channel[1],1)<0||dup2(channel[1],2)<0)_exit(2);MxPacket p={0};p.rc=mx_impl(root,package,fresh,seconds,&p.result,p.why,sizeof p.why);size_t at=0;while(at<sizeof p){ssize_t n=write(channel[1],(char *)&p+at,sizeof p-at);if(n<0&&errno==EINTR)continue;if(n<=0)_exit(2);at+=(size_t)n;}close(channel[1]);_exit(0);}close(channel[1]);MxPacket p={0};size_t at=0;int bad=0;while(at<sizeof p){ssize_t n=read(channel[0],(char *)&p+at,sizeof p-at);if(n<0&&errno==EINTR)continue;if(n<0){bad=1;break;}if(!n)break;at+=(size_t)n;}if(close(channel[0]))bad=1;int status=0;pid_t got;do{got=waitpid(pid,&status,0);}while(got<0&&errno==EINTR);if(bad||at!=sizeof p||got!=pid||!WIFEXITED(status)||WEXITSTATUS(status)){snprintf(why,cap,"mixed-snapshot-reader-failed bytes=%lu status=%d",(unsigned long)at,status);return -1;}if(p.rc){snprintf(why,cap,"%s",p.why[0]?p.why:"mixed-snapshot-reader-refused");return -1;}if(p.result.origin_jobs!=107||p.result.models!=34||p.result.origin_physical_reads!=1004||!mx_hex(p.result.witness)){snprintf(why,cap,"mixed-snapshot-result-shape");return -1;}*out=p.result;return 0;}

/* Public export is unconditional; platform selection stays private. */
int mx_verify_snapshot(const char *root,const char *pkg,const char *expected_source,int seconds,mx_result *out,char *why,size_t cap){return mx_platform_snapshot(root,pkg,expected_source,seconds,out,why,cap);}

