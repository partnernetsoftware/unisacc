static int mx_bind(MxContext *c,const np_buf *b,const char *schema,const char *key,const char *expected){char v[4400];if(mx_field(c,b->p,b->n,schema,key,v)||strcmp(v,expected))return mx_bad(c,"metadata-report-identity",key);return 0;}
