static const char *mx_ctx_keys[]={"status","environment-policy","root","snapshot-root","logical-root","logical-package","physical-package","origin-context","source-context","kernel-generation","pack-context","source","origin-source","origin-verifier-ELF-path","origin-profile-path","foundation","origin-consumer","origin-spec","bootstrap","bootstrap-sha","bootstrap-record-sha","controller-source-path","controller-source","controller-ELF-path","controller-ELF","controller-target","controller-model-package","controller-model-package-sha","controller-flags","tools/cxlib/sourcepackage.cx","tools/cxlib/netpack.cx","tools/cxlib/kernelsha.cx","tools/bound","tools/bound.c","seed/ident.c","identity-helper-path","identity-helper-sha","origin.tsv","selection.tsv","current-union.tsv","kernel-state.tsv","headers.tsv","code.tsv","routes/lnx-arm64.tsv","routes/lnx-x86_64.tsv","routes/osx-arm64.tsv","routes/osx-x86_64.tsv","routes/win-arm64.tsv","routes/win-x86_64.tsv","current-net-models","adopted-net-models","current-union-jobs","declaration","scope"};
static const char *mx_report_keys[]={"status","artifact","manifest","receipt","context","current-source","origin-source","models","kernel-context","origin-spec","origin-verifier","origin-ELF","origin-profile","origin-execution-closure","origin-mapping","union-verifier","union-witness","union-artifact","union-receipt","controller-source","controller-ELF","observation-views","origin-jobs","origin-models","current-union-jobs","current-net-models","adopted-net-models","origin-physical-reads","union-physical-reads","own-physical-reads","endpoint-ns","union-ns","internal-helper-reads","observations-scope","snapshot-body-ns"};
static int mx_bad(MxContext *c,const char *reason,const char *path){if(!c->failed)snprintf(c->why,sizeof c->why,"%s path=%.700s errno=%d",reason,path?path:"-",errno);c->failed=1;return -1;}
static int mx_path(MxContext *c,char p[4400],const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);return n<0||n>=4400?mx_bad(c,"path-bound",b):0;}
static int mx_within(const char *p,const char *base){size_t n=strlen(base);return !strncmp(p,base,n)&&(!p[n]||p[n]=='/');}
static int mx_hex(const char *s){if(strlen(s)!=64)return 0;for(int i=0;i<64;i++)if(!((s[i]>='0'&&s[i]<='9')||(s[i]>='a'&&s[i]<='f')))return 0;return 1;}
static int mx_canonical(MxContext *c,const char *p,int directory){char resolved[4096];struct stat st;if(!p[0]||p[0]!='/'||strlen(p)>=4096||strpbrk(p,"\r\n\t")||!realpath(p,resolved)||strcmp(p,resolved)||lstat(p,&st)||(directory?!S_ISDIR(st.st_mode):!S_ISREG(st.st_mode)))return mx_bad(c,"canonical-normal-path-role",p);return 0;}
static int mx_hash(MxContext *c,const void *bytes,size_t n,char h[65]){if(n<65536){cx_sha256_hex(bytes,n,h);return 0;}if(!c->sha_ready){char t[65];int rc=ks_sha256_hex("",0,t);if(rc||strcmp(t,"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"))return mx_bad(c,"kernel-SHA-empty-selfcheck",0);rc=ks_sha256_hex("abc",3,t);if(rc||strcmp(t,"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"))return mx_bad(c,"kernel-SHA-abc-selfcheck",0);c->sha_ready=1;}int rc=ks_sha256_hex(bytes,n,h);if(rc){char why[100];snprintf(why,sizeof why,"kernel-SHA-negative-rc=%d",rc);return mx_bad(c,why,0);}return 0;}
static char *mx_read(MxContext *c,const char *p,size_t *n,unsigned *mode){struct stat a,b;if(lstat(p,&a)){mx_bad(c,errno==ENOENT?"file-ENOENT":"file-stat-error",p);return 0;}if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>268435456){mx_bad(c,"bounded-regular-file-required",p);return 0;}int fd=open(p,O_RDONLY|O_NOFOLLOW|O_NONBLOCK|O_CLOEXEC);if(fd<0){mx_bad(c,"file-open",p);return 0;}char *s=0;int bad=0;if(fstat(fd,&b)||!S_ISREG(b.st_mode)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size||a.st_mode!=b.st_mode){mx_bad(c,"file-descriptor-identity",p);bad=1;goto done;}*n=(size_t)a.st_size;s=malloc(*n+1);if(!s){mx_bad(c,"allocation",p);bad=1;goto done;}size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0){mx_bad(c,"file-read-extent",p);bad=1;goto done;}at+=(size_t)z;}char x;ssize_t z;do{z=read(fd,&x,1);}while(z<0&&errno==EINTR);if(z||fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size||a.st_mode!=b.st_mode){mx_bad(c,"file-changed-or-extra",p);bad=1;}
done:if(close(fd)){mx_bad(c,"file-close",p);bad=1;}if(bad){free(s);return 0;}s[*n]=0;if(mode)*mode=(unsigned)a.st_mode&07777;c->reads++;return s;}
static int mx_parse(MxContext *c,const char *s,size_t n,const char *schema,const char **keys,int rows,MxRows *out){size_t sn=strlen(schema);if(n<sn||n>65536||memcmp(s,schema,sn)||s[n-1]!='\n'||memchr(s,0,n)||memchr(s,'\r',n))return mx_bad(c,"known-schema-wire",schema);size_t at=sn;for(int i=0;i<rows;i++){if(at>=n)return mx_bad(c,"report-or-context-missing-row",keys[i]);const char *e=memchr(s+at,'\n',n-at);size_t k=strlen(keys[i]);if(!e||(size_t)(e-(s+at))<=k+1||memcmp(s+at,keys[i],k)||s[at+k]!='\t')return mx_bad(c,"report-or-context-row-order",keys[i]);size_t z=(size_t)(e-(s+at+k+1));if(z>=4400||memchr(s+at+k+1,'\t',z))return mx_bad(c,"report-or-context-value-bound",keys[i]);memcpy(out->v[i],s+at+k+1,z);out->v[i][z]=0;at=(size_t)(e-s)+1;}return at==n?0:mx_bad(c,"report-or-context-extra-row",schema);}
static int mx_field(MxContext *c,const char *s,size_t n,const char *schema,const char *key,char out[4400]){size_t sn=strlen(schema);if(!n||n<sn||n>65536||memcmp(s,schema,sn)||s[n-1]!='\n'||memchr(s,0,n)||memchr(s,'\r',n))return mx_bad(c,"bound-metadata-schema-wire",key);int found=0;size_t at=sn,k=strlen(key);while(at<n){const char *end=memchr(s+at,'\n',n-at),*tab=end?memchr(s+at,'\t',(size_t)(end-(s+at))):0;if(!end||!tab||tab==s+at||tab+1==end||memchr(tab+1,'\t',(size_t)(end-tab-1)))return mx_bad(c,"bound-metadata-row",key);if((size_t)(tab-(s+at))==k&&!memcmp(s+at,key,k)){size_t z=(size_t)(end-tab-1);if(++found!=1||z>=4400)return mx_bad(c,"bound-metadata-unique-field",key);memcpy(out,tab+1,z);out[z]=0;}at=(size_t)(end-s)+1;}return found==1?0:mx_bad(c,"bound-metadata-required-field",key);}
static int mx_number(MxContext *c,const char *s,long long *out,int positive){if(!*s||(*s=='0'&&s[1]))return mx_bad(c,"canonical-decimal-observation",s);long long v=0;for(int i=0;s[i];i++){int d=s[i]-'0';if(d<0||d>9||v>(LLONG_MAX-d)/10)return mx_bad(c,"decimal-observation-range",s);v=v*10+d;}if(positive&&!v)return mx_bad(c,"positive-observation-required",s);*out=v;return 0;}
static long long mx_clock(MxContext *c){long t[2]={0,0};long rc=__syscall6(228,1,(long)t,0,0,0);if(rc||t[0]<0||t[1]<0||t[1]>=1000000000L||t[0]>(LLONG_MAX-t[1])/1000000000LL){mx_bad(c,"raw-monotonic-clock",0);return -1;}return (long long)t[0]*1000000000LL+t[1];}

static const char *mx_cv(MxContext *c,const char *key){for(int i=0;i<sizeof mx_ctx_keys/sizeof *mx_ctx_keys;i++)if(!strcmp(key,mx_ctx_keys[i]))return c->ctx->v[i];mx_bad(c,"internal-context-key",key);return "";}
static int mx_context(MxContext *c,const char *fresh){char p[4400];size_t n;if(mx_path(c,p,c->package,"context.tsv"))return -1;char *s=mx_read(c,p,&n,0);if(!s)return -1;int rc=mx_parse(c,s,n,"source-package-mixed-context-v1\n",mx_ctx_keys,sizeof mx_ctx_keys/sizeof *mx_ctx_keys,c->ctx);if(!rc)rc=mx_hash(c,s,n,c->context_sha);free(s);if(rc)return -1;
 if(strcmp(mx_cv(c,"root"),c->root)||strcmp(mx_cv(c,"logical-root"),c->root)||strcmp(mx_cv(c,"pack-context"),c->package)||strcmp(mx_cv(c,"source"),fresh)||strcmp(mx_cv(c,"controller-source"),mx_controller_source)||strcmp(mx_cv(c,"controller-ELF"),mx_controller_elf))return mx_bad(c,"mixed-context-role-or-controller-mismatch",p);
 const char *generation=mx_cv(c,"kernel-generation"),*source_context=mx_cv(c,"source-context"),*snapshot=mx_cv(c,"snapshot-root"),*logical_pkg=mx_cv(c,"logical-package"),*physical_pkg=mx_cv(c,"physical-package"),*origin_context=mx_cv(c,"origin-context");
 if(mx_canonical(c,generation,1)||mx_canonical(c,source_context,1)||mx_canonical(c,snapshot,1)||mx_canonical(c,logical_pkg,1)||mx_canonical(c,physical_pkg,1)||mx_canonical(c,origin_context,1)||!mx_within(generation,c->out)||!mx_within(source_context,c->out)||!mx_within(snapshot,c->out)||!mx_within(logical_pkg,c->out)||!mx_within(physical_pkg,snapshot)||!mx_within(origin_context,snapshot)||!strcmp(generation,source_context)||!strcmp(generation,c->package)||!strcmp(source_context,c->package))return mx_bad(c,"mixed-context-generation-source-or-origin-role",p);
 if(mx_path(c,p,c->root,"tools/source-package-mixed.cx")||strcmp(p,mx_cv(c,"controller-source-path")))return mx_bad(c,"controller-source-path",p);
 return 0;
}
static int mx_observe_file(MxContext *c,MxObserved *o,int slot,const char *path,const char *pin,int elf,int executable,np_buf *copy){size_t n;unsigned mode;char *s=mx_read(c,path,&n,&mode);if(!s)return -1;if((elf&&(n<64||memcmp(s,"\177ELF",4)||(unsigned char)s[4]!=2||(unsigned char)s[5]!=1||(unsigned char)s[18]!=62||s[19]))||(executable&&access(path,X_OK))){free(s);return mx_bad(c,"actual-known-ELF64-x64-X_OK-required",path);}if(mx_hash(c,s,n,o->hash[slot])){free(s);return -1;}if(pin&&strcmp(pin,o->hash[slot])){free(s);return mx_bad(c,"actual-byte-identity-pin-mismatch",path);}if(copy)np_put(copy,s,n);free(s);np_puts(&o->manifest,path);np_puts(&o->manifest,"\t");np_putll(&o->manifest,mode);np_puts(&o->manifest,"\t");np_putll(&o->manifest,(long long)n);np_puts(&o->manifest,"\t");np_puts(&o->manifest,o->hash[slot]);np_puts(&o->manifest,"\n");return 0;}

