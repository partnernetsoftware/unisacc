#pragma unisa module mixedsnapshot
#pragma unisa use netpack
#pragma unisa use kernelsha
/* Read-only mixed-package controller adapter. Canonical roles and the actual
 * context bytes are checked before and after execution; fixed source/ELF pins
 * prevent package metadata from nominating different executable code.
 * Every invocation executes --snapshot, including full origin107/current49
 * DAGs, and physically observes package/code files on both sides.
 * Caller supplies freshly measured expected source and an outer tree watchdog.
 * Linux x86_64 LP64 only. AF_ALG required for >=64KiB, no fallback/result cache.
 * The source tree and package require a single writer during this operation:
 * before/after reads do not prevent same-UID swap-and-restore during exec.
 * Unsigned consistency is not historical compilation or functional PASS.
 * Timing is an observation, never part of stable witness. */
typedef struct {
 char artifact[65],manifest[65],receipt[65],context[65],current_source[65],kernel_context[65],origin_source[65];
 char controller_source[65],controller_elf[65],origin_execution_closure[65],union_witness[65];
 char origin_spec[65],origin_verifier[65],origin_elf[65],origin_profile[65],origin_mapping[65];
 char union_verifier[65],union_artifact[65],union_receipt[65],netpack[65],kernelsha[65];
 char controller_path[4096],controller_bootstrap_path[4096],controller_bootstrap_artifact[65],controller_bootstrap_record[65];
 char origin_epoch_path[4096],origin_epoch_artifact[65],origin_epoch_record[65];
 char current_gen_epoch_path[4096],current_gen_epoch_artifact[65],current_gen_epoch_record[65];
 char reader_module[65],report_identity[65],report_observation[65],observed_files[65],witness[65];
 int models,origin_jobs,origin_models,current_union_jobs,current_net_models,adopted_net_models;
 int origin_physical_reads,union_physical_reads,controller_physical_reads,own_physical_reads;
 long long endpoint_ns,union_ns,snapshot_body_ns,own_elapsed_ns;
} mx_result;
typedef struct {char v[64][4400];} MxRows;
typedef struct {char root[4096],package[4096],out[4400],bound[4400],why[1200],context_sha[65];int failed,reads,sha_ready;MxRows *ctx;} MxContext;
typedef struct {char hash[64][65];np_buf manifest;} MxObserved;
