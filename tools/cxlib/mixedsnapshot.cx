 for(int i=0;i<12;i++)if(mx_path(c,p,c->package,private[i])||mx_canonical(c,p,0)||mx_observe_file(c,o,19+i,p,mx_cv(c,private[i]),0,0,i==0?origin:i==2?un:0))return -1;
 return 0;
