#define MX_COPY(field,row) strcpy(out->field,r->v[row])
 MX_COPY(artifact,1);MX_COPY(manifest,2);MX_COPY(receipt,3);MX_COPY(context,4);MX_COPY(current_source,5);MX_COPY(origin_source,6);MX_COPY(kernel_context,8);MX_COPY(origin_spec,9);MX_COPY(origin_verifier,10);MX_COPY(origin_elf,11);MX_COPY(origin_profile,12);MX_COPY(origin_execution_closure,13);MX_COPY(origin_mapping,14);MX_COPY(union_verifier,15);MX_COPY(union_witness,16);MX_COPY(union_artifact,17);MX_COPY(union_receipt,18);MX_COPY(controller_source,19);MX_COPY(controller_elf,20);
