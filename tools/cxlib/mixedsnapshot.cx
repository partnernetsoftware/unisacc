 out->models=34;out->origin_jobs=107;out->origin_models=34;out->current_union_jobs=49;out->current_net_models=6;out->adopted_net_models=28;out->origin_physical_reads=(int)v[0];out->union_physical_reads=(int)v[1];out->controller_physical_reads=(int)v[2];out->endpoint_ns=v[3];out->union_ns=v[4];out->snapshot_body_ns=v[5];
