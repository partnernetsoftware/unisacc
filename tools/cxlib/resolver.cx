/* resolver.cx — 按 manifest 从目录/内嵌 pack 取字节并校验 sha256。
 *
 * B1：一切按内容哈希寻址；pack 只是 resolver 的另一个来源，与外部目录行为一致。
 * manifest.tsv 每行 `name  kind  arch  sha256  size`（5 字段，TAB 分隔）。
 * 来源顺序：UNISA_HOME 目录 → com 旁目录 → 用户缓存 → 内嵌 pack(UNIPKG1 footer)。
 * 命中必校验 sha256，不符具名拒绝，不静默回退到下一来源。
 *
 * 模块（无 main），供 tools 层与后续 host.cx 下沉复用。工具层允许 libc 输出给人看，
 * 但核心取字节/校验逻辑用 sy_* / mm_* / tx_*。
 */
#pragma unisa module resolver
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sys.env
#pragma unisa use text.text
#pragma unisa use text.num
#pragma unisa use packagefooter
#pragma unisa use codec

/* 单条 manifest 记录。name/kind/arch/sha 是深拷贝；size 是字节数。 */
#define RSV_MAX_ROWS 4096

typedef struct { char name[512], kind[32], arch[32], sha[65]; long long size, order; } RsvManifestRow;
typedef struct { RsvManifestRow *row; int n, cap; } RsvManifest;

typedef struct {
    /* 来源按序。home/com/cache 是目录；pack 是文件（0 表示无内嵌 pack）。 */
    char home[4096], com[4096], cache[4096], pack[4096];
    const RsvManifest *manifest;   /* 借用，调用者持有 */
    /* 已解析的 pack body（惰性，首次 resolve pack 来源时填充）：footer 之后的
       P3/P4 正文字节，pack_body_n 为其长度。 */
    unsigned char *pack_bytes; long pack_n;
    unsigned char *pack_body; long pack_body_n;
    int pack_ready;
} RsvResolver;

/* 为什么（具名错误）；调用者传入缓冲区。 */
static void rsv_why(char *why, int cap, const char *msg, const char *name) {
    int i = 0, k = 0;
    if (!why || cap <= 0) return;
    if (msg) for (; msg[k] && i + 1 < cap; i++, k++) why[i] = msg[k];
    if (name) { if (i + 1 < cap) why[i++] = ' '; for (k = 0; name[k] && i + 1 < cap; i++, k++) why[i] = name[k]; }
    why[i] = 0;
}

/* 解析 manifest 文本（name kind arch sha256 size [order] 行，TAB 分隔，空字段=连续 TAB）。
   兼容 5 字段（缺 order，order 取行号 0 起）与 6 字段（含 order）。返回行数或负。 */
int rsv_parse_manifest(const char *text, long n, RsvManifest *out, char *why, int cap) {
    long at = 0, i;
    if (!text || n < 0 || !out) { rsv_why(why, cap, "bad manifest input", 0); return -1; }
    out->row = 0; out->n = 0; out->cap = 0;
    for (at = 0; at < n; ) {
        long e = tx_chr(text + at, n - at, '\n');
        long ln = e < 0 ? n - at : e;
        if (ln > 0) {
            /* 跳过注释/空 */
            long s = at;
            while (s < at + ln && (text[s] == ' ' || text[s] == '\t')) s++;
            if (s >= at + ln || text[s] == '#') { /* skip */ }
            else {
                if (out->n == out->cap) {
                    long nc = out->cap ? out->cap * 2 : 16;
                    RsvManifestRow *g = realloc(out->row, (size_t)nc * sizeof(RsvManifestRow));
                    if (!g) { rsv_why(why, cap, "out of memory", 0); return -1; }
                    out->row = g; out->cap = (int)nc;
                }
                RsvManifestRow *r = &out->row[out->n];
                char field[6][560]; int f = 0, p = 0, j;
                for (j = 0; j < 6; j++) field[j][0] = 0;
                /* 按 \t 切分至多 6 字段；空字段(连续 \t)保留为空。 */
                for (j = s; j < at + ln && f < 6; j++) {
                    char c = text[j];
                    if (c == '\t') {
                        field[f][p] = 0; f++; p = 0;
                    } else if (c == ' ' && p == 0) {
                        /* 行内空格跳过(前导/尾随) */
                    } else {
                        if (p < 559) field[f][p++] = c;
                    }
                }
                if (f < 6) { field[f][p] = 0; f++; }
                if (f != 5 && f != 6) { rsv_why(why, cap, "manifest row needs 5 or 6 fields", 0); return -1; }
                if (tx_copy(r->name, sizeof r->name, field[0], tx_len(field[0], 511)) ||
                    tx_copy(r->kind, sizeof r->kind, field[1], tx_len(field[1], 31)) ||
                    tx_copy(r->arch, sizeof r->arch, field[2], tx_len(field[2], 31)) ||
                    tx_copy(r->sha, sizeof r->sha, field[3], 64)) {
                    rsv_why(why, cap, "manifest field overflow", 0); return -1;
                }
                if (tx_strtol_r(field[4], 0, 10, &r->size)) { rsv_why(why, cap, "manifest size not a number", r->name); return -1; }
                if (r->size < 0) { rsv_why(why, cap, "manifest negative size", r->name); return -1; }
                if (f == 6) {
                    if (tx_strtol_r(field[5], 0, 10, &r->order)) { rsv_why(why, cap, "manifest order not a number", r->name); return -1; }
                    if (r->order < 0) { rsv_why(why, cap, "manifest negative order", r->name); return -1; }
                } else {
                    r->order = out->n;   /* 缺 order：行号 0 起 */
                }
                out->n++;
            }
        }
        at += ln + 1;
    }
    /* B5d: order must be a permutation of 0..n-1 -- contiguous and unique. A gap or a
       repeat makes "sorted by order" ambiguous, so it is a named refusal, not a
       silently re-numbered table. 5-field manifests get order = row index above and
       therefore pass trivially. */
    {
        static unsigned char seen[RSV_MAX_ROWS];
        long k;
        if (out->n > RSV_MAX_ROWS) { rsv_why(why, cap, "manifest too many rows", 0); return -1; }
        for (k = 0; k < out->n; k++) seen[k] = 0;
        for (k = 0; k < out->n; k++) {
            long long o = out->row[k].order;
            if (o < 0 || o >= out->n) { rsv_why(why, cap, "manifest order outside 0..n-1", out->row[k].name); return -1; }
            if (seen[o]) { rsv_why(why, cap, "manifest duplicate order", out->row[k].name); return -1; }
            seen[o] = 1;
        }
    }
    return out->n;
}

/* 读整个文件到 mm 缓冲。返回字节数，或 -1。 */
static long rsv_read_file(const char *path, unsigned char **out) {
    int fd = sy_open_read(path);
    long n, got;
    sy_stat_t st;
    unsigned char *b;
    if (fd < 0) return -1;
    if (sy_fstat(fd, &st) || st.kind != 'f' || st.size < 0) { /* close via sy_close? */
        /* L0 fs has no sy_close exported here; use close from prelude? tools 层允许 libc */
        sy_close(fd);
        return -1;
    }
    n = st.size;
    b = malloc(n > 0 ? (size_t)n : 1);
    if (!b) { sy_close(fd); return -1; }
    got = sy_read_full(fd, b, n);
    sy_close(fd);
    if (got != 0) { free(b); return -1; }
    *out = b;
    return n;
}

/* 校验 sha256 与声明一致。返回 0 或非 0。 */
static int rsv_check_sha(const unsigned char *b, long n, const char *sha) {
    char h[65];
    if (sy_sha256_hex(b, n, h)) return -1;
    return tx_eqz(h, sha) ? 0 : -1;
}

/* 在目录 dir 里找 <name>，读并校验。命中返回字节(调用者释放)，否则 0。 */
static unsigned char *rsv_from_dir(const char *dir, const RsvManifestRow *r, long *on, char *why, int cap) {
    char p[4096];
    long n;
    unsigned char *b;
    if (!dir || !dir[0]) return 0;
    if (tx_len(dir, 4095) + 1 + tx_len(r->name, 511) >= 4096) { rsv_why(why, cap, "path overflow", r->name); return (unsigned char *)-1; }
    if (tx_copy(p, sizeof p, dir, tx_len(dir, 4095))) return 0;
    { long i = tx_len(p, sizeof p); if (i + 1 < sizeof p) { p[i] = '/'; p[i+1] = 0; } }
    if (tx_copy(p + tx_len(p, sizeof p), sizeof p - tx_len(p, sizeof p), r->name, tx_len(r->name, 511))) return 0;
    if (!sy_exists(p)) return 0;  /* 不存在：试下一来源 */
    n = rsv_read_file(p, &b);
    if (n < 0) { rsv_why(why, cap, "read failed", r->name); return (unsigned char *)-1; }
    if (n != r->size) { free(b); rsv_why(why, cap, "size mismatch", r->name); return (unsigned char *)-1; }
    if (rsv_check_sha(b, n, r->sha)) { free(b); rsv_why(why, cap, "sha256 mismatch", r->name); return (unsigned char *)-1; }
    *on = n;
    return b;
}

/* 惰性解析内嵌 pack。 */
static int rsv_pack_ready(RsvResolver *rs, char *why, int cap) {
    if (rs->pack_ready) return 0;
    if (!rs->pack[0]) { rsv_why(why, cap, "no embedded pack", 0); return -1; }
    {
        long n = rsv_read_file(rs->pack, &rs->pack_bytes);
        if (n < 0) { rsv_why(why, cap, "pack read failed", 0); return -1; }
        rs->pack_n = n;
        PackageFooter foot;
        if (!packagefooter_locate_bytes(rs->pack_bytes, n, &foot)) { rsv_why(why, cap, "pack footer", 0); return -1; }
        rs->pack_body = rs->pack_bytes + foot.package_offset;
        rs->pack_body_n = foot.package_length;
    }
    rs->pack_ready = 1;
    return 0;
}

/* 从 pack body 读一行（到 '\n' 不含）；*at 前进到 '\n' 后。返回长度或 -1。 */
static long rsv_pack_line(const unsigned char *d, long n, long *at) {
    long a = *at, e;
    if (a >= n) return -1;
    e = a;
    while (e < n && d[e] != '\n') e++;
    if (e >= n) return -1;
    *at = e + 1;
    return e - a;
}

/* 从一行里解析前 max 个非负十进制数，存到 out[]，返回解析到的个数。
 * 行首是 '<C> ' 后接数字（M 行）/ '<C> ' 后接多数字（F 行）。 */
static int rsv_line_nums(const unsigned char *line, long ln, long *out, int max) {
    long p = 0; int k = 0;
    while (p < ln && k < max) {
        while (p < ln && (line[p] < '0' || line[p] > '9')) p++;
        if (p >= ln) break;
        long v = 0;
        while (p < ln && line[p] >= '0' && line[p] <= '9') { v = v * 10 + (line[p] - '0'); p++; }
        out[k++] = v;
    }
    return k;
}

/* 从内嵌 pack 找 <name>（key = \x00+name），校验 sha。
 * 只扫 P3/P4 正文：跳过 header+D 行，M 行跳 payload，F 行比对 key。 */
static unsigned char *rsv_from_pack(RsvResolver *rs, const RsvManifestRow *r, long *on, char *why, int cap) {
    unsigned char key[513];
    long kl = tx_len(r->name, 511);
    long at = 0;
    if (rsv_pack_ready(rs, why, cap)) return (unsigned char *)-1;
    if (kl + 1 >= (long)sizeof key) { rsv_why(why, cap, "name overflow", r->name); return (unsigned char *)-1; }
    key[0] = 0;
    if (kl) { void *cx_kept = memcpy(key + 1, r->name, (size_t)kl); (void)cx_kept; }
    /* header 行取 ns（第 3 个数字，字段: P ver nm ns nr） */
    {
        long ln = rsv_pack_line(rs->pack_body, rs->pack_body_n, &at);
        long nums[4]; int nk;
        if (ln <= 0) return 0;
        nk = rsv_line_nums(rs->pack_body, ln, nums, 4);
        if (nk < 4) return 0;
        for (long i = 0; i < nums[2]; i++) { if (rsv_pack_line(rs->pack_body, rs->pack_body_n, &at) < 0) return 0; }
    }
    /* 逐行：M 行跳 stored payload；F 行比对。 */
    for (;;) {
        long ln = rsv_pack_line(rs->pack_body, rs->pack_body_n, &at);
        if (ln <= 0) return 0;
        const unsigned char *line = rs->pack_body + at - ln - 1;
        unsigned char c = line[0];
        if (c == 'M') {
            long nums[4]; int nk = rsv_line_nums(line, ln, nums, 4);
            if (nk < 1 || nums[0] <= 0 || at + nums[0] > rs->pack_body_n) return 0;
            at += nums[0];
        } else if (c == 'F') {
            long nums[6]; int nk = rsv_line_nums(line, ln, nums, 6);
            if (nk < 2) return 0;
            long nlen = nums[0], dlen = nums[1];
            long rawlen = nk >= 3 ? nums[2] : dlen;
            long codec = nk >= 4 ? nums[3] : 0;
            if (nlen <= 0 || dlen < 0 || nlen > rs->pack_body_n - at || dlen > rs->pack_body_n - at - nlen) return 0;
            if (nlen == kl + 1 && memcmp(rs->pack_body + at, key, (size_t)(kl + 1)) == 0) {
                const unsigned char *stored = rs->pack_body + at + nlen;
                unsigned char *raw;
                if (codec == 0) {
                    raw = malloc((size_t)dlen);
                    if (!raw) return (unsigned char *)-1;
                    if (dlen) { void *cx_kept = memcpy(raw, stored, (size_t)dlen); (void)cx_kept; }
                    if (dlen != r->size) { free(raw); rsv_why(why, cap, "size mismatch", r->name); return (unsigned char *)-1; }
                    if (rsv_check_sha(raw, dlen, r->sha)) { free(raw); rsv_why(why, cap, "sha256 mismatch", r->name); return (unsigned char *)-1; }
                    *on = dlen;
                    return raw;
                } else {
                    if (rawlen > 2147483647 || rawlen <= 0) return (unsigned char *)-1;
                    raw = malloc((size_t)rawlen);
                    if (!raw) return (unsigned char *)-1;
                    if (cxcodec_inflate(raw, (unsigned long)rawlen, stored, (unsigned long)dlen)) {
                        free(raw); rsv_why(why, cap, "inflate failed", r->name); return (unsigned char *)-1;
                    }
                    if (rawlen != r->size) { free(raw); rsv_why(why, cap, "size mismatch", r->name); return (unsigned char *)-1; }
                    if (rsv_check_sha(raw, rawlen, r->sha)) { free(raw); rsv_why(why, cap, "sha256 mismatch", r->name); return (unsigned char *)-1; }
                    *on = rawlen;
                    return raw;
                }
            }
            at += nlen + dlen;
        } else {
            return 0;
        }
    }
}

/* 核心：按来源顺序解析 name。返回字节（调用者 mm_free），失败返回 0 并写 why。
 * 找到来源但 sha 不符 → 拒绝（返回 -1 型，即 (unsigned char*)-1），不回退。 */
unsigned char *rsv_resolve(RsvResolver *rs, const char *name, const char *kind, const char *arch,
                           long *on, char *why, int cap) {
    RsvManifestRow *r = 0;
    int i;
    if (!rs || !name || !on) { rsv_why(why, cap, "bad resolve input", 0); return 0; }
    for (i = 0; i < rs->manifest->n; i++) {
        RsvManifestRow *c = &rs->manifest->row[i];
        /* B5d: when several rows match, the one with the smallest order wins -- the same
           order the manifest declares as the member sequence, not the file's row order. */
        if (tx_eqz(c->name, name) &&
            (!kind || tx_eqz(c->kind, kind)) &&
            (!arch || tx_eqz(c->arch, arch))) {
            if (!r || c->order < r->order) r = c;
        }
    }
    if (!r) { rsv_why(why, cap, "name not in manifest", name); return 0; }
    /* 1. UNISA_HOME */
    {
        unsigned char *b = rsv_from_dir(rs->home, r, on, why, cap);
        if (b == (unsigned char *)-1) return 0; /* 具名拒绝 */
        if (b) return b;
    }
    /* 2. com 旁目录 */
    {
        unsigned char *b = rsv_from_dir(rs->com, r, on, why, cap);
        if (b == (unsigned char *)-1) return 0;
        if (b) return b;
    }
    /* 3. 用户缓存 */
    {
        unsigned char *b = rsv_from_dir(rs->cache, r, on, why, cap);
        if (b == (unsigned char *)-1) return 0;
        if (b) return b;
    }
    /* 4. 内嵌 pack */
    {
        unsigned char *b = rsv_from_pack(rs, r, on, why, cap);
        if (b == (unsigned char *)-1) return 0;
        if (b) return b;
    }
    rsv_why(why, cap, "not found in any source", name);
    return 0;
}

/* 释放 resolver 持有的 pack 解析状态。 */
void rsv_release(RsvResolver *rs) {
    if (!rs) return;
    free(rs->pack_bytes);
    rs->pack_bytes = 0; rs->pack_n = 0;
    rs->pack_body = 0; rs->pack_body_n = 0; rs->pack_ready = 0;
}

/* 释放 manifest。 */
void rsv_manifest_release(RsvManifest *m) {
    if (!m) return;
    free(m->row);
    m->row = 0; m->n = 0; m->cap = 0;
}
