#pragma unisa module trailer
/* Commit message attribution stripping (project owner 2026-11-20: commits carry no attribution lines).
 * tr_strip(M) rewrites M in place: every whole line that, after leading blanks, starts with
 * "Co-Authored-By:" or "Signed-off-by:" (case-insensitive), or starts with "Generated with [Claude Code]"
 * after blanks and non-ASCII marks (case-insensitive, tool attribution), is dropped together with the blank lines right before it; a blank
 * separator is kept only when body text follows. Trailing blank lines then go. Other text is untouched.
 * Returns the number of lines dropped. Used by devsvc git commit, commit-own, dvgitx and tools/commit-msg.cx.
 *
 * Window trailer (freeze S0..S9, 2026-11-23): X-Unisacc-Window: <DEVSVC_OWNER>.
 * tr_window_ok / tr_window_put / tr_window_get. Not stripped by tr_strip. Does not stop a
 * forged trailer in a raw git commit; freeze-watch treats absence or mismatch as VIOLATION. */
static int tr_lc(char c) { return c >= 'A' && c <= 'Z' ? c + 32 : c; }
static int tr_pre(const char *s, const char *e, const char *pre) {
    for (; *pre; s++, pre++) { if (s >= e || tr_lc(*s) != *pre) return 0; }
    return 1;
}
int tr_is_attr(const char *s, const char *e) {
    while (s < e && (*s == ' ' || *s == '\t')) s++;
    if (tr_pre(s, e, "co-authored-by:") || tr_pre(s, e, "signed-off-by:")) return 1;
    while (s < e && (*s == ' ' || *s == '\t' || (unsigned char)*s >= 0x80)) s++;   /* an emoji or other non-ASCII mark may lead */
    return tr_pre(s, e, "generated with [claude code]");
}
static int tr_blank(const char *s, const char *e) {
    for (; s < e; s++) if (*s != ' ' && *s != '\t' && *s != '\r') return 0;
    return 1;
}
int tr_strip(char *m) {
    char *r = m, *w = m; int n = 0, sep = 0, endnl = 0;
    while (*r) {
        char *e = r; while (*e && *e != '\n') e++;
        int hasnl = *e == '\n'; long len = e - r, i;
        if (tr_is_attr(r, e)) {
            n++;
            while (w > m && w[-1] == '\n') {   /* drop the blank lines emitted right before it */
                char *p = w - 1; while (p > m && p[-1] != '\n') p--;
                if (!tr_blank(p, w - 1)) break;
                w = p;
            }
            if (w > m) sep = 1;
        } else if (sep && tr_blank(r, e)) {
            /* skipped: one separator is re-added before the next text line */
        } else {
            if (sep) { *w++ = '\n'; sep = 0; }
            for (i = 0; i < len; i++) *w++ = r[i];
            if (hasnl) *w++ = '\n';
        }
        r = hasnl ? e + 1 : e;
        if (hasnl && !*r) endnl = 1;
    }
    *w = 0;
    if (n) {
        while (w > m && (w[-1] == '\n' || w[-1] == ' ' || w[-1] == '\t' || w[-1] == '\r')) *--w = 0;
        if (endnl && w > m) { *w++ = '\n'; *w = 0; }
    }
    return n;
}
/* True when S is a real window owner name: 1..63 bytes, no whitespace, and not the
 * auto-/pane-/flow- prefixes that auto_owner() invents when DEVSVC_OWNER is unset. */
int tr_window_ok(const char *s) {
    long n = 0, i;
    if (!s || !s[0]) return 0;
    while (s[n]) {
        if (s[n] == ' ' || s[n] == '\t' || s[n] == '\n' || s[n] == '\r') return 0;
        n++;
        if (n >= 64) return 0;
    }
    if (n >= 5 && s[0] == 'a' && s[1] == 'u' && s[2] == 't' && s[3] == 'o' && s[4] == '-') return 0;
    if (n >= 5 && s[0] == 'p' && s[1] == 'a' && s[2] == 'n' && s[3] == 'e' && s[4] == '-') return 0;
    if (n >= 5 && s[0] == 'f' && s[1] == 'l' && s[2] == 'o' && s[3] == 'w' && s[4] == '-') return 0;
    for (i = 0; i < n; i++) {
        char c = s[i];
        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
            c == '-' || c == '_' || c == '.') continue;
        return 0;
    }
    return 1;
}

/* Read X-Unisacc-Window value from MSG (case-insensitive key). 1 if found. */
int tr_window_get(const char *msg, char *out, size_t cap) {
    const char *r;
    if (!msg || !out || cap < 2) return 0;
    out[0] = 0;
    r = msg;
    while (*r) {
        const char *e = r; long i, k;
        while (*e && *e != '\n') e++;
        i = 0;
        while (r + i < e && (r[i] == ' ' || r[i] == '\t')) i++;
        if (tr_pre(r + i, e, "x-unisacc-window:")) {
            const char *v = r + i + 17;
            while (v < e && (*v == ' ' || *v == '\t')) v++;
            k = 0;
            while (v + k < e && k + 1 < (long)cap) { out[k] = v[k]; k++; }
            while (k > 0 && (out[k - 1] == ' ' || out[k - 1] == '\t' || out[k - 1] == '\r')) k--;
            out[k] = 0;
            return k > 0 ? 1 : 0;
        }
        r = (*e == '\n') ? e + 1 : e;
    }
    return 0;
}

/* Copy MSG into DST; if NAME is tr_window_ok and MSG has no X-Unisacc-Window yet,
 * append a blank line and "X-Unisacc-Window: NAME\n". Never overwrites an existing
 * trailer (no forge). Returns 1 if appended, 0 if copied unchanged, -1 on overflow. */
int tr_window_put(char *dst, size_t cap, const char *msg, const char *name) {
    char have[80]; long n, nl, need; int i;
    static const char key[] = "X-Unisacc-Window: ";
    if (!dst || !cap || !msg) return -1;
    if (tr_window_get(msg, have, sizeof have) || !tr_window_ok(name)) {
        for (n = 0; msg[n]; n++) if (n + 1 >= (long)cap) return -1;
        for (i = 0; i <= (int)n; i++) dst[i] = msg[i];
        return 0;
    }
    n = 0; while (msg[n]) n++;
    while (n > 0 && (msg[n - 1] == '\n' || msg[n - 1] == '\r' || msg[n - 1] == ' ' || msg[n - 1] == '\t')) n--;
    nl = 0; while (name[nl]) nl++;
    need = n + 2 + 18 + nl + 1;
    if (need + 1 > (long)cap) return -1;
    for (i = 0; i < (int)n; i++) dst[i] = msg[i];
    dst[n++] = '\n'; dst[n++] = '\n';
    for (i = 0; i < 18; i++) dst[n++] = key[i];
    for (i = 0; i < (int)nl; i++) dst[n++] = name[i];
    dst[n++] = '\n';
    dst[n] = 0;
    return 1;
}
