#pragma unisa module trailer
/* Commit message attribution stripping (project owner 2026-11-20: commits carry no attribution lines).
 * tr_strip(M) rewrites M in place: every whole line that, after leading blanks, starts with
 * "Co-Authored-By:" or "Signed-off-by:" (case-insensitive), or starts with "Generated with [Claude Code]"
 * after blanks and non-ASCII marks (case-insensitive, tool attribution), is dropped together with the blank lines right before it; a blank
 * separator is kept only when body text follows. Trailing blank lines then go. Other text is untouched.
 * Returns the number of lines dropped. Used by devsvc git commit, commit-own, dvgitx and tools/commit-msg.cx. */
static int tr_lc(char c) { return c >= 'A' && c <= 'Z' ? c + 32 : c; }
static int tr_pre(const char *s, const char *e, const char *pre) {
    for (; *pre; s++, pre++) { if (s >= e || tr_lc(*s) != *pre) return 0; }
    return 1;
}
int tr_is_attr(const char *s, const char *e) {
    while (s < e && (*s == ' ' || *s == '\t')) s++;
    if (tr_pre(s, e, "co-authored-by:") || tr_pre(s, e, "signed-off-by:")) return 1;
    while (s < e && (*s == ' ' || *s == '\t' || (unsigned char)*s >= 0x80)) s++;   /* an emoji or other non-ASCII mark may lead */
    return tr_pre(s, e, "generated with [claude code]");
}
static int tr_blank(const char *s, const char *e) {
    for (; s < e; s++) if (*s != ' ' && *s != '\t' && *s != '\r') return 0;
    return 1;
}
int tr_strip(char *m) {
    char *r = m, *w = m; int n = 0, sep = 0, endnl = 0;
    while (*r) {
        char *e = r; while (*e && *e != '\n') e++;
        int hasnl = *e == '\n'; long len = e - r, i;
        if (tr_is_attr(r, e)) {
            n++;
            while (w > m && w[-1] == '\n') {   /* drop the blank lines emitted right before it */
                char *p = w - 1; while (p > m && p[-1] != '\n') p--;
                if (!tr_blank(p, w - 1)) break;
                w = p;
            }
            if (w > m) sep = 1;
        } else if (sep && tr_blank(r, e)) {
            /* skipped: one separator is re-added before the next text line */
        } else {
            if (sep) { *w++ = '\n'; sep = 0; }
            for (i = 0; i < len; i++) *w++ = r[i];
            if (hasnl) *w++ = '\n';
        }
        r = hasnl ? e + 1 : e;
        if (hasnl && !*r) endnl = 1;
    }
    *w = 0;
    if (n) {
        while (w > m && (w[-1] == '\n' || w[-1] == ' ' || w[-1] == '\t' || w[-1] == '\r')) *--w = 0;
        if (endnl && w > m) { *w++ = '\n'; *w = 0; }
    }
    return n;
}
