/* tools/cxlib/devsearch.cx -- devsvc search: rg-style bounded text search over the repo file set.
 *   ds_main(root, argc, argv, &stats)   argv = PATTERN [PATH...] [options]; prints matches on stdout, summary last.
 *   options: --fixed --ignore-case --glob G --max-count N --context N --files-only --count --limit-bytes N
 *            --deadline-ms N --all
 *   scope: git ls-files (tracked + untracked not ignored), minus archive/ and kernel/ and binary files
 *          (--all lifts those two excludes; an explicit PATH below archive/ or kernel/ lifts that one).
 *   pattern: --fixed is a substring; otherwise a small basic syntax: `.` any byte, leading `^`, trailing `$`,
 *            `\x` literal x. Unescaped [ ( ) { } * + ? | are refused by name (use --fixed or escape).
 *   bounds: output 65536 bytes, 500 matches (total, line mode), 20000 ms; hitting one prints
 *           `TRUNCATED reason=limit-bytes|max-count|deadline` and summary truncated=1.
 *   rc: 0 hit, 1 none, 2 usage or I/O error. Read only. */
#pragma unisa module devsearch
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.time
#pragma unisa use sys.env


#pragma unisa use mem.heap

typedef struct { long files, matches, ms; int truncated, rc; } ds_stats;

typedef struct { unsigned char c; unsigned char any; } ds_tok;
typedef struct {
    ds_tok t[512]; long n; int bol, eol, icase;
} ds_pat;

static unsigned char ds_lc(unsigned char c) { return (c >= 'A' && c <= 'Z') ? (unsigned char)(c + 32) : c; }

static int ds_parse(ds_pat *p, const char *s, int fixed, int icase) {
    long i = 0;
    p->n = 0; p->bol = 0; p->eol = 0; p->icase = icase;
    if (!fixed && s[0] == '^') { p->bol = 1; i = 1; }
    for (; s[i]; i++) {
        unsigned char c = (unsigned char)s[i];
        if (p->n >= 512) { printf("REFUSE EPATLEN pattern longer than 512\n"); return 1; }
        if (!fixed) {
            if (c == '\\') {
                if (!s[i + 1]) { printf("REFUSE ERXSYNTAX trailing backslash\n"); return 1; }
                c = (unsigned char)s[++i];
                p->t[p->n].c = icase ? ds_lc(c) : c; p->t[p->n].any = 0; p->n++;
                continue;
            }
            if (c == '$' && !s[i + 1]) { p->eol = 1; continue; }
            if (c == '.') { p->t[p->n].c = 0; p->t[p->n].any = 1; p->n++; continue; }
            if (c == '[' || c == '(' || c == ')' || c == '{' || c == '}' || c == '*' || c == '+' || c == '?' || c == '|') {
                printf("REFUSE ERXSYNTAX unsupported regex syntax '%c' (use --fixed or escape with backslash)\n", c);
                return 1;
            }
        }
        p->t[p->n].c = icase ? ds_lc(c) : c; p->t[p->n].any = 0; p->n++;
    }
    if (p->n == 0 && !p->bol && !p->eol) { printf("REFUSE EPATEMPTY empty pattern\n"); return 1; }
    return 0;
}

static int ds_line_hit(const ds_pat *p, const unsigned char *b, long ls, long le) {
    long s, k;
    for (s = ls; s <= le; s++) {
        if (p->bol && s != ls) return 0;
        if (s + p->n > le) return 0;
        for (k = 0; k < p->n; k++) {
            unsigned char c = b[s + k];
            if (p->t[k].any) continue;
            if ((p->icase ? ds_lc(c) : c) != p->t[k].c) break;
        }
        if (k == p->n && (!p->eol || s + p->n == le)) return 1;
        if (p->bol) return 0;
    }
    return 0;
}

/* glob: '?' one byte except '/', '*' run without '/', '**' any run. A glob with no '/' is matched against the basename. */
static int ds_glob(const char *g, const char *s) {
    for (;;) {
        if (*g == '*') {
            int deep = g[1] == '*';
            g += deep ? 2 : 1;
            if (deep && *g == '/' && ds_glob(g + 1, s)) return 1;
            for (;; s++) {
                if (ds_glob(g, s)) return 1;
                if (!*s || (!deep && *s == '/')) return 0;
            }
        }
        if (!*g) return !*s;
        if (*g == '?') { if (!*s || *s == '/') return 0; }
        else if (*g != *s) return 0;
        g++; s++;
    }
}

static int ds_has(const char *s, const char *pre) {
    long i = 0;
    while (pre[i]) { if (s[i] != pre[i]) return 0; i++; }
    return 1;
}

static int ds_num(const char *s, long lo, long hi, long *out) {
    long v = 0, i = 0;
    if (!s || !s[0]) return 1;
    for (; s[i]; i++) { if (s[i] < '0' || s[i] > '9' || v > 100000000L) return 1; v = v * 10 + (s[i] - '0'); }
    if (v < lo || v > hi) return 1;
    *out = v; return 0;
}

int ds_main(const char *root, int argc, char **argv, ds_stats *st) {
    ds_pat pat;
    const char *pattern = 0, *glob = 0, *paths[64];
    long np = 0, maxc = 500, ctx = 0, lim = 65536, dl = 20000, i, t0 = sy_now_ms();
    int fixed = 0, icase = 0, fonly = 0, count = 0, all = 0, optend = 0;
    sy_exit_t xs; struct { unsigned char *data; long len; } o; char lst[600]; int lfd; sy_spawn_t sp; char *v[10]; char rootarg[4096];
    long bytes = 0, hits = 0, files = 0, pos;
    int trunc = 0; const char *why = "";
    st->files = 0; st->matches = 0; st->ms = 0; st->truncated = 0; st->rc = 2;
    for (i = 0; i < argc; i++) {
        const char *a = argv[i];
        if (!optend && a[0] == '-' && a[1]) {
            if (!strcmp(a, "--")) { optend = 1; continue; }
            if (!strcmp(a, "--fixed") || !strcmp(a, "-F")) { fixed = 1; continue; }
            if (!strcmp(a, "--ignore-case") || !strcmp(a, "-i")) { icase = 1; continue; }
            if (!strcmp(a, "--files-only") || !strcmp(a, "-l")) { fonly = 1; continue; }
            if (!strcmp(a, "--count") || !strcmp(a, "-c")) { count = 1; continue; }
            if (!strcmp(a, "--all")) { all = 1; continue; }
            if (!strcmp(a, "--glob") || !strcmp(a, "--max-count") || !strcmp(a, "--context") || !strcmp(a, "--limit-bytes") || !strcmp(a, "--deadline-ms")) {
                const char *val = i + 1 < argc ? argv[i + 1] : 0; int bad = 0;
                if (!val) { printf("REFUSE EARG %s needs a value\n", a); return 2; }
                i++;
                if (!strcmp(a, "--glob")) glob = val;
                else if (!strcmp(a, "--max-count")) bad = ds_num(val, 1, 1000000, &maxc);
                else if (!strcmp(a, "--context")) bad = ds_num(val, 0, 20, &ctx);
                else if (!strcmp(a, "--limit-bytes")) bad = ds_num(val, 1, 16777216, &lim);
                else bad = ds_num(val, 0, 50000, &dl);
                if (bad) { printf("REFUSE EARG bad value for %s: %s\n", a, val); return 2; }
                continue;
            }
            printf("REFUSE EARG unknown option %s\n", a); return 2;
        }
        if (!pattern) pattern = a;
        else if (np < 64) paths[np++] = a;
        else { printf("REFUSE EARG too many paths (max 64)\n"); return 2; }
    }
    if (!pattern) { printf("REFUSE EARG usage: devsvc search PATTERN [PATH...] [--fixed] [--ignore-case] [--glob G] [--max-count N] [--context N] [--files-only] [--count] [--limit-bytes N] [--all]\n"); return 2; }
    if (fonly && count) { printf("REFUSE EARG --files-only and --count are exclusive\n"); return 2; }
    if (ds_parse(&pat, pattern, fixed, icase)) return 2;
    /* file list */
    { const char *tmp = sy_env("TMPDIR"); long z = 0, y; if (!tmp || !tmp[0]) tmp = "/tmp"; while (tmp[z] && z < 400) { lst[z] = tmp[z]; z++; } y = 0; { const char *sf = "/devsearch-ls-"; while (sf[y]) lst[z++] = sf[y++]; } { long pid = sy_pid(); char nb[16]; int nn = 0; while (pid > 0) { nb[nn++] = (char)(48 + pid % 10); pid /= 10; } while (nn > 0) lst[z++] = nb[--nn]; } lst[z] = 0; sy_unlink(lst); lfd = sy_open_new(lst, 0600); }
    { long k = 0, j; const char *s = "-C";
      v[k++] = "git"; v[k++] = (char *)s;
      for (j = 0; root[j] && j < 4095; j++) rootarg[j] = root[j];
      rootarg[j] = 0; v[k++] = rootarg;
      v[k++] = "ls-files"; v[k++] = "-z"; v[k++] = "--cached"; v[k++] = "--others"; v[k++] = "--exclude-standard"; v[k] = 0; }
    sy_spawn_init(&sp); sp.argv = v; sp.deadline_ms = 30000; sp.out_fd = lfd;
    { int64_t ln0 = 0; int pr = sy_proc_run(&sp, &xs); o.data = 0; o.len = 0;
      if (pr == 0 && !xs.timed_out && sy_exit_code(&xs) == 0 && sy_read_file(lst, &o.data, &ln0, 64L << 20) == 0) o.len = (long)ln0; else o.len = -1; sy_unlink(lst); }
    if (o.len < 0) {
        printf("REFUSE EGIT git ls-files failed or timed out\n"); return 2;
    }
    for (pos = 0; pos < o.len && !trunc; ) {
        long ps = pos, pe = pos, bn, n, ls, line, got, mark_n, last, lk;
        char path[4096], full[4400]; unsigned char *b = 0; int64_t bsz = 0; long cc = 0; int fhit = 0, skip = 0;
        while (pe < o.len && o.data[pe]) pe++;
        pos = pe + 1;
        if (pe - ps <= 0 || pe - ps >= 4000) continue;
        for (i = 0; i < pe - ps; i++) path[i] = (char)o.data[ps + i];
        path[pe - ps] = 0;
        if (sy_now_ms() - t0 >= dl) { trunc = 1; why = "deadline"; break; }
        if (np > 0) {
            int in = 0;
            for (i = 0; i < np; i++) {
                long pl = 0; const char *q = paths[i];
                while (q[0] == '.' && q[1] == '/') q += 2;
                while (q[pl]) pl++;
                while (pl > 0 && q[pl - 1] == '/') pl--;
                if (pl == 0 || q[0] == '.' && pl == 1) { in = 1; break; }
                if (!strncmp(path, q, pl) && (path[pl] == 0 || path[pl] == '/')) { in = 1; break; }
            }
            if (!in) continue;
        }
        if (!all) {
            if (ds_has(path, "archive/") || ds_has(path, "kernel/")) {
                const char *dn = ds_has(path, "archive/") ? "archive/" : "kernel/"; int lifted = 0;
                for (i = 0; i < np; i++) { const char *q = paths[i]; while (q[0] == '.' && q[1] == '/') q += 2; if (ds_has(q, dn)) lifted = 1; }
                if (!lifted) skip = 1;
            }
        }
        if (skip) continue;
        if (glob) {
            const char *base = path, *gm = path; long j;
            for (j = 0; path[j]; j++) if (path[j] == '/') base = path + j + 1;
            for (j = 0; glob[j]; j++) if (glob[j] == '/') gm = 0;
            if (!ds_glob(glob, gm ? base : path)) continue;
        }
        full[0] = 0;
        { long j = 0, k2 = 0; while (root[j] && k2 < 4300) full[k2++] = root[j++]; full[k2++] = '/'; for (j = 0; path[j]; j++) full[k2++] = path[j]; full[k2] = 0; }
        if (sy_read_file(full, &b, &bsz, 16L << 20) != 0 || !b) continue;
        n = (long)bsz;
        if (!all) { long lim8 = n < 8192 ? n : 8192; for (i = 0; i < lim8; i++) if (!b[i]) { skip = 1; break; } }
        if (skip) { mm_free(b); continue; }
        files++;
        /* pass over lines */
        mark_n = 0; last = -1; ls = 0; line = 1; (void)bn; (void)got; (void)mark_n; (void)lk;
        if (!pat.icase && !pat.bol && pat.n > 0) {   /* prefilter: a literal pattern absent from the whole buffer cannot hit any line */
            int lit = 1; long q, r;
            for (q = 0; q < pat.n; q++) if (pat.t[q].any) { lit = 0; break; }
            if (lit) {
                int found = 0;
                unsigned char f0 = pat.t[0].c;
                for (q = 0; q + pat.n <= n && !found; q++) {
                    if (b[q] != f0) continue;
                    for (r = 1; r < pat.n && b[q + r] == pat.t[r].c; r++) { }
                    if (r == pat.n) found = 1;
                }
                if (!found) { mm_free(b); continue; }
            }
        }
        {
            /* matched line starts remembered for context printing: scan twice when ctx > 0 */
            long pass;
            for (pass = (ctx > 0 && !fonly && !count ? 1 : 0); pass < (ctx > 0 && !fonly && !count ? 2 : 1); pass++) {
                long lstart = 0, ln = 1;
                long pr_last = 0;    /* last printed line number (pass 1) */
                while (lstart < n && !trunc) {
                    long le = lstart, ctxl;
                    int hit;
                    while (le < n && b[le] != '\n') le++;
                    hit = ds_line_hit(&pat, b, lstart, le);
                    if (pass == 0 && hit) {
                        cc++; fhit = 1;
                        if (fonly) break;
                        if (!count) {
                            char hdr[4200]; long hl, tl = le - lstart > 400 ? 400 : le - lstart, k3, jj = 0;
                            if (ctx > 0) { if (hits == 0 && 0) break; }
                            if (hits >= maxc) { trunc = 1; why = "max-count"; break; }
                            hl = 0; while (path[hl]) { hdr[hl] = path[hl]; hl++; }
                            if (ctx == 0) {
                                char nb[24]; long nn = 0, q = ln;
                                hdr[hl++] = ':';
                                while (q > 0) { nb[nn++] = (char)('0' + q % 10); q /= 10; }
                                while (nn > 0) hdr[hl++] = nb[--nn];
                                hdr[hl++] = ':';
                                if (bytes + hl + tl + 1 > lim) { trunc = 1; why = "limit-bytes"; break; }
                                fwrite(hdr, 1, (size_t)hl, stdout); fwrite(b + lstart, 1, (size_t)tl, stdout); fputc('\n', stdout);
                                bytes += hl + tl + 1;
                            }
                            hits++; (void)k3; (void)jj;
                        }
                    }
                    if (pass == 1 && hit && hits < maxc + 1000000) {
                        /* print lines ln-ctx .. ln+ctx not yet printed: re-walk from line start */
                        long from = ln - ctx > pr_last + 1 ? ln - ctx : pr_last + 1, cl = 1, cs = 0;
                        long to = ln + ctx;
                        if (hits >= maxc) { trunc = 1; why = "max-count"; break; }
                        while (cs < n && cl <= to) {
                            long ce = cs; char hdr[4200], nb[24]; long hl = 0, nn = 0, q = cl, tl;
                            while (ce < n && b[ce] != '\n') ce++;
                            if (cl >= from) {
                                int ish = ds_line_hit(&pat, b, cs, ce);
                                tl = ce - cs > 400 ? 400 : ce - cs;
                                if (pr_last > 0 && cl > pr_last + 1 && cl == from) { if (bytes + 3 > lim) { trunc = 1; why = "limit-bytes"; break; } fputs("--\n", stdout); bytes += 3; }
                                while (path[hl]) { hdr[hl] = path[hl]; hl++; }
                                hdr[hl++] = ish ? ':' : '-';
                                while (q > 0) { nb[nn++] = (char)('0' + q % 10); q /= 10; }
                                while (nn > 0) hdr[hl++] = nb[--nn];
                                hdr[hl++] = ish ? ':' : '-';
                                if (bytes + hl + tl + 1 > lim) { trunc = 1; why = "limit-bytes"; break; }
                                fwrite(hdr, 1, (size_t)hl, stdout); fwrite(b + cs, 1, (size_t)tl, stdout); fputc('\n', stdout);
                                bytes += hl + tl + 1; pr_last = cl;
                            }
                            cl++; cs = ce + 1;
                        }
                        hits++;
                    }
                    (void)ctxl; (void)last;
                    ln++; lstart = le + 1;
                }
                if (trunc) break;
            }
        }
        if (pat.n == 0 && 0) {}
        if (fhit && (fonly || count)) {
            char ob[4200]; long hl = 0;
            while (path[hl]) { ob[hl] = path[hl]; hl++; }
            if (count) { char nb[24]; long nn = 0, q = cc; ob[hl++] = ':'; if (q == 0) nb[nn++] = '0'; while (q > 0) { nb[nn++] = (char)('0' + q % 10); q /= 10; } while (nn > 0) ob[hl++] = nb[--nn]; }
            ob[hl++] = '\n';
            if (bytes + hl > lim) { trunc = 1; why = "limit-bytes"; }
            else { fwrite(ob, 1, (size_t)hl, stdout); bytes += hl; }
            hits += (fonly ? 1 : cc);
        }
        (void)line; (void)ls;
        mm_free(b);
    }
    { long mfiles = 0; (void)mfiles; }
    st->files = files; st->matches = hits; st->truncated = trunc; st->ms = sy_now_ms() - t0;
    if (trunc) printf("TRUNCATED reason=%s\n", why);
    printf("SEARCH files=%ld matches=%ld truncated=%d ms=%ld\n", files, hits, trunc, st->ms);
    st->rc = hits > 0 ? 0 : 1;
    return st->rc;
}
