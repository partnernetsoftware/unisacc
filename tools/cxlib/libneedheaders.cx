/* Canonical historical compiler-header inventory bytes; observation stays with each caller. */
#pragma unisa use cxlib.netpack
void lh_header_begin(np_buf *out){np_puts(out,"compiler-historical-include-inventory-v1\n");}
void lh_header_row(np_buf *out,const char *name,unsigned mode,int directory,size_t bytes,const char *sha){
 np_puts(out,directory?"directory\t":"header-input\t");np_puts(out,name);np_puts(out,"\t");np_putll(out,mode);
 if(!directory){np_puts(out,"\t");np_putll(out,(long long)bytes);np_puts(out,"\t");np_puts(out,sha);}np_puts(out,"\n");
}
