/* Canonical source-package-v1 and individual-job read-only endpoint verifier.
 * Based on the frozen 9c2e foundation and 5c7a producer specifications; neither
 * producer is edited or resealed. Original ROOT product/record roles resolve
 * only to the context's explicit bootstrap when BOTH original hashes match.
 * This does not reconstruct NN, run a compiler, cache test PASS, or prove
 * historical execution, atomic filesystem snapshots, or ABA resistance. */
#pragma unisa module sourcepackage
#pragma unisa use netpack
#pragma unisa use kernelsha
/* Read-only, one-endpoint material snapshots. fresh_source MUST come from the
 * caller's actual current seed/ident observation; never pass a saved receipt
 * as fresh evidence. Call again after the operation for a physical reread.
 * Linux/x86_64 single-threaded construction/test callers only. Verification
 * runs in a forked copy of this SAME compiled caller, with no exec, compiler,
 * generator or package writer. Child-private state dies with that snapshot;
 * errors return to the parent instead of exiting it. Caller outer limits still
 * apply; SECONDS<=55 is only an additional bound, never extra caller time.
 * artifact/manifest/receipt describe compiler.pkg/model-inputs.tsv/package.tsv
 * for package snapshots, or target output/context/record.tsv for job snapshots.
 * sp_verify_jobs_snapshot adds a PARTIAL named-job UNION endpoint. Each call
 * has the same new child/view and unchanged canonical per-job verifier; shared
 * ancestors are validated once within that endpoint, never across calls.
 * Its distinct source-package-jobs-snapshot-v1 report cannot stand for a full
 * package. artifact/receipt are domain-separated canonical union output/job-
 * receipt digests, manifest is context SHA, jobs counts unique ancestors plus
 * leaves, models counts complete verified net-* jobs (not gen-only recipes).
 * With 34 gen-or-net recipe leaves and k>=1 net leaves the union has 37+2*k
 * jobs; with no
 * net leaves only tool-gen is required (35 jobs). Explicit tool-tbl/tool-net
 * roots may be included to bind those converters even when all nets are reused.
 * The 1..107 explicit job IDs must be known and unique; ancestor overlap is
 * allowed. compilerpack/pack are included only when requested or depended on;
 * the gen/tbl/net union never silently attests their execution or a P3 package.
 */
typedef struct {char source[65],artifact[65],manifest[65],receipt[65],witness[65],epoch_artifact[65],epoch_record[65],epoch_path[4096],producer[65],foundation[65],verifier[65],digest_module[65];int jobs,models,physical_reads;long long elapsed_ns;} sp_result;
/* Recorded-job material has an explicit weaker source role. current_source is
 * caller freshly measured (same trust interface as fresh-source APIs), whereas
 * recorded_source is only the source label reconstructed in immutable job
 * records. This API does not rescan historical sources, execute gen, establish
 * current JSON equivalence/applicability, or qualify a current build. */
typedef struct {sp_result material;char current_source[65],recorded_source[65],binding[65];} sp_recorded_jobs_result;
/* Request bytes only, inherited by a private child and cleared on return.
 * Single-threaded caller scope as above; no cross-call view or result cache. */
static char sp_recorded_current[65];
static const char *sp_recorded_scope="MATERIAL_ONLY-recorded-source-not-historical-source-snapshot-current-build-or-applicability";
/* Origin-only API reports captured material and current execution separately.
 * Old verifier bytes are a specification input, never the executing identity. */
typedef struct {sp_result material;char logical_root[4096],snapshot_root[4096],logical_package[4096],physical_package[4096],current_verifier_root[4096],execution_profile_path[4096],executing_elf_path[4096],origin_spec[65],executing_verifier[65],executing_elf[65],execution_profile[65],execution_closure[65],mapping_witness[65];int execution_reads;} sp_origin_result;
typedef struct {const char *logical_root,*snapshot_root,*logical_package,*current_root,*profile;} SpOriginRequest;
typedef struct {char *logical,*physical;} SpOriginMap;
static int sp_origin_mode,sp_origin_map_count;static size_t sp_origin_map_bytes;static SpOriginMap sp_origin_maps[8192];
static sp_origin_result sp_origin_state;
static const char *sp_origin_spec_pin="407f5ef7bd8cf0b65d1086db12b36ab6e19627dc8a0ed5f2e4002df8eae22442";
typedef struct {const char *id,*stage,*flags[4];} SpModel;
