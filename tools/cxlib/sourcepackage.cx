static char **owned_environment;
static char supplied_source[65],epoch_product[4096],epoch_metadata[4400],logical_product[4400],logical_metadata[4600];static int epoch_ready;
static const char *producer_pin="dd6f5e6068289d04346f202035fb1ae3c84a10e254630c7ba5a650c7a06deb46";
typedef struct {char *physical,*bytes;size_t n;char hash[65];unsigned char prefix[64];size_t prefix_n;mode_t mode;} SpObservedFile;
static SpObservedFile sp_files[4096];static int sp_file_count,sp_observation_hits;static size_t sp_kept_bytes;
/* Endpoint-private lookup accelerators only. Zero=empty, otherwise the original
 * insertion-order vector index+1. Half-full maxima retain bounded probing;
 * unsigned hash collisions ALWAYS require exact strcmp, never identity trust. */
static int sp_file_index[8192],sp_map_index[16384];
/* Only within one fresh endpoint observation. Entries are populated from
 * actual reads + canonical byte comparisons, never persisted or used across
 * check_context calls. The after endpoint physically rereads every dependency.
 * These are digest observations, not cached execution/test verdicts. */
static int job_seen[107];static char job_receipt_sha[107][65],job_output_sha[107][65];
static np_buf kernel_observation={0};static int kernel_observed;
static const char *ident_flags="-std=c99 -D_POSIX_C_SOURCE=200809L -O2 -w";
static void die(const char *s){fprintf(stderr,"sourcepackage: REFUSE %s errno=%d\n",s,errno);fflush(stderr);_exit(2);}
/* Digest provider is an explicit Linux kernel-crypto dependency. Every actual
 * read buffer is hashed once by the selected algorithm; AF_ALG never supplies
 * a saved file digest or test verdict. Failure has no silent fallback. */
/* Material reconstruction preserves the frozen dd6 producer's declaration.
 * Runtime reports separately name the executing verifier's actual policy;
 * both providers compute the same SHA256 bytes. No material is rewritten. */
static const char *material_digest_provider="sha256-hybrid-v3;bytes>=65536:Linux-AF_ALG/hash/sha256;smaller:cx_sha256_hex;KS-rc0-or-negative-Linux-errno;kernel-crypto-DECLARED";
static const char *digest_provider="sha256-hybrid-v4;bytes>=1024:Linux-AF_ALG/hash/sha256;smaller:cx_sha256_hex;KS-rc0-or-negative-Linux-errno;kernel-crypto-DECLARED";
static const char *digest_module_pin="8ad60f9004f98b6bd68397668e1c6feabe468bb5be4b5ec9aedc4494aa541e31";
static void kernel_hash_checked(const void *bytes,size_t n,char h[65],const char *tag){int rc=ks_sha256_hex(bytes,n,h);if(rc){char why[200];snprintf(why,sizeof why,"%s kernelsha-rc=%d",tag,rc);die(why);}}
static void digest_selfcheck(void){char h[65];kernel_hash_checked("",0,h,"kernel-sha256-empty-selfcheck");if(strcmp(h,"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"))die("kernel-sha256-empty-vector-mismatch");kernel_hash_checked("abc",3,h,"kernel-sha256-abc-selfcheck");if(strcmp(h,"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"))die("kernel-sha256-abc-vector-mismatch");}
static void hash_bytes(const void *bytes,size_t n,char h[65]){if(n>=1024)kernel_hash_checked(bytes,n,h,"kernel-sha256-buffer-failure");else cx_sha256_hex(bytes,n,h);}
static int forbidden_environment(const char *s){const char *keys[]={"SEED_GEN_GENERIC","SEED_GEN_TRACE","UNISACC_SEED_TRACE","UNISACC_RF_CAPTURE","UNISA_ATTRIBUTES"};for(int i=0;i<5;i++){size_t n=strlen(keys[i]);if(!strncmp(s,keys[i],n)&&s[n]=='=')return 1;}return 0;}
static void clean_environment(void){size_t n=0;for(char **p=environ;*p;p++)n++;if(n>1048576)die("environment-entry-bound");char **next=malloc((n+1)*sizeof *next);if(!next)die("allocation");size_t at=0;for(char **p=environ;*p;p++)if(!forbidden_environment(*p))next[at++]=*p;next[at]=0;char **old=owned_environment;environ=next;owned_environment=next;free(old);for(char **p=environ;*p;p++)if(forbidden_environment(*p))die("environment-policy-not-applied-to-raw-environ");}
static void path(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path-bound");}
static void clean(const char *p){if(!p[0]||strpbrk(p,"\r\n\t"))die("unclean-path");}
static int sp_within(const char *p,const char *base){size_t n=strlen(base);return !strncmp(p,base,n)&&(!p[n]||p[n]=='/');}
static void sp_lexical(const char *p){clean(p);size_t n=strlen(p);if(n<2||n>=4096||p[0]!='/'||p[n-1]=='/'||strstr(p,"//"))die("origin-absolute-canonical-spelling");const char *a=p+1;while(*a){const char *e=strchr(a,'/');size_t z=e?(size_t)(e-a):strlen(a);if((z==1&&a[0]=='.')||(z==2&&a[0]=='.'&&a[1]=='.'))die("origin-dot-component");if(!e)break;a=e+1;}}
/* Physical paths are checked directly, never sent through the logical mapper.
 * No parent symlink is allowed, even if a realpath could land within the root.
 * These checks are not an atomic namespace or hostile-concurrency guarantee. */
static void sp_direct_canonical(const char *p){sp_lexical(p);char resolved[4400],part[4400];if(!realpath(p,resolved)||strcmp(p,resolved))die("origin-physical-not-canonical");strcpy(part,p);for(size_t i=1;;i++){if(part[i]&&part[i]!='/')continue;char c=part[i];part[i]=0;struct stat st;if(lstat(part,&st)||S_ISLNK(st.st_mode)||(c&&!S_ISDIR(st.st_mode)))die("origin-symlink-or-parent");part[i]=c;if(!c)break;}}
static unsigned long long sp_path_hash(const char *p){unsigned long long h=14695981039346656037ULL;for(;*p;p++){h^=(unsigned char)*p;h*=1099511628211ULL;}return h;}
static int sp_file_slot(const char *physical){unsigned at=(unsigned)(sp_path_hash(physical)&8191ULL);for(int probe=0;probe<8192;probe++){int id=sp_file_index[at];if(!id)return (int)at;if(id<1||id>sp_file_count)die("endpoint-file-index-invariant");if(!strcmp(sp_files[id-1].physical,physical))return (int)at;at=(at+1)&8191U;}die("endpoint-file-index-probe-bound");return -1;}
static int sp_map_slot(const char *logical){unsigned at=(unsigned)(sp_path_hash(logical)&16383ULL);for(int probe=0;probe<16384;probe++){int id=sp_map_index[at];if(!id)return (int)at;if(id<1||id>sp_origin_map_count)die("origin-map-index-invariant");if(!strcmp(sp_origin_maps[id-1].logical,logical))return (int)at;at=(at+1)&16383U;}die("origin-map-index-probe-bound");return -1;}
static void sp_indices_init(void){if(sp_file_count||sp_origin_map_count)die("endpoint-initial-view-not-empty");memset(sp_file_index,0,sizeof sp_file_index);memset(sp_map_index,0,sizeof sp_map_index);}
static void sp_map_note(const char *logical,const char *physical){int slot=sp_map_slot(logical),id=sp_map_index[slot];if(id){if(strcmp(physical,sp_origin_maps[id-1].physical))die("origin-mapping-changed");return;}size_t n=strlen(logical)+strlen(physical)+2;if(sp_origin_map_count==8192||n>8388608-sp_origin_map_bytes)die("origin-mapping-bound");SpOriginMap *m=&sp_origin_maps[sp_origin_map_count++];m->logical=strdup(logical);m->physical=strdup(physical);if(!m->logical||!m->physical)die("allocation");sp_origin_map_bytes+=n;sp_map_index[slot]=sp_origin_map_count;}
static const char *sp_physical(const char *logical){const char *p=logical;if(epoch_ready&&!strcmp(p,logical_product))p=epoch_product;else if(epoch_ready&&!strcmp(p,logical_metadata))p=epoch_metadata;if(!sp_origin_mode)return p;sp_lexical(p);if(!sp_within(p,sp_origin_state.logical_root))die("origin-path-outside-logical-root");if(sp_within(p,sp_origin_state.snapshot_root))die("origin-physical-path-used-as-logical");static char mapped[4400];size_t n=strlen(sp_origin_state.logical_root);int z=snprintf(mapped,sizeof mapped,"%s%s",sp_origin_state.snapshot_root,p+n);if(z<0||(size_t)z>=sizeof mapped)die("origin-mapped-path-bound");struct stat st;errno=0;if(lstat(mapped,&st)){if(errno!=ENOENT)die("origin-mapped-path-stat");char parent[4400];strcpy(parent,mapped);char *slash=strrchr(parent,'/');if(!slash||slash==parent)die("origin-mapped-parent");*slash=0;sp_direct_canonical(parent);}else sp_direct_canonical(mapped);sp_map_note(logical,mapped);return mapped;}
static void canonical(const char *p){if(sp_origin_mode){sp_lexical(p);sp_direct_canonical(sp_physical(p));return;}char actual[4400];clean(p);if(p[0]!='/'||!realpath(p,actual)||strcmp(p,actual))die("canonical-input-path-required");}
static void sp_set_logical(const char *p,char out[4096]){sp_lexical(p);if(!sp_within(p,sp_origin_state.logical_root))die("origin-path-outside-logical-root");strcpy(out,p);canonical(out);}
static int sp_suffix(const char *p,const char *s){size_t n=strlen(p),z=strlen(s);return n>=z&&!strcmp(p+n-z,s);}
/* Unique physical reads per endpoint. Large JSON/table/net artifacts retain
 * only actual SHA/size/prefix, never their buffers or a PASS. Small parseable
 * metadata and the two kernel bodies are retained with a fixed64MiB ceiling.
 * Every exported snapshot creates a new child and therefore an empty view. */
static SpObservedFile *sp_observe(const char *logical,int want_bytes){const char *p=sp_physical(logical);int slot=sp_file_slot(p),id=sp_file_index[slot];if(id){SpObservedFile *f=&sp_files[id-1];sp_observation_hits++;if(want_bytes&&!f->bytes)die("parse-bytes-not-retained-in-endpoint-view");return f;}if(sp_file_count==4096)die("endpoint-file-bound");struct stat a,b;errno=0;if(lstat(p,&a))die(errno==ENOENT?"input-absent":"input-stat");if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>134217728)die("bounded-regular-input");int fd=open(p,O_RDONLY|O_NOFOLLOW|O_NONBLOCK|O_CLOEXEC);if(fd<0||fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size)die("input-descriptor");size_t n=(size_t)a.st_size;char *s=malloc(n+1);if(!s)die("allocation");size_t at=0;while(at<n){ssize_t z=read(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("input-extent");at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int bad=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(z||bad||closed)die("input-changed-or-close");s[n]=0;SpObservedFile *f=&sp_files[sp_file_count++];f->physical=strdup(p);if(!f->physical)die("allocation");f->n=n;f->mode=a.st_mode;hash_bytes(s,n,f->hash);f->prefix_n=n<64?n:64;memcpy(f->prefix,s,f->prefix_n);int keep=want_bytes||sp_suffix(p,".tsv")||sp_suffix(p,".status")||sp_suffix(p,".build.json")||sp_suffix(p,".kernel");if(keep){if(n>16777216||n>67108864-sp_kept_bytes)die("endpoint-parse-buffer-bound");f->bytes=s;sp_kept_bytes+=n;}else free(s);sp_file_index[slot]=sp_file_count;return f;}
static char *load(const char *p,size_t *n){SpObservedFile *f=sp_observe(p,1);char *copy=malloc(f->n+1);if(!copy)die("allocation");memcpy(copy,f->bytes,f->n+1);*n=f->n;return copy;}
static void digest(const char *p,char h[65]){SpObservedFile *f=sp_observe(p,0);memcpy(h,f->hash,65);}
static void row(np_buf *b,const char *k,const char *v){np_puts(b,k);np_puts(b,"\t");np_puts(b,v);np_puts(b,"\n");}
static void digest_identity(np_buf *b){char p[4400],h[65];path(p,root,"tools/cxlib/kernelsha.cx");digest(p,h);if(strcmp(h,digest_module_pin))die("kernel-sha256-module-identity");row(b,"digest-provider",material_digest_provider);row(b,"kernelsha-module",h);}
static void equal(const char *p,const np_buf *expected){size_t n;char *s=load(p,&n);int ok=n==expected->n&&!memcmp(s,expected->p,n);free(s);if(!ok)die("receipt-bytes-mismatch");}
static void optional_digest(const char *artifact,char out[65]){char p[4600];int n=snprintf(p,sizeof p,"%s.build.json",artifact);if(n<0||(size_t)n>=sizeof p)die("metadata-path");struct stat st;errno=0;if(lstat(sp_physical(p),&st)){if(errno!=ENOENT)die("metadata-stat");strcpy(out,"ABSENT");return;}digest(p,out);}
static void observe_inputs(void){digest(cc,cc_sha);digest(helper,helper_sha);digest(bootstrap,bootstrap_sha);digest(product,product_sha);digest(self,self_sha);digest(netpack,netpack_sha);digest(bound,bound_sha);digest(bound_c,bound_c_sha);digest(ident,ident_sha);char p[4400];path(p,ctx,"cc.version");digest(p,cc_version_sha);}
static np_buf context_record(void){clean_environment();np_buf b={0};np_puts(&b,"source-package-context-v1\n");row(&b,"status","PREPARED_CONTEXT_ONLY");row(&b,"environment-policy",environment_policy);row(&b,"root",root);row(&b,"context",ctx);row(&b,"source",sid);row(&b,"bootstrap",bootstrap);row(&b,"bootstrap-sha",bootstrap_sha);char h[65];optional_digest(bootstrap,h);row(&b,"bootstrap-build-record-sha",h);row(&b,"root-product-sha",product_sha);optional_digest(product,h);row(&b,"root-build-record-sha",h);row(&b,"cc",cc);row(&b,"cc-sha",cc_sha);row(&b,"cc-version-sha",cc_version_sha);row(&b,"identity-helper",helper_sha);row(&b,"identity-source",ident_sha);row(&b,"identity-flags",ident_flags);row(&b,"controller",self_sha);row(&b,"netpack",netpack_sha);row(&b,"bound",bound_sha);row(&b,"bound.c",bound_c_sha);row(&b,"host-process","Linux/x86_64-LP64");row(&b,"host-dependencies","CC-subtools-system-headers-linker-libraries-and-zlib-DECLARED-NOT-HERMETICALLY-HASHED");row(&b,"reference-executable","NOT-INVOKED-by-native-seed-C-APIs");row(&b,"scope","root-assisted-initial-source-observation;bootstrap-trusted;no-test-result;no-complete-N22-or-zero-Python-chain-claim");return b;}
/* Extract paths only; reconstruct and exact-compare all context bytes using
 * fresh observations before trusting any previously completed job receipt. */
static void extract_path(const char *s,const char *key,char *dest,size_t cap){char needle[80];int z=snprintf(needle,sizeof needle,"\n%s\t",key);if(z<0||(size_t)z>=sizeof needle)die("context-key");const char *a=strstr(s,needle);if(!a||strstr(a+1,needle))die("unique-context-path");a+=strlen(needle);const char *e=strchr(a,'\n');if(!e||e==a||(size_t)(e-a)>=cap)die("context-path-bound");memcpy(dest,a,(size_t)(e-a));dest[e-a]=0;canonical(dest);}
static void check_context(void){memset(job_seen,0,sizeof job_seen);free(kernel_observation.p);kernel_observation=(np_buf){0};kernel_observed=0;canonical(ctx);char p[4400];path(p,ctx,"context.tsv");size_t n;char *s=load(p,&n);if(!n||s[n-1]!='\n'||memchr(s,0,n)||memchr(s,'\r',n))die("context-wire");extract_path(s,"cc",cc,sizeof cc);extract_path(s,"bootstrap",bootstrap,sizeof bootstrap);free(s);observe_inputs();strcpy(sid,supplied_source);np_buf expected=context_record();equal(p,&expected);hash_bytes(expected.p,expected.n,context_sha);free(expected.p);}
typedef struct {int tool,recipe,phase;} SpJob;
static SpJob find_job(const char *id){SpJob j={-1,-1,-1};for(int i=0;i<5;i++){char name[80];snprintf(name,sizeof name,"tool-%s",tools[i]);if(!strcmp(id,name)){j.tool=i;return j;}}const char *phases[]={"gen-","tbl-","net-"};for(int p=0;p<3;p++)for(int m=0;m<(int)(sizeof recipes/sizeof *recipes);m++){char name[160];snprintf(name,sizeof name,"%s%s",phases[p],recipes[m].id);if(!strcmp(id,name)){j.recipe=m;j.phase=p;return j;}}die("unknown-or-PLANNED-job");return j;}
static void job_paths(const char *id,SpJob j,char dir[4400],char output[4400],char receipt[4400]){path(dir,jobs,id);path(output,dir,j.tool>=0?"result.exe":j.phase==0?"result.json":j.phase==1?"result.tbl":"result.net");path(receipt,dir,"record.tsv");}
static int job_command(const char *id,SpJob j,char **v,char output[4400],char executable[4400],char source[4400],char include[4400],char dependency[4400]){char dir[4400],receipt[4400];job_paths(id,j,dir,output,receipt);int n=0;v[n++]=bound;v[n++]="40";
 if(j.tool>=0){v[n++]=cc;v[n++]="-std=c99";v[n++]="-O2";v[n++]="-w";path(include,root,"seed");v[n++]="-I";v[n++]=include;char name[100];snprintf(name,sizeof name,"seed/%s.c",tools[j.tool]);path(source,root,name);v[n++]=source;v[n++]="-o";v[n++]=output;if(j.tool==4)v[n++]="-lz";}
 else{char name[160],tool_dir[4400];snprintf(name,sizeof name,"tool-%s",tools[j.phase]);path(tool_dir,jobs,name);path(executable,tool_dir,"result.exe");v[n++]=executable;if(!j.phase){v[n++]=(char *)recipes[j.recipe].stage;v[n++]=output;for(int i=0;i<4&&recipes[j.recipe].flags[i];i++)v[n++]=(char *)recipes[j.recipe].flags[i];}else{snprintf(name,sizeof name,"%s-%s",j.phase==1?"gen":"tbl",recipes[j.recipe].id);SpJob dj=find_job(name);char dd[4400],dr[4400];job_paths(name,dj,dd,dependency,dr);v[n++]=dependency;v[n++]=output;}}
 v[n]=0;return n;
}
static void verify_job(const char *id,int depth);
static int job_index(SpJob j){return j.tool>=0?j.tool:5+j.recipe*3+j.phase;}
/* Parent-side job-list validation must not call find_job: its existing child
 * refusal uses _exit. No I/O/global observation state is touched here. */
static int sp_known_job_id(const char *id){char name[160];for(int i=0;i<5;i++){snprintf(name,sizeof name,"tool-%s",tools[i]);if(!strcmp(id,name))return 1;}const char *phases[]={"gen","tbl","net"};for(int m=0;m<34;m++)for(int p=0;p<3;p++){snprintf(name,sizeof name,"%s-%s",phases[p],recipes[m].id);if(!strcmp(id,name))return 1;}return 0;}
static int sp_job_list_valid(const char *const *ids,int n){if(!ids||n<1||n>107)return 0;for(int i=0;i<n;i++){if(!ids[i]||!*ids[i]||strlen(ids[i])>=160||!sp_known_job_id(ids[i]))return 0;for(int j=0;j<i;j++)if(!strcmp(ids[i],ids[j]))return 0;}return 1;}
static void dependency(np_buf *b,const char *id,int depth){verify_job(id,depth+1);SpJob j=find_job(id);int at=job_index(j);char dir[4400],out[4400],receipt[4400];job_paths(id,j,dir,out,receipt);row(b,id,job_receipt_sha[at]);row(b,out,job_output_sha[at]);}
static np_buf job_record_observed(const char *id,SpJob j,int depth,char actual_output_sha[65]){clean_environment();np_buf b={0};np_puts(&b,"source-package-job-v1\n");row(&b,"status","PREPARED-no-test-result");row(&b,"environment-policy",environment_policy);row(&b,"context",context_sha);row(&b,"source",sid);row(&b,"job",id);if(j.tool<0){char name[160];snprintf(name,sizeof name,"tool-%s",tools[j.phase]);dependency(&b,name,depth);if(j.phase){snprintf(name,sizeof name,"%s-%s",j.phase==1?"gen":"tbl",recipes[j.recipe].id);dependency(&b,name,depth);}}
 char *v[20],out[4400],exe[4400],src[4400],inc[4400],dep[4400];int n=job_command(id,j,v,out,exe,src,inc,dep);np_buf argv={0};for(int i=0;i<n;i++){char key[32];snprintf(key,sizeof key,"arg-%d",i);row(&b,key,v[i]);row(&argv,key,v[i]);}char h[65],dir[4400],receipt[4400],evidence[4400];job_paths(id,j,dir,out,receipt);path(evidence,dir,"command.argv.tsv");equal(evidence,&argv);free(argv.p);np_buf success={0};np_puts(&success,"rc\t0\n");path(evidence,dir,"command.status");equal(evidence,&success);free(success.p);const char *logs[]={"command.argv.tsv","command.stdout","command.stderr","command.status"};for(int i=0;i<4;i++){path(evidence,dir,logs[i]);digest(evidence,h);row(&b,logs[i],h);}if(j.tool>=0){digest(src,h);row(&b,"actual-seed-source",h);}else{digest(exe,h);row(&b,"actual-native-tool",h);}SpObservedFile *observed=sp_observe(out,0);if(!observed->n)die("empty-job-output");if(j.tool>=0){const unsigned char *bytes=observed->prefix;if(observed->prefix_n<64||memcmp(bytes,"\177ELF",4)||bytes[4]!=2||bytes[5]!=1||bytes[18]!=62||bytes[19]||access(sp_physical(out),X_OK))die("native-tool-not-executable-ELF64-x86_64");}memcpy(h,observed->hash,65);row(&b,"output",out);row(&b,"output-sha",h);if(actual_output_sha)strcpy(actual_output_sha,h);return b;
}
static void verify_job(const char *id,int depth){if(depth>12)die("job-dependency-depth");SpJob j=find_job(id);int at=job_index(j);if(job_seen[at])return;char dir[4400],out[4400],receipt[4400];job_paths(id,j,dir,out,receipt);canonical(dir);np_buf b=job_record_observed(id,j,depth,job_output_sha[at]);equal(receipt,&b);hash_bytes(b.p,b.n,job_receipt_sha[at]);job_seen[at]=1;free(b.p);}
/* Consumer output remains separate from SOURCE_CTX. Phase receipts are honest
 * source-package-phase-v1 observations, never P7 refresh receipts. */
static const char *target_ids[]={"lnx-arm64","lnx-x86_64","osx-arm64","osx-x86_64","win-arm64","win-x86_64"};
static const char *route_ids[]={"lnx/arm64","lnx/x86_64","osx/arm64","osx/x86_64","win/arm64","win/x86_64"};
static int target_index(const char *s){for(int i=0;i<6;i++)if(!strcmp(s,target_ids[i]))return i;die("unknown-target");return -1;}
static void model_output(const char *id,int phase,char output[4400]){char job[160],dir[4400],receipt[4400];snprintf(job,sizeof job,"%s-%s",phase==1?"tbl":"net",id);verify_job(job,0);job_paths(job,find_job(job),dir,output,receipt);}
static unsigned long long kernel_u64(const char *p){unsigned long long v=0;for(int i=7;i>=0;i--)v=(v<<8)|(unsigned char)p[i];return v;}
static void kernel_construction(np_buf *out,const char *kernel_context_sha){
 const char *inputs[]={"src/asmtext.c","src/internal_types.h","tools/asm-material.cx","unisacc.com","tests/assembler.cx","tests/arm-assembler.cx","tests/asm-layout.cx"};const char *outputs[]={"assembler.cx","contracts.cx"};char p[4400],dir[4400],h[65],assembler_source[65],assembler_binary[65];np_buf material={0};np_puts(&material,"unisacc-asm-material-v3\nstatus\tPREPARED\nscope\tsource-preserving-C-assembler-transition\nroot\t");np_puts(&material,root);np_puts(&material,"\n");for(int i=0;i<7;i++){path(p,root,inputs[i]);SpObservedFile *f=sp_observe(p,0);size_t n=f->n;memcpy(h,f->hash,65);np_puts(&material,i==3?"compiler-input\t":"source-input\t");np_puts(&material,inputs[i]);np_puts(&material,"\t");np_putll(&material,(long long)n);np_puts(&material,"\t");np_puts(&material,h);np_puts(&material,"\n");}path(dir,kgen,"assembler");for(int i=0;i<2;i++){path(p,dir,outputs[i]);SpObservedFile *f=sp_observe(p,0);size_t n=f->n;memcpy(h,f->hash,65);if(!i)strcpy(assembler_source,h);np_puts(&material,"material\t");np_puts(&material,outputs[i]);np_puts(&material,"\t");np_putll(&material,(long long)n);np_puts(&material,"\t");np_puts(&material,h);np_puts(&material,"\n");}path(p,dir,"material.tsv");equal(p,&material);hash_bytes(material.p,material.n,h);row(out,p,h);free(material.p);path(p,kgen,"assembler-native");digest(p,assembler_binary);np_buf native={0};np_puts(&native,"native-assembler-cache-v1\nflags\t-O2 -fno-trim-libc\n");row(&native,"context",kernel_context_sha);row(&native,"source",assembler_source);row(&native,"artifact",assembler_binary);path(p,kgen,"assembler-native.tsv");equal(p,&native);hash_bytes(native.p,native.n,h);row(out,p,h);free(native.p);
 const char *units[]={"transition","arith","buffer","memory","intern","bytes","format","stack","action","run","bridge"};const char *arches[]={"arm64","x86_64"};for(int a=0;a<2;a++)for(int e=0;e<2;e++){np_buf files={0};np_puts(&files,"unisacc-native-kernel-files-v1\n");for(int i=0;i<11;i++){char name[160];snprintf(name,sizeof name,"%s/%s.%s",arches[a],units[i],e?"o":"s");path(p,kgen,name);digest(p,h);row(&files,name,h);}char receipt[100];snprintf(receipt,sizeof receipt,"%s-%s.tsv",arches[a],e?"objects":"sources");path(p,kgen,receipt);equal(p,&files);hash_bytes(files.p,files.n,h);row(out,p,h);free(files.p);}
}
static void kernel_state_observe(np_buf *out){
 char p[4400],h[65],expected_helper[65];size_t n;path(p,kgen,"identity-helper.sha256");char *s=load(p,&n);if(n!=64)die("kernel-helper-receipt");memcpy(expected_helper,s,64);expected_helper[64]=0;free(s);path(p,kgen,"identity-helper");digest(p,h);if(strcmp(h,expected_helper))die("kernel-helper-changed");
 np_buf context={0};np_puts(&context,"unisacc-native-kernel-context-v2\n");np_puts(&context,sid);np_puts(&context,"\n");const char *inputs[]={"tools/kernel-build.cx","tools/asm-source.cx","tools/asm-material.cx","tools/kernel-link.cx","tools/cxlib/netpack.cx","tools/cxlib/elfkernel.cx","tests/assembler.cx","tests/arm-assembler.cx","tests/asm-layout.cx","unisacc.com"};for(int i=0;i<10;i++){path(p,root,inputs[i]);digest(p,h);row(&context,inputs[i],h);}row(&context,"identity-helper",expected_helper);hash_bytes(context.p,context.n,h);free(context.p);np_buf expected={0};np_puts(&expected,h);np_puts(&expected,"\n");path(p,kgen,"context.sha256");equal(p,&expected);free(expected.p);row(out,"kernel-context",h);row(out,"kernel-identity-helper",expected_helper);kernel_construction(out,h);
 const char *arches[]={"arm64","x86_64"};for(int i=0;i<2;i++){char name[80];snprintf(name,sizeof name,"%s.kernel",arches[i]);path(p,kgen,name);s=load(p,&n);if(n<48||memcmp(s,"UNIKERN1",8)||kernel_u64(s+8)!=(unsigned)i+1||kernel_u64(s+32)!=n-40||kernel_u64(s+16)>=n-40||kernel_u64(s+24)>n-48||kernel_u64(s+24)%8)die("kernel-header-ISA-extent");if(kernel_u64(s+40+(size_t)kernel_u64(s+24)))die("kernel-nonzero-service-slot");hash_bytes(s,n,h);free(s);row(out,name,h);snprintf(name,sizeof name,"%s-kernel.sha256",arches[i]);path(p,kgen,name);s=load(p,&n);if(n!=64||memcmp(s,h,64))die("kernel-digest-receipt");free(s);}
}
static void kernel_state(np_buf *out){if(!kernel_observed){kernel_state_observe(&kernel_observation);kernel_observed=1;}np_put(out,kernel_observation.p,kernel_observation.n);}
static np_buf pack_context(void){np_buf b={0};np_puts(&b,"source-package-pack-context-v1\n");row(&b,"status","PREPARED_CONTEXT_ONLY");row(&b,"environment-policy",environment_policy);row(&b,"root",root);row(&b,"source-context",ctx);row(&b,"source-context-sha",context_sha);row(&b,"source",sid);row(&b,"foundation",basis_pin);row(&b,"consumer",consumer_sha);digest_identity(&b);char module[4400],module_sha[65];path(module,root,"tools/cxlib/kernelcontext.cx");digest(module,module_sha);row(&b,"kernelcontext-module",module_sha);row(&b,"pack-context",pc);row(&b,"kernel-generation",kgen);kernel_state(&b);row(&b,"trust","same-source-native-C-tools;bootstrap-and-hostCC-systemdeps-zlib-declared;unsigned-consistency-not-historical-execution");return b;}
static void pc_file(char p[4400],const char *name){path(p,pc,name);}
static void verify_pc(void){char p[4400],now[65];canonical(pc);pc_file(p,"context.tsv");size_t n;char *s=load(p,&n);if(!n||memchr(s,0,n)||memchr(s,'\r',n)||s[n-1]!='\n')die("pack-context-wire");extract_path(s,"kernel-generation",kgen,sizeof kgen);free(s);digest(consumer,now);if(strcmp(now,consumer_sha))die("consumer-changed");np_buf b=pack_context();equal(p,&b);free(b.p);const char *arches[]={"arm64","x86_64"};for(int i=0;i<2;i++){char original[4400],copy[4400],name[100],a[65],z[65];snprintf(name,sizeof name,"%s.kernel",arches[i]);path(original,kgen,name);snprintf(name,sizeof name,"kernels/%s",arches[i]);pc_file(copy,name);digest(original,a);digest(copy,z);if(strcmp(a,z))die("private-kernel-copy-changed");}}
static void phase_paths(const char *phase,char dir[4400],char receipt[4400]){char name[200];snprintf(name,sizeof name,"phases/%s",phase);pc_file(dir,name);path(receipt,dir,"record.tsv");}
static void phase_inputs(np_buf *b,const char *phase){clean_environment();row(b,"phase",phase);row(b,"environment-policy",environment_policy);row(b,"source-context",context_sha);row(b,"source",sid);row(b,"consumer",consumer_sha);np_buf p=pack_context();char h[65];hash_bytes(p.p,p.n,h);free(p.p);row(b,"pack-context",h);}
/* Receipts bind complete dependency bytes, not just existence. The original
 * source-job canonical verifier traverses their tool/gen/tbl/net ancestors. */
static void model_dep(np_buf *b,const char *id,int phase){char out[4400],job[160];snprintf(job,sizeof job,"%s-%s",phase==1?"tbl":"net",id);dependency(b,job,0);model_output(id,phase,out);}
static void verified_model_copy(const char *id,np_buf *w){char phase[160],dir[4400],receipt[4400],name[200],src[4400],dest[4400];snprintf(phase,sizeof phase,"model-%s",id);phase_paths(phase,dir,receipt);canonical(dir);np_buf b={0};phase_inputs(&b,phase);model_dep(&b,id,1);model_dep(&b,id,2);np_buf r={0};np_puts(&r,"source-package-phase-v1\n");np_put(&r,b.p,b.n);free(b.p);for(int i=0;i<2;i++){model_output(id,i+1,src);snprintf(name,sizeof name,"models/%s.%s",id,i?"net":"tbl");pc_file(dest,name);char a[65],z[65];digest(src,a);digest(dest,z);if(strcmp(a,z))die("private-model-pair-changed");row(&r,dest,z);}equal(receipt,&r);if(w){char h[65];hash_bytes(r.p,r.n,h);row(w,receipt,h);for(int i=0;i<2;i++){snprintf(name,sizeof name,"models/%s.%s",id,i?"net":"tbl");pc_file(dest,name);digest(dest,h);row(w,dest,h);}}free(r.p);}
static np_buf route_bytes(int t,np_buf *deps){np_buf out={0};const char *stages[]={"e2","e1","e3","e4","prune","lower","elf"};const char *in[]={"src.c","pp.text","tokens.typed","tape.text","tape.text","tape.text","target.text"};const char *formats[]={"pp.text","tokens.typed","tape.text","tape.text","tape.text","target.text","image.bytes"};char p[4400],h[65];path(p,root,"exec/pipeline/image-stages.tsv");digest(p,h);row(deps,"image-stage-source",h);size_t n;char *actual=load(p,&n);np_buf expected={0};np_puts(&expected,"# stage\tinput format\toutput format\tmodel file\n");for(int i=0;i<7;i++){np_puts(&expected,stages[i]);np_puts(&expected,"\t");np_puts(&expected,in[i]);np_puts(&expected,"\t");np_puts(&expected,formats[i]);np_puts(&expected,"\t");np_puts(&expected,stages[i]);np_puts(&expected,".net\n");}if(n!=expected.n||memcmp(actual,expected.p,n))die("image-stage-declaration-changed");free(actual);free(expected.p);for(int i=0;i<7;i++){char id[160],net[4400],name[200];snprintf(id,sizeof id,"%s-%s",i<5?"shared":target_ids[t],stages[i]);verified_model_copy(id,deps);snprintf(name,sizeof name,"models/%s.net",id);pc_file(net,name);np_puts(&out,route_ids[t]);np_puts(&out,"\t");np_puts(&out,stages[i]);np_puts(&out,"\t");np_puts(&out,in[i]);np_puts(&out,"\t");np_puts(&out,formats[i]);np_puts(&out,"\t");np_puts(&out,net);np_puts(&out,"\n");}return out;}
static void verified_route(int t,np_buf *w){char phase[100],dir[4400],receipt[4400],name[100],out[4400];snprintf(phase,sizeof phase,"route-%s",target_ids[t]);phase_paths(phase,dir,receipt);canonical(dir);np_buf deps={0};phase_inputs(&deps,phase);np_buf bytes=route_bytes(t,&deps);snprintf(name,sizeof name,"routes/%s.tsv",target_ids[t]);pc_file(out,name);equal(out,&bytes);np_buf r={0};np_puts(&r,"source-package-phase-v1\n");np_put(&r,deps.p,deps.n);char h[65];hash_bytes(bytes.p,bytes.n,h);row(&r,out,h);equal(receipt,&r);if(w){row(w,out,h);hash_bytes(r.p,r.n,h);row(w,receipt,h);}free(deps.p);free(bytes.p);free(r.p);}
typedef struct {char *line;} SpTreeEntry;static SpTreeEntry tree_entries[8192];static int tree_count;
static int tree_compare(const void *a,const void *b){return strcmp(((const SpTreeEntry *)a)->line,((const SpTreeEntry *)b)->line);}
static void tree_walk(const char *base,const char *relative,const char *label,int depth){if(depth>32||tree_count==8192)die("inventory-bound");char p[4400],key[4400],h[65],line[5000];if(*relative){path(p,base,relative);path(key,label,relative);}else{strcpy(p,base);strcpy(key,label);}struct stat st;errno=0;if(lstat(sp_physical(p),&st))die(errno==ENOENT?"inventory-missing":"inventory-stat");if(S_ISDIR(st.st_mode))strcpy(h,"-");else if(S_ISREG(st.st_mode))digest(p,h);else die("inventory-special-or-symlink");int n=snprintf(line,sizeof line,"%s\t%s\t%o\t%s\n",S_ISDIR(st.st_mode)?"DIR":"FILE",key,(unsigned)(st.st_mode&07777),h);if(n<0||(size_t)n>=sizeof line)die("inventory-line-bound");tree_entries[tree_count++].line=strdup(line);if(!tree_entries[tree_count-1].line)die("allocation");if(!S_ISDIR(st.st_mode))return;DIR *d=opendir(sp_physical(p));if(!d)die("inventory-opendir");for(;;){errno=0;struct dirent *e=readdir(d);if(!e){int saved=errno,closed=closedir(d);if(saved||closed)die("inventory-readdir-or-close");break;}if(!strcmp(e->d_name,".")||!strcmp(e->d_name,".."))continue;clean(e->d_name);char next[4400];if(*relative)path(next,relative,e->d_name);else{if(strlen(e->d_name)>=sizeof next)die("inventory-name-bound");strcpy(next,e->d_name);}tree_walk(base,next,label,depth+1);}}
static void tree_append(np_buf *b,const char *base,const char *label){canonical(base);tree_count=0;tree_walk(base,"",label,0);qsort(tree_entries,(size_t)tree_count,sizeof *tree_entries,tree_compare);for(int i=0;i<tree_count;i++){np_puts(b,tree_entries[i].line);free(tree_entries[i].line);tree_entries[i].line=0;}tree_count=0;}
static void all_jobs(np_buf *w){for(int i=0;i<5;i++){char name[80];snprintf(name,sizeof name,"tool-%s",tools[i]);dependency(w,name,0);}const char *phases[]={"gen","tbl","net"};for(int m=0;m<34;m++)for(int p=0;p<3;p++){char name[160];snprintf(name,sizeof name,"%s-%s",phases[p],recipes[m].id);dependency(w,name,0);}for(int i=0;i<107;i++)if(!job_seen[i])die("full-107-job-DAG-incomplete");}
static void all_models_routes(np_buf *w){for(int i=0;i<34;i++)verified_model_copy(recipes[i].id,w);for(int i=0;i<6;i++)verified_route(i,w);char p[4400];pc_file(p,"models");tree_append(w,p,"PRIVATE_MODELS");/* Exactly34 paired model files, no hidden extra model/dir. */tree_count=0;tree_walk(p,"","CHECK_MODELS",0);int count=tree_count;for(int i=0;i<tree_count;i++){free(tree_entries[i].line);tree_entries[i].line=0;}tree_count=0;if(count!=69)die("private-model-directory-not-exact-34-pairs");pc_file(p,"routes");tree_append(w,p,"PRIVATE_ROUTES");tree_count=0;tree_walk(p,"","CHECK_ROUTES",0);count=tree_count;for(int i=0;i<tree_count;i++){free(tree_entries[i].line);tree_entries[i].line=0;}tree_count=0;if(count!=7)die("private-route-directory-not-exact-six-files");pc_file(p,"kernels");tree_append(w,p,"PRIVATE_KERNELS");tree_count=0;tree_walk(p,"","CHECK_KERNELS",0);count=tree_count;for(int i=0;i<tree_count;i++){free(tree_entries[i].line);tree_entries[i].line=0;}tree_count=0;if(count!=3)die("private-kernel-directory-not-exact-two-files");}
typedef struct {int n;char text[48][4400];char *v[49];} SpArgs;
static void arg(SpArgs *a,const char *s){clean(s);if(a->n==48||strlen(s)>=4400)die("native-argv-bound");strcpy(a->text[a->n],s);a->v[a->n]=a->text[a->n];a->n++;a->v[a->n]=0;}
static SpArgs *native_args(int packing){SpArgs *a=calloc(1,sizeof *a);if(!a)die("allocation");char tool_dir[4400],exe[4400],receipt[4400],p[4400];const char *id=packing?"tool-pack":"tool-compilerpack";job_paths(id,find_job(id),tool_dir,exe,receipt);arg(a,bound);arg(a,"40");arg(a,exe);if(!packing){pc_file(p,"declaration");arg(a,p);arg(a,"--o1");pc_file(p,"models/shared-o1.net");arg(a,p);arg(a,"--e2");pc_file(p,"models/shared-e2.net");arg(a,p);arg(a,"--nativeabi");pc_file(p,"models/shared-nativeabi.net");arg(a,p);arg(a,"--models");pc_file(p,"models");arg(a,p);arg(a,"--kernels");pc_file(p,"kernels");arg(a,p);arg(a,"--audit-dir");pc_file(p,"audit");arg(a,p);for(int i=0;i<6;i++){char name[100];snprintf(name,sizeof name,"routes/%s.tsv",target_ids[i]);pc_file(p,name);arg(a,p);}}
 else{arg(a,"--compressed");arg(a,"-o");pc_file(p,"compiler.pkg");arg(a,p);arg(a,"--mount");arg(a,"006864722f");path(p,root,"include");arg(a,p);arg(a,"--mount");arg(a,"006b65726e656c2f");pc_file(p,"kernels");arg(a,p);arg(a,"--mount");arg(a,"00707265646566696e65732f");pc_file(p,"declaration/predefines");arg(a,p);pc_file(p,"declaration/routes.tsv");arg(a,p);}return a;}
