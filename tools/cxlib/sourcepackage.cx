 char p[4400],a[65],b[65];path(p,ctx,"context.tsv");size_t n;char *s=load(p,&n);if(!n||s[n-1]!='\n'||memchr(s,0,n)||memchr(s,'\r',n))die("source-context-wire");extract_path(s,"bootstrap",bootstrap,sizeof bootstrap);strcpy(epoch_product,bootstrap);int z=snprintf(epoch_metadata,sizeof epoch_metadata,"%s.build.json",epoch_product);if(z<0||(size_t)z>=sizeof epoch_metadata)die("epoch-record-path");sp_field(s,"bootstrap-sha",a,sizeof a);sp_field(s,"root-product-sha",b,sizeof b);digest(epoch_product,bootstrap_sha);if(!sp_hex64(a)||!sp_hex64(b)||strcmp(a,b)||strcmp(a,bootstrap_sha))die("package-epoch-provider-artifact-required");sp_field(s,"bootstrap-build-record-sha",a,sizeof a);sp_field(s,"root-build-record-sha",b,sizeof b);char actual[65];digest(epoch_metadata,actual);if(!sp_hex64(a)||!sp_hex64(b)||strcmp(a,b)||strcmp(a,actual))die("package-epoch-provider-original-record-required");free(s);epoch_ready=1;check_context();if(!job_mode)verify_pc();}
static int sp_file_compare(const void *a,const void *b){return strcmp((*(SpObservedFile *const *)a)->physical,(*(SpObservedFile *const *)b)->physical);}
static void sp_finish_child(sp_result *r){strcpy(r->source,sid);strcpy(r->producer,consumer_sha);strcpy(r->foundation,self_sha);strcpy(r->epoch_path,epoch_product);digest(epoch_product,r->epoch_artifact);digest(epoch_metadata,r->epoch_record);char module[4400];path(module,root,"tools/cxlib/sourcepackage.cx");digest(module,r->verifier);if(sp_origin_mode){strcpy(sp_origin_state.origin_spec,r->verifier);if(strcmp(r->verifier,sp_origin_spec_pin))die("origin-specification-module-identity");strcpy(r->verifier,sp_origin_state.executing_verifier);}path(module,root,"tools/cxlib/kernelsha.cx");digest(module,r->digest_module);if(strcmp(r->digest_module,digest_module_pin))die("kernel-sha256-module-identity");SpObservedFile **order=malloc((size_t)sp_file_count*sizeof *order);if(!order)die("allocation");for(int i=0;i<sp_file_count;i++)order[i]=&sp_files[i];qsort(order,(size_t)sp_file_count,sizeof *order,sp_file_compare);np_buf witness={0};np_puts(&witness,"source-package-endpoint-view-v1\n");row(&witness,"source",sid);row(&witness,"logical-root-artifact",logical_product);row(&witness,"physical-epoch-artifact",epoch_product);row(&witness,"logical-root-record",logical_metadata);row(&witness,"physical-epoch-record",epoch_metadata);row(&witness,"subject",r->artifact);row(&witness,"manifest",r->manifest);row(&witness,"receipt",r->receipt);for(int i=0;i<sp_file_count;i++){SpObservedFile *f=order[i];row(&witness,f->physical,f->hash);char number[80];snprintf(number,sizeof number,"%lu:%o",(unsigned long)f->n,(unsigned)(f->mode&07777));row(&witness,"bytes:mode",number);}hash_bytes(witness.p,witness.n,r->witness);free(witness.p);free(order);r->physical_reads=sp_file_count;}
static int sp_map_compare(const void *a,const void *b){return strcmp(((const SpOriginMap *)a)->logical,((const SpOriginMap *)b)->logical);}
static void sp_mapping_witness(void){qsort(sp_origin_maps,(size_t)sp_origin_map_count,sizeof *sp_origin_maps,sp_map_compare);/* Preserve index/vector agreement after the pre-existing final sort. */memset(sp_map_index,0,sizeof sp_map_index);for(int i=0;i<sp_origin_map_count;i++){int slot=sp_map_slot(sp_origin_maps[i].logical);if(sp_map_index[slot])die("origin-map-index-duplicate");sp_map_index[slot]=i+1;}np_buf b={0};np_puts(&b,"sourcepackage-origin-mapping-v1\n");row(&b,"logical-root",sp_origin_state.logical_root);row(&b,"snapshot-root",sp_origin_state.snapshot_root);for(int i=0;i<sp_origin_map_count;i++){SpOriginMap *m=&sp_origin_maps[i];row(&b,"logical",m->logical);row(&b,"physical",m->physical);int file_slot=sp_file_slot(m->physical),file_id=sp_file_index[file_slot];SpObservedFile *f=file_id?&sp_files[file_id-1]:0;char numbers[100];if(f){row(&b,"sha256",f->hash);snprintf(numbers,sizeof numbers,"%lu:%o",(unsigned long)f->n,(unsigned)(f->mode&07777));row(&b,"bytes:mode",numbers);}else{struct stat st;errno=0;if(lstat(m->physical,&st)){if(errno!=ENOENT)die("origin-unobserved-mapping-stat");row(&b,"sha256","ABSENT");row(&b,"bytes:mode","0:0");}else{if(!S_ISDIR(st.st_mode))die("origin-unobserved-mapping-leaf");row(&b,"sha256","DIRECTORY");snprintf(numbers,sizeof numbers,"0:%o",(unsigned)(st.st_mode&07777));row(&b,"bytes:mode",numbers);}}}hash_bytes(b.p,b.n,sp_origin_state.mapping_witness);free(b.p);}
static void sp_origin_report_prefix(np_buf *b){np_puts(b,"source-package-origin-snapshot-v1\n");row(b,"logical-root",sp_origin_state.logical_root);row(b,"snapshot-root",sp_origin_state.snapshot_root);row(b,"logical-package",sp_origin_state.logical_package);row(b,"physical-package",sp_origin_state.physical_package);row(b,"current-verifier-root",sp_origin_state.current_verifier_root);row(b,"execution-profile-path",sp_origin_state.execution_profile_path);row(b,"executing-elf-path",sp_origin_state.executing_elf_path);row(b,"origin-spec",sp_origin_state.origin_spec);row(b,"executing-verifier",sp_origin_state.executing_verifier);row(b,"executing-elf",sp_origin_state.executing_elf);row(b,"execution-profile",sp_origin_state.execution_profile);row(b,"execution-closure",sp_origin_state.execution_closure);row(b,"mapping-witness",sp_origin_state.mapping_witness);char n[40];snprintf(n,sizeof n,"%d",sp_origin_state.execution_reads);row(b,"execution-reads",n);}

static int sp_recorded_binding(const sp_result *r,const char *current,char out[65]){char text[2048];int n=snprintf(text,sizeof text,"source-package-recorded-jobs-binding-v1\ncurrent-source\t%s\nrecorded-source\t%s\nscope\t%s\nmaterial-witness\t%s\nunion-artifact\t%s\nunion-receipt\t%s\ncontext\t%s\nverifier\t%s\n",current,r->source,sp_recorded_scope,r->witness,r->artifact,r->receipt,r->manifest,r->verifier);if(n<0||(size_t)n>=sizeof text){out[0]=0;return -1;}cx_sha256_hex(text,(size_t)n,out);return 0;}
static void sp_write_report(const sp_result *r,int job_set_mode){np_buf b={0};if(job_set_mode==3){char binding[65];if(sp_recorded_binding(r,sp_recorded_current,binding))die("recorded-jobs-binding-bound");np_puts(&b,"source-package-recorded-jobs-snapshot-v1\n");row(&b,"current-source",sp_recorded_current);row(&b,"recorded-source",r->source);row(&b,"scope",sp_recorded_scope);row(&b,"binding",binding);}if(sp_origin_mode)sp_origin_report_prefix(&b);np_puts(&b,job_set_mode?"source-package-jobs-snapshot-v1\n":"source-package-snapshot-v1\n");row(&b,"source",r->source);row(&b,"artifact",r->artifact);row(&b,"manifest",r->manifest);row(&b,"receipt",r->receipt);row(&b,"witness",r->witness);row(&b,"epoch-artifact",r->epoch_artifact);row(&b,"epoch-record",r->epoch_record);row(&b,"epoch-path",r->epoch_path);row(&b,"producer",r->producer);row(&b,"foundation",r->foundation);row(&b,"verifier",r->verifier);row(&b,"digest-provider",digest_provider);row(&b,"kernelsha-module",r->digest_module);char n[40];snprintf(n,sizeof n,"%d",r->jobs);row(&b,"jobs",n);snprintf(n,sizeof n,"%d",r->models);row(&b,"models",n);snprintf(n,sizeof n,"%d",r->physical_reads);row(&b,"physical-reads",n);size_t at=0;while(at<b.n){ssize_t z=write(1,b.p+at,b.n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("snapshot-report-write");at+=(size_t)z;}free(b.p);}
/* Canonical union identities use the fixed job-index order, not caller order.
 * verify_job remains the original complete argv/status/log/output/ancestor
 * algorithm. The fresh child's seen/read maps only coalesce shared inputs. */
static void sp_job_union(const char *const *subjects,int n,sp_result *result){
 for(int i=0;i<n;i++)verify_job(subjects[i],0);
 np_buf outputs={0},receipts={0};np_puts(&outputs,"source-package-job-union-outputs-v1\n");np_puts(&receipts,"source-package-job-union-receipts-v1\n");row(&outputs,"context",context_sha);row(&receipts,"context",context_sha);row(&outputs,"source",sid);row(&receipts,"source",sid);
 const char *phases[]={"gen","tbl","net"};for(int i=0;i<107;i++)if(job_seen[i]){char id[160];if(i<5)snprintf(id,sizeof id,"tool-%s",tools[i]);else{int m=(i-5)/3,p=(i-5)%3;snprintf(id,sizeof id,"%s-%s",phases[p],recipes[m].id);if(p==2)result->models++;}row(&outputs,id,job_output_sha[i]);row(&receipts,id,job_receipt_sha[i]);result->jobs++;}
 if(!result->jobs)die("empty-verified-job-union");hash_bytes(outputs.p,outputs.n,result->artifact);hash_bytes(receipts.p,receipts.n,result->receipt);strcpy(result->manifest,context_sha);free(outputs.p);free(receipts.p);
}
static void sp_child(const char *r,const char *material,const char *subject,const char *fresh,int job_mode,const SpOriginRequest *origin,const char *const *subjects,int nsubjects){sp_indices_init();if(origin)sp_origin_init(origin);sp_setup_child(r,material,fresh,job_mode);sp_result result;memset(&result,0,sizeof result);if(job_mode==2||job_mode==3){sp_job_union(subjects,nsubjects,&result);}else if(job_mode){verify_job(subject,0);SpJob j=find_job(subject);int at=job_index(j);strcpy(result.artifact,job_output_sha[at]);strcpy(result.receipt,job_receipt_sha[at]);strcpy(result.manifest,context_sha);for(int i=0;i<107;i++)if(job_seen[i])result.jobs++;result.models=j.tool<0?1:0;}else{np_buf inputs=complete_inputs();np_buf record=package_record(&inputs);char p[4400];pc_file(p,"model-inputs.tsv");equal(p,&inputs);hash_bytes(inputs.p,inputs.n,result.manifest);pc_file(p,"package.tsv");equal(p,&record);hash_bytes(record.p,record.n,result.receipt);pc_file(p,"compiler.pkg");digest(p,result.artifact);free(inputs.p);free(record.p);result.jobs=107;result.models=34;}sp_finish_child(&result);if(sp_origin_mode){sp_mapping_witness();sp_execution_check(1);sp_origin_state.material=result;}sp_write_report(&result,job_mode==3?3:job_mode==2);_exit(0);}
static long long sp_clock_ns(void){struct timespec t={0};long rc=__syscall6(228,1,(long)&t,0,0,0);if(_unisa_ret(rc)||t.tv_sec<0||t.tv_nsec<0||t.tv_nsec>=1000000000L||(unsigned long long)t.tv_sec>(unsigned long long)(LLONG_MAX-t.tv_nsec)/1000000000ULL)return -1;return (long long)t.tv_sec*1000000000LL+t.tv_nsec;}
static int sp_parse_row(char **at,const char *key,char *out,size_t cap){char *line=*at,*end=strchr(line,'\n');size_t k=strlen(key);if(!end||(size_t)(end-line)<=k+1||memcmp(line,key,k)||line[k]!='\t'||memchr(line+k+1,'\t',(size_t)(end-line-k-1)))return -1;size_t n=(size_t)(end-line-k-1);if(n>=cap)return -1;memcpy(out,line+k+1,n);out[n]=0;*at=end+1;return 0;}
static int sp_small_uint(const char *s,int max){if(!*s)return -1;int n=0;for(;*s;s++){if(*s<'0'||*s>'9'||n>(max-(*s-'0'))/10)return -1;n=n*10+*s-'0';}return n;}
static int sp_parse_report(np_buf *b,sp_result *r,int job_mode,const char *fresh){const char *schema=job_mode==2?"source-package-jobs-snapshot-v1\n":"source-package-snapshot-v1\n";size_t n=strlen(schema);if(b->n<n||memcmp(b->p,schema,n)||memchr(b->p,0,b->n)||memchr(b->p,'\r',b->n)||b->p[b->n-1]!='\n')return -1;char *at=b->p+n;const char *keys[]={"source","artifact","manifest","receipt","witness","epoch-artifact","epoch-record"};char *values[]={r->source,r->artifact,r->manifest,r->receipt,r->witness,r->epoch_artifact,r->epoch_record};for(int i=0;i<7;i++)if(sp_parse_row(&at,keys[i],values[i],65)||!sp_hex64(values[i]))return -1;if(sp_parse_row(&at,"epoch-path",r->epoch_path,sizeof r->epoch_path)||r->epoch_path[0]!='/'||strpbrk(r->epoch_path,"\r\n\t"))return -1;const char *rest[]={"producer","foundation","verifier"};char *rv[]={r->producer,r->foundation,r->verifier};for(int i=0;i<3;i++)if(sp_parse_row(&at,rest[i],rv[i],65)||!sp_hex64(rv[i]))return -1;char provider[256];if(sp_parse_row(&at,"digest-provider",provider,sizeof provider)||strcmp(provider,digest_provider)||sp_parse_row(&at,"kernelsha-module",r->digest_module,65)||strcmp(r->digest_module,digest_module_pin))return -1;char number[40];if(sp_parse_row(&at,"jobs",number,sizeof number)||(r->jobs=sp_small_uint(number,107))<1)return -1;if(sp_parse_row(&at,"models",number,sizeof number)||(r->models=sp_small_uint(number,34))<0)return -1;if(sp_parse_row(&at,"physical-reads",number,sizeof number)||(r->physical_reads=sp_small_uint(number,4096))<1||*at)return -1;if(strcmp(r->source,fresh)||strcmp(r->producer,producer_pin)||strcmp(r->foundation,basis_pin)||(!job_mode&&(r->jobs!=107||r->models!=34))||(job_mode==1&&r->models>1)||(job_mode==2&&r->models>0&&r->jobs<3+3*r->models))return -1;return 0;}
static int sp_parse_recorded_report(np_buf *b,sp_result *r,const char *recorded){const char *schema="source-package-recorded-jobs-snapshot-v1\n";size_t n=strlen(schema);if(b->n<n||memcmp(b->p,schema,n)||memchr(b->p,0,b->n)||memchr(b->p,'\r',b->n)||b->p[b->n-1]!='\n')return -1;char *at=b->p+n,current[65],source[65],scope[180],binding[65],expected[65];if(sp_parse_row(&at,"current-source",current,sizeof current)||!sp_hex64(current)||strcmp(current,sp_recorded_current)||sp_parse_row(&at,"recorded-source",source,sizeof source)||!sp_hex64(source)||strcmp(source,recorded)||sp_parse_row(&at,"scope",scope,sizeof scope)||strcmp(scope,sp_recorded_scope)||sp_parse_row(&at,"binding",binding,sizeof binding)||!sp_hex64(binding))return -1;np_buf material={0};material.p=at;material.n=b->n-(size_t)(at-b->p);if(sp_parse_report(&material,r,2,recorded))return -1;if(sp_recorded_binding(r,current,expected))return -1;return strcmp(binding,expected)?-1:0;}
static int sp_parse_origin_report(np_buf *b,sp_origin_result *r,const SpOriginRequest *o,const char *fresh){const char *schema="source-package-origin-snapshot-v1\n";size_t n=strlen(schema);if(b->n<n||memcmp(b->p,schema,n)||memchr(b->p,0,b->n)||memchr(b->p,'\r',b->n)||b->p[b->n-1]!='\n')return -1;char *at=b->p+n;const char *keys[]={"logical-root","snapshot-root","logical-package","physical-package","current-verifier-root","execution-profile-path","executing-elf-path"};char *values[]={r->logical_root,r->snapshot_root,r->logical_package,r->physical_package,r->current_verifier_root,r->execution_profile_path,r->executing_elf_path};for(int i=0;i<7;i++)if(sp_parse_row(&at,keys[i],values[i],4096)||values[i][0]!='/')return -1;if(strcmp(r->logical_root,o->logical_root)||strcmp(r->snapshot_root,o->snapshot_root)||strcmp(r->logical_package,o->logical_package)||strcmp(r->current_verifier_root,o->current_root)||strcmp(r->execution_profile_path,o->profile)||!sp_within(o->logical_package,o->logical_root))return -1;char mapped[4400];int z=snprintf(mapped,sizeof mapped,"%s%s",o->snapshot_root,o->logical_package+strlen(o->logical_root));if(z<0||(size_t)z>=sizeof mapped||strcmp(mapped,r->physical_package))return -1;const char *hashkeys[]={"origin-spec","executing-verifier","executing-elf","execution-profile","execution-closure","mapping-witness"};char *hashes[]={r->origin_spec,r->executing_verifier,r->executing_elf,r->execution_profile,r->execution_closure,r->mapping_witness};for(int i=0;i<6;i++)if(sp_parse_row(&at,hashkeys[i],hashes[i],65)||!sp_hex64(hashes[i]))return -1;if(strcmp(r->origin_spec,sp_origin_spec_pin))return -1;char number[40];if(sp_parse_row(&at,"execution-reads",number,sizeof number)||(r->execution_reads=sp_small_uint(number,100000))<1)return -1;np_buf material={0};material.p=at;material.n=b->n-(size_t)(at-b->p);if(sp_parse_report(&material,&r->material,0,fresh)||strcmp(r->material.verifier,r->executing_verifier))return -1;return 0;}
static int sp_snapshot(const char *root_arg,const char *material,const char *subject,const char *fresh,int job_mode,int seconds,sp_result *out,char *why,size_t cap,const SpOriginRequest *origin,sp_origin_result *origin_out,const char *const *subjects,int nsubjects){if(out)memset(out,0,sizeof *out);if(origin_out)memset(origin_out,0,sizeof *origin_out);if(why&&cap)why[0]=0;if(!out||!why||!cap||!root_arg||!material||!fresh||!sp_hex64(fresh)||seconds<1||seconds>55||(job_mode==1&&(!subject||!*subject))||((job_mode==2||job_mode==3)&&!sp_job_list_valid(subjects,nsubjects))||(job_mode==3&&!sp_hex64(sp_recorded_current))||(origin&&(!origin_out||job_mode||!origin->logical_root||!origin->snapshot_root||!origin->logical_package||!origin->current_root||!origin->profile))){if(why&&cap)snprintf(why,cap,"source-package-snapshot-arguments");return -1;}int po[2],pe[2];if(pipe(po)){snprintf(why,cap,"source-package-snapshot-pipe");return -1;}if(pipe(pe)){close(po[0]);close(po[1]);snprintf(why,cap,"source-package-snapshot-pipe");return -1;}long long begin=sp_clock_ns();if(begin<0||begin>LLONG_MAX-(long long)seconds*1000000000LL){for(int i=0;i<2;i++){close(po[i]);close(pe[i]);}snprintf(why,cap,"source-package-snapshot-clock");return -1;}pid_t pid=fork();if(pid<0){for(int i=0;i<2;i++){close(po[i]);close(pe[i]);}snprintf(why,cap,"source-package-snapshot-fork");return -1;}if(!pid){close(po[0]);close(pe[0]);if(dup2(po[1],1)<0||dup2(pe[1],2)<0)_exit(2);close(po[1]);close(pe[1]);sp_child(root_arg,material,subject,fresh,job_mode,origin,subjects,nsubjects);_exit(2);}close(po[1]);close(pe[1]);int open_o=1,open_e=1,reaped=0,status=0,failed=0;if(fcntl(po[0],F_SETFL,O_NONBLOCK)<0||fcntl(pe[0],F_SETFL,O_NONBLOCK)<0)failed=1;np_buf stdout_bytes={0},stderr_bytes={0};char buffer[4096];long long until=begin+(long long)seconds*1000000000LL;
 while(!failed&&(open_o||open_e||!reaped)){int fds[]={po[0],pe[0]};int *opens[]={&open_o,&open_e};np_buf *buffers[]={&stdout_bytes,&stderr_bytes};for(int i=0;i<2;i++)if(*opens[i]){ssize_t n=read(fds[i],buffer,sizeof buffer);if(n>0){if(buffers[i]->n+(size_t)n>(origin&&i==0?65536:16384)){failed=1;break;}np_put(buffers[i],buffer,(size_t)n);}else if(!n){close(fds[i]);*opens[i]=0;}else if(errno!=EAGAIN&&errno!=EINTR){failed=1;break;}}if(!reaped){pid_t got=waitpid(pid,&status,WNOHANG);if(got==pid)reaped=1;else if(got<0&&errno!=EINTR){failed=1;break;}}long long now=sp_clock_ns();if(now<0||now<begin||now>=until){failed=1;break;}if(open_o||open_e||!reaped)usleep(1000);}
 if(failed){kill(pid,SIGKILL);long long reap_until=sp_clock_ns()+250000000LL;while(!reaped){pid_t got=waitpid(pid,&status,WNOHANG);if(got==pid){reaped=1;break;}if(got<0&&errno!=EINTR)break;long long now=sp_clock_ns();if(now<0||now>=reap_until)break;usleep(1000);}snprintf(why,cap,"source-package-snapshot-timeout-transport-or-output-bound%s",reaped?"":"-unreaped");}if(open_o)close(po[0]);if(open_e)close(pe[0]);long long end=sp_clock_ns();sp_result result;sp_origin_result origin_result;memset(&result,0,sizeof result);memset(&origin_result,0,sizeof origin_result);int ok=!failed&&reaped&&WIFEXITED(status)&&WEXITSTATUS(status)==0&&!stderr_bytes.n&&end>=begin&&(origin?!sp_parse_origin_report(&stdout_bytes,&origin_result,origin,fresh):(job_mode==3?!sp_parse_recorded_report(&stdout_bytes,&result,fresh):!sp_parse_report(&stdout_bytes,&result,job_mode,fresh)));if(!ok&&!failed){if(stderr_bytes.n)snprintf(why,cap,"source-package-snapshot-refused: %.*s",(int)stderr_bytes.n,stderr_bytes.p);else snprintf(why,cap,"source-package-snapshot-bad-report-or-child-status");}if(ok){if(origin){origin_result.material.elapsed_ns=end-begin;*origin_out=origin_result;result=origin_result.material;}else result.elapsed_ns=end-begin;*out=result;}free(stdout_bytes.p);free(stderr_bytes.p);return ok?0:-1;}
static int sp_platform_package_snapshot(const char *root_arg,const char *packages,const char *fresh_source,int seconds,sp_result *out,char *why,size_t cap){
#if defined(__linux__) && defined(__x86_64__)
return sp_snapshot(root_arg,packages,0,fresh_source,0,seconds,out,why,cap,0,0,0,0);
#else
if(out)memset(out,0,sizeof *out);if(why&&cap)snprintf(why,cap,"NOT_RUN sourcepackage requires Linux/x86_64");return -1;
#endif
}
static int sp_platform_job_snapshot(const char *root_arg,const char *source_context,const char *job_id,const char *fresh_source,int seconds,sp_result *out,char *why,size_t cap){
#if defined(__linux__) && defined(__x86_64__)
return sp_snapshot(root_arg,source_context,job_id,fresh_source,1,seconds,out,why,cap,0,0,0,0);
#else
if(out)memset(out,0,sizeof *out);if(why&&cap)snprintf(why,cap,"NOT_RUN sourcepackage requires Linux/x86_64");return -1;
#endif
}
static int sp_platform_jobs_snapshot(const char *root_arg,const char *source_context,const char *const *job_ids,int n,const char *fresh_source,int seconds,sp_result *out,char *why,size_t cap){
#if defined(__linux__) && defined(__x86_64__)
return sp_snapshot(root_arg,source_context,0,fresh_source,2,seconds,out,why,cap,0,0,job_ids,n);
#else
if(out)memset(out,0,sizeof *out);if(why&&cap)snprintf(why,cap,"NOT_RUN sourcepackage requires Linux/x86_64");return -1;
#endif
}
int sp_verify_package_snapshot(const char *root_arg,const char *packages,const char *fresh_source,int seconds,sp_result *out,char *why,size_t cap){return sp_platform_package_snapshot(root_arg,packages,fresh_source,seconds,out,why,cap);}
int sp_verify_job_snapshot(const char *root_arg,const char *source_context,const char *job_id,const char *fresh_source,int seconds,sp_result *out,char *why,size_t cap){return sp_platform_job_snapshot(root_arg,source_context,job_id,fresh_source,seconds,out,why,cap);}
int sp_verify_jobs_snapshot(const char *root_arg,const char *source_context,const char *const *job_ids,int n,const char *fresh_source,int seconds,sp_result *out,char *why,size_t cap){return sp_platform_jobs_snapshot(root_arg,source_context,job_ids,n,fresh_source,seconds,out,why,cap);}
static int sp_platform_recorded_jobs_snapshot(const char *root_arg,const char *source_context,const char *const *job_ids,int n,const char *recorded_source,const char *fresh_current_source,int seconds,sp_recorded_jobs_result *out,char *why,size_t cap){
if(out)memset(out,0,sizeof *out);if(why&&cap)why[0]=0;memset(sp_recorded_current,0,sizeof sp_recorded_current);
if(!out||!why||!cap||!root_arg||!source_context||!recorded_source||!fresh_current_source||!sp_hex64(recorded_source)||!sp_hex64(fresh_current_source)||!sp_job_list_valid(job_ids,n)||seconds<1||seconds>55){if(why&&cap)snprintf(why,cap,"source-package-recorded-jobs-arguments");return -1;}
#if defined(__linux__) && defined(__x86_64__)
memcpy(sp_recorded_current,fresh_current_source,65);sp_result material;int rc=sp_snapshot(root_arg,source_context,0,recorded_source,3,seconds,&material,why,cap,0,0,job_ids,n);memset(sp_recorded_current,0,sizeof sp_recorded_current);if(rc)return -1;
out->material=material;memcpy(out->current_source,fresh_current_source,65);memcpy(out->recorded_source,recorded_source,65);if(sp_recorded_binding(&out->material,out->current_source,out->binding)){memset(out,0,sizeof *out);snprintf(why,cap,"source-package-recorded-jobs-binding");return -1;}return 0;
#else
snprintf(why,cap,"NOT_RUN sourcepackage recorded jobs requires Linux/x86_64");return -1;
#endif
}
int sp_verify_recorded_jobs_snapshot(const char *root_arg,const char *source_context,const char *const *job_ids,int n,const char *recorded_source,const char *fresh_current_source,int seconds,sp_recorded_jobs_result *out,char *why,size_t cap){return sp_platform_recorded_jobs_snapshot(root_arg,source_context,job_ids,n,recorded_source,fresh_current_source,seconds,out,why,cap);}
static int sp_platform_origin_snapshot(const char *logical_root,const char *snapshot_root,const char *logical_package,const char *fresh_source,const char *current_root,const char *execution_profile,int seconds,sp_origin_result *out,char *why,size_t cap){
#if defined(__linux__) && defined(__x86_64__)
SpOriginRequest request={logical_root,snapshot_root,logical_package,current_root,execution_profile};sp_result material;return sp_snapshot(logical_root,logical_package,0,fresh_source,0,seconds,&material,why,cap,&request,out,0,0);
#else
if(out)memset(out,0,sizeof *out);if(why&&cap)snprintf(why,cap,"NOT_RUN sourcepackage origin requires Linux/x86_64");return -1;
#endif
}
int sp_verify_origin_package_snapshot(const char *logical_root,const char *snapshot_root,const char *logical_package,const char *fresh_origin_source,const char *current_verifier_root,const char *execution_profile,int seconds,sp_origin_result *out,char *why,size_t cap){return sp_platform_origin_snapshot(logical_root,snapshot_root,logical_package,fresh_origin_source,current_verifier_root,execution_profile,seconds,out,why,cap);}
