#pragma unisa module corecompat
#pragma unisa use netpack
/* One pinned runtime-only source transition, not an ABI equivalence checker.
 * Keep core.c in the complete constructor inventory with its CURRENT hash.
 * The old full-file hash is pinned; the new file must reverse exactly one
 * guarded copy to those exact old bytes. No other source change is admitted.
 * Allocation, slot count, nonempty copies and action/opcode declarations stay
 * byte-identical. This establishes material eligibility, never a test PASS. */
static const char *cc_baseline="6845345a6d2a38bd97221eaf657970f755b69226e4670aab8d624711ea5d24d1";
static const char *cc_old="    memcpy(t->entries[t->n].b,b,n); t->entries[t->n].n=n;";
static const char *cc_new="    if(n)memcpy(t->entries[t->n].b,b,n); t->entries[t->n].n=n;";
/* 0 = exact old file, 1 = exact guarded file, -1 = unapproved bytes. */
int cc_kind(const char *s,size_t n){
 char h[65];cx_sha256_hex(s,n,h);if(!strcmp(h,cc_baseline))return 0;
 size_t on=strlen(cc_old),nn=strlen(cc_new),at=0;int hits=0;
 for(size_t i=0;i+nn<=n;i++)if(!memcmp(s+i,cc_new,nn)){at=i;hits++;}
 if(hits!=1||n<nn)return -1;
 np_buf b={0};np_put(&b,s,at);np_put(&b,cc_old,on);np_put(&b,s+at+nn,n-at-nn);
 cx_sha256_hex(b.p,b.n,h);free(b.p);return !strcmp(h,cc_baseline)?1:-1;
}
/* Receipt records the exception explicitly; current core hash is ALSO in
 * model-inputs.tsv. Caller supplies freshly measured helper and source hashes. */
void cc_receipt(np_buf *out,const char *current,const char *helper){
 np_puts(out,"core-source-compat\tcore-badd-empty-copy-guard-v1\t");
 np_puts(out,cc_baseline);np_puts(out,"\t");np_puts(out,current);
 np_puts(out,"\ncompat-tool\t");np_puts(out,helper);np_puts(out,"\n");
}
