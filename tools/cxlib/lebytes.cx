/* tools/cxlib/lebytes.cx -- little-endian field reads for tool-side object inspection.
 *
 *   #pragma unisa use cxlib.lebytes
 *   unsigned long lb_rd(const unsigned char *b, long off, int n);
 *
 * Reads N (1..8) bytes at B+OFF as an unsigned little-endian integer.  The caller has
 * bounds-checked OFF+N against its buffer; nothing here allocates or keeps state.
 */
#pragma unisa module lebytes

unsigned long lb_rd(const unsigned char *b, long off, int n) {
    unsigned long v = 0; int i;
    for (i = n - 1; i >= 0; i--) v = (v << 8) | b[off + i];
    return v;
}
