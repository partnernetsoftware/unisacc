/* Domain inference: explicit object contracts and checked priority rules.
 * No batch execution or qualification result is represented here. */
#pragma unisa module batchdomain
#pragma unisa use sys.fs
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
typedef struct BdomRule { char *id,*entry,*tier,*layer,*object,*domain,*sample,*basis; int priority; } BdomRule;
typedef struct BdomRules { char *text; BdomRule row[256]; int count; } BdomRules;
static int bdom_refuse(char *why,size_t cap,const char *code,const char *id){
    snprintf(why,cap,"%s id=%s; add an explicit batch-domain exception if the contract is insufficient",code,id?id:"-");return -1;
}
int bdom_kind(const char *name){
    const char *names[]={"product-qualification","repository-governance","tool-selfcheck","devsvc-selfcheck","release-matrix","external-product"};
    for(int i=0;i<6;i++)if(!strcmp(names[i],name))return i;return -1;
}
const char *bdom_name(int kind){
    const char *names[]={"product-qualification","repository-governance","tool-selfcheck","devsvc-selfcheck","release-matrix","external-product"};
    return kind>=0&&kind<6?names[kind]:0;
}
static int bdom_fields(char *p,char **v,int want){
    int n=1;v[0]=p;for(char*q=p;*q;q++){if(*q=='\r')return 0;if(*q=='\t'){*q=0;if(n==want)return 0;v[n++]=q+1;}}
    if(n!=want)return 0;for(int i=0;i<n;i++)if(!*v[i])return 0;return 1;
}
static int bdom_token(const char*s){
    if(!*s)return 0;for(;*s;s++)if(!((*s>='a'&&*s<='z')||(*s>='A'&&*s<='Z')||(*s>='0'&&*s<='9')||*s=='-'||*s=='_'||*s=='.'))return 0;return 1;
}
static int bdom_glob(const char*p,const char*s){
    const char*star=0,*at=0;while(*s){if(*p=='?'||*p==*s){p++;s++;}else if(*p=='*'){star=++p;at=s;}else if(star){p=star;s=++at;}else return 0;}while(*p=='*')p++;return !*p;
}
static unsigned char bdom_lower(unsigned char c){return c>='A'&&c<='Z'?(unsigned char)(c+32):c;}
static int bdom_contains(const char*h,const char*p,size_t n){
    size_t hn=strlen(h);if(!n)return 0;for(size_t i=0;i+n<=hn;i++){size_t j=0;for(;j<n&&bdom_lower((unsigned char)h[i+j])==bdom_lower((unsigned char)p[j]);j++);if(j==n)return 1;}return 0;
}
static int bdom_group(const char*h,const char*p,size_t n){
    size_t at=0;while(at<n){size_t e=at;while(e<n&&p[e]!='|')e++;if(bdom_contains(h,p+at,e-at))return 1;at=e+1;}return 0;
}
static int bdom_object(const char*h,const char*p){
    if(!h||!*h)return 0;if(!strcmp(p,"-"))return 1;for(;;){const char*e=strchr(p,'&');size_t n=e?(size_t)(e-p):strlen(p);if(!bdom_group(h,p,n))return 0;if(!e)break;p=e+1;}return 1;
}
static int bdom_expression(const char*p){
    if(!strcmp(p,"-"))return 1;if(!*p||*p=='&'||*p=='|')return 0;
    for(;*p;p++)if((*p=='&'||*p=='|')&&(!p[1]||p[1]=='&'||p[1]=='|'))return 0;return 1;
}
void bdom_close(BdomRules*d){mm_free(d->text);int z=mm_fill(d,sizeof *d,0,sizeof *d);(void)z;}
/* Rules are parsed in private storage; caller owns the set until bdom_close. */
int bdom_read(const char *path,BdomRules*d,char*why,size_t cap){
    int z=mm_fill(d,sizeof *d,0,sizeof *d);(void)z;size_t n=0;d->text=cx_read(path,&n);
    if(!d->text)return bdom_refuse(why,cap,"rules-read",path);
    if(!n||n>1048576||strlen(d->text)!=n||d->text[n-1]!='\n')return bdom_refuse(why,cap,"rules-size-or-newline",path);
    int header=0;for(char*p=d->text;*p;){char*e=strchr(p,'\n');if(!e)return bdom_refuse(why,cap,"rules-line",path);*e=0;
        if(*p&&*p!='#'){
            if(!header){if(strcmp(p,"id\tpriority\tentry\ttier\tlayer\tobject\tdomain\tsample\tbasis"))return bdom_refuse(why,cap,"rules-header",path);header=1;}
            else {char*v[9];if(!bdom_fields(p,v,9)||!bdom_token(v[0])||!bdom_token(v[7])||!bdom_expression(v[5]))return bdom_refuse(why,cap,"rules-shape",p);
                if(d->count==256)return bdom_refuse(why,cap,"rules-limit",v[0]);
                for(int i=0;i<d->count;i++)if(!strcmp(d->row[i].id,v[0]))return bdom_refuse(why,cap,"duplicate-rule",v[0]);
                if(bdom_kind(v[6])<0)return bdom_refuse(why,cap,"unknown-domain",v[6]);
                char*end=0;long pri=strtol(v[1],&end,10);if(*end||pri<1||pri>10000)return bdom_refuse(why,cap,"rule-priority",v[0]);
                BdomRule*r=&d->row[d->count++];r->id=v[0];r->priority=(int)pri;r->entry=v[2];r->tier=v[3];r->layer=v[4];r->object=v[5];r->domain=v[6];r->sample=v[7];r->basis=v[8];
            }
        }p=e+1;
    }return header&&d->count?0:bdom_refuse(why,cap,"empty-rules",path);
}
int bdom_matches(const BdomRule*r,const char*entry,const char*tier,const char*layer,const char*object){
    return bdom_glob(r->entry,entry)&&bdom_glob(r->tier,tier)&&bdom_glob(r->layer,layer)&&bdom_object(object,r->object);
}
/* A tie between different domains is rejected; no path-only fallback exists. */
int bdom_decide(const BdomRules*d,const char*id,const char*entry,const char*tier,const char*layer,const char*object,int*rule,char*why,size_t cap){
    int best=-1,tie=0;for(int j=0;j<d->count;j++)if(bdom_matches(&d->row[j],entry,tier,layer,object)){
        if(best<0||d->row[j].priority>d->row[best].priority){best=j;tie=0;}
        else if(d->row[j].priority==d->row[best].priority&&strcmp(d->row[j].domain,d->row[best].domain))tie=1;
    }
    if(best<0||tie)return bdom_refuse(why,cap,tie?"domain-conflict":"domain-missing-declaration",id);
    *rule=best;return bdom_kind(d->row[best].domain);
}
