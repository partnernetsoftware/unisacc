/* s9 调度层(A1,2026-11-16):只决定何时发哪一片、并发几路、授予多长、被拒后重发几次、打印什么。
 * 本文件不进冻结根的原生镜像身份(tools/s9-nightly.cx 的身份计算只绑判定层源),改它不使旧根失效。
 * 边界(由 tools/check-s9-nightly.cx 的 sched-layer-* 断言守):这里不算身份、不写收据或证据、不判通过;
 * 列待跑片与起子进程都经判定层给的回调(回调内逐次核镜像身份),完成结论仍由判定层的串行 step 下。
 * 调度写错的后果只能是片没发出去、被 driver 拒或超时被杀,不会多记一条完成。 */
#pragma unisa module s9sched
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.die

typedef struct { const char *name; int pid, fd, deadline_s; long t0; np_buf out; } ParJob;
/* 判定层交给调度层的全部入口:四个限值(判定层从限值表读出)与两个回调。 */
typedef struct {
    int hcap, extra, closes, outer;
    int (*list)(const char *run, char *buf, int cap);                               /* driver pending 的输出;非 0 即被拒 */
    int (*spawn)(ParJob *j, const char *run, const char *leaf, int deadline_s);     /* 起一个 step --slice LEAF */
    const char *sched_sha;                                                          /* 本文件内容摘要,只留痕 */
} ss_ops;

#define SS_MAX 2048
typedef struct { char leaf[80]; int alone, heavy, need, state, tries; ParJob j; } ss_row; /* state: 0 待发 1 在跑 2 DONE 已记 3 未记 4 放弃 */
static ss_row ss_rows[SS_MAX];
static int ss_n;
static char ss_buf[262144];
static void ss_free(ParJob *j) { free(j->out.p); j->out.p = 0; j->out.n = j->out.cap = 0; }
static int ss_field(const char *line, const char *key) { const char *q = strstr(line, key); return q ? atoi(q + strlen(key)) : -1; }
static int ss_has(const char *s, size_t n, const char *needle) {
    size_t z = strlen(needle), i;
    if (!s) return 0;
    for (i = 0; i + z <= n; i++) if (!strncmp(s + i, needle, z)) return 1;
    return 0;
}
/* 待跑片清单:与 aggregate 同一 pending 判定(driver pending)。行数与汇总行不符即拒。 */
static int ss_list(const ss_ops *o, const char *run) {
    int summary = -1;
    char *s, *e;
    ss_n = 0;
    if (o->list(run, ss_buf, (int)sizeof ss_buf)) return -1;
    for (s = ss_buf; *s; s = e) {
        e = strchr(s, '\n');
        if (e) *e++ = 0; else e = s + strlen(s);
        if (!strncmp(s, "S9_PENDING\tslice=", 17)) {
            ss_row *x;
            size_t z = 0;
            const char *q = s + 17;
            if (ss_n == SS_MAX) return -1;
            x = &ss_rows[ss_n];
            while (q[z] && q[z] != '\t' && z + 1 < sizeof x->leaf) { x->leaf[z] = q[z]; z++; }
            x->leaf[z] = 0;
            if (!z || q[z] != '\t') return -1;
            x->alone = ss_field(q, "\talone="); x->heavy = ss_field(q, "\theavy="); x->need = ss_field(q, "\tneed=");
            x->state = 0; x->tries = 0;
            if (x->alone < 0 || x->heavy < 0 || x->need < 1) return -1;
            ss_n++;
        } else if (!strncmp(s, "S9_PENDING_SUMMARY\tpending=", 27)) summary = atoi(s + 27);
    }
    return summary == ss_n ? ss_n : -1;
}
/* 0 仍在跑;1 已结束(*rc 为退出码,超时 124,等待出错 -1),输出在 j->out。只在子进程结束后读管道:每片输出只有几行。 */
static int ss_poll(ParJob *j, int *rc) {
    char chunk[4096];
    int ex = 0, code = 0, sig = 0, w = sy_wait_status(j->pid, 1, &ex, &code, &sig);
    if (w == 0) {
        if (sy_now_ms() - j->t0 <= (long)j->deadline_s * 1000L) return 0;
        (void)sy_kill(j->pid);
        sy_close(j->fd); j->fd = -1; j->pid = 0;
        *rc = 124;
        return 1;
    }
    if (w < 0) { sy_close(j->fd); j->fd = -1; j->pid = 0; *rc = -1; return 1; }
    for (;;) {
        long r = sy_read(j->fd, chunk, sizeof chunk);
        if (r > 0) { np_put(&j->out, chunk, (size_t)r); continue; }
        if (r == -EINTR || r == -EAGAIN) continue;
        break;
    }
    sy_close(j->fd); j->fd = -1;
    *rc = ex ? code : 128 + sig;
    return 1;
}
/* 并发步:一个进程内维持至多 PAR 个 `driver step ROOT RUN --slice LEAF` 子进程。
   冲突域:会话级共享写只有认领(写栅栏核对加 START 记录),由 driver 在 RUN/lock 下串行完成;此后每片只写自己的
   slice-K 目录与 .start/.done/.log,互不相交,所以片间可并行。写栅栏(alone 片须独占)、heavy 上限、身份与冻结核验
   仍在 driver 内逐次执行,本池只是不去发注定被拒的片;被拒(STEP_NO_PROGRESS,rc 4)的片未被认领,可重发,每片至多 3 次。
   每片授予 = need + extra(s9.slice.startup + s9.sup.shave + s9.epoch.margin,与 s9-shards-flow 同式),超过授予加 closes 即杀其进程组记 rc 124。
   总墙钟上限 WALL_MS:剩余不足一片授予时不再发片,返回 3。完成结论不在这里下:池空后仍由判定层串行 step 的 STEP_FINISHED 行作唯一出口。
   返回 0 池已空(待串行 step 确认完成);1 失败;3 墙钟用完仍有待发片;4 有片发不出去。*MS 为本次墙钟。 */
int ss_steps_par(const ss_ops *o, const char *run, int par, long wall_ms, long *ms) {
    long t0 = sy_now_ms(), t_end = t0 + wall_ms;
    int hcap = o->hcap, extra = o->extra, closes = o->closes, outer = o->outer;
    int n = ss_list(o, run), active = 0, hact = 0, wact = 0, launched = 0, done = 0, noprog = 0, unrec = 0, bad = 0, late = 0, peak = 0, i;
    if (n < 0) { fprintf(stderr, "s9-nightly: pending listing refused\n"); *ms = sy_now_ms() - t0; return 1; }
    for (;;) {
        late = 0;
        for (i = 0; i < n && !bad; i++) {
            ss_row *x = &ss_rows[i];
            char env[96];
            sy_ts_t t;
            int grant;
            if (x->state) continue;
            if (active >= par || wact) break;
            if (x->alone && active) continue;
            if (x->heavy && hcap >= 1 && hact >= hcap) continue;
            grant = x->need + extra;
            if (grant + closes > outer) { x->state = 4; noprog++; printf("S9_STEP_PAR\tslice=%s\tresult=GRANT_OVER_OUTER\tgrant=%d\n", x->leaf, grant); continue; }
            if (sy_now_ms() + (long)(grant + closes) * 1000L > t_end) { late++; continue; }
            if (sy_mono(&t) || cx_fmt(env, sizeof env, "%.9f", (double)t.sec + (double)t.nsec / 1e9 + grant) || sy_setenv("UNISACC_BOUND_DEADLINE_MONO", env, 1)) tool_die("s9-nightly", "deadline-env", 0, 2);
            if (o->spawn(&x->j, run, x->leaf, grant + closes)) { bad++; printf("S9_STEP_PAR\tslice=%s\tresult=CANNOT_START\n", x->leaf); break; }
            x->state = 1; x->tries++; active++; hact += x->heavy; wact += x->alone; launched++;
            if (active > peak) peak = active;
        }
        if (!active) break;
        (void)sy_sleep_ms(50);
        for (i = 0; i < n; i++) {
            ss_row *x = &ss_rows[i];
            char mark[200];
            const char *res;
            int rc = 0;
            if (x->state != 1 || !ss_poll(&x->j, &rc)) continue;
            active--; hact -= x->heavy; wact -= x->alone;
            if (cx_fmt(mark, sizeof mark, "S9\tSTEP_SLICE\tslice=%s\tstatus=", x->leaf)) tool_die("s9-nightly", "format-bound", 0, 2);
            {
                size_t mz = strlen(mark), on = x->j.out.n, k;
                const char *out = x->j.out.p;
                int rec = 0;
                for (k = 0; out && k + mz <= on; k++) if (!strncmp(out + k, mark, mz) && (ss_has(out + k + mz, on - k - mz < 14 ? on - k - mz : 14, "DONE_RECORDED\n") || ss_has(out + k + mz, on - k - mz < 13 ? on - k - mz : 13, "ALREADY_DONE\n"))) rec = 1;
                if (rec) { x->state = 2; done++; res = "DONE_RECORDED"; }
                else if (rc == 4 || ss_has(out, on, "S9\tSTEP_NO_PROGRESS")) {
                    if (x->tries < 3) { x->state = 0; res = "NO_PROGRESS_REQUEUED"; }
                    else { x->state = 4; noprog++; res = "NO_PROGRESS"; }
                }
                else if (rc == 0 || rc == 3) { x->state = 3; unrec++; res = "NOT_RECORDED"; }
                else { x->state = 3; bad++; res = "FAIL"; if (out && on) fwrite(out, 1, on, stderr); }
            }
            printf("S9_STEP_PAR\tslice=%s\tresult=%s\trc=%d\tms=%ld\ttry=%d\n", x->leaf, res, rc, sy_now_ms() - x->j.t0, x->tries);
            ss_free(&x->j);
        }
    }
    (void)sy_unsetenv("UNISACC_BOUND_DEADLINE_MONO");
    *ms = sy_now_ms() - t0;
    printf("S9_STEPS_PAR\tpar=%d\tpeak=%d\tpending_at_start=%d\tlaunched=%d\tdone=%d\tno_progress=%d\tnot_recorded=%d\tfailed=%d\tnot_launched=%d\twall_ms=%ld\tsched_sha=%s\n", par, peak, n, launched, done, noprog, unrec, bad, late, *ms, o->sched_sha ? o->sched_sha : "-");
    return bad ? 1 : noprog ? 4 : late ? 3 : 0;
}
