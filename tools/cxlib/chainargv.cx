#pragma unisa module chainargv
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use cxlib.netpack
#define AT_MAX 100000
struct at_tok { char s[1024]; int line, string; };
struct at_src { struct at_tok *t; int n; };
static int at_bad, at_calls, at_diagnostics, at_diagnostic_mismatch;
static const char *at_expected_diagnostic;
static void at_diag(const char *kind,int line,const char *why){fprintf(stderr,"%s\tchain-argv-check\tline=%d\t%s\n",kind,line,why);at_bad=2;at_diagnostics++;if(at_expected_diagnostic&&strcmp(at_expected_diagnostic,why))at_diagnostic_mismatch++;}
static int at_id(int c){return (c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='_';}
static struct at_src at_lex(const char *p){
 struct at_src a={0};int capacity=1024;a.t=malloc(capacity*sizeof *a.t);if(!a.t)exit(2);int line=1;
 while(*p){if(*p=='\n'){line++;p++;continue;}if(*p==' '||*p=='\t'||*p=='\r'){p++;continue;}
 if(p[0]=='/'&&p[1]=='/'){while(*p&&*p!='\n')p++;continue;}
 if(p[0]=='/'&&p[1]=='*'){p+=2;while(*p&&!(p[0]=='*'&&p[1]=='/')){if(*p++=='\n')line++;}if(!*p){at_diag("REFUSE",line,"unterminated comment");break;}p+=2;continue;}
 if(a.n==AT_MAX){at_diag("REFUSE",line,"token capacity");break;}
 if(a.n==capacity){int next=capacity*2;if(next>AT_MAX)next=AT_MAX;struct at_tok *grown=realloc(a.t,next*sizeof *a.t);if(!grown){free(a.t);exit(2);}a.t=grown;capacity=next;}
 struct at_tok *t=&a.t[a.n++];t->line=line;t->string=0;int n=0;
 if(*p=='"'||*p=='\''){int q=*p++;t->string=q=='"';while(*p&&*p!=q){if(n>=1020){at_diag("REFUSE",line,"token bound");break;}if(*p=='\\'&&p[1]){t->s[n++]=*p++;}t->s[n++]=*p++;}if(*p)p++;else at_diag("REFUSE",line,"unterminated literal");}
 else if(at_id(*p)){while(at_id(*p)){if(n>=1020){at_diag("REFUSE",line,"identifier bound");break;}t->s[n++]=*p++;}}
 else {t->s[n++]=*p++;if((t->s[0]=='+'&&*p=='+')||(t->s[0]=='&'&&*p=='&')||(t->s[0]=='!'&&*p=='=')||(t->s[0]=='='&&*p=='=')){t->s[n++]=*p++;}}
 t->s[n]=0;
 }return a;
}
static int at_eq(struct at_src *a,int i,const char *s){return i>=0&&i<a->n&&!strcmp(a->t[i].s,s);}
static int at_has(struct at_src *a,int lo,int hi,const char *pattern){
 struct at_src p=at_lex(pattern);int found=0;
 for(int i=lo;i+p.n<=hi&&i+p.n<=a->n;i++){int j=0;while(j<p.n&&at_eq(a,i+j,p.t[j].s)&&a->t[i+j].string==p.t[j].string)j++;if(j==p.n){found=1;break;}}
 free(p.t);return found;
}
static int at_tail_loop(struct at_src *a,int assignment,const char *bound){
 char pattern[256];cx_fmt(pattern,sizeof pattern,"for(i=0;i<%s;i++)",bound);
 struct at_src p=at_lex(pattern);int first=assignment-p.n,yes=first>=0;
 for(int j=0;yes&&j<p.n;j++)if(!at_eq(a,first+j,p.t[j].s))yes=0;
 free(p.t);return yes;
}
static int at_partition_flow(struct at_src *a){
 return at_has(a,0,a->n,"int slices=(total+slice-1)/slice;")&&
 at_has(a,0,a->n,"int total=wf_total(front0),slice=cf_front_slice();")&&
 at_has(a,0,a->n,"total<cf_root_count()||total>cf_wf_max()")&&
 at_has(a,0,a->n,"slices=wf_inventory(outdir,gen,slug,parts[0],want_stub)")&&
 at_has(a,0,a->n,"cx_fmt(offset,sizeof offset,\"%d\",i*cf_front_slice())")&&
 at_has(a,0,a->n,"wf_tail_count(parts[0],i*cf_front_slice(),amount,sizeof amount)")&&
 at_has(a,0,a->n,"cx_fmt(amount,sizeof amount,\"%d\",cf_front_slice())");
}
static int at_find(struct at_src *a,int lo,int hi,const char *s){for(int i=lo;i<hi&&i<a->n;i++)if(at_eq(a,i,s))return i;return -1;}
static int at_end(struct at_src *a,int i,const char *open,const char *close){int d=0;for(;i<a->n;i++){if(at_eq(a,i,open))d++;if(at_eq(a,i,close)&&!--d)return i;}return -1;}
static const char *at_role(const char *s){
 if(!strcmp(s,"rev"))return "REV";
 if(!strcmp(s,"snap")||!strcmp(s,"s"))return "ROOT";
 if(!strcmp(s,"pkg")||!strcmp(s,"srcpkg"))return "PKG";
 if(!strcmp(s,"ctor")||!strcmp(s,"gen1"))return "CTOR";
 if(!strcmp(s,"build")||!strcmp(s,"b"))return "BUILD";
 if(!strcmp(s,"ctx")||!strcmp(s,"jobs"))return "CTX";
 if(!strcmp(s,"cc"))return "CC";
 if(!strcmp(s,"prep"))return "PREP";
 if(!strcmp(s,"target")||!strcmp(s,"g_mt_target"))return "TARGET";
 if(!strcmp(s,"objs"))return "OBJECTS";
 if(!strcmp(s,"fp")||!strcmp(s,"nout")||!strcmp(s,"outdir")||!strcmp(s,"routes")||!strcmp(s,"dest"))return "OUT";
 if(!strcmp(s,"out"))return "OUT";
 if(!strcmp(s,"part")||!strcmp(s,"parts")||!strcmp(s,"p0")||!strcmp(s,"p1")||!strcmp(s,"p2"))return "PART";
 if(!strcmp(s,"phase")||!strcmp(s,"input"))return "PHASE";
 if(!strcmp(s,"first")||!strcmp(s,"offs")||!strcmp(s,"offset"))return "FIRST";
 if(!strcmp(s,"last"))return "LAST";
 if(!strcmp(s,"tailc")||!strcmp(s,"cnts")||!strcmp(s,"amount"))return "COUNT";
 if(!strcmp(s,"helper"))return "HELPER";
 if(!strcmp(s,"tmpl"))return "TEMPLATE";
 if(!strcmp(s,"stub"))return "STUB";
 if(!strcmp(s,"span_roots"))return "ROOTS";
 if(!strcmp(s,"name")||!strcmp(s,"lnx_obj")||!strcmp(s,"img")||!strcmp(s,"phs")||!strcmp(s,"keys"))return "VALUE";
 if(!strcmp(s,"wft"))return "TOOL";
 return 0;
}
static const char *at_expected(const char *s){
 if(!strcmp(s,"S")||!strcmp(s,"ROOT")||!strcmp(s,"ABS_ROOT"))return "ROOT";
 if(!strcmp(s,"B"))return "BUILD";
 if(!strcmp(s,"P4")||!strcmp(s,"SRC_PKG"))return "PKG";
 if(!strcmp(s,"GEN1"))return "CTOR";
 if(!strcmp(s,"PREPARED_DIR"))return "PREP";
 if(!strcmp(s,"NEW_PART"))return "PART";
 if(!strcmp(s,"NEW_PHASE")||!strcmp(s,"INPUT"))return "PHASE";
 if(!strcmp(s,"NEW_OUT"))return "OUT";
 return s;
}
struct at_arg { char value[1024]; int literal,line; };
static int at_expr(struct at_src *a,int lo,int hi,struct at_arg *v){
 while(lo<hi&&at_eq(a,lo,"(")){int e=at_end(a,lo,"(",")");if(e<0||e>=hi)return 0;lo=e+1;}
 if(lo>=hi)return 0;struct at_tok *t=&a->t[lo];v->line=t->line;v->literal=t->string;
 if(hi!=lo+1){if(!(hi==lo+4&&at_eq(a,lo+1,"[")&&at_eq(a,lo+3,"]")))return 0;}
 if(!t->string&&!at_role(t->s)&&strcmp(t->s,"0"))return 0;
 if(cx_fmt(v->value,sizeof v->value,"%s",t->s))return 0;return 1;
}
static int at_contract(struct at_src *c,const char *cmd,char labels[20][64],int *minimum){
 char prefix[160];cx_fmt(prefix,sizeof prefix,"%s needs ",cmd);
 for(int i=0;i<c->n;i++)if(c->t[i].string){const char *p=0;if(!strncmp(c->t[i].s,prefix,strlen(prefix)))p=c->t[i].s+strlen(prefix);
 else if(!strncmp(c->t[i].s,"usage: ",7)){const char *q=c->t[i].s+7;size_t n=strlen(cmd);if(!strncmp(q,cmd,n)&&q[n]==' ')p=q+n+1;}
 if(!p)continue;
 /* Require a real argc rejection guard in this parser before its diagnostic. */
 *minimum=0;for(int z=i-1;z>=0&&z>i-250;z--)if(at_eq(c,z,"argc")&&(at_eq(c,z+1,"<")||at_eq(c,z+1,"!="))&&c->t[z+2].s[0]>='0'&&c->t[z+2].s[0]<='9'){int m=atoi(c->t[z+2].s);if(!*minimum||m<*minimum)*minimum=m;if(at_eq(c,z+1,"<"))break;}
 /* Variable-tail parsers derive nr/n from end minus the fixed argv prefix. */
 if(!*minimum){for(int z=i-1;z>=0&&z>i-250;z--)if(at_eq(c,z,"end")&&at_eq(c,z+1,"-")&&c->t[z+2].s[0]>='0'&&c->t[z+2].s[0]<='9'){*minimum=atoi(c->t[z+2].s)+1;break;}}
 if(!*minimum)return -1;
 int n=0;while(*p&&*p!='['&&*p!=';'&&n<20){while(*p==' ')p++;if(!*p||*p=='['||*p=='-'||*p==';')break;int k=0;while(*p&&*p!=' '&&*p!=';'&&k<63)labels[n][k++]=*p++;labels[n++][k]=0;}return n;
 }return -1;
}
static int at_option(struct at_src *c,const char *s){
 for(int i=0;i<c->n;i++)if(c->t[i].string&&!strcmp(c->t[i].s,s)){
 int begin=i-10;if(begin<0)begin=0;if(at_find(c,begin,i,"argv")<0)continue;
 int e=at_find(c,i,i+100,"continue");if(e<0)continue;
 for(int j=i;j+4<e;j++)if(at_eq(c,j,"argv")&&at_eq(c,j+1,"[")&&at_eq(c,j+2,"++"))return 2;
 return 1;
 }return 0;
}
static int at_bindings(struct at_src *c,const char *cmd,char labels[20][64],int k){
 char prefix[160];cx_fmt(prefix,sizeof prefix,"%s needs ",cmd);int diagnostic=-1;
 for(int i=0;i<c->n;i++)if(c->t[i].string&&!strncmp(c->t[i].s,prefix,strlen(prefix))){diagnostic=i;break;}
 if(diagnostic<0){
 const char *function="main";
 for(int i=0;i<c->n;i++)if(c->t[i].string&&!strcmp(c->t[i].s,cmd)){
 int lo=i-10;if(lo<0)lo=0;if(at_find(c,lo,i,"argv")<0)continue;
 int ret=at_find(c,i,i+40,"return");if(ret>=0){function=c->t[ret+1].s;break;}
 }
 int body=-1;for(int i=1;i<c->n;i++)if(at_eq(c,i,function)&&at_eq(c,i-1,"int")&&at_eq(c,i+1,"(")){int e=at_end(c,i+1,"(",")");if(e>=0&&at_eq(c,e+1,"{")){body=e+1;break;}}
 if(body<0)return 0;int end=at_end(c,body,"{","}"),seen=0;
 for(int i=body;i+8<end;i++)if((at_eq(c,i,"physical")||at_eq(c,i,"new_name"))&&at_eq(c,i+1,"(")&&at_eq(c,i+2,"argv")&&at_eq(c,i+3,"[")&&at_eq(c,i+5,"]")&&at_eq(c,i+6,",")){
 int index=atoi(c->t[i+4].s)-2;const char *dest=c->t[i+7].s,*role=at_role(dest);
 if(!strcmp(dest,"prepared"))role="PREP";if(!strcmp(dest,"root"))role="ROOT";if(!strcmp(dest,"objects"))role="OBJECTS";
 if(index>=0&&index<k&&role){if(strcmp(role,at_expected(labels[index])))return 0;seen++;}
 }return seen>0;
 }
 int call=-1;for(int i=diagnostic+1;i+2<c->n;i++)if(at_eq(c,i,"return")&&!strncmp(c->t[i+1].s,"cs_",3)&&at_eq(c,i+2,"(")){call=i+1;break;}
 if(call<0)return 0;
 int def=-1;for(int i=0;i<diagnostic;i++)if(at_eq(c,i,c->t[call].s)&&at_eq(c,i-1,"int")&&at_eq(c,i+1,"(")){def=i;break;}
 if(def<0)return 0;
 int formal=def+2,actual=call+2;
 for(int j=0;j<k;j++){
 int end=at_find(c,formal,c->n,",");int close=at_find(c,formal,c->n,")");if(close>=0&&(end<0||close<end))end=close;
 if(end<1)return 0;const char *role=at_role(c->t[end-1].s);
 if(!role||strcmp(role,at_expected(labels[j])))return 0;
 if(!at_eq(c,actual,"argv")||!at_eq(c,actual+1,"[")||atoi(c->t[actual+2].s)!=j+2||!at_eq(c,actual+3,"]"))return 0;
 formal=end+1;actual+=4;if(j+1<k){if(!at_eq(c,actual,","))return 0;actual++;}
 }return 1;
}
static int at_exact_arity(struct at_src *c,const char *cmd,int argc){
 for(int i=0;i<c->n;i++)if(c->t[i].string&&!strncmp(c->t[i].s,"usage: ",7)&&!strncmp(c->t[i].s+7,cmd,strlen(cmd))&&c->t[i].s[7+strlen(cmd)]==' '){
 int lo=i-250;if(lo<0)lo=0;int first=-1;
 for(int j=i-1;j>=lo;j--)if(at_eq(c,j,"argc")&&at_eq(c,j+1,"!=")){first=j;break;}
 if(first<0)return 1;
 int yes=atoi(c->t[first+2].s)==argc;
 for(int j=first-1;j>=lo&&j>=first-16;j--)if(at_eq(c,j,"argc")&&at_eq(c,j+1,"!="))yes|=atoi(c->t[j+2].s)==argc;
 return yes;
 }return 1;
}
static void at_check(struct at_src *callee,struct at_arg *v,int n,int whole){
 int off=whole?2:0;if(n<=off||!v[off].literal){at_diag("REFUSE",n?v[0].line:0,"unknown command construction");return;}
 if(whole&&(!strcmp(v[0].value,"wft")&&strcmp(v[1].value,"--"))){at_diag("REFUSE",v[0].line,"whole-front envelope");return;}
 char labels[20][64];int minimum=0,k=at_contract(callee,v[off].value,labels,&minimum);if(k<0){at_diag("REFUSE",v[off].line,"callee parser outside support domain");return;}
 if(n-off+1<minimum){at_diag("FAIL",v[off].line,"callee argc guard rejects missing argument");return;}
 if(whole&&!at_exact_arity(callee,v[off].value,n-off+1)){at_diag("FAIL",v[off].line,"callee exact argc alternatives reject call");return;}
 if(!at_bindings(callee,v[off].value,labels,k)){at_diag("REFUSE",v[off].line,"callee forwarding/signature order differs from parser contract");return;}
 int pos=off+1;
 for(int j=0;j<k;j++){
 if(strstr(labels[j],"..."))break;
 if(pos>=n||!strncmp(v[pos].value,"--",2)){at_diag("FAIL",v[off].line,"missing positional argument");return;}
 const char *want=at_expected(labels[j]),*got=at_role(v[pos].value);
 if(v[pos].literal){if(!strcmp(want,"TARGET")&&(strstr(v[pos].value,"osx/")||strstr(v[pos].value,"win/")||strstr(v[pos].value,"lnx/")))got="TARGET";
 else if(!strcmp(want,"FIRST")||!strcmp(want,"COUNT")||!strcmp(want,"LAST"))got=want;
 else if(!strcmp(want,"OUT")&&!strcmp(v[pos].value,"out"))got="OUT";}
 if(!got||strcmp(got,want)){at_diag("FAIL",v[pos].line,"positional role/order mismatch");return;}pos++;
 }
 for(;pos<n;pos++){
 if(!whole&&!strcmp(v[off].value,"snap")&&pos==off+2&&v[pos].literal&&!strcmp(v[pos].value,"out"))continue;
 if(whole){const char *x=v[pos].value;if(!strcmp(x,"--template")||!strcmp(x,"--forward-stub")){if(++pos>=n)at_diag("FAIL",v[off].line,"missing option value");continue;}
 if(!strcmp(x,"span_roots")||(!strcmp(v[off].value,"merge")&&at_role(x)&&!strcmp(at_role(x),"PART")))continue;
 at_diag("REFUSE",v[pos].line,"unknown whole-front trailing argument");return;}
 if(!v[pos].literal||strncmp(v[pos].value,"--",2)){at_diag("FAIL",v[pos].line,"bare helper or unexpected positional argument");return;}
 int ar=at_option(callee,v[pos].value);if(!ar){at_diag("REFUSE",v[pos].line,"unknown callee option");return;}
 if(ar==2){if(++pos>=n||!strncmp(v[pos].value,"--",2)){at_diag("FAIL",v[off].line,"missing option value");return;}}
 }
 at_calls++;
}
static void at_scan(struct at_src *a,struct at_src *step,struct at_src *whole){
 for(int call=0;call<a->n;call++){
 int isstep=at_eq(a,call,"step")||at_eq(a,call,"step_secs");int iswhole=at_eq(a,call,"bound_sh_secs");
 int other=!isstep&&!iswhole;
 if(!at_eq(a,call+1,"(")||(other&&(!at_id(a->t[call].s[0])||!at_eq(a,call+3,","))))continue;
 int e=at_end(a,call+1,"(",")");if(e<0)continue;
 int comma=at_find(a,call+2,e,",");if(comma<0||comma+1>=e)continue;const char *name=a->t[comma+1].s;
 if(at_eq(a,comma+1,"char")||at_eq(a,comma+1,"args"))continue;
 /* Locate the lexical declaration of precisely this array. */
 int decl=-1;for(int j=call-1;j>=2;j--)if(at_eq(a,j,name)&&at_eq(a,j+1,"[")&&at_eq(a,j-1,"*")&&at_eq(a,j-2,"char")){decl=j;break;}
 if(decl<0){if(isstep)at_diag("REFUSE",a->t[call].line,"array declaration unavailable");continue;}
 struct at_arg v[128];int n=0,unknown=0,terminated=0;
 int close=at_end(a,decl+1,"[","]"),j=close+1;
 if(at_eq(a,j,"=")&&at_eq(a,j+1,"{")){
 int end=at_end(a,j+1,"{","}");int lo=j+2;for(int z=lo;z<=end;z++)if(at_eq(a,z,",")||z==end){if(lo==z){lo=z+1;continue;}if(n==128||!at_expr(a,lo,z,&v[n]))unknown=1;else if(!strcmp(v[n].value,"0"))terminated=1;else n++;lo=z+1;}j=end+1;
 }
 for(;j<call;j++){
 if(at_eq(a,j,"n")&&at_eq(a,j+1,"=")&&at_eq(a,j+2,"0")&&(at_eq(a,j+3,";")||at_eq(a,j+3,","))){n=0;terminated=0;unknown=0;}
 if(at_eq(a,j,name)&&!at_eq(a,j+1,"[")&&(at_eq(a,j-1,"(")||at_eq(a,j-1,",")))unknown=1;
 if(!at_eq(a,j,name)||!at_eq(a,j+1,"["))continue;
 /* Reading an array is harmless; writes through a passed alias are not supported. */
 int end=at_end(a,j+1,"[","]");if(end<0||!at_eq(a,end+1,"="))continue;
 int z=at_find(a,end+2,call,";");if(z<0){unknown=1;break;}
 int idx=n;if(end==j+3&&at_id(a->t[j+2].s[0])&&a->t[j+2].s[0]>='0'&&a->t[j+2].s[0]<='9')idx=atoi(a->t[j+2].s);
 else if(!(end==j+4&&at_eq(a,j+3,"++"))&&!(end==j+3&&at_eq(a,j+2,"n")))unknown=1;
 if(idx>=128||!at_expr(a,end+2,z,&v[idx]))unknown=1;
 else if(!strcmp(v[idx].value,"0")){terminated=1;if(idx<n)n=idx;}
 else {
 if(!strcmp(v[idx].value,"span_roots")&&(!at_tail_loop(a,j,"cf_root_count()")||!at_eq(a,z-2,"i")))unknown=1;
 if(!strcmp(v[idx].value,"parts")&&n>2&&!strcmp(v[2].value,"merge")&&(!at_tail_loop(a,j,"slices")||!at_eq(a,z-2,"i")||!at_partition_flow(a)))unknown=1;
 if(idx==0)n=0;if(idx!=n)unknown=1;n=idx+1;terminated=0;
 }
 j=z;
 }
 if(other){char labels[20][64];int minimum=0;if(n>0&&(!strcmp(v[0].value,"wft")||(v[0].literal&&at_contract(step,v[0].value,labels,&minimum)>=0)))at_diag("REFUSE",a->t[call].line,"relevant argv escapes through unknown wrapper");continue;}
 if(iswhole&&(n==0||strcmp(v[0].value,"wft"))){if(unknown&&at_find(a,decl,call,"wft")>=0)at_diag("REFUSE",a->t[call].line,"unknown whole-front envelope construction");continue;}
 if(iswhole&&n>2&&!strcmp(v[2].value,"front")&&(at_find(a,decl,call,"offset")>=0||at_find(a,decl,call,"amount")>=0)&&!at_partition_flow(a)){at_diag("REFUSE",a->t[call].line,"unsupported dynamic partition construction");continue;}
 if(unknown||!terminated){at_diag("REFUSE",a->t[call].line,"unsupported array construction or missing terminator");continue;}
 at_check(isstep?step:whole,v,n,iswhole);
 }
}
static int at_run(const char *candidate,const char *chain,const char *front){
 at_bad=0;at_calls=0;at_diagnostics=0;at_diagnostic_mismatch=0;struct at_src a=at_lex(candidate),b=at_lex(chain),c=at_lex(front);
 /* Envelope implementations are part of the proof, not just their names. */
 if(!strstr(candidate,"v[n++] = args[i]")||!strstr(candidate,"return bound_sh_secs(root, v, secs)")||!strstr(candidate,"return step_secs(root, args, 55)")||!strstr(candidate,"v[n++] = rest[i]"))at_diag("REFUSE",0,"unsupported forwarding envelope");
 at_scan(&a,&b,&c);if(!at_calls)at_diag("REFUSE",0,"no supported calls");
 printf("CHAIN_ARGV_CHECK\tcalls=%d\tstatus=%s\n",at_calls,at_bad?"REFUSE":"PASS");free(a.t);free(b.t);free(c.t);return at_bad;
}
int ca_check(const char *candidate, const char *chain, const char *front, const char *expected, int *diagnostics, int *mismatch) {
 at_expected_diagnostic=expected; int rc=at_run(candidate,chain,front);
 if(diagnostics)*diagnostics=at_diagnostics; if(mismatch)*mismatch=at_diagnostic_mismatch;
 at_expected_diagnostic=0; return rc;
}
