#pragma unisa module relsha
#pragma unisa use text.text

/* 0 when s is exactly 40 lowercase hex digits. */
int rs_sha40(const char *s) {
    long n, i;
    if (!s) return 1;
    n = tx_len(s, 64);
    if (n != 40) return 1;
    for (i = 0; i < 40; i++) {
        char c = s[i];
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return 1;
    }
    return 0;
}

/* 1 when CMD looks like deleting a release or git tag. */
int rs_is_tag_delete(const char *cmd) {
    long n;
    if (!cmd) return 0;
    n = tx_len(cmd, 4096);
    if (tx_contains(cmd, n, "release delete", 14)) return 1;
    if (tx_contains(cmd, n, "tag -d", 6)) return 1;
    if (tx_contains(cmd, n, "tag --delete", 12)) return 1;
    return 0;
}
