/* Shared C-source text scanning helpers: identifier classes, exact word compare, comment and literal
 * erasure keeping newlines, plus small owned-string helpers used by the header scanners. */
#pragma unisa module cscan
#pragma unisa use sys.fs
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
int cs_idch(char c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'; }
int cs_idstart(char c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'; }
/* 1 when the N bytes at S equal the literal LIT (at most 64 bytes). */
int cs_word_eq(const char *s, long n, const char *lit) {
    long ln = tx_len(lit, 64);
    return n == ln && mm_same(s, lit, ln);
}
/* Blank comments and string/char literals in place, keeping newlines so line numbers hold. */
void cs_strip_comments(char *s, long n) {
    long i = 0;
    while (i < n) {
        if (s[i] == '/' && i + 1 < n && s[i + 1] == '*') {
            s[i] = ' '; s[i + 1] = ' '; i += 2;
            while (i < n && !(s[i] == '*' && i + 1 < n && s[i + 1] == '/')) { if (s[i] != '\n') s[i] = ' '; i++; }
            if (i < n) { s[i] = ' '; if (i + 1 < n) s[i + 1] = ' '; i += 2; }
        } else if (s[i] == '/' && i + 1 < n && s[i + 1] == '/') {
            while (i < n && s[i] != '\n') { s[i] = ' '; i++; }
        } else if (s[i] == '"' || s[i] == '\'') {
            char q = s[i]; i++;
            while (i < n && s[i] != q && s[i] != '\n') { if (s[i] == '\\' && i + 1 < n && s[i + 1] != '\n') { s[i] = ' '; i++; } s[i] = ' '; i++; }
            if (i < n && s[i] == q) i++;
        } else i++;
    }
}
/* Owned NUL-terminated copy of N bytes. */
char *cs_dupn(const char *s, long n) {
    char *r = mm_alloc(n + 1);
    mm_copy(r, n + 1, s, n);
    r[n] = 0;
    return r;
}
/* Read a whole file into an owned NUL-terminated buffer; length in *N; 0 when unreadable. */
char *cs_slurp(const char *path, long *n) {
    size_t m = 0;
    char *b = cx_read(path, &m), *c;
    if (!b) return 0;
    c = mm_alloc((long)m + 1);
    mm_copy(c, (long)m + 1, b, (long)m);
    c[m] = 0;
    mm_free(b);
    *n = (long)m;
    return c;
}
/* 1 when the NUL-terminated strings A and B (at most 4096 bytes) are equal. */
int cs_streq(const char *a, const char *b) {
    long n = tx_len(a, 4096);
    return n == tx_len(b, 4096) && mm_same(a, b, n);
}
/* First occurrence of the NUL-terminated needle N in the NUL-terminated haystack H, or 0. */
const char *cs_fnd(const char *h, const char *n) {
    size_t k = strlen(n);
    for (; *h; h++) if (!strncmp(h, n, k)) return h;
    return 0;
}
