#pragma unisa module releaseseq
#pragma unisa use sys.fs
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use text.text
#pragma unisa use cxlib.releaseversion

static long rs_key(const char *s) {
    if(!rv_valid(s))return -1;
    long key=0;int parts=0,value=0;
    for(;;s++){
        if(parts==3)return -1;
        if(*s && *s!='.') {value=value*10+(*s-'0');continue;}
        key=key*65536+value;parts++;value=0;
        if(!*s)break;
    }
    return parts==3&&key>0?key:-1;
}
int rs_version(const char *version) { return rs_key(version)>0; }
int rs_product_version(const char *line, char out[24]) {
    const char prefix[] = "unisacc ";
    size_t n = tx_len(line, 128), start = sizeof prefix - 1;
    if (!tx_prefix(line, n, prefix, start)) return -1;
    if (line[n - 1] == '\n') n--;
    if (n <= start || n - start >= 24 ||
        cx_fmt(out, 24, "%.*s", (int)(n - start), line + start) || !rs_version(out)) return -1;
    return 0;
}
int rs_precedes(const char *older,const char *newer) {
    long a=rs_key(older),b=rs_key(newer);
    return a>0&&a<b;
}
/* Greatest published canonical version strictly below the candidate, regardless of slot order. */
int rs_previous(const char *version,char *out,long cap) {
    long want=rs_key(version),best=0;
    unsigned char *data=0;int64_t n=0;
    if(want<0||sy_read_file("build/version-seq.tsv",&data,&n,1L<<20)||!data)return -1;
    char found[24]="";
    int rc=-1;
    for(int64_t a=0;a<n;){
        int64_t z=a;while(z<n&&data[z]!='\n')z++;
        const char *cols[4]={0};long sizes[4]={0};int k=0;int64_t start=a;
        for(int64_t i=a;i<=z&&k<4;i++)if(i==z||data[i]=='\t'){
            cols[k]=(const char *)data+start;sizes[k++]=i-start;start=i+1;
        }
        a=z+1;
        static const char published[]="已公开";
        if(k!=4||sizes[3]!=sizeof published-1||memcmp(cols[3],published,sizeof published-1))continue;
        char s[24];
        if(sizes[1]<=0||sizes[1]>=sizeof s||memchr(cols[1],0,sizes[1]))goto done;
        if(mm_copy(s,sizeof s,cols[1],sizes[1]))goto done;
        s[sizes[1]]=0;
        long key=rs_key(s);
        if(key<0)goto done;
        if(key<want&&key>best){best=key;if(cx_fmt(found,sizeof found,"%s",s))goto done;}
    }
    if(best)rc=cx_fmt(out,cap,"%s",found);
 done:
    free(data);return rc;
}
