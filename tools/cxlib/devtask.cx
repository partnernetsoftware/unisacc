#pragma unisa module devtask
/* devtask: work orders (实施单) and dispatch state for a multi-agent repo, first cut on plain TSV.
 * Store: DIR/tasks.tsv (DT_HDR columns), DIR/task-events.tsv (seq time id event owner), DIR/tasks.lock.
 * Every mutation takes an exclusive flock on tasks.lock, reloads, validates, writes tasks.tsv by atomic rename
 * and appends one event row; two concurrent claims therefore serialize and the second sees state=claimed.
 * The core knows no repo path: DIR is given by the caller; dt_instdir derives it from a devsvc repo table
 * (keys cache_sub, inst_env) so it lands beside the devsvc instance directory.
 * Write domains are comma-joined path prefixes; two domains intersect when one prefix is a byte prefix of
 * the other (conservative: tools/dev intersects tools/devtask.cx).
 * Return codes: 0 ok, 1 refused by state or domain conflict, 2 bad input or I/O. Empty column is "-".
 * Times are UTC, YYYY-MM-DDTHH:MM:SSZ, compared as strings. */
#pragma unisa use cxlib.netpack
#pragma unisa use text.build
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sys.posix
#pragma unisa use sys.env
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

#define DT_MAX 4096
#define DT_HDR "id\ttitle\towner\tstate\twrite_domain\tdeadline\tevidence\tgap\tupdated\n"
#define DT_EHDR "seq\ttime\tid\tevent\towner\n"
typedef struct DtTask { char id[16], title[256], owner[64], state[12], domain[1024], deadline[24], evidence[512], gap[1024], updated[24]; } DtTask;
typedef struct DtSet { DtTask *t; int n; } DtSet;

void dt_utc(long s, char *out, int cap) {
    long d = s / 86400, r = s % 86400, z = d + 719468, era = z / 146097, doe = z - era * 146097;
    long yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365, y = yoe + era * 400;
    long doy = doe - (365 * yoe + yoe / 4 - yoe / 100), mp = (5 * doy + 2) / 153, dd = doy - (153 * mp + 2) / 5 + 1, m = mp < 10 ? mp + 3 : mp - 9;
    if (m <= 2) y++;
    (void)cx_fmt(out, cap, "%04ld-%02ld-%02ldT%02ld:%02ld:%02ldZ", y, m, dd, r / 3600, r % 3600 / 60, r % 60);
}
/* one TSV cell: non-empty, shorter than cap, no control bytes, not the empty marker */
int dt_text_ok(const char *s, long cap) {
    long n = 0;
    if (!s || !*s || !strcmp(s, "-")) return 0;
    for (; s[n]; n++) if ((unsigned char)s[n] < 0x20 || s[n] == 0x7f) return 0;
    return n < cap;
}
int dt_name_ok(const char *s, long cap) {
    if (!dt_text_ok(s, cap)) return 0;
    for (; *s; s++) if (*s == ' ' || *s == ',') return 0;
    return 1;
}
/* comma-joined relative path prefixes: no empty entry, blank, absolute path or .. */
int dt_domain_ok(const char *d) {
    const char *p = d;
    if (!dt_text_ok(d, 1024) || strstr(d, "..")) return 0;
    for (;;) {
        const char *e = strchr(p, ',');
        long n = e ? e - p : (long)strlen(p);
        if (n <= 0 || p[0] == '/') return 0;
        for (long i = 0; i < n; i++) if (p[i] == ' ') return 0;
        if (!e) return 1;
        p = e + 1;
    }
}
/* 1 when some prefix of a and some prefix of b overlap; the first overlapping pair is written to hit */
int dt_domain_hit(const char *a, const char *b, char *hit, int cap) {
    for (const char *p = a; p;) {
        const char *pe = strchr(p, ','); long pn = pe ? pe - p : (long)strlen(p);
        for (const char *q = b; q;) {
            const char *qe = strchr(q, ','); long qn = qe ? qe - q : (long)strlen(q);
            if (!memcmp(p, q, pn < qn ? pn : qn)) { if (hit) (void)cx_fmt(hit, cap, "%.*s~%.*s", (int)pn, p, (int)qn, q); return 1; }
            q = qe ? qe + 1 : 0;
        }
        p = pe ? pe + 1 : 0;
    }
    return 0;
}
static int dt_cp(char *d, int cap, const char *s, long n) { if (n <= 0 || n >= cap || mm_copy(d, cap, s, n)) return 1; d[n] = 0; return 0; }
static int dt_state_ok(const char *s) { return !strcmp(s, "open") || !strcmp(s, "claimed") || !strcmp(s, "blocked") || !strcmp(s, "done") || !strcmp(s, "dropped"); }
int dt_live(const DtTask *t) { return !strcmp(t->state, "open") || !strcmp(t->state, "claimed") || !strcmp(t->state, "blocked"); }
int dt_stale(const DtTask *t, long now) {
    char ts[24]; dt_utc(now, ts, sizeof ts);
    return dt_live(t) && strcmp(t->deadline, "-") && strcmp(t->deadline, ts) < 0;
}
void dt_free(DtSet *s) { free(s->t); s->t = 0; s->n = 0; }
/* a missing tasks.tsv is an empty set; any other read failure or malformed row refuses */
int dt_load(const char *dir, DtSet *s, char *why, int wl) {
    char p[2048]; unsigned char *b = 0; int64_t n = 0; long hl = (long)strlen(DT_HDR), rows = 0, line = 1; int rc;
    s->t = 0; s->n = 0;
    if (snprintf(p, sizeof p, "%s/tasks.tsv", dir) >= (int)sizeof p) { snprintf(why, wl, "directory path too long"); return 2; }
    rc = sy_read_file(p, &b, &n, 1L << 24);
    if (rc == -ENOENT) { s->t = calloc(1, sizeof(DtTask)); if (!s->t) { snprintf(why, wl, "out of memory"); return 2; } return 0; }
    if (rc) { (void)cx_fmt(why, wl, "read tasks.tsv rc=%d", rc); return 2; }
    if (n < hl || memcmp(b, DT_HDR, hl) || b[n - 1] != '\n') { free(b); snprintf(why, wl, "tasks.tsv: bad header or unterminated last row"); return 2; }
    for (long i = hl; i < n; i++) if (b[i] == '\n') rows++;
    if (rows > DT_MAX) { free(b); (void)cx_fmt(why, wl, "tasks.tsv: more than %d rows", DT_MAX); return 2; }
    s->t = calloc(rows + 1, sizeof(DtTask));
    if (!s->t) { free(b); snprintf(why, wl, "out of memory"); return 2; }
    for (long i = hl; i < n;) {
        long e = i, f = 0, fs = i; DtTask *t = &s->t[s->n]; int bad = 0;
        char *dst[] = {t->id, t->title, t->owner, t->state, t->domain, t->deadline, t->evidence, t->gap, t->updated};
        int cap[] = {sizeof t->id, sizeof t->title, sizeof t->owner, sizeof t->state, sizeof t->domain, sizeof t->deadline, sizeof t->evidence, sizeof t->gap, sizeof t->updated};
        line++;
        while (b[e] != '\n') e++;
        for (long k = i; k <= e; k++) if (k == e || b[k] == '\t') { if (f >= 9 || dt_cp(dst[f], cap[f], (const char *)b + fs, k - fs)) bad = 1; f++; fs = k + 1; }
        if (bad || f != 9 || !dt_state_ok(t->state)) { free(b); dt_free(s); (void)cx_fmt(why, wl, "tasks.tsv line %ld: malformed row", line); return 2; }
        s->n++; i = e + 1;
    }
    free(b); return 0;
}
static int dt_save(const char *dir, const DtSet *s, char *why, int wl) {
    char p[2048]; sb *o = sb_new(); int bad;
    if (!o || snprintf(p, sizeof p, "%s/tasks.tsv", dir) >= (int)sizeof p) { snprintf(why, wl, "save setup"); return 2; }
    bad = sb_puts(o, DT_HDR);
    for (int i = 0; i < s->n && !bad; i++) {
        const DtTask *t = &s->t[i]; const char *c[] = {t->id, t->title, t->owner, t->state, t->domain, t->deadline, t->evidence, t->gap, t->updated};
        for (int k = 0; k < 9 && !bad; k++) bad = sb_puts(o, c[k]) || sb_puts(o, k == 8 ? "\n" : "\t");
    }
    if (bad || !sb_cstr(o) || sy_write_atomic(p, sb_cstr(o), sb_len(o), 0600)) { sb_free(o); snprintf(why, wl, "write tasks.tsv failed"); return 2; }
    sb_free(o); return 0;
}
/* exclusive lock for one mutation; the holder only reloads, validates and renames, so the wait is short */
int dt_lock(const char *dir) {
    char p[2048]; int fd;
    if (snprintf(p, sizeof p, "%s/tasks.lock", dir) >= (int)sizeof p || sy_mkdir_all(dir, 0700)) return -1;
    fd = sy_open(p, O_RDWR | O_CREAT, 0600);
    if (fd < 0) return -1;
    if (sy_flock(fd, 2)) { sy_close(fd); return -1; }
    return fd;
}
void dt_unlock(int fd) { if (fd >= 0) { sy_flock(fd, 8); sy_close(fd); } }
/* caller holds the lock; seq continues from the rows already in the file */
static int dt_event_d(const char *dir, const char *id, const char *ev, const char *owner, const char *detail, long now, char *why, int wl) {
    char p[2048], ts[24], row[1700]; unsigned char *b = 0; int64_t n = 0; long seq = 1; int rc, w;
    if (snprintf(p, sizeof p, "%s/task-events.tsv", dir) >= (int)sizeof p) { snprintf(why, wl, "directory path too long"); return 2; }
    rc = sy_read_file(p, &b, &n, 1L << 26);
    if (rc && rc != -ENOENT) { (void)cx_fmt(why, wl, "read task-events.tsv rc=%d", rc); return 2; }
    if (!rc) { seq = 0; for (long i = 0; i < n; i++) if (b[i] == '\n') seq++; free(b); if (seq < 1) seq = 1; }
    dt_utc(now, ts, sizeof ts);
    w = detail ? snprintf(row, sizeof row, "%s%ld\t%s\t%s\t%s\t%s\t%s\n", rc ? DT_EHDR : "", seq, ts, id, ev, owner, detail)
               : snprintf(row, sizeof row, "%s%ld\t%s\t%s\t%s\t%s\n", rc ? DT_EHDR : "", seq, ts, id, ev, owner);
    if (w <= 0 || w >= (int)sizeof row || sy_append_file(p, row, w, 0600)) { snprintf(why, wl, "append task-events.tsv failed"); return 2; }
    return 0;
}
static int dt_event(const char *dir, const char *id, const char *ev, const char *owner, long now, char *why, int wl) { return dt_event_d(dir, id, ev, owner, 0, now, why, wl); }
/* deadline_min 0 means none; owner may be null (unreserved) */
int dt_add(const char *dir, const char *title, const char *domain, long deadline_min, const char *owner, long now, char *idout, int idcap, char *why, int wl) {
    DtSet s; int lk, rc; long top = 0; DtTask *t;
    if (!dt_text_ok(title, 256)) { snprintf(why, wl, "bad title (empty, too long or control bytes)"); return 2; }
    if (!dt_domain_ok(domain)) { snprintf(why, wl, "bad write domain (need relative path prefixes without blanks or ..)"); return 2; }
    if (owner && !dt_name_ok(owner, 64)) { snprintf(why, wl, "bad owner"); return 2; }
    if (deadline_min < 0 || deadline_min > 525600) { snprintf(why, wl, "bad deadline minutes"); return 2; }
    if ((lk = dt_lock(dir)) < 0) { (void)cx_fmt(why, wl, "cannot lock %s", dir); return 2; }
    rc = dt_load(dir, &s, why, wl);
    if (rc) { dt_unlock(lk); return rc; }
    if (s.n >= DT_MAX) { dt_free(&s); dt_unlock(lk); snprintf(why, wl, "task table full"); return 2; }
    for (int i = 0; i < s.n; i++) { long v = atol(s.t[i].id + 1); if (v > top) top = v; }
    t = &s.t[s.n++];
    /* every input below was validated above against these field sizes (title<256, owner<64, domain<1024), so cx_fmt cannot truncate */
    (void)cx_fmt(t->id, sizeof t->id, "T%ld", top + 1); (void)cx_fmt(t->title, sizeof t->title, "%s", title);
    (void)cx_fmt(t->owner, sizeof t->owner, "%s", owner ? owner : "-"); (void)cx_fmt(t->state, sizeof t->state, "open");
    (void)cx_fmt(t->domain, sizeof t->domain, "%s", domain);
    if (deadline_min) dt_utc(now + deadline_min * 60, t->deadline, sizeof t->deadline); else snprintf(t->deadline, sizeof t->deadline, "-");
    snprintf(t->evidence, sizeof t->evidence, "-"); snprintf(t->gap, sizeof t->gap, "-"); dt_utc(now, t->updated, sizeof t->updated);
    if (idout && cx_fmt(idout, idcap, "%s", t->id)) { dt_free(&s); dt_unlock(lk); snprintf(why, wl, "id buffer too small"); return 2; }
    rc = dt_save(dir, &s, why, wl);
    if (!rc) rc = dt_event(dir, t->id, "add", t->owner, now, why, wl);
    dt_free(&s); dt_unlock(lk); return rc;
}
static int dt_note(DtTask *t, const char *tag, const char *text, char *why, int wl) {
    char g[1024]; int w = snprintf(g, sizeof g, "%s%s%s%s", strcmp(t->gap, "-") ? t->gap : "", strcmp(t->gap, "-") ? " | " : "", tag, text);
    if (w >= (int)sizeof g) { (void)cx_fmt(why, wl, "gap column full for %s", t->id); return 2; }
    if (mm_copy(t->gap, sizeof t->gap, g, w + 1)) { (void)cx_fmt(why, wl, "gap copy failed for %s", t->id); return 2; } return 0;
}
/* op: claim (owner) | done (text = evidence) | block (text = why) | gap (text) | drop (text = why) */
int dt_change(const char *dir, const char *op, const char *id, const char *owner, const char *text, long now, char *why, int wl) {
    DtSet s; int lk, rc, k = -1, isclaim = !strcmp(op, "claim"); DtTask *t;
    if (strcmp(op, "claim") && strcmp(op, "done") && strcmp(op, "block") && strcmp(op, "gap") && strcmp(op, "drop")) { (void)cx_fmt(why, wl, "unknown operation %s", op); return 2; }
    if (!dt_name_ok(id, 16)) { snprintf(why, wl, "bad task id"); return 2; }
    if (isclaim && !dt_name_ok(owner, 64)) { snprintf(why, wl, "bad owner"); return 2; }
    if (!isclaim && !dt_text_ok(text, 480)) { snprintf(why, wl, "bad text (empty, too long or control bytes)"); return 2; }
    if ((lk = dt_lock(dir)) < 0) { (void)cx_fmt(why, wl, "cannot lock %s", dir); return 2; }
    rc = dt_load(dir, &s, why, wl);
    if (rc) { dt_unlock(lk); return rc; }
    for (int i = 0; i < s.n; i++) if (!strcmp(s.t[i].id, id)) k = i;
    if (k < 0) { (void)cx_fmt(why, wl, "no such task %s", id); rc = 2; goto out; }
    t = &s.t[k]; rc = 1;
    if (isclaim) {
        int resume = !strcmp(t->state, "blocked") && !strcmp(t->owner, owner), used = 0, hits = 0;
        if (strcmp(t->state, "open") && !resume) { (void)cx_fmt(why, wl, "%s is %s (owner %s), not claimable", id, t->state, t->owner); goto out; }
        if (!resume && strcmp(t->owner, "-") && strcmp(t->owner, owner)) { (void)cx_fmt(why, wl, "%s is reserved for %s", id, t->owner); goto out; }
        for (int i = 0; i < s.n; i++) { char hit[512];
            if (i == k || strcmp(s.t[i].state, "claimed") || !dt_domain_hit(t->domain, s.t[i].domain, hit, sizeof hit)) continue;
            if (!hits++) used = snprintf(why, wl, "write domain of %s intersects claimed:", id);
            if (used > 0 && used < wl) used += snprintf(why + used, wl - used, " %s(owner=%s,%s)", s.t[i].id, s.t[i].owner, hit);
        }
        if (hits) goto out;
        (void)cx_fmt(t->owner, sizeof t->owner, "%s", owner); (void)cx_fmt(t->state, sizeof t->state, "claimed");   /* owner validated < 64 */
    } else if (!strcmp(op, "done")) {
        if (strcmp(t->state, "claimed")) { (void)cx_fmt(why, wl, "%s is %s, only a claimed task can be done", id, t->state); goto out; }
        (void)cx_fmt(t->evidence, sizeof t->evidence, "%s", text); (void)cx_fmt(t->state, sizeof t->state, "done");   /* text validated < 480 */
    } else {
        int isgap = !strcmp(op, "gap"), isblock = !strcmp(op, "block");
        if (!dt_live(t) || (isblock && !strcmp(t->state, "blocked"))) { (void)cx_fmt(why, wl, "%s is %s, cannot %s", id, t->state, op); goto out; }
        if ((rc = dt_note(t, isgap ? "" : isblock ? "blocked: " : "dropped: ", text, why, wl)) != 0) goto out;
        if (!isgap) (void)cx_fmt(t->state, sizeof t->state, "%s", isblock ? "blocked" : "dropped");
    }
    dt_utc(now, t->updated, sizeof t->updated);
    rc = dt_save(dir, &s, why, wl);
    if (!rc) rc = dt_event(dir, id, op, t->owner, now, why, wl);
out:
    dt_free(&s); dt_unlock(lk); return rc;
}
/* instance directory by the devsvc convention: the env var named by inst_env, else
   HOME/<cache_sub>/<first 16 hex of sha256(absolute git common dir of root)>; both keys come from the repo table */
int dt_instdir(const char *root, const char *table, char *out, int cap, char *why, int wl) {
    char p[2048], sub[128] = "", envn[64] = "", home[1024], hex[65], common[1024]; unsigned char *b = 0; int64_t n = 0; int rc; const char *e;
    if (snprintf(p, sizeof p, "%s%s%s", table[0] == '/' ? "" : root, table[0] == '/' ? "" : "/", table) >= (int)sizeof p) { snprintf(why, wl, "table path too long"); return 2; }
    rc = sy_read_file(p, &b, &n, 1L << 20);
    if (rc) { (void)cx_fmt(why, wl, "read repo table %s rc=%d", p, rc); return 2; }
    for (long i = 0; i < n;) {
        long le = i, t1, t2;
        while (le < n && b[le] != '\n') le++;
        for (t1 = i; t1 < le && b[t1] != '\t'; t1++) {}
        for (t2 = t1 + 1; t2 < le && b[t2] != '\t'; t2++) {}
        if (t1 < le && t1 - i == 9 && !memcmp(b + i, "cache_sub", 9)) dt_cp(sub, sizeof sub, (const char *)b + t1 + 1, t2 - t1 - 1);
        if (t1 < le && t1 - i == 8 && !memcmp(b + i, "inst_env", 8)) dt_cp(envn, sizeof envn, (const char *)b + t1 + 1, t2 - t1 - 1);
        i = le + 1;
    }
    free(b);
    if (!sub[0] || !envn[0]) { (void)cx_fmt(why, wl, "repo table %s lacks cache_sub or inst_env", p); return 2; }
    e = getenv(envn);
    if (e && *e) { if (snprintf(out, cap, "%s", e) >= cap) { snprintf(why, wl, "instance path too long"); return 2; } return 0; }
    {   char *v[] = {"git", "-C", (char *)root, "rev-parse", "--path-format=absolute", "--git-common-dir", 0}; np_result r = {0}; char w2[256]; long cn;
        rc = np_run(v, 0, 0, 15, &r, w2, sizeof w2);
        if (rc || r.rc || !r.out || r.outn < 2 || r.outn >= sizeof common) { np_free(&r); snprintf(why, wl, "git common dir query failed"); return 2; }
        cn = (long)r.outn; while (cn > 0 && (r.out[cn - 1] == '\n' || r.out[cn - 1] == '\r')) cn--;
        if (cn >= (long)sizeof common || mm_copy(common, sizeof common, r.out, cn)) { np_free(&r); (void)cx_fmt(why, wl, "git common dir too long"); return 2; } common[cn] = 0; np_free(&r);
    }
    e = getenv("HOME");
    if (!common[0] || !e || !*e || snprintf(home, sizeof home, "%s", e) >= (int)sizeof home || sy_sha256_hex(common, strlen(common), hex)) { snprintf(why, wl, "cannot derive instance directory"); return 2; }
    hex[16] = 0;
    if (snprintf(out, cap, "%s/%s/%s", home, sub, hex) >= cap) { snprintf(why, wl, "instance path too long"); return 2; }
    return 0;
}

/* ---- job-style work orders with executable acceptance (plans/devsvc.md R5) ----
 * Store: DIR/work/ID.tsv (key<TAB>value rows: id title write root opened deadline done, accept CMD per row,
 * snap SHA PATH per row) and DIR/work/index.tsv (one id per row, append only). opened/deadline/done are epoch
 * seconds; done is 0 until every acceptance command passed. The snapshot is the dirty path set of the work tree
 * at open time with a sha256 of each file ("-" missing, "?" unreadable); a path counts as changed by the task
 * when it is dirty now and its (path, sha) pair is not in the snapshot. Inside the write domain means some
 * write entry is a byte prefix of the path. Running the acceptance commands is the caller's side (tools/devtask.cx). */
enum { DW_ACC = 16 };
typedef struct DwSnap { char sha[65], path[512]; } DwSnap;
typedef struct DwTask { char id[64], title[256], write[1024], root[1024], owner[64], ext[1024], cwd[1024]; long opened, deadline, done; char acc[DW_ACC][1024]; int nacc, nsnap; DwSnap *snap; } DwTask;
void dw_free(DwTask *t) { free(t->snap); t->snap = 0; t->nsnap = 0; }
int dw_id_ok(const char *s) {
    if (!dt_name_ok(s, 64)) return 0;
    for (; *s; s++) if (*s == '/' || *s == '.') return 0;
    return 1;
}
int dw_in(const char *write, const char *path) {
    long pl = (long)strlen(path);
    for (const char *p = write; p;) {
        const char *e = strchr(p, ','); long n = e ? e - p : (long)strlen(p);
        if (n <= pl && !memcmp(p, path, n)) return 1;
        p = e ? e + 1 : 0;
    }
    return 0;
}
/* dirty paths of the work tree at root, each with the sha256 of its current bytes */
int dw_dirty(const char *root, DwSnap **out, int *n, char *why, int wl) {
    char *v[] = {"git", "-C", (char *)root, "status", "--porcelain", "-z", "--untracked-files=all", 0}; np_result r = {0}; char w2[256]; int cnt = 0, k = 0; DwSnap *s;
    *out = 0; *n = 0;
    if (np_run(v, 0, 0, 30, &r, w2, sizeof w2) || r.rc) { np_free(&r); (void)cx_fmt(why, wl, "git status failed under %s", root); return 2; }
    for (size_t i = 0; i < r.outn; i++) if (!r.out[i]) cnt++;
    s = calloc(cnt + 1, sizeof *s);
    if (!s) { np_free(&r); snprintf(why, wl, "out of memory"); return 2; }
    for (size_t i = 0; i < r.outn;) {
        size_t e = i; int ren, rc; char p[2048]; unsigned char *b = 0; int64_t bn = 0;
        while (e < r.outn && r.out[e]) e++;
        if (e - i < 4 || dt_cp(s[k].path, sizeof s[k].path, r.out + i + 3, (long)(e - i - 3)) || !dt_text_ok(s[k].path, sizeof s[k].path)
            || snprintf(p, sizeof p, "%s/%s", root, s[k].path) >= (int)sizeof p) { free(s); np_free(&r); snprintf(why, wl, "git status entry malformed, or path too long or with control bytes"); return 2; }
        ren = r.out[i] == 'R' || r.out[i] == 'C';
        rc = sy_read_file(p, &b, &bn, 1L << 27);
        if (rc || sy_sha256_hex(b ? (const void *)b : (const void *)"", (long)bn, s[k].sha)) (void)cx_fmt(s[k].sha, sizeof s[k].sha, "%s", rc == -ENOENT ? "-" : "?");   /* one byte into 65 */
        free(b); k++; i = e + 1;
        if (ren) { while (i < r.outn && r.out[i]) i++; i++; }
    }
    np_free(&r); *out = s; *n = k; return 0;
}
/* ---- external write directories (--write-ext), --cwd, and work trees named by --write ---- */
static int dw_isdir(const char *p) { char *v[] = {"test", "-d", (char *)p, 0}; np_result r = {0}; char w[128]; int ok = !np_run(v, 0, 0, 10, &r, w, sizeof w) && r.rc == 0; np_free(&r); return ok; }
static void dw_up(char *p) { char *s = strrchr(p, '/'); if (s) { if (s == p) p[1] = 0; else *s = 0; } }
/* raw: comma-joined absolute directories; canon gets the realpath list. Refused: not absolute, blank, .., not an existing
 * directory, "/" and HOME itself and its two parents */
int dw_ext_ok(const char *raw, char *canon, int cap, char *why, int wl) {
    char home[1024] = "", bad1[3][1024]; const char *h = getenv("HOME"); int nb = 0; long used = 0;
    canon[0] = 0;
    if (!dt_text_ok(raw, 1024)) { snprintf(why, wl, "bad --write-ext"); return 2; }
    if (h && h[0] == '/' && sy_realpath(h, home, sizeof home) >= 0) { for (int i = 0; i < 3; i++) { (void)cx_fmt(bad1[i], sizeof bad1[i], "%s", i ? bad1[i - 1] : home); if (i) dw_up(bad1[i]); } nb = 3; }
    for (const char *p = raw; p;) {
        const char *e = strchr(p, ','); long n = e ? e - p : (long)strlen(p); char one[1024], rp[1024];
        if (n <= 0 || n >= (long)sizeof one) { snprintf(why, wl, "bad --write-ext entry"); return 2; }
        mm_copy(one, sizeof one, p, n); one[n] = 0;
        if (one[0] != '/' || strstr(one, "..") || strchr(one, ' ')) { (void)cx_fmt(why, wl, "--write-ext needs an absolute path without blanks or ..: %s", one); return 2; }
        if (sy_realpath(one, rp, sizeof rp) < 0 || !dw_isdir(rp)) { (void)cx_fmt(why, wl, "--write-ext is not an existing directory: %s", one); return 2; }
        if (!strcmp(rp, "/")) { snprintf(why, wl, "--write-ext refuses /"); return 2; }
        for (int i = 0; i < nb; i++) if (!strcmp(rp, bad1[i])) { (void)cx_fmt(why, wl, "--write-ext refuses HOME or its two parents: %s", rp); return 2; }
        { int w = snprintf(canon + used, cap - used, "%s%s", used ? "," : "", rp); if (w >= cap - used) { snprintf(why, wl, "oversized --write-ext"); return 2; } used += w; }
        p = e ? e + 1 : 0;
    }
    return 0;
}
/* cwd must be a directory under root/.claude/worktrees/ or under (or equal to) one of the canonical ext directories */
int dw_cwd_ok(const char *cwd, const char *root, const char *ext, char *canon, int cap, char *why, int wl) {
    char rp[1024], rr[1024], pre[1100]; int ok = 0;
    if (cwd[0] != '/' || strstr(cwd, "..") || sy_realpath(cwd, rp, sizeof rp) < 0 || !dw_isdir(rp)) { (void)cx_fmt(why, wl, "--cwd is not an existing directory (absolute, or relative to the repo root, no ..): %s; example: --cwd .claude/worktrees/v0.0.68", cwd); return 2; }
    if (sy_realpath(root, rr, sizeof rr) >= 0 && snprintf(pre, sizeof pre, "%s/.claude/worktrees/", rr) < (int)sizeof pre && !strncmp(rp, pre, strlen(pre)) && rp[strlen(pre)]) ok = 1;
    for (const char *p = ext; p && *p && !ok;) {
        const char *e = strchr(p, ','); long n = e ? e - p : (long)strlen(p);
        if ((long)strlen(rp) >= n && !memcmp(rp, p, n) && (rp[n] == 0 || rp[n] == '/')) ok = 1;
        p = e ? e + 1 : 0;
    }
    if (!ok) { (void)cx_fmt(why, wl, "--cwd must be under .claude/worktrees/ or a --write-ext directory: %s; example: --cwd .claude/worktrees/v0.0.68", rp); return 2; }
    if (snprintf(canon, cap, "%s", rp) >= cap) { snprintf(why, wl, "--cwd too long"); return 2; }
    return 0;
}
static int dw_cat(DwSnap **a, int *na, DwSnap *b, int nb) {
    DwSnap *m = realloc(*a, (size_t)(*na + nb + 1) * sizeof **a);
    if (!m) { free(b); return 1; }
    if (nb && mm_copy(m + *na, (size_t)nb * sizeof *b, b, (size_t)nb * sizeof *b)) { free(b); return 1; }
    *a = m; *na += nb; free(b); return 0;
}
/* every regular file under an external directory, with the sha256 of its bytes; path is the absolute path */
static int dw_extdir(const char *dir, DwSnap **out, int *n, char *why, int wl) {
    char *v[] = {"find", (char *)dir, "-type", "f", "-print0", 0}; np_result r = {0}; char w2[256]; int cnt = 0, k = 0; DwSnap *s;
    *out = 0; *n = 0;
    if (np_run(v, 0, 0, 40, &r, w2, sizeof w2) || r.rc) { np_free(&r); (void)cx_fmt(why, wl, "cannot list %s", dir); return 2; }
    for (size_t i = 0; i < r.outn; i++) if (!r.out[i]) cnt++;
    s = calloc(cnt + 1, sizeof *s);
    if (!s) { np_free(&r); snprintf(why, wl, "out of memory"); return 2; }
    for (size_t i = 0; i < r.outn; k++) {
        size_t e = i; int rc; unsigned char *b = 0; int64_t bn = 0;
        while (e < r.outn && r.out[e]) e++;
        if (dt_cp(s[k].path, sizeof s[k].path, r.out + i, (long)(e - i)) || !dt_text_ok(s[k].path, sizeof s[k].path)) { free(s); np_free(&r); (void)cx_fmt(why, wl, "path too long or with control bytes under %s", dir); return 2; }
        rc = sy_read_file(s[k].path, &b, &bn, 1L << 27);
        if (rc || sy_sha256_hex(b ? (const void *)b : (const void *)"", (long)bn, s[k].sha)) (void)cx_fmt(s[k].sha, sizeof s[k].sha, "%s", rc == -ENOENT ? "-" : "?");
        free(b); i = e + 1;
    }
    np_free(&r); *out = s; *n = k; return 0;
}
/* dirty paths of root, of each work tree .claude/worktrees/NAME that a write entry names (paths prefixed so they
 * match the write entry), and the files of every ext directory (absolute paths) */
int dw_scan(const char *root, const char *write, const char *ext, DwSnap **out, int *n, char *why, int wl) {
    static const char pre[] = ".claude/worktrees/"; char seen[8][128]; int ns = 0, rc = dw_dirty(root, out, n, why, wl);
    for (const char *p = write; p && !rc;) {
        const char *e = strchr(p, ','); long len = e ? e - p : (long)strlen(p);
        if (len > (long)sizeof pre - 1 && !strncmp(p, pre, sizeof pre - 1)) {
            long k = sizeof pre - 1, m; char name[128], base[2048], px[256]; DwSnap *sub = 0; int sn = 0, dup = 0;
            while (k < len && p[k] != '/') k++;
            m = k - (long)(sizeof pre - 1);
            if (m > 0 && m < (long)sizeof name) {
                mm_copy(name, sizeof name, p + sizeof pre - 1, m); name[m] = 0;
                for (int i = 0; i < ns; i++) if (!strcmp(seen[i], name)) dup = 1;
                if (!dup && ns < 8 && snprintf(base, sizeof base, "%s/%s%s", root, pre, name) < (int)sizeof base && dw_isdir(base)) {
                    (void)cx_fmt(seen[ns++], sizeof seen[0], "%s", name);
                    rc = dw_dirty(base, &sub, &sn, why, wl);
                    if (!rc && snprintf(px, sizeof px, "%s%s/", pre, name) >= (int)sizeof px) { free(sub); snprintf(why, wl, "work tree name too long"); rc = 2; }
                    for (int i = 0; !rc && i < sn; i++) {
                        char q[512]; if (snprintf(q, sizeof q, "%s%s", px, sub[i].path) >= (int)sizeof q) { snprintf(why, wl, "work tree path too long"); rc = 2; break; }
                        (void)cx_fmt(sub[i].path, sizeof sub[i].path, "%s", q);
                    }
                    if (!rc && dw_cat(out, n, sub, sn)) { snprintf(why, wl, "out of memory"); rc = 2; }
                    else if (rc) free(sub);
                }
            }
        }
        p = e ? e + 1 : 0;
    }
    for (const char *p = ext; p && *p && !rc;) {
        const char *e = strchr(p, ','); long len = e ? e - p : (long)strlen(p); char d[1024]; DwSnap *sub = 0; int sn = 0;
        if (len >= (long)sizeof d) { snprintf(why, wl, "ext path too long"); rc = 2; break; }
        mm_copy(d, sizeof d, p, len); d[len] = 0;
        rc = dw_extdir(d, &sub, &sn, why, wl);
        if (!rc && dw_cat(out, n, sub, sn)) { snprintf(why, wl, "out of memory"); rc = 2; }
        p = e ? e + 1 : 0;
    }
    if (rc) { free(*out); *out = 0; *n = 0; }
    return rc;
}
static int dw_file(const char *dir, const char *id, char *p, int cap) { return snprintf(p, cap, "%s/work/%s.tsv", dir, id) >= cap; }
int dw_save(const char *dir, const DwTask *t, char *why, int wl) {
    char p[2048], d[2048], num[160]; sb *o = sb_new(); int bad;
    if (!o || dw_file(dir, t->id, p, sizeof p) || snprintf(d, sizeof d, "%s/work", dir) >= (int)sizeof d || sy_mkdir_all(d, 0700)
        || cx_fmt(num, sizeof num, "opened\t%ld\ndeadline\t%ld\ndone\t%ld\n", t->opened, t->deadline, t->done)) { sb_free(o); snprintf(why, wl, "work order save setup failed"); return 2; }
    bad = sb_puts(o, "id\t") || sb_puts(o, t->id) || sb_puts(o, "\ntitle\t") || sb_puts(o, t->title) || sb_puts(o, "\nwrite\t") || sb_puts(o, t->write)
       || sb_puts(o, "\nroot\t") || sb_puts(o, t->root) || sb_puts(o, "\nowner\t") || sb_puts(o, t->owner[0] ? t->owner : "-") || sb_puts(o, "\n") || sb_puts(o, num);
    if (!bad && t->ext[0]) bad = sb_puts(o, "ext\t") || sb_puts(o, t->ext) || sb_puts(o, "\n");
    if (!bad && t->cwd[0]) bad = sb_puts(o, "cwd\t") || sb_puts(o, t->cwd) || sb_puts(o, "\n");
    for (int i = 0; i < t->nacc && !bad; i++) bad = sb_puts(o, "accept\t") || sb_puts(o, t->acc[i]) || sb_puts(o, "\n");
    for (int i = 0; i < t->nsnap && !bad; i++) bad = sb_puts(o, "snap\t") || sb_puts(o, t->snap[i].sha) || sb_puts(o, "\t") || sb_puts(o, t->snap[i].path) || sb_puts(o, "\n");
    if (bad || !sb_cstr(o) || sy_write_atomic(p, sb_cstr(o), sb_len(o), 0600)) { sb_free(o); snprintf(why, wl, "write work order failed"); return 2; }
    sb_free(o); return 0;
}
/* rc 2 with "no such work order" when the file is missing */
int dw_load(const char *dir, const char *id, DwTask *t, char *why, int wl) {
    char p[2048]; unsigned char *b = 0; int64_t n = 0; long rows = 0; int rc, bad = 0;
    memset(t, 0, sizeof *t);
    if (!dw_id_ok(id) || dw_file(dir, id, p, sizeof p)) { snprintf(why, wl, "bad work order id"); return 2; }
    rc = sy_read_file(p, &b, &n, 1L << 24);
    if (rc) { if (rc == -ENOENT) (void)cx_fmt(why, wl, "no such work order %s", id); else (void)cx_fmt(why, wl, "read work order %s rc=%d", id, rc); return 2; }
    for (long i = 0; i < n; i++) if (b[i] == '\n') rows++;
    t->snap = calloc(rows + 1, sizeof *t->snap);
    if (!t->snap || !n || b[n - 1] != '\n') bad = 1;
    for (long i = 0; i < n && !bad;) {
        long e = i, k = i; const char *val; long vl;
        while (b[e] != '\n') e++;
        while (k < e && b[k] != '\t') k++;
        if (k >= e) { bad = 1; break; }
        val = (const char *)b + k + 1; vl = e - k - 1; b[k] = 0; b[e] = 0;
        if (!strcmp((char *)b + i, "id")) bad = dt_cp(t->id, sizeof t->id, val, vl);
        else if (!strcmp((char *)b + i, "title")) bad = dt_cp(t->title, sizeof t->title, val, vl);
        else if (!strcmp((char *)b + i, "write")) bad = dt_cp(t->write, sizeof t->write, val, vl);
        else if (!strcmp((char *)b + i, "root")) bad = dt_cp(t->root, sizeof t->root, val, vl);
        else if (!strcmp((char *)b + i, "ext")) bad = dt_cp(t->ext, sizeof t->ext, val, vl);
        else if (!strcmp((char *)b + i, "cwd")) bad = dt_cp(t->cwd, sizeof t->cwd, val, vl);
        else if (!strcmp((char *)b + i, "owner")) bad = dt_cp(t->owner, sizeof t->owner, val, vl);
        else if (!strcmp((char *)b + i, "opened")) t->opened = atol(val);
        else if (!strcmp((char *)b + i, "deadline")) t->deadline = atol(val);
        else if (!strcmp((char *)b + i, "done")) t->done = atol(val);
        else if (!strcmp((char *)b + i, "accept")) bad = t->nacc >= DW_ACC || dt_cp(t->acc[t->nacc], sizeof t->acc[0], val, vl) || !++t->nacc;
        else if (!strcmp((char *)b + i, "snap")) {
            const char *tab = strchr(val, '\t'); DwSnap *s = &t->snap[t->nsnap];
            bad = !tab || dt_cp(s->sha, sizeof s->sha, val, tab - val) || dt_cp(s->path, sizeof s->path, tab + 1, vl - (tab - val) - 1) || !++t->nsnap;
        } else bad = 1;
        i = e + 1;
    }
    free(b);
    if (bad || strcmp(t->id, id) || !t->write[0] || !t->root[0] || t->opened <= 0 || t->deadline < t->opened || !t->nacc) { dw_free(t); (void)cx_fmt(why, wl, "work order %s: malformed file", id); return 2; }
    if (!t->owner[0]) (void)cx_fmt(t->owner, sizeof t->owner, "-");   /* orders opened before the owner row */
    return 0;
}
/* --write entries: relative prefixes stay; an absolute entry under root/ becomes relative (root itself and outside entries refused) */
int dw_write_norm(const char *w, const char *root, char *out, int cap, char *why, int wl) {
    long used = 0, rl = (long)strlen(root);
    out[0] = 0;
    for (const char *p = w; p;) {
        const char *e = strchr(p, ','); long n = e ? e - p : (long)strlen(p); const char *s = p; int w2;
        if (n > 0 && p[0] == '/') {
            if (n > rl + 1 && !memcmp(p, root, rl) && p[rl] == '/') { s = p + rl + 1; n -= rl + 1; }
            else { (void)cx_fmt(why, wl, "bad --write entry: absolute path must be inside the repo root %s; example: --write tools/foo.cx,tools/bar/ or --write %s/tools/foo.cx", root, root); return 2; }
        }
        w2 = snprintf(out + used, cap - used, "%s%.*s", used ? "," : "", (int)n, s);
        if (w2 >= cap - used) { snprintf(why, wl, "oversized --write"); return 2; }
        used += w2; p = e ? e + 1 : 0;
    }
    return 0;
}
/* rc 1 when a work order with this id exists and is not done; a done one is replaced */
int dw_open(const char *dir, const char *id, const char *title, const char *write0, const char *const *acc, int nacc, long deadline_min, const char *root, const char *ext, const char *cwd0, long now, char *why, int wl) {
    DwTask t, old; int lk, rc; char p[2048], row[80], wn[1024], cw[1100]; const char *write = write0, *cwd = cwd0;
    memset(&t, 0, sizeof t);
    if (strcmp(write0, "-") && dt_text_ok(write0, 1024) && !strstr(write0, "..")) { if (dw_write_norm(write0, root, wn, sizeof wn, why, wl)) return 2; write = wn; }
    if (cwd0 && cwd0[0] && cwd0[0] != '/' && !strstr(cwd0, "..") && snprintf(cw, sizeof cw, "%s/%s", root, cwd0) < (int)sizeof cw) cwd = cw;
    if (!dw_id_ok(id)) { snprintf(why, wl, "bad --id (no blank, comma, slash or dot, under 64 bytes)"); return 2; }
    if (!dt_text_ok(title, 256)) { snprintf(why, wl, "bad --title"); return 2; }
    if (strcmp(write, "-") && !dt_domain_ok(write)) { snprintf(why, wl, "bad --write: need comma-joined repo-relative prefixes without blanks or ..; example: --write tools/foo.cx,tools/bar/ (an absolute path under the repo root is also accepted)"); return 2; }
    if (nacc < 1 || nacc > DW_ACC) { (void)cx_fmt(why, wl, "need 1 to %d --accept commands", DW_ACC); return 2; }
    for (int i = 0; i < nacc; i++) if (!dt_text_ok(acc[i], sizeof t.acc[0])) { (void)cx_fmt(why, wl, "bad --accept number %d (empty, too long or control bytes)", i + 1); return 2; }
    if (deadline_min < 1 || deadline_min > 525600) { snprintf(why, wl, "bad --deadline-min"); return 2; }
    if (!dt_text_ok(root, sizeof t.root) || root[0] != '/') { snprintf(why, wl, "bad root"); return 2; }
    if (ext && ext[0] && dw_ext_ok(ext, t.ext, sizeof t.ext, why, wl)) return 2;
    if (!strcmp(write, "-") && !t.ext[0]) { snprintf(why, wl, "--write - needs --write-ext"); return 2; }
    if (cwd && cwd[0] && dw_cwd_ok(cwd, root, t.ext, t.cwd, sizeof t.cwd, why, wl)) return 2;
    if ((lk = dt_lock(dir)) < 0) { (void)cx_fmt(why, wl, "cannot lock %s", dir); return 2; }
    rc = dw_load(dir, id, &old, why, wl);
    if (!rc) { int live = !old.done; dw_free(&old); if (live) { dt_unlock(lk); (void)cx_fmt(why, wl, "work order %s is already open", id); return 1; } }
    else if (!strstr(why, "no such work order")) { dt_unlock(lk); return 2; }
    (void)cx_fmt(t.id, sizeof t.id, "%s", id); (void)cx_fmt(t.title, sizeof t.title, "%s", title); (void)cx_fmt(t.write, sizeof t.write, "%s", write); (void)cx_fmt(t.root, sizeof t.root, "%s", root);
    for (int i = 0; i < nacc; i++) (void)cx_fmt(t.acc[i], sizeof t.acc[0], "%s", acc[i]);
    t.nacc = nacc; t.opened = now; t.deadline = now + deadline_min * 60;
    {   const char *ow = getenv("DEVSVC_OWNER"); (void)cx_fmt(t.owner, sizeof t.owner, "%s", ow && dt_name_ok(ow, 64) ? ow : "-");   }
    rc = dw_scan(root, write, t.ext, &t.snap, &t.nsnap, why, wl);
    if (!rc) rc = dw_save(dir, &t, why, wl);
    if (!rc && (snprintf(p, sizeof p, "%s/work/index.tsv", dir) >= (int)sizeof p || sy_append_file(p, row, snprintf(row, sizeof row, "%s\n", id), 0600))) { snprintf(why, wl, "append work index failed"); rc = 2; }
    if (!rc) rc = dt_event(dir, id, "task.open", t.owner, now, why, wl);
    dw_free(&t); dt_unlock(lk); return rc;
}
/* 1 when entry (n bytes) is exactly one of the comma-joined entries of list */
static int dw_has(const char *list, const char *entry, long n) {
    for (const char *p = list; p && *p;) {
        const char *e = strchr(p, ','); long m = e ? e - p : (long)strlen(p);
        if (m == n && !memcmp(p, entry, n)) return 1;
        p = e ? e + 1 : 0;
    }
    return 0;
}
/* new entries of src (comma-joined) that list lacks, appended to add (comma-joined); 0 ok, 1 when add overflows */
static int dw_fresh(const char *src, const char *list, char *add, int cap) {
    for (const char *p = src; p && *p;) {
        const char *e = strchr(p, ','); long n = e ? e - p : (long)strlen(p);
        if (n > 0 && !dw_has(list, p, n) && !dw_has(add, p, n)) { long used = (long)strlen(add); int w = snprintf(add + used, cap - used, "%s%.*s", used ? "," : "", (int)n, p); if (w >= cap - used) return 1; }
        p = e ? e + 1 : 0;
    }
    return 0;
}
/* task amend: append write entries (write0, repo-relative or absolute under the root) and external directories (ext0) to an open
 * order; add only. The new paths are snapshotted at their current content, so changes made before the amend are not reported
 * as the order's own outside changes. added gets "write=..;ext=.." of what was actually new (empty when nothing: idempotent,
 * no event). rc 2 for bad input and for a done order. Event task.amend carries the owner and the added items. */
int dw_amend(const char *dir, const char *id, const char *write0, const char *ext0, long now, char *added, int acap, char *why, int wl) {
    DwTask t; int lk, rc; char wn[1024] = "", canon[1024] = "", addw[1024] = "", adde[1024] = "", det[1500]; DwSnap *cur = 0; int n = 0; const char *ow;
    added[0] = 0;
    if (!dw_id_ok(id)) { snprintf(why, wl, "bad work order id"); return 2; }
    if ((!write0 || !*write0) && (!ext0 || !*ext0)) { snprintf(why, wl, "task amend needs --write or --write-ext"); return 2; }
    if ((lk = dt_lock(dir)) < 0) { (void)cx_fmt(why, wl, "cannot lock %s", dir); return 2; }
    if ((rc = dw_load(dir, id, &t, why, wl))) { dt_unlock(lk); return rc; }
    if (t.done) { (void)cx_fmt(why, wl, "work order %s is already done; amend refused", id); rc = 2; goto out; }
    if (write0 && *write0) {
        if (!dt_text_ok(write0, 1024) || strstr(write0, "..")) { snprintf(why, wl, "bad --write"); rc = 2; goto out; }
        if (dw_write_norm(write0, t.root, wn, sizeof wn, why, wl)) { rc = 2; goto out; }
        if (!dt_domain_ok(wn)) { snprintf(why, wl, "bad --write: need comma-joined repo-relative prefixes without blanks or ..; example: --write tools/foo.cx,tools/bar/"); rc = 2; goto out; }
    }
    if (ext0 && *ext0 && dw_ext_ok(ext0, canon, sizeof canon, why, wl)) { rc = 2; goto out; }
    if (dw_fresh(wn, t.write, addw, sizeof addw) || dw_fresh(canon, t.ext, adde, sizeof adde)) { snprintf(why, wl, "oversized amend"); rc = 2; goto out; }
    if (!addw[0] && !adde[0]) goto out;
    if (strlen(t.write) + strlen(addw) + 2 > sizeof t.write || strlen(t.ext) + strlen(adde) + 2 > sizeof t.ext) { snprintf(why, wl, "write domain would exceed its size limit"); rc = 2; goto out; }
    if (cx_fmt(det, sizeof det, "add_write=%s;add_ext=%s", addw[0] ? addw : "-", adde[0] ? adde : "-") || cx_fmt(added, acap, "write=%s;ext=%s", addw[0] ? addw : "-", adde[0] ? adde : "-")) { snprintf(why, wl, "amend text too long"); rc = 2; goto out; }
    if (addw[0]) { int w = !strcmp(t.write, "-") ? snprintf(t.write, sizeof t.write, "%s", addw) : snprintf(t.write + strlen(t.write), sizeof t.write - strlen(t.write), ",%s", addw); if (w < 0 || w >= (int)sizeof t.write) { snprintf(why, wl, "oversized --write"); rc = 2; goto out; } }
    if (adde[0]) { int w = snprintf(t.ext + strlen(t.ext), sizeof t.ext - strlen(t.ext), "%s%s", t.ext[0] ? "," : "", adde); if (w < 0 || w >= (int)sizeof t.ext) { snprintf(why, wl, "oversized --write-ext"); rc = 2; goto out; } }
    rc = dw_scan(t.root, addw, adde, &cur, &n, why, wl);
    if (rc) goto out;
    {   DwSnap *m = realloc(t.snap, (size_t)(t.nsnap + n + 1) * sizeof *m);
        if (!m) { snprintf(why, wl, "out of memory"); rc = 2; goto out; }
        t.snap = m;
        for (int i = 0; i < n; i++) {
            int k, hit = cur[i].path[0] == '/' || (addw[0] && dw_in(addw, cur[i].path));
            if (!hit) continue;
            for (k = 0; k < t.nsnap && strcmp(t.snap[k].path, cur[i].path); k++) {}
            if (k == t.nsnap) t.nsnap++;
            t.snap[k] = cur[i];
        }
    }
    ow = getenv("DEVSVC_OWNER");
    rc = dw_save(dir, &t, why, wl);
    if (!rc) rc = dt_event_d(dir, id, "task.amend", ow && dt_name_ok(ow, 64) ? ow : t.owner, det, now, why, wl);
out:
    free(cur); dw_free(&t); dt_unlock(lk); return rc;
}
/* devsvc events file: $DEVTASK_EVENTS, else $UNISACC_DEVSVC_DIR/events.tsv, else
 * $HOME/.cache/unisacc/devsvc/<first 16 hex of sha256(absolute git common dir)>/events.tsv (devsvc-core.cx header) */
static int dw_evpath(const char *root, char *p, int cap) {
    const char *e = getenv("DEVTASK_EVENTS"), *d = getenv("UNISACC_DEVSVC_DIR"), *home = getenv("HOME");
    char *v[] = {"git", "-C", (char *)root, "rev-parse", "--path-format=absolute", "--git-common-dir", 0}; np_result r = {0}; char w2[256], hx[65]; long n;
    if (e && *e) return snprintf(p, cap, "%s", e) >= cap;
    if (d && *d) return snprintf(p, cap, "%s/events.tsv", d) >= cap;
    const char *pb = getenv("DEVSVC_HOME");
    if (!pb || !*pb) pb = getenv("DV_PIN_DIR");
    if (!home || np_run(v, 0, 0, 15, &r, w2, sizeof w2) || r.rc || !r.out) { np_free(&r); return 1; }
    n = (long)r.outn; while (n > 0 && (r.out[n - 1] == '\n' || r.out[n - 1] == '\r')) n--;
    if (memcmp(r.out + n - 5, "/.git", 5) == 0) n -= 5;
    if (sy_sha256_hex(r.out, n, hx)) { np_free(&r); return 1; }
    np_free(&r); hx[16] = 0;
    if (pb && *pb) return snprintf(p, cap, "%s/%s/events.tsv", pb, hx) >= cap;
    return snprintf(p, cap, "%s/.cache/unisacc/devsvc/%s/events.tsv", home, hx) >= cap;
}
/* 1 when the events file holds an f.edit/f.write row at or after since, by owner, for path, whose post-write sha is sha */
static int dw_ownwrite(const unsigned char *ev, long n, long since, const char *owner, const char *path, const char *sha) {
    char ko[96], kp[600], ks[80];
    if (snprintf(ko, sizeof ko, "\towner=%s\t", owner) >= (int)sizeof ko || snprintf(kp, sizeof kp, "\tpath=%s\t", path) >= (int)sizeof kp || snprintf(ks, sizeof ks, "\tsha=%s", sha) >= (int)sizeof ks) return 0;
    for (long s = 0, e; s < n; s = e + 1) {
        char row[2048]; long ts; const char *q;
        for (e = s; e < n && ev[e] != '\n'; e++) {}
        if (e - s >= (long)sizeof row || e - s < 4) continue;
        mm_copy(row, sizeof row, ev + s, e - s); row[e - s] = 0;
        if (strncmp(row, "EV\t", 3) || !(q = strchr(row + 3, '\t'))) continue;
        ts = atol(q + 1);
        if (ts < since || (!strstr(row, "\tf.edit\t") && !strstr(row, "\tf.write\t"))) continue;
        if (strstr(row, ko) && strstr(row, kp) && (q = strstr(row, ks)) && (q[strlen(ks)] == 0 || q[strlen(ks)] == '\t')) return 1;
    }
    return 0;
}
/* 1 when the work tree bytes of path equal the HEAD blob (dirty only by mode or index state) */
static int dw_eqhead(const char *root, const char *path) {
    char obj[600], *v[] = {"git", "-C", (char *)root, "diff", "--quiet", "HEAD", "--", (char *)path, 0}, *e[] = {"git", "-C", (char *)root, "cat-file", "-e", obj, 0}; np_result r = {0}; char w2[256]; int same;
    if (snprintf(obj, sizeof obj, "HEAD:%s", path) >= (int)sizeof obj) return 0;
    same = !np_run(e, 0, 0, 15, &r, w2, sizeof w2) && r.rc == 0; np_free(&r);   /* untracked paths are not in HEAD; git diff alone says quiet for them */
    if (same) { same = !np_run(v, 0, 0, 15, &r, w2, sizeof w2) && r.rc == 0; np_free(&r); }
    return same;
}
/* paths changed since open: rows appended to in (inside the write domain), out (outside it, produced by this
 * order's owner) and foreign (outside it, not attributable to the owner: INFO only, does not block done).
 * Outside paths whose bytes equal HEAD are skipped. With owner "-" every outside change counts as the owner's.
 * The owner's outside change is one with a devsvc f.edit/f.write event since open, by the owner, whose sha is the current one. */
int dw_diff(const DwTask *t, sb *in, sb *out, sb *foreign, int *nin, int *nout, int *nfor, char *why, int wl) {
    DwSnap *cur = 0; int n = 0, rc = dw_scan(t->root, t->write, t->ext, &cur, &n, why, wl), known = t->owner[0] && strcmp(t->owner, "-"); unsigned char *ev = 0; int64_t evn = 0; char evp[2048];
    *nin = 0; *nout = 0; *nfor = 0;
    if (rc) return rc;
    if (known && !dw_evpath(t->root, evp, sizeof evp)) { int er = sy_read_file(evp, &ev, &evn, 1L << 26); if (er) { free(ev); ev = 0; evn = 0; } }
    for (int i = 0; i < n && !rc; i++) {
        int same = 0, inside = cur[i].path[0] == '/' || dw_in(t->write, cur[i].path); sb *dst;
        for (int k = 0; k < t->nsnap && !same; k++) same = !strcmp(t->snap[k].path, cur[i].path) && !strcmp(t->snap[k].sha, cur[i].sha) && strcmp(cur[i].sha, "?");
        if (same) continue;
        if (!inside && dw_eqhead(t->root, cur[i].path)) continue;
        dst = inside ? in : !known || dw_ownwrite(ev, (long)evn, t->opened, t->owner, cur[i].path, cur[i].sha) ? out : foreign;
        if (sb_puts(dst, cur[i].path) || sb_puts(dst, "\n")) { snprintf(why, wl, "out of memory"); rc = 2; }
        if (dst == in) ++*nin; else if (dst == out) ++*nout; else ++*nfor;
    }
    free(ev); free(cur); return rc;
}
/* marks the work order done at now and appends the task.done row to task-events.tsv */
int dw_finish(const char *dir, DwTask *t, long now, char *why, int wl) {
    int lk = dt_lock(dir), rc;
    if (lk < 0) { (void)cx_fmt(why, wl, "cannot lock %s", dir); return 2; }
    t->done = now; rc = dw_save(dir, t, why, wl);
    if (!rc) rc = dt_event(dir, t->id, "task.done", "-", now, why, wl);
    dt_unlock(lk); return rc;
}

/* ---- acceptance memo (same work order, same input identity) ----
 * Input identity = sha256 over HEAD id and the (path, sha) of every dirty path inside the write domain.
 * DIR/work/ID.pass rows: idx TAB identity TAB command. A row is only honoured when identity and command text
 * both equal the current ones; it records a pass of that very run, never a conclusion for another identity. */
int dw_ident(const DwTask *t, char *out, int cap, char *why, int wl) {
    char *v[] = {"git", "-C", (char *)t->root, "rev-parse", "HEAD", 0}; np_result r = {0}; char w2[256]; DwSnap *s = 0; int n = 0; sb *b = sb_new();
    if (cap < 65 || !b) { sb_free(b); snprintf(why, wl, "ident setup failed"); return 2; }
    if (np_run(v, 0, 0, 15, &r, w2, sizeof w2) || r.rc) { np_free(&r); sb_free(b); snprintf(why, wl, "git rev-parse HEAD failed under %s", t->root); return 2; }
    (void)sb_puts(b, "head "); for (size_t i = 0; i < r.outn && r.out[i] != '\n'; i++) { char c[2] = {r.out[i], 0}; (void)sb_puts(b, c); } (void)sb_puts(b, "\n"); np_free(&r);
    if (dw_scan(t->root, t->write, t->ext, &s, &n, why, wl)) { sb_free(b); return 2; }
    /* every dirty path, not only the write domain: another window's uncommitted edit inside the
       acceptance closure must invalidate SKIP_PASSED (no cached verdicts) */
    for (int i = 0; i < n; i++) { (void)sb_puts(b, s[i].sha); (void)sb_puts(b, " "); (void)sb_puts(b, s[i].path); (void)sb_puts(b, "\n"); }
    free(s);
    if (!sb_cstr(b) || sy_sha256_hex(sb_cstr(b), sb_len(b), out)) { sb_free(b); snprintf(why, wl, "ident hash failed"); return 2; }
    sb_free(b); return 0;
}
/* ok[k] = 1 when acceptance k passed earlier at this identity; missing file = none */
void dw_pass_load(const char *dir, const DwTask *t, const char *ident, int *ok) {
    char p[2048]; unsigned char *b = 0; int64_t n = 0;
    for (int k = 0; k < DW_ACC; k++) ok[k] = 0;
    if (snprintf(p, sizeof p, "%s/work/%s.pass", dir, t->id) >= (int)sizeof p || sy_read_file(p, &b, &n, 1L << 20)) { free(b); return; }
    for (int64_t s = 0, e; s < n; s = e + 1) {
        char *l, *c1, *c2; int k;
        for (e = s; e < n && b[e] != '\n'; e++) {}
        if (e >= n) break;
        b[e] = 0; l = (char *)b + s; c1 = strchr(l, '\t'); c2 = c1 ? strchr(c1 + 1, '\t') : 0;
        if (!c2) continue;
        *c1 = 0; *c2 = 0; k = atoi(l);
        if (k >= 0 && k < t->nacc && !strcmp(c1 + 1, ident) && !strcmp(c2 + 1, t->acc[k])) ok[k] = 1;
    }
    free(b);
}
int dw_pass_save(const char *dir, const DwTask *t, const char *ident, const int *ok) {
    char p[2048], num[16]; sb *o = sb_new(); int bad = !o, rc;
    if (snprintf(p, sizeof p, "%s/work/%s.pass", dir, t->id) >= (int)sizeof p) bad = 1;
    for (int k = 0; k < t->nacc && !bad; k++) if (ok[k]) bad = cx_fmt(num, sizeof num, "%d", k) || sb_puts(o, num) || sb_puts(o, "\t") || sb_puts(o, ident) || sb_puts(o, "\t") || sb_puts(o, t->acc[k]) || sb_puts(o, "\n");
    rc = bad || !sb_cstr(o) ? 2 : sy_write_atomic(p, sb_cstr(o), sb_len(o), 0600);
    sb_free(o); return rc ? 2 : 0;
}
