static int as_bad(AsContext *c,const char *reason,const char *path){if(!c->failed)snprintf(c->why,sizeof c->why,"%s path=%.700s errno=%d",reason,path?path:"-",errno);c->failed=1;return -1;}
static int as_path(AsContext *c,char p[4400],const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);return n<0||n>=4400?as_bad(c,"path-bound",b):0;}
static int as_within(const char *p,const char *base){size_t n=strlen(base);return !strncmp(p,base,n)&&(!p[n]||p[n]=='/');}
