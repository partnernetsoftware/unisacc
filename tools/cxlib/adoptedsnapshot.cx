static int as_hash(AsContext *c,const void *bytes,size_t n,char h[65]){if(n<65536){cx_sha256_hex(bytes,n,h);return 0;}if(!c->sha_ready){char t[65];int rc=ks_sha256_hex("",0,t);if(rc||strcmp(t,"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"))return as_bad(c,"kernel-SHA-empty-selfcheck",0);rc=ks_sha256_hex("abc",3,t);if(rc||strcmp(t,"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"))return as_bad(c,"kernel-SHA-abc-selfcheck",0);c->sha_ready=1;}int rc=ks_sha256_hex(bytes,n,h);if(rc){char why[100];snprintf(why,sizeof why,"kernel-SHA-negative-rc=%d",rc);return as_bad(c,why,0);}return 0;}
static char *as_read(AsContext *c,const char *p,size_t *n,unsigned *mode){struct stat a,b;if(lstat(p,&a)){as_bad(c,errno==ENOENT?"file-ENOENT":"file-stat-error",p);return 0;}if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>268435456){as_bad(c,"bounded-regular-file-required",p);return 0;}int fd=open(p,O_RDONLY|O_NOFOLLOW|O_NONBLOCK|O_CLOEXEC);if(fd<0){as_bad(c,"file-open",p);return 0;}char *s=0;int bad=0;if(fstat(fd,&b)||!S_ISREG(b.st_mode)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size||a.st_mode!=b.st_mode){as_bad(c,"file-descriptor-identity",p);bad=1;goto done;}*n=(size_t)a.st_size;s=malloc(*n+1);if(!s){as_bad(c,"allocation",p);bad=1;goto done;}size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0){as_bad(c,"file-read-extent",p);bad=1;goto done;}at+=(size_t)z;}char x;ssize_t z;do{z=read(fd,&x,1);}while(z<0&&errno==EINTR);if(z||fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size||a.st_mode!=b.st_mode){as_bad(c,"file-changed-or-extra",p);bad=1;}
done:if(close(fd)){as_bad(c,"file-close",p);bad=1;}if(bad){free(s);return 0;}s[*n]=0;if(mode)*mode=(unsigned)a.st_mode&07777;c->reads++;return s;}
