#pragma unisa module adoptedsnapshot
#pragma unisa use netpack
#pragma unisa use kernelsha
/* Read-only single-endpoint adoption snapshot adapter for the ONE reviewed
 * controller source a546381b... / actual ELF 9457cd1e... pair. Context metadata
 * cannot nominate arbitrary code: the complete known context is parsed before
 * checking canonical Root/out controller role, ELF64/x64, X_OK and both pins.
 * --snapshot does not construct, pack, seal, or call the two-endpoint --verify.
 * Its complete origin107/34, NI, kernel and EXECUTED-pack controls remain in
 * that known native implementation. No inherited preparation status is green.
 * Caller supplies an independently ACTUALLY measured fresh current SID and an
 * outer process-tree watchdog; seconds is an additional inner bound (1..55).
 * Controller/reader code-cache provenance is unsigned input consistency, not
 * signatures, historical compilation proof, hermeticity, NN functional PASS,
 * original NN reconstruction or foreign-host qualification.
 * controller_bootstrap_* is the adopted controller's saved P53/record21704/
 * Source329 role. It is NOT the original NN-production epoch; the latter is
 * preserved separately in manifest-bound adopted-origin.tsv (447/e084).
 * Every call has private state and fresh before/after physical reads of the
 * four package core files and executable/source closure. >=64KiB uses AF_ALG
 * SHA256 with invocation-owned empty/abc selfchecks; small buffers use CX SHA.
 * Report identity fields alone enter stable witness. Full report hash, counts
 * and times are observations; timing is never a stable identity input.
 * Errors return -1 with why and all-zero out. Fork isolates dependency exits.
 * Only Linux/x86_64 LP64, single-threaded bounded callers are supported.
 */
typedef struct {
 char artifact[65],manifest[65],receipt[65],context[65],current_source[65],origin_source[65];
 char kernel_context[65],origin_spec[65],origin_verifier[65],origin_elf[65],origin_profile[65];
 char origin_execution_closure[65],origin_mapping[65],ni_witness[65],ni_module[65],netpack[65],kernelsha[65];
 char controller_source[65],controller_elf[65],controller_path[4096];
 char controller_bootstrap_path[4096],controller_bootstrap_artifact[65],controller_bootstrap_record[65];
 char reader_module[65],report_identity[65],report_observation[65],observed_files[65],witness[65];
 int jobs,models,origin_physical_reads,origin_executor_reads,origin_wrapper_reads,ni_physical_reads;
 int controller_endpoint_reads,controller_post_endpoint_reads,own_physical_reads;
 long long controller_endpoint_ns,origin_endpoint_ns,ni_ns,snapshot_body_ns,own_elapsed_ns;
} as_result;
typedef struct {char v[46][4400];} AsRows;
typedef struct {char root[4096],package[4096],out[4400],bound[4400],why[1200],context_sha[65];int failed,reads,sha_ready;AsRows *ctx;} AsContext;
typedef struct {char hash[27][65];np_buf manifest;} AsObserved;
