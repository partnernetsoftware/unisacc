 const char *os="source-package-adopted-origin-v1\n";if(as_bound_field(c,origin,os,"origin-spec",r->v[10])||as_bound_field(c,origin,os,"executing-verifier",r->v[11])||as_bound_field(c,origin,os,"executing-elf",r->v[12])||as_bound_field(c,origin,os,"execution-profile",r->v[13])||as_bound_field(c,origin,os,"execution-closure",r->v[14])||as_bound_field(c,origin,os,"mapping-witness",r->v[15])||as_bound_field(c,origin,os,"origin-source",r->v[6])||as_bound_field(c,origin,os,"physical-reads",r->v[25])||as_bound_field(c,origin,os,"execution-reads",r->v[26])||as_bound_field(c,origin,os,"wrapper-physical-reads",r->v[27])||as_bound_field(c,necessary,"source-package-adoption-NI-v1\n","witness",r->v[16])||as_bound_field(c,necessary,"source-package-adoption-NI-v1\n","verifier",r->v[17])||as_bound_field(c,necessary,"source-package-adoption-NI-v1\n","netpack",r->v[18])||as_bound_field(c,necessary,"source-package-adoption-NI-v1\n","kernelsha",r->v[19]))return -1;char value[4400];if(as_field(c,kernel->p,kernel->n,"","kernel-context",value)||strcmp(value,r->v[9]))return as_bad(c,"bound-kernel-report-context",0);
 long long count[10];for(int i=0;i<10;i++)if(as_number(c,r->v[25+i],&count[i],1))return -1;for(int i=0;i<6;i++)if(count[i]>2147483647LL)return as_bad(c,"snapshot-read-count-int-bound",as_report_keys[25+i]);if(count[9]<count[6]||count[6]<count[7]||count[6]<count[8])return as_bad(c,"snapshot-phase-time-order",0);
 strcpy(out->artifact,r->v[1]);strcpy(out->manifest,r->v[2]);strcpy(out->receipt,r->v[3]);strcpy(out->context,r->v[4]);strcpy(out->current_source,r->v[5]);strcpy(out->origin_source,r->v[6]);strcpy(out->kernel_context,r->v[9]);strcpy(out->origin_spec,r->v[10]);strcpy(out->origin_verifier,r->v[11]);strcpy(out->origin_elf,r->v[12]);strcpy(out->origin_profile,r->v[13]);strcpy(out->origin_execution_closure,r->v[14]);strcpy(out->origin_mapping,r->v[15]);strcpy(out->ni_witness,r->v[16]);strcpy(out->ni_module,r->v[17]);strcpy(out->netpack,r->v[18]);strcpy(out->kernelsha,r->v[19]);strcpy(out->controller_source,r->v[20]);strcpy(out->controller_elf,r->v[21]);strcpy(out->controller_path,c->ctx->v[22]);strcpy(out->controller_bootstrap_path,r->v[22]);strcpy(out->controller_bootstrap_artifact,r->v[23]);strcpy(out->controller_bootstrap_record,r->v[24]);strcpy(out->reader_module,before->hash[13]);out->jobs=107;out->models=34;out->origin_physical_reads=(int)count[0];out->origin_executor_reads=(int)count[1];out->origin_wrapper_reads=(int)count[2];out->ni_physical_reads=(int)count[3];out->controller_endpoint_reads=(int)count[4];out->controller_post_endpoint_reads=(int)count[5];out->controller_endpoint_ns=count[6];out->origin_endpoint_ns=count[7];out->ni_ns=count[8];out->snapshot_body_ns=count[9];np_puts(stable,"source-package-adoption-snapshot-v1\n");for(int i=0;i<25;i++){np_puts(stable,as_report_keys[i]);np_puts(stable,"\t");np_puts(stable,r->v[i]);np_puts(stable,"\n");}return as_hash(c,stable->p,stable->n,out->report_identity)||as_hash(c,raw->out,raw->outn,out->report_observation)?-1:0;
}
static int as_impl(const char *root,const char *package,const char *fresh,int seconds,as_result *out,char *why,size_t cap){AsContext c={0};AsObserved before={0},after={0};np_buf origin={0},necessary={0},kernel={0},stable={0},witness={0};np_result raw={0};as_result result={0};AsRows *report=0;int rc=-1;long long start=as_clock(&c);if(start<0)goto done;if(strlen(root)>=sizeof c.root||strlen(package)>=sizeof c.package){as_bad(&c,"root-package-path-bound",0);goto done;}strcpy(c.root,root);strcpy(c.package,package);if(as_canonical(&c,c.root,1)||as_canonical(&c,c.package,1)||as_path(&c,c.out,c.root,"out")||!as_within(c.package,c.out)||!strcmp(c.package,c.out)||as_path(&c,c.bound,c.root,"tools/bound")){as_bad(&c,"canonical-independent-Root-out-package-role",package);goto done;}c.ctx=calloc(1,sizeof *c.ctx);report=calloc(1,sizeof *report);if(!c.ctx||!report){as_bad(&c,"allocation",0);goto done;}if(as_context(&c,fresh)||as_observe(&c,&before,&origin,&necessary,&kernel))goto done;
 char time[16],message[1200];snprintf(time,sizeof time,"%d",seconds);char *v[]={c.bound,time,c.ctx->v[22],"--snapshot",c.root,c.package,0};char *env[]={"UNISACC_BOUND_CLEANUP_TRACE=","UNISACC_TIME_SCALE=1",0};int idle=seconds<=53?seconds+2:55;if(np_run(v,c.root,env,idle,&raw,message,sizeof message)){as_bad(&c,message,0);goto done;}if(as_report(&c,&raw,fresh,&before,&origin,&necessary,&kernel,report,&result,&stable)||as_observe(&c,&after,0,0,0))goto done;if(before.manifest.n!=after.manifest.n||memcmp(before.manifest.p,after.manifest.p,before.manifest.n)){as_bad(&c,"actual-package-code-or-source-changed-around-snapshot",0);goto done;}if(as_hash(&c,before.manifest.p,before.manifest.n,result.observed_files))goto done;np_puts(&witness,"adopted-single-snapshot-wrapper-witness-v1\n");np_puts(&witness,c.root);np_puts(&witness,"\n");np_puts(&witness,c.package);np_puts(&witness,"\n");np_puts(&witness,result.reader_module);np_puts(&witness,"\n");np_puts(&witness,result.controller_source);np_puts(&witness,"\n");np_puts(&witness,result.controller_elf);np_puts(&witness,"\n");np_puts(&witness,result.report_identity);np_puts(&witness,"\n");np_puts(&witness,result.observed_files);np_puts(&witness,"\n");if(as_hash(&c,witness.p,witness.n,result.witness))goto done;long long end=as_clock(&c);if(end<start){as_bad(&c,"wrapper-monotonic-clock-order",0);goto done;}result.own_physical_reads=c.reads;result.own_elapsed_ns=end-start;*out=result;rc=0;
done:if(rc)snprintf(why,cap,"%s",c.why[0]?c.why:"adopted-snapshot-reader-refused");free(c.ctx);free(report);free(before.manifest.p);free(after.manifest.p);free(origin.p);free(necessary.p);free(kernel.p);free(stable.p);free(witness.p);np_free(&raw);return rc;}
typedef struct {int rc;as_result result;char why[1200];} AsPacket;
static int as_platform_snapshot(const char *root,const char *package,const char *fresh,int seconds,as_result *out,char *why,size_t cap){if(out)memset(out,0,sizeof *out);if(why&&cap)why[0]=0;
#if !defined(__linux__) || !defined(__x86_64__)
 if(why&&cap)snprintf(why,cap,"adopted-snapshot-requires-Linux-x86_64-LP64");return -1;
#endif
 if(!root||!package||!fresh||!out||!why||!cap||root[0]!='/'||package[0]!='/'||strpbrk(root,"\r\n\t")||strpbrk(package,"\r\n\t")||!as_hex(fresh)||seconds<1||seconds>55||sizeof(long)!=8){if(why&&cap)snprintf(why,cap,"adopted-snapshot-arguments");return -1;}int channel[2];if(pipe(channel)){snprintf(why,cap,"adopted-snapshot-pipe errno=%d",errno);return -1;}if(fcntl(channel[1],F_SETFD,FD_CLOEXEC)<0){int e=errno;close(channel[0]);close(channel[1]);snprintf(why,cap,"adopted-snapshot-pipe-cloexec errno=%d",e);return -1;}pid_t pid=fork();if(pid<0){int e=errno;close(channel[0]);close(channel[1]);snprintf(why,cap,"adopted-snapshot-fork errno=%d",e);return -1;}if(!pid){close(channel[0]);if(dup2(channel[1],1)<0||dup2(channel[1],2)<0)_exit(2);AsPacket p={0};p.rc=as_impl(root,package,fresh,seconds,&p.result,p.why,sizeof p.why);size_t at=0;while(at<sizeof p){ssize_t n=write(channel[1],(char *)&p+at,sizeof p-at);if(n<0&&errno==EINTR)continue;if(n<=0)_exit(2);at+=(size_t)n;}close(channel[1]);_exit(0);}close(channel[1]);AsPacket p={0};size_t at=0;int bad=0;while(at<sizeof p){ssize_t n=read(channel[0],(char *)&p+at,sizeof p-at);if(n<0&&errno==EINTR)continue;if(n<0){bad=1;break;}if(!n)break;at+=(size_t)n;}if(close(channel[0]))bad=1;int status=0;pid_t got;do{got=waitpid(pid,&status,0);}while(got<0&&errno==EINTR);if(bad||at!=sizeof p||got!=pid||!WIFEXITED(status)||WEXITSTATUS(status)){snprintf(why,cap,"adopted-snapshot-reader-failed bytes=%lu status=%d",(unsigned long)at,status);return -1;}if(p.rc){snprintf(why,cap,"%s",p.why[0]?p.why:"adopted-snapshot-reader-refused");return -1;}if(p.result.jobs!=107||p.result.models!=34||p.result.origin_physical_reads!=1004||!as_hex(p.result.witness)){snprintf(why,cap,"adopted-snapshot-result-shape");return -1;}*out=p.result;return 0;}
/* Unconditional export: platform preprocessing stays private for CXIF. */
int as_verify_snapshot(const char *root,const char *package,const char *fresh_current_sid,int seconds,as_result *out,char *why,size_t cap){return as_platform_snapshot(root,package,fresh_current_sid,seconds,out,why,cap);}
