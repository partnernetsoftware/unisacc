#pragma unisa module genkit
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use text.text
#pragma unisa use cxlib.awpath
/* genkit -- the shared skeleton of a "fact table -> generator -> table" tool (prefix gk_).
 *
 *   int gk_args(const char *tool, int argc, char **argv, int *check, const char **root)
 *     argv[1] is --check or --write; then an optional ROOT (default ".") and an optional
 *     --only NAME[,NAME...] in any order.  On a usage error it prints
 *     "TOOL: usage --write|--check [ROOT]" on stderr and returns 2; else 0.
 *     *check is 1 for --check, 0 for --write.
 *   int gk_only(const char *name)
 *     1 when no --only was given or NAME is in its comma list; 0 otherwise.  A generator with
 *     several outputs skips the ones not selected (and does not count them).
 *   int gk_emit(const char *tool, int check, const char *path, const void *buf, long n, const char *detail)
 *     --check: compares the bytes on disk with BUF; equal returns 0; different or unreadable prints
 *       "TOOL: DIFF" (or "TOOL: DIFF DETAIL" when DETAIL is non-null) on stderr and returns 1.
 *     --write: publishes BUF atomically (sibling temporary, fsync, rename; on failure PATH is
 *       untouched and no temporary is left) and returns 0, or 2 on failure (nothing printed: the
 *       caller keeps its own refusal text).
 *   int gk_devmeta(int check, const char *name, const void *buf, long n)
 *     the double-write copy of a build/ table under the dev metadata directory (cxlib/awpath
 *     awp_devmeta, root "."): --write publishes it atomically (directory made when missing);
 *     --check ignores a missing local mirror, and prints "MIRROR_STALE<TAB>PATH<TAB>hint=refresh with --write"
 *     when an existing mirror differs (never failing --check rc or incrementing gk_drift).
 *     2 on a bad name or a failed write.
 *   int gk_files(void), int gk_drift(void)
 *     outputs handled and outputs drifted so far (gk_emit and gk_devmeta both count).
 *   int gk_summary(const char *label, int check)
 *     prints "LABEL<TAB>status=CHECK|WRITE<TAB>files=N<TAB>drift=M" on stdout; returns 1 when
 *     drift > 0, else 0 (a ready main() return value).
 * No hidden policy: the messages are the byte-compatible ones the existing generators print, and
 * tools/derive.cx keeps reading only the exit code (0 clean, 1 drift, 2 refused). */

static const char *gk_only_list;
static int gk_nfiles;
static int gk_ndrift;

int gk_args(const char *tool, int argc, char **argv, int *check, const char **root) {
    int i, haveroot = 0;
    gk_only_list = 0;
    if (!check || !root) return 2;
    *root = ".";
    if (argc < 2 || !argv[1] || (!tx_eqz(argv[1], "--write") && !tx_eqz(argv[1], "--check"))) goto usage;
    *check = tx_eqz(argv[1], "--check");
    for (i = 2; i < argc; i++) {
        if (tx_eqz(argv[i], "--only")) {
            if (i + 1 >= argc || gk_only_list || !argv[i + 1][0]) goto usage;
            gk_only_list = argv[++i];
        } else if (argv[i][0] == '-' || haveroot) {
            goto usage;
        } else {
            *root = argv[i];
            haveroot = 1;
        }
    }
    return 0;
usage:
    sy_eprintf("%s: usage --write|--check [ROOT]\n", tool);
    return 2;
}

int gk_only(const char *name) {
    const char *p = gk_only_list;
    long k, nl;
    if (!p) return 1;
    if (!name) return 0;
    for (nl = 0; name[nl]; nl++) {}
    while (*p) {
        for (k = 0; p[k] && p[k] != ','; k++) {}
        if (k > 0 && nl == k && mm_same(p, name, k)) return 1;
        p += k;
        if (*p == ',') p++;
    }
    return 0;
}

static int gk_same_file(const char *path, const void *buf, long n) {
    size_t z = 0;
    char *old = cx_read(path, &z);
    int same = old && (long)z == n && (n == 0 || mm_same(old, buf, n));
    if (old) mm_free(old);
    return same;
}

int gk_emit(const char *tool, int check, const char *path, const void *buf, long n, const char *detail) {
    if (!path || n < 0 || (n > 0 && !buf)) return 2;
    gk_nfiles++;
    if (check) {
        if (gk_same_file(path, buf, n)) return 0;
        gk_ndrift++;
        if (detail) sy_eprintf("%s: DIFF %s\n", tool, detail);
        else sy_eprintf("%s: DIFF\n", tool);
        return 1;
    }
    if (sy_write_atomic(path, buf, (int64_t)n, 0644)) return 2;
    return 0;
}

int gk_devmeta(int check, const char *name, const void *buf, long n) {
    char dm[1024];
    if (n < 0 || (n > 0 && !buf)) return 2;
    if (awp_devmeta(".", name, !check, dm, sizeof dm)) return 2;
    gk_nfiles++;
    if (check) {
        size_t z = 0;
        char *old = cx_read(dm, &z);
        if (!old) return 0;
        if ((long)z != n || (n > 0 && !mm_same(old, buf, n))) {
            sy_printf("MIRROR_STALE\t%s\thint=refresh with --write\n", dm);
        }
        mm_free(old);
        return 0;
    }
    if (sy_write_atomic(dm, buf, (int64_t)n, 0644)) return 2;
    return 0;
}

int gk_files(void) { return gk_nfiles; }
int gk_drift(void) { return gk_ndrift; }

int gk_summary(const char *label, int check) {
    sy_printf("%s\tstatus=%s\tfiles=%d\tdrift=%d\n", label, check ? "CHECK" : "WRITE", gk_nfiles, gk_ndrift);
    return gk_ndrift ? 1 : 0;
}
