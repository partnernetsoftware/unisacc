#pragma unisa module materialconsumers
/* Registry facts only. No execution or cached test verdicts. The returned IDs
 * remain owned by this module until the next load. */
static char *mc_facts;
static char **mc_ids;
static int mc_size;
int mc_load(const char *family) {
 size_t len=0;free(mc_facts);free(mc_ids);mc_facts=0;mc_ids=0;mc_size=0;
 if(!family||!*family||strchr(family,':')||strchr(family,','))return -1;
 mc_facts=cx_read("tests/batches.tsv",&len);if(!mc_facts||!len||memchr(mc_facts,0,len))return -1;
 size_t familylen=strlen(family);
 for(char *row=mc_facts;row&&*row;){char *next=strchr(row,'\n');if(next)*next++=0;
  if(*row&&*row!='#'&&strncmp(row,"id\t",3)){char *cols[8];cols[0]=row;int count=1;
   for(char *p=row;*p&&count<8;p++)if(*p=='\t'){*p=0;cols[count++]=p+1;}
   if(count!=8)return -1;char *end=strchr(cols[7],'\t');if(end)*end=0;
   int consumer=0;for(char *mat=cols[7];mat&&*mat;){char *comma=strchr(mat,',');if(comma)*comma++=0;
    if(!strncmp(mat,family,familylen)&&(mat[familylen]==0||mat[familylen]==':'))consumer=1;mat=comma;}
   if(consumer&&!strcmp(cols[1],"IMPLEMENTED")){
    for(int i=0;i<mc_size;i++)if(!strcmp(mc_ids[i],cols[0]))return -1;
    char **grown=realloc(mc_ids,(mc_size+1)*sizeof *mc_ids);if(!grown)return -1;
    mc_ids=grown;mc_ids[mc_size++]=cols[0];
   }
  }row=next;
 }
 return mc_size;
}
const char *mc_id(int index) {return index>=0&&index<mc_size?mc_ids[index]:0;}
