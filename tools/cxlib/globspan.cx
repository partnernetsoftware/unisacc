#pragma unisa module globspan

/* The last star can absorb one more byte on a mismatch. No call stack or
 * allocation depends on the number of stars. Slashes are ordinary bytes. */
int glob_span_mode(const char *pattern, long pn, const char *text, long tn, int question) {
    long p = 0, t = 0, rest = -1, consumed = 0;
    if (pn < 0 || tn < 0 || (!pattern && pn) || (!text && tn)) return 0;
    while (t < tn) {
        if (p < pn && pattern[p] == '*') {
            rest = ++p;
            consumed = t;
        } else if (p < pn && (pattern[p] == text[t] || (question && pattern[p] == '?'))) {
            p++; t++;
        } else if (rest >= 0) {
            p = rest;
            t = ++consumed;
        } else return 0;
    }
    while (p < pn && pattern[p] == '*') p++;
    return p == pn;
}

int glob_span(const char *pattern, long pn, const char *text, long tn) {
    return glob_span_mode(pattern, pn, text, tn, 0);
}
