#pragma unisa module loadavg
#pragma unisa use sys.fs
#pragma unisa use mem.bytes
/* One-minute load average, for records only (dvqualify evidence, dvledger rows).  It must not
 * gate, delay or refuse anything: the owner retired load gates 2026-11-20; fixed --jobs/--par
 * bounds are the only concurrency limits.  tool_load1() reads the first column of /proc/loadavg;
 * when it cannot be read it returns TOOL_LOAD1_UNREADABLE (99) as a visible record value.
 * Not named cx_load1: the cx_ prefix is reserved for the prelude (a product input).
 * Check: tools/check-loadavg.cx. */
#define TOOL_LOAD1_UNREADABLE 99.0

double tool_load1_at(const char *path) {
    unsigned char *b = 0; int64_t n = 0; double v = TOOL_LOAD1_UNREADABLE;
    if (!sy_read_file(path, &b, &n, 4096) && b) { char t[64]; long k = n < 63 ? n : 63; mm_copy(t, sizeof t, b, k); t[k] = 0; v = atof(t); }
    free(b); return v;
}
double tool_load1(void) { return tool_load1_at("/proc/loadavg"); }
