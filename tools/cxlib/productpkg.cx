#pragma unisa module productpkg
#pragma unisa use sys.fs
#pragma unisa use packagefooter
/* cxlib/productpkg: which file actually carries the P3 package of an installed product, and
   what it takes to copy that product somewhere else.
 *
 * Two layouts go by the name `unisacc.com` on disk:
 *
 *   PP_APE    one self-contained file: the loader, the package and a UNIPKG1 footer at its end.
 *   PP_SPLIT  a thin launcher plus a directory beside it:
 *               unisacc.com            launcher (32-bit shell text, execs entry.elf)
 *               unisacc.com.dev/entry.elf        the loader
 *               unisacc.com.dev/p3-package.bin   the package
 *               ape-receipt.txt        NOT_RELEASE + dev-lnx-only + one sha256 per member
 *
 * Checks kept reading `unisacc.com` and locating a footer inside it, which is true only for
 * PP_APE; under PP_SPLIT they got the launcher text and failed with "no package footer" and
 * friends. The 2026-11-02 wave paid for that twice: eight checks, and one more that copied the
 * launcher alone and then could not find its entry. Ask here instead of reading the product:
 * the answer is a path, and a check that needs a self-contained APE says so by name.
 *
 *   pp_layout(ROOT)                      PP_APE, PP_SPLIT, or -ENOENT when ROOT holds neither
 *   pp_layout_name(V)                    "ape" / "split" / "none"
 *   pp_package_path(ROOT, out, cap)      0, or -ENOENT / -ENAMETOOLONG
 *   pp_read_package(ROOT, &n)            malloc'd bytes of that file, caller frees; 0 on failure
 *   pp_copy_product(ROOT, DEST)          0, or -1: DEST gets the launcher and, under PP_SPLIT,
 *                                        every member the receipt names (or the two default
 *                                        names when there is no receipt)
 *
 * The receipt is the product's own list of what it consists of, so a layout that grows needs no
 * change here: it grows in the receipt. */
#define PP_APE 0
#define PP_SPLIT 1

static const char pp_dev_dir[] = "unisacc.com.dev";
static const char pp_pkg_name[] = "p3-package.bin";

/* ROOT/NAME into DST; 0, or -ENAMETOOLONG. */
static int pp_join(const char *root, const char *name, char *dst, int cap) {
    long rl = 0, nl = 0, i;
    if (!root || !name || !dst || cap < 2) return -ENAMETOOLONG;
    while (root[rl]) rl++;
    while (name[nl]) nl++;
    if (rl + 1 + nl + 1 > (long)cap) return -ENAMETOOLONG;
    for (i = 0; i < rl; i++) dst[i] = root[i];
    dst[rl] = '/';
    for (i = 0; i <= nl; i++) dst[rl + 1 + i] = name[i];
    return 0;
}

/* ROOT/A/B into DST. */
static int pp_join2(const char *root, const char *a, const char *b, char *dst, int cap) {
    char mid[4400];
    if (pp_join(root, a, mid, (int)sizeof mid)) return -ENAMETOOLONG;
    return pp_join(mid, b, dst, cap);
}

const char *pp_layout_name(int v) {
    if (v == PP_APE) return "ape";
    if (v == PP_SPLIT) return "split";
    return "none";
}

/* PP_APE when the single file at PATH carries a UNIPKG1 footer, -ENOENT otherwise. */
int pp_layout_of_file(const char *path) {
    size_t n = 0;
    unsigned char *b;
    PackageFooter f;
    int v = -ENOENT;
    if (!path || sy_exists(path) != 1) return -ENOENT;
    b = (unsigned char *)cx_read(path, &n);
    if (!b) return -ENOENT;
    if (n && n <= 2147483647UL && packagefooter_locate_bytes(b, (long)n, &f)) v = PP_APE;
    free(b);
    return v;
}

/* PP_SPLIT when ROOT/unisacc.com.dev/p3-package.bin exists; PP_APE when ROOT/unisacc.com exists
   and ends with a UNIPKG1 footer; -ENOENT otherwise. */
int pp_layout(const char *root) {
    char p[4400];
    if (pp_join2(root, pp_dev_dir, pp_pkg_name, p, (int)sizeof p)) return -ENAMETOOLONG;
    if (sy_exists(p) == 1) return PP_SPLIT;
    if (pp_join(root, "unisacc.com", p, (int)sizeof p)) return -ENAMETOOLONG;
    return pp_layout_of_file(p);
}

/* The file that holds the P3 package. */
int pp_package_path(const char *root, char *out, int cap) {
    int l = pp_layout(root);
    if (l == PP_SPLIT) return pp_join2(root, pp_dev_dir, pp_pkg_name, out, cap);
    if (l == PP_APE) return pp_join(root, "unisacc.com", out, cap);
    return l;
}

char *pp_read_package(const char *root, size_t *n) {
    char p[4400];
    if (n) *n = 0;
    if (pp_package_path(root, p, (int)sizeof p)) return 0;
    return cx_read(p, n);
}

/* ---- product identity -------------------------------------------------------------------
 *
 * "Unchanged" must mean the whole product, not one file. Under PP_SPLIT the launcher is 624
 * bytes and the package is megabytes, so hashing the launcher alone lets a batch rewrite the
 * package and still look unchanged -- a gap found while closing the 2026-11-02 structural
 * failures (plans/product-identity-2026-11-02.md).
 *
 * PP_APE degenerates to sha256(whole file), exactly what the old guard computed, so old
 * evidence is not reinterpreted. PP_SPLIT hashes the member set:
 *
 *   members sorted by basename -> one line per member "name<TAB>sha256<TAB>bytes" ->
 *   sha256(the lines)
 *
 * Sorted by name, not by directory order; each member hashed on its own; a missing member is a
 * named refusal, never a silently shorter set. */
#define PP_MAX_MEMBERS 16
#define PP_NAME 256

const char *pp_identity_kind(const char *root) {
    int l = pp_layout(root);
    if (l == PP_APE) return "ape1";
    if (l == PP_SPLIT) return "split1";
    return "none";
}

/* TEXT into DST, bounded; returns the length copied. */
static int pp_put(char *dst, int cap, const char *text) {
    int i = 0;
    if (!dst || cap < 1) return 0;
    while (text && text[i] && i < cap - 1) { dst[i] = text[i]; i++; }
    dst[i] = 0;
    return i;
}

/* STRCMP over NUL-terminated strings. */
static int pp_cmp(const char *a, const char *b) {
    while (*a && *a == *b) { a++; b++; }
    return (int)(unsigned char)*a - (int)(unsigned char)*b;
}

/* 0 and the sha256 hex of SRC/NAME, or -1 when it is missing or unreadable. */
static int pp_file_hex(const char *src, const char *name, char hex[65]) {
    char p[4400];
    size_t n = 0;
    char *b;
    if (hex) hex[0] = 0;
    if (pp_join(src, name, p, (int)sizeof p)) return -1;
    if (sy_exists(p) != 1) return -1;
    b = cx_read(p, &n);
    if (!b) return -1;
    cx_sha256_hex(b, n, hex);
    free(b);
    return 0;
}

/* "NAME<TAB>HEX<TAB>BYTES\n" appended to CANON at *AT; -1 when it would not fit. */
static int pp_canon_add(char *canon, long cap, long *at, const char *name, const char *hex, long bytes) {
    char line[400], num[24];
    long n = 0, i, v = bytes < 0 ? 0 : bytes;
    int d = 0;
    for (i = 0; name[i] && n < 300; i++) line[n++] = name[i];
    line[n++] = '\t';
    for (i = 0; hex[i] && n < 340; i++) line[n++] = hex[i];
    line[n++] = '\t';
    do { num[d++] = (char)('0' + v % 10); v /= 10; } while (v > 0);
    while (d > 0) line[n++] = num[--d];
    line[n++] = '\n';
    if (*at + n > cap) return -1;
    for (i = 0; i < n; i++) canon[(*at)++] = line[i];
    return 0;
}

/* The launcher's basename, which is a member of ROOT itself rather than of the dev directory. */
static int pp_is_launcher(const char *name) {
    return pp_cmp(name, "unisacc.com") == 0;
}

/* ROOT's members, sorted by basename: NAMES[][64], SHAS[][65], BYTES[] up to MAX; returns the count
   or -1 (bad layout, missing member). The launcher is always first in the input and sorted like the
   rest; under PP_APE the product is a single member. Exported so a check can print or compare the
   same set pp_product_digest hashes. */
int pp_member_list(const char *root, char names[][64], char shas[][65], long *bytes, int max) {
    char nm[PP_NAME], h[65], p[4400], devsrc[4400], name[PP_NAME];
    int n = 0, i, j, l = pp_layout(root);
    long at = 0, rn = 0;
    char *r;
    if (max < 1) return -1;
    if (l == PP_APE) {
        if (pp_file_hex(root, "unisacc.com", h)) return -1;
        pp_put(nm, PP_NAME, "unisacc.com");
        pp_put(names[0], 64, nm);
        pp_put(shas[0], 65, h);
        {   sy_stat_t st;
            bytes[0] = (!pp_join(root, "unisacc.com", p, (int)sizeof p) && sy_stat(p, &st) == 0) ? (long)st.size : 0;
        }
        return 1;
    }
    if (l != PP_SPLIT) return -1;
    if (pp_join2(root, pp_dev_dir, "", devsrc, (int)sizeof devsrc)) return -1;
    pp_put(names[n], 64, "unisacc.com"); n++;
    if (pp_join(root, "ape-receipt.txt", p, (int)sizeof p)) return -1;
    r = cx_read(p, &rn);
    if (r) {
        long a = 0;
        while (a < rn && n < max) {
            long e = a;
            while (e < rn && r[e] != '\n') e++;
            if (pp_receipt_line(r + a, e - a, name, PP_NAME) && !pp_is_launcher(name)) {
                int dup = 0;
                for (j = 0; j < n; j++) if (pp_cmp(names[j], name) == 0) dup = 1;
                if (!dup) { pp_put(names[n], 64, name); n++; }
            }
            a = e + 1;
        }
        free(r);
    }
    if (n == 1) {
        if (max < 3) return -1;
        pp_put(names[n], 64, pp_pkg_name); n++;
        pp_put(names[n], 64, "entry.elf"); n++;
    }
    for (i = 1; i < n; i++) {
        pp_put(name, PP_NAME, names[i]);
        j = i - 1;
        while (j >= 0 && pp_cmp(names[j], name) > 0) { pp_put(names[j + 1], 64, names[j]); j--; }
        pp_put(names[j + 1], 64, name);
    }
    for (i = 0; i < n; i++) {
        const char *src = pp_is_launcher(names[i]) ? root : devsrc;
        sy_stat_t st;
        if (pp_file_hex(src, names[i], h)) return -1;
        pp_put(shas[i], 65, h);
        bytes[i] = (!pp_join(src, names[i], p, (int)sizeof p) && sy_stat(p, &st) == 0) ? (long)st.size : 0;
    }
    (void)at;
    return n;
}

/* Identity of the installed product at ROOT: 0 and HEX, or -1 (missing member, bad layout). */
int pp_product_digest(const char *root, char hex[65]) {
    static char names[PP_MAX_MEMBERS][64], shas[PP_MAX_MEMBERS][65];
    static long bytes[PP_MAX_MEMBERS];
    char canon[4096];
    int n, i, l = pp_layout(root);
    long at = 0;
    if (hex) hex[0] = 0;
    if (l == PP_APE) return pp_file_hex(root, "unisacc.com", hex);
    if (l != PP_SPLIT) return -1;
    n = pp_member_list(root, names, shas, bytes, PP_MAX_MEMBERS);
    if (n < 1) return -1;
    for (i = 0; i < n; i++)
        if (pp_canon_add(canon, (long)sizeof canon - 1, &at, names[i], shas[i], bytes[i])) return -1;
    canon[at] = 0;
    cx_sha256_hex(canon, (size_t)at, hex);
    return 0;
}

/* pp_product_digest in the shape of the plain per-file digest these checks already call, so a
   call site only has to change the argument: HEX is empty when the product cannot be read. */
void pp_digest_or_zero(const char *root, char hex[65]) {
    if (pp_product_digest(root, hex)) hex[0] = 0;
}

/* Copy NAME from SRC to DST, creating or truncating DST/NAME; 0, or -1. */
static int pp_copy_member(const char *src, const char *dst, const char *name) {
    char sp[4400], dp[4400];
    sy_stat_t st;
    size_t n = 0;
    char *b;
    if (pp_join(src, name, sp, (int)sizeof sp) || pp_join(dst, name, dp, (int)sizeof dp)) return -1;
    b = cx_read(sp, &n);
    if (!b) return -1;
    if (cx_write(dp, b, n)) { free(b); return -1; }
    free(b);
    /* The launcher and the loader are exec'd by path: a copy that drops their mode bits is not a
       product, it is a file that says "missing .../entry.elf". Keep the source's bits. */
    if (sy_stat(sp, &st) == 0) sy_chmod(dp, st.mode & 07777);
    return 0;
}

/* NAME from one receipt line "KEY<TAB>PATH<TAB>sha=...<TAB>bytes=N": the basename of PATH
   when there is one, else KEY. 0 when the line is blank, a comment, or the NOT_ sentinel
   (NOT_RELEASE is eleven characters; matching it by length was the first version of this and
   it failed the whole copy). */
static int pp_receipt_line(const char *line, long len, char *name, int cap) {
    long start = 0, end, p, q, base, r;
    while (start < len && (line[start] == ' ' || line[start] == '\t')) start++;
    end = start;
    while (end < len && line[end] != '\t' && line[end] != ' ' && line[end] != '\n') end++;
    if (end == start) return 0;
    if (end - start >= 4 && line[start] == 'N' && line[start + 1] == 'O' &&
        line[start + 2] == 'T' && line[start + 3] == '_') return 0;
    p = end;
    while (p < len && (line[p] == '\t' || line[p] == ' ')) p++;
    q = p;
    while (q < len && line[q] != '\t' && line[q] != ' ' && line[q] != '\n') q++;
    if (q == p) { p = start; q = end; }
    base = p;
    for (r = p; r < q; r++) if (line[r] == '/') base = r + 1;
    if (q - base <= 0 || q - base >= cap) return 0;
    for (r = base; r < q; r++) name[r - base] = line[r];
    name[q - base] = 0;
    return 1;
}

/* Copy the installed product from ROOT to DEST. Under PP_SPLIT the launcher goes to DEST and
   every member the receipt names goes under DEST/unisacc.com.dev/; a receipt that is missing
   falls back to the two names this file documents. */
int pp_copy_product(const char *root, const char *dst) {
    char p[4400], devsrc[4400], devdst[4400], name[256];
    size_t n = 0;
    char *r;
    long at = 0;
    int l = pp_layout(root), copied = 0;
    if (l < 0) return -1;
    if (sy_exists(dst) != 1 && sy_mkdir(dst, 0700)) return -1;
    if (pp_join2(root, pp_dev_dir, "", devsrc, (int)sizeof devsrc)) return -1;
    if (pp_join2(dst, pp_dev_dir, "", devdst, (int)sizeof devdst)) return -1;
    if (pp_copy_member(root, dst, "unisacc.com")) return -1;
    if (l == PP_APE) return 0;
    if (sy_exists(devdst) != 1 && sy_mkdir(devdst, 0700)) return -1;
    if (pp_join(root, "ape-receipt.txt", p, (int)sizeof p)) return -1;
    r = cx_read(p, &n);
    if (r) {
        while (at < (long)n) {
            long e = at;
            while (e < (long)n && r[e] != '\n') e++;
            if (pp_receipt_line(r + at, e - at, name, (int)sizeof name)) {
                if (!(name[0] == 'u' && name[1] == 'n' && name[2] == 'i' && name[3] == 's' &&
                      name[4] == 'a' && name[5] == 'c' && name[6] == 'c' && name[7] == '.' &&
                      name[8] == 'c' && name[9] == 'o' && name[10] == 'm' && name[11] == 0)) {
                    if (pp_copy_member(devsrc, devdst, name)) { free(r); return -1; }
                    copied++;
                }
            }
            at = e + 1;
        }
        free(r);
    }
    if (!copied) {
        if (pp_copy_member(devsrc, devdst, "entry.elf")) return -1;
        if (pp_copy_member(devsrc, devdst, pp_pkg_name)) return -1;
    }
    return 0;
}
