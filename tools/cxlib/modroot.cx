#pragma unisa module modroot
#pragma unisa use text.text

enum { MR_BAD = 0, MR_GIT = 1, MR_SNAP = 2, MR_INST = 3 };

static int mr_kind(const char *s, long n) {
    if (tx_same(s, n, "git", 3)) return MR_GIT;
    if (tx_same(s, n, "snapshot", 8)) return MR_SNAP;
    if (tx_same(s, n, "installed", 9)) return MR_INST;
    return MR_BAD;
}

int mr_parse(const char *spec, int *kind, char *path, long cap) {
    long n, i, kn;
    if (kind) *kind = MR_BAD;
    if (!spec || !spec[0]) return 1;
    n = tx_len(spec, 4096);
    if (n < 1) return 1;
    i = 0;
    while (i < n && spec[i] != ':') i++;
    if (i < 1 || i >= n - 1) return 1;
    kn = mr_kind(spec, i);
    if (kn == MR_BAD) return 1;
    if (spec[i + 1] != '/') return 1;
    if (tx_copy(path, cap, spec + i + 1, n - (i + 1))) return 1;
    if (kind) *kind = kn;
    return 0;
}
