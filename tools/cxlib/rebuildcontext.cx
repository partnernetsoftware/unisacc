 * Builder is still the actual canonical current Root path and original record;
 * controller Source329 and NN epoch Source447 are not substituted for it. */
int rb_verify_adopted_candidate(const char *root,const char *generation,const char *packages,const char *bootstrap,rb_result *out,char *why,size_t cap){return rb_verify_mode(root,generation,packages,bootstrap,0,3,out,why,cap);}
int rb_verify_mixed_candidate(const char *root,const char *generation,const char *packages,const char *bootstrap,rb_result *out,char *why,size_t cap){return rb_verify_mode(root,generation,packages,bootstrap,0,4,out,why,cap);}
