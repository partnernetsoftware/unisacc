/* Existing verification semantics are fixed to mode0. Explicit source and
 * legacy candidate modes require their own complete validators and schema.
 * The actual current root path must be this generation's original builder,
 * including its canonical old record and artifact bytes.
 * A historical builder source is allowed here, never in rb_verify mode0. */
int rb_verify(const char *root,const char *generation,const char *packages,const char *bootstrap,int current_bootstrap,rb_result *out,char *why,size_t cap){return rb_verify_mode(root,generation,packages,bootstrap,current_bootstrap,0,out,why,cap);}
