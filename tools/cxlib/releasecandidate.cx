#pragma unisa module releasecandidate
#pragma unisa use sys.fs
#pragma unisa use text.text
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.releaseversion

/* One exact TSV header and one candidate row. No network or implicit pins.
 * Failed loads leave the destination unchanged; all diagnostics are bounded.
 * verify accepts only the source four or the complete seven asset roles plus
 * any optional extra sidecar asset columns declared after checksums_sha256. */
enum { RCAND_MAX_EXTRA = 4 };
typedef struct RcCandidate {
 char repo[128],tag[128],commit[41],version[32],workflow[64],workflow_ref[128],ci_run_id[32];
 char name[7][256],sha[7][65];
 int extra_n;
 char extra_name[RCAND_MAX_EXTRA][256],extra_sha[RCAND_MAX_EXTRA][65];
 int extra_cols;
 char extra_col_key[RCAND_MAX_EXTRA][64],extra_col_name[RCAND_MAX_EXTRA][256],extra_col_sha[RCAND_MAX_EXTRA][65];
} RcCandidate;

static int rcand_error(char *why,int cap,const char *field,const char *detail){
 int n=0,i=0;
 if(why&&cap>0){
  while(field[i]&&n<cap-1)why[n++]=field[i++];
  if(n<cap-1)why[n++]=':';
  if(n<cap-1)why[n++]=' ';
  i=0;while(detail[i]&&n<cap-1)why[n++]=detail[i++];why[n]=0;
 }
 return -1;
}
int rcand_hex(const char *s,int n){int i;for(i=0;i<n;i++){int c=s[i];if(!((c>='0'&&c<='9')||(c>='a'&&c<='f')))return 0;}return 1;}
static int rcand_alnum(char c){return(c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9');}
static const char *rcand_column(int i){
 static const char *cols[21]={"repo","tag","commit","version","workflow","workflow_ref","ci_run_id","ape","ape_sha256","package","package_sha256","win_arm64","win_arm64_sha256","record","record_sha256","build_alias","build_alias_sha256","zip","zip_sha256","checksums","checksums_sha256"};
 return cols[i];
}
/* Contract split (prd_mempalace win-arm64.zip removal): versions up to and including
 * RCAND_ZIP_LAST carry the win-arm64 zip in role 5; later versions write "-" for
 * zip and zip_sha256 and the zip is not an asset. Source: owner decision 2026-11-14. */
#define RCAND_ZIP_LAST "0.0.62"
static int rcand_parts(const char *s,long *p){
 int n=0,i=0;long v;
 for(;n<4;n++){p[n]=0;}
 n=0;
 while(s[i]&&n<4){v=0;while(s[i]>='0'&&s[i]<='9'){v=v*10+(s[i]-'0');i++;}p[n++]=v;if(s[i]=='.')i++;else break;}
 return n;
}
int rcand_has_zip(const char *version){
 long a[4],b[4];int i;
 rcand_parts(version,a);rcand_parts(RCAND_ZIP_LAST,b);
 for(i=0;i<4;i++){if(a[i]<b[i])return 1;if(a[i]>b[i])return 0;}
 return 1;
}
int rcand_skip(const RcCandidate *c,int i){return i==5&&!rcand_has_zip(c->version);}
int rcand_sums_count(const RcCandidate *c){
 int i,n=0;
 if(!c)return 0;
 for(i=0;i<6;i++)if(!rcand_skip(c,i))n++;
 if(c->extra_n>0&&c->extra_n<=RCAND_MAX_EXTRA)n+=c->extra_n;
 return n;
}
int rcand_upload_count(const RcCandidate *c){return rcand_sums_count(c)+1;}
static int rcand_nozip_slot(const RcCandidate *c){return tx_eqz(c->name[5],"-")&&tx_eqz(c->sha[5],"-");}
static int rcand_key_ok(const char *s,int n){
 int i;
 if(n<=0||n>=48||!rcand_alnum(s[0]))return 0;
 for(i=0;i<n;i++)if(!rcand_alnum(s[i])&&s[i]!='_')return 0;
 return 1;
}
static int rcand_validate(const RcCandidate *c,char *why,int cap){
 const char *s[7];int sizes[7]={128,128,41,32,64,128,32};int i,j,k,n;
 s[0]=c->repo;s[1]=c->tag;s[2]=c->commit;s[3]=c->version;s[4]=c->workflow;s[5]=c->workflow_ref;s[6]=c->ci_run_id;
 for(i=0;i<7;i++){
  n=(int)tx_len(s[i],sizes[i]);if(n<=0)return rcand_error(why,cap,rcand_column(i),"empty or capacity exceeded");
  for(j=0;j<n;j++)if(s[i][j]<33||s[i][j]>126)return rcand_error(why,cap,rcand_column(i),"unsafe field byte");
 }
 if(tx_len(c->commit,41)!=40||!rcand_hex(c->commit,40))return rcand_error(why,cap,"commit","expected 40 lowercase hex digits");
 if(!rv_valid(c->version))return rcand_error(why,cap,"version","expected three or four canonical components in 0..65535, at most 23 bytes");
 for(i=0;c->tag[i];i++)if(!rcand_alnum(c->tag[i])&&c->tag[i]!='.'&&c->tag[i]!='_'&&c->tag[i]!='-')return rcand_error(why,cap,"tag","expected a plain workflow release tag");
 for(i=0;c->ci_run_id[i];i++)if(c->ci_run_id[i]<'0'||c->ci_run_id[i]>'9')return rcand_error(why,cap,"ci_run_id","expected decimal digits");
 for(i=0;i<7;i++){
  if(i==5){
   if(rcand_has_zip(c->version)){if(rcand_nozip_slot(c))return rcand_error(why,cap,rcand_column(17),"zip required for this version");}
   else{if(!rcand_nozip_slot(c))return rcand_error(why,cap,rcand_column(17),"zip must be - for this version");continue;}
  }
  n=(int)tx_len(c->name[i],256);
  if(n<=0||!rcand_alnum(c->name[i][0]))return rcand_error(why,cap,rcand_column(7+2*i),"expected safe basename");
  for(j=0;j<n;j++)if(!rcand_alnum(c->name[i][j])&&c->name[i][j]!='.'&&c->name[i][j]!='_'&&c->name[i][j]!='-')return rcand_error(why,cap,rcand_column(7+2*i),"unsafe basename byte");
  for(k=0;k<i;k++)if(tx_eqz(c->name[i],c->name[k]))return rcand_error(why,cap,rcand_column(7+2*i),"duplicate basename");
  if(tx_len(c->sha[i],65)!=64||!rcand_hex(c->sha[i],64))return rcand_error(why,cap,rcand_column(8+2*i),"expected 64 lowercase hex digits");
 }
 if(c->extra_n<0||c->extra_n>RCAND_MAX_EXTRA)return rcand_error(why,cap,"extra","invalid extra asset count");
 for(i=0;i<c->extra_n;i++){
  n=(int)tx_len(c->extra_name[i],256);
  if(n<=0||!rcand_alnum(c->extra_name[i][0]))return rcand_error(why,cap,"extra","expected safe basename");
  for(j=0;j<n;j++)if(!rcand_alnum(c->extra_name[i][j])&&c->extra_name[i][j]!='.'&&c->extra_name[i][j]!='_'&&c->extra_name[i][j]!='-')return rcand_error(why,cap,"extra","unsafe basename byte");
  for(k=0;k<7;k++)if(!rcand_skip(c,k)&&tx_eqz(c->extra_name[i],c->name[k]))return rcand_error(why,cap,"extra","duplicate basename");
  for(k=0;k<i;k++)if(tx_eqz(c->extra_name[i],c->extra_name[k]))return rcand_error(why,cap,"extra","duplicate basename");
  if(tx_len(c->extra_sha[i],65)!=64||!rcand_hex(c->extra_sha[i],64))return rcand_error(why,cap,"extra_sha256","expected 64 lowercase hex digits");
 }
 return 0;
}
int rcand_load(const char *path,RcCandidate *c,char *why,int cap){
 char text[8192],*dest[21],ekey[RCAND_MAX_EXTRA][64],ename[RCAND_MAX_EXTRA][256],esha[RCAND_MAX_EXTRA][65];
 int sizes[21],fd,i,j,row,col,ncols=0,extra_cols=0,start,end,n=0,rc;long got;RcCandidate next;
 if(why&&cap>0)why[0]=0;
 if(!path||!path[0]||!c)return rcand_error(why,cap,"candidate","invalid arguments");
 fd=sy_open_read(path);if(fd<0)return rcand_error(why,cap,"candidate","cannot open table");
 if(sy_reg_size(fd)<0){sy_close(fd);return rcand_error(why,cap,"candidate","table is not a regular file");}
 while(n<(int)sizeof text){got=sy_read(fd,text+n,(int)sizeof text-n);if(got<0){sy_close(fd);return rcand_error(why,cap,"candidate","table read failed");}if(!got)break;n+=(int)got;}
 rc=sy_close(fd);if(rc!=0)return rcand_error(why,cap,"candidate","table close failed");
 if(n==(int)sizeof text)return rcand_error(why,cap,"candidate","table capacity exceeded");
 next.extra_n=0;next.extra_cols=0;
 dest[0]=next.repo;sizes[0]=128;dest[1]=next.tag;sizes[1]=128;dest[2]=next.commit;sizes[2]=41;dest[3]=next.version;sizes[3]=32;dest[4]=next.workflow;sizes[4]=64;dest[5]=next.workflow_ref;sizes[5]=128;dest[6]=next.ci_run_id;sizes[6]=32;
 for(i=0;i<7;i++){dest[7+2*i]=next.name[i];sizes[7+2*i]=256;dest[8+2*i]=next.sha[i];sizes[8+2*i]=65;}
 row=0;col=0;start=0;
 for(i=0;i<=n;i++){
  if(i<n&&text[i]!='\t'&&text[i]!='\n'){
   if(text[i]==0||text[i]=='\r')return rcand_error(why,cap,"candidate","NUL or CR byte in table");
   continue;
  }
  if(i==n&&start==n&&col==0)break;
  if(row>1)return rcand_error(why,cap,"candidate","expected exactly one candidate row");
  if(col>=21+2*RCAND_MAX_EXTRA)return rcand_error(why,cap,"candidate","column capacity exceeded");
  end=i;
  if(row==0){
   if(col<21){
    const char *h=rcand_column(col);for(j=0;start+j<end&&h[j]&&text[start+j]==h[j];j++);if(start+j!=end||h[j])return rcand_error(why,cap,rcand_column(col),"header mismatch");
   }else{
    int ei=(col-21)/2,is_sha=(col-21)&1,len=end-start;
    if(!is_sha){
     int k;
     if(!rcand_key_ok(text+start,len))return rcand_error(why,cap,"extra","invalid extra column name");
     for(j=0;j<len;j++)ekey[ei][j]=text[start+j];ekey[ei][len]=0;
     for(k=0;k<21;k++)if(tx_eqz(ekey[ei],rcand_column(k)))return rcand_error(why,cap,ekey[ei],"duplicate column name");
     for(k=0;k<ei;k++)if(tx_eqz(ekey[ei],ekey[k]))return rcand_error(why,cap,ekey[ei],"duplicate column name");
     if(len>=7&&tx_same(ekey[ei]+len-7,7,"_sha256",7))return rcand_error(why,cap,ekey[ei],"invalid extra column name");
    }else{
     int kl=(int)tx_len(ekey[ei],64);
     if(len!=kl+7||!tx_same(text+start,kl,ekey[ei],kl)||!tx_same(text+start+kl,7,"_sha256",7))
      return rcand_error(why,cap,"extra_sha256","expected <key>_sha256 header");
    }
   }
  }else{
   if(col<21){
    if(end-start<=0||end-start>=sizes[col])return rcand_error(why,cap,rcand_column(col),"empty or capacity exceeded");
    for(j=start;j<end;j++)dest[col][j-start]=text[j];dest[col][end-start]=0;
   }else{
    int ei=(col-21)/2,is_sha=(col-21)&1,len=end-start,capc=is_sha?65:256;
    char *dst=is_sha?esha[ei]:ename[ei];
    if(len<=0||len>=capc)return rcand_error(why,cap,is_sha?"extra_sha256":"extra","empty or capacity exceeded");
    for(j=0;j<len;j++)dst[j]=text[start+j];dst[len]=0;
   }
  }
  col++;start=i+1;
  if(i==n||text[i]=='\n'){
   if(row==0){
    if(col<21||((col-21)&1))return rcand_error(why,cap,"candidate","expected 21 columns plus optional extra name/sha256 pairs");
    ncols=col;extra_cols=(col-21)/2;
   }else if(col!=ncols){
    return rcand_error(why,cap,"candidate","row column count mismatch");
   }
   row++;col=0;
  }
 }
 if(row!=2)return rcand_error(why,cap,"candidate","expected header and exactly one candidate row");
 next.extra_cols=extra_cols;
 for(i=0;i<extra_cols;i++){
  int dn=tx_eqz(ename[i],"-"),ds=tx_eqz(esha[i],"-");
  for(j=0;ekey[i][j];j++)next.extra_col_key[i][j]=ekey[i][j];next.extra_col_key[i][j]=0;
  for(j=0;ename[i][j];j++)next.extra_col_name[i][j]=ename[i][j];next.extra_col_name[i][j]=0;
  for(j=0;esha[i][j];j++)next.extra_col_sha[i][j]=esha[i][j];next.extra_col_sha[i][j]=0;
  if(dn&&ds)continue;
  if(dn!=ds)return rcand_error(why,cap,ekey[i],"extra name and sha256 must both be - or both populated");
  for(j=0;ename[i][j];j++)next.extra_name[next.extra_n][j]=ename[i][j];next.extra_name[next.extra_n][j]=0;
  for(j=0;esha[i][j];j++)next.extra_sha[next.extra_n][j]=esha[i][j];next.extra_sha[next.extra_n][j]=0;
  next.extra_n++;
 }
 if(rcand_validate(&next,why,cap)!=0)return -1;
 *c=next;return 0;
}
int rcand_verify(const RcCandidate *c,const char *dir,int count,char *why,int cap){
 int i,j,k,n,ok,rc,m=0;const char *vname[7+RCAND_MAX_EXTRA],*vsha[7+RCAND_MAX_EXTRA],*vcol[7+RCAND_MAX_EXTRA];
 size_t at=0;char detail[512];np_result r={0};char *argv[16];
 if(why&&cap>0)why[0]=0;
 if(!c||!dir||!dir[0]||(count!=4&&count!=7))return rcand_error(why,cap,"verify","expected candidate, directory and count 4 or 7");
 if(rcand_validate(c,why,cap)!=0)return -1;
 argv[0]="sha256sum";argv[1]="--";
 for(i=0;i<count;i++){if(i==5&&!rcand_has_zip(c->version))continue;vname[m]=c->name[i];vsha[m]=c->sha[i];vcol[m]=rcand_column(7+2*i);argv[2+m]=(char *)c->name[i];m++;}
 for(i=0;i<c->extra_n;i++){vname[m]=c->extra_name[i];vsha[m]=c->extra_sha[i];vcol[m]="extra";argv[2+m]=(char *)c->extra_name[i];m++;}
 argv[2+m]=0;detail[0]=0;
 rc=np_run(argv,dir,0,15,&r,detail,sizeof detail);
 if(rc!=0){np_free(&r);return rcand_error(why,cap,"verify",detail[0]?detail:"sha256sum launch failed");}
 if(r.rc!=0||r.residue!=0||!r.out){np_free(&r);return rcand_error(why,cap,"verify","sha256sum failed or child residue");}
 for(k=0;k<m;k++){
  n=(int)tx_len(vname[k],256);ok=r.outn>=at+(size_t)(67+n);
  if(ok){
   for(j=0;j<64;j++)if(r.out[at+j]!=vsha[k][j])ok=0;
   if(r.out[at+64]!=' '||r.out[at+65]!=' ')ok=0;
   for(j=0;j<n;j++)if(r.out[at+66+j]!=vname[k][j])ok=0;
   if(r.out[at+66+n]!='\n')ok=0;
  }
  if(!ok){np_free(&r);return rcand_error(why,cap,vcol[k],"sha256sum output or digest mismatch");}
  at+=(size_t)(67+n);
 }
 ok=at==r.outn;np_free(&r);
 if(!ok)return rcand_error(why,cap,"verify","unexpected trailing sha256sum output");
 return 0;
}
