#pragma unisa module nninputs
#pragma unisa use netpack
#pragma unisa use kernelsha
/* Necessary NN input applicability, not NN inference, construction, training,
 * complete PP facts equivalence, or the original source-package 107/34 DAG.
 * Caller separately proves fresh current/origin SID and the original SP DAG.
 * Legacy native pair: seed/unisa_libneed.c 5f0469bcb6268bf979d8bb872424ae238c8f991b51543337b6f4b2750b2fdbb1;
 * HOSTCC ELF 5c6a7756fa4de143a3e74ec14f392fc8ee736755ad55043cb976ace0fb2bb011.
 * The second, finite admissible reader is the independently exercised CX ELF
 * e4b627f06557a27b4cc71e854f3b4e26d137c8aaeae736279312ccb704df6020,
 * with FAST_ELF.cache.tsv canonical code-cache profile and all pinned material
 * inputs verified before/after. Its compiled-include v2 identity must match
 * the actual current-before observation before either native table call.
 * This pins exercised readers and unsigned input consistency, not historical
 * compilation proof or hermetic compiler lineage. System stdio/headers/libc/zlib remain HOSTCC trust
 * inputs, not carried-project-include dependencies of those five constructors.
 * Caller must bind this compiled coordinator's actual source/module hashes,
 * compiler role, flags and ELF in its code-cache profile. Runtime source SHA
 * cannot prove what a stale compiled caller contains. No saved verdict cache.
 * Linux/x86_64 LP64, single-threaded bounded caller (outer <=55 seconds).
 * Each call forks an invocation-private reader, so dependency fatal errors
 * (including netpack allocation failures) cannot exit the calling process.
 * Both roots' four source/data trees and whole include trees are physically
 * read at independent before/after endpoints. Symlinks are literal records,
 * never traversed; include symlinks are refused before the trusted native
 * scanner, whose own historical directory walker follows symlinks.
 * Directory, regular-file and literal-link permission modes participate in
 * complete tree records. Include inventory/directory/file modes match;
 * contents may differ only subject to exact
 * native libneed and ordered trigger projections. No filesystem writes.
 * SHA provider ni-hybrid-sha256-provider-v1: <1024 bytes software, >=1024 AF_ALG
 * (no fallback), empty/abc selfchecks per call. Actual phase times use the
 * raw Linux clock_gettime syscall, CLOCK_MONOTONIC, in nanoseconds. They are
 * observations, excluded from stable identity hashes and never cached.
 * elapsed_ns spans reader setup through final identity hashes, excluding
 * cleanup, fork/IPC and caller compiler/startup costs. support_ns is the sum
 * of its two separately reported endpoints; other phase fields do not overlap.
 * ni_compare: 0 means necessary inputs match; -1 gives why and all-zero out.
 * physical_reads counts this module's regular-file and literal-link reads;
 * native scanner internal physical reads are UNMEASURED, never inferred.
 */
typedef struct {
 char witness[65],data[65],ctor_cdeps[65],current_include[65],origin_include[65];
 char libneed[65],autoinc_full[65],autoinc_facts[65],native_artifact[65],native_C_source[65];
 char verifier[65],netpack[65],kernelsha[65],runtime_support[65];
 char native_profile[65],compiled_include[65],compiled_material[65],derived_source[65],compiler_artifact[65],compiler_record[65];
 int native_source_kind; /* 1 legacy HOSTCC C; 2 own CX compiled code cache */
 int data_files,data_dirs,data_symlinks,ctor_files,ordered_headers,full_triggers,facts_triggers;
 int physical_reads,current_reads,origin_reads,support_reads,native_table_calls,native_internal_reads;
 long long setup_ns,support_before_ns,support_after_ns,support_ns,order_ns;
 long long current_before_ns,origin_before_ns,data_compare_ns;
 long long native_current_ns,native_origin_ns,native_compare_ns;
 long long current_after_ns,origin_after_ns,stability_compare_ns,finalhash_ns,elapsed_ns;
} ni_result;
typedef struct {char *name;char sha[65];size_t bytes;unsigned mode;int kind;} NiEntry;
typedef struct {np_buf data,include,include_shape,cdeps,full,facts;int files,dirs,links,headers,full_count,facts_count;} NiEndpoint;
typedef struct {
 char root[4096],origin[4096],native[4400],bound[4400],why[1200];
 int failed,digest_ready,reads[3],role,entries_count;
 NiEntry *entries;char *order[256];char order_sha[65];int headers;
} NiContext;
static const char *ni_native_c="5f0469bcb6268bf979d8bb872424ae238c8f991b51543337b6f4b2750b2fdbb1";
static const char *ni_native_elf="5c6a7756fa4de143a3e74ec14f392fc8ee736755ad55043cb976ace0fb2bb011";
static const char *ni_fast_elf="e4b627f06557a27b4cc71e854f3b4e26d137c8aaeae736279312ccb704df6020";
static int ni_bad(NiContext *c,const char *reason,const char *path){if(!c->failed)snprintf(c->why,sizeof c->why,"%s path=%.700s errno=%d",reason,path?path:"-",errno);c->failed=1;return -1;}
static long long ni_clock_ns(NiContext *c){long stamp[2]={0,0};long rc=__syscall6(228,1,(long)stamp,0,0,0);if(rc){char reason[100];snprintf(reason,sizeof reason,"monotonic-clock-raw-rc=%ld",rc);ni_bad(c,reason,0);return -1;}if(stamp[0]<0||stamp[1]<0||stamp[1]>=1000000000L||stamp[0]>(LLONG_MAX-stamp[1])/1000000000LL){ni_bad(c,"monotonic-clock-range",0);return -1;}return (long long)stamp[0]*1000000000LL+stamp[1];}
static int ni_phase(NiContext *c,long long *last,long long *elapsed){long long now=ni_clock_ns(c);if(now<0)return -1;if(now<*last)return ni_bad(c,"monotonic-clock-went-backwards",0);*elapsed=now-*last;*last=now;return 0;}
static int ni_path(NiContext *c,char p[4400],const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);return n<0||n>=4400?ni_bad(c,"path-bound",b):0;}
static int ni_id(unsigned char x){return(x>='a'&&x<='z')||(x>='A'&&x<='Z')||(x>='0'&&x<='9')||x=='_';}
static int ni_relative(const char *p){if(!*p||*p=='/'||strpbrk(p,"\r\n\t\\"))return 0;const char *s=p;while(*s){const char *e=strchr(s,'/');size_t n=e?(size_t)(e-s):strlen(s);if(!n||(n==1&&s[0]=='.')||(n==2&&s[0]=='.'&&s[1]=='.'))return 0;for(size_t i=0;i<n;i++)if(!ni_id((unsigned char)s[i])&&s[i]!='.'&&s[i]!='-')return 0;if(!e)break;s=e+1;}return 1;}
static int ni_hash(NiContext *c,const void *p,size_t n,char h[65]){
 if(n<1024){cx_sha256_hex(p,n,h);return 0;}
 if(!c->digest_ready){char test[65];int rc=ks_sha256_hex("",0,test);if(rc||strcmp(test,"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"))return ni_bad(c,"kernel-sha256-empty-selfcheck",0);rc=ks_sha256_hex("abc",3,test);if(rc||strcmp(test,"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"))return ni_bad(c,"kernel-sha256-abc-selfcheck",0);c->digest_ready=1;}
 int rc=ks_sha256_hex(p,n,h);if(rc){char reason[160];snprintf(reason,sizeof reason,"kernel-sha256-buffer-rc=%d",rc);return ni_bad(c,reason,0);}return 0;
}
static char *ni_read(NiContext *c,const char *p,size_t *n,unsigned *mode){
 struct stat a,b;if(lstat(p,&a)||!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>268435456){ni_bad(c,"bounded-regular-file",p);return 0;}
 int fd=open(p,O_RDONLY|O_CLOEXEC|O_NOFOLLOW|O_NONBLOCK);if(fd<0){ni_bad(c,"file-open",p);return 0;}char *s=0;int bad=0;
 if(fstat(fd,&b)||!S_ISREG(b.st_mode)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size||a.st_mode!=b.st_mode){ni_bad(c,"file-descriptor-identity",p);bad=1;goto end;}
 *n=(size_t)a.st_size;s=malloc(*n+1);if(!s){ni_bad(c,"allocation",p);bad=1;goto end;}size_t at=0;
 while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0){ni_bad(c,"file-read-extent",p);bad=1;goto end;}at+=(size_t)z;}
 char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);
 if(z||fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size||a.st_mode!=b.st_mode){ni_bad(c,"file-changed-or-extra-byte",p);bad=1;}
end:
 if(close(fd)){ni_bad(c,"file-close",p);bad=1;}if(bad){free(s);return 0;}s[*n]=0;if(mode)*mode=(unsigned)a.st_mode&07777;c->reads[c->role]++;return s;
}
static int ni_digest_file(NiContext *c,const char *base,const char *rel,char h[65]){char p[4400];size_t n;if(ni_path(c,p,base,rel))return -1;char *s=ni_read(c,p,&n,0);if(!s)return -1;int rc=ni_hash(c,s,n,h);free(s);return rc;}
static void ni_row(np_buf *b,const char *key,const char *value){np_puts(b,key);np_puts(b,"\t");np_puts(b,value);np_puts(b,"\n");}
static void ni_clear_entries(NiContext *c){for(int i=0;i<c->entries_count;i++)free(c->entries[i].name);c->entries_count=0;}
static int ni_entry(NiContext *c,const char *base,const char *rel,const struct stat *st,int kind){
 if(c->entries_count==16384||!ni_relative(rel))return ni_bad(c,"tree-entry-name-or-capacity",rel);NiEntry *v=&c->entries[c->entries_count++];memset(v,0,sizeof *v);v->name=strdup(rel);if(!v->name)return ni_bad(c,"allocation",rel);v->kind=kind;v->mode=(unsigned)st->st_mode&07777;char p[4400];if(ni_path(c,p,base,rel))return -1;
 if(kind==1){size_t n;unsigned mode;char *s=ni_read(c,p,&n,&mode);if(!s)return -1;v->bytes=n;v->mode=mode;int rc=ni_hash(c,s,n,v->sha);free(s);return rc;}
 if(kind==3){char literal[4400];ssize_t n=readlink(p,literal,sizeof literal);if(n<0||n>=(ssize_t)sizeof literal)return ni_bad(c,"bounded-literal-symlink",rel);struct stat after;if(lstat(p,&after)||after.st_dev!=st->st_dev||after.st_ino!=st->st_ino||after.st_mode!=st->st_mode||after.st_size!=st->st_size)return ni_bad(c,"symlink-changed",rel);v->bytes=(size_t)n;c->reads[c->role]++;return ni_hash(c,literal,(size_t)n,v->sha);}return 0;
}
static int ni_walk(NiContext *c,const char *base,const char *rel,int depth){
 if(depth>64)return ni_bad(c,"tree-depth",rel);char p[4400];if(ni_path(c,p,base,rel))return -1;struct stat st;if(lstat(p,&st))return ni_bad(c,"tree-stat",rel);
 if(S_ISREG(st.st_mode))return ni_entry(c,base,rel,&st,1);if(S_ISLNK(st.st_mode))return ni_entry(c,base,rel,&st,3);if(!S_ISDIR(st.st_mode))return ni_bad(c,"tree-special-file",rel);if(ni_entry(c,base,rel,&st,2))return -1;
 DIR *d=opendir(p);if(!d)return ni_bad(c,"tree-directory-open",rel);int rc=0;for(;;){errno=0;struct dirent *e=readdir(d);if(!e){int saved=errno,closed=closedir(d);if(saved||closed)return ni_bad(c,"tree-directory-read-or-close",rel);return rc;}if(!strcmp(e->d_name,".")||!strcmp(e->d_name,".."))continue;char child[4400];if(ni_path(c,child,rel,e->d_name)||ni_walk(c,base,child,depth+1)){rc=-1;break;}}int closed=closedir(d);if(closed)ni_bad(c,"tree-directory-close",rel);return rc;
}
static int ni_cmp_entry(const void *a,const void *b){return strcmp(((const NiEntry *)a)->name,((const NiEntry *)b)->name);}
static int ni_tree(NiContext *c,const char *base,int include,NiEndpoint *out){
 ni_clear_entries(c);const char *trees[]={"exec","src","weights"};if(include){if(ni_walk(c,base,"include",0))return -1;}else for(int i=0;i<3;i++)if(ni_walk(c,base,trees[i],0))return -1;
 qsort(c->entries,(size_t)c->entries_count,sizeof *c->entries,ni_cmp_entry);np_buf *b=include?&out->include:&out->data;np_puts(b,include?"ni-complete-include-tree-v2-all-modes\n":"ni-complete-exec-src-weights-v3-all-modes\n");if(include)np_puts(&out->include_shape,"ni-complete-include-inventory-and-all-modes-v2\n");
 for(int i=0;i<c->entries_count;i++){NiEntry *v=&c->entries[i];if(i&&!strcmp(v[-1].name,v->name))return ni_bad(c,"duplicate-tree-entry",v->name);if(!include&&!strcmp(v->name,"exec/facts/pp-autoinc.tsv")&&(v->kind!=1||strcmp(v->sha,c->order_sha)))return ni_bad(c,"autoinc-order-does-not-match-observed-data-tree",v->name);np_puts(b,v->kind==1?"file\t":v->kind==2?"directory\t":"literal-symlink\t");np_puts(b,v->name);np_puts(b,"\t");np_putll(b,v->mode);if(v->kind!=2){np_puts(b,"\t");np_putll(b,(long long)v->bytes);np_puts(b,"\t");np_puts(b,v->sha);}np_puts(b,"\n");
  if(include){if(v->kind==3)return ni_bad(c,"include-symlink-unsupported-by-trusted-native-walker",v->name);np_putll(&out->include_shape,v->kind);np_puts(&out->include_shape,"\t");np_puts(&out->include_shape,v->name);np_puts(&out->include_shape,"\t");np_putll(&out->include_shape,v->mode);np_puts(&out->include_shape,"\n");}
  else if(v->kind==1)out->files++;else if(v->kind==2)out->dirs++;else out->links++;
 }return 0;
}
/* Explicit repository transitive quote closure observed in the five actual
 * HOSTCC constructors. Every member's own quote list is checked, including
 * leaves; macro includes refuse. Angle headers remain system/toolchain trust. */
static const char *ni_deps[]={"seed/gen.c","seed/json.h","seed/facts.h","seed/tbl.c","seed/net.c","exec/c/core.h","seed/compilerpack.c","seed/sha256.h","include/unisa_safedel.h","seed/pack.c"};
static const char *ni_quotes[]={"json.h\nfacts.h\n","","","json.h\n","../exec/c/core.h\n","","json.h\nsha256.h\n../include/unisa_safedel.h\n","","",""};
static int ni_quotes_check(NiContext *c,const char *s,size_t n,int file){
 np_buf quotes={0};size_t at=0;int rc=-1;while(at<n){size_t end=at;while(end<n&&s[end]!='\n')end++;size_t p=at;while(p<end&&(s[p]==' '||s[p]=='\t'))p++;if(p<end&&s[p]=='#'){p++;while(p<end&&(s[p]==' '||s[p]=='\t'))p++;if(end-p>=7&&!memcmp(s+p,"include",7)&&(p+7==end||!ni_id((unsigned char)s[p+7]))){p+=7;while(p<end&&(s[p]==' '||s[p]=='\t'))p++;if(p==end||(s[p]!='\"'&&s[p]!='<')){ni_bad(c,"constructor-macro-or-nonliteral-include",ni_deps[file]);goto done;}char stop=s[p]=='\"'?'\"':'>';int quote=s[p]=='\"';size_t a=++p;while(p<end&&s[p]!=stop)p++;if(p==end){ni_bad(c,"constructor-include-extent",ni_deps[file]);goto done;}if(quote){np_put(&quotes,s+a,p-a);np_puts(&quotes,"\n");}}}at=end+1;}
 if(quotes.n!=strlen(ni_quotes[file])||(quotes.n&&memcmp(quotes.p,ni_quotes[file],quotes.n))){ni_bad(c,"constructor-transitive-quote-set-changed",ni_deps[file]);goto done;}rc=0;
done:free(quotes.p);return rc;
}
static int ni_ancestors(NiContext *c,const char *base,const char *rel){char p[4400];if(ni_path(c,p,base,rel))return -1;for(char *q=p+strlen(base)+1;*q;q++)if(*q=='/'){*q=0;struct stat st;int bad=lstat(p,&st)||!S_ISDIR(st.st_mode);*q='/';if(bad)return ni_bad(c,"repository-dependency-parent-not-normal-directory",rel);}return 0;}
static int ni_cdeps(NiContext *c,const char *base,np_buf *b){np_puts(b,"ni-five-native-constructor-repository-dependencies-v1\n");np_puts(b,"roles\tgen:gen.c,json.h,facts.h;tbl:tbl.c,json.h;net:net.c,exec/c/core.h;compilerpack:compilerpack.c,json.h,sha256.h,include/unisa_safedel.h;pack:pack.c\nHOST_TRUST\tsystem-stdio-headers-libc-zlib-not-project-carried-headers;nonhermetic\n");for(int i=0;i<10;i++){char p[4400],h[65];size_t n;unsigned mode;if(ni_ancestors(c,base,ni_deps[i])||ni_path(c,p,base,ni_deps[i]))return -1;char *s=ni_read(c,p,&n,&mode);if(!s)return -1;int rc=ni_quotes_check(c,s,n,i);if(!rc)rc=ni_hash(c,s,n,h);free(s);if(rc)return -1;np_puts(b,ni_deps[i]);np_puts(b,"\t");np_putll(b,mode);np_puts(b,"\t");np_putll(b,(long long)n);np_puts(b,"\t");np_puts(b,h);np_puts(b,"\n");}return 0;}
static int ni_order(NiContext *c){char p[4400];size_t n;if(ni_path(c,p,c->root,"exec/facts/pp-autoinc.tsv"))return -1;char *s=ni_read(c,p,&n,0);if(!s)return -1;int rc=-1;if(ni_hash(c,s,n,c->order_sha))goto done;if(n<8||memcmp(s,"# value\n",8)||s[n-1]!='\n'||memchr(s,0,n)||memchr(s,'\r',n)){ni_bad(c,"autoinc-order-schema",p);goto done;}size_t at=8;while(at<n){size_t end=at;while(end<n&&s[end]!='\n')end++;if(end>at&&s[at]!='#'){if(c->headers==256||end-at>=4096){ni_bad(c,"autoinc-order-bound",p);goto done;}char name[4096];memcpy(name,s+at,end-at);name[end-at]=0;size_t z=strlen(name);if(!ni_relative(name)||z<3||strcmp(name+z-2,".h")){ni_bad(c,"autoinc-order-plain-header",p);goto done;}for(int i=0;i<c->headers;i++)if(!strcmp(c->order[i],name)){ni_bad(c,"autoinc-order-duplicate",name);goto done;}c->order[c->headers]=strdup(name);if(!c->order[c->headers++]){ni_bad(c,"allocation",name);goto done;}}at=end+1;}if(!c->headers){ni_bad(c,"autoinc-empty-order",p);goto done;}rc=0;
done:free(s);return rc;}
/* Exact probe6363 Latin-1 Python whitespace and line projection. In particular
 * startswith(static) has NO word boundary, names may start with a digit, only
 * the first '(' and a later same-line '{' participate. Not C declaration parse. */
static int ni_space(unsigned char x){return(x>=9&&x<=13)||(x>=28&&x<=32)||x==133||x==160;}
static void ni_trigger(np_buf *b,int h,int i,const char *s,size_t n){np_puts(b,"trigger\t");np_putll(b,h);np_puts(b,"\t");np_putll(b,i);np_puts(b,"\t");np_putll(b,(long long)n);np_puts(b,"\t");np_put(b,s,n);np_puts(b,"\n");}
static int ni_projection(NiContext *c,const char *base,NiEndpoint *r){np_puts(&r->full,"autoinc-map-v1\nmode\tE.autoinc_map-including-printf\n");np_puts(&r->facts,"autoinc-map-v1\nmode\tppautoinc-headers-filter-printf-only\n");for(int h=0;h<c->headers;h++){char rel[4400],p[4400],hash[65];size_t n;unsigned mode;if(ni_path(c,rel,"include",c->order[h])||ni_path(c,p,base,rel))return -1;char *s=ni_read(c,p,&n,&mode);if(!s)return -1;if(ni_hash(c,s,n,hash)){free(s);return -1;}int found=0;for(int i=0;i<c->entries_count;i++){NiEntry *v=&c->entries[i];if(!strcmp(v->name,rel)){if(v->kind!=1||v->mode!=mode||v->bytes!=n||strcmp(v->sha,hash)){free(s);return ni_bad(c,"projection-header-changed-after-tree-read",rel);}found++;}}if(found!=1){free(s);return ni_bad(c,"projection-header-not-in-complete-inventory",rel);}np_puts(&r->full,"header\t");np_putll(&r->full,h);np_puts(&r->full,"\t");np_puts(&r->full,c->order[h]);np_puts(&r->full,"\n");np_puts(&r->facts,"header\t");np_putll(&r->facts,h);np_puts(&r->facts,"\t");np_puts(&r->facts,c->order[h]);np_puts(&r->facts,"\n");int full=0,facts=0;size_t at=0;while(at<n){size_t end=at;while(end<n&&s[end]!='\n')end++;size_t len=end-at;const char *ln=s+at;if(len>7&&!memcmp(ln,"static",6)){const char *open=memchr(ln,'(',len);if(open&&memchr(open,'{',len-(size_t)(open-ln))){size_t last=(size_t)(open-ln);while(last&&ni_space((unsigned char)ln[last-1]))last--;size_t first=last;while(first&&ni_id((unsigned char)ln[first-1]))first--;if(first<last){ni_trigger(&r->full,h,full++,ln+first,last-first);if(last-first!=6||memcmp(ln+first,"printf",6))ni_trigger(&r->facts,h,facts++,ln+first,last-first);}}}at=end+1;}np_puts(&r->full,"count\t");np_putll(&r->full,h);np_puts(&r->full,"\t");np_putll(&r->full,full);np_puts(&r->full,"\n");np_puts(&r->facts,"count\t");np_putll(&r->facts,h);np_puts(&r->facts,"\t");np_putll(&r->facts,facts);np_puts(&r->facts,"\n");r->full_count+=full;r->facts_count+=facts;free(s);}r->headers=c->headers;return 0;}
static int ni_observe(NiContext *c,const char *base,int role,NiEndpoint *out){c->role=role;return ni_tree(c,base,0,out)||ni_cdeps(c,base,&out->cdeps)||ni_tree(c,base,1,out)||ni_projection(c,base,out)?-1:0;}
static int ni_equal(NiContext *c,const np_buf *a,const np_buf *b,const char *reason){
 if(a->n==b->n&&!memcmp(a->p,b->p,a->n))return 0;
 /* Canonical tree rows are kind, path, mode, bytes, digest. Report the first
  * divergent row without changing equality or trusting a diagnostic as proof. */
 if(!strcmp(reason,"necessary-data-tree-mismatch")||!strcmp(reason,"data-tree-changed-between-endpoints")){
  size_t at=0,start=0;while(at<a->n&&at<b->n&&a->p[at]==b->p[at]){if(a->p[at]=='\n')start=at+1;at++;}
  const np_buf *row=start<a->n?a:b;size_t p=start;
  while(p<row->n&&row->p[p]!='\t'&&row->p[p]!='\n')p++;
  if(p<row->n&&row->p[p]=='\t'){size_t first=++p;while(p<row->n&&row->p[p]!='\t'&&row->p[p]!='\n')p++;
   if(p>first&&p-first<4400){char path[4400];memcpy(path,row->p+first,p-first);path[p-first]=0;return ni_bad(c,reason,path);}}
 }
 return ni_bad(c,reason,0);
}
static int ni_stable(NiContext *c,const NiEndpoint *a,const NiEndpoint *b){return ni_equal(c,&a->data,&b->data,"data-tree-changed-between-endpoints")||ni_equal(c,&a->cdeps,&b->cdeps,"constructor-dependencies-changed-between-endpoints")||ni_equal(c,&a->include,&b->include,"complete-include-tree-changed-between-endpoints")||ni_equal(c,&a->full,&b->full,"full-trigger-projection-changed-between-endpoints")||ni_equal(c,&a->facts,&b->facts,"facts-trigger-projection-changed-between-endpoints")?-1:0;}
/* A single measured CX reader profile, not an arbitrary binary allowlist.
 * Original material receipts are read unchanged; no NOT_RECORDED preparation
 * field is rewritten into a native build or functional verdict. */
static const char *ni_material_files[]={"material.tsv","inputs.tsv","base-unisa_libneed.c","libneed.cx","bootstrap-input.com","bootstrap-input.com.build.json"};
static const char *ni_material_hashes[]={
 "6023a8bb24e05cd3b373dbb8cd6fc5f1553f54b0a24bacc16b79f814783b8a5c",
