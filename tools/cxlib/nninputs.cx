static int ni_hex64(const char *s){if(strlen(s)!=64)return 0;for(int i=0;i<64;i++)if(!((s[i]>='0'&&s[i]<='9')||(s[i]>='a'&&s[i]<='f')))return 0;return 1;}
static int ni_profile_field(NiContext *c,const np_buf *b,const char *key,char out[4400]){if(!b->n||b->n>32768||b->p[b->n-1]!='\n'||memchr(b->p,0,b->n)||memchr(b->p,'\r',b->n))return ni_bad(c,"code-profile-or-material-wire",key);char tag[160];int n=snprintf(tag,sizeof tag,"\n%s\t",key);if(n<0||n>=sizeof tag)return ni_bad(c,"code-profile-key-bound",key);char *p=strstr(b->p,tag);if(!p||strstr(p+1,tag))return ni_bad(c,"code-profile-unique-field",key);p+=(size_t)n;char *end=strchr(p,'\n');if(!end||end==p||end-p>=4400||memchr(p,'\t',(size_t)(end-p)))return ni_bad(c,"code-profile-field-bound",key);memcpy(out,p,(size_t)(end-p));out[end-p]=0;return 0;}
static int ni_pinned_bytes(NiContext *c,const char *path,const char *expected,np_buf *out,np_buf *profile,const char *role){size_t n;unsigned mode;char *s=ni_read(c,path,&n,&mode);if(!s)return -1;char h[65];if(ni_hash(c,s,n,h)){free(s);return -1;}if(expected&&strcmp(h,expected)){free(s);return ni_bad(c,"code-profile-pinned-input-mismatch",path);}if(out)np_put(out,s,n);free(s);if(profile){np_puts(profile,"input\t");np_puts(profile,role);np_puts(profile,"\t");np_putll(profile,mode);np_puts(profile,"\t");np_putll(profile,(long long)n);np_puts(profile,"\t");np_puts(profile,h);np_puts(profile,"\n");}return 0;}
static int ni_profile_elf(NiContext *c,const char *path,const char *expected,np_buf *profile,const char *role){np_buf b={0};if(ni_pinned_bytes(c,path,expected,&b,profile,role))return -1;int ok=b.n>=64&&!memcmp(b.p,"\177ELF",4)&&(unsigned char)b.p[4]==2&&(unsigned char)b.p[5]==1&&(unsigned char)b.p[18]==62&&b.p[19]==0;free(b.p);return ok?0:ni_bad(c,"code-profile-ELF64-x86_64-required",path);}
/* Rebuild the original generator's complete header prefix from actual current
 * headers, and compare it against the unchanged pinned inputs.tsv. This is the
 * bridge from the actual compiled material to NI's v2 include digest; a profile
 * cannot simply relabel a fixed ELF with arbitrary present-day header bytes. */
static void ni_endpoint_free(NiEndpoint *r);
static int ni_material_headers(NiContext *c,const np_buf *inputs,const char *include_sha){NiEndpoint observed={0};np_buf prefix={0};int rc=-1;if(ni_tree(c,c->root,1,&observed))goto done;np_puts(&prefix,"libneed-material-applicable-inputs-v1\nscope\tcomplete-current-include-tree-all-modes-plus-fixed-producer-support-and-original-saved-bootstrap\n");for(int i=0;i<c->entries_count;i++){NiEntry *v=&c->entries[i];np_puts(&prefix,v->kind==2?"directory\t":"header-input\t");np_puts(&prefix,v->name);np_puts(&prefix,"\t");np_putll(&prefix,v->mode);if(v->kind!=2){np_puts(&prefix,"\t");np_putll(&prefix,(long long)v->bytes);np_puts(&prefix,"\t");np_puts(&prefix,v->sha);}np_puts(&prefix,"\n");}if(inputs->n<prefix.n||memcmp(inputs->p,prefix.p,prefix.n)){ni_bad(c,"compiled-material-header-inputs-mismatch-current-tree",0);goto done;}char h[65];if(ni_hash(c,observed.include.p,observed.include.n,h))goto done;if(strcmp(h,include_sha)){ni_bad(c,"compiled-include-v2-identity-mismatch",0);goto done;}rc=0;
done:ni_endpoint_free(&observed);free(prefix.p);return rc;}
/* Read-only canonical encoder, shared with tools/libneed-native-profile.cx.
 * Caller of the public encoder must obtain include_sha from an ACTUAL legacy
 * ni_compare, not from a receipt. Fast ni_compare independently rechecks it. */
static int ni_profile_build(NiContext *c,const char *material,const char *reference,const char *include_sha,np_buf *out,ni_result *r){
 np_buf files[6]={{0}},profile={0};char material_root[4096],reference_path[4096],p[4400],field[4400];int rc=-1;struct stat st;
 if(!ni_hex64(include_sha)||material[0]!='/'||reference[0]!='/'||!realpath(material,material_root)||!realpath(reference,reference_path)||lstat(material_root,&st)||!S_ISDIR(st.st_mode)){ni_bad(c,"fast-code-profile-arguments",material);goto done;}
 np_puts(&profile,"libneed-native-code-cache-v1\nstatus\tCODE_CACHE\nscope\tmeasured-sorted-lookup-CX-reader-not-NN-or-functional-PASS\n");ni_row(&profile,"root",c->root);ni_row(&profile,"origin-snapshot-root",c->origin);ni_row(&profile,"material",material_root);ni_row(&profile,"artifact-path",c->native);ni_row(&profile,"legacy-reference-path",reference_path);ni_row(&profile,"compiled-include-canonical-v2",include_sha);
 for(int i=0;i<6;i++){if(ni_ancestors(c,material_root,ni_material_files[i])||ni_path(c,p,material_root,ni_material_files[i])||ni_pinned_bytes(c,p,ni_material_hashes[i],&files[i],&profile,ni_material_files[i]))goto done;}
 if(ni_profile_field(c,&files[0],"root",field)||strcmp(field,c->root)){ni_bad(c,"material-original-root-mismatch",material_root);goto done;}
 if(ni_profile_field(c,&files[0],"saved-bootstrap-path",field))goto done;if(field[0]!='/'){ni_bad(c,"material-original-bootstrap-path-not-absolute",field);goto done;}
 ni_row(&profile,"original-saved-bootstrap-path",field);if(ni_pinned_bytes(c,field,ni_material_hashes[4],0,&profile,"original-saved-bootstrap-artifact"))goto done;int n=snprintf(p,sizeof p,"%s.build.json",field);if(n<0||n>=sizeof p){ni_bad(c,"original-saved-record-path-bound",field);goto done;}if(ni_pinned_bytes(c,p,ni_material_hashes[5],0,&profile,"original-saved-bootstrap-record"))goto done;
 const char *support[]={"seed/unisa_libneed.c","tools/libneed-material.cx","tools/cxlib/netpack.cx","tools/cxlib/kernelsha.cx","tools/cxlib/nninputs.cx","tools/libneed-native-profile.cx"};const char *expected[]={ni_native_c,"221119d70f46f8724b67504ebcdebee719271885b8e386aabee34633f05cdf65","ba52e2f2f81d5c45482f995cc3d62f1e8ac9155cd01cbb2ce42ef0d8df232b77","8ad60f9004f98b6bd68397668e1c6feabe468bb5be4b5ec9aedc4494aa541e31",0,0};for(int i=0;i<6;i++){if(ni_ancestors(c,c->root,support[i])||ni_path(c,p,c->root,support[i])||ni_pinned_bytes(c,p,expected[i],0,&profile,support[i]))goto done;}
 if(ni_profile_elf(c,c->native,ni_fast_elf,&profile,"actual-CX-native-ELF64-x86_64")||ni_profile_elf(c,reference_path,ni_native_elf,&profile,"legacy-HOSTCC-reference-ELF64-x86_64"))goto done;
 if(ni_material_headers(c,&files[1],include_sha))goto done;
 ni_row(&profile,"compiler-command-kind","sh MAT/bootstrap-input.com");ni_row(&profile,"compiler-original-recorded-source","329cdb7077891074f638634dc7abdcd59ee39c368ad6ba1c2fcf867c3c63de2e");ni_row(&profile,"compiler-artifact-sha256",ni_material_hashes[4]);ni_row(&profile,"compiler-original-record-sha256",ni_material_hashes[5]);np_puts(&profile,"flags\t-I ");np_puts(&profile,c->root);np_puts(&profile,"/include -O2 -b lnx/x86_64\n");ni_row(&profile,"derived-CX-sha256",ni_material_hashes[3]);ni_row(&profile,"base-C-sha256",ni_native_c);ni_row(&profile,"native-artifact-sha256",ni_fast_elf);ni_row(&profile,"material-original-receipt-sha256",ni_material_hashes[0]);ni_row(&profile,"material-original-inputs-sha256",ni_material_hashes[1]);ni_row(&profile,"trust","unsigned-code-cache-input-consistency-not-historical-compilation-proof;legacy-reference-HOSTCC-nonhermetic;base-C-reused-not-NN-reconstruction");
 strcpy(r->compiled_include,include_sha);strcpy(r->compiled_material,ni_material_hashes[0]);strcpy(r->derived_source,ni_material_hashes[3]);strcpy(r->compiler_artifact,ni_material_hashes[4]);strcpy(r->compiler_record,ni_material_hashes[5]);*out=profile;memset(&profile,0,sizeof profile);rc=0;
done:for(int i=0;i<6;i++)free(files[i].p);free(profile.p);return rc;
}
static int ni_profile_check(NiContext *c,np_buf *support,ni_result *r){char p[4400];int n=snprintf(p,sizeof p,"%s.cache.tsv",c->native);if(n<0||n>=sizeof p)return ni_bad(c,"fast-code-profile-path-bound",c->native);size_t bytes;unsigned mode;char *s=ni_read(c,p,&bytes,&mode);if(!s)return -1;np_buf actual={0},expected={0};np_put(&actual,s,bytes);free(s);char root_field[4400],origin_field[4400],artifact_field[4400],material_field[4400],reference_field[4400],include_field[4400];int rc=-1;
 if(ni_profile_field(c,&actual,"root",root_field)||ni_profile_field(c,&actual,"origin-snapshot-root",origin_field)||ni_profile_field(c,&actual,"artifact-path",artifact_field)||ni_profile_field(c,&actual,"material",material_field)||ni_profile_field(c,&actual,"legacy-reference-path",reference_field)||ni_profile_field(c,&actual,"compiled-include-canonical-v2",include_field))goto done;
 if(strcmp(root_field,c->root)||strcmp(origin_field,c->origin)||strcmp(artifact_field,c->native)){ni_bad(c,"fast-code-profile-role-path-mismatch",p);goto done;}
 if(ni_profile_build(c,material_field,reference_field,include_field,&expected,r)||ni_equal(c,&actual,&expected,"fast-code-profile-canonical-bytes-mismatch")||ni_hash(c,actual.p,actual.n,r->native_profile))goto done;
 ni_row(support,"fast-code-cache-profile-path",p);ni_row(support,"fast-code-cache-profile-sha256",r->native_profile);np_puts(support,"fast-code-cache-profile-mode\t");np_putll(support,mode);np_puts(support,"\n");ni_row(support,"native-source-kind","own-CX-code-cache-with-original-C-reference-and-unsigned-input-profile");rc=0;
done:free(actual.p);free(expected.p);return rc;
}
static int ni_current_compiled_include(NiContext *c,const NiEndpoint *current,const ni_result *r){if(r->native_source_kind!=2)return 0;char h[65];if(ni_hash(c,current->include.p,current->include.n,h))return -1;return strcmp(h,r->compiled_include)?ni_bad(c,"current-before-include-does-not-match-CX-code-profile",0):0;}
static int ni_support(NiContext *c,np_buf *b,ni_result *r){c->role=2;np_puts(b,"ni-runtime-support-v2-reader-code-profile\nprovider\tni-hybrid-sha256-provider-v1-threshold1024-AF_ALG-no-fallback\n");const char *files[]={"tools/cxlib/nninputs.cx","tools/cxlib/netpack.cx","tools/cxlib/kernelsha.cx","tools/bound","tools/bound.c","seed/unisa_libneed.c"};for(int i=0;i<6;i++){char h[65];if(ni_ancestors(c,c->root,files[i])||ni_digest_file(c,c->root,files[i],h))return -1;ni_row(b,files[i],h);if(i==0)strcpy(r->verifier,h);if(i==1)strcpy(r->netpack,h);if(i==2)strcpy(r->kernelsha,h);if(i==5){if(strcmp(h,ni_native_c))return ni_bad(c,"trusted-libneed-C-source-mismatch",files[i]);strcpy(r->native_C_source,h);}}char h[65];size_t n;char *s=ni_read(c,c->native,&n,0);if(!s)return -1;int rc=ni_hash(c,s,n,h);int elf=n>=64&&!memcmp(s,"\177ELF",4)&&(unsigned char)s[4]==2&&(unsigned char)s[5]==1&&(unsigned char)s[18]==62&&s[19]==0;free(s);if(rc)return -1;if(!elf)return ni_bad(c,"trusted-libneed-native-ELF64-mismatch",c->native);strcpy(r->native_artifact,h);ni_row(b,"trusted-native-path",c->native);ni_row(b,"trusted-native-artifact",h);if(!strcmp(h,ni_native_elf)){r->native_source_kind=1;ni_row(b,"native-source-kind","legacy-HOSTCC-C-reference-explicit-nonhermetic-trust");}else if(!strcmp(h,ni_fast_elf)){r->native_source_kind=2;if(ni_profile_check(c,b,r))return -1;}else return ni_bad(c,"trusted-libneed-native-artifact-mismatch",c->native);return ni_hash(c,b->p,b->n,r->runtime_support);}
static int ni_table(NiContext *c,const char *base,np_buf *out){char dir[4400];if(ni_path(c,dir,base,"include"))return -1;char *v[]={c->bound,"12",c->native,"table",dir,0};char *env[]={"UNISACC_BOUND_CLEANUP_TRACE=","UNISACC_TIME_SCALE=1",0};np_result r;char why[1000];if(np_run(v,c->root,env,15,&r,why,sizeof why))return ni_bad(c,why,dir);int ok=!r.rc&&!r.errn&&r.outn>=24&&r.outn<=8388608&&r.out[r.outn-1]=='\n'&&!memchr(r.out,0,r.outn)&&!memchr(r.out,'\r',r.outn)&&!strncmp(r.out,"NAMES ",6)&&strstr(r.out,"\nROOTS_CLOSURE ");if(!ok){char why2[180];snprintf(why2,sizeof why2,"trusted-native-libneed-table-rc=%d stderr-bytes=%lu",r.rc,(unsigned long)r.errn);np_free(&r);return ni_bad(c,why2,dir);}np_put(out,r.out,r.outn);np_free(&r);return 0;}
static void ni_endpoint_free(NiEndpoint *r){free(r->data.p);free(r->include.p);free(r->include_shape.p);free(r->cdeps.p);free(r->full.p);free(r->facts.p);}
static int ni_impl(const char *current,const char *origin,const char *native,ni_result *out,char *why,size_t cap){
 NiContext c={0};NiEndpoint a={0},b={0},aa={0},bb={0};np_buf support={0},support_after={0},ta={0},tb={0},witness={0};ni_result result={0},after_result={0};int rc=-1;long long begin=ni_clock_ns(&c),last=begin;if(begin<0)goto done;
 if(!realpath(current,c.root)||!realpath(origin,c.origin)||!realpath(native,c.native)||!strcmp(c.root,c.origin)){ni_bad(&c,"distinct-real-root-and-native-paths",0);goto done;}struct stat st;if(lstat(c.root,&st)||!S_ISDIR(st.st_mode)||lstat(c.origin,&st)||!S_ISDIR(st.st_mode)){ni_bad(&c,"normal-root-directories",0);goto done;}if(ni_path(&c,c.bound,c.root,"tools/bound"))goto done;c.entries=calloc(16384,sizeof *c.entries);if(!c.entries){ni_bad(&c,"allocation",0);goto done;}
 if(ni_phase(&c,&last,&result.setup_ns))goto done;
 if(ni_support(&c,&support,&result)||ni_phase(&c,&last,&result.support_before_ns))goto done;
 if(ni_order(&c)||ni_phase(&c,&last,&result.order_ns))goto done;
 if(ni_observe(&c,c.root,0,&a)||ni_current_compiled_include(&c,&a,&result)||ni_phase(&c,&last,&result.current_before_ns))goto done;
 if(ni_observe(&c,c.origin,1,&b)||ni_phase(&c,&last,&result.origin_before_ns))goto done;
 if(ni_equal(&c,&a.data,&b.data,"necessary-data-tree-mismatch")||ni_equal(&c,&a.cdeps,&b.cdeps,"necessary-constructor-repository-Cdeps-mismatch")||ni_equal(&c,&a.include_shape,&b.include_shape,"include-inventory-or-mode-mismatch")||ni_equal(&c,&a.full,&b.full,"full-ordered-autoinc-trigger-mismatch")||ni_equal(&c,&a.facts,&b.facts,"printf-filtered-autoinc-trigger-mismatch"))goto done;
 if(ni_phase(&c,&last,&result.data_compare_ns))goto done;
 if(ni_table(&c,c.root,&ta)||ni_phase(&c,&last,&result.native_current_ns))goto done;
 if(ni_table(&c,c.origin,&tb)||ni_phase(&c,&last,&result.native_origin_ns))goto done;
 if(ni_equal(&c,&ta,&tb,"complete-native-libneed-canonical-table-mismatch")||ni_phase(&c,&last,&result.native_compare_ns))goto done;
 if(ni_observe(&c,c.root,0,&aa)||ni_phase(&c,&last,&result.current_after_ns))goto done;
 if(ni_observe(&c,c.origin,1,&bb)||ni_phase(&c,&last,&result.origin_after_ns))goto done;
 if(ni_stable(&c,&a,&aa)||ni_stable(&c,&b,&bb)||ni_phase(&c,&last,&result.stability_compare_ns))goto done;
 if(ni_support(&c,&support_after,&after_result)||ni_equal(&c,&support,&support_after,"runtime-support-native-or-C-source-changed")||ni_phase(&c,&last,&result.support_after_ns))goto done;
 if(ni_hash(&c,a.data.p,a.data.n,result.data)||ni_hash(&c,a.cdeps.p,a.cdeps.n,result.ctor_cdeps)||ni_hash(&c,a.include.p,a.include.n,result.current_include)||ni_hash(&c,b.include.p,b.include.n,result.origin_include)||ni_hash(&c,ta.p,ta.n,result.libneed)||ni_hash(&c,a.full.p,a.full.n,result.autoinc_full)||ni_hash(&c,a.facts.p,a.facts.n,result.autoinc_facts))goto done;
 np_puts(&witness,"nn-necessary-input-applicability-v3-reader-code-profile\nstatus\tNECESSARY_INPUTS_MATCH\nnot-claimed\tNN-PASS-or-training-or-construction-or-complete-PP-facts-or-origin-SP-DAG\n");ni_row(&witness,"current-root",c.root);ni_row(&witness,"origin-snapshot-root",c.origin);ni_row(&witness,"data",result.data);ni_row(&witness,"constructor-repository-Cdeps",result.ctor_cdeps);ni_row(&witness,"current-include",result.current_include);ni_row(&witness,"origin-include",result.origin_include);ni_row(&witness,"complete-native-libneed-table",result.libneed);ni_row(&witness,"autoinc-full",result.autoinc_full);ni_row(&witness,"autoinc-printf-filtered",result.autoinc_facts);ni_row(&witness,"runtime-support",result.runtime_support);if(ni_hash(&c,witness.p,witness.n,result.witness)||ni_phase(&c,&last,&result.finalhash_ns))goto done;result.elapsed_ns=last-begin;result.support_ns=result.support_before_ns+result.support_after_ns;
 result.data_files=a.files;result.data_dirs=a.dirs;result.data_symlinks=a.links;result.ctor_files=10;result.ordered_headers=a.headers;result.full_triggers=a.full_count;result.facts_triggers=a.facts_count;result.current_reads=c.reads[0];result.origin_reads=c.reads[1];result.support_reads=c.reads[2];result.physical_reads=c.reads[0]+c.reads[1]+c.reads[2];result.native_table_calls=2;result.native_internal_reads=-1;*out=result;rc=0;
done:
 if(rc&&why&&cap)snprintf(why,cap,"%s",c.why[0]?c.why:"nn-inputs-internal-error");ni_clear_entries(&c);free(c.entries);for(int i=0;i<c.headers;i++)free(c.order[i]);ni_endpoint_free(&a);ni_endpoint_free(&b);ni_endpoint_free(&aa);ni_endpoint_free(&bb);free(support.p);free(support_after.p);free(ta.p);free(tb.p);free(witness.p);return rc;
}
/* Fixed IPC packet keeps partial results private even if a dependency exits.
 * Process lifetime and its descendants remain under the caller's watchdog.
 * No global verdict/state survives this call; OS page cache is not a verdict. */
typedef struct {int rc;ni_result result;char why[1200];} NiPacket;
static int ni_platform_compare(const char *current_root,const char *origin_snapshot_root,const char *trusted_native,ni_result *out,char *why,size_t cap){
 if(out)memset(out,0,sizeof *out);if(why&&cap)why[0]=0;
#if !defined(__linux__) || !defined(__x86_64__)
 if(why&&cap)snprintf(why,cap,"nn-inputs-requires-Linux-x86_64-LP64");return -1;
#endif
 if(!out||!why||!cap||!current_root||!origin_snapshot_root||!trusted_native||current_root[0]!='/'||origin_snapshot_root[0]!='/'||trusted_native[0]!='/'||strpbrk(current_root,"\r\n\t")||strpbrk(origin_snapshot_root,"\r\n\t")||strpbrk(trusted_native,"\r\n\t")||sizeof(long)!=8){if(why&&cap)snprintf(why,cap,"nn-inputs-arguments");return -1;}
 int channel[2];if(pipe(channel)){snprintf(why,cap,"nn-inputs-result-pipe errno=%d",errno);return -1;}if(fcntl(channel[1],F_SETFD,FD_CLOEXEC)<0){int e=errno;close(channel[0]);close(channel[1]);snprintf(why,cap,"nn-inputs-result-pipe-cloexec errno=%d",e);return -1;}pid_t pid=fork();if(pid<0){close(channel[0]);close(channel[1]);snprintf(why,cap,"nn-inputs-fork errno=%d",errno);return -1;}
 if(!pid){close(channel[0]);if(dup2(channel[1],1)<0||dup2(channel[1],2)<0)_exit(2);NiPacket packet={0};packet.rc=ni_impl(current_root,origin_snapshot_root,trusted_native,&packet.result,packet.why,sizeof packet.why);size_t at=0;while(at<sizeof packet){ssize_t n=write(channel[1],(char *)&packet+at,sizeof packet-at);if(n<0&&errno==EINTR)continue;if(n<=0)_exit(2);at+=(size_t)n;}close(channel[1]);_exit(0);}
 close(channel[1]);NiPacket packet={0};size_t at=0;int read_bad=0;while(at<sizeof packet){ssize_t n=read(channel[0],(char *)&packet+at,sizeof packet-at);if(n<0&&errno==EINTR)continue;if(n<0){read_bad=1;break;}if(!n)break;at+=(size_t)n;}int closed=close(channel[0]),status=0;pid_t got;do{got=waitpid(pid,&status,0);}while(got<0&&errno==EINTR);if(read_bad||closed||at!=sizeof packet||got!=pid||!WIFEXITED(status)||WEXITSTATUS(status)){snprintf(why,cap,"nn-inputs-reader-failed packet-bytes=%lu status=%d errno=%d",(unsigned long)at,status,errno);return -1;}if(packet.rc){snprintf(why,cap,"%s",packet.why[0]?packet.why:"nn-inputs-reader-refused");return -1;}if(packet.result.native_table_calls!=2||packet.result.native_internal_reads!=-1||!packet.result.witness[0]||(packet.result.native_source_kind!=1&&packet.result.native_source_kind!=2)||(packet.result.native_source_kind==2&&(!packet.result.native_profile[0]||!packet.result.compiled_include[0]))){snprintf(why,cap,"nn-inputs-result-shape");return -1;}*out=packet.result;return 0;
}

/* Exported items must be unconditional for the current CX module scanner. */
int ni_compare(const char *current_root,const char *origin_snapshot_root,const char *trusted_native,ni_result *out,char *why,size_t cap){return ni_platform_compare(current_root,origin_snapshot_root,trusted_native,out,why,cap);}

/* Pure canonical encoder for the separate EXCL profile writer. It does not
 * write a profile, execute readers or turn a supplied digest into proof;
 * tools/libneed-native-profile.cx first calls actual legacy ni_compare.
 * Every material/compiler/reference/header input is physically read here. */
static int ni_profile_text_impl(const char *root,const char *origin,const char *material,const char *fast,const char *reference,const char *include_sha,np_buf *out,char *why,size_t cap){
 if(out)memset(out,0,sizeof *out);if(why&&cap)why[0]=0;if(!root||!origin||!material||!fast||!reference||!include_sha||!out||!why||!cap||root[0]!='/'||origin[0]!='/'||material[0]!='/'||fast[0]!='/'||reference[0]!='/'||strpbrk(root,"\r\n\t")||strpbrk(origin,"\r\n\t")||strpbrk(material,"\r\n\t")||strpbrk(fast,"\r\n\t")||strpbrk(reference,"\r\n\t")){if(why&&cap)snprintf(why,cap,"fast-profile-text-arguments");return -1;}
 NiContext c={0};np_buf profile={0};ni_result metadata={0};int rc=-1;if(!realpath(root,c.root)||!realpath(origin,c.origin)||!realpath(fast,c.native)||!strcmp(c.root,c.origin)){ni_bad(&c,"fast-profile-text-realpaths",0);goto done;}c.role=2;c.entries=calloc(16384,sizeof *c.entries);if(!c.entries){ni_bad(&c,"allocation",0);goto done;}if(ni_profile_build(&c,material,reference,include_sha,&profile,&metadata))goto done;*out=profile;memset(&profile,0,sizeof profile);rc=0;
done:if(rc)snprintf(why,cap,"%s",c.why[0]?c.why:"fast-profile-text-refused");ni_clear_entries(&c);free(c.entries);free(profile.p);return rc;
}
int ni_fast_profile_text(const char *root,const char *origin,const char *material,const char *fast,const char *reference,const char *include_sha,np_buf *out,char *why,size_t cap){return ni_profile_text_impl(root,origin,material,fast,reference,include_sha,out,why,cap);}
