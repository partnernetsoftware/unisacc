static void sov_field(const char *s,size_t n,const char *key,char *out,size_t cap){
    char needle[100];int z=snprintf(needle,sizeof needle,"\n%s\t",key);if(z<0||(size_t)z>=sizeof needle)sov_die("profile-field-key");
    if(!n||s[n-1]!='\n'||memchr(s,0,n)||memchr(s,'\r',n))sov_die("profile-wire");
