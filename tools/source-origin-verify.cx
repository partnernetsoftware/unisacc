static void sov_snapshot(const char *r,const char *logical,const char *snapshot,const char *pc,const char *fresh,const char *profile){
    char before[65],after[65];sov_bind_own_profile(r,profile,before);sp_origin_result result;memset(&result,0,sizeof result);char why[4096]={0};
    int refused=sov_explicit_material?sp_verify_profile_origin_package_snapshot(sov_material.id,logical,snapshot,pc,fresh,r,sov_source_root,profile,48,&result,why,sizeof why):sp_verify_origin_package_snapshot(logical,snapshot,pc,fresh,r,profile,48,&result,why,sizeof why);if(refused)sov_die(why);
    sov_bind_own_profile(r,profile,after);if(strcmp(before,after)||strcmp(after,result.execution_profile))sov_die("execution-profile-changed");
    if(result.material.jobs!=107||result.material.models!=34)sov_die("incomplete-origin-DAG");
    if(strcmp(result.current_verifier_root,r)||strcmp(result.material.verifier,result.executing_verifier)||result.execution_reads<1||result.material.physical_reads<1)sov_die("origin-executor-report-inconsistent");
    np_buf b={0};np_puts(&b,sov_explicit_material?"source-origin-snapshot-v2\n":"source-origin-snapshot-v1\n");sov_row(&b,"status","VERIFIED-origin-DAG-not-current-construction-no-test-result");if(sov_explicit_material)sov_row(&b,"material-profile",sov_material.id);
    sov_row(&b,"logical-root",result.logical_root);sov_row(&b,"snapshot-root",result.snapshot_root);sov_row(&b,"logical-package",result.logical_package);sov_row(&b,"physical-package",result.physical_package);sov_row(&b,"current-verifier-root",result.current_verifier_root);sov_row(&b,"execution-profile-path",result.execution_profile_path);sov_row(&b,"executing-elf-path",result.executing_elf_path);
    sov_row(&b,"origin-spec",result.origin_spec);sov_row(&b,"executing-verifier",result.executing_verifier);sov_row(&b,"executing-elf",result.executing_elf);sov_row(&b,"execution-profile",result.execution_profile);sov_row(&b,"execution-closure",result.execution_closure);sov_row(&b,"mapping-witness",result.mapping_witness);sov_number(&b,"execution-reads",result.execution_reads);
    sp_result *m=&result.material;sov_row(&b,"origin-source",m->source);sov_row(&b,"artifact",m->artifact);sov_row(&b,"manifest",m->manifest);sov_row(&b,"receipt",m->receipt);sov_row(&b,"witness",m->witness);sov_row(&b,"epoch-artifact",m->epoch_artifact);sov_row(&b,"epoch-record",m->epoch_record);sov_row(&b,"epoch-path",m->epoch_path);sov_row(&b,"producer",m->producer);sov_row(&b,"foundation",m->foundation);sov_row(&b,"verifier",m->verifier);sov_row(&b,"digest-module",m->digest_module);
    sov_number(&b,"jobs",m->jobs);sov_number(&b,"models",m->models);sov_number(&b,"physical-reads",m->physical_reads);sov_number(&b,"elapsed-ns",m->elapsed_ns);sov_number(&b,"wrapper-physical-reads",sov_reads);sov_stdout(&b);free(b.p);
}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
    fputs("source-origin-verify: REFUSE Linux/x86_64-LP64-native-and-proc-required\n",stderr);return 2;
#else
    if(sizeof(long)!=8||sizeof(void *)!=8)sov_die("LP64-required");
    if((argc==11||argc==12)&&!strcmp(argv[2],"--material-profile")&&!strcmp(argv[4],"--source-root")){
        if(!mp_get(argv[3],&sov_material))sov_die("unknown-material-profile");sov_explicit_material=1;if(sov_material.origin_context_version!=2)sov_die("explicit-new-material-profile-required");sov_root(argv[5],sov_source_root);char explicit_root[4096];sov_root(argv[6],explicit_root);
        if(argc==11&&!strcmp(argv[1],"--write-profile")&&!strcmp(argv[9],"--models")){sov_write_profile(explicit_root,argv[7],argv[8],argv[10]);return 0;}
        if(argc==12&&!strcmp(argv[1],"--snapshot")){sov_snapshot(explicit_root,argv[7],argv[8],argv[9],argv[10],argv[11]);return 0;}
        sov_die("explicit-material-profile-arguments");
    }
    char r[4096];if(argc==5&&!strcmp(argv[1],"--write-profile")){sov_root(argv[2],r);sov_write_profile(r,argv[3],argv[4],0);return 0;}
    if(argc==7&&!strcmp(argv[1],"--write-profile")&&!strcmp(argv[5],"--models")){sov_root(argv[2],r);sov_write_profile(r,argv[3],argv[4],argv[6]);return 0;}
    if(argc==8&&!strcmp(argv[1],"--snapshot")){sov_root(argv[2],r);sov_snapshot(r,argv[3],argv[4],argv[5],argv[6],argv[7]);return 0;}
    sov_die("usage --write-profile CURRENT_ROOT ABS_SAVED_BOOTSTRAP NEW_PROFILE [--models ABS_COMPILER_PACKAGE] | --snapshot CURRENT_ROOT LOGICAL_ROOT SNAPSHOT_ROOT LOGICAL_PC FRESH_ORIGIN_SID PROFILE");return 2;
#endif
}
