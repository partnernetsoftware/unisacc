    sov_row(&b,"sourcepackage-sha",f->sp_sha);sov_row(&b,"netpack-sha",f->np_sha);sov_row(&b,"kernelsha-sha",f->ks_sha);sov_row(&b,"include-tree-sha",f->include_sha);
    sov_row(&b,"bootstrap",f->bootstrap);sov_row(&b,"bootstrap-sha",f->bootstrap_sha);sov_row(&b,"bootstrap-record-sha",f->record_sha);
    if(v2){sov_row(&b,"compiler-package",f->compiler_package);sov_row(&b,"compiler-package-sha",f->compiler_package_sha);}
    sov_row(&b,"target","lnx/x86_64");sov_row(&b,"flags",f->flags);sov_row(&b,"elf",f->elf);sov_row(&b,"elf-sha",f->elf_sha);sov_row(&b,"scope","unsigned-consistency-not-historical-compilation-hermetic-host-or-test-PASS");return b;
}
static void sov_closure(const np_buf *profile,char profile_sha[65],char closure_sha[65]){
    sov_digest_bytes(profile->p,profile->n,profile_sha);np_buf c={0};const char *v2="sourcepackage-origin-executor-v2\n",*v3="sourcepackage-origin-executor-v3\n";np_puts(&c,profile->n>=strlen(v3)&&!memcmp(profile->p,v3,strlen(v3))?"sourcepackage-origin-execution-closure-v3\n":profile->n>=strlen(v2)&&!memcmp(profile->p,v2,strlen(v2))?"sourcepackage-origin-execution-closure-v2\n":"sourcepackage-origin-execution-closure-v1\n");np_put(&c,profile->p,profile->n);sov_digest_bytes(c.p,c.n,closure_sha);free(c.p);
