static void sov_root(const char *arg,char root_out[4096]){sov_canonical(arg);if(strlen(arg)>=4096)sov_die("root-bound");strcpy(root_out,arg);struct stat s;if(lstat(arg,&s)||!S_ISDIR(s.st_mode))sov_die("current-root-directory");}
static void sov_driver(const char *root_arg,char driver_out[4400],char h[65]){
    char own[4400];sov_path(driver_out,4400,root_arg,"tools/source-origin-verify.cx");
    if(__FILE__[0]=='/'){if(strlen(__FILE__)>=sizeof own)sov_die("own-source-bound");strcpy(own,__FILE__);}else sov_path(own,sizeof own,root_arg,__FILE__);
    sov_canonical(own);if(strcmp(own,driver_out))sov_die("own-source-must-be-current-root-wrapper");sov_digest(own,h);
}
static void sov_compiler_package(const char *r,const char *package,char path_out[4096],char hash[65]){
    sov_canonical(package);if(strlen(package)>=4096||!sov_within(package,r))sov_die("compiler-package-current-root-path");
    strcpy(path_out,package);size_t n;char *s=sov_load(package,&n);if(n<4||memcmp(s,"P 3 ",4)){free(s);sov_die("compiler-package-P3-required");}sov_digest_bytes(s,n,hash);free(s);
}
static void sov_collect(const char *root_arg,const char *bootstrap,const char *package,SovFacts *f){
    memset(f,0,sizeof *f);sov_root(root_arg,f->root);sov_canonical(bootstrap);
    if(strlen(bootstrap)>=sizeof f->bootstrap)sov_die("saved-bootstrap-bound");strcpy(f->bootstrap,bootstrap);
