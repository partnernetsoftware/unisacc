static np_buf sov_profile(const SovFacts *f){
    int v2=f->compiler_package[0]!=0,v3=f->material_profile[0]!=0;np_buf b={0};np_puts(&b,v3?"sourcepackage-origin-executor-v3\n":v2?"sourcepackage-origin-executor-v2\n":"sourcepackage-origin-executor-v1\n");
