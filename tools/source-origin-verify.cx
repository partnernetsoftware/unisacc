static void sov_stdout(const np_buf *b){size_t at=0;while(at<b->n){ssize_t z=write(1,b->p+at,b->n-at);if(z<0&&errno==EINTR)continue;if(z<=0)sov_die("stdout-write");at+=(size_t)z;}}
static void sov_profile_parent(const char *p){
    sov_clean(p);if(p[0]!='/'||strlen(p)>=4096)sov_die("absolute-new-profile-required");char parent[4096];strcpy(parent,p);char *slash=strrchr(parent,'/');
