static void sov_bind_own_profile(const char *r,const char *profile,char profile_sha[65]){
    size_t n;char *s=sov_load(profile,&n);const char *v1="sourcepackage-origin-executor-v1\n",*v2s="sourcepackage-origin-executor-v2\n",*v3s="sourcepackage-origin-executor-v3\n";int v3=n>=strlen(v3s)&&!memcmp(s,v3s,strlen(v3s));int v2=v3||(n>=strlen(v2s)&&!memcmp(s,v2s,strlen(v2s)));if(v3!=sov_explicit_material)sov_die("explicit-material-profile-version-required");if(!v2&&(n<strlen(v1)||memcmp(s,v1,strlen(v1))))sov_die("profile-schema");
