/* Independent native code-cache executor for full origin-DAG observations.
 * --write-profile CURRENT_ROOT ABS_SAVED_BOOTSTRAP NEW_PROFILE [--models ABS_COMPILER_PACKAGE]
 * v1 without --models is unchanged. v2 binds the explicit package bytes and
 * --models flag; it is a declared compilation input, not candidate qualification.
 * --snapshot CURRENT_ROOT LOGICAL_ROOT SNAPSHOT_ROOT LOGICAL_PC FRESH_ORIGIN_SID PROFILE
 * Build exactly: sh ABS_SAVED_BOOTSTRAP -I CURRENT_ROOT/include -O2
 *               -b lnx/x86_64 tools/source-origin-verify.cx -o ELF
 * The unsigned profile describes observed inputs and actual executing ELF,
 * not historical compilation, current-source NN construction or test PASS.
 * Linux/x86_64/LP64 and /proc/self/exe are explicit dependencies. Snapshot
 * performs fresh verification once, never construction or metadata writes.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.kernelsha
#pragma unisa use cxlib.sourcepackage
#pragma unisa use cxlib.mixedprofiles

static int sov_reads;
static mp_profile sov_material;
static int sov_explicit_material;
static char sov_source_root[4096];
static char *sov_tree_lines[1024];static int sov_tree_count;
static const char *sov_ks_pin="8ad60f9004f98b6bd68397668e1c6feabe468bb5be4b5ec9aedc4494aa541e31";
typedef struct {
    char root[4096],driver[4400],bootstrap[4096],elf[4096],flags[9000];
    char compiler_package[4096],compiler_package_sha[65];
    char material_profile[80],material_roles_sha[65];
    char source_root[4096];
    char driver_sha[65],sp_sha[65],np_sha[65],ks_sha[65],include_sha[65];
    char bootstrap_sha[65],record_sha[65],elf_sha[65];
} SovFacts;
static void sov_die(const char *reason){fprintf(stderr,"source-origin-verify: REFUSE %s errno=%d\n",reason,errno);exit(2);}
static void sov_clean(const char *p){if(!p||!*p||strpbrk(p,"\t\r\n"))sov_die("unclean-path-or-value");}
static void sov_path(char *p,size_t cap,const char *a,const char *b){int n=snprintf(p,cap,"%s/%s",a,b);if(n<0||(size_t)n>=cap)sov_die("path-bound");}
static int sov_within(const char *p,const char *base){size_t n=strlen(base);return !strcmp(p,base)||(!strncmp(p,base,n)&&p[n]=='/');}
static void sov_canonical(const char *p){char resolved[4400];sov_clean(p);if(p[0]!='/'||!realpath(p,resolved)||strcmp(p,resolved))sov_die("canonical-path-required");}
static void sov_digest_bytes(const void *p,size_t n,char h[65]){
    if(n>=65536){int rc=ks_sha256_hex(p,n,h);if(rc){char why[120];{ if (cx_fmt(why,sizeof why,"kernelsha-failure rc=%d",rc)) { fprintf(stderr, "source-origin-verify: text too long for why\n"); exit(2); } }sov_die(why);}}
    else cx_sha256_hex(p,n,h);
}
static char *sov_read_fd(int fd,const struct stat *initial,size_t *n){
    *n=(size_t)initial->st_size;char *s=malloc(*n+1);if(!s){close(fd);sov_die("allocation");}
    size_t at=0;int bad=0,saved=0;
    while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0){bad=1;saved=errno;break;}at+=(size_t)z;}
    char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);
    struct stat final;
    if(z||fstat(fd,&final)||initial->st_dev!=final.st_dev||initial->st_ino!=final.st_ino||initial->st_size!=final.st_size||initial->st_mode!=final.st_mode){bad=1;saved=errno;}
    if(close(fd)){bad=1;saved=errno;}
    if(bad){free(s);errno=saved;sov_die("input-extent-identity-or-close");}
    s[*n]=0;sov_reads++;return s;
}
static char *sov_load(const char *p,size_t *n){
    sov_canonical(p);struct stat a,b;
    if(lstat(p,&a)||!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>16777216)sov_die("bounded-regular-input");
    int fd=open(p,O_RDONLY|O_NOFOLLOW|O_NONBLOCK|O_CLOEXEC);if(fd<0)sov_die("input-open");
    if(fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size||a.st_mode!=b.st_mode){int e=errno;close(fd);errno=e;sov_die("input-descriptor");}
    return sov_read_fd(fd,&a,n);
}
static void sov_digest(const char *p,char h[65]){size_t n;char *s=sov_load(p,&n);sov_digest_bytes(s,n,h);free(s);}
static void sov_row(np_buf *b,const char *key,const char *value){sov_clean(key);sov_clean(value);np_puts(b,key);np_puts(b,"\t");np_puts(b,value);np_puts(b,"\n");}
static void sov_number(np_buf *b,const char *key,long long value){char s[60];{ if (cx_fmt(s,sizeof s,"%lld",value)) { fprintf(stderr, "source-origin-verify: text too long for s\n"); exit(2); } }sov_row(b,key,s);}
static int sov_line_compare(const void *a,const void *b){return strcmp(*(char *const *)a,*(char *const *)b);}
static void sov_tree(const char *base,const char *relative,int depth){
    if(depth>16||sov_tree_count==1024)sov_die("include-tree-bound");
    char p[4400],label[4400],hash[65],line[5000];
    if(*relative)sov_path(p,sizeof p,base,relative);else{if(strlen(base)>=sizeof p)sov_die("include-base-bound");strcpy(p,base);}
    sov_canonical(p);struct stat a;if(lstat(p,&a))sov_die("include-tree-stat");
    if(*relative)sov_path(label,sizeof label,"EXECUTION_HEADERS",relative);else strcpy(label,"EXECUTION_HEADERS");
    if(S_ISDIR(a.st_mode))strcpy(hash,"-");else if(S_ISREG(a.st_mode))sov_digest(p,hash);else sov_die("include-tree-symlink-or-special");
    int n=snprintf(line,sizeof line,"%s\t%s\t%o\t%s\n",S_ISDIR(a.st_mode)?"DIR":"FILE",label,(unsigned)(a.st_mode&07777),hash);
    if(n<0||(size_t)n>=sizeof line)sov_die("include-tree-line-bound");
    sov_tree_lines[sov_tree_count++]=strdup(line);if(!sov_tree_lines[sov_tree_count-1])sov_die("allocation");
    if(!S_ISDIR(a.st_mode))return;
    DIR *dir=opendir(p);if(!dir)sov_die("include-tree-opendir");
    for(;;){errno=0;struct dirent *e=readdir(dir);
        if(!e){int saved=errno,rc=closedir(dir);if(saved||rc)sov_die("include-tree-readdir-or-close");break;}
        if(!strcmp(e->d_name,".")||!strcmp(e->d_name,".."))continue;sov_clean(e->d_name);
        char next[4400];if(*relative)sov_path(next,sizeof next,relative,e->d_name);else{if(strlen(e->d_name)>=sizeof next)sov_die("include-entry-bound");strcpy(next,e->d_name);}
        sov_tree(base,next,depth+1);
    }
    struct stat end;if(lstat(p,&end)||a.st_dev!=end.st_dev||a.st_ino!=end.st_ino||a.st_mode!=end.st_mode)sov_die("include-directory-changed");
}
static void sov_include_sha(const char *root_arg,char h[65]){
    if(sov_tree_count)sov_die("include-tree-state");char p[4400];sov_path(p,sizeof p,root_arg,"include");sov_tree(p,"",0);
    qsort(sov_tree_lines,(size_t)sov_tree_count,sizeof sov_tree_lines[0],sov_line_compare);np_buf b={0};
    for(int i=0;i<sov_tree_count;i++){np_puts(&b,sov_tree_lines[i]);free(sov_tree_lines[i]);sov_tree_lines[i]=0;}
    sov_tree_count=0;sov_digest_bytes(b.p,b.n,h);free(b.p);
}
static void sov_executable(const char *root_arg,char path_out[4096],char hash_out[65]){
    ssize_t k=readlink("/proc/self/exe",path_out,4095);if(k<=0||k>=4095)sov_die("executing-ELF-readlink");path_out[k]=0;
    sov_canonical(path_out);if(!sov_within(path_out,root_arg))sov_die("executing-ELF-outside-current-root");
    struct stat a,b;if(lstat(path_out,&a)||!S_ISREG(a.st_mode)||a.st_size<64||a.st_size>16777216)sov_die("bounded-regular-executing-ELF");
    int actual=open(path_out,O_RDONLY|O_NOFOLLOW|O_NONBLOCK|O_CLOEXEC);if(actual<0)sov_die("executing-ELF-open");
    int proc=open("/proc/self/exe",O_RDONLY|O_CLOEXEC);if(proc<0){close(actual);sov_die("executing-ELF-proc-open");}
    int bad=fstat(actual,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size||a.st_mode!=b.st_mode;
    if(fstat(proc,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size||a.st_mode!=b.st_mode)bad=1;
