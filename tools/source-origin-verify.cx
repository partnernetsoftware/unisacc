}
static void sov_write_profile(const char *r,const char *bootstrap,const char *path,const char *package){
    sov_profile_parent(path);if(!sov_within(path,r))sov_die("profile-outside-current-root");SovFacts before,after;sov_collect(r,bootstrap,package,&before);np_buf b=sov_profile(&before);
    int fd=open(path,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)sov_die("exclusive-new-profile");
