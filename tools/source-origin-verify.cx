    if(sov_explicit_material){if(!package)sov_die("explicit-material-profile-requires-models");strcpy(f->material_profile,sov_material.id);sov_root(sov_source_root,f->source_root);if(!strcmp(f->source_root,f->root)||!sov_within(f->bootstrap,f->source_root))sov_die("explicit-tool-source-bootstrap-role");char saved_role[4400];sov_path(saved_role,sizeof saved_role,f->source_root,sov_material.controller_bootstrap_relative);if(strcmp(saved_role,f->bootstrap))sov_die("explicit-preserved-source-bootstrap-path");sov_path(p,sizeof p,f->root,"tools/cxlib/mixedprofiles.cx");sov_digest(p,f->material_roles_sha);}
