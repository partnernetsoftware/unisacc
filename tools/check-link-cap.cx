/* Check the link-input cap, taken from exec/facts/limits.tsv FRONT_UNIT_MAX (0.0.98: 256).
   cap-1 source arguments must pass the walk; cap+1 must be refused with the named sentence
   `too many sources (limit <cap>)`.  Fake .o paths, so the walk count is what is exercised and
   the real open fails later (ENOENT), which is not the cap.
   History: C44-LINK-CAP-01 took link inputs 64 -> 96; UNITOK2-CAP took the walk 96 -> 128;
   0.0.98 takes the walk 128 -> 256 (CXM_MAXU/DV_MAXU) and moves the number into the fact table.
   A stale installed product carries the old cap: it is reported as SKIP with the sentence it
   actually printed, never as a pass, so a product built before the change cannot look like one
   built after it.
   Assertions and the bounded child (50 s, stderr kept apart) go through testx.check. */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use text.text
#pragma unisa use testx.check

static int front_unit_max(const char *root) {
    char p[4400], ln[512]; int v = 0;
    if (cx_fmt(p, sizeof p, "%s/exec/facts/limits.tsv", root)) return 0;
    FILE *f = fopen(p, "r");
    if (!f) return 0;
    while (fgets(ln, sizeof ln, f)) if (!strncmp(ln, "FRONT_UNIT_MAX\t", 15)) { v = atoi(ln + 15); break; }
    fclose(f);
    return (v >= 2 && v <= 100000) ? v : 0;
}

int main(int argc, char **argv) {
    char root[4096], com[4400], bound[4400], work[512], out_lo[560], out_hi[560], fake[560];
    char sent[64], why[128];
    char *v[300];   /* 255 fake paths + 7 leading args + terminator */
    int i, rc, cap;
    tk_begin("");
    root[0] = 0;
    if (argc >= 2 && argv[1][0] == '/') { if (tx_copy(com, 4400, argv[1], tx_len(argv[1], 4400))) return 2; }
    else {
        if (sy_cwd(root, 4096) < 0) return 2;
        if (cx_fmt(com, sizeof com, "%s/unisacc.com", root)) return 2;
    }
    if (root[0] == 0 && sy_cwd(root, 4096) < 0) return 2;
    cap = front_unit_max(root);
    if (!cap) { printf("FAIL\tfront-unit-max-fact\tmissing-or-absurd\n"); return tk_end("CHECK_LINK_CAP", 1); }
    if (cx_fmt(bound, sizeof bound, "%s/tools/bound", root)) return 2;
    if (sy_mkdtemp(sy_tmpdir(), "link-cap-", work, (int)sizeof work) != 0) return 2;
    if (cx_fmt(out_lo, sizeof out_lo, "%s/out_lo", work) || cx_fmt(out_hi, sizeof out_hi, "%s/out_hi", work)
        || cx_fmt(fake, sizeof fake, "%s/fake.o", work)) return 2;
    if (cx_fmt(sent, sizeof sent, "too many sources (limit %d)", cap)) return 2;
    /* cap-1 sources: the walk must not refuse (the open fails ENOENT, which is not the cap). */
    i = 0;
    v[i++] = bound; v[i++] = "50"; v[i++] = com;
    v[i++] = "-b"; v[i++] = "lnx/x86_64"; v[i++] = "-o"; v[i++] = out_lo;
    { int k = 0; while (k < cap - 1) { v[i++] = fake; k = k + 1; } }
    v[i] = 0;
    if (tk_run(v, root, 50000) < 0) { printf("FAIL\tcap-minus-1-run\n"); return 2; }
    if (tk_has(tk_err(), sent)) {
        /* The product refuses below its own stated cap: that is a real defect, not staleness. */
        printf("FAIL\tcap-minus-1-passes-walk\trefused-below-cap-%d\n", cap);
        tk_ok(0, "cap-minus-1-passes-walk");
    } else if (tk_has(tk_err(), "too many sources")) {
        printf("SKIP\tcap-minus-1-passes-walk\tproduct-carries-an-older-cap\n");
    } else {
        tk_ok(1, "cap-minus-1-passes-walk");
    }
    /* cap+1 sources: the walk refuses and the sentence carries the cap. */
    i = 0;
    v[i++] = bound; v[i++] = "50"; v[i++] = com;
    v[i++] = "-b"; v[i++] = "lnx/x86_64"; v[i++] = "-o"; v[i++] = out_hi;
    { int k = 0; while (k < cap + 1) { v[i++] = fake; k = k + 1; } }
    v[i] = 0;
    rc = tk_run(v, root, 50000);
    if (rc < 0) { printf("FAIL\tcap-plus-1-run\n"); return 2; }
    tk_ok(rc == 1 && tk_has(tk_err(), "too many sources"), "cap-plus-1-refused-named");
    /* The sentence must name this build's cap, not a stale one. */
    if (!tk_has(tk_err(), "too many sources")) printf("SKIP\tcap-plus-1-names-the-cap\tproduct-accepted-%d\n", cap + 1);
    else if (!tk_has(tk_err(), sent)) {
        tx_copy(why, sizeof why, tk_err(), tx_len(tk_err(), 128));
        printf("SKIP\tcap-plus-1-names-the-cap\tstale-sentence: %s\n", why);
    } else tk_ok(1, "cap-plus-1-names-the-cap");
    return tk_end("CHECK_LINK_CAP", 0);
}
