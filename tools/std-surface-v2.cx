/* tools/std-surface-v2.cx -- migrate/normalize build/std-surface.tsv to v2 (design-core §14, stability S3).
 *
 *   sh ./unisacc.com tools/std-surface-v2.cx -- --write
 *   sh ./unisacc.com tools/std-surface-v2.cx -- --check
 *
 * --write: v1->v2 migrate, or re-normalize errors on an existing v2 table (idempotent).
 * --check: verify v2 shape (header, 14 cols, 12 caps, >=17 outs, # removed); exit 0/1.
 * Does not invent impl cells or flip status. E4/E5 signature text only for status=new. */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

enum { SS_COLS10 = 10, SS_OUT = 14, SS_MAXLINE = 4096, SS_MAXROW = 4096, SS_ERR = 256, SS_NOTE = 640 };

typedef struct { char *p; long n; } Sp;
typedef struct {
    Sp f[1];
    char pkg[32], name[64], sig[768], ana[256], err[SS_ERR];
    char lnx[160], osx[160], win[160], st[48], note[SS_NOTE];
    char stab[24], since[16], own[64], test[8];
    int is_data, area_tag;
} Row;

static Row rows[SS_MAXROW];
static int nrows, already_v2, has_caps, has_e9;
static char *src;
static size_t srcn;
static int e4_skip, e5_skip, e5_sig, e9_added, err_changed;
static int rows_before, rows_after, areas;

static int eqz(const char *a, const char *b) { return tx_eqz(a, b); }
static int same(Sp s, const char *z) { return tx_same(s.p, s.n, z, tx_len(z, 256)); }
static void sp_set(Sp *s, const char *p, long n) { s->p = (char *)p; s->n = n; }
static void cpy(char *d, long cap, Sp s) {
    long n = s.n < cap - 1 ? s.n : cap - 1;
    if (n > 0) mm_copy(d, cap, s.p, n);
    d[n] = 0;
}
static void cpyz(char *d, long cap, const char *z) {
    long n = tx_len(z, 4096);
    if (n >= cap) n = cap - 1;
    if (n > 0) mm_copy(d, cap, z, n);
    d[n] = 0;
}
static void append_note(char *note, long cap, const char *bit) {
    long n = tx_len(note, cap), b, i;
    if (!bit || !bit[0]) return;
    b = tx_len(bit, 400);
    /* skip if already present as substring */
    for (i = 0; i + b <= n; i++) if (tx_same(note + i, b, bit, b)) return;
    if (n == 1 && note[0] == '-') { cpyz(note, cap, bit); return; }
    if (n + 1 + b >= cap) return;
    if (n > 0) { note[n++] = ';'; note[n] = 0; }
    mm_copy(note + n, cap - n, bit, b);
    note[n + b] = 0;
}

static int split_tabs(const char *p, long n, Sp *out, int max) {
    int k = 0;
    long i, start = 0;
    for (i = 0; i <= n; i++)
        if (i == n || p[i] == '\t') {
            if (k < max) sp_set(&out[k], p + start, i - start);
            k++;
            start = i + 1;
        }
    return k;
}

static int name_in(const char *name, const char *const *list) {
    int i;
    for (i = 0; list[i]; i++) if (eqz(name, list[i])) return 1;
    return 0;
}

static const char *const e1_names[] = {
    "mg_buf", "mg_init", "mg_reserve", "mg_push", "mg_append", "mg_free", "mg_move", "mg_clear",
    "mg_pop", "mg_truncate", "mg_insert", "mg_remove", "mg_take",
    "ms_slice", "ms_slice_mut", "ms_none", "ms_is_none", "ms_span", "ms_of", "ms_len", "ms_at",
    "ms_eq", "ms_find", "ms_rfind", "ms_contains", "ms_starts_with", "ms_ends_with",
    "ms_mut_of", "ms_mut_len", "ms_mut_at", "ms_mut_fill", "ms_mut_copy", 0
};
static const char *const e2_names[] = { "tx_vsnprintf", "tx_snprintf", 0 };
static const char *const e3_stream[] = {
    "xs_item_set", "xs_open", "xs_add", "xs_tap", "xs_run", "xs_receipt_count",
    "xs_receipt", "xs_receipt64", "xs_receipt_id", "xs_close", 0
};
static const char *const e3_mem[] = { "mm_copy", "mm_move", "mm_fill", 0 };
static const char *const e3_sys[] = { "sy_printf", "sy_eprintf", "sy_vprintf", "sy_veprintf", "sy_puts", 0 };
static const char *const e3_text[] = { "tx_copy", "tx_field", 0 };
static const char *const e4_names[] = { "sy_stat_t", "sy_truncate", "sy_utimes", "sy_ts_t", 0 };
static const char *const e5_names[] = {
    "sy_spawn_t", "sy_child_t", "sy_tcp_accept_from", "sy_tcp_connect_to",
    "sy_udp_recv_from", "sy_unix_connect", "sy_tcp_dial", 0
};
static const char *const e6_names[] = {
    "sy_reg_size", "sy_lseek", "sy_set_mtime", "sy_now_ms", "sy_wall_s", "xs_receipt",
    "sy_dir_names", "sy_flock", "sy_local_fmt",
    "sy_run", "sy_spawn", "sy_spawn_inherit", "sy_spawn_pipe", "sy_wait_status", "sy_wait", "sy_kill",
    "sy_tcp_listen", "sy_tcp_connect", "sy_tcp_accept", "sy_wait_port", "sy_resolve4",
    "tx_atol", "tx_strtol", "tx_strtoul", "tx_strtod", 0
};
static const char *const e7_names[] = {
    "rl_tmpfile_exec", "rl_run_link", "sy_fork_session", "sy_map_none", "sy_unmap",
    "sy_protect_rw", "sy_protect_rx", "sy_at_fdcwd", "sy_openat", "sy_mkdirat",
    "sy_unlinkat", "sy_linkat", 0
};

typedef struct { const char *name; const char *cap; int mask; } E8;
static const E8 e8_tab[] = {
    { "sy_openat", "at", 4 }, { "sy_at_fdcwd", "at", 4 }, { "sy_mkdirat", "at", 4 },
    { "sy_unlinkat", "at", 4 }, { "sy_linkat", "at", 4 },
    { "sy_mkfifo", "fifo", 4 },
    { "sy_symlink", "symlink", 4 }, { "sy_readlink", "symlink", 4 },
    { "sy_setpgid", "pgroup", 4 }, { "sy_getpgid", "pgroup", 4 }, { "sy_setsid", "pgroup", 4 },
    { "sy_killpg", "pgroup", 4 }, { "sy_tcgetpgrp", "pgroup", 4 }, { "sy_tcsetpgrp", "pgroup", 4 },
    { "sy_tty_t", "termios", 4 }, { "sy_tty_get", "termios", 4 }, { "sy_tty_set", "termios", 4 },
    { "sy_tty_raw", "termios", 4 },
    { "sy_sig_handle", "posix-signal", 6 }, { "sy_sig_default", "posix-signal", 4 },
    { "sy_sig_ignore", "posix-signal", 4 }, { "sy_raise", "posix-signal", 4 },
    { "sy_map_none", "mmap-exec", 4 }, { "sy_unmap", "mmap-exec", 4 },
    { "sy_protect_rw", "mmap-exec", 4 }, { "sy_protect_rx", "mmap-exec", 4 },
    { "sy_dup2", "dup2", 4 },
    { "sy_socketpair", "socketpair", 4 },
    { "sy_kill_tree", "proc-tree", 6 }, { "rp_kill_tree", "proc-tree", 6 },
    { "rl_tmpfile_exec", "memfd-exec", 1 },
    { "sy_flock", "flock", 4 },
    { 0, 0, 0 }
};

static const E8 *e8_of(const char *name) {
    int i;
    for (i = 0; e8_tab[i].name; i++) if (eqz(name, e8_tab[i].name)) return &e8_tab[i];
    return 0;
}

static void e8_cell(char *cell, long cap, const char *cname, int bit) {
    const E8 *e = e8_of(cname);
    long n;
    if (!e || !(e->mask & bit)) return;
    n = tx_len(cell, cap);
    if (n < 8 || !tx_prefix(cell, n, "refuse:", 7)) return;
    if (eqz(cell, "refuse:ENOSYS 本版未实现")) return;
    tx_snprintf(cell, (int)cap, "refuse:ENOSYS cap=%s", e->cap);
}

/* ---- S3 errors grammar (stability.md §4) ---- */

static int is_ename_tok(const char *p, long n) {
    long i;
    if (n < 3 || p[0] != '-' || p[1] != 'E') return 0;
    for (i = 2; i < n; i++) {
        int c = (unsigned char)p[i];
        if (!((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))) return 0;
    }
    return 1;
}

static int tok_closed(const char *p, long n) {
    if (tx_same(p, n, "none", 4) || tx_same(p, n, "0/1", 3) || tx_same(p, n, "null", 4)
        || tx_same(p, n, "noreturn", 8) || tx_same(p, n, "miss:-1", 7) || tx_same(p, n, "-errno", 6))
        return 1;
    if (n > 4 && tx_prefix(p, n, "ret:", 4)) return 1;
    return is_ename_tok(p, n);
}

static int ename_prefix_len(const char *p, long n) {
    long i;
    if (n < 3 || p[0] != '-' || p[1] != 'E') return 0;
    for (i = 2; i < n; i++) {
        int c = (unsigned char)p[i];
        if (!((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))) break;
    }
    return (i >= 3) ? (int)i : 0;
}

static void push_tok(char *out, long cap, long *at, const char *tok, long tn) {
    long i;
    if (tn <= 0) return;
    /* dedupe exact token already present (split by ;) */
    {
        long s = 0;
        for (i = 0; i <= *at; i++) {
            if (i == *at || out[i] == ';') {
                if (i - s == tn && tx_same(out + s, tn, tok, tn)) return;
                s = i + 1;
            }
        }
    }
    if (*at && *at + 1 < cap) out[(*at)++] = ';';
    if (*at + tn >= cap) return;
    mm_copy(out + *at, cap - *at, tok, tn);
    *at += tn;
    out[*at] = 0;
}

static void push_z(char *out, long cap, long *at, const char *z) {
    push_tok(out, cap, at, z, tx_len(z, 128));
}

/* Map one free-text piece into closed tokens; prose -> note. */
static void map_piece(const char *p, long n, char *out, long ocap, long *at, char *note, long ncap) {
    char tmp[320];
    long i, el;
    if (n <= 0) return;
    if (n >= (long)sizeof tmp) n = (long)sizeof tmp - 1;
    mm_copy(tmp, sizeof tmp, p, n);
    tmp[n] = 0;

    if (tok_closed(p, n)) { push_tok(out, ocap, at, p, n); return; }

    /* whole-piece phrase maps */
    if (eqz(tmp, "负值表失败")) { push_z(out, ocap, at, "-EINVAL"); return; }
    if (eqz(tmp, "failed 置位")) { push_z(out, ocap, at, "ret:failed"); return; }
    if (eqz(tmp, "返回所需长度") || eqz(tmp, "返回长度") || eqz(tmp, "返回字节数") || eqz(tmp, "返回新长度")) {
        push_z(out, ocap, at, "ret:needlen"); return;
    }
    if (eqz(tmp, "返回 fd")) { push_z(out, ocap, at, "ret:fd"); return; }
    if (eqz(tmp, "返回条数")) { push_z(out, ocap, at, "ret:count"); return; }
    if (eqz(tmp, "非 0 表冲突或坏输入") || eqz(tmp, "负值表失败")) { push_z(out, ocap, at, "-EINVAL"); return; }
    if (eqz(tmp, "非 0 表坏句柄")) { push_z(out, ocap, at, "-EBADF"); return; }
    if (eqz(tmp, "非 0 且 why 写原因") || eqz(tmp, "透传步函数负码并写 why")) {
        push_z(out, ocap, at, "-errno"); push_z(out, ocap, at, "ret:why"); return;
    }
    if (eqz(tmp, "非 0 表失败")) { push_z(out, ocap, at, "-ENOMEM"); return; }
    if (eqz(tmp, "非 0 表越界") || eqz(tmp, "非 0 表长度不符")) { push_z(out, ocap, at, "-ERANGE"); return; }
    if (eqz(tmp, "非 0 表空")) { push_z(out, ocap, at, "-ENOENT"); return; }
    if (eqz(tmp, "-1 未找到")) { push_z(out, ocap, at, "miss:-1"); return; }
    if (eqz(tmp, "不返回") || eqz(tmp, "越深度即退出")) { push_z(out, ocap, at, "noreturn"); return; }
    if (eqz(tmp, "未知码返回 0") || eqz(tmp, "未知名返回 0") || eqz(tmp, "未知返回 0")) {
        push_z(out, ocap, at, "null"); return;
    }
    if (eqz(tmp, "至少返回 1")) { push_z(out, ocap, at, "ret:ge1"); return; }
    if (eqz(tmp, "SY_EAI_* 负码")) { push_z(out, ocap, at, "ret:eai"); return; }
    if (eqz(tmp, "1 取到,0 空")) { push_z(out, ocap, at, "ret:1-got-0-empty"); return; }
    if (eqz(tmp, "1 有分量,0 结束") || eqz(tmp, "1 有行,0 结束") || eqz(tmp, "1 有段,0 结束")
        || eqz(tmp, "1 有项,0 结束") || eqz(tmp, "1 有码点,0 结束")) {
        push_z(out, ocap, at, "ret:1-item-0-end"); return;
    }
    if (eqz(tmp, "0 表结束")) { push_z(out, ocap, at, "ret:eof-0"); return; }
    if (eqz(tmp, "1 已退出,0 仍在跑")) { push_z(out, ocap, at, "ret:1-exited-0-running"); return; }
    if (eqz(tmp, "1 可读,0 超时")) { push_z(out, ocap, at, "ret:1-ready-0-timeout"); return; }
    if (eqz(tmp, "1 有,0 无") || eqz(tmp, "1 删到,0 无")) { push_z(out, ocap, at, "ret:1-yes-0-no"); return; }
    if (eqz(tmp, "0 表对端关闭")) { push_z(out, ocap, at, "ret:peer-close-0"); return; }

    if (tx_prefix(tmp, n, "0 表", 4)) {
        push_z(out, ocap, at, "null");
        if (n > 4) append_note(note, ncap, tmp);
        return;
    }

    /* -errno(...) or -errno + prose */
    if (tx_prefix(tmp, n, "-errno", 6)) {
        push_z(out, ocap, at, "-errno");
        if (n == 6) return;
        if (tmp[6] == '(') {
            long r = 7;
            while (r < n && tmp[r] != ')') r++;
            if (r < n) {
                char bit[240];
                long bn = r - 7;
                if (bn > 0 && bn < (long)sizeof bit) {
                    mm_copy(bit, sizeof bit, tmp + 7, bn);
                    bit[bn] = 0;
                    append_note(note, ncap, bit);
                }
                if (r + 1 < n) append_note(note, ncap, tmp + r + 1);
            } else append_note(note, ncap, tmp + 6);
            return;
        }
        if (tmp[6] == ' ' || (unsigned char)tmp[6] > 127) {
            append_note(note, ncap, tmp + 6 + (tmp[6] == ' ' ? 1 : 0));
            /* also pull embedded -EName from the prose */
            for (i = 6; i < n; i++) {
                el = ename_prefix_len(tmp + i, n - i);
                if (el > 0) { push_tok(out, ocap, at, tmp + i, el); i += el - 1; }
            }
            return;
        }
        append_note(note, ncap, tmp + 6);
        return;
    }

    /* -EName + optional prose */
    el = ename_prefix_len(tmp, n);
    if (el > 0) {
        push_tok(out, ocap, at, tmp, el);
        if (el < n) {
            long off = el;
            if (tmp[off] == ' ') off++;
            if (off < n) {
                /* pull more -EName from remainder, rest to note */
                char rest[300];
                long rn = n - off, j, w = 0;
                for (j = 0; j < rn; j++) {
                    long e2 = ename_prefix_len(tmp + off + j, rn - j);
                    if (e2 > 0) {
                        push_tok(out, ocap, at, tmp + off + j, e2);
                        j += e2 - 1;
                    } else if (w + 1 < (long)sizeof rest) {
                        rest[w++] = tmp[off + j];
                    }
                }
                while (w > 0 && rest[w - 1] == ' ') w--;
                while (w > 0 && rest[0] == ' ') { mm_move(rest, sizeof rest, rest + 1, w - 1); w--; }
                if (w > 0) { rest[w] = 0; append_note(note, ncap, rest); }
            }
        }
        return;
    }

    /* scan for any -EName / -errno inside free text */
    {
        int got = 0;
        for (i = 0; i < n; ) {
            if (i + 6 <= n && tx_same(tmp + i, 6, "-errno", 6)) {
                push_z(out, ocap, at, "-errno");
                got = 1;
                i += 6;
                continue;
            }
            el = ename_prefix_len(tmp + i, n - i);
            if (el > 0) { push_tok(out, ocap, at, tmp + i, el); got = 1; i += el; continue; }
            i++;
        }
        if (got) { append_note(note, ncap, tmp); return; }
    }

    /* leftover Chinese / prose: nearest closed form */
    if (tx_prefix(tmp, n, "返回", 2)) { push_z(out, ocap, at, "ret:needlen"); append_note(note, ncap, tmp); return; }
    push_z(out, ocap, at, "-EINVAL");
    append_note(note, ncap, tmp);
}

static void s3_norm(char *err, long ecap, char *note, long ncap) {
    char raw[SS_ERR], out[SS_ERR];
    long at = 0, i, n, start;
    cpyz(raw, sizeof raw, err);
    n = tx_len(raw, sizeof raw);
    out[0] = 0;
    start = 0;
    for (i = 0; i <= n; i++) {
        if (i == n || raw[i] == ';') {
            long pn = i - start, s = start;
            while (pn > 0 && raw[s] == ' ') { s++; pn--; }
            while (pn > 0 && raw[s + pn - 1] == ' ') pn--;
            if (pn > 0) map_piece(raw + s, pn, out, sizeof out, &at, note, ncap);
            start = i + 1;
        }
    }
    if (!at) cpyz(out, sizeof out, "none");
    if (!eqz(err, out)) err_changed++;
    cpyz(err, ecap, out);
}

static void e1_err(char *err, long cap, const char *name) {
    if (eqz(name, "mg_pop") && eqz(err, "非 0 表空")) { cpyz(err, cap, "-ENOENT"); return; }
    if (eqz(err, "非 0 表越界") || eqz(err, "非 0 表长度不符")) { cpyz(err, cap, "-ERANGE"); return; }
    if (eqz(err, "非 0 表失败")) { cpyz(err, cap, "-ENOMEM"); return; }
    if (eqz(err, "-1 未找到")) cpyz(err, cap, "miss:-1");
}

static void e3_err(char *err, long cap, const char *name) {
    if (eqz(name, "xs_item_set")) cpyz(err, cap, "-EINVAL");
    else if (eqz(name, "xs_open")) cpyz(err, cap, "-ENOMEM;-EMFILE");
    else if (eqz(name, "xs_add")) cpyz(err, cap, "-EBADF;-EMFILE;-EINVAL");
    else if (eqz(name, "xs_tap")) cpyz(err, cap, "-EBADF");
    else if (eqz(name, "xs_run")) cpyz(err, cap, "-errno;ret:why");
    else if (eqz(name, "xs_receipt_count") || eqz(name, "xs_receipt") || eqz(name, "xs_receipt64")
             || eqz(name, "xs_receipt_id") || eqz(name, "xs_close")) cpyz(err, cap, "-EBADF");
    else if (name_in(name, e3_mem) || name_in(name, e3_text)) cpyz(err, cap, "-ERANGE");
    else if (name_in(name, e3_sys)) cpyz(err, cap, "-errno");
}

static void e5_sig_new(char *sig, long cap, const char *name) {
    if (eqz(name, "sy_tcp_accept_from"))
        cpyz(sig, cap, "int sy_tcp_accept_from(int fd, sy_deadline_t d, sy_addr_t *peer);");
    else if (eqz(name, "sy_tcp_connect_to"))
        cpyz(sig, cap, "int sy_tcp_connect_to(const sy_addr_t *a, sy_deadline_t d);");
    else if (eqz(name, "sy_udp_recv_from"))
        cpyz(sig, cap, "long sy_udp_recv_from(int fd, void *buf, long n, sy_addr_t *from, sy_deadline_t d);");
    else if (eqz(name, "sy_unix_connect"))
        cpyz(sig, cap, "int sy_unix_connect(const char *path, sy_deadline_t d);");
    else if (eqz(name, "sy_tcp_dial"))
        cpyz(sig, cap, "int sy_tcp_dial(const char *host, int port, sy_deadline_t d);");
}

static void own_of(char *own, long cap, const char *name) {
    if (tx_prefix(name, tx_len(name, 64), "sy_open", 7)) cpyz(own, cap, "open:fd close:sy_close");
    else if (eqz(name, "sy_dir_open")) cpyz(own, cap, "open:dir close:sy_dir_close");
    else if (eqz(name, "mm_alloc") || eqz(name, "mm_zalloc")) cpyz(own, cap, "open:heap close:mm_free");
    else if (eqz(name, "mg_init") || eqz(name, "mg_buf")) cpyz(own, cap, "open:mg close:mg_free");
    else if (eqz(name, "xs_open")) cpyz(own, cap, "open:pipe close:xs_close");
    else if (eqz(name, "ms_none") || eqz(name, "ms_span") || eqz(name, "ms_of") || eqz(name, "ms_mut_of")
             || eqz(name, "ms_slice") || eqz(name, "ms_slice_mut")) cpyz(own, cap, "borrow");
    else cpyz(own, cap, "none");
}

static void stab_of(char *stab, long cap, const char *pkg, const char *name) {
    if (name_in(name, e6_names)) cpyz(stab, cap, "legacy");
    else if (name_in(name, e7_names)) cpyz(stab, cap, "internal");
    else if (tx_prefix(pkg, tx_len(pkg, 32), "ext.", 4)) cpyz(stab, cap, "incubating");
    else cpyz(stab, cap, "pre");
}

static void transform_row(Row *r) {
    if (!already_v2) {
        int is_new = eqz(r->st, "new");
        if (name_in(r->name, e1_names) && eqz(r->pkg, "ext.memx")) {
            cpyz(r->pkg, sizeof r->pkg, "cx.mem");
            e1_err(r->err, sizeof r->err, r->name);
        }
        if (name_in(r->name, e2_names) && eqz(r->pkg, "ext.textx")) cpyz(r->pkg, sizeof r->pkg, "cx.text");
        if (name_in(r->name, e3_stream) || name_in(r->name, e3_mem) || name_in(r->name, e3_sys) || name_in(r->name, e3_text))
            e3_err(r->err, sizeof r->err, r->name);
        if (name_in(r->name, e4_names) && !is_new) { e4_skip++; append_note(r->note, sizeof r->note, "pending E4"); }
        if (name_in(r->name, e5_names)) {
            if (!is_new) { e5_skip++; append_note(r->note, sizeof r->note, "pending E5"); }
            else { e5_sig_new(r->sig, sizeof r->sig, r->name); e5_sig++; }
        }
        e8_cell(r->lnx, sizeof r->lnx, r->name, 1);
        e8_cell(r->osx, sizeof r->osx, r->name, 2);
        e8_cell(r->win, sizeof r->win, r->name, 4);
        stab_of(r->stab, sizeof r->stab, r->pkg, r->name);
        cpyz(r->since, sizeof r->since, "0.1.0");
        own_of(r->own, sizeof r->own, r->name);
        cpyz(r->test, sizeof r->test, "-");
    }
    s3_norm(r->err, sizeof r->err, r->note, sizeof r->note);
}

static void load(const char *path) {
    long i = 0;
    src = cx_read(path, &srcn);
    if (!src) { sy_eprintf("std-surface-v2\tcannot read %s\n", path); exit(2); }
    while (i < (long)srcn) {
        long e = i, n;
        Sp f[SS_OUT + 2];
        int k;
        Row *r;
        while (e < (long)srcn && src[e] != '\n') e++;
        n = e - i;
        if (nrows >= SS_MAXROW) { sy_eprintf("std-surface-v2\trow bound\n"); exit(2); }
        r = &rows[nrows];
        mm_fill(r, (long)sizeof *r, 0, (long)sizeof *r);
        if (nrows == 0 && tx_same(src + i, n, "# std-surface v2", 16)) already_v2 = 1;
        if (n > 5 && tx_prefix(src + i, n, "# cap\t", 6)) has_caps = 1;
        if (n > 7 && tx_prefix(src + i, n, "# area ", 7)) {
            areas++;
            r->is_data = 0;
            sp_set(&r->f[0], src + i, n);
        } else if (n > 0 && src[i] != '#') {
            k = split_tabs(src + i, n, f, SS_OUT + 2);
            if (k != SS_COLS10 && k != SS_OUT) {
                sy_eprintf("std-surface-v2\tbad cols line near %ld k=%d\n", (long)nrows, k);
                exit(2);
            }
            r->is_data = 1;
            rows_before++;
            cpy(r->pkg, sizeof r->pkg, f[0]);
            cpy(r->name, sizeof r->name, f[1]);
            cpy(r->sig, sizeof r->sig, f[2]);
            cpy(r->ana, sizeof r->ana, f[3]);
            cpy(r->err, sizeof r->err, f[4]);
            cpy(r->lnx, sizeof r->lnx, f[5]);
            cpy(r->osx, sizeof r->osx, f[6]);
            cpy(r->win, sizeof r->win, f[7]);
            cpy(r->st, sizeof r->st, f[8]);
            cpy(r->note, sizeof r->note, f[9]);
            if (k == SS_OUT) {
                cpy(r->stab, sizeof r->stab, f[10]);
                cpy(r->since, sizeof r->since, f[11]);
                cpy(r->own, sizeof r->own, f[12]);
                cpy(r->test, sizeof r->test, f[13]);
            }
            if (eqz(r->name, "sy_err_kind")) has_e9 = 1;
            transform_row(r);
        } else {
            r->is_data = 0;
            sp_set(&r->f[0], src + i, n);
        }
        nrows++;
        i = e + 1;
    }
}

static void mark_inserts(void) {
    int i, in = 0, last = -1;
    if (has_e9 || already_v2) return;
    for (i = 0; i < nrows; i++) {
        if (!rows[i].is_data && rows[i].f[0].n > 7 && tx_prefix(rows[i].f[0].p, rows[i].f[0].n, "# area ", 7)) {
            if (last >= 0) {
                if (in == 1) rows[last].area_tag = 1;
                else if (in == 2) rows[last].area_tag = 2;
                else if (in == 3) rows[last].area_tag = 3;
            }
            last = -1;
            if (same(rows[i].f[0], "# area stream")) in = 1;
            else if (same(rows[i].f[0], "# area net")) in = 2;
            else if (same(rows[i].f[0], "# area sys")) in = 3;
            else in = 0;
        } else if (rows[i].is_data && (in == 1 || in == 2 || in == 3)) {
            last = i;
        }
    }
    if (last >= 0) {
        if (in == 1) rows[last].area_tag = 1;
        else if (in == 2) rows[last].area_tag = 2;
        else if (in == 3) rows[last].area_tag = 3;
    }
}

static void emit_row(char *dst, long cap, long *at, Row *r) {
    int n = tx_snprintf(dst + *at, (int)(cap - *at),
                        "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n",
                        r->pkg, r->name, r->sig, r->ana, r->err, r->lnx, r->osx, r->win,
                        r->st, r->note, r->stab, r->since, r->own, r->test);
    if (n < 0 || *at + n >= cap) { sy_eprintf("std-surface-v2\toutbound\n"); exit(2); }
    *at += n;
    rows_after++;
}

static void emit_e9(char *dst, long cap, long *at, int which) {
    const char *refuse = "refuse:ENOSYS 本版未实现";
    Row r;
    mm_fill(&r, (long)sizeof r, 0, (long)sizeof r);
    cpyz(r.st, sizeof r.st, "new");
    cpyz(r.lnx, sizeof r.lnx, refuse);
    cpyz(r.osx, sizeof r.osx, refuse);
    cpyz(r.win, sizeof r.win, refuse);
    cpyz(r.since, sizeof r.since, "0.1.0");
    cpyz(r.test, sizeof r.test, "-");
    cpyz(r.own, sizeof r.own, "none");
    if (which == 3) {
        cpyz(r.pkg, sizeof r.pkg, "cx.sys"); cpyz(r.stab, sizeof r.stab, "pre");
        cpyz(r.name, sizeof r.name, "sy_err_kind");
        cpyz(r.sig, sizeof r.sig, "int sy_err_kind(int e);");
        cpyz(r.ana, sizeof r.ana, "Rust io::Error::kind; Python OSError");
        cpyz(r.err, sizeof r.err, "none");
        cpyz(r.note, sizeof r.note, "返回 SY_K_* 类,未知码归 OTHER");
        emit_row(dst, cap, at, &r); e9_added++;
        cpyz(r.name, sizeof r.name, "sy_cap");
        cpyz(r.sig, sizeof r.sig, "int sy_cap(int cap);");
        cpyz(r.ana, sizeof r.ana, "QuickJS 能力表");
        cpyz(r.err, sizeof r.err, "0/1");
        cpyz(r.note, sizeof r.note, "能力查询,未知能力为 0");
        emit_row(dst, cap, at, &r); e9_added++;
        cpyz(r.name, sizeof r.name, "sy_res_live");
        cpyz(r.sig, sizeof r.sig, "long sy_res_live(int kind);");
        cpyz(r.ana, sizeof r.ana, "Python ResourceWarning 计数");
        cpyz(r.err, sizeof r.err, "-EINVAL");
        cpyz(r.note, sizeof r.note, "句柄型资源存活数");
        emit_row(dst, cap, at, &r); e9_added++;
    } else if (which == 1) {
        cpyz(r.pkg, sizeof r.pkg, "cx.stream"); cpyz(r.stab, sizeof r.stab, "pre");
        cpyz(r.name, sizeof r.name, "xs_reader_deadline");
        cpyz(r.sig, sizeof r.sig, "int xs_reader_deadline(int r, sy_deadline_t d);");
        cpyz(r.ana, sizeof r.ana, "Rust Read 带超时");
        cpyz(r.err, sizeof r.err, "-EBADF");
        cpyz(r.note, sizeof r.note, "之后的读到期返回 -ETIMEDOUT");
        emit_row(dst, cap, at, &r); e9_added++;
        cpyz(r.name, sizeof r.name, "xs_writer_deadline");
        cpyz(r.sig, sizeof r.sig, "int xs_writer_deadline(int w, sy_deadline_t d);");
        cpyz(r.ana, sizeof r.ana, "Rust Write 带超时");
        cpyz(r.err, sizeof r.err, "-EBADF");
        cpyz(r.note, sizeof r.note, "之后的写到期返回 -ETIMEDOUT");
        emit_row(dst, cap, at, &r); e9_added++;
    } else if (which == 2) {
        cpyz(r.pkg, sizeof r.pkg, "ext.net"); cpyz(r.stab, sizeof r.stab, "incubating");
        cpyz(r.name, sizeof r.name, "sy_recv_until");
        cpyz(r.sig, sizeof r.sig, "long sy_recv_until(int fd, void *buf, long n, sy_deadline_t d);");
        cpyz(r.ana, sizeof r.ana, "POSIX recv 带截止");
        cpyz(r.err, sizeof r.err, "-errno;-ETIMEDOUT");
        cpyz(r.note, sizeof r.note, "0 表对端关闭");
        emit_row(dst, cap, at, &r); e9_added++;
        cpyz(r.name, sizeof r.name, "sy_send_all_until");
        cpyz(r.sig, sizeof r.sig, "int sy_send_all_until(int fd, const void *buf, long n, sy_deadline_t d);");
        cpyz(r.ana, sizeof r.ana, "POSIX send 写完或失败");
        cpyz(r.err, sizeof r.err, "-errno;-ETIMEDOUT");
        cpyz(r.note, sizeof r.note, "写完或失败");
        emit_row(dst, cap, at, &r); e9_added++;
    }
}

static int emit_line(char *dst, long cap, long *at, const char *z) {
    int n = tx_snprintf(dst + *at, (int)(cap - *at), "%s\n", z);
    if (n < 0 || *at + n >= cap) return -1;
    *at += n;
    return 0;
}

static long build(char *dst, long cap) {
    long at = 0;
    int i, saw_col = 0, saw_removed = 0, outs_extra = 0;
    mark_inserts();
    if (emit_line(dst, cap, &at, "# std-surface v2")) return -1;
    for (i = 0; i < nrows; i++) {
        Row *r = &rows[i];
        if (r->is_data) {
            emit_row(dst, cap, &at, r);
            if (r->area_tag) emit_e9(dst, cap, &at, r->area_tag);
            continue;
        }
        if (same(r->f[0], "# std-surface v1") || same(r->f[0], "# std-surface v2")) continue;
        if (r->f[0].n > 5 && tx_prefix(r->f[0].p, r->f[0].n, "# pkg", 5)) {
            if (emit_line(dst, cap, &at,
                          "# pkg\tname\tsignature\tanalogue\terrors\tlnx\tosx\twin\tstatus\tnote\tstab\tsince\town\ttest"))
                return -1;
            saw_col = 1;
            continue;
        }
        if (!has_caps && r->f[0].n > 7 && tx_prefix(r->f[0].p, r->f[0].n, "# area ", 7) && !saw_removed) {
            if (!outs_extra) {
                if (emit_line(dst, cap, &at, "# out\tfs-watch\t不做文件系统监视;各平台语义不一")) return -1;
                if (emit_line(dst, cap, &at, "# out\tcalendar-tz\t不做本地时区、时区库与日历运算;只有 UTC")) return -1;
                if (emit_line(dst, cap, &at, "# out\tregex-glob\t正则、glob、通配留在 ext.*")) return -1;
                if (emit_line(dst, cap, &at, "# out\tuser-host-db\t不做用户与组数据库、主机统计")) return -1;
                if (emit_line(dst, cap, &at, "# out\traw-net\t不做原始套接字、组播、DNS 记录查询")) return -1;
                if (emit_line(dst, cap, &at, "# out\tdata-formats\tJSON/TOML/命令行参数解析等留在 ext.*;TSV 已在 ext.tsvx")) return -1;
                outs_extra = 1;
            }
            if (emit_line(dst, cap, &at, "# cap\tat\t*at 族相对目录句柄")) return -1;
            if (emit_line(dst, cap, &at, "# cap\tfifo\t命名管道")) return -1;
            if (emit_line(dst, cap, &at, "# cap\tsymlink\t符号链接")) return -1;
            if (emit_line(dst, cap, &at, "# cap\tpgroup\t进程组与会话")) return -1;
            if (emit_line(dst, cap, &at, "# cap\ttermios\t终端属性")) return -1;
            if (emit_line(dst, cap, &at, "# cap\tposix-signal\tPOSIX 信号处置与 raise")) return -1;
            if (emit_line(dst, cap, &at, "# cap\tmmap-exec\t可执行映射与保护")) return -1;
            if (emit_line(dst, cap, &at, "# cap\tdup2\t指定目标号的 dup")) return -1;
            if (emit_line(dst, cap, &at, "# cap\tsocketpair\t本地双工套接字对")) return -1;
            if (emit_line(dst, cap, &at, "# cap\tproc-tree\t进程树遍历与杀灭")) return -1;
            if (emit_line(dst, cap, &at, "# cap\tmemfd-exec\t内存映像直接 exec")) return -1;
            if (emit_line(dst, cap, &at, "# cap\tflock\tBSD flock 文件锁")) return -1;
            if (emit_line(dst, cap, &at, "# removed")) return -1;
            saw_removed = 1;
        }
        {
            char tmp[SS_MAXLINE];
            if (r->f[0].n >= SS_MAXLINE) return -1;
            mm_copy(tmp, SS_MAXLINE, r->f[0].p, r->f[0].n);
            tmp[r->f[0].n] = 0;
            if (emit_line(dst, cap, &at, tmp)) return -1;
        }
    }
    if (!saw_col) {
        sy_eprintf("std-surface-v2\tmissing column header in input\n");
        return -1;
    }
    return at;
}

static int check_v2(const char *path) {
    char *t;
    size_t tn = 0;
    long i = 0, line = 0;
    int caps = 0, outs = 0, removed = 0, bad = 0, data = 0, s3bad = 0;
    t = cx_read(path, &tn);
    if (!t) { sy_eprintf("std-surface-v2\tcannot read %s\n", path); return 1; }
    while (i < (long)tn) {
        long e = i, n;
        Sp f[SS_OUT + 2];
        int k;
        while (e < (long)tn && t[e] != '\n') e++;
        n = e - i;
        line++;
        if (line == 1) {
            if (!tx_same(t + i, n, "# std-surface v2", 16)) {
                sy_eprintf("FAIL\tv2 header\n");
                bad++;
            }
        } else if (n > 5 && tx_prefix(t + i, n, "# out\t", 6)) outs++;
        else if (n > 5 && tx_prefix(t + i, n, "# cap\t", 6)) caps++;
        else if (tx_same(t + i, n, "# removed", 9)) removed++;
        else if (n > 0 && t[i] != '#') {
            k = split_tabs(t + i, n, f, SS_OUT + 2);
            if (k != SS_OUT) {
                sy_eprintf("FAIL\tline=%ld cols=%d want=14\n", line, k);
                bad++;
            } else {
                /* soft S3 report: each ; piece must be closed */
                long a = 0, en = f[4].n;
                const char *ep = f[4].p;
                while (a <= en) {
                    long b = a;
                    while (b < en && ep[b] != ';') b++;
                    if (b > a && !tok_closed(ep + a, b - a)) {
                        if (s3bad < 8)
                            sy_eprintf("FAIL\ts3\tline=%ld\t%.*s\n", line, (int)(b - a > 80 ? 80 : b - a), ep + a);
                        s3bad++;
                    }
                    a = b + 1;
                }
            }
            data++;
        }
        i = e + 1;
    }
    mm_free(t);
    if (caps != 12) { sy_eprintf("FAIL\tcaps=%d want=12\n", caps); bad++; }
    if (outs < 17) { sy_eprintf("FAIL\touts=%d want>=17\n", outs); bad++; }
    if (!removed) { sy_eprintf("FAIL\tmissing # removed\n"); bad++; }
    if (s3bad) { sy_eprintf("FAIL\ts3_pieces=%d\n", s3bad); bad++; }
    sy_printf("STD_SURFACE_V2\tcheck\trows=%d\tcaps=%d\touts=%d\tremoved=%d\ts3bad=%d\tfailed=%d\n",
              data, caps, outs, removed, s3bad, bad);
    return bad ? 1 : 0;
}

int main(int argc, char **argv) {
    const char *path = "build/std-surface.tsv";
    int check = 0;
    char *out;
    long cap = 1 << 21, n;
    if (argc < 2 || argc > 3) {
        sy_eprintf("std-surface-v2\tusage\t--write|--check [PATH]\n");
        return 2;
    }
    if (eqz(argv[1], "--write")) { /* write */ }
    else if (eqz(argv[1], "--check")) check = 1;
    else { sy_eprintf("std-surface-v2\tusage\t--write|--check [PATH]\n"); return 2; }
    if (argc == 3) path = argv[2];
    if (check) return check_v2(path);
    load(path);
    out = mm_alloc(cap);
    if (!out) { sy_eprintf("std-surface-v2\talloc\n"); return 2; }
    n = build(out, cap);
    if (n < 0) return 2;
    if (sy_write_atomic(path, out, n, 0644)) {
        sy_eprintf("std-surface-v2\tcannot write %s\n", path);
        return 2;
    }
    sy_printf("STD_SURFACE_V2\twrite\talready_v2=%d\trows_before=%d\trows_after=%d\tareas=%d\te9=%d\terr_changed=%d\te4_skip=%d\te5_skip=%d\te5_sig=%d\n",
              already_v2, rows_before, rows_after, areas, e9_added, err_changed, e4_skip, e5_skip, e5_sig);
    mm_free(out);
    return 0;
}
