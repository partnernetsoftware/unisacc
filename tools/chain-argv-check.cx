/* 静态支持域：C 词法（跳过注释）、局部 char* 数组的初始化、常数下标、
 * n++ 追加、空终止，以及 step/step_secs -> bound_sh_secs 包装。
 * whole-front 的根/分片尾参数保留符号重复量：cf_root_count()、slices；
 * 核实际 for 归纳变量、bound、append 元素一致，不复制事实表数值。
 * callee 的 needs/usage 与 argc 守卫共同生成位置合同；选项从实际 argv[i]
 * 分支读取，是否消费值由该分支 argv[++i] 决定。位置角色是显式命名域，
 * 不猜测任意表达式：未知表达式、别名写入或包装变化均 REFUSE（退出 2）。
 * 只核参数形状/角色，不宣称路径存在、运行成功或链资格。条件选项追加按
 * 每个源码分支分别核其形状，不证明选项之间的运行时互斥。无编译/真链。
 * 用法：chain-argv-check [CANDIDATE CHAIN_STEP WHOLE_FRONT]
 */
#pragma unisa use cxlib.chainargv
#pragma unisa use sys.fs
int main(int argc,char **argv){
 if(argc!=1&&argc!=4){fprintf(stderr,"usage: chain-argv-check [CANDIDATE CHAIN_STEP WHOLE_FRONT]\n");return 2;}
 const char *paths[]={"tools/candidate-chain.cx","tools/chain-step.cx","tools/whole-front.cx"};char *b[3];size_t n;
 for(int i=0;i<3;i++){b[i]=cx_read(argc==4?argv[i+1]:paths[i],&n);if(!b[i]){fprintf(stderr,"REFUSE source unreadable\n");return 2;}if(memchr(b[i],0,n)){fprintf(stderr,"REFUSE source NUL\n");return 2;}}
 int rc=ca_check(b[0],b[1],b[2],0,0,0);for(int i=0;i<3;i++)free(b[i]);return rc;
}
