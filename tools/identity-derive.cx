/* tools/identity-derive.cx -- ROOT is the product tree.
 *   sh ./unisacc.com tools/identity-derive.cx -- ROOT --check
 *   sh ./unisacc.com tools/identity-derive.cx -- ROOT --write
 * Master: installed unisacc.com bytes. Orchestrates existing
 *   tools/check-root-identity.cx [--emit]
 * --check: FAIL if the derived root-identity block disagrees (prints that tool's DIFF).
 * --write: emit the block. No new hash logic. */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.sha
#pragma unisa use sys.fs
static void die(const char *s){fprintf(stderr,"identity-derive: %s\n",s);exit(2);}
int main(int argc,char **argv){
    int a=argc>=2&&!strcmp(argv[1],"--")?2:1, write=0, check=0, i;
    const char *root=0;
    for(i=a;i<argc;i++){
        if(!strcmp(argv[i],"--write")) write=1;
        else if(!strcmp(argv[i],"--check")) check=1;
        else if(argv[i][0]=='/' && !root) root=argv[i];
        else die("usage: ROOT --check|--write");
    }
    if(!root||write==check) die("usage: ROOT --check|--write");
    np_result r;char why[1200];
    char *v[8];int k=0;
    v[k++]="sh";v[k++]="./unisacc.com";v[k++]="tools/check-root-identity.cx";v[k++]="--";v[k++]=(char*)root;
    if(write) v[k++]="--emit";
    v[k]=0;
    if(np_run(v,".",0,40,&r,why,sizeof why)){fprintf(stderr,"identity-derive: transport %s\n",why);return 2;}
    if(r.outn)fwrite(r.out,1,r.outn,stdout);
    if(r.errn)fwrite(r.err,1,r.errn,stderr);
    int rc=r.rc; np_free(&r);
    if(check&&rc){fputs("IDENTITY_DERIVE\tDIFF\troot-identity\n",stdout);return 1;}
    {char com[4400], rec[4400], hex[65]; size_t n=0; char *b;
     if(cx_fmt(com,sizeof com,"%s/unisacc.com",root)||cx_fmt(rec,sizeof rec,"%s/ape-receipt.txt",root)) die("path");
     b=cx_read(com,&n); if(!b) die("product");
     cx_sha256_hex(b,n,hex); free(b);
     b=cx_read(rec,&n); if(!b) die("ape-receipt");
     if(!strstr(b,hex)){fputs("IDENTITY_DERIVE\tDIFF\tape-receipt\n",stdout);free(b);return 1;}
     free(b);}
    puts(write?"IDENTITY_DERIVE\tWRITE\troot-identity":"IDENTITY_DERIVE\tCHECK\tok");
    return rc?1:0;
}
