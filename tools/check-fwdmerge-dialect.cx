/* tools/check-fwdmerge-dialect.cx -- 杠杆1 的先失败用例:方言表化前后的判定差。
 *
 *   sh ./unisacc.com tools/check-fwdmerge-dialect.cx
 *
 * fwm_merge(cx/compiler/fwdmerge.cx:157)今天把合并断言写死成 ELF/x86_64 方言字面量
 * (`.unit 2`、`main:`、`__init_u:`、`__main_ret:`、`__init:`、`  ret`、`  .exit r0`)。
 * 因此一段 Mach-O/arm64 形状的磁带必然在第一个断言处返回 0,而 driver 随后整段
 * units→e3→prune→lower→elf 重跑 —— 这就是要消掉的第二遍 e3。
 *
 * 夹具来源:out/fwm-probe/ASSERTIONS.md 的断言链打点表(在 out/ 副本里给每条 goto done
 * 前插 stage 序号定位)。下面这条 ELF 磁带是**合成**的,不是 driver 实际产出的磁带 ——
 * 真数据正例要等 INSTALL44 装好、能在 dv_fw_merge 落盘真磁带后再补(C 方案),
 * 在那之前真数据一项记 NOT_RUN,不记 PASS。
 *
 * 本检查用合成磁带直接调 fwm_merge:
 *   D1 Mach-O/arm64 形状的磁带:今天必须返回 0(失败用例,红);方言表化后应返回 1
 *      —— 所以断言写成「与当前实现一致」的形式会永远绿,这里刻意断言返回 0,
 *      表化落地时本文件必须同步改成 1(改动即证据)。
 *   D2 ELF/x86_64 形状的磁带:前后都必须返回 1(防回归)
 *   D3 ELF/x86_64 的合并结果逐字节稳定(同一输入两次相同)
 *   D4 首行不是 `.unit 2` 的磁带一律返回 0(边界,防止把任意文本当磁带)
 *
 * 末行 FWDMERGE_DIALECT_CHECK<TAB>assertions=N<TAB>failed=M;任何 FAIL 退出 1。
 */
#pragma unisa use compiler.fwdmerge
#pragma unisa use sys.fs

static int fd_n, fd_failed;
static char fd_root[4096];

static void fd_die(const char *s) { fprintf(stderr, "check-fwdmerge-dialect: %s\n", s); exit(2); }

static void fd_ck(int ok, const char *what) {
    fd_n++;
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", what);
    if (!ok) fd_failed++;
}

/* the allocator trio the driver injects (src/driveroute.cx:189-193) */
static void *fd_alloc(void *p, long long n) { return realloc(p, n ? (size_t)n : 1); }
static void fd_release(void *p) { free(p); }
static void fd_fail(char *m) { fprintf(stderr, "fwdmerge: %s\n", m ? m : "failure"); fd_failed++; }

/* Build a tape from a NUL-terminated text; the FwmBuf layout is {b, at, n, cap}. */
static void fd_tape(const char *text, FwmBuf *out) {
    size_t n = strlen(text);
    out->b = (unsigned char *)text;
    out->at = 0;
    out->n = (int)n;
    out->cap = (int)n;
}

/* ELF/x86_64 shape: the stub carries main:/__init_u:/__main_ret:, the base carries
   __init:/__main_ret:; tapes have one final .end. fwm_export seeds the symbols. */
static const char *fd_elf_unit =
    ".unit 2\n"
    ".global helper\n.end\n";
static const char *fd_elf_stub =
    ".global main\n"
    ".bss x 8\n"
    "main:\n"
    "  call __init_u\n"
    "  ret\n"
    "__init_u:\n"
    "  call exit\n"
    "  .exit r0\n"
    "  ret\n"
    "__main_ret:\n"
    "  .exit r0\n.end\n";
static const char *fd_elf_base =
    ".str S0 \"x\"\n"
    "__init:\n"
    "  ret\n"
    "  call helper\n"
    "__main_ret:\n"
    "  ret\n.end\n";

/* Mach-O/arm64 shape: same structure, different labels -- `_main`, `__init_u` without the
   trailing colon form the ELF merge expects, and `  bl` instead of `  call`. */
static const char *fd_macho_unit =
    ".unit 2\n"
    ".global _helper\n.end\n";
static const char *fd_macho_stub =
    ".global _main\n"
    "_main:\n"
    "  bl ___init_u\n"
    "  ret\n"
    "___init_u:\n"
    "  bl _exit\n"
    "  ret\n"
    "__main_ret:\n"
    "  ret\n.end\n";
static const char *fd_macho_base =
    "_init:\n"
    "  ret\n"
    "  bl _helper\n"
    "__main_ret:\n"
    "  ret\n.end\n";

static int fd_run(const char *unit, const char *stub, const char *base, FwmBuf *out) {
    FwmBuf u, s, bb;
    fd_tape(unit, &u);
    fd_tape(stub, &s);
    fd_tape(base, &bb);
    memset(out, 0, sizeof *out);
    out->b = 0;
    out->at = 0;
    out->n = 0;
    out->cap = 0;
    return fwm_merge(&bb, &s, &u, 0, out);
}

static int fd_contains(const FwmBuf *b, const char *s) {
    int n = (int)strlen(s);
    for (int i = 0; i <= b->n - n; i++) if (!memcmp(b->b + i, s, (size_t)n)) return 1;
    return 0;
}
static int fd_same_body(const FwmBuf *a, const FwmBuf *b) {
    int i = 0, j = 0;
    while (i < a->n || j < b->n) {
        if (i + 6 <= a->n && (i == 0 || a->b[i - 1] == '\n') && !memcmp(a->b + i, ".unit ", 6)) {
            while (i < a->n && a->b[i] != '\n') i++; if (i < a->n) i++; continue;
        }
        if (j + 6 <= b->n && (j == 0 || b->b[j - 1] == '\n') && !memcmp(b->b + j, ".unit ", 6)) {
            while (j < b->n && b->b[j] != '\n') j++; if (j < b->n) j++; continue;
        }
        if (i == a->n || j == b->n || a->b[i] != b->b[j]) return 0;
        i++; j++;
    }
    return 1;
}

int main(void) {
    if (!realpath(".", fd_root)) fd_die("root");
    if (fwm_bind(fd_alloc, fd_release, fd_fail)) fd_die("fwm_bind");
    fwm_reset();
    if (fwm_export((const unsigned char *)"helper", 6)) fd_die("fwm_export helper");

    /* D1: Mach-O/arm64 today must be refused (this is the failure case the dialect table fixes) */
    {   FwmBuf out;
        int r = fd_run(fd_macho_unit, fd_macho_stub, fd_macho_base, &out);
        printf("MACHO_MERGE\tresult=%d\tbytes=%d\n", r, out.n);
        fd_ck(r == 0, "D1-macho-arm64-refused-today");
        free(out.b);
    }

    /* D2 + D3: ELF/x86_64 merges, and twice the same */
    {   FwmBuf a, b;
        int r1 = fd_run(fd_elf_unit, fd_elf_stub, fd_elf_base, &a);
        int r2 = fd_run(fd_elf_unit, fd_elf_stub, fd_elf_base, &b);
        printf("ELF_MERGE\tresult=%d\tbytes=%d\n", r1, a.n);
        fd_ck(r1 == 1, "D2a-elf-x86_64-merges");
        fd_ck(r1 == r2 && a.n == b.n && a.n > 0 && !memcmp(a.b, b.b, (size_t)a.n), "D3-elf-merge-stable");
        free(a.b); free(b.b);
    }

    /* D4: a tape that does not start with `.unit 2` is refused whatever else it looks like */
    {   FwmBuf out;
        int r = fd_run(".unit 3\n.end\n", fd_elf_stub, fd_elf_base, &out);
        printf("BADUNIT_MERGE\tresult=%d\n", r);
        fd_ck(r == 0, "D4-non-unit2-refused");
        free(out.b);
    }
    {
        const char *located_stub =
            ".global main\n.unit 0 1:62\n.bss x 8\nmain:\n  call __init_u\n  ret\n"
            "__init_u:\n  call exit\n  .exit r0\n  ret\n__main_ret:\n  .exit r0\n.end\n";
        const char *located_base =
            ".str S0 \"x\"\n.unit 0 1:62\n__init:\n.unit 0 1:63\n  ret\n.unit 0 1:62\n  call helper\n.unit 0 1:63\n__main_ret:\n.unit 0 0:\n  ret\n.end\n";
        FwmBuf plain, located;
        int rp = fd_run(fd_elf_unit, fd_elf_stub, fd_elf_base, &plain);
        int rl = fd_run(fd_elf_unit, located_stub, located_base, &located);
        fd_ck(rp == 1 && rl == 1 && fd_same_body(&plain, &located), "D5-location-preserves-forward-body");
        fd_ck(rl == 1 && fd_contains(&located, ".unit 0 1:62\n") && fd_contains(&located, ".unit 1 1:62\n"), "D6-distinct-TUs-same-filename");
        fd_ck(rl == 1 && fd_contains(&located, ".unit 0 1:62\n__init:\n") && fd_contains(&located, ".unit 0 1:63\n  ret\n") && fd_contains(&located, ".unit 0 1:62\n  call helper\n") && fd_contains(&located, ".unit 0 1:63\n__main_ret:\n"), "D6b-same-TU-A-B-A-B");
        fd_ck(rl == 1 && fd_contains(&located, ".unit 0 0:\n  ret\n"), "D6c-explicit-empty-clears-context");
        int ends = 0;
        for (int i = 0; i + 5 <= located.n; i++) if (!memcmp(located.b + i, ".end\n", 5)) ends++;
        fd_ck(rl == 1 && ends == 1 && located.n >= 5 && !memcmp(located.b + located.n - 5, ".end\n", 5), "D7-one-final-end");
        free(plain.b); free(located.b);
    }
    {
        FwmBuf out;
        int r = fd_run(".unit 2\n.global helper\n", fd_elf_stub, fd_elf_base, &out);
        fd_ck(r == 0, "D8-missing-end-refused"); free(out.b);
        r = fd_run(".unit 2\n.global helper\n.end\nX", fd_elf_stub, fd_elf_base, &out);
        fd_ck(r == 0, "D9-after-end-refused"); free(out.b);
        r = fd_run(".unit 2\n.unit 0 21474836470:61\n.global helper\n.end\n", fd_elf_stub, fd_elf_base, &out);
        fd_ck(r == 0, "D10-overflow-name-length-refused"); free(out.b);
        r = fd_run(".unit 2\n.unit 128 1:61\n.global helper\n.end\n", fd_elf_stub, fd_elf_base, &out);
        fd_ck(r == 0, "D11-overlimit-TU-refused"); free(out.b);
    }
    {
        const char *labels = ".global main\n.unit0:\n.unitx:\n.endfoo:\n.bss x 8\nmain:\n  call __init_u\n  ret\n__init_u:\n  call exit\n  .exit r0\n  ret\n__main_ret:\n  .exit r0\n.end\n";
        FwmBuf out;
        int r = fd_run(fd_elf_unit, labels, fd_elf_base, &out);
        fd_ck(r == 1 && fd_contains(&out, ".unit0__u0:\n") && fd_contains(&out, ".unitx__u0:\n") && fd_contains(&out, ".endfoo__u0:\n"), "D12-meta-prefix-labels-preserved");
        free(out.b);
    }

    printf("FWDMERGE_DIALECT_CHECK\tassertions=%d\tfailed=%d\n", fd_n, fd_failed);
    return fd_failed ? 1 : 0;
}
