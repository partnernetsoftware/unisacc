/* winstate: window state and heartbeat of the production line (plans/devsvc.md "产线化", disk contract (2), unit U3).
 * Usage (prefix: sh ./unisacc.com tools/winstate.cx -- ...; the devsvc entry may forward "win ..." here):
 *   set NAME --state S [--task T] [--blocker B] [--caps C] [--model M] [--ctx PCT]
 *        report a state; prints WINSTATE WINDOW= STATE= SINCE= HEARTBEAT= EVENT=0|1
 *   beat NAME                       refresh the heartbeat only; prints WINSTATE_BEAT
 *   status --tsv                    header line then one row per window (win/NAME.tsv), sorted by name
 *   lost [--emit]                   windows whose heartbeat is older than 600 s; prints WIN_LOST rows; with --emit
 *                                   appends window.state blocker=heartbeat-lost once per stale heartbeat (line tick)
 *   common: [--dir D]  line directory; else $LINE_DIR; else <devsvc instance directory>/line
 * Row (win/NAME.tsv, one data row under the header): window caps model state since task blocker ctx_left_pct heartbeat.
 * state is one of working idle waiting compacting, anything else is refused (rc 2, nothing written); waiting needs a
 * blocker, the other states keep blocker "-" (a blocker given with them is refused). since and heartbeat are the
 * receiver's clock, never the client's. A report whose state, task and blocker equal the stored row only refreshes
 * heartbeat (and caps, model, ctx_left_pct); since is kept and no event is written. A change sets since=now and writes
 * event window.state (window state task blocker).
 * Events: appended to DIR/win-events.tsv (time kind fields) and sent through devsvc events emit unless $WINSTATE_EMIT=0.
 * Lock: DIR/win/NAME.lock (flock, bounded wait 5 s then rc 1); rows are replaced by atomic rename.
 * Clock: $WINSTATE_NOW (epoch seconds) replaces the clock, for checks only (same use as $DEVTASK_NOW).
 * Column header and event name: LINE_HDR_WIN and LINE_EV_WINDOW_STATE below are a local copy of plans/devsvc.md (2)
 * until tools/cxlib/lineorder.cx lands on main; then this file uses its constants instead.
 * Exit: 0 ok, 1 refused (lock busy, unknown window), 2 bad input or I/O. */
#pragma unisa use cxlib.devtask
#pragma unisa use cxlib.netpack
#pragma unisa use text.build
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.proc
#pragma unisa use sys.time
#pragma unisa use sys.env
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

#define LINE_HDR_WIN "window\tcaps\tmodel\tstate\tsince\ttask\tblocker\tctx_left_pct\theartbeat"
#define LINE_EV_WINDOW_STATE "window.state"
#define HB_LOST_S 600
#define WMAX 256

typedef struct Win { char window[64], caps[256], model[64], state[16], task[128], blocker[128], ctx[8]; long since, hb; } Win;
static char dir[1024], root[1024];
static long now_s;
static Win ws[WMAX]; static int nw;

static int bad(const char *m, const char *a) { fprintf(stderr, "WINSTATE_REFUSE\t%s%s%s\n", m, a ? "\t" : "", a ? a : ""); return 2; }
static int name_ok(const char *s, long cap) {
    long i = 0;
    for (; s[i]; i++) { unsigned char c = (unsigned char)s[i]; if (i >= cap - 1 || !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '-')) return 0; }
    return i > 0 && strcmp(s, ".") && strcmp(s, "..");
}
/* a field value: 1..cap-1 printable bytes, no whitespace (event values must not hold blanks) */
static int field_ok(const char *s, long cap) {
    long i = 0;
    for (; s[i]; i++) { unsigned char c = (unsigned char)s[i]; if (i >= cap - 1 || c <= ' ' || c == 0x7f) return 0; }
    return i > 0;
}
/* the state whitelist of the contract */
static int ws_state_ok(const char *s) { return !strcmp(s, "working") || !strcmp(s, "idle") || !strcmp(s, "waiting") || !strcmp(s, "compacting"); }
/* heartbeat-lost judgment for line tick: 1 when the heartbeat is older than HB_LOST_S at now */
static int ws_hb_lost(long hb, long now) { return now - hb > HB_LOST_S; }
/* report validation; 0 ok, else the refusal text in why */
static int report_ok(const char *state, const char *blocker, const char **why) {
    if (!ws_state_ok(state)) { *why = "bad state (working idle waiting compacting)"; return 1; }
    if (!strcmp(state, "waiting") && !strcmp(blocker, "-")) { *why = "waiting needs --blocker"; return 1; }
    if (strcmp(state, "waiting") && strcmp(blocker, "-")) { *why = "blocker only with state waiting"; return 1; }
    return 0;
}
/* bounded copy of n bytes into a NUL-terminated field (truncates at cap - 1) */
static void cpn(char *d, long cap, const unsigned char *s, long n) { long m = n < 0 ? 0 : n > cap - 1 ? cap - 1 : n; if (m > 0) mm_copy(d, cap, s, m); d[m] = 0; }
static void cps(char *d, long cap, const char *s) { cpn(d, cap, (const unsigned char *)s, (long)strlen(s)); }

/* parse the data row of win/NAME.tsv (comment lines skipped); 0 ok */
static int row_parse(const unsigned char *b, long n, Win *w) {
    long f[10], k = 0, i = 0, le; char t[32];
    while (i < n && b[i] == '#') { while (i < n && b[i] != '\n') i++; i++; }
    if (i >= n) return 1;
    le = i; while (le < n && b[le] != '\n') le++;
    f[0] = i;
    for (long j = i; j < le && k < 9; j++) if (b[j] == '\t') f[++k] = j + 1;
    if (k != 8) return 1;
    f[9] = le + 1;
    cpn(w->window, sizeof w->window, b + f[0], f[1] - f[0] - 1); cpn(w->caps, sizeof w->caps, b + f[1], f[2] - f[1] - 1);
    cpn(w->model, sizeof w->model, b + f[2], f[3] - f[2] - 1); cpn(w->state, sizeof w->state, b + f[3], f[4] - f[3] - 1);
    cpn(t, sizeof t, b + f[4], f[5] - f[4] - 1); w->since = atol(t);
    cpn(w->task, sizeof w->task, b + f[5], f[6] - f[5] - 1); cpn(w->blocker, sizeof w->blocker, b + f[6], f[7] - f[6] - 1);
    cpn(w->ctx, sizeof w->ctx, b + f[7], f[8] - f[7] - 1);
    cpn(t, sizeof t, b + f[8], f[9] - f[8] - 1); w->hb = atol(t);
    return 0;
}
static int win_path(const char *name, const char *ext, char *p, long cap) { return cx_fmt(p, cap, "%s/win/%s%s", dir, name, ext); }
/* 0 loaded, 1 absent, 2 unreadable or malformed */
static int win_load(const char *name, Win *w) {
    char p[1200]; unsigned char *b = 0; int64_t n = 0; int rc;
    if (win_path(name, ".tsv", p, sizeof p)) return 2;
    rc = sy_read_file(p, &b, &n, 1L << 16);
    if (rc == -ENOENT) return 1;
    if (rc || !b) { free(b); return 2; }
    rc = row_parse(b, (long)n, w) ? 2 : 0; free(b); return rc;
}
static int win_save(const Win *w) {
    char p[1200], ln[1200];
    if (win_path(w->window, ".tsv", p, sizeof p)) return 2;
    if (cx_fmt(ln, sizeof ln, "#%s\n%s\t%s\t%s\t%s\t%ld\t%s\t%s\t%s\t%ld\n", LINE_HDR_WIN, w->window, w->caps, w->model, w->state, w->since, w->task, w->blocker, w->ctx, w->hb)) return 2;
    return sy_write_atomic(p, ln, strlen(ln), 0600) ? 2 : 0;
}
static int lock_take(const char *name) {
    char p[1200], d[1100]; int fd; long t0 = sy_now_ms();
    if (cx_fmt(d, sizeof d, "%s/win", dir) || sy_mkdir_all(d, 0700) || win_path(name, ".lock", p, sizeof p)) return -2;
    fd = sy_open(p, O_RDWR | O_CREAT, 0600);
    if (fd < 0) return -2;
    for (;;) {
        if (!sy_flock(fd, 2 | 4)) return fd;
        if (sy_now_ms() - t0 >= 5000) { sy_close(fd); return -1; }
        sy_sleep_ms(25);
    }
}
static void lock_drop(int fd) { sy_flock(fd, 8); sy_close(fd); }

static int find_root(void) {
    char *v[] = {"git", "rev-parse", "--show-toplevel", 0}; np_result r = {0}; char w[256]; long n;
    if (root[0]) return 0;
    if (np_run(v, 0, 0, 10, &r, w, sizeof w) || r.rc || !r.out) { np_free(&r); return 1; }
    n = (long)r.outn; while (n > 0 && r.out[n - 1] == '\n') n--;
    cpn(root, sizeof root, (const unsigned char *)r.out, n); np_free(&r); return 0;
}
/* window.state event: local log row, then devsvc events emit unless WINSTATE_EMIT=0 */
static void event(const Win *w, const char *blocker) {
    char p[1200], txt[700], ln[800]; const char *e = getenv("WINSTATE_EMIT");
    if (cx_fmt(txt, sizeof txt, "window=%s state=%s task=%s blocker=%s", w->window, w->state, w->task, blocker)) return;
    if (!cx_fmt(p, sizeof p, "%s/win-events.tsv", dir) && !cx_fmt(ln, sizeof ln, "%ld\t%s\t%s\n", now_s, LINE_EV_WINDOW_STATE, txt)) sy_append_file(p, ln, strlen(ln), 0600);
    if (e && !strcmp(e, "0")) return;
    {   char prod[1100], *v[] = {"sh", prod, "tools/devsvc.cx", "--", "events", "emit", LINE_EV_WINDOW_STATE, txt, 0}; np_result r = {0}; char wb[256];
        if (find_root() || cx_fmt(prod, sizeof prod, "%s/unisacc.com", root)) { fprintf(stderr, "WINSTATE_EMIT_FAIL\tno repo root\n"); return; } /* lint:allow R1-product events emit runs the installed product of ROOT, as devsvc itself does */
        if (np_run(v, root, 0, 10, &r, wb, sizeof wb) || r.rc) fprintf(stderr, "WINSTATE_EMIT_FAIL\trc=%d\n", r.rc);
        np_free(&r);
    }
}
static int cmp_win(const void *a, const void *b) { return strcmp(((const Win *)a)->window, ((const Win *)b)->window); }
/* every window row under DIR/win, sorted; 0 ok */
static int load_all(void) {
    char d[1100]; DIR *dp; struct dirent *e;
    nw = 0;
    if (cx_fmt(d, sizeof d, "%s/win", dir)) return 2;
    dp = opendir(d);
    if (!dp) return errno == ENOENT ? 0 : 2;
    while ((e = readdir(dp))) {
        long n = (long)strlen(e->d_name); char nm[64];
        if (n < 5 || n - 4 >= (long)sizeof nm || strcmp(e->d_name + n - 4, ".tsv")) continue;
        cpn(nm, sizeof nm, (const unsigned char *)e->d_name, n - 4);
        if (!name_ok(nm, 64) || nw >= WMAX) continue;
        if (win_load(nm, &ws[nw]) == 0) nw++;
        else fprintf(stderr, "WINSTATE_WARN\tunreadable row\t%s\n", e->d_name);
    }
    closedir(dp);
    qsort(ws, nw, sizeof ws[0], cmp_win);
    return 0;
}
static int cmd_set(const char *name, const char *state, const char *task, const char *blocker, const char *caps, const char *model, const char *ctx) {
    const char *rw; Win old = {0}, w = {0}; int had, fd, change;
    if (!state) return bad("missing --state", 0);
    if (report_ok(state, blocker, &rw)) return bad(rw, state);
    if (!field_ok(task, 128)) return bad("bad --task", task);
    if (!field_ok(blocker, 128)) return bad("bad --blocker", blocker);
    if (caps && !field_ok(caps, 256)) return bad("bad --caps", caps);
    if (model && !field_ok(model, 64)) return bad("bad --model", model);
    if (ctx && strcmp(ctx, "-")) { char *end; long v = strtol(ctx, &end, 10); if (*end || !*ctx || v < 0 || v > 100) return bad("bad --ctx (0..100 or -)", ctx); }
    fd = lock_take(name);
    if (fd == -1) { fprintf(stderr, "WINSTATE_REFUSE\tlock busy\t%s\n", name); return 1; }
    if (fd < 0) return bad("cannot open lock", dir);
    had = win_load(name, &old);
    if (had == 2) { lock_drop(fd); return bad("unreadable window row", name); }
    cps(w.window, sizeof w.window, name); cps(w.state, sizeof w.state, state); cps(w.task, sizeof w.task, task); cps(w.blocker, sizeof w.blocker, blocker);
    cps(w.caps, sizeof w.caps, caps ? caps : had == 0 ? old.caps : "-");
    cps(w.model, sizeof w.model, model ? model : had == 0 ? old.model : "-");
    cps(w.ctx, sizeof w.ctx, ctx ? ctx : had == 0 ? old.ctx : "-");
    change = had != 0 || strcmp(old.state, w.state) || strcmp(old.task, w.task) || strcmp(old.blocker, w.blocker);
    w.since = change ? now_s : old.since;
    w.hb = now_s;
    if (win_save(&w)) { lock_drop(fd); return bad("cannot write window row", name); }
    if (change) event(&w, w.blocker);
    lock_drop(fd);
    printf("WINSTATE\tWINDOW=%s\tSTATE=%s\tSINCE=%ld\tHEARTBEAT=%ld\tEVENT=%d\n", w.window, w.state, w.since, w.hb, change);
    return 0;
}
static int cmd_beat(const char *name) {
    Win w = {0}; int fd = lock_take(name), had;
    if (fd == -1) { fprintf(stderr, "WINSTATE_REFUSE\tlock busy\t%s\n", name); return 1; }
    if (fd < 0) return bad("cannot open lock", dir);
    had = win_load(name, &w);
    if (had) { lock_drop(fd); fprintf(stderr, "WINSTATE_REFUSE\t%s\t%s\n", had == 1 ? "unknown window" : "unreadable window row", name); return had == 1 ? 1 : 2; }
    w.hb = now_s;
    if (win_save(&w)) { lock_drop(fd); return bad("cannot write window row", name); }
    lock_drop(fd);
    printf("WINSTATE_BEAT\tWINDOW=%s\tHEARTBEAT=%ld\n", w.window, w.hb);
    return 0;
}
static int cmd_lost(int emit) {
    if (load_all()) return bad("cannot read windows", dir);
    for (int i = 0; i < nw; i++) {
        char p[1200], mark[32], cur[32]; unsigned char *b = 0; int64_t n = 0; int seen = 0;
        if (!ws_hb_lost(ws[i].hb, now_s)) continue;
        printf("WIN_LOST\tWINDOW=%s\tSTATE=%s\tHEARTBEAT=%ld\tAGE_S=%ld\n", ws[i].window, ws[i].state, ws[i].hb, now_s - ws[i].hb);
        if (!emit || win_path(ws[i].window, ".lost", p, sizeof p) || cx_fmt(cur, sizeof cur, "%ld\n", ws[i].hb)) continue;
        if (!sy_read_file(p, &b, &n, 64) && b && n < (int64_t)sizeof mark) { cpn(mark, sizeof mark, b, (long)n); seen = !strcmp(mark, cur); }
        free(b);
        if (seen) continue;   /* one event per stale heartbeat value */
        event(&ws[i], "heartbeat-lost");
        if (sy_write_atomic(p, cur, strlen(cur), 0600)) return bad("cannot write lost mark", p);
    }
    return 0;
}

int main(int argc, char **argv) {
    const char *cmd = 0, *name = 0, *state = 0, *task = "-", *blocker = "-", *caps = 0, *model = 0, *ctx = 0, *odir = 0; int a = 1, tsv = 0, emit = 0, i; char why[512];
    if (argc > 1 && !strcmp(argv[1], "--")) a = 2;
    if (argc > a && !strcmp(argv[a], "win")) a++;
    for (i = a; i < argc; i++) {
        const char *s = argv[i]; int more = i + 1 < argc;
        if (!strcmp(s, "--state") && more) state = argv[++i];
        else if (!strcmp(s, "--task") && more) task = argv[++i];
        else if (!strcmp(s, "--blocker") && more) blocker = argv[++i];
        else if (!strcmp(s, "--caps") && more) caps = argv[++i];
        else if (!strcmp(s, "--model") && more) model = argv[++i];
        else if (!strcmp(s, "--ctx") && more) ctx = argv[++i];
        else if (!strcmp(s, "--dir") && more) odir = argv[++i];
        else if (!strcmp(s, "--tsv")) tsv = 1;
        else if (!strcmp(s, "--emit")) emit = 1;
        else if (!strcmp(s, "--help")) { printf("usage: winstate set NAME --state S [--task T] [--blocker B] [--caps C] [--model M] [--ctx PCT] | beat NAME | status --tsv | lost [--emit]; common [--dir D]\n"); return 0; }
        else if (s[0] == '-') return bad("unknown option", s);
        else if (!cmd) cmd = s;
        else if (!name) name = s;
        else return bad("extra argument", s);
    }
    if (!cmd) return bad("missing subcommand (set beat status lost)", 0);
    {   const char *e = getenv("WINSTATE_NOW"); now_s = e && *e ? atol(e) : sy_wall_s(); if (now_s <= 0) return bad("bad WINSTATE_NOW", e); }
    if (odir) { if (cx_fmt(dir, sizeof dir, "%s", odir)) return bad("dir too long", 0); }
    else if (getenv("LINE_DIR") && *getenv("LINE_DIR")) { if (cx_fmt(dir, sizeof dir, "%s", getenv("LINE_DIR"))) return bad("dir too long", 0); }
    else {
        char inst[1024];
        if (find_root()) return bad("not in a git work tree", 0);
        if (dt_instdir(root, "tools/devsvc-repo.tsv", inst, sizeof inst, why, sizeof why)) return bad("instance directory", why);
        if (cx_fmt(dir, sizeof dir, "%s/line", inst)) return bad("dir too long", 0);
    }
    if (!strcmp(cmd, "status")) {
        if (!tsv) return bad("status needs --tsv", 0);
        if (load_all()) return bad("cannot read windows", dir);
        printf("#%s\n", LINE_HDR_WIN);
        for (i = 0; i < nw; i++) printf("%s\t%s\t%s\t%s\t%ld\t%s\t%s\t%s\t%ld\n", ws[i].window, ws[i].caps, ws[i].model, ws[i].state, ws[i].since, ws[i].task, ws[i].blocker, ws[i].ctx, ws[i].hb);
        return 0;
    }
    if (!strcmp(cmd, "lost")) return cmd_lost(emit);
    if (strcmp(cmd, "set") && strcmp(cmd, "beat")) return bad("unknown subcommand", cmd);
    if (!name || !name_ok(name, 64)) return bad("bad or missing window NAME", name);
    return !strcmp(cmd, "set") ? cmd_set(name, state, task, blocker, caps, model, ctx) : cmd_beat(name);
}
