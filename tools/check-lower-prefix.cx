/* Test-only lower-prefix experiment; no product implementation is installed. */
#pragma unisa use sys.proc
int main(int argc,char **argv){
    if(argc<1||argc>4096)return 2;
    char **v=calloc((size_t)argc+4,sizeof *v);if(!v)return 2;
    v[0]="sh";v[1]="./unisacc.com";v[2]="tests/cases/lower_prefix/check_prefix.cx";v[3]="--";
    for(int i=1;i<argc;i++)v[i+3]=argv[i];
    char *out=0;size_t n=0;int rc=cx_runv_timeout(v,50,&out,&n);
    free(v);if(out&&n&&fwrite(out,1,n,stdout)!=n){free(out);return 2;}
    free(out);return rc;
}
