/* One fresh applicability observation. No model construction or admission. */
#pragma unisa use cxlib.nninputs
int main(int argc,char **argv){
 if(argc!=4){fputs("usage: CURRENT_ROOT ORIGIN_ROOT TRUSTED_NATIVE_READER\n",stderr);return 2;}
 ni_result r={0};char why[1600]={0};
 if(ni_compare(argv[1],argv[2],argv[3],&r,why,sizeof why)){
  fprintf(stderr,"nn-inputs-compare: REFUSE %s\n",why);return 2;
 }
 printf("NECESSARY_INPUTS\twitness=%s\tdata=%s\tconstructor-dependencies=%s\n",r.witness,r.data,r.ctor_cdeps);
 printf("HEADERS\tcurrent=%s\torigin=%s\n",r.current_include,r.origin_include);
 printf("READER\tartifact=%s\tmodule=%s\tphysical-reads=%d\tnative-table-calls=%d\n",r.native_artifact,r.verifier,r.physical_reads,r.native_table_calls);
 puts("NOT_CLAIMED\tfresh-source-identity;origin-package-provenance;model-construction;inference;admission;functional-PASS");
 return 0;
}
