/* tools/check-streampack-full.cx -- registered full streampack batch (P3+P4+raw+footer).
 * Marker: CHECK_STREAMPACK. */
#pragma unisa use sysx.process
int main(void) {
    char root[4096], why[512];
    np_result r = {0};
    if (!getcwd(root, sizeof root)) return 2;
    char *av[] = {"sh", "./unisacc.com", "tools/check-streampack.cx", "--", "--full", 0};
    if (np_run(av, root, 0, 50, &r, why, sizeof why)) {
        fprintf(stderr, "check-streampack-full: %s\n", why);
        return 2;
    }
    if (r.outn) fwrite(r.out, 1, r.outn, stdout);
    if (r.errn) fwrite(r.err, 1, r.errn, stderr);
    int rc = r.rc;
    np_free(&r);
    return rc;
}
