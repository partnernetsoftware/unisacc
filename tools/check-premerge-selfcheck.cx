/* check-premerge-selfcheck.cx -- contracts of tools/premerge-selfcheck.cx on two synthetic patches.
 *   sh ./unisacc.com tools/check-premerge-selfcheck.cx
 * good patch: check calls the real entry, uses git, the completion marker is verified  -> every item PASS, rc 0, receipt bound to the patch sha256.
 * stub patch: check prints a fixed ok=19 line, never mentions the changed source, and the marker is verified by nothing -> items 1 and 4 FAIL, rc 1.
 * weak receipt: an empty receipt target or missing patch is a refusal (rc 2), never PASS. */
#pragma unisa use cxlib.ckrun
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use text.text

static int bad, checks;
static void ok(int c, const char *w) { checks++; printf("%s\t%s\n", c ? "PASS" : "FAIL", w); if (!c) bad++; }

int main(void) {
    char tmp[1024], sc[6000], out[8192]; int rc;
    if (cx_fmt(tmp, sizeof tmp, "%s/psc-check-XXXXXX", sy_env_or("TMPDIR", "/tmp")) || !mkdtemp(tmp)) return 2;
    cx_fmt(sc, sizeof sc,
        "set -e; cd %s && mkdir r && cd r && git init -q . && mkdir tools && printf 'int main(void){\\n  if (0) return -1;\\n  return 0;\\n}\\n' > tools/seed.cx && git add -A && "
        "git -c user.name=x -c user.email=x@x commit -qm base && git branch -M main && "
        "printf 'int main(void){ puts(\"READY=yes\"); return 0; }\\n' > tools/foo.cx && "
        "printf 'int main(void){ system(\"cat tools/foo.cx; cat nonexistent_x 2>/dev/null; git rev-parse HEAD\"); printf(\"CX_FOO ok=%%%%d failed=%%%%d\\\\n\", 1, 0); return 0; }\\n' > tools/check-foo.cx && "
        "git add -A && git diff --cached > ../good.patch && git reset -q --hard && rm -f tools/foo.cx tools/check-foo.cx && "
        "printf 'int main(void){ puts(\"READY=yes\"); return 0; }\\n' > tools/foo.cx && "
        "printf 'int main(void){ printf(\"CX_FOO ok=19 failed=0\\\\n\"); return 0; }\\n' > tools/check-foo.cx && "
        "git add -A && git diff --cached > ../stub.patch && git reset -q --hard && rm -f tools/foo.cx tools/check-foo.cx && "
        "sed -i '/return -1/d' tools/seed.cx && git diff > ../del.patch && git checkout -q -- tools/seed.cx && "
        "printf 'int main(void){ system(\"cat /tmp/x/y\"); return 0; }\\n' > tools/check-bar.cx && git add -A && git diff --cached > ../path.patch && git reset -q --hard && rm -f tools/check-bar.cx && "
        "printf 'tools/seed.cx\\treturn -1\\tfixture removes the guard on purpose\\n' > ../declare.tsv && echo FIXTURE_OK", tmp);
    rc = ckk_sh_t("check-premerge-selfcheck", sc, out, sizeof out, 30);
    if (rc != 0 || !ckk_has(out, sizeof out, "FIXTURE_OK")) { printf("fixture setup failed: %.400s\n", out); return 2; }

    cx_fmt(sc, sizeof sc, "sh ./unisacc.com tools/premerge-selfcheck.cx -- --patch %s/good.patch --repo %s/r --base main "
           "--check 'git rev-parse HEAD >/dev/null && grep -q \"READY=yes\" tools/foo.cx && grep -q foo tools/check-foo.cx' --out %s/good.rec 2>&1", tmp, tmp, tmp);
    rc = ckk_sh_t("check-premerge-selfcheck", sc, out, sizeof out, 60);
    ok(rc == 0 && ckk_has(out, sizeof out, "SELFCHECK_SUMMARY patch_sha256=") && ckk_has(out, sizeof out, "verdict=PASS"), "good patch: verdict PASS, rc 0");
    ok(ckk_has(out, sizeof out, "item=1 name=real-entry verdict=PASS") && ckk_has(out, sizeof out, "item=2 name=git-failure verdict=PASS") &&
       ckk_has(out, sizeof out, "item=4 name=marker-flip verdict=PASS"), "good patch: items 1, 2 and 4 each PASS on a real run");
    cx_fmt(sc, sizeof sc, "sh ./unisacc.com tools/premerge-selfcheck.cx -- --patch %s/del.patch --repo %s/r --base main --check true --out %s/del.rec 2>&1", tmp, tmp, tmp);
    rc = ckk_sh_t("check-premerge-selfcheck", sc, out, sizeof out, 60);
    ok(rc == 1 && ckk_has(out, sizeof out, "item=6 name=deleted-guard verdict=FAIL"), "deleted guard line without a declaration fails");
    cx_fmt(sc, sizeof sc, "sh ./unisacc.com tools/premerge-selfcheck.cx -- --patch %s/del.patch --repo %s/r --base main --check true --declare %s/declare.tsv --out %s/del2.rec 2>&1", tmp, tmp, tmp, tmp);
    rc = ckk_sh_t("check-premerge-selfcheck", sc, out, sizeof out, 60);
    ok(ckk_has(out, sizeof out, "item=6 name=deleted-guard verdict=PASS") && !ckk_has(out, sizeof out, "item=6 name=deleted-guard verdict=FAIL"), "the same deletion with a declared reason passes item 6");
    cx_fmt(sc, sizeof sc, "sh ./unisacc.com tools/premerge-selfcheck.cx -- --patch %s/path.patch --repo %s/r --base main --check true --out %s/path.rec 2>&1", tmp, tmp, tmp);
    rc = ckk_sh_t("check-premerge-selfcheck", sc, out, sizeof out, 60);
    ok(rc == 1 && ckk_has(out, sizeof out, "item=8 name=hardcoded-path verdict=FAIL"), "a check that hard-codes a /home path fails item 8");
    cx_fmt(sc, sizeof sc, "sh ./unisacc.com tools/premerge-selfcheck.cx -- --patch %s/del.patch --repo %s/r --base main --check true --declare %s/declare.tsv --probe 'true' --out %s/p7a.rec 2>&1", tmp, tmp, tmp, tmp);
    rc = ckk_sh_t("check-premerge-selfcheck", sc, out, sizeof out, 60);
    ok(ckk_has(out, sizeof out, "item=7 name=malformed-input verdict=FAIL") && ckk_has(out, sizeof out, "accepted or crashed on 'empty'"), "a probe that accepts every input fails item 7, empty input included");
    cx_fmt(sc, sizeof sc, "sh ./unisacc.com tools/premerge-selfcheck.cx -- --patch %s/del.patch --repo %s/r --base main --check true --declare %s/declare.tsv --probe 'test -s \"$F\"' --out %s/p7b.rec 2>&1", tmp, tmp, tmp, tmp);
    rc = ckk_sh_t("check-premerge-selfcheck", sc, out, sizeof out, 60);
    ok(ckk_has(out, sizeof out, "item=7 name=malformed-input verdict=FAIL") && !ckk_has(out, sizeof out, "accepted or crashed on 'empty'"), "a probe that refuses empty input but accepts others is still caught");
    cx_fmt(sc, sizeof sc, "test \"$(sha256sum %s/good.patch | cut -d' ' -f1)\" = \"$(sed -n 's/.*patch_sha256=\\([0-9a-f]*\\).*/\\1/p' %s/good.rec)\"", tmp, tmp);
    ok(ckk_sh_t("check-premerge-selfcheck", sc, 0, 0, 10) == 0, "receipt file carries the sha256 of the patch");

    cx_fmt(sc, sizeof sc, "sh ./unisacc.com tools/premerge-selfcheck.cx -- --patch %s/stub.patch --repo %s/r --base main --check true --out %s/stub.rec 2>&1", tmp, tmp, tmp);
    rc = ckk_sh_t("check-premerge-selfcheck", sc, out, sizeof out, 60);
    ok(rc == 1 && ckk_has(out, sizeof out, "verdict=FAIL"), "stub patch: verdict FAIL, rc 1");
    ok(ckk_has(out, sizeof out, "item=1 name=stub-output verdict=FAIL") && ckk_has(out, sizeof out, "item=1 name=real-entry verdict=FAIL"), "stub patch: fixed ok=19 output and no real entry are both caught");
    ok(ckk_has(out, sizeof out, "item=4 name=marker-flip verdict=FAIL"), "stub patch: a completion marker that no check verifies is caught");

    cx_fmt(sc, sizeof sc, "sh ./unisacc.com tools/premerge-selfcheck.cx -- --patch %s/nonexistent.patch --repo %s/r --check true --out %s/x.rec 2>&1", tmp, tmp, tmp);
    rc = ckk_sh_t("check-premerge-selfcheck", sc, out, sizeof out, 30);
    ok(rc == 2 && ckk_has(out, sizeof out, "REFUSE"), "a missing patch is a refusal, not a pass");

    cx_fmt(sc, sizeof sc, "rm -rf %s", tmp); ckk_sh_t("check-premerge-selfcheck", sc, 0, 0, 20);
    printf("CX_PREMERGE_SELFCHECK\tchecks=%d\tfailed=%d\n", checks, bad);
    return bad ? 1 : 0;
}
