/* check-premerge-selfcheck.cx -- contracts of tools/premerge-selfcheck.cx on synthetic patches and repositories.
 *   sh ./unisacc.com tools/check-premerge-selfcheck.cx
 * good patch: check calls the real entry, uses git, the completion marker is verified  -> every item PASS, rc 0, receipt bound to the patch sha256.
 * stub patch: check prints a fixed ok=19 line, never mentions the changed source, and the marker is verified by nothing -> items 1 and 4 FAIL, rc 1.
 * bypass switches: a source adding --force, --mutate, --skip, --unsafe or --bypass fails item 8.
 * refusals (rc 2, no receipt, old receipt removed, no scratch tree left, caller's repository untouched): missing patch, invalid base,
 * missing overlay, patch that does not apply, --check-timeout above 55, nonexistent --repo.
 * The tool runs are independent, so they are queued and started together to keep the whole check inside one 55 s command. */
#pragma unisa use cxlib.ckrun
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use text.text

static int bad, checks;
static char g_tmp[1024], qs[30000];
static int qn;
static void ok(int c, const char *w) { ckk_ok(c, w); }
static int sh(const char *script, char *out, int cap, int secs) { return ckk_sh_t("check-premerge-selfcheck", script, out, cap, secs); }

/* append one background shell piece to the batch */
static void qraw(const char *piece) {
    long n = (long)strlen(piece);
    if (qn + n + 8 >= (long)sizeof qs) { printf("batch buffer too small\n"); exit(2); }
    if (mm_copy(qs + qn, (long)sizeof qs - qn, piece, n + 1) != 0) exit(2);
    qn += (int)n;
}
/* one tool run: stdout+stderr to o/NAME.txt, exit code to o/NAME.rc; ARGFMT takes the temp directory for each %s */
static void q(const char *name, const char *argfmt) {
    char a[2400], l[3200];
    if (cx_fmt(a, sizeof a, argfmt, g_tmp, g_tmp, g_tmp, g_tmp)) exit(2);
    if (cx_fmt(l, sizeof l, "( TMPDIR=\"$T/td\" sh ./unisacc.com tools/premerge-selfcheck.cx -- %s > \"$T/o/%s.txt\" 2>&1; echo $? > \"$T/o/%s.rc\" ) & ", a, name, name)) exit(2);
    qraw(l);
}
static void flush(void) {
    static char sc[32000];
    if (cx_fmt(sc, sizeof sc, "T=%s; mkdir -p \"$T/o\"; %s wait", g_tmp, qs)) exit(2);
    sh(sc, 0, 0, 55);
}
static char *rd(const char *name, const char *ext) {
    char p[1300], *b, *c; size_t n;
    cx_fmt(p, sizeof p, "%s/o/%s.%s", g_tmp, name, ext);
    b = cx_read(p, &n);
    if (!b) return "";
    c = malloc(n + 1);
    if (mm_copy(c, (long)n + 1, b, (long)n) != 0) exit(2);
    c[n] = 0; free(b);
    return c;
}
static int has(const char *name, const char *needle) { return strstr(rd(name, "txt"), needle) != 0; }
static int rcof(const char *name) { const char *s = rd(name, "rc"); return s[0] ? atoi(s) : -99; }

int main(void) {
    char *tmp = g_tmp, sc[6000], out[8192]; int rc;
    if (cx_fmt(tmp, sizeof g_tmp, "%s/psc-check-XXXXXX", sy_env_or("TMPDIR", "/tmp")) || !mkdtemp(tmp)) return 2;
    cx_fmt(sc, sizeof sc,
        "set -e; cd %s && mkdir r && cd r && git init -q . && mkdir tools && printf 'int main(void){\\n  if (0) return -1;\\n  return 0;\\n}\\n' > tools/seed.cx && git add -A && "
        "git -c user.name=x -c user.email=x@x commit -qm base && git branch -M main && "
        "printf 'int main(void){ puts(\"READY=yes\"); return 0; }\\n' > tools/foo.cx && "
        "printf 'int main(void){ system(\"cat tools/foo.cx; cat nonexistent_x 2>/dev/null; git rev-parse HEAD\"); printf(\"CX_FOO ok=%%%%d failed=%%%%d\\\\n\", 1, 0); return 0; }\\n' > tools/check-foo.cx && "
        "git add -A && git diff --cached > ../good.patch && git reset -q --hard && rm -f tools/foo.cx tools/check-foo.cx && "
        "printf 'int main(void){ puts(\"READY=yes\"); return 0; }\\n' > tools/foo.cx && "
        "n=19 && printf 'int main(void){ printf(\"CX_FOO ok=%%s failed=0\\\\n\"); return 0; }\\n' \"$n\" > tools/check-foo.cx && "
        "git add -A && git diff --cached > ../stub.patch && git reset -q --hard && rm -f tools/foo.cx tools/check-foo.cx && "
        "sed -i '/return -1/d' tools/seed.cx && git diff > ../del.patch && git checkout -q -- tools/seed.cx && "
        "p=/t; printf 'int main(void){ system(\"cat %%smp/x/y\"); return 0; }\\n' \"$p\" > tools/check-bar.cx && git add -A && git diff --cached > ../path.patch && git reset -q --hard && rm -f tools/check-bar.cx && "
        "printf 'tools/seed.cx\\treturn -1\\tfixture removes the guard on purpose\\n' > ../declare.tsv && echo FIXTURE_OK", tmp);
    rc = ckk_sh_t("check-premerge-selfcheck", sc, out, sizeof out, 30);
    if (rc != 0 || !ckk_has(out, sizeof out, "FIXTURE_OK")) { printf("fixture setup failed: %.400s\n", out); return 2; }

    /* second fixture set: two-guard seed in r2 (main advances once), a tsv row, and extra patches built in r */
    cx_fmt(sc, sizeof sc, "T=%s; %s", tmp,
        "set -e; cd \"$T\" && mkdir td r2 && cd r2 && git init -q . && mkdir tools tests && "
        "printf 'int main(void){\\n  if (0) return -1;\\n  if (1) return -2;\\n  return 0;\\n}\\n' > tools/seed.cx && "
        "printf 'a\\tb1\\nc\\tb2\\n' > tests/batches.tsv && git add -A && git -c user.name=x -c user.email=x@x commit -qm b0 && git branch -M main && "
        "sed -i '/return -/d' tools/seed.cx && git diff > ../two.patch && git checkout -q -- . && "
        "grep -v '^c' tests/batches.tsv > ../bt && cp ../bt tests/batches.tsv && git diff > ../tsv.patch && git checkout -q -- . && "
        "sed -i '/return -1/d' tools/seed.cx && git diff > ../stale.patch && git -c user.name=x -c user.email=x@x commit -qam b1 && "
        "printf 'tools/seed.cx\\treturn -1\\tfx\\ntools/seed.cx\\treturn -2\\tfx\\n' > ../two.decl && "
        "printf 'tests/batches.tsv\\tc\\tfx drops row c\\n' > ../tsv.decl && cd ../r && "
        "printf 'int main(void){ puts(\"READY=yes\"); return 0; }\\n' > tools/foo.cx && "
        "printf 'int main(void){ system(\"cat tools/foo.cx\"); printf(\"CX_FOO ok=%%d failed=%%d\\\\n\", 1, 0); return 0; }\\n' > tools/check-foo.cx && "
        "git add -A && git diff --cached > ../nonneg.patch && git reset -q --hard && rm -f tools/foo.cx tools/check-foo.cx && "
        "for s in force mutate skip unsafe bypass; do printf 'int main(int c, char **v){ if (c > 1 && !strcmp(v[1], \"--%s\")) return 0; return 1; }\\n' \"$s\" > tools/foo.cx && git add -A && git diff --cached > ../sw-$s.patch && git reset -q --hard && rm -f tools/foo.cx; done && "
        "printf 'int main(void){ puts(\"READY=yes\"); return 0; }\\n' > tools/foo.cx && "
        "printf 'int main(void){ system(\"cat tools/foo.cx; cat nonexistent; git rev-parse HEAD; echo src cx ext exec include seed kernel\"); printf(\"CX_FOO ok=%%d failed=%%d\\\\n\", 1, 0); return 0; }\\n' > tools/check-foo.cx && "
        "git add -A && git diff --cached > ../guard.patch && git reset -q --hard && rm -f tools/foo.cx tools/check-foo.cx && echo FX2_OK");
    rc = ckk_sh_t("check-premerge-selfcheck", sc, out, sizeof out, 30);
    if (rc != 0 || !ckk_has(out, sizeof out, "FX2_OK")) { printf("fixture 2 setup failed: %.400s\n", out); return 2; }

    /* third fixture set (item 10): each patch adds a producer (tools/foo.cx) and a check whose matching call looks for one literal */
    {   static const char *lit[][3] = {
            /* name, producer source, check source */
            { "lit-ok", "int main(void){ return 0; }\n", "int main(void){ has(out, \"CX_FOO\\tok\"); return 0; } /* foo.cx nonexistent */\n" },
            { "lit-bs", "int main(void){ return 0; }\n", "int main(void){ has(out, \"CX_FOO\\\\tok\"); return 0; } /* foo.cx nonexistent */\n" },
            { "lit-need", "int main(void){ return 0; }\n", "int main(void){ has(out, \"NEED tape\"); return 0; } /* foo.cx nonexistent */\n" },
            { "lit-prod", "int main(void){ puts(\"REFUSE-Q reason=zz\"); return 0; }\n", "int main(void){ has(out, \"REFUSE-Q reason=zz\"); return 0; } /* foo.cx nonexistent */\n" },
            { "lit-noprod", "int main(void){ return 0; }\n", "int main(void){ has(out, \"REFUSE-W reason=zz\"); return 0; } /* foo.cx nonexistent */\n" },
            { "lit-none", "int main(void){ return 0; }\n", "int main(void){ printf(\"zzzzz\"); return 0; } /* foo.cx nonexistent */\n" },
            { 0, 0, 0 } };
        int li;
        for (li = 0; lit[li][0]; li++) {
            char p1[1300], p2[1300], sc3[1800];
            cx_fmt(p1, sizeof p1, "%s/r/tools/foo.cx", tmp); cx_fmt(p2, sizeof p2, "%s/r/tools/check-foo.cx", tmp);
            if (cx_write(p1, lit[li][1], strlen(lit[li][1])) || cx_write(p2, lit[li][2], strlen(lit[li][2]))) return 2;
            cx_fmt(sc3, sizeof sc3, "cd %s/r && git add -A && git diff --cached > ../%s.patch && git reset -q --hard && git clean -fdq && echo LIT_OK", tmp, lit[li][0]);
            rc = ckk_sh_t("check-premerge-selfcheck", sc3, out, sizeof out, 30);
            if (rc != 0 || !ckk_has(out, sizeof out, "LIT_OK")) { printf("fixture 3 setup failed: %.300s\n", out); return 2; }
        }
        cx_fmt(sc, sizeof sc, "%s/sample-ok.txt", tmp);
        if (cx_write(sc, "CX_FOO\tok\n", 10)) return 2;
    }

    /* fourth fixture set (item 11): two copies of r whose tree has a stand-in tools/precommit-preview.cx, one answering blocked=0 and one blocked=2 */
    const char *T_G = "good", *T_PA = "pv-ok", *T_PB = "pv-bad"; /* receipt tags of the item-11 runs */
    {   static const char *pvsrc[2] = {
            "int main(void){ printf(\"%s\\n\", \"GATE\\tfake\\tPASS\\tok\\t-\"); printf(\"%s\\n\", \"PRECOMMIT_PREVIEW\\tblocked=0\"); return 0; }\n",
            "int main(void){ printf(\"%s\\n\", \"GATE\\tratchet:fake\\tBLOCK\\tfake gate refuses reason=x\\t-\"); printf(\"%s\\n\", \"PRECOMMIT_PREVIEW\\tblocked=2\"); return 1; }\n" };
        static const char *pvdir[2] = { "rp-ok", "rp-bad" };
        int pi;
        for (pi = 0; pi < 2; pi++) {
            char pp[1300], sc4[1800];
            cx_fmt(sc4, sizeof sc4, "cd %s && rm -rf %s && cp -a r %s", tmp, pvdir[pi], pvdir[pi]);
            rc = ckk_sh_t("check-premerge-selfcheck", sc4, out, sizeof out, 30);
            if (rc != 0) { printf("fixture 4 setup failed: %.300s\n", out); return 2; }
            cx_fmt(pp, sizeof pp, "%s/%s/tools/precommit-preview.cx", tmp, pvdir[pi]);
            if (cx_write(pp, pvsrc[pi], strlen(pvsrc[pi]))) return 2;
            cx_fmt(sc4, sizeof sc4, "cd %s/%s && git add -A && git -c user.name=x -c user.email=x@x commit -qm pv", tmp, pvdir[pi]);
            rc = ckk_sh_t("check-premerge-selfcheck", sc4, out, sizeof out, 30);
            if (rc != 0) { printf("fixture 4 commit failed: %.300s\n", out); return 2; }
        }
    }

    /* warm the compile cache once so the parallel runs start from the cached binary */
    cx_fmt(sc, sizeof sc, "TMPDIR=%s/td sh ./unisacc.com tools/premerge-selfcheck.cx -- --no-such-argument >/dev/null 2>&1; true", tmp);
    sh(sc, 0, 0, 30);

    q("good", "--patch %s/good.patch --repo %s/r --base main "
              "--check 'git rev-parse HEAD >/dev/null && grep -q \"READY=yes\" tools/foo.cx && grep -q foo tools/check-foo.cx' --out %s/good.rec");
    q("del", "--patch %s/del.patch --repo %s/r --base main --check true --out %s/del.rec");
    q("del2", "--patch %s/del.patch --repo %s/r --base main --check true --declare %s/declare.tsv --out %s/del2.rec");
    q("path", "--patch %s/path.patch --repo %s/r --base main --check true --out %s/path.rec");
    q("p7a", "--patch %s/del.patch --repo %s/r --base main --check true --declare %s/declare.tsv --probe 'true' --out %s/p7a.rec");
    q("p7b", "--patch %s/del.patch --repo %s/r --base main --check true --declare %s/declare.tsv --probe 'test -s \"$F\"' --out %s/p7b.rec");
    q("p7c", "--patch %s/good.patch --repo %s/r --base main "
             "--check 'git rev-parse HEAD >/dev/null && grep -q \"READY=yes\" tools/foo.cx && grep -q foo tools/check-foo.cx' --probe false --out %s/p7c.rec");
    q("stub", "--patch %s/stub.patch --repo %s/r --base main --check true --out %s/stub.rec");
    q("missing", "--patch %s/nonexistent.patch --repo %s/r --check true --out %s/x.rec");
    q("two", "--patch %s/two.patch --repo %s/r2 --base main~1 --current main~1 --check true --declare %s/two.decl --out %s/two.rec");
    q("tsv", "--patch %s/tsv.patch --repo %s/r2 --base main~1 --current main~1 --check true --out %s/tsv.rec");
    q("tsv2", "--patch %s/tsv.patch --repo %s/r2 --base main~1 --current main~1 --check true --declare %s/tsv.decl --out %s/tsv2.rec");
    q("stale", "--patch %s/stale.patch --repo %s/r2 --base main~1 --check true --out %s/stale.rec");
    q("nonneg", "--patch %s/nonneg.patch --repo %s/r --base main --check true --out %s/nonneg.rec");
    q("sw-force", "--patch %s/sw-force.patch --repo %s/r --base main --check true --out %s/swf.rec");
    q("sw-mutate", "--patch %s/sw-mutate.patch --repo %s/r --base main --check true --out %s/swm.rec");
    q("sw-skip", "--patch %s/sw-skip.patch --repo %s/r --base main --check true --out %s/sws.rec");
    q("sw-unsafe", "--patch %s/sw-unsafe.patch --repo %s/r --base main --check true --out %s/swu.rec");
    q("sw-bypass", "--patch %s/sw-bypass.patch --repo %s/r --base main --check true --out %s/swb.rec");
    q("g1", "--patch %s/good.patch --repo %s/r --base main --guard --check true --out %s/g1.rec");
    q("g2", "--patch %s/guard.patch --repo %s/r --base main --guard --check 'grep -q READY=yes tools/foo.cx' --out %s/g2.rec");
    q("i2", "--patch %s/good.patch --repo %s/r --base main --check 'git rev-parse HEAD >/dev/null 2>&1; grep -q READY=yes tools/foo.cx' --out %s/i2.rec");
    q("b1", "--patch %s/good.patch --repo %s/r --base no-such-rev --check true --out %s/b1.rec");
    q("o1", "--patch %s/good.patch --repo %s/r --base main --overlay %s/no-overlay-dir --check true --out %s/o1.rec");
    q("a1", "--patch %s/stale.patch --repo %s/r2 --base main --check true --out %s/a1.rec");
    q("t1", "--patch %s/good.patch --repo %s/r --base main --check true --check-timeout 56 --out %s/t1.rec");
    /* an old receipt at --out does not survive a refusal */
    qraw("( printf OLD > \"$T/pre.rec\"; TMPDIR=\"$T/td\" sh ./unisacc.com tools/premerge-selfcheck.cx -- --patch \"$T/nonexistent.patch\" --repo \"$T/r\" --check true --out \"$T/pre.rec\" >/dev/null 2>&1; "
         "test ! -e \"$T/pre.rec\" && echo PRE_GONE > \"$T/o/pre.txt\" ) & ");
    /* the tool identity is its own source file whatever the working directory */
    qraw("( R=$(pwd); cd \"$T\" && TMPDIR=\"$T/td\" sh \"$R/unisacc.com\" \"$R/tools/premerge-selfcheck.cx\" -- --patch \"$T/good.patch\" --repo \"$T/r\" --base main --check true --out \"$T/ci.rec\" >/dev/null 2>&1; "
         "test \"$(grep -o 'tool_sha256=[0-9a-f]*' \"$T/ci.rec\" | cut -d= -f2)\" = \"$(sha256sum \"$R/tools/premerge-selfcheck.cx\" | cut -c1-64)\" && echo CI_OK > \"$T/o/ci.txt\" ) & ");
    /* a nonexistent --repo is refused and the caller's repository is left alone */
    qraw("( R=$(pwd); mkdir \"$T/cw\" && cd \"$T/cw\" && git init -q . && echo x > a && git add -A && git -c user.name=x -c user.email=x@x commit -qm c0 && echo u > u && "
         "n1=$(git rev-list --count HEAD) && rc=0 && TMPDIR=\"$T/td\" sh \"$R/unisacc.com\" \"$R/tools/premerge-selfcheck.cx\" -- --patch \"$T/good.patch\" --repo \"$T/no-such-repo\" --check true --out \"$T/cw.rec\" >/dev/null 2>&1 || rc=$?; "
         "n2=$(git rev-list --count HEAD) && test \"$rc\" = 2 && test \"$n1\" = \"$n2\" && test -f u && git status --porcelain | grep -q '^?? u' && test ! -e \"$T/cw.rec\" && echo CWD_UNTOUCHED > \"$T/o/cw.txt\" ) & ");
    q("pv-ok", "--patch %s/good.patch --repo %s/rp-ok --base main --check true --out %s/pv-ok.rec");
    q("pv-bad", "--patch %s/good.patch --repo %s/rp-bad --base main --check true --out %s/pv-bad.rec");
    q("nobase", "--patch %s/good.patch --repo %s/r --check true --out %s/nobase.rec");
    q("lit-ok", "--patch %s/lit-ok.patch --repo %s/r --base main --check true --sample %s/sample-ok.txt --out %s/lit-ok.rec");
    q("lit-nosample", "--patch %s/lit-ok.patch --repo %s/r --base main --check true --out %s/lit-ns.rec");
    q("lit-bs", "--patch %s/lit-bs.patch --repo %s/r --base main --check true --sample %s/sample-ok.txt --out %s/lit-bs.rec");
    q("lit-need", "--patch %s/lit-need.patch --repo %s/r --base main --check true --sample %s/sample-ok.txt --out %s/lit-need.rec");
    q("lit-prod", "--patch %s/lit-prod.patch --repo %s/r --base main --check true --out %s/lit-prod.rec");
    q("lit-noprod", "--patch %s/lit-noprod.patch --repo %s/r --base main --check true --out %s/lit-noprod.rec");
    q("lit-none", "--patch %s/lit-none.patch --repo %s/r --base main --check true --out %s/lit-none.rec");
    /* inside a git hook GIT_DIR, GIT_INDEX_FILE and GIT_WORK_TREE name the outer repository: the reads of the source repository must not see them */
    qraw("( GIT_DIR=\"$T/no-outer-gitdir\" GIT_INDEX_FILE=\"$T/no-outer-index\" GIT_WORK_TREE=\"$T/no-outer-tree\" TMPDIR=\"$T/td\" sh ./unisacc.com tools/premerge-selfcheck.cx -- "
         "--patch \"$T/good.patch\" --repo \"$T/r\" --base main --check true --out \"$T/hk.rec\" > \"$T/o/hk.txt\" 2>&1; echo $? > \"$T/o/hk.rc\" ) & ");
    flush();

    ok(rcof("good") == 0 && has("good", "SELFCHECK_SUMMARY patch_sha256=") && has("good", "verdict=PASS"), "good patch: verdict PASS, rc 0");
    ok(has("good", "item=1 name=real-entry verdict=PASS") && has("good", "item=2 name=git-failure verdict=PASS") && has("good", "item=4 name=marker-flip verdict=PASS"), "good patch: items 1, 2 and 4 each PASS on a real run");
    ok(has("good", "item=5 name=negative-input verdict=PASS") && has("good", "item=8 name=paths-and-switches verdict=PASS") && has("p7c", "item=7 name=malformed-input verdict=PASS"), "good patch: items 5 and 8 PASS, and a probe that refuses every malformed input passes item 7");
    ok(rcof("del") == 1 && has("del", "item=6 name=deleted-guard verdict=FAIL"), "deleted guard line without a declaration fails");
    ok(has("del2", "item=6 name=deleted-guard verdict=PASS") && !has("del2", "item=6 name=deleted-guard verdict=FAIL"), "the same deletion with a declared reason passes item 6");
    ok(rcof("path") == 1 && has("path", "item=8 name=hardcoded-path verdict=FAIL"), "a check that hard-codes a path outside the tree fails item 8");
    ok(has("p7a", "item=7 name=malformed-input verdict=FAIL") && has("p7a", "accepted or crashed on 'empty'"), "a probe that accepts every input fails item 7, empty input included");
    ok(has("p7b", "item=7 name=malformed-input verdict=FAIL") && !has("p7b", "accepted or crashed on 'empty'"), "a probe that refuses empty input but accepts others is still caught");
    ok(rcof("stub") == 1 && has("stub", "verdict=FAIL"), "stub patch: verdict FAIL, rc 1");
    ok(has("stub", "item=1 name=stub-output verdict=FAIL") && has("stub", "item=1 name=real-entry verdict=FAIL"), "stub patch: fixed ok=19 output and no real entry are both caught");
    ok(has("stub", "item=4 name=marker-flip verdict=FAIL"), "stub patch: a completion marker that no check verifies is caught");
    ok(rcof("missing") == 2 && has("missing", "REFUSE"), "a missing patch is a refusal, not a pass");
    ok(has("two", "item=6 name=deleted-guard verdict=PASS") && !has("two", "item=6 name=deleted-guard verdict=FAIL"), "every deleted guard line is matched against the declaration table, not only the first");
    ok(has("tsv", "item=6 name=deleted-guard verdict=FAIL") && has("tsv", "tests/batches.tsv"), "a deleted batches row without a declaration fails item 6");
    ok(has("tsv2", "item=6 name=deleted-guard verdict=PASS"), "the same deleted row with a declared reason passes item 6");
    ok(has("stale", "item=6 name=deleted-guard-stale verdict=FAIL"), "a patch built on a base that main has moved past fails the stale-base check");
    ok(has("nonneg", "item=5 name=negative-input verdict=FAIL"), "a changed source with no added negative-input check line fails item 5");
    ok(has("sw-force", "item=8 name=escape-switch verdict=FAIL") && has("sw-force", "--force"), "a source that adds a --force switch fails item 8");
    ok(has("sw-mutate", "item=8 name=escape-switch verdict=FAIL") && has("sw-mutate", "--mutate"), "a source that adds a --mutate switch fails item 8");
    ok(has("sw-skip", "item=8 name=escape-switch verdict=FAIL") && has("sw-skip", "--skip"), "a source that adds a --skip switch fails item 8");
    ok(has("sw-unsafe", "item=8 name=escape-switch verdict=FAIL") && has("sw-unsafe", "--unsafe"), "a source that adds an --unsafe switch fails item 8");
    ok(has("sw-bypass", "item=8 name=escape-switch verdict=FAIL") && has("sw-bypass", "--bypass"), "a source that adds a --bypass switch fails item 8");
    ok(has("g1", "item=3 name=guard-closure verdict=FAIL") && has("g1", "no added check line names path class"), "a guard patch whose checks name no path class fails item 3");
    ok(has("g2", "item=3 name=guard-closure verdict=PASS") && has("g2", "item=7 name=malformed-input verdict=UNMEASURED"), "a guard patch naming every class passes item 3, and item 7 without --probe is UNMEASURED");
    ok(has("i2", "item=2 name=git-failure verdict=FAIL"), "a check that swallows a git failure and stays green fails item 2");
    cx_fmt(sc, sizeof sc, "T=%s; %s", tmp, "test \"$(sha256sum \"$T/good.patch\" | cut -d' ' -f1)\" = \"$(sed -n 's/.*patch_sha256=\\([0-9a-f]*\\).*/\\1/p' \"$T/good.rec\" | head -n 1)\"");
    ok(sh(sc, 0, 0, 10) == 0, "receipt file carries the sha256 of the patch");
    cx_fmt(sc, sizeof sc, "T=%s; %s", tmp, "test \"$(grep -o 'base_commit=[0-9a-f]*' \"$T/good.rec\" | cut -d= -f2)\" = \"$(git -C \"$T/r\" rev-parse main)\" && grep -q 'SELFCHECK_INPUT check0=git rev-parse' \"$T/good.rec\" && grep -q 'tool_sha256=' \"$T/good.rec\"");
    ok(sh(sc, 0, 0, 10) == 0, "the receipt records the base commit, the --check commands and the tool identity");
    ok(has("ci", "CI_OK"), "the receipt's tool_sha256 is the sha256 of the tool's own source, also from another working directory");
    ok(has("pre", "PRE_GONE"), "an old receipt at --out is removed by a refused run");
    ok(has("cw", "CWD_UNTOUCHED"), "a nonexistent --repo is refused (rc 2) and the caller's repository gets no commit and keeps its untracked files");
    ok(has("hk", "SELFCHECK_SUMMARY patch_sha256=") && !has("hk", "REFUSE"), "with GIT_DIR, GIT_INDEX_FILE and GIT_WORK_TREE set to an outer repository (a git hook) the source repository is still read correctly");
    ok(has("nobase", "SELFCHECK_SUMMARY patch_sha256=") && has("nobase", "base_commit=") && !has("nobase", "REFUSE"), "without --base the default revision main is used");
    ok(has(T_G, "item=11 name=commit-gate-preview verdict=NA"), "item 11: a tree without tools/precommit-preview.cx is NA");
    ok(has(T_PA, "item=11 name=commit-gate-preview verdict=PASS") && has(T_PA, "blocked=0 over") && has(T_PA, "head="), "item 11: the gate answering blocked=0 passes and the receipt names the head");
    ok(rcof(T_PB) == 1 && has(T_PB, "commit-gate-preview") && has(T_PB, "blocked=2 over") && has(T_PB, "BLOCK"), "item 11: the gate answering blocked=2 fails and the first BLOCK row is quoted");
    ok(has("b1", "REFUSE repo or base revision invalid"), "an invalid --base is refused before any tree is built");
    ok(has("o1", "REFUSE overlay copy failed") && !has("o1", "SELFCHECK"), "a missing --overlay directory is refused, not ignored");
    ok(has("a1", "REFUSE patch does not apply") && !has("a1", "SELFCHECK"), "a patch that does not apply to the base is refused, no receipt");
    ok(has("t1", "REFUSE check-timeout outside"), "--check-timeout above the 55 s command bound is refused");
    ok(has("lit-ok", "item=10 name=literal-sample verdict=PASS") && !has("lit-ok", "item=10 name=literal-not-in-sample"), "item 10: a literal whose decoded bytes (a real tab) occur in the sample passes");
    ok(has("lit-nosample", "item=10 name=literal-sample verdict=UNMEASURED") && rcof("lit-nosample") == 3, "item 10: added matching literals and no sample is UNMEASURED, rc 3");
    ok(rcof("lit-bs") == 1 && has("lit-bs", "item=10 name=literal-not-in-sample verdict=FAIL") && has("lit-bs", "bytes 43585f464f4f5c746f6b"), "item 10: a literal backslash-t (read wrongly as a tab) is not in the sample and is printed byte for byte");
    ok(rcof("lit-need") == 1 && has("lit-need", "item=10 name=literal-not-in-sample verdict=FAIL") && has("lit-need", "NEED tape"), "item 10: a literal that no real output ever carried fails");
    ok(has("lit-prod", "item=10 name=literal-sample verdict=PASS") && has("lit-prod", "1 proved by the producer"), "item 10: a refusal marker identical to the producer's source text is proved without a sample");
    ok(rcof("lit-noprod") == 1 && has("lit-noprod", "item=10 name=literal-not-in-sample verdict=FAIL") && has("lit-noprod", "REFUSE-W"), "item 10: a refusal marker no producer source carries fails");
    ok(has("lit-none", "item=10 name=literal-sample verdict=NA"), "item 10: a patch with no literal in a matching call is NA");
    cx_fmt(sc, sizeof sc, "T=%s; %s", tmp, "! ls \"$T/td\" | grep -q -E '^(premerge-selfcheck|unisacc-privrepo)-'");
    ok(sh(sc, 0, 0, 10) == 0, "no private tree is left in TMPDIR after passes and refusals");

    cx_fmt(sc, sizeof sc, "rm -rf %s", tmp); sh(sc, 0, 0, 20);
    checks = ckk_okcount(&bad);
    printf("CX_PREMERGE_SELFCHECK\tchecks=%d\tfailed=%d\n", checks, bad);
    return bad ? 1 : 0;
}
