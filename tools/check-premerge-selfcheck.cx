/* check-premerge-selfcheck.cx -- contracts of tools/premerge-selfcheck.cx on synthetic patches and repositories.
 *   sh ./unisacc.com tools/check-premerge-selfcheck.cx [-- --part main|rd]   (the two parts together are the whole check; split for the 55 s bound, see tests/split-parents.tsv)
 * good patch: check calls the real entry, uses git, the completion marker is verified  -> every item PASS, rc 0, receipt bound to the patch sha256.
 * stub patch: check prints a fixed ok=19 line, never mentions the changed source, and the marker is verified by nothing -> items 1 and 4 FAIL, rc 1.
 * bypass switches: a source adding --force, --mutate, --skip, --unsafe or --bypass fails item 8.
 * refusals (rc 2, no receipt, old receipt removed, no scratch tree left, caller's repository untouched): missing patch, invalid base,
 * missing overlay, patch that does not apply, --check-timeout above 55, nonexistent --repo.
 * The tool runs are independent, so they are queued and started together to keep the whole check inside one 55 s command. */
#pragma unisa use cxlib.ckrun
#pragma unisa use cxlib.faultinj
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use text.text

static int bad, checks;
static char g_tmp[1024], qs[30000];
static int qn;
static int g_part;   /* 0 = every assertion; 1 = main part; 2 = rd part (two-round compare, item 10 literal samples, items 6 to 8 probes) */
static void ok_(int c, const char *w) { if (g_part != 2) ckk_ok(c, w); }   /* an assertion of the main part */
static void okr_(int c, const char *w) { if (g_part != 1) ckk_ok(c, w); }   /* an assertion of the rd part */
#define okr(c, w) okr_((c), (w))
#define ok(c, w) ok_((c), (w))
static int sh(const char *script, char *out, int cap, int secs) { return ckk_sh_t("check-premerge-selfcheck", script, out, cap, secs); }

/* append one background shell piece to the batch */
static void qraw(const char *piece) {
    long n = (long)strlen(piece);
    if (qn + n + 8 >= (long)sizeof qs) { printf("batch buffer too small\n"); exit(2); }
    if (mm_copy(qs + qn, (long)sizeof qs - qn, piece, n + 1) != 0) exit(2);
    qn += (int)n;
}
/* runs that belong to the main part only */
static void qraw_main(const char *piece) { if (g_part != 2) qraw(piece); }
/* runs that belong to the rd part only (the part is balanced by wall time, not by assertion count) */
static void qraw_rd(const char *piece) { if (g_part != 1) qraw(piece); }
/* one tool run: stdout+stderr to o/NAME.txt, exit code to o/NAME.rc; ARGFMT takes the temp directory for each %s */
static void q(const char *name, const char *argfmt) {
    char a[2400], l[3200];
    int in_rd = !strncmp(name, "rd-", 3) || !strncmp(name, "lit-", 4) || !strcmp(name, "del") || !strcmp(name, "del2") || !strcmp(name, "path") || !strcmp(name, "p7a") || !strcmp(name, "p7b");   /* the rd part runs these tool runs, the main part the others */
    if (g_part == 2 && !in_rd) return;
    if (g_part == 1 && in_rd) return;
    if (cx_fmt(a, sizeof a, argfmt, g_tmp, g_tmp, g_tmp, g_tmp, g_tmp, g_tmp, g_tmp)) exit(2);
    if (cx_fmt(l, sizeof l, "( TMPDIR=\"$T/td\" \"$T/psc\" %s > \"$T/o/%s.txt\" 2>&1; echo $? > \"$T/o/%s.rc\" ) & ", a, name, name)) exit(2);
    qraw(l);
}
static void flush(void) {
    static char sc[32000];
    if (cx_fmt(sc, sizeof sc, "T=%s; mkdir -p \"$T/o\"; %s wait", g_tmp, qs)) exit(2);
    sh(sc, 0, 0, 55);
}
static char *rd(const char *name, const char *ext) {
    char p[1300], *b, *c; size_t n;
    cx_fmt(p, sizeof p, "%s/o/%s.%s", g_tmp, name, ext);
    b = cx_read(p, &n);
    if (!b) return "";
    c = malloc(n + 1);
    if (mm_copy(c, (long)n + 1, b, (long)n) != 0) exit(2);
    c[n] = 0; free(b);
    return c;
}
static int has(const char *name, const char *needle) { return strstr(rd(name, "txt"), needle) != 0; }
static int rcof(const char *name) { const char *s = rd(name, "rc"); return s[0] ? atoi(s) : -99; }

/* --flip: item 12 (flip-compare) on a repository whose tools/affected.cx is the stand-in tests/cases/premerge-affected-stub.cx.
 * The stand-in takes each batch's status from tests/state.txt of the tree it runs in, so a patch editing that file flips a batch in the patched
 * tree only.  Selection: b-good (kind source), b-refuse-neg (kind literal, a negative control by name), tools-compile-000 (never run). */
static int flip_main(void) {
    char *tmp = g_tmp, sc[6000], out[8192], src[1300], dst[1300];
    if (cx_fmt(tmp, sizeof g_tmp, "%s/psc-flip-XXXXXX", sy_env_or("TMPDIR", "/tmp")) || !mkdtemp(tmp)) return 2;
    if (cx_fmt(src, sizeof src, "tests/cases/premerge-affected-stub.cx") || cx_fmt(dst, sizeof dst, "%s/stub.cx", tmp)) return 2;
    cx_fmt(sc, sizeof sc, "cp %s %s && echo STUB_OK", src, dst);
    if (sh(sc, out, sizeof out, 10) != 0 || !ckk_has(out, sizeof out, "STUB_OK")) { printf("stub copy failed\n"); return 2; }
    cx_fmt(sc, sizeof sc,
        "set -e; R=$(pwd); T=%s; cd \"$T\" && mkdir td r5 && cd r5 && git init -q . && mkdir tools tests && cp ../stub.cx tools/affected.cx && ln -s \"$R/cx\" cx && ln -s \"$R/ext\" ext && ln -s \"$R/cxroot.tsv\" cxroot.tsv && "
        "printf 'int main(void){ return 0; }\\n' > tools/seed.cx && printf 'b-good=1\\nb-refuse-neg=1\\n' > tests/state.txt && git add -A && "
        "git -c user.name=x -c user.email=x@x commit -qm base && git branch -M main && "
        "printf 'int main(void){ return 1; }\\n' > tools/seed.cx && git diff > ../same.patch && "
        "sed -i 's/^b-good=1/b-good=0/' tests/state.txt && git diff > ../flip.patch && git checkout -q -- . && "
        "printf 'int main(void){ return 1; }\\n' > tools/seed.cx && sed -i 's/^b-refuse-neg=1/b-refuse-neg=0/' tests/state.txt && git diff > ../flipneg.patch && git checkout -q -- . && "
        "printf 'batch:b-good\\t-\\tfixture flips this batch on purpose\\n' > ../decl-ok.tsv && "
        "printf 'batch:b-refuse-neg\\t-\\tfixture flips this batch on purpose\\n' > ../decl-neg.tsv && echo FLIPFX_OK", tmp);
    if (sh(sc, out, sizeof out, 30) != 0 || !ckk_has(out, sizeof out, "FLIPFX_OK")) { printf("flip fixture failed: %.400s\n", out); return 2; }
    q("f-same", "--patch %s/same.patch --repo %s/r5 --base main --check true --out %s/f-same.rec");
    q("f-flip", "--patch %s/flip.patch --repo %s/r5 --base main --check true --out %s/f-flip.rec");
    q("f-decl", "--patch %s/flip.patch --repo %s/r5 --base main --check true --declare %s/decl-ok.tsv --out %s/f-decl.rec");
    q("f-wrong", "--patch %s/flip.patch --repo %s/r5 --base main --check true --declare %s/decl-neg.tsv --out %s/f-wrong.rec");
    q("f-gneg", "--patch %s/flipneg.patch --repo %s/r5 --base main --check true --declare %s/decl-neg.tsv --guard --out %s/f-gneg.rec");
    q("f-nog", "--patch %s/flipneg.patch --repo %s/r5 --base main --check true --declare %s/decl-neg.tsv --out %s/f-nog.rec");
    q("f-ids", "--patch %s/same.patch --repo %s/r5 --base main --check true --flip-ids b-good --guard --out %s/f-ids.rec");
    q("f-cap", "--patch %s/same.patch --repo %s/r5 --base main --check true --flip-max 1 --out %s/f-cap.rec");
    q("f-gok", "--patch %s/same.patch --repo %s/r5 --base main --check true --guard --out %s/f-gok.rec");
    flush();
    ok(has("f-same", "item=12 name=flip-compare verdict=PASS") && has("f-same", "2 batches compared") && !has("f-same", "tools-compile-000"),
       "item 12: a patch that flips nothing passes, the tools-compile batch is not run");
    ok(rcof("f-flip") == 1 && has("f-flip", "item=12 name=flip-compare verdict=FAIL") && has("f-flip", "b-good PASS->FAIL") && has("f-flip", "went PASS -> not PASS") && !has("f-flip", "(declared)"),
       "item 12: a batch that went PASS -> FAIL in the patched tree fails and is named");
    ok(has("f-decl", "item=12 name=flip-compare verdict=PASS") && has("f-decl", "b-good PASS->FAIL (declared)") && has("f-decl", "declared=1"),
       "item 12: the same flip with a batch:ID declare row passes and is listed as declared");
    ok(rcof("f-wrong") == 1 && has("f-wrong", "item=12 name=flip-compare verdict=FAIL") && has("f-wrong", "b-good PASS->FAIL") && !has("f-wrong", "(declared)"),
       "item 12: a declare row for another batch does not excuse the flip");
    ok(has("f-gneg", "item=12 name=flip-compare verdict=FAIL") && has("f-gneg", "negative control"),
       "item 12: a guard patch fails when a selected negative control is red after the patch, even when the flip is declared");
    ok(has("f-nog", "item=12 name=flip-compare verdict=PASS") && has("f-nog", "negative-controls=1"),
       "item 12: without --guard the declared flip of that control passes");
    ok(has("f-ids", "item=12 name=flip-compare verdict=UNMEASURED") && has("f-ids", "no negative control"),
       "item 12: a guard patch whose selection holds no negative control is UNMEASURED, not PASS");
    ok(has("f-cap", "item=12 name=flip-compare verdict=UNMEASURED") && has("f-cap", "ran 1 of 2") && has("f-cap", "no PASS flip"),
       "item 12: more batches selected than the cap allows to run is UNMEASURED and says so");
    ok(has("f-gok", "item=12 name=flip-compare verdict=PASS") && has("f-gok", "negative-controls=1"),
       "item 12: a guard patch with a green negative control passes");
    cx_fmt(sc, sizeof sc, "T=%s; %s", tmp, "! ls \"$T/td\" | grep -q -E '^(premerge-selfcheck|unisacc-privrepo)-'");
    ok(sh(sc, 0, 0, 10) == 0, "item 12: no private tree (patched or base) is left in TMPDIR");
    {   const char *sp = sy_env_or("UNISACC_FLIP_SAMPLE", "");   /* the real tool outputs of this run, for the item-10 sample of a patch that changes this check */
        if (sp[0]) { char q2[1300]; if (!ckk_shq(q2, sizeof q2, sp)) { cx_fmt(sc, sizeof sc, "cat %s/o/f-*.txt > %s", tmp, q2); sh(sc, 0, 0, 10); } }
    }
    cx_fmt(sc, sizeof sc, "rm -rf %s", tmp); sh(sc, 0, 0, 20);
    checks = ckk_okcount(&bad);
    printf("CX_PREMERGE_SELFCHECK_FLIP\tchecks=%d\tfailed=%d\n", checks, bad);
    return bad ? 1 : 0;
}

int main(int argc, char **argv) {
    if (argc > 1 && !strcmp(argv[1], "--flip")) return flip_main();
    if (argc > 2 && !strcmp(argv[1], "--part")) { if (!strcmp(argv[2], "main")) g_part = 1; else if (!strcmp(argv[2], "rd")) g_part = 2; else { printf("check-premerge-selfcheck: --part main|rd\n"); return 2; } }
    char *tmp = g_tmp, sc[6000], out[8192]; int rc;
    if (cx_fmt(tmp, sizeof g_tmp, "%s/psc-check-XXXXXX", sy_env_or("TMPDIR", "/tmp")) || !mkdtemp(tmp)) return 2;
    cx_fmt(sc, sizeof sc,
        "set -e; cd %s && mkdir r && cd r && git init -q . && mkdir tools && printf 'int main(void){\\n  if (0) return -1;\\n  return 0;\\n}\\n' > tools/seed.cx && git add -A && "
        "git -c user.name=x -c user.email=x@x commit -qm base && git branch -M main && "
        "printf 'int main(void){ puts(\"READY=yes\"); return 0; }\\n' > tools/foo.cx && "
        "printf 'int main(void){ system(\"cat tools/foo.cx; cat nonexistent_x 2>/dev/null; git rev-parse HEAD\"); printf(\"CX_FOO ok=%%%%d failed=%%%%d\\\\n\", 1, 0); return 0; }\\n' > tools/check-foo.cx && "
        "git add -A && git diff --cached > ../good.patch && git reset -q --hard && rm -f tools/foo.cx tools/check-foo.cx && "
        "printf 'int main(void){ puts(\"READY=yes\"); return 0; }\\n' > tools/foo.cx && "
        "n=19 && printf 'int main(void){ printf(\"CX_FOO ok=%%s failed=0\\\\n\"); return 0; }\\n' \"$n\" > tools/check-foo.cx && "
        "git add -A && git diff --cached > ../stub.patch && git reset -q --hard && rm -f tools/foo.cx tools/check-foo.cx && "
        "sed -i '/return -1/d' tools/seed.cx && git diff > ../del.patch && git checkout -q -- tools/seed.cx && git rm -q tools/seed.cx && git diff --cached > ../delfile.patch && git reset -q --hard && "
        "p=/t; printf 'int main(void){ system(\"cat %%smp/x/y\"); return 0; }\\n' \"$p\" > tools/check-bar.cx && git add -A && git diff --cached > ../path.patch && git reset -q --hard && rm -f tools/check-bar.cx && "
        "printf 'tools/seed.cx\\treturn -1\\tfixture removes the guard on purpose\\n' > ../declare.tsv && "
        "printf 'tools/check-foo.cx\\tCX_FOO\\tfixture renames the marker\\n' > ../rd.decl && git checkout -q -b rd1 && git apply ../good.patch && "
        "printf '  ck(a == 1 && strstr(s, \"x\") && b != 2, \"rd-keep\");\\n  ck(a == 1 && strstr(s, \"y\"), \"rd-drop\");\\n  ck(a == 1 && strcmp(s, \"z\") == 0 && has(s), \"rd-weak\");\\n  ck(strstr(s, \"a\\\\\"b\") && c, \"rd-esc\");\\n  ck(a == 1 && strstr(s, \"w\"), \"r13\");\\n  ck(strstr(s, \"REFUSE x\"), \"rd-neg\");\\n  ck(a == 1);\\n  ck(a == 1 && b, \"zq\");\\n' >> tools/check-foo.cx && printf 'int rd_bar = 1;\\nint rd_baz = 2;\\n' > tools/rd-bar.cx && printf '  ck(a == 2 && strstr(s, \"g1\"), \"rd-gone\");\\n' > tools/rd-gone.cx && "
        "git add -A && git -c user.name=x -c user.email=x@x commit -qm round1 && git diff main rd1 > ../rdr1.patch && "
        "sed -i 's/CX_FOO/CX_BAR/' tools/check-foo.cx && sed -i '/rd-drop/d' tools/check-foo.cx && sed -i '/\"r13\"/d' tools/check-foo.cx && sed -i '/rd-neg/d' tools/check-foo.cx && sed -i '/ck(a == 1);/d' tools/check-foo.cx && sed -i '/\"zq\")/d' tools/check-foo.cx && sed -i '1d' tools/rd-bar.cx && rm tools/rd-gone.cx && sed -i 's/ && has(s)//' tools/check-foo.cx && sed -i 's/ && c, \"rd-esc\"/, \"rd-esc\"/' tools/check-foo.cx && sed -i 's/READY=yes/READY=no/' tools/foo.cx && git diff > ../rd2.patch && git diff main > ../rdcum.patch && git checkout -q -- tools/check-foo.cx tools/foo.cx tools/rd-bar.cx tools/rd-gone.cx && printf '  ck(a == 3, \"rd-plus-one\");\\n  ck(a == 4, \"rd-plus-two\");\\n  ck(a == 5, \"rd-plus-three\");\\n' >> tools/check-foo.cx && git diff > ../rd3.patch && git checkout -q -- tools/check-foo.cx && git checkout -q -b rd1d && git rm -q tools/rd-gone.cx && git -c user.name=x -c user.email=x@x commit -qm nogone && git checkout -q rd1 && git checkout -q -b rd1e && sed -i '/rd-drop/d' tools/check-foo.cx && git -c user.name=x -c user.email=x@x commit -qam nodrop && git checkout -q main && echo FIXTURE_OK", tmp);
    rc = ckk_sh_t("check-premerge-selfcheck", sc, out, sizeof out, 30);
    if (rc != 0 || !ckk_has(out, sizeof out, "FIXTURE_OK")) { printf("fixture setup failed: %.400s\n", out); return 2; }

    const char *T_G = "good", *T_PA = "pv-ok", *T_PB = "pv-bad"; /* receipt tags of the item-11 runs */
    if (g_part == 2) { cx_fmt(sc, sizeof sc, "mkdir -p %s/td", tmp); sh(sc, 0, 0, 10); }
    if (g_part != 2) {   /* the rd part needs only repository r and its rd1 branch */
    /* second fixture set: two-guard seed in r2 (main advances once), a tsv row, and extra patches built in r */
    cx_fmt(sc, sizeof sc, "T=%s; %s", tmp,
        "set -e; cd \"$T\" && mkdir td r2 && cd r2 && git init -q . && mkdir tools tests && "
        "printf 'int main(void){\\n  if (0) return -1;\\n  if (1) return -2;\\n  return 0;\\n}\\n' > tools/seed.cx && "
        "printf 'a\\tb1\\nc\\tb2\\n' > tests/batches.tsv && git add -A && git -c user.name=x -c user.email=x@x commit -qm b0 && git branch -M main && "
        "sed -i '/return -/d' tools/seed.cx && git diff > ../two.patch && git checkout -q -- . && "
        "grep -v '^c' tests/batches.tsv > ../bt && cp ../bt tests/batches.tsv && git diff > ../tsv.patch && git checkout -q -- . && "
        "sed -i '/return -1/d' tools/seed.cx && git diff > ../stale.patch && git -c user.name=x -c user.email=x@x commit -qam b1 && "
        "printf 'tools/seed.cx\\treturn -1\\tfx\\ntools/seed.cx\\treturn -2\\tfx\\n' > ../two.decl && "
        "printf 'tests/batches.tsv\\tc\\tfx drops row c\\n' > ../tsv.decl && cd ../r && "
        "printf 'int main(void){ puts(\"READY=yes\"); return 0; }\\n' > tools/foo.cx && "
        "printf 'int main(void){ system(\"cat tools/foo.cx\"); printf(\"CX_FOO ok=%%d failed=%%d\\\\n\", 1, 0); return 0; }\\n' > tools/check-foo.cx && "
        "git add -A && git diff --cached > ../nonneg.patch && git reset -q --hard && rm -f tools/foo.cx tools/check-foo.cx && "
        "for s in force mutate skip unsafe bypass; do printf 'int main(int c, char **v){ if (c > 1 && !strcmp(v[1], \"--%s\")) return 0; return 1; }\\n' \"$s\" > tools/foo.cx && git add -A && git diff --cached > ../sw-$s.patch && git reset -q --hard && rm -f tools/foo.cx; done && "
        "printf 'int main(void){ puts(\"READY=yes\"); return 0; }\\n' > tools/foo.cx && "
        "printf 'int main(void){ system(\"cat tools/foo.cx; cat nonexistent; git rev-parse HEAD; echo src cx ext exec include seed kernel\"); printf(\"CX_FOO ok=%%d failed=%%d\\\\n\", 1, 0); return 0; }\\n' > tools/check-foo.cx && "
        "git add -A && git diff --cached > ../guard.patch && git reset -q --hard && rm -f tools/foo.cx tools/check-foo.cx && echo FX2_OK");
    rc = ckk_sh_t("check-premerge-selfcheck", sc, out, sizeof out, 30);
    if (rc != 0 || !ckk_has(out, sizeof out, "FX2_OK")) { printf("fixture 2 setup failed: %.400s\n", out); return 2; }

    /* item 14 fixtures: repository r4 holds one registered read; three patches add a read without a row, with its row, and only in a comment */
    cx_fmt(sc, sizeof sc, "T=%s; %s", tmp,
        "set -e; cd \"$T\" && mkdir r4 && cd r4 && git init -q . && mkdir -p cx src tools tests && "
        "printf 'x\\n' > tools.txt && printf '#c\\n' > tests/env-semantics.tsv && "
        "printf 'UNISACC_OLD\\tdom\\toff\\toff\\toff\\toff\\tcx/a.cx\\n' >> tests/env-semantics.tsv && "
        "printf 'void f(void){ sy_env(\"UNISACC_OLD\"); }\\n' > cx/a.cx && printf 'int h;\\n' > src/h.h && printf 'int v;\\n' > src/v.h && printf 'int t;\\n' > tools/t.cx && "
        "git add -A && git -c user.name=x -c user.email=x@x commit -qm e0 && git branch -M main && "
        "printf 'void g(void){ sy_env(\"UNISACC_NEWVAR\"); }\\n' >> cx/a.cx && git diff > ../env-bad.patch && "
        "printf 'UNISACC_NEWVAR\\tdom\\toff\\toff\\toff\\toff\\tcx/b.cx\\n' >> tests/env-semantics.tsv && git diff > ../env-file.patch && "
        "printf 'UNISACC_NEWVAR\\tdom\\toff\\toff\\toff\\toff\\tcx/a.cx,cx/b.cx\\n' >> tests/env-semantics.tsv && git diff > ../env-ok.patch && git checkout -q -- . && "
        "printf '/* reads env(\"UNISACC_NEWVAR\") later */\\n' >> cx/a.cx && printf '// getenv(\"UNISACC_Y\")\\n' >> cx/a.cx && git diff > ../env-cmt.patch && git checkout -q -- . && "
        "printf 'const char *h(void){ return getenv (\"UNISA_NEW\"); }\\n' >> src/h.h && git diff > ../env-unisa.patch && git checkout -q -- . && "
        "printf 'static const char *x_env[] = {\"UNISACC_A\", \"UNISACC_B\"};\\n' >> cx/a.cx && git diff > ../env-table.patch && git checkout -q -- . && "
        "printf '#define SLOT \"UNISACC_VERSION_SLOT_0000000000\"\\n' >> src/v.h && printf 'x = sy_env(\"UNISACC_T\");\\n' >> tools/t.cx && git diff > ../env-na.patch && git checkout -q -- . && echo FX5_OK");
    rc = ckk_sh_t("check-premerge-selfcheck", sc, out, sizeof out, 30);
    if (rc != 0 || !ckk_has(out, sizeof out, "FX5_OK")) { printf("fixture 5 setup failed: %.400s\n", out); return 2; }
    }
    /* third fixture set (item 10): each patch adds a producer (tools/foo.cx) and a check whose matching call looks for one literal */
    {   static const char *lit[][3] = {
            /* name, producer source, check source */
            { "lit-ok", "int main(void){ return 0; }\n", "int main(void){ has(out, \"CX_FOO\\tok\"); return 0; } /* foo.cx nonexistent */\n" },
            { "lit-bs", "int main(void){ return 0; }\n", "int main(void){ has(out, \"CX_FOO\\\\tok\"); return 0; } /* foo.cx nonexistent */\n" },
            { "lit-need", "int main(void){ return 0; }\n", "int main(void){ has(out, \"NEED tape\"); return 0; } /* foo.cx nonexistent */\n" },
            { "lit-prod", "int main(void){ puts(\"REFUSE-Q reason=zz\"); return 0; }\n", "int main(void){ has(out, \"REFUSE-Q reason=zz\"); return 0; } /* foo.cx nonexistent */\n" },
            { "lit-noprod", "int main(void){ return 0; }\n", "int main(void){ has(out, \"REFUSE-W reason=zz\"); return 0; } /* foo.cx nonexistent */\n" },
            { "lit-none", "int main(void){ return 0; }\n", "int main(void){ printf(\"zzzzz\"); return 0; } /* foo.cx nonexistent */\n" },
            { 0, 0, 0 } };
        int li;
        for (li = 0; lit[li][0]; li++) {
            char p1[1300], p2[1300], sc3[1800];
            cx_fmt(p1, sizeof p1, "%s/r/tools/foo.cx", tmp); cx_fmt(p2, sizeof p2, "%s/r/tools/check-foo.cx", tmp);
            if (cx_write(p1, lit[li][1], strlen(lit[li][1])) || cx_write(p2, lit[li][2], strlen(lit[li][2]))) return 2;
            cx_fmt(sc3, sizeof sc3, "cd %s/r && git add -A && git diff --cached > ../%s.patch && git reset -q --hard && git clean -fdq && echo LIT_OK", tmp, lit[li][0]);
            rc = ckk_sh_t("check-premerge-selfcheck", sc3, out, sizeof out, 30);
            if (rc != 0 || !ckk_has(out, sizeof out, "LIT_OK")) { printf("fixture 3 setup failed: %.300s\n", out); return 2; }
        }
        cx_fmt(sc, sizeof sc, "%s/sample-ok.txt", tmp);
        if (cx_write(sc, "CX_FOO\tok\n", 10)) return 2;
    }

    if (g_part != 2) {   /* fixture set 4 is for the main part only */
    /* fourth fixture set (item 11): two copies of r whose tree has a stand-in tools/precommit-preview.cx, one answering blocked=0 and one blocked=2 */
    {   static const char *pvsrc[2] = {
            "int main(void){ printf(\"%s\\n\", \"GATE\\tfake\\tPASS\\tok\\t-\"); printf(\"%s\\n\", \"PRECOMMIT_PREVIEW\\tblocked=0\"); return 0; }\n",
            "int main(void){ printf(\"%s\\n\", \"GATE\\tratchet:fake\\tBLOCK\\tfake gate refuses reason=x\\t-\"); printf(\"%s\\n\", \"PRECOMMIT_PREVIEW\\tblocked=2\"); return 1; }\n" };
        static const char *pvdir[2] = { "rp-ok", "rp-bad" };
        int pi;
        for (pi = 0; pi < 2; pi++) {
            char pp[1300], sc4[1800];
            cx_fmt(sc4, sizeof sc4, "cd %s && rm -rf %s && cp -a r %s", tmp, pvdir[pi], pvdir[pi]);
            rc = ckk_sh_t("check-premerge-selfcheck", sc4, out, sizeof out, 30);
            if (rc != 0) { printf("fixture 4 setup failed: %.300s\n", out); return 2; }
            cx_fmt(pp, sizeof pp, "%s/%s/tools/precommit-preview.cx", tmp, pvdir[pi]);
            if (cx_write(pp, pvsrc[pi], strlen(pvsrc[pi]))) return 2;
            cx_fmt(sc4, sizeof sc4, "cd %s/%s && git add -A && git -c user.name=x -c user.email=x@x commit -qm pv", tmp, pvdir[pi]);
            rc = ckk_sh_t("check-premerge-selfcheck", sc4, out, sizeof out, 30);
            if (rc != 0) { printf("fixture 4 commit failed: %.300s\n", out); return 2; }
        }
    }

    }
    /* prebuild the check target binary once before flush(); in main/orig run the source-identity -run probe concurrently with the build */
    if (g_part != 2) {
        cx_fmt(sc, sizeof sc,
            "T=%s; mkdir -p \"$T/o\"; R=$(pwd); "
            "( cd \"$T\" && TMPDIR=\"$T/td\" sh \"$R/unisacc.com\" \"$R/tools/premerge-selfcheck.cx\" -- --patch \"$T/good.patch\" --repo \"$T/r\" --base main --check true --out \"$T/ci.rec\" >/dev/null 2>&1; "
            "test \"$(grep -o 'tool_sha256=[0-9a-f]*' \"$T/ci.rec\" | cut -d= -f2)\" = \"$(sha256sum \"$R/tools/premerge-selfcheck.cx\" | cut -c1-64)\" && echo CI_OK > \"$T/o/ci.txt\" ) & "
            "sh ./unisacc.com tools/premerge-selfcheck.cx -o \"$T/psc\" >/dev/null 2>&1; brc=$?; wait; exit $brc", tmp);
    } else {
        cx_fmt(sc, sizeof sc, "sh ./unisacc.com tools/premerge-selfcheck.cx -o %s/psc >/dev/null 2>&1", tmp);
    }
    if (sh(sc, 0, 0, 55) != 0) { printf("premerge-selfcheck build failed\n"); return 2; }

    q("good", "--patch %s/good.patch --repo %s/r --base main "
              "--check 'git rev-parse HEAD >/dev/null && grep -q \"READY=yes\" tools/foo.cx && grep -q foo tools/check-foo.cx' --out %s/good.rec");
    q("del", "--patch %s/del.patch --repo %s/r --base main --check true --out %s/del.rec");
    q("del2", "--patch %s/del.patch --repo %s/r --base main --check true --declare %s/declare.tsv --out %s/del2.rec");
    q("path", "--patch %s/path.patch --repo %s/r --base main --check true --out %s/path.rec");
    q("delfile", "--patch %s/delfile.patch --repo %s/r --base main --check true --out %s/delfile.rec");
    q("delfile2", "--patch %s/delfile.patch --repo %s/r --base main --check true --declare %s/declare.tsv --out %s/delfile2.rec");
    q("p7a", "--patch %s/del.patch --repo %s/r --base main --check true --declare %s/declare.tsv --probe 'true' --out %s/p7a.rec");
    q("p7b", "--patch %s/del.patch --repo %s/r --base main --check true --declare %s/declare.tsv --probe 'test -s \"$F\"' --out %s/p7b.rec");
    q("p7c", "--patch %s/good.patch --repo %s/r --base main "
             "--check 'git rev-parse HEAD >/dev/null && grep -q \"READY=yes\" tools/foo.cx && grep -q foo tools/check-foo.cx' --probe false --out %s/p7c.rec");
    q("stub", "--patch %s/stub.patch --repo %s/r --base main --check true --out %s/stub.rec");
    q("missing", "--patch %s/nonexistent.patch --repo %s/r --check true --out %s/x.rec");
    q("rd-a", "--patch %s/rd2.patch --round1 %s/rdr1.patch --repo %s/r --base rd1 --current rd1 --check true --declare %s/rd.decl --out %s/rd-a.rec");
    q("rd-b", "--patch %s/rdcum.patch --round1 %s/rdr1.patch --repo %s/r --base main --check true --declare %s/rd.decl --out %s/rd-b.rec");
    q("rd-c", "--patch %s/rd3.patch --round1 %s/rdr1.patch --repo %s/r --base rd1 --current rd1 --check true --out %s/rd-c.rec");
    q("rd-d", "--patch %s/rd3.patch --round1 %s/rdr1.patch --repo %s/r --base rd1d --current rd1d --check true --out %s/rd-d.rec");
    q("rd-e", "--patch %s/rd3.patch --round1 %s/rdr1.patch --repo %s/r --base rd1e --current rd1e --check true --out %s/rd-e.rec");
    q("mech-bad", "--mechanical --patch %s/tsv.patch --repo %s/r --base main --check true --out %s/mech-bad.rec");
    q("two", "--patch %s/two.patch --repo %s/r2 --base main~1 --current main~1 --check true --declare %s/two.decl --out %s/two.rec");
    q("tsv", "--patch %s/tsv.patch --repo %s/r2 --base main~1 --current main~1 --check true --out %s/tsv.rec");
    q("env-bad", "--patch %s/env-bad.patch --repo %s/r4 --base main --check true --out %s/env-bad.rec");
    q("env-ok", "--patch %s/env-ok.patch --repo %s/r4 --base main --check true --out %s/env-ok.rec");
    q("env-cmt", "--patch %s/env-cmt.patch --repo %s/r4 --base main --check true --out %s/env-cmt.rec");
    q("env-file", "--patch %s/env-file.patch --repo %s/r4 --base main --check true --out %s/env-file.rec");
    q("env-unisa", "--patch %s/env-unisa.patch --repo %s/r4 --base main --check true --out %s/env-unisa.rec");
    q("env-table", "--patch %s/env-table.patch --repo %s/r4 --base main --check true --out %s/env-table.rec");
    q("env-na", "--patch %s/env-na.patch --repo %s/r4 --base main --check true --out %s/env-na.rec");
    q("tsv2", "--patch %s/tsv.patch --repo %s/r2 --base main~1 --current main~1 --check true --declare %s/tsv.decl --out %s/tsv2.rec");
    q("stale", "--patch %s/stale.patch --repo %s/r2 --base main~1 --check true --out %s/stale.rec");
    q("nonneg", "--patch %s/nonneg.patch --repo %s/r --base main --check true --out %s/nonneg.rec");
    q("sw-force", "--patch %s/sw-force.patch --repo %s/r --base main --check true --out %s/swf.rec");
    q("sw-mutate", "--patch %s/sw-mutate.patch --repo %s/r --base main --check true --out %s/swm.rec");
    q("sw-skip", "--patch %s/sw-skip.patch --repo %s/r --base main --check true --out %s/sws.rec");
    q("sw-unsafe", "--patch %s/sw-unsafe.patch --repo %s/r --base main --check true --out %s/swu.rec");
    q("sw-bypass", "--patch %s/sw-bypass.patch --repo %s/r --base main --check true --out %s/swb.rec");
    q("g1", "--patch %s/good.patch --repo %s/r --base main --guard --check true --out %s/g1.rec");
    q("g2", "--patch %s/guard.patch --repo %s/r --base main --guard --check 'grep -q READY=yes tools/foo.cx' --out %s/g2.rec");
    q("i2", "--patch %s/good.patch --repo %s/r --base main --check 'git rev-parse HEAD >/dev/null 2>&1; grep -q READY=yes tools/foo.cx' --out %s/i2.rec");
    q("b1", "--patch %s/good.patch --repo %s/r --base no-such-rev --check true --out %s/b1.rec");
    q("o1", "--patch %s/good.patch --repo %s/r --base main --overlay %s/no-overlay-dir --check true --out %s/o1.rec");
    q("a1", "--patch %s/stale.patch --repo %s/r2 --base main --check true --out %s/a1.rec");
    q("t1", "--patch %s/good.patch --repo %s/r --base main --check true --check-timeout 56 --out %s/t1.rec");
    /* an old receipt at --out does not survive a refusal */
    qraw_main("( printf OLD > \"$T/pre.rec\"; TMPDIR=\"$T/td\" \"$T/psc\" --patch \"$T/nonexistent.patch\" --repo \"$T/r\" --check true --out \"$T/pre.rec\" >/dev/null 2>&1; "
         "test ! -e \"$T/pre.rec\" && echo PRE_GONE > \"$T/o/pre.txt\" ) & ");
    /* a nonexistent --repo is refused and the caller's repository is left alone */
    qraw_rd("( mkdir \"$T/cw\" && cd \"$T/cw\" && git init -q . && echo x > a && git add -A && git -c user.name=x -c user.email=x@x commit -qm c0 && echo u > u && "
         "n1=$(git rev-list --count HEAD) && rc=0 && TMPDIR=\"$T/td\" \"$T/psc\" --patch \"$T/good.patch\" --repo \"$T/no-such-repo\" --check true --out \"$T/cw.rec\" >/dev/null 2>&1 || rc=$?; "
         "n2=$(git rev-list --count HEAD) && test \"$rc\" = 2 && test \"$n1\" = \"$n2\" && test -f u && git status --porcelain | grep -q '^?? u' && test ! -e \"$T/cw.rec\" && echo CWD_UNTOUCHED > \"$T/o/cw.txt\" ) & ");
    q("pv-ok", "--patch %s/good.patch --repo %s/rp-ok --base main --check true --out %s/pv-ok.rec");
    q("pv-bad", "--patch %s/good.patch --repo %s/rp-bad --base main --check true --out %s/pv-bad.rec");
    q("nobase", "--patch %s/good.patch --repo %s/r --check true --out %s/nobase.rec");
    q("lit-ok", "--patch %s/lit-ok.patch --repo %s/r --base main --check true --sample %s/sample-ok.txt --out %s/lit-ok.rec");
    q("lit-nosample", "--patch %s/lit-ok.patch --repo %s/r --base main --check true --out %s/lit-ns.rec");
    q("lit-bs", "--patch %s/lit-bs.patch --repo %s/r --base main --check true --sample %s/sample-ok.txt --out %s/lit-bs.rec");
    q("lit-need", "--patch %s/lit-need.patch --repo %s/r --base main --check true --sample %s/sample-ok.txt --out %s/lit-need.rec");
    q("lit-prod", "--patch %s/lit-prod.patch --repo %s/r --base main --check true --out %s/lit-prod.rec");
    q("lit-noprod", "--patch %s/lit-noprod.patch --repo %s/r --base main --check true --out %s/lit-noprod.rec");
    q("lit-none", "--patch %s/lit-none.patch --repo %s/r --base main --check true --out %s/lit-none.rec");
    /* inside a git hook GIT_DIR, GIT_INDEX_FILE and GIT_WORK_TREE name the outer repository: the reads of the source repository must not see them
       (cxlib.faultinj sets all three to a path that does not exist, so a read that honours them fails) */
    {   char hkp[3000], hkc[3600];
        if (fi_gitenv(1, 0, hkp, sizeof hkp) != 0 ||
            cx_fmt(hkc, sizeof hkc, "( %sTMPDIR=\"$T/td\" \"$T/psc\" "
                   "--patch \"$T/good.patch\" --repo \"$T/r\" --base main --check true --out \"$T/hk.rec\" > \"$T/o/hk.txt\" 2>&1; echo $? > \"$T/o/hk.rc\" ) & ", hkp)) exit(2);
        qraw_main(hkc);
    }
    flush();

    ok(rcof("good") == 0 && has("good", "SELFCHECK_SUMMARY patch_sha256=") && has("good", "verdict=PASS"), "good patch: verdict PASS, rc 0");
    ok(has("good", "item=1 name=real-entry verdict=PASS") && has("good", "item=2 name=git-failure verdict=PASS") && has("good", "item=4 name=marker-flip verdict=PASS"), "good patch: items 1, 2 and 4 each PASS on a real run");
    ok(has("good", "item=5 name=negative-input verdict=PASS") && has("good", "item=8 name=paths-and-switches verdict=PASS") && has("p7c", "item=7 name=malformed-input verdict=PASS"), "good patch: items 5 and 8 PASS, and a probe that refuses every malformed input passes item 7");
    okr(rcof("del") == 1 && has("del", "item=6 name=deleted-guard verdict=FAIL"), "deleted guard line without a declaration fails");
    okr(has("del2", "item=6 name=deleted-guard verdict=PASS") && !has("del2", "item=6 name=deleted-guard verdict=FAIL"), "the same deletion with a declared reason passes item 6");
    okr(rcof("path") == 1 && has("path", "item=8 name=hardcoded-path verdict=FAIL"), "a check that hard-codes a path outside the tree fails item 8");
    okr(has("p7a", "item=7 name=malformed-input verdict=FAIL") && has("p7a", "accepted or crashed on 'empty'"), "a probe that accepts every input fails item 7, empty input included");
    okr(has("p7b", "item=7 name=malformed-input verdict=FAIL") && !has("p7b", "accepted or crashed on 'empty'"), "a probe that refuses empty input but accepts others is still caught");
    ok(rcof("stub") == 1 && has("stub", "verdict=FAIL"), "stub patch: verdict FAIL, rc 1");
    ok(has("stub", "item=1 name=stub-output verdict=FAIL") && has("stub", "item=1 name=real-entry verdict=FAIL"), "stub patch: fixed ok=19 output and no real entry are both caught");
    ok(has("stub", "item=4 name=marker-flip verdict=FAIL"), "stub patch: a completion marker that no check verifies is caught");
    ok(rcof("missing") == 2 && has("missing", "REFUSE"), "a missing patch is a refusal, not a pass");
    ok(has("good", "item=13 name=round-compare verdict=NA"), "item 13: a patch without --round1 is NA");
    ok(rcof("delfile") == 1 && has("delfile", "item=6 name=deleted-guard verdict=FAIL") && has("delfile", "tools/seed.cx deletes an assertion/refusal/verdict line with no declared reason"), "item 6: deleting a whole file that holds a guard line is a deleted guard, not invisible");
    ok(has("delfile2", "item=6 name=deleted-guard verdict=PASS") && !has("delfile2", "item=6 name=deleted-guard verdict=FAIL"), "item 6: a whole-file deletion with a declared reason passes");
    okr(rcof("rd-a") == 1 && has("rd-a", "round-unnamed-change verdict=FAIL detail=round two changes a round-one line with no --declare row (file<TAB>substring<TAB>reason): tools/check-foo.cx: ck(a == 1 && strstr(s, \"y\")") && has("rd-a", "item=13 name=round-rewrite-share verdict=FAIL"), "item 13: an undeclared round-two change to a round-one line, and a rewrite over 30%, both fail");
    okr(!has("rd-a", "reason): tools/check-foo.cx: int main(void){ system("), "item 13: a declared round-two change is not reported as unnamed");
    okr(has("rd-a", "round-assertion-dropped verdict=FAIL detail=round two drops the round-one assertion 'rd-drop'") && !has("rd-a", "assertion 'rd-keep'"), "item 13: a round-one assertion that round two deletes is reported dropped by name, an untouched one is not");
    okr(has("rd-a", "round-assertion-weakened verdict=FAIL detail=round two weakens the round-one assertion 'rd-weak' (tools/check-foo.cx): fewer conditions (6 -> 4)") && has("rd-a", "assertion 'rd-esc' (tools/check-foo.cx): fewer conditions (2 -> 1)"), "item 13: a round-one assertion that round two reduces to fewer conditions is reported weakened, and a name after an escaped quote is read");
    okr(has("rd-a", "round-assertion-dropped verdict=FAIL detail=round two drops the round-one assertion 'r13'") && has("rd-a", "round-negative-count verdict=FAIL detail=the negative-case assertions fall from 1 to 0"), "item 13: a three-character assertion name is read, and a round two that removes the only refusal assertion lowers the number of negative-case assertions");
    okr(!has("rd-a", "the round-one assertion ''") && !has("rd-a", "the round-one assertion 'zq'"), "item 13: an assertion call with no name literal is not an assertion with an empty name");
    okr(has("rd-a", "round-assertion-dropped verdict=FAIL detail=round two drops the round-one assertion 'rd-gone' (tools/rd-gone.cx)"), "item 13: deleting a whole file that holds a round-one assertion reports the assertion dropped");
    okr(rcof("rd-b") == 2 && has("rd-b", "REFUSE round-one lines absent from the base:") && has("rd-b", "first: tools/check-foo.cx: ") && !has("rd-b", "item=13"), "item 13: a --base tree that lacks round one (both rounds cut against main) is refused, never judged as touching 0 of N lines, and the first missing file is the one quoted");
    okr(rcof("rd-d") == 2 && has("rd-d", "REFUSE round-one lines absent from the base:") && has("rd-d", "first: tools/rd-gone.cx: ") && !has("rd-d", "item=13"), "item 13: a base that lacks one round-one file (the last one) is refused and the file is named");
    okr(rcof("rd-e") == 2 && has("rd-e", "REFUSE round-one lines absent from the base:") && has("rd-e", "(1 round-one line(s) are not in it, first: tools/check-foo.cx: ") && has("rd-e", "rd-drop"), "item 13: a base that lacks one round-one line of the first file is refused, with the count and the line quoted");
    ok_(rcof("env-bad") == 1 && has("env-bad", "item=14 name=env-unregistered verdict=FAIL") && has("env-bad", "UNISACC_NEWVAR"), "item 14: a new UNISACC_ read in cx/ without an env-semantics row is FAIL and names the variable");
    ok_(has("env-ok", "item=14 name=env-semantics verdict=PASS") && !has("env-ok", "env-unregistered"), "item 14: the same read with its row listing the file is PASS");
    ok_(has("env-cmt", "item=14 name=env-semantics verdict=NA") && !has("env-cmt", "env-unregistered"), "item 14: a variable named only in a comment is not a read");
    ok_(rcof("env-file") == 1 && has("env-file", "item=14 name=env-unregistered verdict=FAIL") && has("env-file", "cx/a.cx:2"), "item 14: a table row naming the variable but not the reading file is FAIL");
    ok_(rcof("env-unisa") == 1 && has("env-unisa", "UNISA_NEW") && has("env-unisa", "src/h.h:2"), "item 14: an unregistered UNISA_ read, spaced getenv call, in a .h file is FAIL");
    ok_(rcof("env-table") == 1 && has("env-table", "UNISACC_A") && has("env-table", "UNISACC_B"), "item 14: both names of an added *_env[] table are reads");
    ok_(has("env-na", "item=14 name=env-semantics verdict=NA") && !has("env-na", "env-unregistered"), "item 14: the version slot literal and a read under tools/ are not product reads");
    okr(has("rd-c", "item=13 name=round-compare verdict=PASS") && !has("rd-c", "round-negative-count"), "item 13: three added positive assertions with the negative-case count unchanged are not a falling negative share");
    if (g_part != 1) {   /* rd-a.rec exists only in the rd part */
        char rsc[1500];
        cx_fmt(rsc, sizeof rsc, "T=%s; %s", tmp, "test \"$(sha256sum \"$T/rdr1.patch\" | cut -c1-64)\" = \"$(grep -o 'round1_sha256=[0-9a-f]*' \"$T/rd-a.rec\" | head -n 1 | cut -d= -f2)\"");
        okr(sh(rsc, 0, 0, 10) == 0, "item 13: the receipt carries the sha256 of the round-one file");
    }
    ok(rcof("mech-bad") == 1 && has("mech-bad", "MECH item=1 name=apply-check rc=") && has("mech-bad", "verdict=FAIL detail=git apply --check failed") && has("mech-bad", "MECH_SUMMARY patch_sha256=") && has("mech-bad", "fail=7") && has("mech-bad", "verdict=FAIL\n") && !has("mech-bad", "verdict=PASS"), "--mechanical: a patch that does not apply to the base makes the whole receipt FAIL with all seven items listed, never a refusal");
    ok(has("two", "item=6 name=deleted-guard verdict=PASS") && !has("two", "item=6 name=deleted-guard verdict=FAIL"), "every deleted guard line is matched against the declaration table, not only the first");
    ok(has("tsv", "item=6 name=deleted-guard verdict=FAIL") && has("tsv", "tests/batches.tsv"), "a deleted batches row without a declaration fails item 6");
    ok(has("tsv2", "item=6 name=deleted-guard verdict=PASS"), "the same deleted row with a declared reason passes item 6");
    ok(has("stale", "item=6 name=deleted-guard-stale verdict=FAIL"), "a patch built on a base that main has moved past fails the stale-base check");
    ok(has("nonneg", "item=5 name=negative-input verdict=FAIL"), "a changed source with no added negative-input check line fails item 5");
    ok(has("sw-force", "item=8 name=escape-switch verdict=FAIL") && has("sw-force", "--force"), "a source that adds a --force switch fails item 8");
    ok(has("sw-mutate", "item=8 name=escape-switch verdict=FAIL") && has("sw-mutate", "--mutate"), "a source that adds a --mutate switch fails item 8");
    ok(has("sw-skip", "item=8 name=escape-switch verdict=FAIL") && has("sw-skip", "--skip"), "a source that adds a --skip switch fails item 8");
    ok(has("sw-unsafe", "item=8 name=escape-switch verdict=FAIL") && has("sw-unsafe", "--unsafe"), "a source that adds an --unsafe switch fails item 8");
    ok(has("sw-bypass", "item=8 name=escape-switch verdict=FAIL") && has("sw-bypass", "--bypass"), "a source that adds a --bypass switch fails item 8");
    ok(has("g1", "item=3 name=guard-closure verdict=FAIL") && has("g1", "no added check line names path class"), "a guard patch whose checks name no path class fails item 3");
    ok(has("g2", "item=3 name=guard-closure verdict=PASS") && has("g2", "item=7 name=malformed-input verdict=UNMEASURED"), "a guard patch naming every class passes item 3, and item 7 without --probe is UNMEASURED");
    ok(has("i2", "item=2 name=git-failure verdict=FAIL"), "a check that swallows a git failure and stays green fails item 2");
    if (g_part != 2) {   /* these read good.rec, which only the main part makes */
        cx_fmt(sc, sizeof sc, "T=%s; %s", tmp, "test \"$(sha256sum \"$T/good.patch\" | cut -d' ' -f1)\" = \"$(sed -n 's/.*patch_sha256=\\([0-9a-f]*\\).*/\\1/p' \"$T/good.rec\" | head -n 1)\"");
        ok(sh(sc, 0, 0, 10) == 0, "receipt file carries the sha256 of the patch");
        cx_fmt(sc, sizeof sc, "T=%s; %s", tmp, "test \"$(grep -o 'base_commit=[0-9a-f]*' \"$T/good.rec\" | cut -d= -f2)\" = \"$(git -C \"$T/r\" rev-parse main)\" && grep -q 'SELFCHECK_INPUT check0=git rev-parse' \"$T/good.rec\" && grep -q 'tool_sha256=' \"$T/good.rec\"");
        ok(sh(sc, 0, 0, 10) == 0, "the receipt records the base commit, the --check commands and the tool identity");
    }
    ok(has("ci", "CI_OK"), "the receipt's tool_sha256 is the sha256 of the tool's own source, also from another working directory");
    ok(has("pre", "PRE_GONE"), "an old receipt at --out is removed by a refused run");
    okr(has("cw", "CWD_UNTOUCHED"), "a nonexistent --repo is refused (rc 2) and the caller's repository gets no commit and keeps its untracked files");
    ok(has("hk", "SELFCHECK_SUMMARY patch_sha256=") && !has("hk", "REFUSE"), "with GIT_DIR, GIT_INDEX_FILE and GIT_WORK_TREE set to an outer repository (a git hook) the source repository is still read correctly");
    ok(has("nobase", "SELFCHECK_SUMMARY patch_sha256=") && has("nobase", "base_commit=") && !has("nobase", "REFUSE"), "without --base the default revision main is used");
    ok(has(T_G, "item=11 name=commit-gate-preview verdict=NA"), "item 11: a tree without tools/precommit-preview.cx is NA");
    ok(has(T_G, "item=12 name=flip-compare verdict=NA") && has(T_G, "no tools/affected.cx"), "item 12: a tree without tools/affected.cx is NA");
    ok(has(T_PA, "item=11 name=commit-gate-preview verdict=PASS") && has(T_PA, "blocked=0 over") && has(T_PA, "head="), "item 11: the gate answering blocked=0 passes and the receipt names the head");
    ok(rcof(T_PB) == 1 && has(T_PB, "commit-gate-preview") && has(T_PB, "blocked=2 over") && has(T_PB, "BLOCK"), "item 11: the gate answering blocked=2 fails and the first BLOCK row is quoted");
    ok(has("b1", "REFUSE repo or base revision invalid"), "an invalid --base is refused before any tree is built");
    ok(has("o1", "REFUSE overlay copy failed") && !has("o1", "SELFCHECK"), "a missing --overlay directory is refused, not ignored");
    ok(has("a1", "REFUSE patch does not apply") && !has("a1", "SELFCHECK"), "a patch that does not apply to the base is refused, no receipt");
    ok(has("t1", "REFUSE check-timeout outside"), "--check-timeout above the 55 s command bound is refused");
    okr(has("lit-ok", "item=10 name=literal-sample verdict=PASS") && !has("lit-ok", "item=10 name=literal-not-in-sample"), "item 10: a literal whose decoded bytes (a real tab) occur in the sample passes");
    okr(has("lit-nosample", "item=10 name=literal-sample verdict=UNMEASURED") && rcof("lit-nosample") == 3, "item 10: added matching literals and no sample is UNMEASURED, rc 3");
    okr(rcof("lit-bs") == 1 && has("lit-bs", "item=10 name=literal-not-in-sample verdict=FAIL") && has("lit-bs", "bytes 43585f464f4f5c746f6b"), "item 10: a literal backslash-t (read wrongly as a tab) is not in the sample and is printed byte for byte");
    okr(rcof("lit-need") == 1 && has("lit-need", "item=10 name=literal-not-in-sample verdict=FAIL") && has("lit-need", "NEED tape"), "item 10: a literal that no real output ever carried fails");
    okr(has("lit-prod", "item=10 name=literal-sample verdict=PASS") && has("lit-prod", "1 proved by the producer"), "item 10: a refusal marker identical to the producer's source text is proved without a sample");
    okr(rcof("lit-noprod") == 1 && has("lit-noprod", "item=10 name=literal-not-in-sample verdict=FAIL") && has("lit-noprod", "REFUSE-W"), "item 10: a refusal marker no producer source carries fails");
    okr(has("lit-none", "item=10 name=literal-sample verdict=NA"), "item 10: a patch with no literal in a matching call is NA");
    cx_fmt(sc, sizeof sc, "T=%s; %s", tmp, "! ls \"$T/td\" | grep -q -E '^(premerge-selfcheck|unisacc-privrepo)-'");
    ok(sh(sc, 0, 0, 10) == 0, "no private tree is left in TMPDIR after passes and refusals");

    cx_fmt(sc, sizeof sc, "rm -rf %s", tmp); sh(sc, 0, 0, 20);
    checks = ckk_okcount(&bad);
    if (g_part) printf("CX_PREMERGE_SELFCHECK_PART\tpart=%s\tchecks=%d\tfailed=%d\n", g_part == 1 ? "main" : "rd", checks, bad);
    else printf("CX_PREMERGE_SELFCHECK\tchecks=%d\tfailed=%d\n", checks, bad);
    return bad ? 1 : 0;
}
