/* Tool self-check for the devsvc freeze write-window lock (tools/devsvc-repo.tsv + tools/devsvc-core.cx).
 * Uses a clean git-archive checkout (real commit-own.cx, no stub) and isolated devsvc instance.
 * Covers: config lock/lockdomain rows, ttl=7200 acquire & DEVSVC_OWNER acquire, path normalization
 * (docs/../src/a.txt and symlink lnk -> src), multi-path --whole, git add/merge/register/derive --write,
 * unified owner resolution (--owner > DEVSVC_OWNER, CLAUDE_JOB_ID no self-lock), case-insensitive owner,
 * mid-segment negative examples (docs/src/x, tests2/x, release-x/y for M1), worktree shared freeze lock,
 * release and ttl expiry recovery, real commit-own X-Unisacc-Window trailer and no forged trailer.
 * Check: CHECK_DEVSVC_FREEZE. */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use sys.posix
#pragma unisa use sys.sig
#pragma unisa use cxlib.netpack
#pragma unisa use mem.bytes
#pragma unisa use mem.heap

static char root[4096], tmp[4096], prod[4200], src_core[4200], bin[4200], repo[4200], wt[4200], inst[4200];
static char out[65536];
static int passed, failed, g_no_autostart, g_use_self_bin;

static void ck(const char *label, int ok) {
    if (ok) passed++; else failed++;
    printf("%s\tdevsvc-freeze.%s\n", ok ? "PASS" : "FAIL", label);
    if (!ok) printf("NOTE\toutput\t%.500s\n", out);
    fflush(stdout);
}

static int has(const char *hay, const char *s) {
    if (!hay || !s) return 0;
    size_t hn = strlen(hay), sn = strlen(s);
    if (sn == 0) return 1;
    if (sn > hn) return 0;
    for (size_t i = 0; i + sn <= hn; i++) {
        if (hay[i] == s[0] && mm_same(hay + i, s, sn)) return 1;
    }
    return 0;
}

static int read_pid_file(const char *path) {
    unsigned char *b = 0; int64_t n = 0;
    if (sy_read_file(path, &b, &n, 64) != 0 || !b || n <= 0) { mm_free(b); return 0; }
    int pid = 0;
    for (int64_t i = 0; i < n && b[i] >= '0' && b[i] <= '9'; i++) pid = pid * 10 + (int)(b[i] - '0');
    mm_free(b);
    return pid;
}

/* 1 when PID does not exist (-ESRCH) or is already a zombie (State:\tZ awaiting ancestor subreaper). */
static int pid_is_gone_or_zombie(int pid) {
    if (pid <= 0) return 1;
    if (sy_signal(pid, 0) == -ESRCH) return 1;
    char sp[64];
    unsigned char *b = 0; int64_t n = 0;
    if (cx_fmt(sp, sizeof sp, "/proc/%d/status", pid)) return 0;
    int rc = sy_read_file(sp, &b, &n, 4096);
    if (rc == -ENOENT) { mm_free(b); return 1; }
    if (rc != 0 || !b || n <= 0) { mm_free(b); return 0; }
    int z = 0;
    for (int64_t i = 0; i + 8 <= n; i++) {
        if (b[i] == 'S' && mm_same(b + i, "State:\tZ", 8)) { z = 1; break; }
    }
    mm_free(b);
    return z;
}

/* Bounded poll (every 50ms up to timeout_ms) until sock is removed and daemon PID is gone/zombie. */
static int wait_daemon_gone(const char *pid_file, const char *sock_path, int timeout_ms) {
    int pid = read_pid_file(pid_file);
    long deadline = sy_now_ms() + (long)timeout_ms;
    for (;;) {
        if (sy_exists(sock_path) == 0 && pid_is_gone_or_zombie(pid)) return 1;
        if (sy_now_ms() >= deadline) break;
        sy_sleep_ms(50);
    }
    return (sy_exists(sock_path) == 0 && pid_is_gone_or_zombie(pid)) ? 1 : 0;
}

static int runv(char **v, const char *cwd, char **env, int secs, int *rc) {
    np_result r = {0}; char why[300];
    *rc = -1; out[0] = 0;
    if (np_run(v, cwd, env, secs, &r, why, sizeof why)) {
        fprintf(stderr, "exec %s: %s\n", v[0], why);
        return 0;
    }
    *rc = r.rc;
    long k = (long)r.outn < (long)sizeof out - 1 ? (long)r.outn : (long)sizeof out - 1;
    if (k > 0) mm_copy(out, sizeof out, r.out, k);
    out[k > 0 ? k : 0] = 0;
    if (r.errn) {
        long e = (long)r.errn < (long)sizeof out - 1 - k ? (long)r.errn : (long)sizeof out - 1 - k;
        if (e > 0) { mm_copy(out + k, sizeof out - k, r.err, e); out[k + e] = 0; }
    }
    np_free(&r);
    return 1;
}

static int run_dv_ex(const char *cwd, const char *owner, const char *job_id, char **args, int *rc) {
    char *v[32]; int n = 0;
    char e_inst[4300], e_tab[4300], e_own[128], e_job[128], e_tmp[4300], e_pin[4300], e_home[4300], e_path[4300], e_self[4300];
    char *env[14]; int ne = 0;
    const char *hv = sy_env("HOME"), *pv = sy_env("PATH");
    v[n++] = bin;
    for (int i = 0; args[i] && n < 30; i++) v[n++] = args[i];
    v[n] = 0;
    if (cx_fmt(e_inst, sizeof e_inst, "UNISACC_DEVSVC_DIR=%s", inst) ||
        cx_fmt(e_tab, sizeof e_tab, "DEVSVC_REPO_TABLE=%s/tools/devsvc-repo.tsv", repo) ||
        cx_fmt(e_tmp, sizeof e_tmp, "TMPDIR=%s", tmp) ||
        cx_fmt(e_pin, sizeof e_pin, "DV_PIN_DIR=%s/pin", tmp)) return 0;
    env[ne++] = e_inst;
    env[ne++] = e_tab;
    env[ne++] = e_tmp;
    env[ne++] = e_pin;
    if (hv && *hv && !cx_fmt(e_home, sizeof e_home, "HOME=%s", hv)) env[ne++] = e_home;
    if (pv && *pv && !cx_fmt(e_path, sizeof e_path, "PATH=%s", pv)) env[ne++] = e_path;
    if (g_use_self_bin && !cx_fmt(e_self, sizeof e_self, "DEVSVC_SELF_BIN=%s", bin)) env[ne++] = e_self;
    if (g_no_autostart) env[ne++] = "DEVSVC_NO_AUTOSTART=1";
    if (owner && *owner) {
        if (cx_fmt(e_own, sizeof e_own, "DEVSVC_OWNER=%s", owner)) return 0;
        env[ne++] = e_own;
    }
    if (job_id && *job_id) {
        if (cx_fmt(e_job, sizeof e_job, "CLAUDE_JOB_ID=%s", job_id)) return 0;
        env[ne++] = e_job;
    }
    env[ne] = 0;
    return runv(v, cwd, env, 55, rc);
}

static int run_dv(const char *cwd, const char *owner, char **args, int *rc) {
    return run_dv_ex(cwd, owner, 0, args, rc);
}

static int wr(const char *dir, const char *rel, const char *txt) {
    char p[4500];
    if (cx_fmt(p, sizeof p, "%s/%s", dir, rel)) return 1;
    return sy_write_file(p, txt, strlen(txt), 0644);
}

static int sh_in(const char *cwd, const char *cmd) {
    char *v[] = {"sh", "-c", (char *)cmd, 0}; int rc = -1;
    return runv(v, cwd, 0, 40, &rc) && rc == 0;
}

int main(int argc, char **argv) {
    char f_new[4400], f_old[4400], f_rep[4400], cmd[4800], gitp[4200];
    int rc = -1;
    int scope_only = argc == 3 && !strcmp(argv[2], "--scope-only");
    int owner_only = argc == 3 && !strcmp(argv[2], "--owner-only");
    int lifecycle_only = argc == 3 && !strcmp(argv[2], "--lifecycle-only");
    int split = scope_only || owner_only || lifecycle_only;
    /* Keep real commits and merges. Registered slices skip the optional
       commit-own pending-derived hint and post-merge launcher rebuild. */
    const char *archive_paths = split
        ? " -- . ':(exclude)archive' ':(exclude)tools/on-change.cx' ':(exclude)tools/devsvc.cx'" : "";
    const char *configure_repo = split ? "git config gc.auto 0 && " : "";
    if (sy_cwd(root, sizeof root) < 0) return 2;
    if (argc >= 3 && !strcmp(argv[1], "--prepare-only")) {
        if (cx_fmt(prod, sizeof prod, "%s/unisacc.com", root) || /* lint:allow R1-product test harness invokes checkout product directly */
            cx_fmt(src_core, sizeof src_core, "%s/tools/devsvc-core.cx", root)) return 2;
        char *bv[] = {"sh", prod, src_core, "-o", argv[2], 0};
        if (!runv(bv, root, 0, 55, &rc) || rc != 0) { fprintf(stderr, "prepare devsvc-core failed rc=%d: %s\n", rc, out); return 2; }
        printf("PREPARED\tdevsvc-core\tbin=%s\n", argv[2]);
        return 0;
    }
    if (cx_fmt(gitp, sizeof gitp, "%s/.git", root)) return 2;
    if (sy_exists(gitp) == 0) {
        printf("UNMEASURED\tdevsvc-freeze\tno-.git-in-root\n");
        printf("CHECK_DEVSVC_FREEZE\tpass=0\tfail=0\tunmeasured=1\n");
        return split ? 1 : 0;
    }
    { char wt_base[4300];
      if (cx_fmt(wt_base, sizeof wt_base, "%s/.work/tmp", root) || sy_mkdir_all(wt_base, 0700) ||
          sy_mkdtemp(wt_base, "dvf", tmp, sizeof tmp)) return 2; }
    if (sy_mkdtemp("/tmp", "dvfs", inst, sizeof inst)) return 2;
    if (cx_fmt(prod, sizeof prod, "%s/unisacc.com", root) || /* lint:allow R1-product test harness invokes checkout product directly */
        cx_fmt(src_core, sizeof src_core, "%s/tools/devsvc-core.cx", root) ||
        cx_fmt(repo, sizeof repo, "%s/repo", tmp) ||
        cx_fmt(wt, sizeof wt, "%s/wt", tmp) ||
        cx_fmt(f_new, sizeof f_new, "%s/new.txt", tmp) ||
        cx_fmt(f_old, sizeof f_old, "%s/old.txt", tmp) ||
        cx_fmt(f_rep, sizeof f_rep, "%s/rep.txt", tmp)) return 2;
    if (argc >= 2 && argv[1][0]) {
        if (sy_realpath(argv[1], bin, sizeof bin) < 0) { fprintf(stderr, "bad core binary: %s\n", argv[1]); return 2; }
    } else {
        if (cx_fmt(bin, sizeof bin, "%s/devsvc-core", tmp)) return 2;
        char *bv[] = {"sh", prod, src_core, "-o", bin, 0};
        if (!runv(bv, root, 0, 55, &rc) || rc != 0) { fprintf(stderr, "compile devsvc-core failed rc=%d: %s\n", rc, out); return 2; }
    }

    if (sy_mkdir_all(repo, 0700) || sy_mkdir_all(inst, 0700)) return 2;
    if (wr(tmp, "new.txt", "updated\n") || wr(tmp, "old.txt", "initial\n") || wr(tmp, "rep.txt", "edited\n")) return 2;

    /* Clean git-archive checkout (real commit-own.cx, cx/, ext/, tools/) + worktree table copy */
    if (cx_fmt(cmd, sizeof cmd,
               "git -C '%s' archive HEAD%s | tar -x -C '%s' && "
               "ln -s '%s/unisacc.com' '%s/unisacc.com' && "
               "cp '%s/tools/devsvc-repo.tsv' '%s/tools/devsvc-repo.tsv' && "
               "mkdir -p '%s/docs/src' '%s/tests2' '%s/release-x' && "
               "ln -s src '%s/lnk'",
               root, archive_paths, repo, root, repo, root, repo, repo, repo, repo, repo) || !sh_in(root, cmd)) {
        fprintf(stderr, "setup archive repo failed: %s\n", out);
        return 2;
    }
    if (wr(repo, "src/a.txt", "initial\n") ||
        wr(repo, "docs/note.txt", "initial\n") ||
        wr(repo, "docs/src/x.txt", "initial\n") ||
        wr(repo, "tests2/x.txt", "initial\n") ||
        wr(repo, "release-x/y.txt", "initial\n") ||
        wr(repo, "build/freeze.tsv", "# empty\n")) return 2;
    if (cx_fmt(cmd, sizeof cmd, "git init -q -b main && %sgit add -A && git -c user.name=fx -c user.email=fx@localhost -c commit.gpgsign=false commit -qm init", configure_repo) ||
        !sh_in(repo, cmd)) {
        fprintf(stderr, "setup init commit failed: %s\n", out);
        return 2;
    }
    /* Create a side branch for git merge refusal test */
    if (!sh_in(repo, "git checkout -q -b side-br && printf 'side\\n' > docs/side.txt && git add docs/side.txt && git -c user.name=fx -c user.email=fx@localhost -c commit.gpgsign=false commit -qm side && git checkout -q main")) {
        fprintf(stderr, "setup side branch failed: %s\n", out);
        return 2;
    }
    if (cx_fmt(cmd, sizeof cmd, "git worktree add -q -b wt-branch '%s' && ln -s '%s/unisacc.com' '%s/unisacc.com'", wt, root, wt) ||
        !sh_in(repo, cmd)) {
        fprintf(stderr, "setup worktree failed: %s\n", out);
        return 2;
    }

    /* (1) config includes freeze lock and domain */
    { char *a[] = {"config", 0};
      ck("config-has-freeze", run_dv(repo, "integ", a, &rc) && rc == 0 &&
         has(out, "CFG\tlock\tfreeze\n") &&
         has(out, "CFG\tlockdomain\tfreeze\tsrc/,cx/,ext/,include/,seed/,exec/,kernel/,weights/,tests/,release/,build/freeze.tsv\n")); }

    /* Start isolated devsvc instance via prepared native binary and record its PID */
    {
        char scmd[4800];
        if (cx_fmt(scmd, sizeof scmd,
                   "UNISACC_DEVSVC_DIR='%s' DEVSVC_REPO_TABLE='%s/tools/devsvc-repo.tsv' DEVSVC_OWNER=integ "
                   "nohup '%s' serve --ttl 120 --idle 60 >'%s/serve.log' 2>&1 & echo $! > '%s/serve.pid'; "
                   "i=0; while [ $i -lt 50 ]; do [ -S '%s/sock' ] && exit 0; sleep 0.1; i=$((i+1)); done; cat '%s/serve.log'; exit 1",
                   inst, repo, bin, tmp, tmp, inst, tmp) || !sh_in(repo, scmd)) {
            fprintf(stderr, "start failed: %s\n", out);
            failed++;
            goto done;
        }
    }

    /* (2) acquire freeze via DEVSVC_OWNER (no --owner flag) with ttl=7200 and uppercase normalization */
    { char *a[] = {"lock", "acquire", "freeze", "--ttl", "7200", 0};
      ck("acquire-via-env-ttl-7200", run_dv(repo, "Integ", a, &rc) && rc == 0 && has(out, "OK\tacquired\tfreeze\towner=integ")); }

    if (scope_only) goto scope;
    if (owner_only) goto owner;
    /* (3) non-owner f write in freeze domain refused */
    { char *a[] = {"f", "write", "src/a.txt", "--from", f_new, 0};
      size_t n = 0; char *cur; char p[4500];
      int ok = run_dv(repo, "worker1", a, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=integ");
      cx_fmt(p, sizeof p, "%s/src/a.txt", repo);
      cur = cx_read(p, &n);
      ok = ok && cur && n == 8 && mm_same(cur, "initial\n", 8);
      free(cur);
      ck("non-owner-f-write-refused", ok); }

    /* (4) CONFIRMED (1): path traversal docs/../src/a.txt refused */
    { char *a[] = {"f", "write", "docs/../src/a.txt", "--from", f_new, 0};
      ck("non-owner-dotdot-traversal-refused", run_dv(repo, "worker1", a, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=integ")); }

    /* (5) CONFIRMED (2): symlink bypass lnk/a.txt and non-existent lnk/new-file.txt refused */
    { char *a1[] = {"f", "write", "lnk/a.txt", "--from", f_new, 0};
      char *a2[] = {"f", "write", "lnk/new-file.txt", "--from", f_new, 0};
      int ok1 = run_dv(repo, "worker1", a1, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=integ");
      int ok2 = ok1 && run_dv(repo, "worker1", a2, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=integ");
      ck("non-owner-symlink-bypass-refused", ok2); }

    /* (6) non-owner f edit & build/freeze.tsv refused */
    { char *a1[] = {"f", "edit", "src/a.txt", "--old-file", f_old, "--new-file", f_rep, 0};
      char *a2[] = {"f", "write", "build/freeze.tsv", "--from", f_new, 0};
      int ok1 = run_dv(repo, "worker1", a1, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=integ");
      int ok2 = ok1 && run_dv(repo, "worker1", a2, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=integ");
      ck("non-owner-edit-and-freeze-tsv-refused", ok2); }

    /* (7) CONFIRMED (3): git commit --whole multi-path (outside + inside) refused and HEAD unchanged */
    { char h0[64], h1[64];
      char *a[] = {"git", "commit", "-m", "multi blocked", "--whole", "docs/note.txt", "src/a.txt", 0};
      int ok0 = sh_in(repo, "git rev-parse HEAD");
      mm_copy(h0, sizeof h0, out, 40); h0[40] = 0;
      int ok1 = ok0 && run_dv(repo, "worker1", a, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=integ");
      int ok2 = ok1 && sh_in(repo, "git rev-parse HEAD");
      mm_copy(h1, sizeof h1, out, 40); h1[40] = 0;
      ck("non-owner-commit-multi-whole-refused", ok2 && mm_same(h0, h1, 40)); }

    /* (7b) CONFIRMED (A): switches (--push/--derive/--dry-run) between --whole paths must NOT reset path mode, and --push checks freeze */
    { char *a1[] = {"git", "commit", "--whole", "docs/note.txt", "--push", "src/a.txt", "-m", "push mid", 0};
      char *a2[] = {"git", "commit", "--whole", "docs/note.txt", "--derive", "src/a.txt", "-m", "derive mid", 0};
      char *a3[] = {"git", "commit", "--whole", "docs/note.txt", "--dry-run", "src/a.txt", "-m", "dry mid", 0};
      char *a4[] = {"git", "commit", "--whole", "docs/note.txt", "--push", "-m", "push outside", 0};
      char *a5[] = {"git", "commit", "--keyed", "docs/note.txt", "--derive", "src/a.txt", "-m", "keyed path key", 0};
      int ok1 = run_dv(repo, "worker1", a1, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=integ");
      int ok2 = ok1 && run_dv(repo, "worker1", a2, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=integ");
      int ok3 = ok2 && run_dv(repo, "worker1", a3, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=integ");
      int ok4 = ok3 && run_dv(repo, "worker1", a4, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=integ");
      int ok5 = ok4 && run_dv(repo, "worker1", a5, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=integ");
      ck("non-owner-commit-switch-between-paths-refused", ok5); }

    /* (8) CONFIRMED (4) + --no-ff: other write channels (git add, git merge --no-ff, register, derive --write) refused for non-owner */
    { char *aa[] = {"git", "add", "src/a.txt", 0};
      char *am[] = {"git", "merge", "--no-ff", "side-br", "-m", "blocked merge", 0};
      char *ar[] = {"register", "dummy", "tools/check-dummy.cx", "DUMMY", "desc", "tools/dummy.cx", 0};
      char *ad[] = {"derive", "--write", "--only", "table-index", 0};
      int ok1 = run_dv(repo, "worker1", aa, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=integ");
      int ok2 = ok1 && run_dv(repo, "worker1", am, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=integ");
      int ok3 = ok2 && run_dv(repo, "worker1", ar, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=integ");
      int ok4 = ok3 && run_dv(repo, "worker1", ad, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=integ");
      ck("non-owner-other-write-channels-refused", ok4); }

    /* (8b) holder integrator devsvc git merge --no-ff creates real 2-parent merge commit (ff=0) */
    { char *am[] = {"git", "merge", "--no-ff", "side-br", "-m", "S0 merge side-br", 0};
      int ok1 = run_dv(repo, "integ", am, &rc) && rc == 0 && has(out, "GIT_MERGE\trc=0\t") && has(out, "\tff=0\t");
      int ok2 = ok1 && sh_in(repo, "git rev-list --parents -n 1 HEAD | wc -w") && (out[0] == '3' || has(out, " 3\n"));
      ck("integrator-git-merge-no-ff-creates-merge-commit", ok2); }

    if (lifecycle_only) goto lifecycle;
owner:
    /* (9) CONFIRMED (9) M1 killer: outside-domain & mid-segment paths (docs/src/x.txt, tests2/x.txt, release-x/y.txt) allowed */
    { char *a1[] = {"f", "write", "docs/src/x.txt", "--from", f_new, 0};
      char *a2[] = {"f", "write", "tests2/x.txt", "--from", f_new, 0};
      char *a3[] = {"f", "write", "release-x/y.txt", "--from", f_new, 0};
      char *aw[] = {"f", "write", "docs/note.txt", "--from", f_new, 0};
      char *ac[] = {"git", "commit", "-m", "outside domain real commit", "--whole", "docs/note.txt", 0};
      int ok1 = run_dv(repo, "worker1", a1, &rc) && rc == 0;
      int ok2 = ok1 && run_dv(repo, "worker1", a2, &rc) && rc == 0;
      int ok3 = ok2 && run_dv(repo, "worker1", a3, &rc) && rc == 0;
      int ok4 = ok3 && run_dv(repo, "worker1", aw, &rc) && rc == 0;
      int ok5 = ok4 && run_dv(repo, "worker1", ac, &rc) && rc == 0;
      ck("non-owner-outside-and-mid-segment-allowed", ok5); }

    /* (10) CONFIRMED (5): CLAUDE_JOB_ID set without DEVSVC_OWNER, integrator passes --owner integ on f write & git commit without self-lock */
    { char *aw[] = {"f", "write", "src/a.txt", "--from", f_new, "--owner", "integ", 0};
      char *ac[] = {"git", "commit", "--owner", "integ", "-m", "owner flag real commit", "--whole", "src/a.txt", 0};
      int ok1 = run_dv_ex(repo, 0, "job123", aw, &rc) && rc == 0;
      int ok2 = ok1 && run_dv_ex(repo, 0, "job123", ac, &rc) && rc == 0;
      int ok3 = ok2 && sh_in(repo, "git log -1 --format='%(trailers)'") && has(out, "X-Unisacc-Window: integ");
      ck("integrator-owner-flag-no-self-lock", ok3); }

    /* (11) CONFIRMED (6): case-insensitive owner (DEVSVC_OWNER=Integ) allowed, normalized lowercase trailer, lock stays held */
    { char *aw[] = {"f", "write", "src/a.txt", "--from", f_rep, 0};
      char *ac[] = {"git", "commit", "-m", "case norm real commit", "--whole", "src/a.txt", 0};
      char *al[] = {"lock", "list", 0};
      int ok1 = run_dv(repo, "Integ", aw, &rc) && rc == 0;
      int ok2 = ok1 && run_dv(repo, "Integ", ac, &rc) && rc == 0;
      int ok3 = ok2 && sh_in(repo, "git log -1 --format='%(trailers)'") && has(out, "X-Unisacc-Window: integ");
      int ok4 = ok3 && run_dv(repo, "integ", al, &rc) && rc == 0 && has(out, "LOCK\tfreeze\towner=integ\t");
      ck("owner-case-insensitive-trailer-and-lock-kept", ok4); }

    /* (11b) CONFIRMED (D): leading/trailing whitespace in DEVSVC_OWNER=" integ " works across f write and git commit */
    { char *aw[] = {"f", "write", "src/a.txt", "--from", f_old, 0};
      char *ac[] = {"git", "commit", "-m", "trimmed owner commit", "--whole", "src/a.txt", 0};
      int ok1 = run_dv(repo, " integ ", aw, &rc) && rc == 0;
      int ok2 = ok1 && run_dv(repo, " integ ", ac, &rc) && rc == 0;
      int ok3 = ok2 && sh_in(repo, "git log -1 --format='%(trailers)'") && has(out, "X-Unisacc-Window: integ");
      ck("owner-whitespace-trimmed-all-channels", ok3); }

    /* (11c) CONFIRMED (B): four locks.tsv corruptions while daemon holds freeze all fail closed */
    { char lp[4500]; char *bak = 0; size_t bn = 0;
      char *af[] = {"f", "write", "src/a.txt", "--from", f_new, 0};
      if (cx_fmt(lp, sizeof lp, "%s/locks.tsv", inst)) return 2;
      bak = cx_read(lp, &bn);
      int ok = (bak != 0 && bn > 0);
      ok = ok && !sy_write_file(lp, "freeze\tinteg\n", 13, 0600) && run_dv(repo, "worker1", af, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=locks-corrupt");
      ok = ok && !sy_write_file(lp, "freeze\tinteg\tabc\t0\n", 19, 0600) && run_dv(repo, "worker1", af, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=locks-corrupt");
      ok = ok && !sy_write_file(lp, "", 0, 0600) && run_dv(repo, "worker1", af, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=integ");
      ok = ok && !sy_write_file(lp, "freeze\tinteg\t9999999999", 23, 0600) && run_dv(repo, "worker1", af, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=locks-corrupt");
      ok = ok && !sy_write_file(lp, "freeze\tworker1\t9999999999\n", 26, 0600) && run_dv(repo, "worker1", af, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=locks-mismatch");
      if (bak) { (void)sy_write_file(lp, bak, bn, 0600); free(bak); }
      ck("locks-tsv-corruptions-and-mismatch-fail-closed", ok); }

    if (owner_only) goto missing_owner;
scope:
    /* (12) The same freeze lock follows main across worktrees. */
    { char *af[] = {"f", "write", "src/a.txt", "--from", f_new, 0};
      char *ac[] = {"git", "commit", "--cwd", wt, "-m", "linked worktree commit", "--whole", "src/a.txt", 0};
      char *as[] = {"git", "commit", "--cwd", repo, "-m", "primary non-main commit", "--whole", "src/a.txt", 0};
      int ok1 = run_dv(wt, "worker1", af, &rc) && rc == 0 && has(out, "FREEZE_SCOPE skip=worktree branch=wt-branch");
      ck("linked-worktree-write-skips-freeze-lock", ok1);
      if (!ok1) (void)wr(wt, "src/a.txt", "updated\n");
      ck("linked-worktree-commit-skips-freeze-lock",
         run_dv(repo, "worker1", ac, &rc) && rc == 0 && has(out, "FREEZE_SCOPE skip=worktree branch=wt-branch"));
      printf("SCOPE_PROBE linked rc=%d\n%s", rc, out);
      int side_ready = sh_in(repo, "git switch -qc freeze-scope-side") && !wr(repo, "src/a.txt", "side edit\n");
      ck("primary-non-main-commit-skips-freeze-lock",
         side_ready && run_dv(repo, "worker1", as, &rc) && rc == 0 && has(out, "FREEZE_SCOPE skip=worktree branch=freeze-scope-side"));
      printf("SCOPE_PROBE non-main rc=%d\n%s", rc, out);
      char *am[] = {"git", "merge", "freeze-scope-side", "--cwd", wt, "--no-ff", 0};
      int linked_main = side_ready &&
          !cx_fmt(cmd, sizeof cmd, "git -C '%s' symbolic-ref HEAD refs/heads/main", wt) && sh_in(repo, cmd);
      ck("linked-main-write-refuses-non-owner",
         linked_main && run_dv(wt, "worker1", af, &rc) && rc == 1 &&
         has(out, "LOCK_HELD freeze owner=integ") && !has(out, "FREEZE_SCOPE skip="));
      /* The clean path isolates the lock decision from commit-own validation. */
      ck("worktree-shared-lock-refuses-non-owner",
         linked_main && run_dv(repo, "worker1", ac, &rc) && rc == 1 &&
         has(out, "LOCK_HELD freeze owner=integ") && !has(out, "FREEZE_SCOPE skip="));
      ck("linked-main-merge-refuses-non-owner",
         linked_main && run_dv(repo, "worker1", am, &rc) && rc == 1 &&
         has(out, "LOCK_HELD freeze owner=integ") && has(out, "GIT_MERGE\trc=1\treason=lock-held\tlock=freeze"));
      char *apull[] = {"git", "pull", "--cwd", wt, 0};
      char *apush[] = {"git", "push", "--cwd", wt, 0};
      ck("linked-main-pull-refuses-non-owner",
         linked_main && run_dv(repo, "worker1", apull, &rc) && rc == 1 &&
         has(out, "GIT_PULL\trc=1\treason=lock-held\tlock=freeze"));
      ck("linked-main-push-refuses-non-owner",
         linked_main && run_dv(repo, "worker1", apush, &rc) && rc == 1 &&
         has(out, "GIT_PUSH_REFUSE\treason=lock-held\tlock=freeze"));
      char *amc[] = {"git", "merge", "--continue", 0};
      int recorded = linked_main && !cx_fmt(cmd, sizeof cmd,
          "printf '%%s\\tmain\\t%%s\\n' '%s' \"$(git rev-parse main)\" > .git/DEVSVC_MERGE_TARGET", wt) &&
          sh_in(repo, cmd);
      ck("linked-main-merge-continue-refuses-non-owner",
         recorded && run_dv(repo, "worker1", amc, &rc) && rc == 1 &&
         has(out, "LOCK_HELD freeze owner=integ") && has(out, "GIT_MERGE\trc=1\treason=lock-held\tlock=freeze"));
      if (recorded) (void)sh_in(repo, "rm .git/DEVSVC_MERGE_TARGET");
      int linked_restored = !linked_main ||
          (!cx_fmt(cmd, sizeof cmd, "git -C '%s' symbolic-ref HEAD refs/heads/wt-branch", wt) && sh_in(repo, cmd));
      ck("freeze-scope-fixture-returns-to-main", linked_restored && (!side_ready ||
         sh_in(repo, "git restore --worktree src/a.txt && git switch -q main"))); }

    /* (12b) Armed build/freeze.tsv (0.1.8-FREEZE owner=cc): guards main + frozen version branch v0.1.8 (and any
       renamed branch descended from base_commit) only; pre-freeze ujs, w/*, and v0.1.9 pass; v0.1.8 passes for
       DEVSVC_OWNER=cc; unparsable/ambiguous sid fails closed; missing lock with active table & owner mismatch refuse. */
    { char wt_ujs[4400], wt_v18[4400], wt_ren[4400], wt_v19[4400], wt_win[4400], fz_row[768], head_oid[64];
      int setup_ok = !cx_fmt(wt_ujs, sizeof wt_ujs, "%s/wt-ujs", tmp) &&
                     !cx_fmt(wt_v18, sizeof wt_v18, "%s/wt-v018", tmp) &&
                     !cx_fmt(wt_ren, sizeof wt_ren, "%s/wt-ren", tmp) &&
                     !cx_fmt(wt_v19, sizeof wt_v19, "%s/wt-v019", tmp) &&
                     !cx_fmt(wt_win, sizeof wt_win, "%s/wt-win", tmp) &&
                     !cx_fmt(cmd, sizeof cmd,
                             "git worktree add -q -b ujs '%s' && ln -s '%s/unisacc.com' '%s/unisacc.com' && "
                             "git worktree add -q -b v0.1.9 '%s' && ln -s '%s/unisacc.com' '%s/unisacc.com' && "
                             "git worktree add -q -b w/agyneon3 '%s' && ln -s '%s/unisacc.com' '%s/unisacc.com'",
                             wt_ujs, root, wt_ujs, wt_v19, root, wt_v19, wt_win, root, wt_win) &&
                     sh_in(repo, cmd) &&
                     sh_in(repo, "printf 'c0a\\n' > docs/c0a.txt && git add docs/c0a.txt && git -c user.name=fx -c user.email=fx@localhost -c commit.gpgsign=false commit -qm c0a && git rev-parse HEAD");
      head_oid[0] = 0;
      if (setup_ok) {
          long hl = (long)strlen(out);
          while (hl > 0 && (out[hl - 1] == '\n' || out[hl - 1] == '\r')) hl--;
          if (hl == 40) { mm_copy(head_oid, sizeof head_oid, out, 40); head_oid[40] = 0; }
          else setup_ok = 0;
      }
      char *arel[] = {"lock", "release", "freeze", "--owner", "integ", 0};
      char *aacq[] = {"lock", "acquire", "freeze", "--owner", "cc", "--ttl", "7200", 0};
      setup_ok = setup_ok &&
          run_dv(repo, "integ", arel, &rc) && rc == 0 &&
          run_dv(repo, "cc", aacq, &rc) && rc == 0 &&
          !cx_fmt(fz_row, sizeof fz_row,
                  "# candidate_sid\tbase_commit\towner\tdeadline_epoch_s\tpaths\n"
                  "0.1.8-FREEZE\t%s\tcc\t9999999999\tsrc/\n", head_oid) &&
          !wr(repo, "build/freeze.tsv", fz_row) &&
          !cx_fmt(cmd, sizeof cmd,
                  "git worktree add -q -b v0.1.8 '%s' && ln -s '%s/unisacc.com' '%s/unisacc.com' && "
                  "git worktree add -q -b sneaky-rename '%s' && ln -s '%s/unisacc.com' '%s/unisacc.com'",
                  wt_v18, root, wt_v18, wt_ren, root, wt_ren) &&
          sh_in(repo, cmd);
      char *ac_ujs[] = {"git", "commit", "--cwd", wt_ujs, "-m", "ujs paper commit", "--whole", "src/a.txt", 0};
      char *ac_main[] = {"git", "commit", "-m", "main non-owner commit", "--whole", "src/a.txt", 0};
      char *ac_v18[] = {"git", "commit", "--cwd", wt_v18, "-m", "v0.1.8 frozen branch commit", "--whole", "src/a.txt", 0};
      char *ac_ren[] = {"git", "commit", "--cwd", wt_ren, "-m", "renamed frozen branch commit", "--whole", "src/a.txt", 0};
      char *ac_v19[] = {"git", "commit", "--cwd", wt_v19, "-m", "v0.1.9 later branch commit", "--whole", "src/a.txt", 0};
      char *ac_win[] = {"git", "commit", "--cwd", wt_win, "-m", "window branch commit", "--whole", "src/a.txt", 0};
      ck("armed-freeze-ujs-worktree-commit-accepted",
         setup_ok && !wr(wt_ujs, "src/a.txt", "ujs edit\n") &&
         run_dv(repo, "ccapi", ac_ujs, &rc) && rc == 0 && has(out, "FREEZE_SCOPE skip=worktree branch=ujs"));
      ck("armed-freeze-main-commit-refused",
         setup_ok && !wr(repo, "src/a.txt", "main edit\n") &&
         run_dv(repo, "worker1", ac_main, &rc) && rc == 1 &&
         has(out, "LOCK_HELD freeze owner=cc") && !has(out, "FREEZE_SCOPE skip="));
      ck("armed-freeze-version-branch-non-owner-refused",
         setup_ok && !wr(wt_v18, "src/a.txt", "v18 edit\n") &&
         run_dv(repo, "worker1", ac_v18, &rc) && rc == 1 &&
         has(out, "LOCK_HELD freeze owner=cc") && !has(out, "FREEZE_SCOPE skip="));
      ck("armed-freeze-renamed-branch-base-commit-refused",
         setup_ok && !wr(wt_ren, "src/a.txt", "ren edit\n") &&
         run_dv(repo, "worker1", ac_ren, &rc) && rc == 1 &&
         has(out, "LOCK_HELD freeze owner=cc") && !has(out, "FREEZE_SCOPE skip="));
      ck("armed-freeze-version-branch-cc-owner-accepted",
         setup_ok && !wr(wt_v18, "src/a.txt", "v18 cc edit\n") &&
         run_dv(repo, "cc", ac_v18, &rc) && rc == 0 && !has(out, "LOCK_HELD freeze"));
      ck("armed-freeze-later-version-branch-accepted",
         setup_ok && !wr(wt_v19, "src/a.txt", "v19 edit\n") &&
         run_dv(repo, "worker1", ac_v19, &rc) && rc == 0 && has(out, "FREEZE_SCOPE skip=worktree branch=v0.1.9"));
      ck("armed-freeze-window-branch-accepted",
         setup_ok && !wr(wt_win, "src/a.txt", "win edit\n") &&
         run_dv(repo, "worker1", ac_win, &rc) && rc == 0 && has(out, "FREEZE_SCOPE skip=worktree branch=w/agyneon3"));
      /* Post-freeze main descendant branch (branched from C0b after C0a base_commit) and its 2nd commit pass;
         renamed branch at advanced release tip and missing refs/heads/<branch> fail closed. */
      { char wt_post[4400], wt_rtip[4400];
        int p_ok = setup_ok &&
                   !cx_fmt(wt_post, sizeof wt_post, "%s/wt-post", tmp) &&
                   !cx_fmt(wt_rtip, sizeof wt_rtip, "%s/wt-rtip", tmp) &&
                   sh_in(repo, "printf 'c0b\\n' > docs/c0b.txt && git add docs/c0b.txt && git -c user.name=fx -c user.email=fx@localhost -c commit.gpgsign=false commit -qm c0b") &&
                   !cx_fmt(cmd, sizeof cmd,
                           "git worktree add -q -b w/v019-post '%s' main && ln -s '%s/unisacc.com' '%s/unisacc.com' && "
                           "git worktree add -q -b sneaky-tip '%s' refs/heads/v0.1.8 && ln -s '%s/unisacc.com' '%s/unisacc.com'",
                           wt_post, root, wt_post, wt_rtip, root, wt_rtip) &&
                   sh_in(repo, cmd);
        char *ac_post1[] = {"git", "commit", "--cwd", wt_post, "-m", "post-freeze descendant commit 1", "--whole", "src/a.txt", 0};
        char *ac_post2[] = {"git", "commit", "--cwd", wt_post, "-m", "post-freeze descendant commit 2", "--whole", "src/a.txt", 0};
        char *ac_rtip[] = {"git", "commit", "--cwd", wt_rtip, "-m", "renamed branch at advanced release tip", "--whole", "src/a.txt", 0};
        char *ac_post_miss[] = {"git", "commit", "--cwd", wt_post, "-m", "post-freeze with release ref missing", "--whole", "src/a.txt", 0};
        ck("armed-freeze-post-freeze-main-descendant-branch-accepted",
           p_ok && !wr(wt_post, "src/a.txt", "post c0b edit 1\n") &&
           run_dv(repo, "worker1", ac_post1, &rc) && rc == 0 && has(out, "FREEZE_SCOPE skip=worktree branch=w/v019-post"));
        ck("armed-freeze-renamed-branch-at-advanced-release-tip-refused",
           p_ok && !wr(wt_rtip, "src/a.txt", "rtip edit\n") &&
           run_dv(repo, "worker1", ac_rtip, &rc) && rc == 1 &&
           has(out, "LOCK_HELD freeze owner=cc") && !has(out, "FREEZE_SCOPE skip="));
        int del_ok = p_ok && !cx_fmt(cmd, sizeof cmd,
            "git -C '%s' checkout -q --detach && git -C '%s' update-ref -d refs/heads/v0.1.8",
            wt_v18, repo) && sh_in(repo, cmd);
        int miss_refused = del_ok && !wr(wt_post, "src/a.txt", "post missing ref edit\n") &&
            run_dv(repo, "worker1", ac_post_miss, &rc) && rc == 1 &&
            has(out, "LOCK_HELD freeze owner=cc") && !has(out, "FREEZE_SCOPE skip=");
        int rest_ok = del_ok && !cx_fmt(cmd, sizeof cmd,
            "git -C '%s' update-ref refs/heads/v0.1.8 \"$(git -C '%s' rev-parse HEAD)\" && "
            "git -C '%s' symbolic-ref HEAD refs/heads/v0.1.8 && "
            "git -C '%s' restore --worktree src/a.txt",
            repo, wt_v18, wt_v18, wt_post) && sh_in(repo, cmd);
        ck("armed-freeze-release-ref-missing-fail-closed", miss_refused && rest_ok);
        ck("armed-freeze-descendant-branch-second-commit-accepted",
           rest_ok && !wr(wt_post, "src/a.txt", "post c0b edit 2\n") &&
           run_dv(repo, "worker1", ac_post2, &rc) && rc == 0 && has(out, "FREEZE_SCOPE skip=worktree branch=w/v019-post")); }
      /* Unparsable sid fails closed (guards ujs too) */
      { char bad_row[512];
        int ok = setup_ok && !cx_fmt(bad_row, sizeof bad_row,
            "# candidate_sid\tbase_commit\towner\tdeadline_epoch_s\tpaths\n"
            "BAD-SID\t%s\tcc\t9999999999\tsrc/\n", head_oid) &&
            !wr(repo, "build/freeze.tsv", bad_row) && !wr(wt_ujs, "src/a.txt", "ujs bad sid\n") &&
            run_dv(repo, "ccapi", ac_ujs, &rc) && rc == 1 && !has(out, "FREEZE_SCOPE skip=");
        ck("armed-freeze-unparsable-sid-fail-closed", ok); }
      /* Ambiguous two armed rows fail closed (guards ujs too) */
      { char dup_row[768];
        int ok = setup_ok && !cx_fmt(dup_row, sizeof dup_row,
            "# candidate_sid\tbase_commit\towner\tdeadline_epoch_s\tpaths\n"
            "0.1.8-FREEZE\t%s\tcc\t9999999999\tsrc/\n"
            "0.1.9-FREEZE\t%s\tcc\t9999999999\tsrc/\n", head_oid, head_oid) &&
            !wr(repo, "build/freeze.tsv", dup_row) && !wr(wt_ujs, "src/a.txt", "ujs dup row\n") &&
            run_dv(repo, "ccapi", ac_ujs, &rc) && rc == 1 && !has(out, "FREEZE_SCOPE skip=");
        ck("armed-freeze-ambiguous-two-rows-fail-closed", ok); }
      /* Active freeze.tsv (owner=cc) with healthy service but missing lock refuses non-owner */
      { char *arel_cc[] = {"lock", "release", "freeze", "--owner", "cc", 0};
        int ok = setup_ok && !wr(repo, "build/freeze.tsv", fz_row) &&
            run_dv(repo, "cc", arel_cc, &rc) && rc == 0 &&
            !wr(repo, "src/a.txt", "missing lock edit\n") &&
            run_dv(repo, "worker1", ac_main, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=cc");
        ck("armed-freeze-missing-lock-refuses-non-owner", ok); }
      /* Lock holder != armed freeze.tsv row owner refuses lock holder too */
      { char *aacq_in[] = {"lock", "acquire", "freeze", "--owner", "integ", "--ttl", "7200", 0};
        int ok = setup_ok && run_dv(repo, "integ", aacq_in, &rc) && rc == 0 &&
            !wr(repo, "src/a.txt", "mismatch owner edit\n") &&
            run_dv(repo, "integ", ac_main, &rc) && rc == 1 && has(out, "LOCK_HELD freeze");
        ck("armed-freeze-lock-holder-row-owner-mismatch-refused", ok); }
      (void)wr(repo, "build/freeze.tsv", "# empty\n");
      (void)sh_in(repo, "git restore --worktree src/a.txt"); }

    if (scope_only) goto done;
lifecycle:
    /* (13) non-owner cannot release freeze; holder release recovers worktree & main */
    { char *ab[] = {"lock", "release", "freeze", "--owner", "worker1", 0};
      char *ar[] = {"lock", "release", "freeze", "--owner", "INTEG", 0};
      char *aw[] = {"f", "write", "src/a.txt", "--from", f_new, 0};
      int ok0 = run_dv(repo, "worker1", ab, &rc) && rc == 1 && has(out, "ERR\tnot-owner\tfreeze\towner=integ");
      int ok1 = ok0 && run_dv(repo, "integ", ar, &rc) && rc == 0 && has(out, "OK\treleased\tfreeze");
      int ok2 = ok1 && run_dv(wt, "worker1", aw, &rc) && rc == 0;
      ck("release-owner-only-and-recovers-worktree", ok2); }

    /* (14) ttl expiry automatically recovers */
    { char *aq[] = {"lock", "acquire", "freeze", "--owner", "integ", "--ttl", "1", 0};
      char *aw[] = {"f", "write", "src/a.txt", "--from", f_old, 0};
      int ok1 = run_dv(repo, "integ", aq, &rc) && rc == 0;
      int ok2 = ok1 && run_dv(repo, "worker1", aw, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=integ");
      sy_sleep_ms(2100);
      int ok3 = ok2 && run_dv(repo, "worker1", aw, &rc) && rc == 0;
      ck("ttl-expiry-recovers", ok3); }

    if (lifecycle_only) goto default_ttl;
missing_owner:
    /* (15) CONFIRMED (11): real commit-own without DEVSVC_OWNER or --owner does not forge X-Unisacc-Window trailer */
    { char *aw[] = {"f", "write", "docs/note.txt", "--from", f_rep, 0};
      char *ac[] = {"git", "commit", "-m", "no owner real commit", "--whole", "docs/note.txt", 0};
      int ok1 = run_dv(repo, 0, aw, &rc) && rc == 0;
      int ok2 = ok1 && run_dv(repo, 0, ac, &rc) && rc == 0;
      int ok3 = ok2 && sh_in(repo, "git log -1 --format='%(trailers)'") && !has(out, "X-Unisacc-Window:");
      ck("missing-owner-no-forged-trailer", ok3); }

    if (owner_only) goto trailer;
default_ttl:
    /* (16) PLAUSIBLE: freeze default ttl is 7200 when --ttl omitted */
    { char *aq[] = {"lock", "acquire", "freeze", "--owner", "integ", 0};
      ck("freeze-default-ttl-7200", run_dv(repo, "integ", aq, &rc) && rc == 0 && has(out, "expires_in_s=7200")); }

    /* (17) PLAUSIBLE + M3 killer: fail-closed when daemon stopped, and chmod 000 locks.tsv refuses BOTH non-owner AND integrator */
    { char *st[] = {"stop", 0};
      char *af[] = {"f", "write", "src/a.txt", "--from", f_new, 0};
      char lcmd[4600], flw[4600];
      if (wr(tmp, "flow-stdout.tsv", "n1\texec\t-\ta0=echo;a1=hi;stdout_to=src/flow-out.txt\n") ||
          cx_fmt(flw, sizeof flw, "%s/flow-stdout.tsv", tmp)) return 2;
      char *afl[] = {"flow", "run", flw, "--par", "1", 0};
      int ok1 = run_dv(repo, "integ", st, &rc) && rc == 0;
      int ok2 = ok1 && run_dv(repo, "worker1", af, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=integ");
      int ok3 = ok2 && run_dv(repo, "worker1", afl, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=integ");
      int ok4 = ok3 && !cx_fmt(lcmd, sizeof lcmd, "chmod 000 '%s/locks.tsv'", inst) && sh_in(repo, lcmd);
      int ok5 = ok4 && run_dv(repo, "worker1", af, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=locks-unreadable");
      int ok6 = ok5 && run_dv(repo, "integ", af, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=locks-unreadable");
      (void)cx_fmt(lcmd, sizeof lcmd, "chmod 600 '%s/locks.tsv'", inst);
      (void)sh_in(repo, lcmd);
      ck("freeze-fail-closed-stopped-and-unreadable", ok6); }

    if (lifecycle_only) goto stopped;
trailer:
    /* (18) PLAUSIBLE: trailer叠加 real commit-own (tr_strip + tr_window_put) produces exactly one X-Unisacc-Window line per commit */
    { int ok = sh_in(repo, "git log -n 6 --format='%(trailers)' | grep -c '^X-Unisacc-Window: integ$'") &&
               (out[0] == '3' && (out[1] == '\n' || out[1] == 0));
      ck("trailer-single-line-with-commit-own", ok); }

    if (owner_only) goto done;
stopped:
    /* (19) CONFIRMED (C): bounded poll (5000ms / 50ms) verifying stopped daemon leaves no socket and no live process
     *      (handles zombie state when run-batch enables PR_SET_CHILD_SUBREAPER). */
    { char pidf[4400], sockp[4400];
      int ok = !cx_fmt(pidf, sizeof pidf, "%s/serve.pid", tmp) &&
               !cx_fmt(sockp, sizeof sockp, "%s/sock", inst) &&
               wait_daemon_gone(pidf, sockp, 5000);
      ck("cleanup-no-residual-daemon", ok); }

    /* (20) Slow-exiting fake daemon fixture: short bound (50ms) must fail, 5000ms bounded poll must succeed */
    { char spid[4400], ssock[4400], pbuf[32];
      int ok = 0;
      if (!cx_fmt(spid, sizeof spid, "%s/slow.pid", tmp) &&
          !cx_fmt(ssock, sizeof ssock, "%s/slow.sock", tmp)) {
          (void)sy_write_file(ssock, "1", 1, 0600);
          int fpid = fork();
          if (fpid == 0) {
              sy_sleep_ms(350);
              (void)sy_unlink(ssock);
              sy_exit(0);
          }
          if (fpid > 0 && !cx_fmt(pbuf, sizeof pbuf, "%d\n", fpid) &&
              !sy_write_file(spid, pbuf, (long)strlen(pbuf), 0600)) {
              int short_rc = wait_daemon_gone(spid, ssock, 50);
              int long_rc = wait_daemon_gone(spid, ssock, 5000);
              sy_wait_status(fpid, 0, 0, 0, 0);
              ok = (short_rc == 0 && long_rc == 1);
          }
      }
      ck("wait-daemon-gone-slow-exit", ok); }

    /* (21) Expired-only build/freeze.tsv + stopped daemon + no locks.tsv: an expired row is NOT a thaw
       (contract changed with the pre-push gate tools/prepush.cx): fail closed for everyone, the row's
       owner included, with the renew/delete hint. Header-only and whitespace-only rows stay a thaw.
       Run git add in linked worktree wt pointing at main (primary checkout refuses shared-index git add). */
    { char lkp[4400];
      char *aa[] = {"git", "add", "src/a.txt", 0};
      int wt_main = !cx_fmt(cmd, sizeof cmd, "git -C '%s' symbolic-ref HEAD refs/heads/main", wt) && sh_in(repo, cmd);
      int ok = wt_main && !cx_fmt(lkp, sizeof lkp, "%s/locks.tsv", inst);
      if (ok) (void)sy_unlink(lkp);
      ok = ok && !wr(repo, "build/freeze.tsv",
                     "# candidate_sid\tbase_commit\towner\tdeadline_epoch_s\tpaths\n"
                     "L0-CORE-FREEZE-049\t7bf9cd5aad\tcc\t1000000000\tcx/sys cx/core\n");
      g_no_autostart = 1; g_use_self_bin = 0;
      ok = ok && run_dv(wt, "worker1", aa, &rc) && rc == 1 &&
           has(out, "LOCK_HELD freeze owner=freeze-expired") && has(out, "FREEZE_EXPIRED") && has(out, "Renew deadline_epoch_s");
      ck("expired-freeze-tsv-refused", ok);
      ok = wt_main && run_dv(wt, "CC", aa, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=freeze-expired");
      ck("expired-freeze-tsv-refuses-owner-too", ok);
      ok = wt_main && !wr(repo, "build/freeze.tsv", "# candidate_sid\tbase_commit\towner\tdeadline_epoch_s\tpaths\n\n   \n\t \n") &&
           run_dv(wt, "worker1", aa, &rc) && rc == 0 && !has(out, "LOCK_HELD freeze");
      g_no_autostart = 0;
      ck("header-and-whitespace-rows-freeze-tsv-allowed", ok); }

    /* (22) Active build/freeze.tsv + stopped daemon + autostart disabled: fail-closed with recovery command */
    { char *aa[] = {"git", "add", "src/a.txt", 0};
      int ok = !wr(repo, "build/freeze.tsv",
                   "# candidate_sid\tbase_commit\towner\tdeadline_epoch_s\tpaths\n"
                   "0.1.8-FREEZE\t7bf9cd5aad\tcc\t9999999999\tsrc/\n");
      g_no_autostart = 1; g_use_self_bin = 0;
      ok = ok && run_dv(wt, "worker1", aa, &rc) && rc == 1 &&
           has(out, "LOCK_HELD freeze owner=freeze-svc-unreachable") &&
           has(out, "tools/devsvc.cx -- start");
      g_no_autostart = 0;
      ck("active-freeze-tsv-autostart-fail-closed", ok); }

    /* (23) Active build/freeze.tsv (owner=cc) + stopped daemon + autostart allowed (DEVSVC_SELF_BIN):
       autostart recovers the service, still refuses non-owner by armed row owner, and allows row owner cc. */
    { char *aa[] = {"git", "add", "src/a.txt", 0};
      char *st[] = {"stop", 0};
      char pidf[4400], sockp[4400];
      g_no_autostart = 0; g_use_self_bin = 1;
      int ok = run_dv(wt, "worker1", aa, &rc) && rc == 1 && has(out, "LOCK_HELD freeze owner=cc") &&
               run_dv(wt, "cc", aa, &rc) && rc == 0 && !has(out, "LOCK_HELD freeze");
      g_use_self_bin = 0;
      (void)run_dv(repo, "integ", st, &rc);
      if (!cx_fmt(pidf, sizeof pidf, "%s/serve.pid", tmp) && !cx_fmt(sockp, sizeof sockp, "%s/sock", inst))
          (void)wait_daemon_gone(pidf, sockp, 5000);
      if (!cx_fmt(cmd, sizeof cmd, "git -C '%s' symbolic-ref HEAD refs/heads/wt-branch", wt)) (void)sh_in(repo, cmd);
      ck("active-freeze-tsv-autostart-recovers", ok); }

done:
    { char *st[] = {"stop", 0}; (void)run_dv(repo, "integ", st, &rc); }
    { char kcmd[4600], pidf[4400], sockp[4400];
      if (!cx_fmt(kcmd, sizeof kcmd, "P=$(cat '%s/serve.pid' 2>/dev/null || true); [ -n \"$P\" ] && kill -9 \"$P\" 2>/dev/null || true", tmp))
          (void)sh_in(root, kcmd);
      if (!cx_fmt(pidf, sizeof pidf, "%s/serve.pid", tmp) && !cx_fmt(sockp, sizeof sockp, "%s/sock", inst))
          (void)wait_daemon_gone(pidf, sockp, 5000); }
    { char *rm[] = {"rm", "-rf", tmp, inst, 0}; (void)runv(rm, 0, 0, 30, &rc); }
    if (sy_exists(tmp) != 0) (void)sy_remove_all(tmp);
    if (sy_exists(inst) != 0) (void)sy_remove_all(inst);
    ck("cleanup-tmp-and-pin-removed", sy_exists(tmp) == 0 && sy_exists(inst) == 0);
    int expected = lifecycle_only ? 22 : owner_only ? 10 : scope_only ? 28 : 0;
    if (expected && passed + failed != expected) {
        fprintf(stderr, "DEVSVC_FREEZE_COUNT expected=%d actual=%d\n", expected, passed + failed);
        failed++;
    }
    const char *rid = sy_env("DEVSVC_FREEZE_RUN_ID");
    if (rid && rid[0]) printf("CHECK_DEVSVC_FREEZE\trun_id=%s\tpass=%d\tfail=%d\n", rid, passed, failed);
    else printf("CHECK_DEVSVC_FREEZE\tpass=%d\tfail=%d\n", passed, failed);
    return failed ? 1 : 0;
}
