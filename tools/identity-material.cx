/* Identity-only CX code material; prepare ROOT NEW_MAT SAVED_BOOTSTRAP or
 * --verify ROOT MAT. Caller bound55. This tool does not compile or execute the
 * derived reader, install anything, construct NN, or emit a test verdict.
 * Fixed seed/ident.c identity prefix and seed/sha256.h retain the exact source
 * set, per-tree part ordering, path-NUL/raw32 aggregation and old traversal/
 * read/close error semantics. Only per-file digest buffering/provider changes:
 * below64KiB original Sha; at/above64KiB Linux AF_ALG, never fallback.
 * New runtime domain: each selected file <=256MiB, bounded doubling buffer;
 * oversize explicitly refuses. This is not unrestricted old-ident equivalence.
 * Material input files <=256MiB, header inventory <=8192 nodes/depth48,
 * safe ASCII paths, normal files/directories only. Runtime identity traversal
 * retains original file-symlink following; inventory restrictions apply only
 * to code-material support/current includes, not a new identity selection rule.
 * Saved P53 bootstrap and current full carried headers have distinct roles.
 * PREPARED/VERIFIED means unsigned material consistency, not native compilation
 * history, actual matching ELF, benchmark, NN or candidate qualification.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.kernelsha
#pragma unisa use text.text
typedef struct {char *name;size_t n;unsigned mode;int directory;char sha[65];} ImEntry;
typedef struct {np_buf base,sha,kernel,source,bootstrap,record,inputs,receipt;char builder[4400],builder_source[65],producer[65],bootstrap_sha[65],record_sha[65];} ImMaterial;
static char root[4096],mat[4400],self[4096];static ImEntry entries[8192];static int count,hash_ready;
static const char *base_sha="fec241b7392f31511f02c3f90d0a481082570801f3e0288c9887bb289a2fc325";
static const char *sha_source_pin="0471814f903a38d781fee3b2ee0e60e530a33f161fedd9e3a248db0e1326663e";
static const char *kernelsha_pin="8ad60f9004f98b6bd68397668e1c6feabe468bb5be4b5ec9aedc4494aa541e31";
static const char *p53="53e2cd1f669c92fda2c16dd93a9021cd4db97f05c57ab2d1acf9a835cbac9857";
static void die(const char *s){fprintf(stderr,"identity-material: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void path(char p[4400],const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path-bound");}
static void hash(const void *s,size_t n,char h[65]){if(n<65536){cx_sha256_hex(s,n,h);return;}if(!hash_ready){char t[65];int rc=ks_sha256_hex("",0,t);if(rc||!tx_eqz(t, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"))die("kernel-sha-empty-selfcheck");rc=ks_sha256_hex("abc",3,t);if(rc||!tx_eqz(t, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"))die("kernel-sha-abc-selfcheck");hash_ready=1;}int rc=ks_sha256_hex(s,n,h);if(rc){char why[100];snprintf(why,sizeof why,"kernel-sha-rc=%d",rc);die(why);}}
static char *load(const char *p,size_t *n,unsigned *mode){struct stat a,b;if(lstat(p,&a))die(errno==ENOENT?"input-ENOENT":"input-stat-error");if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>268435456)die("bounded-regular-input");int fd=open(p,O_RDONLY|O_NOFOLLOW|O_CLOEXEC|O_NONBLOCK);if(fd<0)die("input-open");if(fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size||a.st_mode!=b.st_mode)die("input-descriptor-identity");*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s)die("allocation");size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("input-extent");at+=(size_t)z;}char x;ssize_t z;do{z=read(fd,&x,1);}while(z<0&&errno==EINTR);int changed=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size||a.st_mode!=b.st_mode;int closed=close(fd);if(z||changed||closed)die("input-changed-or-close");s[*n]=0;if(mode)*mode=(unsigned)a.st_mode&07777;return s;}
/* Material namespace cannot traverse a symlink, dot or absent parent. */
static void material_path(int include_leaf){char p[4400];size_t n=strlen(mat);if(n<2||mat[0]!='/'||mat[n-1]=='/')die("material-absolute-canonical-shape");strcpy(p,mat);size_t start=1;for(size_t i=1;i<=n;i++){if(p[i]!='/'&&p[i])continue;size_t z=i-start;if(!z||(z==1&&p[start]=='.')||(z==2&&p[start]=='.'&&p[start+1]=='.'))die("material-dot-or-empty-component");if(i<n||include_leaf){char saved=p[i];p[i]=0;struct stat st;if(lstat(p,&st))die(errno==ENOENT?"material-parent-ENOENT":"material-parent-stat-error");if(!S_ISDIR(st.st_mode))die("material-parent-not-normal-directory");p[i]=saved;}start=i+1;}}
static void digest(const char *p,char h[65]){size_t n;char *s=load(p,&n,0);hash(s,n,h);free(s);}
static np_buf bytes(const char *p){size_t n;char *s=load(p,&n,0);np_buf b={0};np_put(&b,s,n);free(s);return b;}
static void row(np_buf *b,const char *k,const char *v){np_puts(b,k);np_puts(b,"\t");np_puts(b,v);np_puts(b,"\n");}
static int safe(const char *s){if(!*s||*s=='/'||strpbrk(s,"\r\n\t\\"))return 0;const char *p=s;while(*p){const char *q=strchr(p,'/');size_t n=q?(size_t)(q-p):strlen(p);if(!n||(n==1&&p[0]=='.')||(n==2&&p[0]=='.'&&p[1]=='.'))return 0;for(size_t i=0;i<n;i++)if(!((p[i]>='a'&&p[i]<='z')||(p[i]>='A'&&p[i]<='Z')||(p[i]>='0'&&p[i]<='9')||p[i]=='_'||p[i]=='-'||p[i]=='.'))return 0;if(!q)break;p=q+1;}return 1;}
static void add(const char *rel,const struct stat *st,int directory){if(count==8192||!safe(rel))die("header-entry-name-or-capacity");ImEntry *e=&entries[count++];e->name=strdup(rel);if(!e->name)die("allocation");e->directory=directory;e->mode=(unsigned)st->st_mode&07777;e->n=0;e->sha[0]=0;if(!directory){char p[4400];path(p,root,rel);unsigned mode;char *s=load(p,&e->n,&mode);e->mode=mode;hash(s,e->n,e->sha);free(s);}}
static void walk(const char *rel,int depth){if(depth>48)die("header-tree-depth");char p[4400];path(p,root,rel);struct stat st;if(lstat(p,&st))die(errno==ENOENT?"header-ENOENT":"header-stat-error");if(S_ISREG(st.st_mode)){add(rel,&st,0);return;}if(!S_ISDIR(st.st_mode))die("header-symlink-or-special-input");add(rel,&st,1);DIR *d=opendir(p);if(!d)die("header-directory-open");for(;;){errno=0;struct dirent *e=readdir(d);if(!e){int saved=errno,closed=closedir(d);if(saved||closed)die("header-directory-read-or-close");break;}if(tx_eqz(e->d_name, ".")||tx_eqz(e->d_name, ".."))continue;char next[4400];path(next,rel,e->d_name);walk(next,depth+1);}}
static int cmp(const void *a,const void *b){return strcmp(((const ImEntry *)a)->name,((const ImEntry *)b)->name);}
static void file_row(np_buf *b,const char *role,const char *name,const char *file){size_t n;unsigned mode;char *s=load(file,&n,&mode),h[65];hash(s,n,h);free(s);np_puts(b,role);np_puts(b,"\t");np_puts(b,name);np_puts(b,"\t");np_putll(b,mode);np_puts(b,"\t");np_putll(b,(long long)n);np_puts(b,"\t");np_puts(b,h);np_puts(b,"\n");}
static np_buf snapshot(const ImMaterial *m){for(int i=0;i<count;i++)free(entries[i].name);count=0;walk("include",0);qsort(entries,(size_t)count,sizeof *entries,cmp);np_buf b={0};np_puts(&b,"identity-material-applicable-inputs-v1\nscope\tcomplete-current-include-tree-all-modes-plus-fixed-producer-support-and-original-saved-bootstrap\n");for(int i=0;i<count;i++){ImEntry *e=&entries[i];if(i&&tx_eqz(e[-1].name, e->name))die("duplicate-header-entry");np_puts(&b,e->directory?"directory\t":"header-input\t");np_puts(&b,e->name);np_puts(&b,"\t");np_putll(&b,e->mode);if(!e->directory){np_puts(&b,"\t");np_putll(&b,(long long)e->n);np_puts(&b,"\t");np_puts(&b,e->sha);}np_puts(&b,"\n");}const char *support[]={"seed/ident.c","seed/sha256.h","tools/identity-material.cx","tools/cxlib/netpack.cx","tools/cxlib/kernelsha.cx"};for(int i=0;i<5;i++){char p[4400];path(p,root,support[i]);file_row(&b,"producer-input",support[i],p);}file_row(&b,"compiler-input","saved-original-bootstrap-artifact",m->builder);char rp[4400];int n=snprintf(rp,sizeof rp,"%s.build.json",m->builder);if(n<0||n>=sizeof rp)die("bootstrap-record-path");file_row(&b,"compiler-input","saved-original-bootstrap-record",rp);return b;}
static char *unique(char *s,const char *fragment){char *p=strstr(s,fragment);if(!p||strstr(p+1,fragment))die("unique-transform-fragment");return p;}
static char *replace(char *s,const char *old,const char *next){char *p=unique(s,old);size_t a=(size_t)(p-s),n=strlen(s),o=strlen(old),k=strlen(next);char *r=malloc(n-o+k+1);if(!r)die("allocation");memcpy(r,s,a);memcpy(r+a,next,k);memcpy(r+a+k,p+o,n-a-o+1);free(s);return r;}
static np_buf derive(ImMaterial *m){
 char h[65];hash(m->base.p,m->base.n,h);if(!tx_eqz(h, base_sha)||memchr(m->base.p,0,m->base.n)||memchr(m->base.p,'\r',m->base.n))die("fixed-base-ident-source-required");
 hash(m->sha.p,m->sha.n,h);if(!tx_eqz(h, sha_source_pin)||memchr(m->sha.p,0,m->sha.n)||memchr(m->sha.p,'\r',m->sha.n))die("fixed-base-sha-source-required");
 const char *end="/* sha256 of a file (absolute or relative to ROOT) and its size */";
 char *cut=unique(m->base.p,end);size_t n=(size_t)(cut-m->base.p);char *s=malloc(n+1);if(!s)die("allocation");memcpy(s,m->base.p,n);s[n]=0;
 const char *includes[]={"#include <dirent.h>\n","#include <stdint.h>\n","#include <stdio.h>\n","#include <stdlib.h>\n","#include <string.h>\n","#include <sys/stat.h>\n","#include <unistd.h>\n","#include <fcntl.h>\n","#include \"sha256.h\"\n"};
 for(int i=0;i<9;i++)s=replace(s,includes[i],"");if(strstr(s,"#include"))die("unexpected-ident-prefix-include");
 char *sha=strdup(m->sha.p);if(!sha)die("allocation");sha=replace(sha,"#include <stdint.h>\n","");sha=replace(sha,"#include <string.h>\n","");if(strstr(sha,"#include"))die("unexpected-sha-include");
 s=replace(s,"static void file_entry(Sha *h, const char *rel) {\n    /* read(2), not stdio: the product's <stdio.h> refuses ferror() in a unit\n       that never calls fgetc (archive/plans/v0.0.32.md D3) */\n    Sha f; unsigned char buf[1 << 16], dg[32]; long n; int fd = open(rel, O_RDONLY);\n    if (fd < 0) die(\"cannot open\", rel);\n    sha_init(&f);\n    while ((n = read(fd, buf, sizeof buf)) > 0) sha_put(&f, buf, (size_t)n);\n    if (n < 0) die(\"read failed\", rel);\n    close(fd);\n    sha_end(&f, dg);\n    sha_put(h, rel, strlen(rel) + 1);\n    sha_put(h, dg, 32);\n}\n","static void file_entry(Sha *h, const char *rel) {\n    Sha f; unsigned char buf[1 << 16], dg[32], *bytes = NULL;\n    size_t used = 0, allocated = 0; long n; int fd = open(rel, O_RDONLY);\n    if (fd < 0) die(\"cannot open\", rel);\n    while ((n = read(fd, buf, sizeof buf)) > 0) {\n        size_t add = (size_t)n;\n        if (used > 268435456UL - add) { close(fd); free(bytes); die(\"identity file exceeds 256MiB domain\", rel); }\n        size_t need = used + add;\n        if (need > allocated) {\n            size_t next = allocated ? allocated : 65536;\n            while (next < need) next *= 2;\n            unsigned char *grown = realloc(bytes, next);\n            if (!grown) { close(fd); free(bytes); die(\"out of memory\", rel); }\n            bytes = grown; allocated = next;\n        }\n        memcpy(bytes + used, buf, add); used = need;\n    }\n    if (n < 0) { close(fd); free(bytes); die(\"read failed\", rel); }\n    close(fd); /* Preserve original close-error behavior; no retry. */\n    if (used < 65536) {\n        sha_init(&f); sha_put(&f, used ? bytes : (const unsigned char *)\"\", used); sha_end(&f, dg);\n    } else {\n        char hex[65]; int rc = ks_sha256_hex(bytes, used, hex);\n        if (rc) { fprintf(stderr,\"ident: kernel-sha-negative-errno=%d: %s\\n\",rc,rel); free(bytes); exit(1); }\n        for (int i = 0; i < 32; i++) {\n            unsigned char a = (unsigned char)hex[2*i], b = (unsigned char)hex[2*i+1];\n            int hi = a >= '0' && a <= '9' ? a-'0' : a >= 'a' && a <= 'f' ? a-'a'+10 : -1;\n            int lo = b >= '0' && b <= '9' ? b-'0' : b >= 'a' && b <= 'f' ? b-'a'+10 : -1;\n            if (hi < 0 || lo < 0) { free(bytes); die(\"kernel sha hex contract\", rel); }\n            dg[i] = (unsigned char)((hi << 4) | lo);\n        }\n        if (hex[64]) { free(bytes); die(\"kernel sha hex extent\", rel); }\n    }\n    free(bytes);\n    sha_put(h, rel, strlen(rel) + 1);\n    sha_put(h, dg, 32);\n}\n");
 np_buf b={0};np_puts(&b,"/* GENERATED identity-only source; base-ident.c/base-sha256.h retained.\n * Producer SHA256=");np_puts(&b,m->producer);np_puts(&b,"\n * Fixed identity selection/order/outer Sha unchanged. 64KiB AF_ALG threshold.\n * New selected-file bound256MiB; no fallback, native build or verdict recorded.\n */\n#pragma unisa use cxlib.kernelsha\n");
 np_puts(&b,sha);np_puts(&b,"\n");np_puts(&b,s);np_puts(&b,"\nint main(int argc,char **argv){char hex[65];if(argc!=1&&argc!=2)die(\"usage\",\"identity [ROOT]\");const char *root=argc==2?argv[1]:\".\";if(chdir(root))die(\"cannot enter\",root);identity(hex);printf(\"%s\\n\",hex);return 0;}\n");
 free(sha);free(s);return b;
}
static int hex64(const char *s){if(strlen(s)!=64)return 0;for(int i=0;i<64;i++)if(!((s[i]>='a'&&s[i]<='f')||(s[i]>='0'&&s[i]<='9')))return 0;return 1;}
static void json_hash(char *record,const char *key,char h[65]){char tag[120];int n=snprintf(tag,sizeof tag,"\n  \"%s\": \"",key);if(n<0||n>=sizeof tag)die("record-key-bound");char *p=unique(record,tag)+strlen(tag);if(strlen(p)<67||p[64]!='\"'||p[65]!=','||p[66]!='\n')die("bootstrap-hash-field-shape");memcpy(h,p,64);h[64]=0;if(!hex64(h))die("bootstrap-hash-field-hex");}
static void record_ok(ImMaterial *m){hash(m->bootstrap.p,m->bootstrap.n,m->bootstrap_sha);hash(m->record.p,m->record.n,m->record_sha);if(!tx_eqz(m->bootstrap_sha, p53)||m->bootstrap.n!=4911193)die("explicit-saved-P53-bootstrap-required");if(m->record.n<4||m->record.n>16384||memcmp(m->record.p,"{\n",2)||memcmp(m->record.p+m->record.n-3,"\n}\n",3)||memchr(m->record.p,0,m->record.n)||memchr(m->record.p,'\r',m->record.n))die("original-bootstrap-record-wire");char h[65];json_hash(m->record.p,"artifact_sha256",h);if(!tx_eqz(h, m->bootstrap_sha))die("original-record-artifact-mismatch");json_hash(m->record.p,"sources_sha256",m->builder_source);char bytes_field[120];snprintf(bytes_field,sizeof bytes_field,"\n  \"bytes\": %lu,\n",(unsigned long)m->bootstrap.n);unique(m->record.p,bytes_field);unique(m->record.p,"\n  \"schema\": 1,\n");}
static np_buf receipt(ImMaterial *m){np_buf b={0};np_puts(&b,"identity-CX-code-material-v1\nstatus\tPREPARED\nscope\tidentity-prefix-only-preserve-source-selection-and-order-256MiB-file-domain-no-native-or-PASS\n");row(&b,"root",root);row(&b,"saved-bootstrap-path",m->builder);row(&b,"saved-bootstrap-artifact",m->bootstrap_sha);row(&b,"saved-bootstrap-original-record",m->record_sha);row(&b,"saved-bootstrap-recorded-source",m->builder_source);row(&b,"producer",m->producer);row(&b,"base-C",base_sha);row(&b,"base-sha-source",sha_source_pin);row(&b,"carried-module","cxlib/kernelsha.cx");row(&b,"carried-module-sha",kernelsha_pin);row(&b,"material-layout","exact8-regular-leaves-plus-cxlib-directory-no-extras-no-symlinks");row(&b,"transform-contract","fixed-identity-prefix;9-ident-and2-sha-include-strips;1-file_entry-replace;identity-only-main");row(&b,"runtime-domain","selected-file<=268435456;new-bound-refuses;old-walk-file-symlink-and-error-semantics-retained;not-unrestricted-ident-equivalence");row(&b,"sha-provider","identity-material-hybrid-provider-v1-threshold65536-AF_ALG-selfchecked-no-fallback");row(&b,"planned-native-flags","-I CURRENT_ROOT/include -O2 -b lnx/x86_64");char include[4400];path(include,root,"include");row(&b,"planned-native-include",include);row(&b,"planned-native-input","identity.cx");row(&b,"native-build-evidence","NOT_RECORDED;actual-native-artifact-and-compiler-code-profile-require-separate-evidence");row(&b,"trust","saved-bootstrap-original-role-and-current-carried-headers-distinct;HOSTCC-system-dependencies-remain-nonhermetic");row(&b,"observations","fresh-complete-input-endpoints-not-atomic-or-historical-proof");const char *names[]={"base-ident.c","base-sha256.h","identity.cx","bootstrap-input.com","bootstrap-input.com.build.json","inputs.tsv","cxlib/kernelsha.cx"};const np_buf *bufs[]={&m->base,&m->sha,&m->source,&m->bootstrap,&m->record,&m->inputs,&m->kernel};for(int i=0;i<7;i++){char h[65];hash(bufs[i]->p,bufs[i]->n,h);row(&b,names[i],h);}return b;}
static void write_new(const char *p,const np_buf *b,int mode){int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC|O_NOFOLLOW,mode);if(fd<0)die("exclusive-material-output");size_t at=0;while(at<b->n){ssize_t n=write(fd,b->p+at,b->n-at);if(n<0&&errno==EINTR)continue;if(n<=0)die("material-write");at+=(size_t)n;}int bad=fsync(fd),closed=close(fd);if(bad||closed)die("material-sync-or-close");}
static void save(const char *name,const np_buf *b,int mode){char p[4400];path(p,mat,name);write_new(p,b,mode);}
static void equal(const char *name,const np_buf *b){char p[4400];path(p,mat,name);np_buf a=bytes(p);int ok=a.n==b->n&&!memcmp(a.p,b->p,a.n);free(a.p);if(!ok)die("material-bytes-or-receipt-mismatch");}
static void layout_dir(const char *dir,int nested){const char *leaves[]={"base-ident.c","base-sha256.h","identity.cx","bootstrap-input.com","bootstrap-input.com.build.json","inputs.tsv","material.tsv","cxlib"};unsigned seen=0;DIR *d=opendir(dir);if(!d)die("material-layout-open");for(;;){errno=0;struct dirent *e=readdir(d);if(!e){int saved=errno,closed=closedir(d);if(saved||closed)die("material-layout-read-or-close");break;}if(tx_eqz(e->d_name, ".")||tx_eqz(e->d_name, ".."))continue;int index=-1;if(nested){if(tx_eqz(e->d_name, "kernelsha.cx"))index=0;}else for(int i=0;i<8;i++)if(tx_eqz(e->d_name, leaves[i]))index=i;if(index<0||(seen&(1U<<index)))die("material-layout-extra-or-duplicate");seen|=1U<<index;char p[4400];path(p,dir,e->d_name);struct stat st;if(lstat(p,&st))die(errno==ENOENT?"material-layout-ENOENT":"material-layout-stat-error");if(!nested&&index==7){if(!S_ISDIR(st.st_mode))die("material-layout-module-directory");layout_dir(p,1);}else if(!S_ISREG(st.st_mode))die("material-layout-nonregular-leaf");}if(seen!=(nested?1U:255U))die("material-layout-missing-leaf");}
static void material_layout(void){layout_dir(mat,0);}
static void material_equal(ImMaterial *m){equal("base-ident.c",&m->base);equal("base-sha256.h",&m->sha);equal("identity.cx",&m->source);equal("bootstrap-input.com",&m->bootstrap);equal("bootstrap-input.com.build.json",&m->record);equal("inputs.tsv",&m->inputs);equal("material.tsv",&m->receipt);equal("cxlib/kernelsha.cx",&m->kernel);material_layout();}
static void free_material(ImMaterial *m){free(m->base.p);free(m->sha.p);free(m->kernel.p);free(m->source.p);free(m->bootstrap.p);free(m->record.p);free(m->inputs.p);free(m->receipt.p);}
static ImMaterial observe(const char *builder){ImMaterial m={0};if(!realpath(builder,m.builder)||strpbrk(m.builder,"\r\n\t"))die("saved-bootstrap-realpath");char p[4400],h[65];path(p,root,"tools/identity-material.cx");digest(p,m.producer);digest(self,h);if(!tx_eqz(h, m.producer))die("producer-must-be-current-root-tool");path(p,root,"seed/ident.c");m.base=bytes(p);path(p,root,"seed/sha256.h");m.sha=bytes(p);path(p,root,"tools/cxlib/kernelsha.cx");m.kernel=bytes(p);hash(m.kernel.p,m.kernel.n,h);if(!tx_eqz(h, kernelsha_pin))die("kernelsha-fixed-module-required");m.bootstrap=bytes(m.builder);int n=snprintf(p,sizeof p,"%s.build.json",m.builder);if(n<0||n>=sizeof p)die("bootstrap-record-path");m.record=bytes(p);record_ok(&m);m.source=derive(&m);m.inputs=snapshot(&m);m.receipt=receipt(&m);return m;}
static void stable(ImMaterial *before){ImMaterial after=observe(before->builder);const np_buf *a[]={&before->base,&before->sha,&before->kernel,&before->source,&before->bootstrap,&before->record,&before->inputs,&before->receipt};const np_buf *b[]={&after.base,&after.sha,&after.kernel,&after.source,&after.bootstrap,&after.record,&after.inputs,&after.receipt};for(int i=0;i<8;i++)if(a[i]->n!=b[i]->n||memcmp(a[i]->p,b[i]->p,a[i]->n))die("applicable-input-or-derived-material-changed");free_material(&after);}
static void bootstrap_field(char out[4400]){char p[4400];path(p,mat,"material.tsv");np_buf b=bytes(p);if(!b.n||b.p[b.n-1]!='\n'||memchr(b.p,0,b.n)||memchr(b.p,'\r',b.n))die("material-receipt-wire");const char *tag="\nsaved-bootstrap-path\t";char *s=unique(b.p,tag)+strlen(tag),*e=strchr(s,'\n');if(!e||e==s||e-s>=4400||s[0]!='/'||memchr(s,'\t',(size_t)(e-s)))die("saved-bootstrap-field");memcpy(out,s,(size_t)(e-s));out[e-s]=0;free(b.p);}
