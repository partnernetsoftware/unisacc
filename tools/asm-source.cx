/* Native kernel assembly source preparation, not an instruction validator.
 * Uses the product C preprocessor; expands the explicit GAS macro subset.
 * ROOT ARCH INPUT.S OUTPUT.s. Output is exclusive; failures retain no success claim.
 * The native assembler remains responsible for rejecting unsupported instructions. */
#pragma unisa use cxlib.netpack
typedef struct {char *name,*params[16];int np;np_buf body;} Macro;
static Macro macros[64];static int nm,serial,expanded;
static np_buf output;
static void die(const char *s){fprintf(stderr,"asm-source: REFUSE %s\n",s);exit(2);}
static char *copy(const char *s,size_t n){char *p=malloc(n+1);if(!p)die("allocation");memcpy(p,s,n);p[n]=0;return p;}
static int space(int c){return c==' '||c=='\t'||c=='\r';}
static int ident(int c){return (c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='_'||c=='.'||c=='$';}
static char *trim(char *s){while(space(*s))s++;size_t n=strlen(s);while(n&&space(s[n-1]))s[--n]=0;return s;}
static int token(char *s,const char *word){size_t n=strlen(word);return !strncmp(s,word,n)&&(!s[n]||space(s[n]));}
static int args(char *s,char **v,int max){int n=0,depth=0,quote=0;char *start;s=trim(s);if(!*s)return 0;start=s;for(;;s++){int c=*s;if(!c||(!quote&&!depth&&c==',')){if(n==max)die("macro argument capacity");int end=!c;*s=0;v[n++]=trim(start);if(!*v[n-1])die("empty macro argument");if(end)break;start=s+1;}else if(quote){if(c=='\\'&&s[1])s++;else if(c==quote)quote=0;}else if(c=='\"'||c=='\'')quote=c;else if(c=='('||c=='[')depth++;else if(c==')'||c==']'){if(!depth)die("unbalanced macro argument");depth--;}}if(depth||quote)die("unbalanced macro argument");return n;}
static void process(char *line,int depth);
static void invoke(Macro *m,char *rest,int depth){char *actual[16];int count=args(rest,actual,16),id=++serial;if(count!=m->np)die("macro argument count");np_buf body={0};size_t at=0;while(at<m->body.n){char c=m->body.p[at++];if(c!='\\'){np_put(&body,&c,1);continue;}if(at==m->body.n)die("unfinished macro escape");c=m->body.p[at++];if(c=='@'){np_putll(&body,id);continue;}if(c=='('&&at<m->body.n&&m->body.p[at]==')'){at++;continue;}size_t begin=at-1;while(at<m->body.n&&ident(m->body.p[at])&&m->body.p[at]!='.')at++;size_t len=at-begin;int p=-1,j;if(c>='1'&&c<='9'){unsigned long v=0;for(j=0;j<(int)len;j++){char d=m->body.p[begin+j];if(d<'0'||d>'9')die("numeric macro parameter");v=v*10+(unsigned)(d-'0');if(v>16)die("macro parameter range");}p=(int)v-1;}else for(j=0;j<m->np;j++)if(strlen(m->params[j])==len&&!memcmp(m->params[j],m->body.p+begin,len)){p=j;break;}if(p<0||p>=count)die("unknown macro substitution");np_puts(&body,actual[p]);}
 char *p=body.p;while(p&&*p){char *e=strchr(p,'\n');if(!e)die("macro body final newline");*e=0;process(p,depth+1);p=e+1;}free(body.p);expanded++;}
static void normalize(char *s){np_buf b={0};size_t i=0,n=strlen(s);int quote=0;while(i<n){char c=s[i];if(quote){np_put(&b,s+i,1);i++;if(c=='\\'&&i<n){np_put(&b,s+i,1);i++;}else if(c==quote)quote=0;continue;}if(c=='\"'||c=='\''){quote=c;np_put(&b,s+i++,1);continue;}if(ident(c)){size_t start=i;while(i<n&&ident(s[i]))i++;size_t k=i-start,q=i;while(q<n&&space(s[q]))q++;if(q+8<=n&&!memcmp(s+q,"@PAGEOFF",8)&&!ident(s[q+8])){np_puts(&b,":lo12:");np_put(&b,s+start,k);i=q+8;}else {np_put(&b,s+start,k);if(q+5<=n&&!memcmp(s+q,"@PAGE",5)&&!ident(s[q+5]))i=q+5;}}else{if(c=='@')die("unknown Mach-O relocation suffix");if(c=='\\')die("unexpanded macro escape");np_put(&b,s+i++,1);}}np_put(&output,b.p,b.n);np_puts(&output,"\n");free(b.p);}
static void process(char *line,int depth){if(depth>32)die("macro recursion limit");char *s=trim(line);if(!*s)return;if(s[0]=='#'){/* Product -E line markers, never assembler comments/instructions. */if(s[1]==' '||s[1]=='\t'||(s[1]>='0'&&s[1]<='9'))return;die("unprocessed preprocessor directive");}
 if(token(s,".macro")||token(s,".endm")||token(s,".endmacro")||token(s,".rept")||token(s,".irp")||token(s,".irpc")||token(s,".if")||token(s,".endif")||token(s,".altmacro"))die("unsupported nested macro/control directive");
 /* -E inserts spaces around tokens produced by token pasting, including label colons. */
 size_t label=0;while(ident(s[label]))label++;size_t after=label;while(space(s[after]))after++;if(label&&s[after]==':'&&after>label)memmove(s+label,s+after,strlen(s+after)+1);
 int i;size_t k=0;while(s[k]&&!space(s[k]))k++;for(i=0;i<nm;i++)if(strlen(macros[i].name)==k&&!memcmp(s,macros[i].name,k)){invoke(&macros[i],trim(s+k),depth);return;}
 if(token(s,".section")){char *r=trim(s+8);if(!strcmp(r,"__TEXT,__const")||!strcmp(r,"__TEXT,__cstring,cstring_literals")){np_puts(&output,".data\n");return;}if(!strncmp(r,"__TEXT",6))die("unknown Mach-O section");}
 /* Unknown uppercase macro calls are refused; lower-case opcodes are left for as. */
 if(k&&s[0]>='A'&&s[0]<='Z'&&s[k-1]!=':')die("unknown macro invocation");normalize(s);
}
typedef struct {int number,line,ordinal;} Numeric;
static void numeric_labels(void){Numeric labels[4096];int count=0,ln=0;char *s=output.p;while(s&&*s){char *e=strchr(s,'\n'),*p=s;ln++;if(!e)die("output line termination");while(p<e&&space(*p))p++;if(p<e&&*p>='0'&&*p<='9'){int number=0;while(p<e&&*p>='0'&&*p<='9'){if(number>1000000)die("numeric label range");number=number*10+*p++-'0';}if(p<e&&*p==':'){if(count==4096)die("numeric label capacity");labels[count].number=number;labels[count].line=ln;labels[count].ordinal=count;count++;}}s=e+1;}
 if(!count)return;np_buf b={0};size_t i=0;ln=1;int quote=0,line_start=1;while(i<output.n){char c=output.p[i];if(c=='\n'){np_put(&b,&c,1);i++;ln++;line_start=1;continue;}if(quote){np_put(&b,&c,1);i++;if(c=='\\'&&i<output.n){np_put(&b,output.p+i,1);i++;}else if(c==quote)quote=0;continue;}if(c=='\"'||c=='\''){quote=c;np_put(&b,&c,1);i++;continue;}if(c>='0'&&c<='9'&&(i==0||!ident(output.p[i-1]))){size_t start=i;int number=0,j,found=-1;while(i<output.n&&output.p[i]>='0'&&output.p[i]<='9'){if(number>1000000)die("numeric reference range");number=number*10+output.p[i++]-'0';}int def=i<output.n&&output.p[i]==':'&&line_start;int ref=i<output.n&&(output.p[i]=='f'||output.p[i]=='b')&&(i+1==output.n||!ident(output.p[i+1]));if(def||ref){for(j=0;j<count;j++)if(labels[j].number==number){if(def&&labels[j].line==ln){found=j;break;}if(ref&&output.p[i]=='b'&&labels[j].line<=ln)found=j;if(ref&&output.p[i]=='f'&&labels[j].line>ln){found=j;break;}}if(found<0)die("unbound numeric local label");np_puts(&b,".Lunisa_numeric_");np_putll(&b,found);if(ref)i++;}else np_put(&b,output.p+start,i-start);line_start=0;continue;}if(!space(c))line_start=0;np_put(&b,&c,1);i++;}free(output.p);output=b;
}
int main(int argc,char **argv){char root[4096],input[4096],product[4096],bound[4096],bridge[64],why[1024],defines[9][100];char *av[32];int n=0,i;np_result result;static const char *imports[]={"calloc","realloc","free","memcpy","memcmp","memset","strlen","core_host_fetch","core_host_panic"};
 if(argc!=5||(strcmp(argv[2],"arm64")&&strcmp(argv[2],"x86_64")))die("usage ROOT arm64|x86_64 INPUT.S OUTPUT.s");if(!realpath(argv[1],root)||!realpath(argv[3],input))die("input/root resolution");if(snprintf(product,sizeof product,"%s/unisacc.com",root)>=(int)sizeof product||snprintf(bound,sizeof bound,"%s/tools/bound",root)>=(int)sizeof bound)die("path capacity");struct stat st;if(stat(input,&st)||!S_ISREG(st.st_mode))die("INPUT.S regular file required");
 av[n++]=bound;av[n++]="20";av[n++]="sh";av[n++]=product;av[n++]="-E";av[n++]="-D__APPLE__";av[n++]="-D__ASSEMBLER__";snprintf(bridge,sizeof bridge,"bridge_%s.S",argv[2]);char *base=strrchr(input,'/');base=base?base+1:input;if(strcmp(base,bridge))for(i=0;i<9;i++){snprintf(defines[i],sizeof defines[i],"-D%s=bridge_%s",imports[i],imports[i]);av[n++]=defines[i];}av[n++]=input;av[n]=0;
 if(np_run(av,root,0,25,&result,why,sizeof why))die(why);if(result.rc){if(result.errn)fwrite(result.err,1,result.errn,stderr);die("product preprocessing failed");}if(memchr(result.out,0,result.outn))die("NUL in preprocessed text");char *p=result.out;Macro *current=0;while(p&&*p){char *e=strchr(p,'\n');if(!e)die("preprocessor final newline");*e=0;char *s=trim(p);if(token(s,".macro")){if(current||nm==64)die("nested/too many macros");s=trim(s+6);size_t k=0;while(ident(s[k]))k++;if(!k)die("macro name");for(i=0;i<nm;i++)if(strlen(macros[i].name)==k&&!memcmp(macros[i].name,s,k))die("duplicate macro");current=&macros[nm++];current->name=copy(s,k);char *params[16];int j;current->np=args(trim(s+k),params,16);for(j=0;j<current->np;j++){size_t x=0;while(ident(params[j][x]))x++;if(!x||params[j][x])die("unsupported macro parameter/default");current->params[j]=copy(params[j],x);for(i=0;i<j;i++)if(!strcmp(current->params[i],current->params[j]))die("duplicate macro parameter");}}
 else if(token(s,".endm")||token(s,".endmacro")){if(!current)die("endm without macro");char *t=s+(token(s,".endm")?5:9);if(*trim(t))die("endm operands");current=0;}
 else if(current){np_puts(&current->body,s);np_puts(&current->body,"\n");}else process(s,0);p=e+1;}if(current)die("unterminated macro");numeric_labels();
 int fd=open(argv[4],O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);size_t at=0;if(fd<0)die("OUTPUT.s must not exist");while(at<output.n){ssize_t k=write(fd,output.p+at,output.n-at);if(k<0&&errno==EINTR)continue;if(k<=0)die("output write");at+=(size_t)k;}if(fsync(fd)||close(fd))die("output close");fprintf(stderr,"asm-source: PREPARED %s %lu bytes, %d macro calls; instruction encoding unverified\n",argv[2],(unsigned long)output.n,expanded);np_free(&result);return 0;}
