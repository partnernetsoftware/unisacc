/* tools/check-l0-syscall6.cx -- verify sy_syscall6 via sys.sysnums syp_getpid vs sy_pid. */
#pragma unisa use sys.syscall
#pragma unisa use sys.sysnums
#pragma unisa use sys.proc

#if defined(__APPLE__) && defined(__aarch64__)
#define SC6_NUM(name) (sn_osx_arm64_##name##_hi * 65536L + sn_osx_arm64_##name##_lo)
#elif defined(__APPLE__) && defined(__x86_64__)
#define SC6_NUM(name) (sn_osx_x86_64_##name##_hi * 65536L + sn_osx_x86_64_##name##_lo)
#elif defined(__linux__) && defined(__aarch64__)
#define SC6_NUM(name) (sn_lnx_arm64_##name##_hi * 65536L + sn_lnx_arm64_##name##_lo)
#elif defined(__linux__) && defined(__x86_64__)
#define SC6_NUM(name) (sn_lnx_x86_64_##name##_hi * 65536L + sn_lnx_x86_64_##name##_lo)
#else
#define SC6_NUM(name) (sn_fallback_##name##_hi * 65536L + sn_fallback_##name##_lo)
#endif

static int sc6_pass, sc6_fail;
static void sc6_ck(int ok, const char *name) {
    printf("%s\tl0-syscall6.%s\n", ok ? "PASS" : "FAIL", name);
    if (ok) sc6_pass++; else sc6_fail++;
}

int main(void) {
    long nr_getpid = SC6_NUM(syp_getpid);
    long r_pid = sy_syscall6(nr_getpid, 0, 0, 0, 0, 0);
    int p = sy_pid();
    sc6_ck(nr_getpid > 0, "sysnums-getpid-nonzero");
    sc6_ck(p > 0 && r_pid == (long)p, "getpid-matches-sy-pid");
    {
        long r_bad = sy_syscall6(-1, 0, 0, 0, 0, 0);
        sc6_ck(r_bad < 0, "invalid-nr-returns-neg-errno");
    }
    printf("CHECK_L0_SYSCALL6\tpassed=%d\tfailed=%d\tpid=%d\tr_pid=%ld\tnr=%ld\n",
           sc6_pass, sc6_fail, p, r_pid, nr_getpid);
    return sc6_fail ? 1 : 0;
}
