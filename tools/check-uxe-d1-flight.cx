#pragma unisa use chrome_dom
#pragma unisa use text.fmt
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.time

typedef struct { int r,g,b; } Color;
typedef struct { int row,h,lo,hi,paint; } Span;
typedef struct { int x,y,want; } Probe;
static int offsets[13][2], groups[4], span_count, paint_count;
static Color palette[17];
static unsigned char grid[13][46][34];
static Span spans[13*46*34];
static Probe probes[48];
static Probe pitch_probes[24];

static int load_facts(void) {
    size_t size=0;
    char *data=cx_read("ujs/practice/uxe/test/d1-airframe.tsv",&size), *line;
    int count=0, ok=1, h,row,col;
    if(!data) return 0;
    for(line=strtok(data,"\n");line && ok;line=strtok(0,"\n")) {
        int a,b,c,d,e,f,g,i;
        if(line[0]=='#') continue;
        if(sscanf(line,"layer %d %d %d",&a,&b,&c)==3 && a==count && count<13) {
            offsets[count][0]=b; offsets[count++][1]=c;
        } else if(sscanf(line,"paint %d %d %d %d",&a,&b,&c,&d)==4 && a==paint_count+1 && a<=16) {
            palette[++paint_count]=(Color){b,c,d};
        } else if(sscanf(line,"part %d %d %d %d %d %d %d %d",&a,&b,&c,&d,&e,&f,&g,&i)==8 &&
            a>=0 && b>=a && b<13 && c>=0 && d>=c && d<46 && i>=1 && i<=paint_count) {
            for(row=c;row<=d;row++) {
                int width=f+(row-c)*g;
                if(width<1 || e-width<0 || e+width>34) { ok=0; break; }
                for(h=a;h<=b;h++) for(col=e-width;col<e+width;col++) grid[h][row][col]=i;
            }
        } else ok=0;
    }
    free(data);
    if(!ok || count!=13 || paint_count<8) return 0;
    for(h=0;h<13;h++) for(row=0;row<46;row++) {
        int start=0;
        while(start<34) {
            int end=start+1, paint=grid[h][row][start];
            while(end<34 && grid[h][row][end]==paint) end++;
            if(paint) spans[span_count++]=(Span){row,h,start-17,end-17,paint};
            start=end;
        }
    }
    palette[0]=(Color){17,28,48};
    return span_count>0;
}

static int slab(double origin,double direction,double low,double high,double *enter,double *leave) {
    double a,b;
    if(direction==0) return origin>=low && origin<=high;
    a=(low-origin)/direction;
    b=(high-origin)/direction;
    if(a>b) { double t=a; a=b; b=t; }
    if(a>*enter) *enter=a;
    if(b<*leave) *leave=b;
    return *enter<=*leave;
}

/* Intersect the pixel ray with each contiguous run of like-colored unit cubes. */
static int nearest(double px,double py,int mode,int *hits) {
    double right=(px-213)/240, down=(py-120)/240;
    double vy=-.6-.8*down,vz=-.8+.6*down,best=300,ey=48,ez=64;
    int result=-1,i,last_layer=-1;
    if(mode==3) {
        /* Rotate the eye and ray toward the lattice by minus 18 degrees. */
        double cp=.951056516295,sp=.309016994375,old_vy=vy;
        ey=48*cp+64*sp; ez=64*cp-48*sp;
        vy=old_vy*cp+vz*sp; vz=vz*cp-old_vy*sp;
    }
    *hits=0;
    for(i=0;i<span_count;i++) {
        Span span=spans[i];
        int h=span.h, row=span.row, dz=offsets[h][1];
        int y=(mode==1?12-h:h)-6, x=offsets[h][0]+(mode==2 && h>=7?3:0);
        double enter=.1,leave=300;
        if(!slab(ey,vy,y-.5,y+.5,&enter,&leave) ||
           !slab(ez,vz,row-23+dz,row-22+dz,&enter,&leave) ||
           !slab(0,right,x+span.lo,x+span.hi,&enter,&leave)) continue;
        if(h!=last_layer) { (*hits)++; last_layer=h; }
        if(enter<best) { best=enter; result=span.paint; }
    }
    return result;
}

static int stable(int x,int y,int want,int mode) {
    int dx,dy,hits;
    for(dx=-1;dx<=1;dx+=2) for(dy=-1;dy<=1;dy+=2)
        if(nearest(x+.5+dx*.06,y+.5+dy*.06,mode,&hits)!=want) return 0;
    return 1;
}

static int choose_probes(void) {
    int x,y,n=0;
    for(y=58;y<204;y+=4) for(x=143;x<284;x+=4) {
        int hit,unused,want=nearest(x+.5,y+.5,0,&hit), group;
        if(want<0) group=0;
        else if(nearest(x+.5,y+.5,2,&unused)!=want) group=1;
        else if(hit>=2 && nearest(x+.5,y+.5,1,&unused)!=want) group=2;
        else group=3;
        if(groups[group]>=12 || !stable(x,y,want,0)) continue;
        groups[group]++;
        probes[n++]=(Probe){x,y,want};
    }
    return n;
}

static int choose_pitch(void) {
    int x,y,n=0,counts[2]={0};
    for(y=60;y<193;y+=3) for(x=168;x<261;x+=3) {
        int hit,want=nearest(x+.5,y+.5,3,&hit), zone=y>=119;
        if(counts[zone]>=12 || nearest(x+.5,y+.5,0,&hit)==want || !stable(x,y,want,3)) continue;
        counts[zone]++;
        pitch_probes[n++]=(Probe){x,y,want};
    }
    return n;
}

static int number(const char **p) {
    int n=0,negative=**p=='-';
    if(negative) (*p)++;
    if(**p<'0' || **p>'9') return -1000;
    while(**p>='0' && **p<='9') {
        n=n*10+**p-'0';
        *p=*p+1;
        if(n>999) return -1000;
    }
    return negative?-n:n;
}

static int flight(const char **p,int *settled,int *pitch_settled) {
    int replay,i,heading,bank,pitch,altitude,fail=0;
    for(replay=0;replay<2;replay++) {
        if(**p!='|') return -1;
        *p=*p+1;
        heading=0; bank=0; pitch=0; altitude=25; *settled=0; *pitch_settled=0;
        for(i=0;i<23;i++) {
            int axis=i<7?1:i>=14 && i<17?-1:0, desired=axis*24;
            int got_heading=number(p),got_bank,got_pitch,got_altitude;
            if(got_heading<0 || **p!=',') return -1;
            *p=*p+1;
            got_bank=number(p);
            if(got_bank<-24 || got_bank>24 || **p!=',') return -1;
            *p=*p+1; got_pitch=number(p);
            if(got_pitch<-18 || got_pitch>18 || **p!=',') return -1;
            *p=*p+1; got_altitude=number(p);
            if(got_altitude<12 || got_altitude>106) return -1;
            if(i<22) {
                if(**p!=';') return -1;
                *p=*p+1;
            }
            heading=(heading+axis*3+360)%360;
            if(bank<desired) bank+=4;
            else if(bank>desired) bank-=4;
            if(pitch<axis*18) pitch+=3;
            else if(pitch>axis*18) pitch-=3;
            altitude+=axis;
            fail+=heading!=got_heading || bank!=got_bank || pitch!=got_pitch || altitude!=got_altitude;
            if(i>=7 && i<14 && !got_bank && !*settled) *settled=i-6;
            if(i>=7 && i<14 && !got_pitch && !*pitch_settled) *pitch_settled=i-6;
        }
        fail+=!*settled || *settled>6;
        fail+=!*pitch_settled || *pitch_settled>6;
    }
    return fail;
}

static int silhouette(const char **p) {
    int expected[17]={0},actual[17]={0}, min_x[2]={999,999},max_x[2]={0,0};
    int x,y,k,failed=0;
    if(**p!='|') return -1;
    *p=*p+1;
    for(y=44;y<=211;y+=3) for(x=145;x<=280;x+=3) {
        int hits,want=nearest(x+.5,y+.5,0,&hits),r=number(p),g,b,got;
        if(r<0 || **p!=',') return -1;
        *p=*p+1; g=number(p);
        if(g<0 || **p!=',') return -1;
        *p=*p+1; b=number(p);
        if(b<0) return -1;
        if(y+3<=211 || x+3<=280) {
            if(**p!=',') return -1;
            *p=*p+1;
        }
        want=want<0?0:want;
        for(got=0;got<=paint_count;got++)
            if(palette[got].r==r && palette[got].g==g && palette[got].b==b) break;
        expected[want]++;
        if(got>paint_count) failed++;
        else actual[got]++;
        if(want==4) { if(x<min_x[0]) min_x[0]=x; if(x>max_x[0]) max_x[0]=x; }
        if(got==4) { if(x<min_x[1]) min_x[1]=x; if(x>max_x[1]) max_x[1]=x; }
    }
    for(k=1;k<=paint_count;k++) failed+=abs(expected[k]-actual[k])>2+expected[k]/20;
    failed+=expected[4]<10 || expected[5]<8 || expected[6]<1;
    failed+=abs((max_x[1]-min_x[1])-(max_x[0]-min_x[0]))>3;
    printf("D1_SILHOUETTE wing_area=%d/%d tail_accent_area=%d/%d canopy_area=%d/%d wingspan_px=%d/%d failed=%d\n",
        actual[4],expected[4],actual[5],expected[5],actual[6]+actual[7],expected[6]+expected[7],
        max_x[1]-min_x[1],max_x[0]-min_x[0],failed);
    return failed;
}

static int input_error(const char *stage,char *out) {
    printf("D1_FLIGHT_ERROR stage=%s\n",stage);
    free(out);
    return 2;
}

static const char *browser(char *url,char **out,int stage) {
    char profile[128],option[160];
    const char *p, *tag="<output id=\"pixels\">";
    char *args[]={"google-chrome","--headless=new","--use-angle=swiftshader",
        "--enable-unsafe-swiftshader","--disable-background-networking","--allow-file-access-from-files",
        "--window-size=1280,807","--no-first-run","--virtual-time-budget=5000",option,"--dump-dom",url,0};
    size_t size=0;
    int attempt;
    for(attempt=1;attempt<=2;attempt++) {
        int rc,complete,error;
        tx_snprintf(profile,sizeof profile,"/tmp/chrome-d1-flight-%d-%d-%d",(int)getpid(),stage,attempt);
        tx_snprintf(option,sizeof option,"--user-data-dir=%s",profile);
        rc=cx_runv_timeout(args,attempt==1?12:8,out,&size);
        chd_wipe(profile);
        p=*out?strstr(*out,tag):0;
        if(p) p+=strlen(tag);
        complete=p && *p!='<' && strstr(p,"</output>");
        error=p && !strncmp(p,"ERROR:",6);
        if(!rc && complete && !error) return p;
        printf("D1_FLIGHT_BROWSER stage=%d attempt=%d rc=%d bytes=%d payload=%.100s\n",
            stage,attempt,rc,(int)size,p?p:"missing");
        if(rc || error || attempt==2) return 0;
        free(*out);
        *out=0;
        size=0;
    }
    return 0;
}

static int add_probes(char *url,int capacity,int at,const Probe *set,int n) {
    int i;
    if(at<0 || at>=capacity) return -1;
    for(i=0;i<n;i++) {
        int w=tx_snprintf(url+at,capacity-at,"%s%d,%d",i?";":"",set[i].x,set[i].y);
        if(w<0 || w>=capacity-at) return -1;
        at+=w;
    }
    return at;
}

static int pitch_pixels(const char **p,int n) {
    int i,j,fail=0;
    if(**p!='|') return -1;
    *p=*p+1;
    for(i=0;i<n;i++) {
        int paint=pitch_probes[i].want,got[3];
        Color color=palette[paint<0?0:paint];
        for(j=0;j<3;j++) {
            got[j]=number(p);
            if(got[j]<0 || got[j]>255) return -1;
            if(j<2 || i<n-1) {
                if(**p!=(j<2?',':';')) return -1;
                *p=*p+1;
            }
        }
        fail+=got[0]!=color.r || got[1]!=color.g || got[2]!=color.b;
    }
    return fail;
}

static int check_airframe(const char *mutation) {
    char cwd[1024],url[2200],*out=0;
    const char *p;
    int n,tilt_n,i,j,k,at,pixel_fail=0,scale_fail=0,flight_fail,settled,shape_fail,tilt_fail,pitch_settled;
    if(!load_facts() || !getcwd(cwd,sizeof cwd)) return input_error("airframe-facts",0);
    n=choose_probes();
    tilt_n=choose_pitch();
    if(n<8 || tilt_n!=24 || groups[0]<2 || groups[1]<2 || groups[2]<2) return input_error("airframe-probes",0);
    at=tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/d1-flight.html?%s&probe=",cwd,mutation);
    at=add_probes(url,sizeof url,at,probes,n);
    if(at<0 || at+7>=(int)sizeof url) return input_error("airframe-url",0);
    at+=tx_snprintf(url+at,sizeof url-at,"&pitch=");
    if(add_probes(url,sizeof url,at,pitch_probes,tilt_n)<0) return input_error("pitch-url",0);
    p=browser(url,&out,1);
    if(!p) return input_error("airframe-browser",out);
    for(i=0;i<n;i++) {
        Color color=palette[probes[i].want<0?0:probes[i].want];
        int expected[]={color.r,color.g,color.b,255}, first[4];
        for(j=0;j<9;j++) for(k=0;k<4;k++) {
            int got=number(&p);
            if(got<0 || got>255 || ((j!=8 || k!=3) && *p++!=',')) return input_error("airframe-rgba",out);
            if(!j) { first[k]=got; pixel_fail+=got!=expected[k]; }
            else scale_fail+=got!=first[k];
        }
        if(i<n-1 && *p++!=';') return input_error("airframe-block",out);
    }
    shape_fail=silhouette(&p);
    if(shape_fail<0) return input_error("airframe-silhouette",out);
    tilt_fail=pitch_pixels(&p,tilt_n);
    if(tilt_fail<0) return input_error("pitch-rgb",out);
    flight_fail=flight(&p,&settled,&pitch_settled);
    if(flight_fail<0 || strncmp(p,"</output>",9)) return input_error("airframe-replay",out);
    free(out);
    printf("CHECK_UXE_D1_FLIGHT\tprobes=%d background=%d offset=%d occlusion=%d pixel_fail=%d scale_fail=%d replay_frames=46 flight_fail=%d release_frames=%d\n",
        n,groups[0],groups[1],groups[2],pixel_fail,scale_fail,flight_fail,settled);
    printf("D1_PITCH probes=%d pixel_fail=%d release_frames=%d\n",tilt_n,tilt_fail,pitch_settled);
    return pixel_fail || scale_fail || flight_fail || shape_fail || tilt_fail;
}

static double root(double square) {
    double estimate=square;
    int i;
    for(i=0;i<12;i++) estimate=(estimate+square/estimate)*.5;
    return estimate;
}

static int center(double x,double y,double z,double travel,int *px,int *py) {
    /* Unit right/up/forward from the chase eye to the point ahead of the jet. */
    double ex=-37.1830338545, ez=59.3078577709;
    double fx=-ex, fy=-32, fz=-13-ez;
    double horizontal=root(fx*fx+fz*fz), length=root(horizontal*horizontal+fy*fy);
    double rx=-fz/horizontal, rz=fx/horizontal, depth, up;
    x-=ex; y-=34; z-=ez+travel;
    depth=(fx*x+fy*y+fz*z)/length;
    if(depth<=0) return 0;
    up=(-rz*fy*x+horizontal*y+rx*fy*z)/length;
    *px=(int)(213+240*(rx*x+rz*z)/depth);
    *py=(int)(120-240*up/depth);
    return *px>=4 && *px<422 && *py>=4 && *py<236;
}

static int csv(const char **p) {
    int n=number(p);
    if(n<0 || **p!=',') return -1;
    *p=*p+1;
    return n;
}

static int check_world(const char *mutation) {
    const int islands[3][3]={{-60,-102,24},{61,-134,28},{-5,-192,31}};
    int px[2][3],py[2][3],seed=7,travel=-12,speed=12,i,j,k;
    int speeds[2]={60,0},world_fail=0,hud_fail=0,at;
    char cwd[1024],url[2200],*out=0;
    const char *p;
    if(!getcwd(cwd,sizeof cwd)) return input_error("world-cwd",0);
    at=tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/d1-flight.html?%s&world=",cwd,mutation);
    if(at<0 || at>=(int)sizeof url) return input_error("world-url",0);
    for(j=0;j<2;j++) {
        seed=7;
        for(i=0;i<3;i++) {
            int x,z,w;
            seed=(seed*73+41)%251; x=islands[i][0]+seed%13-6;
            seed=(seed*73+41)%251; z=islands[i][1]+seed%17-8;
            if(!center(x,-23.92+.25*islands[i][2],z,travel/8.0,&px[j][i],&py[j][i]))
                return input_error("world-projection",0);
            w=tx_snprintf(url+at,sizeof url-at,"%s%d,%d",i?";":j?"%7C":"",px[j][i],py[j][i]);
            if(w<0 || w>=(int)sizeof url-at) return input_error("world-url",0);
            at+=w;
        }
        if(j==0) {
            for(k=0;k<27;k++) {
                if(speed<28) speed+=2;
                travel-=speed;
            }
            speeds[1]=speed*5;
        }
    }
    p=browser(url,&out,2);
    if(!p) return input_error("world-browser",out);
    for(j=0;j<2;j++) {
        int hud_speed=csv(&p), hud_alt=csv(&p);
        if(hud_speed<0 || hud_alt<0) return input_error("world-hud-payload",out);
        hud_fail+=hud_speed!=speeds[j] || hud_alt!=100;
        for(i=0;i<3;i++) {
            int sumx=0,sumy=0,count=0;
            for(k=0;k<81;k++) {
                int r=csv(&p),g=csv(&p),b=number(&p);
                if(r<0 || g<0 || b<0 || r>255 || g>255 || b>255)
                    return input_error("world-rgb",out);
                if(i<2 || k<80) {
                    if(*p++!=',') return input_error("world-rgb-delimiter",out);
                }
                if(g>=164 && g>=r+22 && g>=b+45) {
                    sumx+=k%9-4; sumy+=k/9-4; count++;
                }
            }
            world_fail+=count<2 || abs(sumx)>2*count || abs(sumy)>2*count;
            printf("D1_ISLAND frame=%d island=%d expected=%d,%d samples=%d error=%d,%d\n",
                j?28:1,i,px[j][i],py[j][i],count,count?sumx/count:0,count?sumy/count:0);
        }
        if(j==0 && *p++!='|') return input_error("world-frame-delimiter",out);
        printf("D1_HUD frame=%d speed=%d expected=%d altitude=%d\n",j?28:1,hud_speed,speeds[j],hud_alt);
    }
    if(strncmp(p,"</output>",9)) return input_error("world-trailer",out);
    free(out);
    printf("D1_WORLD\ttravel_eighths=%d island_fail=%d hud_fail=%d\n",travel,world_fail,hud_fail);
    return world_fail || hud_fail;
}

static int check_pages_auto(int live) {
    const char *finals[]={"D1_FLY_NEXT_READY","D1_FLY_NEXT_ERROR"};
    char cwd[1024],url[1500];
    int retry,rc;
    if(live) tx_snprintf(url,sizeof url,"https://partnernetsoftware.github.io/unisacc/uxe/fly-next/?auto=1");
    else {
        if(!getcwd(cwd,sizeof cwd)) return input_error("pages-auto-cwd",0);
        tx_snprintf(url,sizeof url,"file://%s/docs/uxe/fly-next/index.html?auto=1",cwd);
    }
    rc=chd_dump_expect("/usr/bin/google-chrome",url,finals[0],finals,2,"",2,15,&retry);
    printf("D1_PAGES_AUTO live=%d expected=%s rc=%d retries=%d\n",live,finals[0],rc,retry);
    return rc;
}

static unsigned field_hash(int x,int y,int seed) {
    unsigned n=(unsigned)(x+17)*374761393u ^ (unsigned)(y+29)*668265263u ^ (unsigned)seed*1442695041u;
    n=(n^(n>>13))*1274126177u;
    return (n^(n>>16))&255;
}

static int field_noise(int x,int y,int spacing,int seed) {
    int u=x/spacing,v=y/spacing,a=x%spacing,b=y%spacing,mask=256/spacing-1;
    int q0=field_hash(u,v,seed),q1=field_hash((u+1)&mask,v,seed);
    int q2=field_hash(u,(v+1)&mask,seed),q3=field_hash((u+1)&mask,(v+1)&mask,seed);
    return (q0*(spacing-a)*(spacing-b)+q1*a*(spacing-b)+q2*(spacing-a)*b+q3*a*b)/(spacing*spacing);
}

static int down_ratio(int numerator,int denominator) {
    return (numerator<0?numerator-denominator+1:numerator)/denominator;
}

static int terrain_height(int x,int y,int seed,int legacy) {
    static const int islands[][5]={{100,106,34,28,113},{163,96,22,18,97},{130,67,12,13,84},
        {72,56,16,15,100},{187,52,17,13,102},{104,25,16,14,98},{150,20,15,13,103},{215,19,19,13,104}};
    static const int release[][5]={{162,82,44,62,93},{68,103,32,42,93},{227,65,32,26,93},{92,29,40,30,93},{188,15,58,37,93}};
    int i,peak=-49,steepness=legacy?96:116;
    for(i=0;i<(legacy?5:8);i++) {
        const int *a=legacy?release[i]:islands[i];
        int dx=abs(a[0]-x),dy=abs(a[1]-y),ground;
        if(dx>128) dx=256-dx;
        if(dy>128) dy=256-dy;
        ground=a[4]-steepness*dx*dx/(a[2]*a[2])-steepness*dy*dy/(a[3]*a[3]);
        if(ground>peak) peak=ground;
    }
    if(legacy) return peak+down_ratio(35*(field_noise(x,y,32,seed)-128),100)
        +down_ratio(field_noise(x,y,8,seed+3)-128,5)
        +down_ratio(7*(field_noise(x,y,2,seed+5)-128),100);
    return peak+down_ratio(45*(field_noise(x,y,64,seed)-128),100)
        +down_ratio(field_noise(x,y,16,seed+3)-128,4)
        +down_ratio(7*(field_noise(x,y,2,seed+5)-128),100);
}

static int terrain_band(int x,int y,int seed,int legacy) {
    static const int stops[]={-25,-8,0,8,28,55,101};
    int i,elevation=terrain_height(x,y,seed,legacy);
    for(i=0;i<7 && elevation>=stops[i];i++) {}
    return i;
}

static int take_channel(const char **p,int end) {
    int value=number(p);
    if(value<0 || value>255 || (end && **p!=end)) return -1;
    if(end) *p=*p+1;
    return value;
}

static int far_islands(void) {
    unsigned char land[64*20];
    int queue[64*20],x,y,i,count=0;
    for(y=0;y<20;y++) for(x=0;x<64;x++) land[64*y+x]=terrain_height(x*4+2,y*4+2,7,0)>=0;
    for(i=0;i<64*20;i++) if(land[i]) {
        int next=0,end=1,clipped=0,inside=0;
        queue[0]=i; land[i]=0;
        while(next<end) {
            int at=queue[next++],col=at%64,row=at/64,j;
            int near[4]={at-1,at+1,at-64,at+64};
            if(col==0 || col==63 || row==0 || row==19) clipped=1;
            inside+=abs(4*col+2-128)*151 < (127-(4*row+2))*213;
            for(j=0;j<4;j++) {
                int adjacent=near[j];
                if((j==0 && col==0) || (j==1 && col==63) || adjacent<0 || adjacent>=64*20 || !land[adjacent]) continue;
                land[adjacent]=0;
                queue[end++]=adjacent;
            }
        }
        count+=!clipped && inside>=5;
    }
    return count;
}

static int projected_land_ratio(void) {
    int x,y,ground=0,water=0;
    for(y=123;y<240;y+=8) for(x=1;x<426;x+=8) {
        int depth;
        for(depth=4;depth<=400;depth+=4) {
            int gx=(int)((256+(x+.5-213)*depth/151)/2)&255;
            int gy=(int)((254.5-depth)/2)&255;
            int altitude=terrain_height(gx,gy,7,0);
            double top=100+(45-(altitude>0?altitude*.22:0))*151/depth;
            if(y+1<top) continue;
            ground+=altitude>=0;
            water+=altitude<0;
            break;
        }
    }
    return ground+water?ground*100/(ground+water):0;
}

static int check_terrain(const char *mutation,int published) {
    static const int palette[][3]={{19,67,128},{30,111,165},{45,158,190},{231,204,134},
        {133,183,71},{89,153,59},{60,115,61},{119,111,121}};
    char cwd[1024],url[2300],*out=0;
    const char *p;
    int x,y,at,n=0,i,j,failed=0,green=0,land=0,sea=0,foam=0,counts[8]={0},want[32];
    if(!getcwd(cwd,sizeof cwd)) return input_error("terrain-cwd",0);
    at=tx_snprintf(url,sizeof url,"file://%s/%s?%s&terrain=",cwd,published?
        "docs/uxe/fly-next/index.html":"ujs/practice/uxe/test/d1-pixel-a.html",mutation);
    if(at<0 || at>=(int)sizeof url) return input_error("terrain-url",0);
    for(y=1;y<256;y+=3) for(x=1;x<256;x+=3) {
        int kind=terrain_band(x,y,7,published),size;
        if(counts[kind]>=4 || terrain_band(x,y,31,published)==kind) continue;
        size=tx_snprintf(url+at,sizeof url-at,"%s%d,%d",n?";":"",x,y);
        if(size<0 || size>=(int)sizeof url-at) return input_error("terrain-url",0);
        at+=size;
        counts[kind]++;
        want[n++]=kind;
    }
    for(i=0;i<8;i++) if(counts[i]<3) return input_error("terrain-probe-coverage",0);
    p=browser(url,&out,3);
    if(!p) return input_error("terrain-browser",out);
    for(i=0;i<n;i++) {
        int wrong=0;
        for(j=0;j<3;j++) {
            int next=i==n-1 && j==2?'|':',';
            int value=take_channel(&p,next);
            if(value<0) return input_error("terrain-swatch",out);
            wrong+=value!=palette[want[i]][j];
        }
        failed+=wrong>0;
    }
    for(i=0;i<30*107;i++) {
        int r=take_channel(&p,','),g=take_channel(&p,','),b=take_channel(&p,i+1<30*107?',':0);
        if(r<0 || g<0 || b<0) return input_error("terrain-frame",out);
        if(g>r+15 && g>b+8) { green++; land++; }
        else if((r>=g+14 && g>=b+23) || (r>=75 && r<155 && abs(r-g)<=11 && abs(g-b)<=12)) land++;
        if(b>r+20 && b>g) sea++;
        if(g>=175 && r>=110 && b>=g-15 && b<=g+30) foam++;
    }
    if(strncmp(p,"</output>",9)) return input_error("terrain-trailer",out);
    free(out);
    printf("D1_TERRAIN swatches=%d band_errors=%d land=%d/3210 green=%d water=%d foam=%d\n",
        n,failed,land,green,sea,foam);
    if(!published) {
        int islands=far_islands(),expected=projected_land_ratio(),observed=land+sea?land*100/(land+sea):0;
        printf("D1_ARCHIPELAGO seed_far_islands=%d land_expected_pct=%d land_actual_pct=%d sea_actual_pct=%d\n",
            islands,expected,observed,100-observed);
        failed+=islands<5 || expected<25 || expected>70 || abs(expected-observed)>15;
    }
    return failed || land<550 || green<350 || sea<320 || foam<20;
}

static void enemy_point(int tick,int index,int *px,int *py) {
    static const int enemies[3][4]={{-49,-116,55,1},{4,-91,45,0},{53,-135,50,-1}};
    const int *e=enemies[index];
    double forward=-e[1]+tick/3-1.5*tick;
    *px=(int)(213.5+151*(e[0]+(tick%72/6)*e[3])/forward);
    *py=(int)(113.5+151*(38-e[2])/forward);
}

static int check_combat(const char *mutation,int published) {
    static const int colors[][3]={{255,116,106},{255,228,107},{255,235,134},{247,121,61},
        {35,52,77},{232,234,219}};
    char cwd[1024],url[2100],*out=0;
    const char *p;
    int frame,i,j,at,marker_fail=0,lock_fail=0,hit_fail=0,ammo_fail=0;
    int locations[2][6][2],types[2][6]={{0,0,0,1,1,5},{0,0,2,3,4,6}};
    if(!getcwd(cwd,sizeof cwd)) return input_error("combat-cwd",0);
    for(i=0;i<3;i++) {
        enemy_point(1,i,&locations[0][i][0],&locations[0][i][1]);
        locations[0][i][1]-=8;
    }
    enemy_point(1,1,&locations[0][3][0],&locations[0][3][1]);
    locations[0][4][0]=locations[0][3][0]+11;
    locations[0][4][1]=locations[0][3][1]+9;
    locations[0][3][0]-=11;
    locations[0][3][1]-=9;
    enemy_point(18,0,&locations[1][0][0],&locations[1][0][1]);
    enemy_point(18,2,&locations[1][1][0],&locations[1][1][1]);
    locations[1][0][1]-=8;
    locations[1][1][1]-=8;
    enemy_point(17,1,&locations[1][2][0],&locations[1][2][1]);
    locations[1][3][0]=locations[1][2][0]+1;
    locations[1][3][1]=locations[1][2][1]+1;
    locations[1][2][0]-=3;
    locations[1][2][1]-=2;
    enemy_point(18,1,&locations[1][4][0],&locations[1][4][1]);
    locations[1][4][1]-=8;
    locations[0][5][0]=locations[1][5][0]=35;
    locations[0][5][1]=locations[1][5][1]=227;
    at=tx_snprintf(url,sizeof url,"file://%s/%s?%s&combat=",cwd,published?
        "docs/uxe/fly-next/index.html":"ujs/practice/uxe/test/d1-pixel-a.html",mutation);
    if(at<0 || at>=(int)sizeof url) return input_error("combat-url",0);
    for(frame=0;frame<2;frame++) {
        for(i=0;i<6;i++) {
            int w=tx_snprintf(url+at,sizeof url-at,"%s%d,%d",i?";":frame?"%7C":"",
                locations[frame][i][0],locations[frame][i][1]);
            if(w<0 || w>=(int)sizeof url-at) return input_error("combat-url",0);
            at+=w;
        }
    }
    p=browser(url,&out,4);
    if(!p) return input_error("combat-browser",out);
    for(frame=0;frame<2;frame++) for(i=0;i<6;i++) {
        int observed[3],match[6]={1,1,1,1,1,1},kind=types[frame][i];
        for(j=0;j<3;j++) {
            int end=j!=2 || i<5?',':frame==0?'|':0,k;
            observed[j]=take_channel(&p,end);
            if(observed[j]<0) return input_error("combat-pixel",out);
            for(k=0;k<6;k++) match[k]&=observed[j]==colors[k][j];
        }
        if(kind==0) marker_fail+=!match[0];
        else if(kind==1) lock_fail+=!match[1];
        else if(kind==4) hit_fail+=match[0];
        else if(kind>=5) ammo_fail+=!match[kind-1];
        else {
            hit_fail+=!match[2] && !match[3];
            printf("D1_IMPACT xy=%d,%d rgb=%d,%d,%d\n",locations[frame][i][0],locations[frame][i][1],
                observed[0],observed[1],observed[2]);
        }
    }
    if(strncmp(p,"</output>",9)) return input_error("combat-trailer",out);
    free(out);
    printf("D1_COMBAT markers=5 marker_fail=%d lock_fail=%d impact_fail=%d ammo_fail=%d\n",
        marker_fail,lock_fail,hit_fail,ammo_fail);
    return marker_fail || lock_fail || hit_fail || ammo_fail;
}

static int check_viewport(const char *mutation) {
    char cwd[1024],url[1800],profile[160],option[180],path[160],shot[180],*out=0;
    char *window[]={ "--window-size=1280,807","--window-size=960,1000" };
    char *bottom[]={ "3x1+639+719","3x1+479+912" };
    char *chrome[]={"google-chrome","--headless=new","--disable-background-networking",
        "--allow-file-access-from-files","--no-first-run","--virtual-time-budget=5000",
        option,shot,0,url,0};
    char *crop[]={"convert",path,"-crop",0,"+repage","-depth","8","rgb:-",0};
    size_t size;
    int i,j,failed=0;
    if(!getcwd(cwd,sizeof cwd)) return input_error("viewport-cwd",0);
    tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/d1-pixel-a.html?still=1&%s",cwd,mutation);
    for(i=0;i<2;i++) {
        int rc,background=0;
        tx_snprintf(profile,sizeof profile,"/tmp/chrome-d1-viewport-%d-%d",(int)getpid(),i);
        tx_snprintf(option,sizeof option,"--user-data-dir=%s",profile);
        tx_snprintf(path,sizeof path,"%s/viewport.png",profile);
        tx_snprintf(shot,sizeof shot,"--screenshot=%s",path);
        chrome[8]=window[i];
        crop[3]=bottom[i];
        rc=cx_runv_timeout(chrome,12,&out,&size);
        if(rc) { chd_wipe(profile); return input_error("viewport-chrome",out); }
        free(out); out=0;
        rc=cx_runv_timeout(crop,4,&out,&size);
        chd_wipe(profile);
        if(rc || size!=9) return input_error("viewport-pixels",out);
        for(j=0;j<9;j+=3)
            background+=(unsigned char)out[j]==34 && (unsigned char)out[j+1]==86 && (unsigned char)out[j+2]==117;
        printf("D1_VIEWPORT size=%s background_pixels=%d/3\n",window[i]+14,background);
        failed+=background!=0;
        free(out); out=0;
    }
    return failed!=0;
}

static int detail_material(int r,int g,int b) {
    static const int paint[4][3]={{121,155,65},{103,168,81},{52,104,56},{174,225,231}};
    static const int haze[3]={173,214,234};
    int i,j;
    for(i=0;i<4;i++) for(j=0;j<=16;j++) {
        int red=paint[i][0]+down_ratio((haze[0]-paint[i][0])*j*86+800,1600);
        int green=paint[i][1]+down_ratio((haze[1]-paint[i][1])*j*86+800,1600);
        int blue=paint[i][2]+down_ratio((haze[2]-paint[i][2])*j*86+800,1600);
        if(r==red && g==green && b==blue) return i+1;
    }
    return 0;
}

static int check_detail(const char *mutation) {
    char cwd[1024],url[1800],*out=0;
    const char *p;
    int x,y,n=0,want[8],at,i,phase,furrows=0,trees=0,waves=0,wrong=0;
    unsigned char foam[26*107];
    if(!getcwd(cwd,sizeof cwd)) return input_error("detail-cwd",0);
    at=tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/d1-pixel-a.html?%s&detail=",cwd,mutation);
    for(y=1;y<255 && n<8;y+=9) for(x=1;x<255 && n<8;x+=7) {
        int a=terrain_height(x,y,7,0),b=terrain_height(x+1,y,7,0);
        int c=terrain_height(x,y+1,7,0),d=terrain_height(x+1,y+1,7,0);
        int fine=down_ratio(9*a+3*b+3*c+d,16)+128;
        if(fine==128+a || fine<0 || fine>255) continue;
        at+=tx_snprintf(url+at,sizeof url-at,"%s%d,%d",n?";":"",4*x+1,4*y+1);
        want[n++]=fine;
    }
    if(n!=8) return input_error("detail-probes",0);
    p=browser(url,&out,7);
    if(!p) return input_error("detail-browser",out);
    for(phase=0;phase<2;phase++) for(i=0;i<26*107;i++) {
        int r=take_channel(&p,','),g=take_channel(&p,','),b=take_channel(&p,','),material;
        if(r<0 || g<0 || b<0) return input_error("detail-pixel",out);
        material=detail_material(r,g,b);
        if(!phase) {
            furrows+=material==1;
            trees+=material==2 || material==3;
            foam[i]=material==4;
        } else waves+=foam[i]!=(material==4);
    }
    for(i=0;i<n;i++) wrong+=take_channel(&p,i+1<n?',':0)!=want[i];
    if(strncmp(p,"</output>",9)) return input_error("detail-trailer",out);
    free(out);
    printf("D1_DETAIL relief_fail=%d furrows=%d crowns=%d wave_changes=%d\n",wrong,furrows,trees,waves);
    return wrong || furrows<5 || trees<5 || waves<5;
}

static int check_attitude(const char *mutation) {
    char cwd[1024],url[1800],*out=0;
    const double radians=52*3.141592653589793/180;
    double squared=radians*radians;
    double c=1-squared*(.5-squared*(1.0/24-squared/720));
    double s=radians*(1-squared*(1.0/6-squared*(1.0/120-squared/5040)));
    int x=(int)(213-34.5*c+.15*s),y=(int)(148-34.5*s-.15*c);
    int trail_x=(int)(213.5-38*c-5*s-17*.68-24*17*17*.004);
    int trail_y=(int)(148.5-38*s+5*c+17);
    int r,g,b,wing,trail;
    const char *p;
    if(!getcwd(cwd,sizeof cwd)) return input_error("attitude-cwd",0);
    tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/d1-pixel-a.html?still=bank&%s&attitude=7,%d,%d;7,%d,%d",
        cwd,mutation,x,y,trail_x,trail_y);
    p=browser(url,&out,6);
    if(!p) return input_error("attitude-browser",out);
    r=take_channel(&p,','); g=take_channel(&p,','); b=take_channel(&p,',');
    wing=r>105 && g>35 && g<150 && b>=0 && b<100;
    printf("D1_ATTITUDE wing=%d rgb=%d,%d,%d\n",wing,r,g,b);
    r=take_channel(&p,','); g=take_channel(&p,','); b=take_channel(&p,0);
    trail=r==148 && g==190 && b==197;
    printf("D1_ATTITUDE trail=%d rgb=%d,%d,%d\n",trail,r,g,b);
    if(strncmp(p,"</output>",9)) return input_error("attitude-trailer",out);
    free(out);
    return !wing || !trail;
}

static int check_effects(const char *mutation) {
    static const int expected[3][3]={{155,162,175},{155,162,175},{121,197,189}};
    char cwd[1024],url[1800],*out=0;
    int x,y,probe,channel,failed=0,missile_x,missile_y;
    const char *p;
    if(!getcwd(cwd,sizeof cwd)) return input_error("effects-cwd",0);
    enemy_point(1,1,&x,&y);
    missile_x=(int)(213.5+(x-213)*7.0/13);
    missile_y=(int)(172.5+(y-166)*7.0/13);
    tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/d1-pixel-a.html?freeze-targets&%s&effects=3,%d,%d;11,%d,%d;30,%d,%d",
        cwd,mutation,x,y+1,missile_x,missile_y,x+(int)(.5+13*.48),y+(int)(.5+13*13*.12));
    p=browser(url,&out,5);
    if(!p) return input_error("effects-browser",out);
    for(probe=0;probe<3;probe++) {
        int got[3],bad=0;
        for(channel=0;channel<3;channel++) {
            got[channel]=take_channel(&p,probe==2 && channel==2?0:',');
            bad|=got[channel]!=expected[probe][channel];
        }
        printf("D1_EFFECT probe=%d rgb=%d,%d,%d failed=%d\n",probe,got[0],got[1],got[2],bad);
        failed+=bad;
    }
    if(strncmp(p,"</output>",9)) return input_error("effects-trailer",out);
    free(out);
    return failed!=0;
}

typedef struct {
    sy_child_t child;
    int id,at,len;
    long deadline;
    char buffer[4096],reply[8192],session[100];
} ChromeInput;
typedef struct { int heading,ammo,missiles,lock,frames,elapsed,gap; } LiveFlight;

static int cdp_message(ChromeInput *c,long deadline) {
    int n=0;
    while(n<(int)sizeof c->reply-1) {
        if(c->at>=c->len) {
            long left=deadline-sy_now_ms();
            if(left<=0 || sy_readable(c->child.out_fd,left)<=0) return 0;
            c->len=(int)sy_read(c->child.out_fd,c->buffer,sizeof c->buffer);
            c->at=0;
            if(c->len<=0) return 0;
        }
        c->reply[n]=c->buffer[c->at++];
        if(!c->reply[n++]) return 1;
    }
    return 0;
}

static int cdp_call(ChromeInput *c,const char *method,const char *params) {
    char payload[2100],session[130];
    long deadline=sy_now_ms()+3000;
    int id=++c->id,n;
    if(deadline>c->deadline) deadline=c->deadline;
    if(deadline<=sy_now_ms()) return 0;
    session[0]=0;
    if(c->session[0]) tx_snprintf(session,sizeof session,",\"sessionId\":\"%s\"",c->session);
    n=tx_snprintf(payload,sizeof payload,"{\"id\":%d,\"method\":\"%s\",\"params\":%s%s}",id,method,params,session);
    if(n<0 || n>=(int)sizeof payload || sy_write_all(c->child.in_fd,payload,n+1)) return 0;
    while(cdp_message(c,deadline)) {
        char *p=strstr(c->reply,"\"id\":");
        if(p && atoi(p+5)==id) return strstr(c->reply,"\"error\":")==0;
    }
    return 0;
}

static int cdp_string(ChromeInput *c,const char *mark,char *out,int cap) {
    const char *p=strstr(c->reply,mark);
    int n=0;
    if(!p) return 0;
    p+=strlen(mark);
    while(p[n] && p[n]!='"' && n+1<cap) { out[n]=p[n]; n++; }
    out[n]=0;
    return p[n]=='"' && n>0;
}

static int keyboard(ChromeInput *c,const char *key,const char *code,int vk,int down) {
    char args[300];
    tx_snprintf(args,sizeof args,"{\"type\":\"%s\",\"key\":\"%s\",\"code\":\"%s\",\"windowsVirtualKeyCode\":%d}",
        down?"rawKeyDown":"keyUp",key,code,vk);
    return cdp_call(c,"Input.dispatchKeyEvent",args);
}

static int read_flight(ChromeInput *c,LiveFlight *state) {
    char text[250];
    if(!cdp_call(c,"Runtime.evaluate","{\"expression\":\"document.title==='D1_FLY_NEXT_READY'?document.querySelector('output').textContent:''\"}") ||
        !cdp_string(c,"\"value\":\"",text,sizeof text)) return 0;
    return sscanf(text,"%d,%d,%d,%d,%d,%d,%d",&state->heading,&state->ammo,&state->missiles,
        &state->lock,&state->frames,&state->elapsed,&state->gap)==7;
}

static int key_change(ChromeInput *c,const char *key,const char *code,int vk,int field,LiveFlight *state) {
    int old=field==0?state->heading:field==1?state->ammo:state->missiles;
    int changed=0;
    long end=sy_now_ms()+700;
    if(!keyboard(c,key,code,vk,1)) return -1;
    while(!changed && sy_now_ms()<end) {
        if(read_flight(c,state)) changed=(field==0?state->heading:field==1?state->ammo:state->missiles)!=old;
        if(!changed) sy_sleep_ms(12);
    }
    if(!keyboard(c,key,code,vk,0)) return -1;
    return changed;
}

static int exercise_keyboard(ChromeInput *c,const char *url) {
    LiveFlight state;
    char target[100],params[1300];
    int original,turned,ammo,missiles,change,i,failed=0;
    long end;
    if(!cdp_call(c,"Target.createTarget","{\"url\":\"about:blank\"}") ||
        !cdp_string(c,"\"targetId\":\"",target,sizeof target)) return input_error("cdp-target",0);
    tx_snprintf(params,sizeof params,"{\"targetId\":\"%s\",\"flatten\":true}",target);
    if(!cdp_call(c,"Target.attachToTarget",params) ||
        !cdp_string(c,"\"sessionId\":\"",c->session,sizeof c->session)) return input_error("cdp-attach",0);
    tx_snprintf(params,sizeof params,"{\"url\":\"%s\"}",url);
    if(!cdp_call(c,"Page.navigate",params)) return input_error("cdp-navigate",0);
    end=sy_now_ms()+6000;
    for(i=0;!read_flight(c,&state);i++) {
        if(sy_now_ms()>=end || i>=100) return input_error("cdp-ready",0);
        sy_sleep_ms(35);
    }
    original=state.heading; ammo=state.ammo; missiles=state.missiles;
    change=key_change(c,"d","KeyD",68,0,&state);
    if(change<0) return input_error("cdp-turn",0);
    turned=state.heading;
    failed+=!change || turned==original;
    change=key_change(c," ","Space",32,1,&state);
    if(change<0) return input_error("cdp-gun",0);
    failed+=!change || state.ammo!=ammo-1;
    printf("D1_KEYBOARD turn=%d->%d ammo=%d->%d lock=%d\n",original,turned,ammo,state.ammo,state.lock);
    for(i=0;!state.lock && state.heading>0 && state.heading<33 && i<7;i++) {
        change=key_change(c,"a","KeyA",65,0,&state);
        if(change<=0) break;
    }
    if(!state.lock) failed++;
    else {
        change=key_change(c,"m","KeyM",77,2,&state);
        if(change<0) return input_error("cdp-missile",0);
        failed+=!change || state.missiles!=missiles-1;
    }
    printf("D1_KEYBOARD missile=%d->%d\n",missiles,state.missiles);
    sy_sleep_ms(1150);
    if(!read_flight(c,&state)) return input_error("cdp-frame-stats",0);
    failed+=state.frames<13 || state.elapsed<600 || state.gap<33000;
    printf("D1_PLAY\tframes=%d elapsed_ms=%d fps_milli=%d minimum_frame_us=%d lock_fps=30 failed=%d\n",
        state.frames,state.elapsed,state.elapsed?1000000*(state.frames-2)/state.elapsed:0,state.gap,failed);
    return !!failed;
}

static int check_pages_keyboard(int mutate) {
    ChromeInput c={0};
    sy_spawn_t launch;
    sy_exit_t ended;
    char cwd[1024],url[1260],profile[128],option[160];
    char *argv[]={"sh","-c","exec google-chrome \"$@\" 3<&0 4>&1 1>/dev/null","chrome-pipe",
        "--headless=new","--disable-background-networking","--no-first-run","--allow-file-access-from-files",
        "--remote-debugging-pipe","--window-size=1280,807",option,"about:blank",0};
    int rc,n;
    if(!getcwd(cwd,sizeof cwd)) return input_error("cdp-cwd",0);
    n=tx_snprintf(url,sizeof url,"file://%s/docs/uxe/fly-next/index.html?input-test=1%s",cwd,mutate?"&wrong-key":"");
    if(n<0 || n>=(int)sizeof url) return input_error("cdp-url",0);
    tx_snprintf(profile,sizeof profile,"/tmp/chrome-d1-keyboard-%d",(int)getpid());
    tx_snprintf(option,sizeof option,"--user-data-dir=%s",profile);
    sy_spawn_init(&launch);
    launch.argv=argv; launch.in_fd=SY_STDIO_PIPE; launch.out_fd=SY_STDIO_PIPE;
    launch.err_fd=SY_STDIO_NULL; launch.pgroup=-1; launch.deadline_ms=23000;
    rc=sy_proc_spawn(&launch,&c.child);
    if(rc) return input_error("cdp-spawn",0);
    c.deadline=sy_now_ms()+22500;
    rc=exercise_keyboard(&c,url);
    sy_close(c.child.in_fd);
    sy_close(c.child.out_fd);
    sy_proc_kill(&c.child,9);
    sy_proc_wait(&c.child,&ended);
    chd_wipe(profile);
    return rc;
}

int main(int argc,char **argv) {
    int rc;
    if(argc==1) {
        rc=check_airframe("");
        return rc?rc:check_world("");
    }
    if(argc==2 && !strcmp(argv[1],"pages")) {
        rc=check_terrain("",1);
        return rc?rc:check_combat("",1);
    }
    if(argc==2 && !strcmp(argv[1],"pages-auto")) return check_pages_auto(0);
    if(argc==2 && !strcmp(argv[1],"pages-live")) return check_pages_auto(1);
    if(argc==2 && !strcmp(argv[1],"pages-input")) return check_pages_keyboard(0);
    if(argc==2 && !strcmp(argv[1],"pages-wrong-key")) return check_pages_keyboard(1);
    if(argc==2 && !strcmp(argv[1],"terrain")) return check_terrain("",0);
    if(argc==2 && (!strcmp(argv[1],"wrong-seed") || !strcmp(argv[1],"wrong-bands") || !strcmp(argv[1],"muted-palette")))
        return check_terrain(argv[1],0);
    if(argc==2 && !strcmp(argv[1],"combat")) return check_combat("",0);
    if(argc==2 && !strcmp(argv[1],"effects")) return check_effects("");
    if(argc==2 && !strcmp(argv[1],"attitude")) return check_attitude("");
    if(argc==2 && !strcmp(argv[1],"detail")) return check_detail("");
    if(argc==2 && !strcmp(argv[1],"viewport")) return check_viewport("");
    if(argc==2 && !strcmp(argv[1],"short-canvas")) return check_viewport(argv[1]);
    if(argc==2 && (!strcmp(argv[1],"coarse-relief") || !strcmp(argv[1],"bare-ground") ||
        !strcmp(argv[1],"still-waves"))) return check_detail(argv[1]);
    if(argc==2 && (!strcmp(argv[1],"shallow-roll") || !strcmp(argv[1],"flat-pitch") ||
        !strcmp(argv[1],"straight-trail"))) return check_attitude(argv[1]);
    if(argc==2 && (!strcmp(argv[1],"no-fall") || !strcmp(argv[1],"no-plume") ||
        !strcmp(argv[1],"no-hit-smoke"))) return check_effects(argv[1]);
    if(argc==2 && (!strcmp(argv[1],"freeze-targets") || !strcmp(argv[1],"no-lock"))) return check_combat(argv[1],0);
    if(argc==2 && !strcmp(argv[1],"world")) return check_world("");
    if(argc==2 && (!strcmp(argv[1],"frozen-position") || !strcmp(argv[1],"frozen-hud")))
        return check_world(argv[1]);
    if(argc==2 && (!strcmp(argv[1],"reverse") || !strcmp(argv[1],"offset") ||
        !strcmp(argv[1],"short-wings") || !strcmp(argv[1],"no-tails") || !strcmp(argv[1],"frozen-pitch")))
        return check_airframe(argv[1]);
    return input_error("arguments",0);
}
