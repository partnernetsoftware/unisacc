#pragma unisa use chrome_dom
#pragma unisa use text.fmt
#pragma unisa use text.text
#pragma unisa use text.codec
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.time
#pragma unisa use mem.heap

typedef struct { int r,g,b; } Color;
typedef struct { int row,h,lo,hi,paint; } Span;
typedef struct { int x,y,want; } Probe;
static int offsets[13][2], groups[4], span_count, paint_count;
static Color palette[17];
static unsigned char grid[13][46][34];
static Span spans[13*46*34];
static Probe probes[48];
static Probe pitch_probes[24];

static int load_facts(void) {
    size_t size=0;
    char *data=cx_read("ujs/practice/uxe/test/d1-airframe.tsv",&size), *line;
    int count=0, ok=1, h,row,col;
    if(!data) return 0;
    for(line=strtok(data,"\n");line && ok;line=strtok(0,"\n")) {
        int a,b,c,d,e,f,g,i;
        if(line[0]=='#') continue;
        if(sscanf(line,"layer %d %d %d",&a,&b,&c)==3 && a==count && count<13) {
            offsets[count][0]=b; offsets[count++][1]=c;
        } else if(sscanf(line,"paint %d %d %d %d",&a,&b,&c,&d)==4 && a==paint_count+1 && a<=16) {
            palette[++paint_count]=(Color){b,c,d};
        } else if(sscanf(line,"part %d %d %d %d %d %d %d %d",&a,&b,&c,&d,&e,&f,&g,&i)==8 &&
            a>=0 && b>=a && b<13 && c>=0 && d>=c && d<46 && i>=1 && i<=paint_count) {
            for(row=c;row<=d;row++) {
                int width=f+(row-c)*g;
                if(width<1 || e-width<0 || e+width>34) { ok=0; break; }
                for(h=a;h<=b;h++) for(col=e-width;col<e+width;col++) grid[h][row][col]=i;
            }
        } else ok=0;
    }
    free(data);
    if(!ok || count!=13 || paint_count<8) return 0;
    for(h=0;h<13;h++) for(row=0;row<46;row++) {
        int start=0;
        while(start<34) {
            int end=start+1, paint=grid[h][row][start];
            while(end<34 && grid[h][row][end]==paint) end++;
            if(paint) spans[span_count++]=(Span){row,h,start-17,end-17,paint};
            start=end;
        }
    }
    palette[0]=(Color){17,28,48};
    return span_count>0;
}

static int slab(double origin,double direction,double low,double high,double *enter,double *leave) {
    double a,b;
    if(direction==0) return origin>=low && origin<=high;
    a=(low-origin)/direction;
    b=(high-origin)/direction;
    if(a>b) { double t=a; a=b; b=t; }
    if(a>*enter) *enter=a;
    if(b<*leave) *leave=b;
    return *enter<=*leave;
}

/* Intersect the pixel ray with each contiguous run of like-colored unit cubes. */
static int nearest(double px,double py,int mode,int *hits) {
    double right=(px-213)/240, down=(py-120)/240;
    double vy=-.6-.8*down,vz=-.8+.6*down,best=300,ey=48,ez=64;
    int result=-1,i,last_layer=-1;
    if(mode==3) {
        /* Rotate the eye and ray toward the lattice by minus 18 degrees. */
        double cp=.951056516295,sp=.309016994375,old_vy=vy;
        ey=48*cp+64*sp; ez=64*cp-48*sp;
        vy=old_vy*cp+vz*sp; vz=vz*cp-old_vy*sp;
    }
    *hits=0;
    for(i=0;i<span_count;i++) {
        Span span=spans[i];
        int h=span.h, row=span.row, dz=offsets[h][1];
        int y=(mode==1?12-h:h)-6, x=offsets[h][0]+(mode==2 && h>=7?3:0);
        double enter=.1,leave=300;
        if(!slab(ey,vy,y-.5,y+.5,&enter,&leave) ||
           !slab(ez,vz,row-23+dz,row-22+dz,&enter,&leave) ||
           !slab(0,right,x+span.lo,x+span.hi,&enter,&leave)) continue;
        if(h!=last_layer) { (*hits)++; last_layer=h; }
        if(enter<best) { best=enter; result=span.paint; }
    }
    return result;
}

static int stable(int x,int y,int want,int mode) {
    int dx,dy,hits;
    for(dx=-1;dx<=1;dx+=2) for(dy=-1;dy<=1;dy+=2)
        if(nearest(x+.5+dx*.06,y+.5+dy*.06,mode,&hits)!=want) return 0;
    return 1;
}

static int choose_probes(void) {
    int x,y,n=0;
    for(y=58;y<204;y+=4) for(x=143;x<284;x+=4) {
        int hit,unused,want=nearest(x+.5,y+.5,0,&hit), group;
        if(want<0) group=0;
        else if(nearest(x+.5,y+.5,2,&unused)!=want) group=1;
        else if(hit>=2 && nearest(x+.5,y+.5,1,&unused)!=want) group=2;
        else group=3;
        if(groups[group]>=12 || !stable(x,y,want,0)) continue;
        groups[group]++;
        probes[n++]=(Probe){x,y,want};
    }
    return n;
}

static int choose_pitch(void) {
    int x,y,n=0,counts[2]={0};
    for(y=60;y<193;y+=3) for(x=168;x<261;x+=3) {
        int hit,want=nearest(x+.5,y+.5,3,&hit), zone=y>=119;
        if(counts[zone]>=12 || nearest(x+.5,y+.5,0,&hit)==want || !stable(x,y,want,3)) continue;
        counts[zone]++;
        pitch_probes[n++]=(Probe){x,y,want};
    }
    return n;
}

static int number(const char **p) {
    int n=0,negative=**p=='-';
    if(negative) (*p)++;
    if(**p<'0' || **p>'9') return -1000;
    while(**p>='0' && **p<='9') {
        n=n*10+**p-'0';
        *p=*p+1;
        if(n>999) return -1000;
    }
    return negative?-n:n;
}

static int flight(const char **p,int *settled,int *pitch_settled) {
    int replay,i,heading,bank,pitch,altitude,fail=0;
    for(replay=0;replay<2;replay++) {
        if(**p!='|') return -1;
        *p=*p+1;
        heading=0; bank=0; pitch=0; altitude=25; *settled=0; *pitch_settled=0;
        for(i=0;i<23;i++) {
            int axis=i<7?1:i>=14 && i<17?-1:0, desired=axis*24;
            int got_heading=number(p),got_bank,got_pitch,got_altitude;
            if(got_heading<0 || **p!=',') return -1;
            *p=*p+1;
            got_bank=number(p);
            if(got_bank<-24 || got_bank>24 || **p!=',') return -1;
            *p=*p+1; got_pitch=number(p);
            if(got_pitch<-18 || got_pitch>18 || **p!=',') return -1;
            *p=*p+1; got_altitude=number(p);
            if(got_altitude<12 || got_altitude>106) return -1;
            if(i<22) {
                if(**p!=';') return -1;
                *p=*p+1;
            }
            heading=(heading+axis*3+360)%360;
            if(bank<desired) bank+=4;
            else if(bank>desired) bank-=4;
            if(pitch<axis*18) pitch+=3;
            else if(pitch>axis*18) pitch-=3;
            altitude+=axis;
            fail+=heading!=got_heading || bank!=got_bank || pitch!=got_pitch || altitude!=got_altitude;
            if(i>=7 && i<14 && !got_bank && !*settled) *settled=i-6;
            if(i>=7 && i<14 && !got_pitch && !*pitch_settled) *pitch_settled=i-6;
        }
        fail+=!*settled || *settled>6;
        fail+=!*pitch_settled || *pitch_settled>6;
    }
    return fail;
}

static int silhouette(const char **p) {
    int expected[17]={0},actual[17]={0}, min_x[2]={999,999},max_x[2]={0,0};
    int x,y,k,failed=0;
    if(**p!='|') return -1;
    *p=*p+1;
    for(y=44;y<=211;y+=3) for(x=145;x<=280;x+=3) {
        int hits,want=nearest(x+.5,y+.5,0,&hits),r=number(p),g,b,got;
        if(r<0 || **p!=',') return -1;
        *p=*p+1; g=number(p);
        if(g<0 || **p!=',') return -1;
        *p=*p+1; b=number(p);
        if(b<0) return -1;
        if(y+3<=211 || x+3<=280) {
            if(**p!=',') return -1;
            *p=*p+1;
        }
        want=want<0?0:want;
        for(got=0;got<=paint_count;got++)
            if(palette[got].r==r && palette[got].g==g && palette[got].b==b) break;
        expected[want]++;
        if(got>paint_count) failed++;
        else actual[got]++;
        if(want==4) { if(x<min_x[0]) min_x[0]=x; if(x>max_x[0]) max_x[0]=x; }
        if(got==4) { if(x<min_x[1]) min_x[1]=x; if(x>max_x[1]) max_x[1]=x; }
    }
    for(k=1;k<=paint_count;k++) failed+=abs(expected[k]-actual[k])>2+expected[k]/20;
    failed+=expected[4]<10 || expected[5]<8 || expected[6]<1;
    failed+=abs((max_x[1]-min_x[1])-(max_x[0]-min_x[0]))>3;
    printf("D1_SILHOUETTE wing_area=%d/%d tail_accent_area=%d/%d canopy_area=%d/%d wingspan_px=%d/%d failed=%d\n",
        actual[4],expected[4],actual[5],expected[5],actual[6]+actual[7],expected[6]+expected[7],
        max_x[1]-min_x[1],max_x[0]-min_x[0],failed);
    return failed;
}

static int input_error(const char *stage,char *out) {
    printf("D1_FLIGHT_ERROR stage=%s\n",stage);
    free(out);
    return 2;
}

static const char *browser(char *url,char **out,int stage) {
    char profile[128],option[160];
    const char *p, *tag="<output id=\"pixels\">";
    char *args[]={"google-chrome","--headless=new","--use-angle=swiftshader",
        "--enable-unsafe-swiftshader","--disable-background-networking","--allow-file-access-from-files",
        "--window-size=1280,807","--no-first-run","--virtual-time-budget=5000",option,"--dump-dom",url,0};
    size_t size=0;
    int attempt;
    if(stage==8 || stage==9) {
        args[2]="--disable-gpu";
        args[3]="--disable-component-update";
    }
    for(attempt=1;attempt<=2;attempt++) {
        int rc,complete,error;
        tx_snprintf(profile,sizeof profile,"/tmp/chrome-d1-flight-%d-%d-%d",(int)getpid(),stage,attempt);
        tx_snprintf(option,sizeof option,"--user-data-dir=%s",profile);
        rc=cx_runv_timeout(args,attempt==1?12:8,out,&size);
        chd_wipe(profile);
        p=*out?strstr(*out,tag):0;
        if(p) p+=strlen(tag);
        complete=p && *p!='<' && strstr(p,"</output>");
        error=p && !strncmp(p,"ERROR:",6);
        if(!rc && complete && !error) return p;
        printf("D1_FLIGHT_BROWSER stage=%d attempt=%d rc=%d bytes=%d payload=%.100s\n",
            stage,attempt,rc,(int)size,p?p:"missing");
        if(rc || error || attempt==2) return 0;
        free(*out);
        *out=0;
        size=0;
    }
    return 0;
}

static int add_probes(char *url,int capacity,int at,const Probe *set,int n) {
    int i;
    if(at<0 || at>=capacity) return -1;
    for(i=0;i<n;i++) {
        int w=tx_snprintf(url+at,capacity-at,"%s%d,%d",i?";":"",set[i].x,set[i].y);
        if(w<0 || w>=capacity-at) return -1;
        at+=w;
    }
    return at;
}

static int pitch_pixels(const char **p,int n) {
    int i,j,fail=0;
    if(**p!='|') return -1;
    *p=*p+1;
    for(i=0;i<n;i++) {
        int paint=pitch_probes[i].want,got[3];
        Color color=palette[paint<0?0:paint];
        for(j=0;j<3;j++) {
            got[j]=number(p);
            if(got[j]<0 || got[j]>255) return -1;
            if(j<2 || i<n-1) {
                if(**p!=(j<2?',':';')) return -1;
                *p=*p+1;
            }
        }
        fail+=got[0]!=color.r || got[1]!=color.g || got[2]!=color.b;
    }
    return fail;
}

static int check_airframe(const char *mutation) {
    char cwd[1024],url[2200],*out=0;
    const char *p;
    int n,tilt_n,i,j,k,at,pixel_fail=0,scale_fail=0,flight_fail,settled,shape_fail,tilt_fail,pitch_settled;
    if(!load_facts() || !getcwd(cwd,sizeof cwd)) return input_error("airframe-facts",0);
    n=choose_probes();
    tilt_n=choose_pitch();
    if(n<8 || tilt_n!=24 || groups[0]<2 || groups[1]<2 || groups[2]<2) return input_error("airframe-probes",0);
    at=tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/d1-flight.html?%s&probe=",cwd,mutation);
    at=add_probes(url,sizeof url,at,probes,n);
    if(at<0 || at+7>=(int)sizeof url) return input_error("airframe-url",0);
    at+=tx_snprintf(url+at,sizeof url-at,"&pitch=");
    if(add_probes(url,sizeof url,at,pitch_probes,tilt_n)<0) return input_error("pitch-url",0);
    p=browser(url,&out,1);
    if(!p) return input_error("airframe-browser",out);
    for(i=0;i<n;i++) {
        Color color=palette[probes[i].want<0?0:probes[i].want];
        int expected[]={color.r,color.g,color.b,255}, first[4];
        for(j=0;j<9;j++) for(k=0;k<4;k++) {
            int got=number(&p);
            if(got<0 || got>255 || ((j!=8 || k!=3) && *p++!=',')) return input_error("airframe-rgba",out);
            if(!j) { first[k]=got; pixel_fail+=got!=expected[k]; }
            else scale_fail+=got!=first[k];
        }
        if(i<n-1 && *p++!=';') return input_error("airframe-block",out);
    }
    shape_fail=silhouette(&p);
    if(shape_fail<0) return input_error("airframe-silhouette",out);
    tilt_fail=pitch_pixels(&p,tilt_n);
    if(tilt_fail<0) return input_error("pitch-rgb",out);
    flight_fail=flight(&p,&settled,&pitch_settled);
    if(flight_fail<0 || strncmp(p,"</output>",9)) return input_error("airframe-replay",out);
    free(out);
    printf("CHECK_UXE_D1_FLIGHT\tprobes=%d background=%d offset=%d occlusion=%d pixel_fail=%d scale_fail=%d replay_frames=46 flight_fail=%d release_frames=%d\n",
        n,groups[0],groups[1],groups[2],pixel_fail,scale_fail,flight_fail,settled);
    printf("D1_PITCH probes=%d pixel_fail=%d release_frames=%d\n",tilt_n,tilt_fail,pitch_settled);
    return pixel_fail || scale_fail || flight_fail || shape_fail || tilt_fail;
}

static double root(double square) {
    double estimate=square;
    int i;
    for(i=0;i<12;i++) estimate=(estimate+square/estimate)*.5;
    return estimate;
}

static int center(double x,double y,double z,double travel,int *px,int *py) {
    /* Unit right/up/forward from the chase eye to the point ahead of the jet. */
    double ex=-37.1830338545, ez=59.3078577709;
    double fx=-ex, fy=-32, fz=-13-ez;
    double horizontal=root(fx*fx+fz*fz), length=root(horizontal*horizontal+fy*fy);
    double rx=-fz/horizontal, rz=fx/horizontal, depth, up;
    x-=ex; y-=34; z-=ez+travel;
    depth=(fx*x+fy*y+fz*z)/length;
    if(depth<=0) return 0;
    up=(-rz*fy*x+horizontal*y+rx*fy*z)/length;
    *px=(int)(213+240*(rx*x+rz*z)/depth);
    *py=(int)(120-240*up/depth);
    return *px>=4 && *px<422 && *py>=4 && *py<236;
}

static int csv(const char **p) {
    int n=number(p);
    if(n<0 || **p!=',') return -1;
    *p=*p+1;
    return n;
}

static int check_world(const char *mutation) {
    const int islands[3][3]={{-60,-102,24},{61,-134,28},{-5,-192,31}};
    int px[2][3],py[2][3],seed=7,travel=-12,speed=12,i,j,k;
    int speeds[2]={60,0},world_fail=0,hud_fail=0,at;
    char cwd[1024],url[2200],*out=0;
    const char *p;
    if(!getcwd(cwd,sizeof cwd)) return input_error("world-cwd",0);
    at=tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/d1-flight.html?%s&world=",cwd,mutation);
    if(at<0 || at>=(int)sizeof url) return input_error("world-url",0);
    for(j=0;j<2;j++) {
        seed=7;
        for(i=0;i<3;i++) {
            int x,z,w;
            seed=(seed*73+41)%251; x=islands[i][0]+seed%13-6;
            seed=(seed*73+41)%251; z=islands[i][1]+seed%17-8;
            if(!center(x,-23.92+.25*islands[i][2],z,travel/8.0,&px[j][i],&py[j][i]))
                return input_error("world-projection",0);
            w=tx_snprintf(url+at,sizeof url-at,"%s%d,%d",i?";":j?"%7C":"",px[j][i],py[j][i]);
            if(w<0 || w>=(int)sizeof url-at) return input_error("world-url",0);
            at+=w;
        }
        if(j==0) {
            for(k=0;k<27;k++) {
                if(speed<28) speed+=2;
                travel-=speed;
            }
            speeds[1]=speed*5;
        }
    }
    p=browser(url,&out,2);
    if(!p) return input_error("world-browser",out);
    for(j=0;j<2;j++) {
        int hud_speed=csv(&p), hud_alt=csv(&p);
        if(hud_speed<0 || hud_alt<0) return input_error("world-hud-payload",out);
        hud_fail+=hud_speed!=speeds[j] || hud_alt!=100;
        for(i=0;i<3;i++) {
            int sumx=0,sumy=0,count=0;
            for(k=0;k<81;k++) {
                int r=csv(&p),g=csv(&p),b=number(&p);
                if(r<0 || g<0 || b<0 || r>255 || g>255 || b>255)
                    return input_error("world-rgb",out);
                if(i<2 || k<80) {
                    if(*p++!=',') return input_error("world-rgb-delimiter",out);
                }
                if(g>=164 && g>=r+22 && g>=b+45) {
                    sumx+=k%9-4; sumy+=k/9-4; count++;
                }
            }
            world_fail+=count<2 || abs(sumx)>2*count || abs(sumy)>2*count;
            printf("D1_ISLAND frame=%d island=%d expected=%d,%d samples=%d error=%d,%d\n",
                j?28:1,i,px[j][i],py[j][i],count,count?sumx/count:0,count?sumy/count:0);
        }
        if(j==0 && *p++!='|') return input_error("world-frame-delimiter",out);
        printf("D1_HUD frame=%d speed=%d expected=%d altitude=%d\n",j?28:1,hud_speed,speeds[j],hud_alt);
    }
    if(strncmp(p,"</output>",9)) return input_error("world-trailer",out);
    free(out);
    printf("D1_WORLD\ttravel_eighths=%d island_fail=%d hud_fail=%d\n",travel,world_fail,hud_fail);
    return world_fail || hud_fail;
}

static int check_pages_auto(int live) {
    const char *finals[]={"D1_FLY_NEXT_READY","D1_FLY_NEXT_ERROR"};
    char cwd[1024],url[1500];
    int retry,rc;
    if(live) tx_snprintf(url,sizeof url,"https://partnernetsoftware.github.io/unisacc/uxe/fly-next/?auto=1");
    else {
        if(!getcwd(cwd,sizeof cwd)) return input_error("pages-auto-cwd",0);
        tx_snprintf(url,sizeof url,"file://%s/docs/uxe/fly-next/index.html?auto=1",cwd);
    }
    rc=chd_dump_expect("/usr/bin/google-chrome",url,finals[0],finals,2,"",2,15,&retry);
    printf("D1_PAGES_AUTO live=%d expected=%s rc=%d retries=%d\n",live,finals[0],rc,retry);
    return rc;
}

static unsigned field_hash(int x,int y,int seed) {
    unsigned n=(unsigned)(x+17)*374761393u ^ (unsigned)(y+29)*668265263u ^ (unsigned)seed*1442695041u;
    n=(n^(n>>13))*1274126177u;
    return (n^(n>>16))&255;
}

static int field_noise(int x,int y,int spacing,int seed) {
    int u=x/spacing,v=y/spacing,a=x%spacing,b=y%spacing,mask=256/spacing-1;
    int q0=field_hash(u,v,seed),q1=field_hash((u+1)&mask,v,seed);
    int q2=field_hash(u,(v+1)&mask,seed),q3=field_hash((u+1)&mask,(v+1)&mask,seed);
    return (q0*(spacing-a)*(spacing-b)+q1*a*(spacing-b)+q2*(spacing-a)*b+q3*a*b)/(spacing*spacing);
}

static int down_ratio(int numerator,int denominator) {
    return (numerator<0?numerator-denominator+1:numerator)/denominator;
}

static int terrain_height_mode(int x,int y,int seed,int shelf) {
    static const int islands[][5]={{100,106,34,28,113},{163,96,22,18,97},{130,67,12,13,84},
        {72,56,16,15,100},{187,52,17,13,102},{104,25,16,14,98},{150,20,15,13,103},{215,19,19,13,104}};
    int i,peak=-49;
    for(i=0;i<8;i++) {
        const int *a=islands[i];
        int dx=abs(a[0]-x),dy=abs(a[1]-y),ground;
        if(dx>128) dx=256-dx;
        if(dy>128) dy=256-dy;
        ground=a[4]-116*dx*dx/(a[2]*a[2])-116*dy*dy/(a[3]*a[3]);
        if(ground>peak) peak=ground;
    }
    if(shelf) {
        static const int rims[][6]={{24,129,54,113,20,27},{54,113,79,104,22,42},
            {79,104,106,92,22,50},{106,92,114,73,14,28},{35,124,37,98,15,27},
            {63,116,68,133,11,28},{89,103,103,129,13,30}};
        double lx=(x-59)/10.5,ly=(y-111)/8.2,lagoon=lx*lx+ly*ly;
        int height=-49;
        for(i=0;i<7;i++) {
            const int *a=rims[i];
            int dx=a[2]-a[0],dy=a[3]-a[1],r=a[4],h=a[5];
            double t=((x-a[0])*dx+(y-a[1])*dy)/(double)(dx*dx+dy*dy);
            if(t<0) t=0;
            if(t>1) t=1;
            double off_x=x-a[0]-dx*t,off_y=y-a[1]-dy*t;
            int level=h-(int)((h+19)*(off_x*off_x+off_y*off_y)/(r*r));
            if(level>height) height=level;
        }
        if(lagoon<1) height-=(int)((1-lagoon)*65);
        if(height>peak) peak=height;
    }
    return peak+down_ratio(45*(field_noise(x,y,64,seed)-128),100)
        +down_ratio(field_noise(x,y,16,seed+3)-128,4)
        +down_ratio(7*(field_noise(x,y,2,seed+5)-128),100);
}

static int terrain_height(int x,int y,int seed) {
    return terrain_height_mode(x,y,seed,0);
}

static int terrain_band(int x,int y,int seed,int shelf) {
    static const int stops[]={-25,-8,0,8,28,55,101};
    int i,elevation=terrain_height_mode(x,y,seed,shelf);
    for(i=0;i<7 && elevation>=stops[i];i++) {}
    return i;
}

static int take_channel(const char **p,int end) {
    int value=number(p);
    if(value<0 || value>255 || (end && **p!=end)) return -1;
    if(end) *p=*p+1;
    return value;
}

static int far_islands(int shelf) {
    unsigned char land[64*20];
    int queue[64*20],x,y,i,count=0;
    for(y=0;y<20;y++) for(x=0;x<64;x++) land[64*y+x]=terrain_height_mode(x*4+2,y*4+2,7,shelf)>=0;
    for(i=0;i<64*20;i++) if(land[i]) {
        int next=0,end=1,clipped=0,inside=0;
        queue[0]=i; land[i]=0;
        while(next<end) {
            int at=queue[next++],col=at%64,row=at/64,j;
            int near[4]={at-1,at+1,at-64,at+64};
            if(col==0 || col==63 || row==0 || row==19) clipped=1;
            inside+=abs(4*col+2-128)*151 < (127-(4*row+2))*213;
            for(j=0;j<4;j++) {
                int adjacent=near[j];
                if((j==0 && col==0) || (j==1 && col==63) || adjacent<0 || adjacent>=64*20 || !land[adjacent]) continue;
                land[adjacent]=0;
                queue[end++]=adjacent;
            }
        }
        count+=!clipped && inside>=5;
    }
    return count;
}

static int projected_land_ratio(int shelf) {
    int x,y,ground=0,water=0;
    for(y=123;y<240;y+=8) for(x=1;x<426;x+=8) {
        int depth;
        for(depth=4;depth<=400;depth+=4) {
            int gx=(int)((256+(x+.5-213)*depth/151)/2)&255;
            int gy=(int)((254.5-depth)/2)&255;
            int altitude=terrain_height_mode(gx,gy,7,shelf);
            double top=100+(45-(altitude>0?altitude*.22:0))*151/depth;
            if(y+1<top) continue;
            ground+=altitude>=0;
            water+=altitude<0;
            break;
        }
    }
    return ground+water?ground*100/(ground+water):0;
}

static int check_terrain(const char *mutation,int published) {
    static const int palette[][3]={{19,67,128},{30,111,165},{45,158,190},{231,204,134},
        {133,183,71},{89,153,59},{60,115,61},{119,111,121}};
    char cwd[1024],url[2300],*out=0;
    const char *p;
    int x,y,at,n=0,i,j,failed=0,green=0,land=0,sea=0,foam=0,counts[8]={0},want[32];
    if(!getcwd(cwd,sizeof cwd)) return input_error("terrain-cwd",0);
    at=tx_snprintf(url,sizeof url,"file://%s/%s?%s&terrain=",cwd,published?
        "docs/uxe/fly-next/index.html":"ujs/practice/uxe/test/d1-pixel-a.html",mutation);
    if(at<0 || at>=(int)sizeof url) return input_error("terrain-url",0);
    for(y=1;y<256;y+=3) for(x=1;x<256;x+=3) {
        int kind=terrain_band(x,y,7,published),size;
        if(counts[kind]>=4 || terrain_band(x,y,31,published)==kind) continue;
        size=tx_snprintf(url+at,sizeof url-at,"%s%d,%d",n?";":"",x,y);
        if(size<0 || size>=(int)sizeof url-at) return input_error("terrain-url",0);
        at+=size;
        counts[kind]++;
        want[n++]=kind;
    }
    for(i=0;i<8;i++) if(counts[i]<3) return input_error("terrain-probe-coverage",0);
    p=browser(url,&out,3);
    if(!p) return input_error("terrain-browser",out);
    for(i=0;i<n;i++) {
        int wrong=0;
        for(j=0;j<3;j++) {
            int next=i==n-1 && j==2?'|':',';
            int value=take_channel(&p,next);
            if(value<0) return input_error("terrain-swatch",out);
            wrong+=value!=palette[want[i]][j];
        }
        failed+=wrong>0;
    }
    for(i=0;i<30*107;i++) {
        int r=take_channel(&p,','),g=take_channel(&p,','),b=take_channel(&p,i+1<30*107?',':0);
        if(r<0 || g<0 || b<0) return input_error("terrain-frame",out);
        if(g>r+15 && g>b+8) { green++; land++; }
        else if((r>=g+14 && g>=b+23) || (r>=75 && r<155 && abs(r-g)<=11 && abs(g-b)<=12)) land++;
        if(b>r+20 && b>g) sea++;
        if(g>=175 && r>=110 && b>=g-15 && b<=g+30) foam++;
    }
    if(strncmp(p,"</output>",9)) return input_error("terrain-trailer",out);
    free(out);
    printf("D1_TERRAIN swatches=%d band_errors=%d land=%d/3210 green=%d water=%d foam=%d\n",
        n,failed,land,green,sea,foam);
    {
        int islands=far_islands(published),expected=projected_land_ratio(published),observed=land+sea?land*100/(land+sea):0;
        printf("D1_ARCHIPELAGO seed_far_islands=%d land_expected_pct=%d land_actual_pct=%d sea_actual_pct=%d\n",
            islands,expected,observed,100-observed);
        failed+=islands<5 || expected<25 || expected>70 || abs(expected-observed)>15;
    }
    return failed || land<550 || green<350 || sea<320 || foam<20;
}

static void enemy_point(int tick,int index,int published,int *px,int *py) {
    static const int enemies[3][4]={{-49,-116,55,1},{4,-91,45,0},{53,-135,50,-1}};
    static const int layered[3][4]={{-25,-53,53,1},{4,-91,45,0},{94,-208,71,-1}};
    const int *e=published?layered[index]:enemies[index];
    double forward=-e[1]+tick/3-1.5*tick;
    *px=(int)(213.5+151*(e[0]+(tick%72/6)*e[3])/forward);
    *py=(int)(113.5+151*(38-e[2])/forward);
}

static int check_combat(const char *mutation,int published) {
    static const int colors[][3]={{255,116,106},{255,228,107},{255,235,134},{247,121,61},
        {35,52,77},{232,234,219}};
    char cwd[1024],url[2100],*out=0;
    const char *p;
    int frame,i,j,at,marker_fail=0,lock_fail=0,hit_fail=0,ammo_fail=0;
    int locations[2][6][2],types[2][6]={{0,0,0,1,1,5},{0,0,2,3,4,6}};
    if(!getcwd(cwd,sizeof cwd)) return input_error("combat-cwd",0);
    for(i=0;i<3;i++) {
        enemy_point(1,i,published,&locations[0][i][0],&locations[0][i][1]);
        locations[0][i][1]-=8;
    }
    enemy_point(1,1,published,&locations[0][3][0],&locations[0][3][1]);
    locations[0][4][0]=locations[0][3][0]+11;
    locations[0][4][1]=locations[0][3][1]+9;
    locations[0][3][0]-=11;
    locations[0][3][1]-=9;
    enemy_point(18,0,published,&locations[1][0][0],&locations[1][0][1]);
    enemy_point(18,2,published,&locations[1][1][0],&locations[1][1][1]);
    locations[1][0][1]-=8;
    locations[1][1][1]-=8;
    enemy_point(17,1,published,&locations[1][2][0],&locations[1][2][1]);
    locations[1][3][0]=locations[1][2][0]+1;
    locations[1][3][1]=locations[1][2][1]+1;
    locations[1][2][0]-=3;
    locations[1][2][1]-=2;
    enemy_point(18,1,published,&locations[1][4][0],&locations[1][4][1]);
    locations[1][4][1]-=8;
    locations[0][5][0]=locations[1][5][0]=35;
    locations[0][5][1]=locations[1][5][1]=227;
    at=tx_snprintf(url,sizeof url,"file://%s/%s?%s&combat=",cwd,published?
        "docs/uxe/fly-next/index.html":"ujs/practice/uxe/test/d1-pixel-a.html",mutation);
    if(at<0 || at>=(int)sizeof url) return input_error("combat-url",0);
    for(frame=0;frame<2;frame++) {
        for(i=0;i<6;i++) {
            int w=tx_snprintf(url+at,sizeof url-at,"%s%d,%d",i?";":frame?"%7C":"",
                locations[frame][i][0],locations[frame][i][1]);
            if(w<0 || w>=(int)sizeof url-at) return input_error("combat-url",0);
            at+=w;
        }
    }
    p=browser(url,&out,4);
    if(!p) return input_error("combat-browser",out);
    for(frame=0;frame<2;frame++) for(i=0;i<6;i++) {
        int observed[3],match[6]={1,1,1,1,1,1},kind=types[frame][i];
        for(j=0;j<3;j++) {
            int end=j!=2 || i<5?',':frame==0?'|':0,k;
            observed[j]=take_channel(&p,end);
            if(observed[j]<0) return input_error("combat-pixel",out);
            for(k=0;k<6;k++) match[k]&=observed[j]==colors[k][j];
        }
        if(kind==0) marker_fail+=!match[0];
        else if(kind==1) lock_fail+=!match[1];
        else if(kind==4) hit_fail+=match[0];
        else if(kind>=5) ammo_fail+=!match[kind-1];
        else {
            hit_fail+=!match[2] && !match[3];
            printf("D1_IMPACT xy=%d,%d rgb=%d,%d,%d\n",locations[frame][i][0],locations[frame][i][1],
                observed[0],observed[1],observed[2]);
        }
    }
    if(strncmp(p,"</output>",9)) return input_error("combat-trailer",out);
    free(out);
    printf("D1_COMBAT markers=5 marker_fail=%d lock_fail=%d impact_fail=%d ammo_fail=%d\n",
        marker_fail,lock_fail,hit_fail,ammo_fail);
    return marker_fail || lock_fail || hit_fail || ammo_fail;
}

static int check_audio(const char *mutation) {
    static const int points[]={2,42,82,202,402,802};
    char cwd[1024],url[1950],wave[16],*out=0,*facts;
    size_t size=0;
    const char *p;
    int engine,slope,start,end,gain,attack,duration,actual[5],i,failed=0;
    facts=cx_read("ujs/practice/uxe/test/d1-audio.tsv",&size);
    if(!facts || !size) return input_error("audio-facts",facts);
    p=strstr(facts,"\nlock\t");
    if(!p || sscanf(facts,"engine %15s %d %d",wave,&engine,&slope)!=3 ||
        sscanf(p," lock %15s %d %d %d %d %d",wave,&start,&end,&gain,&attack,&duration)!=6 ||
        strcmp(wave,"sine") || start!=800 || end!=800) return input_error("audio-facts",facts);
    free(facts);
    if(!getcwd(cwd,sizeof cwd)) return input_error("audio-cwd",0);
    tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/d1-pixel-a.html?freeze-targets&%s&audio=%d,%d,%d,%d,%d,%d",
        cwd,mutation,points[0],points[1],points[2],points[3],points[4],points[5]);
    p=browser(url,&out,9);
    if(!p) return input_error("audio-browser",out);
    for(i=0;i<5;i++) actual[i]=take_channel(&p,',');
    failed=actual[0]!=1 || actual[1]!=1 || actual[2]!=1 || actual[3]!=1 || actual[4]!=engine+28*slope;
    printf("D1_AUDIO_EVENTS gun=%d missile=%d explosion=%d lock=%d engine_hz=%d failed=%d\n",
        actual[0],actual[1],actual[2],actual[3],actual[4],failed);
    for(i=0;i<6;i++) {
        int got,used=0,n=points[i],rise=attack*8,stop=duration*8;
        double envelope=n<rise?(double)n/rise:n<stop?(double)(stop-n)/(stop-rise):0;
        int expected=(int)(.5+gain*10*envelope*.9510565163);
        int bad;
        if(sscanf(p,"%d%n",&got,&used)!=1 || used<=0) return input_error("audio-sample",out);
        p+=used;
        bad=abs(got-expected)>5;
        if(i<5) {
            if(*p!=',') return input_error("audio-sample",out);
            p++;
        }
        printf("D1_AUDIO_PCM n=%d actual=%d expected=%d failed=%d\n",n,got,expected,bad);
        failed+=bad;
    }
    if(strncmp(p,"</output>",9)) return input_error("audio-trailer",out);
    free(out);
    return failed!=0;
}

static void pursuing_left(int tick,int *x,int *y) {
    int phase=(tick-30)%96;
    int sweep=phase<24?phase:phase<72?48-phase:phase-96;
    double depth=114.5+tick/3;
    *x=(int)(213.5+151*(-49+tick%72/6+.65*sweep)/depth);
    *y=(int)(113.5+151*(-17+.18*sweep)/depth);
}

static int check_waves(const char *mutation) {
    static const int rgb[][3]={{35,52,77},{232,234,219},{232,234,219},{35,52,77},
        {35,52,77},{232,234,219},{255,116,106}};
    char cwd[1024],url[1950],*out=0;
    const char *p;
    int i,j,wrong=0;
    int join_x=(int)(213.5+151*(-49+30)/157.0);
    int join_y=(int)(113.5+151*(38-55-3)/157.0)-8;
    if(!getcwd(cwd,sizeof cwd)) return input_error("waves-cwd",0);
    tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/d1-pixel-a.html?%s&waves=1,31,216;35,408,230;52,408,230;53,408,230;88,31,216;89,31,216;89,%d,%d",
        cwd,mutation,join_x,join_y);
    p=browser(url,&out,8);
    if(!p) return input_error("waves-browser",out);
    for(i=0;i<7;i++) {
        int bad=0;
        for(j=0;j<3;j++) bad|=take_channel(&p,i==6 && j==2?0:',')!=rgb[i][j];
        printf("D1_WAVE probe=%d failed=%d\n",i,bad);
        wrong+=bad;
    }
    if(strncmp(p,"</output>",9)) return input_error("waves-trailer",out);
    free(out);
    return wrong!=0;
}

static int check_skirmish(const char *mutation) {
    static const int expected[][3]={{232,234,219},{255,116,106},{226,82,159},
        {121,220,162},{62,75,92},{62,75,92},{121,220,162},{35,52,77}};
    char cwd[1024],url[1950],*out=0;
    int x,y,bolt_x,bolt_y,i,j,failed=0,n=(int)(sizeof expected/sizeof expected[0]);
    const char *p;
    if(!getcwd(cwd,sizeof cwd)) return input_error("skirmish-cwd",0);
    pursuing_left(40,&x,&y);
    bolt_x=(int)(.5+x+(213-x)*15.0/22);
    bolt_y=(int)(.5+y+(158-y)*15.0/22);
    pursuing_left(55,&x,&y);
    tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/d1-pixel-a.html?hold-course&%s&skirmish=18,409,228;55,%d,%d;55,%d,%d;63,376,227;63,380,227;142,352,227;0,380,227;0,409,228",
        cwd,mutation,x,y-8,bolt_x,bolt_y);
    p=browser(url,&out,8);
    if(!p) return input_error("skirmish-browser",out);
    for(i=0;i<n;i++) {
        int got[3],bad=0;
        for(j=0;j<3;j++) {
            got[j]=take_channel(&p,i+1==n && j==2?0:',');
            bad|=got[j]!=expected[i][j];
        }
        printf("D1_SKIRMISH probe=%d rgb=%d,%d,%d failed=%d\n",i,got[0],got[1],got[2],bad);
        failed+=bad;
    }
    if(strncmp(p,"</output>",9)) return input_error("skirmish-trailer",out);
    free(out);
    return failed!=0;
}

static int check_viewport(const char *mutation) {
    char cwd[1024],url[1800],profile[160],option[180],path[160],shot[180],*out=0;
    char *window[]={ "--window-size=1280,807","--window-size=960,1000" };
    char *bottom[]={ "3x1+639+719","3x1+479+912" };
    char *chrome[]={"google-chrome","--headless=new","--disable-background-networking",
        "--allow-file-access-from-files","--no-first-run","--virtual-time-budget=5000",
        option,shot,0,url,0};
    char *crop[]={"convert",path,"-crop",0,"+repage","-depth","8","rgb:-",0};
    size_t size;
    int i,j,failed=0;
    if(!getcwd(cwd,sizeof cwd)) return input_error("viewport-cwd",0);
    tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/d1-pixel-a.html?still=1&%s",cwd,mutation);
    for(i=0;i<2;i++) {
        int rc,background=0;
        tx_snprintf(profile,sizeof profile,"/tmp/chrome-d1-viewport-%d-%d",(int)getpid(),i);
        tx_snprintf(option,sizeof option,"--user-data-dir=%s",profile);
        tx_snprintf(path,sizeof path,"%s/viewport.png",profile);
        tx_snprintf(shot,sizeof shot,"--screenshot=%s",path);
        chrome[8]=window[i];
        crop[3]=bottom[i];
        rc=cx_runv_timeout(chrome,12,&out,&size);
        if(rc) { chd_wipe(profile); return input_error("viewport-chrome",out); }
        free(out); out=0;
        rc=cx_runv_timeout(crop,4,&out,&size);
        chd_wipe(profile);
        if(rc || size!=9) return input_error("viewport-pixels",out);
        for(j=0;j<9;j+=3)
            background+=(unsigned char)out[j]==34 && (unsigned char)out[j+1]==86 && (unsigned char)out[j+2]==117;
        printf("D1_VIEWPORT size=%s background_pixels=%d/3\n",window[i]+14,background);
        failed+=background!=0;
        free(out); out=0;
    }
    return failed!=0;
}

static int detail_material(int r,int g,int b) {
    static const int paint[4][3]={{121,155,65},{103,168,81},{52,104,56},{174,225,231}};
    static const int haze[3]={173,214,234};
    int i,j;
    for(i=0;i<4;i++) for(j=0;j<=16;j++) {
        int red=paint[i][0]+down_ratio((haze[0]-paint[i][0])*j*86+800,1600);
        int green=paint[i][1]+down_ratio((haze[1]-paint[i][1])*j*86+800,1600);
        int blue=paint[i][2]+down_ratio((haze[2]-paint[i][2])*j*86+800,1600);
        if(r==red && g==green && b==blue) return i+1;
    }
    return 0;
}

static int check_detail(const char *mutation) {
    char cwd[1024],url[1800],*out=0;
    const char *p;
    int x,y,n=0,want[8],at,i,phase,furrows=0,trees=0,waves=0,wrong=0;
    unsigned char foam[26*107];
    if(!getcwd(cwd,sizeof cwd)) return input_error("detail-cwd",0);
    at=tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/d1-pixel-a.html?%s&detail=",cwd,mutation);
    for(y=1;y<255 && n<8;y+=9) for(x=1;x<255 && n<8;x+=7) {
        int a=terrain_height(x,y,7),b=terrain_height(x+1,y,7);
        int c=terrain_height(x,y+1,7),d=terrain_height(x+1,y+1,7);
        int fine=down_ratio(9*a+3*b+3*c+d,16)+128;
        if(fine==128+a || fine<0 || fine>255) continue;
        at+=tx_snprintf(url+at,sizeof url-at,"%s%d,%d",n?";":"",4*x+1,4*y+1);
        want[n++]=fine;
    }
    if(n!=8) return input_error("detail-probes",0);
    p=browser(url,&out,7);
    if(!p) return input_error("detail-browser",out);
    for(phase=0;phase<2;phase++) for(i=0;i<26*107;i++) {
        int r=take_channel(&p,','),g=take_channel(&p,','),b=take_channel(&p,','),material;
        if(r<0 || g<0 || b<0) return input_error("detail-pixel",out);
        material=detail_material(r,g,b);
        if(!phase) {
            furrows+=material==1;
            trees+=material==2 || material==3;
            foam[i]=material==4;
        } else waves+=foam[i]!=(material==4);
    }
    for(i=0;i<n;i++) wrong+=take_channel(&p,i+1<n?',':0)!=want[i];
    if(strncmp(p,"</output>",9)) return input_error("detail-trailer",out);
    free(out);
    printf("D1_DETAIL relief_fail=%d furrows=%d crowns=%d wave_changes=%d\n",wrong,furrows,trees,waves);
    return wrong || furrows<5 || trees<5 || waves<5;
}

static int check_attitude(const char *mutation) {
    char cwd[1024],url[1800],*out=0;
    const double radians=52*3.141592653589793/180;
    double squared=radians*radians;
    double c=1-squared*(.5-squared*(1.0/24-squared/720));
    double s=radians*(1-squared*(1.0/6-squared*(1.0/120-squared/5040)));
    int x=(int)(213-34.5*c+.15*s),y=(int)(148-34.5*s-.15*c);
    int trail_x=(int)(213.5-38*c-5*s-17*.68-24*17*17*.004);
    int trail_y=(int)(148.5-38*s+5*c+17);
    int r,g,b,wing,trail;
    const char *p;
    if(!getcwd(cwd,sizeof cwd)) return input_error("attitude-cwd",0);
    tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/d1-pixel-a.html?still=bank&%s&attitude=7,%d,%d;7,%d,%d",
        cwd,mutation,x,y,trail_x,trail_y);
    p=browser(url,&out,6);
    if(!p) return input_error("attitude-browser",out);
    r=take_channel(&p,','); g=take_channel(&p,','); b=take_channel(&p,',');
    wing=r>105 && g>35 && g<150 && b>=0 && b<100;
    printf("D1_ATTITUDE wing=%d rgb=%d,%d,%d\n",wing,r,g,b);
    r=take_channel(&p,','); g=take_channel(&p,','); b=take_channel(&p,0);
    trail=r==148 && g==190 && b==197;
    printf("D1_ATTITUDE trail=%d rgb=%d,%d,%d\n",trail,r,g,b);
    if(strncmp(p,"</output>",9)) return input_error("attitude-trailer",out);
    free(out);
    return !wing || !trail;
}

static int check_effects(const char *mutation) {
    static const int expected[3][3]={{155,162,175},{155,162,175},{121,197,189}};
    char cwd[1024],url[1800],*out=0;
    int x,y,probe,channel,failed=0,missile_x,missile_y;
    const char *p;
    if(!getcwd(cwd,sizeof cwd)) return input_error("effects-cwd",0);
    enemy_point(1,1,0,&x,&y);
    missile_x=(int)(213.5+(x-213)*7.0/13);
    missile_y=(int)(172.5+(y-166)*7.0/13);
    tx_snprintf(url,sizeof url,"file://%s/ujs/practice/uxe/test/d1-pixel-a.html?freeze-targets&%s&effects=3,%d,%d;11,%d,%d;30,%d,%d",
        cwd,mutation,x,y+1,missile_x,missile_y,x+(int)(.5+13*.48),y+(int)(.5+13*13*.12));
    p=browser(url,&out,5);
    if(!p) return input_error("effects-browser",out);
    for(probe=0;probe<3;probe++) {
        int got[3],bad=0;
        for(channel=0;channel<3;channel++) {
            got[channel]=take_channel(&p,probe==2 && channel==2?0:',');
            bad|=got[channel]!=expected[probe][channel];
        }
        printf("D1_EFFECT probe=%d rgb=%d,%d,%d failed=%d\n",probe,got[0],got[1],got[2],bad);
        failed+=bad;
    }
    if(strncmp(p,"</output>",9)) return input_error("effects-trailer",out);
    free(out);
    return failed!=0;
}

typedef struct {
    sy_child_t child;
    int id,at,len;
    long deadline;
    char buffer[4096],reply[131072],session[100];
} ChromeInput;
typedef struct { int heading,ammo,missiles,lock,frames,elapsed,gap; } LiveFlight;
typedef struct { int hp_first,hp_last,ko,loss; } LiveBattle;
typedef struct { int x,z,speed,tick; } LiveWater;
enum { LIVE_FLIGHT,LIVE_BATTLE,LIVE_MUTE,LIVE_WATER,LIVE_WATER_AUTO,LIVE_BRIDGE,LIVE_TOWN,LIVE_COAST,LIVE_WASM,
    LIVE_WATER_WASM,LIVE_WALK_WASM };

static int cdp_message(ChromeInput *c,long deadline) {
    int n=0;
    while(n<(int)sizeof c->reply-1) {
        if(c->at>=c->len) {
            long left=deadline-sy_now_ms();
            if(left<=0 || sy_readable(c->child.out_fd,left)<=0) return 0;
            c->len=(int)sy_read(c->child.out_fd,c->buffer,sizeof c->buffer);
            c->at=0;
            if(c->len<=0) return 0;
        }
        c->reply[n]=c->buffer[c->at++];
        if(!c->reply[n++]) return 1;
    }
    return 0;
}

static int cdp_call(ChromeInput *c,const char *method,const char *params) {
    char payload[2100],session[130];
    long deadline=sy_now_ms()+3000;
    int id=++c->id,n;
    if(deadline>c->deadline) deadline=c->deadline;
    if(deadline<=sy_now_ms()) return 0;
    session[0]=0;
    if(c->session[0]) tx_snprintf(session,sizeof session,",\"sessionId\":\"%s\"",c->session);
    n=tx_snprintf(payload,sizeof payload,"{\"id\":%d,\"method\":\"%s\",\"params\":%s%s}",id,method,params,session);
    if(n<0 || n>=(int)sizeof payload || sy_write_all(c->child.in_fd,payload,n+1)) return 0;
    while(cdp_message(c,deadline)) {
        char *p=strstr(c->reply,"\"id\":");
        if(p && atoi(p+5)==id) return strstr(c->reply,"\"error\":")==0;
    }
    return 0;
}

static int cdp_string(ChromeInput *c,const char *mark,char *out,int cap) {
    const char *p=strstr(c->reply,mark);
    int n=0;
    if(!p) return 0;
    p+=strlen(mark);
    while(p[n] && p[n]!='"' && n+1<cap) { out[n]=p[n]; n++; }
    out[n]=0;
    return p[n]=='"' && n>0;
}

static int keyboard(ChromeInput *c,const char *key,const char *code,int vk,int down) {
    char args[300];
    tx_snprintf(args,sizeof args,"{\"type\":\"%s\",\"key\":\"%s\",\"code\":\"%s\",\"windowsVirtualKeyCode\":%d}",
        down?"rawKeyDown":"keyUp",key,code,vk);
    return cdp_call(c,"Input.dispatchKeyEvent",args);
}

static int read_flight(ChromeInput *c,LiveFlight *state) {
    char text[250];
    if(!cdp_call(c,"Runtime.evaluate","{\"expression\":\"document.title==='D1_FLY_NEXT_READY'?document.querySelector('output').textContent:''\"}") ||
        !cdp_string(c,"\"value\":\"",text,sizeof text)) return 0;
    return sscanf(text,"%d,%d,%d,%d,%d,%d,%d",&state->heading,&state->ammo,&state->missiles,
        &state->lock,&state->frames,&state->elapsed,&state->gap)==7;
}

static int read_battle(ChromeInput *c,LiveBattle *state) {
    char text[180];
    const char *query="{\"expression\":\"(()=>{const q=document.querySelector('canvas').getContext('2d');"
        "const rgb=(x,y)=>{const p=q.getImageData(x,y,1,1).data;return p[0]*65536+p[1]*256+p[2]};"
        "return [rgb(352,229),rgb(383,229),rgb(409,228),Number(!document.querySelector('section').hidden)].join(',')})()\"}";
    if(!cdp_call(c,"Runtime.evaluate",query) || !cdp_string(c,"\"value\":\"",text,sizeof text)) return 0;
    return sscanf(text,"%d,%d,%d,%d",&state->hp_first,&state->hp_last,&state->ko,&state->loss)==4;
}

static int exercise_battle(ChromeInput *c) {
    const int full=0x79dca2,empty=0x3e4b5c,digit=0xe8eadb,panel=0x23344d;
    LiveBattle b={0};
    LiveFlight f={0};
    int i,drop=0,kill=0,restarted=0;
    long end=sy_now_ms()+9000;
    for(i=0;i<100 && sy_now_ms()<end;i++) {
        if(!read_battle(c,&b)) return input_error("cdp-battle-hud",0);
        kill|=b.ko==digit;
        drop|=b.hp_first!=empty && b.hp_last==empty;
        if(b.loss) break;
        sy_sleep_ms(90);
    }
    printf("D1_BATTLE hp_drop=%d ko_increase=%d loss=%d hp_empty=%d\n",
        drop,kill,b.loss,b.hp_first==empty && b.hp_last==empty);
    if(!drop || !kill || !b.loss || b.hp_first!=empty || b.hp_last!=empty) return 1;
    if(!keyboard(c,"r","KeyR",82,1) || !keyboard(c,"r","KeyR",82,0)) return input_error("cdp-restart-key",0);
    end=sy_now_ms()+1800;
    for(i=0;i<40 && sy_now_ms()<end;i++) {
        if(!read_battle(c,&b)) return input_error("cdp-restart-hud",0);
        if(!b.loss && b.hp_first==full && b.hp_last==full && b.ko==panel && read_flight(c,&f) &&
            f.heading==0 && f.ammo==96 && f.missiles==3) { restarted=1; break; }
        sy_sleep_ms(45);
    }
    printf("D1_RESTART key=R restored=%d loss=%d hp=%06x/%06x ko_pixel=%06x ammo=%d missiles=%d\n",
        restarted,b.loss,b.hp_first,b.hp_last,b.ko,f.ammo,f.missiles);
    return !restarted;
}

typedef struct { int gun, missile, explosion, lock; } LiveAudio;

static int read_audio_events(ChromeInput *c, LiveAudio *audio) {
    char text[80];
    return cdp_call(c,"Runtime.evaluate","{\"expression\":\"document.querySelector('output').dataset.audio||''\"}") &&
        cdp_string(c,"\"value\":\"",text,sizeof text) &&
        sscanf(text,"%d,%d,%d,%d",&audio->gun,&audio->missile,&audio->explosion,&audio->lock)==4;
}

static int key_change(ChromeInput *c,const char *key,const char *code,int vk,int field,LiveFlight *state) {
    int old=field==0?state->heading:field==1?state->ammo:state->missiles;
    int changed=0;
    long end=sy_now_ms()+700;
    if(!keyboard(c,key,code,vk,1)) return -1;
    while(!changed && sy_now_ms()<end) {
        if(read_flight(c,state)) changed=(field==0?state->heading:field==1?state->ammo:state->missiles)!=old;
        if(!changed) sy_sleep_ms(12);
    }
    if(!keyboard(c,key,code,vk,0)) return -1;
    return changed;
}

static int cdp_navigate(ChromeInput *c,const char *url,int native) {
    char target[100],params[1300];
    if(!cdp_call(c,"Target.createTarget","{\"url\":\"about:blank\"}") ||
        !cdp_string(c,"\"targetId\":\"",target,sizeof target)) return 0;
    tx_snprintf(params,sizeof params,"{\"targetId\":\"%s\",\"flatten\":true}",target);
    if(!cdp_call(c,"Target.attachToTarget",params) ||
        !cdp_string(c,"\"sessionId\":\"",c->session,sizeof c->session)) return 0;
    if(native && (!cdp_call(c,"Page.enable","{}") || !cdp_call(c,"Page.addScriptToEvaluateOnNewDocument",
        "{\"source\":\"(()=>{let next,now=0;let p;const Instance=WebAssembly.Instance;"
        "WebAssembly.Instance=new Proxy(Instance,{construct(target,args){const i=new target(...args);"
        "if(i.exports.uxe_frame)p=i.exports;return i;}});"
        "window.requestAnimationFrame=f=>(next=f,1);window.cancelAnimationFrame=()=>{next=null};"
        "window.__d1Step=(n=1)=>{if(!p||!next)return 0;"
        "for(let j=0;j<n;j++){const f=next;next=null;f(now);now+=33.334;}return 1;};"
        "window.__d1Packet=()=>new Uint8Array(p.memory.buffer,2097152,112);"
        "window.__d1Error='';addEventListener('unhandledrejection',e=>{window.__d1Error=String(e.reason);});"
        "addEventListener('error',e=>{window.__d1Error=e.message;});})()\"}"))) return 0;
    tx_snprintf(params,sizeof params,"{\"url\":\"%s\"}",url);
    return cdp_call(c,"Page.navigate",params);
}

static int native_eval(ChromeInput *c,const char *expression,char *text,int cap) {
    char params[1600];
    int n=tx_snprintf(params,sizeof params,"{\"expression\":\"%s\"}",expression);
    return n>0 && n<(int)sizeof params && cdp_call(c,"Runtime.evaluate",params) &&
        cdp_string(c,"\"value\":\"",text,cap);
}

static int native_key(ChromeInput *c,const char *key,const char *code,int vk,const char *want) {
    char got[180];
    if(!keyboard(c,key,code,vk,1)) return 1;
    int ok=native_eval(c,"__d1Step();[1,3,8,9,11,15,18,20].map(i=>__d1Packet()[i]).join(',')",
        got,sizeof got);
    if(!keyboard(c,key,code,vk,0) || !ok) return 1;
    printf("D1_WASM_KEY %s got=%s expect=%s failed=%d\n",code,got,want,strcmp(got,want)!=0);
    return strcmp(got,want)!=0;
}

static int native_screenshot(ChromeInput *c,const char *path) {
    if(!cdp_call(c,"Page.captureScreenshot","{\"format\":\"png\",\"captureBeyondViewport\":false}")) return 1;
    const char *start=strstr(c->reply,"\"data\":\"");
    if(!start) return 1;
    start+=8;
    const char *end=strchr(start,'"');
    if(!end) return 1;
    unsigned char *png=mm_alloc(100000);
    if(!png) return 1;
    long len=tx_b64_decode(start,end-start,png,100000);
    int rc=len<=0 || sy_write_file(path,png,len,0600);
    mm_free(png);
    return rc;
}

static int native_ready(ChromeInput *c) {
    char text[180]="";
    int ready=0;
    long deadline=sy_now_ms()+5000;
    for(int i=0;i<120 && sy_now_ms()<deadline;i++) {
        if(native_eval(c,"(()=>{try{return String(__d1Step(2))+'|'+__d1Error}catch(e){return String(e)}})()",text,sizeof text) &&
           !strcmp(text,"1|")) {
            ready=1; break;
        }
        sy_sleep_ms(40);
    }
    if(!ready) {
        char page[300]="";
        native_eval(c,"location.href+'|'+document.title",page,sizeof page);
        printf("D1_WASM_READY failed=1 state=%s page=%s\n",text,page);
        return 0;
    }
    return 1;
}

static int exercise_native(ChromeInput *c,int shot) {
    const char *packet="[1,3,8,9,11,15,18,20].map(i=>__d1Packet()[i]).join(',')";
    char text[180]="",step[500];
    if(!native_ready(c)) return 1;
    if(shot) return native_screenshot(c,"/tmp/cdx2-d1-p11-verified.png");
    if(native_key(c,"w","KeyW",87,"0,24,26,12,96,0,100,3") ||
       native_key(c,"s","KeyS",83,"0,24,25,12,96,0,100,3") ||
       native_key(c,"d","KeyD",68,"3,28,25,12,96,0,100,3") ||
       native_key(c,"a","KeyA",65,"0,24,25,12,96,0,100,3") ||
       native_key(c,"Shift","ShiftLeft",16,"0,24,25,14,96,0,100,3") ||
       native_key(c," ","Space",32,"0,24,25,12,95,0,100,3") ||
       native_key(c,"m","KeyM",77,"0,24,25,12,95,0,100,2")) return 1;
    tx_snprintf(step,sizeof step,"__d1Step(13);%s",packet);
    if(!native_eval(c,step,text,sizeof text) || strcmp(text,"0,24,25,12,95,1,100,2")) {
        printf("D1_WASM_KO got=%s failed=1\n",text); return 1;
    }
    printf("D1_WASM_KO got=%s failed=0\n",text);
    tx_snprintf(step,sizeof step,"for(let i=0;i<5;i++){__d1Packet().set([1,0,0,18],88);__d1Step();}%s",packet);
    if(!native_eval(c,step,text,sizeof text) || strcmp(text,"0,24,25,12,95,1,0,2")) {
        printf("D1_WASM_LOSS got=%s failed=1\n",text); return 1;
    }
    printf("D1_WASM_LOSS got=%s failed=0\n",text);
    return native_key(c,"r","KeyR",82,"0,24,25,12,96,0,100,3");
}

static int native_water_read(ChromeInput *c,int steps,LiveWater *water) {
    char expr[530],text[130];
    tx_snprintf(expr,sizeof expr,"__d1Step(%d);(()=>{const p=__d1Packet();"
        "return [p[0]+256*p[1]-32768,p[2]+256*p[3]+65536*p[4],p[5]+256*p[6]-1024,p[7]].join(',')})()",steps);
    return native_eval(c,expr,text,sizeof text) &&
        sscanf(text,"%d,%d,%d,%d",&water->x,&water->z,&water->speed,&water->tick)==4;
}

static int native_touch(ChromeInput *c,const char *kind,int x) {
    char params[200];
    if(!strcmp(kind,"touchEnd")) return cdp_call(c,"Input.dispatchTouchEvent",
        "{\"type\":\"touchEnd\",\"touchPoints\":[]}");
    tx_snprintf(params,sizeof params,"{\"type\":\"%s\",\"touchPoints\":[{\"x\":%d,\"y\":400,\"id\":0}]}",kind,x);
    return cdp_call(c,"Input.dispatchTouchEvent",params);
}

static int exercise_native_water(ChromeInput *c) {
    LiveWater rest={0},east={0},west={0},touch_east={0},touch_west={0},released={0};
    if(!native_ready(c) || !native_water_read(c,0,&rest) ||
       !keyboard(c,"w","KeyW",87,1) || !keyboard(c,"d","KeyD",68,1) || !native_water_read(c,18,&east) ||
       !keyboard(c,"w","KeyW",87,0) || !keyboard(c,"d","KeyD",68,0) ||
       !keyboard(c,"a","KeyA",65,1) || !keyboard(c,"s","KeyS",83,1) || !native_water_read(c,24,&west) ||
       !keyboard(c,"a","KeyA",65,0) || !keyboard(c,"s","KeyS",83,0) ||
       !native_touch(c,"touchStart",1050) || !native_water_read(c,24,&touch_east) ||
       !native_touch(c,"touchMove",230) || !native_water_read(c,24,&touch_west) ||
       !native_touch(c,"touchEnd",0) || !native_water_read(c,24,&released)) return input_error("d2-wasm-input",0);
    int failed=rest.speed!=350 || east.x<=rest.x || east.z<=rest.z || east.speed<1000 ||
        west.x>=east.x || west.speed>=0 || touch_east.x<=west.x || touch_east.speed<1000 ||
        touch_west.x>=touch_east.x || released.speed>=touch_west.speed;
    printf("D2_WASM_INPUT start=%d,%d,%d WASD=%d,%d,%d then %d,%d,%d touch=%d,%d,%d then %d,%d,%d "
        "release_speed=%d failed=%d\n",rest.x,rest.z,rest.speed,east.x,east.z,east.speed,
        west.x,west.z,west.speed,touch_east.x,touch_east.z,touch_east.speed,touch_west.x,touch_west.z,touch_west.speed,
        released.speed,failed);
    return failed;
}

typedef struct { int distance,yaw,pitch; } NativeWalk;

static int native_walk_read(ChromeInput *c,int steps,NativeWalk *walk) {
    char query[240],text[120];
    tx_snprintf(query,sizeof query,"__d1Step(%d);[0,7,8].map(i=>"
        "new Float32Array(__d1Packet().buffer,2097152,9)[i]).join(',')",steps);
    return native_eval(c,query,text,sizeof text) &&
        sscanf(text,"%d,%d,%d",&walk->distance,&walk->yaw,&walk->pitch)==3;
}

static int native_mouse(ChromeInput *c,const char *kind,int x,int y,int buttons) {
    char params[240];
    tx_snprintf(params,sizeof params,"{\"type\":\"%s\",\"x\":%d,\"y\":%d,"
        "\"button\":\"left\",\"buttons\":%d,\"clickCount\":1}",kind,x,y,buttons);
    return cdp_call(c,"Input.dispatchMouseEvent",params);
}

static int exercise_native_walk(ChromeInput *c) {
    char text[80],wheel[160];
    NativeWalk start={0},pressed={0},dragged={0},rolled={0},touch={0},released={0},forward={0},backward={0};
    int w=0,h=0;
    if(!native_ready(c) || !native_walk_read(c,0,&start) ||
       !native_eval(c,"[innerWidth,innerHeight].join(',')",text,sizeof text) ||
       sscanf(text,"%d,%d",&w,&h)!=2 || w<800 || h<500) return input_error("d3-wasm-ready",0);
    tx_snprintf(wheel,sizeof wheel,"{\"type\":\"mouseWheel\",\"x\":%d,\"y\":%d,\"deltaX\":0,\"deltaY\":-100}",w/4,h/2);
    if(!native_mouse(c,"mousePressed",w/4,h/2,1) || !native_walk_read(c,1,&pressed) ||
       !native_mouse(c,"mouseMoved",w*3/8,h*5/8,1) || !native_walk_read(c,1,&dragged) ||
       !native_mouse(c,"mouseReleased",w*3/8,h*5/8,0) ||
       !cdp_call(c,"Input.dispatchMouseEvent",wheel) || !native_walk_read(c,1,&rolled) ||
       !native_touch(c,"touchStart",w/2) || !native_walk_read(c,4,&touch) ||
       !native_touch(c,"touchEnd",0) || !native_walk_read(c,3,&released) ||
       !keyboard(c,"w","KeyW",87,1) || !native_walk_read(c,3,&forward) || !keyboard(c,"w","KeyW",87,0) ||
       !keyboard(c,"s","KeyS",83,1) || !native_walk_read(c,3,&backward) || !keyboard(c,"s","KeyS",83,0))
        return input_error("d3-wasm-gesture",0);
    int failed=start.distance!=0 || start.yaw!=0 || start.pitch!=0 || pressed.distance!=0 ||
        dragged.distance!=0 || dragged.yaw<790 || dragged.yaw>810 || dragged.pitch< -365 || dragged.pitch> -355 ||
        rolled.distance!=540 || touch.distance!=1260 || released.distance!=touch.distance ||
        forward.distance!=released.distance+540 || backward.distance!=released.distance;
    printf("D3_WASM_INPUT drag=%d,%d,%d wheel=%d touch=%d release=%d W=%d S=%d failed=%d\n",
        dragged.distance,dragged.yaw,dragged.pitch,rolled.distance,touch.distance,released.distance,
        forward.distance,backward.distance,failed);
    return failed;
}

static int read_water(ChromeInput *c,LiveWater *water) {
    char value[100];
    if(!cdp_call(c,"Runtime.evaluate","{\"expression\":\"document.querySelector('output')?.textContent||''\"}") ||
        !cdp_string(c,"\"value\":\"",value,sizeof value)) return 0;
    return sscanf(value,"%d,%d,%d,%d",&water->x,&water->z,&water->speed,&water->tick)==4;
}

static double water_sine(double x) {
    double square;
    while(x>3.14159265359) x-=6.28318530718;
    if(x>1.570796326795) x=3.14159265359-x;
    if(x< -1.570796326795) x= -3.14159265359-x;
    square=x*x;
    return x*(1-square*(1.0/6-square*(1.0/120-square*(1.0/5040-square/362880))));
}

typedef struct { int land,largest,components,span,bands; } CoastStats;

static int coast_stats(const char *text,int w,int h,int role,CoastStats *stats) {
    enum { MAX=128*128 };
    unsigned char land[MAX];
    int queue[MAX],i,n=w*h;
    if(n>MAX || strlen(text)<(size_t)n) return 0;
    for(i=0;i<n;i++) {
        if(text[i]<'0' || text[i]>'2') return 0;
        land[i]=(unsigned char)(role?text[i]=='0'+role:text[i]!='0');
        stats->land+=land[i];
    }
    for(i=0;i<n;i++) {
        int xlo=i%w,xhi=xlo,ylo=i/w,yhi=ylo,tail=1,k;
        if(!land[i]) continue;
        land[i]=0;
        queue[0]=i;
        for(k=0;k<tail;k++) {
            int p=queue[k],x=p%w,y=p/w,j;
            int neighbors[]={x>0?p-1:-1,x+1<w?p+1:-1,p-w,p+w};
            if(x<xlo) xlo=x;
            if(x>xhi) xhi=x;
            if(y<ylo) ylo=y;
            if(y>yhi) yhi=y;
            for(j=0;j<4;j++) {
                int a=neighbors[j];
                if(a<0 || a>=n || !land[a]) continue;
                land[a]=0;
                queue[tail++]=a;
            }
        }
        if(tail>=12) stats->components++;
        if(tail>=4 && yhi-ylo<12 && ylo<h/2) stats->bands|=1<<(ylo/5);
        if(tail>stats->largest) stats->largest=tail;
        if(xhi-xlo+1>stats->span) stats->span=xhi-xlo+1;
    }
    return 1;
}

static int check_w1(const char *mutation,int published) {
    char cwd[1024],url[2000],*out=0;
    const char *p;
    int banks[55]={0},bank=0,i,j,k,failed=0,full=0;
    double smoothed=0;
    if(!getcwd(cwd,sizeof cwd)) return 2;
    tx_snprintf(url,sizeof url,"file://%s/%s?w1-check&%s",cwd,
        published==3?"ujs/practice/uxe/test/d1-solid-audit.html":published==2?"ujs/practice/uxe/test/d1-depth-audit.html":
        published?"docs/uxe/fly-next/index.html":"ujs/practice/uxe/test/d1-coast-audit.html",mutation);
    p=browser(url,&out,22);
    if(!p) { free(out); return 2; }
    for(i=1;i<=54;i++) {
        int at[6],used=0,wanted=i<=19?24:i<=33?-24:0;
        int lifetime=i+1<30?i+1:30,bad;
        double bend=0,expected[6];
        if(sscanf(p,"%d,%d,%d,%d,%d,%d%n",at,at+1,at+2,at+3,at+4,at+5,&used)!=6 ||
            !used || p[used]!=(i==54?'<':';')) { free(out); return 2; }
        p+=used+1;
        if(bank<wanted) bank+=4;
        else if(bank>wanted) bank-=4;
        banks[i]=bank;
        smoothed=(3*smoothed+bank)/4;
        for(j=0;j<lifetime;j++) bend+=banks[i-j]*(j+1)*7;
        expected[0]=bank; expected[1]=(smoothed<0?-smoothed:smoothed)*340;
        expected[2]=-smoothed*430; expected[3]=-smoothed*290;
        expected[4]=lifetime; expected[5]=bend;
        bad=0;
        for(k=0;k<6;k++) {
            double diff=at[k]-expected[k];
            bad|=diff>(k==0 || k==4?0:1) || diff<-(k==0 || k==4?0:1);
        }
        failed+=bad;
        full+=at[4]==30;
        if(i==8 || i==19 || i==33 || i==54)
            printf("W1 tick=%d bank=%d rise_mm=%d side_mm=%d tilt_mpx=%d trail=%d bend_mpx=%d failed=%d\n",
                i,at[0],at[1],at[2],at[3],at[4],at[5],bad);
    }
    free(out);
    return failed || full!=26;
}

static int check_audit_coast(const char *mutation,int published) {
    char cwd[1024],url[4096],profile[128],option[160],*out=0;
    char *av[]={"google-chrome","--headless=new","--allow-file-access-from-files","--disable-background-networking",
        "--virtual-time-budget=5500","--dump-dom",option,url,0};
    const char *p;
    int i,rc,failed=0;
    size_t bytes=0;
    if(!getcwd(cwd,sizeof cwd)) return 2;
    tx_snprintf(url,sizeof url,"file://%s/%s?coast-audit&%s",cwd,
        published==3?"ujs/practice/uxe/test/d1-solid-audit.html":published==2?"ujs/practice/uxe/test/d1-depth-audit.html":
        published?"docs/uxe/fly-next/index.html":"ujs/practice/uxe/test/d1-coast-audit.html",mutation);
    tx_snprintf(profile,sizeof profile,"/tmp/chrome-dom-audit-coast-%d",(int)getpid());
    tx_snprintf(option,sizeof option,"--user-data-dir=%s",profile);
    rc=cx_runv_timeout(av,16,&out,&bytes);
    chd_wipe(profile);
    p=out?strstr(out,"<output>"):0;
    if(rc || !p) { free(out); return 2; }
    p+=strlen("<output>");
    for(i=0;i<4;i++) {
        CoastStats stats={0};
        int w=i?142:128,h=i?44:128,term=i==3?'<':'|',bad;
        if(!coast_stats(p,w,h,0,&stats) || p[w*h]!=term) { free(out); return 2; }
        if(i) {
            CoastStats same_shore={0},islands={0};
            int bands=0,j;
            if(!coast_stats(p,w,h,2,&same_shore) || !coast_stats(p,w,h,1,&islands)) { free(out); return 2; }
            for(j=0;j<8;j++) bands+=!!(islands.bands&(1<<j));
            bad=same_shore.span*100<25*w || bands<2 || stats.land*100>66*w*h;
            printf("AUDIT_D1 heading=%d shore_span=%d/%d distant_layers=%d land=%d/%d failed=%d\n",
                (i-2)*18,same_shore.span,w,bands,stats.land,w*h,bad);
        } else {
            bad=stats.components<5 || stats.largest*100<45*stats.land || stats.land*100>58*w*h;
            printf("AUDIT_D1 map land=%d largest=%d islands=%d failed=%d\n",
                stats.land,stats.largest,stats.components,bad);
        }
        failed+=bad;
        p+=w*h+1;
    }
    free(out);
    return failed?1:0;
}

static int check_solid_airframe(const char *mutation,int published) {
    enum { W=96,H=54 };
    char cwd[1024],url[1700],*out=0;
    if(!getcwd(cwd,sizeof cwd)) return 2;
    tx_snprintf(url,sizeof url,"file://%s/%s?airframe-depth&still=1&%s",cwd,
        published?"docs/uxe/fly-next/index.html":"ujs/practice/uxe/test/d1-solid-audit.html",mutation);
    const char *p=browser(url,&out,3);
    if(!p || strspn(p,"01234")!=W*H || strncmp(p+W*H,"</output>",9)) { free(out); return 2; }
    int keel=0,wing[2]={0},tones[3]={0},ymin=H,ymax=0;
    for(int y=0;y<H;y++) for(int x=0;x<W;x++) {
        int shade=p[y*W+x]-'0';
        if(shade<1 || shade>3) continue;
        if(x>=36 && x<60) {
            if(y<ymin) ymin=y;
            if(y>ymax) ymax=y;
            if(y>=31) { keel++; tones[shade-1]++; }
        }
        if(y>=28 && y<=35 && x>=7 && x<=29) wing[0]++;
        if(y>=28 && y<=35 && x>=66 && x<=88) wing[1]++;
    }
    int height=ymax-ymin+1;
    int bad=height<25 || keel<95 || tones[1]<12 || wing[0]<60 || wing[1]<60;
    printf("D1_SOLID height=%d keel=%d keel_luma=%d,%d,%d wing_edges=%d,%d bad=%d\n",
        height,keel,tones[0],tones[1],tones[2],wing[0],wing[1],bad);
    free(out);
    return bad;
}

static int check_d1_depth(const char *mutation,int published) {
    char cwd[1024],url[4096],profile[128],option[160],*out=0;
    char *av[]={"google-chrome","--headless=new","--allow-file-access-from-files","--disable-background-networking",
        "--virtual-time-budget=5500","--dump-dom",option,url,0};
    size_t bytes=0;
    if(!getcwd(cwd,sizeof cwd)) return 2;
    tx_snprintf(url,sizeof url,"file://%s/%s?depth-audit&still=1&%s",cwd,
        published==2?"ujs/practice/uxe/test/d1-solid-audit.html":
        published?"docs/uxe/fly-next/index.html":"ujs/practice/uxe/test/d1-depth-audit.html",mutation);
    tx_snprintf(profile,sizeof profile,"/tmp/chrome-dom-d1-depth-%d",(int)getpid());
    tx_snprintf(option,sizeof option,"--user-data-dir=%s",profile);
    int rc=cx_runv_timeout(av,15,&out,&bytes);
    chd_wipe(profile);
    const char *p=out?strstr(out,"<output>"):0;
    if(rc || !p) { free(out); return 2; }
    p+=8;
    int bad=0,first=0;
    for(int frame=0;frame<4;frame++) {
        int a[9],used=0;
        if(sscanf(p,"%d,%d,%d,%d,%d,%d,%d,%d,%d%n",a,a+1,a+2,a+3,a+4,a+5,a+6,a+7,a+8,&used)!=9 ||
            p[used]!=(frame<3?';':'<')) { free(out); return 2; }
        if(frame<3) {
            int spread=a[7]-a[1];
            bad+=a[0]<9 || a[3]-a[0]<24 || a[6]-a[3]<60 || spread<120 || abs(a[2]-a[5])<8;
            if(frame==0) first=a[0];
            if(frame==2) bad+=abs(first-a[0])<8;
            printf("D1_DEPTH frame=%d depths=%d,%d,%d spread=%d\n",frame,a[0],a[3],a[6],spread);
        } else {
            int tones=0,total=0;
            for(int i=1;i<8;i++) { tones+=a[i]>=12; total+=a[i]; }
            bad+=tones<5 || total<200;
            printf("D1_ROCK intermediate_tones=%d pixels=%d bad=%d\n",tones,total,bad);
        }
        p+=used+1;
    }
    free(out);
    return bad!=0;
}

static int check_water_mirrors(const char *mutation,int published) {
    enum { W=426, BRIDGE_ROWS=32, TITLE_ROWS=24 };
    char cwd[1024],url[4096],profile[128],option[160],*out=0;
    char *av[]={"google-chrome","--headless=new","--allow-file-access-from-files","--disable-background-networking",
        "--virtual-time-budget=5500","--dump-dom",option,url,0};
    size_t bytes=0;
    if(!getcwd(cwd,sizeof cwd)) return 2;
    tx_snprintf(url,sizeof url,"file://%s/%s?mirror-frames&%s",cwd,
        published?"docs/uxe/water-keeps/index.html":"ujs/practice/uxe/demo/water-keeps/reflection-audit.html",mutation);
    tx_snprintf(profile,sizeof profile,"/tmp/chrome-dom-water-mirrors-%d",(int)getpid());
    tx_snprintf(option,sizeof option,"--user-data-dir=%s",profile);
    int rc=cx_runv_timeout(av,15,&out,&bytes);
    chd_wipe(profile);
    const char *p=out?strstr(out,"<output>"):0;
    if(rc || !p) { free(out); return 2; }
    p+=8;
    int bands=0,after=0,ink=0,moved=0;
    for(int frame=0;frame<4;frame++) {
        int count=W*(frame<2?BRIDGE_ROWS:TITLE_ROWS);
        if(strspn(p,"01")!=(size_t)count || p[count]!=(frame<3?';':'<')) { free(out); return 2; }
        if(frame==0) {
            double center=213+155*(5.4*water_sine(24.0/49)+4.3*water_sine(24.0/117))/24;
            double span=155*(13.2+1.9*water_sine(24.0/39))/24;
            for(int lane=-2;lane<=2;lane++) {
                int x=(int)(center+.42*lane*span+.5),lit=0;
                for(int y=0;y<BRIDGE_ROWS;y++) {
                    for(int col=x-4;col<=x+4;col++) if(p[y*W+col]=='1') { lit++; break; }
                }
                bands+=lit>=14;
            }
        } else if(frame==1) {
            for(int i=0;i<count;i++) after+=p[i]=='1';
        } else if(frame==2) {
            for(int i=0;i<count;i++) ink+=p[i]=='1';
        } else {
            for(int i=0;i<count;i++) moved+=p[i]!=p[i-count-1];
        }
        p+=count+1;
    }
    int bad=bands<3 || after!=0 || ink<100 || moved<60;
    printf("WATER_MIRRORS bands=%d after=%d title=%d shifted=%d bad=%d\n",bands,after,ink,moved,bad);
    free(out);
    return bad;
}

static int check_audit_banks(const char *mutation,int published) {
    enum { PIXELS=213*65 };
    const int positions[]={0,30,58};
    char cwd[1024],url[4096],profile[128],option[160],*out=0;
    char *av[]={"google-chrome","--headless=new","--allow-file-access-from-files","--disable-background-networking",
        "--virtual-time-budget=5500","--dump-dom",option,url,0};
    const char *p;
    int i,j,rc,failed=0;
    size_t bytes=0;
    if(!getcwd(cwd,sizeof cwd)) return 2;
    tx_snprintf(url,sizeof url,
        "file://%s/%s?bank-audit&%s",cwd,
        published==2?"ujs/practice/uxe/demo/water-keeps/reflection-audit.html":
        published?"docs/uxe/water-keeps/index.html":"ujs/practice/uxe/demo/water-keeps/banks-audit.html",mutation);
    tx_snprintf(profile,sizeof profile,"/tmp/chrome-dom-audit-banks-%d",(int)getpid());
    tx_snprintf(option,sizeof option,"--user-data-dir=%s",profile);
    rc=cx_runv_timeout(av,15,&out,&bytes);
    chd_wipe(profile);
    p=out?strstr(out,"<output>"):0;
    if(rc || !p) { free(out); return 2; }
    p+=strlen("<output>");
    for(i=0;i<3;i++) {
        int offsets[2]={0},counts[8]={0},near[8]={0},far[8]={0},bad;
        double boat_x=.78*(5.4*water_sine(positions[i]/49.0)+4.3*water_sine(positions[i]/117.0));
        for(j=0;j<40;j++) {
            int at=0,used=0,side=j%2?1:-1,y=111+(j/2)*6;
            double d=1550.0/(y-90),z=positions[i]+d;
            double center=5.4*water_sine(z/49)+4.3*water_sine(z/117);
            double half=13.2+1.9*water_sine(z/39);
            double shore=213+(center+side*half-boat_x)*155/d;
            if(sscanf(p,"%d%n",&at,&used)!=1 || !used || p[used]!=(j==39?'|':',')) {
                free(out); return 2;
            }
            p+=used+1;
            offsets[j%2]+=at-shore>2.5 || shore-at>2.5;
        }
        if(strlen(p)<PIXELS+1 || p[PIXELS]!=(i==2?'<':';')) { free(out); return 2; }
        for(j=0;j<PIXELS;j++) {
            int code=p[j]-'0';
            if(code<0 || code>7) { free(out); return 2; }
            counts[code]++;
            if(j/213>=35) near[code]++;
            else far[code]++;
        }
        p+=PIXELS+1;
        bad=offsets[0]<4 || offsets[1]<4 || counts[1]<90 || counts[2]<150 ||
            counts[4]<45 || near[1]<15 || near[2]<25 || far[1]<15 || far[2]<25;
        failed+=bad;
        printf("AUDIT_D2 z=%d shore_rows=%d,%d reeds=%d,%d posts=%d near=%d,%d far=%d,%d failed=%d\n",
            positions[i],offsets[0],offsets[1],counts[1],counts[2],counts[4],
            near[1],near[2],far[1],far[2],bad);
    }
    free(out);
    return failed?1:0;
}

static int water_right_edge(int z) {
    return (int)(12300+5400*water_sine(z/49000.0)+4300*water_sine(z/117000.0)+1900*water_sine(z/39000.0));
}

static int exercise_water(ChromeInput *c) {
    LiveWater start,open,at,reverse;
    int i,forward=0,steered=0,edge=0,braked=0,left=0,back=0;
    long end=sy_now_ms()+4000;
    for(i=0;!read_water(c,&start);i++) {
        if(i>=90 || sy_now_ms()>=end) return input_error("cdp-water-ready",0);
        sy_sleep_ms(35);
    }
    open=start;
    if(!keyboard(c,"w","KeyW",87,1)) return input_error("cdp-water-accelerate",0);
    end=sy_now_ms()+2000;
    for(i=0;i<55 && sy_now_ms()<end;i++) {
        if(read_water(c,&open) && open.z-start.z>=8000 && open.speed>=950) { forward=1; break; }
        sy_sleep_ms(35);
    }
    if(!keyboard(c,"d","KeyD",68,1)) return input_error("cdp-water-right",0);
    at=open;
    end=sy_now_ms()+7200;
    for(i=0;i<180 && sy_now_ms()<end;i++) {
        if(read_water(c,&at)) {
            steered|=at.x-open.x>=4500;
            if(abs(at.x-water_right_edge(at.z))<=500) {
                edge=1;
                if(at.speed<=550 && at.speed+400<open.speed) { braked=1; break; }
            }
        }
        sy_sleep_ms(40);
    }
    if(!keyboard(c,"d","KeyD",68,0) || !keyboard(c,"a","KeyA",65,1)) return input_error("cdp-water-left",0);
    end=sy_now_ms()+1300;
    for(i=0;i<36 && sy_now_ms()<end;i++) {
        if(read_water(c,&reverse) && reverse.x<=at.x-600) { left=1; break; }
        sy_sleep_ms(35);
    }
    if(!keyboard(c,"a","KeyA",65,0) || !keyboard(c,"w","KeyW",87,0) ||
        !keyboard(c,"s","KeyS",83,1)) return input_error("cdp-water-reverse",0);
    end=sy_now_ms()+1750;
    reverse=at;
    for(i=0;i<48 && sy_now_ms()<end;i++) {
        LiveWater next;
        if(read_water(c,&next)) {
            back=next.speed< -100 && next.z<reverse.z;
            reverse=next;
            if(back) break;
        }
        sy_sleep_ms(35);
    }
    if(!keyboard(c,"s","KeyS",83,0)) return input_error("cdp-water-stop",0);
    printf("D2_PAGES_INPUT W=%d D=%d A=%d S=%d bank=%d braked=%d x=%d->%d z=%d->%d speed=%d->%d\n",
        forward,steered,left,back,edge,braked,open.x,at.x,start.z,at.z,open.speed,at.speed);
    return !forward || !steered || !left || !back || !edge || !braked;
}

static int exercise_water_auto(ChromeInput *c) {
    int i;
    long end=sy_now_ms()+4000;
    char title[100]="";
    for(i=0;i<80 && sy_now_ms()<end;i++) {
        if(cdp_call(c,"Runtime.evaluate","{\"expression\":\"document.title\"}") &&
            cdp_string(c,"\"value\":\"",title,sizeof title) &&
            (!strcmp(title,"WATER_OK") || !strcmp(title,"WATER_FAIL") || !strcmp(title,"WATER_ERR"))) break;
        sy_sleep_ms(35);
    }
    printf("D2_PAGES_AUTO title=%s expected=WATER_OK\n",title);
    return strcmp(title,"WATER_OK")!=0;
}

static int exercise_keyboard(ChromeInput *c,int battle,int framed) {
    LiveFlight state;
    int original,turned,ammo,missiles,change,i,failed=0;
    long end;
    end=sy_now_ms()+6000;
    for(i=0;!read_flight(c,&state);i++) {
        if(sy_now_ms()>=end || i>=100) return input_error("cdp-ready",0);
        sy_sleep_ms(35);
    }
    if(battle==LIVE_MUTE) {
        int muted;
        for(i=1;i>=0;i--) {
            char value[20];
            if(!keyboard(c,"n","KeyN",78,1) || !keyboard(c,"n","KeyN",78,0) ||
                !cdp_call(c,"Runtime.evaluate","{\"expression\":\"String(Number(document.querySelector('aside').textContent.endsWith('静音')))\"}") ||
                !cdp_string(c,"\"value\":\"",value,sizeof value)) return input_error("cdp-audio-key",0);
            muted=atoi(value);
            printf("D1_AUDIO_KEY key=N muted=%d expected=%d\n",muted,i);
            if(muted!=i) return 1;
        }
        return 0;
    }
    if(battle) {
        LiveBattle initial;
        if(!read_battle(c,&initial)) return input_error("cdp-initial-hud",0);
        if(initial.hp_first!=0x79dca2 || initial.hp_last!=0x79dca2 || initial.ko!=0x23344d || initial.loss) {
            printf("D1_BATTLE_INITIAL hp=%06x/%06x ko_pixel=%06x loss=%d\n",
                initial.hp_first,initial.hp_last,initial.ko,initial.loss);
            return 1;
        }
    }
    original=state.heading; ammo=state.ammo; missiles=state.missiles;
    change=key_change(c,"d","KeyD",68,0,&state);
    if(change<0) return input_error("cdp-turn",0);
    turned=state.heading;
    failed+=!change || turned==original;
    change=key_change(c," ","Space",32,1,&state);
    if(change<0) return input_error("cdp-gun",0);
    failed+=!change || state.ammo!=ammo-1;
    printf("D1_KEYBOARD turn=%d->%d ammo=%d->%d lock=%d\n",original,turned,ammo,state.ammo,state.lock);
    for(i=0;!state.lock && state.heading>0 && state.heading<33 && i<7;i++) {
        change=key_change(c,"a","KeyA",65,0,&state);
        if(change<=0) break;
    }
    if(!state.lock) failed++;
    else {
        change=key_change(c,"m","KeyM",77,2,&state);
        if(change<0) return input_error("cdp-missile",0);
        failed+=!change || state.missiles!=missiles-1;
    }
    printf("D1_KEYBOARD missile=%d->%d\n",missiles,state.missiles);
    if(framed && !cdp_call(c,"Runtime.evaluate","{\"expression\":\"window.d1RunFrames()\"}"))
        return input_error("cdp-release-frames",0);
    LiveAudio audio={0};
    if(framed) {
        int target_frames=state.frames+40;
        end=sy_now_ms()+15000;
        if(end>c->deadline-4100) end=c->deadline-4100;
        for(i=0;i<400 && sy_now_ms()<end;i++) {
            if(!read_audio_events(c,&audio)) return input_error("cdp-audio-events",0);
            if(!read_flight(c,&state)) return input_error("cdp-frame-stats",0);
            if((audio.explosion || state.frames>=target_frames) && state.frames>=13 && state.elapsed>=600) break;
            sy_sleep_ms(40);
        }
    } else {
        sy_sleep_ms(1150);
        if(!read_flight(c,&state)) return input_error("cdp-frame-stats",0);
    }
    failed+=state.frames<13 || state.elapsed<600 || state.gap<33000;
    printf("D1_PLAY\tframes=%d elapsed_ms=%d fps_milli=%d minimum_frame_us=%d lock_fps=30 failed=%d\n",
        state.frames,state.elapsed,state.elapsed?1000000*(state.frames-2)/state.elapsed:0,state.gap,failed);
    if(failed || !battle) return !!failed;
    if(!framed && !read_audio_events(c,&audio)) return input_error("cdp-audio-events",0);
    failed=audio.gun!=1 || audio.missile!=1 || audio.explosion!=1 || audio.lock<1;
    printf("D1_PAGES_AUDIO gun=%d missile=%d explosion=%d lock=%d failed=%d\n",
        audio.gun,audio.missile,audio.explosion,audio.lock,failed);
    return failed?failed:exercise_battle(c);
}

typedef struct { int a,b,c,d; } LiveWalk;

static int read_walk(ChromeInput *c,LiveWalk *s,int town) {
    char value[160];
    const char *d3="{\"expression\":\"document.title==='D3_OK'?document.querySelector('output').textContent:''\"}";
    const char *d4="{\"expression\":\"document.title==='D4_OK'?document.querySelector('output').textContent:''\"}";
    return cdp_call(c,"Runtime.evaluate",town?d4:d3) && cdp_string(c,"\"value\":\"",value,sizeof value) &&
        sscanf(value,"%d,%d,%d,%d",&s->a,&s->b,&s->c,&s->d)==4;
}

static int walk_step(ChromeInput *c,LiveWalk *s,int frames) {
    char args[100],value[160];
    tx_snprintf(args,sizeof args,"{\"expression\":\"advancePreview(%d)\"}",frames);
    return cdp_call(c,"Runtime.evaluate",args) && cdp_string(c,"\"value\":\"",value,sizeof value) &&
        sscanf(value,"%d,%d,%d,%d",&s->a,&s->b,&s->c,&s->d)==4;
}

static int walk_key(ChromeInput *c,LiveWalk *s,int back,int frames) {
    int ok;
    const char *key=back?"s":"w",*code=back?"KeyS":"KeyW";
    int vk=back?83:87;
    if(!keyboard(c,key,code,vk,1)) return 0;
    ok=walk_step(c,s,frames);
    return keyboard(c,key,code,vk,0) && ok;
}

static int bridge_route(const LiveWalk *s) {
    if(s->a==30600) return s->b==16000 && s->c==12400 && s->d==8650;
    return s->a==0 && s->b==15000 && s->c==4000 && s->d==29000;
}

static int read_town_camera(ChromeInput *c,int *depth,int *margin) {
    int tick,x,y,target,sx,sy;
    char value[200];
    const char *expr="{\"expression\":\"document.querySelector('output').dataset.camera||''\"}";
    return cdp_call(c,"Runtime.evaluate",expr) && cdp_string(c,"\"value\":\"",value,sizeof value) &&
        sscanf(value,"%d,%d,%d,%d,%d,%d,%d,%d",&tick,&x,&y,depth,&target,&sx,&sy,margin)==8;
}

static int town_smoke(const LiveWalk *s) {
    double age=(s->a%120)/120.0;
    int lift=5670+(int)((2650+820*age)*age+.5);
    return abs(s->d-lift)<=1;
}

static int exercise_walk(ChromeInput *c,int town) {
    LiveWalk start={0},held={0},forward={0},back={0};
    long end=sy_now_ms()+4200;
    int i,ready=0;
    for(i=0;i<80 && sy_now_ms()<end;i++) {
        if(read_walk(c,&start,town)) { ready=1; break; }
        sy_sleep_ms(35);
    }
    if(!ready) {
        char title[120]="";
        if(cdp_call(c,"Runtime.evaluate","{\"expression\":\"document.title\"}")) cdp_string(c,"\"value\":\"",title,sizeof title);
        printf("WALK_AUTO expected=%s title=%s\n",town?"D4_OK":"D3_OK",title);
        return 1;
    }
    if(!town) {
        int moved=walk_key(c,&forward,0,170);
        printf("D3_OK distance=%d->%d start=%d,%d,%d xyz=%d,%d,%d moved=%d\n",
            start.a,forward.a,start.b,start.c,start.d,forward.b,forward.c,forward.d,moved);
        return !bridge_route(&start) || !moved || forward.a!=170*180 || !bridge_route(&forward);
    }
    if(start.b || start.c!=14000 || !town_smoke(&start)) {
        printf("D4 initial tick=%d deck=%d eye=%d smoke=%d\n",start.a,start.b,start.c,start.d);
        return 1;
    }
    int depth=0,margin=0,back_depth=0,back_margin=0;
    if(!walk_step(c,&held,8) || !walk_key(c,&forward,0,170) ||
        !read_town_camera(c,&depth,&margin) || !walk_key(c,&back,1,170) ||
        !read_town_camera(c,&back_depth,&back_margin))
        return input_error("cdp-walk-step",0);
    printf("D4_OK eye=%d->%d->%d smoke=%d->%d deck=%d->%d depth=%d->%d foot_margin=%d\n",
        start.c,forward.c,back.c,start.d,held.d,forward.b,back.b,depth,back_depth,margin);
    return start.a!=0 || held.a!=8 || forward.a!=178 || back.a!=348 ||
        held.b || held.c!=14000 || held.d<=start.d || !town_smoke(&held) ||
        !town_smoke(&forward) || !town_smoke(&back) ||
        forward.b!=4080 || forward.c!=21080 || back.b || back.c!=14000 ||
        depth!=37000 || back_depth!=22000 || margin<30 || back_margin>=0;
}

static int solid_keyboard_fixture(const char *cwd,const char *source,const char *dir) {
    const char *needles[] = {"<meta charset=\"utf-8\">", "let pointer=null,buttons=0;",
        "keys.add(event.code);", "previous=now;", "const steps=Math.floor((pending+.25)/frameInterval);\n      pending-=steps*frameInterval;"};
    char html[24576], path[1260], base[1260];
    unsigned char *input=0;
    int64_t size=0;
    int used=0, rc=1;
    tx_snprintf(base,sizeof base,"<meta charset=\"utf-8\">\n<base href=\"file://%s/ujs/practice/uxe/test/\">",cwd);
    const char *replacements[] = {base,
        "let pointer=null,buttons=0;\n"
        "  let frameKeys=true,frameBudget=1;\n"
        "  window.d1RunFrames=()=>{ frameKeys=false; };\n"
        "  if(query.has('no-explosion-sound')) {\n"
        "    const trigger=audio.trigger;\n"
        "    combat=combatModel(buffer,query,name=>{if(name!=='explosion')trigger(name);});\n"
        "  }",
        "keys.add(event.code);\n    if(frameKeys && !event.repeat) frameBudget++;",
        "previous=now;\n    if(frameKeys && !frameBudget) { pending=0; requestAnimationFrame(loop); return; }",
        "const steps=frameKeys?1:Math.floor((pending+.25)/frameInterval);\n"
        "      if(frameKeys) { frameBudget--; pending=0; } else pending-=steps*frameInterval;"};
    if(sy_read_file(source,&input,&size,20000)) return 1;
    const char *at=(char *)input;
    long left=size;
    for(size_t i=0;i<sizeof needles/sizeof needles[0];i++) {
        long key=tx_len(needles[i],256), before=tx_find(at,left,needles[i],key);
        if(before<0) goto done;
        int n=tx_snprintf(html+used,sizeof html-used,"%.*s%s",(int)before,at,replacements[i]);
        if(n<0 || n>=(int)sizeof html-used) goto done;
        used+=n;
        at+=before+key;
        left-=before+key;
    }
    if(left>=(long)sizeof html-used) goto done;
    if(tx_snprintf(html+used,sizeof html-used,"%.*s",(int)left,at)!=left) goto done;
    tx_snprintf(path,sizeof path,"%s/solid.html",dir);
    rc=sy_write_file(path,html,used+left,0600)!=0;
done:
    mm_free(input);
    return rc;
}

static int check_keyboard_path(const char *mutation,int battle,const char *candidate) {
    ChromeInput c={0};
    sy_spawn_t launch;
    sy_exit_t ended;
    char cwd[1024],url[1260],profile[128],option[160],fixture[128]="";
    char *argv[]={"sh","-c","exec google-chrome \"$@\" 3<&0 4>&1 1>/dev/null","chrome-pipe",
        "--headless=new","--disable-background-networking","--no-first-run","--allow-file-access-from-files",
        "--use-angle=swiftshader","--enable-unsafe-swiftshader",
        "--remote-debugging-pipe","--window-size=1280,807",option,"about:blank",0};
    int rc,n;
    int framed=candidate && !strcmp(candidate,"ujs/practice/uxe/test/d1-solid-audit.html");
    if(!getcwd(cwd,sizeof cwd)) return input_error("cdp-cwd",0);
    int native=battle==LIVE_WASM || battle==LIVE_WATER_WASM || battle==LIVE_WALK_WASM;
    if(native) {
        n=tx_snprintf(url,sizeof url,"%s",candidate);
    } else if(framed) {
        if(sy_mkdtemp("/tmp","d1-keyboard-",fixture,sizeof fixture)) return input_error("cdp-fixture-dir",0);
        if(solid_keyboard_fixture(cwd,candidate,fixture)) { chd_wipe(fixture); return input_error("cdp-fixture",0); }
        n=tx_snprintf(url,sizeof url,"file://%s/solid.html?input-test=1&hold-course&%s",fixture,mutation);
    } else n=tx_snprintf(url,sizeof url,"file://%s/%s?%s&%s",cwd,
        candidate?candidate:battle==LIVE_COAST?"ujs/practice/uxe/test/d1-coast-audit.html":
        battle==LIVE_BRIDGE?"docs/uxe/ink-walk/index.html":battle==LIVE_TOWN?"docs/uxe/oneshot/index.html":
        battle>=LIVE_WATER?"docs/uxe/water-keeps/index.html":
        battle==LIVE_MUTE?"ujs/practice/uxe/test/d1-pixel-a.html":"docs/uxe/fly-next/index.html",
        battle==LIVE_COAST || battle==LIVE_BATTLE?"input-test=1&hold-course":
        battle>=LIVE_WATER_AUTO?"auto=1":"input-test=1",mutation);
    if(n<0 || n>=(int)sizeof url) { if(framed) chd_wipe(fixture); return input_error("cdp-url",0); }
    tx_snprintf(profile,sizeof profile,"/tmp/chrome-d1-keyboard-%d",(int)getpid());
    tx_snprintf(option,sizeof option,"--user-data-dir=%s",profile);
    sy_spawn_init(&launch);
    launch.argv=argv; launch.in_fd=SY_STDIO_PIPE; launch.out_fd=SY_STDIO_PIPE;
    launch.err_fd=SY_STDIO_NULL; launch.pgroup=-1; launch.deadline_ms=23000;
    rc=sy_proc_spawn(&launch,&c.child);
    if(rc) { if(framed) chd_wipe(fixture); return input_error("cdp-spawn",0); }
    c.deadline=sy_now_ms()+22500;
    if(!cdp_navigate(&c,url,native)) rc=input_error("cdp-navigate",0);
    else if(battle==LIVE_WASM) rc=exercise_native(&c,mutation[0]!=0);
    else if(battle==LIVE_WATER_WASM) rc=exercise_native_water(&c);
    else if(battle==LIVE_WALK_WASM) rc=exercise_native_walk(&c);
    else if(battle==LIVE_WATER) rc=exercise_water(&c);
    else if(battle==LIVE_WATER_AUTO) rc=exercise_water_auto(&c);
    else if(battle==LIVE_BRIDGE || battle==LIVE_TOWN) rc=exercise_walk(&c,battle==LIVE_TOWN);
    else rc=exercise_keyboard(&c,battle==LIVE_COAST?LIVE_BATTLE:battle,framed);
    sy_close(c.child.in_fd);
    sy_close(c.child.out_fd);
    sy_proc_kill(&c.child,9);
    sy_proc_wait(&c.child,&ended);
    chd_wipe(profile);
    if(framed) chd_wipe(fixture);
    return rc;
}

static int check_pages_keyboard(const char *mutation,int battle) {
    return check_keyboard_path(mutation,battle,0);
}

int main(int argc,char **argv) {
    int rc;
    if(argc==3 && !strcmp(argv[1],"wasm-walk-input")) {
        if(strncmp(argv[2],"file:///",8) && strncmp(argv[2],"http://127.0.0.1:",17)) return 2;
        return check_keyboard_path("",LIVE_WALK_WASM,argv[2]);
    }
    if(argc==3 && !strcmp(argv[1],"wasm-water-input")) {
        if(strncmp(argv[2],"file:///",8) && strncmp(argv[2],"http://127.0.0.1:",17)) return 2;
        return check_keyboard_path("",LIVE_WATER_WASM,argv[2]);
    }
    if(argc==3 && (!strcmp(argv[1],"wasm-page-input") || !strcmp(argv[1],"wasm-page-shot"))) {
        if(strncmp(argv[2],"file:///",8) && strncmp(argv[2],"http://127.0.0.1:",17)) return 2;
        return check_keyboard_path(!strcmp(argv[1],"wasm-page-shot")?"shot":"",LIVE_WASM,argv[2]);
    }
    if((argc==2 || argc==3) && (!strcmp(argv[1],"solid-airframe") || !strcmp(argv[1],"published-solid")))
        return check_solid_airframe(argc==3?argv[2]:"",argv[1][0]=='p');
    if(argc==2 && !strcmp(argv[1],"solid-w1")) return check_w1("",3);
    if(argc==2 && !strcmp(argv[1],"solid-coast")) return check_audit_coast("",3);
    if(argc==2 && !strcmp(argv[1],"solid-depth")) return check_d1_depth("",2);
    if(argc==2 && !strcmp(argv[1],"solid-battle")) return check_keyboard_path("",LIVE_COAST,
        "ujs/practice/uxe/test/d1-solid-audit.html");
    if(argc==2 && !strcmp(argv[1],"solid-no-explosion")) return check_keyboard_path("no-explosion-sound",LIVE_COAST,
        "ujs/practice/uxe/test/d1-solid-audit.html");
    if((argc==2 || argc==3) && (!strcmp(argv[1],"w1") || !strcmp(argv[1],"published-w1")))
        return check_w1(argc==3?argv[2]:"",argv[1][0]=='p');
    if(argc==2 && !strcmp(argv[1],"coast-battle")) return check_pages_keyboard("",LIVE_COAST);
    if((argc==2 || argc==3) && (!strcmp(argv[1],"audit-coast") || !strcmp(argv[1],"published-coast")))
        return check_audit_coast(argc==3?argv[2]:"",argv[1][0]=='p');
    if((argc==2 || argc==3) && (!strcmp(argv[1],"audit-banks") || !strcmp(argv[1],"published-banks")))
        return check_audit_banks(argc==3?argv[2]:"",argv[1][0]=='p');
    if((argc==2 || argc==3) && !strcmp(argv[1],"bridge-pages-input"))
        return check_pages_keyboard(argc==3?argv[2]:"",LIVE_BRIDGE);
    if((argc==2 || argc==3) && !strcmp(argv[1],"town-pages-input"))
        return check_pages_keyboard(argc==3?argv[2]:"",LIVE_TOWN);
    if(argc==2 && !strcmp(argv[1],"belly-pages-input"))
        return check_keyboard_path("",LIVE_TOWN,"ujs/practice/uxe/test/d4-belly-x3.html");
    if(argc==1) {
        rc=check_airframe("");
        return rc?rc:check_world("");
    }
    if(argc==2 && !strcmp(argv[1],"pages")) {
        rc=check_terrain("",1);
        return rc?rc:check_combat("",1);
    }
    if(argc==2 && !strcmp(argv[1],"pages-auto")) return check_pages_auto(0);
    if(argc==2 && !strcmp(argv[1],"pages-live")) return check_pages_auto(1);
    if(argc==2 && !strcmp(argv[1],"pages-input")) return check_pages_keyboard("",0);
    if(argc==2 && !strcmp(argv[1],"pages-wrong-key")) return check_pages_keyboard("wrong-key",0);
    if(argc==2 && !strcmp(argv[1],"pages-battle")) return check_pages_keyboard("",1);
    if(argc==2 && !strcmp(argv[1],"pages-no-return-fire")) return check_pages_keyboard("no-return-fire",1);
    if(argc==2 && !strcmp(argv[1],"pages-no-restart")) return check_pages_keyboard("no-restart",1);
    if(argc==2 && !strcmp(argv[1],"pages-no-lock-sound")) return check_pages_keyboard("no-lock-sound",LIVE_BATTLE);
    if(argc==2 && !strcmp(argv[1],"mirror-banks")) return check_audit_banks("",2);
    if((argc==2 || argc==3) && (!strcmp(argv[1],"flight-depth") || !strcmp(argv[1],"published-depth")))
        return check_d1_depth(argc==3?argv[2]:"",argv[1][0]=='p');
    if(argc==2 && (!strcmp(argv[1],"flat-formation") || !strcmp(argv[1],"hard-rock")))
        return check_d1_depth(argv[1],0);
    if(argc==2 && !strcmp(argv[1],"depth-battle")) return check_keyboard_path("",LIVE_COAST,
        "ujs/practice/uxe/test/d1-depth-audit.html");
    if(argc==2 && !strcmp(argv[1],"depth-w1")) return check_w1("",2);
    if(argc==2 && !strcmp(argv[1],"depth-coast")) return check_audit_coast("",2);
    if(argc==2 && (!strcmp(argv[1],"mirror-input") || !strcmp(argv[1],"mirror-auto")))
        return check_keyboard_path("",!strcmp(argv[1],"mirror-auto")?LIVE_WATER_AUTO:LIVE_WATER,
            "ujs/practice/uxe/demo/water-keeps/reflection-audit.html");
    if((argc==2 || argc==3) && (!strcmp(argv[1],"water-mirrors") || !strcmp(argv[1],"published-mirrors")))
        return check_water_mirrors(argc==3?argv[2]:"",argv[1][0]=='p');
    if(argc==2 && (!strcmp(argv[1],"no-title-shimmer") || !strcmp(argv[1],"no-bridge-shimmer")))
        return check_water_mirrors(argv[1],0);
    if(argc==2 && !strcmp(argv[1],"water-pages-input")) return check_pages_keyboard("",LIVE_WATER);
    if(argc==2 && !strcmp(argv[1],"water-pages-no-bank-slow")) return check_pages_keyboard("no-bank-slow",LIVE_WATER);
    if(argc==2 && !strcmp(argv[1],"water-pages-no-steer-key")) return check_pages_keyboard("no-steer-key",LIVE_WATER);
    if(argc==2 && !strcmp(argv[1],"water-pages-auto")) return check_pages_keyboard("",LIVE_WATER_AUTO);
    if(argc==2 && !strcmp(argv[1],"water-pages-bad-auto")) return check_pages_keyboard("bad-auto-title",LIVE_WATER_AUTO);
    if(argc==2 && !strcmp(argv[1],"terrain")) return check_terrain("",0);
    if(argc==2 && (!strcmp(argv[1],"wrong-seed") || !strcmp(argv[1],"wrong-bands") || !strcmp(argv[1],"muted-palette")))
        return check_terrain(argv[1],0);
    if(argc==2 && !strcmp(argv[1],"combat")) return check_combat("",0);
    if(argc==2 && !strcmp(argv[1],"effects")) return check_effects("");
    if(argc==2 && !strcmp(argv[1],"attitude")) return check_attitude("");
    if(argc==2 && !strcmp(argv[1],"detail")) return check_detail("");
    if(argc==2 && !strcmp(argv[1],"viewport")) return check_viewport("");
    if(argc==2 && !strcmp(argv[1],"short-canvas")) return check_viewport(argv[1]);
    if(argc==2 && !strcmp(argv[1],"skirmish")) return check_skirmish("");
    if(argc==2 && !strcmp(argv[1],"waves")) return check_waves("");
    if(argc==2 && (!strcmp(argv[1],"light-as-heavy") || !strcmp(argv[1],"weak-heavy") ||
        !strcmp(argv[1],"no-wave"))) return check_waves(argv[1]);
    if(argc==2 && !strcmp(argv[1],"audio")) return check_audio("");
    if(argc==2 && !strcmp(argv[1],"audio-key")) return check_pages_keyboard("",2);
    if(argc==2 && (!strcmp(argv[1],"no-lock-sound") || !strcmp(argv[1],"flat-envelope"))) return check_audio(argv[1]);
    if(argc==2 && (!strcmp(argv[1],"no-return-fire") || !strcmp(argv[1],"no-maneuver") ||
        !strcmp(argv[1],"no-restart"))) return check_skirmish(argv[1]);
    if(argc==2 && (!strcmp(argv[1],"coarse-relief") || !strcmp(argv[1],"bare-ground") ||
        !strcmp(argv[1],"still-waves"))) return check_detail(argv[1]);
    if(argc==2 && (!strcmp(argv[1],"shallow-roll") || !strcmp(argv[1],"flat-pitch") ||
        !strcmp(argv[1],"straight-trail"))) return check_attitude(argv[1]);
    if(argc==2 && (!strcmp(argv[1],"no-fall") || !strcmp(argv[1],"no-plume") ||
        !strcmp(argv[1],"no-hit-smoke"))) return check_effects(argv[1]);
    if(argc==2 && (!strcmp(argv[1],"freeze-targets") || !strcmp(argv[1],"no-lock"))) return check_combat(argv[1],0);
    if(argc==2 && !strcmp(argv[1],"world")) return check_world("");
    if(argc==2 && (!strcmp(argv[1],"frozen-position") || !strcmp(argv[1],"frozen-hud")))
        return check_world(argv[1]);
    if(argc==2 && (!strcmp(argv[1],"reverse") || !strcmp(argv[1],"offset") ||
        !strcmp(argv[1],"short-wings") || !strcmp(argv[1],"no-tails") || !strcmp(argv[1],"frozen-pitch")))
        return check_airframe(argv[1]);
    return input_error("arguments",0);
}
