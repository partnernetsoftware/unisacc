/* tools/matrix-waive.cx -- record owner-approved known gaps in the domain matrices, with a check that the record and the
 * matrices agree.  A waived cell stays in the matrix (state and evidence untouched) so the gap stays traceable; it only
 * stops counting as required.
 *
 *   sh ./unisacc.com tools/matrix-waive.cx -- ROOT WAIVERS.tsv --check          verify (exit 1 on any disagreement)
 *   sh ./unisacc.com tools/matrix-waive.cx -- ROOT WAIVERS.tsv OUT_DIR          write OUT_DIR/<matrix>-domain-matrix.tsv
 *                                                                              for every matrix a waiver touches
 * WAIVERS.tsv (# comments; TAB separated):
 *   R  ID  TEXT                       a reason: who approved, where the gap goes, what the release notes say
 *   W  ID  MATRIX  HOST  CELL|*       waive CELL (or every cell of HOST) of tests/MATRIX-domain-matrix.tsv
 * Apply: a matching row that is required (column 3 `yes`) and not COVERED_LOCAL gets column 3 `no` and its
 * requirement text (column 6) ends with " [waived ID: TEXT]"; COVERED_LOCAL rows are never waived (they are evidence).
 * Check: every W matches at least one row; every matched non-covered row is waived by that W (required=no and the
 * marker present); no row carries a "[waived " marker that no W accounts for.  It never writes into tests/. */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.sig
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

#define MAXW 64
#define MAXR 16
typedef struct { char id[16], text[512]; } Reason;
typedef struct { char rid[16], matrix[48], host[24], cell[128]; int hits; } Waiver;
static Reason reasons[MAXR]; static int nr;
static Waiver w[MAXW]; static int nw;

static void die(const char *a, const char *b) { sy_eprintf("matrix-waive: %s%s%s\n", a, b ? ": " : "", b ? b : ""); sy_exit(2); }
static int col(const char *s, long n, int idx, char *out, long cap) {
    long off, len; if (tx_field(s, n, '\t', idx, &off, &len) || tx_copy(out, cap, s + off, len)) return 0; return 1;
}
static const Reason *reason(const char *id) { int i; for (i = 0; i < nr; i++) if (tx_eqz(reasons[i].id, id)) return &reasons[i]; return 0; }

static void load(const char *path) {
    size_t n; char *t = cx_read(path, &n); long at = 0;
    if (!t) die("cannot read", path);
    while (at < (long)n) {
        long e = tx_chr(t + at, (long)n - at, '\n'), l = e < 0 ? (long)n - at : e; const char *s = t + at; char kind[4];
        at += l + 1;
        if (!l || s[0] == '#') continue;
        if (!col(s, l, 0, kind, sizeof kind)) die("bad row", s);
        if (tx_eqz(kind, "R")) { if (nr == MAXR || !col(s, l, 1, reasons[nr].id, 16) || !col(s, l, 2, reasons[nr].text, 512)) die("bad R row", s); nr++; }
        else if (tx_eqz(kind, "W")) { if (nw == MAXW || !col(s, l, 1, w[nw].rid, 16) || !col(s, l, 2, w[nw].matrix, 48) || !col(s, l, 3, w[nw].host, 24) || !col(s, l, 4, w[nw].cell, 128) || !reason(w[nw].rid)) die("bad W row (unknown reason?)", s); nw++; }
        else die("row kind is R or W", s);
    }
    mm_free(t);
}

typedef struct { char *p; long n, cap; } Out;
static void put(Out *o, const char *s, long n) {
    if (o->n + n + 1 > o->cap) { long c = (o->n + n + 1) * 2 + 4096; char *g = o->p ? mm_grow(o->p, c) : mm_alloc(c); if (!g) die("out of memory", 0); o->p = g; o->cap = c; }
    tx_copy(o->p + o->n, o->cap - o->n, s, n); o->n += n;
}

/* find the waiver that covers (matrix, host, cell), or -1 */
static int cover(const char *matrix, const char *host, const char *cell) {
    int i; for (i = 0; i < nw; i++) if (tx_eqz(w[i].matrix, matrix) && tx_eqz(w[i].host, host) && (tx_eqz(w[i].cell, "*") || tx_eqz(w[i].cell, cell))) return i;
    return -1;
}

/* walk one matrix: apply (out != 0) or check; returns the number of disagreements */
static int walk(const char *root, const char *matrix, Out *out) {
    char path[4400]; size_t n; char *t; long at = 0; int bad = 0;
    if (cx_fmt(path, sizeof path, "%s/tests/%s-domain-matrix.tsv", root, matrix)) die("path", matrix);
    t = cx_read(path, &n); if (!t) die("cannot read", path);
    while (at < (long)n) {
        long e = tx_chr(t + at, (long)n - at, '\n'), l = e < 0 ? (long)n - at : e; const char *s = t + at;
        char host[24], cell[128], req[8], state[40], text[4096]; int wi; long off, len;
        at += l + 1;
        if (!l || s[0] == '#' || !col(s, l, 0, host, sizeof host) || !col(s, l, 1, cell, sizeof cell) || !col(s, l, 2, req, sizeof req) || !col(s, l, 3, state, sizeof state)) { if (out) { put(out, s, l); put(out, "\n", 1); } continue; }
        wi = cover(matrix, host, cell);
        if (wi < 0) {
            if (tx_find(s, l, "[waived ", 8) >= 0) { sy_printf("DISAGREE\t%s\t%s\t%s\tmarker without a waiver\n", matrix, host, cell); bad++; }
            if (out) { put(out, s, l); put(out, "\n", 1); }
            continue;
        }
        w[wi].hits++;
        if (tx_eqz(state, "COVERED_LOCAL")) { if (out) { put(out, s, l); put(out, "\n", 1); } continue; }   /* evidence stays */
        {   char mark[600]; int has;
            if (cx_fmt(mark, sizeof mark, " [waived %s: %s]", w[wi].rid, reason(w[wi].rid)->text)) die("reason too long", w[wi].rid);
            has = tx_find(s, l, mark, tx_len(mark, sizeof mark)) >= 0;
            if (!out) { if (!tx_eqz(req, "no") || !has) { sy_printf("DISAGREE\t%s\t%s\t%s\tnot waived (required=%s)\n", matrix, host, cell, req); bad++; } continue; }
            if (tx_eqz(req, "no") && has) { put(out, s, l); put(out, "\n", 1); continue; }   /* already waived */
            /* rebuild: column 3 -> no, column 6 gets the marker */
            {   long c, nc = tx_fields(s, l, '\t'), mc = nc > 5 ? 5 : nc - 1;   /* the marker goes to the requirement text, or to the last column of a short row */
                for (c = 0; ; c++) {
                    if (tx_field(s, l, '\t', c, &off, &len)) break;
                    if (c) put(out, "\t", 1);
                    if (c == 2) put(out, "no", 2);
                    else { put(out, s + off, len); if (c == mc) put(out, mark, tx_len(mark, sizeof mark)); }
                }
                put(out, "\n", 1); }
            (void)text;
        }
    }
    mm_free(t);
    return bad;
}

int main(int argc, char **argv) {
    int i, bad = 0, check; char seen[MAXW][48]; int ns = 0;
    if (argc != 4) { sy_eprintf("usage: matrix-waive.cx ROOT WAIVERS.tsv --check | OUT_DIR\n"); return 2; }
    check = tx_eqz(argv[3], "--check");
    load(argv[2]);
    for (i = 0; i < nw; i++) {
        int k, dup = 0; for (k = 0; k < ns; k++) if (tx_eqz(seen[k], w[i].matrix)) dup = 1;
        if (dup) continue;
        tx_copy(seen[ns++], 48, w[i].matrix, tx_len(w[i].matrix, 48));
        if (check) bad += walk(argv[1], w[i].matrix, 0);
        else {
            Out o = {0, 0, 0}; char path[4400];
            bad += walk(argv[1], w[i].matrix, &o);
            if (cx_fmt(path, sizeof path, "%s/%s-domain-matrix.tsv", argv[3], w[i].matrix) || cx_write(path, o.p, (size_t)o.n)) die("cannot write", path);
            mm_free(o.p);
        }
    }
    for (i = 0; i < nw; i++) if (!w[i].hits) { sy_printf("DISAGREE\t%s\t%s\t%s\twaiver matches no row\n", w[i].matrix, w[i].host, w[i].cell); bad++; }
    {   int total = 0; for (i = 0; i < nw; i++) total += w[i].hits; sy_printf("MATRIX_WAIVE\t%s\twaivers=%d\tmatched_rows=%d\tdisagree=%d\n", check ? "check" : "apply", nw, total, bad); }
    return bad ? 1 : 0;
}
