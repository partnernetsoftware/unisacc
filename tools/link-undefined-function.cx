/* tools/link-undefined-function.cx -- linker contract (prd.md:771, R20-3): a unit whose `.extern` function no unit or
 * archive member defines must be refused at link time, not linked into an image that crashes.
 *   sh ./unisacc.com tools/link-undefined-function.cx -- ROOT ABS_OUT
 * This batch is the minimal repro itself (2026-10-28, cc; fable ruling: own batch, expectation never relaxed):
 *   main.c = `int used(void); int main(void){return used()+2;}`  ->  `-c -b lnx/x86_64 -funit -o main.o main.c` (rc 0)
 *   `-o img main.o`            expected: rc != 0, stderr `link: undefined reference to used`, no img
 *   `-o img2 main.o none.a`    (archive whose only member defines `unused`) expected: the same refusal
 *   `-o img3 main.c`           (direct C route) expected: the same refusal
 * Observed on f3705dfa and on the classic REF 0ed46192: rc 0, image written, SIGSEGV when run (shared defect, not a
 * regression; cause src/tapelink.c:351 tl_check_undef checks only `g_*` data externs). The crash is recorded as INFO,
 * never executed unbounded (tools/bound 5). See plans/defects-c43.md link.undef-function-refusal. */
#pragma unisa use cxlib.netpack

static char root[4096], outdir[4096], product[4400], bound[4400]; static int npass, nfail; static FILE *res;
static void die(const char *s) { fprintf(stderr, "link-undefined-function: REFUSE %s errno=%d\n", s, errno); exit(2); }
static void path(char *p, size_t cap, const char *a, const char *b) { int n = snprintf(p, cap, "%s/%s", a, b); if (n < 0 || (size_t)n >= cap) die("path"); }
static void saved(const char *p, const char *s, size_t n) { int f = open(p, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600); if (f < 0) die("exclusive create"); while (n) { ssize_t k = write(f, s, n); if (k <= 0) die("write"); s += k; n -= (size_t)k; } if (close(f)) die("close"); }
static void check(int ok, const char *label, const char *detail) { fprintf(res, "%s\tlink.undef-function-refusal.%s\t%s\n", ok ? "PASS" : "FAIL", label, detail); printf("%s\t%s\n", ok ? "PASS" : "FAIL", label); if (ok) npass++; else nfail++; }
static int prod(char *const extra[], np_result *r) { char *v[16]; int n = 0; v[n++] = "sh"; v[n++] = product; for (int i = 0; extra[i]; i++) { if (n >= 15) die("argv"); v[n++] = extra[i]; } v[n] = 0; char why[1024]; return np_run(v, outdir, 0, 20, r, why, sizeof why); }
static void refusal(const char *label, char *const argv[], const char *img, int fail) { np_result r; if (prod(argv, &r)) { check(0, label, "transport"); return; }
    char p[4400]; path(p, sizeof p, outdir, img); struct stat st; int absent = lstat(p, &st) && errno == ENOENT; if (!absent && errno != 0 && lstat(p, &st)) die("lstat");
    int named = r.errn && strstr(r.err, "undefined reference to used") != 0; char d[320]; { if (cx_fmt(d, sizeof d, "rc=%d image-absent=%d named=%d stderr=%.*s", r.rc, absent, named, (int)(r.errn > 120 ? 120 : r.errn), r.err)) { fprintf(stderr, "link-undefined-function: text too long for d\n"); exit(2); } } for (char *q = d; *q; q++) if (*q == '\n') *q = ' ';
    check(fail ? (r.rc && absent && named) : (!r.rc && !absent && !named), label, d);
    if (!absent) { if (chmod(p, 0700)) die("chmod"); char *e[] = { bound, "5", p, 0 }; np_result x; char why[1024]; if (!np_run(e, outdir, 0, 7, &x, why, sizeof why)) { fprintf(res, "INFO\tlink.undef-function-refusal.%s.image-run\trc=%d (crash expected while the defect stands)\n", label, x.rc); np_free(&x); } }
    np_free(&r); }

int main(int argc, char **argv) {
    if (argc != 3 || !realpath(argv[1], root) || argv[2][0] != '/') { fputs("usage: ROOT ABS_OUT\n", stderr); return 2; }
    { if (cx_fmt(outdir, sizeof outdir, "%s", argv[2])) { fprintf(stderr, "link-undefined-function: text too long for outdir\n"); exit(2); } } if (mkdir(outdir, 0700)) die("new out dir must be absent"); path(product, sizeof product, root, "unisacc.com"); path(bound, sizeof bound, root, "tools/bound");
    char rp[4400]; path(rp, sizeof rp, outdir, "results.tsv"); res = fopen(rp, "wbx"); if (!res) die("results");
    { size_t n; char *b = cx_read(product, &n); if (!b) die("product"); char h[65]; cx_sha256_hex(b, n, h); free(b); fprintf(res, "IDENTITY\tcandidate=%s\n", h); }
    const char *M = "int used(void);int main(void){return used()+2;}\n", *U = "int unused(void){return 99;}\n"; char p[4400];
    path(p, sizeof p, outdir, "main.c"); saved(p, M, strlen(M)); path(p, sizeof p, outdir, "unused.c"); saved(p, U, strlen(U));
    { char *v[] = { "-c", "-b", "lnx/x86_64", "-funit", "-o", "main.o", "main.c", 0 }; np_result r; if (prod(v, &r) || r.rc) die("main.o"); np_free(&r); char *w[] = { "-c", "-b", "lnx/x86_64", "-funit", "-o", "unused.o", "unused.c", 0 }; if (prod(w, &r) || r.rc) die("unused.o"); np_free(&r); char *a[] = { "ar", "rcs", "none.a", "unused.o", 0 }; if (prod(a, &r) || r.rc) die("none.a"); np_free(&r); }
    { char *v[] = { "-o", "img", "main.o", 0 }; refusal("object-only", v, "img", 1); }
    { char *v[] = { "-o", "img2", "main.o", "none.a", 0 }; refusal("archive-without-definition", v, "img2", 1); }
    { char *v[] = { "-o", "img3", "main.c", 0 }; refusal("direct-c-route", v, "img3", 1); }
    /* a.c prototypes used and calls it; b.c defines it. -o of both must link, not report undefined reference. */
    { path(p, sizeof p, outdir, "a.c"); saved(p, "int used(void);int main(void){return used();}\n", 46);
      path(p, sizeof p, outdir, "b.c"); saved(p, "int used(void){return 7;}\n", 26);
      char *v[] = { "-o", "imgm", "a.c", "b.c", 0 }; refusal("multi-file-defined", v, "imgm", 0); }
    /* cross-archive order (found 2026-10-28): m2 needs outer (in A.a); outer needs inner (in B.a). `m2.o A.a B.a` works
       (106); `m2.o B.a A.a` must be refused the same way (inner never pulled: archives are scanned once, in order,
       like ld) -- today it links a crashing image. The working order is asserted so the row is not vacuous. */
    { const char *S[3][2] = { { "in.c", "int inner(void){return 3;}\n" }, { "out.c", "int inner(void);int outer(void){return inner()*2;}\n" }, { "m2.c", "int outer(void);int main(void){return 100+outer();}\n" } };
      for (int i = 0; i < 3; i++) { path(p, sizeof p, outdir, S[i][0]); saved(p, S[i][1], strlen(S[i][1])); char o[16]; { if (cx_fmt(o, sizeof o, "%.*s.o", (int)strlen(S[i][0]) - 2, S[i][0])) { fprintf(stderr, "link-undefined-function: text too long for o\n"); exit(2); } } char *v[] = { "-c", "-b", "lnx/x86_64", "-funit", "-o", o, (char *)S[i][0], 0 }; np_result r; if (prod(v, &r) || r.rc) die("unit"); np_free(&r); }
      { char *a[] = { "ar", "rcs", "A.a", "out.o", 0 }, *b[] = { "ar", "rcs", "B.a", "in.o", 0 }; np_result r; if (prod(a, &r) || r.rc) die("A.a"); np_free(&r); if (prod(b, &r) || r.rc) die("B.a"); np_free(&r); }
      { char *v[] = { "-o", "ok", "m2.o", "A.a", "B.a", 0 }; np_result r; if (prod(v, &r)) die("ok"); int rc = r.rc; np_free(&r); char q[4400]; path(q, sizeof q, outdir, "ok"); int x = -1; if (!rc) { if (chmod(q, 0700)) die("chmod"); char *e[] = { bound, "5", q, 0 }; char why[1024]; np_result y; if (!np_run(e, outdir, 0, 7, &y, why, sizeof why)) { x = y.rc; np_free(&y); } }
        char d[100]; { if (cx_fmt(d, sizeof d, "link rc=%d run rc=%d want 106", rc, x)) { fprintf(stderr, "link-undefined-function: text too long for d\n"); exit(2); } } check(!rc && x == 106, "cross-archive-order.working-order", d); }
      { char *v[] = { "-o", "img4", "m2.o", "B.a", "A.a", 0 }; np_result r; if (prod(v, &r)) { check(0, "cross-archive-order.reversed-refused", "transport"); }
        else { char q[4400]; path(q, sizeof q, outdir, "img4"); struct stat st; int absent = lstat(q, &st) && errno == ENOENT; int named = r.errn && strstr(r.err, "undefined reference to inner") != 0; char d[320]; { if (cx_fmt(d, sizeof d, "rc=%d image-absent=%d named=%d stderr=%.*s", r.rc, absent, named, (int)(r.errn > 120 ? 120 : r.errn), r.err)) { fprintf(stderr, "link-undefined-function: text too long for d\n"); exit(2); } } for (char *z = d; *z; z++) if (*z == '\n') *z = ' ';
          check(r.rc && absent && named, "cross-archive-order.reversed-refused", d); if (!absent) { if (chmod(q, 0700)) die("chmod"); char *e[] = { bound, "5", q, 0 }; char why[1024]; np_result y; if (!np_run(e, outdir, 0, 7, &y, why, sizeof why)) { fprintf(res, "INFO\tlink.undef-function-refusal.cross-archive-order.image-run\trc=%d (crash expected while the defect stands)\n", y.rc); np_free(&y); } } np_free(&r); } } }
    fprintf(res, "SUMMARY\tpass=%d\tfail=%d\n", npass, nfail); fclose(res); printf("LINK_UNDEF_REFUSAL\tpass=%d\tfail=%d\n", npass, nfail); return nfail ? 1 : 0;
}
