#pragma unisa use sys.io
#pragma unisa use text.text
/* Project the os and arch columns of exec/facts/pp-targets.tsv onto
   name tables. The six pairs stay on targetname.
   sh ./unisacc.com tools/axis-gen.cx -- --check
   sh ./unisacc.com tools/axis-gen.cx -- --write
   The fact table is the only name list. First-seen order in each column.
   Exactly six unique pairs, three operating systems, two architectures.
   A null out-pointer returns 4. An index outside 0..count-1 returns 2.
   No libc and no include. */
#define TSV "exec/facts/pp-targets.tsv"
#define NPAIR 6
#define NOS 3
#define NARCH 2
#define NAMEMAX 32
#define FILECAP 2048
#define CHECKCAP 8192

static char pair_os[NPAIR][NAMEMAX];
static char pair_arch[NPAIR][NAMEMAX];
static char oses[NOS][NAMEMAX];
static char arches[NARCH][NAMEMAX];
static int npair;
static int nos;
static int narch;

static int fail(const char *why) {
    sy_eprintf("axis-gen\tFAIL\t%s\n", why);
    return 1;
}

static int name_ok(const char *s, int n) {
    int i;
    if (n < 1 || n >= NAMEMAX) return 0;
    if (s[0] < 'a' || s[0] > 'z') return 0;
    for (i = 1; i < n; i++) {
        char c = s[i];
        if (c >= 'a' && c <= 'z') continue;
        if (c >= '0' && c <= '9') continue;
        if (c == '_') continue;
        return 0;
    }
    return 1;
}

static void copy_field(char *dst, const char *s, int n) {
    int i;
    for (i = 0; i < n; i++) dst[i] = s[i];
    dst[n] = 0;
}

static int push_unique(char names[][NAMEMAX], int *count, int cap, const char *s, const char *why) {
    int i;
    for (i = 0; i < *count; i++) if (tx_eqz(names[i], s)) return 0;
    if (*count >= cap) return fail(why);
    for (i = 0; s[i]; i++) names[*count][i] = s[i];
    names[*count][i] = 0;
    *count += 1;
    return 0;
}

static int push_pair(const char *os, const char *arch) {
    int i;
    if (npair >= NPAIR) return fail("pair-count");
    for (i = 0; i < npair; i++) {
        if (tx_eqz(pair_os[i], os) && tx_eqz(pair_arch[i], arch)) return fail("pair-dup");
    }
    for (i = 0; os[i]; i++) pair_os[npair][i] = os[i];
    pair_os[npair][i] = 0;
    for (i = 0; arch[i]; i++) pair_arch[npair][i] = arch[i];
    pair_arch[npair][i] = 0;
    npair++;
    return 0;
}

static int take_row(const char *line, int n) {
    const char *f[2];
    int len[2];
    int i, k, start;
    char os[NAMEMAX], arch[NAMEMAX];
    k = 0;
    start = 0;
    for (i = 0; i <= n; i++) {
        if (i == n || line[i] == '\t') {
            if (k >= 2) return fail("row-fields");
            f[k] = line + start;
            len[k] = i - start;
            k++;
            start = i + 1;
        }
    }
    if (k != 2) return fail("row-fields");
    if (!name_ok(f[0], len[0])) return fail("os-charset");
    if (!name_ok(f[1], len[1])) return fail("arch-charset");
    copy_field(os, f[0], len[0]);
    copy_field(arch, f[1], len[1]);
    if (push_pair(os, arch)) return 1;
    if (push_unique(oses, &nos, NOS, os, "os-count")) return 1;
    if (push_unique(arches, &narch, NARCH, arch, "arch-count")) return 1;
    return 0;
}

static int parse_tsv(char *b, size_t n) {
    size_t i = 0;
    int saw = 0;
    if (n == 0 || b[n - 1] != '\n') return fail("tsv-newline");
    while (i < n) {
        size_t e = i;
        while (e < n && b[e] != '\n') e++;
        b[e] = 0;
        if (e == i) return fail("tsv-blank");
        if (!saw) {
            if (!tx_eqz(b + i, "# os\tarch")) return fail("tsv-header");
            saw = 1;
        } else if (b[i] == '#') {
            return fail("tsv-comment");
        } else if (take_row(b + i, (int)(e - i))) {
            return 1;
        }
        i = e + 1;
    }
    if (npair != NPAIR) return fail("pair-count");
    if (nos != NOS) return fail("os-count");
    if (narch != NARCH) return fail("arch-count");
    return 0;
}

static int app(char *dst, int cap, int *n, const char *s) {
    int i = 0;
    while (s[i]) {
        if (*n + 1 >= cap) return -1;
        dst[*n] = s[i];
        *n += 1;
        i++;
    }
    dst[*n] = 0;
    return 0;
}

static int app_n(char *dst, int cap, int *n, int d) {
    char s[4];
    int k = 0;
    if (d < 0 || d > 99) return -1;
    if (d >= 10) s[k++] = (char)('0' + d / 10);
    s[k++] = (char)('0' + d % 10);
    s[k] = 0;
    return app(dst, cap, n, s);
}

static int emit_mod(char *dst, int cap, const char *mod, const char *prefix,
                     char names[][NAMEMAX], int count, const char *what) {
    int n = 0, i;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa module ")) return -1;
    if (app(dst, cap, &n, mod)) return -1;
    if (app(dst, cap, &n, "\n")) return -1;
    if (app(dst, cap, &n, "/* Generated by tools/axis-gen.cx from exec/facts/pp-targets.tsv.\n")) return -1;
    if (app(dst, cap, &n, "   Do not edit by hand. Names are the first-seen ")) return -1;
    if (app(dst, cap, &n, what)) return -1;
    if (app(dst, cap, &n, " column.\n")) return -1;
    if (app(dst, cap, &n, "   The six os/arch pairs stay on targetname.\n")) return -1;
    if (app(dst, cap, &n, "   A null out-pointer returns 4. An index outside 0..count-1 returns 2.\n")) return -1;
    if (app(dst, cap, &n, "   No libc and no include. */\n")) return -1;
    if (app(dst, cap, &n, "int ")) return -1;
    if (app(dst, cap, &n, prefix)) return -1;
    if (app(dst, cap, &n, "_count(void) {\n    return ")) return -1;
    if (app_n(dst, cap, &n, count)) return -1;
    if (app(dst, cap, &n, ";\n}\n")) return -1;
    if (app(dst, cap, &n, "int ")) return -1;
    if (app(dst, cap, &n, prefix)) return -1;
    if (app(dst, cap, &n, "_at(int index, const char **name) {\n")) return -1;
    if (app(dst, cap, &n, "    if (!name) return 4;\n")) return -1;
    for (i = 0; i < count; i++) {
        if (app(dst, cap, &n, "    if (index == ")) return -1;
        if (app_n(dst, cap, &n, i)) return -1;
        if (app(dst, cap, &n, ") { *name = \"")) return -1;
        if (app(dst, cap, &n, names[i])) return -1;
        if (app(dst, cap, &n, "\"; return 0; }\n")) return -1;
    }
    if (app(dst, cap, &n, "    return 2;\n}\n")) return -1;
    return n;
}

static int emit_side(char *dst, int cap, int *n, const char *prefix,
                      char names[][NAMEMAX], int count) {
    int i;
    if (app(dst, cap, n, "    if (")) return -1;
    if (app(dst, cap, n, prefix)) return -1;
    if (app(dst, cap, n, "_count() != ")) return -1;
    if (app_n(dst, cap, n, count)) return -1;
    if (app(dst, cap, n, ") return 1;\n")) return -1;
    for (i = 0; i < count; i++) {
        if (app(dst, cap, n, "    if (")) return -1;
        if (app(dst, cap, n, prefix)) return -1;
        if (app(dst, cap, n, "_at(")) return -1;
        if (app_n(dst, cap, n, i)) return -1;
        if (app(dst, cap, n, ", &name) || !tx_eqz(name, \"")) return -1;
        if (app(dst, cap, n, names[i])) return -1;
        if (app(dst, cap, n, "\")) return 1;\n")) return -1;
    }
    if (app(dst, cap, n, "    if (")) return -1;
    if (app(dst, cap, n, prefix)) return -1;
    if (app(dst, cap, n, "_at(0, missing) != 4) return 1;\n")) return -1;
    if (app(dst, cap, n, "    if (")) return -1;
    if (app(dst, cap, n, prefix)) return -1;
    if (app(dst, cap, n, "_at(-1, &name) != 2) return 1;\n")) return -1;
    if (app(dst, cap, n, "    if (")) return -1;
    if (app(dst, cap, n, prefix)) return -1;
    if (app(dst, cap, n, "_at(")) return -1;
    if (app_n(dst, cap, n, count)) return -1;
    if (app(dst, cap, n, ", &name) != 2) return 1;\n")) return -1;
    return 0;
}

static int emit_check(char *dst, int cap) {
    int n = 0;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa use compiler.osname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use runtime.osname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use compiler.archname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use runtime.archname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use sys.io\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use text.text\n")) return -1;
    if (app(dst, cap, &n, "/* Generated by tools/axis-gen.cx. Narrow check of os and arch names. */\n")) return -1;
    if (app(dst, cap, &n, "int main(void) {\n")) return -1;
    if (app(dst, cap, &n, "    const char *name;\n")) return -1;
    if (app(dst, cap, &n, "    const char **missing;\n")) return -1;
    if (app(dst, cap, &n, "    missing = 0;\n")) return -1;
    if (emit_side(dst, cap, &n, "osn", oses, nos)) return -1;
    if (emit_side(dst, cap, &n, "rsn", oses, nos)) return -1;
    if (emit_side(dst, cap, &n, "arc", arches, narch)) return -1;
    if (emit_side(dst, cap, &n, "rarc", arches, narch)) return -1;
    if (app(dst, cap, &n, "    sy_printf(\"CX_OS\\tok=")) return -1;
    if (app_n(dst, cap, &n, nos)) return -1;
    if (app(dst, cap, &n, "\\tfailed=0\\n\");\n")) return -1;
    if (app(dst, cap, &n, "    sy_printf(\"CX_ARCH\\tok=")) return -1;
    if (app_n(dst, cap, &n, narch)) return -1;
    if (app(dst, cap, &n, "\\tfailed=0\\n\");\n")) return -1;
    if (app(dst, cap, &n, "    return 0;\n}\n")) return -1;
    return n;
}

static int same_bytes(const char *a, size_t an, const char *b, int bn) {
    int i;
    if (an != (size_t)bn) return 0;
    for (i = 0; i < bn; i++) if (a[i] != b[i]) return 0;
    return 1;
}

static int one_file(int dowrite, const char *path, const char *body, int n) {
    size_t on = 0;
    char *cur;
    if (dowrite) {
        if (cx_write(path, body, (size_t)n)) return fail("write");
        return 0;
    }
    cur = cx_read(path, &on);
    if (!cur) return fail(path);
    if (!same_bytes(cur, on, body, n)) return fail(path);
    return 0;
}

int main(int argc, char **argv) {
    size_t nb = 0;
    char *b;
    char file[FILECAP], check[CHECKCAP];
    int dowrite, fn, cn;
    if (argc != 2 || (!tx_eqz(argv[1], "--check") && !tx_eqz(argv[1], "--write"))) {
        sy_eprintf("axis-gen\tusage\t--check|--write\n");
        return 2;
    }
    dowrite = tx_eqz(argv[1], "--write");
    b = cx_read(TSV, &nb);
    if (!b) return fail("tsv-read");
    if (parse_tsv(b, nb)) return 1;
    cn = emit_check(check, CHECKCAP);
    if (cn < 0) return fail("emit-check");
    fn = emit_mod(file, FILECAP, "osname", "osn", oses, nos, "os");
    if (fn < 0) return fail("emit-os-compiler");
    if (one_file(dowrite, "cx/compiler/osname.cx", file, fn)) return 1;
    fn = emit_mod(file, FILECAP, "osname", "rsn", oses, nos, "os");
    if (fn < 0) return fail("emit-os-runtime");
    if (one_file(dowrite, "cx/runtime/osname.cx", file, fn)) return 1;
    fn = emit_mod(file, FILECAP, "archname", "arc", arches, narch, "arch");
    if (fn < 0) return fail("emit-arch-compiler");
    if (one_file(dowrite, "cx/compiler/archname.cx", file, fn)) return 1;
    fn = emit_mod(file, FILECAP, "archname", "rarc", arches, narch, "arch");
    if (fn < 0) return fail("emit-arch-runtime");
    if (one_file(dowrite, "cx/runtime/archname.cx", file, fn)) return 1;
    if (one_file(dowrite, "tools/check-cx-axis.cx", check, cn)) return 1;
    if (dowrite) sy_printf("AXIS_GEN\tWROTE\tos=%d\tarch=%d\n", nos, narch);
    else sy_printf("AXIS_GEN\tCHECK\tos=%d\tarch=%d\n", nos, narch);
    return 0;
}
