#pragma unisa use chrome_dom

int main(void) {
    size_t size=0;
    unsigned char *tile=(unsigned char *)cx_read("ujs/practice/uxe/test/d3-masonry.rgba",&size);
    int ok=tile && size==64*64*4;
    int course,x,y;
    if(ok) for(course=0;course<4;course++) {
        int mortar=(course%2)*16, across=(mortar+8)%64;
        int row=course*16;
        /* Cross the center of the staggered vertical joint and the lower bed joint. */
        ok &= tile[(64*(row+8)+mortar)*4]<180;
        ok &= tile[(64*(row+8)+across)*4]>210;
        ok &= tile[(64*row+across)*4]<180;
    }
    if(ok) for(y=0;y<64;y++) for(x=0;x<64;x++) {
        int at=(y*64+x)*4;
        ok &= tile[at+3]==255 && tile[at+1]>=205 && tile[at+1]<=248;
    }
    if(tile) free(tile);
    printf("CHECK_GEN_D3_MASONRY\t%s\n",ok?"PASS":"FAIL");
    return ok?0:1;
}
