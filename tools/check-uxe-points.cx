#pragma unisa use chrome_dom
/* tools/check-uxe-points.cx -- 16 正视点中心应红.
 * sh ./unisacc.com tools/check-uxe-points.cx --
 */
static int failed;
static void ck(int ok, const char *lab) {
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", lab);
    if (!ok) failed++;
}
int main(void) {
    char cwd[512], url[700];
    const char *pre = "file://";
    const char *suf = "/ujs/practice/uxe/test/uxe-points.html";
    char *av[12];
    char *out = 0;
    size_t on = 0;
    int n, i, k, red = 0, rc;
    if (!getcwd(cwd, sizeof cwd)) return 2;
    n = 0;
    while (pre[n]) { url[n] = pre[n]; n++; }
    for (i = 0; cwd[i] && n < 500; i++) url[n++] = cwd[i];
    for (i = 0; suf[i] && n < 640; i++) url[n++] = suf[i];
    url[n] = 0;
    av[0] = "/usr/bin/google-chrome";
    av[1] = "--headless=new";
    av[2] = "--enable-unsafe-swiftshader";
    av[3] = "--allow-file-access-from-files";
    av[4] = "--disable-web-security";
    av[5] = "--no-first-run";
    av[6] = "--user-data-dir=/tmp/uxe-pts-chk";
    av[7] = "--virtual-time-budget=20000";
    av[8] = "--dump-dom";
    av[9] = url;
    av[10] = 0;
    rc = cx_runv_timeout(av, 25, &out, &on);
    if (rc == 127) { if (out) free(out); printf("POINTS_UNMEASURED\n"); return 2; }
    if (out) {
        const char *p = out;
        while (*p) {
            if (p[0] == '[' && p[1] >= '0' && p[1] <= '9') {
                int sx = 0, sy = 0, r = 0, g = 0, b = 0, a = 0;
                p++;
                while (*p >= '0' && *p <= '9') { sx = sx * 10 + *p - '0'; p++; }
                if (*p == ',') p++;
                while (*p >= '0' && *p <= '9') { sy = sy * 10 + *p - '0'; p++; }
                if (*p == ',') p++;
                while (*p >= '0' && *p <= '9') { r = r * 10 + *p - '0'; p++; }
                if (*p == ',') p++;
                while (*p >= '0' && *p <= '9') { g = g * 10 + *p - '0'; p++; }
                if (*p == ',') p++;
                while (*p >= '0' && *p <= '9') { b = b * 10 + *p - '0'; p++; }
                if (*p == ',') p++;
                while (*p >= '0' && *p <= '9') { a = a * 10 + *p - '0'; p++; }
                if (r >= 200 && g <= 20 && b <= 20) red++;
            } else p++;
        }
        free(out);
    }
    ck(red == 16, "points-16-red");
    printf("CHECK_UXE_POINTS\tred=%d\tfailed=%d\n", red, failed);
    return failed ? 1 : 0;
}
