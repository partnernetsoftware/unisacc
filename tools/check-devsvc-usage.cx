/* tools/check-devsvc-usage.cx -- 检查 devsvc-usage:固定夹具 events.tsv 与 jsonl 的计数断言。
 *
 *   sh ./unisacc.com tools/check-devsvc-usage.cx        (在仓根跑)
 *
 * 夹具写 /tmp/dvuck-<pid>/:events.tsv(owner=a 的 f 两条、x 一条;无 owner 的 git 一条;未知 kind 一条不计)
 *   与 proj/s1.jsonl(仓内 Read、仓外 Read、经 devsvc 的 Bash、直接 git、直接 sh ./unisacc.com、无关 ls、一行坏 JSON)。
 * 断言:(a) 事件计数;(b) 会话 devsvc=1 native=3 ratio=0.25;(c) 末行 DEVSVC_USAGE sessions=1 devsvc=1 native=3 ratio=0.25;
 *   (d) 样例列含 Read 路径;(e) 未知参数 rc 2。末行 CHECK_DEVSVC_USAGE<TAB>failed=N;有 FAIL 则 rc 1。 */
#pragma unisa use sys.time
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sysx.process
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use cxlib.ckassert

#define F(dst, cap, ...) do { if (snprintf(dst, cap, __VA_ARGS__) < 0) fputs("", stderr); } while (0)
static int nfail;
static char out[1 << 15], fx[160];
static void ca_local_assert(int c, const char *name) {
    printf("%s\tdevsvc-usage.%s\n", c ? "PASS" : "FAIL", name);
    if (!c) { printf("NOTE\tlast-output\t%.700s\n", out); nfail++; }
}

static int has(const char *s) { return strstr(out, s) != 0; }
static int wfile(const char *rel, const char *txt) { char p[400]; F(p, sizeof p, "%s/%s", fx, rel); return sy_write_atomic(p, (char *)txt, strlen(txt), 0644); }
#define TU(inp) "{\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"t\"," inp "}]}}\n"
int main(void) {
    char c[400], pr[400], ev[400], rt[400], wp[400]; int rc;
    F(fx, sizeof fx, "/tmp/dvuck-%d", sy_pid());
    F(c, sizeof c, "mkdir -p %s/proj %s/root", fx, fx);
    { char *v[] = {"sh", "-c", c, 0}; if (ck_run(v, out, sizeof out) != 0) { printf("FAIL\tdevsvc-usage.fixture\n"); return 1; } }
    wfile("events.tsv",
          "EV\t1\t100\tf.write\towner=a ok\nEV\t2\t101\tf.edit\towner=a ok\nEV\t3\t102\tx.run\towner=a\n"
          "EV\t4\t103\tgit.commit\tok\nEV\t5\t104\tzzz.other\towner=a\n");
    wfile("proj/s1.jsonl",
          TU("\"name\":\"Read\",\"input\":{\"file_path\":\"/rootfx/a.cx\"}")
          TU("\"name\":\"Read\",\"input\":{\"file_path\":\"/elsewhere/b.cx\"}")
          TU("\"name\":\"Bash\",\"input\":{\"command\":\"sh ./unisacc.com tools/devsvc.cx -- f read a\"}")
          TU("\"name\":\"Bash\",\"input\":{\"command\":\"cd /rootfx && git status\"}")
          TU("\"name\":\"Bash\",\"input\":{\"command\":\"sh ./unisacc.com tools/x.cx\"}")
          TU("\"name\":\"Bash\",\"input\":{\"command\":\"ls -la\"}")
          "{bad tool_use json\n");
    wfile("warn.tsv", "T\ts\tgit-write\tgit commit\nT\ts\tsleep-poll\tsleep 5\nT\ts\tgit-write\tgit push\n");
    F(wp, sizeof wp, "%s/warn.tsv", fx); F(pr, sizeof pr, "%s/proj", fx); F(ev, sizeof ev, "%s/events.tsv", fx);
    { char *v[] = {"sh", "./unisacc.com", "tools/devsvc-usage.cx", "--", "--hours", "1", "--proj", pr, "--events", ev, "--root", "/rootfx", "--warn", wp, 0}; rc = ck_run(v, out, sizeof out); }
    ca_local_assert(has("HOOKWARN\tgit-write\t2\n"), "hookwarn-git-write");
    ca_local_assert(has("HOOKWARN\tsleep-poll\t1\n"), "hookwarn-sleep-poll");
    ca_local_assert(rc == 0, "rc0");
    {   /* HOOKWARN 按 --hours 窗口:--now 1794700000 即 2026-11-14T23:46:40Z,窗口 1 小时;窗口外两行(当日 20:00、前一日)不计 */
        char w2[400]; int rc2;
        wfile("warn2.tsv", "2026-11-14T23:30:00.000Z\ts\tgit-write\tgit commit\n2026-11-14T20:00:00.000Z\ts\tgit-write\tgit push\n"
                           "2026-11-13T23:40:00.000Z\ts\tsleep-poll\tsleep 5\n2026-11-14T22:46:40.000Z\ts\tdirect-cx\tsh x\n"
                           "2026-11-14T22:46:39.000Z\ts\tdirect-cx\tsh y\n");
        F(w2, sizeof w2, "%s/warn2.tsv", fx);
        { char *v[] = {"sh", "./unisacc.com", "tools/devsvc-usage.cx", "--", "--hours", "1", "--now", "1794700000", "--proj", pr, "--events", ev, "--root", "/rootfx", "--warn", w2, 0}; rc2 = ck_run(v, out, sizeof out); }
        ca_local_assert(rc2 == 0 && has("HOOKWARN\tgit-write\t1\n"), "hookwarn-window-keeps-recent");
        ca_local_assert(!has("HOOKWARN\tsleep-poll\t"), "hookwarn-window-drops-old-rule");
        ca_local_assert(has("HOOKWARN\tdirect-cx\t1\n"), "hookwarn-window-boundary-inclusive");
        { char *v[] = {"sh", "./unisacc.com", "tools/devsvc-usage.cx", "--", "--hours", "48", "--now", "1794700000", "--proj", pr, "--events", ev, "--root", "/rootfx", "--warn", w2, 0}; rc2 = ck_run(v, out, sizeof out); }
        ca_local_assert(rc2 == 0 && has("HOOKWARN\tgit-write\t2\n") && has("HOOKWARN\tsleep-poll\t1\n") && has("HOOKWARN\tdirect-cx\t2\n"), "hookwarn-window-48h-all");
    }
    ca_local_assert(has("EVENTS\towner=a\tf=2\tx=1\tflow=0\tdoc=0\tgit=0\tlock=0\trun=0"), "events-owner-a");
    ca_local_assert(has("EVENTS\towner=-\tf=0\tx=0\tflow=0\tdoc=0\tgit=1\tlock=0\trun=0"), "events-no-owner");
    ca_local_assert(has("SESSION\ts1\tdevsvc=1\tnative=3\tratio=0.25"), "session-counts");
    ca_local_assert(has("\tRead:/rootfx/a.cx"), "sample-read");
    ca_local_assert(has("DEVSVC_USAGE sessions=1 devsvc=1 native=3 ratio=0.25\n"), "last-line");
    { char *v[] = {"sh", "./unisacc.com", "tools/devsvc-usage.cx", "--", "--bogus", "1", 0}; rc = ck_run(v, out, sizeof out); ca_local_assert(rc == 2, "bad-arg-rc2"); }
    F(rt, sizeof rt, "rm -rf %s", fx);
    { char *v[] = {"sh", "-c", rt, 0}; (void)ck_run(v, out, sizeof out); }
    printf("CHECK_DEVSVC_USAGE\tfailed=%d\n", nfail);
    return nfail ? 1 : 0;
}
