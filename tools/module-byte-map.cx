/* Hash-linked attribution of emitter contexts to final file bytes.
 * ORIGIN MERGED ROWS EPISODES RECORDS IMAGE; source is planned_source, not exclusive ownership.
 * No inference from proportion, symbol size, or final file layout alone.
 */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sys.time
#pragma unisa use text.text
#define MB_MAX 1000000
static long began;
static void mb_die(const char *s){fprintf(stderr,"MODULE_BYTE_MAP REFUSE %s\n",s);exit(2);}
static void mb_tick(void){if(sy_now_ms()-began>49000)mb_die("49 second deadline");}
static char *mb_load(const char *p,size_t *n,char hash[65]){struct stat st;mb_tick();if(stat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>134217728)mb_die("input extent/kind");char *b=cx_read(p,n);if(!b||*n!=(size_t)st.st_size)mb_die("read extent");if(sy_sha256_hex(b,(long)*n,hash))cx_sha256_hex(b,*n,hash);return b;}
static char *mb_line(char **p){char *s=*p;if(!*s)return 0;char *e=strchr(s,'\n');if(!e)mb_die("missing final LF");*e=0;*p=e+1;return s;}
static int mb_fields(char *s,char **v){int n=1;v[0]=s;for(;*s;s++)if(*s=='\t'){if(n==32)mb_die("columns");*s=0;v[n++]=s+1;}return n;}
static char *mb_kv(char **v,int n,const char *k){size_t z=strlen(k);char *out=0;for(int i=1;i<n;i++)if(!strncmp(v[i],k,z)&&v[i][z]=='='){if(out)mb_die("duplicate field");out=v[i]+z+1;}if(!out)mb_die("missing field");return out;}
static long mb_num(const char *s){if(!s||!*s)mb_die("number");if(!strcmp(s,"-1"))return -1;long n=0;for(;*s;s++){if(*s<'0'||*s>'9'||n>1000000000)mb_die("number");n=n*10+*s-'0';}return n;}
static long mb_n(char **v,int n,const char *k){return mb_num(mb_kv(v,n,k));}
static void mb_hash(char **v,int n,const char *k,const char *expected){if(strcmp(mb_kv(v,n,k),expected))mb_die("SHA chain");}
static void mb_span(long lo,long hi,long max){if(lo<0||hi<lo||hi>max)mb_die("range");}
static char *mb_text(char *b,size_t n){if(memchr(b,0,n)||memchr(b,'\r',n))mb_die("text NUL/CR");return b;}
typedef struct {long lo,hi,bytes,records;char *name;int synthetic;} MbUnit;
typedef struct {long lo,hi;int owner;} MbEntity;
typedef struct {long lo,hi;int owner;} MbEpisode;
static MbUnit units[2048];static int nu;
static MbEntity *entities;static long ne;
static MbEpisode *episodes;static long np;
static long sb[5],sr[5];
typedef struct {long lo,hi;int owner;} MbContext;
static MbContext *contexts;static long nc;static int whole;
static void mb_hexfield(char **v,int n,const char *key){char *p=mb_kv(v,n,key);if(strlen(p)!=64)mb_die("whole SHA shape");for(int i=0;i<64;i++)if(!((p[i]>='0'&&p[i]<='9')||(p[i]>='a'&&p[i]<='f')))mb_die("whole SHA hex");}
static void mb_whole(char *origin,char *tape,long length,const char *tapehash){
 char *at=origin,*s=mb_line(&at),*v[32];int n=s?mb_fields(s,v):0;
 if(n!=13||strcmp(v[0],"WHOLE_FUNCTION_ORIGIN")||strcmp(mb_kv(v,n,"version"),"1")||strcmp(mb_kv(v,n,"claim"),"emitter-context-not-exclusive-ownership"))mb_die("whole header");
 const char *keys[]={"material_sha","frames_sha","attrs_sha","original_units_sha","frame_manifest_sha","config_sha","watch_sha","output_sha","tape_sha","delta_sha"};for(int i=0;i<10;i++)mb_hexfield(v,n,keys[i]);
 mb_hash(v,n,"tape_sha",tapehash);mb_hash(v,n,"delta_sha","a985b1706b96659bd3951a44495e774d4eb3c969163845c7a63d9c225e6b1811");
 const char *profile="CT.afterfn\tunit_epoch,hl_pos,fns,fne\toutput-mark\nFN.nx\tunit_epoch,infunc\toutput-span\n";char expected[65];if(sy_sha256_hex(profile,strlen(profile),expected))cx_sha256_hex(profile,strlen(profile),expected);mb_hash(v,n,"config_sha",expected);
 contexts=calloc(100000,sizeof *contexts);if(!contexts)mb_die("whole context allocation");long cursor=0;int complete=0,body=0;
 while((s=mb_line(&at))){mb_tick();n=mb_fields(s,v);if(complete)mb_die("whole identity after tail");
  if(!strcmp(v[0],"UNIT")){
   if(body||n!=4||nu==128||mb_num(v[1])!=nu)mb_die("whole UNIT sequence/schema");char *name=mb_kv(v,n,"planned_source"),*kind=mb_kv(v,n,"kind");if(!*name||name[0]!='/'||strpbrk(name,"\t\r\n")||(strcmp(kind,"SOURCE")&&strcmp(kind,"SYNTHETIC")))mb_die("whole UNIT identity");for(int i=0;i<nu;i++)if(!strcmp(name,units[i].name))mb_die("whole duplicate source");units[nu].name=strdup(name);if(!units[nu].name)mb_die("unit allocation");units[nu].synthetic=!strcmp(kind,"SYNTHETIC");nu++;
  }else if(!strcmp(v[0],"CONTEXT")){
   body=1;if(n!=7||!nu||nc==100000||mb_num(v[1])!=nc)mb_die("whole CONTEXT sequence/schema");long unit=mb_n(v,n,"unit"),lo=mb_n(v,n,"lo"),hi=mb_n(v,n,"hi"),saved=mb_n(v,n,"survived");mb_span(lo,hi,length);if(unit<0||unit>=nu||saved<0||saved>1||lo!=cursor)mb_die("whole CONTEXT order/range");mb_hexfield(v,n,"sha");char actual[65];if(sy_sha256_hex(tape+lo,hi-lo,actual))cx_sha256_hex(tape+lo,hi-lo,actual);if((!strcmp(actual,mb_kv(v,n,"sha")))!=saved)mb_die("whole context survival SHA");contexts[nc++]=(MbContext){lo,hi,saved?(units[unit].synthetic?-3:(int)unit):-1};cursor=hi;
  }else if(!strcmp(v[0],"UNKNOWN")){
   body=1;if(n!=3||!nu)mb_die("whole UNKNOWN schema");long lo=mb_n(v,n,"lo"),hi=mb_n(v,n,"hi");mb_span(lo,hi,length);if(lo!=cursor||hi==lo)mb_die("whole UNKNOWN order/range");cursor=hi;
  }else if(!strcmp(v[0],"COMPLETE")){
   if(n!=5||!nu||mb_n(v,n,"units")!=nu||mb_n(v,n,"contexts")!=nc||mb_n(v,n,"tape_bytes")!=length||cursor!=length)mb_die("whole tail count/extent");mb_hash(v,n,"tape_sha",tapehash);complete=1;
  }else mb_die("whole origin row");
 }
 if(!complete)mb_die("whole identity missing tail");
}

/* -1 UNKNOWN, -2 SHARED, -3 SYNTHETIC; modules are nonnegative unit indices. */
static int mb_owner(long lo,long hi,long total){if(lo<0||hi<lo||hi>total)return -1;if(whole){if(hi==lo)return -1;long l=0,r=nc;while(l<r){long m=(l+r)/2;if(contexts[m].lo<=lo)l=m+1;else r=m;}if(!l)return -1;MbContext *c=&contexts[l-1];return lo>=c->lo&&hi<=c->hi?c->owner:-1;}for(int i=0;i<nu;i++)if(lo>=units[i].lo&&hi<=units[i].hi&&hi>lo)return i;return -1;}
static int mb_join(int a,int b){if(a==-1||b==-1)return -1;if(a==b)return a;return -2;}
int main(int argc,char **argv){began=sy_now_ms();whole=argc==8&&!strcmp(argv[1],"--whole-context");if(argc!=7&&!whole)mb_die("usage [--whole-context] ORIGIN MERGED ROWS EPISODES RECORDS IMAGE");if(whole)argv++;char h[6][65];size_t size[6];char *b[6];for(int i=0;i<6;i++)b[i]=mb_load(argv[i+1],&size[i],h[i]);for(int i=0;i<5;i++)if(i!=1)mb_text(b[i],size[i]);
 char *at,*s,*v[32];int n;long synlo=-1,synhi=-1;int complete=0;
 if(whole)mb_whole(b[0],b[1],size[1],h[1]);else{
 at=b[0];s=mb_line(&at);n=s?mb_fields(s,v):0;if(!n||strcmp(v[0],"TAPE_ORIGIN"))mb_die("origin header");mb_hash(v,n,"tape_sha",h[1]);if(mb_n(v,n,"bytes")!=(long)size[1])mb_die("merged bytes");long origin_end=0;
 while((s=mb_line(&at))){n=mb_fields(s,v);if(complete)mb_die("origin after tail");if(!strcmp(v[0],"ORDER_INPUT"))continue;if(!strcmp(v[0],"UNIT")){if(nu==2048||n<3||mb_num(v[1])!=nu)mb_die("unit sequence");MbUnit *u=&units[nu];u->lo=mb_n(v,n,"lo");u->hi=mb_n(v,n,"hi");mb_span(u->lo,u->hi,(long)size[1]);if(u->lo!=origin_end||synlo>=0)mb_die("origin overlap/gap");u->name=strdup(mb_kv(v,n,"planned_source"));if(!u->name||!*u->name||strpbrk(u->name,"\t\r\n"))mb_die("planned source");origin_end=u->hi;nu++;}else if(!strcmp(v[0],"SYNTHETIC")){if(synlo>=0)mb_die("duplicate synthetic");synlo=mb_n(v,n,"lo");synhi=mb_n(v,n,"hi");mb_span(synlo,synhi,(long)size[1]);if(synlo!=origin_end)mb_die("synthetic gap");origin_end=synhi;}else if(!strcmp(v[0],"COMPLETE")){if(mb_n(v,n,"units")!=nu||mb_n(v,n,"sum")!=(long)size[1]||origin_end!=(long)size[1])mb_die("origin tail");mb_hash(v,n,"tape_sha",h[1]);complete=1;}else mb_die("origin row");}if(!complete)mb_die("origin tail missing");}
 entities=calloc(MB_MAX,sizeof *entities);episodes=calloc(MB_MAX,sizeof *episodes);if(!entities||!episodes)mb_die("allocation");at=b[2];s=mb_line(&at);n=s?mb_fields(s,v):0;if(!n||strcmp(v[0],"LOWER_ROW_ID"))mb_die("rows header");mb_hash(v,n,"source_sha",h[1]);char outputsha[65];(cx_fmt(outputsha, sizeof outputsha, "%s", mb_kv(v,n,"output_sha")) ? exit(2) : (void)0);long codebytes=mb_n(v,n,"code_bytes"),codeend=0;complete=0;
 while((s=mb_line(&at))){n=mb_fields(s,v);if(complete)mb_die("rows after tail");if(!strcmp(v[0],"ENTITY")){if(ne==MB_MAX||n<2||mb_num(v[1])!=ne)mb_die("ENTITY sequence");long cl=mb_n(v,n,"code_lo"),ch=mb_n(v,n,"code_hi"),lo=mb_n(v,n,"source_lo"),hi=mb_n(v,n,"source_hi");mb_span(cl,ch,codebytes);mb_span(lo,hi,(long)size[1]);if(cl!=codeend)mb_die("ENTITY code overlap/gap");codeend=ch;MbEntity *e=&entities[ne++];e->lo=lo;e->hi=hi;e->owner=lo>=synlo&&hi<=synhi&&hi>lo?-3:mb_owner(lo,hi,(long)size[1]);}else if(!strcmp(v[0],"LOWER_ROW_ORIGIN")){if(mb_n(v,n,"entities")!=ne||mb_n(v,n,"rows")!=ne||mb_n(v,n,"code_bytes")!=codebytes||codeend!=codebytes)mb_die("rows tail");complete=1;}else mb_die("rows row");}if(!complete)mb_die("rows tail missing");
 at=b[3];s=mb_line(&at);n=s?mb_fields(s,v):0;if(!n||strcmp(v[0],"LOWER_EPISODE_ID"))mb_die("episodes header");mb_hash(v,n,"rows_sha",h[2]);mb_hash(v,n,"output_sha",outputsha);long targetend=0,ecount=0,unknowncount=0,unknownbytes=0;complete=0;
 while((s=mb_line(&at))){n=mb_fields(s,v);if(complete)mb_die("episodes after tail");if(!strcmp(v[0],"EPISODE")||!strcmp(v[0],"UNKNOWN")){if(np==MB_MAX)mb_die("episode bound");long lo=mb_n(v,n,"target_lo"),hi=mb_n(v,n,"target_hi");mb_span(lo,hi,67108864);if(lo!=targetend||hi==lo)mb_die("episode target overlap/gap");int owner=-1;if(!strcmp(v[0],"EPISODE")){if(n<2||mb_num(v[1])!=ecount++)mb_die("episode sequence");long nl=mb_n(v,n,"nc_lo"),nh=mb_n(v,n,"nc_hi");mb_span(nl,nh,ne);char *rule=mb_kv(v,n,"rule");long expected=!strcmp(rule,"GENERIC")?1:!strcmp(rule,"PF")||!strcmp(rule,"PL")||!strcmp(rule,"AI")?2:!strcmp(rule,"AF")?4:0;if(!expected||nh-nl!=expected)mb_die("episode rule/count");if(nh==nl||mb_n(v,n,"source0_lo")!=entities[nl].lo||mb_n(v,n,"source0_hi")!=entities[nl].hi)mb_die("episode ENTITY mismatch");long s1l=mb_n(v,n,"source1_lo"),s1h=mb_n(v,n,"source1_hi");if(nh-nl==1?(s1l!=-1||s1h!=-1):(s1l!=entities[nl+1].lo||s1h!=entities[nl+1].hi))mb_die("episode ENTITY second mismatch");if(expected==4)for(int j=2;j<4;j++){char key[32];(cx_fmt(key, sizeof key, "source%d_lo", j) ? exit(2) : (void)0);long lo=mb_n(v,n,key);(cx_fmt(key, sizeof key, "source%d_hi", j) ? exit(2) : (void)0);if(lo!=entities[nl+j].lo||mb_n(v,n,key)!=entities[nl+j].hi)mb_die("episode ENTITY ARM mismatch");}owner=entities[nl].owner;for(long j=nl+1;j<nh;j++)owner=mb_join(owner,entities[j].owner);}else{unknowncount++;unknownbytes+=hi-lo;}episodes[np].lo=lo;episodes[np].hi=hi;episodes[np++].owner=owner;targetend=hi;}else if(!strcmp(v[0],"LOWER_EPISODES")){if(mb_n(v,n,"episodes")!=ecount||mb_n(v,n,"uncovered_target_bytes")!=unknownbytes)mb_die("episodes tail");complete=1;}else mb_die("episode row");}if(!complete)mb_die("episodes tail missing");
 at=b[4];s=mb_line(&at);n=s?mb_fields(s,v):0;if(!n||strcmp(v[0],"ENCODER_RECORD_ID"))mb_die("records header");mb_hash(v,n,"target_sha",outputsha);mb_hash(v,n,"image_sha",h[5]);long nr=0,textend=0,filebase=-1,lasttarget=0,ep=0;long headerlo=-1,headerhi=-1,datalo=-1,datahi=-1;int others=0;complete=0;
 while((s=mb_line(&at))){n=mb_fields(s,v);if(complete)mb_die("records after tail");if(!strcmp(v[0],"RECORD")){if(others||n<2||mb_num(v[1])!=nr)mb_die("record sequence");long tl=mb_n(v,n,"target_lo"),th=mb_n(v,n,"target_hi"),xl=mb_n(v,n,"text_lo"),xh=mb_n(v,n,"text_hi"),fl=mb_n(v,n,"file_lo"),fh=mb_n(v,n,"file_hi");mb_span(tl,th,targetend);mb_span(xl,xh,(long)size[5]);mb_span(fl,fh,(long)size[5]);if(tl<lasttarget||th==tl||xl!=textend||xh-xl!=fh-fl)mb_die("record overlap/gap");if(filebase<0)filebase=fl-xl;if(fl!=filebase+xl||fh!=filebase+xh)mb_die("record file mapping");lasttarget=th;textend=xh;while(ep<np&&episodes[ep].hi<=tl)ep++;int owner=ep<np&&tl>=episodes[ep].lo&&th<=episodes[ep].hi?episodes[ep].owner:-1;long bytes=fh-fl;if(owner>=0){units[owner].bytes+=bytes;units[owner].records++;}else{int k=-owner-1;sb[k]+=bytes;sr[k]++;}nr++;}else if(!strcmp(v[0],"OTHER")){if(n<2)mb_die("other schema");long lo=mb_n(v,n,"file_lo"),hi=mb_n(v,n,"file_hi");mb_span(lo,hi,(long)size[5]);if(!strcmp(v[1],"HEADER")&&others==0){headerlo=lo;headerhi=hi;}else if(!strcmp(v[1],"DATA_OR_ALIGN")&&others==1){datalo=lo;datahi=hi;}else mb_die("other order");others++;}else if(!strcmp(v[0],"ENCODER_RECORD_ORIGIN")){if(mb_n(v,n,"records")!=nr||mb_n(v,n,"text_bytes")!=textend||mb_n(v,n,"image_bytes")!=(long)size[5])mb_die("records tail");complete=1;}else mb_die("record row");}if(!complete)mb_die("records tail missing");if(nr==0){if(targetend||textend)mb_die("empty record target");filebase=headerhi;}if(lasttarget>targetend||others!=2||headerlo!=0||headerhi!=filebase||datalo!=filebase+textend||datahi!=(long)size[5])mb_die("file coverage");
 long total=headerhi-headerlo+datahi-datalo;for(int i=0;i<nu;i++)total+=units[i].bytes;for(int i=0;i<3;i++)total+=sb[i];if(total!=(long)size[5])mb_die("byte conservation");mb_tick();printf("MODULE_BYTE_ID\torigin_sha=%s\tmerged_sha=%s\trows_sha=%s\tepisodes_sha=%s\trecords_sha=%s\timage_sha=%s\tclaim=emitter-context-not-exclusive-ownership\n",h[0],h[1],h[2],h[3],h[4],h[5]);for(int i=0;i<nu;i++)printf("MODULE\t%s\tbytes=%ld\trecords=%ld\tunit=%d\n",units[i].name,units[i].bytes,units[i].records,i);const char *tags[]={"UNKNOWN","SHARED","SYNTHETIC"};for(int i=0;i<3;i++)printf("%s\tbytes=%ld\trecords=%ld\n",tags[i],sb[i],sr[i]);printf("OTHER\tHEADER\tbytes=%ld\nOTHER\tDATA_OR_ALIGN\tbytes=%ld\nMODULE_BYTE_MAP\timage_bytes=%ld\taccounted_bytes=%ld\trecords=%ld\tzero_records=INCLUDED\tstate=CONSERVED\n",headerhi-headerlo,datahi-datalo,(long)size[5],total,nr);return 0;}
