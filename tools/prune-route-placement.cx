#pragma unisa use sys.time
#pragma unisa use sys.hostid
/* tools/prune-route-placement.cx -- stream-prune cell prune.route.placement (prd S3.2 prune row: image and -run routes
 * call prune before lower; public -S/-c do not).
 *   sh ./unisacc.com tools/prune-route-placement.cx -- ROOT ABS_OUT
 * Fixture A has a dead static function with unique literals (99, 12345); fixture B is A without it. Oracles:
 *   s-keeps-dead: `-S` of A still names `dead:` and carries the literal 12345 (unpruned E4 output);
 *   c-keeps-dead: `-c` of A still carries the `dead` symbol name;
 *   image-prunes: the image of A is byte-equal to the image of B (the dead body left no bytes), and runs with exit 7;
 *   run-prunes: `-run` of A exits 7 (the route accepts the dead function and executes main);
 *   s-from-b-differs: `-S` of B differs from `-S` of A (the comparison is not vacuous).
 * O0 placement (image of A at -O0 vs B at -O0) is recorded as INFO, not asserted: the prd row names the route, not the
 * optimisation level. */
#pragma unisa use cxlib.netpack

static char root[4096], outdir[4096], product[4400]; static int npass, nfail; static FILE *res;
static void die(const char *s) { fprintf(stderr, "prune-route-placement: REFUSE %s errno=%d\n", s, errno); exit(2); }
static void path(char *p, size_t cap, const char *a, const char *b) { int n = snprintf(p, cap, "%s/%s", a, b); if (n < 0 || (size_t)n >= cap) die("path"); }
static void saved(const char *p, const char *s, size_t n) { int f = open(p, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600); if (f < 0) die("exclusive create"); while (n) { ssize_t k = write(f, s, n); if (k <= 0) die("write"); s += k; n -= (size_t)k; } if (close(f)) die("close"); }
static void check(int ok, const char *label, const char *detail) { fprintf(res, "%s\tprune.route.placement.%s\t%s\n", ok ? "PASS" : "FAIL", label, detail); printf("%s\t%s\n", ok ? "PASS" : "FAIL", label); if (ok) npass++; else nfail++; }
static int prod(char *const extra[], np_result *r) { char *v[16]; int n = 0; v[n++] = "sh"; v[n++] = product; for (int i = 0; extra[i]; i++) { if (n >= 15) die("argv"); v[n++] = extra[i]; } v[n] = 0; char why[1024]; return np_run(v, root, 0, 20, r, why, sizeof why); }
static int compile3(const char *flag, const char *out, const char *in, const char *opt) { char *v[] = { (char *)flag, "-o", (char *)out, (char *)in, (char *)opt, 0 }; if (!opt) v[4] = 0; np_result r; if (prod(v, &r)) return -1; int rc = r.rc; np_free(&r); return rc; }
static char *load(const char *p, size_t *n) { char *b = cx_read(p, n); if (!b) die(p); return b; }
static int has(const char *hay, size_t n, const char *needle) { size_t k = strlen(needle); for (size_t i = 0; i + k <= n; i++) if (!memcmp(hay + i, needle, k)) return 1; return 0; }

static unsigned long long po_get(const unsigned char*p,int n){unsigned long long v=0;for(int i=n-1;i>=0;i--)v=(v<<8)|p[i];return v;}
static int po_span(size_t n,unsigned long long a,unsigned long long z){return a<=n&&z<=n-a;}
static int po_line(const char*p,size_t n,const char*want){size_t z=strlen(want);for(size_t a=0;a<n;){size_t e=a;while(e<n&&p[e]!='\n')e++;if(e==n)return 0;if(e-a==z&&!memcmp(p+a,want,z))return 1;a=e+1;}return 0;}
static int po_elf(const unsigned char*p,size_t n,const char*target,const char*name){if(n<64||memcmp(p,"\177ELF\2\1\1",7)||po_get(p+16,2)!=1||po_get(p+18,2)!=(strstr(target,"arm64")?183:62)||po_get(p+58,2)!=64)return 0;unsigned long long sh=po_get(p+40,8),count=po_get(p+60,2);if(!count||count>4096||!po_span(n,sh,count*64))return 0;int matches=0;for(unsigned long long i=0;i<count;i++){const unsigned char*s=p+sh+i*64;unsigned long long type=po_get(s+4,4),off=po_get(s+24,8),len=po_get(s+32,8);if(type!=8&&!po_span(n,off,len))return 0;if(type!=2)continue;unsigned long long link=po_get(s+40,4);if(po_get(s+56,8)!=24||len%24||link>=count)return 0;const unsigned char*str=p+sh+link*64;unsigned long long so=po_get(str+24,8),sn=po_get(str+32,8);if(po_get(str+4,4)!=3||!po_span(n,so,sn))return 0;for(unsigned long long k=0;k<len;k+=24){const unsigned char*q=p+off+k;unsigned long long ni=po_get(q,4),sec=po_get(q+6,2);if(ni>=sn||!memchr(p+so+ni,0,sn-ni))return 0;if(!strcmp((const char*)p+so+ni,name)){if((q[4]>>4)>1||((q[4]&15)!=0&&(q[4]&15)!=2)||sec==0||sec>=count)return 0;const unsigned char*body=p+sh+sec*64;if(po_get(body+4,4)!=1||!(po_get(body+8,8)&4)||po_get(q+8,8)>=po_get(body+32,8))return 0;printf("INFO\tELF_SYMBOL\tname=%s\tbinding=%s\ttype=%d\tdefined=1\tqualification=NO_SYSTEM_LINK_CLAIM\n",name,(q[4]>>4)?"GLOBAL":"LOCAL",q[4]&15);matches++;}}}return matches==1;}
static const char *po_payload;static size_t po_payload_n;
static int po_unit_defined(const unsigned char*p,size_t n,const char*target,const char*name,int exported){po_payload=0;po_payload_n=0;int arm=strstr(target,"arm64")!=0;unsigned long long off=0,len=0;int found=0;if(!strncmp(target,"lnx/",4)){if(n<64||memcmp(p,"\177ELF\2\1\1",7)||po_get(p+16,2)!=1||po_get(p+18,2)!=(arm?183:62)||po_get(p+58,2)!=64)return 0;unsigned long long sh=po_get(p+40,8),ns=po_get(p+60,2),ni=po_get(p+62,2);if(!ns||ns>4096||ni>=ns||!po_span(n,sh,ns*64))return 0;const unsigned char*str=p+sh+ni*64;unsigned long long so=po_get(str+24,8),sn=po_get(str+32,8);if(po_get(str+4,4)!=3||!po_span(n,so,sn))return 0;for(unsigned long long i=0;i<ns;i++){const unsigned char*q=p+sh+i*64;unsigned long long nameoff=po_get(q,4),a=po_get(q+24,8),b=po_get(q+32,8);if(nameoff>=sn||!memchr(p+so+nameoff,0,sn-nameoff))return 0;if(!strcmp((const char*)p+so+nameoff,".unisa.tape")){if(po_get(q+4,4)!=1||!po_span(n,a,b))return 0;off=a;len=b;found++;}}}else if(!strncmp(target,"osx/",4)){if(n<32||po_get(p,4)!=0xfeedfacfULL||po_get(p+4,4)!=(arm?0x100000cULL:0x1000007ULL)||po_get(p+12,4)!=1)return 0;unsigned long long count=po_get(p+16,4),end=32+po_get(p+20,4),at=32;if(end>n||count>4096)return 0;for(unsigned long long i=0;i<count;i++){if(!po_span(end,at,8))return 0;unsigned long long cmd=po_get(p+at,4),z=po_get(p+at+4,4);if(z<8||!po_span(end,at,z))return 0;if(cmd==25){if(z<72)return 0;unsigned long long ns=po_get(p+at+64,4);if(ns>4096||72+ns*80!=z)return 0;for(unsigned long long k=0;k<ns;k++){const unsigned char*s=p+at+72+k*80;unsigned long long a=po_get(s+48,4),b=po_get(s+40,8);if(!po_span(n,a,b))return 0;if(!memcmp(s,"__unisa_tape\0",13)&&!memcmp(s+16,"__UNISA\0",8)){off=a;len=b;found++;}}}at+=z;}if(at!=end)return 0;}else if(!strncmp(target,"win/",4)){if(n<20||po_get(p,2)!=(arm?0xaa64:0x8664)||po_get(p+16,2))return 0;unsigned long long ns=po_get(p+2,2);if(!ns||ns>4096||!po_span(n,20,ns*40))return 0;for(unsigned long long i=0;i<ns;i++){const unsigned char*s=p+20+i*40;unsigned long long a=po_get(s+20,4),b=po_get(s+16,4);if(!po_span(n,a,b))return 0;if(!memcmp(s,".unisatp",8)){off=a;len=b;found++;}}}else return 0;if(found!=1||!po_span(n,off,len))return 0;char header[100];if(cx_fmt(header,sizeof header,"UNISATAPE1 %s ",target))return 0;size_t hn=strlen(header);if(len<=hn||memcmp(p+off,header,hn))return 0;unsigned long long at=off+hn,end=off+len,declared=0;int digits=0;while(at<end&&p[at]>='0'&&p[at]<='9'){unsigned d=p[at++]-'0';if(declared>(len-d)/10)return 0;declared=declared*10+d;digits++;}if(!digits||at>=end||p[at++]!='\n'||declared!=end-at||memchr(p+at,0,declared)||!declared||p[end-1]!='\n')return 0;char global[150],definition[150];if(cx_fmt(global,sizeof global,".global %s",name)||cx_fmt(definition,sizeof definition,"%s:",name))return 0;po_payload=(const char*)p+at;po_payload_n=(size_t)declared;return po_line((const char*)p+at,declared,".unit 2")&&(!exported||po_line((const char*)p+at,declared,global))&&po_line((const char*)p+at,declared,definition);}
static int po_unit(const unsigned char*p,size_t n,const char*target,const char*name){return po_unit_defined(p,n,target,name,1);}
static int po_symbol(const unsigned char*p,size_t n,const char*target,const char*name){return !strncmp(target,"lnx/",4)?po_elf(p,n,target,name):po_unit(p,n,target,name);}
static long po_until;static int po_callno;static char po_models[4400],po_env[4500];
static void po_hash(const char*p,char h[65]){size_t n;char*b=load(p,&n);cx_sha256_hex(b,n,h);free(b);}
static int po_compile(const char*input,const char*output,const char*target,const char*opt,int bare,int unit,const char*flag){if(po_until-sy_now_ms()<9000){check(0,"object-child-window","NOT_RUN insufficient full 8 second child window");return 3;}char *v[20];int k=0;size_t pn;char*pb=load(product,&pn);int native=pn>=4&&(!memcmp(pb,"\177ELF",4)||po_get((unsigned char*)pb,4)==0xfeedfacfULL);free(pb);if(!native)v[k++]="sh";v[k++]=product;v[k++]=(char*)flag;if(unit)v[k++]="-funit";if(!bare){v[k++]="-b";v[k++]=(char*)target;}v[k++]=(char*)opt;v[k++]="-o";v[k++]=(char*)output;v[k++]=(char*)input;v[k]=0;char *env[]={po_env,"UNISACC_CTOR=","UNISACC_RF_CAPTURE=",0};np_result r={0};char why[1000];long began=sy_now_ms();int tr=np_run(v,root,env,8,&r,why,sizeof why);char p[4400],name[100],row[1600];if(cx_fmt(name,sizeof name,"compile-%d.stdout",po_callno))die("object log");path(p,sizeof p,outdir,name);saved(p,r.out?r.out:"",r.outn);if(cx_fmt(name,sizeof name,"compile-%d.stderr",po_callno))die("object log");path(p,sizeof p,outdir,name);saved(p,r.err?r.err:"",r.errn);if(cx_fmt(row,sizeof row,"rc\t%d\ntransport\t%d\nresidue\t%d\nelapsed_ms\t%ld\nreason\t%s\n",r.rc,tr,r.residue,sy_now_ms()-began,tr?why:"-"))die("object status");if(cx_fmt(name,sizeof name,"compile-%d.status.tsv",po_callno++))die("object log");path(p,sizeof p,outdir,name);saved(p,row,strlen(row));int ok=!tr&&!r.rc&&!r.residue&&!r.outn;np_free(&r);return ok?0:2;}
static int po_objects(int argc,char**argv){if((argc!=7&&argc!=8)||!realpath(argv[2],root)||argv[3][0]!='/'||!realpath(argv[4],product)||!realpath(argv[5],po_models))die("usage --objects ROOT NEW_OUT DUT MODELS TARGET [source|tape|both|bare]");const char*targets[]={"lnx/x86_64","lnx/arm64","osx/x86_64","osx/arm64","win/x86_64","win/arm64"};int known=0;for(int i=0;i<6;i++)known|=!strcmp(targets[i],argv[6]);if(!known)die("unknown object target");const char*mode=argc==8?argv[7]:"both";if(strcmp(mode,"source")&&strcmp(mode,"tape")&&strcmp(mode,"both")&&strcmp(mode,"bare"))die("object mode");if(!strcmp(mode,"bare")&&strcmp(argv[6],tn_self()))die("bare-c target must equal actual host");if(cx_fmt(outdir,sizeof outdir,"%s",argv[3])||mkdir(outdir,0700)||cx_fmt(po_env,sizeof po_env,"UNISA_CONTAINER=%s",po_models))die("new object output or environment");char p[4400],src[4400],tape[4400],object[4400];path(p,sizeof p,outdir,"results.tsv");res=fopen(p,"wbx");if(!res)die("object results");char before[2][65],after[65];po_hash(product,before[0]);po_hash(po_models,before[1]);fprintf(res,"IDENTITY\tdut=%s\tmodels=%s\ttarget=%s\tmode=%s\n",before[0],before[1],argv[6],mode);po_until=sy_now_ms()+45000;path(src,sizeof src,outdir,"external.c");const char*fixture="static int dead(int x){return x*99+12345;}\nint ext_f(void){return 37;}\nint main(void){return 7;}\n";saved(src,fixture,strlen(fixture));path(tape,sizeof tape,outdir,"external.tape");int tape_rc=0;if(!strcmp(mode,"both")||!strcmp(mode,"tape")){char unitobj[4400];path(unitobj,sizeof unitobj,outdir,"tape-source-unit.o");tape_rc=po_compile(src,unitobj,argv[6],"-O2",0,1,"-c");size_t un=0;char*ub=tape_rc?0:cx_read(unitobj,&un);if(!ub||!po_unit((unsigned char*)ub,un,argv[6],"ext_f"))tape_rc=2;else{saved(tape,po_payload,po_payload_n);char sh[65],th[65];cx_sha256_hex(ub,un,sh);cx_sha256_hex(po_payload,po_payload_n,th);fprintf(res,"TAPE_SOURCE\tunit_sha=%s\ttape_sha=%s\ttarget=%s\tcommand=source-c-funit-O2\n",sh,th,argv[6]);}free(ub);check(!tape_rc,"tape-input-prepared","strictly extracted same-target real source -c -funit payload with export metadata");} int pending=0;for(int input=0;input<3;input++){if((!input&&!strcmp(mode,"tape"))||(input==1&&(!strcmp(mode,"source")||!strcmp(mode,"bare")))||(input==2&&strcmp(mode,"both")))continue;if(input==1&&tape_rc)continue;for(int opt=0;opt<3;opt++){char option[10],label[150],name[100];if(cx_fmt(option,sizeof option,"-O%d",opt)||cx_fmt(name,sizeof name,"%s-O%d.o",input==2?"unit":input?"tape":"source",opt)||cx_fmt(label,sizeof label,"%s.%s-O%d.external-definition-retained",argv[6],input==2?"unit":input?"tape":"source",opt))die("object name");path(object,sizeof object,outdir,name);int rc=po_compile(input==1?tape:src,object,argv[6],option,!strcmp(mode,"bare"),input==2,"-c");if(rc==3){pending=1;break;}size_t n=0;char*b=rc?0:cx_read(object,&n);int ok=b&&(input==2?po_unit((unsigned char*)b,n,argv[6],"ext_f"):po_symbol((unsigned char*)b,n,argv[6],"ext_f"))&&(input==2?po_unit((unsigned char*)b,n,argv[6],"main"):po_symbol((unsigned char*)b,n,argv[6],"main"));if(input==2&&b)ok=ok&&po_unit_defined((unsigned char*)b,n,argv[6],"dead",0);check(ok,label,rc?"compile failed; transcript retained":"defined external symbol in independently parsed object");free(b);}if(pending)break;}po_hash(product,after);check(!strcmp(before[0],after),"object-dut-stable","before/after content SHA");po_hash(po_models,after);check(!strcmp(before[1],after),"object-models-stable","before/after content SHA");fprintf(res,"SUMMARY\tpass=%d\tfail=%d\tpending=%d\n",npass,nfail,pending);if(fclose(res))die("object results close");printf("PRUNE_OBJECT_EXTERNAL\tpass=%d\tfail=%d\tpending=%d\ttarget=%s\n",npass,nfail,pending,argv[6]);return pending?3:nfail?1:0;}
int main(int argc, char **argv) {if(argc>1&&!strcmp(argv[1],"--objects"))return po_objects(argc,argv);if(argc==5&&!strcmp(argv[1],"--oracle")){size_t z;char*b=load(argv[2],&z);int ok=po_symbol((unsigned char*)b,z,argv[3],argv[4]);free(b);printf("PRUNE_OBJECT_ORACLE\tok=%d\n",ok);return ok?0:1;}

    if (argc != 3 || !realpath(argv[1], root) || argv[2][0] != '/') { fputs("usage: ROOT ABS_OUT\n", stderr); return 2; }
    { if (cx_fmt(outdir, sizeof outdir, "%s", argv[2])) { fprintf(stderr, "prune-route-placement: text too long for outdir\n"); exit(2); } } if (mkdir(outdir, 0700)) die("new out dir must be absent"); path(product, sizeof product, root, "unisacc.com");
    char rp[4400]; path(rp, sizeof rp, outdir, "results.tsv"); res = fopen(rp, "wbx"); if (!res) die("results");
    { size_t n; char *b = load(product, &n); char h[65]; cx_sha256_hex(b, n, h); free(b); fprintf(res, "IDENTITY\tcandidate=%s\n", h); }
    const char *A = "static int dead(int x){return x*99+12345;}\nint main(void){return 7;}\n", *B = "int main(void){return 7;}\n";
    char ac[4400], bc[4400], as[4400], bs[4400], ao[4400], ai[4400], bi[4400], a0[4400], b0[4400];
    path(ac, sizeof ac, outdir, "a.c"); path(bc, sizeof bc, outdir, "b.c"); saved(ac, A, strlen(A)); saved(bc, B, strlen(B));
    path(as, sizeof as, outdir, "a.tape"); path(bs, sizeof bs, outdir, "b.tape"); path(ao, sizeof ao, outdir, "a.o"); path(ai, sizeof ai, outdir, "a.img"); path(bi, sizeof bi, outdir, "b.img"); path(a0, sizeof a0, outdir, "a0.img"); path(b0, sizeof b0, outdir, "b0.img");
    if (compile3("-S", as, ac, 0) || compile3("-S", bs, bc, 0) || compile3("-c", ao, ac, 0) || compile3("-o", ai, ac, 0) == -1) die("routes");
    size_t n; char *t = load(as, &n); check(has(t, n, "dead:") && has(t, n, "12345"), "s-keeps-dead", "-S names dead: and carries literal 12345"); free(t);
    t = load(ao, &n); check(has(t, n, "dead"), "c-keeps-dead", "-c object carries the dead symbol name"); free(t);
    { size_t na, nb; char *x = load(as, &na), *y = load(bs, &nb); check(na != nb || memcmp(x, y, na), "s-from-b-differs", "-S of A differs from -S of B"); free(x); free(y); }
    { np_result r; char *v[] = { "-o", ai, ac, 0 }; if (prod(v, &r)) die("image A"); int rc = r.rc; np_free(&r); char *w[] = { "-o", bi, bc, 0 }; if (prod(w, &r)) die("image B"); int rb = r.rc; np_free(&r);
      size_t na, nb; char *x = rc || rb ? 0 : load(ai, &na), *y = rc || rb ? 0 : load(bi, &nb); char d[160]; { if (cx_fmt(d, sizeof d, "image rc A=%d B=%d bytes %zu/%zu", rc, rb, x ? na : 0, y ? nb : 0)) { fprintf(stderr, "prune-route-placement: text too long for d\n"); exit(2); } }
      check(x && y && na == nb && !memcmp(x, y, na), "image-prunes.byte-equal-without-dead", d); free(x); free(y);
      if (chmod(ai, 0700)) die("chmod"); char bound[4400]; path(bound, sizeof bound, root, "tools/bound"); char *e[] = { bound, "5", ai, 0 }; char why[1024]; if (np_run(e, root, 0, 7, &r, why, sizeof why)) die("exec"); { if (cx_fmt(d, sizeof d, "rc=%d stdout=%zu", r.rc, r.outn)) { fprintf(stderr, "prune-route-placement: text too long for d\n"); exit(2); } } check(r.rc == 7 && !r.outn, "image-prunes.executes-7", d); np_free(&r); }
    { np_result r; char *v[] = { "-run", ac, 0 }; if (prod(v, &r)) die("run"); char d[80]; { if (cx_fmt(d, sizeof d, "rc=%d stdout=%zu", r.rc, r.outn)) { fprintf(stderr, "prune-route-placement: text too long for d\n"); exit(2); } } check(r.rc == 7 && !r.outn, "run-prunes.executes-7", d); np_free(&r); }
    { int ra = compile3("-O0", a0, ac, 0), rb = compile3("-O0", b0, bc, 0); size_t na = 0, nb = 0; char *x = ra || rb ? 0 : cx_read(a0, &na), *y = ra || rb ? 0 : cx_read(b0, &nb); fprintf(res, "INFO\tprune.route.placement.o0-image\trc A=%d B=%d byte-equal=%d (route-level placement; level not asserted)\n", ra, rb, x && y && na == nb && !memcmp(x, y, na)); free(x); free(y); }
    fprintf(res, "SUMMARY\tpass=%d\tfail=%d\n", npass, nfail); fclose(res); printf("PRUNE_ROUTE_PLACEMENT\tpass=%d\tfail=%d\n", npass, nfail); return nfail ? 1 : 0;
}
