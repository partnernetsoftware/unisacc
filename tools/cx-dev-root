#!/bin/sh
# tools/cx-dev-root DIR -- a fake repo root whose unisacc.com is cx-dev (NOT_RELEASE, scope LOCAL).
#   sh tools/cx-dev-root /tmp/cxd-root && cd /tmp/cxd-root && sh ./unisacc.com tools/check-random-expr.cx
# Every top-level entry of the checkout is a symlink into it (unisacc.com, out and .git are not); unisacc.com is a
# wrapper that execs tools/cx-dev, so any check or batch that runs `sh ./unisacc.com ...` from DIR runs the
# private package (nets rebuilt from the worktree) instead of the installed product.  Needs a built cx-dev
# (sh ./unisacc.com tools/cx-dev.cx -- --build).  The result is LOCAL evidence, never a candidate result.
set -eu
REPO=$(cd "$(dirname "$0")/.." && pwd)
D=${1:?usage: cx-dev-root DIR}
mkdir -p "$D"
for e in "$REPO"/* "$REPO"/.[!.]*; do
  [ -e "$e" ] || continue
  n=$(basename "$e")
  case $n in unisacc.com|out|.git|.claude) continue;; esac
  ln -sfn "$e" "$D/$n"
done
printf '#!/bin/sh\nUNISACC_LOCAL=1 exec sh %s/tools/cx-dev "$@"\n' "$REPO" > "$D/unisacc.com"
chmod +x "$D/unisacc.com"
echo "CXDEV_ROOT	$D	repo=$REPO"
