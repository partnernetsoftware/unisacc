/* Hand-built consistency fixtures, not historical model execution evidence. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sysx.process
#pragma unisa use mem.bytes
static char dir[4400],com[4400],tool[4400],mat[4400],frames[4400],units[4400],cfg[4400],watch[4400],output[4400],dest[4400];static int checks,bad;
static const char *model="a985b1706b96659bd3951a44495e774d4eb3c969163845c7a63d9c225e6b1811",*profile="CT.afterfn\tunit_epoch,hl_pos,fns,fne\toutput-mark\nFN.nx\tunit_epoch,infunc\toutput-span\n";
static void die(void){exit(2);}static void put(const char *p,const void *b,long n){if(cx_write(p,b,n))die();}static void hash(const void *b,long n,char h[65]){cx_sha256_hex(b,n,h);}static void w(char *b,long *n,long v){for(int i=0;i<4;i++)b[(*n)++]=(unsigned char)(v>>(8*i));}static void bytes(char *b,long *n,const char *s,long z){mm_copy(b+*n, z, s, z);*n+=z;}
static void fixture(int mode){char pp[64],fr[256],u[256],at[4]={0},carrier[300],b[8192],path[4400];long pn=0,fn=0,un=0,cn=0;
 bytes(pp,&pn,"UNIPP1\0",7);w(pp,&pn,2);for(int i=0;i<4;i++)w(pp,&pn,0);bytes(pp,&pn,"a\n",2);
 w(fr,&fn,4+5+8+4+pn+1);w(fr,&fn,5);bytes(fr,&fn,"/a.cx",5);long pl=fn;bytes(fr,&fn,"UNITOK1\0",8);w(fr,&fn,pn);bytes(fr,&fn,pp,pn);bytes(fr,&fn,"X",1);
 bytes(u,&un,"UNITOK2\0",8);w(u,&un,1);w(u,&un,5);bytes(u,&un,"/a.cx",5);w(u,&un,pn);bytes(u,&un,pp,pn);
 bytes(u,&un,"@",1);w(u,&un,0);w(u,&un,0);bytes(u,&un,"\n@unit0\n",8);long hl=un;bytes(u,&un,"@",1);w(u,&un,0);w(u,&un,0);bytes(u,&un,"\nid=x\n",6);long ns=hl+13,ne=ns+1;bytes(u,&un,"@",1);w(u,&un,0);w(u,&un,2);bytes(u,&un,"\neof\n",5);
 bytes(carrier,&cn,"USLATTRT",8);w(carrier,&cn,4);bytes(carrier,&cn,at,4);bytes(carrier,&cn,fr,fn);
 char fh[65],ah[65],ch[65],ph[65],uh[65],gh[65],oh[65],span[65],mh[65];hash(fr,fn,fh);hash(at,4,ah);hash(carrier,cn,ch);hash(fr+pl,fn-pl,ph);hash(u,un,uh);hash(profile,strlen(profile),gh);hash(mode==1?"y\n":"x\n",2,oh);hash("x\n",2,span);
 (cx_fmt(path, sizeof path, "%s/frames.bin", mat) ? exit(2) : (void)0);put(path,fr,fn);(cx_fmt(path, sizeof path, "%s/attrs.bin", mat) ? exit(2) : (void)0);put(path,at,4);(cx_fmt(path, sizeof path, "%s/units-input.carrier", mat) ? exit(2) : (void)0);put(path,carrier,cn);
 (cx_fmt(b,sizeof b,"WHOLE_STAGE_MATERIAL\tframes_sha=%s\tframes_bytes=%ld\tattrs_sha=%s\tattrs_bytes=4\tattributes=0\tcarrier_sha=%s\nFRAME\t0\tpath=/a.cx\tframe_lo=0\tframe_hi=%ld\tpayload_lo=%ld\tpayload_bytes=%ld\tpayload_sha=%s\nCOMPLETE\tframes=1\tattributes=0\tcarrier_sha=%s\n",fh,fn,ah,ch,fn,pl,fn-pl,ph,ch)?exit(2):(void)0);(cx_fmt(path, sizeof path, "%s/material.tsv", mat) ? exit(2) : (void)0);put(path,b,strlen(b));put(units,u,un);put(cfg,profile,strlen(profile));put(output,mode==1?"y\n":"x\n",2);(cx_fmt(path, sizeof path, "%s/frame-2.bin", frames) ? exit(2) : (void)0);put(path,u,un);
 (cx_fmt(b,sizeof b,"WATCH_FRAME_EXPORT\tversion=1\tdelta_sha=%s\tinput_sha=%s\tconfig_sha=%s\toutput_sha=%s\toutput_bytes=2\nFRAME\t2\tfile=frame-2.bin\tsha=%s\tend=%ld\nCOMPLETE\tframes=1\tbytes=%ld\n",model,uh,gh,oh,uh,un,un)?exit(2):(void)0);hash(b,strlen(b),mh);(cx_fmt(path, sizeof path, "%s/manifest.tsv", frames) ? exit(2) : (void)0);put(path,b,strlen(b));
 (cx_fmt(b,sizeof b,"WRITE_EVENTS\tversion=1\tdelta_sha=%s\tinput_sha=%s\tconfig_sha=%s\toutput_sha=%s\toutput_bytes=2\tclaim=STATE_OBSERVATION_ONLY\twatch_format=compact-v1\tsnapshot_policy=single-active-output-v1\tframe_manifest_sha=%s\nFRAME\t1\t2\t%s\t%ld\nWATCHC\t2\t0\t2\t0\t0\t0\t0\t0\t%ld\t%ld\t%ld\t%ld\nOUTPUT_MARK\t3\tmark_seq=3\tframe_instance=2\tframe_sha=%s\tframe_end=%ld\toutput_generation=0\toutput_lo=0\nWATCHC\t4\t1\t2\t0\t0\t2\t0\t0\t0\t1\nOUTPUT_SPAN\t5\tmark_seq=3\tframe_instance=2\tframe_sha=%s\tframe_end=%ld\toutput_generation=0\toutput_lo=0\toutput_hi=2\tspan_sha=%s\nCOMPLETE\tevents=%d\n",mode==6?uh:model,uh,gh,oh,mh,uh,un,mode==2?1L:0L,mode==3?hl+1:hl,ns,ne,uh,un,uh,un,span,mode==4?4:5)?exit(2):(void)0);put(watch,b,strlen(b));if(mode==5){(cx_fmt(path, sizeof path, "%s/frame-2.bin", frames) ? exit(2) : (void)0);put(path,"bad",3);}}
static void change(const char *file,const char *old,const char *value){size_t n;char *b=cx_read(file,&n),*at=b?strstr(b,old):0;if(!at||strstr(at+strlen(old),old))die();long lo=at-b,a=strlen(old),v=strlen(value);char *out=malloc(n-a+v);if(!out)die();mm_copy(out, lo, b, lo);mm_copy(out+lo, v, value, v);mm_copy(out+lo+v, n-lo-a, at+a, n-lo-a);put(file,out,n-a+v);free(out);free(b);}
static void sidecar_fixture(int mode){
 char b[33]={0},old[65],fresh[65],manifest_path[4400],old_manifest[65],new_manifest[65],from[120],to[120];mm_copy(b, 7, "USLFW1\n", 7);b[7]=mode==12?3:2;b[15]=mode==11?1:0;if(mode==13)b[6]=0;b[31]='x';b[32]='\n';hash("x\n",2,old);hash(b,33,fresh);put(output,b,33);(cx_fmt(manifest_path, sizeof manifest_path, "%s/manifest.tsv", frames) ? exit(2) : (void)0);size_t n;char *m=cx_read(manifest_path,&n);if(!m)die();hash(m,n,old_manifest);free(m);(cx_fmt(from, sizeof from, "output_sha=%s", old) ? exit(2) : (void)0);(cx_fmt(to, sizeof to, "output_sha=%s", fresh) ? exit(2) : (void)0);change(manifest_path,from,to);change(watch,from,to);change(manifest_path,"output_bytes=2","output_bytes=33");change(watch,"output_bytes=2","output_bytes=33");m=cx_read(manifest_path,&n);if(!m)die();hash(m,n,new_manifest);free(m);(cx_fmt(from, sizeof from, "frame_manifest_sha=%s", old_manifest) ? exit(2) : (void)0);(cx_fmt(to, sizeof to, "frame_manifest_sha=%s", new_manifest) ? exit(2) : (void)0);change(watch,from,to);
}
static void run(int mode,int expected,const char *label){fixture(mode);if(mode>=10)sidecar_fixture(mode);(cx_fmt(dest, sizeof dest, "%s/result%d", dir, mode) ? exit(2) : (void)0);char *v[]={"sh",com,tool,"--",mat,units,frames,cfg,watch,output,dest,mode>=10?"--sidecar":0,0};np_result r={0};char why[256]={0};int tr=np_run(v,0,0,10,&r,why,sizeof why),ok=!tr&&!r.residue&&r.rc==expected;if(!expected){char p[4400];size_t n;(cx_fmt(p, sizeof p, "%s/origin.tsv", dest) ? exit(2) : (void)0);char *b=cx_read(p,&n);ok=ok&&b&&strstr(b,"planned_source=/a.cx")&&strstr(b,mode==1?"survived=0":"survived=1")&&strstr(b,"COMPLETE\tunits=1\tcontexts=1");free(b);}else{struct stat st;ok=ok&&lstat(dest,&st)&&errno==ENOENT;}checks++;bad+=!ok;printf("%s\t%s\n",ok?"PASS":"FAIL",label);if(!ok)fprintf(stderr,"rc=%d tr=%d %s\n%s\n",r.rc,tr,why,r.err?r.err:"");np_free(&r);}
int main(int argc,char **argv){int side_only=argc==2&&!strcmp(argv[1],"--sidecar-checks");if(argc!=1&&!side_only)return 2;char root[4400],tmp[]="/tmp/whole-function-check-XXXXXX";if(!realpath(".",root)||!mkdtemp(tmp))die();(cx_fmt(dir, sizeof dir, "%s", tmp) ? exit(2) : (void)0);(cx_fmt(com, sizeof com, "%s/unisacc.com", root) ? exit(2) : (void)0);(cx_fmt(tool, sizeof tool, "%s/tools/whole-function-origin.cx", root) ? exit(2) : (void)0);(cx_fmt(mat, sizeof mat, "%s/material", dir) ? exit(2) : (void)0);(cx_fmt(frames, sizeof frames, "%s/frames", dir) ? exit(2) : (void)0);if(mkdir(mat,0700)||mkdir(frames,0700))die();(cx_fmt(units, sizeof units, "%s/units", dir) ? exit(2) : (void)0);(cx_fmt(cfg, sizeof cfg, "%s/config", dir) ? exit(2) : (void)0);(cx_fmt(watch, sizeof watch, "%s/watch", dir) ? exit(2) : (void)0);(cx_fmt(output, sizeof output, "%s/output", dir) ? exit(2) : (void)0);
 if(side_only){run(10,0,"production LF-magic USLFW1 sidecar accepted with bare tape hash");run(11,2,"nonzero hostslots refuses");run(12,2,"sidecar length mismatch refuses");run(13,2,"old NUL magic refuses");printf("WHOLE_FUNCTION_SIDECAR_CHECK\tchecks=%d\tfailed=%d\n",checks,bad);return bad?1:0;}
 run(0,0,"normalized frame ID2 links exact prefix unit to original path");run(1,0,"later changed final snapshot becomes UNKNOWN context");run(2,2,"wrong epoch refuses");run(3,2,"hl_pos inside token instead of prefix refuses");run(4,2,"wrong COMPLETE count refuses");run(5,2,"export frame tamper refuses");run(6,2,"nonfixed model delta identity refuses");printf("WHOLE_FUNCTION_ORIGIN_CHECK\tchecks=%d\tfailed=%d\tclaim=fixture-consistency-only\n",checks,bad);return bad?1:0;}
