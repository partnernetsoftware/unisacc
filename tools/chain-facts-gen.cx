/* Construction metadata only: --check refuses fact/library drift without writing. */
#pragma unisa use sys.fs
#pragma unisa use mem.bytes
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.sourcepackage
static char *keys[128],*sources[128],*phases[128];
static int nr,np,nets,tools,front_slice,wf_max;
static void die(const char *s){fprintf(stderr,"chain-facts-gen: REFUSE %s\n",s);exit(2);}
static int number(const char *s){int n=0;if(!*s||*s=='0')die("positive canonical count");for(;*s;s++){if(*s<'0'||*s>'9'||n>100)die("count bound");n=n*10+*s-'0';}if(n>128)die("count bound");return n;}
static int safe(const char *s){if(!*s)return 0;for(;*s;s++)if(!strchr("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_./-",*s))return 0;return 1;}
static void array(np_buf *b,const char *name,char **values,int n){np_puts(b,"static const char *");np_puts(b,name);np_puts(b,"[] = {\n");for(int i=0;i<n;i++){np_puts(b," \"");np_puts(b,values[i]);np_puts(b,"\",\n");}np_puts(b,"};\n");}
int main(int argc,char **argv){
 if(argc!=2||(strcmp(argv[1],"--write")&&strcmp(argv[1],"--check"))){fprintf(stderr,"chain-facts-gen: usage --write|--check\n");return 2;}
 size_t n;char *s=cx_read("build/chain-facts.tsv",&n);if(!s||!n||n>65536||s[n-1]!='\n'||memchr(s,0,n)||memchr(s,'\r',n))die("fact text");
 for(char *p=s;*p;){char *e=strchr(p,'\n');*e=0;if(*p!='#'){char *k=strchr(p,'\t'),*v=k?strchr(k+1,'\t'):0;if(!k||!v||strchr(v+1,'\t'))die("fact columns");*k++=0;*v++=0;if(!safe(k)||!safe(v))die("fact token");
  if(!strcmp(p,"count")){if(nr||np)die("count order");if(!strcmp(k,"nets")&&!nets)nets=number(v);else if(!strcmp(k,"tools")&&!tools)tools=number(v);else if(!strcmp(k,"front_slice")&&!front_slice)front_slice=number(v);else if(!strcmp(k,"wf_max")&&!wf_max)wf_max=number(v);else die("count key");}
  else if(!strcmp(p,"root")){if(np||nr==128||strncmp(v,"src/",4)||strstr(v,"..")||strstr(v,"//")||strchr(k,'/')||strlen(k)<3||strcmp(k+strlen(k)-2,".o"))die("root fact");for(int i=0;i<nr;i++)if(!strcmp(keys[i],k)||!strcmp(sources[i],v))die("duplicate root");keys[nr]=k;sources[nr++]=v;}
  else if(!strcmp(p,"p3")){if(np==128||strcmp(v,"-"))die("phase fact");for(int i=0;i<np;i++)if(!strcmp(phases[i],k))die("duplicate phase");phases[np++]=k;}
  else die("fact kind");}p=e+1;
 }
 if(!nr||!np||!nets||!tools||!front_slice||!wf_max||front_slice>wf_max)die("incomplete facts");
 if(nets!=sp_model_count()||tools!=sp_tool_count()){fprintf(stderr,"chain-facts-gen: DIFF network counts\n");free(s);return 1;}
 np_buf b={0};np_puts(&b,"/* Generated by tools/chain-facts-gen.cx --write; edit build/chain-facts.tsv. */\n#pragma unisa module chainfacts\n");array(&b,"cf_keys",keys,nr);array(&b,"cf_sources",sources,nr);array(&b,"cf_phases",phases,np);
 int guards=0;for(int i=0;i<np;i++)if(!strncmp(phases[i],"guard-",6)&&strcmp(phases[i],"guard-init"))guards++;
 np_puts(&b,"int cf_root_count(void){return (int)(sizeof cf_keys / sizeof cf_keys[0]);}\nint cf_p3_count(void){return (int)(sizeof cf_phases / sizeof cf_phases[0]);}\nint cf_p3_guard_count(void){return ");np_putll(&b,guards);np_puts(&b,";}\nint cf_net_count(void){return ");np_putll(&b,nets);np_puts(&b,";}\nint cf_tool_count(void){return ");np_putll(&b,tools);np_puts(&b,";}\n");
 np_puts(&b,"int cf_front_slice(void){return ");np_putll(&b,front_slice);np_puts(&b,";}\nint cf_wf_max(void){return ");np_putll(&b,wf_max);np_puts(&b,";}\n");
 np_puts(&b,"const char *cf_root_key(int i){return i>=0&&i<cf_root_count()?cf_keys[i]:0;}\nconst char *cf_root_source(int i){return i>=0&&i<cf_root_count()?cf_sources[i]:0;}\nconst char *cf_p3_phase(int i){return i>=0&&i<cf_p3_count()?cf_phases[i]:0;}\n");
 const char *dst="tools/cxlib/chainfacts.cx";int check=!strcmp(argv[1],"--check");if(check){size_t z;char *old=cx_read(dst,&z);int same=old&&z==b.n&&!memcmp(old,b.p,z);free(old);if(!same){fprintf(stderr,"chain-facts-gen: DIFF\n");free(b.p);free(s);return 1;}}else if(cx_write(dst,b.p,b.n))die("write library");
 printf("CHAIN_FACTS\tstatus=%s\troots=%d\tlnx_objects=%d\tp3_phases=%d\tnets=%d\ttools=%d\n",check?"CHECK":"WRITE",nr,nr,np,nets,tools);free(b.p);free(s);return 0;
}
