/* Construction metadata only: --check refuses fact/library drift without writing. */
#pragma unisa use sys.fs
#pragma unisa use mem.bytes
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.sourcepackage
static char *keys[128],*sources[128],*phases[128],*rt_targets[32],*rt_keys[32],*rt_sources[32],*tu_targets[32],*tu_keys[32],*tu_units[32];
static int nr,np,nrt,ntu,nets,tools,front_slice,wf_max;
static void die(const char *s){fprintf(stderr,"chain-facts-gen: REFUSE %s\n",s);exit(2);}
static int number(const char *s){int n=0;if(!*s||*s=='0')die("positive canonical count");for(;*s;s++){if(*s<'0'||*s>'9'||n>100)die("count bound");n=n*10+*s-'0';}if(n>128)die("count bound");return n;}
static int safe(const char *s){if(!*s)return 0;for(;*s;s++)if(!strchr("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_./-:",*s))return 0;return 1;}
static void array(np_buf *b,const char *name,char **values,int n){np_puts(b,"static const char *");np_puts(b,name);np_puts(b,"[] = {\n");for(int i=0;i<n;i++){np_puts(b," \"");np_puts(b,values[i]);np_puts(b,"\",\n");}np_puts(b,"};\n");}
int main(int argc,char **argv){
 if(argc!=2||(strcmp(argv[1],"--write")&&strcmp(argv[1],"--check"))){fprintf(stderr,"chain-facts-gen: usage --write|--check\n");return 2;}
 size_t n;char *s=cx_read("build/chain-facts.tsv",&n);if(!s||!n||n>65536||s[n-1]!='\n'||memchr(s,0,n)||memchr(s,'\r',n))die("fact text");
 for(char *p=s;*p;){char *e=strchr(p,'\n');*e=0;if(*p!='#'){char *k=strchr(p,'\t'),*v=k?strchr(k+1,'\t'):0;if(!k||!v||strchr(v+1,'\t'))die("fact columns");*k++=0;*v++=0;if(!safe(k)||!safe(v))die("fact token");
  if(!strcmp(p,"count")){if(nr||np)die("count order");if(!strcmp(k,"nets")&&!nets)nets=number(v);else if(!strcmp(k,"tools")&&!tools)tools=number(v);else if(!strcmp(k,"front_slice")&&!front_slice)front_slice=number(v);else if(!strcmp(k,"wf_max")&&!wf_max)wf_max=number(v);else die("count key");}
  else if(!strcmp(p,"root")){if(np||nr==128||strncmp(v,"src/",4)||strstr(v,"..")||strstr(v,"//")||strchr(k,'/')||strlen(k)<3||strcmp(k+strlen(k)-2,".o"))die("root fact");for(int i=0;i<nr;i++)if(!strcmp(keys[i],k)||!strcmp(sources[i],v))die("duplicate root");keys[nr]=k;sources[nr++]=v;}
  else if(!strcmp(p,"p3")){if(np==128||nrt||ntu||strcmp(v,"-"))die("phase fact");for(int i=0;i<np;i++)if(!strcmp(phases[i],k))die("duplicate phase");phases[np++]=k;}
  else if(!strcmp(p,"root_target")){
   char *col=strchr(k,':');if(!col||col==k||!col[1]||strchr(col+1,':')||nrt==32||strncmp(v,"src/",4)||strstr(v,"..")||strstr(v,"//"))die("root_target fact");
   *col++=0;
   if(strcmp(k,"lnx/x86_64")&&strcmp(k,"lnx/arm64")&&strcmp(k,"osx/x86_64")&&strcmp(k,"osx/arm64")&&strcmp(k,"win/x86_64")&&strcmp(k,"win/arm64"))die("root_target target");
   int kfound=0;for(int i=0;i<nr;i++)if(!strcmp(keys[i],col)){kfound=1;break;}if(!kfound)die("root_target unknown key");
   for(int i=0;i<nrt;i++)if(!strcmp(rt_targets[i],k)&&!strcmp(rt_keys[i],col))die("duplicate root_target");
   rt_targets[nrt]=k;rt_keys[nrt]=col;rt_sources[nrt++]=v;
  }
  else if(!strcmp(p,"tape_unit")){
   char *col=strchr(k,':');if(!col||col==k||!col[1]||strchr(col+1,':')||ntu==32||!v[0]||strchr(v,'/')||strchr(v,'.')||strchr(v,':'))die("tape_unit fact");
   *col++=0;
   if(strcmp(k,"lnx/x86_64"))die("tape_unit unsupported target");
   for(int i=0;i<ntu;i++)if(!strcmp(tu_targets[i],k)&&(!strcmp(tu_keys[i],col)||!strcmp(tu_units[i],v)))die("duplicate tape_unit");
   tu_targets[ntu]=k;tu_keys[ntu]=col;tu_units[ntu++]=v;
  }
  else die("fact kind");}p=e+1;
 }
 if(!nr||!np||!nets||!tools||!front_slice||!wf_max||front_slice>wf_max)die("incomplete facts");
 for(int i=0;i<ntu;i++){int found=0;for(int j=0;j<nrt;j++)if(!strcmp(rt_targets[j],tu_targets[i])&&!strcmp(rt_keys[j],tu_keys[i])){found=1;break;}if(!found)die("tape_unit without root_target");}
 for(int i=0;i<nrt;i++){if(strcmp(rt_targets[i],"lnx/x86_64"))continue;int found=0;for(int j=0;j<ntu;j++)if(!strcmp(tu_targets[j],rt_targets[i])&&!strcmp(tu_keys[j],rt_keys[i])){found=1;break;}if(!found)die("root_target missing tape_unit");}
 if(nets!=sp_model_count()||tools!=sp_tool_count()){fprintf(stderr,"chain-facts-gen: DIFF network counts\n");free(s);return 1;}
 np_buf b={0};np_puts(&b,"/* Generated by tools/chain-facts-gen.cx --write; edit build/chain-facts.tsv. */\n#pragma unisa module chainfacts\n#pragma unisa use sys.fs\n#pragma unisa use text.text\n#pragma unisa use text.fmt\n");array(&b,"cf_keys",keys,nr);array(&b,"cf_sources",sources,nr);array(&b,"cf_phases",phases,np);
 array(&b,"cf_rt_targets",rt_targets,nrt);array(&b,"cf_rt_keys",rt_keys,nrt);array(&b,"cf_rt_sources",rt_sources,nrt);
 array(&b,"cf_tu_targets",tu_targets,ntu);array(&b,"cf_tu_keys",tu_keys,ntu);array(&b,"cf_tu_units",tu_units,ntu);
 int guards=0;for(int i=0;i<np;i++)if(!strncmp(phases[i],"guard-",6)&&strcmp(phases[i],"guard-init"))guards++;
 np_puts(&b,"int cf_root_count(void){return (int)(sizeof cf_keys / sizeof cf_keys[0]);}\nint cf_p3_count(void){return (int)(sizeof cf_phases / sizeof cf_phases[0]);}\nint cf_p3_guard_count(void){return ");np_putll(&b,guards);np_puts(&b,";}\nint cf_net_count(void){return ");np_putll(&b,nets);np_puts(&b,";}\nint cf_tool_count(void){return ");np_putll(&b,tools);np_puts(&b,";}\n");
 np_puts(&b,"int cf_front_slice(void){return ");np_putll(&b,front_slice);np_puts(&b,";}\nint cf_wf_max(void){return ");np_putll(&b,wf_max);np_puts(&b,";}\n");
 np_puts(&b,"const char *cf_root_key(int i){return i>=0&&i<cf_root_count()?cf_keys[i]:0;}\nconst char *cf_root_source(int i){return i>=0&&i<cf_root_count()?cf_sources[i]:0;}\nconst char *cf_p3_phase(int i){return i>=0&&i<cf_p3_count()?cf_phases[i]:0;}\n");
 np_puts(&b,"int cf_rt_count(void){return ");np_putll(&b,nrt);np_puts(&b,";}\nconst char *cf_rt_target(int i){return i>=0&&i<cf_rt_count()?cf_rt_targets[i]:0;}\nconst char *cf_rt_key(int i){return i>=0&&i<cf_rt_count()?cf_rt_keys[i]:0;}\nconst char *cf_rt_source(int i){return i>=0&&i<cf_rt_count()?cf_rt_sources[i]:0;}\n");
 np_puts(&b,"const char *cf_root_source_for(int i,const char *target){const char *k=cf_root_key(i);if(k&&target){for(int j=0;j<cf_rt_count();j++){if(!strcmp(cf_rt_target(j),target)&&!strcmp(cf_rt_key(j),k))return cf_rt_source(j);}}return cf_root_source(i);}\n");
 np_puts(&b,"int cf_tu_count(void){return ");np_putll(&b,ntu);np_puts(&b,";}\nconst char *cf_tu_target(int i){return i>=0&&i<cf_tu_count()?cf_tu_targets[i]:0;}\nconst char *cf_tu_key(int i){return i>=0&&i<cf_tu_count()?cf_tu_keys[i]:0;}\nconst char *cf_tu_unit(int i){return i>=0&&i<cf_tu_count()?cf_tu_units[i]:0;}\n");
 np_puts(&b,"const char *cf_tu_for(const char *target,const char *key){if(target&&key){for(int j=0;j<cf_tu_count();j++){if(!strcmp(cf_tu_target(j),target)&&!strcmp(cf_tu_key(j),key))return cf_tu_unit(j);}}return 0;}\n");
 np_puts(&b,"int cf_snap_tape_state(const char *root){char p[4400],buf[32768];sy_stat_t st;int fd;long n=0,r,at=0;int seen[32],cnt=0;if(!root||!root[0]||cx_fmt(p,sizeof p,\"%s/build/chain-facts.tsv\",root))return -1;r=sy_lstat(p,&st);if(r==-ENOENT)return 0;if(r!=0||st.kind!='f'||st.size<=0||st.size>=(long)sizeof buf)return -1;fd=sy_open(p,O_RDONLY,0);if(fd<0)return -1;while(n<st.size){r=sy_read(fd,buf+n,st.size-n);if(r<=0){(void)sy_close(fd);return -1;}n+=r;}(void)sy_close(fd);buf[n]=0;for(int i=0;i<32;i++)seen[i]=0;while(at<n){long e=at,ln,o0=0,l0=0,o1=0,l1=0,o2=0,l2=0,o3=0,l3=0;while(e<n&&buf[e]!='\\n')e++;ln=e-at;if(ln>0&&buf[at+ln-1]=='\\r')ln--;if(ln>0&&buf[at]!='#'){if(tx_field(buf+at,ln,'\\t',0,&o0,&l0)==0&&l0==9&&tx_same(buf+at+o0,9,\"tape_unit\",9)){if(tx_field(buf+at,ln,'\\t',1,&o1,&l1)!=0||tx_field(buf+at,ln,'\\t',2,&o2,&l2)!=0||tx_field(buf+at,ln,'\\t',3,&o3,&l3)==0)return -1;long col=-1;for(long q=0;q<l1;q++)if(buf[at+o1+q]==':'){col=q;break;}if(col<=0||col+1>=l1)return -1;if(col!=10||!tx_same(buf+at+o1,10,\"lnx/x86_64\",10))return -1;int hit=-1;for(int j=0;j<cf_tu_count();j++){const char *tk=cf_tu_key(j),*tu=cf_tu_unit(j);if(tk&&tu&&l1-col-1==tx_len(tk,128)&&tx_same(buf+at+o1+col+1,l1-col-1,tk,l1-col-1)&&l2==tx_len(tu,128)&&tx_same(buf+at+o2,l2,tu,l2)){hit=j;break;}}if(hit<0||hit>=32||seen[hit])return -1;seen[hit]=1;cnt++;}}at=e+1;}return cnt==cf_tu_count()?cnt:-1;}\n");
 np_puts(&b,"int cf_check_routed_guests(const char *snap,char *miss,long mcap){int n=0;if(miss&&mcap>0)miss[0]=0;if(cf_snap_tape_state(snap)<0){if(miss&&mcap>0)(void)cx_fmt(miss,mcap,\"chain-facts-mismatch:%s\",snap?snap:\"\");return -2;}for(int ti=0;ti<cf_tu_count();ti++){const char *tgt=cf_tu_target(ti),*u=cf_tu_unit(ti);char ug[4400];sy_stat_t st;if(!tgt||!u||!tx_eqz(tgt,\"lnx/x86_64\"))return -1;if(tx_eqz(u,\"m53\")){if(cx_fmt(ug,sizeof ug,\"%s/cx/driver/stream_s1_m1.cx\",snap))return -1;}else{if(cx_fmt(ug,sizeof ug,\"%s/exec/tape/guests/%s_guest.cx\",snap,u))return -1;}if(sy_lstat(ug,&st)!=0||st.kind!='f'||st.size<=0){if(miss&&mcap>0)(void)cx_fmt(miss,mcap,\"%s\",ug);return -1;}n++;}return n;}\n");
 const char *dst="tools/cxlib/chainfacts.cx";int check=!strcmp(argv[1],"--check");if(check){size_t z;char *old=cx_read(dst,&z);int same=old&&z==b.n&&!memcmp(old,b.p,z);free(old);if(!same){fprintf(stderr,"chain-facts-gen: DIFF\n");free(b.p);free(s);return 1;}}else if(cx_write(dst,b.p,b.n))die("write library");
 printf("CHAIN_FACTS\tstatus=%s\troots=%d\tlnx_objects=%d\tp3_phases=%d\tnets=%d\ttools=%d\n",check?"CHECK":"WRITE",nr,nr,np,nets,tools);free(b.p);free(s);return 0;
}
