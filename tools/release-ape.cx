/* tools/release-ape.cx -- pack the five release-build slices and the frozen P3 into one APE unisacc-next.com,
 * and smoke it before anyone installs it (plans/release-0.0.43.md step 2, wrap).
 *
 *   sh ./unisacc.com tools/release-ape.cx -- pack OUT P3 WIN_X86_64 LNX_X86_64 LNX_ARM64 OSX_X86_64 OSX_ARM64
 *   sh ./unisacc.com tools/release-ape.cx -- smoke OUT/unisacc-next.com
 *
 * pack: P3 is a package file as release-build writes it (package bytes, then the 16-byte UNIPKG1 footer); its
 *   package bytes (footer cut, located with runtime.packagefooter) become OUT/p3-package.body, NOT .bin: the
 *   shipped dev-lnx tree uses that name WITH the footer.  tools/ape-pack.cx --tool unisacc --deflate --payload
 *   makes OUT/unisacc-next.com: launcher + five gzip slices + one copy of the package + one UNIPKG1 footer, the layout of the installed unisacc.com (one package at
 *   the end, read by every slice through UNISA_CONTAINER).  The lnx slices are entry.elf (no P3 of their own).
 *   Writes OUT/ape-receipt.txt (every input and the output with sha256 and bytes) and checks that the packed
 *   package bytes equal OUT/p3-package.body.
 * smoke: runs the packed file the way users do (sh FILE ...) under tools/bound: --version names the candidate version; -run of a
 *   C program exits 7; -S prints a tape; a .cx program that calls the host C library (sy_printf) prints its line
 *   -- the memory-image route that 5ed7ba69 broke; and tests/srcshape.cx --check exits 0.  Prints
 *   RELEASE_APE<TAB>SMOKE<TAB>ok=N<TAB>failed=M; exit 0 only when nothing failed.
 * An L3 tool: no #include, no direct libc call. */
#pragma unisa use runtime.packagefooter
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.io
#pragma unisa use sys.sig
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use cxlib.releaseversion

/* sy_run with a bound: ARGV runs under cx_runv_timeout (SECS, process group killed on expiry), stdout and stderr
   merged into OUT (CAP, NUL-terminated, *CUT set when it did not fit; CUT may be 0). */
static int bounded_run(char **argv, int secs, char *out, int cap, int *cut) {
    char *w[64], *b = 0;
    size_t n = 0, j;
    int k = 0, i, rc;
    if (cut) *cut = 0;
    if (!argv) return -EINVAL;
    w[k++] = "sh"; w[k++] = "-c"; w[k++] = "exec \"$@\" 2>&1"; w[k++] = "sh";
    for (i = 0; argv[i] && k < 63; i++) w[k++] = argv[i];
    if (argv[i]) return -E2BIG;
    w[k] = 0;
    rc = cx_runv_timeout(w, secs, &b, &n);
    if (cap > 0) {
        if (n > (size_t)cap - 1) { n = (size_t)cap - 1; if (cut) *cut = 1; }
        for (j = 0; b && j < n; j++) out[j] = b[j];
        out[b ? n : 0] = 0;
    }
    free(b);
    return rc;
}

static void ra_die(const char *a, const char *b) { sy_eprintf("release-ape: %s%s%s\n", a, b ? ": " : "", b ? b : ""); sy_exit(2); }

static int sha_of(const char *path, char hex[65], long *bytes) {
    size_t n = 0; char *b = cx_read(path, &n);
    if (!b) return -1;
    cx_sha256_hex(b, n, hex); *bytes = (long)n; mm_free(b);
    return 0;
}

/* run ARGV; stdout+stderr (truncated to cap) into OUT; the exit code, or -1 */
static int run(char **argv, char *out, int cap) { int cut; return bounded_run(argv, 50, out, cap, &cut); }

static int receipt_line(char *r, long cap, long *at, const char *key, const char *path) {
    char hex[65]; long n = 0;
    if (sha_of(path, hex, &n)) return -1;
    if (cx_fmt(r + *at, (size_t)(cap - *at), "%s\t%s\tsha=%s\tbytes=%ld\n", key, path, hex, n)) return -1;
    *at += tx_len(r + *at, cap - *at);
    return 0;
}

static const char *ra_manager[2];
static const char *ra_osx[2];
static int ra_built_managers;
/* This validates a thin executable identity, never signature trust. */
static unsigned long ra_u32(const unsigned char *p) { return (unsigned long)p[0] | (unsigned long)p[1]<<8 | (unsigned long)p[2]<<16 | (unsigned long)p[3]<<24; }
static void ra_macho(const char *path,unsigned long cpu) {
    size_t n=0;unsigned char *p=(unsigned char *)cx_read(path,&n);
    if(!p||n<32||ra_u32(p)!=0xfeedfacfUL||ra_u32(p+4)!=cpu||ra_u32(p+12)!=2)ra_die("replacement requires matching thin Mach-O executable",path);
    unsigned long count=ra_u32(p+16),bytes=ra_u32(p+20),at=32;
    if(bytes>n-32||count>bytes/8)ra_die("Mach-O command bounds",path);
    for(unsigned long i=0;i<count;i++){if(at>32+bytes-8)ra_die("Mach-O command header",path);unsigned long z=ra_u32(p+at+4);if(z<8||z%8||z>32+bytes-at)ra_die("Mach-O command size",path);at+=z;}
    if(at!=32+bytes)ra_die("Mach-O command extent",path);mm_free(p);
}
static int pack(char **argv, int nslice) {
    const char *out = argv[0], *p3 = argv[1], *keys[8] = {"p3", "win/x86_64", "lnx/x86_64", "lnx/arm64", "osx/x86_64", "osx/arm64", "win/arm64"};
    char payload[4400], com[4400], rp[4400], log[8192], receipt[8192]; size_t pn; long at = 0; int i, rc; PackageFooter foot;
    char version[24]; if (rv_load("release/candidate.tsv", version)) ra_die("invalid release version", "release/candidate.tsv");
    if (nslice != 5 && nslice != 6) ra_die("slice count", "pack takes 5 or 6 slices");
    const char *source_osx[2]={argv[5],argv[6]};char before[4][65];long before_bytes[4];
    if(ra_osx[0]){
        if(!ra_manager[0])ra_die("--osx-slices requires explicit --cache-manager-osx",0);
        for(i=0;i<2;i++){ra_macho(ra_osx[i],i?0x100000cUL:0x1000007UL);ra_macho(ra_manager[i],i?0x100000cUL:0x1000007UL);}
        for(i=0;i<4;i++)if(sha_of(i<2?ra_osx[i]:ra_manager[i-2],before[i],before_bytes+i))ra_die("replacement input",0);
        argv[5]=(char*)ra_osx[0];argv[6]=(char*)ra_osx[1];
    }
    if (sy_mkdir(out, 0755) && sy_exists(out) != 1) ra_die("cannot make", out);
    if(!ra_manager[0]){
        ra_built_managers=1;
        static char managers[2][4400];const char *targets[2]={"osx/x86_64","osx/arm64"};
        for(i=0;i<2;i++){
            if(cx_fmt(managers[i],sizeof managers[i],"%s/cache-manager-%s",out,i?"arm64":"x64"))ra_die("manager path",out);
            char *build[]={"./tools/bound","50","sh","./unisacc.com","tools/cache-retain.cx","-b",(char*)targets[i],"-o",managers[i],0};
            rc=run(build,log,sizeof log);if(rc){sy_eprintf("%s",log);ra_die("manager construction",targets[i]);}ra_manager[i]=managers[i];
        }
    }
    if (cx_fmt(payload, sizeof payload, "%s/p3-package.body", out) || cx_fmt(com, sizeof com, "%s/unisacc-next.com", out) || cx_fmt(rp, sizeof rp, "%s/ape-receipt.txt", out)) ra_die("path too long", out);
    {   char *b = cx_read(p3, &pn);
        if (!b || pn > 2147483647UL || !packagefooter_locate_bytes((const unsigned char *)b, (long)pn, &foot)) ra_die("no package footer", p3);
        if (foot.package_offset < 0 || foot.footer_offset < foot.package_offset || foot.footer_offset + 16 != (long)pn || b[foot.package_offset] != 'P') ra_die("unexpected package span", p3);
        if (cx_write(payload, b + foot.package_offset, (size_t)(foot.footer_offset - foot.package_offset))) ra_die("cannot write", payload);
        mm_free(b);
    }
    {   /* ASLIMIT-02 dropped the static BSS 213MB -> 12.1MB. --need covers the
           launcher layer only, and one value serves every subcommand, so it is
           the smallest floor any subcommand needs (-c at 44 MiB), not the
           heaviest (as at 203 MiB). The heavy paths carry their own precheck
           inside the compiler: at_tables refuses below 203 MiB, tl_tables below
           44 MiB. The two layers do not overlap: the launcher cannot know which
           subcommand it is about to run. The old 300000 was for the 237936 KB
           mapping era. Re-measure if any floor moves. */
        char *av[28] = {"sh", "./unisacc.com", "-run", "tools/ape-pack.cx", "--", "--payload", payload, "--tool", "unisacc", "--need", "53248", "--deflate",
                      "--product", "unisacc", version, com, argv[2], argv[3], argv[4], argv[5], argv[6], 0, 0};
        if (nslice == 6) { av[21] = argv[7]; av[22] = 0; }   /* WIN_ARM64 is the optional sixth slice */
        if(ra_manager[0]){int k=nslice==6?22:21;av[k++]="--cache-manager-osx";av[k++]=(char*)ra_manager[0];av[k++]=(char*)ra_manager[1];av[k]=0;
            /* Packer options precede positional inputs. */
            for(int j=k-1;j>=8;j--)av[j]=av[j-3];av[5]="--cache-manager-osx";av[6]=(char*)ra_manager[0];av[7]=(char*)ra_manager[1];av[k]=0;
        }
        rc = run(av, log, sizeof log);
        if (rc != 0 || sy_exists(com) != 1) { sy_eprintf("%s", log); ra_die("ape-pack failed", com); }
        sy_chmod(com, 0755);
    }
    for (i = 0; i < nslice + 1; i++) if (receipt_line(receipt, sizeof receipt, &at, keys[i], argv[1 + i])) ra_die("cannot hash", argv[1 + i]);
    if(ra_osx[0]){
        for(i=0;i<4;i++){char h[65];long z;const char *p=i<2?ra_osx[i]:ra_manager[i-2];if(sha_of(p,h,&z)||z!=before_bytes[i]||!tx_eqz(h,before[i]))ra_die("replacement changed during pack",p);}
        for(i=0;i<2;i++)if(receipt_line(receipt,sizeof receipt,&at,i?"source/osx/arm64":"source/osx/x86_64",source_osx[i])||receipt_line(receipt,sizeof receipt,&at,i?"replacement/osx/arm64":"replacement/osx/x86_64",ra_osx[i]))ra_die("source/replacement receipt",0);
        if(cx_fmt(receipt+at,sizeof receipt-at,"replacement-claim\tBYTE_PRESERVING_REPACK_NOT_SIGNATURE_VERIFICATION\n"))ra_die("claim bound",0);at+=tx_len(receipt+at,sizeof receipt-at);
    }
    if(cx_fmt(receipt+at,sizeof receipt-at,"cache-manager-mode\t%s\n",ra_built_managers?"BUILT_CURRENT_PRODUCT":"EXPLICIT_INPUTS"))ra_die("manager mode",out);at+=tx_len(receipt+at,sizeof receipt-at);
    if(ra_built_managers&&(receipt_line(receipt,sizeof receipt,&at,"cache-manager-source","tools/cache-retain.cx")||receipt_line(receipt,sizeof receipt,&at,"cache-manager-constructor","unisacc.com")))ra_die("manager construction identity",out);
    if(ra_manager[0])for(i=0;i<2;i++)if(receipt_line(receipt,sizeof receipt,&at,i?"cache-manager/osx/arm64":"cache-manager/osx/x86_64",ra_manager[i]))ra_die("cannot hash manager",ra_manager[i]);
    if (receipt_line(receipt, sizeof receipt, &at, "p3-package.body", payload) || receipt_line(receipt, sizeof receipt, &at, "unisacc-next.com", com)) ra_die("cannot hash", com);
    {   /* the packed file's last package must be the payload: footer = "UNIPKG1\n" + length, payload just before it */
        size_t cn, qn; char *c = cx_read(com, &cn), *q = cx_read(payload, &qn); long len = 0; int k;
        if (!c || !q || cn < qn + 16 || !tx_same(c + cn - 16, 8, "UNIPKG1\n", 8)) ra_die("no UNIPKG1 footer at the end", com);
        for (k = 7; k >= 0; k--) len = (len << 8) | (unsigned char)c[cn - 8 + k];
        if (len != (long)qn || !tx_same(c + cn - 16 - qn, (long)qn, q, (long)qn)) ra_die("packed package differs from the payload", com);
        mm_free(c); mm_free(q);
    }
    if (cx_write(rp, receipt, (size_t)at)) ra_die("cannot write", rp);
    sy_printf("%sRELEASE_APE\tPACKED\t%s\n", receipt, com);
    return 0;
}

static int ok, failed;
static void ck(int good, const char *name, const char *log) {
    if (good) { ok++; sy_printf("PASS\trelease-ape.smoke.%s\n", name); }
    else { failed++; sy_printf("FAIL\trelease-ape.smoke.%s\n%s\n", name, log); }
}

static int smoke(const char *com) {
    char log[8192], dir[4400], c[4400], cx[4400];
    char version[24], expected[64];
    if (rv_load("release/candidate.tsv", version) || cx_fmt(expected, sizeof expected, "unisacc %s", version)) ra_die("invalid release version", "release/candidate.tsv");
    if (sy_exists(com) != 1) ra_die("no such file", com);
    if (cx_fmt(dir, sizeof dir, "%s/unisacc-release-ape-smoke-%d", sy_tmpdir(), (int)sy_pid()) || (sy_mkdir(dir, 0755) && sy_exists(dir) != 1)) ra_die("cannot make", dir);
    if (cx_fmt(c, sizeof c, "%s/seven.c", dir) || cx_write(c, "int main(void){return 7;}\n", 26)) ra_die("cannot write", c);
    if (cx_fmt(cx, sizeof cx, "%s/hostc.cx", dir)) ra_die("path", dir);
    {   /* `use` resolves beside the using file: give the smoke dir the L0 module links the repo's dirs have */
        const char *mods[3] = {"sys", "mem", "text"}; int m; char cwd[4096];
        if (sy_cwd(cwd, sizeof cwd) < 0) ra_die("cannot get cwd", dir);
        for (m = 0; m < 3; m++) {
            char link[4400], target[4400]; sy_stat_t st;
            if (cx_fmt(link, sizeof link, "%s/%s", dir, mods[m]) || cx_fmt(target, sizeof target, "%s/cx/%s", cwd, mods[m])) ra_die("path", dir);
            if (sy_lstat(link, &st) == -ENOENT && sy_symlink(target, link)) ra_die("cannot link", link);
        }
    }
    {   const char *s = "#pragma unisa use sys.io\nint main(void){sy_printf(\"release-ape-hostc\\n\");return 0;}\n";
        if (cx_write(cx, s, (size_t)tx_len(s, 256))) ra_die("cannot write", cx); }
    {   char *av[] = {"./tools/bound", "30", "sh", (char *)com, "--version", 0}; int rc = run(av, log, sizeof log);
        ck(rc == 0 && tx_find(log, tx_len(log, sizeof log), expected, tx_len(expected, sizeof expected)) >= 0, "candidate-version", log); }
    {   char *av[] = {"./tools/bound", "30", "sh", (char *)com, "-run", c, 0}; int rc = run(av, log, sizeof log);
        ck(rc == 7, "run-c-exit-7", log); }
    {   char *av[] = {"./tools/bound", "30", "sh", (char *)com, "-O0", "-b", "lnx/x86_64", "-S", c, "-o", "-", 0}; int rc = run(av, log, sizeof log);
        ck(rc == 0 && tx_find(log, tx_len(log, sizeof log), "_start:", 7) >= 0, "S-prints-tape", log); }
    {   char *av[] = {"./tools/bound", "50", "sh", (char *)com, cx, 0}; int rc = run(av, log, sizeof log);
        ck(rc == 0 && tx_find(log, tx_len(log, sizeof log), "release-ape-hostc", 17) >= 0, "cx-host-c-library", log); }
    {   char *av[] = {"./tools/bound", "50", "sh", (char *)com, "tests/srcshape.cx", "--", "--check", 0}; int rc = run(av, log, sizeof log);
        ck(rc == 0, "cx-tool-srcshape", log); }
    sy_printf("RELEASE_APE\tSMOKE\tok=%d\tfailed=%d\n", ok, failed);
    return failed ? 1 : 0;
}

/* --dev-lnx-only: a local-development APE for the host (Linux x86_64 only).
   A thin shell head plus a side directory (ELF + P3 package) instead of the
   six-slice ap`e-pack layout, so it never needs ujs/ and cannot be mistaken
   for a release. The product is unisacc.com + unisacc.com.dev/; the receipt
   records NOT_RELEASE and both identities. The shell head execs the side ELF
   with UNISA_CONTAINER pointing at the side P3 package, transparently. */
static int devlnx(const char *out, const char *p3, const char *lnxelf) {
    char dir[4400], elfdst[4400], pkgdst[4400], com[4400], rp[4400], receipt[8192], hex[65];
    long at = 0, n = 0; size_t pn; PackageFooter foot;
    char version[24]; if(rv_load("release/candidate.tsv",version))ra_die("invalid release version","release/candidate.tsv");
    /* Booter head: identify OS/arch via uname, read the side manifest.tsv to
       locate the external base (kernel), export UNISA_KERNEL(+_SHA) when the
       external file is present, then hand off to the existing entry ELF.
       No base is built here; an absent external base falls back to the
       embedded pack blob through UNISA_KERNEL unset. */
    const char *head =
        "#!/bin/sh\n"
        "# unisacc.com --dev-lnx-only: booter head; selects base by uname then execs the side ELF. NOT_RELEASE.\n"
        "self=$(readlink -f \"$0\" 2>/dev/null || printf '%s' \"$0\")\n"
        "dir=$(dirname \"$self\")\n"
        "elf=\"$dir/unisacc.com.dev/entry.elf\"\n"
        "pkg=\"$dir/unisacc.com.dev/p3-package.bin\"\n"
        "need=53248\n"
        "lim=$(ulimit -v)\n"
        "case \"$lim\" in unlimited) : ;; *) [ \"$lim\" -lt \"$need\" ] && { echo \"unisacc.com: run: out of memory (ulimit -v $lim < $need)\" >&2; exit 2; } ;; esac\n"
        "[ -x \"$elf\" ] || { echo \"unisacc.com: missing $elf\" >&2; exit 1; }\n"
        "[ -f \"$pkg\" ] || { echo \"unisacc.com: missing $pkg\" >&2; exit 1; }\n"
        "UNISA_CONTAINER=\"$pkg\"; export UNISA_CONTAINER\n"
        "# booter: uname arch -> base name; read manifest.tsv for sha + path\n"
        "arch=$(uname -m 2>/dev/null || printf x86_64)\n"
        "case \"$arch\" in\n"
        "  x86_64|amd64) base=x86_64 ;;\n"
        "  aarch64|arm64) base=arm64 ;;\n"
        "  *) base=x86_64 ;;\n"
        "esac\n"
        "manifest=\"$dir/unisacc.com.dev/manifest.tsv\"\n"
        "kernelfile=\"$dir/unisacc.com.dev/base/$base.kernel\"\n"
        "if [ -f \"$manifest\" ]; then\n"
        "  while IFS='\t' read -r name kind arch sha size rest; do\n"
        "    [ \"$name\" = \"kernel/$base\" ] || continue\n"
        "    if [ -f \"$kernelfile\" ] && [ -n \"$sha\" ]; then\n"
        "      UNISA_KERNEL=\"$kernelfile\"; export UNISA_KERNEL\n"
        "      UNISA_KERNEL_SHA=\"$sha\"; export UNISA_KERNEL_SHA\n"
        "    fi\n"
        "    break\n"
        "  done < \"$manifest\"\n"
        "fi\n"
        "exec \"$elf\" \"$@\"\n";
    if (sy_mkdir(out, 0755) && sy_exists(out) != 1) ra_die("cannot make", out);
    if (cx_fmt(dir, sizeof dir, "%s/unisacc.com.dev", out)) ra_die("path too long", out);
    if (sy_mkdir(dir, 0755) && sy_exists(dir) != 1) ra_die("cannot make", dir);
    if (cx_fmt(elfdst, sizeof elfdst, "%s/entry.elf", dir) || cx_fmt(pkgdst, sizeof pkgdst, "%s/p3-package.bin", dir)) ra_die("path too long", dir);
    if (cx_fmt(com, sizeof com, "%s/unisacc.com", out) || cx_fmt(rp, sizeof rp, "%s/ape-receipt.txt", out)) ra_die("path too long", out);
    {   char *b = cx_read(p3, &pn);
        if (!b || pn > 2147483647UL || !packagefooter_locate_bytes((const unsigned char *)b, (long)pn, &foot)) ra_die("no package footer", p3);
        if (foot.package_offset < 0 || foot.footer_offset < foot.package_offset || foot.footer_offset + 16 != (long)pn || b[foot.package_offset] != 'P') ra_die("unexpected package span", p3);
        /* UNISA_CONTAINER reads the whole file: package bytes plus the 16-byte
           UNIPKG1 footer, so copy the input verbatim (not just the package). */
        if (cx_write(pkgdst, b, pn)) ra_die("cannot write package", pkgdst);
        mm_free(b);
    }
    {   char *e = cx_read(lnxelf, &n);
        if (!e || n == 0) ra_die("cannot read slice", lnxelf);
        if(rv_inject_slot((unsigned char *)e,(size_t)n,version))ra_die("invalid version slot",lnxelf);
        if (cx_write(elfdst, e, n)) ra_die("cannot write slice", elfdst);
        mm_free(e);
    }
    sy_chmod(elfdst, 0755);
    if (cx_write(com, head, (size_t)tx_len(head, 4096))) ra_die("cannot write head", com);
    sy_chmod(com, 0755);
    if (cx_fmt(receipt, sizeof receipt, "NOT_RELEASE\tdev-lnx-only\n")) ra_die("receipt", com);
    at = tx_len(receipt, sizeof receipt);
    if (receipt_line(receipt, sizeof receipt, &at, "unisacc.com", com) || receipt_line(receipt, sizeof receipt, &at, "entry.elf", elfdst) || receipt_line(receipt, sizeof receipt, &at, "p3-package", pkgdst)) ra_die("cannot hash", com);
    if (cx_write(rp, receipt, (size_t)at)) ra_die("cannot write", rp);
    sy_printf("%sRELEASE_APE\tDEV_LNX_PACKED\t%s\n", receipt, com);
    return 0;
}

int main(int argc, char **argv) {
    if(argc>1&&tx_eqz(argv[1],"pack")){
        int p=2;while(p<argc&&argv[p][0]=='-'){
            if(p+2>=argc)ra_die("pack option arguments",argv[p]);
            if(tx_eqz(argv[p],"--cache-manager-osx")&&!ra_manager[0]){ra_manager[0]=argv[p+1];ra_manager[1]=argv[p+2];}
            else if(tx_eqz(argv[p],"--osx-slices")&&!ra_osx[0]){ra_osx[0]=argv[p+1];ra_osx[1]=argv[p+2];}
            else ra_die("unknown or duplicate pack option",argv[p]);p+=3;
        }
        if(argc-p==7||argc-p==8)return pack(argv+p,argc-p-2);
        ra_die("pack positional arguments",0);
    }
    /* pack OUT P3 + five slices = 9 argv; the optional sixth slice WIN_ARM64 = 10. */
    if ((argc == 9 || argc == 10) && tx_eqz(argv[1], "pack")) return pack(argv + 2, argc - 4);
    if (argc == 5 && tx_eqz(argv[1], "dev-lnx")) return devlnx(argv[2], argv[3], argv[4]);
    if (argc == 3 && tx_eqz(argv[1], "smoke")) return smoke(argv[2]);
    sy_eprintf("usage: release-ape.cx pack [--cache-manager-osx X64 ARM64] [--osx-slices X64 ARM64] OUT P3 WIN_X86_64 LNX_X86_64 LNX_ARM64 OSX_X86_64 OSX_ARM64 [WIN_ARM64] | dev-lnx OUT P3 LNX_ELF | smoke FILE\n");
    return 2;
}
