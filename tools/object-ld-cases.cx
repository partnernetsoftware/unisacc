/* tools/object-ld-cases.cx -- formats cell object.system-linker (prd.md:768 §3.15): a whole-program product ELF
 * relocatable (`-c -b lnx/x86_64 -o X.o SRC.c`, _start global) is linked by the host ld and runs.
 *   sh ./unisacc.com tools/object-ld-cases.cx -- ROOT ABS_OUT HOST_LD
 * HOST_LD is the declared oracle (fable ruling 2026-10-28: a .cx batch may call a host tool the row declares as its
 * oracle; its path, `--version` first line and SHA-256 are recorded as oracle_id). Per fixture (hand-derived stdout and
 * exit code): product `-c` rc 0 and the object is ELF64 ET_REL x86-64 with a global `_start` (independent header read);
 * host `ld -o prog X.o` rc 0 with empty stderr; host `ld -static` likewise and the two outputs execute identically;
 * the linked program's stdout and exit equal the literal, and equal the product's own image route for the same source
 * (stdout/exit; bytes are not compared, the layouts differ by design). Relocations: the object's .rela.text must be
 * consumed (the ld output has no R_X86_64 relocation section left), checked by walking ld's output section headers. */
#pragma unisa use cxlib.netpack

static char root[4096], outdir[4096], product[4400], hostld[4096], bound[4400]; static int npass, nfail; static FILE *res;
static void die(const char *s) { fprintf(stderr, "object-ld-cases: REFUSE %s errno=%d\n", s, errno); exit(2); }
static void path(char *p, size_t cap, const char *a, const char *b) { int n = snprintf(p, cap, "%s/%s", a, b); if (n < 0 || (size_t)n >= cap) die("path"); }
static void saved(const char *p, const char *s, size_t n) { int f = open(p, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600); if (f < 0) die("exclusive create"); while (n) { ssize_t k = write(f, s, n); if (k <= 0) die("write"); s += k; n -= (size_t)k; } if (close(f)) die("close"); }
static void check(int ok, const char *fx, const char *label, const char *detail) { fprintf(res, "%s\tobject.system-linker.%s.%s\t%s\n", ok ? "PASS" : "FAIL", fx, label, detail); printf("%s\t%s.%s\n", ok ? "PASS" : "FAIL", fx, label); if (ok) npass++; else nfail++; }
static int runin(char *const argv[], np_result *r) { char why[1024]; return np_run(argv, outdir, 0, 20, r, why, sizeof why); }
static int prod(char *const extra[], np_result *r) { char *v[16]; int n = 0; v[n++] = "sh"; v[n++] = product; for (int i = 0; extra[i]; i++) { if (n >= 15) die("argv"); v[n++] = extra[i]; } v[n] = 0; return runin(v, r); }
static unsigned long le(const unsigned char *p, int n) { unsigned long v = 0; for (int i = n - 1; i >= 0; i--) v = (v << 8) | p[i]; return v; }
/* ELF64 facts: type, machine, whether a global _start symbol exists, whether any RELA section exists */
static int elf_facts(const char *p, int *type, int *machine, int *has_start, int *has_rela) { size_t n; unsigned char *b = (unsigned char *)cx_read(p, &n); if (!b) return 0; *type = *machine = *has_start = *has_rela = 0;
    if (n < 64 || memcmp(b, "\177ELF\2\1\1", 7)) { free(b); return 0; } *type = (int)le(b + 16, 2); *machine = (int)le(b + 18, 2);
    unsigned long shoff = le(b + 40, 8), shentsize = le(b + 58, 2), shnum = le(b + 60, 2), shstrndx = le(b + 62, 2); if (shentsize != 64 || shoff + shnum * 64 > n) { free(b); return 0; }
    for (unsigned long i = 0; i < shnum; i++) { const unsigned char *sh = b + shoff + i * 64; unsigned long st = le(sh + 4, 4), off = le(sh + 24, 8), sz = le(sh + 32, 8), link = le(sh + 40, 4), ent = le(sh + 56, 8);
        if (st == 4) *has_rela = 1;
        if (st == 2 && ent == 24 && off + sz <= n && link < shnum) { const unsigned char *strsh = b + shoff + link * 64; unsigned long stroff = le(strsh + 24, 8), strsz = le(strsh + 32, 8); if (stroff + strsz > n) continue;
            for (unsigned long k = 0; k * 24 < sz; k++) { const unsigned char *sym = b + off + k * 24; unsigned long nm = le(sym, 4); int bind = sym[4] >> 4; if (nm < strsz && bind == 1 && !strcmp((const char *)b + stroff + nm, "_start")) *has_start = 1; } } }
    (void)shstrndx; free(b); return 1; }
static int exec_lit(const char *prog, const char *want_out, int want_rc, char *d, size_t cap) { if (chmod(prog, 0700)) die("chmod"); char *v[] = { bound, "5", (char *)prog, 0 }; np_result r; if (runin(v, &r)) { snprintf(d, cap, "transport"); return 0; }
    size_t wn = strlen(want_out); int ok = r.rc == want_rc && r.outn == wn && !memcmp(r.out, want_out, wn); snprintf(d, cap, "rc=%d want=%d stdout=%zu want=%zu", r.rc, want_rc, r.outn, wn); np_free(&r); return ok; }

int main(int argc, char **argv) {
    if (argc != 4 || !realpath(argv[1], root) || argv[2][0] != '/' || !realpath(argv[3], hostld)) { fputs("usage: ROOT ABS_OUT HOST_LD\n", stderr); return 2; }
    { if (cx_fmt(outdir, sizeof outdir, "%s", argv[2])) { fprintf(stderr, "object-ld-cases: text too long for outdir\n"); exit(2); } } if (mkdir(outdir, 0700)) die("new out dir must be absent"); path(product, sizeof product, root, "unisacc.com"); path(bound, sizeof bound, root, "tools/bound");
    char rp[4400]; path(rp, sizeof rp, outdir, "results.tsv"); res = fopen(rp, "wbx"); if (!res) die("results");
    { size_t n; char *b = cx_read(product, &n); if (!b) die("product"); char h[65]; cx_sha256_hex(b, n, h); free(b); np_result r; char *vv[] = { hostld, "--version", 0 }; char ver[200] = "-"; if (!runin(vv, &r)) { size_t k = 0; while (k < r.outn && r.out[k] != '\n' && k < 199) { ver[k] = r.out[k]; k++; } ver[k] = 0; np_free(&r); }
      char *lb = cx_read(hostld, &n); char lh[65] = "-"; if (lb) { cx_sha256_hex(lb, n, lh); free(lb); } fprintf(res, "IDENTITY\tcandidate=%s\nORACLE\thost_ld=%s\toracle_id=%s+%s\n", h, hostld, ver, lh); }
    struct { const char *name, *src, *out; int rc; } fx[3] = {
        { "return7", "int main(void){return 7;}\n", "", 7 },
        { "printf", "#include <stdio.h>\nint main(void){printf(\"hi %d\\n\",42);return 3;}\n", "hi 42\n", 3 },
        { "data-bss", "#include <stdio.h>\nstatic int g[64];static const char *msg=\"data\";int main(void){int i,s=0;for(i=0;i<64;i++)g[i]=i;for(i=0;i<64;i++)s+=g[i];printf(\"%s %d\\n\",msg,s);return s%256;}\n", "data 2016\n", 224 } };
    for (int i = 0; i < 3; i++) { const char *fxn = fx[i].name; char c[64], o[64], p1[64], p2[64], img[64], d[300]; { if (cx_fmt(c, sizeof c, "%s.c", fxn)) { fprintf(stderr, "object-ld-cases: text too long for c\n"); exit(2); } } { if (cx_fmt(o, sizeof o, "%s.o", fxn)) { fprintf(stderr, "object-ld-cases: text too long for o\n"); exit(2); } } { if (cx_fmt(p1, sizeof p1, "%s.ld", fxn)) { fprintf(stderr, "object-ld-cases: text too long for p1\n"); exit(2); } } { if (cx_fmt(p2, sizeof p2, "%s.ld-static", fxn)) { fprintf(stderr, "object-ld-cases: text too long for p2\n"); exit(2); } } { if (cx_fmt(img, sizeof img, "%s.img", fxn)) { fprintf(stderr, "object-ld-cases: text too long for img\n"); exit(2); } }
        char cp[4400]; path(cp, sizeof cp, outdir, c); saved(cp, fx[i].src, strlen(fx[i].src));
        { char *v[] = { "-c", "-b", "lnx/x86_64", "-o", o, c, 0 }; np_result r; if (prod(v, &r)) die("compile"); { if (cx_fmt(d, sizeof d, "rc=%d", r.rc)) { fprintf(stderr, "object-ld-cases: text too long for d\n"); exit(2); } } check(!r.rc, fxn, "product-c.rc0", d); np_free(&r); }
        { char op[4400]; path(op, sizeof op, outdir, o); int t, m, s, ra; int ok = elf_facts(op, &t, &m, &s, &ra); { if (cx_fmt(d, sizeof d, "type=%d machine=%d global_start=%d rela=%d", t, m, s, ra)) { fprintf(stderr, "object-ld-cases: text too long for d\n"); exit(2); } } check(ok && t == 1 && m == 62 && s && ra, fxn, "object.et-rel-x86_64-global-start-with-rela", d); }
        { char *v[] = { hostld, "-o", p1, o, 0 }; np_result r; if (runin(v, &r)) die("ld"); { if (cx_fmt(d, sizeof d, "rc=%d stderr=%zu", r.rc, r.errn)) { fprintf(stderr, "object-ld-cases: text too long for d\n"); exit(2); } } check(!r.rc && !r.errn, fxn, "host-ld.rc0-empty-stderr", d); np_free(&r);
          char *w[] = { hostld, "-static", "-o", p2, o, 0 }; if (runin(w, &r)) die("ld -static"); { if (cx_fmt(d, sizeof d, "rc=%d stderr=%zu", r.rc, r.errn)) { fprintf(stderr, "object-ld-cases: text too long for d\n"); exit(2); } } check(!r.rc && !r.errn, fxn, "host-ld-static.rc0-empty-stderr", d); np_free(&r); }
        { char pp[4400]; path(pp, sizeof pp, outdir, p1); int t, m, s, ra; int ok = elf_facts(pp, &t, &m, &s, &ra); { if (cx_fmt(d, sizeof d, "type=%d rela_left=%d", t, ra)) { fprintf(stderr, "object-ld-cases: text too long for d\n"); exit(2); } } check(ok && t == 2 && !ra, fxn, "host-ld.output-et-exec-no-rela-left", d); }
        { char pp[4400]; path(pp, sizeof pp, outdir, p1); check(exec_lit(pp, fx[i].out, fx[i].rc, d, sizeof d), fxn, "host-ld.executes-literal", d); path(pp, sizeof pp, outdir, p2); check(exec_lit(pp, fx[i].out, fx[i].rc, d, sizeof d), fxn, "host-ld-static.executes-literal", d); }
        { char *v[] = { "-o", img, c, 0 }; np_result r; if (prod(v, &r)) die("image"); int rc = r.rc; np_free(&r); char pp[4400]; path(pp, sizeof pp, outdir, img); int ok = !rc && exec_lit(pp, fx[i].out, fx[i].rc, d, sizeof d); check(ok, fxn, "product-image.same-literal", d); } }
    fprintf(res, "SUMMARY\tpass=%d\tfail=%d\n", npass, nfail); fclose(res); printf("OBJECT_LD_CASES\tpass=%d\tfail=%d\n", npass, nfail); return nfail ? 1 : 0;
}
