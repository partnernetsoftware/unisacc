/* tools/check-muthelp.cx -- behaviour of tools/cxlib/muthelp.cx: literal search, one-anchor mutated copy
 * (missing and non-unique anchors refused, empty anchor copies), fixture helpers.  rc 1 on a failure. */
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use testx.check
#pragma unisa use cxlib.muthelp
#pragma unisa use cxlib.ckassert
static char *rd(const char *dir, const char *rel) {
    char p[4400]; size_t n = 0;
    cx_fmt(p, sizeof p, "%s/%s", dir, rel);
    return cx_read(p, &n);
}
int main(void) {
    char root[4096], work[4096]; char buf[8]; char *t;
    ck(mh_find_at("abcabc", 6, "ca", 2) == 2 && mh_find_at("abc", 3, "d", 1) < 0 && mh_find_at("ab", 2, "abc", 3) < 0, "find-at");
    ck(mh_find_at("a\0b", 3, "\0b", 2) == 1, "find-at-binary-safe");
    mh_copy(buf, "xyz", 3);
    ck(buf[0] == 'x' && buf[2] == 'z', "copy");
    if (tk_scratch("check-muthelp-root", root, sizeof root) || tk_scratch("check-muthelp-work", work, sizeof work)) { ck(0, "scratch"); return 1; }
    mh_put(root, "f.txt", "one two three\n");
    mh_put(root, "g.txt", "aa aa\n");
    ck(mh_put_mut(root, work, "f.txt", "two", "2"), "mut-applies");
    t = rd(work, "f.txt");
    ck(t && !strcmp(t, "one 2 three\n"), "mut-result-exact");
    ck(mh_put_mut(root, work, "f.txt", "", ""), "empty-anchor-copies");
    t = rd(work, "f.txt");
    ck(t && !strcmp(t, "one two three\n"), "empty-anchor-unchanged");
    ck(!mh_put_mut(root, work, "f.txt", "zzz", "x"), "missing-anchor-refused");
    ck(!mh_put_mut(root, work, "g.txt", "aa", "b"), "non-unique-anchor-refused");
    ck(!mh_put_mut(root, work, "nofile.txt", "a", "b"), "missing-file-refused");
    mh_put(root, "r.tsv", "a\nb\na\n");
    ck(mh_rowcount("a\nb\na\n", 6, "a") == 2 && mh_rowcount("a\nb\na\n", 6, "c") == 0, "rowcount");
    mh_mkdir(root, "sub");
    mh_put(root, "sub/h.txt", "x");
    t = rd(root, "sub/h.txt");
    ck(t && t[0] == 'x', "mkdir-then-put");
    printf("CHECK_MUTHELP\tassertions=%d\tfailed=%d\n", ck_assertions(), ck_failures());
    tk_end("CHECK_MUTHELP_SCRATCH", 0);
    return ck_failures() ? 1 : 0;
}
