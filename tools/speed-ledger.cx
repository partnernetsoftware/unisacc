/* tools/speed-ledger.cx -- offline per-version speed ledger (S5).
 *   sh ./unisacc.com tools/speed-ledger.cx -- --version VER [--repo DIR] [--chain-dir DIR] [--chain-base PREFIX] [--prerun FILE] [--units-file FILE] [--domain-total N] [--header]
 *   sh ./unisacc.com tools/speed-ledger.cx -- --check FILE --version VER [--repo DIR] [--chain-dir DIR] [--chain-base PREFIX] [--prerun FILE] [--units-file FILE] [--domain-total N]
 * Derives one TSV row from existing read-only records (git log/tags, chain-run.tsv ATTEMPT_TIME/SUPERVISE,
 * bg.log BLOCKER/SUPERVISE across all variant dirs of --chain-base, release/evidence/vVER-strict-*.tsv
 * deduplicated by BATCH_RUN id + non-RAW batch rows, tests/batch-domain-index.tsv, plans/vVER.md,
 * plans/roadmap-0.0.83-0.0.99.md, and optional --units-file).
 * Missing data is reported honestly as UNMEASURED (never guessed).
 * Columns (18):
 *   version slot_min chain_start_min chain_exit_min prerun_done_min public_min
 *   chains chain_eff chain_par prerun_par selected_batches domain_ratio
 *   planned_units done_units unplanned_units post_chain_commits throughput post_chain_to_public_min */
#pragma unisa use cxlib.ckassert
#pragma unisa use sys.fs
#pragma unisa use text.text
#pragma unisa use mem.bytes

#define SL_PW 4400
#define SL_OUT 65536
#define SL_MAXB 2048

static char sl_seen_b[SL_MAXB][128];
static int sl_nseen_b;

static void sl_add_batch_id(const char *id, size_t len) {
    if (len == 0 || len >= 128) return;
    for (int i = 0; i < sl_nseen_b; i++) {
        if (strlen(sl_seen_b[i]) == len && tx_same(sl_seen_b[i], (long)len, id, (long)len)) return;
    }
    if (sl_nseen_b < SL_MAXB) {
        if (mm_copy(sl_seen_b[sl_nseen_b], 128, id, (long)len)) return;
        sl_seen_b[sl_nseen_b][len] = 0;
        sl_nseen_b++;
    }
}

static long long sl_atoll(const char *s) {
    long long v = 0;
    int neg = 0;
    if (!s) return -1;
    while (*s == ' ' || *s == '\t') s++;
    if (*s == '-') { neg = 1; s++; }
    if (*s < '0' || *s > '9') return -1;
    while (*s >= '0' && *s <= '9') { v = v * 10 + (*s - '0'); s++; }
    return neg ? -v : v;
}

static long long sl_num_after(const char *s, const char *key) {
    const char *p = strstr(s, key);
    if (!p) return -1;
    return sl_atoll(p + strlen(key));
}

static long long sl_git_ts(const char *repo, int earliest, const char *rel_path) {
    char out[SL_OUT];
    char *av[10];
    int k = 0;
    av[k++] = "git";
    av[k++] = "-C";
    av[k++] = (char *)repo;
    av[k++] = "log";
    if (!earliest) av[k++] = "-1";
    av[k++] = "--format=%ct";
    av[k++] = "--";
    av[k++] = (char *)rel_path;
    av[k] = 0;
    if (ck_run(av, out, sizeof out) != 0 || !out[0]) return -1;
    if (!earliest) return sl_atoll(out);
    {
        char *p = out, *last = 0;
        while (*p) {
            if (*p >= '0' && *p <= '9') last = p;
            char *nl = strchr(p, '\n');
            if (!nl) break;
            p = nl + 1;
        }
        return last ? sl_atoll(last) : -1;
    }
}

static long long sl_git_tag_ts(const char *repo, const char *ver) {
    char out[SL_OUT], tag[64];
    if (cx_fmt(tag, sizeof tag, "v%s", ver)) return -1;
    {
        char *av[] = {"git", "-C", (char *)repo, "tag", "-l", tag, "--format=%(creatordate:unix)", 0};
        if (ck_run(av, out, sizeof out) == 0 && out[0] >= '0' && out[0] <= '9') return sl_atoll(out);
    }
    return -1;
}

static void sl_fmt_min(long long ts, long long slot, char *dst, size_t cap) {
    if (ts < 0 || slot < 0) {
        (void)cx_fmt(dst, (int)cap, "UNMEASURED");
        return;
    }
    long long d = ts - slot;
    int neg = 0;
    if (d < 0) { neg = 1; d = -d; }
    long long t = (d * 10 + 30) / 60;
    (void)cx_fmt(dst, (int)cap, "%s%lld.%lld", neg ? "-" : "", t / 10, t % 10);
}

static void sl_fmt_ratio2(long long num, long long den, char *dst, size_t cap) {
    if (num <= 0 || den <= 0) {
        (void)cx_fmt(dst, (int)cap, "UNMEASURED");
        return;
    }
    long long h = (num * 100 + den / 2) / den;
    (void)cx_fmt(dst, (int)cap, "%lld.%02lld", h / 100, h % 100);
}

static void sl_fmt_pct1(long long num, long long den, char *dst, size_t cap) {
    if (num < 0 || den <= 0) {
        (void)cx_fmt(dst, (int)cap, "UNMEASURED");
        return;
    }
    long long t = (num * 1000 + den / 2) / den;
    (void)cx_fmt(dst, (int)cap, "%lld.%lld%%", t / 10, t % 10);
}

typedef struct {
    long long start_ts;
    long long exit_ts;
    long long sum_ms;
    int ok;
    int valid;
    int bg_blockers;
    int bg_sup_ok;
    int bg_sup_fail;
} SlChainInfo;

static void sl_parse_bg_log(const char *path, SlChainInfo *ci) {
    size_t sz = 0, i = 0;
    char *s = cx_read(path, &sz);
    if (!s) return;
    while (i < sz) {
        size_t a = i;
        while (i < sz && s[i] != '\n') i++;
        size_t len = i - a;
        if (len > 0 && s[a + len - 1] == '\r') len--;
        if (i < sz && s[i] == '\n') i++;
        if (len == 0) continue;

        char line[1024];
        if (len >= sizeof line) len = sizeof line - 1;
        if (mm_copy(line, (long)sizeof line, s + a, (long)len)) break;
        line[len] = 0;

        if (strstr(line, "BLOCKER") != 0) {
            ci->bg_blockers++;
        } else if (tx_prefixz(line, "SUPERVISE\t", 10)) {
            long long rc = sl_num_after(line, "rc=");
            if (rc == 0) ci->bg_sup_ok++;
            else if (rc > 0) ci->bg_sup_fail++;
        }
    }
    free(s);
}

static void sl_parse_chain_dir(const char *dir, SlChainInfo *ci) {
    char p[SL_PW], bg[SL_PW];
    size_t sz = 0, i = 0;
    char *s;
    memset(ci, 0, sizeof *ci);
    ci->start_ts = -1;
    ci->exit_ts = -1;
    if (cx_fmt(p, sizeof p, "%s/chain-run.tsv", dir)) return;
    s = cx_read(p, &sz);
    if (s) {
        ci->valid = 1;
        while (i < sz) {
            size_t a = i;
            while (i < sz && s[i] != '\n') i++;
            size_t len = i - a;
            if (len > 0 && s[a + len - 1] == '\r') len--;
            if (i < sz && s[i] == '\n') i++;
            if (len == 0) continue;

            char line[1024];
            if (len >= sizeof line) len = sizeof line - 1;
            if (mm_copy(line, (long)sizeof line, s + a, (long)len)) break;
            line[len] = 0;

            if (tx_prefixz(line, "LIMITS\t", 7) || tx_prefixz(line, "SEGMENT\t", 8) || tx_prefixz(line, "YIELD\t", 6)) {
                char *t1 = strchr(line, '\t');
                long long ts = t1 ? sl_atoll(t1 + 1) : -1;
                if (ts > 0) {
                    if (ci->start_ts < 0 || ts < ci->start_ts) ci->start_ts = ts;
                    if (ts > ci->exit_ts) ci->exit_ts = ts;
                }
            } else if (tx_prefixz(line, "ATTEMPT_TIME\t", 13)) {
                long long w = sl_num_after(line, "wall_ms=");
                if (w > 0) ci->sum_ms += w;
            } else if (tx_prefixz(line, "SUPERVISE\t", 10)) {
                char *t1 = strchr(line, '\t');
                long long ts = t1 ? sl_atoll(t1 + 1) : -1;
                long long rc = sl_num_after(line, "rc=");
                if (ts > 0 && ts > ci->exit_ts) ci->exit_ts = ts;
                if (rc == 0) ci->ok = 1;
            }
        }
        free(s);
    }
    if (!cx_fmt(bg, sizeof bg, "%s/bg.log", dir)) {
        sl_parse_bg_log(bg, ci);
        if (ci->bg_blockers > 0 || ci->bg_sup_ok > 0 || ci->bg_sup_fail > 0) ci->valid = 1;
    }
}

static void sl_ver_short(const char *ver, char *out, size_t cap) {
    const char *p = ver;
    size_t o = 0;
    if (tx_prefixz(p, "0.", 2)) p += 2;
    for (; *p && o + 1 < cap; p++) {
        if (*p != '.') out[o++] = *p;
    }
    out[o] = 0;
}

typedef struct {
    SlChainInfo best;
    int chains_ok;
    int chains_total;
    long long min_start_ts;
    long long max_exit_ts;
    long long sum_wall_s;
} SlChainAgg;

static void sl_accum_chain(SlChainAgg *agg, const SlChainInfo *ci) {
    int dir_ok = (ci->ok || ci->bg_sup_ok > 0) ? 1 : 0;
    int dir_fail = ci->bg_sup_fail + ci->bg_blockers;
    if (!dir_ok && dir_fail == 0) dir_fail = 1;
    agg->chains_ok += dir_ok;
    agg->chains_total += dir_ok + dir_fail;

    if (ci->start_ts > 0) {
        if (agg->min_start_ts < 0 || ci->start_ts < agg->min_start_ts) agg->min_start_ts = ci->start_ts;
    }
    if (ci->exit_ts > 0) {
        if (agg->max_exit_ts < 0 || ci->exit_ts > agg->max_exit_ts) agg->max_exit_ts = ci->exit_ts;
    }
    if (ci->start_ts > 0 && ci->exit_ts > ci->start_ts) {
        agg->sum_wall_s += (ci->exit_ts - ci->start_ts);
    }
    if (!agg->best.valid || (dir_ok && !agg->best.ok) || (dir_ok == agg->best.ok && ci->start_ts > agg->best.start_ts)) {
        agg->best = *ci;
        agg->best.ok = dir_ok;
    }
}

static void sl_discover_chains(const char *ver, const char *opt_chain_dir, const char *opt_chain_base, SlChainAgg *agg) {
    memset(agg, 0, sizeof *agg);
    agg->best.start_ts = -1;
    agg->best.exit_ts = -1;
    agg->min_start_ts = -1;
    agg->max_exit_ts = -1;

    if (opt_chain_dir) {
        SlChainInfo ci;
        sl_parse_chain_dir(opt_chain_dir, &ci);
        if (ci.valid) sl_accum_chain(agg, &ci);
        return;
    }

    char parent[SL_PW], pref[256];
    if (opt_chain_base) {
        const char *sl = strrchr(opt_chain_base, '/');
        if (!sl) return;
        size_t plen = (size_t)(sl - opt_chain_base);
        if (plen == 0) {
            if (cx_fmt(parent, sizeof parent, "/")) return;
        } else {
            if (plen >= sizeof parent || mm_copy(parent, (long)sizeof parent, opt_chain_base, (long)plen)) return;
            parent[plen] = 0;
        }
        if (cx_fmt(pref, sizeof pref, "%s", sl + 1)) return;
    } else {
        char vshort[32];
        sl_ver_short(ver, vshort, sizeof vshort);
        if (cx_fmt(parent, sizeof parent, "/tmp")) return;
        if (cx_fmt(pref, sizeof pref, "unisacc-session-v%s-chain", vshort)) return;
    }

    size_t prlen = strlen(pref);
    DIR *dp = opendir(parent);
    if (!dp) return;
    struct dirent *de;
    while ((de = readdir(dp)) != 0) {
        if (!tx_prefixz(de->d_name, pref, (long)prlen)) continue;
        char sdir[SL_PW];
        if (cx_fmt(sdir, sizeof sdir, "%s/%s", parent, de->d_name)) continue;

        /* Support both direct chain-run.tsv/bg.log in variant dir and nested <sha>/ subdirs */
        {
            SlChainInfo direct;
            sl_parse_chain_dir(sdir, &direct);
            if (direct.valid) {
                sl_accum_chain(agg, &direct);
                continue;
            }
        }
        DIR *sub = opendir(sdir);
        if (!sub) continue;
        struct dirent *sde;
        while ((sde = readdir(sub)) != 0) {
            if (sde->d_name[0] == '.') continue;
            char subp[SL_PW];
            SlChainInfo ci;
            if (cx_fmt(subp, sizeof subp, "%s/%s", sdir, sde->d_name)) continue;
            sl_parse_chain_dir(subp, &ci);
            if (ci.valid) sl_accum_chain(agg, &ci);
        }
        closedir(sub);
    }
    closedir(dp);
}

static int sl_find_strict(const char *repo, const char *ver, char *rel_out, size_t cap) {
    char edir[SL_PW], pref[64];
    DIR *dp;
    struct dirent *de;
    int found = 0;
    rel_out[0] = 0;
    if (cx_fmt(edir, sizeof edir, "%s/release/evidence", repo)) return 0;
    if (cx_fmt(pref, sizeof pref, "v%s-strict-", ver)) return 0;
    dp = opendir(edir);
    if (!dp) return 0;
    while ((de = readdir(dp)) != 0) {
        size_t nl = strlen(de->d_name);
        if (!tx_prefixz(de->d_name, pref, (long)strlen(pref))) continue;
        if (nl < 4 || !tx_eqz(de->d_name + nl - 4, ".tsv")) continue;
        char cand[SL_PW];
        if (cx_fmt(cand, sizeof cand, "release/evidence/%s", de->d_name)) continue;
        if (!found || strcmp(cand, rel_out) > 0) {
            if (!cx_fmt(rel_out, (int)cap, "%s", cand)) found = 1;
        }
    }
    closedir(dp);
    return found;
}

static void sl_parse_prerun(const char *path, long long *sel_batches, long long *sum_ms, long long *wall_ms) {
    size_t sz = 0, i = 0;
    char *s = cx_read(path, &sz);
    long long summary_b = -1;
    sl_nseen_b = 0;
    *sel_batches = -1;
    *sum_ms = 0;
    *wall_ms = 0;
    if (!s) return;
    while (i < sz) {
        size_t a = i;
        while (i < sz && s[i] != '\n') i++;
        size_t len = i - a;
        if (len > 0 && s[a + len - 1] == '\r') len--;
        if (i < sz && s[i] == '\n') i++;
        if (len == 0 || s[a] == '#') continue;

        char line[1024];
        if (len >= sizeof line) len = sizeof line - 1;
        if (mm_copy(line, (long)sizeof line, s + a, (long)len)) break;
        line[len] = 0;

        if (tx_prefixz(line, "SUMMARY\t", 8)) {
            long long b = sl_num_after(line, "batches=");
            long long tm = sl_num_after(line, "total_ms=");
            if (b >= 0) summary_b = b;
            if (tm > 0) *wall_ms += tm;
        } else if (tx_prefixz(line, "RAW\t", 4)) {
            const char *idp = strstr(line, "id=");
            if (idp) {
                idp += 3;
                size_t k = 0;
                while (idp[k] && idp[k] != '\t' && idp[k] != ' ') k++;
                sl_add_batch_id(idp, k);
            }
        } else if (!tx_prefixz(line, "batch\t", 6)) {
            char *t1 = strchr(line, '\t');
            if (t1 && t1 > line) {
                sl_add_batch_id(line, (size_t)(t1 - line));
            }
            char *p = line;
            int col = 0;
            while (p && col < 5) {
                p = strchr(p, '\t');
                if (p) p++;
                col++;
            }
            if (p && col == 5) {
                long long ms = sl_atoll(p);
                if (ms > 0) *sum_ms += ms;
            }
        }
    }
    free(s);
    if (sl_nseen_b > 0) *sel_batches = sl_nseen_b;
    else if (summary_b >= 0) *sel_batches = summary_b;
}

static long long sl_count_domain(const char *repo) {
    char p[SL_PW];
    size_t sz = 0, i = 0;
    long long n = 0;
    if (cx_fmt(p, sizeof p, "%s/tests/batch-domain-index.tsv", repo)) return -1;
    char *s = cx_read(p, &sz);
    if (!s) {
        char qp[SL_PW], qc[SL_PW];
        if (!cx_fmt(qp, sizeof qp, "%s/unisacc.com", repo) && !cx_fmt(qc, sizeof qc, "%s/tools/derived-query.cx", repo) &&
            sy_exists(qp) == 1 && sy_exists(qc) == 1) {
            char *qv[] = { "sh", qp, qc, "--", "batch-domains", "--root", (char *)repo, "--path", 0 };
            char *qo = 0; size_t qn = 0;
            if (cx_runv_timeout(qv, 45, &qo, &qn) == 0 && qo && qn > 0) {
                while (qn > 0 && (qo[qn - 1] == '\n' || qo[qn - 1] == '\r')) qo[--qn] = 0;
                if (qn > 0) s = cx_read(qo, &sz);
            }
            if (qo) free(qo);
        }
    }
    if (!s) return -1;
    while (i < sz) {
        size_t a = i;
        while (i < sz && s[i] != '\n') i++;
        size_t len = i - a;
        if (i < sz && s[i] == '\n') i++;
        if (len > 0 && tx_find(s + a, (long)len, "\tproduct-qualification\t", 23) >= 0) n++;
    }
    free(s);
    return n > 0 ? n : -1;
}

static long long sl_parse_dec1(const char *s) {
    long long whole = 0, frac = 0;
    if (!s) return -1;
    while (*s == ' ' || *s == '\t') s++;
    if (*s < '0' || *s > '9') return -1;
    while (*s >= '0' && *s <= '9') { whole = whole * 10 + (*s - '0'); s++; }
    if (*s == '.') {
        s++;
        if (*s < '0' || *s > '9') return -1;
        frac = *s - '0';
    }
    return whole * 10 + frac;
}

static void sl_fmt_dec1(long long x10, char *dst, size_t cap) {
    if (x10 < 0) {
        (void)cx_fmt(dst, (int)cap, "UNMEASURED");
        return;
    }
    if (x10 % 10 == 0) (void)cx_fmt(dst, (int)cap, "%lld", x10 / 10);
    else (void)cx_fmt(dst, (int)cap, "%lld.%lld", x10 / 10, x10 % 10);
}

static const char *sl_kv_find(const char *line, const char *key) {
    const char *p = line;
    size_t klen = strlen(key);
    while ((p = strstr(p, key)) != 0) {
        if (p == line) return p + klen;
        char prev = p[-1];
        if (!((prev >= 'a' && prev <= 'z') || (prev >= 'A' && prev <= 'Z') || (prev >= '0' && prev <= '9') || prev == '_')) {
            return p + klen;
        }
        p += klen;
    }
    return 0;
}

static void sl_units_from_kv(const char *path, long long *planned, long long *done, long long *unplanned) {
    size_t sz = 0, i = 0;
    char *s = cx_read(path, &sz);
    if (!s) return;
    while (i < sz) {
        size_t a = i;
        while (i < sz && s[i] != '\n') i++;
        size_t len = i - a;
        if (len > 0 && s[a + len - 1] == '\r') len--;
        if (i < sz && s[i] == '\n') i++;
        if (len == 0) continue;

        char line[1024];
        if (len >= sizeof line) len = sizeof line - 1;
        if (mm_copy(line, (long)sizeof line, s + a, (long)len)) break;
        line[len] = 0;

        const char *p;
        if ((p = sl_kv_find(line, "planned_units=")) != 0) {
            long long v = sl_parse_dec1(p);
            if (v >= 0) *planned = v;
        }
        if ((p = sl_kv_find(line, "done_units=")) != 0) {
            long long v = sl_parse_dec1(p);
            if (v >= 0) *done = v;
        }
        if ((p = sl_kv_find(line, "unplanned_units=")) != 0) {
            long long v = sl_parse_dec1(p);
            if (v >= 0) *unplanned = v;
        }
    }
    free(s);
}

static void sl_units_from_tsv(const char *path, const char *ver, long long *planned, long long *done, long long *unplanned) {
    size_t sz = 0, i = 0;
    char *s = cx_read(path, &sz);
    char key[80];
    if (!s) return;
    if (cx_fmt(key, sizeof key, "%s\t", ver)) { free(s); return; }
    size_t klen = strlen(key);
    while (i < sz) {
        size_t a = i;
        while (i < sz && s[i] != '\n') i++;
        size_t len = i - a;
        if (len > 0 && s[a + len - 1] == '\r') len--;
        if (i < sz && s[i] == '\n') i++;
        if (len < klen || !tx_same(s + a, (long)klen, key, (long)klen)) continue;

        char line[512];
        if (len >= sizeof line) len = sizeof line - 1;
        if (mm_copy(line, (long)sizeof line, s + a, (long)len)) break;
        line[len] = 0;

        char *c1 = strchr(line, '\t');
        if (!c1) break;
        c1++;
        char *c2 = strchr(c1, '\t');
        if (c2) *c2++ = 0;
        char *c3 = c2 ? strchr(c2, '\t') : 0;
        if (c3) *c3++ = 0;
        if (c3) {
            char *c4 = strchr(c3, '\t');
            if (c4) *c4 = 0;
        }
        long long v1 = sl_parse_dec1(c1);
        long long v2 = c2 ? sl_parse_dec1(c2) : -1;
        long long v3 = c3 ? sl_parse_dec1(c3) : -1;
        if (v1 >= 0) *planned = v1;
        if (v2 >= 0) *done = v2;
        if (v3 >= 0) *unplanned = v3;
        break;
    }
    free(s);
}

static long long sl_planned_from_roadmap(const char *repo, const char *ver) {
    char p[SL_PW], key[80];
    size_t sz = 0, i = 0;
    if (cx_fmt(p, sizeof p, "%s/plans/roadmap-0.0.83-0.0.99.md", repo)) return -1;
    if (cx_fmt(key, sizeof key, "| %s |", ver)) return -1;
    char *s = cx_read(p, &sz);
    if (!s) return -1;
    size_t klen = strlen(key);
    long long res = -1;
    while (i < sz) {
        size_t a = i;
        while (i < sz && s[i] != '\n') i++;
        size_t len = i - a;
        if (len > 0 && s[a + len - 1] == '\r') len--;
        if (i < sz && s[i] == '\n') i++;
        if (len < klen || !tx_same(s + a, (long)klen, key, (long)klen)) continue;

        char line[1024];
        if (len >= sizeof line) len = sizeof line - 1;
        if (mm_copy(line, (long)sizeof line, s + a, (long)len)) break;
        line[len] = 0;

        /* Find "| <planned>/<cap> |" column in D table */
        char *q = line;
        while ((q = strchr(q, '|')) != 0) {
            q++;
            while (*q == ' ') q++;
            if (*q >= '0' && *q <= '9') {
                char *r = q;
                while ((*r >= '0' && *r <= '9') || *r == '.') r++;
                if (*r == '/' && r[1] >= '0' && r[1] <= '9') {
                    char *e = r + 1;
                    while ((*e >= '0' && *e <= '9') || *e == '.') e++;
                    while (*e == ' ') e++;
                    if (*e == '|') {
                        res = sl_parse_dec1(q);
                        break;
                    }
                }
            }
        }
        if (res >= 0) break;
    }
    free(s);
    return res;
}

static int sl_git_ref_exists(const char *repo, const char *ref) {
    char out[256];
    char *av[] = {"git", "-C", (char *)repo, "rev-parse", "--verify", "-q", (char *)ref, 0};
    return ck_run(av, out, sizeof out) == 0 && out[0] != 0;
}

static long long sl_git_ref_ts(const char *repo, const char *ref) {
    char out[256];
    char *av[] = {"git", "-C", (char *)repo, "log", "-1", "--format=%ct", (char *)ref, 0};
    if (ck_run(av, out, sizeof out) != 0 || !out[0]) return -1;
    return sl_atoll(out);
}

static long long sl_count_post_chain_commits(const char *repo, const char *ver, long long start_ts, long long end_ts) {
    if (start_ts <= 0) return -1;
    if (end_ts > 0 && end_ts <= start_ts + 1) return 0;

    char after_arg[64], before_arg[64], tag_ref[80], br_ref[80], out[256];
    if (cx_fmt(after_arg, sizeof after_arg, "--after=%lld", start_ts + 1)) return -1;
    if (end_ts > 0 && cx_fmt(before_arg, sizeof before_arg, "--before=%lld", end_ts - 1)) return -1;
    if (cx_fmt(tag_ref, sizeof tag_ref, "refs/tags/v%s", ver)) return -1;
    if (cx_fmt(br_ref, sizeof br_ref, "refs/heads/v%s", ver)) return -1;

    int has_tag = sl_git_ref_exists(repo, tag_ref);
    int has_br = sl_git_ref_exists(repo, br_ref);

    char *av[24];
    int k = 0;
    av[k++] = "git";
    av[k++] = "-C";
    av[k++] = (char *)repo;
    av[k++] = "rev-list";
    av[k++] = "--count";
    av[k++] = after_arg;
    if (end_ts > 0) av[k++] = before_arg;
    av[k++] = "HEAD";
    if (has_tag) av[k++] = tag_ref;
    if (has_br) av[k++] = br_ref;
    av[k++] = "--";
    av[k++] = "src/";
    av[k++] = "cx/";
    av[k++] = "exec/";
    av[k++] = "include/";
    av[k++] = "seed/";
    av[k++] = "weights/";
    av[k++] = "kernel/";
    av[k++] = "tools/";
    av[k] = 0;

    if (ck_run(av, out, sizeof out) != 0 || !out[0]) return -1;
    return sl_atoll(out);
}

int main(int argc, char **argv) {
    const char *ver = 0;
    const char *repo = ".";
    const char *opt_chain = 0;
    const char *opt_chain_base = 0;
    const char *opt_prerun = 0;
    const char *opt_units = 0;
    const char *opt_check = 0;
    long long opt_dom = -1;
    int show_hdr = 0;

    for (int i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--version") && i + 1 < argc) ver = argv[++i];
        else if (tx_eqz(argv[i], "--repo") && i + 1 < argc) repo = argv[++i];
        else if (tx_eqz(argv[i], "--chain-dir") && i + 1 < argc) opt_chain = argv[++i];
        else if (tx_eqz(argv[i], "--chain-base") && i + 1 < argc) opt_chain_base = argv[++i];
        else if (tx_eqz(argv[i], "--prerun") && i + 1 < argc) opt_prerun = argv[++i];
        else if (tx_eqz(argv[i], "--units-file") && i + 1 < argc) opt_units = argv[++i];
        else if (tx_eqz(argv[i], "--check") && i + 1 < argc) opt_check = argv[++i];
        else if (tx_eqz(argv[i], "--domain-total") && i + 1 < argc) opt_dom = sl_atoll(argv[++i]);
        else if (tx_eqz(argv[i], "--header")) show_hdr = 1;
        else {
            fprintf(stderr, "usage: speed-ledger --version VER [--repo DIR] [--chain-dir DIR] [--chain-base PREFIX] [--prerun FILE] [--units-file FILE] [--domain-total N] [--header] [--check FILE]\n");
            return 2;
        }
    }
    if (!ver || !ver[0]) {
        fprintf(stderr, "speed-ledger: REFUSE --version required\n");
        return 2;
    }

    char plan_rel[128], pub_rel[128], strict_rel[SL_PW], prerun_full[SL_PW];
    if (cx_fmt(plan_rel, sizeof plan_rel, "plans/v%s.md", ver)) return 2;
    if (cx_fmt(pub_rel, sizeof pub_rel, "release/evidence/%s/public-readback.txt", ver)) return 2;

    long long slot_ts = sl_git_ts(repo, 1, plan_rel);
    long long pub_ts = sl_git_ts(repo, 0, pub_rel);
    if (pub_ts < 0) pub_ts = sl_git_tag_ts(repo, ver);

    SlChainAgg agg;
    sl_discover_chains(ver, opt_chain, opt_chain_base, &agg);

    long long prerun_ts = -1, sel_b = -1, pr_sum = 0, pr_wall = 0;
    strict_rel[0] = 0;
    if (opt_prerun) {
        if (opt_prerun[0] == '/') {
            if (cx_fmt(prerun_full, sizeof prerun_full, "%s", opt_prerun)) return 2;
        } else {
            if (cx_fmt(prerun_full, sizeof prerun_full, "%s/%s", repo, opt_prerun)) return 2;
            prerun_ts = sl_git_ts(repo, 0, opt_prerun);
        }
        if (prerun_ts < 0) {
            struct stat st;
            if (stat(prerun_full, &st) == 0) prerun_ts = (long long)st.st_mtime;
        }
        sl_parse_prerun(prerun_full, &sel_b, &pr_sum, &pr_wall);
    } else if (sl_find_strict(repo, ver, strict_rel, sizeof strict_rel)) {
        if (cx_fmt(prerun_full, sizeof prerun_full, "%s/%s", repo, strict_rel)) return 2;
        prerun_ts = sl_git_ts(repo, 0, strict_rel);
        sl_parse_prerun(prerun_full, &sel_b, &pr_sum, &pr_wall);
    }

    long long dom_tot = opt_dom > 0 ? opt_dom : sl_count_domain(repo);

    char f_slot[32], f_cs[32], f_ce[32], f_pr[32], f_pub[32];
    char f_chains[32], f_ceff[32], f_cpar[32], f_ppar[32], f_sel[32], f_drat[32];
    sl_fmt_min(slot_ts, slot_ts, f_slot, sizeof f_slot);
    sl_fmt_min(agg.best.start_ts, slot_ts, f_cs, sizeof f_cs);
    sl_fmt_min(agg.best.exit_ts, slot_ts, f_ce, sizeof f_ce);
    sl_fmt_min(prerun_ts, slot_ts, f_pr, sizeof f_pr);
    sl_fmt_min(pub_ts, slot_ts, f_pub, sizeof f_pub);

    if (agg.chains_total > 0) {
        (void)cx_fmt(f_chains, sizeof f_chains, "%d/%d", agg.chains_ok, agg.chains_total);
        long long ok_wall_s = (agg.best.ok && agg.best.start_ts > 0 && agg.best.exit_ts > agg.best.start_ts) ? (agg.best.exit_ts - agg.best.start_ts) : 0;
        long long span_s = (agg.min_start_ts > 0 && agg.max_exit_ts > agg.min_start_ts) ? (agg.max_exit_ts - agg.min_start_ts) : 0;
        long long tot_wall_s = agg.sum_wall_s > span_s ? agg.sum_wall_s : span_s;
        if (ok_wall_s > 0 && tot_wall_s > 0) {
            sl_fmt_pct1(ok_wall_s, tot_wall_s, f_ceff, sizeof f_ceff);
        } else {
            sl_fmt_pct1(agg.chains_ok, agg.chains_total, f_ceff, sizeof f_ceff);
        }
    } else {
        (void)cx_fmt(f_chains, sizeof f_chains, "UNMEASURED");
        (void)cx_fmt(f_ceff, sizeof f_ceff, "UNMEASURED");
    }

    if (agg.best.valid && agg.best.start_ts > 0 && agg.best.exit_ts > agg.best.start_ts && agg.best.sum_ms > 0) {
        sl_fmt_ratio2(agg.best.sum_ms, (agg.best.exit_ts - agg.best.start_ts) * 1000LL, f_cpar, sizeof f_cpar);
    } else {
        (void)cx_fmt(f_cpar, sizeof f_cpar, "UNMEASURED");
    }

    sl_fmt_ratio2(pr_sum, pr_wall, f_ppar, sizeof f_ppar);

    if (sel_b >= 0) {
        if (dom_tot > 0) {
            (void)cx_fmt(f_sel, sizeof f_sel, "%lld/%lld", sel_b, dom_tot);
            sl_fmt_pct1(sel_b, dom_tot, f_drat, sizeof f_drat);
        } else {
            (void)cx_fmt(f_sel, sizeof f_sel, "%lld", sel_b);
            (void)cx_fmt(f_drat, sizeof f_drat, "UNMEASURED");
        }
    } else {
        (void)cx_fmt(f_sel, sizeof f_sel, "UNMEASURED");
        (void)cx_fmt(f_drat, sizeof f_drat, "UNMEASURED");
    }

    long long planned_x10 = -1, done_x10 = -1, unpl_x10 = -1;
    {
        char plan_full[SL_PW];
        if (!cx_fmt(plan_full, sizeof plan_full, "%s/%s", repo, plan_rel)) {
            sl_units_from_kv(plan_full, &planned_x10, &done_x10, &unpl_x10);
        }
        if (planned_x10 < 0) planned_x10 = sl_planned_from_roadmap(repo, ver);
        if (opt_units) sl_units_from_tsv(opt_units, ver, &planned_x10, &done_x10, &unpl_x10);
    }

    long long freeze_ts = -1;
    {
        char tag_ref[80];
        if (!cx_fmt(tag_ref, sizeof tag_ref, "refs/tags/v%s", ver) && sl_git_ref_exists(repo, tag_ref)) {
            freeze_ts = sl_git_ref_ts(repo, tag_ref);
        }
        if (freeze_ts < 0) freeze_ts = pub_ts;
    }
    long long post_commits = sl_count_post_chain_commits(repo, ver, agg.best.start_ts, freeze_ts);

    char f_plan[32], f_done[32], f_unpl[32], f_pcc[32], f_tput[32], f_p2p[32];
    sl_fmt_dec1(planned_x10, f_plan, sizeof f_plan);
    sl_fmt_dec1(done_x10, f_done, sizeof f_done);
    sl_fmt_dec1(unpl_x10, f_unpl, sizeof f_unpl);
    if (post_commits >= 0) (void)cx_fmt(f_pcc, sizeof f_pcc, "%lld", post_commits);
    else (void)cx_fmt(f_pcc, sizeof f_pcc, "UNMEASURED");

    if (done_x10 >= 0 && slot_ts > 0 && pub_ts > slot_ts) {
        long long pub_s = pub_ts - slot_ts;
        long long h = (done_x10 * 36000LL + pub_s / 2) / pub_s;
        (void)cx_fmt(f_tput, sizeof f_tput, "%lld.%02lld", h / 100, h % 100);
    } else {
        (void)cx_fmt(f_tput, sizeof f_tput, "UNMEASURED");
    }
    sl_fmt_min(pub_ts, agg.best.exit_ts, f_p2p, sizeof f_p2p);

    char row[1536];
    if (cx_fmt(row, sizeof row, "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s",
        ver, f_slot, f_cs, f_ce, f_pr, f_pub, f_chains, f_ceff, f_cpar, f_ppar, f_sel, f_drat,
        f_plan, f_done, f_unpl, f_pcc, f_tput, f_p2p)) return 2;

    if (opt_check) {
        size_t bsz = 0, i = 0;
        char *bs = cx_read(opt_check, &bsz);
        char key[80];
        int matched = 0, found = 0;
        if (!bs) {
            fprintf(stderr, "speed-ledger: REFUSE cannot read %s\n", opt_check);
            return 2;
        }
        if (cx_fmt(key, sizeof key, "%s\t", ver)) return 2;
        while (i < bsz) {
            size_t a = i;
            while (i < bsz && bs[i] != '\n') i++;
            size_t len = i - a;
            if (len > 0 && bs[a + len - 1] == '\r') len--;
            if (i < bsz && bs[i] == '\n') i++;
            if (len >= strlen(key) && tx_same(bs + a, (long)strlen(key), key, (long)strlen(key))) {
                found = 1;
                if (len == strlen(row) && tx_same(bs + a, (long)len, row, (long)len)) {
                    matched = 1;
                } else {
                    printf("DIFF\tversion=%s\texpected=%.*s\tactual=%s\n", ver, (int)len, bs + a, row);
                }
                break;
            }
        }
        free(bs);
        if (!found) printf("DIFF\tversion=%s\texpected=MISSING\tactual=%s\n", ver, row);
        printf("SPEED_LEDGER\tmode=check\tversion=%s\tstatus=%s\n", ver, matched ? "OK" : "DRIFT");
        return matched ? 0 : 1;
    }

    if (show_hdr) {
        printf("version\tslot_min\tchain_start_min\tchain_exit_min\tprerun_done_min\tpublic_min\tchains\tchain_eff\tchain_par\tprerun_par\tselected_batches\tdomain_ratio\tplanned_units\tdone_units\tunplanned_units\tpost_chain_commits\tthroughput\tpost_chain_to_public_min\n");
    }
    printf("%s\n", row);
    return 0;
}
