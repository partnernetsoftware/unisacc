/* tools/check-cscan.cx -- behaviour of tools/cxlib/cscan.cx: identifier classes, word compare, comment and
 * literal erasure keeping newlines, owned copies, substring search.  Prints PASS/FAIL rows; rc 1 on a failure. */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use cxlib.cscan
#pragma unisa use cxlib.ckassert
int main(void) {
    char a[] = "int x; /* c\nd */ y = \"s//t\"; // e\nz = 'q';\n";
    char *d, *e;
    long n = 0;
    ck(cs_idch('a') && cs_idch('Z') && cs_idch('7') && cs_idch('_') && !cs_idch('-') && !cs_idch(' '), "idch-classes");
    ck(cs_idstart('a') && cs_idstart('_') && !cs_idstart('7') && !cs_idstart('.'), "idstart-classes");
    ck(cs_word_eq("abcd", 3, "abc") && !cs_word_eq("abcd", 4, "abc") && !cs_word_eq("abx", 3, "abc"), "word-eq-exact");
    cs_strip_comments(a, (long)strlen(a));
    ck(a[0] == 'i' && !strstr(a, "c\nd") && !strstr(a, "s//t") && !strstr(a, "//") && !strstr(a, "'q'"), "strip-erases-comments-and-literals");
    ck(a[11] == '\n' && a[strlen(a) - 1] == '\n', "strip-keeps-newlines");
    ck(strstr(a, "z =") && strstr(a, "y ="), "strip-keeps-code");
    d = cs_dupn("hello", 3);
    ck(d && d[3] == 0 && d[0] == 'h' && d[2] == 'l', "dupn-copy-terminated");
    ck(cs_streq("ab", "ab") && !cs_streq("ab", "abc") && !cs_streq("ab", "ac"), "streq");
    ck(cs_fnd("hello world", "o w") && *cs_fnd("hello", "ll") == 'l' && !cs_fnd("hello", "xy"), "fnd");
    e = cs_slurp("tools/check-cscan.cx", &n);
    sy_stat_t st;
    ck(e && n > 100 && sy_stat("tools/check-cscan.cx", &st) == 0 &&
       n == st.size && e[n] == 0 && e[0] == '/', "slurp-reads-file");
    ck(!cs_slurp("tools/no-such-file.cx", &n), "slurp-missing-is-null");
    printf("CHECK_CSCAN\tassertions=%d\tfailed=%d\n", ck_assertions(), ck_failures());
    return ck_failures() ? 1 : 0;
}
