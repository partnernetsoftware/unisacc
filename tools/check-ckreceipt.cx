/* Check the assertion wire and the runner-owned receipt location. */
#pragma unisa use cxlib.ckreceipt
#pragma unisa use cxlib.ckassert
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use mem.heap

static int failed;

static void expect(int ok, const char *name) {
    printf("%s\tckreceipt.%s\n", ok ? "PASS" : "FAIL", name);
    if (!ok) failed++;
}

int main(void) {
    static char attempt[] = "0123456789abcdef0123456789abcdef"
                            "0123456789abcdef0123456789abcdef";
    char root[4096], dir[4096], receipts[4096], slot[4096], file[4096];
    if (sy_cwd(root, sizeof root) ||
        sy_mkdtemp(sy_tmpdir(), "unisacc-session-check-ckreceipt-", dir, sizeof dir) ||
        cx_fmt(receipts, sizeof receipts, "%s/receipts", dir) || sy_mkdir(receipts, 0700) ||
        sy_mkdtemp(receipts, "attempt-", slot, sizeof slot) ||
        cx_fmt(file, sizeof file, "%s/assertions.tsv", slot)) return 2;

    expect(ckr_receipt_path(root, file), "private-attempt");
    expect(!ckr_receipt_path(root, receipts), "receipt-leaf-required");

    char *args[] = {"check-ckreceipt", "--ck-receipt-v1", file, attempt, 0};
    int count = 4;
    int began = ck_receipt_begin(&count, args);
    expect(began == 1 && count == 1 && !args[1], "consume-runner-argv");
    ck_observe(1);
    ck_observe(0);
    ck_receipt_finish();

    size_t n = 0;
    char *receipt = cx_read(file, &n);
    unsigned long passes = 0, failures = 0;
    expect(receipt && ckr_verify(receipt, n, attempt, &passes, &failures) == 1 &&
           passes == 1 && failures == 1, "writer-reader-agree");
    expect(receipt && n > 0 && ckr_verify(receipt, n - 1, attempt, &passes, &failures) < 0,
           "truncated-footer-refused");
    expect(receipt && ckr_verify(receipt, n, "wrong-attempt", &passes, &failures) < 0,
           "wrong-attempt-refused");
    expect(ckr_verify("", 0, attempt, &passes, &failures) == 0 &&
           passes == 0 && failures == 0, "missing-distinct-from-zero");
    mm_free(receipt);
    if (cx_rmtree(dir)) return 2;
    printf("CHECK_CKRECEIPT\tfailed=%d\n", failed);
    return failed != 0;
}
