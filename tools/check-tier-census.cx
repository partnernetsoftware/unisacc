/* tools/check-tier-census.cx -- checks tools/tier-census.cx on a private fixture root and the repo.
 *
 *   sh ./unisacc.com tools/check-tier-census.cx
 *
 * Verifies tier1_chain, tier2_gen (generator + replaceable companion check), domain_check (EVIDENCE and INFERRED),
 * tier3_oneshot, unknown-option refusal (rc 2), and repo smoke run.
 * Ends with CHECK_TIER_CENSUS<TAB>failed=N. */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sys.posix
#pragma unisa use cxlib.procrun
#pragma unisa use text.text
#pragma unisa use mem.bytes

static int tc_failed;
static char tc_out[1 << 16];

static void tc_ck(int ok, const char *name) {
    if (!ok) tc_failed++;
    sy_printf("%s\ttier-census.%s\n", ok ? "PASS" : "FAIL", name);
}

static int tc_substr(const char *hay, long hn, const char *ned) {
    long nn = tx_len(ned, 512), i;
    char n0;
    if (!hay || !ned || nn <= 0 || nn > hn) return 0;
    n0 = ned[0];
    for (i = 0; i + nn <= hn; i++) if (hay[i] == n0 && mm_same(hay + i, ned, nn)) return 1;
    return 0;
}

static int tc_run(char **args) {
    char *av[16];
    int k = 0, i, cut = 0;
    const char *u = sy_env("UNISACC");
    if (!u || !*u) u = "./unisacc.com";
    av[k++] = "sh";
    av[k++] = (char *)u;
    av[k++] = "tools/tier-census.cx";
    av[k++] = "--";
    for (i = 0; args[i] && k < 15; i++) av[k++] = args[i];
    av[k] = 0;
    return pr_run_merged(av, 45, tc_out, (int)sizeof tc_out, &cut);
}

static void tc_put(const char *root, const char *rel, const char *body) {
    char p[700];
    if (!cx_fmt(p, sizeof p, "%s/%s", root, rel)) cx_write(p, body, tx_len(body, 1 << 16));
}

int main(void) {
    char root[600], p[700], lpath[700], opath[700];
    int rc;
    size_t sz = 0;
    char *tsv = 0;

    if (cx_fmt(root, sizeof root, "%s/tier-census-ck-%d", sy_tmpdir(), (int)sy_pid())) return 2;
    sy_mkdir(root, 0700);
    if (!cx_fmt(p, sizeof p, "%s/tools", root)) sy_mkdir(p, 0700);
    if (!cx_fmt(p, sizeof p, "%s/tests", root)) sy_mkdir(p, 0700);

    tc_put(root, "tools/caller.cx", "int main(void) { const char *p = \"tools/chain-a.cx\"; return p[0] == 0; }\n");
    tc_put(root, "tools/chain-a.cx", "int main(void) { return 0; }\n");
    tc_put(root, "tools/foo-gen.cx", "#pragma unisa use cxlib.genkit\nint main(void) { return 0; }\n");
    tc_put(root, "tools/check-foo-gen.cx", "int main(void) { const char *g = \"tools/foo-gen.cx\"; const char *m = \"--check\"; return g[0] == m[0]; }\n");
    tc_put(root, "tools/check-ext-bar.cx", "#pragma unisa use textx.json\nint main(void) { return 0; }\n");
    tc_put(root, "tools/check-uxe-inferred.cx", "int main(void) { return 0; }\n");
    tc_put(root, "tools/oneshot.cx", "int main(void) { return 0; }\n");
    tc_put(root, "tests/batches.tsv", "# empty\n");
    tc_put(root, "list.tsv",
        "tools/chain-a.cx\t2026-11-20\n"
        "tools/foo-gen.cx\t2026-11-20\n"
        "tools/check-foo-gen.cx\t2026-11-20\n"
        "tools/check-ext-bar.cx\t2026-11-20\n"
        "tools/check-uxe-inferred.cx\t2026-11-20\n"
        "tools/oneshot.cx\t2026-11-20\n");

    cx_fmt(lpath, sizeof lpath, "%s/list.tsv", root);
    cx_fmt(opath, sizeof opath, "%s/out.tsv", root);
    {
        char *a[] = {"--root", root, "--list", lpath, "--out", opath, 0};
        rc = tc_run(a);
    }
    tc_ck(rc == 0 && tc_substr(tc_out, tx_len(tc_out, sizeof tc_out),
          "TIER_CENSUS_SUMMARY\ttotal=6\tabsent=0\t") &&
          tc_substr(tc_out, tx_len(tc_out, sizeof tc_out), "\ttier1=1\t") &&
          tc_substr(tc_out, tx_len(tc_out, sizeof tc_out), "\ttier2=2\t") &&
          tc_substr(tc_out, tx_len(tc_out, sizeof tc_out), "\tdomain=2\t") &&
          tc_substr(tc_out, tx_len(tc_out, sizeof tc_out), "\ttier3=1\t") &&
          tc_substr(tc_out, tx_len(tc_out, sizeof tc_out), "\tinferred=1\ttier3_plus_domain=3\t") &&
          tc_substr(tc_out, tx_len(tc_out, sizeof tc_out), "\tt2_checks=1\tt2_replaceable=1\n"),
          "fixture-summary-counts");

    tsv = cx_read(opath, &sz);
    tc_ck(tsv && tc_substr(tsv, (long)sz, "tools/chain-a.cx\t2026-11-20\t1\ttier1_chain\tEVIDENCE\tref:tools\n"), "fixture-tier1-chain");
    tc_ck(tsv && tc_substr(tsv, (long)sz, "tools/foo-gen.cx\t2026-11-20\t2\ttier2_gen\tEVIDENCE\tgen:uses-genkit\n") &&
          tc_substr(tsv, (long)sz, "tools/check-foo-gen.cx\t2026-11-20\t1\ttier2_gen\tEVIDENCE\tgen-check:calls-gen-cx\n"), "fixture-tier2-gen");
    tc_ck(tsv && tc_substr(tsv, (long)sz, "tools/check-ext-bar.cx\t2026-11-20\t2\tdomain_check\tEVIDENCE\tdomain:non-tool-module-no-tool-call\n") &&
          tc_substr(tsv, (long)sz, "tools/check-uxe-inferred.cx\t2026-11-20\t1\tdomain_check\tINFERRED\tname:domain-prefix\n"), "fixture-domain-evidence-and-inferred");
    tc_ck(tsv && tc_substr(tsv, (long)sz, "tools/oneshot.cx\t2026-11-20\t1\ttier3_oneshot\tEVIDENCE\tno-ref-no-batch-no-check\n"), "fixture-tier3-oneshot");
    if (tsv) free(tsv);

    {
        char *a[] = {"--bogus", 0};
        rc = tc_run(a);
        tc_ck(rc == 2, "unknown-option-exit-2");
    }

    {
        char *a[] = {"--since", "7", "--out", opath, 0};
        rc = tc_run(a);
        tc_ck(rc == 0 && tc_substr(tc_out, tx_len(tc_out, sizeof tc_out), "TIER_CENSUS_SUMMARY\ttotal="), "repo-smoke-ok");
    }

    cx_rmtree(root);
    sy_printf("CHECK_TIER_CENSUS\tfailed=%d\n", tc_failed);
    return tc_failed ? 1 : 0;
}
