/* tools/own-flow.cx -- prototype of OWN-E2 (plans/v0.0.77.md 2.3, A1): use after free and double free found by a
 * linear, intraprocedural scan of each function body of a .cx file.  It is written in the restricted style of
 * cx/cx0/plan.cx (fixed arrays, no callbacks, one pass over a token array) so the core can move into the
 * planner (P5) unchanged in shape.
 *
 *   sh ./unisacc.com tools/own-flow.cx -- FILE...
 *
 * Rules.  Subjects are the plain local names (parameters included; globals and file statics excluded) that
 * appear as the only argument of a releaser: free, mm_free, and every NAME declared in the same file by a
 * comment `own-flow: releases NAME`, or by a one-line macro `#define NAME(x) free(x)` (mm_free or a declared
 * releaser in place of free).  The argument may be parenthesized or cast: free((p)), free((void *)p).
 * No-return calls also include names containing panic, die_, _die, fatal_, and functions of the same file
 * whose body ends in a no-return call.  A name declared in an inner block leaves scope with it.
 * The body is walked statement by statement (braced or not); a name is live until it is released, then freed
 * (with the line).  Every merge point joins the incoming flow states: freed on any incoming path is freed.
 *   E2   any later occurrence of a freed name -- dereference, argument, operand, test, return -- is a use
 *        after free (pointer value reads included: C11 6.2.4p2 makes the value indeterminate).
 *   E2b  a freed name given to a releaser again is a double free.
 * A name comes back to live when it is assigned as a whole (`p = ...`), declared again, or its address is
 * taken (`&p`, treated as reassigned).  `sizeof p` and member names (`x.p`, `x->p`) are not uses.
 * Flow: return, break, continue, goto and a no-return call (exit, abort, _exit, _Exit, sy_exit, die, fatal,
 * longjmp) end the path where they stand.  if/else arms (braced or not) start from the state after the
 * condition and are joined afterwards (possibly freed is rejected).  A switch case label joins the switch
 * entry with the fall-through of the group before it; the switch exit joins every break, the fall-through of
 * the last group, and the entry when there is no default.  Loops (for, while, do, braced or not): the body
 * is read from the entry and, when the back edge (end of body join continue states, then step and condition)
 * adds a release, once more from entry join back edge, so a release the next iteration reaches again is a
 * double free; the exit joins the back edge (none for for (;;), while (1), do .. while (1)) and every break.
 * A goto joins its state into the label; a label joins that with the fall-through; with any goto the body is
 * read twice so a backward goto reaches its label.
 * Escape: a comment `own-flow: unsafe` inside a function, or between the previous function and its body,
 * exempts that function; it is counted (OWNFLOW_UNSAFE line, unsafe= in the summary).  `#pragma unisa unsafe`
 * does not exist before P1; the comment is the prototype marker.
 *
 * Limits (silent misses, also printed as the LIMITS line): no aliasing (q = p, then free p, then use q), no
 * struct fields, array elements or globals as subjects, no transfer of ownership across functions (a callee
 * that frees its argument is not a releaser unless declared; release through a function pointer is missed),
 * no longjmp/setjmp, macros other than the one-line releaser form are not expanded, a loop body is read at
 * most twice, a ?: arm is read as unconditional, shadowing names in inner blocks are not separated from the
 * outer name (the outer one is live again after the block).  Preprocessor lines are skipped (both arms of #if
 * are read).
 *
 * Output: one line per finding
 *   OWNFLOW<TAB>FILE:LINE<TAB>FUNCTION<TAB>NAME<TAB>E2|E2b<TAB>text
 * one OWNFLOW_UNSAFE<TAB>FILE:LINE<TAB>FUNCTION per exempt function, the LIMITS line, and last
 *   OWNFLOW_SUMMARY files=F functions=N flagged=M findings=K unsafe=U
 * where flagged counts functions with at least one finding.  rc 1 when K > 0, rc 2 on a usage or read error. */
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

enum { T_ID = 1, T_P, T_LIT };
typedef struct { int k, off, len, line, mt; } Tok;

#define MAXV 64
#define MAXD 64
#define MAXREP 256
#define MAXREL 32

static const char *src;
static Tok *tk;
static int ntk;
static int ulines[256], nul;
static char relname[MAXREL][64];
static int nrel;
/* functions of this file whose body ends in a no-return call (found per file, three rounds) */
#define MAXNR 256
static int nr_off[MAXNR], nr_len[MAXNR], nnr;
static int local_noret(int i) {
    int r;
    for (r = 0; r < nnr; r++) if (tk[i].len == nr_len[r] && memcmp(src + tk[i].off, src + nr_off[r], (size_t)nr_len[r]) == 0) return 1;
    return 0;
}

/* per function state.  A flow state St holds, per subject, freed (st) and the line of the release (fl);
   dead marks an unreachable point (after return, break, continue, goto or a no-return call). */
typedef struct { int st[MAXV], fl[MAXV], dead; } St;
static int vo[MAXV], vl[MAXV], vd[MAXV], nv;
static St cur;
static int rkey[MAXREP][3], nrkey;
static const char *g_file, *g_fn;
static int g_fnlen, g_find;
static int depth_now;

/* break/continue targets: loops (kind 1) and switches (kind 2); a switch also keeps its entry state */
static int fr_kind[MAXD], fr_default[MAXD], nfr;
static St fr_brk[MAXD], fr_cont[MAXD], fr_ent[MAXD];
/* goto labels: state joined from every goto and from the fall-through into the label */
#define MAXL 32
static int lb_off[MAXL], lb_len[MAXL], nlb;
static St lb_st[MAXL];

static int files, functions, flagged, findings, unsafe_n;

static int is_ids(int c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'; }
static int of_idc(int c) { return (c >= '0' && c <= '9') || is_ids(c); }

static int tis(int i, const char *w) {
    int n = (int)tx_len(w, 64);
    return i >= 0 && i < ntk && tk[i].len == n && memcmp(src + tk[i].off, w, (size_t)n) == 0;
}
static int tp(int i, int c) { return i >= 0 && i < ntk && tk[i].k == T_P && src[tk[i].off] == c; }
static int tid(int i) { return i >= 0 && i < ntk && tk[i].k == T_ID; }

static void note_comment(const char *s, long n, int line) {
    long i;
    for (i = 0; i + 9 <= n; i++) {
        if (memcmp(s + i, "own-flow:", 9) != 0) continue;
        long j = i + 9;
        while (j < n && s[j] == ' ') j++;
        if (j + 6 <= n && memcmp(s + j, "unsafe", 6) == 0) { if (nul < 256) ulines[nul++] = line; }
        else if (j + 8 <= n && memcmp(s + j, "releases", 8) == 0) {
            j += 8;
            while (j < n && s[j] == ' ') j++;
            long a = j;
            while (j < n && of_idc(s[j])) j++;
            if (j > a && j - a < 64 && nrel < MAXREL) { mm_copy(relname[nrel], 64, s + a, (size_t)(j - a)); relname[nrel][j - a] = 0; nrel++; }
        }
        return;
    }
}

/* `#define NAME(x) free(x)` (or mm_free, or a releaser declared earlier in the file) makes NAME a releaser;
   the body must be exactly one releaser call on the macro parameter, an optional `;` allowed */
static long skip_sp(long j, long n) { while (j < n && (src[j] == ' ' || src[j] == '\t')) j++; return j; }
static long word(long j, long n) { while (j < n && of_idc(src[j])) j++; return j; }
static void note_define(long i, long n) {
    long j = skip_sp(i + 1, n), a, b, pa, pb, ra, rb2;
    int r, known = 0;
    if (j + 6 > n || memcmp(src + j, "define", 6) != 0) return;
    j = skip_sp(j + 6, n); a = j; j = word(j, n); b = j;
    if (b == a || j >= n || src[j] != '(') return;
    j = skip_sp(j + 1, n); pa = j; j = word(j, n); pb = j;
    j = skip_sp(j, n);
    if (pb == pa || j >= n || src[j] != ')') return;
    j = skip_sp(j + 1, n); ra = j; j = word(j, n); rb2 = j;
    if (rb2 - ra == 4 && memcmp(src + ra, "free", 4) == 0) known = 1;
    if (rb2 - ra == 7 && memcmp(src + ra, "mm_free", 7) == 0) known = 1;
    for (r = 0; r < nrel; r++) if ((long)tx_len(relname[r], 64) == rb2 - ra && memcmp(src + ra, relname[r], (size_t)(rb2 - ra)) == 0) known = 1;
    if (!known) return;
    j = skip_sp(j, n);
    if (j >= n || src[j] != '(') return;
    j = skip_sp(j + 1, n);
    if (j + (pb - pa) > n || memcmp(src + j, src + pa, (size_t)(pb - pa)) != 0) return;
    j = skip_sp(j + (pb - pa), n);
    if (j >= n || src[j] != ')') return;
    j = skip_sp(j + 1, n);
    if (j < n && src[j] == ';') j = skip_sp(j + 1, n);
    if (j < n && src[j] != '\n' && src[j] != '\r') return;
    if (b - a < 64 && nrel < MAXREL) { mm_copy(relname[nrel], 64, src + a, (size_t)(b - a)); relname[nrel][b - a] = 0; nrel++; }
}

static int lex(long n) {
    long i = 0; int line = 1, bol = 1;
    ntk = 0; nul = 0; nrel = 0;
    while (i < n) {
        char c = src[i];
        if (c == '\n') { line++; bol = 1; i++; continue; }
        if (c == ' ' || c == '\t' || c == '\r' || c == '\f') { i++; continue; }
        if (c == '#' && bol) {
            note_define(i, n);
            while (i < n && src[i] != '\n') { if (src[i] == '\\' && i + 1 < n && src[i + 1] == '\n') { line++; i++; } i++; }
            continue;
        }
        bol = 0;
        if (c == '/' && i + 1 < n && src[i + 1] == '*') {
            long a = i; int l0 = line; i += 2;
            while (i + 1 < n && !(src[i] == '*' && src[i + 1] == '/')) { if (src[i] == '\n') line++; i++; }
            i += 2;
            note_comment(src + a, i - a, l0);
            continue;
        }
        if (c == '/' && i + 1 < n && src[i + 1] == '/') {
            long a = i;
            while (i < n && src[i] != '\n') i++;
            note_comment(src + a, i - a, line);
            continue;
        }
        Tok *t = &tk[ntk];
        t->off = (int)i; t->line = line; t->mt = -1;
        if (c == '"' || c == '\'') {
            char q = c; i++;
            while (i < n && src[i] != q && src[i] != '\n') { if (src[i] == '\\') i++; i++; }
            i++; t->k = T_LIT;
        } else if (is_ids(c)) {
            while (i < n && of_idc(src[i])) i++;
            t->k = T_ID;
        } else if (c >= '0' && c <= '9') {
            while (i < n && (of_idc(src[i]) || src[i] == '.')) i++;
            t->k = T_LIT;
        } else { i++; t->k = T_P; }
        t->len = (int)(i - t->off);
        ntk++;
    }
    /* bracket matching */
    {
        int stk[4096], sp = 0, k;
        for (k = 0; k < ntk; k++) {
            if (tk[k].k != T_P) continue;
            char c = src[tk[k].off];
            if (c == '(' || c == '[' || c == '{') { if (sp >= 4096) return -1; stk[sp++] = k; }
            else if (c == ')' || c == ']' || c == '}') { if (sp <= 0) return -1; int o = stk[--sp]; tk[o].mt = k; tk[k].mt = o; }
        }
        if (sp) return -1;
    }
    return 0;
}

static int releaser(int i) {
    int r;
    if (!tid(i)) return 0;
    if (tis(i, "free") || tis(i, "mm_free")) return 1;
    for (r = 0; r < nrel; r++) if (tis(i, relname[r])) return 1;
    return 0;
}
/* releaser call at I: the token of its single plain-name argument (parentheses and one cast stripped:
   free((p)), free((void *)p)), or -1 */
static int rel_arg(int i) {
    int a, e;
    if (!releaser(i) || !tp(i + 1, '(') || tk[i + 1].mt < 0 || tp(i - 1, '.') || tp(i - 1, '>')) return -1;
    a = i + 2; e = tk[i + 1].mt - 1;
    while (a < e && tp(a, '(') && tk[a].mt == e) { a++; e--; }
    if (a < e && tp(a, '(') && tk[a].mt > a && tk[a].mt < e && tid(a + 1)) {
        int c = tk[a].mt, j, typ = 1;
        for (j = a + 1; j < c; j++) if (!(tid(j) || tp(j, '*'))) typ = 0;
        if (typ) a = c + 1;
        while (a < e && tp(a, '(') && tk[a].mt == e) { a++; e--; }
    }
    return a == e && tid(a) ? a : -1;
}

/* identifier I contains W (no-return naming convention: core_host_panic, die_usage, fatal_io) */
static int name_has(int i, const char *w) {
    int n = (int)tx_len(w, 64), j;
    if (!tid(i)) return 0;
    for (j = 0; j + n <= tk[i].len; j++) if (memcmp(src + tk[i].off + j, w, (size_t)n) == 0) return 1;
    return 0;
}
static int noreturn_call(int i) {
    return tis(i, "exit") || tis(i, "abort") || tis(i, "_exit") || tis(i, "_Exit") || tis(i, "sy_exit") ||
           tis(i, "die") || tis(i, "fatal") || tis(i, "longjmp") || tis(i, "siglongjmp") || name_has(i, "panic") ||
           name_has(i, "die_") || name_has(i, "fatal_") || name_has(i, "_die") || local_noret(i);
}
static int stmt_kw(int i) {
    return tis(i, "return") || tis(i, "else") || tis(i, "case") || tis(i, "do") || tis(i, "sizeof") || tis(i, "goto");
}

static int var_of(int i, int add) {
    int v;
    for (v = 0; v < nv; v++) if (vl[v] == tk[i].len && memcmp(src + vo[v], src + tk[i].off, (size_t)vl[v]) == 0) return v;
    if (!add || nv >= MAXV) return -1;
    vo[nv] = tk[i].off; vl[nv] = tk[i].len; vd[nv] = 0; cur.st[nv] = 0; cur.fl[nv] = 0;
    return nv++;
}

/* one line per (name, line, kind); nothing is reported at an unreachable point */
static void report(int v, int line, int kind) {
    int r;
    if (cur.dead) return;
    for (r = 0; r < nrkey; r++) if (rkey[r][0] == v && rkey[r][1] == line && rkey[r][2] == kind) return;
    if (nrkey < MAXREP) { rkey[nrkey][0] = v; rkey[nrkey][1] = line; rkey[nrkey][2] = kind; nrkey++; }
    if (kind == 2) printf("OWNFLOW\t%s:%d\t%.*s\t%.*s\tE2b\t%.*s is released twice (first at line %d)\n", g_file, line, g_fnlen, g_fn, vl[v], src + vo[v], vl[v], src + vo[v], cur.fl[v]);
    else printf("OWNFLOW\t%s:%d\t%.*s\t%.*s\tE2\t%.*s is used after free at line %d\n", g_file, line, g_fnlen, g_fn, vl[v], src + vo[v], vl[v], src + vo[v], cur.fl[v]);
    findings++; g_find++;
}

/* A := A join B: freed on either path is freed; an unreachable side adds nothing */
static void join(St *a, const St *b) {
    int v;
    if (b->dead) return;
    if (a->dead) { *a = *b; return; }
    for (v = 0; v < nv; v++) if (!a->st[v] && b->st[v]) { a->st[v] = 1; a->fl[v] = b->fl[v]; }
}
static void set_dead(St *a) { int v; for (v = 0; v < MAXV; v++) { a->st[v] = 0; a->fl[v] = 0; } a->dead = 1; }
/* B adds a release that A lacks */
static int adds(const St *a, const St *b) {
    int v;
    if (b->dead) return 0;
    if (a->dead) { for (v = 0; v < nv; v++) if (b->st[v]) return 1; return 0; }
    for (v = 0; v < nv; v++) if (b->st[v] && !a->st[v]) return 1;
    return 0;
}

/* first token of the last statement before the closing brace RB, or -1 */
static int last_stmt(int lb, int rb) {
    int j = rb - 1;
    if (!tp(j, ';')) return -1;
    j--;
    while (j > lb) {
        if ((tp(j, ')') || tp(j, ']')) && tk[j].mt >= 0) { j = tk[j].mt - 1; continue; }
        if (tp(j, ';') || tp(j, '{') || tp(j, '}')) break;
        j--;
    }
    return j + 1;
}

/* token K is a declaration of its name: `T NAME` or `T *NAME` followed by ; , = [ or ) */
static int is_decl(int k) {
    if (!(tp(k + 1, ';') || tp(k + 1, ',') || tp(k + 1, '=') || tp(k + 1, '[') || tp(k + 1, ')'))) return 0;
    if (tid(k - 1) && !stmt_kw(k - 1)) return 1;
    return tp(k - 1, '*') && (tid(k - 2) || tp(k - 2, '*') || tp(k - 2, ',')) && !stmt_kw(k - 2);
}
/* the name at token I is a parameter or a local of the function whose parameter list ends at LB - 1;
   globals and file statics are not subjects (a callee may reassign them) */
static int declared_local(int i, int lb, int rb) {
    int k, from = tp(lb - 1, ')') && tk[lb - 1].mt > 0 ? tk[lb - 1].mt : lb;
    for (k = from; k < rb; k++)
        if (tid(k) && tk[k].len == tk[i].len && memcmp(src + tk[k].off, src + tk[i].off, (size_t)tk[i].len) == 0 && is_decl(k)) return 1;
    return 0;
}

/* ---- structured walk: one statement at a time, flow states joined at every merge point ---- */
static int stmt(int i, int rb);

/* end of the expression statement at I: its `;`, or the closing brace / RB when there is none */
static int stmt_end(int i, int rb) {
    int j = i;
    while (j < rb) {
        if ((tp(j, '(') || tp(j, '[') || tp(j, '{')) && tk[j].mt > j) { j = tk[j].mt + 1; continue; }
        if (tp(j, ';') || tp(j, '}')) return j;
        j++;
    }
    return rb;
}

/* tokens [A, B) in source order: releases, uses, reassignments */
static void expr(int a, int b) {
    int k = a;
    while (k < b) {
        int s = rel_arg(k);
        if (s >= 0) {
            int v = var_of(s, 0), close = tk[k + 1].mt;
            if (v >= 0) {
                if (cur.st[v]) report(v, tk[s].line, 2);
                else { cur.st[v] = 1; cur.fl[v] = tk[s].line; }
            }
            k = close + 1; continue;
        }
        if (tid(k) && !tp(k + 1, '(')) {
            int v = var_of(k, 0);
            if (v < 0 || tp(k - 1, '.') || (tp(k - 1, '>') && tp(k - 2, '-'))) { k++; continue; }
            int assign = tp(k + 1, '=') && !tp(k + 2, '=');
            int decl = (tp(k + 1, ';') || tp(k + 1, ',') || tp(k + 1, '=') || tp(k + 1, '[')) &&
                       ((tid(k - 1) && !stmt_kw(k - 1)) || (tp(k - 1, '*') && (tid(k - 2) || tp(k - 2, '*') || tp(k - 2, ',')) && !stmt_kw(k - 2)));
            int deref_assign = assign && tp(k - 1, '*') && !decl;
            int addr = tp(k - 1, '&') && !(tid(k - 2) || tp(k - 2, ')') || tp(k - 2, ']') || (k >= 2 && tk[k - 2].k == T_LIT));
            int szof = tis(k - 1, "sizeof") || (tp(k - 1, '(') && tis(k - 2, "sizeof"));
            if (szof) { k++; continue; }
            if (decl) vd[v] = depth_now;
            if (decl || addr || (assign && !deref_assign && !tp(k - 1, ']'))) { cur.st[v] = 0; k++; continue; }
            if (cur.st[v]) report(v, tk[k].line, 1);
            k++; continue;
        }
        k++;
    }
}

static int block(int lb) {
    int rb = tk[lb].mt, j = lb + 1, v;
    depth_now++;
    while (j < rb) { int nj = stmt(j, rb); j = nj > j ? nj : j + 1; }
    depth_now--;
    /* names declared inside the closed block go out of scope */
    for (v = 0; v < nv; v++) if (vd[v] > depth_now) { cur.st[v] = 0; vd[v] = 0; }
    return rb + 1;
}

static int label_of(int i) {
    int l;
    for (l = 0; l < nlb; l++) if (lb_len[l] == tk[i].len && memcmp(src + lb_off[l], src + tk[i].off, (size_t)tk[i].len) == 0) return l;
    if (nlb >= MAXL) return -1;
    lb_off[nlb] = tk[i].off; lb_len[nlb] = tk[i].len; set_dead(&lb_st[nlb]);
    return nlb++;
}

static int push_frame(int kind) {
    if (nfr >= MAXD) return -1;
    fr_kind[nfr] = kind; fr_default[nfr] = 0;
    set_dead(&fr_brk[nfr]); set_dead(&fr_cont[nfr]); fr_ent[nfr] = cur;
    return nfr++;
}

/* while and for: COND [CA, CB) is read before every iteration, STEP [SA, SB) after it.  The body runs zero
   or more times: it is read once from the entry, and once more from entry join back edge when the back edge
   brings a release the entry lacks.  The exit is entry join back edge (none for a loop without a condition)
   join every break. */
static int run_loop(int ca, int cb, int sa, int sb, int body, int rb, int forever) {
    St e, back;
    int f, end = body, it;
    expr(ca, cb);
    e = cur;
    f = push_frame(1);
    if (f < 0) return stmt_end(body, rb) + 1;
    for (it = 0; it < 2; it++) {
        end = stmt(body, rb);
        join(&cur, &fr_cont[f]);
        expr(sa, sb);
        expr(ca, cb);
        back = cur;
        if (it == 1 || !adds(&e, &back)) break;
        cur = e; join(&cur, &back);
    }
    if (forever) set_dead(&cur); else { St x = e; join(&x, &back); cur = x; }
    join(&cur, &fr_brk[f]);
    nfr--;
    return end;
}

static int cond_forever(int ca, int cb) {
    return ca == cb || (cb == ca + 1 && (tis(ca, "1") || tis(ca, "true")));
}

static int stmt(int i, int rb) {
    if (i >= rb) return rb;
    if (tp(i, '{') && tk[i].mt > i) return block(i);
    if (tp(i, ';')) return i + 1;
    if (tis(i, "if") && tp(i + 1, '(') && tk[i + 1].mt > i) {
        int c = tk[i + 1].mt, j;
        St e, a;
        expr(i + 2, c);
        e = cur;
        j = stmt(c + 1, rb);
        a = cur;
        if (tis(j, "else")) { cur = e; j = stmt(j + 1, rb); join(&cur, &a); }
        else join(&cur, &e);
        return j;
    }
    if (tis(i, "while") && tp(i + 1, '(') && tk[i + 1].mt > i) {
        int c = tk[i + 1].mt;
        return run_loop(i + 2, c, c, c, c + 1, rb, cond_forever(i + 2, c));
    }
    if (tis(i, "for") && tp(i + 1, '(') && tk[i + 1].mt > i) {
        int c = tk[i + 1].mt, j, s1 = -1, s2 = -1;
        for (j = i + 2; j < c; j++) {
            if ((tp(j, '(') || tp(j, '[') || tp(j, '{')) && tk[j].mt > j) { j = tk[j].mt; continue; }
            if (tp(j, ';')) { if (s1 < 0) s1 = j; else if (s2 < 0) s2 = j; }
        }
        if (s1 < 0 || s2 < 0) { expr(i + 2, c); return run_loop(c, c, c, c, c + 1, rb, 0); }
        expr(i + 2, s1);
        return run_loop(s1 + 1, s2, s2 + 1, c, c + 1, rb, cond_forever(s1 + 1, s2));
    }
    if (tis(i, "do")) {
        St e = cur, back;
        int f = push_frame(1), j = i + 1, c = -1, it;
        if (f < 0) return i + 1;
        for (it = 0; it < 2; it++) {
            j = stmt(i + 1, rb);
            join(&cur, &fr_cont[f]);
            if (tis(j, "while") && tp(j + 1, '(') && tk[j + 1].mt > j) { c = tk[j + 1].mt; expr(j + 2, c); }
            back = cur;
            if (it == 1 || !adds(&e, &back)) break;
            cur = e; join(&cur, &back);
        }
        cur = back;
        if (c > 0 && cond_forever(j + 2, c)) set_dead(&cur);
        join(&cur, &fr_brk[f]);
        nfr--;
        if (c > 0) return tp(c + 1, ';') ? c + 2 : c + 1;
        return j;
    }
    if (tis(i, "switch") && tp(i + 1, '(') && tk[i + 1].mt > i) {
        int c = tk[i + 1].mt, f, j;
        St fall;
        expr(i + 2, c);
        if (!tp(c + 1, '{')) return stmt(c + 1, rb);
        f = push_frame(2);
        if (f < 0) return tk[c + 1].mt + 1;
        set_dead(&cur);
        j = block(c + 1);
        fall = cur;
        cur = fr_brk[f];
        join(&cur, &fall);
        if (!fr_default[f]) join(&cur, &fr_ent[f]);
        nfr--;
        return j;
    }
    if (tis(i, "case") || (tis(i, "default") && tp(i + 1, ':'))) {
        int f, j = i + 1;
        for (f = nfr - 1; f >= 0 && fr_kind[f] != 2; f--) ;
        if (tis(i, "case"))
            while (j < rb && !(tp(j, ':') && !tp(j + 1, ':'))) { if ((tp(j, '(') || tp(j, '[')) && tk[j].mt > j) j = tk[j].mt; j++; }
        if (f >= 0) { join(&cur, &fr_ent[f]); if (tis(i, "default")) fr_default[f] = 1; }
        return j + 1;
    }
    if (tis(i, "return")) {
        int e = stmt_end(i, rb);
        expr(i + 1, e);
        set_dead(&cur);
        return tp(e, ';') ? e + 1 : e;
    }
    if ((tis(i, "break") || tis(i, "continue")) && tp(i + 1, ';')) {
        int f = nfr - 1;
        if (tis(i, "continue")) while (f >= 0 && fr_kind[f] != 1) f--;
        if (f >= 0) join(tis(i, "break") ? &fr_brk[f] : &fr_cont[f], &cur);
        set_dead(&cur);
        return i + 2;
    }
    if (tis(i, "goto") && tid(i + 1)) {
        int l = label_of(i + 1);
        if (l >= 0) join(&lb_st[l], &cur);
        set_dead(&cur);
        return tp(i + 2, ';') ? i + 3 : i + 2;
    }
    if (tis(i, "else")) return i + 1;
    if (tid(i) && tp(i + 1, ':') && !tp(i + 2, ':')) {
        int l = label_of(i);
        if (l >= 0) join(&cur, &lb_st[l]);
        return i + 2;
    }
    {
        int e = stmt_end(i, rb);
        expr(i, e);
        if (tid(i) && tp(i + 1, '(') && noreturn_call(i)) set_dead(&cur);
        return tp(e, ';') ? e + 1 : (e > i ? e : i + 1);
    }
}

static void scan_body(int lb, int rb) {
    int d, pass, has_goto = 0;
    nfr = 0; nlb = 0; depth_now = 0;
    for (d = 0; d < MAXV; d++) { cur.st[d] = 0; cur.fl[d] = 0; }
    cur.dead = 0;
    /* subjects: every plain local name handed to a releaser somewhere in this body */
    for (d = lb + 1; d < rb; d++) {
        int s = rel_arg(d);
        if (s >= 0 && declared_local(s, lb, rb)) var_of(s, 1);
        if (tis(d, "goto")) has_goto = 1;
    }
    /* a backward goto carries states the first pass meets only after the label: read the body twice */
    for (pass = 0; pass < (has_goto ? 2 : 1); pass++) {
        for (d = 0; d < MAXV; d++) { cur.st[d] = 0; cur.fl[d] = 0; vd[d] = 0; }
        cur.dead = 0; nfr = 0; depth_now = 0;
        block(lb);
    }
}

static int fn_unsafe(int from_line, int to_line) {
    int u;
    for (u = 0; u < nul; u++) if (ulines[u] > from_line && ulines[u] <= to_line) return 1;
    return 0;
}

static int do_file(const char *path) {
    size_t n;
    char *s = cx_read(path, &n);
    int k, depth = 0, prev_end_line = 0;
    if (!s) { fprintf(stderr, "own-flow: cannot read %s\n", path); return 2; }
    src = s;
    tk = mm_alloc((n + 16) * sizeof(Tok));
    if (!tk) { mm_free(s); return 2; }
    files++;
    if (lex((long)n)) { printf("OWNFLOW_SKIP\t%s\tunbalanced brackets\n", path); mm_free(tk); mm_free(s); return 0; }
    nnr = 0;
    {
        int round;
        for (round = 0; round < 3; round++) {
            int d = 0;
            for (k = 0; k < ntk; k++) {
                if (tp(k, '{')) {
                    if (d == 0 && tp(k - 1, ')') && tk[k - 1].mt > 0 && tid(tk[k - 1].mt - 1) && tk[k].mt > k) {
                        int nm = tk[k - 1].mt - 1, rb = tk[k].mt, s = last_stmt(k, rb);
                        if (s >= 0 && tid(s) && tp(s + 1, '(') && noreturn_call(s) && !local_noret(nm) && nnr < MAXNR) {
                            nr_off[nnr] = tk[nm].off; nr_len[nnr] = tk[nm].len; nnr++;
                        }
                        k = rb; continue;
                    }
                    d++;
                } else if (tp(k, '}') && d > 0) d--;
            }
        }
    }
    for (k = 0; k < ntk; k++) {
        if (tp(k, '{')) {
            if (depth == 0 && tp(k - 1, ')') && tk[k - 1].mt > 0 && tid(tk[k - 1].mt - 1) && tk[k].mt > k) {
                int nm = tk[k - 1].mt - 1, rb = tk[k].mt;
                functions++;
                g_file = path; g_fn = src + tk[nm].off; g_fnlen = tk[nm].len; g_find = 0;
                nv = 0; nrkey = 0;
                if (fn_unsafe(prev_end_line, tk[rb].line)) {
                    unsafe_n++;
                    printf("OWNFLOW_UNSAFE\t%s:%d\t%.*s\n", path, tk[nm].line, g_fnlen, g_fn);
                } else {
                    scan_body(k, rb);
                    if (g_find) flagged++;
                }
                prev_end_line = tk[rb].line;
                k = rb;
                continue;
            }
            depth++;
        } else if (tp(k, '}')) { if (depth > 0) depth--; prev_end_line = tk[k].line; }
        else if (depth == 0 && tp(k, ';')) prev_end_line = tk[k].line;
    }
    mm_free(tk); tk = 0;
    mm_free(s);
    return 0;
}

int main(int argc, char **argv) {
    int a, rc = 0;
    if (argc < 2) { fprintf(stderr, "usage: own-flow.cx -- FILE...\n"); return 2; }
    for (a = 1; a < argc; a++) if (do_file(argv[a])) rc = 2;
    printf("LIMITS\tno-alias\tno-fields-or-globals\tno-cross-function-transfer\tno-longjmp\tmacro-releaser-one-line-only\tloop-body-read-twice\tternary-arm-unconditional\tno-shadowing\n");
    printf("OWNFLOW_SUMMARY files=%d functions=%d flagged=%d findings=%d unsafe=%d\n", files, functions, flagged, findings, unsafe_n);
    if (rc) return rc;
    return findings ? 1 : 0;
}
