            ck(rc == 2 && has(out, "REFUSE\tLAUNCH_ENV\treason=ident-helper-ephemeral"), "ident-require-persistent-refuses-tmp-launch-env");

            cx_fmt(sub, sizeof sub,
                "env -i HOME=\"$HOME\" PATH=/usr/bin:/bin TMPDIR=/tmp UNISACC_IDENT_HELPER='%s' "
                "sh ./unisacc.com tools/chain-ready.cx -- --launch-env --repo '%s' --strict-helper --require-persistent-helper",
                ih_persist, irepo);
            rc = run((char *[]){"./tools/bound", "30", "sh", "-c", sub, 0}, out, sizeof out);
            ck(rc == 0 && has(out, "CHAIN_READY_LAUNCH_ENV\tok=1") && has(out, "--require-persistent-helper"), "ident-require-persistent-accepts-persistent-launch-env");

            cx_fmt(cmd, sizeof cmd, "rm -f '%s' '%s.ident' '%s'", ih_persist, ih_persist, ph_link);
            { char *sv[] = {"./tools/bound", "10", "sh", "-c", cmd, 0}; (void)run(sv, out, sizeof out); }
        } else {
            ck(1, "ident-prepare-helper-persistent-builds");
            ck(1, "ident-prepare-helper-persistent-reuses");
            ck(1, "ident-prepare-helper-symlink-to-tmp-refused");
            ck(1, "ident-require-persistent-refuses-tmp-gate20");
            ck(1, "ident-require-persistent-refuses-tmp-launch-env");
            ck(1, "ident-require-persistent-accepts-persistent-launch-env");
        }

        /* Non-R4 private source mutants (red-then-green kill: refusal passes on clean, turns RED on mutant) */
        {
            char mdir[1200];
            if (prepare_alt_cr_tree(cwd, "lstat",
                    "if (sy_lstat(ih, &hst) != 0 || hst.kind != 'f')",
                    "struct stat _hst; if (stat(ih, &_hst) != 0 || !S_ISREG(_hst.st_mode))", mdir, sizeof mdir) == 0) {
                cx_fmt(sub, sizeof sub, "--only 20-ident-helper --repo '%s'", irepo);
                cx_fmt(cmd, sizeof cmd, "UNISACC_IDENT_HELPER='%s' sh ./unisacc.com tools/chain-ready.cx -- %s", ih_sym, sub);
                int c_ok = (run((char *[]){"./tools/bound", "30", "sh", "-c", cmd, 0}, out, sizeof out) == 1 && has(out, "missing-or-not-regular"));
                cx_fmt(cmd, sizeof cmd, "cd '%s' && UNISACC_IDENT_HELPER='%s' sh ./unisacc.com tools/chain-ready.cx -- %s", mdir, ih_sym, sub);
                int m_ok = (run((char *[]){"./tools/bound", "45", "sh", "-c", cmd, 0}, out, sizeof out) == 1 && has(out, "missing-or-not-regular"));
                ck(c_ok == 1 && m_ok == 0, "ident-mut-symlink-helper-killed-red-then-green");
            } else ck(0, "ident-mut-symlink-helper-killed-red-then-green");

            if (prepare_alt_cr_tree(cwd, "strict-probe",
                    "    if (strict_req) {\n        if (cr_abs_from_cwd(ih, abs_ih, sizeof abs_ih) || cr_probe_helper_exec(repo, abs_ih) != 0) {",
                    "    if (0) {\n        if (cr_abs_from_cwd(ih, abs_ih, sizeof abs_ih) || cr_probe_helper_exec(repo, abs_ih) != 0) {", mdir, sizeof mdir) == 0) {
                cx_fmt(cmd, sizeof cmd, "UNISACC_IDENT_HELPER='%s' sh ./unisacc.com tools/chain-ready.cx -- --only 20-ident-helper --repo '%s' --strict-helper", ih_fail, irepo);
                int c_ok = (run((char *[]){"./tools/bound", "30", "sh", "-c", cmd, 0}, out, sizeof out) == 1 && has(out, "helper-exec-probe-failed"));
                cx_fmt(cmd, sizeof cmd, "cd '%s' && UNISACC_IDENT_HELPER='%s' sh ./unisacc.com tools/chain-ready.cx -- --only 20-ident-helper --repo '%s' --strict-helper", mdir, ih_fail, irepo);
                int m_ok = (run((char *[]){"./tools/bound", "45", "sh", "-c", cmd, 0}, out, sizeof out) == 1 && has(out, "helper-exec-probe-failed"));
                ck(c_ok == 1 && m_ok == 0, "ident-mut-exec-probe-killed-red-then-green");
            } else ck(0, "ident-mut-exec-probe-killed-red-then-green");

            if (prepare_alt_cr_tree(cwd, "persist",
                    "    if (cr_require_persist && cr_is_ephemeral_path(ih)) {\n",
                    "    if (0 && cr_is_ephemeral_path(ih)) {\n", mdir, sizeof mdir) == 0) {
                cx_fmt(cmd, sizeof cmd, "UNISACC_IDENT_HELPER='%s' sh ./unisacc.com tools/chain-ready.cx -- --only 20-ident-helper --repo '%s' --strict-helper --require-persistent-helper", ih_real, irepo);
                int c_ok = (run((char *[]){"./tools/bound", "30", "sh", "-c", cmd, 0}, out, sizeof out) == 1 && has(out, "helper-ephemeral-path"));
                cx_fmt(cmd, sizeof cmd, "cd '%s' && UNISACC_IDENT_HELPER='%s' sh ./unisacc.com tools/chain-ready.cx -- --only 20-ident-helper --repo '%s' --strict-helper --require-persistent-helper", mdir, ih_real, irepo);
                int m_ok = (run((char *[]){"./tools/bound", "45", "sh", "-c", cmd, 0}, out, sizeof out) == 1 && has(out, "helper-ephemeral-path"));
                ck(c_ok == 1 && m_ok == 0, "ident-mut-persist-killed-red-then-green");
            } else ck(0, "ident-mut-persist-killed-red-then-green");
        }
    }
    if (run_stage) {
        char srepo[400], rdir[400], rcpt[480], cmd[4096], sub[2048], cwd[400];
        char v_run_id[160], v_rev[160], v_stage[160], v_verdict[160], v_elapsed[160], v_roster[160], v_ts[160], exp_roster[65];
        static const char *const exp_names[9] = {
            "derive-a", "derive-b", "ratchets", "tri-chain-a", "tri-chain-b", "tri-chain-c", "env-root", "gen-preflight", "union-shards"
        };
        static const char *const exp_gates[9] = {
            "1-rev,1-branch,2a-derive,2a-derive2,2a-derive3,2a-derive4",
            "2a-derive5,2a-derive6,2a-derive7",
            "2b-ratchets",
            "3a-cxmod-tri,3a-cxmod-tri-exports",
            "3b-cx0-extract,4-p1",
            "5-candidate-chain,5-candidate-chain2,5-candidate-chain3,5-candidate-chain4,5-candidate-chain5",
            "6-affected,7-recipe,8-inflight,9-ledger,10-envhygiene,11-version-slot,12-root-files,12p-preflight-entry,13-snap-cache,14-root-record",
            "15-gen-all,16-disk-free,17-root-public,18-parse2-gen,19-chain-preflight,19a-preflight-sixtarget,19b-preflight-snap,20-ident-helper,21-verseq-gen",
            "22-premerge-union,22-premerge-union2,22-premerge-union3,22-premerge-union4,22-premerge-union5,23-freeze-armed,24-root-current,25-tools-compile-shards"
        };
        {
            char rbuf[4096]; size_t rpos = 0;
            for (int si = 0; si < 9; si++) {
                size_t sn = tx_len(exp_names[si], 128), gn = tx_len(exp_gates[si], 512);
                mm_copy(rbuf + rpos, sizeof rbuf - rpos, exp_names[si], (long)sn); rpos += sn;
                rbuf[rpos++] = '\t';
                mm_copy(rbuf + rpos, sizeof rbuf - rpos, exp_gates[si], (long)gn); rpos += gn;
                rbuf[rpos++] = '\n';
            }
            sy_sha256_hex(rbuf, (long)rpos, exp_roster);
        }
        if (sy_cwd(cwd, sizeof cwd) != 0) cwd[0] = 0;
        cx_fmt(srepo, sizeof srepo, "%s/srepo", tmpd);
        cx_fmt(rdir, sizeof rdir, "%s/stage-rcpts", tmpd);
        (void)sy_mkdir(rdir, 0700);
        cx_fmt(cmd, sizeof cmd,
            "mkdir -p '%s/tools' '%s/build' && "
            "printf '#define NRK 3\\n' > '%s/tools/ratchets.cx' && "
            "printf '#!/bin/sh\\nshift\\nexec \"$@\"\\n' > '%s/tools/bound' && chmod +x '%s/tools/bound' && "
            "cat > '%s/unisacc.com' << 'EOFS'\n"
            "#!/bin/sh\n"
            "tool=\"$1\"; shift; [ \"$1\" = \"--\" ] && shift\n"
            "case \"$tool\" in\n"
            "  tools/ratchets.cx)\n"
            "    if [ \"${STAGE_FAIL_RATCHETS:-0}\" = \"1\" ]; then\n"
            "      printf 'RATCHET\\tcxraw\\tFAIL\\tx\\nRATCHETS\\tok=2\\tfail=1\\telapsed_ms=4\\n'; exit 1\n"
            "    fi\n"
            "    printf 'RATCHET\\tcxraw\\tok\\tx\\nRATCHETS\\tok=3\\tfail=0\\telapsed_ms=4\\n'; exit 0;;\n"
            "  tools/derive.cx)\n"
            "    only=\"\"\n"
            "    while [ $# -gt 0 ]; do\n"
            "      if [ \"$1\" = \"--only\" ]; then shift; only=\"$1\"; fi\n"
            "      shift\n"
            "    done\n"
            "    printf 'DERIVE_CALL\\t%%s\\n' \"$only\" >> '%s/derive.calls'\n"
            "    printf 'DERIVE\\t%%s\\tOK\\t2\\nDERIVE_SUMMARY\\tok=1\\tdrift=0\\trefused=0\\tskipped=0\\telapsed_ms=2\\n' \"$only\"; exit 0;;\n"
            "esac\n"
            "exit 0\n"
            "EOFS\n"
            "chmod +x '%s/unisacc.com' && "
            "git -C '%s' init -q -b main && "
            "git -C '%s' -c user.name=t -c user.email=t@t -c commit.gpgsign=false add -A && "
            "git -C '%s' -c user.name=t -c user.email=t@t -c commit.gpgsign=false commit -qm init",
            srepo, srepo, srepo, srepo, srepo, srepo, srepo, srepo, srepo, srepo, srepo);
        { char *sv[] = {"./tools/bound", "30", "sh", "-c", cmd, 0}; rc = run(sv, out, sizeof out); ck(rc == 0, "stage-fixture-setup"); }

        /* 1. --stage-list outputs the 9 roster-derived stages in order */
        {
            char *av[] = {"./tools/bound", "40", "sh", UC, "tools/chain-ready.cx", "--", "--stage-list", 0};
            rc = run(av, out, sizeof out);
            ck(rc == 0 && tx_eqz(out, "derive-a\nderive-b\nratchets\ntri-chain-a\ntri-chain-b\ntri-chain-c\nenv-root\ngen-preflight\nunion-shards\n"),
               "stage-list-prints-9-stages");
        }
        /* 2. Unknown stage name is refused with rc=2 */
        {
            char *av[] = {"./tools/bound", "40", "sh", UC, "tools/chain-ready.cx", "--", "--stage", "bogus-stage", 0};
            rc = run(av, out, sizeof out);
            ck(rc == 2 && has(out, "REFUSE\tCHAIN_READY_STAGE\treason=unknown-stage\tstage=bogus-stage"),
               "stage-unknown-refused-rc2");
        }
        /* 3. --stage combined with --only is refused with rc=2 */
        {
            char *av[] = {"./tools/bound", "40", "sh", UC, "tools/chain-ready.cx", "--", "--stage", "ratchets", "--only", "2b-ratchets", 0};
            rc = run(av, out, sizeof out);
            ck(rc == 2 && has(out, "REFUSE\tCHAIN_READY_STAGE\treason=incompatible-mode"),
               "stage-plus-only-refused-rc2");
        }
        /* 4. --stage ratchets --rev <40hex> --run-id rid-rat-1 --receipt-dir DIR writes valid v2 receipt */
        {
            const char *rev40 = "0123456789abcdef0123456789abcdef01234567";
            cx_fmt(cmd, sizeof cmd,
                "cd '%s' && DEVSVC_OWNER=cc sh '%s/unisacc.com' '%s/tools/chain-ready.cx' -- "
                "--repo '%s' --stage ratchets --rev '%s' --run-id rid-rat-1 --receipt-dir '%s'",
                srepo, cwd, cwd, srepo, rev40, rdir);
            char *av[] = {"./tools/bound", "40", "sh", "-c", cmd, 0};
            rc = run(av, out, sizeof out);
            cx_fmt(rcpt, sizeof rcpt, "%s/ratchets.rcpt", rdir);
            int g_ok = (cr_rcpt_get(rcpt, "run_id", v_run_id, sizeof v_run_id) == 0 &&
                        cr_rcpt_get(rcpt, "rev", v_rev, sizeof v_rev) == 0 &&
                        cr_rcpt_get(rcpt, "stage", v_stage, sizeof v_stage) == 0 &&
                        cr_rcpt_get(rcpt, "verdict", v_verdict, sizeof v_verdict) == 0 &&
                        cr_rcpt_get(rcpt, "elapsed_ms", v_elapsed, sizeof v_elapsed) == 0 &&
                        cr_rcpt_get(rcpt, "roster_sha", v_roster, sizeof v_roster) == 0 &&
                        cr_rcpt_get(rcpt, "ts_epoch_s", v_ts, sizeof v_ts) == 0);
            int f_ok = (rc_fresh(rcpt, "rid-rat-1") == 0);
            ck(rc == 0 && has(out, "2b-ratchets\tPASS") && has(out, "READY\tyes") &&
               g_ok && f_ok &&
               tx_eqz(v_run_id, "rid-rat-1") && tx_eqz(v_rev, rev40) &&
               tx_eqz(v_stage, "ratchets") && tx_eqz(v_verdict, "READY") &&
               tx_eqz(v_roster, exp_roster),
               "stage-ratchets-writes-valid-v2-receipt-ready");
        }
        /* 5. Failing stage writes verdict=FAIL receipt and exits 1 */
        {
            const char *rev40 = "0123456789abcdef0123456789abcdef01234567";
            cx_fmt(cmd, sizeof cmd,
                "cd '%s' && STAGE_FAIL_RATCHETS=1 DEVSVC_OWNER=cc sh '%s/unisacc.com' '%s/tools/chain-ready.cx' -- "
                "--repo '%s' --stage ratchets --rev '%s' --run-id rid-rat-fail --receipt-dir '%s'",
                srepo, cwd, cwd, srepo, rev40, rdir);
            char *av[] = {"./tools/bound", "40", "sh", "-c", cmd, 0};
            rc = run(av, out, sizeof out);
            cx_fmt(rcpt, sizeof rcpt, "%s/ratchets.rcpt", rdir);
            int g_ok = (cr_rcpt_get(rcpt, "verdict", v_verdict, sizeof v_verdict) == 0 &&
                        cr_rcpt_get(rcpt, "run_id", v_run_id, sizeof v_run_id) == 0);
            int f_ok = (rc_fresh(rcpt, "rid-rat-fail") == 0);
            ck(rc == 1 && has(out, "2b-ratchets\tFAIL") && has(out, "READY\tno") &&
               g_ok && f_ok && tx_eqz(v_verdict, "FAIL"),
               "stage-ratchets-fail-writes-fail-receipt-rc1");
        }
        /* 6. --stage derive-b runs only shards 5..7 (does not run shards 1..4) and writes derive-b.rcpt */
        {
            char dcalls[480]; size_t dcn = 0; char *dcb = 0;
            cx_fmt(dcalls, sizeof dcalls, "%s/derive.calls", srepo);
            (void)sy_unlink(dcalls);
            cx_fmt(cmd, sizeof cmd,
                "cd '%s' && DEVSVC_OWNER=cc sh '%s/unisacc.com' '%s/tools/chain-ready.cx' -- "
                "--repo '%s' --stage derive-b --run-id rid-der-b --receipt-dir '%s'",
                srepo, cwd, cwd, srepo, rdir);
            char *av[] = {"./tools/bound", "40", "sh", "-c", cmd, 0};
            rc = run(av, out, sizeof out);
            cx_fmt(rcpt, sizeof rcpt, "%s/derive-b.rcpt", rdir);
            dcb = cx_read(dcalls, &dcn);
            int only_567 = (dcb && has(dcb, "DERIVE_CALL\tproduct-map\n") &&
                            has(dcb, "DERIVE_CALL\tdoc-links,tool-index\n") &&
                            has(dcb, "DERIVE_CALL\ttable-index\n") &&
                            !has(dcb, "tables-gen") && !has(dcb, "chain-phases"));
            if (dcb) mm_free(dcb);
            ck(rc == 0 && only_567 && rc_fresh(rcpt, "rid-der-b") == 0 &&
               cr_rcpt_get(rcpt, "stage", v_stage, sizeof v_stage) == 0 && tx_eqz(v_stage, "derive-b") &&
               cr_rcpt_get(rcpt, "verdict", v_verdict, sizeof v_verdict) == 0 && tx_eqz(v_verdict, "READY") &&
               cr_rcpt_get(rcpt, "rev", v_rev, sizeof v_rev) == 0 && tx_len(v_rev, sizeof v_rev) == 40,
               "stage-derive-b-runs-only-shards-5-6-7-and-resolves-head-rev");
        }
        /* 7. Two execution mutations KILLED (red-then-green) */
        {
            char mdir[1200];
            const char *rev40 = "0123456789abcdef0123456789abcdef01234567";
            if (prepare_alt_cr_tree(cwd, "stage-mut1",
                    "const char *verdict = nfail ? \"FAIL\" : \"READY\";",
                    "const char *verdict = \"READY\";", mdir, sizeof mdir) == 0) {
                cx_fmt(cmd, sizeof cmd,
                    "cd '%s' && STAGE_FAIL_RATCHETS=1 DEVSVC_OWNER=cc sh '%s/unisacc.com' '%s/tools/chain-ready.cx' -- "
                    "--repo '%s' --stage ratchets --rev '%s' --run-id rid-mut1 --receipt-dir '%s'",
                    srepo, mdir, mdir, srepo, rev40, rdir);
                (void)run((char *[]){"./tools/bound", "45", "sh", "-c", cmd, 0}, out, sizeof out);
                cx_fmt(rcpt, sizeof rcpt, "%s/ratchets.rcpt", rdir);
                int m1_ok = (cr_rcpt_get(rcpt, "verdict", v_verdict, sizeof v_verdict) == 0 && tx_eqz(v_verdict, "FAIL"));
                ck(m1_ok == 0, "stage-mut1-verdict-always-ready-killed");
            } else ck(0, "stage-mut1-verdict-always-ready-killed");

            if (prepare_alt_cr_tree(cwd, "stage-mut2",
                    "return sy_sha256_hex(roster_buf, (long)rpos, out_sha);",
                    "return sy_sha256_hex(roster_buf, (long)rpos - 1, out_sha);", mdir, sizeof mdir) == 0) {
                cx_fmt(cmd, sizeof cmd,
                    "cd '%s' && DEVSVC_OWNER=cc sh '%s/unisacc.com' '%s/tools/chain-ready.cx' -- "
                    "--repo '%s' --stage ratchets --rev '%s' --run-id rid-mut2 --receipt-dir '%s'",
                    srepo, mdir, mdir, srepo, rev40, rdir);
                (void)run((char *[]){"./tools/bound", "45", "sh", "-c", cmd, 0}, out, sizeof out);
                cx_fmt(rcpt, sizeof rcpt, "%s/ratchets.rcpt", rdir);
                int m2_ok = (cr_rcpt_get(rcpt, "roster_sha", v_roster, sizeof v_roster) == 0 && tx_eqz(v_roster, exp_roster));
                ck(m2_ok == 0, "stage-mut2-corrupt-roster-sha-killed");
            } else ck(0, "stage-mut2-corrupt-roster-sha-killed");
        }
    }
    printf("SHARD_RESULT\tpart=%s\tpassed=%d\tfailed=%d\trc=%d\n", part_name, passed, failed, failed ? 1 : 0);
    printf("CHAIN_READY_CHECK\tpassed=%d\tfailed=%d\n", passed, failed);
    return failed ? 1 : 0;
}
