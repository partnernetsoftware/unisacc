    /* both measurements failing on the SAME path is a FAIL, not a pass and not an exemption.  A dangling
       symlink is the device: it exists (so the path is located and named in the evidence), while statvfs and
       `df -Pk` both fail on it.  It has to come in through --chain-base: an UNISACC_CHAIN_BASE that is not
       canonical(tmp)/unisacc-session-chain-NAME is ignored by cr_override, so the gate would fall back to the
       home base and never reach this branch -- the fixture would have passed for the wrong reason. */
    {   char *v[] = {"./tools/bound", "40", "sh", "-c", "L=$(mktemp -u); ln -s /nonexistent/chain-ready-disk-fixture \"$L\"; "
                 "sh " UC " tools/chain-ready.cx -- --only 16-disk-free --repo . --chain-base \"$L\"; rc=$?; rm -f \"$L\"; exit $rc", 0};
        rc = run(v, out, sizeof out);
        ck(rc == 1 && has(out, "16-disk-free\tFAIL") && has(out, "DISK_UNMEASURED sy_disk_avail_mb and the bounded df -Pk both failed") && has(out, "READY\tno"),
           "disk-both-measurements-fail-is-fail");
    }
    /* The filesystem that matters is the chain base's, not the checkout's (S1 2026-11-24).  A 4 MiB tmpfs
       mounted in a user namespace is a real chain disk that is really too small, while the checkout stays on
       the roomy root: measuring the repo passes, measuring the chain base blocks.  Nothing here is a stub --
       sy_disk_avail_mb reads that mount. */
    {   char *v[64]; int n = 0;
        v[n++] = "./tools/bound"; v[n++] = "40"; v[n++] = "unshare"; v[n++] = "-Ur"; v[n++] = "-m"; v[n++] = "sh"; v[n++] = "-c";
        v[n++] = "D=$(mktemp -d); B=\"$D/unisacc-session-chain-tf1\"; mkdir -p \"$B\"; mount -t tmpfs -o size=4m tmpfs \"$B\" || exit 9; "
                 "sh " UC " tools/chain-ready.cx -- --only 16-disk-free --root . --repo . --chain-base \"$B\"; rc=$?; "
                 "umount \"$B\"; rm -rf \"$D\"; exit $rc";
        v[n] = 0;
        rc = run(v, out, sizeof out);
        ck(rc == 1 && has(out, "16-disk-free\tFAIL") && has(out, "DISK_BLOCKED avail_gb=0") && has(out, "READY\tno"),
           "disk-chain-base-small-blocks-while-checkout-is-roomy");
    }
    /* a chain base that resolves is what gets measured, and the row names it: `--repo` still points at the
       roomy checkout, so a row carrying ANY other path means the gate measured the wrong filesystem.  The
       override is resolved through cxlib.chainroot cr_base -- the one place that decides where a chain
       directory lands -- not by reading the variable, so / here is REJECTED as an override (cr_override takes
       only canonical(tmp)/unisacc-session-chain-NAME) and the home chain base is what gets measured.  A gate
       that honoured the raw value would pass on a roomy / while the chain filled the home disk: that is the
       fail-open this fixture catches. */
    {   char *v[] = {"./tools/bound", "40", "env", "UNISACC_CHAIN_BASE=/", "sh", UC, "tools/chain-ready.cx", "--", "--only", "16-disk-free", "--repo", repo, 0};
        rc = run(v, out, sizeof out);
        ck((rc == 0 || rc == 1) && has(out, ".cache/unisacc/chains") && !has(out, "disk=/\t") &&
           !has(out, "16-disk-free\tUNMEASURED"),
           "disk-stale-absolute-override-is-not-honoured-and-home-base-is-measured");
    }
    /* the override cr_override DOES accept is measured: the same directory the chain will use.  cr_override
       takes only canonical(tmpdir)/unisacc-session-chain-NAME, so the base must be a direct child of the temp
       directory -- putting it one level deeper (inside a mktemp -d) would be ignored and the home base would
       answer, which is exactly the fallback the fixture above pins from the other side. */
    {   char *v[] = {"./tools/bound", "40", "sh", "-c", "B=\"$(dirname \"$(mktemp -u)\")/unisacc-session-chain-cr1\"; mkdir -p \"$B\"; "
                 "UNISACC_CHAIN_BASE=\"$B\" sh " UC " tools/chain-ready.cx -- --only 16-disk-free --repo . ; rc=$?; rmdir \"$B\"; exit $rc", 0};
        rc = run(v, out, sizeof out);
        ck((rc == 0 || rc == 1) && has(out, "unisacc-session-chain-cr1") &&
           !has(out, "16-disk-free\tUNMEASURED"), "disk-accepted-override-is-what-gets-measured");
    }
    /* A one-character relative --repo ("./") must be resolved before cr_base judges it: cr_override only
       speaks about a canonical absolute checkout root, so a spelling left relative silently answers with the
       home base and the accepted override looks ignored.  The row names the base that was measured, so a gate
       that skipped the resolution points at .cache/unisacc/chains instead of the temp base here. */
    {   char *v[] = {"./tools/bound", "40", "sh", "-c", "B=\"$(dirname \"$(mktemp -u)\")/unisacc-session-chain-cr26\"; mkdir -p \"$B\"; "
                 "UNISACC_CHAIN_BASE=\"$B\" sh " UC " tools/chain-ready.cx -- --only 16-disk-free --repo ./ ; rc=$?; rmdir \"$B\"; exit $rc", 0};
        rc = run(v, out, sizeof out);
        ck((rc == 0 || rc == 1) && has(out, "disk=") && has(out, "unisacc-session-chain-cr26") &&
           !has(out, ".cache/unisacc/chains") && !has(out, "16-disk-free\tUNMEASURED"),
           "disk-dot-slash-repo-still-resolves-the-accepted-override");
    }
    /* --chain-base ABS is the escape for a caller whose directories are not cr_base() (bg-candidate -- --base):
