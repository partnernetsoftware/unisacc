/* tools/check-chain-ready.cx -- fixtures for tools/chain-ready.cx: the judges on crafted outputs, a fake git
 * repository (clean and dirty), a fake in-flight process, and --fast.  No full chain-ready run (that takes minutes).
 *   sh ./unisacc.com tools/check-chain-ready.cx
 * Ends with CHAIN_READY_CHECK passed=N failed=M; exit 0 only when failed=0. */
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use text.conv
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use sys.env
#pragma unisa use sys.sha
#pragma unisa use cxlib.receipt

#define UC "./unisacc.com" /* lint:allow R1 fixtures run tools/chain-ready.cx under the installed product */
static int passed, failed;
static char tmpd[300];
static int launch_from = 0, launch_count = -1;
static int l_in_range(int idx) {
    if (idx < launch_from) return 0;
    if (launch_count >= 0 && idx >= launch_from + launch_count) return 0;
    return 1;
}

static void ck(int ok, const char *name) {
    if (ok) { passed++; printf("PASS\t%s\n", name); } else { failed++; printf("FAIL\t%s\n", name); }
}
static int has(const char *h, const char *w) {
    long hn, wn, i;
    if (!h) return 0;
    hn = (long)tx_len(h, 1 << 20); wn = (long)tx_len(w, 4096);
    for (i = 0; i + wn <= hn; i++) if (!memcmp(h + i, w, (size_t)wn)) return 1;
    return 0;
}

static int cr_rcpt_get(const char *path, const char *key, char *out, long cap) {
    size_t n = 0; char *b; long at = 0, kl = (long)tx_len(key, 128);
    if (!out || cap <= 0) return -1;
    out[0] = 0;
    b = cx_read(path, &n);
    if (!b) return -1;
    while (at < (long)n) {
        long e = at;
        while (e < (long)n && b[e] != '\n') e++;
        long ln = e - at; const char *l = b + at;
        at = e + 1;
        if (ln > kl + 1 && !memcmp(l, key, (size_t)kl) && l[kl] == '\t') {
            long vl = ln - (kl + 1);
            if (vl > 0 && l[kl + 1 + vl - 1] == '\r') vl--;
            if (vl <= 0 || vl >= cap) { mm_free(b); return -1; }
            mm_copy(out, cap, l + kl + 1, vl);
            out[vl] = 0;
            mm_free(b);
            return 0;
        }
    }
    mm_free(b);
    return -1;
}

/* run ARGV (null-terminated) with stderr merged; out gets the text; returns the exit code or -1 */
static int run(char **argv, char *out, int cap) {
    int fd, pid, ex = 0, code = 0, sig = 0; long n = 0, r;
    out[0] = 0;
    long deadline_ms = 0; (void)deadline_ms;   /* the deadline lives in the ./tools/bound argv prefix */
    /* callers pass ./tools/bound SECONDS argv (bound-limited), or the 17.31 s sleep stand-in */
    pid = sy_spawn_pipe(argv, 0, 0, &fd, 0);
    if (pid <= 0) return -1;
    while (n < cap - 1 && (r = sy_read(fd, out + n, cap - 1 - n)) > 0) n += r;
    out[n] = 0; sy_close(fd);
    return sy_wait_status(pid, 0, &ex, &code, &sig) == pid && ex ? code : -1;
}
/* the judge on TEXT with exit code RC; optional --repo DIR so NRK is read from that tree */
static int judge_at(const char *repo, const char *kind, const char *text, const char *rc, char *out, int cap) {
    char f[400]; char *w[16]; int n = 0;
    static int seq; cx_fmt(f, sizeof f, "%s/j%d.txt", tmpd, ++seq);
    cx_write(f, text, tx_len(text, 1 << 20));
    w[n++] = "./tools/bound"; w[n++] = "40"; w[n++] = "sh"; w[n++] = UC; w[n++] = "tools/chain-ready.cx"; w[n++] = "--";
    if (repo && repo[0]) { w[n++] = "--repo"; w[n++] = (char *)repo; }
    w[n++] = "--judge"; w[n++] = (char *)kind; w[n++] = f; w[n++] = (char *)rc; w[n] = 0;
    return run(w, out, cap);
}
static int judge(const char *kind, const char *text, const char *rc, char *out, int cap) {
    return judge_at(0, kind, text, rc, out, cap);
}
static void jt(const char *name, const char *kind, const char *text, const char *rc, const char *want, const char *frag) {
    char out[2048]; int r = judge(kind, text, rc, out, sizeof out);
    ck(r == 0 && tx_prefix(out, 4, want, 4) && (!frag || has(out, frag)), name);
}
static void jt_repo(const char *name, const char *repo, const char *kind, const char *text, const char *rc, const char *want, const char *frag) {
    char out[2048]; int r = judge_at(repo, kind, text, rc, out, sizeof out);
    ck(r == 0 && tx_prefix(out, 4, want, 4) && (!frag || has(out, frag)), name);
}
static void git(const char *dir, const char *a, const char *b, const char *c) {
    char out[512]; char *v[16]; int n = 0;
    v[n++] = "./tools/bound"; v[n++] = "20"; v[n++] = "git"; v[n++] = "-c"; v[n++] = "user.name=t"; v[n++] = "-c"; v[n++] = "user.email=t@t";
    v[n++] = "-C"; v[n++] = (char *)dir; v[n++] = (char *)a; if (b) v[n++] = (char *)b; if (c) v[n++] = (char *)c; v[n] = 0;
    run(v, out, sizeof out);
}

/* Parse active line-start #define NRK <N> from ratchets source without scanning source via tx_find. */
static int cr_read_nrk(const char *path) {
    size_t sz = 0;
    char *buf = cx_read(path, &sz);
    long pos = 0;
    int blk_cmt = 0;
    int val = -1;
    if (!buf) return -1;
    while (pos < (long)sz) {
        long eol = pos;
        long cur = pos;
        while (eol < (long)sz && buf[eol] != '\n') eol++;
        while (cur < eol) {
            if (blk_cmt) {
                if (cur + 1 < eol && buf[cur] == '*' && buf[cur + 1] == '/') { blk_cmt = 0; cur += 2; }
                else cur++;
                continue;
            }
            if (cur + 1 < eol && buf[cur] == '/' && buf[cur + 1] == '*') { blk_cmt = 1; cur += 2; continue; }
            if (cur + 1 < eol && buf[cur] == '/' && buf[cur + 1] == '/') break;
            if (buf[cur] == ' ' || buf[cur] == '\t') { cur++; continue; }
            if (cur + 7 < eol && !memcmp(buf + cur, "#define", 7) && (buf[cur + 7] == ' ' || buf[cur + 7] == '\t')) {
                long q = cur + 7;
                while (q < eol && (buf[q] == ' ' || buf[q] == '\t')) q++;
                if (q + 3 < eol && !memcmp(buf + q, "NRK", 3) && (buf[q + 3] == ' ' || buf[q + 3] == '\t')) {
                    long d = q + 3, acc = 0;
                    while (d < eol && (buf[d] == ' ' || buf[d] == '\t')) d++;
                    if (d < eol && buf[d] >= '0' && buf[d] <= '9') {
                        while (d < eol && buf[d] >= '0' && buf[d] <= '9' && acc < 10000) {
                            acc = acc * 10 + (buf[d] - '0');
                            d++;
                        }
                        if (acc > 0 && (d == eol || buf[d] == ' ' || buf[d] == '\t' || buf[d] == '\r' || buf[d] == '/'))
                            val = (int)acc;
                    }
                }
            }
            break;
        }
        if (val > 0) break;
        pos = (eol < (long)sz) ? eol + 1 : eol;
    }
    mm_free(buf);
    return val;
}

static int merge_cr_shards(int nfiles, char **files) {
    int got_core = 0, got_launch = 0;
    long tot_pass = 0, tot_fail = 0;
    for (int f = 0; f < nfiles; f++) {
        size_t n = 0; char *b = cx_read(files[f], &n);
        if (!b) { printf("FAIL\tmerge-shard-unreadable\t%s\n", files[f]); return 1; }
        long at = 0;
        while (at < (long)n) {
            long e = at; while (e < (long)n && b[e] != '\n') e++;
            long ln = e - at; const char *l = b + at; at = e + 1;
            if (ln > 13 && tx_prefix(l, ln, "SHARD_RESULT\t", 13)) {
                char row[512]; long cl = ln < (long)sizeof row - 1 ? ln : (long)sizeof row - 1;
                mm_copy(row, sizeof row, l, cl); row[cl] = 0;
                const char *pp = strstr(row, "\tpassed=");
                const char *fp = strstr(row, "\tfailed=");
                const char *rp = strstr(row, "\trc=");
                int64_t sp = 0, sf = 1, sr = 1;
                if (pp) { long dl = 0; while (pp[8 + dl] >= '0' && pp[8 + dl] <= '9') dl++; if (dl > 0) tx_to_i64(pp + 8, dl, 10, &sp); }
                if (fp) { long dl = 0; while (fp[8 + dl] >= '0' && fp[8 + dl] <= '9') dl++; if (dl > 0) tx_to_i64(fp + 8, dl, 10, &sf); }
                if (rp) { long dl = 0; while (rp[4 + dl] >= '0' && rp[4 + dl] <= '9') dl++; if (dl > 0) tx_to_i64(rp + 4, dl, 10, &sr); }
                if (strstr(row, "\tpart=core\t") && sf == 0 && sr == 0) { got_core++; tot_pass += (long)sp; }
                else if (strstr(row, "\tpart=launch\t") && sf == 0 && sr == 0) { got_launch++; tot_pass += (long)sp; }
                else { tot_fail++; }
            }
        }
        mm_free(b);
    }
    if (got_core != 1 || got_launch != 1 || tot_fail > 0) {
        printf("CHAIN_READY_CHECK_MERGED\tcore=%d\tlaunch=%d\tpassed=%ld\tfailed=%ld\tstatus=FAIL\n",
               got_core, got_launch, tot_pass, tot_fail + (got_core != 1) + (got_launch != 1));
        return 1;
    }
    printf("CHAIN_READY_CHECK\tpassed=%ld\tfailed=0\n", tot_pass);
    return 0;
}

static long cr_span_find(const char *hay, long hn, const char *needle, long nn) {
    if (!hay || !needle || nn <= 0 || hn < nn) return -1;
    for (long i = 0; i <= hn - nn; i++) {
        long j = 0;
        while (j < nn && hay[i + j] == needle[j]) j++;
        if (j == nn) return i;
    }
    return -1;
}

static int prepare_alt_cr_tree(const char *cwd, const char *tag, const char *find_str, const char *sub_str, char *mdir_out, size_t mcap) {
    char p[1400], cmd[4800], out[1024];
    size_t sn = 0; char *src;
    if (cx_fmt(mdir_out, mcap, "%s/alt-cr-%s", tmpd, tag)) return -1;
    if (cx_fmt(cmd, sizeof cmd,
        "rm -rf '%s' && mkdir -p '%s/tools' && ln -sT '%s/cx' '%s/cx' && ln -s '%s/cxroot.tsv' '%s/cxroot.tsv' && "
        "ln -s '%s/unisacc.com' '%s/unisacc.com' && ln -sT '%s/tools/cxlib' '%s/tools/cxlib' && "
        "ln -s '%s/tools/bound' '%s/tools/bound' && ln -s '%s/tools/bound.c' '%s/tools/bound.c' && "
        "{ [ ! -e '%s/ext' ] || ln -sT '%s/ext' '%s/ext'; }",
        mdir_out, mdir_out, cwd, mdir_out, cwd, mdir_out, cwd, mdir_out, cwd, mdir_out, cwd, mdir_out, cwd, mdir_out, cwd, cwd, mdir_out)) return -1;
    char *sv[] = {"./tools/bound", "15", "sh", "-c", cmd, 0};
    if (run(sv, out, sizeof out) != 0) return -1;
    cx_fmt(p, sizeof p, "%s/tools/chain-ready.cx", cwd);
    src = cx_read(p, &sn);
    if (!src) return -1;
    long fl = tx_len(find_str, 4096), rl = tx_len(sub_str, 4096);
    long at = cr_span_find(src, (long)sn, find_str, fl);
    if (at < 0 || cr_span_find(src + at + fl, (long)sn - at - fl, find_str, fl) >= 0) { mm_free(src); return -1; }
    size_t mn = sn - (size_t)fl + (size_t)rl;
    char *mb = mm_alloc((long)mn + 1);
    if (!mb) { mm_free(src); return -1; }
    mm_copy(mb, (long)mn + 1, src, at);
    mm_copy(mb + at, (long)mn + 1 - at, sub_str, rl);
    mm_copy(mb + at + rl, (long)mn + 1 - at - rl, src + at + fl, (long)sn - at - fl);
    mm_free(src);
    cx_fmt(p, sizeof p, "%s/tools/chain-ready.cx", mdir_out);
    if (cx_write(p, mb, mn)) { mm_free(mb); return -1; }
    mm_free(mb);
    return 0;
}

static int run_cr_in(const char *tdir, const char *subcmd, char *out, int ocap) {
    char cmd[4800];
    if (cx_fmt(cmd, sizeof cmd, "cd '%s' && sh ./unisacc.com tools/chain-ready.cx -- %s", tdir, subcmd)) return -1;
    char *av[] = {"./tools/bound", "45", "sh", "-c", cmd, 0};
    return run(av, out, ocap);
}

int main(int argc, char **argv) {
    int run_core = 1, run_launch = 1, run_ident = 1, run_stage = 1; const char *part_name = "all";
    for (int a = 1; a < argc; a++) {
        if (tx_eqz(argv[a], "--part") && a + 1 < argc) {
            part_name = argv[++a];
            if (tx_eqz(part_name, "core")) { run_core = 1; run_launch = 0; run_ident = 0; run_stage = 0; }
            else if (tx_eqz(part_name, "launch")) { run_core = 0; run_launch = 1; run_ident = 0; run_stage = 0; }
            else if (tx_eqz(part_name, "ident")) { run_core = 0; run_launch = 0; run_ident = 1; run_stage = 0; }
            else if (tx_eqz(part_name, "stage")) { run_core = 0; run_launch = 0; run_ident = 0; run_stage = 1; }
            else { printf("FAIL\tbad-part\t%s\n", part_name); return 2; }
        } else if (tx_eqz(argv[a], "--merge-shards") && a + 1 < argc) {
            return merge_cr_shards(argc - (a + 1), argv + a + 1);
        } else if (tx_eqz(argv[a], "--case-range") && a + 2 < argc) {
            int64_t f64 = -1, c64 = -1;
            const char *fs = argv[a + 1], *cs = argv[a + 2];
            if (tx_to_i64(fs, (long)tx_len(fs, 16), 10, &f64) ||
                tx_to_i64(cs, (long)tx_len(cs, 16), 10, &c64) || f64 < 0 || c64 <= 0) {
                printf("FAIL\tbad-case-range\t%s %s\n", fs, cs); return 2;
            }
            launch_from = (int)f64; launch_count = (int)c64; run_ident = 0; a += 2;
        } else {
            printf("FAIL\tbad-arg\t%s\n", argv[a]); return 2;
        }
    }
    char repo[400], out[8192]; int rc;
    if (sy_mkdtemp(sy_tmpdir(), "chain-ready-check-", tmpd, sizeof tmpd) != 0) { puts("FAIL\ttmpdir"); return 1; }
    if (run_core) {
    /* judges */
    jt("rev-clean-pass", "rev", "", "0", "PASS", "no uncommitted");
    jt("rev-dirty-fail", "rev", " M cx/sys/sysnums.cx\n?? cx/sys/netnb.cx\n", "0", "FAIL", "2 uncommitted");
    jt("rev-git-error-fail", "rev", "", "128", "FAIL", "rc=128");
    jt("branch-main-pass", "branch", "main\n", "0", "PASS", "branch main");
    jt("branch-version-pass", "branch", "v0.0.87\n", "0", "PASS", "branch v0.0.87");
    jt("branch-first-minor-pass", "branch", "v0.1.0\n", "0", "PASS", "branch v0.1.0");
    jt("branch-minor-patch-pass", "branch", "v0.1.4\r\n", "0", "PASS", "branch v0.1.4");
    jt("branch-two-parts-fail", "branch", "v0.0\n", "0", "FAIL", "not main");
    jt("branch-leading-zero-fail", "branch", "v01.0.0\n", "0", "FAIL", "not main");
    jt("branch-four-parts-fail", "branch", "v0.1.0.1\n", "0", "FAIL", "not main");
    jt("branch-other-fail", "branch", "feature\n", "0", "FAIL", "not main");
    jt("derive-ok-pass", "derive", "DERIVE\ttables-gen\tOK\t5\nDERIVE_SUMMARY\tok=7\tdrift=0\trefused=0\tskipped=0\telapsed_ms=9\n", "0", "PASS", "drift=0");
    jt("derive-drift-fail", "derive", "DERIVE\ttool-index\tDRIFT\t6\trc=1\tx\nDERIVE_SUMMARY\tok=4\tdrift=2\trefused=0\tskipped=0\telapsed_ms=9\n", "1", "FAIL", "DRIFT");
    jt("derive-drift-names-generator", "derive", "DERIVE\ttool-index\tDRIFT\t6\trc=1\tx\nDERIVE_SUMMARY\tok=4\tdrift=2\trefused=0\tskipped=0\telapsed_ms=9\n", "1", "FAIL", "failed_generator=tool-index(DRIFT)");
    jt("derive-refused-fail", "derive", "DERIVE\tproduct-map\tREFUSED\t1\trc=2\tx\nDERIVE_SUMMARY\tok=4\tdrift=0\trefused=1\tskipped=0\telapsed_ms=9\n", "2", "FAIL", "REFUSED");
    jt("derive-timeout-row-names-generator", "derive", "DERIVE\tproduct-map\tTIMEOUT\t45000\trc=142\tx\nDERIVE_SUMMARY\tok=0\tdrift=0\trefused=1\tskipped=13\telapsed_ms=45001\n", "2", "FAIL", "failed_generator=product-map(TIMEOUT)");
    jt("derive-outer-timeout-shard-names-unfinished-generators", "derive:doc-links,tool-index,table-index", "DERIVE\tdoc-links\tOK\t11000\n", "142", "FAIL", "failed_generator=tool-index(TIMEOUT),table-index(TIMEOUT)");
    jt("derive-no-summary-fail", "derive", "garbage\n", "0", "FAIL", "no DERIVE_SUMMARY");
    /* 2b: ok must equal <repo>/tools/ratchets.cx line-start #define NRK (comments skipped). */
    {
        int nrk = cr_read_nrk("tools/ratchets.cx");
        ck(nrk > 0, "ratchets-nrk-fact-read");
        if (nrk > 0) {
            char r_ok[128], r_ok_frag[32], r_short[128], r_over[128], r_want_frag[32], r_slack[280], r_fail1[160];
            cx_fmt(r_ok, sizeof r_ok, "RATCHET\tcxraw\tok\tx\nRATCHETS\tok=%d\tfail=0\telapsed_ms=5\n", nrk);
            cx_fmt(r_ok_frag, sizeof r_ok_frag, "ok=%d", nrk);
            cx_fmt(r_short, sizeof r_short, "RATCHETS\tok=%d\tfail=0\telapsed_ms=5\n", nrk - 1);
            cx_fmt(r_over, sizeof r_over, "RATCHETS\tok=%d\tfail=0\telapsed_ms=5\n", nrk + 1);
            cx_fmt(r_want_frag, sizeof r_want_frag, "want_ok=%d", nrk);
            cx_fmt(r_slack, sizeof r_slack,
                   "RATCHET\tcxraw\tok\tcxraw: ok: 896 units, 677 calls (baseline 13491); 0 above baseline, 11 below (--write ratchets down)\nRATCHETS\tok=%d\tfail=0\telapsed_ms=5\n",
                   nrk);
            cx_fmt(r_fail1, sizeof r_fail1,
                   "RATCHET\tcheck-literal\tFAIL\tLITERAL\nRATCHETS\tok=%d\tfail=1\telapsed_ms=5\n",
                   nrk - 1);
            jt("ratchets-roster-pass", "ratchets", r_ok, "0", "PASS", r_ok_frag);
            jt("ratchets-short-fail", "ratchets", r_short, "0", "FAIL", r_want_frag);
            jt("ratchets-over-fail", "ratchets", r_over, "0", "FAIL", r_want_frag);
            jt("ratchets-slack-warn-pass", "ratchets", r_slack, "0", "PASS", "WARN ratchet-slack cxraw_below=11");
            jt("ratchets-fail1-fail", "ratchets", r_fail1, "1", "FAIL", "fail=1");
        }
    }
    {
        char nrkdir[420], toolsdir[440], rkpath[460];
        const char *body_miss = "/* no NRK define in this fixture */\nint x;\n";
        const char *body_cmt = "/* was: #define NRK 18 */\n#define NRK 19\n";
        cx_fmt(nrkdir, sizeof nrkdir, "%s/nrk-miss", tmpd);
        cx_fmt(toolsdir, sizeof toolsdir, "%s/tools", nrkdir);
        cx_fmt(rkpath, sizeof rkpath, "%s/ratchets.cx", toolsdir);
        (void)sy_mkdir(nrkdir, 0700); (void)sy_mkdir(toolsdir, 0700);
        cx_write(rkpath, body_miss, tx_len(body_miss, 256));
        jt_repo("ratchets-nrk-missing-fail", nrkdir, "ratchets",
                "RATCHETS\tok=19\tfail=0\telapsed_ms=5\n", "0", "FAIL", "nrk-missing");
        cx_fmt(nrkdir, sizeof nrkdir, "%s/nrk-cmt", tmpd);
        cx_fmt(toolsdir, sizeof toolsdir, "%s/tools", nrkdir);
        cx_fmt(rkpath, sizeof rkpath, "%s/ratchets.cx", toolsdir);
        (void)sy_mkdir(nrkdir, 0700); (void)sy_mkdir(toolsdir, 0700);
        cx_write(rkpath, body_cmt, tx_len(body_cmt, 256));
        jt_repo("ratchets-nrk-comment-trap-pass", nrkdir, "ratchets",
                "RATCHETS\tok=19\tfail=0\telapsed_ms=5\n", "0", "PASS", "roster=19");
        jt_repo("ratchets-nrk-comment-trap-short-fail", nrkdir, "ratchets",
                "RATCHETS\tok=18\tfail=0\telapsed_ms=5\n", "0", "FAIL", "want_ok=19");
    }
    jt("tri-pass", "tri", "GAP\tCXM_MAXU\tnamed\nCXMOD_TRI\tpassed=15\tfailed=0\tgaps=2\n", "0", "PASS", "failed=0");
    jt("tri-fail", "tri", "CXMOD_TRI\tpassed=14\tfailed=1\tgaps=2\n", "1", "FAIL", "failed=1");
    jt("extract-exact-pass", "extract", "CX0_EXTRACT\tEXACT\tbytes=1\n", "0", "PASS", "EXACT");
    jt("extract-drift-fail", "extract", "CX0_EXTRACT\tDRIFT\tbytes=1\n", "1", "FAIL", "DRIFT");
    jt("chain-fail-row", "chain", "PASS\ta\nFAIL\tcheck-candidate-chain.b\n", "1", "FAIL", "fail=1");
    jt("chain-pass", "chain", "PASS\ta\nPASS\tb\n", "0", "PASS", "pass=2");
    {
        char cs_ok[4096], cs_136[4096], cs_to[4096];
        static const char *sn[4] = {"core-a", "core-b", "objects", "watch"};
        static const int sc_ok[4] = {60, 54, 16, 7}, sc_136[4] = {60, 54, 16, 6}, sc_to[4] = {60, 54, 16, 0};
        static const int rc_ok[4] = {0, 0, 0, 0}, rc_to[4] = {0, 0, 0, 142};
        int m, s, c;
        for (m = 0; m < 3; m++) {
            char *buf = m == 0 ? cs_ok : m == 1 ? cs_136 : cs_to;
            const int *cnts = m == 0 ? sc_ok : m == 1 ? sc_136 : sc_to;
            const int *rcs = m == 2 ? rc_to : rc_ok;
            long pos = 0;
            buf[0] = 0;
            for (s = 0; s < 4; s++) {
                cx_fmt(buf + pos, 4096 - (size_t)pos, "SHARD\t%s\trc=%d\n", sn[s], rcs[s]);
                pos = (long)tx_len(buf, 4096);
                for (c = 0; c < cnts[s]; c++) {
                    cx_fmt(buf + pos, 4096 - (size_t)pos, "PASS\tcase\n");
                    pos = (long)tx_len(buf, 4096);
                }
            }
        }
