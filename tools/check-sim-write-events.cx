/* Independent tiny deltas: write association, never module ownership. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sysx.process
#pragma unisa use text.text
static int checks,bad;static char dir[4400],delta[4400],input[4400],side[4400],com[4400],sim[4400];
static void die(const char *s){fprintf(stderr,"check-sim-write-events %s\n",s);exit(2);}
static void ck(int yes,const char *s){checks++;printf("%s\t%s\n",yes?"PASS":"FAIL",s);if(!yes)bad++;}
static void path(char *p,const char *name){if(cx_fmt(p,4400,"%s/%s",dir,name))die("path");}
static int exists(const char *p){struct stat s;if(!lstat(p,&s))return 1;if(errno==ENOENT)return 0;die("stat");return 1;}
static char *run(int tracing,const char *limit,const char *bytes,int expected){char *v[20];int k=0;v[k++]="sh";v[k++]=com;v[k++]=sim;v[k++]="--";v[k++]=delta;v[k++]=input;if(tracing){v[k++]="--write-events";v[k++]=side;}if(limit){v[k++]="--event-limit";v[k++]=(char *)limit;}if(bytes){v[k++]="--event-bytes";v[k++]=(char *)bytes;}v[k]=0;np_result r={0};char why[512]={0};int e=np_run(v,0,0,10,&r,why,sizeof why);char *s=0;if(!e&&!r.residue&&r.rc==expected){s=malloc(r.outn+1);if(!s)die("alloc");memcpy(s,r.out,r.outn);s[r.outn]=0;}else{fprintf(stderr,"transport=%d rc=%d expected=%d why=%s\n%s\n",e,r.rc,expected,why,r.err?r.err:"");}np_free(&r);return s;}
static const char *pass="{\"start\":\"S\",\"states\":{\"S\":[\"b\",{\"65\":[\"S\",0]}]},\"seqs\":[[[\"COPY\"],[\"ADV\"],[\"LDI\",\"lo\",0],[\"SPAN\",\"lo\"],[\"LDI\",\"at\",1],[\"LDI\",\"v\",7],[\"OFILL\",\"at\",\"v\",1],[\"LDI\",\"cut\",1],[\"OCUT\",\"blob\",\"cut\"],[\"ODROP\"],[\"OUT\",88],[\"OCLR\"],[\"OUT\",66],[\"SWAP\"],[\"COPY\"],[\"ACCEPT\"]]]}";
int main(void){char root[4400],temp[]="/tmp/check-sim-write-events-XXXXXX",*off,*on,*t;size_t n;if(!realpath(".",root)||!mkdtemp(temp))die("temp/cwd");strcpy(dir,temp);if(cx_fmt(com,sizeof com,"%s/unisacc.com",root)||cx_fmt(sim,sizeof sim,"%s/tools/sim.cx",root))die("paths");path(delta,"delta.json");path(input,"input");path(side,"events.tsv");if(cx_write(delta,pass,strlen(pass))||cx_write(input,"A",1))die("fixture");off=run(0,0,0,0);on=run(1,"10",0,0);ck(off&&on&&!strcmp(off,"B")&&!strcmp(off,on),"off/on exact final bytes B");free(off);free(on);t=cx_read(side,&n);ck(t&&strstr(t,"COMPLETE\tevents=10\n"),"exact event budget boundary ten");ck(t&&strstr(t,"action=COPY\t")&&strstr(t,"action=SPAN\t")&&strstr(t,"source_lo=0\tsource_hi=1"),"COPY/SPAN explicit input range");ck(t&&strstr(t,"action=OFILL\tbuffer=output\tgeneration=0\tafter_generation=0\tbefore=2\tafter=2"),"same-length overwrite captured at nonzero output offset");char *fill=t?strstr(t,"action=OFILL\t"):0;char *dst=fill?strstr(fill,"dst_lo=1\tdst_hi=2"):0;ck(dst&&strchr(fill,'\n')&&dst<strchr(fill,'\n'),"OFILL actual nonzero destination interval on OFILL event");ck(t&&strstr(t,"action=OCUT\t")&&strstr(t,"action=ODROP\t")&&strstr(t,"action=OCLR\t"),"cut/drop/clear captured");ck(t&&strstr(t,"action=SWAP\tbuffer=output\tgeneration=0\tafter_generation=1\tbefore=1\tafter=0"),"SWAP changes generation");char h[65],needle[96];cx_sha256_hex("B",1,h);snprintf(needle,sizeof needle,"output_sha=%s",h);ck(t&&strstr(t,needle),"output SHA binds exact final bytes");cx_sha256_hex(pass,strlen(pass),h);snprintf(needle,sizeof needle,"delta_sha=%s",h);ck(t&&strstr(t,needle),"delta SHA binds fixture");cx_sha256_hex("A",1,h);snprintf(needle,sizeof needle,"input_sha=%s",h);ck(t&&strstr(t,needle)&&strstr(t,"module=UNKNOWN"),"input identity and unknown ownership explicit");free(t);unlink(side);
on=run(1,"9",0,2);ck(on&&!exists(side),"event budget overflow publishes no complete sidecar");free(on);on=run(1,0,"128",2);ck(on&&!exists(side),"file budget overflow publishes no complete sidecar");free(on);
const char *reject="{\"start\":\"S\",\"states\":{\"S\":[\"b\",{\"65\":[\"S\",0]}]},\"seqs\":[[[\"OUT\",88],[\"REJECT\",\"fixture\"]]]}";if(cx_write(delta,reject,strlen(reject)))die("reject fixture");on=run(1,0,0,1);ck(on&&!exists(side),"rejection publishes no complete sidecar");free(on);if(cx_write(side,"sentinel",8))die("sentinel");on=run(1,0,0,2);t=cx_read(side,&n);ck(on&&t&&n==8&&!memcmp(t,"sentinel",8),"existing target refuses and preserves bytes");free(on);free(t);unlink(delta);unlink(input);unlink(side);rmdir(dir);printf("SIM_WRITE_EVENTS_CHECK\tchecks=%d\tfailed=%d\n",checks,bad);return bad?1:0;}
