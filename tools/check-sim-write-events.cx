/* Independent tiny deltas: write association, never module ownership. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sysx.process
#pragma unisa use text.text
#pragma unisa use mem.bytes
static int checks,bad;static char dir[4400],delta[4400],input[4400],side[4400],com[4400],sim[4400];
static void die(const char *s){fprintf(stderr,"check-sim-write-events %s\n",s);exit(2);}
static void ck(int yes,const char *s){checks++;printf("%s\t%s\n",yes?"PASS":"FAIL",s);if(!yes)bad++;}
static void path(char *p,const char *name){if(cx_fmt(p,4400,"%s/%s",dir,name))die("path");}
static int exists(const char *p){struct stat s;if(!lstat(p,&s))return 1;if(errno==ENOENT)return 0;die("stat");return 1;}
static char *run(int tracing,const char *limit,const char *bytes,int expected){char *v[20];int k=0;v[k++]="sh";v[k++]=com;v[k++]=sim;v[k++]="--";v[k++]=delta;v[k++]=input;if(tracing){v[k++]="--write-events";v[k++]=side;}if(limit){v[k++]="--event-limit";v[k++]=(char *)limit;}if(bytes){v[k++]="--event-bytes";v[k++]=(char *)bytes;}v[k]=0;np_result r={0};char why[512]={0};int e=np_run(v,0,0,10,&r,why,sizeof why);char *s=0;if(!e&&!r.residue&&r.rc==expected){s=malloc(r.outn+1);if(!s)die("alloc");mm_copy(s, r.outn, r.out, r.outn);s[r.outn]=0;}else{fprintf(stderr,"transport=%d rc=%d expected=%d why=%s\n%s\n",e,r.rc,expected,why,r.err?r.err:"");}np_free(&r);return s;}
static const char *pass="{\"start\":\"S\",\"states\":{\"S\":[\"b\",{\"65\":[\"S\",0]}]},\"seqs\":[[[\"COPY\"],[\"ADV\"],[\"LDI\",\"lo\",0],[\"SPAN\",\"lo\"],[\"LDI\",\"at\",1],[\"LDI\",\"v\",7],[\"OFILL\",\"at\",\"v\",1],[\"LDI\",\"cut\",1],[\"OCUT\",\"blob\",\"cut\"],[\"ODROP\"],[\"OUT\",88],[\"OCLR\"],[\"OUT\",66],[\"SWAP\"],[\"COPY\"],[\"ACCEPT\"]]]}";
static const char *edges="{\"start\":\"S\",\"states\":{\"S\":[\"b\",{\"65\":[\"S\",0]}]},\"seqs\":[[[\"LDI\",\"lo\",1],[\"LDI\",\"hi\",2],[\"BLOBSAVE\",\"b\",\"lo\",\"hi\"],[\"INPUSH\",\"b\"],[\"COPY\"],[\"INPOP\"],[\"SBCLR\"],[\"SBOUT\",81],[\"SBSAVE\",\"s\"],[\"INPUSH\",\"s\"],[\"COPY\"],[\"INPOP\"],[\"LDI\",\"zero\",0],[\"OCUT\",\"all\",\"zero\"],[\"INPUSH\",\"all\"],[\"COPY\"],[\"ADV\"],[\"COPY\"],[\"INPOP\"],[\"SWAP\"],[\"COPY\"],[\"ADV\"],[\"COPY\"],[\"ACCEPT\"]]]}";
static const char *field(const char *line,const char *key){long n=strlen(key);if(!line)return 0;for(const char *p=line;*p&&*p!='\n';p++)if((p==line||p[-1]=='\t')&&!strncmp(p,key,n)&&p[n]=='=')return p+n+1;return 0;}
static long number(const char *line,const char *key){const char *p=field(line,key);char *e;if(!p)return -999;long v=strtol(p,&e,10);return (*e=='\t'||*e=='\n')?v:-999;}
static int word(const char *line,const char *key,const char *value){const char *p=field(line,key);long n=strlen(value);return p&&!strncmp(p,value,n)&&(p[n]=='\t'||p[n]=='\n');}
static const char *edge(const char *log,const char *op,long id){if(!log)return 0;for(const char *p=log;*p;){if(!strncmp(p,"EDGE\t",5)&&word(p,"action",op)&&number(p,"destination_id")==id)return p;const char *e=strchr(p,'\n');if(!e)break;p=e+1;}return 0;}
static void edgeprobe(void){
    char *off,*on,*t,h[65];size_t n;
    if(cx_write(delta,edges,strlen(edges))||cx_write(input,"AB",2))die("edge fixture");
    off=run(0,0,0,0);on=run(1,0,0,0);
    ck(off&&on&&!strcmp(off,"BQ")&&!strcmp(off,on),"independent blob/scratch/swap delta exact output BQ with tracing off/on");free(off);free(on);
    t=cx_read(side,&n);const char *b=edge(t,"BLOBSAVE",2),*s=edge(t,"SBSAVE",3),*c=edge(t,"OCUT",4),*f=edge(t,"INPUSH",4),*sw=edge(t,"SWAP",5);
    cx_sha256_hex("B",1,h);
    ck(word(b,"source_buffer","frame")&&number(b,"source_generation")==1&&number(b,"source_lo")==1&&number(b,"source_hi")==2&&word(b,"sha",h),"BLOBSAVE byte B hash and actual source subrange");
    cx_sha256_hex("Q",1,h);
    ck(word(s,"source_buffer","scratch")&&number(s,"source_generation")==1&&number(s,"source_lo")==0&&number(s,"source_hi")==1&&word(s,"sha",h),"SBSAVE scratch generation and Q hash");
    cx_sha256_hex("BQ",2,h);
    ck(word(c,"source_buffer","output")&&number(c,"source_generation")==0&&number(c,"source_lo")==0&&number(c,"source_hi")==2&&word(c,"sha",h),"OCUT captures exact BQ output range into blob 4");
    ck(word(f,"source_buffer","blob")&&number(f,"source_blob_id")==number(c,"destination_id")&&number(f,"source_generation")==0&&number(f,"source_hi")==2&&word(f,"sha",h),"INPUSH frame 4 joins created blob identity and bytes");
    ck(word(sw,"source_buffer","output")&&number(sw,"source_generation")==0&&number(sw,"source_hi")==2&&word(sw,"sha",h),"SWAP frame 5 joins old output generation and bytes");free(t);unlink(side);
}
static const char *memory="{\"start\":\"S\",\"states\":{\"S\":[\"b\",{\"65\":[\"S\",0]}]},\"seqs\":[[[\"LDI\",\"at\",76000000],[\"LDX\",\"v\",\"at\",5],[\"LDI\",\"v\",66],[\"STX\",\"at\",5,\"v\"],[\"LDI\",\"v\",81],[\"STX\",\"at\",5,\"v\"],[\"LDX\",\"v\",\"at\",5],[\"OUTW\",\"v\"],[\"LDI\",\"v\",0],[\"STX\",\"at\",5,\"v\"],[\"LDX\",\"v\",\"at\",5],[\"ACCEPT\"]]]}";
static const char *memoryline(const char *log,const char *op,long version){if(!log)return 0;for(const char *p=log;*p;){if(!strncmp(p,"MEMORY\t",7)&&word(p,"action",op)&&number(p,"version")==version)return p;const char *e=strchr(p,'\n');if(!e)break;p=e+1;}return 0;}
static void memoryprobe(void){
 if(cx_write(delta,memory,strlen(memory))||cx_write(input,"A",1))die("memory fixture");
 char *off=run(0,0,0,0),*on=run(1,0,0,0);ck(off&&on&&!strcmp(off,"Q")&&!strcmp(off,on),"memory overwrite off/on actual final output Q");free(off);free(on);size_t n;char *t=cx_read(side,&n);
 const char *initial=memoryline(t,"LDX",0),*first=memoryline(t,"STX",1),*second=memoryline(t,"STX",2),*read=memoryline(t,"LDX",2),*zero=memoryline(t,"STX",3),*readzero=memoryline(t,"LDX",3);
 ck(number(initial,"address")==76000005&&number(initial,"value")==0,"unwritten attribute read has version zero");
 ck(number(first,"value")==66&&number(first,"previous_version")==0&&number(second,"value")==81&&number(second,"previous_version")==1,"same address stores preserve sequential write versions");
 ck(number(read,"address")==76000005&&number(read,"value")==81,"LDX joins last STX version rather than first store");
 ck(number(zero,"value")==0&&number(zero,"previous_version")==2&&number(readzero,"address")==76000005&&number(readzero,"value")==0,"zero overwrite owns new version and subsequent read");free(t);unlink(side);
}
static const char *internprobe_delta="{\"start\":\"S\",\"states\":{\"S\":[\"b\",{\"114\":[\"S\",0]}]},\"seqs\":[[[\"LDI\",\"lo\",0],[\"LDI\",\"hi\",3],[\"INTERN\",\"first\",\"lo\",\"hi\"],[\"LDI\",\"lo\",4],[\"LDI\",\"hi\",7],[\"INTERN\",\"second\",\"lo\",\"hi\"],[\"SBCLR\"],[\"SBOUT\",114],[\"SBOUT\",101],[\"SBOUT\",116],[\"SBINTERN\",\"scratch\"],[\"OUTW\",\"first\"],[\"OUTW\",\"second\"],[\"OUTW\",\"scratch\"],[\"ACCEPT\"]]]}";
static const char *nextedge(const char *p,const char *op){if(!p)return 0;const char *e=strchr(p,'\n');return e?edge(e+1,op,1):0;}
static void internprobe(void){
 if(cx_write(delta,internprobe_delta,strlen(internprobe_delta))||cx_write(input,"ret\nret\n",8))die("intern fixture");
 char *off=run(0,0,0,0),*on=run(1,0,0,0);ck(off&&on&&!strcmp(off,"\1\1\1")&&!strcmp(off,on),"equal token intern identity reused with tracing off/on");free(off);free(on);size_t n;char *t=cx_read(side,&n),h[65];cx_sha256_hex("ret",3,h);
 const char *a=edge(t,"INTERN",1),*b=nextedge(a,"INTERN"),*c=edge(t,"SBINTERN",1);
 ck(word(a,"source_buffer","frame")&&number(a,"source_lo")==0&&number(a,"source_hi")==3&&word(a,"sha",h),"first INTERN binds exact first token subrange and SHA");
 ck(word(b,"source_buffer","frame")&&number(b,"source_lo")==4&&number(b,"source_hi")==7&&word(b,"sha",h),"equal token keeps distinct second source range");
 ck(word(c,"source_buffer","scratch")&&number(c,"source_generation")==1&&number(c,"source_lo")==0&&number(c,"source_hi")==3&&word(c,"sha",h),"SBINTERN binds scratch generation to same identity");free(t);unlink(side);
}
int main(void){char root[4400],temp[]="/tmp/check-sim-write-events-XXXXXX",*off,*on,*t;size_t n;if(!realpath(".",root)||!mkdtemp(temp))die("temp/cwd");(cx_fmt(dir, sizeof dir, "%s", temp) ? exit(2) : (void)0);if(cx_fmt(com,sizeof com,"%s/unisacc.com",root)||cx_fmt(sim,sizeof sim,"%s/tools/sim.cx",root))die("paths");path(delta,"delta.json");path(input,"input");path(side,"events.tsv");if(cx_write(delta,pass,strlen(pass))||cx_write(input,"A",1))die("fixture");off=run(0,0,0,0);on=run(1,"12",0,0);ck(off&&on&&!strcmp(off,"B")&&!strcmp(off,on),"off/on exact final bytes B");free(off);free(on);t=cx_read(side,&n);ck(t&&strstr(t,"COMPLETE\tevents=12\n"),"exact event budget boundary twelve including edges");ck(t&&strstr(t,"action=COPY\t")&&strstr(t,"action=SPAN\t")&&strstr(t,"source_lo=0\tsource_hi=1"),"COPY/SPAN explicit input range");ck(t&&strstr(t,"action=OFILL\tbuffer=output\tgeneration=0\tafter_generation=0\tbefore=2\tafter=2"),"same-length overwrite captured at nonzero output offset");char *fill=t?strstr(t,"action=OFILL\t"):0;char *dst=fill?strstr(fill,"dst_lo=1\tdst_hi=2"):0;ck(dst&&strchr(fill,'\n')&&dst<strchr(fill,'\n'),"OFILL actual nonzero destination interval on OFILL event");ck(t&&strstr(t,"action=OCUT\t")&&strstr(t,"action=ODROP\t")&&strstr(t,"action=OCLR\t"),"cut/drop/clear captured");ck(t&&strstr(t,"action=SWAP\tbuffer=output\tgeneration=0\tafter_generation=1\tbefore=1\tafter=0"),"SWAP changes generation");char h[65],needle[96];cx_sha256_hex("B",1,h);(cx_fmt(needle, sizeof needle, "output_sha=%s", h) ? exit(2) : (void)0);ck(t&&strstr(t,needle),"output SHA binds exact final bytes");cx_sha256_hex(pass,strlen(pass),h);(cx_fmt(needle, sizeof needle, "delta_sha=%s", h) ? exit(2) : (void)0);ck(t&&strstr(t,needle),"delta SHA binds fixture");cx_sha256_hex("A",1,h);(cx_fmt(needle, sizeof needle, "input_sha=%s", h) ? exit(2) : (void)0);ck(t&&strstr(t,needle)&&strstr(t,"module=UNKNOWN"),"input identity and unknown ownership explicit");free(t);unlink(side);
on=run(1,"11",0,2);ck(on&&!exists(side),"event budget overflow publishes no complete sidecar");free(on);on=run(1,0,"128",2);ck(on&&!exists(side),"file budget overflow publishes no complete sidecar");free(on);edgeprobe();memoryprobe();internprobe();if(cx_write(input,"A",1))die("restore reject input");
const char *reject="{\"start\":\"S\",\"states\":{\"S\":[\"b\",{\"65\":[\"S\",0]}]},\"seqs\":[[[\"OUT\",88],[\"REJECT\",\"fixture\"]]]}";if(cx_write(delta,reject,strlen(reject)))die("reject fixture");on=run(1,0,0,1);ck(on&&!exists(side),"rejection publishes no complete sidecar");free(on);if(cx_write(side,"sentinel",8))die("sentinel");on=run(1,0,0,2);t=cx_read(side,&n);ck(on&&t&&n==8&&!memcmp(t,"sentinel",8),"existing target refuses and preserves bytes");free(on);free(t);unlink(delta);unlink(input);unlink(side);rmdir(dir);printf("SIM_WRITE_EVENTS_CHECK\tchecks=%d\tfailed=%d\n",checks,bad);return bad?1:0;}
