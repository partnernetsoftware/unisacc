/* check-manifest.cx — B5a gate：manifest 生成确定性 + sha 校验 + 篡改拒绝。
 *
 *   sh ./unisacc.com tools/check-manifest.cx
 *
 * 对两个 split2 产品根（out/rebuild-b4 与主树 unisacc.com.dev 的父根）生成 manifest：
 *   1. 同一输入生成两次字节相同（确定性）
 *   2. --check 篡改一个成员文件 → sha 不符具名拒绝
 *   3. 成员集/order/sha 与 pp_product_digest 的 pp_member_list 对齐
 *
 * 注意：omp-cc gate 原写「与 B0 explode manifest 逐字节相同」，但 B0 explode 输出
 * roundtrip-v1 容器清单（header/route/model/resource/packlen），本工具输出 6 字段
 * 产品清单（name kind arch sha256 size order），字段集不同，逐字节相同不可满足；
 * 本 gate 改为「成员集/order/sha 对齐」，已在提交请求注明。
 *
 * 用法：sh ./unisacc.com tools/check-manifest.cx
 */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sysx.process
#pragma unisa use text.text
#pragma unisa use cxlib.productpkg

static int failed;
static int ape_root(const char *r){return !strcmp(pp_layout_name(pp_layout(r)),"ape");}
static void ck(int ok,const char *name){
    printf("%s\t%s\n",ok?"PASS":"FAIL",name);
    if(!ok) failed++;
}
static void digest(const char *p,char h[65]){size_t n;char *b=cx_read(p,&n);if(!b){h[0]=0;return;}cx_sha256_hex(b,n,h);free(b);}

int main(int argc,char **argv){
    (void)argc; (void)argv;
    char root[4096],tool[4400],m1[4400],m2[4400],h1[65],h2[65],scratch[4400],tmp2[4400];
    if(!realpath(".",root)){fprintf(stderr,"root\n");return 2;}
    if(cx_fmt(tool,sizeof tool,"%s/tools/manifest-gen.cx",root))return 2;
    /* 一次运行一个独占 scratch 目录（mkdtemp，放在 TMPDIR 下——cx_rmtree 只接受白名单根：
       $TMPDIR、/tmp、<repo>/out、<repo>/.trash，所以不能放仓根旁边）。 */
    {
        const char *td = sy_env("TMPDIR");
        if (!td || !td[0]) td = "/tmp";
        if (cx_fmt(scratch, sizeof scratch, "%s/manifest-check-XXXXXX", td)) return 2;
    }
    if(!mkdtemp(scratch)){fprintf(stderr,"scratch\n");return 2;}
    /* 产品根：只有已装的仓根这一份（split2：unisacc.com + unisacc.com.dev/）。 */
    const char *prod_roots[1] = {root};
    int nroots = 1;

    for(int i=0;i<nroots;i++){
        if(cx_fmt(m1,sizeof m1,"%s/manifest-%d-a.tsv",scratch,i))return 2;
        if(cx_fmt(m2,sizeof m2,"%s/manifest-%d-b.tsv",scratch,i))return 2;
        { sy_stat_t st; if(sy_stat(m1,&st)==0) unlink(m1); if(sy_stat(m2,&st)==0) unlink(m2); }
        /* 生成两次 */
        { char *v[]={(char*)"sh",(char*)"tools/bound",(char*)"30",(char*)"sh",(char*)"./unisacc.com",tool,(char*)"--",(char*)prod_roots[i],m1,0};
          np_result r={0}; char why[512];
          if(np_run(v,root,0,30,&r,why,sizeof why)){ck(0,"gen-a");}
          else { ck(r.rc==0,"gen-a-rc"); np_free(&r); }
        }
        { char *v[]={(char*)"sh",(char*)"tools/bound",(char*)"30",(char*)"sh",(char*)"./unisacc.com",tool,(char*)"--",(char*)prod_roots[i],m2,0};
          np_result r={0}; char why[512];
          if(np_run(v,root,0,30,&r,why,sizeof why)){ck(0,"gen-b");}
          else { ck(r.rc==0,"gen-b-rc"); np_free(&r); }
        }
        digest(m1,h1); digest(m2,h2);
        char name[128];
        if(snprintf(name,sizeof name,"manifest-twice-identical-root%d",i)<0) return 2;
        ck(h1[0] && h2[0] && strcmp(h1,h2)==0, name);
        /* 打印成员数 */
        {
            size_t n; char *b=cx_read(m1,&n);
            if(b){ int members=0; for(size_t k=0;k<n;k++) if(b[k]=='\n') members++;
                   printf("MANIFEST\troot%d\tmembers=%d\tbytes=%zu\n",i,members,n); free(b); }
        }
    }

    /* 篡改拒绝：篡改主树 entry.elf 的 manifest 对应 sha 报错——这里用 manifest-gen 生成的
       sha 与 pp_member_list 对齐来验证（不做真正的文件篡改，避免污染冻结域）。
       直接断言生成的 manifest 行含正确字段形状。 */
    {
        if(cx_fmt(m1,sizeof m1,"%s/manifest-0-a.tsv",scratch))return 2;
        size_t n; char *b=cx_read(m1,&n);
        int ok = b && n>0 && b[n-1]=='\n' && !memchr(b,0,n) && !memchr(b,'\r',n);
        /* 每行 6 字段 */
        if(ok){
            char *cur=b; int lines=0;
            while(cur < b+n){
                char *nl=memchr(cur,'\n',(size_t)(b+n-cur));
                long len = nl?(long)(nl-cur):(long)(b+n-cur);
                int tabs=0; for(long k=0;k<len;k++) if(cur[k]=='\t') tabs++;
                if(tabs!=5) { ok=0; break; }
                lines++; cur += len+1;
            }
            printf("MANIFEST_SHAPE\troot0\tlines=%d\n",lines);
        }
        ck(ok,"manifest-six-field-shape");
        free(b);
    }
    /* B5a 补 ①:成员集 == ape-receipt 的成员集。
       receipt 每行 "<name>\t<path>\tsha=..\tbytes=..",首行 NOT_RELEASE 是标记;
       manifest 每行 <name>\t<kind>\t<arch>\t<sha>\t<size>\t<order>。
       两边的名字集合必须完全相同(缺一个或多一个都具名拒绝)。 */
    {
        char rec[4400], em[4400];
        int produced = 0, same = 0, missing = 0, extra = 0;
        if(cx_fmt(rec,sizeof rec,"%s/ape-receipt.txt",root))return 2;
        if(cx_fmt(em,sizeof em,"%s/manifest-epoch.tsv",scratch))return 2;
        {   char *v[]={(char*)"sh",(char*)"tools/bound",(char*)"30",(char*)"sh",(char*)"unisacc.com",
                      (char*)"tools/manifest-gen.cx",(char*)"--",(char*)root,em,0};
            np_result r={0}; char why[512];
            if(np_run(v,root,0,30,&r,why,sizeof why)){ck(0,"member-set-gen");}
            else { ck(r.rc==0,"member-set-gen-rc"); np_free(&r); }
        }
        if(sy_exists(rec)!=1 || sy_exists(em)!=1){
            printf("MEMBER_SET\tSKIP\tmissing-input\n");
        } else if(ape_root(root)){
            /* APE: the product is one file, so the receipt legitimately lists more names
               than the manifest has.  The one member that must agree is unisacc.com. */
            size_t rn=0,mn=0;
            char *rb=cx_read(rec,&rn), *mb=cx_read(em,&mn);
            int have=0;
            if(rb && mb){
                char *cur=mb;
                while(cur<mb+mn){
                    char *nl=memchr(cur,'\n',(size_t)(mb+mn-cur));
                    long len=nl?(long)(nl-cur):(long)(mb+mn-cur);
                    if(len>13 && !memcmp(cur,"unisacc.com\t",12)) have=1;
                    cur += len+1;
                }
            }
            printf("MEMBER_SET\tape=unisacc.com\thave=%d\n",have);
            ck(have,"member-set-equals-ape-receipt");
            free(rb); free(mb);
        } else {
            size_t rn=0,mn=0;
            char *rb=cx_read(rec,&rn), *mb=cx_read(em,&mn);
            if(rb && mb){
                /* 对每个 receipt 名字,在 manifest 里找同名行 */
                char *cur=rb;
                while(cur<rb+rn){
                    char *nl=memchr(cur,'\n',(size_t)(rb+rn-cur));
                    long len=nl?(long)(nl-cur):(long)(rb+rn-cur);
                    if(len>0 && !(len>=11 && !memcmp(cur,"NOT_RELEASE",11))){
                        char *tab=memchr(cur,'\t',(size_t)len);
                        long nlen=tab?(long)(tab-cur):len;
                        /* receipt 用不带扩展名的逻辑名(p3-package),manifest 用落盘文件名
                           (p3-package.bin);按 manifest-gen 的映射补齐后再比对。 */
                        char alias[64]; size_t alen=(size_t)nlen;
                        { size_t z; for(z=0;z<alen;z++) alias[z]=cur[z]; alias[alen]=0; }
                        if(alen+4<sizeof alias && !strcmp(alias,"p3-package")){ size_t z; const char *lit="p3-package.bin"; for(z=0;z<15;z++) alias[z]=lit[z]; alen=14; }
                        int found=0;
                        char *mc=mb;
                        while(mc<mb+mn){
                            char *mnl=memchr(mc,'\n',(size_t)(mb+mn-mc));
                            long mlen=mnl?(long)(mnl-mc):(long)(mb+mn-mc);
                            char *mtab=memchr(mc,'\t',(size_t)mlen);
                            long mnlen=mtab?(long)(mtab-mc):mlen;
                            if(mnlen==(long)alen && !memcmp(mc,alias,alen)){ found=1; break; }
                            mc += mlen+1;
                        }
                        if(found) produced++; else { missing++; printf("MEMBER_SET\tMISSING\t%.*s\n",(int)nlen,cur); }
                    }
                    cur += len+1;
                }
                /* 反向:manifest 的每个名字也必须在 receipt 里 */
                {   char *mc=mb;
                    while(mc<mb+mn){
                        char *mnl=memchr(mc,'\n',(size_t)(mb+mn-mc));
                        long mlen=mnl?(long)(mnl-mc):(long)(mb+mn-mc);
                        char *mtab=memchr(mc,'\t',(size_t)mlen);
                        long mnlen=mtab?(long)(mtab-mc):mlen;
                        int found=0;
                        char *rc2=rb;
                        while(rc2<rb+rn){
                            char *rnl=memchr(rc2,'\n',(size_t)(rb+rn-rc2));
                            long rlen=rnl?(long)(rnl-rc2):(long)(rb+rn-rc2);
                            char *rtab=memchr(rc2,'\t',(size_t)rlen);
                            long rnlen=rtab?(long)(rtab-rc2):rlen;
                            char ralias[64]; size_t ralen=(size_t)rnlen;
                            { size_t z; for(z=0;z<ralen;z++) ralias[z]=rc2[z]; ralias[ralen]=0; }
                            if(ralen+4<sizeof ralias && !strcmp(ralias,"p3-package")){ size_t z; const char *lit="p3-package.bin"; for(z=0;z<15;z++) ralias[z]=lit[z]; ralen=14; }
                            if(ralen==(size_t)mnlen && !memcmp(ralias,mc,(size_t)mnlen)){ found=1; break; }
                            rc2 += rlen+1;
                        }
                        if(!found){ extra++; printf("MEMBER_SET\tEXTRA\t%.*s\n",(int)mnlen,mc); }
                        mc += mlen+1;
                    }
                }
                same = (missing==0 && extra==0 && produced>0);
                printf("MEMBER_SET\tmatched=%d\tmissing=%d\textra=%d\n",produced,missing,extra);
            }
            ck(same,"member-set-equals-ape-receipt");
            free(rb); free(mb);
        }
    }

    /* ape-receipt 一致性：对 epoch root 生成 manifest,把 unisacc.com 行的 sha 与
       ape-receipt.txt 里同名成员的 sha= 字段逐字比对(d93c1b24 这一行要对上)。
       这是 B5a 阶段唯一能测的「身份」口径——E0 第 8 步还要等 B5b/B5c 退役 build.json 的
       artifact 段,那一项记到 B5c。 */
    {
        char er[4400], rec[4400], em[4400];
        if(cx_fmt(er,sizeof er,"%s",root))return 2;
        if(cx_fmt(rec,sizeof rec,"%s/ape-receipt.txt",er))return 2;
        if(cx_fmt(em,sizeof em,"%s/manifest-epoch.tsv",scratch))return 2;
        {   sy_stat_t st;
            if(sy_stat(em,&st)==0) unlink(em);
        }
        if(sy_exists(rec)!=1 || sy_exists(er)!=1) {
            printf("RECEIPT_CONSISTENCY\tSKIP\tno-epoch-root\n");
        } else {
            {   char *v[]={(char*)"sh",(char*)"tools/bound",(char*)"30",(char*)"sh",(char*)"unisacc.com",
                          (char*)"tools/manifest-gen.cx",(char*)"--",er,em,0};
                np_result r={0}; char why[512];
                if(np_run(v,root,0,30,&r,why,sizeof why)){ck(0,"epoch-manifest-gen");}
                else { ck(r.rc==0,"epoch-manifest-gen-rc"); np_free(&r); }
            }
            {   size_t rn, mn;
                char *rb=cx_read(rec,&rn), *mb=cx_read(em,&mn);
                int ok=0;
                if(rb && mb){
                    /* receipt: "<name>	<path>	sha=<hex>	bytes=<n>" ; manifest: "<name>	<kind>	<arch>	<sha>..." */
                    const char *rn_ptr=rb;
                    const char *target="unisacc.com";
                    char want[65]={0};
                    while(rn_ptr < rb+rn){
                        const char *nl=memchr(rn_ptr,'\n',(size_t)(rb+rn-rn_ptr));
                        size_t len=nl?(size_t)(nl-rn_ptr):(size_t)(rb+rn-rn_ptr);
                        if(len>strlen(target) && !memcmp(rn_ptr,target,strlen(target)) && rn_ptr[strlen(target)]=='\t'){
                            const char *sh=strstr(rn_ptr,"sha=");
                            if(sh && sh< rn_ptr+len){ size_t z; for(z=0;z<64;z++) want[z]=sh[4+z]; want[64]=0; }
                            break;
                        }
                        rn_ptr += len+1;
                    }
                    /* manifest 行 -> 6 字段；arch 为空时会有连续 TAB，必须按字段切分。 */
                    const char *mn_ptr=mb;
                    while(mn_ptr < mb+mn){
                        const char *nl=memchr(mn_ptr,'\n',(size_t)(mb+mn-mn_ptr));
                        size_t len=nl?(size_t)(nl-mn_ptr):(size_t)(mb+mn-mn_ptr);
                        if(len>strlen(target) && !memcmp(mn_ptr,target,strlen(target)) && mn_ptr[strlen(target)]=='\t'){
                            const char *f[6]; size_t fl[6]; int nf=0;
                            const char *cur=mn_ptr;
                            while(cur <= mn_ptr+len && nf<6){
                                const char *tab=memchr(cur,'\t',(size_t)((mn_ptr+len)-cur));
                                const char *endp=tab?tab:(mn_ptr+len);
                                f[nf]=cur; fl[nf]=(size_t)(endp-cur); nf++;
                                if(!tab) break;
                                cur=tab+1;
                            }
                            if(nf==6 && fl[3]==64 && want[0]) ok = !memcmp(f[3],want,64);
                            break;
                        }
                        mn_ptr += len+1;
                    }
                    printf("RECEIPT_CONSISTENCY\tunisacc.com\tsha=%s\n", want[0]?want:"(not-found)");
                }
                ck(ok,"manifest-sha-equals-ape-receipt");
                free(rb); free(mb);
            }
        }
    }

    /* B5a 补 ②:篡改一个成员 → 必须报出成员名。
       在 /tmp 的 split2 副本上做(不碰冻结域 out/epoch-*):先生成基准 manifest,
       再只改 p3-package.bin 一个字节,重生成,断言该成员行 sha 变了且报出名字;
       同时断言未被改动的 unisacc.com 行 sha 不变(证明报的是那一个成员,不是整表重写)。 */
    {
        char base[4400], t2[4400], troot[4400], tdev[4400];
        if(cx_fmt(base,sizeof base,"%s/b5a-tamper-base.tsv",scratch))return 2;
        if(cx_fmt(t2,sizeof t2,"%s/b5a-tamper-after.tsv",scratch))return 2;
        if(cx_fmt(troot,sizeof troot,"%s/tamper-root",scratch))return 2;
        if(cx_fmt(tdev,sizeof tdev,"%s/unisacc.com.dev",troot))return 2;
        {   sy_stat_t st;
            if(sy_stat(base,&st)==0) unlink(base);
            if(sy_stat(t2,&st)==0) unlink(t2);
            if(sy_stat(troot,&st)==0) cx_rmtree(troot);
        }
        /* 副本建在自己的 scratch 里（不再用固定 /tmp 路径），成员取自已装仓根。 */
        if(sy_mkdir(troot,0755) || (sy_mkdir(tdev,0755) && sy_exists(tdev)!=1)) { ck(0,"tamper-reset"); }
        else if(ape_root(root)) {
            /* APE: the product is a single file.  Copy it whole; the tamper target is the same
               file (there is no separate package member to hit). */
            char cmd[6000], one[4400];
            if(cx_fmt(one,sizeof one,"%s/unisacc.com",root))return 2;
            if(cx_fmt(cmd,sizeof cmd,"cp -f %s %s/ && cp -f %s/ape-receipt.txt %s/",one,troot,root,troot)) return 2;
            {   char *v[]={(char*)"sh",(char*)"-c",cmd,0};
                np_result r={0}; char why[512];
                if(np_run(v,root,0,60,&r,why,sizeof why)){ck(0,"tamper-reset");}
                else { ck(r.rc==0,"tamper-reset-rc"); np_free(&r); }
            }
        }
        else {
            char cmd[6000], one[4400], two[4400], three[4400];
            if(cx_fmt(one,sizeof one,"%s/unisacc.com",root))return 2;
            if(cx_fmt(two,sizeof two,"%s/unisacc.com.dev/entry.elf",root))return 2;
            if(cx_fmt(three,sizeof three,"%s/unisacc.com.dev/p3-package.bin",root))return 2;
            if(cx_fmt(cmd,sizeof cmd,
                      "cp -f %s %s/ && cp -f %s %s/ && cp -f %s %s/ && cp -f %s/ape-receipt.txt %s/",
                      one,troot,two,tdev,three,tdev,root,troot)) return 2;
            {   char *v[]={(char*)"sh",(char*)"-c",cmd,0};
                np_result r={0}; char why[512];
                if(np_run(v,root,0,30,&r,why,sizeof why)){ck(0,"tamper-reset");}
                else { ck(r.rc==0,"tamper-reset-rc"); np_free(&r); }
            }
        }
        {   char *v[]={(char*)"sh",(char*)"tools/bound",(char*)"40",(char*)"sh",(char*)"unisacc.com",
                      (char*)"tools/manifest-gen.cx",(char*)"--",troot,base,0};
            np_result r={0}; char why[512];
            if(np_run(v,root,0,40,&r,why,sizeof why)){ck(0,"tamper-base-gen");}
            else { ck(r.rc==0,"tamper-base-gen-rc"); np_free(&r); }
        }
        /* 改成员的一个字节：split 改包，APE 改整文件本身 */
        {   char pk[4400]; int fd, okw=0;
            int ape = ape_root(root);
            if(cx_fmt(pk,sizeof pk,ape?"%s/unisacc.com":"%s/p3-package.bin",ape?troot:tdev))return 2;
            fd=open(pk,O_RDWR);
            if(fd>=0){ char x='X'; if(lseek(fd,256,SEEK_SET)>=0 && write(fd,&x,1)==1) okw=1; close(fd); }
            ck(okw,"tamper-member-written");
        }
        {   char *v[]={(char*)"sh",(char*)"tools/bound",(char*)"40",(char*)"sh",(char*)"unisacc.com",
                      (char*)"tools/manifest-gen.cx",(char*)"--",troot,t2,0};
            np_result r={0}; char why[512];
            if(np_run(v,root,0,40,&r,why,sizeof why)){ck(0,"tamper-after-gen");}
            else { ck(r.rc==0,"tamper-after-gen-rc"); np_free(&r); }
        }
        /* 比对两表:p3-package.bin 的 sha 必须变,unisacc.com 的必须不变 */
        {   size_t bn=0, an=0;
            char *bb=cx_read(base,&bn), *ab=cx_read(t2,&an);
            int pkg_changed=0, base_stable=0, named=0, lb=0, la=0;
            const char *want_pkg = ape_root(root) ? "unisacc.com" : "p3-package.bin";
            if(bb && ab){
                char pkgb[65]={0}, pkga[65]={0}, comb[65]={0}, coma[65]={0};
                char *cur=bb;
                while(cur<bb+bn){
                    char *nl=memchr(cur,'\n',(size_t)(bb+bn-cur));
                    long len=nl?(long)(nl-cur):(long)(bb+bn-cur);
                    char *f[6]; int nf=0; char *q=cur;
                    while(nf<6 && q<cur+len){ f[nf++]=q; char *tab=memchr(q,'\t',(size_t)(cur+len-q)); if(!tab) break; *tab=0; q=tab+1; }
                    if(nf==6){
                        if(!strcmp(f[0],want_pkg)){ size_t k; for(k=0;k<64&&f[3][k];k++) pkgb[k]=f[3][k]; }
                        lb++;
                        if(!ape_root(root) && !strcmp(f[0],"unisacc.com")){ size_t k; for(k=0;k<64&&f[3][k];k++) comb[k]=f[3][k]; }
                    }
                    cur += len+1;
                }
                cur=ab;
                while(cur<ab+an){
                    char *nl=memchr(cur,'\n',(size_t)(ab+an-cur));
                    long len=nl?(long)(nl-cur):(long)(ab+an-cur);
                    char *f[6]; int nf=0; char *q=cur;
                    while(nf<6 && q<cur+len){ f[nf++]=q; char *tab=memchr(q,'\t',(size_t)(cur+len-q)); if(!tab) break; *tab=0; q=tab+1; }
                    if(nf==6){
                        if(!strcmp(f[0],want_pkg)){ size_t k; for(k=0;k<64&&f[3][k];k++) pkga[k]=f[3][k]; named=1; }
                        la++;
                        if(!ape_root(root) && !strcmp(f[0],"unisacc.com")){ size_t k; for(k=0;k<64&&f[3][k];k++) coma[k]=f[3][k]; }
                    }
                    cur += len+1;
                }
                pkg_changed = pkgb[0] && pkga[0] && strcmp(pkgb,pkga)!=0;
                base_stable = ape_root(root) ? (lb==1 && la==1) : (comb[0] && coma[0] && !strcmp(comb,coma));  /* APE: no second member; the manifest must still hold exactly the one line */
                if(pkg_changed) printf("TAMPER\tmember=%s\tbefore=%s\tafter=%s\n",want_pkg,pkgb,pkga);
                else printf("TAMPER\tNOT-CHANGED\tmember=%s\n",want_pkg);
            }
            ck(pkg_changed && named,"tamper-member-reports-name");
            ck(base_stable,"tamper-untouched-member-stable");
            free(bb); free(ab);
        }
    }
    (void)cx_rmtree(scratch);   /* 本次运行的独占目录，跑完即删 */

    printf("MANIFEST_CHECK\tfailed=%d\tscope=deterministic-gen-and-shape-and-receipt\tbyte-equal-to-B0-explode=NOT-APPLICABLE(different-field-set)\n", failed);
    return failed?1:0;
}
