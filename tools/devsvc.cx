/* tools/devsvc.cx -- 仓开发服务 devsvc 的入口(固定版本启动器):按已提交(git HEAD)的服务源与其依赖构造原生执行体并缓存,
 *   再把参数原样交给它。服务与 CLI 的实现在配置表 self 所指的 tools/devsvc-core.cx,子命令全表见该文件头注。
 * 批次 devsvc-robust(tools/check-devsvc-robust.cx)。设计见 plans/devsvc.md 第 8 节。
 *
 *   sh ./unisacc.com tools/devsvc.cx -- <子命令与参数>          用 HEAD 版本:别人把工作副本(服务源或 tools/cxlib 等依赖)改到一半、
 *                                                               甚至有语法错,普通调用都不受影响
 *   sh ./unisacc.com tools/devsvc.cx -- --dev <子命令与参数>    用工作副本(开发 devsvc 自身时;等价于直接跑 tools/devsvc-core.cx)
 *   环境变量 DEVSVC_DEV 非空等价 --dev;DV_PIN_DIR 指定固定版本缓存目录(检查用)。
 *
 * 身份:`git rev-parse HEAD:<self> HEAD:<lib0> HEAD:<lib1> HEAD:<lib2> HEAD:<同级模块目录>...`(配置表 tools/devsvc-repo.tsv 的 self 与三行 lib;
 *   同级模块目录是 self 以 `use X.*` 引到、且在 self 所在目录下已提交的 X,例如 tools/net)加模块映射 cxroot.tsv、配置表和产品字节摘要与大小,
 *   取 sha256 前 20 位为键;默认执行体按 Git 公共目录在 $HOME/<cache_sub>/pinned/repos/ 下分域。HEAD 里这些路径不变就不重建。
 * 构造:`git archive HEAD` 把 cxroot.tsv、self、三个库源目录与同级模块目录解到 /tmp/dv-pin-<pid>,在其中用产品编译(上限 55 s),原子改名入缓存,
 *   清掉临时目录。只有执行体输入无未提交改动且 HEAD 未移动时才发布回退记录。记录含提交、构造键和产品与配置摘要,每个工作树独立。
 * 构造失败时,同一工作树中有身份相符且来自当前提交祖先的回退记录才使用旧执行体。其余情形退回工作副本并在 stderr 提示。
 * 所起实例:执行体经环境变量 DEVSVC_SELF_BIN 得知自己的路径,自动拉起的服务也是同一固定版本。
 * 输出与退出码即 devsvc 自己的;本入口成功路径不往 stdout 写任何东西,stderr 只在下述工单时钟条件成立时加行。用法错 rc 2;配置表读不到 rc 3。
 * 工单时钟:子命令为 flow/f/x/doc/git 且 $DEVSVC_OWNER 名下有未完成的 devtask 工单时,命令结束后在 stderr 逐单打
 *   TASK_LEFT<TAB>id=ID<TAB>left_s=N<TAB>used_s=M(过期则 TASK_OVERDUE ... over_s=N);只读工单文件,不改退出码。检查 tools/check-devsvc-remain.cx。
 * 子命令 bump(tlib 包版本预留)不经核心,转 tools/bump.cx -- --root ROOT ARGS...,用法见该文件头注与 plans/devsvc.md。
 * 有界:构造 55 s;被转交的 devsvc 自带各子命令上限,本入口另设 3700 s 总上限(flow 截止上限 3600 s 加余量)。
 * 本入口自身仍按工作副本即编即跑,所以保持短小、只依赖 cx/ 与 ext/sysx,不 use tools/cxlib。
 * 服务提交、合入或拉取推进 HEAD 后，后台调用 prebuild-self。相同内容键共享构造锁；普通调用等锁至多 30 秒，超时走原构造路径。
 * 预热仅返回材料 PREPARED 收据。已在跑的实例仍在 ttl 或 idle 自退后换新。 */
#pragma unisa use sys.time
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.proc
#pragma unisa use sys.env
#pragma unisa use sys.sha
#pragma unisa use os.osx
#pragma unisa use sysx.process
#pragma unisa use mem.bytes
#pragma unisa use mem.heap

#define PW 1024
#define CFG_TABLE "tools/devsvc-repo.tsv"
static int ovf, preparing, pin_ok;
#define F(dst, cap, ...) do { int f_ = snprintf(dst, cap, __VA_ARGS__); if (f_ < 0 || f_ >= (int)(cap)) ovf++; } while (0)
static char c_product[128], c_self[128], c_lib[3][128], c_cache[128], c_instenv[64];
#define MAXSIB 8
static char sib[MAXSIB][192]; static int nsib;   /* self 所在目录下、被 self 以 `use X.*` 引到的同级模块目录(相对仓根) */

static int cfg_take(char *dst, int cap, const char *v, long n) {
    if (n <= 0 || n >= cap || mm_copy(dst, cap, v, n)) return 0;
    dst[n] = 0; return 1;
}
/* 只取本入口要用的键;0 成功 */
static int runcap(char **argv, const char *cwd, char *out, int cap);
static char headtab[1 << 16]; static long headtab_n;   /* HEAD 版配置表(固定版本模式下的唯一配置来源) */
/* 钉死用的修订:能不起 git 读出 HEAD 提交号时为该提交号(本次全部 git 读与构造都钉在同一提交上,不受中途 HEAD 移动影响),否则为 HEAD */
static char hd[48] = "HEAD";
/* 解析配置表文本(只读 b[0,n));0 成功 */
static int cfg_parse(const char *b, long n) {
    const char *s, *e, *end, *t, *t2; int nlib = 0, seen = 0;
    c_instenv[0] = 0;
    for (s = b, end = s + n; s < end; s = e + 1) {
        long kl, vl;
        e = memchr(s, '\n', end - s); if (!e) break;
        t = memchr(s, '\t', e - s); if (!t || *s == '#') continue;
        t2 = memchr(t + 1, '\t', e - t - 1); if (!t2) t2 = e;
        kl = t - s; vl = t2 - t - 1;
        if (kl == 7 && !memcmp(s, "product", 7)) seen |= cfg_take(c_product, sizeof c_product, t + 1, vl) ? 1 : 0;
        else if (kl == 4 && !memcmp(s, "self", 4)) seen |= cfg_take(c_self, sizeof c_self, t + 1, vl) ? 2 : 0;
        else if (kl == 9 && !memcmp(s, "cache_sub", 9)) seen |= cfg_take(c_cache, sizeof c_cache, t + 1, vl) ? 4 : 0;
        else if (kl == 3 && !memcmp(s, "lib", 3) && nlib < 3 && cfg_take(c_lib[nlib], sizeof c_lib[0], t + 1, vl)) nlib++;
        else if (kl == 8 && !memcmp(s, "inst_env", 8)) (void)cfg_take(c_instenv, sizeof c_instenv, t + 1, vl);
    }
    return seen == 7 && nlib == 3 ? 0 : -1;
}
/* 配置来源:$DEVSVC_REPO_TABLE 优先;--dev 读工作区表;否则只读 git HEAD 里的表,工作区改表不影响普通调用 */
static int cfg_load(const char *root, int dev, int *from_head) {
    char table[PW + 64]; unsigned char *b = 0; int64_t n = 0; const char *ov = getenv("DEVSVC_REPO_TABLE");
    *from_head = 0;
    if (!(ov && *ov) && !dev) {
        char spec[160]; char *v[] = {"git", "show", spec, 0};
        F(spec, sizeof spec, "%s:%s", hd, CFG_TABLE);
        if (!ovf && runcap(v, root, headtab, sizeof headtab) == 0 && headtab[0]) {
            headtab_n = (long)strlen(headtab); n = headtab_n;
            b = malloc((size_t)n + 1); if (!b) return -1;
            mm_copy(b, n + 1, headtab, n); *from_head = 1;
        }
    }
    if (!b) {
        if (ov && *ov) F(table, sizeof table, "%s", ov); else F(table, sizeof table, "%s/%s", root, CFG_TABLE);
        if (ovf || sy_read_file(table, &b, &n, 1 << 16) || !b) return -1;
        if (pin_ok && n > 0 && n < (int64_t)sizeof headtab && !mm_copy(headtab, sizeof headtab, b, n)) {
            headtab[n] = 0; headtab_n = (long)n; *from_head = 1;
        }
    }
    {   int r = cfg_parse((const char *)b, (long)n); free(b); return r; }
}
/* 有界跑一条命令(55 s),stdout 收进 out;返回退出码,起不来或装不下为负 */
static int runcap(char **argv, const char *cwd, char *out, int cap) {
    np_result r; char why[200]; int rc; long n;
    memset(out, 0, cap);
    if (np_run(argv, cwd, 0, 55, &r, why, sizeof why)) return -1;
    n = (long)r.outn; rc = r.rc;
    if (n > cap - 1 || (n > 0 && mm_copy(out, cap, r.out, n))) rc = -2;
    np_free(&r);
    return rc;
}
/* 扫 self 的 `#pragma unisa use X.Y`:X 在 self 同目录下有目录的,记为同级模块目录(进身份、进归档)。
 * wc 为 0 读钉死修订版并只认已提交目录(全部候选一次 git ls-tree 判定);wc 为 1 读工作副本并认磁盘上的目录(工作副本退回的内容键用)。 */
#define MAXCAND 32
static void siblings(const char *root, int wc) {
    static char srcb[1 << 20], cand[MAXCAND][192]; char spec[192], dirp[160], *s, *e, *sl; int i, nc = 0;
    nsib = 0;
    if (wc) {
        unsigned char *b = 0; int64_t n = 0; char p[PW + 200];
        F(p, sizeof p, "%s/%s", root, c_self);
        if (sy_read_file(p, &b, &n, (1 << 20) - 1) || !b) { if (b) free(b); return; }
        mm_copy(srcb, sizeof srcb, b, n); srcb[n] = 0; free(b);
    } else {   char *v[] = {"git", "show", spec, 0}; F(spec, sizeof spec, "%s:%s", hd, c_self); if (runcap(v, root, srcb, sizeof srcb) != 0) return; }
    F(dirp, sizeof dirp, "%s", c_self); sl = strrchr(dirp, '/'); if (sl) *sl = 0; else dirp[0] = 0;
    for (s = srcb; *s; s = e + 1) {
        long k = 0; const char *p;
        e = strchr(s, '\n'); if (!e) break;
        if (strncmp(s, "#pragma unisa use ", 18)) continue;
        for (p = s + 18; p < e && *p != '.' && *p != ' ' && *p != '\r' && k < 63; p++) k++;
        if (k <= 0 || k >= 63 || *p != '.') continue;
        F(spec, sizeof spec, "%s%s%.*s", dirp, dirp[0] ? "/" : "", (int)k, s + 18);
        for (i = 0; i < nc; i++) if (!strcmp(cand[i], spec)) break;
        if (i < nc || nc >= MAXCAND) continue;
        F(cand[nc], sizeof cand[0], "%s", spec); nc++;
    }
    if (ovf) return;
    if (wc) {
        for (i = 0; i < nc && nsib < MAXSIB; i++) { char dp[PW + 200]; sy_stat_t st; F(dp, sizeof dp, "%s/%s", root, cand[i]); if (sy_stat(dp, &st) == 0 && st.kind == 'd') { F(sib[nsib], sizeof sib[0], "%s", cand[i]); nsib++; } }
        return;
    }
    if (nc == 0) return;
    {   /* 一次 ls-tree 判定全部候选是否已提交(取代逐个 rev-parse --verify) */
        static char lt[1 << 14]; char *g[6 + MAXCAND]; int k = 0, j;
        g[k++] = "git"; g[k++] = "ls-tree"; g[k++] = "--name-only"; g[k++] = hd; g[k++] = "--";
        for (j = 0; j < nc; j++) g[k++] = cand[j];
        g[k] = 0;
        if (runcap(g, root, lt, sizeof lt) != 0) return;
        for (j = 0; j < nc && nsib < MAXSIB; j++) {
            long cl = (long)strlen(cand[j]); const char *q = lt;
            for (; *q; q = strchr(q, '\n'), q = q ? q + 1 : "")
                if (!strncmp(q, cand[j], cl) && (q[cl] == '\n' || q[cl] == 0)) { F(sib[nsib], sizeof sib[0], "%s", cand[j]); nsib++; break; }
        }
    }
}
static int run_through(char **v, long deadline_ms) {
    sy_spawn_t o; sy_exit_t ex;
    sy_spawn_init(&o); o.argv = v; o.deadline_ms = deadline_ms;
    fflush(stdout);
    if (sy_proc_run(&o, &ex)) return 1;
    return sy_exit_code(&ex);
}
/* 执行体字节 sha 存在 <bin>.sha,racy-2s stat 备忘存在 <bin>.stat;命中时 O(1) stat 校验 */
static int fg_small(const char *p, char *out, int cap);
static int fg_hex40(const char *s);
static int bin_sha(const char *bin, char hex[65]) {
    unsigned char *b = 0; int64_t n = 0; int rc = -1;
    if (!sy_read_file(bin, &b, &n, 1LL << 30) && b && !sy_sha256_hex(b, (long)n, hex)) rc = 0;
    if (b) free(b);
    return rc;
}
static void bin_seal_stat(const char *bin, const sy_stat_t *st, const char *hex) {
    char sp[PW + 16], line[256]; long now = sy_wall_s(); int k;
    F(sp, sizeof sp, "%s.stat", bin);
    if (ovf || now < st->ctime + 2 || now < st->mtime + 2) return;
    sy_stat_t s2;
    if (sy_stat(bin, &s2) || s2.size != st->size || s2.ino != st->ino || s2.dev != st->dev || s2.mtime != st->mtime || s2.ctime != st->ctime) return;
    k = snprintf(line, sizeof line, "dvbin1\t%ld\t%lu\t%ld\t%ld\t%ld\t%s\tr%010ld", st->size, st->dev, st->ino, st->mtime, st->ctime, hex, now);
    if (k > 0 && k < (int)sizeof line) (void)sy_write_atomic(sp, line, k, 0600);
}
static void bin_seal(const char *bin) {
    char hex[65], p[PW + 16], sp[PW + 16]; sy_stat_t st;
    F(p, sizeof p, "%s.sha", bin); F(sp, sizeof sp, "%s.stat", bin);
    if (!ovf) sy_unlink(sp);
    if (!ovf && !bin_sha(bin, hex) && !sy_write_atomic(p, hex, 64, 0600) && !sy_stat(bin, &st) && st.kind == 'f') bin_seal_stat(bin, &st, hex);
}
/* 1:执行体在且与 .stat (racy 2s 规则) 或 .sha 相符(无 .sha 的旧条目补写后视为相符);0:不在或不符(不符时删掉以便重建) */
static int bin_ok(const char *bin) {
    char hex[65], p[PW + 16], sp[PW + 16], want[160], sline[256]; unsigned char *b = 0; int64_t n = 0;
    sy_stat_t st; int ok, wl;
    if (ovf || sy_stat(bin, &st) || st.kind != 'f') return 0;
    F(p, sizeof p, "%s.sha", bin); F(sp, sizeof sp, "%s.stat", bin);
    if (ovf) return 0;
    wl = snprintf(want, sizeof want, "dvbin1\t%ld\t%lu\t%ld\t%ld\t%ld\t", st.size, st.dev, st.ino, st.mtime, st.ctime);
    if (wl > 0 && wl < (int)sizeof want && sy_exists(p) == 1 && fg_small(sp, sline, sizeof sline) == wl + 64 + 12 && !memcmp(sline, want, wl)) {
        if (sline[wl + 64] == '\t' && sline[wl + 65] == 'r' && fg_hex40(sline + wl) && fg_hex40(sline + wl + 24)) {
            long rec = atol(sline + wl + 66);
            if (rec >= st.ctime + 2 && rec >= st.mtime + 2) return 1;
        }
    }
    if (bin_sha(bin, hex)) return 0;
    if (sy_read_file(p, &b, &n, 128) || !b) { if (b) free(b); sy_write_atomic(p, hex, 64, 0600); bin_seal_stat(bin, &st, hex); return 1; }
    ok = n == 64 && !memcmp(b, hex, 64);
    free(b);
    if (ok) bin_seal_stat(bin, &st, hex);
    else { fprintf(stderr, "dv: cached %s does not match its sha, rebuilding\n", bin); sy_unlink(bin); sy_unlink(p); sy_unlink(sp); }
    return ok;
}
/* 用产品把 src 编成 bin(cwd 下,上限 55 s,日志 logp),原子改名;0 成功 */
static int compile_to(const char *prod, const char *src, const char *cwd, const char *bin, const char *logp) {
    char out[PW + 32]; int rc, lf; sy_spawn_t o; sy_exit_t ex;
    char *v[] = {"sh", (char *)prod, (char *)src, "-o", out, 0};
    F(out, sizeof out, "%s.tmp%d", bin, sy_pid());
    if (ovf) return -1;
    lf = sy_open(logp, O_WRONLY | O_CREAT | O_TRUNC, 0600);
    sy_spawn_init(&o); o.argv = v; o.cwd = cwd; o.pgroup = preparing ? 0 : -1; o.deadline_ms = 55000;
    o.in_fd = SY_STDIO_NULL; o.out_fd = lf >= 0 ? lf : SY_STDIO_NULL; o.err_fd = lf >= 0 ? lf : SY_STDIO_NULL;
    rc = sy_proc_run(&o, &ex);
    if (lf >= 0) sy_close(lf);
    if (!rc && (sy_exit_code(&ex) != 0 || sy_exists(out) != 1)) rc = -4;
    if (!rc && sy_rename(out, bin)) rc = -5;
    if (rc) sy_unlink(out); else bin_seal(bin);
    return rc;
}
/* 工作副本内容键:self 文件、三个库源目录与同级模块目录下全部文件(跳过 .git),逐个记 "相对路径<TAB>sha256",
 *   排序后连同工作区配置表与产品 sha 再取 sha256。与仓路径无关,内容相同的克隆得同一键。 */
static char wl[1 << 20]; static long wl_n; static int wl_bad;
static void wl_file(const char *root, const char *rel) {
    char p[2 * PW], hex[65]; unsigned char *b = 0; int64_t n = 0; int k;
    F(p, sizeof p, "%s/%s", root, rel);
    if (sy_read_file(p, &b, &n, 1LL << 28) || !b || sy_sha256_hex(b, (long)n, hex)) F(hex, sizeof hex, "-");
    if (b) free(b);
    k = snprintf(wl + wl_n, sizeof wl - wl_n, "%s\t%s\n", rel, hex);
    if (k < 0 || k >= (int)(sizeof wl - wl_n)) wl_bad = 1; else wl_n += k;
}
static void wl_tree(const char *root, const char *rel, int depth) {
    char p[2 * PW], c[PW]; sy_dir_t d; int r;
    F(p, sizeof p, "%s/%s", root, rel);
    if (ovf || depth > 24 || sy_dir_open(&d, p)) { wl_bad = 1; return; }
    while ((r = sy_dir_next(&d)) == 1) {
        if (!strcmp(d.name, ".git")) continue;
        F(c, sizeof c, "%s/%s", rel, d.name);
        if (d.kind == 'd') wl_tree(root, c, depth + 1); else if (d.kind == 'f' || d.kind == 'l') wl_file(root, c);
    }
    if (r < 0) wl_bad = 1;
    sy_dir_close(&d);
}
static int wl_cmp(const void *a, const void *b) { return strcmp(*(char *const *)a, *(char *const *)b); }
static int wc_key(const char *root, const char *ph, char hex[65]) {
    static char *ln[1 << 14], cat[1 << 20]; long n = 0, cn = 0, i; char *s, *e, tp[PW + 64]; unsigned char *tb = 0; int64_t tn = 0;
    wl_n = 0; wl_bad = 0;
    wl_file(root, c_self);
    for (i = 0; i < 3; i++) wl_tree(root, c_lib[i], 0);
    for (i = 0; i < nsib; i++) wl_tree(root, sib[i], 0);
    if (wl_bad || ovf) return -1;
    for (s = wl; s < wl + wl_n && n < (long)(sizeof ln / sizeof ln[0]); s = e + 1) { e = memchr(s, '\n', wl + wl_n - s); if (!e) break; *e = 0; ln[n++] = s; }
    qsort(ln, (size_t)n, sizeof ln[0], wl_cmp);
    for (i = 0; i < n; i++) { int k = snprintf(cat + cn, sizeof cat - cn, "%s\n", ln[i]); if (k < 0 || k >= (int)(sizeof cat - cn)) return -1; cn += k; }
    F(tp, sizeof tp, "%s/%s", root, CFG_TABLE);
    if (!ovf && !sy_read_file(tp, &tb, &tn, 1 << 16) && tb) { char th[65]; if (!sy_sha256_hex(tb, (long)tn, th)) { int k = snprintf(cat + cn, sizeof cat - cn, "table\t%s\n", th); if (k > 0 && k < (int)(sizeof cat - cn)) cn += k; } }
    if (tb) free(tb);
    {   int k = snprintf(cat + cn, sizeof cat - cn, "wc-v1\tproduct\t%s\n", ph); if (k < 0 || k >= (int)(sizeof cat - cn)) return -1; cn += k; }
    return sy_sha256_hex(cat, cn, hex) ? -1 : 0;
}
/* 从 HEAD 构造固定版本到 bin;0 成功。日志在 logp。 */
static int build(const char *root, const char *prod, const char *bin, const char *logp) {
    char tmp[128], src[PW], scratch[256]; int rc;
    F(tmp, sizeof tmp, "/tmp/dv-pin-%d", sy_pid()); F(src, sizeof src, "%s/%s", tmp, c_self);
    if (ovf || sy_mkdir_all(tmp, 0700)) return -1;
    {   char *v[24]; int k = 0, i;
        v[k++] = "sh"; v[k++] = "-c"; v[k++] = "d=$1; h=$2; shift 2; git archive \"$h\" -- cxroot.tsv \"$@\" | tar -x -C \"$d\""; v[k++] = "sh"; v[k++] = tmp; v[k++] = hd;
        v[k++] = c_self; v[k++] = c_lib[0]; v[k++] = c_lib[1]; v[k++] = c_lib[2];
        for (i = 0; i < nsib; i++) v[k++] = sib[i];
        v[k] = 0;
        rc = runcap(v, root, scratch, sizeof scratch); }
    if (rc == 0 && sy_exists(src) != 1) rc = -3;
    if (rc == 0) rc = compile_to(prod, src, tmp, bin, logp);
    {   char *v[] = {"rm", "-rf", tmp, 0}; runcap(v, 0, scratch, sizeof scratch); }
    return rc;
}

/* 命中路免 git(plans/runtime-speedup-lessons-2026-11-16.md N1):
 * fastgit 不起子进程,从 cwd 向上找 .git(目录或 gitdir: 文件),读 commondir、HEAD、loose ref 或 packed-refs,得顶层、公共 git 目录与 HEAD 提交号。
 *   只认常规布局:环境里有 GIT_DIR 等变量、cwd 在 .git 内、reftable、HEAD 指向 refs/heads/ 以外、ref 是符号引用或读不出 40 位十六进制时,
 *   一律返回非 0,交回原来逐个问 git 的路径(结论不变,只是慢)。
 * 备忘:按提交号存上次经 git 算得的身份原料(同级模块目录、rev-parse 的树/块号行、HEAD 版配置表),路径 <DV_PIN_DIR 或 $HOME/.cache/devsvc-launch>/memo/head-<提交号>。
 *   提交号相同则 <提交号>:<路径> 全部相同,所以复用不放松"从 HEAD 钉死、内容键缓存";HEAD 一动提交号即变,备忘自然不命中并重新钉死。
 *   产品身份(真实路径、大小、内容 sha)与执行体字节 sha 每次照旧现算,不进备忘。 */
static char fg_top[PW], fg_git[PW], fg_common[PW], fg_commit[48];
static int fg_join(char *dst, int cap, const char *base, const char *p) {   /* p 为绝对路径时照抄,否则接在 base 后;装不下 -1 */
    if (p[0] == '/') return cx_fmt(dst, cap, "%s", p) ? -1 : 0;
    return cx_fmt(dst, cap, "%s/%s", base, p) ? -1 : 0;
}
static int fg_small(const char *p, char *out, int cap) {   /* 读小文件并去掉尾部空白;返回长度,读不到或装不下 -1 */
    unsigned char *b = 0; int64_t n = 0;
    if (sy_read_file(p, &b, &n, cap - 1) || !b || n >= cap || (n > 0 && mm_copy(out, cap, b, n))) { if (b) free(b); return -1; }
    free(b); out[n] = 0;
    while (n > 0 && (out[n - 1] == '\n' || out[n - 1] == '\r' || out[n - 1] == ' ')) out[--n] = 0;
    return (int)n;
}
static int fg_hex40(const char *s) { int i; for (i = 0; i < 40; i++) if (!((s[i] >= '0' && s[i] <= '9') || (s[i] >= 'a' && s[i] <= 'f'))) return 0; return 1; }
/* 0:顶层、公共 git 目录与提交号都读出;1:只读出顶层(及可能的公共目录);-1:不确定,全交给 git */
static int fastgit(void) {
    static char cur[PW], p[2 * PW], q[2 * PW], t[PW + 64], v[128];
    static const char *envs[] = {"GIT_DIR", "GIT_WORK_TREE", "GIT_COMMON_DIR", "GIT_CEILING_DIRECTORIES", "GIT_DISCOVERY_ACROSS_FILESYSTEM", "GIT_INDEX_FILE", "GIT_OBJECT_DIRECTORY", 0};
    char *sl; int r, depth; long cl; sy_stat_t st;
    fg_top[0] = fg_git[0] = fg_common[0] = fg_commit[0] = 0;
    for (r = 0; envs[r]; r++) { const char *e = getenv(envs[r]); if (e && *e) return -1; }
    if (sy_cwd(cur, sizeof cur) < 0 || cur[0] != '/' || strstr(cur, "/.git/")) return -1;
    cl = (long)strlen(cur); if (cl >= 5 && !strcmp(cur + cl - 5, "/.git")) return -1;
    for (depth = 0; ; depth++) {
        if (depth > 256 || fg_join(p, sizeof p, cur, ".git")) return -1;
        r = sy_exists(p);
        if (r == 1) break;
        if (r != 0) return -1;   /* 只把 ENOENT 当不存在 */
        if (!strcmp(cur, "/")) return -1;
        sl = strrchr(cur, '/'); if (sl == cur) cur[1] = 0; else *sl = 0;
    }
    if (sy_stat(p, &st)) return -1;
    if (st.kind == 'd') { if (fg_join(fg_git, sizeof fg_git, "", p)) return -1; }
    else if (st.kind == 'f') { if (fg_small(p, t, sizeof t) < 9 || strncmp(t, "gitdir: ", 8) || fg_join(fg_git, sizeof fg_git, cur, t + 8)) return -1; }
    else return -1;
    if (fg_join(q, sizeof q, fg_git, "HEAD") || sy_exists(q) != 1) return -1;   /* 不像仓的 .git:git 会继续往上找,交给 git */
    if (fg_join(fg_top, sizeof fg_top, "", cur)) return -1;
    if (fg_join(q, sizeof q, fg_git, "commondir")) return 1;
    r = sy_exists(q);
    if (r == 1) { if (fg_small(q, t, sizeof t) <= 0 || fg_join(p, sizeof p, fg_git, t)) return 1; }
    else if (r == 0) { if (fg_join(p, sizeof p, "", fg_git)) return 1; }
    else return 1;
    if (sy_realpath(p, fg_common, sizeof fg_common) < 0) { fg_common[0] = 0; return 1; }
    if (fg_join(q, sizeof q, fg_common, "reftable") || sy_exists(q) != 0) return 1;
    if (fg_join(q, sizeof q, fg_git, "HEAD")) return 1;
    r = fg_small(q, t, sizeof t);
    if (r == 40 && fg_hex40(t)) { mm_copy(fg_commit, sizeof fg_commit, t, 41); return 0; }   /* 分离 HEAD */
    if (r < 17 || strncmp(t, "ref: refs/heads/", 16)) return 1;
    if (fg_join(q, sizeof q, fg_common, t + 5)) return 1;
    r = sy_exists(q);
    if (r == 1) { if (fg_small(q, v, sizeof v) == 40 && fg_hex40(v)) { mm_copy(fg_commit, sizeof fg_commit, v, 41); return 0; } return 1; }
    if (r != 0) return 1;
    {   /* loose ref 不存在才查 packed-refs(loose 优先,与 git 一致) */
        unsigned char *b = 0; int64_t n = 0; const char *s, *e, *end, *ref = t + 5; long rl = (long)strlen(ref); int got = 0;
        if (fg_join(q, sizeof q, fg_common, "packed-refs") || sy_read_file(q, &b, &n, 1LL << 28) || !b) { if (b) free(b); return 1; }
        for (s = (const char *)b, end = s + n; s < end; s = e + 1) {
            e = memchr(s, '\n', end - s); if (!e) e = end;
            if (e - s == 41 + rl && s[40] == ' ' && !memcmp(s + 41, ref, rl) && fg_hex40(s)) { mm_copy(fg_commit, sizeof fg_commit, s, 40); fg_commit[40] = 0; got = 1; break; }
        }
        free(b);
        return got ? 0 : 1;
    }
}
static int memo_path(char *p, int cap, int dir_only) {
    const char *d = getenv("DV_PIN_DIR"); char home[PW];
    const char *suffix = "/memo";
    if (!d || !*d) {
        if (sy_homedir(home, sizeof home) < 0) return -1;
        d = home;
        suffix = "/.cache/devsvc-launch/memo";
    }
    if (dir_only) return cx_fmt(p, cap, "%s%s", d, suffix) ? -1 : 0;
    return cx_fmt(p, cap, "%s%s/head-%s", d, suffix, hd) ? -1 : 0;
}
/* 备忘格式:"dvmemo1<TAB><提交号>\n" 后接若干 "sib<TAB>路径\n",再 "trees<TAB>长度\n"+字节,"tab<TAB>长度\n"+字节,恰到文件尾。任何不符即不命中 */
static int memo_load(char *trees, int tcap) {
    char p[2 * PW], hdr[80]; unsigned char *b = 0; int64_t n = 0; const char *s, *end, *e; long ln, tln = -1; int ok = 0;
    if (memo_path(p, sizeof p, 0) || sy_read_file(p, &b, &n, 1 << 20) || !b) { if (b) free(b); return -1; }
    s = (const char *)b; end = s + n; nsib = 0;
    if (snprintf(hdr, sizeof hdr, "dvmemo1\t%s\n", hd) >= (int)sizeof hdr) { free(b); return -1; }
    if (n > (int64_t)strlen(hdr) && !memcmp(s, hdr, strlen(hdr))) {
        s += strlen(hdr);
        while (end - s > 4 && !memcmp(s, "sib\t", 4) && nsib < MAXSIB) {
            e = memchr(s, '\n', end - s); if (!e || e - s - 4 <= 0 || e - s - 4 >= (long)sizeof sib[0]) break;
            mm_copy(sib[nsib], sizeof sib[0], s + 4, e - s - 4); sib[nsib][e - s - 4] = 0; nsib++; s = e + 1;
        }
        if (end - s > 6 && !memcmp(s, "trees\t", 6)) {
            ln = atol(s + 6); e = memchr(s, '\n', end - s);
            if (e && ln > 0 && ln < tcap && end - (e + 1) >= ln) {
                mm_copy(trees, tcap, e + 1, ln); trees[ln] = 0; tln = ln; s = e + 1 + ln;
                if (end - s > 4 && !memcmp(s, "tab\t", 4)) {
                    ln = atol(s + 4); e = memchr(s, '\n', end - s);
                    if (e && ln > 0 && ln < (long)sizeof headtab && end - (e + 1) == ln) {
                        mm_copy(headtab, sizeof headtab, e + 1, ln); headtab[ln] = 0; headtab_n = ln;
                        ok = (long)strlen(headtab) == ln && (long)strlen(trees) == tln && strstr(trees, "\ncxroot\t") && cfg_parse(headtab, headtab_n) == 0;
                    }
                }
            }
        }
    }
    free(b);
    if (!ok) { nsib = 0; headtab_n = 0; headtab[0] = 0; }
    return ok ? 0 : -1;
}
static void memo_save(const char *trees) {
    static char mb[(1 << 16) + 8192]; char p[2 * PW], d[2 * PW]; long k, tl = (long)strlen(trees); int i, r;
    if (memo_path(d, sizeof d, 1) || memo_path(p, sizeof p, 0) || tl <= 0 || headtab_n <= 0) return;
    k = snprintf(mb, sizeof mb, "dvmemo1\t%s\n", hd);
    for (i = 0; i < nsib && k > 0 && k < (long)sizeof mb; i++) k += snprintf(mb + k, sizeof mb - k, "sib\t%s\n", sib[i]);
    if (k <= 0 || k >= (long)sizeof mb) return;
    r = snprintf(mb + k, sizeof mb - k, "trees\t%ld\n", tl); if (r < 0 || k + r + tl >= (long)sizeof mb) return;
    k += r; mm_copy(mb + k, sizeof mb - (size_t)k, trees, tl); k += tl;
    r = snprintf(mb + k, sizeof mb - k, "tab\t%ld\n", headtab_n); if (r < 0 || k + r + headtab_n > (long)sizeof mb) return;
    k += r; mm_copy(mb + k, sizeof mb - (size_t)k, headtab, headtab_n); k += headtab_n;
    if (sy_mkdir_all(d, 0700)) return;
    (void)sy_write_atomic(p, mb, k, 0600);
}
/* 产品内容 sha(进固定版本键)的备忘:按 (真实路径, 大小, dev, ino, mtime, ctime) 记上次算得的 sha,路径 <备忘目录>/prod-<sha256(真实路径)前 16 位>。
 *   只信"记录时刻比文件 ctime 至少晚 2 s"的条目(同 git 索引的 racy 规则:ctime 只到秒,记录后任何改写都会把 ctime 推到记录时刻之后,
 *   因而与所记不同);否则照旧整文件读并算 sha。键仍是产品内容 sha,不是路径或时间。0 成功 */
static int prod_sha(const char *real, char ph[65]) {
    char d[2 * PW], p[2 * PW + 64], rh[65], line[2 * PW + 256], want[2 * PW + 200]; sy_stat_t st; unsigned char *b = 0; int64_t n = 0; long now; int k, wl;
    int have = !memo_path(d, sizeof d, 1) && !sy_sha256_hex(real, (long)strlen(real), rh) && !sy_stat(real, &st);
    if (have) { rh[16] = 0; k = snprintf(p, sizeof p, "%s/prod-%s", d, rh); have = k > 0 && k < (int)sizeof p; }
    if (have) {
        wl = snprintf(want, sizeof want, "dvprod1\t%s\t%ld\t%lu\t%ld\t%ld\t%ld\t", real, st.size, st.dev, st.ino, st.mtime, st.ctime);
        if (wl > 0 && wl < (int)sizeof want && fg_small(p, line, sizeof line) == wl + 64 + 12 && !memcmp(line, want, wl)) {
            /* 行尾:<sha 64 位><TAB>r<记录时刻 10 位> */
            if (line[wl + 64] == '\t' && line[wl + 65] == 'r' && fg_hex40(line + wl) && fg_hex40(line + wl + 24)) {
                long rec = atol(line + wl + 66);
                if (rec >= st.ctime + 2 && rec >= st.mtime + 2) { mm_copy(ph, 65, line + wl, 64); ph[64] = 0; return 0; }
            }
        }
    }
    if (sy_read_file(real, &b, &n, 1LL << 30) || !b || sy_sha256_hex(b, (long)n, ph)) { if (b) free(b); return -1; }
    free(b);
    now = sy_wall_s();
    if (have && wl > 0 && wl < (int)sizeof want && now >= st.ctime + 2 && now >= st.mtime + 2) {
        sy_stat_t s2;   /* 读的过程中文件被改则不记 */
        if (!sy_stat(real, &s2) && s2.size == st.size && s2.ino == st.ino && s2.dev == st.dev && s2.mtime == st.mtime && s2.ctime == st.ctime) {
            k = snprintf(line, sizeof line, "%s%s\tr%010ld", want, ph, now);
            if (k > 0 && k < (int)sizeof line && !sy_mkdir_all(d, 0700)) (void)sy_write_atomic(p, line, k, 0600);
        }
    }
    return 0;
}

/* Work-order clock carried by flow-family output (plans/devsvc.md section 6, S3): after flow/f/x/doc/git, when $DEVSVC_OWNER
 * has open devtask work orders (DIR/work/ID.tsv, owner row equal, done 0), print one stderr line per order:
 *   TASK_LEFT<TAB>id=ID<TAB>left_s=N<TAB>used_s=M      or, past the deadline,   TASK_OVERDUE<TAB>id=ID<TAB>over_s=N<TAB>used_s=M
 * DIR is the devtask instance directory: $<inst_env> when set, else $HOME/<cache_sub>/<sha256(git common dir)[:16]>.
 * Read only; any failure prints nothing and never changes the exit code. $DEVTASK_NOW overrides the clock (checks). */
static long wo_num(const char *b, const char *key) {
    long kl = (long)strlen(key); const char *s = b;
    for (; s && *s; s = strchr(s, '\n'), s = s ? s + 1 : 0) if (!strncmp(s, key, kl) && s[kl] == '\t') return atol(s + kl + 1);
    return -1;
}
static void task_left(const char *root, const char *sub) {
    static char dir[PW], common[PW], p[2 * PW], seen[16][64];
    const char *ow = getenv("DEVSVC_OWNER"), *home = getenv("HOME"), *ne = getenv("DEVTASK_NOW"), *e; char hex[65], *s, *le; int ns = 0, i, ovf0 = ovf;
    unsigned char *ib = 0; int64_t in = 0; long now, ol;
    if (!ow || !*ow || !c_cache[0]) return;
    if (strcmp(sub, "flow") && strcmp(sub, "f") && strcmp(sub, "x") && strcmp(sub, "doc") && strcmp(sub, "git")) return;
    ol = (long)strlen(ow);
    e = c_instenv[0] ? getenv(c_instenv) : 0;
    if (e && *e) F(dir, sizeof dir, "%s", e);
    else {
        const char *pb = getenv("DEVSVC_HOME"); long cn;
        if (!pb || !*pb) pb = getenv("DV_PIN_DIR");
        if (*fg_common) F(common, sizeof common, "%s", fg_common);
        else {
            char *gv[] = {"git", "rev-parse", "--path-format=absolute", "--git-common-dir", 0};
            if (!home || !*home || runcap(gv, root, common, sizeof common) != 0) return;
        }
        cn = (long)strlen(common); while (cn > 0 && (common[cn - 1] == '\n' || common[cn - 1] == '\r')) common[--cn] = 0;
        if (memcmp(common + cn - 5, "/.git", 5) == 0) cn -= 5;
        if (!cn || sy_sha256_hex(common, cn, hex)) return;
        hex[16] = 0;
        if (pb && *pb) F(dir, sizeof dir, "%s/%s", pb, hex);
        else F(dir, sizeof dir, "%s/%s/%s", home, c_cache, hex);
    }
    F(p, sizeof p, "%s/work/index.tsv", dir);
    if (ovf != ovf0) { ovf = ovf0; return; }
    if (sy_read_file(p, &ib, &in, 1 << 16) || !ib || in <= 0) { if (ib) free(ib); return; }
    now = ne && *ne ? atol(ne) : sy_wall_s();
    for (s = (char *)ib; s < (char *)ib + in; s = le + 1) {
        unsigned char *b = 0; int64_t n = 0; long idl, opened, deadline; char id[64], *ob, *z;
        le = memchr(s, '\n', (char *)ib + in - s); if (!le) break;
        idl = le - s; if (idl <= 0 || idl >= (long)sizeof id || memchr(s, '/', idl) || s[0] == '.') continue;
        if (mm_copy(id, sizeof id, s, idl)) continue;
        id[idl] = 0;
        for (i = 0; i < ns; i++) if (!strcmp(seen[i], id)) break;
        if (i < ns || ns >= 16) continue;
        F(p, sizeof p, "%s/work/%s.tsv", dir, id);
        if (ovf != ovf0) { ovf = ovf0; continue; }
        if (sy_read_file(p, &b, &n, 1 << 20) || !b || n <= 0) { if (b) free(b); continue; }
        z = realloc(b, (size_t)n + 1); if (!z) { free(b); continue; }
        b = (unsigned char *)z; b[n] = 0;
        ob = strstr((char *)b, "\nowner\t"); opened = wo_num((char *)b, "opened"); deadline = wo_num((char *)b, "deadline");
        if (ob && !strncmp(ob + 7, ow, ol) && ob[7 + ol] == '\n' && wo_num((char *)b, "done") == 0 && opened > 0 && deadline >= opened) {
            F(seen[ns], sizeof seen[0], "%s", id); ns++;
            if (now <= deadline) fprintf(stderr, "TASK_LEFT\tid=%s\tleft_s=%ld\tused_s=%ld\n", id, deadline - now, now - opened);
            else fprintf(stderr, "TASK_OVERDUE\tid=%s\tover_s=%ld\tused_s=%ld\n", id, now - deadline, now - opened);
        }
        free(b);
    }
    free(ib);
}

/* POSIX record locks belong to the process, so a crashed builder cannot strand
 * the next caller. Keep the lock inode: unlinking it would split contenders. */
static int prepare_bin(const char *root, const char *prod, const char *bin, const char *logp, int warm) {
    char path[PW + 16]; long deadline = sy_now_ms() + 30000;
    int fd, i, rc;
    if (snprintf(path, sizeof path, "%s.lock", bin) >= (int)sizeof path) fd = -1;
    else fd = sy_open(path, O_RDWR | O_CREAT, 0600);
    if (fd >= 0) {
        for (i = 0; i <= 300; i++) {
            rc = sy_lockf(fd, 1, 0);
            if (!rc) {
                rc = bin_ok(bin) ? 0 : build(root, prod, bin, logp);
                sy_close(fd);
                return rc;
            }
            if (rc != -EAGAIN && rc != -EACCES) break;
            if (i == 300 || sy_now_ms() >= deadline) break;
            sy_sleep_ms(100);
        }
        sy_close(fd);
    }
    if (bin_ok(bin)) return 0;
    return warm ? -1 : build(root, prod, bin, logp);
}

/* An explicit cache remains useful for test fixtures. The default cache is
 * scoped by Git common directory and the fallback is scoped by worktree. */
static int pin_base(char *out, int cap, const char *override, const char *scope, int working) {
    char home[PW], hash[65];
    if (override && *override) return cx_fmt(out, cap, "%s", override);
    if (!scope[0] || sy_homedir(home, sizeof home) < 0 || sy_sha256_hex(scope, strlen(scope), hash)) return -1;
    return cx_fmt(out, cap, "%s/%s/pinned/%s/%s", home, c_cache, working ? "workcopies" : "repos", hash);
}

static int fallback_path(const char *base, const char *root, char *out, int cap) {
    char real[PW], hash[65];
    if (!fg_common[0] || sy_realpath(root, real, sizeof real) < 0 ||
            sy_sha256_hex(real, strlen(real), hash)) return -1;
    return cx_fmt(out, cap, "%s/good-%s", base, hash);
}

static void fallback_publish(const char *root, const char *path, const char *key, const char *context) {
    char status[8], current[48], row[160];
    char *dirty[15 + MAXSIB] = {"git", "--no-optional-locks", "--literal-pathspecs",
        "status", "--porcelain=v1", "--untracked-files=no", "--",
        c_self, c_lib[0], c_lib[1], c_lib[2], CFG_TABLE, "cxroot.tsv"};
    char *rev[] = {"git", "rev-parse", "--verify", "HEAD", 0};
    for (int i = 0; i < nsib; i++) dirty[13 + i] = sib[i];
    if (runcap(dirty, root, status, sizeof status) || status[0] ||
            runcap(rev, root, current, sizeof current) || strlen(current) != 41 || strncmp(current, hd, 40)) return;
    int n = snprintf(row, sizeof row, "dvlast1\t%s\t%s\t%s", hd, key, context);
    if (n > 0 && n < (int)sizeof row) (void)sy_write_atomic(path, row, n, 0600);
}

static int fallback_pick(const char *root, const char *base, const char *path, const char *context,
                         char *bin, int cap) {
    char row[160], old[41], key[21], exec[PW], seal[PW + 16], quiet[1];
    if (fg_small(path, row, sizeof row) != 134 || strncmp(row, "dvlast1\t", 8) ||
            !fg_hex40(row + 8) || row[48] != '\t' || row[69] != '\t' || strcmp(row + 70, context)) return -1;
    for (int i = 49; i < 69; i++) if (!((row[i] >= '0' && row[i] <= '9') || (row[i] >= 'a' && row[i] <= 'f'))) return -1;
    if (cx_fmt(old, sizeof old, "%.40s", row + 8) ||
        cx_fmt(key, sizeof key, "%.20s", row + 49)) return -1;
    char *ancestry[] = {"git", "merge-base", "--is-ancestor", old, hd, 0};
    if (runcap(ancestry, root, quiet, sizeof quiet) ||
            cx_fmt(exec, sizeof exec, "%s/%s/devsvc", base, key) ||
            cx_fmt(seal, sizeof seal, "%s.sha", exec) || sy_exists(seal) != 1 || !bin_ok(exec)) return -1;
    return cx_fmt(bin, cap, "%s", exec);
}

int main(int argc, char **argv) {
    long launch_begin=sy_now_ms();
    static char root[PW], prod[PW], selfp[PW], real[PW], trees[800], keysrc[2 * PW], base[PW], kd[PW], bin[PW], logp[PW + 16], lg[PW + 80];
    char hex[65], h[4 + MAXSIB][200], *v[260]; const char *dvdir = getenv("DV_PIN_DIR"), *de = getenv("DEVSVC_DEV"); int a = 1, dev = 0, i, n = 0, rc; int64_t psz = 0;
    if (argc > 1 && !strcmp(argv[1], "--")) a = 2;
    if (argc > a && !strcmp(argv[a], "--dev")) { dev = 1; a++; }
    if (de && *de) dev = 1;
    if (argc > a + 1 && !strcmp(argv[a], "git") && !strcmp(argv[a + 1], "push") && argc - a > 250) {
        fprintf(stderr, "GIT_PUSH_REFUSE\treason=too-many-commits\tcount=%d\tmax=44\tnext=devsvc git push --range A..B\n", argc - a - 2);
        return 2;
    }
    if (argc <= a || argc - a > 250) { fprintf(stderr, "usage: devsvc [--dev] <subcommand...>   (pinned to git HEAD unless --dev; subcommands: see tools/devsvc-core.cx header)\n"); return 2; }
    preparing = argc == a + 1 && !strcmp(argv[a], "prebuild-self");
    if (preparing && getenv("DEVSVC_REPO_TABLE_PIN")) {
        sy_unsetenv("DEVSVC_REPO_TABLE");
        sy_unsetenv("DEVSVC_REPO_TABLE_PIN");
    }
    int fromhead = 0, wcfb = 0, memo = 0, fr = -1; char cwd0[PW];
    {   /* 按当前 git 顶层取根(版本工作树一个树一个实例);能不起 git 读出顶层就直接用(fastgit),否则问 git;不在 git 内时退回 cwd */
        char *gv[] = {"git", "rev-parse", "--show-toplevel", 0}; char *nl; const char *ovt;
        if (sy_cwd(cwd0, sizeof cwd0) < 0) return 3;
        F(root, sizeof root, "%s", cwd0);
        fr = fastgit();
        if (fr >= 0) F(root, sizeof root, "%s", fg_top);
        else if (runcap(gv, root, real, sizeof real) == 0 && real[0] == '/') { nl = strchr(real, '\n'); if (nl) *nl = 0; F(root, sizeof root, "%s", real); }
        real[0] = 0;
        {   /* 嵌套继承规则(plans/devsvc.md 第 3 节):外层 devsvc 作业经 UNISACC_FLOW_ROOT_JOB 标记它导出的根;本次根不在该根下(临时根、夹具根)
               就丢弃外层的配置钉与执行体(DEVSVC_REPO_TABLE、DEVSVC_REPO_TABLE_PIN、DEVSVC_SELF_BIN)及等于标记的继承 UNISACC_FLOW_ROOT,按本根重新解析;
               在其下(同仓嵌套)继承照旧。随后把标记改记本根,核心导出 UNISACC_FLOW_ROOT 时再按同一规则校正 */
            const char *j = getenv("UNISACC_FLOW_ROOT_JOB"), *ofr = getenv("UNISACC_FLOW_ROOT"); long jn = j ? (long)strlen(j) : 0;
            if (jn > 0 && !(!strncmp(root, j, jn) && (root[jn] == 0 || root[jn] == '/'))) {
                if (ofr && !strcmp(ofr, j)) unsetenv("UNISACC_FLOW_ROOT");
                unsetenv("DEVSVC_REPO_TABLE"); unsetenv("DEVSVC_REPO_TABLE_PIN"); unsetenv("DEVSVC_SELF_BIN"); unsetenv("UNISACC_FLOW_ROOT_JOB");
                unsetenv("DEVSVC_FG_CWD"); unsetenv("DEVSVC_FG_TOP"); unsetenv("DEVSVC_FG_COMMON"); unsetenv("DEVSVC_FG_HEAD");
            } }
        ovt = getenv("DEVSVC_REPO_TABLE");
        if (fr != 0 && !dev) {
            char rev[80]; char *v[] = {"git", "rev-parse", "--verify", "HEAD", 0};
            if (!runcap(v, root, rev, sizeof rev) && strlen(rev) == 41 && rev[40] == '\n' && fg_hex40(rev))
                F(hd, sizeof hd, "%.40s", rev);
        }
        if (fr == 0 && !dev) F(hd, sizeof hd, "%s", fg_commit);
        {   /* 外层 devsvc 导出的 DEVSVC_REPO_TABLE_PIN=<修订>:<表路径>:与本仓当前 hd 及 DEVSVC_REPO_TABLE 一致且表可读时认作同修订已钉死表
               (照常加载 memo 与 headtab,不降为 headtab_n=0);不一致(如 HEAD 已移动、跨仓继承或 prebuild-self)则清掉外层钉死表与标记 */
            const char *pin = getenv("DEVSVC_REPO_TABLE_PIN"), *c = pin ? strchr(pin, ':') : 0;
            if (pin && *pin) {
                if (!preparing && !dev && fg_hex40(hd) && c && c - pin == 40 && !strncmp(pin, hd, 40) &&
                    ovt && *ovt && !strcmp(c + 1, ovt) && sy_exists(ovt) == 1) {
                    pin_ok = 1;
                } else {
                    if (!ovt || (c && !strcmp(c + 1, ovt))) sy_unsetenv("DEVSVC_REPO_TABLE");
                    sy_unsetenv("DEVSVC_REPO_TABLE_PIN");
                }
            }
            ovt = getenv("DEVSVC_REPO_TABLE");
        }
        if (fr == 0 && !dev && (!(ovt && *ovt) || pin_ok) && memo_load(trees, sizeof trees) == 0) { memo = 1; fromhead = 1; } }

    if (!memo && cfg_load(root, dev, &fromhead)) { fprintf(stderr, "devsvc: repo table unreadable or missing product/self/cache_sub/lib\n"); return 3; }
    F(prod, sizeof prod, "%s/%s", root, c_product); F(selfp, sizeof selfp, "%s/%s", root, c_self);
    /* Only pure list arguments can bypass the working-copy service bootstrap. */
    if (dev && !strcmp(argv[a], "qualify") && argc-a <= 57) {
        int list = 0;
        for (i = a+1; i < argc; i++) {
            if (!strcmp(argv[i], "--list")) list = 1;
            else if ((!strcmp(argv[i], "--ids") || !strcmp(argv[i], "--set") ||
                      !strcmp(argv[i], "--seed") || !strcmp(argv[i], "--jobs") ||
                      !strcmp(argv[i], "--segment-batches")) && i+1 < argc) i++;
            else break;
        }
        if (list && i == argc && !strcmp(c_self, "tools/devsvc-core.cx")) {
            char qp[PW]; F(qp, sizeof qp, "%s/tools/dvqualify.cx", root);
            if (ovf) return 2;
            v[n++]="sh"; v[n++]=prod; v[n++]=qp; v[n++]="--"; v[n++]=root;
            for (i=a+1; i<argc; i++) v[n++]=argv[i];
            v[n]=0;
            rc=run_through(v, 40000);
            if (rc == 124) fprintf(stderr,"devsvc: QUALIFY_LIST_TIMEOUT\n");
            return rc;
        }
    }
    if (!strcmp(argv[a], "bump")) {   /* 版本预留转 tools/bump.cx(工作副本即编即跑,自带锁与 20 s 内有界);本入口外层上限 60 s */
        static char bp[PW]; F(bp, sizeof bp, "%s/tools/bump.cx", root);
        if (ovf) { fprintf(stderr, "dv: path too long\n"); return 2; }
        v[n++] = "sh"; v[n++] = prod; v[n++] = bp; v[n++] = "--"; v[n++] = "--root"; v[n++] = root;
        for (i = a + 1; i < argc; i++) v[n++] = argv[i];
        v[n] = 0;
        return run_through(v, 60000);
    }
    if (!dev) {
        int got = memo;
        if (!got) {
            char *g[9 + MAXSIB]; int k = 0;
            siblings(root, 0);
            g[k++] = "git"; g[k++] = "rev-parse";
            F(h[0], sizeof h[0], "%s:%s", hd, c_self); g[k++] = h[0];
            for (i = 0; i < 3; i++) { F(h[i + 1], sizeof h[0], "%s:%s", hd, c_lib[i]); g[k++] = h[i + 1]; }
            for (i = 0; i < nsib; i++) { F(h[i + 4], sizeof h[0], "%s:%s", hd, sib[i]); g[k++] = h[i + 4]; }
            {   static char ht[200]; F(ht, sizeof ht, "%s:%s", hd, CFG_TABLE); g[k++] = ht; }   /* 配置表进身份 */
            g[k] = 0;
            got = !ovf && runcap(g, root, trees, sizeof trees) == 0;
            if (got) {   /* build archives cxroot.tsv too. An empty listing identifies an absent map. */
                char map[160]; char *ls[] = {"git", "ls-tree", hd, "--", "cxroot.tsv", 0};
                int used = strlen(trees), left = sizeof trees - used;
                int written = -1;
                if (!runcap(ls, root, map, sizeof map)) written = snprintf(trees + used, left, "cxroot\t%s", map);
                got = written >= 0 && written < left;
            }
            if (got && fromhead && fg_commit[0] && !strcmp(hd, fg_commit)) memo_save(trees);   /* 只在全程钉在已知提交号上时记备忘 */
        }
        if (!got || sy_realpath(prod, real, sizeof real) < 0 || sy_file_size(real, &psz)) {
            fprintf(stderr, "dv: no committed %s at HEAD here, using the working copy\n", c_self); dev = 1; wcfb = 1; }
    }
    if (preparing && (dev || !fromhead || !strcmp(hd, "HEAD"))) return 1;
    if (dev && wcfb) {   /* 工作副本退回:按工作副本内容取键,缓存在各根共用的 pinned/wc-<键>/;构造失败才即编即跑 */
        unsigned char *pb = 0; int64_t pn = 0; char ph[65];
        siblings(root, 1);
        if (sy_realpath(prod, real, sizeof real) >= 0 && !sy_read_file(real, &pb, &pn, 1LL << 30) && pb && !sy_sha256_hex(pb, (long)pn, ph) && !wc_key(root, ph, hex)) {
            hex[20] = 0;
            if (!pin_base(base, sizeof base, dvdir, root, 1)) {
                F(kd, sizeof kd, "%s/wc-%s", base, hex); F(bin, sizeof bin, "%s/devsvc", kd); F(logp, sizeof logp, "%s/build.log", kd);
                if (!ovf && (bin_ok(bin) || (!sy_mkdir_all(kd, 0700) && compile_to(prod, selfp, root, bin, logp) == 0))) { dev = 0; fromhead = 0; }
            }
        }
        if (pb) free(pb);
    }
    if (!dev && !wcfb) {
        char context[65], ph[65], cfg[65], pair[132];
        int publish = 0, recover = 0;
        {   /* 产品身份按内容哈希(不含仓路径,跨克隆/工作树共享缓存) */
            if (prod_sha(real, ph) || sy_sha256_hex(headtab, headtab_n, cfg) ||
                    cx_fmt(pair, sizeof pair, "%s\t%s", ph, cfg) ||
                    sy_sha256_hex(pair, strlen(pair), context)) return 3;
            F(keysrc, sizeof keysrc, "%s|%s|%ld|%ld", trees, ph, (long)psz, headtab_n); }

        if (sy_sha256_hex(keysrc, strlen(keysrc), hex)) return 3;
        hex[20] = 0;
        if (pin_base(base, sizeof base, dvdir, fg_common[0] ? fg_common : root, 0)) return 3;
        recover = fromhead && fr == 0 && !strcmp(hd, fg_commit) && !fallback_path(base, root, lg, sizeof lg);
        F(kd, sizeof kd, "%s/%s", base, hex); F(bin, sizeof bin, "%s/devsvc", kd); F(logp, sizeof logp, "%s/build.log", kd);
        if (ovf) { fprintf(stderr, "dv: path too long\n"); return 2; }
        if (!bin_ok(bin)) {
            if (sy_mkdir_all(kd, 0700)) return 3;
            rc = prepare_bin(root, prod, bin, logp, preparing);
            if (preparing && rc) return 1;
            if (rc == 0) publish = 1;
            else {
                if (recover && !fallback_pick(root, base, lg, context, bin, sizeof bin))
                    fprintf(stderr, "dv: HEAD build failed rc=%d (log %s), using last good %s\n", rc, logp, bin);
                else dev = 1;
                if (dev) fprintf(stderr, "dv: HEAD build failed rc=%d (log %s) and no last good build, using the working copy\n", rc, logp);
            }
        }
        if (recover && (publish || preparing)) fallback_publish(root, lg, hex, context);
    }
    if (preparing) {
        char receipt[128], path[PW + 16];
        int len = snprintf(receipt, sizeof receipt, "PREPARED\tkey=%s\tcommit=%s\n", hex, hd);
        if (!bin_ok(bin) || len < 0 || len >= (int)sizeof receipt ||
            snprintf(path, sizeof path, "%s/prepared", kd) >= (int)sizeof path ||
            sy_write_atomic(path, receipt, len, 0600)) return 1;
        printf("%s", receipt);
        return 0;
    }
    unsetenv("DEVSVC_FG_CWD"); unsetenv("DEVSVC_FG_TOP"); unsetenv("DEVSVC_FG_COMMON"); unsetenv("DEVSVC_FG_HEAD");
    if (fr >= 0 && cwd0[0] && fg_top[0]) {
        setenv("DEVSVC_FG_CWD", cwd0, 1); setenv("DEVSVC_FG_TOP", fg_top, 1);
        if (fr == 0 && fg_common[0]) setenv("DEVSVC_FG_COMMON", fg_common, 1);
        if (fr == 0 && fg_commit[0]) setenv("DEVSVC_FG_HEAD", fg_commit, 1);
    }
    if (dev) { v[n++] = "sh"; v[n++] = prod; v[n++] = selfp; v[n++] = "--"; }
    else {
        if (setenv("DEVSVC_SELF_BIN", bin, 1)) return 3;
        if (fromhead) {   /* HEAD 版配置表存进 pinned/<键>/ 并经 DEVSVC_REPO_TABLE 交给核心 */
            char tp[PW + 32]; F(tp, sizeof tp, "%s/devsvc-repo.tsv", kd);
            char pin[PW + 96]; F(pin, sizeof pin, "%s:%s", hd, tp);   /* 告诉核心这张表取自哪个修订(config 输出配置身份用) */
            int same = 0;
            if (!ovf && sy_exists(tp) == 1) {
                unsigned char *eb = 0; int64_t en = 0;
                if (!sy_read_file(tp, &eb, &en, headtab_n + 1) && eb && en == headtab_n && !memcmp(eb, headtab, headtab_n)) same = 1;
                if (eb) free(eb);
            }
            if (ovf || (!same && sy_write_atomic(tp, headtab, headtab_n, 0600)) || setenv("DEVSVC_REPO_TABLE", tp, 1) || setenv("DEVSVC_REPO_TABLE_PIN", pin, 1)) { fprintf(stderr, "dv: cannot stage HEAD repo table\n"); return 3; }
        }
        v[n++] = bin;
    }
    for (i = a; i < argc; i++) v[n++] = argv[i];
    v[n] = 0;
    if(!strcmp(argv[a],"x") || !strcmp(argv[a],"flow") || (!strcmp(argv[a],"git") && a+1<argc && !strcmp(argv[a+1],"commit"))){
        char mark[32];if(!cx_fmt(mark,sizeof mark,"%ld",launch_begin))sy_setenv("DEVSVC_TIMING_BEGIN",mark,1);
    }
    if (!strcmp(argv[a],"x") || !strcmp(argv[a],"qualify")) {
        char owner[32]; sy_spawn_t opts; sy_exit_t st;
        if (cx_fmt(owner,sizeof owner,"%d",sy_pid()) || sy_setenv("DEVSVC_REQUEST_PARENT",owner,1)) return 1;
        sy_spawn_init(&opts); opts.argv=v; opts.pgroup=-1; opts.deadline_ms=3700000;
        fflush(stdout);
        rc=sy_proc_run(&opts,&st) ? 1 : sy_exit_code(&st);
    } else rc = run_through(v, 3700000);
    fflush(stdout); task_left(root, argv[a]);
    return rc;
}
