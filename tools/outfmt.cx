/* tools/outfmt.cx -- ratchet counting hand-written string literals starting with
 * 'TAG\t' for the five structured output formats (RATCHET, RATCHETS, BATCH_RUN,
 * MATERIAL, DEFERRED, strict row header) in tracked .cx files outside tools/cxlib/
 * and archive/. Only allows decrease; read failures are explicit errors.
 *
 *   sh ./unisacc.com tools/outfmt.cx -- --check
 *   sh ./unisacc.com tools/outfmt.cx -- --write-baseline
 *   sh ./unisacc.com tools/outfmt.cx -- --check-file PATH BASELINE_TSV
 */
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sysx.process
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use mem.heap

#define BASE "build/outfmt-prefix-baseline.tsv"

/* Match any C string literal starting with "TAG\t (whether followed by closing quote or more text,
 * e.g. "BATCH_RUN\tid=", "RATCHET\t%s", "DEFERRED\t"). Constructed via cx_fmt so this file
 * contains no raw literal hits itself. */
static int has_fmt_literal_prefix(const char *s, long n) {
    char pat[32];
    if (!cx_fmt(pat, sizeof pat, "\"%s\\t", "RATCHET") && tx_find(s, n, pat, tx_len(pat, sizeof pat)) >= 0) return 1;
    if (!cx_fmt(pat, sizeof pat, "\"%s\\t", "RATCHETS") && tx_find(s, n, pat, tx_len(pat, sizeof pat)) >= 0) return 1;
    if (!cx_fmt(pat, sizeof pat, "\"%s\\t", "BATCH_RUN") && tx_find(s, n, pat, tx_len(pat, sizeof pat)) >= 0) return 1;
    if (!cx_fmt(pat, sizeof pat, "\"%s\\t", "MATERIAL") && tx_find(s, n, pat, tx_len(pat, sizeof pat)) >= 0) return 1;
    if (!cx_fmt(pat, sizeof pat, "\"%s\\t", "DEFERRED") && tx_find(s, n, pat, tx_len(pat, sizeof pat)) >= 0) return 1;
    if (!cx_fmt(pat, sizeof pat, "\"%s\\t%s\\t", "batch", "domain") && tx_find(s, n, pat, tx_len(pat, sizeof pat)) >= 0) return 1;
    return 0;
}

static long count_file(const char *path) {
    size_t sz = 0;
    char *b = (char *)cx_read(path, &sz);
    long at = 0, hits = 0;
    int in_blk = 0;
    if (!b) return -1;
    while (at < (long)sz) {
        long e = tx_chr(b + at, (long)sz - at, '\n'), ln = e < 0 ? (long)sz - at : e;
        const char *l = b + at;
        long p = 0;
        while (p < ln && (l[p] == ' ' || l[p] == '\t')) p++;
        if (in_blk) {
            long c = tx_find(l, ln, "*/", 2);
            if (c >= 0) in_blk = 0;
            at += ln + 1;
            continue;
        }
        if (ln - p >= 2 && l[p] == '/' && l[p + 1] == '/') { at += ln + 1; continue; }
        if (ln - p >= 2 && l[p] == '/' && l[p + 1] == '*') {
            if (tx_find(l + p + 2, ln - p - 2, "*/", 2) < 0) in_blk = 1;
            at += ln + 1;
            continue;
        }
        if (has_fmt_literal_prefix(l + p, ln - p)) hits++;
        at += ln + 1;
    }
    mm_free(b);
    return hits;
}

static long base_of(const char *b, long n, const char *f, long fl) {
    long at = 0;
    while (b && at < n) {
        long e = tx_chr(b + at, n - at, '\n'), ln = e < 0 ? n - at : e, t = tx_chr(b + at, ln, '\t');
        if (t == fl && tx_same(b + at, fl, f, fl) && b[at] != '#') {
            long v = 0, j;
            for (j = t + 1; j < ln && b[at + j] >= '0' && b[at + j] <= '9'; j++) v = v * 10 + (b[at + j] - '0');
            return v;
        }
        at += ln + 1;
    }
    return -1;
}

static int excluded(const char *p, long n) {
    if (tx_prefix(p, n, "tools/cxlib/", 12)) return 1;
    if (tx_prefix(p, n, "archive/", 8)) return 1;
    if (tx_eqz(p, "tools/outfmt.cx")) return 1;
    return 0;
}

int main(int argc, char **argv) {
    static char list[1 << 20];
    int wb = 0;
    long r, at = 0, files = 0, total = 0, over = 0;
    size_t bn = 0;
    char *base = 0;

    if (argc == 4 && tx_eqz(argv[1], "--check-file")) {
        long c = count_file(argv[2]), b;
        base = (char *)cx_read(argv[3], &bn);
        if (c < 0 || !base) { fprintf(stderr, "outfmt-prefix: cannot read inputs\n"); return 2; }
        b = base_of(base, (long)bn, argv[2], tx_len(argv[2], 4096));
        if (c > b && c > 0) {
            printf("outfmt-prefix: %s has %ld hits, baseline %ld\n", argv[2], c, b < 0 ? 0 : b);
            printf("outfmt-prefix: FAIL: files=1 hits=%ld over=1\n", c);
            return 1;
        }
        printf("outfmt-prefix: ok: files=1 hits=%ld over=0\n", c);
        return 0;
    }

    if (argc != 2 || (!tx_eqz(argv[1], "--check") && !tx_eqz(argv[1], "--write-baseline"))) {
        fprintf(stderr, "usage: tools/outfmt.cx --check | --write-baseline | --check-file PATH BASELINE\n");
        return 2;
    }
    wb = tx_eqz(argv[1], "--write-baseline");
    {
        char *gv[] = {"git", "ls-files", "--", "*.cx", 0};
        np_result nr; char why[128];
        if (np_run(gv, 0, 0, 30, &nr, why, sizeof why) != 0 || nr.rc != 0) {
            np_free(&nr);
            fprintf(stderr, "outfmt-prefix: git ls-files failed\n");
            return 2;
        }
        r = (long)nr.outn < (long)sizeof list - 1 ? (long)nr.outn : (long)sizeof list - 1;
        if (r > 0 && nr.out) (void)mm_copy(list, sizeof list, nr.out, (size_t)r);
        list[r] = 0;
        np_free(&nr);
    }
    base = wb ? 0 : (char *)cx_read(BASE, &bn);
    if (!wb && !base) { printf("outfmt-prefix: FAIL: cannot read %s\n", BASE); return 1; }
    if (wb) printf("# outfmt-prefix baseline: FILE<TAB>HITS of hand-written outfmt string literals outside tools/cxlib/ (only goes down)\n");
    while (at < r) {
        long e = tx_chr(list + at, r - at, '\n'), ln = e < 0 ? r - at : e;
        if (ln > 0 && ln < 1024) {
            char p[1024];
            tx_copy(p, sizeof p, list + at, ln); p[ln] = 0;
            if (!excluded(p, ln)) {
                long c = count_file(p);
                if (c < 0) {
                    fprintf(stderr, "outfmt-prefix: cannot read %s\n", p);
                    return 2;
                }
                if (c > 0) {
                    files++; total += c;
                    if (wb) printf("%s\t%ld\n", p, c);
                    else {
                        long b = base_of(base, (long)bn, p, ln);
                        if (c > b) {
                            over++;
                            printf("outfmt-prefix: %s has %ld hits, baseline %ld\n", p, c, b < 0 ? 0 : b);
                        }
                    }
                }
            }
        }
        at += ln + 1;
    }
    if (wb) return 0;
    printf("outfmt-prefix: %s: files=%ld hits=%ld over=%ld (use tools/cxlib/outfmt.cx)\n", over ? "FAIL" : "ok", files, total, over);
    return over ? 1 : 0;
}
