/* tools/check-tapeslice_contract.cx -- check tape.tapeslice_contract module exported helpers and validators. */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use tape.tapeslice_contract

static int g_pass = 0;
static int g_fail = 0;

static void ck(int ok, const char *name) {
    if (ok) { g_pass++; sy_printf("PASS\tcheck-tapeslice_contract.%s\n", name); }
    else { g_fail++; sy_printf("FAIL\tcheck-tapeslice_contract.%s\n", name); }
}

int main(void) {
    char why[64];
    size_t n = 0;
    char *slots = (char *)cx_read("tools/tape/facts/hoststub-slots.tsv", &n);
    unsigned char bad[16];
    int i;
    ts_wr_u(bad, 4, 0x04030201ull);
    ck(ts_rd_u(bad, 4) == 0x04030201ull, "le-u32-roundtrip");
    why[0] = 0;
    ck(slots != 0 && n > 0 && ts_validate_host_table(slots, (long)n, why, (long)sizeof why) == 0, "host-table-validated");
    if (slots) mm_free(slots);
    for (i = 0; i < (int)sizeof bad; i++) bad[i] = 0;
    why[0] = 0;
    ck(ts_validate_container(bad, (long)sizeof bad, why, (long)sizeof why) != 0, "short-container-rejected");
    sy_printf("CHECK_TAPESLICE_CONTRACT\tpassed=%d\tfailed=%d\n", g_pass, g_fail);
    return g_fail ? 1 : 0;
}
