/* DEV_ONLY unsigned code cache, never a test-result or product qualification.
 * Build with -DDEV_RUN_SOURCE_SHA='"actual tools/dev-run.cx SHA256"'.
 * CLI ROOT [--opt=0|--opt=2] SOURCE.cx [-- PROGRAM_ARGS...]. Linux/x86_64.
 * On a cache miss the installed product (/bin/sh ROOT/unisacc.com, its embedded package
 * unless UNISACC_DEV_MODELS names one) writes a standard native ELF; the product bytes,
 * shell, package, options, environment, -cx-plan module closure and include tree all
 * enter the key, so any change is a miss. A complete external byte namespace covers all compile inputs. Unsealed attempts
 * are never reused. Inputs must be quiescent: before/after checks are not an
 * atomic snapshot or protection against a malicious same-user ABA mutation.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.kernelsha
#pragma unisa use text.text
#ifndef DEV_RUN_SOURCE_SHA
#define DEV_RUN_SOURCE_SHA "NOT_COMPILED_WITH_SOURCE_IDENTITY"
#endif
static const char *np_pin="fa5ec4702ac0ee4216edc8085f5d3e4b4ae53aed05ac2a4a308f64c0d2e51660";
static const char *ks_pin="8ad60f9004f98b6bd68397668e1c6feabe468bb5be4b5ec9aedc4494aa541e31";
static unsigned long long physical_reads;
static int uncached,tree_entries;
static void bad(const char *s){fprintf(stderr,"dev-run: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void path(char out[4400],const char *a,const char *b){int n=snprintf(out,4400,"%s/%s",a,b);if(n<0||n>=4400)bad("path-bound");}
static void field(np_buf *b,const char *s){np_putll(b,(long long)strlen(s));np_puts(b,":");np_puts(b,s);np_puts(b,"\n");}
static void num(np_buf *b,long long n){np_putll(b,n);np_puts(b,"\n");}
static void hash(const void *p,size_t n,char h[65]){if(n>=1024){if(ks_sha256_hex(p,n,h))bad("kernel-sha256");}else cx_sha256_hex(p,n,h);}
static int same(const struct stat *a,const struct stat *b){return a->st_dev==b->st_dev&&a->st_ino==b->st_ino&&a->st_size==b->st_size&&a->st_mode==b->st_mode&&a->st_mtime==b->st_mtime&&a->st_ctime==b->st_ctime;}
static char *read_actual(const char *p,size_t *n,struct stat *out){struct stat a,b,c;if(lstat(p,&a)||!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>134217728)bad("bounded-regular-file");int fd=open(p,O_RDONLY|O_NOFOLLOW|O_CLOEXEC|O_NONBLOCK);if(fd<0||fstat(fd,&b)||!same(&a,&b))bad("file-open-identity");char *s=malloc((size_t)a.st_size+1);if(!s)bad("allocation");size_t at=0;while(at<(size_t)a.st_size){ssize_t z=read(fd,s+at,(size_t)a.st_size-at);if(z<0&&errno==EINTR)continue;if(z<=0)bad("file-read");at+=(size_t)z;}char x;ssize_t z;do{z=read(fd,&x,1);}while(z<0&&errno==EINTR);int changed=fstat(fd,&b)||lstat(p,&c)||!same(&a,&b)||!same(&a,&c);int closed=close(fd);if(z||changed||closed)bad("file-changed-or-close");s[at]=0;*n=at;if(out)*out=a;physical_reads++;return s;}
static int explicit_include(const char *s,size_t n){for(size_t i=0;i+1<n;i++)if((s[i]=='?'&&s[i+1]=='?')||(s[i]=='%'&&s[i+1]==':')||(i+13<=n&&!memcmp(s+i,"__has_include",13)))return 1;np_buf b={0};for(size_t i=0;i<n;i++){if(s[i]=='\\'&&i+1<n&&s[i+1]=='\n'){i++;continue;}if(s[i]=='\\'&&i+2<n&&s[i+1]=='\r'&&s[i+2]=='\n'){i+=2;continue;}np_put(&b,s+i,1);}int found=0;size_t at=0;while(at<b.n){size_t end=at;while(end<b.n&&b.p[end]!='\n')end++;size_t q=at;while(q<end&&(b.p[q]==' '||b.p[q]=='\t'||b.p[q]=='\v'||b.p[q]=='\f'||b.p[q]=='\r'))q++;if(q<end&&b.p[q]=='#'){q++;while(q<end&&(b.p[q]==' '||b.p[q]=='\t'||b.p[q]=='\v'||b.p[q]=='\f'||b.p[q]=='\r'))q++;if(q<end&&b.p[q]=='/')found=1;if(end-q>=7&&!memcmp(b.p+q,"include",7))found=1;}at=end+1;}free(b.p);return found;}
static void file(np_buf *b,const char *p,int scan){struct stat a,c;char resolved[4400],literal[4400];field(b,p);if(lstat(p,&a))bad("input-lstat");num(b,(long long)(a.st_mode&07777));if(S_ISLNK(a.st_mode)){ssize_t n=readlink(p,literal,sizeof literal-1);if(n<0||n>=(ssize_t)sizeof literal-1)bad("link-bound");literal[n]=0;field(b,"symlink");field(b,literal);if(!realpath(p,resolved))bad("link-resolve");}else{if(!S_ISREG(a.st_mode))bad("input-not-regular");if(!realpath(p,resolved))bad("input-resolve");field(b,"regular");}field(b,resolved);size_t n;struct stat st;char *s=read_actual(resolved,&n,&st);char h[65];hash(s,n,h);num(b,(long long)n);num(b,(long long)(st.st_mode&07777));field(b,h);if(scan&&explicit_include(s,n))uncached=1;free(s);if(lstat(p,&c)||!same(&a,&c))bad("input-link-changed");}
static int strings(const void *a,const void *b){return strcmp(*(char *const *)a,*(char *const *)b);}
static char **children(const char *p,int *count){DIR *d=opendir(p);if(!d)bad("directory-open");char **v=0;int n=0;for(;;){errno=0;struct dirent *e=readdir(d);if(!e){int saved=errno,closed=closedir(d);if(saved||closed)bad("directory-read-close");break;}if(tx_eq(e->d_name, ".", 1L << 20)||tx_eq(e->d_name, "..", 1L << 20))continue;if(n==8192)bad("directory-count-bound");char **w=realloc(v,(size_t)(n+1)*sizeof *v);if(!w)bad("allocation");v=w;v[n]=strdup(e->d_name);if(!v[n])bad("allocation");n++;}qsort(v,(size_t)n,sizeof *v,strings);*count=n;return v;}
static void tree(np_buf *b,const char *p,int depth){if(depth>32||++tree_entries>8192)bad("tree-bound");struct stat a,c;if(lstat(p,&a))bad("tree-stat");if(!S_ISDIR(a.st_mode)){file(b,p,0);return;}field(b,p);field(b,"directory");num(b,(long long)(a.st_mode&07777));int n;char **v=children(p,&n);num(b,n);for(int i=0;i<n;i++){char q[4400];path(q,p,v[i]);tree(b,q,depth+1);free(v[i]);}free(v);if(lstat(p,&c)||!same(&a,&c))bad("directory-changed");}
static void pinned(np_buf *b,const char *p,const char *expected){size_t n;char *s=read_actual(p,&n,0);char h[65];hash(s,n,h);free(s);if(strcmp(h,expected))bad("compiled-source-or-native-pin");field(b,p);field(b,h);}
static void canonical(const char *p,char out[4400]){if(!realpath(p,out))bad("canonical-path");}
static void plan(np_buf *b,char **v,const char *inc,const char *cwd){np_result r={0};char why[1200];if(np_run(v,cwd,0,10,&r,why,sizeof why)||r.rc||r.errn||!r.outn||r.outn>1048576||memchr(r.out,0,r.outn)||memchr(r.out,'\r',r.outn)||r.out[r.outn-1]!='\n')bad("incomplete-cx-plan");field(b,r.out);char *at=r.out;int units=0;while(*at){char *end=strchr(at,'\n');*end=0;char *tab=strchr(at,'\t');if(!tab)bad("plan-row");*tab=0;char index[20];snprintf(index,sizeof index,"%d",units);if(strcmp(at,index)||++units>256)bad("plan-index-or-unit-bound");if(units>16)uncached=1;at=tab+1;int col=0;for(;;){tab=strchr(at,'\t');if(tab)*tab=0;if(!*at||strlen(at)>=4400)bad("plan-empty-or-long-field");char p[4400];if(tx_eq(at, "cx.h", 1L << 20))path(p,inc,"cx.h");else if(at[0]=='/')snprintf(p,sizeof p,"%s",at);else path(p,cwd,at);file(b,p,col==0);col++;if(!tab)break;at=tab+1;}if(col<2)bad("plan-cx-prelude-missing");at=end+1;}if(!units)bad("empty-plan");np_free(&r);}
static char **compiler_environment(char **caller){size_t n=0;for(char **p=caller;*p;p++)if(++n>65536)bad("environment-count");char **v=calloc(n+2,sizeof *v);if(!v)bad("allocation");size_t k=0;for(char **p=caller;*p;p++)if(strncmp(*p,"UNISACC_E3CACHE=",16)&&strncmp(*p,"UNISACC_RUN_CACHE=",18))v[k++]=*p;v[k++]="UNISACC_RUN_CACHE=0";return v;}
static void environment(np_buf *b){np_buf e={0};for(char **p=environ;*p;p++){
 /* The outer bound sets a fresh absolute deadline for every invocation.
  * It still reaches the inner watchdog; its value cannot change successful
  * compiler output and must not make every warm lookup cold. */
 if(!strncmp(*p,"UNISACC_BOUND_DEADLINE_MONO=",28)||
    !strncmp(*p,"CODEX_TOOL_CALL_ID=",19)||
    !strncmp(*p,"_=",2))continue;
 /* Exact agent-session names whose values change between agent turns (effort, job dir,
  * messaging token...). No getenv in exec/c, src, seed, include or the APE shell header
  * (HOME, TMPDIR, XDG_CACHE_HOME) reads them; every other variable stays in the key. */
 static const char *const session[]={"AI_AGENT=","CLAUDECODE=","CLAUDE_PID=","CLAUDE_EFFORT=","CLAUDE_JOB_DIR=",
  "CLAUDE_CODE_SESSION_ID=","CLAUDE_CODE_CHILD_SESSION=","CLAUDE_CODE_SESSION_ATTENDED=","CLAUDE_CODE_ENTRYPOINT=",
  "CLAUDE_CODE_EXECPATH=","CLAUDE_CODE_MESSAGING_SOCKET=","CLAUDE_CODE_MESSAGING_TOKEN=",0};
 int skip=0;for(int i=0;session[i];i++)if(!strncmp(*p,session[i],strlen(session[i])))skip=1;
 if(skip)continue;
 field(&e,*p);
 }char h[65];hash(e.p,e.n,h);field(b,"compiler-output-environ-sha256");field(b,h);free(e.p);}
static void manifest(char h[65],const char *root,const char *product,const char *shell,const char *pkg,const char *inc,const char *bound,const char *cwd,char **command,char **planv){np_buf b={0};uncached=0;tree_entries=0;field(&b,"dev-run-product-elf-namespace-v3;DEV_ONLY;byte-hybrid1024;no-verdict-cache");field(&b,root);field(&b,cwd);char p[4400];path(p,root,"tools/dev-run.cx");pinned(&b,p,DEV_RUN_SOURCE_SHA);path(p,root,"tools/cxlib/netpack.cx");pinned(&b,p,np_pin);path(p,root,"tools/cxlib/kernelsha.cx");pinned(&b,p,ks_pin);file(&b,product,0);file(&b,shell,0);if(*pkg)file(&b,pkg,0);else field(&b,"embedded-package");file(&b,bound,0);for(int i=0;command[i];i++)field(&b,command[i]);environment(&b);plan(&b,planv,inc,cwd);tree(&b,inc,0);hash(b.p,b.n,h);free(b.p);}
static void private_dir(const char *p,int create){struct stat st;errno=0;if(lstat(p,&st)){if(errno!=ENOENT||!create||mkdir(p,0700)||lstat(p,&st))bad("private-directory-create");}if(!S_ISDIR(st.st_mode)||st.st_uid!=getuid()||(st.st_mode&07777)!=0700)bad("private-directory-owner-mode");}
/* A seal covers every blob byte, name, mode and size; no program rc/output.
 * Only this leaf inventory is admitted. Symlinks/directories never enter it. */
static int inventory(const char *dir,char h[65]){private_dir(dir,0);int n;char **v=children(dir,&n);int allowed=n==1&&tx_eq(v[0], "program.elf", 1L << 20);for(int i=0;i<n;i++)free(v[i]);free(v);if(!allowed)return -1;char p[4400];path(p,dir,"program.elf");struct stat st;errno=0;if(lstat(p,&st)){if(errno!=ENOENT)bad("cache-file-stat");return -1;}if(!S_ISREG(st.st_mode)||st.st_uid!=getuid()||(st.st_mode&07777)!=0700||st.st_size<64||st.st_size>134217728)return -1;size_t z;char *s=read_actual(p,&z,&st);unsigned char *u=(unsigned char *)s;int elf=u[0]==127&&u[1]=='E'&&u[2]=='L'&&u[3]=='F'&&u[4]==2&&u[5]==1&&u[6]==1&&(u[16]==2||u[16]==3)&&u[17]==0&&u[18]==62&&u[19]==0&&u[20]==1&&u[21]==0&&u[22]==0&&u[23]==0&&u[52]==64&&u[53]==0;char x[65];hash(s,z,x);free(s);if(!elf||access(p,X_OK))return -1;np_buf b={0};field(&b,"dev-run-native-elf-inventory-v2");field(&b,"program.elf");num(&b,(long long)z);num(&b,(long long)(st.st_mode&07777));field(&b,x);hash(b.p,b.n,h);free(b.p);return 1;}
static int hex(const char *p){for(int i=0;i<64;i++)if(!((p[i]>='0'&&p[i]<='9')||(p[i]>='a'&&p[i]<='f')))return 0;return p[64]==0;}
static int warm(const char *ns,char dir[4400],char expected[65]){char p[4400];path(p,ns,"entry.tsv");struct stat st;errno=0;if(lstat(p,&st)){if(errno==ENOENT)return 0;bad("seal-stat");}if(!S_ISREG(st.st_mode)||st.st_uid!=getuid()||(st.st_mode&07777)!=0600||st.st_size>256)return 0;size_t n;char *s=read_actual(p,&n,0);int good=0;if(n>=24&&s[n-1]=='\n'&&!memchr(s,0,n)&&!memchr(s,'\r',n)&&!strncmp(s,"dev-run-seal-v1\nattempt\t",24)){char *a=s+24,*end=strchr(a,'\n');if(end){*end=0;char *q=end+1;if(!strncmp(q,"inventory\t",10)){q+=10;char *nl=strchr(q,'\n');if(nl&&nl[1]==0){*nl=0;if(!strncmp(a,"attempt-",8)&&strlen(a)==14&&strspn(a+8,"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")==6&&strlen(q)==64&&hex(q)){path(dir,ns,a);strcpy(expected,q);good=1;}}}}}free(s);if(!good)return 0;struct stat ds;errno=0;if(lstat(dir,&ds)){if(errno==ENOENT)return 0;bad("sealed-attempt-stat");}if(!S_ISDIR(ds.st_mode)||ds.st_uid!=getuid()||(ds.st_mode&07777)!=0700)return 0;char actual[65];int count=inventory(dir,actual);return count==1&&tx_eq(actual, expected, 1L << 20);}
static void seal(const char *ns,const char *dir,const char *h){char p[4400],tmp[4400];path(p,ns,"entry.tsv");int z=snprintf(tmp,sizeof tmp,"%s/entry-%d.tmp",ns,(int)getpid());if(z<0||z>=(int)sizeof tmp)bad("seal-path");const char *base=strrchr(dir,'/');if(!base)bad("attempt-name");np_buf b={0};np_puts(&b,"dev-run-seal-v1\nattempt\t");np_puts(&b,base+1);np_puts(&b,"\ninventory\t");np_puts(&b,h);np_puts(&b,"\n");int fd=open(tmp,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)bad("seal-open");size_t at=0;while(at<b.n){ssize_t w=write(fd,b.p+at,b.n-at);if(w<0&&errno==EINTR)continue;if(w<=0)bad("seal-write");at+=(size_t)w;}int synced=fsync(fd),closed=close(fd);if(synced||closed||rename(tmp,p))bad("seal-sync-close-rename");free(b.p);}
static int execute(char **v,const char *root){pid_t p=fork();if(p<0)bad("fork");if(!p){if(chdir(root))_exit(126);execv(v[0],v);_exit(127);}int status;pid_t w;do{w=waitpid(p,&status,0);}while(w<0&&errno==EINTR);if(w!=p)bad("waitpid");if(WIFEXITED(status))return WEXITSTATUS(status);if(WIFSIGNALED(status))return 128+WTERMSIG(status);bad("child-status");return 2;}
int main(int argc,char **argv){
#if defined(__linux__) && defined(__x86_64__)
 if(argc<3)bad("usage ROOT [--opt=0|--opt=2] SOURCE.cx [-- PROGRAM_ARGS]");
 char root[4400],native[4400],pkg[4400],inc[4400],src[4400],bound[4400],cwd[4400];
 canonical(argv[1],root);if(!getcwd(cwd,sizeof cwd))bad("caller-cwd");
 int at=2;char *opt="-O0";
 if(tx_eq(argv[at], "--opt=0", 1L << 20)||tx_eq(argv[at], "--opt=2", 1L << 20)){opt=argv[at][6]=='2'?"-O2":"-O0";if(++at>=argc)bad("source-required");}
 const char *source=argv[at++];size_t sn=strlen(source);
 if(sn<3||strcmp(source+sn-3,".cx")||source[0]=='-')bad("only-cx-source");
 if(sn>=sizeof src)bad("source-path-bound");memcpy(src,source,sn+1);
 if(at<argc&&strcmp(argv[at++],"--"))bad("program-arguments-require-separator");
 path(native,root,"unisacc.com");char *shell="/bin/sh";pkg[0]=0;
 const char *e=getenv("UNISACC_DEV_MODELS");if(e&&*e)canonical(e,pkg);
 e=getenv("UNISACC_DEV_INCLUDE");if(e&&*e)canonical(e,inc);else path(inc,root,"include");path(bound,root,"tools/bound");
 char k[65];if(ks_sha256_hex("",0,k)||strcmp(k,"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")||ks_sha256_hex("abc",3,k)||strcmp(k,"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"))bad("kernel-sha-selfcheck");
 char **caller_environ=environ;environ=compiler_environment(caller_environ);
 /* Only compiler options enter the key. The output role is stable; the actual
  * fresh attempt path and all runtime program arguments never enter it. */
 char *role="fresh-output-role/program.elf";
 char *command[16],*planv[12];int c=0,p=0;
 command[c++]=bound;command[c++]="40";command[c++]=shell;command[c++]=native;
 planv[p++]=bound;planv[p++]="8";planv[p++]=shell;planv[p++]=native;
 if(*pkg){command[c++]="--models";command[c++]=pkg;planv[p++]="--models";planv[p++]=pkg;}
 command[c++]="-I";command[c++]=inc;command[c++]=opt;command[c++]="-b";command[c++]="lnx/x86_64";command[c++]=src;command[c++]="-o";
 int out_at=c;command[c++]=role;command[c]=0;
 planv[p++]="-I";planv[p++]=inc;planv[p++]="-cx-plan";planv[p++]=src;planv[p]=0;
 char before[65],after[65];manifest(before,root,native,shell,pkg,inc,bound,cwd,command,planv);int no_cache=uncached;
 char cache[4400],ns[4400],attempt[4400],sealed[65],program[4400];
 path(cache,root,"out/c43-cxcache-product-cache");private_dir(cache,1);path(ns,cache,before);private_dir(ns,1);
 int hit=!no_cache&&warm(ns,attempt,sealed);
 if(!hit){path(attempt,ns,"attempt-XXXXXX");if(!mkdtemp(attempt))bad("fresh-attempt");private_dir(attempt,0);}
 path(program,attempt,"program.elf");
 fprintf(stderr,"DEV_RUN\tDEV_ONLY\tcache=%s\tnamespace=%s\n",no_cache?"BYPASS-input-scope":hit?"SEALED":"COLD",before);
 if(!hit){
  command[out_at]=program;int rc=execute(command,cwd);command[out_at]=role;
  if(rc)return rc;
  manifest(after,root,native,shell,pkg,inc,bound,cwd,command,planv);
  if(strcmp(before,after)||uncached!=no_cache)bad("inputs-changed-during-compilation");
  struct stat st;if(lstat(program,&st)||!S_ISREG(st.st_mode)||st.st_uid!=getuid())bad("compiler-output-not-regular-owned");
  if(chmod(program,0700))bad("compiler-output-mode");
  char blobs[65];if(inventory(attempt,blobs)!=1)bad("invalid-native-elf-output");
  if(!no_cache)seal(ns,attempt,blobs);
 }
 /* Program execution begins only after compile input and full ELF validation.
  * Its fresh argv and original environment/stdin/cwd are never cached. */
 char **program_argv=calloc((size_t)(argc-at)+2,sizeof *program_argv);if(!program_argv)bad("allocation");
 int n=0;program_argv[n++]=src;for(;at<argc;at++)program_argv[n++]=argv[at];
 environ=caller_environ;
 fprintf(stderr,"DEV_RUN\tDEV_ONLY\tphysical_reads=%llu\tprogram-exec\n",physical_reads);
 execv(program,program_argv);bad("native-program-exec");return 2;
#else
 fputs("dev-run: requires Linux/x86_64\n",stderr);return 2;
#endif
}
