/* tools/register-fixture-slow.cx -- the failing, slow batch of tools/check-register.cx's dirty-rollback case.
 * It never prints the registered marker, so its batch FAILs, and it takes long enough that the check can take
 * the registry lock before tools/register.cx's rollback reaches it.  Not registered as a batch itself. */
#pragma unisa use sys.time
int main(void) {
    sy_sleep_ms(700);
    printf("REGISTER_FIXTURE_SLOW_DONE\n");
    return 0;
}
