/* Independent container/symbol fixtures. Does not qualify any compiler candidate. */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.time
static int checks,bad;static long until;static char temp[4400],exe[4400],root[4096];
static void die(const char*s){fprintf(stderr,"check-prune-route-placement: %s\n",s);exit(2);}static void ck(int ok,const char*s){checks++;bad+=!ok;printf("%s\t%s\n",ok?"PASS":"FAIL",s);}static void path(char*p,size_t cap,const char*a,const char*b){if(cx_fmt(p,cap,"%s/%s",a,b))die("path");}static void set(unsigned char*p,int width,unsigned long long v){for(int i=0;i<width;i++){p[i]=(unsigned char)v;v>>=8;}}
static void save(const char*p,const unsigned char*b,size_t n){if(cx_write(p,b,n))die("write fixture");}
static np_result run(char**v,int sec){long left=until-sy_now_ms();if(sec>left/1000)sec=left/1000;if(sec<1)die("whole deadline");np_result r={0};char why[1000];if(np_run(v,root,0,sec,&r,why,sizeof why)||r.residue)die(why);return r;}
static void oracle(const char*file,const char*target,int expected,const char*label){char*v[]={exe,"--oracle",(char*)file,(char*)target,"ext_f",0};np_result r=run(v,3);ck(r.rc==expected&&r.out&&strstr(r.out,"PRUNE_OBJECT_ORACLE"),label);if(r.rc!=expected&&r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);}
static size_t elf(unsigned char*b,int arm){memset(b,0,512);b[0]=127;b[1]='E';b[2]='L';b[3]='F';b[4]=2;b[5]=1;b[6]=1;set(b+16,2,1);set(b+18,2,arm?183:62);set(b+20,4,1);set(b+40,8,256);set(b+52,2,64);set(b+58,2,64);set(b+60,2,4);b[64]=0xc3;const char names[]="\0ext_f\0main\0";for(size_t i=0;i<sizeof names;i++)b[80+i]=names[i];set(b+128,4,1);b[132]=0x12;set(b+134,2,1);set(b+152,4,7);b[156]=0x12;set(b+158,2,1);set(b+320+4,4,1);set(b+320+8,8,6);set(b+320+24,8,64);set(b+320+32,8,1);set(b+384+4,4,3);set(b+384+24,8,80);set(b+384+32,8,sizeof names);set(b+448+4,4,2);set(b+448+24,8,104);set(b+448+32,8,72);set(b+448+40,4,2);set(b+448+56,8,24);return 512;}
static size_t unit(unsigned char*b,const char*target,int missingglobal){memset(b,0,4096);const char*body=missingglobal?".unit 2\n; .global ext_f\next_f:\n.global main\nmain:\n":".unit 2\n.global ext_f\next_f:\n.global main\nmain:\n";char wire[1000];if(cx_fmt(wire,sizeof wire,"UNISATAPE1 %s %zu\n%s",target,strlen(body),body))die("wire");size_t n=strlen(wire),off,total=0;int arm=strstr(target,"arm64")!=0;if(!strncmp(target,"lnx/",4)){off=64;total=704;b[0]=127;b[1]='E';b[2]='L';b[3]='F';b[4]=2;b[5]=1;b[6]=1;set(b+16,2,1);set(b+18,2,arm?183:62);set(b+20,4,1);set(b+40,8,512);set(b+52,2,64);set(b+58,2,64);set(b+60,2,3);set(b+62,2,2);const char names[]="\0.unisa.tape\0.shstrtab\0";for(size_t i=0;i<sizeof names;i++)b[384+i]=names[i];set(b+576,4,1);set(b+580,4,1);set(b+600,8,off);set(b+608,8,n);set(b+640,4,13);set(b+644,4,3);set(b+664,8,384);set(b+672,8,sizeof names);}else if(!strncmp(target,"osx/",4)){off=184;set(b,4,0xfeedfacf);set(b+4,4,arm?0x100000c:0x1000007);set(b+12,4,1);set(b+16,4,1);set(b+20,4,152);set(b+32,4,25);set(b+36,4,152);set(b+96,4,1);const char*a="__unisa_tape",*c="__UNISA";for(size_t i=0;i<strlen(a);i++)b[104+i]=a[i];for(size_t i=0;i<strlen(c);i++)b[120+i]=c[i];set(b+144,8,n);set(b+152,4,184);}else{off=60;set(b,2,arm?0xaa64:0x8664);set(b+2,2,1);const char*a=".unisatp";for(int i=0;i<8;i++)b[20+i]=a[i];set(b+36,4,n);set(b+40,4,60);}for(size_t i=0;i<n;i++)b[off+i]=wire[i];return total?total:off+n;}
int main(int argc,char**argv){if(argc!=2||!realpath(argv[1],root))return 2;until=sy_now_ms()+45000;char t[]="/tmp/prune-placement-check-XXXXXX";if(!mkdtemp(t)||!realpath(t,temp))die("temp");char source[4400],self[4096],com[4400],p[4400];if(!realpath(__FILE__,self))die("source");char*slash=strrchr(self,'/');if(!slash)die("source path");*slash=0;path(source,sizeof source,self,"prune-route-placement.cx");path(com,sizeof com,root,"unisacc.com");path(exe,sizeof exe,temp,"tool");char*build[]={"sh",com,source,"-o",exe,0};np_result r=run(build,25);ck(!r.rc,"compile current extended tool");if(r.rc){if(r.errn)fwrite(r.err,1,r.errn,stderr);die("compile");}np_free(&r);unsigned char b[4096];path(p,sizeof p,temp,"fixture.o");for(int arm=0;arm<2;arm++){size_t n=elf(b,arm);save(p,b,n);oracle(p,arm?"lnx/arm64":"lnx/x86_64",0,"real ELF section/symbol global definition fixture");b[132]=2;save(p,b,n);oracle(p,arm?"lnx/arm64":"lnx/x86_64",0,"LOCAL binding reported without system linker claim");set(b+134,2,0);save(p,b,n);oracle(p,arm?"lnx/arm64":"lnx/x86_64",1,"undefined ELF symbol rejected despite string name");n=elf(b,arm);save(p,b,n);oracle(p,arm?"lnx/x86_64":"lnx/arm64",1,"wrong ELF machine rejected");save(p,b,100);oracle(p,arm?"lnx/arm64":"lnx/x86_64",1,"truncated symbol sections rejected");}const char*targets[]={"lnx/x86_64","lnx/arm64","osx/x86_64","osx/arm64","win/x86_64","win/arm64"};for(int i=0;i<6;i++){size_t n=unit(b,targets[i],0);save(p,b,n);oracle(p,targets[i],0,"bounded exact-target unit global and definition fixture");save(p,b,n-1);oracle(p,targets[i],1,"truncated unit payload rejected");n=unit(b,targets[i],1);save(p,b,n);oracle(p,targets[i],1,"comment global decoy does not export definition");n=unit(b,targets[i],0);save(p,b,n);oracle(p,targets[(i%2)?i-1:i+1],1,"unit architecture and payload target mismatch rejected");}char*missing[]={exe,"--objects",0};r=run(missing,3);ck(r.rc==2,"missing explicit candidate/material arguments rejected");np_free(&r);printf("PRUNE_ROUTE_PLACEMENT_CHECK\tchecks=%d\tfailed=%d\tscope=independent-format-consistency-fixtures\tretained=%s\n",checks,bad,temp);return bad?1:0;}
