/* tools/abidispatch-gen.cx -- weights/abi/dispatch.tsv: which syscall chain lower enters for (op, os, arch).
 *
 *   sh ./unisacc.com tools/abidispatch-gen.cx -- --check|--write
 *
 * The table is a projection of weights/gold/abi.tsv (522 keys, same op/os/arch domains, same row order):
 * the label is the op itself when the row names a kernel number (sysno != none) or, on win, an
 * import (winimp != none), and `fail` otherwise -- the rule tools/facts-gen.cx uses for @abisel.
 * tools/decide-gen.cx compiles it into exec/lower/abidecide-result.tsv (--each os --each arch
 * --sections), one section per target, so the lower net of a target carries that target's rows only.
 * --check refuses when the committed table differs byte for byte. */
#pragma unisa use sys.io
#pragma unisa use text.text
#define AG_IN "weights/gold/abi.tsv"
#define AG_OUT "weights/abi/dispatch.tsv"
#define AG_MAXV 128
static void die(const char *a, const char *b) { fprintf(stderr, "abidispatch-gen: %s %s\n", a, b); exit(2); }
static char *slurp(const char *p) {
    FILE *f = fopen(p, "rb"); size_t cap = 1 << 22, n; char *b;
    if (!f) return 0;
    b = malloc(cap); if (!b) die("memory", p);
    n = fread(b, 1, cap - 1, f); fclose(f); b[n] = 0; return b;
}
static int split(char *s, char **v, int cap) {
    int n = 0; v[n++] = s;
    while (*s) { if (*s == '\t') { *s = 0; if (n == cap) die("too many fields", v[0]); v[n++] = s + 1; } s++; }
    return n;
}
static int put(char *out, long *at, long cap, const char *s) { long n = (long)strlen(s); if (*at + n >= cap) die("output bound", s); memcpy(out + *at, s, (size_t)n); *at += n; return 0; }
int main(int argc, char **argv) {
    if (argc != 2 || (strcmp(argv[1], "--write") && strcmp(argv[1], "--check"))) die("usage:", "--check|--write");
    char *t = slurp(AG_IN), *line, *ops[AG_MAXV]; int nops = 0, nfield = 0, nhead = 0, nrows = 0, nsel = 0, ncol = 0, sysno = -1, winimp = -1;
    long cap = 1 << 20, at = 0; char *out = malloc(cap); if (!t || !out) die("cannot read", AG_IN);
    put(out, &at, cap, "# weights/abi/dispatch.tsv: syscall dispatch, key = (op, os, arch) of weights/gold/abi.tsv; generated by `tools/abidispatch-gen.cx --write` -- do not edit\n");
    put(out, &at, cap, "# label = op when abi.tsv names sysno (or winimp on win), else fail (the tools/facts-gen.cx @abisel rule). Compiled by tools/decide-gen.cx into exec/lower/abidecide-result.tsv.\n");
    for (line = t; line && *line; ) {
        char *nl = strchr(line, '\n'), *v[AG_MAXV + 16]; int n, i;
        if (nl) *nl = 0;
        if (!strncmp(line, "#field\t", 7)) {
            char *copy = strdup(line); n = split(copy, v, AG_MAXV + 16);
            if (nfield == 0) { if (strcmp(v[1], "op")) die("first field must be op", v[1]); for (i = 2; i < n; i++) ops[nops++] = v[i]; }
            nfield++; put(out, &at, cap, line); put(out, &at, cap, "\n");
        } else if (!strncmp(line, "#head\t", 6)) {
            if (nhead++ == 0) { put(out, &at, cap, "#head\ty\t-\tfail"); for (i = 0; i < nops; i++) { put(out, &at, cap, "\t"); put(out, &at, cap, ops[i]); } put(out, &at, cap, "\n"); }
        } else if (*line && *line != '#') {
            n = split(line, v, AG_MAXV + 16);
            if (!ncol) {   /* the header row: op os arch => sysno ... */
                if (n < 4 || strcmp(v[0], "op") || strcmp(v[1], "os") || strcmp(v[2], "arch")) die("bad header row", line);
                ncol = n;
                for (i = 3; i < n; i++) { if (!strcmp(v[i], "=> sysno")) sysno = i; if (!strcmp(v[i], "=> winimp")) winimp = i; }
                if (sysno < 0 || winimp < 0) die("header lacks sysno/winimp", line);
                put(out, &at, cap, "op\tos\tarch\t=> y\n");
            } else {
                int selected;
                if (n != ncol) die("row width differs from header", v[0]);
                for (i = 0; i < nops && strcmp(ops[i], v[0]); i++) ;
                if (i == nops) die("op not in domain", v[0]);
                selected = strcmp(v[sysno], "none") != 0 || (!strcmp(v[1], "win") && strcmp(v[winimp], "none") != 0);
                nrows++; nsel += selected;
                put(out, &at, cap, v[0]); put(out, &at, cap, "\t"); put(out, &at, cap, v[1]); put(out, &at, cap, "\t"); put(out, &at, cap, v[2]);
                put(out, &at, cap, "\t"); put(out, &at, cap, selected ? v[0] : "fail"); put(out, &at, cap, "\n");
            }
        }
        line = nl ? nl + 1 : 0;
    }
    if (nfield != 3 || !nrows) die("abi.tsv shape", AG_IN);
    if (!strcmp(argv[1], "--write")) { FILE *o = fopen(AG_OUT, "wb"); if (!o || fwrite(out, 1, (size_t)at, o) != (size_t)at || fclose(o)) die("cannot write", AG_OUT); }
    else { char *old = slurp(AG_OUT); if (!old || strlen(old) != (size_t)at || memcmp(old, out, (size_t)at)) { fprintf(stderr, "abidispatch-gen: %s differs\n", AG_OUT); return 1; } }
    printf("ABIDISPATCH\tkeys=%d\tselected=%d\tops=%d\tstatus=PASS\n", nrows, nsel, nops); return 0;
}
