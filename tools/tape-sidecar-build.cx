/* tools/tape-sidecar-build.cx -- build and verify lnx/x86_64 tape sidecar (tapemode.so + manifest.tsv).
 *
 * Usage:
 *   cx tools/tape-sidecar-build.cx -- [--target TARGET] [--check] ROOT OUT_DIR
 *
 * Contract:
 *   - Only lnx/x86_64 builds OUT_DIR/tapemode.so and OUT_DIR/manifest.tsv (requires host cc -shared -fPIC -nostdlib -O2 -Wl,-Bsymbolic -Wl,--hash-style=sysv -Wl,-z,norelro).
 *   - The other five targets (lnx/arm64, osx/x86_64, osx/arm64, win/x86_64, win/arm64) print SKIP and exit 0
 *     without writing any files.
 *   - Unknown targets refuse with rc=2.
 *   - Static ELF64 structure verification (shared by build and --check, zero dlopen/execution):
 *       ELF64 LE ET_DYN EM_X86_64, at least one executable PT_LOAD, no W+X PT_LOAD (PF_W|PF_X),
 *       no executable PT_GNU_STACK, no SHT_RELA/SHT_REL sections, no DT_NEEDED/DT_RELA/DT_REL/DT_JMPREL/DT_INIT,
 *       and all 3 required symbols (tape_run_x86_64, hoststub_lnx_x86_64, hoststub_lnx_x86_64_bind)
 *       defined in this ELF's own .dynsym (st_shndx != 0, GLOBAL/WEAK).
 *   - Paired publish prechecks OUT_DIR and destination paths (rejects non-regular targets before any rename)
 *     and rolls back tapemode.so if manifest.tsv rename fails.
 *   - --check verifies regular files (rejects symlinks), checks manifest.tsv bytes and source/so sha256+bytes
 *     BEFORE running static ELF64 verification on the same in-memory bytes (no dlopen, no TOCTOU).
 */
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

static int tsb_target_kind(const char *t) {
    if (tx_eqz(t, "lnx/x86_64")) return 1;
    if (tx_eqz(t, "lnx/arm64") || tx_eqz(t, "osx/x86_64") || tx_eqz(t, "osx/arm64") ||
        tx_eqz(t, "win/x86_64") || tx_eqz(t, "win/arm64")) return 2;
    return 0;
}

static unsigned int tsb_u16(const unsigned char *p) {
    return (unsigned int)p[0] | ((unsigned int)p[1] << 8);
}

static unsigned int tsb_u32(const unsigned char *p) {
    return (unsigned int)p[0] | ((unsigned int)p[1] << 8) |
           ((unsigned int)p[2] << 16) | ((unsigned int)p[3] << 24);
}

static unsigned long tsb_u64(const unsigned char *p) {
    return (unsigned long)tsb_u32(p) | ((unsigned long)tsb_u32(p + 4) << 32);
}

static int tsb_range_ok(unsigned long off, unsigned long sz, unsigned long total) {
    return off <= total && sz <= total - off;
}

static int tsb_cstr_eq(const unsigned char *strtab, unsigned long strsz, unsigned long off, const char *want) {
    unsigned long i = 0;
    if (off >= strsz) return 0;
    while (want[i]) {
        if (off + i >= strsz || strtab[off + i] != (unsigned char)want[i]) return 0;
        i++;
    }
    return (off + i < strsz && strtab[off + i] == 0) ? 1 : 0;
}

/* Pure static ELF64 x86_64 ET_DYN verifier. Zero dlopen, zero external tools. */
static int tsb_verify_elf(const unsigned char *b, size_t n, const char **reason_out) {
    unsigned long phoff, shoff, dyn_off = 0, dyn_sz = 0;
    unsigned long dynsym_off = 0, dynsym_sz = 0, dynsym_entsz = 0;
    unsigned int phentsz, phnum, shentsz, shnum, dynsym_link = 0;
    unsigned int i;
    int has_exec = 0;
    int sym_mask = 0;

    if (n < 4 || b[0] != 0x7f || b[1] != 'E' || b[2] != 'L' || b[3] != 'F') {
        *reason_out = "so-not-elf";
        return -1;
    }
    if (n < 64 || b[4] != 2 || b[5] != 1 || b[6] != 1 ||
        tsb_u16(b + 16) != 3 || tsb_u16(b + 18) != 62) {
        *reason_out = "so-not-elf64-x86_64-dyn";
        return -1;
    }

    phoff = tsb_u64(b + 32);
    shoff = tsb_u64(b + 40);
    phentsz = tsb_u16(b + 54);
    phnum = tsb_u16(b + 56);
    shentsz = tsb_u16(b + 58);
    shnum = tsb_u16(b + 60);

    if (phnum == 0 || phentsz < 56 || !tsb_range_ok(phoff, (unsigned long)phentsz * (unsigned long)phnum, (unsigned long)n)) {
        *reason_out = "so-bad-phdr";
        return -1;
    }
    for (i = 0; i < phnum; i++) {
        const unsigned char *ph = b + phoff + (unsigned long)i * (unsigned long)phentsz;
        unsigned int p_type = tsb_u32(ph + 0);
        unsigned int p_flags = tsb_u32(ph + 4);
        unsigned long p_offset = tsb_u64(ph + 8);
        unsigned long p_filesz = tsb_u64(ph + 32);
        if (p_type == 1) { /* PT_LOAD */
            if ((p_flags & 3U) == 3U) { /* PF_W | PF_X, regardless of PF_R */
                *reason_out = "so-wx-segment";
                return -1;
            }
            if (p_flags & 1U) has_exec = 1;
        } else if (p_type == 0x6474e551U) { /* PT_GNU_STACK */
            if (p_flags & 1U) {
                *reason_out = "so-exec-stack";
                return -1;
            }
        } else if (p_type == 2) { /* PT_DYNAMIC */
            if (!tsb_range_ok(p_offset, p_filesz, (unsigned long)n)) {
                *reason_out = "so-bad-dynamic";
                return -1;
            }
            dyn_off = p_offset;
            dyn_sz = p_filesz;
        }
    }
    if (!has_exec) {
        *reason_out = "so-no-exec-segment";
        return -1;
    }

    if (shnum == 0 || shentsz < 64 || !tsb_range_ok(shoff, (unsigned long)shentsz * (unsigned long)shnum, (unsigned long)n)) {
        *reason_out = "so-bad-shdr";
        return -1;
    }
    for (i = 0; i < shnum; i++) {
        const unsigned char *sh = b + shoff + (unsigned long)i * (unsigned long)shentsz;
        unsigned int sh_type = tsb_u32(sh + 4);
        unsigned long sh_offset = tsb_u64(sh + 24);
        unsigned long sh_size = tsb_u64(sh + 32);
        unsigned int sh_link = tsb_u32(sh + 40);
        unsigned long sh_entsz = tsb_u64(sh + 56);
        if (sh_type == 4 || sh_type == 9 || sh_type == 19) { /* SHT_RELA, SHT_REL, SHT_RELR */
            *reason_out = "so-has-relocations";
            return -1;
        }
        if (sh_type == 6 && dyn_sz == 0) { /* SHT_DYNAMIC */
            if (!tsb_range_ok(sh_offset, sh_size, (unsigned long)n)) {
                *reason_out = "so-bad-dynamic";
                return -1;
            }
            dyn_off = sh_offset;
            dyn_sz = sh_size;
        }
        if (sh_type == 11) { /* SHT_DYNSYM */
            if (!tsb_range_ok(sh_offset, sh_size, (unsigned long)n) || sh_entsz < 24) {
                *reason_out = "so-bad-dynsym";
                return -1;
            }
            dynsym_off = sh_offset;
            dynsym_sz = sh_size;
            dynsym_entsz = sh_entsz;
            dynsym_link = sh_link;
        }
    }

    if (dyn_sz > 0) {
        unsigned long off = 0;
        while (off + 16 <= dyn_sz) {
            unsigned long d_tag = tsb_u64(b + dyn_off + off);
            if (d_tag == 0) break; /* DT_NULL */
            if (d_tag == 1) { /* DT_NEEDED */
                *reason_out = "so-has-needed";
                return -1;
            }
            if (d_tag == 7 || d_tag == 17 || d_tag == 23 || d_tag == 35 || d_tag == 36 || d_tag == 37) { /* DT_RELA, DT_REL, DT_JMPREL, DT_RELRSZ, DT_RELR, DT_RELRENT */
                *reason_out = "so-has-relocations";
                return -1;
            }
            if (d_tag == 12 || d_tag == 25 || d_tag == 32) { /* DT_INIT, DT_INIT_ARRAY, DT_PREINIT_ARRAY */
                *reason_out = "so-has-init";
                return -1;
            }
            off += 16;
        }
    }

    if (dynsym_sz == 0 || dynsym_link == 0 || dynsym_link >= shnum) {
        *reason_out = "so-missing-symbols";
        return -1;
    }
    {
        const unsigned char *str_sh = b + shoff + (unsigned long)dynsym_link * (unsigned long)shentsz;
        unsigned int str_type = tsb_u32(str_sh + 4);
        unsigned long str_off = tsb_u64(str_sh + 24);
        unsigned long str_sz = tsb_u64(str_sh + 32);
        unsigned long off = 0;
        if (str_type != 3 || !tsb_range_ok(str_off, str_sz, (unsigned long)n)) {
            *reason_out = "so-bad-dynstr";
            return -1;
        }
        while (off + dynsym_entsz <= dynsym_sz) {
            const unsigned char *sym = b + dynsym_off + off;
            unsigned int st_name = tsb_u32(sym + 0);
            unsigned int st_bind = (unsigned int)(sym[4] >> 4);
            unsigned int st_shndx = tsb_u16(sym + 6);
            if (st_shndx != 0 && st_shndx < shnum && (st_bind == 1 || st_bind == 2)) {
                if (tsb_cstr_eq(b + str_off, str_sz, st_name, "tape_run_x86_64")) sym_mask |= 1;
                else if (tsb_cstr_eq(b + str_off, str_sz, st_name, "hoststub_lnx_x86_64")) sym_mask |= 2;
                else if (tsb_cstr_eq(b + str_off, str_sz, st_name, "hoststub_lnx_x86_64_bind")) sym_mask |= 4;
            }
            off += dynsym_entsz;
        }
    }
    if (sym_mask != 7) {
        *reason_out = "so-missing-symbols";
        return -1;
    }
    *reason_out = "ok";
    return 0;
}

static int tsb_read_reg(const char *path, char **buf_out, size_t *len_out, char hex[65]) {
    sy_stat_t st;
    size_t n = 0;
    char *b;
    if (sy_lstat(path, &st) != 0 || st.kind != 'f') return -1;
    b = cx_read(path, &n);
    if (!b || (long)n != (long)st.size || n == 0) { if (b) mm_free(b); return -1; }
    cx_sha256_hex(b, n, hex);
    if (buf_out) *buf_out = b;
    else mm_free(b);
    if (len_out) *len_out = n;
    return 0;
}

static int tsb_check_manifest(const char *out_dir, const char *s1, const char *s2) {
    char so_p[4400], mf_p[4400], so_sha[65], want_head[256], want_row[256];
    sy_stat_t st;
    size_t so_n = 0, mn = 0;
    char *so_b = 0, *mb = 0;
    const char *elf_reason = "so-invalid";

    if (cx_fmt(so_p, sizeof so_p, "%s/tapemode.so", out_dir) ||
        cx_fmt(mf_p, sizeof mf_p, "%s/manifest.tsv", out_dir)) {
        sy_printf("TAPE_SIDECAR_BUILD\tFAIL\treason=path-bound\n");
        return 1;
    }
    if (sy_lstat(out_dir, &st) != 0 || st.kind != 'd') {
        sy_printf("TAPE_SIDECAR_BUILD\tFAIL\treason=out-not-dir\n");
        return 1;
    }
    if (sy_lstat(so_p, &st) != 0) { sy_printf("TAPE_SIDECAR_BUILD\tFAIL\treason=so-missing\n"); return 1; }
    if (st.kind != 'f') { sy_printf("TAPE_SIDECAR_BUILD\tFAIL\treason=so-not-regular\n"); return 1; }
    if (sy_lstat(mf_p, &st) != 0 || st.kind != 'f') {
        sy_printf("TAPE_SIDECAR_BUILD\tFAIL\treason=manifest-missing-or-not-regular\n");
        return 1;
    }
    if (tsb_read_reg(so_p, &so_b, &so_n, so_sha) != 0) {
        sy_printf("TAPE_SIDECAR_BUILD\tFAIL\treason=so-unreadable\n");
        return 1;
    }
    mb = cx_read(mf_p, &mn);
    if (!mb || mn == 0) {
        mm_free(so_b);
        if (mb) mm_free(mb);
        sy_printf("TAPE_SIDECAR_BUILD\tFAIL\treason=manifest-unreadable\n");
        return 1;
    }
    /* Verify manifest bytes and exact source + .so digest BEFORE static ELF verification. */
    if (cx_fmt(want_head, sizeof want_head, "# tape-sidecar-manifest-v1 target=lnx/x86_64 src_tape=%s src_hoststub=%s\n", s1, s2) ||
        cx_fmt(want_row, sizeof want_row, "tapemode.so\t%s\t%ld\n", so_sha, (long)so_n)) {
        mm_free(so_b);
        mm_free(mb);
        sy_printf("TAPE_SIDECAR_BUILD\tFAIL\treason=format-bound\n");
        return 1;
    }
    {
        long hl = tx_len(want_head, sizeof want_head), rl = tx_len(want_row, sizeof want_row);
        int ok = ((long)mn == hl + rl) && tx_same(mb, hl, want_head, hl) && tx_same(mb + hl, rl, want_row, rl);
        mm_free(mb);
        if (!ok) {
            mm_free(so_b);
            sy_printf("TAPE_SIDECAR_BUILD\tFAIL\treason=manifest-mismatch\n");
            return 1;
        }
    }
    if (tsb_verify_elf((const unsigned char *)so_b, so_n, &elf_reason) != 0) {
        mm_free(so_b);
        sy_printf("TAPE_SIDECAR_BUILD\tFAIL\treason=%s\n", elf_reason);
        return 1;
    }
    mm_free(so_b);
    sy_printf("TAPE_SIDECAR_BUILD\tCHECK_OK\ttarget=lnx/x86_64\tsha=%s\tbytes=%ld\n", so_sha, (long)so_n);
    return 0;
}

int main(int argc, char **argv) {
    const char *target = "lnx/x86_64";
    const char *pos[2];
    int np = 0, check_only = 0, i;
    char root_abs[4096], src_tape[4400], src_host[4400], s1[65], s2[65];
    size_t b1 = 0, b2 = 0;

    for (i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--")) continue;
        if (tx_eqz(argv[i], "--check")) { check_only = 1; continue; }
        if (tx_eqz(argv[i], "--target") && i + 1 < argc) { target = argv[++i]; continue; }
        if (argv[i][0] == '-') {
            sy_eprintf("tape-sidecar-build: usage: [--target TARGET] [--check] ROOT OUT_DIR\n");
            return 2;
        }
        if (np < 2) pos[np++] = argv[i];
        else { sy_eprintf("tape-sidecar-build: usage: [--target TARGET] [--check] ROOT OUT_DIR\n"); return 2; }
    }
    if (np != 2) {
        sy_eprintf("tape-sidecar-build: usage: [--target TARGET] [--check] ROOT OUT_DIR\n");
        return 2;
    }
    {
        int tk = tsb_target_kind(target);
        if (tk == 0) {
            sy_printf("TAPE_SIDECAR_BUILD\tREFUSE\treason=unknown-target\ttarget=%s\n", target);
            return 2;
        }
        if (tk == 2) {
            sy_printf("TAPE_SIDECAR_BUILD\tSKIP\ttarget=%s\treason=unsupported-target\n", target);
            return 0;
        }
    }
    if (sy_realpath(pos[0], root_abs, (int)sizeof root_abs) < 0) {
        sy_printf("TAPE_SIDECAR_BUILD\tREFUSE\treason=bad-root\n");
        return 2;
    }
    if (cx_fmt(src_tape, sizeof src_tape, "%s/tools/tape/asm/tape_x86_64.S", root_abs) ||
        cx_fmt(src_host, sizeof src_host, "%s/tools/tape/asm/hoststub_lnx_x86_64.S", root_abs)) {
        sy_printf("TAPE_SIDECAR_BUILD\tREFUSE\treason=path-bound\n");
        return 2;
    }
    if (tsb_read_reg(src_tape, 0, &b1, s1) != 0 || tsb_read_reg(src_host, 0, &b2, s2) != 0) {
        sy_printf("TAPE_SIDECAR_BUILD\tREFUSE\treason=missing-asm-sources\n");
        return 2;
    }
    if (check_only) return tsb_check_manifest(pos[1], s1, s2);

    {
        sy_stat_t st;
        int lst = sy_lstat(pos[1], &st);
        if (lst == 0) {
            if (st.kind != 'd') {
                sy_printf("TAPE_SIDECAR_BUILD\tFAIL\treason=out-not-dir\n");
                return 1;
            }
        } else if (sy_mkdir(pos[1], 0755) != 0) {
            sy_printf("TAPE_SIDECAR_BUILD\tREFUSE\treason=mkdir-out-failed\n");
            return 2;
        }
    }
    {
        char tmp_so[4400], dst_so[4400], bak_so[4400], tmp_mf[4400], dst_mf[4400], so_sha[65], mf_body[512];
        char *log = 0, *so_b = 0;
        size_t logn = 0, so_n = 0;
        const char *elf_reason = "built-so-invalid";
        int rc, had_old_so = 0;
        int pid = sy_pid();
        sy_stat_t st_so, st_mf;

        if (cx_fmt(tmp_so, sizeof tmp_so, "%s/.tapemode.so.%d", pos[1], pid) ||
            cx_fmt(dst_so, sizeof dst_so, "%s/tapemode.so", pos[1]) ||
            cx_fmt(bak_so, sizeof bak_so, "%s/.bak.tapemode.so.%d", pos[1], pid) ||
            cx_fmt(tmp_mf, sizeof tmp_mf, "%s/.manifest.tsv.%d", pos[1], pid) ||
            cx_fmt(dst_mf, sizeof dst_mf, "%s/manifest.tsv", pos[1])) {
            sy_printf("TAPE_SIDECAR_BUILD\tREFUSE\treason=path-bound\n");
            return 2;
        }
        /* Precheck destination paths before compiling or renaming so paired publish cannot go half-way. */
        if (sy_lstat(dst_so, &st_so) == 0) {
            if (st_so.kind != 'f') {
                sy_printf("TAPE_SIDECAR_BUILD\tFAIL\treason=dst-not-regular\tpath=tapemode.so\n");
                return 1;
            }
            had_old_so = 1;
        }
        if (sy_lstat(dst_mf, &st_mf) == 0 && st_mf.kind != 'f') {
            sy_printf("TAPE_SIDECAR_BUILD\tFAIL\treason=dst-not-regular\tpath=manifest.tsv\n");
            return 1;
        }
        {
            char *av[] = {"cc", "-shared", "-fPIC", "-nostdlib", "-O2",
                          "-Wl,-Bsymbolic", "-Wl,--hash-style=sysv", "-Wl,-z,norelro",
                          "-o", tmp_so, src_tape, src_host, 0};
            rc = cx_runv_timeout(av, 30, &log, &logn);
        }
        if (rc != 0) {
            (void)sy_unlink(tmp_so);
            if (log && logn) (void)sy_write_all(2, log, (long)logn);
            if (log) mm_free(log);
            sy_printf("TAPE_SIDECAR_BUILD\tFAIL\treason=cc-failed\trc=%d\n", rc);
            return 1;
        }
        if (log) mm_free(log);
        if (tsb_read_reg(tmp_so, &so_b, &so_n, so_sha) != 0) {
            (void)sy_unlink(tmp_so);
            sy_printf("TAPE_SIDECAR_BUILD\tFAIL\treason=built-so-unreadable\n");
            return 1;
        }
        if (tsb_verify_elf((const unsigned char *)so_b, so_n, &elf_reason) != 0) {
            mm_free(so_b);
            (void)sy_unlink(tmp_so);
            sy_printf("TAPE_SIDECAR_BUILD\tFAIL\treason=%s\n", elf_reason);
            return 1;
        }
        mm_free(so_b);
        (void)sy_chmod(tmp_so, 0755);
        if (cx_fmt(mf_body, sizeof mf_body,
                   "# tape-sidecar-manifest-v1 target=lnx/x86_64 src_tape=%s src_hoststub=%s\ntapemode.so\t%s\t%ld\n",
                   s1, s2, so_sha, (long)so_n)) {
            (void)sy_unlink(tmp_so);
            sy_printf("TAPE_SIDECAR_BUILD\tREFUSE\treason=manifest-bound\n");
            return 2;
        }
        if (cx_write(tmp_mf, mf_body, (size_t)tx_len(mf_body, sizeof mf_body))) {
            (void)sy_unlink(tmp_so); (void)sy_unlink(tmp_mf);
            sy_printf("TAPE_SIDECAR_BUILD\tFAIL\treason=manifest-write-failed\n");
            return 1;
        }
        (void)sy_chmod(tmp_mf, 0644);

        /* Re-verify destination kinds immediately before paired commit. */
        if ((sy_lstat(dst_so, &st_so) == 0 && st_so.kind != 'f') ||
            (sy_lstat(dst_mf, &st_mf) == 0 && st_mf.kind != 'f')) {
            (void)sy_unlink(tmp_so); (void)sy_unlink(tmp_mf);
            sy_printf("TAPE_SIDECAR_BUILD\tFAIL\treason=dst-not-regular\n");
            return 1;
        }
        if (had_old_so) {
            if (sy_rename(dst_so, bak_so) != 0) {
                (void)sy_unlink(tmp_so); (void)sy_unlink(tmp_mf);
                sy_printf("TAPE_SIDECAR_BUILD\tFAIL\treason=so-backup-failed\n");
                return 1;
            }
        }
        if (sy_rename(tmp_so, dst_so) != 0) {
            if (had_old_so) (void)sy_rename(bak_so, dst_so);
            (void)sy_unlink(tmp_so); (void)sy_unlink(tmp_mf);
            sy_printf("TAPE_SIDECAR_BUILD\tFAIL\treason=so-rename-failed\n");
            return 1;
        }
        if (sy_rename(tmp_mf, dst_mf) != 0) {
            if (had_old_so) (void)sy_rename(bak_so, dst_so);
            else (void)sy_unlink(dst_so);
            (void)sy_unlink(tmp_mf);
            sy_printf("TAPE_SIDECAR_BUILD\tFAIL\treason=manifest-rename-failed\n");
            return 1;
        }
        if (had_old_so) (void)sy_unlink(bak_so);
        sy_printf("TAPE_SIDECAR_BUILD\tBUILT\ttarget=lnx/x86_64\tso=%s\tsha=%s\tbytes=%ld\tsrc_tape=%s\tsrc_hoststub=%s\n",
                  dst_so, so_sha, (long)so_n, s1, s2);
    }
    return 0;
}
