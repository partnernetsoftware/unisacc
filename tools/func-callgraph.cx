/* tools/func-callgraph.cx -- C 源文件的函数边界识别 + 词法调用图 + 入口可达分类。
 *
 *   sh ./unisacc.com tools/func-callgraph.cx -- FILE            输出 function-matrix.tsv(入口表为 seed/gen.c 专用)
 *   sh ./unisacc.com tools/func-callgraph.cx -- FILE --funcs    只输出 函数\t起行\t止行\t行数
 *
 * 由 G1 的 cg.py 移植。边界:顶层深度 0 处 '{' 且其前一个有效字符是 ')' 即函数;
 * 扫描时跳过注释、字符串、字符常量与预处理行(含续行)。调用图:每个函数行段内逐行去掉
 * 双引号串后取标识符,命中函数名(main 除外)即边。缺文件退出 2。
 */
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.arena

#define MAXF 1024
#define MAXK 16
#define HSZ 4096

static int ar, keep1;
static const char *B; static long N;
static long *ls; static long nl;               /* 行首偏移,nl 行 */
static long fa[MAXF], fb[MAXF], no[MAXF], nlen[MAXF]; static int nf;
static short hs_[HSZ];                          /* 名字哈希表,存 函数序号+1 */
static char *adj;                               /* nf*nf 邻接 */

static void die(const char *a, const char *b) { fprintf(stderr, "func-callgraph: %s%s%s\n", a, b ? ": " : "", b ? b : ""); exit(2); }

static int idst(int c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'; }
static int idch(int c) { return idst(c) || (c >= '0' && c <= '9'); }

static long hash(const char *s, long n) { unsigned long h = 5381; long i; for (i = 0; i < n; i++) h = h * 33 + (unsigned char)s[i]; return (long)(h % HSZ); }
static int look(const char *s, long n) {
    long h = hash(s, n);
    while (hs_[h]) { int f = hs_[h] - 1; if (nlen[f] == n && tx_same(B + no[f], n, s, n)) return f; h = (h + 1) % HSZ; }
    return -1;
}
static void put(int f) {
    long h = hash(B + no[f], nlen[f]);
    while (hs_[h]) h = (h + 1) % HSZ;
    hs_[h] = (short)(f + 1);
}

/* 行号(1 起)由偏移二分 */
static long lineof(long off) { long lo = 0, hi = nl - 1; while (lo < hi) { long m = (lo + hi + 1) / 2; if (ls[m] <= off) lo = m; else hi = m - 1; } return lo + 1; }

static void scan(void) {
    long i = 0, hsp = -1, last = -1; int depth = 0, infn = 0, fnidx = -1;
    while (i < N) {
        char c = B[i];
        if (c == '/' && i + 1 < N && B[i + 1] == '*') { i += 2; while (i + 1 < N && !(B[i] == '*' && B[i + 1] == '/')) i++; i += 2; continue; }
        if (c == '/' && i + 1 < N && B[i + 1] == '/') { while (i < N && B[i] != '\n') i++; continue; }
        if (c == '#' && depth == 0) {              /* 预处理行(仅顶层,且为行首首个非空白) */
            long j = i - 1; while (j >= 0 && (B[j] == ' ' || B[j] == '\t')) j--;
            if (j < 0 || B[j] == '\n') {
                while (i < N && !(B[i] == '\n' && B[i - 1] != '\\')) i++;
                continue;
            }
        }
        if (c == '"' || c == '\'') {
            long s = i++; while (i < N && B[i] != c) { if (B[i] == '\\') i++; i++; } i++;
            if (hsp < 0) hsp = s; last = c; continue;
        }
        if (c == ' ' || c == '\t' || c == '\n' || c == '\r') { i++; continue; }
        if (depth == 0 && hsp < 0) hsp = i;
        if (c == '{') {
            if (depth == 0 && last == ')' && hsp >= 0 && nf < MAXF) {
                long p = hsp, q; while (p < i && B[p] != '(') p++;
                q = p; while (q > hsp && (B[q - 1] == ' ' || B[q - 1] == '\t')) q--;
                p = q; while (p > hsp && idch(B[p - 1])) p--;
                fnidx = nf++; no[fnidx] = p; nlen[fnidx] = q - p; fa[fnidx] = lineof(hsp); infn = 1;
            }
            depth++;
        } else if (c == '}') {
            depth--;
            if (depth == 0) { if (infn) { fb[fnidx] = lineof(i); infn = 0; hsp = -1; if (fb[fnidx] == fa[fnidx] && !keep1) nf--; } }
        } else if (c == ';' && depth == 0) hsp = -1;
        last = c; i++;
    }
}

/* 第 l 行(1 起)里的标识符,去掉双引号串后命中的函数,置 mark[f]=1 */
static void line_callees(long l, char *mark) {
    long s = ls[l - 1], e = (l < nl) ? ls[l] : N, i = s;
    if (e > s && B[e - 1] == '\n') e--;
    while (i < e) {
        char c = B[i];
        if (c == '"') { i++; while (i < e && B[i] != '"') { if (B[i] == '\\') i++; i++; } i++; continue; }
        if (idst(c)) {
            long j = i; int f; while (j < e && idch(B[j])) j++;
            f = look(B + i, j - i); if (f >= 0 && !(nlen[f] == 4 && tx_same(B + no[f], 4, "main", 4))) mark[f] = 1;
            i = j; continue;
        }
        i++;
    }
}

static void clo(const char *roots, char *seen) {
    int *st = ar_alloc(ar, (long)sizeof(int) * (nf * nf + 8)); long sp = 0; int f, g;
    for (f = 0; f < nf; f++) if (roots[f]) st[sp++] = f;
    while (sp) {
        f = st[--sp]; if (seen[f]) continue;
        if (nlen[f] == 4 && tx_same(B + no[f], 4, "main", 4)) continue;
        seen[f] = 1;
        for (g = 0; g < nf; g++) if (adj[f * nf + g] && !seen[g]) st[sp++] = g;
    }
}

typedef struct { const char *key; long a, b; int nrec; } Ent;
static const Ent ENT[] = {
    {"nativeabi", 8802, 8804, 1}, {"pp", 8818, 8822, 3}, {"lex", 8875, 8889, 3}, {"opt", 8897, 8945, 2},
    {"lower-enc(通用清单解释器)", 8978, 9002, 20}, {"parse2", 9003, 9026, 3},
    {"通用清单(tapecheck/library*/hostsymbols/unitcontainer/units)", 9027, 9075, 9}, {"prune", 9076, 9082, 1},
};
#define NE 8
#define INSPECT_LO 8002
#define INSPECT_HI 9082

static long kname(const char *k) { long p = tx_chr(k, tx_len(k, 256), '('); return p < 0 ? tx_len(k, 256) : p; }

int main(int argc, char **argv) {
    long i; int f, g, k, funcsonly = 0;
    if (argc < 2) die("usage", "FILE [--funcs] [--oneline]");
    for (k = 2; k < argc; k++) {
        if (tx_eqz(argv[k], "--funcs")) funcsonly = 1;
        else if (tx_eqz(argv[k], "--oneline")) keep1 = 1;   /* 默认与 G1 一致:不收单行函数 */
        else die("unknown option", argv[k]);
    }
    ar = ar_new(1L << 30);
    { size_t n; B = cx_read(argv[1], &n); N = (long)n; if (!B) die("cannot read", argv[1]); }
    ls = ar_alloc(ar, (long)sizeof(long) * (N + 2)); nl = 0; ls[nl++] = 0;
    for (i = 0; i < N; i++) if (B[i] == '\n' && i + 1 < N) ls[nl++] = i + 1;
    scan();
    for (f = 0; f < nf; f++) put(f);
    if (funcsonly) {
        for (f = 0; f < nf; f++) printf("%.*s\t%ld\t%ld\t%ld\n", (int)nlen[f], B + no[f], fa[f], fb[f], fb[f] - fa[f] + 1);
        return 0;
    }
    adj = ar_alloc(ar, (long)nf * nf);
    for (i = 0; i < (long)nf * nf; i++) adj[i] = 0;
    for (f = 0; f < nf; f++) {
        char *m = ar_alloc(ar, nf);
        if (nlen[f] == 4 && tx_same(B + no[f], 4, "main", 4)) continue;
        for (g = 0; g < nf; g++) m[g] = 0;
        for (i = fa[f]; i <= fb[f]; i++) line_callees(i, m);
        for (g = 0; g < nf; g++) adj[f * nf + g] = m[g];
    }
    {
        char *reach = ar_alloc(ar, (long)(NE + 1) * nf), *mset = ar_alloc(ar, nl + 2);
        long total[64]; const char *cname[64]; int ncls = 0;
        for (i = 0; i < nl + 2; i++) mset[i] = 0;
        for (k = 0; k < NE; k++) {
            char *roots = ar_alloc(ar, nf);
            for (g = 0; g < nf; g++) roots[g] = 0;
            for (i = ENT[k].a; i <= ENT[k].b && i <= nl; i++) { line_callees(i, roots); mset[i] = 1; }
            for (g = 0; g < nf; g++) reach[k * nf + g] = 0;
            clo(roots, reach + k * nf);
        }
        {
            char *roots = ar_alloc(ar, nf);
            for (g = 0; g < nf; g++) roots[g] = 0;
            for (i = INSPECT_LO; i <= INSPECT_HI && i <= nl; i++) if (!mset[i]) line_callees(i, roots);
            for (g = 0; g < nf; g++) reach[NE * nf + g] = 0;
            clo(roots, reach + NE * nf);
        }
        printf("函数\t起行\t止行\t行数\t可达配方数(上界)\t分类\t可达入口\n");
        for (f = 0; f < nf; f++) {
            char cls[256]; int np = 0, nk = 0, cnt = 0, first = -1; long len = fb[f] - fa[f] + 1;
            int ismain = (nlen[f] == 4 && tx_same(B + no[f], 4, "main", 4));
            for (k = 0; k <= NE; k++) if (reach[k * nf + f]) { nk++; if (k < NE) { np++; cnt += ENT[k].nrec; if (first < 0) first = k; } }
            if (ismain) tx_snprintf(cls, sizeof cls, "D-main分发");
            else if (!nk) tx_snprintf(cls, sizeof cls, "X-不可达");
            else if (!np) tx_snprintf(cls, sizeof cls, "X-仅inspect调试");
            else if (np >= 6) tx_snprintf(cls, sizeof cls, "A-全局公共");
            else if (np == 1) tx_snprintf(cls, sizeof cls, "B-单族:%.*s", (int)kname(ENT[first].key), ENT[first].key);
            else tx_snprintf(cls, sizeof cls, "C-跨族");
            printf("%.*s\t%ld\t%ld\t%ld\t%d\t%s\t", (int)nlen[f], B + no[f], fa[f], fb[f], len, cnt, cls);
            { int sep = 0;
              for (k = 0; k <= NE; k++) if (reach[k * nf + f]) {
                  if (sep) printf("|");
                  if (k < NE) printf("%.*s", (int)kname(ENT[k].key), ENT[k].key); else printf("inspect-*调试");
                  sep = 1; }
            }
            printf("\n");
            for (k = 0; k < ncls; k++) if (tx_eqz(cname[k], cls)) break;
            if (k == ncls) { char *cp = ar_alloc(ar, 256); tx_copy(cp, 256, cls, tx_len(cls, 256) + 1); cname[ncls] = cp; total[ncls] = 0; ncls++; }
            total[k] += len;
        }
        /* 按类名字节序排序(插入排序)后写 stderr 摘要 */
        { long sum = 0;
          for (i = 1; i < ncls; i++) { const char *c = cname[i]; long t = total[i]; long j = i - 1;
              while (j >= 0 && tx_cmp(cname[j], tx_len(cname[j], 256), c, tx_len(c, 256)) > 0) { cname[j + 1] = cname[j]; total[j + 1] = total[j]; j--; }
              cname[j + 1] = c; total[j + 1] = t; }
          for (i = 0; i < ncls; i++) sum += total[i];
          fprintf(stderr, "%ld\n", sum);
          for (i = 0; i < ncls; i++) fprintf(stderr, "%s %ld %.1f%%\n", cname[i], total[i], 100.0 * total[i] / (double)nl);
        }
    }
    return 0;
}
