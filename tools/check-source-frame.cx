#pragma unisa use runtime.source_frame
static int failures, calls;
static void *allocate(void *p, size_t n) { calls++; return realloc(p, n); }
static void *fail_allocate(void *p, size_t n) { (void)p; (void)n; calls++; return 0; }
static void check(int ok, const char *name) { printf("%s %s\n", ok ? "PASS" : "FAIL", name); if (!ok) failures++; }
int main(void) {
    const char *names[] = {"a.c", ""};
    const unsigned char first[] = {0, 255, 65};
    const unsigned char *bytes[] = {first, 0};
    int lengths[] = {3, 0};
    const unsigned char expected[] = {3,0,0,0,'a','.','c',3,0,0,0,0,255,65,0,0,0,0,0,0,0,0};
    unsigned char *out = 0; int n = -1;
    check(cxsf_encode(2,names,bytes,lengths,&out,&n,allocate)==0 && n==(int)sizeof expected && !memcmp(out,expected,sizeof expected), "ordered-binary-frame");
    free(out); out=0; n=-1;
    check(cxsf_encode(0,0,0,0,&out,&n,allocate)==0 && out && n==0, "empty-frame-owned"); free(out);
    out=(unsigned char *)names; n=41; calls=0;
    lengths[0]=-1;
    check(cxsf_encode(2,names,bytes,lengths,&out,&n,allocate)==1 && out==(unsigned char *)names && n==41 && calls==0, "negative-length-untouched");
    lengths[0]=3; bytes[0]=0;
    check(cxsf_encode(2,names,bytes,lengths,&out,&n,allocate)==1 && out==(unsigned char *)names && n==41 && calls==0, "missing-bytes-untouched");
    bytes[0]=first;
    lengths[0]=2147483647;
    check(cxsf_encode(2,names,bytes,lengths,&out,&n,allocate)==2 && out==(unsigned char *)names && n==41 && calls==0, "extent-rejected-before-allocation");
    lengths[0]=3;
    check(cxsf_encode(2,names,bytes,lengths,&out,&n,fail_allocate)==3 && out==(unsigned char *)names && n==41 && calls==1, "allocation-failure-untouched");
    check(cxsf_encode(-1,names,bytes,lengths,&out,&n,allocate)==1 && calls==1, "negative-count");
    const unsigned char pair_expected[]={3,0,0,0,0,255,65,2,0,0,0,255,65};
    out=0; n=-1;
    check(cxsf_pair(first,3,first+1,2,&out,&n,allocate)==0 && n==(int)sizeof pair_expected && !memcmp(out,pair_expected,sizeof pair_expected), "e3-pair-binary"); free(out);
    out=(unsigned char *)names; n=41; calls=0;
    check(cxsf_pair(first,2147483647,0,0,&out,&n,allocate)==2 && out==(unsigned char *)names && n==41 && calls==0, "e3-pair-overflow");
    check(cxsf_pair(0,1,0,0,&out,&n,allocate)==1 && out==(unsigned char *)names && n==41 && calls==0, "e3-pair-invalid");
    check(cxsf_pair(0,0,0,0,&out,&n,fail_allocate)==3 && out==(unsigned char *)names && n==41 && calls==1, "e3-pair-allocation-failure");
    out=0; n=-1;
    check(cxsf_pair(0,0,0,0,&out,&n,allocate)==0 && n==8 && out && !memcmp(out,"\0\0\0\0\0\0\0\0",8), "e3-pair-empty"); free(out);
    char line[128],stage[32],hex[65];
    int ln=snprintf(line,sizeof line,"#SC2\tstage=e3:lnx/x86_64\tinput_sha256=%064d\n",0);
    check(cxsf_companion((unsigned char *)line,ln,stage,sizeof stage,hex)==1 && !strcmp(stage,"e3:lnx/x86_64") && strlen(hex)==64, "companion-valid");
    strcpy(stage,"unchanged"); strcpy(hex,"unchanged");
    line[ln-2]='A';
    check(!cxsf_companion((unsigned char *)line,ln,stage,sizeof stage,hex) && !strcmp(stage,"unchanged") && !strcmp(hex,"unchanged"), "companion-uppercase-untouched");
    line[ln-2]='0'; line[ln-1]='x';
    check(!cxsf_companion((unsigned char *)line,ln,stage,sizeof stage,hex), "companion-missing-newline");
    line[ln-1]='\n'; line[12]=0;
    check(!cxsf_companion((unsigned char *)line,ln,stage,sizeof stage,hex), "companion-embedded-nul");
    line[12]='3';
    check(!cxsf_companion((unsigned char *)line,ln,stage,2,hex), "companion-stage-capacity");
    int number=99;
    check(cxsf_hex_digit('0')==0 && cxsf_hex_digit('f')==15 && cxsf_hex_digit('F')==-1 && cxsf_hex_digit(256)==-1, "ledger-hex-boundaries");
    check(cxsf_length("2147483647",&number) && number==2147483647, "ledger-length-max");
    number=99;
    check(!cxsf_length("2147483648",&number) && !cxsf_length("01",&number) && !cxsf_length("-1",&number) && !cxsf_length("",&number) && number==99, "ledger-length-invalid-unchanged");
    ln=snprintf(line,sizeof line,"#SC1\tstage=e3:lnx/x86_64\tinput_sha256=%064d",0);
    check(cxsf_ledger_identity(line,stage,sizeof stage,hex) && !strcmp(stage,"e3:lnx/x86_64") && strlen(hex)==64, "ledger-identity-valid");
    strcpy(stage,"unchanged");strcpy(hex,"unchanged");line[ln-1]='A';
    check(!cxsf_ledger_identity(line,stage,sizeof stage,hex) && !strcmp(stage,"unchanged") && !strcmp(hex,"unchanged"), "ledger-identity-invalid-unchanged");
    printf("CXSOURCE_FRAME\tfailed=%d\n", failures);
    return failures ? 1 : 0;
}
