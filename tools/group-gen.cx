#pragma unisa use sys.io
#pragma unisa use text.text
/* Project route groups from exec/c/compiler-routes.tsv onto the compiler
   and runtime group name tables.
   sh ./unisacc.com tools/group-gen.cx -- --check
   sh ./unisacc.com tools/group-gen.cx -- --write
   The fact table is the only name list. A group is the suffix before the
   first '/', or the whole suffix when there is no '/'. First-seen order.
   Exactly ten data rows, exactly four unique groups: the names stay strings
   because pp is already the net module stem.
   The ten suffixes stay on the route table. This is not st_gap.
   A null out-pointer returns 4. An index outside 0..count-1 returns 2.
   No libc and no include. */
#define TSV "exec/c/compiler-routes.tsv"
#define NROUTE 10
#define NGROUP 4
#define NAMEMAX 32
#define FILECAP 2048
#define CHECKCAP 4096

static char suffixes[NROUTE][NAMEMAX];
static char groups[NGROUP][NAMEMAX];
static int nsuffix;
static int ngroups;

static int fail(const char *why) {
    sy_eprintf("group-gen\tFAIL\t%s\n", why);
    return 1;
}

static int ident_ok(const char *s, int n) {
    int i;
    if (n < 1 || n >= NAMEMAX) return 0;
    if (s[0] < 'a' || s[0] > 'z') return 0;
    for (i = 1; i < n; i++) {
        char c = s[i];
        if (c >= 'a' && c <= 'z') continue;
        if (c >= '0' && c <= '9') continue;
        return 0;
    }
    return 1;
}

static int level_ok(const char *s, int n) {
    int i;
    if (n < 1 || n >= NAMEMAX) return 0;
    if (!((s[0] >= 'A' && s[0] <= 'Z') || (s[0] >= 'a' && s[0] <= 'z'))) return 0;
    for (i = 1; i < n; i++) {
        char c = s[i];
        if (c >= 'A' && c <= 'Z') continue;
        if (c >= 'a' && c <= 'z') continue;
        if (c >= '0' && c <= '9') continue;
        return 0;
    }
    return 1;
}

static int stage_ok(const char *s, int n) {
    return ident_ok(s, n);
}

static int opt_ok(const char *s, int n) {
    return level_ok(s, n);
}

static void copy_field(char *dst, const char *s, int n) {
    int i;
    for (i = 0; i < n; i++) dst[i] = s[i];
    dst[n] = 0;
}

static int group_of(const char *suffix, int n, char *dst) {
    int i, slash = -1;
    for (i = 0; i < n; i++) {
        if (suffix[i] != '/') continue;
        if (slash >= 0) return 0;
        slash = i;
    }
    if (slash == 0 || slash == n - 1) return 0;
    if (slash < 0) {
        if (!ident_ok(suffix, n)) return 0;
        copy_field(dst, suffix, n);
        return 1;
    }
    if (!ident_ok(suffix, slash)) return 0;
    if (!level_ok(suffix + slash + 1, n - slash - 1)) return 0;
    copy_field(dst, suffix, slash);
    return 1;
}

static int push_suffix(const char *s) {
    int i;
    for (i = 0; i < nsuffix; i++) if (tx_eqz(suffixes[i], s)) return fail("suffix-dup");
    if (nsuffix >= NROUTE) return fail("route-count");
    for (i = 0; s[i]; i++) suffixes[nsuffix][i] = s[i];
    suffixes[nsuffix][i] = 0;
    nsuffix++;
    return 0;
}

static int push_group(const char *s) {
    int i;
    for (i = 0; i < ngroups; i++) if (tx_eqz(groups[i], s)) return 0;
    if (ngroups >= NGROUP) return fail("group-count");
    for (i = 0; s[i]; i++) groups[ngroups][i] = s[i];
    groups[ngroups][i] = 0;
    ngroups++;
    return 0;
}

static int take_row(const char *line, int n) {
    const char *f[3];
    int len[3];
    int i, k, start;
    char suffix[NAMEMAX], group[NAMEMAX];
    k = 0;
    start = 0;
    for (i = 0; i <= n; i++) {
        if (i == n || line[i] == '\t') {
            if (k >= 3) return fail("row-fields");
            f[k] = line + start;
            len[k] = i - start;
            k++;
            start = i + 1;
        }
    }
    if (k != 3) return fail("row-fields");
    if (!stage_ok(f[1], len[1])) return fail("stage-charset");
    if (!opt_ok(f[2], len[2])) return fail("opt-charset");
    if (!group_of(f[0], len[0], group)) return fail("group-shape");
    copy_field(suffix, f[0], len[0]);
    if (push_suffix(suffix)) return 1;
    if (push_group(group)) return 1;
    return 0;
}

static int parse_tsv(char *b, size_t n) {
    size_t i = 0;
    int saw = 0;
    if (n == 0 || b[n - 1] != '\n') return fail("tsv-newline");
    while (i < n) {
        size_t e = i;
        while (e < n && b[e] != '\n') e++;
        b[e] = 0;
        if (e == i) return fail("tsv-blank");
        if (!saw) {
            if (!tx_eqz(b + i, "# route suffix\tlast stage\toptimiser"))
                return fail("tsv-header");
            saw = 1;
        } else if (b[i] == '#') {
            return fail("tsv-comment");
        } else if (take_row(b + i, (int)(e - i))) {
            return 1;
        }
        i = e + 1;
    }
    if (nsuffix != NROUTE) return fail("route-count");
    if (ngroups != NGROUP) return fail("group-count");
    return 0;
}

static int app(char *dst, int cap, int *n, const char *s) {
    int i = 0;
    while (s[i]) {
        if (*n + 1 >= cap) return -1;
        dst[*n] = s[i];
        *n += 1;
        i++;
    }
    dst[*n] = 0;
    return 0;
}

static int app_n(char *dst, int cap, int *n, int d) {
    char s[4];
    int k = 0;
    if (d < 0 || d > 99) return -1;
    if (d >= 10) s[k++] = (char)('0' + d / 10);
    s[k++] = (char)('0' + d % 10);
    s[k] = 0;
    return app(dst, cap, n, s);
}

static int emit_mod(char *dst, int cap, const char *prefix) {
    int n = 0, i;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa module groupname\n")) return -1;
    if (app(dst, cap, &n, "/* Generated by tools/group-gen.cx from exec/c/compiler-routes.tsv.\n")) return -1;
    if (app(dst, cap, &n, "   Do not edit by hand. A group is the suffix before '/', or the whole suffix.\n")) return -1;
    if (app(dst, cap, &n, "   The ten suffixes stay on the route table. pp is already a net module stem.\n")) return -1;
    if (app(dst, cap, &n, "   A null out-pointer returns 4. An index outside 0..count-1 returns 2.\n")) return -1;
    if (app(dst, cap, &n, "   No libc and no include. */\n")) return -1;
    if (app(dst, cap, &n, "int ")) return -1;
    if (app(dst, cap, &n, prefix)) return -1;
    if (app(dst, cap, &n, "_count(void) {\n    return ")) return -1;
    if (app_n(dst, cap, &n, ngroups)) return -1;
    if (app(dst, cap, &n, ";\n}\n")) return -1;
    if (app(dst, cap, &n, "int ")) return -1;
    if (app(dst, cap, &n, prefix)) return -1;
    if (app(dst, cap, &n, "_at(int index, const char **name) {\n")) return -1;
    if (app(dst, cap, &n, "    if (!name) return 4;\n")) return -1;
    for (i = 0; i < ngroups; i++) {
        if (app(dst, cap, &n, "    if (index == ")) return -1;
        if (app_n(dst, cap, &n, i)) return -1;
        if (app(dst, cap, &n, ") { *name = \"")) return -1;
        if (app(dst, cap, &n, groups[i])) return -1;
        if (app(dst, cap, &n, "\"; return 0; }\n")) return -1;
    }
    if (app(dst, cap, &n, "    return 2;\n}\n")) return -1;
    return n;
}

static int emit_row(char *dst, int cap, int *n, const char *prefix, int i) {
    if (app(dst, cap, n, "    if (")) return -1;
    if (app(dst, cap, n, prefix)) return -1;
    if (app(dst, cap, n, "_at(")) return -1;
    if (app_n(dst, cap, n, i)) return -1;
    if (app(dst, cap, n, ", &name) || !tx_eqz(name, \"")) return -1;
    if (app(dst, cap, n, groups[i])) return -1;
    if (app(dst, cap, n, "\")) return 1;\n")) return -1;
    return 0;
}

static int emit_check(char *dst, int cap) {
    int n = 0, i;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa use compiler.groupname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use runtime.groupname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use sys.io\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use text.text\n")) return -1;
    if (app(dst, cap, &n, "/* Generated by tools/group-gen.cx. Narrow check of the four route groups. */\n")) return -1;
    if (app(dst, cap, &n, "int main(void) {\n")) return -1;
    if (app(dst, cap, &n, "    const char *name;\n")) return -1;
    if (app(dst, cap, &n, "    const char **missing;\n")) return -1;
    if (app(dst, cap, &n, "    missing = 0;\n")) return -1;
    if (app(dst, cap, &n, "    if (pgn_count() != ")) return -1;
    if (app_n(dst, cap, &n, ngroups)) return -1;
    if (app(dst, cap, &n, ") return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rgn_count() != ")) return -1;
    if (app_n(dst, cap, &n, ngroups)) return -1;
    if (app(dst, cap, &n, ") return 1;\n")) return -1;
    for (i = 0; i < ngroups; i++) {
        if (emit_row(dst, cap, &n, "pgn", i)) return -1;
        if (emit_row(dst, cap, &n, "rgn", i)) return -1;
    }
    if (app(dst, cap, &n, "    if (pgn_at(0, missing) != 4) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rgn_at(0, missing) != 4) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (pgn_at(-1, &name) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (pgn_at(")) return -1;
    if (app_n(dst, cap, &n, ngroups)) return -1;
    if (app(dst, cap, &n, ", &name) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rgn_at(-1, &name) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rgn_at(")) return -1;
    if (app_n(dst, cap, &n, ngroups)) return -1;
    if (app(dst, cap, &n, ", &name) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    sy_printf(\"CX_GROUP\\tok=")) return -1;
    if (app_n(dst, cap, &n, ngroups)) return -1;
    if (app(dst, cap, &n, "\\tfailed=0\\n\");\n")) return -1;
    if (app(dst, cap, &n, "    return 0;\n}\n")) return -1;
    return n;
}

static int same_bytes(const char *a, size_t an, const char *b, int bn) {
    int i;
    if (an != (size_t)bn) return 0;
    for (i = 0; i < bn; i++) if (a[i] != b[i]) return 0;
    return 1;
}

static int one_file(int dowrite, const char *path, const char *body, int n) {
    size_t on = 0;
    char *cur;
    if (dowrite) {
        if (cx_write(path, body, (size_t)n)) return fail("write");
        return 0;
    }
    cur = cx_read(path, &on);
    if (!cur) return fail(path);
    if (!same_bytes(cur, on, body, n)) return fail(path);
    return 0;
}

int main(int argc, char **argv) {
    size_t nb = 0;
    char *b;
    char file[FILECAP], check[CHECKCAP];
    int dowrite, fn, cn;
    if (argc != 2 || (!tx_eqz(argv[1], "--check") && !tx_eqz(argv[1], "--write"))) {
        sy_eprintf("group-gen\tusage\t--check|--write\n");
        return 2;
    }
    dowrite = tx_eqz(argv[1], "--write");
    b = cx_read(TSV, &nb);
    if (!b) return fail("tsv-read");
    if (parse_tsv(b, nb)) return 1;
    cn = emit_check(check, CHECKCAP);
    if (cn < 0) return fail("emit-check");
    fn = emit_mod(file, FILECAP, "pgn");
    if (fn < 0) return fail("emit-compiler");
    if (one_file(dowrite, "cx/compiler/groupname.cx", file, fn)) return 1;
    fn = emit_mod(file, FILECAP, "rgn");
    if (fn < 0) return fail("emit-runtime");
    if (one_file(dowrite, "cx/runtime/groupname.cx", file, fn)) return 1;
    if (one_file(dowrite, "tools/check-cx-group.cx", check, cn)) return 1;
    if (dowrite) sy_printf("GROUP_GEN\tWROTE\trows=%d\n", ngroups);
    else sy_printf("GROUP_GEN\tCHECK\trows=%d\n", ngroups);
    return 0;
}
