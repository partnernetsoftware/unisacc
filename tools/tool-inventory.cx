/* Report tracked working-tree tools; candidates are hints, never deletion advice or gates. */
#pragma unisa use sys.fs
#pragma unisa use sysx.process
#pragma unisa use mem.bytes
typedef struct {char *path,*dir,*checker;long lines,bytes,callers;char sha[65];int registered,check;} Tool;
static Tool *ts;static int nt;static const char *root=".";
static void die(const char *s){fprintf(stderr,"tool-inventory: %s\n",s);exit(2);}
static int ends(const char *s,const char *e){size_t n=strlen(s),z=strlen(e);return n>=z&&!memcmp(s+n-z,e,z);}
static char *run(char **a,long *n){np_result r={0};char why[300]={0};if(np_run(a,root,0,8,&r,why,sizeof why)||r.rc||r.residue){fprintf(stderr,"tool-inventory: git failed %s %s\n",why,r.err?r.err:"");np_free(&r);exit(2);}char *b=malloc(r.outn+1);if(!b)die("allocation");mm_copy(b, r.outn, r.out, r.outn);b[r.outn]=0;*n=r.outn;np_free(&r);return b;}
static char *readpath(const char *p,size_t *n){char full[8192];if(snprintf(full,sizeof full,"%s/%s",root,p)>=(int)sizeof full)die("path bound");return cx_read(full,n);}
static int regular(const char *p){char full[8192];struct stat st;if(snprintf(full,sizeof full,"%s/%s",root,p)>=(int)sizeof full)die("path bound");if(lstat(full,&st)){if(errno==ENOENT)return 0;die("lstat error");}return S_ISREG(st.st_mode);}
static int lookup(const char *p){int lo=0,hi=nt;while(lo<hi){int m=(lo+hi)/2,c=strcmp(ts[m].path,p);if(c<0)lo=m+1;else hi=m;}return lo<nt&&!strcmp(ts[lo].path,p)?lo:-1;}
static int textpath(const char *p){const char *ex[]={".cx",".c",".h",".md",".tsv",".json",".sh",".yml",".yaml",".txt"};for(int i=0;i<10;i++)if(ends(p,ex[i]))return 1;return 0;}
static int pathchar(int c){return (c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='/'||c=='_'||c=='-'||c=='.';}
int main(int argc,char **argv){int recent=10;for(int i=1;i<argc;i++){if(!strcmp(argv[i],"--root")&&i+1<argc)root=argv[++i];else if(!strcmp(argv[i],"--recent")&&i+1<argc){char *e;long v=strtol(argv[++i],&e,10);if(!*argv[i]||*e||v<0||v>10000)die("recent must be 0..10000");recent=v;}else die("usage --root DIR --recent N");}
 long ln;char *av[]={"git","ls-files","--stage","-z",0};char *list=run(av,&ln);char **paths=calloc((size_t)ln+1,sizeof *paths);if(!paths)die("allocation");int np=0,skipped=0;for(long at=0;at<ln;){char *s=list+at;size_t z=strlen(s);if(z>=(size_t)(ln-at))die("git path framing");at+=z+1;char *tab=strchr(s,'\t');if(!tab)die("git stage framing");*tab++=0;if(strpbrk(tab,"\r\n\t"))die("control byte in path");char *stage=strrchr(s,' ');if(!stage||strcmp(stage+1,"0"))die("unmerged index");if(strncmp(s,"100644 ",7)&&strncmp(s,"100755 ",7)){skipped++;continue;}if(!regular(tab)){skipped++;continue;}paths[np++]=tab;}
 ts=calloc(np?np:1,sizeof *ts);if(!ts)die("allocation");for(int i=0;i<np;i++)if(!strncmp(paths[i],"tools/",6)&&ends(paths[i],".cx")){size_t n;char *b=readpath(paths[i],&n);if(!b)die("tracked tool read");Tool *t=&ts[nt++];t->path=paths[i];t->bytes=n;for(size_t j=0;j<n;j++)if(b[j]=='\n')t->lines++;cx_sha256_hex(b,n,t->sha);free(b);t->dir=strdup(t->path);char *slash=strrchr(t->dir,'/');*slash=0;}
 if(getenv("TOOL_INVENTORY_TRACE"))fprintf(stderr,"inventory paths=%d tools=%d\n",np,nt);
 /* ls-files is byte sorted; tools retain that ordering for binary lookup. */
 size_t bn=0;char *batch=readpath("tests/batches.tsv",&bn);if(!batch&&errno!=ENOENT)die("batch table read");static char cp[8192];for(int i=0;i<nt;i++){Tool *t=&ts[i];const char *base=strrchr(t->path,'/')+1;if(!strncmp(base,"check-",6))t->check=1;else {(cx_fmt(cp, sizeof cp, "%s/check-%s", t->dir, base) ? exit(2) : (void)0);if(lookup(cp)<0)(cx_fmt(cp, sizeof cp, "tools/check-%s", base) ? exit(2) : (void)0);if(lookup(cp)>=0){t->check=1;t->checker=strdup(cp);}}}
 if(batch){static char *fields[16];for(char *p=batch;*p;){char *e=strchr(p,'\n');if(e)*e=0;int nf=0;for(char *s=p;nf<16;){fields[nf++]=s;char *q=strchr(s,'\t');if(!q)break;*q=0;s=q+1;}if(nf>3&&!strcmp(fields[1],"IMPLEMENTED"))for(int i=0;i<nt;i++)if(!strcmp(fields[3],ts[i].path)||(ts[i].checker&&!strcmp(fields[3],ts[i].checker)))ts[i].registered=1;if(!e)break;p=e+1;}free(batch);}
 int *seen=calloc(nt?nt:1,sizeof *seen);if(!seen)die("allocation");for(int i=0;i<np;i++)if(textpath(paths[i])){size_t n;if(getenv("TOOL_INVENTORY_TRACE"))fprintf(stderr,"caller %s\n",paths[i]);char *b=readpath(paths[i],&n);if(!b)die("tracked caller read");if(memchr(b,0,n)){free(b);continue;}memset(seen,0,nt*sizeof *seen);for(char *p=b;(p=strstr(p,"tools/"));){char *e=p;while(pathchar((unsigned char)*e))e++;char saved=*e;*e=0;int k=lookup(p);if(k>=0&&strcmp(paths[i],ts[k].path))seen[k]=1;*e=saved;p+=6;}for(int j=0;j<nt;j++)ts[j].callers+=seen[j];free(b);}
 long total=0,bytes=0;printf("TOOL_INVENTORY\tversion=1\tscope=tracked-index-regular-working-tree\tline_unit=LF-bytes\tcallers=lexical-full-tool-path-distinct-files\tthreshold=NONE\n");for(int i=0;i<nt;i++){Tool *t=&ts[i];total+=t->lines;bytes+=t->bytes;printf("FILE\t%s\tlines=%ld\tbytes=%ld\tsha=%s\tcaller_files=%ld\tregistered=%d\tpaired_check=%d\n",t->path,t->lines,t->bytes,t->sha,t->callers,t->registered,t->check);}
 for(int i=0;i<nt;i++){int first=1;for(int j=0;j<i;j++)if(!strcmp(ts[j].dir,ts[i].dir))first=0;if(first){long z=0,c=0;for(int j=i;j<nt;j++)if(!strcmp(ts[j].dir,ts[i].dir)){z+=ts[j].lines;c++;}printf("DIRECTORY\t%s\tfiles=%ld\tlines=%ld\n",ts[i].dir,c,z);}}
 for(int i=0;i<nt;i++){Tool *t=&ts[i];if(!t->check)printf("CANDIDATE\tmissing-paired-check\t%s\n",t->path);if(!t->registered)printf("CANDIDATE\tno-implemented-batch-entry\t%s\n",t->path);if(!t->callers)printf("CANDIDATE\tno-lexical-caller\t%s\n",t->path);for(int j=0;j<i;j++)if(t->bytes==ts[j].bytes&&!strcmp(t->sha,ts[j].sha))printf("CANDIDATE\texact-content-duplicate\t%s\t%s\n",ts[j].path,t->path);}
 if(recent){char opt[40];(cx_fmt(opt, sizeof opt, "-%d", recent) ? exit(2) : (void)0);char *g[]={"git","-c","core.quotepath=false","log",opt,"--format=COMMIT%x09%H","--numstat","--no-renames",0};long gn;char *b=run(g,&gn),commit[65]="";long add=0,del=0,files=0;for(char *p=b;*p;){char *e=strchr(p,'\n');if(e)*e=0;if(!strncmp(p,"COMMIT\t",7)){if(*commit)printf("RECENT\t%s\tadded=%ld\tdeleted=%ld\tnet=%ld\tfiles=%ld\n",commit,add,del,add-del,files);(cx_fmt(commit, sizeof commit, "%s", p+7) ? exit(2) : (void)0);add=del=files=0;}else {char *t=strchr(p,'\t'),*u=t?strchr(t+1,'\t'):0;if(u&&!strncmp(u+1,"tools/",6)&&ends(u+1,".cx")){*t=0;*u=0;if(strcmp(p,"-")&&strcmp(t+1,"-")){char *a,*d;long x=strtol(p,&a,10),y=strtol(t+1,&d,10);if(*a||*d||x<0||y<0)die("git numstat");add+=x;del+=y;}else printf("RECENT_BINARY\t%s\t%s\n",commit,u+1);files++;}}if(!e)break;p=e+1;}if(*commit)printf("RECENT\t%s\tadded=%ld\tdeleted=%ld\tnet=%ld\tfiles=%ld\n",commit,add,del,add-del,files);free(b);}
 printf("TOOL_INVENTORY_COMPLETE\tfiles=%d\tlines=%ld\tbytes=%ld\tskipped_nonregular_or_missing=%d\trecent_requested=%d\tcandidates=REPORT_ONLY\n",nt,total,bytes,skipped,recent);return 0;
}
