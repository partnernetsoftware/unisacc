/* check-old-product-material: from the trusted checkout root, no network.
 * gate: three materials present -> READY; missing old -> UNKNOWN no-producer rc 3; no receipt -> rc 3;
 * old copy of the candidate -> REFUSE; --candidate other bytes -> REFUSE candidate-mismatch;
 * changed material -> REFUSE. prepare: old version equal to the candidate version and models outside
 * the candidate directory are refused before any download. Ends CHECK_OLD_PRODUCT_MATERIAL. */
#pragma unisa use sys.fs
#pragma unisa use fsx.fs
#pragma unisa use sys.posix
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use sys.sha
#pragma unisa use sysx.process
#pragma unisa use text.text
#pragma unisa use mem.heap

static int pass,fail;
static char root[4096];
static const char *dir;
static void ck(int ok,const char *what){if(ok)pass++;else{fail++;printf("FAIL\t%s\n",what);}}
static void die(const char *s){printf("CHECK_OLD_PRODUCT_MATERIAL\tREFUSE\t%s\n",s);exit(2);}
static void put(const char *leaf,const char *s,char out[4096]){if(cx_path_join(out,4096,dir,leaf))die("path");sy_unlink(out);if(sy_write_file(out,s,tx_len(s,1<<20),0600))die("fixture write");}
static void sha(const char *p,char h[65]){unsigned char *b;int64_t n;if(sy_read_file(p,&b,&n,1<<20)||sy_sha256_any_hex(b,n,h))die("fixture sha");mm_free(b);}
static int run(char **args,np_result *r){
    char launcher[4096],why[256],*v[16];int n=0;if(cx_path_join(launcher,sizeof launcher,root,"unisacc.com"))die("path");
    v[n++]="sh";v[n++]=launcher;v[n++]="tools/old-product-material.cx";v[n++]="--";for(int i=0;args[i]&&n<15;i++)v[n++]=args[i];v[n]=0;
    memset(r,0,sizeof *r);if(np_run(v,root,0,30,r,why,sizeof why)||r->residue)die("tool transport");return r->rc;
}
static int has(np_result *r,const char *s){long n=tx_len(s,256);return (r->out&&tx_find(r->out,(long)r->outn,s,n)>=0)||(r->err&&tx_find(r->err,(long)r->errn,s,n)>=0);}
static void receipt(const char *sub,const char *body){char d[4096],p[4096];if(cx_path_join(d,sizeof d,dir,sub))die("path");sy_mkdir(d,0700);if(cx_path_join(p,sizeof p,d,"materials.tsv"))die("path");sy_unlink(p);if(sy_write_file(p,body,tx_len(body,1<<16),0600))die("receipt write");}
int main(void){
    char a[4096],b[4096],c[4096],ha[65],hb[65],hc[65],body[30000],sub[4096];np_result r;
    if(sy_realpath(".",root,sizeof root)<0)die("root");
    int scratch;
    if(fsx_scratch(&scratch,"check-opm") || !(dir=fsx_scratch_dir(scratch)))die("private dir");
    put("old.bin","old product bytes\n",a);put("new.bin","candidate bytes\n",b);put("other.bin","another candidate\n",c);
    sha(a,ha);sha(b,hb);sha(c,hc);
    /* (1) all three present */
    cx_fmt(body,sizeof body,"old-product-material-v1\nstatus\tPREPARED-no-test-result\nold-product\t%s\t%s\nnew-product\t%s\t%s\nnew-models\t%s\t%s\n",a,ha,b,hb,b,hb);
    receipt("ok",body);cx_path_join(sub,sizeof sub,dir,"ok");
    char *g1[]={"gate",sub,0};int rc=run(g1,&r);
    ck(rc==0&&has(&r,"OLD_PRODUCT_MATERIAL\tREADY\told-product=")&&has(&r,"\tnew-models="),"three-materials-ready");np_free(&r);
    char *g2[]={"gate",sub,"--candidate",b,0};rc=run(g2,&r);ck(rc==0,"candidate-bound-ready");np_free(&r);
    /* (2) bound to another candidate */
    char *g3[]={"gate",sub,"--candidate",c,0};rc=run(g3,&r);ck(rc==2&&has(&r,"reason=candidate-mismatch"),"candidate-mismatch-refused");np_free(&r);
    /* (3) missing old */
    cx_fmt(body,sizeof body,"old-product-material-v1\nstatus\tPREPARED-no-test-result\nnew-product\t%s\t%s\nnew-models\t%s\t%s\n",b,hb,b,hb);
    receipt("noold",body);cx_path_join(sub,sizeof sub,dir,"noold");
    char *g4[]={"gate",sub,0};rc=run(g4,&r);ck(rc==3&&has(&r,"UNKNOWN\tno-producer=old-product")&&!has(&r,"READY"),"missing-old-unknown");np_free(&r);
    /* (4) missing models */
    cx_fmt(body,sizeof body,"old-product-material-v1\nstatus\tPREPARED-no-test-result\nold-product\t%s\t%s\nnew-product\t%s\t%s\n",a,ha,b,hb);
    receipt("nomodels",body);cx_path_join(sub,sizeof sub,dir,"nomodels");
    char *g5[]={"gate",sub,0};rc=run(g5,&r);ck(rc==3&&has(&r,"no-producer=new-models"),"missing-models-unknown");np_free(&r);
    /* (5) no receipt at all */
    cx_path_join(sub,sizeof sub,dir,"absent");
    char *g6[]={"gate",sub,0};rc=run(g6,&r);ck(rc==3&&has(&r,"no-producer=old-product"),"no-receipt-unknown");np_free(&r);
    /* (6) the old lane is a copy of the candidate (same bytes, other path) */
    char cp[4096];put("copy.bin","candidate bytes\n",cp);
    cx_fmt(body,sizeof body,"old-product-material-v1\nstatus\tPREPARED-no-test-result\nold-product\t%s\t%s\nnew-product\t%s\t%s\nnew-models\t%s\t%s\n",cp,hb,b,hb,b,hb);
    receipt("copy",body);cx_path_join(sub,sizeof sub,dir,"copy");
    char *g7[]={"gate",sub,0};rc=run(g7,&r);ck(rc==2&&has(&r,"reason=old-product-is-candidate-copy"),"candidate-copy-refused");np_free(&r);
    /* (7) material changed after preparation */
    cx_fmt(body,sizeof body,"old-product-material-v1\nstatus\tPREPARED-no-test-result\nold-product\t%s\t%s\nnew-product\t%s\t%s\nnew-models\t%s\t%s\n",a,hc,b,hb,b,hb);
    receipt("changed",body);cx_path_join(sub,sizeof sub,dir,"changed");
    char *g8[]={"gate",sub,0};rc=run(g8,&r);ck(rc==2&&has(&r,"reason=material-identity-changed"),"changed-material-refused");np_free(&r);
    /* (8) prepare: old version equal to candidate version, refused before download */
    char cand[4096],cache[4096],out[4096];if(cx_path_join(cand,sizeof cand,root,"unisacc.com")||cx_path_join(cache,sizeof cache,dir,"cache")||cx_path_join(out,sizeof out,dir,"mat"))die("path");
    np_result v={0};char why[256];char *vv[]={"sh",cand,"--version",0};if(np_run(vv,0,0,10,&v,why,sizeof why)||v.rc||v.outn<10)die("candidate version");
    char ver[64];if(tx_copy(ver,sizeof ver,v.out+8,v.outn-9))die("version bound");np_free(&v);
    char *p1[]={"prepare",root,cand,cache,out,"--old-version",ver,0};rc=run(p1,&r);
    ck(rc==2&&has(&r,"reason=old-version-equals-candidate-version")&&sy_exists(out)!=1,"same-version-refused");np_free(&r);
    /* (9) prepare: models outside the candidate directory */
    char *p2[]={"prepare",root,cand,cache,out,"--models",a,0};rc=run(p2,&r);
    ck(rc==2&&has(&r,"reason=models-not-bound-to-candidate")&&sy_exists(out)!=1,"foreign-models-refused");np_free(&r);
    /* (10) layout switch with same candidate bytes & shared prep-cache must not fail material-absent */
    {
        char mir[4096],fake_old[4096],fsha[65],prep[4096],la[4096],lb[4096],assets[512],shcmd[8192];
        const char *old_script="#!/bin/sh\necho \"unisacc 0.0.1\"\n";
        long old_len=tx_len(old_script,256);
        if(cx_path_join(mir,sizeof mir,dir,"mirror")||cx_path_join(fake_old,sizeof fake_old,mir,"unisacc.com")||
           cx_path_join(prep,sizeof prep,dir,"shared-prep")||cx_path_join(la,sizeof la,dir,"layout-a")||
           cx_path_join(lb,sizeof lb,dir,"layout-b"))die("layout path");
        sy_mkdir(mir,0700);sy_mkdir(prep,0700);
        if(sy_write_file(fake_old,old_script,old_len,0700))die("fake old write");
        sha(fake_old,fsha);
        if(cx_fmt(assets,sizeof assets,"version\trepo\ttag\tasset\tbytes\tsha256\n0.0.1\tpartnernetsoftware/unisacc\tv0.0.1\tunisacc.com\t%ld\t%s\n",old_len,fsha))die("assets fmt");
        for(int k=0;k<2;k++){
            const char *ld=k==0?la:lb;
            char td[4096],ap[4096],up[4096];
            if(cx_path_join(td,sizeof td,ld,"tools")||cx_path_join(ap,sizeof ap,td,"old-product-assets.tsv")||cx_path_join(up,sizeof up,ld,"unisacc.com"))die("ld path");
            sy_mkdir(ld,0700);
            if(cx_fmt(shcmd,sizeof shcmd,
                "for d in cx cxroot.tsv ext include tests exec build src apps seed weights iterate ujs tools; do "
                "[ -e '%s/'\"$d\" ] && (cp -al '%s/'\"$d\" '%s/'\"$d\" 2>/dev/null || cp -a '%s/'\"$d\" '%s/'\"$d\"); done && "
                "rm -f '%s/tools/old-product-assets.tsv'",
                root,root,ld,root,ld,ld))die("mk layout fmt");
            { char *sv[]={"sh","-c",shcmd,0}; char why[256]; np_result sr={0};
              if(np_run(sv,root,0,15,&sr,why,sizeof why)||sr.rc||sr.residue)die("mk layout"); np_free(&sr); }
            if(sy_write_file(ap,assets,tx_len(assets,sizeof assets),0600))die("assets write");
            if(sy_copy(cand,up,0755))die("cand copy");
        }
        if(cx_fmt(shcmd,sizeof shcmd,
            "UNISACC_PREP_CACHE='%s' UNISACC_OLD_PRODUCT_MIRROR='%s' UNISACC_OLD_PRODUCT_VERSION=0.0.1 "
            "sh '%s' tools/affected.cx -- --root '%s' --materials-dump --ids netregen-small-lnx-x86_64 --prepare-materials",
            prep,mir,cand,la))die("la cmd");
        { char *sv[]={"sh","-c",shcmd,0}; char why[256]; np_result sr={0};
          if(np_run(sv,root,0,40,&sr,why,sizeof why)||sr.residue)die("la run");
          int ok_a=(sr.rc==0&&has(&sr,"layout-a/unisacc.com")&&!has(&sr,"material-absent"));
          if(!ok_a)fprintf(stderr,"la rc=%d out=%.*s err=%.*s\n",sr.rc,(int)(sr.outn<300?sr.outn:300),sr.out?sr.out:"",(int)(sr.errn<300?sr.errn:300),sr.err?sr.err:"");
          ck(ok_a,"layout-a-prepared");
          np_free(&sr); }
        /* Remove layout A so stale receipt pointing to layout-a/unisacc.com would fail material-absent */
        { char *rmv[]={"rm","-rf",la,0}; char why[256]; np_result sr={0};
          if(np_run(rmv,root,0,15,&sr,why,sizeof why)||sr.rc)die("rm layout-a"); np_free(&sr); }
        if(cx_fmt(shcmd,sizeof shcmd,
            "UNISACC_PREP_CACHE='%s' UNISACC_OLD_PRODUCT_MIRROR='%s' UNISACC_OLD_PRODUCT_VERSION=0.0.1 "
            "sh '%s' tools/affected.cx -- --root '%s' --materials-dump --ids netregen-small-lnx-x86_64 --prepare-materials",
            prep,mir,cand,lb))die("lb cmd");
        { char *sv[]={"sh","-c",shcmd,0}; char why[256]; np_result sr={0};
          if(np_run(sv,root,0,40,&sr,why,sizeof why)||sr.residue)die("lb run");
          int ok_b=(sr.rc==0&&has(&sr,"layout-b/unisacc.com")&&!has(&sr,"material-absent"));
          if(!ok_b)fprintf(stderr,"lb rc=%d out=%.*s err=%.*s\n",sr.rc,(int)(sr.outn<300?sr.outn:300),sr.out?sr.out:"",(int)(sr.errn<300?sr.errn:300),sr.err?sr.err:"");
          ck(ok_b,"layout-b-switch-no-material-absent");
          np_free(&sr); }
    }
    printf("CHECK_OLD_PRODUCT_MATERIAL\tpass=%d\tfail=%d\n",pass,fail);
    return fail?1:0;
}
