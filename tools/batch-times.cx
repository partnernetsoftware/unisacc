/* tools/batch-times.cx -- generate build/batch-times.tsv from tests/batches.tsv and strict-*.tsv prerun rows.
 *
 *   sh ./unisacc.com tools/batch-times.cx -- --write|--check [--root DIR]
 *       [--batches FILE] [--out FILE] [--strict-dir DIR]... [--strict FILE]...
 *       [--threshold-pct 1..99]
 *
 * Per-batch metrics (across observed PASS timing samples, ascending array a[0..k-1]):
 *   max_ms      = a[k-1] (historical maximum observed sample)
 *   median_ms   = a[(k-1)/2] (lower median / p50)
 *   p95_ms      = a[ceil(0.95*k) - 1]
 *   budget_ms   = budget_seconds * 1000 (from tests/batches.tsv, never raised)
 *   headroom_ms = budget_ms - p95_ms
 *   timeouts    = count of TIMEOUT rows (or rc 124/142); counted for alarm, never mixed into timing samples
 *   fails       = count of non-timeout FAIL rows; recorded for visibility, does not trigger near-bound
 *
 * Directory scan recurses up to depth 4 under strict-dir (depth 5+ ignored).
 * Exceeding file/sample bounds refuses (rc 2) instead of silently truncating.
 *
 * Alarm: p95_ms > threshold_pct% of budget_ms (default 70%) or timeouts > 0 marks status=near-bound
 * and emits a split ticket field plus a # SPLIT_TICKET summary line.
 *
 * Exit codes: 0 ok/wrote, 1 drift (--check), 2 refuse/usage.
 * Check: tools/check-batch-times.cx. */
#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.bytes
#pragma unisa use mem.heap

#define BT_MAX_BATCHES 4096
#define BT_MAX_SAMPLES 1024
#define BT_MAX_FILES 1024
#define BT_MAX_DIRS 32
#define BT_MAX_DEPTH 4
#define BT_PW 4400

typedef struct {
    char id[128];
    long budget_ms;
    long *samples;
    int nsamples;
    int cap_samples;
    int timeouts;
    int fails;
    char source[512];
} BtBatch;

static BtBatch bt_batches[BT_MAX_BATCHES];
static int bt_nbatches = 0;

static char bt_files[BT_MAX_FILES][BT_PW];
static int bt_nfiles = 0;

static const char *bt_dirs[BT_MAX_DIRS];
static int bt_ndirs = 0;

static int bt_refuse(const char *why) {
    sy_printf("REFUSE\tbatch-times\t%s\n", why);
    return 2;
}

static int bt_is_digits(const char *s, long len) {
    if (len <= 0 || len > 18) return 0;
    for (long i = 0; i < len; i++) {
        if (s[i] < '0' || s[i] > '9') return 0;
    }
    return 1;
}

static long bt_parse_long(const char *s, long len) {
    long v = 0;
    for (long i = 0; i < len; i++) {
        v = v * 10 + (s[i] - '0');
    }
    return v;
}

static int bt_ends_with(const char *s, const char *suf) {
    size_t sl = strlen(s), fl = strlen(suf);
    return sl >= fl && memcmp(s + sl - fl, suf, fl) == 0;
}

static int bt_has_sub(const char *s, const char *sub) {
    size_t sl = strlen(s), nl = strlen(sub);
    if (nl == 0 || nl > sl) return 0;
    for (size_t i = 0; i + nl <= sl; i++) {
        if (s[i] == sub[0] && memcmp(s + i, sub, nl) == 0) return 1;
    }
    return 0;
}

static int bt_is_strict_name(const char *name) {
    if (!bt_ends_with(name, ".tsv")) return 0;
    return bt_has_sub(name, "strict");
}

static int bt_is_derive_log_name(const char *name) {
    /* Exclude hand-typed tables (derive-timings.tsv / derive-weights.tsv); only scan real log/evidence files. */
    if (tx_eqz(name, "derive-timings.tsv") || tx_eqz(name, "derive-weights.tsv") ||
        tx_eqz(name, "derive-times.tsv") || tx_eqz(name, "derive.tsv")) return 0;
    return bt_ends_with(name, ".log") || bt_ends_with(name, ".txt") || bt_ends_with(name, ".tsv");
}

static int bt_cmp_str(const void *a, const void *b) {
    return strcmp((const char *)a, (const char *)b);
}

static int bt_cmp_batch(const void *a, const void *b) {
    const BtBatch *ba = (const BtBatch *)a;
    const BtBatch *bb = (const BtBatch *)b;
    return strcmp(ba->id, bb->id);
}

static int bt_cmp_long(const void *a, const void *b) {
    long la = *(const long *)a;
    long lb = *(const long *)b;
    if (la < lb) return -1;
    if (la > lb) return 1;
    return 0;
}

static int bt_find_batch(const char *id, long len) {
    if (len <= 0 || len >= 127) return -1;
    int lo = 0, hi = bt_nbatches - 1;
    while (lo <= hi) {
        int mid = lo + (hi - lo) / 2;
        const char *cur = bt_batches[mid].id;
        long cl = (long)strlen(cur);
        long ml = cl < len ? cl : len;
        int c = memcmp(cur, id, (size_t)ml);
        if (c == 0) {
            if (cl == len) return mid;
            c = cl < len ? -1 : 1;
        }
        if (c < 0) lo = mid + 1;
        else hi = mid - 1;
    }
    return -1;
}

static int bt_add_sample(BtBatch *cur, long ms) {
    if (cur->nsamples >= BT_MAX_SAMPLES) return bt_refuse("too-many-samples");
    if (cur->nsamples >= cur->cap_samples) {
        int ncap = cur->cap_samples ? cur->cap_samples * 2 : 32;
        if (ncap > BT_MAX_SAMPLES) ncap = BT_MAX_SAMPLES;
        long *ns = (long *)mm_alloc((size_t)ncap * sizeof(long));
        if (!ns) return bt_refuse("oom");
        if (cur->samples && cur->nsamples > 0) {
            mm_copy(ns, (long)((size_t)ncap * sizeof(long)), cur->samples, (long)((size_t)cur->nsamples * sizeof(long)));
        }
        if (cur->samples) mm_free(cur->samples);
        cur->samples = ns;
        cur->cap_samples = ncap;
    }
    cur->samples[cur->nsamples++] = ms;
    return 0;
}

static int bt_load_batches(const char *path) {
    size_t n = 0;
    char *b = cx_read(path, &n);
    if (!b) return bt_refuse("unreadable-batches-tsv");
    bt_nbatches = 0;
    long pos = 0;
    while (pos < (long)n) {
        long ls = pos;
        while (pos < (long)n && b[pos] != '\n') pos++;
        long le = pos;
        if (pos < (long)n) pos++;
        if (le > ls && b[le - 1] == '\r') le--;
        if (le <= ls || b[ls] == '#') continue;
        const char *cols[16];
        long clens[16];
        int nc = 0;
        long p = ls;
        while (nc < 16) {
            long cs = p;
            while (p < le && b[p] != '\t') p++;
            cols[nc] = b + cs;
            clens[nc] = p - cs;
            nc++;
            if (p >= le) break;
            p++;
        }
        if (nc < 7) continue;
        if (clens[0] == 2 && memcmp(cols[0], "id", 2) == 0) continue;
        if (!bt_is_digits(cols[6], clens[6])) continue;
        if (clens[0] <= 0 || clens[0] >= 127) continue;
        if (bt_nbatches >= BT_MAX_BATCHES) {
            free(b);
            return bt_refuse("too-many-batches");
        }
        BtBatch *cur = &bt_batches[bt_nbatches++];
        mm_copy(cur->id, sizeof cur->id, cols[0], (size_t)clens[0]);
        cur->id[clens[0]] = 0;
        cur->budget_ms = bt_parse_long(cols[6], clens[6]) * 1000L;
        cur->samples = 0;
        cur->nsamples = 0;
        cur->cap_samples = 0;
        cur->timeouts = 0;
        cur->fails = 0;
        cur->source[0] = 0;
    }
    free(b);
    if (bt_nbatches == 0) return bt_refuse("empty-batches-tsv");
    qsort(bt_batches, (size_t)bt_nbatches, sizeof bt_batches[0], bt_cmp_batch);
    return 0;
}

static int bt_load_derive_facts(const char *path) {
    size_t n = 0;
    char *b = cx_read(path, &n);
    if (!b) return bt_refuse("unreadable-derive-tsv");
    bt_nbatches = 0;
    long pos = 0;
    while (pos < (long)n) {
        long ls = pos;
        while (pos < (long)n && b[pos] != '\n') pos++;
        long le = pos;
        if (pos < (long)n) pos++;
        if (le > ls && b[le - 1] == '\r') le--;
        if (le <= ls || b[ls] == '#') continue;
        const char *cols[12];
        long clens[12];
        int nc = 0;
        long p = ls;
        while (nc < 12) {
            long cs = p;
            while (p < le && b[p] != '\t') p++;
            cols[nc] = b + cs;
            clens[nc] = p - cs;
            nc++;
            if (p >= le) break;
            p++;
        }
        if (nc < 8 || clens[0] <= 0 || clens[0] >= 127) continue;
        if (clens[0] == 4 && memcmp(cols[0], "name", 4) == 0) continue;
        if (!bt_is_digits(cols[7], clens[7])) continue;
        if (bt_nbatches >= BT_MAX_BATCHES) {
            free(b);
            return bt_refuse("too-many-batches");
        }
        BtBatch *cur = &bt_batches[bt_nbatches++];
        mm_copy(cur->id, sizeof cur->id, cols[0], (size_t)clens[0]);
        cur->id[clens[0]] = 0;
        cur->budget_ms = bt_parse_long(cols[7], clens[7]) * 1000L;
        cur->samples = 0;
        cur->nsamples = 0;
        cur->cap_samples = 0;
        cur->timeouts = 0;
        cur->fails = 0;
        cur->source[0] = 0;
    }
    free(b);
    if (bt_nbatches == 0) return bt_refuse("empty-derive-tsv");
    qsort(bt_batches, (size_t)bt_nbatches, sizeof bt_batches[0], bt_cmp_batch);
    return 0;
}

static void bt_record_source(BtBatch *cur, const char *rel_path) {
    if (!cur->source[0] && rel_path && rel_path[0]) {
        size_t pl = strlen(rel_path);
        if (pl >= sizeof cur->source) pl = sizeof cur->source - 1;
        mm_copy(cur->source, sizeof cur->source, rel_path, pl);
        cur->source[pl] = 0;
    }
}

/* Resolve PATH to a canonical repo-relative path under ROOT; refuse paths escaping ROOT. */
static int bt_rel_source_under_root(const char *root, const char *path, char *rel_out, size_t rcap) {
    char abs_root[BT_PW], abs_path[BT_PW];
    if (sy_realpath(root, abs_root, (int)sizeof abs_root) < 0 || !abs_root[0]) return bt_refuse("bad-root");
    if (sy_realpath(path, abs_path, (int)sizeof abs_path) < 0 || !abs_path[0]) return bt_refuse("unreadable-derive-log");
    size_t rl = strlen(abs_root);
    if (strncmp(abs_path, abs_root, rl) != 0 || abs_path[rl] != '/') {
        return bt_refuse("source-outside-root");
    }
    const char *rel = abs_path + rl + 1;
    if (!rel[0] || strlen(rel) >= rcap) return bt_refuse("path-bound");
    mm_copy(rel_out, rcap, rel, strlen(rel) + 1);
    return 0;
}

static int bt_load_derive_log(const char *root, const char *path) {
    /* Never ingest hand-typed timing/weight tables even if passed explicitly. */
    if (bt_ends_with(path, "derive-timings.tsv") || bt_ends_with(path, "derive-weights.tsv")) {
        return bt_refuse("hand-typed-derive-table-forbidden");
    }
    char rel_src[512];
    int rrc = bt_rel_source_under_root(root, path, rel_src, sizeof rel_src);
    if (rrc) return rrc;
    size_t n = 0;
    char *b = cx_read(path, &n);
    if (!b) return bt_refuse("unreadable-derive-log");
    long pos = 0;
    while (pos < (long)n) {
        long ls = pos;
        while (pos < (long)n && b[pos] != '\n') pos++;
        long le = pos;
        if (pos < (long)n) pos++;
        if (le > ls && b[le - 1] == '\r') le--;
        if (le - ls < 8 || memcmp(b + ls, "DERIVE\t", 7) != 0) continue;
        const char *cols[8];
        long clens[8];
        int nc = 0;
        long p = ls;
        while (nc < 8) {
            long cs = p;
            while (p < le && b[p] != '\t') p++;
            cols[nc] = b + cs;
            clens[nc] = p - cs;
            nc++;
            if (p >= le) break;
            p++;
        }
        if (nc < 4) continue;
        int idx = bt_find_batch(cols[1], clens[1]);
        if (idx < 0) continue;
        const char *st = cols[2];
        long stl = clens[2];
        if (stl == 7 && memcmp(st, "SKIPPED", 7) == 0) continue;
        /* Require bounded integer ms on every accepted row before recording source or counters. */
        if (!bt_is_digits(cols[3], clens[3])) continue;
        long ms = bt_parse_long(cols[3], clens[3]);
        if (ms < 0 || ms > 36000000L) continue;
        if (stl == 7 && memcmp(st, "TIMEOUT", 7) == 0) {
            /* Exact TIMEOUT token only; NEVER added to timing samples. */
            bt_batches[idx].timeouts++;
            bt_record_source(&bt_batches[idx], rel_src);
            continue;
        }
        if ((stl == 4 && memcmp(st, "FAIL", 4) == 0) ||
            (stl == 5 && memcmp(st, "DRIFT", 5) == 0) ||
            (stl == 5 && memcmp(st, "ERROR", 5) == 0) ||
            (stl == 7 && memcmp(st, "REFUSED", 7) == 0)) {
            bt_batches[idx].fails++;
            bt_record_source(&bt_batches[idx], rel_src);
            continue;
        }
        if ((stl == 2 && memcmp(st, "OK", 2) == 0) ||
            (stl == 4 && memcmp(st, "PASS", 4) == 0) ||
            (stl == 5 && memcmp(st, "WROTE", 5) == 0) ||
            (stl == 5 && memcmp(st, "MATCH", 5) == 0)) {
            int rc = bt_add_sample(&bt_batches[idx], ms);
            if (rc) { free(b); return rc; }
            bt_record_source(&bt_batches[idx], rel_src);
        }
    }
    free(b);
    return 0;
}

static int bt_add_file(const char *path) {
    char canon[BT_PW];
    const char *use = path;
    if (sy_realpath(path, canon, (int)sizeof canon) >= 0 && canon[0]) {
        use = canon;
    }
    size_t len = strlen(use);
    if (len == 0 || len >= BT_PW) return bt_refuse("path-too-long");
    for (int i = 0; i < bt_nfiles; i++) {
        if (tx_eqz(bt_files[i], use)) return 0;
    }
    if (bt_nfiles >= BT_MAX_FILES) return bt_refuse("too-many-files");
    mm_copy(bt_files[bt_nfiles], BT_PW, use, len + 1);
    bt_nfiles++;
    return 0;
}

static int bt_scan_dir(const char *dir, int depth, int derive_mode) {
    if (depth > BT_MAX_DEPTH) return 0;
    sy_dir_t d;
    if (sy_dir_open(&d, dir)) return bt_refuse("unreadable-strict-dir");
    int next;
    while ((next = sy_dir_next(&d)) == 1) {
        if (tx_eqz(d.name, ".") || tx_eqz(d.name, "..")) continue;
        char q[BT_PW];
        if (cx_fmt(q, sizeof q, "%s/%s", dir, d.name)) {
            sy_dir_close(&d);
            return bt_refuse("path-bound");
        }
        sy_stat_t st;
        if (sy_stat(q, &st)) continue;
        if (st.kind == 'd' && depth < BT_MAX_DEPTH) {
            int rc = bt_scan_dir(q, depth + 1, derive_mode);
            if (rc) {
                sy_dir_close(&d);
                return rc;
            }
        } else if (st.kind == 'f' && (derive_mode ? bt_is_derive_log_name(d.name) : bt_is_strict_name(d.name))) {
            int rc = bt_add_file(q);
            if (rc) {
                sy_dir_close(&d);
                return rc;
            }
        }
    }
    sy_dir_close(&d);
    if (next < 0) return bt_refuse("dir-read-error");
    return 0;
}

static int bt_is_timeout_row(const char *st, long stl, const char *rc_col, long rcl) {
    if (st && stl == 7 && memcmp(st, "TIMEOUT", 7) == 0) return 1;
    if (rc_col && bt_is_digits(rc_col, rcl)) {
        long rcv = bt_parse_long(rc_col, rcl);
        if (rcv == 124 || rcv == 142) return 1;
    }
    return 0;
}

static int bt_is_fail_row(const char *st, long stl) {
    return st && stl == 4 && memcmp(st, "FAIL", 4) == 0;
}

static int bt_load_strict_file(const char *path) {
    size_t n = 0;
    char *b = cx_read(path, &n);
    if (!b) return bt_refuse("unreadable-strict-file");
    long pos = 0;
    while (pos < (long)n) {
        long ls = pos;
        while (pos < (long)n && b[pos] != '\n') pos++;
        long le = pos;
        if (pos < (long)n) pos++;
        if (le > ls && b[le - 1] == '\r') le--;
        if (le <= ls || b[ls] == '#') continue;
        if (le - ls >= 4 && memcmp(b + ls, "RAW\t", 4) == 0) continue;
        if (le - ls >= 8 && memcmp(b + ls, "SUMMARY\t", 8) == 0) continue;
        if (le - ls >= 14 && memcmp(b + ls, "PRERUN_WINDOW\t", 14) == 0) continue;
        if (le - ls >= 11 && memcmp(b + ls, "CHECKPOINT\t", 11) == 0) continue;
        const char *cols[10];
        long clens[10];
        int nc = 0;
        long p = ls;
        while (nc < 10) {
            long cs = p;
            while (p < le && b[p] != '\t') p++;
            cols[nc] = b + cs;
            clens[nc] = p - cs;
            nc++;
            if (p >= le) break;
            p++;
        }
        if (nc >= 1 && ((clens[0] == 5 && memcmp(cols[0], "batch", 5) == 0) ||
                        (clens[0] == 2 && memcmp(cols[0], "id", 2) == 0))) {
            continue;
        }
        const char *id_col = 0, *ms_col = 0, *st_col = 0, *rc_col = 0;
        long id_len = 0, ms_len = 0, st_len = 0, rc_len = 0;
        if (nc >= 4 && bt_is_digits(cols[0], clens[0]) && bt_is_digits(cols[3], clens[3])) {
            id_col = cols[1]; id_len = clens[1];
            st_col = cols[2]; st_len = clens[2];
            ms_col = cols[3]; ms_len = clens[3];
        } else if (nc >= 6 && bt_is_digits(cols[5], clens[5])) {
            id_col = cols[0]; id_len = clens[0];
            st_col = cols[2]; st_len = clens[2];
            rc_col = cols[3]; rc_len = clens[3];
            ms_col = cols[5]; ms_len = clens[5];
        } else if (nc >= 4 && (bt_is_timeout_row(cols[2], clens[2], cols[3], clens[3]) || bt_is_fail_row(cols[2], clens[2]))) {
            id_col = cols[0]; id_len = clens[0];
            st_col = cols[2]; st_len = clens[2];
            rc_col = cols[3]; rc_len = clens[3];
        } else if (nc >= 2 && bt_is_digits(cols[1], clens[1])) {
            id_col = cols[0]; id_len = clens[0];
            ms_col = cols[1]; ms_len = clens[1];
        }
        if (!id_col) continue;
        int idx = bt_find_batch(id_col, id_len);
        if (idx < 0) continue;
        if (st_col && !(st_len == 4 && memcmp(st_col, "PASS", 4) == 0)) {
            if (bt_is_timeout_row(st_col, st_len, rc_col, rc_len)) {
                bt_batches[idx].timeouts++;
            } else if (bt_is_fail_row(st_col, st_len)) {
                bt_batches[idx].fails++;
            }
            continue;
        }
        if (!ms_col) continue;
        long ms = bt_parse_long(ms_col, ms_len);
        int rc = bt_add_sample(&bt_batches[idx], ms);
        if (rc) { free(b); return rc; }
    }
    free(b);
    return 0;
}

typedef struct {
    char *buf;
    size_t len;
    size_t cap;
    int oom;
} BtBuf;

static void bt_buf_put(BtBuf *bb, const char *s, size_t n) {
    if (bb->oom || n == 0) return;
    if (bb->len + n + 1 > bb->cap) {
        size_t ncap = bb->cap ? bb->cap * 2 : 65536;
        while (ncap < bb->len + n + 1) ncap *= 2;
        char *nb = (char *)mm_alloc(ncap);
        if (!nb) { bb->oom = 1; return; }
        if (bb->buf && bb->len > 0) mm_copy(nb, ncap, bb->buf, bb->len);
        if (bb->buf) mm_free(bb->buf);
        bb->buf = nb;
        bb->cap = ncap;
    }
    mm_copy(bb->buf + bb->len, bb->cap - bb->len, s, n);
    bb->len += n;
    bb->buf[bb->len] = 0;
}

static void bt_buf_puts(BtBuf *bb, const char *s) {
    bt_buf_put(bb, s, strlen(s));
}

int main(int argc, char **argv) {
    int mode = 0; /* 1=write, 2=check */
    int derive_mode = 0;
    const char *root = ".";
    const char *batches_arg = 0;
    const char *derive_facts_arg = 0;
    const char *out_arg = 0;
    int threshold_pct = 70;
    int explicit_inputs = 0;

    for (int i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--write")) mode = 1;
        else if (tx_eqz(argv[i], "--check")) mode = 2;
        else if (tx_eqz(argv[i], "--derive")) derive_mode = 1;
        else if (tx_eqz(argv[i], "--root") && i + 1 < argc) root = argv[++i];
        else if (tx_eqz(argv[i], "--batches") && i + 1 < argc) batches_arg = argv[++i];
        else if (tx_eqz(argv[i], "--derive-facts") && i + 1 < argc) derive_facts_arg = argv[++i];
        else if (tx_eqz(argv[i], "--out") && i + 1 < argc) out_arg = argv[++i];
        else if ((tx_eqz(argv[i], "--strict-dir") || tx_eqz(argv[i], "--derive-dir")) && i + 1 < argc) {
            if (bt_ndirs >= BT_MAX_DIRS) return bt_refuse("too-many-input-dirs");
            bt_dirs[bt_ndirs++] = argv[++i];
            explicit_inputs = 1;
        } else if ((tx_eqz(argv[i], "--strict") || tx_eqz(argv[i], "--derive-log")) && i + 1 < argc) {
            int rc = bt_add_file(argv[++i]);
            if (rc) return rc;
            explicit_inputs = 1;
        } else if (tx_eqz(argv[i], "--threshold-pct") && i + 1 < argc) {
            const char *ts = argv[++i];
            long tl = (long)strlen(ts);
            if (!bt_is_digits(ts, tl)) return bt_refuse("invalid-threshold-pct");
            long tv = bt_parse_long(ts, tl);
            if (tv < 1 || tv > 99) return bt_refuse("threshold-pct-out-of-range");
            threshold_pct = (int)tv;
        } else {
            return bt_refuse("unknown-arg");
        }
    }
    if (mode == 0) {
        sy_printf("usage: batch-times.cx -- [--derive] --write|--check [--root DIR] [--batches FILE] [--derive-facts FILE] [--out FILE] [--strict-dir|--derive-dir DIR] [--strict|--derive-log FILE] [--threshold-pct 1..99]\n");
        return 2;
    }

    char out_path[BT_PW], batches_path[BT_PW], def_strict_dir[BT_PW];
    if (out_arg) {
        if (cx_fmt(out_path, sizeof out_path, "%s", out_arg)) return bt_refuse("path-bound");
    } else {
        if (cx_fmt(out_path, sizeof out_path, "%s/build/%s", root, derive_mode ? "derive-times.tsv" : "batch-times.tsv")) return bt_refuse("path-bound");
    }
    if (derive_mode) {
        if (derive_facts_arg) {
            if (cx_fmt(batches_path, sizeof batches_path, "%s", derive_facts_arg)) return bt_refuse("path-bound");
        } else {
            if (cx_fmt(batches_path, sizeof batches_path, "%s/exec/facts/derive.tsv", root)) return bt_refuse("path-bound");
        }
    } else if (batches_arg) {
        if (cx_fmt(batches_path, sizeof batches_path, "%s", batches_arg)) return bt_refuse("path-bound");
    } else {
        if (cx_fmt(batches_path, sizeof batches_path, "%s/tests/batches.tsv", root)) return bt_refuse("path-bound");
    }

    int rc = derive_mode ? bt_load_derive_facts(batches_path) : bt_load_batches(batches_path);
    if (rc) return rc;
    if (!explicit_inputs) {
        if (cx_fmt(def_strict_dir, sizeof def_strict_dir, "%s/release/evidence", root)) return bt_refuse("path-bound");
        bt_dirs[bt_ndirs++] = def_strict_dir;
    }
    for (int i = 0; i < bt_ndirs; i++) {
        rc = bt_scan_dir(bt_dirs[i], 0, derive_mode);
        if (rc) return rc;
    }
    if (bt_nfiles == 0) return bt_refuse(derive_mode ? "no-derive-logs-found" : "no-strict-files-found");
    qsort(bt_files, (size_t)bt_nfiles, sizeof bt_files[0], bt_cmp_str);
    for (int i = 0; i < bt_nfiles; i++) {
        rc = derive_mode ? bt_load_derive_log(root, bt_files[i]) : bt_load_strict_file(bt_files[i]);
        if (rc) return rc;
    }

    int measured = 0, near_bound = 0;
    BtBuf rows = {0}, tickets = {0};
    char line[1024];

    for (int i = 0; i < bt_nbatches; i++) {
        BtBatch *cur = &bt_batches[i];
        int k = cur->nsamples;
        long budget_ms = cur->budget_ms;
        const char *src_col = cur->source[0] ? cur->source : "-";
        if (k == 0 && cur->timeouts == 0 && cur->fails == 0) continue;
        if (k > 0) {
            measured++;
            qsort(cur->samples, (size_t)k, sizeof cur->samples[0], bt_cmp_long);
            long max_ms = cur->samples[k - 1];
            long median_ms = cur->samples[(k - 1) / 2];
            int p95_idx = (95 * k + 99) / 100 - 1;
            if (p95_idx < 0) p95_idx = 0;
            if (p95_idx >= k) p95_idx = k - 1;
            long p95_ms = cur->samples[p95_idx];
            long headroom_ms = budget_ms - p95_ms;
            int is_near = (p95_ms * 100L > budget_ms * (long)threshold_pct) || cur->timeouts > 0;
            if (is_near) {
                near_bound++;
                if (derive_mode) {
                    cx_fmt(line, sizeof line,
                           "%s\t%ld\t%ld\t%ld\t%ld\t%ld\t%d\t%d\t%d\tnear-bound\tSPLIT_TICKET:%s:p95=%ldms>%d%%of%ldms,timeouts=%d\t%s\n",
                           cur->id, max_ms, median_ms, p95_ms, budget_ms, headroom_ms, k, cur->timeouts, cur->fails,
                           cur->id, p95_ms, threshold_pct, budget_ms, cur->timeouts, src_col);
                } else {
                    cx_fmt(line, sizeof line,
                           "%s\t%ld\t%ld\t%ld\t%ld\t%ld\t%d\t%d\t%d\tnear-bound\tSPLIT_TICKET:%s:p95=%ldms>%d%%of%ldms,timeouts=%d\n",
                           cur->id, max_ms, median_ms, p95_ms, budget_ms, headroom_ms, k, cur->timeouts, cur->fails,
                           cur->id, p95_ms, threshold_pct, budget_ms, cur->timeouts);
                }
                bt_buf_puts(&rows, line);
                cx_fmt(line, sizeof line,
                       "# SPLIT_TICKET\t%s\tp95_ms=%ld\tbudget_ms=%ld\theadroom_ms=%ld\ttimeouts=%d\tfails=%d\tthreshold_pct=%d\taction=split-or-j1-warm\n",
                       cur->id, p95_ms, budget_ms, headroom_ms, cur->timeouts, cur->fails, threshold_pct);
                bt_buf_puts(&tickets, line);
            } else {
                if (derive_mode) {
                    cx_fmt(line, sizeof line,
                           "%s\t%ld\t%ld\t%ld\t%ld\t%ld\t%d\t%d\t%d\tok\t-\t%s\n",
                           cur->id, max_ms, median_ms, p95_ms, budget_ms, headroom_ms, k, cur->timeouts, cur->fails, src_col);
                } else {
                    cx_fmt(line, sizeof line,
                           "%s\t%ld\t%ld\t%ld\t%ld\t%ld\t%d\t%d\t%d\tok\t-\n",
                           cur->id, max_ms, median_ms, p95_ms, budget_ms, headroom_ms, k, cur->timeouts, cur->fails);
                }
                bt_buf_puts(&rows, line);
            }
        } else if (cur->timeouts > 0) {
            near_bound++;
            if (derive_mode) {
                cx_fmt(line, sizeof line,
                       "%s\tUNMEASURED\tUNMEASURED\tUNMEASURED\t%ld\tUNMEASURED\t0\t%d\t%d\tnear-bound\tSPLIT_TICKET:%s:timeouts=%d,budget=%ldms\t%s\n",
                       cur->id, budget_ms, cur->timeouts, cur->fails, cur->id, cur->timeouts, budget_ms, src_col);
            } else {
                cx_fmt(line, sizeof line,
                       "%s\tUNMEASURED\tUNMEASURED\tUNMEASURED\t%ld\tUNMEASURED\t0\t%d\t%d\tnear-bound\tSPLIT_TICKET:%s:timeouts=%d,budget=%ldms\n",
                       cur->id, budget_ms, cur->timeouts, cur->fails, cur->id, cur->timeouts, budget_ms);
            }
            bt_buf_puts(&rows, line);
            cx_fmt(line, sizeof line,
                   "# SPLIT_TICKET\t%s\tp95_ms=UNMEASURED\tbudget_ms=%ld\theadroom_ms=UNMEASURED\ttimeouts=%d\tfails=%d\tthreshold_pct=%d\taction=split-or-j1-warm\n",
                   cur->id, budget_ms, cur->timeouts, cur->fails, threshold_pct);
            bt_buf_puts(&tickets, line);
        } else {
            /* k == 0 && timeouts == 0 && fails > 0: assertion FAIL only, never triggers near-bound */
            if (derive_mode) {
                cx_fmt(line, sizeof line,
                       "%s\tUNMEASURED\tUNMEASURED\tUNMEASURED\t%ld\tUNMEASURED\t0\t0\t%d\tok\t-\t%s\n",
                       cur->id, budget_ms, cur->fails, src_col);
            } else {
                cx_fmt(line, sizeof line,
                       "%s\tUNMEASURED\tUNMEASURED\tUNMEASURED\t%ld\tUNMEASURED\t0\t0\t%d\tok\t-\n",
                       cur->id, budget_ms, cur->fails);
            }
            bt_buf_puts(&rows, line);
        }
    }

    BtBuf out = {0};
    if (derive_mode) {
        bt_buf_puts(&out, "# Generated by tools/batch-times.cx --derive --write from exec/facts/derive.tsv and real DERIVE logs; do not edit by hand.\n");
    } else {
        bt_buf_puts(&out, "# Generated by tools/batch-times.cx --write from tests/batches.tsv and strict-*.tsv; do not edit by hand.\n");
    }
    cx_fmt(line, sizeof line, "# threshold_pct=%d\tfiles=%d\tmeasured=%d\tnear_bound=%d\n",
           threshold_pct, bt_nfiles, measured, near_bound);
    bt_buf_puts(&out, line);
    if (derive_mode) {
        bt_buf_puts(&out, "generator\tmax_ms\tmedian_ms\tp95_ms\tbudget_ms\theadroom_ms\tsamples\ttimeouts\tfails\tstatus\tsplit_ticket\tsource\n");
    } else {
        bt_buf_puts(&out, "batch\tmax_ms\tmedian_ms\tp95_ms\tbudget_ms\theadroom_ms\tsamples\ttimeouts\tfails\tstatus\tsplit_ticket\n");
    }
    if (rows.buf && rows.len > 0) bt_buf_put(&out, rows.buf, rows.len);
    if (tickets.buf && tickets.len > 0) bt_buf_put(&out, tickets.buf, tickets.len);

    for (int i = 0; i < bt_nbatches; i++) {
        if (bt_batches[i].samples) mm_free(bt_batches[i].samples);
    }
    if (rows.buf) mm_free(rows.buf);
    if (tickets.buf) mm_free(tickets.buf);
    if (out.oom || !out.buf) {
        if (out.buf) mm_free(out.buf);
        return bt_refuse("oom");
    }

    const char *tag = derive_mode ? "DERIVE_TIMES" : "BATCH_TIMES";
    if (mode == 1) {
        if (sy_write_atomic(out_path, out.buf, (int64_t)out.len, 0644)) {
            mm_free(out.buf);
            return bt_refuse("write-failed");
        }
        sy_printf("%s\twrote\tmeasured=%d\tnear_bound=%d\tthreshold_pct=%d\tout=%s\n",
                  tag, measured, near_bound, threshold_pct, out_path);
        mm_free(out.buf);
        return 0;
    }

    size_t old_n = 0;
    char *old = cx_read(out_path, &old_n);
    int same = (old != 0 && old_n == out.len && mm_same(old, out.buf, (long)out.len));
    if (old) free(old);
    mm_free(out.buf);
    if (!same) {
        sy_printf("DIFF\t%s\n", out_path);
        sy_printf("%s\tdrift\tmeasured=%d\tnear_bound=%d\tthreshold_pct=%d\n",
                  tag, measured, near_bound, threshold_pct);
        return 1;
    }
    sy_printf("%s\tok\tmeasured=%d\tnear_bound=%d\tthreshold_pct=%d\n",
              tag, measured, near_bound, threshold_pct);
    return 0;
}
