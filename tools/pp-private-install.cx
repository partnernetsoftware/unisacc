/* Prepare an isolated kernel view with the constructed PP net installed.
 * Usage: ROOT PP_MATERIAL NEW_ABS_OUTPUT. No live kernel file is changed.
 * The caller runs private/unisa_self.c with its compiler and records the result.
 */
#pragma unisa use cxlib.netpack
static char root[4096],material[4096],out[4096],private_dir[4400];
static void die(const char *s){fprintf(stderr,"pp-private-install: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void path(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path-bound");}
static char *load(const char *p,size_t *n){struct stat a,b;errno=0;if(lstat(p,&a))die(errno==ENOENT?"input-absent":"input-stat");if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>16777216)die("bounded-regular-input");int fd=open(p,O_RDONLY|O_CLOEXEC|O_NONBLOCK|O_NOFOLLOW);if(fd<0)die("input-open");if(fstat(fd,&b)||!S_ISREG(b.st_mode)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size){close(fd);die("input-descriptor");}*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s){close(fd);die("allocation");}size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0){close(fd);die("input-extent");}at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int changed=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(z||changed||closed){free(s);die("input-changed-or-close");}s[*n]=0;return s;}
static void save(const char *p,const char *s,size_t n){int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive-output");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0){close(fd);die("output-write");}at+=(size_t)z;}int synced=fsync(fd),closed=close(fd);if(synced||closed)die("output-close");}
static void hex(np_buf *b,unsigned char c){static const char *digit="0123456789abcdef";char s[4]={'\\','x',digit[c>>4],digit[c&15]};np_put(b,s,4);}
static void verify_material(void){char product[4400],bound[4400],tool[4400],why[1400];path(product,root,"unisacc.com");path(bound,root,"tools/bound");path(tool,root,"tools/pp-gold-material.cx");char *v[]={bound,"20","sh",product,tool,"--","--verify",root,material,0};np_result r;if(np_run(v,root,0,23,&r,why,sizeof why))die(why);const char *want="VERIFIED\tpp-gold-material\tno-test-result\n";int good=!r.rc&&!r.errn&&r.outn==strlen(want)&&!memcmp(r.out,want,r.outn);if(!good&&r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);if(!good)die("pp-material-current-verification");}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN pp-private-install requires Linux/x86_64 LP64\n",stderr);return 3;
#endif
 int negative=argc==5&&!strcmp(argv[4],"--negative-class-flip");if((argc!=4&&!negative)||sizeof(long)!=8||!realpath(argv[1],root)||!realpath(argv[2],material)||argv[3][0]!='/'||strlen(argv[3])>=sizeof out||strpbrk(argv[3],"\r\n\t"))die("usage-ROOT-PP-MATERIAL-NEW-ABS-OUT-[--negative-class-flip]");strcpy(out,argv[3]);
 verify_material();char source[4400],dest[4400],kernel[4400],h[65],installed[65];path(source,material,"pp.weights");size_t n;char *w=load(source,&n);if(n!=142)die("pp-weight-length");cx_sha256_hex(w,n,h);if(negative){if(w[103]!=0||w[104]!=0)die("negative-first-class-precondition");w[103]=1;}cx_sha256_hex(w,n,installed);
 char root_kernel[4400];path(root_kernel,root,"kernel");struct stat st;if(lstat(root_kernel,&st)||!S_ISDIR(st.st_mode))die("root-kernel-directory");if(mkdir(out,0700))die("fresh-output-required");path(private_dir,out,"kernel");if(mkdir(private_dir,0700))die("private-kernel-directory");
 np_buf receipt={0};np_puts(&receipt,"pp-private-install-v1\nstatus\tPREPARED\nscope\tisolated-pp-weight-replacement-no-root-change-no-product-candidate\n");np_puts(&receipt,"pp.weights\t");np_puts(&receipt,h);np_puts(&receipt,"\ninstalled-pp-sha256\t");np_puts(&receipt,installed);np_puts(&receipt,negative?"\nnegative\tfirst-W2-class-0-to-1\n":"\nnegative\tno\n");
 DIR *dir=opendir(root_kernel);if(!dir)die("kernel-list-open");int copied=0;for(;;){errno=0;struct dirent *e=readdir(dir);if(!e){int err=errno,closed=closedir(dir);if(err||closed)die("kernel-list-close");break;}if(!strcmp(e->d_name,".")||!strcmp(e->d_name,"..")||!strcmp(e->d_name,"weight.pp.inc"))continue;if(strchr(e->d_name,'/')||strchr(e->d_name,'\t')||strchr(e->d_name,'\n'))die("kernel-name-wire");path(source,root_kernel,e->d_name);size_t length;char *bytes=load(source,&length);char hash[65];cx_sha256_hex(bytes,length,hash);path(dest,private_dir,e->d_name);save(dest,bytes,length);free(bytes);np_puts(&receipt,"copied-kernel-file\t");np_puts(&receipt,e->d_name);np_puts(&receipt,"\t");np_puts(&receipt,hash);np_puts(&receipt,"\n");copied++;}
 if(copied!=40)die("kernel-file-count-changed");np_buf inc={0};np_puts(&inc,"/* Private PP constructed-weight probe; source material sha256=");np_puts(&inc,h);np_puts(&inc,"; installed sha256=");np_puts(&inc,installed);np_puts(&inc,negative?"; NEGATIVE class flip. */\n":". */\n");for(size_t i=0;i<n;i++){if(i%20==0)np_puts(&inc,"  \"");hex(&inc,(unsigned char)w[i]);if(i%20==19||i+1==n)np_puts(&inc,"\"\n");}path(dest,private_dir,"weight.pp.inc");save(dest,inc.p,inc.n);free(inc.p);free(w);
 char base[4400],after[65];path(base,material,"pp.weights");w=load(base,&n);cx_sha256_hex(w,n,after);free(w);if(strcmp(h,after))die("pp-material-changed");np_puts(&receipt,"private-kernel-files\t41\n");path(dest,out,"receipt.tsv");save(dest,receipt.p,receipt.n);free(receipt.p);printf("PREPARED\tpp-private-install\tpp-sha256=%s\tinstalled=%s\tnegative=%d\tkernel-files=41\n",h,installed,negative);return 0;
}
