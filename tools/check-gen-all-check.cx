/* tools/check-gen-all-check.cx -- regression checks for tools/gen-all-check.cx, chain-ready 15-gen-all, and precommit derive_gate.
 *   sh ./unisacc.com tools/check-gen-all-check.cx [-- [--drift|--pass-gates|--chain-ready|--hang|--split-check]]
 * Split across 5 fast batches (verified by --split-check / batch check-gen-all-split, zero dropped assertions):
 *   default (--):
 *     - current-tree-all-same              --root . passes first 22 of 44 product-table generators
 *     - current-tree-list-44               --list discovers 44 generators with two waivers expiring at 0.0.87
 *     - synth-winargv-stamp-drift-refused  tampered # input sha256 in enc-x86win-winargs.tsv -> win-argv-gen DIFF + --write fix
 *     - synth-k2gen2-stamp-drift-refused   tampered # input sha256 in k2-gen2.tsv -> facts-gen DIFF k2-gen2 + --write fix
 *     - bg-and-poll-roundtrip              --bg starts and --poll retrieves completed summary
 *     - (optional when full git history exists, else NOT_RUN): hist-0082-winargv-drift-refused, hist-0083-k2gen2-drift-refused
 *   --drift:
 *     - synthetic-header-drift-refused         editing include/stdlib.h -> facts-gen + cx-flatten DIFF + --write fix
 *     - precommit-derive-gate-blocks-drift     staging include/stdlib.h without recompute -> BLOCKED without unisacc.com false DIFF
 *     - precommit-recomputed-unstaged-blocked  worktree recompute not staged still caught on index snapshot
 *   --pass-gates:
 *     - precommit-recomputed-and-staged-passes staging include/stdlib.h + recomputed tables -> PASS blocked=0
 *   --chain-ready:
 *     - chain-ready-15-gen-all                 live 15-gen-all PASS and --judge genall refuses DIFF
 *     - precommit-unstaged-other-cx-not-blocked unstaged cx/ edit does not block staging axis-gen+arity-gen comments
 *   --hang:
 *     - precommit-single-error-allows          generator ERROR without DIFF logs GEN_ALL_GATE_UNAVAILABLE and allows commit
 *     - precommit-hang-bounded-no-orphan       hanging double times out <40s, allows commit, zero orphans
 *   --split-check:
 *     - verifies all 5 split batches are IMPLEMENTED in tests/batches.tsv and the 15-assertion partition is complete
 * Last line: CHECK_GEN_ALL_{CHECK|DRIFT|PASS|READY|HANG|SPLIT}<TAB>ok=N<TAB>failed=M<TAB>ms=T (rc 0 only when failed=0). */
#pragma unisa use cxlib.ckassert
#pragma unisa use cxlib.ckrun
#pragma unisa use sys.fs
#pragma unisa use sys.time
#pragma unisa use sys.env
#pragma unisa use mem.bytes
#pragma unisa use text.text

#define CGAC_PW 4400
#define CGAC_OUT 32768
#define CGAC_GENERATORS 44
#define CGAC_PART (CGAC_GENERATORS / 2)

static void cgac_abort(const char *why) {
    fprintf(stderr, "check-gen-all-check: REFUSE %s\n", why);
    exit(2);
}

static void cgac_mk(const char *p) {
    if (mkdir(p, 0700) != 0 && errno != EEXIST) cgac_abort("mkdir");
}

static int cgac_flip_first_sha(const char *path) {
    size_t n = 0;
    char *b = (char *)cx_read(path, &n);
    if (!b) return 1;
    long pos = tx_find(b, (long)n, "sha256:", 7);
    if (pos < 0 || pos + 7 >= (long)n) { free(b); return 1; }
    b[pos + 7] = (b[pos + 7] == '0') ? '1' : '0';
    int rc = cx_write(path, b, n);
    free(b);
    return rc;
}

static void cgac_prep_minirepo(const char *cwd, const char *rep, char *out) {
    char cmd[8192];
    cgac_mk(rep);
    if (cx_fmt(cmd, sizeof cmd,
        "git -C '%s' archive HEAD -- include src cx ext seed exec build weights iterate kernel tools cxroot.tsv | tar -x -C '%s' && "
        "cp '%s/tools/gen-all-check.cx' '%s/tools/precommit.cx' '%s/tools/' && rm -f '%s/tools/ratchets.cx' && "
        "printf '# derive v1\\n' > '%s/exec/facts/derive.tsv' && "
        "ln -s '%s/unisacc.com' '%s/unisacc.com' && "
        "cd '%s' && git init -q && git config user.email test@local && git config user.name test && "
        "git add -A && git commit -q -m init",
        cwd, rep, cwd, cwd, rep, rep, rep, cwd, rep, rep)) cgac_abort("minirepo-fmt");
    if (ckk_sh("check-gen-all-check", cmd, out, CGAC_OUT) != 0) cgac_abort("minirepo-run");
}

static int cgac_list_slice(const char *out, int start, int count, char *dst, size_t dcap) {
    int idx = 0, got = 0;
    size_t out_n = strlen(out), pos = 0, dp = 0;
    dst[0] = 0;
    while (pos < out_n) {
        size_t ls = pos;
        while (pos < out_n && out[pos] != '\n') pos++;
        size_t le = pos;
        if (pos < out_n) pos++;
        if (le > ls && out[le - 1] == '\r') le--;
        if (le - ls > 9 && memcmp(out + ls, "GEN_ITEM\t", 9) == 0) {
            size_t ns = ls + 9, ne = ns;
            while (ne < le && out[ne] != '\t') ne++;
            if (idx >= start && idx < start + count && ne > ns) {
                size_t nl = ne - ns;
                if (dp + (got ? 1 : 0) + nl + 1 >= dcap) return -1;
                if (got) dst[dp++] = ',';
                mm_copy(dst + dp, dcap - dp, out + ns, nl);
                dp += nl;
                dst[dp] = 0;
                got++;
            }
            idx++;
        }
    }
    return got;
}

static int cgac_pass_summary(const char *out) {
    char row[128];
    return !cx_fmt(row, sizeof row, "GEN_ALL_SUMMARY\ttotal=%d\tpass=%d\tdiff=0\terror=0\t",
                   CGAC_PART, CGAC_PART) && ckk_has(out, CGAC_OUT, row);
}

int main(int argc, char **argv) {
    long t0 = sy_now_ms();
    char cwd[CGAC_PW], work[CGAC_PW], cmd[8192], out[CGAC_OUT];
    const char *td = sy_tmpdir();
    const char *base_td = (td && td[0] == '/') ? td : "/tmp";
    int part2_mode = (argc >= 2 && argv[1] && tx_eqz(argv[1], "--part2"));
    int synth_mode = (argc >= 2 && argv[1] && tx_eqz(argv[1], "--synth"));
    int drift_mode = (argc >= 2 && argv[1] && tx_eqz(argv[1], "--drift"));
    int unstaged_mode = (argc >= 2 && argv[1] && tx_eqz(argv[1], "--unstaged"));
    int pass_mode = (argc >= 2 && argv[1] && tx_eqz(argv[1], "--pass-gates"));
    int ready_all = (argc >= 2 && argv[1] && tx_eqz(argv[1], "--chain-ready"));
    int ready_live = ready_all || (argc >= 2 && argv[1] && tx_eqz(argv[1], "--chain-ready-live"));
    int ready_precommit = ready_all || (argc >= 2 && argv[1] && tx_eqz(argv[1], "--chain-ready-precommit"));
    int hang_mode = (argc >= 2 && argv[1] && tx_eqz(argv[1], "--hang"));
    int split_mode = (argc >= 2 && argv[1] && tx_eqz(argv[1], "--split-check"));

    if (!getcwd(cwd, sizeof cwd)) cgac_abort("getcwd");
    if (split_mode) {
        static const char *bids[9] = {
            "check-gen-all-check", "check-gen-all-part2", "check-gen-all-synth",
            "check-gen-all-drift", "check-gen-all-unstaged", "check-gen-all-pass",
            "check-gen-all-ready", "check-gen-all-ready-precommit", "check-gen-all-hang"
        };
        static const char *bargs[9] = {
            "-", "--part2", "--synth", "--drift", "--unstaged", "--pass-gates", "--chain-ready-live", "--chain-ready-precommit", "--hang"
        };
        static const int bexp[9] = { 2, 1, 5, 3, 1, 1, 1, 1, 2 };
        int bfound[9] = { 0 };
        char bpath[CGAC_PW];
        size_t bn = 0;
        if (cx_fmt(bpath, sizeof bpath, "%s/tests/batches.tsv", cwd)) cgac_abort("sp-path");
        char *buf = (char *)cx_read(bpath, &bn);
        if (!buf) cgac_abort("sp-read-batches");
        size_t pos = 0;
        while (pos < bn) {
            size_t ls = pos;
            while (pos < bn && buf[pos] != '\n') pos++;
            size_t le = pos;
            if (pos < bn) pos++;
            if (le > ls && buf[le - 1] == '\r') le--;
            const char *cols[16];
            size_t clens[16];
            int nc = 0;
            size_t p = ls;
            while (nc < 16) {
                size_t cs = p;
                while (p < le && buf[p] != '\t') p++;
                cols[nc] = buf + cs;
                clens[nc] = p - cs;
                nc++;
                if (p >= le) break;
                p++;
            }
            if (nc < 10) continue;
            for (int i = 0; i < 9; i++) {
                size_t idl = strlen(bids[i]);
                size_t argl = strlen(bargs[i]);
                const char *src_need = "tools/check-gen-all-check.cx";
                size_t srcl = strlen(src_need);
                if (clens[0] == idl && memcmp(cols[0], bids[i], idl) == 0 &&
                    clens[1] == 11 && memcmp(cols[1], "IMPLEMENTED", 11) == 0 &&
                    clens[3] == srcl && memcmp(cols[3], src_need, srcl) == 0 &&
                    clens[9] == argl && memcmp(cols[9], bargs[i], argl) == 0) {
                    bfound[i]++;
                }
            }
        }
        free(buf);
        int total_assertions = 0;
        for (int i = 0; i < 9; i++) {
            char msg[160];
            (void)cx_fmt(msg, sizeof msg, "split-batch-registered: %s args=%s", bids[i], bargs[i]);
            ck(bfound[i] == 1, msg);
            total_assertions += bexp[i];
        }
        ck(total_assertions == 17, "split-assertion-partition-total: 17 assertions (15 core + 2 history, 22+22=44 gens)");
        printf("CHECK_GEN_ALL_SPLIT\tok=%d\tfailed=%d\tms=%ld\n", ck_assertions() - ck_failures(), ck_failures(), sy_now_ms() - t0);
        return ck_failures() ? 1 : 0;
    }

    if (cx_fmt(work, sizeof work, "%s/check-gen-all-%d", base_td, (int)getpid())) cgac_abort("work");
    cgac_mk(work);

    if (drift_mode) {
        char rep[CGAC_PW];
        int rc;
        if (cx_fmt(rep, sizeof rep, "%s/drift-repo", work)) cgac_abort("drep");
        cgac_prep_minirepo(cwd, rep, out);

        /* Step 1: direct gen-all-check on edited include/stdlib.h -> facts-gen + cx-flatten DIFF + --write fix (also warms unit cache) */
        if (cx_fmt(cmd, sizeof cmd,
            "unset UNISA_CONTAINER && cd '%s' && printf '\\n/* cgac-precommit-drift */\\n' >> include/stdlib.h && "
            "sh ./unisacc.com tools/gen-all-check.cx -- --root '%s' --only facts-gen,cx-flatten", rep, rep)) cgac_abort("d1a");
        rc = ckk_sh("check-gen-all-check", cmd, out, sizeof out);
        ck(rc == 1 && ckk_has(out, CGAC_OUT, "GEN_CHECK\tfacts-gen\tDIFF\t") &&
           ckk_has(out, CGAC_OUT, "k2-gen2") &&
           ckk_has(out, CGAC_OUT, "fix: sh ./unisacc.com tools/facts-gen.cx -- --write .") &&
           ckk_has(out, CGAC_OUT, "GEN_CHECK\tcx-flatten\tDIFF\t") &&
           ckk_has(out, CGAC_OUT, "fix: sh ./unisacc.com tools/cx-flatten.cx -- --write ."),
           "synthetic-header-drift-refused: editing include/stdlib.h refused by facts-gen and cx-flatten with --write fix");

        /* Step 2: staging arity-gen.cx (uses unisacc.com) + drifted winargs table without recompute -> precommit blocks with real DIFF (no unisacc.com false DIFF) */
        if (cx_fmt(cmd, sizeof cmd,
            "unset UNISA_CONTAINER && cd '%s' && git checkout -- include/stdlib.h && "
            "printf '\\n/* cgac-arity-touch */\\n' >> tools/arity-gen.cx && "
            "printf '\\n/* cgac-winargv-drift */\\n' >> tools/win-argv-gen.cx && "
            "git add tools/arity-gen.cx tools/win-argv-gen.cx && "
            "UNISACC_PRECOMMIT_SERIAL=1 sh ./unisacc.com tools/precommit.cx", rep)) cgac_abort("d1b");
        rc = ckk_sh("check-gen-all-check", cmd, out, sizeof out);
        ck(rc != 0 && ckk_has(out, CGAC_OUT, "BLOCKED product-table-drift") && !ckk_has(out, CGAC_OUT, "cannot open"),
           "precommit-derive-gate-blocks-drift: staging product input without recompute blocked by real DIFF without unisacc.com false DIFF");

        /* Step 3: staging a newly added ext/ file without updating build/lane-inputs.tsv is blocked by lane-inputs-gen DIFF, and passes once recomputed+staged */
        if (cx_fmt(cmd, sizeof cmd,
            "unset UNISA_CONTAINER && cd '%s' && git reset -q HEAD -- tools/arity-gen.cx tools/win-argv-gen.cx && "
            "git checkout -- tools/arity-gen.cx tools/win-argv-gen.cx && "
            "printf '#pragma unisa module cgac_dummy\\nstatic int cgac_d(void) { return 0; }\\n' > ext/net/cgac_dummy.cx && "
            "git add ext/net/cgac_dummy.cx && "
            "UNISACC_PRECOMMIT_SERIAL=1 sh ./unisacc.com tools/precommit.cx", rep)) cgac_abort("d1c");
        rc = ckk_sh("check-gen-all-check", cmd, out, sizeof out);
        {
            int blocked_ok = (rc != 0 && ckk_has(out, CGAC_OUT, "BLOCKED product-table-drift") &&
                              ckk_has(out, CGAC_OUT, "GEN_CHECK\tlane-inputs-gen\tDIFF"));
            int pass_ok = 0;
            if (blocked_ok) {
                if (cx_fmt(cmd, sizeof cmd,
                    "unset UNISA_CONTAINER && cd '%s' && sh ./unisacc.com tools/lane-inputs-gen.cx -- --write . >/dev/null && "
                    "git add build/lane-inputs.tsv && "
                    "UNISACC_PRECOMMIT_SERIAL=1 sh ./unisacc.com tools/precommit.cx", rep)) cgac_abort("d1d");
                rc = ckk_sh("check-gen-all-check", cmd, out, sizeof out);
                pass_ok = (rc == 0 && ckk_has(out, CGAC_OUT, "PRECOMMIT\t") && ckk_has(out, CGAC_OUT, "blocked=0"));
            }
            ck(blocked_ok && pass_ok,
               "precommit-lane-inputs-add-ext-blocked-and-synced: staging new ext/ file blocks on lane-inputs-gen DIFF until build/lane-inputs.tsv is staged");
        }

        { char *rmv[] = {"rm", "-rf", work, 0}; (void)ck_run(rmv, out, sizeof out); }
        printf("CHECK_GEN_ALL_DRIFT\tok=%d\tfailed=%d\tms=%ld\n", ck_assertions() - ck_failures(), ck_failures(), sy_now_ms() - t0);
        return ck_failures() ? 1 : 0;
    }

    if (unstaged_mode) {
        char rep[CGAC_PW];
        int rc;
        if (cx_fmt(rep, sizeof rep, "%s/unstaged-repo", work)) cgac_abort("urep");
        cgac_prep_minirepo(cwd, rep, out);

        /* Recompute in worktree without staging -> index tree still drifts -> BLOCKED product-table-drift */
        if (cx_fmt(cmd, sizeof cmd,
            "unset UNISA_CONTAINER && cd '%s' && "
            "printf '\\n/* winargv-stamp-drift */\\n' >> tools/win-argv-gen.cx && git add tools/win-argv-gen.cx && "
            "sh ./unisacc.com tools/win-argv-gen.cx -- --write . >/dev/null && "
            "UNISACC_PRECOMMIT_SERIAL=1 sh ./unisacc.com tools/precommit.cx", rep)) cgac_abort("u1");
        rc = ckk_sh("check-gen-all-check", cmd, out, sizeof out);
        ck(rc != 0 && ckk_has(out, CGAC_OUT, "BLOCKED product-table-drift"),
           "precommit-recomputed-unstaged-blocked: worktree recompute not staged still caught on index snapshot");

        { char *rmv[] = {"rm", "-rf", work, 0}; (void)ck_run(rmv, out, sizeof out); }
        printf("CHECK_GEN_ALL_UNSTAGED\tok=%d\tfailed=%d\tms=%ld\n", ck_assertions() - ck_failures(), ck_failures(), sy_now_ms() - t0);
        return ck_failures() ? 1 : 0;
    }

    if (pass_mode) {
        char rep[CGAC_PW];
        int rc;
        if (cx_fmt(rep, sizeof rep, "%s/pass-repo", work)) cgac_abort("prep");
        cgac_prep_minirepo(cwd, rep, out);

        /* P1 (Scene 4): staging include/stdlib.h + all recomputed downstream tables -> precommit PASS (rc=0, blocked=0) */
        if (cx_fmt(cmd, sizeof cmd,
            "unset UNISA_CONTAINER && cd '%s' && printf '\\n/* cgac-recomputed-ok */\\n' >> include/stdlib.h && "
            "(sh ./unisacc.com tools/facts-gen.cx -- --write . >/dev/null & p1=$!; "
            "sh ./unisacc.com tools/cx-flatten.cx -- --write . >/dev/null & p2=$!; "
            "sh ./unisacc.com tools/libc-decl-scan.cx -- --write >/dev/null & p3=$!; "
            "wait $p1 && wait $p2 && wait $p3) && "
            "git add include/stdlib.h include/cx-flat.h exec/facts/ build/libc-decls.tsv && "
            "UNISACC_PRECOMMIT_SERIAL=1 sh ./unisacc.com tools/precommit.cx", rep)) cgac_abort("p1");
        rc = ckk_sh("check-gen-all-check", cmd, out, sizeof out);
        ck(rc == 0 && ckk_has(out, CGAC_OUT, "PRECOMMIT\t") && ckk_has(out, CGAC_OUT, "blocked=0"),
           "precommit-recomputed-and-staged-passes: staging include/stdlib.h + recomputed tables passes with unisacc.com linked");

        { char *rmv[] = {"rm", "-rf", work, 0}; (void)ck_run(rmv, out, sizeof out); }
        printf("CHECK_GEN_ALL_PASS\tok=%d\tfailed=%d\tms=%ld\n", ck_assertions() - ck_failures(), ck_failures(), sy_now_ms() - t0);
        return ck_failures() ? 1 : 0;
    }

    if (ready_live) {
        char df[CGAC_PW];
        int rc_ok, rc_bad;
        if (cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/chain-ready.cx' -- --only 15-gen-all", cwd, cwd))
            cgac_abort("r1");
        rc_ok = ckk_sh("check-gen-all-check", cmd, out, sizeof out);
        int ok_pass = (rc_ok == 0 && ckk_has(out, CGAC_OUT, "15-gen-all\tPASS\t") && ckk_has(out, CGAC_OUT, "READY\tyes\t"));

        if (cx_fmt(df, sizeof df, "%s/fake-diff.tsv", work)) cgac_abort("rdf");
        {
            const char *bad = "GEN_CHECK\tfacts-gen\tDIFF\t120\tDIFF k2-gen2; fix: sh ./unisacc.com tools/facts-gen.cx -- --write .\n"
                              "GEN_ALL_SUMMARY\ttotal=1\tpass=0\tdiff=1\terror=0\tuncovered=0\tms=120\n";
            if (cx_write(df, bad, strlen(bad))) cgac_abort("rwdf");
        }
        if (cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/chain-ready.cx' -- --judge genall '%s' 1", cwd, cwd, df))
            cgac_abort("r2");
        rc_bad = ckk_sh("check-gen-all-check", cmd, out, sizeof out);
        int ok_fail = (rc_bad == 0 && ckk_has(out, CGAC_OUT, "FAIL\t") && ckk_has(out, CGAC_OUT, "k2-gen2"));
        ck(ok_pass && ok_fail, "chain-ready-15-gen-all: live 15-gen-all PASS and --judge genall refuses DIFF");
    }

    if (ready_precommit) {
        char rep[CGAC_PW];
        int rc;
        /* Unstaged cx/ edit by another session does NOT block staging comments in tools/axis-gen.cx + tools/arity-gen.cx */
        if (cx_fmt(rep, sizeof rep, "%s/ready-repo", work)) cgac_abort("rrep");
        cgac_prep_minirepo(cwd, rep, out);
        if (cx_fmt(cmd, sizeof cmd,
            "unset UNISA_CONTAINER && cd '%s' && "
            "printf '\\n/* other-session-unstaged */\\n' >> cx/check_memory.cx && "
            "printf '\\n/* harmless-gen-comment */\\n' >> tools/axis-gen.cx && "
            "printf '\\n/* arity-harmless-comment */\\n' >> tools/arity-gen.cx && "
            "git add tools/axis-gen.cx tools/arity-gen.cx && "
            "UNISACC_PRECOMMIT_SERIAL=1 sh ./unisacc.com tools/precommit.cx", rep)) cgac_abort("r3");
        rc = ckk_sh("check-gen-all-check", cmd, out, sizeof out);
        ck(rc == 0 && ckk_has(out, CGAC_OUT, "PRECOMMIT\t") && ckk_has(out, CGAC_OUT, "blocked=0"),
           "precommit-unstaged-other-cx-not-blocked: unstaged cx/ edit does not block staging axis-gen+arity-gen comments");
    }

    if (ready_live || ready_precommit) {
        { char *rmv[] = {"rm", "-rf", work, 0}; (void)ck_run(rmv, out, sizeof out); }
        printf("CHECK_GEN_ALL_READY\tok=%d\tfailed=%d\tms=%ld\n", ck_assertions() - ck_failures(), ck_failures(), sy_now_ms() - t0);
        return ck_failures() ? 1 : 0;
    }

    if (hang_mode) {
        char rep[CGAC_PW], gpath[CGAC_PW], hsrc[1024], tag[64], pout[256];
        long t10;
        int rc, rc_pg;
        if (cx_fmt(rep, sizeof rep, "%s/hang-repo", work)) cgac_abort("hrep");
        cgac_prep_minirepo(cwd, rep, out);

        /* H1: single generator ERROR (not DIFF) -> prints GEN_ALL_GATE_UNAVAILABLE and allows commit (rc=0) */
        if (cx_fmt(cmd, sizeof cmd,
            "cd '%s' && printf '# err-test\\n' >> exec/facts/clock-targets.tsv && git add exec/facts/clock-targets.tsv", rep))
            cgac_abort("h1prep");
        if (ckk_sh("check-gen-all-check", cmd, out, sizeof out) != 0) cgac_abort("h1prep-run");
        if (cx_fmt(gpath, sizeof gpath, "%s/tools/gen-all-check.cx", rep)) cgac_abort("h1gp");
        {
            const char *esrc =
                "int main(void) {\n"
                "  printf(\"GEN_CHECK\\tfake-gen\\tERROR\\t10\\trc=2 broken\\n\");\n"
                "  printf(\"GEN_ALL_SUMMARY\\ttotal=1\\tpass=0\\tdiff=0\\terror=1\\tuncovered=0\\tms=10\\n\");\n"
                "  return 2;\n"
                "}\n";
            if (cx_write(gpath, esrc, strlen(esrc))) cgac_abort("h1w");
        }
        if (cx_fmt(cmd, sizeof cmd,
            "unset UNISA_CONTAINER && cd '%s' && UNISACC_PRECOMMIT_SERIAL=1 sh ./unisacc.com tools/precommit.cx", rep))
            cgac_abort("h1run");
        rc = ckk_sh("check-gen-all-check", cmd, out, sizeof out);
        ck(rc == 0 && ckk_has(out, CGAC_OUT, "GEN_ALL_GATE_UNAVAILABLE") && ckk_has(out, CGAC_OUT, "blocked=0"),
           "precommit-single-error-allows: generator ERROR without DIFF logs GEN_ALL_GATE_UNAVAILABLE and allows commit");

        /* H2: hanging gen-all-check double times out <40s, logs GEN_ALL_GATE_UNAVAILABLE, allows commit, zero orphans */
        if (cx_fmt(tag, sizeof tag, "cgac_hang_probe_%d", (int)getpid())) cgac_abort("htag");
        if (cx_fmt(hsrc, sizeof hsrc,
            "#pragma unisa use sys.proc\n"
            "int main(void) {\n"
            "  int p = fork();\n"
            "  if (p == 0) { char *a[] = {\"sh\", \"-c\", \"sleep 300; echo %s\", 0}; execvp(\"sh\", a); _exit(127); }\n"
            "  for (;;) { char *s[] = {\"sleep\", \"1\", 0}; int c = fork(); if (c == 0) { execvp(\"sleep\", s); _exit(127); } int st = 0; waitpid(c, &st, 0); }\n"
            "  return 0;\n"
            "}\n", tag)) cgac_abort("hsrc");
        if (cx_write(gpath, hsrc, strlen(hsrc))) cgac_abort("hw");
        t10 = sy_now_ms();
        if (cx_fmt(cmd, sizeof cmd,
            "unset UNISA_CONTAINER && cd '%s' && UNISACC_PRECOMMIT_SERIAL=1 sh ./unisacc.com tools/precommit.cx", rep))
            cgac_abort("hrun");
        rc = ckk_sh("check-gen-all-check", cmd, out, sizeof out);
        long dt10 = sy_now_ms() - t10;
        if (cx_fmt(cmd, sizeof cmd, "pgrep -f '[c]gac_hang_probe_%d'", (int)getpid())) cgac_abort("hpg");
        rc_pg = ckk_sh("check-gen-all-check", cmd, pout, sizeof pout);
        ck(rc == 0 && dt10 < 40000 && ckk_has(out, CGAC_OUT, "GEN_ALL_GATE_UNAVAILABLE") && rc_pg != 0,
           "precommit-hang-bounded-no-orphan: hanging double times out <40s, allows commit, zero orphans");

        { char *rmv[] = {"rm", "-rf", work, 0}; (void)ck_run(rmv, out, sizeof out); }
        printf("CHECK_GEN_ALL_HANG\tok=%d\tfailed=%d\tms=%ld\n", ck_assertions() - ck_failures(), ck_failures(), sy_now_ms() - t0);
        return ck_failures() ? 1 : 0;
    }

    if (part2_mode) {
        char slice[2048];
        int rc, got;
        if (cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/gen-all-check.cx' -- --root '%s' --list", cwd, cwd, cwd))
            cgac_abort("p2list");
        rc = ckk_sh("check-gen-all-check", cmd, out, sizeof out);
        got = (rc == 0) ? cgac_list_slice(out, CGAC_PART, CGAC_PART, slice, sizeof slice) : -1;
        if (got != CGAC_PART) cgac_abort("p2slice");
        if (cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/gen-all-check.cx' -- --root '%s' --jobs 12 --only '%s'",
            cwd, cwd, cwd, slice)) cgac_abort("p2run");
        rc = ckk_sh("check-gen-all-check", cmd, out, sizeof out);
        ck(rc == 0 && cgac_pass_summary(out) &&
           ckk_has(out, CGAC_OUT, "GEN_CHECK\tversion-metrics-gen\tPASS\t") &&
           ckk_has(out, CGAC_OUT, "GEN_CHECK\twin-argv-gen\tPASS\t"),
           "current-tree-all-same-part2: --root . passes second half (22/22) of 44 product-table generators");

        { char *rmv[] = {"rm", "-rf", work, 0}; (void)ck_run(rmv, out, sizeof out); }
        printf("CHECK_GEN_ALL_PART2\tok=%d\tfailed=%d\tms=%ld\n", ck_assertions() - ck_failures(), ck_failures(), sy_now_ms() - t0);
        return ck_failures() ? 1 : 0;
    }

    if (!synth_mode) {
        /* Paired with --part2 for full 44-generator coverage. */
        char slice[2048], summary[128];
        int rc, got;
        if (cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/gen-all-check.cx' -- --root '%s' --list", cwd, cwd, cwd))
            cgac_abort("c1b");
        rc = ckk_sh("check-gen-all-check", cmd, out, sizeof out);
        if (cx_fmt(summary, sizeof summary, "GEN_LIST_SUMMARY\ttotal=%d\tuncovered=2\n", CGAC_GENERATORS))
            cgac_abort("list-summary");
        ck(rc == 0 && ckk_has(out, CGAC_OUT, summary) &&
           ckk_has(out, CGAC_OUT, "GEN_ITEM\tfacts-gen\t") &&
           ckk_has(out, CGAC_OUT, "GEN_ITEM\twin-argv-gen\t") &&
           ckk_has(out, CGAC_OUT, "GEN_ITEM\tcx-flatten\t") &&
           ckk_has(out, CGAC_OUT, "GEN_ITEM\tlane-inputs-gen\t") &&
           ckk_has(out, CGAC_OUT, "GEN_ITEM\tversion-metrics-gen\t") &&
           ckk_has(out, CGAC_OUT, "GEN_UNCOVERED\ttools/rt-shared-gen.cx\tknown-gap:unlisted-stdlib-state;expires=0.0.87\n") &&
           ckk_has(out, CGAC_OUT, "GEN_UNCOVERED\ttools/ucn-pp-gen.cx\tneeds-pristine-root;expires=0.0.87\n"),
           "current-tree-list-44: --list discovers 44 generators and both named waivers ending at 0.0.87");

        got = (rc == 0) ? cgac_list_slice(out, 0, CGAC_PART, slice, sizeof slice) : -1;
        if (got != CGAC_PART) cgac_abort("c1slice");
        if (cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/gen-all-check.cx' -- --root '%s' --jobs 12 --only '%s'",
            cwd, cwd, cwd, slice)) cgac_abort("c1a");
        rc = ckk_sh("check-gen-all-check", cmd, out, sizeof out);
        ck(rc == 0 && cgac_pass_summary(out) &&
           ckk_has(out, CGAC_OUT, "GEN_CHECK\tfacts-gen\tPASS\t") &&
           ckk_has(out, CGAC_OUT, "GEN_CHECK\tlane-inputs-gen\tPASS\t") &&
           ckk_has(out, CGAC_OUT, "GEN_CHECK\tcx-flatten\tPASS\t"),
           "current-tree-all-same: --root . passes first half (22/22) of 44 product-table generators");

        { char *rmv[] = {"rm", "-rf", work, 0}; (void)ck_run(rmv, out, sizeof out); }
        printf("CHECK_GEN_ALL_CHECK\tok=%d\tfailed=%d\tms=%ld\n", ck_assertions() - ck_failures(), ck_failures(), sy_now_ms() - t0);
        return ck_failures() ? 1 : 0;
    }

    /* --synth mode: history-independent synthetic stamp drifts + --bg/--poll + optional git history replays */

    /* History-independent synthetic win-argv stamp drift (works in single-commit qualify layouts) */
    {
        char sw[CGAC_PW], fp[CGAC_PW];
        int rc;
        if (cx_fmt(sw, sizeof sw, "%s/synth-winargv", work)) cgac_abort("sw");
        cgac_mk(sw);
        if (cx_fmt(cmd, sizeof cmd,
            "git -C '%s' archive HEAD -- exec/facts cx tools/win-argv-gen.cx cxroot.tsv | tar -x -C '%s'", cwd, sw))
            cgac_abort("swprep");
        if (ckk_sh("check-gen-all-check", cmd, out, sizeof out) != 0) cgac_abort("swprep-run");
        if (cx_fmt(fp, sizeof fp, "%s/exec/facts/enc-x86win-winargs.tsv", sw) || cgac_flip_first_sha(fp)) cgac_abort("swflip");
        if (cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/gen-all-check.cx' -- --root '%s' --only win-argv-gen", cwd, cwd, sw))
            cgac_abort("swrun");
        rc = ckk_sh("check-gen-all-check", cmd, out, sizeof out);
        ck(rc == 1 && ckk_has(out, CGAC_OUT, "GEN_CHECK\twin-argv-gen\tDIFF\t") &&
           ckk_has(out, CGAC_OUT, "enc-x86win-winargs") &&
           ckk_has(out, CGAC_OUT, "fix: sh ./unisacc.com tools/win-argv-gen.cx -- --write ."),
           "synth-winargv-stamp-drift-refused: tampered winargs provenance stamp reports win-argv-gen DIFF + --write fix");
    }

    /* History-independent synthetic k2-gen2 stamp drift (works in single-commit qualify layouts) */
    {
        char sk[CGAC_PW], fp[CGAC_PW];
        int rc;
        if (cx_fmt(sk, sizeof sk, "%s/synth-k2gen2", work)) cgac_abort("sk");
        cgac_mk(sk);
        if (cx_fmt(cmd, sizeof cmd,
            "git -C '%s' archive HEAD | tar -x -C '%s' && "
            "ln -s '%s/unisacc.com' '%s/unisacc.com'", cwd, sk, cwd, sk)) cgac_abort("skprep");
        if (ckk_sh("check-gen-all-check", cmd, out, sizeof out) != 0) cgac_abort("skprep-run");
        if (cx_fmt(fp, sizeof fp, "%s/exec/facts/k2-gen2.tsv", sk) || cgac_flip_first_sha(fp)) cgac_abort("skflip");
        if (cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/gen-all-check.cx' -- --root '%s' --only facts-gen", cwd, cwd, sk))
            cgac_abort("skrun");
        rc = ckk_sh("check-gen-all-check", cmd, out, sizeof out);
        ck(rc == 1 && ckk_has(out, CGAC_OUT, "GEN_CHECK\tfacts-gen\tDIFF\t") &&
           ckk_has(out, CGAC_OUT, "k2-gen2") &&
           ckk_has(out, CGAC_OUT, "fix: sh ./unisacc.com tools/facts-gen.cx -- --write ."),
           "synth-k2gen2-stamp-drift-refused: tampered k2-gen2 provenance stamp reports facts-gen DIFF + --write fix");
    }

    /* Background --bg and --poll roundtrip */
    {
        char bgd[CGAC_PW];
        int rc_bg, rc_p = 3, tries = 0;
        if (cx_fmt(bgd, sizeof bgd, "%s/bg", work)) cgac_abort("bgd");
        if (cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/gen-all-check.cx' -- --bg '%s' --root '%s' --only win-argv-gen",
            cwd, cwd, bgd, cwd)) cgac_abort("c5a");
        rc_bg = ckk_sh("check-gen-all-check", cmd, out, sizeof out);
        int ok_bg = (rc_bg == 0 && ckk_has(out, CGAC_OUT, "GEN_ALL_BG\t") && ckk_has(out, CGAC_OUT, "status=STARTED"));
        while (rc_p == 3 && tries < 40) {
            if (cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/gen-all-check.cx' -- --poll '%s'", cwd, cwd, bgd))
                cgac_abort("c5b");
            rc_p = ckk_sh("check-gen-all-check", cmd, out, sizeof out);
            if (rc_p == 3) {
                char *sl[] = {"sleep", "0.2", 0};
                char dummy[64];
                (void)ck_run(sl, dummy, sizeof dummy);
            }
            tries++;
        }
        ck(ok_bg && rc_p == 0 && ckk_has(out, CGAC_OUT, "GEN_ALL_SUMMARY\ttotal=1\tpass=1\tdiff=0\terror=0\t"),
           "bg-and-poll-roundtrip: --bg starts and --poll retrieves completed summary");
    }

    /* Optional real git history replays: run when commits exist in local git history, else print named NOT_RUN (never counted as PASS) */
    {
        if (cx_fmt(cmd, sizeof cmd, "git -C '%s' cat-file -e d20a8f64af^{commit} 2>/dev/null", cwd)) cgac_abort("h82chk");
        if (ckk_sh("check-gen-all-check", cmd, out, sizeof out) == 0) {
            char h82[CGAC_PW];
            int rc;
            if (cx_fmt(h82, sizeof h82, "%s/hist-d20", work)) cgac_abort("h82");
            cgac_mk(h82);
            if (cx_fmt(cmd, sizeof cmd,
                "git -C '%s' archive d20a8f64af -- exec/facts cx tools/win-argv-gen.cx cxroot.tsv | tar -x -C '%s'", cwd, h82))
                cgac_abort("c3prep");
            if (ckk_sh("check-gen-all-check", cmd, out, sizeof out) != 0) cgac_abort("c3prep-run");
            if (cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/gen-all-check.cx' -- --root '%s' --only win-argv-gen", cwd, cwd, h82))
                cgac_abort("c3");
            rc = ckk_sh("check-gen-all-check", cmd, out, sizeof out);
            ck(rc == 1 && ckk_has(out, CGAC_OUT, "GEN_CHECK\twin-argv-gen\tDIFF\t") &&
               ckk_has(out, CGAC_OUT, "enc-x86win-winargs") &&
               ckk_has(out, CGAC_OUT, "fix: sh ./unisacc.com tools/win-argv-gen.cx -- --write ."),
               "hist-0082-winargv-drift-refused: d20a8f64af replay reports win-argv-gen DIFF + --write fix");
        } else {
            printf("NOT_RUN\thist-0082-winargv-drift-refused\treason=shallow-single-commit-layout\n");
        }
    }

    {
        if (cx_fmt(cmd, sizeof cmd, "git -C '%s' cat-file -e 8d79aea9b9^{commit} 2>/dev/null", cwd)) cgac_abort("h83chk");
        if (ckk_sh("check-gen-all-check", cmd, out, sizeof out) == 0) {
            char h83[CGAC_PW];
            int rc;
            if (cx_fmt(h83, sizeof h83, "%s/hist-8d7", work)) cgac_abort("h83");
            cgac_mk(h83);
            if (cx_fmt(cmd, sizeof cmd,
                "git -C '%s' archive 8d79aea9b9 | tar -x -C '%s' && ln -s '%s/unisacc.com' '%s/unisacc.com'", cwd, h83, cwd, h83))
                cgac_abort("c4prep");
            if (ckk_sh("check-gen-all-check", cmd, out, sizeof out) != 0) cgac_abort("c4prep-run");
            if (cx_fmt(cmd, sizeof cmd, "sh '%s/unisacc.com' '%s/tools/gen-all-check.cx' -- --root '%s' --only facts-gen", cwd, cwd, h83))
                cgac_abort("c4");
            rc = ckk_sh("check-gen-all-check", cmd, out, sizeof out);
            ck(rc == 1 && ckk_has(out, CGAC_OUT, "GEN_CHECK\tfacts-gen\tDIFF\t") &&
               ckk_has(out, CGAC_OUT, "k2-gen2") &&
               ckk_has(out, CGAC_OUT, "fix: sh ./unisacc.com tools/facts-gen.cx -- --write ."),
               "hist-0083-k2gen2-drift-refused: 8d79aea9b9 replay reports facts-gen k2-gen2 DIFF + --write fix");
        } else {
            printf("NOT_RUN\thist-0083-k2gen2-drift-refused\treason=shallow-single-commit-layout\n");
        }
    }

    { char *rmv[] = {"rm", "-rf", work, 0}; (void)ck_run(rmv, out, sizeof out); }

    printf("CHECK_GEN_ALL_SYNTH\tok=%d\tfailed=%d\tms=%ld\n", ck_assertions() - ck_failures(), ck_failures(), sy_now_ms() - t0);
    return ck_failures() ? 1 : 0;
}
