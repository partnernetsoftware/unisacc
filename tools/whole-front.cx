static int image_phase(int argc,char **argv){
 if((argc!=7&&argc!=8)||(argc==8&&strcmp(argv[7],"--resume")))die("usage: image-build|image-verify PREPARED_DIR TARGET PHASE STUB_DIR OUT [--resume]");
 int verify=!strcmp(argv[1],"image-verify"),resume=argc==8;const char *targets[]={"osx/x86_64","osx/arm64","win/x86_64","win/arm64","lnx/x86_64","lnx/arm64"};int valid=0;for(int i=0;i<6;i++)if(!strcmp(argv[3],targets[i]))valid=1;if(!valid)die("image target");
 long long start=phase_now();physical(argv[2],prepared);char phase[4400],stub[4400],dest[4400];physical(argv[4],phase);physical(argv[5],stub);new_name(argv[6],dest);phase_control(dest,verify||resume);
 epoch_clear();epoch_active=1;
 np_buf before={0},upstream={0},again={0},manifest={0},r={0};inputs(&before);image_stub(argv[3],phase,stub,&upstream);
 np_puts(&manifest,"whole-front-image-input-v1\n");add(&manifest,"prepared",prepared);add(&manifest,"target",argv[3]);add(&manifest,"phase",phase);add(&manifest,"stub",stub);add(&manifest,"root",root);add(&manifest,"ctor",ctor);add(&manifest,"pkg",pkg);np_put(&manifest,before.p,before.n);np_put(&manifest,upstream.p,upstream.n);
 char p[4400],image[4400],slice[128];if(cx_fmt(slice,sizeof slice,"slice-%s",argv[3]))die("slice name bound");for(char *s=slice;*s;s++)if(*s=='/')*s='-';path(image,dest,"image");
 if(verify||resume){path(p,dest,"INPUT");size_t n;char *s=load(p,&n);if(n!=manifest.n||memcmp(s,manifest.p,n))die("image INPUT changed");free(s);}else{
  if(mkdir(dest,0700))die("exclusive image NEW_OUT");char evidence[4400];if(tx_copy(evidence,sizeof evidence,out,(long)strlen(out)))die("text copy bound");if(tx_copy(out,sizeof out,dest,(long)strlen(dest)))die("text copy bound");save("INPUT",manifest.p,manifest.n);
  if(setenv("TMPDIR",tmpdir,1)||setenv("UNISA_CONTAINER",pkg,1)||setenv("UNISACC_PHASE","B",1)||setenv("UNISACC_PHASE_IN",phase,1)||unsetenv("UNISACC_PHASE_OUT"))die("image environment");
  char *v[50],log[4400];int k=0;v[k++]=ctor;v[k++]="-o";v[k++]=image;v[k++]="-b";v[k++]=argv[3];for(int i=0;i<44;i++)v[k++]=root_args[i];v[k]=0;epoch_clear();long long t=phase_now();run(v,root,log);long long ns=phase_now()-t;epoch_clear();
  size_t n;char *s=load(log,&n);save("stdout",s,n);free(s);char err[64];if(cx_fmt(err,sizeof err,"child-%d.stderr",serial-1))die("image stderr name");path(p,dest,err);s=load(p,&n);save("stderr",s,n);free(s);np_buf timing={0};np_putll(&timing,ns);np_puts(&timing,"\n");save("construct_ns",timing.p,timing.n);free(timing.p);
  /* PKG already contains its footer: append unchanged, exactly once. */
  size_t ni,np;char *ib=load(image,&ni),*pb=load(pkg,&np);if(ni>536870912-np)die("slice extent");int fd;path(p,dest,slice);fd=open(p,O_WRONLY|O_CREAT|O_EXCL,0700);if(fd<0)die("exclusive slice");const char *blocks[]={ib,pb};size_t lengths[]={ni,np};for(int j=0;j<2;j++){size_t at=0;while(at<lengths[j]){ssize_t z=write(fd,blocks[j]+at,lengths[j]-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("slice write");at+=(size_t)z;tick();}}if(close(fd))die("slice close");free(ib);free(pb);if(tx_copy(out,sizeof out,evidence,(long)strlen(evidence)))die("text copy bound");
 }
 if(!verify&&!resume)image_pin(dest,slice);
 /* Recovery is explicit: pin only when no checkpoint exists. */
 path(p,control,"built.tsv");struct stat checkpoint_stat;if((verify||resume)&&lstat(p,&checkpoint_stat)){if(errno!=ENOENT)die("build checkpoint access");image_pin(dest,slice);}
 np_buf artifacts={0};image_artifacts(dest,slice,&artifacts);image_checkpoint(&manifest,&artifacts,verify||resume);
 if(!verify){
  epoch_clear();epoch_active=0;tick();
  free(before.p);free(upstream.p);free(manifest.p);free(artifacts.p);free(r.p);printf("BUILT_UNVERIFIED\twhole-front\timage=%s\tno-qualification\n",image);return 0;
 }
 /* Fresh post traversal: no pre-traversal SHA or input facts survive. */
 epoch_clear();same_inputs(&before);image_stub(argv[3],phase,stub,&again);if(upstream.n!=again.n||memcmp(upstream.p,again.p,upstream.n))die("image upstream changed");
 epoch_clear();epoch_active=0;np_buf after_artifacts={0};image_artifacts(dest,slice,&after_artifacts);if(artifacts.n!=after_artifacts.n||memcmp(artifacts.p,after_artifacts.p,artifacts.n))die("image artifacts changed");free(after_artifacts.p);
 np_puts(&r,"whole-front-image-v1\nstatus\tPREPARED\nscope\tdevelopment-materials-no-qualification\n");char *entries=strchr(manifest.p,'\n')+1;np_put(&r,entries,manifest.n-(size_t)(entries-manifest.p));add(&r,"output",dest);image_file(dest,"INPUT",&r);image_file(dest,"image",&r);image_file(dest,slice,&r);image_file(dest,"stdout",&r);image_file(dest,"stderr",&r);image_file(dest,"construct_ns",&r);dir_identity(dest,&r,"output_dev_ino");dir_identity(control,&r,"control_dev_ino");tick();long long elapsed=phase_now()-start;phase_ready(&r,resume,elapsed);tick();free(before.p);free(upstream.p);free(again.p);free(manifest.p);free(artifacts.p);free(r.p);printf("PREPARED\twhole-front\timage=%s\tresume=%s/ready.tsv\tverify_ns=%lld\tno-qualification\n",image,control,elapsed);return 0;
}
/* Ordered fr_add wire; no model semantics are reproduced here. */
static char sp_src[WF_MAX][4400];static int sp_n;static char sp_stub[4400],sp_stub_sha[65];
static unsigned long sp32(const char *p){const unsigned char *q=(const unsigned char *)p;return (unsigned long)q[0]|((unsigned long)q[1]<<8)|((unsigned long)q[2]<<16)|((unsigned long)q[3]<<24);}
static void sp_take(char *b,size_t n,size_t *at,const char *key,char v[4400]){if(*at>n||n-*at<8)die("span record extent");unsigned long z=sp32(b+*at),k=sp32(b+*at+4);if(z<4||z>n-*at-4||k>z-4||k!=strlen(key)||memcmp(b+*at+8,key,k))die("span record order");size_t len=z-4-k;if(len>=4400||memchr(b+*at+8+k,0,len))die("span record value");if(mm_copy(v,4400,b+*at+8+k,(long)len))die("span value bound");v[len]=0;if(strpbrk(v,"\t\r\n"))die("span value text");*at+=4+z;}
static void sp_expect(char *b,size_t n,size_t *at,const char *key,const char *want){char v[4400];sp_take(b,n,at,key,v);if(strcmp(v,want))die("span identity mismatch");}
static int sp_stage(const char *s){const char *st[]={"units","e3","prune","lower","elf"};for(int i=0;i<5;i++)if(!strcmp(s,st[i]))return i;die("span stage boundary");return -1;}
static void sp_attrs(char *b,size_t n){if(!n)return;if(n<4)die("span attrs");unsigned long c=sp32(b);if(c>(n-4)/9||n!=4+9*c)die("span attrs extent");for(size_t i=4;i<n;i+=9)if(sp32(b+i)>=(unsigned long)sp_n)die("span attrs unit");}
static void sp_sources(np_buf *b){for(int i=0;i<sp_n;i++){char p[4400],q[4400],h[65];if(sp_src[i][0]=='/')physical(sp_src[i],p);else{path(q,root,sp_src[i]);physical(q,p);}add(b,"source",sp_src[i]);digest(p,h);add(b,"source_sha",h);}}
static void sp_phase(const char *file,np_buf *b,int establish){char h[65];digest(file,h);add(b,"phase_sha",h);size_t n;char *s=load(file,&n);if(n<8)die("span phase header");unsigned long fn=sp32(s),an=sp32(s+4);if(!fn||fn>n-8||an!=n-8-fn)die("span phase extent");size_t at=8,end=8+fn;int nr=0;while(at<end){if(end-at<8||nr==WF_MAX)die("span frames");unsigned long z=sp32(s+at),k=sp32(s+at+4);if(z<4||z>end-at-4||!k||k>=4400||k>z-4||memchr(s+at+8,0,k))die("span frame extent");char name[4400];if(mm_copy(name,sizeof name,s+at+8,(long)k))die("span source bound");name[k]=0;if(strpbrk(name,"\t\r\n"))die("span source text");if(establish){for(int j=0;j<nr;j++)if(!strcmp(name,sp_src[j]))die("span duplicate source");if(tx_copy(sp_src[nr],sizeof sp_src[nr],name,(long)strlen(name)))die("text copy bound");}else if(nr>=sp_n||strcmp(sp_src[nr],name))die("span source order");nr++;at+=4+z;}if(establish)sp_n=nr;else if(nr!=sp_n)die("span source count");sp_attrs(s+end,an);free(s);}
static void sp_checkpoint(const char *dir,const char *target,int nr,char **roots,const char *first,const char *last,int establish,np_buf *b){
 char p[4400],h[65],v[4400];path(p,dir,"ready");digest(p,h);add(b,"worker_ready_sha",h);size_t n,at=0;char *s=load(p,&n);sp_expect(s,n,&at,"format","WIN_SPAN_CHECKPOINT_1");sp_expect(s,n,&at,"pkg",pkg);digest(pkg,h);sp_expect(s,n,&at,"pkg_sha256",h);sp_expect(s,n,&at,"target",target);sp_take(s,n,&at,"roots_count",v);if(number(v)!=nr)die("span roots count");for(int i=0;i<nr;i++)sp_expect(s,n,&at,"root",roots[i]);sp_take(s,n,&at,"n",v);long total=number(v);if(total<1||total>WF_MAX||(!establish&&total!=sp_n))die("span sources count");if(establish)sp_n=(int)total;for(int i=0;i<total;i++){sp_take(s,n,&at,"source",v);if(establish){for(int j=0;j<i;j++)if(!strcmp(v,sp_src[j]))die("span duplicate source");if(tx_copy(sp_src[i],sizeof sp_src[i],v,(long)strlen(v)))die("text copy bound");}else if(strcmp(v,sp_src[i]))die("span source order");}if(*sp_stub){sp_expect(s,n,&at,"forward_stub",sp_stub);digest(sp_stub,h);if(strcmp(h,sp_stub_sha))die("span stub changed");sp_expect(s,n,&at,"forward_stub_sha256",h);add(b,"forward_stub_sha",h);}sp_take(s,n,&at,"first",v);int fi=sp_stage(v);if(last&&strcmp(v,first))die("span first");sp_take(s,n,&at,"last",v);int li=sp_stage(v);if(li<fi||(last?strcmp(last,v):li+1!=sp_stage(first)))die("span continuity");if(*sp_stub&&!last&&(fi!=0||li!=1))die("B checkpoint must be units..e3");path(p,dir,"body.bin");digest(p,h);sp_expect(s,n,&at,"body_sha256",h);add(b,"body_sha",h);path(p,dir,"attrs.bin");digest(p,h);sp_expect(s,n,&at,"attrs_sha256",h);add(b,"attrs_sha",h);size_t an;char *a=load(p,&an);sp_attrs(a,an);free(a);sp_take(s,n,&at,"kind",v);if(at!=n||(strcmp(v,"OPAQUE")&&strcmp(v,"DIRECT_IMAGE")&&strcmp(v,"FORWARD_FRAME")))die("span kind");path(p,dir,"body.bin");size_t bn;char *body=load(p,&bn);if(!strcmp(v,"OPAQUE")&&bn==0){free(body);free(s);die("span empty opaque body");}int frame=bn>=6&&!memcmp(body,"USLFW1",6);if((!strcmp(v,"FORWARD_FRAME"))!=frame||(!strcmp(v,"DIRECT_IMAGE")&&li!=sp_stage("elf"))||(!strcmp(v,"OPAQUE")&&li==sp_stage("elf")))die("span kind/body");if(!strcmp(v,"DIRECT_IMAGE")){path(p,dir,"image");size_t in;char *im=load(p,&in);if(in!=bn||memcmp(im,body,bn))die("span image bytes");if(!strncmp(target,"win/",4)){if(bn<64||memcmp(body,"MZ",2))die("span PE header");unsigned long pe=sp32(body+60);if(pe<64||pe>bn-24||memcmp(body+pe,"PE\0\0",4))die("span PE header");unsigned machine=(unsigned char)body[pe+4]|((unsigned)(unsigned char)body[pe+5]<<8);if(machine!=(!strcmp(target,"win/arm64")?0xaa64:0x8664))die("span PE machine");}else if(bn<32||sp32(body)!=0xfeedfacfUL||sp32(body+4)!=(!strcmp(target,"osx/arm64")?0x100000cUL:0x1000007UL))die("span MachO header/cpu");free(im);digest(p,h);add(b,"image_sha",h);}add(b,"kind",v);free(body);free(s);
}
static void span_require_template(void){
 char p[4400];size_t n;char *t;path(p,prepared,"receipt.txt");t=load(p,&n);
 if(!t||tx_find(t,(long)n,"whole-win-span.cx.in",20)<0){free(t);die("span requires prepared template whole-win-span.cx.in (whole-front.cx.in worker has no span; was silent rc=2)");}
 free(t);
}
static int span_cli(int argc,char **argv){
 int resume=argc>1&&!strcmp(argv[argc-1],"--resume"),end=argc-resume,nr=end-8;sp_stub[0]=0;if(nr>=3&&!strcmp(argv[end-2],"--forward-stub")){physical(argv[end-1],sp_stub);digest(sp_stub,sp_stub_sha);nr-=2;}if(nr<1||nr>WF_MAX)die("usage: span PREPARED_DIR TARGET INPUT NEW_OUT FIRST LAST ROOT... [--resume]");if(strcmp(argv[3],"win/x86_64")&&strcmp(argv[3],"win/arm64")&&strcmp(argv[3],"osx/x86_64")&&strcmp(argv[3],"osx/arm64"))die("span target");int first=sp_stage(argv[6]),last=sp_stage(argv[7]);if(first>last)die("span reversed stages");if(*sp_stub&&!((first==0&&last==1)||(first==2&&last==4)))die("B requires units..e3 or prune..elf");physical(argv[2],prepared);span_require_template();char input[4400],dest[4400];physical(argv[4],input);new_name(argv[5],dest);phase_control(dest,resume);epoch_active=0;np_buf before={0},after={0},ib={0},ia={0},result={0},r={0};inputs(&before);if(!first)sp_phase(input,&ib,1);else sp_checkpoint(input,argv[3],nr,argv+8,argv[6],0,1,&ib);sp_sources(&ib);
 if(!resume){char *v[WF_MAX+11],log[4400];int k=0;v[k++]=worker_image;v[k++]="span";v[k++]=pkg;v[k++]=argv[3];v[k++]=input;v[k++]=dest;v[k++]=argv[6];v[k++]=argv[7];for(int i=0;i<nr;i++)v[k++]=argv[8+i];if(*sp_stub){v[k++]="--forward-stub";v[k++]=sp_stub;}v[k]=0;run(v,root,log);}
 inputs(&after);if(before.n!=after.n||memcmp(before.p,after.p,before.n))die("span context changed");if(!first)sp_phase(input,&ia,0);else sp_checkpoint(input,argv[3],nr,argv+8,argv[6],0,0,&ia);sp_sources(&ia);if(ib.n!=ia.n||memcmp(ib.p,ia.p,ib.n))die("span input changed");if(*sp_stub&&!first){if(sp_n==WF_MAX)die("span stub source bound");for(int i=sp_n;i>1;i--)if(tx_copy(sp_src[i],sizeof sp_src[i],sp_src[i-1],(long)strlen(sp_src[i-1])))die("text copy bound");if(tx_copy(sp_src[1],sizeof sp_src[1],sp_stub,(long)strlen(sp_stub)))die("text copy bound");sp_n++;}if(*sp_stub){char sh[65];digest(sp_stub,sh);if(strcmp(sh,sp_stub_sha))die("span stub changed");}sp_checkpoint(dest,argv[3],nr,argv+8,argv[6],argv[7],0,&result);np_puts(&r,"whole-front-span-v1\nstatus\tPREPARED\nscope\tdevelopment-materials-no-qualification\n");if(*sp_stub){add(&r,"forward_stub",sp_stub);add(&r,"forward_stub_sha",sp_stub_sha);}add(&r,"prepared",prepared);add(&r,"target",argv[3]);add(&r,"input",input);add(&r,"output",dest);add(&r,"first",argv[6]);add(&r,"last",argv[7]);for(int i=0;i<nr;i++)add(&r,"root",argv[8+i]);addnum(&r,"ctx_before_bytes",before.n);np_put(&r,before.p,before.n);addnum(&r,"ctx_after_bytes",after.n);np_put(&r,after.p,after.n);addnum(&r,"input_before_bytes",ib.n);np_put(&r,ib.p,ib.n);addnum(&r,"input_after_bytes",ia.n);np_put(&r,ia.p,ia.n);np_put(&r,result.p,result.n);dir_identity(dest,&r,"output_dev_ino");dir_identity(control,&r,"control_dev_ino");char p[4400],q[4400];path(q,control,"ready.tsv");if(resume){size_t oldn;char *old=load(q,&oldn);if(oldn!=r.n||memcmp(old,r.p,oldn))die("span ready changed");free(old);}else{save("ready.tsv",r.p,r.n);path(p,out,"ready.tsv");if(rename(p,q))die("span ready publish");}free(before.p);free(after.p);free(ib.p);free(ia.p);free(result.p);free(r.p);printf("PREPARED\twhole-front\tspan=%s\tno-qualification\n",dest);return 0;
}
int main(int argc,char **argv){began=sy_now_ms();if(argc>1&&!strcmp(argv[1],"span"))return span_cli(argc,argv);if(argc>1&&(!strcmp(argv[1],"image-build")||!strcmp(argv[1],"image-verify")))return image_phase(argc,argv);if(argc>1&&!strcmp(argv[1],"front"))return front(argc,argv);if(argc>1&&!strcmp(argv[1],"merge"))return merge_phase(argc,argv);if(argc>1&&!strcmp(argv[1],"stub"))return stub_phase(argc,argv);if((argc!=7&&argc!=9)||strcmp(argv[1],"prepare")||(argc==9&&(strcmp(argv[7],"--template")||argv[8][0]!='/')))die("usage: prepare ROOT PKG CTOR OBJECTS NEW_OUT [--template ABS_TEMPLATE]; front PREPARED_DIR TARGET NEW_PART FIRST COUNT [--resume]; merge PREPARED_DIR TARGET NEW_PHASE PART... [--resume]; stub PREPARED_DIR TARGET PHASE NEW_OUT [--resume]; image-build PREPARED_DIR TARGET PHASE STUB_DIR NEW_OUT [--resume]; image-verify PREPARED_DIR TARGET PHASE STUB_DIR OUT [--resume]; span PREPARED_DIR TARGET INPUT NEW_OUT FIRST LAST ROOT... [--resume]");physical(argv[2],root);physical(argv[3],pkg);physical(argv[4],ctor);physical(argv[5],objects);const char *env=getenv("UNISACC_IDENTITY_HELPER");if(!env||!*env)die("explicit UNISACC_IDENTITY_HELPER required");physical(env,helper);if(access(ctor,X_OK)||access(helper,X_OK))die("native executable required");if(argc==9)physical(argv[8],tmpl);else{char p[4400];path(p,root,"tools/templates/whole-front.cx.in");physical(p,tmpl);}if(strpbrk(argv[6],"\t\r\n")||mkdir(argv[6],0700))die("exclusive NEW_OUT required");physical(argv[6],out);
 char tmp[4400],tmp_physical[4400],tmp_record[4700];struct stat tmp_stat;path(tmp,out,"tmp");if(mkdir(tmp,0700))die("exclusive prepare TMPDIR");physical(tmp,tmp_physical);if(lstat(tmp_physical,&tmp_stat)||!S_ISDIR(tmp_stat.st_mode)||setenv("TMPDIR",tmp_physical,1))die("prepare TMPDIR identity/environment");if(cx_fmt(tmp_record,sizeof tmp_record,"whole-front-tmp-v1\nstatus\tPREPARED\nscope\tprepare-only\npath\t%s\ndev\t%lu\nino\t%lu\n",tmp_physical,(unsigned long)tmp_stat.st_dev,(unsigned long)tmp_stat.st_ino))die("TMPDIR receipt bound");save("tmp.identity",tmp_record,strlen(tmp_record));
 char ph[65],ch[65],hh[65],th[65],rh[65],source[65],after[65],p[4400],h[65];long pb=digest(pkg,ph),cb=digest(ctor,ch),hb=digest(helper,hh),tb=digest(tmpl,th);sid(source);if(digest(helper,h)!=hb||strcmp(h,hh))die("helper changed");path(p,objects,"receipt.txt");digest(p,rh);size_t n;char *receipt=load(p,&n);if(memchr(receipt,0,n)||memchr(receipt,'\r',n))die("receipt text");char *at=receipt,*s;int root_seen=0,pkg_seen=0,sha_seen=0;while((s=line(&at))){char *tab=strchr(s,'\t');if(!tab)continue;*tab++=0;if(!strcmp(s,"root")){if(root_seen++||strcmp(tab,root))die("receipt root mismatch");}else if(!strcmp(s,"p3")){if(pkg_seen++||strcmp(tab,pkg))die("receipt p3 mismatch");}else if(!strcmp(s,"p3_sha")){if(sha_seen++||strcmp(tab,ph))die("receipt p3 SHA mismatch");}else{size_t z=strlen(s);if(z<2||strcmp(s+z-2,".o"))continue;if(count==WF_MAX||z>=256||strpbrk(s,"/\\ ")||find(s)>=0)die("duplicate/unsafe object");for(size_t k=0;k<z;k++)if(!strchr("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-",s[k]))die("object basename");char *sha=0,*bytes=0,*f=tab;for(;;){char *e=strchr(f,'\t');if(e)*e=0;if(!strncmp(f,"sha=",4)){if(sha)die("duplicate SHA field");sha=f+4;}if(!strncmp(f,"bytes=",6)){if(bytes)die("duplicate bytes field");bytes=f+6;}if(!e)break;f=e+1;}if(!sha||!bytes||!hex(sha))die("object SHA/bytes fields");if(tx_copy(names[count],sizeof names[count],s,(long)strlen(s)))die("text copy bound");if(tx_copy(hashes[count],sizeof hashes[count],sha,(long)strlen(sha)))die("text copy bound");sizes[count++]=number(bytes);}}
 free(receipt);if(root_seen!=1||pkg_seen!=1||sha_seen!=1||!count||find("drive.o")<0||find("worker.o")>=0)die("incomplete object receipt");check_objects();roots();char worker[4400],wo[4400],image[4400];path(worker,out,"worker.cx");path(wo,out,"worker.o");path(image,out,"worker");char *text=load(tmpl,&n);save("worker.cx",text,n);free(text);if(setenv("UNISA_CONTAINER",pkg,1))die("container environment");char log[4400];char *cv[]={ctor,"-c","-funit",worker,"-o",wo,0};long compile_ms=run(cv,root,log);char *lv[WF_MAX+6];char paths[WF_MAX][4400];int k=0;lv[k++]=ctor;lv[k++]="-o";lv[k++]=image;for(int i=0;i<count;i++)if(strcmp(names[i],"drive.o")){path(paths[i],objects,names[i]);lv[k++]=paths[i];}lv[k++]=wo;lv[k]=0;long link_ms=run(lv,root,log);
 check_objects();path(p,objects,"receipt.txt");digest(p,h);if(strcmp(h,rh)||digest(pkg,h)!=pb||strcmp(h,ph)||digest(ctor,h)!=cb||strcmp(h,ch)||digest(helper,h)!=hb||strcmp(h,hh)||digest(tmpl,h)!=tb||strcmp(h,th))die("input identity changed");sid(after);if(strcmp(source,after)||digest(helper,h)!=hb||strcmp(h,hh))die("source/helper identity changed");digest(worker,h);if(strcmp(h,th))die("worker source changed");char wh[65],ih[65],roots_sha[65];long wb=digest(wo,wh),ib=digest(image,ih);path(p,out,"roots.txt");digest(p,roots_sha);np_buf r={0};np_puts(&r,"whole-front-prepare-v1\nstatus\tPREPARED\nscope\tdevelopment-materials-no-qualification\n");const char *keys[]={"root","pkg","ctor","helper","template","objects","source_sid","pkg_sha","ctor_sha","helper_sha","template_sha","object_receipt_sha","worker_object_sha","worker_sha","roots_sha"};const char *values[]={root,pkg,ctor,helper,tmpl,objects,source,ph,ch,hh,th,rh,wh,ih,roots_sha};for(int i=0;i<15;i++){np_puts(&r,keys[i]);np_puts(&r,"\t");np_puts(&r,values[i]);np_puts(&r,"\n");}for(int i=0;i<count;i++){np_puts(&r,names[i]);np_puts(&r,"\tsha=");np_puts(&r,hashes[i]);np_puts(&r,"\tbytes=");np_putll(&r,sizes[i]);np_puts(&r,"\n");}np_puts(&r,"compile_ms\t");np_putll(&r,compile_ms);np_puts(&r,"\nlink_ms\t");np_putll(&r,link_ms);np_puts(&r,"\nworker_object_bytes\t");np_putll(&r,wb);np_puts(&r,"\nworker_bytes\t");np_putll(&r,ib);np_puts(&r,"\nelapsed_ms\t");np_putll(&r,sy_now_ms()-began);np_puts(&r,"\n");save("receipt.txt",r.p,r.n);free(r.p);tick();printf("PREPARED\twhole-front\tout=%s\tresume=receipt.txt\tno-qualification\n",out);return 0;}
