static int stub_phase(int argc,char **argv);
/* Resume traversals share the entry deadline, but never their mutable path state.
 * Receipt readers own no live fields across this boundary. Keep serial monotonic
 * so returning to the parent's evidence directory cannot reuse a log name. */
static void resume_call(int (*phase)(int,char **),int argc,char **argv){
 struct resume_state {char paths[12][4400],names[WF_MAX][256],hashes[WF_MAX][65],roots[44][4400];long sizes[WF_MAX];int count;} *s=malloc(sizeof *s);
 if(!s)die("resume state allocation");
 char *paths[]={root,pkg,ctor,objects,out,tmpl,helper,prepared,part,control,worker_image,tmpdir};
 for(int i=0;i<12;i++)memcpy(s->paths[i],paths[i],4400);
 memcpy(s->names,names,sizeof names);memcpy(s->hashes,hashes,sizeof hashes);memcpy(s->sizes,sizes,sizeof sizes);memcpy(s->roots,root_args,sizeof root_args);s->count=count;
 const char *env=getenv("TMPDIR");char *saved_env=0;if(env){saved_env=malloc(strlen(env)+1);if(!saved_env)die("resume environment allocation");if(tx_copy(saved_env,(long)strlen(env)+1,env,(long)strlen(env)))die("text copy bound");}
 /* argv[2] otherwise aliases prepared, which the child parser overwrites. */
 /* Preserve the child-log/output contract without spawning this executable. */
 char stdout_path[4400],stderr_path[4400],name[64];if(cx_fmt(name,sizeof name,"child-%d.stdout",serial))die("resume log name");path(stdout_path,out,name);if(cx_fmt(name,sizeof name,"child-%d.stderr",serial++))die("resume log name");path(stderr_path,out,name);
 if(fflush(stdout)||fflush(stderr))die("flush resume logs");int saved_stdout=dup(1),saved_stderr=dup(2),fo=open(stdout_path,O_WRONLY|O_CREAT|O_EXCL,0600),fe=open(stderr_path,O_WRONLY|O_CREAT|O_EXCL,0600);if(saved_stdout<0||saved_stderr<0||fo<0||fe<0||dup2(fo,1)<0||dup2(fe,2)<0)die("exclusive resume logs");close(fo);close(fe);
 char *saved_prepared=argv[2];argv[2]=s->paths[7];int saved_depth=resume_depth;resume_depth++;tick();int rc=phase(argc,argv);tick();resume_depth=saved_depth;argv[2]=saved_prepared;
 if(fflush(stdout)||fflush(stderr)||dup2(saved_stdout,1)<0||dup2(saved_stderr,2)<0)die("restore resume logs");close(saved_stdout);close(saved_stderr);
 for(int i=0;i<12;i++)memcpy(paths[i],s->paths[i],4400);
 memcpy(names,s->names,sizeof names);memcpy(hashes,s->hashes,sizeof hashes);memcpy(sizes,s->sizes,sizeof sizes);memcpy(root_args,s->roots,sizeof root_args);count=s->count;
 if(saved_env){if(setenv("TMPDIR",saved_env,1))die("restore resume environment");free(saved_env);}else if(unsetenv("TMPDIR"))die("restore resume environment");
 free(s);receipt_text=0;nf=0;if(rc)die("resume failed");
}
static void verified_part(const char *target,const char *dir,long first,long amount){
 char a[64],b[64];if(cx_fmt(a,sizeof a,"%ld",first)||cx_fmt(b,sizeof b,"%ld",amount))die("part range formatting");char *v[]={"whole-front","front",prepared,(char *)target,(char *)dir,a,b,"--resume",0};resume_call(front,8,v);
}
static int merge_phase(int argc,char **argv){
 int resume=argc>1&&!strcmp(argv[argc-1],"--resume"),end=argc-resume,n=end-5;if(n<1||n>WF_MAX||!*argv[3]||strlen(argv[3])>64||strpbrk(argv[3],"\t\r\n"))die("usage: merge PREPARED_DIR TARGET NEW_PHASE PART... [--resume]");
 long long start=phase_now();physical(argv[2],prepared);char phase[4400];new_name(argv[4],phase);phase_control(phase,resume);np_buf before={0},r={0},parts={0};inputs(&before);
 char dirs[WF_MAX][4400],ready_hash[WF_MAX][65];const char *list[WF_MAX];long next=0,total=0;char *order=0;
 char payload_sha[WF_MAX][3][65];const char *payload_names[]={"part.tsv","frames.bin","attrs.bin"};for(int i=0;i<n;i++)for(int j=0;j<3;j++){char p[4400];path(p,argv[5+i],payload_names[j]);digest(p,payload_sha[i][j]);}add(&parts,"root",root);add(&parts,"pkg",pkg);add(&parts,"ctor",ctor);add(&parts,"worker",worker_image);
 for(int i=0;i<n;i++){physical(argv[5+i],dirs[i]);list[i]=dirs[i];char p[4400];path(p,dirs[i],"part.tsv");size_t z;char *text=load(p,&z);if(memchr(text,0,z)||memchr(text,'\r',z))die("merge manifest text");char *at=text;long values[3];const char *keys[]={"first","count","total"};for(int j=0;j<3;j++){char *s=line(&at),*t=s?strchr(s,'\t'):0;if(!t)die("merge header");*t++=0;if(strcmp(s,keys[j]))die("merge header order");values[j]=number(t);}if(values[0]!=next||!values[1]||values[2]>WF_MAX||values[0]>values[2]||values[1]>values[2]-values[0]||(i&&values[2]!=total))die("merge partition continuity");if(!i){total=values[2];order=malloc(strlen(at)+1);if(!order)die("merge order allocation");if(tx_copy(order,(long)strlen(at)+1,at,(long)strlen(at)))die("text copy bound");}else if(strcmp(order,at))die("merge global order");next+=values[1];verified_part(argv[3],dirs[i],values[0],values[1]);free(text);if(cx_fmt(p,sizeof p,"%s.control/ready.tsv",dirs[i]))die("part ready path");digest(p,ready_hash[i]);char key[64];if(cx_fmt(key,sizeof key,"part_%d",i))die("part key");add(&parts,key,dirs[i]);if(cx_fmt(key,sizeof key,"part_ready_sha_%d",i))die("part SHA key");add(&parts,key,ready_hash[i]);}
 free(order);if(next!=total)die("incomplete merge partition");if(!resume){char why[256];tick();if(wf_merge_parts(list,n,phase,why,sizeof why))die(why);tick();}
 same_inputs(&before);for(int i=0;i<n;i++){char p[4400],h[65];if(cx_fmt(p,sizeof p,"%s.control/ready.tsv",dirs[i]))die("part ready path");digest(p,h);if(strcmp(h,ready_hash[i]))die("part ready changed");}
 for(int i=0;i<n;i++)for(int j=0;j<3;j++){char p[4400],h[65];path(p,dirs[i],payload_names[j]);digest(p,h);if(strcmp(h,payload_sha[i][j]))die("part payload changed during merge");}
 char h[65];long bytes=digest(phase,h);np_puts(&r,"whole-front-merge-v1\nstatus\tPREPARED\nscope\tdevelopment-materials-no-qualification\n");add(&r,"prepared",prepared);add(&r,"target",argv[3]);add(&r,"phase",phase);np_put(&r,before.p,before.n);addnum(&r,"parts",n);np_put(&r,parts.p,parts.n);add(&r,"phase_sha",h);addnum(&r,"phase_bytes",bytes);dir_identity(control,&r,"control_dev_ino");phase_ready(&r,resume,phase_now()-start);free(before.p);free(parts.p);free(r.p);printf("PREPARED\twhole-front\tphase=%s\tresume=%s/ready.tsv\tno-qualification\n",phase,control);return 0;
}
static void verify_merge(const char *target,const char *phase,np_buf *identity){
 char p[4400],h[65];if(cx_fmt(p,sizeof p,"%s.control/ready.tsv",phase))die("merge ready path");digest(p,h);add(identity,"merge_ready_sha",h);read_fields(p,"whole-front-merge-v1");if(strcmp(field("prepared"),prepared)||strcmp(field("target"),target)||strcmp(field("phase"),phase))die("merge provenance");int n=(int)number(field("parts"));if(n<1||n>WF_MAX)die("merge parts");char dirs[WF_MAX][4400];char *v[WF_MAX+7];v[0]="whole-front";v[1]="merge";v[2]=prepared;v[3]=(char *)target;v[4]=(char *)phase;for(int i=0;i<n;i++){char key[64];if(cx_fmt(key,sizeof key,"part_%d",i))die("merge key");canonical(field(key),dirs[i]);v[5+i]=dirs[i];}v[5+n]="--resume";v[6+n]=0;free(receipt_text);resume_call(merge_phase,6+n,v);char after[65];digest(p,after);if(strcmp(h,after))die("merge receipt changed");
}
static void stub_result(const char *dest,np_buf *r){
 char p[4400],h[65];const char *files[]={"stub.c","replay.phase","stub-path.txt"};for(int i=0;i<3;i++){path(p,dest,files[i]);long n=digest(p,h);if(n<=0)die("empty stub product");add(r,files[i],h);}
 path(p,dest,"stub-path.txt");size_t n;char *text=load(p,&n);if(!n||n>=4400||memchr(text,0,n)||memchr(text,'\n',n)||memchr(text,'\r',n))die("stub path text");char source[4400];if(mm_copy(source,sizeof source,text,(long)n))die("stub path bound");source[n]=0;free(text);if(source[0]!='/')die("absolute stub path required");char actual[65],copy[65];digest(source,actual);path(p,dest,"stub.c");digest(p,copy);if(strcmp(actual,copy))die("real stub differs from copied stub");add(r,"real_stub_sha",actual);dir_identity(dest,r,"output_dev_ino");
}
static int stub_phase(int argc,char **argv){
 if((argc!=6&&argc!=7)||(argc==7&&strcmp(argv[6],"--resume"))||!*argv[3]||strlen(argv[3])>64||strpbrk(argv[3],"\t\r\n"))die("usage: stub PREPARED_DIR TARGET PHASE NEW_OUT [--resume]");int resume=argc==7;long long start=phase_now();physical(argv[2],prepared);char phase[4400],dest[4400];physical(argv[4],phase);new_name(argv[5],dest);phase_control(dest,resume);np_buf before={0},merge_before={0},merge_after={0},r={0};inputs(&before);verify_merge(argv[3],phase,&merge_before);char h[65];digest(phase,h);add(&merge_before,"phase_sha",h);
 if(!resume){char *v[51],log[4400];int k=0;v[k++]=worker_image;v[k++]="stub";v[k++]=pkg;v[k++]=argv[3];v[k++]=phase;v[k++]=dest;for(int i=0;i<44;i++)v[k++]=root_args[i];v[k]=0;run(v,root,log);}else{char p[4400],h[65];path(p,dest,"stub.c");if(digest(p,h)<=0)die("resume without stub product identity");path(p,dest,"replay.phase");if(digest(p,h)<=0)die("resume without stub product identity");}
 same_inputs(&before);verify_merge(argv[3],phase,&merge_after);digest(phase,h);add(&merge_after,"phase_sha",h);if(merge_before.n!=merge_after.n||memcmp(merge_before.p,merge_after.p,merge_before.n))die("merge changed during stub");np_puts(&r,"whole-front-stub-v1\nstatus\tPREPARED\nscope\tdevelopment-materials-no-qualification\n");add(&r,"prepared",prepared);add(&r,"target",argv[3]);add(&r,"phase",phase);add(&r,"output",dest);np_put(&r,before.p,before.n);np_put(&r,merge_before.p,merge_before.n);stub_result(dest,&r);dir_identity(control,&r,"control_dev_ino");phase_ready(&r,resume,phase_now()-start);free(before.p);free(merge_before.p);free(merge_after.p);free(r.p);printf("PREPARED\twhole-front\tstub=%s\tresume=%s/ready.tsv\tno-qualification\n",dest,control);return 0;
}
/* Image materialization consumes the compiler's native B path, not a second emitter. */
static void image_stub(const char *target,const char *phase,const char *stub,np_buf *id){
 char p[4400],h[65],after[65];
 if(cx_fmt(p,sizeof p,"%s.control/ready.tsv",stub))die("stub ready path");digest(p,h);add(id,"prev_ready_sha",h);
 char *v[]={"whole-front","stub",prepared,(char *)target,(char *)phase,(char *)stub,"--resume",0};resume_call(stub_phase,7,v);digest(p,after);if(strcmp(h,after))die("stub receipt changed");
 path(p,stub,"stub-path.txt");size_t n;char *s=load(p,&n);char actual[4400];path(actual,tmpdir,"unisacc-forward-entry.c");if(n!=strlen(actual)||memcmp(s,actual,n))die("dv_fwd_file path differs from prepared TMPDIR");free(s);
 char a[65],b[65];digest(actual,a);path(p,stub,"stub.c");digest(p,b);if(strcmp(a,b))die("dv_fwd_file bytes differ from stub.c");add(id,"real_stub_sha",a);add(id,"real_stub_path",actual);digest(phase,h);add(id,"phase_sha",h);dir_identity(stub,id,"stub_dev_ino");
}
static void image_file(const char *dir,const char *name,np_buf *r){char p[4400],h[65],key[128];path(p,dir,name);long n=digest(p,h);if(cx_fmt(key,sizeof key,"%s_sha",name))die("image key bound");add(r,key,h);if(cx_fmt(key,sizeof key,"%s_bytes",name))die("image key bound");addnum(r,key,n);}
/* The decimal marker is written only after a successful constructor run. */
static void image_artifacts(const char *dest,const char *slice,np_buf *r){
 char p[4400];size_t n;path(p,dest,"construct_ns");char *s=load(p,&n);if(n<2||n>12||s[n-1]!='\n')die("construct timing wire");long long ns=0;for(size_t i=0;i<n-1;i++){if(s[i]<'0'||s[i]>'9')die("construct timing decimal");ns=ns*10+s[i]-'0';if(ns>45000000000LL)die("construct deadline (45 seconds)");}free(s);
 size_t ni,np,nz;path(p,dest,"image");char *ib=load(p,&ni),*pb=load(pkg,&np);path(p,dest,slice);char *sb=load(p,&nz);if(ni>536870912-np||nz!=ni+np||memcmp(sb,ib,ni)||memcmp(sb+ni,pb,np))die("slice differs from image plus complete PKG");free(ib);free(pb);free(sb);
 image_file(dest,"INPUT",r);image_file(dest,"image",r);image_file(dest,slice,r);image_file(dest,"stdout",r);image_file(dest,"stderr",r);image_file(dest,"construct_ns",r);
 const char *files[]={"INPUT","image",slice,"stdout","stderr","construct_ns"};for(int i=0;i<6;i++){struct stat st;char key[160],value[256];path(p,dest,files[i]);if(lstat(p,&st)||!S_ISREG(st.st_mode))die("image checkpoint stat");if(cx_fmt(key,sizeof key,"%s_stat",files[i])||cx_fmt(value,sizeof value,"%lu:%lu:%ld:%ld:%ld",(unsigned long)st.st_dev,(unsigned long)st.st_ino,(long)st.st_size,(long)st.st_mtime,(long)(st.st_mode&0777)))die("image checkpoint stat bound");add(r,key,value);}
}
/* Recovery records present artifacts, never a historical child return status. */
static void image_pin(const char *dest,const char *slice){const char *files[]={"INPUT","image",slice,"stdout","stderr","construct_ns"};for(int i=0;i<6;i++){char p[4400];struct stat st;path(p,dest,files[i]);if(lstat(p,&st)||!S_ISREG(st.st_mode)||chmod(p,0444))die("read-only image checkpoint");}}
static void image_checkpoint(np_buf *manifest,np_buf *artifacts,int recovery){
 np_buf b={0};np_puts(&b,"whole-front-image-checkpoint-v1\n");np_put(&b,manifest->p,manifest->n);np_put(&b,artifacts->p,artifacts->n);char p[4400];path(p,control,"built.tsv");struct stat st;
 if(!lstat(p,&st)){size_t n;char *s=load(p,&n);const char *a="status\tBUILT_UNVERIFIED\n",*c="status\tRECOVERED_BUILT_UNVERIFIED\n";size_t tail=n>=b.n?n-b.n:0;if(n<b.n||memcmp(s,b.p,b.n)||!((tail==strlen(a)&&!memcmp(s+b.n,a,tail))||(tail==strlen(c)&&!memcmp(s+b.n,c,tail))))die("build checkpoint changed; reconstruct required");free(s);}
 else{if(errno!=ENOENT)die("build checkpoint access");np_puts(&b,recovery?"status\tRECOVERED_BUILT_UNVERIFIED\n":"status\tBUILT_UNVERIFIED\n");char evidence[4400];if(tx_copy(evidence,sizeof evidence,out,(long)strlen(out)))die("text copy bound");if(tx_copy(out,sizeof out,control,(long)strlen(control)))die("text copy bound");save("built.tsv",b.p,b.n);if(chmod(p,0444))die("read-only build receipt");if(tx_copy(out,sizeof out,evidence,(long)strlen(evidence)))die("text copy bound");if(recovery)printf("RECOVERED_BUILT_UNVERIFIED\tcheckpoint=current-recovery-time\tno-historical-output-SHA-or-child-rc-claim\n");}free(b.p);
