/* Development materials, never qualification.
 * prepare ROOT PKG CTOR OBJECTS NEW_OUT [--template ABS_TEMPLATE]
 * front PREPARED_DIR TARGET NEW_PART FIRST COUNT [--resume]
 * merge PREPARED_DIR TARGET NEW_PHASE PART... [--resume]
 * stub PREPARED_DIR TARGET PHASE NEW_OUT [--resume]
 * image-build PREPARED_DIR TARGET PHASE STUB_DIR NEW_OUT [--resume]
 * image-verify PREPARED_DIR TARGET PHASE STUB_DIR OUT [--resume]
 * span PREPARED_DIR TARGET INPUT NEW_OUT FIRST LAST ROOT... [--forward-stub STUB] [--resume]
 * B uses units..e3 then prune..elf, with the same real STUB on every call.
 * Each invocation shares one 45-second deadline, including worker and hashing.
 * Failed directories are retained. Image build is BUILT_UNVERIFIED; verify
 * accepts complete constructor artifacts, including interrupted old image runs.
 */
#pragma unisa use sys.fs
#pragma unisa use sys.time
#pragma unisa use sys.sha
#pragma unisa use text.text
#pragma unisa use mem.bytes
/* Text copies retain the complete span and NUL; byte copies check capacity. */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.wholefrontmerge
#define WF_MAX 128
static long began;
static char root[4400],pkg[4400],ctor[4400],objects[4400],out[4400],tmpl[4400],helper[4400];
static char names[WF_MAX][256],hashes[WF_MAX][65];
static long sizes[WF_MAX];
static int count,serial;
/* Process-local facts only: each image pre/post traversal owns a fresh epoch.
 * No ready result is memoized, and every ready schema is rebuilt as before.
 * Standalone front/merge/stub remain uncached. Nested --resume calls cannot
 * run workers; they inherit this epoch, restored path state and one deadline.
 * Constructor boundaries invalidate both facts and the complete inputs buffer. */
#define WF_DIGEST_MAX 2048
static struct {size_t path_at;char sha[65];long bytes;} epoch_digests[WF_DIGEST_MAX];
static int epoch_active,epoch_count,resume_depth;
static np_buf epoch_inputs;
static np_buf epoch_paths;
static char epoch_prepared[4400];
static void epoch_clear(void){epoch_count=0;free(epoch_inputs.p);memset(&epoch_inputs,0,sizeof epoch_inputs);free(epoch_paths.p);memset(&epoch_paths,0,sizeof epoch_paths);epoch_prepared[0]=0;}
static void die(const char *s){fprintf(stderr,"whole-front: REFUSE %s\n",s);exit(2);}
static void tick(void){if(sy_now_ms()-began>=45000)die("phase deadline (45 seconds)");}
static void path(char *p,const char *a,const char *b){if(cx_fmt(p,4400,"%s/%s",a,b))die("path bound");}
static void physical(const char *s,char *p){if(!s||sy_realpath(s,p,4400)<0||strpbrk(p,"\t\r\n"))die("physical path");}
static int hex(const char *s){if(strlen(s)!=64)return 0;for(int i=0;i<64;i++)if(!strchr("0123456789abcdef",s[i]))return 0;return 1;}
static char *load(const char *p,size_t *n){tick();struct stat st;if(lstat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>536870912)die("bounded regular input");char *b=cx_read(p,n);if(!b||*n!=(size_t)st.st_size)die("input extent");tick();return b;}
static long digest(const char *p,char h[65]){
 char actual[4400];if(epoch_active){struct stat st;if(lstat(p,&st)||!S_ISREG(st.st_mode))die("bounded regular input");physical(p,actual);tick();for(int i=0;i<epoch_count;i++)if(!strcmp(actual,epoch_paths.p+epoch_digests[i].path_at)){if(tx_copy(h,65,epoch_digests[i].sha,(long)strlen(epoch_digests[i].sha)))die("text copy bound");return epoch_digests[i].bytes;}if(epoch_count==WF_DIGEST_MAX)die("digest epoch bound");}
 size_t n;char *b=load(p,&n);if(sy_sha256_hex(b,(long)n,h))cx_sha256_hex(b,n,h);free(b);tick();
 if(epoch_active){epoch_digests[epoch_count].path_at=epoch_paths.n;np_put(&epoch_paths,actual,strlen(actual)+1);if(tx_copy(epoch_digests[epoch_count].sha,sizeof epoch_digests[epoch_count].sha,h,(long)strlen(h)))die("text copy bound");epoch_digests[epoch_count++].bytes=(long)n;}return (long)n;
}
static void save(const char *name,const char *s,size_t n){tick();char p[4400];path(p,out,name);int fd=open(p,O_WRONLY|O_CREAT|O_EXCL,0600);if(fd<0)die("exclusive output");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("write output");at+=(size_t)z;tick();}if(close(fd))die("close output");}
static char *line(char **at){char *s=*at;if(!*s)return 0;char *e=strchr(s,'\n');if(!e)die("receipt final LF");*e=0;*at=e+1;return s;}
static long number(const char *s){long n=0;if(!*s)die("empty bytes");for(;*s;s++){if(*s<'0'||*s>'9'||n>53687091)die("bytes range");n=n*10+*s-'0';}if(n>536870912)die("bytes range");return n;}
static int find(const char *s){for(int i=0;i<count;i++)if(!strcmp(names[i],s))return i;return -1;}
static void enumerate(void){DIR *d=opendir(objects);if(!d)die("object directory");struct dirent *e;int seen=0;while((e=readdir(d))){size_t n=strlen(e->d_name);if(n>=2&&!strcmp(e->d_name+n-2,".o")){if(find(e->d_name)<0)die("unregistered object");seen++;}}if(closedir(d)||seen!=count)die("missing object");}
static void check_objects(void){char p[4400],h[65];enumerate();for(int i=0;i<count;i++){path(p,objects,names[i]);if(digest(p,h)!=sizes[i]||strcmp(h,hashes[i]))die("object hash/bytes mismatch");}}
/* Direct process groups and a monotonic deadline bound even continuously noisy children. */
static long run(char **v,const char *cwd,char *stdout_path){tick();char a[64],b[64],ep[4400];if(cx_fmt(a,sizeof a,"child-%d.stdout",serial)||cx_fmt(b,sizeof b,"child-%d.stderr",serial++))die("log name");path(stdout_path,out,a);path(ep,out,b);int fo=open(stdout_path,O_WRONLY|O_CREAT|O_EXCL,0600),fe=open(ep,O_WRONLY|O_CREAT|O_EXCL,0600);if(fo<0||fe<0)die("exclusive child logs");long start=sy_now_ms(),end=began+45000;pid_t pid=fork();if(pid<0)die("fork");if(!pid){if(setpgid(0,0)||chdir(cwd)||dup2(fo,1)<0||dup2(fe,2)<0)_exit(126);close(fo);close(fe);execv(v[0],v);_exit(127);}close(fo);close(fe);setpgid(pid,pid);int st=0;for(;;){pid_t z=waitpid(pid,&st,WNOHANG);if(z==pid)break;if(z<0&&errno!=EINTR){kill(-pid,SIGKILL);die("wait child");}if(sy_now_ms()>=end){kill(-pid,SIGKILL);kill(pid,SIGKILL);while(waitpid(pid,&st,0)<0&&errno==EINTR){}die("child/prepare deadline");}usleep(1000);}/* No descendants may escape a completed command. */
 kill(-pid,SIGKILL);tick();if(!WIFEXITED(st)||WEXITSTATUS(st))die("child failed (see exclusive logs)");return sy_now_ms()-start;}
static void sid(char h[65]){char log[4400];char *v[]={helper,root,0};run(v,root,log);size_t n;char *s=load(log,&n);if(n!=65||s[64]!='\n')die("native Fv2 identity wire");memcpy(h,s,64);h[64]=0;free(s);if(!hex(h))die("native Fv2 identity hex");}
static void whitespace(char **at){char *p=*at;for(;;){while(*p==' '||*p=='\t'||*p=='\r'||*p=='\n')p++;if(p[0]=='/'&&p[1]=='*'){char *q=strstr(p+2,"*/");if(!q)die("root array comment");p=q+2;}else break;}*at=p;}
static void roots(void) {
    char p[4400]; path(p,root,"tools/release-build.cx");
    size_t n; char *s=load(p,&n); if(memchr(s,0,n))die("root source NUL");
    const char *anchor="static const char *rb_whole_src[RB_WHOLE_SRC] = {";
    char *a=strstr(s,anchor); if(!a||strstr(a+strlen(anchor),anchor))die("unknown root array declaration");
    a+=strlen(anchor); np_buf b={0}; int nr=0;
    for(;;) {
        whitespace(&a); if(*a!='\"')die("root array string expected");
        char *start=++a;
        while(*a&&*a!='\"') { if(!strchr("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_./-",*a))die("unknown root array string syntax"); a++; }
        if(*a!='\"'||a-start<5||strncmp(start,"src/",4))die("root path");
        size_t z=(size_t)(a-start); char rel[4400],absolute[4400];
        if(z>=sizeof rel)die("root bound"); if(mm_copy(rel,sizeof rel,start,(long)z))die("root bound"); rel[z]=0;
        if(strstr(rel,"..")||strstr(rel,"//"))die("unsafe root");
        path(absolute,root,rel); np_puts(&b,absolute); np_puts(&b,"\n"); nr++; a++;
        whitespace(&a);
        if(*a==',') { a++; whitespace(&a); if(*a!='}')continue; }
        if(*a!='}'||a[1]!=';')die("unknown root array syntax"); break;
    }
    if(nr!=44)die("root array must contain 44 roots");
    save("roots.txt",b.p,b.n); free(b.p); free(s);
}
/* Receipt readers reject duplicate and unknown keys, including object entries. */
typedef struct {char *key,*value;} wf_field;
static wf_field fields[WF_MAX*2+64];
static int nf;
static char *receipt_text;
static void read_fields(const char *file,const char *magic){
 size_t n;receipt_text=load(file,&n);if(memchr(receipt_text,0,n)||memchr(receipt_text,'\r',n))die("receipt text");
 char *at=receipt_text,*s=line(&at);if(!s||strcmp(s,magic))die("receipt version");nf=0;
 while((s=line(&at))){char *t=strchr(s,'\t');if(!t||t==s||!t[1]||nf==WF_MAX*2+64)die("receipt field");*t++=0;for(int i=0;i<nf;i++)if(!strcmp(fields[i].key,s))die("duplicate receipt key");fields[nf].key=s;fields[nf++].value=t;}
}
static char *field(const char *key){for(int i=0;i<nf;i++)if(!strcmp(fields[i].key,key))return fields[i].value;die("missing receipt key");return 0;}
static void add(np_buf *b,const char *key,const char *value){np_puts(b,key);np_puts(b,"\t");np_puts(b,value);np_puts(b,"\n");}
static void addnum(np_buf *b,const char *key,long value){np_puts(b,key);np_puts(b,"\t");np_putll(b,value);np_puts(b,"\n");}
static void canonical(const char *s,char *dest){char p[4400];physical(s,p);if(strcmp(s,p))die("noncanonical receipt path");if(tx_copy(dest,4400,p,(long)strlen(p)))die("text copy bound");}
static void object_fields(void){
 count=0;
 for(int i=0;i<nf;i++){char *s=fields[i].key;size_t z=strlen(s);if(z<2||strcmp(s+z-2,".o"))continue;
 if(count==WF_MAX||z>=256)die("object bound");for(size_t j=0;j<z;j++)if(!strchr("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-",s[j]))die("unsafe object");
 char *v=fields[i].value,*t=strchr(v,'\t');if(!t||strncmp(v,"sha=",4)||strncmp(t+1,"bytes=",6)||strchr(t+1,'\t'))die("object receipt fields");*t=0;if(!hex(v+4))die("object SHA");if(tx_copy(names[count],sizeof names[count],s,(long)strlen(s)))die("text copy bound");if(tx_copy(hashes[count],sizeof hashes[count],v+4,(long)strlen(v+4)))die("text copy bound");sizes[count++]=number(t+7);
 }
 if(!count||find("drive.o")<0||find("worker.o")>=0)die("incomplete objects");
}
static void match_hash(const char *file,const char *expected,np_buf *b,const char *key){char h[65];digest(file,h);if(!hex(expected)||strcmp(h,expected))die("prepared input SHA mismatch");add(b,key,h);}
static void dir_identity(const char *file,np_buf *b,const char *key){struct stat st;if(lstat(file,&st)||!S_ISDIR(st.st_mode))die("directory identity");char v[128];if(cx_fmt(v,sizeof v,"%lu:%lu",(unsigned long)st.st_dev,(unsigned long)st.st_ino))die("directory identity bound");add(b,key,v);}
static char prepared[4400],part[4400],control[4400],worker_image[4400],tmpdir[4400];
static char root_args[44][4400];
static void inputs(np_buf *b){
 if(epoch_active&&epoch_inputs.p){if(strcmp(prepared,epoch_prepared))die("epoch prepared identity");np_put(b,epoch_inputs.p,epoch_inputs.n);tick();return;}
 char p[4400],h[65];path(p,prepared,"receipt.txt");digest(p,h);add(b,"prepare_receipt_sha",h);read_fields(p,"whole-front-prepare-v1");
 const char *known[]={"status","scope","root","pkg","ctor","helper","template","objects","source_sid","pkg_sha","ctor_sha","helper_sha","template_sha","object_receipt_sha","worker_object_sha","worker_sha","roots_sha","compile_ms","link_ms","worker_object_bytes","worker_bytes","elapsed_ms"};
 for(int i=0;i<nf;i++){size_t z=strlen(fields[i].key);int ok=z>2&&!strcmp(fields[i].key+z-2,".o");for(int j=0;j<22;j++)if(!strcmp(fields[i].key,known[j]))ok=1;if(!ok)die("unknown prepare key");}
 for(int i=0;i<22;i++)field(known[i]);
 if(strcmp(field("status"),"PREPARED")||strcmp(field("scope"),"development-materials-no-qualification"))die("prepare status/scope");
 canonical(field("root"),root);canonical(field("pkg"),pkg);canonical(field("ctor"),ctor);canonical(field("helper"),helper);canonical(field("template"),tmpl);canonical(field("objects"),objects);
 if(access(ctor,X_OK)||access(helper,X_OK))die("prepared executable");object_fields();check_objects();
 match_hash(pkg,field("pkg_sha"),b,"pkg_sha");match_hash(ctor,field("ctor_sha"),b,"ctor_sha");match_hash(helper,field("helper_sha"),b,"helper_sha");match_hash(tmpl,field("template_sha"),b,"template_sha");
 path(p,objects,"receipt.txt");match_hash(p,field("object_receipt_sha"),b,"object_receipt_sha");path(p,prepared,"worker.cx");match_hash(p,field("template_sha"),b,"worker_source_sha");
 path(p,prepared,"worker.o");if(digest(p,h)!=number(field("worker_object_bytes")))die("worker object bytes");match_hash(p,field("worker_object_sha"),b,"worker_object_sha");
 path(worker_image,prepared,"worker");if(digest(worker_image,h)!=number(field("worker_bytes"))||access(worker_image,X_OK))die("worker image bytes/executable");match_hash(worker_image,field("worker_sha"),b,"worker_sha");
 path(p,prepared,"roots.txt");match_hash(p,field("roots_sha"),b,"roots_sha");size_t n;char *text=load(p,&n);if(memchr(text,0,n)||memchr(text,'\r',n))die("roots text");char *at=text,*s;int nr=0;
 while((s=line(&at))){
     if(nr==44||s[0]!='/'||strpbrk(s,"\t\r\n")||strlen(s)>=4400)die("absolute roots required");
     char resolved[4400]; physical(s,resolved); size_t rz=strlen(root);
     if(strncmp(s,root,rz)||strncmp(s+rz,"/src/",5)||strncmp(resolved,root,rz)||resolved[rz]!='/')die("root outside source tree");
     for(int j=0;j<nr;j++)if(!strcmp(root_args[j],s))die("duplicate root");
     if(tx_copy(root_args[nr++],sizeof root_args[nr++],s,(long)strlen(s)))die("text copy bound");
 }
 free(text);if(nr!=44)die("44 roots required");
 char source_expected[65],helper_expected[65];if(!hex(field("source_sid"))||!hex(field("helper_sha")))die("source/helper SHA");if(tx_copy(source_expected,sizeof source_expected,field("source_sid"),(long)strlen(field("source_sid"))))die("text copy bound");if(tx_copy(helper_expected,sizeof helper_expected,field("helper_sha"),(long)strlen(field("helper_sha"))))die("text copy bound");
 free(receipt_text);path(tmpdir,prepared,"tmp");char tp[4400];physical(tmpdir,tp);if(strcmp(tmpdir,tp))die("TMPDIR canonical identity");dir_identity(tmpdir,b,"tmp_dev_ino");
 path(p,prepared,"tmp.identity");digest(p,h);add(b,"tmp_receipt_sha",h);read_fields(p,"whole-front-tmp-v1");if(nf!=5||strcmp(field("status"),"PREPARED")||strcmp(field("scope"),"prepare-only")||strcmp(field("path"),tmpdir))die("TMPDIR receipt");struct stat st;if(lstat(tmpdir,&st))die("TMPDIR stat");char dev[64],ino[64];if(cx_fmt(dev,sizeof dev,"%lu",(unsigned long)st.st_dev)||cx_fmt(ino,sizeof ino,"%lu",(unsigned long)st.st_ino)||strcmp(dev,field("dev"))||strcmp(ino,field("ino")))die("TMPDIR changed");free(receipt_text);
 dir_identity(prepared,b,"prepared_dev_ino");dir_identity(root,b,"root_dev_ino");dir_identity(objects,b,"objects_dev_ino");
 if(setenv("TMPDIR",tmpdir,1))die("front TMPDIR environment");
 sid(h);if(strcmp(h,source_expected))die("source identity mismatch");add(b,"source_sid",h);match_hash(helper,helper_expected,b,"helper_after_sha");
 if(epoch_active){if(tx_copy(epoch_prepared,sizeof epoch_prepared,prepared,(long)strlen(prepared)))die("text copy bound");np_put(&epoch_inputs,b->p,b->n);}
}
static void part_result(np_buf *b,long first,long amount){
 char p[4400],h[65];path(p,part,"part.tsv");size_t n;char *text=load(p,&n);if(memchr(text,0,n)||memchr(text,'\r',n))die("part text");char *at=text,*s;const char *keys[]={"first","count","total"};long v[3];
 for(int i=0;i<3;i++){s=line(&at);char *t=s?strchr(s,'\t'):0;if(!t)die("part header");*t++=0;if(strcmp(s,keys[i]))die("part header order");v[i]=number(t);}if(v[0]!=first||v[1]!=amount||v[2]<44||v[2]>WF_MAX||first>v[2]||amount>v[2]-first)die("part range/total");
 char entries[WF_MAX][4400];int nr=0;while((s=line(&at))){char *t=strchr(s,'\t');if(!t||nr>=v[2])die("part order");*t++=0;if(number(s)!=nr||!*t||strlen(t)>=4400||strchr(t,'\t'))die("part ordered unit");for(int j=0;j<nr;j++)if(!strcmp(entries[j],t))die("part duplicate unit");if(tx_copy(entries[nr++],sizeof entries[nr++],t,(long)strlen(t)))die("text copy bound");}if(nr!=v[2])die("part missing units");
 for(int j=0;j<44;j++){int found=0;for(int i=0;i<nr;i++)if(!strcmp(root_args[j],entries[i]))found=1;if(!found)die("part missing root");}free(text);digest(p,h);add(b,"part_sha",h);addnum(b,"total",v[2]);
 path(p,part,"frames.bin");long z=digest(p,h);if(z<=0)die("empty frames");add(b,"frames_sha",h);addnum(b,"frames_bytes",z);path(p,part,"attrs.bin");z=digest(p,h);add(b,"attrs_sha",h);addnum(b,"attrs_bytes",z);dir_identity(part,b,"part_dev_ino");dir_identity(control,b,"control_dev_ino");
}
static int front(int argc,char **argv){
 if((argc!=7&&argc!=8)||(argc==8&&strcmp(argv[7],"--resume")))die("usage: front PREPARED_DIR TARGET NEW_PART FIRST COUNT [--resume]");int resume=argc==8;long first=number(argv[5]),amount=number(argv[6]);if(!amount||first>WF_MAX||amount>WF_MAX||!*argv[3]||strlen(argv[3])>64||strpbrk(argv[3],"\t\r\n"))die("front arguments");physical(argv[2],prepared);
 char parent[4400],leaf[4400],raw[4400];if(strlen(argv[4])>=sizeof raw||strpbrk(argv[4],"\t\r\n"))die("part path");if(tx_copy(raw,sizeof raw,argv[4],(long)strlen(argv[4])))die("text copy bound");char *slash=strrchr(raw,'/');if(slash){if(tx_copy(leaf,sizeof leaf,slash+1,(long)strlen(slash+1)))die("text copy bound");if(slash==raw)slash[1]=0;else *slash=0;physical(raw,parent);}else{if(tx_copy(leaf,sizeof leaf,raw,(long)strlen(raw)))die("text copy bound");physical(".",parent);}if(!*leaf||!strcmp(leaf,".")||!strcmp(leaf,".."))die("part basename");path(part,parent,leaf);if(cx_fmt(control,sizeof control,"%s.control",part))die("control bound");
 struct stat st;if(resume){if(lstat(control,&st)||!S_ISDIR(st.st_mode))die("missing ready control");}else{if(!lstat(part,&st)||errno!=ENOENT||mkdir(control,0700))die("exclusive NEW_PART/control required");}
 char evidence[4400];path(evidence,control,"check-XXXXXX");if(!mkdtemp(evidence))die("exclusive evidence directory");if(tx_copy(out,sizeof out,evidence,(long)strlen(evidence)))die("text copy bound");
 np_buf before={0},after={0},ready={0};inputs(&before);
 if(!resume){char *args[52];int k=0;args[k++]=worker_image;args[k++]="front";args[k++]=pkg;args[k++]=argv[3];args[k++]=part;args[k++]=argv[5];args[k++]=argv[6];for(int i=0;i<44;i++)args[k++]=root_args[i];args[k]=0;char log[4400];run(args,root,log);}
 inputs(&after);if(before.n!=after.n||memcmp(before.p,after.p,before.n))die("front input identity changed");
 np_puts(&ready,"whole-front-ready-v1\nstatus\tPREPARED\nscope\tdevelopment-materials-no-qualification\n");add(&ready,"prepared",prepared);add(&ready,"part",part);add(&ready,"target",argv[3]);addnum(&ready,"first",first);addnum(&ready,"count",amount);np_put(&ready,before.p,before.n);part_result(&ready,first,amount);
 if(resume){char p[4400];path(p,control,"ready.tsv");size_t n;char *old=load(p,&n);if(n!=ready.n||memcmp(old,ready.p,n))die("incomplete or changed ready part");free(old);}else{if(tx_copy(out,sizeof out,control,(long)strlen(control)))die("text copy bound");save("ready.tsv",ready.p,ready.n);}
 free(before.p);free(after.p);free(ready.p);printf("PREPARED\twhole-front\tpart=%s\tresume=%s/ready.tsv\tno-qualification\n",part,control);return 0;
}
static long long phase_now(void){sy_ts_t t;if(sy_mono(&t))die("monotonic clock");return (long long)t.sec*1000000000LL+t.nsec;}
static void new_name(const char *s,char dest[4400]){
 char raw[4400],parent[4400],leaf[4400];if(strlen(s)>=sizeof raw||strpbrk(s,"\t\r\n"))die("output path");if(tx_copy(raw,sizeof raw,s,(long)strlen(s)))die("text copy bound");char *slash=strrchr(raw,'/');if(slash){if(tx_copy(leaf,sizeof leaf,slash+1,(long)strlen(slash+1)))die("text copy bound");if(slash==raw)slash[1]=0;else *slash=0;physical(raw,parent);}else{if(tx_copy(leaf,sizeof leaf,raw,(long)strlen(raw)))die("text copy bound");physical(".",parent);}if(!*leaf||!strcmp(leaf,".")||!strcmp(leaf,".."))die("output basename");path(dest,parent,leaf);
}
static void phase_control(const char *dest,int resume){
 if(cx_fmt(control,sizeof control,"%s.control",dest))die("control bound");struct stat st;if(resume){if(lstat(control,&st)||!S_ISDIR(st.st_mode))die("missing phase control");}else if(!lstat(dest,&st)||errno!=ENOENT||mkdir(control,0700))die("exclusive phase/control required");char evidence[4400];path(evidence,control,"check-XXXXXX");if(!mkdtemp(evidence))die("exclusive phase evidence");if(tx_copy(out,sizeof out,evidence,(long)strlen(evidence)))die("text copy bound");
}
static void phase_ready(np_buf *r,int resume,long long ns){
 char p[4400];path(p,control,"ready.tsv");if(resume){size_t n;char *s=load(p,&n);const char *key="elapsed_ns\t";size_t z=strlen(key);if(n<=r->n+z+1||memcmp(s,r->p,r->n)||memcmp(s+r->n,key,z))die("changed phase ready");char *v=s+r->n+z,*e=s+n-1;if(*e!='\n'||v==e)die("phase timing");for(;v<e;v++)if(*v<'0'||*v>'9')die("phase timing");free(s);}else{np_puts(r,"elapsed_ns\t");np_putll(r,ns);np_puts(r,"\n");if(tx_copy(out,sizeof out,control,(long)strlen(control)))die("text copy bound");save("ready.tsv",r->p,r->n);}
}
static void same_inputs(np_buf *before){if(epoch_active&&!resume_depth)epoch_clear();np_buf after={0};inputs(&after);if(before->n!=after.n||memcmp(before->p,after.p,before->n))die("phase input identity changed");free(after.p);}
