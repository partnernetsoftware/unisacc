#pragma unisa module tapeslice_contract
/* Generated by tools/tapeslice-gen.cx from tools/tape/facts/tapeslice-container.tsv and hoststub-slots.tsv -- do not edit. */
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use crypto.sha256

#define TS_MAGIC "UTAPEBIN"
#define TS_MAJOR 1
#define TS_MINOR 3
#define TS_ENDIAN 1
#define TS_NSECT 6
#define TS_DIR_OFF 64
#define TS_IDENT_OFF 28
#define TS_IDENT_LEN 32
#define TS_ORIGIN_OFF 60
#define TS_HEADER_TOTAL 208
#define TS_HOST_SLOTS 37
#define TS_M1_HOST_MASK 383ull
#define TS_ROW_COUNT 34

typedef struct {
    const char *field;
    int off;
    int size;
    const char *kind;
    const char *value;
} ts_contract_row_t;

static const ts_contract_row_t ts_contract_rows[TS_ROW_COUNT] = {
    {"magic", 0, 8, "magic", "UTAPEBIN"},
    {"major", 8, 2, "u16", "1"},
    {"minor", 10, 2, "u16", "3"},
    {"endian", 12, 2, "u16", "1"},
    {"flags", 14, 2, "u16", "0"},
    {"entry_off", 16, 4, "u32", "0"},
    {"nsect", 20, 4, "u32", "6"},
    {"dir_off", 24, 4, "u32", "64"},
    {"ident", 28, 32, "sha256", "zeroed-ident-file-sha256"},
    {"origin", 60, 4, "u32", "0"},
    {"sect_code_tag", 64, 4, "tag", "CODE"},
    {"sect_code_off", 68, 8, "u64", "208"},
    {"sect_code_len", 76, 8, "u64", "0"},
    {"sect_code_cnt", 84, 4, "u32", "0"},
    {"sect_data_tag", 88, 4, "tag", "DATA"},
    {"sect_data_off", 92, 8, "u64", "208"},
    {"sect_data_len", 100, 8, "u64", "0"},
    {"sect_data_cnt", 108, 4, "u32", "0"},
    {"sect_bssz_tag", 112, 4, "tag", "BSSZ"},
    {"sect_bssz_off", 116, 8, "u64", "208"},
    {"sect_bssz_len", 124, 8, "u64", "8"},
    {"sect_bssz_cnt", 132, 4, "u32", "1"},
    {"sect_syms_tag", 136, 4, "tag", "SYMS"},
    {"sect_syms_off", 140, 8, "u64", "216"},
    {"sect_syms_len", 148, 8, "u64", "0"},
    {"sect_syms_cnt", 156, 4, "u32", "0"},
    {"sect_relo_tag", 160, 4, "tag", "RELO"},
    {"sect_relo_off", 164, 8, "u64", "216"},
    {"sect_relo_len", 172, 8, "u64", "0"},
    {"sect_relo_cnt", 180, 4, "u32", "0"},
    {"sect_host_tag", 184, 4, "tag", "HOST"},
    {"sect_host_off", 188, 8, "u64", "216"},
    {"sect_host_len", 196, 8, "u64", "0"},
    {"sect_host_cnt", 204, 4, "u32", "0"}
};

static const char *ts_sect_tags[TS_NSECT] = {"CODE", "DATA", "BSSZ", "SYMS", "RELO", "HOST"};

static const char *ts_hoststub_names[TS_HOST_SLOTS] = {
    "exit", "read", "write", "mmap", "munmap", "open", "close", "mprotect",
    "fstat", "stat", "lseek", "pread", "spawn", "wait", "pipe", "dup2",
    "kill", "getpid", "clock", "sleep", "getenvblock", "selfpath", "getcwd", "rename",
    "unlink", "mkdir", "readdir", "ftruncate", "fsync", "chmod", "readlink", "dlopen",
    "dlsym", "dlcall", "sigset", "sigret", "isatty"
};

unsigned long long ts_rd_u(const unsigned char *p, int k) {
    unsigned long long v = 0;
    int i = k - 1;
    while (i >= 0) { v = (v << 8) | (unsigned long long)(p[i] & 255); i--; }
    return v;
}

void ts_wr_u(unsigned char *p, int k, unsigned long long v) {
    int i = 0;
    while (i < k) { p[i] = (unsigned char)(v & 255ull); v >>= 8; i++; }
}

int ts_contract_row_count(void) { return TS_ROW_COUNT; }

const ts_contract_row_t *ts_contract_row(int idx) {
    if (idx < 0 || idx >= TS_ROW_COUNT) return 0;
    return &ts_contract_rows[idx];
}

/* Compute sha256 over full container with header bytes 28..59 (ident) zeroed. */
void ts_compute_ident(const unsigned char *buf, long len, unsigned char out_dig[32]) {
    unsigned char *tmp;
    int i;
    for (i = 0; i < 32; i++) out_dig[i] = 0;
    if (!buf || len <= 0) return;
    tmp = (unsigned char *)mm_alloc(len);
    if (!tmp) return;
    mm_copy(tmp, len, buf, len);
    if (len >= TS_IDENT_OFF + TS_IDENT_LEN) {
        for (i = 0; i < TS_IDENT_LEN; i++) tmp[TS_IDENT_OFF + i] = 0;
    }
    cx_sha256(tmp, (size_t)len, out_dig);
    mm_free(tmp);
}

void ts_seal_ident(unsigned char *buf, long len) {
    unsigned char dig[32];
    int i;
    if (!buf || len < TS_HEADER_TOTAL) return;
    ts_compute_ident(buf, len, dig);
    for (i = 0; i < 32; i++) buf[TS_IDENT_OFF + i] = dig[i];
}

static int ts_fail(char *why, long wcap, const char *msg) {
    long i = 0;
    if (why && wcap > 0) {
        while (msg[i] && i + 1 < wcap) { why[i] = msg[i]; i++; }
        why[i] = 0;
    }
    return 1;
}

/* Validate a UTAPEBIN minor==3 tapeslice container buffer of length len. Returns 0 on success. */
int ts_validate_container(const unsigned char *b, long len, char *why, long wcap) {
    int i, j;
    unsigned long long entry_off, nsect, dir_off, origin, prev_end;
    unsigned long long code_len = 0, data_off = 0, data_len = 0;
    unsigned char dig[32];
    if (!b) return ts_fail(why, wcap, "null-buffer");
    if (len < TS_HEADER_TOTAL + 8) return ts_fail(why, wcap, "short-header");
    for (i = 0; i < 8; i++) {
        if (b[i] != (unsigned char)TS_MAGIC[i]) return ts_fail(why, wcap, "bad-magic");
    }
    if (ts_rd_u(b + 8, 2) != TS_MAJOR) return ts_fail(why, wcap, "bad-major");
    if (ts_rd_u(b + 10, 2) != TS_MINOR) return ts_fail(why, wcap, "bad-minor");
    if (ts_rd_u(b + 12, 2) != TS_ENDIAN) return ts_fail(why, wcap, "bad-endian");
    if (ts_rd_u(b + 14, 2) != 0) return ts_fail(why, wcap, "bad-flags");
    entry_off = ts_rd_u(b + 16, 4);
    nsect = ts_rd_u(b + 20, 4);
    if (nsect != TS_NSECT) return ts_fail(why, wcap, "bad-nsect");
    dir_off = ts_rd_u(b + 24, 4);
    if (dir_off != TS_DIR_OFF) return ts_fail(why, wcap, "bad-dir-off");
    origin = ts_rd_u(b + TS_ORIGIN_OFF, 4);
    if (origin > 6) return ts_fail(why, wcap, "bad-origin");
    prev_end = TS_HEADER_TOTAL;
    for (i = 0; i < TS_NSECT; i++) {
        int d = TS_DIR_OFF + 24 * i;
        const char *want_tag = ts_sect_tags[i];
        unsigned long long aligned, soff, slen, scnt;
        for (j = 0; j < 4; j++) {
            if (b[d + j] != (unsigned char)want_tag[j]) return ts_fail(why, wcap, "unknown-or-misordered-tag");
        }
        soff = ts_rd_u(b + d + 4, 8);
        slen = ts_rd_u(b + d + 12, 8);
        scnt = ts_rd_u(b + d + 20, 4);
        aligned = prev_end + ((8ull - (prev_end & 7ull)) & 7ull);
        if (soff != aligned) return ts_fail(why, wcap, "unaligned-or-gap-section-off");
        if (soff > (unsigned long long)len || slen > (unsigned long long)len - soff) return ts_fail(why, wcap, "section-out-of-bounds");
        while (prev_end < soff) {
            if (b[prev_end] != 0) return ts_fail(why, wcap, "nonzero-padding");
            prev_end++;
        }
        if (i == 0) code_len = slen;
        if (i == 1) { data_off = soff; data_len = slen; }
        if (i == 2 && (slen != 8 || scnt != 1)) return ts_fail(why, wcap, "bad-bssz-shape");
        if (i == 3) {
            unsigned long long r;
            if ((slen & 15ull) != 0 || scnt != (slen >> 4)) return ts_fail(why, wcap, "bad-table-section-shape");
            for (r = 0; r < scnt; r++) {
                const unsigned char *row = b + soff + (r << 4);
                unsigned long long noff = ts_rd_u(row, 4);
                unsigned int ssect = (unsigned int)row[4];
                unsigned int skind = (unsigned int)row[5];
                unsigned long long srsv = ts_rd_u(row + 6, 2);
                unsigned long long k;
                int nul_ok = 0;
                if (ssect > 3 || skind > 3 || srsv != 0) return ts_fail(why, wcap, "bad-syms-record");
                if (noff >= data_len || b[data_off + noff] == 0) return ts_fail(why, wcap, "bad-syms-record");
                for (k = noff; k < data_len; k++) {
                    if (b[data_off + k] == 0) { nul_ok = 1; break; }
                }
                if (!nul_ok) return ts_fail(why, wcap, "bad-syms-record");
            }
        }
        if (i == 4) {
            unsigned long long r;
            if ((slen & 15ull) != 0 || scnt != (slen >> 4)) return ts_fail(why, wcap, "bad-table-section-shape");
            for (r = 0; r < scnt; r++) {
                const unsigned char *row = b + soff + (r << 4);
                unsigned long long rpos = ts_rd_u(row, 8);
                unsigned int rkind = (unsigned int)row[8];
                unsigned int rwidth = (unsigned int)row[9];
                unsigned long long rrsv = ts_rd_u(row + 10, 2);
                if (rkind > 3 || rwidth < 1 || rwidth > 10 || rrsv != 0) return ts_fail(why, wcap, "bad-relo-record");
                if (rpos == 0 || rpos >= code_len || (unsigned long long)rwidth > code_len - rpos) return ts_fail(why, wcap, "bad-relo-record");
            }
        }
        if (i == 5) {
            unsigned char seen[TS_HOST_SLOTS];
            unsigned long long hpos = 0, r;
            for (j = 0; j < TS_HOST_SLOTS; j++) seen[j] = 0;
            for (r = 0; r < scnt; r++) {
                unsigned long long slot, nlen, wlen = 0, k;
                const char *want;
                if (slen - hpos < 4) return ts_fail(why, wcap, "bad-host-record");
                slot = ts_rd_u(b + soff + hpos, 2);
                nlen = ts_rd_u(b + soff + hpos + 2, 2);
                hpos += 4;
                if (slot >= TS_HOST_SLOTS) return ts_fail(why, wcap, "unknown-host-slot");
                if (seen[slot]) return ts_fail(why, wcap, "bad-host-record");
                seen[slot] = 1;
                if (nlen > slen - hpos) return ts_fail(why, wcap, "bad-host-record");
                want = ts_hoststub_names[slot];
                while (want[wlen]) wlen++;
                if (nlen != wlen) return ts_fail(why, wcap, "bad-host-record");
                for (k = 0; k < nlen; k++) {
                    if (b[soff + hpos + k] != (unsigned char)want[k]) return ts_fail(why, wcap, "bad-host-record");
                }
                hpos += nlen;
            }
            if (hpos != slen) return ts_fail(why, wcap, "bad-host-record");
        }
        prev_end = soff + slen;
    }
    if (prev_end != (unsigned long long)len) return ts_fail(why, wcap, "truncated-or-trailing-bytes");
    if (code_len == 0 && entry_off != 0) return ts_fail(why, wcap, "bad-entry-off");
    if (code_len > 0 && entry_off >= code_len) return ts_fail(why, wcap, "bad-entry-off");
    ts_compute_ident(b, len, dig);
    for (i = 0; i < 32; i++) {
        if (b[TS_IDENT_OFF + i] != dig[i]) return ts_fail(why, wcap, "bad-ident");
    }
    if (why && wcap > 0) why[0] = 0;
    return 0;
}

int ts_validate_entry_ibitmap(const unsigned char *b, long len, const unsigned char *ibitmap, long ibitmap_cap, char *why, long wcap) {
    unsigned long long entry_off, code_len, byte_idx;
    if (ts_validate_container(b, len, why, wcap) != 0) return 1;
    entry_off = ts_rd_u(b + 16, 4);
    code_len = ts_rd_u(b + TS_DIR_OFF + 12, 8);
    if (code_len > 0) {
        byte_idx = entry_off >> 3;
        if (!ibitmap || ibitmap_cap <= 0 || byte_idx >= (unsigned long long)ibitmap_cap) {
            return ts_fail(why, wcap, "entry-not-on-insn-boundary");
        }
        if ((((unsigned int)ibitmap[byte_idx] >> (entry_off & 7ull)) & 1u) == 0u) {
            return ts_fail(why, wcap, "entry-not-on-insn-boundary");
        }
        {
            int rd = TS_DIR_OFF + 24 * 4;
            unsigned long long rsoff = ts_rd_u(b + rd + 4, 8);
            unsigned long long rscnt = ts_rd_u(b + rd + 20, 4);
            unsigned long long rr;
            for (rr = 0; rr < rscnt; rr++) {
                const unsigned char *row = b + rsoff + (rr << 4);
                unsigned long long rpos = ts_rd_u(row, 8);
                unsigned int rwidth = (unsigned int)row[9], k;
                for (k = 0; k < rwidth; k++) {
                    unsigned long long p = rpos + (unsigned long long)k;
                    unsigned long long pb = p >> 3;
                    if (pb >= (unsigned long long)ibitmap_cap || (((unsigned int)ibitmap[pb] >> (p & 7ull)) & 1u) != 0u) {
                        return ts_fail(why, wcap, "relo-crosses-insn-boundary");
                    }
                }
            }
        }
    }
    if (why && wcap > 0) why[0] = 0;
    return 0;
}

/* Overflow-safe subtraction check for 8-byte aligned DATA + BSS inside memlimit. */
int ts_check_linear_bounds(unsigned long long data_len, unsigned long long bss_size,
                           unsigned long long memlimit, unsigned long long *out_data_aligned,
                           char *why, long wcap) {
    unsigned long long aligned;
    if (data_len > 0xffffffffffffffffull - 7ull) return ts_fail(why, wcap, "data-align-overflow");
    aligned = (data_len + 7ull) & ~7ull;
    if (bss_size > memlimit || aligned > memlimit - bss_size) {
        return ts_fail(why, wcap, "linear-mem-oob");
    }
    if (out_data_aligned) *out_data_aligned = aligned;
    if (why && wcap > 0) why[0] = 0;
    return 0;
}

/* Strictly verify hoststub-slots.tsv slot/op columns against generated ts_hoststub_names[0..36]. */
int ts_validate_host_table(const char *tsv_buf, long tsv_len, char *why, long wcap) {
    unsigned char seen[TS_HOST_SLOTS];
    long pos = 0;
    int saw_hdr = 0, row_idx = 0, i;
    if (!tsv_buf || tsv_len <= 0) return ts_fail(why, wcap, "host-table-slot-mismatch");
    for (i = 0; i < TS_HOST_SLOTS; i++) seen[i] = 0;
    while (pos < tsv_len) {
        long e = pos, t0 = -1, t1 = -1, k;
        while (e < tsv_len && tsv_buf[e] != '\n') e++;
        if (e == pos) return ts_fail(why, wcap, "host-table-slot-mismatch");
        if (tsv_buf[pos] == '#') {
            pos = (e < tsv_len) ? (e + 1) : e;
            continue;
        }
        if (!saw_hdr) {
            if (e - pos < 8 || !tx_prefix(tsv_buf + pos, e - pos, "slot\top\t", 8)) {
                return ts_fail(why, wcap, "host-table-slot-mismatch");
            }
            saw_hdr = 1;
        } else {
            long slot = 0, op_len, wlen = 0;
            const char *want;
            for (k = pos; k < e; k++) {
                if (tsv_buf[k] == '\t') {
                    if (t0 < 0) t0 = k;
                    else { t1 = k; break; }
                }
            }
            if (t0 <= pos) return ts_fail(why, wcap, "host-table-slot-mismatch");
            if (t1 < 0) t1 = e;
            for (k = pos; k < t0; k++) {
                if (tsv_buf[k] < '0' || tsv_buf[k] > '9') return ts_fail(why, wcap, "host-table-slot-mismatch");
                slot = slot * 10 + (long)(tsv_buf[k] - '0');
                if (slot >= TS_HOST_SLOTS) return ts_fail(why, wcap, "host-table-slot-mismatch");
            }
            if (seen[slot] || slot != (long)row_idx) return ts_fail(why, wcap, "host-table-slot-mismatch");
            seen[slot] = 1;
            row_idx++;
            op_len = t1 - (t0 + 1);
            want = ts_hoststub_names[slot];
            while (want[wlen]) wlen++;
            if (op_len != wlen) return ts_fail(why, wcap, "host-table-op-mismatch");
            for (k = 0; k < op_len; k++) {
                if (tsv_buf[t0 + 1 + k] != want[k]) return ts_fail(why, wcap, "host-table-op-mismatch");
            }
        }
        pos = (e < tsv_len) ? (e + 1) : e;
    }
    if (!saw_hdr || row_idx != TS_HOST_SLOTS) return ts_fail(why, wcap, "host-table-slot-mismatch");
    if (why && wcap > 0) why[0] = 0;
    return 0;
}

/* Verify all HOST slots referenced by container belong to M1 frozen 8-slot core (0,1,2,3,4,5,6,8). */
int ts_validate_m1_host_support(const unsigned char *b, long len, char *why, long wcap) {
    int d = TS_DIR_OFF + 24 * 5;
    unsigned long long soff, scnt, hpos = 0, r;
    if (ts_validate_container(b, len, why, wcap) != 0) return 1;
    soff = ts_rd_u(b + d + 4, 8);
    scnt = ts_rd_u(b + d + 20, 4);
    for (r = 0; r < scnt; r++) {
        unsigned long long slot = ts_rd_u(b + soff + hpos, 2);
        unsigned long long nlen = ts_rd_u(b + soff + hpos + 2, 2);
        if (slot >= 64 || ((TS_M1_HOST_MASK >> slot) & 1ull) == 0ull) {
            return ts_fail(why, wcap, "m1-unsupported-host-slot");
        }
        hpos += 4 + nlen;
    }
    if (why && wcap > 0) why[0] = 0;
    return 0;
}

/* Verify a hostcall slot invoked from CODE is valid, M1-supported (when m1_only), and declared in HOST section. */
int ts_validate_hostcall_slot(const unsigned char *b, long len, unsigned int slot, int m1_only, char *why, long wcap) {
    int d = TS_DIR_OFF + 24 * 5;
    unsigned long long soff, scnt, hpos = 0, r;
    if (ts_validate_container(b, len, why, wcap) != 0) return 1;
    if (slot >= TS_HOST_SLOTS) return ts_fail(why, wcap, "unknown-host-slot");
    if (m1_only && ((TS_M1_HOST_MASK >> slot) & 1ull) == 0ull) {
        return ts_fail(why, wcap, "m1-unsupported-host-slot");
    }
    soff = ts_rd_u(b + d + 4, 8);
    scnt = ts_rd_u(b + d + 20, 4);
    for (r = 0; r < scnt; r++) {
        unsigned long long rslot = ts_rd_u(b + soff + hpos, 2);
        unsigned long long nlen = ts_rd_u(b + soff + hpos + 2, 2);
        if (rslot == (unsigned long long)slot) {
            if (why && wcap > 0) why[0] = 0;
            return 0;
        }
        hpos += 4 + nlen;
    }
    return ts_fail(why, wcap, "undeclared-host-slot-in-code");
}
