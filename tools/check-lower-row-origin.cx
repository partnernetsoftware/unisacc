/* Independent WATCH consistency fixtures; they are not claimed executions of the fixture delta. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sysx.process
#pragma unisa use text.text
static int checks,bad;static char root[4400],dir[4400],paths[5][4400],tool[4400],com[4400];static char sh[65],dh[65],gh[65],oh[65],ch[65];
static const char *src="a:\n.bss z 8\n  x\n",*code="a:\n  x\n",*delta="{\"fixture\":\"WATCH consistency only, not execution attestation\"}\n",*cfg="LINE\tline\nLAY\tcode\nC.init\tcode,nc\nC.label\tnc,tok\nC.next\tnc,na\n";
static void ck(int yes,const char *s){checks++;printf("%s\t%s\n",yes?"PASS":"FAIL",s);if(!yes)bad++;}
static void row(FILE *f,int id,const char *state,int fi,const char *hash,long cur,long end,long len,const char *extra){fprintf(f,"WATCH\t%d\tstate_hex=%s\tframe_instance=%d\tframe_sha=%s\tcursor=%ld\tframe_end=%ld\toutput_generation=0\toutput_len=%ld\t%s\n",id,state,fi,hash,cur,end,len,extra);}
static void fixture(int mode){FILE *f=fopen(paths[3],"wb");if(!f)exit(2);fprintf(f,"WRITE_EVENTS\tversion=1\tdelta_sha=%s\tinput_sha=%s\tconfig_sha=%s\toutput_sha=%s\toutput_bytes=1\n",mode==1?oh:dh,sh,gh,oh);row(f,1,"4c494e45",1,sh,0,16,0,"value:line=0");row(f,mode==2?1:2,"4c494e45",1,sh,3,16,mode==3?2:3,"value:line=0");row(f,3,"4c494e45",1,sh,12,16,3,"value:line=3");row(f,4,"4c494e45",1,sh,16,16,7,"value:line=12");row(f,5,"4c4159",1,sh,16,16,7,"value:code=0");row(f,6,"432e696e6974",2,mode==4?sh:ch,0,7,1,"value:code=99\tvalue:nc=0");row(f,7,"432e6c6162656c",2,ch,2,7,1,"value:nc=0\tvalue:tok=99999");row(f,8,"432e6e657874",2,ch,mode==5?1:2,7,1,"value:nc=0\tvalue:na=0");row(f,9,"432e6e657874",2,ch,6,7,1,mode==6?"value:nc=0\tvalue:na=1":"value:nc=1\tvalue:na=1");if(mode!=7)fprintf(f,"COMPLETE\tevents=%d\n",mode==8?8:9);if(fclose(f))exit(2);}
static char *run(int expected){char *v[]={"sh",com,tool,"--",paths[0],paths[1],paths[2],paths[3],paths[4],0};np_result r={0};char why[512]={0};int e=np_run(v,root,0,8,&r,why,sizeof why);char *s=0;if(!e&&!r.residue&&r.rc==expected){s=malloc(r.outn+1);if(!s)exit(2);memcpy(s,r.out,r.outn);s[r.outn]=0;}else fprintf(stderr,"transport=%d rc=%d expected=%d %s\n%s\n",e,r.rc,expected,why,r.err?r.err:"");np_free(&r);return s;}
static void compact_fixture(int mode) {
    FILE *f = fopen(paths[3], "wb");
    if (!f) exit(2);
    fprintf(f, "WRITE_EVENTS\tversion=1\tdelta_sha=%s\tinput_sha=%s\tconfig_sha=%s\toutput_sha=%s\toutput_bytes=1%s\n",
            dh, sh, gh, oh, mode == 7 ? "" : "\twatch_format=compact-v1");
    fprintf(f, "FRAME\t1\t1\t%s\t16\n", sh);
    if (mode == 2) fprintf(f, "FRAME\t2\t1\t%s\t16\n", sh);
    fprintf(f, "WATCHC\t%d\t%d\t1\t0\t0\t0\t0\t0\t0%s\n",
            mode == 3 ? 3 : 2, mode == 4 ? 64 : 0, mode == 5 ? "\t99" : "");
    fputs("WATCHC\t3\t0\t1\t3\t0\t3\t0\t0\t0\n", f);
    fputs("WATCHC\t4\t0\t1\t12\t0\t3\t0\t0\t3\n", f);
    fputs("WATCHC\t5\t0\t1\t16\t0\t7\t0\t0\t12\n", f);
    fputs("WATCHC\t6\t1\t1\t16\t0\t7\t0\t0\t0\n", f);
    fprintf(f, "FRAME\t7\t2\t%s\t7\n", mode == 6 ? sh : ch);
    fprintf(f, "WATCHC\t8\t2\t%d\t0\t0\t1\t0\t0\t%s\n",
            mode == 1 ? 3 : 2, mode == 8 ? "0\t99" : "99\t0");
    fputs("WATCHC\t9\t3\t2\t2\t0\t1\t0\t0\t0\t99999\n", f);
    fputs("WATCHC\t10\t4\t2\t2\t0\t1\t0\t0\t0\t0\n", f);
    fputs("WATCHC\t11\t4\t2\t6\t0\t1\t0\t0\t1\t1\n", f);
    fputs("COMPLETE\tevents=11\n", f);
    if (fclose(f)) exit(2);
}
static void compact_checks(void) {
    fixture(0);
    char *long_view = run(0);
    compact_fixture(0);
    char *short_view = run(0);
    ck(long_view && short_view && !strcmp(long_view, short_view),
       "compact-v1 preserves complete long state/register lineage view");
    free(long_view);
    free(short_view);
    const char *names[] = {
        "", "compact undefined frame refuses", "compact duplicate frame refuses",
        "compact shared sequence order refuses", "compact invalid config slot refuses",
        "compact wrong value column count refuses", "compact code frame SHA refuses",
        "compact records require explicit format", "compact config register order preserves nc checks"
    };
    for (int i = 1; i <= 8; i++) {
        compact_fixture(i);
        char *s = run(2);
        ck(s != 0, names[i]);
        free(s);
    }
}
int main(void){char temp[]="/tmp/check-lower-row-origin-XXXXXX";if(!realpath(".",root)||!mkdtemp(temp))return 2;strcpy(dir,temp);for(int i=0;i<5;i++)if(cx_fmt(paths[i],4400,"%s/f%d",dir,i))return 2;if(cx_fmt(com,sizeof com,"%s/unisacc.com",root)||cx_fmt(tool,sizeof tool,"%s/tools/lower-row-origin.cx",root))return 2;const char *contents[]={src,delta,cfg,"","Z"};for(int i=0;i<5;i++)if(cx_write(paths[i],contents[i],strlen(contents[i])))return 2;cx_sha256_hex(src,strlen(src),sh);cx_sha256_hex(delta,strlen(delta),dh);cx_sha256_hex(cfg,strlen(cfg),gh);cx_sha256_hex("Z",1,oh);cx_sha256_hex(code,strlen(code),ch);fixture(0);char *s=run(0);ck(s&&strstr(s,"rows=2\tcode_bytes=7\tentities=2"),"independent complete data-pass and entity fixture");ck(s&&strstr(s,"code_lo=3\tcode_hi=7\tsource_lo=12\tsource_hi=16"),"deleted data row does not shift source lineage");ck(s&&strstr(s,"label=1")&&strstr(s,"object_module=UNKNOWN"),"label maps actual row independently of intern token");free(s);const char *names[]={"","wrong actual delta SHA refuses","duplicate/reversed WATCH id refuses","copy length mismatch refuses","code frame SHA mismatch refuses","incomplete C.next row refuses","duplicate entity nc refuses","missing COMPLETE refuses","wrong COMPLETE count refuses"};for(int i=1;i<=8;i++){fixture(i);s=run(2);ck(s!=0,names[i]);free(s);}compact_checks();fixture(0);if(cx_write(paths[4],"Y",1))return 2;s=run(2);ck(s!=0,"actual output SHA mismatch refuses");free(s);for(int i=0;i<5;i++)unlink(paths[i]);rmdir(dir);printf("LOWER_ROW_ORIGIN_CHECK\tchecks=%d\tfailed=%d\n",checks,bad);return bad?1:0;}
