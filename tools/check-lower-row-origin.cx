/* Independent WATCH consistency fixtures; they are not claimed executions of the fixture delta. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sysx.process
#pragma unisa use text.text
static int checks,bad;static char root[4400],dir[4400],paths[5][4400],tool[4400],com[4400];static char sh[65],dh[65],gh[65],oh[65],ch[65];
static const char *src="a:\n.bss z 8\n  x\n",*code="a:\n  x\n",*delta="{\"fixture\":\"WATCH consistency only, not execution attestation\"}\n",*cfg="LINE\tline\nLAY\tcode\nC.init\tcode,nc\nC.label\tnc,tok\nC.next\tnc,na\n";
static void ck(int yes,const char *s){checks++;printf("%s\t%s\n",yes?"PASS":"FAIL",s);if(!yes)bad++;}
static void row(FILE *f,int id,const char *state,int fi,const char *hash,long cur,long end,long len,const char *extra){fprintf(f,"WATCH\t%d\tstate_hex=%s\tframe_instance=%d\tframe_sha=%s\tcursor=%ld\tframe_end=%ld\toutput_generation=0\toutput_len=%ld\t%s\n",id,state,fi,hash,cur,end,len,extra);}
static void fixture(int mode){FILE *f=fopen(paths[3],"wb");if(!f)exit(2);fprintf(f,"WRITE_EVENTS\tversion=1\tdelta_sha=%s\tinput_sha=%s\tconfig_sha=%s\toutput_sha=%s\toutput_bytes=1\n",mode==1?oh:dh,sh,gh,oh);row(f,1,"4c494e45",1,sh,0,16,0,"value:line=0");row(f,mode==2?1:2,"4c494e45",1,sh,3,16,mode==3?2:3,"value:line=0");row(f,3,"4c494e45",1,sh,12,16,3,"value:line=3");row(f,4,"4c494e45",1,sh,16,16,7,"value:line=12");row(f,5,"4c4159",1,sh,16,16,7,"value:code=0");row(f,6,"432e696e6974",2,mode==4?sh:ch,0,7,1,"value:code=99\tvalue:nc=0");row(f,7,"432e6c6162656c",2,ch,2,7,1,"value:nc=0\tvalue:tok=99999");row(f,8,"432e6e657874",2,ch,mode==5?1:2,7,1,"value:nc=0\tvalue:na=0");row(f,9,"432e6e657874",2,ch,6,7,1,mode==6?"value:nc=0\tvalue:na=1":"value:nc=1\tvalue:na=1");if(mode!=7)fprintf(f,"COMPLETE\tevents=%d\n",mode==8?8:9);if(fclose(f))exit(2);}
static char *run(int expected){char *v[]={"sh",com,tool,"--",paths[0],paths[1],paths[2],paths[3],paths[4],0};np_result r={0};char why[512]={0};int e=np_run(v,root,0,8,&r,why,sizeof why);char *s=0;if(!e&&!r.residue&&r.rc==expected){s=malloc(r.outn+1);if(!s)exit(2);memcpy(s,r.out,r.outn);s[r.outn]=0;}else fprintf(stderr,"transport=%d rc=%d expected=%d %s\n%s\n",e,r.rc,expected,why,r.err?r.err:"");np_free(&r);return s;}
static void compact_fixture(int mode) {
    FILE *f = fopen(paths[3], "wb");
    if (!f) exit(2);
    fprintf(f, "WRITE_EVENTS\tversion=1\tdelta_sha=%s\tinput_sha=%s\tconfig_sha=%s\toutput_sha=%s\toutput_bytes=1%s\n",
            dh, sh, gh, oh, mode == 7 ? "" : "\twatch_format=compact-v1");
    fprintf(f, "FRAME\t1\t1\t%s\t16\n", sh);
    if (mode == 2) fprintf(f, "FRAME\t2\t1\t%s\t16\n", sh);
    fprintf(f, "WATCHC\t%d\t%d\t1\t0\t0\t0\t0\t0\t0%s\n",
            mode == 3 ? 3 : 2, mode == 4 ? 64 : 0, mode == 5 ? "\t99" : "");
    fputs("WATCHC\t3\t0\t1\t3\t0\t3\t0\t0\t0\n", f);
    fputs("WATCHC\t4\t0\t1\t12\t0\t3\t0\t0\t3\n", f);
    fputs("WATCHC\t5\t0\t1\t16\t0\t7\t0\t0\t12\n", f);
    fputs("WATCHC\t6\t1\t1\t16\t0\t7\t0\t0\t0\n", f);
    fprintf(f, "FRAME\t7\t2\t%s\t7\n", mode == 6 ? sh : ch);
    fprintf(f, "WATCHC\t8\t2\t%d\t0\t0\t1\t0\t0\t%s\n",
            mode == 1 ? 3 : 2, mode == 8 ? "0\t99" : "99\t0");
    fputs("WATCHC\t9\t3\t2\t2\t0\t1\t0\t0\t0\t99999\n", f);
    fputs("WATCHC\t10\t4\t2\t2\t0\t1\t0\t0\t0\t0\n", f);
    fputs("WATCHC\t11\t4\t2\t6\t0\t1\t0\t0\t1\t1\n", f);
    fputs("COMPLETE\tevents=11\n", f);
    if (fclose(f)) exit(2);
}
static void compact_checks(void) {
    fixture(0);
    char *long_view = run(0);
    compact_fixture(0);
    char *short_view = run(0);
    ck(long_view && short_view && !strcmp(long_view, short_view),
       "compact-v1 preserves complete long state/register lineage view");
    free(long_view);
    free(short_view);
    const char *names[] = {
        "", "compact undefined frame refuses", "compact duplicate frame refuses",
        "compact shared sequence order refuses", "compact invalid config slot refuses",
        "compact wrong value column count refuses", "compact code frame SHA refuses",
        "compact records require explicit format", "compact config register order preserves nc checks"
    };
    for (int i = 1; i <= 8; i++) {
        compact_fixture(i);
        char *s = run(2);
        ck(s != 0, names[i]);
        free(s);
    }
}
static char ep_rows[4400];
static void episode_fixture(int mode) {
    const char *config="GENERIC\tci,kind,op,ldp_dry\nC.advance\tci,nc,ldp_dry\nLDP.original.PF.emit\tci,nc,ldp_dry\nLDP.original.PL.emit\tci,nc,ldp_dry\n";
    const char *target="x\ny\n";
    if(cx_write(paths[2],config,strlen(config))||cx_write(paths[4],target,strlen(target)))exit(2);
    cx_sha256_hex(config,strlen(config),gh);cx_sha256_hex(target,strlen(target),oh);
    FILE *f=fopen(ep_rows,"wb");if(!f)exit(2);
    fprintf(f,"LOWER_ROW_ID\tsource_sha=%s\tdelta_sha=%s\tconfig_sha=%s\toutput_sha=%s\tcode_sha=%s\tcode_bytes=7\n",sh,dh,gh,oh,ch);
    fputs("ENTITY\t0\tcode_lo=0\tcode_hi=3\tsource_lo=0\tsource_hi=3\tlabel=1\nENTITY\t1\tcode_lo=3\tcode_hi=7\tsource_lo=12\tsource_hi=16\tlabel=0\nLOWER_ROW_ORIGIN\trows=2\tcode_bytes=7\tentities=2\n",f);
    if(fclose(f))exit(2);f=fopen(paths[3],"wb");if(!f)exit(2);
    fprintf(f,"WRITE_EVENTS\tdelta_sha=%s\tinput_sha=%s\tconfig_sha=%s\toutput_sha=%s\toutput_bytes=4\n",mode==5?oh:dh,sh,gh,oh);
    const char *state=mode==1?"4c44502e6f726967696e616c2e50462e656d6974":mode==2?"4c44502e6f726967696e616c2e504c2e656d6974":"47454e45524943";
    const char *start=mode==1||mode==2?"value:ci=0\tvalue:nc=2\tvalue:ldp_dry=0":mode==7?"value:ci=0\tvalue:kind=2\tvalue:op=123\tvalue:ldp_dry=1":"value:ci=0\tvalue:kind=2\tvalue:op=123\tvalue:ldp_dry=0";
    row(f,1,state,2,ch,0,7,0,start);
    if(mode!=6){
        const char *close=mode==1||mode==2||mode==3?"value:ci=1\tvalue:nc=2\tvalue:ldp_dry=0":mode==7?"value:ci=0\tvalue:nc=2\tvalue:ldp_dry=1":"value:ci=0\tvalue:nc=2\tvalue:ldp_dry=0";
        row(f,2,"432e616476616e6365",2,ch,2,7,mode==1||mode==2?4:mode==8?1:2,close);
    }
    if(mode==4)row(f,3,"47454e45524943",2,ch,3,7,0,"value:ci=1\tvalue:kind=2\tvalue:op=123\tvalue:ldp_dry=0");
    fprintf(f,"COMPLETE\tevents=%d\n",mode==6?1:mode==4?3:2);
    if(fclose(f))exit(2);
}
static char *episode_run(int expected) {
    char *v[]={"sh",com,tool,"--","--episodes",ep_rows,paths[1],paths[2],paths[3],paths[4],0};
    np_result r={0};char why[512]={0};int e=np_run(v,root,0,8,&r,why,sizeof why);char *s=0;
    if(!e&&!r.residue&&r.rc==expected){s=malloc(r.outn+1);if(!s)exit(2);memcpy(s,r.out,r.outn);s[r.outn]=0;}
    else fprintf(stderr,"episode transport=%d rc=%d expected=%d %s\n%s\n",e,r.rc,expected,why,r.err?r.err:"");
    np_free(&r);return s;
}
static void episode_checks(void) {
    if(cx_fmt(ep_rows,sizeof ep_rows,"%s/rows",dir))exit(2);
    episode_fixture(0);char *s=episode_run(0);
    ck(s&&strstr(s,"rule=GENERIC\ttarget_lo=0\ttarget_hi=2\tnc_lo=0\tnc_hi=1"),"GENERIC complete target line and one source entity");free(s);
    for(int i=1;i<=2;i++){
        episode_fixture(i);s=episode_run(0);
        ck(s&&strstr(s,"nc_lo=0\tnc_hi=2\tsource0_lo=0\tsource0_hi=3\tsource1_lo=12\tsource1_hi=16"),i==1?"PF preserves two disjoint source rows":"PL preserves two disjoint source rows");free(s);
    }
    const char *names[]={"","","","wrong close ci refuses","overlapping output episodes refuse","episode wrong SHA refuses","unclosed episode refuses","","partial target row refuses"};
    for(int i=3;i<=8;i++){
        episode_fixture(i);s=episode_run(i==7?0:2);
        if(i==7)ck(s&&strstr(s,"episodes=0")&&strstr(s,"dry_excluded=2"),"dry observations excluded from lineage");
        else ck(s!=0,names[i]);free(s);
    }
    unlink(ep_rows);
}
static void arm_fixture(int mode){
 const char *base="GENERIC\tci,kind,op,ldp_dry\nC.advance\tci,nc,ldp_dry\nLDP.original.PF.emit\tci,nc,ldp_dry\nLDP.original.PL.emit\tci,nc,ldp_dry\n";
 char config[512];snprintf(config,sizeof config,"%s%s%s",base,mode==6?"":"LDP.original.AF.emit\tci,nc,ldp_dry\n",mode==5?"":"LDP.original.AI.emit\tci,nc,ldp_dry\n");
 if(cx_write(paths[2],config,strlen(config))||cx_write(paths[4],"x\n",2))exit(2);
 cx_sha256_hex(config,strlen(config),gh);cx_sha256_hex("x\n",2,oh);char codehash[65];cx_sha256_hex("a\nb\nc\nd\n",8,codehash);
 FILE *f=fopen(ep_rows,"wb");if(!f)exit(2);
 fprintf(f,"LOWER_ROW_ID\tsource_sha=%s\tdelta_sha=%s\tconfig_sha=%s\toutput_sha=%s\tcode_sha=%s\tcode_bytes=8\n",sh,dh,gh,oh,codehash);
 for(int i=0;i<(mode==3?3:4);i++)fprintf(f,"ENTITY\t%d\tcode_lo=%d\tcode_hi=%d\tsource_lo=%d\tsource_hi=%d\n",i,i*2,i*2+2,i*4,i*4+2);
 fputs("LOWER_ROW_ORIGIN\trows=4\tcode_bytes=8\tentities=4\n",f);if(fclose(f))exit(2);
 f=fopen(paths[3],"wb");if(!f)exit(2);fprintf(f,"WRITE_EVENTS\tdelta_sha=%s\tinput_sha=%s\tconfig_sha=%s\toutput_sha=%s\toutput_bytes=2\n",dh,sh,gh,oh);
 char vals[128];snprintf(vals,sizeof vals,"value:ci=0\tvalue:nc=4\tvalue:ldp_dry=%d",mode==4);
 row(f,1,mode==1?"4c44502e6f726967696e616c2e41492e656d6974":"4c44502e6f726967696e616c2e41462e656d6974",2,codehash,0,8,0,vals);
 snprintf(vals,sizeof vals,"value:ci=%d\tvalue:nc=4\tvalue:ldp_dry=%d",mode==1?1:mode==2?2:3,mode==4);
 row(f,2,"432e616476616e6365",2,codehash,8,8,2,vals);fputs("COMPLETE\tevents=2\n",f);if(fclose(f))exit(2);
}
static void arm_checks(void){
 if(cx_fmt(ep_rows,sizeof ep_rows,"%s/rows",dir))exit(2);
 for(int i=0;i<7;i++){arm_fixture(i);char *out=episode_run(i==0||i==1||i==4?0:2);int ok=out!=0;
 if(i==0)ok=ok&&strstr(out,"rule=AF")&&strstr(out,"nc_lo=0\tnc_hi=4")&&strstr(out,"source1_lo=4\tsource1_hi=6")&&strstr(out,"source2_lo=8\tsource2_hi=10\tsource3_lo=12\tsource3_hi=14");
 if(i==1)ok=ok&&strstr(out,"rule=AI")&&strstr(out,"nc_lo=0\tnc_hi=2")&&!strstr(out,"source2_lo");
 if(i==4)ok=ok&&strstr(out,"episodes=0")&&strstr(out,"dry_excluded=2");
 const char *labels[]={"AF four exact source rows","AI two rows without lookahead","AF wrong close ci refuses","AF incomplete ENTITY ledger refuses","ARM dry observations excluded","AF-only profile refuses","AI-only profile refuses"};ck(ok,labels[i]);free(out);}
 unlink(ep_rows);
}
static char bundle_manifest[4400];static int bundle_job;
static int bundle_material(int episode){
 if(episode){if(cx_fmt(ep_rows,sizeof ep_rows,"%s/rows",dir))return 0;episode_fixture(0);FILE *f=fopen(paths[3],"wb");if(!f)return 0;
 fprintf(f,"WRITE_EVENTS\tversion=1\tdelta_sha=%s\tinput_sha=%s\toutput_sha=%s\toutput_bytes=4\tclaim=STATE_OBSERVATION_ONLY\tconfig_sha=%s\twatch_format=compact-v1\nFRAME\t1\t2\t%s\t7\nWATCHC\t2\t0\t2\t0\t0\t0\t0\t0\t0\t2\t123\t0\nWATCHC\t3\t1\t2\t2\t0\t2\t0\t0\t0\t2\t0\nCOMPLETE\tevents=3\n",dh,sh,oh,gh,ch);if(fclose(f))return 0;
 }else{if(cx_write(paths[2],cfg,strlen(cfg))||cx_write(paths[4],"Z",1))return 0;cx_sha256_hex(cfg,strlen(cfg),gh);cx_sha256_hex("Z",1,oh);compact_fixture(0);size_t n;char *old=cx_read(paths[3],&n),*body=old?strchr(old,'\n'):0;if(!body)return 0;FILE *f=fopen(paths[3],"wb");if(!f)return 0;fprintf(f,"WRITE_EVENTS\tversion=1\tdelta_sha=%s\tinput_sha=%s\toutput_sha=%s\toutput_bytes=1\tclaim=STATE_OBSERVATION_ONLY\tconfig_sha=%s\twatch_format=compact-v1\n",dh,sh,oh,gh);fwrite(body+1,1,n-(body+1-old),f);free(old);if(fclose(f))return 0;}
 char helper[4400],out[4400];if(cx_fmt(helper,sizeof helper,"%s/tools/check-watch-bundle.cx",root)||cx_fmt(out,sizeof out,"%s/bundle-%d",dir,++bundle_job)||cx_fmt(bundle_manifest,sizeof bundle_manifest,"%s/manifest.tsv",out))return 0;
 char *v[]={"sh",com,helper,"--","--fixture-from-watch",paths[3],out,episode?"2":"4",0};np_result r={0};char why[256]={0};int tr=np_run(v,root,0,8,&r,why,sizeof why);int ok=!tr&&!r.residue&&!r.rc;if(!ok)fprintf(stderr,"bundle prepare tr=%d rc=%d %s\n%s\n",tr,r.rc,why,r.err?r.err:"");np_free(&r);return ok;
}
static char *bundle_run(int episode,int expected){
 char *v[14];int k=0;v[k++]="sh";v[k++]=com;v[k++]=tool;v[k++]="--";v[k++]="--watch-bundle";if(episode){v[k++]="--episodes";v[k++]=ep_rows;v[k++]=paths[1];v[k++]=paths[2];v[k++]=bundle_manifest;v[k++]=paths[4];}else{for(int i=0;i<3;i++)v[k++]=paths[i];v[k++]=bundle_manifest;v[k++]=paths[4];}v[k]=0;
 np_result r={0};char why[256]={0};int tr=np_run(v,root,0,8,&r,why,sizeof why);char *out=0;if(!tr&&!r.residue&&r.rc==expected){out=malloc(r.outn+1);memcpy(out,r.out,r.outn);out[r.outn]=0;}else fprintf(stderr,"bundle consume tr=%d rc=%d expected=%d %s\n%s\n",tr,r.rc,expected,why,r.err?r.err:"");np_free(&r);return out;
}
static int damage_bundle(int missing){size_t n;char *m=cx_read(bundle_manifest,&n),*tag=m?strstr(m,"\nPART\t1\tfile="):0;if(!tag)return 0;tag+=strlen("\nPART\t1\tfile=");char *end=strchr(tag,'\t');if(!end)return 0;*end=0;char path[4400],*slash=strrchr(bundle_manifest,'/');if(!slash)return 0;long prefix=slash-bundle_manifest;if(cx_fmt(path,sizeof path,"%.*s/%s",(int)prefix,bundle_manifest,tag))return 0;int rc=missing?unlink(path):cx_write(path,"tamper\n",7);free(m);return rc==0;}
static void bundle_checks(void){
 for(int i=0;i<4;i++){
  int prepared=bundle_material(i==1);if(i>=2&&prepared)prepared=damage_bundle(i==2);
  char *out=prepared?bundle_run(i==1,i>=2?2:0):0;int ok=out!=0;
  if(i<2){char h[65],needle[100];size_t n;char *m=cx_read(bundle_manifest,&n);if(m){cx_sha256_hex(m,n,h);free(m);}else ok=0;snprintf(needle,sizeof needle,"watch_sha=%s",m?h:"");ok=ok&&strstr(out,"watch_transport=watch-bundle-v1")&&strstr(out,needle)&&strstr(out,i==1?"rule=GENERIC\ttarget_lo=0\ttarget_hi=2":"rows=2\tcode_bytes=7\tentities=2");}
  const char *labels[]={"bundle row LINE and FRAME state persist across parts with manifest SHA","bundle episode pending persists across parts with manifest SHA","bundle missing part refuses","bundle changed part actual SHA refuses"};ck(ok,labels[i]);free(out);
 }
 unlink(ep_rows);
}
int main(int argc,char **argv){int bundle_only=argc==2&&!strcmp(argv[1],"--watch-bundle");int rows_basic=argc==2&&!strcmp(argv[1],"--rows-basic"),rows_compact=argc==2&&!strcmp(argv[1],"--rows-compact");int arm_only=argc==2&&!strcmp(argv[1],"--arm-episodes"),episode_only=argc==2&&!strcmp(argv[1],"--episodes"),row_only=argc==2&&!strcmp(argv[1],"--rows");if(argc>1&&!episode_only&&!row_only&&!arm_only&&!bundle_only&&!rows_basic&&!rows_compact)return 2;char temp[]="/tmp/check-lower-row-origin-XXXXXX";if(!realpath(".",root)||!mkdtemp(temp))return 2;strcpy(dir,temp);for(int i=0;i<5;i++)if(cx_fmt(paths[i],4400,"%s/f%d",dir,i))return 2;if(cx_fmt(com,sizeof com,"%s/unisacc.com",root)||cx_fmt(tool,sizeof tool,"%s/tools/lower-row-origin.cx",root))return 2;const char *contents[]={src,delta,cfg,"","Z"};for(int i=0;i<5;i++)if(cx_write(paths[i],contents[i],strlen(contents[i])))return 2;cx_sha256_hex(src,strlen(src),sh);cx_sha256_hex(delta,strlen(delta),dh);cx_sha256_hex(cfg,strlen(cfg),gh);cx_sha256_hex("Z",1,oh);cx_sha256_hex(code,strlen(code),ch);if(bundle_only){bundle_checks();}else if(rows_compact){compact_checks();}else if(arm_only){arm_checks();}else if(!episode_only){fixture(0);char *s=run(0);ck(s&&strstr(s,"rows=2\tcode_bytes=7\tentities=2"),"independent complete data-pass and entity fixture");ck(s&&strstr(s,"code_lo=3\tcode_hi=7\tsource_lo=12\tsource_hi=16"),"deleted data row does not shift source lineage");ck(s&&strstr(s,"label=1")&&strstr(s,"object_module=UNKNOWN"),"label maps actual row independently of intern token");free(s);const char *names[]={"","wrong actual delta SHA refuses","duplicate/reversed WATCH id refuses","copy length mismatch refuses","code frame SHA mismatch refuses","incomplete C.next row refuses","duplicate entity nc refuses","missing COMPLETE refuses","wrong COMPLETE count refuses"};for(int i=1;i<=8;i++){fixture(i);s=run(2);ck(s!=0,names[i]);free(s);}if(!rows_basic)compact_checks();fixture(0);if(cx_write(paths[4],"Y",1))return 2;s=run(2);ck(s!=0,"actual output SHA mismatch refuses");free(s);}if(!row_only&&!arm_only&&!bundle_only&&!rows_basic&&!rows_compact)episode_checks();for(int i=0;i<5;i++)unlink(paths[i]);rmdir(dir);printf("LOWER_ROW_ORIGIN_CHECK\tchecks=%d\tfailed=%d\n",checks,bad);return bad?1:0;}
