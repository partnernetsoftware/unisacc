/* 私有链预检：init ROOT CHAIN_OUT NEW_OUT (--files LIST | --range A..B)
 * 后续：ROOT CHAIN_OUT NEW_OUT job JOB | routes | p3 | probe NAME |
 * slice KEY | slice-link | finish。每次仅一个有界阶段；未完成绝不 PASS。
 * --files 是仓根相对路径逐行清单；未映射输入明确拒绝。
 * ROOT 必须是与 HEAD 一致的私有链克隆；本工具不安装、不提交。
 */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use text.text
static char root[4096],chain[4096],out[4096],oldroot[4096],jobs[4400],ctor[4400],pkg[4400];
static void die(const char *s){fprintf(stderr,"CHAIN_PRECHECK\tREFUSE\t%s\trc=2\n",s);exit(2);}
static void fit(char *d,size_t c,const char *s){size_t n=strlen(s);if(n>=c)die("copy-bound");for(size_t i=0;i<=n;i++)d[i]=s[i];}
static void path(char *d,const char *a,const char *b){if(cx_fmt(d,4400,"%s/%s",a,b))die("path-bound");}
static char *load(const char *p,size_t *n){struct stat st;if(lstat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>268435456)die(p);char *s=cx_read(p,n);if(!s||*n!=(size_t)st.st_size)die("read-extent");return s;}
static void save(const char *p,const char *s,size_t n){int f=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW,0600);if(f<0)die("exclusive-output");while(n){ssize_t k=write(f,s,n);if(k<0&&errno==EINTR)continue;if(k<=0)die("write");s+=k;n-=(size_t)k;}if(close(f))die("close");}
static void copy(const char *a,const char *b,int executable){size_t n;char *s=load(a,&n);save(b,s,n);free(s);if(executable&&chmod(b,0700))die("chmod");}
static int run(char **v,const char *cwd,const char *name,char **env,int expected){np_result r;char why[1400],p[4400],status[120];path(p,out,name);if(mkdir(p,0700))die("exclusive-phase");int t=np_run(v,cwd,env,58,&r,why,sizeof why);char q[4400];path(q,p,"command.stdout");save(q,r.out?r.out:"",r.outn);path(q,p,"command.stderr");save(q,t?why:(r.err?r.err:""),t?strlen(why):r.errn);path(q,p,"command.status");int z=snprintf(status,sizeof status,"rc\t%d\ntransport\t%d\nresidue\t%d\n",t?124:r.rc,t,r.residue);if(z<0||(size_t)z>=sizeof status)die("status format bound");save(q,status,(size_t)z);int rc=t?124:r.rc;int good=!t&&!r.residue&&rc==expected;np_free(&r);printf("CHAIN_PRECHECK\t%s\t%s\trc=%d\n",name,good?"PREPARED":"FAIL",rc);return good?0:1;}
static void checked(char **v,const char *cwd,const char *name,char **env){if(run(v,cwd,name,env,0))exit(1);}
static char *capture(char **v){np_result r;char why[1400];if(np_run(v,root,0,15,&r,why,sizeof why)||r.rc||r.residue)die("git-query");char *s=malloc(r.outn+1);if(!s)die("allocation");for(size_t i=0;i<r.outn;i++)s[i]=r.out[i];s[r.outn]=0;np_free(&r);return s;}
static int zero(const char *dir){char p[4400];size_t n;path(p,dir,"command.status");char *s=load(p,&n);const char *full="rc\t0\ntransport\t0\nresidue\t0\n";int ok=(n==5&&!memcmp(s,"rc\t0\n",5))||(n==strlen(full)&&!memcmp(s,full,n));free(s);return ok;}
static int selected(const char *id){char p[4400];size_t n,k=strlen(id);path(p,out,"selected.tsv");char *s=load(p,&n);int yes=0;size_t at=0;while(at<n){size_t z=at;while(z<n&&s[z]!='\n')z++;if(z-at==k&&!memcmp(s+at,id,k)){yes=1;break;}at=z+1;}free(s);return yes;}
static int relative(const char *s){if(!*s||*s=='/'||strpbrk(s,"\\:\r\t"))return 0;const char *a=s;while(*a){const char *z=strchr(a,'/');size_t n=z?(size_t)(z-a):strlen(a);if(!n||(n==1&&*a=='.')||(n==2&&!memcmp(a,"..",2)))return 0;if(!z)return 1;a=z+1;}return 0;}
static void snapshot_parent(void){char p[4400];path(p,root,"out");struct stat st;if(!lstat(p,&st)){if(!S_ISDIR(st.st_mode))die("ROOT/out must be a directory");return;}if(errno!=ENOENT)die("ROOT/out stat failed");if(mkdir(p,0700))die("ROOT/out mkdir failed");}
static void init(int argc,char **argv){
 char p[4400],q[4400];if(argc!=7||(!tx_eqz(argv[5],"--files")&&!tx_eqz(argv[5],"--range")))die("init arguments");char *dirtyv[]={"git","status","--porcelain","--untracked-files=no",0};char *dirty=capture(dirtyv);if(*dirty)die("ROOT tracked changes: commit privately before precheck");free(dirty);
 snapshot_parent();
 char *changed;size_t cn;if(tx_eqz(argv[5],"--files"))changed=load(argv[6],&cn);else{char *v[]={"git","diff","--name-only",argv[6],"--",0};changed=capture(v);cn=strlen(changed);}if(!cn||memchr(changed,0,cn))die("empty-or-invalid-file-list");
 np_buf sel={0};DIR *d;struct dirent *e;path(p,chain,"ctx/jobs");if(!(d=opendir(p)))die("jobs directory");int count=0;
 while((e=readdir(d))){if(strncmp(e->d_name,"gen-",4))continue;path(q,p,e->d_name);if(!zero(q))die("chain gen status failed");char f[4400];path(f,q,"command.reads.tsv");size_t n;char *reads=load(f,&n);char *end=strchr(reads,'\n');if(memchr(reads,0,n)||!end||reads[0]!='/'||end==reads||(size_t)(end-reads)>=sizeof oldroot)die("reads-root");if(!oldroot[0]){size_t k=(size_t)(end-reads);for(size_t i=0;i<k;i++)oldroot[i]=reads[i];oldroot[k]=0;}else if((size_t)(end-reads)!=strlen(oldroot)||memcmp(reads,oldroot,strlen(oldroot)))die("reads-root-inconsistent");free(reads);count++;}closedir(d);if(!count)die("no-gen-jobs");
 char *at=changed;while(*at){char *z=strchr(at,'\n');if(z)*z=0;if(!relative(at))die("file-list-relative-path");int hits=0;d=opendir(p);if(!d)die("jobs directory");
  while((e=readdir(d))){if(strncmp(e->d_name,"gen-",4))continue;path(q,p,e->d_name);char f[4400],want[4400];path(f,q,"command.reads.tsv");size_t n;char *reads=load(f,&n);if(cx_fmt(want,sizeof want,"%s/%s",oldroot,at))die("mapping-bound");size_t pos=0,k=strlen(want);int hit=0;while(pos<n){size_t end=pos;while(end<n&&reads[end]!='\n')end++;if(end-pos==k&&!memcmp(reads+pos,want,k)){hit=1;break;}pos=end+1;}if(hit){np_puts(&sel,e->d_name);np_puts(&sel,"\n");hits++;}free(reads);}
  closedir(d);if(!hits)die("changed file unmapped: no silent gen omission");if(!z)break;at=z+1;
 }free(changed);if(mkdir(out,0700))die("NEW_OUT must not exist");path(q,out,"selected.tsv");save(q,sel.p,sel.n);free(sel.p);path(q,out,"source-root");save(q,oldroot,strlen(oldroot));path(q,out,"root");save(q,root,strlen(root));path(q,out,"jobs");if(mkdir(q,0700))die("mkdir jobs");printf("CHAIN_PRECHECK\tinit\tPREPARED\tall-gen=%d\trc=0\n",count);
}
static void resume(void){char p[4400];size_t n;path(p,out,"root");char *s=load(p,&n);if(n!=strlen(root)||memcmp(s,root,n))die("ROOT identity");free(s);char *v[]={"git","status","--porcelain","--untracked-files=no",0};s=capture(v);if(*s)die("ROOT tracked changes during precheck");free(s);path(p,out,"source-root");s=load(p,&n);fit(oldroot,sizeof oldroot,s);free(s);}
static void job(const char *id){if(strpbrk(id,"/\\\r\n\t"))die("job not selected");char gen[300];if(!strncmp(id,"gen-",4))fit(gen,sizeof gen,id);else if(!strncmp(id,"tbl-",4)||!strncmp(id,"net-",4)){if(cx_fmt(gen,sizeof gen,"gen-%s",id+4))die("job-id bound");}else die("job not selected");if(!selected(gen))die("job not selected");char src[4400],dst[4400],p[4400];path(p,chain,"ctx/jobs");path(src,p,id);path(dst,jobs,id);if(mkdir(dst,0700))die("job output exists");if(!strncmp(id,"tbl-",4)||!strncmp(id,"net-",4)){char dep[300];if(cx_fmt(dep,sizeof dep,"%s%s",!strncmp(id,"tbl-",4)?"gen-":"tbl-",id+4))die("dependency");path(p,jobs,dep);if(!zero(p))die("dependency status failed");}
 path(p,src,"command.argv.tsv");size_t n;char *s=load(p,&n),*a=s;char *v[64];int k=0;while(*a){char *z=strchr(a,'\n');if(z)*z=0;char *t=strchr(a,'\t');if(!t||k==63)die("argv format");t++;np_buf b={0},c={0};char oldjobs[4400];path(oldjobs,chain,"ctx/jobs");np_replace(t,strlen(t),oldjobs,strlen(oldjobs),jobs,strlen(jobs),-1,&b);np_replace(b.p,b.n,oldroot,strlen(oldroot),root,strlen(root),-1,&c);free(b.p);v[k++]=c.p;if(!z)break;a=z+1;}v[k]=0;if(k<3)die("argv count");/* tools stay the exact chain's native executable; outputs always land NEW_OUT. */
 if(strstr(v[2],"/tool-")){free(v[2]);char tool[4400];path(tool,chain,"ctx/jobs");const char *which=!strncmp(id,"gen-",4)?"tool-gen/result.exe":!strncmp(id,"tbl-",4)?"tool-tbl/result.exe":"tool-net/result.exe";path(p,tool,which);v[2]=strdup(p);}char name[350];if(cx_fmt(name,sizeof name,"run-%s",id))die("phase-name");int failed=run(v,root,name,0,0);char from[4400];path(from,out,name);const char *leaves[]={"command.status","command.stdout","command.stderr"};for(int i=0;i<3;i++){path(p,from,leaves[i]);char to[4400];path(to,dst,leaves[i]);copy(p,to,0);}for(int i=0;i<k;i++)free(v[i]);free(s);if(failed)exit(1);}
static void input_error(const char *why,const char *old,const char *now,int olderr,int nowerr){fprintf(stderr,"CHAIN_PRECHECK\tREFUSE\t%s\tbaseline=%s\tcurrent=%s\tbaseline-errno=%d\tcurrent-errno=%d\trc=2\n",why,old,now,olderr,nowerr);exit(2);}
static void compare_input(const char *old,const char *now){
 struct stat a,b;int ar=lstat(old,&a),ae=ar?errno:0;int br=lstat(now,&b),be=br?errno:0;
 /* reads includes failed existence probes: unchanged ENOENT on both sides is
  * evidence of the same negative lookup, not an absent required payload. */
 if(ar||br){if(ar&&br&&ae==ENOENT&&be==ENOENT)return;input_error("reuse-input-stat-or-existence-changed",old,now,ae,be);}
 if(S_ISDIR(a.st_mode)&&S_ISDIR(b.st_mode))return;
 if(!S_ISREG(a.st_mode)||!S_ISREG(b.st_mode))input_error("reuse-input-type",old,now,0,0);
 size_t an,bn;char *av=load(old,&an),*bv=load(now,&bn);int same=an==bn&&!memcmp(av,bv,an);free(av);free(bv);if(!same)input_error("unaffected gen input differs: file list incomplete",old,now,0,0);
}
static void unchanged_inputs(void){char base[4400],p[4400];path(base,chain,"ctx/jobs");DIR *d=opendir(base);struct dirent *e;if(!d)die("reuse inputs");while((e=readdir(d))){if(strncmp(e->d_name,"gen-",4)||selected(e->d_name))continue;path(p,base,e->d_name);char rp[4400];path(rp,p,"command.reads.tsv");size_t n;char *s=load(rp,&n),*a=s;while(*a){char *z=strchr(a,'\n');if(z)*z=0;size_t k=strlen(oldroot);if(!strncmp(a,oldroot,k)&&a[k]=='/'){char now[4400];if(cx_fmt(now,sizeof now,"%s%s",root,a+k))die("reuse input bound");compare_input(a,now);}if(!z)break;a=z+1;}free(s);}closedir(d);}
static void reuse(void){char base[4400],p[4400],q[4400],dst[4400];path(base,chain,"ctx/jobs");DIR *d=opendir(base);struct dirent *e;np_buf receipt={0};int count=0;if(!d)die("reuse jobs");while((e=readdir(d))){int tool=!strncmp(e->d_name,"tool-",5),net=!strncmp(e->d_name,"net-",4),tbl=!strncmp(e->d_name,"tbl-",4);if(!tool&&!net&&!tbl)continue;char gen[300];if(!tool){if(cx_fmt(gen,sizeof gen,"gen-%s",e->d_name+4))die("reuse-id");if(selected(gen))continue;}path(p,base,e->d_name);if(!zero(p))die("reuse source status failed");path(dst,jobs,e->d_name);if(mkdir(dst,0700))die("reuse destination");const char *leaf=tool?"result.exe":net?"result.net":"result.tbl";path(q,p,leaf);char target[4400];path(target,dst,leaf);size_t n;char *b=load(q,&n);char h[65];cx_sha256_hex(b,n,h);save(target,b,n);free(b);b=load(target,&n);char h2[65];cx_sha256_hex(b,n,h2);free(b);if(strcmp(h,h2))die("reuse sha mismatch");if(tool&&chmod(target,0700))die("tool chmod");np_puts(&receipt,e->d_name);np_puts(&receipt,"\t");np_puts(&receipt,h);np_puts(&receipt,"\n");count++;}closedir(d);path(p,out,"reused-unaffected.tsv");save(p,receipt.p,receipt.n);free(receipt.p);printf("CHAIN_PRECHECK\treuse\tPREPARED\treused-unaffected=%d\trc=0\n",count);}
static void assert_selected_done(void){char p[4400];size_t n;path(p,out,"selected.tsv");char *s=load(p,&n),*a=s;while(*a){char *z=strchr(a,'\n');if(z)*z=0;path(p,jobs,a);if(!zero(p))die("selected gen incomplete");char id[300];const char *phases[]={"tbl-","net-"};for(int i=0;i<2;i++){if(cx_fmt(id,sizeof id,"%s%s",phases[i],a+4))die("selected id");path(p,jobs,id);if(!zero(p))die("selected tbl/net incomplete");}if(!z)break;a=z+1;}free(s);}
static void phase(const char *what,const char *arg){char com[4400],tool[4400],p[4400],q[4400],envtext[4500];path(com,root,"unisacc.com");if(cx_fmt(envtext,sizeof envtext,"UNISA_CONTAINER=%s",pkg))die("env bound");char *env[]={envtext,0};
 if(tx_eqz(what,"reuse"))unchanged_inputs();
 if(tx_eqz(what,"routes")||tx_eqz(what,"p3")||tx_eqz(what,"finish"))assert_selected_done();
 if(tx_eqz(what,"finish")){const char *marks[]={"include.accepted","drive.accepted"};for(int i=0;i<2;i++){path(p,out,marks[i]);size_t n;char *s=load(p,&n);if(n!=3||memcmp(s,"ok\n",3))die("probe acceptance missing");free(s);}}
 if(tx_eqz(what,"reuse")){reuse();return;}
 if(tx_eqz(what,"identity")){path(p,chain,"ctx/identity-helper");path(q,out,"identity-helper");copy(p,q,1);char *v[]={q,root,0};checked(v,root,"identity-run",0);path(p,out,"identity-run/command.stdout");size_t n;char *s=load(p,&n);if(n<64)die("identity length");np_buf b={0};np_puts(&b,"source\t");np_put(&b,s,64);np_puts(&b,"\n");free(s);path(p,chain,"ctx/context.tsv");s=load(p,&n);char *a=s;int found=0;while(*a){char *z=strchr(a,'\n');if(!z)break;if(!strncmp(a,"cc\t",3)){np_put(&b,a,(size_t)(z-a)+1);found=1;break;}a=z+1;}free(s);if(!found)die("chain cc identity absent");path(p,out,"context.tsv");save(p,b.p,b.n);free(b.p);path(p,chain,"ctx/cc.version");path(q,out,"cc.version");copy(p,q,0);return;}
 if(tx_eqz(what,"routes")){path(tool,root,"tools/chain-step.cx");path(p,out,"routes");char *v[]={"sh",com,tool,"--","routes","HEAD",root,jobs,p,0};checked(v,root,"routes-run",0);return;}
 if(tx_eqz(what,"p3")){path(tool,root,"tools/release-build.cx");path(p,out,"routes/compiler.pkg");path(q,out,"routes/declaration/routes.tsv");char *v[]={"sh",com,tool,"--","p3",root,p,pkg,"--nets",jobs,"--routes",q,0};checked(v,root,"p3-run",0);return;}
 if(tx_eqz(what,"probe")){
  if(!arg)die("probe name required");char src[4400],bin[4400];path(p,out,"probes");if(mkdir(p,0700)&&errno!=EEXIST)die("probes directory");if(cx_fmt(src,sizeof src,"%s/%s.%s",p,arg,tx_eqz(arg,"use")?"cx":"c"))die("probe path");path(bin,out,"probe-entry.elf");
  if(tx_eqz(arg,"entry")){path(tool,root,"tools/entry-build.cx");char *v[]={ctor,"-b","lnx/x86_64","-o",bin,tool,0};checked(v,root,"probe-entry",env);return;}
  if(tx_eqz(arg,"include")){char hdr[4400],body[9000];path(hdr,p,"local.h");const char *h="#define PRECHECK_VALUE 7\n";save(hdr,h,strlen(h));if(cx_fmt(body,sizeof body,"#include \"local.h\"\n#if PRECHECK_VALUE != 7\n#error relative_include_value\n#endif\n#include \"%s\"\n#if PRECHECK_VALUE != 7\n#error absolute_include_value\n#endif\nint main(void){return PRECHECK_VALUE;}\n",hdr))die("probe body");save(src,body,strlen(body));char *v[]={ctor,"-b","lnx/x86_64","-E",src,0};checked(v,root,"probe-include",env);path(q,out,"include.accepted");save(q,"ok\n",3);return;}
  if(tx_eqz(arg,"use")){char mod[4400];path(mod,p,"leaf.cx");const char *m="#pragma unisa module leaf\nint precheck_leaf(void){return 7;}\n",*s="#pragma unisa use leaf\nint main(void){return precheck_leaf();}\n";save(mod,m,strlen(m));save(src,s,strlen(s));char *v[]={ctor,"-b","lnx/x86_64","-o",bin,src,0};checked(v,p,"probe-use",env);return;}
  if(tx_eqz(arg,"drive")){char dd[4400],dh[4400];path(dd,p,"C:");if(mkdir(dd,0700))die("drive-dir");path(dh,dd,"dh.h");const char *h="#define DRIVE_VALUE 7\n",*s="#include \"C:/dh.h\"\n#if DRIVE_VALUE != 7\n#error drive_include_value\n#endif\nint main(void){return DRIVE_VALUE;}\n";save(dh,h,strlen(h));path(dd,p,"src");if(mkdir(dd,0700))die("drive-source-dir");path(src,dd,"drive.c");save(src,s,strlen(s));char *v[]={ctor,"-b","win/x86_64","-E",src,0};checked(v,p,"probe-drive",env);v[2]="lnx/x86_64";np_result r;char why[1400];int t=np_run(v,p,env,30,&r,why,sizeof why);int refused=!t&&r.rc!=0&&!r.residue;np_free(&r);if(!refused)die("linux drive path must refuse");path(q,out,"drive.accepted");save(q,"ok\n",3);return;}
  die("unknown probe");
 }
 if(tx_eqz(what,"slice")){if(!arg||strpbrk(arg,"/\\\r\n\t"))die("slice object KEY or all required");path(tool,root,"tools/entry-build.cx");path(p,out,"sl-lnx");char *v[]={ctor,tool,"--",root,pkg,p,ctor,"--target","lnx/x86_64","--only",(char *)arg,0};char name[300];if(cx_fmt(name,sizeof name,"slice-%s",arg))die("slice name");if(tx_eqz(arg,"all")){v[9]=0;checked(v,root,"slice-link-run",env);}else checked(v,root,name,env);return;}
 if(tx_eqz(what,"slice-link")){path(tool,root,"tools/entry-build.cx");path(p,out,"sl-lnx");char *v[]={ctor,tool,"--",root,pkg,p,ctor,"--target","lnx/x86_64","--link-only",0};checked(v,root,"slice-link-run",env);return;}
 if(tx_eqz(what,"finish")){const char *r[]={"p3-run","probe-entry","probe-include","probe-use","probe-drive","slice-link-run"};for(int i=0;i<6;i++){path(p,out,r[i]);if(!zero(p))die("incomplete or failed phase");}path(p,out,"sl-lnx/candidate");size_t n;char *b=load(p,&n);if(n<4||memcmp(b,"\177ELF",4))die("slice candidate");free(b);b=load(pkg,&n);char h[65];cx_sha256_hex(b,n,h);free(b);printf("CHAIN_PRECHECK\tPASS\tpkg=%s\trc=0\n",h);return;}die("unknown phase");}
static void identity(int creating){char *v[]={"git","rev-parse","--verify","HEAD",0};char *s=capture(v);np_buf b={0};np_puts(&b,s);np_puts(&b,chain);free(s);char p[4400];path(p,out,"session.identity");if(creating)save(p,b.p,b.n);else{size_t n;char *old=load(p,&n);if(n!=b.n||memcmp(old,b.p,n))die("HEAD or CHAIN_OUT changed");free(old);}free(b.p);}
int main(int argc,char **argv){if(argc<5)die("usage ROOT CHAIN_OUT NEW_OUT init --files LIST | --range RANGE; or PHASE [ARG]");if(!realpath(argv[1],root)||!realpath(argv[2],chain)||argv[3][0]!='/'||strlen(argv[3])>=sizeof out)die("absolute roots/output");fit(out,sizeof out,argv[3]);path(jobs,out,"jobs");path(pkg,out,"pkg.bin");path(ctor,chain,"ctrl/unisacc.com.dev/entry.elf");np_subreaper();if(tx_eqz(argv[4],"init")){init(argc,argv);identity(1);return 0;}resume();identity(0);if(tx_eqz(argv[4],"job")&&argc==6){job(argv[5]);return 0;}phase(argv[4],argc>5?argv[5]:0);return 0;}
