/* Consistency fixtures, not executions of sim nor historical source provenance. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sysx.process
static char root[4400],work[4400],com[4400],tool[4400],p[6][4400];
static int count,bad,arm_expected;static int whole_expected,whole_unknown;
static void die(const char *s){fprintf(stderr,"check-module-byte-map: %s\n",s);exit(2);}
static void put(int i,const char *s){if(cx_write(p[i],s,strlen(s)))die("write");}
static void sha(int i,char h[65]){size_t n;char *b=cx_read(p[i],&n);if(!b)die("read");if(sy_sha256_hex(b,(long)n,h))cx_sha256_hex(b,n,h);free(b);}
static void fixture(void){put(1,"012345678901234567890123456789012345678901234567890123456789");put(5,"0123456789abcdef");char merged[65],image[65],rows[65],zero[65];memset(zero,'0',64);zero[64]=0;sha(1,merged);sha(5,image);char b[8192];
 snprintf(b,sizeof b,"TAPE_ORIGIN\tversion=1\ttape_sha=%s\tbytes=60\nORDER_INPUT\tclaim=fixture-consistency-only\nUNIT\t0\ta.o\tlo=0\thi=20\tplanned_source=a.cx\nUNIT\t1\tb.o\tlo=20\thi=40\tplanned_source=b.cx\nSYNTHETIC\tinit\tlo=40\thi=60\nCOMPLETE\tunits=2\tcontext_bytes=40\tsynthetic_bytes=20\tsum=60\ttape_sha=%s\n",merged,merged);put(0,b);
 snprintf(b,sizeof b,"LOWER_ROW_ID\tsource_sha=%s\toutput_sha=%s\tcode_bytes=3\nENTITY\t0\tcode_lo=0\tcode_hi=1\tsource_lo=1\tsource_hi=2\nENTITY\t1\tcode_lo=1\tcode_hi=2\tsource_lo=21\tsource_hi=22\nENTITY\t2\tcode_lo=2\tcode_hi=3\tsource_lo=41\tsource_hi=42\nLOWER_ROW_ORIGIN\trows=3\tcode_bytes=3\tentities=3\n",merged,zero);put(2,b);sha(2,rows);
 snprintf(b,sizeof b,"LOWER_EPISODE_ID\trows_sha=%s\toutput_sha=%s\nEPISODE\t0\trule=GENERIC\ttarget_lo=0\ttarget_hi=1\tnc_lo=0\tnc_hi=1\tsource0_lo=1\tsource0_hi=2\tsource1_lo=-1\tsource1_hi=-1\nEPISODE\t1\trule=GENERIC\ttarget_lo=1\ttarget_hi=2\tnc_lo=1\tnc_hi=2\tsource0_lo=21\tsource0_hi=22\tsource1_lo=-1\tsource1_hi=-1\nEPISODE\t2\trule=PF\ttarget_lo=2\ttarget_hi=3\tnc_lo=0\tnc_hi=2\tsource0_lo=1\tsource0_hi=2\tsource1_lo=21\tsource1_hi=22\nEPISODE\t3\trule=GENERIC\ttarget_lo=3\ttarget_hi=4\tnc_lo=2\tnc_hi=3\tsource0_lo=41\tsource0_hi=42\tsource1_lo=-1\tsource1_hi=-1\nUNKNOWN\ttarget_lo=4\ttarget_hi=6\treason=fixture\nLOWER_EPISODES\tepisodes=4\tuncovered_target_bytes=2\n",rows,zero);put(3,b);
 FILE *f=fopen(p[4],"wb");if(!f)die("records");fprintf(f,"ENCODER_RECORD_ID\ttarget_sha=%s\timage_sha=%s\n",zero,image);int x=0;for(int i=0;i<6;i++){int len=i==4?0:1;fprintf(f,"RECORD\t%d\ttarget_lo=%d\ttarget_hi=%d\ttext_lo=%d\ttext_hi=%d\tfile_lo=%d\tfile_hi=%d\n",i,i,i+1,x,x+len,x+4,x+len+4);x+=len;}fprintf(f,"OTHER\tHEADER\tfile_lo=0\tfile_hi=4\nOTHER\tDATA_OR_ALIGN\tfile_lo=9\tfile_hi=16\nENCODER_RECORD_ORIGIN\trecords=6\ttext_bytes=5\timage_bytes=16\n");if(fclose(f))die("close");}
static void change(int i,const char *old,const char *value){size_t n;char *s=cx_read(p[i],&n),*at=s?strstr(s,old):0;if(!at||strstr(at+strlen(old),old))die("exact fixture replacement");size_t a=at-s,o=strlen(old),v=strlen(value);char *b=malloc(n-o+v+1);if(!b)die("alloc");memcpy(b,s,a);memcpy(b+a,value,v);memcpy(b+a+v,at+o,n-a-o);if(cx_write(p[i],b,n-o+v))die("replace");free(b);free(s);}
static void check(int expected,const char *label){char *v[12];int vi=0;v[vi++]="sh";v[vi++]=com;v[vi++]=tool;v[vi++]="--";if(whole_expected)v[vi++]="--whole-context";for(int i=0;i<6;i++)v[vi++]=p[i];v[vi]=0;np_result r={0};char why[512]={0};int tr=np_run(v,root,0,8,&r,why,sizeof why);int ok=!tr&&!r.residue&&r.rc==expected;if(!expected&&whole_expected){ok=ok&&r.out&&strstr(r.out,whole_unknown?"UNKNOWN\tbytes=3\trecords=4":"UNKNOWN\tbytes=1\trecords=2")&&strstr(r.out,whole_unknown?"SHARED\tbytes=0\trecords=0":"SHARED\tbytes=1\trecords=1")&&strstr(r.out,"SYNTHETIC\tbytes=1\trecords=1")&&strstr(r.out,"MODULE\t/b.cx\tbytes=1\trecords=1")&&strstr(r.out,"accounted_bytes=16");}else if(!expected&&arm_expected)ok=ok&&strstr(r.out,"SHARED\tbytes=3\trecords=3")&&strstr(r.out,"SYNTHETIC\tbytes=1\trecords=1")&&strstr(r.out,"UNKNOWN\tbytes=1\trecords=2")&&strstr(r.out,"accounted_bytes=16");else if(!expected)ok=ok&&strstr(r.out,"MODULE\ta.cx\tbytes=1\trecords=1")&&strstr(r.out,"MODULE\tb.cx\tbytes=1\trecords=1")&&strstr(r.out,"SHARED\tbytes=1\trecords=1")&&strstr(r.out,"SYNTHETIC\tbytes=1\trecords=1")&&strstr(r.out,"UNKNOWN\tbytes=1\trecords=2")&&strstr(r.out,"accounted_bytes=16");else ok=ok&&!r.outn;count++;bad+=!ok;printf("%s\t%s\n",ok?"PASS":"FAIL",label);if(!ok){fprintf(stderr,"transport=%d rc=%d %s\n",tr,r.rc,why);if(r.err)fwrite(r.err,1,r.errn,stderr);if(r.out)fwrite(r.out,1,r.outn,stderr);}np_free(&r);}
static void arm_fixture(void){
 fixture();char merged[65],rows[65],zero[65];sha(1,merged);memset(zero,'0',64);zero[64]=0;char b[8192];
 FILE *f=fopen(p[2],"wb");if(!f)die("arm rows");fprintf(f,"LOWER_ROW_ID\tsource_sha=%s\toutput_sha=%s\tcode_bytes=5\n",merged,zero);
 long sources[]={1,2,21,22,41};for(int i=0;i<5;i++)fprintf(f,"ENTITY\t%d\tcode_lo=%d\tcode_hi=%d\tsource_lo=%ld\tsource_hi=%ld\n",i,i,i+1,sources[i],sources[i]+1);
 fputs("LOWER_ROW_ORIGIN\trows=5\tcode_bytes=5\tentities=5\n",f);if(fclose(f))die("arm rows close");sha(2,rows);
 snprintf(b,sizeof b,"LOWER_EPISODE_ID\trows_sha=%s\toutput_sha=%s\nEPISODE\t0\trule=AF\ttarget_lo=0\ttarget_hi=3\tnc_lo=0\tnc_hi=4\tsource0_lo=1\tsource0_hi=2\tsource1_lo=2\tsource1_hi=3\tsource2_lo=21\tsource2_hi=22\tsource3_lo=22\tsource3_hi=23\nEPISODE\t1\trule=GENERIC\ttarget_lo=3\ttarget_hi=4\tnc_lo=4\tnc_hi=5\tsource0_lo=41\tsource0_hi=42\tsource1_lo=-1\tsource1_hi=-1\nUNKNOWN\ttarget_lo=4\ttarget_hi=6\treason=fixture\nLOWER_EPISODES\tepisodes=2\tuncovered_target_bytes=2\n",rows,zero);put(3,b);
}
static void whole_fixture(int location){
 fixture();whole_unknown=location;char merged[65],zero[65],profileh[65],slice[4][65];sha(1,merged);memset(zero,'0',64);zero[64]=0;
 const char *profile="CT.afterfn\tunit_epoch,hl_pos,fns,fne\toutput-mark\nFN.nx\tunit_epoch,infunc\toutput-span\n";cx_sha256_hex(profile,strlen(profile),profileh);size_t z;char *tape=cx_read(p[1],&z);if(!tape)die("whole fixture tape");long lo[]={0,20,30,40},hi[]={10,30,35,50};for(int i=0;i<4;i++)cx_sha256_hex(tape+lo[i],hi[i]-lo[i],slice[i]);free(tape);
 char b[8192];snprintf(b,sizeof b,"WHOLE_FUNCTION_ORIGIN\tversion=1\tmaterial_sha=%s\tframes_sha=%s\tattrs_sha=%s\toriginal_units_sha=%s\tframe_manifest_sha=%s\tconfig_sha=%s\twatch_sha=%s\toutput_sha=%s\ttape_sha=%s\tdelta_sha=a985b1706b96659bd3951a44495e774d4eb3c969163845c7a63d9c225e6b1811\tclaim=emitter-context-not-exclusive-ownership\nUNIT\t0\tplanned_source=/a.cx\tkind=SOURCE\nUNIT\t1\tplanned_source=/b.cx\tkind=SOURCE\nUNIT\t2\tplanned_source=/stub.c\tkind=SYNTHETIC\nCONTEXT\t0\tunit=0\tlo=0\thi=10\tsurvived=1\tsha=%s\nUNKNOWN\tlo=10\thi=20\nCONTEXT\t1\tunit=1\tlo=20\thi=30\tsurvived=1\tsha=%s\nCONTEXT\t2\tunit=0\tlo=30\thi=35\tsurvived=0\tsha=%s\nUNKNOWN\tlo=35\thi=40\nCONTEXT\t3\tunit=2\tlo=40\thi=50\tsurvived=1\tsha=%s\nUNKNOWN\tlo=50\thi=60\nCOMPLETE\tunits=3\tcontexts=4\ttape_bytes=60\ttape_sha=%s\n",zero,zero,zero,zero,zero,profileh,zero,zero,merged,slice[0],slice[1],zero,slice[3],merged);put(0,b);
 if(location){long a=location==1?11:location==2?31:9,h=location==3?11:a+1;char replace[120];snprintf(replace,sizeof replace,"source_lo=%ld\tsource_hi=%ld",a,h);change(2,"source_lo=1\tsource_hi=2",replace);char rows[65];sha(2,rows);change(3,"nc_lo=0\tnc_hi=1\tsource0_lo=1\tsource0_hi=2","nc_lo=0\tnc_hi=1\tsource0_lo=111\tsource0_hi=112");snprintf(replace,sizeof replace,"source0_lo=%ld\tsource0_hi=%ld",a,h);change(3,"source0_lo=111\tsource0_hi=112",replace);change(3,"nc_lo=0\tnc_hi=2\tsource0_lo=1\tsource0_hi=2","nc_lo=0\tnc_hi=2\tsource0_lo=111\tsource0_hi=112");change(3,"source0_lo=111\tsource0_hi=112",replace);size_t n;char *e=cx_read(p[3],&n),*q=e?strstr(e,"rows_sha="):0;if(!q)die("whole rows identity");memcpy(q+9,rows,64);if(cx_write(p[3],e,n))die("whole rows update");free(e);}
}
static void whole_checks(void){
 whole_expected=1;whole_fixture(0);check(0,"whole source/stub/fusion shared counted once and conserved");whole_fixture(1);check(0,"explicit UNKNOWN hole remains unknown");whole_fixture(2);check(0,"non-surviving context remains unknown");whole_fixture(3);check(0,"cross-context boundary remains unknown");
 whole_fixture(0);change(0,"CONTEXT\t1\tunit=1\tlo=20","CONTEXT\t1\tunit=1\tlo=19");check(2,"whole overlap/order refuses");whole_fixture(0);change(0,"CONTEXT\t2\tunit=0\tlo=30\thi=35\tsurvived=0","CONTEXT\t2\tunit=0\tlo=30\thi=35\tsurvived=1");check(2,"whole survival hash mismatch refuses");whole_fixture(0);change(0,"contexts=4","contexts=5");check(2,"whole wrong context count refuses");whole_fixture(0);change(0,"tape_bytes=60","tape_bytes=61");check(2,"whole wrong tape extent refuses");whole_fixture(0);change(0,"kind=SYNTHETIC","kind=UNKNOWN_KIND");check(2,"whole unknown unit kind refuses");whole_fixture(0);change(0,"claim=emitter-context-not-exclusive-ownership","claim=exclusive");check(2,"whole wrong identity claim refuses");whole_fixture(0);change(0,"version=1","version=2");check(2,"whole unsupported schema refuses");whole_fixture(0);change(0,"UNKNOWN\tlo=50\thi=60","UNKNOWN\tlo=50\thi=59");check(2,"whole coverage gap refuses");printf("MODULE_BYTE_MAP_WHOLE_CHECK\tchecks=%d\tfailed=%d\n",count,bad);
}

int main(int argc,char **argv){if(!realpath(".",root))die("root");snprintf(work,sizeof work,"%s/out/module-byte-map-check-XXXXXX",root);if(!mkdtemp(work))die("temp");snprintf(com,sizeof com,"%s/unisacc.com",root);snprintf(tool,sizeof tool,"%s/tools/module-byte-map.cx",root);for(int i=0;i<6;i++)snprintf(p[i],sizeof p[i],"%s/input%d",work,i);
 if(argc==2&&!strcmp(argv[1],"--whole-context-checks")){whole_checks();return bad?1:0;}
 if(argc==2&&!strcmp(argv[1],"--arm-episodes")){arm_expected=1;arm_fixture();check(0,"AF4 cross-module SHARED counted once per record");arm_fixture();change(3,"source2_lo=21","source2_lo=20");check(2,"AF4 source2 ENTITY tamper refuses");arm_fixture();change(3,"\tsource3_hi=23","");check(2,"AF4 missing source3 refuses");printf("MODULE_BYTE_MAP_ARM_CHECK\tchecks=%d\tfailed=%d\n",count,bad);return bad?1:0;}if(argc!=1)return 2;
 fixture();check(0,"two-modules-shared-synthetic-unknown-zero-conserved");
 fixture();
 for(int i=3;i>=0;i--){char a[100],z[100];snprintf(a,sizeof a,"target_lo=%d\ttarget_hi=%d",i,i+1);snprintf(z,sizeof z,"target_lo=%d\ttarget_hi=%d",2*i,2*i+2);change(3,a,z);}
 change(3,"UNKNOWN\ttarget_lo=4\ttarget_hi=6","UNKNOWN\ttarget_lo=8\ttarget_hi=14");change(3,"uncovered_target_bytes=2","uncovered_target_bytes=6");
 for(int i=5;i>=0;i--){char a[100],z[100];snprintf(a,sizeof a,"target_lo=%d\ttarget_hi=%d",i,i+1);snprintf(z,sizeof z,"target_lo=%d\ttarget_hi=%d",2*i,2*i+1);change(4,a,z);}
 check(0,"metadata-label-gaps-and-nonrecord-tail-conserved");
 fixture();change(3,"nc_lo=0\tnc_hi=1\tsource0_lo=1","nc_lo=0\tnc_hi=3\tsource0_lo=1");check(2,"rule-count-over-two-refused");
 fixture();put(1,"changed");check(2,"wrong-merged-hash-refused");
 fixture();change(4,"RECORD\t1\ttarget_lo=1","RECORD\t1\ttarget_lo=0");check(2,"overlapping-record-refused");
 fixture();change(3,"EPISODE\t0\trule=GENERIC\ttarget_lo=0\ttarget_hi=1\tnc_lo=0\tnc_hi=1\tsource0_lo=1","EPISODE\t0\trule=GENERIC\ttarget_lo=0\ttarget_hi=1\tnc_lo=0\tnc_hi=1\tsource0_lo=2");check(2,"wrong-ENTITY-refused");
 fixture();change(4,"ENCODER_RECORD_ORIGIN\trecords=6\ttext_bytes=5\timage_bytes=16\n","");check(2,"missing-record-tail-refused");
 fixture();change(3,"EPISODE\t3\trule=GENERIC\ttarget_lo=3","EPISODE\t3\trule=GENERIC\ttarget_lo=2");check(2,"overlapping-episode-refused");
 printf("MODULE_BYTE_MAP_CHECK\tchecks=%d\tfailed=%d\tfixture=consistency-only\twork=%s\n",count,bad,work);return bad?1:0;}
