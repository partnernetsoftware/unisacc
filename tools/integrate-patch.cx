 patch_frozen();patch_author_live();treeid(now);if(strcmp(now,tree))die("write-tree-ne-receipt-tree");
 if(!getenv("INTEGRATE_LAND_TEST")){compile_tools();land_require_affected();}
 char *cv[]={"git","-C",candidate,"-c","user.name=integrate-patch","-c","user.email=integrate@local","-c","core.hooksPath=/dev/null","commit","--no-verify","-F",msgfile,0};
 success("land-commit",cv,0,0,20);
