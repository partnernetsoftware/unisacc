    if(hit){char *sv[]={"sh","./unisacc.com","tools/chain-smoke.cx","--","--scan","tools/candidate-chain.cx",0};np_result sr=call("chain-smoke-scan",sv,candidate,0,20);int sc=sr.rc;np_free(&sr);if(sc){puts("INTEGRATE_PATCH\tstatus=CHAIN_SMOKE_RED\tqualification=NOT_QUALIFIED");exit(1);}}}
