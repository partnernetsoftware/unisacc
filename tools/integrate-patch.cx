  if(L>9&&!memcmp(q,"AFFECTED\t",9)){const char *id=q+9;const char *tab=memchr(id,'\t',(size_t)(q+L-id));size_t z=tab?(size_t)(tab-id):(size_t)(q+L-id);
   if(z&&z<80&&ni<32){if(mm_copy(ids[ni],80,id,(long)z))die("id-copy");ids[ni][z]=0;ni++;}}
  if(!nl)break;q=nl+1;}}
