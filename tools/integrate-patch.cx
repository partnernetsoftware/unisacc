/* ROOT PATCH NEW_PRIVATE_CLONE [--base REV] [--prepare-only] [--land]
 * --resume PRIVATE_CLONE continues bounded, identity-bound real gate phases,
 * including an unfinished prepare compile step (PENDING next_phase=prepare).
 * --land CLONE after READY_TO_COMMIT: write-tree==receipt tree, commit, push, align.
 * Each invocation has 120 seconds; children receive at most 55 seconds. The
 * independent main snapshot and candidate are never scanned while being edited.
 * 本地普通克隆仅硬链接Git不可变对象；refs/index/工作树独立，无alternates。
 * Logs/three-side materials/receipts live in PRIVATE_CLONE/.git/integrate. */
#pragma unisa use cxlib.appendmerge
#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
#pragma unisa use mem.bytes
#pragma unisa use cxlib.productpkg
#pragma unisa use cxlib.kernelsha
#pragma unisa use sys.time
#pragma unisa use sys.env
static char root[4096],candidate[4096],state[4400],baseline[4400],base[65],patchsha[65],product[65],tree[65],patchorigin[4096],msgfile[4096];
static long deadline;static int serial,phase,until_mode,stop_pending,fake_left=-1;static char why[1000];
static const char *phasefiles[]={"metadata.stdout","ratchets-base.stdout","ratchets-head.stdout","precommit.stdout"};
static char phasehash[4][65];
static void die(const char *s){fprintf(stderr,"integrate-patch: REFUSE %s\n",s);exit(2);}
static void path(char *p,size_t c,const char *a,const char *b){if(cx_fmt(p,c,"%s/%s",a,b))die("path-bound");}
static void put(const char *p,const char *s,size_t n){if(cx_write(p,s,n))die("write-material");}
static char *load(const char *p,size_t *n){sy_stat_t st;if(sy_lstat(p,&st)||st.kind!='f'||st.size<0||st.size>134217728)die("regular-bounded-material");char *s=cx_read(p,n);if(!s)die("read-material");return s;}
static void digest(const char *p,char h[65]){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,h);free(s);}
static void material(const char *name,const char *s,size_t n){char p[4700];path(p,sizeof p,state,name);put(p,s,n);}
static void save(void);
/* prep_open: tree frozen and receipt saved with phase 0, so the prepare compile step is resumable.
 * Before that point (clone/apply) an exhausted budget is still a refusal. */
static int prep_open,call_timeout_ok;
static void pending(void){if(!phase&&!prep_open)die("prepare-budget-exhausted-retained-materials-not-resumable");save();if(phase)printf("INTEGRATE_PATCH\tstatus=PENDING\tnext_phase=%d\tqualification=NOT_QUALIFIED\n",phase);else printf("INTEGRATE_PATCH\tstatus=PENDING\tnext_phase=prepare\tqualification=NOT_QUALIFIED\n");if(until_mode){stop_pending=1;return;}exit(3);}
static np_result call(const char *label,char **v,const char *cwd,char **env,int seconds){
 if(seconds>55||seconds<1)die("child-budget");long available=(deadline-sy_now_ms()-2000)/1000;if(available<seconds)pending();
 np_result r={0};long start=sy_now_ms();int tr=np_run(v,cwd,env,seconds,&r,why,sizeof why);char file[200],row[300];
 if(cx_fmt(file,sizeof file,"%03d-%s.stdout",++serial,label))die("log-name");material(file,r.out?r.out:"",r.outn);
 if(cx_fmt(file,sizeof file,"%03d-%s.stderr",serial,label))die("log-name");material(file,r.err?r.err:"",r.errn);
 if(cx_fmt(row,sizeof row,"transport=%d\trc=%d\tresidue=%d\telapsed_ms=%ld\n",tr,r.rc,r.residue,sy_now_ms()-start)||cx_fmt(file,sizeof file,"%03d-%s.status",serial,label))die("status-format");material(file,row,strlen(row));
 /* call_timeout_ok: the compile wave harvests per-job status files after a clean 55s kill */
 if(tr&&call_timeout_ok&&r.timed_out&&!r.residue){r.rc=-1;r.out=r.err=0;r.outn=r.errn=0;return r;}
 if(tr||r.residue){np_free(&r);die("child-transport-or-residue-see-stage-logs");}return r;
}
static void success(const char *label,char **v,const char *cwd,char **env,int seconds){np_result r=call(label,v,cwd,env,seconds);int rc=r.rc;np_free(&r);if(rc)die("child-nonzero-see-stage-logs");}
static np_result git(const char *label,const char *where,const char *a,const char *b,const char *c,const char *d,char **env){char *v[]={"git","-C",(char*)where,(char*)a,(char*)b,(char*)c,(char*)d,0};return call(label,v,0,env,12);}
static void text(np_result *r,char *s,size_t cap){size_t n=r->outn;if(r->rc||!n||n>=cap||r->out[n-1]!='\n'||memchr(r->out,0,n))die("git-identity-output");n--;if(memchr(r->out,'\n',n))die("git-identity-lines");if(mm_copy(s,(long)cap,r->out,(long)n))die("git-identity-copy-bound");s[n]=0;np_free(r);}
static void identity(const char *where,const char *rev,char *out,size_t cap){char spec[200];if(cx_fmt(spec,sizeof spec,"%s^{commit}",rev))die("revision-bound");np_result r=git("revision",where,"rev-parse","--verify",spec,0,0);text(&r,out,cap);}
static void treeid(char out[65]){np_result r=git("index-tree",candidate,"write-tree",0,0,0,0);text(&r,out,65);}
static void save(void){np_buf b={0};np_puts(&b,"INTEGRATE_PATCH1\nroot\t");np_puts(&b,root);np_puts(&b,"\nbase\t");np_puts(&b,base);np_puts(&b,"\npatch\t");np_puts(&b,patchsha);np_puts(&b,"\nproduct\t");np_puts(&b,product);np_puts(&b,"\ntree\t");np_puts(&b,tree);np_puts(&b,"\nphase\t");np_putll(&b,phase);np_puts(&b,"\nserial\t");np_putll(&b,serial);np_puts(&b,"\n");for(int i=0;i<4;i++){np_puts(&b,phasefiles[i]);np_puts(&b,"\t");np_puts(&b,phasehash[i][0]?phasehash[i]:"-");np_puts(&b,"\n");}material("receipt.tsv",b.p,b.n);free(b.p);}
static const char *field(char **at,const char *key){char *s=*at,*e=strchr(s,'\n');size_t n=strlen(key);if(!e||strncmp(s,key,n)||s[n]!='\t')die("receipt-schema");*e=0;*at=e+1;return s+n+1;}
static void copyfield(char *s,size_t cap,const char *v){if(cx_fmt(s,cap,"%s",v))die("receipt-field-bound");}
static void readreceipt(void){char p[4700];path(p,sizeof p,state,"receipt.tsv");size_t n;char *s=load(p,&n);if(n<17||strncmp(s,"INTEGRATE_PATCH1\n",17)||memchr(s,0,n)||memchr(s,'\r',n))die("receipt-wire");char *at=s+17;copyfield(root,sizeof root,field(&at,"root"));copyfield(base,sizeof base,field(&at,"base"));copyfield(patchsha,sizeof patchsha,field(&at,"patch"));copyfield(product,sizeof product,field(&at,"product"));copyfield(tree,sizeof tree,field(&at,"tree"));const char *v=field(&at,"phase");char *end;phase=(int)strtol(v,&end,10);if(*end||v==end||phase<0||phase>6)die("receipt-phase");v=field(&at,"serial");serial=(int)strtol(v,&end,10);if(*end||serial<0||serial>10000)die("receipt-serial");for(int i=0;i<4;i++){v=field(&at,phasefiles[i]);if(i<phase-1){if(strlen(v)!=64)die("completed-phase-digest");copyfield(phasehash[i],65,v);}else if(strcmp(v,"-"))die("unexecuted-phase-digest");}if(*at)die("receipt-extra-fields");free(s);}
static void productcheck(const char *where){char h[65];if(pp_product_digest(where,h)||strcmp(h,product))die("product-identity-changed");}
static void verify(void){patch_author_live();char h[65];identity(candidate,"HEAD",h,sizeof h);if(strcmp(h,base))die("candidate-HEAD-changed");identity(candidate,"refs/heads/main",h,sizeof h);if(strcmp(h,base))die("candidate-main-changed");treeid(h);if(strcmp(h,tree))die("candidate-index-changed");np_result r=git("unstaged",candidate,"diff","--quiet",0,0,0);if(r.rc)die("candidate-unstaged-changes");np_free(&r);r=git("untracked",candidate,"ls-files","--others","--exclude-standard",0,0);if(r.rc||r.outn)die("candidate-untracked-inputs");np_free(&r);productcheck(candidate);productcheck(baseline);identity(baseline,"HEAD",h,sizeof h);if(strcmp(h,base))die("baseline-HEAD-changed");r=git("baseline-clean",baseline,"diff","--quiet","HEAD",0,0);if(r.rc)die("baseline-inputs-changed");np_free(&r);char p[4700];path(p,sizeof p,state,"patch.diff");digest(p,h);if(strcmp(h,patchsha))die("patch-identity-changed");}
static void clone(const char *target,const char *label){char *v[]={"git","clone","--local","--no-checkout",root,(char*)target,0};success(label,v,0,0,45);char *ck[]={"git","-C",(char*)target,"checkout","-B","main",base,0};success("checkout-main",ck,0,0,15);if(pp_copy_product(root,target))die("freeze-product-copy");}
static char *indexblob(const char *name,char **env,size_t *n,int *present){char *lv[]={"git","-C",candidate,"ls-files","--error-unmatch","--",(char*)name,0};np_result r=call("table-presence",lv,0,env,5);if(r.rc==1){np_free(&r);*present=0;*n=0;return 0;}if(r.rc)die("index-table-presence");np_free(&r);char spec[200];if(cx_fmt(spec,sizeof spec,":%s",name))die("table-spec");r=git("table-blob",candidate,"show",spec,0,0,env);if(r.rc)die("table-blob");char *s=r.out;r.out=0;*n=r.outn;*present=1;np_free(&r);return s;}
static int want_land;
/* stop_after: 0 = off. 1..5 = preflight, stop after that gate phase; never writes ready.tsv or READY. */
static int stop_after;
static int parse_stop_after(const char *v){char *end;long n=strtol(v,&end,10);if(end==v||*end||n<1||n>5)die("stop-after-range");return (int)n;}
static void preflight_ok(void){puts("INTEGRATE_PREFLIGHT\tstatus=PREFLIGHT_OK");}
static int contains(const char *s,size_t n,const char *part);
static void land(void);
static void run_affected(void);
static void require_git_diff(const char *s,size_t n){
 int git=0,idx=0;for(size_t i=0;i+11<=n;i++)if(!memcmp(s+i,"diff --git ",11))git=1;
 for(size_t i=0;i+6<=n;i++)if((i==0||s[i-1]=='\n')&&!memcmp(s+i,"index ",6))idx=1;
 if(!git||!idx){fprintf(stderr,"integrate-patch: REFUSE patch-not-git-diff-with-index\n");fprintf(stderr,"integrate-patch: repair: git diff --full-index BASE HEAD > PATCH\n");exit(2);}
}
static int file_in_patch(const char *s,size_t n,const char *rel){
 char mark[500];size_t pn;
 if(!rel||!rel[0])return 0;
 if(!cx_fmt(mark,sizeof mark,"diff --git a/%s b/%s",rel,rel)){pn=strlen(mark);for(size_t i=0;i+pn<=n;i++)if(!memcmp(s+i,mark,pn))return 1;}
 if(!cx_fmt(mark,sizeof mark,"+++ b/%s",rel)){pn=strlen(mark);for(size_t i=0;i+pn<=n;i++)if((i==0||s[i-1]=='\n')&&!memcmp(s+i,mark,pn))return 1;}
 if(!cx_fmt(mark,sizeof mark,"diff --git a/%s ",rel)){pn=strlen(mark);for(size_t i=0;i+pn<=n;i++)if(!memcmp(s+i,mark,pn))return 1;}
 return 0;
}
static int exists_here(const char *rel){
 char p[4700];
 if(!rel||!rel[0]||!strcmp(rel,"-"))return 0;
 if(candidate[0]){path(p,sizeof p,candidate,rel);if(sy_exists(p)==1)return 1;}
 if(root[0]){path(p,sizeof p,root,rel);if(sy_exists(p)==1)return 1;}
 {sy_stat_t st;if(!sy_lstat(rel,&st)&&st.kind=='f')return 1;}
 return 0;
}
static void check_registry_rows(const char *s,size_t n){
 const char *tables[]={"tests/batches.tsv","tests/coverage.tsv"};
 for(int t=0;t<2;t++){
  char a[80];if(cx_fmt(a,sizeof a,"+++ b/%s",tables[t]))die("table-mark");
  const char *sec=0;size_t sl=strlen(a);for(size_t i=0;i+sl<=n;i++)if(!memcmp(s+i,a,sl)&&(i==0||s[i-1]=='\n')){sec=s+i;break;}
  if(!sec)continue;
  const char *end=sec+1;while(end<s+n){if((end==s||end[-1]=='\n')&&end+11<=s+n&&!memcmp(end,"diff --git ",11))break;end++;}
  for(const char *q=sec;q<end;){const char *nl=memchr(q,'\n',(size_t)(end-q));if(!nl)break;
   if(q[0]=='+'&&q[1]!='+'){const char *row=q+1;const char *col[16];int nc=0;const char *f=row;
    col[nc++]=f;while(f<nl&&nc<16){if(*f=='\t'){col[nc++]=f+1;}f++;}
    if(t==0&&nc>=4){const char *impl=col[1];size_t il=(size_t)(col[2]-col[1]-1);
     if(il==11&&!memcmp(impl,"IMPLEMENTED",11)){const char *chk=nc>=9?col[8]:col[3];size_t m=(size_t)((nc>=10?col[9]:nl)-chk);if(m&&chk[m-1]=='\t')m--;
      char pathc[400];if(m>=sizeof pathc)die("registry-check-path");if(m&&mm_copy(pathc,sizeof pathc,chk,(long)m))die("chk-copy");pathc[m]=0;
      if(m&&strcmp(pathc,"-")&&!file_in_patch(s,n,pathc)&&!exists_here(pathc))die("registry-check-missing");}}}
   q=nl+1;}
 }
}
static void patch_frozen(void){char p[4700],h[65];path(p,sizeof p,state,"patch.diff");digest(p,h);if(strcmp(h,patchsha))die("patch-sha-changed-after-open");}
static void load_origin(void){char p[4700];path(p,sizeof p,state,"patch.origin");size_t n;char *s=load(p,&n);if(n&&s[n-1]=='\n')n--;if(!n||n>=sizeof patchorigin)die("patch-origin");if(mm_copy(patchorigin,sizeof patchorigin,s,(long)n))die("origin-copy");patchorigin[n]=0;free(s);}
static void patch_author_live(void){char h[65];if(!patchorigin[0])load_origin();digest(patchorigin,h);if(strcmp(h,patchsha)){fprintf(stderr,"integrate-patch: REFUSE patch-author-rewritten-after-freeze\n");fprintf(stderr,"integrate-patch: frozen copy differs from %s\n",patchorigin);exit(2);}}
/* Resumable prepare compile step. .git/integrate/prepare-done.tsv is bound by its header to
 * base/patch/product/tree (any change voids every row). Row: tool, DONE, source sha, artifact sha,
 * compiler identity (product digest); or tool, SOLO (timed out inside a shared wave, next try alone).
 * A hit still re-digests source and artifact; a mismatch recompiles that tool. Tools compile in waves
 * of independent jobs inside one bounded 55s child; every job has its own artifact and status file. */
static void prep_hdr(char *h,size_t c){if(cx_fmt(h,c,"PREPARE_DONE1\nbase\t%s\npatch\t%s\nproduct\t%s\ntree\t%s\n",base,patchsha,product,tree))die("prep-hdr");}
static char *prep_load(size_t *n,size_t *body){char p[4700],h[1000];path(p,sizeof p,state,"prepare-done.tsv");*n=0;if(sy_exists(p)!=1)return 0;prep_hdr(h,sizeof h);size_t m;char *s=load(p,&m);size_t hl=strlen(h);if(m<hl||memcmp(s,h,hl)||memchr(s,0,m)||(m&&s[m-1]!='\n')){free(s);return 0;}*n=m;*body=hl;return s;}
/* f[0..3] receive status, source sha, artifact sha, compiler; returns 1 when a well-formed row exists */
static int prep_row(const char *rel,char f[4][65]){
 size_t n,at=0;char *s=prep_load(&n,&at);size_t rl=strlen(rel);int found=0;if(!s)return 0;
 while(at<n&&!found){const char *e=memchr(s+at,'\n',n-at);size_t z=(size_t)(e-s-at);
  if(z>rl+1&&!memcmp(s+at,rel,rl)&&s[at+rl]=='\t'){const char *q=s+at+rl+1,*end=s+at+z;int k=0,ok=1;
   for(;k<4&&ok;k++){const char *t=k<3?memchr(q,'\t',(size_t)(end-q)):end;if(!t||t==q||t-q>64)ok=0;else{if(mm_copy(f[k],65,q,(long)(t-q)))die("prep-field");f[k][t-q]=0;q=t+1;}}
   found=ok&&k==4;}
  at+=z+1;}
 free(s);return found;
}
static void prep_set(const char *rel,const char *status,const char *src,const char *art){
 size_t n,at=0;char *s=prep_load(&n,&at);np_buf b={0};char h[1000];size_t rl=strlen(rel);prep_hdr(h,sizeof h);np_puts(&b,h);
 while(s&&at<n){const char *e=memchr(s+at,'\n',n-at);size_t z=(size_t)(e-s-at);if(!(z>rl&&!memcmp(s+at,rel,rl)&&s[at+rl]=='\t'))np_put(&b,s+at,z+1);at+=z+1;}
 free(s);np_puts(&b,rel);np_puts(&b,"\t");np_puts(&b,status);np_puts(&b,"\t");np_puts(&b,src);np_puts(&b,"\t");np_puts(&b,art);np_puts(&b,"\t");np_puts(&b,product);np_puts(&b,"\n");material("prepare-done.tsv",b.p,b.n);free(b.p);
}
struct prep_job{char rel[400],outp[4700],src[65];int lib,solo,done;};
/* 1: recorded, identities unchanged, artifact digest verified */
static int prep_hit(struct prep_job *j){
 char f[4][65],h[65];const char *stale=0;if(!prep_row(j->rel,f))return 0;
 if(!strcmp(f[0],"SOLO")){j->solo=1;return 0;}
 if(strcmp(f[0],"DONE"))stale="record-status";
 else if(strcmp(f[3],product))stale="compiler-identity";
 else if(strcmp(f[1],j->src))stale="source-sha";
 else if(sy_exists(j->outp)!=1)stale="artifact-missing";
 else{digest(j->outp,h);if(strcmp(h,f[2]))stale="artifact-sha";}
 if(stale){printf("INTEGRATE_PREPARE_STALE\ttool=%s\treason=%s\n",j->rel,stale);return 0;}
 return 1;
}
#define PREP_JOBS 256
#define PREP_WIDTH 8
static void compile_tools(void){
 static struct prep_job jobs[PREP_JOBS];int nj=0,skipped=0,compiled=0,left=0;
 const char *fm=getenv("INTEGRATE_FAKE_PREP_MAX"),*we=getenv("INTEGRATE_PREP_WIDTH");int fmax=fm&&fm[0]?atoi(fm):-1,width=we&&we[0]?atoi(we):4;
 if(width<1||width>PREP_WIDTH)die("prepare-wave-width");
 productcheck(candidate);
 {char dir[4700];path(dir,sizeof dir,state,"compile-out.d");if(sy_mkdir(dir,0700)&&sy_exists(dir)!=1)die("prepare-artifact-directory");}
 np_result d=git("compile-names",candidate,"diff","--cached","--name-only",0,0);if(d.rc)die("compile-names");
 size_t at=0;while(at<d.outn){const char *e=memchr(d.out+at,'\n',d.outn-at);size_t z=e?(size_t)(e-d.out-at):d.outn-at;
  if(z>6&&z<390&&!memcmp(d.out+at,"tools/",6)&&z>9&&!memcmp(d.out+at+z-3,".cx",3)){
   if(nj==PREP_JOBS)die("prepare-too-many-tool-files");struct prep_job *j=&jobs[nj++];char sp[4700],key[65],name[100];
   if(mm_copy(j->rel,400,d.out+at,(long)z))die("rel");j->rel[z]=0;j->solo=j->done=0;
   cx_sha256_hex(j->rel,z,key);if(cx_fmt(name,sizeof name,"compile-out.d/%.32s.bin",key))die("prepare-artifact-name");path(j->outp,sizeof j->outp,state,name);
   /* tools/cxlib/ holds library modules without main: compile-only (-c), entry tools link */
   j->lib=z>12&&!memcmp(j->rel,"tools/cxlib/",12);
   path(sp,sizeof sp,candidate,j->rel);if(sy_exists(sp)!=1){fprintf(stderr,"integrate-patch: REFUSE tool-compile-failed %s\n",j->rel);exit(2);}
   digest(sp,j->src);
   if(prep_hit(j)){j->done=1;skipped++;printf("INTEGRATE_PREPARE_SKIP\ttool=%s\n",j->rel);}else left++;
  }at+=z+1;}
 np_free(&d);
 const char *script="c=$1; w=$2; shift 2; i=0\nwhile [ $# -ge 3 ]; do\n i=$((i+1))\n (\n  if [ \"$3\" = lib ]; then (cd \"$c\" && exec sh ./unisacc.com \"$1\" -c -o \"$2\") >\"$w/$i.stdout\" 2>\"$w/$i.stderr\"\n  else (cd \"$c\" && exec sh ./unisacc.com \"$1\" -o \"$2\") >\"$w/$i.stdout\" 2>\"$w/$i.stderr\"; fi\n  printf '%s\\n' \"$?\" >\"$w/$i.rc.tmp\" && mv \"$w/$i.rc.tmp\" \"$w/$i.rc\"\n ) &\n shift 3\ndone\nwait\n";
 while(left>0){
  struct prep_job *wave[PREP_WIDTH];int k=0;
  if(fmax>=0&&compiled>=fmax){pending();return;}
  if(deadline-sy_now_ms()<58000){pending();return;}
  for(int i=0;i<nj&&k<width&&(fmax<0||compiled+k<fmax);i++){if(jobs[i].done)continue;if(jobs[i].solo){if(!k)wave[k++]=&jobs[i];break;}wave[k++]=&jobs[i];}
  char wdir[4700];if(cx_fmt(wdir,sizeof wdir,"%s/prepare-wave-%05d-XXXXXX",state,serial+1)||!mkdtemp(wdir))die("prepare-wave-directory");
  char *v[8+3*PREP_WIDTH];int a=0;v[a++]="sh";v[a++]="-c";v[a++]=(char*)script;v[a++]="prepare-wave";v[a++]=candidate;v[a++]=wdir;
  for(int i=0;i<k;i++){v[a++]=wave[i]->rel;v[a++]=wave[i]->outp;v[a++]=wave[i]->lib?"lib":"bin";}v[a]=0;
  call_timeout_ok=1;np_result r=call("compile-wave",v,0,0,55);call_timeout_ok=0;int timed=r.timed_out,rc=r.rc;np_free(&r);
  if(!timed&&rc)die("prepare-wave-driver-failed");
  const char *bad=0;
  for(int i=0;i<k;i++){struct prep_job *j=wave[i];char sp[4800],h[65],art[65];size_t sn;compiled++;
   if(cx_fmt(sp,sizeof sp,"%s/%d.rc",wdir,i+1))die("prepare-wave-status-path");
   if(sy_exists(sp)!=1){
    if(!timed)die("prepare-wave-status-missing");
    if(k==1){fprintf(stderr,"integrate-patch: REFUSE tool-compile-timeout %s\n",j->rel);exit(2);}
    /* killed at the wave bound while sharing cores: recorded, retried alone under the same 55s bound */
    j->solo=1;prep_set(j->rel,"SOLO","-","-");printf("INTEGRATE_PREPARE_SOLO\ttool=%s\n",j->rel);continue;}
   char *st=load(sp,&sn);int ok=sn==2&&st[0]=='0'&&st[1]=='\n';free(st);
   if(!ok){if(cx_fmt(sp,sizeof sp,"%s/%d.stderr",wdir,i+1))die("prepare-wave-status-path");if(sy_exists(sp)==1){char *es=load(sp,&sn);fwrite(es,1,sn>4000?4000:sn,stderr);free(es);}if(!bad)bad=j->rel;continue;}
   if(sy_exists(j->outp)!=1)die("tool-compile-artifact-missing");
   path(sp,sizeof sp,candidate,j->rel);digest(sp,h);if(strcmp(h,j->src))die("tool-source-changed-during-compile");
   digest(j->outp,art);prep_set(j->rel,"DONE",j->src,art);j->done=1;left--;printf("INTEGRATE_PREPARE_COMPILED\ttool=%s\n",j->rel);
  }
  if(bad){fprintf(stderr,"integrate-patch: REFUSE tool-compile-failed %s\n",bad);exit(2);}
 }
 printf("INTEGRATE_PREPARE\ttools=%d\tskipped=%d\tcompiled=%d\n",nj,skipped,compiled);
}
static void prepare(const char *patch){
 char p[4700],fake[4700],fakearg[4800],envindex[4800];path(p,sizeof p,state,"patch.diff");size_t pn;char *bytes=load(patch,&pn);require_git_diff(bytes,pn);cx_sha256_hex(bytes,pn,patchsha);put(p,bytes,pn);if(cx_fmt(patchorigin,sizeof patchorigin,"%s",patch))die("origin");{char line[4200];if(cx_fmt(line,sizeof line,"%s\n",patchorigin))die("origin-line");material("patch.origin",line,strlen(line));}
 save();
 clone(baseline,"clone-main-snapshot");productcheck(candidate);productcheck(baseline);check_registry_rows(bytes,pn);free(bytes);
 path(fake,sizeof fake,state,"patch.index");if(cx_fmt(fakearg,sizeof fakearg,"--build-fake-ancestor=%s",fake)||cx_fmt(envindex,sizeof envindex,"GIT_INDEX_FILE=%s",fake))die("fake-index-bound");char *env[]={envindex,0};
 char *av[]={"git","-C",candidate,"apply",fakearg,p,0};success("patch-ancestor",av,0,0,15);
 char *b[4]={0},*o[4]={0},*t[4]={0};size_t bn[4]={0},on[4]={0},tn[4]={0};int touched[4]={0},removed[4]={0};
 for(int k=0;k<4;k++){int present;b[k]=indexblob(am_path(k),env,&bn[k],&present);touched[k]=present;int ours;o[k]=indexblob(am_path(k),0,&on[k],&ours);if(!ours){on[k]=strlen(am_header(k));o[k]=strdup(am_header(k));}}
 char *pv[]={"git","-C",candidate,"apply","--cached",p,0};success("patch-side",pv,0,env,15);
 for(int k=0;k<4;k++){int present;t[k]=indexblob(am_path(k),env,&tn[k],&present);removed[k]=b[k]&&!present;if(present)touched[k]=1;if(!b[k]){bn[k]=strlen(am_header(k));b[k]=strdup(am_header(k));}if(!t[k]){tn[k]=strlen(am_header(k));t[k]=strdup(am_header(k));}if(!b[k]||!o[k]||!t[k])die("table-allocation");}
 char *apply[]={"git","-C",candidate,"apply","--3way",p,0};np_result applied=call("apply-threeway",apply,0,0,20);if(applied.rc!=0&&applied.rc!=1)die("patch-apply-failed");int arc=applied.rc;np_free(&applied);int conflicts=0;
 for(int k=0;k<4;k++){if(!touched[k]){free(b[k]);free(o[k]);free(t[k]);continue;}np_buf merged={0},problem={0};char name[100];
  if(cx_fmt(name,sizeof name,"table-%d.base",k))die("material-name");material(name,b[k],bn[k]);if(cx_fmt(name,sizeof name,"table-%d.ours",k))die("material-name");material(name,o[k],on[k]);if(cx_fmt(name,sizeof name,"table-%d.theirs",k))die("material-name");material(name,t[k],tn[k]);
  int rc;if(removed[k]){rc=1;np_puts(&problem,"CONFLICT\ttable-file-deletion-not-an-append\n");}else rc=am_merge(k,b[k],bn[k],o[k],on[k],t[k],tn[k],&merged,&problem);free(b[k]);free(o[k]);free(t[k]);
  if(rc){conflicts++;if(cx_fmt(name,sizeof name,"table-%d.conflicts",k))die("material-name");material(name,problem.p,problem.n);}
  else{char target[4700];path(target,sizeof target,candidate,am_path(k));put(target,merged.p,merged.n);char *add[]={"git","-C",candidate,"add","--",(char*)am_path(k),0};success("stage-table",add,0,0,5);}
  free(merged.p);free(problem.p);
 }
 np_result u=git("conflict-list",candidate,"diff","--name-only","--diff-filter=U",0,0);if(u.rc)die("conflict-query");material("conflicts.paths",u.out?u.out:"",u.outn);if(u.outn)conflicts++;np_free(&u);
 if(conflicts){puts("INTEGRATE_PATCH\tstatus=CONFLICT\tqualification=NOT_QUALIFIED\tmaterials=.git/integrate");exit(1);}
 if(arc){/* Exit one is acceptable only for table conflicts we resolved. */np_result d=git("apply-result",candidate,"diff","--cached","--name-only",0,0);if(d.rc||!d.outn)die("apply-nonzero-without-staged-result");np_free(&d);}
 /* tree frozen: save phase 0 so an exhausted compile budget is a resumable PENDING */
 treeid(tree);phase=0;prep_open=1;save();compile_tools();phase=1;save();
}
static int hasline(const char *s,size_t n,const char *line,size_t ln){for(size_t at=0;at<n;){const char *e=memchr(s+at,'\n',n-at);size_t z=e?(size_t)(e-s-at):n-at;if(z==ln&&!memcmp(s+at,line,z))return 1;at+=z+1;}return 0;}
static int contains(const char *s,size_t n,const char *part){size_t pn=strlen(part);for(size_t i=0;i+pn<=n;i++)if(!memcmp(s+i,part,pn))return 1;return 0;}
static int ratchet_valid(const char *s,size_t n){int count=0,summary=0,expected=-1;const char *names[128];size_t lengths[128];for(size_t at=0;at<n;){const char *e=memchr(s+at,'\n',n-at);if(!e)return 0;size_t z=(size_t)(e-s-at);if(z>8&&!memcmp(s+at,"RATCHET\t",8)){const char *tab=memchr(s+at+8,'\t',z-8);if(!tab||count==128||(!contains(s+at,z,"\tok\t")&&!contains(s+at,z,"\tFAIL\t")))return 0;size_t kn=(size_t)(tab-s-at-8);if(!kn)return 0;for(int i=0;i<count;i++)if(lengths[i]==kn&&!memcmp(names[i],s+at+8,kn))return 0;names[count]=s+at+8;lengths[count++]=kn;}if(z>12&&!memcmp(s+at,"RATCHETS\tok=",12)){char *end;long ok=strtol(s+at+12,&end,10);if(ok<0||ok>128||strncmp(end,"\tfail=",6))return 0;long bad=strtol(end+6,&end,10);if(bad<0||bad>128||end>e||strncmp(end,"\telapsed_ms=",12))return 0;expected=(int)(ok+bad);summary++;}at+=z+1;}return count>0&&count==expected&&summary==1;}
static int gate_present(const char *s,size_t n,const char *name,size_t kn){for(size_t at=0;at<n;){const char *e=memchr(s+at,'\n',n-at);if(!e)return 0;size_t z=(size_t)(e-s-at);if(z>kn+8&&!memcmp(s+at,"RATCHET\t",8)&&!memcmp(s+at+8,name,kn)&&s[at+8+kn]=='\t')return 1;at+=z+1;}return 0;}
static int gate_red_detail(const char *s,size_t n,const char *name,size_t kn,int detail){for(size_t at=0;at<n;){const char *e=memchr(s+at,'\n',n-at);if(!e)return 0;size_t z=(size_t)(e-s-at);if(detail){if(z>kn+2&&s[at]==' '&&s[at+1]==' '&&!memcmp(s+at+2,name,kn)&&s[at+2+kn]==':')return 1;}else if(z>kn+14&&!memcmp(s+at,"RATCHET\t",8)&&!memcmp(s+at+8,name,kn)&&!memcmp(s+at+8+kn,"\tFAIL\t",6))return 1;at+=z+1;}return 0;}
static int ratchet_delta(void){
 char p[4700];size_t bn,hn;path(p,sizeof p,state,"ratchets-base.stdout");char *b=load(p,&bn);path(p,sizeof p,state,"ratchets-head.stdout");char *h=load(p,&hn);np_buf delta={0};
 if(!ratchet_valid(b,bn)||!ratchet_valid(h,hn))die("incomplete-ratchet-report");
 for(size_t at=0;at<bn;){const char *e=memchr(b+at,'\n',bn-at);size_t z=(size_t)(e-b-at);if(z>8&&!memcmp(b+at,"RATCHET\t",8)){const char *tab=memchr(b+at+8,'\t',z-8);if(!gate_present(h,hn,b+at+8,(size_t)(tab-b-at-8)))die("ratchet-gate-removed");}at+=z+1;}
 for(size_t at=0;at<hn;){const char *e=memchr(h+at,'\n',hn-at);size_t z=(size_t)(e-h-at);int red=z>2&&h[at]==' '&&h[at+1]==' ';
  if(z>8&&!memcmp(h+at,"RATCHET\t",8)&&contains(h+at,z,"\tFAIL\t")){const char *tab=memchr(h+at+8,'\t',z-8);size_t kn=(size_t)(tab-h-at-8);const char *name=h+at+8;
   /* A changed total/file-count summary is not new debt when both genuine
    * scans expose the existing failing gate's concrete offending rows. Those
    * rows are compared independently below, with no path exemptions. */
   red=!(gate_red_detail(b,bn,name,kn,0)&&gate_red_detail(b,bn,name,kn,1)&&gate_red_detail(h,hn,name,kn,1));
  }
  if(red&&!hasline(b,bn,h+at,z)){np_put(&delta,h+at,z);np_puts(&delta,"\n");}at+=z+1;
 }
 material("ratchets.new-red",delta.p?delta.p:"",delta.n);int fail=delta.n!=0;free(b);free(h);free(delta.p);return fail;
}
static void ratchets_pair(void){
 char dir[4700];if(cx_fmt(dir,sizeof dir,"%s/ratchets-pair-%05d-XXXXXX",state,serial+1)||!mkdtemp(dir))die("ratchets-pair-directory");
 /* 两个真实扫描各自独立目录和日志；同一有界进程组负责超时清理。 */
 const char *script="(cd \"$1\" && exec sh ./unisacc.com tools/ratchets.cx) >\"$3/base.stdout\" 2>\"$3/base.stderr\" & a=$!\n(cd \"$2\" && exec sh ./unisacc.com tools/ratchets.cx) >\"$3/head.stdout\" 2>\"$3/head.stderr\" & b=$!\nwait \"$a\"; ra=$?\nprintf '%s\\n' \"$ra\" >\"$3/base.status\"\nwait \"$b\"; rb=$?\nprintf '%s\\n' \"$rb\" >\"$3/head.status\"\n[ \"$ra\" -le 1 ] && [ \"$rb\" -le 1 ]";
 /* 基线棘轮缓存:基线输出只由(基线树id, 产品摘要)决定(基线克隆为该树的干净检出),
  * 同键命中且通过ratchet_valid则只跑head侧;未命中或INTEGRATE_NO_RATCHET_CACHE=1走完整双扫并回填。 */
 char cpath[4700]="",cdir[4700];int hit=0;
 if(!getenv("INTEGRATE_NO_RATCHET_CACHE")){char bt[65];np_result tr=git("baseline-tree",baseline,"rev-parse","HEAD^{tree}",0,0,0);text(&tr,bt,sizeof bt);
  char name[300];if(cx_fmt(name,sizeof name,"out/integrate-ratchet-cache/%s-%s.base.stdout",bt,product)||cx_fmt(cdir,sizeof cdir,"%s/out/integrate-ratchet-cache",root)||cx_fmt(cpath,sizeof cpath,"%s/%s",root,name))die("ratchet-cache-path");
  /* INTEGRATE_RATCHET_CACHE_DIR: 显式缓存目录(检查夹具用);未设时保持默认位置 */
  {const char *ce=getenv("INTEGRATE_RATCHET_CACHE_DIR");if(ce&&ce[0]&&(cx_fmt(cdir,sizeof cdir,"%s",ce)||cx_fmt(cpath,sizeof cpath,"%s/%s-%s.base.stdout",ce,bt,product)))die("ratchet-cache-path");}
  if(sy_exists(cpath)==1){size_t cn;char *cs=load(cpath,&cn);if(ratchet_valid(cs,cn)){char bp[5000];path(bp,sizeof bp,dir,"base.stdout");put(bp,cs,cn);hit=1;}free(cs);}}
 const char *headonly="(cd \"$2\" && exec sh ./unisacc.com tools/ratchets.cx) >\"$3/head.stdout\" 2>\"$3/head.stderr\"; rb=$?\nprintf '%s\\n' \"$rb\" >\"$3/head.status\"\n[ \"$rb\" -le 1 ]";
 char *v[]={"sh","-c",(char*)(hit?headonly:script),"ratchets-pair",baseline,candidate,dir,0};np_result r=call("ratchets-pair",v,0,0,55);int rc=r.rc;np_free(&r);if(rc)die("ratchets-pair-not-completed");
 for(int i=0;i<2;i++){char p[5000];size_t n;path(p,sizeof p,dir,i?"head.stdout":"base.stdout");char *s=load(p,&n);if(!ratchet_valid(s,n)){free(s);die("ratchets-error-or-incomplete");}material(phasefiles[i+1],s,n);
  if(!i&&!hit&&cpath[0]){char tmp[4800];char od[4700];if(!cx_fmt(od,sizeof od,"%s/out",root))sy_mkdir(od,0700);sy_mkdir(cdir,0700);if(!cx_fmt(tmp,sizeof tmp,"%s.tmp%d",cpath,(int)sy_now_ms()&0xffff)&&!cx_write(tmp,s,n)&&sy_rename(tmp,cpath))die("ratchet-cache-store");}
  free(s);}
 if(hit)puts("INTEGRATE_PATCH\tratchets-base=CACHE_HIT");
 if(ratchet_delta()){puts("INTEGRATE_PATCH\tstatus=NEW_RATCHET_RED\tqualification=NOT_QUALIFIED");exit(1);}
 for(int i=1;i<=2;i++){char p[4700];path(p,sizeof p,state,phasefiles[i]);digest(p,phasehash[i]);}phase=4;save();
}
static void gates(void){
 /* phase 0: prepare compile step still open; identities are verified before any recorded tool is skipped */
 if(phase==0){prep_open=1;verify();compile_tools();if(stop_pending)return;phase=1;save();}
 if(fake_left<0){const char *fe=getenv("INTEGRATE_PATCH_FAKE_PENDING");fake_left=fe&&fe[0]?atoi(fe):0;}
 if(fake_left>0){fake_left--;pending();if(stop_pending)return;}
 if(getenv("INTEGRATE_PATCH_FAKE_PENDING")&&fake_left==0){printf("INTEGRATE_PATCH\tstatus=READY_TO_COMMIT\tqualification=GATES_ONLY\tfake=1\n");return;}
 for(;phase<6;){if(stop_after&&phase>stop_after){verify();preflight_ok();return;}for(int i=0;i<4&&i<phase-1;i++){char p[4700],h[65];path(p,sizeof p,state,phasefiles[i]);digest(p,h);if(strcmp(h,phasehash[i]))die("completed-phase-output-changed");}verify();if(deadline-sy_now_ms()<((phase==1||phase==3||phase==4)?57000:3000))pending();if(stop_pending)return;
  if(phase==1){char *v[]={"sh","./unisacc.com","tests/run.cx","--","--list",0};np_result r=call("metadata",v,candidate,0,55);int ok=!r.rc&&r.out&&strstr(r.out,"metadata_valid=1");material("metadata.stdout",r.out?r.out:"",r.outn);np_free(&r);if(!ok)die("metadata-invalid");}
  else if(phase==2){ratchets_pair();continue;}
  else if(phase==3){char *v[]={"sh","./unisacc.com","tools/ratchets.cx",0};np_result r=call("ratchets-head",v,candidate,0,55);if(r.rc!=0&&r.rc!=1)die("ratchets-not-completed");if(!ratchet_valid(r.out?r.out:"",r.outn))die("ratchets-error-or-incomplete");material("ratchets-head.stdout",r.out,r.outn);np_free(&r);if(ratchet_delta()){puts("INTEGRATE_PATCH\tstatus=NEW_RATCHET_RED\tqualification=NOT_QUALIFIED");exit(1);}}
  else if(phase==4){char *v[]={"sh","./unisacc.com","tools/precommit.cx",0};np_result r=call("precommit",v,candidate,0,55);int ok=!r.rc&&r.out&&strstr(r.out,"PRECOMMIT\t")&&strstr(r.out,"blocked=0");material("precommit.stdout",r.out?r.out:"",r.outn);np_free(&r);if(!ok){puts("INTEGRATE_PATCH\tstatus=PRECOMMIT_FAILED\tqualification=NOT_QUALIFIED");exit(1);}}
  else if(phase==5){if(ratchet_delta())die("ratchet-delta-changed");verify();run_affected();if(stop_pending)return;if(!stop_after){const char *ready="INTEGRATE_READY1\nstatus\tREADY_TO_COMMIT\nscope\tmetadata-ratchets-precommit-only\npushed\t0\n";material("ready.tsv",ready,strlen(ready));}}
  if(phase<=4){char p[4700];path(p,sizeof p,state,phasefiles[phase-1]);digest(p,phasehash[phase-1]);}
  phase++;save();
 }
 for(int i=0;i<4;i++){char p[4700],h[65];path(p,sizeof p,state,phasefiles[i]);digest(p,h);if(strcmp(h,phasehash[i]))die("completed-phase-output-changed");}verify();
 if(stop_after){preflight_ok();return;}
 {char p[4700];size_t n;path(p,sizeof p,state,"ratchets-base.stdout");char *b=load(p,&n);int oldred=contains(b,n,"\tFAIL\t");free(b);printf("INTEGRATE_PATCH\tstatus=READY_TO_COMMIT\tbase=%s\ttree=%s\tbaseline_red=%s\tpushed=0\tqualification=GATES_ONLY\n",base,tree,oldred?"PRESENT":"NONE");}
 if(want_land)land();
}
static void write_affected_record(void){
 np_buf b={0};np_puts(&b,"AFFECTED_GATE1\npatch\t");np_puts(&b,patchsha);np_puts(&b,"\nbase\t");np_puts(&b,base);np_puts(&b,"\nstatus\tPASS\n");
 material("affected.tsv",b.p,b.n);free(b.p);
}
static void land_require_affected(void){
 char p[4700];size_t n;path(p,sizeof p,state,"affected.tsv");char *s=load(p,&n);
 char want[200];
 if(cx_fmt(want,sizeof want,"AFFECTED_GATE1\npatch\t%s\nbase\t%s\n",patchsha,base))die("affected-want");
 int ok=n>=strlen(want)&&!memcmp(s,want,strlen(want));
 free(s);
 if(!ok)die("land-affected-stale-reopen-gates");
}
static void aff_hdr(char *h,size_t c){if(cx_fmt(h,c,"AFFECTED_DONE1\nbase\t%s\npatch\t%s\nproduct\t%s\ntree\t%s\n",base,patchsha,product,tree))die("aff-hdr");}
/* 本phase已得结论的批次记录；身份头(base/patch/product/tree)变则整体作废 */
static char *aff_load(size_t *n){char p[4700],h[1000];path(p,sizeof p,state,"affected-done.tsv");*n=0;if(sy_exists(p)!=1)return 0;aff_hdr(h,sizeof h);size_t m;char *s=load(p,&m);size_t hl=strlen(h);if(m<hl||memcmp(s,h,hl)||memchr(s,0,m)){free(s);return 0;}*n=m;return s;}
static int aff_done(const char *id){size_t n;char *s=aff_load(&n);if(!s)return 0;char key[100];if(cx_fmt(key,sizeof key,"\n%s\t",id))die("aff-key");int hit=contains(s,n,key);free(s);return hit;}
static void aff_mark(const char *id,const char *status,const char *evidence){size_t n;char *s=aff_load(&n);np_buf b={0};if(s){np_put(&b,s,n);free(s);}else{char h[1000];aff_hdr(h,sizeof h);np_puts(&b,h);}np_puts(&b,id);np_puts(&b,"\t");np_puts(&b,status);np_puts(&b,"\t");np_puts(&b,evidence);np_puts(&b,"\n");material("affected-done.tsv",b.p,b.n);free(b.p);}
/* 返回1表示因预算PENDING已停；测试钩子INTEGRATE_FAKE_AFF_MAX/LOG */
static int aff_loop(char (*ids)[80],int ni){
 const char *fmax=getenv("INTEGRATE_FAKE_AFF_MAX"),*flog=getenv("INTEGRATE_FAKE_AFF_LOG");int fruns=0;
 for(int i=0;i<ni;i++){
  if(aff_done(ids[i])){printf("INTEGRATE_AFFECTED_SKIP\tid=%s\n",ids[i]);continue;}
  if(fmax){if(fruns>=atoi(fmax)){pending();return 1;}fruns++;if(flog){size_t ln=0;char *old=sy_exists(flog)==1?cx_read(flog,&ln):0;np_buf lb={0};if(old){np_put(&lb,old,ln);free(old);}np_puts(&lb,ids[i]);np_puts(&lb,"\n");if(cx_write(flog,lb.p,lb.n))die("fake-log");free(lb.p);}aff_mark(ids[i],"PASS","fake");continue;}
  /* materials are prepared before the batch loop (bounded, cached by identity, never a PASS); INTEGRATE_NO_PREPARE=1 turns it off */
  char *bv[]={"sh","./unisacc.com","tools/affected.cx","--","--ids",ids[i],"--run","--prepare-materials",0};
  {const char *np_off=getenv("INTEGRATE_NO_PREPARE");if(np_off&&np_off[0]=='1')bv[7]=0;}
  np_result br=call("affected-run",bv,candidate,0,55);int rc=br.rc;int red=br.out&&strstr(br.out,"fail=")&&!strstr(br.out,"fail=0");const char *st="PASS";
  if(red&&br.out&&strstr(br.out,"RUN_REFUSED\t")&&strstr(br.out,"requires another native host")&&!strstr(br.out,"status=FAIL")){printf("INTEGRATE_DEFERRED\tid=%s\treason=another-native-host\n",ids[i]);red=0;st="DEFERRED";if(rc==1)rc=0;}
  /* affected rc 3 with only a materials deferral is a stable DEFERRED, not a resumable pending */
  if(rc==3&&!red&&br.out&&strstr(br.out,"DEFERRED\t")&&(strstr(br.out,"needs-materials=")||(strstr(br.out,"prepare-failed=")&&!strstr(br.out,"prebuild-budget")&&!strstr(br.out,"start-deadline")&&!strstr(br.out,"killed-at-deadline")))&&strstr(br.out,"pass=0\tfail=0\t")){printf("INTEGRATE_DEFERRED\tid=%s\treason=needs-materials\n",ids[i]);st="DEFERRED";rc=0;}
  if(rc||red)printf("INTEGRATE_RED\tid=%s\trc=%d\n",ids[i],rc);
  np_free(&br);if(rc==3){pending();return 1;}if(rc||red){puts("INTEGRATE_PATCH\tstatus=AFFECTED_RED\tqualification=NOT_QUALIFIED");exit(1);}
  {char ev[100];if(cx_fmt(ev,sizeof ev,"%03d-affected-run.stdout",serial))die("aff-ev");aff_mark(ids[i],st,ev);}
 }
 return 0;
}
static void run_affected(void){
 { const char *fi=getenv("INTEGRATE_FAKE_AFF_IDS");
   if(fi&&fi[0]){static char fids[32][80];int nf2=0;const char *q=fi;while(*q&&nf2<32){const char *c=strchr(q,',');size_t z=c?(size_t)(c-q):strlen(q);if(z&&z<80){if(mm_copy(fids[nf2],80,q,(long)z))die("fake-id");fids[nf2][z]=0;nf2++;}if(!c)break;q=c+1;}
    if(aff_loop(fids,nf2))return;write_affected_record();return;} }
 np_result d=git("staged-names",candidate,"diff","--cached","--name-only",0,0);if(d.rc)die("staged-names");
 char files[32][400];int nf=0;size_t at=0;
 while(at<d.outn){const char *e=memchr(d.out+at,'\n',d.outn-at);size_t z=e?(size_t)(e-d.out-at):d.outn-at;
  if(z>6&&z<390&&!memcmp(d.out+at,"tools/",6)&&z>9&&!memcmp(d.out+at+z-3,".cx",3)){if(nf==32)die("too-many-tool-files");if(mm_copy(files[nf],400,d.out+at,(long)z))die("name-copy");files[nf][z]=0;nf++;}
  at+=z+1;}
