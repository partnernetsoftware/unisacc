 char *cv[]={"git","clone","--local","--no-checkout",root,candidate,0};if(np_run(cv,0,0,45,&r,why,sizeof why)||r.rc||r.residue){if(r.errn)fwrite(r.err,1,r.errn,stderr);die("create-private-clone");}
