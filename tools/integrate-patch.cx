static void until_done(int maxn){
 int i;if(maxn<1)die("until-done-n");if(maxn>6)maxn=6;until_mode=1;
 for(i=0;i<maxn;i++){deadline=sy_now_ms()+110000;stop_pending=0;gates();if(!stop_pending)return;}
 printf("INTEGRATE_PATCH\tstatus=PENDING\tuntil_done_cap=%d\tqualification=NOT_QUALIFIED\n",maxn);
 printf("INTEGRATE_PATCH\tnext=--resume %s\n",candidate);exit(3);
}
int main(int argc,char **argv){
 deadline=sy_now_ms()+120000;const char *clear[]={"GIT_INDEX_FILE","GIT_DIR","GIT_WORK_TREE","GIT_COMMON_DIR","UNISA_CONTAINER","UNISA_ATTRIBUTES","UNISACC_RF_CAPTURE",0};for(int k=0;clear[k];k++)if(sy_unsetenv(clear[k]))die("ambient-execution-environment");
