   size_t un=u.outn;if(un&&u.out[un-1]=='\n')un--;if(un>=sizeof url){np_free(&u);die("url");}if(mm_copy(url,sizeof url,u.out,(long)un))die("url-copy");url[un]=0;np_free(&u); }
 { char *pv[]={"git","-C",candidate,"push",url,"HEAD:refs/heads/main",0};np_result pr=call("land-push",pv,0,0,20);int prc=pr.rc;np_free(&pr);
   if(prc){char *rb[]={"git","-C",candidate,"reset","--soft","HEAD~1",0};call("land-push-rollback",rb,0,0,12);fprintf(stderr,"integrate-patch: REFUSE land-push-failed-rolled-back\n");exit(2);} }
 { char *fr[]={"git","-C",root,"fetch",url,"main",0};success("land-fetch-shared",fr,0,0,20); }
 { char *nv[]={"git","-C",candidate,"diff-tree","--no-commit-id","--name-only","-r","HEAD",0};
   np_result names=call("land-paths",nv,0,0,12);
   np_result st=git("root-status",root,"status","--porcelain","-uall",0,0);
   const char *q=names.out;size_t qn=names.outn;
   while(q&&qn){const char *nl=memchr(q,'\n',qn);size_t z=nl?(size_t)(nl-q):qn;char rel[400];if(z>=sizeof rel)die("path-long");if(mm_copy(rel,sizeof rel,q,(long)z))die("rel");rel[z]=0;
    int staged=0,dirty=0;const char *s=st.out;size_t sn=st.outn;
    while(s&&sn){const char *e=memchr(s,'\n',sn);size_t lz=e?(size_t)(e-s):sn;if(lz>3){const char *name=s+3;size_t nn=lz-3;if(nn>=2&&name[0]==' '){name++;nn--;}if(nn==z&&!memcmp(name,rel,z)){if(s[0]!=' '&&s[0]!='?')staged=1;if(s[1]!=' '&&s[1]!='?')dirty=1;}}
     if(!e)break;sn-=(size_t)(e-s)+1;s=e+1;}
    if(staged){fprintf(stderr,"integrate-patch: REFUSE land-shared-index-dirty %s\n",rel);exit(2);}
    if(dirty){char *ix[]={"git","-C",root,"update-index","--add","--",rel,0};call("land-index-only",ix,0,0,8);printf("INTEGRATE_PATCH\tpath=%s\tFOREIGN-EDIT\n",rel);}
    else{char *co[]={"git","-C",root,"checkout","-f","FETCH_HEAD","--",rel,0};success("land-checkout",co,0,0,8);printf("INTEGRATE_PATCH\tpath=%s\tsynced\n",rel);}
    if(!nl)break;qn-=z+1;q=nl+1;}
   np_free(&names);np_free(&st); }
 { char *ur[]={"git","-C",root,"update-ref","refs/heads/main","FETCH_HEAD",0};success("land-update-main",ur,0,0,12); }
