 if(aff_loop(ids,ni))return;
 }
 { np_result n=git("smoke-names",candidate,"diff","--cached","--name-only",0,0);if(n.rc)die("smoke-names");
   char *tv[48];int tk=0;tv[tk++]="sh";tv[tk++]="./unisacc.com";tv[tk++]="tools/chain-smoke.cx";tv[tk++]="--";tv[tk++]="--trigger";
   size_t at2=0;int any=0;while(at2<n.outn&&tk<40){const char *e=memchr(n.out+at2,'\n',n.outn-at2);size_t z=e?(size_t)(e-n.out-at2):n.outn-at2;
    if(z&&z<390){static char sm[32][400];int si=any;if(si==32)die("smoke-too-many");if(mm_copy(sm[si],400,n.out+at2,(long)z))die("smoke-copy");sm[si][z]=0;tv[tk++]=sm[si];any++;}
    at2+=z+1;}
