 if(argc==4&&!strcmp(argv[1],"--until-done")){int n=atoi(argv[3]);if(sy_realpath(argv[2],candidate,sizeof candidate)<0)die("candidate-realpath");path(state,sizeof state,candidate,".git/integrate");path(baseline,sizeof baseline,state,"main-snapshot");readreceipt();until_done(n);return 0;}
 if(argc==3&&!strcmp(argv[1],"--test-affected")){if(sy_realpath(argv[2],candidate,sizeof candidate)<0)die("candidate-realpath");path(state,sizeof state,candidate,".git/integrate");readreceipt();run_affected();if(stop_pending)return 3;puts("INTEGRATE_TEST_AFFECTED\tdone=1");return 0;}
 if(argc==3&&!strcmp(argv[1],"--test-prepare")){if(sy_realpath(argv[2],candidate,sizeof candidate)<0)die("candidate-realpath");path(state,sizeof state,candidate,".git/integrate");readreceipt();prep_open=1;compile_tools();if(stop_pending)return 3;if(!phase){phase=1;save();}puts("INTEGRATE_TEST_PREPARE\tdone=1");return 0;}
 if(argc==5&&!strcmp(argv[1],"--resume")&&!strcmp(argv[3],"--stop-after")){stop_after=parse_stop_after(argv[4]);if(sy_realpath(argv[2],candidate,sizeof candidate)<0)die("candidate-realpath");path(state,sizeof state,candidate,".git/integrate");path(baseline,sizeof baseline,state,"main-snapshot");readreceipt();gates();return 0;}
 if(argc==3&&!strcmp(argv[1],"--resume")){if(sy_realpath(argv[2],candidate,sizeof candidate)<0)die("candidate-realpath");path(state,sizeof state,candidate,".git/integrate");path(baseline,sizeof baseline,state,"main-snapshot");readreceipt();gates();return 0;}
 if(argc==4&&!strcmp(argv[1],"--resume")&&!strcmp(argv[3],"--land")){fprintf(stderr,"integrate-patch: REFUSE land-requires --message-file\n");exit(2);}
 if(argc<4||argc>10)die("usage ROOT PATCH NEW_PRIVATE_CLONE [--base REV] [--prepare-only] | --resume CLONE | --land CLONE --message-file F | --until-done CLONE N");const char *rev="refs/heads/main";int prepareonly=0;for(int i=4;i<argc;i++){if(!strcmp(argv[i],"--prepare-only"))prepareonly=1;else if(!strcmp(argv[i],"--land"))want_land=1;else if(!strcmp(argv[i],"--message-file")&&i+1<argc){if(sy_realpath(argv[++i],msgfile,sizeof msgfile)<0)die("message-file");}else if(!strcmp(argv[i],"--base")&&i+1<argc)rev=argv[++i];else if(!strcmp(argv[i],"--stop-after")&&i+1<argc)stop_after=parse_stop_after(argv[++i]);else die("unknown-option");}if(stop_after&&(prepareonly||want_land))die("stop-after-conflicts-with-mode");
 if(sy_realpath(argv[1],root,sizeof root)<0||strpbrk(root,"\t\r\n"))die("root-realpath");char patch[4096];if(sy_realpath(argv[2],patch,sizeof patch)<0)die("patch-realpath");
 char target[4096];if(cx_fmt(target,sizeof target,"%s",argv[3])||target[0]!='/'||strpbrk(target,"\t\r\n"))die("absolute-new-clone-required");char *slash=strrchr(target,'/');if(!slash||!slash[1])die("clone-path");char name[4096],parent[4096];copyfield(name,sizeof name,slash+1);*slash=0;if(!strcmp(name,".")||!strcmp(name,"..")||sy_realpath(*target?target:"/",parent,sizeof parent)<0)die("clone-parent");path(candidate,sizeof candidate,parent,name);if(!strcmp(candidate,root)||(!strncmp(candidate,root,strlen(root))&&candidate[strlen(root)]=='/'))die("source-root-must-remain-read-only");if(sy_exists(candidate)!=0)die("clone-must-not-exist");
