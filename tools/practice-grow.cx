#pragma unisa use mem.grow
#pragma unisa use mem.heap
/* practice-grow.cx: a practice suite that drives mg_buf at its boundaries
   (large growth, move invalidation, take hand-off).  It is a real consumer of
   mem.grow beyond its own check, and it surfaces interface defects when they
   appear.  usage: sh ./unisacc.com tools/practice-grow.cx */
static int bad;
static void ok(int c, const char *n) { printf("%s\t%s\n", c ? "PASS" : "FAIL", n); if (!c) bad = 1; }
int main(void) {
    {
        /* large growth stays O(N) and the boundary byte reads back */
        mg_buf g; long i;
        mg_init(&g);
        for (i = 0; i < 100000; i++) if (mg_push(&g, (i & 255))) bad = 1;
        ok(g.len == 100000, "grow-large");
        ok(g.data[0] == 0 && g.data[99999] == (99999 & 255), "grow-large-content");
        mg_free(&g);
        ok(g.data == 0 && g.len == 0, "grow-large-freed");
    }
    {
        /* move invalidates the source: a later free of the source is a no-op */
        mg_buf a, b;
        mg_init(&a); mg_init(&b);
        mg_append(&a, "xyz", 3);
        ok(mg_move(&b, &a) == 0 && b.len == 3 && a.data == 0, "move-invalidates-source");
        mg_free(&a);
        mg_free(&b);
    }
    {
        /* take hands the block out: the caller becomes the sole owner */
        mg_buf t; unsigned char *p; long n, c;
        mg_init(&t);
        mg_append(&t, "abc", 3);
        ok(mg_take(&t, &p, &n, &c) == 0 && n == 3 && p[0] == 'a' && p[2] == 'c', "take-hands-out");
        ok(t.data == 0 && t.len == 0, "take-zeros-buffer");
        mm_free(p);
    }
    {
        /* pop returns the tail by value and shortens without shrinking */
        mg_buf g; int c;
        mg_init(&g);
        mg_append(&g, "abc", 3);
        ok(mg_pop(&g, &c) == 0 && c == 'c' && g.len == 2, "pop-returns-tail");
        ok(mg_pop(&g, &c) == 0 && c == 'b' && g.len == 1, "pop-again");
        ok(mg_pop(&g, &c) == 0 && c == 'a' && g.len == 0, "pop-last");
        ok(mg_pop(&g, &c) == -1, "pop-empty-refused");
        mg_free(&g);
    }
    {
        /* truncate drops the tail in place (no shrink, O(1)) */
        mg_buf g;
        mg_init(&g);
        mg_append(&g, "abcdef", 6);
        ok(mg_truncate(&g, 3) == 0 && g.len == 3 && g.data[2] == 'c', "truncate-shortens");
        ok(g.cap == 6 || g.cap >= 6, "truncate-no-shrink");
        ok(mg_truncate(&g, -1) == -1 && g.len == 3, "truncate-negative-refused");
        ok(mg_truncate(&g, 9) == -1 && g.len == 3, "truncate-over-refused");
        mg_free(&g);
    }
    {
        /* clear keeps the block so a regrow does not reallocate (Vec::clear) */
        mg_buf g; long cap0;
        mg_init(&g);
        mg_append(&g, "hello", 5);
        cap0 = g.cap;
        ok(mg_clear(&g) == 0 && g.len == 0 && g.data != 0, "clear-drops-bytes");
        ok(g.cap == cap0, "clear-keeps-capacity");
        mg_append(&g, "x", 1);
        ok(g.cap == cap0, "clear-no-realloc-on-regrow");
        mg_free(&g);
    }
    {
        /* insert shifts the tail right and can grow (Vec::insert) */
        mg_buf g;
        mg_init(&g);
        mg_append(&g, "ac", 2);
        ok(mg_insert(&g, 1, 'b') == 0 && g.len == 3 && g.data[0] == 'a' && g.data[1] == 'b' && g.data[2] == 'c', "insert-middle");
        ok(mg_insert(&g, 0, 'Z') == 0 && g.data[0] == 'Z' && g.data[1] == 'a', "insert-head");
        ok(mg_insert(&g, g.len, '!') == 0 && g.data[g.len - 1] == '!', "insert-tail-is-append");
        ok(mg_insert(&g, -1, 'x') == -1 && mg_insert(&g, g.len + 1, 'x') == -1, "insert-bad-index-refused");
        mg_free(&g);
    }
    {
        /* remove shifts the tail left and returns the byte (Vec::remove) */
        mg_buf g; int c;
        mg_init(&g);
        mg_append(&g, "abc", 3);
        ok(mg_remove(&g, 1, &c) == 0 && c == 'b' && g.len == 2 && g.data[0] == 'a' && g.data[1] == 'c', "remove-middle");
        ok(mg_remove(&g, 0, &c) == 0 && c == 'a' && g.len == 1 && g.data[0] == 'c', "remove-head");
        ok(mg_remove(&g, 0, &c) == 0 && c == 'c' && g.len == 0, "remove-last");
        ok(mg_remove(&g, 0, &c) == -1, "remove-empty-refused");
        ok(mg_remove(&g, -1, &c) == -1, "remove-bad-index-refused");
        mg_free(&g);
    }
    printf("PRACTICE_GROW\tfailed=%d\n", bad);
    return bad;
}
