/* check-chain-gen1-smoke.cx -- real-CLI tests for chain-gen1-smoke.cx (GREEN, RED, TIMEOUT, bad-cwd). */
#pragma unisa use sys.fs
#pragma unisa use text.text

static int cs_n;
static int cs_failed;

static void cs_ck(int ok, const char *what) {
    cs_n++;
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", what);
    if (!ok) cs_failed++;
}

static char *cs_read_all(const char *p, size_t *out_n) {
    FILE *f;
    long sz;
    char *b;
    size_t nr;
    *out_n = 0;
    f = fopen(p, "rb");
    if (!f) return 0;
    if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return 0; }
    sz = ftell(f);
    if (sz < 0 || fseek(f, 0, SEEK_SET) != 0) { fclose(f); return 0; }
    b = (char *)malloc((size_t)sz + 1);
    if (!b) { fclose(f); return 0; }
    nr = sz > 0 ? fread(b, 1, (size_t)sz, f) : 0;
    fclose(f);
    b[nr] = 0;
    *out_n = nr;
    return b;
}

static int cs_contains(const char *path, const char *needle) {
    char *buf;
    size_t n;
    size_t nl;
    size_t i;
    int found;
    buf = cs_read_all(path, &n);
    if (!buf) return 0;
    nl = strlen(needle);
    found = 0;
    if (n >= nl) {
        i = 0;
        while (i <= n - nl) {
            if (memcmp(buf + i, needle, nl) == 0) { found = 1; break; }
            i++;
        }
    }
    free(buf);
    return found;
}

int main(void) {
    const char *base;
    char cmd[4096];
    int rc;

    base = "/tmp/v098-gen1-smoke-chk";
    system("rm -rf /tmp/v098-gen1-smoke-chk && mkdir -p /tmp/v098-gen1-smoke-chk/chain_green/gen1/lnx-x86_64 /tmp/v098-gen1-smoke-chk/chain_red/gen1/lnx-x86_64 /tmp/v098-gen1-smoke-chk/chain_timeout");

    /* Seed owner.tsv + mock candidate + mock pkg for GREEN and RED */
    system("printf 'OWNER\\t1\\tabc\\tguard=1\\tpid=2\\tpgid=424242\\tdeadline_s=900\\tchain=bg-b1\\n' > /tmp/v098-gen1-smoke-chk/chain_green/owner.tsv");
    system("cp /tmp/v098-gen1-smoke-chk/chain_green/owner.tsv /tmp/v098-gen1-smoke-chk/chain_red/owner.tsv");
    system("cp /tmp/v098-gen1-smoke-chk/chain_green/owner.tsv /tmp/v098-gen1-smoke-chk/chain_timeout/owner.tsv");
    system("touch /tmp/v098-gen1-smoke-chk/chain_green/compiler.bootstrap.pkg /tmp/v098-gen1-smoke-chk/chain_red/compiler.bootstrap.pkg");

    system("printf '#!/bin/sh\\nwhile [ $# -gt 0 ]; do if [ \"$1\" = \"-o\" ]; then echo x > \"$2\"; exit 0; fi; shift; done\\nexit 0\\n' > /tmp/v098-gen1-smoke-chk/chain_green/gen1/lnx-x86_64/candidate && chmod +x /tmp/v098-gen1-smoke-chk/chain_green/gen1/lnx-x86_64/candidate");
    system("printf '#!/bin/sh\\necho \"reject: not covered: a label defined twice\" >&2\\nexit 1\\n' > /tmp/v098-gen1-smoke-chk/chain_red/gen1/lnx-x86_64/candidate && chmod +x /tmp/v098-gen1-smoke-chk/chain_red/gen1/lnx-x86_64/candidate");

    /* 1. GREEN on shard 0..0 --no-diff */
    cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com tools/chain-gen1-smoke.cx -- --chain-dir %s/chain_green --root . --out %s/out_green --shard-from 0 --shard-to 0 --no-diff >%s/green.log 2>&1", base, base, base);
    rc = system(cmd);
    cs_ck(rc == 0 && cs_contains("/tmp/v098-gen1-smoke-chk/green.log", "GEN1_SMOKE\tGREEN"), "S1-green-real-cli");

    /* 2. RED on mock candidate */
    cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com tools/chain-gen1-smoke.cx -- --chain-dir %s/chain_red --root . --out %s/out_red --shard-from 0 --shard-to 0 --no-diff >%s/red.log 2>&1", base, base, base);
    rc = system(cmd);
    cs_ck(rc != 0 && cs_contains("/tmp/v098-gen1-smoke-chk/red.log", "GEN1_SMOKE\tRED") && cs_contains("/tmp/v098-gen1-smoke-chk/red.log", "pgid=424242") && cs_contains("/tmp/v098-gen1-smoke-chk/red.log", "a label defined twice"), "S2-red-prints-pgid-and-err");

    /* 3. TIMEOUT on empty chain dir */
    cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com tools/chain-gen1-smoke.cx -- --chain-dir %s/chain_timeout --root . --out %s/out_to --wait-s 0 --max-polls 1 >%s/to.log 2>&1", base, base, base);
    rc = system(cmd);
    cs_ck(rc != 0 && cs_contains("/tmp/v098-gen1-smoke-chk/to.log", "GEN1_SMOKE\tTIMEOUT") && cs_contains("/tmp/v098-gen1-smoke-chk/to.log", "pgid=424242"), "S3-timeout-bounded");

    /* 4. Bad cwd (missing ./unisacc.com) */
    rc = system("PWD_ROOT=$(pwd); (cd /tmp && sh \"$PWD_ROOT/unisacc.com\" \"$PWD_ROOT/tools/chain-gen1-smoke.cx\" -- --chain-dir /tmp/v098-gen1-smoke-chk/chain_green --root \"$PWD_ROOT\" --out /tmp/v098-gen1-smoke-chk/out_badcwd) >/tmp/v098-gen1-smoke-chk/badcwd.log 2>&1");
    cs_ck(rc != 0 && cs_contains("/tmp/v098-gen1-smoke-chk/badcwd.log", "cwd missing ./unisacc.com"), "S4-bad-cwd-refused");

    system("rm -rf /tmp/v098-gen1-smoke-chk");
    printf("CHAIN_GEN1_SMOKE_CHECK\tassertions=%d\tfailed=%d\n", cs_n, cs_failed);
    return cs_failed ? 1 : 0;
}
