/* check-chain-gen1-smoke.cx -- real-CLI tests for tools/chain-gen1-smoke.cx. */
#pragma unisa use sys.fs
#pragma unisa use text.text

static int cs_n;
static int cs_failed;

static void cs_ck(int ok, const char *what) {
    cs_n++;
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", what);
    if (!ok) cs_failed++;
}

static char *cs_read_all(const char *p, size_t *out_n) {
    FILE *f;
    long sz;
    char *b;
    size_t nr;
    *out_n = 0;
    f = fopen(p, "rb");
    if (!f) return 0;
    if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return 0; }
    sz = ftell(f);
    if (sz < 0 || fseek(f, 0, SEEK_SET) != 0) { fclose(f); return 0; }
    b = (char *)malloc((size_t)sz + 1);
    if (!b) { fclose(f); return 0; }
    nr = sz > 0 ? fread(b, 1, (size_t)sz, f) : 0;
    fclose(f);
    b[nr] = 0;
    *out_n = nr;
    return b;
}

static int cs_contains(const char *path, const char *needle) {
    char *buf;
    size_t n;
    size_t nl;
    size_t i;
    int found;
    buf = cs_read_all(path, &n);
    if (!buf) return 0;
    nl = strlen(needle);
    found = 0;
    if (n >= nl) {
        i = 0;
        while (i <= n - nl) {
            if (memcmp(buf + i, needle, nl) == 0) { found = 1; break; }
            i++;
        }
    }
    free(buf);
    return found;
}

static int cs_exit_code(int sys_rc) {
    return WIFEXITED(sys_rc) ? WEXITSTATUS(sys_rc) : -1;
}

int main(void) {
    char tmpl[128];
    char *base;
    char cmd[8192];
    char logp[4096];
    int rc;

    cx_fmt(tmpl, sizeof tmpl, "/tmp/cg1s-XXXXXX");
    base = mkdtemp(tmpl);
    if (!base) { printf("FAIL\tmkdtemp\n"); return 1; }

    cx_fmt(cmd, sizeof cmd,
           "mkdir -p %s/c_green/gen1/lnx-x86_64 %s/c_red/gen1/lnx-x86_64 %s/c_sred/gen1/lnx-x86_64 %s/c_to/gen1/lnx-x86_64 %s/c_infra/gen1/lnx-x86_64",
           base, base, base, base, base);
    system(cmd);

    cx_fmt(cmd, sizeof cmd,
           "printf 'OWNER\\t1\\tabc\\tguard=1\\tpid=2\\tpgid=424242\\tdeadline_s=900\\tchain=bg-b1\\n' > %s/c_green/owner.tsv && "
           "cp %s/c_green/owner.tsv %s/c_red/owner.tsv && cp %s/c_green/owner.tsv %s/c_sred/owner.tsv && "
           "cp %s/c_green/owner.tsv %s/c_to/owner.tsv && cp %s/c_green/owner.tsv %s/c_infra/owner.tsv",
           base, base, base, base, base, base, base, base, base);
    system(cmd);

    /* Non-empty pkg for green/red/sred/infra; zero-byte pkg for c_to (S3) */
    cx_fmt(cmd, sizeof cmd,
           "echo pkg > %s/c_green/compiler.bootstrap.pkg && cp %s/c_green/compiler.bootstrap.pkg %s/c_red/compiler.bootstrap.pkg && "
           "cp %s/c_green/compiler.bootstrap.pkg %s/c_sred/compiler.bootstrap.pkg && cp %s/c_green/compiler.bootstrap.pkg %s/c_infra/compiler.bootstrap.pkg && "
           ": > %s/c_to/compiler.bootstrap.pkg && echo cand > %s/c_to/gen1/lnx-x86_64/candidate",
           base, base, base, base, base, base, base, base, base);
    system(cmd);

    /* S1: real compiler wrapper forwarding to ./unisacc.com (ignores --models), compiling shard 0 */
    cx_fmt(cmd, sizeof cmd,
           "printf '#!/bin/sh\\nif [ \"$1\" = \"--models\" ]; then shift 2; fi\\nexec ./unisacc.com \"$@\"\\n' > %s/c_green/gen1/lnx-x86_64/candidate && "
           "chmod +x %s/c_green/gen1/lnx-x86_64/candidate && cp %s/c_green/gen1/lnx-x86_64/candidate %s/c_infra/gen1/lnx-x86_64/candidate",
           base, base, base, base);
    system(cmd);

    /* S2: quick-smoke red */
    cx_fmt(cmd, sizeof cmd,
           "printf '#!/bin/sh\\necho \"reject: not covered: a label defined twice\" >&2\\nexit 1\\n' > %s/c_red/gen1/lnx-x86_64/candidate && chmod +x %s/c_red/gen1/lnx-x86_64/candidate",
           base, base);
    system(cmd);

    /* S5: quick-smoke passes (-b lnx/x86_64), shard compile passes 1st file then fails 2nd (-c) */
    cx_fmt(cmd, sizeof cmd,
           "printf '#!/bin/sh\\nis_c=0; out=\"\"\\nwhile [ $# -gt 0 ]; do if [ \"$1\" = \"-c\" ]; then is_c=1; fi; if [ \"$1\" = \"-o\" ]; then out=\"$2\"; fi; shift; done\\nif [ \"$is_c\" = \"1\" ]; then case \"$out\" in *0000.o) echo x > \"$out\"; exit 0 ;; *) echo \"reject: shard0\" >&2; exit 1 ;; esac; fi\\nexit 0\\n' > %s/c_sred/gen1/lnx-x86_64/candidate && chmod +x %s/c_sred/gen1/lnx-x86_64/candidate",
           base, base);
    system(cmd);

    /* S1 */
    cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com tools/chain-gen1-smoke.cx -- --chain-dir %s/c_green --root . --out %s/o1 --shard-from 0 --shard-to 0 --no-diff >%s/s1.log 2>&1", base, base, base);
    rc = cs_exit_code(system(cmd));
    cx_fmt(logp, sizeof logp, "%s/s1.log", base);
    cs_ck(rc == 0 && cs_contains(logp, "GEN1_SMOKE\tGREEN"), "S1-green-real-compiler");

    /* S2 */
    cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com tools/chain-gen1-smoke.cx -- --chain-dir %s/c_red --root . --out %s/o2 --shard-from 0 --shard-to 0 --no-diff >%s/s2.log 2>&1", base, base, base);
    rc = cs_exit_code(system(cmd));
    cx_fmt(logp, sizeof logp, "%s/s2.log", base);
    cs_ck(rc == 1 && cs_contains(logp, "GEN1_SMOKE\tRED") && cs_contains(logp, "pgid=424242") && cs_contains(logp, "a label defined twice"), "S2-red-prints-pgid-and-err");

    /* S3: zero-byte pkg -> TIMEOUT missing=pkg, rc=2 */
    cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com tools/chain-gen1-smoke.cx -- --chain-dir %s/c_to --root . --out %s/o3 --wait-s 0 --max-polls 1 >%s/s3.log 2>&1", base, base, base);
    rc = cs_exit_code(system(cmd));
    cx_fmt(logp, sizeof logp, "%s/s3.log", base);
    cs_ck(rc == 2 && cs_contains(logp, "GEN1_SMOKE\tTIMEOUT") && cs_contains(logp, "missing=pkg") && cs_contains(logp, "pgid=424242"), "S3-timeout-zero-pkg");

    /* S4: bad cwd -> rc=2 */
    cx_fmt(cmd, sizeof cmd, "PWD_ROOT=$(pwd); (cd /tmp && sh \"$PWD_ROOT/unisacc.com\" \"$PWD_ROOT/tools/chain-gen1-smoke.cx\" -- --chain-dir %s/c_green --root \"$PWD_ROOT\" --out %s/o4) >%s/s4.log 2>&1", base, base, base);
    rc = cs_exit_code(system(cmd));
    cx_fmt(logp, sizeof logp, "%s/s4.log", base);
    cs_ck(rc == 2 && cs_contains(logp, "cwd missing ./unisacc.com"), "S4-bad-cwd-refused");

    /* S5: shard red -> rc=1 and err=FAIL ... */
    cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com tools/chain-gen1-smoke.cx -- --chain-dir %s/c_sred --root . --out %s/o5 --shard-from 0 --shard-to 0 --no-diff >%s/s5.log 2>&1", base, base, base);
    rc = cs_exit_code(system(cmd));
    cx_fmt(logp, sizeof logp, "%s/s5.log", base);
    cs_ck(rc == 1 && cs_contains(logp, "GEN1_SMOKE\tRED\tshard=0") && cs_contains(logp, "err=FAIL ") && cs_contains(logp, ".stderr\n"), "S5-shard-red-rc");

    /* S6: --dry-shards computes total_shards dynamically */
    cx_fmt(cmd, sizeof cmd, "N=$(sh ./unisacc.com tests/tools-compile.cx -- --shards .); sh ./unisacc.com tools/chain-gen1-smoke.cx -- --chain-dir %s/c_green --root . --out %s/o6 --dry-shards | grep -q \"total_shards=$N\"", base, base);
    rc = cs_exit_code(system(cmd));
    cs_ck(rc == 0, "S6-shards-computed");

    /* S7: bad root fails shard query -> rc=2 ERROR msg= */
    cx_fmt(cmd, sizeof cmd, "mkdir -p %s/badroot/tests && cp tests/tools-compile.cx tests/tools-compile-sources.tsv %s/badroot/tests/ && sh ./unisacc.com tools/chain-gen1-smoke.cx -- --chain-dir %s/c_infra --root %s/badroot --out %s/o7 >%s/s7.log 2>&1", base, base, base, base, base, base);
    rc = cs_exit_code(system(cmd));
    cx_fmt(logp, sizeof logp, "%s/s7.log", base);
    cs_ck(rc == 2 && cs_contains(logp, "GEN1_SMOKE\tERROR\tmsg="), "S7-badroot-error-msg");

    /* S8: bad --par 0 and x -> rc=2 ERROR msg= */
    cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com tools/chain-gen1-smoke.cx -- --chain-dir %s/c_green --root . --out %s/o8a --par 0 >%s/s8a.log 2>&1", base, base, base);
    rc = cs_exit_code(system(cmd));
    cx_fmt(logp, sizeof logp, "%s/s8a.log", base);
    {
        int ok8a;
        ok8a = (rc == 2 && cs_contains(logp, "GEN1_SMOKE\tERROR\tmsg="));
        cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com tools/chain-gen1-smoke.cx -- --chain-dir %s/c_green --root . --out %s/o8b --par x >%s/s8b.log 2>&1", base, base, base);
        rc = cs_exit_code(system(cmd));
        cx_fmt(logp, sizeof logp, "%s/s8b.log", base);
        cs_ck(ok8a && rc == 2 && cs_contains(logp, "GEN1_SMOKE\tERROR\tmsg="), "S8-bad-par-refused");
    }

    /* S9: missing chain-dir or root -> rc=2 ERROR msg= */
    cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com tools/chain-gen1-smoke.cx -- --chain-dir %s/no_such --root . --out %s/o9a >%s/s9a.log 2>&1", base, base, base);
    rc = cs_exit_code(system(cmd));
    cx_fmt(logp, sizeof logp, "%s/s9a.log", base);
    {
        int ok9a;
        ok9a = (rc == 2 && cs_contains(logp, "GEN1_SMOKE\tERROR\tmsg="));
        cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com tools/chain-gen1-smoke.cx -- --chain-dir %s/c_green --root %s/no_such --out %s/o9b >%s/s9b.log 2>&1", base, base, base, base);
        rc = cs_exit_code(system(cmd));
        cx_fmt(logp, sizeof logp, "%s/s9b.log", base);
        cs_ck(ok9a && rc == 2 && cs_contains(logp, "GEN1_SMOKE\tERROR\tmsg="), "S9-missing-chain-or-root");
    }

    /* S10: inner tools-compile rc=2 (existing out dir) -> INFRA rc=2 */
    cx_fmt(cmd, sizeof cmd, "mkdir -p %s/o10/new_s0 && sh ./unisacc.com tools/chain-gen1-smoke.cx -- --chain-dir %s/c_green --root . --out %s/o10 --shard-from 0 --shard-to 0 --no-diff >%s/s10.log 2>&1", base, base, base, base);
    rc = cs_exit_code(system(cmd));
    cx_fmt(logp, sizeof logp, "%s/s10.log", base);
    cs_ck(rc == 2 && cs_contains(logp, "GEN1_SMOKE\tINFRA\tshard=0") && cs_contains(logp, "err=tools-compile:"), "S10-inner-rc2-infra");

    cx_fmt(cmd, sizeof cmd, "rm -rf %s", base);
    system(cmd);
    printf("CHAIN_GEN1_SMOKE_CHECK\tassertions=%d\tfailed=%d\n", cs_n, cs_failed);
    return cs_failed ? 1 : 0;
}
