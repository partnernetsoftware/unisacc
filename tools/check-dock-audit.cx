/* tools/check-dock-audit.cx -- build/dock-audit.tsv against tools/dock-map.cx.
 *
 *   sh ./unisacc.com tools/check-dock-audit.cx            check (rc 1 on any FAIL)
 *   sh ./unisacc.com tools/check-dock-audit.cx -- --write  rewrite the table: existing rows kept,
 *                                                          missing dock files get an UNAUDITED row,
 *                                                          rows of files no longer docked are dropped
 *
 * Fact table: build/dock-audit.tsv, columns  path  module(0|1)  kind(bare|include|libc)  auditor  reason.
 * Fact source: `tools/dock-map.cx --tracked` (every tracked .cx with `#pragma unisa dock`).
 * One audit row per docked file; module=0 rows are docked scripts the module rule does not ask,
 * still audited.  Assertions:
 *   A1 audit rows == dock-map docked count      A2 every docked file has a row
 *   A3 no row for a file that is not docked     A4 no duplicate path
 *   A5 module column matches dock-map           A6 kind column matches the file's pragma
 *   A7 every row has 5 fields, auditor and reason non-empty
 * Ends with DOCK_AUDIT_CHECK<TAB>assertions=N<TAB>failed=M<TAB>docked=D<TAB>rows=R<TAB>unaudited=U.
 */
#pragma unisa use sysx.process
#pragma unisa use text.text
#pragma unisa use mem.bytes

#define DA_MAX 4096
static char *da_path[DA_MAX]; static int da_mod[DA_MAX]; static const char *da_kind[DA_MAX];
static int da_nd;
static char *da_rpath[DA_MAX]; static char *da_rline[DA_MAX]; static int da_nr;
static int da_failed, da_n;

static void da_die(const char *s) { fprintf(stderr, "check-dock-audit: %s\n", s); exit(2); }
static void da_ck(int ok, const char *what) {
    da_n++;
    if (!ok) { da_failed++; printf("FAIL\t%s\n", what); }
}

static char *da_dup(const char *s, long n) {
    char *m = malloc((size_t)n + 1);
    if (!m) da_die("allocation");
    if (mm_copy(m, n + 1, s, n)) da_die("copy");
    m[n] = 0;
    return m;
}

/* Field K (0 = the tag) of a TAB-separated line; 0 when absent. */
static char *da_field(char *p, int k) {
    while (k > 0) {
        p = strchr(p, '\t');
        if (!p) return 0;
        p++; k--;
    }
    return p;
}

static const char *da_kind_of(const char *b, long n) {
    long i;
    for (i = 0; i + 8 < n; i++) {
        long j;
        if (b[i] != '#' || memcmp(b + i + 1, "pragma", 6)) continue;
        j = i + 7;
        while (j < n && (b[j] == ' ' || b[j] == '\t')) j++;
        if (j + 5 > n || memcmp(b + j, "unisa", 5)) continue;
        j += 5;
        while (j < n && (b[j] == ' ' || b[j] == '\t')) j++;
        if (j + 4 > n || memcmp(b + j, "dock", 4)) continue;
        if (j + 4 < n && b[j + 4] >= 'a' && b[j + 4] <= 'z') continue;
        j += 4;
        while (j < n && (b[j] == ' ' || b[j] == '\t')) j++;
        if (j + 7 <= n && !memcmp(b + j, "include", 7)) return "include";
        if (j + 4 <= n && !memcmp(b + j, "libc", 4)) return "libc";
        return "bare";
    }
    return "bare";
}

int main(int argc, char **argv) {
    np_result r; char why[512];
    char *av[] = { "sh", "unisacc.com", "tools/dock-map.cx", "--", "--tracked", 0 };
    int write = argc > 1 && !strcmp(argv[1], "--write");
    long at, on, docked_sum = -1, unaudited = 0;
    size_t tn = 0; char *tab; int i, j;

    if (np_run(av, ".", 0, 50, &r, why, sizeof why)) da_die(why);
    if (r.rc) { np_free(&r); da_die("dock-map failed"); }
    for (at = 0, on = (long)r.outn; at < on; ) {
        char *p = r.out + at; long e = at;
        while (e < on && r.out[e] != '\n') e++;
        r.out[e] = 0; at = e + 1;
        if (!strncmp(p, "DOCKMAP_TAB", 11)) {
            char *d = da_field(p, 4);
            if (d && !strncmp(d, "docked=", 7)) docked_sum = atol(d + 7);
        } else if (!strncmp(p, "DOCKMAP\t", 8) && da_field(p, 4) && !strncmp(da_field(p, 4), "dock=1", 6)) {
            char *q = p + 8, *t = strchr(q, '\t'); size_t n = 0; char *src;
            if (!t || da_nd >= DA_MAX) da_die("map row");
            da_path[da_nd] = da_dup(q, t - q);
            da_mod[da_nd] = !strncmp(da_field(p, 2), "module=1", 8);
            src = cx_read(da_path[da_nd], &n);
            if (!src) da_die(da_path[da_nd]);
            da_kind[da_nd] = da_kind_of(src, (long)n); free(src);
            da_nd++;
        }
    }
    np_free(&r);

    tab = cx_read("build/dock-audit.tsv", &tn);
    if (tab) {
        long p = 0;
        while (p < (long)tn) {
            long e = p; char *t;
            while (e < (long)tn && tab[e] != '\n') e++;
            if (e > p && tab[p] != '#' && strncmp(tab + p, "path\t", 5)) {
                if (da_nr >= DA_MAX) da_die("table size");
                da_rline[da_nr] = da_dup(tab + p, e - p);
                t = strchr(da_rline[da_nr], '\t');
                da_rpath[da_nr] = da_dup(da_rline[da_nr], t ? t - da_rline[da_nr] : (long)strlen(da_rline[da_nr]));
                da_nr++;
            }
            p = e + 1;
        }
        free(tab);
    }

    if (write) {
        FILE *f = fopen("build/dock-audit.tsv", "wb");
        if (!f) da_die("open build/dock-audit.tsv");
        fputs("path\tmodule\tkind\tauditor\treason\n", f);
        for (i = 0; i < da_nd; i++) {
            int found = -1;
            for (j = 0; j < da_nr; j++) if (!strcmp(da_rpath[j], da_path[i])) { found = j; break; }
            if (found >= 0) fprintf(f, "%s\n", da_rline[found]);
            else fprintf(f, "%s\t%d\t%s\tUNAUDITED\tnot yet audited (seeded from dock-map)\n", da_path[i], da_mod[i], da_kind[i]);
        }
        fclose(f);
        printf("DOCK_AUDIT_WRITE\trows=%d\n", da_nd);
        return 0;
    }

    da_ck(da_nr == da_nd, "A1-rows-equal-docked-count");
    da_ck(docked_sum == da_nd && docked_sum == da_nr, "A1b-summary-docked-equals-rows");
    for (i = 0; i < da_nd; i++) {
        int found = -1;
        for (j = 0; j < da_nr; j++) if (!strcmp(da_rpath[j], da_path[i])) { found = j; break; }
        if (found < 0) { da_ck(0, da_path[i]); continue; }
        {   char *f[5]; char *c = da_rline[found]; int k = 0, ok = 1;
            f[k++] = c;
            while (*c && k < 5) { if (*c == '\t') { *c = 0; f[k++] = c + 1; } c++; }
            if (k != 5 || strchr(f[4], '\t') || !f[3][0] || !f[4][0]) { ok = 0; }
            da_ck(ok, "A7-row-shape");
            if (ok) {
                da_ck(atoi(f[1]) == da_mod[i], "A5-module-column");
                da_ck(!strcmp(f[2], da_kind[i]), "A6-kind-column");
                if (!strcmp(f[3], "UNAUDITED")) unaudited++;
            }
        }
    }
    for (j = 0; j < da_nr; j++) {
        int hit = 0, dup = 0;
        for (i = 0; i < da_nd; i++) if (!strcmp(da_rpath[j], da_path[i])) hit = 1;
        for (i = 0; i < j; i++) if (!strcmp(da_rpath[j], da_rpath[i])) dup = 1;
        da_ck(hit, "A3-row-has-docked-file");
        da_ck(!dup, "A4-no-duplicate-path");
    }
    printf("DOCK_AUDIT_CHECK\tassertions=%d\tfailed=%d\tdocked=%d\trows=%d\tunaudited=%ld\n",
           da_n, da_failed, da_nd, da_nr, unaudited);
    return da_failed ? 1 : 0;
}
