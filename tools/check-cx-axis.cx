#pragma unisa use compiler.osname
#pragma unisa use runtime.osname
#pragma unisa use compiler.archname
#pragma unisa use runtime.archname
#pragma unisa use sys.io
#pragma unisa use text.text
/* Generated by tools/axis-gen.cx. Narrow check of os and arch names. */
int main(void) {
    const char *name;
    const char **missing;
    missing = 0;
    if (osn_count() != 3) return 1;
    if (osn_at(0, &name) || !tx_eqz(name, "lnx")) return 1;
    if (osn_at(1, &name) || !tx_eqz(name, "osx")) return 1;
    if (osn_at(2, &name) || !tx_eqz(name, "win")) return 1;
    if (osn_at(0, missing) != 4) return 1;
    if (osn_at(-1, &name) != 2) return 1;
    if (osn_at(3, &name) != 2) return 1;
    if (rsn_count() != 3) return 1;
    if (rsn_at(0, &name) || !tx_eqz(name, "lnx")) return 1;
    if (rsn_at(1, &name) || !tx_eqz(name, "osx")) return 1;
    if (rsn_at(2, &name) || !tx_eqz(name, "win")) return 1;
    if (rsn_at(0, missing) != 4) return 1;
    if (rsn_at(-1, &name) != 2) return 1;
    if (rsn_at(3, &name) != 2) return 1;
    if (arc_count() != 2) return 1;
    if (arc_at(0, &name) || !tx_eqz(name, "x86_64")) return 1;
    if (arc_at(1, &name) || !tx_eqz(name, "arm64")) return 1;
    if (arc_at(0, missing) != 4) return 1;
    if (arc_at(-1, &name) != 2) return 1;
    if (arc_at(2, &name) != 2) return 1;
    if (rarc_count() != 2) return 1;
    if (rarc_at(0, &name) || !tx_eqz(name, "x86_64")) return 1;
    if (rarc_at(1, &name) || !tx_eqz(name, "arm64")) return 1;
    if (rarc_at(0, missing) != 4) return 1;
    if (rarc_at(-1, &name) != 2) return 1;
    if (rarc_at(2, &name) != 2) return 1;
    sy_printf("CX_OS\tok=3\tfailed=0\n");
    sy_printf("CX_ARCH\tok=2\tfailed=0\n");
    return 0;
}
