#pragma unisa use sys.io
#pragma unisa use text.text
/* Project exec/c/compiler-routes.tsv onto the compiler and runtime route tables.
   sh ./unisacc.com tools/route-gen.cx -- --check
   sh ./unisacc.com tools/route-gen.cx -- --write
   The fact table is the only name list. A row is suffix, last stage, optimiser.
   A suffix may contain '/' and uppercase, so it is a string, not a file stem.
   Exactly ten data rows. A null out-pointer returns 4.
   An index outside 0..count-1 returns 2.
   No libc and no include. */
#define TSV "exec/c/compiler-routes.tsv"
#define NROUTE 10
#define NAMEMAX 32
#define FILECAP 4096
#define CHECKCAP 8192

typedef struct {
    char suffix[NAMEMAX];
    char stage[NAMEMAX];
    char opt[NAMEMAX];
} Row;

static Row rows[NROUTE];
static int nrows;

static int fail(const char *why) {
    sy_eprintf("route-gen\tFAIL\t%s\n", why);
    return 1;
}

static int field_ok(const char *s, int n) {
    int i;
    if (n < 1 || n >= NAMEMAX) return 0;
    for (i = 0; i < n; i++) {
        char c = s[i];
        if (c >= 'a' && c <= 'z') continue;
        if (c >= 'A' && c <= 'Z') continue;
        if (c >= '0' && c <= '9') continue;
        if (c == '/') continue;
        return 0;
    }
    return 1;
}

static void copy_field(char *dst, const char *s, int n) {
    int i;
    for (i = 0; i < n; i++) dst[i] = s[i];
    dst[n] = 0;
}

static int take_row(const char *line, int n) {
    const char *f[3];
    int len[3];
    int i, k, start;
    if (nrows >= NROUTE) return fail("route-count");
    k = 0;
    start = 0;
    for (i = 0; i <= n; i++) {
        if (i == n || line[i] == '\t') {
            if (k >= 3) return fail("row-fields");
            f[k] = line + start;
            len[k] = i - start;
            k++;
            start = i + 1;
        }
    }
    if (k != 3) return fail("row-fields");
    for (i = 0; i < 3; i++) if (!field_ok(f[i], len[i])) return fail("row-charset");
    copy_field(rows[nrows].suffix, f[0], len[0]);
    copy_field(rows[nrows].stage, f[1], len[1]);
    copy_field(rows[nrows].opt, f[2], len[2]);
    nrows++;
    return 0;
}

static int parse_tsv(char *b, size_t n) {
    size_t i = 0;
    int saw = 0;
    if (n == 0 || b[n - 1] != '\n') return fail("tsv-newline");
    while (i < n) {
        size_t e = i;
        while (e < n && b[e] != '\n') e++;
        b[e] = 0;
        if (e == i) return fail("tsv-blank");
        if (!saw) {
            if (!tx_eqz(b + i, "# route suffix\tlast stage\toptimiser")) return fail("tsv-header");
            saw = 1;
        } else if (b[i] == '#') {
            return fail("tsv-comment");
        } else if (take_row(b + i, (int)(e - i))) {
            return 1;
        }
        i = e + 1;
    }
    if (nrows != NROUTE) return fail("route-count");
    return 0;
}

static int unique_suffix(void) {
    int i, j;
    for (i = 0; i < nrows; i++) {
        for (j = i + 1; j < nrows; j++) {
            if (tx_eqz(rows[i].suffix, rows[j].suffix)) return fail("suffix-dup");
        }
    }
    return 0;
}

static int app(char *dst, int cap, int *n, const char *s) {
    int i = 0;
    while (s[i]) {
        if (*n + 1 >= cap) return -1;
        dst[*n] = s[i];
        *n += 1;
        i++;
    }
    dst[*n] = 0;
    return 0;
}

static int app_n(char *dst, int cap, int *n, int d) {
    char s[4];
    int k = 0;
    if (d < 0 || d > 99) return -1;
    if (d >= 10) s[k++] = (char)('0' + d / 10);
    s[k++] = (char)('0' + d % 10);
    s[k] = 0;
    return app(dst, cap, n, s);
}

static int emit_mod(char *dst, int cap, const char *prefix) {
    int n = 0, i;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa module routename\n")) return -1;
    if (app(dst, cap, &n, "/* Generated by tools/route-gen.cx from exec/c/compiler-routes.tsv.\n")) return -1;
    if (app(dst, cap, &n, "   Do not edit by hand. Columns are suffix, last stage, optimiser.\n")) return -1;
    if (app(dst, cap, &n, "   A null out-pointer returns 4. An index outside 0..count-1 returns 2.\n")) return -1;
    if (app(dst, cap, &n, "   No libc and no include. */\n")) return -1;
    if (app(dst, cap, &n, "int ")) return -1;
    if (app(dst, cap, &n, prefix)) return -1;
    if (app(dst, cap, &n, "_count(void) {\n    return ")) return -1;
    if (app_n(dst, cap, &n, nrows)) return -1;
    if (app(dst, cap, &n, ";\n}\n")) return -1;
    if (app(dst, cap, &n, "int ")) return -1;
    if (app(dst, cap, &n, prefix)) return -1;
    if (app(dst, cap, &n, "_at(int index, const char **suffix, const char **stage, const char **opt) {\n")) return -1;
    if (app(dst, cap, &n, "    if (!suffix || !stage || !opt) return 4;\n")) return -1;
    for (i = 0; i < nrows; i++) {
        if (app(dst, cap, &n, "    if (index == ")) return -1;
        if (app_n(dst, cap, &n, i)) return -1;
        if (app(dst, cap, &n, ") { *suffix = \"")) return -1;
        if (app(dst, cap, &n, rows[i].suffix)) return -1;
        if (app(dst, cap, &n, "\"; *stage = \"")) return -1;
        if (app(dst, cap, &n, rows[i].stage)) return -1;
        if (app(dst, cap, &n, "\"; *opt = \"")) return -1;
        if (app(dst, cap, &n, rows[i].opt)) return -1;
        if (app(dst, cap, &n, "\"; return 0; }\n")) return -1;
    }
    if (app(dst, cap, &n, "    return 2;\n}\n")) return -1;
    return n;
}

static int emit_row(char *dst, int cap, int *n, const char *prefix, int i) {
    if (app(dst, cap, n, "    if (")) return -1;
    if (app(dst, cap, n, prefix)) return -1;
    if (app(dst, cap, n, "_at(")) return -1;
    if (app_n(dst, cap, n, i)) return -1;
    if (app(dst, cap, n, ", &suffix, &stage, &opt) || !tx_eqz(suffix, \"")) return -1;
    if (app(dst, cap, n, rows[i].suffix)) return -1;
    if (app(dst, cap, n, "\") || !tx_eqz(stage, \"")) return -1;
    if (app(dst, cap, n, rows[i].stage)) return -1;
    if (app(dst, cap, n, "\") || !tx_eqz(opt, \"")) return -1;
    if (app(dst, cap, n, rows[i].opt)) return -1;
    if (app(dst, cap, n, "\")) return 1;\n")) return -1;
    return 0;
}

static int emit_check(char *dst, int cap) {
    int n = 0, i;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa use compiler.routename\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use runtime.routename\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use sys.io\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use text.text\n")) return -1;
    if (app(dst, cap, &n, "/* Generated by tools/route-gen.cx. Narrow check of the ten route rows. */\n")) return -1;
    if (app(dst, cap, &n, "int main(void) {\n")) return -1;
    if (app(dst, cap, &n, "    const char *suffix; const char *stage; const char *opt;\n")) return -1;
    if (app(dst, cap, &n, "    const char **missing;\n")) return -1;
    if (app(dst, cap, &n, "    missing = 0;\n")) return -1;
    if (app(dst, cap, &n, "    if (rn_count() != 10) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rrn_count() != 10) return 1;\n")) return -1;
    for (i = 0; i < nrows; i++) {
        if (emit_row(dst, cap, &n, "rn", i)) return -1;
        if (emit_row(dst, cap, &n, "rrn", i)) return -1;
    }
    if (app(dst, cap, &n, "    if (rn_at(0, missing, &stage, &opt) != 4) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rn_at(0, &suffix, missing, &opt) != 4) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rn_at(0, &suffix, &stage, missing) != 4) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rrn_at(0, missing, &stage, &opt) != 4) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rrn_at(0, &suffix, missing, &opt) != 4) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rrn_at(0, &suffix, &stage, missing) != 4) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rn_at(-1, &suffix, &stage, &opt) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rn_at(10, &suffix, &stage, &opt) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rrn_at(-1, &suffix, &stage, &opt) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    if (rrn_at(10, &suffix, &stage, &opt) != 2) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    sy_printf(\"CX_ROUTE\\tok=10\\tfailed=0\\n\");\n")) return -1;
    if (app(dst, cap, &n, "    return 0;\n}\n")) return -1;
    return n;
}

static int same_bytes(const char *a, size_t an, const char *b, int bn) {
    int i;
    if (an != (size_t)bn) return 0;
    for (i = 0; i < bn; i++) if (a[i] != b[i]) return 0;
    return 1;
}

static int one_file(int dowrite, const char *path, const char *body, int n) {
    size_t on = 0;
    char *cur;
    if (dowrite) {
        if (cx_write(path, body, (size_t)n)) return fail("write");
        return 0;
    }
    cur = cx_read(path, &on);
    if (!cur) return fail(path);
    if (!same_bytes(cur, on, body, n)) return fail(path);
    return 0;
}

int main(int argc, char **argv) {
    size_t nb = 0;
    char *b;
    char file[FILECAP], check[CHECKCAP];
    int dowrite, fn, cn;
    if (argc != 2 || (!tx_eqz(argv[1], "--check") && !tx_eqz(argv[1], "--write"))) {
        sy_eprintf("route-gen\tusage\t--check|--write\n");
        return 2;
    }
    dowrite = tx_eqz(argv[1], "--write");
    b = cx_read(TSV, &nb);
    if (!b) return fail("tsv-read");
    if (parse_tsv(b, nb)) return 1;
    if (unique_suffix()) return 1;
    cn = emit_check(check, CHECKCAP);
    if (cn < 0) return fail("emit-check");
    fn = emit_mod(file, FILECAP, "rn");
    if (fn < 0) return fail("emit-compiler");
    if (one_file(dowrite, "cx/compiler/routename.cx", file, fn)) return 1;
    fn = emit_mod(file, FILECAP, "rrn");
    if (fn < 0) return fail("emit-runtime");
    if (one_file(dowrite, "cx/runtime/routename.cx", file, fn)) return 1;
    if (one_file(dowrite, "tools/check-cx-route.cx", check, cn)) return 1;
    if (dowrite) sy_printf("ROUTE_GEN\tWROTE\trows=%d\n", nrows);
    else sy_printf("ROUTE_GEN\tCHECK\trows=%d\n", nrows);
    return 0;
}
