/* tools/check-commit-own.cx -- tools/commit-own.cx keeps the shared index in sync even when another git process
 * holds .git/index.lock (an agent's git status refreshes the index).  Before the fix, update-index failed silently
 * and a NEW file showed up as `D  path` plus `?? path` right after the commit (penoff, macbyt).
 *
 *   sh ./unisacc.com tools/check-commit-own.cx            (from the repo root; works in out/check-commit-own/)
 *   sh ./unisacc.com tools/check-commit-own.cx -- --cases a|b
 *
 * In a throwaway local clone with a copy of the working-tree commit-own.cx and the installed unisacc.com:
 *   lock    a new file is committed while .git/index.lock is held for 4 s: COMMIT_OWN says index_unsynced=0, the
 *           file's index entry is the committed blob and git status shows nothing for it;
 *   nolock  the same without a lock, as a control.
 * --cases splits the set in two, because one batch has 55 s and the whole set costs ~69 s of git work on top of
 * the native builds: a = nolock/symlink/dirlink/keyed, b = lock/registered.  Both halves keep every assertion the
 * whole run made, and the artifact cases (foreign-staged, pending-derived) run in both; that is why there are two
 * registry entries for this check.  No --cases argument runs everything, which is what a hand run wants.
 * Prints PASS/FAIL per case and CHECK_COMMIT_OWN<TAB>failed=N; exit 1 when N > 0. */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use cxlib.productpkg
#pragma unisa use sys.proc
#pragma unisa use sys.io
#pragma unisa use sys.sig
#pragma unisa use mem.heap
#pragma unisa use text.text
#pragma unisa use sys.time
#pragma unisa use cxlib.toolprep

static int failed;
static char base[4096];   /* sy_tmpdir()/check-commit-own-PID: the throwaway clone's parent */
static void ck(int ok, const char *name) { if (ok) sy_printf("PASS\tcheck-commit-own.%s\n", name); else { failed++; sy_printf("FAIL\tcheck-commit-own.%s\n", name); } }
static void die(const char *s) { sy_eprintf("check-commit-own: REFUSE %s\n", s); sy_exit(2); }
/* the native image of tools/commit-own.cx and the directory of its two siblings; built once in main */
static char co_native[4400];

/* sh -c SCRIPT in the clone; stdout+stderr into OUT.
   UNISACC_CHECK_TIMING=1 prints one TIMING line per case on stderr (a measurement, never a verdict);
   unset -- the normal run -- prints nothing extra, so the check's output contract does not change. */
static int sh(const char *script, char *out, int cap) {
    char *av[] = {"sh", "-c", 0, 0}, *o = 0; size_t on = 0; int rc;
    char full[8192];
    const char *timing = getenv("UNISACC_CHECK_TIMING");
    long t0 = sy_now_ms();
    if (cx_fmt(full, sizeof full, "{ %s\n} 2>&1", script)) die("script too long");
    av[2] = full;
    rc = cx_runv_timeout(av, 50, &o, &on);   /* 50 s bound (the check budget is 55 s) */
    if (cap > 0) { size_t m = o ? on : 0; if (m > (size_t)cap - 1) m = (size_t)cap - 1; if (m) tx_copy(out, cap, o, (long)m); else out[0] = 0; }
    if (o) mm_free(o);
    if (timing && timing[0] == '1') sy_eprintf("TIMING\tsh_ms=%ld\trc=%d\t%.60s\n", sy_now_ms() - t0, rc, full);
    return rc;
}

static void case_(const char *name, int lock_s) {
    char out[8192], script[2048];
    if (cx_fmt(script, sizeof script,
        "cd %s/clone && printf 'n\\n' > %s.txt && "
        "if [ %d -gt 0 ]; then ( touch .git/index.lock; sleep %d; rm -f .git/index.lock ) & sleep 0.3; fi; "
        "./tools/co.native -m %s --whole %s.txt 2>&1 | tail -1; wait; "
        "echo STATUS; git status --short -- %s.txt; echo ENTRY; git ls-files -s -- %s.txt | cut -c1-6",
        base, name, lock_s, lock_s, name, name, name, name)) die("script");
    sh(script, out, sizeof out);
    {   const char *a = "index_unsynced=0", *b = "STATUS\nENTRY\n100644";
        ck(tx_find(out, tx_len(out, sizeof out), a, tx_len(a, 64)) >= 0 && tx_find(out, tx_len(out, sizeof out), b, tx_len(b, 64)) >= 0, name); }
}

/* a --whole symlink commits as 120000 with the target string as the blob, not as a 100644 copy of its target. */
static void case_symlink(void) {
    char out[8192], script[2048];
    if (cx_fmt(script, sizeof script,
        "cd %s/clone && ln -sf target.c tools/link.c && "
        "./tools/co.native -m symlink --whole tools/link.c 2>&1 | tail -1; "
        "echo MODE; git ls-tree HEAD -- tools/link.c | cut -c1-6; echo TARGET; git cat-file -p HEAD:tools/link.c",
        base, 0, 0, 0, 0)) die("script");
    sh(script, out, sizeof out);
    {   const char *a = "index_unsynced=0", *m = "MODE\n120000", *t = "TARGET\ntarget.c";
        ck(tx_find(out, tx_len(out, sizeof out), a, tx_len(a, 64)) >= 0 &&
           tx_find(out, tx_len(out, sizeof out), m, tx_len(m, 64)) >= 0 &&
           tx_find(out, tx_len(out, sizeof out), t, tx_len(t, 64)) >= 0, "symlink-commits-120000-with-target-string"); }
}

/* a --whole directory symlink commits as 120000 too (tools/cxlib/sys -> ../../cx/sys is one). */
static void case_dirlink(void) {
    char out[8192], script[2048];
    if (cx_fmt(script, sizeof script,
        "cd %s/clone && mkdir -p realdir && ln -sf realdir tools/dlink && "
        "./tools/co.native -m dirlink --whole tools/dlink 2>&1 | tail -1; "
        "echo MODE; git ls-tree HEAD -- tools/dlink | cut -c1-6; echo TARGET; git cat-file -p HEAD:tools/dlink",
        base, 0, 0, 0, 0)) die("script");
    sh(script, out, sizeof out);
    {   const char *a = "index_unsynced=0", *m = "MODE\n120000", *t = "TARGET\nrealdir";
        ck(tx_find(out, tx_len(out, sizeof out), a, tx_len(a, 64)) >= 0 &&
           tx_find(out, tx_len(out, sizeof out), m, tx_len(m, 64)) >= 0 &&
           tx_find(out, tx_len(out, sizeof out), t, tx_len(t, 64)) >= 0, "dir-symlink-commits-120000-with-target-string"); }
}

/* --keyed KEY is a whole TAB-delimited field, not a substring: rows A (whose text mentions A-B) and A-B coexist. */
static void case_keyed(void) {
    char out[8192], script[4096];
    /* (1) --keyed A-B: A's row is removed in the work tree by someone else and A-B is edited; A must stay in the commit. */
    if (cx_fmt(script, sizeof script,
        "cd %s/clone && printf 'x\\nA\\tsee A-B\\nA-B\\tone\\ny\\n' > k1.tsv && git add k1.tsv && git commit -qm k1 -- k1.tsv && "
        "printf 'x\\nA-B\\ttwo\\ny\\n' > k1.tsv && "
        "./tools/co.native -m k1b --keyed k1.tsv A-B >/dev/null 2>&1; echo SHOW; git show HEAD:k1.tsv",
        base, 0, 0, 0, 0)) die("script");
    sh(script, out, sizeof out);
    ck(tx_find(out, tx_len(out, sizeof out), "\nA\tsee A-B\n", 11) >= 0 && tx_find(out, tx_len(out, sizeof out), "\nA-B\ttwo\n", 9) >= 0 &&
       tx_find(out, tx_len(out, sizeof out), "\nA-B\tone\n", 9) < 0, "keyed-AB-keeps-A-row");
    /* (2) --keyed A: A-B is edited by someone else; only the new A row is added. */
    if (cx_fmt(script, sizeof script,
        "cd %s/clone && printf 'x\\nA-B\\tone\\ny\\nz\\n' > k2.tsv && git add k2.tsv && git commit -qm k2 -- k2.tsv && "
        "printf 'x\\nA-B\\ttwo\\ny\\nz\\nA\\tnew\\n' > k2.tsv && "
        "./tools/co.native -m k2b --keyed k2.tsv A >/dev/null 2>&1; echo SHOW; git show HEAD:k2.tsv",
        base, 0, 0, 0, 0)) die("script");
    sh(script, out, sizeof out);
    ck(tx_find(out, tx_len(out, sizeof out), "\nA-B\tone\n", 9) >= 0 && tx_find(out, tx_len(out, sizeof out), "\nA\tnew\n", 7) >= 0 &&
       tx_find(out, tx_len(out, sizeof out), "\nA-B\ttwo\n", 9) < 0, "keyed-A-leaves-AB-row");
}

/* --registered ID...: three manifests with suffixed batch ids (zzra1..3) and their coverage/packages rows plus a
   foreign row appended by someone else.  One call selects all nine rows and the three manifests, the foreign row
   stays out (and stays in the work tree), and reg-manifest --check --index -- the precommit gate's verdict --
   reports nothing for them.  Then a foreign row whose field equals a new id (zzrb1) is refused, nothing committed. */
#define CO_MK "mk(){ i=$1; r=\"$i\\tIMPLEMENTED\\tinterfaces\\ttools/check-$i.cx\\tSOURCE\\tlnx/x86_64\\t55\\t-\\ttools/check-$i.cx\\t-\\tinterfaces.$i\\trc0:X\\tproduct\\tcommit\"; " \
    "c=\"interfaces.$i\\tinterfaces\\tIMPLEMENTED_SEPARATE_BATCH\\tfixture\\ttools/check-$i.cx\"; p=\"batch\\t$i\\tall\\t-\\t-\\t-\\t-\\t-\\t-\"; " \
    "printf \"batch\\t$r\\ncoverage\\t$c\\npackages\\t$p\\n\" > tests/manifests/$i.tsv; printf \"$r\\n\" >> tests/batches.tsv; " \
    "printf \"$c\\n\" >> tests/coverage.tsv; printf \"$p\\n\" >> build/batch-packages.tsv; }; "
static void case_registered(void) {
    char out[8192], script[4096];
    if (cx_fmt(script, sizeof script,
        "cd %s/clone && " CO_MK "mk zzra1; mk zzra2; mk zzra3; printf 'zzforeign\\tother\\n' >> tests/batches.tsv; "
        "./tools/co.native -m reg --registered zzra1 zzra2 zzra3 > reg.out 2>&1; echo RC=$?; grep -c '^REGISTERED' reg.out; "
        "echo HEADROWS; git show HEAD:tests/batches.tsv | grep -c '^zzra'; git show HEAD:tests/coverage.tsv | grep -c '^interfaces.zzra'; "
        "git show HEAD:build/batch-packages.tsv | grep -c 'zzra'; git ls-tree --name-only HEAD tests/manifests/ | grep -c zzra; "
        "echo FOREIGN; git show HEAD:tests/batches.tsv | grep -c zzforeign; grep -c zzforeign tests/batches.tsv; "
        "echo GATE; \"$UNISACC_COMMIT_OWN_NATIVES/reg-manifest\" --check --index | grep -c zzra; echo END", base)) die("script");
    sh(script, out, sizeof out);
    {   const char *want = "RC=0\n1\nHEADROWS\n3\n3\n3\n3\nFOREIGN\n0\n1\nGATE\n0\nEND";
        ck(tx_find(out, tx_len(out, sizeof out), want, tx_len(want, 256)) >= 0, "registered-selects-set-gate-agrees"); }
    if (cx_fmt(script, sizeof script,
        "cd %s/clone && " CO_MK "mk zzrb1; printf 'zzother\\tsee\\tzzrb1\\n' >> tests/batches.tsv; "
        "./tools/co.native -m misfire --registered zzrb1 > mf.out 2>&1; echo RC=$?; grep -c 'not a manifest row' mf.out; "
        "echo HEADROWS; git show HEAD:tests/batches.tsv | grep -c zzrb1; echo END", base)) die("script");
    sh(script, out, sizeof out);
    {   const char *want = "RC=1\n1\nHEADROWS\n0\nEND";
        ck(tx_find(out, tx_len(out, sizeof out), want, tx_len(want, 256)) >= 0, "registered-refuses-foreign-field-match"); }
}

/* NAME=abs-path arguments, as run-batch supplies declared batch materials; -1 when absent. */
static int co_material(int argc, char **argv, const char *name) {
    size_t n = strlen(name); int i;
    for (i = 1; i < argc; i++)
        if (!strncmp(argv[i], name, n) && argv[i][n] == '=' && argv[i][n + 1] == '/') return i;
    return -1;
}
int main(int argc, char **argv) {
    char out[8192];
    char prep[2048], clone[4400];
    if (cx_fmt(base, sizeof base, "%s/check-commit-own-%d", sy_tmpdir(), (int)sy_pid()) || cx_fmt(clone, sizeof clone, "%s/clone", base)) die("path");
    if (cx_fmt(prep, sizeof prep, "rm -rf %s && mkdir -p %s && git clone -q --local . %s && "
           "cp tools/commit-own.cx tools/own-diff.cx tools/on-change.cx %s/tools/ && "
           "cd %s && git config user.email t@t && git config user.name t", base, base, clone, clone, clone)) die("path");
    if (sh(prep, out, sizeof out) != 0)
        die("cannot prepare the clone");
    /* The product into the clone: which files make up "the product" is a layout question, so ask
       productpkg rather than naming unisacc.com.dev here. A hardcoded `cp -r unisacc.com.dev`
       breaks the day a complete APE ships again, and silently copies nothing when the layout is
       PE-only. */
    {   char root[4400];
        if (sy_cwd(root, sizeof root) < 0) die("cwd");
        if (pp_copy_product(root, clone)) die("cannot copy the product into the clone");
    }
    char root_local[4400];
    if (sy_cwd(root_local, sizeof root_local) < 0) die("cwd");
    /* The six native images are batch materials when run-batch supplies them (NAME=abs-path on argv), so the
       build happens outside this batch's 55 s budget and is cached by identity.  Run by hand with no materials,
       build them here with cxlib.toolprep as before: the assertions and the isolation are the same either way,
       only who pays for the compile differs.  Each image is copied into the clone because every case runs inside
       it; the sibling directory is named to both tools so they stop compiling their own children. */
    {   char natives[4400], img[4400], dst[4400], why[400]; int mi;
        static const char *names[6] = {"commit-own-tool", "own-diff-tool", "on-change-tool", "affected-tool", "derive-tool", "domain-tool"};
        if (cx_fmt(natives, sizeof natives, "%s/tools/natives", clone) || sy_mkdir(natives, 0755)) die("natives dir");
        if (cx_fmt(co_native, sizeof co_native, "%s/tools/co.native", clone)) die("path");
        why[0] = 0;
        for (mi = 0; mi < 6; mi++) {
            int a = co_material(argc, argv, names[mi]);
            const char *leaf = mi == 0 ? "co.native" : mi == 1 ? "own-diff" : mi == 2 ? "on-change" : mi == 3 ? "affected" : mi == 4 ? "derive" : "domain";
            if (a > 0) {
                if (mi == 0) { if (cx_fmt(dst, sizeof dst, "%s", co_native)) die("path"); }
                else if (cx_fmt(dst, sizeof dst, "%s/%s", natives, leaf)) die("path");
                {   char *cp[] = {"cp", "-f", argv[a] + strlen(names[mi]) + 1, dst, 0};
                    if (cx_runv_timeout(cp, 20, 0, 0) != 0) die("material copy"); }
            } else if (mi == 0) {
                if (tq_native(root_local, "tools/commit-own.cx", co_native, why, sizeof why)) die(why);
            } else if (mi == 1 || mi == 2) {
                static const char *srcs[6] = {"", "tools/own-diff.cx", "tools/on-change.cx"};
                if (cx_fmt(img, sizeof img, "%s/%s", natives, leaf) || tq_native(root_local, srcs[mi], img, why, sizeof why)) die(why);
            }
        }
        /* reg-manifest (the registration gate's verdict) for --registered; not a declared material yet */
        if (cx_fmt(img, sizeof img, "%s/reg-manifest", natives) || tq_native(root_local, "tools/reg-manifest.cx", img, why, sizeof why)) die(why);
        if (setenv("UNISACC_COMMIT_OWN_NATIVES", natives, 1)) die("natives env");
        if (setenv("UNISACC_ON_CHANGE_NATIVES", natives, 1)) die("natives env");
    }
    /* A batch has 55 s and the whole set is ~69 s of git work on top of the native builds (measured: prep 1.0 s,
       nolock 19.1 s, lock 15.6 s, registered 20.3 s, the seven small cases ~12 s), so the cases are
       PARTITIONED, never weakened: a = nolock/symlink/dirlink/keyed, b = lock/registered.  Both halves assert
       exactly what the whole run asserted, and the two artifact cases below run in both (they are cheap and
       belong to neither half's contract).  No --cases argument runs everything, which is what a hand run wants.
       Hence two registry entries for this check, commit-own (b) and commit-own-nolock (a). */
    {   int ai; const char *group = 0;
        for (ai = 1; ai < argc; ai++) if (!strcmp(argv[ai], "--cases") && ai + 1 < argc) group = argv[++ai];
        if (!group || group[0] == 'b') { case_("lock", 4); case_registered(); }
        if (!group || group[0] == 'a') { case_("nolock", 0); case_symlink(); case_dirlink(); case_keyed(); }
    }
    {   char out[8192], script[2048];
        if (cx_fmt(script, sizeof script,
            "cd %s/clone && printf 'f\\n' > foreign.txt && git add -- foreign.txt && printf 'm\\n' > mine-own.txt && "
            "./tools/co.native -m mine --whole mine-own.txt 2>&1; echo CACHED; git diff --cached --name-only", base))
            die("script");
        sh(script, out, sizeof out);
        ck(tx_find(out, tx_len(out, sizeof out), "cached-foreign", 14) >= 0 &&
           tx_find(out, tx_len(out, sizeof out), "CACHED\nforeign.txt", 18) >= 0, "foreign-staged-kept");
    }
    {   char out[8192], script[2048];   /* pending-derived 提示:改 tools/ 下 .cx 含 tool-index;无关路径不含;提示不改 rc */
        if (cx_fmt(script, sizeof script,
            "cd %s/clone && printf 'int main(void){return 0;}\\n' > tools/zz-pend.cx && "
            "./tools/co.native -m pend --whole tools/zz-pend.cx 2>&1; echo RC=$?", base)) die("script");
        sh(script, out, sizeof out);
        ck(tx_find(out, tx_len(out, sizeof out), "pending-derived=tool-index", 26) >= 0 &&
           tx_find(out, tx_len(out, sizeof out), "RC=0", 4) >= 0, "pending-derived-tool-index");
        if (cx_fmt(script, sizeof script,
            "cd %s/clone && printf 'q\\n' > zz-plain.txt && "
            "./tools/co.native -m plain --whole zz-plain.txt 2>&1; echo RC=$?", base)) die("script");
        sh(script, out, sizeof out);
        ck(tx_find(out, tx_len(out, sizeof out), "pending-derived=", 16) < 0 &&
           tx_find(out, tx_len(out, sizeof out), "RC=0", 4) >= 0, "no-pending-derived-for-unrelated");
    }
    {   char rm[4500]; if (!cx_fmt(rm, sizeof rm, "rm -rf %s", base)) sh(rm, out, sizeof out); }
    sy_printf("CHECK_COMMIT_OWN\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
