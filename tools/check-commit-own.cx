/* tools/check-commit-own.cx -- tools/commit-own.cx keeps the shared index in sync even when another git process
 * holds .git/index.lock (an agent's git status refreshes the index).  Before the fix, update-index failed silently
 * and a NEW file showed up as `D  path` plus `?? path` right after the commit (penoff, macbyt).
 *
 *   sh ./unisacc.com tools/check-commit-own.cx            (from the repo root; works in out/check-commit-own/)
 *
 * In a throwaway local clone with a copy of the working-tree commit-own.cx and the installed unisacc.com:
 *   lock    a new file is committed while .git/index.lock is held for 4 s: COMMIT_OWN says index_unsynced=0, the
 *           file's index entry is the committed blob and git status shows nothing for it;
 *   nolock  the same without a lock, as a control.
 * Prints PASS/FAIL per case and CHECK_COMMIT_OWN<TAB>failed=N; exit 1 when N > 0. */
#pragma unisa use sys.fs
#pragma unisa use mem.bytes
#pragma unisa use sys.env
#pragma unisa use cxlib.productpkg
#pragma unisa use sys.proc
#pragma unisa use sys.io
#pragma unisa use sys.sig
#pragma unisa use mem.heap
#pragma unisa use text.text
#pragma unisa use sys.time

static int failed;
static char base[4096];   /* sy_tmpdir()/check-commit-own-PID: the throwaway clone's parent */
static void ck(int ok, const char *name) { if (ok) sy_printf("PASS\tcheck-commit-own.%s\n", name); else { failed++; sy_printf("FAIL\tcheck-commit-own.%s\n", name); } }
static void die(const char *s) { sy_eprintf("check-commit-own: REFUSE %s\n", s); sy_exit(2); }

/* sh -c SCRIPT in the clone; stdout+stderr into OUT */
static int sh(const char *script, char *out, int cap) {
    char *av[] = {"sh", "-c", 0, 0}, *o = 0; size_t on = 0; int rc;
    char full[8192];
    if (cx_fmt(full, sizeof full, "{ %s\n} 2>&1", script)) die("script too long");
    av[2] = full;
    rc = cx_runv_timeout(av, 50, &o, &on);   /* 50 s bound (the check budget is 55 s) */
    if (cap > 0) { size_t m = o ? on : 0; if (m > (size_t)cap - 1) m = (size_t)cap - 1; if (m) tx_copy(out, cap, o, (long)m); else out[0] = 0; }
    if (o) mm_free(o);
    return rc;
}

static void case_(const char *name, int lock_s) {
    char out[8192], script[2048];
    if (cx_fmt(script, sizeof script,
        "cd %s/clone && printf 'n\\n' > %s.txt && "
        "if [ %d -gt 0 ]; then ( touch .git/index.lock; sleep %d; rm -f .git/index.lock ) & sleep 0.3; fi; "
        "sh ./unisacc.com tools/devsvc.cx -- run --local tools/commit-own.cx -- -m %s --whole %s.txt 2>&1 | grep -v DEVSVC_RUN | tail -1; wait; "
        "echo STATUS; git status --short -- %s.txt; echo ENTRY; git ls-files -s -- %s.txt | cut -c1-6",
        base, name, lock_s, lock_s, name, name, name, name)) die("script");
    sh(script, out, sizeof out);
    {   const char *a = "index_unsynced=0", *b = "STATUS\nENTRY\n100644";
        ck(tx_find(out, tx_len(out, sizeof out), a, tx_len(a, 64)) >= 0 && tx_find(out, tx_len(out, sizeof out), b, tx_len(b, 64)) >= 0, name); }
}

/* a --whole symlink commits as 120000 with the target string as the blob, not as a 100644 copy of its target. */
static void case_symlink(void) {
    char out[8192], script[2048];
    if (cx_fmt(script, sizeof script,
        "cd %s/clone && ln -sf target.c tools/link.c && "
        "sh ./unisacc.com tools/devsvc.cx -- run --local tools/commit-own.cx -- -m symlink --whole tools/link.c 2>&1 | grep -v DEVSVC_RUN | tail -1; "
        "echo MODE; git ls-tree HEAD -- tools/link.c | cut -c1-6; echo TARGET; git cat-file -p HEAD:tools/link.c",
        base, 0, 0, 0, 0)) die("script");
    sh(script, out, sizeof out);
    {   const char *a = "index_unsynced=0", *m = "MODE\n120000", *t = "TARGET\ntarget.c";
        ck(tx_find(out, tx_len(out, sizeof out), a, tx_len(a, 64)) >= 0 &&
           tx_find(out, tx_len(out, sizeof out), m, tx_len(m, 64)) >= 0 &&
           tx_find(out, tx_len(out, sizeof out), t, tx_len(t, 64)) >= 0, "symlink-commits-120000-with-target-string"); }
}

/* a --whole directory symlink commits as 120000 too (tools/cxlib/sys -> ../../cx/sys is one). */
static void case_dirlink(void) {
    char out[8192], script[2048];
    if (cx_fmt(script, sizeof script,
        "cd %s/clone && mkdir -p realdir && ln -sf realdir tools/dlink && "
        "sh ./unisacc.com tools/devsvc.cx -- run --local tools/commit-own.cx -- -m dirlink --whole tools/dlink 2>&1 | grep -v DEVSVC_RUN | tail -1; "
        "echo MODE; git ls-tree HEAD -- tools/dlink | cut -c1-6; echo TARGET; git cat-file -p HEAD:tools/dlink",
        base, 0, 0, 0, 0)) die("script");
    sh(script, out, sizeof out);
    {   const char *a = "index_unsynced=0", *m = "MODE\n120000", *t = "TARGET\nrealdir";
        ck(tx_find(out, tx_len(out, sizeof out), a, tx_len(a, 64)) >= 0 &&
           tx_find(out, tx_len(out, sizeof out), m, tx_len(m, 64)) >= 0 &&
           tx_find(out, tx_len(out, sizeof out), t, tx_len(t, 64)) >= 0, "dir-symlink-commits-120000-with-target-string"); }
}

/* --keyed KEY is a whole TAB-delimited field, not a substring: rows A (whose text mentions A-B) and A-B coexist. */
static void case_keyed(void) {
    char out[8192], script[4096];
    /* (1) --keyed A-B: A's row is removed in the work tree by someone else and A-B is edited; A must stay in the commit. */
    if (cx_fmt(script, sizeof script,
        "cd %s/clone && printf 'x\\nA\\tsee A-B\\nA-B\\tone\\ny\\n' > k1.tsv && git add k1.tsv && git commit -qm k1 -- k1.tsv && "
        "printf 'x\\nA-B\\ttwo\\ny\\n' > k1.tsv && "
        "sh ./unisacc.com tools/devsvc.cx -- run --local tools/commit-own.cx -- -m k1b --keyed k1.tsv A-B >/dev/null 2>&1; echo SHOW; git show HEAD:k1.tsv",
        base, 0, 0, 0, 0)) die("script");
    sh(script, out, sizeof out);
    ck(tx_find(out, tx_len(out, sizeof out), "\nA\tsee A-B\n", 11) >= 0 && tx_find(out, tx_len(out, sizeof out), "\nA-B\ttwo\n", 9) >= 0 &&
       tx_find(out, tx_len(out, sizeof out), "\nA-B\tone\n", 9) < 0, "keyed-AB-keeps-A-row");
    /* (2) --keyed A: A-B is edited by someone else; only the new A row is added. */
    if (cx_fmt(script, sizeof script,
        "cd %s/clone && printf 'x\\nA-B\\tone\\ny\\nz\\n' > k2.tsv && git add k2.tsv && git commit -qm k2 -- k2.tsv && "
        "printf 'x\\nA-B\\ttwo\\ny\\nz\\nA\\tnew\\n' > k2.tsv && "
        "sh ./unisacc.com tools/devsvc.cx -- run --local tools/commit-own.cx -- -m k2b --keyed k2.tsv A >/dev/null 2>&1; echo SHOW; git show HEAD:k2.tsv",
        base, 0, 0, 0, 0)) die("script");
    sh(script, out, sizeof out);
    ck(tx_find(out, tx_len(out, sizeof out), "\nA-B\tone\n", 9) >= 0 && tx_find(out, tx_len(out, sizeof out), "\nA\tnew\n", 7) >= 0 &&
       tx_find(out, tx_len(out, sizeof out), "\nA-B\ttwo\n", 9) < 0, "keyed-A-leaves-AB-row");
}

/* --keyed PATH given twice for one PATH (KEY1, then KEY2,KEY1 -- a repeated key): one entry with the union, so
   both own rows land; the two rows someone else changed (one edited, one appended) stay out of HEAD and stay in
   the work tree.  Before the fix each --keyed was its own entry and the private index kept the last blob only:
   the KEY1 row was lost.  Then a key no line of the file carries refuses with exit 2, named, nothing committed. */
static void case_multikey(void) {
    char out[8192], script[4096];
    if (cx_fmt(script, sizeof script,
        "cd %s/clone && printf 'h\\nF1\\told\\nM1\\told\\nM2\\told\\ny\\n' > mk.tsv && git add mk.tsv && git commit -qm mk -- mk.tsv && "
        "printf 'h\\nF1\\tnew\\nM1\\tnew\\nM2\\tnew\\ny\\nF2\\tadd\\n' > mk.tsv && "
        "sh ./unisacc.com tools/devsvc.cx -- run --local tools/commit-own.cx -- -m mk2 --keyed mk.tsv M1 --keyed mk.tsv M2,M1 > mk.out 2>&1; echo RC=$?; "
        "echo SHOW; git show HEAD:mk.tsv; echo WORK; grep -c '^F' mk.tsv; echo END",
        base, 0, 0, 0, 0)) die("script");
    sh(script, out, sizeof out);
    {   long n = tx_len(out, sizeof out); int ok;   /* own-diff --emit decides where the kept foreign F1 line sits */
        ok = tx_find(out, n, "RC=0\nSHOW\nh\n", 12) >= 0 && tx_find(out, n, "\nM1\tnew\n", 8) >= 0 && tx_find(out, n, "\nM2\tnew\n", 8) >= 0 &&
             tx_find(out, n, "\nF1\told\n", 8) >= 0 && tx_find(out, n, "F1\tnew", 6) < 0 && tx_find(out, n, "F2\tadd", 6) < 0 &&
             tx_find(out, n, "\nM1\told", 7) < 0 && tx_find(out, n, "\nWORK\n2\nEND", 11) >= 0;
        if (!ok) sy_printf("DETAIL\t%s\n", out);
        ck(ok, "multikey-same-path-union-dedup-foreign-kept"); }
    if (cx_fmt(script, sizeof script,
        "cd %s/clone && H0=$(git rev-parse HEAD) && printf 'M3\\tx\\n' >> mk.tsv && "
        "sh ./unisacc.com tools/devsvc.cx -- run --local tools/commit-own.cx -- -m mk3 --keyed mk.tsv M3 --keyed mk.tsv ZZNOKEY > mk3.out 2>&1; echo RC=$?; "
        "grep -c 'COMMIT_OWN_MISSING_KEY.path=mk.tsv.key=ZZNOKEY' mk3.out; grep -c 'COMMIT_OWN_FAIL.class=args' mk3.out; "
        "[ \"$H0\" = \"$(git rev-parse HEAD)\" ] && echo SAMEHEAD; echo END",
        base, 0, 0, 0, 0)) die("script");
    sh(script, out, sizeof out);
    ck(tx_find(out, tx_len(out, sizeof out), "RC=2\n1\n1\nSAMEHEAD\nEND", 21) >= 0, "multikey-missing-key-refused-named");
}

/* --registered ID...: three manifests with suffixed batch ids (zzra1..3) and their coverage/packages rows plus a
   foreign row appended by someone else.  One call selects all nine rows and the three manifests, the foreign row
   stays out (and stays in the work tree), and reg-manifest --check --index -- the precommit gate's verdict --
   reports nothing for them.  Then a foreign row whose field equals a new id (zzrb1) is refused, nothing committed. */
#define CO_MK "mk(){ sh \"$COMMIT_GATE_FIXTURE_PRODUCT\" \"$COMMIT_GATE_FIXTURE_SOURCE\" -- --fixture-batch \"$1\" commit-own > \"fixture-$1.out\"; }; "
/* --registered ID...: the registration unit of one set (one manifest plus its coverage and packages rows) is
   committed in one call: the set's rows reach HEAD, a foreign row appended by someone else stays out and stays
   in the work tree, and reg-manifest --check --index -- the precommit gate's verdict -- reports nothing for it.
   Three sets in one call were measured at 52.7 s on a fresh clone (one pre-commit hook run per --registered call,
   7.6 s each, plus the clone), so each set is its own batch; every set asserts exactly what the combined call
   asserted about its own rows.  WHICH is 1..3 for zzra1..zzra3. */
static void case_registered(int which) {
    char out[8192], script[4096], name[64], want[256];
    if (cx_fmt(name, sizeof name, "registered-set-%d", which) ||
        cx_fmt(want, sizeof want, "RC=0\n1\nHEADROWS\n1\n1\n1\n1\nFOREIGN\n0\n1\nGATE\n0\nEND")) die("path");
    if (cx_fmt(script, sizeof script,
        "cd %s/clone && id=zzra%d; " CO_MK "mk $id; printf 'zzforeign'$id'\\tother\\n' >> tests/batches.tsv; "
        "sh ./unisacc.com tools/devsvc.cx -- run --local tools/commit-own.cx -- -m reg$id --registered $id > reg.out 2>&1; echo RC=$?; grep -c '^REGISTERED' reg.out; "
        "echo HEADROWS; git show HEAD:tests/batches.tsv | grep -c \"^$id\"; git show HEAD:tests/coverage.tsv | grep -c \"^interfaces.$id\"; "
        "git show HEAD:tests/batches.tsv > head-registry.tsv && sh ./unisacc.com tools/batch-packages-gen.cx -- --query --registry head-registry.tsv --row \"$id\" | grep -c \"$id\"; git ls-tree --name-only HEAD tests/manifests/ | grep -c \"$id\"; "
        "echo FOREIGN; git show HEAD:tests/batches.tsv | grep -c zzforeign$id; grep -c zzforeign$id tests/batches.tsv; "
        "echo GATE; sh ./unisacc.com tools/reg-manifest.cx -- --check --index | grep -c \"$id\"; echo END",
        base, which, 0, 0, 0)) die("script");
    sh(script, out, sizeof out);
    ck(tx_find(out, tx_len(out, sizeof out), want, tx_len(want, 256)) >= 0, name);
}

/* The refusal half on its own: an added registry line that is not a manifest row (a whole-field match on someone
   else's row) must refuse with exit 1 and nothing committed. */
static void case_registered_refuse(void) {
    char out[8192], script[4096];
    if (cx_fmt(script, sizeof script,
        "cd %s/clone && " CO_MK "mk zzrb1; printf 'zzother\\tsee\\tzzrb1\\n' >> tests/batches.tsv; "
        "sh ./unisacc.com tools/devsvc.cx -- run --local tools/commit-own.cx -- -m misfire --registered zzrb1 > mf.out 2>&1; echo RC=$?; grep -c 'not a manifest row' mf.out; "
        "echo HEADROWS; git show HEAD:tests/batches.tsv | grep -c zzrb1; echo END", base, 0, 0, 0, 0)) die("script");
    sh(script, out, sizeof out);
    {   const char *want = "RC=1\n1\nHEADROWS\n0\nEND";
        ck(tx_find(out, tx_len(out, sizeof out), want, tx_len(want, 256)) >= 0, "registered-refuses-foreign-field-match"); }
}
/* S2 (plans/devsvc.md 6): the commit failures seen in the devsvc event history, as cases.  --help exits 0;
   --dry-run builds the private index and runs the pre-commit hook without committing; a failed commit names its
   class on stderr (COMMIT_OWN_FAIL class=...); a successful one prints COMMIT_OWN_PHASE timings; HEAD moving under
   the commit (another agent committed meanwhile) is retried once on the new HEAD when none of the commit's paths
   changed there; a --whole/--keyed of a table --registered owns is dropped with a NOTE instead of refusing. */
#define CO_HK(dir) "GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.hooksPath GIT_CONFIG_VALUE_0=$PWD/" dir " "
#define CO_RUN "sh ./unisacc.com tools/devsvc.cx -- run --local tools/commit-own.cx -- "
static void s2_want(const char *script_tail, const char *want, const char *name) {
    char out[8192], script[6000];
    if (cx_fmt(script, sizeof script, "cd %s/clone && %s", base, script_tail)) die("script");
    sh(script, out, sizeof out);
    ck(tx_find(out, tx_len(out, sizeof out), want, tx_len(want, 512)) >= 0, name);
    if (tx_find(out, tx_len(out, sizeof out), want, tx_len(want, 512)) < 0) sy_printf("GOT\t%s\n", out);   /* the evidence of a FAIL */
}
static void case_s2(int part) {
    /* the pending-derived hint is not under test here (the three older batches assert it); without tools/on-change.cx
       commit-own skips it, which keeps each group inside the 55 s budget on a loaded machine */
    {   char o[256], s[4500]; if (!cx_fmt(s, sizeof s, "rm -f %s/clone/tools/on-change.cx", base)) sh(s, o, sizeof o); }
    if (part == 0 || part == 1) {
    if (part == 0)
    s2_want(CO_RUN "--help > h.out 2>&1; echo RC=$?; grep -c 'usage' h.out; echo END", "RC=0\n1\nEND", "s2-help-rc0");
    if (part == 1)
    s2_want("printf 'd\\n' > zz-dry.txt; H0=$(git rev-parse HEAD); " CO_RUN "-m dry --whole zz-dry.txt --dry-run > d.out 2>&1; echo RC=$?; "
            "grep -c '^COMMIT_OWN_DRY' d.out; [ \"$H0\" = \"$(git rev-parse HEAD)\" ] && echo SAMEHEAD; git status --short -- zz-dry.txt; echo END",
            "RC=0\n1\nSAMEHEAD\n?? zz-dry.txt\nEND", "s2-dry-run-commits-nothing");
    if (part == 1) {
    s2_want("mkdir -p zzhk4 && printf '#!/bin/sh\\necho precommit: blocked:lint:ZZ >&2\\nexit 1\\n' > zzhk4/pre-commit && chmod +x zzhk4/pre-commit; "
            "printf 'e\\n' > zz-dry2.txt; H0=$(git rev-parse HEAD); " CO_HK("zzhk4") CO_RUN "-m dry2 --whole zz-dry2.txt --dry-run > d2.out 2>&1; echo RC=$?; "
            "grep -c 'blocked:lint:ZZ' d2.out; grep -c 'COMMIT_OWN_FAIL.class=precommit' d2.out; [ \"$H0\" = \"$(git rev-parse HEAD)\" ] && echo SAMEHEAD; echo END",
            "RC=1\n1\n1\nSAMEHEAD\nEND", "s2-dry-run-reports-hook-refusal");
    s2_want("printf 'f\\n' > zz-cls.txt; " CO_HK("zzhk4") CO_RUN "-m cls --whole zz-cls.txt > c.out 2>&1; echo RC=$?; "
            "grep -c 'COMMIT_OWN_FAIL.class=precommit' c.out; grep -v DEVSVC_RUN c.out | tail -1; echo END",
            "RC=1\n1\ncommit-own: git commit refused (rc 1): precommit: blocked:lint:ZZ\nEND", "s2-fail-class-precommit");
    }
    if (part == 0)
    s2_want(CO_RUN "-m x > a.out 2>&1; echo RC=$?; grep -c 'COMMIT_OWN_FAIL.class=args' a.out; echo END", "RC=2\n1\nEND", "s2-fail-class-args");
    if (part == 0)
    s2_want("printf 'p\\n' > zz-ph.txt; " CO_RUN "-m ph --whole zz-ph.txt > p.out 2>&1; echo RC=$?; grep -c '^COMMIT_OWN_PHASE.select_ms=' p.out; "
            "grep -v DEVSVC_RUN p.out | tail -1 | cut -c1-18; echo END", "RC=0\n1\nCOMMIT_OWN\tcommit=\nEND", "s2-phase-line-before-result");
    return; }
    if (part == 2) {
    s2_want("mkdir -p zzhk7 && printf '#!/bin/sh\\n[ -e .git/zzraced ] && exit 0\\n: > .git/zzraced\\n"
            "c=$(git commit-tree \"HEAD^{tree}\" -p HEAD -m zzrace) && git update-ref HEAD $c\\nexit 0\\n' > zzhk7/pre-commit && chmod +x zzhk7/pre-commit; "
            "printf 'r\\n' > zz-race.txt; " CO_HK("zzhk7") CO_RUN "-m race7 --whole zz-race.txt > r.out 2>&1; echo RC=$?; "
            "grep -c 'HEAD moved' r.out; git log --format=%s -2; git show HEAD:zz-race.txt; echo END",
            "RC=0\n1\nrace7\nzzrace\nr\nEND", "s2-head-moved-retried-once");
    s2_want("mkdir -p zzhk8 && printf '#!/bin/sh\\n[ -e .git/zzraced8 ] && exit 0\\n: > .git/zzraced8\\n"
            "b=$(printf other | git hash-object -w --stdin) && GIT_INDEX_FILE=.git/zz8.idx git read-tree HEAD && "
            "GIT_INDEX_FILE=.git/zz8.idx git update-index --add --cacheinfo 100644,$b,zz-race.txt && t=$(GIT_INDEX_FILE=.git/zz8.idx git write-tree) && "
            "c=$(git commit-tree $t -p HEAD -m zzrace8) && git update-ref HEAD $c\\nexit 0\\n' > zzhk8/pre-commit && chmod +x zzhk8/pre-commit; "
            "printf 'mine\\n' > zz-race.txt; " CO_HK("zzhk8") CO_RUN "-m race8 --whole zz-race.txt > r8.out 2>&1; echo RC=$?; "
            "grep -c 'COMMIT_OWN_FAIL.class=head-moved' r8.out; git log --format=%s -1; git show HEAD:zz-race.txt; echo; echo END",
            "RC=1\n1\nzzrace8\nother\nEND", "s2-head-moved-same-path-not-retried");
    return; }
    {   char out[8192], script[6000];
        if (cx_fmt(script, sizeof script,
            "cd %s/clone && " CO_MK "mk zzs2r; printf 'zzs2foreign\\tother\\n' >> tests/batches.tsv; "
            CO_RUN "-m regw --registered zzs2r --whole tests/batches.tsv > rw.out 2>&1; echo RC=$?; grep -c 'its --keyed/--whole is dropped' rw.out; "
            "git show HEAD:tests/batches.tsv | grep -c '^zzs2r'; git show HEAD:tests/batches.tsv | grep -c zzs2foreign; grep -c zzs2foreign tests/batches.tsv; echo END",
            base, 0, 0, 0, 0)) die("script");
        sh(script, out, sizeof out);
        {   const char *want = "RC=0\n1\n1\n0\n1\nEND";
            ck(tx_find(out, tx_len(out, sizeof out), want, tx_len(want, 256)) >= 0, "s2-registered-drops-redundant-whole"); }
    }
    s2_want("mkdir -p zzhk_cas1 && printf '#!/bin/sh\\n# tools/precommit.cx\\necho g >> .git/zzcas1.cnt\\n[ -e .git/zzcas1_r ] && exit 0\\n: > .git/zzcas1_r\\n"
            "b=$(printf other | git hash-object -w --stdin) && GIT_INDEX_FILE=.git/zzc1.idx git read-tree HEAD && "
            "GIT_INDEX_FILE=.git/zzc1.idx git update-index --add --cacheinfo 100644,$b,zz-cas-other.txt && t=$(GIT_INDEX_FILE=.git/zzc1.idx git write-tree) && "
            "c=$(git commit-tree $t -p HEAD -m zzcas1) && git update-ref HEAD $c\\nexit 0\\n' > zzhk_cas1/pre-commit && chmod +x zzhk_cas1/pre-commit; "
            "printf 'm0\\n' > zz-cas-def.txt; rm -f .git/zzcas1.cnt .git/zzcas1_r; " CO_HK("zzhk_cas1") CO_RUN "-m casdef --whole zz-cas-def.txt > casdef.out 2>&1; echo DEFRC=$?; "
            "grep -c '^COMMIT_CAS_REBASE' casdef.out; wc -l < .git/zzcas1.cnt | tr -d ' '; "
            "printf 'm\\n' > zz-cas-mine.txt; rm -f .git/zzcas1.cnt .git/zzcas1_r; H0=$(git rev-parse HEAD); UNISACC_COMMIT_CAS_REBASE=1 " CO_HK("zzhk_cas1") CO_RUN "-m cas1 --whole zz-cas-mine.txt > cas1.out 2>&1; echo RC=$?; "
            "grep -c \"^COMMIT_TIMING.*gates=skipped-by-disjoint-readset[[:space:]]base=$H0[[:space:]]\" cas1.out; grep -c 'gates_rc=' cas1.out; "
            "grep -c \"^COMMIT_OWN.*gates=skipped-by-disjoint-readset[[:space:]]base=$H0$\" cas1.out; wc -l < .git/zzcas1.cnt | tr -d ' '; git show HEAD:zz-cas-mine.txt; echo END",
            "DEFRC=0\n0\n2\nRC=0\n1\n0\n1\n1\nm\nEND", "s2-cas-disjoint-skips-gate");
    s2_want("mkdir -p zzhk_cas2 include kernel && printf '#!/bin/sh\\n# tools/precommit.cx\\necho g >> .git/zzcas2.cnt\\n[ -e .git/zzcas2_r ] && exit 0\\n: > .git/zzcas2_r\\n"
            "TP=$(cat .git/zzcas2_path); git cat-file -p \"HEAD:$TP\" > .git/zzc2.b 2>/dev/null || : > .git/zzc2.b; "
            "echo \"/* cas2 */\" >> .git/zzc2.b; b=$(git hash-object -w .git/zzc2.b) && GIT_INDEX_FILE=.git/zzc2.idx git read-tree HEAD && "
            "GIT_INDEX_FILE=.git/zzc2.idx git update-index --add --cacheinfo 100644,$b,\"$TP\" && t=$(GIT_INDEX_FILE=.git/zzc2.idx git write-tree) && "
            "c=$(git commit-tree $t -p HEAD -m zzcas2) && git update-ref HEAD $c\\nexit 0\\n' > zzhk_cas2/pre-commit && chmod +x zzhk_cas2/pre-commit; "
            "printf '/* i1 */\\n' > include/zz-cas-a.h; printf 'include/zz-cas-b.h\\n' > .git/zzcas2_path; rm -f .git/zzcas2.cnt .git/zzcas2_r; "
            "UNISACC_COMMIT_CAS_REBASE=1 " CO_HK("zzhk_cas2") CO_RUN "-m c2a --whole include/zz-cas-a.h > c2a.out 2>&1; echo A=$?/$(grep -c skipped-by-disjoint-readset c2a.out)/$(wc -l < .git/zzcas2.cnt | tr -d ' '); "
            "printf '/* i2 */\\n' > include/zz-cas-a2.h; printf 'tools/pp-autoinc-gen.cx\\n' > .git/zzcas2_path; rm -f .git/zzcas2.cnt .git/zzcas2_r; "
            "UNISACC_COMMIT_CAS_REBASE=1 " CO_HK("zzhk_cas2") CO_RUN "-m c2b --whole include/zz-cas-a2.h > c2b.out 2>&1; echo B=$?/$(grep -c skipped-by-disjoint-readset c2b.out)/$(wc -l < .git/zzcas2.cnt | tr -d ' '); "
            "printf '/* i3 */\\n' > include/zz-cas-a3.h; printf 'cx/sys/fs.cx\\n' > .git/zzcas2_path; rm -f .git/zzcas2.cnt .git/zzcas2_r; "
            "UNISACC_COMMIT_CAS_REBASE=1 " CO_HK("zzhk_cas2") CO_RUN "-m c2c --whole include/zz-cas-a3.h > c2c.out 2>&1; echo C=$?/$(grep -c skipped-by-disjoint-readset c2c.out)/$(wc -l < .git/zzcas2.cnt | tr -d ' '); "
            "printf 'int cas_k(void){return 0;}\\n' > tools/zz-cas-kx.cx; printf 'kernel/zz-cas-k.bin\\n' > .git/zzcas2_path; rm -f .git/zzcas2.cnt .git/zzcas2_r; "
            "UNISACC_COMMIT_CAS_REBASE=1 " CO_HK("zzhk_cas2") CO_RUN "-m c2d --whole tools/zz-cas-kx.cx > c2d.out 2>&1; echo D=$?/$(grep -c skipped-by-disjoint-readset c2d.out)/$(wc -l < .git/zzcas2.cnt | tr -d ' '); echo END",
            "A=0/0/2\nB=0/0/2\nC=0/0/2\nD=0/0/2\nEND", "s2-cas-intersect-reruns-gate");
    s2_want("mkdir -p zzhk_cas3 && printf '#!/bin/sh\\n# tools/precommit.cx\\n[ -e .git/zzcas3_r ] && exit 0\\n: > .git/zzcas3_r\\n"
            "b=$(printf theirs | git hash-object -w --stdin) && GIT_INDEX_FILE=.git/zzc3.idx git read-tree HEAD && "
            "GIT_INDEX_FILE=.git/zzc3.idx git update-index --add --cacheinfo 100644,$b,zz-cas-same.txt && t=$(GIT_INDEX_FILE=.git/zzc3.idx git write-tree) && "
            "c=$(git commit-tree $t -p HEAD -m zzcas3) && git update-ref HEAD $c\\nexit 0\\n' > zzhk_cas3/pre-commit && chmod +x zzhk_cas3/pre-commit; "
            "printf 'mine\\n' > zz-cas-same.txt; rm -f .git/zzcas3_r; UNISACC_COMMIT_CAS_REBASE=1 " CO_HK("zzhk_cas3") CO_RUN "-m cas3 --whole zz-cas-same.txt > cas3.out 2>&1; echo RC=$?; "
            "grep -c 'COMMIT_OWN_FAIL.class=head-moved' cas3.out; git show HEAD:zz-cas-same.txt; echo; echo END",
            "RC=1\n1\ntheirs\nEND", "s2-cas-same-path-refused");
    s2_want("mkdir -p zzhk_cas4 && printf '#!/bin/sh\\n# tools/precommit.cx\\necho g >> .git/zzcas4.cnt\\n[ -e .git/zzcas4_r ] && exit 0\\n: > .git/zzcas4_r\\n"
            "P1=$(cat .git/zzcas4_p1); P2=$(cat .git/zzcas4_p2); "
            "b1=$(echo \"$P1\" | git hash-object -w --stdin) && GIT_INDEX_FILE=.git/zzc4.idx git read-tree HEAD && "
            "GIT_INDEX_FILE=.git/zzc4.idx git update-index --add --cacheinfo 100644,$b1,\"$P1\" && t1=$(GIT_INDEX_FILE=.git/zzc4.idx git write-tree) && "
            "c1=$(git commit-tree $t1 -p HEAD -m zzcas4a) && git update-ref HEAD $c1 && "
            "{ git cat-file -p \"HEAD:$P2\" 2>/dev/null || true; echo \"/* cas4 */\"; } > .git/zzc4.b2 && "
            "b2=$(git hash-object -w .git/zzc4.b2) && GIT_INDEX_FILE=.git/zzc4.idx git read-tree HEAD && "
            "GIT_INDEX_FILE=.git/zzc4.idx git update-index --add --cacheinfo 100644,$b2,\"$P2\" && t2=$(GIT_INDEX_FILE=.git/zzc4.idx git write-tree) && "
            "c2=$(git commit-tree $t2 -p HEAD -m zzcas4b) && git update-ref HEAD $c2\\nexit 0\\n' > zzhk_cas4/pre-commit && chmod +x zzhk_cas4/pre-commit; "
            "printf 'm4\\n' > zz-cas-m4.txt; printf 'zz-cas-o1.txt\\n' > .git/zzcas4_p1; printf 'zz-cas-o2.txt\\n' > .git/zzcas4_p2; rm -f .git/zzcas4.cnt .git/zzcas4_r; "
            "UNISACC_COMMIT_CAS_REBASE=1 " CO_HK("zzhk_cas4") CO_RUN "-m cas4a --whole zz-cas-m4.txt > cas4a.out 2>&1; "
            "echo C1=$?/$(grep -c skipped-by-disjoint-readset cas4a.out)/$(wc -l < .git/zzcas4.cnt | tr -d ' '); git show HEAD:zz-cas-o1.txt; git show HEAD:zz-cas-o2.txt | head -1; git show HEAD:zz-cas-m4.txt; "
            "printf 'int cas5(void){return 0;}\\n' > zz-cas-m5.cx; printf 'zz-cas-o3.txt\\n' > .git/zzcas4_p1; printf 'tools/check-precommit-gates.cx\\n' > .git/zzcas4_p2; rm -f .git/zzcas4.cnt .git/zzcas4_r; "
            "UNISACC_COMMIT_CAS_REBASE=1 " CO_HK("zzhk_cas4") CO_RUN "-m cas4b --whole zz-cas-m5.cx > cas4b.out 2>&1; "
            "echo C2=$?/$(grep -c skipped-by-disjoint-readset cas4b.out)/$(wc -l < .git/zzcas4.cnt | tr -d ' '); git show HEAD:zz-cas-o3.txt; git show HEAD:zz-cas-m5.cx; echo END",
            "C1=0/2/1\nzz-cas-o1.txt\n/* cas4 */\nm4\nC2=0/0/2\nzz-cas-o3.txt\nint cas5(void){return 0;}\nEND", "s2-cas-multi-advance-keeps-other");
    s2_want("mkdir -p zzhk_cas5 && printf '#!/bin/sh\\necho g >> .git/zzcas5.cnt\\n[ -e .git/zzcas5_r ] && exit 0\\n: > .git/zzcas5_r\\n"
            "P=$(cat .git/zzcas5_p); b=$(printf o4 | git hash-object -w --stdin) && GIT_INDEX_FILE=.git/zzc5.idx git read-tree HEAD && "
            "GIT_INDEX_FILE=.git/zzc5.idx git update-index --add --cacheinfo 100644,$b,\"$P\" && t=$(GIT_INDEX_FILE=.git/zzc5.idx git write-tree) && "
            "c=$(git commit-tree $t -p HEAD -m zzcas5) && git update-ref HEAD $c\\nexit 0\\n' > zzhk_cas5/pre-commit && chmod +x zzhk_cas5/pre-commit; "
            "printf 'm6\\n' > zz-cas-m6.txt; printf 'zz-cas-o4.txt\\n' > .git/zzcas5_p; rm -f .git/zzcas5.cnt .git/zzcas5_r; UNISACC_COMMIT_CAS_REBASE=1 " CO_HK("zzhk_cas5") CO_RUN "-m cas5a --whole zz-cas-m6.txt > cas5a.out 2>&1; "
            "echo NS=$?/$(grep -c skipped-by-disjoint-readset cas5a.out)/$(wc -l < .git/zzcas5.cnt | tr -d ' '); "
            "cp tests/precommit-gates.tsv .git/gates.save && grep -v '^facts' .git/gates.save > tests/precommit-gates.tsv; "
            "printf '# tools/precommit.cx\\n' >> zzhk_cas5/pre-commit; printf 'm6b\\n' > zz-cas-m6.txt; printf 'zz-cas-o5.txt\\n' > .git/zzcas5_p; rm -f .git/zzcas5.cnt .git/zzcas5_r; "
            "UNISACC_COMMIT_CAS_REBASE=1 " CO_HK("zzhk_cas5") CO_RUN "-m cas5b --whole zz-cas-m6.txt > cas5b.out 2>&1; r=$?; cp .git/gates.save tests/precommit-gates.tsv; "
            "echo BT=$r/$(grep -c skipped-by-disjoint-readset cas5b.out)/$(wc -l < .git/zzcas5.cnt | tr -d ' '); "
            "printf 'bogus\\tACMR\\tfoo\\tdesc\\n' >> tests/precommit-gates.tsv; printf 'm6c\\n' > zz-cas-m6.txt; printf 'zz-cas-o6.txt\\n' > .git/zzcas5_p; rm -f .git/zzcas5.cnt .git/zzcas5_r; "
            "UNISACC_COMMIT_CAS_REBASE=1 " CO_HK("zzhk_cas5") CO_RUN "-m cas5c --whole zz-cas-m6.txt > cas5c.out 2>&1; r=$?; cp .git/gates.save tests/precommit-gates.tsv; "
            "echo UG=$r/$(grep -c skipped-by-disjoint-readset cas5c.out)/$(wc -l < .git/zzcas5.cnt | tr -d ' '); echo END",
            "NS=0/0/2\nBT=0/0/2\nUG=0/0/2\nEND", "s2-cas-nonstd-hook-and-bad-table");
}
/* --derive (one group per case, each one real commit with tools/derive.cx on the commit's tree; on-change.cx is
   removed from the clone as in case_s2, the pending hint is asserted by the artifacts group):
   tool     a new tools/zz-dt.cx committed with --derive: its build/tool-index.tsv row lands in the same commit; a
            foreign row appended to the work-tree tool-index stays out of HEAD and stays in the work tree, and the
            work tree gains the recomputed row (merged, not overwritten);
   reg      a batch registered with --registered --derive (no build/batch-packages.tsv row written by hand): the
            same commit carries its build/links.tsv and build/batch-packages.tsv rows;
   neg      without --derive the commit is exactly the named path (no COMMIT_OWN_DERIVE, tool-index untouched); with
            --derive and a derive manifest whose --check drifts after --write: exit 1, class derive-drift named, HEAD
            unchanged. */
/* This legacy merge contract requests an explicit materialized catalog.
 * The default query-only policy is checked independently by derive-query-only. */
static void prepare_materialized_catalog(int publish){
    char path[4400],manifest[4400],script[12000],out[8192];size_t n=0;
    if(cx_fmt(path,sizeof path,"%s/clone/exec/facts/derive.tsv",base)||cx_fmt(manifest,sizeof manifest,"%s/clone/zz-catalog-derive.tsv",base))die("catalog-path");
    char*source=cx_read(path,&n);if(!source)die("catalog-fact-read");char*row=source,*found=0,*end=0;
    while(*row){char*e=strchr(row,'\n');if(!e)die("catalog-fact-newline");if(e-row>=11&&!memcmp(row,"tool-index\t",11)){if(found)die("catalog-fact-duplicate");found=row;end=e+1;}row=e+1;}
    if(!found)die("catalog-fact-missing");char*write=found;for(int i=0;i<3;i++){write=strchr(write,'\t');if(!write||write>=end)die("catalog-fact-shape");write++;}
    if(end-write<11||memcmp(write,"query-only ",11))die("catalog-fact-policy");size_t head=write-found,total=end-found-11;char*projection=mm_alloc(total);if(!projection)die("catalog-allocation");
    if(mm_copy(projection,total,found,head)||mm_copy(projection+head,total-head,write+11,end-write-11)||sy_write_atomic(manifest,projection,total,0600))die("catalog-projection");if(publish&&sy_write_atomic(path,projection,total,0600))die("catalog-explicit-policy");mm_free(projection);mm_free(source);
    if(cx_fmt(script,sizeof script,"cd %s/clone && sh ./unisacc.com tools/tool-index.cx -- --write-tools && git add -f -- build/tool-index.tsv && (git diff --cached --quiet -- build/tool-index.tsv || git commit -qm catalog-baseline -- build/tool-index.tsv)",base))die("catalog-prepare-path");
    if(sh(script,out,sizeof out))die("catalog-baseline");
    if(publish){if(cx_fmt(script,sizeof script,"cd %s/clone && sh ./unisacc.com tools/links-gen.cx -- --write",base)||sh(script,out,sizeof out))die("catalog-explicit-links");}
}
static void case_derive(int part) {
    if(part==0||part==2)prepare_materialized_catalog(0);
    /* the product's -run cache is keyed by path: with the clone's own copy of unisacc.com every generator compiled
       cold in each check run (measured: tables-gen 6 s, batch-packages-gen over 25 s, the group over 55 s), so the
       clone's product files point at the checkout's (same bytes, a stable path; commit-own's derive slot root then
       stays warm as it does in the shared checkout) */
    {   char o[256], s[9000], r[4096];
        if (sy_cwd(r, sizeof r) < 0) die("cwd");
        if (!cx_fmt(s, sizeof s, "rm -f %s/clone/tools/on-change.cx; cd %s/clone && for f in unisacc.com unisacc.com.ape.sha256 unisacc.com.build.json; do [ -e %s/$f ] && ln -sf %s/$f $f; done; true", base, base, r, r, 0)) sh(s, o, sizeof o); }
    if (part == 0)
    s2_want("printf '/* tools/zz-dt.cx -- zz derive fixture tool */\\nint main(void){return 0;}\\n' > tools/zz-dt.cx; "
            "printf 'zzforeigndt\\tforeign row\\n' >> build/tool-index.tsv; "
            "UNISACC_COMMIT_OWN_DERIVE_MANIFEST=$PWD/zz-catalog-derive.tsv " CO_RUN "-m dt --whole tools/zz-dt.cx --derive > dt.out 2>&1; echo RC=$?; grep -c '^DERIVED.build/tool-index.tsv' dt.out; "
            "echo HEAD; git show HEAD:build/tool-index.tsv | grep -c '^zz-dt.cx'; git show --name-only --format= HEAD | grep -c '^build/tool-index.tsv'; "
            "git show HEAD:build/tool-index.tsv | grep -c zzforeigndt; echo WORK; grep -c zzforeigndt build/tool-index.tsv; grep -c '^zz-dt.cx' build/tool-index.tsv; echo END",
            "RC=0\n1\nHEAD\n1\n1\n0\nWORK\n1\n1\nEND", "derive-tool-index-same-commit-foreign-kept");
    /* reg-prep (part 3): the same set with --dry-run.  It asserts the derive pass on its own (rc 0, stage ok, the
       links and batch-packages files derived, HEAD unchanged) and leaves the derive slot's -run cache warm: a group
       killed at its bound mid-compile stores nothing, so the cold pass (derive.cx 10 s, tables-gen 6 s,
       batch-packages-gen 24.7 s) never became warm while reg ran alone.  reg (part 1) then runs the real commit
       (measured 48 s warm); the batch list runs reg-prep first. */
#define CO_DR_SETUP CO_MK "mk zzdr; extra=$(cat fixture-zzdr.out); "
    if (part == 3)
    s2_want(CO_DR_SETUP "H0=$(git rev-parse HEAD); " CO_RUN "-m dr --registered zzdr $extra --whole tools/check-zzdr.cx --whole tests/tools-compile-sources.tsv --derive --dry-run > dp.out 2>&1; echo RC=$?; "
            "grep -c 'COMMIT_OWN_DERIVE.rc=0.stage=ok' dp.out; grep -c '^DERIVED.build/links.tsv' dp.out; grep -c '^DERIVED.build/batch-packages.tsv' dp.out; "
            "[ \"$H0\" = \"$(git rev-parse HEAD)\" ] && echo SAMEHEAD; echo END",
            "RC=0\n1\n1\n0\nSAMEHEAD\nEND", "derive-registered-dry-run-derives-commits-nothing");
    if (part == 1)
    s2_want(CO_DR_SETUP CO_RUN "-m dr --registered zzdr $extra --whole tools/check-zzdr.cx --whole tests/tools-compile-sources.tsv --derive > dr.out 2>&1; echo RC=$?; "
            "echo HEAD; git show HEAD:build/links.tsv | grep -c zzdr; git show HEAD:tests/batches.tsv > head-registry.tsv && sh ./unisacc.com tools/batch-packages-gen.cx -- --query --registry head-registry.tsv --row zzdr | grep -c zzdr; "
            "git show --name-only --format= HEAD | grep -c '^build/links.tsv'; git ls-tree HEAD build/batch-packages.tsv | wc -l; echo END",
            "RC=0\nHEAD\n1\n1\n1\n0\nEND", "derive-registered-links-and-packages-same-commit");
    if (part == 2) {
    s2_want("printf '/* tools/zz-do.cx -- zz no-derive tool */\\nint main(void){return 0;}\\n' > tools/zz-do.cx; "
            CO_RUN "-m do --whole tools/zz-do.cx > do.out 2>&1; echo RC=$?; grep -c COMMIT_OWN_DERIVE do.out; "
            "git show --name-only --format= HEAD; git show HEAD:build/tool-index.tsv | grep -c '^zz-do.cx'; echo END",
            "RC=0\n0\ntools/zz-do.cx\n0\nEND", "derive-off-commits-only-the-path");
    s2_want("printf '# zz\\nzzd\\tzzgen\\tfalse\\ttrue\\tzzd.out\\tzzd-*\\t1\\t5\\n' > $PWD/zzd-manifest.tsv; printf 'i\\n' > zzd-in.txt; H0=$(git rev-parse HEAD); "
            "UNISACC_COMMIT_OWN_DERIVE_MANIFEST=$PWD/zzd-manifest.tsv " CO_RUN "-m dd --whole zzd-in.txt --derive > dd.out 2>&1; echo RC=$?; "
            "grep -c 'COMMIT_OWN_FAIL.class=derive-drift' dd.out; grep -c 'DERIVE.zzd.DRIFT' dd.out; [ \"$H0\" = \"$(git rev-parse HEAD)\" ] && echo SAMEHEAD; echo END",
            "RC=1\n1\n1\nSAMEHEAD\nEND", "derive-drift-named-nothing-committed");
    s2_want("printf 'x\\n' > zzsr-in.txt; H0=$(git rev-parse HEAD); "
            "printf '#!/bin/sh\\necho ran >> %s/zzsr-count\\necho artifact > zzsr.out\\n' \"$PWD\" > zzsr-gen.sh; "
            "printf 'sr\\tzzgen\\ttest -f zzsr.out\\tsh %s/zzsr-gen.sh\\tzzsr.out\\tzzsr-*\\t1\\t5\\n' \"$PWD\" > zzsr-manifest.tsv; "
            "export UNISACC_COMMIT_OWN_DERIVE_MANIFEST=$PWD/zzsr-manifest.tsv; " CO_RUN "-m sr --whole zzsr-in.txt --derive-prepare $PWD/zzsr.rec > zzsr-pre.out 2>&1; echo PRE=$?; "
            "[ \"$H0\" = \"$(git rev-parse HEAD)\" ] && echo SAMEHEAD; D=$(sha256sum zzsr.rec | cut -d' ' -f1); cp zzsr.rec zzsr.saved; "
            "printf 'changed\\n' > zzsr-in.txt; " CO_RUN "-m sr --whole zzsr-in.txt --derive-receipt $PWD/zzsr.rec --derive-id $D > zzsr-stale.out 2>&1; echo STALE=$?; grep -c 'class=derive-identity' zzsr-stale.out; "
            "printf 'x\\n' > zzsr-in.txt; cp zzsr-manifest.tsv zzsr-manifest.saved; printf '# changed\\n' >> zzsr-manifest.tsv; " CO_RUN "-m sr --whole zzsr-in.txt --derive-receipt $PWD/zzsr.rec --derive-id $D > zzsr-ctx.out 2>&1; echo CONTEXT=$?; grep -c 'class=derive-identity' zzsr-ctx.out; cp zzsr-manifest.saved zzsr-manifest.tsv; "
            "printf 'corrupt\\n' >> zzsr.rec; " CO_RUN "-m sr --whole zzsr-in.txt --derive-receipt $PWD/zzsr.rec --derive-id $D > zzsr-bad.out 2>&1; echo CORRUPT=$?; grep -c 'class=derive-identity' zzsr-bad.out; "
            "cp zzsr.saved zzsr.rec; " CO_RUN "-m sr --whole zzsr-in.txt --derive-receipt $PWD/zzsr.rec --derive-id $D > zzsr-ok.out 2>&1; echo RESUME=$?; grep -c 'COMMIT_DERIVE_IDENTITY' zzsr-ok.out; wc -l < zzsr-count; git show HEAD:zzsr-in.txt; git show HEAD:zzsr.out; echo END",
            "PRE=0\nSAMEHEAD\nSTALE=1\n1\nCONTEXT=1\n1\nCORRUPT=1\n1\nRESUME=0\n1\n1\nx\nartifact\nEND", "derive-receipt-identity-no-rerun-stale-and-corrupt-refused");
    }
    /* bound (part 4): every generator runs under its own bound_s of the derive manifest, not under a fixed one.  A
       write that sleeps 4 s passes with bound_s 20 (rc 0, WROTE, at least 4000 ms) and is a TIMEOUT with bound_s 2
       (exit 1, class derive-failed, HEAD unchanged).  The repo's own table is held to the same floor: no row of
       exec/facts/derive.tsv may carry a bound_s under 20 (libc-decls had 3: it fit the warm shared checkout and was a
       TIMEOUT rc 142 on the commit's own tree, where the -run cache is cold; every --derive commit touching include/
       was refused). */
    if (part == 4) {
    s2_want("printf '# zz\\nzzb\\tzzgen\\ttrue\\tsleep 4\\tzzb.out\\tzzb-*\\t1\\t20\\n' > $PWD/zzb-manifest.tsv; printf 'i\\n' > zzb-in.txt; "
            "UNISACC_COMMIT_OWN_DERIVE_MANIFEST=$PWD/zzb-manifest.tsv " CO_RUN "-m db --whole zzb-in.txt --derive > db.out 2>&1; echo RC=$?; "
            "grep -c 'COMMIT_OWN_DERIVE.rc=0.stage=ok' db.out; grep -c 'TIMEOUT' db.out; "
            "ms=$(grep '^DERIVE.zzb.WROTE' db.out | head -1 | cut -f4); [ \"${ms:-0}\" -ge 4000 ] && echo SLEPT; git show --name-only --format= HEAD; echo END",
            "RC=0\n1\n0\nSLEPT\nzzb-in.txt\nEND", "derive-honours-bound-s-sleep-4-under-20");
    s2_want("printf '# zz\\nzzt\\tzzgen\\ttrue\\tsleep 4\\tzzt.out\\tzzt-*\\t1\\t2\\n' > $PWD/zzt-manifest.tsv; printf 'i\\n' > zzt-in.txt; H0=$(git rev-parse HEAD); "
            "UNISACC_COMMIT_OWN_DERIVE_MANIFEST=$PWD/zzt-manifest.tsv " CO_RUN "-m dt2 --whole zzt-in.txt --derive > dt2.out 2>&1; echo RC=$?; "
            "grep -c 'COMMIT_OWN_FAIL.class=derive-failed' dt2.out; grep -c 'DERIVE.zzt.TIMEOUT' dt2.out; [ \"$H0\" = \"$(git rev-parse HEAD)\" ] && echo SAMEHEAD; echo END",
            "RC=1\n1\n1\nSAMEHEAD\nEND", "derive-bound-s-2-times-out-nothing-committed");
    s2_want("echo BEG; cut -f1,8 exec/facts/derive.tsv | grep -v '^#' | while IFS='\t' read -r n b; do [ \"$b\" = - ] || [ \"$b\" -ge 20 ] || echo \"LOW $n $b\"; done; echo END",
            "BEG\nEND", "derive-table-no-bound-under-20");
    }
}
/* --cases bench-a | bench-b: not a batch -- a measurement.  Five small commits through commit-own with the real
   pre-commit hook (tools/precommit.cx) in the clone; prints BENCH<TAB>name<TAB>rc<TAB>ms per commit. */
static void bench_one(const char *name, const char *setup, const char *args) {
    char out[8192], script[6000]; long t0; 
    if (cx_fmt(script, sizeof script,
        "cd %s/clone && %s mkdir -p zzbhooks && printf '#!/bin/sh\\nexec sh ./unisacc.com tools/precommit.cx\\n' > zzbhooks/pre-commit && chmod +x zzbhooks/pre-commit; "
        CO_MK "%s " CO_HK("zzbhooks") CO_RUN "%s > bench.out 2>&1; echo RC=$?; tail -3 bench.out", base,
        sy_env("CO_BENCH_BASE") ? "git show HEAD:tools/commit-own.cx > tools/commit-own.cx;" : "", setup, args, 0, 0)) die("script");
    t0 = sy_now_ms();
    sh(script, out, sizeof out);
    {   long ms = sy_now_ms() - t0, at = tx_find(out, tx_len(out, sizeof out), "RC=", 3);
        sy_printf("BENCH\t%s\trc=%c\tms=%ld\n%s\n", name, at >= 0 ? out[at + 3] : '?', ms, out); }
}
static void bench(int part) {
    if (part == 1) bench_one("b1-whole-txt", "printf 'b\\n' > zz-b1.txt;", "-m b1 --whole zz-b1.txt");
    if (part == 2) bench_one("b2-whole-doc", "printf 'zz bench\\n' >> plans/devsvc.md;", "-m b2 --whole plans/devsvc.md");
    if (part == 3) bench_one("b3-whole-cx", "printf '/* zz bench */\\n' >> tools/own-diff.cx;", "-m b3 --whole tools/own-diff.cx");
    if (part == 4) bench_one("b4-registered-plus-whole-table", "mk zzb4;", "-m b4 --registered zzb4 --whole tests/batches.tsv");
    if (part == 5) bench_one("b5-registered", "mk zzb5;", "-m b5 --registered zzb5");
}

/* Groups of at most two cases.  Measured per case (fresh clone, warm devsvc cache): prep 0.2 s + the tool's own
   15 s (its precommit gate is reused inside the same commit, so it is not run twice) + git; two cases therefore
   land near 31 s and the batch budget is 55 s.  The four artifact cases used to run after EVERY group, which is
   why a one-case group measured 64 s; they are groups of their own now, so a group costs exactly its own cases.
   Nothing asserts less than it did: every case keeps its own assertions and its own clone. */
static const char *co_group(int argc, char **argv) {
    int i;
    for (i = 1; i < argc; i++) if (!strcmp(argv[i], "--cases") && i + 1 < argc) return argv[i + 1];
    return 0;
}
static int co_has(const char *g, const char *a, const char *b) {
    return !g || !strcmp(g, a) || (b && !strcmp(g, b));
}
int main(int argc, char **argv) {
    char out[8192];
    const char *g = co_group(argc, argv);
    char prep[2048], clone[4400];
    if (cx_fmt(base, sizeof base, "%s/check-commit-own-%d", sy_tmpdir(), (int)sy_pid()) || cx_fmt(clone, sizeof clone, "%s/clone", base)) die("path");
    if (cx_fmt(prep, sizeof prep, "rm -rf %s && mkdir -p %s && git clone -q --local . %s && "
           "cp tools/commit-own.cx tools/own-diff.cx tools/on-change.cx tools/check-precommit-gates.cx %s/tools/ && "
           "cd %s && git config user.email t@t && git config user.name t", base, base, clone, clone, clone)) die("path");
    if (sh(prep, out, sizeof out) != 0)
        die("cannot prepare the clone");
    { char marker[4400];const char *text="UNISACC_GATE_FIXTURE_V1\n";
      if(cx_fmt(marker,sizeof marker,"%s/.commit-gate-fixture",clone)||
         sy_write_atomic(marker,text,strlen(text),0600))die("fixture-marker-write"); }
    /* The product into the clone: which files make up "the product" is a layout question, so ask
       productpkg rather than naming unisacc.com.dev here. A hardcoded `cp -r unisacc.com.dev`
       breaks the day a complete APE ships again, and silently copies nothing when the layout is
       PE-only. */
    {   char root[4400];
        if (sy_cwd(root, sizeof root) < 0) die("cwd");
        if (pp_copy_product(root, clone)) die("cannot copy the product into the clone");
        char source[4400],product[4400];
        if(cx_fmt(source,sizeof source,"%s/tools/fixture-gate-tool.cx",root)||
           cx_fmt(product,sizeof product,"%s/unisacc.com",root)||
           sy_setenv("COMMIT_GATE_FIXTURE_SOURCE",source,1)||
           sy_setenv("COMMIT_GATE_FIXTURE_PRODUCT",product,1))die("fixture-tool-env");
    }
    /* One case per batch: a single real commit costs ~30 s in this tool (its precommit gate plus git plus the
       checks), so two cases measure 60 s and cannot fit the 55 s budget.  Every case keeps its assertions and its
       own clone; the previous three-batch split is retired with every assertion carried over one-for-one.  The
       artifact cases used to run after every group and now have groups of their own, so a group costs exactly its
       own case.  No --cases argument runs everything. */
    if (co_has(g, "lock", 0)) case_("lock", 4);
    if (co_has(g, "nolock", 0)) case_("nolock", 0);
    if (co_has(g, "symlink", 0)) case_symlink();
    if (co_has(g, "dirlink", 0)) case_dirlink();
    if (co_has(g, "keyed", 0)) case_keyed();
    if (co_has(g, "multikey", 0)) case_multikey();
    if (co_has(g, "reg-a", 0)) case_registered(1);
    if (co_has(g, "reg-b", 0)) case_registered(2);
    if (co_has(g, "reg-c", 0)) case_registered(3);
    if (co_has(g, "reg-refuse", 0)) case_registered_refuse();
    if (g && !strncmp(g, "bench-", 6)) bench(g[6] - 0x30);
    if (co_has(g, "s2", 0)) { case_s2(0); case_s2(1); case_s2(2); }
    if (co_has(g, "s2b", 0)) case_s2(3);
    if (co_has(g, "derive-tool", 0)) case_derive(0);
    if (co_has(g, "derive-reg-prep", 0)) case_derive(3);
    if (co_has(g, "derive-reg", 0)) case_derive(1);
    if (co_has(g, "derive-neg", 0)) case_derive(2);
    if (co_has(g, "derive-bound", "derive-neg")) case_derive(4);   /* also part of the derive-neg batch */
    /* case_s2 removes tools/on-change.cx from the clone; with no --cases every group shares that clone, so put it
       back before the artifacts group asserts the pending-derived hint */
    if (!g) {   char o[256], s[9000];
        if (!cx_fmt(s, sizeof s, "cp tools/on-change.cx %s/tools/", clone, 0, 0, 0, 0)) sh(s, o, sizeof o); }
    if (co_has(g, "foreign", 0))
    {   char out[8192], script[2048];
        if (cx_fmt(script, sizeof script,
            "cd %s/clone && printf 'f\\n' > foreign.txt && git add -- foreign.txt && printf 'm\\n' > mine-own.txt && "
            "sh ./unisacc.com tools/devsvc.cx -- run --local tools/commit-own.cx -- -m mine --whole mine-own.txt 2>&1; echo CACHED; git diff --cached --name-only", base))
            die("script");
        sh(script, out, sizeof out);
        ck(tx_find(out, tx_len(out, sizeof out), "cached-foreign", 14) >= 0 &&
           tx_find(out, tx_len(out, sizeof out), "CACHED\nforeign.txt", 18) >= 0, "foreign-staged-kept");
    }
    /* prestaged (2026-11-16, three times in one day: tools/check-tape-gap.cx after ca2ed83ca9): an OLD version of a
       tracked path is staged in the shared index, the work tree is edited again, the path is committed --whole.  The
       shared index entry must be the committed blob (git status shows nothing for the path), the dropped staged blob
       is named in a NOTE; a path that is NOT in the commit keeps its staged entry (the foreign case above). */
    if (co_has(g, "prestaged", "foreign"))   /* also part of the foreign batch */
        s2_want("printf 'v1\\n' > zz-pre.txt && git add -- zz-pre.txt && git commit -q --no-verify -m pre0 -- zz-pre.txt && "
                "printf 'v2-staged-old\\n' > zz-pre.txt && git add -- zz-pre.txt && printf 'v3-work\\n' > zz-pre.txt && "
                CO_RUN "-m pre --whole zz-pre.txt > pre.out 2>&1; echo RC=$?; grep -c 'index_unsynced=0' pre.out; grep -c 'NOTE.zz-pre.txt.the shared index held a staged version' pre.out; "
                "[ \"$(git ls-files -s -- zz-pre.txt | cut -c8-47)\" = \"$(git rev-parse HEAD:zz-pre.txt)\" ] && echo SAMEBLOB; git cat-file -p HEAD:zz-pre.txt; "
                "echo ST; git status --short -- zz-pre.txt; echo END",
                "RC=0\n1\n1\nSAMEBLOB\nv3-work\nST\nEND", "prestaged-old-version-index-equals-head-after-commit");
    if(co_has(g,"artifacts",0))prepare_materialized_catalog(1);
    if (co_has(g, "artifacts", 0)) 
    {   char out[8192], script[2048];   /* pending-derived 提示:改 tools/ 下 .cx 含 tool-index;无关路径不含;提示不改 rc */
        if (cx_fmt(script, sizeof script,
            "cd %s/clone && printf 'int main(void){return 0;}\\n' > tools/zz-pend.cx && "
            "sh ./unisacc.com tools/devsvc.cx -- run --local tools/commit-own.cx -- -m pend --whole tools/zz-pend.cx 2>&1; echo RC=$?", base)) die("script");
        sh(script, out, sizeof out);
        ck(tx_find(out, tx_len(out, sizeof out), "pending-derived=tool-index", 26) >= 0 &&
           tx_find(out, tx_len(out, sizeof out), "RC=0", 4) >= 0, "pending-derived-tool-index");
        if (cx_fmt(script, sizeof script,
            "cd %s/clone && printf 'q\\n' > zz-plain.txt && "
            "sh ./unisacc.com tools/devsvc.cx -- run --local tools/commit-own.cx -- -m plain --whole zz-plain.txt 2>&1; echo RC=$?", base)) die("script");
        sh(script, out, sizeof out);
        ck(tx_find(out, tx_len(out, sizeof out), "pending-derived=", 16) < 0 &&
           tx_find(out, tx_len(out, sizeof out), "RC=0", 4) >= 0, "no-pending-derived-for-unrelated");
    }
    if (co_has(g, "hookfail", 0)) 
    {   char out[8192], script[2048];   /* git commit 失败:末行 refused 带 git stderr 首行原因(此处由失败的 pre-commit 钩子给出) */
        if (cx_fmt(script, sizeof script,
            "cd %s/clone && mkdir -p zzhooks && printf '#!/bin/sh\\necho ZZHOOKREASON >&2\\nexit 1\\n' > zzhooks/pre-commit && chmod +x zzhooks/pre-commit && "
            "printf 'h\\n' > zz-hookfail.txt && GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.hooksPath GIT_CONFIG_VALUE_0=$PWD/zzhooks "
            "sh ./unisacc.com tools/devsvc.cx -- run --local tools/commit-own.cx -- -m hookfail --whole zz-hookfail.txt 2>&1 | grep -v DEVSVC_RUN | tail -1", base)) die("script");
        sh(script, out, sizeof out);
        ck(tx_find(out, tx_len(out, sizeof out), "git commit refused (rc 1): ZZHOOKREASON", 39) >= 0, "commit-refused-names-git-reason");
    }
done:
    if (failed) sy_eprintf("CHECK_COMMIT_OWN_DIAGNOSTICS retained=%s/clone\n", base);
    else { char rm[4500]; if (!cx_fmt(rm, sizeof rm, "rm -rf %s", base)) sh(rm, out, sizeof out); }
    sy_printf("CHECK_COMMIT_OWN\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
