#pragma unisa use text.text
/* safedel: the argv-only CLI of the one deletion guard, include/unisa_safedel.h (commissar ruling 2026-10-23), for
   sh, make, CI and the remaining Python callers.  Always an argv list, never a shell string:
     sh tests/cxbin tests/safedel.cx [--dry-run] [--purge] [--max-files N] [--force-count N] [-v] [--] PATH...
     sh tests/cxbin tests/safedel.cx --purge-trash HOME --older-than HOURS [--dry-run] [--max-files N] [--force-count N] [-v]
   Options are read anywhere before `--`; a path that starts with `-` comes after `--`.  Every PATH is checked (a dry
   run of the guard) before any is touched: one refusal and nothing is deleted.  Default: each PATH (a tree) moves into
   the .trash of its root; --purge deletes it for good.  The ceiling is --max-files entries per PATH (default
   SAFEDEL_MAX_FILES; for --purge-trash the summed expired entries); above it only an explicit --force-count N, N at
   least the count, proceeds.  --purge-trash HOME (the temp root or a repository root) purges HOME/.trash entries older
   than HOURS.  rc 0 done (a missing PATH included), 3 refused (nothing deleted), 2 usage, 1 an I/O error after the
   checks passed (the paths before it are done, the rest untouched). */
static int usage(const char *m) {
    fprintf(stderr, "safedel: %s\nusage: safedel [--dry-run] [--purge] [--max-files N] [--force-count N] [-v] [--] PATH...\n"
                    "       safedel --purge-trash HOME --older-than HOURS [--dry-run] [--max-files N] [--force-count N] [-v]\n", m);
    return 2;
}
/* a decimal count: digits only, at most 15 of them */
static int number(const char *s, long *v) {
    long x = 0; int n = 0;
    if (!s) return -1;
    for (; s[n]; n++) { if (s[n] < '0' || s[n] > '9' || n >= 15) return -1; x = x * 10 + (s[n] - '0'); }
    if (!n) return -1;
    *v = x; return 0;
}
int main(int argc, char **argv) {
    unsigned flags = SAFEDEL_RECURSIVE; int dry = 0, verbose = 0, purge = 0, i, np = 0, rc, worst = 0, ends = 0;
    long maxf = -1, force = -1, hours = -1, limit;   /* -1: not given */
    const char *home = 0; char why[1400]; const char **paths;
    paths = (const char **)calloc((size_t)argc + 1, sizeof *paths);
    if (!paths) return 2;
    for (i = 1; i < argc; i++) {
        const char *a = argv[i]; long *slot = 0;
        if (ends || a[0] != '-' || !a[1]) { paths[np++] = a; continue; }
        if (tx_eq(a, "--", 1L << 20)) { ends = 1; continue; }
        if (tx_eq(a, "--dry-run", 1L << 20)) { dry = 1; continue; }
        if (tx_eq(a, "--purge", 1L << 20)) { purge = 1; continue; }
        if (tx_eq(a, "-v", 1L << 20) || tx_eq(a, "--verbose", 1L << 20)) { verbose = 1; continue; }
        if (tx_eq(a, "--max-files", 1L << 20)) slot = &maxf;
        else if (tx_eq(a, "--force-count", 1L << 20)) slot = &force;
        else if (tx_eq(a, "--older-than", 1L << 20)) slot = &hours;
        else if (tx_eq(a, "--purge-trash", 1L << 20)) {
            if (i + 1 >= argc) return usage("--purge-trash needs HOME");
            home = argv[++i]; continue;
        } else return usage("unknown option");
        if (i + 1 >= argc || number(argv[i + 1], slot) != 0) return usage("an option needs a decimal count");
        i++;
    }
    if (!maxf || !force) return usage("--max-files and --force-count take a count of at least 1");
    limit = maxf > 0 ? maxf : SAFEDEL_MAX_FILES;
    if (force > limit) limit = force;
    if (home) {
        if (np) return usage("--purge-trash takes no PATH");
        if (purge) return usage("--purge-trash always purges");
        if (hours < 0) return usage("--purge-trash needs --older-than HOURS");
        rc = unisa_safedel_purge_trash(home, hours, limit, dry ? SAFEDEL_DRYRUN : 0u, why, (int)sizeof why);
        if (rc) fprintf(stderr, "safedel: %s: %s\n", rc == SAFEDEL_REFUSED ? "refused" : "failed", why);
        else if (dry || verbose) printf("safedel: %s\n", why);
        return rc;
    }
    if (hours >= 0) return usage("--older-than belongs to --purge-trash");
    if (!np) return usage("no PATH");
    if (purge) flags |= SAFEDEL_PURGE;
    for (i = 0; i < np; i++) {
        rc = unisa_safedel(paths[i], flags | SAFEDEL_DRYRUN, limit, why, (int)sizeof why);
        if (rc) { fprintf(stderr, "safedel: %s: %s\n", rc == SAFEDEL_REFUSED ? "refused" : "failed", why); if (rc == SAFEDEL_REFUSED || !worst) worst = rc; }
        else if (dry) printf("safedel: %s\n", why);
    }
    if (worst) { fprintf(stderr, "safedel: nothing deleted\n"); return worst; }
    if (dry) return 0;
    for (i = 0; i < np; i++) {
        rc = unisa_safedel(paths[i], flags, limit, why, (int)sizeof why);
        if (rc) { fprintf(stderr, "safedel: %s: %s\n", rc == SAFEDEL_REFUSED ? "refused" : "failed", why); return rc; }
        if (verbose) printf("safedel: %s\n", why);
    }
    return 0;
}
