/* Checks tools/refactor.cx: sh ./unisacc.com tools/check-refactor.cx   (from the repo root)
   find: the truth rule takes exactly the five truth-value uses in tools/refactor/truth-cases.txt and
   none of the nine value, comparison, argument, '!' and bitwise uses; the '!' rule takes only line 11;
   the where column ($3=1L << 20) takes the two tx_eq calls of tools/refactor/eqz-cases.txt whose third
   argument is exactly that text, not cap 8 or another spelling; sites lists all 13 strcmp and f calls of the
   truth fixture, the nested f(strcmp(...)) as two, and none of the calls quoted in its comments; rename
   oldf newf on tools/refactor/rename-cases.txt takes the definition (line 3), the pointer and the call
   (line 4), not the comment, the string, OLDN or OLDN_x.
   apply, on a copy in out/: a check whose output does not change keeps the edit (OK); a check that
   prints the file sees the edit and restores the copy byte for byte (REVERT, rc 1).
   Prints PASS/FAIL lines and CHECK_REFACTOR<TAB>failed=N. */
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use sys.time
#pragma unisa use sysx.poll
#pragma unisa use sys.posix
#pragma unisa use sys.env

/* an unlinked spool file the drained output of a bounded child goes to */
static int spool_open(void) {
    char t[4096];
    int fd;
    if (cx_fmt(t, sizeof t, "%s/r2b-XXXXXX", sy_tmpdir())) return -1;
    fd = mkstemp(t);
    if (fd >= 0) sy_unlink(t);
    return fd;
}

/* sy_spawn_pipe with a 50 s deadline: the child's stdout (and stderr when EFD is given) is drained here with sy_poll
   into spool files; past the deadline its process group is killed.  OFD/EFD come back as the spool files, rewound,
   and the child is NOT reaped: the caller's sy_wait_status(pid) still reports its real status (128+9 when killed). */
static int spawn_pipe_bounded(char **argv, const char *cwd, int flags, int *ofd, int *efd) {
    int po = -1, pe = -1, pid, fo, fe = -1, open_o = 1, open_e = efd ? 1 : 0, killed = 0;
    long deadline = sy_now_ms() + 50000;
    char chunk[16384];
    pid = sy_spawn_pipe(argv, cwd, flags, &po, efd ? &pe : 0);
    if (pid < 0) return pid;
    fo = spool_open();
    if (efd) fe = spool_open();
    if (fo < 0 || (efd && fe < 0)) { sy_killpg(pid, 9); sy_signal(pid, 9); sy_close(po); if (efd) sy_close(pe); return -EIO; }
    while (open_o || open_e) {
        sy_pollfd_t p[2];
        int n = 0, io = -1, ie = -1, r;
        long left = deadline - sy_now_ms(), g;
        if (left <= 0) {
            if (killed) break;
            sy_killpg(pid, 9); sy_signal(pid, 9); killed = 1; deadline = sy_now_ms() + 2000;
            continue;
        }
        if (open_o) { io = n; p[n].fd = po; p[n].events = SY_POLLIN; p[n].revents = 0; n++; }
        if (open_e) { ie = n; p[n].fd = pe; p[n].events = SY_POLLIN; p[n].revents = 0; n++; }
        r = sy_poll(p, n, left > 200 ? 200 : left);
        if (r < 0) break;
        if (io >= 0 && p[io].revents) {
            g = sy_read(po, chunk, sizeof chunk);
            if (g > 0) { if (sy_write_all(fo, chunk, g)) break; } else open_o = 0;
        }
        if (ie >= 0 && p[ie].revents) {
            g = sy_read(pe, chunk, sizeof chunk);
            if (g > 0) { if (sy_write_all(fe, chunk, g)) break; } else open_e = 0;
        }
    }
    if (open_o || open_e) { sy_killpg(pid, 9); sy_signal(pid, 9); }
    sy_close(po);
    if (efd) sy_close(pe);
    sy_lseek(fo, 0, 0);
    *ofd = fo;
    if (efd) { sy_lseek(fe, 0, 0); *efd = fe; }
    return pid;
}

static int failed;
static void ck(int ok, const char *name) { if (!ok) failed++; printf("%s\trefactor.%s\n", ok ? "PASS" : "FAIL", name); }

/* runs sh ./unisacc.com tools/refactor.cx -- A...; stdout into out (cap bytes, terminated); returns the exit code or -1 */
static int tool(char **args, char *out, long cap) {
    char *argv[16]; int i = 0, k, ofd, efd, pid, ex = 0, code = 0, sig = 0; long n = 0, r; char junk[4096];
    argv[i++] = "sh"; argv[i++] = "./unisacc.com"; argv[i++] = "tools/refactor.cx"; argv[i++] = "--";
    for (k = 0; args[k] && i < 15; k++) argv[i++] = args[k];
    argv[i] = 0;
    pid = spawn_pipe_bounded(argv, 0, SY_SPAWN_STDERR_SPLIT, &ofd, &efd);
    if (pid < 0) return -1;
    while ((r = sy_read(ofd, out + n, cap - 1 - n)) > 0) n += r;
    out[n] = 0;
    while (sy_read(ofd, junk, sizeof junk) > 0) {}
    while (sy_read(efd, junk, sizeof junk) > 0) {}
    sy_close(ofd); sy_close(efd);
    if (sy_wait_status(pid, 0, &ex, &code, &sig) != pid || !ex) return -1;
    return code;
}

/* the line field (4th) of every row naming FILE, as " 3 4" */
static void lines_of(const char *tsv, const char *file, char *dst, long cap) {
    const char *p = tsv; long fl = tx_len(file, 4096), dn = 0;
    dst[0] = 0;
    while (*p) {
        const char *e = p, *f[5]; int k = 0;
        while (*e && *e != '\n') e++;
        f[0] = p;
        for (const char *q = p; q < e && k < 4; q++) if (*q == '\t') f[++k] = q + 1;
        if (k == 4 && tx_prefix(f[1], e - f[1], file, fl) && f[1][fl] == '\t') {
            long ln = 0; while (f[3][ln] != '\t') ln++;
            if (dn + ln + 2 < cap) { dst[dn++] = ' '; tx_copy(dst + dn, cap - dn, f[3], ln); dn += ln; }
        }
        p = *e ? e + 1 : e;
    }
}

/* structural row/line assertions over tool output or a result file: no substring search.
   mode 'P' some line (leading blanks ignored) starts with PAT; 'S' some line ends with PAT; 'E' some line equals PAT;
   'F' some tab-separated field equals PAT; 'G' some tab-separated field starts with PAT.  Returns 1 when any line matches. */
static int has_line(const char *buf, long n, char mode, const char *pat) {
    long pl = tx_len(pat, 4096), p = 0;
    while (p < n) {
        long e = p, s;
        while (e < n && buf[e] != '\n') e++;
        s = p;
        if (mode != 'S' && mode != 'E') while (s < e && (buf[s] == ' ' || buf[s] == '\t')) s++;
        if (mode == 'P' && e - s >= pl && tx_prefix(buf + s, e - s, pat, pl)) return 1;
        if (mode == 'S' && e - s >= pl && tx_prefix(buf + e - pl, pl, pat, pl)) return 1;
        if (mode == 'E' && e - s == pl && tx_prefix(buf + s, e - s, pat, pl)) return 1;
        if (mode == 'F' || mode == 'G') {
            long f = p;
            while (f <= e) {
                long g = f;
                while (g < e && buf[g] != '\t') g++;
                if (mode == 'F' && g - f == pl && tx_prefix(buf + f, g - f, pat, pl)) return 1;
                if (mode == 'G' && g - f >= pl && tx_prefix(buf + f, g - f, pat, pl)) return 1;
                f = g + 1;
            }
        }
        p = e + 1;
    }
    return 0;
}

static int put_file(const char *path, const char *s, long n) {
    int fd = sy_open_new(path, 0644), bad;
    if (fd < 0) return 1;
    bad = sy_write_all(fd, s, n) != 0;
    return sy_close(fd) != 0 || bad;
}

int main(void) {
    static char out[1 << 16], got[256], dir[256], copy[300], cands[300], acc[1 << 16];
    const char *cases = "tools/refactor/truth-cases.txt";
    size_t sn, an; char *src = cx_read(cases, &sn), *after; long i, n;
    int rc;
    char *truth[] = {"find", "tools/refactor/strcmp-truth.tsv", (char *)cases, 0};
    char *bang[] = {"find", "tools/refactor/strcmp-eq.tsv", (char *)cases, 0};

    ck(src != 0, "fixture-readable");
    rc = tool(truth, out, sizeof out); lines_of(out, cases, got, sizeof got);
    ck(rc == 0 && tx_eq(got, " 3 4 5 6 14", 64), "find-truth-takes-only-truth-uses");
    rc = tool(bang, out, sizeof out); lines_of(out, cases, got, sizeof got);
    ck(rc == 0 && tx_eq(got, " 11", 64), "find-bang-takes-only-bang");
    {   char *ren[] = {"rename", "--auto", "oldf", "newf", "tools/refactor/rename-cases.txt", 0};
        rc = tool(ren, out, sizeof out); lines_of(out, "tools/refactor/rename-cases.txt", got, sizeof got);
        ck(rc == 0 && tx_eq(got, " 3 4 4", 64) && has_line(out, tx_len(out, sizeof out), 'P', "accept\t")
           && has_line(out, tx_len(out, sizeof out), 'S', "\toldf\tnewf\t-"), "rename-definition-pointer-call-not-comment-or-string");
    }
    {   char *sites[] = {"sites", "strcmp,f", (char *)cases, 0}; long nl = 0, q;
        rc = tool(sites, out, sizeof out);
        for (q = 0; out[q]; q++) if (out[q] == '\n') nl++;
        ck(rc == 0 && nl == 13 && has_line(out, tx_len(out, sizeof out), 'S', "truth-cases.txt:10\tf(strcmp(v[0], \"h\"))")
           && has_line(out, tx_len(out, sizeof out), 'S', "truth-cases.txt:10\tstrcmp(v[0], \"h\")"),
           "sites-lists-every-call-nested-too-not-comments");
    }
    {   char *fold[] = {"find", "tools/refactor/eqz-fold.tsv", "tools/refactor/eqz-cases.txt", 0};
        rc = tool(fold, out, sizeof out); lines_of(out, "tools/refactor/eqz-cases.txt", got, sizeof got);
        ck(rc == 0 && tx_eq(got, " 4 5", 64) && has_line(out, tx_len(out, sizeof out), 'F', "tx_eqz(v[0], \"b\")"),
           "find-where-takes-only-that-argument-text");
    }

    /* apply on a copy: accept every row of the truth rule */
    if (cx_fmt(dir, sizeof dir, "%s/check-refactor-%d", sy_tmpdir(), sy_pid()) || cx_fmt(copy, sizeof copy, "%s/t.cx", dir)
        || cx_fmt(cands, sizeof cands, "%s/cands.tsv", dir) || !src) return 2;
    sy_mkdir("out", 0755);
    if (sy_mkdir(dir, 0755) != 0 || put_file(copy, src, (long)sn)) { ck(0, "scratch-copy"); goto done; }
    {   char *find[] = {"find", "tools/refactor/strcmp-truth.tsv", copy, 0};
        rc = tool(find, out, sizeof out);
        n = tx_len(out, sizeof out); an = 0;
        for (i = 0; i < n; i++) {   /* "-\t" at a row start becomes "accept\t" */
            if ((i == 0 || out[i - 1] == '\n') && out[i] == '-' && i + 1 < n && out[i + 1] == '\t') { tx_copy(acc + an, 8, "accept", 6); an += 6; continue; }
            acc[an++] = out[i];
        }
        ck(rc == 0 && put_file(cands, acc, (long)an) == 0, "candidates-written");
    }
    {   char *revert[] = {"apply", cands, "2", "cat {file}", 0};
        rc = tool(revert, out, sizeof out); after = cx_read(copy, &an);
        ck(rc == 1 && has_line(out, tx_len(out, sizeof out), 'P', "REVERT\t") && after && tx_same(after, (long)an, src, (long)sn),
           "apply-changed-output-reverts-byte-for-byte");
    }
    {   char *keep[] = {"apply", cands, "2", "true", 0};
        rc = tool(keep, out, sizeof out); after = cx_read(copy, &an);
        ck(rc == 0 && has_line(out, tx_len(out, sizeof out), 'P', "OK\t") && after
           && has_line(after, (long)an, 'P', "if (!tx_eq(v[0], \"a\", 1L << 20)) n++;")
           && has_line(after, (long)an, 'P', "if (strcmp(v[0], \"e\") < 0) n++;")
           && has_line(after, (long)an, 'P', "#pragma unisa use text.text"),
           "apply-same-output-keeps-edit");
    }
    sy_unlink(copy); sy_unlink(cands);   /* the empty scratch directory stays under sy_tmpdir(), not in the repo's out/ */
    {   /* sweep in a scratch dir with its own text link and its own copy of the rules (so its skip list is its own):
           one fixable file OK, one whose compile fails before the edit SKIP and skip-listed, nothing remaining;
           a second sweep finds nothing to do */
        char sd[300], good[340], bad[340], rules[340], *sk; size_t skn, rn; char *rsrc = cx_read("tools/refactor/strcmp-eq.tsv", &rn);
        const char *gsrc = "int main(int c, char **v) { if (!strcmp(v[0], \"x\")) return 1; return c; }\n";
        const char *bsrc = "int main(void) { return !strcmp(\"a\", \"b\") + undeclared_var; }\n";
        char rootabs[1024], textabs[1100];   /* scratch is outside the repo, so the text link is absolute */
        if (sy_realpath(".", rootabs, sizeof rootabs) < 0 || cx_fmt(textabs, sizeof textabs, "%s/cx/text", rootabs)) return 2;
        if (cx_fmt(sd, sizeof sd, "%s/check-refactor-%d-sweep", sy_tmpdir(), sy_pid()) || cx_fmt(good, sizeof good, "%s/g.cx", sd)
            || cx_fmt(bad, sizeof bad, "%s/b.cx", sd) || cx_fmt(rules, sizeof rules, "%s/rules.tsv", sd) || !rsrc) return 2;
        {   char *lnv[] = {"ln", "-s", textabs, "text", 0}; int lpid, lfd = -1;
            if (sy_mkdir(sd, 0755) != 0 || put_file(good, gsrc, tx_len(gsrc, 4096)) || put_file(bad, bsrc, tx_len(bsrc, 4096)) || put_file(rules, rsrc, (long)rn)) { ck(0, "sweep-scratch"); goto done; }
            lpid = spawn_pipe_bounded(lnv, sd, 0, &lfd, 0);
            if (lpid > 0) { char junk[256]; while (sy_read(lfd, junk, sizeof junk) > 0) {} sy_close(lfd); sy_wait_status(lpid, 0, 0, 0, 0); }
        }
        {   char *sw[] = {"sweep", rules, "2", good, bad, "--", "sh ./unisacc.com -c -b lnx/x86_64 {file} -o /dev/null && echo compiled", 0};
            rc = tool(sw, out, sizeof out); after = cx_read(good, &an);
            ck(rc == 0 && has_line(out, tx_len(out, sizeof out), 'P', "SWEEP\tok=1\tskip=1\trevert=0\tdefer=0\tremaining=0\t")
               && after && has_line(after, (long)an, 'P', "int main(int c, char **v) { if (tx_eq(v[0], \"x\", 1L << 20)) return 1; return c; }"), "sweep-fixes-one-skips-one");
        }
        {   char skp[400]; long i; char rb[340];
            tx_copy(rb, sizeof rb, rules, tx_len(rules, sizeof rb)); for (i = 0; rb[i]; i++) if (rb[i] == '/') rb[i] = '_';
            if (cx_fmt(skp, sizeof skp, "out/refactor-verify/skip-%s.txt", rb)) return 2;
            sk = cx_read(skp, &skn);
            ck(sk && has_line(sk, (long)skn, 'E', bad) && !has_line(sk, (long)skn, 'E', good), "sweep-skip-list-has-only-the-failed-file");
            {   char *sw2[] = {"sweep", rules, "2", good, bad, "--", "true", 0};
                rc = tool(sw2, out, sizeof out);
                ck(rc == 0 && has_line(out, tx_len(out, sizeof out), 'P', "SWEEP\tok=0\tskip=0\trevert=0\tdefer=0\tremaining=0\t"), "sweep-again-nothing-to-do");
            }
            sy_unlink(skp);
        }
        {   /* a file that already has 32 uses cannot take another: skip, not safe (installed-product limit) */
            char full[340], src[2048]; int at = 0, u;
            if (cx_fmt(full, sizeof full, "%s/full.cx", sd)) return 2;
            for (u = 1; u <= 32; u++) { if (cx_fmt(src + at, sizeof src - at, "#pragma unisa use m%d\n", u)) return 2; at += (int)tx_len(src + at, 64); }
            if (cx_fmt(src + at, sizeof src - at, "int f(char *a) { return !strcmp(a, \"x\"); }\n")) return 2;
            if (put_file(full, src, tx_len(src, sizeof src))) { ck(0, "use-limit-scratch"); goto done; }
            {   char *fu[] = {"find", "--auto", "tools/refactor/strcmp-eqz.tsv", full, 0};
                rc = tool(fu, out, sizeof out);
                ck(rc == 0 && has_line(out, tx_len(out, sizeof out), 'G', "a new use would pass the 32-use limit")
                   && has_line(out, tx_len(out, sizeof out), 'F', "skip") && !has_line(out, tx_len(out, sizeof out), 'P', "accept\t"), "find-refuses-a-33rd-use");
            }
            sy_unlink(full);
        }
    }
done:
    printf("CHECK_REFACTOR\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
