#pragma unisa use runtime.package_decode
static int calls,fail_at,live;
static void *grow(void *p,size_t n){calls++;if(calls==fail_at)return 0;if(p)return realloc(p,n);void *q=malloc(n);if(q)live++;return q;}
static void drop(void *p){if(p){live--;free(p);}}
static int failed;
static void check(int ok,const char *name){if(!ok){fprintf(stderr,"FAIL %s\n",name);failed++;}else printf("PASS %s\n",name);}
int main(int argc,char **argv){
 const char text[]="P 1 1 1\nD r s in out 0\nM 1\nN";
 CxPackageDecode d={0};d.allocate=grow;d.release=drop;
 check(!cxpk_decode(&d,(const unsigned char *)text,sizeof text-1),"valid");
 check(d.package.complete&&d.package.ver==1&&d.package.m==1&&d.package.s==1&&d.package.nr==0,"counts");
 check(!strcmp(d.package.stages[0].route,"r")&&!strcmp(d.package.stages[0].name,"s")&&d.package.stages[0].model==0,"stage");
 check(d.package.len[0]==1&&text[d.package.off[0]]=='N'&&d.package.raw[0]==1,"model");
 cxpl_release(&d.package,drop);check(live==0,"release");
 int complete=0;for(int i=1;i<20;i++){calls=0;fail_at=i;int rc=cxpk_decode(&d,(const unsigned char *)text,sizeof text-1);if(!rc){complete=1;cxpl_release(&d.package,drop);break;}check(!live&&!strcmp(d.why,"out of memory"),"allocation-cleanup");}
 check(complete&&!live,"allocation-complete");fail_at=0;
 const char bad[]="P 1 1 1\nD r s in out 0\nM 1\nX";
 check(cxpk_decode(&d,(const unsigned char *)bad,sizeof bad-1)&&!strcmp(d.why,"package requires networks")&&!live,"bad-model");
 if(argc>1){size_t n;char *data=cx_read(argv[1],&n);if(!data||n>2147483647UL)return 2;
  int rc=cxpk_decode(&d,(const unsigned char *)data,(long)n);
  if(rc)fprintf(stderr,"package decode: %s\n",d.why?d.why:"bad argument");
  check(!rc,"real-package");if(!rc)check(d.package.ver==3&&d.package.m==32&&d.package.s==1479&&d.package.nr==74,"real-package-counts");
  cxpl_release(&d.package,drop);check(!live,"real-package-release");free(data);
 }
 printf("CXPACKAGE_DECODE failed=%d\n",failed);return failed?1:0;
}
