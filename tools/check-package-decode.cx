/* tools/check-package-decode.cx -- runtime.package_decode 解码与分配失败注入的检查。 */
#pragma unisa use runtime.package_decode
#pragma unisa use runtime.package_lifetime
#pragma unisa use runtime.model_number
#pragma unisa use compiler.bindstage
#pragma unisa use text.text
static int same_text(const char *a,const char *b){return tx_eq(a,b,1L<<20);}
static int calls,fail_at,live;
static void *grow(void *p,size_t n){calls++;if(calls==fail_at)return 0;if(p)return realloc(p,n);void *q=malloc(n);if(q)live++;return q;}
static void drop(void *p){if(p){live--;free(p);}}
static int failed;
static void check(int ok,const char *name){if(!ok){fprintf(stderr,"FAIL %s\n",name);failed++;}else printf("PASS %s\n",name);}
int main(int argc,char **argv){
 const char text[]="P 1 1 1\nD r s in out 0\nM 1\nN";
 CxPackageDecode d={0};d.allocate=grow;d.release=drop;
 check(!cxpk_decode(&d,(const unsigned char *)text,sizeof text-1),"valid");
 check(d.package.complete&&d.package.ver==1&&d.package.m==1&&d.package.s==1&&d.package.nr==0,"counts");
 check(same_text(d.package.stages[0].route,"r")&&same_text(d.package.stages[0].name,"s")&&d.package.stages[0].model==0,"stage");
 check(d.package.len[0]==1&&text[d.package.off[0]]=='N'&&d.package.raw[0]==1,"model");
 cxpl_release(&d.package,drop);check(live==0,"release");
 const char p4raw[]="P 4 1 1 2\nD r s in out 0\nM 1 1 1 0\nAF 1 3 3 0 0\nkvalF 2 1 4 1 7\nxyw";
 check(!cxpk_decode(&d,(const unsigned char *)p4raw,sizeof p4raw-1),"p4-six-word-resource");
 check(d.package.complete&&d.package.ver==4&&d.package.nr==2,"p4-counts");
 check(d.package.res[0].len==3&&d.package.res[0].rawlen==3&&d.package.res[0].codec==0&&d.package.res[0].crc==0,"p4-raw-resource-fields");
 check(d.package.res[1].len==1&&d.package.res[1].rawlen==4&&d.package.res[1].codec==1&&d.package.res[1].crc==7,"p4-packed-resource-fields");
 cxpl_release(&d.package,drop);check(!live,"p4-release");
 const char p4badraw[]="P 4 1 1 1\nD r s in out 0\nM 1 1 1 0\nAF 1 3 4 0 0\nkval";
 check(cxpk_decode(&d,(const unsigned char *)p4badraw,sizeof p4badraw-1)&&same_text(d.why,"raw resource rawlen mismatch")&&!live,"p4-rawlen-mismatch");
 const char p4badcodec[]="P 4 1 1 1\nD r s in out 0\nM 1 1 1 0\nAF 1 3 3 2 0\nkval";
 check(cxpk_decode(&d,(const unsigned char *)p4badcodec,sizeof p4badcodec-1)&&same_text(d.why,"bad resource codec")&&!live,"p4-codec-refused");
 const char p4short[]="P 4 1 1 1\nD r s in out 0\nM 1 1 1 0\nAF 1 3\nkval";
 check(cxpk_decode(&d,(const unsigned char *)p4short,sizeof p4short-1)&&!live,"p4-five-word-resource-refused");
 int complete=0;for(int i=1;i<20;i++){calls=0;fail_at=i;int rc=cxpk_decode(&d,(const unsigned char *)text,sizeof text-1);if(!rc){complete=1;cxpl_release(&d.package,drop);break;}check(!live&&same_text(d.why,"out of memory"),"allocation-cleanup");}
 check(complete&&!live,"allocation-complete");fail_at=0;
 const char bad[]="P 1 1 1\nD r s in out 0\nM 1\nX";
 check(cxpk_decode(&d,(const unsigned char *)bad,sizeof bad-1)&&same_text(d.why,"package requires networks")&&!live,"bad-model");
 if(argc>1){size_t n;char *data=cx_read(argv[1],&n);if(!data||n>2147483647UL)return 2;
  int rc=cxpk_decode(&d,(const unsigned char *)data,(long)n);
  if(rc)fprintf(stderr,"package decode: %s\n",d.why?d.why:"bad argument");
  check(!rc,"real-package");if(!rc)check(d.package.ver==3&&d.package.m==32&&d.package.s==1479&&d.package.nr==74,"real-package-counts");
  cxpl_release(&d.package,drop);check(!live,"real-package-release");free(data);
 }
 printf("CXPACKAGE_DECODE\tfailed=%d\n",failed);return failed?1:0;
}
