/* tools/check-envcompat.cx -- contract check of cxlib.envcompat (the UNISA_ -> UNISACC_ rename window helper for tools and tests).
 *
 *   cx tools/check-envcompat.cx -- [--root DIR]
 *
 * (1) The helper's name table equals the deprecated rows of tests/env-semantics.tsv: every listed name has a UNISA_ row with an
 *     expires column, and the one deprecated row without a twin is UNISA_NOSTDINC (the product alone writes it).
 * (2) ec_setenv / ec_unsetenv write and delete both spellings of a listed name, given in either spelling, and only the given spelling of any other name (a
 *     longer name that merely starts like a listed one, KERNEL versus KERNEL_SHA, a name already spelled UNISA_).
 * (3) ec_env takes the new spelling first (an empty new value counts as set), falls back to the old one, else 0; ec_env_or's
 *     fallback covers unset and empty.
 * (4) ec_envp appends the pair for a listed name, one entry otherwise, keeps the array 0-terminated and answers -1 when full.
 * Last line CHECK_ENVCOMPAT<TAB>assertions=N<TAB>failed=M, rc 0 when M is 0. */
#pragma unisa use cxlib.envcompat
#pragma unisa use sys.env
#pragma unisa use mem.bytes
#pragma unisa use sys.io
#pragma unisa use text.text

static int nas, failed;
static void ck(int ok, const char *name) {
    nas++;
    if (ok) sy_printf("PASS\tenvcompat.%s\n", name);
    else { failed++; sy_printf("FAIL\tenvcompat.%s\n", name); }
}

static int same(const char *a, const char *b) { return a && b && !strcmp(a, b); }

/* the number of tab separated columns of the table row whose first column is NAME, 0 when there is no such row */
static int table_columns(const char *tbl, const char *name) {
    size_t nl = strlen(name);
    const char *s = tbl;
    while (*s) {
        const char *e = strchr(s, '\n');
        if (!e) e = s + strlen(s);
        if (*s != '#' && (size_t)(e - s) > nl && !strncmp(s, name, nl) && s[nl] == '\t') {
            int c = 1;
            const char *q;
            for (q = s; q < e; q++) if (*q == '\t') c++;
            return c;
        }
        s = *e ? e + 1 : e;
    }
    return 0;
}

static int deprecated_rows(const char *tbl, char out[][64], int cap) {
    int n = 0;
    const char *s = tbl;
    while (*s) {
        const char *e = strchr(s, '\n');
        if (!e) e = s + strlen(s);
        if (!strncmp(s, "UNISA_", 6)) {
            const char *t = memchr(s, '\t', (size_t)(e - s));
            int c = 1;
            const char *q;
            for (q = s; q < e; q++) if (*q == '\t') c++;
            if (t && c == 8 && n < cap && t - s < 64) { if (mm_copy(out[n], 64, s, (long)(t - s))) return n; out[n][t - s] = 0; n++; }
        }
        s = *e ? e + 1 : e;
    }
    return n;
}

int main(int argc, char **argv) {
    const char *root = ".";
    char path[4200], *tbl = 0, dep[16][64];
    char *arr[8];
    char legacy[16][80];
    size_t tn = 0;
    int i, n, nd, nl = 0;
    FILE *f;
    for (i = 1; i < argc; i++) {
        if (!strcmp(argv[i], "--root") && i + 1 < argc) root = argv[++i];
        else { fprintf(stderr, "usage: check-envcompat.cx -- [--root DIR]\n"); return 2; }
    }
    /* (1) table agreement */
    { int cx_kept = snprintf(path, sizeof path, "%s/tests/env-semantics.tsv", root); (void)cx_kept; }
    f = fopen(path, "rb");
    if (!f) { fprintf(stderr, "check-envcompat: cannot read %s\n", path); return 2; }
    {
        char *b = malloc(1 << 20);
        tn = b ? fread(b, 1, (1 << 20) - 1, f) : 0;
        fclose(f);
        if (!b || !tn) { fprintf(stderr, "check-envcompat: empty %s\n", path); return 2; }
        b[tn] = 0;
        tbl = b;
    }
    for (i = 0; ec_legacy_name(i) && nl < 16; i++) { int cx_kept = snprintf(legacy[nl], sizeof legacy[nl], "UNISACC_%s", ec_legacy_name(i)); (void)cx_kept; nl++; }
    ck(nl == 7 && !ec_legacy_name(7) && !ec_legacy_name(100), "legacy-name-list-ends");
    for (i = 0; i < nl; i++) {
        char nm[96];
        { int cx_kept = snprintf(nm, sizeof nm, "legacy-%s-is-in-env-semantics", legacy[i]); (void)cx_kept; }
        ck(table_columns(tbl, legacy[i]) == 8, nm);
    }
    nd = deprecated_rows(tbl, dep, 16);
    ck(nd == 2, "only-compat-exec-c-unisa-rows");
    {
        static const char *const want7[7] = {
            "CONTAINER", "FFI_BRIDGE", "FWD_REPLAY", "JOBS", "KERNEL", "KERNEL_SHA", "MAXSTEPS"
        };
        int seen[7] = {0, 0, 0, 0, 0, 0, 0};
        FILE *ef = fopen("cx/sys/env.cx", "r");
        char *eb = ef ? malloc(65536) : 0;
        size_t en = (ef && eb) ? fread(eb, 1, 65535, ef) : 0;
        int exact_ok = (eb && en > 0);
        int count = 0;
        if (ef) fclose(ef);
        if (eb) eb[en] = 0;
        if (exact_ok) {
            const char *tb = strstr(eb, "sy_compat_env");
            const char *eq = tb ? strstr(tb, "= {") : 0;
            const char *te = eq ? strstr(eq, "};") : 0;
            const char *p = eq ? eq + 3 : 0;
            if (!tb || !eq || !te) exact_ok = 0;
            while (exact_ok && p < te) {
                const char *q = strchr(p, '{');
                if (!q || q >= te) break;
                if (strncmp(q, "{0, 0}", 6) == 0 || strncmp(q, "{0,0}", 5) == 0) break;
                if (strncmp(q, "{\"UNISACC_", 10) != 0) { exact_ok = 0; break; }
                q += 10;
                const char *q1 = strchr(q, '"');
                if (!q1 || q1 >= te) { exact_ok = 0; break; }
                size_t klen = (size_t)(q1 - q);
                char kname[64];
                if (klen == 0 || klen >= sizeof kname) { exact_ok = 0; break; }
                mm_copy(kname, sizeof kname, q, klen);
                kname[klen] = 0;
                char expected_pair[160];
                cx_fmt(expected_pair, sizeof expected_pair, "{\"UNISACC_%s\", \"UNISA_%s\"}", kname, kname);
                if (strncmp(q - 10, expected_pair, strlen(expected_pair)) != 0) { exact_ok = 0; break; }
                int matched = -1;
                int wi;
                for (wi = 0; wi < 7; wi++) {
                    if (strcmp(kname, want7[wi]) == 0) { matched = wi; break; }
                }
                if (matched < 0 || seen[matched]) { exact_ok = 0; break; }
                seen[matched] = 1;
                count++;
                p = q1 + 1;
            }
            int wi;
            for (wi = 0; wi < 7 && exact_ok; wi++) {
                if (!seen[wi]) exact_ok = 0;
            }
            if (count != 7) exact_ok = 0;
        }
        ck(exact_ok, "product-compat-table-matches-7-pairs");
        free(eb);
    }
    free(tbl);
    /* (2) writes */
    sy_unsetenv("UNISACC_JOBS"); sy_unsetenv("UNISA_JOBS");
    ck(ec_setenv("UNISACC_JOBS", "3", 1) == 0 && same(sy_env("UNISACC_JOBS"), "3") && same(sy_env("UNISA_JOBS"), "3"), "setenv-writes-both-spellings");
    ck(ec_setenv("UNISACC_JOBS", "5", 0) == 0 && same(sy_env("UNISACC_JOBS"), "3") && same(sy_env("UNISA_JOBS"), "3"), "setenv-without-overwrite-keeps-both");
    ck(ec_unsetenv("UNISACC_JOBS") == 0 && !sy_env("UNISACC_JOBS") && !sy_env("UNISA_JOBS"), "unsetenv-deletes-both-spellings");
    sy_unsetenv("UNISACC_OTHER_X"); sy_unsetenv("UNISA_OTHER_X");
    ck(ec_setenv("UNISACC_OTHER_X", "1", 1) == 0 && same(sy_env("UNISACC_OTHER_X"), "1") && !sy_env("UNISA_OTHER_X"), "unlisted-name-has-no-twin");
    sy_unsetenv("UNISACC_OTHER_X");
    sy_unsetenv("UNISACC_KERNEL"); sy_unsetenv("UNISA_KERNEL"); sy_unsetenv("UNISACC_KERNEL_SHA"); sy_unsetenv("UNISA_KERNEL_SHA");
    ec_setenv("UNISACC_KERNEL_SHA", "aa", 1);
    ck(same(sy_env("UNISA_KERNEL_SHA"), "aa") && !sy_env("UNISA_KERNEL") && !sy_env("UNISACC_KERNEL"), "kernel-sha-twin-is-not-the-kernel-twin");
    ec_unsetenv("UNISACC_KERNEL_SHA");
    sy_unsetenv("UNISACC_JOBS_X"); sy_unsetenv("UNISA_JOBS_X");
    ck(ec_setenv("UNISACC_JOBS_X", "1", 1) == 0 && !sy_env("UNISA_JOBS_X"), "longer-name-with-a-listed-prefix-has-no-twin");
    sy_unsetenv("UNISACC_JOBS_X");
    sy_unsetenv("UNISA_JOBS"); sy_unsetenv("UNISACC_JOBS");
    ck(ec_setenv("UNISA_JOBS", "2", 1) == 0 && same(sy_env("UNISA_JOBS"), "2") && same(sy_env("UNISACC_JOBS"), "2"), "an-old-spelling-given-writes-both");
    ck(ec_unsetenv("UNISA_JOBS") == 0 && !sy_env("UNISA_JOBS") && !sy_env("UNISACC_JOBS"), "an-old-spelling-given-deletes-both");
    sy_setenv("UNISACC_JOBS", "new", 1); sy_setenv("UNISA_JOBS", "old", 1);
    ck(same(ec_env("UNISA_JOBS"), "new") && same(ec_env("UNISACC_JOBS"), "new"), "env-reads-the-new-spelling-first-whichever-spelling-is-asked");
    sy_setenv("UNISACC_JOBS", "", 1);
    ck(same(ec_env("UNISACC_JOBS"), "") && same(ec_env("UNISA_JOBS"), ""), "env-empty-new-wins-over-old");
    sy_unsetenv("UNISACC_JOBS");
    ck(same(ec_env("UNISA_JOBS"), "old") && same(ec_env("UNISACC_JOBS"), "old"), "env-falls-back-to-the-old-spelling-whichever-spelling-is-asked");
    sy_unsetenv("UNISA_JOBS");
    ec_setenv("UNISACC_CONTAINER", "/tmp/c.ape", 1); sy_setenv("UNISACC_APE_SELF", "/tmp/c.ape", 1);
    ck(same(ec_env("UNISACC_CONTAINER"), "/tmp/c.ape") && same(sy_env("UNISACC_APE_SELF"), "/tmp/c.ape"), "launcher-container-ape-self-pairing");
    ec_unsetenv("UNISACC_CONTAINER"); sy_unsetenv("UNISACC_APE_SELF");
    /* (3) reads */
    sy_unsetenv("UNISACC_MAXSTEPS"); sy_unsetenv("UNISA_MAXSTEPS");
    ck(ec_env("UNISACC_MAXSTEPS") == 0, "env-unset-is-null");
    sy_setenv("UNISA_MAXSTEPS", "7", 1);
    ck(same(ec_env("UNISACC_MAXSTEPS"), "7"), "env-falls-back-to-the-old-spelling");
    sy_setenv("UNISACC_MAXSTEPS", "9", 1);
    ck(same(ec_env("UNISACC_MAXSTEPS"), "9"), "env-takes-the-new-spelling-first");
    sy_setenv("UNISACC_MAXSTEPS", "", 1);
    ck(same(ec_env("UNISACC_MAXSTEPS"), ""), "env-empty-new-value-counts-as-set");
    ck(same(ec_env_or("UNISACC_MAXSTEPS", "dflt"), "dflt"), "env-or-covers-empty");
    sy_unsetenv("UNISACC_MAXSTEPS"); sy_unsetenv("UNISA_MAXSTEPS");
    ck(same(ec_env_or("UNISACC_MAXSTEPS", "dflt"), "dflt"), "env-or-covers-unset");
    sy_setenv("UNISA_MAXSTEPS", "4", 1);
    ck(same(ec_env_or("UNISACC_MAXSTEPS", "dflt"), "4"), "env-or-takes-the-old-spelling");
    sy_unsetenv("UNISA_MAXSTEPS");
    sy_setenv("UNISA_FREE_NAME", "z", 1);
    ck(ec_env("UNISA_FREE_NAME") && same(ec_env("UNISA_FREE_NAME"), "z") && !ec_env("UNISACC_FREE_NAME"), "env-of-an-old-spelling-reads-it-directly");
    sy_unsetenv("UNISA_FREE_NAME");
    /* (4) child environment arrays */
    n = 0; arr[0] = 0;
    ck(ec_envp(arr, &n, 8, "UNISACC_CONTAINER=/p") == 0 && n == 2 && same(arr[0], "UNISACC_CONTAINER=/p") && same(arr[1], "UNISA_CONTAINER=/p") && !arr[2], "envp-appends-the-pair-and-terminates");
    ck(ec_envp(arr, &n, 8, "UNISACC_LOCAL=1") == 0 && n == 3 && same(arr[2], "UNISACC_LOCAL=1") && !arr[3], "envp-appends-one-entry-for-an-unlisted-name");
    ck(ec_envp(arr, &n, 8, "UNISACC_KERNEL_SHA=ab") == 0 && n == 5 && same(arr[4], "UNISA_KERNEL_SHA=ab") && !arr[5], "envp-pair-for-the-longer-listed-name");
    n = 0; arr[0] = 0;
    ck(ec_envp(arr, &n, 2, "UNISACC_JOBS=1") == -1 && !arr[n], "envp-full-array-answers-minus-one-and-stays-terminated");
    n = 0; arr[0] = 0;
    ck(ec_envp(arr, &n, 1, "UNISACC_LOCAL=1") == -1 && n == 0, "envp-no-room-for-the-first-entry");
    n = 0; arr[0] = 0;
    ck(ec_envp(arr, &n, 8, "UNISA_CONTAINER=/p") == 0 && n == 2 && same(arr[0], "UNISA_CONTAINER=/p") && same(arr[1], "UNISACC_CONTAINER=/p") && !arr[2], "envp-old-spelling-given-gains-the-new-one-after-it");
    { static char big[1200]; char *pr = big; int bi;
      if (mm_copy(big, sizeof big, "UNISACC_CONTAINER=", 18)) return 2;
      for (bi = 18; bi < 1100; bi++) big[bi] = 'x';
      big[1100] = 0; n = 0; arr[0] = 0; (void)pr;
      ck(ec_envp(arr, &n, 8, big) == 0 && n == 2 && strlen(arr[1]) == strlen(big) - 2 && !strncmp(arr[1], "UNISA_CONTAINER=", 16), "envp-long-value-still-gets-its-twin-whole"); }
    {
        char tmpdir[128];
        char cmd[1024];
        char psrc[160];
        char pbin[160];
        char csrc[160];
        char cbin[160];
        char cwd[256];
        FILE *pf;
        int rc;
        cx_fmt(tmpdir, sizeof tmpdir, "/tmp/check-envcompat-prod-XXXXXX");
        if (!mkdtemp(tmpdir)) tmpdir[0] = 0;
        if (!getcwd(cwd, sizeof cwd)) cwd[0] = 0;
        cx_fmt(cmd, sizeof cmd, "ln -sfn %s/cx %s/cx && ln -sfn %s/cxroot.tsv %s/cxroot.tsv", cwd, tmpdir, cwd, tmpdir);
        rc = (tmpdir[0] && system(cmd) == 0) ? 0 : 1;
        ck(rc == 0, "prod-probe-dir-setup");
        cx_fmt(psrc, sizeof psrc, "%s/probe.cx", tmpdir);
        cx_fmt(pbin, sizeof pbin, "%s/probe", tmpdir);
        pf = fopen(psrc, "w");
        if (pf) {
            fprintf(pf, "#pragma unisa use cx.sys.env\nint printf(const char *, ...);\nint main(void) {\n    const char *j = sy_env(\"UNISACC_JOBS\");\n    const char *c = sy_env(\"UNISACC_CONTAINER\");\n    const char *a = sy_env(\"UNISACC_APE_SELF\");\n    printf(\"JOBS=%%s|CONT=%%s|APE=%%s\\n\", j ? j : \"<NULL>\", c ? c : \"<NULL>\", a ? a : \"<NULL>\");\n    return 0;\n}\n");
            fclose(pf);
        }
        cx_fmt(cmd, sizeof cmd, "cd %s && %s/unisacc.com %s -o %s >/dev/null 2>&1", tmpdir, cwd, psrc, pbin);
        rc = system(cmd);
        ck(rc == 0, "prod-sy-env-probe-builds");
        cx_fmt(cmd, sizeof cmd, "env -u UNISACC_JOBS -u UNISA_JOBS UNISACC_JOBS=new UNISA_JOBS=old %s | grep -qx 'JOBS=new|CONT=<NULL>|APE=<NULL>'", pbin);
        ck(system(cmd) == 0, "prod-sy-env-conflict-new-wins");
        cx_fmt(cmd, sizeof cmd, "env -u UNISACC_JOBS -u UNISA_JOBS UNISACC_JOBS= UNISA_JOBS=old %s | grep -qx 'JOBS=|CONT=<NULL>|APE=<NULL>'", pbin);
        ck(system(cmd) == 0, "prod-sy-env-empty-new-wins");
        cx_fmt(cmd, sizeof cmd, "env -u UNISACC_JOBS -u UNISA_JOBS UNISA_JOBS=old %s | grep -qx 'JOBS=old|CONT=<NULL>|APE=<NULL>'", pbin);
        ck(system(cmd) == 0, "prod-sy-env-old-only-fallback");
        {
            char abin[160], wpe[160], pkg[160], lcom[160];
            unsigned char pe[1024];
            FILE *wf;
            cx_fmt(abin, sizeof abin, "%s/ape", tmpdir);
            cx_fmt(wpe, sizeof wpe, "%s/win.exe", tmpdir);
            cx_fmt(pkg, sizeof pkg, "%s/pkg", tmpdir);
            cx_fmt(lcom, sizeof lcom, "%s/launcher.com", tmpdir);
            memset(pe, 0, sizeof pe);
            pe[0] = 'M'; pe[1] = 'Z'; pe[0x3c] = 64;
            pe[64] = 'P'; pe[65] = 'E';
            pe[64 + 24 + 60 + 1] = 4; /* SizeOfHeaders = 1024 */
            wf = fopen(wpe, "wb"); if (wf) { fwrite(pe, 1, sizeof pe, wf); fclose(wf); }
            wf = fopen(pkg, "wb"); if (wf) { fwrite("P 1 x", 1, 5, wf); fclose(wf); }
            cx_fmt(cmd, sizeof cmd, "/usr/bin/cc -O2 -I%s -o %s %s/seed/ape.c >/dev/null 2>&1 && %s --payload %s %s %s %s %s %s %s >/dev/null 2>&1", cwd, abin, cwd, abin, pkg, lcom, wpe, pbin, pbin, pbin, pbin);
            ck(system(cmd) == 0, "prod-launcher-ape-packs");
            cx_fmt(cmd, sizeof cmd, "env -u UNISACC_CONTAINER -u UNISA_CONTAINER -u UNISACC_APE_SELF HOME=%s sh %s | grep -qx 'JOBS=<NULL>|CONT=%s|APE=%s'", tmpdir, lcom, lcom, lcom);
            ck(system(cmd) == 0, "prod-launcher-old-container-ape-self-pairing");
        }
        cx_fmt(csrc, sizeof csrc, "%s/c_runreuse.c", tmpdir);
        cx_fmt(cbin, sizeof cbin, "%s/c_runreuse", tmpdir);
        pf = fopen(csrc, "w");
        if (pf) {
            fprintf(pf, "#include <stdio.h>\n#include <stdlib.h>\n#include <errno.h>\n#include <string.h>\n#include <unistd.h>\n#include <sys/stat.h>\n#define RF_STRICT 0\ntypedef struct { unsigned char *b; int n; int cap; } Buf;\nstatic Buf ATTRS; static int ATTR_SLOT = -1; static struct { unsigned char *data; int len; } RI[1];\nstatic const char *rf_capture_dir(void){return 0;}\nstatic int rr_is_dir(const char *p){(void)p;return 0;}\nstatic const char *bx_file_mode(int w){return w?\"wb\":\"rb\";}\n#include \"exec/c/runreuse.h\"\nint main(void) {\n    const char *p = rr_product_path(\"/arg0\");\n    printf(\"%%s\\n\", p ? p : \"<NULL>\");\n    return 0;\n}\n");
            fclose(pf);
        }
        cx_fmt(cmd, sizeof cmd, "/usr/bin/cc -I%s -o %s %s", cwd, cbin, csrc);
        ck(system(cmd) == 0, "c-path-runreuse-builds");
        cx_fmt(cmd, sizeof cmd, "env -u UNISACC_CONTAINER -u UNISA_CONTAINER UNISACC_CONTAINER=/new/c UNISA_CONTAINER=/old/c %s | grep -qx '/new/c'", cbin);
        ck(system(cmd) == 0, "c-path-runreuse-conflict-new-wins");
        cx_fmt(cmd, sizeof cmd, "env -u UNISACC_CONTAINER -u UNISA_CONTAINER UNISA_CONTAINER=/old/c %s | grep -qx '/old/c'", cbin);
        ck(system(cmd) == 0, "c-path-runreuse-old-only-fallback");
        cx_fmt(csrc, sizeof csrc, "%s/c_binding.c", tmpdir);
        cx_fmt(cbin, sizeof cbin, "%s/c_binding", tmpdir);
        pf = fopen(csrc, "w");
        if (pf) {
            fprintf(pf, "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\ntypedef long I;\ntypedef struct { int dummy; } CoreModel;\ntypedef struct { int dummy; } CoreResult;\nstatic void die(const char *s){(void)s;exit(2);}\nstatic int core_host_fetch(unsigned char *a,long b,unsigned char **c,int *d){(void)a;(void)b;(void)c;(void)d;return 0;}\nstatic void core_host_panic(char *a){(void)a;}\nstatic unsigned char *readfile(const char *p,int *n,int z){(void)n;(void)z;printf(\"%%s\\n\",p?p:\"<NULL>\");exit(0);return 0;}\nstatic long __mmap(long a,long b,long c,long d,long e,long f){(void)a;(void)b;(void)c;(void)d;(void)e;(void)f;return 0;}\nstatic int __mprotect(long a,long b,long c){(void)a;(void)b;(void)c;return 0;}\n#include \"exec/c/asm/binding.c\"\nint main(void) {\n    kernel_load();\n    return 1;\n}\n");
            fclose(pf);
        }
        cx_fmt(cmd, sizeof cmd, "/usr/bin/cc -D__UNISA__ -I%s -o %s %s >/dev/null 2>&1", cwd, cbin, csrc);
        ck(system(cmd) == 0, "c-path-binding-builds");
        cx_fmt(cmd, sizeof cmd, "env -u UNISACC_KERNEL -u UNISA_KERNEL UNISACC_KERNEL=/new/k UNISA_KERNEL=/old/k %s | grep -qx '/new/k'", cbin);
        ck(system(cmd) == 0, "c-path-binding-conflict-new-wins");
        cx_fmt(cmd, sizeof cmd, "env -u UNISACC_KERNEL -u UNISA_KERNEL UNISA_KERNEL=/old/k %s | grep -qx '/old/k'", cbin);
        ck(system(cmd) == 0, "c-path-binding-old-only-fallback");
        cx_fmt(cmd, sizeof cmd, "rm -rf %s", tmpdir);
        system(cmd);
    }
    sy_printf("CHECK_ENVCOMPAT\tassertions=%d\tfailed=%d\n", nas, failed);
    return failed ? 1 : 0;
}
