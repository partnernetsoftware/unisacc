/* --create ROOT SNAPROOT MATERIAL FAST_ELF LEGACY_REFERENCE_ELF NEW_PROFILE
 * Caller bound55. NEW_PROFILE must be the canonical FAST_ELF.cache.tsv path.
 * Execute the actual legacy NI reader first; it needs no fast profile. Then
 * bind the existing measured CX artifact to exact, independently read source,
 * original material/header/compiler roles and flags. EXCL/fsync unsigned code
 * cache consistency only: not historical compilation proof, NN construction,
 * functional PASS, or a rewrite of any original NOT_RECORDED receipt.
 * No compiler, Python, model builder or mutation of preparation materials.
 * The caller separately records this writer's actual compiled source/module/
 * compiler/flags/ELF profile; runtime source SHA cannot prove stale-ELF lineage.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.nninputs
#pragma unisa use text.text
static void die(const char *s){fprintf(stderr,"libneed-native-profile: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void path(char p[4400],const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path-bound");}
static char *load(const char *p,size_t *n){struct stat a,b;if(lstat(p,&a))die(errno==ENOENT?"input-ENOENT":"input-stat-error");if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>32768)die("bounded-regular-profile-or-source-input");int fd=open(p,O_RDONLY|O_NOFOLLOW|O_CLOEXEC|O_NONBLOCK);if(fd<0)die("input-open");if(fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size||a.st_mode!=b.st_mode)die("input-descriptor");*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s)die("allocation");size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("input-read-extent");at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int changed=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size||a.st_mode!=b.st_mode;int closed=close(fd);if(z||changed||closed)die("input-changed-or-close");s[*n]=0;return s;}
static void digest(const char *p,char h[65]){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,h);free(s);}
static void same(const np_buf *a,const np_buf *b){if(a->n!=b->n||memcmp(a->p,b->p,a->n))die("canonical-code-inputs-changed");}
static np_buf canonical(const char *root,const char *snapshot,const char *material,const char *fast,const char *reference,const char *include){np_buf b={0};char why[1400];if(ni_fast_profile_text(root,snapshot,material,fast,reference,include,&b,why,sizeof why))die(why);return b;}
static void write_profile(const char *p,const np_buf *b){int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)die("exclusive-new-code-profile");size_t at=0;while(at<b->n){ssize_t n=write(fd,b->p+at,b->n-at);if(n<0&&errno==EINTR)continue;if(n<=0)die("profile-write-partial-retained");at+=(size_t)n;}int bad=fsync(fd),closed=close(fd);if(bad||closed)die("profile-sync-or-close-retained");char parent[4400];if(strlen(p)>=sizeof parent)die("profile-parent-bound");strcpy(parent,p);char *slash=strrchr(parent,'/');if(!slash)die("absolute-profile-parent");if(slash==parent)slash[1]=0;else *slash=0;fd=open(parent,O_RDONLY|O_DIRECTORY|O_CLOEXEC);if(fd<0)die("profile-directory-open");bad=fsync(fd);closed=close(fd);if(bad||closed)die("profile-directory-sync-retained");}
int main(int argc,char **argv){if(argc!=8||!tx_eqz(argv[1], "--create"))die("usage---create-ROOT-SNAPROOT-MATERIAL-FAST_ELF-LEGACY_REFERENCE_ELF-NEW_PROFILE");char root[4096],snapshot[4096],material[4096],fast[4096],reference[4096],profile[4400],self[4096];for(int i=2;i<8;i++)if(argv[i][0]!='/'||strpbrk(argv[i],"\r\n\t"))die("absolute-clean-path-arguments-required");if(!realpath(argv[2],root)||!realpath(argv[3],snapshot)||!realpath(argv[4],material)||!realpath(argv[5],fast)||!realpath(argv[6],reference)||!realpath(__FILE__,self))die("resolve-input-paths");int n=snprintf(profile,sizeof profile,"%s.cache.tsv",fast);if(n<0||n>=sizeof profile||!tx_eqz(argv[7], profile))die("profile-must-be-FAST_ELF.cache.tsv");struct stat st;errno=0;if(!lstat(profile,&st))die("new-profile-already-exists");if(errno!=ENOENT)die("profile-existence-stat-error");char source[4400],before[65],own[65],after[65];path(source,root,"tools/libneed-native-profile.cx");digest(source,before);digest(self,own);if(!tx_eqz(before, own))die("writer-must-be-current-root-source");
 ni_result observed={0};char why[1400];if(ni_compare(root,snapshot,reference,&observed,why,sizeof why))die(why);if(observed.native_source_kind!=1||!tx_eqz(observed.native_artifact, "5c6a7756fa4de143a3e74ec14f392fc8ee736755ad55043cb976ace0fb2bb011")||!tx_eqz(observed.native_C_source, "5f0469bcb6268bf979d8bb872424ae238c8f991b51543337b6f4b2750b2fdbb1"))die("actual-legacy-reference-role-required");
 np_buf first=canonical(root,snapshot,material,fast,reference,observed.current_include),second=canonical(root,snapshot,material,fast,reference,observed.current_include);same(&first,&second);free(second.p);digest(source,after);if(!tx_eqz(before, after))die("writer-source-changed-before-profile-create");write_profile(profile,&first);np_buf final=canonical(root,snapshot,material,fast,reference,observed.current_include);same(&first,&final);free(final.p);size_t actual_n;char *actual=load(profile,&actual_n);if(actual_n!=first.n||memcmp(actual,first.p,actual_n))die("created-profile-exact-readback-mismatch");free(actual);digest(source,after);if(!tx_eqz(before, after))die("writer-source-changed-after-profile-create");char h[65];cx_sha256_hex(first.p,first.n,h);printf("CODE_CACHE_PROFILE\t%s\tsha256=%s\tbytes=%lu\n",profile,h,(unsigned long)first.n);printf("LEGACY_READER_OBSERVATION\twitness=%s\tcurrent_include_v2=%s\tphysical_reads=%d\tnative_calls=%d\n",observed.witness,observed.current_include,observed.physical_reads,observed.native_table_calls);puts("PROFILE_CREATED\tunsigned-code-cache-consistency\tnot-historical-compilation-proof-or-NN-functional-qualification");free(first.p);return 0;}
