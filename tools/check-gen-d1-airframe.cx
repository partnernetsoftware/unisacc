#pragma unisa use chrome_dom

int main(void) {
    char *args[]={"sh","./unisacc.com","tools/gen-d1-airframe.cx","--","--check",0};
    char *out=0;
    size_t size=0;
    int rc=cx_runv_timeout(args,40,&out,&size);
    if(out) { fwrite(out,1,size,stdout); free(out); }
    printf("CHECK_GEN_D1_AIRFRAME\tfailed=%d\n",rc);
    return rc?1:0;
}
