/* tools/coldcompile.cx -- cold compile time and use closure of .cx files (a measurement, not a test).
 *
 *   sh ./unisacc.com tools/coldcompile.cx -- OUT.tsv FILE...          (from the repository root)
 *   sh ./unisacc.com tools/coldcompile.cx -- --plan-only FILE...
 *
 * For each FILE (repo-relative), one after another:
 *   closure   the compiler's own plan (`PRODUCT -cx-plan FILE`, bound 20 s): its units, FILE first;
 *   cold_ms   wall time of `PRODUCT FILE -o DIR/image` under tools/bound 40 with TMPDIR set to DIR, a new
 *             empty directory below this tool's own temporary directory, so the product's run cache,
 *             model cache and interface headers all start empty (the gate's "fresh TMPDIR" condition;
 *             the OS page cache is not cold).  The image is built, not run: no check executes.  DIR is
 *             removed afterwards.
 * A row is appended to OUT.tsv (created with its header when absent) and printed:
 *   file  cold_ms  rc  units  closure_bytes  load1  uses
 * rc is the compile's exit code (142: the 40 s bound), cold_ms is its wall time whatever the rc;
 * closure_bytes sums the bytes of all units; load1 is /proc/loadavg's first field before the compile
 * (a loaded machine inflates cold_ms: read the two together); uses is the other units, comma separated.
 * --plan-only prints rows with cold_ms, rc and load1 as "-" and writes no file.
 * A FILE whose plan fails (missing file, unresolved use) gets no row: PLAN_FAILED<TAB>file on stderr, and
 * the remaining files are still done.  Ends with COLDCOMPILE<TAB>files=N<TAB>compile_failed=K<TAB>plan_failed=P.
 * Exit 0 when every FILE has a row (a failing compile is a measured row), 1 when a plan failed, 2 on
 * usage or I/O trouble. */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use mem.bytes

static void die(const char *a, const char *b) { fprintf(stderr, "coldcompile: %s%s%s\n", a, b ? ": " : "", b ? b : ""); exit(2); }

static const char *HEADER = "file\tcold_ms\trc\tunits\tclosure_bytes\tload1\tuses\n";

/* the plan of FILE: units, bytes and the comma list of the other units into USES; 1 when there is none */
static int plan(const char *file, int *units, long *bytes, char *uses, long cap) {
    char *v[] = {"tools/bound", "20", "sh", "./unisacc.com", "-cx-plan", (char *)file, 0}, *o = 0; size_t on = 0;
    long at = 0, un = 0; int rc = cx_runv_timeout(v, 25, &o, &on);
    *units = 0; *bytes = 0; uses[0] = 0;
    if (rc || !o) { free(o); return 1; }
    while (at < (long)on) {
        long e = at, p = at, q;
        while (e < (long)on && o[e] != '\n') e++;
        while (p < e && o[p] >= '0' && o[p] <= '9') p++;
        if (p > at && p < e && o[p] == '\t') {
            size_t fn = 0; char *f;
            p++; q = p;
            while (q < e && o[q] != '\t') q++;
            o[q] = 0;
            f = cx_read(o + p, &fn);
            if (!f) { free(o); return 1; }
            free(f);
            *bytes += (long)fn;
            if (*units) {
                if (un + (q - p) + 2 >= cap) die("uses too long", file);
                if (un) uses[un++] = ',';
                if (mm_copy(uses + un, (size_t)(cap - un), o + p, (size_t)(q - p))) die("uses too long", file);
                un += q - p; uses[un] = 0;
            }
            (*units)++;
        }
        at = e + 1;
    }
    free(o);
    return *units ? 0 : 1;
}

static void load1(char *out, long cap) {
    size_t n = 0; char *s = cx_read("/proc/loadavg", &n); long k = 0;
    while (s && k < (long)n && k < cap - 1 && s[k] != ' ' && s[k] != '\n') { out[k] = s[k]; k++; }
    if (!k) out[k++] = '-';
    out[k] = 0;
    free(s);
}

static void append(const char *path, const char *row) {
    size_t n = 0, hn = strlen(HEADER), rn = strlen(row), total; char *old = sy_exists(path) == 1 ? cx_read(path, &n) : 0, *all;
    if (sy_exists(path) == 1 && !old) die("cannot read", path);
    total = n + hn + rn + 1;
    all = malloc(total);
    if (!all) die("allocation", 0);
    if (old ? mm_copy(all, total, old, n) : mm_copy(all, total, HEADER, hn)) die("copy bound", path);
    if (!old) n = hn;
    if (mm_copy(all + n, total - n, row, rn)) die("copy bound", path);
    if (cx_write(path, all, n + rn)) die("cannot write", path);
    free(old); free(all);
}

int main(int argc, char **argv) {
    static char uses[65536], row[70000];
    int plan_only = argc > 2 && tx_eqz(argv[1], "--plan-only"), a, files = 0, bad = 0, noplan = 0;
    if (argc < 3 || (argv[1][0] == '-' && !plan_only)) die("usage: OUT.tsv FILE... | --plan-only FILE...", 0);
    if (sy_exists("unisacc.com") != 1 || sy_exists("tools/bound") != 1) die("run from the repository root", 0);
    for (a = 2; a < argc; a++) {
        int units = 0; long bytes = 0;
        if (plan(argv[a], &units, &bytes, uses, sizeof uses)) { fprintf(stderr, "PLAN_FAILED\t%s\n", argv[a]); noplan++; continue; }
        if (plan_only) {
            if (cx_fmt(row, sizeof row, "%s\t-\t-\t%d\t%ld\t-\t%s\n", argv[a], units, bytes, uses[0] ? uses : "-")) die("row too long", argv[a]);
        } else {
            char fresh[4400], env[4500], image[4500], ld[32], *o = 0; size_t on = 0; long t0, ms; int rc;
            if (cx_fmt(fresh, sizeof fresh, "%s/coldcompile-%d-%d", sy_tmpdir(), sy_pid(), a) || cx_fmt(env, sizeof env, "TMPDIR=%s", fresh) ||
                cx_fmt(image, sizeof image, "%s/image", fresh)) die("path too long", sy_tmpdir());
            if (sy_mkdir(fresh, 0700)) die("cannot make", fresh);
            load1(ld, sizeof ld);
            {   char *v[] = {"tools/bound", "40", "env", env, "sh", "./unisacc.com", argv[a], "-o", image, 0};
                t0 = sy_now_ms();
                rc = cx_runv_timeout(v, 45, &o, &on);
                ms = sy_now_ms() - t0;
            }
            free(o);
            if (cx_rmtree(fresh)) die("cannot remove", fresh);
            if (rc) bad++;
            if (cx_fmt(row, sizeof row, "%s\t%ld\t%d\t%d\t%ld\t%s\t%s\n", argv[a], ms, rc, units, bytes, ld, uses[0] ? uses : "-")) die("row too long", argv[a]);
            append(argv[1], row);
        }
        printf("%s", row);
        files++;
    }
    printf("COLDCOMPILE\tfiles=%d\tcompile_failed=%d\tplan_failed=%d\n", files, bad, noplan);
    return noplan ? 1 : 0;
}
