/* ROOT NEW_ABS_OUT; Linux/x86_64 LP64; caller tools/bound55.
 * Independent guarded no-op and fresh default-run comparisons, not a speedup
 * claim. Two targets bound8 + two source controls bound8 = explicit32s child
 * budgets; outer55 remains hard. No old out fixture or saved verdict is used.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use text.text
static char root[4096],work[4096],product[4400],bound[4400],identity[4400],self[4096],fixture[4400],truepath[4096],netpack[4400],bound_source[4400];
static const char *program="int main(int argc,char **argv){if(argc!=2)return 2;printf(\"WATCHDOG_ARG\\t%s\\n\",argv[1]);return 0;}\n";
static const char *argument="fixed-argv-37",*expected="WATCHDOG_ARG\tfixed-argv-37\n";
static int assertions,failures,clock_seen;static long long clock_previous;
static void die(const char *s){fprintf(stderr,"run-watchdog-bench: REFUSE %s errno=%d\n",s,errno);exit(2);}
static void path(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path-bound");}
static void ck(int ok,const char *name){assertions++;if(!ok)failures++;printf("%s\trun-watchdog-bench.%s\n",ok?"PASS":"FAIL",name);}
/* Same implicit prelude timespec and generic Linux syscall as the original
 * startup benchmark. Unit ns does not assert clock resolution. */
static long long now_ns(void){struct timespec t={0};long rc=__syscall6(228,1,(long)&t,0,0,0);if(_unisa_ret(rc)||t.tv_sec<0||t.tv_nsec<0||t.tv_nsec>=1000000000L)die("CLOCK_MONOTONIC-read-or-extent");if((unsigned long long)t.tv_sec>(unsigned long long)(LLONG_MAX-t.tv_nsec)/1000000000ULL)die("clock-integer-overflow");long long n=(long long)t.tv_sec*1000000000LL+t.tv_nsec;if(clock_seen&&n<clock_previous)die("CLOCK_MONOTONIC-moved-backward");clock_seen=1;clock_previous=n;return n;}
static char *load(const char *p,size_t *n){struct stat a,b;errno=0;if(lstat(p,&a))die(errno==ENOENT?"input-absent":"input-stat");if(!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>134217728)die("bounded-regular-input");int fd=open(p,O_RDONLY|O_CLOEXEC|O_NONBLOCK|O_NOFOLLOW);if(fd<0||fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size)die("input-descriptor");*n=(size_t)a.st_size;char *s=malloc(*n+1);if(!s)die("allocation");size_t at=0;while(at<*n){ssize_t z=read(fd,s+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("input-extent");at+=(size_t)z;}char extra;ssize_t z;do{z=read(fd,&extra,1);}while(z<0&&errno==EINTR);int bad=fstat(fd,&b)||a.st_dev!=b.st_dev||a.st_ino!=b.st_ino||a.st_size!=b.st_size;int closed=close(fd);if(z||bad||closed)die("input-changed-or-close");s[*n]=0;return s;}
static void digest(const char *p,char h[65]){size_t n;char *s=load(p,&n);cx_sha256_hex(s,n,h);free(s);}
static void save(const char *name,const char *s,size_t n){char p[4400];path(p,work,name);int fd=open(p,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC|O_NOFOLLOW,0600);if(fd<0)die("exclusive-evidence");size_t at=0;while(at<n){ssize_t z=write(fd,s+at,n-at);if(z<0&&errno==EINTR)continue;if(z<=0)die("evidence-write");at+=(size_t)z;}int synced=fsync(fd),closed=close(fd);if(synced||closed)die("evidence-close");}
static void row(np_buf *b,const char *k,const char *v){np_puts(b,k);np_puts(b,"\t");np_puts(b,v);np_puts(b,"\n");}
static void clear_ambient(void){if(unsetenv("UNISACC_RF_CAPTURE")||unsetenv("UNISA_ATTRIBUTES"))die("clear-ambient-resources");}
static void transcript(const char *label,const np_result *r,long long ns){char name[100],text[180];snprintf(name,sizeof name,"%s.stdout",label);save(name,r->out,r->outn);snprintf(name,sizeof name,"%s.stderr",label);save(name,r->err,r->errn);int n=ns<0?snprintf(text,sizeof text,"rc\t%d\nduration_ns\tUNMEASURED\n",r->rc):snprintf(text,sizeof text,"rc\t%d\nduration_ns\t%lld\n",r->rc,ns);snprintf(name,sizeof name,"%s.status",label);save(name,text,(size_t)n);}
static void source_identity(char h[65],const char *label){char *v[]={bound,"8","sh",product,identity,"--",root,0};char *env[]={"UNISACC_BOUND_CLEANUP_TRACE=",0};char why[1024];np_result r;clear_ambient();if(np_run(v,root,env,10,&r,why,sizeof why))die(why);transcript(label,&r,-1);int ok=!r.rc&&!r.errn&&r.outn==65&&r.out[64]=='\n';if(ok){memcpy(h,r.out,64);h[64]=0;for(int i=0;i<64;i++)if(!((h[i]>='0'&&h[i]<='9')||(h[i]>='a'&&h[i]<='f')))ok=0;}if(!ok&&r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);if(!ok)die("source-identity-prerequisite");}
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN run-watchdog-bench requires Linux/x86_64\n",stderr);return 3;
#endif
 if(argc!=3||!realpath(argv[1],root)||argv[2][0]!='/'||strlen(argv[2])>=sizeof work||strpbrk(argv[2],"\t\r\n")||!realpath(__FILE__,self)||!realpath("/bin/true",truepath))die("usage-ROOT-NEW_ABS_OUT-or-realpath");if(sizeof(long)!=8||sizeof(void *)!=8||sizeof(struct timespec)!=16)die("Linux-x86_64-LP64-clock-layout-required");
 char parent[4096],base[4096],leaf[4096];strcpy(parent,argv[2]);char *slash=strrchr(parent,'/');if(!slash||!slash[1]||tx_eqz(slash+1, ".")||tx_eqz(slash+1, ".."))die("output-leaf");strcpy(leaf,slash+1);if(slash==parent)slash[1]=0;else *slash=0;if(!realpath(parent,base))die("output-parent");int z=snprintf(work,sizeof work,"%s%s%s",base,tx_eqz(base, "/")?"":"/",leaf);if(z<0||(size_t)z>=sizeof work||mkdir(work,0700))die("fresh-output-directory-required");
 path(product,root,"unisacc.com");path(bound,root,"tools/bound");path(identity,root,"seed/ident.c");path(netpack,root,"tools/cxlib/netpack.cx");path(bound_source,root,"tools/bound.c");path(fixture,work,"program.cx");save("program.cx",program,strlen(program));
 const char *watched[]={product,self,netpack,bound,bound_source,truepath,fixture,identity};const char *names[]={"product","controller","netpack","bound-wrapper","bound-C-source","resolved-bin-true","sourcefixture","identity-source"};char hashes[8][65],raw_before[65],raw_after[65],after[65];np_buf identities={0};for(int i=0;i<8;i++){digest(watched[i],hashes[i]);row(&identities,names[i],hashes[i]);}row(&identities,"bin-true-realpath",truepath);source_identity(raw_before,"source-before");row(&identities,"raw-source",raw_before);save("inputs-before.tsv",identities.p,identities.n);free(identities.p);
 printf("WATCHDOG_IDENTITY\tproduct=%s\trawsource=%s\tcontroller=%s\ttrue=%s\n",hashes[0],raw_before,hashes[1],hashes[5]);puts("SCOPE\ttwo-independent-guarded-e2e-samples\tincludes-wrapper-watchdog-trace-compilation-runtime-pipe-capture\tfirst-observed-not-OS-cold\ttrace-overhead-included");puts("CLOCK\tLinux-syscall228-CLOCK_MONOTONIC1\tunit=ns\tresolution=UNMEASURED");
 np_buf samples={0};np_puts(&samples,"sample\trc\tduration_ns\texact_output\ttrace_sha256\n");
 for(int i=0;i<2;i++){
  const char *label=i?"cx":"noop";char trace_name[100],trace_path[4400],trace_env[4500],evidence[100];snprintf(trace_name,sizeof trace_name,"%s.trace.raw",label);path(trace_path,work,trace_name);struct stat st;errno=0;if(!lstat(trace_path,&st)||errno!=ENOENT)die("trace-must-be-absent");z=snprintf(trace_env,sizeof trace_env,"UNISACC_BOUND_CLEANUP_TRACE=%s",trace_path);if(z<0||(size_t)z>=sizeof trace_env)die("trace-env-bound");char *env[]={trace_env,0};char *noop[]={bound,"8",truepath,0};char *cx[]={bound,"8","sh",product,fixture,"--",(char *)argument,0};char **v=i?cx:noop;
  np_buf command={0};for(int j=0;v[j];j++){char key[32];snprintf(key,sizeof key,"arg-%d",j);row(&command,key,v[j]);}row(&command,"environment",trace_env);snprintf(evidence,sizeof evidence,"%s.argv.tsv",label);save(evidence,command.p,command.n);free(command.p);
  char why[1024];np_result r;clear_ambient();long long begin=now_ns();int error=np_run(v,root,env,10,&r,why,sizeof why);long long end=now_ns();if(error){snprintf(evidence,sizeof evidence,"%s.error",label);save(evidence,why,strlen(why));char unavailable[180];int un=snprintf(unavailable,sizeof unavailable,"rc\tUNAVAILABLE\nduration_ns\t%lld\nstreams\tUNAVAILABLE-transport-error\n",end-begin);snprintf(evidence,sizeof evidence,"%s.status",label);save(evidence,unavailable,(size_t)un);die(why);}long long ns=end-begin;transcript(label,&r,ns);int ok=!r.rc&&!r.errn&&(i?(r.outn==strlen(expected)&&!memcmp(r.out,expected,r.outn)):!r.outn);snprintf(evidence,sizeof evidence,"%s-exact-rc-and-streams",label);ck(ok,evidence);if(!ok&&r.errn)fwrite(r.err,1,r.errn,stderr);
  /* Retain raw trace only; no parsing its phases into verdicts or durations.
   * Trace logging is part of the measured instrument, not free observation. */
  size_t trace_n;char *trace=load(trace_path,&trace_n);char trace_sha[65];cx_sha256_hex(trace,trace_n,trace_sha);free(trace);char line[300];z=snprintf(line,sizeof line,"%s\t%d\t%lld\t%s\t%s\n",label,r.rc,ns,ok?"MATCH":"MISMATCH",trace_sha);np_put(&samples,line,(size_t)z);printf("WATCHDOG_SAMPLE\t%s\trc=%d\te2e_ns=%lld\toutput=%s\ttrace=%s\n",label,r.rc,ns,ok?"MATCH":"MISMATCH",trace_name);np_free(&r);
 }
 save("samples.tsv",samples.p,samples.n);free(samples.p);source_identity(raw_after,"source-after");ck(tx_eqz(raw_before, raw_after),"full-rawsource-unchanged");np_buf final={0};for(int i=0;i<8;i++){digest(watched[i],after);row(&final,names[i],after);char key[100];snprintf(key,sizeof key,"%s-unchanged",names[i]);ck(tx_eqz(hashes[i], after),key);}char true_after[4096];if(!realpath("/bin/true",true_after))die("bin-true-final-realpath");ck(tx_eqz(truepath, true_after),"bin-true-realpath-unchanged");row(&final,"bin-true-realpath",true_after);row(&final,"raw-source",raw_after);save("inputs-after.tsv",final.p,final.n);free(final.p);
 puts("TIMING\tproduct-startup_compile_load_infer_output_validation_cleanup=UNMEASURED\tOS-cold=UNMEASURED\ttrace-phases=RAW_ONLY");puts("NOT_CLAIMED\ttwo-second-attribution-overhead-subtraction-speedup-or-cache-mechanism");printf("RUN_WATCHDOG_BENCH\tsamples=2\tassertions=%d\tfailed=%d\texplicit-child-budgets=32\n",assertions,failures);return failures?1:0;
}
