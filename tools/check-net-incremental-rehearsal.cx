/* Independent plan and isolated mutation fixtures; not a 42-build PASS. */
#pragma unisa use sys.fs
#pragma unisa use sysx.process
static char root[8192],base[8192],com[8192],tool[8192],bin[8192];static int checks,failed;
static void die(void){fprintf(stderr,"incremental check IO\n");exit(2);}
static void ck(int yes,const char *s){checks++;failed+=!yes;printf("%s\t%s\n",yes?"PASS":"FAIL",s);}
static void writefile(const char *path,const void *p,size_t n){if(cx_write(path,p,n))die();}
static np_result call(char **a){np_result r={0};char why[300];if(np_run(a,root,0,35,&r,why,sizeof why)||r.residue)die();return r;}
/* Exercise the real compare -> window -> cached path, before any artifacts
 * can be consumed. No second receipt validator stands in for that reader. */
static void cache_boundaries(void){char dir[8192],receipt[8192];if(cx_fmt(dir,sizeof dir,"%s/cache-boundaries",base)||mkdir(dir,0700)||cx_fmt(receipt,sizeof receipt,"%s/profile-source-packages-v2-cache.tsv",dir))die();const char *labels[]={"legacy cache schema refused by real consumer","v2 missing fields refused without fallback","v2 other physical root refused","v2 duplicate field refused"};for(int mode=0;mode<4;mode++){char wire[8192];if(mode==0){if(cx_fmt(wire,sizeof wire,"%s","REHEARSAL_CACHE\tkind=profile\tstate=PREPARED\n"))die();}else if(mode==1){if(cx_fmt(wire,sizeof wire,"REHEARSAL_CACHE\tschema=source-packages-v2\troot=%s\tkind=profile\tstate=PREPARED\n",root))die();}else if(cx_fmt(wire,sizeof wire,"REHEARSAL_CACHE\tschema=source-packages-v2\troot=/different-physical-tree\tkind=profile\tpackages_sha=a\tprofile_sha=b\tsource_sha=c\tproduct_sha=d\texe_sha=e\tflags_sha=f\texecution_key=g\tcompile_ms=0\tstate=PREPARED%s\n",mode==3?"\troot=/duplicate":""))die();writefile(receipt,wire,strlen(wire));char *a[]={bin,"compare",dir,"0",0};np_result r=call(a);const char *why=mode==0?"cache receipt schema":mode==2?"cache physical root/kind identity":"receipt unique required field";ck(r.rc&&r.err&&strstr(r.err,why),labels[mode]);np_free(&r);}}
static int cache_phase(int argc,char **argv){if(argc!=4||!realpath(".",root)||!realpath(argv[2],bin)||argv[3][0]!='/')die();const char *dir=argv[3];if(!strcmp(argv[1],"--cache-create")){if(mkdir(dir,0700))die();char *a[]={bin,"cache",(char *)dir,"profile",0};np_result r={0};char why[300];if(np_run(a,root,0,50,&r,why,sizeof why)||r.residue)die();ck(!r.rc&&r.out&&strstr(r.out,"schema=source-packages-v2"),"actual v2 cache rebuilt");if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);}else if(!strcmp(argv[1],"--cache-adopt")){char *a[]={bin,"cache-list",(char *)dir,0};np_result r=call(a);ck(!r.rc&&r.out&&strstr(r.out,"CACHE_ADOPTED\tschema=source-packages-v2")&&strstr(r.out,"RECIPE\t"),"real cached consumer executes rebuilt v2 profile");if(r.errn)fwrite(r.err,1,r.errn,stderr);np_free(&r);char roots[2][8192],files[2][8192];np_result keys[2]={{0}};for(int i=0;i<2;i++){if(cx_fmt(roots[i],sizeof roots[i],"%s/equal-bytes-root-%d",dir,i)||mkdir(roots[i],0700)||cx_fmt(files[i],sizeof files[i],"%s/same-input",roots[i]))die();writefile(files[i],"identical source bytes\n",strlen("identical source bytes\n"));char *q[]={bin,"cache-key",(char *)dir,roots[i],0};keys[i]=call(q);}size_t an,bn;char *ab=cx_read(files[0],&an),*bb=cx_read(files[1],&bn);ck(ab&&bb&&an==bn&&!memcmp(ab,bb,an)&&!keys[0].rc&&!keys[1].rc&&keys[0].out&&keys[1].out&&strcmp(keys[0].out,keys[1].out),"same input and receipt bytes with only physical root changed produce distinct production execution keys");free(ab);free(bb);np_free(keys);np_free(keys+1);}else die();printf("NET_CACHE_PHASE\tchecks=%d\tfailed=%d\n",checks,failed);return failed?1:0;}
int main(int argc,char **argv){if(argc>1)return cache_phase(argc,argv);if(argc!=1)die();if(!realpath(".",root))die();char tmpabs[8192];if(!realpath(getenv("TMPDIR")?getenv("TMPDIR"):"/tmp",tmpabs))die();if(cx_fmt(base,sizeof base,"%s/c48-incremental-check-XXXXXX",tmpabs)||!mkdtemp(base)||cx_fmt(com,sizeof com,"%s/unisacc.com",root)||cx_fmt(tool,sizeof tool,"%s/tools/net-incremental-rehearsal.cx",root))die();if(cx_fmt(bin,sizeof bin,"%s/controller",base))die();char *prep[]={"sh",com,tool,"-o",bin,0};np_result pr=call(prep);ck(!pr.rc,"compile current controller once");if(pr.rc)die();np_free(&pr);char *list[]={"sh",com,"tools/net-build-profile.cx","--","--list",0};np_result ids=call(list);if(ids.rc)die();char names[42][160];int nn=0;for(char *p=ids.out;(p=strstr(p,"\nRECIPE\t"));p++){int i;char name[160];if(sscanf(p+1,"RECIPE\t%d\t%159s",&i,name)!=2||i!=nn||nn==42)die();(cx_fmt(names[nn++], sizeof names[nn++], "%s", name) ? exit(2) : (void)0);}if(nn!=42)die();np_free(&ids);
 cache_boundaries();
 char before[8192],after[8192],out[8192];cx_fmt(before,sizeof before,"%s/before.tsv",base);cx_fmt(after,sizeof after,"%s/after.tsv",base);const char *labels[]={"exact three recipe plan","four changed rejected","tool identity rejected","missing digest rejected","duplicate net rejected","wrong affected set rejected"};for(int mode=0;mode<6;mode++){char a[32768],b[32768],h[65],changed[65],other[65];memset(h,'a',64);h[64]=0;memset(changed,'b',64);changed[64]=0;memset(other,'c',64);other[64]=0;long an=0,bn=0;for(int i=0;i<42;i++){int hit=!strcmp(names[i],"shared-e2")||!strcmp(names[i],"tokenpp")||!strcmp(names[i],"warnpp-shared");an+=snprintf(a+an,sizeof a-an,"NET_DIGEST\tversion=1\tnet=%s\tstage=fixture\tsha256=%s\tfiles=1\tbytes=1\ttool_sha=%s\tclosure=static-upper-bound\n",names[i],h,h);if(mode==3&&i==41)continue;const char *id=mode==4&&i==41?names[0]:names[i];int delta=hit||(mode==1&&i==1);if(mode==5){if(!strcmp(names[i],"tokenpp"))delta=0;if(i==1)delta=1;}bn+=snprintf(b+bn,sizeof b-bn,"NET_DIGEST\tversion=1\tnet=%s\tstage=fixture\tsha256=%s\tfiles=1\tbytes=1\ttool_sha=%s\tclosure=static-upper-bound\n",id,delta?changed:h,mode==2?other:h);}writefile(before,a,an);writefile(after,b,bn);cx_fmt(out,sizeof out,"%s/plan-%d.tsv",base,mode);char *v[]={bin,"plan",before,after,out,0};np_result r=call(v);struct stat st;int yes=r.rc==(mode?2:0);if(mode){errno=0;yes=yes&&!r.outn&&lstat(out,&st)&&errno==ENOENT;}else{size_t n;char *s=cx_read(out,&n);yes=yes&&s&&strstr(s,"PLAN_COMPLETE\tmodels=42\tbuild=3\treuse=39");free(s);}ck(yes,labels[mode]);if(!yes)fprintf(stderr,"%s\n",r.err?r.err:"");np_free(&r);}
 char dir[8192],nested[8192],file[8192];cx_fmt(dir,sizeof dir,"%s/mutation",base);if(mkdir(dir,0700))die();cx_fmt(nested,sizeof nested,"%s/root",dir);if(mkdir(nested,0700))die();cx_fmt(nested,sizeof nested,"%s/root/exec",dir);if(mkdir(nested,0700))die();cx_fmt(nested,sizeof nested,"%s/root/exec/pp",dir);if(mkdir(nested,0700))die();cx_fmt(file,sizeof file,"%s/location-byte.tsv",nested);const char *src="S\tREJECT unreachable\nT\tREJECT unreachable\n";writefile(file,src,strlen(src));char *m[]={bin,"mutate",dir,0};np_result r=call(m);size_t n;char *actual=cx_read(file,&n);const char *want="S\tREJECT unreachable\nT\tREJECT BASE6-probe-unreachable\n";ck(!r.rc&&actual&&n==strlen(want)&&!memcmp(actual,want,n),"only last REJECT string mutates in private fixture");free(actual);np_free(&r);r=call(m);ck(r.rc==2&&!r.outn,"repeat mutation refuses");np_free(&r);char missing[8192],result[8192];cx_fmt(missing,sizeof missing,"%s/missing",base);cx_fmt(result,sizeof result,"%s/report.tsv",base);char *badcache[]={bin,"cache",missing,"unknown",0};r=call(badcache);ck(r.rc==2&&!r.outn,"unknown native cache kind refuses");np_free(&r);char *badreport[]={bin,"report",missing,result,0};r=call(badreport);struct stat st;errno=0;ck(r.rc==2&&!r.outn&&lstat(result,&st)&&errno==ENOENT,"incomplete report cannot publish VERIFIED");np_free(&r);printf("NET_INCREMENTAL_CHECK\tchecks=%d\tfailed=%d\tclaim=fixtures-not-full-rehearsal\n",checks,failed);return failed?1:0;}
