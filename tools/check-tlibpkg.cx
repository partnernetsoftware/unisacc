/* tools/check-tlibpkg.cx -- unit checks of tools/cxlib/tlibpkg.cx (no product build, no native tool).
 *
 *   sh ./unisacc.com tools/check-tlibpkg.cx [-- ROOT OUT]
 *
 * (1) version text: three decimal parts only; (2) the compatibility rule: same major and
 * minor.patch not older; (3) member names; (4) the ar walk over short and "#1/" long names, the
 * metadata members included, and the refusals of a cut archive; (5) the canonical-header check
 * refuses a changed owner field, a wrong pad byte and trailing bytes; (6) receipt field lookup;
 * (7) a package table in a private tree: units are the directory's own regular .cx files in
 * path order, a symlinked unit and an excluded unit are not members, deps and exclusions are
 * read, and a missing package, a bad version and a bad deps item are refused; the optional
 * opaque field names units of the package only. */
#pragma unisa use cxlib.tlibpkg
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.proc
#pragma unisa use sys.time
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use mem.heap

static int failed;
static TpPkg pk;
static char work[4400];

static void ck(int ok, const char *name) {
    if (!ok) failed++;
    sy_printf("%s\ttlibpkg.%s\n", ok ? "PASS" : "FAIL", name);
}

/* One ar member in the product's spelling; LONGNAME uses the BSD "#1/N" form. */
static void member(TpBuf *o, const char *name, const char *body, long n, int longname) {
    char h[64], nm[32];
    long nl = tx_len(name, 256), size = longname ? n + nl : n;
    if (longname) { if (cx_fmt(nm, sizeof nm, "#1/%ld", nl)) nm[0] = 0; }
    else if (cx_fmt(nm, sizeof nm, "%s", name)) nm[0] = 0;
    if (cx_fmt(h, sizeof h, "%-16s%-12s%-6s%-6s%-8s%-10ld`\n", nm, "0", "0", "0", "100644", size)) { o->bad = 1; return; }
    tp_put(o, h, 60);
    if (longname) tp_put(o, name, nl);
    tp_put(o, body, n);
    if (size & 1) tp_put(o, "\n", 1);
}

static int put(const char *rel, const char *text) {
    char p[4400];
    if (cx_fmt(p, sizeof p, "%s/%s", work, rel)) return -1;
    return cx_write(p, text, (size_t)tx_len(text, TX_ZCAP));
}

static int putat(const char *root, const char *rel, const char *text) {
    char p[4400];
    if (cx_fmt(p, sizeof p, "%s/%s", root, rel)) return -1;
    return cx_write(p, text, (size_t)tx_len(text, TX_ZCAP));
}

/* A one-package tree at ROOT for the kit key: a product, the table, the manifest, the tlib tool, a
   unit that includes a file next to it, which includes one found from ROOT. */
static int keytree(const char *root) {
    static const char *dirs[] = {"", "/build", "/build/layer-api", "/pa", "/tools", "/top", 0};
    char p[4400];
    int i;
    for (i = 0; dirs[i]; i++) if (cx_fmt(p, sizeof p, "%s%s", root, dirs[i]) || sy_mkdir(p, 0755)) return -1;
    return putat(root, "unisacc.com", "product1\n") || putat(root, "build/tlib-packages.tsv", "p.a\t0.3.1\tabc\tpa\t-\t-\tnote\n") ||
           putat(root, "build/layer-api/p.a.tsv", "m\n") || putat(root, "tools/tlib.cx", "int t;\n") ||
           putat(root, "pa/alpha.cx", "#include \"inc.h\"\nint a;\n") || putat(root, "pa/inc.h", "#define X 1\n# include \"top/deep.h\"\n") ||
           putat(root, "top/deep.h", "int d;\n");
}

int main(int argc, char **argv) {
    char name[300], why[256], dst[128], p[4400], q[4400];
    const char *d;
    long len, at;
    int v[3], prep = 0;
    TpBuf ar;

    /* (1) (2) versions */
    ck(!tp_ver_parse("0.1.0", v) && v[0] == 0 && v[1] == 1 && v[2] == 0 && !tp_ver_parse("12.34.56", v) && v[0] == 12 && v[2] == 56, "version-parse");
    ck(tp_ver_parse("1.2", v) && tp_ver_parse("1.2.3.4", v) && tp_ver_parse("1..3", v) && tp_ver_parse("a.b.c", v) &&
       tp_ver_parse("", v) && tp_ver_parse("1.2.3 ", v) && tp_ver_parse("1.2.-3", v), "version-refusals");
    ck(tp_ver_compat("0.1.0", "0.1.0") == 0 && tp_ver_compat("0.2.0", "0.1.5") == 0 && tp_ver_compat("0.1.5", "0.1.2") == 0 &&
       tp_ver_compat("1.4.0", "1.3.9") == 0, "compat-same-major-not-older");
    ck(tp_ver_compat("1.0.0", "0.9.9") == 1 && tp_ver_compat("0.9.9", "1.0.0") == 1, "compat-major-mismatch");
    ck(tp_ver_compat("0.1.0", "0.2.0") == 2 && tp_ver_compat("0.2.1", "0.2.2") == 2, "compat-provider-too-old");
    ck(tp_ver_compat("0.1", "0.1.0") == -1 && tp_ver_compat("0.1.0", "x") == -1, "compat-bad-version");

    /* (3) member names */
    ck(!tp_member_name("cx/sys/fs.cx", name, sizeof name) && tx_eqz(name, "cx.sys.fs.o") &&
       !tp_member_name("cx/owned.cx", name, sizeof name) && tx_eqz(name, "cx.owned.o"), "member-name");
    ck(tp_member_name("cx/sys/fs.c", name, sizeof name) && tp_member_name("cx/sys/fs.cx", name, 8), "member-name-refusals");

    /* (4) ar walk */
    ar.b = 0; ar.n = 0; ar.cap = 0; ar.bad = 0;
    tp_put(&ar, "!<arch>\n", 8);
    member(&ar, "__.S.receipt", "k\tv\n", 4, 0);
    member(&ar, "a.o", "odd", 3, 0);
    member(&ar, "a.very.long.member.name.o", "LONGBODY", 8, 1);
    ck(!ar.bad, "archive-fixture");
    at = 0;
    ck(tp_ar_next(ar.b, ar.n, &at, name, sizeof name, &d, &len) == 0 && tx_eqz(name, "__.S.receipt") && len == 4 &&
       tp_ar_next(ar.b, ar.n, &at, name, sizeof name, &d, &len) == 0 && tx_eqz(name, "a.o") && len == 3 && mm_same(d, "odd", 3) &&
       tp_ar_next(ar.b, ar.n, &at, name, sizeof name, &d, &len) == 0 && tx_eqz(name, "a.very.long.member.name.o") && len == 8 && mm_same(d, "LONGBODY", 8) &&
       tp_ar_next(ar.b, ar.n, &at, name, sizeof name, &d, &len) == 1, "ar-walk-short-long-and-metadata");
    ck(tp_ar_find(ar.b, ar.n, "a.o", &d, &len) == 0 && len == 3 && tp_ar_find(ar.b, ar.n, "absent.o", &d, &len) == 1, "ar-find");
    at = 0;
    ck(tp_ar_next("not an archive at all", 21, &at, name, sizeof name, &d, &len) == -1, "ar-refuses-non-archive");
    at = 0;
    ck(tp_ar_next(ar.b, ar.n - 5, &at, name, sizeof name, &d, &len) == 0 && tp_ar_next(ar.b, ar.n - 5, &at, name, sizeof name, &d, &len) == 0 &&
       tp_ar_next(ar.b, ar.n - 5, &at, name, sizeof name, &d, &len) == -1, "ar-refuses-cut-member");

    /* (5) canonical headers */
    ck(tp_ar_canon(ar.b, ar.n) == 0, "canon-accepts-product-spelling");
    ar.b[8 + 16] = '7';                       /* mtime of the first member */
    ck(tp_ar_canon(ar.b, ar.n) == -1, "canon-refuses-owner-field");
    ar.b[8 + 16] = '0';
    ar.b[8 + 60 + 4 + 60 + 3] = ' ';          /* the pad byte after the 3-byte body */
    ck(tp_ar_canon(ar.b, ar.n) == -1, "canon-refuses-pad-byte");
    ar.b[8 + 60 + 4 + 60 + 3] = '\n';
    tp_put(&ar, "x", 1);
    ck(tp_ar_canon(ar.b, ar.n) == -1 && tp_ar_canon(ar.b, ar.n - 1) == 0, "canon-refuses-trailing-bytes");
    mm_free(ar.b);

    /* (6) receipt fields */
    {
        const char *r = "pkg\tfx\nunit\ta.cx\ts1\ta.o\to1\nunit\tb.cx\ts2\tb.o\to2\ncontent_sha\tcc\n";
        long rn = tx_len(r, 4096);
        ck(tp_rc_get(r, rn, "pkg", 0, 1, dst, sizeof dst) == 0 && tx_eqz(dst, "fx") &&
           tp_rc_get(r, rn, "unit", 1, 3, dst, sizeof dst) == 0 && tx_eqz(dst, "b.o") &&
           tp_rc_get(r, rn, "unit", 2, 1, dst, sizeof dst) == 1 && tp_rc_get(r, rn, "absent", 0, 1, dst, sizeof dst) == 1 &&
           tp_rc_get(r, rn, "pkg", 0, 4, dst, sizeof dst) == -1 && tp_rc_get(r, rn, "unit", 0, 2, dst, 2) == -1, "receipt-fields");
    }

    /* (7) package table in a private tree */
    if (argc >= 3 && argv[2][0]) {
        (void)sy_mkdir(argv[2], 0755);
        if (cx_fmt(work, sizeof work, "%s/tlibpkg-%d-%ld", argv[2], sy_pid(), sy_now_ms())) return 2;
    } else {
        char root[4096], dot[4400];
        if (sy_realpath(argc >= 2 && argv[1][0] ? argv[1] : ".", root, sizeof root) < 0 || cx_fmt(dot, sizeof dot, "%s/.trash", root) ||
            cx_fmt(work, sizeof work, "%s/tlibpkg-%d-%ld", dot, sy_pid(), sy_now_ms())) return 2;
        (void)sy_mkdir(dot, 0755);
    }
    if (sy_mkdir(work, 0700) || sy_realpath(work, work, sizeof work) < 0) return 2;
    if (cx_fmt(p, sizeof p, "%s/build", work) || sy_mkdir(p, 0755) || cx_fmt(p, sizeof p, "%s/pa", work) || sy_mkdir(p, 0755) ||
        cx_fmt(p, sizeof p, "%s/pb", work) || sy_mkdir(p, 0755)) return 2;
    prep |= put("pa/zeta.cx", "int z;\n") || put("pa/alpha.cx", "int a;\n") || put("pa/skip.cx", "int s;\n") || put("pa/note.txt", "x\n");
    prep |= put("pb/real.cx", "int r;\n") || put("top.cx", "int t;\n");
    prep |= cx_fmt(p, sizeof p, "%s/pa/linked.cx", work) || sy_symlink("../pb/real.cx", p);
    prep |= put("build/tlib-packages.tsv",
                "# comment\n"
                "p.a\t0.3.1\tabc\tpa;top.cx\tpa/skip.cx=why-not\t-\tnote\n"
                "p.b\t1.0.0\tdef\tpb\t-\tp.a@0.3.0\tnote\n"
                "p.badver\t1.0\tdef\tpb\t-\t-\tnote\n"
                "p.baddep\t1.0.0\tdef\tpb\t-\tp.a\tnote\n"
                "p.empty\t1.0.0\tdef\tbuild\t-\t-\tnote\n"
                "p.opq\t1.0.0\tdef\tpa\t-\t-\tnote\tpa/zeta.cx=no-interface\n"
                "p.badopq\t1.0.0\tdef\tpa\t-\t-\tnote\tpb/real.cx=not-a-unit\n");
    ck(!prep, "table-fixture");
    ck(tp_load(work, "p.a", &pk, why, sizeof why) == 0 && tx_eqz(pk.version, "0.3.1") && tx_eqz(pk.api_sha, "abc") && pk.nunit == 3 &&
       tx_eqz(pk.unit[0], "pa/alpha.cx") && tx_eqz(pk.unit[1], "pa/zeta.cx") && tx_eqz(pk.unit[2], "top.cx"), "units-own-regular-files-in-path-order");
    ck(tp_find_unit(&pk, "pa/linked.cx") < 0 && tp_find_unit(&pk, "pa/skip.cx") < 0 && tp_find_unit(&pk, "pa/note.txt") < 0 &&
       pk.nexcl == 1 && tp_find_excl(&pk, "pa/skip.cx") == 0 && tx_eqz(pk.excl_why[0], "why-not") && pk.ndep == 0, "symlink-and-excluded-are-not-members");
    ck(tp_load(work, "p.b", &pk, why, sizeof why) == 0 && pk.nunit == 1 && tx_eqz(pk.unit[0], "pb/real.cx") && pk.ndep == 1 &&
       tx_eqz(pk.dep_pkg[0], "p.a") && tx_eqz(pk.dep_ver[0], "0.3.0"), "deps-read");
    ck(tp_load(work, "p.none", &pk, why, sizeof why) == -1 && tp_load(work, "p.badver", &pk, why, sizeof why) == -1 &&
       tp_load(work, "p.baddep", &pk, why, sizeof why) == -1 && tp_load(work, "p.empty", &pk, why, sizeof why) == -1, "table-refusals");
    {
        long nn = 0;
        char *names = tp_names(work, &nn);
        ck(names && tx_prefix(names, nn, "p.a\np.b\n", 8) && tx_count(names, nn, "\n", 1) == 7, "package-names-in-table-order");
        mm_free(names);
    }
    /* the optional eighth field: a unit packed without interface rows must be a unit of the package */
    ck(tp_load(work, "p.opq", &pk, why, sizeof why) == 0 && pk.nunit == 3 && pk.nopq == 1 && tp_find_opaque(&pk, "pa/zeta.cx") == 0 &&
       tx_eqz(pk.opq_why[0], "no-interface") && tp_find_opaque(&pk, "pa/alpha.cx") < 0 && tp_find_unit(&pk, "pa/zeta.cx") >= 0, "opaque-unit-read");
    ck(tp_load(work, "p.a", &pk, why, sizeof why) == 0 && pk.nopq == 0 && tp_load(work, "p.badopq", &pk, why, sizeof why) == -1, "opaque-absent-and-non-unit-refused");
    if (cx_fmt(q, sizeof q, "%s/pa/alpha.cx", work) || tp_sha_file(q, name)) name[0] = 0;
    tp_sha("int a;\n", 7, dst);
    ck(name[0] && tx_eqz(name, dst), "file-sha-equals-block-sha");
    {
        char a[65], b[65];
        tp_sha("abc", 3, a);
        cx_sha256_hex("abc", 3, b);
        ck(tx_eqz(a, b) && tx_eqz(a, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"), "sha-fast-path-equals-portable");
    }

    /* (8) the kit key is content, not the checkout path */
    {
        char r1[4400], r2[4400], k1[65], k2[65], k3[65], d1[4400], d2[4400], prod[4400];
        int okp = !cx_fmt(r1, sizeof r1, "%s/key1", work) && !cx_fmt(r2, sizeof r2, "%s/deeper/key2", work) &&
                  !cx_fmt(p, sizeof p, "%s/deeper", work) && !sy_mkdir(p, 0755) && !keytree(r1) && !keytree(r2);
        ck(okp, "kit-key-fixture");
        k1[0] = k2[0] = k3[0] = 0;
        ck(okp && !cx_fmt(prod, sizeof prod, "%s/unisacc.com", r1) && tp_kit_key(r1, prod, k1) == 0 && tx_len(k1, 65) == 64 &&
           !cx_fmt(prod, sizeof prod, "%s/unisacc.com", r2) && tp_kit_key(r2, prod, k2) == 0 && tx_eqz(k1, k2), "kit-key-same-content-two-roots-same-key");
        ck(okp && tp_kit_dir(r1, d1, sizeof d1) == 0 && tp_kit_dir(r2, d2, sizeof d2) == 0 && tx_eqz(d1, d2) &&
           tx_find(d1, tx_len(d1, sizeof d1), k1, 64) > 0 && tx_find(d1, tx_len(d1, sizeof d1), "key1", 4) < 0, "kit-dir-is-the-key-and-names-no-root");
        ck(okp && !putat(r2, "pa/alpha.cx", "#include \"inc.h\"\nint b;\n") && tp_kit_key(r2, prod, k3) == 0 && !tx_eqz(k1, k3) &&
           !putat(r2, "pa/alpha.cx", "#include \"inc.h\"\nint a;\n") && tp_kit_key(r2, prod, k3) == 0 && tx_eqz(k1, k3), "kit-key-unit-byte-changes-key-restore-returns");
        ck(okp && !putat(r2, "pa/inc.h", "#define X 2\n# include \"top/deep.h\"\n") && tp_kit_key(r2, prod, k3) == 0 && !tx_eqz(k1, k3) &&
           !putat(r2, "pa/inc.h", "#define X 1\n# include \"top/deep.h\"\n") &&tp_kit_key(r2, prod, k3) == 0 && tx_eqz(k1, k3), "kit-key-included-file-byte-changes-key");
        ck(okp && !putat(r2, "top/deep.h", "int e;\n") && tp_kit_key(r2, prod, k3) == 0 && !tx_eqz(k1, k3) &&
           !putat(r2, "top/deep.h", "int d;\n") && tp_kit_key(r2, prod, k3) == 0 && tx_eqz(k1, k3), "kit-key-nested-root-relative-include-changes-key");
        ck(okp && !putat(r2, "unisacc.com", "product2\n") && tp_kit_key(r2, prod, k3) == 0 && !tx_eqz(k1, k3) &&
           !putat(r2, "unisacc.com", "product1\n") && tp_kit_key(r2, prod, k3) == 0 && tx_eqz(k1, k3), "kit-key-product-changes-key");
        ck(okp && !putat(r2, "build/layer-api/p.a.tsv", "n\n") && tp_kit_key(r2, prod, k3) == 0 && !tx_eqz(k1, k3) &&
           !putat(r2, "build/layer-api/p.a.tsv", "m\n") && tp_kit_key(r2, prod, k3) == 0 && tx_eqz(k1, k3), "kit-key-manifest-changes-key");
        ck(okp && !putat(r2, "tools/tlib.cx", "int u;\n") && tp_kit_key(r2, prod, k3) == 0 && !tx_eqz(k1, k3) &&
           !putat(r2, "tools/tlib.cx", "int t;\n") && tp_kit_key(r2, prod, k3) == 0 && tx_eqz(k1, k3), "kit-key-tlib-tool-changes-key");
        ck(okp && !putat(r2, "build/tlib-packages.tsv", "p.a\t0.3.2\tabc\tpa\t-\t-\tnote\n") && tp_kit_key(r2, prod, k3) == 0 && !tx_eqz(k1, k3) &&
           !putat(r2, "build/tlib-packages.tsv", "p.a\t0.3.1\tabc\tpa\t-\t-\tnote\n") && tp_kit_key(r2, prod, k3) == 0 && tx_eqz(k1, k3), "kit-key-table-changes-key");
        ck(okp && !putat(r2, "pa/beta.cx", "int n;\n") && tp_kit_key(r2, prod, k3) == 0 && !tx_eqz(k1, k3), "kit-key-added-unit-changes-key");
        ck(okp && !cx_fmt(p, sizeof p, "%s/absent.com", r1) && tp_kit_key(r1, p, k3) == -1 && tp_kit_key(work, prod, k3) == 0 &&
           !cx_fmt(p, sizeof p, "%s/nowhere", work) && tp_kit_key(p, prod, k3) == -1 && tp_kit_dir(p, d1, sizeof d1) == -1, "kit-key-unreadable-product-or-table-refused");
        /* (9) the unit object key: the unit, every unit of its use closure and the files they #include */
        {
            const char *cl = "tools/tlib.cx\npa/alpha.cx\n";
            char u1[65], u2[65], u3[65];
            u1[0] = u2[0] = u3[0] = 0;
            ck(okp && tp_unit_key(r1, "ps1", "-c", "tools/tlib.cx", cl, u1) == 0 && tx_len(u1, 65) == 64 &&
               tp_unit_key(r2, "ps1", "-c", "tools/tlib.cx", cl, u2) == 0 && tx_eqz(u1, u2) && !tx_eqz(u1, k1), "unit-key-same-content-two-roots-same-key");
            ck(okp && !putat(r2, "tools/tlib.cx", "int u;\n") && tp_unit_key(r2, "ps1", "-c", "tools/tlib.cx", cl, u3) == 0 && !tx_eqz(u1, u3) &&
               !putat(r2, "tools/tlib.cx", "int t;\n") && tp_unit_key(r2, "ps1", "-c", "tools/tlib.cx", cl, u3) == 0 && tx_eqz(u1, u3), "unit-key-unit-byte-changes-key-restore-returns");
            ck(okp && !putat(r2, "pa/alpha.cx", "#include \"inc.h\"\nint b;\n") && tp_unit_key(r2, "ps1", "-c", "tools/tlib.cx", cl, u3) == 0 && !tx_eqz(u1, u3) &&
               !putat(r2, "pa/alpha.cx", "#include \"inc.h\"\nint a;\n") && tp_unit_key(r2, "ps1", "-c", "tools/tlib.cx", cl, u3) == 0 && tx_eqz(u1, u3), "unit-key-used-unit-byte-changes-key");
            ck(okp && !putat(r2, "pa/inc.h", "#define X 2\n# include \"top/deep.h\"\n") && tp_unit_key(r2, "ps1", "-c", "tools/tlib.cx", cl, u3) == 0 && !tx_eqz(u1, u3) &&
               !putat(r2, "pa/inc.h", "#define X 1\n# include \"top/deep.h\"\n") && tp_unit_key(r2, "ps1", "-c", "tools/tlib.cx", cl, u3) == 0 && tx_eqz(u1, u3), "unit-key-included-file-of-used-unit-changes-key");
            ck(okp && !putat(r2, "top/deep.h", "int e;\n") && tp_unit_key(r2, "ps1", "-c", "tools/tlib.cx", cl, u3) == 0 && !tx_eqz(u1, u3) &&
               !putat(r2, "top/deep.h", "int d;\n") && tp_unit_key(r2, "ps1", "-c", "tools/tlib.cx", cl, u3) == 0 && tx_eqz(u1, u3), "unit-key-nested-include-changes-key");
            ck(okp && tp_unit_key(r1, "ps2", "-c", "tools/tlib.cx", cl, u3) == 0 && !tx_eqz(u1, u3) &&
               tp_unit_key(r1, "ps1", "-c -DX", "tools/tlib.cx", cl, u3) == 0 && !tx_eqz(u1, u3) &&
               tp_unit_key(r1, "ps1", "-c", "./tools/tlib.cx", cl, u3) == 0 && !tx_eqz(u1, u3) &&
               tp_unit_key(r1, "ps1", "-c", "tools/tlib.cx", "tools/tlib.cx\n", u3) == 0 && !tx_eqz(u1, u3), "unit-key-product-flags-path-closure-each-change-key");
            ck(okp && tp_unit_key(r1, "", "-c", "tools/tlib.cx", cl, u3) == -1 && tp_unit_key(r1, "ps1", "-c", "tools/tlib.cx", "", u3) == -1 &&
               tp_unit_key(r1, "ps1", "-c", "", cl, u3) == -1, "unit-key-bad-argument-refused");
        }
    }

    if (argc < 3) cx_rmtree(work);
    sy_printf("CHECK_TLIBPKG\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
