#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use text.text
/* tools/check-batch-split.cx -- split tsv names == labels in the original .cx
 *
 *   sh ./unisacc.com tools/check-batch-split.cx
 *
 * stdio-crossunit-split.tsv covers ck("...") names in tests/stdio-crossunit.cx;
 * stream-pipe-split.tsv covers sp_ck(..., "...") labels in tests/check-stream-pipe.cx.
 * part is portable or posix. Prints CHECK_BATCH_SPLIT<TAB>failed=N. */
static int failed;
static int has(const char *h, size_t n, const char *s) {
    size_t sl = 0, i, k;
    while (s[sl]) sl++;
    if (sl == 0 || n < sl) return 0;
    for (i = 0; i + sl <= n; i++) {
        for (k = 0; k < sl && h[i + k] == s[k]; k++) {}
        if (k == sl) return 1;
    }
    return 0;
}
static void ck(int ok, const char *n) {
    if (!ok) failed++;
    sy_printf("%s\t%s\n", ok ? "PASS" : "FAIL", n);
}
static int load_tsv(const char *p, char *names[], char *parts[], int max, int *n) {
    size_t bn = 0, i = 0;
    char *b = cx_read(p, &bn);
    if (!b) return -1;
    *n = 0;
    while (i < bn && *n < max) {
        size_t e = i, t;
        while (e < bn && b[e] != '\n') e++;
        if (b[i] != '#' && !(i + 4 < e && b[i] == 'n' && b[i + 1] == 'a' && b[i + 2] == 'm' && b[i + 3] == 'e')) {
            t = i;
            while (t < e && b[t] != '\t') t++;
            if (t < e && t > i) {
                b[t] = 0;
                if (e < bn) b[e] = 0;
                names[*n] = b + i;
                parts[*n] = b + t + 1;
                (*n)++;
            }
        }
        i = e < bn ? e + 1 : e;
    }
    return 0;
}
int main(void) {
    char *sn[32], *sp[32], *tn[32], *tp[32];
    int ns = 0, nt = 0, i;
    size_t n1 = 0, n2 = 0;
    char *cx1 = cx_read("tests/stdio-crossunit.cx", &n1);
    char *cx2 = cx_read("tests/check-stream-pipe.cx", &n2);
    if (!cx1 || !cx2) { sy_eprintf("check-batch-split: source\n"); return 2; }
    if (load_tsv("tests/stdio-crossunit-split.tsv", sn, sp, 32, &ns)) return 2;
    if (load_tsv("tests/stream-pipe-split.tsv", tn, tp, 32, &nt)) return 2;
    ck(ns == 9, "stdio-split-count-9");
    ck(nt == 9, "stream-split-count-9");
    for (i = 0; i < ns; i++) {
        int hit = has(cx1, n1, sn[i]) || (has(cx1, n1, "ab-fclose") && has(sn[i], 20, "ab-fclose"))
            || (has(cx1, n1, "ab-exit") && has(sn[i], 16, "ab-exit"))
            || (has(cx1, n1, "abc-fflush") && has(sn[i], 20, "abc-fflush"));
        ck(hit, sn[i]);
        ck(tx_eqz(sp[i], "portable") || tx_eqz(sp[i], "posix"), "stdio-part");
    }
    for (i = 0; i < nt; i++) {
        ck(has(cx2, n2, tn[i]), tn[i]);
        ck(tx_eqz(tp[i], "portable") || tx_eqz(tp[i], "posix"), "stream-part");
    }
    sy_printf("CHECK_BATCH_SPLIT\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
