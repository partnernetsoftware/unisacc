/* check-dcheck: tools/dcheck.cx on a private fixture root (a four-row registry and fake checks under the temp
 * directory; the selection is the real tools/affected.cx, the run is the real devsvc flow).
 *   sh ./unisacc.com tools/check-dcheck.cx          (from the repo root)
 * Fixture: batches fx-pass, fx-fail, fx-slow (tier commit) and fx-daily (tier daily); every check source names
 * tools/fxsrc.cx, none names tools/other.cx.  The fake checks run through --runner: fx-pass sleeps 1 s and exits 0,
 * fx-fail prints `FAIL fx-fail assertion-7` and exits 1, fx-slow sleeps 30 s against a 2.5 s node bound.
 * Prints PASS|FAIL<TAB>name per assertion and CHECK_DCHECK<TAB>checks=N<TAB>failed=N; rc 0 only when none failed. */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.time
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

static int checks, failed;
static char **prepared;
static char fx[2048], instance[2048], out[1 << 16];
static void ck(int ok, const char *name) { checks++; if (!ok) failed++; printf("%s\t%s\n", ok ? "PASS" : "FAIL", name); if (!ok) printf("--- output ---\n%s\n", out); }
static int has(const char *s) { return strstr(out, s) != 0; }
static long num(const char *key) { const char *q = strstr(out, key); return q ? atol(q + strlen(key)) : -1; }
static int put(const char *rel, const char *text) {
    char p[2400];
    if (cx_fmt(p, sizeof p, "%s/%s", fx, rel)) return 1;
    return sy_write_atomic(p, text, (long)strlen(text), 0644) != 0;
}
/* argv (0-terminated) in cwd, stdout into out; the exit code, -1 on a runner fault */
static int runv(char **v, const char *cwd) {
    np_result r = {0}; char why[256] = ""; int rc = np_run(v, cwd, 0, 50, &r, why, sizeof why); long n = (long)r.outn;
    if (n > (long)sizeof out - 1) n = (long)sizeof out - 1;
    if (r.out && n > 0 && mm_copy(out, sizeof out, r.out, n)) n = 0;
    out[n < 0 ? 0 : n] = 0;
    if (rc) { np_free(&r); return -1; }
    rc = r.rc; np_free(&r); return rc;
}
/* sh ./unisacc.com tools/dcheck.cx -- --root FX --home . --runner R --node-timeout-ms MS ARGS... */
static int dcheck(const char *ms, char **args) {
    char *v[32]; int n = 0;
    if (prepared) {
        v[n++] = prepared[0]; v[n++] = "--prepared-tools";
        for (int i = 0; i < 3; i++) v[n++] = prepared[i];
    } else { v[n++] = "sh"; v[n++] = "./unisacc.com"; v[n++] = "tools/dcheck.cx"; v[n++] = "--"; }
    v[n++] = "--root"; v[n++] = fx; v[n++] = "--home"; v[n++] = ".";
    v[n++] = "--runner"; v[n++] = "sh tools/run-{id}.sh"; v[n++] = "--node-timeout-ms"; v[n++] = (char *)ms;
    for (int k = 0; args[k] && n < 31; k++) v[n++] = args[k];
    v[n] = 0;
    return runv(v, 0);
}

static int wait_job(char **argv, const char *id) {
    if (!prepared) return runv(argv, 0);
    char *native[] = {prepared[2], "wait", (char *)id, "--timeout-ms", "30000", 0};
    return runv(native, 0);
}

int main(int argc, char **argv) {
    static const char *bid[] = {"pass", "fail", "slow", "daily", 0};
    char reg[4096], cov[2048], p[2400]; long rn = 0, cn = 0; int rc; unsigned char *td = 0; int64_t tn = 0; long t0 = sy_now_ms();
    int run_select = 1, run_bg = 1, run_manifest = 1;
    if (argc != 1) {
        if (argc != 6 || strcmp(argv[1], "--cases")) return 2;
        int all = !strcmp(argv[2], "all");
        run_select = all || !strcmp(argv[2], "select");
        run_bg = all || !strcmp(argv[2], "bg");
        run_manifest = all || !strcmp(argv[2], "manifest");
        if (!run_select && !run_bg && !run_manifest) return 2;
        prepared = argv + 3;
        for (int i = 0; i < 3; i++)
            if (prepared[i][0] != '/' || sy_is_reg(prepared[i]) != 1) {
                fprintf(stderr, "REFUSE\tcheck-dcheck\tprepared-tool-required\n");
                return 2;
            }
        (void)unsetenv("DEVSVC_REPO_TABLE_PIN");
        (void)unsetenv("DEVSVC_REPO_TABLE");
        if (setenv("DEVSVC_SELF_BIN", prepared[2], 1)) return 2;
    }
    if (sy_is_reg("tools/dcheck.cx") != 1 || sy_is_reg("exec/pipeline/table-deps.tsv") != 1) { printf("FAIL\trun-from-repo-root\nCHECK_DCHECK\tchecks=1\tfailed=1\n"); return 2; }
    if (cx_fmt(fx, sizeof fx, "%s/check-dcheck-%d", sy_tmpdir(), sy_pid())) return 2;
    if (prepared && (cx_fmt(instance, sizeof instance, "%s/check-dcheck-dv-%d", sy_tmpdir(), sy_pid()) ||
                     setenv("UNISACC_DEVSVC_DIR", instance, 1))) return 2;
    {   const char *sub[] = {"", "/tests", "/tools", "/exec", "/exec/pipeline", 0};
        for (int i = 0; sub[i]; i++) { if (cx_fmt(p, sizeof p, "%s%s", fx, sub[i]) || sy_mkdir(p, 0755) < 0) { printf("FAIL\tfixture-mkdir\t%s\nCHECK_DCHECK\tchecks=1\tfailed=1\n", p); return 2; } }
    }
    rn = snprintf(reg, sizeof reg, "id\timplementation\tlayer\tsource\tmode\tplatform\tbudget_seconds\tmaterials\tentry\targs\tcoverage\texpect\theaders\ttier\n");
    cn = snprintf(cov, sizeof cov, "id\tlayer\timplementation\texpected_or_gap\tsource\n");
    rc = 0;
    for (int i = 0; bid[i]; i++) {
        char rel[128];
        rn += snprintf(reg + rn, sizeof reg - (size_t)rn, "fx-%s\tIMPLEMENTED\tcontract\ttools/check-fx%s.cx\tSOURCE\tlnx/x86_64\t%s\t-\ttools/check-fx%s.cx\t-\tfx.%s\trc0:FX\tproduct\t%s\n", bid[i], bid[i], i == 2 ? "70" : "55", bid[i], bid[i], i == 3 ? "daily" : "commit");
        cn += snprintf(cov + cn, sizeof cov - (size_t)cn, "fx.%s\tcontract\tIMPLEMENTED_SEPARATE_BATCH\tfixture\ttools/check-fx%s.cx\n", bid[i], bid[i]);
        (void)cx_fmt(rel, sizeof rel, "tools/check-fx%s.cx", bid[i]);
        rc |= put(rel, "int main(void){ const char *p = \"tools/fxsrc.cx\"; return !p; }\n");
    }
    rc |= put("tests/batches.tsv", reg) | put("tests/coverage.tsv", cov) | put("tests/run-batch.cx", "/* fixture: dcheck runs these batches through --runner */\n");
    rc |= put("tools/fxsrc.cx", "int fx;\n") | put("tools/other.cx", "int other;\n");
    rc |= put("tools/run-fx-pass.sh", "sleep 1; echo FX ok\n") | put("tools/run-fx-daily.sh", "echo FX ok\n");
    rc |= put("tools/run-fx-fail.sh", "sleep 1; echo 'FX step one'; echo 'FAIL fx-fail assertion-7'; echo 'FAIL later'; exit 1\n") | put("tools/run-fx-slow.sh", "sleep 30\n");
    if (sy_read_file("exec/pipeline/table-deps.tsv", &td, &tn, 1L << 24) == 0) {   /* the header line only: no table dependency in the fixture */
        long e = 0; while (e < (long)tn && td[e] != '\n') e++;
        td[e] = 0; (void)cx_fmt(p, sizeof p, "%s\n", (char *)td); rc |= put("exec/pipeline/table-deps.tsv", p); free(td);
    } else rc = 1;
    if (rc) { printf("FAIL\tfixture-write\nCHECK_DCHECK\tchecks=1\tfailed=1\n"); return 2; }

    if (run_select) {
    {   /* three commit batches selected, run together; the daily one is left out */
        char *a[] = {"--par", "3", "tools/fxsrc.cx", 0};
        rc = dcheck("2500", a);
        ck(has("DCHECK_SELECT\tchanged=1\tbatches=3\ttier=commit\t") && !has("fx-daily"), "select-commit-tier-only");
        ck(has("CHECK\tfx-pass\tPASS\t"), "pass-batch-pass");
        ck(has("CHECK\tfx-fail\tFAIL\t") && has("\tfirst=FAIL fx-fail assertion-7\n"), "fail-batch-first-line");
        ck(has("CHECK\tfx-slow\tDEFERRED\t") && has("first=timeout after ") && !has("CHECK\tfx-slow\tPASS"), "timeout-deferred-not-pass");
        ck(has("\nDCHECK\ttotal=3\tpass=1\tfail=1\tdeferred=1\tnot_run=0\twall_ms=") && rc == 1, "summary-and-rc1");
        ck(num("DCHECK_FLOW\tpeak=") > 1, "parallel-peak-above-1");
        ck(num("\twall_ms=") > 0 && num("\tserial_ms=") >= 4500 && num("\twall_ms=") < num("\tserial_ms="), "wall-below-serial");
        {   const char *q = strstr(out, "\nDCHECK\t"); ck(q && !strchr(q + 1, '\n')[1], "summary-is-last-line"); }
    }
    {   char *a[] = {"--only", "fx-pass,fx-daily", "tools/fxsrc.cx", 0};
        rc = dcheck("4000", a);
        ck(rc == 3 && has("CHECK\tfx-pass\tPASS\t") && has("CHECK\tfx-daily\tNOT_RUN\t0\tfirst=not selected") && has("DCHECK\ttotal=2\tpass=1\tfail=0\tdeferred=0\tnot_run=1\t") && !has("fx-fail") && !has("fx-slow"), "only-keeps-named-unselected-not-run");
    }
    {   char *a[] = {"--tier", "daily", "--only", "fx-daily", "tools/fxsrc.cx", 0};
        rc = dcheck("4000", a);
        ck(rc == 0 && has("batches=1\ttier=daily\t") && has("CHECK\tfx-daily\tPASS\t") && has("DCHECK\ttotal=1\tpass=1\t"), "tier-daily-selects-daily");
    }
    {   char *a[] = {"--only", "fx-slow", "tools/fxsrc.cx", 0};
        rc = dcheck("1000", a);
        ck(rc == 3 && has("CHECK\tfx-slow\tDEFERRED\t") && has("DCHECK\ttotal=1\tpass=0\tfail=0\tdeferred=1\tnot_run=0\t"), "only-deferred-rc3");
    }
    {   char *a[] = {"--only", "fx-slow,fx-pass", "tools/fxsrc.cx", 0}; const char *w, *c;
        (void)dcheck("1000", a);
        w = strstr(out, "DCHECK_WARN\tbudget-above-node-cap\tid=fx-slow\tbudget=70\n"); c = strstr(out, "CHECK\tfx-slow\t");
        ck(w && c && w < c && !has("DCHECK_WARN\tbudget-above-node-cap\tid=fx-pass"), "budget-above-node-cap-warns-before-check-line");
    }
    {   char *a[] = {"tools/other.cx", 0};
        rc = dcheck("4000", a);
        ck(rc == 0 && has("DCHECK_SELECT\tchanged=1\tbatches=0\t") && !has("\nCHECK\t") && has("DCHECK\ttotal=0\tpass=0\tfail=0\tdeferred=0\tnot_run=0\twall_ms=0\tserial_ms=0\n"), "unused-path-total-0-rc0");
    }
    {   /* no path given: the git work tree changes.  A fresh repository with nothing in it has none ... */
        char *g[] = {"git", "init", "-q", 0}, *a[] = {0}, *b[] = {"--only", "fx-daily", "--tier", "daily", 0};
        char gi[2400]; (void)cx_fmt(gi, sizeof gi, "%s/.gitignore", fx);
        rc = runv(g, fx);
        if (rc == 0) rc = put(".gitignore", "*\n");
        if (rc == 0) rc = dcheck("4000", a);
        ck(rc == 0 && has("DCHECK_SELECT\tchanged=0\tbatches=0\t") && has("DCHECK\ttotal=0\tpass=0\tfail=0\tdeferred=0\tnot_run=0\twall_ms=0\tserial_ms=0\n"), "empty-change-total-0-rc0");
        /* ... and with the fixture files untracked they are the change */
        (void)sy_unlink(gi);
        rc = dcheck("4000", b);
        ck(rc == 0 && num("DCHECK_SELECT\tchanged=") >= 10 && has("CHECK\tfx-daily\tPASS\t") && has("DCHECK\ttotal=1\tpass=1\t"), "git-worktree-changes-are-the-default");
    }
    {   char *a[] = {"--plan", "tools/fxsrc.cx", 0};
        rc = dcheck("4000", a);
        ck(rc == 0 && has("PLAN\tfx-fail\tb2\n") && has("b3\texec\t-\ta0=sh;a1=-c;a2=") && has(";timeout_ms=4000\n") && !has("\nCHECK\t") && !has("DCHECK\t"), "plan-prints-nodes-runs-nothing");
    }
    {   char *a[] = {"--bogus", 0}, *b[] = {"tools/fxsrc.cx", 0}, *c[] = {"--tier", "weekly", "tools/fxsrc.cx", 0};
        rc = dcheck("4000", a); ck(rc == 2, "unknown-option-rc2");
        rc = dcheck("55001", b); ck(rc == 2 && !has("\nCHECK\t"), "node-bound-never-widened");
        rc = dcheck("4000", c); ck(rc == 2, "unknown-tier-rc2");
    }
    }
    if (run_bg) {   /* --bg hands back a devsvc job at once; devsvc wait shows the same result lines */
        char *a[] = {"--bg", "--only", "fx-pass", "tools/fxsrc.cx", 0}; char id[128] = ""; const char *q; long b0 = sy_now_ms(), bms;
        rc = dcheck("4000", a); bms = sy_now_ms() - b0;
        q = strstr(out, "JOB\t");
        if (q) { long k = 0; q += 4; while (q[k] && q[k] != '\t' && q[k] != '\n' && k < (long)sizeof id - 1) { id[k] = q[k]; k++; } id[k] = 0; }
        ck(rc == 0 && id[0] && !has("\nCHECK\t"), "bg-returns-job");
        (void)bms;
        if (id[0]) {
            char *w[] = {"sh", "./unisacc.com", "tools/devsvc.cx", "--", "wait", id, "--timeout-ms", "30000", 0};
            rc = wait_job(w, id);
            ck(rc == 0 && has("CHECK\tfx-pass\tPASS\t") && has("DCHECK\ttotal=1\tpass=1\tfail=0\tdeferred=0\tnot_run=0\t") && has("JOB_DONE\t"), "bg-wait-shows-result");
        } else ck(0, "bg-wait-shows-result");
    }
    if (run_manifest) {   /* selection and run as two jobs: --select-only --out writes the manifest, --from runs only its batches */
        char m1[2400], m2[2400], m3[2400], bad1[2400]; char *a[8]; unsigned char *mb = 0; int64_t mn = 0; char mt[2048];
        (void)cx_fmt(m1, sizeof m1, "%s/m1.tsv", fx); (void)cx_fmt(m2, sizeof m2, "%s/m2.tsv", fx); (void)cx_fmt(m3, sizeof m3, "%s/m3.tsv", fx);
        a[0] = "--select-only"; a[1] = "--out"; a[2] = m1; a[3] = "tools/fxsrc.cx"; a[4] = 0;
        rc = dcheck("2500", a);
        ck(rc == 0 && has("DCHECK_SELECT\tchanged=1\tbatches=3\ttier=commit\t") && has("DCHECK_MANIFEST\tfile=") && !has("\nCHECK\t") && !has("\nDCHECK\t") && !has("fx-daily"), "select-only-prints-summary-and-runs-nothing");
        mt[0] = 0;
        if (sy_read_file(m1, &mb, &mn, 1 << 16) == 0 && mn < (int64_t)sizeof mt) { mm_copy(mt, sizeof mt, mb, mn); mt[mn] = 0; free(mb); }
        ck(!strncmp(mt, "DCHECK_MANIFEST\t1\nTIER\tcommit\nCHANGED\t1\n", 40) && strstr(mt, "BATCH\tfx-pass\t55\t0\n") && strstr(mt, "BATCH\tfx-fail\t55\t0\n") && strstr(mt, "BATCH\tfx-slow\t70\t0\n") && !strstr(mt, "fx-daily") && strstr(mt, "END\tbatches=3\textra=0\n"), "select-only-manifest-content");
        a[0] = "--select-only"; a[1] = "--out"; a[2] = m2; a[3] = "--only"; a[4] = "fx-pass,fx-daily"; a[5] = "tools/fxsrc.cx"; a[6] = 0;
        rc = dcheck("2500", a);
        mt[0] = 0; mb = 0;
        if (rc == 0 && sy_read_file(m2, &mb, &mn, 1 << 16) == 0 && mn < (int64_t)sizeof mt) { mm_copy(mt, sizeof mt, mb, mn); mt[mn] = 0; free(mb); }
        ck(strstr(mt, "BATCH\tfx-pass\t") && !strstr(mt, "fx-fail") && strstr(mt, "EXTRA\tfx-daily\n") && strstr(mt, "END\tbatches=1\textra=1\n"), "select-only-manifest-honours-only-and-extra");
        a[0] = "--from"; a[1] = m1; a[2] = "--par"; a[3] = "3"; a[4] = 0;
        rc = dcheck("1500", a);
        ck(has("DCHECK_SELECT\tchanged=1\tbatches=3\ttier=commit\tselect_ms=0\n") && has("CHECK\tfx-pass\tPASS\t") && has("CHECK\tfx-fail\tFAIL\t") && has("\tfirst=FAIL fx-fail assertion-7\n") && has("CHECK\tfx-slow\tDEFERRED\t")
            && has("DCHECK_WARN\tbudget-above-node-cap\tid=fx-slow\tbudget=70\n") && has("\nDCHECK\ttotal=3\tpass=1\tfail=1\tdeferred=1\tnot_run=0\twall_ms=") && rc == 1 && num("DCHECK_FLOW\tpeak=") > 1 && !has("DCHECK_MANIFEST"), "from-runs-manifest-batches-without-selection");
        a[0] = "--from"; a[1] = m2; a[2] = 0;
        rc = dcheck("4000", a);
        ck(rc == 3 && has("CHECK\tfx-pass\tPASS\t") && has("CHECK\tfx-daily\tNOT_RUN\t0\tfirst=not selected") && !has("fx-fail") && has("DCHECK\ttotal=2\tpass=1\tfail=0\tdeferred=0\tnot_run=1\t"), "from-reports-extra-as-not-run");
        (void)put("m3.tsv", "DCHECK_MANIFEST\t1\nTIER\tdaily\nCHANGED\t0\nBATCH\tfx-daily\t-1\t0\nEND\tbatches=1\textra=0\n");
        a[0] = "--from"; a[1] = m3; a[2] = 0;
        rc = dcheck("4000", a);
        ck(rc == 0 && has("DCHECK_SELECT\tchanged=0\tbatches=1\ttier=daily\t") && has("CHECK\tfx-daily\tPASS\t") && !has("fx-pass") && has("DCHECK\ttotal=1\tpass=1\t"), "from-only-listed-batches-no-path-no-git");
        {   /* damaged manifests: each is rc 2 and runs nothing; the id with shell syntax never reaches a command */
            static const char *dm[][2] = {
                {"bad-trunc", "DCHECK_MANIFEST\t1\nTIER\tcommit\nCHANGED\t1\nBATCH\tfx-pass\t55\t0\n"},
                {"bad-header", "DCHECK_MANIFEST\t2\nTIER\tcommit\nCHANGED\t1\nBATCH\tfx-pass\t55\t0\nEND\tbatches=1\textra=0\n"},
                {"bad-count", "DCHECK_MANIFEST\t1\nTIER\tcommit\nCHANGED\t1\nBATCH\tfx-pass\t55\t0\nEND\tbatches=2\textra=0\n"},
                {"bad-id", "DCHECK_MANIFEST\t1\nTIER\tcommit\nCHANGED\t1\nBATCH\tfx-pass';touch\t55\t0\nEND\tbatches=1\textra=0\n"},
                {"bad-dup", "DCHECK_MANIFEST\t1\nTIER\tcommit\nCHANGED\t1\nBATCH\tfx-pass\t55\t0\nBATCH\tfx-pass\t55\t0\nEND\tbatches=2\textra=0\n"},
                {"bad-tier", "DCHECK_MANIFEST\t1\nTIER\tweekly\nCHANGED\t1\nBATCH\tfx-pass\t55\t0\nEND\tbatches=1\textra=0\n"},
                {"bad-field", "DCHECK_MANIFEST\t1\nTIER\tcommit\nCHANGED\t1\nBATCH\tfx-pass\tx\t0\nEND\tbatches=1\textra=0\n"},
                {"bad-after-end", "DCHECK_MANIFEST\t1\nTIER\tcommit\nCHANGED\t1\nEND\tbatches=0\textra=0\nBATCH\tfx-pass\t55\t0\n"},
                {"bad-empty", ""},
                {0, 0}};
            int allbad = 1;
            for (int i = 0; dm[i][0]; i++) {
                char nm[64]; (void)cx_fmt(nm, sizeof nm, "%s.tsv", dm[i][0]); (void)put(nm, dm[i][1]); (void)cx_fmt(bad1, sizeof bad1, "%s/%s", fx, nm);
                a[0] = "--from"; a[1] = bad1; a[2] = 0;
                rc = dcheck("4000", a);
                if (rc != 2 || has("\nCHECK\t") || has("DCHECK\ttotal=")) { allbad = 0; printf("INFO\tnot refused: %s rc=%d\n", dm[i][0], rc); }
            }
            ck(allbad, "from-damaged-manifest-refused-rc2-runs-nothing");
            (void)cx_fmt(bad1, sizeof bad1, "%s/nosuch.tsv", fx); a[0] = "--from"; a[1] = bad1; a[2] = 0; rc = dcheck("4000", a);
            ck(rc == 2 && !has("\nCHECK\t"), "from-missing-file-rc2");
        }
        {   char *e1[] = {"--select-only", "tools/fxsrc.cx", 0}, *e2[] = {"--out", m1, "tools/fxsrc.cx", 0}, *e3[] = {"--from", m1, "tools/fxsrc.cx", 0}, *e4[] = {"--from", m1, "--only", "fx-pass", 0}, *e5[] = {"--from", m1, "--tier", "daily", 0}, *e6[] = {"--from", m1, "--select-only", "--out", m2, 0};
            int r1 = dcheck("4000", e1), r2 = dcheck("4000", e2), r3 = dcheck("4000", e3), r4 = dcheck("4000", e4), r5 = dcheck("4000", e5), r6 = dcheck("4000", e6);
            ck(r1 == 2 && r2 == 2 && r3 == 2 && r4 == 2 && r5 == 2 && r6 == 2, "select-only-out-from-option-conflicts-rc2");
        }
        {   /* the two jobs composed as devsvc background jobs: select-only --bg, then --from --bg */
            char id1[128] = "", id2[128] = ""; const char *q; char *w[] = {"sh", "./unisacc.com", "tools/devsvc.cx", "--", "wait", id1, "--timeout-ms", "30000", 0};
            char mb2[2400]; (void)cx_fmt(mb2, sizeof mb2, "%s/mbg.tsv", fx);
            a[0] = "--bg"; a[1] = "--select-only"; a[2] = "--out"; a[3] = mb2; a[4] = "--only"; a[5] = "fx-pass"; a[6] = "tools/fxsrc.cx"; a[7] = 0;
            rc = dcheck("4000", a); q = strstr(out, "JOB\t");
            if (q) { long k = 0; q += 4; while (q[k] && q[k] != '\t' && q[k] != '\n' && k < (long)sizeof id1 - 1) { id1[k] = q[k]; k++; } id1[k] = 0; }
            if (rc == 0 && id1[0]) { rc = wait_job(w, id1); ck(rc == 0 && has("DCHECK_MANIFEST\tfile=") && has("JOB_DONE\t") && sy_is_reg(mb2) == 1, "bg-select-only-writes-manifest"); } else ck(0, "bg-select-only-writes-manifest");
            a[0] = "--bg"; a[1] = "--from"; a[2] = mb2; a[3] = "--par"; a[4] = "2"; a[5] = 0;
            rc = dcheck("4000", a); q = strstr(out, "JOB\t");
            if (q) { long k = 0; q += 4; while (q[k] && q[k] != '\t' && q[k] != '\n' && k < (long)sizeof id2 - 1) { id2[k] = q[k]; k++; } id2[k] = 0; }
            if (rc == 0 && id2[0]) { char *w2[] = {"sh", "./unisacc.com", "tools/devsvc.cx", "--", "wait", id2, "--timeout-ms", "30000", 0}; rc = wait_job(w2, id2); ck(rc == 0 && has("CHECK\tfx-pass\tPASS\t") && has("DCHECK\ttotal=1\tpass=1\t"), "bg-from-runs-manifest-batches"); } else ck(0, "bg-from-runs-manifest-batches");
        }
