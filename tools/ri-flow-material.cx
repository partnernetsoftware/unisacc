/* Bounded split profile over separately prepared generic source material.
 * compile ROOT MAT | seal ROOT MAT | --verify-native ROOT MAT
 * compile emits COMPILED pending material only. Only seal emits PREPARED. */
#pragma unisa use cxlib.riflowmaterial
int main(int argc,char **argv){
#if !defined(__linux__) || !defined(__x86_64__)
 fputs("NOT_RUN ri-flow-material requires Linux/x86_64\n",stderr);return 3;
#endif
 if(argc!=4||(strcmp(argv[1],"compile")&&strcmp(argv[1],"seal")&&strcmp(argv[1],"--verify-native"))){fputs("usage compile ROOT MAT | seal ROOT MAT | --verify-native ROOT MAT\n",stderr);return 2;}
 char h[65];size_t n;int compile=!strcmp(argv[1],"compile"),seal=!strcmp(argv[1],"seal");int rc=compile?rfm_compile(argv[2],argv[3],h,&n):seal?rfm_seal(argv[2],argv[3],h,&n):rfm_verify_native(argv[2],argv[3],h,&n);if(rc)return 2;
 printf("%s\tri-flow-native\tartifact=%s\tbytes=%lu\tflags=%s\t%sno-test-result\n",compile?"COMPILED":seal?"PREPARED":"VERIFIED",h,(unsigned long)n,rfm_flags(),compile?"pending-only\t":"");return 0;
}
