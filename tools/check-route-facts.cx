/* tools/check-route-facts.cx -- check of tools/route-facts.cx and its two tables.
 *
 *   sh ./unisacc.com tools/check-route-facts.cx
 *
 * Runs, each as a bounded child of ./unisacc.com:
 *   1 draft --check            the draft file equals the generator output
 *   2 baseline --check         the product is run again on all 108 keys and equals the baseline file
 *   3 compare draft baseline   every shared column of every key agrees (mismatch=0)
 *   4 mutation: one cont cell of a private draft copy changed (prune -> e4 at key 0 0 lnx/x86_64);
 *     compare must exit 1 with exactly one mismatch naming that key and column
 *   5 mutation: one stages cell changed (tapecheck -> tapechekc at key 2 0 lnx/x86_64); same demand
 *   6 mutation: one data row removed; compare must refuse the shape with exit 2
 * Last line on success: ROUTE_FACTS_CHECK_PASS.  Private copies go to $TMPDIR or /tmp. */
#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use text.text
#pragma unisa use cxlib.netpack

#define DRAFT "build/route-facts.draft.tsv"
#define BASE "build/route-baseline.tsv"
#define CAP 65536

static char prod[4200], work[4096], tool[4200], dbuf[CAP], mbuf[CAP];
static long dlen;
static int nfail, npass;

static void note(int ok, const char *tag, const char *det) {
    printf("%s\t%s\t%s\n", ok ? "ok" : "FAIL", tag, det);
    if (ok) npass++; else nfail++;
}

static int run_tool(const char *a1, const char *a2, const char *a3, np_result *r) {
    char *av[10];
    char why[512];
    int k = 0;
    av[k++] = tool;
    av[k++] = (char *)a1;
    if (a2) av[k++] = (char *)a2;
    if (a3) av[k++] = (char *)a3;
    av[k] = 0;
    if (np_run(av, 0, 0, 50, r, why, sizeof why)) {
        fprintf(stderr, "check-route-facts: spawn: %s\n", why);
        return 1;
    }
    return 0;
}

static int has(const np_result *r, const char *want) {
    size_t n = strlen(want), i;
    if (!r->out) return 0;
    for (i = 0; i + n <= r->outn; i++) if (!memcmp(r->out + i, want, n)) return 1;
    return 0;
}

static void expect_rc0(const char *tag, const char *a1, const char *a2, const char *a3, const char *marker) {
    np_result r = {0};
    char det[160];
    int t = run_tool(a1, a2, a3, &r);
    int ok = !t && r.rc == 0 && has(&r, marker);
    cx_fmt(det, sizeof det, "rc=%d marker=%s", r.rc, marker);
    note(ok, tag, det);
    if (!ok && r.err) fprintf(stderr, "%.*s", (int)r.errn, r.err);
    np_free(&r);
}

/* Replace the first occurrence of old in the draft bytes; write the result to path. */
static int mutate(const char *path, const char *old, const char *neu) {
    long on = (long)strlen(old), nn = (long)strlen(neu), i, at = -1, n = 0;
    FILE *f;
    for (i = 0; i + on <= dlen; i++) if (!memcmp(dbuf + i, old, (size_t)on)) { at = i; break; }
    if (at < 0 || dlen - on + nn >= CAP) return 1;
    for (i = 0; i < at; i++) mbuf[n++] = dbuf[i];
    for (i = 0; i < nn; i++) mbuf[n++] = neu[i];
    for (i = at + on; i < dlen; i++) mbuf[n++] = dbuf[i];
    f = fopen(path, "wb");
    if (!f) return 1;
    if ((long)fwrite(mbuf, 1, (size_t)n, f) != n) { fclose(f); return 1; }
    return fclose(f) ? 1 : 0;
}

static void expect_red(const char *tag, const char *old, const char *neu, int want_rc, const char *want1, const char *want2) {
    char path[4200], det[200];
    np_result r = {0};
    int ok;
    if (cx_fmt(path, sizeof path, "%s/%s.tsv", work, tag) || mutate(path, old, neu)) { note(0, tag, "cannot build the mutant"); return; }
    int rc = run_tool("--compare", path, BASE, &r);
    (void)sy_unlink(path);
    if (rc) { note(0, tag, "spawn"); return; }
    ok = r.rc == want_rc && (!want1 || has(&r, want1)) && (!want2 || has(&r, want2));
    cx_fmt(det, sizeof det, "rc=%d want=%d", r.rc, want_rc);
    note(ok, tag, det);
    if (!ok) fprintf(stderr, "out=[%.*s] err=[%.*s]\n", (int)r.outn, r.out ? r.out : "", (int)r.errn, r.err ? r.err : "");
    np_free(&r);
}

int main(void) {
    const char *td = getenv("TMPDIR");
    FILE *f;
    if (!td || !td[0]) td = "/tmp";
    if (sy_realpath("./unisacc.com", prod, sizeof prod) < 0) { fprintf(stderr, "check-route-facts: no ./unisacc.com here\n"); return 2; }
    if (cx_fmt(work, sizeof work, "%s/check-route-facts-%d", td, (int)getpid()) || sy_mkdir_all(work, 0700)) { fprintf(stderr, "check-route-facts: work dir\n"); return 2; }
    if (cx_fmt(tool, sizeof tool, "%s/route-facts", work)) return 2;
    char *build[] = {"sh", prod, "tools/route-facts.cx", "-o", tool, 0};
    char why[512];
    np_result prepared = {0};
    int prep_rc = np_run(build, 0, 0, 25, &prepared, why, sizeof why);
    if (prep_rc || prepared.rc) {
        fprintf(stderr, "check-route-facts: prepare rc=%d %s\n", prepared.rc, prep_rc ? why : "");
        if (prepared.err) fprintf(stderr, "%.*s", (int)prepared.errn, prepared.err);
        np_free(&prepared);
        return 2;
    }
    np_free(&prepared);
    f = fopen(DRAFT, "rb");
    if (!f) { fprintf(stderr, "check-route-facts: no %s\n", DRAFT); return 2; }
    dlen = (long)fread(dbuf, 1, CAP - 1, f);
    fclose(f);

    expect_rc0("draft-check", "--check", 0, 0, "ROUTE_DRAFT_CHECK");
    expect_rc0("baseline-check", "--baseline", "--check", 0, "ROUTE_BASELINE_CHECK");
    expect_rc0("compare", "--compare", DRAFT, BASE, "ROUTE_COMPARE\tcells=108\tcols=3\tmismatch=0");
    expect_red("mutant-cont",
               "0\t0\tlnx/x86_64\timage\tlnx/x86_64/image/O0\telf\te2,e1,e3,prune,lower,elf\tprune\t0\n",
               "0\t0\tlnx/x86_64\timage\tlnx/x86_64/image/O0\telf\te2,e1,e3,prune,lower,elf\te4\t0\n",
               1, "ROUTE_MISMATCH\t0\t0\tlnx/x86_64\tcont\te4\tprune\n", "\tmismatch=1\n");
    expect_red("mutant-stages",
               "2\t0\tlnx/x86_64\ttape\tlnx/x86_64/tape/O0\ttapecheck\te2,e1,e3,tapecheck\t",
               "2\t0\tlnx/x86_64\ttape\tlnx/x86_64/tape/O0\ttapecheck\te2,e1,e3,tapechekc\t",
               1, "ROUTE_MISMATCH\t2\t0\tlnx/x86_64\tstages\te2,e1,e3,tapechekc\te2,e1,e3,tapecheck\n", "\tmismatch=1\n");
    expect_red("mutant-row",
               "5\t2\twin/arm64\tobject\twin/arm64/object/O2\tobject\te2,e1,e3,tapecheck,e4,prune,lower,elf\te4\t0\n",
               "", 2, 0, 0);
    (void)sy_unlink(tool);
    (void)sy_rmdir(work);
    printf("ROUTE_FACTS_CHECK\tpass=%d\tfail=%d\n", npass, nfail);
    if (nfail) return 1;
    printf("ROUTE_FACTS_CHECK_PASS\n");
    return 0;
}
