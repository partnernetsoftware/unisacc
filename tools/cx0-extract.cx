/* CX-owned parser -> classic C compatibility projection. plan.cx is the actual
 * complete module and the single maintained parser. The fixed prefix contains
 * only the legacy explanation, include and driver callback declarations.
 * sh ./unisacc.com tools/cx0-extract.cx -- [--check] [--output FILE] [--source CX]
 * Default target src/cxmod.c remains a live product/reference/host-tool input.
 * --check never writes; unchanged generation preserves the existing file. */
static void bad(const char *why){fprintf(stderr,"cx0-extract: %s errno=%d\n",why,errno);exit(2);}
static char *read_regular(const char *path,size_t *n,int absent){
 int fd=open(path,O_RDONLY|O_NONBLOCK|O_NOFOLLOW);if(fd<0){if(absent&&errno==ENOENT)return 0;bad("input-open");}struct stat a,b;
 if(fstat(fd,&a)||!S_ISREG(a.st_mode)||a.st_size<0||a.st_size>8388608){close(fd);bad("bounded-regular-input");}
 *n=(size_t)a.st_size;char *p=malloc(*n+1);if(!p){close(fd);bad("allocation");}size_t at=0;
 while(at<*n){ssize_t z=read(fd,p+at,*n-at);if(z<0&&errno==EINTR)continue;if(z<=0){close(fd);free(p);bad("input-read");}at+=(size_t)z;}
 char tail;ssize_t z;do{z=read(fd,&tail,1);}while(z<0&&errno==EINTR);int invalid=z||fstat(fd,&b)||a.st_size!=b.st_size;if(close(fd))invalid=1;
 if(invalid||memchr(p,0,*n)){free(p);bad("input-changed-close-or-NUL");}p[*n]=0;return p;
}
static char *private_body(const char *source){
 const char *begin="/* CX0_COMPAT_BODY_BEGIN */\n",*end="/* CX0_COMPAT_BODY_END */\n";
 if(strncmp(source,"#pragma unisa module plan\n",26))bad("complete-CX-module-required");
 const char *a=strstr(source,begin),*b=strstr(source,end);if(!a||!b||strstr(a+1,begin)||strstr(b+1,end)||b<=a||a==source||a[-1]!='\n'||b[-1]!='\n')bad("unique-ordered-body-markers-required");
 if(!strstr(b,"cx0_result cx0_plan(")||!strstr(b,"cx0_result cx0_capture_plan("))bad("complete-CX-module-API-required");
 a+=strlen(begin);size_t n=(size_t)(b-a);/* Two separator newlines belong to the module adapter. */
 if(n<3||(memcmp(a,"#define CXM_MAXU ",17)&&memcmp(a,"/* CX0_HOST_BEGIN head */\n",26))||a[n-1]!='\n'||a[n-2]!='\n'||a[n-3]!='\n')bad("private-body-boundaries");n-=2;
 char *body=malloc(n+1);if(!body)bad("allocation");{ void *cx_kept = memcpy(body,a,n); (void)cx_kept; }body[n]=0;return body;
}
static int is_function_head(const char *p){ /* p at "cxm_..." after the type: identifier then '(' means a function definition */
 while(*p&&(isalnum((unsigned char)*p)||*p=='_'))p++;return *p=='(';
}
static char *classic_visibility(char *body,int functions_only){
 size_t n=strlen(body),at=0;char *out=malloc(n+1);if(!out)bad("allocation");const char *p=body;int depth=0,comment=0,quote=0,escape=0,removed=0;
 while(*p){
  if(!depth&&!comment&&!quote&&!strncmp(p,"static ",7)&&(!strncmp(p+7,"int cxm_",8)||!strncmp(p+7,"char cxm_",9)||!strncmp(p+7,"char *cxm_",10))&&(!functions_only||is_function_head(p+7+(p[7]=='i'?4:p[12]=='*'?6:5)))){p+=7;removed++;}
  char c=*p;out[at++]=c;
  if(comment){if(c=='*'&&p[1]=='/'){out[at++]=*++p;comment=0;}}
  else if(quote){if(escape)escape=0;else if(c=='\\')escape=1;else if(c==quote)quote=0;}
  else if(c=='/'&&p[1]=='*'){out[at++]=*++p;comment=1;}
  else if(c=='/'&&p[1]=='/'){while(p[1]&&p[1]!='\n')out[at++]=*++p;}
  else if(c=='"'||c=='\'')quote=c;else if(c=='{')depth++;else if(c=='}'){if(!depth)bad("unbalanced-private-body");depth--;}
  p++;
 }out[at]=0;free(body);if(depth||comment||quote||!removed)bad("unbalanced-or-nonprivate-parser");return out;
}
static void publish(const char *path,const char *bytes,size_t n){
 char temporary[4400];int z=snprintf(temporary,sizeof temporary,"%s.XXXXXX",path);if(z<0||(size_t)z>=sizeof temporary)bad("output-path-bound");
 int fd=mkstemp(temporary);if(fd<0)bad("output-temporary-create");int failed=fchmod(fd,0644);size_t at=0;
 while(!failed&&at<n){ssize_t w=write(fd,bytes+at,n-at);if(w<0&&errno==EINTR)continue;if(w<=0){failed=1;break;}at+=(size_t)w;}
 if(fsync(fd))failed=1;if(close(fd))failed=1;if(!failed&&rename(temporary,path))failed=1;
 if(failed){int e=errno;if(unlink(temporary)&&errno!=ENOENT)bad("output-failed-cleanup");errno=e;bad("output-write-close-or-publish");}
}
static void cpyn(char *d,const char *s,size_t n){size_t i;for(i=0;i<n;i++)d[i]=s[i];}
static char *join3(const char *a,size_t an,const char *b,size_t bn,const char *c,size_t cn){
 if(an>8388608||bn>8388608||cn>8388608||an+bn+cn>8388608)bad("projection-bound");
 char *r=malloc(an+bn+cn+1);if(!r)bad("allocation");
 cpyn(r,a,an);cpyn(r+an,b,bn);cpyn(r+an+bn,c,cn);r[an+bn+cn]=0;return r;
}
static void bad_zone(const char *why,const char *name){
 char m[160];int z=snprintf(m,sizeof m,"%s zone=%s",why,name);if(z<0||(size_t)z>=sizeof m)bad("zone-message-bound");bad(m);
}
/* projection.tsv: zone TAB c-fragment TAB cx-fragment; fragment "-" is empty; zone "@tail" is appended after the body. */
static char *fragment(const char *dir,const char *file,const char *zone){
 if(!strcmp(file,"-")){char *e=malloc(1);if(!e)bad("allocation");e[0]=0;return e;}
 char path[600];int z=snprintf(path,sizeof path,"%s/%s",dir,file);if(z<0||(size_t)z>=sizeof path)bad_zone("fragment-path-bound",zone);
 size_t n;return read_regular(path,&n,0);
}
static int zone_row(const char *tsv,const char *zone,char *cf,char *xf){
 const char *p=tsv;size_t zl=strlen(zone);int first=1;
 while(*p){const char *e=strchr(p,'\n');if(!e)e=p+strlen(p);
  if(!first&&(size_t)(e-p)>zl&&!strncmp(p,zone,zl)&&p[zl]=='\t'){const char *a=p+zl+1,*t=memchr(a,'\t',(size_t)(e-a));if(!t||(size_t)(t-a)>=128||(size_t)(e-t-1)>=128)bad_zone("projection-row-shape",zone);
   cpyn(cf,a,(size_t)(t-a));cf[t-a]=0;cpyn(xf,t+1,(size_t)(e-t-1));xf[e-t-1]=0;return 1;}
  first=0;p=*e?e+1:e;}
 return 0;
}
/* Replace each CX0_HOST_BEGIN/END pair (whole marker lines, markers included) by the target's fragment. */
static char *host_zones(char *body,const char *tsv,const char *dir,int cx){
 const char *B="/* CX0_HOST_BEGIN ",*E="/* CX0_HOST_END ";char seen[32][64];int nseen=0;size_t bl=strlen(B),el=strlen(E);
 for(;;){
  char *a=strstr(body,B);char *oe=strstr(body,E);
  if(!a){if(oe)bad("host-zone-end-without-begin");break;}
  if(oe&&oe<a)bad("host-zone-end-before-begin");
  if(a!=body&&a[-1]!='\n')bad("host-zone-begin-not-at-line-start");
  char *q=a+bl;char name[64];size_t nl=0;while(q[nl]&&q[nl]!=' '&&q[nl]!='\n'&&nl<63){name[nl]=q[nl];nl++;}name[nl]=0;
  if(!nl||strncmp(q+nl," */\n",4))bad("host-zone-begin-malformed");
  for(int i=0;i<nseen;i++)if(!strcmp(seen[i],name))bad_zone("host-zone-duplicate",name);
  if(nseen>=32)bad("host-zone-too-many");cpyn(seen[nseen++],name,nl+1);
  char *content=q+nl+4;char want[160];int wz=snprintf(want,sizeof want,"%s%s */\n",E,name);if(wz<0||(size_t)wz>=sizeof want)bad_zone("zone-name-bound",name);
  char *e=strstr(content,want);if(!e)bad_zone("host-zone-unclosed",name);
  char *nb=strstr(content,B);if(nb&&nb<e)bad_zone("host-zone-nested",name);
  if(e[-1]!='\n'&&e!=content)bad_zone("host-zone-end-not-at-line-start",name);
  char cf[128],xf[128];if(!zone_row(tsv,name,cf,xf))bad_zone("host-zone-not-in-projection",name);
  char *fr=fragment(dir,cx?xf:cf,name);
  char *r=join3(body,(size_t)(a-body),fr,strlen(fr),e+strlen(want),strlen(e+strlen(want)));free(fr);free(body);body=r;(void)el;
 }
 /* every table zone must exist in the body, except @tail */
 const char *p=tsv;int first=1;
 while(*p){const char *e=strchr(p,'\n');if(!e)e=p+strlen(p);
  if(!first&&e>p&&*p!='@'){char zn[64];size_t l=0;while(p+l<e&&p[l]!='\t'&&l<63){zn[l]=p[l];l++;}zn[l]=0;int ok=0;for(int i=0;i<nseen;i++)if(!strcmp(seen[i],zn))ok=1;if(!ok)bad_zone("projection-zone-missing-in-plan",zn);}
  first=0;p=*e?e+1:e;}
 return body;
}
/* One target: tgt 0 = classic C (src/cxmod.c), 1 = product CX (cx/compiler/cxmod.cx). Prints one CX0_EXTRACT line. */
static void project(int tgt,int check,const char *output,const char *source,const char *prefix,const char *tsv_path,const char *dir){
 struct stat a,b,c;int have_output=!lstat(output,&a);if(!have_output&&errno!=ENOENT)bad("output-stat");if(have_output&&(!S_ISREG(a.st_mode)||stat(source,&b)||stat(prefix,&c)||(a.st_dev==b.st_dev&&a.st_ino==b.st_ino)||(a.st_dev==c.st_dev&&a.st_ino==c.st_ino)))bad("regular-output-must-not-alias-source-or-prefix");
 size_t sn,pn=0,tn;char *src=read_regular(source,&sn,0),*pre=tgt?0:read_regular(prefix,&pn,0),*body=private_body(src);free(src);
 char *tsv=read_regular(tsv_path,&tn,0);
 body=classic_visibility(body,tgt);body=host_zones(body,tsv,dir,tgt);
 char *tail=0;size_t tl=0;
 if(tgt){char cf[128],xf[128];if(!zone_row(tsv,"@tail",cf,xf))bad_zone("projection-row-missing","@tail");tail=fragment(dir,xf,"@tail");tl=strlen(tail);}
 free(tsv);
 size_t bn=strlen(body);if(pn>8388608-bn||tl>8388608-bn-pn)bad("projection-bound");size_t n=pn+bn+tl;char *result=join3(pre?pre:"",pn,body,bn,tail?tail:"",tl);free(pre);free(body);free(tail);
 size_t oldn=0;char *old=read_regular(output,&oldn,1);int exact=old&&oldn==n&&!memcmp(old,result,n);free(old);
 if(check&&!exact){free(result);bad("generated-projection-differs");}if(!check&&!exact)publish(output,result,n);
 char hash[65];cx_sha256_hex(result,n,hash);free(result);printf("CX0_EXTRACT\t%s\tbytes=%zu\tsha256=%s\toutput=%s\tauthority=%s\n",check?"EXACT":exact?"UNCHANGED":"PREPARED",n,hash,output,source);
}
int main(int argc,char **argv){
 int check=0,all=0;const char *output="src/cxmod.c",*source="cx/cx0/plan.cx",*prefix="cx/cx0/compat-prefix.c.in";int out_given=0,source_given=0;
 for(int i=1;i<argc;i++){if(!strcmp(argv[i],"--check")&&!check)check=1;else if(!strcmp(argv[i],"--all")&&!all)all=1;else if(!strcmp(argv[i],"--output")&&!out_given&&i+1<argc){output=argv[++i];out_given=1;}else if(!strcmp(argv[i],"--source")&&!source_given&&i+1<argc){source=argv[++i];source_given=1;}else bad("usage-[--check]-[--all]-[--output-FILE]-[--source-CX]");}
 if(all&&out_given)bad("--all-excludes---output");
 project(0,check,output,source,prefix,"cx/cx0/projection.tsv","cx/cx0/proj");
 if(all)project(1,check,"cx/compiler/cxmod.cx",source,prefix,"cx/cx0/projection.tsv","cx/cx0/proj");
 return 0;
}
