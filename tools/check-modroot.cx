/* tools/check-modroot.cx -- C2-p1: KIND:PATH parse; missing/bad kind/relative refuse. */
#pragma unisa use cxlib.modroot
#pragma unisa use text.text

static int failed;
static void ck(int ok, const char *n) {
    printf("%s\tcheck-modroot.%s\n", ok ? "PASS" : "FAIL", n);
    if (!ok) failed++;
}
int main(void) {
    int k;
    char p[200];
    ck(mr_parse(0, &k, p, 200) != 0 && k == MR_BAD, "missing-spec-refuse");
    ck(mr_parse("", &k, p, 200) != 0, "empty-spec-refuse");
    ck(mr_parse("bogus:/tmp/x", &k, p, 200) != 0 && k == MR_BAD, "bad-kind-refuse");
    ck(mr_parse("git:rel", &k, p, 200) != 0, "relative-path-refuse");
    ck(mr_parse("git:", &k, p, 200) != 0, "empty-path-refuse");
    ck(mr_parse("git:/tmp/tree", &k, p, 200) == 0 && k == MR_GIT && tx_eqz(p, "/tmp/tree"), "git-ok");
    ck(mr_parse("snapshot:/snap", &k, p, 200) == 0 && k == MR_SNAP, "snapshot-ok");
    ck(mr_parse("installed:/opt/unisacc", &k, p, 200) == 0 && k == MR_INST, "installed-ok");
    printf("CHECK_MODROOT\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
