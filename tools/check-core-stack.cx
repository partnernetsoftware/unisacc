#pragma unisa use core.stack
void core_host_panic(const char *s){fprintf(stderr,"unexpected panic: %s\n",s);exit(2);}
int main(void){
 int failed=0;CxCoreStack s={0};for(int i=0;i<1025;i++)core_stack_push(&s,i);
 if(s.n!=1025||s.cap!=2048||s.entries[0]!=0||s.entries[1024]!=1024)failed++;
 core_stack_pop(&s);if(s.n!=1024||s.entries[1023]!=1023)failed++;
 unsigned char bytes[]={1,2};int64_t attr[]={3,4};CxCoreFrame v={bytes,attr,0,2};CxCoreFrames f={0};
 for(int i=0;i<17;i++)core_frame_push(&f,&v);if(f.n!=17||f.cap!=32||f.entries[16].b!=bytes||f.entries[16].at!=attr)failed++;
 for(int i=0;i<20;i++)core_frame_pop(&f);if(f.n!=1)failed++;
 free(s.entries);free(f.entries);printf("CXCORE_STACK failed=%d\n",failed);return failed?1:0;
}
