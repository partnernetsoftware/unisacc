#!/bin/sh
# tools/cx-dev -- thin entry of the cx-dev lane (NOT_RELEASE).  It only execs the constructed loader; it never runs
# the installed product.  Construct the loader bundle once (and after tools/cx-dev.cx or the installed product
# changes):  sh ./unisacc.com tools/cx-dev.cx -- --build
d=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd) || exit 2
b="${CXDEV_HOME:-${TMPDIR:-/tmp}/cx-dev-$(id -u)/wt$d}/cx-dev"
if [ ! -x "$b" ] || [ ! "$b" -nt "$d/tools/cx-dev.cx" ] || [ ! "$b" -nt "$d/unisacc.com" ]; then
  echo "cx-dev: REFUSE loader missing or older than tools/cx-dev.cx or the installed product; construct it: sh ./unisacc.com tools/cx-dev.cx -- --build" >&2; exit 2
fi
exec "$b" "$@"
