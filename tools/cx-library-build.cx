/* Linux x86_64 host library builder. First version only.
 * PACKAGE OUTPUT CC AR [LDFLAG...]
 * PACKAGE, OUTPUT, CC and AR are absolute paths. OUTPUT must not exist
 * and must lie under /tmp, $TMPDIR or <repo>/out so failure can delete
 * that new tree. Default link flags are -lffi -ldl. No FFI probe.
 * The receipt is manifest.txt. A failed build removes OUTPUT.
 * The library TU links the CX model number reader as a separate unit.
 */
#pragma unisa use sys.process
#pragma unisa use runtime.packagestruct
#pragma unisa use runtime.packagefooter
#pragma unisa use text.text
#define NFILE 256
static char root[4096], outdir[4096], boundp[4400], ccpath[4096], arpath[4096];
static char relv[NFILE][240];
static char shav[NFILE][65];
static int nrel, created;
static FILE *man;
static void fail(const char *s) {
    if (created && cx_rmtree(outdir)) fprintf(stderr, "cx-library-build: cleanup-failed\n");
    fprintf(stderr, "cx-library-build: %s\n", s);
    exit(2);
}
static int bad_token(const char *s) {
    if (!s || !s[0]) return 1;
    for (const char *p = s; *p; p++) if (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') return 1;
    return 0;
}
static void hash_file(const char *p, char h[65]) {
    size_t n; char *s = cx_read(p, &n);
    if (!s) fail("read-input");
    cx_sha256_hex(s, n, h);
    free(s);
}
/* Audit package framing, not compressed model contents or authentication. */
static int package_structure(const char *path) {
    size_t n; char *bytes=cx_read(path,&n); int version=0, rc;
    if (!bytes) fail("read-package");
    if (n > 2147483647UL) { free(bytes); fail("package-too-large"); }
    const unsigned char *data=(const unsigned char *)bytes; long length=(long)n;
    if (n < 2 || bytes[0] != 'P' || bytes[1] != ' ') {
        PackageFooter footer;
        if (!packagefooter_locate_bytes(data,length,&footer)) { free(bytes); fail("package-footer"); }
        data+=(long)footer.package_offset; length=(long)footer.package_length;
    }
    rc=cxps_audit(data,length,&version); free(bytes);
    if(rc) fail("package-structure");
    return version;
}
static void package_payload(const char *pkg, const char *helper, const char *product) {
    char *av[]={boundp,"40","sh",(char *)product,(char *)helper,"--",(char *)pkg,0};
    char why[1024]; np_result r={0};
    if(np_run(av,root,0,45,&r,why,sizeof why)) fail(why);
    if(r.rc || r.errn || !r.out || strncmp(r.out,"CXPAYLOAD_AUDIT\tP3\t",19)) {
        if(r.errn) fwrite(r.err,1,r.errn,stderr);
        np_free(&r); fail("package-model-payload");
    }
    np_free(&r);
}
static int below(const char *path, const char *base) {
    size_t n;
    if (!base || !base[0]) return 0;
    n = strlen(base);
    return strlen(path) > n && !strncmp(path, base, n) && path[n] == '/';
}
static int normalize(const char *in, char *out, size_t cap) {
    const char *comp[64], *p = in; size_t len[64], n = 0; int k = 0;
    while (*p) {
        while (*p == '/') p++;
        if (!*p) break;
        const char *q = p; while (*q && *q != '/') q++;
        size_t L = (size_t)(q - p);
        if (L == 1 && p[0] == '.') { p = q; continue; }
        if (L == 2 && p[0] == '.' && p[1] == '.') { if (!k) return 1; k--; p = q; continue; }
        if (k == 64) return 1;
        comp[k] = p; len[k] = L; k++; p = q;
    }
    if (!k) return 1;
    for (int i = 0; i < k; i++) {
        if (n && n + 1 >= cap) return 1;
        if (n) out[n++] = '/';
        if (n + len[i] >= cap) return 1;
        { void *cx_kept = memcpy(out + n, comp[i], len[i]); (void)cx_kept; } n += len[i];
    }
    out[n] = 0;
    return 0;
}
static void mkdir_parent(const char *file) {
    char buf[4400]; int n = snprintf(buf, sizeof buf, "%s", file);
    if (n < 0 || (size_t)n >= sizeof buf) fail("path-bound");
    for (char *p = buf + 1; *p; p++) if (*p == '/') {
        *p = 0; if (mkdir(buf, 0700) && errno != EEXIST) fail("mkdir-snapshot"); *p = '/';
    }
}
static int known(const char *r) {
    for (int i = 0; i < nrel; i++) if (tx_eqz(relv[i], r)) return 1;
    return 0;
}
static void add_rel(const char *r);
static void scan_includes(const char *s, size_t n, const char *filerel) {
    size_t i = 0;
    while (i < n) {
        size_t a = i; while (i < n && s[i] != '\n') i++;
        const char *p = s + a, *e = s + i; const char *name; char inc[240], joined[512], norm[240], dir[240];
        while (p < e && (*p == ' ' || *p == '\t')) p++;
        if (p < e && *p == '#') {
            p++; while (p < e && (*p == ' ' || *p == '\t')) p++;
            if ((size_t)(e - p) >= 7 && !memcmp(p, "include", 7)) {
                p += 7; while (p < e && (*p == ' ' || *p == '\t')) p++;
                if (p < e && *p == '"') {
                    p++; name = p; while (p < e && *p != '"') p++;
                    if (p < e && (size_t)(p - name) < sizeof inc) {
                        { void *cx_kept = memcpy(inc, name, (size_t)(p - name)); (void)cx_kept; } inc[p - name] = 0;
                        dir[0] = 0; { const char *sl = strrchr(filerel, '/'); if (sl) { size_t d = (size_t)(sl - filerel); if (d >= sizeof dir) fail("path-bound"); { void *cx_kept = memcpy(dir, filerel, d); (void)cx_kept; } dir[d] = 0; } }
                        if (dir[0]) { int z = snprintf(joined, sizeof joined, "%s/%s", dir, inc); if (z < 0 || (size_t)z >= sizeof joined) fail("path-bound"); }
                        else { int z = snprintf(joined, sizeof joined, "%s", inc); if (z < 0 || (size_t)z >= sizeof joined) fail("path-bound"); }
                        if (normalize(joined, norm, sizeof norm)) fail("include-escapes");
                        add_rel(norm);
                    } else fail("include-path");
                }
            }
        }
        if (i < n) i++;
    }
}
static void add_rel(const char *r) {
    char full[4400], dest[4400]; struct stat st; size_t n; char *s; int z, id;
    if (known(r)) return;
    if (nrel >= NFILE || strlen(r) >= 240) fail("snapshot-too-large");
    z = snprintf(full, sizeof full, "%s/%s", root, r);
    if (z < 0 || (size_t)z >= sizeof full) fail("path-bound");
    if (lstat(full, &st) || !S_ISREG(st.st_mode)) fail("include-missing");
    id = nrel; { if (cx_fmt(relv[id], sizeof relv[id], "%s", r)) fail("snapshot-too-large"); } nrel++;
    s = cx_read(full, &n); if (!s) fail("read-source");
    cx_sha256_hex(s, n, shav[id]);
    z = snprintf(dest, sizeof dest, "%s/work/src/%s", outdir, r);
    if (z < 0 || (size_t)z >= sizeof dest) fail("path-bound");
    mkdir_parent(dest);
    { FILE *f = fopen(dest, "wx"); if (!f || fwrite(s, 1, n, f) != n || fclose(f)) fail("snapshot-write"); }
    if (fprintf(man, "source\t%s\t%s\n", r, shav[id]) < 0) fail("manifest-write");
    scan_includes(s, n, r);
    free(s);
}
static long mono_ms(void) {
#if defined(__UNISA__) && defined(__linux__) && defined(__x86_64__)
    long stamp[2] = { 0, 0 };
    long rc = __syscall6(228, 1, (long)stamp, 0, 0, 0);
    if (rc || stamp[0] < 0 || stamp[1] < 0 || stamp[1] >= 1000000000L) fail("clock");
    return stamp[0] * 1000L + stamp[1] / 1000000L;
#else
    fail("clock");
    return 0;
#endif
}
static void run_step(char **av, char **env, const char *label) {
    np_result r = { 0 }; char why[1024]; long a, b, ms;
    a = mono_ms();
    if (np_run(av, root, env, 55, &r, why, sizeof why)) fail(why);
    b = mono_ms();
    ms = b - a; if (ms < 0) ms = 0;
    if (r.rc) { if (r.errn) fwrite(r.err, 1, r.errn, stderr); np_free(&r); fail(label); }
    np_free(&r);
    if (fprintf(man, "command\t%ld", ms) < 0) fail("manifest-write");
    for (int i = 0; av[i]; i++) if (fprintf(man, "\t%s", av[i]) < 0) fail("manifest-write");
    if (fprintf(man, "\trc=0\n") < 0) fail("manifest-write");
}
static void rehash(const char *pkg, const char *pkgsha, const char *ccsha, const char *arsha, const char *selfsha) {
    char h[65];
    hash_file(pkg, h); if (!tx_eqz(h, pkgsha)) fail("package-changed");
    hash_file(ccpath, h); if (!tx_eqz(h, ccsha)) fail("cc-changed");
    hash_file(arpath, h); if (!tx_eqz(h, arsha)) fail("ar-changed");
    hash_file(__FILE__, h); if (!tx_eqz(h, selfsha)) fail("builder-changed");
    for (int i = 0; i < nrel; i++) {
        char full[4400]; int z = snprintf(full, sizeof full, "%s/%s", root, relv[i]);
        if (z < 0 || (size_t)z >= sizeof full) fail("path-bound");
        hash_file(full, h); if (!tx_eqz(h, shav[i])) fail("source-changed");
    }
}
static void artifact(const char *name, const char *path) {
    struct stat st; char h[65];
    if (lstat(path, &st) || !S_ISREG(st.st_mode)) fail("artifact-missing");
    hash_file(path, h);
    if (fprintf(man, "artifact\t%s\t%ld\t%s\n", name, (long)st.st_size, h) < 0) fail("manifest-write");
}
static int allowed(const char *full) {
    char tmp[4096], repoout[4400], envroot[4096]; const char *t = getenv("TMPDIR");
    if (!realpath("/tmp", tmp)) fail("temp-root");
    if (below(full, tmp)) return 1;
    if (t && t[0] == '/' && realpath(t, envroot) && below(full, envroot)) return 1;
    { int z = snprintf(repoout, sizeof repoout, "%s/out", root); if (z < 0 || (size_t)z >= sizeof repoout) fail("path-bound"); }
    if (realpath(repoout, envroot) && below(full, envroot)) return 1;
    return 0;
}
