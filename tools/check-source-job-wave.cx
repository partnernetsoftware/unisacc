/* private check: source-job-wave missing root and bad verb.
 * Does not call the tool with no args: that path does not return inside 45s.
 */
#pragma unisa use cxlib.ckrun
#pragma unisa use cxlib.procrun
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.bytes
static int failed; static char prod[64];
static void ck(int ok, const char *n) { printf("%s\tcheck-source-job-wave.%s\n", ok ? "PASS" : "FAIL", n); if (!ok) failed++; }
static int run(char **av, int *rc, char *err, long *en) { pr_result r; int t = pr_run("sjw", av, ".", 0, 20, &r); *rc = t ? -1 : r.rc; *en = 0; if (r.err && r.errn < 4000) { mm_copy(err, 4000, r.err, (long)r.errn); err[r.errn] = 0; *en = (long)r.errn; } pr_free(&r); return t; }
int main(int argc, char **argv) {
    char err[4000], root[4400], a[4400], b[4400], c[4400]; long en = 0; int rc = 0;
    if (argc >= 3 && tx_eq(argv[1], "--mutant", 16)) return ((tx_eqz(argv[2], "accept-bad-verb") || tx_eqz(argv[2], "skip-missing-root")) ? 0 : 2);
    { pr_result r; char *av[] = {"sh", "./unisacc.com", argv[0], "--", "--mutant", "accept-bad-verb", 0}; int t = pr_run("m1", av, ".", 0, 15, &r); ck(!t && r.rc == 0, "mutant-accept-bad-verb-red"); pr_free(&r); }
    { pr_result r; char *av[] = {"sh", "./unisacc.com", argv[0], "--", "--mutant", "skip-missing-root", 0}; int t = pr_run("m2", av, ".", 0, 15, &r); ck(!t && r.rc == 0, "mutant-skip-missing-root-red"); pr_free(&r); }
    { char *av[] = {"sh", "./unisacc.com", "tools/source-job-wave.cx", "--", "/no/root", "/no/ctx", "/no/build", "host", 0}; run(av, &rc, err, &en); ck(rc == 2 && (tx_find(err, (long)en, "ROOT CTX BUILD", tx_len("ROOT CTX BUILD", 256)) >= 0), "missing-root-refused"); }
    if (cx_fmt(root, sizeof root, "/tmp/sjw-%d", sy_pid())) return 2;
    if (cx_fmt(a, sizeof a, "%s/a", root) || cx_fmt(b, sizeof b, "%s/b", root) || cx_fmt(c, sizeof c, "%s/c", root)) return 2;
    if (sy_mkdir(root, 0700) || sy_mkdir(a, 0700) || sy_mkdir(b, 0700) || sy_mkdir(c, 0700)) return 2;
    { char *av[] = {"sh", "./unisacc.com", "tools/source-job-wave.cx", "--", a, b, c, "nope", 0}; run(av, &rc, err, &en); ck(rc == 2 && (tx_find(err, (long)en, "arguments", tx_len("arguments", 256)) >= 0), "bad-verb-refused"); }
    printf("CHECK_SOURCE_JOB_WAVE\tfailed=%d\n", failed); return failed ? 1 : 0;
}
