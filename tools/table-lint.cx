/* tools/table-lint.cx -- static checks on a seed-gen delta before any network is built.
 *   sh ./unisacc.com tools/table-lint.cx -- DELTA.json [--strict]
 * Reads the pre-network delta (state names intact, cxlib.delta) and reports, per check, every finding
 * with the state/edge it concerns. rc 0 when no ERROR; --strict also turns WARN into rc 1.
 * Checks (the ones that this week's E2 UCN work found by probing after construction):
 *   total       a b/r state missing an edge for some key 0..256 (the executor dies at run time there)
 *   reach       states unreachable from the start state (dead rows are debt, not coverage)
 *   stale-r     (WARN: path-insensitive) a result-mode state entered without r set since the last dispatch
 *               (CMP/CMPI/C64/C64U/RLD/A64/A64I/DIVMOD10/OLAST), so it dispatches on a stale result
 *   t-keys      a label PUSHed somewhere without a row in a t-mode state, or a t-row key never pushed
 *   unwritten   a register read somewhere but written nowhere (reads 0 forever)
 *   maybe-unwritten  a register read on some path before any write (forward must-write dataflow over
 *               the state graph from START; W defaults to 0, so WARN unless it is also never written)
 *   dead-end    a state with no outgoing edge that neither ACCEPTs nor REJECTs by name
 *   sb-read     SBINTERN/SBFIND that may consume a string buffer not cleared on some path since
 *               the last SBINTERN/SBFIND (WARN: a stale key is the classic silent identity bug; SBSAVE is a save-for-restore)
 * No construction, no execution, no cached verdict. */
#pragma unisa use cxlib.delta

static dl_delta D; static int errors, warnings, strict;
static void finding(const char *level, const char *check, const char *state, const char *detail) {
    printf("%s\t%s\t%s\t%s\n", level, check, state, detail); if (!strcmp(level, "ERROR")) errors++; else warnings++;
}
static int sets_r(dl_seq *q) {
    int r = 0;
    for (int i = 0; i < q->n; i++) { int op = q->a[i].op; if (op == DL_CMP || op == DL_CMPI || op == DL_C64 || op == DL_C64U || op == DL_RLD || op == DL_A64 || op == DL_A64I || op == DL_DIVMOD10 || op == DL_OLAST) r = 1; }
    return r;
}
/* registers written / read by an action (by id); returns counts through out arrays */
static int act_writes(dl_act *a, int *w) {
    int n = 0;
    switch (a->op) {
    case DL_MARK: case DL_LDI: case DL_COPYW: case DL_ALU: case DL_ALUI: case DL_A64: case DL_A64I: case DL_LDX: case DL_OLEN: case DL_OCUT: case DL_ORES: case DL_XATTR: case DL_INTERN: case DL_SBINTERN: case DL_BLOBSAVE: case DL_SBSAVE: case DL_SBFIND: case DL_BYTE: case DL_XLEN: case DL_BLEN: case DL_DIVMOD10: case DL_INC:
        w[n++] = a->r1; break;
    default: break;
    }
    return n;
}
static int act_reads(dl_act *a, int *r) {
    int n = 0;
    switch (a->op) {
    case DL_JUMP: case DL_RLD: case DL_OUTW: case DL_SPAN: case DL_SPANT: case DL_SETOT: case DL_INPUSH: case DL_INPUSHX: case DL_SBBLOB: case DL_DIVMOD10: case DL_INC: r[n++] = a->r1; break;
    case DL_COPYW: case DL_OCUT: case DL_INPUSHXE: case DL_SBSPAN: case DL_BLEN: case DL_SPAN2: case DL_OFILL: if (a->op == DL_COPYW || a->op == DL_OCUT || a->op == DL_BLEN || a->op == DL_OFILL) r[n++] = a->r2; else { r[n++] = a->r1; r[n++] = a->r2; } break;
    case DL_CMP: r[n++] = a->r1; if (!a->addr2) r[n++] = a->r2; break;
    case DL_CMPI: r[n++] = a->r1; break;
    case DL_C64: case DL_C64U: r[n++] = a->r1; r[n++] = a->r2; break;
    case DL_ALU: case DL_A64: r[n++] = a->r2; r[n++] = a->r3; break;
    case DL_ALUI: case DL_A64I: r[n++] = a->r2; break;
    case DL_LDX: r[n++] = a->r2; break;
    case DL_STX: r[n++] = a->r1; r[n++] = a->r2; break;
    case DL_INTERN: case DL_BLOBSAVE: r[n++] = a->r2; r[n++] = a->r3; break;
    default: break;
    }
    return n;
}
typedef struct { int next; dl_seq *seq; int from; int key; int keys; } Edge;   /* key: first key, keys: how many keys share this (from,next,seq) */
static Edge *E; static int NE;
static void collect_edges(void) {
    int cap = 1024; E = malloc((size_t)cap * sizeof(Edge)); if (!E) exit(2);
    for (int s = 0; s < D.ns; s++) {
        dl_state *st = &D.s[s];
        if (st->mode == 't') { for (int k = 0; k < st->tn; k++) { if (NE == cap) { cap *= 2; E = realloc(E, (size_t)cap * sizeof(Edge)); if (!E) exit(2); } E[NE].next = st->tedges[k].next; E[NE].seq = st->tedges[k].seq; E[NE].from = s; E[NE].key = -1 - k; E[NE].keys = 1; NE++; } }
        else for (int k = 0; k < 257; k++) if (st->byte[k].next >= 0) {
            int dup = -1; for (int e = NE - 1; e >= 0 && E[e].from == s; e--) if (E[e].next == st->byte[k].next && E[e].seq == st->byte[k].seq) { dup = e; break; }
            if (dup >= 0) { E[dup].keys++; continue; }
            if (NE == cap) { cap *= 2; E = realloc(E, (size_t)cap * sizeof(Edge)); if (!E) exit(2); } E[NE].next = st->byte[k].next; E[NE].seq = st->byte[k].seq; E[NE].from = s; E[NE].key = k; E[NE].keys = 1; NE++; }
    }
}
static const char *keyname(dl_state *st, int key, char *buf, size_t cap) { if (key < 0) snprintf(buf, cap, "%s", st->tkeys[-1 - key]); else snprintf(buf, cap, "%d", key); return buf; }

int main(int argc, char **argv) {
    if (argc < 2 || argc > 3) { fputs("usage: table-lint DELTA.json [--strict]\n", stderr); return 2; }
    strict = argc == 3 && !strcmp(argv[2], "--strict");
    dl_load(argv[1], &D); collect_edges();
    char kb[256], detail[1024];
    /* total */
    for (int s = 0; s < D.ns; s++) if (D.s[s].mode != 't') { int miss = 0, first = -1; for (int k = 0; k < 257; k++) if (D.s[s].byte[k].next < 0) { miss++; if (first < 0) first = k; } if (miss) { { if (cx_fmt(detail, sizeof detail, "%d keys without an edge (first %d)", miss, first)) { fprintf(stderr, "table-lint: text too long for detail\n"); exit(2); } } finding("ERROR", "total", D.s[s].name, detail); } }
    /* reach */
    unsigned char *seen = calloc((size_t)D.ns, 1); int *work = malloc((size_t)D.ns * sizeof(int)); int wn = 0; if (!seen || !work) return 2;
    seen[D.start] = 1; work[wn++] = D.start;
    while (wn) { int s = work[--wn]; dl_state *st = &D.s[s]; if (st->mode == 't') { for (int k = 0; k < st->tn; k++) { int t = st->tedges[k].next; if (!seen[t]) { seen[t] = 1; work[wn++] = t; } } } else for (int k = 0; k < 257; k++) { int t = st->byte[k].next; if (t >= 0 && !seen[t]) { seen[t] = 1; work[wn++] = t; } } }
    { int un = 0; for (int s = 0; s < D.ns; s++) if (!seen[s]) { un++; finding("WARN", "reach", D.s[s].name, "unreachable from the start state"); } (void)un; }
    /* stale-r: r must have been set since the last result-mode dispatch (fresh=1); dataflow over the graph */
    { unsigned char *fresh = calloc((size_t)D.ns, 1), *has = calloc((size_t)D.ns, 1); if (!fresh || !has) return 2; has[D.start] = 1; fresh[D.start] = 0; int changed = 1, rounds = 0;
      while (changed && rounds < 1000) { changed = 0; rounds++;
        for (int i = 0; i < NE; i++) { int f = E[i].from, t = E[i].next; if (!has[f]) continue; int c = D.s[f].mode == 'r' ? (E[i].keys == 1 ? 1 : E[i].keys == 257 ? fresh[f] : 0) : fresh[f]; if (sets_r(E[i].seq)) c = 1;   /* a single-key edge out of a result state knows r exactly */
          if (!has[t]) { has[t] = 1; fresh[t] = (unsigned char)c; changed = 1; } else if (fresh[t] && !c) { fresh[t] = 0; changed = 1; } } }
      for (int i = 0; i < NE; i++) { int f = E[i].from, t = E[i].next; if (!has[f] || D.s[t].mode != 'r') continue; int c = D.s[f].mode == 'r' ? (E[i].keys == 1 ? 1 : E[i].keys == 257 ? fresh[f] : 0) : fresh[f]; if (sets_r(E[i].seq)) c = 1;
        if (!c && D.s[f].mode == 'r' && E[i].keys == 1) continue;   /* a single-key edge out of a result state knows r exactly: re-dispatch is deliberate */
        if (!c) { int uniform = 1; for (int k = 1; k < 257; k++) if (D.s[t].byte[k].next != D.s[t].byte[0].next || D.s[t].byte[k].seq != D.s[t].byte[0].seq) { uniform = 0; break; }
          if (uniform) continue;   /* a result state whose row is one `*` edge does not dispatch on r */
          { if (cx_fmt(detail, sizeof detail, "entered from %s on key %s (%d keys) without r set since the last result dispatch", D.s[f].name, keyname(&D.s[f], E[i].key, kb, sizeof kb), E[i].keys)) { fprintf(stderr, "table-lint: text too long for detail\n"); exit(2); } } finding("WARN", "stale-r", D.s[t].name, detail); } }
    }
    /* t-keys */
    for (int i = 0; i < NE; i++) for (int j = 0; j < E[i].seq->n; j++) if (E[i].seq->a[j].op == DL_PUSH) {
        const char *lab = E[i].seq->a[j].s1; int found = 0;
        for (int s = 0; s < D.ns && !found; s++) if (D.s[s].mode == 't') for (int k = 0; k < D.s[s].tn; k++) if (!strcmp(D.s[s].tkeys[k], lab)) { found = 1; break; }
        if (!found) { { if (cx_fmt(detail, sizeof detail, "label %s pushed by %s but no t-state has a row for it", lab, D.s[E[i].from].name)) { fprintf(stderr, "table-lint: text too long for detail\n"); exit(2); } } finding("ERROR", "t-keys", D.s[E[i].from].name, detail); }
    }
    for (int s = 0; s < D.ns; s++) if (D.s[s].mode == 't') for (int k = 0; k < D.s[s].tn; k++) {
        const char *lab = D.s[s].tkeys[k]; if (!strcmp(lab, "BOT")) continue; int found = 0;
        for (int i = 0; i < NE && !found; i++) for (int j = 0; j < E[i].seq->n; j++) if (E[i].seq->a[j].op == DL_PUSH && !strcmp(E[i].seq->a[j].s1, lab)) { found = 1; break; }
        if (!found) { { if (cx_fmt(detail, sizeof detail, "row for label %s but nothing pushes it", lab)) { fprintf(stderr, "table-lint: text too long for detail\n"); exit(2); } } finding("WARN", "t-keys", D.s[s].name, detail); }
    }
    /* unwritten / maybe-unwritten: must-write dataflow over edges */
    int nr = D.nreg + 1; unsigned char *written_any = calloc((size_t)nr, 1), *read_any = calloc((size_t)nr, 1); if (!written_any || !read_any) return 2;
    for (int i = 0; i < NE; i++) for (int j = 0; j < E[i].seq->n; j++) { int w[4], r[4]; int nw = act_writes(&E[i].seq->a[j], w), nrd = act_reads(&E[i].seq->a[j], r); for (int x = 0; x < nw; x++) written_any[w[x]] = 1; for (int x = 0; x < nrd; x++) read_any[r[x]] = 1; }
    for (int g = 1; g < nr; g++) if (read_any[g] && !written_any[g]) { { if (cx_fmt(detail, sizeof detail, "register %s is read but never written (always 0)", dl_regname(&D, g))) { fprintf(stderr, "table-lint: text too long for detail\n"); exit(2); } } finding("WARN", "unwritten", "-", detail); }
    { long words = (nr + 63) / 64; unsigned long long *in = calloc((size_t)D.ns * (size_t)words, sizeof(unsigned long long)); unsigned char *has = calloc((size_t)D.ns, 1); if (!in || !has) return 2;
      has[D.start] = 1; int changed = 1, rounds = 0;
      while (changed && rounds < 1000) { changed = 0; rounds++;
        for (int i = 0; i < NE; i++) { int f = E[i].from, t = E[i].next; if (!has[f]) continue;
          unsigned long long *out = malloc((size_t)words * sizeof(unsigned long long)); if (!out) return 2; memcpy(out, in + (size_t)f * (size_t)words, (size_t)words * sizeof(unsigned long long));
          for (int j = 0; j < E[i].seq->n; j++) { int w[4]; int nw = act_writes(&E[i].seq->a[j], w); for (int x = 0; x < nw; x++) if (w[x]) out[w[x] / 64] |= 1ULL << (w[x] % 64); }
          unsigned long long *dst = in + (size_t)t * (size_t)words;
          if (!has[t]) { memcpy(dst, out, (size_t)words * sizeof(unsigned long long)); has[t] = 1; changed = 1; }
          else for (long k = 0; k < words; k++) { unsigned long long nv = dst[k] & out[k]; if (nv != dst[k]) { dst[k] = nv; changed = 1; } }
          free(out); }
      }
      /* one line per register: how many edges read it before any write on some path, and the first such edge */
      int *count = calloc((size_t)nr, sizeof(int)); char **first = calloc((size_t)nr, sizeof(char *)); if (!count || !first) return 2;
      for (int i = 0; i < NE; i++) { int f = E[i].from; if (!has[f]) continue; unsigned long long *cur = malloc((size_t)words * sizeof(unsigned long long)); if (!cur) return 2; memcpy(cur, in + (size_t)f * (size_t)words, (size_t)words * sizeof(unsigned long long));
        for (int j = 0; j < E[i].seq->n; j++) { int w[4], r[4]; int nrd = act_reads(&E[i].seq->a[j], r);
          for (int x = 0; x < nrd; x++) if (r[x] && written_any[r[x]] && !(cur[r[x] / 64] & (1ULL << (r[x] % 64)))) {
            if (!count[r[x]]++) { { if (cx_fmt(detail, sizeof detail, "%s on edge %s --%s--> %s", dl_opname(E[i].seq->a[j].op), D.s[f].name, keyname(&D.s[f], E[i].key, kb, sizeof kb), D.s[E[i].next].name)) { fprintf(stderr, "table-lint: text too long for detail\n"); exit(2); } } first[r[x]] = malloc(strlen(detail) + 1); if (!first[r[x]]) return 2; memcpy(first[r[x]], detail, strlen(detail) + 1); } }
          int nw = act_writes(&E[i].seq->a[j], w); for (int x = 0; x < nw; x++) if (w[x]) cur[w[x] / 64] |= 1ULL << (w[x] % 64); }
        free(cur); }
      for (int g = 1; g < nr; g++) if (count[g]) { { if (cx_fmt(detail, sizeof detail, "register %s read before any write on some path at %d edges; first: %s (W defaults to 0, so WARN)", dl_regname(&D, g), count[g], first[g])) { fprintf(stderr, "table-lint: text too long for detail\n"); exit(2); } } finding("WARN", "maybe-unwritten", "-", detail); }
    }
    /* dead-end */
    for (int s = 0; s < D.ns; s++) { dl_state *st = &D.s[s]; int out = 0, term = 0; if (st->mode == 't') out = st->tn; else for (int k = 0; k < 257; k++) if (st->byte[k].next >= 0) out++;
        if (!out) { for (int i = 0; i < NE; i++) if (E[i].next == s) for (int j = 0; j < E[i].seq->n; j++) if (E[i].seq->a[j].op == DL_ACCEPT || E[i].seq->a[j].op == DL_REJECT) term = 1; if (!term) finding("ERROR", "dead-end", st->name, "no outgoing edge and no ACCEPT/REJECT on any incoming edge"); } }
    /* sb-read: may the string buffer be stale at a read? dataflow value: 1 = clean (cleared since last consume) */
    { unsigned char *clean = malloc((size_t)D.ns), *has = calloc((size_t)D.ns, 1); if (!clean || !has) return 2; memset(clean, 1, (size_t)D.ns); has[D.start] = 1; int changed = 1, rounds = 0;
      while (changed && rounds < 1000) { changed = 0; rounds++;
        for (int i = 0; i < NE; i++) { int f = E[i].from, t = E[i].next; if (!has[f]) continue; int c = clean[f];
          for (int j = 0; j < E[i].seq->n; j++) { int op = E[i].seq->a[j].op; if (op == DL_SBCLR) c = 1; else if (op == DL_SBINTERN || op == DL_SBFIND) c = 0; }
          if (!has[t]) { has[t] = 1; clean[t] = (unsigned char)c; changed = 1; } else if (clean[t] && !c) { clean[t] = 0; changed = 1; } }
      }
      int reported = 0;
      for (int i = 0; i < NE && reported < 200; i++) { int f = E[i].from; if (!has[f]) continue; int c = clean[f];
        for (int j = 0; j < E[i].seq->n; j++) { int op = E[i].seq->a[j].op; if (op == DL_SBCLR) c = 1; else if (op == DL_SBINTERN || op == DL_SBFIND) { if (!c) { { if (cx_fmt(detail, sizeof detail, "%s on edge %s --%s--> %s may read a string buffer not cleared since its last consume", dl_opname(op), D.s[f].name, keyname(&D.s[f], E[i].key, kb, sizeof kb), D.s[E[i].next].name)) { fprintf(stderr, "table-lint: text too long for detail\n"); exit(2); } } finding("WARN", "sb-read", D.s[f].name, detail); reported++; } c = 0; } } }
    }
    printf("SUMMARY\tstates=%d\tedges=%d\tregisters=%d\terrors=%d\twarnings=%d\n", D.ns, NE, D.nreg, errors, warnings);
    return errors || (strict && warnings) ? 1 : 0;
}
