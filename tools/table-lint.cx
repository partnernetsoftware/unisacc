/* 静态表审计。case manifest: scope<TAB>b|r<TAB>relative-table.tsv。
 * 表支持4列 state/observation/next/actions 或5列 section/state/observation/next/actions。
 * policy: scope<TAB>state<TAB>no-fallback|external<TAB>reason，精确匹配且原因必填。
 * root按manifest call闭包选择安装项；未解析的动态绑定明确UNRESOLVED，不能当确定错误。
 * rows是全部TSV非空非注释数据行，包含manifest及facts；states为静态检查中的不同作用域状态。
 */
#pragma unisa use sys.fs
#pragma unisa use text.text
#pragma unisa use mem.bytes

typedef struct { char *scope,*name,*file; int line,mode,star,dynamic,unknown,lo,hi; unsigned char keys[257]; } State;
typedef struct { char *scope,*from,*to,*file; int line,dynamic,push; } Ref;
typedef struct { char *scope,*state,*rule,*reason; } Policy;
typedef struct { char *stage,*stem,*section,*bind,*opts; int mode,templ;char *facts,*over,*alias,*dir; } Install;
static State *states;static int ns,cs;static Ref *refs;static int nr,cr;
static Policy *pol;static int np,cp;static Install *inst;static int ni,ci;
static int files,rows,errors,warnings,shown,limit=10,audit,fixture,unresolved,checked,errors_only;
static char **visited;static int nv;
static char tl_source[4400]="<arguments>";static int tl_source_line;
static void tl_at(const char *file,int line){size_t n=strlen(file);if(n>=sizeof tl_source){fprintf(stderr,"table-lint: source path too long\n");exit(2);}for(size_t i=0;i<=n;i++)tl_source[i]=file[i];tl_source_line=line;}
static void refuse(const char *s){fprintf(stderr,"table-lint: REFUSE: %s:%d: %s\n",tl_source,tl_source_line,s);exit(2);}
static void *tl_grow(void *p,size_t n){void *q=realloc(p,n?n:1);if(!q)refuse("allocation");return q;}
/* 工具侧私有JSON值读取器：最多32层、65536节点；完整消费输入，严格转义和数字语法。 */
enum {J_NULL,J_BOOL,J_NUM,J_STR,J_ARR,J_OBJ};
typedef struct jvalue {int kind;unsigned shares;char *s;size_t slen,len,nkeys,capacity;struct jvalue **items,**vals;char **keys;struct jvalue *parent;} jvalue;
typedef struct {const char *p,*end;int nodes;} Parser;
static void jspace(Parser *p){while(p->p<p->end&&strchr(" \r\n\t",*p->p))p->p++;}
static unsigned jhex(Parser *p){unsigned n=0;for(int i=0;i<4;i++){if(p->p==p->end)refuse("JSON unicode escape");unsigned char c=(unsigned char)*p->p++;unsigned v=c>='0'&&c<='9'?c-'0':c>='a'&&c<='f'?c-'a'+10:c>='A'&&c<='F'?c-'A'+10:16;if(v==16)refuse("JSON unicode digit");n=n*16+v;}return n;}
static char *jstring(Parser *p,size_t *len){if(p->p==p->end||*p->p++!='\"')refuse("JSON string");size_t cap=32,n=0;char *s=tl_grow(0,cap);int closed=0;while(p->p<p->end){unsigned char c=(unsigned char)*p->p++;if(c=='\"'){closed=1;break;}if(c<32)refuse("JSON control byte");unsigned code=c;int unicode=0;if(c=='\\'){if(p->p==p->end)refuse("JSON escape");c=(unsigned char)*p->p++;if(c=='u'){code=jhex(p);unicode=1;if(code>=0xd800&&code<=0xdbff){if(p->end-p->p<2||p->p[0]!='\\'||p->p[1]!='u')refuse("JSON missing low surrogate");p->p+=2;unsigned low=jhex(p);if(low<0xdc00||low>0xdfff)refuse("JSON low surrogate");code=0x10000+((code-0xd800)<<10)+(low-0xdc00);}else if(code>=0xdc00&&code<=0xdfff)refuse("JSON lone low surrogate");}else if(c=='n')code=10;else if(c=='r')code=13;else if(c=='t')code=9;else if(c=='b')code=8;else if(c=='f')code=12;else if(c=='\"'||c=='\\'||c=='/')code=c;else refuse("JSON invalid escape");}if(n+5>cap){cap*=2;s=tl_grow(s,cap);}if(unicode&&code>=0x80){if(code<0x800){s[n++]=(char)(0xc0|(code>>6));s[n++]=(char)(0x80|(code&63));}else if(code<0x10000){s[n++]=(char)(0xe0|(code>>12));s[n++]=(char)(0x80|((code>>6)&63));s[n++]=(char)(0x80|(code&63));}else{s[n++]=(char)(0xf0|(code>>18));s[n++]=(char)(0x80|((code>>12)&63));s[n++]=(char)(0x80|((code>>6)&63));s[n++]=(char)(0x80|(code&63));}}else s[n++]=(char)code;}if(!closed)refuse("JSON unterminated string");s[n]=0;*len=n;return s;}
static jvalue *jparse(Parser *p,int depth){if(depth>32||++p->nodes>65536)refuse("JSON nesting/node bound");jspace(p);if(p->p==p->end)refuse("JSON missing value");jvalue *v=tl_grow(0,sizeof *v);memset(v,0,sizeof *v);char c=*p->p;if(c=='\"'){v->kind=J_STR;v->s=jstring(p,&v->slen);return v;}if(c=='['||c=='{'){int object=c=='{';v->kind=object?J_OBJ:J_ARR;p->p++;jspace(p);char close=object?'}':']';if(p->p<p->end&&*p->p==close){p->p++;return v;}size_t cap=0;for(;;){char *key=0;size_t kl=0;if(object){jspace(p);key=jstring(p,&kl);if(strlen(key)!=kl)refuse("JSON NUL object key");for(size_t i=0;i<v->nkeys;i++)if(!strcmp(v->keys[i],key))refuse("JSON duplicate key");jspace(p);if(p->p==p->end||*p->p++!=':')refuse("JSON colon");}jvalue *item=jparse(p,depth+1);size_t n=object?v->nkeys:v->len;if(n==cap){cap=cap?cap*2:8;if(object){v->keys=tl_grow(v->keys,cap*sizeof *v->keys);v->vals=tl_grow(v->vals,cap*sizeof *v->vals);}else v->items=tl_grow(v->items,cap*sizeof *v->items);}if(object){v->keys[n]=key;v->vals[n]=item;v->nkeys++;}else v->items[v->len++]=item;jspace(p);if(p->p==p->end)refuse("JSON unclosed container");c=*p->p++;if(c==close)return v;if(c!=',')refuse("JSON comma");}}if(c=='-'||(c>='0'&&c<='9')){const char *numstart=p->p;v->kind=J_NUM;if(*p->p=='-')p->p++;if(p->p==p->end)refuse("JSON number");if(*p->p=='0')p->p++;else{if(*p->p<'1'||*p->p>'9')refuse("JSON integer");while(p->p<p->end&&*p->p>='0'&&*p->p<='9')p->p++;}if(p->p<p->end&&*p->p=='.'){p->p++;const char *start=p->p;while(p->p<p->end&&*p->p>='0'&&*p->p<='9')p->p++;if(p->p==start)refuse("JSON fraction");}if(p->p<p->end&&(*p->p=='e'||*p->p=='E')){p->p++;if(p->p<p->end&&(*p->p=='+'||*p->p=='-'))p->p++;const char *start=p->p;while(p->p<p->end&&*p->p>='0'&&*p->p<='9')p->p++;if(p->p==start)refuse("JSON exponent");}v->slen=(size_t)(p->p-numstart);v->s=tl_grow(0,v->slen+1);for(size_t i=0;i<v->slen;i++)v->s[i]=numstart[i];v->s[v->slen]=0;return v;}if(p->end-p->p>=4&&!memcmp(p->p,"null",4)){p->p+=4;return v;}if(p->end-p->p>=4&&!memcmp(p->p,"true",4)){p->p+=4;v->kind=J_BOOL;v->slen=1;return v;}if(p->end-p->p>=5&&!memcmp(p->p,"false",5)){p->p+=5;v->kind=J_BOOL;return v;}refuse("JSON invalid value");return 0;}
static void jfree(jvalue *v){if(!v)return;if(v->shares){v->shares--;return;}jfree(v->parent);for(size_t i=0;i<v->len;i++)jfree(v->items[i]);for(size_t i=0;i<v->nkeys;i++){free(v->keys[i]);jfree(v->vals[i]);}free(v->s);free(v->items);free(v->keys);free(v->vals);free(v);}
static char *tl_dup(const char *s){size_t n=strlen(s);char *p=malloc(n+1);if(!p)refuse("allocation");for(size_t i=0;i<=n;i++)p[i]=s[i];return p;}
static void join(char *p,size_t n,const char *a,const char *b){if(cx_fmt(p,n,"%s/%s",a,b))refuse("path bound");}
static int relative(const char *s){if(!*s||*s=='/'||strpbrk(s,"\\\r\n\t"))return 0;const char *a=s;while(*a){const char *z=strchr(a,'/');size_t n=z?(size_t)(z-a):strlen(a);if(!n||(n==1&&*a=='.')||(n==2&&!memcmp(a,"..",2)))return 0;if(!z)return 1;a=z+1;}return 0;}
static char *load(const char *p){tl_at(p,0);struct stat st;size_t n;if(lstat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>16777216)refuse(p);char *s=cx_read(p,&n);if(!s||n!=(size_t)st.st_size||memchr(s,0,n))refuse("input extent or NUL");return s;}
static int exists(const char *p){struct stat st;if(!lstat(p,&st)){if(!S_ISREG(st.st_mode))refuse(p);return 1;}if(errno!=ENOENT)refuse(p);return 0;}
static int fields(char *s,char **v,int cap){int n=1;v[0]=s;for(;*s;s++)if(*s=='\t'){if(n==cap)refuse("too many TSV columns");*s=0;v[n++]=s+1;}return n;}
static char *lineend(char *a){char *z=strchr(a,'\n');if(z)*z=0;size_t n=strlen(a);if(n&&a[n-1]=='\r')a[n-1]=0;return z;}
static void finding(int error,const char *rule,const char *scope,const char *file,int line,const char *state,const char *why){if(error)errors++;else warnings++;if(shown<limit&&(!errors_only||error)){if(printf("%s\t%s\t%s\t%s:%d\t%s\t%s\n",error?"ERROR":"WARN",rule,scope,file,line,state,why)<0)refuse("stdout");shown++;}}
static void unknown(const char *scope,const char *file,int line,const char *state,const char *why){unresolved++;finding(0,"UNRESOLVED",scope,file,line,state,why);}
static int dynamic(const char *s){return !strncmp(s,"fresh:",6)||strpbrk(s,"${}")!=0;}
static unsigned tl_possible_hash(const char *scope,const char *name);
static int *state_index;static size_t state_slots;static int state_indexed;
static size_t state_slot(const char *scope,const char *name){size_t s=(size_t)tl_possible_hash(scope,name)&(state_slots-1);while(state_index[s]){State *v=&states[state_index[s]-1];if(!strcmp(v->scope,scope)&&!strcmp(v->name,name))break;s=(s+1)&(state_slots-1);}return s;}
static void state_sync(void){
 if(!state_slots||(size_t)ns>state_slots/2){size_t cap=state_slots?state_slots:128;while((size_t)ns>cap/2)cap*=2;int *next=tl_grow(0,cap*sizeof *next);memset(next,0,cap*sizeof *next);free(state_index);state_index=next;state_slots=cap;state_indexed=0;}
 for(;state_indexed<ns;state_indexed++){State *v=&states[state_indexed];state_index[state_slot(v->scope,v->name)]=state_indexed+1;}
}
static int stateid(const char *scope,const char *name){if(!ns)return -1;if(state_indexed!=ns)state_sync();return state_index[state_slot(scope,name)]-1;}
static void addref(const char *scope,const char *from,const char *to,const char *file,int line,int dyn,int push){if(nr==cr){cr=cr?cr*2:1024;refs=tl_grow(refs,(size_t)cr*sizeof *refs);}refs[nr++]=(Ref){tl_dup(scope),tl_dup(from),tl_dup(to),tl_dup(file),line,dyn||dynamic(to),push};}
static const char *policy(const char *scope,const char *state,const char *rule){for(int i=0;i<np;i++)if(!strcmp(pol[i].scope,scope)&&!strcmp(pol[i].state,state)&&!strcmp(pol[i].rule,rule))return pol[i].reason;return 0;}
static void addpolicy(const char *scope,const char *state,const char *rule,const char *reason){if(np==cp){cp=cp?cp*2:64;pol=tl_grow(pol,(size_t)cp*sizeof *pol);}pol[np++]=(Policy){tl_dup(scope),tl_dup(state),tl_dup(rule),tl_dup(reason)};}
static void policies(const char *dir,const char *leaf){char p[4400];join(p,sizeof p,dir,leaf);if(!exists(p))return;char *s=load(p),*a=s;int ln=0;while(*a){tl_at(p,++ln);char *z=lineend(a);if(*a&&*a!='#'){char *v[4];if(fields(a,v,4)!=4||!*v[0]||!*v[1]||!*v[3]||(strcmp(v[2],"no-fallback")&&strcmp(v[2],"external")&&strcmp(v[2],"sb-entry")))refuse("policy schema/reason");if(!strcmp(v[2],"sb-entry")){char *bar=strchr(v[3],'|');if(!bar||bar==v[3]||!bar[1])refuse("sb-entry requires target|reason");}addpolicy(v[0],v[1],v[2],v[3]);}if(!z)break;a=z+1;}free(s);}
static jvalue *tl_json(const char *s){Parser p={s,s+strlen(s),0};jvalue *v=jparse(&p,0);jspace(&p);if(p.p!=p.end)refuse("JSON trailing input");return v;}
static jvalue *tl_get(jvalue *v,const char *key){for(;v;v=v->parent){if(v->kind!=J_OBJ)return 0;for(size_t i=0;i<v->nkeys;i++)if(!strcmp(v->keys[i],key))return v->vals[i];}return 0;}
static const char *bound(const char *s,const char *bindings,char *out,size_t cap){if(s[0]!='$')return s;const char *name=s+1;size_t k=strlen(name);const char *a=bindings;while(*a){const char *z=strchr(a,',');size_t n=z?(size_t)(z-a):strlen(a);if(n>k&&a[k]=='='&&!memcmp(a,name,k)){a+=k+1;n-=k+1;if(n>=5&&!memcmp(a,"@str:",5)){a+=5;n-=5;}else return s;if(n>=cap)refuse("binding bound");for(size_t i=0;i<n;i++)out[i]=a[i];out[n]=0;return out;}if(!z)break;a=z+1;}return s;}
static int number(const char **p){int n=0;if(**p<'0'||**p>'9')return -1;while(**p>='0'&&**p<='9'){if(n>257)return -1;n=n*10+**p-'0';*p=*p+1;}return n;}
static void keys(State *s,const char *obs){if(!strcmp(obs,"*")){s->star=1;return;}const char *p=obs;while(*p){int lo=number(&p),hi=lo;if(lo<0||lo>256){s->unknown=1;return;}if(*p=='-'){p++;hi=number(&p);if(hi<lo||hi>256){s->unknown=1;return;}}for(int i=lo;i<=hi;i++)s->keys[i]=1;if(!*p)return;if(*p++!=','){s->unknown=1;return;}}s->unknown=1;}
static void domain(State *s,const char *opts){s->lo=0;s->hi=257;if(!opts)return;const char *p=strstr(opts,"\"domain\"");if(!p)return;p+=8;while(*p==' '||*p=='\t')p++;if(*p++!=':')refuse("domain syntax");while(*p==' '||*p=='\t')p++;if(*p++!='['){s->unknown=1;return;}while(*p==' '||*p=='\t')p++;int lo=number(&p);while(*p==' '||*p=='\t')p++;if(*p++!=',')refuse("domain pair");while(*p==' '||*p=='\t')p++;int hi=number(&p);while(*p==' '||*p=='\t')p++;if(*p!=']'||lo<0||hi<lo||hi>257)refuse("domain bounds");s->lo=lo;s->hi=hi;}
static void buffercheck(jvalue *acts,const char *scope,const char *file,int line,const char *state,const char *target){const char *contract=policy(scope,state,"sb-entry");if(!contract)return;const char *bar=strchr(contract,'|');size_t n=(size_t)(bar-contract);if(strlen(target)!=n||memcmp(target,contract,n))return;int cleared=0;for(size_t i=0;i<acts->len;i++){jvalue *a=acts->items[i];if(a->kind!=J_ARR||!a->len||a->items[0]->kind!=J_STR)refuse("action shape");const char *op=a->items[0]->s;if(!strcmp(op,"SBCLR"))cleared=1;else if(op[0]=='@'||(!strncmp(op,"SB",2)&&strcmp(op,"SBSAVE")))cleared=0;}if(!cleared)finding(1,"sbclear",scope,file,line,state,contract);else if(audit)finding(0,"sb-entry",scope,file,line,state,contract);}
/* 仅凭已安装源表的真实行状态和有限foreach事实，记录可能生成的定义。
 * 不把候选当已安装状态：命中只把该条undefined改为UNRESOLVED。
 */
typedef struct {char *facts,*over;jvalue *array;} TlFact;
typedef struct {char *scope,*name,*why;} TlPossible;
static TlFact *tl_fact_cache;static int tl_nf;
static TlPossible *tl_possible;static int tl_npossible,tl_cpossible;
/* 槽为候选下标+1；半满前扩容，重复候选保留首次证据。 */
static int *tl_possible_index;static size_t tl_possible_slots;
static Install *tl_active;static const char *tl_fact_root=".";
static const char *tl_table_dir;
static unsigned tl_possible_hash(const char *scope,const char *name){unsigned h=2166136261u;for(const unsigned char *p=(const unsigned char *)scope;*p;p++)h=(h^*p)*16777619u;h=(h^0u)*16777619u;for(const unsigned char *p=(const unsigned char *)name;*p;p++)h=(h^*p)*16777619u;return h;}
static size_t tl_possible_slot(const char *scope,const char *name,unsigned hash){size_t slot=(size_t)hash&(tl_possible_slots-1);while(tl_possible_index[slot]){TlPossible *p=&tl_possible[tl_possible_index[slot]-1];if(!strcmp(p->scope,scope)&&!strcmp(p->name,name))break;slot=(slot+1)&(tl_possible_slots-1);}return slot;}
static void tl_possible_rehash(void){size_t slots=tl_possible_slots?tl_possible_slots*2:128;int *old=tl_possible_index;tl_possible_index=tl_grow(0,slots*sizeof *tl_possible_index);memset(tl_possible_index,0,slots*sizeof *tl_possible_index);tl_possible_slots=slots;for(int i=0;i<tl_npossible;i++){TlPossible *p=&tl_possible[i];size_t slot=tl_possible_slot(p->scope,p->name,tl_possible_hash(p->scope,p->name));tl_possible_index[slot]=i+1;}free(old);}
static void tl_possible_insert(const char *scope,const char *name,const char *why,unsigned hash,size_t slot){if(!tl_possible_slots||(size_t)(tl_npossible+1)>tl_possible_slots/2){tl_possible_rehash();slot=tl_possible_slot(scope,name,hash);}if(tl_npossible==tl_cpossible){tl_cpossible=tl_cpossible?tl_cpossible*2:128;if(tl_cpossible>100000)tl_cpossible=100000;tl_possible=tl_grow(tl_possible,(size_t)tl_cpossible*sizeof *tl_possible);}tl_possible[tl_npossible]=(TlPossible){tl_dup(scope),tl_dup(name),tl_dup(why)};tl_possible_index[slot]=++tl_npossible;}
static void tl_possible_add(const char *scope,const char *name,const char *file,int line,const char *reason){if(!*name||dynamic(name)||!strcmp(name,"-"))return;unsigned hash=tl_possible_hash(scope,name);size_t slot=0;if(tl_possible_slots){slot=tl_possible_slot(scope,name,hash);if(tl_possible_index[slot])return;}char why[4400];if(cx_fmt(why,sizeof why,"possible definition from %s:%d; %s; not a fully assembled state",file,line,reason))refuse("definition evidence bound");if(tl_npossible>=100000)refuse("possible generated definition bound");tl_possible_insert(scope,name,why,hash,slot);}
static jvalue *tl_value(int kind){jvalue *v=tl_grow(0,sizeof *v);memset(v,0,sizeof *v);v->kind=kind;return v;}
static jvalue *tl_text(const char *s){jvalue *v=tl_value(J_STR);v->s=tl_dup(s);v->slen=strlen(s);return v;}
static void tl_append(jvalue *a,jvalue *v){if(a->len>=a->capacity){size_t cap=a->capacity?a->capacity*2:8;while(cap<=a->len)cap*=2;a->items=tl_grow(a->items,cap*sizeof *a->items);a->capacity=cap;}a->items[a->len++]=v;}
static jvalue *tl_fact_rows(char *text,const char *stem,const char *over){char *a=text,*z=lineend(a);char *header=a;while(*header=='#'||*header==' ')header++;char *cols[256];int nc=fields(header,cols,256);char *names[256];for(int i=0;i<nc;i++)names[i]=tl_dup(cols[i]);jvalue *array=tl_value(J_ARR);int selected=!strcmp(stem,over);char map[1200];if(cx_fmt(map,sizeof map,"%s!",stem))refuse("facts map bound");int mapped=!strcmp(map,over)&&nc==2&&!strcmp(names[0],"name")&&!strcmp(names[1],"value");while(z){a=z+1;z=lineend(a);if(!*a||*a=='#')continue;char *v[256];int n=fields(a,v,256);if(n!=nc)refuse("header facts column count");jvalue *record=tl_value(J_OBJ);record->nkeys=(size_t)nc;record->keys=tl_grow(0,(size_t)nc*sizeof *record->keys);record->vals=tl_grow(0,(size_t)nc*sizeof *record->vals);for(int i=0;i<nc;i++){record->keys[i]=tl_dup(names[i]);/* Names stay literal; quoted values use the same strict JSON reader. */record->vals[i]=v[i][0]=='"'?tl_json(v[i]):tl_text(v[i]);}if(selected&&nc==1&&!strcmp(names[0],"value")){jvalue *value=record->vals[0];record->vals[0]=0;tl_append(array,value);jfree(record);}else if(selected)tl_append(array,record);else if(mapped){jvalue *key=record->vals[0];if(key->kind==J_STR&&strlen(key->s)==key->slen)tl_append(array,tl_text(key->s));jfree(record);}else jfree(record);}for(int i=0;i<nc;i++)free(names[i]);if(!selected&&!mapped){jfree(array);return 0;}return array;}
static jvalue *tl_fact_array(const char *facts,const char *over){for(int i=0;i<tl_nf;i++)if(!strcmp(tl_fact_cache[i].facts,facts)&&!strcmp(tl_fact_cache[i].over,over))return tl_fact_cache[i].array;jvalue *result=0;char oldsource[4400];if(mm_copy(oldsource,sizeof oldsource,tl_source,strlen(tl_source)+1))refuse("source copy bound");int oldline=tl_source_line;const char *at=facts;while(*at){const char *end=strchr(at,'+');size_t n=end?(size_t)(end-at):strlen(at);char stem[1024];if(!n||n>=sizeof stem)break;if(mm_copy(stem,sizeof stem-1,at,n))refuse("facts stem bound");stem[n]=0;if(relative(stem)){char leaf[1200],base[4400],p[4400];join(base,sizeof base,tl_fact_root,"exec/facts");if(cx_fmt(leaf,sizeof leaf,"%s.tsv",stem))refuse("facts filename bound");join(p,sizeof p,base,leaf);if(exists(p)){char *s=load(p),*a=s;int line=0;char *first=s;while(*first){char *e=strchr(first,'\n');if(*first&&*first!='#'&&*first!='\n'&&*first!='\r')break;if(!e){first+=strlen(first);break;}first=e+1;}if(*first&&*first!='='&&*first!='@'&&*first!='\t'){jvalue *value=tl_fact_rows(s,stem,over);if(value){jfree(result);result=value;}}else while(*a){tl_at(p,++line);char *z=lineend(a);if(*a&&*a!='#'){char *tab=strchr(a,'\t');char *valueat=tab?strchr(tab+1,'\t'):0;if(tab&&valueat&&a[0]=='='&&(size_t)(tab-a-1)==strlen(over)&&!memcmp(a+1,over,strlen(over))&&valueat-tab==5&&!memcmp(tab+1,"json",4)){jvalue *value=tl_json(valueat+1);if(value->kind==J_ARR){jfree(result);result=value;}else jfree(value);}}if(!z)break;a=z+1;}free(s);}}if(!end)break;at=end+1;}tl_at(oldsource,oldline);tl_fact_cache=tl_grow(tl_fact_cache,(size_t)(tl_nf+1)*sizeof *tl_fact_cache);tl_fact_cache[tl_nf++]=(TlFact){tl_dup(facts),tl_dup(over),result};return result;}
static const char *tl_fact_scalar(jvalue *record,const char *field,const char *alias){if(!strcmp(field,alias)&&(record->kind==J_STR||record->kind==J_NUM))return record->s;char key[1024];size_t n=strlen(field);if(n>=sizeof key)return 0;for(size_t i=0;i<=n;i++)key[i]=field[i];size_t al=strlen(alias);char *p=key;if(!strncmp(p,alias,al)&&(p[al]=='.'||p[al]=='[')){p+=al+1;char *end=strchr(p,']');if(end)*end=0;}else if(strchr(p,'.')||strchr(p,'['))return 0;jvalue *v=tl_get(record,p);if(!v||(v->kind!=J_STR&&v->kind!=J_NUM)||!v->s||strlen(v->s)!=v->slen)return 0;return v->s;}
static int tl_fact_format(const char *expression,jvalue *record,const char *alias,char *out,size_t cap){const char *p=expression;int format=0;if(!strncmp(p,"@fmt:",5)||!strncmp(p,"@str:",5)){p+=5;format=1;}if(!format){const char *value=tl_fact_scalar(record,p,alias);if(!value)return 0;size_t n=strlen(value);if(n>=cap)refuse("generated name bound");for(size_t i=0;i<=n;i++)out[i]=value[i];return 1;}size_t n=0;while(*p){if(*p=='{'){const char *end=strchr(p+1,'}');if(!end)return 0;size_t k=(size_t)(end-p-1);char field[1024];if(!k||k>=sizeof field)return 0;for(size_t i=0;i<k;i++)field[i]=p[1+i];field[k]=0;const char *value=tl_fact_scalar(record,field,alias);if(!value)return 0;size_t v=strlen(value);if(n+v>=cap)refuse("generated name bound");for(size_t i=0;i<v;i++)out[n++]=value[i];p=end+1;}else{if(n+1>=cap)refuse("generated name bound");out[n++]=*p;p++;}}out[n]=0;return n&&!dynamic(out);}
static void tl_generated_state(const char *scope,const char *state,const char *file,int line){Install *in=tl_active;if(!in||state[0]!='$'||!strcmp(in->over,"-")||dynamic(in->over))return;const char *key=state+1;size_t k=strlen(key);const char *at=in->bind;char expr[4400];int found=0;while(*at){const char *end=strchr(at,',');size_t n=end?(size_t)(end-at):strlen(at);if(n>k&&at[k]=='='&&!memcmp(at,key,k)){size_t v=n-k-1;if(v>=sizeof expr)refuse("generated binding bound");for(size_t i=0;i<v;i++)expr[i]=at[k+1+i];expr[v]=0;found=1;break;}if(!end)break;at=end+1;}if(!found)return;jvalue *array=tl_fact_array(in->facts,in->over);if(!array)return;for(size_t i=0;i<array->len;i++){char name[4400],why[4400];if(!tl_fact_format(expr,array->items[i],in->alias,name,sizeof name))continue;unsigned hash=tl_possible_hash(scope,name);size_t slot=0;if(tl_possible_slots){slot=tl_possible_slot(scope,name,hash);if(tl_possible_index[slot])continue;}if(tl_npossible>=100000)refuse("possible generated definition bound");if(cx_fmt(why,sizeof why,"possible definition from %s:%d; facts=%s foreach=%s binding=%s; not a fully assembled state",file,line,in->facts,in->over,expr))refuse("generated evidence bound");tl_possible_insert(scope,name,why,hash,slot);}}
static const char *tl_possible_definition(const char *scope,const char *name){if(!tl_possible_slots)return 0;size_t slot=tl_possible_slot(scope,name,tl_possible_hash(scope,name));int index=tl_possible_index[slot];return index?tl_possible[index-1].why:0;}
static void row(const char *scope,const char *file,int line,char **v,int mode,int raw,const char *bindings,const char *opts){char sb[4400],tb[4400];const char *state=bound(v[1],bindings,sb,sizeof sb),*target=bound(v[3],bindings,tb,sizeof tb);jvalue *acts=tl_json(v[4]);if(acts->kind!=J_ARR)refuse("actions must be JSON array");for(size_t i=0;i<acts->len;i++){jvalue *a=acts->items[i];if(a->kind!=J_ARR||!a->len||a->items[0]->kind!=J_STR||strlen(a->items[0]->s)!=a->items[0]->slen)refuse("action shape/opcode");if(a->items[0]->s[0]=='@'){if(!raw)refuse("unbound action macro");unknown(scope,file,line,v[1],"action macro requires manifest expansion");}}int dyn=dynamic(state);if(!raw&&(dyn||dynamic(target)))refuse("fixture states must be bound literals");if(dyn){tl_generated_state(scope,v[1],file,line);unknown(scope,file,line,state,"state requires foreach/fresh/facts binding; mode/target/fallback not statically proved");jfree(acts);return;}int id=stateid(scope,state);if(id<0){if(ns==cs){cs=cs?cs*2:1024;states=tl_grow(states,(size_t)cs*sizeof *states);}id=ns++;memset(&states[id],0,sizeof states[id]);states[id].scope=tl_dup(scope);states[id].name=tl_dup(state);states[id].file=tl_dup(file);states[id].line=line;states[id].mode=mode;}else if(states[id].mode!=mode)finding(1,"mode-conflict",scope,file,line,state,"same bound state has byte and result modes");keys(&states[id],v[2]);domain(&states[id],opts);if(opts&&(strstr(opts,"domain_keys")||strstr(opts,"domain_at")||strstr(opts,"tmodes")))states[id].unknown=1;addref(scope,state,target,file,line,0,0);buffercheck(acts,scope,file,line,state,target);for(size_t i=0;i<acts->len;i++){jvalue *a=acts->items[i];if(!strcmp(a->items[0]->s,"PUSH")){if(a->len!=2)refuse("PUSH arity");jvalue *t=a->items[1];if(t->kind==J_STR){if(strlen(t->s)!=t->slen)refuse("PUSH target NUL");char b[4400];const char *to=bound(t->s,bindings,b,sizeof b);addref(scope,state,to,file,line,0,1);}else if(t->kind==J_ARR&&raw)unknown(scope,file,line,state,"PUSH constant/facts target requires binding");else refuse("PUSH target must be bound string");}}jfree(acts);}
/* 仅9列模板允许JSON字符串外的{facts.path}，包括动作片段拼接。
 * 这不是JSON容错：插值前动作无法解析，明确记为UNRESOLVED；普通4/5列表仍严格JSON。
 */
static int tl_action_template(const char *s){int quoted=0,found=0;for(size_t i=0;s[i];i++){unsigned char c=(unsigned char)s[i];if(quoted){if(c=='\\'){if(!s[i+1])refuse("template trailing escape");i++;}else if(c=='\"')quoted=0;continue;}if(c=='\"'){quoted=1;continue;}if(c!='{')continue;size_t k=i+1;if(!((s[k]>='a'&&s[k]<='z')||(s[k]>='A'&&s[k]<='Z')||s[k]=='_'))continue;while((s[k]>='a'&&s[k]<='z')||(s[k]>='A'&&s[k]<='Z')||(s[k]>='0'&&s[k]<='9')||strchr("_.[]",s[k])&&s[k])k++;if(s[k]=='}'){found=1;i=k;}else if(!s[k])refuse("unclosed template placeholder");}if(quoted)refuse("template unterminated string");return found;}
static int tl_install_file(Install *in,const char *stage,const char *leaf){if(strcmp(in->stage,stage)||(in->dir&&tl_table_dir&&strcmp(in->dir,tl_table_dir)))return 0;if(in->templ==2)return !strcmp(in->stem,leaf);size_t n=strlen(in->stem);if(strncmp(leaf,in->stem,n))return 0;const char *suffix=leaf+n;if(in->templ==1)return !strcmp(suffix,"-template.tsv");return !strcmp(suffix,"-byte.tsv")||!strcmp(suffix,"-result.tsv");}
/* 图编辑操作数遵循finite_rules/manifest_template_edits；只保留可能定义，
 * 不把label、条件编辑或克隆前置条件当作已验证的状态/覆盖。 */
static void tl_template_definitions(const char *scope,const char *file,int line,char **v){const char *op=v[4];int dest=0;if(!strcmp(op,"move-state")||!strcmp(op,"move")||!strcmp(op,"copy-state")||!strcmp(op,"copy-replace")||!strcmp(op,"clone-push"))dest=6;else if(!strcmp(op,"copy")||!strcmp(op,"alias")||!strcmp(op,"label")||!strcmp(op,"fill-edge"))dest=5;if(!dest)return;for(int i=0;i<ni;i++){Install *in=&inst[i];if(in->templ!=1||!tl_install_file(in,scope,file))continue;if(strcmp(in->section,"-")&&strcmp(in->section,v[0])&&strcmp(v[0],"-")&&!dynamic(in->section))continue;tl_active=in;char b[4400],why[256];const char *name=bound(v[dest],in->bind,b,sizeof b);if(cx_fmt(why,sizeof why,"template %s definition operand %c; edit prerequisites and resulting edges unresolved",op,'a'+dest-5))refuse("template evidence bound");tl_possible_add(scope,name,file,line,why);tl_generated_state(scope,v[dest],file,line);if(!strcmp(op,"clone-push"))tl_possible_add(scope,v[8],file,line,"clone-push continuation label; clone preconditions unresolved");}tl_active=0;}
static void table(const char *dir,const char *leaf,const char *scope,int mode,int raw){tl_table_dir=dir;char p[4400];join(p,sizeof p,dir,leaf);char *s=load(p),*a=s;int line=0;if(!raw)files++;while(*a){line++;tl_at(p,line);char *z=lineend(a);if(*a&&*a!='#'){char *v[9];int n=fields(a,v,9),templ=n==9,rulemode=0;if(n==4){for(int k=4;k>0;k--)v[k]=v[k-1];v[0]="-";}else if(n==9){if(!raw)refuse("fixture table requires 4 or 5 columns");if(!strcmp(v[4],"rule:b"))rulemode='b';else if(!strcmp(v[4],"rule:r"))rulemode='r';else if(strcmp(v[4],"rule")){tl_template_definitions(scope,leaf,line,v);unknown(scope,leaf,line,v[0],"template instruction is generated dynamically; no static row");if(!z)break;a=z+1;continue;}v[1]=v[5];v[2]=v[6];v[3]=v[7];v[4]=v[8];if(tl_action_template(v[4])){unknown(scope,leaf,line,v[1],"actions contain unexpanded facts placeholders or action-fragment splice; action references and buffer preconditions are not statically proved");v[4]="[]";}}else if(n!=5)refuse("transition table requires 4/5 columns or 9-column template");if(!*v[1]||!*v[2]||!*v[3])refuse("empty transition field");if(!raw){rows++;row(scope,leaf,line,v,mode,0,"-",0);}else{int matched=0;for(int i=0;i<ni;i++){Install *in=&inst[i];if(!tl_install_file(in,scope,leaf))continue;tl_active=in;if(strcmp(in->section,"-")&&strcmp(in->section,v[0])&&strcmp(v[0],"-")){if(dynamic(in->section)){char b[4400];const char *name=bound(v[1],in->bind,b,sizeof b);tl_possible_add(scope,name,leaf,line,"literal source row under dynamic section selection");tl_generated_state(scope,v[1],leaf,line);}continue;}int m=rulemode?rulemode:in->mode?in->mode:mode;if(templ&&in->templ!=1)continue;row(scope,leaf,line,v,m,1,in->bind,in->opts);matched=1;}tl_active=0;if(!matched)unknown(scope,leaf,line,v[1],"source row is not selected by a statically resolved manifest section");}}if(!z)break;a=z+1;}free(s);}
static void case_manifest(const char *dir){char p[4400];join(p,sizeof p,dir,"manifest.tsv");char *s=load(p),*a=s;int count=0,ln=0;while(*a){tl_at(p,++ln);char *z=lineend(a);if(*a&&*a!='#'){char *v[3];if(fields(a,v,3)!=3||!*v[0]||strlen(v[1])!=1||(v[1][0]!='b'&&v[1][0]!='r')||!relative(v[2]))refuse("fixture manifest schema");table(dir,v[2],v[0],v[1][0],0);count++;}if(!z)break;a=z+1;}free(s);if(!count)refuse("empty fixture manifest");}
static void install(const char *stage,const char *stem,const char *section,const char *bind,const char *opts,int mode,int templ){if(ni==ci){ci=ci?ci*2:128;inst=tl_grow(inst,(size_t)ci*sizeof *inst);}inst[ni++]=(Install){tl_dup(stage),tl_dup(stem),tl_dup(section),tl_dup(bind),tl_dup(opts),mode,templ,tl_dup("-"),tl_dup("-"),tl_dup("it"),0};}
/* 只有call可含父目录；真实目录必须仍在同一ROOT内。case/facts仍用relative。 */
static int tl_call(const char *dir,const char *name,char *outdir,size_t cap,char *stem,size_t sc){if(!*name||*name=='/'||strpbrk(name,"\\\r\n\t"))return 0;char path[4400],base[4400],resolved[4400];join(path,sizeof path,dir,name);char *slash=strrchr(path,'/');if(!slash||!slash[1])return 0;if(strlen(slash+1)>=sc)refuse("call stem bound");if(mm_copy(stem,sc,slash+1,strlen(slash+1)+1))refuse("call stem bound");*slash=0;if(!relative(stem)||!realpath(tl_fact_root,base)||!realpath(path,resolved))return 0;size_t n=strlen(base);if(strncmp(base,resolved,n)||(resolved[n]&&resolved[n]!='/'&&strcmp(base,"/")))return 0;if(strlen(resolved)>=cap)refuse("call directory bound");if(mm_copy(outdir,cap,resolved,strlen(resolved)+1))refuse("call directory bound");return 1;}
/* 有限环境只产生精确的定义候选；仅显式flags可证明的false条件剪枝。
 * 其余条件、fresh、动作和图编辑前置条件仍未证明；调用独立帧，仅活动栈阻断递归。 */
/* 输入值只读共享；作用域只持有父帧与本地增量，let仅回并本地增量。 */
static jvalue *tl_env_copy(jvalue *v){if(v)v->shares++;return v;}
static jvalue *tl_env_scope(jvalue *v){jvalue *r=tl_value(J_OBJ);r->parent=tl_env_copy(v);return r;}
static void tl_env_put(jvalue *v,const char *key,jvalue *value){for(size_t i=0;i<v->nkeys;i++)if(!strcmp(v->keys[i],key)){jfree(v->vals[i]);v->vals[i]=value;return;}if(v->nkeys>=v->capacity){size_t cap=v->capacity?v->capacity*2:8;while(cap<=v->nkeys)cap*=2;v->keys=tl_grow(v->keys,cap*sizeof *v->keys);v->vals=tl_grow(v->vals,cap*sizeof *v->vals);v->capacity=cap;}size_t n=v->nkeys++;v->keys[n]=tl_dup(key);v->vals[n]=value;}
static void tl_env_merge(jvalue *env,jvalue *map){if(map&&map->kind==J_OBJ)for(size_t i=0;i<map->nkeys;i++)tl_env_put(env,map->keys[i],tl_env_copy(map->vals[i]));}
static TlFact *tl_env_cache;static int tl_ne;
/* 每个facts文件仅拆列一次；命名表、标量与JSON混排共享只读材料。 */
typedef struct {char *key,*json;jvalue *value;} TlEnvFactEntry;
typedef struct TlEnvFactFile {char *path,*text;TlEnvFactEntry *entries;int count,capacity;struct TlEnvFactFile *next;} TlEnvFactFile;
static TlEnvFactFile *tl_env_fact_files;
static TlEnvFactEntry *tl_env_fact_entry(TlEnvFactFile *p,char *key){if(p->count==p->capacity){p->capacity=p->capacity?p->capacity*2:16;p->entries=tl_grow(p->entries,(size_t)p->capacity*sizeof *p->entries);}TlEnvFactEntry *e=&p->entries[p->count++];*e=(TlEnvFactEntry){key,0,0};return e;}
static jvalue *tl_env_typed(const char *type,const char *text){if(!strcmp(type,"str"))return tl_text(text);if(!strcmp(type,"json"))return tl_json(text);if(!strcmp(type,"int")){const char *p=text;int negative=*p=='-';if(negative)p++;if(!*p)refuse("facts integer");for(const char *d=p;*d;d++)if(*d<'0'||*d>'9')refuse("facts integer");while(*p=='0'&&p[1])p++;jvalue *v=tl_value(J_NUM);size_t n=strlen(p);int sign=negative&&strcmp(p,"0");v->s=tl_grow(0,n+(size_t)sign+1);if(sign)v->s[0]='-';if(mm_copy(v->s+sign,n+1,p,n+1))refuse("facts integer bound");v->slen=n+(size_t)sign;return v;}refuse("facts type");return 0;}
static TlEnvFactFile *tl_env_fact_file(const char *path){for(TlEnvFactFile *p=tl_env_fact_files;p;p=p->next)if(!strcmp(p->path,path))return p;if(!exists(path))return 0;TlEnvFactFile *p=tl_grow(0,sizeof *p);*p=(TlEnvFactFile){0};p->path=tl_dup(path);p->text=load(path);char *a=p->text,*names[255],*types[255];int nc=0;jvalue *table=0;while(*a){char *z=lineend(a);if(*a=='='){table=0;char *v[3];if(fields(a,v,3)==3){TlEnvFactEntry *e=tl_env_fact_entry(p,v[0]+1);if(!strcmp(v[1],"json"))e->json=v[2];else e->value=tl_env_typed(v[1],v[2]);}}else if(*a=='@'){char *v[256];int n=fields(a,v,256);nc=n-1;table=tl_value(J_ARR);tl_env_fact_entry(p,v[0]+1)->value=table;for(int i=0;i<nc;i++){names[i]=v[i+1];char *colon=strrchr(names[i],':');if(!colon)refuse("typed facts column type");*colon=0;types[i]=colon+1;}}else if(*a=='\t'&&table){char *v[256];int n=fields(a,v,256);if(n!=nc+1)refuse("typed facts column count");jvalue *record=tl_value(J_OBJ);for(int i=0;i<nc;i++)tl_env_put(record,names[i],tl_env_typed(types[i],v[i+1]));tl_append(table,record);}if(!z)break;a=z+1;}p->next=tl_env_fact_files;tl_env_fact_files=p;return p;}
static jvalue *tl_env_fact(const char *facts,const char *key){for(int i=0;i<tl_ne;i++)if(!strcmp(tl_env_cache[i].facts,facts)&&!strcmp(tl_env_cache[i].over,key))return tl_env_cache[i].array;jvalue *result=0;const char *a=facts;while(*a){const char *end=strchr(a,'+');size_t n=end?(size_t)(end-a):strlen(a);char stem[1024],leaf[1200],base[4400],path[4400];if(!n||n>=sizeof stem)break;if(mm_copy(stem,sizeof stem-1,a,n))refuse("facts stem bound");stem[n]=0;if(relative(stem)){join(base,sizeof base,tl_fact_root,"exec/facts");if(cx_fmt(leaf,sizeof leaf,"%s.tsv",stem))refuse("facts filename bound");join(path,sizeof path,base,leaf);TlEnvFactFile *file=tl_env_fact_file(path);if(file)for(int i=0;i<file->count;i++){TlEnvFactEntry *entry=&file->entries[i];if(!strcmp(entry->key,key)){if(!entry->value)entry->value=tl_json(entry->json);jfree(result);result=tl_env_copy(entry->value);}}}if(!end)break;a=end+1;}if(!result)result=tl_env_copy(tl_fact_array(facts,key));tl_env_cache=tl_grow(tl_env_cache,(size_t)(tl_ne+1)*sizeof *tl_env_cache);tl_env_cache[tl_ne++]=(TlFact){tl_dup(facts),tl_dup(key),result};return result;}
static jvalue *tl_env_path(jvalue *env,const char *facts,const char *path){if(*path=='$')path++;char key[1024];size_t n=strcspn(path,".[");if(!n||n>=sizeof key)return 0;if(mm_copy(key,sizeof key-1,path,n))refuse("environment key bound");key[n]=0;jvalue *v=tl_get(env,key);if(!v)v=tl_env_fact(facts,key);const char *p=path+n;while(v&&*p){if(*p!='.'&&*p!='[')return 0;char close=*p++=='['?']':0;n=strcspn(p,close?"]":".[");if(!n||n>=sizeof key)return 0;if(mm_copy(key,sizeof key-1,p,n))refuse("environment key bound");key[n]=0;p+=n;if(close){if(*p!=close)return 0;p++;}if(v->kind==J_ARR){const char *num=key;int k=number(&num);v=k>=0&&!*num&&(size_t)k<v->len?v->items[k]:0;}else v=tl_get(v,key);}return v;}
static char *tl_env_format(const char *text,jvalue *env,const char *facts){char out[4400];size_t n=0;while(*text){if(*text=='{'){const char *end=strchr(text+1,'}');if(!end)return 0;size_t k=(size_t)(end-text-1);char key[1024];if(!k||k>=sizeof key)return 0;if(mm_copy(key,sizeof key-1,text+1,k))refuse("environment key bound");key[k]=0;jvalue *v=tl_env_path(env,facts,key);if(!v||(v->kind!=J_STR&&v->kind!=J_NUM)||!v->s||strlen(v->s)!=v->slen)return 0;k=strlen(v->s);if(n+k>=sizeof out)refuse("environment format bound");if(mm_copy(out+n,sizeof out-n-1,v->s,k))refuse("environment format bound");n+=k;text=end+1;}else{if(n+1>=sizeof out)refuse("environment format bound");out[n++]=*text++;}}out[n]=0;return tl_dup(out);}
static jvalue *tl_env_cell(const char *text,jvalue *env,const char *facts){if(!strncmp(text,"@str:",5)||!strncmp(text,"@fmt:",5)){char *s=tl_env_format(text+5,env,facts);if(!s)return 0;jvalue *v=tl_text(s);free(s);return v;}if(!strncmp(text,"fresh:",6)||text[0]=='@')return 0;return tl_env_copy(tl_env_path(env,facts,text));}
static jvalue *tl_env_eval(jvalue *v,jvalue *env,const char *facts){if(v->kind==J_STR)return tl_env_cell(v->s,env,facts);jvalue *r=tl_value(v->kind);if(v->kind==J_OBJ){for(size_t i=0;i<v->nkeys;i++){jvalue *x=tl_env_eval(v->vals[i],env,facts);if(x)tl_env_put(r,v->keys[i],x);}}else if(v->kind==J_ARR){for(size_t i=0;i<v->len;i++){jvalue *x=tl_env_eval(v->items[i],env,facts);if(!x){jfree(r);return 0;}tl_append(r,x);}}else{jfree(r);r=tl_env_copy(v);}return r;}
static void tl_env_cells(jvalue *out,const char *cells,jvalue *env,const char *facts){const char *a=cells;while(*a&&strcmp(a,"-")){const char *end=strchr(a,',');size_t n=end?(size_t)(end-a):strlen(a);const char *eq=memchr(a,'=',n);if(eq){size_t k=(size_t)(eq-a),m=n-k-1;char key[1024],expr[4400];if(k>=sizeof key||m>=sizeof expr)refuse("environment binding bound");if(mm_copy(key,sizeof key-1,a,k))refuse("environment key bound");key[k]=0;if(mm_copy(expr,sizeof expr-1,eq+1,m))refuse("environment binding bound");expr[m]=0;jvalue *v=tl_env_cell(expr,env,facts);if(v)tl_env_put(out,key,v);else tl_env_put(out,key,tl_value(J_NULL));}if(!end)break;a=end+1;}}
static void tl_env_bindmap(jvalue *out,jvalue *map,jvalue *env,const char *facts){if(!map)return;if(map->kind==J_STR)tl_env_merge(out,tl_env_path(env,facts,map->s));else if(map->kind==J_ARR){for(size_t i=0;i<map->len;i++)tl_env_bindmap(out,map->items[i],env,facts);}else if(map->kind==J_OBJ){jvalue *v=tl_env_eval(map,env,facts);tl_env_merge(out,v);jfree(v);}}
/* 仅显式美元别名递归；格式化产出的美元引用同样解析，循环由深度界限拒绝证明。 */
static char *tl_env_name(const char *s,jvalue *env,const char *facts){char *name=0;for(int depth=0;depth<64;depth++){if(*s=='$'){jvalue *v=tl_env_path(env,facts,s);if(!v||v->kind!=J_STR||strlen(v->s)!=v->slen){free(name);return 0;}char *next=tl_dup(v->s);free(name);name=next;}else{if(!strncmp(s,"@str:",5)||!strncmp(s,"@fmt:",5))s+=5;char *next=tl_env_format(s,env,facts);free(name);name=next;if(!name)return 0;}if(*name!='$')return name;s=name;}free(name);return 0;}
static void tl_env_candidate(const char *scope,const char *file,int line,const char *s,jvalue *env,const char *facts){char *name=tl_env_name(s,env,facts);if(name){tl_possible_add(scope,name,file,line,"finite call/let/template environment; installation conditions, mode, fallback and edit prerequisites not proved");free(name);}}
static void tl_env_template(const char *scope,const char *file,int line,char **v,jvalue *env,const char *facts){jvalue *contexts=strcmp(v[2],"-")?tl_env_path(env,facts,v[2]):0;size_t nc=!strcmp(v[2],"-")?1:contexts&&contexts->kind==J_ARR?contexts->len:0;int dest=0;if(!strcmp(v[4],"rule")||!strcmp(v[4],"rule:b")||!strcmp(v[4],"rule:r")||!strcmp(v[4],"copy")||!strcmp(v[4],"alias")||!strcmp(v[4],"label")||!strcmp(v[4],"fill-edge"))dest=5;else if(!strcmp(v[4],"move-state")||!strcmp(v[4],"move")||!strcmp(v[4],"copy-state")||!strcmp(v[4],"copy-replace")||!strcmp(v[4],"clone-push"))dest=6;for(size_t ci=0;dest&&ci<nc;ci++){jvalue *base=tl_env_scope(env);if(contexts)tl_env_put(base,v[2],tl_env_copy(contexts->items[ci]));jvalue *array=strcmp(v[3],"-")?tl_env_path(base,facts,v[3]):0;size_t count=!strcmp(v[3],"-")?1:array&&array->kind==J_ARR?array->len:0;for(size_t i=0;i<count;i++){jvalue *item=tl_env_scope(base);if(array)tl_env_put(item,v[3],tl_env_copy(array->items[i]));tl_env_candidate(scope,file,line,v[dest],item,facts);if(!strcmp(v[4],"clone-push"))tl_env_candidate(scope,file,line,v[8],item,facts);jfree(item);}jfree(base);}}
/* 冻结输入只缓存解析材料；每个调用仍在自己的环境中枚举全部候选。 */
typedef struct {char *v[9];int cols,line;} TlEnvSourceRow;
typedef struct TlEnvSource {char *path,*text;TlEnvSourceRow *rows;int count,capacity;struct TlEnvSource *next;} TlEnvSource;
static TlEnvSource *tl_env_sources;
static TlEnvSource *tl_env_source_rows(const char *path){for(TlEnvSource *p=tl_env_sources;p;p=p->next)if(!strcmp(p->path,path))return p;if(!exists(path))return 0;TlEnvSource *p=tl_grow(0,sizeof *p);*p=(TlEnvSource){0};p->path=tl_dup(path);p->text=load(path);char *a=p->text;int line=0;while(*a){char *z=lineend(a);line++;if(*a&&*a!='#'){if(p->count==p->capacity){p->capacity=p->capacity?p->capacity*2:64;p->rows=tl_grow(p->rows,(size_t)p->capacity*sizeof *p->rows);}TlEnvSourceRow *r=&p->rows[p->count++];r->line=line;r->cols=fields(a,r->v,9);if(r->cols==4){for(int k=4;k>0;k--)r->v[k]=r->v[k-1];r->v[0]="-";r->cols=5;}}if(!z)break;a=z+1;}p->next=tl_env_sources;tl_env_sources=p;return p;}
static void tl_env_source(const char *dir,const char *scope,const char *stem,const char *section,int kind,jvalue *env,const char *facts){const char *suffixes[]={"-byte.tsv","-result.tsv","-template.tsv",""};int first=kind==1?2:kind==2?3:0,last=kind==0?2:first+1;for(int si=first;si<last;si++){char leaf[4400],path[4400];if(cx_fmt(leaf,sizeof leaf,"%s%s",stem,suffixes[si]))refuse("environment source bound");if(!relative(leaf))continue;join(path,sizeof path,dir,leaf);TlEnvSource *p=tl_env_source_rows(path);if(!p)continue;for(int i=0;i<p->count;i++){TlEnvSourceRow *r=&p->rows[i];char **v=r->v;int n=r->cols;if((n==5||n==9)&&(!strcmp(section,"-")||!strcmp(v[0],"-")||!strcmp(section,v[0]))){if(n==9&&kind==1)tl_env_template(scope,leaf,r->line,v,env,facts);else if(n==5)tl_env_candidate(scope,leaf,r->line,v[1],env,facts);}}}}
typedef struct {char *v[9];int depth,line; jvalue *opts;} TlEnvRow;
typedef struct TlEnvManifest {char *path,*text;TlEnvRow *rows;int count,capacity;struct TlEnvManifest *next;} TlEnvManifest;
static TlEnvManifest *tl_env_manifests;
static char *tl_env_stack[65];static unsigned tl_env_steps;
/* 三值条件只查询显式opts.flags；facts谓词与缺失标志一律未知。 */
static void tl_when_space(const char **p){while(**p==' '||**p=='\t')(*p)++;}
static int tl_when_or(const char **p,jvalue *flags,int depth);
static int tl_when_atom(const char **p,jvalue *flags,int depth){if(depth>64)return -1;tl_when_space(p);if(**p=='!'){(*p)++;int v=tl_when_atom(p,flags,depth+1);return v<0?-1:!v;}if(**p=='('){(*p)++;int v=tl_when_or(p,flags,depth+1);tl_when_space(p);if(**p!=')')return -1;(*p)++;return v;}const char *a=*p;while(**p&&!strchr("!&|() \t",**p))(*p)++;size_t n=(size_t)(*p-a);char key[1024];if(!n||n>=sizeof key)return -1;if(mm_copy(key,sizeof key,a,n))refuse("condition key bound");key[n]=0;jvalue *v=tl_get(flags,key);return v&&v->kind==J_BOOL?(v->slen?1:0):-1;}
static int tl_when_and(const char **p,jvalue *flags,int depth){int v=tl_when_atom(p,flags,depth);for(;;){tl_when_space(p);if(**p!='&')return v;(*p)++;if(**p=='&')(*p)++;int b=tl_when_atom(p,flags,depth);v=v==0||b==0?0:v<0||b<0?-1:1;}}
static int tl_when_or(const char **p,jvalue *flags,int depth){int v=tl_when_and(p,flags,depth);for(;;){tl_when_space(p);if(**p!='|')return v;(*p)++;if(**p=='|')(*p)++;int b=tl_when_and(p,flags,depth);v=v==1||b==1?1:v<0||b<0?-1:0;}}
static int tl_env_when(const char *when,jvalue *env){if(!*when||!strcmp(when,"-"))return 1;const char *p=when;int v=tl_when_or(&p,tl_get(env,"$flags"),0);tl_when_space(&p);return *p?-1:v;}
static void tl_env_manifest(const char *dir,const char *stage,const char *stem,jvalue *env,const char *inherited,int depth);
static void tl_env_block(TlEnvRow *r,int begin,int end,const char *dir,const char *stage,jvalue *env,const char *inherited,int depth){for(int i=begin;i<end;){if(++tl_env_steps>1000000)refuse("finite environment expansion bound");TlEnvRow *row=&r[i];int next=i+1;while(next<end&&r[next].depth>row->depth)next++;char **v=row->v;const char *facts=strcmp(v[4],"-")?v[4]:inherited;if(!row->opts)row->opts=strcmp(v[8],"-")?tl_json(v[8]):tl_value(J_OBJ);jvalue *opts=row->opts;if(opts->kind!=J_OBJ)refuse("manifest opts must be object");jvalue *with=tl_get(opts,"with"),*flags=tl_get(opts,"flags");jvalue *context=with||flags?tl_env_scope(env):tl_env_copy(env);tl_env_merge(context,with);if(flags&&flags->kind==J_OBJ){jvalue *known=tl_env_scope(tl_get(env,"$flags"));tl_env_merge(known,flags);tl_env_put(context,"$flags",known);}if(tl_env_when(v[3],context)==0){jfree(context);i=next;continue;}const char *op=v[0];if(!strcmp(op,"foreach")){jvalue *over=tl_get(opts,"over"),*as=tl_get(opts,"as");const char *alias=as&&as->kind==J_STR?as->s:"it";jvalue *array=over&&over->kind==J_STR?tl_env_path(context,facts,over->s):0;int keys=0;if(over&&over->kind==J_STR){size_t n=strlen(over->s);if(n&&over->s[n-1]=='!'){char *s=tl_dup(over->s);s[n-1]=0;jvalue *map=tl_env_path(context,facts,s);free(s);if(map&&map->kind==J_OBJ){array=map;keys=1;}}}size_t count=array?(keys?array->nkeys:array->kind==J_ARR?array->len:0):0;for(size_t ai=0;ai<count;ai++){jvalue *child=tl_env_scope(context);tl_env_put(child,alias,keys?tl_text(array->keys[ai]):tl_env_copy(array->items[ai]));jvalue *pre=tl_get(opts,"pre");if(pre&&pre->kind==J_ARR)for(size_t pi=0;pi<pre->len;pi++){jvalue *p=pre->items[pi];if(p->kind==J_ARR&&p->len==2&&p->items[0]->kind==J_STR&&p->items[1]->kind==J_STR){jvalue *x=tl_env_cell(p->items[1]->s,child,facts);if(x)tl_env_put(child,p->items[0]->s,x);}}tl_env_block(r,i+1,next,dir,stage,child,facts,depth);jfree(child);}}else{jvalue *local=tl_env_scope(context),*let=tl_get(opts,"let");if(let){jvalue *x=tl_env_eval(let,context,facts);tl_env_merge(local,x);jfree(x);}if(!strcmp(op,"let")){tl_env_bindmap(local,tl_get(opts,"bindmap"),local,facts);tl_env_cells(local,v[7],local,facts);tl_env_merge(env,local);}else if(!strcmp(op,"call")){tl_env_bindmap(local,tl_get(opts,"bindmap"),local,facts);tl_env_cells(local,v[7],local,facts);char *name=tl_env_name(v[1],local,facts);char cd[4400],cs[4400];if(name&&!dynamic(name)&&tl_call(dir,name,cd,sizeof cd,cs,sizeof cs))tl_env_manifest(cd,stage,cs,local,facts,depth+1);free(name);}else if(!strcmp(op,"rows")||!strcmp(op,"table")||!strcmp(op,"template")){tl_env_bindmap(local,tl_get(opts,"bindmap"),local,facts);tl_env_cells(local,v[7],local,facts);char *stem=tl_env_name(v[1],local,facts),*section=tl_env_name(v[2],local,facts);if(stem&&section&&!dynamic(section))tl_env_source(dir,stage,stem,section,!strcmp(op,"template")?1:!strcmp(op,"table")?2:0,local,facts);free(stem);free(section);}if(next>i+1)tl_env_block(r,i+1,next,dir,stage,local,facts,depth);jfree(local);}jfree(context);i=next;}}
static void tl_env_manifest(const char *dir,const char *stage,const char *stem,jvalue *env,const char *inherited,int depth){if(depth>64)refuse("manifest recursion bound");char leaf[4400],path[4400];if(cx_fmt(leaf,sizeof leaf,"%s-manifest.tsv",stem))refuse("manifest name bound");join(path,sizeof path,dir,leaf);for(int i=0;i<depth;i++)if(!strcmp(tl_env_stack[i],path))return;TlEnvManifest *cached=tl_env_manifests;while(cached&&strcmp(cached->path,path))cached=cached->next;if(!cached){if(!exists(path))return;cached=tl_grow(0,sizeof *cached);*cached=(TlEnvManifest){0};cached->path=tl_dup(path);char *text=load(path),*a=text;cached->text=text;TlEnvRow *r=0;int count=0,line=0;while(*a){char *z=lineend(a);line++;if(*a&&*a!='#'){if(count==cached->capacity){cached->capacity=cached->capacity?cached->capacity*2:64;r=tl_grow(r,(size_t)cached->capacity*sizeof *r);}TlEnvRow *row=&r[count++];row->line=line;row->opts=0;int n=fields(a,row->v,9);while(n<9)row->v[n++]="-";row->depth=0;while(*row->v[0]=='.'){row->v[0]++;row->depth++;}if(row->depth>=64)refuse("manifest nesting bound");}if(!z)break;a=z+1;}cached->rows=r;cached->count=count;cached->next=tl_env_manifests;tl_env_manifests=cached;}tl_env_stack[depth]=tl_dup(path);tl_env_block(cached->rows,0,cached->count,dir,stage,env,inherited,depth);free(tl_env_stack[depth]);tl_env_stack[depth]=0;}
static void manifest(const char *dir,const char *stage,const char *stem,int depth){if(depth>64)refuse("manifest recursion bound");char leaf[4400],p[4400];if(cx_fmt(leaf,sizeof leaf,"%s-manifest.tsv",stem))refuse("manifest name bound");join(p,sizeof p,dir,leaf);char visit[8800];if(cx_fmt(visit,sizeof visit,"%s\t%s",stage,p))refuse("manifest visit key bound");for(int i=0;i<nv;i++)if(!strcmp(visited[i],visit))return;visited=tl_grow(visited,(size_t)(nv+1)*sizeof *visited);visited[nv++]=tl_dup(visit);if(!exists(p)){unknown(stage,leaf,0,"-","manifest call target is absent; cannot establish full assembly");return;}char *s=load(p),*a=s;int line=0;char *overs[64]={0},*aliases[64]={0};while(*a){line++;tl_at(p,line);char *z=lineend(a);if(*a&&*a!='#'){char *v[9];int cols=fields(a,v,9);while(cols<9)v[cols++]="-";char *op=v[0];int nesting=0;while(*op=='.'){op++;nesting++;}if(nesting>=64)refuse("manifest nesting bound");for(int d=nesting;d<64;d++){free(overs[d]);free(aliases[d]);overs[d]=0;aliases[d]=0;}jvalue *o=0;if(strcmp(v[8],"-")){o=tl_json(v[8]);if(o->kind!=J_OBJ)refuse("manifest opts must be object");}if(!strcmp(op,"foreach")){jvalue *over=o?tl_get(o,"over"):0,*alias=o?tl_get(o,"as"):0;if(over&&over->kind==J_STR){overs[nesting]=tl_dup(over->s);aliases[nesting]=tl_dup(alias&&alias->kind==J_STR?alias->s:"it");}}else if(!strcmp(op,"call")){char cd[4400],cs[4400];if(dynamic(v[1]))unknown(stage,leaf,line,v[1],"dynamic manifest call");else if(tl_call(dir,v[1],cd,sizeof cd,cs,sizeof cs))manifest(cd,stage,cs,depth+1);else refuse("manifest call directory must resolve inside ROOT");}else if(!strcmp(op,"rows")||!strcmp(op,"table")||!strcmp(op,"template")){int mode=0;jvalue *m=o?tl_get(o,"mode"):0;if(m){if(m->kind!=J_STR||strlen(m->s)!=1||(m->s[0]!='b'&&m->s[0]!='r'&&m->s[0]!='t'))refuse("manifest mode");mode=m->s[0];}int kind=!strcmp(op,"template")?1:!strcmp(op,"table")?2:0;if(kind==2&&!mode)mode='r';install(stage,v[1],v[2],v[7],v[8],mode,kind);Install *installed=&inst[ni-1];installed->dir=tl_dup(dir);jvalue *bm=o?tl_get(o,"bindmap"):0;if(bm&&bm->kind==J_OBJ){for(size_t bi=0;bi<bm->nkeys;bi++){jvalue *bv=bm->vals[bi];if(bv->kind!=J_STR||strncmp(bv->s,"@str:",5)||dynamic(bv->s)||strchr(bv->s,','))continue;size_t bn=strlen(installed->bind)+strlen(bm->keys[bi])+strlen(bv->s)+3;char *bb=tl_grow(0,bn);if(cx_fmt(bb,bn,"%s=%s,%s",bm->keys[bi],bv->s,installed->bind))refuse("bindmap bound");free(installed->bind);installed->bind=bb;}}free(installed->facts);installed->facts=tl_dup(v[4]);for(int d=nesting-1;d>=0;d--)if(overs[d]){free(installed->over);free(installed->alias);installed->over=tl_dup(overs[d]);installed->alias=tl_dup(aliases[d]);break;}jvalue *skip=o?tl_get(o,"skip"):0;if(skip&&skip->kind==J_ARR)for(size_t i=0;i<skip->len;i++)if(skip->items[i]->kind==J_STR)addpolicy(stage,skip->items[i]->s,"no-fallback","manifest skip: installation intentionally excludes this state/domain");if(o&&(tl_get(o,"domain_at")||tl_get(o,"tmodes")||tl_get(o,"domain_keys")))unknown(stage,leaf,line,v[1],"domain_at/domain_keys/tmodes requires facts; affected rows retain UNRESOLVED classification");}if(o)jfree(o);}if(!z)break;a=z+1;}for(int d=0;d<64;d++){free(overs[d]);free(aliases[d]);}free(s);}
static int cmpnames(const void *a,const void *b){return strcmp(*(char *const *)a,*(char *const *)b);}
static void scan(const char *root,const char *sub){tl_fact_root=root;char initial[4400],canonical[4400];join(initial,sizeof initial,root,sub);if(!realpath(initial,canonical))refuse(initial);jvalue *env=tl_value(J_OBJ);tl_env_manifest(canonical,sub,"gen",env,"-",0);jfree(env);manifest(canonical,sub,"gen",0);if(!strcmp(sub,"exec/pp")){install(sub,"start","-","-","-",'b',0);inst[ni-1].dir=tl_dup(canonical);}char **dirs=0;int nd=0;for(int j=0;j<ni;j++){if(strcmp(inst[j].stage,sub)||!inst[j].dir)continue;int seen=0;for(int k=0;k<nd;k++)if(!strcmp(dirs[k],inst[j].dir))seen=1;if(!seen){dirs=tl_grow(dirs,(size_t)(nd+1)*sizeof *dirs);dirs[nd++]=inst[j].dir;}}int tables=0;for(int di=0;di<nd;di++){const char *dir=dirs[di];tl_table_dir=dir;DIR *d=opendir(dir);if(!d)refuse(dir);char **names=0;int n=0;struct dirent *e;while((e=readdir(d))){size_t k=strlen(e->d_name);if(k>4&&!strcmp(e->d_name+k-4,".tsv")){names=tl_grow(names,(size_t)(n+1)*sizeof *names);names[n++]=tl_dup(e->d_name);}}if(closedir(d))refuse("closedir");qsort(names,(size_t)n,sizeof *names,cmpnames);for(int i=0;i<n;i++){const char *name=names[i];char p[4400];join(p,sizeof p,dir,name);char *s=load(p),*a=s;files++;while(*a){char *z=lineend(a);if(*a&&*a!='#')rows++;if(!z)break;a=z+1;}free(s);int mode=0,selected=0;for(int j=0;j<ni;j++)if(tl_install_file(&inst[j],sub,name)){selected=1;mode=inst[j].mode;if(!mode){size_t k=strlen(name);mode=k>=9&&!strcmp(name+k-9,"-byte.tsv")?'b':'r';}break;}if(selected){table(dir,name,sub,mode,1);tables++;}else if(audit)finding(0,"inventory",sub,name,0,"-","not a transition source selected by the manifest call closure");free(names[i]);}free(names);}free(dirs);tl_table_dir=0;if(!tables)refuse("no installed transition tables");}
int main(int argc,char **argv){const char *root=".",*cas=0;int hasroot=0;for(int i=1;i<argc;i++){if(!strcmp(argv[i],"--errors-only"))errors_only=1;else if(!strcmp(argv[i],"--audit"))audit=1;else if(!strcmp(argv[i],"--root")&&i+1<argc){root=argv[++i];hasroot=1;}else if(!strcmp(argv[i],"--case")&&i+1<argc)cas=argv[++i];else if(!strcmp(argv[i],"--limit")&&i+1<argc){const char *s=argv[++i];long v=0;if(!*s)refuse("limit");for(;*s;s++){if(*s<'0'||*s>'9'||v>100000)refuse("limit");v=v*10+*s-'0';}limit=(int)v;}else refuse("usage: [--root ROOT | --case DIR] [--limit N] [--audit] [--errors-only]");}fixture=cas!=0;if(cas){if(hasroot)refuse("root and case are exclusive");policies(cas,"policy.tsv");case_manifest(cas);}else{char pd[4400];join(pd,sizeof pd,root,"tools");policies(pd,"table-lint-policy.tsv");scan(root,"exec/pp");scan(root,"exec/parse2");}
for(int i=0;i<ns;i++){State *s=&states[i];int complete=1;for(int k=s->lo;k<s->hi;k++)if(!s->keys[k]){complete=0;break;}checked++;const char *why=policy(s->scope,s->name,"no-fallback");if(s->lo==0&&s->hi==256)finding(0,"eof-domain",s->scope,s->file,s->line,s->name,"manifest domain [0,256) intentionally leaves EOF outside dispatch domain");if(!s->star&&!complete&&!why){if(s->unknown)unknown(s->scope,s->file,s->line,s->name,"fallback domain depends on facts/dynamic observation; not proved total");else finding(1,"missing-fallback",s->scope,s->file,s->line,s->name,"outgoing state lacks * and does not explicitly cover manifest domain; no reasoned no-fallback policy");}else if(audit&&why)finding(0,"policy",s->scope,s->file,s->line,s->name,why);}
for(int i=0;i<nr;i++){Ref *r=&refs[i];int builtin=!strcmp(r->to,"RET")||(!r->push&&(!strcmp(r->to,"HALT")||!strcmp(r->to,"DEAD")));if(r->dynamic||!strcmp(r->to,"BOT")){unknown(r->scope,r->file,r->line,r->to,"target is dynamically bound; state definition not statically proved");continue;}if(!builtin&&stateid(r->scope,r->to)<0&&!policy(r->scope,r->to,"external")){const char *possible=tl_possible_definition(r->scope,r->to);if(possible)unknown(r->scope,r->file,r->line,r->to,possible);else finding(1,"undefined-state",r->scope,r->file,r->line,r->to,r->push?"PUSH target has no installed state definition":"next target has no installed state definition");}}
if(printf("TABLE_LINT\tfiles=%d\trows=%d\terrors=%d\twarnings=%d\tstates=%d\tchecked=%d\tunresolved=%d\tstatus=%s\n",files,rows,errors,warnings,ns,checked,unresolved,errors?"ERROR":unresolved?"PARTIAL":"STATIC_OK")<0||fflush(stdout))refuse("stdout");return errors?1:0;}
