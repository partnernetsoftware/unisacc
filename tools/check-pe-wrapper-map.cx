/* Independent small PE64 and standard VERSIONINFO fixture, not an ape-pack run. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use sys.env
#pragma unisa use sysx.process
#pragma unisa use mem.bytes
static unsigned char bare[1536],wrapped[4096],res[1024];static long rp;static int checks,failed;
static void die(void){fprintf(stderr,"PE wrapper fixture IO\n");exit(2);}
static void p16(unsigned char *p,long n){p[0]=n;p[1]=n>>8;}
static void p32(unsigned char *p,long n){for(int i=0;i<4;i++)p[i]=n>>(8*i);}
static void key(const char *s){while(*s){res[rp++]=*s++;res[rp++]=0;}res[rp++]=0;res[rp++]=0;}
static void pad(void){while(rp%4)res[rp++]=0;}
static long begin(const char *s,int type,int vn){long a=rp;rp+=6;p16(res+a+2,vn);p16(res+a+4,type);key(s);pad();return a;}
static void end(long at){p16(res+at,rp-at);}
static void txt(const char *k,const char *v){long a=begin(k,1,strlen(v)+1);key(v);end(a);}
static void fixture(int mode){
 memset(bare,0,sizeof bare);memset(wrapped,0,sizeof wrapped);memset(res,0,sizeof res);bare[0]='M';bare[1]='Z';p32(bare+60,64);mm_copy(bare+64, 4, "PE\0\0", 4);p16(bare+68,0x8664);p16(bare+70,1);p16(bare+84,240);p16(bare+88,0x20b);p32(bare+120,4096);p32(bare+124,512);p32(bare+144,8192);p32(bare+148,1024);p32(bare+196,16);unsigned char *s=bare+328;mm_copy(s, 5, ".text", 5);p32(s+8,3);p32(s+12,4096);p32(s+16,512);p32(s+20,1024);p32(s+36,0x60000020);bare[1024]=0x90;bare[1025]=0x90;bare[1026]=0xc3;
 /* Stub PE begins at512; its required geometry leaves SizeOfHeaders1024. */
 wrapped[0]='M';wrapped[1]='Z';p32(wrapped+60,512);mm_copy(wrapped+512, 304, bare+64, 304);mm_copy(wrapped+1024, 512, bare+1024, 512);long oo=536,rs=816;
 rp=88;long top=begin("VS_VERSION_INFO",0,52);long fixed=rp;rp+=52;long vals[13]={0xfeef04bdUL,65536,65538,196608,65538,196608,63,0,0x40004,1,0,0,0};for(int i=0;i<13;i++)p32(res+fixed+4*i,vals[i]);long sf=begin("StringFileInfo",1,0),table=begin("040904B0",1,0);txt("ProductName","Fixture");pad();txt("ProductVersion","1.2.3");pad();txt("FileDescription","Fixture");pad();txt("FileVersion","1.2.3");end(table);end(sf);pad();long vf=begin("VarFileInfo",1,0),tr=begin("Translation",0,4);p32(res+rp,0x04b00409);rp+=4;end(tr);end(vf);end(top);
 res[14]=1;res[16]=16;res[20]=24;res[23]=128;res[38]=1;res[40]=1;res[44]=48;res[47]=128;res[62]=1;res[64]=9;res[65]=4;res[68]=72;p32(res+72,8192+88);p32(res+76,rp-88);p32(res+80,1200);
 long rawsize=(rp+511)/512*512;p16(wrapped+518,2);p32(wrapped+oo+8,rawsize);p32(wrapped+oo+56,12288);p32(wrapped+oo+128,8192);p32(wrapped+oo+132,rp);mm_copy(wrapped+rs, 5, ".rsrc", 5);p32(wrapped+rs+8,rp);p32(wrapped+rs+12,8192);p32(wrapped+rs+16,rawsize);p32(wrapped+rs+20,1536);p32(wrapped+rs+36,0x40000040);mm_copy(wrapped+1536, rp, res, rp);
 if(mode==1)wrapped[1024]^=1;if(mode==2)p32(wrapped+788,8192);if(mode==3)p32(wrapped+796,1536);if(mode==4)wrapped[1536+16]=17;if(mode==5)wrapped[1536+fixed]^=1;if(mode==6)wrapped[oo+16]^=1;if(mode==7)p32(wrapped+oo+60,1536);if(mode==8)wrapped[1536+rp]=1;if(mode==9)p32(wrapped+rs+16,rawsize+512);if(mode==10)wrapped[1536+rp-1]^=1;
 if(mode==11){unsigned char old[4096];mm_copy(old, sizeof old, wrapped, sizeof old);memset(wrapped,0,sizeof wrapped);wrapped[0]='M';wrapped[1]='Z';p32(wrapped+60,1024);mm_copy(wrapped+1024, 344, old+512, 344);p32(wrapped+1048+60,1536);p32(wrapped+1308,1536);p32(wrapped+1348,2048);mm_copy(wrapped+1536, 512, old+1024, 512);mm_copy(wrapped+2048, 512, old+1536, 512);mm_copy(wrapped+2560, 7, "PAYLOAD", 7);}
}
int main(int argc,char **argv){int mapmode=argc==2&&!strcmp(argv[1],"--module-map-checks");if(argc!=1&&!mapmode)die();char root[4096],base[8192],com[8192],tool[8192],bp[8192],op[8192];if(!realpath(".",root)||cx_fmt(base,sizeof base,"%s/pe-wrapper-check-XXXXXX",sy_tmpdir())||!mkdtemp(base)||cx_fmt(com,sizeof com,"%s/unisacc.com",root)||cx_fmt(tool,sizeof tool,"%s/tools/pe-wrapper-map.cx",root)||cx_fmt(bp,sizeof bp,"%s/bare.exe",base)||cx_fmt(op,sizeof op,"%s/wrapper.com",base))die();
 if(mapmode){char mp[8192];if(cx_fmt(mp,sizeof mp,"%s/map.tsv",base))die();const char *labels[]={"module counts preserved and prefix conserved","map image SHA","map total","map header bytes","code outside text","map record count","map trailing identity"};for(int i=0;i<7;i++){fixture(11);if(cx_write(bp,bare,sizeof bare)||cx_write(op,wrapped,2567))die();char h[65],z[65];if(sy_sha256_hex(bare,sizeof bare,h)&&cx_sha256_hex(bare,sizeof bare,h))die();memset(z,'a',64);z[64]=0;char map[4096];int n=snprintf(map,sizeof map,"MODULE_BYTE_ID\torigin_sha=%s\tmerged_sha=%s\trows_sha=%s\tepisodes_sha=%s\trecords_sha=%s\timage_sha=%s\tclaim=emitter-context-not-exclusive-ownership\nMODULE\tfixture.cx\tbytes=%d\trecords=1\tunit=0\nUNKNOWN\tbytes=1\trecords=1\nSHARED\tbytes=0\trecords=0\nSYNTHETIC\tbytes=1\trecords=1\nOTHER\tHEADER\tbytes=%d\nOTHER\tDATA_OR_ALIGN\tbytes=%d\nMODULE_BYTE_MAP\timage_bytes=%d\taccounted_bytes=1536\trecords=%d\tzero_records=INCLUDED\tstate=CONSERVED\n%s",z,z,z,z,z,i==1?z:h,i==4?2:1,i==3?1023:1024,i==4?508:509,i==2?1535:1536,i==5?4:3,i==6?"EXTRA\n":"");if(cx_write(mp,map,n))die();char *v[]={"sh",com,tool,"--",bp,op,"--module-map",mp,0};np_result r={0};char why[300]={0};int tr=np_run(v,root,0,8,&r,why,sizeof why);int yes=!tr&&!r.residue&&r.rc==(i?2:0);if(!i)yes=yes&&r.out&&strstr(r.out,"image_scope=outer-pe-prefix")&&strstr(r.out,"MODULE\tfixture.cx\tbytes=1\trecords=1\tunit=0")&&strstr(r.out,"OTHER\tHEADER\tbytes=1536\nOTHER\tDATA_OR_ALIGN\tbytes=509\nOTHER\tRESOURCE\tbytes=512")&&strstr(r.out,"MODULE_BYTE_MAP\timage_bytes=2560\taccounted_bytes=2560\trecords=3");else yes=yes&&!r.outn;checks++;failed+=!yes;printf("%s\t%s\n",yes?"PASS":"FAIL",labels[i]);if(!yes)fprintf(stderr,"mapcase%d tr%d rc%d %s %s\n",i,tr,r.rc,why,r.err?r.err:"");np_free(&r);}printf("PE_WRAPPER_MODULE_CHECK\tchecks=%d\tfailed=%d\n",checks,failed);return failed?1:0;}
 const char *labels[]={"standard independent PE resource and exact body","body mutation","section RVA mutation","section raw pointer mutation","resource tree mutation","fixed version mutation","unexplained optional field","wrong header geometry","resource padding","resource extent","translation mutation","nonzero delta and opaque APE tail"};
 for(int i=0;i<12;i++){fixture(i);if(cx_write(bp,bare,sizeof bare)||cx_write(op,wrapped,i==11?2567:2048))die();char *v[]={"sh",com,tool,"--",bp,op,0};np_result r={0};char why[300]={0};int tr=np_run(v,root,0,8,&r,why,sizeof why);int yes=!tr&&!r.residue&&r.rc==((i&&i!=11)?2:0);if(!i)yes=yes&&r.out&&strstr(r.out,"pe_extent=2048\tdelta=0")&&strstr(r.out,"BODY\told_lo=1024\told_hi=1536\tnew_lo=1024\tnew_hi=1536\tdelta=0")&&strstr(r.out,"preserved_body_bytes=512\tother_bytes=1536\tproduct_bytes=2048");else if(i==11)yes=yes&&r.out&&strstr(r.out,"pe_extent=2560\tdelta=512")&&strstr(r.out,"preserved_body_bytes=512\tother_bytes=2055\tproduct_bytes=2567");else yes=yes&&!r.outn;checks++;failed+=!yes;printf("%s\t%s\n",yes?"PASS":"FAIL",labels[i]);if(!yes)fprintf(stderr,"case%d tr%d rc%d %s %s\n",i,tr,r.rc,why,r.err?r.err:"");np_free(&r);}
 printf("PE_WRAPPER_CHECK\tchecks=%d\tfailed=%d\n",checks,failed);return failed?1:0;}
