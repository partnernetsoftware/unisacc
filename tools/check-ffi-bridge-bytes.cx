/* tools/check-ffi-bridge-bytes.cx -- the generator writes, --check passes, and a tampered table fails.
 *   sh ./unisacc.com tools/check-ffi-bridge-bytes.cx
 * Uses a self-built fixture in a /tmp mkdtemp scratch, so it neither reads include/ nor writes out/.
 * (that comparison against include/ lands with the epoch merge.) */
#pragma unisa use sys.fs
#pragma unisa use sys.env
#pragma unisa use sys.io
#pragma unisa use sys.proc
#pragma unisa use text.text

/* sy_run with a bound: ARGV runs under cx_runv_timeout (SECS, process group killed on expiry), stdout and stderr
   merged into OUT (CAP, NUL-terminated, *CUT set when it did not fit; CUT may be 0). */
static int bounded_run(char **argv, int secs, char *out, int cap, int *cut) {
    char *w[64], *b = 0;
    size_t n = 0, j;
    int k = 0, i, rc;
    if (cut) *cut = 0;
    if (!argv) return -EINVAL;
    w[k++] = "sh"; w[k++] = "-c"; w[k++] = "exec \"$@\" 2>&1"; w[k++] = "sh";
    for (i = 0; argv[i] && k < 63; i++) w[k++] = argv[i];
    if (argv[i]) return -E2BIG;
    w[k] = 0;
    rc = cx_runv_timeout(w, secs, &b, &n);
    if (cap > 0) {
        if (n > (size_t)cap - 1) { n = (size_t)cap - 1; if (cut) *cut = 1; }
        for (j = 0; b && j < n; j++) out[j] = b[j];
        out[b ? n : 0] = 0;
    }
    free(b);
    return rc;
}
static int assertions, failed;
static void ok(int c, const char *n) { assertions++; if (!c) failed++; printf("%s\t%s\n", c ? "PASS" : "FAIL", n); }
int main(void) {
    char root[4400], raw[4400], hdr[4400], gen[4400], out[512], scratch[4400];
    int rc;
    if (sy_cwd(root, sizeof root) < 0) return 2;
    if (cx_fmt(scratch, sizeof scratch, "/tmp/ffi-bytes-XXXXXX") || !mkdtemp(scratch)) return 2;
    if (cx_fmt(raw, sizeof raw, "%s/raw.bin", scratch) ||
        cx_fmt(hdr, sizeof hdr, "%s/table.h", scratch) ||
        cx_fmt(gen, sizeof gen, "%s/tools/gen-ffi-bridge.cx", root)) return 2;
    {   /* self-contained fixture: the generator is about bytes, not about a real .text */
        unsigned char fx[16]; int i;
        for (i = 0; i < 16; i++) fx[i] = (unsigned char)(0x40 + i);
        if (cx_write(raw, fx, 16)) return 2;
    }
    {   char *av[] = { "sh", "unisacc.com", gen, "--", "x86_64", raw, hdr, 0 };
        out[0] = 0; rc = bounded_run(av, 50, out, (int)sizeof out, 0);
        ok(rc == 0 && tx_find(out, (long)strlen(out), "WROTE", 5) >= 0, "generate-writes"); }
    {   char *av[] = { "sh", "unisacc.com", gen, "--", "--check", "x86_64", raw, hdr, 0 };
        out[0] = 0; rc = bounded_run(av, 50, out, (int)sizeof out, 0);
        ok(rc == 0 && tx_find(out, (long)strlen(out), "CHECK OK", (long)sizeof("CHECK OK") - 1) >= 0, "check-passes"); }
    {   size_t n = 0; char *b = cx_read(hdr, &n);
        ok(b != 0 && n > 8, "table-nonempty");
        if (b) { b[n - 1] = ' '; cx_write(hdr, b, n); free(b); }
        {   char *av[] = { "sh", "unisacc.com", gen, "--", "--check", "x86_64", raw, hdr, 0 };
            out[0] = 0; rc = bounded_run(av, 50, out, (int)sizeof out, 0);
            ok(rc != 0, "tampered-fails"); } }
    /* 只删自己建的文件，再删本次的独占目录：不用通配符，也不碰别人的东西。 */
    {   int left = 0;
        left += sy_unlink(raw) != 0;
        left += sy_unlink(hdr) != 0;
        left += sy_rmdir(scratch) != 0;
        ok(left == 0, "scratch-removed"); }
    printf("FFI_BYTES\tassertions=%d\tfailed=%d\n", assertions, failed);
    return failed ? 1 : 0;
}
