/* tools/stray-link-watch.cx -- bounded trap for stray self links such as cx/cx.
 * Usage:
 *   sh ./unisacc.com tools/stray-link-watch.cx -- --once [--root DIR] [--log FILE]
 *   sh ./unisacc.com tools/stray-link-watch.cx -- --daemon DEADLINE_S [--root DIR] [--log FILE]
 * Scans ROOT (default: current directory) and every ROOT/.claude/worktrees/* for D/D being a symbolic link,
 * D in cx tools tests src ext include exec.  On a hit it appends to LOG (default
 * $CLAUDE_JOB_DIR/tmp/stray-link-watch/events.log, else /tmp/stray-link-watch/events.log): time, path, link
 * target, lstat mtime, a full `ps -eo pid,ppid,pgid,etimes,user,args` snapshot and /proc/PID/cwd of every ln,
 * sh -c and unisacc.com process; then removes only that symbolic link (lstat re-checked right before unlink,
 * never a directory, never recursive).  --daemon polls every 2 seconds and exits by itself at DEADLINE_S
 * (1..86400).  Prints STRAY_LINK_EVENT lines and ends with STRAY_LINK_WATCH<TAB>events=N<TAB>removed=M. */
#pragma unisa use cxlib.ckrun
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.env
#pragma unisa use sys.time
#pragma unisa use text.text

#define SLW_PW 4400
#define SLW_SNAP (1 << 20)

static const char *slw_dirs[] = {"cx", "tools", "tests", "src", "ext", "include", "exec", 0};
static char slw_log[SLW_PW];
static int slw_events, slw_removed;
static char slw_snap[SLW_SNAP];

static void slw_append(const char *s) { (void)sy_append_file(slw_log, s, (int64_t)strlen(s), 0600); }

static void slw_hit(const char *top, const char *d, const char *link) {
    char tgt[SLW_PW], line[SLW_PW * 3];
    sy_stat_t st;
    long k = sy_readlink(link, tgt, sizeof tgt - 1);
    if (k < 0) k = 0;
    tgt[k] = 0;
    if (sy_lstat(link, &st) != 0 || st.kind != 'l') return;
    slw_events++;
    if (cx_fmt(line, sizeof line, "=== EVENT now_ms=%ld top=%s dir=%s link=%s target=%s lstat_mtime=%ld\n",
               sy_now_ms(), top, d, link, tgt, st.mtime)) return;
    slw_append(line);
    slw_snap[0] = 0;
    (void)ckk_sh_t("stray-link-watch",
        "ps -eo pid,ppid,pgid,etimes,user,args; echo '--- suspect cwd'; "
        "for p in $(ps -eo pid=,args= | grep -E ' ln |^ *[0-9]+ ln|sh -c|unisacc.com' | grep -v grep | while read a b; do echo $a; done); do "
        "printf '%s cwd=%s\\n' \"$p\" \"$(readlink /proc/$p/cwd 2>/dev/null)\"; done",
        slw_snap, sizeof slw_snap, 20);
    slw_append(slw_snap);
    /* remove only this symbolic link: re-check it is still a link named D inside directory D */
    if (sy_lstat(link, &st) == 0 && st.kind == 'l' && sy_unlink(link) == 0) {
        slw_removed++;
        slw_append("--- removed symbolic link only\n");
    } else {
        slw_append("--- NOT removed (changed or unlink failed)\n");
    }
    printf("STRAY_LINK_EVENT\t%s\ttarget=%s\n", link, tgt);
    fflush(stdout);
}

static void slw_scan_top(const char *top) {
    char dir[SLW_PW], link[SLW_PW];
    sy_stat_t st;
    for (int i = 0; slw_dirs[i]; i++) {
        if (cx_fmt(dir, sizeof dir, "%s/%s", top, slw_dirs[i])) continue;
        if (sy_lstat(dir, &st) != 0 || st.kind != 'd') continue;
        if (cx_fmt(link, sizeof link, "%s/%s", dir, slw_dirs[i])) continue;
        if (sy_lstat(link, &st) == 0 && st.kind == 'l') slw_hit(top, slw_dirs[i], link);
    }
}

static void slw_scan(const char *root) {
    char wt[SLW_PW], sub[SLW_PW];
    sy_dir_t d;
    slw_scan_top(root);
    if (cx_fmt(wt, sizeof wt, "%s/.claude/worktrees", root)) return;
    if (sy_dir_open(&d, wt) != 0) return;
    while (sy_dir_next(&d) == 1) {
        if (d.name[0] == '.') continue;
        if (cx_fmt(sub, sizeof sub, "%s/%s", wt, d.name)) continue;
        slw_scan_top(sub);
    }
    sy_dir_close(&d);
}

int main(int argc, char **argv) {
    char root[SLW_PW];
    long deadline = -1;
    int once = 0;
    if (!getcwd(root, sizeof root)) return 2;
    slw_log[0] = 0;
    for (int i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--once")) once = 1;
        else if (tx_eqz(argv[i], "--daemon") && i + 1 < argc) deadline = atol(argv[++i]);
        else if (tx_eqz(argv[i], "--root") && i + 1 < argc) { if (cx_fmt(root, sizeof root, "%s", argv[++i])) return 2; }
        else if (tx_eqz(argv[i], "--log") && i + 1 < argc) { if (cx_fmt(slw_log, sizeof slw_log, "%s", argv[++i])) return 2; }
        else { fprintf(stderr, "stray-link-watch: REFUSE usage: --once | --daemon DEADLINE_S [--root DIR] [--log FILE]\n"); return 2; }
    }
    if (once == (deadline >= 0) || (!once && (deadline < 1 || deadline > 86400))) {
        fprintf(stderr, "stray-link-watch: REFUSE usage: exactly one of --once or --daemon DEADLINE_S (1..86400)\n");
        return 2;
    }
    if (!slw_log[0]) {
        const char *jd = sy_env("CLAUDE_JOB_DIR");
        char dir[SLW_PW], cmd[SLW_PW * 2], o[256];
        if (cx_fmt(dir, sizeof dir, "/tmp/stray-link-watch")) return 2;
        if (jd && jd[0] == '/' && cx_fmt(dir, sizeof dir, "%s/tmp/stray-link-watch", jd)) return 2;
        if (cx_fmt(cmd, sizeof cmd, "mkdir -p '%s'", dir) || ckk_sh("stray-link-watch", cmd, o, sizeof o)) return 2;
        if (cx_fmt(slw_log, sizeof slw_log, "%s/events.log", dir)) return 2;
    }
    long end = sy_now_ms() + deadline * 1000;
    for (;;) {
        slw_scan(root);
        if (once || sy_now_ms() >= end) break;
        sy_sleep_ms(2000);
    }
    printf("STRAY_LINK_WATCH\troot=%s\tlog=%s\tevents=%d\tremoved=%d\n", root, slw_log, slw_events, slw_removed);
    return 0;
}
