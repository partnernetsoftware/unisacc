/* tools/install-ape.cx -- put a six-slice APE at ROOT/unisacc.com; the old launcher script stays as unisacc-dev.
 *
 *   sh ./unisacc.com tools/install-ape.cx -- ROOT APE SHA256 [--write]
 *   self-test: sh ./unisacc.com tools/check-install-ape.cx [-- ROOT [APE]]
 *
 * APE   the candidate file (a single file: launcher, slices, one package, a UNIPKG1 footer).
 * SHA256  the full expected sha256 of APE (64 hex).  A mismatch, a file without a UNIPKG1 footer, or a file that
 *         does not answer `--version` is refused by name; nothing under ROOT is touched.
 * Without --write it only reports (a dry run never writes).  With --write:
 *   1  ROOT/unisacc.com is copied to ROOT/unisacc-dev when that is still the launcher script (a shell script
 *      without a footer) and unisacc-dev does not exist yet; an existing unisacc-dev is kept as it is.
 *   2  the APE is copied to ROOT/.unisacc.com.install.<pid> (mode 0755), re-hashed, then renamed over
 *      ROOT/unisacc.com in one step; any failure removes the temporary file and leaves unisacc.com as it was.
 * The record of the source sha is ROOT/unisacc.com.ape.sha256 (one line "sha256<TAB>bytes<TAB>name"), written the
 * same way.  unisacc.com stays ignored by git (it is a product); this tool and the record format are what is kept.
 * An identical installed APE reports ALREADY: --write repairs stale build-record bytes/kind/digest and
 * the APE receipt. Clean records are not rewritten. Without --write stale metadata is unchanged.
 * Prints INSTALL_APE<TAB>status<TAB>sha256<TAB>bytes; exit 0 ok, 1 refused, 2 usage/IO.
 *
 * Candidate mode (0.0.87 S4: install a chain candidate as the local Root before it is public):
 *   sh ./unisacc.com tools/install-ape.cx -- ROOT --candidate DIR [--write]
 *   DIR is one bg-candidate directory BASE/<rev> (40 hex basename).  Refused by name unless
 *   DIR/chain-run.identity names rev=<rev>, DIR/seal.tsv exists, the last unisacc-next.com row of
 *   DIR/ape-final/ape-receipt.txt names DIR/ape-final/unisacc-next.com with the file's own sha and bytes, and the
 *   version the APE answers is a data row (column version) of ROOT/release/candidate.tsv.  Then the normal install
 *   runs, with three differences: before unisacc.com is replaced the current Root is backed up into
 *   ROOT/.unisacc-root-backups/<sha256>/ (unisacc.com, build record, receipt, sha record, candidate marker; at most
 *   three backups, index.tsv oldest first, the oldest removed beyond three); ROOT/unisacc.com.candidate.tsv is
 *   written ("CANDIDATE rev= sha= bytes= version= source= not=PUBLISHED"); plans/root-identity.md is NOT re-emitted
 *   (a tracked document never names an unpublished product).  Nothing is written under release/evidence.
 *   A normal (public) install --write removes the candidate marker.
 *   ROOT --rollback [--write]: with a backup index, restores the newest backup (sha checked before and after,
 *   files absent from the backup removed), then drops it; without one, the old split-era rollback below.
 *   ROOT --release-gate: rc 0 INSTALL_APE PUBLIC_ROOT when there is no candidate marker; rc 1
 *   INSTALL_APE REFUSED root-candidate rev=... otherwise.  release-exec and release-run --pack refuse the same
 *   marker themselves (REFUSE ..._ROOT_CANDIDATE); chain-ready item 17-root-public lists it without blocking a chain.
 * An L3 tool: no #include, no direct libc call. */
#pragma unisa use runtime.packagefooter
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.proc
#pragma unisa use sys.sig
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

/* sy_run with a bound: ARGV runs under cx_runv_timeout (SECS, process group killed on expiry),
   stdout and stderr merged into OUT (CAP, NUL-terminated, *CUT set when it did not fit). */
static int bounded_run(char **argv, int secs, char *out, int cap, int *cut) {
    char *w[40], *b = 0;
    size_t n = 0;
    int k = 0, i, rc;
    *cut = 0;
    w[k++] = "sh"; w[k++] = "-c"; w[k++] = "exec \"$@\" 2>&1"; w[k++] = "sh";
    for (i = 0; argv[i] && k < 39; i++) w[k++] = argv[i];
    if (argv[i]) return -1;
    w[k] = 0;
    rc = cx_runv_timeout(w, secs, &b, &n);
    if (cap > 0) {
        if (n > (size_t)cap - 1) { n = (size_t)cap - 1; *cut = 1; }
        if (b && n) mm_copy(out, (size_t)cap, b, n);
        out[n] = 0;
    }
    free(b);
    return rc;
}

static void ia_refuse(const char *why, const char *what) {
    sy_printf("INSTALL_APE\tREFUSED\t%s\t%s\n", why, what ? what : "-");
    sy_exit(1);
}
static void ia_die(const char *why) { sy_eprintf("install-ape: %s\n", why); sy_exit(2); }

static int ia_hex64(const char *s) {
    int i;
    for (i = 0; i < 64; i++) {
        char c = s[i];
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return 0;
    }
    return s[64] == 0;
}

/* sha256 and size of PATH; 0 on success */
static int ia_sha(const char *path, char hex[65], long *bytes) {
    size_t n = 0;
    char *b = cx_read(path, &n);
    if (!b) return -1;
    cx_sha256_hex(b, n, hex);
    *bytes = (long)n;
    mm_free(b);
    return 0;
}

/* 1 when the file at PATH ends with a UNIPKG1 footer (a self-contained APE), 0 otherwise, -1 unreadable */
static int ia_has_footer(const char *path) {
    size_t n = 0;
    PackageFooter f;
    int r;
    char *b = cx_read(path, &n);
    if (!b) return -1;
    r = n > 16 && n <= 2147483647UL && packagefooter_locate_bytes((unsigned char *)b, (long)n, &f) ? 1 : 0;
    mm_free(b);
    return r;
}

/* run `sh APE --version`; 1 when it exits 0 and prints a line starting "unisacc " */
static int ia_version_ok(const char *ape, char *line, int cap) {
    char *v[4];
    char out[256];
    int cut = 0, rc;
    v[0] = "sh"; v[1] = (char *)ape; v[2] = "--version"; v[3] = 0;
    rc = bounded_run(v, 20, out, (int)sizeof out, &cut);
    if (rc != 0 || tx_len(out, (long)sizeof out) < 9 || !tx_same(out, 8, "unisacc ", 8)) return 0;
    {   int k = 0;
        while (out[k] && out[k] != '\n' && k + 1 < cap) { line[k] = out[k]; k++; }
        line[k] = 0; }
    return 1;
}

static int ia_join(char *out, int cap, const char *a, const char *b) { return cx_fmt(out, (size_t)cap, "%s/%s", a, b); }

/* ROOT/unisacc.com.build.json: product_kind ape1, product_digest = the APE's whole-file sha256,
   and bytes = its verified size; every other field and its order kept. A root without a record
   is left without one (nothing to sync). Written through a temporary file and renamed. */
/* A candidate record unisacc.com.build.json beside the APE whose product_digest equals the APE sha256 describes
   exactly this APE: it replaces the root record as a whole (commit and sources_sha256 follow). Otherwise the
   three-field sync below runs and RECORD_STALE is printed, since commit/sources_sha256 are then not refreshed. */
static int ia_cand_record(const char *ape, const char *sha, char **out, size_t *outn) {
    char dir[4400], cp[4400], pat[128];
    size_t n = 0, k;
    char *b;
    long at, l = tx_len(ape, (long)sizeof dir), s;
    if (l <= 0 || l >= (long)sizeof dir) return 0;
    mm_copy(dir, (long)sizeof dir, ape, l + 1);
    for (s = l; s > 0 && dir[s - 1] != '/'; s--) ;
    if (s == 0) { dir[0] = '.'; dir[1] = 0; } else dir[s - 1 ? s - 1 : 1] = 0;
    if (ia_join(cp, (int)sizeof cp, dir, "unisacc.com.build.json")) return 0;
    if (sy_exists(cp) != 1) return 0;
    b = cx_read(cp, &n);
    if (!b) return 0;
    if (cx_fmt(pat, sizeof pat, "\"product_digest\": \"%s\"", sha)) { mm_free(b); return 0; }
    at = tx_find(b, (long)n, pat, tx_len(pat, (long)sizeof pat));
    (void)k;
    if (at < 0) { mm_free(b); return 0; }
    *out = b; *outn = n;
    return 1;
}

static void ia_sync_record(const char *root, const char *ape, const char *sha, long bytes) {
    char path[4400], tmp[4400], *b, *o;
    size_t n = 0;
    long at = 0, w = 0;
    int fd;
    sy_stat_t st;
    if (ia_join(path, (int)sizeof path, root, "unisacc.com.build.json") || cx_fmt(tmp, sizeof tmp, "%s.%d", path, sy_pid())) ia_die("path");
    fd = sy_open_read(path);
    if (fd == -ENOENT) return;
    if (fd < 0) ia_die("cannot open the build record");
    if (sy_fstat(fd, &st) || st.kind != 'f') { (void)sy_close(fd); ia_die("cannot read the build record"); }
    if (sy_close(fd)) ia_die("cannot close the build record");
    b = cx_read(path, &n);
    if (!b) ia_die("cannot read the build record");
    {   char *cb = 0; size_t cn = 0;
        if (ia_cand_record(ape, sha, &cb, &cn)) {
            if (cn == n && tx_same(b, (long)n, cb, (long)cn)) { mm_free(b); mm_free(cb); return; }
            if (cx_write(tmp, cb, cn)) { (void)sy_unlink(tmp); mm_free(b); mm_free(cb); ia_die("cannot write the build record"); }
            if (sy_rename(tmp, path)) { (void)sy_unlink(tmp); mm_free(b); mm_free(cb); ia_die("cannot rename the build record"); }
            mm_free(b); mm_free(cb);
            sy_printf("INSTALL_APE\tRECORD_REPLACED\t%s\n", path);
            return;
        }
        sy_printf("INSTALL_APE\tRECORD_STALE\t%s\n", path);
    }
    o = mm_alloc((long)n + 256);
    if (!o) { mm_free(b); ia_die("memory"); }
    while (at < (long)n) {
        long e = at, l;
        while (e < (long)n && b[e] != '\n') e++;
        l = e - at + (e < (long)n ? 1 : 0);
        if (l > 18 && tx_find(b + at, l, "\"product_kind\":", 15) >= 0) {
            int comma = tx_find(b + at, l, ",", 1) >= 0;
            if (cx_fmt(o + w, 256, "  \"product_kind\": \"ape1\"%s\n", comma ? "," : "")) ia_die("record format");
            w += tx_len(o + w, 256);
        } else if (l > 18 && tx_find(b + at, l, "\"product_digest\":", 17) >= 0) {
            int comma = tx_find(b + at, l, ",", 1) >= 0;
            if (cx_fmt(o + w, 256, "  \"product_digest\": \"%s\"%s\n", sha, comma ? "," : "")) ia_die("record format");
            w += tx_len(o + w, 256);
        } else if (l > 8 && tx_find(b + at, l, "\"bytes\":", 8) >= 0) {
            int comma = tx_find(b + at, l, ",", 1) >= 0;
            if (cx_fmt(o + w, 256, "  \"bytes\": %ld%s\n", bytes, comma ? "," : "")) ia_die("record format");
            w += tx_len(o + w, 256);
        } else {
            mm_copy(o + w, (long)n + 256 - w, b + at, l);
            w += l;
        }
        at += l;
    }
    if (w == (long)n && tx_same(b, (long)n, o, w)) { mm_free(b); mm_free(o); return; }
    if (cx_write(tmp, o, (size_t)w)) { (void)sy_unlink(tmp); mm_free(b); mm_free(o); ia_die("cannot write the build record"); }
    if (sy_rename(tmp, path)) { (void)sy_unlink(tmp); mm_free(b); mm_free(o); ia_die("cannot rename the build record"); }
    mm_free(b);
    mm_free(o);
}

/* ROOT/ape-receipt.txt becomes the APE-shaped one line "unisacc.com<TAB>APE<TAB>sha=HEX<TAB>bytes=N" (the split
   receipt named three members; an APE has one).  Written through a temporary file and renamed. */
static void ia_write_receipt(const char *root, const char *ape, const char *sha, long bytes) {
    char path[4400], tmp[4400], line[9000];
    if (ia_join(path, (int)sizeof path, root, "ape-receipt.txt") || cx_fmt(tmp, sizeof tmp, "%s.%d", path, sy_pid())) ia_die("path");
    if (cx_fmt(line, sizeof line, "unisacc.com\t%s\tsha=%s\tbytes=%ld\n", ape, sha, bytes)) ia_die("receipt format");
    sy_stat_t st;int present=sy_lstat(path,&st);
    if(present&&present!=-ENOENT)ia_die("cannot stat the receipt");
    if(!present){
        if(st.kind!='f')ia_die("receipt is not a regular file");
        if(st.size>=0&&st.size<=(long)sizeof line){
            size_t n=0;char *old=cx_read(path,&n);if(!old)ia_die("cannot read the receipt");
            int same=tx_same(old,(long)n,line,tx_len(line,sizeof line));mm_free(old);if(same)return;
        }
    }
    if (cx_write(tmp, line, (size_t)tx_len(line, (long)sizeof line))) { (void)sy_unlink(tmp); ia_die("cannot write the receipt"); }
    if (sy_rename(tmp, path)) { (void)sy_unlink(tmp); ia_die("cannot rename the receipt"); }
}

/* Re-emit plans/root-identity.md from the installed APE (split2 -> ape1).  A root without the tool or the document
   has nothing to emit and is skipped; a failing emit is an error. */
static void ia_emit_identity(const char *root) {
    char com[4400], tool[4400], doc[4400], out[512], cmd[9000];
    char *v[8];
    int k = 0, cut = 0, rc;
    if (ia_join(com, (int)sizeof com, root, "unisacc.com") || ia_join(tool, (int)sizeof tool, root, "tools/check-root-identity.cx") ||
        ia_join(doc, (int)sizeof doc, root, "plans/root-identity.md")) ia_die("path");
    if (sy_exists(tool) != 1 || sy_exists(doc) != 1) { sy_printf("INSTALL_APE\tIDENTITY_SKIP\tno-tool-or-doc\n"); return; }
    if (cx_fmt(cmd, sizeof cmd, "cd '%s' && sh ./unisacc.com tools/check-root-identity.cx -- '%s' --emit", root, root)) ia_die("path");
    v[k++] = "sh"; v[k++] = "-c"; v[k++] = cmd; v[k] = 0;
    rc = bounded_run(v, 50, out, (int)sizeof out, &cut);
    if (rc != 0) ia_die("installed, but check-root-identity --emit failed");
    sy_printf("INSTALL_APE\tIDENTITY_EMITTED\t%s\n", doc);
}

/* ---- candidate mode: backups, marker, rollback, release gate ---------------------------------------------- */
#define IA_KEEP 3
#define IA_MARK "unisacc.com.candidate.tsv"
#define IA_BDIR ".unisacc-root-backups"
static const char *ia_saved[5] = {"unisacc.com", "unisacc.com.build.json", "ape-receipt.txt", "unisacc.com.ape.sha256", IA_MARK};
static const char *g_cand_rev, *g_cand_dir;
static char g_cand_ver[160];

static int ia_hexn(const char *s, int n) {
    int i;
    for (i = 0; i < n; i++) { char c = s[i]; if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return 0; }
    return s[n] == 0;
}

/* index.tsv: one sha256 per line, oldest first.  Reads up to 16 entries into SHAS; returns the count, -1 none. */
static int ia_index_read(const char *root, char shas[16][65]) {
    char p[4400]; size_t n = 0; long at = 0; int k = 0; char *b;
    if (cx_fmt(p, sizeof p, "%s/%s/index.tsv", root, IA_BDIR)) ia_die("path");
    if (sy_exists(p) != 1) return -1;
    if (!(b = cx_read(p, &n))) ia_die("cannot read the backup index");
    while (at < (long)n && k < 16) {
        long e = at;
        while (e < (long)n && b[e] != '\n') e++;
        if (e - at == 64) { mm_copy(shas[k], 65, b + at, 64); shas[k][64] = 0; if (ia_hexn(shas[k], 64)) k++; }
        at = e + 1;
    }
    mm_free(b);
    return k;
}
static void ia_index_write(const char *root, char shas[16][65], int k) {
    char p[4400], t[4400], buf[16 * 65 + 1]; long w = 0; int i;
    if (cx_fmt(p, sizeof p, "%s/%s/index.tsv", root, IA_BDIR) || cx_fmt(t, sizeof t, "%s.%d", p, sy_pid())) ia_die("path");
    for (i = 0; i < k; i++) { mm_copy(buf + w, (long)sizeof buf - w, shas[i], 64); w += 64; buf[w++] = '\n'; }
    if (cx_write(t, buf, (size_t)w)) { (void)sy_unlink(t); ia_die("cannot write the backup index"); }
    if (sy_rename(t, p)) { (void)sy_unlink(t); ia_die("cannot rename the backup index"); }
}

/* copy the current Root state into ROOT/.unisacc-root-backups/<sha>/ and keep at most IA_KEEP backups */
static void ia_backup(const char *root) {
    char com[4400], bd[4400], d[4400], s[4400], t[4400], cur[65], chk[65], shas[16][65];
    long cb = 0, kb = 0; int k, i, j;
    if (ia_join(com, (int)sizeof com, root, "unisacc.com") || ia_join(bd, (int)sizeof bd, root, IA_BDIR)) ia_die("path");
    if (sy_exists(com) != 1 || ia_sha(com, cur, &cb)) { sy_printf("INSTALL_APE\tBACKUP_SKIP\tno-current-root\n"); return; }
    if (sy_exists(bd) != 1 && sy_mkdir(bd, 0755)) ia_die("cannot make the backup directory");
    if (ia_join(d, (int)sizeof d, bd, cur)) ia_die("path");
    if (sy_exists(d) == 1) (void)cx_rmtree(d);
    if (sy_mkdir(d, 0755)) ia_die("cannot make the backup");
    for (i = 0; i < 5; i++) {
        if (ia_join(s, (int)sizeof s, root, ia_saved[i]) || ia_join(t, (int)sizeof t, d, ia_saved[i])) ia_die("path");
        if (sy_exists(s) != 1) continue;
        if (sy_copy(s, t, i == 0 ? 0755 : 0644)) ia_die("cannot copy into the backup");
    }
    if (ia_join(t, (int)sizeof t, d, "unisacc.com") || ia_sha(t, chk, &kb) || !tx_eqz(chk, cur) || kb != cb) ia_die("backup copy differs from the Root");
    k = ia_index_read(root, shas);
    if (k < 0) k = 0;
    for (i = j = 0; i < k; i++) if (!tx_eqz(shas[i], cur)) { if (i != j) mm_copy(shas[j], 65, shas[i], 65); j++; }
    k = j;
    if (k >= 16) ia_die("backup index full");
    mm_copy(shas[k++], 65, cur, 65);
    while (k > IA_KEEP) {
        char old[4400];
        if (ia_join(old, (int)sizeof old, bd, shas[0])) ia_die("path");
        (void)cx_rmtree(old);
        sy_printf("INSTALL_APE\tBACKUP_PRUNED\t%s\n", shas[0]);
        for (i = 1; i < k; i++) mm_copy(shas[i - 1], 65, shas[i], 65);
        k--;
    }
    ia_index_write(root, shas, k);
    sy_printf("INSTALL_APE\tBACKUP\t%s\t%ld\tkept=%d\n", cur, cb, k);
}

static void ia_mark(const char *root, const char *sha, long bytes) {
    char p[4400], t[4400], line[9000];
    if (ia_join(p, (int)sizeof p, root, IA_MARK) || cx_fmt(t, sizeof t, "%s.%d", p, sy_pid())) ia_die("path");
    if (!g_cand_rev) {
        if (sy_exists(p) == 1) { if (sy_unlink(p)) ia_die("cannot remove the candidate marker"); sy_printf("INSTALL_APE\tCANDIDATE_CLEARED\t%s\n", p); }
        return;
    }
    if (cx_fmt(line, sizeof line, "CANDIDATE\trev=%s\tsha=%s\tbytes=%ld\tversion=%s\tsource=%s\tnot=PUBLISHED\n", g_cand_rev, sha, bytes, g_cand_ver, g_cand_dir)) ia_die("marker format");
    if (cx_write(t, line, (size_t)tx_len(line, (long)sizeof line))) { (void)sy_unlink(t); ia_die("cannot write the candidate marker"); }
    if (sy_rename(t, p)) { (void)sy_unlink(t); ia_die("cannot rename the candidate marker"); }
    sy_printf("INSTALL_APE\tCANDIDATE\trev=%s\tnot=PUBLISHED\n", g_cand_rev);
}

/* restore the newest backup; -1 when there is no backup index (caller falls back) */
static int ia_rollback_backup(const char *root, int write) {
    char shas[16][65], bd[4400], d[4400], s[4400], t[4400], tmp[4400], h[65];
    long b = 0; int k = ia_index_read(root, shas), i;
    if (k <= 0) return -1;
    if (ia_join(bd, (int)sizeof bd, root, IA_BDIR) || ia_join(d, (int)sizeof d, bd, shas[k - 1]) || ia_join(s, (int)sizeof s, d, "unisacc.com")) ia_die("path");
    if (ia_sha(s, h, &b) || !tx_eqz(h, shas[k - 1])) ia_refuse("backup-differs-from-its-name", d);
    if (!write) { sy_printf("INSTALL_APE\tROLLBACK_DRYRUN\t%s\n", shas[k - 1]); return 0; }
    for (i = 0; i < 5; i++) {
        if (ia_join(s, (int)sizeof s, d, ia_saved[i]) || ia_join(t, (int)sizeof t, root, ia_saved[i]) ||
            cx_fmt(tmp, sizeof tmp, "%s/.rollback.%d.%d", root, i, sy_pid())) ia_die("path");
        if (sy_exists(s) != 1) { if (i && sy_exists(t) == 1 && sy_unlink(t)) ia_die("cannot remove a file absent from the backup"); continue; }
        if (sy_copy(s, tmp, i == 0 ? 0755 : 0644)) { (void)sy_unlink(tmp); ia_die("cannot copy from the backup"); }
        if (sy_rename(tmp, t)) { (void)sy_unlink(tmp); ia_die("cannot restore from the backup"); }
    }
    if (ia_join(t, (int)sizeof t, root, "unisacc.com") || ia_sha(t, h, &b) || !tx_eqz(h, shas[k - 1])) ia_die("restored Root differs from the backup");
    (void)cx_rmtree(d);
    ia_index_write(root, shas, k - 1);
    sy_printf("INSTALL_APE\tROLLED_BACK\t%s\t%ld\tkept=%d\n", h, b, k - 1);
    return 0;
}

static int ia_release_gate(const char *root) {
    char p[4400], rev[64]; size_t n = 0; char *b; long at;
    if (ia_join(p, (int)sizeof p, root, IA_MARK)) ia_die("path");
    if (sy_exists(p) != 1) { sy_printf("INSTALL_APE\tPUBLIC_ROOT\t%s\n", root); return 0; }
    rev[0] = 0;
    if ((b = cx_read(p, &n)) != 0) {
        at = tx_find(b, (long)n, "rev=", 4);
        if (at >= 0 && at + 44 <= (long)n) { mm_copy(rev, (long)sizeof rev, b + at, 44); rev[44] = 0; }
        mm_free(b);
    }
    sy_printf("INSTALL_APE\tREFUSED\troot-candidate\t%s\tfix=install-ape --rollback or install the public APE\n", rev[0] ? rev : "rev=?");
    return 1;
}

/* verify DIR as a sealed bg-candidate and install its APE in candidate mode */
static int ia_install(const char *root, const char *ape, const char *want, int write);
static int ia_candidate(const char *root, const char *dirarg, int write) {
    static char dir[4096];
    char p[4400], apep[4400], got[65], ver[160], have_s[32];
    const char *rev; long l, have = 0, at = 0, off, len; size_t n = 0; char *b;
    int found = 0;
    char rfile[4400], rsha[80], rbytes[40];
    if (sy_realpath(dirarg, dir, (int)sizeof dir) < 0) ia_refuse("candidate-dir-unreadable", dirarg);
    l = tx_len(dir, (long)sizeof dir); rev = dir + l;
    while (rev > dir && rev[-1] != '/') rev--;
    if (!ia_hexn(rev, 40)) ia_refuse("candidate-dir-not-rev", dir);
    if (ia_join(p, (int)sizeof p, dir, "chain-run.identity")) ia_die("path");
    if (!(b = cx_read(p, &n))) ia_refuse("candidate-no-identity", p);
    {   char pat[64]; cx_fmt(pat, sizeof pat, "rev=%s", rev); found = tx_find(b, (long)n, pat, 44) >= 0; mm_free(b); }
    if (!found) ia_refuse("candidate-identity-rev-mismatch", rev);
    if (ia_join(p, (int)sizeof p, dir, "seal.tsv")) ia_die("path");
    if (sy_exists(p) != 1) ia_refuse("candidate-not-sealed", p);
    if (ia_join(p, (int)sizeof p, dir, "ape-final/ape-receipt.txt") || ia_join(apep, (int)sizeof apep, dir, "ape-final/unisacc-next.com")) ia_die("path");
    if (!(b = cx_read(p, &n))) ia_refuse("candidate-no-ape-receipt", p);
    found = 0;
    while (at < (long)n) {
        long e = at;
        while (e < (long)n && b[e] != '\n') e++;
        if (e - at > 17 && tx_same(b + at, 17, "unisacc-next.com\t", 17) &&
            !tx_field(b + at, e - at, '\t', 1, &off, &len) && len < (long)sizeof rfile) {
            mm_copy(rfile, (long)sizeof rfile, b + at + off, len); rfile[len] = 0;
            rsha[0] = rbytes[0] = 0;
            if (!tx_field(b + at, e - at, '\t', 2, &off, &len) && len == 68 && tx_same(b + at + off, 4, "sha=", 4)) { mm_copy(rsha, (long)sizeof rsha, b + at + off + 4, 64); rsha[64] = 0; }
            if (!tx_field(b + at, e - at, '\t', 3, &off, &len) && len > 6 && len < 30 && tx_same(b + at + off, 6, "bytes=", 6)) { mm_copy(rbytes, (long)sizeof rbytes, b + at + off + 6, len - 6); rbytes[len - 6] = 0; }
            found = 1;
        }
        at = e + 1;
    }
    mm_free(b);
    if (!found) ia_refuse("candidate-receipt-no-ape-row", p);
    if (!tx_eqz(rfile, apep)) ia_refuse("candidate-receipt-path-mismatch", rfile);
    if (ia_sha(apep, got, &have)) ia_refuse("cannot-read-ape", apep);
    cx_fmt(have_s, sizeof have_s, "%ld", have);
    if (!tx_eqz(got, rsha) || !tx_eqz(have_s, rbytes)) ia_refuse("candidate-receipt-sha-mismatch", got);
    if (!ia_version_ok(apep, ver, (int)sizeof ver)) ia_refuse("ape-does-not-answer-version", apep);
    {   const char *v = ver + 8; long vl = 0;
        while (v[vl] && v[vl] != ' ' && v[vl] != '\t' && vl < 150) vl++;
        mm_copy(g_cand_ver, (long)sizeof g_cand_ver, v, vl); g_cand_ver[vl] = 0; }
    if (cx_fmt(p, sizeof p, "%s/release/candidate.tsv", root)) ia_die("path");
    found = 0; at = 0;
    if ((b = cx_read(p, &n)) != 0) {
        long vl = tx_len(g_cand_ver, (long)sizeof g_cand_ver);
        while (at < (long)n) {
            long e = at;
            while (e < (long)n && b[e] != '\n') e++;
            if (!tx_field(b + at, e - at, '\t', 3, &off, &len) && len == vl && tx_same(b + at + off, len, g_cand_ver, vl)) found = 1;
            at = e + 1;
        }
        mm_free(b);
    }
    if (!found) ia_refuse("candidate-version-not-in-candidate-list", g_cand_ver);
    g_cand_rev = rev; g_cand_dir = dir;
    return ia_install(root, apep, got, write);
}

/* install APE over ROOT/unisacc.com.  want = expected sha; write = do it.  Returns the exit code. */
static int ia_install(const char *root, const char *ape, const char *want, int write) {
    char got[65], cur[65], com[4400], dev[4400], tmp[4400], rec[4400], rtmp[4400], line[4400], ver[160];
    long bytes = 0, cb = 0;
    int pid = sy_pid(), had_dev, had_split;
    if (!ia_hex64(want)) ia_refuse("expected-sha-not-64-hex", want);
    if (ia_sha(ape, got, &bytes)) ia_refuse("cannot-read-ape", ape);
    if (!tx_eqz(got, want)) ia_refuse("sha-mismatch", got);
    if (ia_has_footer(ape) != 1) ia_refuse("no-UNIPKG1-footer", ape);
    if (!ia_version_ok(ape, ver, (int)sizeof ver)) ia_refuse("ape-does-not-answer-version", ape);
    if (ia_join(com, (int)sizeof com, root, "unisacc.com") || ia_join(dev, (int)sizeof dev, root, "unisacc-dev") ||
        ia_join(rec, (int)sizeof rec, root, "unisacc.com.ape.sha256")) ia_die("path");
    if (cx_fmt(tmp, sizeof tmp, "%s/.unisacc.com.install.%d", root, pid) || cx_fmt(rtmp, sizeof rtmp, "%s/.unisacc.com.ape.sha256.%d", root, pid)) ia_die("path");
    if (ia_sha(com, cur, &cb) == 0 && tx_eqz(cur, got)) {
        if (write) { ia_sync_record(root, ape, got, bytes); ia_write_receipt(root, ape, got, bytes); ia_mark(root, got, bytes); }
        sy_printf("INSTALL_APE\tALREADY\t%s\t%ld\t%s\n", got, bytes, ver);
        return 0;
    }
    if (!write) {
        sy_printf("INSTALL_APE\tDRYRUN\t%s\t%ld\t%s\n", got, bytes, ver);
        return 0;
    }
    had_dev = sy_exists(dev);
    if (!had_dev && sy_exists(com)) {
        int f = ia_has_footer(com);
        if (f == 0) {
            if (sy_copy(com, dev, 0755)) ia_die("cannot keep the launcher as unisacc-dev");
        }
    }
    {   char sd[4400], sp[4400];
        if (ia_join(sd, (int)sizeof sd, root, "unisacc.com.dev") || ia_join(sp, (int)sizeof sp, root, "unisacc.com.dev.split-prev")) ia_die("path");
        had_split = sy_exists(sd) == 1;
        if (had_split && !sy_exists(sp)) { if (sy_rename(sd, sp)) ia_die("cannot move unisacc.com.dev aside"); }
    }
    {   char bj[4400], bp[4400];
        if (ia_join(bj, (int)sizeof bj, root, "unisacc.com.build.json") || ia_join(bp, (int)sizeof bp, root, "unisacc.com.build.json.split-prev")) ia_die("path");
        if (sy_exists(bj) == 1 && sy_exists(bp) != 1 && sy_copy(bj, bp, 0600)) ia_die("cannot keep the build record as .split-prev");
    }
    if (g_cand_rev) ia_backup(root);
    if (sy_copy(ape, tmp, 0755)) { (void)sy_unlink(tmp); ia_die("cannot copy the ape beside unisacc.com"); }
    if (ia_sha(tmp, cur, &cb) || !tx_eqz(cur, got) || cb != bytes) { (void)sy_unlink(tmp); ia_refuse("copy-differs-from-source", tmp); }
    if (cx_fmt(line, sizeof line, "%s\t%ld\t%s\n", got, bytes, "unisacc.com")) { (void)sy_unlink(tmp); ia_die("record"); }
    if (cx_write(rtmp, line, (size_t)tx_len(line, (long)sizeof line))) { (void)sy_unlink(tmp); (void)sy_unlink(rtmp); ia_die("cannot write the record"); }
    if (sy_rename(tmp, com)) { (void)sy_unlink(tmp); (void)sy_unlink(rtmp); ia_die("cannot rename over unisacc.com"); }
    if (sy_rename(rtmp, rec)) { (void)sy_unlink(rtmp); ia_die("installed, but the record could not be written"); }
    ia_sync_record(root, ape, got, bytes);
    ia_write_receipt(root, ape, got, bytes);
    ia_mark(root, got, bytes);
    if (g_cand_rev) sy_printf("INSTALL_APE\tIDENTITY_SKIP\tcandidate-not-public\n"); else ia_emit_identity(root);
    sy_printf("INSTALL_APE\tINSTALLED\t%s\t%ld\t%s\n", got, bytes, ver);
    return 0;
}

/* undo: ROOT/unisacc-dev goes back to unisacc.com, ROOT/unisacc.com.dev.split-prev back to unisacc.com.dev, and
   ROOT/unisacc.com.build.json.split-prev (saved by the install) back to unisacc.com.build.json.  Refuses when
   there is no unisacc-dev to go back to. */
static int ia_rollback(const char *root, int write) {
    char com[4400], dev[4400], sd[4400], sp[4400], gone[4400];
    if (ia_join(com, (int)sizeof com, root, "unisacc.com") || ia_join(dev, (int)sizeof dev, root, "unisacc-dev") ||
        ia_join(sd, (int)sizeof sd, root, "unisacc.com.dev") || ia_join(sp, (int)sizeof sp, root, "unisacc.com.dev.split-prev") ||
        cx_fmt(gone, sizeof gone, "%s/.unisacc.com.ape-removed.%d", root, sy_pid())) ia_die("path");
    if (sy_exists(dev) != 1) ia_refuse("no-unisacc-dev-to-roll-back-to", dev);
    if (!write) { sy_printf("INSTALL_APE\tROLLBACK_DRYRUN\t%s\n", dev); return 0; }
    if (sy_rename(com, gone)) ia_die("cannot move the ape aside");
    if (sy_rename(dev, com)) { (void)sy_rename(gone, com); ia_die("cannot restore unisacc-dev"); }
    if (sy_exists(sp) == 1 && sy_exists(sd) != 1 && sy_rename(sp, sd)) ia_die("cannot restore unisacc.com.dev");
    {   char bj[4400], bp[4400];
        if (ia_join(bj, (int)sizeof bj, root, "unisacc.com.build.json") || ia_join(bp, (int)sizeof bp, root, "unisacc.com.build.json.split-prev")) ia_die("path");
        if (sy_exists(bp) == 1 && sy_rename(bp, bj)) ia_die("cannot restore the build record");
    }
    (void)sy_unlink(gone);
    sy_printf("INSTALL_APE\tROLLED_BACK\t%s\n", com);
    return 0;
}

int main(int argc, char **argv) {
    char root[4096];
    int write = 0, rollback = 0, gate = 0, i;
    const char *cand = 0;
    const char *pos[3];
    int np = 0;
    for (i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--")) continue;
        if (tx_eqz(argv[i], "--write")) { write = 1; continue; }
        if (tx_eqz(argv[i], "--rollback")) { rollback = 1; continue; }
        if (tx_eqz(argv[i], "--release-gate")) { gate = 1; continue; }
        if (tx_eqz(argv[i], "--candidate")) { if (cand || i + 1 >= argc) ia_die("usage: ROOT --candidate DIR [--write]"); cand = argv[++i]; continue; }
        if (np < 3) pos[np++] = argv[i]; else ia_die("usage: ROOT APE SHA256 [--write] | ROOT --candidate DIR [--write] | ROOT --rollback [--write] | ROOT --release-gate");
    }
    if (gate || cand) {
        if (np != 1 || rollback || (gate && (cand || write))) ia_die("usage: ROOT --candidate DIR [--write] | ROOT --release-gate");
        if (sy_realpath(pos[0], root, (int)sizeof root) < 0) ia_die("root");
        return gate ? ia_release_gate(root) : ia_candidate(root, cand, write);
    }
    if (rollback) {
        int r;
        if (np != 1) ia_die("usage: ROOT --rollback [--write]");
        if (sy_realpath(pos[0], root, (int)sizeof root) < 0) ia_die("root");
        if ((r = ia_rollback_backup(root, write)) >= 0) return r;
        return ia_rollback(root, write);
    }
    if (np != 3) ia_die("usage: ROOT APE SHA256 [--write] | ROOT --rollback [--write]");
    if (sy_realpath(pos[0], root, (int)sizeof root) < 0) ia_die("root");
    return ia_install(root, pos[1], pos[2], write);
}
