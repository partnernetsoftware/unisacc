/* tools/freeze-day.cx -- read-only S0..S10 ordered command checklist with live repo values and readiness gates.
 *
 *   sh ./unisacc.com tools/freeze-day.cx -- plan --version V [--branch REF] [--repo DIR] [--owner NAME]
 *       [--prerun-dir ABS_DIR] [--chain-dir ABS_DIR] [--ape ABS_APE]
 *       [--readiness-bin CMD] [--merge-tree HASH] [--no-readiness]
 *   sh ./unisacc.com tools/freeze-day.cx -- check --step STEP_ID --log FILE
 *
 * Read-only checklist generator: never merges, commits, pushes, or publishes.
 * Plan reads current values from --repo (release/candidate.tsv, git HEAD, HEAD^{tree}, branch SHA,
 * release/ templates, optional freeze-readiness --skip-slow) and prints copyable S0..S10 commands
 * with gate READY/BLOCKED (including S0-preview, S0-gates, S0-verify-tree HEAD^{tree}==merge_tree,
 * S0-freeze-slot, S1 split into 3 --only batches, S3 load guard + l0-posix2 judge, and S4b/S8b lock renewals).
 * Check reads a step log file and verifies the step's expected completion marker without executing anything.
 * Final lines:
 *   FREEZE_DAY<TAB>plan<TAB>steps=23<TAB>blocked=M
 *   FREEZE_DAY<TAB>check<TAB>step=ID<TAB>status=PASS|FAIL<TAB>expect=...<TAB>log=...
 * Check: tools/check-freeze-day.cx (batch freeze-day).
 */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use sys.posix
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use cxlib.netpack

enum { FD_MAX_FR = 32, FD_STEPS = 24 };

typedef struct {
    char id[64];
    char verdict[32];
    char detail[256];
} fr_row_t;

typedef struct {
    const char *id;
    const char *who;
    int budget_s;
    const char *expect;
} step_spec_t;

static const step_spec_t g_specs[FD_STEPS] = {
    { "S0-preview",      "integrator",  60,   "MERGE_VERSION\tverdict=READY" },
    { "S0-gates",        "integrator",  300,  "MERGE_GATE\tratchets-total" },
    { "S0-devsvc-alive", "integrator",  30,   "OK\tpong" },
    { "S0-lock",         "integrator",  60,   "FREEZE_BROADCAST" },
    { "S0-merge",       "integrator",  300,  "GIT_COMMIT\trc=0" },
    { "S0-verify-tree", "integrator",  15,   "MERGE_TREE_MATCH" },
    { "S0-freeze-slot", "integrator",  120,  "11-version-slot\tPASS" },
    { "S1-light",       "integrator",  45,   "READY\tyes" },
    { "S1-mid",         "integrator",  50,   "READY\tyes" },
    { "S1-chain",       "integrator",  55,   "5-candidate-chain\tPASS" },
    { "S2",             "integrator",  1800, "CHAIN_DONE" },
    { "S3-inputs",      "prerun",      60,   "PRERUN_INPUTS_SUMMARY" },
    { "S3-run",         "prerun",      2280, "PRERUN_SUMMARY" },
    { "S3b",            "ci",          600,  "conclusion=success" },
    { "S3c",            "docs",        600,  "CHECK_RELEASE_PREP" },
    { "S4",             "prerun",      180,  "PRERUN_ARCHIVE" },
    { "S4b-renew-lock", "integrator",  30,   "LOCK_ACQUIRED" },
    { "S5",             "integrator",  300,  "RELEASE_EXEC_WARM" },
    { "S6",             "integrator",  180,  "RELEASE_CHAIN" },
    { "S7",             "integrator",  180,  "RELEASE_CHAIN" },
    { "S8",             "integrator",  180,  "RELEASE_CHAIN" },
    { "S8b-renew-lock", "integrator",  30,   "LOCK_ACQUIRED" },
    { "S9",             "integrator",  720,  "exec-7-Y2-done" },
    { "S10",            "integrator",  480,  "RELEASE_POST\tstatus=DONE" }
};

static fr_row_t g_fr[FD_MAX_FR];
static int g_nfr;
static int g_fr_ran;
static int g_fr_blockers;
static char g_fr_ready[16];

static int die_usage(const char *msg) {
    sy_eprintf("freeze-day: REFUSE %s\n", msg);
    return 2;
}

static void trim_eol(char *s) {
    long n = tx_len(s, 4096);
    while (n > 0 && (s[n - 1] == '\n' || s[n - 1] == '\r' || s[n - 1] == ' ' || s[n - 1] == '\t')) {
        s[--n] = 0;
    }
}

static int run_cap(char **av, const char *cwd, int timeout_s, char *out, long cap) {
    char why[256];
    np_result r;
    mm_fill(&r, sizeof r, 0, sizeof r);
    out[0] = 0;
    if (np_run(av, cwd, 0, timeout_s, &r, why, sizeof why) != 0) {
        np_free(&r);
        return -1;
    }
    if (r.out && r.outn > 0 && cap > 1) {
        long cp = (long)r.outn;
        if (cp >= cap) cp = cap - 1;
        mm_copy(out, cap, r.out, cp);
        out[cp] = 0;
    }
    int rc = r.rc;
    np_free(&r);
    return rc;
}

static int git_rev(const char *repo, const char *ref, int short_flag, char *out, long cap) {
    char *av[7];
    int n = 0;
    av[n++] = "git"; av[n++] = "-C"; av[n++] = (char *)repo;
    av[n++] = "rev-parse";
    if (short_flag) av[n++] = "--short";
    av[n++] = (char *)ref;
    av[n] = 0;
    int rc = run_cap(av, 0, 10, out, cap);
    if (rc != 0) { out[0] = 0; return -1; }
    trim_eol(out);
    return out[0] ? 0 : -1;
}

static int get_field(const char *line, long ln, int col, char *out, long cap) {
    long at = 0;
    int c = 0;
    out[0] = 0;
    while (at <= ln) {
        long s = at;
        while (at < ln && line[at] != '\t') at++;
        if (c == col) {
            long fl = at - s;
            if (fl >= cap) fl = cap - 1;
            if (fl > 0) mm_copy(out, cap, line + s, fl);
            out[fl] = 0;
            return 0;
        }
        c++;
        at++;
    }
    return -1;
}

static int load_candidate_tsv(const char *repo, char *prev_ver, long vcap, char *prev_sha, long scap, char *ape_name, long acap) {
    char path[1024];
    unsigned char *raw = 0;
    int64_t sz = 0;
    prev_ver[0] = 0; prev_sha[0] = 0; ape_name[0] = 0;
    if (cx_fmt(path, sizeof path, "%s/release/candidate.tsv", repo)) return -1;
    if (sy_read_file(path, &raw, &sz, 1 << 20) != 0 || !raw || sz <= 0) { mm_free(raw); return -1; }
    const char *b = (const char *)raw;
    long n = (long)sz, at = 0, last_s = -1, last_l = 0;
    int row_idx = 0;
    while (at < n) {
        long e = tx_chr(b + at, n - at, '\n');
        long ln = e < 0 ? n - at : e;
        if (ln > 0 && b[at + ln - 1] == '\r') ln--;
        if (ln > 0 && b[at] != '#') {
            if (row_idx > 0) { last_s = at; last_l = ln; }
            row_idx++;
        }
        at += (e < 0 ? n - at : e + 1);
    }
    int ok = 0;
    if (last_s >= 0) {
        if (get_field(b + last_s, last_l, 3, prev_ver, vcap) == 0 &&
            get_field(b + last_s, last_l, 2, prev_sha, scap) == 0 &&
            get_field(b + last_s, last_l, 7, ape_name, acap) == 0) {
            ok = 1;
        }
    }
    mm_free(raw);
    return ok ? 0 : -1;
}

static void run_readiness(const char *repo, const char *ver, const char *rd_bin) {
    char *av[12];
    char cmd_buf[2048];
    char out[65536];
    int n = 0;
    g_nfr = 0; g_fr_ran = 1; g_fr_blockers = 0;
    cx_fmt(g_fr_ready, sizeof g_fr_ready, "unknown");
    if (rd_bin && rd_bin[0]) {
        if (cx_fmt(cmd_buf, sizeof cmd_buf, "%s --repo '%s' --version '%s' --skip-slow", rd_bin, repo, ver)) return;
        av[n++] = "sh"; av[n++] = "-c"; av[n++] = cmd_buf; av[n] = 0;
    } else {
        const char *u = sy_env("UNISACC");
        if (!u || !u[0]) u = "./unisacc.com";
        av[n++] = "sh"; av[n++] = (char *)u; av[n++] = "tools/freeze-readiness.cx"; av[n++] = "--";
        av[n++] = "--repo"; av[n++] = (char *)repo;
        av[n++] = "--version"; av[n++] = (char *)ver;
        av[n++] = "--skip-slow"; av[n] = 0;
    }
    (void)run_cap(av, 0, 50, out, sizeof out);
    long len = tx_len(out, sizeof out), at = 0;
    while (at < len) {
        long e = tx_chr(out + at, len - at, '\n');
        long ln = e < 0 ? len - at : e;
        if (ln > 0 && out[at + ln - 1] == '\r') ln--;
        const char *l = out + at;
        if (ln > 8 && tx_prefix(l, ln, "FR_ITEM\t", 8) && g_nfr < FD_MAX_FR) {
            fr_row_t *r = &g_fr[g_nfr];
            mm_fill(r, sizeof *r, 0, sizeof *r);
            if (get_field(l, ln, 1, r->id, sizeof r->id) == 0 &&
                get_field(l, ln, 3, r->detail, sizeof r->detail) == 0 &&
                get_field(l, ln, 8, r->verdict, sizeof r->verdict) == 0) {
                g_nfr++;
            }
        } else if (ln > 17 && tx_prefix(l, ln, "FREEZE_READINESS\t", 17)) {
            char rf[32], bf[32];
            if (get_field(l, ln, 1, rf, sizeof rf) == 0 && tx_prefix(rf, tx_len(rf, 32), "ready=", 6)) {
                cx_fmt(g_fr_ready, sizeof g_fr_ready, "%s", rf + 6);
            }
            if (get_field(l, ln, 2, bf, sizeof bf) == 0 && tx_prefix(bf, tx_len(bf, 32), "blockers=", 9)) {
                int v = 0;
                for (const char *p = bf + 9; *p >= '0' && *p <= '9'; p++) v = v * 10 + (*p - '0');
                g_fr_blockers = v;
            }
        }
        at += (e < 0 ? len - at : e + 1);
    }
}

static const fr_row_t *find_fr(const char *id) {
    for (int i = 0; i < g_nfr; i++) {
        if (tx_eqz(g_fr[i].id, id)) return &g_fr[i];
    }
    return 0;
}

static int fr_is_bad(const char *id) {
    const fr_row_t *r = find_fr(id);
    if (!r) return 0;
    return tx_eqz(r->verdict, "FAIL") || tx_eqz(r->verdict, "CONFLICT");
}

static void add_reason(char *buf, long cap, const char *tok) {
    long n = tx_len(buf, cap), tl = tx_len(tok, 128);
    if (n == 0 || (n == 1 && buf[0] == '-')) {
        if (tl >= cap) tl = cap - 1;
        mm_copy(buf, cap, tok, tl);
        buf[tl] = 0;
        return;
    }
    if (n + 1 + tl < cap) {
        buf[n] = ',';
        mm_copy(buf + n + 1, cap - n - 1, tok, tl);
        buf[n + 1 + tl] = 0;
    }
}

static void extract_tree_hash(const char *detail, char *out, long cap) {
    long dl = tx_len(detail, 256);
    long pos = tx_find(detail, dl, "tree=", 5);
    out[0] = 0;
    if (pos < 0) return;
    long i = pos + 5, o = 0;
    while (i < dl && o + 1 < cap && detail[i] != ' ' && detail[i] != '\t' && detail[i] != ',' && detail[i] != ';') {
        out[o++] = detail[i++];
    }
    out[o] = 0;
}

static int tree_hash_matches(const char *head_tree, const char *merge_tree) {
    long hl = tx_len(head_tree, 64), ml = tx_len(merge_tree, 64);
    if (hl < 7 || ml < 7) return 0;
    long cmp = hl < ml ? hl : ml;
    return tx_prefix(head_tree, hl, merge_tree, cmp);
}

/* ---- Parse-level command self-check (--selfcheck) ---- */
static char g_cr_items[64][64];
static int g_ncr;

static void cr_add_item(const char *s, long n) {
    if (n <= 0 || n >= 64 || g_ncr >= 64) return;
    char tmp[64];
    mm_copy(tmp, sizeof tmp, s, n);
    tmp[n] = 0;
    for (int i = 0; i < g_ncr; i++) if (tx_eqz(g_cr_items[i], tmp)) return;
    mm_copy(g_cr_items[g_ncr], 64, tmp, n + 1);
    g_ncr++;
}

/* Read real item names from <repo>/tools/chain-ready.cx (both nm[] table and WANT("...") guards). */
static void load_chain_ready_items(const char *repo) {
    char p[1024];
    g_ncr = 0;
    if (cx_fmt(p, sizeof p, "%s/tools/chain-ready.cx", repo)) return;
    unsigned char *raw = 0;
    int64_t sz = 0;
    if (sy_read_file(p, &raw, &sz, 4 << 20) != 0 || !raw || sz <= 0) { mm_free(raw); return; }
    const char *s = (const char *)raw;
    /* 1. Extract quoted names from static const char *nm[] = { ... }; */
    long nm_pos = tx_find(s, (long)sz, "static const char *nm[] = {", 27);
    if (nm_pos >= 0) {
        long end_pos = tx_find(s + nm_pos, (long)sz - nm_pos, "};", 2);
        if (end_pos > 0) {
            long i = nm_pos + 27, lim = nm_pos + end_pos;
            while (i < lim) {
                if (s[i] == '"') {
                    long st = i + 1;
                    i++;
                    while (i < lim && s[i] != '"') i++;
                    if (i < lim && i > st) cr_add_item(s + st, i - st);
                }
                i++;
            }
        }
    }
    /* 2. Extract quoted names from WANT("...") across the file */
    long pos = 0;
    while (pos < (long)sz) {
        long hit = tx_find(s + pos, (long)sz - pos, "WANT(\"", 6);
        if (hit < 0) break;
        long st = pos + hit + 6;
        long en = st;
        while (en < (long)sz && s[en] != '"' && s[en] != '\n') en++;
        if (en < (long)sz && s[en] == '"' && en > st) cr_add_item(s + st, en - st);
        pos = en + 1;
    }
    mm_free(raw);
}

static int cr_prefix_matches(const char *pfx) {
    long pl = tx_len(pfx, 64);
    if (pl <= 0 || g_ncr <= 0) return 0;
    for (int i = 0; i < g_ncr; i++) {
        long il = tx_len(g_cr_items[i], 64);
        if (tx_prefix(g_cr_items[i], il, pfx, pl)) return 1;
    }
    return 0;
}

static int sc_in_list(const char *tok, const char *const *list) {
    for (int i = 0; list[i]; i++) if (tx_eqz(tok, list[i])) return 1;
    return 0;
}

static int sc_check_flags(char toks[][256], int start, int nt,
                          const char *const *val_flags, const char *const *bool_flags,
                          int allow_pos, int *npos_out, char *why, long wcap) {
    int npos = 0;
    for (int i = start; i < nt; i++) {
        if (toks[i][0] == '-' && toks[i][1] == '-') {
            if (val_flags && sc_in_list(toks[i], val_flags)) {
                if (i + 1 >= nt) { cx_fmt(why, wcap, "missing-value:%s", toks[i]); return 1; }
                i++;
            } else if (bool_flags && sc_in_list(toks[i], bool_flags)) {
                /* ok */
            } else {
                cx_fmt(why, wcap, "unknown-flag:%s", toks[i]);
                return 1;
            }
        } else if (toks[i][0] == '-' && toks[i][1]) {
            if (val_flags && sc_in_list(toks[i], val_flags)) {
                if (i + 1 >= nt) { cx_fmt(why, wcap, "missing-value:%s", toks[i]); return 1; }
                i++;
            } else if (bool_flags && sc_in_list(toks[i], bool_flags)) {
                /* ok */
            } else {
                cx_fmt(why, wcap, "unknown-flag:%s", toks[i]);
                return 1;
            }
        } else {
            if (!allow_pos) { cx_fmt(why, wcap, "unexpected-pos:%s", toks[i]); return 1; }
            npos++;
        }
    }
    if (npos_out) *npos_out = npos;
    return 0;
}

static int sc_has_flag(char toks[][256], int start, int nt, const char *flag, char *val, long vcap) {
    for (int i = start; i < nt; i++) {
        if (tx_eqz(toks[i], flag)) {
            if (val && vcap > 0) {
                if (i + 1 < nt) cx_fmt(val, vcap, "%s", toks[i + 1]);
                else val[0] = 0;
            }
            return 1;
        }
    }
    return 0;
}

static int sc_validate_tool(const char *tool, char toks[][256], int nt, char *why, long wcap) {
    why[0] = '-'; why[1] = 0;
    if (tx_eqz(tool, "chain-ready")) {
        static const char *const vf[] = {"--repo", "--root", "--rev", "--since", "--pgrep-pat", "--only", "--version", "--preflight-table", "--disk-free-gb", 0};
        static const char *const bf[] = {"--fast", 0};
        if (sc_check_flags(toks, 0, nt, vf, bf, 0, 0, why, wcap)) return 1;
        char onlyv[256]; onlyv[0] = 0;
        if (sc_has_flag(toks, 0, nt, "--only", onlyv, sizeof onlyv)) {
            if (tx_find(onlyv, tx_len(onlyv, 256), ",", 1) >= 0) {
                cx_fmt(why, wcap, "chain-ready-only-must-be-single-prefix");
                return 1;
            }
            if (!tx_eqz(onlyv, "$p")) {
                if (g_ncr <= 0) {
                    cx_fmt(why, wcap, "chain-ready-items-unreadable");
                    return 1;
                }
                if (!cr_prefix_matches(onlyv)) {
                    cx_fmt(why, wcap, "chain-ready-only-no-match:%s", onlyv);
                    return 1;
                }
            }
        }
        return 0;
    }
    if (tx_eqz(tool, "bg-candidate")) {
        if (nt < 1) { cx_fmt(why, wcap, "missing-subcmd"); return 1; }
        if (tx_eqz(toks[0], "start")) {
            static const char *const vf[] = {"--rev", "--deadline-s", "--segment-s", "--max-segments", "--chain", 0};
            if (sc_check_flags(toks, 1, nt, vf, 0, 0, 0, why, wcap)) return 1;
            if (!sc_has_flag(toks, 1, nt, "--rev", 0, 0)) { cx_fmt(why, wcap, "bg-candidate-start-needs-rev"); return 1; }
            return 0;
        }
        if (tx_eqz(toks[0], "promote") || tx_eqz(toks[0], "status") || tx_eqz(toks[0], "stop")) return 0;
        cx_fmt(why, wcap, "unknown-subcmd:%s", toks[0]);
        return 1;
    }
    if (tx_eqz(tool, "prerun-inputs")) {
        static const char *const vf[] = {"--rev", "--version", "--prev", "--ape", "--dir", "--repo", "--prev-windows", "--priority-src", "--add-ids", "--times-cache", "--evidence-out", "--prev-rev", "--exclude", "--lanes", "--jobs", 0};
        static const char *const bf[] = {"--no-templates", 0};
        if (sc_check_flags(toks, 0, nt, vf, bf, 0, 0, why, wcap)) return 1;
        if (!sc_has_flag(toks, 0, nt, "--rev", 0, 0) || !sc_has_flag(toks, 0, nt, "--version", 0, 0) ||
            !sc_has_flag(toks, 0, nt, "--prev", 0, 0) || !sc_has_flag(toks, 0, nt, "--dir", 0, 0)) {
            cx_fmt(why, wcap, "prerun-inputs-missing-required");
            return 1;
        }
        return 0;
    }
    if (tx_eqz(tool, "prerun-drive")) {
        if (nt < 1) { cx_fmt(why, wcap, "missing-subcmd"); return 1; }
        if (tx_eqz(toks[0], "plan")) {
            static const char *const vf[] = {"--ids-file", "--out", "--heavy-file", "--times-file", "--priority-file", "--normal-jobs", "--window-lanes", "--win-size", "--warmup", "--max-wins", "--unmeasured-ms", 0};
            if (sc_check_flags(toks, 1, nt, vf, 0, 0, 0, why, wcap)) return 1;
            if (!sc_has_flag(toks, 1, nt, "--ids-file", 0, 0) || !sc_has_flag(toks, 1, nt, "--out", 0, 0)) { cx_fmt(why, wcap, "plan-missing-required"); return 1; }
            return 0;
        }
        if (tx_eqz(toks[0], "run")) {
            static const char *const vf[] = {"--root", "--candidate", "--out", "--dir", "--max-jobs", "--window-lanes", "--load-cap", "--max-retries", "--mock-runner", 0};
            static const char *const bf[] = {"--resume", "--keep-going", "--no-keep-going", "--fail-fast-unknown", 0};
            if (sc_check_flags(toks, 1, nt, vf, bf, 0, 0, why, wcap)) return 1;
            if (!sc_has_flag(toks, 1, nt, "--out", 0, 0) && !sc_has_flag(toks, 1, nt, "--dir", 0, 0)) { cx_fmt(why, wcap, "run-missing-out"); return 1; }
            return 0;
        }
        if (tx_eqz(toks[0], "merge")) {
            static const char *const vf[] = {"--in-dir", "--out", "--dir", "--version", 0};
            if (sc_check_flags(toks, 1, nt, vf, 0, 0, 0, why, wcap)) return 1;
            if (!sc_has_flag(toks, 1, nt, "--in-dir", 0, 0) && !sc_has_flag(toks, 1, nt, "--dir", 0, 0)) { cx_fmt(why, wcap, "merge-missing-in-dir"); return 1; }
            return 0;
        }
        if (tx_eqz(toks[0], "archive")) {
            static const char *const vf[] = {"--in-dir", "--dir", "--repo", "--version", 0};
            if (sc_check_flags(toks, 1, nt, vf, 0, 0, 0, why, wcap)) return 1;
            if (!sc_has_flag(toks, 1, nt, "--in-dir", 0, 0) && !sc_has_flag(toks, 1, nt, "--dir", 0, 0)) { cx_fmt(why, wcap, "archive-missing-in-dir"); return 1; }
            return 0;
        }
        cx_fmt(why, wcap, "unknown-subcmd:%s", toks[0]);
        return 1;
    }
    if (tx_eqz(tool, "ci-early")) {
        static const char *const vf[] = {"--rev", "--version", "--ape-sha", "--repo", "--workflow", "--ref", "--out", "--poll-s", "--poll-max", "--ci-json", "--ci-log", 0};
        static const char *const bf[] = {"--parse-only", "--no-dispatch", 0};
        if (sc_check_flags(toks, 0, nt, vf, bf, 0, 0, why, wcap)) return 1;
        if (!sc_has_flag(toks, 0, nt, "--rev", 0, 0)) { cx_fmt(why, wcap, "ci-early-needs-rev"); return 1; }
        return 0;
    }
    if (tx_eqz(tool, "release-run")) {
        if (nt < 1) { cx_fmt(why, wcap, "missing-mode"); return 1; }
        if (tx_eqz(toks[0], "--pack")) {
            static const char *const vf[] = {"--chain-out", "--snap", 0};
            int npos = 0;
            if (sc_check_flags(toks, 1, nt, vf, 0, 1, &npos, why, wcap)) return 1;
            if (npos < 4 || !sc_has_flag(toks, 1, nt, "--chain-out", 0, 0)) { cx_fmt(why, wcap, "release-run-pack-needs-4-pos-and-chain-out"); return 1; }
            return 0;
        }
        cx_fmt(why, wcap, "unknown-mode:%s", toks[0]);
        return 1;
    }
    if (tx_eqz(tool, "release-chain")) {
        if (nt < 1) { cx_fmt(why, wcap, "missing-subcmd"); return 1; }
        if (tx_eqz(toks[0], "run") || tx_eqz(toks[0], "plan")) {
            static const char *const vf[] = {"--inputs", "--state", "--layout", "--decisions", "--from", 0};
            if (sc_check_flags(toks, 1, nt, vf, 0, 0, 0, why, wcap)) return 1;
            if (!sc_has_flag(toks, 1, nt, "--inputs", 0, 0) || !sc_has_flag(toks, 1, nt, "--state", 0, 0) ||
                !sc_has_flag(toks, 1, nt, "--layout", 0, 0)) { cx_fmt(why, wcap, "release-chain-missing-required"); return 1; }
            return 0;
        }
        cx_fmt(why, wcap, "unknown-subcmd:%s", toks[0]);
        return 1;
    }
    if (tx_eqz(tool, "release-exec")) {
        if (nt < 1) { cx_fmt(why, wcap, "missing-mode"); return 1; }
        if (tx_eqz(toks[0], "--warm") || tx_eqz(toks[0], "--execute")) {
            static const char *const vf[] = {"--layout", "--out", "--from-step", "--strict", "--baseline", 0};
            static const char *const bf[] = {"--dry", 0};
            int npos = 0;
            if (sc_check_flags(toks, 1, nt, vf, bf, 1, &npos, why, wcap)) return 1;
            if (npos < 1 || !sc_has_flag(toks, 1, nt, "--layout", 0, 0)) { cx_fmt(why, wcap, "release-exec-needs-candidate-and-layout"); return 1; }
            return 0;
        }
        cx_fmt(why, wcap, "unknown-mode:%s", toks[0]);
        return 1;
    }
    if (tx_eqz(tool, "devsvc")) {
        if (nt < 1) { cx_fmt(why, wcap, "missing-subcmd"); return 1; }
        if (tx_eqz(toks[0], "ping") || tx_eqz(toks[0], "start")) return 0;
        if (tx_eqz(toks[0], "lock")) {
            if (nt < 3 || !tx_eqz(toks[1], "acquire")) { cx_fmt(why, wcap, "devsvc-lock-usage"); return 1; }
            static const char *const vf[] = {"--owner", "--ttl", 0};
            return sc_check_flags(toks, 3, nt, vf, 0, 0, 0, why, wcap);
        }
        if (tx_eqz(toks[0], "git")) {
            if (nt < 2) { cx_fmt(why, wcap, "devsvc-git-missing-op"); return 1; }
            if (tx_eqz(toks[1], "push") || tx_eqz(toks[1], "merge") || tx_eqz(toks[1], "commit")) return 0;
            cx_fmt(why, wcap, "devsvc-git-unknown:%s", toks[1]);
            return 1;
        }
        if (tx_eqz(toks[0], "x")) {
            int dash = -1;
            for (int i = 1; i < nt; i++) if (tx_eqz(toks[i], "--")) { dash = i; break; }
            if (dash < 0 || dash + 1 >= nt) { cx_fmt(why, wcap, "devsvc-x-needs-dashdash-and-cmd"); return 1; }
            static const char *const vf[] = {"--par", "--timeout-ms", "--cwd", "--owner", 0};
            static const char *const bf[] = {"--bg", 0};
            if (sc_check_flags(toks, 1, dash, vf, bf, 0, 0, why, wcap)) return 1;
            if (!sc_has_flag(toks, 1, dash, "--par", 0, 0)) { cx_fmt(why, wcap, "devsvc-x-needs-par"); return 1; }
            return 0;
        }
        cx_fmt(why, wcap, "unknown-subcmd:%s", toks[0]);
        return 1;
    }
    if (tx_eqz(tool, "merge-version")) {
        if (nt < 1) { cx_fmt(why, wcap, "missing-subcmd"); return 1; }
        if (tx_eqz(toks[0], "preview")) {
            static const char *const vf[] = {"--branch", "--base", "--repo", "--rules", "--work", 0};
            return sc_check_flags(toks, 1, nt, vf, 0, 0, 0, why, wcap);
        }
        if (tx_eqz(toks[0], "gate")) {
            if (nt < 2) { cx_fmt(why, wcap, "merge-version-gate-missing-name"); return 1; }
            static const char *const vf[] = {"--branch", "--repo", "--work", "--max-load", "--shard", "--shards", 0};
            return sc_check_flags(toks, 2, nt, vf, 0, 0, 0, why, wcap);
        }
        cx_fmt(why, wcap, "unknown-subcmd:%s", toks[0]);
        return 1;
    }
    if (tx_eqz(tool, "freeze-broadcast")) {
        if (nt < 1) { cx_fmt(why, wcap, "missing-subcmd"); return 1; }
        static const char *const vf[] = {"--windows-table", "--mux", "--tmux", "--lock", "--until", "--load-ceil", "--why", "--ledger-dir", "--from", "--session", 0};
        static const char *const bf[] = {"--dry", 0};
        return sc_check_flags(toks, 1, nt, vf, bf, 0, 0, why, wcap);
    }
    if (tx_eqz(tool, "check-release-prep")) {
        static const char *const vf[] = {"--part", "--notes", "--rollback", 0};
        return sc_check_flags(toks, 0, nt, vf, 0, 0, 0, why, wcap);
    }
    if (tx_eqz(tool, "release-post")) {
        if (nt < 1 || (!tx_eqz(toks[0], "run") && !tx_eqz(toks[0], "plan"))) { cx_fmt(why, wcap, "release-post-subcmd"); return 1; }
        static const char *const vf[] = {"--version", "--step", "--repo", "--evidence-dir", "--chain-dir", "--prerun-dir", "--backup-dir", "--state-file", 0};
        static const char *const bf[] = {"--dry", "--execute", "--root-upgrade", 0};
        return sc_check_flags(toks, 1, nt, vf, bf, 0, 0, why, wcap);
    }
    return 0;
}

static void sc_scan_cmd(const char *step_id, const char *cmd, int *checked, int *failed) {
    /* If cmd starts with "for p in A B C ...; do ", collect loop prefixes for chain-ready --only "$p". */
    char for_items[32][64];
    int nfor = 0;
    if (tx_prefix(cmd, tx_len(cmd, 2048), "for p in ", 9)) {
        const char *fp = cmd + 9;
        while (*fp && *fp != ';' && nfor < 32) {
            while (*fp == ' ' || *fp == '\t') fp++;
            if (!*fp || *fp == ';') break;
            int k = 0;
            while (*fp && *fp != ' ' && *fp != '\t' && *fp != ';' && k < 63) for_items[nfor][k++] = *fp++;
            for_items[nfor][k] = 0;
            if (k > 0) nfor++;
        }
    }
    const char *p = cmd;
    while (*p) {
        const char *m = strstr(p, "tools/");
        if (!m) break;
        const char *cx = strstr(m, ".cx --");
        if (!cx || cx - m <= 6 || cx - m > 60) { p = m + 6; continue; }
        char tool[64];
        long tl = (long)(cx - (m + 6));
        if (tl <= 0 || tl >= (long)sizeof tool) { p = cx + 6; continue; }
        mm_copy(tool, sizeof tool, m + 6, tl);
        tool[tl] = 0;
        const char *q = cx + 6;
        /* Tokenize arguments until shell separator (&&, ||, ;, #, ), end) */
        char toks[48][256];
        int nt = 0;
        while (*q && nt < 48) {
            while (*q == ' ' || *q == '\t') q++;
            if (!*q || *q == ';' || *q == '#' || *q == ')') break;
            if ((q[0] == '&' && q[1] == '&') || (q[0] == '|' && q[1] == '|')) break;
            int k = 0;
            if (*q == '"' || *q == '\'') {
                char quote = *q++;
                while (*q && *q != quote && k < 255) toks[nt][k++] = *q++;
                if (*q == quote) q++;
            } else {
                while (*q && *q != ' ' && *q != '\t' && *q != ';' && *q != '#' && *q != ')' && k < 255) {
                    if ((q[0] == '&' && q[1] == '&') || (q[0] == '|' && q[1] == '|')) break;
                    toks[nt][k++] = *q++;
                }
            }
            toks[nt][k] = 0;
            if (k > 0) nt++;
        }
        char why[128];
        int bad = sc_validate_tool(tool, toks, nt, why, sizeof why);
        /* Expand for-loop --only "$p" prefixes against chain-ready item table */
        if (!bad && tx_eqz(tool, "chain-ready")) {
            char onlyv[256]; onlyv[0] = 0;
            if (sc_has_flag(toks, 0, nt, "--only", onlyv, sizeof onlyv) && tx_eqz(onlyv, "$p")) {
                if (g_ncr <= 0) {
                    bad = 1;
                    cx_fmt(why, sizeof why, "chain-ready-items-unreadable");
                } else if (nfor <= 0) {
                    bad = 1;
                    cx_fmt(why, sizeof why, "chain-ready-for-loop-empty");
                } else {
                    for (int fi = 0; fi < nfor; fi++) {
                        if (!cr_prefix_matches(for_items[fi])) {
                            bad = 1;
                            cx_fmt(why, sizeof why, "chain-ready-only-no-match:%s", for_items[fi]);
                            break;
                        }
                    }
                }
            }
        }
        (*checked)++;
        if (bad) (*failed)++;
        printf("FREEZE_SELFCHECK\tstep=%s\ttool=%s\tstatus=%s\treason=%s\n",
            step_id, tool, bad ? "FAIL" : "OK", why);
        /* Advance past current tool invocation; for devsvc x, allow scanning nested tools/*.cx after "--" */
        if (tx_eqz(tool, "devsvc") && nt >= 2 && tx_eqz(toks[0], "x")) p = cx + 6;
        else p = q;
    }
}

static int cmd_plan(int argc, char **argv) {
    char ver[64], branch[96], repo[512], owner[64];
    char prerun_dir[512], chain_dir[512], ape_path[512], rd_bin[512], merge_tree[64];
    int no_rd = 0, selfcheck = 0;
    ver[0] = branch[0] = repo[0] = owner[0] = 0;
    prerun_dir[0] = chain_dir[0] = ape_path[0] = rd_bin[0] = merge_tree[0] = 0;

    for (int i = 2; i < argc; i++) {
        if (tx_eqz(argv[i], "--version") && i + 1 < argc) { if (cx_fmt(ver, sizeof ver, "%s", argv[++i])) return 2; }
        else if (tx_eqz(argv[i], "--branch") && i + 1 < argc) { if (cx_fmt(branch, sizeof branch, "%s", argv[++i])) return 2; }
        else if (tx_eqz(argv[i], "--repo") && i + 1 < argc) { if (cx_fmt(repo, sizeof repo, "%s", argv[++i])) return 2; }
        else if (tx_eqz(argv[i], "--owner") && i + 1 < argc) { if (cx_fmt(owner, sizeof owner, "%s", argv[++i])) return 2; }
        else if (tx_eqz(argv[i], "--prerun-dir") && i + 1 < argc) { if (cx_fmt(prerun_dir, sizeof prerun_dir, "%s", argv[++i])) return 2; }
        else if (tx_eqz(argv[i], "--chain-dir") && i + 1 < argc) { if (cx_fmt(chain_dir, sizeof chain_dir, "%s", argv[++i])) return 2; }
        else if (tx_eqz(argv[i], "--ape") && i + 1 < argc) { if (cx_fmt(ape_path, sizeof ape_path, "%s", argv[++i])) return 2; }
        else if (tx_eqz(argv[i], "--readiness-bin") && i + 1 < argc) { if (cx_fmt(rd_bin, sizeof rd_bin, "%s", argv[++i])) return 2; }
        else if (tx_eqz(argv[i], "--merge-tree") && i + 1 < argc) { if (cx_fmt(merge_tree, sizeof merge_tree, "%s", argv[++i])) return 2; }
        else if (tx_eqz(argv[i], "--no-readiness")) no_rd = 1;
        else if (tx_eqz(argv[i], "--selfcheck")) selfcheck = 1;
        else return die_usage("unknown-plan-arg");
    }
    if (!ver[0]) return die_usage("missing --version");
    if (!branch[0]) cx_fmt(branch, sizeof branch, "v%s", ver);
    if (!repo[0]) cx_fmt(repo, sizeof repo, ".");
    if (!owner[0]) cx_fmt(owner, sizeof owner, "cc");

    const char *home = sy_env("HOME");
    if (!home || !home[0]) home = "/tmp";
    if (!prerun_dir[0]) cx_fmt(prerun_dir, sizeof prerun_dir, "%s/.cache/unisacc/prerun-%s", home, ver);
    if (!chain_dir[0]) cx_fmt(chain_dir, sizeof chain_dir, "%s/.cache/unisacc/chains/%s", home, ver);

    char prev_ver[64], prev_sha[64], cand_ape[128], main_sha[64], head_tree[64], branch_sha[64], rev_full[64];
    int has_cand = (load_candidate_tsv(repo, prev_ver, sizeof prev_ver, prev_sha, sizeof prev_sha, cand_ape, sizeof cand_ape) == 0);
    if (!has_cand) {
        cx_fmt(prev_ver, sizeof prev_ver, "MISSING");
        cx_fmt(prev_sha, sizeof prev_sha, "MISSING");
        cx_fmt(cand_ape, sizeof cand_ape, "unisacc.com");
    }
    if (!ape_path[0]) cx_fmt(ape_path, sizeof ape_path, "%s/%s", chain_dir, cand_ape);

    if (git_rev(repo, "HEAD", 1, main_sha, sizeof main_sha) != 0) cx_fmt(main_sha, sizeof main_sha, "MISSING");
    int has_head_tree = (git_rev(repo, "HEAD^{tree}", 0, head_tree, sizeof head_tree) == 0);
    if (!has_head_tree) cx_fmt(head_tree, sizeof head_tree, "MISSING");
    int has_branch = (git_rev(repo, branch, 1, branch_sha, sizeof branch_sha) == 0);
    if (!has_branch) cx_fmt(branch_sha, sizeof branch_sha, "MISSING");
    if (git_rev(repo, has_branch ? branch : "HEAD", 0, rev_full, sizeof rev_full) != 0)
        cx_fmt(rev_full, sizeof rev_full, "0000000000000000000000000000000000000000");

    if (!no_rd) {
        run_readiness(repo, ver, rd_bin);
    } else {
        g_fr_ran = 0; g_nfr = 0; g_fr_blockers = 0;
        cx_fmt(g_fr_ready, sizeof g_fr_ready, "skipped");
    }
    if (!merge_tree[0]) {
        const fr_row_t *mr = find_fr("merge-s0-tree");
        if (mr) extract_tree_hash(mr->detail, merge_tree, sizeof merge_tree);
    }
    int has_merge_tree = (merge_tree[0] && !tx_eqz(merge_tree, "UNMEASURED"));
    if (!merge_tree[0]) cx_fmt(merge_tree, sizeof merge_tree, "UNMEASURED");

    char notes_p[640], rb_p[640], dec_p[640];
    cx_fmt(notes_p, sizeof notes_p, "%s/release/notes-%s.md", repo, ver);
    cx_fmt(rb_p, sizeof rb_p, "%s/release/rollback.txt", repo);
    cx_fmt(dec_p, sizeof dec_p, "%s/release/decision.txt", repo);
    int has_notes = (sy_exists(notes_p) == 1);
    int has_rb = (sy_exists(rb_p) == 1);
    int has_dec = (sy_exists(dec_p) == 1);

    printf("FREEZE_DAY_CTX\tversion=%s\tbranch=%s\tbranch_sha=%s\tmain_sha=%s\thead_tree=%s\tprev_version=%s\tprev_commit=%s\tmerge_tree=%s\towner=%s\treadiness_ready=%s\treadiness_blockers=%d\n",
        ver, branch, branch_sha, main_sha, head_tree, prev_ver, prev_sha, merge_tree, owner, g_fr_ready, g_fr_blockers);

    int blocked = 0, sc_checked = 0, sc_failed = 0;
    if (selfcheck) load_chain_ready_items(repo);
    for (int i = 0; i < FD_STEPS; i++) {
        char cmd[2048], why[512];
        cmd[0] = 0;
        cx_fmt(why, sizeof why, "-");
        int is_blk = 0;

        if (i == 0) { /* S0-preview */
            cx_fmt(cmd, sizeof cmd,
                "sh ./unisacc.com tools/merge-version.cx -- preview --branch %s --base main --work %s/mv-work # expect MERGE_VERSION verdict=READY tree=%s",
                branch, chain_dir, merge_tree);
            if (!has_branch) { is_blk = 1; add_reason(why, sizeof why, "branch-missing"); }
            if (fr_is_bad("merge-s0-tree")) { is_blk = 1; add_reason(why, sizeof why, "merge-s0-tree"); }
        } else if (i == 1) { /* S0-gates */
            cx_fmt(cmd, sizeof cmd,
                "# precheck uptime load1<8; each <=55s: "
                "sh ./unisacc.com tools/merge-version.cx -- gate traps --branch %s --work %s/mv-work && "
                "sh ./unisacc.com tools/merge-version.cx -- gate derive-write --branch %s --work %s/mv-work && "
                "sh ./unisacc.com tools/merge-version.cx -- gate derive-check --branch %s --work %s/mv-work && "
                "sh ./unisacc.com tools/merge-version.cx -- gate tests --branch %s --work %s/mv-work && "
                "sh ./unisacc.com tools/merge-version.cx -- gate ratchets --shards 3 --branch %s --work %s/mv-work "
                "# expect MERGE_GATE traps/derive-write/derive-check/tests OK and ratchets-total fail=0",
                branch, chain_dir, branch, chain_dir, branch, chain_dir, branch, chain_dir, branch, chain_dir);
            if (!has_branch) { is_blk = 1; add_reason(why, sizeof why, "branch-missing"); }
            if (fr_is_bad("merge-s0-tree")) { is_blk = 1; add_reason(why, sizeof why, "merge-s0-tree"); }
        } else if (i == 2) { /* S0-devsvc-alive */
            cx_fmt(cmd, sizeof cmd,
                "sh ./unisacc.com tools/devsvc.cx -- ping || (sh ./unisacc.com tools/devsvc.cx -- start && sh ./unisacc.com tools/devsvc.cx -- ping)");
        } else if (i == 3) { /* S0-lock */
            cx_fmt(cmd, sizeof cmd,
                "DEVSVC_OWNER=%s sh ./unisacc.com tools/devsvc.cx -- lock acquire freeze --owner %s --ttl 7200 && "
                "sh ./unisacc.com tools/freeze-broadcast.cx -- start --lock freeze --from %s",
                owner, owner, owner);
            if (fr_is_bad("devsvc-freeze")) { is_blk = 1; add_reason(why, sizeof why, "devsvc-freeze"); }
            if (fr_is_bad("hardlink-trees")) { is_blk = 1; add_reason(why, sizeof why, "hardlink-trees"); }
        } else if (i == 4) { /* S0-merge */
            cx_fmt(cmd, sizeof cmd,
                "DEVSVC_OWNER=%s sh ./unisacc.com tools/devsvc.cx -- git merge --no-ff %s # branch_sha=%s merge_tree=%s && "
                "DEVSVC_OWNER=%s sh ./unisacc.com tools/devsvc.cx -- git push",
                owner, branch, branch_sha, merge_tree, owner);
            if (!has_branch) { is_blk = 1; add_reason(why, sizeof why, "branch-missing"); }
            if (!has_cand) { is_blk = 1; add_reason(why, sizeof why, "candidate-tsv-missing"); }
            if (fr_is_bad("dirty-freeze-domain")) { is_blk = 1; add_reason(why, sizeof why, "dirty-freeze-domain"); }
            if (fr_is_bad("cx-mode-drift")) { is_blk = 1; add_reason(why, sizeof why, "cx-mode-drift"); }
            if (fr_is_bad("merge-s0-tree")) { is_blk = 1; add_reason(why, sizeof why, "merge-s0-tree"); }
            if (fr_is_bad("ahead-origin")) { is_blk = 1; add_reason(why, sizeof why, "ahead-origin"); }
            if (fr_is_bad("chain-1rev")) { is_blk = 1; add_reason(why, sizeof why, "chain-1rev"); }
        } else if (i == 5) { /* S0-verify-tree */
            cx_fmt(cmd, sizeof cmd,
                "t=$(git rev-parse HEAD^{tree}); case \"$t\" in %s*) echo \"MERGE_TREE_MATCH $t\" ;; *) echo \"MERGE_TREE_MISMATCH head=$t expect=%s\"; exit 1 ;; esac",
                merge_tree, merge_tree);
            if (has_merge_tree && (!has_head_tree || !tree_hash_matches(head_tree, merge_tree))) {
                is_blk = 1;
                add_reason(why, sizeof why, "head-tree-mismatch");
            }
        } else if (i == 6) { /* S0-freeze-slot */
            cx_fmt(cmd, sizeof cmd,
                "# write build/freeze.tsv %s row (col3==DEVSVC_OWNER==UNISACC_INTEGRATOR==%s lowercase); "
                "update release/candidate.tsv (%s -> %s); fill freeze_at in plans/v%s.md; "
                "DEVSVC_OWNER=%s sh ./unisacc.com tools/devsvc.cx -- git commit --derive -m \"freeze: %s freeze row, candidate slot and freeze_at\" --whole build/freeze.tsv --whole release/candidate.tsv --whole plans/v%s.md && "
                "sh ./unisacc.com tools/chain-ready.cx -- --only 11-version-slot --version %s",
                ver, owner, prev_ver, ver, ver, owner, ver, ver, ver);
            if (!has_cand) { is_blk = 1; add_reason(why, sizeof why, "candidate-tsv-missing"); }
            if (fr_is_bad("verseq")) { is_blk = 1; add_reason(why, sizeof why, "verseq"); }
            if (fr_is_bad("plan-freeze-at")) { is_blk = 1; add_reason(why, sizeof why, "plan-freeze-at"); }
        } else if (i == 7) { /* S1-light */
            cx_fmt(cmd, sizeof cmd,
                "for p in 1-rev 6-affected 7-recipe 8-inflight 9-ledger 10-envhygiene 11-version-slot 12-root-files 12p-preflight-entry 13-snap-cache 14-root-record 16-disk-free 17-root-public 20-ident-helper 21-verseq-gen; do "
                "sh ./unisacc.com tools/chain-ready.cx -- --version %s --only \"$p\" || exit 1; done",
                ver);
            if (fr_is_bad("chain-1rev")) { is_blk = 1; add_reason(why, sizeof why, "chain-1rev"); }
            if (fr_is_bad("verseq")) { is_blk = 1; add_reason(why, sizeof why, "verseq"); }
            if (fr_is_bad("plan-freeze-at")) { is_blk = 1; add_reason(why, sizeof why, "plan-freeze-at"); }
        } else if (i == 8) { /* S1-mid */
            cx_fmt(cmd, sizeof cmd,
                "for p in 2a-derive 2b-ratchets 3a-cxmod-tri 3b-cx0-extract 4-p1 15-gen-all 18-parse2-gen 19-chain-preflight 22-premerge-union; do "
                "sh ./unisacc.com tools/chain-ready.cx -- --version %s --only \"$p\" || exit 1; done",
                ver);
            if (fr_is_bad("ratchets")) { is_blk = 1; add_reason(why, sizeof why, "ratchets"); }
        } else if (i == 9) { /* S1-chain */
            cx_fmt(cmd, sizeof cmd,
                "sh ./unisacc.com tools/chain-ready.cx -- --version %s --only 5-candidate-chain # solo <=55s (baseline 53.5s)",
                ver);
        } else if (i == 10) { /* S2 */
            cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com tools/bg-candidate.cx -- start --rev %s", rev_full);
            if (!has_branch) { is_blk = 1; add_reason(why, sizeof why, "branch-missing"); }
        } else if (i == 11) { /* S3-inputs */
            cx_fmt(cmd, sizeof cmd,
                "sh ./unisacc.com tools/prerun-inputs.cx -- --rev %s --version %s --prev %s --prev-rev %s --ape %s --dir %s",
                branch_sha, ver, prev_ver, prev_sha, ape_path, prerun_dir);
            if (!has_cand) { is_blk = 1; add_reason(why, sizeof why, "candidate-tsv-missing"); }
            if (!has_branch) { is_blk = 1; add_reason(why, sizeof why, "branch-missing"); }
        } else if (i == 12) { /* S3-run */
            cx_fmt(cmd, sizeof cmd,
                "# precheck uptime load1<8 (if load1>12 downgrade to --window-lanes 2 --max-jobs 6); "
                "sh ./unisacc.com tools/prerun-drive.cx -- plan --ids-file %s/ids.txt --times-file %s/times.tsv --priority-file %s/priority.tsv --out %s --normal-jobs 8 --window-lanes 3 && "
                "sh ./unisacc.com tools/prerun-drive.cx -- run --root . --candidate %s --out %s --resume --max-jobs 8 --window-lanes 3 --keep-going "
                "# judge: PRERUN_SUMMARY 0 FAIL, UNKNOWN only in expected-unmeasured.tsv, verify l0-posix2 first-run result",
                prerun_dir, prerun_dir, prerun_dir, prerun_dir, ape_path, prerun_dir);
        } else if (i == 13) { /* S3b */
            cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com tools/ci-early.cx -- --rev %s --version %s", rev_full, ver);
            if (!has_branch) { is_blk = 1; add_reason(why, sizeof why, "branch-missing"); }
        } else if (i == 14) { /* S3c */
            cx_fmt(cmd, sizeof cmd,
                "sh ./unisacc.com tools/check-release-prep.cx -- --part notes --notes release/notes-%s.md && "
                "sh ./unisacc.com tools/check-release-prep.cx -- --part rollback --rollback release/rollback.txt",
                ver);
            if (!has_notes) { is_blk = 1; add_reason(why, sizeof why, "missing-notes-template"); }
            if (!has_rb) { is_blk = 1; add_reason(why, sizeof why, "missing-rollback-template"); }
            if (fr_is_bad("release-prep-notes")) { is_blk = 1; add_reason(why, sizeof why, "release-prep-notes"); }
            if (fr_is_bad("release-prep-rollback")) { is_blk = 1; add_reason(why, sizeof why, "release-prep-rollback"); }
        } else if (i == 15) { /* S4 */
            cx_fmt(cmd, sizeof cmd,
                "sh ./unisacc.com tools/prerun-drive.cx -- merge --in-dir %s --out %s --version %s && "
                "sh ./unisacc.com tools/prerun-drive.cx -- archive --in-dir %s --version %s",
                prerun_dir, prerun_dir, ver, prerun_dir, ver);
        } else if (i == 16) { /* S4b-renew-lock */
            cx_fmt(cmd, sizeof cmd,
                "DEVSVC_OWNER=%s sh ./unisacc.com tools/devsvc.cx -- lock acquire freeze --owner %s --ttl 7200 # renew before S5 (<90m)",
                owner, owner);
        } else if (i == 17) { /* S5 */
            cx_fmt(cmd, sizeof cmd,
                "sh ./unisacc.com tools/release-run.cx -- --pack . release/candidate.tsv %s/src %s/pack --chain-out %s && "
                "sh ./unisacc.com tools/release-exec.cx -- --warm %s/pack/candidate.tsv --layout %s/pack/layout --out %s/warm",
                chain_dir, chain_dir, chain_dir, chain_dir, chain_dir, chain_dir);
        } else if (i == 18) { /* S6 */
            cx_fmt(cmd, sizeof cmd,
                "sh ./unisacc.com tools/release-chain.cx -- run --inputs %s/inputs.tsv --state %s/state --layout %s/pack/layout --from 1",
                prerun_dir, chain_dir, chain_dir);
        } else if (i == 19) { /* S7 */
            cx_fmt(cmd, sizeof cmd,
                "sh ./unisacc.com tools/release-chain.cx -- run --inputs %s/inputs.tsv --state %s/state --layout %s/pack/layout --from 3 "
                "# stage release/notes-%s.md release/rollback.txt release/decision.txt",
                prerun_dir, chain_dir, chain_dir, ver);
            if (!has_notes) { is_blk = 1; add_reason(why, sizeof why, "missing-notes-template"); }
            if (!has_rb) { is_blk = 1; add_reason(why, sizeof why, "missing-rollback-template"); }
            if (!has_dec) { is_blk = 1; add_reason(why, sizeof why, "missing-decision-template"); }
        } else if (i == 20) { /* S8 */
            cx_fmt(cmd, sizeof cmd,
                "sh ./unisacc.com tools/release-chain.cx -- run --inputs %s/inputs.tsv --state %s/state --layout %s/pack/layout --from 4",
                prerun_dir, chain_dir, chain_dir);
        } else if (i == 21) { /* S8b-renew-lock */
            cx_fmt(cmd, sizeof cmd,
                "DEVSVC_OWNER=%s sh ./unisacc.com tools/devsvc.cx -- lock acquire freeze --owner %s --ttl 7200 # renew before S9 execute",
                owner, owner);
        } else if (i == 22) { /* S9 */
            cx_fmt(cmd, sizeof cmd,
                "DEVSVC_OWNER=%s sh ./unisacc.com tools/devsvc.cx -- x --bg --par 1 -- sh ./unisacc.com tools/release-exec.cx -- --execute release/candidate.tsv --layout %s/pack/layout --out %s/exec",
                owner, chain_dir, chain_dir);
        } else if (i == 23) { /* S10 */
            cx_fmt(cmd, sizeof cmd,
                "sh ./unisacc.com tools/release-post.cx -- run --version %s --dry && "
                "sh ./unisacc.com tools/freeze-broadcast.cx -- end --dry --from %s",
                ver, owner);
        }

        if (is_blk) blocked++;
        char exp_disp[128];
        long el = tx_len(g_specs[i].expect, sizeof exp_disp - 1);
        for (long k = 0; k < el; k++) exp_disp[k] = g_specs[i].expect[k] == '\t' ? ' ' : g_specs[i].expect[k];
        exp_disp[el] = 0;
        printf("FREEZE_STEP\tid=%s\twho=%s\tbudget_s=%d\tgate=%s\treason=%s\texpect=%s\tcmd=%s\n",
            g_specs[i].id, g_specs[i].who, g_specs[i].budget_s,
            is_blk ? "BLOCKED" : "READY", why, exp_disp, cmd);
        if (selfcheck) sc_scan_cmd(g_specs[i].id, cmd, &sc_checked, &sc_failed);
    }

    printf("FREEZE_DAY\tplan\tsteps=%d\tblocked=%d\n", FD_STEPS, blocked);
    if (selfcheck) {
        printf("FREEZE_DAY\tselfcheck\tchecked=%d\tfailed=%d\n", sc_checked, sc_failed);
        if (sc_failed > 0) return 1;
    }
    return 0;
}

static int cmd_check(int argc, char **argv) {
    char step[64], logf[1024];
    step[0] = logf[0] = 0;
    for (int i = 2; i < argc; i++) {
        if (tx_eqz(argv[i], "--step") && i + 1 < argc) { if (cx_fmt(step, sizeof step, "%s", argv[++i])) return 2; }
        else if (tx_eqz(argv[i], "--log") && i + 1 < argc) { if (cx_fmt(logf, sizeof logf, "%s", argv[++i])) return 2; }
        else return die_usage("unknown-check-arg");
    }
    if (!step[0] || !logf[0]) return die_usage("check requires --step and --log");

    const step_spec_t *sp = 0;
    for (int i = 0; i < FD_STEPS; i++) {
        if (tx_eqz(g_specs[i].id, step)) { sp = &g_specs[i]; break; }
    }
    if (!sp) return die_usage("unknown-step-id");

    unsigned char *raw = 0;
    int64_t sz = 0;
    if (sy_read_file(logf, &raw, &sz, 16 << 20) != 0 || !raw) {
        mm_free(raw);
        return die_usage("log-unreadable");
    }
    long el = tx_len(sp->expect, 128);
    int found = (sz > 0 && tx_find((const char *)raw, (long)sz, sp->expect, el) >= 0);
    mm_free(raw);
    printf("FREEZE_DAY\tcheck\tstep=%s\tstatus=%s\texpect=%s\tlog=%s\n",
        sp->id, found ? "PASS" : "FAIL", sp->expect, logf);
    return found ? 0 : 1;
}

int main(int argc, char **argv) {
    if (argc < 2) return die_usage("subcommand plan|check required");
    if (tx_eqz(argv[1], "plan")) return cmd_plan(argc, argv);
    if (tx_eqz(argv[1], "check")) return cmd_check(argc, argv);
    return die_usage("unknown subcommand");
}
