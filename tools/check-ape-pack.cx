/* Explicit candidate only: cache retention, manager reuse and unsafe-path fallback. */
#pragma unisa use sysx.process
#pragma unisa use sys.time
#pragma unisa use sys.hostid
#pragma unisa use mem.bytes
static int checks,failed;static long deadline;static char ape[4400],base[4400],key[17],manager_key[17],payload_sha[65];static const char *arch;
static void die(const char*s){fprintf(stderr,"check-ape-pack: %s\n",s);exit(2);}
static void ck(int yes,const char*s){checks++;failed+=!yes;printf("%s\t%s\n",yes?"PASS":"FAIL",s);}
static void path(char*p,size_t n,const char*a,const char*b){if(cx_fmt(p,n,"%s/%s",a,b))die("path bound");}
static void make(const char*p){if(mkdir(p,0700))die("fresh directory");}
static void put(const char*p,const char*s){if(cx_write(p,s,strlen(s)))die("fixture write");}
static int exists(const char*p){struct stat st;if(!lstat(p,&st))return 1;if(errno!=ENOENT)die("lstat error");return 0;}
static int regular(const char*p,struct stat*st){if(lstat(p,st))die("required file stat");return S_ISREG(st->st_mode)&&st->st_uid==getuid()&&st->st_nlink==1;}
static void hash(const char*p,char h[65]){struct stat st;if(!regular(p,&st)||st.st_size<0||st.st_size>67108864)die("bounded regular input");size_t n;char*b=cx_read(p,&n);if(!b||n!=(size_t)st.st_size)die("read extent");cx_sha256_hex(b,n,h);free(b);}
static int hex16(const char*s){if(strlen(s)!=16)return 0;for(int i=0;i<16;i++)if(!((s[i]>='0'&&s[i]<='9')||(s[i]>='a'&&s[i]<='f')))return 0;return 1;}
static void parse_keys(void){size_t n;char*b=cx_read(ape,&n);if(!b||n>67108864)die("APE read");const char*prefix=!strcmp(arch,"-arm64")?"Darwinarm64) o=":"Darwinx86_64) o=";size_t pn=strlen(prefix);int found=0;for(size_t i=0;i+pn<n;i++){if(memcmp(b+i,prefix,pn))continue;size_t len=0;while(i+len<n&&b[i+len]!='\n'&&len<511)len++;if(len==511||i+len==n)die("managed dispatcher line bound");char line[512];if(mm_copy(line,sizeof line,b+i,len))die("dispatcher copy");line[len]=0;char semi1,semi2,extra;long o,z,h,q;if(sscanf(line+pn,"%ld n=%ld k=%16s h=%ld z=%ld j=%16s s=%64s%c%c%c",&o,&z,key,&h,&q,manager_key,payload_sha,&semi1,&semi2,&extra)!=9||semi1!=';'||semi2!=';'||!hex16(key)||!hex16(manager_key)||strlen(payload_sha)!=64||strncmp(payload_sha,key,16)||o<1||z<1||h<1||q<1)die("managed dispatcher schema");for(int k=0;k<64;k++)if(!((payload_sha[k]>='0'&&payload_sha[k]<='9')||(payload_sha[k]>='a'&&payload_sha[k]<='f')))die("dispatcher full SHA");found++;}free(b);if(found!=1)die("exactly one managed Darwin dispatcher required");}
static int count_prefix(const char*dir,const char*prefix,int payload){DIR*d=opendir(dir);if(!d)die("scan directory");int count=0,seen=0;for(;;){errno=0;struct dirent*e=readdir(d);if(!e){if(errno||closedir(d))die("scan read");return count;}if(++seen>256)die("directory scan bound");if(!strcmp(e->d_name,".")||!strcmp(e->d_name,".."))continue;if(prefix&&strncmp(e->d_name,prefix,strlen(prefix)))continue;if(payload&&!hex16(e->d_name+strlen(prefix)))continue;count++;}}
static void fresh(const char*name,char cache[4400],char tmp[4400],char managed[4400]){char p[4400];path(p,sizeof p,base,name);make(p);path(cache,4400,p,"cache");make(cache);path(tmp,4400,p,"tmp");make(tmp);path(managed,4400,cache,"unisacc");make(managed);}
static int launch(const char*label,const char*cache,const char*tmp){if(deadline-sy_now_ms()<5500)die("overall deadline lacks full child window");char a[4600],b[4600];if(cx_fmt(a,sizeof a,"XDG_CACHE_HOME=%s",cache)||cx_fmt(b,sizeof b,"TMPDIR=%s",tmp))die("environment bound");char*env[]={a,b,0};char*v[]={"/usr/bin/arch",(char*)arch,"/bin/sh",ape,"--version",0};np_result r={0};char why[1000]={0};long start=sy_now_ms();int tr=np_run(v,0,env,5,&r,why,sizeof why);int good=!tr&&!r.residue&&!r.rc&&r.out&&strstr(r.out,"unisacc");printf("APE_PACK_LAUNCH\tjob=%s\tms=%ld\trc=%d\ttransport=%d\tresidue=%d\tversion_valid=%d\n",label,sy_now_ms()-start,r.rc,tr,r.residue,good);if(!good){fprintf(stderr,"%s\n",why);if(r.errn)fwrite(r.err,1,r.errn,stderr);}np_free(&r);return good;}
static void old_payloads(const char*d){for(int i=0;i<5;i++){char body[100],sha[65],name[100],p[4400],marker[100];if(cx_fmt(body,sizeof body,"old-managed-fixture-%d\n",i))die("fixture body");cx_sha256_hex(body,strlen(body),sha);char k[17];if(mm_copy(k,sizeof k,sha,16))die("key copy");k[16]=0;if(cx_fmt(name,sizeof name,"unisacc-%s",k))die("payload name");path(p,sizeof p,d,name);put(p,body);if(chmod(p,0700))die("payload mode");if(cx_fmt(name,sizeof name,"unisacc.managed-v1-%s",k)||cx_fmt(marker,sizeof marker,"APE_CACHE_V1\tsha=%s\n",sha))die("marker bound");path(p,sizeof p,d,name);put(p,marker);if(sy_set_mtime(p,1000000000+i))die("ordered marker stamp");}}
static void current_state(const char*d){char p[4400],name[200],h[65],expected[512];struct stat st;if(cx_fmt(name,sizeof name,"unisacc-%s",key))die("current name");path(p,sizeof p,d,name);ck(regular(p,&st),"current payload is owned regular file");hash(p,h);ck(!strcmp(h,payload_sha),"current payload matches dispatcher full SHA");if(cx_fmt(expected,sizeof expected,"APE_CACHE_V2\tname=%s\ttype=%s\tsha=%s\n",name,strncmp(h,key,16)?"legacy-compressed-key":"raw-key",h))die("current marker");if(cx_fmt(name,sizeof name,"unisacc.managed-v1-%s",key))die("marker name");path(p,sizeof p,d,name);size_t n;char*s=cx_read(p,&n);ck(s&&strlen(expected)==n&&!memcmp(s,expected,n),"current marker binds actual payload SHA");free(s);if(cx_fmt(name,sizeof name,"unisacc.lease-v1-%s-",key))die("lease prefix");ck(count_prefix(d,name,0)>0,"current lease remains present");}
static int lease_names(const char*d,char names[32][160]){DIR*dir=opendir(d);if(!dir)die("lease snapshot directory");int n=0,scanned=0;for(;;){errno=0;struct dirent*e=readdir(dir);if(!e){if(errno||closedir(dir))die("lease snapshot read");return n;}if(++scanned>256)die("lease snapshot scan bound");if(strncmp(e->d_name,"unisacc.lease-v1-",17))continue;if(n==32||mm_copy(names[n],160,e->d_name,strlen(e->d_name)+1))die("lease snapshot bound");n++;}}
static void hot_no_manager(void){
char p[4400],cache[4400],tmp[4400],d[4400],file[4400],real[4400],marker[4400],body[9300],before[65],after[65];
path(p,sizeof p,base,"retention");path(cache,sizeof cache,p,"cache");path(tmp,sizeof tmp,p,"tmp");path(d,sizeof d,cache,"unisacc");path(p,sizeof p,d,".managers");path(file,sizeof file,p,manager_key);path(real,sizeof real,base,"m.real");path(marker,sizeof marker,base,"FULL_MANAGER_EXECUTED");
size_t bn;char*binary=cx_read(file,&bn);if(!binary||cx_write(real,binary,bn)||chmod(real,0700))die("private real manager copy");free(binary);
if(cx_fmt(body,sizeof body,"#!/bin/sh\nif [ \"$1\" = --touch ]; then exec '%s' \"$@\"; fi\n: > '%s'\nexit 75\n",real,marker))die("hot manager fixture");put(file,body);if(chmod(file,0700))die("hot fixture mode");hash(file,before);
char planted[6][160];for(int k=0;k<2;k++)for(int j=0;j<3;j++){long pid=99999990+j;errno=0;if(kill(pid,0)!=-1||errno!=ESRCH)die("fixture PID is not certainly dead");if(cx_fmt(planted[k*3+j],sizeof planted[0],"unisacc.lease-v1-%s-%ld",k?"0123456789abcdef":key,pid))die("dead lease name");path(p,sizeof p,d,planted[k*3+j]);put(p,"");}
char previous[32][160],next[32][160];char prefix[100];if(cx_fmt(prefix,sizeof prefix,"unisacc.lease-v1-%s-",key))die("current lease prefix");
for(int iteration=0;iteration<12;iteration++){int np=lease_names(d,previous);char label[80];if(cx_fmt(label,sizeof label,"hot-touch-%d",iteration+1))die("hot iteration label");ck(launch(label,cache,tmp),"hot touch fixture preserves successful version");ck(!exists(marker),"hot path never calls manager full mode");int nn=lease_names(d,next),fresh_pid=0,dead_gone=1;for(int j=0;j<nn;j++)if(!strncmp(next[j],prefix,strlen(prefix))){int old=0;for(int i=0;i<np;i++)if(!strcmp(previous[i],next[j]))old=1;if(!old)fresh_pid=1;}for(int i=0;i<np;i++){path(p,sizeof p,d,previous[i]);if(exists(p))dead_gone=0;}ck(fresh_pid,"new parent PID receives a distinct current-key lease");ck(dead_gone,"all previous dead parent leases are removed");ck(nn==1,"twelve repeated hot launches keep lease count stable at one");}
for(int i=0;i<6;i++){path(p,sizeof p,d,planted[i]);ck(!exists(p),"cross-key planted dead lease is reclaimed");}
hash(file,after);ck(!strcmp(before,after),"hot path leaves touch-only manager fixture byte-identical");current_state(d);ck(count_prefix(d,"unisacc-",1)==4,"touch-only hot path retains four managed payloads");ck(count_prefix(tmp,0,0)==0,"touch-only hot path leaves no isolated TMP output");}
static void attack(const char*label,int directory){if(!directory)hot_no_manager();char cache[4400],tmp[4400],d[4400],external[4400],script[4400],marker[4400],m[4400],target[4400],body[9000],h[65],after[65];fresh(label,cache,tmp,d);path(external,sizeof external,base,directory?"external-dir":"external-file");make(external);path(script,sizeof script,external,manager_key);path(marker,sizeof marker,external,"EXECUTED");if(cx_fmt(body,sizeof body,"#!/bin/sh\n: > '%s'\nexit 0\n",marker))die("external marker script");put(script,body);if(chmod(script,0700))die("external script mode");hash(script,h);path(m,sizeof m,d,".managers");if(directory){if(symlink(external,m))die("symlink manager directory");}else{make(m);path(target,sizeof target,m,manager_key);if(symlink(script,target))die("symlink manager file");}ck(launch(label,cache,tmp),directory?"symlink manager directory uses successful isolated fallback":"symlink manager file uses successful isolated fallback");ck(!exists(marker),directory?"symlink directory never executes external script":"symlink file never executes external script");hash(script,after);ck(!strcmp(h,after),"external manager target remains byte-identical");struct stat st;const char*link=directory?m:target;ck(!lstat(link,&st)&&S_ISLNK(st.st_mode),"unsafe symlink remains a symlink");ck(count_prefix(tmp,0,0)==0,"isolated fallback removes external TMP payload and directory");}
int main(int argc,char**argv){if(argc!=3){fprintf(stderr,"usage: check-ape-pack APE arm64|x86_64\n");return 2;}if(strncmp(tn_self(),"osx/",4))die("Darwin host required");arch=!strcmp(argv[2],"arm64")?"-arm64":!strcmp(argv[2],"x86_64")?"-x86_64":0;if(!arch||!realpath(argv[1],ape))die("explicit candidate and architecture");deadline=sy_now_ms()+52000;char before[65],after[65];hash(ape,before);parse_keys();char pattern[]="/tmp/check-ape-pack-XXXXXX";if(!mkdtemp(pattern)||!realpath(pattern,base))die("private fixture root");printf("APE_PACK_IDENTITY\tsha256=%s\tarch=%s\tpayload_key=%s\tmanager_key=%s\tretained=%s\n",before,argv[2],key,manager_key,base);char cache[4400],tmp[4400],d[4400],m[4400],file[4400],h[65];fresh("retention",cache,tmp,d);old_payloads(d);ck(launch("cold",cache,tmp),"cold candidate version succeeds");ck(count_prefix(d,"unisacc-",1)==4,"exactly four managed payloads retained including current");current_state(d);path(m,sizeof m,d,".managers");struct stat ds,st;ck(!lstat(m,&ds)&&S_ISDIR(ds.st_mode)&&(ds.st_mode&0777)==0700&&ds.st_uid==getuid(),"single owned private managers directory");ck(count_prefix(m,0,0)==1,"managers directory has exactly one manager");path(file,sizeof file,m,manager_key);ck(regular(file,&st)&&(st.st_mode&0777)==0700,"manager is owned regular executable mode 0700");hash(file,h);ck(!strncmp(h,manager_key,16),"manager filename equals actual binary SHA16");struct stat initial=st;for(int i=0;i<2;i++){if(sy_sleep_ms(1100))die("mtime observation delay");ck(launch(i?"hot2":"hot1",cache,tmp),"hot candidate version succeeds");ck(regular(file,&st)&&st.st_ino==initial.st_ino&&st.st_dev==initial.st_dev&&st.st_mtime==initial.st_mtime&&st.st_size==initial.st_size,"hot launch reuses manager inode and mtime");current_state(d);ck(count_prefix(d,"unisacc-",1)==4,"hot launch retains exactly four payloads");}attack("symlink-file",0);attack("symlink-directory",1);hash(ape,after);ck(!strcmp(before,after),"explicit candidate SHA stable throughout check");if(sy_now_ms()>deadline)die("overall check deadline");printf("APE_PACK_CHECK\tchecks=%d\tfailed=%d\tarch=%s\tcandidate=%s\n",checks,failed,argv[2],before);return failed?1:0;}
