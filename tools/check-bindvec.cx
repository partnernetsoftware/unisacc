/* Narrow check for the runargs index helpers. Not the 32-use unit
   check: that program is already at 64 units. */
#pragma unisa use compiler.bindvec

static int g_fail;

static void note(int ok, const char *name) {
    printf("%s %s\n", ok ? "PASS" : "FAIL", name);
    if (!ok) g_fail = g_fail + 1;
}

int main(void) {
    note(bx_run_slots(1, 0) == 3, "slots-one");
    note(bx_run_slots(4, 2) == 8, "slots-env");
    note(bx_run_slots(0, 0) == 2, "slots-zero");
    note(bx_run_slots(-1, 0) == 1, "slots-neg");
    note(bx_run_arg_at(2, 2) == 1, "arg-first");
    note(bx_run_arg_at(2, 5) == 4, "arg-later");
    note(bx_run_arg_at(4, 1) == -2, "arg-before");
    note(bx_run_nul(4) == 4, "nul");
    note(bx_run_nul(0) == 0, "nul-zero");
    note(bx_run_env_at(4, 0) == 5, "env-first");
    note(bx_run_env_at(4, 2) == 7, "env-last");
    note(bx_run_env_at(1, -1) == 1, "env-neg");
    printf("BINDVEC failed=%d\n", g_fail);
    return g_fail ? 1 : 0;
}
