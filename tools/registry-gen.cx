/* tools/registry-gen.cx -- shard-manifest splitter, synthesizer, checker, and real-insert shard probe (0.0.87 S5a).
 * Source-of-truth tables covered (3 tables; derived tables like batch-domain-index/links/table-index stay in derive.cx):
 *   0: batches               -> tests/batches.tsv               (key = col 0 id)
 *   1: coverage              -> tests/coverage.tsv              (key = col 0 id)
 *   2: tools-compile-sources -> tests/tools-compile-sources.tsv (key = col 0 path)
 *
 * Manifest shard format (DIR/<safe_id>.tsv):
 *   # registry-shard-v1
 *   <table_name>\t<seq>\t<key>\t<raw_line>\n
 * Header & fidelity metadata (DIR/_headers.tsv):
 *   # registry-headers-v1
 *   <table_name>\tMETA\ttrailing_nl=0|1\n
 *   <table_name>\tHDR\t<seq>\t<raw_leading_header_or_comment>\n
 *   <table_name>\tMID\t<seq>\t<raw_mid_comment_or_blank>\n
 *
 * Safety invariants enforced on --split / --check / --write:
 *   (1) Reversible case-safe filename encoding (%xx for uppercase & non-[a-z0-9-]); >160B truncated + sha256 suffix;
 *       filename collision refused (rc=2).
 *   (2) Every shard row key must match its filename safe_id(tid, key).tsv (else rc=2 shard-filename-mismatch).
 *   (3) Every (table, key) must be unique across all shard files (else rc=2 duplicate-key).
 *   (4) Exact roundtrip fidelity for mid-file comments, blank lines, and missing trailing newline.
 *
 * Usage:
 *   sh ./unisacc.com tools/registry-gen.cx -- --split --root ROOT --dir OUT_DIR
 *   sh ./unisacc.com tools/registry-gen.cx -- --check [--root ROOT] [--dir DIR]
 *   sh ./unisacc.com tools/registry-gen.cx -- --write --root ROOT --dir DIR [--out OUT_DIR]
 *   sh ./unisacc.com tools/registry-gen.cx -- --shard-experiment [--root ROOT]
 * Check: tools/check-registry-gen.cx (batch registry-gen)
 */
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.env
#pragma unisa use sys.sha
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use text.text
#pragma unisa use cxlib.netpack

#define RG_NTABLES 3

static const char *const RG_TNAME[RG_NTABLES] = {
    "batches",
    "coverage",
    "tools-compile-sources"
};

static const char *const RG_TPATH[RG_NTABLES] = {
    "tests/batches.tsv",
    "tests/coverage.tsv",
    "tests/tools-compile-sources.tsv"
};

static void die(const char *m) {
    fprintf(stderr, "registry-gen: REFUSE %s\n", m);
    exit(2);
}

static int find_table(const char *name, size_t n) {
    for (int i = 0; i < RG_NTABLES; i++) {
        if (strlen(RG_TNAME[i]) == n && !memcmp(RG_TNAME[i], name, n)) return i;
    }
    return -1;
}

typedef struct {
    int tid;
    int kind;    /* 0 = HDR (leading), 1 = DATA, 2 = MID (mid-file comment/blank) */
    long seq;
    char *key;
    char *raw;
    size_t raw_len;
} RegRow;

typedef struct {
    RegRow *v;
    int n;
    int cap;
} RowVec;

static void rv_push(RowVec *rv, int tid, int kind, long seq, const char *key, size_t kn, const char *raw, size_t rn) {
    if (rv->n == rv->cap) {
        int nc = rv->cap ? rv->cap * 2 : 512;
        RegRow *nv = (RegRow *)mm_alloc((long)nc * (long)sizeof(RegRow));
        if (!nv) die("oom");
        if (rv->v) {
            mm_copy(nv, (long)nc * (long)sizeof(RegRow), rv->v, (long)rv->n * (long)sizeof(RegRow));
            mm_free(rv->v);
        }
        rv->v = nv;
        rv->cap = nc;
    }
    RegRow *r = &rv->v[rv->n++];
    r->tid = tid;
    r->kind = kind;
    r->seq = seq;
    r->key = (char *)mm_alloc((long)kn + 1);
    r->raw = (char *)mm_alloc((long)rn + 1);
    if (!r->key || !r->raw) die("oom");
    if (kn) mm_copy(r->key, (long)kn + 1, key, (long)kn);
    r->key[kn] = 0;
    if (rn) mm_copy(r->raw, (long)rn + 1, raw, (long)rn);
    r->raw[rn] = 0;
    r->raw_len = rn;
}

static void rv_free(RowVec *rv) {
    for (int i = 0; i < rv->n; i++) {
        mm_free(rv->v[i].key);
        mm_free(rv->v[i].raw);
    }
    if (rv->v) mm_free(rv->v);
    rv->v = 0; rv->n = 0; rv->cap = 0;
}

static int rv_cmp_order(const void *a, const void *b) {
    const RegRow *ra = (const RegRow *)a;
    const RegRow *rb = (const RegRow *)b;
    if (ra->tid != rb->tid) return ra->tid - rb->tid;
    int ha = (ra->kind == 0) ? 0 : 1;
    int hb = (rb->kind == 0) ? 0 : 1;
    if (ha != hb) return ha - hb; /* leading headers first */
    long sa = ra->seq > 0 ? ra->seq : 1000000000L;
    long sb = rb->seq > 0 ? rb->seq : 1000000000L;
    if (sa != sb) return sa < sb ? -1 : 1;
    return strcmp(ra->key, rb->key);
}

static int rv_cmp_key(const void *a, const void *b) {
    const RegRow *ra = (const RegRow *)a;
    const RegRow *rb = (const RegRow *)b;
    if (ra->tid != rb->tid) return ra->tid - rb->tid;
    return strcmp(ra->key, rb->key);
}

/* Reversible, case-insensitive-FS-safe shard stem encoding:
 *   prefix: b- (batches), c- (coverage), t- (tools-compile-sources)
 *   [a-z0-9-] kept verbatim; ALL other bytes (including A-Z, /, ., _, space, %, etc.) -> %xx lowercase hex.
 *   If encoded stem exceeds 160 bytes, truncate to 120 bytes + "-h" + sha256(key)[0..15]. */
static void safe_shard_name(int tid, const char *key, char *out, size_t cap) {
    static const char hx[] = "0123456789abcdef";
    const char *pre = tid == 0 ? "b-" : (tid == 1 ? "c-" : "t-");
    char enc[2048];
    size_t at = 0;
    enc[at++] = pre[0];
    enc[at++] = pre[1];
    int overflow = 0;
    for (const unsigned char *p = (const unsigned char *)key; *p; p++) {
        unsigned char c = *p;
        if ((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-') {
            if (at + 1 >= sizeof enc) { overflow = 1; break; }
            enc[at++] = (char)c;
        } else {
            if (at + 3 >= sizeof enc) { overflow = 1; break; }
            enc[at++] = '%';
            enc[at++] = hx[c >> 4];
            enc[at++] = hx[c & 15];
        }
    }
    enc[at] = 0;
    if (overflow || at > 160) {
        char sha[65];
        if (sy_sha256_hex((const unsigned char *)key, strlen(key), sha)) die("sha256");
        size_t keep = at > 120 ? 120 : at;
        /* Do not cut inside a %xx escape */
        if (keep >= 1 && enc[keep - 1] == '%') keep -= 1;
        else if (keep >= 2 && enc[keep - 2] == '%') keep -= 2;
        if (keep + 19 >= cap) die("shard-name-bound");
        mm_copy(out, (long)cap, enc, (long)keep);
        out[keep] = '-';
        out[keep + 1] = 'h';
        mm_copy(out + keep + 2, (long)(cap - keep - 2), sha, 16);
        out[keep + 18] = 0;
    } else {
        if (at + 1 > cap) die("shard-name-bound");
        mm_copy(out, (long)cap, enc, (long)at + 1);
    }
}

static int is_leading_header(int tid, long line_no, const char *s, size_t len) {
    if (len == 0) return 1;
    if (s[0] == '#') return 1;
    if ((tid == 0 || tid == 1) && line_no == 1 && len >= 3 && !memcmp(s, "id\t", 3)) return 1;
    return 0;
}

static int do_split(const char *root, const char *dir) {
    if (sy_mkdir_all(dir, 0755)) die("mkdir-dir");
    np_buf hdrs = {0};
    np_puts(&hdrs, "# registry-headers-v1\n");

    int shard_files = 0;
    int total_rows = 0;
    RowVec all = {0};

    for (int tid = 0; tid < RG_NTABLES; tid++) {
        char fp[4400];
        if (cx_fmt(fp, sizeof fp, "%s/%s", root, RG_TPATH[tid])) die("path-bound");
        size_t fn = 0;
        char *fb = cx_read(fp, &fn);
        if (!fb) die(RG_TPATH[tid]);
        int trailing_nl = (fn == 0 || fb[fn - 1] == '\n') ? 1 : 0;
        {
            char mline[128];
            cx_fmt(mline, sizeof mline, "%s\tMETA\ttrailing_nl=%d\n", RG_TNAME[tid], trailing_nl);
            np_puts(&hdrs, mline);
        }
        char *cur = fb, *end = fb + fn;
        long lno = 0;
        int seen_data = 0;
        while (cur < end) {
            lno++;
            char *nl = (char *)memchr(cur, '\n', (size_t)(end - cur));
            size_t len = nl ? (size_t)(nl - cur) : (size_t)(end - cur);
            if (!seen_data && is_leading_header(tid, lno, cur, len)) {
                char pre[128];
                cx_fmt(pre, sizeof pre, "%s\tHDR\t%ld\t", RG_TNAME[tid], lno);
                np_puts(&hdrs, pre);
                np_put(&hdrs, cur, len);
                np_puts(&hdrs, "\n");
            } else if (len == 0 || cur[0] == '#') {
                /* Mid-file comment or blank line: preserved at exact line sequence */
                char pre[128];
                cx_fmt(pre, sizeof pre, "%s\tMID\t%ld\t", RG_TNAME[tid], lno);
                np_puts(&hdrs, pre);
                np_put(&hdrs, cur, len);
                np_puts(&hdrs, "\n");
            } else {
                seen_data = 1;
                char *tab = (char *)memchr(cur, '\t', len);
                size_t kn = tab ? (size_t)(tab - cur) : len;
                rv_push(&all, tid, 1, lno, cur, kn, cur, len);
                total_rows++;
            }
            cur = nl ? nl + 1 : end;
        }
        free(fb);
    }

    /* Write _headers.tsv */
    {
        char hp[4400];
        if (cx_fmt(hp, sizeof hp, "%s/_headers.tsv", dir)) die("hdr-path");
        if (sy_write_atomic(hp, hdrs.p, hdrs.n, 0644)) die("write-headers");
        free(hdrs.p);
    }

    /* Compute shard filename for each data row; refuse filename collisions across distinct (tid, key) */
    char **snames = (char **)mm_alloc((long)(all.n ? all.n : 1) * (long)sizeof(char *));
    typedef struct { const char *name; int idx; } Pair;
    Pair *pairs = (Pair *)mm_alloc((long)(all.n ? all.n : 1) * (long)sizeof(Pair));
    if (!snames || !pairs) die("oom");
    for (int i = 0; i < all.n; i++) {
        snames[i] = (char *)mm_alloc(256);
        if (!snames[i]) die("oom");
        safe_shard_name(all.v[i].tid, all.v[i].key, snames[i], 256);
        pairs[i].name = snames[i];
        pairs[i].idx = i;
    }

    for (int gap = all.n / 2; gap > 0; gap /= 2) {
        for (int i = gap; i < all.n; i++) {
            Pair tmp = pairs[i];
            int j = i;
            while (j >= gap && strcmp(pairs[j - gap].name, tmp.name) > 0) {
                pairs[j] = pairs[j - gap];
                j -= gap;
            }
            pairs[j] = tmp;
        }
    }

    int i = 0;
    while (i < all.n) {
        int j = i + 1;
        while (j < all.n && !strcmp(pairs[j].name, pairs[i].name)) {
            RegRow *ra = &all.v[pairs[i].idx];
            RegRow *rb = &all.v[pairs[j].idx];
            if (ra->tid != rb->tid || strcmp(ra->key, rb->key) != 0) die("shard-filename-collision");
            die("duplicate-key");
            j++;
        }
        np_buf sb = {0};
        np_puts(&sb, "# registry-shard-v1\n");
        for (int k = i; k < j; k++) {
            RegRow *r = &all.v[pairs[k].idx];
            char pre[256];
            cx_fmt(pre, sizeof pre, "%s\t%ld\t", RG_TNAME[r->tid], r->seq);
            np_puts(&sb, pre);
            np_puts(&sb, r->key);
            np_puts(&sb, "\t");
            np_put(&sb, r->raw, r->raw_len);
            np_puts(&sb, "\n");
        }
        char sp[4600];
        if (cx_fmt(sp, sizeof sp, "%s/%s.tsv", dir, pairs[i].name)) die("shard-path");
        if (sy_write_file(sp, sb.p, (int64_t)sb.n, 0644)) die("write-shard");
        free(sb.p);
        shard_files++;
        i = j;
    }

    for (int k = 0; k < all.n; k++) mm_free(snames[k]);
    mm_free(snames);
    mm_free(pairs);
    rv_free(&all);
    printf("REGISTRY_SPLIT\tshards=%d\trows=%d\tdir=%s\n", shard_files, total_rows, dir);
    return 0;
}

static void load_manifest_dir(const char *dir, RowVec *all, int trailing_nl[RG_NTABLES]) {
    for (int i = 0; i < RG_NTABLES; i++) trailing_nl[i] = 1;
    /* 1. Load _headers.tsv */
    char hp[4400];
    if (cx_fmt(hp, sizeof hp, "%s/_headers.tsv", dir)) die("hdr-path");
    size_t hn = 0;
    char *hb = cx_read(hp, &hn);
    if (!hb) die("missing-_headers.tsv");
    char *cur = hb, *end = hb + hn;
    while (cur < end) {
        char *nl = (char *)memchr(cur, '\n', (size_t)(end - cur));
        size_t len = nl ? (size_t)(nl - cur) : (size_t)(end - cur);
        if (len > 0 && cur[0] != '#') {
            char *t1 = (char *)memchr(cur, '\t', len);
            char *t2 = t1 ? (char *)memchr(t1 + 1, '\t', (size_t)(cur + len - (t1 + 1))) : 0;
            if (!t1 || !t2) die("bad-header-line");
            int tid = find_table(cur, (size_t)(t1 - cur));
            if (tid < 0) die("bad-header-table");
            size_t kl = (size_t)(t2 - (t1 + 1));
            if (kl == 4 && !memcmp(t1 + 1, "META", 4)) {
                size_t vl = (size_t)(cur + len - (t2 + 1));
                if (vl == 13 && !memcmp(t2 + 1, "trailing_nl=0", 13)) trailing_nl[tid] = 0;
                else if (vl == 13 && !memcmp(t2 + 1, "trailing_nl=1", 13)) trailing_nl[tid] = 1;
                else die("bad-meta-line");
            } else if ((kl == 3 && !memcmp(t1 + 1, "HDR", 3)) || (kl == 3 && !memcmp(t1 + 1, "MID", 3))) {
                int kind = (t1[1] == 'H') ? 0 : 2;
                char *t3 = (char *)memchr(t2 + 1, '\t', (size_t)(cur + len - (t2 + 1)));
                if (!t3) die("bad-header-seq");
                char sbuf[32];
                size_t sl = (size_t)(t3 - (t2 + 1));
                if (sl >= sizeof sbuf) die("bad-header-seq");
                mm_copy(sbuf, sizeof sbuf, t2 + 1, (long)sl); sbuf[sl] = 0;
                long seq = atol(sbuf);
                rv_push(all, tid, kind, seq, "", 0, t3 + 1, (size_t)(cur + len - (t3 + 1)));
            } else {
                die("bad-header-kind");
            }
        }
        cur = nl ? nl + 1 : end;
    }
    free(hb);

    /* 2. Scan all *.tsv shard files in dir; enforce filename == safe_id(tid, key).tsv */
    RowVec data_only = {0};
    sy_dir_t d;
    if (sy_dir_open(&d, dir)) die("opendir-manifests");
    int next;
    while ((next = sy_dir_next(&d)) == 1) {
        long ln = tx_len(d.name, 256);
        if (ln <= 4 || strcmp(d.name + ln - 4, ".tsv") != 0) continue;
        if (tx_eqz(d.name, "_headers.tsv")) continue;
        char sp[4600];
        if (cx_fmt(sp, sizeof sp, "%s/%s", dir, d.name)) die("shard-path");
        size_t sn = 0;
        char *sb = cx_read(sp, &sn);
        if (!sb) die("read-shard");
        char *p = sb, *se = sb + sn;
        while (p < se) {
            char *nl = (char *)memchr(p, '\n', (size_t)(se - p));
            size_t len = nl ? (size_t)(nl - p) : (size_t)(se - p);
            if (len > 0 && p[0] != '#') {
                char *t1 = (char *)memchr(p, '\t', len);
                char *t2 = t1 ? (char *)memchr(t1 + 1, '\t', (size_t)(p + len - (t1 + 1))) : 0;
                char *t3 = t2 ? (char *)memchr(t2 + 1, '\t', (size_t)(p + len - (t2 + 1))) : 0;
                if (!t1 || !t2 || !t3) { free(sb); sy_dir_close(&d); die("bad-shard-line"); }
                int tid = find_table(p, (size_t)(t1 - p));
                if (tid < 0) { free(sb); sy_dir_close(&d); die("bad-shard-table"); }
                char sbuf[32];
                size_t sl = (size_t)(t2 - (t1 + 1));
                if (sl >= sizeof sbuf) { free(sb); sy_dir_close(&d); die("bad-shard-seq"); }
                mm_copy(sbuf, sizeof sbuf, t1 + 1, (long)sl); sbuf[sl] = 0;
                long seq = atol(sbuf);
                size_t kn = (size_t)(t3 - (t2 + 1));
                char *kcopy = (char *)mm_alloc((long)kn + 1);
                if (!kcopy) die("oom");
                if (kn) mm_copy(kcopy, (long)kn + 1, t2 + 1, (long)kn);
                kcopy[kn] = 0;
                char exp_stem[256], exp_file[264];
                safe_shard_name(tid, kcopy, exp_stem, sizeof exp_stem);
                cx_fmt(exp_file, sizeof exp_file, "%s.tsv", exp_stem);
                if (strcmp(d.name, exp_file) != 0) {
                    fprintf(stderr, "registry-gen: REFUSE shard-filename-mismatch file=%s expected=%s key=%s\n",
                            d.name, exp_file, kcopy);
                    mm_free(kcopy); free(sb); sy_dir_close(&d);
                    exit(2);
                }
                mm_free(kcopy);
                rv_push(all, tid, 1, seq, t2 + 1, kn, t3 + 1, (size_t)(p + len - (t3 + 1)));
                rv_push(&data_only, tid, 1, seq, t2 + 1, kn, "", 0);
            }
            p = nl ? nl + 1 : se;
        }
        free(sb);
    }
    sy_dir_close(&d);
    if (next < 0) die("readdir-manifests");

    /* 3. Enforce unique (table, key) across all shard files */
    if (data_only.n > 1) {
        qsort(data_only.v, (size_t)data_only.n, sizeof(RegRow), rv_cmp_key);
        for (int i = 1; i < data_only.n; i++) {
            if (data_only.v[i].tid == data_only.v[i - 1].tid &&
                strcmp(data_only.v[i].key, data_only.v[i - 1].key) == 0) {
                fprintf(stderr, "registry-gen: REFUSE duplicate-key table=%s key=%s\n",
                        RG_TNAME[data_only.v[i].tid], data_only.v[i].key);
                rv_free(&data_only);
                exit(2);
            }
        }
    }
    rv_free(&data_only);

    if (all->n > 1) qsort(all->v, (size_t)all->n, sizeof(RegRow), rv_cmp_order);
}

static void synth_tables(const char *dir, np_buf out[RG_NTABLES]) {
    for (int i = 0; i < RG_NTABLES; i++) { out[i].p = 0; out[i].n = 0; out[i].cap = 0; }
    RowVec all = {0};
    int trailing_nl[RG_NTABLES];
    load_manifest_dir(dir, &all, trailing_nl);
    for (int i = 0; i < all.n; i++) {
        RegRow *r = &all.v[i];
        np_put(&out[r->tid], r->raw, r->raw_len);
        np_puts(&out[r->tid], "\n");
    }
    for (int tid = 0; tid < RG_NTABLES; tid++) {
        if (!trailing_nl[tid] && out[tid].n > 0 && out[tid].p[out[tid].n - 1] == '\n') {
            out[tid].n--;
            out[tid].p[out[tid].n] = 0;
        }
    }
    rv_free(&all);
}

static int do_check_dir(const char *root, const char *dir) {
    np_buf gen[RG_NTABLES];
    synth_tables(dir, gen);
    int diffs = 0;
    size_t total_bytes = 0;
    for (int tid = 0; tid < RG_NTABLES; tid++) {
        char fp[4400];
        if (cx_fmt(fp, sizeof fp, "%s/%s", root, RG_TPATH[tid])) die("path-bound");
        size_t en = 0;
        char *eb = cx_read(fp, &en);
        int same = (eb && en == gen[tid].n && (!en || !memcmp(eb, gen[tid].p, en)));
        if (!same) {
            fprintf(stderr, "REGISTRY_GEN\tDIFF\ttable=%s\texisting=%zu\tgenerated=%zu\n",
                    RG_TPATH[tid], eb ? en : 0, gen[tid].n);
            diffs++;
        } else {
            total_bytes += en;
        }
        free(eb);
        free(gen[tid].p);
    }
    if (diffs) return 1;
    printf("REGISTRY_GEN\tSAME\ttables=%d\tbytes=%zu\n", RG_NTABLES, total_bytes);
    return 0;
}

static int do_write_dir(const char *dir, const char *out_root) {
    np_buf gen[RG_NTABLES];
    synth_tables(dir, gen);
    char tdir[4400];
    if (cx_fmt(tdir, sizeof tdir, "%s/tests", out_root)) die("out-path");
    sy_mkdir_all(tdir, 0755);
    size_t total_bytes = 0;
    for (int tid = 0; tid < RG_NTABLES; tid++) {
        char fp[4400];
        if (cx_fmt(fp, sizeof fp, "%s/%s", out_root, RG_TPATH[tid])) die("path-bound");
        if (sy_write_atomic(fp, gen[tid].p, gen[tid].n, 0644)) die("write-table");
        total_bytes += gen[tid].n;
        free(gen[tid].p);
    }
    printf("REGISTRY_GEN\tWROTE\ttables=%d\tbytes=%zu\tout=%s\n", RG_NTABLES, total_bytes, out_root);
    return 0;
}

static unsigned long long fnv1a_64(const char *s) {
    unsigned long long h = 14695981039346656037ULL;
    for (const unsigned char *p = (const unsigned char *)s; *p; p++) {
        h ^= (unsigned long long)*p;
        h *= 1099511628211ULL;
    }
    return h;
}

static int str_ptr_cmp(const void *a, const void *b) {
    return strcmp(*(const char *const *)a, *(const char *const *)b);
}

/* Measure exact changed-shard count by actually inserting `probe_tool` into sorted `base[0..n-1]`,
 * building every shard's concatenated member string before and after, and counting differing shards. */
static int measure_seq_diff(char **base, int n, const char *probe) {
    char **ext = (char **)mm_alloc((long)(n + 1) * (long)sizeof(char *));
    if (!ext) die("oom");
    for (int i = 0; i < n; i++) ext[i] = base[i];
    ext[n] = (char *)probe;
    qsort(ext, (size_t)(n + 1), sizeof(char *), str_ptr_cmp);
    int s0 = (n + 7) / 8, s1 = (n + 8) / 8;
    int smax = s1 > s0 ? s1 : s0;
    int diff = 0;
    for (int s = 0; s < smax; s++) {
        int same = 1;
        for (int j = 0; j < 8; j++) {
            int idx = s * 8 + j;
            const char *a = idx < n ? base[idx] : 0;
            const char *b = idx < n + 1 ? ext[idx] : 0;
            if ((a == 0) != (b == 0) || (a && b && strcmp(a, b) != 0)) { same = 0; break; }
        }
        if (!same) diff++;
    }
    mm_free(ext);
    return diff;
}

static int measure_hash_diff(char **base, int n, const char *probe, int B) {
    np_buf *b0 = (np_buf *)mm_alloc((long)B * (long)sizeof(np_buf));
    np_buf *b1 = (np_buf *)mm_alloc((long)B * (long)sizeof(np_buf));
    if (!b0 || !b1) die("oom");
    for (int i = 0; i < B; i++) { b0[i].p = 0; b0[i].n = 0; b0[i].cap = 0; b1[i].p = 0; b1[i].n = 0; b1[i].cap = 0; }
    for (int i = 0; i < n; i++) {
        int bk = (int)(fnv1a_64(base[i]) & (unsigned long long)(B - 1));
        np_puts(&b0[bk], base[i]); np_puts(&b0[bk], "\n");
        np_puts(&b1[bk], base[i]); np_puts(&b1[bk], "\n");
    }
    int pbk = (int)(fnv1a_64(probe) & (unsigned long long)(B - 1));
    np_puts(&b1[pbk], probe); np_puts(&b1[pbk], "\n");
    int diff = 0;
    for (int i = 0; i < B; i++) {
        int same = (b0[i].n == b1[i].n && (!b0[i].n || !memcmp(b0[i].p, b1[i].p, b0[i].n)));
        if (!same) diff++;
        free(b0[i].p);
        free(b1[i].p);
    }
    mm_free(b0);
    mm_free(b1);
    return diff;
}

/* Real-insertion shard-stability experiment: sequential 8/shard vs power-of-2 FNV-1a (B=256). */
static int do_shard_experiment(const char *root) {
    char fp[4400];
    if (cx_fmt(fp, sizeof fp, "%s/tests/tools-compile-sources.tsv", root)) die("path-bound");
    size_t fn = 0;
    char *fb = cx_read(fp, &fn);
    if (!fb) die("read-sources");
    char **tools = (char **)mm_alloc(4096L * (long)sizeof(char *));
    if (!tools) die("oom");
    int n = 0;
    char *cur = fb, *end = fb + fn;
    while (cur < end && n < 4096) {
        char *nl = (char *)memchr(cur, '\n', (size_t)(end - cur));
        size_t len = nl ? (size_t)(nl - cur) : (size_t)(end - cur);
        if (len > 0 && cur[0] != '#') {
            char *tab = (char *)memchr(cur, '\t', len);
            size_t kn = tab ? (size_t)(tab - cur) : len;
            char *cp = (char *)mm_alloc((long)kn + 1);
            if (!cp) die("oom");
            mm_copy(cp, (long)kn + 1, cur, (long)kn); cp[kn] = 0;
            tools[n++] = cp;
        }
        cur = nl ? nl + 1 : end;
    }
    free(fb);
    qsort(tools, (size_t)n, sizeof(char *), str_ptr_cmp);

    int B = 256; /* power-of-2 for consistent per-bucket split */
    int cnt[256];
    for (int i = 0; i < B; i++) cnt[i] = 0;
    for (int i = 0; i < n; i++) cnt[(int)(fnv1a_64(tools[i]) & (unsigned long long)(B - 1))]++;
    int min_b = cnt[0], max_b = cnt[0], max_bi = 0, empty_b = 0, over8 = 0;
    for (int i = 0; i < B; i++) {
        if (cnt[i] < min_b) min_b = cnt[i];
        if (cnt[i] > max_b) { max_b = cnt[i]; max_bi = i; }
        if (cnt[i] == 0) empty_b++;
        if (cnt[i] > 8) over8++;
    }

    int seq_head = measure_seq_diff(tools, n, "tools/000-probe.cx");
    int seq_mid  = measure_seq_diff(tools, n, "tools/m00-probe.cx");
    int seq_tail = measure_seq_diff(tools, n, "tools/zzz-probe.cx");
    int hash_head = measure_hash_diff(tools, n, "tools/000-probe.cx", B);
    int hash_mid  = measure_hash_diff(tools, n, "tools/m00-probe.cx", B);
    int hash_tail = measure_hash_diff(tools, n, "tools/zzz-probe.cx", B);

    printf("SHARD_EXPERIMENT\ttools=%d\tseq_shards=%d\tseq_head_diff=%d\tseq_mid_diff=%d\tseq_tail_diff=%d\thash_buckets=%d\thash_head_diff=%d\thash_mid_diff=%d\thash_tail_diff=%d\thash_min=%d\thash_max=%d\thash_max_bucket=%d\thash_empty=%d\thash_over8=%d\n",
           n, (n + 7) / 8, seq_head, seq_mid, seq_tail, B, hash_head, hash_mid, hash_tail, min_b, max_b, max_bi, empty_b, over8);
    for (int i = 0; i < n; i++) mm_free(tools[i]);
    mm_free(tools);
    return 0;
}

int main(int argc, char **argv) {
    int mode = 0; /* 1=split, 2=check, 3=write, 4=shard-experiment */
    const char *root_arg = ".", *dir_arg = 0, *out_arg = 0;
    for (int i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--")) continue;
        else if (tx_eqz(argv[i], "--split")) mode = 1;
        else if (tx_eqz(argv[i], "--check")) mode = 2;
        else if (tx_eqz(argv[i], "--write")) mode = 3;
        else if (tx_eqz(argv[i], "--shard-experiment")) mode = 4;
        else if (tx_eqz(argv[i], "--root") && i + 1 < argc) root_arg = argv[++i];
        else if (tx_eqz(argv[i], "--dir") && i + 1 < argc) dir_arg = argv[++i];
        else if (tx_eqz(argv[i], "--out") && i + 1 < argc) out_arg = argv[++i];
        else if (argv[i][0] != '-') root_arg = argv[i];
        else die("usage: --split|--check|--write|--shard-experiment [--root ROOT] [--dir DIR] [--out OUT]");
    }
    if (!mode) die("usage: --split|--check|--write|--shard-experiment");

    char root[4096];
    if (sy_realpath(root_arg, root, sizeof root) < 0) die("root-realpath");

    if (mode == 4) return do_shard_experiment(root);
    if (mode == 1) {
        if (!dir_arg) die("--split requires --dir");
        return do_split(root, dir_arg);
    }
    if (mode == 3) {
        if (!dir_arg) die("--write requires --dir");
        return do_write_dir(dir_arg, out_arg ? out_arg : root);
    }

    /* mode == 2 (--check): if --dir given, check directly; else use ROOT/tests/registry.d if present,
     * otherwise run stage-1 read-only in-memory split -> synth -> byte-compare roundtrip. */
    if (dir_arg) return do_check_dir(root, dir_arg);
    char def_dir[4400];
    if (cx_fmt(def_dir, sizeof def_dir, "%s/tests/registry.d", root)) die("def-dir-bound");
    sy_stat_t st;
    if (sy_lstat(def_dir, &st) == 0 && st.kind == 'd') return do_check_dir(root, def_dir);

    RowVec all = {0};
    int trailing_nl[RG_NTABLES];
    for (int tid = 0; tid < RG_NTABLES; tid++) {
        char fp[4400];
        if (cx_fmt(fp, sizeof fp, "%s/%s", root, RG_TPATH[tid])) die("path-bound");
        size_t fn = 0;
        char *fb = cx_read(fp, &fn);
        if (!fb) die(RG_TPATH[tid]);
        trailing_nl[tid] = (fn == 0 || fb[fn - 1] == '\n') ? 1 : 0;
        char *cur = fb, *end = fb + fn;
        long lno = 0;
        int seen_data = 0;
        while (cur < end) {
            lno++;
            char *nl = (char *)memchr(cur, '\n', (size_t)(end - cur));
            size_t len = nl ? (size_t)(nl - cur) : (size_t)(end - cur);
            if (!seen_data && is_leading_header(tid, lno, cur, len)) {
                rv_push(&all, tid, 0, lno, "", 0, cur, len);
            } else if (len == 0 || cur[0] == '#') {
                rv_push(&all, tid, 2, lno, "", 0, cur, len);
            } else {
                seen_data = 1;
                char *tab = (char *)memchr(cur, '\t', len);
                size_t kn = tab ? (size_t)(tab - cur) : len;
                rv_push(&all, tid, 1, lno, cur, kn, cur, len);
            }
            cur = nl ? nl + 1 : end;
        }
        free(fb);
    }
    if (all.n > 1) qsort(all.v, (size_t)all.n, sizeof(RegRow), rv_cmp_order);
    np_buf gen[RG_NTABLES];
    for (int i = 0; i < RG_NTABLES; i++) { gen[i].p = 0; gen[i].n = 0; gen[i].cap = 0; }
    for (int i = 0; i < all.n; i++) {
        np_put(&gen[all.v[i].tid], all.v[i].raw, all.v[i].raw_len);
        np_puts(&gen[all.v[i].tid], "\n");
    }
    for (int tid = 0; tid < RG_NTABLES; tid++) {
        if (!trailing_nl[tid] && gen[tid].n > 0 && gen[tid].p[gen[tid].n - 1] == '\n') {
            gen[tid].n--;
            gen[tid].p[gen[tid].n] = 0;
        }
    }
    rv_free(&all);
    int diffs = 0;
    size_t total_bytes = 0;
    for (int tid = 0; tid < RG_NTABLES; tid++) {
        char fp[4400];
        if (cx_fmt(fp, sizeof fp, "%s/%s", root, RG_TPATH[tid])) die("path-bound");
        size_t en = 0;
        char *eb = cx_read(fp, &en);
        int same = (eb && en == gen[tid].n && (!en || !memcmp(eb, gen[tid].p, en)));
        if (!same) {
            fprintf(stderr, "REGISTRY_GEN\tDIFF\ttable=%s\texisting=%zu\tgenerated=%zu\n",
                    RG_TPATH[tid], eb ? en : 0, gen[tid].n);
            diffs++;
        } else total_bytes += en;
        free(eb);
        free(gen[tid].p);
    }
    if (diffs) return 1;
    printf("REGISTRY_GEN\tSAME\ttables=%d\tbytes=%zu\n", RG_NTABLES, total_bytes);
    return 0;
}
