/* tools/check-textx-zlfeed.cx -- ext/textx/inflate.cx incremental decoding (zl_init, zl_feed, zl_done, zl_end).
 *   sh ./unisacc.com tools/check-textx-zlfeed.cx [-- --cases size;oracle;diff;trunc;corrupt;sticky;mutc;mut1;mut2;mut3;mut4;mut5]
 *   size     sizeof(zl_state) == ZL_STATE_BYTES
 *   oracle   proposition (b) correctness against independent known-answer vectors (hand-built or pre-generated
 *            by external system gzip, never produced by textx.deflate/inflate):
 *            3 stored (empty, short, cross-block), 3 fixed (empty, short, 2-block cross-boundary back-ref),
 *            3 dynamic (raw greek, raw colors, gzip planets), plus dist > output_so_far malformed (-EINVAL)
 *   diff     proposition (a) split invariance: 9 drivers (whole, 1B in, 7B in, rand 1..64 x3 seeds, 1B out,
 *            7B out, 1B in + 1B out) match one-shot zl_inflate/zl_gunzip byte-for-byte on stored, fixed,
 *            dynamic, >32 KiB window wrap long-distance match, trailing bytes, exact-cap, and gzip headers
 *   trunc    truncated raw and gzip streams across drivers: zl_end == -EIO (or one-shot code), output is prefix
 *   corrupt  malformed raw and gzip streams + bit flips: sticky error, matching error code
 *   sticky   bad arguments leave state untouched, ZL_END is final, sticky error rejects further input
 *   mutc     private copy of ext/textx without mutation: all feed groups must pass (control)
 *   mut1-5   private copy with mutations: M1 window mask wrong, M2 bit buffer cleared across feeds,
 *            M3 hold buffer cleared across feeds, M4 gzip running CRC reset across feeds,
 *            M5 symmetric off-by-one output truncation in BOTH one-shot zl_raw and streaming zl_feed
 *            (must be killed by proposition (b) oracle)
 * Prints PASS/FAIL per case and CHECK_TEXTX_ZLFEED<TAB>failed=N; exit 0 only when N is 0. */
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use text.text
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use testx.check
#pragma unisa use textx.inflate
#pragma unisa use textx.deflate
#pragma unisa use cxlib.muthelp

#define MAXIN 140000
#define MAXOUT 76000

static unsigned char orig[MAXOUT], comp[MAXIN], one_out[MAXOUT], feed_out[MAXOUT], tmp_in[MAXIN];
static unsigned char small_buf[16];
static unsigned long g_seed = 12345UL;
static unsigned long d_lcg = 1UL;
static zl_state g_st;

#define cp mh_copy
#define find_at mh_find_at
static int zl_eq(const unsigned char *a, const unsigned char *b, long n) { return n == 0 || memcmp(a, b, (size_t)n) == 0; }
#define same zl_eq
static unsigned long drnd(void) {
    d_lcg = d_lcg * 1103515245UL + 12345UL;
    return (d_lcg >> 16) & 0x7FFFFFFFUL;
}

static void fill_data(long n, int kind) {
    long i;
    for (i = 0; i < n; i++) {
        g_seed = g_seed * 6364136223846793005UL + 1442695040888963407UL;
        if (kind == 0) orig[i] = (unsigned char)(g_seed >> 33);
        else if (kind == 1) orig[i] = (unsigned char)("abcabcabd"[i % 9]);
        else orig[i] = (unsigned char)('a' + (int)((i / 97) % 3));
    }
}

/* 70000 bytes: 32000 random bytes followed by repeats from start so matches cross 32 KiB window wrap twice */
static void fill_longdist(long n) {
    long i;
    unsigned long s = 987654321UL;
    for (i = 0; i < 32000 && i < n; i++) {
        s = s * 6364136223846793005UL + 1442695040888963407UL;
        orig[i] = (unsigned char)(s >> 33);
    }
    for (; i < n; i++) orig[i] = orig[i - 32000];
}

/* Independent RFC 1951 fixed-Huffman bit-writer (never uses textx.deflate/inflate) */
typedef struct bw_t { unsigned char *buf; long pos; unsigned int bb; int bc; } bw_t;
static void bw_put(bw_t *w, unsigned int val, int nbits) {
    w->bb |= (val & ((1U << nbits) - 1U)) << w->bc;
    w->bc += nbits;
    while (w->bc >= 8) { w->buf[w->pos++] = (unsigned char)(w->bb & 255U); w->bb >>= 8; w->bc -= 8; }
}
static unsigned int rev_bits(unsigned int v, int n) {
    unsigned int r = 0; int i;
    for (i = 0; i < n; i++) { r = (r << 1) | (v & 1U); v >>= 1; }
    return r;
}
static void bw_fix_sym(bw_t *w, int sym) {
    if (sym <= 143) bw_put(w, rev_bits((unsigned int)(0x30 + sym), 8), 8);
    else if (sym <= 255) bw_put(w, rev_bits((unsigned int)(0x190 + (sym - 144)), 9), 9);
    else if (sym <= 279) bw_put(w, rev_bits((unsigned int)(sym - 256), 7), 7);
    else bw_put(w, rev_bits((unsigned int)(0xC0 + (sym - 280)), 8), 8);
}

/* Independent 2-block fixed DEFLATE stream:
 * block 1 (BFINAL=0): 64 literals + 6 matches (len 28, dist 64)
 * block 2 (BFINAL=1): 6 matches (len 28, dist 64) crossing block boundary => 400 bytes total */
static long build_fixed_two_blocks(unsigned char *dst, unsigned char *exp_out, long *exp_len) {
    bw_t w; int i, k; long n = 0;
    w.buf = dst; w.pos = 0; w.bb = 0; w.bc = 0;
    bw_put(&w, 0U, 1); /* BFINAL = 0 */
    bw_put(&w, 1U, 2); /* BTYPE = 01 (fixed) */
    for (i = 0; i < 64; i++) {
        unsigned char c = (unsigned char)(32 + (i * 3) % 90);
        bw_fix_sym(&w, (int)c);
        exp_out[n++] = c;
    }
    /* sym 271 = base 27 + 2 extra bits (val 1 -> len 28); dcode 11 = base 49 + 4 extra bits (val 15 -> dist 64) */
    for (k = 0; k < 6; k++) {
        bw_fix_sym(&w, 271);
        bw_put(&w, 1U, 2);
        bw_put(&w, rev_bits(11U, 5), 5);
        bw_put(&w, 15U, 4);
        for (i = 0; i < 28; i++) { exp_out[n] = exp_out[n - 64]; n++; }
    }
    bw_fix_sym(&w, 256); /* EOB block 1 */
    bw_put(&w, 1U, 1); /* BFINAL = 1 */
    bw_put(&w, 1U, 2); /* BTYPE = 01 (fixed) */
    for (k = 0; k < 6; k++) {
        bw_fix_sym(&w, 271);
        bw_put(&w, 1U, 2);
        bw_put(&w, rev_bits(11U, 5), 5);
        bw_put(&w, 15U, 4);
        for (i = 0; i < 28; i++) { exp_out[n] = exp_out[n - 64]; n++; }
    }
    bw_fix_sym(&w, 256); /* EOB block 2 */
    if (w.bc > 0) w.buf[w.pos++] = (unsigned char)(w.bb & 255U);
    *exp_len = n;
    return w.pos;
}

/* Independent malformed fixed block: emits "ab" (2 bytes), then back-ref len=3, dist=5 (> 2) */
static long build_fixed_dist_too_far(unsigned char *dst) {
    bw_t w;
    w.buf = dst; w.pos = 0; w.bb = 0; w.bc = 0;
    bw_put(&w, 1U, 1); /* BFINAL = 1 */
    bw_put(&w, 1U, 2); /* BTYPE = 01 (fixed) */
    bw_fix_sym(&w, 'a');
    bw_fix_sym(&w, 'b');
    bw_fix_sym(&w, 257);              /* len = 3, 0 extra bits */
    bw_put(&w, rev_bits(4U, 5), 5);   /* dcode 4 = base 5, 1 extra bit */
    bw_put(&w, 0U, 1);                /* dist = 5 > 2 */
    bw_fix_sym(&w, 256);
    if (w.bc > 0) w.buf[w.pos++] = (unsigned char)(w.bb & 255U);
    return w.pos;
}

