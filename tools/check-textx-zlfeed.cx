/* run zl_feed with driver drv (9 drivers):
 * 0=whole, 1=1B in, 2=7B in, 3..5=rand 1..64 (seeds 101,202,303), 6=1B out, 7=7B out, 8=1B in + 1B out. */
static long run_driver(int mode, int drv, const unsigned char *in, long inlen,
                       unsigned char *out, long maxout, long *out_n, long *in_used, long *end_rc, long *viol) {
    long pos = 0, outp = 0, step, c, o, r = ZL_NEED_IN, cap_step, iter = 0;
    unsigned char *ob;
    *viol = 0;
    if (zl_init(&g_st, mode) != 0) { *viol = 1; return -EINVAL; }
    if (drv == 3) d_lcg = 101UL;
    else if (drv == 4) d_lcg = 202UL;
    else if (drv == 5) d_lcg = 303UL;
    for (;;) {
        if (++iter > 500000L) { *viol += 100; break; }
        if (drv == 0 || drv == 6 || drv == 7) step = inlen - pos;
        else if (drv == 1 || drv == 8) step = pos < inlen ? 1 : 0;
        else if (drv == 2) { step = 7; if (step > inlen - pos) step = inlen - pos; }
        else { step = (long)(drnd() % 64UL) + 1; if (step > inlen - pos) step = inlen - pos; }
        if (drv == 6 || drv == 8) { cap_step = 1; ob = small_buf; ob[1] = 0xA5; }
        else if (drv == 7) { cap_step = 7; ob = small_buf; ob[7] = 0xA5; }
        else { cap_step = maxout - outp; ob = out + outp; if (cap_step < 0) cap_step = 0; }
        c = -1; o = -1;
        r = zl_feed(&g_st, in + pos, step, &c, ob, cap_step, &o);
        if (c < 0 || c > step || o < 0 || o > cap_step) *viol += 1;
        if ((drv == 6 || drv == 8) && ob[1] != 0xA5) *viol += 1;
        if (drv == 7 && ob[7] != 0xA5) *viol += 1;
        if (o > 0 && (drv == 6 || drv == 7 || drv == 8)) {
            if (outp + o <= maxout) cp(out + outp, ob, o);
            else *viol += 1;
        }
        outp += o;
        pos += c;
        if (r == ZL_END) {
            long c2 = -1, o2 = -1, r2;
            r2 = zl_feed(&g_st, in + pos, inlen - pos, &c2, small_buf, 8, &o2);
            if (r2 != ZL_END || c2 != 0 || o2 != 0 || !zl_done(&g_st)) *viol += 1;
            break;
        }
        if (r < 0) {
            long c2 = -1, o2 = -1, r2;
            r2 = zl_feed(&g_st, in + pos, inlen - pos, &c2, small_buf, 8, &o2);
            if (r2 != r || c2 != 0 || o2 != 0) *viol += 1;
            break;
        }
        if (r == ZL_NEED_OUT) {
            if (o == 0 && cap_step > 0) *viol += 1;
            continue;
        }
        if (c != step) *viol += 1;
        if (pos >= inlen) break;
    }
    *out_n = outp;
    *in_used = pos;
    *end_rc = zl_end(&g_st);
    return r;
}

/* Proposition (b): check BOTH one-shot and streaming (all 9 drivers) against independent known answer */
static int check_oracle(const char *tag, int mode, const unsigned char *in, long inlen,
                        const unsigned char *exp, long explen, long exp_used) {
    int drv, ok = 1;
    long one_n = -1, one_r;
    memset(one_out, 0xDD, (size_t)(explen + 16 < MAXOUT ? explen + 16 : MAXOUT));
    one_r = mode == ZL_GZIP ? zl_gunzip(one_out, MAXOUT, &one_n, in, inlen)
                            : zl_inflate(one_out, MAXOUT, &one_n, in, inlen);
    if (one_r != 0 || one_n != explen || !same(one_out, exp, explen)) ok = 0;
    for (drv = 0; drv < 9; drv++) {
        long fn = 0, fu = 0, erc = 0, viol = 0, r;
        memset(feed_out, 0xCC, (size_t)(explen + 16 < MAXOUT ? explen + 16 : MAXOUT));
        r = run_driver(mode, drv, in, inlen, feed_out, MAXOUT, &fn, &fu, &erc, &viol);
        if (r != ZL_END || erc != 0 || viol != 0 || fn != explen || !same(feed_out, exp, explen)) ok = 0;
        if (exp_used >= 0 && fu != exp_used) ok = 0;
    }
    tk_ok(ok, tag);
    return ok;
}

/* Proposition (a): split invariance across all 9 drivers vs one-shot + exact-cap check */
static int check_split(const char *tag, int mode, const unsigned char *in, long inlen,
                       const unsigned char *exp, long explen, long exp_used) {
    int drv, ok = 1;
    long one_n = -1, one_r;
    one_r = mode == ZL_GZIP ? zl_gunzip(one_out, MAXOUT, &one_n, in, inlen)
                            : zl_inflate(one_out, MAXOUT, &one_n, in, inlen);
    if (one_r != 0 || one_n != explen || !same(one_out, exp, explen)) {
        tk_ok(0, tag);
        return 0;
    }
    for (drv = 0; drv < 9; drv++) {
        long fn = 0, fu = 0, erc = 0, viol = 0, r;
        memset(feed_out, 0xCC, (size_t)(explen + 16 < MAXOUT ? explen + 16 : MAXOUT));
        r = run_driver(mode, drv, in, inlen, feed_out, MAXOUT, &fn, &fu, &erc, &viol);
        if (r != ZL_END || erc != 0 || viol != 0 || fn != one_n || !same(feed_out, one_out, one_n)) ok = 0;
        if (exp_used >= 0 && fu != exp_used) ok = 0;
    }
    if (explen <= MAXOUT - 8) {
        long c = 0, o = 0, r;
        zl_init(&g_st, mode);
        feed_out[explen] = 0x5A;
        r = zl_feed(&g_st, in, inlen, &c, feed_out, explen, &o);
        if (r != ZL_END || o != explen || feed_out[explen] != 0x5A || !same(feed_out, one_out, explen)) ok = 0;
    }
    tk_ok(ok, tag);
    return ok;
}

static int check_err_all(int mode, const unsigned char *in, long inlen, long want_err) {
    int drv;
    long one_n = 0, one_r;
    one_r = mode == ZL_GZIP ? zl_gunzip(one_out, MAXOUT, &one_n, in, inlen)
                            : zl_inflate(one_out, MAXOUT, &one_n, in, inlen);
    if (one_r != want_err) return 0;
    for (drv = 0; drv < 9; drv++) {
        long fn, fu, erc, viol, r;
        r = run_driver(mode, drv, in, inlen, feed_out, MAXOUT, &fn, &fu, &erc, &viol);
        if (viol != 0 || r == ZL_END || erc != want_err) return 0;
    }
    return 1;
}

static void group_size(void) {
    sy_printf("INFO\tsizeof_zl_core=%ld\tsizeof_zl_state=%ld\tZL_STATE_BYTES=%ld\n",
              (long)sizeof(zl_core), (long)sizeof(zl_state), (long)ZL_STATE_BYTES);
    tk_ok((long)sizeof(zl_state) == (long)ZL_STATE_BYTES, "size-zl-state-exact");
}

static void group_oracle(void) {
    long cn, explen;
    /* 3 stored blocks: empty, short, cross-block boundary */
    {   static const unsigned char st0[] = { 0x01, 0x00, 0x00, 0xFF, 0xFF };
        check_oracle("oracle-stored-empty", ZL_RAW, st0, (long)sizeof st0, (const unsigned char *)"", 0, (long)sizeof st0); }
    {   static const unsigned char st1[] = { 0x01, 0x03, 0x00, 0xFC, 0xFF, 'a', 'b', 'c' };
        check_oracle("oracle-stored-abc", ZL_RAW, st1, (long)sizeof st1, (const unsigned char *)"abc", 3, (long)sizeof st1); }
    {   static const unsigned char st2[] = {
            0x00, 0x06, 0x00, 0xF9, 0xFF, 'h', 'e', 'l', 'l', 'o', ' ',
            0x01, 0x06, 0x00, 0xF9, 0xFF, 'w', 'o', 'r', 'l', 'd', '!' };
        check_oracle("oracle-stored-cross-block", ZL_RAW, st2, (long)sizeof st2, (const unsigned char *)"hello world!", 12, (long)sizeof st2); }
    /* 3 fixed blocks: empty, short, 2-block cross-boundary with repeat distances */
    {   static const unsigned char fx0[] = { 0x03, 0x00 };
        check_oracle("oracle-fixed-empty", ZL_RAW, fx0, (long)sizeof fx0, (const unsigned char *)"", 0, 2); }
    {   static const unsigned char fx1[] = { 0x4B, 0x4C, 0x4A, 0x06, 0x00 };
        check_oracle("oracle-fixed-abc", ZL_RAW, fx1, (long)sizeof fx1, (const unsigned char *)"abc", 3, (long)sizeof fx1); }
    cn = build_fixed_two_blocks(comp, orig, &explen);
    check_oracle("oracle-fixed-cross-block-repeat", ZL_RAW, comp, cn, orig, explen, cn);
    /* 3 dynamic blocks pre-generated by external system gzip (verify BTYPE=2 in stream) */
    tk_ok((gz_dyn_greek[10] & 7) == 5 && (gz_dyn_colors[10] & 7) == 5 && (gz_dyn_planets[10] & 7) == 5,
          "oracle-dyn-vectors-are-btype2");
    check_oracle("oracle-dyn-raw-greek", ZL_RAW, gz_dyn_greek + 10, (long)sizeof(gz_dyn_greek) - 18,
                 (const unsigned char *)txt_dyn_greek, (long)strlen(txt_dyn_greek), (long)sizeof(gz_dyn_greek) - 18);
    check_oracle("oracle-dyn-raw-colors", ZL_RAW, gz_dyn_colors + 10, (long)sizeof(gz_dyn_colors) - 18,
                 (const unsigned char *)txt_dyn_colors, (long)strlen(txt_dyn_colors), (long)sizeof(gz_dyn_colors) - 18);
    check_oracle("oracle-dyn-gzip-planets", ZL_GZIP, gz_dyn_planets, (long)sizeof(gz_dyn_planets),
                 (const unsigned char *)txt_dyn_planets, (long)strlen(txt_dyn_planets), (long)sizeof(gz_dyn_planets));
    /* malformed: distance > output produced so far */
    cn = build_fixed_dist_too_far(comp);
    tk_ok(check_err_all(ZL_RAW, comp, cn, -EINVAL), "oracle-corrupt-dist-gt-out");
}

static void group_diff(void) {
    long cn;
    /* stored multi with trailing bytes */
    {   static const unsigned char st2[] = {
            0x00, 0x03, 0x00, 0xFC, 0xFF, 'f', 'o', 'o',
            0x01, 0x03, 0x00, 0xFC, 0xFF, 'b', 'a', 'r',
            0xDE, 0xAD };
        check_split("raw-stored-multi-trailing", ZL_RAW, st2, (long)sizeof st2, (const unsigned char *)"foobar", 6, 16); }
    /* dynamic blocks via dz_deflate */
    {   static const long lens[7] = { 0, 5, 300, 5000, 20000, 40000, 65536 };
        static const int kinds[7] = { 0, 1, 1, 2, 1, 2, 0 };
        static const char *names[7] = { "raw-dyn-0", "raw-dyn-5", "raw-dyn-300", "raw-dyn-5000",
                                        "raw-dyn-20k", "raw-dyn-40k", "raw-dyn-64k" };
        int i;
        for (i = 0; i < 7; i++) {
            fill_data(lens[i], kinds[i]);
            cn = dz_deflate(orig, lens[i], comp, MAXIN);
            check_split(names[i], ZL_RAW, comp, cn, orig, lens[i], cn);
        }
    }
    /* trailing bytes after raw dynamic */
    fill_data(300, 1);
    cn = dz_deflate(orig, 300, comp, MAXIN);
    comp[cn] = 0x55; comp[cn + 1] = 0x66;
    check_split("raw-dyn-trailing", ZL_RAW, comp, cn + 2, orig, 300, cn);
    /* >32 KiB window wrap long-distance match */
    fill_longdist(70000);
    cn = dz_deflate(orig, 70000, comp, MAXIN);
    check_split("raw-longdist-70k", ZL_RAW, comp, cn, orig, 70000, cn);
    /* gzip plain */
    {   static const long lens[5] = { 0, 10, 3000, 30000, 65536 };
        static const int kinds[5] = { 0, 1, 1, 2, 0 };
        static const char *names[5] = { "gzip-0", "gzip-10", "gzip-3000", "gzip-30k", "gzip-64k" };
        int i;
        for (i = 0; i < 5; i++) {
            fill_data(lens[i], kinds[i]);
            cn = dz_gzip(orig, lens[i], comp, MAXIN);
            check_split(names[i], ZL_GZIP, comp, cn, orig, lens[i], cn);
        }
    }
    /* gzip long-distance 70k */
    fill_longdist(70000);
    cn = dz_gzip(orig, 70000, comp, MAXIN);
    check_split("gzip-longdist-70k", ZL_GZIP, comp, cn, orig, 70000, cn);
    /* gzip FNAME + trailing bytes */
    fill_data(3000, 1);
    cn = dz_gzip(orig, 3000, comp, MAXIN);
    cp(tmp_in, comp, 10); tmp_in[3] = 8;
    cp(tmp_in + 10, "a.txt", 6);
    cp(tmp_in + 16, comp + 10, cn - 10);
    tmp_in[cn + 6] = 0x77; tmp_in[cn + 7] = 0x88;
    check_split("gzip-fname-trailing", ZL_GZIP, tmp_in, cn + 8, orig, 3000, cn + 6);
    /* gzip FEXTRA + FCOMMENT + FHCRC */
    cp(tmp_in, comp, 10); tmp_in[3] = 4 | 16 | 2;
    tmp_in[10] = 3; tmp_in[11] = 0; tmp_in[12] = 1; tmp_in[13] = 2; tmp_in[14] = 3;
    cp(tmp_in + 15, "hi", 3);
    tmp_in[18] = 0; tmp_in[19] = 0;
    cp(tmp_in + 20, comp + 10, cn - 10);
    check_split("gzip-extra-comment-hcrc", ZL_GZIP, tmp_in, cn + 10, orig, 3000, cn + 10);
}

static int check_trunc_case(int mode, const unsigned char *in, long cut, const unsigned char *full_exp, long full_len) {
    long one_n = 0, one_r, fn, fu, erc, viol, r;
    int drv;
    one_r = mode == ZL_GZIP ? zl_gunzip(one_out, MAXOUT, &one_n, in, cut)
                            : zl_inflate(one_out, MAXOUT, &one_n, in, cut);
    if (one_r >= 0) return 0;
    for (drv = 0; drv < 9; drv++) {
        r = run_driver(mode, drv, in, cut, feed_out, MAXOUT, &fn, &fu, &erc, &viol);
        if (viol != 0) return 0;
        if (r == ZL_END) return 0;
        if (erc != one_r) return 0;
        if (fn > full_len || !same(feed_out, full_exp, fn)) return 0;
    }
    return 1;
}

static void group_trunc(void) {
    long cn, i;
    int ok;
    fill_data(5000, 2);
    cn = dz_deflate(orig, 5000, comp, MAXIN);
    {   long cuts[6] = { 0, 1, 2, 10, cn / 2, cn - 1 };
        ok = 1;
        for (i = 0; i < 6; i++) if (!check_trunc_case(ZL_RAW, comp, cuts[i], orig, 5000)) ok = 0;
        tk_ok(ok, "trunc-raw-dyn");
    }
    {   static const unsigned char st[] = { 0x01, 0x03, 0x00, 0xFC, 0xFF, 'a', 'b', 'c' };
        ok = 1;
        for (i = 0; i < (long)sizeof st; i++) if (!check_trunc_case(ZL_RAW, st, i, (const unsigned char *)"abc", 3)) ok = 0;
        tk_ok(ok, "trunc-raw-stored-all");
    }
    fill_data(3000, 1);
    cn = dz_gzip(orig, 3000, comp, MAXIN);
    {   long cuts[7] = { 0, 5, 9, 12, cn / 2, cn - 8, cn - 1 };
        ok = 1;
        for (i = 0; i < 7; i++) if (!check_trunc_case(ZL_GZIP, comp, cuts[i], orig, 3000)) ok = 0;
        tk_ok(ok, "trunc-gzip");
    }
    {   static const unsigned char b5[] = { 0x00, 0x00, 0x00, 0x00, 0x00 };
        ok = check_trunc_case(ZL_GZIP, b5, 5, orig, 0);
        tk_ok(ok, "trunc-gzip-5byte-bad-magic-eio");
    }
}

static void group_corrupt(void) {
    long cn, i;
    int ok;
    {   static const unsigned char bad_st[] = { 0x01, 0x03, 0x00, 0x00, 0x00, 'a', 'b', 'c' };
        tk_ok(check_err_all(ZL_RAW, bad_st, (long)sizeof bad_st, -EINVAL), "corrupt-stored-nlen"); }
    {   static const unsigned char bad_bt[] = { 0x07 };
        tk_ok(check_err_all(ZL_RAW, bad_bt, (long)sizeof bad_bt, -EINVAL), "corrupt-reserved-btype"); }
    fill_data(3000, 1);
    cn = dz_gzip(orig, 3000, comp, MAXIN);
    cp(tmp_in, comp, cn); tmp_in[1] = 0x8C;
    tk_ok(check_err_all(ZL_GZIP, tmp_in, cn, -EINVAL), "corrupt-gzip-magic");
    cp(tmp_in, comp, cn); tmp_in[3] = 0x80;
    tk_ok(check_err_all(ZL_GZIP, tmp_in, cn, -EINVAL), "corrupt-gzip-reserved-flg");
    cp(tmp_in, comp, cn); tmp_in[cn - 8] ^= 0x01;
    tk_ok(check_err_all(ZL_GZIP, tmp_in, cn, -EINVAL), "corrupt-gzip-crc");
    cp(tmp_in, comp, cn); tmp_in[cn - 4] ^= 0x01;
    tk_ok(check_err_all(ZL_GZIP, tmp_in, cn, -EINVAL), "corrupt-gzip-isize");
    fill_data(2000, 1);
    cn = dz_deflate(orig, 2000, comp, MAXIN);
    ok = 1;
    for (i = 0; i < 16; i++) {
        long pos = (i * 37) % cn;
        long one_n = 0, one_r, fn, fu, erc, viol, r;
        int drv;
        cp(tmp_in, comp, cn);
        tmp_in[pos] ^= (unsigned char)(1U << (unsigned int)(i & 7));
        one_r = zl_inflate(one_out, MAXOUT, &one_n, tmp_in, cn);
        for (drv = 0; drv < 9; drv++) {
            r = run_driver(ZL_RAW, drv, tmp_in, cn, feed_out, MAXOUT, &fn, &fu, &erc, &viol);
            if (viol != 0) ok = 0;
            if (one_r == 0) {
                if (r != ZL_END || erc != 0 || fn != one_n || !same(feed_out, one_out, one_n)) ok = 0;
            } else {
                if (erc != one_r) ok = 0;
            }
        }
    }
    tk_ok(ok, "corrupt-bitflips-match-oneshot");
}

static void group_sticky(void) {
    long c, o, r;
    static const unsigned char st[] = { 0x01, 0x03, 0x00, 0xFC, 0xFF, 'a', 'b', 'c' };
    tk_ok(zl_init(0, ZL_RAW) == -EINVAL && zl_init(&g_st, 99) == -EINVAL, "sticky-bad-init");
    tk_ok(zl_end(0) == -EINVAL && zl_done(0) == 0, "sticky-null-end-done");
    zl_init(&g_st, ZL_RAW);
    tk_ok(zl_feed(0, st, 1, &c, small_buf, 8, &o) == -EINVAL &&
          zl_feed(&g_st, st, -1, &c, small_buf, 8, &o) == -EINVAL &&
          zl_feed(&g_st, 0, 1, &c, small_buf, 8, &o) == -EINVAL &&
          zl_feed(&g_st, st, 1, 0, small_buf, 8, &o) == -EINVAL &&
          zl_feed(&g_st, st, 1, &c, 0, 8, &o) == -EINVAL &&
          zl_feed(&g_st, st, 1, &c, small_buf, -1, &o) == -EINVAL &&
          zl_feed(&g_st, st, 1, &c, small_buf, 8, 0) == -EINVAL, "sticky-bad-args-rejected");
    r = zl_feed(&g_st, st, (long)sizeof st, &c, small_buf, 8, &o);
    tk_ok(r == ZL_END && c == (long)sizeof st && o == 3 && same(small_buf, (const unsigned char *)"abc", 3) &&
          zl_done(&g_st) == 1 && zl_end(&g_st) == 0, "sticky-state-intact-after-bad-args");
}

/* ---- ccogw system-gzip 46-byte member vector & piece=1..n+2 split invariance ----
 * Attribution: ccogw (moltbaby/bin/lib/check-inflate-stream.cx, 77 assertions).
 * System-gzip literal (echo "hello world hello world hello world" | gzip, with FNAME="plain.txt")
 * plus raw deflate slice: independent of this library, kills symmetric off-by-one defects. */
static void group_ccogw_sysgzip(void) {
    static const unsigned char gz[46] = {
        0x1f,0x8b,0x08,0x08,0xc0,0xab,0x01,0x6b,0x00,0x03,0x70,0x6c,0x61,0x69,0x6e,
        0x2e,0x74,0x78,0x74,0x00,0xcb,0x48,0xcd,0xc9,0xc9,0x57,0x28,0xcf,0x2f,0xca,
        0x49,0x51,0xc8,0xc0,0xce,0xe6,0x02,0x00,0x69,0x2e,0x6b,0x6e,0x24,0x00,0x00,
        0x00
    };
    static const unsigned char raw[18] = {
        0xcb,0x48,0xcd,0xc9,0xc9,0x57,0x28,0xcf,0x2f,0xca,0x49,0x51,0xc8,0xc0,0xce,
        0xe6,0x02,0x00
    };
    static const char plain[] = "hello world hello world hello world\n";
    long plain_len = (long)(sizeof plain - 1);
    unsigned char out[256];
    const unsigned char *vecs[2] = { gz, raw };
    long vlens[2] = { 46, 18 };
    int modes[2] = { ZL_GZIP, ZL_RAW };
    const char *labels[2] = { "ccogw-gzip", "ccogw-raw" };
    int k;
    for (k = 0; k < 2; k++) {
        long at = 0, total = 0, rc = 0;
        if (zl_init(&g_st, modes[k]) == 0) {
            while (at < vlens[k]) {
                long c = 0, p = 0;
                rc = zl_feed(&g_st, vecs[k] + at, vlens[k] - at, &c, out + total, (long)sizeof out - total, &p);
                total += p; at += c;
                if (rc < 0 || zl_done(&g_st) || (c == 0 && p == 0)) break;
            }
        } else rc = -1;
        {
            char nm1[64], nm2[64];
            cx_fmt(nm1, sizeof nm1, "%s-vector-length", labels[k]);
            cx_fmt(nm2, sizeof nm2, "%s-vector-content", labels[k]);
            tk_ok(rc >= 0 && total == plain_len, nm1);
            tk_ok(rc >= 0 && total == plain_len && same(out, (const unsigned char *)plain, plain_len), nm2);
        }
        {
            long piece;
            for (piece = 1; piece <= vlens[k] + 2; piece++) {
                char nm[64];
                long at2 = 0, tot2 = 0, r2 = 0;
                if (zl_init(&g_st, modes[k]) == 0) {
                    while (at2 < vlens[k]) {
                        long take = vlens[k] - at2 < piece ? vlens[k] - at2 : piece;
                        long c = 0, p = 0;
                        r2 = zl_feed(&g_st, vecs[k] + at2, take, &c, out + tot2, (long)sizeof out - tot2, &p);
                        tot2 += p; at2 += c;
                        if (r2 < 0 || zl_done(&g_st) || (c == 0 && p == 0)) break;
                    }
                } else r2 = -1;
                cx_fmt(nm, sizeof nm, "%s.piece-%ld", labels[k], piece);
                tk_ok(r2 >= 0 && tot2 == plain_len && same(out, (const unsigned char *)plain, plain_len), nm);
            }
        }
    }
    {
        long c = 0, p = 0, r;
        tk_ok(zl_init(&g_st, ZL_GZIP) == 0, "ccogw-init-ok");
        r = zl_feed(&g_st, gz, 23, &c, out, (long)sizeof out, &p);
        tk_ok(r >= 0, "ccogw-partial-feed-accepted");
        tk_ok(!zl_done(&g_st), "ccogw-partial-not-done");
        tk_ok(zl_end(&g_st) != 0, "ccogw-partial-end-reports-unfinished");
        tk_ok(zl_init(&g_st, 99) != 0, "ccogw-bad-mode-rejected");
    }
}

/* ---- mutation: private copy of ext/textx with one or two lines changed ---- */
static char work[4096], com[4400], root[4096];

static int put_mut2(const char *rel, const char *old1, const char *nw1, const char *old2, const char *nw2) {
    if (!mh_put_mut(root, work, rel, old1, nw1)) return 0;
    if (!old2[0]) return 1;
    return mh_put_mut(work, work, rel, old2, nw2);
}

static int setup_mut(const char *o1, const char *n1, const char *o2, const char *n2) {
    char lk[4400]; char *src, *dst; size_t n, i, k = 0, ln;
    if (!put_mut2("ext/textx/inflate.cx", o1, n1, o2, n2)) return 0;
    if (!put_mut2("ext/textx/deflate.cx", "", "", "", "")) return 0;
    if (!put_mut2("ext/textx/chunked.cx", "", "", "", "")) return 0;
    if (!put_mut2("tools/check-textx-zlfeed.cx", "", "", "", "")) return 0;
    if (cx_fmt(lk, sizeof lk, "%s/r", work)) return 0;
    if (sy_exists(lk) != 1 && sy_symlink(root, lk)) return 0;
    {   char p[4400]; if (cx_fmt(p, sizeof p, "%s/cxroot.tsv", root)) return 0; src = cx_read(p, &n); }
    if (!src || !(dst = mm_alloc((long)n * 2 + 64))) return 0;
    i = 0;
    while (i < n) {
        size_t e = i, t1 = 0, t2 = 0;
        while (e < n && src[e] != '\n') { if (src[e] == '\t') { if (!t1) t1 = e; else if (!t2) t2 = e; } e++; }
        ln = e - i;
        if (ln > 2 && src[i] == 'R' && src[i + 1] == '\t' && t2 && !(t2 - (i + 2) == 5 && !strncmp(src + i + 2, "textx", 5))) {
            cp(dst + k, src + i, (long)(t2 + 1 - i)); k += t2 + 1 - i;
            dst[k++] = 'r'; dst[k++] = '/';
            cp(dst + k, src + t2 + 1, (long)(e - t2 - 1)); k += e - t2 - 1;
        } else { cp(dst + k, src + i, (long)ln); k += ln; }
        if (e < n) dst[k++] = '\n';
        i = e + 1;
    }
    dst[k] = 0;
    return tk_write(work, "cxroot.tsv", dst) == 0;
}

static int run_child(const char *cases) {
    char probe[4400]; char *av[] = { "sh", com, probe, "--", "--cases", (char *)cases, 0 };
    if (cx_fmt(probe, sizeof probe, "%s/tools/check-textx-zlfeed.cx", work)) return -1;
    return tk_run(av, 0, 55000);
}

static void group_mut(int part) {
    int rc;
    if (tk_scratch("check-textx-zlfeed", work, sizeof work)) { tk_ok(0, "mut-scratch"); return; }
    if (part == 0) {
        if (setup_mut("", "", "", "")) {
            rc = run_child("size;oracle;ccogw;diff;trunc;corrupt;sticky");
            tk_ok(rc == 0, "mut-control-unmutated-passes");
        } else tk_ok(0, "mut-control-setup");
    } else if (part == 1) {
        /* M1: window wrap mask off by half */
        if (setup_mut("s->win[(c->wpos - (unsigned int)c->pdist) & 32767U]",
                      "s->win[(c->wpos - (unsigned int)c->pdist) & 16383U]", "", "")) {
            rc = run_child("diff");
            tk_ok(rc == 1 && tk_has(tk_out(), "FAIL\traw-longdist-70k"), "mut1-window-wrap-detected");
        } else tk_ok(0, "mut1-setup");
    } else if (part == 2) {
        /* M2: bit buffer cleared on every feed entry */
        if (setup_mut("if (c->phase == ZLP_DONE) return ZL_END;",
                      "if (c->phase == ZLP_DONE) return ZL_END; c->bb = 0; c->bc = 0;", "", "")) {
            rc = run_child("diff");
            tk_ok(rc == 1 && tk_has(tk_out(), "FAIL\traw-dyn-300"), "mut2-bitbuf-cleared-detected");
        } else tk_ok(0, "mut2-setup");
    } else if (part == 3) {
        /* M3: hold buffer cleared on every feed entry */
        if (setup_mut("if (c->phase == ZLP_DONE) return ZL_END;",
                      "if (c->phase == ZLP_DONE) return ZL_END; c->nhold = 0;", "", "")) {
            rc = run_child("diff");
            tk_ok(rc == 1 && tk_has(tk_out(), "FAIL\traw-dyn-300"), "mut3-hold-cleared-detected");
        } else tk_ok(0, "mut3-setup");
    } else if (part == 4) {
        /* M4: gzip running CRC reset on every feed entry */
        if (setup_mut("if (c->phase == ZLP_DONE) return ZL_END;",
                      "if (c->phase == ZLP_DONE) return ZL_END; c->crc = 0xFFFFFFFFU;", "", "")) {
            rc = run_child("diff");
            tk_ok(rc == 1 && tk_has(tk_out(), "FAIL\tgzip-3000"), "mut4-gzip-crc-reset-detected");
        } else tk_ok(0, "mut4-setup");
    } else if (part == 5) {
        /* M5: symmetric off-by-one output drop in BOTH one-shot zl_raw and streaming zl_feed -> oracle & ccogw MUST fail */
        if (setup_mut("if (outlen) *outlen = zl_n;",
                      "if (outlen) *outlen = zl_n > 0 ? zl_n - 1 : 0;",
                      "*outlen = o;",
                      "*outlen = o > 0 ? o - 1 : 0;")) {
            rc = run_child("oracle;ccogw");
            tk_ok(rc == 1 && tk_has(tk_out(), "FAIL\toracle-stored-abc") && tk_has(tk_out(), "FAIL\toracle-dyn-raw-greek") &&
                  tk_has(tk_out(), "FAIL\tccogw-gzip-vector-content") && tk_has(tk_out(), "FAIL\tccogw-raw-vector-content"),
                  "mut5-symmetric-drop-killed-by-oracle");
        } else tk_ok(0, "mut5-setup");
    }
}

int main(int argc, char **argv) {
    tk_begin("");
    tk_cases_init(argc, argv);
    if (sy_cwd(root, sizeof root) < 0 || cx_fmt(com, sizeof com, "%s/unisacc.com", root)) return 2;
    if (tk_case("size")) group_size();
    if (tk_case("oracle")) group_oracle();
    if (tk_case("ccogw")) group_ccogw_sysgzip();
    if (tk_case("diff")) group_diff();
    if (tk_case("trunc")) group_trunc();
    if (tk_case("corrupt")) group_corrupt();
    if (tk_case("sticky")) group_sticky();
    if (tk_case("mutc")) group_mut(0);
    if (tk_case("mut1")) group_mut(1);
    if (tk_case("mut2")) group_mut(2);
    if (tk_case("mut3")) group_mut(3);
    if (tk_case("mut4")) group_mut(4);
    if (tk_case("mut5")) group_mut(5);
    return tk_end("CHECK_TEXTX_ZLFEED", 0);
}
