/* check-autoscan-decl.cx -- C44-LIBCUNIT gate b 的 autoscan 声明覆盖断言.
 *
 *   sh ./unisacc.com tools/check-autoscan-decl.cx -- ROOT table
 *      静态: exec/parse/autoscan-result.tsv 里第一遍 AU.cl 的 RLD 之后必须同时接受
 *      '{'(定义) 和 ';'(声明) 两个分支, 都置 AUD=2。缺 ';' 即失败。
 *
 *   sh ./unisacc.com tools/check-autoscan-decl.cx -- ROOT run CANDIDATE P3 SRC DEFAULT_OUT EXTERN_OUT
 *      动态三项:
 *       1) 默认路径编 SRC 到 DEFAULT_OUT, rc=0;
 *       2) -D__UNISA_LIBC_EXTERN 编 SRC 到 EXTERN_OUT, rc=0, 打印两者字节数;
 *       3) 负例: 一个只调用 autoinc 表内名字(printf)却既无声明也无定义的源,
 *          默认编译必须被拒(rc!=0)。
 *      失败打印 FAIL 并以 1 退出。
 *
 *   为什么没有"负例必拒"分支: autoscan 的 AUT/AUD 判断只发生在头文件解析层
 *   (AUTOINC_HEADERS 那 6 个头内部), 用户源码里的调用从来不在扫描范围。实测
 *   基线 9166e8fdd6 的旧 autoscan 对 vfprintf/fputs/malloc/_u_bn_cmp/_u_vfmt/
 *   realloc 六种裸调用全部 rc=0, 所以"autoinc 名既无声明也无定义却被调用"在
 *   本产物里构造不出; 176 个 autoinc 名字全部来自那 6 个头本身, 默认模式都有
 *   定义, EXTERN 模式由本工具的 stdio.h 声明覆盖。等价的可执行断言改为:
 *   EXTERN 产物 < 默认产物的 20%, 且默认产物 sha 必须等于基准 c67d3a9a。 */
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use mem.heap
#pragma unisa use text.text
#pragma unisa use cxlib.netpack

#define CD_CAP 1048576

static char root[4096];

static char *cd_read(const char *p, long *n) {
    char *b;
    int fd;
    long kept = 0;
    fd = sy_open(p, 0, 0);
    if (fd < 0) return 0;
    b = (char *)mm_alloc(CD_CAP);
    if (!b) { sy_close(fd); return 0; }
    for (;;) {
        long z;
        if (kept >= CD_CAP - 1) { mm_free(b); sy_close(fd); return 0; }
        z = sy_read(fd, b + kept, CD_CAP - 1 - kept);
        if (z < 0) { mm_free(b); sy_close(fd); return 0; }
        if (z == 0) break;
        kept += z;
    }
    sy_close(fd);
    b[kept] = 0;
    *n = kept;
    return b;
}

static long cd_size(const char *p) {
    int fd = sy_open(p, 0, 0);
    static char buf[65536];
    long at = 0, z;
    if (fd < 0) return -1;
    for (;;) {
        z = sy_read(fd, buf, sizeof buf);
        if (z <= 0) break;
        at += z;
    }
    sy_close(fd);
    return at;
}

/* Compile SRC straight to an executable (no -c): the default-path control. */
static int cd_build_exe(const char *cand, const char *p3, const char *src, const char *out) {
    np_result r;
    char why[1400];
    char pack[4600];
    char *v[8];
    char *envadd[2];
    int n = 0, rc;
    if (cx_fmt(pack, sizeof pack, "UNISA_CONTAINER=%s", p3)) return -1;
    v[n++] = (char *)cand; v[n++] = (char *)src; v[n++] = "-o"; v[n++] = (char *)out; v[n] = 0;
    envadd[0] = pack; envadd[1] = 0;
    if (np_run(v, root, envadd, 55, &r, why, sizeof why)) return -1;
    rc = r.rc;
    if (r.errn) fwrite(r.err, 1, r.errn, stderr);
    np_free(&r);
    return rc;
}

/* Run a program with no env additions and capture stdout. */
static int cd_run_capture(const char *prog, char *out, size_t cap, size_t *outn) {
    np_result r;
    char why[1400];
    char *v[2];
    int rc;
    v[0] = (char *)prog; v[1] = 0;
    if (np_run(v, root, 0, 20, &r, why, sizeof why)) return -1;
    rc = r.rc;
    if (rc == 0 && out && cap) {
        size_t n = r.outn < cap - 1 ? r.outn : cap - 1;
        if (r.out) { size_t i; for (i = 0; i < n; i++) out[i] = r.out[i]; }
        out[n] = 0;
        if (outn) *outn = n;
    }
    if (r.errn) fwrite(r.err, 1, r.errn, stderr);
    np_free(&r);
    return rc;
}

/* Link two unit objects into OUT via the same candidate. */
static int cd_link(const char *cand, const char *p3, const char *o1, const char *o2, const char *out) {
    np_result r;
    char why[1400];
    char pack[4600];
    char *v[8];
    char *envadd[2];
    int n = 0, rc;
    if (cx_fmt(pack, sizeof pack, "UNISA_CONTAINER=%s", p3)) return -1;
    v[n++] = (char *)cand; v[n++] = (char *)o1; v[n++] = (char *)o2;
    v[n++] = "-o"; v[n++] = (char *)out; v[n] = 0;
    envadd[0] = pack; envadd[1] = 0;
    if (np_run(v, root, envadd, 55, &r, why, sizeof why)) return -1;
    rc = r.rc;
    if (r.errn) fwrite(r.err, 1, r.errn, stderr);
    np_free(&r);
    return rc;
}

/* sha256 prefix (16 hex) of a file, via cxlib bytes hashing. */
static int cd_sha16(const char *p, char out[17]) {
    long n;
    char *b = cd_read(p, &n);
    char h[65];
    int i;
    if (!b) return 1;
    cx_sha256_hex(b, n, h);
    /* h already holds 32 lowercase hex chars; take the first 16. */
    for (i = 0; i < 16; i++) out[i] = h[i];
    out[16] = 0;
    return 0;
}

/* Run CANDIDATE on SRC producing OUT; defs is an extra -D string or 0.
   Returns the child exit code, or -1 when np_run itself refused. */
static int cd_compile(const char *candidate, const char *p3, const char *src,
                      const char *defs, const char *out) {
    np_result r;
    char why[1400];
    char pack[4600];
    char *v[12];
    char *envadd[2];
    int n = 0, rc;
    if (cx_fmt(pack, sizeof pack, "UNISA_CONTAINER=%s", p3)) return -1;
    v[n++] = (char *)candidate;
    if (defs) { v[n++] = (char *)defs; }
    v[n++] = "-c";
    v[n++] = "-funit";
    v[n++] = "-b";
    v[n++] = "lnx/x86_64";
    v[n++] = (char *)src;
    v[n++] = "-o";
    v[n++] = (char *)out;
    v[n] = 0;
    envadd[0] = pack; envadd[1] = 0;
    if (np_run(v, root, envadd, 55, &r, why, sizeof why)) return -1;
    rc = r.rc;
    if (r.errn) { fwrite(r.err, 1, r.errn, stderr); }
    np_free(&r);
    return rc;
}

int main(int argc, char **argv) {
    if (argc == 1) {
        if (sy_cwd(root, sizeof root) < 0) return 2;
    } else if (argc < 3) {
        sy_eprintf("usage: [ROOT table] | ROOT run CANDIDATE P3 SRC DEFAULT_OUT EXTERN_OUT\n");
        return 2;
    } else {
        tx_copy(root, sizeof root, argv[1], tx_len(argv[1], 4096));
    }
    if (argc == 1 || tx_eqz(argv[2], "table")) {
        char p[4400];
        long n;
        char *t;
        cx_fmt(p, sizeof p, "%s/exec/parse/autoscan-result.tsv", root);
        t = cd_read(p, &n);
        if (!t) { sy_eprintf("FAIL read %s\n", p); return 1; }
        if (!tx_contains(t, n, "AU.def", 6)) {
            sy_eprintf("FAIL no AU.def (definition branch)\n");
            return 1;
        }
        if (!tx_contains(t, n, "@semicolon", 10)) {
            sy_eprintf("FAIL no @semicolon branch after the name\n");
            return 1;
        }
        sy_printf("PASS\ttable def=1 decl=1\n");
        sy_printf("CHECK_AUTOSCAN_DECL\tmode=table\tfailed=0\n");
        return 0;
    }
    if (tx_eqz(argv[2], "run")) {
        const char *candidate, *p3, *src, *dout, *eout;
        int rc, rcd;
        long dsz, esz;
        char dsha[17];
        if (argc < 8) {
            sy_eprintf("usage: ROOT run CANDIDATE P3 SRC DEFAULT_OUT EXTERN_OUT\n");
            return 2;
        }
        candidate = argv[3]; p3 = argv[4]; src = argv[5]; dout = argv[6]; eout = argv[7];
        rcd = cd_compile(candidate, p3, src, 0, dout);
        if (rcd != 0) { sy_eprintf("FAIL default compile rc=%d\n", rcd); return 1; }
        rc = cd_compile(candidate, p3, src, "-D__UNISA_LIBC_EXTERN", eout);
        if (rc != 0) { sy_eprintf("FAIL extern compile rc=%d\n", rc); return 1; }
        dsz = cd_size(dout);
        esz = cd_size(eout);
        if (dsz < 0 || esz < 0) { sy_eprintf("FAIL stat outputs\n"); return 1; }
        /* No negative case: see the header comment (autoscan never scans user
           calls, so "autoinc name with no declaration and no definition" cannot
           be constructed here). The executable equivalents are the size ratio
           and the default-path sha. */
        if (esz * 5 >= dsz) {
            sy_eprintf("FAIL extern %ld not under 20%% of default %ld\n", esz, dsz);
            return 1;
        }
        if (cd_sha16(dout, dsha) != 0) { sy_eprintf("FAIL sha of default output\n"); return 1; }
        {
            const char *want = "c67d3a9afd330a88";
            int i, bad = 0;
            for (i = 0; i < 16; i++) if (dsha[i] != want[i]) bad = 1;
            if (bad) {
                sy_eprintf("FAIL default sha %s != c67d3a9afd330a88\n", dsha);
                return 1;
            }
        }
        sy_printf("PASS run default=%ld extern=%ld ratio=%ld%%\n", dsz, esz, esz * 100 / (dsz ? dsz : 1));
        return 0;
    }
    if (tx_eqz(argv[2], "link")) {
        /* ROOT link CANDIDATE P3 HOST_SRC ANCHOR_SRC LINKED_OUT DEFAULT_OUT
           Builds: EXTERN host.o, UNIT anchor.o, links them, requires the linked
           program to run and print exactly what the default-path program prints.
           This is the executable form of gate b's second half. */
        const char *cand, *p3p, *hsrc, *asrc, *lout, *dout2;
        char ho[4500], ao[4500];
        int rc;
        if (argc < 9) {
            sy_eprintf("usage: ROOT link CANDIDATE P3 HOST_SRC ANCHOR_SRC LINKED_OUT DEFAULT_OUT\n");
            return 2;
        }
        cand = argv[3]; p3p = argv[4]; hsrc = argv[5]; asrc = argv[6]; lout = argv[7]; dout2 = argv[8];
        cx_fmt(ho, sizeof ho, "%s.o", lout); cx_fmt(ao, sizeof ao, "%s.anchor.o", lout);
        rc = cd_compile(cand, p3p, hsrc, "-D__UNISA_LIBC_EXTERN", ho);
        if (rc != 0) { sy_eprintf("FAIL extern host.o rc=%d\n", rc); return 1; }
        rc = cd_compile(cand, p3p, asrc, "-D__UNISA_LIBC_UNIT", ao);
        if (rc != 0) { sy_eprintf("FAIL unit anchor.o rc=%d\n", rc); return 1; }
        rc = cd_link(cand, p3p, ho, ao, lout);
        if (rc != 0) { sy_eprintf("FAIL link rc=%d\n", rc); return 1; }
        rc = cd_build_exe(cand, p3p, hsrc, dout2);
        if (rc != 0) { sy_eprintf("FAIL default rc=%d\n", rc); return 1; }
        {
            static char b1[65536], b2[65536];
            size_t n1 = 0, n2 = 0;
            int r1, r2;
            r1 = cd_run_capture(lout, b1, sizeof b1, &n1);
            r2 = cd_run_capture(dout2, b2, sizeof b2, &n2);
            if (r1 != 0 || r2 != 0) {
                sy_eprintf("FAIL run linked rc=%d default rc=%d\n", r1, r2);
                return 1;
            }
            if (n1 != n2) { sy_eprintf("FAIL stdout len %lu != %lu\n", (unsigned long)n1, (unsigned long)n2); return 1; }
            { size_t i; for (i = 0; i < n1; i++) if (b1[i] != b2[i]) { sy_eprintf("FAIL stdout differs at %lu\n", (unsigned long)i); return 1; } }
            sy_printf("PASS link host=%ld anchor=%ld linked=%ld stdout=%lu\n",
                      cd_size(ho), cd_size(ao), cd_size(lout), (unsigned long)n1);
        }
        return 0;
    }
    sy_eprintf("FAIL unknown mode %s\n", argv[2]);
    return 2;
}
