/* tools/check-ujs-g4-yaw.cx -- 红夹具 8 帧=1; persist 8 帧=8; chrome G4_LET_OK.
 *
 * sh ./unisacc.com tools/check-ujs-g4-yaw.cx --
 *
 * 页 ujs/practice/uxe/demo/g4-let/ 编 persist 夹具 g4-let-yaw.ujs (let-b64.js)。
 * 无 chrome: UJS_G4_YAW_UNMEASURED 退出 2,不是 PASS。
 */
static int ck_failed, ck_asserts;

static void ck_ck(int ok, const char *label) {
    ck_asserts++;
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", label);
    if (!ok) ck_failed++;
}

static int json_val_eq(const char *s, size_t n, const char *want) {
    size_t i, a, b, m = 0;
    if (!s || !want) return 0;
    while (want[m]) m++;
    for (i = 0; i + 8 < n; i++) {
        if (s[i]=='"' && s[i+1]=='v' && s[i+2]=='a' && s[i+3]=='l' &&
            s[i+4]=='u' && s[i+5]=='e' && s[i+6]=='"') {
            i += 7;
            while (i < n && s[i] != ':') i++;
            if (i < n) i++;
            while (i < n && (s[i]==' ' || s[i]=='\t')) i++;
            a = i;
            while (i < n && s[i] != ',' && s[i] != '}' && s[i] != ' ' && s[i] != '\n') i++;
            b = i;
            if (b - a != m) return 0;
            for (i = 0; i < m; i++) if (s[a + i] != want[i]) return 0;
            return 1;
        }
    }
    return 0;
}

static int json_value(const char *s, size_t n) {
    size_t i;
    int v, neg;
    for (i = 0; i + 8 < n; i++) {
        if (s[i]=='"' && s[i+1]=='v' && s[i+2]=='a' && s[i+3]=='l' &&
            s[i+4]=='u' && s[i+5]=='e' && s[i+6]=='"') {
            i += 7;
            while (i < n && s[i] != ':') i++;
            if (i < n) i++;
            while (i < n && (s[i]==' ' || s[i]=='\t')) i++;
            neg = 0;
            if (i < n && s[i]=='-') { neg = 1; i++; }
            v = 0;
            while (i < n && s[i] >= '0' && s[i] <= '9') { v = v * 10 + (s[i] - '0'); i++; }
            if (i < n && s[i] != ',' && s[i] != '}' && s[i] != ' ' && s[i] != '\n' && s[i] != 0)
                return -999;
            return neg ? -v : v;
        }
    }
    return -999;
}

static int title_is(const char *s, size_t n, const char *want) {
    size_t i, j, a, b, wl = 0;
    if (!s || !want) return 0;
    while (want[wl]) wl++;
    for (i = 0; i + 7 < n; i++) {
        if (s[i]=='<' && s[i+1]=='t' && s[i+2]=='i' && s[i+3]=='t' &&
            s[i+4]=='l' && s[i+5]=='e' && s[i+6]=='>') {
            a = i + 7;
            for (b = a; b + 8 < n; b++) {
                if (s[b]=='<' && s[b+1]=='/' && s[b+2]=='t' && s[b+3]=='i' &&
                    s[b+4]=='t' && s[b+5]=='l' && s[b+6]=='e' && s[b+7]=='>') {
                    if (b - a != wl) return 0;
                    for (j = 0; j < wl; j++) if (s[a + j] != want[j]) return 0;
                    return 1;
                }
            }
            return 0;
        }
    }
    return 0;
}

static int dump_dom(const char *url, char **out, size_t *on) {
    char *av[12];
    av[0] = "/usr/bin/google-chrome";
    av[1] = "--headless=new";
    av[2] = "--enable-unsafe-swiftshader";
    av[3] = "--allow-file-access-from-files";
    av[4] = "--disable-web-security";
    av[5] = "--virtual-time-budget=20000";
    av[6] = "--timeout=20000";
    av[7] = "--dump-dom";
    av[8] = (char *)url;
    av[9] = 0;
    *out = 0; *on = 0;
    return cx_runv_timeout(av, 25, out, on);
}

static int frame_last(const char *wasm, int nframes) {
    char *av[8];
    char *out = 0;
    size_t on = 0;
    int rc, v;
    char nf[8];
    int k = 0, x = nframes;
    char d[8];
    int nd = 0;
    if (x <= 0) return -999;
    while (x) { d[nd++] = (char)('0' + (x % 10)); x /= 10; }
    while (nd) nf[k++] = d[--nd];
    nf[k] = 0;
    av[0] = "sh";
    av[1] = "./unisacc.com";
    av[2] = "ujs/product/frame-run.cx";
    av[3] = "ujs/product/host1_vm.cx";
    av[4] = "--";
    av[5] = (char *)wasm;
    av[6] = nf;
    av[7] = 0;
    rc = cx_runv_timeout(av, 20, &out, &on);
    v = (out && on) ? json_value(out, on) : -999;
    if (out) { fwrite(out, 1, on, stdout); free(out); }
    if (rc != 0) return -999;
    return v;
}

static int frame_last_rg(const char *wasm, int nframes) {
    char *av[9];
    char *out = 0;
    size_t on = 0;
    int rc, v;
    char nf[8];
    int k = 0, x = nframes;
    char d[8];
    int nd = 0;
    if (x <= 0) return -999;
    while (x) { d[nd++] = (char)('0' + (x % 10)); x /= 10; }
    while (nd) nf[k++] = d[--nd];
    nf[k++] = 'g';
    nf[k] = 0;
    av[0] = "sh";
    av[1] = "./unisacc.com";
    av[2] = "ujs/product/frame-run.cx";
    av[3] = "ujs/product/host1_vm.cx";
    av[4] = "--";
    av[5] = (char *)wasm;
    av[6] = nf;
    av[7] = 0;
    rc = cx_runv_timeout(av, 20, &out, &on);
    v = (out && on) ? json_value(out, on) : -999;
    if (out) { fwrite(out, 1, on, stdout); free(out); }
    if (rc != 0) return -999;
    return v;
}

static int compile_ujs(const char *src, const char *dst) {
    char *av[8];
    char *out = 0;
    size_t on = 0;
    int rc;
    av[0] = "sh";
    av[1] = "./ujs/ujs.com";
    av[2] = (char *)src;
    av[3] = "-o";
    av[4] = (char *)dst;
    av[5] = 0;
    rc = cx_runv_timeout(av, 30, &out, &on);
    if (out) { fwrite(out, 1, on, stdout); free(out); }
    return rc;
}

int main(int argc, char **argv) {
    FILE *f;
    char *out = 0;
    size_t on = 0;
    int rc, v;
    ck_ck(json_val_eq("{\"value\":4}", 11, "4"), "tok-4");
    ck_ck(!json_val_eq("{\"value\":4.5}", 13, "4"), "tok-not-4.5");
    ck_ck(!json_val_eq("{\"value\":40}", 12, "4"), "tok-not-40");
    ck_ck(json_val_eq("{\"value\":0.5}", 13, "0.5"), "tok-0.5");
    ck_ck(!json_val_eq("{\"value\":10.5}", 14, "0.5"), "tok-not-10.5");
    ck_ck(!json_val_eq("{\"value\":0.55}", 14, "0.5"), "tok-not-0.55");
    char cwd[512];
    char url[640];
    const char *pre = "file://";
    int n = 0, i;
    (void)argc; (void)argv;
    rc = compile_ujs("ujs/tests/g4-let-red.ujs", "/tmp/g4-let-red.wasm");
    ck_ck(rc == 0, "compile-red");
    v = frame_last("/tmp/g4-let-red.wasm", 8);
    ck_ck(v == 1, "red-8-is-1");
    v = frame_last("/tmp/g4-let-red.wasm", 2);
    ck_ck(v == 1, "red-2-is-1");
    rc = compile_ujs("ujs/tests/g4-let-yaw.ujs", "/tmp/g4-let-yaw.wasm");
    ck_ck(rc == 0, "compile-persist");
    v = frame_last("/tmp/g4-let-yaw.wasm", 1);
    ck_ck(v == 1, "persist-1-is-1");
    v = frame_last("/tmp/g4-let-yaw.wasm", 8);
    ck_ck(v == 8, "persist-8-is-8");
    v = frame_last_rg("/tmp/g4-let-yaw.wasm", 8);
    ck_ck(v == 1, "persist-8-resetg-1");
    rc = compile_ujs("ujs/tests/g4-let-f64-red.ujs", "/tmp/g4-let-f64-red.wasm");
    ck_ck(rc == 0, "compile-f64-red");
    {
        char *av[8];
        char *out = 0;
        size_t on = 0;
        int frc;
        av[0] = "sh"; av[1] = "./unisacc.com"; av[2] = "ujs/product/frame-run.cx";
        av[3] = "ujs/product/host1_vm.cx"; av[4] = "--";
        av[5] = "/tmp/g4-let-f64-red.wasm"; av[6] = "8"; av[7] = 0;
        frc = cx_runv_timeout(av, 20, &out, &on);
        if (out && on) fwrite(out, 1, on, stdout);
        ck_ck(frc == 0 && out && json_val_eq(out, on, "0.5"), "f64-red-8-is-0.5");
        if (out) free(out);
        out = 0; on = 0;
        rc = compile_ujs("ujs/tests/g4-let-f64.ujs", "/tmp/g4-let-f64.wasm");
        ck_ck(rc == 0, "compile-f64-persist");
        av[5] = "/tmp/g4-let-f64.wasm";
        frc = cx_runv_timeout(av, 20, &out, &on);
        if (out && on) fwrite(out, 1, on, stdout);
        ck_ck(frc == 0 && out && json_val_eq(out, on, "4"), "f64-persist-8-is-4");
        if (out) free(out);
    }
    rc = compile_ujs("ujs/tests/g4-let-2slot-red.ujs", "/tmp/g4-let-2slot-red.wasm");
    ck_ck(rc == 0, "compile-2slot-red");
    v = frame_last("/tmp/g4-let-2slot-red.wasm", 8);
    ck_ck(v == 1001, "2slot-red-8-is-1001");
    rc = compile_ujs("ujs/tests/g4-let-2slot.ujs", "/tmp/g4-let-2slot.wasm");
    ck_ck(rc == 0, "compile-2slot");
    v = frame_last("/tmp/g4-let-2slot.wasm", 8);
    ck_ck(v == 8008, "2slot-persist-8-is-8008");
    rc = compile_ujs("ujs/tests/g4-let-mix-red.ujs", "/tmp/g4-let-mix-red.wasm");
    ck_ck(rc == 0, "compile-mix-red");
    {
        char *av[8];
        char *out2 = 0;
        size_t on2 = 0;
        int frc;
        av[0] = "sh"; av[1] = "./unisacc.com"; av[2] = "ujs/product/frame-run.cx";
        av[3] = "ujs/product/host1_vm.cx"; av[4] = "--";
        av[5] = "/tmp/g4-let-mix-red.wasm"; av[6] = "8"; av[7] = 0;
        frc = cx_runv_timeout(av, 20, &out2, &on2);
        if (out2 && on2) fwrite(out2, 1, on2, stdout);
        ck_ck(frc == 0 && out2 && json_val_eq(out2, on2, "0.5"), "mix-red-8-is-0.5");
        if (out2) free(out2);
        out2 = 0; on2 = 0;
        rc = compile_ujs("ujs/tests/g4-let-mix.ujs", "/tmp/g4-let-mix.wasm");
        ck_ck(rc == 0, "compile-mix");
        av[5] = "/tmp/g4-let-mix.wasm";
        frc = cx_runv_timeout(av, 20, &out2, &on2);
        if (out2 && on2) fwrite(out2, 1, on2, stdout);
        ck_ck(frc == 0 && out2 && json_val_eq(out2, on2, "4"), "mix-persist-8-is-4");
        if (out2) free(out2);
    }
    rc = compile_ujs("ujs/tests/g4-let-slot63.ujs", "/tmp/g4-let-slot63.wasm");
    ck_ck(rc == 0, "compile-slot63");
    v = frame_last("/tmp/g4-let-slot63.wasm", 8);
    ck_ck(v == 8, "slot63-persist-8-is-8");
    rc = compile_ujs("ujs/tests/g4-let-65.ujs", "/tmp/g4-let-65.wasm");
    ck_ck(rc != 0, "compile-65-refused");
    if (ck_failed) {
        printf("UJS_G4_YAW_FAIL\tasserts=%d\tfailed=%d\n", ck_asserts, ck_failed);
        return 1;
    }
    f = fopen("/usr/bin/google-chrome", "rb");
    if (!f) {
        printf("UJS_G4_YAW_UNMEASURED\tno-chrome\thost-ok\n");
        return 2;
    }
    fclose(f);
    if (!getcwd(cwd, sizeof cwd)) return 2;
    while (pre[n]) { url[n] = pre[n]; n++; }
    for (i = 0; cwd[i] && n < 630; i++) url[n++] = cwd[i];
    {
        const char *suf = "/ujs/practice/uxe/demo/g4-let/index.html";
        for (i = 0; suf[i] && n < 639; i++) url[n++] = suf[i];
    }
    url[n] = 0;
    rc = dump_dom(url, &out, &on);
    if (!out || !title_is(out, on, "G4_LET_OK")) {
        printf("FAIL\tchrome-title rc=%d\n", rc);
        if (out) free(out);
        printf("UJS_G4_YAW_FAIL\tasserts=%d\tfailed=%d\n", ck_asserts + 1, ck_failed + 1);
        return 1;
    }
    printf("PASS\tchrome-G4_LET_OK\n");
    free(out); out = 0; on = 0;
    n = 0;
    while (pre[n]) { url[n] = pre[n]; n++; }
    for (i = 0; cwd[i] && n < 620; i++) url[n++] = cwd[i];
    {
        const char *suf = "/ujs/practice/uxe/demo/g4-let/index.html?red=1";
        for (i = 0; suf[i] && n < 639; i++) url[n++] = suf[i];
    }
    url[n] = 0;
    rc = dump_dom(url, &out, &on);
    if (!out || !title_is(out, on, "G4_LET_RED") || title_is(out, on, "G4_LET_OK")) {
        printf("FAIL\tchrome-red-title rc=%d\n", rc);
        if (out) free(out);
        printf("UJS_G4_YAW_FAIL\tasserts=%d\tfailed=%d\n", ck_asserts + 2, ck_failed + 1);
        return 1;
    }
    printf("PASS\tchrome-G4_LET_RED\n");
    if (out) free(out);
    printf("UJS_G4_YAW_OK\tasserts=%d\tfailed=0\n", ck_asserts + 2);
    return 0;
}
