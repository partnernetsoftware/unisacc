#pragma unisa use chrome_dom
/* tools/run-uxe-regress.cx -- 九条 UXE 回归加 s0-exist 摘要.
 * sh ./unisacc.com tools/run-uxe-regress.cx --
 */
static const char *nm[10];
static const char *path[10];
static int njob;
static void add(const char *n, const char *p) {
    nm[njob] = n;
    path[njob] = p;
    njob++;
}
static void last_line(const char *s, long n, char *out, int cap) {
    long i, a, b;
    int k;
    if (!s || n <= 0) { out[0] = 0; return; }
    i = n - 1;
    while (i >= 0 && (s[i] == '\n' || s[i] == '\r')) i--;
    b = i;
    while (i >= 0 && s[i] != '\n') i--;
    a = i + 1;
    k = 0;
    while (a <= b && k < cap - 1) { out[k++] = s[a++]; }
    out[k] = 0;
}
int main(void) {
    char *av[8], *out;
    size_t on;
    char sum[512], bin[700];
    int i, rc, bad, n, k;
    const char *s;
    add("gpu-tri", "tools/check-ujs-gpu-tri.cx");
    add("tex16", "tools/check-uxe-tex16.cx");
    add("tex2", "tools/check-uxe-tex2.cx");
    add("blend", "tools/check-uxe-blend.cx");
    add("v4", "tools/check-uxep-v4.cx");
    add("points-proj", "tools/check-uxe-points-proj.cx");
    add("font", "tools/check-uxe-font.cx");
    add("ss-tex", "tools/check-uxe-ss-tex.cx");
    add("gen-s0-assets", "tools/check-gen-s0-assets.cx");
    add("s0-exist", "tools/check-uxe-s0-exist.cx");
    if (!getcwd(bin, 512)) return 2;
    n = 0; while (bin[n]) n++;
    bin[n++] = '/';
    s = "unisacc.com";
    k = 0; while (s[k]) bin[n++] = s[k++];
    bin[n] = 0;
    av[0] = "/bin/sh";
    av[1] = bin;
    av[3] = "--";
    av[4] = 0;
    bad = 0;
    for (i = 0; i < njob; i++) {
        out = 0; on = 0;
        av[2] = (char *)path[i];
        rc = cx_runv_timeout(av, 55, &out, &on);
        last_line(out, (long)on, sum, 512);
        printf("%s\trc=%d\t%s\n", nm[i], rc, sum);
        if (rc) bad++;
        if (out) free(out);
    }
    printf("UXE_REGRESS\tn=%d\tfailed=%d\n", njob, bad);
    return bad ? 1 : 0;
}
