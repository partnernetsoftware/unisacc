/* Checks cx/sys/sigwatch.cx: sy_sig_watch / sy_sig_taken (Linux).
     sh ./unisacc.com tools/check-cx-sys-sigwatch.cx
   Prints PASS/FAIL lines and CX_SYS_SIGWATCH<TAB>ok=N<TAB>failed=N; exit 1 on any FAIL. */
#pragma unisa use sys.sig
#pragma unisa use sys.sigwatch
static int nok, nfail;
static void ck(int c, const char *name) {
    printf("%s\tsigwatch.%s\n", c ? "PASS" : "FAIL", name);
    if (c) nok++; else nfail++;
}
static void ckv(long got, long want, const char *name) {
    if (got != want) printf("NOTE\tsigwatch.%s\tgot=%ld\twant=%ld\n", name, got, want);
    ck(got == want, name);
}
int main(void) {
    ckv(sy_sig_watch(0), -EINVAL, "watch-zero");
    ckv(sy_sig_watch(99), -EINVAL, "watch-big");
    ckv(sy_sig_watch(9), -EINVAL, "watch-sigkill");
    ckv(sy_sig_taken(0), -EINVAL, "taken-zero");
    ckv(sy_sig_taken(10), 0, "taken-unwatched");
    ckv(sy_sig_watch(10), 0, "watch-usr1");
    ckv(sy_sig_taken(10), 0, "taken-none");
    ckv(sy_raise(10), 0, "raise-1");
    ckv(sy_sig_taken(10), 1, "taken-one");
    ckv(sy_sig_taken(10), 0, "taken-cleared");
    sy_raise(10); sy_raise(10); sy_raise(10);
    ckv(sy_sig_taken(10), 3, "taken-three");
    ckv(sy_sig_watch(12), 0, "watch-usr2");
    sy_raise(12);
    ckv(sy_sig_taken(10), 0, "other-sig-untouched");
    ckv(sy_sig_taken(12), 1, "usr2-one");
    printf("CX_SYS_SIGWATCH\tok=%d\tfailed=%d\n", nok, nfail);
    return nfail ? 1 : 0;
}
