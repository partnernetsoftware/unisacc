/* tools/check-slow-split.cx -- 校验慢批拆分(signal-targets/win-argv/snapshots-cx/premerge-selfcheck)原批与分片断言多重集严格相等。
 *   sh ./unisacc.com tools/check-slow-split.cx [-- --group all|signal-targets|win-argv|snapshots-cx|premerge-selfcheck]
 * Runs each original batch alongside its split parts concurrently, extracts every PASS assertion ID
 * (column 2 of PASS<TAB>ID lines), sorts both multisets, and requires exact multiset equality
 * (missing, extra, or duplicate assertions all fail). Last line: CHECK_SLOW_SPLIT<TAB>ok=N<TAB>failed=M<TAB>ms=T. */
#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.time
#pragma unisa use sys.env
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use text.text
#pragma unisa use text.fmt

#define CSS_MAX_JOBS 8
#define CSS_MAX_IDS 1024
#define CSS_ID_LEN 160

typedef struct {
    char label[64];
    int pid;
    int fd;
    char *out;
    long n;
    long cap;
    int done;
    int rc;
    long t0;
    long ms;
} CssJob;

typedef struct {
    char ids[CSS_MAX_IDS][CSS_ID_LEN];
    int n;
    int fails;
} CssBag;

static int css_start(CssJob *j, const char *label, char **argv) {
    mm_fill(j, sizeof *j, 0, sizeof *j);
    tx_copy(j->label, sizeof j->label, label, tx_len(label, 60));
    j->cap = 65536;
    j->out = (char *)mm_alloc((size_t)j->cap);
    if (!j->out) return 1;
    j->t0 = sy_now_ms();
    long deadline = j->t0 + 55000;
    (void)deadline;
    j->pid = sy_spawn_pipe(argv, 0, 0, &j->fd, 0);
    if (j->pid < 0) {
        j->done = 1;
        j->rc = 127;
        return 1;
    }
    /* the read end is polled across every job: a blocking read on the first job would hold the others' end-of-output (and so their ms) until it finished */
    sy_fd_nonblock(j->fd, 1);
    return 0;
}

static void css_wait_all(CssJob *jobs, int nj, long bound_ms) {
    long deadline = sy_now_ms() + bound_ms;
    int left = nj;
    while (left > 0) {
        int progressed = 0;
        for (int i = 0; i < nj; i++) {
            CssJob *j = &jobs[i];
            if (j->done) continue;
            if (j->n + 4096 >= j->cap) {
                char *nb = (char *)mm_grow(j->out, (size_t)(j->cap * 2));
                if (!nb) { j->rc = 126; j->done = 1; left--; continue; }
                j->out = nb;
                j->cap *= 2;
            }
            long g = sy_read_once(j->fd, j->out + j->n, j->cap - 1 - j->n);
            if (g > 0) {
                j->n += g;
                j->out[j->n] = 0;
                progressed = 1;
            } else if (g == 0) {
                int ex = 0, code = 0, sig = 0;
                sy_close(j->fd);
                j->ms = sy_now_ms() - j->t0;
                j->rc = (sy_wait_status(j->pid, 0, &ex, &code, &sig) == j->pid && ex) ? code : 128;
                j->done = 1;
                left--;
                progressed = 1;
            } else if (g != -EAGAIN && g != -EINTR) {   /* a read error ends the job named, never spins */
                sy_close(j->fd);
                j->ms = sy_now_ms() - j->t0;
                sy_kill(j->pid);
                sy_wait_status(j->pid, 0, 0, 0, 0);
                j->rc = 126;
                j->done = 1;
                left--;
                progressed = 1;
            }
        }
        if (left > 0 && sy_now_ms() >= deadline) {
            for (int i = 0; i < nj; i++) {
                if (!jobs[i].done) {
                    sy_kill(jobs[i].pid);
                    sy_close(jobs[i].fd);
                    sy_wait_status(jobs[i].pid, 0, 0, 0, 0);
                    jobs[i].rc = 124;
                    jobs[i].ms = sy_now_ms() - jobs[i].t0;
                    jobs[i].done = 1;
                    left--;
                }
            }
            break;
        }
        if (!progressed && left > 0) sy_sleep_ms(10);
    }
}

static void css_collect(const char *buf, long n, CssBag *bag) {
    long at = 0;
    while (at < n) {
        long e = tx_chr(buf + at, n - at, '\n');
        long l = e < 0 ? n - at : e;
        if (l > 5 && tx_prefix(buf + at, l, "FAIL\t", 5)) {
            bag->fails++;
        } else if (l > 5 && tx_prefix(buf + at, l, "PASS\t", 5)) {
            long id_start = at + 5, id_end = id_start;
            while (id_end < at + l && buf[id_end] != '\t' && buf[id_end] != '\r') id_end++;
            long il = id_end - id_start;
            if (il > 0 && bag->n < CSS_MAX_IDS) {
                if (il >= CSS_ID_LEN) il = CSS_ID_LEN - 1;
                mm_copy(bag->ids[bag->n], CSS_ID_LEN, buf + id_start, (size_t)il);
                bag->ids[bag->n][il] = 0;
                bag->n++;
            }
        }
        at += l + 1;
    }
}

static int css_str_lt(const char *a, const char *b) {
    long i = 0;
    while (a[i] && b[i]) {
        if (a[i] != b[i]) return (unsigned char)a[i] < (unsigned char)b[i];
        i++;
    }
    return a[i] == 0 && b[i] != 0;
}

static void css_sort(CssBag *bag) {
    char tmp[CSS_ID_LEN];
    for (int i = 1; i < bag->n; i++) {
        int j = i;
        mm_copy(tmp, CSS_ID_LEN, bag->ids[i], CSS_ID_LEN);
        while (j > 0 && css_str_lt(tmp, bag->ids[j - 1])) {
            mm_copy(bag->ids[j], CSS_ID_LEN, bag->ids[j - 1], CSS_ID_LEN);
            j--;
        }
        mm_copy(bag->ids[j], CSS_ID_LEN, tmp, CSS_ID_LEN);
    }
}

static int css_compare(const char *group, CssJob *jobs, int nj, long group_ms) {
    CssBag orig, parts;
    mm_fill(&orig, sizeof orig, 0, sizeof orig);
    mm_fill(&parts, sizeof parts, 0, sizeof parts);
    int bad_rc = 0;
    for (int i = 0; i < nj; i++) {
        if (jobs[i].rc != 0) {
            sy_eprintf("check-slow-split: %s job=%s rc=%d\n", group, jobs[i].label, jobs[i].rc);
            bad_rc++;
        }
        if (i == 0) css_collect(jobs[i].out, jobs[i].n, &orig);
        else css_collect(jobs[i].out, jobs[i].n, &parts);
    }
    css_sort(&orig);
    css_sort(&parts);

    int diff = 0, i = 0, j = 0;
    while (i < orig.n || j < parts.n) {
        if (i < orig.n && j < parts.n && tx_eqz(orig.ids[i], parts.ids[j])) {
            i++; j++;
        } else if (j >= parts.n || (i < orig.n && css_str_lt(orig.ids[i], parts.ids[j]))) {
            sy_eprintf("check-slow-split: DIFF %s MISSING_IN_PARTS %s\n", group, orig.ids[i]);
            diff++; i++;
        } else {
            sy_eprintf("check-slow-split: DIFF %s EXTRA_OR_DUP_IN_PARTS %s\n", group, parts.ids[j]);
            diff++; j++;
        }
    }

    int ok = (bad_rc == 0 && orig.fails == 0 && parts.fails == 0 && diff == 0);
    sy_printf("%s\tslow-split.%s\torig=%d\tparts=%d\tunion=%d\tms=%ld\n",
              ok ? "PASS" : "FAIL", group, orig.n, nj - 1, parts.n, group_ms);
    for (int k = 0; k < nj; k++) {
        sy_printf("SPLIT_TIMING\tgroup=%s\tjob=%s\trc=%d\tms=%ld\n", group, jobs[k].label, jobs[k].rc, jobs[k].ms);
        if (jobs[k].out) mm_free(jobs[k].out);
    }
    return ok ? 0 : 1;
}

#define CSS_MAX_ENTRIES 32
#define CSS_MAX_SHARDS 7
#define CSS_MAX_ARGV 24

typedef struct {
    char parent[96];
    char orig_entry[192];
    char orig_args[256];
    char check[96];
    char check_entry[192];
    char check_args[256];
    char shards[CSS_MAX_SHARDS][96];
    char shard_entry[CSS_MAX_SHARDS][192];
    char shard_args[CSS_MAX_SHARDS][256];
    int nshards;
} CssEntry;

static int css_lookup_batch(const char *bt, long bn, const char *id,
                            char *entry_out, size_t entry_cap,
                            char *args_out, size_t args_cap) {
    long at = 0, idl = tx_len(id, 128);
    if (entry_out && entry_cap) entry_out[0] = 0;
    if (args_out && args_cap) args_out[0] = 0;
    while (at < bn) {
        long e = tx_chr(bt + at, bn - at, '\n'), l = e < 0 ? bn - at : e;
        long o0, l0, o1, l1, o8, l8, o9, l9;
        if (l > 0 && bt[at] != '#' &&
            !tx_field(bt + at, l, '\t', 0, &o0, &l0) && l0 == idl && tx_same(bt + at + o0, l0, id, idl) &&
            !tx_field(bt + at, l, '\t', 1, &o1, &l1) && l1 == 11 && tx_same(bt + at + o1, l1, "IMPLEMENTED", 11) &&
            !tx_field(bt + at, l, '\t', 8, &o8, &l8) && l8 > 0 &&
            !tx_field(bt + at, l, '\t', 9, &o9, &l9) && l9 > 0) {
            if (entry_out && entry_cap) {
                long cp = (l8 < (long)entry_cap - 1) ? l8 : (long)entry_cap - 1;
                mm_copy(entry_out, entry_cap, bt + at + o8, (size_t)cp);
                entry_out[cp] = 0;
            }
            if (args_out && args_cap) {
                long cp = (l9 < (long)args_cap - 1) ? l9 : (long)args_cap - 1;
                mm_copy(args_out, args_cap, bt + at + o9, (size_t)cp);
                args_out[cp] = 0;
            }
            return 1;
        }
        at += l + 1;
    }
    return 0;
}

static int css_build_argv(const char *entry, const char *args, const char *workdir,
                          char **argv_out, char tok_buf[CSS_MAX_ARGV][256]) {
    int c = 0;
    argv_out[c++] = "sh";
    argv_out[c++] = "./unisacc.com"; /* lint:allow R1-product runs registered split parent/shard check via installed product */
    argv_out[c++] = (char *)entry;
    argv_out[c++] = "--";
    if (args && args[0] && !tx_eqz(args, "-")) {
        long al = tx_len(args, 256), p = 0;
        while (p < al && c < CSS_MAX_ARGV - 1) {
            long e = p;
            while (e < al && args[e] != ';') e++;
            long tl = e - p;
            if (tl > 0) {
                if (tl == 6 && tx_same(args + p, 6, "{root}", 6)) {
                    tx_copy(tok_buf[c], 256, ".", 1);
                    tok_buf[c][1] = 0;
                } else if (tl == 5 && tx_same(args + p, 5, "{out}", 5)) {
                    long wl = tx_len(workdir, 255);
                    mm_copy(tok_buf[c], 256, workdir, (size_t)wl);
                    tok_buf[c][wl] = 0;
                } else {
                    if (tl >= 256) tl = 255;
                    mm_copy(tok_buf[c], 256, args + p, (size_t)tl);
                    tok_buf[c][tl] = 0;
                }
                argv_out[c] = tok_buf[c];
                c++;
            }
            p = e + 1;
        }
    }
    argv_out[c] = 0;
    return c;
}

static int css_run_entry(const CssEntry *en, const char *work) {
    long t0 = sy_now_ms();
    if (!en->orig_entry[0] || en->nshards < 2 || en->nshards >= CSS_MAX_JOBS) return 1;

    CssJob jobs[CSS_MAX_JOBS];
    char dirs[CSS_MAX_JOBS][256];
    char *av[CSS_MAX_ARGV];
    char toks[CSS_MAX_ARGV][256];
    int nj = 1 + en->nshards;

    if (cx_fmt(dirs[0], sizeof dirs[0], "%s/%s-orig", work, en->parent)) return 1;
    css_build_argv(en->orig_entry, en->orig_args, dirs[0], av, toks);
    css_start(&jobs[0], "orig", av);
    for (int i = 0; i < en->nshards; i++) {
        if (cx_fmt(dirs[i + 1], sizeof dirs[i + 1], "%s/%s", work, en->shards[i])) return 1;
        css_build_argv(en->shard_entry[i], en->shard_args[i], dirs[i + 1], av, toks);
        css_start(&jobs[i + 1], en->shards[i], av);
    }
    css_wait_all(jobs, nj, 55000);
    return css_compare(en->parent, jobs, nj, sy_now_ms() - t0);
}

static int css_valid_ver3(const char *s, long n) {
    int parts = 0, dig = 0;
    for (long i = 0; i <= n; i++) {
        char c = (i < n) ? s[i] : 0;
        if (c >= '0' && c <= '9') { dig++; if (dig > 6) return 0; }
        else if ((c == '.' || c == 0) && dig > 0) { parts++; dig = 0; if (c == 0) break; }
        else return 0;
    }
    return parts == 3;
}

/* Single-source loader: parses and validates tests/split-parents.tsv against tests/batches.tsv.
 * Reads exact shard ids and verifier batch from the table (no hard-coded parent/shard/check literals
 * and no prefix scan over unrelated batches). */
static int css_load_split_table(const char *path, CssEntry *entries, int maxe, int *out_n) {
    int bad = 0, ne = 0;
    size_t pn = 0, bn = 0;
    *out_n = 0;
    char *pb = (char *)cx_read(path, &pn);
    if (!pb) {
        sy_eprintf("check-slow-split: cannot read split-parents table %s\n", path);
        sy_printf("FAIL\tslow-split.split-parents-table\treason=unreadable\n");
        return 1;
    }
    char *bt = (char *)cx_read("tests/batches.tsv", &bn);
    if (!bt) {
        mm_free(pb);
        sy_eprintf("check-slow-split: cannot read tests/batches.tsv\n");
        sy_printf("FAIL\tslow-split.split-parents-table\treason=no-batches\n");
        return 1;
    }
    long at = 0;
    while (at < (long)pn) {
        long e = tx_chr(pb + at, (long)pn - at, '\n'), l = e < 0 ? (long)pn - at : e;
        if (l > 0 && pb[at + l - 1] == '\r') { sy_eprintf("check-slow-split: CRLF in %s\n", path); bad++; }
        if (l > 0 && pb[at] != '#') {
            long o0, l0, o1, l1, o2, l2, o3, l3, o4, l4;
            if (tx_fields(pb + at, l, '\t') != 5 ||
                tx_field(pb + at, l, '\t', 0, &o0, &l0) || tx_field(pb + at, l, '\t', 1, &o1, &l1) ||
                tx_field(pb + at, l, '\t', 2, &o2, &l2) || tx_field(pb + at, l, '\t', 3, &o3, &l3) ||
                tx_field(pb + at, l, '\t', 4, &o4, &l4)) {
                sy_eprintf("check-slow-split: malformed row (need 5 cols) in %s\n", path);
                bad++;
            } else {
                char par[96], shs[512], chk[96];
                if (l0 >= 96) l0 = 95; mm_copy(par, 96, pb + at + o0, (size_t)l0); par[l0] = 0;
                if (l1 >= 512) l1 = 511; mm_copy(shs, 512, pb + at + o1, (size_t)l1); shs[l1] = 0;
                if (l2 >= 96) l2 = 95; mm_copy(chk, 96, pb + at + o2, (size_t)l2); chk[l2] = 0;
                if (!tx_eqz(par, "parent")) {
                    char orig_e[192], orig_a[256], chk_e[192], chk_a[256];
                    if (!css_valid_ver3(pb + at + o3, l3)) { sy_eprintf("check-slow-split: invalid since version in %s\n", path); bad++; }
                    for (int k = 0; k < ne; k++) if (tx_eqz(entries[k].parent, par)) { sy_eprintf("check-slow-split: duplicate parent %s\n", par); bad++; }
                    if (!css_lookup_batch(bt, (long)bn, par, orig_e, sizeof orig_e, orig_a, sizeof orig_a) || sy_exists(orig_e) != 1) {
                        sy_eprintf("check-slow-split: parent %s not IMPLEMENTED or entry missing\n", par);
                        bad++;
                    }
                    if (!css_lookup_batch(bt, (long)bn, chk, chk_e, sizeof chk_e, chk_a, sizeof chk_a) || sy_exists(chk_e) != 1) {
                        sy_eprintf("check-slow-split: check %s not IMPLEMENTED or entry missing\n", chk);
                        bad++;
                    } else if (tx_eqz(chk_e, "tools/check-slow-split.cx")) {
                        char want_arg[128];
                        if (cx_fmt(want_arg, sizeof want_arg, "--group;%s", par) ||
                            tx_find(chk_a, tx_len(chk_a, 256), want_arg, tx_len(want_arg, 128)) < 0) {
                            sy_eprintf("check-slow-split: check batch %s args=%s does not target --group;%s\n", chk, chk_a, par);
                            bad++;
                        }
                    }

                    if (ne >= maxe) { sy_eprintf("check-slow-split: exceeds max parents %d\n", maxe); bad++; }
                    else {
                        CssEntry *en = &entries[ne];
                        mm_fill(en, sizeof *en, 0, sizeof *en);
                        tx_copy(en->parent, sizeof en->parent, par, tx_len(par, 95));
                        tx_copy(en->orig_entry, sizeof en->orig_entry, orig_e, tx_len(orig_e, 191));
                        tx_copy(en->orig_args, sizeof en->orig_args, orig_a, tx_len(orig_a, 255));
                        tx_copy(en->check, sizeof en->check, chk, tx_len(chk, 95));
                        tx_copy(en->check_entry, sizeof en->check_entry, chk_e, tx_len(chk_e, 191));
                        tx_copy(en->check_args, sizeof en->check_args, chk_a, tx_len(chk_a, 255));
                        long sp = 0, sl = tx_len(shs, 512);
                        while (sp < sl) {
                            long se = sp;
                            while (se < sl && shs[se] != ',') se++;
                            long ol = se - sp;
                            if (ol > 0 && ol < 96 && en->nshards < CSS_MAX_SHARDS) {
                                char one[96], se_buf[192], sa_buf[256];
                                mm_copy(one, 96, shs + sp, (size_t)ol); one[ol] = 0;
                                if (tx_eqz(one, par)) { sy_eprintf("check-slow-split: parent %s listed as own shard\n", par); bad++; }
                                for (int k = 0; k < en->nshards; k++) if (tx_eqz(en->shards[k], one)) { sy_eprintf("check-slow-split: duplicate shard %s\n", one); bad++; }
                                if (!css_lookup_batch(bt, (long)bn, one, se_buf, sizeof se_buf, sa_buf, sizeof sa_buf) || sy_exists(se_buf) != 1) {
                                    sy_eprintf("check-slow-split: shard %s not IMPLEMENTED or entry missing\n", one);
                                    bad++;
                                } else {
                                    tx_copy(en->shards[en->nshards], 96, one, ol);
                                    tx_copy(en->shard_entry[en->nshards], 192, se_buf, tx_len(se_buf, 191));
                                    tx_copy(en->shard_args[en->nshards], 256, sa_buf, tx_len(sa_buf, 255));
                                    en->nshards++;
                                }
                            } else bad++;
                            sp = se + 1;
                        }
                        if (en->nshards < 2) { sy_eprintf("check-slow-split: parent %s needs >=2 shards\n", par); bad++; }
                        ne++;
                    }
                }
            }
        }
        at += l + 1;
    }
    for (int i = 0; i < ne; i++) {
        for (int k = 0; k < entries[i].nshards; k++) {
            for (int j = 0; j < ne; j++) {
                if (tx_eqz(entries[i].shards[k], entries[j].parent)) {
                    sy_eprintf("check-slow-split: chained shard-as-parent %s\n", entries[i].shards[k]);
                    bad++;
                }
            }
        }
    }
    if (ne == 0) { sy_eprintf("check-slow-split: empty split-parents table %s\n", path); bad++; }
    mm_free(bt);
    mm_free(pb);
    *out_n = ne;
    sy_printf("%s\tslow-split.split-parents-table\tparents=%d\tbad=%d\n", bad ? "FAIL" : "PASS", ne, bad);
    return bad ? 1 : 0;
}

int main(int argc, char **argv) {
    long t0 = sy_now_ms();
    const char *group = "all";
    const char *parents_path = "tests/split-parents.tsv";
    int table_only = 0;
    const char *td = sy_tmpdir();
    const char *base_td = (td && td[0] == '/') ? td : "/tmp";
    char work[4096];
    CssEntry entries[CSS_MAX_ENTRIES];
    int ne = 0, ok = 0, failed = 0;

    for (int i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--group") && i + 1 < argc) group = argv[++i];
        else if (tx_eqz(argv[i], "--parents") && i + 1 < argc) parents_path = argv[++i];
        else if (tx_eqz(argv[i], "--table-only")) table_only = 1;
        else { sy_eprintf("check-slow-split: usage [-- --group all|PARENT] [--parents FILE] [--table-only]\n"); return 2; }
    }

    int tbl_rc = css_load_split_table(parents_path, entries, CSS_MAX_ENTRIES, &ne);
    if (table_only) {
        if (tbl_rc == 0) ok++; else failed++;
        sy_printf("CHECK_SLOW_SPLIT\tok=%d\tfailed=%d\tms=%ld\n", ok, failed, sy_now_ms() - t0);
        return failed ? 1 : 0;
    }
    if (tbl_rc == 0) ok++; else failed++;

    if (cx_fmt(work, sizeof work, "%s/check-slow-split-%d", base_td, (int)sy_pid())) return 2;
    if (sy_mkdir(work, 0700) != 0) return 2;

    int ran = 0;
    for (int i = 0; i < ne; i++) {
        if (tx_eqz(group, "all") || tx_eqz(group, entries[i].parent)) {
            ran++;
            if (css_run_entry(&entries[i], work) == 0) ok++; else failed++;
        }
    }
    (void)cx_rmtree(work);

    if (ran == 0) { sy_eprintf("check-slow-split: unknown group %s\n", group); return 2; }
    sy_printf("CHECK_SLOW_SPLIT\tok=%d\tfailed=%d\tms=%ld\n", ok, failed, sy_now_ms() - t0);
    return failed ? 1 : 0;
}
