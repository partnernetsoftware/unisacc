/* tools/check-slow-split.cx -- 校验慢批拆分(signal-targets/win-argv/snapshots-cx)原批与分片断言多重集严格相等。
 *   sh ./unisacc.com tools/check-slow-split.cx [-- --group all|signal-targets|win-argv|snapshots-cx]
 * Runs each original batch alongside its split parts concurrently, extracts every PASS assertion ID
 * (column 2 of PASS<TAB>ID lines), sorts both multisets, and requires exact multiset equality
 * (missing, extra, or duplicate assertions all fail). Last line: CHECK_SLOW_SPLIT<TAB>ok=N<TAB>failed=M<TAB>ms=T. */
#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.time
#pragma unisa use sys.env
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use text.text
#pragma unisa use text.fmt

#define CSS_MAX_JOBS 8
#define CSS_MAX_IDS 1024
#define CSS_ID_LEN 160

typedef struct {
    char label[64];
    int pid;
    int fd;
    char *out;
    long n;
    long cap;
    int done;
    int rc;
    long t0;
    long ms;
} CssJob;

typedef struct {
    char ids[CSS_MAX_IDS][CSS_ID_LEN];
    int n;
    int fails;
} CssBag;

static int css_start(CssJob *j, const char *label, char **argv) {
    mm_fill(j, sizeof *j, 0, sizeof *j);
    tx_copy(j->label, sizeof j->label, label, tx_len(label, 60));
    j->cap = 65536;
    j->out = (char *)mm_alloc((size_t)j->cap);
    if (!j->out) return 1;
    j->t0 = sy_now_ms();
    long deadline = j->t0 + 55000;
    (void)deadline;
    j->pid = sy_spawn_pipe(argv, 0, 0, &j->fd, 0);
    if (j->pid < 0) {
        j->done = 1;
        j->rc = 127;
        return 1;
    }
    return 0;
}

static void css_wait_all(CssJob *jobs, int nj, long bound_ms) {
    long deadline = sy_now_ms() + bound_ms;
    int left = nj;
    while (left > 0) {
        int progressed = 0;
        for (int i = 0; i < nj; i++) {
            CssJob *j = &jobs[i];
            if (j->done) continue;
            if (j->n + 4096 >= j->cap) {
                char *nb = (char *)mm_grow(j->out, (size_t)(j->cap * 2));
                if (!nb) { j->rc = 126; j->done = 1; left--; continue; }
                j->out = nb;
                j->cap *= 2;
            }
            long g = sy_read_once(j->fd, j->out + j->n, j->cap - 1 - j->n);
            if (g > 0) {
                j->n += g;
                j->out[j->n] = 0;
                progressed = 1;
            } else if (g == 0) {
                int ex = 0, code = 0, sig = 0;
                sy_close(j->fd);
                j->ms = sy_now_ms() - j->t0;
                j->rc = (sy_wait_status(j->pid, 0, &ex, &code, &sig) == j->pid && ex) ? code : 128;
                j->done = 1;
                left--;
                progressed = 1;
            }
        }
        if (left > 0 && sy_now_ms() >= deadline) {
            for (int i = 0; i < nj; i++) {
                if (!jobs[i].done) {
                    sy_kill(jobs[i].pid);
                    sy_close(jobs[i].fd);
                    sy_wait_status(jobs[i].pid, 0, 0, 0, 0);
                    jobs[i].rc = 124;
                    jobs[i].done = 1;
                    left--;
                }
            }
            break;
        }
        if (!progressed && left > 0) sy_sleep_ms(10);
    }
}

static void css_collect(const char *buf, long n, CssBag *bag) {
    long at = 0;
    while (at < n) {
        long e = tx_chr(buf + at, n - at, '\n');
        long l = e < 0 ? n - at : e;
        if (l > 5 && tx_prefix(buf + at, l, "FAIL\t", 5)) {
            bag->fails++;
        } else if (l > 5 && tx_prefix(buf + at, l, "PASS\t", 5)) {
            long id_start = at + 5, id_end = id_start;
            while (id_end < at + l && buf[id_end] != '\t' && buf[id_end] != '\r') id_end++;
            long il = id_end - id_start;
            if (il > 0 && bag->n < CSS_MAX_IDS) {
                if (il >= CSS_ID_LEN) il = CSS_ID_LEN - 1;
                mm_copy(bag->ids[bag->n], CSS_ID_LEN, buf + id_start, (size_t)il);
                bag->ids[bag->n][il] = 0;
                bag->n++;
            }
        }
        at += l + 1;
    }
}

static int css_str_lt(const char *a, const char *b) {
    long i = 0;
    while (a[i] && b[i]) {
        if (a[i] != b[i]) return (unsigned char)a[i] < (unsigned char)b[i];
        i++;
    }
    return a[i] == 0 && b[i] != 0;
}

static void css_sort(CssBag *bag) {
    char tmp[CSS_ID_LEN];
    for (int i = 1; i < bag->n; i++) {
        int j = i;
        mm_copy(tmp, CSS_ID_LEN, bag->ids[i], CSS_ID_LEN);
        while (j > 0 && css_str_lt(tmp, bag->ids[j - 1])) {
            mm_copy(bag->ids[j], CSS_ID_LEN, bag->ids[j - 1], CSS_ID_LEN);
            j--;
        }
        mm_copy(bag->ids[j], CSS_ID_LEN, tmp, CSS_ID_LEN);
    }
}

static int css_compare(const char *group, CssJob *jobs, int nj, long group_ms) {
    CssBag orig, parts;
    mm_fill(&orig, sizeof orig, 0, sizeof orig);
    mm_fill(&parts, sizeof parts, 0, sizeof parts);
    int bad_rc = 0;
    for (int i = 0; i < nj; i++) {
        if (jobs[i].rc != 0) {
            sy_eprintf("check-slow-split: %s job=%s rc=%d\n", group, jobs[i].label, jobs[i].rc);
            bad_rc++;
        }
        if (i == 0) css_collect(jobs[i].out, jobs[i].n, &orig);
        else css_collect(jobs[i].out, jobs[i].n, &parts);
    }
    css_sort(&orig);
    css_sort(&parts);

    int diff = 0, i = 0, j = 0;
    while (i < orig.n || j < parts.n) {
        if (i < orig.n && j < parts.n && tx_eqz(orig.ids[i], parts.ids[j])) {
            i++; j++;
        } else if (j >= parts.n || (i < orig.n && css_str_lt(orig.ids[i], parts.ids[j]))) {
            sy_eprintf("check-slow-split: DIFF %s MISSING_IN_PARTS %s\n", group, orig.ids[i]);
            diff++; i++;
        } else {
            sy_eprintf("check-slow-split: DIFF %s EXTRA_OR_DUP_IN_PARTS %s\n", group, parts.ids[j]);
            diff++; j++;
        }
    }

    int ok = (bad_rc == 0 && orig.fails == 0 && parts.fails == 0 && diff == 0);
    sy_printf("%s\tslow-split.%s\torig=%d\tparts=%d\tunion=%d\tms=%ld\n",
              ok ? "PASS" : "FAIL", group, orig.n, nj - 1, parts.n, group_ms);
    for (int k = 0; k < nj; k++) {
        sy_printf("SPLIT_TIMING\tgroup=%s\tjob=%s\trc=%d\tms=%ld\n", group, jobs[k].label, jobs[k].rc, jobs[k].ms);
        if (jobs[k].out) mm_free(jobs[k].out);
    }
    return ok ? 0 : 1;
}

static int run_signal_targets(void) {
    long t0 = sy_now_ms();
    CssJob jobs[4];
    char *v0[] = {"sh", "./unisacc.com", "tools/check-signal-targets.cx", "--", ".", 0};
    char *v1[] = {"sh", "./unisacc.com", "tools/check-signal-targets-part.cx", "--", "--part", "gen", ".", 0};
    char *v2[] = {"sh", "./unisacc.com", "tools/check-signal-targets-part.cx", "--", "--part", "posix", ".", 0};
    char *v3[] = {"sh", "./unisacc.com", "tools/check-signal-targets-part.cx", "--", "--part", "win", ".", 0};
    css_start(&jobs[0], "orig", v0);
    css_start(&jobs[1], "gen", v1);
    css_start(&jobs[2], "posix", v2);
    css_start(&jobs[3], "win", v3);
    css_wait_all(jobs, 4, 55000);
    return css_compare("signal-targets", jobs, 4, sy_now_ms() - t0);
}

static int run_win_argv(void) {
    long t0 = sy_now_ms();
    CssJob jobs[4];
    char *v0[] = {"sh", "./unisacc.com", "tools/check-win-argv.cx", "--", ".", 0};
    char *v1[] = {"sh", "./unisacc.com", "tools/check-win-argv-part.cx", "--", "--part", "facts", ".", 0};
    char *v2[] = {"sh", "./unisacc.com", "tools/check-win-argv-part.cx", "--", "--part", "x86_64", ".", 0};
    char *v3[] = {"sh", "./unisacc.com", "tools/check-win-argv-part.cx", "--", "--part", "arm64", ".", 0};
    css_start(&jobs[0], "orig", v0);
    css_start(&jobs[1], "facts", v1);
    css_start(&jobs[2], "x86_64", v2);
    css_start(&jobs[3], "arm64", v3);
    css_wait_all(jobs, 4, 55000);
    return css_compare("win-argv", jobs, 4, sy_now_ms() - t0);
}

static int run_snapshots_cx(const char *work) {
    long t0 = sy_now_ms();
    CssJob jobs[3];
    char d0[4096], d1[4096], d2[4096];
    if (cx_fmt(d0, sizeof d0, "%s/snap-orig", work) ||
        cx_fmt(d1, sizeof d1, "%s/snap-core", work) ||
        cx_fmt(d2, sizeof d2, "%s/snap-alloc", work)) return 1;
    char *v0[] = {"sh", "./unisacc.com", "tests/snapshots-cx.cx", "--", ".", d0, 0};
    char *v1[] = {"sh", "./unisacc.com", "tools/check-snapshots-cx-part.cx", "--", "--part", "core", ".", d1, 0};
    char *v2[] = {"sh", "./unisacc.com", "tools/check-snapshots-cx-part.cx", "--", "--part", "alloc", ".", d2, 0};
    css_start(&jobs[0], "orig", v0);
    css_start(&jobs[1], "core", v1);
    css_start(&jobs[2], "alloc", v2);
    css_wait_all(jobs, 3, 55000);
    return css_compare("snapshots-cx", jobs, 3, sy_now_ms() - t0);
}

int main(int argc, char **argv) {
    long t0 = sy_now_ms();
    const char *group = "all";
    const char *td = sy_tmpdir();
    const char *base_td = (td && td[0] == '/') ? td : "/tmp";
    char work[4096];
    int ok = 0, failed = 0;

    if (argc == 3 && tx_eqz(argv[1], "--group")) group = argv[2];
    else if (argc != 1) { sy_eprintf("check-slow-split: usage [-- --group all|signal-targets|win-argv|snapshots-cx]\n"); return 2; }

    if (cx_fmt(work, sizeof work, "%s/check-slow-split-%d", base_td, (int)sy_pid())) return 2;
    if (sy_mkdir(work, 0700) != 0) return 2;

    if (tx_eqz(group, "all") || tx_eqz(group, "signal-targets")) {
        if (run_signal_targets() == 0) ok++; else failed++;
    }
    if (tx_eqz(group, "all") || tx_eqz(group, "win-argv")) {
        if (run_win_argv() == 0) ok++; else failed++;
    }
    if (tx_eqz(group, "all") || tx_eqz(group, "snapshots-cx")) {
        if (run_snapshots_cx(work) == 0) ok++; else failed++;
    }
    (void)cx_rmtree(work);

    if (ok + failed == 0) { sy_eprintf("check-slow-split: unknown group %s\n", group); return 2; }
    sy_printf("CHECK_SLOW_SPLIT\tok=%d\tfailed=%d\tms=%ld\n", ok, failed, sy_now_ms() - t0);
    return failed ? 1 : 0;
}
