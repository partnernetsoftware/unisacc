#pragma unisa use cxlib.uxeimage
#pragma unisa use chrome_dom
/* tools/gen-s0-lily.cx -- 概念稿荷叶椭圆 900x220.
 * ellipse(x,y,48,18,0.2) at five pads. #2A4A18
 * sh ./unisacc.com tools/gen-s0-lily.cx -- --write|--check
 */
#define CW 900
#define CH 220
#define OX 120
#define OY 360
static unsigned char cpix[CH][CW][4];
static const int padx[5] = {180, 320, 500, 700, 860};
static const int pady[5] = {400, 440, 380, 460, 410};
static int in_ell(double wx, double wy, double cx, double cy) {
    double c = 0.9800665778412416, s = 0.19866933079506122;
    double dx = wx - cx, dy = wy - cy;
    double u = dx * c + dy * s, v = -dx * s + dy * c;
    return (u * u) / (48.0 * 48.0) + (v * v) / (18.0 * 18.0) <= 1.0;
}
static void fill_lily(void) {
    int y, x, i, hit;
    for (y = 0; y < CH; y++) for (x = 0; x < CW; x++) {
        double wx = (double)(OX + x), wy = (double)(OY + y);
        hit = 0;
        for (i = 0; i < 5; i++) if (in_ell(wx, wy, (double)padx[i], (double)pady[i])) hit = 1;
        if (hit) {
            cpix[y][x][0] = 42; cpix[y][x][1] = 74; cpix[y][x][2] = 24; cpix[y][x][3] = 255;
        } else {
            cpix[y][x][0] = 0; cpix[y][x][1] = 0; cpix[y][x][2] = 0; cpix[y][x][3] = 0;
        }
    }
}
static unsigned char outb[CH * (1 + CW * 4) + (CH * (1 + CW * 4) / 65535 + 1) * 5 + 63];
int main(int argc, char **argv) {
    int write = 0, check = 0, i, oi, failed = 0;
    FILE *f;
    uxe_crc_init();
    for (i = 1; i < argc; i++) {
        if (argv[i][0] == '-' && argv[i][2] == 'w') write = 1;
        if (argv[i][0] == '-' && argv[i][2] == 'c') check = 1;
    }
    if (!write && !check) { printf("GEN_S0_LILY\tdry\n"); return 0; }
    fill_lily();
    oi = uxe_encode_rgba_png(outb,sizeof outb,&cpix[0][0][0],CW,CH);
    if(oi<=0) return 2;
    if (write) {
        f = fopen("ujs/plans/demo-v2/look-dev/lily-pad.png", "wb");
        if (!f) return 1;
        fwrite(outb, 1, oi, f);
        fclose(f);
        printf("WROTE\tlily-pad.png\t%d\n", oi);
    }
    if (check) {
        if (uxe_check_png("ujs/plans/demo-v2/look-dev/lily-pad.png", outb, oi)) {
            printf("DIFF\tlily-pad.png\n"); failed = 1;
        } else printf("MATCH\tlily-pad.png\n");
    }
    printf("GEN_S0_LILY\tok\n");
    return failed;
}
