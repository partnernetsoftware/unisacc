/* Raw DEFLATE stored block; CRC is independently obtained from gzip. */
#pragma unisa use runtime.model_payload
static int failed;
static int reject(const unsigned char *p,long n) { return p && n==9; }
static void ck(int ok, const char *name) {
    printf("%s\t%s\n", ok ? "PASS" : "FAIL", name);
    if (!ok) failed++;
}
int main(void) {
    unsigned char input[] = {1,9,0,246,255,'U','N','I','N','E','T','B','1','N',0};
    unsigned char wrong[] = {1,9,0,246,255,'X','N','I','N','E','T','B','1','N'};
    ck(cxmp_audit(input,14,9,4131514041U)==0,"valid");
    ck(cxmp_audit(input,14,9,0)==4,"crc");
    ck(cxmp_audit(input,13,9,4131514041U)==3,"truncated");
    ck(cxmp_audit(input,14,10,4131514041U)==3,"raw-length");
    ck(cxmp_audit(input,15,9,4131514041U)==3,"extra-input");
    ck(cxmp_audit(0,14,9,0)==1,"null");
    ck(cxmp_audit(input,14,0,0)==1,"empty-raw");
    ck(cxmp_audit(wrong,14,9,118358510U)==5,"network-marker");
    ck(cxmp_audit_with(input,14,9,4131514041U,reject)==6,"network-callback-reject");
    printf("CXMODEL_PAYLOAD\tfailed=%d\n",failed);
    return failed != 0;
}
