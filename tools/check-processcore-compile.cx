/* Checks installed compiler -S expansion of process module consumers.
 * Regression 7026ecaa4d: default-run success did not prove static code generation. */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.env
int main(void){
 const char*product=sy_env_or("UNISACC","./unisacc.com"); /* lint:allow R1-product Run the same candidate compiler explicitly; the harness may override UNISACC. */
 const char*inputs[]={"tests/bound-rc142.cx","tests/all-aggregate.cx"};int failed=0;
 for(int i=0;i<2;i++){char*v[]={"sh",(char*)product,(char*)inputs[i],"-S",0},why[400];np_result r={0};int tr=np_run(v,0,0,25,&r,why,sizeof why);int ok=!tr&&!r.rc&&r.outn>0;printf("CHECK\tprocesscore-compile\tinput=%s\trc=%d\ttransport=%d\tbytes=%lu\tstatus=%s\n",inputs[i],r.rc,tr,(unsigned long)r.outn,ok?"PASS":"FAIL");if(!ok){failed++;fprintf(stderr,"%s\n%s\n",tr?why:"compile refused",r.err?r.err:"");}np_free(&r);}
 printf("CHECK_PROCESSCORE_COMPILE\tfailed=%d\n",failed);return failed?1:0;
}
