/* tools/check-func-callgraph.cx -- tools/func-callgraph.cx 的检查。
 *
 *   sh ./unisacc.com tools/check-func-callgraph.cx -- [UNISACC_COM]     (仓库根目录运行;默认 ./unisacc.com)
 *
 * 1) seed/gen.c 函数数 = 290 且函数名清单与 tests/fixtures/func-callgraph-gen-funcs.txt 逐行相同
 *    (--write [UNISACC_COM] 重写清单);2) 小夹具边界逐行精确(含注释/字符串内花括号、续行宏、
 * 数组初始化、多行签名、单行函数默认不收);3) --oneline 多收单行函数;4) 缺文件非零退出;
 * 5) seed/gen.c 的矩阵含 A-全局公共 与 X-仅inspect调试 两类。
 * 输出 PASS/FAIL 与 CHECK_FUNC_CALLGRAPH<TAB>failed=N。 */
#pragma unisa use sys.proc
#pragma unisa use sys.io
#pragma unisa use text.text
#pragma unisa use sys.fs
#pragma unisa use mem.heap

static int failed;
static char buf[1 << 17];
static void ck(int ok, const char *name) {
    if (ok) sy_printf("PASS\tcheck-func-callgraph.%s\n", name);
    else { failed++; sy_printf("FAIL\tcheck-func-callgraph.%s\n", name); }
}

/* 取 --funcs 输出每行首列(函数名),逐行写入 out,返回长度;超出 cap 返回 -1。 */
static long names_of(const char *s, long n, char *out, long cap) {
    long i = 0, o = 0;
    while (i < n) {
        while (i < n && s[i] != '\t' && s[i] != '\n') { if (o + 2 > cap) return -1; out[o++] = s[i++]; }
        while (i < n && s[i] != '\n') i++;
        if (i < n) i++;
        if (o + 2 > cap) return -1;
        out[o++] = '\n';
    }
    out[o] = 0;
    return o;
}

/* 期望函数名清单(按源码顺序);seed/gen.c 增删函数时用 --write 重写并在提交说明写明来源。
 * 281 -> 290:4f2c7e5574(T1 集成)新增 buf_char die_at frame_coherence frame_emissions
 * frame_out_byte frame_output_action frame_rejects gen_json_failure input_register
 * manifest_graph_call_fields open_input,删除 pp_install_sourcefacts pp_sourcefacts_edit。 */
#define GEN_FUNCS_LIST "tests/fixtures/func-callgraph-gen-funcs.txt"
#define GEN_FUNCS_COUNT 290
static char names[1 << 15];

int main(int argc, char **argv) {
    int wr = argc > 1 && tx_eqz(argv[1], "--write");
    const char *com = argc > 1 + wr ? argv[1 + wr] : "./unisacc.com";
    int cut = 0, rc; long n, lines, nn;
    {
        char *a[] = {"sh", (char *)com, "tools/func-callgraph.cx", "--", "seed/gen.c", "--funcs", 0};
        char *want = 0; long wn = 0;
        rc = sy_run(a, buf, sizeof buf, &cut); n = tx_len(buf, sizeof buf);
        ck(rc == 0 && !cut, "gen-runs");
        nn = names_of(buf, n, names, sizeof names);
        if (wr) {
            if (nn < 0 || sy_write_file(GEN_FUNCS_LIST, names, nn, 0644) != 0) { sy_printf("FAIL\twrite %s\n", GEN_FUNCS_LIST); return 1; }
            sy_printf("WROTE\t%s\tfuncs=%ld\n", GEN_FUNCS_LIST, tx_count(names, nn, "\n", 1));
            return 0;
        }
        ck(tx_count(buf, n, "\n", 1) == GEN_FUNCS_COUNT, "gen-290-funcs");
        ck(nn >= 0 && sy_read_file(GEN_FUNCS_LIST, &want, &wn, sizeof names) == 0 && want
           && tx_same(names, nn, want, wn), "gen-funcs-list-exact");
        if (!(nn >= 0 && want && tx_same(names, nn, want, wn))) sy_printf("GOT-FUNCS\n%s", nn >= 0 ? names : "(overflow)\n");
        if (want) mm_free(want);
    }
    {
        char *a[] = {"sh", (char *)com, "tools/func-callgraph.cx", "--", "tests/fixtures/func-callgraph-small.c", "--funcs", 0};
        const char *want;
        rc = sy_run(a, buf, sizeof buf, &cut); n = tx_len(buf, sizeof buf);
        /* main 为单行函数,默认不收;期望只有 alpha/beta/gamma_f */
        want = "alpha\t10\t15\t6\nbeta\t16\t20\t5\ngamma_f\t22\t24\t3\n";
        ck(rc == 0 && tx_same(buf, n, want, tx_len(want, 999)), "fixture-bounds");
        if (!(rc == 0 && tx_same(buf, n, want, tx_len(want, 999)))) sy_printf("GOT\n%s", buf);
    }
    {
        char *a[] = {"sh", (char *)com, "tools/func-callgraph.cx", "--", "tests/fixtures/func-callgraph-small.c", "--funcs", "--oneline", 0};
        rc = sy_run(a, buf, sizeof buf, &cut); n = tx_len(buf, sizeof buf);
        ck(rc == 0 && tx_count(buf, n, "\n", 1) == 5 && tx_contains(buf, n, "one\t9\t9\t1\n", 10), "fixture-oneline");
    }
    {
        char *a[] = {"sh", (char *)com, "tools/func-callgraph.cx", "--", "/nonexistent-dir/no-such-file.c", 0};
        rc = sy_run(a, buf, sizeof buf, &cut);
        ck(rc != 0, "missing-file-rejected");
    }
    {
        char *a[] = {"sh", (char *)com, "tools/func-callgraph.cx", "--", "seed/gen.c", 0};
        rc = sy_run(a, buf, sizeof buf, &cut); n = tx_len(buf, sizeof buf);
        lines = tx_count(buf, n, "\tA-全局公共\t", 0 + tx_len("\tA-全局公共\t", 99));
        ck(rc == 0 && lines > 0 && tx_contains(buf, n, "\tX-仅inspect调试\t", tx_len("\tX-仅inspect调试\t", 99)), "matrix-classes");
    }
    sy_printf("CHECK_FUNC_CALLGRAPH\tfailed=%d\n", failed);
    return failed ? 1 : 0;
}
