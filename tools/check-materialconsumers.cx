#pragma unisa use cxlib.materialconsumers
static int failed,checks;
static void ck(int ok,const char *name){checks++;if(!ok)failed++;printf("%s\tmaterialconsumers.%s\n",ok?"PASS":"FAIL",name);}
int main(void){
 int count=mc_load("libneed-native"),found=0,unique=1;
 ck(count>0,"declared-family-nonempty");
 for(int i=0;i<count;i++){const char *id=mc_id(i);if(!id){unique=0;continue;}
  if(!strcmp(id,"libneed-attributes"))found++;
  for(int j=0;j<i;j++)if(!strcmp(id,mc_id(j)))unique=0;
 }
 ck(found==1,"original-bare-family-consumer-retained");
 ck(unique,"unique-owned-ids");
 ck(!mc_id(-1)&&!mc_id(count),"getter-bounds");
 ck(mc_load("libneed-native:")==-1&&!mc_id(0),"invalid-family-clears-previous-result");
 ck(mc_load("libneed-native-no-such-family")==0&&!mc_id(0),"family-prefix-is-not-a-match");
 ck(mc_load("libneed-native")==count&&mc_id(0),"reload-rebuilds-facts");
 ck(mc_load(0)==-1&&!mc_id(0),"null-family-clears-result");
 printf("CHECK_MATERIALCONSUMERS\tchecks=%d\tfailed=%d\n",checks,failed);return failed?1:0;
}
