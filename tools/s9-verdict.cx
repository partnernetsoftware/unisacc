/* tools/s9-verdict.cx -- 把 s9 aggregate 产物映射为 release/evidence.tsv 第 4 行(只读,不写 evidence.tsv)。
 *   sh ./unisacc.com tools/s9-verdict.cx -- RUN [--batches tests/batches.tsv]
 * 输入: RUN/aggregate.out(`s9-shards aggregate ROOT RUN` 的 stdout 原样落盘;发布流程负责落盘)与 RUN/tier(init 写入:commit|release|all)。
 * 输出一行: 4<TAB>PASS|FAIL|UNKNOWN<TAB>RUN/aggregate.out ,原因写 stderr(S9_VERDICT reason=...)。
 * all/daily 保留既有规则与输出: FAIL 优先;全体 IMPLEMENTED 批为 PASS 且 AGGREGATE 计数一致才 PASS。
 * release 只接受独立的 S9 RELEASE_ONLY 行,用与计划器相同的平台谓词独立重建 IMPLEMENTED/release 批名集合,
 * 每个成员恰好一条真实尝试对应的 BATCH 行,状态和全部计数严格一致才 PASS;混入 daily AGGREGATE 不作证明。
 * release 的 PASS 只表该范围通过,不是 daily 的 QUALIFIED。缺失、未知、重复、范围外批名或伪计数不记 PASS。 */
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use cxlib.platformscope

static char *slurp(const char *p, size_t *n) {
    FILE *f = fopen(p, "rb");
    char *b; size_t cap = 1 << 16, len = 0, r;
    if (!f) return 0;
    b = (char *)malloc(cap + 1);
    if (!b) { fclose(f); return 0; }
    while ((r = fread(b + len, 1, cap - len, f)) > 0) {
        len += r;
        if (len == cap) { cap *= 2; b = (char *)realloc(b, cap + 1); if (!b) { fclose(f); return 0; } }
    }
    fclose(f);
    b[len] = 0; *n = len;
    return b;
}
/* 取第 k 个制表符字段(0 起)到 out;无则返回 0。 */
static int field(const char *ln, int k, char *out, int cap) {
    int i = 0;
    while (k > 0) { while (*ln && *ln != '\t') ln++; if (!*ln) return 0; ln++; k--; }
    while (*ln && *ln != '\t' && i < cap - 1) out[i++] = *ln++;
    out[i] = 0;
    return 1;
}
static long kv(const char *ln, const char *key) { /* 在行内找 key=数字 字段 */
    char f[128]; int k;
    size_t kl = strlen(key);
    for (k = 1; field(ln, k, f, sizeof f); k++)
        if (!strncmp(f, key, kl) && f[kl] == '=') return atol(f + kl + 1);
    return -1;
}
static long expected(const char *bt, const char *tier) { /* 数 tests/batches.tsv 的 IMPLEMENTED 批,release 只数 tier 列为 release */
    size_t n; char *s = slurp(bt, &n), *p; long c = 0; int rel = !strcmp(tier, "release");
    if (!s) return -1;
    p = s;
    while (*p) {
        char *e = p, impl[64], t[64];
        while (*e && *e != '\n') e++;
        { char sv = *e; *e = 0;
          if (p != s && field(p, 1, impl, sizeof impl) && !strcmp(impl, "IMPLEMENTED")) {
              if (!rel) c++;
              else if (field(p, 13, t, sizeof t) && !strcmp(t, "release")) c++;
          }
          *e = sv; }
        p = *e ? e + 1 : e;
    }
    free(s);
    return c;
}
static void setwhy(char *w, const char *s) {
    size_t n = strlen(s);
    if (n > 199) n = 199;
    if (mm_copy(w, 200, s, (long)n)) n = 0;
    w[n] = 0;
}
typedef struct {char id[128];int seen;} release_row;
/* Release uses exactly the planner's existing native-host predicate. Daily retains its historical parser. */
static int release_scope(const char *bt,release_row **rows){
 size_t n;char *s=slurp(bt,&n);int count=0,cap=32;*rows=calloc((size_t)cap,sizeof **rows);
 if(!s||!*rows){free(s);free(*rows);*rows=0;return -1;}
 char *p=s;int invalid=0;
 while(*p&&!invalid){char *e=p;while(*e&&*e!='\n')e++;char save=*e;*e=0;
  char impl[64],tier[64],platform[64],id[129]; /* spare byte detects an overlong ID rather than accepting a truncated prefix */
  if(p!=s&&p[0]!='#'&&field(p,1,impl,sizeof impl)&&!strcmp(impl,"IMPLEMENTED")&&field(p,13,tier,sizeof tier)&&!strcmp(tier,"release")&&field(p,5,platform,sizeof platform)&&psc_platform_allowed(platform)){
   if(!field(p,0,id,sizeof id)||!id[0]||strlen(id)>127)invalid=1;
   for(int i=0;i<count;i++)if(!strcmp((*rows)[i].id,id))invalid=1;
   if(!invalid){if(count==cap){cap*=2;release_row *b=realloc(*rows,(size_t)cap*sizeof **rows);if(!b){invalid=1;}else *rows=b;}
    if(!invalid){if(tx_copy((*rows)[count].id,sizeof id-1,id,strlen(id)))invalid=1;(*rows)[count].seen=0;count++;}}
  }*e=save;p=save?e+1:e;
 }
 free(s);if(invalid){free(*rows);*rows=0;return -1;}return count;
}
static int release_value(const char *line,const char *key,char *out,int cap){
 char f[512];size_t k=strlen(key);int found=0;
 for(int i=1;field(line,i,f,sizeof f);i++)if(!strncmp(f,key,k)&&f[k]=='='){
  if(found++||strlen(f+k+1)>=(size_t)cap)return 0;if(tx_copy(out,cap,f+k+1,strlen(f+k+1)))return 0;
 }return found==1;
}
static int release_number(const char *line,const char *key,long *out){
 char v[64];if(!release_value(line,key,v,sizeof v)||!v[0])return 0;long n=0;
 for(int i=0;v[i];i++){if(v[i]<'0'||v[i]>'9'||n>214748364||(n==214748364&&v[i]>'7'))return 0;n=n*10+v[i]-'0';}*out=n;return 1;
}
static const char *judge_release(const char *text,const char *bt,char *why){
 size_t wire=strlen(text);if(!wire||text[wire-1]!='\n'){setwhy(why,"release-aggregate-wire");return "UNKNOWN";}
 release_row *rows=0;int count=release_scope(bt,&rows);if(count<=0){free(rows);setwhy(why,"release-registry-unreadable-or-empty");return "UNKNOWN";}
 size_t n=strlen(text);char *s=malloc(n+1);if(!s){free(rows);setwhy(why,"allocation");return "UNKNOWN";}if(mm_copy(s,n+1,text,n+1)){free(rows);free(s);setwhy(why,"copy-bound");return "UNKNOWN";}
 long actual[5]={0},declared[7]={0};const char *keys[]={"pass","fail","unknown","missing","refused","selected","pending"};
 int bad=0,summaries=0,nb=0;char status[64]="";char *p=s;
 while(*p){char *e=p;while(*e&&*e!='\n')e++;char save=*e;*e=0;char kind[64];
  if(field(p,0,kind,sizeof kind)&&!strcmp(kind,"BATCH")){
   char id[129],v[64];int index=-1,vi=-1;long attempts=-1;nb++;
   if(!field(p,1,id,sizeof id)||!field(p,2,v,sizeof v))bad++;
   else{for(int i=0;i<count;i++)if(!strcmp(rows[i].id,id))index=i;
    if(index<0||rows[index].seen)bad++;else rows[index].seen=1;
    const char *states[]={"PASS","FAIL","UNKNOWN","MISSING","REFUSED"};for(int i=0;i<5;i++)if(!strcmp(v,states[i]))vi=i;
    if(vi<0)bad++;else actual[vi]++;
    if(!release_number(p,"attempts",&attempts)||(vi==3?attempts!=0:attempts<1))bad++;
   }
  }else if(!strcmp(kind,"S9")){
   char mode[64],value[64];if(!field(p,1,mode,sizeof mode)||strcmp(mode,"RELEASE_ONLY")||summaries++)bad++;
   for(int i=0;i<7;i++)if(!release_number(p,keys[i],&declared[i]))bad++;
   if(!release_value(p,"tier",value,sizeof value)||strcmp(value,"release"))bad++;
   if(!release_value(p,"host_scope",value,sizeof value)||strcmp(value,psc_host_scope()))bad++;
   if(!release_value(p,"qualification",value,sizeof value)||strcmp(value,"NOT_FULL"))bad++;
   if(!release_value(p,"status",status,sizeof status))bad++;
  }else if(!strcmp(kind,"S9_NA")){long na=-1;if(!release_number(p,"n",&na)||na!=0)bad++;
  }else if(strcmp(kind,"S9_AGG_PART_WALL"))bad++;
  *e=save;p=save?e+1:e;
 }
 for(int i=0;i<count;i++)if(!rows[i].seen)bad++;
 for(int i=0;i<5;i++)if(actual[i]!=declared[i])bad++;
 if(nb!=count||declared[5]!=count||summaries!=1)bad++;
 const char *want=actual[0]==count&&!declared[6]?"PASS":actual[1]?"FAIL":"UNKNOWN";
 if(strcmp(status,want))bad++;
 free(rows);free(s);
 if(actual[1]){setwhy(why,"fail-present");return "FAIL";}
 if(bad){setwhy(why,"release-scope-or-counter-mismatch");return "UNKNOWN";}
 if(actual[0]!=count||declared[6]){setwhy(why,"release-non-pass-state");return "UNKNOWN";}
 setwhy(why,"release-scope-all-pass");return "PASS";
}
static const char *judge(const char *run, const char *bt, char *why) {
    char p[4400], tier[64] = ""; size_t n; char *s, *q; long nb = 0, agg_impl = -1, exp; int fail = 0, bad = 0, has_agg = 0;
    if (cx_fmt(p, sizeof p, "%s/tier", run)) { setwhy(why,"path-too-long"); return "UNKNOWN"; }
    s = slurp(p, &n);
    if (!s) { setwhy(why, "tier-missing"); return "UNKNOWN"; }
    { size_t i = 0; while (i < n && s[i] != '\n' && i < sizeof tier - 1) { tier[i] = s[i]; i++; } tier[i] = 0; }
    free(s);
    if (strcmp(tier, "release") && strcmp(tier, "all")) { if (cx_fmt(why, 200, "tier-%s-not-full", tier)) setwhy(why, "tier-not-full"); return "UNKNOWN"; }
    if (cx_fmt(p, sizeof p, "%s/aggregate.out", run)) { setwhy(why,"path-too-long"); return "UNKNOWN"; }
    s = slurp(p, &n);
    if (!s || !n) { setwhy(why, "aggregate-missing-or-empty"); free(s); return "UNKNOWN"; }
    if (!strcmp(tier,"release")) { const char *v=judge_release(s,bt,why);free(s);return v; }
    q = s;
    while (*q) {
        char *e = q, k0[32], st[64];
        while (*e && *e != '\n') e++;
        { char sv = *e; *e = 0;
          if (field(q, 0, k0, sizeof k0)) {
              if (!strcmp(k0, "BATCH") && field(q, 2, st, sizeof st)) {
                  nb++;
                  if (!strcmp(st, "FAIL")) fail++; else if (strcmp(st, "PASS")) bad++;
              } else if (!strcmp(k0, "AGGREGATE")) {
                  has_agg = 1; agg_impl = kv(q, "implemented_batches");
                  if (kv(q, "fail") > 0) fail++;
                  if (kv(q, "unknown") != 0 || kv(q, "missing") != 0 || kv(q, "refused") != 0) bad++;
              } else if (!strcmp(k0, "S9")) { /* PENDING/COMMIT_ONLY/REGRESSION_ONLY 等非全量结论 */
                  bad++;
              }
          }
          *e = sv; }
        q = *e ? e + 1 : e;
    }
    free(s);
    if (fail) { setwhy(why, "fail-present"); return "FAIL"; }
    if (!has_agg) { setwhy(why, "no-aggregate-line"); return "UNKNOWN"; }
    if (bad) { setwhy(why, "non-pass-state"); return "UNKNOWN"; }
    exp = expected(bt, tier);
    if (exp <= 0) { setwhy(why, "registry-unreadable-or-empty"); return "UNKNOWN"; }
    if (nb != exp || agg_impl != exp) { if (cx_fmt(why, 200, "count-mismatch batch=%ld aggregate=%ld registry=%ld", nb, agg_impl, exp)) setwhy(why, "count-mismatch"); return "UNKNOWN"; }
    setwhy(why, "all-pass");
    return "PASS";
}
int main(int argc, char **argv) {
    const char *bt = "tests/batches.tsv", *run;
    char why[256] = "", ev[4400];
    if (argc != 2 && argc != 4) { fprintf(stderr, "usage: s9-verdict RUN [--batches FILE]\n"); return 2; }
    run = argv[1];
    if (argc == 4) { if (strcmp(argv[2], "--batches")) { fprintf(stderr, "usage\n"); return 2; } bt = argv[3]; }
    if (cx_fmt(ev, sizeof ev, "%s/aggregate.out", run)) { fprintf(stderr, "path-too-long\n"); return 2; }
    { const char *v = judge(run, bt, why);
      fprintf(stderr, "S9_VERDICT\treason=%s\n", why);
      printf("4\t%s\t%s\n", v, ev); }
    return 0;
}
