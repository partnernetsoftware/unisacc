    if (rln_at(0, &name) || !tx_eqz(name, "e2")) return 1;
    if (rln_at(1, &name) || !tx_eqz(name, "e3")) return 1;
    if (rln_at(2, &name) || !tx_eqz(name, "e4")) return 1;
