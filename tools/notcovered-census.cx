/* tools/notcovered-census.cx -- census of the distinct "not covered:" refusal texts under exec/ -> tests/notcovered.tsv.
 *
 *   sh ./unisacc.com tools/notcovered-census.cx [-- --check | --write | --print] [--root DIR]
 *
 * Columns: message class kind sites nets measured repro.  measured/repro come from the meas[] table below
 * (ACCEPT/REJECT, measured by tools/check-notcovered.cx on tests/notcovered-cases/REPRO.cx); every other row is
 * UNMEASURED.  --print writes the table to stdout; --write replaces tests/notcovered.tsv; --check (the 14th
 * ratchet, tools/ratchets.cx) compares and prints one summary line
 *   notcovered: ok: rows=N measured=M      or      notcovered: FAIL: new=A grown=B gone=C changed=D
 * followed by NEW / GROWN rows (a message the table lacks, or more sites than its row: only-go-down rule) and
 * GONE / CHANGED notes.  Any difference fails: a message that went away still needs --write so the base shrinks. */
#pragma unisa use sys.posix
#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

#define MAXM 2000
static const char *root = ".";
static char *msg[MAXM];
static long msgn[MAXM];
static int occ[MAXM];
static char *nets[MAXM];
static long netsn[MAXM];
static int ord[MAXM];
static int nm;

static const char *meas[][3] = {
    {"not covered: floating constant expression in __builtin_expect_with_probability", "REJECT", "branch_hint_float_expression"},
    {"not covered: an op outside the first encoder slice", "ACCEPT", "r01_frame_1d_1m,r02_frame_2d"},
    {"not covered: address or target declaration", "ACCEPT", "t08_frame_900k"},
    {"not covered: block-scope extern object without a visible file-scope declaration", "REJECT", "x16_block_extern_decl,v03_unclosed_main_fs"},
    {"not covered: malformed unit frame", "REJECT", "u03_extra_close,u01_stray_block"},
    {"not covered: nonconstant bound", "ACCEPT", "r09_offsetof_assert"},
    {"not covered: constant expression", "ACCEPT", "y01_sizeof_obj_static_bound,y02_sizeof_arr_ratio_static,y12_enum_sizeof_obj"},
    {"not covered: array of pointers to arrays", "REJECT", "t04_arr_of_ptr_to_arr"},
    {"not covered: pointer to pointer to array", "REJECT", "t05_ptr_ptr_arr"},
    {"not covered: array parameter whose element is a typedef array", "REJECT", "t10_array_param_typedef"},
    {"not covered: call through a non-function", "REJECT", "t03_fn_typedef_decl"},
    {"not covered: width", "REJECT", "r27_fn_typedef"},
    {"not covered: incompatible semantic declaration type", "ACCEPT", "s01_mu_fnptr_struct"},
    {"not covered: member access", "REJECT", "t09_stat_mtim"},
    {"not covered: top-level construct", "REJECT", "y09_noreturn,u02_stray_block_single"},
    {"not covered: expected )", "REJECT", "y05_sizeof_array_type"},
    {"not covered: expected ;", "REJECT", "y07_alignas"},
    {"not covered: expression", "REJECT", "y08_alignof_packed"},
    {"not covered: goto", "ACCEPT", "r10_goto"},
    {"not covered: struct return", "ACCEPT", "r13_struct_return"},
    {"not covered: more than 6 arguments", "ACCEPT", "r14_seven_args"},
    {"not covered: va_start", "ACCEPT", "r15_variadic"},
    {"not covered: va_arg", "ACCEPT", "r15_variadic"},
    {"not covered: array rank", "ACCEPT", "r18_array_rank"},
    {"not covered: double operand", "ACCEPT", "r19_double_update"},
    {"not covered: struct assignment", "ACCEPT", "r12_struct_assign"},
    {"not covered: a struct member of struct type", "ACCEPT", "r11_nested_struct"},
    {"not covered: adjacent string literals", "ACCEPT", "r23_string_forms"},
    {"not covered: ?: arms of different types", "ACCEPT", "r24_ternary_types"},
    {"not covered: parenthesized lvalue", "ACCEPT", "r28_paren_lvalue_misc"},
    {"not covered: global initialiser", "ACCEPT", "r22_global_init"},
    {"not covered: array initialiser", "ACCEPT", "r31_array_init"},
    {"not covered: function typedef shape", "ACCEPT", "t01_fn_typedef_ptr"},
    {"not covered: compound literal extent", "ACCEPT", "r21_compound_literal"},
};

static int has(const char *h, long hn, const char *s) {
    long sn = tx_len(s, 200), i;
    for (i = 0; i + sn <= hn; i++) if (mm_same(h + i, s, sn)) return 1;
    return 0;
}
static int net_seen(int i,const char *net,long n){
    for(long at=0;at<netsn[i];){long end=at;while(end<netsn[i]&&nets[i][end]!=',')end++;
        if(end-at==n&&mm_same(nets[i]+at,net,n))return 1;at=end+1;}
    return 0;
}
static void note(const char *m, long n, const char *net, long netn) {
    int i;
    for (i = 0; i < nm; i++) if (msgn[i] == n && mm_same(msg[i], m, n)) break;
    if (i == nm) {
        if (nm >= MAXM) return;
        msg[i] = mm_alloc(n + 1); mm_copy(msg[i], n + 1, m, n); msg[i][n] = 0; msgn[i] = n;
        nets[i] = mm_alloc(4096); netsn[i] = 0; nets[i][0] = 0;
        nm++;
    }
    occ[i]++;
    if (!net_seen(i,net,netn) && netsn[i] + netn + 2 < 4096) {
        if (netsn[i]) nets[i][netsn[i]++] = ',';
        mm_copy(nets[i] + netsn[i], 4096 - netsn[i], net, netn); netsn[i] += netn; nets[i][netsn[i]] = 0;
    }
}
static void scan(const char *rel) {
    char path[900];
    size_t m = 0;
    char *t;
    long n, i, rn = tx_len(rel, 900), netn, k;
    if (rn > 3 && mm_same(rel + rn - 3, ".md", 3)) return;
    if (has(rel, rn, "/probes/")) return;
    if (cx_fmt(path, sizeof path, "%s/%s", root, rel)) return;
    t = cx_read(path, &m);
    if (!t) return;
    n = (long)m;
    for (k = rn - 1; k >= 0 && rel[k] != '/'; k--) ;
    for (k = k + 1; k < rn && rel[k] != '-' && rel[k] != '.'; k++) ;
    netn = k;
    for (i = 0; i + 12 <= n; i++) {
        long e;
        if (t[i] != 'n' || !mm_same(t + i, "not covered:", 12)) continue;
        e = i + 12;
        while (e < n && t[e] != '\t' && t[e] != '\n' && t[e] != '"' && t[e] != '\\' && t[e] != '`' && e - i < 160) {
            if (t[e] == ',' && e + 7 < n && (mm_same(t + e, ",reject", 7) || mm_same(t + e, ",gapof=", 7))) break;
            e++;
        }
        while (e > i && t[e - 1] == ' ') e--;
        if (e - i > 12) note(t + i, e - i, rel, netn);
        i = e;
    }
    mm_free(t);
}
static void walk(const char *rel) {
    sy_dir_t d;
    char dir[900];
    if (cx_fmt(dir, sizeof dir, "%s/%s", root, rel) || sy_dir_open(&d, dir)) return;
    while (sy_dir_next(&d) == 1) {
        char r[900];
        if (d.name_n == 0 || d.name[0] == '.') continue;
        if (cx_fmt(r, sizeof r, "%s/%s", rel, d.name)) continue;
        if (d.kind == 'd') walk(r);
        else if (d.kind == 'f') scan(r);
    }
    sy_dir_close(&d);
}
static int cmp(const char *a, const char *b) {
    long i = 0;
    while (a[i] && a[i] == b[i]) i++;
    return (unsigned char)a[i] - (unsigned char)b[i];
}
/* Directory enumeration order is not part of the census contract. */
static void canonicalize_nets(int i) {
    long n=netsn[i],count=1,k=0,at=0;
    if(!n)return;
    for(long j=0;j<n;j++)if(nets[i][j]==',')count++;
    char **parts=mm_alloc(count*(long)sizeof *parts),*ordered=mm_alloc(4096);
    if(!parts||!ordered){fprintf(stderr,"notcovered: cannot canonicalize nets\n");exit(2);}
    parts[0]=nets[i];
    for(long j=0;j<n;j++)if(nets[i][j]==','){nets[i][j]=0;parts[++k]=nets[i]+j+1;}
    for(long j=1;j<count;j++){char*v=parts[j];long h=j;while(h>0&&cmp(parts[h-1],v)>0){parts[h]=parts[h-1];h--;}parts[h]=v;}
    for(long j=0;j<count;j++){long len=tx_len(parts[j],4096);if(j)ordered[at++]=',';
        if(len<0||at+len>=4096||mm_copy(ordered+at,4096-at,parts[j],len)){fprintf(stderr,"notcovered: canonical net bound\n");exit(2);}at+=len;}
    ordered[at]=0;mm_free(parts);mm_free(nets[i]);nets[i]=ordered;netsn[i]=at;
}
static const char *class_of(int i) {
    const char *m = msg[i], *s = nets[i];
    long n = msgn[i], sn = netsn[i];
    if (has(s, sn, "exec/pp/")) return "pp";
    if (has(m, n, "librar") || has(s, sn, "exec/c/") || has(s, sn, "exec/model") || has(m, n, "cc interop") || has(m, n, "native ABI") || has(m, n, "host")) return "library-abi";
    if (has(s, sn, "parse2/units") || has(s, sn, "layoutprovenance") || has(m, n, "unit ") || has(m, n, "token locations") || has(m, n, "layout")) return "units";
    if (has(s, sn, "exec/lex/") || has(s, sn, "exec/parse/")) return "lex-frames";
    if (has(s, sn, "exec/enc/") || has(s, sn, "exec/lower/") || has(s, sn, "exec/pipeline/") || has(s, sn, "exec/opt/") || has(s, sn, "exec/prune/") || has(s, sn, "exec/tapecheck/")) return "backend";
    if (has(s, sn, "parse2/constexpr") || has(s, sn, "parse2/vla") || has(m, n, "static assertion") || has(m, n, "constant") || has(m, n, "sizeof") || has(m, n, "offsetof")) return "constexpr";
    if (has(m, n, "expected ") || has(m, n, "unterminated") || has(m, n, "top-level") || has(m, n, "no main")) return "syntax-diag";
    if (has(m, n, "extern") || has(m, n, "static ") || has(m, n, "identifier") || has(m, n, "redecl") || has(m, n, "redefin") || has(m, n, "tag") || has(m, n, "label") || has(m, n, "goto") || has(m, n, "break/continue") || has(m, n, "__func__")) return "scope-decl";
    if (has(m, n, "array") || has(m, n, "initiali") || has(m, n, "subscript") || has(m, n, "compound literal") || has(m, n, "string") || has(m, n, "character")) return "array-init";
    if (has(m, n, "function") || has(m, n, "call") || has(m, n, "argument") || has(m, n, "va_") || has(m, n, "signature") || has(m, n, "parameter") || has(m, n, "return") || has(m, n, "printf") || has(m, n, "setjmp") || has(m, n, "arity")) return "function-call";
    if (has(m, n, "struct") || has(m, n, "member") || has(m, n, "enum") || has(m, n, "typedef") || has(m, n, "type") || has(m, n, "bit-field") || has(m, n, "pointer") || has(m, n, "declar") || has(m, n, "float") || has(m, n, "width") || has(m, n, "target")) return "type-decl";
    return "expr-stmt";
}
static const char *kind_of(int i) {
    const char *m = msg[i];
    long n = msgn[i];
    if (has(m, n, "capacity") || has(m, n, "exhausted") || has(m, n, "limit") || has(m, n, "more than") || has(m, n, "exceeds") || has(m, n, "budget") || has(m, n, "depth") || has(m, n, "longer than") || has(m, n, "beyond") || has(m, n, "nested too deeply")) return "cap";
    if (has(m, n, "malformed") || has(m, n, "truncated") || has(m, n, "out of domain") || has(m, n, "outside context domain") || has(m, n, "resource") || has(m, n, "facts") || has(m, n, "key ") || has(m, n, "wire") || has(m, n, "metadata") || has(m, n, "token view")) return "frame";
    if (has(m, n, "expected ") || has(m, n, "unterminated") || has(m, n, "twice") || has(m, n, "redecl") || has(m, n, "redefin") || has(m, n, "failed") || has(m, n, "zero divisor") || has(m, n, "division by zero") || has(m, n, "no main") || has(m, n, "outside a") || has(m, n, "non-") || has(m, n, "too few") || has(m, n, "too many") || has(m, n, "undefined") || has(m, n, "conflict") || has(m, n, "invalid") || has(m, n, "incomplete") || has(m, n, "of void")) return "diag";
    return "gap";
}
static char *ob; static long on, ocap;
static void ap(const char *s) {
    long n = tx_len(s, 1 << 20);
    if (on + n + 1 > ocap) { long nc = (on + n + 1) * 2; char *nb = mm_alloc(nc); if (on) mm_copy(nb, nc, ob, on); if (ob) mm_free(ob); ob = nb; ocap = nc; }
    mm_copy(ob + on, ocap - on, s, n); on += n; ob[on] = 0;
}
/* field f (0-based) of the TSV line [s, s+n) -> [*fs, *fs+*fn) */
static int field(const char *s, long n, int f, const char **fs, long *fn) {
    long a = 0, i; int c = 0;
    for (i = 0; i <= n; i++) if (i == n || s[i] == '\t') { if (c == f) { *fs = s + a; *fn = i - a; return 1; } c++; a = i + 1; }
    return 0;
}
static long find_line(const char *t, long tn, const char *ms, long mn, long *ln) {   /* line of t whose field 0 is ms */
    long at = 0;
    while (at < tn) {
        long e = at; const char *f; long fn;
        while (e < tn && t[e] != '\n') e++;
        if (field(t + at, e - at, 0, &f, &fn) && fn == mn && mm_same(f, ms, mn)) { *ln = e - at; return at; }
        at = e + 1;
    }
    return -1;
}
static long sites_of(const char *s, long n) { const char *f; long fn, v = 0, i; if (!field(s, n, 3, &f, &fn)) return -1; for (i = 0; i < fn; i++) v = v * 10 + (f[i] - '0'); return v; }
static int check(const char *path) {
    size_t m = 0; char *t = cx_read(path, &m); long tn, at = 0; int nw = 0, gr = 0, gone = 0, ch = 0, rows = 0, meas_n = 0;
    if (!t) { printf("notcovered: FAIL: cannot read %s\n", path); return 1; }
    tn = (long)m;
    while (at < on) {   /* generated vs table */
        long e = at, ln = 0, p; const char *f; long fn;
        while (e < on && ob[e] != '\n') e++;
        if (at > 0 && field(ob + at, e - at, 0, &f, &fn)) {
            rows++;
            { const char *mf; long mfn; if (field(ob + at, e - at, 5, &mf, &mfn) && !(mfn == 10 && mm_same(mf, "UNMEASURED", 10))) meas_n++; }
            p = find_line(t, tn, f, fn, &ln);
            if (p < 0) { nw++; printf("NEW\t%.*s\n", (int)(e - at), ob + at); }
            else if (sites_of(ob + at, e - at) > sites_of(t + p, ln)) { gr++; printf("GROWN\t%.*s\n", (int)(e - at), ob + at); }
            else if (ln != e - at || !mm_same(t + p, ob + at, ln)) { ch++; printf("CHANGED\t%.*s\n", (int)(e - at), ob + at); }
        }
        at = e + 1;
    }
    at = 0;
    while (at < tn) {   /* table rows the census no longer finds */
        long e = at, ln; const char *f; long fn;
        while (e < tn && t[e] != '\n') e++;
        if (at > 0 && field(t + at, e - at, 0, &f, &fn) && fn > 0 && find_line(ob, on, f, fn, &ln) < 0) { gone++; printf("GONE\t%.*s\n", (int)fn, f); }
        at = e + 1;
    }
    if (!(tn == on && mm_same(t, ob, on)) && !nw && !gr && !gone && !ch) ch++;
    mm_free(t);
    if (nw || gr || gone || ch) { printf("notcovered: FAIL: new=%d grown=%d gone=%d changed=%d (gone/changed only: run --write)\n", nw, gr, gone, ch); return 1; }
    printf("notcovered: ok: rows=%d measured=%d\n", rows, meas_n);
    return 0;
}
int main(int argc, char **argv) {
    int i, j, k, mode = 0;   /* 0 print, 1 check, 2 write */
    char line[8192], tpath[1000];
    for (i = 1; i < argc; i++) {
        if (tx_eqz(argv[i], "--check")) mode = 1;
        else if (tx_eqz(argv[i], "--write")) mode = 2;
        else if (tx_eqz(argv[i], "--print")) mode = 0;
        else if (tx_eqz(argv[i], "--root") && i + 1 < argc) root = argv[++i];
        else { fprintf(stderr, "usage: tools/notcovered-census.cx [--check|--write|--print] [--root DIR]\n"); return 2; }
    }
    walk("exec");
    if (nm == 0) { fprintf(stderr, "notcovered: FAIL: no \"not covered:\" text under %s/exec\n", root); return 2; }
    for(i=0;i<nm;i++)canonicalize_nets(i);
    for (i = 0; i < nm; i++) ord[i] = i;
    for (i = 1; i < nm; i++) { int v = ord[i]; for (j = i; j > 0 && cmp(msg[ord[j - 1]], msg[v]) > 0; j--) ord[j] = ord[j - 1]; ord[j] = v; }
    ap("message\tclass\tkind\tsites\tnets\tmeasured\trepro\n");
    for (j = 0; j < nm; j++) {
        const char *ms = "UNMEASURED", *rp = "-";
        i = ord[j];
        for (k = 0; k < (int)(sizeof meas / sizeof meas[0]); k++) if (!cmp(meas[k][0], msg[i])) { ms = meas[k][1]; rp = meas[k][2]; }
        if (cx_fmt(line, sizeof line, "%s\t%s\t%s\t%d\t%s\t%s\t%s\n", msg[i], class_of(i), kind_of(i), occ[i], nets[i], ms, rp)) { fprintf(stderr, "notcovered: line too long\n"); return 2; }
        ap(line);
    }
    if (cx_fmt(tpath, sizeof tpath, "%s/tests/notcovered.tsv", root)) return 2;
    if (mode == 1) return check(tpath);
    if (mode == 2) { if (cx_write(tpath, ob, on)) { fprintf(stderr, "notcovered: cannot write %s\n", tpath); return 2; } printf("NOTCOVERED_WRITE\trows=%d\t%s\n", nm, tpath); return 0; }
    fputs(ob, stdout);
    return 0;
}
