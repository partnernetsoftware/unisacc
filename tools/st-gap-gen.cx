/* tools/st-gap-gen.cx -- 由事实表 exec/facts/st-gap.tsv 生成 build/st-gap.tsv(mode 0..5 乘 level 0..2 共 18 格真值表)
 * 与 build/st-gap-chain.txt(应与 cx/runtime/runexec.cx 的 st_gap 逐行相同的 if 链)。不替换任何消费者。
 *
 *   sh ./unisacc.com tools/st-gap-gen.cx -- --write|--check [--root DIR]
 *
 * 表列: mode(0..9 或 *,* 只能在最后一行) level(any|le0) name([a-z0-9]+)。首个匹配行生效。
 * 坏行 REFUSE rc 2;--check 字节不同 rc 1。检查: tools/check-st-gap-gen.cx。 */
#pragma unisa use sys.io
#pragma unisa use sys.fs
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

#define MAXROW 32
#define OUTCAP 16384
static const char *root = ".";
static const char *tab;
static long fo[MAXROW][3], fl[MAXROW][3];
static int nrow;
static char *out, *out2;
static long outn, out2n;

static int streq(const char *a, const char *b) {
    long n = tx_len(a, 4096);
    return n == tx_len(b, 4096) && mm_same(a, b, n);
}
static int feq(int r, int c, const char *lit) {
    long n = tx_len(lit, 64);
    return fl[r][c] == n && mm_same(tab + fo[r][c], lit, n);
}
static void put(char *o, long *on, const char *s) {
    long n = tx_len(s, 4096);
    if (*on + n < OUTCAP) { mm_copy(o + *on, OUTCAP - *on, s, n); *on += n; }
}
static int refuse(long line, const char *why) {
    sy_printf("REFUSE\texec/facts/st-gap.tsv\tline=%ld\t%s\n", line, why);
    return 2;
}
static int parse(long n) {
    long i = 0, line = 0;
    while (i < n) {
        long e = i, c, k;
        int r = nrow;
        line++;
        while (e < n && tab[e] != '\n') e++;
        if (e == i || tab[i] == '#') { i = e + 1; continue; }
        if (nrow >= MAXROW) return refuse(line, "too-many-rows");
        if (tx_fields(tab + i, e - i, '\t') != 3) return refuse(line, "field-count");
        for (c = 0; c < 3; c++) {
            long o, l;
            if (tx_field(tab + i, e - i, '\t', c, &o, &l) || l == 0) return refuse(line, "empty-field");
            fo[r][c] = i + o; fl[r][c] = l;
        }
        if (nrow > 0 && feq(r - 1, 0, "*")) return refuse(line, "row-after-fallback");
        if (!(fl[r][0] == 1 && ((tab[fo[r][0]] >= '0' && tab[fo[r][0]] <= '9') || tab[fo[r][0]] == '*'))) return refuse(line, "bad-mode");
        if (!feq(r, 1, "any") && !feq(r, 1, "le0")) return refuse(line, "bad-level");
        for (k = 0; k < fl[r][2]; k++) {
            char ch = tab[fo[r][2] + k];
            if (!((ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9'))) return refuse(line, "bad-name");
        }
        nrow++;
        i = e + 1;
    }
    return 0;
}
static void putf(char *o, long *on, int r, int c) {
    if (*on + fl[r][c] < OUTCAP) { mm_copy(o + *on, OUTCAP - *on, tab + fo[r][c], fl[r][c]); *on += fl[r][c]; }
}
static int hit(int r, int mode, int level) {
    if (!feq(r, 0, "*") && tab[fo[r][0]] - '0' != mode) return 0;
    if (feq(r, 1, "le0") && level > 0) return 0;
    return 1;
}
static void gen(void) {
    int r, m, l;
    char b[64];
    put(out, &outn, "# Generated by tools/st-gap-gen.cx --write from exec/facts/st-gap.tsv; do not edit by hand.\n# mode\tlevel\tname\n");
    for (m = 0; m <= 5; m++)
        for (l = 0; l <= 2; l++) {
            for (r = 0; r < nrow; r++) if (hit(r, m, l)) break;
            cx_fmt(b, sizeof b, "%d\t%d\t", m, l);
            put(out, &outn, b);
            if (r < nrow) putf(out, &outn, r, 2); else put(out, &outn, "?");
            put(out, &outn, "\n");
        }
    for (r = 0; r < nrow; r++) {
        put(out2, &out2n, r == 0 ? "    if (" : feq(r, 0, "*") ? "    else name = \"" : "    else if (");
        if (!feq(r, 0, "*")) {
            put(out2, &out2n, "mode == "); putf(out2, &out2n, r, 0);
            if (feq(r, 1, "le0")) put(out2, &out2n, " && level <= 0");
            put(out2, &out2n, ") name = \"");
        }
        putf(out2, &out2n, r, 2);
        put(out2, &out2n, feq(r, 0, "*") ? "\";\n" : "\";\n");
    }
}
static int cmp(const char *path, const char *want, long wn) {
    size_t om = 0;
    char *old = cx_read(path, &om);
    if (!old || (long)om != wn || !mm_same(old, want, wn)) { sy_printf("DIFF\t%s\n", path); return 1; }
    return 0;
}
int main(int argc, char **argv) {
    int a, mode = 0, rc;
    char path[900], p1[900], p2[900];
    size_t m = 0;
    for (a = 1; a < argc; a++) {
        if (streq(argv[a], "--write")) mode = 1;
        else if (streq(argv[a], "--check")) mode = 2;
        else if (streq(argv[a], "--root") && a + 1 < argc) root = argv[++a];
        else mode = -1;
    }
    if (mode <= 0) { sy_printf("usage: st-gap-gen.cx -- --write|--check [--root DIR]\n"); return 2; }
    if (cx_fmt(path, sizeof path, "%s/exec/facts/st-gap.tsv", root) || cx_fmt(p1, sizeof p1, "%s/build/st-gap.tsv", root) || cx_fmt(p2, sizeof p2, "%s/build/st-gap-chain.txt", root)) return 2;
    tab = cx_read(path, &m);
    if (!tab) { sy_printf("REFUSE\texec/facts/st-gap.tsv\tunreadable\n"); return 2; }
    rc = parse((long)m);
    if (rc) return rc;
    if (nrow == 0 || !feq(nrow - 1, 0, "*")) { sy_printf("REFUSE\texec/facts/st-gap.tsv\tno-fallback\n"); return 2; }
    out = mm_alloc(OUTCAP); out2 = mm_alloc(OUTCAP);
    gen();
    if (mode == 1) {
        if (cx_write(p1, out, outn) || cx_write(p2, out2, out2n)) { sy_printf("REFUSE\tbuild/st-gap.tsv\tunwritable\n"); return 2; }
        sy_printf("ST_GAP_GEN\tWROTE\trows=%d\n", nrow);
        return 0;
    }
    if (cmp(p1, out, outn) | cmp(p2, out2, out2n)) { sy_printf("ST_GAP_GEN\tFAIL\trows=%d\n", nrow); return 1; }
    sy_printf("ST_GAP_GEN\tok\trows=%d\n", nrow);
    return 0;
}
