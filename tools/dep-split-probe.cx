/* A narrow, explicit mutation of an isolated snapshot, never a dependency-edge edit.
 * --autoscan ROOT FACT_SHA MANIFEST_SHA requires an isolation marker and exact inputs.
 * --facts GRAPH reuses the canonical net-deps graph; family counts are static only. */
#pragma unisa use sys.fs
#pragma unisa use sys.sha
#pragma unisa use mem.bytes
static void die(const char*s){fprintf(stderr,"DEP_SPLIT_PROBE REFUSE %s errno=%d\n",s,errno);exit(2);}
static char*readfile(const char*p,size_t*n){struct stat st;if(lstat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>33554432)die("bounded regular input");char*s=cx_read(p,n);if(!s||memchr(s,0,*n)||memchr(s,'\r',*n)||!*n||s[*n-1]!='\n')die("text framing");return s;}
static void digest(const char*s,size_t n,char h[65]){if(sy_sha256_hex(s,n,h))cx_sha256_hex(s,n,h);}
static void path(char*p,size_t cap,const char*a,const char*b){if(cx_fmt(p,cap,"%s/%s",a,b))die("path bound");}
static void shaarg(const char*s){if(strlen(s)!=64)die("SHA argument");for(int i=0;i<64;i++)if(!((s[i]>='0'&&s[i]<='9')||(s[i]>='a'&&s[i]<='f')))die("SHA argument");}
static char*replace(const char*s,const char*a,const char*b,int expected){size_t n=strlen(s),na=strlen(a),nb=strlen(b);int hits=0;for(const char*p=s;(p=strstr(p,a));p+=na)hits++;if(hits!=expected)die("consumer occurrence mismatch");size_t cap=n+(nb>na?(nb-na)*hits:0)+1;char*out=malloc(cap);if(!out)die("allocation");size_t at=0;const char*p=s,*q;while((q=strstr(p,a))){size_t k=q-p;if(mm_copy(out+at,cap-at,p,k))die("copy bound");at+=k;if(mm_copy(out+at,cap-at,b,nb))die("copy bound");at+=nb;p=q+na;}size_t tail=strlen(p);if(mm_copy(out+at,cap-at,p,tail+1))die("copy bound");return out;}
static void autoscan(const char*arg,const char*fh,const char*mh){shaarg(fh);shaarg(mh);char root[4096],cwd[4096],p[4400],m[4400],v[4400],marker[4400];if(!realpath(arg,root)||!realpath(".",cwd)||!strcmp(root,cwd)||strlen(root)<2)die("isolated root required");path(marker,sizeof marker,root,".dep-split-isolated");size_t n;char*s=readfile(marker,&n);if(strcmp(s,"DEP_SPLIT_ISOLATED_V1\n"))die("isolation marker");free(s);path(p,sizeof p,root,"exec/facts/parse-constants.tsv");path(m,sizeof m,root,"exec/parse/autoscan-manifest.tsv");path(v,sizeof v,root,"exec/facts/parse-autoscan-private.tsv");struct stat st;errno=0;if(!lstat(v,&st)||errno!=ENOENT)die("new view must be absent");char*f=readfile(p,&n),h[65];digest(f,n,h);if(strcmp(h,fh))die("facts identity mismatch");size_t mn;char*manifest=readfile(m,&mn);digest(manifest,mn,h);if(strcmp(h,mh))die("consumer identity mismatch");char view[512]="# name\tvalue\n";size_t at=strlen(view);const char*keys[]={"AUT","AUD"};for(int i=0;i<2;i++){int count=0;for(char*q=f;*q;){char*e=strchr(q,'\n');if(!e)die("fact row framing");size_t k=strlen(keys[i]);if((size_t)(e-q)>k&&q[k]=='\t'&&!memcmp(q,keys[i],k)){if(memchr(q+k+1,'\t',e-q-k-1))die("fact columns");size_t len=e-q+1;if(mm_copy(view+at,sizeof view-at,q,len))die("view bound");at+=len;count++;}q=e+1;}if(count!=1)die("unique required fact key");}view[at]=0;
char*next=replace(manifest,"parse-constants","parse-autoscan-private",3);if(cx_write(v,view,at))die("view publication");if(cx_write(m,next,strlen(next)))die("consumer publication; partial view is not a receipt");digest(view,at,h);printf("DEP_SPLIT_TRIAL\tview=exec/facts/parse-autoscan-private.tsv\tsha256=%s\tkeys=AUT,AUD\tclaim=ACTUAL_CONSUMER_CHANGED_NOT_EQUIVALENCE\n",h);free(f);free(manifest);free(next);}
static void facts(const char*file){size_t n;char*s=readfile(file,&n);if(strncmp(s,"net\tstage\tmanifest\tinput_file\tkind\n",35))die("graph header");const char*targets[]={"exec/facts/parse-constants.tsv","exec/facts/numeric-names.tsv","seed/gen.c"};int counts[3][4]={0};char seen[3][64][128]={0};int used[3]={0};char*p=strchr(s,'\n')+1;while(*p){char*e=strchr(p,'\n');if(!e)die("graph LF");*e=0;if(*p!='#'){char*f[5];f[0]=p;int nf=1;for(char*q=p;*q;q++)if(*q=='\t'){*q=0;if(nf==5)die("graph columns");f[nf++]=q+1;}if(nf!=5)die("graph columns");for(int t=0;t<3;t++)if(!strcmp(f[3],targets[t])){if(strcmp(f[4],t==2?"shared-generator":"facts"))die("graph kind");if(!*f[0]||strlen(f[0])>=128||used[t]==64)die("net name bound");for(int j=0;j<used[t];j++)if(!strcmp(seen[t][j],f[0]))die("duplicate fact/net edge");if(cx_fmt(seen[t][used[t]++],128,"%s",f[0]))die("net bound");int g=!strcmp(f[1],"lower")?1:!strncmp(f[1],"enc",3)?2:0;counts[t][g]++;}}p=e+1;}for(int t=0;t<3;t++)printf("STATIC_FAMILY\t%s\ttotal=%d\tfront_other=%d\tlower=%d\tencoder=%d\tclaim=STATIC_NOT_RUNTIME\n",targets[t],used[t],counts[t][0],counts[t][1],counts[t][2]);free(s);}
int main(int argc,char**argv){if(argc==3&&!strcmp(argv[1],"--facts")){facts(argv[2]);return 0;}if(argc==5&&!strcmp(argv[1],"--autoscan")){autoscan(argv[2],argv[3],argv[4]);return 0;}die("usage --facts GRAPH | --autoscan ISOLATED_ROOT FACT_SHA MANIFEST_SHA");return 2;}
