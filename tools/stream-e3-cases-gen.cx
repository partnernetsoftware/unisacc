/* tools/stream-e3-cases-gen.cx -- stream-e3 positive cells from tools/stream-e3-pos.tsv.
 * One -O0 lnx/x86_64 image. Each row is one argv and must exit 0.
 *   sh ./unisacc.com tools/stream-e3-cases-gen.cx -- --check
 *   sh ./unisacc.com tools/stream-e3-cases-gen.cx -- ROOT TABLE ABS_OUT
 *   sh ./unisacc.com tools/stream-e3-cases-gen.cx --
 * The no-argument form (batch runner) uses the repo as ROOT, tools/stream-e3-pos.tsv,
 * and a fresh out/e3pos-<pid> directory. --check reads the table and does not compile.
 * A failing row stays FAIL. This tool does not edit the product.
 */
#pragma unisa use cxlib.netpack
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.proc
#pragma unisa use sys.sig
#pragma unisa use text.text
#pragma unisa use text.fmt

static char root[4096], table[4200], outdir[4200], bound[4400], product[4400];
static int npass, nfail;
static void die(const char *s) { sy_eprintf("stream-e3-cases: REFUSE %s\n", s); sy_exit(2); }
static void path(char *p, long cap, const char *a, const char *b) {
    int n = tx_snprintf(p, (size_t)cap, "%s/%s", a, b);
    if (n < 0 || (long)n >= cap) die("path");
}
static void saved(const char *p, const char *s, long n) {
    int f = sy_open(p, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
    if (f < 0) die("exclusive create");
    if (sy_write_all(f, s, n)) die("write");
    if (sy_close(f)) die("close");
}

#define MAXR 32
static char cells[MAXR][64];
static char bodies[MAXR][1200];
static int nrows;

static void fn_name(char *dst, long cap, const char *cell) {
    long i = 0, n = tx_len(cell, 80);
    if (n < 0 || cap < n + 4) die("name");
    dst[0] = 'f'; dst[1] = 'n'; dst[2] = '_';
    while (i < n) {
        char c = cell[i];
        dst[i + 3] = (c == '.' || c == '-') ? '_' : c;
        i++;
    }
    dst[n + 3] = 0;
}

static int load_table(const char *p) {
    size_t n; char *s = cx_read(p, &n); long at = 0;
    if (!s) die("table");
    nrows = 0;
    while (at < (long)n) {
        long e = tx_chr(s + at, (long)n - at, '\n');
        long ln = e < 0 ? (long)n - at : e;
        if (ln > 0 && s[at] != '#') {
            long tab = tx_chr(s + at, ln, '\t');
            long bl = ln - tab - 1;
            if (tab <= 0 || bl <= 0) die("row shape");
            if (nrows >= MAXR) die("row count");
            if (tab >= (long)sizeof cells[0] || bl >= (long)sizeof bodies[0]) die("row bound");
            if (tx_copy(cells[nrows], (long)sizeof cells[0], s + at, tab)) die("row bound");
            if (tx_copy(bodies[nrows], (long)sizeof bodies[0], s + at + tab + 1, bl)) die("row bound");
            if (!tx_prefixz(cells[nrows], "e3.pos.", 7)) die("cell prefix");
            for (int i = 0; i < nrows; i++) if (tx_eqz(cells[i], cells[nrows])) die("duplicate cell");
            if (tx_find(bodies[nrows], tx_len(bodies[nrows], 1200), "return", 6) < 0) die("body has no return");
            nrows++;
        }
        at += ln + (e < 0 ? 0 : 1);
        if (e < 0) break;
    }
    if (!nrows) die("empty table");
    return nrows;
}

static void emit(const char *p) {
    static char buf[65536];
    long n = 0;
    int z = tx_snprintf(buf, sizeof buf,
        "/* generated by tools/stream-e3-cases-gen.cx from tools/stream-e3-pos.tsv */\n"
        "#include <stdio.h>\n#include <string.h>\n#include <stdarg.h>\n"
        "static int add2(int x,int y){return x+y;}\n"
        "static int sum3(int k,...){va_list ap;int i,s=0;va_start(ap,k);for(i=0;i<k;i++)s+=va_arg(ap,int);va_end(ap);return s;}\n");
    if (z < 0 || (size_t)z >= sizeof buf) die("emit");
    n = z;
    for (int i = 0; i < nrows; i++) {
        char name[80]; fn_name(name, (long)sizeof name, cells[i]);
        z = tx_snprintf(buf + n, sizeof buf - (size_t)n, "static int %s(void){%s}\n", name, bodies[i]);
        if (z < 0 || (size_t)z >= sizeof buf - (size_t)n) die("emit");
        n += z;
    }
    z = tx_snprintf(buf + n, sizeof buf - (size_t)n, "int main(int argc,char **argv){if(argc!=2)return 2;\n");
    if (z < 0 || (size_t)z >= sizeof buf - (size_t)n) die("emit");
    n += z;
    for (int i = 0; i < nrows; i++) {
        char name[80]; fn_name(name, (long)sizeof name, cells[i]);
        z = tx_snprintf(buf + n, sizeof buf - (size_t)n, "if(!strcmp(argv[1],\"%s\"))return %s();\n", cells[i], name);
        if (z < 0 || (size_t)z >= sizeof buf - (size_t)n) die("emit");
        n += z;
    }
    z = tx_snprintf(buf + n, sizeof buf - (size_t)n, "return 3;}\n");
    if (z < 0 || (size_t)z >= sizeof buf - (size_t)n) die("emit");
    n += z;
    saved(p, buf, n);
}

static int runv(char *const argv[], int secs, np_result *r) {
    char why[1024], sec[16], *v[24]; int n = 0;
    tx_snprintf(sec, sizeof sec, "%d", secs);
    v[n++] = bound; v[n++] = sec;
    for (int i = 0; argv[i]; i++) { if (n >= 22) die("argv"); v[n++] = argv[i]; }
    v[n] = 0;
    return np_run(v, root, 0, secs + 2, r, why, sizeof why);
}

int main(int argc, char **argv) {
    int check = argc >= 2 && tx_eqz(argv[1], "--check");
    if (!check && argc != 1 && argc != 4) {
        sy_eprintf("usage: [--check] | ROOT TABLE ABS_OUT\n");
        return 2;
    }
    if (check || argc == 1) {
        if (sy_realpath(".", root, (int)sizeof root) < 0) die("root");
        path(table, (long)sizeof table, root, "tools/stream-e3-pos.tsv");
    } else {
        if (sy_realpath(argv[1], root, (int)sizeof root) < 0) die("root");
        if (sy_realpath(argv[2], table, (int)sizeof table) < 0) die("table");
    }
    load_table(table);
    if (check) { sy_printf("CHECK\tstream-e3-pos\tok=%d\n", nrows); return 0; }
    if (argc == 1) {
        int z = tx_snprintf(outdir, sizeof outdir, "%s/out/e3pos-%d", root, (int)sy_pid());
        if (z < 0 || (size_t)z >= sizeof outdir) die("out");
    } else {
        long n = tx_len(argv[3], (long)sizeof outdir);
        if (argv[3][0] != '/' || n < 0) die("absolute out");
        if (tx_copy(outdir, (long)sizeof outdir, argv[3], n)) die("absolute out");
    }
    if (sy_mkdir(outdir, 0700)) die("out exists or unusable");
    path(bound, (long)sizeof bound, root, "tools/bound");
    path(product, (long)sizeof product, root, "unisacc.com");
    char src[4400], elf[4400], res[4400];
    path(src, (long)sizeof src, outdir, "prog.c");
    path(elf, (long)sizeof elf, outdir, "prog.elf");
    path(res, (long)sizeof res, outdir, "results.tsv");
    emit(src);
    np_result cr; char *cv[] = {"sh", product, src, "-O0", "-b", "lnx/x86_64", "-o", elf, 0};
    if (runv(cv, 40, &cr) || cr.rc) {
        sy_eprintf("stream-e3-cases: compile rc=%d\n", cr.rc);
        if (cr.errn) {
            long m = cr.errn > 800 ? 800 : cr.errn;
            sy_write_all(2, cr.err, m);
            sy_write_all(2, "\n", 1);
        }
        return 1;
    }
    np_free(&cr);
    int rf = sy_open(res, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
    if (rf < 0) die("results");
    for (int i = 0; i < nrows; i++) {
        np_result r; char *av[] = {elf, cells[i], 0};
        int bad = runv(av, 3, &r);
        int ok = !bad && r.rc == 0;
        char line[256];
        int rc = bad ? -1 : r.rc;
        int z = tx_snprintf(line, sizeof line, "%s\t%s\trc=%d\n", ok ? "PASS" : "FAIL", cells[i], rc);
        if (z < 0 || (size_t)z >= sizeof line) die("result line");
        if (sy_write_all(rf, line, z)) die("results");
        sy_printf("%s\t%s\trc=%d\n", ok ? "PASS" : "FAIL", cells[i], rc);
        if (ok) npass++; else nfail++;
        np_free(&r);
    }
    {
        char line[128];
        int z = tx_snprintf(line, sizeof line, "SUMMARY\tpass=%d\tfail=%d\n", npass, nfail);
        if (z < 0 || (size_t)z >= sizeof line || sy_write_all(rf, line, z)) die("results");
    }
    if (sy_close(rf)) die("results");
    sy_printf("STREAM_E3_POS\tassertions=%d\tfailed=%d\n", npass + nfail, nfail);
    return nfail ? 1 : 0;
}
