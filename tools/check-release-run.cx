        for (i = 0; i < 9; i++) if (fixture_put(src, inputs[i], "private pack input\n")) return 2;
        { char *pv[] = {"env", envp, "sh", "unisacc.com", "tools/release-run.cx", "--", "--pack", fake, tsv, src, goodod, "--chain-out", chain, "--snap", snap, 0};
          rc = run(pv, root, out, sizeof out); }
        ck(rc == 2 && sy_exists(marker) == 1 && has(out, "release-ape pack"), "gate positive reaches actual pack child");
        { char *rm[] = {"rm", "-f", marker, 0}; if (run(rm, root, 0, 0)) return 2; }
        if(memo_fixture(chain,-1)||cx_fmt(od,sizeof od,"%s/gate-positive-shutdown",work))return 2;
        {char *pv[]={"env",envp,"sh","unisacc.com","tools/release-run.cx","--","--pack",fake,tsv,src,od,"--chain-out",chain,"--snap",snap,0};
         rc=run(pv,root,out,sizeof out);}
        ck(rc==2&&sy_exists(marker)==1&&has(out,"release-ape pack"),"gate full recheck and effective memo shutdown reaches pack child");
        {char *rm[]={"rm","-f",marker,0};if(run(rm,root,0,0))return 2;}
        /* Missing/UNKNOWN proofs, latest failure/residue, changed or missing slices,
         * a completed resume, memo use and chain-directory rebinding must refuse. */
        static char otherchain[4400];
        for (int test = 0; test < 42; test++) {
            char leaf[400], path[4800], label[200]; np_buf log = {0};
            if (chain_fixture(chain) || cx_fmt(od, sizeof od, "%s/gate-negative-%d", work, test)) return 2;
            if(test>=30&&memo_fixture(chain,test))return 2;
            if (test == 1 && fixture_put(chain, "checkpoint.tsv", "UNKNOWN\tcompare\twall_ms=0\tsha=-\n")) return 2;
            if(test==29&&(cx_fmt(otherchain,sizeof otherchain,"%s/other-chain",work)||chain_fixture(otherchain)))return 2;
            if (test >= 2 && test <= 9) {
                int category = (test - 2) % 4;
                for (int j = 0; j < 4; j++) {
                    if (j != category) np_puts(&log, fp_rows[j]);
                    else if (test >= 6) {
                        const char *unknown[4] = {"CHAIN\tfixedpoint\tobjects=UNKNOWN\tcount=44\n", "CHAIN\tfixedpoint\tkernels=UNKNOWN\tcount=2\n", "CHAIN\tfixedpoint\tslices=UNKNOWN\tcount=6\n", "CHAIN\tfixedpoint\tproduct=UNKNOWN\n"};
                        np_puts(&log, unknown[j]);
                    }
                }
                if (fixture_put(chain, "chain-run-1.stdout", log.p)) return 2;
                free(log.p);
            }
            if (test == 10 || test == 11) {
                const char *attempt = test == 10 ?
                    "ATTEMPT\t1\tphase=compare\trc=0\tresidue=0\tbound=60\tmemo=off\nATTEMPT\t2\tphase=compare\trc=1\tresidue=0\tbound=60\tmemo=off\n" :
                    "ATTEMPT\t1\tphase=compare\trc=0\tresidue=0\tbound=60\tmemo=off\nATTEMPT\t2\tphase=compare\trc=0\tresidue=1\tbound=60\tmemo=off\n";
                if (fixture_put(chain, "chain-run.tsv", attempt)) return 2;
                for (int j = 0; j < 4; j++) np_puts(&log, fp_rows[j]);
                if (fixture_put(chain, "chain-run-2.stdout", log.p)) return 2;
                free(log.p);
            }
            if (test == 26) {
                for (int j = 0; j < 4; j++) np_puts(&log, fp_rows[j]);
                np_puts(&log, "CHAIN\tfixedpoint\tobjects=UNKNOWN\tcount=44\n");
                if (fixture_put(chain, "chain-run-1.stdout", log.p)) return 2;
                free(log.p);
            }
            if (test == 27 && fixture_put(chain, "fixedpoint/g3/lnx-x86_64/entry.elf", "")) return 2;
            if (test == 28 && fixture_put(chain, "chain-run.tsv", "ATTEMPT\t1\tphase=compare\trc=0\tresidue=0\tbound=60\tmemo=on\n")) return 2;
            if ((test == 12 || test == 25) && fixture_put(chain, "fixedpoint/g3/lnx-x86_64/entry.elf", "changed real bytes\n")) return 2;
            if (test >= 13 && test <= 24) {
                if (cx_fmt(leaf, sizeof leaf, "fixedpoint/g%d/%s", 2 + (test - 13) / 6, chain_roles[(test - 13) % 6]) ||
                    cx_fmt(path, sizeof path, "%s/%s", chain, leaf)) return 2;
                { char *rm[] = {"rm", path, 0}; if (run(rm, root, 0, 0)) return 2; }
            }
            if (test == 25) {
                /* Binding was produced by the positive run, not hand-forged. */
                if (fixture_put(goodod, "state.tsv", "STEP\t4\tape-pack\tDONE\n")) return 2;
                char *rv[] = {"env", envp, "sh", "unisacc.com", "tools/release-run.cx", "--", "--resume", goodod, 0};
                rc = run(rv, root, out, sizeof out);
            } else {
                char *pv[18]; int count = 0;
                pv[count++] = "env"; pv[count++] = envp; pv[count++] = "sh"; pv[count++] = "unisacc.com";
                pv[count++] = "tools/release-run.cx"; pv[count++] = "--"; pv[count++] = "--pack";
                pv[count++] = fake; pv[count++] = tsv; pv[count++] = src; pv[count++] = test==29?goodod:od;
                if (test != 0) { pv[count++] = "--chain-out"; pv[count++] = test==29?otherchain:chain; }
                pv[count++] = "--snap"; pv[count++] = snap; pv[count] = 0;
                rc = run(pv, root, out, sizeof out);
            }
            if (cx_fmt(label, sizeof label, "gate negative %d rc2 before any packing child", test)) return 2;
            ck(rc == 2 && sy_exists(marker) != 1 && has(out, "REFUSE") &&
                !has(out,"sources-sid-mismatch")&&(test==29?has(out,"pack input changed"):!has(out,"pack input changed"))&&
                !has(out, "sha256sum --check"), label);
        }
        if (chain_fixture(chain)) return 2;
        nc_suite(chain, snap, hp);
      }
    }
    sy_printf("%s\tfailed=%d\n",gate_only?"CHECK_RELEASE_PACK_GATE":"CHECK_RELEASE_RUN",failed);
    return failed ? 1 : 0;
}
