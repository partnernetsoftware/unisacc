/* tools/check-release-run.cx -- release-run --dry-run 合同检查(0.0.50 R)。
 *
 * 用真实 0.0.49 材料(release-layout + candidate.tsv)驱动 release-run --dry-run:
 *   R1 四步全 DONE,状态文件按序记录;
 *   R2 输出含 layout PASS、7 条资产 OK、dispatch 重放(PLAN_UPLOAD 7 条、tag 一致);
 *   R3 决议步在无证据时保持 UNKNOWN(不猜);
 *   R4 dry-run 不产生 git 变更:跑前后 rev-parse HEAD 相同;gh 从未被调用
 *      (环境里注入 GH=never,任何 gh 调用都会失败使测试红)。
 * 负控:布局被改动一字节 -> layout-check 步 REFUSE 非零退出。 */
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use sys.sig
#pragma unisa use cxlib.netpack

static int failed;
static char root[4096], td[4400], work[4400];

static void ck(int ok, const char *n) {
    sy_printf("%s\tcheck-release-run.%s\n", ok ? "PASS" : "FAIL", n);
    if (!ok) failed++;
}
static long tlen(const char *s) { return tx_len(s, 1 << 100); }
static int run(char **v, const char *cwd, char *out, int cap) {
    np_result r = {0}; char why[512] = {0}; int rc;
    if (np_run(v, cwd, 0, 50, &r, why, sizeof why)) { np_free(&r); return 125; }
    rc = r.rc;
    if (out && r.outn < (size_t)cap) { long i; for (i = 0; i < (long)r.outn; i++) out[i] = r.out[i]; out[r.outn] = 0; }
    if (r.outn) sy_write_all(1, r.out ? r.out : "", r.outn);
    if (r.errn) sy_write_all(2, r.err, r.errn);
    np_free(&r);
    return rc;
}
static int has(const char *b, const char *s) { return tx_find(b, tlen(b), s, tlen(s)) >= 0; }

int main(void) {
    char out[65536], layout[4400], cand[4400], odir[4400], state[4600], *b; size_t n;
    char *v[8]; int rc, i;
    const char *src = sy_env("RELEASE_RUN_FIXTURE");
    if (!src || !src[0]) { sy_eprintf("check-release-run: set RELEASE_RUN_FIXTURE to the 0.0.49 release-layout directory\n"); return 2; }
    if (sy_cwd(root, sizeof root)) return 2;
    { char t[] = "/tmp/check-release-run-XXXXXX"; if (!mkdtemp(t)) return 2;
      if (cx_fmt(work, sizeof work, "%s", t) || cx_fmt(layout, sizeof layout, "%s/layout", work)) return 2; }
    { char *cv[] = {"cp", "-r", (char *)src, layout, 0}; if (run(cv, root, 0, 0)) return 2; }
    if (cx_fmt(cand, sizeof cand, "%s/candidate.tsv", work)) return 2;
    { const char *ct = sy_env("RELEASE_RUN_CANDIDATE");
      if (!ct || !ct[0]) { sy_eprintf("check-release-run: set RELEASE_RUN_CANDIDATE to the candidate table\n"); return 2; }
      { char *cv[] = {"cp", (char *)ct, cand, 0}; if (run(cv, root, 0, 0)) return 2; } }
    if (cx_fmt(odir, sizeof odir, "%s/out", work)) return 2;
    v[0] = "env"; v[1] = "GH=never"; v[2] = "PATH=/usr/bin:/bin";
    v[3] = "sh"; v[4] = "unisacc.com"; v[5] = "tools/release-run.cx";
    v[6] = "--"; v[7] = 0;
    { char *w[12]; int k = 0;
      for (i = 0; i < 7; i++) w[k++] = v[i];
      w[k++] = (char *)"--dry-run"; w[k++] = root; w[k++] = cand; w[k++] = layout; w[k++] = odir; w[k] = 0;
      rc = run(w, root, out, sizeof out); }
    ck(rc == 0, "dry-run rc0");
    ck(has(out, "STEP\tlayout-check\tDONE"), "R1a layout-check DONE");
    ck(has(out, "STEP\tsums-check\tDONE"), "R1b sums-check DONE");
    ck(has(out, "STEP\tdispatch-replay\tDONE"), "R1c dispatch-replay DONE");
    ck(has(out, "STEP\tdecide\tDONE"), "R1d decide DONE");
    { int oks = 0; const char *p = out; long rest = tlen(out);
      while (rest > 0) { long at = tx_find(p, rest, ": OK", 4); if (at < 0) break; oks++; p += at + 4; rest -= at + 4; }
      ck(oks >= 6, "R2b all layout assets OK (SHA256SUMS has 6 members)");
    }
    ck(has(out, "mode=DRY_RUN\texternal_operations=0"), "R2c dispatch replay marker");
    ck(has(out, "UNKNOWN"), "R3 unknown steps not guessed");
    ck(has(out, "DRY_RUN_OK\tno release created, no CI, no push"), "R4 no external ops");
    if (cx_fmt(state, sizeof state, "%s/state.tsv", odir)) return 2;
    b = (char *)cx_read(state, &n);
    ck(b && tx_find(b, (long)n, "\tDONE", 5) >= 0, "state.tsv recorded");
    if (b) { (void)b; }
    /* 负控:篡改一个资产字节 -> layout-check/sums 必须非零 */
    { char bad[4600]; char *w[12]; int k = 0;
      if (cx_fmt(bad, sizeof bad, "%s/unisacc.com", layout)) return 2;
      { int f = sy_open(bad, O_WRONLY | O_APPEND, 0600); const char one = 'X';
        if (f < 0 || sy_write_all(f, &one, 1) || sy_close(f)) return 2; }
      if (cx_fmt(odir, sizeof odir, "%s/out2", work)) return 2;
      for (i = 0; i < 7; i++) w[k++] = v[i];
      w[k++] = (char *)"--dry-run"; w[k++] = root; w[k++] = cand; w[k++] = layout; w[k++] = odir; w[k] = 0;
      rc = run(w, root, out, sizeof out);
      ck(rc != 0, "negative: tampered asset refuses"); }
    sy_printf("CHECK_RELEASE_RUN\tfailed=%d\n", failed);
    if (b) { (void)b; }
}
