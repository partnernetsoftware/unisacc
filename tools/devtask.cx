/* devtask: work orders and dispatch (实施单与派工), replaces envelope dispatch and manual tracking.
 * Usage (prefix: sh ./unisacc.com tools/devtask.cx --):
 *   add TITLE --domain P... [--deadline MIN] [--for OWNER]   new open task; prints TASK add ID
 *   claim ID --owner O        open -> claimed; refused (rc 1) naming every claimed task whose write domain intersects
 *   done ID --evidence E      claimed -> done; evidence is a commit id or log path
 *   block ID --why W          open|claimed -> blocked (the owner may claim again to resume)
 *   gap ID --text T           record a reported gap on a live task
 *   drop ID --why W           live -> dropped
 *   list [--state S] [--owner O] | show ID | stale            stale: live tasks past their deadline
 * Job-style work orders with executable acceptance (plans/devsvc.md R5; ids are free names, separate from the T-table above):
 *   task open --id ID --title T --write P... --accept CMD [--accept CMD]... --deadline-min N [--root R]
 *       [--write-ext ABSDIR]... [--cwd DIR]  --write-ext: existing absolute directory outside the repo, snapshotted by file sha like the
 *       repo (refused: /, HOME and its two parents, relative, missing); --write may then be omitted. --cwd: acceptance commands run
 *       there, must be under .claude/worktrees/ of the root or under a --write-ext directory. A --write prefix .claude/worktrees/NAME
 *       also snapshots that work tree's dirty files (git -C), reported as .claude/worktrees/NAME/PATH.
 *       records the write domain, the acceptance commands and a snapshot of the dirty paths (with content hashes)
 *   task status ID   used and remaining seconds, paths changed since open inside the write domain (CHANGED) and
 *       outside it (OUTSIDE_WARN)
 *   task done ID     runs every acceptance command (through devsvc x in the root, 55 s each) and requires no change
 *       outside the write domain; all pass -> devsvc event task.done, task-events.tsv row, DONE line, rc 0; otherwise
 *       TASK_NOT_DONE with the failing output tails, rc 1, and the order stays open (done may be retried any time)
 *   task list        every work order with state open|overdue|done
 *   $DEVTASK_ACCEPT_DIRECT=1 runs acceptance by sh -c under the root and skips the devsvc event (checks only).
 * Common: --dir D picks the store directory; otherwise $DEVTASK_DIR; otherwise the devsvc instance directory
 * derived from the repo table ($DEVSVC_REPO_TABLE or tools/devsvc-repo.tsv under the git top level).
 * $DEVTASK_NOW (epoch seconds) replaces the clock, for checks and demonstrations only.
 * Exit: 0 ok, 1 refused by state or conflict (DEVTASK_REFUSE on stderr), 2 bad input or I/O. Store format in cxlib/devtask.cx. */
#pragma unisa use cxlib.devtask
#pragma unisa use cxlib.netpack
#pragma unisa use text.build
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.time
#pragma unisa use sys.env
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

static const char *val[8]; static char dom[1024];
static const char *names[] = {"--dir", "--domain", "--deadline", "--for", "--owner", "--evidence", "--why", "--text", "--state"};
enum { O_DIR, O_DOMAIN, O_DEADLINE, O_FOR, O_OWNER, O_EVIDENCE, O_WHY, O_TEXT, O_STATE, O_N };
static const char *ov[O_N];
static int bad(const char *m, const char *a) { fprintf(stderr, "devtask: %s%s%s\n", m, a ? " " : "", a ? a : ""); return 2; }
/* allowed: bit per option; every option takes one value, --domain takes one or more */
static int parse(int argc, char **argv, int from, unsigned allowed) {
    for (int i = from; i < argc; i++) {
        int k = -1;
        for (int j = 0; j < O_N; j++) if (!strcmp(argv[i], names[j])) k = j;
        if (k < 0 || !((allowed | 1u << O_DIR) >> k & 1)) return bad("unexpected argument", argv[i]);
        if (ov[k]) return bad("repeated option", argv[i]);
        if (i + 1 >= argc || !strncmp(argv[i + 1], "--", 2)) return bad("missing value for", argv[i]);
        if (k != O_DOMAIN) { ov[k] = argv[++i]; continue; }
        for (long used = 0; i + 1 < argc && strncmp(argv[i + 1], "--", 2);) {
            int w = snprintf(dom + used, sizeof dom - used, "%s%s", used ? "," : "", argv[++i]);
            if (strchr(argv[i], ',') || w >= (int)(sizeof dom - used)) return bad("bad or oversized --domain entry", argv[i]);
            used += w;
        }
        ov[k] = dom;
    }
    return 0;
}
static int resolve(char *dir, int cap) {
    const char *e = ov[O_DIR] ? ov[O_DIR] : getenv("DEVTASK_DIR"), *tb = getenv("DEVSVC_REPO_TABLE"); char why[512], root[1024];
    char *v[] = {"git", "rev-parse", "--show-toplevel", 0}; np_result r = {0}; long n;
    if (e && *e) return snprintf(dir, cap, "%s", e) >= cap ? bad("--dir too long", 0) : 0;
    if (np_run(v, 0, 0, 15, &r, why, sizeof why) || r.rc || !r.out || r.outn < 2 || r.outn >= sizeof root) { np_free(&r); return bad("not inside a git work tree; give --dir", 0); }
    n = (long)r.outn; while (n > 0 && r.out[n - 1] == '\n') n--;
    if (n >= (long)sizeof root || mm_copy(root, sizeof root, r.out, n)) { np_free(&r); return bad("git toplevel too long", 0); } root[n] = 0; np_free(&r);
    if (dt_instdir(root, tb && *tb ? tb : "tools/devsvc-repo.tsv", dir, cap, why, sizeof why)) return bad(why, 0);
    return 0;
}
/* ---- task: job-style work orders (plans/devsvc.md R5); the store and diff live in cxlib/devtask.cx ---- */
static int toplevel(char *root, int cap) {
    char *v[] = {"git", "rev-parse", "--show-toplevel", 0}; np_result r = {0}; char why[256]; long n;
    if (np_run(v, 0, 0, 15, &r, why, sizeof why) || r.rc || !r.out || r.outn < 2) { np_free(&r); return bad("not inside a git work tree; give --root", 0); }
    n = (long)r.outn; while (n > 0 && r.out[n - 1] == '\n') n--;
    if (n >= cap || mm_copy(root, cap, r.out, n)) { np_free(&r); return bad("git toplevel too long", 0); }
    root[n] = 0; np_free(&r); return 0;
}
static void tail(const char *tag, const char *s, long n) {
    long i = n, lines = 0;
    if (!s || n <= 0) return;
    while (i > 0 && n - i < 3000 && lines < 25) { i--; if (s[i] == '\n' && i != n - 1) lines++; }
    if (i > 0 && s[i] == '\n') i++;
    printf("--- %s tail ---\n%.*s%s", tag, (int)(n - i), s + i, s[n - 1] == '\n' ? "" : "\n");
}
/* one acceptance command, 55 s bound: through devsvc x, or sh -c directly when $DEVTASK_ACCEPT_DIRECT is set (checks only) */
static int accept_run(const DwTask *t, int k, int direct) {
    const char *wd = t->cwd[0] ? t->cwd : t->root;
    char *vx[] = {"sh", "./unisacc.com", "tools/devsvc.cx", "--", "x", "--par", "1", "--timeout-ms", "55000", "--cwd", (char *)wd, "--", "sh", "-c", (char *)t->acc[k], 0};
    char *vd[] = {"sh", "-c", (char *)t->acc[k], 0}; np_result r = {0}; char why[512] = ""; long t0 = sy_now_ms();
    int rc = np_run(direct ? vd : vx, direct ? wd : 0, 0, direct ? 55 : 58, &r, why, sizeof why), ok = !rc && !r.rc;
    printf("ACCEPT\t%d\t%s\trc=%d\tms=%ld\t%s\n", k + 1, ok ? "PASS" : r.timed_out ? "TIMEOUT" : "FAIL", rc ? rc : r.rc, sy_now_ms() - t0, t->acc[k]);
    if (!ok) { if (rc) printf("--- runner ---\n%s\n", why); tail("stdout", r.out, (long)r.outn); tail("stderr", r.err, (long)r.errn); }
    np_free(&r); return ok;
}
/* escape for a flow node value: everything but [A-Za-z0-9_./-] as %XX */
static void esc(sb *o, const char *s) { for (; *s; s++) { unsigned char c = (unsigned char)*s; char h[8]; if ((c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c == '.' || c == '/' || c == '-') { h[0] = (char)c; h[1] = 0; } else (void)cx_fmt(h, sizeof h, "%%%02X", c); (void)sb_puts(o, h); } }
/* NODE line of flow output for id: state text and ms; returns 1 when found */
static int node_of(const char *out, long n, const char *id, char *st, int sc, long *rc, long *ms) {
    char key[40]; (void)cx_fmt(key, sizeof key, "NODE\t%s\t", id);
    for (long i = 0; i < n;) {
        long e = i; while (e < n && out[e] != '\n') e++;
        if (e - i > (long)strlen(key) && !strncmp(out + i, key, strlen(key))) {
            const char *p = out + i + strlen(key), *q; long k = 0;
            while (p + k < out + e && p[k] != '\t' && k < sc - 1) { st[k] = p[k]; k++; } st[k] = 0;
            q = strstr(p, "rc="); *rc = q && q < out + e ? atol(q + 3) : -1;
            q = strstr(p, "ms="); *ms = q && q < out + e ? atol(q + 3) : 0;
            return 1;
        }
        i = e + 1;
    }
    return 0;
}
static void runfile_tail(const char *run, const char *id, const char *ext, const char *tag) {
    char p[2048]; unsigned char *b = 0; int64_t n = 0;
    if (snprintf(p, sizeof p, "%s/out/%s.%s", run, id, ext) < (int)sizeof p && !sy_read_file(p, &b, &n, 1L << 24)) tail(tag, (const char *)b, (long)n);
    free(b);
}
/* run the acceptance commands with todo[k] set as ONE devsvc flow (one exec node each, 55 s bound each, all concurrent);
 * pass[k] is set for the ones that passed; returns the number that failed, -1 on a runner fault */
static int accept_flow(const char *dir, const DwTask *t, const int *todo, int *pass, int direct) {
    char fp[2048], why[512] = ""; sb *o = sb_new(); int nrun = 0, failed = 0; np_result r = {0}; char jobs[16]; char run[1024] = "";
    (void)direct;
    if (!o || snprintf(fp, sizeof fp, "%s/work/%s.nodes.tsv", dir, t->id) >= (int)sizeof fp) { sb_free(o); return -1; }
    for (int k = 0; k < t->nacc; k++) {
        char id[16], cmd[1200];
        if (!todo[k]) continue;
        (void)cx_fmt(id, sizeof id, "a%d", k + 1); (void)cx_fmt(cmd, sizeof cmd, "cd '%s' && { %s\n}", t->cwd[0] ? t->cwd : t->root, t->acc[k]);
        (void)sb_puts(o, id); (void)sb_puts(o, "\texec\t-\ta0=sh;a1=-c;a2="); esc(o, cmd); (void)sb_puts(o, ";timeout_ms=55000\n"); nrun++;
    }
    if (!nrun) { sb_free(o); return 0; }
    if (sy_write_atomic(fp, sb_cstr(o), sb_len(o), 0600)) { sb_free(o); return -1; }
    sb_free(o); (void)cx_fmt(jobs, sizeof jobs, "%d", nrun > 32 ? 32 : nrun);
    {   char *v[] = {"sh", "./unisacc.com", "tools/devsvc.cx", "--", "flow", "run", fp, "--par", jobs, 0};
        int rc = np_run(v, 0, 0, 58, &r, why, sizeof why);
        if (rc && !r.out) { printf("--- runner ---\n%s\n", why); np_free(&r); return -1; }
    }
    for (long i = 0; i < (long)r.outn;) {
        long e = i; const char *q; while (e < (long)r.outn && r.out[e] != '\n') e++;
        if (e - i > 12 && !strncmp(r.out + i, "DEVSVC_FLOW\t", 12) && (q = strstr(r.out + i, "run=")) && q < r.out + e) { long m = r.out + e - (q + 4); if (m > 0 && m < (long)sizeof run) { if (!mm_copy(run, sizeof run, q + 4, m)) run[m] = 0; else run[0] = 0; } }
        i = e + 1;
    }
    for (int k = 0; k < t->nacc; k++) {
        char id[16], st[32] = ""; long rc = -1, ms = 0; int found, ok;
        if (!todo[k]) continue;
        (void)cx_fmt(id, sizeof id, "a%d", k + 1);
        found = node_of(r.out, (long)r.outn, id, st, sizeof st, &rc, &ms); ok = found && !strcmp(st, "ok");
        printf("ACCEPT\t%d\t%s\trc=%ld\tms=%ld\t%s\n", k + 1, ok ? "PASS" : !strcmp(st, "timeout") ? "TIMEOUT" : "FAIL", rc, ms, t->acc[k]);
        pass[k] = ok;
        if (!ok) { failed++; if (run[0]) { runfile_tail(run, id, "out", "stdout"); runfile_tail(run, id, "err", "stderr"); } }
    }
    np_free(&r); return failed;
}
static void paths(const char *tag, sb *b) {
    const char *s = sb_cstr(b);
    for (const char *p = s; p && *p;) { const char *e = strchr(p, '\n'); if (!e) break; printf("%s\t%.*s\n", tag, (int)(e - p), p); p = e + 1; }
}
static int task_main(int argc, char **argv, long now) {
    const char *sub = argc > 2 ? argv[2] : "", *id = 0, *title = 0, *dmin = 0, *rootopt = 0, *cwdopt = 0, *acc[DW_ACC + 1]; char extraw[1024] = "", dir[1024], root[1024], why[2048] = ""; int nacc = 0, rc, i = 3;
    int isopen = !strcmp(sub, "open"), islist = !strcmp(sub, "list"), direct = getenv("DEVTASK_ACCEPT_DIRECT") && *getenv("DEVTASK_ACCEPT_DIRECT");
    DwTask t; sb *in, *out, *fo = 0; int nin = 0, nout = 0, nfo = 0;
    if (!isopen && !islist && strcmp(sub, "status") && strcmp(sub, "done")) {
        fprintf(stderr, "usage: devtask task open --id ID --title T --write P... [--write-ext ABSDIR]... --accept CMD [--accept CMD]... --deadline-min N [--root R] [--cwd DIR]\n"
                        "       devtask task status ID | task done ID | task list   (all: [--dir D])\n");
        return 2;
    }
    int bg = 0, wmode = !strcmp(sub, "done") && argc > 4 && !strcmp(argv[3], "--wait");
    if (wmode) { id = argv[4]; i = 5; }
    else if (!isopen && !islist) { if (argc < 4 || !strncmp(argv[3], "--", 2)) return bad("task needs an ID first:", sub); id = argv[i++]; }
    for (; i < argc; i++) {
        const char *a = argv[i], **dst = 0;
        if (!strcmp(a, "--dir")) dst = &ov[O_DIR];
        else if (!strcmp(sub, "done") && !strcmp(a, "--bg")) { bg = 1; continue; }
        else if (isopen && !strcmp(a, "--id")) dst = &id;
        else if (isopen && !strcmp(a, "--title")) dst = &title;
        else if (isopen && !strcmp(a, "--deadline-min")) dst = &dmin;
        else if (isopen && !strcmp(a, "--root")) dst = &rootopt;
        else if (isopen && !strcmp(a, "--cwd")) dst = &cwdopt;
        else if (isopen && !strcmp(a, "--write-ext")) {
            int w;
            if (i + 1 >= argc || !strncmp(argv[i + 1], "--", 2)) return bad("missing value for", a);
            w = snprintf(extraw + strlen(extraw), sizeof extraw - strlen(extraw), "%s%s", extraw[0] ? "," : "", argv[i + 1]);
            if (w >= (int)(sizeof extraw - strlen(extraw))) return bad("oversized --write-ext", 0);
            i++; continue;
        }
        else if (isopen && !strcmp(a, "--accept")) { if (i + 1 >= argc) return bad("missing value for", a); if (nacc >= DW_ACC) return bad("too many --accept", 0); acc[nacc++] = argv[++i]; continue; }
        else if (isopen && !strcmp(a, "--write")) {
            long used = (long)strlen(dom);
            if (i + 1 >= argc || !strncmp(argv[i + 1], "--", 2)) return bad("missing value for", a);
            while (i + 1 < argc && strncmp(argv[i + 1], "--", 2)) {
                int w = snprintf(dom + used, sizeof dom - used, "%s%s", used ? "," : "", argv[++i]);
                if (w >= (int)(sizeof dom - used)) return bad("oversized --write", 0);
                used += w;
            }
            continue;
        } else return bad("unexpected argument", a);
        if (*dst) return bad("repeated option", a);
        if (i + 1 >= argc) return bad("missing value for", a);
        *dst = argv[++i];
    }
    if (resolve(dir, sizeof dir)) return 2;
    if (isopen) {
        long min = 0;
        if (!dom[0] && extraw[0]) (void)cx_fmt(dom, sizeof dom, "-");
        if (!id || !title || !dom[0] || !nacc || !dmin) return bad("task open needs --id --title --write --accept --deadline-min", 0);
        for (const char *q = dmin; *q; q++) if (*q < '0' || *q > '9') return bad("bad --deadline-min", dmin);
        if (strlen(dmin) > 6 || (min = atol(dmin)) < 1) return bad("bad --deadline-min", dmin);
        if (rootopt) { if (snprintf(root, sizeof root, "%s", rootopt) >= (int)sizeof root) return bad("--root too long", 0); } else if (toplevel(root, sizeof root)) return 2;
        {   char wn2[1024]; if (strcmp(dom, "-") && dt_domain_ok(dom) == 0 && !strstr(dom, "..") && dw_write_norm(dom, root, wn2, sizeof wn2, why, sizeof why) == 0) (void)cx_fmt(dom, sizeof dom, "%s", wn2); }
        rc = dw_open(dir, id, title, dom, acc, nacc, min, root, extraw, cwdopt, now, why, sizeof why);
        if (!rc) printf("TASK\topen\t%s\tdeadline_s=%ld\taccept=%d\twrite=%s\n", id, min * 60, nacc, dom);
        goto end;
    }
    if (islist) {
        char p[2048]; unsigned char *b = 0; int64_t n = 0; int count = 0;
        if (snprintf(p, sizeof p, "%s/work/index.tsv", dir) >= (int)sizeof p) return bad("--dir too long", 0);
        rc = sy_read_file(p, &b, &n, 1L << 22);
        if (rc && rc != -ENOENT) { fprintf(stderr, "devtask: read work index rc=%d\n", rc); return 2; }
        printf("id\tstate\tused_s\tleft_s\twrite\ttitle\n");
        for (long s = 0, e; !rc && s < n; s = e + 1) {
            int dup = 0;
            for (e = s; e < n && b[e] != '\n'; e++) {}
            if (e >= n) break;
            b[e] = 0;
            for (long q = e + 1, qe; q < n && !dup; q = qe + 1) { for (qe = q; qe < n && b[qe] != '\n'; qe++) {} dup = qe - q == e - s && !memcmp(b + q, b + s, e - s); }
            if (dup) continue;   /* a reopened id is listed once, at its last row */
            if (dw_load(dir, (char *)b + s, &t, why, sizeof why)) { free(b); fprintf(stderr, "devtask: %s\n", why); return 2; }
            printf("%s\t%s\t%ld\t%ld\t%s\t%s\n", t.id, t.done ? "done" : now > t.deadline ? "overdue" : "open", (t.done ? t.done : now) - t.opened, t.done ? 0 : t.deadline - now, t.write, t.title);
            count++; dw_free(&t);
        }
        free(b); printf("DEVTASK_WORK\tcount=%d\n", count);
        return 0;
    }
    if (wmode || bg) {   /* --wait: devsvc wait on the recorded JOB; --bg: rerun this done under devsvc x --bg and record its JOB */
        char jp[2048], jb[64] = ""; unsigned char *b = 0; int64_t bn = 0; np_result r2 = {0}; char w3[256] = ""; int rc2;
        if (!dw_id_ok(id) || snprintf(jp, sizeof jp, "%s/work/%s.job", dir, id) >= (int)sizeof jp) return bad("bad work order id", id);
        if (wmode) {
            if (sy_read_file(jp, &b, &bn, 1 << 12) || bn < 2 || bn >= (int64_t)sizeof jb) { free(b); return bad("no background done recorded for", id); }
            if (mm_copy(jb, sizeof jb, b, bn)) { free(b); return bad("bad job file for", id); } jb[bn] = 0; free(b); for (char *q = jb; *q; q++) if (*q == 10) *q = 0;
            { char *v[] = {"sh", "./unisacc.com", "tools/devsvc.cx", "--", "wait", jb, "--timeout-ms", "55000", 0};
              rc2 = np_run(v, 0, 0, 58, &r2, w3, sizeof w3); if (r2.out) fwrite(r2.out, 1, r2.outn, stdout); if (r2.err) fwrite(r2.err, 1, r2.errn, stderr); np_free(&r2); return rc2 ? 2 : (r2.rc ? 1 : 0); }
        } else {
            static const char *en[] = {"DEVTASK_NOW", "DEVTASK_EVENTS", "DEVTASK_ACCEPT_DIRECT", "DEVSVC_OWNER", "DEVSVC_REPO_TABLE", 0};
            char ev[5][1200]; char *v[40]; int n = 0; const char *jl;
            v[n++] = "sh"; v[n++] = "./unisacc.com"; v[n++] = "tools/devsvc.cx"; v[n++] = "--"; v[n++] = "x"; v[n++] = "--par"; v[n++] = "1"; v[n++] = "--bg"; v[n++] = "--"; v[n++] = "env";
            for (int q = 0; en[q]; q++) if (getenv(en[q]) && *getenv(en[q])) { (void)cx_fmt(ev[q], sizeof ev[q], "%s=%s", en[q], getenv(en[q])); v[n++] = ev[q]; }
            v[n++] = "sh"; v[n++] = "./unisacc.com"; v[n++] = "tools/devtask.cx"; v[n++] = "--"; v[n++] = "task"; v[n++] = "done"; v[n++] = (char *)id; v[n++] = "--dir"; v[n++] = dir; v[n] = 0;
            rc2 = np_run(v, 0, 0, 40, &r2, w3, sizeof w3);
            jl = r2.out ? strstr(r2.out, "JOB\t") : 0;
            if (rc2 || r2.rc || !jl) { printf("BG_FAIL\n"); if (r2.out) fwrite(r2.out, 1, r2.outn, stdout); np_free(&r2); return 2; }
            { char jid[64]; long m = 0; const char *q = jl + 4; while (q[m] && q[m] != 9 && q[m] != 10 && m < 62) { jid[m] = q[m]; m++; } jid[m] = 0;
              if (sy_write_atomic(jp, jid, m, 0600)) { np_free(&r2); return bad("cannot record job id", jid); }
              printf("JOB\t%s\tdone-bg=%s\n", jid, id); }
            np_free(&r2); return 0;
        }
    }
    if ((rc = dw_load(dir, id, &t, why, sizeof why)) != 0) goto end;
    in = sb_new(); out = sb_new(); fo = sb_new();
    if (!in || !out || !fo) { dw_free(&t); return bad("out of memory", 0); }
    if (!strcmp(sub, "status")) {
        rc = dw_diff(&t, in, out, fo, &nin, &nout, &nfo, why, sizeof why);
        if (!rc) {
            printf("TASK\t%s\tstate=%s\tused_s=%ld\tleft_s=%ld\ttitle=%s\n", t.id, t.done ? "done" : "open", (t.done ? t.done : now) - t.opened, t.done ? 0 : t.deadline - now, t.title);
            printf("WRITE\t%s\n", t.write);
            for (int k = 0; k < t.nacc; k++) printf("ACCEPT\t%d\t%s\n", k + 1, t.acc[k]);
            paths("CHANGED", in); paths("OUTSIDE_WARN", out); paths("INFO_FOREIGN", fo);
            printf("TASK_STATUS\t%s\tchanged=%d\toutside=%d\toverdue=%d\tforeign=%d\towner=%s\n", t.id, nin, nout, !t.done && now > t.deadline, nfo, t.owner);
        }
    } else {
        int failed = 0; const char *emit = "local";
        int todo[DW_ACC], pass[DW_ACC], skipped = 0; char ident[65] = "";
        if (dw_ident(&t, ident, sizeof ident, why, sizeof why)) { rc = 2; goto fin; }
        dw_pass_load(dir, &t, ident, pass);
        for (int k = 0; k < t.nacc; k++) { todo[k] = !pass[k]; if (pass[k]) { skipped++; printf("ACCEPT\t%d\tSKIP_PASSED\tsame_input\t%s\n", k + 1, t.acc[k]); } }
        failed = accept_flow(dir, &t, todo, pass, direct);
        (void)dw_pass_save(dir, &t, ident, pass);
        if (failed < 0) { failed = t.nacc; printf("ACCEPT_RUNNER_FAULT\n"); }
        (void)skipped;
        rc = dw_diff(&t, in, out, fo, &nin, &nout, &nfo, why, sizeof why);
        if (!rc) {
            paths("OUTSIDE_CHANGED", out); paths("INFO_FOREIGN", fo);
            if (!failed && !nout && !direct) {   /* the coordinator reads this event; without it the work order stays open */
                char text[400]; char *v[] = {"sh", "./unisacc.com", "tools/devsvc.cx", "--", "events", "emit", "task.done", text, 0}; np_result r = {0}; char w2[256] = "";
                (void)cx_fmt(text, sizeof text, "id=%s accept=%d changed=%d used_s=%ld late=%d", t.id, t.nacc, nin, now - t.opened, now > t.deadline);
                if (np_run(v, 0, 0, 30, &r, w2, sizeof w2) || r.rc) { printf("EMIT_FAIL\ttask.done\trc=%d\t%s\n", r.rc, w2); tail("emit", r.out, (long)r.outn); tail("emit stderr", r.err, (long)r.errn); failed = -1; }
                else emit = "devsvc";
                np_free(&r);
            }
            if (!failed && !nout) rc = dw_finish(dir, &t, now, why, sizeof why);
            if (!rc && !failed && !nout) printf("DONE\t%s\taccept=%d\tchanged=%d\tused_s=%ld\tlate=%d\tevent=task.done(%s)\n", t.id, t.nacc, nin, now - t.opened, now > t.deadline, emit);
            else if (!rc) { printf("TASK_NOT_DONE\t%s\taccept_failed=%d\toutside=%d\temit_failed=%d\tleft_s=%ld\n", t.id, failed > 0 ? failed : 0, nout, failed < 0, t.deadline - now); rc = 1; }
        }
    }
fin:
    sb_free(in); sb_free(out); sb_free(fo); dw_free(&t);
    if (rc == 1 && !why[0]) return 1;
end:
    if (rc == 1) fprintf(stderr, "DEVTASK_REFUSE\t%s\n", why); else if (rc) fprintf(stderr, "devtask: %s\n", why);
    return rc;
}
static void row(const DtTask *t) { printf("%s\t%s\t%s\t%s\t%s\t%s\n", t->id, t->state, t->owner, t->deadline, t->domain, t->title); }
int main(int argc, char **argv) {
    char dir[1024], why[2048] = "", id[16]; const char *cmd = argc > 1 ? argv[1] : "", *pos = argc > 2 ? argv[2] : 0, *ne = getenv("DEVTASK_NOW");
    long now = ne && *ne ? atol(ne) : sy_wall_s(); int rc, view = !strcmp(cmd, "list") || !strcmp(cmd, "stale"); unsigned allow = 0; DtSet s;
    (void)val;
    if (!strcmp(cmd, "task")) return task_main(argc, argv, now);
    if (ne && *ne && now <= 0) return bad("bad DEVTASK_NOW", ne);
    if (!strcmp(cmd, "add")) allow = 1u << O_DOMAIN | 1u << O_DEADLINE | 1u << O_FOR;
    else if (!strcmp(cmd, "claim")) allow = 1u << O_OWNER;
    else if (!strcmp(cmd, "done")) allow = 1u << O_EVIDENCE;
    else if (!strcmp(cmd, "block") || !strcmp(cmd, "drop")) allow = 1u << O_WHY;
    else if (!strcmp(cmd, "gap")) allow = 1u << O_TEXT;
    else if (!strcmp(cmd, "list")) allow = 1u << O_STATE | 1u << O_OWNER;
    else if (strcmp(cmd, "show") && strcmp(cmd, "stale")) {
        fprintf(stderr, "usage: devtask add TITLE --domain P... [--deadline MIN] [--for OWNER] | claim ID --owner O | done ID --evidence E\n"
                        "       devtask block ID --why W | gap ID --text T | drop ID --why W | list [--state S] [--owner O] | show ID | stale   (all: [--dir D])\n");
        return 2;
    }
    if (!view && (!pos || !strncmp(pos, "--", 2))) return bad(cmd, "needs a TITLE or ID first");
    if (parse(argc, argv, view ? 2 : 3, allow) || resolve(dir, sizeof dir)) return 2;
    if (!strcmp(cmd, "add")) {
        long min = 0; const char *d = ov[O_DEADLINE];
        if (!ov[O_DOMAIN]) return bad("add needs --domain", 0);
        if (d) { for (const char *q = d; *q; q++) if (*q < '0' || *q > '9') return bad("bad --deadline", d); min = atol(d); if (min < 1 || strlen(d) > 6) return bad("bad --deadline", d); }
        rc = dt_add(dir, pos, ov[O_DOMAIN], min, ov[O_FOR], now, id, sizeof id, why, sizeof why);
        if (!rc) printf("TASK\tadd\t%s\topen\n", id);
    } else if (!view && strcmp(cmd, "show")) {
        const char *text = ov[O_EVIDENCE] ? ov[O_EVIDENCE] : ov[O_WHY] ? ov[O_WHY] : ov[O_TEXT];
        if (!strcmp(cmd, "claim") ? !ov[O_OWNER] : !text) return bad(cmd, "lacks its required option");
        rc = dt_change(dir, cmd, pos, ov[O_OWNER], text, now, why, sizeof why);
        if (!rc) printf("TASK\t%s\t%s\tok\n", cmd, pos);
    } else {
        int count = 0, found = 0;
        if (ov[O_STATE] && strcmp(ov[O_STATE], "open") && strcmp(ov[O_STATE], "claimed") && strcmp(ov[O_STATE], "blocked") && strcmp(ov[O_STATE], "done") && strcmp(ov[O_STATE], "dropped")) return bad("bad --state", ov[O_STATE]);
        rc = dt_load(dir, &s, why, sizeof why);
        if (!rc) {
            if (view) printf("id\tstate\towner\tdeadline\twrite_domain\ttitle\n");
            for (int i = 0; i < s.n; i++) { const DtTask *t = &s.t[i];
                if (!view) { if (strcmp(t->id, pos)) continue; found = 1;
                    printf("id\t%s\ntitle\t%s\nowner\t%s\nstate\t%s\nwrite_domain\t%s\ndeadline\t%s\nevidence\t%s\ngap\t%s\nupdated\t%s\nstale\t%d\n", t->id, t->title, t->owner, t->state, t->domain, t->deadline, t->evidence, t->gap, t->updated, dt_stale(t, now));
                } else if (!strcmp(cmd, "stale") ? dt_stale(t, now) : (!ov[O_STATE] || !strcmp(ov[O_STATE], t->state)) && (!ov[O_OWNER] || !strcmp(ov[O_OWNER], t->owner))) { row(t); count++; }
            }
            if (view) printf("%s\tcount=%d\ttotal=%d\n", !strcmp(cmd, "stale") ? "DEVTASK_STALE" : "DEVTASK_LIST", count, s.n);
            else if (!found) { (void)cx_fmt(why, sizeof why, "no such task %s", pos); rc = 2; }
            dt_free(&s);
        }
    }
    if (rc == 1) fprintf(stderr, "DEVTASK_REFUSE\t%s\n", why); else if (rc) fprintf(stderr, "devtask: %s\n", why);
    return rc;
}
