#pragma unisa use sys.io
#pragma unisa use text.text
/* Project the official names of the seven pipeline stages.
   sh ./unisacc.com tools/official-gen.cx -- --check
   sh ./unisacc.com tools/official-gen.cx -- --write
   Names come from the official column of exec/pipeline/image-stages.tsv,
   in file order. Stage codes stay on streamname.
   lex, parse, opt and prune are already module file names, so this is
   one table, not seven files. This is not st_gap.
   A null out-pointer returns 4. An index outside 0..count-1 returns 2.
   No libc and no include. */
#define STAGES "exec/pipeline/image-stages.tsv"
#define NROW 7
#define NAMEMAX 32
#define FILECAP 2048
#define CHECKCAP 8192

static char codes[NROW][NAMEMAX];
static char names[NROW][NAMEMAX];
static int ncode;
static int nname;

static int fail(const char *why) {
    sy_eprintf("official-gen\tFAIL\t%s\n", why);
    return 1;
}

static int ident_ok(const char *s, int n) {
    int i;
    if (n < 1 || n >= NAMEMAX) return 0;
    if (s[0] < 'a' || s[0] > 'z') return 0;
    for (i = 1; i < n; i++) {
        char c = s[i];
        if (c >= 'a' && c <= 'z') continue;
        if (c >= '0' && c <= '9') continue;
        return 0;
    }
    return 1;
}

static void copy_field(char *dst, const char *s, int n) {
    int i;
    for (i = 0; i < n; i++) dst[i] = s[i];
    dst[n] = 0;
}

static int in_set(char set[][NAMEMAX], int n, const char *s) {
    int i;
    for (i = 0; i < n; i++) if (tx_eqz(set[i], s)) return 1;
    return 0;
}

static int push_new(char set[][NAMEMAX], int *count, const char *s, const char *dup, const char *full) {
    int i;
    if (in_set(set, *count, s)) return fail(dup);
    if (*count >= NROW) return fail(full);
    for (i = 0; s[i]; i++) set[*count][i] = s[i];
    set[*count][i] = 0;
    *count += 1;
    return 0;
}

static int take_stage(const char *line, int n) {
    const char *f[5];
    int len[5];
    int i, k, start;
    char code[NAMEMAX], official[NAMEMAX];
    k = 0;
    start = 0;
    for (i = 0; i <= n; i++) {
        if (i == n || line[i] == '\t') {
            if (k >= 5) return fail("row-fields");
            f[k] = line + start;
            len[k] = i - start;
            k++;
            start = i + 1;
        }
    }
    if (k != 5) return fail("row-fields");
    if (!ident_ok(f[0], len[0])) return fail("code-charset");
    if (!ident_ok(f[4], len[4])) return fail("official-charset");
    copy_field(code, f[0], len[0]);
    copy_field(official, f[4], len[4]);
    if (push_new(codes, &ncode, code, "code-dup", "code-count")) return 1;
    if (push_new(names, &nname, official, "official-dup", "official-count")) return 1;
    return 0;
}

static int parse_stages(void) {
    size_t nb = 0, i = 0;
    char *b;
    int saw = 0;
    b = cx_read(STAGES, &nb);
    if (!b) return fail(STAGES);
    if (nb == 0 || b[nb - 1] != '\n') return fail("tsv-newline");
    while (i < nb) {
        size_t e = i;
        while (e < nb && b[e] != '\n') e++;
        b[e] = 0;
        if (e == i) return fail("tsv-blank");
        if (!saw) {
            if (!tx_eqz(b + i, "# stage\tinput format\toutput format\tmodel file\tofficial"))
                return fail("tsv-header");
            saw = 1;
        } else if (b[i] == '#') {
            return fail("tsv-comment");
        } else if (take_stage(b + i, (int)(e - i))) {
            return 1;
        }
        i = e + 1;
    }
    if (ncode != NROW) return fail("code-count");
    if (nname != NROW) return fail("official-count");
    return 0;
}

static int app(char *dst, int cap, int *n, const char *s) {
    int i = 0;
    while (s[i]) {
        if (*n + 1 >= cap) return -1;
        dst[*n] = s[i];
        *n += 1;
        i++;
    }
    dst[*n] = 0;
    return 0;
}

static int app_n(char *dst, int cap, int *n, int d) {
    char s[4];
    int k = 0;
    if (d < 0 || d > 99) return -1;
    if (d >= 10) s[k++] = (char)('0' + d / 10);
    s[k++] = (char)('0' + d % 10);
    s[k] = 0;
    return app(dst, cap, n, s);
}

static int emit_mod(char *dst, int cap, const char *prefix) {
    int n = 0, i;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa module officialname\n")) return -1;
    if (app(dst, cap, &n, "/* Generated by tools/official-gen.cx.\n")) return -1;
    if (app(dst, cap, &n, "   Do not edit by hand. Names are the official column of image-stages.tsv.\n")) return -1;
    if (app(dst, cap, &n, "   Stage codes stay on streamname. Order is file order.\n")) return -1;
    if (app(dst, cap, &n, "   A null out-pointer returns 4. An index outside 0..count-1 returns 2.\n")) return -1;
    if (app(dst, cap, &n, "   No libc and no include. */\n")) return -1;
    if (app(dst, cap, &n, "int ")) return -1;
    if (app(dst, cap, &n, prefix)) return -1;
    if (app(dst, cap, &n, "_count(void) {\n    return ")) return -1;
    if (app_n(dst, cap, &n, nname)) return -1;
    if (app(dst, cap, &n, ";\n}\n")) return -1;
    if (app(dst, cap, &n, "int ")) return -1;
    if (app(dst, cap, &n, prefix)) return -1;
    if (app(dst, cap, &n, "_at(int index, const char **name) {\n")) return -1;
    if (app(dst, cap, &n, "    if (!name) return 4;\n")) return -1;
    for (i = 0; i < nname; i++) {
        if (app(dst, cap, &n, "    if (index == ")) return -1;
        if (app_n(dst, cap, &n, i)) return -1;
        if (app(dst, cap, &n, ") { *name = \"")) return -1;
        if (app(dst, cap, &n, names[i])) return -1;
        if (app(dst, cap, &n, "\"; return 0; }\n")) return -1;
    }
    if (app(dst, cap, &n, "    return 2;\n}\n")) return -1;
    return n;
}

static int emit_rows(char *dst, int cap, int *n, const char *prefix) {
    int i;
    if (app(dst, cap, n, "    if (")) return -1;
    if (app(dst, cap, n, prefix)) return -1;
    if (app(dst, cap, n, "_count() != ")) return -1;
    if (app_n(dst, cap, n, nname)) return -1;
    if (app(dst, cap, n, ") return 1;\n")) return -1;
    for (i = 0; i < nname; i++) {
        if (app(dst, cap, n, "    if (")) return -1;
        if (app(dst, cap, n, prefix)) return -1;
        if (app(dst, cap, n, "_at(")) return -1;
        if (app_n(dst, cap, n, i)) return -1;
        if (app(dst, cap, n, ", &name) || !tx_eqz(name, \"")) return -1;
        if (app(dst, cap, n, names[i])) return -1;
        if (app(dst, cap, n, "\")) return 1;\n")) return -1;
    }
    if (app(dst, cap, n, "    if (")) return -1;
    if (app(dst, cap, n, prefix)) return -1;
    if (app(dst, cap, n, "_at(0, missing) != 4) return 1;\n")) return -1;
    if (app(dst, cap, n, "    if (")) return -1;
    if (app(dst, cap, n, prefix)) return -1;
    if (app(dst, cap, n, "_at(-1, &name) != 2) return 1;\n")) return -1;
    if (app(dst, cap, n, "    if (")) return -1;
    if (app(dst, cap, n, prefix)) return -1;
    if (app(dst, cap, n, "_at(")) return -1;
    if (app_n(dst, cap, n, nname)) return -1;
    if (app(dst, cap, n, ", &name) != 2) return 1;\n")) return -1;
    return 0;
}

static int emit_check(char *dst, int cap) {
    int n = 0;
    dst[0] = 0;
    if (app(dst, cap, &n, "#pragma unisa use compiler.officialname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use runtime.officialname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use compiler.streamname\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use sys.io\n")) return -1;
    if (app(dst, cap, &n, "#pragma unisa use text.text\n")) return -1;
    if (app(dst, cap, &n, "/* Generated by tools/official-gen.cx. Narrow check of official stage names. */\n")) return -1;
    if (app(dst, cap, &n, "int main(void) {\n")) return -1;
    if (app(dst, cap, &n, "    const char *name;\n")) return -1;
    if (app(dst, cap, &n, "    const char *other;\n")) return -1;
    if (app(dst, cap, &n, "    const char *official;\n")) return -1;
    if (app(dst, cap, &n, "    const char *code;\n")) return -1;
    if (app(dst, cap, &n, "    const char **missing;\n")) return -1;
    if (app(dst, cap, &n, "    int i;\n")) return -1;
    if (app(dst, cap, &n, "    missing = 0;\n")) return -1;
    if (emit_rows(dst, cap, &n, "ofn")) return -1;
    if (emit_rows(dst, cap, &n, "rof")) return -1;
    if (app(dst, cap, &n, "    if (sn_count() != ")) return -1;
    if (app_n(dst, cap, &n, nname)) return -1;
    if (app(dst, cap, &n, ") return 1;\n")) return -1;
    if (app(dst, cap, &n, "    for (i = 0; i < ofn_count(); i++) {\n")) return -1;
    if (app(dst, cap, &n, "        if (ofn_at(i, &name)) return 1;\n")) return -1;
    if (app(dst, cap, &n, "        if (rof_at(i, &other)) return 1;\n")) return -1;
    if (app(dst, cap, &n, "        if (!tx_eqz(name, other)) return 1;\n")) return -1;
    if (app(dst, cap, &n, "        if (sn_at(i, &official, &code)) return 1;\n")) return -1;
    if (app(dst, cap, &n, "        if (!tx_eqz(name, official)) return 1;\n")) return -1;
    if (app(dst, cap, &n, "    }\n")) return -1;
    if (app(dst, cap, &n, "    sy_printf(\"CX_OFFICIAL\\tok=")) return -1;
    if (app_n(dst, cap, &n, nname)) return -1;
    if (app(dst, cap, &n, "\\tfailed=0\\n\");\n")) return -1;
    if (app(dst, cap, &n, "    return 0;\n}\n")) return -1;
    return n;
}

static int same_bytes(const char *a, size_t an, const char *b, int bn) {
    int i;
    if (an != (size_t)bn) return 0;
    for (i = 0; i < bn; i++) if (a[i] != b[i]) return 0;
    return 1;
}

static int one_file(int dowrite, const char *path, const char *body, int n) {
    size_t on = 0;
    char *cur;
    if (dowrite) {
        if (cx_write(path, body, (size_t)n)) return fail("write");
        return 0;
    }
    cur = cx_read(path, &on);
    if (!cur) return fail(path);
    if (!same_bytes(cur, on, body, n)) return fail(path);
    return 0;
}

int main(int argc, char **argv) {
    char file[FILECAP], check[CHECKCAP];
    int dowrite, fn, cn;
    if (argc != 2 || (!tx_eqz(argv[1], "--check") && !tx_eqz(argv[1], "--write"))) {
        sy_eprintf("official-gen\tusage\t--check|--write\n");
        return 2;
    }
    dowrite = tx_eqz(argv[1], "--write");
    if (parse_stages()) return 1;
    cn = emit_check(check, CHECKCAP);
    if (cn < 0) return fail("emit-check");
    fn = emit_mod(file, FILECAP, "ofn");
    if (fn < 0) return fail("emit-compiler");
    if (one_file(dowrite, "cx/compiler/officialname.cx", file, fn)) return 1;
    fn = emit_mod(file, FILECAP, "rof");
    if (fn < 0) return fail("emit-runtime");
    if (one_file(dowrite, "cx/runtime/officialname.cx", file, fn)) return 1;
    if (one_file(dowrite, "tools/check-cx-official.cx", check, cn)) return 1;
    if (dowrite) sy_printf("OFFICIAL_GEN\tWROTE\trows=%d\n", nname);
    else sy_printf("OFFICIAL_GEN\tCHECK\trows=%d\n", nname);
    return 0;
}
