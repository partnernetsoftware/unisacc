/* tools/dup-census.cx -- census of duplicated static functions in tools/*.cx and tools/cxlib/*.cx (the 15th ratchet).
 * 重复是测量,合并是决定(须权衡间接成本、平台是否已有、副本们是契约一致还是仅文字一致;已核实契约不同或合并净亏的重复组登记入白名单,不计入棘轮,防止为降数字做净亏合并)
 *
 *   sh ./unisacc.com tools/dup-census.cx [-- --print | --check | --write | --where NAME | --hint-file PATH | --list-hints] [--root DIR]
 *
 * Scans ROOT/tools/*.cx and ROOT/tools/cxlib/*.cx (direct children, file names sorted).  A static function is a
 * line starting "static " with "NAME(" before any '=' or ';', whose parameter list is followed by '{'; its text
 * runs from the start of that line to the matching '}' (braces inside string and char literals skipped).
 *   by name:     names defined in 2 or more files, their definitions, and excess lines (sum of lines minus
 *                lines / defs per name: an upper bound of what one shared copy would save);
 *   verbatim:    a group is 2 or more definitions with the same name and byte-identical text; per group the
 *                copies, lines of one copy, total lines (copies x lines) and redundant lines ((copies-1) x lines);
 *   fragments:   counts of hand-written snippets (information only, never judged);
 *   whitelist:   optional build/dup-census-whitelist.tsv (columns: name<TAB>reason<TAB>verified_date).  Matched
 *                function names are marked whitelisted=N in output and excluded from ratchet failure counts.
 * --print writes the report (stable: no time, no absolute path) to stdout:
 *   GROUP<TAB>name<TAB>copies<TAB>lines<TAB>total<TAB>redundant     one row per verbatim group, by name
 *   WHITELIST<TAB>name<TAB>whitelisted=N<TAB>copies=C<TAB>redundant=R   matched whitelisted function rows
 *   FRAG<TAB>label<TAB>occurrences<TAB>files                         information rows
 *   DUP_SUMMARY files=.. static_fn=.. dup_names=.. dup_defs=.. excess_lines=.. verbatim_groups=.. verbatim_defs=.. verbatim_lines=.. verbatim_redundant=.. [whitelisted=..]
 * --write replaces build/dup-census-baseline.tsv (rows total<TAB>verbatim_groups|verbatim_redundant<TAB>N and
 * group<TAB>name<TAB>copies<TAB>lines).  --check compares with it and prints
 *   dup-census: ok: verbatim_groups=N (baseline M) verbatim_redundant=R (baseline S) whitelisted=W
 *   dup-census: FAIL: new=A grown=B groups=N baseline=M redundant=R baseline=S whitelisted=W
 * preceded by rows "dup-census: NAME has N verbatim copies, baseline M" for a group the baseline lacks (M 0) or
 * one with more copies, and "dup-census: tools total lines verbatim_redundant R, baseline S" when that total grew.
 * Fewer groups, copies or lines pass (only go down); --write then lowers the baseline.  rc 0 ok, 1 FAIL, 2 error. */
#pragma unisa use sys.posix
#pragma unisa use sys.fs
#pragma unisa use sys.io
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.heap
#pragma unisa use mem.bytes

#define MAXF 4096
#define MAXE 80000
#define MAXG 4096
#define MAXWL 256
static const char *root = ".";
static char *fname[MAXF]; static char *fbuf[MAXF]; static long flen[MAXF]; static int nf;
static int e_file[MAXE], e_lines[MAXE]; static long e_s[MAXE], e_e[MAXE], e_ns[MAXE], e_nl[MAXE];
static unsigned long e_h[MAXE], e_nh[MAXE]; static int ne, idx[MAXE], aidx[MAXE], amem[MAXE], aseen[MAXE];
static int g_rep[MAXG], g_copies[MAXG], g_lines[MAXG], g_i0[MAXG]; static int ng;
static int ag_rep[MAXG], ag_copies[MAXG], ag_lines[MAXG], ag_i0[MAXG]; static int nag, nam;
static char wl_name[MAXWL][128]; static int nwl;

static const char *dc_hints[][3] = {
    {"run",      "pr_run",   "tools/cxlib/procrun.cx (or px_run in ext/sysx/run.cx)"},
    {"exec",     "px_run",   "ext/sysx/run.cx (or pr_run in tools/cxlib/procrun.cx)"},
    {"spawn",    "px_run",   "ext/sysx/run.cx (or pr_run in tools/cxlib/procrun.cx)"},
    {"sh",       "ckk_sh_t", "tools/cxlib/ckrun.cx (or pr_run in tools/cxlib/procrun.cx)"},
    {"ck_run",   "ck_run",   "tools/cxlib/ckassert.cx (or tk_run in ext/testx/check.cx)"},
    {"check",    "tk_ok",    "ext/testx/check.cx (or ck_run in tools/cxlib/ckassert.cx)"},
    {"has",      "tk_has",   "ext/testx/check.cx (or tx_find in cx/text/text.cx)"},
    {"contains", "tk_has",   "ext/testx/check.cx (or tx_find in cx/text/text.cx)"},
    {"append",   "sb_puts",  "ext/textx/build.cx (or cx_fmt / tx_*)"},
    {"join",     "sb_join",  "ext/textx/build.cx (or cx_fmt / tx_*)"},
    {"cat",      "sb_puts",  "ext/textx/build.cx (or cx_fmt / tx_*)"},
    {"fmt",      "sb_putn",  "ext/textx/build.cx (or cx_fmt / tx_*)"},
    {"put",      "sb_puts",  "ext/textx/build.cx (or cx_fmt / tx_*)"},
    {"str",      "sb_puts",  "ext/textx/build.cx (or cx_fmt / tx_*)"},
};
#define NHINTS 14

static int dc_hint_for(const char *nm, long nl) {
    int h; long i;
    for (h = 0; h < NHINTS; h++) {
        long pl = tx_len(dc_hints[h][0], 64);
        if (nl == pl && mm_same(nm, dc_hints[h][0], pl)) return h;
    }
    for (h = 0; h < NHINTS; h++) {
        long pl = tx_len(dc_hints[h][0], 64);
        if (pl > nl) continue;
        for (i = 0; i + pl <= nl; i++) {
            int l_ok = (i == 0 || nm[i - 1] == '_');
            int r_ok = (i + pl == nl || nm[i + pl] == '_' || (nm[i + pl] >= '0' && nm[i + pl] <= '9'));
            if (l_ok && r_ok && mm_same(nm + i, dc_hints[h][0], pl)) return h;
        }
    }
    return -1;
}

static const char *frag[][2] = {
    {"path.fmt-join", "\"%s/%s\""}, {"tsv.hand-tabchr", "'\\t'"}, {"fmt.snprintf", "snprintf("},
    {"argv.strcmp-argv", "strcmp(argv["}, {"tmp.mkdtemp", "mkdtemp("}, {"tmp.literal", "\"/tmp/"},
    {"sort.hand-shellgap", "gap /= 2"}, {"io.libc-fopen", "fopen("},
};
#define NFRAG 8
static long fr_occ[NFRAG]; static int fr_files[NFRAG];

static int isid(int c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'; }

static unsigned long dc_hash_anon(const char *b, long ls, long q, long qe, long k) {
    unsigned long nh = 1469598103934665603ul; long t;
    const char *ph = "_FN_";
    for (t = ls; t < q; t++) { nh ^= (unsigned char)b[t]; nh *= 1099511628211ul; }
    for (t = 0; t < 4; t++) { nh ^= (unsigned char)ph[t]; nh *= 1099511628211ul; }
    for (t = qe; t < k; t++) { nh ^= (unsigned char)b[t]; nh *= 1099511628211ul; }
    return nh;
}

static void scan(int fi) {
    const char *b = fbuf[fi]; long n = flen[fi], i = 0;
    while (i < n) {
        long ls = i, le, p, q, qe, k, t; int par = 0, d = 0, lines = 1; unsigned long h = 1469598103934665603ul;
        while (i < n && b[i] != '\n') i++;
        le = i; if (i < n) i++;
        if (le - ls < 10 || !mm_same(b + ls, "static ", 7)) continue;
        p = ls; while (p < le && b[p] != '(' && b[p] != '=' && b[p] != ';') p++;
        if (p >= le || b[p] != '(') continue;
        qe = p; while (qe > ls && b[qe - 1] == ' ') qe--;
        q = qe; while (q > ls && isid(b[q - 1])) q--;
        if (qe == q) continue;
        k = p;
        while (k < n) { if (b[k] == '(') par++; else if (b[k] == ')') { par--; if (!par) { k++; break; } } k++; }
        while (k < n && (b[k] == ' ' || b[k] == '\n' || b[k] == '\t')) k++;
        if (k >= n || b[k] != '{') continue;
        while (k < n) {
            char c = b[k];
            if (c == '"' || c == '\'') { k++; while (k < n && b[k] != c && b[k] != '\n') { if (b[k] == '\\') k++; k++; } k++; continue; }
            if (c == '{') d++;
            else if (c == '}') { d--; if (!d) { k++; break; } }
            k++;
        }
        if (k > n) k = n;
        for (t = ls; t < k; t++) { if (b[t] == '\n') lines++; h ^= (unsigned char)b[t]; h *= 1099511628211ul; }
        if (ne < MAXE) { e_file[ne] = fi; e_s[ne] = ls; e_e[ne] = k; e_ns[ne] = q; e_nl[ne] = qe - q; e_lines[ne] = lines; e_h[ne] = h; e_nh[ne] = dc_hash_anon(b, ls, q, qe, k); ne++; }
        i = k; while (i < n && b[i] != '\n') i++;
        if (i < n) i++;
    }
}

static int ncmp(int a, int b) { return tx_cmp(fbuf[e_file[a]] + e_ns[a], e_nl[a], fbuf[e_file[b]] + e_ns[b], e_nl[b]); }
static int ecmp(int a, int b) {
    int r = ncmp(a, b);
    if (r) return r;
    if (e_h[a] != e_h[b]) return e_h[a] < e_h[b] ? -1 : 1;
    return e_file[a] - e_file[b];
}
static int acmp(int a, int b) {
    if (e_nh[a] != e_nh[b]) return e_nh[a] < e_nh[b] ? -1 : 1;
    if (e_file[a] != e_file[b]) return e_file[a] - e_file[b];
    return e_s[a] < e_s[b] ? -1 : (e_s[a] > e_s[b] ? 1 : 0);
}
static int same_body(int a, int b) {
    long la = e_e[a] - e_s[a];
    return e_h[a] == e_h[b] && la == e_e[b] - e_s[b] && mm_same(fbuf[e_file[a]] + e_s[a], fbuf[e_file[b]] + e_s[b], la);
}
static int same_body_anon(int a, int b) {
    long pa = e_ns[a] - e_s[a], pb = e_ns[b] - e_s[b];
    long sa = e_e[a] - (e_ns[a] + e_nl[a]), sb = e_e[b] - (e_ns[b] + e_nl[b]);
    if (e_nh[a] != e_nh[b] || pa != pb || sa != sb) return 0;
    return mm_same(fbuf[e_file[a]] + e_s[a], fbuf[e_file[b]] + e_s[b], pa) &&
           mm_same(fbuf[e_file[a]] + e_ns[a] + e_nl[a], fbuf[e_file[b]] + e_ns[b] + e_nl[b], sa);
}
static void sort_e(void) {
    int gap, i, j, t;
    for (i = 0; i < ne; i++) idx[i] = i;
    for (gap = ne / 2; gap > 0; gap /= 2) for (i = gap; i < ne; i++) { t = idx[i]; for (j = i; j >= gap && ecmp(idx[j - gap], t) > 0; j -= gap) idx[j] = idx[j - gap]; idx[j] = t; }
}
static void sort_a(void) {
    int gap, i, j, t;
    for (i = 0; i < ne; i++) aidx[i] = i;
    for (gap = ne / 2; gap > 0; gap /= 2) for (i = gap; i < ne; i++) { t = aidx[i]; for (j = i; j >= gap && acmp(aidx[j - gap], t) > 0; j -= gap) aidx[j] = aidx[j - gap]; aidx[j] = t; }
}
static void sort_names(int lo, int hi) {   /* the file names of one directory, by bytes */
    int i, j; char *t;
    for (i = lo + 1; i < hi; i++) { t = fname[i]; for (j = i; j > lo && tx_cmp(fname[j - 1], tx_len(fname[j - 1], 1024), t, tx_len(t, 1024)) > 0; j--) fname[j] = fname[j - 1]; fname[j] = t; }
}
static int list_dir(const char *rel) {
    sy_dir_t d; char dir[1200]; int lo = nf;
    if (cx_fmt(dir, sizeof dir, "%s/%s", root, rel) || sy_dir_open(&d, dir)) return -1;
    while (sy_dir_next(&d) == 1) {
        long l = tx_len(d.name, 512); char r[1200];
        if (l < 4 || !tx_eqz(d.name + l - 3, ".cx") || d.name[0] == '.' || nf >= MAXF) continue;
        if (cx_fmt(r, sizeof r, "%s/%s", rel, d.name)) continue;
        fname[nf] = mm_alloc(tx_len(r, 1200) + 1);
        if (!fname[nf]) break;
        mm_copy(fname[nf], tx_len(r, 1200) + 1, r, tx_len(r, 1200) + 1); nf++;
    }
    sy_dir_close(&d);
    sort_names(lo, nf);
    return 0;
}

static long s_dupnames, s_dupdefs, s_excess, s_vdefs, s_vlines, s_vred, s_adefs, s_ared;

static void census(void) {
    int i, j, k, f;
    for (f = 0; f < nf; f++) {
        char p[1300]; size_t m = 0; char *b;
        if (!fbuf[f]) {
            if (cx_fmt(p, sizeof p, "%s/%s", root, fname[f])) continue;
            b = cx_read(p, &m);
            fbuf[f] = b ? b : (char *)""; flen[f] = b ? (long)m : 0;
        }
        scan(f);
        for (k = 0; k < NFRAG; k++) {
            long pl = tx_len(frag[k][1], 64), c = 0, at;
            for (at = 0; at + pl <= flen[f]; at++) if (fbuf[f][at] == frag[k][1][0] && mm_same(fbuf[f] + at, frag[k][1], pl)) c++;
            if (c) { fr_occ[k] += c; fr_files[k]++; }
        }
    }
    sort_e();
    for (i = 0; i < ne; i = j) {
        long lines = 0; int files = 0;
        for (j = i; j < ne && !ncmp(idx[j], idx[i]); j++) lines += e_lines[idx[j]];
        for (k = i; k < j; k++) { int x, seen = 0; for (x = i; x < k; x++) if (e_file[idx[x]] == e_file[idx[k]]) { seen = 1; break; } if (!seen) files++; }
        if (files >= 2) { s_dupnames++; s_dupdefs += j - i; s_excess += lines - lines / (j - i); }
        for (k = i; k < j; ) {   /* verbatim runs: sorted by hash inside a name */
            int m = k + 1;
            while (m < j && same_body(idx[k], idx[m])) m++;
            if (m - k >= 2 && ng < MAXG) {
                g_rep[ng] = idx[k]; g_i0[ng] = k; g_copies[ng] = m - k; g_lines[ng] = e_lines[idx[k]]; ng++;
                s_vdefs += m - k; s_vlines += (long)(m - k) * e_lines[idx[k]]; s_vred += (long)(m - k - 1) * e_lines[idx[k]];
            }
            k = m;
        }
    }
    sort_a();
    for (i = 0; i < ne; i = j) {
        for (j = i + 1; j < ne && e_nh[aidx[j]] == e_nh[aidx[i]]; j++) {}
        if (j - i < 2) continue;
        for (k = i; k < j; k++) aseen[k] = 0;
        for (k = i; k < j; k++) {
            int m, cnt = 0, diff_name = 0, base_m = nam;
            if (aseen[k]) continue;
            aseen[k] = 1;
            if (nam < MAXE) amem[nam++] = aidx[k];
            cnt = 1;
            for (m = k + 1; m < j; m++) {
                if (aseen[m] || !same_body_anon(aidx[k], aidx[m])) continue;
                aseen[m] = 1;
                if (ncmp(aidx[k], aidx[m])) diff_name = 1;
                if (nam < MAXE) amem[nam++] = aidx[m];
                cnt++;
            }
            if (cnt >= 2 && diff_name && nag < MAXG) {
                ag_rep[nag] = aidx[k]; ag_i0[nag] = base_m; ag_copies[nag] = cnt; ag_lines[nag] = e_lines[aidx[k]]; nag++;
                s_adefs += cnt; s_ared += (long)(cnt - 1) * e_lines[aidx[k]];
            } else {
                nam = base_m;
            }
        }
    }
}

static void gname(int g, const char **s, long *l) { int e = g_rep[g]; *s = fbuf[e_file[e]] + e_ns[e]; *l = e_nl[e]; }
static long num(const char *s, long n) { long v = 0, x; for (x = 0; x < n && s[x] >= '0' && s[x] <= '9'; x++) v = v * 10 + (s[x] - '0'); return v; }

static int dc_wl_date(const char *s, long n) {
    int i;
    if (n != 10 || s[4] != '-' || s[7] != '-') return 0;
    for (i = 0; i < 10; i++) {
        if (i == 4 || i == 7) continue;
        if (s[i] < '0' || s[i] > '9') return 0;
    }
    return 1;
}
static int dc_wl_has(const char *nm, long nl) {
    int i;
    for (i = 0; i < nwl; i++) {
        if (tx_len(wl_name[i], 128) == nl && mm_same(wl_name[i], nm, nl)) return 1;
    }
    return 0;
}
static int dc_wl_load(const char *rdir) {
    char wpath[1300]; size_t m = 0; char *t; long at = 0; int st;
    nwl = 0;
    if (cx_fmt(wpath, sizeof wpath, "%s/build/dup-census-whitelist.tsv", rdir)) return -1;
    st = sy_is_reg(wpath);
    if (st == -ENOENT) return 0;
    if (st != 1) { fprintf(stderr, "dup-census: cannot stat %s\n", wpath); return -1; }
    t = cx_read(wpath, &m);
    if (!t) { fprintf(stderr, "dup-census: cannot read %s\n", wpath); return -1; }
    while (at < (long)m) {
        long e = tx_chr(t + at, (long)m - at, '\n'), ln = e < 0 ? (long)m - at : e;
        long o0, l0, o1, l1, o2, l2, o3, l3, k; int has_nonws = 0;
        if (ln > 0 && t[at] != '#') {
            if (ln == 25 && mm_same(t + at, "name\treason\tverified_date", 25)) { at += ln + 1; continue; }
            if (tx_field(t + at, ln, '\t', 0, &o0, &l0) ||
                tx_field(t + at, ln, '\t', 1, &o1, &l1) ||
                tx_field(t + at, ln, '\t', 2, &o2, &l2) ||
                !tx_field(t + at, ln, '\t', 3, &o3, &l3)) {
                fprintf(stderr, "dup-census: whitelist row requires 3 columns (name, reason, verified_date) in %s\n", wpath);
                mm_free(t); return -1;
            }
            if (l0 <= 0 || l0 >= 128) { fprintf(stderr, "dup-census: invalid whitelist name in %s\n", wpath); mm_free(t); return -1; }
            for (k = 0; k < l0; k++) if (!isid((unsigned char)t[at + o0 + k])) { fprintf(stderr, "dup-census: invalid whitelist identifier in %s\n", wpath); mm_free(t); return -1; }
            for (k = 0; k < l1; k++) if (t[at + o1 + k] != ' ' && t[at + o1 + k] != '\t' && t[at + o1 + k] != '\r') has_nonws = 1;
            if (l1 <= 0 || !has_nonws || (l1 == 1 && t[at + o1] == '-')) {
                fprintf(stderr, "dup-census: missing whitelist reason in %s\n", wpath);
                mm_free(t); return -1;
            }
            if (!dc_wl_date(t + at + o2, l2)) {
                fprintf(stderr, "dup-census: missing or invalid whitelist verified_date (YYYY-MM-DD required) in %s\n", wpath);
                mm_free(t); return -1;
            }
            if (dc_wl_has(t + at + o0, l0) || nwl >= MAXWL) {
                fprintf(stderr, "dup-census: duplicate or excess whitelist name in %s\n", wpath);
                mm_free(t); return -1;
            }
            mm_copy(wl_name[nwl], sizeof wl_name[0], t + at + o0, l0);
            wl_name[nwl][l0] = 0;
            nwl++;
        }
        at += ln + 1;
    }
    mm_free(t);
    return 0;
}
static void dc_wl_base(const char *t, long tn, int *bg_wl, long *br_wl) {
    long at = 0;
    *bg_wl = 0; *br_wl = 0;
    while (at < tn) {
        long e = tx_chr(t + at, tn - at, '\n'), ln = e < 0 ? tn - at : e, o1, l1, o2, l2, o3, l3;
        if (ln > 6 && mm_same(t + at, "group\t", 6) &&
            !tx_field(t + at, ln, '\t', 1, &o1, &l1) &&
            !tx_field(t + at, ln, '\t', 2, &o2, &l2) &&
            !tx_field(t + at, ln, '\t', 3, &o3, &l3) &&
            dc_wl_has(t + at + o1, l1)) {
            long c = num(t + at + o2, l2), l = num(t + at + o3, l3);
            (*bg_wl)++;
            if (c > 1 && l > 0) *br_wl += (c - 1) * l;
        }
        at += ln + 1;
    }
}

/* baseline: one name may carry more than one verbatim group; compare per name, copies summed */
static int base_find(const char *t, long tn, const char *nm, long nl, long *copies) {
    long at = 0; int found = 0;
    while (at < tn) {
        long e = tx_chr(t + at, tn - at, '\n'), ln = e < 0 ? tn - at : e, o1, l1, o2, l2;
        if (ln > 6 && mm_same(t + at, "group\t", 6) && !tx_field(t + at, ln, '\t', 1, &o1, &l1) && l1 == nl && mm_same(t + at + o1, nm, nl)
            && !tx_field(t + at, ln, '\t', 2, &o2, &l2)) { *copies += num(t + at + o2, l2); found = 1; }
        at += ln + 1;
    }
    return found;
}
static long base_total(const char *t, long tn, const char *key) {
    char pre[64]; long pl, at = 0;
    if (cx_fmt(pre, sizeof pre, "total\t%s\t", key)) return -1;
    pl = tx_len(pre, 64);
    while (at < tn) {
        long e = tx_chr(t + at, tn - at, '\n'), ln = e < 0 ? tn - at : e;
        if (ln > pl && mm_same(t + at, pre, pl)) return num(t + at + pl, ln - pl);
        at += ln + 1;
    }
    return -1;
}

static int dc_find_or_add_file(const char *path) {
    int f; long pl = tx_len(path, 1300), rl = tx_len(root, 1200);
    const char *rel = path;
    size_t m = 0; char *b;
    if (rl > 0 && pl > rl + 1 && mm_same(path, root, rl) && path[rl] == '/') rel = path + rl + 1;
    for (f = 0; f < nf; f++) {
        if (tx_eqz(fname[f], rel) || tx_eqz(fname[f], path)) return f;
    }
    if (nf >= MAXF) return -1;
    b = cx_read(path, &m);
    if (!b) return -1;
    fname[nf] = mm_alloc(pl + 1);
    if (!fname[nf]) { mm_free(b); return -1; }
    mm_copy(fname[nf], pl + 1, path, pl + 1);
    fbuf[nf] = b; flen[nf] = (long)m;
    nf++;
    return nf - 1;
}

static void dc_print_anon_groups(void) {
    int g, t;
    for (g = 0; g < nag; g++) {
        printf("ANON_GROUP\t");
        for (t = 0; t < ag_copies[g]; t++) {
            int e = amem[ag_i0[g] + t], prev = 0, u;
            for (u = 0; u < t; u++) {
                if (!ncmp(amem[ag_i0[g] + u], e)) { prev = 1; break; }
            }
            if (prev) continue;
            if (t > 0) printf(",");
            printf("%.*s", (int)e_nl[e], fbuf[e_file[e]] + e_ns[e]);
        }
        printf("\t%d\t%d\t%ld\n", ag_copies[g], ag_lines[g], (long)(ag_copies[g] - 1) * ag_lines[g]);
    }
    printf("DUP_ANON\tgroups=%d\tdefs=%ld\tredundant=%ld\n", nag, s_adefs, s_ared);
}

int main(int argc, char **argv) {
    int mode = 0, a, g, h, target_fi = -1; char bpath[1300]; const char *where = 0, *hint_file = 0;
    for (a = 1; a < argc; a++) {
        if (tx_eqz(argv[a], "--print")) mode = 0;
        else if (tx_eqz(argv[a], "--check")) mode = 1;
        else if (tx_eqz(argv[a], "--write")) mode = 2;
        else if (tx_eqz(argv[a], "--where") && a + 1 < argc) { mode = 3; where = argv[++a]; }
        else if (tx_eqz(argv[a], "--list-hints")) mode = 4;
        else if (tx_eqz(argv[a], "--hint-file") && a + 1 < argc) { mode = 5; hint_file = argv[++a]; }
        else if (tx_eqz(argv[a], "--root") && a + 1 < argc) root = argv[++a];
        else { fprintf(stderr, "usage: tools/dup-census.cx [--print | --check | --write | --where NAME | --hint-file PATH | --list-hints] [--root DIR]\n"); return 2; }
    }
    if (mode == 4) {
        for (a = 0; a < NHINTS; a++) printf("HINT_ENTRY\t%s\t%s\t%s\n", dc_hints[a][0], dc_hints[a][1], dc_hints[a][2]);
        return 0;
    }
    if (list_dir("tools")) { fprintf(stderr, "dup-census: cannot list %s/tools\n", root); return 2; }
    list_dir("tools/cxlib");   /* optional */
    if (mode == 5) {
        target_fi = dc_find_or_add_file(hint_file);
        if (target_fi < 0) { fprintf(stderr, "dup-census: cannot read %s\n", hint_file); return 2; }
    }
    if (dc_wl_load(root)) return 2;
    census();
    if (mode == 5) {
        int e, o;
        for (e = 0; e < ne; e++) {
            const char *nm; long nl; int hi;
            if (e_file[e] != target_fi) continue;
            nm = fbuf[e_file[e]] + e_ns[e]; nl = e_nl[e];
            hi = dc_hint_for(nm, nl);
            if (hi >= 0) printf("DUP_HINT\talt\t%.*s\t%s\t%s\n", (int)nl, nm, dc_hints[hi][1], dc_hints[hi][2]);
            for (o = 0; o < ne; o++) {
                if (e_file[o] == target_fi) continue;
                if (same_body_anon(e, o)) {
                    printf("DUP_HINT\tdup\t%.*s\t%s\t%.*s\n", (int)nl, nm, fname[e_file[o]], (int)e_nl[o], fbuf[e_file[o]] + e_ns[o]);
                    break;
                }
            }
        }
        return 0;
    }
    if (cx_fmt(bpath, sizeof bpath, "%s/build/dup-census-baseline.tsv", root)) return 2;
    if (mode == 3) {   /* --where NAME: the files of every verbatim group of that name, one row per copy */
        for (g = 0; g < ng; g++) {
            const char *s; long l; int t; gname(g, &s, &l);
            if (l != tx_len(where, 256) || !mm_same(s, where, l)) continue;
            for (t = 0; t < g_copies[g]; t++) printf("WHERE\t%s\t%d\t%s\n", where, g, fname[e_file[idx[g_i0[g] + t]]]);
        }
        return 0;
    }
    if (mode == 0) {
        int wl_groups = 0;
        for (g = 0; g < ng; g++) { const char *s; long l; gname(g, &s, &l); printf("GROUP\t%.*s\t%d\t%d\t%ld\t%ld\n", (int)l, s, g_copies[g], g_lines[g], (long)g_copies[g] * g_lines[g], (long)(g_copies[g] - 1) * g_lines[g]); }
        for (g = 0; g < ng; g = h) {
            const char *s; long l, copies = 0, wred = 0;
            gname(g, &s, &l);
            for (h = g; h < ng; h++) {
                const char *s2; long l2; gname(h, &s2, &l2);
                if (l2 != l || !mm_same(s, s2, l)) break;
                copies += g_copies[h];
                wred += (long)(g_copies[h] - 1) * g_lines[h];
            }
            if (dc_wl_has(s, l)) {
                wl_groups += h - g;
                printf("WHITELIST\t%.*s\twhitelisted=%d\tcopies=%ld\tredundant=%ld\n", (int)l, s, h - g, copies, wred);
            }
        }
        for (a = 0; a < NFRAG; a++) printf("FRAG\t%s\t%ld\t%d\n", frag[a][0], fr_occ[a], fr_files[a]);
        if (wl_groups > 0)
            printf("DUP_SUMMARY files=%d static_fn=%d dup_names=%ld dup_defs=%ld excess_lines=%ld verbatim_groups=%d verbatim_defs=%ld verbatim_lines=%ld verbatim_redundant=%ld whitelisted=%d\n",
                   nf, ne, s_dupnames, s_dupdefs, s_excess, ng, s_vdefs, s_vlines, s_vred, wl_groups);
        else
            printf("DUP_SUMMARY files=%d static_fn=%d dup_names=%ld dup_defs=%ld excess_lines=%ld verbatim_groups=%d verbatim_defs=%ld verbatim_lines=%ld verbatim_redundant=%ld\n",
                   nf, ne, s_dupnames, s_dupdefs, s_excess, ng, s_vdefs, s_vlines, s_vred);
        dc_print_anon_groups();
        return 0;
    }
    if (mode == 2) {
        long cap = 256 + (long)ng * 160, on; char *ob = mm_alloc(cap);
        if (!ob || cx_fmt(ob, cap, "# tools/dup-census.cx --write: verbatim duplicate groups, only go down (15th ratchet)\ntotal\tverbatim_groups\t%d\ntotal\tverbatim_redundant\t%ld\n", ng, s_vred)) return 2;
        on = tx_len(ob, cap);
        for (g = 0; g < ng; g++) { const char *s; long l; gname(g, &s, &l); if (cx_fmt(ob + on, cap - on, "group\t%.*s\t%d\t%d\n", (int)l, s, g_copies[g], g_lines[g])) return 2; on += tx_len(ob + on, cap - on); }
        if (cx_write(bpath, ob, on)) { fprintf(stderr, "dup-census: cannot write %s\n", bpath); return 2; }
        printf("DUP_CENSUS_WRITE\tgroups=%d\tredundant=%ld\n", ng, s_vred);
        return 0;
    }
    {   size_t m = 0; char *t = cx_read(bpath, &m); long bg, br, wl_red = 0, base_wl_r = 0, eff_bg, eff_vred, eff_br;
        int nw = 0, gr = 0, wl_groups = 0, base_wl_g = 0, eff_ng, bad;
        if (!t) { fprintf(stderr, "dup-census: cannot read %s\n", bpath); return 2; }
        bg = base_total(t, (long)m, "verbatim_groups"); br = base_total(t, (long)m, "verbatim_redundant");
        if (bg < 0 || br < 0) { fprintf(stderr, "dup-census: baseline lacks total rows\n"); return 2; }
        dc_wl_base(t, (long)m, &base_wl_g, &base_wl_r);
        for (g = 0; g < ng; g = h) {
            const char *s; long l, copies = 0, wred = 0, bc = 0; int found;
            gname(g, &s, &l);
            for (h = g; h < ng; h++) {
                const char *s2; long l2; gname(h, &s2, &l2);
                if (l2 != l || !mm_same(s, s2, l)) break;
                copies += g_copies[h];
                wred += (long)(g_copies[h] - 1) * g_lines[h];
            }
            if (dc_wl_has(s, l)) { wl_groups += h - g; wl_red += wred;
                printf("dup-census: %.*s whitelisted=%d (copies=%ld)\n", (int)l, s, h - g, copies);
                continue;
            }
            found = base_find(t, (long)m, s, l, &bc);
            if (!found || copies > bc) {
                int hi = dc_hint_for(s, l);
                printf("dup-census: %.*s has %ld verbatim copies, baseline %ld\n", (int)l, s, copies, bc);
                if (hi >= 0) printf("dup-census: hint: %.*s -> %s (%s)\n", (int)l, s, dc_hints[hi][1], dc_hints[hi][2]);
                if (found) gr++; else nw++;
            }
        }
        eff_ng = ng - wl_groups; eff_bg = bg - base_wl_g;
        eff_vred = s_vred - wl_red; eff_br = br - base_wl_r;
        if (eff_vred > eff_br) printf("dup-census: tools total lines verbatim_redundant %ld, baseline %ld\n", eff_vred, eff_br);
        bad = nw || gr || eff_ng > eff_bg || eff_vred > eff_br;
        if (bad) printf("dup-census: FAIL: new=%d grown=%d groups=%d baseline=%ld redundant=%ld baseline=%ld whitelisted=%d\n", nw, gr, eff_ng, eff_bg, eff_vred, eff_br, wl_groups);
        else printf("dup-census: ok: verbatim_groups=%d (baseline %ld) verbatim_redundant=%ld (baseline %ld) whitelisted=%d\n", eff_ng, eff_bg, eff_vred, eff_br, wl_groups);
        if (nag > 0) printf("dup-census: info: anon_groups=%d anon_defs=%ld anon_redundant=%ld\n", nag, s_adefs, s_ared);
        return bad ? 1 : 0;
    }
}
