/* tools/check-libc-decl-scan.cx -- tools/libc-decl-scan.cx 的检查:夹具头里验证声明/宏/类型/重复/注释干扰/空头/篡改检测,并核对仓内 build/libc-decls.tsv 一致。
 *
 *   sh ./unisacc.com tools/check-libc-decl-scan.cx
 */
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.posix
#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use mem.bytes
#pragma unisa use mem.heap

static int failed, nok;
static char dir[320];
static void ck(int ok, const char *name) {
    if (ok) { nok++; sy_printf("PASS\tcheck-libc-decl-scan.%s\n", name); }
    else { failed++; sy_printf("FAIL\tcheck-libc-decl-scan.%s\n", name); }
}
static void put(const char *rel, const char *body) {
    char p[500];
    cx_fmt(p, sizeof p, "%s/%s", dir, rel);
    cx_write(p, body, tx_len(body, 100000));
}
static int run(const char *root, const char *mode, char *out, long cap) {
    char cmd[900]; char *o = 0; size_t n = 0; int rc;
    cx_fmt(cmd, sizeof cmd, "sh ./unisacc.com tools/libc-decl-scan.cx -- %s --root %s", mode, root);
    char *v[] = {"sh", "-c", cmd, 0};
    rc = cx_runv_timeout(v, 50, &o, &n);
    out[0] = 0; if (o && (long)n < cap) { mm_copy(out, cap, o, n); out[n] = 0; }
    return rc;
}
/* 完整行匹配: 行 ROW(不含换行)是否存在于 T,返回出现次数 */
static int rowcount(const char *t, long n, const char *row) {
    long rl = tx_len(row, 1000), i = 0; int c = 0;
    while (i < n) {
        long e = i;
        while (e < n && t[e] != '\n') e++;
        if (e - i == rl && mm_same(t + i, row, rl)) c++;
        i = e + 1;
    }
    return c;
}
static long rowpos(const char *t, long n, const char *row) {
    long rl = tx_len(row, 1000), i = 0;
    while (i < n) {
        long e = i;
        while (e < n && t[e] != '\n') e++;
        if (e - i == rl && mm_same(t + i, row, rl)) return i;
        i = e + 1;
    }
    return -1;
}
static int lines(const char *t, long n) { long i; int c = 0; for (i = 0; i < n; i++) c += t[i] == '\n'; return c; }
static int hasl(const char *h, const char *lit) {
    long hn = tx_len(h, 100000), ln = tx_len(lit, 4096), i;
    if (hn < 0) hn = 100000; /* 超 cap:只查 cap 内,不把 -1 当长度 */
    for (i = 0; i + ln <= hn; i++) if (h[i] == lit[0] && mm_same(h + i, lit, ln)) return 1;
    return 0;
}
static void mk(const char *rel) { char p[500]; cx_fmt(p, sizeof p, "%s/%s", dir, rel); mkdir(p, 0700); }

int main(void) {
    char out[8192]; long n = 0; char *t; char p[500];
    int rc;
    if (cx_fmt(dir, sizeof dir, "%s/libc-decl-check-XXXXXX", sy_tmpdir()) || !mkdtemp(dir)) { ck(0, "tmpdir"); return 1; }
    mk("include"); mk("build"); mk("exec"); mk("exec/facts");
    put("exec/facts/libc99posix.tsv", "# name\tsignature\nopen\tint open(const char *,int,...)\nread\tssize_t read(int,void *,size_t)\n");
    put("include/a.h",
        "/* comment int fake(int); */\n#ifndef A_H\n#define A_H\n#define FOO 1\n#define BAR(x) ((x)+1)\n#define FOO 2\n"
        "typedef unsigned long size_t;\ntypedef int (*cb_t)(int);\ntypedef struct { int a; } st_t;\n"
        "int open(const char *, int, ...);\nstatic int helper(int x) { return x; }\nint open(const char *, int, ...);\n"
        "extern int var;\nstruct s { int (*fp)(int); };\nconst char *s = \"int strfake(void);\";\n// int linefake(void);\n#endif\n");
    put("include/b.h", "#define BAZ 3\nint read(int);\n#define LONGM(a) \\\n    ((a) + 1)\nint after_cont(void);\n");
    put("include/empty.h", "");
    rc = run(dir, "--write", out, sizeof out);
    ck(rc == 0 && hasl(out, "WROTE\trows=11\tno=9\theaders=3"), "write-summary");
    rc = run(dir, "--check", out, sizeof out);
    ck(rc == 0 && hasl(out, "OK\tbuild/libc-decls.tsv"), "check-ok");
    cx_fmt(p, sizeof p, "%s/build/libc-decls.tsv", dir);
    { size_t m = 0; t = cx_read(p, &m); n = (long)m; }
    if (!t) { ck(0, "read-output"); return 1; }
    ck(rowcount(t, n, "# header\tname\tkind\tin_libc99posix\tline") == 1 && rowpos(t, n, "# header\tname\tkind\tin_libc99posix\tline") == 0, "header-first");
    ck(rowcount(t, n, "a.h\tFOO\tmacro\tno\t4") == 1, "macro-first-line");
    ck(rowcount(t, n, "a.h\tFOO\tmacro\tno\t6") == 0, "macro-duplicate-dropped");
    ck(rowcount(t, n, "a.h\tBAR\tmacro\tno\t5") == 1, "function-like-macro");
    ck(rowcount(t, n, "a.h\tA_H\tmacro\tno\t3") == 0, "include-guard-skipped");
    ck(rowcount(t, n, "a.h\tsize_t\ttype\tno\t7") == 1, "typedef-plain");
    ck(rowcount(t, n, "a.h\tcb_t\ttype\tno\t8") == 1, "typedef-function-pointer");
    ck(rowcount(t, n, "a.h\tst_t\ttype\tno\t9") == 1, "typedef-struct-body");
    ck(rowcount(t, n, "a.h\topen\tfunc\tyes\t10") == 1, "func-in-facts-yes");
    ck(rowcount(t, n, "a.h\topen\tfunc\tyes\t12") == 0, "func-duplicate-dropped");
    ck(rowcount(t, n, "a.h\thelper\tfunc\tno\t11") == 1, "static-definition-counted-as-func");
    ck(!hasl(t, "\tfake\t"), "block-comment-ignored");
    ck(!hasl(t, "strfake"), "string-literal-ignored");
    ck(!hasl(t, "linefake"), "line-comment-ignored");
    ck(!hasl(t, "\tvar\t") && !hasl(t, "\tfp\t"), "variables-and-members-ignored");
    ck(rowcount(t, n, "b.h\tBAZ\tmacro\tno\t1") == 1, "second-header-macro");
    ck(rowcount(t, n, "b.h\tread\tfunc\tyes\t2") == 1, "second-header-func-yes");
    ck(rowcount(t, n, "b.h\tLONGM\tmacro\tno\t3") == 1 && rowcount(t, n, "b.h\tafter_cont\tfunc\tno\t5") == 1, "continuation-line-counted");
    ck(!hasl(t, "empty.h"), "empty-header-no-rows");
    ck(rowpos(t, n, "a.h\tFOO\tmacro\tno\t4") < rowpos(t, n, "b.h\tBAZ\tmacro\tno\t1"), "header-order-bytewise");
    ck(lines(t, n) == 12, "row-count");
    put("build/libc-decls.tsv", "tampered\n");
    rc = run(dir, "--check", out, sizeof out);
    ck(rc == 1 && hasl(out, "DIFF\tbuild/libc-decls.tsv"), "tamper-detected");
    rc = run(dir, "--summary", out, sizeof out);
    ck(rc == 0 && hasl(out, "TOTAL\trows=11\tno=9") && hasl(out, "GAP\ta.h\tno=6\tall=7"), "summary-gap");
    {
        char e[320];
        cx_fmt(e, sizeof e, "%s/empty-root", dir);
        mkdir(e, 0700);
        cx_fmt(p, sizeof p, "%s/build", e); mkdir(p, 0700);
        rc = run(e, "--write", out, sizeof out);
        ck(rc == 0 && hasl(out, "rows=0"), "missing-include-dir-header-only");
    }
    rc = run(dir, "--bogus", out, sizeof out);
    ck(rc == 2, "usage-rc2");
    rc = run(".", "--check", out, sizeof out);
    ck(rc == 0, "repo-table-current");
    sy_printf("LIBC_DECL_SCAN\tok=%d\tfailed=%d\n", nok, failed);
    return failed ? 1 : 0;
}
