/* tools/check-flowrun.cx -- tools/flowrun.cx and the engine tools/cxlib/flowexec.cx.
 *
 *   sh ./unisacc.com tools/check-flowrun.cx      (from the repo root; work dir $TMPDIR/check-flowrun-<pid>)
 *
 * Every case really runs flowrun as a child (bounded 50 s) on a flow file written here:
 *   parallel          two `sleep 1` exec nodes: engine wall_ms < 1800 and peak=2
 *   dep-order         the dependent node starts after both dependencies ended ok
 *   events            RUN/events.tsv equals the EVT lines on stdout, seq 1..N in order, no extra line,
 *                     start before end for each node
 *   node-output-file  RUN/out/<id>.out holds the child's stdout
 *   fail-skip         a failed node: its dependents are skip with dep=<id>:<state> and never
 *                     executed (their marker files are absent); an independent node still runs; rc 1
 *   fail-rc-and-stderr  the fail event carries the exit code, RUN/out/<id>.err the stderr
 *   timeout-event     timeout_ms: node is timeout rc 124, its dependent is skip
 *   timeout-kill-tree the grandchild (a background sleep 30) is gone from /proc after the group kill
 *   timeout-keeps-output  what the child wrote before the kill is in RUN/out/<id>.out
 *   deadline          --deadline-ms kills every running node (timeout) and skips the rest
 *   lock-serial-exec  two exec nodes with the same lock never overlap (peak=1, wall >= the sum)
 *   file-write-serial two file.write nodes on one path (real cxlib.flowfile) run one after the
 *                     other and a dependent file.read sees the second content
 *   file-fail-skip    a refused file.write (no root) is fail with flowfile's reason, dependent skip
 *   cycle, unknown-dep, dup-id, bad-option   named refusals rc 2, nothing run
 *   dry               ORDER lines in dependency order, nothing run
 *   exec-args         cwd, env (appended), stdin file reach the child; argv is not shell-split
 * Prints PASS/FAIL per case and CHECK_FLOWRUN<TAB>failed=N. */
#pragma unisa use sys.time
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.sig
#pragma unisa use text.text
#pragma unisa use mem.heap

/* ARGV under cx_runv_timeout (SECS, process group killed on expiry), stdout and stderr merged into OUT. */
static int bounded_run(char **argv, int secs, char *out, int cap) {
    char *w[64], *b = 0;
    size_t n = 0, j;
    int k = 0, i, rc;
    w[k++] = "sh"; w[k++] = "-c"; w[k++] = "exec \"$@\" 2>&1"; w[k++] = "sh";
    for (i = 0; argv[i] && k < 63; i++) w[k++] = argv[i];
    if (argv[i]) return -E2BIG;
    w[k] = 0;
    rc = cx_runv_timeout(w, secs, &b, &n);
    if (n > (size_t)cap - 1) n = (size_t)cap - 1;
    for (j = 0; b && j < n; j++) out[j] = b[j];
    out[b ? n : 0] = 0;
    free(b);
    return rc;
}

static int failed;
static void ck(int ok, const char *name) { if (ok) sy_printf("PASS\tcheck-flowrun.%s\n", name); else { failed++; sy_printf("FAIL\tcheck-flowrun.%s\n", name); } }
static void die(const char *s) { sy_eprintf("check-flowrun: REFUSE %s\n", s); sy_exit(2); }
static long pos(const char *s, const char *w) { return tx_find(s, tx_len(s, 1 << 20), w, tx_len(w, 1 << 16)); }
static int has(const char *s, const char *w) { return pos(s, w) >= 0; }
static long numafter(const char *s, const char *key) { long p = pos(s, key), v = 0; if (p < 0) return -1; p += tx_len(key, 128); while (s[p] >= '0' && s[p] <= '9') v = v * 10 + (s[p++] - '0'); return v; }
static char root[4096], com[4500], tool[4500], wd[1024];
/* run: --par is mandatory, so add `--par 8` when the case gives neither --par nor --jobs; run_raw adds nothing */
static int run_raw(char **args, char *out, int cap) { char *v[24]; int k = 0; v[k++] = "sh"; v[k++] = com; v[k++] = tool; v[k++] = "--"; for (; *args && k < 21; args++) v[k++] = *args; v[k] = 0; return bounded_run(v, 50, out, cap); }
static int run(char **args, char *out, int cap) {
    char *v[24]; int k = 0, i, given = 0;
    for (i = 0; args[i] && k < 21; i++) { v[k++] = args[i]; if (tx_eqz(args[i], "--par") || tx_eqz(args[i], "--jobs")) given = 1; }
    if (!given) { v[k++] = "--par"; v[k++] = "8"; }
    v[k] = 0;
    return run_raw(v, out, cap);
}
static char *rd(const char *name) {
    static char p[8][1200]; static int k; char *q = p[k++ & 7];
    if (cx_fmt(q, 1200, "%s/%s", wd, name)) die("path");
    return q;
}
static char *wf(const char *name, const char *text) {
    char *q = rd(name);
    if (sy_write_file(q, text, tx_len(text, 1 << 16), 0644)) die("cannot write flow file");
    return q;
}
static char *slurp(const char *path) { unsigned char *b = 0; int64_t n = 0; return sy_read_file(path, &b, &n, 1L << 20) ? 0 : (char *)b; }
/* 1 when PID no longer runs: no /proc entry, or a killed process nobody has reaped yet (state Z or X
   in /proc/PID/stat).  Under tools/bound (a child subreaper, the batch runner's wrapper) the orphaned
   grandchild is adopted by bound and stays a zombie until bound ends, so "absent from /proc" alone
   would call a dead process alive. */
static int proc_dead(long pid) {
    char p[64], *t; long i, close = -1; int z;
    cx_fmt(p, sizeof p, "/proc/%ld", pid);
    if (sy_exists(p) == 0) return 1;
    cx_fmt(p, sizeof p, "/proc/%ld/stat", pid);
    t = slurp(p);
    if (!t) return 0;
    for (i = 0; t[i]; i++) if (t[i] == ')') close = i;
    z = close >= 0 && t[close + 1] == ' ' && (t[close + 2] == 'Z' || t[close + 2] == 'X');
    mm_free(t);
    return z;
}

int main(void) {
    int cap = (int)(1L << 20), rc;
    char *out = mm_alloc(1L << 20), buf[4096], *ev, *t;
    if (!out) die("out of memory");
    if (sy_cwd(root, (int)sizeof root) < 0 || cx_fmt(com, sizeof com, "%s/unisacc.com", root)
        || cx_fmt(tool, sizeof tool, "%s/tools/flowrun.cx", root)) die("paths");
    if (cx_fmt(wd, sizeof wd, "%s/check-flowrun-%d", sy_tmpdir(), (int)getpid())) die("work dir");
    rc = sy_mkdir(wd, 0755);
    if (rc < 0 && rc != -EEXIST) die("cannot make work dir");

    {   /* parallel + dependency order + event stream */
        char *a[] = {"run", wf("par.tsv",
            "# two sleepers, one join\n"
            "a\texec\t-\ta0=sleep;a1=1\n"
            "b\texec\t-\ta0=sleep;a1=1\n"
            "c\texec\ta,b\ta0=echo;a1=joined\n"), "--run", rd("par"), 0};
        long w;
        rc = run(a, out, cap); w = numafter(out, "\twall_ms=");
        ck(rc == 0 && w >= 1000 && w < 1800 && has(out, "\tpeak=2\t") && has(out, "FLOW_RUN\tnodes=3\tok=3\tfail=0\ttimeout=0\tskip=0\t"), "parallel");
        ck(rc == 0 && pos(out, "\ta\tok\t") > 0 && pos(out, "\tb\tok\t") > 0 && pos(out, "\tc\tstart\t") > pos(out, "\ta\tok\t")
           && pos(out, "\tc\tstart\t") > pos(out, "\tb\tok\t") && pos(out, "\tc\tok\t") > pos(out, "\tc\tstart\t"), "dep-order");
        cx_fmt(buf, sizeof buf, "%s/par/events.tsv", wd); ev = slurp(buf);
        {   int ok = ev != 0, i; char key[32]; long last = -1, evn = ev ? tx_len(ev, 1 << 20) : 0;
            for (i = 1; ok && i <= 6; i++) { long p; cx_fmt(key, sizeof key, "EVT\t%d\t", i); p = pos(ev, key); if (p <= last) ok = 0; last = p; }
            if (ok && pos(ev, "EVT\t7\t") >= 0) ok = 0;
            if (ok && !(pos(out, ev) == 0 && pos(out + evn, "FLOW_RUN\t") == 0)) ok = 0;   /* stdout = the event file, then the summary */
            if (ok && !(pos(ev, "\ta\tstart\t") < pos(ev, "\ta\tok\t") && pos(ev, "\tb\tstart\t") < pos(ev, "\tb\tok\t"))) ok = 0;
            ck(ok, "events");
        }
        if (ev) mm_free(ev);
        cx_fmt(buf, sizeof buf, "%s/par/out/c.out", wd); t = slurp(buf);
        ck(t && tx_eqz(t, "joined\n"), "node-output-file");
        if (t) mm_free(t);
    }
    {   /* --par is mandatory: missing refused rc 2, a `par N` line or --par 1 for one node runs, --par 8 overlaps */
        char *a[] = {"run", wf("one.tsv", "a\texec\t-\ta0=true\n"), "--run", rd("nopar"), 0};
        rc = run_raw(a, out, cap);
        ck(rc == 2 && has(out, "flowrun: REFUSE missing --par"), "missing-par-refused");
    }
    {   char *a[] = {"run", rd("one.tsv"), "--par", "1", "--run", rd("par1"), 0};
        rc = run_raw(a, out, cap);
        ck(rc == 0 && has(out, "FLOW_RUN\tnodes=1\tok=1\t") && has(out, "\tjobs=1\t"), "par1-single-node");
    }
    {   char *a[] = {"run", wf("pline.tsv", "par 3\na\texec\t-\ta0=true\n"), "--run", rd("pline"), 0};
        rc = run_raw(a, out, cap);
        ck(rc == 0 && has(out, "\tjobs=3\t"), "par-line-declares");
    }
    {   char *a[] = {"run", rd("pline.tsv"), "--par", "2", "--run", rd("pline2"), 0};
        rc = run_raw(a, out, cap);
        ck(rc == 0 && has(out, "\tjobs=2\t"), "par-cli-wins-over-line");
    }
    {   char *a[] = {"run", rd("one.tsv"), "--par", "33", "--run", rd("par33"), 0};
        rc = run_raw(a, out, cap);
        ck(rc == 2 && has(out, "REFUSE --par wants a number 1..32"), "par-over-32-refused");
    }
    {   char *a[] = {"run", wf("p8.tsv", "a\texec\t-\ta0=sleep;a1=0.5\nb\texec\t-\ta0=sleep;a1=0.5\nc\texec\t-\ta0=sleep;a1=0.5\n"), "--par", "8", "--run", rd("par8"), 0};
        rc = run_raw(a, out, cap);
        ck(rc == 0 && numafter(out, "\tpeak=") > 1, "par8-peak-above-1");
    }
    {   /* failure propagates as skip; skipped nodes do not execute */
        char text[4096], *a[] = {"run", 0, "--run", rd("fail"), 0};
        cx_fmt(text, sizeof text,
            "f\texec\t-\ta0=sh;a1=-c;a2=echo oops >&2%%3B exit 7\n"
            "g\texec\tf\ta0=touch;a1=%s/g-ran\n"
            "h\texec\tg\ta0=touch;a1=%s/h-ran\n"
            "i\texec\t-\ta0=touch;a1=%s/i-ran\n", wd, wd, wd);
        a[1] = wf("fail.tsv", text);
        rc = run(a, out, cap);
        ck(rc == 1 && has(out, "\tf\tfail\t")
           && has(out, "\tg\tskip\t0\t-1\tdep=f:fail") && has(out, "\th\tskip\t0\t-1\tdep=g:skip") && has(out, "\ti\tok\t")
           && !has(out, "\tg\tstart\t") && !has(out, "\th\tstart\t")
           && has(out, "FLOW_RUN\tnodes=4\tok=1\tfail=1\ttimeout=0\tskip=2\t")
           && sy_exists(rd("g-ran")) == 0 && sy_exists(rd("h-ran")) == 0 && sy_exists(rd("i-ran")) == 1, "fail-skip");
        cx_fmt(buf, sizeof buf, "%s/fail/out/f.err", wd); t = slurp(buf);
        ck(t && tx_eqz(t, "oops\n") && has(out, "\t7\tout=0 err=5 first=oops\n"), "fail-rc-and-stderr");
        if (t) mm_free(t);
    }
    {   /* node timeout: group kill takes the grandchild too; earlier output is kept */
        char text[4096], *a[] = {"run", 0, "--run", rd("to"), 0}; long w, pid = 0; int gone = 0, alive_before = 0, i;
        cx_fmt(text, sizeof text,
            "t\texec\t-\ttimeout_ms=400;a0=sh;a1=-c;a2=echo partial%%3B sleep 30 & echo $! > %s/gpid%%3B wait\n"
            "u\texec\tt\ta0=true\n", wd);
        a[1] = wf("to.tsv", text);
        rc = run(a, out, cap); w = numafter(out, "\twall_ms=");
        t = slurp(rd("gpid"));
        if (t) { pid = atol(t); mm_free(t); alive_before = pid > 1; }
        if (pid > 1) for (i = 0; i < 100 && !gone; i++) {   /* bounded wait 1 s */
            if (proc_dead(pid)) gone = 1; else sy_sleep_ms(10);
        }
        ck(rc == 1 && has(out, "\tt\ttimeout\t") && has(out, "\t124\ttimeout_ms=400, process group killed out=8 ") && w >= 400 && w < 3000
           && has(out, "\tu\tskip\t0\t-1\tdep=t:timeout"), "timeout-event");
        ck(alive_before && gone, "timeout-kill-tree");
        cx_fmt(buf, sizeof buf, "%s/to/out/t.out", wd); t = slurp(buf);
        ck(t && tx_eqz(t, "partial\n"), "timeout-keeps-output");
        if (t) mm_free(t);
    }
    {   /* run deadline: all running nodes killed, the rest skipped */
        char *a[] = {"run", wf("dl.tsv",
            "p\texec\t-\ta0=sleep;a1=30\n"
            "q\texec\t-\ta0=sleep;a1=30\n"
            "r\texec\tp\ta0=true\n"), "--run", rd("dl"), "--deadline-ms", "500", 0};
        long w;
        rc = run(a, out, cap); w = numafter(out, "\twall_ms=");
        ck(rc == 1 && has(out, "\tp\ttimeout\t") && has(out, "\tq\ttimeout\t") && has(out, "\t124\trun deadline 500 ms, process group killed")
           && has(out, "\tr\tskip\t") && w >= 500 && w < 3000 && has(out, "\tok=0\tfail=0\ttimeout=2\tskip=1\t"), "deadline");
    }
    {   /* same lock: never at once */
        char *a[] = {"run", wf("lock.tsv",
            "x1\texec\t-\tlock=L;a0=sleep;a1=0.4\n"
            "x2\texec\t-\tlock=L;a0=sleep;a1=0.4\n"), "--run", rd("lock"), 0}; long w;
        rc = run(a, out, cap); w = numafter(out, "\twall_ms=");
        ck(rc == 0 && w >= 800 && has(out, "\tpeak=1\t")
           && ((pos(out, "\tx1\tok\t") < pos(out, "\tx2\tstart\t")) || (pos(out, "\tx2\tok\t") < pos(out, "\tx1\tstart\t"))), "lock-serial-exec");
    }
    {   /* file nodes through the real cxlib.flowfile: same path is serial, content escapes decode */
        char text[4096], *a[] = {"run", 0, "--run", rd("file"), 0};
        cx_fmt(text, sizeof text,
            "w1\tfile.write\t-\troot=%s;path=shared.txt;content=one%%0A\n"
            "w2\tfile.write\t-\troot=%s;path=shared.txt;content=two%%3B%%09x%%0A\n"
            "r1\tfile.read\tw1,w2\tpath=%s/shared.txt\n"
            "s1\texec\t-\ta0=sleep;a1=0.2\n", wd, wd, wd);
        a[1] = wf("file.tsv", text);
        rc = run(a, out, cap);
        cx_fmt(buf, sizeof buf, "%s/file/out/r1.out", wd); t = slurp(buf);
        ck(rc == 0 && t && tx_eqz(t, "two;\tx\n") && pos(out, "\tw1\tok\t") > 0 && pos(out, "\tw1\tok\t") < pos(out, "\tw2\tstart\t")
           && pos(out, "\tw2\tok\t") < pos(out, "\tr1\tstart\t") && has(out, "FLOW_RUN\tnodes=4\tok=4\t"), "file-write-serial");
        if (t) mm_free(t);
    }
    {   /* a refused file node fails with flowfile's reason and its dependent is skipped */
        char text[4096], *a[] = {"run", 0, "--run", rd("ffail"), 0};
        cx_fmt(text, sizeof text,
            "m\tfile.read\t-\tpath=%s/no-such-file\n"
            "n\texec\tm\ta0=touch;a1=%s/n-ran\n", wd, wd);
        a[1] = wf("ffail.tsv", text);
        rc = run(a, out, cap);
        ck(rc == 1 && has(out, "\tm\tfail\t") && has(out, "\t1\tENOENT") && has(out, "\tn\tskip\t0\t-1\tdep=m:fail") && sy_exists(rd("n-ran")) == 0, "file-fail-skip");
    }
    {   char *a[] = {"run", wf("cyc.tsv", "a\texec\tb\ta0=true\nb\texec\ta\ta0=true\nc\texec\t-\ta0=true\n"), "--run", rd("cyc"), 0};
        rc = run(a, out, cap);
        ck(rc == 2 && has(out, "REFUSE dependency cycle among nodes: a b\n") && !has(out, "EVT\t") && sy_exists(rd("cyc")) == 0, "cycle"); }
    {   char *a[] = {"run", wf("unk.tsv", "a\texec\tzz\ta0=true\n"), "--run", rd("unk"), 0};
        rc = run(a, out, cap);
        ck(rc == 2 && has(out, "REFUSE node 'a' depends on unknown node 'zz'") && !has(out, "EVT\t") && sy_exists(rd("unk")) == 0, "unknown-dep"); }
    {   char *a[] = {"run", wf("dup.tsv", "a\texec\t-\ta0=true\na\texec\t-\ta0=true\n"), "--run", rd("dup"), 0};
        rc = run(a, out, cap);
        ck(rc == 2 && has(out, "duplicate node id 'a'") && !has(out, "EVT\t"), "dup-id"); }
    {   char *a[] = {"run", rd("par.tsv"), "--bogus", 0};
        rc = run(a, out, cap);
        ck(rc == 2 && has(out, "REFUSE unknown or incomplete option --bogus") && has(out, "usage: run"), "bad-option"); }
    {   char *a[] = {"--par", "2", "--dry", "run", rd("par.tsv"), 0};
        rc = run(a, out, cap);
        ck(rc == 0 && has(out, "FLOW_DRY"), "opts-before-run"); }
    {   char *a[] = {"run", rd("par.tsv"), "extra", "--par", "1", 0};
        rc = run(a, out, cap);
        ck(rc == 2 && has(out, "REFUSE unexpected word extra"), "extra-word-named"); }
    {   char *a[] = {"run", rd("par.tsv"), "--dry", "--run", rd("dry"), 0};
        rc = run(a, out, cap);
        ck(rc == 0 && pos(out, "ORDER\t1\ta\texec\t-\n") == 0 && has(out, "ORDER\t2\tb\texec\t-\n") && has(out, "ORDER\t3\tc\texec\ta,b\n") && has(out, "FLOW_DRY\tnodes=3")
           && !has(out, "EVT\t") && sy_exists(rd("dry")) == 0, "dry"); }
    {   /* exec args: cwd, env appended, stdin file, argv kept whole (no shell split) */
        char text[4096], *a[] = {"run", 0, "--run", rd("args"), 0};
        cx_fmt(text, sizeof text,
            "e\texec\t-\tcwd=/;env=FLOW_CK=v 1;env=FLOW_CK2=b;stdin=%s/par.tsv;a0=sh;a1=-c;a2=pwd%%3B echo \"$FLOW_CK|$FLOW_CK2|${PATH:+inherited}\"%%3B head -c 5%%3B echo%%3B echo \"$1\";a3=sh;a4=two  words%%3B $(x)\n", wd);
        a[1] = wf("args.tsv", text);
        rc = run(a, out, cap);
        cx_fmt(buf, sizeof buf, "%s/args/out/e.out", wd); t = slurp(buf);
        ck(rc == 0 && t && tx_eqz(t, "/\nv 1|b|inherited\n# two\ntwo  words; $(x)\n"), "exec-args");
        if (t) mm_free(t);
    }
    {   /* --echo-max: a long out is cut and marked, a short one is whole; the node file keeps everything */
        char *a[] = {"run", wf("emax.tsv", "big\texec\t-\ta0=printf;a1=0123456789abcdef\nsmall\texec\t-\ta0=echo;a1=hi\n"), "--run", rd("emax"), "--echo", "--echo-max", "10", 0};
        rc = run(a, out, cap);
        cx_fmt(buf, sizeof buf, "%s/emax/out/big.out", wd); t = slurp(buf);
        ck(rc == 0 && has(out, "ECHO\tbig\tbytes=16\n0123456789\nECHO_TRUNC\tbig\tshown=10\ttotal=16\n") && has(out, "ECHO\tsmall\tbytes=3\nhi\n")
           && !has(out, "ECHO_TRUNC\tsmall") && t && tx_eqz(t, "0123456789abcdef"), "echo-max-trunc");
        if (t) mm_free(t);
    }
    {   char *a[] = {"run", rd("emax.tsv"), "--run", rd("emax2"), "--echo", 0};
        rc = run(a, out, cap);
        ck(rc == 0 && has(out, "ECHO\tbig\tbytes=16\n0123456789abcdef\n") && !has(out, "ECHO_TRUNC"), "echo-default-max-whole"); }
    {   char *a[] = {"run", rd("emax.tsv"), "--run", rd("emax3"), "--echo", "--echo-max", "x", 0};
        rc = run(a, out, cap);
        ck(rc == 2 && has(out, "REFUSE --echo-max") && !has(out, "EVT\t"), "echo-max-bad-value"); }
    {   /* one flow: search a symbol, cross-check against grep (compare set), pipe the matches to wc
           (stdin_node); a differing compare is fail rc 1 and its dependent is skip */
        char text[4096], *a[] = {"run", 0, "--run", rd("demo"), 0};
        cx_fmt(buf, sizeof buf, "%s/src", wd);
        rc = sy_mkdir(buf, 0755);
        if (rc < 0 && rc != -EEXIST) die("cannot make src");
        wf("src/a.c", "int sym_one;\nint other;\nsym_one = 2;\n");
        cx_fmt(text, sizeof text,
            "s\tsearch\t-\tpattern=sym_one;paths=%s/src\n"
            "g\texec\t-\ta0=grep;a1=-rnF;a2=sym_one;a3=%s/src\n"
            "n\texec\ts\tstdin_node=s;a0=wc;a1=-l\n"
            "c\tcompare\ts,g\ta=node:s;b=node:g;mode=set\n"
            "h\texec\t-\ta0=echo;a1=nothing\n"
            "d\tcompare\ts,h\ta=node:s;b=node:h;mode=lines\n"
            "z\texec\td\ta0=touch;a1=%s/z-ran\n", wd, wd, wd);
        a[1] = wf("demo.tsv", text);
        rc = run(a, out, cap);
        cx_fmt(buf, sizeof buf, "%s/demo/out/c.out", wd); t = slurp(buf);
        ck(rc == 1 && has(out, "\tc\tok\t") && t && tx_eqz(t, "same=1\ndiffs=0\nmode=set\n"), "search-compare-agree-with-grep");
        if (t) mm_free(t);
        cx_fmt(buf, sizeof buf, "%s/demo/out/n.out", wd); t = slurp(buf);
        ck(t && numafter(t, "") == 2, "stdin-node-pipe");
        if (t) mm_free(t);
        ck(has(out, "\td\tfail\t") && has(out, "\t1\tEDIFF") && has(out, "\tz\tskip\t0\t-1\tdep=d:fail") && sy_exists(rd("z-ran")) == 0, "compare-diff-fail-skip");
    }
    {   char *a[] = {"run", wf("sn.tsv", "a\texec\t-\ta0=true\nb\texec\t-\tstdin_node=a;a0=cat\n"), "--run", rd("sn"), 0};
        rc = run(a, out, cap);
        ck(rc == 2 && has(out, "REFUSE node 'b' stdin_node 'a' is not one of its deps") && !has(out, "EVT\t") && sy_exists(rd("sn")) == 0, "stdin-node-not-dep"); }
    sy_printf("CHECK_FLOWRUN\tfailed=%d\n", failed);
    mm_free(out);
    return failed ? 1 : 0;
}
