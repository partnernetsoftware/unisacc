/* Finite CX pack applicability observation; never an admission or test PASS. */
#pragma unisa use cxlib.netpack
#pragma unisa use cxlib.kernelsha
#pragma unisa use text.text
static char oldroot[4096],newroot[4096];static int files,dirs,links,delta;static np_buf record;
static int fifo_profile,tapelink_profile,driverdiag_profile;
static void die(const char *s,const char *p){fprintf(stderr,"cxpack-source-delta: REFUSE %s path=%s errno=%d\n",s,p,errno);exit(2);}
static void path(char *p,const char *a,const char *b){int n=snprintf(p,4400,"%s/%s",a,b);if(n<0||n>=4400)die("path-bound",b);}
static void hash(const void *p,size_t n,char h[65]){if(ks_sha256_hex(p,n,h))die("sha256","-");}
static char *readfile(const char *p,size_t *n){struct stat st;if(lstat(p,&st)||!S_ISREG(st.st_mode)||st.st_size<0||st.st_size>268435456)die("regular-file",p);char *s=cx_read(p,n);if(!s||*n!=(size_t)st.st_size)die("read-size",p);return s;}
static int order(const void *a,const void *b){return strcmp(*(char *const *)a,*(char *const *)b);}
static char **entries(const char *p,int *count){DIR *d=opendir(p);if(!d)die("directory",p);char **v=calloc(16384,sizeof *v);if(!v)die("allocation",p);*count=0;
 for(;;){errno=0;struct dirent *e=readdir(d);if(!e){if(errno)die("readdir",p);break;}if(tx_eq(e->d_name, ".", 1L << 20)||tx_eq(e->d_name, "..", 1L << 20))continue;if(*count==16384||strpbrk(e->d_name,"\r\n\t"))die("entry-bound",p);v[*count]=strdup(e->d_name);if(!v[(*count)++])die("allocation",p);}
 if(closedir(d))die("closedir",p);qsort(v,(size_t)*count,sizeof *v,order);return v;
}
static void walk(const char *rel,int depth){
 if(depth>64)die("depth",rel);char a[4400],b[4400],ha[65],hb[65];path(a,oldroot,rel);path(b,newroot,rel);struct stat sa,sb;
 if(lstat(a,&sa)||lstat(b,&sb))die("missing-or-inaccessible",rel);if(sa.st_mode!=sb.st_mode)die("type-or-mode-mismatch",rel);
 np_puts(&record,rel);np_puts(&record,"\t");np_putll(&record,sa.st_mode);
 if(S_ISDIR(sa.st_mode)){dirs++;np_puts(&record,"\n");int na,nb;char **va=entries(a,&na),**vb=entries(b,&nb);if(na!=nb)die("inventory-count",rel);
  for(int i=0;i<na;i++){if(strcmp(va[i],vb[i]))die("inventory-name",rel);char sub[4400];path(sub,rel,va[i]);walk(sub,depth+1);free(va[i]);free(vb[i]);}free(va);free(vb);return;
 }
 if(S_ISLNK(sa.st_mode)){char x[4400],y[4400];ssize_t nx=readlink(a,x,sizeof x),ny=readlink(b,y,sizeof y);if(nx<0||ny<0||nx>=sizeof x||ny>=sizeof y||nx!=ny||memcmp(x,y,(size_t)nx))die("literal-symlink-mismatch",rel);hash(x,(size_t)nx,ha);{ if (cx_fmt(hb, sizeof hb, "%s",ha)) { fprintf(stderr, "cxpack-source-delta: text too long for hb\n"); exit(2); } }links++;}
 else if(S_ISREG(sa.st_mode)){size_t an,bn;char *x=readfile(a,&an),*y=readfile(b,&bn);hash(x,an,ha);hash(y,bn,hb);
  if(driverdiag_profile){
   if(tx_eq(rel, "exec/c/compiler.c", 1L << 20)){if(strcmp(ha,"cd0680d13b3251c62215f94db3aa757974379bd80a6f601ea3e9ce43989b2d04")||strcmp(hb,"5abb0daa38f80ef81f13f1e934ebcb5eeed1aae7d25ae661fe032fe3ab220c19"))die("unapproved-driverdiag-source-pair",rel);delta++;}
   else if(tx_eq(rel, "src/tapelink.c", 1L << 20)){if(strcmp(ha,"abca60c309919cdebaaac13a2c11f2193729d5e2b99a18118592398fa89967db")||strcmp(hb,"4eb4b8bdb875c03503dca1289343194410fa6e6d1531a64faa951b0099c1d531"))die("unapproved-driverdiag-source-pair",rel);delta++;}
   else if(an!=bn||memcmp(x,y,an))die("unexpected-content-delta",rel);
  }
  else if(tapelink_profile){
   if(tx_eq(rel, "src/tapelink.c", 1L << 20)){if(strcmp(ha,"16925f6467ed351302a1854023d670f75412b72d90f09a19c3ca5c46d2b13ea4")||strcmp(hb,"abca60c309919cdebaaac13a2c11f2193729d5e2b99a18118592398fa89967db"))die("unapproved-tapelink-source-pair",rel);delta++;}
   else if(an!=bn||memcmp(x,y,an))die("unexpected-content-delta",rel);
  }
  else if(fifo_profile){
   if(tx_eq(rel, "src/main.c", 1L << 20)){if(strcmp(ha,"c2a1f76fd222016eab3ff1f588104a464b2259e88e7c3e677f1b6384c0f50ec3")||strcmp(hb,"29d6f3fa6a453c7d899759691958fb1eaa1af72b62c2221d3a75bc0b3f05b008"))die("unapproved-fifo-source-pair",rel);delta++;}
   else if(tx_eq(rel, "exec/c/compiler.c", 1L << 20)){if(strcmp(ha,"e29a12864bf37445c269561c1c2a36f59c909b17cefa6f181621ed96e0b72d32")||strcmp(hb,"cd0680d13b3251c62215f94db3aa757974379bd80a6f601ea3e9ce43989b2d04"))die("unapproved-fifo-source-pair",rel);delta++;}
   else if(an!=bn||memcmp(x,y,an))die("unexpected-content-delta",rel);
  }
  else if(tx_eq(rel, "src/cxmod.c", 1L << 20)){if(strcmp(ha,"452fcb3bc03a9071099307205b4eda0e6e2d09922de49637d982080976f9a2cc")||strcmp(hb,"c0a385b6ff5f1aa3e9067142b91b033747134718afa7af62bd9236a6a49c7ce6"))die("unapproved-cxpack-source-pair",rel);delta++;}
  else if(tx_eq(rel, "src/main.c", 1L << 20)){if(strcmp(ha,"53a44b1aa097f2e20f1ffd64491ef27417377bb236f11848c84cde1a52f1ea04")||strcmp(hb,"c2a1f76fd222016eab3ff1f588104a464b2259e88e7c3e677f1b6384c0f50ec3"))die("unapproved-cxpack-source-pair",rel);delta++;}
  else if(tx_eq(rel, "exec/c/compiler.c", 1L << 20)){if(strcmp(ha,"4d7d44f21e85fafa8463d007da5b329b1cfb34f64238adb1afb3b1699cffd17c")||strcmp(hb,"e29a12864bf37445c269561c1c2a36f59c909b17cefa6f181621ed96e0b72d32"))die("unapproved-cxpack-source-pair",rel);delta++;}
  else if(an!=bn||memcmp(x,y,an))die("unexpected-content-delta",rel);free(x);free(y);files++;
 }else die("special-file",rel);
 np_puts(&record,"\t");np_puts(&record,ha);np_puts(&record,"\t");np_puts(&record,hb);np_puts(&record,"\n");
}
int main(int argc,char **argv){if((argc!=3&&argc!=4)||(argc==4&&strcmp(argv[3],"fifo-v1")&&strcmp(argv[3],"tapelink-v1")&&strcmp(argv[3],"driverdiag-v1"))||!realpath(argv[1],oldroot)||!realpath(argv[2],newroot)||tx_eq(oldroot, newroot, 1L << 20))die("usage DISTINCT_ORIGIN_ROOT CURRENT_ROOT [fifo-v1|tapelink-v1|driverdiag-v1]","-");fifo_profile=argc==4&&tx_eq(argv[3], "fifo-v1", 1L << 20);tapelink_profile=argc==4&&tx_eq(argv[3], "tapelink-v1", 1L << 20);driverdiag_profile=argc==4&&tx_eq(argv[3], "driverdiag-v1", 1L << 20);
 const char *trees[]={"src","exec","unisa","include","weights","kernel","seed","iterate/kernel"};
 np_puts(&record,driverdiag_profile?"driver-diagnostics-source-delta-v1\n":tapelink_profile?"tapelink-source-delta-v1\n":fifo_profile?"cxpack-fifo-source-delta-v1\n":"cxpack-source-delta-v1\n");for(int i=0;i<8;i++)walk(trees[i],0);if(delta!=(driverdiag_profile?2:tapelink_profile?1:fifo_profile?2:3))die("exact-pinned-delta-count-required","CX pack");char h[65];hash(record.p,record.n,h);free(record.p);
 printf("CXPACK_SOURCE_DELTA\tfiles=%d\tdirectories=%d\tliteral-symlinks=%d\tapproved-deltas=%d\twitness=%s\n",files,dirs,links,delta,h);
 puts("NOT_CLAIMED\tatomic-snapshot;complete-repository-identity;constructor-execution;package-provenance;admission;functional-PASS");return 0;
}
