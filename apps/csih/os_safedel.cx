#pragma unisa module os_safedel
/* Lower layer: deletion guard. May #include libc/POSIX product headers. */
#include <unisa_safedel.h>

int csih_safedel_purge(const char *path, char *why, int whylen) {
    return unisa_safedel(path, SAFEDEL_PURGE | SAFEDEL_RECURSIVE, 0, why, whylen);
}
int csih_safedel_purge_file(const char *path, char *why, int whylen) {
    return unisa_safedel(path, SAFEDEL_PURGE, 0, why, whylen);
}
