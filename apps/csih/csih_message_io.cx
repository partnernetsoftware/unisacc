#pragma unisa module csih_message_io
#pragma unisa use text.fmt
#pragma unisa use csih_message
#pragma unisa use zstr
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.env
typedef struct csih_message_preview_entry {
    char id[33];
    long mtime;
    size_t body_bytes;
    int truncated;
    char preview[257];
} csih_message_preview_entry;

/* Cooperative private mailbox consumer. Only the unique ACTIVE owner calls
 * this library. Trusted ancestors, no external replacement and all writers
 * sharing this process-record lock are prerequisites (not authentication).
 * No creation, deletion, replay of started, or crash exactly-once promise.
 * Files, directories, the record lock and memory go through cx/sys, cx/mem
 * and zstr; no direct libc call. Directory listings are sy_dir_names (the
 * getdents order readdir gave, "." and ".." already left out). */

typedef struct {
    int lock, dirs[5], count, unfinished, selected_kind;
    char paths[5][4096], ids[1024][33], selected[33];
    char *buf;
    csih_message message;
} cmi_work;

/* room for a state directory listing: 1024 ids of 37 bytes and a margin */
#define CMI_NAMES (64 * 1024)

static void cmi_why(char *why,size_t cap,const char *s) {
    if(why && cap) tx_snprintf(why,cap,"%s",s);
}
static int cmi_id(const char *s) {
    size_t i;if(!s || zs_len(s)!=32)return 0;
    for(i=0;i<32;i++)if(!((s[i]>='0'&&s[i]<='9')||(s[i]>='a'&&s[i]<='f')))return 0;
    return 1;
}
static int cmi_session(const char *s) {
    size_t i,n;if(!s)return 0;n=(size_t)zs_len(s);if(!n||n>64)return 0;
    for(i=0;i<n;i++)if(!((s[i]>='a'&&s[i]<='z')||(s[i]>='A'&&s[i]<='Z')||(s[i]>='0'&&s[i]<='9')||s[i]==':'||s[i]=='_'||s[i]=='-'))return 0;
    return 1;
}
static int cmi_path(char *dst,const char *parent,const char *name) {
    long a=zs_len(parent),b=zs_len(name);
    if(a+b+1>=4096)return 0;
    mm_copy(dst,4096,parent,a);dst[a]='/';mm_copy(dst+a+1,4096-a-1,name,b+1);return 1;
}
static int cmi_check(int fd,int directory) {
    sy_stat_t sb;if(sy_fstat(fd,&sb)<0)return 0;
    return sb.uid==(long)sy_uid() && sb.kind==(directory?'d':'f') && sb.mode==(directory?0700:0600);
}
static int cmi_read(cmi_work *w,const char *path,const char *id,const char *session,csih_message *msg,char *why,size_t cap) {
    int fd,ok=0,kind=0;size_t n=0;long nr;sy_stat_t sb;
    fd=sy_open(path,O_RDONLY|O_NOFOLLOW|O_CLOEXEC,0);
    if(fd<0){cmi_why(why,cap,"message open failed");return 0;}
    if(!cmi_check(fd,0)||sy_fstat(fd,&sb)<0||sb.size<1||sb.size>32768){cmi_why(why,cap,"message kind/owner/permissions/size invalid");goto end;}
    while(n<32769){nr=sy_read(fd,w->buf+n,(long)(32769-n));if(nr<0){cmi_why(why,cap,"message read failed");goto end;}if(nr==0)break;n+=(size_t)nr;}
    if(n!=(size_t)sb.size){cmi_why(why,cap,"message length changed or oversized");goto end;}
    kind=csih_message_decode(w->buf,n,session,msg,why,cap);
    if(!kind)goto end;
    if(!zs_eq(msg->id,id)){cmi_why(why,cap,"message id/filename mismatch");goto end;}
    ok=kind;
end:
    if(sy_close(fd)<0){cmi_why(why,cap,"message close failed");ok=0;}
    return ok;
}
/* Open lock exactly once: another close of this inode in the same process
 * releases POSIX record locks. Child processes must not reuse this lifecycle. */
static int cmi_open(cmi_work *w,const char *dir,char *why,size_t cap) {
    static const char *names[]={"ready","started","done"};char lockpath[4096];int i,lr;
    if(!dir||dir[0]!='/'||zs_len(dir)>=4096){cmi_why(why,cap,"absolute session directory required");return -1;}
    tx_copy(w->paths[0],4096,dir,zs_len(dir));
    if(!cmi_path(w->paths[1],dir,"inbox")){cmi_why(why,cap,"path too long");return -1;}
    for(i=0;i<2;i++){w->dirs[i]=sy_open(w->paths[i],O_RDONLY|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC,0);if(w->dirs[i]<0||!cmi_check(w->dirs[i],1)){cmi_why(why,cap,"directory kind/owner/permissions invalid");return -1;}}
    if(!cmi_path(lockpath,w->paths[1],"mailbox.lock")){cmi_why(why,cap,"path too long");return -1;}
    w->lock=sy_open(lockpath,O_RDWR|O_NOFOLLOW|O_CLOEXEC,0);
    if(w->lock<0||!cmi_check(w->lock,0)){cmi_why(why,cap,"lock kind/owner/permissions invalid");return -1;}
    /* the whole-file F_SETLK write lock, not waiting */
    lr=sy_lockf(w->lock,1,0);
    if(lr<0){if(lr==-EAGAIN||lr==-EACCES){cmi_why(why,cap,"mailbox busy");return 0;}cmi_why(why,cap,"record lock failed");return -1;}
    for(i=0;i<3;i++){if(!cmi_path(w->paths[i+2],w->paths[1],names[i])){cmi_why(why,cap,"path too long");return -1;}w->dirs[i+2]=sy_open(w->paths[i+2],O_RDONLY|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC,0);if(w->dirs[i+2]<0||!cmi_check(w->dirs[i+2],1)){cmi_why(why,cap,"state directory kind/owner/permissions invalid");return -1;}}
    return 1;
}
/* The names in directory PATH into NAMES (NUL after each): their count, -1 when
 * it cannot be opened, -2 when it cannot be read (or does not fit). */
static int cmi_list(const char *path,char *names) {
    int fd=sy_open(path,O_RDONLY|O_DIRECTORY|O_CLOEXEC,0),n;
    if(fd<0)return -1;
    n=sy_dir_names(fd,names,CMI_NAMES);
    if(sy_close(fd)<0&&n>=0)n=-3;
    return n==-3?-3:(n<0?-2:n);
}
static int cmi_scan(cmi_work *w,const char *session,int tasks,char *why,size_t cap) {
    int i,j,k,ok,n,c,seen=0;char path[4096],id[33],*names,*e;csih_message *msg;
    msg=mm_alloc((long)sizeof *msg);names=mm_alloc(CMI_NAMES);
    if(!msg||!names){mm_free(msg);mm_free(names);cmi_why(why,cap,"allocation failed");return 0;}
    n=cmi_list(w->paths[1],names);
    if(n==-1){mm_free(msg);mm_free(names);cmi_why(why,cap,"inbox scan open failed");return 0;}
    ok=1;
    for(c=0,e=names;ok&&c<(n<0?0:n);c++,e+=zs_len(e)+1){seen++;if(seen>4|| (!zs_eq(e,"ready")&&!zs_eq(e,"started")&&!zs_eq(e,"done")&&!zs_eq(e,"mailbox.lock"))){ok=0;cmi_why(why,cap,"unknown inbox entry");break;}}
    if(ok&&n==-2){ok=0;cmi_why(why,cap,"inbox scan read failed");}
    if(n==-3){ok=0;cmi_why(why,cap,"inbox scan close failed");}
    if(seen!=4&&ok){ok=0;cmi_why(why,cap,"inbox entries missing");}
    for(i=2;i<5&&ok;i++){
        n=cmi_list(w->paths[i],names);if(n==-1){ok=0;cmi_why(why,cap,"state scan open failed");break;}
        for(c=0,e=names;c<(n<0?0:n);c++,e+=zs_len(e)+1){
            if(zs_len(e)!=37||!zs_eq(e+32,".json")){ok=0;cmi_why(why,cap,"unknown state entry");break;}
            mm_copy(id,(long)sizeof id,e,32);id[32]=0;
            if(!cmi_id(id)||w->count>=1024){ok=0;cmi_why(why,cap,"invalid id or capacity1024 exceeded");break;}
            for(j=0;j<w->count;j++)if(zs_eq(w->ids[j],id))break;
            if(j!=w->count){ok=0;cmi_why(why,cap,"duplicate id across states");break;}
            tx_copy(w->ids[w->count++],33,id,32);
            if(i!=4 && ++w->unfinished>32){ok=0;cmi_why(why,cap,"capacity32 exceeded");break;}
            if(!cmi_path(path,w->paths[i],e)){ok=0;cmi_why(why,cap,"path too long");break;}
            k=cmi_read(w,path,id,session,msg,why,cap);if(!k){ok=0;break;}
            if(i==2&&(tasks||k==2)&&(!w->selected[0]||zs_cmp(id,w->selected)<0)){tx_copy(w->selected,33,id,32);w->selected_kind=k;mm_copy(&w->message,(long)sizeof w->message,msg,(long)sizeof *msg);}
        }
        if(ok&&n==-2){ok=0;cmi_why(why,cap,"state scan read failed");}
        if(n==-3){ok=0;cmi_why(why,cap,"state scan close failed");}
    }
    mm_free(names);mm_free(msg);return ok;
}
static int cmi_cleanup(cmi_work *w) {
    int i,ok=1;for(i=4;i>=0;i--)if(w->dirs[i]>=0&&sy_close(w->dirs[i])<0)ok=0;
    if(w->lock>=0&&sy_close(w->lock)<0)ok=0;
    mm_free(w->buf);return ok;
}
static int cmi_move(cmi_work *w,int src,int dst,const char *id,char *why,size_t cap,int *committed) {
    char name[38],a[4096],b[4096];sy_stat_t sb;int r;
    tx_snprintf(name,sizeof name,"%s.json",id);
    if(!cmi_path(a,w->paths[src],name)||!cmi_path(b,w->paths[dst],name)){cmi_why(why,cap,"path too long");return 0;}
    r=sy_lstat(b,&sb);
    if(r==0||r!=-ENOENT){cmi_why(why,cap,"destination exists or cannot be checked");return 0;}
    if(sy_rename(a,b)<0){cmi_why(why,cap,"rename failed");return 0;}
    *committed=1;
    if(sy_fsync(w->dirs[src])<0||sy_fsync(w->dirs[dst])<0){cmi_why(why,cap,"converted; directory persistence unconfirmed");return 0;}
    return 1;
}
static int cmi_operation(const char *dir,const char *session,int tasks,const char *finish,csih_message *out,char *why,size_t cap) {
    cmi_work *w;int i,opened,rc=-1,committed=0;char name[38],path[4096];
    if(out)mm_fill(out,(long)sizeof *out,0,(long)sizeof *out);
    if(!cmi_session(session)||(!finish&&(!out||(tasks!=0&&tasks!=1)))||(finish&&!cmi_id(finish))){cmi_why(why,cap,"invalid arguments");return -1;}
    w=mm_zalloc((long)sizeof *w);if(!w){cmi_why(why,cap,"allocation failed");return -1;}
    w->lock=-1;for(i=0;i<5;i++)w->dirs[i]=-1;
    w->buf=mm_alloc(32769);if(!w->buf){cmi_why(why,cap,"allocation failed");goto end;}
    opened=cmi_open(w,dir,why,cap);if(opened<=0){if(!opened&&!finish)rc=0;goto end;}
    if(!cmi_scan(w,session,tasks,why,cap))goto end;
    if(finish){
        tx_snprintf(name,sizeof name,"%s.json",finish);
        if(!cmi_path(path,w->paths[3],name)){cmi_why(why,cap,"path too long");goto end;}
        if(!cmi_read(w,path,finish,session,&w->message,why,cap))goto end;
        if(cmi_move(w,3,4,finish,why,cap,&committed))rc=0;
    }else if(!w->selected_kind){rc=0;cmi_why(why,cap,"no eligible message");}
    else if(cmi_move(w,2,3,w->selected,why,cap,&committed))rc=w->selected_kind;
end:
    if(!cmi_cleanup(w)){rc=-1;cmi_why(why,cap,committed?"converted; close unconfirmed":"close failed");}
    if(committed&&rc<0)rc=-2;
    if(rc==1||rc==2)mm_copy(out,(long)sizeof *out,&w->message,(long)sizeof *out);
    else if(out)mm_fill(out,(long)sizeof *out,0,(long)sizeof *out);
    if(rc>=0&&!(rc==0&&!finish))cmi_why(why,cap,"ok");
    mm_free(w);return rc;
}
int csih_message_take(const char *dir,const char *session,int tasks,csih_message *out,char *why,size_t cap) {
    return cmi_operation(dir,session,tasks,NULL,out,why,cap);
}
int csih_message_finish(const char *dir,const char *session,const char *id,char *why,size_t cap) {
    if(!id){cmi_why(why,cap,"invalid id");return -1;}
    return cmi_operation(dir,session,0,id,NULL,why,cap);
}
/* Read-only preview of notices in done/. Same validation as take/finish
 * (cmi_open + cmi_scan), no move, no acknowledgement. Top-cap by mtime desc,
 * id asc; the preview keeps whole UTF-8 codepoints within 256 bytes. */
int csih_message_preview(const char *dir,const char *session,csih_message_preview_entry *out,int cap,int *total,char *why,size_t wcap) {
    cmi_work *w=NULL;csih_message *msg=NULL;char *names=NULL,*e;
    int i,j,n=0,t=0,ok=0,c,count;
    if(total)*total=0;
    if(!out||cap<0||!total||!cmi_session(session)){cmi_why(why,wcap,"invalid arguments");return -1;}
    w=mm_zalloc((long)sizeof *w);msg=mm_alloc((long)sizeof *msg);names=mm_alloc(CMI_NAMES);
    if(!w||!msg||!names){cmi_why(why,wcap,"allocation failed");goto end;}
    w->lock=-1;for(i=0;i<5;i++)w->dirs[i]=-1;
    w->buf=mm_alloc(32769);if(!w->buf){cmi_why(why,wcap,"allocation failed");goto end;}
    if(cmi_open(w,dir,why,wcap)!=1)goto end;
    if(!cmi_scan(w,session,0,why,wcap))goto end;
    count=cmi_list(w->paths[4],names);
    if(count==-1){cmi_why(why,wcap,"done open failed");goto end;}
    ok=1;
    if(count==-2){ok=0;cmi_why(why,wcap,"done read failed");}
    for(c=0,e=names;ok&&c<(count<0?0:count);c++,e+=zs_len(e)+1){
        char id[33],path[4096];sy_stat_t sb;long mtime;size_t bytes,shown;int k;
        if(zs_len(e)!=37||!zs_eq(e+32,".json")){ok=0;cmi_why(why,wcap,"unexpected done entry");break;}
        mm_copy(id,(long)sizeof id,e,32);id[32]=0;
        if(!cmi_id(id)||!cmi_path(path,w->paths[4],e)){ok=0;cmi_why(why,wcap,"bad done path/id");break;}
        k=cmi_read(w,path,id,session,msg,why,wcap);
        if(!k){ok=0;break;}
        if(k!=2)continue;
        if(sy_lstat(path,&sb)!=0||sb.kind!='f'||sb.uid!=(long)sy_uid()||sb.mode!=0600){ok=0;cmi_why(why,wcap,"notice stat changed");break;}
        mtime=sb.mtime;t++;
        j=0;while(j<n&&(out[j].mtime>mtime||(out[j].mtime==mtime&&zs_cmp(out[j].id,id)<0)))j++;
        if(j>=cap)continue;
        if(n<cap)n++;
        for(i=n-1;i>j;i--)out[i]=out[i-1];
        mm_fill(&out[j],(long)sizeof out[j],0,(long)sizeof out[j]);
        tx_copy(out[j].id,33,id,32);out[j].mtime=mtime;
        bytes=(size_t)zs_len(msg->body);shown=bytes>256?256:bytes;
        /* Decoder validated UTF-8; retreat to a codepoint boundary. */
        while(shown&&shown<bytes&&(((unsigned char)msg->body[shown]&0xc0)==0x80))shown--;
        mm_copy(out[j].preview,(long)sizeof out[j].preview,msg->body,(long)shown);out[j].preview[shown]=0;
        out[j].body_bytes=bytes;out[j].truncated=shown<bytes;
    }
    if(count==-3&&ok){ok=0;cmi_why(why,wcap,"done close failed");}
end:
    if(w){if(!cmi_cleanup(w)&&ok){ok=0;cmi_why(why,wcap,"mailbox close failed");}w->buf=NULL;mm_free(w);w=NULL;}
    mm_free(msg);mm_free(names);
    if(!ok)return -1;
    *total=t;
    cmi_why(why,wcap,"ok");
    return n;
}
