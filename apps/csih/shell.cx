#pragma unisa module shell
#pragma unisa use sys.poll
#pragma unisa use sys.time
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use mem.bytes
/*
 * shell.cx — run a command through a real shell and bring back what it printed.
 *
 * WHY A REAL SHELL AND NOT A HAND-WRITTEN INTERPRETER: the tool this replaces
 * is called "bash" and its whole value is that a person (or a model) can write
 * what they already know how to write. Pipes, redirection, globs, `&&`, quoting
 * — a subset implementation gets all of them subtly wrong, and the failures are
 * silent: `a | b` doing something that is not a pipe is worse than a refusal.
 * The shell is the interface. This file's job is to be a faithful pipe to it,
 * not to reimplement it.
 *
 * WHY A PIPE AND NOT system(): system() does not return the OUTPUT, and output
 * is the entire point of a tool a model calls. It also runs the shell in a way
 * that discards the distinction between "the command failed" and "the shell
 * could not start", which are different facts. Here both are reported.
 *
 * THE THREE THINGS THIS MUST GET RIGHT, each of which is a classic way to hang
 * or lie:
 *
 *   1. CLOSE THE WRITE END IN THE PARENT. If the parent keeps its copy of the
 *      pipe's write end open, read() never sees EOF — it blocks forever waiting
 *      for a writer that is the parent itself. This is the single most common
 *      way a "run a command and capture output" function deadlocks.
 *
 *   2. DRAIN BEFORE WAITING, AND WAIT AFTER. Read everything, then waitpid. A
 *      child that fills the pipe buffer and blocks on write, while the parent
 *      blocks in waitpid, is a deadlock with no error message.
 *
 *   3. REPORT THE EXIT STATUS EVEN WHEN THE COMMAND FAILED. A non-zero status is
 *      a RESULT, not an error of this function. "the command ran and said no"
 *      and "the command could not run" lead to different next actions.
 *
 * unisacc limits honoured (SKILL.md §2): no `return f()` of a struct from a
 * non-main function; stdio owned by the CLI file. Two limits this header used
 * to claim are GONE and were measured away, not assumed away:
 *   - `execl`/`execlp` — unisacc 0.0.23 provides both (this file still uses
 *     execvp, which it has always had).
 *   - `chdir` — missing in 0.0.19, present in 0.0.23. The CDSH_HAVE_CHDIR guard
 *     and its shell-level `cd` fallback were deleted with it; see the child
 *     block below. `fchdir` is still missing and is not needed.
 * "structs restated" is narrower than the old line claimed: unisacc 0.0.23 sees
 * a type defined in an EARLIER file on the command line, so a restatement is not
 * strictly required to link (measured; gcc rejects the same pair). It is
 * order-dependent — put the user first and it fails with "not covered:
 * top-level construct" — and the restatements are what let each module build on
 * its own. So they stay; the old wording just overstated the reason.
 *
 * CLI takes SUBCOMMANDS, not dash-options.
 */

/* ── results ────────────────────────────────────────────────────────────── */

enum { shell_out_cap = 65536 };

typedef struct {
    int  ok;          /* 1 = the shell ran (whatever its exit status) */
    int  err;         /* errno if THIS function failed (fork/pipe/wait) */
    int  exited;      /* 1 = the child exited normally */
    int  status;      /* exit status when exited, else 0 */
    int  signal;      /* terminating signal when !exited, else 0 */
    int  timed_out;   /* 1 = the child was killed for running too long */
    long bytes;       /* bytes of output captured */
    char out[shell_out_cap];
} shell_result;

/* Wait until fd is readable or the absolute deadline (sy_now_ms clock) passes.
 * Returns 1 when readable, 0 on deadline, -1 on error. *rem_ms gets the
 * remaining milliseconds at the moment of return (0 if past deadline). */
static int shell_poll_deadline(int fd, long deadline_ms, long *rem_ms)
{
    long ms = deadline_ms - sy_now_ms();
    sy_pollfd_t p;
    int pr;
    if (ms <= 0) { if (rem_ms) *rem_ms = 0; return 0; }
    if (rem_ms) *rem_ms = ms;
    p.fd = fd;
    p.events = SY_POLLIN;
    p.revents = 0;
    pr = sy_poll(&p, 1, ms);                      /* resumes after EINTR itself */
    if (pr > 0) return 1;
    if (pr == 0) { if (rem_ms) *rem_ms = 0; return 0; }
    errno = -pr;
    return -1;
}

/* poll up to two fds (-1 skips a slot). Returns the ready count, 0 on timeout,
 * -1 on error; revents (SY_POLL* bits, the same values as poll(2)) in *re0/*re1. */
int shell_poll2(int fd0, int fd1, int timeout_ms, unsigned short *re0, unsigned short *re1)
{
    sy_pollfd_t pf[2];
    int n = 0, r;
    if (re0) *re0 = 0;
    if (re1) *re1 = 0;
    pf[0].fd = fd0;
    pf[0].events = SY_POLLIN;
    pf[0].revents = 0;
    pf[1].fd = fd1;
    pf[1].events = SY_POLLIN;
    pf[1].revents = 0;
    if (fd0 >= 0) n = 1;
    if (fd1 >= 0) n = 2;
    /* No fds is a plain sleep of timeout_ms: the retry back-off and the
     * managed standby loop rely on it. Returning at once made both spin. */
    if (n == 0) { sy_sleep_ms(timeout_ms); return 0; }
    r = sy_poll(pf, n, timeout_ms);
    if (r < 0) { errno = -r; return -1; }
    if (r == 0) return 0;
    if (fd0 >= 0 && re0) *re0 = (unsigned short)pf[0].revents;
    if (fd1 >= 0 && re1) *re1 = (unsigned short)pf[1].revents;
    return r;
}

/* ── running ────────────────────────────────────────────────────────────── */

/*
 * Run `command` through /bin/sh -c, capture stdout+stderr, and report the exit
 * status.
 *
 * stderr goes into the same buffer as stdout ON PURPOSE. A tool that hides
 * stderr shows a model an empty result and no reason for it — the exact
 * "unresponsive tool" complaint this project keeps producing. Interleaving
 * loses the distinction, which is a real cost, so the buffer records that it
 * happened: see the `2>&1` in the command that is actually executed.
 */
/*
 * Run in a SPECIFIC DIRECTORY.
 *
 * WHY THIS EXISTS, and the measurement behind it: of 2852 real tool calls in a
 * dsh session, 2107 (84%) began with `cd`. The reason is that every call is a
 * new process, so the working directory resets — a person writes `cd repo` once
 * and stays there, while a tool surface that cannot remember a directory forces
 * the caller to prepend `cd` to everything forever. That is not a cost the user
 * pays once; it is a cost on every single call.
 *
 * So the directory is a parameter. The child chdir()s before exec, which is
 * both the simplest implementation and the most honest one: nothing about the
 * PARENT process's directory changes, so two concurrent calls cannot interfere.
 *
 * cwd == NULL means "wherever we are", preserving the old behaviour exactly.
 */
/* Called about every 200ms while a command runs. Returning nonzero kills the
 * command (the user pressed Esc). NULL: no tick, plain wait. */
typedef int (*shell_tick_fn)(void);
static shell_tick_fn shell_tick;
void shell_set_tick(shell_tick_fn fn) { shell_tick = fn; }
/* For other waits outside a command (e.g. a retry back-off): pump the UI once.
 * Nonzero means the user asked to stop. */
int shell_call_tick(void) { return shell_tick ? shell_tick() : 0; }

shell_result shell_run_in(const char *command, const char *cwd) {
    shell_result r;
    int outfd = -1;
    int pid;

    mm_fill(&r, (long)sizeof r, 0, (long)sizeof r);
    r.ok = 0;

    if (!command) { r.err = EINVAL; return r; }
    if (!command[0]) { r.err = EINVAL; return r; }

    /*
     * sy_spawn_pipe (sys.proc) starts /bin/sh -c COMMAND:
     * - in its own process group, so a timeout or Esc kills the whole command,
     *   not just /bin/sh while its children keep running;
     * - in CWD, changed in the child, so this process's own cwd never moves;
     * - with stdin from /dev/null: a command that reads stdin must NOT steal
     *   keystrokes from the raw-mode TUI that launched it;
     * - with stdout and stderr both in one pipe (see the header), whose write
     *   end the parent no longer holds, so EOF arrives when the command ends.
     * A failed chdir or exec comes back as -errno with the child reaped. They
     * are reported as before, as exit codes the caller can tell apart from
     * "the command ran and failed": 125 for the directory, 126 for exec.
     */
    {
        char *argv[4];
        argv[0] = (char *)"/bin/sh";
        argv[1] = (char *)"-c";
        argv[2] = (char *)command;
        argv[3] = NULL;
        pid = sy_spawn_pipe(argv, cwd, SY_SPAWN_NO_PATH, &outfd, NULL);
    }
    if (pid < 0) {
        int e = -pid;
        /* no pipe or no process: THIS function failed, as before (r.err) */
        if (e == EMFILE || e == ENFILE || e == EAGAIN || e == ENOMEM || e == EINVAL) { r.err = e; return r; }
        r.ok = 1;
        r.exited = 1;
        r.status = cwd ? 125 : 126;
        return r;
    }

    /* Drain first, then wait — the child may be blocked writing into a full
     * pipe while we wait for it to finish. Reversed, that is the deadlock. */
    long budget_ms = 60000, deadline;
    const char *env = sy_env("CSIH_EXEC_TIMEOUT_SEC");
    if (env && env[0]) {
        long v = strtol(env, NULL, 10);
        if (v > 0 && v <= 60) budget_ms = v * 1000;
    }
    deadline = sy_now_ms() + budget_ms;
    {
        long off = 0, cap = (long)sizeof r.out, n;
        while (off + 1 < cap) {
            /* Wake every 200ms so the UI can redraw and the user can cancel.
             * The overall deadline is unchanged. */
            int stop = 0;
            for (;;) {
                long slice = sy_now_ms() + 200;
                int last = slice >= deadline;
                if (last) slice = deadline;
                if (shell_poll_deadline(outfd, slice, NULL) != 0) break;
                if (last) { r.timed_out = 1; stop = 1; break; }
                if (shell_tick && shell_tick()) { r.timed_out = 1; r.err = ECANCELED; stop = 1; break; }
            }
            if (stop) break;
            n = sy_read(outfd, r.out + off, cap - 1 - off);   /* resumes after EINTR itself */
            if (n <= 0) break;
            off += n;
        }
        r.out[off] = '\0';
        r.bytes = off;
        /* The buffer is full but the child may still be writing. Stop reading
         * into r.out, but keep draining, or the wait below deadlocks on a full pipe. */
        if (off + 1 >= cap) {
            char junk[1024];
            r.bytes = -1;
            for (;;) {
                int pr = shell_poll_deadline(outfd, deadline, NULL);
                if (pr == 0) { r.timed_out = 1; break; }
                if (pr < 0) { r.err = errno; break; }
                n = sy_read(outfd, junk, (long)sizeof junk);
                if (n <= 0) break;
            }
        }
    }
    sy_close(outfd);

    {
        int w, exited = 0, code = 0, sig = 0;
        /* One deadline for the whole turn: if we already hit it while
         * reading, kill now; otherwise wait with the same deadline's
         * remaining time, never a fresh budget. The kill takes the whole
         * process group (sy_killpg), then the leader itself. */
        if (r.timed_out) {
            sy_killpg(pid, SIGKILL);
            sy_signal(pid, SIGKILL);
            w = sy_wait_status(pid, 0, &exited, &code, &sig);
        } else {
            /* The pipe usually closes a moment before the exit status is
             * ready. A flat 100ms nap here added 100ms to every exec
             * (turn_latency); back off from 1ms instead, still capped at 100. */
            long nap_ms = 1;
            for (;;) {
                long ms;
                w = sy_wait_status(pid, 1, &exited, &code, &sig);
                if (w != 0) break;                /* reaped, or -errno */
                ms = deadline - sy_now_ms();
                if (ms <= 0) {
                    sy_killpg(pid, SIGKILL);
                    sy_signal(pid, SIGKILL);
                    r.timed_out = 1;
                    w = sy_wait_status(pid, 0, &exited, &code, &sig);
                    break;
                }
                sy_sleep_ms(ms > nap_ms ? nap_ms : ms);
                if (nap_ms < 100) nap_ms = nap_ms * 2 > 100 ? 100 : nap_ms * 2;
            }
        }

        if (w < 0) { r.err = -w; return r; }

        r.ok = 1;
        r.exited = exited;
        if (exited) r.status = code;
        else r.signal = sig;
    }
    return r;
}

/* Run in the current directory — the original entry point, kept so existing
 * callers (and their tests) are unaffected by the addition above. */
shell_result shell_run(const char *command) {
    shell_result r;
    r = shell_run_in(command, NULL);
    return r;
}

/* shell_cli.c owns the self-test. */
