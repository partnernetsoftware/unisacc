#pragma unisa module reload_io
#pragma unisa use reload_state
#pragma unisa use sys.guard
#pragma unisa use sys.poll
#pragma unisa use sys.time
#pragma unisa use sys.posix
#pragma unisa use sys.fs
#pragma unisa use text.text
#pragma unisa use mem.bytes
typedef struct {
    dev_t  dev;
    ino_t  ino;
    char   session_id[4096];
    char   handoff_id[4096];
    char   candidate_hash[65];
} reload_io_token;

/* reload_io.c - S2 save 单件实现 */
#define RELOAD_IO_MAX 131072

enum { RC_ERR_CAP = 1024 };

static char rc_err[RC_ERR_CAP];

char *rc_err_buf(void) { return rc_err; }

/* fail()'s exit: back to the innermost rc_guard (sys/guard), or abort outside one. */
void rc_fail_jump(void) { sy_guard_fail(); }

/* Run fn(ud): 0 when it returns, 1 when it (at any depth) failed via rc_fail_jump.
 * The setjmp frame lives in sy_guard, which stays alive for the whole callback. */
int rc_guard(void (*fn)(void *), void *ud) { return sy_guard(fn, ud); }

time_t reload_io_wall_now(void) { return (time_t)sy_wall_s(); }

/* poll up to two fds (-1 skips a slot): the ready count, 0 on timeout (or no
 * fds), -1 with errno on failure; revents (SY_POLL* bits) in *re0/*re1. */
int reload_io_poll2(int fd0, int fd1, int timeout_ms, unsigned short *re0, unsigned short *re1)
{
    sy_pollfd_t pf[2];
    int n = 0, r;
    if (re0) *re0 = 0;
    if (re1) *re1 = 0;
    pf[0].fd = fd0;
    pf[0].events = SY_POLLIN;
    pf[0].revents = 0;
    pf[1].fd = fd1;
    pf[1].events = SY_POLLIN;
    pf[1].revents = 0;
    if (fd0 >= 0) n = 1;
    if (fd1 >= 0) n = 2;
    if (n == 0) return 0;
    r = sy_poll(pf, n, timeout_ms);
    if (r < 0) { errno = -r; return -1; }
    if (r == 0) return 0;
    if (fd0 >= 0 && re0) *re0 = (unsigned short)pf[0].revents;
    if (fd1 >= 0 && re1) *re1 = (unsigned short)pf[1].revents;
    return r;
}

/* flock(LOCK_EX | LOCK_NB): 0, or -1 with errno (EWOULDBLOCK when held). */
int reload_io_flock_exnb(int fd) {
    int r = sy_flock(fd, 2 | 4);
    if (r < 0) { errno = -r; return -1; }
    return 0;
}


static void rset(char *why, size_t cap, const char *m) {
  long n;
  if (!why || cap == 0) return;
  n = tx_len(m, 1 << 20);
  if (n < 0) n = 0;
  if (n >= (long)cap) n = (long)cap - 1;
  mm_copy(why, (long)cap, m, n);
  why[n] = '\0';
}

static int dir_fsync_fd(int dfd, char *why, size_t cap) {
  if (sy_fsync(dfd) != 0) { rset(why, cap, "rename 后目录 fsync 未确认持久"); return -2; }
  return 0;
}

int reload_io_save(const char *path, const char *text, size_t len, char *why, size_t cap) {
  if (!path || !text || !why || cap == 0) { rset(why, cap, "参数为空"); return -1; }
  if (path[0] != '/') { rset(why, cap, "path 非绝对路径"); return -1; }
  long plen = tx_len(path, 4096);
  if (plen < 0) { rset(why, cap, "path 总长超过 4095"); return -1; }
  if (len > RELOAD_IO_MAX) { rset(why, cap, "len 超过 131072"); return -1; }
  if (reload_state_validate_any(text, len, why, cap) == 0) return -1;
  long slash = plen - 1;
  while (slash >= 0 && path[slash] != '/') slash--;
  if (slash <= 0 || path[slash + 1] == '\0') { rset(why, cap, "path 非法目录或空名"); return -1; }
  long dlen = slash;
  char dir[4096];
  if (dlen >= (long)sizeof(dir)) { rset(why, cap, "父目录路径过长"); return -1; }
  mm_copy(dir, (long)sizeof dir, path, dlen);
  dir[dlen] = '\0';

  int dfd = sy_openat(sy_at_fdcwd(), dir, O_RDONLY | O_DIRECTORY | O_NOFOLLOW, 0);
  if (dfd < 0) { rset(why, cap, "打开父目录失败: 非目录或链接"); return -1; }
  sy_stat_t ds;
  if (sy_fstat(dfd, &ds) != 0) { rset(why, cap, "fstat 父目录失败"); sy_close(dfd); return -1; }
  if (ds.kind != 'd') { rset(why, cap, "父目录非普通目录"); sy_close(dfd); return -1; }
  if (ds.uid != (long)getuid()) { rset(why, cap, "父目录非本人 owner"); sy_close(dfd); return -1; }
  if ((ds.mode & 0777) != 0700) { rset(why, cap, "父目录权限非 0700"); sy_close(dfd); return -1; }
  char tmp[4096];
  int tfd = -1;
  for (unsigned seq = 0; seq < 10000; seq++) {
    if (cx_fmt(tmp, sizeof(tmp), "%s/.reload_io.%ld.%u.tmp", dir, (long)getpid(), seq)) { rset(why, cap, "临时路径过长"); sy_close(dfd); return -1; }
    tfd = sy_openat(sy_at_fdcwd(), tmp, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600);
    if (tfd >= 0) break;
    if (tfd != -EEXIST) { rset(why, cap, "创建临时文件失败"); sy_close(dfd); return -1; }
  }
  if (tfd < 0) { rset(why, cap, "临时文件冲突过多"); sy_close(dfd); return -1; }
  sy_stat_t ts;
  if (sy_fstat(tfd, &ts) != 0 || ts.kind != 'f' || ts.uid != (long)getuid() || (ts.mode & 0777) != 0600) {
    rset(why, cap, "临时文件权限/owner 异常"); sy_close(tfd); sy_unlink(tmp); sy_close(dfd); return -1;
  }
  /* sy_write_all resumes after EINTR and reports a 0-byte write as -EIO */
  if (sy_write_all(tfd, text, (long)len) != 0) {
    rset(why, cap, "写入临时文件失败"); sy_close(tfd); sy_unlink(tmp); sy_close(dfd); return -1;
  }
  if (sy_fsync(tfd) != 0) { rset(why, cap, "临时文件 fsync 失败"); sy_close(tfd); sy_unlink(tmp); sy_close(dfd); return -1; }
  if (sy_close(tfd) != 0) { rset(why, cap, "临时文件 close 失败"); sy_unlink(tmp); sy_close(dfd); return -1; }
  if (sy_rename(tmp, path) != 0) { rset(why, cap, "rename 失败"); sy_unlink(tmp); sy_close(dfd); return -1; }
  int rc = dir_fsync_fd(dfd, why, cap);
  if (rc == -2) { sy_close(dfd); return -2; }
  if (rc != 0) { rset(why, cap, "目录 fsync 失败"); sy_close(dfd); return -1; }
  if (sy_close(dfd) != 0) { rset(why, cap, "目标已替换，目录 close 失败未确认持久"); return -2; }
  rset(why, cap, "ok");
  return 0;
}






