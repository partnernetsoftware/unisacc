#pragma unisa use text.fmt
#pragma unisa use sys.io
#pragma unisa use zstr
#pragma unisa use reload_consume
#pragma unisa use reload_load
/* reload_consume_cli.c — 独立探针 CLI，仅供临时验收 reload_io_consume。
 * 不执行会话恢复，不做生产接管；不自行 mkdir/chmod/unlink。
 */


static char out[131073];
static reload_io_token tok;

/* NEXT: 参数计数与模式白名单必须在 reload_io_load 之前完成。 */
int main(int argc, char **argv) {
  const char *path, *session, *handoff, *hash, *mode, *repl = NULL;
  size_t len = 0;
  int load_rc, consume_rc;
  char why[512];

  if ((argc != 7 && argc != 8) || zs_cmp(argv[1], "consume") != 0) {
    sy_eprintf("usage: %s consume PATH SESSION HANDOFF HASH MODE [REPLACEMENT]\n", argv[0]);
    return 2;
  }

  path = argv[2];
  session = argv[3];
  handoff = argv[4];
  hash = argv[5];
  mode = argv[6];
  if (zs_cmp(mode, "replace") == 0) {
    if (argc != 8) {
      sy_eprintf("replace needs REPLACEMENT\n");
      return 2;
    }
    repl = argv[7];
  } else if (argc != 7) {
    sy_eprintf("too many arguments for mode %s\n", mode);
    return 2;
  }

  if (zs_cmp(mode, "direct") != 0 && zs_cmp(mode, "stale") != 0 &&
      zs_cmp(mode, "bad-id") != 0 && zs_cmp(mode, "unterminated") != 0 &&
      zs_cmp(mode, "replace") != 0) {
    sy_eprintf("unknown mode: %s\n", mode);
    return 2;
  }

  load_rc = reload_io_load(path, session, handoff, hash, out, sizeof(out),
                           &len, &tok, why, sizeof(why));
  if (load_rc != 0) {
    sy_printf("load_rc=%d why=%s\n", load_rc, why);
    return 1;
  }

  if (zs_cmp(mode, "direct") == 0) {
    /* token 不动 */
  } else if (zs_cmp(mode, "stale") == 0) {
    tok.ino += 1;
  } else if (zs_cmp(mode, "bad-id") == 0) {
    tx_snprintf(tok.session_id, sizeof tok.session_id, "other");
  } else if (zs_cmp(mode, "unterminated") == 0) {
    zs_mset(tok.session_id, 'x', sizeof(tok.session_id));
  } else if (zs_cmp(mode, "replace") == 0) {
    if (rename(repl, path) != 0) {
      sy_eprintf("rename failed: %s -> %s\n", repl, path);
      return 2;
    }
  }

  consume_rc = reload_io_consume(path, &tok, why, sizeof(why));
  sy_printf("consume_rc=%d why=%s\n", consume_rc, why);
  if (consume_rc == 0) return 0;
  if (consume_rc == -1) return 1;
  if (consume_rc == -2) return 3;
  return 1;
}
