#pragma unisa use text.text
#pragma unisa use text.fmt
#pragma unisa use sys.io
#pragma unisa use sys.proc
#pragma unisa use sys.fs
/*
 * affected.cx -- which csih contracts (apps/csih/tests/contracts.tsv) must run
 * again after FILE... changed. tools/affected.cx answers this for tests/batches.tsv
 * only; csih's contracts live in their own table. From the repo root:
 *   sh ./unisacc.com apps/csih/tools/affected.cx -- FILE...
 * A contract is affected when its argv is `U -run ENTRY.cx ...` and one FILE (by
 * real path, so two link spellings are one file) is in ENTRY's module closure as
 * `sh ./unisacc.com -cx-plan ENTRY` plans it from apps/csih (column 2), or is ENTRY.
 * Not seen: files a check reads or compiles at run time (a probe that builds
 * agent_cli.cx in a copy names it only in a string); the last line counts the
 * contracts whose argv is not of that shape (unchecked=N), so a reader knows.
 * Prints AFFECTED<TAB>id per affected contract and
 * AFFECTED_SUMMARY<TAB>files=N<TAB>contracts=M<TAB>affected=K<TAB>unchecked=U.
 * Exit 0, or 2 on usage or I/O errors.
 */

#define NF 64
static char want[NF][4096];
static int nwant;
static char plan[1 << 20];

/* 1 when the real path of P (relative to apps/csih) is one of the wanted files */
static int wanted(const char *p) {
    char rel[4400], real[4096];
    int i;
    if (p[0] == '/') { if (tx_snprintf(rel, sizeof rel, "%s", p) >= (int)sizeof rel) return 0; }
    else if (tx_snprintf(rel, sizeof rel, "apps/csih/%s", p) >= (int)sizeof rel) return 0;
    if (sy_realpath(rel, real, (int)sizeof real) < 0) return 0;
    for (i = 0; i < nwant; i++) if (tx_eqz(real, want[i])) return 1;
    return 0;
}

/* 1 when ENTRY (relative to apps/csih) or a file of its closure is wanted; -1 when it cannot be planned */
static int touches(const char *entry) {
    char *av[5], ent[600];
    int fd = -1, pid, exited = 0, code = 0, sig = 0, hit = 0;
    long n = 0, k, a;
    if (wanted(entry)) return 1;
    if (tx_snprintf(ent, sizeof ent, "apps/csih/%s", entry) >= (int)sizeof ent) return -1;
    av[0] = "sh"; av[1] = "./unisacc.com"; av[2] = "-cx-plan"; av[3] = ent; av[4] = 0;
    pid = sy_spawn_pipe(av, 0, 0, &fd, 0);
    if (pid < 0) return -1;
    while (n < (long)sizeof plan - 1 && (k = sy_read(fd, plan + n, (long)sizeof plan - 1 - n)) > 0) n += k;
    sy_close(fd);
    if (sy_wait_status(pid, 0, &exited, &code, &sig) < 0 || !exited || code != 0 || n == 0) return -1;
    plan[n] = 0;
    for (a = 0; a < n && !hit;) {
        long e = tx_chr(plan + a, n - a, '\n'), ln = e < 0 ? n - a : e, t = tx_chr(plan + a, ln, '\t'), f, fl;
        if (t >= 0) {
            f = a + t + 1;
            fl = tx_chr(plan + f, a + ln - f, '\t');
            if (fl < 0) fl = a + ln - f;
            plan[f + fl] = 0;
            /* -cx-plan names files relative to the repo root or absolutely */
            {
                char real[4096];
                int i;
                if (sy_realpath(plan + f, real, (int)sizeof real) >= 0)   /* the length, or -errno */
                    for (i = 0; i < nwant; i++) if (tx_eqz(real, want[i])) hit = 1;
            }
        }
        a += ln + 1;
    }
    return hit;
}

int main(int argc, char **argv) {
    size_t n = 0;
    char *t;
    long at = 0, len;
    int i, contracts = 0, affected = 0, unchecked = 0;
    if (argc < 2) { sy_printf("usage: affected.cx -- FILE...\n"); return 2; }
    for (i = 1; i < argc && nwant < NF; i++) {
        if (sy_realpath(argv[i], want[nwant], (int)sizeof want[0]) < 0) { sy_printf("affected: cannot resolve %s\n", argv[i]); return 2; }
        nwant++;
    }
    t = cx_read("apps/csih/tests/contracts.tsv", &n);
    if (!t) { sy_printf("affected: cannot read apps/csih/tests/contracts.tsv\n"); return 2; }
    len = (long)n;
    while (at < len) {
        long e = tx_chr(t + at, len - at, '\n'), ln = e < 0 ? len - at : e;
        char *f[9];
        int nf = 0;
        long k = at;
        if (ln > 0 && t[at] != '#') {
            f[nf++] = t + at;
            for (k = at; k < at + ln && nf < 9; k++) if (t[k] == '\t') { t[k] = 0; f[nf++] = t + k + 1; }
            t[at + ln] = 0;
            if (nf >= 6 && tx_eqz(f[2], "IMPLEMENTED")) {
                contracts++;
                if (tx_prefix(f[5], tx_len(f[5], 4096), "U -run ", 7)) {
                    char entry[600];
                    long s = 7, x = s;
                    int r;
                    while (f[5][x] && f[5][x] != ' ') x++;
                    if (tx_snprintf(entry, sizeof entry, "%.*s", (int)(x - s), f[5] + s) >= (int)sizeof entry) return 2;
                    r = touches(entry);
                    if (r < 0) { sy_printf("affected: cannot plan %s (%s)\n", entry, f[0]); unchecked++; }
                    else if (r) { sy_printf("AFFECTED\t%s\n", f[0]); affected++; }
                } else unchecked++;
            }
        }
        at += ln + 1;
    }
    sy_printf("AFFECTED_SUMMARY\tfiles=%d\tcontracts=%d\taffected=%d\tunchecked=%d\n", nwant, contracts, affected, unchecked);
    return 0;
}
