/*
 * win-unsupported.cx — the win/x86_64 (and win/arm64) slice of csih.com for now.
 * csih's TUI is POSIX: termios raw mode, O_DIRECTORY, fcntl(F_GETFL), process
 * groups, tmux. Built for win/x86_64 those are "unknown identifier" /
 * "incomplete struct termios" (2026-10-30), so a real Windows csih needs a
 * console-API port first. Until then this slice says so and exits 2, instead
 * of a slice that half-works or none at all.
 */
int main(void) {
    fputs("csih: Windows is not supported yet (the TUI needs a console-API port of its termios, "
          "directory-fd and process-group code). Use csih.com on Linux or macOS.\n", stderr);
    return 2;
}
