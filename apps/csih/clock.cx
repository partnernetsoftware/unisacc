#pragma unisa module clock
#pragma unisa use sys.time
/* Monotonic clock through sys.time (sy_mono): the clock id is the platform's
   (CLOCK_MONOTONIC is 1 on Linux, 6 on macOS), not a hard-coded 1. */
static long clock_read_ms(void) {
    sy_ts_t ts;
    if (sy_mono(&ts) != 0) return -1;
    return ts.sec * 1000 + ts.nsec / 1000000;
}
static long clock_read_us(void) {
    sy_ts_t ts;
    if (sy_mono(&ts) != 0) return -1;
    return ts.sec * 1000000 + ts.nsec / 1000;
}
long clock_now_ms(void) { return clock_read_ms(); }
long clock_now_us(void) { return clock_read_us(); }
