#pragma unisa module clock
/* Monotonic clock. No #include <time.h>: prototype stays inside the static helper.
   Linux CLOCK_MONOTONIC is literal 1; Darwin/Windows not verified in this pass. */
static long clock_read_ms(void) {
    struct timespec ts;
    extern int clock_gettime(int, struct timespec *);
    if (clock_gettime(1, &ts) != 0) return -1;
    return (long)ts.tv_sec * 1000 + (long)(ts.tv_nsec / 1000000);
}
static long clock_read_us(void) {
    struct timespec ts;
    extern int clock_gettime(int, struct timespec *);
    if (clock_gettime(1, &ts) != 0) return -1;
    return (long)ts.tv_sec * 1000000 + (long)(ts.tv_nsec / 1000);
}
long clock_now_ms(void) { return clock_read_ms(); }
long clock_now_us(void) { return clock_read_us(); }
