#pragma unisa module check
#pragma unisa use suite
#pragma unisa use u_run
#pragma unisa use probes.tmuxwit
/*
 * check.cx — unisacc-only suite driver. Lower: may #include libc/posix.
 *   unisacc.com -run check.cx
 * Exit 0 only when every check is ok.
 */
#include <sys/stat.h>
#include <sys/wait.h>

static int pass_n, fail_n;
static const char *U;
static char work[64];

static void ok(const char *m) { printf("  ok    %s\n", m); pass_n++; }
static void no(const char *m) { printf("  FAIL  %s\n", m); fail_n++; }

static void first_line(const char *s, char *d, int n) {
    int i = 0;
    while (s[i] && s[i] != '\n' && i + 1 < n) { d[i] = s[i]; i++; }
    d[i] = 0;
}

static int run_args(char **args, int n, char *out, int cap, int *rc) {
    return u_spawn(U, args, n, NULL, out, cap, rc);
}

static void selftest(const char *label, char **args, int n) {
    char out[2048], line[180], msg[240];
    int rc;
    run_args(args, n, out, (int)sizeof out, &rc);
    first_line(out, line, (int)sizeof line);
    snprintf(msg, sizeof msg, "%s (unisacc rc=%d: %s)", label, rc, line);
    if (rc == 0) ok(msg); else no(msg);
}

static int count_in(const char *s, const char *needle) {
    int c = 0;
    const char *p = s;
    size_t n = strlen(needle);
    if (!n) return 0;
    while ((p = strstr(p, needle))) { c++; p += n; }
    return c;
}

static int read_file(const char *path, char *buf, int cap) {
    FILE *f = fopen(path, "r");
    int n;
    if (!f) { if (cap) buf[0] = 0; return -1; }
    n = (int)fread(buf, 1, (size_t)cap - 1, f);
    fclose(f);
    if (n < 0) n = 0;
    buf[n] = 0;
    return n;
}

/* `term_cli size` on a COLSxROWS tty (a private tmux pane): its one line, or a reason. */
static void tty_size_line(const char *sess, int cols, int rows, char *line, int cap) {
    static char pane[32768];
    char *cmd[] = { "sh", "-c", "\"$0\" -run term_cli.cx -- size; echo __TW_END__; sleep 30", (char *)U };
    const char *p;
    int n = 0;
    snprintf(line, cap, "(no output)");
    if (tw_new(sess, cols, rows, NULL, cmd, 4) != 0) { snprintf(line, cap, "(tmux new-session failed)"); return; }
    if (!tw_wait_text(sess, "__TW_END__", 30000, pane, sizeof pane)) { snprintf(line, cap, "(timed out)"); return; }
    p = strstr(pane, "cols=");
    if (!p) return;
    while (p[n] && p[n] != '\n' && n < cap - 1) n++;
    snprintf(line, cap, "%.*s", n, p);
}

/* Same report as the old pty witness: "uni=<100x30 line>|uni-small=<5x2 line>". */
static int pty_size(char *out, int cap) {
    char big[256], small[256];
    if (!tw_open("check")) { snprintf(out, cap, "tmux missing"); return -1; }
    tty_size_line("big", 100, 30, big, sizeof big);
    tty_size_line("small", 5, 2, small, sizeof small);
    tw_close();
    snprintf(out, cap, "uni=%s|uni-small=%s", big, small);
    return 0;
}

static int heavy_slice(const char *name) {
    return name && (!strcmp(name, "tui") || !strcmp(name, "agent"));
}

static int want_slice(int argc, char **argv, const char *name) {
    int i;
    if (argc <= 1) {
        /* Full modules pass skips heavy slices: nesting check+tui exceeds the 60s bound. */
        return !heavy_slice(name);
    }
    for (i = 1; i < argc; i++) {
        if (!strcmp(argv[i], "modules")) return !heavy_slice(name);
        if (!strcmp(argv[i], "all")) return 1;
        if (name && !strcmp(argv[i], name)) return 1;
    }
    return 0;
}

static int is_phase_token(const char *s) {
    return s && (!strcmp(s, "modules") || !strcmp(s, "loop") ||
                 !strcmp(s, "probes") || !strcmp(s, "probes-tui") ||
                 !strcmp(s, "probes-libc") || !strcmp(s, "probes-net") ||
                 !strcmp(s, "probes-e2e") || !strcmp(s, "all"));
}

static int want_probe(int argc, char **argv, const char *bucket) {
    int i;
    if (argc <= 1) return 1;
    for (i = 1; i < argc; i++) {
        if (!strcmp(argv[i], "all") || !strcmp(argv[i], "probes")) return 1;
        if (!strcmp(argv[i], bucket)) return 1;
    }
    return 0;
}

static int want_phase(int argc, char **argv, const char *phase) {
    int i, saw_phase = 0, saw_slice = 0;
    if (argc <= 1) return 1;
    for (i = 1; i < argc; i++) {
        if (!strcmp(argv[i], "all")) return 1;
        if (is_phase_token(argv[i])) {
            saw_phase = 1;
            if (!strcmp(argv[i], phase)) return 1;
        } else {
            saw_slice = 1;
        }
    }
    if (saw_phase) return 0;
    /* bare slice names: modules phase only */
    return saw_slice && !strcmp(phase, "modules");
}

int main(int argc, char **argv) {
    char out[8192], path[96], msg[300];
    int rc;
    FILE *f;
    U = getenv("UNISACC");
    if (!U || !U[0]) U = "../../unisacc.com";
    if (access(U, 1) != 0) { printf("no unisacc at %s\n", U); return 1; }
    snprintf(work, sizeof work, "/tmp/csih-check-%d", (int)getpid());
    if (mkdir(work, 0700) != 0) { printf("no temp\n"); return 2; }

    printf("csih — backend=unisacc (%s)\n\n", U);
    if (want_phase(argc, argv, "modules")) {
        int i;
        printf("each module alone (via its cli file):\n");
        if (argc <= 1 || want_slice(argc, argv, "suite")) {
            if (suite_run_selftest() == 0) ok("suite match rules");
            else no("suite match rules");
        }
        for (i = 0; i < suite_slice_count(); i++) {
            const char *av[48];
            const char *name = NULL;
            int n = suite_slice_fill(i, av, 48, &name);
            char label[64];
            if (!want_slice(argc, argv, name)) continue;
            /* Single heavy slice: replace via sh (APE needs it). Still pays
             * check compile once; prefer direct `unisacc -run csih.cx -- selftest`. */
            if (argc == 2 && heavy_slice(name) && n >= 4) {
                char *xav[10];
                xav[0] = (char *)"sh";
                xav[1] = (char *)"-c";
                xav[2] = (char *)"exec \"$0\" \"$@\"";
                xav[3] = (char *)U;
                xav[4] = (char *)av[0];
                xav[5] = (char *)av[1];
                xav[6] = (char *)av[2];
                xav[7] = (char *)av[3];
                xav[8] = NULL;
                printf("exec %s %s %s %s %s\n", U, av[0], av[1], av[2], av[3]);
                fflush(stdout);
                execv("/bin/sh", xav);
                snprintf(label, sizeof label, "%s exec", name ? name : "?");
                no(label);
                continue;
            }
            snprintf(label, sizeof label, "%s selftest", name ? name : "?");
            selftest(label, (char **)av, n);
        }
    }
    if (want_phase(argc, argv, "loop")) {
    printf("\nthe closed loop (session -> field -> gate -> write back):\n");

    pty_size(out, (int)sizeof out);
    if (strstr(out, "uni=cols=100 rows=30 source=tty"))
        ok("term size reads the real tty (unisacc)");
    else { snprintf(msg, sizeof msg, "term size on a pty: %.180s", out); no(msg); }
    if (strstr(out, "uni-small=cols=80 rows=24 source=fallback"))
        ok("term size falls back instead of trusting a 2x5 tty (the 43690 guard)");
    else { snprintf(msg, sizeof msg, "term size small-tty guard: %.180s", out); no(msg); }

    snprintf(path, sizeof path, "%s/uni.jsonl", work);
    f = fopen(path, "w");
    if (f) {
        fputs("{\"role\":\"user\",\"text\":\"go\"}\n{\"role\":\"model\",\"p\":0.20}\n{\"role\":\"model\",\"p\":0.83}\n", f);
        fclose(f);
    }
    {
        char *a[] = {"-run", "loop.cx", "--", "run", path};
        char line[160];
        run_args(a, 5, out, (int)sizeof out, &rc);
        first_line(out, line, (int)sizeof line);
        snprintf(msg, sizeof msg, "loop run stdout+rc (unisacc rc=%d: %s)", rc, line);
        if (rc == 0) ok(msg); else no(msg);
    }
    read_file(path, out, (int)sizeof out);
    if (strstr(out, "\"verdict\":\"CONTINUE\"") && strstr(out, "\"role\":\"gate\""))
        ok("the verdict is IN the transcript (loop closed, not just printed)");
    else no("no gate verdict record written back");

    snprintf(path, sizeof path, "%s/m1.c", work);
    f = fopen(path, "w"); if (f) { fputs("int main(void){return 0;}\n", f); fclose(f); }
    {
        char *a[] = {path, path};
        char m2[96];
        run_args(a, 2, out, (int)sizeof out, &rc);
        if (strstr(out, "duplicate") || strstr(out, "multiple definitions") || strstr(out, "redefinition"))
            ok("two mains are rejected BY NAME (0.0.19 fixed the misleading error)");
        else if (strstr(out, "not covered"))
            ok("two mains still cannot combine (message is still the old vague one)");
        else no("unisacc accepted two mains — re-read loop.cx header");
        snprintf(m2, sizeof m2, "%s/m2.c", work);
        f = fopen(m2, "w"); if (f) { fputs("int other(void){return 0;}\n", f); fclose(f); }
        a[1] = m2;
        run_args(a, 2, out, (int)sizeof out, &rc);
        if (rc == 0) ok("still true: one main + one library composes");
        else no("one-main + library no longer composes");
    }
    } /* want_phase loop */

    if (want_phase(argc, argv, "probes") || want_probe(argc, argv, "probes-tui") ||
        want_probe(argc, argv, "probes-libc") || want_probe(argc, argv, "probes-net") ||
        want_probe(argc, argv, "probes-e2e")) {

    if (want_probe(argc, argv, "probes-tui") || want_phase(argc, argv, "probes")) {
    printf("\nTUI probes (probes/tui_run.cx):\n");
    {
        char *a[] = {"-run", "probes/tui_run.cx"};
        run_args(a, 2, out, (int)sizeof out, &rc);
        if (rc == 0 && count_in(out, "unisacc-ok") == 6)
            ok("6 unisacc TUI questions ok");
        else {
            snprintf(msg, sizeof msg, "TUI probes unisacc rc=%d ok=%d",
                     rc, count_in(out, "unisacc-ok"));
            no(msg);
        }
    }
    }

    if (want_probe(argc, argv, "probes-libc") || want_phase(argc, argv, "probes")) {
    printf("\nunisacc libc coverage (probes/libc_cover.cx):\n");
    {
        char *a[] = {"-run", "probes/libc_cover.cx"};
        char *p;
        int nerr = -1, nmiss = -1;
        run_args(a, 2, out, (int)sizeof out, &rc);
        p = strstr(out, "defined: ");
        if (p) nerr = atoi(p + 9);
        p = strstr(out, "Missing: ");
        if (p) nmiss = atoi(p + 9);
        if (nerr == 43) ok("errno now 43/43 — unisacc 0.0.19 closed the gap");
        else { snprintf(msg, sizeof msg, "errno coverage is %d/43", nerr); no(msg); }
        if (nmiss == 0) ok("functions: no gaps — unisacc now provides execl/execlp too");
        else { snprintf(msg, sizeof msg, "expected 0 missing functions, found %d", nmiss); no(msg); }
    }

    {
        char *a[] = {"-run", "probes/dup_symbol.cx"};
        run_args(a, 2, out, (int)sizeof out, &rc);
        if (rc == 0 && !strstr(out, "STILL BROKEN"))
            ok("dup-globals are now REJECTED by unisacc (0 broken; was 2 before 0.0.19)");
        else { snprintf(msg, sizeof msg, "dup-symbol probe rc=%d", rc); no(msg); }
    }
    }

    if (want_probe(argc, argv, "probes-e2e") || want_phase(argc, argv, "probes")) {
    printf("\nTUI end to end (probes/tui_e2e.cx):\n");
    {
        /* Cold `unisacc -run csih.cx` is ~47s every launch (run-cache miss on CXIF
         * temps). E2E needs a native ELF: sh $UNISACC csih.cx -o ../../out/csih-e2e-bin/csih */
        char cwd[512], bin[640];
        const char *eb = getenv("CSIH_BIN");
        char *a[] = {"-run", "probes/tui_e2e.cx"};
        if (!(eb && eb[0] && access(eb, 1) == 0)) {
            if (!getcwd(cwd, sizeof cwd)) { no("getcwd for CSIH_BIN"); goto e2e_done; }
            snprintf(bin, sizeof bin, "%s/../../out/csih-e2e-bin/csih", cwd);
            if (access(bin, 1) != 0) {
                char *ba[] = {"csih.cx", "-o", bin};
                mkdir("../../out", 0755);
                mkdir("../../out/csih-e2e-bin", 0755);
                printf("  (building CSIH_BIN %s)\n", bin);
                if (u_spawn(U, ba, 3, NULL, out, (int)sizeof out, &rc) != 0 || rc != 0) {
                    snprintf(msg, sizeof msg,
                        "CSIH_BIN missing/build rc=%d; run: sh \"$UNISACC\" csih.cx -o ../../out/csih-e2e-bin/csih",
                        rc);
                    no(msg);
                    goto e2e_done;
                }
            }
            setenv("CSIH_BIN", bin, 1);
        }
        setenv("CSIH_E2E_FIRST_FRAME_S", "8", 1);
        run_args(a, 2, out, (int)sizeof out, &rc);
        if (rc == 0) ok("typed text reaches the transcript and a verdict is rendered");
        else {
            snprintf(msg, sizeof msg, "tui e2e failed rc=%d out=%s", rc, out[0] ? out : "(empty)");
            no(msg);
        }
    e2e_done: ;
    }
    }

    if (want_probe(argc, argv, "probes-net") || want_phase(argc, argv, "probes")) {
    printf("\nnetwork (probes/net_cover.cx + roundtrips):\n");
    {
        char *a[] = {"-run", "probes/net_cover.cx"};
        char net[8192];
        run_args(a, 2, net, (int)sizeof net, &rc);
        if (rc == 0 && (strstr(net, "ok    round trip") || strstr(net, "round trip ok")))
            ok("loopback TCP round trip (unisacc)");
        else no("net round trip differs");
        if (strstr(net, "trap still present"))
            no("the _unisa_ret trap is back — socket() needs <sys/wait.h> again");
        else {
            ok("socket() builds without <sys/wait.h> (the _unisa_ret trap is fixed)");
            read_file("net.cx", out, (int)sizeof out);
            if (strstr(out, "include <sys/wait.h>"))
                no("net.cx still includes <sys/wait.h> for the fixed trap — remove it");
            else
                ok("net.cx no longer carries the dead <sys/wait.h> include");
        }
    }
    {
        char *a[] = {"-run", "probes/http_roundtrip.cx"};
        run_args(a, 2, out, (int)sizeof out, &rc);
        if (rc == 0) ok("real HTTP round trip against a local server (unisacc)");
        else no("http round trip failed");
    }
    {
        char *a[] = {"-run", "probes/llm_roundtrip.cx"};
        run_args(a, 2, out, (int)sizeof out, &rc);
        if (rc == 0) ok("real LLM round trip (request -> net -> gate -> transcript, unisacc)");
        else no("llm round trip failed");
    }
    {
        char *a[] = {"-run", "probes/agent_roundtrip.cx"};
        run_args(a, 2, out, (int)sizeof out, &rc);
        if (rc == 0) ok("agent loop end-to-end (exec -> answer -> go:stop, unisacc)");
        else no("agent roundtrip failed");
    }
    }
    } /* probes buckets */

    printf("\n  %d ok, %d fail\n", pass_n, fail_n);
    return fail_n ? 1 : 0;
}
