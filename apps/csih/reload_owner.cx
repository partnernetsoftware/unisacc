#pragma unisa module reload_owner
#pragma unisa use sys.fs
#pragma unisa use sys.posix
#pragma unisa use sys.env
#pragma unisa use zstr
#pragma unisa use mem.bytes
/* Independent POSIX ownership library; see reload_owner.h assumptions.
   Files and the record lock go through cx/sys (sy_open, sy_fstat, sy_lockf). */

static int owner_fail(char *why, size_t cap, const char *message) {
    if (why && cap) snprintf(why, cap, "%s", message);
    return -1;
}

int reload_owner_acquire(const char *path, int *out_fd, char *why, size_t cap) {
    char parent[4096];
    const char *slash;
    long len, dlen;
    int dfd, fd;
    sy_stat_t st;
    if (out_fd) *out_fd = -1;
    if (!path || !out_fd) return owner_fail(why, cap, "null argument");
    len = zs_len(path);
    if (len == 0 || len > 4095 || path[0] != '/' || path[len - 1] == '/')
        return owner_fail(why, cap, "lock path not absolute or invalid length");
    slash = zs_rchr(path, '/');
    dlen = slash == path ? 1 : (long)(slash - path);
    mm_copy(parent, (long)sizeof parent, path, dlen); parent[dlen] = 0;
    dfd = sy_open(parent, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC, 0);
    if (dfd < 0) return owner_fail(why, cap, "open parent failed");
    if (sy_fstat(dfd, &st) != 0 || st.kind != 'd' || st.uid != (long)sy_uid() ||
        (st.mode & 0777) != 0700) {
        sy_close(dfd); return owner_fail(why, cap, "parent not owned 0700 directory");
    }
    if (sy_close(dfd) != 0) return owner_fail(why, cap, "parent close failed");
    /* O_CLOEXEC at open: the lock fd never leaks into a child */
    fd = sy_open(path, O_RDWR | O_CREAT | O_NOFOLLOW | O_CLOEXEC, 0600);
    if (fd < 0) return owner_fail(why, cap, "open lock failed");
    if (sy_fstat(fd, &st) != 0 || st.kind != 'f' || st.uid != (long)sy_uid() ||
        (st.mode & 0777) != 0600) {
        sy_close(fd); return owner_fail(why, cap, "lock not owned 0600 regular file");
    }
    /* exclusive record lock over the whole file, including future growth; no wait */
    if (sy_lockf(fd, 1, 0) != 0) {
        sy_close(fd); return owner_fail(why, cap, "ownership lock unavailable");
    }
    *out_fd = fd;
    if (why && cap) snprintf(why, cap, "ok");
    return 0;
}

int reload_owner_release(int *fd, char *why, size_t cap) {
    int owned;
    if (!fd || *fd < 0) return owner_fail(why, cap, "no owned fd");
    owned = *fd;
    *fd = -1;
    if (sy_close(owned) != 0)
        return owner_fail(why, cap, "close failed; ownership return not confirmed");
    if (why && cap) snprintf(why, cap, "ok");
    return 0;
}
