#pragma unisa module tui_reload
#pragma unisa use reload_state
#pragma unisa use reload_session_decode
#pragma unisa use reload_session_encode
#pragma unisa use reload_io
#pragma unisa use reload_load
#pragma unisa use reload_consume
#pragma unisa use journal_checkpoint
#pragma unisa use reload_owner
/* tui_reload: the reload/handoff calls tui makes, behind one use. A unit takes at most 32
   uses and a call must see its declaration in its own unit, so tui uses this module instead
   of the eight it forwards to. Each tr_* is the same call, same arguments, same result. */

int tr_no_embedded_nul(const char *text, size_t len, char *why, size_t cap) {
    return rs_no_embedded_nul(text, len, why, cap);
}

int tr_session_decode(const char *text, size_t len, reload_session_state *out, char *why, size_t cap) {
    return reload_session_decode_v2(text, len, out, why, cap);
}

int tr_session_encode(const reload_session_state *st, char *buf, size_t cap, size_t *out_len,
                      char *why, size_t cap_why) {
    return reload_session_encode_v2(st, buf, cap, out_len, why, cap_why);
}

int tr_save(const char *path, const char *text, size_t len, char *why, size_t cap) {
    return reload_io_save(path, text, len, why, cap);
}

int tr_load(const char *path, const char *expected_session, const char *expected_handoff,
            const char *expected_hash, char *out, size_t out_cap, size_t *out_len,
            reload_io_token *token, char *why, size_t cap) {
    return reload_io_load(path, expected_session, expected_handoff, expected_hash,
                          out, out_cap, out_len, token, why, cap);
}

int tr_consume(const char *path, const reload_io_token *token, char *why, size_t cap) {
    return reload_io_consume(path, token, why, cap);
}

int tr_journal_checkpoint(const char *path, long long *offset, char *why, size_t cap) {
    return journal_checkpoint(path, offset, why, cap);
}

int tr_owner_acquire(const char *path, int *out_fd, char *why, size_t cap) {
    return reload_owner_acquire(path, out_fd, why, cap);
}

int tr_owner_release(int *fd, char *why, size_t cap) {
    return reload_owner_release(fd, why, cap);
}
