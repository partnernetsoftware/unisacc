#pragma unisa use reload_candidate
#pragma unisa use json

int rc_setjmp(void *jb);
void rc_fail_push(void *jb);
char *rc_err_buf(void);

/* message_send.cx -- C port of message_send.py (same CLI, receipt JSON and exit codes).
 *
 * Publish bounded messages, not delivery/identity authentication.
 *
 * CLI:
 *   message_send publish PRIVATE_SESSION_DIR EXPECTED_SESSION JSON_FILE   (- for stdin)
 *   prints receipt JSON on stdout (rc 0 published / 1 rejected / 3 published-unconfirmed);
 *   cause on stderr as "message publisher: CAUSE".
 *
 *
 * STATUS
 *   ported : CLI, input read (O_NOFOLLOW, regular file, LIMIT+1 cap), strict UTF-8,
 *            JSON parse with duplicate-key rejection, schema/field checks, canonical
 *            envelope bytes and size limit, receipt printing, absolute/trusted session dir.
 *   BLOCKED: the publish body (inbox/ state dirs, mailbox lock, temp write, atomic link).
 *            Missing in unisacc 0.0.39: openat, linkat, lockf (dir_fd-relative mkdir/open/
 *            unlink also depend on the *at family). Such valid messages are rejected here
 *            with rc 1 and cause "publish blocked: openat/linkat/lockf missing in unisacc".
 *   DEVIATION: NUL inside JSON string escapes (\u0000) cannot be detected in NUL-terminated
 *            jvalue strings; Python rejects them with "NUL value".
 */

#define MS_LIMIT 32768
#define MS_BODY_MAX 4095

static void ms_req(int ok, const char *msg) {
    if (!ok) fail(msg);
}

static int ms_valid_session(const char *s) {
    size_t i, n = strlen(s);
    if (n < 1 || n > 64) return 0;
    for (i = 0; i < n; i++) {
        unsigned char c = (unsigned char)s[i];
        if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') ||
              c == ':' || c == '_' || c == '-'))
            return 0;
    }
    return 1;
}

static int ms_valid_id(const char *s) {
    size_t i;
    if (strlen(s) != 32) return 0;
    for (i = 0; i < 32; i++)
        if (!((s[i] >= '0' && s[i] <= '9') || (s[i] >= 'a' && s[i] <= 'f'))) return 0;
    return 1;
}

/* strict UTF-8 (rejects overlong, surrogates, > U+10FFFF), like Python decode('utf-8', 'strict') */
static int ms_utf8_ok(const unsigned char *p, size_t n) {
    size_t i = 0;
    while (i < n) {
        unsigned c = p[i], cp;
        size_t need, k;
        if (c < 0x80) { i++; continue; }
        if (c >= 0xC2 && c <= 0xDF) { need = 1; cp = c & 0x1F; }
        else if (c >= 0xE0 && c <= 0xEF) { need = 2; cp = c & 0x0F; }
        else if (c >= 0xF0 && c <= 0xF4) { need = 3; cp = c & 0x07; }
        else return 0;
        if (i + need >= n) return 0;
        for (k = 1; k <= need; k++) {
            unsigned b = p[i + k];
            if ((b & 0xC0) != 0x80) return 0;
            cp = (cp << 6) | (b & 0x3F);
        }
        if (need == 2 && (cp < 0x800 || (cp >= 0xD800 && cp <= 0xDFFF))) return 0;
        if (need == 3 && (cp < 0x10000 || cp > 0x10FFFF)) return 0;
        i += need + 1;
    }
    return 1;
}

/* duplicate keys anywhere -> same message as the Python JSON-level rejection */
static void ms_check_unique(const jvalue *v) {
    size_t i, j;
    if (!v) return;
    if (v->kind == J_OBJ) {
        for (i = 0; i < v->nkeys; i++)
            for (j = 0; j < i; j++)
                ms_req(strcmp(v->keys[i], v->keys[j]) != 0, "invalid JSON or duplicate keys");
        for (i = 0; i < v->nkeys; i++) ms_check_unique(v->vals[i]);
    } else if (v->kind == J_ARR) {
        for (i = 0; i < v->len; i++) ms_check_unique(v->items[i]);
    }
}

/* Python json.dumps(ensure_ascii=False) string body (no outer quotes is NOT used: quoted here) */
static void ms_canon_str(Buf *b, const char *s) {
    const unsigned char *p = (const unsigned char *)s;
    bs(b, "\"");
    for (; *p; p++) {
        switch (*p) {
        case '"': bs(b, "\\\""); break;
        case '\\': bs(b, "\\\\"); break;
        case '\n': bs(b, "\\n"); break;
        case '\r': bs(b, "\\r"); break;
        case '\t': bs(b, "\\t"); break;
        case '\b': bs(b, "\\b"); break;
        case '\f': bs(b, "\\f"); break;
        default:
            if (*p < 0x20) {
                char u[8];
                snprintf(u, sizeof u, "\\u%04x", *p);
                bs(b, u);
            } else {
                bn(b, p, 1);
            }
        }
    }
    bs(b, "\"");
}

/* decode(raw, expected): validated 5-key envelope, canonical bytes in *canon (Buf) */
static jvalue *ms_decode(const unsigned char *raw, size_t rawn, const char *expected, Buf *canon) {
    static const char *keys[] = {"version", "id", "session", "kind", "body"};
    char perr[256];
    jvalue *root, *ver, *id, *ses, *kind, *body;
    size_t blen;

    ms_req(rawn <= MS_LIMIT, "input exceeds32768");
    ms_req(ms_valid_session(expected), "invalid expected session");
    ms_req(!(rawn >= 3 && raw[0] == 0xEF && raw[1] == 0xBB && raw[2] == 0xBF), "invalid JSON or duplicate keys");
    ms_req(ms_utf8_ok(raw, rawn), "invalid UTF8");
    root = json_parse((const char *)raw, rawn, perr, sizeof perr);
    ms_req(root != NULL, "invalid JSON or duplicate keys");
    ms_check_unique(root);
    ms_req(root->kind == J_OBJ && exact_keys(root, keys, 5), "message schema mismatch");

    ver = jget(root, "version");
    ms_req(ver->kind == J_NUM && ver->n == 1.0, "version must be numeric1");
    id = jget(root, "id");
    ms_req(id->kind == J_STR && ms_valid_id(id->s), "invalid message id");
    ses = jget(root, "session");
    ms_req(ses->kind == J_STR && !strcmp(ses->s, expected), "session mismatch");
    kind = jget(root, "kind");
    ms_req(kind->kind == J_STR && (!strcmp(kind->s, "task") || !strcmp(kind->s, "notice")), "invalid message kind");
    body = jget(root, "body");
    ms_req(body->kind == J_STR && body->s[0] != '\0', "empty/nonstring body");
    blen = strlen(body->s);
    ms_req(blen <= MS_BODY_MAX, "body exceeds4095 UTF8 bytes");

    /* normalized envelope, keys sorted, version 1, separators (',',':'), ensure_ascii=False */
    bs(canon, "{\"body\":");
    ms_canon_str(canon, body->s);
    bs(canon, ",\"id\":");
    ms_canon_str(canon, id->s);
    bs(canon, ",\"kind\":");
    ms_canon_str(canon, kind->s);
    bs(canon, ",\"session\":");
    ms_canon_str(canon, ses->s);
    bs(canon, ",\"version\":1}");
    ms_req(canon->n <= MS_LIMIT, "normalized message exceeds32768");
    return root;
}

/* read_input(filename): LIMIT+1 cap; returns 0 ok, -1 OS error (cause = input/directory error) */
static int ms_read_input(const char *filename, unsigned char **out, size_t *outn) {
    unsigned char *buf = malloc(MS_LIMIT + 1);
    size_t got = 0;
    int fd;
    if (!buf) return -1;
    if (!strcmp(filename, "-")) {
        fd = 0;
    } else {
        fd = open(filename, O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
        if (fd < 0) { free(buf); return -1; }
    }
    if (fd != 0) {
        struct stat sb;
        if (fstat(fd, &sb) != 0) { close(fd); free(buf); return -1; }
        if (!S_ISREG(sb.st_mode)) { close(fd); free(buf); fail("JSON input must be regular"); }
    }
    while (got < MS_LIMIT + 1) {
        ssize_t r = read(fd, buf + got, (MS_LIMIT + 1) - got);
        if (r < 0) { if (errno == EINTR) continue; if (fd != 0) close(fd); free(buf); return -1; }
        if (r == 0) break;
        got += (size_t)r;
    }
    if (fd != 0) close(fd);
    *out = buf;
    *outn = got;
    return 0;
}

static void ms_print_receipt(const char *kind, const char *id, const char *session, const char *status) {
    /* json.dumps(sort_keys=True, separators=(',',':')): id, kind, session, status; null when unset */
    printf("{\"id\":%s%s%s,\"kind\":%s%s%s,\"session\":%s%s%s,\"status\":\"%s\"}\n",
           id ? "\"" : "null", id ? id : "", id ? "\"" : "",
           kind ? "\"" : "null", kind ? kind : "", kind ? "\"" : "",
           session ? "\"" : "null", session ? session : "", session ? "\"" : "",
           status);
}

static int ms_main_body(int argc, char **argv) {
    static char rc_cause[1100];
    unsigned char *raw = NULL;
    size_t rawn = 0;
    Buf canon = {0, 0, 0};
    jvalue *obj;
    const char *cause = NULL;
    int rc;

    ms_req(argc == 5 && !strcmp(argv[1], "publish"),
           "usage: publish PRIVATE_SESSION_DIR EXPECTED_SESSION JSON_FILE (- for stdin)");
    if (ms_read_input(argv[4], &raw, &rawn) != 0) {
        ms_print_receipt(NULL, NULL, NULL, "rejected");
        fprintf(stderr, "message publisher: input/directory error\n");
        return 1;
    }
    obj = ms_decode(raw, rawn, argv[3], &canon);

    /* publish(): absolute trusted private session dir, then the blocked body */
    if (argv[2][0] != '/') fail("session directory must be absolute");
    trusted(argv[2], 1, 1);
    snprintf(rc_cause, sizeof rc_cause,
             "publish blocked: openat/linkat/lockf missing in unisacc 0.0.39 (TODO port)");
    cause = rc_cause;
    ms_print_receipt(jget(obj, "kind")->s, jget(obj, "id")->s, jget(obj, "session")->s, "rejected");
    fprintf(stderr, "message publisher: %s\n", cause);
    rc = 1;
    return rc;
}

int main(int argc, char **argv) {
    __u_word jb[8];
    int rc;
    rc_fail_push(jb);
    if (rc_setjmp(jb)) {
        /* validation failure: receipt keeps null id/kind/session like the Python default */
        ms_print_receipt(NULL, NULL, NULL, "rejected");
        fprintf(stderr, "message publisher: %s\n", rc_err_buf());
        return 1;
    }
    rc = ms_main_body(argc, argv);
    return rc;
}
