#pragma unisa use text.fmt
#pragma unisa use sys.io
#pragma unisa use zstr
#pragma unisa use mem.heap
#pragma unisa use reload_candidate
#pragma unisa use reload_io
#pragma unisa use json
#pragma unisa use sys.posix
#pragma unisa use sys.fs

/* message_send.cx -- C port of message_send.py (same CLI, receipt JSON and exit codes).
 *
 * Publish bounded messages, not delivery/identity authentication.
 *
 * CLI:
 *   message_send publish PRIVATE_SESSION_DIR EXPECTED_SESSION JSON_FILE   (- for stdin)
 *   prints receipt JSON on stdout (rc 0 published / 1 rejected / 3 published-unconfirmed);
 *   cause on stderr as "message publisher: CAUSE".
 *
 *
 * STATUS
 *   ported : CLI, input read (O_NOFOLLOW, regular file, LIMIT+1 cap), strict UTF-8,
 *            JSON parse with duplicate-key rejection, schema/field checks, canonical
 *            envelope bytes and size limit, receipt printing, absolute/trusted session dir,
 *            and (2026-10-30) the publish body: inbox/ and its ready/started/done dirs
 *            made and opened relative to directory fds with O_NOFOLLOW and checked owner
 *            and private modes, the mailbox.lock record lock, the scan (only those dirs and
 *            the lock, [0-9a-f]{32}.json names, one state per id, stored envelopes decoded
 *            and their id/name matched, capacities 32 unfinished / 1024 retained), the temp
 *            write + fsync and the atomic linkat publish, then cleanup. The *at calls and
 *            lockf the carried runtime lacks come from cx/sys posix (apps/csih/sys).
 *   DEVIATION: NUL inside JSON string escapes (\u0000) cannot be detected in NUL-terminated
 *            jvalue strings; Python rejects them with "NUL value".
 *   DEVIATION: a session dir that fails trusted() (owner, symlink, kind, private mode):
 *            same receipt and rc 1, but the cause is trusted()'s own text ("wrong private
 *            permissions: DIR"). Python prints "filesystem error errno=None" there, because
 *            its trusted() raises a plain ValueError that publish() reports as an OS error.
 *            Checked against the archived message_send.py on 2026-10-30: published,
 *            already-published, conflict, mailbox busy, unknown inbox entry, symlinked
 *            inbox and relative dir give identical receipts, rc and causes, and the
 *            published tree, modes and envelope bytes are identical.
 */

#define MS_LIMIT 32768
#define MS_BODY_MAX 4095

static void ms_req(int ok, const char *msg) {
    if (!ok) fail(msg);
}

static int ms_valid_session(const char *s) {
    size_t i, n = zs_len(s);
    if (n < 1 || n > 64) return 0;
    for (i = 0; i < n; i++) {
        unsigned char c = (unsigned char)s[i];
        if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') ||
              c == ':' || c == '_' || c == '-'))
            return 0;
    }
    return 1;
}

static int ms_valid_id(const char *s) {
    size_t i;
    if (zs_len(s) != 32) return 0;
    for (i = 0; i < 32; i++)
        if (!((s[i] >= '0' && s[i] <= '9') || (s[i] >= 'a' && s[i] <= 'f'))) return 0;
    return 1;
}

/* strict UTF-8 (rejects overlong, surrogates, > U+10FFFF), like Python decode('utf-8', 'strict') */
static int ms_utf8_ok(const unsigned char *p, size_t n) {
    size_t i = 0;
    while (i < n) {
        unsigned c = p[i], cp;
        size_t need, k;
        if (c < 0x80) { i++; continue; }
        if (c >= 0xC2 && c <= 0xDF) { need = 1; cp = c & 0x1F; }
        else if (c >= 0xE0 && c <= 0xEF) { need = 2; cp = c & 0x0F; }
        else if (c >= 0xF0 && c <= 0xF4) { need = 3; cp = c & 0x07; }
        else return 0;
        if (i + need >= n) return 0;
        for (k = 1; k <= need; k++) {
            unsigned b = p[i + k];
            if ((b & 0xC0) != 0x80) return 0;
            cp = (cp << 6) | (b & 0x3F);
        }
        if (need == 2 && (cp < 0x800 || (cp >= 0xD800 && cp <= 0xDFFF))) return 0;
        if (need == 3 && (cp < 0x10000 || cp > 0x10FFFF)) return 0;
        i += need + 1;
    }
    return 1;
}

/* duplicate keys anywhere -> same message as the Python JSON-level rejection */
static void ms_check_unique(const jvalue *v) {
    size_t i, j;
    if (!v) return;
    if (v->kind == J_OBJ) {
        for (i = 0; i < v->nkeys; i++)
            for (j = 0; j < i; j++)
                ms_req(zs_cmp(v->keys[i], v->keys[j]) != 0, "invalid JSON or duplicate keys");
        for (i = 0; i < v->nkeys; i++) ms_check_unique(v->vals[i]);
    } else if (v->kind == J_ARR) {
        for (i = 0; i < v->len; i++) ms_check_unique(v->items[i]);
    }
}

/* Python json.dumps(ensure_ascii=False) string body (no outer quotes is NOT used: quoted here) */
static void ms_canon_str(Buf *b, const char *s) {
    const unsigned char *p = (const unsigned char *)s;
    bs(b, "\"");
    for (; *p; p++) {
        switch (*p) {
        case '"': bs(b, "\\\""); break;
        case '\\': bs(b, "\\\\"); break;
        case '\n': bs(b, "\\n"); break;
        case '\r': bs(b, "\\r"); break;
        case '\t': bs(b, "\\t"); break;
        case '\b': bs(b, "\\b"); break;
        case '\f': bs(b, "\\f"); break;
        default:
            if (*p < 0x20) {
                char u[8];
                tx_snprintf(u, sizeof u, "\\u%04x", *p);
                bs(b, u);
            } else {
                bn(b, p, 1);
            }
        }
    }
    bs(b, "\"");
}

/* decode(raw, expected): validated 5-key envelope, canonical bytes in *canon (Buf) */
static jvalue *ms_decode(const unsigned char *raw, size_t rawn, const char *expected, Buf *canon) {
    static const char *keys[] = {"version", "id", "session", "kind", "body"};
    char perr[256];
    jvalue *root, *ver, *id, *ses, *kind, *body;
    size_t blen;

    ms_req(rawn <= MS_LIMIT, "input exceeds32768");
    ms_req(ms_valid_session(expected), "invalid expected session");
    ms_req(!(rawn >= 3 && raw[0] == 0xEF && raw[1] == 0xBB && raw[2] == 0xBF), "invalid JSON or duplicate keys");
    ms_req(ms_utf8_ok(raw, rawn), "invalid UTF8");
    root = json_parse((const char *)raw, rawn, perr, sizeof perr);
    ms_req(root != NULL, "invalid JSON or duplicate keys");
    ms_check_unique(root);
    ms_req(root->kind == J_OBJ && exact_keys(root, keys, 5), "message schema mismatch");

    ver = jget(root, "version");
    ms_req(ver->kind == J_NUM && ver->n == 1.0, "version must be numeric1");
    id = jget(root, "id");
    ms_req(id->kind == J_STR && ms_valid_id(id->s), "invalid message id");
    ses = jget(root, "session");
    ms_req(ses->kind == J_STR && !zs_cmp(ses->s, expected), "session mismatch");
    kind = jget(root, "kind");
    ms_req(kind->kind == J_STR && (!zs_cmp(kind->s, "task") || !zs_cmp(kind->s, "notice")), "invalid message kind");
    body = jget(root, "body");
    ms_req(body->kind == J_STR && body->s[0] != '\0', "empty/nonstring body");
    blen = zs_len(body->s);
    ms_req(blen <= MS_BODY_MAX, "body exceeds4095 UTF8 bytes");

    /* normalized envelope, keys sorted, version 1, separators (',',':'), ensure_ascii=False */
    bs(canon, "{\"body\":");
    ms_canon_str(canon, body->s);
    bs(canon, ",\"id\":");
    ms_canon_str(canon, id->s);
    bs(canon, ",\"kind\":");
    ms_canon_str(canon, kind->s);
    bs(canon, ",\"session\":");
    ms_canon_str(canon, ses->s);
    bs(canon, ",\"version\":1}");
    ms_req(canon->n <= MS_LIMIT, "normalized message exceeds32768");
    return root;
}

/* read_input(filename): LIMIT+1 cap; returns 0 ok, -1 OS error (cause = input/directory error) */
static int ms_read_input(const char *filename, unsigned char **out, size_t *outn) {
    unsigned char *buf = mm_alloc(MS_LIMIT + 1);
    size_t got = 0;
    int fd;
    if (!buf) return -1;
    if (!zs_cmp(filename, "-")) {
        fd = 0;
    } else {
        fd = open(filename, O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
        if (fd < 0) { mm_free(buf); return -1; }
    }
    if (fd != 0) {
        struct stat sb;
        if (fstat(fd, &sb) != 0) { close(fd); mm_free(buf); return -1; }
        if (!S_ISREG(sb.st_mode)) { close(fd); mm_free(buf); fail("JSON input must be regular"); }
    }
    while (got < MS_LIMIT + 1) {
        ssize_t r = read(fd, buf + got, (MS_LIMIT + 1) - got);
        if (r < 0) { if (errno == EINTR) continue; if (fd != 0) close(fd); mm_free(buf); return -1; }
        if (r == 0) break;
        got += (size_t)r;
    }
    if (fd != 0) close(fd);
    *out = buf;
    *outn = got;
    return 0;
}

static void ms_print_receipt(const char *kind, const char *id, const char *session, const char *status) {
    /* json.dumps(sort_keys=True, separators=(',',':')): id, kind, session, status; null when unset */
    sy_printf("{\"id\":%s%s%s,\"kind\":%s%s%s,\"session\":%s%s%s,\"status\":\"%s\"}\n",
           id ? "\"" : "null", id ? id : "", id ? "\"" : "",
           kind ? "\"" : "null", kind ? kind : "", kind ? "\"" : "",
           session ? "\"" : "null", session ? session : "", session ? "\"" : "",
           status);
}

/* ---- publish (message_send.py publish/scan/read_envelope/directory/checked) ----
 * Every step is relative to a directory fd opened with O_NOFOLLOW, so a path
 * swapped for a symlink mid-way cannot redirect it. Failures inside run under
 * their own rc_guard: like Python's try/finally, the receipt then still names
 * the message, cleanup runs, and the status says whether it became visible. */

static const char *const ms_states[3] = { "ready", "started", "done" };

typedef struct {
    const char *dir, *expected, *wanted;
    Buf *canon;
    int fds[16], nfds;
    int statefd[3];
    int tempfd, temporary, visible;
    const char *status;
    char tempname[64];
} ms_pub_t;
static ms_pub_t MP;

static void ms_os(long r) {
    char m[64];
    if (r >= 0) return;
    tx_snprintf(m, sizeof m, "filesystem error errno=%ld", -r);
    fail(m);
}

static int ms_push(int fd) {
    if (MP.nfds < (int)(sizeof MP.fds / sizeof MP.fds[0])) MP.fds[MP.nfds++] = fd;
    return fd;
}

static int ms_same(const char *a, const char *b) {
    while (*a && *a == *b) { a++; b++; }
    return *a == *b;
}

static int ms_len(const char *s) { int n = 0; while (s[n]) n++; return n; }

static int ms_bytes_eq(const char *a, const char *b, size_t n) {
    size_t i;
    for (i = 0; i < n; i++) if (a[i] != b[i]) return 0;
    return 1;
}

#define RC_ERR_CAP_MS 1024

/* checked(fd, directory): ours, the right kind, private mode */
static sy_stat_t ms_checked(int fd, int directory) {
    sy_stat_t s;
    ms_os(sy_fstat(fd, &s));
    ms_req(s.uid == (long)getuid() && s.kind == (directory ? 'd' : 'f'), "untrusted opened file kind/owner");
    ms_req(s.mode == (directory ? 0700 : 0600), "wrong private permissions");
    return s;
}

/* directory(parent, name): make it if absent (an existing one is fine), open, check */
static int ms_directory(int parent, const char *name) {
    int r = sy_mkdirat(parent, name, 0700), fd;
    if (r < 0 && r != -EEXIST) ms_os(r);
    fd = sy_openat(parent, name, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC, 0);
    ms_os(fd);
    ms_push(fd);
    ms_checked(fd, 1);
    return fd;
}

/* [0-9a-f]{32}\.json */
static int ms_state_name(const char *n) {
    int i;
    for (i = 0; i < 32; i++) if (!((n[i] >= '0' && n[i] <= '9') || (n[i] >= 'a' && n[i] <= 'f'))) return 0;
    return ms_same(n + 32, ".json");
}

/* read_envelope(parent, name, expected): the stored envelope's canonical bytes into OUT */
static void ms_read_envelope(int parent, const char *name, Buf *out) {
    static unsigned char raw[MS_LIMIT + 2];
    long got = 0, k;
    jvalue *obj;
    int fd = sy_openat(parent, name, O_RDONLY | O_NOFOLLOW | O_CLOEXEC, 0);
    sy_stat_t s;
    char want[64];
    ms_os(fd);
    ms_push(fd);
    s = ms_checked(fd, 0);
    ms_req(s.size <= MS_LIMIT, "stored envelope oversized");
    while (got < MS_LIMIT + 1 && (k = sy_read(fd, raw + got, MS_LIMIT + 1 - got)) > 0) got += k;
    ms_os(k < 0 ? k : 0);
    out->n = 0;
    obj = ms_decode(raw, (size_t)got, MP.expected, out);
    tx_snprintf(want, sizeof want, "%s.json", jget(obj, "id")->s);
    ms_req(ms_same(name, want), "stored id/filename mismatch");
}

/* scan(): retained, unfinished; *existing set when WANTED is stored (its bytes in EXISTING) */
static void ms_scan(int inbox, int *retained, int *unfinished, int *found, Buf *existing) {
    static char names[65536], ids[1024][33];
    static Buf stored;
    int n, i, at, st, nids = 0;
    n = sy_dir_names(inbox, names, sizeof names);
    ms_os(n);
    {
        int seen[4] = { 0, 0, 0, 0 }, bad = n != 4;
        for (i = 0, at = 0; i < n; i++, at += ms_len(names + at) + 1) {
            if (ms_same(names + at, "ready")) seen[0]++;
            else if (ms_same(names + at, "started")) seen[1]++;
            else if (ms_same(names + at, "done")) seen[2]++;
            else if (ms_same(names + at, "mailbox.lock")) seen[3]++;
            else bad = 1;
        }
        ms_req(!bad && seen[0] == 1 && seen[1] == 1 && seen[2] == 1 && seen[3] == 1, "unknown inbox entry");
    }
    *unfinished = 0;
    *found = 0;
    for (st = 0; st < 3; st++) {
        n = sy_dir_names(MP.statefd[st], names, sizeof names);
        ms_os(n);
        for (i = 0, at = 0; i < n; i++, at += ms_len(names + at) + 1) {
            const char *name = names + at;
            char mid[33];
            int j;
            ms_req(ms_state_name(name), "unknown state directory entry");
            tx_snprintf(mid, sizeof mid, "%.32s", name);
            for (j = 0; j < nids; j++) ms_req(!ms_same(ids[j], mid), "id present in multiple states");
            ms_req(nids < 1024, "retained message capacity exceeded");
            ms_read_envelope(MP.statefd[st], name, &stored);
            tx_snprintf(ids[nids++], 33, "%s", mid);
            if (st != 2) (*unfinished)++;
            ms_req(*unfinished <= 32, "unfinished message capacity exceeded");
            if (ms_same(mid, MP.wanted)) {
                existing->n = 0;
                bn(existing, stored.p, stored.n);
                *found = 1;
            }
        }
    }
    *retained = nids;
}

/* .publish-<32 random hex>.tmp */
static void ms_tempname(char *out, int cap) {
    unsigned char r[16];
    long got = 0;
    int fd = sy_openat(sy_at_fdcwd(), "/dev/urandom", O_RDONLY | O_CLOEXEC, 0), i, at;
    ms_os(fd);
    got = sy_read(fd, r, sizeof r);
    sy_close(fd);
    ms_req(got == (long)sizeof r, "random source short read");
    at = tx_snprintf(out, cap, ".publish-");
    for (i = 0; i < 16 && at + 3 < cap; i++) at += tx_snprintf(out + at, cap - at, "%02x", r[i]);
    tx_snprintf(out + at, cap - at, ".tmp");
}

static void ms_publish_body(void *ud) {
    static Buf existing;
    int parent, inbox, lock, st, retained, unfinished, found, r;
    (void)ud;
    ms_req(MP.dir[0] == '/', "session directory must be absolute");
    trusted(MP.dir, 1, 1);
    parent = sy_openat(sy_at_fdcwd(), MP.dir, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC, 0);
    ms_os(parent);
    ms_push(parent);
    ms_checked(parent, 1);
    inbox = ms_directory(parent, "inbox");
    lock = sy_openat(inbox, "mailbox.lock", O_RDWR | O_CREAT | O_NOFOLLOW | O_CLOEXEC, 0600);
    ms_os(lock);
    ms_push(lock);
    ms_checked(lock, 0);
    r = sy_lockf(lock, 1, 0);
    if (r == -EAGAIN || r == -EACCES) fail("mailbox busy");
    ms_os(r);
    for (st = 0; st < 3; st++) MP.statefd[st] = ms_directory(inbox, ms_states[st]);
    ms_scan(inbox, &retained, &unfinished, &found, &existing);
    if (found) {
        ms_req(existing.n == MP.canon->n && ms_bytes_eq(existing.p, MP.canon->p, existing.n), "id conflicts with existing content");
        MP.visible = 1;
        MP.status = "already-published";
        return;
    }
    ms_req(unfinished < 32, "unfinished capacity32 reached");
    ms_req(retained < 1024, "retained capacity1024 reached");
    /* persist any newly created namespace before exposing an envelope */
    ms_os(sy_fsync(lock));
    ms_os(sy_fsync(inbox));
    ms_os(sy_fsync(parent));
    ms_tempname(MP.tempname, sizeof MP.tempname);
    MP.tempfd = sy_openat(MP.statefd[0], MP.tempname, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
    ms_os(MP.tempfd);
    MP.temporary = 1;
    ms_checked(MP.tempfd, 0);
    ms_os(sy_write_all(MP.tempfd, MP.canon->p, (long)MP.canon->n));
    ms_os(sy_fsync(MP.tempfd));
    r = MP.tempfd;
    MP.tempfd = -1;
    ms_os(sy_close(r));
    {
        /* link is atomic, fails on an existing target, and exposes complete bytes */
        char final_[64];
        tx_snprintf(final_, sizeof final_, "%s.json", MP.wanted);
        ms_os(sy_linkat(MP.statefd[0], MP.tempname, MP.statefd[0], final_, 0));
    }
    MP.visible = 1;
    MP.status = "published";
    ms_os(sy_unlinkat(MP.statefd[0], MP.tempname, 0));
    MP.temporary = 0;
    ms_os(sy_fsync(MP.statefd[0]));
}

/* publish(): rc 0 / 1 rejected / 3 published-unconfirmed; *STATUS and *CAUSE (NULL: none) */
static int ms_publish(const char *dir, const char *expected, const char *id, Buf *canon,
                      const char **status, char *cause, int cap) {
    static const ms_pub_t zero;
    int failed, i;
    char err[RC_ERR_CAP_MS];
    MP = zero;
    MP.dir = dir; MP.expected = expected; MP.wanted = id; MP.canon = canon;
    MP.tempfd = -1;
    MP.statefd[0] = MP.statefd[1] = MP.statefd[2] = -1;
    failed = rc_guard(ms_publish_body, 0);
    err[0] = 0;
    if (failed) tx_snprintf(err, sizeof err, "%s", rc_err_buf());
    /* finally: our own temp file only; never a target or the lock */
    if (MP.tempfd >= 0) { int r = sy_close(MP.tempfd); if (r < 0 && !err[0]) tx_snprintf(err, sizeof err, "filesystem error errno=%d", -r); }
    if (MP.temporary) { int r = sy_unlinkat(MP.statefd[0], MP.tempname, 0); if (r < 0 && !err[0]) tx_snprintf(err, sizeof err, "filesystem error errno=%d", -r); }
    for (i = MP.nfds - 1; i >= 0; i--) { int r = sy_close(MP.fds[i]); if (r < 0 && !err[0]) tx_snprintf(err, sizeof err, "filesystem error errno=%d", -r); }
    if (err[0]) {
        *status = MP.visible ? "published-unconfirmed" : "rejected";
        tx_snprintf(cause, cap, "%s", err);
        return MP.visible ? 3 : 1;
    }
    *status = MP.status;
    cause[0] = 0;
    return 0;
}

static int ms_main_body(int argc, char **argv) {
    static char rc_cause[1100];
    unsigned char *raw = NULL;
    size_t rawn = 0;
    Buf canon = {0, 0, 0};
    jvalue *obj;
    const char *cause = NULL;
    int rc;

    ms_req(argc == 5 && !zs_cmp(argv[1], "publish"),
           "usage: publish PRIVATE_SESSION_DIR EXPECTED_SESSION JSON_FILE (- for stdin)");
    if (ms_read_input(argv[4], &raw, &rawn) != 0) {
        ms_print_receipt(NULL, NULL, NULL, "rejected");
        sy_eprintf("message publisher: input/directory error\n");
        return 1;
    }
    obj = ms_decode(raw, rawn, argv[3], &canon);

    /* publish(): decode failures above go to main's guard (null receipt, like
     * Python's default); everything after names the message in its receipt. */
    {
        const char *status = "rejected";
        rc = ms_publish(argv[2], argv[3], jget(obj, "id")->s, &canon, &status, rc_cause, sizeof rc_cause);
        cause = rc_cause[0] ? rc_cause : NULL;
        ms_print_receipt(jget(obj, "kind")->s, jget(obj, "id")->s, jget(obj, "session")->s, status);
        if (cause) sy_eprintf("message publisher: %s\n", cause);
    }
    return rc;
}

static int ms_argc;
static char **ms_argv;
static int ms_rc;

static void ms_guard_body(void *ud) {
    (void)ud;
    ms_rc = ms_main_body(ms_argc, ms_argv);
}

int main(int argc, char **argv) {
    ms_argc = argc;
    ms_argv = argv;
    ms_rc = 0;
    if (rc_guard(ms_guard_body, 0)) {
        /* validation failure: receipt keeps null id/kind/session like the Python default */
        ms_print_receipt(NULL, NULL, NULL, "rejected");
        sy_eprintf("message publisher: %s\n", rc_err_buf());
        return 1;
    }
    return ms_rc;
}
