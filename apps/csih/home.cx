#pragma unisa module home
#pragma unisa use text.fmt
#pragma unisa use zstr
#pragma unisa use sys.fs
/* csih.home: bind ~/.csih (symlink legacy ~/.cdsh). Existence, the link and the
   directory are all sys.fs. */
void csih_home_bind(const char *home) {
    char neu[512], old[512];
    if (!home || !home[0]) return;
    tx_snprintf(neu, sizeof neu, "%s/.csih", home);
    if (sy_exists(neu) == 1) return;
    tx_snprintf(old, sizeof old, "%s/.cdsh", home);
    if (sy_exists(old) == 1 && sy_symlink(".cdsh", neu) == 0) return;
    sy_mkdir(neu, 0750);
}
