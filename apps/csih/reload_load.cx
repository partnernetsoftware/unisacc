#pragma unisa module reload_load
#pragma unisa use json
#pragma unisa use reload_state
#pragma unisa use reload_io
#pragma unisa use zstr
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use sys.fs
/* reload_load.c — reload_io_load 实现（唯一新源码，无 main）。
 * 采信 load 成功不删文件；仅已提交恢复后由 consume 收尾。
 * 文件、目录与内存经 cx 底层（sys.fs、mem.*、zstr），不直接调 libc。
 */


#define LOAD_MAX_BYTES 131072
#define WHY_CAP_DEFAULT 256

static void set_why(char *why, size_t cap, const char *msg)
{
    if (why != NULL && cap > 0) {
        long n = zs_len(msg);
        if (n > (long)cap - 1) n = (long)cap - 1;
        mm_copy(why, (long)cap, msg, n);
        why[n] = '\0';
    }
}

static int check_dir(const char *path, char *why, size_t cap)
{
    char dir[4096];
    size_t n = (size_t)zs_len(path);
    int fd;
    sy_stat_t st;

    if (n == 0 || n > 4095 || path[0] != '/') {
        set_why(why, cap, "path length or prefix out of range");
        return -1;
    }
    if (path[n - 1] == '/') {
        set_why(why, cap, "target path must not end with slash");
        return -1;
    }
    {
        size_t slash = 0;
        for (size_t i = n; i > 0; i--) {
            if (path[i - 1] == '/') {
                slash = i - 1;
                break;
            }
        }
        if (slash == 0) {
            dir[0] = '/';
            dir[1] = '\0';
        } else {
            mm_copy(dir, (long)sizeof dir, path, (long)slash);
            dir[slash] = '\0';
        }
    }
    fd = sy_open(dir, O_RDONLY | O_DIRECTORY | O_NOFOLLOW, 0);
    if (fd < 0) {
        set_why(why, cap, "open parent dir failed");
        return -1;
    }
    if (sy_fstat(fd, &st) != 0) {
        set_why(why, cap, "fstat parent dir failed");
        sy_close(fd);
        return -1;
    }
    if (st.kind != 'd' || st.uid != (long)getuid() ||
        (st.mode & 0777) != 0700) {
        set_why(why, cap, "parent dir not trusted");
        sy_close(fd);
        return -1;
    }
    return fd;
}

/* Exactly SIZE bytes, then end of file: 0; a short read, a grown file or an
 * error: -1. sy_read resumes after EINTR itself. */
static int read_all(int fd, char *buf, size_t size)
{
    size_t off = 0;
    char extra;
    long r;
    while (off < size) {
        r = sy_read(fd, buf + off, (long)(size - off));
        if (r <= 0) {
            return -1; /* error or short read */
        }
        off += (size_t)r;
    }
    r = sy_read(fd, &extra, 1);
    if (r == 0) {
        return 0; /* EOF confirmed */
    }
    return -1; /* error, or grew */
}

static int str_eq(const char *v, size_t vlen, const char *expect)
{
    if (expect == NULL) {
        return 0;
    }
    return tx_same(v, (long)vlen, expect, zs_len(expect));
}

int reload_io_load(const char *path, const char *expected_session,
                   const char *expected_handoff, const char *expected_hash,
                   char *out, size_t out_cap, size_t *out_len,
                   reload_io_token *token, char *why, size_t cap)
{
    int dfd = -1, fd = -1, rc = -1;
    char *buf = NULL;
    sy_stat_t st;
    size_t size = 0;
    jvalue *root = NULL, *v;
    const char *sv = NULL;
    size_t svl = 0;

    if (out_len != NULL) {
        *out_len = 0;
    }
    if (token != NULL) {
        mm_fill(token, (long)sizeof(*token), 0, (long)sizeof(*token));
    }
    if (out != NULL && out_cap > 0) {
        out[0] = '\0';
    }
    if (path == NULL || out == NULL || out_len == NULL || token == NULL ||
        expected_session == NULL || expected_handoff == NULL ||
        expected_hash == NULL) {
        set_why(why, cap, "null argument");
        return -1;
    }

    dfd = check_dir(path, why, cap);
    if (dfd < 0) {
        return -1;
    }
    fd = sy_open(path, O_RDONLY | O_NOFOLLOW, 0);
    if (fd < 0) {
        set_why(why, cap, "open target failed");
        goto done;
    }
    if (sy_fstat(fd, &st) != 0) {
        set_why(why, cap, "fstat target failed");
        goto done;
    }
    if (st.kind != 'f' || st.uid != (long)getuid() ||
        (st.mode & 0777) != 0600) {
        set_why(why, cap, "target not trusted");
        goto done;
    }
    if (st.size < 0 || (unsigned long long)st.size > LOAD_MAX_BYTES) {
        set_why(why, cap, "target size out of range");
        goto done;
    }
    size = (size_t)st.size;
    if (out_cap < size + 1) {
        set_why(why, cap, "out buffer too small");
        goto done;
    }
    buf = (char *)mm_alloc((long)size + 1);
    if (buf == NULL) {
        set_why(why, cap, "malloc failed");
        goto done;
    }
    if (read_all(fd, buf, size) != 0) {
        set_why(why, cap, "read failed or size changed");
        goto done;
    }
    buf[size] = '\0';
    if (sy_close(fd) != 0) {
        fd = -1;
        set_why(why, cap, "close target failed");
        goto done;
    }
    fd = -1;
    if (reload_state_validate_any(buf, size, why, cap) != 1) {
        goto done;
    }
    root = json_parse(buf, size, why, cap);
    if (root == NULL) {
        goto done;
    }
    v = jget(root, "session_id");
    sv = v != NULL ? jstr(v) : NULL;
    if (sv == NULL) {
        set_why(why, cap, "missing session_id field");
        goto done;
    }
    if (!str_eq(sv, (size_t)zs_len(sv), expected_session)) {
        set_why(why, cap, "session_id mismatch");
        goto done;
    }
    v = jget(root, "handoff_id");
    sv = v != NULL ? jstr(v) : NULL;
    if (sv == NULL) {
        set_why(why, cap, "missing handoff_id field");
        goto done;
    }
    if (!str_eq(sv, (size_t)zs_len(sv), expected_handoff)) {
        set_why(why, cap, "handoff_id mismatch");
        goto done;
    }
    v = jget(root, "candidate_hash");
    sv = v != NULL ? jstr(v) : NULL;
    if (sv == NULL) {
        set_why(why, cap, "missing candidate_hash field");
        goto done;
    }
    if (!str_eq(sv, (size_t)zs_len(sv), expected_hash)) {
        set_why(why, cap, "candidate_hash mismatch");
        goto done;
    }
    /* the expected ids equal the file's validated fields; the copies are
       bounded anyway, and a value that does not fit is refused, not cut */
    if (tx_copy(token->session_id, (long)sizeof token->session_id, expected_session, zs_len(expected_session)) ||
        tx_copy(token->handoff_id, (long)sizeof token->handoff_id, expected_handoff, zs_len(expected_handoff)) ||
        tx_copy(token->candidate_hash, (long)sizeof token->candidate_hash, expected_hash, zs_len(expected_hash))) {
        set_why(why, cap, "token field too long");
        goto done;
    }
    mm_copy(out, (long)out_cap, buf, (long)size + 1);
    *out_len = size;
    token->dev = (dev_t)st.dev;
    token->ino = (ino_t)st.ino;
    set_why(why, cap, "ok");
    rc = 0;

done:
    if (rc != 0) {
        *out_len = 0;
        if (out_cap > 0) {
            out[0] = '\0';
        }
        mm_fill(token, (long)sizeof(*token), 0, (long)sizeof(*token));
    }
    if (root != NULL) {
        jfree(root);
    }
    mm_free(buf);
    if (fd >= 0) {
        sy_close(fd);
    }
    if (dfd >= 0) {
        if (sy_close(dfd) != 0) {
            rc = -1;
            set_why(why, cap, "close parent failed");
            *out_len = 0;
            if (out_cap > 0) {
                out[0] = '\0';
            }
            mm_fill(token, (long)sizeof(*token), 0, (long)sizeof(*token));
        }
    }
    return rc;
}
