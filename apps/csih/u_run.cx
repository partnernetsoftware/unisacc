#pragma unisa module u_run
/* probes.sys.*, not sys.*: check.cx uses this with probes.tmuxwit, which takes sys.proc
 * through probes/sys; the compiler keys modules by path, so the same cx/sys file reached
 * through apps/csih/sys too is "defined twice" (out/modrepro; reported to cc). */
#pragma unisa use probes.sys.proc
#pragma unisa use probes.sys.fs
/*
 * u_run.cx — spawn unisacc.com and keep its wait status. Processes and pipes
 * are cx/sys (sy_spawn_pipe, sy_wait_status); no direct libc call.
 * APE needs /bin/sh exec; plain execv returns ENOEXEC.
 */

/* Run ARGV (argv[0] a path), stdin /dev/null, stdout+stderr captured into
 * OUT (CAP bytes, NUL-terminated; the rest is drained so the child never
 * blocks on a full pipe). *RC is the exit status, 128 for a signal, 127 when
 * /bin/sh could not be started. 0, or -1 when the wait itself failed. */
static int u_capture(char **argv, char *out, int cap, int *rc) {
    int fd = -1, pid, exited = 0, code = 0;
    long off = 0, k;
    pid = sy_spawn_pipe(argv, 0, SY_SPAWN_NO_PATH, &fd, 0);
    if (pid < 0) { *rc = 127; return 0; }
    for (;;) {
        char junk[1024];
        if (off + 1 < cap) k = sy_read(fd, out + off, (long)cap - 1 - off);
        else k = sy_read(fd, junk, (long)sizeof junk);
        if (k <= 0) break;
        if (off + 1 < cap) off += k;
    }
    out[off] = 0;
    sy_close(fd);
    if (sy_wait_status(pid, 0, &exited, &code, 0) < 0) return -1;
    *rc = exited ? code : 128;
    return 0;
}

int u_spawn(const char *bin, char **args, int nargs, const char *cwd,
            char *out, int cap, int *rc) {
    char *argv[32];
    int i, n = 0;
    if (cap < 1 || !bin || !rc) return -1;
    out[0] = 0;
    *rc = 127;
    if (nargs < 0 || nargs + 8 > 32) return 0;
    argv[n++] = (char *)"/bin/sh";
    argv[n++] = (char *)"-c";
    if (cwd && cwd[0]) {
        argv[n++] = (char *)"d=$1; b=$2; shift 2; cd \"$d\" && exec \"$b\" \"$@\"";
        argv[n++] = (char *)"_";
        argv[n++] = (char *)cwd;
        argv[n++] = (char *)bin;
    } else {
        argv[n++] = (char *)"exec \"$0\" \"$@\"";
        argv[n++] = (char *)bin;
    }
    for (i = 0; i < nargs; i++) argv[n++] = args[i];
    argv[n] = 0;
    return u_capture(argv, out, cap, rc);
}

int u_spawn_sh(const char *bin, char **args, int nargs, const char *script,
               char *out, int cap, int *rc) {
    char *argv[32];
    int i, n = 0;
    if (cap < 1 || !bin || !rc || !script) return -1;
    out[0] = 0;
    *rc = 127;
    if (nargs < 0 || nargs + 6 > 32) return 0;
    argv[n++] = (char *)"/bin/sh";
    argv[n++] = (char *)"-c";
    argv[n++] = (char *)script;
    argv[n++] = (char *)bin;
    for (i = 0; i < nargs; i++) argv[n++] = args[i];
    argv[n] = 0;
    return u_capture(argv, out, cap, rc);
}

void u_stop(int pid) {
    if (pid <= 0) return;
    sy_signal(pid, 15);
}
