#pragma unisa use sys.io
#pragma unisa use zstr
#pragma unisa use journal_checkpoint

int journal_checkpoint(const char *path, long long *offset, char *why, size_t cap);

int main(int argc, char **argv)
{
    long long offset = 77;
    char why[256];
    int rc;

    why[0] = '\0';
    if (argc != 3 || zs_cmp(argv[1], "checkpoint") != 0) {
        sy_eprintf("usage: %s checkpoint <path>\n", argv[0]);
        return 2;
    }

    rc = journal_checkpoint(argv[2], &offset, why, sizeof(why));
    sy_printf("rc=%d offset=%lld why=%s\n", rc, offset, why);
    return rc == 0 ? 0 : 1;
}
