#pragma unisa module zstr
#pragma unisa use text.text
/*
 * zstr.cx — the NUL-terminated string operations csih's modules used from
 * libc (strlen, strcmp, strncmp, strchr, strrchr, strstr), over text.text.
 * No libc call. The semantics are libc's for terminated strings; a string is
 * scanned up to ZS_SCAN bytes (an unterminated one reads as that long).
 * Byte copies and fills are mem.bytes (mm_copy, mm_move, mm_fill).
 */

#define ZS_SCAN (1L << 30)

/* strlen */
long zs_len(const char *s) { long n = tx_len(s, ZS_SCAN); return n < 0 ? 0 : n; }

/* !strcmp: 1 when A and B are the same string */
int zs_eq(const char *a, const char *b) { return tx_eq(a, b, ZS_SCAN); }

/* !strncmp(s, p, strlen(p)): 1 when S starts with P */
int zs_starts(const char *s, const char *p) { return tx_prefix(s, zs_len(s), p, zs_len(p)); }

/* strcmp's order: <0, 0 or >0, comparing unsigned bytes */
int zs_cmp(const char *a, const char *b) {
    const unsigned char *x = (const unsigned char *)a, *y = (const unsigned char *)b;
    while (*x && *x == *y) { x++; y++; }
    return (int)*x - (int)*y;
}

/* strstr: the first W in S, or 0 */
char *zs_find(const char *s, const char *w) {
    long at = tx_find(s, zs_len(s), w, zs_len(w));
    return at < 0 ? 0 : (char *)s + at;
}

/* strchr: the first C in S (C 0: the terminator), or 0 */
char *zs_chr(const char *s, int c) {
    long n = zs_len(s), at;
    if ((char)c == 0) return (char *)s + n;
    at = tx_chr(s, n, c);
    return at < 0 ? 0 : (char *)s + at;
}

/* strrchr: the last C in S, or 0 */
char *zs_rchr(const char *s, int c) {
    long i = zs_len(s);
    if ((char)c == 0) return (char *)s + i;
    while (i-- > 0) if (s[i] == (char)c) return (char *)s + i;
    return 0;
}

/* memchr(s, 0, cap) != 0: 1 when S has a terminator within CAP bytes */
int zs_has_nul(const char *s, long cap) { return tx_len(s, cap) >= 0; }
