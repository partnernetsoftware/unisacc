#pragma unisa module zstr
#pragma unisa use text.text
#pragma unisa use mem.bytes
/* not used here: brought in so every module using zstr also sees the libc-shaped
   formatting, number parsing and stdio wrappers (tx_snprintf, tx_strtol,
   sy_printf, ...) without spending its own uses (a unit takes at most 32) */
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use sys.io
/*
 * zstr.cx — the NUL-terminated string operations csih's modules used from
 * libc (strlen, strcmp, strncmp, strchr, strrchr, strstr), over text.text.
 * No libc call. The semantics are libc's for terminated strings; a string is
 * scanned up to ZS_SCAN bytes (an unterminated one reads as that long).
 * Byte copies and fills are mem.bytes (mm_copy, mm_move, mm_fill).
 */

#define ZS_SCAN (1L << 30)

/* strlen */
long zs_len(const char *s) { long n = tx_len(s, ZS_SCAN); return n < 0 ? 0 : n; }

/* !strcmp: 1 when A and B are the same string */
int zs_eq(const char *a, const char *b) { return tx_eq(a, b, ZS_SCAN); }

/* !strncmp(s, p, strlen(p)): 1 when S starts with P */
int zs_starts(const char *s, const char *p) { return tx_prefix(s, zs_len(s), p, zs_len(p)); }

/* strcmp's order: <0, 0 or >0, comparing unsigned bytes */
int zs_cmp(const char *a, const char *b) {
    const unsigned char *x = (const unsigned char *)a, *y = (const unsigned char *)b;
    while (*x && *x == *y) { x++; y++; }
    return (int)*x - (int)*y;
}

/* strncmp's order over at most N bytes: <0, 0 or >0 */
int zs_ncmp(const char *a, const char *b, long n) {
    const unsigned char *x = (const unsigned char *)a, *y = (const unsigned char *)b;
    if (n <= 0) return 0;
    while (--n > 0 && *x && *x == *y) { x++; y++; }
    return (int)*x - (int)*y;
}

/* strstr: the first W in S, or 0 */
char *zs_find(const char *s, const char *w) {
    long at = tx_find(s, zs_len(s), w, zs_len(w));
    return at < 0 ? 0 : (char *)s + at;
}

/* strchr: the first C in S (C 0: the terminator), or 0 */
char *zs_chr(const char *s, int c) {
    long n = zs_len(s), at;
    if ((char)c == 0) return (char *)s + n;
    at = tx_chr(s, n, c);
    return at < 0 ? 0 : (char *)s + at;
}

/* strrchr: the last C in S, or 0 */
char *zs_rchr(const char *s, int c) {
    long i = zs_len(s);
    if ((char)c == 0) return (char *)s + i;
    while (i-- > 0) if (s[i] == (char)c) return (char *)s + i;
    return 0;
}

/* ── libc-shaped byte and string copies over mem.bytes ──────────────────
   Same arguments and results as memcpy/memmove/memset/memchr/strcpy/strncpy,
   for call sites where the destination's capacity is not at hand: the caller
   keeps the bound it already had. Prefer mm_copy/tx_copy with a capacity. */

void *zs_mcpy(void *d, const void *s, long n) { if (n > 0) mm_copy(d, n, s, n); return d; }
void *zs_mmove(void *d, const void *s, long n) { if (n > 0) mm_move(d, n, s, n); return d; }
void *zs_mset(void *d, int c, long n) { if (n > 0) mm_fill(d, n, c, n); return d; }
void *zs_mchr(const void *s, int c, long n) {
    const unsigned char *p = (const unsigned char *)s;
    long i;
    for (i = 0; i < n; i++) if (p[i] == (unsigned char)c) return (void *)(p + i);
    return 0;
}
/* bounded copy of the z-string SRC into DST[CAP]: at most CAP-1 bytes and a
   NUL; 0, or 1 when SRC was cut to fit (0 and nothing written when CAP < 1) */
int zs_set(char *d, long cap, const char *s) {
    long n = zs_len(s), cut = 0;
    if (!d || cap < 1) return 0;
    if (n > cap - 1) { n = cap - 1; cut = 1; }
    mm_copy(d, cap, s, n);
    d[n] = 0;
    return cut;
}
char *zs_cpy(char *d, const char *s) { long n = zs_len(s); mm_copy(d, n + 1, s, n + 1); return d; }
/* strncpy: copy at most N bytes, NUL-pad the rest; no terminator when S is N or longer */
char *zs_ncpy(char *d, const char *s, long n) {
    long i = 0;
    for (; i < n && s[i]; i++) d[i] = s[i];
    for (; i < n; i++) d[i] = 0;
    return d;
}

/* memchr(s, 0, cap) != 0: 1 when S has a terminator within CAP bytes */
int zs_has_nul(const char *s, long cap) { return tx_len(s, cap) >= 0; }
