#pragma unisa module reload_consume
#pragma unisa use reload_io
#pragma unisa use reload_load
#pragma unisa use zstr
#pragma unisa use text.text
#pragma unisa use mem.bytes
#pragma unisa use mem.heap
#pragma unisa use sys.fs
#pragma unisa use sys.env
/* reload_consume.c — reload_io_consume 实现（唯一新源码，无 main）。
 * 文件、目录与内存经 cx 底层（sys.fs、mem.*、zstr），不直接调 libc。
 * 前提：调用者已提交恢复后才可调用；本代码不执行恢复。
 * 信任假设：可信祖先目录、同一 session 单写者；不声称检查到
 * unlink 无竞争，也不声称排除外部替换。
 */


static void cwhy(char *why, size_t cap, const char *m) {
  if (why == NULL || cap == 0) return;
  long n = zs_len(m);
  if (n >= (long)cap) n = (long)cap - 1;
  mm_copy(why, (long)cap, m, n);
  why[n] = '\0';
}

int reload_io_consume(const char *path, const reload_io_token *token,
                      char *why, size_t cap) {
  int rc = -1;
  int dfd = -1;
  int removed = 0;
  char *buf = NULL;
  reload_io_token fresh;
  size_t len = 0;

  if (why != NULL && cap > 0) why[0] = '\0';
  mm_fill(&fresh, (long)sizeof(fresh), 0, (long)sizeof(fresh));

  if (path == NULL || token == NULL) {
    cwhy(why, cap, "null path or token");
    return -1;
  }
  if (why == NULL || cap == 0) {
    return -1;
  }
  if (path[0] != '/' || zs_len(path) > 4095) {
    cwhy(why, cap, "path not absolute or too long");
    return -1;
  }

  /* 先确认 token 各身份数组有 NUL，避免被当作 C 串越界读取。 */
  if (!zs_has_nul(token->session_id, (long)sizeof(token->session_id)) ||
      !zs_has_nul(token->handoff_id, (long)sizeof(token->handoff_id)) ||
      !zs_has_nul(token->candidate_hash, (long)sizeof(token->candidate_hash))) {
    cwhy(why, cap, "token field not NUL-terminated");
    return -1;
  }

  buf = mm_alloc(131073);
  if (buf == NULL) {
    cwhy(why, cap, "buffer allocation failed");
    return -1;
  }

  if (reload_io_load(path, token->session_id, token->handoff_id,
                     token->candidate_hash, buf, 131073, &len, &fresh,
                     why, cap) != 0) {
    mm_free(buf);
    buf = NULL;
    return -1;
  }

  if (fresh.dev != token->dev || fresh.ino != token->ino) {
    cwhy(why, cap, "file replaced: dev/ino mismatch");
    mm_free(buf);
    buf = NULL;
    return -1;
  }

  mm_free(buf);
  buf = NULL;

  {
    char dir[4096];
    const char *slash = zs_rchr(path, '/');
    size_t dlen;

    if (slash == NULL) {
      cwhy(why, cap, "path lost its slash");
      return -1;
    }
    dlen = (slash == path) ? 1 : (size_t)(slash - path);
    if (dlen + 1 > sizeof(dir)) {
      cwhy(why, cap, "parent path too long");
      return -1;
    }
    if (dlen == 1 && path[0] == '/') {
      dir[0] = '/';
      dir[1] = '\0';
    } else {
      mm_copy(dir, (long)sizeof dir, path, (long)dlen);
      dir[dlen] = '\0';
    }

    dfd = sy_open(dir, O_RDONLY | O_DIRECTORY | O_NOFOLLOW, 0);
    if (dfd < 0) {
      cwhy(why, cap, "open parent directory failed");
      return -1;
    }

    {
      sy_stat_t ds;
      if (sy_fstat(dfd, &ds) != 0 || ds.kind != 'd' ||
          ds.uid != (long)sy_euid() || (ds.mode & 0777) != 0700) {
        cwhy(why, cap, "parent dir not owned 0700 directory");
        sy_close(dfd);
        dfd = -1;
        return -1;
      }
    }
  }

  if (sy_unlink(path) != 0) {
    cwhy(why, cap, "unlink failed");
    goto done;
  }
  removed = 1;

  if (sy_fsync(dfd) != 0) {
    cwhy(why, cap, "unlinked but fsync parent failed: not durable");
    rc = -2;
    goto done;
  }

  rc = 0;
  cwhy(why, cap, "ok");

done:
  if (dfd >= 0) {
    if (sy_close(dfd) != 0) {
      if (removed) {
        cwhy(why, cap, "unlinked but close parent failed: not durable");
        rc = -2;
      } else {
        cwhy(why, cap, "close parent failed");
        rc = -1;
      }
    }
    dfd = -1;
  }
  mm_free(buf);
  buf = NULL;
  return rc;
}
