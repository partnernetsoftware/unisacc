#pragma unisa use fio
#pragma unisa use sys.io
#pragma unisa use zstr
#pragma unisa use mem.heap
#pragma unisa use reload_state
/*
 * reload_state_cli.c — feed a JSON state file to the library validator.
 *
 * WHY: reload_state.c owns the question "is this v1 state valid?". This
 * tiny CLI owns only I/O: read a file, hand the bytes to the library,
 * print PASS/FAIL plus the reason. No JSON parsing lives here.
 */

int reload_state_validate(const char *text, size_t len, char *why, size_t cap);
int reload_state_validate_v2(const char *text, size_t len, char *why, size_t cap);

#define RS_CLI_MAX 131072

int main(int argc, char **argv) {
    if (argc != 3 || (zs_cmp(argv[1], "check") != 0 && zs_cmp(argv[1], "check-v2") != 0)) {
        sy_eprintf("usage: %s check FILE\n", argv[0]);
        return 2;
    }
    int use_v2 = zs_cmp(argv[1], "check-v2") == 0;

    const char *path = argv[2];
    fio_t *f = fio_open(path, "rb");
    if (!f) {
        sy_eprintf("cannot open: %s\n", path);
        return 2;
    }
    if (fio_seek(f, 0, SEEK_END) != 0) {
        sy_eprintf("cannot seek: %s\n", path);
        fio_close(f);
        return 2;
    }
    long n = fio_tell(f);
    if (n < 0) {
        sy_eprintf("cannot size: %s\n", path);
        fio_close(f);
        return 2;
    }
    if (n > RS_CLI_MAX) {
        sy_eprintf("too large (>%d)\n", RS_CLI_MAX);
        fio_close(f);
        return 2;
    }
    fio_rewind(f);

    size_t len = (size_t)n;
    char *buf = mm_alloc(len + 1);
    if (!buf) {
        sy_eprintf("out of memory\n");
        fio_close(f);
        return 2;
    }
    size_t got = fio_read(buf, 1, len, f);
    if (got != len || fio_error(f)) {
        sy_eprintf("read error: %s\n", path);
        mm_free(buf);
        fio_close(f);
        return 2;
    }
    fio_close(f);
    buf[len] = '\0';

    char why[256];
    int ok = use_v2 ? reload_state_validate_v2(buf, len, why, sizeof why)
                    : reload_state_validate(buf, len, why, sizeof why);
    sy_printf("%s: %s\n", ok ? "PASS" : "FAIL", why);

    mm_free(buf);
    return ok ? 0 : 1;
}
