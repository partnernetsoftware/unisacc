            tui_apply_key(&th, TERM_KEY_CHAR, 0x15);
            if (!ok) { sy_printf("FAIL alt-enter [%s]\n", th.input); failures++; }
            else sy_printf("  ok   alt-enter adds a newline without sending\n");
