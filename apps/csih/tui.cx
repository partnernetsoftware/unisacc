            tui_state_init(&ta, NULL); ta.mode = 1;
            tui_type(&ta, "/allow");
            b2 = agent_danger_blocked(ACT_EXEC, "git push origin main", why, (int)sizeof why);
            b3 = agent_danger_blocked(ACT_EXEC, "git push origin main", why, (int)sizeof why);
            agent_allow_danger(0);
            if (b2 || !b3 || ta.npending)
                { sy_printf("FAIL /allow first=%d second=%d\n", b2, b3); failures++; }
            else sy_printf("  ok   /allow lets exactly one through\n");
        }
        {
            static tui_state tp;
            char why[300];
            int bad = 0;
            tui_state_init(&tp, NULL); tp.mode = 1;
            tui_type(&tp, "/perm read");
            if (agent_get_perm() != 0) bad |= 1;
            if (!agent_perm_blocked(ACT_WRITE, "", "a.txt", "/w", why, (int)sizeof why) || !zs_find(why, "/perm work")) bad |= 2;
            if (agent_perm_blocked(ACT_EXEC, "ls -la | grep x", "", "/w", why, (int)sizeof why)) bad |= 4;
            if (agent_perm_blocked(ACT_EXEC, "git status", "", "/w", why, (int)sizeof why)) bad |= 8;
            /* With the sandbox the kernel refuses the write, so the gate lets these
             * through; without it the read-only list must stop them. */
            {
                int boxed = agent_sandbox_available();
                if (agent_perm_blocked(ACT_EXEC, "cat a > b", "", "/w", why, (int)sizeof why) == boxed) bad |= 16;
                if (agent_perm_blocked(ACT_EXEC, "env", "", "/w", why, (int)sizeof why) == boxed) bad |= 32;
                if (agent_perm_blocked(ACT_EXEC, "find . -delete", "", "/w", why, (int)sizeof why) == boxed) bad |= 64;
                if (agent_perm_blocked(ACT_EXEC, "ls; rm x", "", "/w", why, (int)sizeof why) == boxed) bad |= 128;
            }
            tui_type(&tp, "/perm work");
            if (agent_perm_blocked(ACT_WRITE, "", "src/a.c", "/w", why, (int)sizeof why)) bad |= 256;
            if (agent_perm_blocked(ACT_WRITE, "", "/w/src/a.c", "/w", why, (int)sizeof why)) bad |= 512;
            if (!agent_perm_blocked(ACT_WRITE, "", "/etc/passwd", "/w", why, (int)sizeof why)) bad |= 1024;
            if (!agent_perm_blocked(ACT_EDIT, "", "../x", "/w", why, (int)sizeof why)) bad |= 2048;
            if (!agent_perm_blocked(ACT_WRITE, "", "/wx/a", "/w", why, (int)sizeof why)) bad |= 4096;
            if (agent_perm_blocked(ACT_EXEC, "make test", "", "/w", why, (int)sizeof why)) bad |= 8192;
            tui_type(&tp, "/perm any");
            agent_allow_danger(0);
            if (agent_perm_blocked(ACT_WRITE, "", "/etc/x", "/w", why, (int)sizeof why)
                || agent_danger_blocked(ACT_EXEC, "rm -rf x", why, (int)sizeof why)) bad |= 16384;
            tui_type(&tp, "/perm bogus");
            if (!zs_find(tp.log[tp.nlog - 1], "usage: /perm")) bad |= 32768;
            agent_set_perm(1);
            if (bad) { sy_printf("FAIL perm tiers bad=%d\n", bad); failures++; }
            else sy_printf("  ok   /perm read|work|any gates writes and commands\n");
        }
        {
            static tui_state tf2;
            tui_state_init(&tf2, NULL); tf2.mode = 1; tf2.rows = 24;
            tui_log_event(&tf2, "exec\t跑测试\tmake test");
            tui_log_event(&tf2, "  evidence 9-1-1-1");
            tui_log_event(&tf2, "  │ 命令退出 2");
            tui_log_event(&tf2, "exec\t看目录\tls");
            tui_log_event(&tf2, "  evidence 9-1-1-2");
            tui_log_event(&tf2, "  │ 命令退出 0");
            tui_log_event(&tf2, "  │ FOLDED-BODY");
            if (tf2.nlog != 2 || !tf2.ex_open[0] || tf2.ex_open[1])
                { sy_printf("FAIL failed tool row nlog=%d open=%d ok row open=%d\n", tf2.nlog, tf2.ex_open[0], tf2.ex_open[1]); failures++; }
            else sy_printf("  ok   failed tool row opens by itself\n");
            if (!tui_frame_has(&tf2, "· 命令退出 0") || tui_frame_has(&tf2, "FOLDED-BODY"))
                { sy_printf("FAIL closed tool row lacks status or shows body\n"); failures++; }
            else sy_printf("  ok   closed tool row is one line with status\n");
            if (!tui_frame_has(&tf2, "  │ 命令退出 2") || !tui_frame_has(&tf2, "  │ evidence 9-1-1-1")
                || tui_frame_has(&tf2, "⏎"))
                { sy_printf("FAIL open tool body not one line per row\n"); failures++; }
            else sy_printf("  ok   open tool body is one line per row\n");
            tui_apply_key(&tf2, TERM_KEY_CHAR, '\t');
            if (!tf2.ex_open[1] || tf2.ninput) { sy_printf("FAIL tab did not open newest tool row\n"); failures++; }
            else {
                tui_apply_key(&tf2, TERM_KEY_CHAR, '\t');
                if (tf2.ex_open[1]) { sy_printf("FAIL tab did not close it again\n"); failures++; }
                else sy_printf("  ok   tab toggles the newest tool row\n");
            }
            {
                char b1[16], b2[16], b3[16];
                tf2.busy = 1;
                tui_agent_event("exec\t睡一会\tsleep 3", &tf2);
                tui_bytes(b1, sizeof b1, 574); tui_bytes(b2, sizeof b2, 32839); tui_bytes(b3, sizeof b3, 3 * 1024 * 1024);
                if (zs_cmp(tf2.phase, "跑命令 sleep 3") || !tui_frame_has(&tf2, "⏳ 跑命令")
                    || zs_cmp(b1, "574B") || zs_cmp(b2, "32.1KB") || zs_cmp(b3, "3.0MB"))
                    { sy_printf("FAIL busy phase=[%s] bytes=%s %s %s\n", tf2.phase, b1, b2, b3); failures++; }
                else sy_printf("  ok   busy line names the running command and reads sizes\n");
                /* bell: never off a tty, never with CSIH_BELL=0, not for a turn just started */
                net_turn_clock();
                if (tui_should_bell(0, NULL) || tui_should_bell(1, "0") || tui_should_bell(1, NULL))
                    { sy_printf("FAIL bell rules\n"); failures++; }
                else sy_printf("  ok   bell only on a tty, not disabled, after 10s\n");
            {
                /* the first screen shows where to start; it goes once there is a log */
                static tui_state tw;
                tui_state_init(&tw, NULL); tw.mode = 1; tw.rows = 24;
                if (!tui_frame_has(&tw, "/help 看命令")) { sy_printf("FAIL welcome hint missing\n"); failures++; }
                else {
                    tui_log_plain(&tw, "x");
                    if (tui_frame_has(&tw, "/help 看命令")) { sy_printf("FAIL welcome hint stays\n"); failures++; }
                    else sy_printf("  ok   empty screen hints /help, Tab and Alt-Enter; then steps aside\n");
                }
            }
            {
                /* colour is added only on output: frames stay plain */
                char o[600];
                int okc = tui_line_color("✓ 已验收 · x") && !zs_cmp(tui_line_color("✓ 已验收 · x"), "\x1b[32m")
                    && tui_line_color("✗ 失败: x") && tui_line_color("  │ blocked: x")
                    && !tui_line_color("exec[展开]> x") && !tui_line_color("普通行");
                tui_put_line(o, sizeof o, 3, "✓ ok");
                okc = okc && !zs_cmp(o, "\x1b[3;1H\x1b[32m✓ ok\x1b[0m\x1b[K");
                tui_put_line(o, sizeof o, 4, "plain");
                okc = okc && !zs_cmp(o, "\x1b[4;1Hplain\x1b[K");
                okc = okc && !tui_frame_has(&tf2, "\x1b[");
                if (tui_env_has("NO_COLOR") || tui_env_first("CSIH_COLOR") == '0')
                    sy_printf("  skip colour: turned off by NO_COLOR/CSIH_COLOR here\n");
                else if (!okc) { sy_printf("FAIL colour\n"); failures++; }
                else sy_printf("  ok   status rows are coloured on output, frames stay plain\n");
            }
                tf2.busy = 0;
            }
        }

        {
            static tui_state ts;
            char path[256];
            fio_t *f;
            int ok = 0, room0, room1;
            tx_snprintf(path, sizeof path, "/tmp/csih-status-%d.txt", (int)sy_pid());
            f = tui_fopen(path, "w");
            if (f) {
                fio_puts("进度 37/52 .cx（盘点 tools/inventory）\n\n下一刀 grk: cx/runtime/routespan\n拒绝 not covered: x\n第四行不显示\n", f);
                fio_close(f);
                /* Short terminal, so the log room is not at its cap and the 3 rows show. */
                tui_state_init(&ts, NULL); ts.mode = 1; ts.rows = 16;
                room0 = tui_log_room(&ts);
                sy_setenv("CSIH_STATUS_FILE", path, 1);
                ok = tui_frame_has(&ts, "项目> 进度 37/52") && zs_find(ts.status[0], "秒前")
                    && tui_frame_has(&ts, "项目> 下一刀 grk") && tui_frame_has(&ts, "项目> 拒绝 not")
                    && !tui_frame_has(&ts, "第四行") && ts.nstatus == 3;
                room1 = tui_log_room(&ts);
                ok = ok && room1 == room0 - 3;
                sy_setenv("CSIH_STATUS_FILE", "/nonexistent/csih-status", 1);
                ok = ok && !tui_frame_has(&ts, "项目>") && ts.nstatus == 0;
                sy_unsetenv("CSIH_STATUS_FILE");
                if (tui_selftest_rm(path, 0)) failures++;
            }
            if (!ok) { sy_printf("FAIL project status rows n=%d\n", ts.nstatus); failures++; }
            else sy_printf("  ok   project status file shows up to 3 rows with age\n");
        }

        {
            static tui_state td;
            char dir[128], out[4096], note[400];
            agent_step s;
            int k, created = 0, plus = 0, once = 0, empty_ok;
            tx_snprintf(dir, sizeof dir, "/tmp/csih-diff-%d", (int)sy_pid());
            tui_mkdir(dir, 0700);
            tui_state_init(&td, NULL); td.mode = 1;
            while (agent_undo_depth() > 0) agent_undo_last(note, sizeof note);
            tui_type(&td, "/diff");
            empty_ok = zs_find(td.log[td.nlog - 1], "还没有改过文件") != NULL;
            s = agent_parse("{\"act\":\"file\",\"op\":\"write\",\"path\":\"d.txt\",\"text\":\"first\"}");
            agent_exec(&s, dir, out, sizeof out);
            s = agent_parse("{\"act\":\"file\",\"op\":\"write\",\"path\":\"d.txt\",\"text\":\"second\"}");
            agent_exec(&s, dir, out, sizeof out);
            tui_type(&td, "/diff");
            for (k = 0; k < td.nlog; k++) {
                if (zs_find(td.log[k], "diff: 新建") && zs_find(td.log[k], "d.txt")) { created++; once++; }
                if (zs_find(td.log[k], "+second")) plus = 1;
            }
            while (agent_undo_depth() > 0) agent_undo_last(note, sizeof note);
            tui_rmdir(dir);
            /* two writes to one new file: listed once, as new, with its current text */
            if (!empty_ok || created != 1 || !plus || once != 1)
                { sy_printf("FAIL /diff created=%d plus=%d\n", created, plus); failures++; }
            else sy_printf("  ok   /diff lists each changed file once with its diff\n");
            {
                /* two writes during a turn show up on its result row; none, nothing */
                char ch[64], doc[300];
                int ok2;
                tui_turn_undo0 = agent_undo_depth();
                tui_turn_changes(ch, sizeof ch);
                ok2 = ch[0] == 0;
                tx_snprintf(doc, sizeof doc, "{\"act\":\"file\",\"op\":\"write\",\"path\":\"/tmp/csih-turnchg-%d.txt\",\"text\":\"a\"}", (int)sy_pid());
                s = agent_parse(doc); agent_exec(&s, "/tmp", out, sizeof out);
                s = agent_parse(doc); agent_exec(&s, "/tmp", out, sizeof out);
                tui_turn_changes(ch, sizeof ch);
                ok2 = ok2 && !zs_cmp(ch, " · 改了 2 处文件（/diff 查看）");
                agent_undo_last(note, sizeof note); agent_undo_last(note, sizeof note);  /* removes the file */
                tui_turn_undo0 = -1;
                if (!ok2) { sy_printf("FAIL turn changes [%s]\n", ch); failures++; }
                else sy_printf("  ok   result row counts this turn's file changes\n");
            }
        }
        {
            static tui_state tv;
            char path[128];
            fio_t *f;
            int i, ok;
            tx_snprintf(path, sizeof path, "/tmp/csih-view-%d.txt", (int)sy_pid());
            f = tui_fopen(path, "w");
            if (f) { for (i = 1; i <= 30; i++) fio_printf(f, "line %d\n", i); fio_close(f); }
            tui_state_init(&tv, NULL); tv.mode = 1;
            tx_snprintf(tv.input, sizeof tv.input, "/view %s 25", path); tv.ninput = (int)(size_t)zs_len(tv.input);
            tui_apply_key(&tv, TERM_KEY_ENTER, 0);
            ok = zs_find(tv.log[1], "   25│ line 25") && zs_find(tv.log[tv.nlog - 1], "line 30") && !tv.npending && !tv.busy;
            tx_snprintf(tv.input, sizeof tv.input, "/view %s", path); tv.ninput = (int)(size_t)zs_len(tv.input);
            tui_apply_key(&tv, TERM_KEY_ENTER, 0);
            ok = ok && zs_find(tv.log[tv.nlog - 1], "还有更多") && zs_find(tv.log[tv.nlog - 1], " 21");
            tui_type(&tv, "/view /nonexistent/x");
            ok = ok && zs_find(tv.log[tv.nlog - 1], "cannot open");
            if (tui_selftest_rm(path, 0)) failures++;
            if (!ok) { sy_printf("FAIL /view\n"); failures++; }
            else sy_printf("  ok   /view shows numbered lines and paging\n");
        }
        {
            /* /copy without touching the user's real tmux buffer: the refusals,
             * and that the quoting survives /bin/sh byte for byte. */
            static tui_state tc2;
            static char q[600], cmd[700];
            const char *tricky = "it's \"quoted\" $HOME `x` \\n 中文";
            char *tm = sy_env("TMUX") ? mm_strdup(sy_env("TMUX")) : NULL;
            shell_result r;
            int ok;
            tui_state_init(&tc2, NULL); tc2.mode = 1;
            tui_type(&tc2, "/copy");
            ok = zs_find(tc2.log[tc2.nlog - 1], "还没有可复制") != NULL;
            tx_snprintf(tc2.last_answer, sizeof tc2.last_answer, "%s", tricky);
            sy_unsetenv("TMUX");
            tui_type(&tc2, "/copy");
            ok = ok && zs_find(tc2.log[tc2.nlog - 1], "不在 tmux") != NULL;
            if (tm) { sy_setenv("TMUX", tm, 1); mm_free(tm); }
            tui_sh_quote(q, sizeof q, tricky);
            tx_snprintf(cmd, sizeof cmd, "printf %%s %s", q);
            r = shell_run_in(cmd, "/");
            ok = ok && !zs_cmp(r.out, tricky);
            if (!ok) { sy_printf("FAIL /copy [%s]\n", r.out); failures++; }
            else sy_printf("  ok   /copy refuses when empty or outside tmux; quoting is exact\n");
        }
        {
            static tui_state tk2;
            char path[128], text[300];
            fio_t *f;
            r_frame fr;
            int i, y = 0, x = 0, ok = 0, before;
            tx_snprintf(path, sizeof path, "/tmp/csih-click-%d.txt", (int)sy_pid());
            f = tui_fopen(path, "w");
            if (f) { for (i = 1; i <= 5; i++) fio_printf(f, "row %d\n", i); fio_close(f); }
            tui_state_init(&tk2, NULL); tk2.mode = 1; tk2.rows = 24; tk2.cols = 120;
            tx_snprintf(text, sizeof text, "see %s:3 for details", path);
            tui_log_plain(&tk2, text);
            fr = tui_render_state(&tk2, 120);
            for (i = 0; i < fr.n; i++) {
                const char *p = zs_find(fr.lines[i], "/tmp/csih-click-");
                if (p) { y = i + 1; x = tui_str_cols(fr.lines[i], (int)(p - fr.lines[i])) + 5; break; }
            }
            if (y) {
                before = tk2.nlog;
                tui_click(&tk2, x, y);
                ok = tk2.nlog > before && zs_find(tk2.log[before], "view:") && zs_find(tk2.log[before + 1], "    3│ row 3");
                /* the word "details" is not a file: nothing opens */
                before = tk2.nlog;
                tui_click(&tk2, x + (int)(size_t)zs_len(path) + 8, y);
                ok = ok && tk2.nlog == before;
            }
            if (tui_selftest_rm(path, 0)) failures++;
            if (!ok) { sy_printf("FAIL click path y=%d x=%d\n", y, x); failures++; }
            else sy_printf("  ok   clicking a file path opens it in /view at path:LINE\n");
        }

        {
            /* custom command from ~/.csih/commands: expanded, then queued like a prompt */
            static tui_state tcc;
            char home[128], d[200], p[260];
            char *oldhome = sy_env("HOME") ? mm_strdup(sy_env("HOME")) : NULL;
            fio_t *f;
            int ok;
            tx_snprintf(home, sizeof home, "/tmp/csih-cmd-%d", (int)sy_pid());
            tui_mkdir(home, 0700);
            tx_snprintf(d, sizeof d, "%s/.csih", home); tui_mkdir(d, 0700);
            tx_snprintf(d, sizeof d, "%s/.csih/commands", home); tui_mkdir(d, 0700);
            tx_snprintf(p, sizeof p, "%s/greet.md", d);
            f = tui_fopen(p, "w"); if (f) { fio_puts("用中文问候 $ARGS，再说一遍 $ARGS\n", f); fio_close(f); }
            sy_setenv("HOME", home, 1);
            tui_state_init(&tcc, NULL); tcc.mode = 1; tcc.busy = 1;
            tui_type(&tcc, "/greet 小王");
            ok = tcc.npending == 1 && !zs_cmp(tcc.pending[0], "用中文问候 小王，再说一遍 小王");
            tui_type(&tcc, "/nosuchcmd");
            ok = ok && tcc.npending == 1 && zs_find(tcc.log[tcc.nlog - 1], "unknown command: /nosuchcmd");
            if (oldhome) { sy_setenv("HOME", oldhome, 1); mm_free(oldhome); }
            if (tui_selftest_rm(home, 1)) failures++;
            if (!ok) { sy_printf("FAIL custom command pending=%d [%s]\n", tcc.npending, tcc.npending ? tcc.pending[0] : ""); failures++; }
            else sy_printf("  ok   custom /command expands $ARGS from ~/.csih/commands\n");
            /* /retry queues the newest history line again */
            tui_state_init(&tcc, NULL); tcc.mode = 1; tcc.busy = 1;
            tui_type(&tcc, "/retry");
            ok = tcc.npending == 0 && zs_find(tcc.log[tcc.nlog - 1], "还没有发过");
            tx_snprintf(tcc.history[0], sizeof tcc.history[0], "跑一下测试"); tcc.nhistory = 1;
            tui_type(&tcc, "/retry");
            ok = ok && tcc.npending == 1 && !zs_cmp(tcc.pending[0], "跑一下测试");
            if (!ok) { sy_printf("FAIL /retry\n"); failures++; }
            else sy_printf("  ok   /retry sends the last prompt again\n");
            tui_type(&tcc, "/status");
            ok = tcc.nlog >= 2 && zs_find(tcc.log[tcc.nlog - 2], "状态：") && zs_find(tcc.log[tcc.nlog - 2], "权限 ")
                && zs_find(tcc.log[tcc.nlog - 1], "busy=");
            if (!ok) { sy_printf("FAIL /status overview\n"); failures++; }
            else sy_printf("  ok   /status shows a readable overview above the raw fields\n");
            {
                /* /why keeps the last 5 distinct reasons, and listing them adds none */
                int i3;
                char r[64];
                tui_state_init(&tcc, NULL); tcc.mode = 1;
                tui_type(&tcc, "/why");
                ok = zs_find(tcc.log[tcc.nlog - 1], "还没有失败") != NULL;
                for (i3 = 1; i3 <= 7; i3++) { tx_snprintf(r, sizeof r, "✗ 失败: 原因%d", i3); tui_log_plain(&tcc, r); }
                tui_log_plain(&tcc, "✗ 失败: 原因7");          /* repeat: not stored twice */
                tui_type(&tcc, "/why");
                ok = ok && tcc.why.n == 7 && zs_find(tcc.log[tcc.nlog - 5], "原因3") && zs_find(tcc.log[tcc.nlog - 1], "原因7")
                    && !zs_find(tcc.log[tcc.nlog - 5], "原因2");
                tui_type(&tcc, "/why");
                ok = ok && tcc.why.n == 7 && zs_find(tcc.log[tcc.nlog - 5], "原因3");
                if (!ok) { sy_printf("FAIL /why n=%d\n", tcc.why.n); failures++; }
                else sy_printf("  ok   /why lists the last 5 reasons, listing adds none\n");
            }
            {
                char tp[128];
                char *oldt = sy_env("CSIH_TRANSCRIPT") ? mm_strdup(sy_env("CSIH_TRANSCRIPT")) : NULL;
                tx_snprintf(tp, sizeof tp, "/tmp/csih-ctx-%d.jsonl", (int)sy_pid());
                f = tui_fopen(tp, "w");
                if (f) { fio_puts("{\"role\":\"user\",\"text\":\"a\"}\n{\"role\":\"assistant\",\"text\":\"b\"}\n{\"role\":\"user\",\"text\":\"c\"}\n", f); fio_close(f); }
                sy_setenv("CSIH_TRANSCRIPT", tp, 1);
                tui_state_init(&tcc, NULL); tcc.mode = 1;
                tui_type(&tcc, "/context");
                ok = tcc.nlog >= 2 && zs_find(tcc.log[tcc.nlog - 2], "3 条记录") && zs_find(tcc.log[tcc.nlog - 1], "每轮送最近 50 条");
                sy_setenv("CSIH_TRANSCRIPT", "/nonexistent/csih-ctx.jsonl", 1);
                tui_type(&tcc, "/context");
                ok = ok && zs_find(tcc.log[tcc.nlog - 2], "没有对话记录");
                if (oldt) { sy_setenv("CSIH_TRANSCRIPT", oldt, 1); mm_free(oldt); } else sy_unsetenv("CSIH_TRANSCRIPT");
                if (tui_selftest_rm(tp, 0)) failures++;
                if (!ok) { sy_printf("FAIL /context\n"); failures++; }
                else sy_printf("  ok   /context reports records, size and the trim rule\n");
            }
        }

        sy_printf("%s\n", failures ? "SELFTEST FAILED" : "selftest ok");
        return failures == 0 ? 0 : 1;
    }

    if (!zs_cmp(cmd, "once")) {
        /* Render a single frame to stdout and exit — usable from a pipe, which
         * is how a probe checks the frame without a terminal. */
        tui_state st;
        r_frame f;
        int i, cols = 40;
        tui_state_init(&st, NULL);
        f = tui_render_state(&st, cols);
        for (i = 0; i < f.n; i++) sy_printf("%s|\n", f.lines[i]);
        return 0;
    }

    if (!zs_cmp(cmd, "context-index")) {
        /* Dev only: bind the owned DIR like agent-owned, print the context packet
         * once, then return ownership. check.sh diffs it against a golden. */
        static tui_state st;
        static reload_io_token token;
        char why[256];
        char *packet = NULL;
        if (argc != 5) {
            sy_printf("usage: context-index DIR SESSION HASH\n");
            return 64;
        }
        if (tui_owned_start(&st, argv[2], argv[3], argv[4], NULL, NULL, &token, why, sizeof why) != 0) {
            sy_printf("owned startup refused: %s\n", why);
            return 1;
        }
        if (!context_index_packet(st.owned,st.owned_dir,&packet) || !packet) {
            sy_printf("context index failed\n");
            tui_owned_close(&st, why, sizeof why);
            return 1;
        }
        sy_printf("%s\n", packet);
        mm_free(packet);
        if (tui_owned_close(&st, why, sizeof why) != 0) {
            sy_printf("ownership return not confirmed: %s\n", why);
            return 1;
        }
        return 0;
    }

    if (!zs_cmp(cmd, "run") || !zs_cmp(cmd, "agent") ||
        !zs_cmp(cmd, "agent-owned") || !zs_cmp(cmd, "resume-agent") ||
        !zs_cmp(cmd, "agent-managed") || !zs_cmp(cmd, "standby-managed")) {
        /* The real loop. Needs a terminal; refuses politely without one rather
         * than emitting escape sequences into a pipe. `agent` is the same loop
         * in agent mode (Enter drives the DeepSeek loop instead of the gate). */
        static tui_state st;
        static reload_io_token resume_token;
        char owned_why[256];
        int cols, first = 1;
        int managed_mode = !zs_cmp(cmd, "agent-managed") || !zs_cmp(cmd, "standby-managed");
        int standby_mode = !zs_cmp(cmd, "standby-managed");
        int owned_mode = !zs_cmp(cmd, "agent-owned") || !zs_cmp(cmd, "resume-agent") || managed_mode;
        int resume_mode = !zs_cmp(cmd, "resume-agent");
        int agent_mode = zs_cmp(cmd, "run") != 0;
        if ((owned_mode && !resume_mode && !managed_mode && argc != 5) || (resume_mode && argc != 7) ||
            (managed_mode && argc != (standby_mode ? 7 : 6))) {
            sy_printf("usage: agent-owned DIR SESSION HASH | resume-agent DIR STATE SESSION HANDOFF HASH\n");
            return 64;
        }

        if (!sy_isatty(0) || !sy_isatty(1)) {
            sy_printf("tui %s needs a terminal (stdin and stdout must be ttys)\n", cmd);
            return 64;
        }
        /* `tui run [spill] [transcript]` / `tui agent [spill] [transcript]`.
         * spill writes long tool results under ~/.csih/tool. Default is off.
         * tui_state_init clears the struct, so the measured size is applied
         * after it. Doing it before left rows at the 24-line default. */
        {
            int ai;
            const char *transcript = NULL;
            agent_set_spill(0);
            if (!owned_mode) for (ai = 2; ai < argc; ai++) {
                if (!zs_cmp(argv[ai], "spill")) agent_set_spill(1);
                else if (!transcript) transcript = argv[ai];
            }
            tui_state_init(&st, transcript);
            /* Plain agent/run sessions share one input history across restarts. */
            if (!owned_mode && tui_env_has("HOME")) {
                char hf[600];
                /* bind, not mkdir: a bare mkdir here left a legacy ~/.cdsh unlinked */
                csih_home_bind(sy_env("HOME"));
                tx_snprintf(hf, sizeof hf, "%s/.csih/history", sy_env("HOME"));
                tui_history_load(&st, hf);
            }
        }
        if (managed_mode && tui_managed_init(argv[2], argv[3], standby_mode ? argv[4] : "initial",
                standby_mode ? argv[5] : argv[4], standby_mode ? argv[6] : argv[5], standby_mode) != 0) {
            sy_printf("managed startup refused\n"); return 1;
        }
        if (owned_mode && !standby_mode && tui_owned_start(&st, argv[2], resume_mode ? argv[4] : argv[3],
                 resume_mode ? argv[6] : argv[4], resume_mode ? argv[3] : NULL,
                 resume_mode ? argv[5] : NULL, &resume_token, owned_why, sizeof owned_why) != 0) {
            sy_printf("owned startup refused: %s\n", owned_why);
            if (tui_owned_close(&st, owned_why, sizeof owned_why) != 0)
                sy_printf("ownership return not confirmed: %s\n", owned_why);
            return 1;
        }
        st.mode = agent_mode ? 1 : 0;
        {
            term_size_t sz = term_size();
            cols = sz.cols;
            st.rows = sz.rows;
            /* render pads to at most R_MAX_COLS. A wider pane used to fail
             * the width check and draw nothing, so the window stayed blank. */
            if (cols > R_MAX_COLS) cols = R_MAX_COLS;
            if (st.rows > R_MAX_LINES) st.rows = R_MAX_LINES;
            if (st.rows < 1) st.rows = 24;
            st.cols = cols;
        }
        r_frame_init(&tui_prev);
        term_install_exit_handler(term_on_signal);
        if (!standby_mode && term_raw_enter() != 0) {
            sy_printf("cannot enter raw mode\n");
            if (tui_owned_close(&st, owned_why, sizeof owned_why) != 0)
                sy_printf("ownership return not confirmed: %s\n", owned_why);
            return 1;
        }
        /* Commit point: validated UI/context applied, ownership held, raw TTY
         * ready. Consume exactly once; cleanup failure is not a second apply. */
        if (resume_mode && tr_consume(argv[3], &resume_token, owned_why, sizeof owned_why) != 0) {
            term_raw_leave();
            sy_printf("restore committed; state cleanup failed: %s; do not reapply\n", owned_why);
            if (tui_owned_close(&st, owned_why, sizeof owned_why) != 0)
                sy_printf("ownership return not confirmed: %s\n", owned_why);
            return 1;
        }
        if (managed_mode) {
            tui_managed.raw = !standby_mode;
            if (tui_managed_send(standby_mode ? "READY" : "ACK", 0) != 0) st.quit = 1;
        }
        if (owned_mode && !standby_mode) tui_log_plain(&st, "owned session; HASH is explicit binding, not verified source identity");

        while (!st.quit && !term_interrupted()) {
            if (managed_mode) {
                unsigned short re0 = 0, re1 = 0;
                tui_managed_poll(&st);
                if (st.quit) break;
                if (tui_managed.phase != 3) {
                    shell_poll2(tui_managed.fd, -1, TUI_FRAME_MS, &re0, &re1);
                    continue;
                }
            }
            if (st.busy && !agent_turn_step(0)) tui_turn_done(&st);
            if (!st.busy && st.npending > 0 && st.mode == 1) {
                tui_run_pending(&st);
            }
            tui_mail_poll(&st, !st.busy && st.npending == 0 && st.mode == 1);
            /* Drain everything that has arrived into the queue FIRST, then
             * consume exactly one key per redraw. Consuming the read directly
             * is what lost 14 of 15 characters: one read returns a whole typed
             * line, and one key per tick threw the rest away. */
            if (tui_q_empty(&st)) {
                /* A busy turn says how long it may wait: 0 with work ready,
                 * 10ms with a request in flight. A whole frame here was up to
                 * 250ms lost on every step (turn_latency: Enter -> request
                 * 263ms, request -> request 930ms around a 5ms exec). */
                int wait_ms = st.busy ? agent_turn_wait_ms(TUI_FRAME_MS) : TUI_FRAME_MS;
                int ready = term_wait_readable(wait_ms);
                if (ready < 0) break;             /* terminal gone */
                if (ready == 1) {
                    /* Read in BULK and split into keys. Calling term_read_key()
                     * once per frame was the data-loss bug: one read returns a
                     * whole typed line, and term_parse_key() given fifteen
                     * bytes returns a single UNKNOWN — fourteen characters
                     * gone. See term_read_keys' header. */
                    term_key_t batch[64];
                    int room = tui_q_room(&st);
                    int nk = term_read_keys(batch, room < 64 ? room : 64);
                    int j;
                    for (j = 0; j < nk; j++) tui_q_push(&st, batch[j]);
                } else {
                    /* The idle tick keeps its frame cadence: short busy
                     * waits add up to one frame before it fires. */
                    static int short_wait;
                    short_wait += wait_ms;
                    if (short_wait >= TUI_FRAME_MS) {
                        short_wait = 0;
                        tui_apply_key(&st, -1, 0);
                        tui_repaint = 1;
                    }
                }
            }
            while (!tui_q_empty(&st)) {
                term_key_t k = tui_q_pop(&st);
                st.more_keys = !tui_q_empty(&st);
                if (k.kind == TERM_KEY_MOUSE) tui_click(&st, k.x, k.y);
                else if (k.kind == TERM_KEY_WHEEL)
                    tui_wheel(&st, k.y, (int)(unsigned char)k.ch);
                else tui_apply_key(&st, (int)k.kind, k.ch);
            }
            st.more_keys = 0;
            {
                term_size_t sz = term_size();
                if (sz.source) {
                    int c = sz.cols, r = sz.rows;
                    if (c > R_MAX_COLS) c = R_MAX_COLS;
                    if (r > R_MAX_LINES) r = R_MAX_LINES;
                    if (c != st.cols || r != st.rows) {
                        st.cols = c;
                        st.rows = r;
                        tui_repaint = 1;
                    }
                }
            }
            /* Redraw against the shared previous frame (tui_redraw also serves
             * the live agent events, so the two stay consistent). */
            tui_redraw(&st);
            if (first) { tui_write_all("\x1b[?25l", 6); first = 0; }
        }
        if (!managed_mode || (!tui_managed.retired && tui_managed.raw && st.owner_fd >= 0)) {
            char sum[300];
            term_raw_leave();
            /* 11 bytes. A hard-coded 9 cut "\x1b[0m" to "\x1b[0", and the next
             * byte printed (the shell prompt, or this summary's 'c') finished
             * it as "\x1b[0c", a device-attributes query: the character
             * vanished and the terminal's ^[[?1;2c reply was echoed. */
            static const char restore[] = "\x1b[?25h\x1b[0m\n";
            tui_write_all(restore, sizeof restore - 1);
            /* One line left in the terminal: what this session cost and changed. */
            if (!managed_mode && tui_session_summary(sum, sizeof sum)) sy_printf("%s\n", sum);
        }
        if (managed_mode) sy_close(tui_managed.fd);
        /* Successful retirement must not restore TTY state over the new actor. */
        /* show cursor, reset, newline */
        if (tui_owned_close(&st, owned_why, sizeof owned_why) != 0) {
            sy_printf("ownership return not confirmed: %s\n", owned_why); return 1;
        }
        return 0;
    }

    sy_printf("usage: tui selftest | once | run | agent | agent-owned DIR SESSION HASH | resume-agent DIR STATE SESSION HANDOFF HASH\n");
    return 64;
}

/* Product main lives in csih.cx so this unit stays a library under `#pragma unisa use tui`. */
