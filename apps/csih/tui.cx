            rr.outcome = AGENT_OUTCOME_FAILED;
            tx_snprintf(rr.reason, sizeof rr.reason, "unfinished: answer outcome=failed");
            tui_result_row(row, sizeof row, &rr);
            if (zs_cmp(row, "✗ 失败: 模型报告未能完成")) { sy_printf("FAIL model-failed row: %s\n", row); failures++; }
            else sy_printf("  ok   model-reported failure is ✗ with a Chinese reason\n");
            zs_mset(&rr, 0, sizeof rr);
            rr.ok = 1; rr.rounds = 1; rr.actions = 3; rr.acceptance = AGENT_ACCEPT_ACCEPTED;
            tx_snprintf(rr.answer, sizeof rr.answer, "done");
            tx_snprintf(rr.reason, sizeof rr.reason, "semantic acceptance (work): records match");
            net_turn_clock();   /* elapsed 0: the row leaves the time out */
            tui_turn_undo0 = -1; /* no turn in flight: no file-change note */
            tui_done_row(row, sizeof row, &rr);
            if (zs_cmp(row, "✓ 已验收 · 本轮结束 1 轮 3 步 · records match")) { sy_printf("FAIL done row: %s\n", row); failures++; }
