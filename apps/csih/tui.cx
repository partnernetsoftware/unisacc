            tui_result_row(row, sizeof row, &rr);
            if (zs_cmp(row, "✗ 失败: http 401")) { sy_printf("FAIL failed row: %s\n", row); failures++; }
            else sy_printf("  ok   failed row uses ✗ 失败\n");
