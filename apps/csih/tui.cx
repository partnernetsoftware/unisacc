            for (s = "你好"; *s; s++) tui_apply_key(&tq, TERM_KEY_CHAR, *s);
            tui_apply_key(&tq, TERM_KEY_LEFT, 0);
            tui_apply_key(&tq, TERM_KEY_CHAR, 'a');
            if (zs_cmp(tq.input, "你a好")) okc = 0;
            if (!okc) { sy_printf("FAIL cursor editing: [%s] back=%d\n", tq.input, tq.back); failures++; }
            else sy_printf("  ok   cursor moves and edits mid-line\n");
            tui_apply_key(&tq, TERM_KEY_CHAR, 0x15);
