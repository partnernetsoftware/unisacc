            tui_apply_key(&tq, TERM_KEY_LEFT, 0);
            tui_apply_key(&tq, TERM_KEY_CHAR, 'l');
            if (zs_cmp(tq.input, "hello") || !tui_frame_has(&tq, "> hell▏o")) okc = 0;
            tui_apply_key(&tq, TERM_KEY_CHAR, 0x01);
            tui_apply_key(&tq, TERM_KEY_CHAR, 'X');
            if (zs_cmp(tq.input, "Xhello")) okc = 0;
            tui_apply_key(&tq, TERM_KEY_RIGHT, 0);
            tui_apply_key(&tq, TERM_KEY_BACKSPACE, 0);
