            for (k = 0; k < 400; k++) { zw[1 + 2 * k] = (char)0xCC; zw[2 + 2 * k] = (char)0x81; }   /* U+0301 */
            zw[801] = 0;
            for (k = 0; k < (int)sizeof fit; k++) fit[k] = 'Z';
            n = tui_utf8_fit(zw, 5, fit, 64);
            if (n >= 64 || fit[n] != 0 || fit[64] != 'Z') { sy_printf("FAIL zero-width run overran the fit buffer: n=%d\n", n); failures++; }
            else sy_printf("  ok   zero-width codepoints cannot overrun the fit buffer\n");
