#pragma unisa module tui
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use sys.io
#pragma unisa use zstr
#pragma unisa use fio
/* A call must see the declaration in this unit. These were only reachable through
   agent or zstr, so the prototypes were missing and the call was implicit. A unit
   takes at most 32 uses: the eight reload modules come through tui_reload. */
#pragma unisa use sys.env
#pragma unisa use sys.fs
#pragma unisa use sys.proc
#pragma unisa use sys.posix
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use home
#pragma unisa use clock
#pragma unisa use render
#pragma unisa use term
#pragma unisa use cols
#pragma unisa use chat
#pragma unisa use tools
#pragma unisa use file
#pragma unisa use shell
#pragma unisa use json
#pragma unisa use session
#pragma unisa use agent
#pragma unisa use net
#pragma unisa use tui_reload
#pragma unisa use csih_message_io
#pragma unisa use context_index
#pragma unisa use os_safedel

/* the first byte of environment variable NAME, 0 when unset or empty
   (the compiler takes no subscript of a call's result) */
static int tui_env_first(const char *name) { const char *v = sy_env(name); return v ? (unsigned char)v[0] : 0; }
static int tui_env_has(const char *name) { return tui_env_first(name) != 0; }

/* sys.fs with the libc calls' shape: 0, or -1 with errno */
static int tui_errno(int r) { if (r < 0) { errno = -r; return -1; } return r; }
/* getcwd's shape: DST, or 0 with errno */
static char *tui_getcwd(char *dst, int cap) { int r = sy_cwd(dst, cap); if (r < 0) { errno = -r; return 0; } return dst; }
static int tui_rename(const char *a, const char *b) { return tui_errno(sy_rename(a, b)); }
/* fopen's shape: errno is per compilation unit, so fio's code is copied into this one */
static fio_t *tui_fopen(const char *p, const char *mode) { fio_t *f = fio_open(p, mode); if (!f) errno = fio_errno(); return f; }
static int tui_mkdir(const char *p, int mode) { return tui_errno(sy_mkdir(p, mode)); }
static int tui_rmdir(const char *p) { return tui_errno(sy_unlinkat(sy_at_fdcwd(), p, 1)); }

/*
 * tui.c — the main loop. This is the file that finally puts term.c and
 * render.c together, and it is deliberately the SMALLEST of the three.
 *
 * WHAT IT DOES, in full: wait for a byte or for the frame interval to elapse,
 * fold that into the screen state, render the state to a frame, diff the frame
 * against the previous one, write the difference. That is the entire TUI. No
 * virtual tree, no reconciler, no widget layer — see TUI-INTERFACE.md §2 for
 * why copying Ink's reconciler would import React's complexity for a UI that
 * has a handful of screens.
 *
 * WHAT IS DELIBERATELY NOT HERE: any string formatting (render.c), any ANSI
 * sequence (render.c's frame_diff), any syscall (term.c). Every one of those
 * splits exists so the decision-making is testable without a terminal, and
 * this file — the untestable part — holds nothing but the wiring.
 *
 * TWO DESIGN DECISIONS CAME FROM AN INDEPENDENT REVIEW (dsh-new), NOT FROM ME,
 * and both corrected a plan of mine that was wrong:
 *
 *   1. "Forget strcmp's cost; the cost is writing one character at a time."
 *      I had been about to add long-line protection around the line compare.
 *      Wrong target. frame_diff() already builds a whole line into the buffer
 *      before writing, and tui_write_line() below asserts it goes out in ONE
 *      write() — that is what the review said to protect.
 *
 *   2. "A line containing a raw NUL makes strcmp stop early and MISS a change."
 *      Screen lines should never contain NUL, so this is asserted rather than
 *      handled: silently diffing two lines as equal is a redraw that never
 *      happens, which presents to a user as a frozen screen. That failure mode
 *      is worth a hard stop.
 *
 * CLI takes SUBCOMMANDS, not dash-options (unisacc reserves the dashes), and
 * `tui selftest` runs with NO terminal attached — the loop is driven by an
 * injected key source, so the part that would normally need a human at a
 * keyboard is exercised in CI.
 */
/* the one deletion guard (commissar ruling 2026-10-23): the selftest's removals go through unisa_safedel(); its
   fixtures live under the temp root ($TMPDIR, or /tmp), the guard's whitelist */

/* Include the HEADERS, never the .c files. The first version did
 * `#include "render.c"` / `#include "term.c"`, which dragged in two more
 * `main`s and two more `failures` counters and would not link — the same
 * "two mains" rule this project has enforced all along, broken by a new route. */

#define tui_next_cp csih_next_cp
#define tui_cp_cols csih_cp_cols

/* Types and symbols for chat/tools/agent/shell/net come from `#pragma unisa use`. */

/* How long a loop waits before redrawing anyway. Frames only change on input in
 * this design, so this is a safety net rather than the animation clock — but
 * keeping it means a state change from elsewhere cannot leave the screen stale
 * forever. CXIF exports file-scope types: bounds must be enum, not #define. */
enum {
    tui_frame_ms = 250,
    tui_input_max = 4096, /* a paste is one buffer, not one 240-byte line */
    tui_loop_max = 8,     /* goal resubmits, same order of magnitude as a turn */
    tui_log_view = 40,    /* agent log rows; a shorter terminal uses fewer */
    TUI_FRAME_MS = 250,
    TUI_INPUT_MAX = 4096,
    TUI_LOOP_MAX = 8,
    TUI_LOG_VIEW = 40
};

/* Last 5 failure/refusal reasons for /why (see the why member below). */
typedef struct { char text[5][240]; long t[5]; int n; } tui_why_ring;

typedef struct {
    char input[tui_input_max];   /* what the user has typed */
    int  ninput;
    char pending[8][tui_input_max]; /* lines typed while a call is in flight */
    int  npending;
    char history[16][tui_input_max]; /* accepted manual lines, oldest first */
    int  nhistory;
    int  history_pos;              /* browsing cursor; == nhistory means tail */
    int  history_browsing;         /* 1 while Up/Down is walking history */
    char history_draft[tui_input_max]; /* draft saved on the first Up */
    int  quit;                   /* leave the program */
    int  ask_exit;               /* empty Ctrl-C: say Ctrl-D quits, do not quit */
    int  pasting;                /* inside ESC [ 200 ~ ... ESC [ 201 ~ */
    int  more_keys;              /* 1 when this key is not the last of the burst */
    int  cancel;                 /* stop this turn and return to the input */
    int  busy;                   /* 1 while a model call is in flight */
    int  busy_tick;              /* ticks when busy became 1 */
    char phase[64];              /* what the in-flight request is doing now */
    int  ended;                  /* 1 when phase holds a stop cause, not a live call */
    int  ticks;                  /* loop iterations; not printed in agent mode */
    const char *notice;          /* one-line feedback, e.g. an unknown key */
    const char *transcript;      /* where turns are recorded; NULL = no chat */
    char journal_path[4096];     /* owned path after inactive snapshot apply */
    reload_session_state *owned; /* explicit startup context, heap owned by main */
    char owned_dir[4096];
    int owner_fd;
    char  last[192];             /* most recent verdict, so it can be shown */
    char  output[1024];          /* last tool output, shown in the frame */

    /*
     * A QUEUE of keys, not a single key — because one read() can return many.
     *
     * This is not a theoretical concern: a pty delivers a whole typed line in
     * one chunk, and the first version of this loop called term_read_key()
     * once per poll tick, so `hello from tui\r` produced ONE key ('h') and
     * silently dropped the other fourteen bytes. The symptom was a transcript
     * line reading {"role":"user","text":""} after visibly typing a sentence —
     * a data-loss bug that looks like a rendering bug.
     *
     * So: drain what arrived into this queue, then consume one key per
     * iteration. Keys are never discarded; only the polling is one-per-tick.
     */
    term_key_t queue[64];
    int  qhead, qtail;

    int  mode;            /* 0 = chat, 1 = agent */
    int  cols;            /* usable width, from term_size */
    int  rows;            /* usable height, from term_size */
    char log[40][240];    /* agent event scrollback (ring buffer) */
    int  nlog;
    int  ex_on[40];             /* 1 when this log slot is a tool row */
    int  ex_open[40];           /* 1 shows the tool body; 0 is the summary */
    char ex_tag[40][12];
    char ex_why[40][96];
    char ex_cmd[40][120];
    char ex_body[40][1024];     /* tool output, drawn only while open */
    char last_answer[4096];       /* whole answer (agent caps it at 4096), for /copy */
    char errline[240];        /* last error, shown on the status row, not in the log */
    char goal[tui_input_max]; /* /goal text; empty until set */
    int  loop_on;             /* /loop arms automatic resubmit */
    int  loop_left;           /* remaining auto-submits this arming */
    int  sys_open;            /* 0: system rule only. 1: ten body rows */
    int  sys_top;             /* first wrapped row shown while open */
    int  mind_top;            /* first folded row of the mind block */
    int  mind_open;           /* 0: mind rule only. 1: folded mind rows */
    int  log_skip;            /* newest log entries hidden; 0 follows the tail */
    char mail_id[33];         /* in-flight message id, empty when idle */
    int  mail_active;         /* 1 while a take()ed message is being handled */
    int  mail_blocked;        /* 1 when take() yielded nothing usable */
    long mail_next_ms;        /* next poll deadline, from clock_now_ms */
    char mail_error[256];     /* last take/finish failure reason */
    char model[96];           /* /model override for this session; empty uses CSIH_MODEL */
    int  back;                /* cursor distance from the end of input, in bytes; 0 = at end */
    char status[3][240];      /* project status rows, read from the status file each frame */
    int  nstatus;
    char rsearch[256];        /* Ctrl-R needle, taken from the input at the first press */
    int  rsearch_at;          /* 1 + index of the last match; 0 = not searching */
    /* Last 5 failure/refusal reasons for /why, as a ring; n counts all pushed,
     * the newest is text[(n-1)%5]. One nested member: unisacc caps how many
     * members a struct may have, and tui_state is at that cap. */
    tui_why_ring why;
} tui_state;

static int tui_mail_meta(tui_state *st, const char *id, const char *result, const char *reason);
static void tui_mail_complete(tui_state *st, const char *result, const char *reason);
static void tui_mail_poll(tui_state *st, int tasks_allowed);

static void tui_state_init(tui_state *st, const char *transcript) {
    zs_mset(st, 0, sizeof *st);
    st->transcript = transcript;
    st->owner_fd = -1;
    st->mode = 0;
    st->cols = 40;
    st->rows = 24;
    st->notice = 0;
    (void)transcript;
}

/* These helpers prepare an inactive restore only; they do not transfer
 * startup context, journal ownership, or a running request. */
static int tui_reload_error(char *why, size_t cap, const char *message) {
    if (why && cap) tx_snprintf(why, cap, "%s", message);
    return -1;
}

static int tui_reload_valid(const reload_session_state *snapshot,
                            char *why, size_t cap) {
    char *scratch = mm_alloc(1048576);
    size_t len = 0;
    int rc;
    if (!scratch) return tui_reload_error(why, cap, "reload allocation failed");
    rc = tr_session_encode(snapshot, scratch, 1048576, &len, why, cap);
    mm_free(scratch);
    return rc;
}

static int tui_reload_capture(const tui_state *st,
                              const reload_session_state *metadata,
                              reload_session_state *out, char *why, size_t cap) {
    size_t i;
    if (!out) return tui_reload_error(why, cap, "reload null output");
    if (!st || !metadata || out == metadata) {
        zs_mset(out, 0, sizeof *out);
        return tui_reload_error(why, cap, "reload null or aliased input");
    }
    zs_mset(out, 0, sizeof *out);
    if (st->busy) return tui_reload_error(why, cap, "reload busy");
    if (st->npending < 0 || st->npending > 8 || st->nhistory < 0 || st->nhistory > 16 ||
        st->history_pos < 0 || st->history_pos > st->nhistory)
        return tui_reload_error(why, cap, "reload counts out of range");
    zs_mcpy(out->session_id, metadata->session_id, sizeof out->session_id);
    zs_mcpy(out->handoff_id, metadata->handoff_id, sizeof out->handoff_id);
    zs_mcpy(out->candidate_hash, metadata->candidate_hash, sizeof out->candidate_hash);
    zs_mcpy(out->cwd, metadata->cwd, sizeof out->cwd);
    zs_mcpy(out->role, metadata->role, sizeof out->role);
    zs_mcpy(out->peer, metadata->peer, sizeof out->peer);
    zs_mcpy(out->journal_path, metadata->journal_path, sizeof out->journal_path);
    out->journal_offset = metadata->journal_offset;
    zs_mcpy(out->goal, st->goal, sizeof out->goal);
    zs_mcpy(out->input, st->input, sizeof out->input);
    zs_mcpy(out->history_draft, st->history_draft, sizeof out->history_draft);
    out->npending = (size_t)st->npending;
    out->nhistory = (size_t)st->nhistory;
    out->history_pos = (size_t)st->history_pos;
    out->history_browsing = st->history_browsing;
    out->loop_on = st->loop_on;
    out->loop_left = st->loop_left;
    for (i = 0; i < out->npending; i++)
        zs_mcpy(out->pending[i], st->pending[i], sizeof out->pending[i]);
    for (i = 0; i < out->nhistory; i++)
        zs_mcpy(out->history[i], st->history[i], sizeof out->history[i]);
    if (tui_reload_valid(out, why, cap) != 0) {
        zs_mset(out, 0, sizeof *out);
        return -1;
    }
    return 0;
}

static int tui_reload_apply(tui_state *st, const reload_session_state *snapshot,
                            char *why, size_t cap) {
    size_t i;
    if (!st || !snapshot) return tui_reload_error(why, cap, "reload null input");
    if (st->busy) return tui_reload_error(why, cap, "reload busy");
    if (tui_reload_valid(snapshot, why, cap) != 0) return -1;
    zs_mcpy(st->goal, snapshot->goal, sizeof st->goal);
    zs_mcpy(st->input, snapshot->input, sizeof st->input);
    st->ninput = (int)(size_t)zs_len(st->input);
    zs_mset(st->pending, 0, sizeof st->pending);
    zs_mset(st->history, 0, sizeof st->history);
    st->npending = (int)snapshot->npending;
    st->nhistory = (int)snapshot->nhistory;
    for (i = 0; i < snapshot->npending; i++)
        zs_mcpy(st->pending[i], snapshot->pending[i], sizeof st->pending[i]);
    for (i = 0; i < snapshot->nhistory; i++)
        zs_mcpy(st->history[i], snapshot->history[i], sizeof st->history[i]);
    zs_mcpy(st->history_draft, snapshot->history_draft, sizeof st->history_draft);
    st->history_pos = (int)snapshot->history_pos;
    st->history_browsing = snapshot->history_browsing;
    st->loop_on = snapshot->loop_on;
    st->loop_left = snapshot->loop_left;
    zs_mcpy(st->journal_path, snapshot->journal_path, sizeof st->journal_path);
    st->transcript = st->journal_path;
    return 0;
}

/* Export/prepare assume idle single-writer ownership and trusted ancestors.
 * prepare intentionally uses checkpoint: it fsyncs the journal while checking
 * its current exact length, without reading/replaying or consuming anything. */
static int tui_reload_export(const tui_state *st,
                             const reload_session_state *metadata,
                             const char *path, char *why, size_t cap) {
    reload_session_state *work = NULL, *snapshot = NULL;
    char *encoded = NULL;
    size_t len = 0;
    long long offset = 0;
    int rc = -1;
    if (!st || !metadata || !path)
        return tui_reload_error(why, cap, "reload null input");
    if (st->busy) return tui_reload_error(why, cap, "reload busy");
    if (!zs_mchr(metadata->journal_path, 0, sizeof metadata->journal_path))
        return tui_reload_error(why, cap, "journal path not terminated");
    work = mm_alloc(sizeof *work);
    snapshot = mm_alloc(sizeof *snapshot);
    encoded = mm_alloc(131073);
    if (!work || !snapshot || !encoded) {
        tui_reload_error(why, cap, "reload allocation failed");
        goto done;
    }
    zs_mcpy(work, metadata, sizeof *work);
    if (tr_journal_checkpoint(work->journal_path, &offset, why, cap) != 0) goto done;
    work->journal_offset = (unsigned long long)offset;
    if (tui_reload_capture(st, work, snapshot, why, cap) != 0) goto done;
    if (tr_session_encode(snapshot, encoded, 131073, &len, why, cap) != 0) goto done;
    rc = tr_save(path, encoded, len, why, cap);
    if (rc == -2)
        tui_reload_error(why, cap, "state replaced; durability not confirmed");
 done:
    mm_free(encoded);
    mm_free(snapshot);
    mm_free(work);
    return rc;
}

static int tui_reload_prepare_bound(const char *path, const char *expected_session,
                              const char *expected_handoff, const char *expected_hash,
                              const char *expected_journal,
                              reload_session_state *out, reload_io_token *token,
                              char *why, size_t cap) {
    char *text = NULL;
    size_t len = 0;
    long long offset = 0;
    int rc = -1;
    if (out) zs_mset(out, 0, sizeof *out);
    if (token) zs_mset(token, 0, sizeof *token);
    if (!path || !expected_session || !expected_handoff || !expected_hash || !out || !token)
        return tui_reload_error(why, cap, "reload null input");
    text = mm_alloc(131073);
    if (!text) return tui_reload_error(why, cap, "reload allocation failed");
    if (tr_load(path, expected_session, expected_handoff, expected_hash,
                       text, 131073, &len, token, why, cap) != 0) goto done;
    if (tr_session_decode(text, len, out, why, cap) != 0) goto done;
    if (expected_journal && zs_cmp(out->journal_path, expected_journal)) {
        tui_reload_error(why, cap, "snapshot journal not bound to owned directory");
        goto done;
    }
    if (tr_journal_checkpoint(out->journal_path, &offset, why, cap) != 0) goto done;
    if ((unsigned long long)offset != out->journal_offset) {
        tui_reload_error(why, cap, "journal length != snapshot offset");
        goto done;
    }
    rc = 0;
 done:
    mm_free(text);
    if (rc != 0) {
        zs_mset(out, 0, sizeof *out);
        zs_mset(token, 0, sizeof *token);
    }
    return rc;
}

static int tui_reload_prepare(const char *path, const char *session,
                              const char *handoff, const char *hash,
                              reload_session_state *out, reload_io_token *token,
                              char *why, size_t cap) {
    return tui_reload_prepare_bound(path, session, handoff, hash, NULL, out, token, why, cap);
}

/* Runtime capacities are those of the real agent, not the wider codec. */
static int tui_owned_id(const char *s, int empty) {
    size_t i;
    if (!s || (!empty && !s[0]) || (size_t)zs_len(s) > 4095) return 0;
    for (i = 0; s[i]; i++) {
        unsigned char c = (unsigned char)s[i];
        if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
              (c >= '0' && c <= '9') || zs_chr("_-.:", c))) return 0;
    }
    return 1;
}

static int tui_owned_runtime(const reload_session_state *m, char *why, size_t cap) {
    size_t i;
    if ((size_t)zs_len(m->journal_path) >= 512 || (size_t)zs_len(m->cwd) >= 1024 ||
        m->cwd[0] != '/' || (size_t)zs_len(m->peer) > 48 || (size_t)zs_len(m->role) >= 16)
        return tui_reload_error(why, cap, "owned runtime path/peer capacity exceeded");
    for (i = 0; m->peer[i]; i++) {
        unsigned char c = (unsigned char)m->peer[i];
        if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
              (c >= '0' && c <= '9') || zs_chr(":_-", c)))
            return tui_reload_error(why, cap, "owned runtime peer invalid");
    }
    return 0;
}

static int tui_owned_start(tui_state *st, const char *dir, const char *session,
                           const char *hash, const char *state_path, const char *handoff,
                           reload_io_token *token, char *why, size_t cap) {
    char lock[4096], journal[4096];
    const char *v;
    size_t i;
    int fd, dfd;
    sy_stat_t sb;
    reload_session_state *m;
    if (!dir || dir[0] != '/' || (size_t)zs_len(dir) > 4000 || dir[(size_t)zs_len(dir)-1] == '/' ||
        !tui_owned_id(session, 0) || !hash || (size_t)zs_len(hash) != 64 ||
        (state_path && !tui_owned_id(handoff, 0)))
        return tui_reload_error(why, cap, "owned arguments invalid");
    for (i = 0; i < 64; i++)
        if (!zs_chr("0123456789abcdefABCDEF", hash[i]))
            return tui_reload_error(why, cap, "owned hash must be 64 hex (explicit binding only)");
    tx_snprintf(lock, sizeof lock, "%s/owner.lock", dir);
    tx_snprintf(journal, sizeof journal, "%s/journal.jsonl", dir);
    if ((size_t)zs_len(journal) >= 512)
        return tui_reload_error(why, cap, "owned journal exceeds agent capacity");
    if (tr_owner_acquire(lock, &st->owner_fd, why, cap) != 0) return -1;
    m = mm_alloc(sizeof *m);
    if (!m) return tui_reload_error(why, cap, "owned context allocation failed");
    zs_mset(m, 0, sizeof *m); st->owned = m;
    tx_snprintf(st->owned_dir, sizeof st->owned_dir, "%s", dir);
    if (state_path) {
        if (tui_reload_prepare_bound(state_path, session, handoff, hash, journal, m, token, why, cap) != 0) return -1;
        if (zs_cmp(m->journal_path, journal))
            return tui_reload_error(why, cap, "snapshot journal not bound to owned directory");
    } else {
        tx_snprintf(m->session_id, sizeof m->session_id, "%s", session);
        tx_snprintf(m->candidate_hash, sizeof m->candidate_hash, "%s", hash);
        tx_snprintf(m->handoff_id, sizeof m->handoff_id, "initial");
        tx_snprintf(m->journal_path, sizeof m->journal_path, "%s", journal);
        v = sy_env("CSIH_CWD");
        if (v && v[0]) {
            if ((size_t)zs_len(v) >= 1024) return tui_reload_error(why, cap, "owned cwd exceeds agent capacity");
            tx_snprintf(m->cwd, sizeof m->cwd, "%s", v);
        } else if (!tui_getcwd(m->cwd, (int)sizeof m->cwd))
            return tui_reload_error(why, cap, "owned getcwd failed");
        v = sy_env("CSIH_ROLE");
        if (!v || !v[0]) v = "agent";
        if (!tui_owned_id(v, 0)) return tui_reload_error(why, cap, "owned role invalid");
        tx_snprintf(m->role, sizeof m->role, "%s", v);
        v = sy_env("CSIH_PEER");
        if (!v) v = "";
        if (!tui_owned_id(v, 1)) return tui_reload_error(why, cap, "owned peer invalid");
        tx_snprintf(m->peer, sizeof m->peer, "%s", v);
    }
    if (tui_owned_runtime(m, why, cap) != 0) return -1;
    dfd = sy_open(m->cwd, O_RDONLY | O_DIRECTORY, 0);
    if (dfd < 0) return tui_reload_error(why, cap, "owned cwd not enterable directory");
    if (sy_close(dfd) != 0 || sy_chdir(m->cwd) != 0)
        return tui_reload_error(why, cap, "owned cwd activation failed");
    if (!state_path) {
        fd = sy_open(journal, O_RDWR | O_CREAT | O_NOFOLLOW | O_CLOEXEC, 0600);
        if (fd < 0) return tui_reload_error(why, cap, "owned journal open failed");
        if (sy_fstat(fd, &sb) != 0 || sb.kind != 'f' || sb.uid != (long)sy_uid() ||
            (sb.mode & 0777) != 0600) {
            sy_close(fd); return tui_reload_error(why, cap, "owned journal not trusted regular file");
        }
        if (sy_close(fd) != 0) return tui_reload_error(why, cap, "owned journal close failed");
    }
    if (tui_reload_apply(st, m, why, cap) != 0) return -1;
    if (sy_setenv("CSIH_CWD", m->cwd, 1) != 0 || sy_setenv("CSIH_ROLE", m->role, 1) != 0 ||
        sy_setenv("CSIH_PEER", m->peer, 1) != 0)
        return tui_reload_error(why, cap, "owned startup environment failed");
    if (agent_role_configure(m->role, m->peer) != 0)
        return tui_reload_error(why, cap, "owned agent role configuration failed");
    return 0;
}

static int tui_owned_close(tui_state *st, char *why, size_t cap) {
    int rc = 0;
    if (st->owner_fd >= 0) rc = tr_owner_release(&st->owner_fd, why, cap);
    mm_free(st->owned); st->owned = NULL;
    return rc;
}

/* Forward declarations: the key handler (defined below) dispatches to
 * tui_run_agent, which drives the agent and redraws live. */
static void tui_redraw(tui_state *st);
static int tui_run_agent(tui_state *st);
static void tui_apply_key(tui_state *st, int kind, char ch);
static void tui_submit(tui_state *st);
static void tui_log_hold(tui_state *st);
static void tui_log_scroll(tui_state *st, int delta);
static int tui_log_room(const tui_state *st);
static r_frame tui_render_state(tui_state *st, int cols);
static const char *csih_env(const char *neu, const char *old);

/* ── the key queue ──────────────────────────────────────────────────────── */

static int tui_q_empty(const tui_state *st) { return st->qhead == st->qtail; }

/* One slot stays empty so head==tail means empty. Reading more than this
 * from the tty drops the overflow: those bytes are already gone. */
static int tui_q_room(const tui_state *st) {
    int cap = (int)(sizeof st->queue / sizeof st->queue[0]);
    int used = (st->qtail - st->qhead + cap) % cap;
    return cap - 1 - used;
}

static void tui_q_push(tui_state *st, term_key_t k) {
    int next = (st->qtail + 1) % (int)(sizeof st->queue / sizeof st->queue[0]);
    if (next == st->qhead) return;   /* full: drop rather than corrupt the ring */
    st->queue[st->qtail] = k;
    st->qtail = next;
}

static term_key_t tui_q_pop(tui_state *st) {
    term_key_t k;
    zs_mset(&k, 0, sizeof k);
    k.kind = TERM_KEY_NONE;
    if (tui_q_empty(st)) return k;
    k = st->queue[st->qhead];
    st->qhead = (st->qhead + 1) % (int)(sizeof st->queue / sizeof st->queue[0]);
    return k;
}

/* ── output ─────────────────────────────────────────────────────────────── */

/*
 * Write a whole string with ONE write() call.
 *
 * A loop of putchar() per character is the classic TUI performance bug the
 * review named. One write per changed line also matters for a second reason: a
 * line written in pieces can be interleaved with output from another process
 * sharing the terminal, producing torn lines that look like a rendering bug.
 *
 * Returns 0 on success, -1 if the terminal is gone (nothing to do about it
 * except stop looping, which the caller does).
 */
static int tui_write_all(const char *s, size_t n) {
    return sy_write_all(1, s, (long)n) == 0 ? 0 : -1;   /* resumes after EINTR; 0 written is an error */
}

/*
 * Every line must cover `width` terminal columns. Byte length is not enough:
 * one CJK character is 3 bytes and 2 columns, so a byte-padded line stops
 * early and the old glyphs stay on the right. An embedded NUL still fails,
 * because the visible width then falls short.
 *
 * The first version of this function compared (size_t)zs_len(x) != (size_t)zs_len(x), which is
 * always false: a check that can never fire, written to look like a safeguard.
 * That is worse than no check, because it is quoted as one. The review's point
 * stands — frame_diff() uses strcmp, which stops at a NUL, so a line with an
 * embedded NUL compares equal to a longer line and the redraw never happens,
 * which a user sees as a frozen screen.
 */
static int tui_disp_width(const char *s);

static int tui_frame_bad_width(const r_frame *f, int width) {
    int i;
    for (i = 0; i < f->n; i++) {
        if (tui_disp_width(f->lines[i]) != width) return 1;
    }
    return 0;
}

/* ── the loop, with its inputs injected ─────────────────────────────────── */

/*
 * One iteration: fold a key (or a timeout) into the state.
 *
 * Split from the loop so it can be driven by a scripted key sequence in the
 * self-test. `key_kind` is a term_key_kind; -1 means "the wait timed out".
 */
static void tui_history_add(tui_state *st, const char *text) {
    if (!text || !text[0]) return;
    if (st->nhistory > 0 && !zs_cmp(st->history[st->nhistory - 1], text)) {
        st->history_pos = st->nhistory;
        st->history_browsing = 0;
        return;
    }
    if (st->nhistory >= 16) {
        zs_mmove(st->history[0], st->history[1], (size_t)(16 - 1) * TUI_INPUT_MAX);
        st->nhistory = 16 - 1;
    }
    tx_snprintf(st->history[st->nhistory], TUI_INPUT_MAX, "%s", text);
    st->nhistory++;
    st->history_pos = st->nhistory;
    st->history_browsing = 0;
}

static void tui_history_move(tui_state *st, int delta) {
    st->back = 0;
    if (st->nhistory <= 0) return;
    if (!st->history_browsing) {
        if (delta >= 0) return;
        tx_snprintf(st->history_draft, TUI_INPUT_MAX, "%s", st->input);
        st->history_browsing = 1;
        st->history_pos = st->nhistory;
    }
    {
        int pos = st->history_pos + delta;
        if (pos < 0) pos = 0;
        if (pos > st->nhistory) pos = st->nhistory;
        st->history_pos = pos;
    }
    if (st->history_pos >= st->nhistory) {
        tx_snprintf(st->input, TUI_INPUT_MAX, "%s", st->history_draft);
        st->history_browsing = 0;
    } else {
        tx_snprintf(st->input, TUI_INPUT_MAX, "%s", st->history[st->history_pos]);
    }
    st->ninput = (int)(size_t)zs_len(st->input);
}

static void tui_enqueue(tui_state *st) {
    if (!st->input[0]) return;
    if (st->npending >= 8) { st->notice = "待发送已满"; return; }
    tx_snprintf(st->pending[st->npending], TUI_INPUT_MAX, "%s", st->input);
    st->npending++;
    st->input[0] = '\0';
    st->ninput = 0;
}

static void tui_dequeue(tui_state *st) {
    if (st->npending <= 0) return;
    tx_snprintf(st->input, TUI_INPUT_MAX, "%s", st->pending[0]);
    st->ninput = (int)(size_t)zs_len(st->input);
    zs_mmove(st->pending[0], st->pending[1], (size_t)(st->npending - 1) * TUI_INPUT_MAX);
    st->npending--;
}

static void tui_log_make_room(tui_state *st) {
    if (st->nlog < 40) return;
    zs_mmove(st->log[0], st->log[1], sizeof st->log[0] * 39);
    zs_mmove(st->ex_on, st->ex_on + 1, sizeof st->ex_on[0] * 39);
    zs_mmove(st->ex_open, st->ex_open + 1, sizeof st->ex_open[0] * 39);
    zs_mmove(st->ex_tag[0], st->ex_tag[1], sizeof st->ex_tag[0] * 39);
    zs_mmove(st->ex_why[0], st->ex_why[1], sizeof st->ex_why[0] * 39);
    zs_mmove(st->ex_cmd[0], st->ex_cmd[1], sizeof st->ex_cmd[0] * 39);
    zs_mmove(st->ex_body[0], st->ex_body[1], sizeof st->ex_body[0] * 39);
    st->nlog = 39;
    st->ex_on[39] = 0;
    st->ex_open[39] = 0;
    st->ex_tag[39][0] = 0;
    st->ex_why[39][0] = 0;
    st->ex_cmd[39][0] = 0;
    st->ex_body[39][0] = 0;
}

static void tui_note_err(tui_state *st, const char *s);

static void tui_log_plain(tui_state *st, const char *s) {
    tui_log_make_room(st);
    st->ex_on[st->nlog] = 0;
    st->ex_open[st->nlog] = 0;
    st->ex_tag[st->nlog][0] = 0;
    st->ex_why[st->nlog][0] = 0;
    st->ex_cmd[st->nlog][0] = 0;
    st->ex_body[st->nlog][0] = 0;
    tx_snprintf(st->log[st->nlog], sizeof st->log[0], "%s", s ? s : "");
    st->nlog++;
    tui_log_hold(st);
    tui_note_err(st, s);
}

static void tui_log_line(tui_state *st, const char *s) {
    tui_log_plain(st, s);
}

/* First N bytes of a tool call, cut on a UTF-8 boundary. A longer call
 * keeps an ellipsis so the closed row stays a summary. */
static void tui_condense(char *dst, int dstmax, const char *src, int maxb) {
    int i = 0;
    if (!dst || dstmax < 1) return;
    if (!src) src = "";
    while (src[i] && i + 1 < dstmax && i < maxb) {
        dst[i] = src[i];
        i++;
    }
    while (i > 0 && ((unsigned char)dst[i - 1] & 0xC0) == 0x80) i--;
    if (src[i] && i + 4 < dstmax) {
        zs_mcpy(dst + i, "…", 3);
        i += 3;
    }
    dst[i] = 0;
}

/* `exec<TAB>why<TAB>cmd` or `fold<TAB>tag<TAB>why<TAB>call`.
 * Closed row shows why and a short call. The body stays hidden. */
static int tui_exec_fields(const char *line, char *why, int wn, char *cmd, int cn) {
    const char *p, *tab;
    int n;
    if (!line || zs_ncmp(line, "exec\t", 5) != 0) return 0;
    p = line + 5;
    tab = zs_chr(p, '\t');
    if (!tab) return 0;
    n = (int)(tab - p);
    if (n >= wn) n = wn - 1;
    if (n < 0) n = 0;
    zs_mcpy(why, p, (size_t)n);
    why[n] = 0;
    tx_snprintf(cmd, (size_t)cn, "%s", tab + 1);
    if (!why[0]) tx_snprintf(why, (size_t)wn, "%s", "(无解释)");
    return 1;
}

/* fold<TAB>tag<TAB>why<TAB>call. tag is the word in front of [展开]. */
static int tui_fold_fields(const char *line, char *tag, int tn,
                           char *why, int wn, char *cmd, int cn) {
    const char *p, *t1, *t2;
    int n;
    if (!line || zs_ncmp(line, "fold\t", 5) != 0) return 0;
    p = line + 5;
    t1 = zs_chr(p, '\t');
    if (!t1) return 0;
    n = (int)(t1 - p);
    if (n >= tn) n = tn - 1;
    if (n < 0) n = 0;
    zs_mcpy(tag, p, (size_t)n);
    tag[n] = 0;
    p = t1 + 1;
    t2 = zs_chr(p, '\t');
    if (!t2) return 0;
    n = (int)(t2 - p);
    if (n >= wn) n = wn - 1;
    if (n < 0) n = 0;
    zs_mcpy(why, p, (size_t)n);
    why[n] = 0;
    tx_snprintf(cmd, (size_t)cn, "%s", t2 + 1);
    if (!tag[0]) tx_snprintf(tag, (size_t)tn, "tool");
    if (!why[0]) tx_snprintf(why, (size_t)wn, "%s", "(无解释)");
    return 1;
}

/* Tool output is `  │ ...`. It belongs to the tool row above it. */
static const char *tui_bar_text(const char *line) {
    if (!line || zs_ncmp(line, "  │ ", 6) != 0) return 0;
    return line + 6;
}

static void tui_body_add(tui_state *st, int i, const char *s) {
    char *b = st->ex_body[i];
    size_t n = (size_t)zs_len(b);
    size_t cap = sizeof st->ex_body[0];
    if (!s) s = "";
    if (n && n + 1 < cap) b[n++] = '\n';
    while (*s && n + 1 < cap) b[n++] = *s++;
    b[n] = 0;
}

static int tui_looks_err(const char *s);

static void tui_log_event(tui_state *st, const char *line) {
    char tag[12], why[96], cmd[120];
    const char *bar = tui_bar_text(line);
    /* The evidence label belongs to the tool row above, so its body still folds. */
    if (line && !zs_ncmp(line, "  evidence ", 11) && st->nlog > 0 && st->ex_on[st->nlog - 1]) {
        tui_body_add(st, st->nlog - 1, line + 2);
        return;
    }
    if (bar && st->nlog > 0 && st->ex_on[st->nlog - 1]) {
        tui_body_add(st, st->nlog - 1, bar);
        tui_note_err(st, line);
        /* A failing tool shows its body without a click. */
        if (tui_looks_err(bar)) st->ex_open[st->nlog - 1] = 1;
        return;
    }
    tui_log_make_room(st);
    tag[0] = 0;
    if (tui_exec_fields(line, why, (int)sizeof why, cmd, (int)sizeof cmd))
        tx_snprintf(tag, sizeof tag, "exec");
    else if (!tui_fold_fields(line, tag, (int)sizeof tag, why, (int)sizeof why,
                              cmd, (int)sizeof cmd))
        tag[0] = 0;
    if (tag[0]) {
        st->ex_on[st->nlog] = 1;
        st->ex_open[st->nlog] = 0;
        tx_snprintf(st->ex_tag[st->nlog], sizeof st->ex_tag[0], "%s", tag);
        tx_snprintf(st->ex_why[st->nlog], sizeof st->ex_why[0], "%s", why);
        tx_snprintf(st->ex_cmd[st->nlog], sizeof st->ex_cmd[0], "%s", cmd);
        st->ex_body[st->nlog][0] = 0;
        tx_snprintf(st->log[st->nlog], sizeof st->log[0], "%s[展开]> %s", tag, why);
    } else {
        st->ex_on[st->nlog] = 0;
        st->ex_open[st->nlog] = 0;
        st->ex_tag[st->nlog][0] = 0;
        st->ex_why[st->nlog][0] = 0;
        st->ex_cmd[st->nlog][0] = 0;
        st->ex_body[st->nlog][0] = 0;
        tx_snprintf(st->log[st->nlog], sizeof st->log[0], "%s", line ? line : "");
    }
    st->nlog++;
    tui_log_hold(st);
    tui_note_err(st, line);
}

/* One status row under the hint. Kernel lines such as nfs still hit the tty,
 * but anything the harness itself saw is copied here so it does not have to
 * sit in the middle of the frame. */
static int tui_looks_err(const char *s) {
    if (!s) return 0;
    if (zs_find(s, "error:")) return 1;
    if (zs_find(s, "not covered")) return 1;
    if (zs_find(s, "not responding")) return 1;
    if (zs_find(s, "is alive again")) return 1;
    if (zs_find(s, "✗")) return 1;
    if (zs_find(s, "◐ 做完未验证")) return 1;
    if (zs_find(s, "操作失败")) return 1;
    if (zs_find(s, "blocked:")) return 1;       /* the refusal sentence is the useful reason */
    if (zs_ncmp(s, "命令退出 ", 13) == 0 && zs_cmp(s + 13, "0")) return 1;
    if (zs_find(s, "exit=") && !zs_find(s, "exit=0")) return 1;
    return 0;
}

static void tui_note_err(tui_state *st, const char *s) {
    int i, o = 0;
    if (!s) return;
    /* A quote of source or tool body (x.c:/x.h: lines) is never a turn
     * error, even when the quoted text happens to contain exit=1. */
    if (zs_find(s, ".c:") || zs_find(s, ".h:")) return;
    /* A later success in the same turn clears the stale error row. */
    if (!tui_looks_err(s) &&
        (zs_find(s, "exit=0") || zs_find(s, "selftest ok") || zs_find(s, " ok "))) {
        st->errline[0] = '\0';
        return;
    }
    /* A step trace indented "  \u2502 .../x.c:..." is the tool's own body text,
     * so an exit=1 printed there is not a turn error. Real tool failures and
     * plain exit=/error: lines still paint 错误>. */
    if (s[0] == ' ' && s[1] == ' ' &&
        (unsigned char)s[2] == 0xE2 && (unsigned char)s[3] == 0x94 && (unsigned char)s[4] == 0x82 &&
        zs_find(s, ".c:"))
        return;
    if (!tui_looks_err(s)) return;
    for (i = 0; s[i] && o + 1 < (int)sizeof st->errline; i++) {
        char c = s[i];
        if (c == '\n' || c == '\r' || c == '\t') c = ' ';
        st->errline[o++] = c;
    }
    st->errline[o] = 0;
    /* Keep the last 5 reasons for /why; the error row itself is overwritten. */
    if (st->why.n == 0 || zs_cmp(st->why.text[(st->why.n - 1) % 5], st->errline)) {
        tx_snprintf(st->why.text[st->why.n % 5], sizeof st->why.text[0], "%s", st->errline);
        st->why.t[st->why.n % 5] = (long)net_now();
        st->why.n++;
    }
}

/* The line a live turn actually runs. Only the user's goal. The write gate
 * stays in the system prompt, and is not repeated onto this task. */
static void tui_goal_prompt(const tui_state *st, char *out, int n) {
    tx_snprintf(out, (size_t)n,
             "目标：%s。继续这一目标，做完就停。",
             st->goal);
}

static void tui_drop_goal_pending(tui_state *st) {
    char want[TUI_INPUT_MAX];
    int i, w = 0;
    if (!st->goal[0]) { return; }
    tui_goal_prompt(st, want, (int)sizeof want);
    for (i = 0; i < st->npending; i++) {
        if (!zs_cmp(st->pending[i], want)) continue;
        if (w != i) zs_mcpy(st->pending[w], st->pending[i], TUI_INPUT_MAX);
        w++;
    }
    st->npending = w;
}

static void tui_queue_goal(tui_state *st) {
    char line[TUI_INPUT_MAX];
    if (!st->goal[0] || st->npending >= 8) return;
    if (st->loop_left <= 0) {
        st->loop_on = 0;
        return;
    }
    tui_goal_prompt(st, line, (int)sizeof line);
    tx_snprintf(st->pending[st->npending], TUI_INPUT_MAX, "%s", line);
    st->npending++;
    st->loop_left--;
}

/* Slash commands never start a model turn. /loop on queues the goal so the
 * live loop can start it while idle. Returns 1 when the line was one. */
static int tui_managed_request(tui_state *st);

/* Recognize command tokens only, never absolute paths or multiline pastes. */
static int tui_command_len(const char *text) {
    int i = 1;
    if (!text || text[0] != '/' || zs_chr(text, '\n') || zs_chr(text, '\r')) return 0;
    if (!((text[i] >= 'A' && text[i] <= 'Z') || (text[i] >= 'a' && text[i] <= 'z'))) return 0;
    for (i = 2; text[i]; i++) {
        char c = text[i];
        if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
              (c >= '0' && c <= '9') || c == '_' || c == '-')) break;
    }
    return text[i] == 0 || text[i] == ' ' ? i : 0;
}

static int tui_archives(const char *path, long *stamps, int max);

/* /new: move the transcript aside so the next turn starts with no history.
 * The old file is kept as PATH.<seconds>.jsonl. Returns 0 on success. */
static int tui_new_context(const char *path, char *note, size_t cap) {
    char old[4200];
    fio_t *f;
    if (!path || !path[0]) { tx_snprintf(note, cap, "new: no transcript path"); return 1; }
    f = tui_fopen(path, "r");
    if (!f) {
        if (errno == ENOENT) { tx_snprintf(note, cap, "new: 已是空上下文"); return 0; }
        tx_snprintf(note, cap, "new: cannot open %s: %s", path, sy_strerror(errno));
        return 1;
    }
    fio_close(f);
    {
        /* Never overwrite an archive: two moves in one second bump the stamp.
         * And stay newest, so /resume 1 is always the one just moved aside. */
        long stamp = (long)net_now(), have[1];
        int tries = 0;
        if (tui_archives(path, have, 1) == 1 && have[0] >= stamp) stamp = have[0] + 1;
        do tx_snprintf(old, sizeof old, "%s.%ld.jsonl", path, stamp++);
        while (sy_exists(old) == 1 && ++tries < 100);
        if (tries >= 100) { tx_snprintf(note, cap, "new: no free archive name"); return 1; }
    }
    if (tui_rename(path, old) != 0) {
        tx_snprintf(note, cap, "new: cannot move transcript: %s", sy_strerror(errno));
        return 1;
    }
    tx_snprintf(note, cap, "new: 已开新上下文；旧转录存为 %.180s", old);
    return 0;
}

/* Archived transcripts next to PATH, newest first: PATH.<seconds>.jsonl.
 * Fills stamps[] and returns how many (at most max). */
static int tui_archives(const char *path, long *stamps, int max) {
    static char names[65536];
    char dir[512];
    const char *base = zs_rchr(path, '/');
    const char *p;
    size_t bl;
    int n = 0, i, j;
    if (!base) return 0;
    tx_snprintf(dir, sizeof dir, "%.*s", (int)(base - path), path);
    base++;
    bl = (size_t)zs_len(base);
    if (!file_list(dir[0] ? dir : "/", names, sizeof names).ok) return 0;
    for (p = names; *p; ) {
        const char *nl = zs_chr(p, '\n');
        size_t len = nl ? (size_t)(nl - p) : (size_t)zs_len(p);
        /* base "." digits ".jsonl" */
        if (len > bl + 7 && !zs_ncmp(p, base, bl) && p[bl] == '.'
            && !zs_ncmp(p + len - 6, ".jsonl", 6)) {
            long v = 0;
            size_t k;
            int digits = 1;
            for (k = bl + 1; k < len - 6; k++) {
                if (p[k] < '0' || p[k] > '9') { digits = 0; break; }
                v = v * 10 + (p[k] - '0');
            }
            if (digits && v > 0) {
                /* Insert sorted, newest first; drop the oldest past max. */
                for (i = 0; i < n && stamps[i] > v; i++) ;
                if (i < max) {
                    for (j = (n < max ? n : max - 1); j > i; j--) stamps[j] = stamps[j - 1];
                    stamps[i] = v;
                    if (n < max) n++;
                }
            }
        }
        if (!nl) break;
        p = nl + 1;
    }
    return n;
}

/* First user line of a transcript, for the /resume list. */
static void tui_first_user(const char *file, char *out, size_t cap) {
    static char buf[8192];
    const char *u = NULL, *t, *e;
    int lines = 0;
    /* Transcripts are large; file_read refuses those, so read the head only. */
    fio_t *f = tui_fopen(file, "r");
    out[0] = 0;
    if (!f) return;
    while (lines++ < 64 && fio_gets(buf, sizeof buf, f))
        if ((u = zs_find(buf, "\"role\":\"user\""))) break;
    fio_close(f);
    if (!u) return;
    t = zs_find(u, "\"text\":\"");
    if (!t) return;
    t += 8;
    e = zs_chr(t, '"');
    if (!e) e = t + (size_t)zs_len(t);
    {
        int len = (int)(e - t);
        if (len > 120) {
            len = 120;
            while (len > 0 && ((unsigned char)t[len] & 0xC0) == 0x80) len--;
        }
        tx_snprintf(out, cap, "%.*s", len, t);
    }
}

/* /resume shared: copy the old shared journal (one file for every cwd, before
 * per-directory journals) in as this cwd's newest archive. The original is
 * left alone. Returns 0 on success. */
static int tui_import_shared(const char *path, const char *shared, char *note, size_t cap) {
    static char buf[65536];
    char dst[600];
    fio_t *in, *out;
    size_t n;
    long stamp = (long)net_now();
    int tries = 0;
    in = tui_fopen(shared, "r");
    if (!in) { tx_snprintf(note, cap, "resume: 没有旧的共享对话记录 %.200s", shared); return 1; }
    {
        /* Newest, so it is archive 1: archives bumped past now must not outrank it. */
        long have[1];
        if (tui_archives(path, have, 1) == 1 && have[0] >= stamp) stamp = have[0] + 1;
    }
    do tx_snprintf(dst, sizeof dst, "%s.%ld.jsonl", path, stamp++);
    while (sy_exists(dst) == 1 && ++tries < 100);
    /* sy_exists above found dst free; "wx" is not available on every libc here. */
    out = tries < 100 ? tui_fopen(dst, "w") : NULL;
    if (!out) { fio_close(in); tx_snprintf(note, cap, "resume: cannot create %s", dst); return 1; }
    while ((n = fio_read(buf, 1, sizeof buf, in)) > 0)
        if (fio_write(buf, 1, n, out) != n) { fio_close(in); fio_close(out); tx_snprintf(note, cap, "resume: copy failed"); return 1; }
    fio_close(in);
    if (fio_close(out) != 0) { tx_snprintf(note, cap, "resume: copy failed"); return 1; }
    tx_snprintf(note, cap, "resume: 已把旧的共享对话记录复制为本目录的归档 1，/resume 1 换回");
    return 0;
}

/* /resume N: archive the live transcript, then bring archive N back. */
static int tui_resume(const char *path, int pick, char *note, size_t cap) {
    long stamps[9];
    char from[600], why[400];
    int n = tui_archives(path, stamps, 9);
    if (pick < 1 || pick > n) { tx_snprintf(note, cap, "resume: 没有第 %d 个归档（共 %d 个）", pick, n); return 1; }
    tx_snprintf(from, sizeof from, "%s.%ld.jsonl", path, stamps[pick - 1]);
    if (tui_new_context(path, why, sizeof why) != 0) { tx_snprintf(note, cap, "%s", why); return 1; }
    if (tui_rename(from, path) != 0) {
        tx_snprintf(note, cap, "resume: cannot restore: %s", sy_strerror(errno));
        return 1;
    }
    tx_snprintf(note, cap, "resume: 已换回 %ld 的转录；之前的已归档", stamps[pick - 1]);
    return 0;
}

/* Tab after "/pre": one match completes it (plus a space), several complete
 * the shared prefix and list the candidates. Built-ins and custom commands
 * from ./.csih/commands and ~/.csih/commands. */
static void tui_complete_command(tui_state *st) {
    static const char *builtin[] = {
        "/help", "/status", "/clear", "/goal", "/loop", "/reload", "/reload-code", "/export-state",
        "/exit", "/quit", "/model", "/cwd", "/cost", "/perm", "/allow", "/new", "/resume", "/undo",
        "/diff", "/view", "/copy", "/retry", "/context", "/compact", "/net", "/export", "/why", NULL
    };
    static char names[64][64];
    char dirs[2][600], listing[8192], line[240];
    const char *home = sy_env("HOME");
    int n = 0, i, d, plen = (int)(size_t)zs_len(st->input), common = -1;
    for (i = 0; builtin[i] && n < 64; i++)
        if (!zs_ncmp(builtin[i], st->input, (size_t)plen)) tx_snprintf(names[n++], sizeof names[0], "%s", builtin[i]);
    tx_snprintf(dirs[0], sizeof dirs[0], ".csih/commands");
    tx_snprintf(dirs[1], sizeof dirs[1], "%s/.csih/commands", home ? home : "");
    for (d = 0; d < 2; d++) {
        const char *p;
        if (!file_list(dirs[d], listing, sizeof listing).ok) continue;
        for (p = listing; *p && n < 64; ) {
            const char *nl = zs_chr(p, '\n');
            size_t len = nl ? (size_t)(nl - p) : (size_t)zs_len(p);
            if (len > 3 && len < 60 && !zs_ncmp(p + len - 3, ".md", 3)) {
                char cand[64];
                int dup = 0;
                tx_snprintf(cand, sizeof cand, "/%.*s", (int)(len - 3), p);
                for (i = 0; i < n; i++) if (!zs_cmp(names[i], cand)) dup = 1;
                if (!dup && !zs_ncmp(cand, st->input, (size_t)plen)) tx_snprintf(names[n++], sizeof names[0], "%s", cand);
            }
            if (!nl) break;
            p = nl + 1;
        }
    }
    if (!n) { st->notice = "没有匹配的命令"; return; }
    for (i = 0; i < n; i++) {
        int k = 0;
        if (common < 0) { common = (int)(size_t)zs_len(names[0]); continue; }
        while (k < common && names[i][k] == names[0][k]) k++;
        common = k;
    }
    if (n == 1) tx_snprintf(st->input, TUI_INPUT_MAX, "%s ", names[0]);
    else if (common > plen) tx_snprintf(st->input, TUI_INPUT_MAX, "%.*s", common, names[0]);
    st->ninput = (int)(size_t)zs_len(st->input);
    st->back = 0;
    if (n > 1) {
        size_t o = (size_t)tx_snprintf(line, sizeof line, "可选：");
        for (i = 0; i < n && o + 20 < sizeof line; i++) o += (size_t)tx_snprintf(line + o, sizeof line - o, "%s ", names[i]);
        tui_log_plain(st, line);
    }
}

/* Single-quote s for /bin/sh. */
static void tui_sh_quote(char *out, size_t cap, const char *s) {
    size_t n = 0;
    if (cap < 3) { if (cap) out[0] = 0; return; }
    out[n++] = '\'';
    for (; *s && n + 6 < cap; s++) {
        if (*s == '\'') { zs_mcpy(out + n, "'\\''", 4); n += 4; }
        else out[n++] = *s;
    }
    out[n++] = '\'';
    out[n] = 0;
}

/* /compact: archive the transcript like /new, then start the new one with a
 * single user record quoting the last 5 user requests and the last answer.
 * Quoted, not summarised by the model: no tokens spent, every word checkable,
 * nothing invented. Returns 0 on success. */
static int tui_compact(const char *path, const char *last_answer, char *note, size_t cap) {
    static char summary[6000], rec[20000];
    char why[400];
    const char *users[5];
    jvalue *held[5];
    session_records recs = session_read(path);
    size_t i, o;
    int nu = 0, k;
    fio_t *f;
    zs_mset(held, 0, sizeof held);
    for (i = recs.count; i > 0 && nu < 5; i--) {
        char err[128];
        jvalue *v = json_parse(recs.lines[i - 1], (size_t)zs_len(recs.lines[i - 1]), err, sizeof err);
        const char *role = v ? jstr(jget(v, "role")) : NULL, *text = v ? jstr(jget(v, "text")) : NULL;
        if (role && text && !zs_cmp(role, "user") && text[0] && zs_ncmp(text, "此前对话摘录", 18)) {
            held[nu] = v; users[nu++] = text;
        } else if (v) jfree(v);
    }
    if (!nu && !(last_answer && last_answer[0])) {
        session_free(&recs);
        tx_snprintf(note, cap, "compact: 没有可保留的内容，用 /new 即可");
        return 1;
    }
    o = (size_t)tx_snprintf(summary, sizeof summary, "此前对话摘录（csih /compact 原文摘录，不是模型总结；完整记录已归档，可 /resume 换回）：\n用户最近的请求（旧→新）：\n");
    for (k = nu - 1; k >= 0 && o + 8 < sizeof summary; k--)
        o += (size_t)tx_snprintf(summary + o, sizeof summary - o, "- %.600s\n", users[k]);
    if (last_answer && last_answer[0] && o + 8 < sizeof summary)
        o += (size_t)tx_snprintf(summary + o, sizeof summary - o, "上一轮答复：%.2000s\n", last_answer);
    for (k = 0; k < nu; k++) jfree(held[k]);
    session_free(&recs);
    if (tui_new_context(path, why, sizeof why) != 0) { tx_snprintf(note, cap, "%s", why); return 1; }
    if (!json_rec(rec, sizeof rec, "role", "user", "text", summary, NULL, NULL)) {
        tx_snprintf(note, cap, "compact: 摘录太长"); return 1;
    }
    f = tui_fopen(path, "w");
    if (!f) { tx_snprintf(note, cap, "compact: cannot write %s", path); return 1; }
    fio_printf(f, "%s\n", rec);
    fio_close(f);
    tx_snprintf(note, cap, "compact: 已归档完整记录，新上下文保留 %d 条请求%s的原文摘录", nu, last_answer && last_answer[0] ? "和上一轮答复" : "");
    return 0;
}

/* /export: the transcript as Markdown. User text under "## 你", the answer
 * text out of each act=answer object under "## csih", tool output in a fence
 * (first 1500 bytes each). Judge rows, decisions and other internals are left
 * out. Returns the number of sections written, -1 on error. */
static int tui_export(const char *transcript, const char *dest, char *note, size_t cap) {
    session_records recs = session_read(transcript);
    fio_t *f;
    size_t i;
    int sections = 0;
    if (!recs.count) { session_free(&recs); tx_snprintf(note, cap, "export: 当前没有对话记录"); return -1; }
    f = tui_fopen(dest, "w");
    if (!f) { session_free(&recs); tx_snprintf(note, cap, "export: cannot write %.200s: %s", dest, sy_strerror(errno)); return -1; }
    fio_printf(f, "# csih 对话导出\n\n");
    for (i = 0; i < recs.count; i++) {
        char err[128];
        jvalue *v = json_parse(recs.lines[i], (size_t)zs_len(recs.lines[i]), err, sizeof err);
        const char *role = v ? jstr(jget(v, "role")) : NULL, *text = v ? jstr(jget(v, "text")) : NULL;
        if (!role || !text) { if (v) jfree(v); continue; }
        if (!zs_cmp(role, "user")) {
            fio_printf(f, "## 你\n\n%s\n\n", text); sections++;
        } else if (!zs_cmp(role, "assistant")) {
            /* Only answers: the text of an act=answer object, or plain prose. */
            jvalue *a = json_parse(text, (size_t)zs_len(text), err, sizeof err);
            const char *act = a ? jstr(jget(a, "act")) : NULL, *body = a ? jstr(jget(a, "text")) : NULL;
            if (a && act && !zs_cmp(act, "answer") && body) { fio_printf(f, "## csih\n\n%s\n\n", body); sections++; }
            else if (!a && text[0] != '{') { fio_printf(f, "## csih\n\n%s\n\n", text); sections++; }
            if (a) jfree(a);
        } else if (!zs_cmp(role, "tool")) {
            const char *name = jstr(jget(v, "name"));
            size_t n = (size_t)zs_len(text);
            fio_printf(f, "### 工具 %s\n\n```\n%.*s%s\n```\n\n", name ? name : "", (int)(n > 1500 ? 1500 : n), text,
                    n > 1500 ? "\n…（截断）" : "");
            sections++;
        }
        jfree(v);
    }
    session_free(&recs);
    if (fio_close(f) != 0) { tx_snprintf(note, cap, "export: write failed"); return -1; }
    tx_snprintf(note, cap, "export: %d 段写入 %.200s", sections, dest);
    return sections;
}

static void tui_command_done(tui_state *st) {
    st->input[0] = 0;
    st->ninput = 0;
}

static int tui_slash(tui_state *st) {
    int token = tui_command_len(st->input);
    char note[240];
    if (!token) return 0;
    if (!zs_cmp(st->input, "/help")) {
        /* Grouped by what you want to do. Every row stays under the 240-byte log row. */
        tui_log_plain(st, "【会话】/model [名]: 看/换模型；/cwd: 工作目录；/clear: 清屏（上下文保留）；/exit /quit: 退出");
        tui_log_plain(st, "【对话】/new 新上下文 · /resume [N|shared] 换回归档 · /compact 只留摘录 · /retry 重发 · /export [路径] 导出 · /context 规模");
        tui_log_plain(st, "【文件】/view PATH [LINE] 看文件 · /diff 本次改动 · /undo 撤销一步（不含 exec）· /copy 答复进 tmux 缓冲");
        tui_log_plain(st, "【安全】/perm read|work|any 权限档 · /net on|off work 档网络 · /allow 放行一条危险命令");
        tui_log_plain(st, "【信息】/status 概览 · /cost 词元 · /why 最近失败原因 · /help 本帮助；//foo 发送字面 /foo");
        tui_log_plain(st, "【目标】/goal [text] 设目标 · /loop 目标循环 · /reload 重读密钥 · /reload-code、/export-state（owned 会话）");
        tui_log_plain(st, "【按键】Esc 取消/清输入 · Alt-Enter 换行 · Tab 补全命令或展开工具行 · Ctrl-U/W/R 清行/删词/搜历史；自定义命令 .csih/commands/名字.md");
        tui_command_done(st);
        return 1;
    }
    if (!zs_ncmp(st->input, "/model", 6) && token == 6) {
        const char *arg = st->input + 6;
        while (*arg == ' ') arg++;
        if (!*arg) {
            const char *m = st->model[0] ? st->model : csih_env("CSIH_MODEL", "CDSH_MODEL");
            tx_snprintf(note, sizeof note, "model: %s%s", m ? m : "deepseek-chat", st->model[0] ? " (/model)" : "");
        } else if (st->busy) {
            tx_snprintf(note, sizeof note, "busy: model unchanged");
        } else if ((size_t)zs_len(arg) >= sizeof st->model || zs_chr(arg, ' ') || zs_chr(arg, '"') || zs_chr(arg, '\\')) {
            tx_snprintf(note, sizeof note, "usage: /model NAME (one word, under %d bytes)", (int)sizeof st->model);
        } else {
            tx_snprintf(st->model, sizeof st->model, "%s", arg);
            tx_snprintf(note, sizeof note, "model set: %s (this session)", st->model);
        }
        tui_log_plain(st, note);
        tui_command_done(st);
        return 1;
    }
    if (!zs_ncmp(st->input, "/export", 7) && token == 7) {
        char path[512], dest[600], msg[400];
        const char *arg = st->input + 7;
        while (*arg == ' ') arg++;
        if (st->owned) tx_snprintf(path, sizeof path, "%s", st->journal_path);
        else if (agent_transcript_path(path, sizeof path) != 0) path[0] = 0;
        if (*arg) tx_snprintf(dest, sizeof dest, "%s", arg);
        else tx_snprintf(dest, sizeof dest, "csih-%ld.md", (long)net_now());
        if (!path[0]) tui_log_plain(st, "export: no transcript path");
        else { tui_export(path, dest, msg, sizeof msg); tui_log_plain(st, msg); }
        tui_command_done(st);
        return 1;
    }
    if (!zs_cmp(st->input, "/compact")) {
        char path[512], msg[400];
        if (st->busy) tui_log_plain(st, "busy: /compact refused");
        else if (st->owned) tui_log_plain(st, "compact: owned session keeps its journal; not supported");
        else if (agent_transcript_path(path, sizeof path) != 0) tui_log_plain(st, "compact: no transcript path");
        else { tui_compact(path, st->last_answer, msg, sizeof msg); tui_log_plain(st, msg); }
        tui_command_done(st);
        return 1;
    }
    if (!zs_cmp(st->input, "/new")) {
        char path[512], msg[400];
        if (st->busy) tui_log_plain(st, "busy: /new refused");
        else if (st->owned) tui_log_plain(st, "new: owned session keeps its journal; not supported");
        else if (agent_transcript_path(path, sizeof path) != 0) tui_log_plain(st, "new: no transcript path");
        else {
            tui_new_context(path, msg, sizeof msg);
            tui_log_plain(st, msg);
            st->last_answer[0] = 0; st->errline[0] = 0; st->ended = 0;
        }
        tui_command_done(st);
        return 1;
    }
    if (!zs_ncmp(st->input, "/resume", 7) && token == 7) {
        char path[512], msg[400];
        const char *arg = st->input + 7;
        while (*arg == ' ') arg++;
        if (st->busy) tui_log_plain(st, "busy: /resume refused");
        else if (st->owned) tui_log_plain(st, "resume: owned session keeps its journal; not supported");
        else if (agent_transcript_path(path, sizeof path) != 0) tui_log_plain(st, "resume: no transcript path");
        else if (!*arg) {
            long stamps[9];
            int n = tui_archives(path, stamps, 9), i;
            if (!n) tui_log_plain(st, "resume: 没有归档（/new 会产生）");
            for (i = 0; i < n; i++) {
                char file[600], first[160];
                long age = (long)net_now() - stamps[i];
                tx_snprintf(file, sizeof file, "%s.%ld.jsonl", path, stamps[i]);
                tui_first_user(file, first, sizeof first);
                if (age < 3600) tx_snprintf(msg, sizeof msg, "%d) %ld 分钟前 · %s", i + 1, age / 60, first[0] ? first : "(空)");
                else if (age < 86400) tx_snprintf(msg, sizeof msg, "%d) %ld 小时前 · %s", i + 1, age / 3600, first[0] ? first : "(空)");
                else tx_snprintf(msg, sizeof msg, "%d) %ld 天前 · %s", i + 1, age / 86400, first[0] ? first : "(空)");
                tui_log_plain(st, msg);
            }
            if (n) tui_log_plain(st, "resume N 换回第 N 个；当前转录会先归档");
            tui_log_plain(st, "resume shared: 导入按目录分开之前的旧共享对话记录");
        } else if (!zs_cmp(arg, "shared")) {
            char shared[512];
            const char *home = sy_env("HOME");
            tx_snprintf(shared, sizeof shared, "%s/.cdsh/tui.jsonl", home ? home : "");
            if (!zs_cmp(shared, path)) tui_log_plain(st, "resume: 当前就在用共享对话记录");
            else { tui_import_shared(path, shared, msg, sizeof msg); tui_log_plain(st, msg); }
        } else {
            tui_resume(path, (int)tx_atol(arg), msg, sizeof msg);
            tui_log_plain(st, msg);
            st->last_answer[0] = 0; st->errline[0] = 0; st->ended = 0;
        }
        tui_command_done(st);
        return 1;
    }
    if (!zs_ncmp(st->input, "/perm", 5) && token == 5) {
        static const char *names[] = { "read", "work", "any" };
        const char *arg = st->input + 5;
        int i, want = -1;
        while (*arg == ' ') arg++;
        for (i = 0; i < 3; i++) if (!zs_cmp(arg, names[i])) want = i;
        if (!*arg)
            tx_snprintf(note, sizeof note, "perm: %s（read 只读；work 只写工作目录、危险命令要 /allow；any 不拦）",
                     names[agent_get_perm()]);
        else if (want < 0) tx_snprintf(note, sizeof note, "usage: /perm read|work|any");
        else if (st->busy) tx_snprintf(note, sizeof note, "busy: perm unchanged");
        else { agent_set_perm(want); tx_snprintf(note, sizeof note, "perm set: %s", names[want]); }
        tui_log_plain(st, note);
        tui_command_done(st);
        return 1;
    }
    if (!zs_ncmp(st->input, "/view", 5) && token == 5) {
        /* /view PATH [LINE]: 20 numbered lines from LINE (default 1), local only. */
        char path[1024], here[1024], full[2100], buf[1024];
        const char *arg = st->input + 5, *sp;
        int from = 1, ln = 0, shown = 0;
        fio_t *f;
        while (*arg == ' ') arg++;
        sp = zs_rchr(arg, ' ');
        if (sp && sp[1] >= '0' && sp[1] <= '9') { from = (int)tx_atol(sp + 1); tx_snprintf(path, sizeof path, "%.*s", (int)(sp - arg), arg); }
        else tx_snprintf(path, sizeof path, "%s", arg);
        if (from < 1) from = 1;
        if (!path[0]) { tui_log_plain(st, "usage: /view PATH [LINE]"); tui_command_done(st); return 1; }
        if (path[0] == '~' && path[1] == '/' && sy_env("HOME")) tx_snprintf(full, sizeof full, "%s%s", sy_env("HOME"), path + 1);
        else if (path[0] == '/') tx_snprintf(full, sizeof full, "%s", path);
        else {
            const char *cwd = csih_env("CSIH_CWD", "CDSH_CWD");
            if (!cwd) { if (!tui_getcwd(here, (int)sizeof here)) zs_set(here, (long)sizeof here, "."); cwd = here; }
            tx_snprintf(full, sizeof full, "%s/%s", cwd, path);
        }
        f = tui_fopen(full, "r");
        if (!f) { tx_snprintf(note, sizeof note, "view: cannot open %.180s: %s", path, sy_strerror(errno)); tui_log_plain(st, note); tui_command_done(st); return 1; }
        tx_snprintf(note, sizeof note, "view: %.180s 从第 %d 行", path, from);
        tui_log_plain(st, note);
        while (shown < 20 && fio_gets(buf, sizeof buf, f)) {
            ln++;
            if (ln < from) continue;
            buf[zs_cspn(buf, "\r\n")] = 0;
            tx_snprintf(note, sizeof note, "%5d│ %.220s", ln, buf);
            tui_log_plain(st, note);
            shown++;
        }
        if (!shown) tui_log_plain(st, "view: （此范围没有内容）");
        else if (fio_gets(buf, sizeof buf, f)) {
            tx_snprintf(note, sizeof note, "view: 还有更多，/view %.150s %d", path, ln + 1);
            tui_log_plain(st, note);
        }
        fio_close(f);
        tui_command_done(st);
        return 1;
    }
    if (!zs_cmp(st->input, "/diff")) {
        /* Each undo step against what is on disk now: diff -u, a few lines each.
         * Several steps on one file show the first backup only, i.e. the whole change. */
        int i, j, n = agent_undo_depth(), shown = 0, rows = 0;
        if (!n) tui_log_plain(st, "diff: agent 本次运行还没有改过文件");
        for (i = 0; i < n && rows < 30; i++) {
            const char *path, *bak, *pj, *bj;
            int existed, ej, dup = 0;
            char cmd[2400], qp[1100], qb[700];
            shell_result r;
            agent_undo_entry(i, &path, &bak, &existed);
            for (j = 0; j < i; j++) { agent_undo_entry(j, &pj, &bj, &ej); if (!zs_cmp(pj, path)) dup = 1; }
            if (dup) continue;
            tui_sh_quote(qp, sizeof qp, path);
            tui_sh_quote(qb, sizeof qb, existed ? bak : "/dev/null");
            tx_snprintf(cmd, sizeof cmd, "diff -u %s %s | tail -n +3 | head -12; true", qb, qp);
            tx_snprintf(note, sizeof note, "diff: %s %.200s", existed ? "改动" : "新建", path);
            tui_log_plain(st, note); rows++; shown++;
            r = shell_run_in(cmd, "/");
            {
                char *p = r.out;
                while (*p && rows < 30) {
                    char *nl = zs_chr(p, '\n');
                    if (nl) *nl = 0;
                    tx_snprintf(note, sizeof note, "  %.230s", p);
                    tui_log_plain(st, note); rows++;
                    if (!nl) break;
                    p = nl + 1;
                }
            }
        }
        if (shown) tui_log_plain(st, "diff: /undo 可逐步撤销；exec 的改动不在此列");
        tui_command_done(st);
        return 1;
    }
    if (!zs_cmp(st->input, "/context")) {
        char path[512], up[16], sz[16];
        int per_turn = 0, keep = 0, calls = 0, tokens = 0, sec = 0, rsec = 0;
        long trim = 0, sent = 0, hit = 0, miss = 0, out = 0;
        sy_stat_t sb;
        agent_context_limits(&per_turn, &trim, &keep);
        if (st->owned) tx_snprintf(path, sizeof path, "%s", st->journal_path);
        else if (agent_transcript_path(path, sizeof path) != 0) path[0] = 0;
        if (!path[0] || sy_stat(path, &sb) != 0) {
            tui_log_plain(st, "context: 当前没有对话记录（新上下文）");
        } else {
            session_records recs = session_read(path);
            tui_bytes(sz, sizeof sz, sb.size);
            tx_snprintf(note, sizeof note, "context: %zu 条记录 · %s · %.150s", recs.count, sz, path);
            tui_log_plain(st, note);
            session_free(&recs);
        }
        net_progress(&sec, &tokens, &sent, &rsec);
        net_session_usage(&calls, &hit, &miss, &out);
        tui_bytes(up, sizeof up, sent);
        tui_bytes(sz, sizeof sz, trim);
        tx_snprintf(note, sizeof note, "context: 每轮送最近 %d 条；文件超过 %s 时裁到最近 %d 条；上次请求上传 %s，本会话输入 %ld 词元",
                 per_turn, sz, keep, up, hit + miss);
        tui_log_plain(st, note);
        tui_command_done(st);
        return 1;
    }
    if (!zs_cmp(st->input, "/why")) {
        /* Recent failure / refusal reasons, oldest first, newest last. */
        int i, first = st->why.n > 5 ? st->why.n - 5 : 0;
        char rows[5][300];
        int nr = 0;
        if (!st->why.n) { tui_log_plain(st, "why: 本次还没有失败或被拦截"); tui_command_done(st); return 1; }
        /* Build first, then log: logging an error-looking row would push it again. */
        for (i = first; i < st->why.n; i++) {
            long age = (long)net_now() - st->why.t[i % 5];
            tx_snprintf(rows[nr++], sizeof rows[0], "why %d（%ld秒前）: %.230s", i - first + 1, age < 0 ? 0 : age, st->why.text[i % 5]);
        }
        {
            /* Listing is not a new failure: the rows quote ✗/exit= text, so
             * logging them would push into (and overwrite) the ring. Restore it. */
            static tui_why_ring keep;
            char line[240];
            keep = st->why;
            tx_snprintf(line, sizeof line, "%s", st->errline);
            for (i = 0; i < nr; i++) tui_log_plain(st, rows[i]);
            st->why = keep;
            tx_snprintf(st->errline, sizeof st->errline, "%s", line);
        }
        tui_command_done(st);
        return 1;
    }
    if (!zs_cmp(st->input, "/retry")) {
        /* Send the last prompt again (it is the newest history line). */
        if (!st->nhistory) {
            tui_log_plain(st, "retry: 还没有发过输入");
            tui_command_done(st);
            return 1;
        }
        tx_snprintf(note, sizeof note, "retry: 重发「%.180s」", st->history[st->nhistory - 1]);
        tui_log_plain(st, note);
        tx_snprintf(st->input, TUI_INPUT_MAX, "%s%s", st->history[st->nhistory - 1][0] == '/' ? " " : "",
                 st->history[st->nhistory - 1]);
        st->ninput = (int)(size_t)zs_len(st->input);
        return 0;
    }
    if (!zs_cmp(st->input, "/copy")) {
        /* Last answer into the tmux paste buffer (prefix ] pastes it anywhere). */
        static char cmd[4096 * 4 + 64], q[4096 * 4 + 8];
        if (!st->last_answer[0] || !zs_cmp(st->last_answer, "(no answer text)"))
            tui_log_plain(st, "copy: 还没有可复制的答复");
        else if (!tui_env_has("TMUX"))
            tui_log_plain(st, "copy: 不在 tmux 里，无法放进粘贴缓冲区");
        else {
            shell_result r;
            tui_sh_quote(q, sizeof q, st->last_answer);
            tx_snprintf(cmd, sizeof cmd, "tmux set-buffer -- %s", q);
            r = shell_run_in(cmd, "/");
            if (r.ok && r.exited && r.status == 0)
                tx_snprintf(note, sizeof note, "copy: 已复制上一轮答复（%d 字节）到 tmux 缓冲区，prefix ] 粘贴", (int)(size_t)zs_len(st->last_answer));
            else tx_snprintf(note, sizeof note, "copy: tmux set-buffer 失败（exit=%d）", r.exited ? r.status : -1);
            tui_log_plain(st, note);
        }
        tui_command_done(st);
        return 1;
    }
    if (!zs_cmp(st->input, "/undo")) {
        char msg[400];
        if (st->busy) tui_log_plain(st, "busy: /undo refused");
        else { agent_undo_last(msg, sizeof msg); tui_log_plain(st, msg); }
        tui_command_done(st);
        return 1;
    }
    if (!zs_ncmp(st->input, "/net", 4) && token == 4) {
        const char *arg = st->input + 4;
        while (*arg == ' ') arg++;
        if (!zs_cmp(arg, "on") || !zs_cmp(arg, "off")) {
            if (st->busy) tx_snprintf(note, sizeof note, "busy: net unchanged");
            else { agent_set_net(!zs_cmp(arg, "on")); tx_snprintf(note, sizeof note, "net: work 档命令%s网络", agent_get_net() ? "可以用" : "不能用"); }
        } else if (!*arg)
            tx_snprintf(note, sizeof note, "net: %s（read 档始终断网；any 档不进沙箱，不受影响%s）", agent_get_net() ? "on" : "off",
                     agent_sandbox_available() ? "" : "；本机没有沙箱，此开关无效");
        else tx_snprintf(note, sizeof note, "usage: /net [on|off]");
        tui_log_plain(st, note);
        tui_command_done(st);
        return 1;
    }
    if (!zs_cmp(st->input, "/allow")) {
        agent_allow_danger(1);
        tui_log_plain(st, "allow: 下一条危险命令放行一次（rm -rf / git push / reset 等）");
        tui_command_done(st);
        return 1;
    }
    if (!zs_cmp(st->input, "/cost")) {
        int calls = 0;
        long hit = 0, miss = 0, out = 0;
        net_session_usage(&calls, &hit, &miss, &out);
        tx_snprintf(note, sizeof note, "cost: 请求 %d 次 · 输入 %ld（缓存命中 %ld，%d%%）· 输出 %ld 词元",
                 calls, hit + miss, hit, hit + miss ? (int)(hit * 100 / (hit + miss)) : 0, out);
        tui_log_plain(st, note);
        tui_command_done(st);
        return 1;
    }
    if (!zs_cmp(st->input, "/cwd")) {
        char here[1024];
        const char *cwd = csih_env("CSIH_CWD", "CDSH_CWD");
        if (!cwd) { if (!tui_getcwd(here, (int)sizeof here)) zs_set(here, (long)sizeof here, "?"); cwd = here; }
        tx_snprintf(note, sizeof note, "cwd: %.200s", cwd);
        tui_log_plain(st, note);
        tui_command_done(st);
        return 1;
    }
    if (!zs_cmp(st->input, "/status")) {
        /* A readable overview first; the raw fields stay as the last row (tests read it). */
        static const char *perm[] = { "read", "work", "any" };
        const char *m = st->model[0] ? st->model : csih_env("CSIH_MODEL", "CDSH_MODEL");
        int calls = 0;
        long h0 = 0, m0 = 0, o0 = 0;
        net_session_usage(&calls, &h0, &m0, &o0);
        tx_snprintf(note, sizeof note, "状态：%s · 权限 %s%s · 沙箱%s · %s · 可撤销 %d 步 · 待发送 %d · 本会话请求 %d 次",
                 m ? m : "deepseek-chat", perm[agent_get_perm()], agent_get_net() ? "" : "（断网）",
                 agent_sandbox_available() ? "开" : "无", st->busy ? "执行中" : "空闲",
                 agent_undo_depth(), st->npending, calls);
        tui_log_plain(st, note);
        tx_snprintf(note, sizeof note,
            "busy=%d mode=%s owned=%d owner=%d goal=%d loop=%d left=%d history=%d pending=%d keys=%d",
            st->busy, st->mode == 1 ? "agent" : "chat", st->owned != NULL,
            st->owner_fd >= 0, st->goal[0] != 0, st->loop_on, st->loop_left,
            st->nhistory, st->npending, (st->qtail - st->qhead + 64) % 64);
        tui_log_plain(st, note);
        tui_command_done(st);
        return 1;
    }
    if (!zs_cmp(st->input, "/clear")) {
        if (st->busy) tui_log_plain(st, "busy: not cleared");
        else {
            zs_mset(st->log, 0, sizeof st->log);
            zs_mset(st->ex_on, 0, sizeof st->ex_on);
            zs_mset(st->ex_open, 0, sizeof st->ex_open);
            zs_mset(st->ex_tag, 0, sizeof st->ex_tag);
            zs_mset(st->ex_why, 0, sizeof st->ex_why);
            zs_mset(st->ex_cmd, 0, sizeof st->ex_cmd);
            zs_mset(st->ex_body, 0, sizeof st->ex_body);
            st->nlog = 0; st->log_skip = 0;
            zs_mset(st->history, 0, sizeof st->history);
            zs_mset(st->history_draft, 0, sizeof st->history_draft);
            st->nhistory = 0; st->history_pos = 0; st->history_browsing = 0;
            st->errline[0] = 0; st->last_answer[0] = 0;
            st->last[0] = 0; st->output[0] = 0; st->notice = NULL;
            st->phase[0] = 0; st->ended = 0;
            tx_snprintf(note, sizeof note, "cleared UI view; model context and journal unchanged; pending=%d retained", st->npending);
            tui_log_plain(st, note);
        }
        tui_command_done(st);
        return 1;
    }
    if (st->input[token] == ' ' && ((!zs_ncmp(st->input, "/help", 5) && token == 5) ||
        (!zs_ncmp(st->input, "/status", 7) && token == 7) ||
        (!zs_ncmp(st->input, "/clear", 6) && token == 6) ||
        (!zs_ncmp(st->input, "/cwd", 4) && token == 4) ||
        (!zs_ncmp(st->input, "/cost", 5) && token == 5) ||
        (!zs_ncmp(st->input, "/allow", 6) && token == 6) ||
        (!zs_ncmp(st->input, "/undo", 5) && token == 5) ||
        (!zs_ncmp(st->input, "/diff", 5) && token == 5) ||
        (!zs_ncmp(st->input, "/copy", 5) && token == 5) ||
        (!zs_ncmp(st->input, "/retry", 6) && token == 6) ||
        (!zs_ncmp(st->input, "/context", 8) && token == 8) ||
        (!zs_ncmp(st->input, "/why", 4) && token == 4) ||
        (!zs_ncmp(st->input, "/new", 4) && token == 4) ||
        (!zs_ncmp(st->input, "/compact", 8) && token == 8) ||
        (!zs_ncmp(st->input, "/reload", 7) && token == 7) ||
        (!zs_ncmp(st->input, "/reload-code", 12) && token == 12) ||
        (!zs_ncmp(st->input, "/exit", 5) && token == 5) ||
        (!zs_ncmp(st->input, "/quit", 5) && token == 5))) {
        tx_snprintf(note, sizeof note, "usage: %.*s (no arguments)", token, st->input);
        tui_log_plain(st, note);
        tui_command_done(st);
        return 1;
    }
    if (!zs_cmp(st->input, "/reload-code")) {
        if (tui_managed_request(st) != 0) tui_log_plain(st, "reload-code: requires managed idle actor");
        return 1;
    }
    if (!zs_ncmp(st->input, "/export-state", 13) &&
        (st->input[13] == 0 || st->input[13] == ' ')) {
        reload_session_state *m = NULL;
        tui_state *copy = NULL;
        char why[256], path[4096], note[4200];
        const char *handoff = st->input + 13;
        int rc = -1;
        while (*handoff == ' ') handoff++;
        if (!st->owned || st->owner_fd < 0 || st->busy || !tui_owned_id(handoff, 0)) {
            tui_log_plain(st, "export-state: requires owned idle state and explicit valid HANDOFF");
            return 1;
        }
        m = mm_alloc(sizeof *m); copy = mm_alloc(sizeof *copy);
        if (!m || !copy) tx_snprintf(why, sizeof why, "allocation failed");
        else {
            zs_mcpy(m, st->owned, sizeof *m);
            tx_snprintf(m->handoff_id, sizeof m->handoff_id, "%s", handoff);
            zs_mcpy(copy, st, sizeof *copy);
            copy->input[0] = 0; copy->ninput = 0;
            tx_snprintf(path, sizeof path, "%s/state-v2.json", st->owned_dir);
            rc = tui_reload_export(copy, m, path, why, sizeof why);
        }
        if (rc == 0) {
            st->input[0] = 0; st->ninput = 0;
            tx_snprintf(note, sizeof note, "state saved: %s (explicit HASH binding only)", path);
        } else tx_snprintf(note, sizeof note, "export-state: %s", why);
        tui_log_plain(st, note);
        mm_free(copy); mm_free(m);
        return 1;
    }
    if (!zs_cmp(st->input, "/goal")) {
        st->input[0] = '\0';
        st->ninput = 0;
        return 1;
    }
    if (!zs_ncmp(st->input, "/goal ", 6)) {
        if (!st->input[6]) {
            tui_drop_goal_pending(st);
            st->goal[0] = '\0';
            st->loop_on = 0;
            st->loop_left = 0;
        } else {
            tx_snprintf(st->goal, sizeof st->goal, "%s", st->input + 6);
        }
        st->input[0] = '\0';
        st->ninput = 0;
        return 1;
    }
    if (!zs_ncmp(st->input, "/loop", 5) && (st->input[5] == '\0' || st->input[5] == ' ')) {
        if (!st->goal[0] || st->loop_on) {
            if (st->goal[0]) tui_drop_goal_pending(st);
            st->loop_on = 0;
            st->loop_left = 0;
        } else {
            st->loop_on = 1;
            st->loop_left = TUI_LOOP_MAX;
            if (!st->busy) tui_queue_goal(st);
        }
        st->input[0] = '\0';
        st->ninput = 0;
        return 1;
    }
    /* Re-read the key file on the next call. Pages are already read every
     * frame. The command itself is consumed. A busy turn is left running. */
    if (!zs_cmp(st->input, "/reload")) {
        if (st->busy)
            tui_log_plain(st, "reload: 请求中，没重载");
        else if (net_deepseek_forget())
            tui_log_plain(st, "reload: 页每帧已重读，密钥缓存已清");
        else
            tui_log_plain(st, "reload: 密钥文件打不开，沿用已有密钥");
        st->input[0] = '\0';
        st->ninput = 0;
        return 1;
    }
    {
        /* Custom command: ./.csih/commands/NAME.md, else ~/.csih/commands/NAME.md.
         * Its text, with $ARGS replaced by what followed the name, is sent as
         * the prompt (return 0: the caller sends st->input). */
        char file[1200], body[TUI_INPUT_MAX], out[TUI_INPUT_MAX], args[TUI_INPUT_MAX];
        const char *home = sy_env("HOME"), *p, *a;
        size_t n = 0, o = 0;
        fio_t *f;
        tx_snprintf(args, sizeof args, "%s", st->input[token] == ' ' ? st->input + token + 1 : "");
        tx_snprintf(file, sizeof file, ".csih/commands/%.*s.md", token - 1, st->input + 1);
        f = tui_fopen(file, "r");
        if (!f && home) {
            tx_snprintf(file, sizeof file, "%s/.csih/commands/%.*s.md", home, token - 1, st->input + 1);
            f = tui_fopen(file, "r");
        }
        if (f) {
            n = fio_read(body, 1, sizeof body - 1, f);
            fio_close(f);
            body[n] = 0;
            for (p = body; *p && o + 1 < sizeof out; ) {
                if (!zs_ncmp(p, "$ARGS", 5)) {
                    for (a = args; *a && o + 1 < sizeof out; a++) out[o++] = *a;
                    p += 5;
                } else out[o++] = *p++;
            }
            out[o] = 0;
            while (o > 0 && (out[o - 1] == '\n' || out[o - 1] == ' ')) out[--o] = 0;
            if (!out[0]) { tx_snprintf(note, sizeof note, "command %.*s: %s 是空的", token, st->input, file); tui_log_plain(st, note); tui_command_done(st); return 1; }
            /* A leading / would be read as a command again; send it literally. */
            tx_snprintf(st->input, TUI_INPUT_MAX, "%s%s", out[0] == '/' ? " " : "", out);
            st->ninput = (int)(size_t)zs_len(st->input);
            return 0;
        }
    }
    tx_snprintf(note, sizeof note, "unknown command: %.*s (/help 查看；自定义命令放 .csih/commands/名字.md)", token, st->input);
    tui_log_plain(st, note);
    tui_command_done(st);
    return 1;
}

static void tui_type(tui_state *st, const char *s) {
    for (; s && *s; s++) tui_apply_key(st, TERM_KEY_CHAR, *s);
    tui_apply_key(st, TERM_KEY_ENTER, 0);
}

static int tui_frame_has(tui_state *st, const char *needle) {
    r_frame f = tui_render_state(st, 40);
    int i;
    for (i = 0; i < f.n; i++)
        if (f.lines[i] && zs_find(f.lines[i], needle)) return 1;
    return 0;
}

/* One byte into the input. A paste newline uses this too. */
/* Byte offset of the cursor. Code that rewrites input without touching
 * back leaves it stale, so clamp here rather than trust it. */
static int tui_cursor(tui_state *st) {
    if (st->back < 0 || st->back > st->ninput) st->back = st->back < 0 ? 0 : st->ninput;
    return st->ninput - st->back;
}

static void tui_input_byte(tui_state *st, char ch) {
    st->ask_exit = 0;
    if (st->ninput < TUI_INPUT_MAX - 1) {
        int at = tui_cursor(st);
        zs_mmove(st->input + at + 1, st->input + at, (size_t)(st->ninput - at));
        st->input[at] = ch;
        st->ninput++;
        st->input[st->ninput] = '\0';
    } else {
        st->notice = "input full";
    }
}

/* Manual Enter path. Records the line into history only when tui_submit
 * actually accepted it (input was non-empty and got cleared). The queue-full
 * path keeps the input, so it is not recorded. */
/* History survives restarts in ~/.csih/history, one line per entry, newlines
 * inside an entry stored as \x1e. Only the real agent/run entry sets the
 * file, so self-tests never read or write it. */
static char tui_hist_file[600];

static void tui_history_save(const char *line) {
    fio_t *f;
    if (!tui_hist_file[0] || !line || !line[0]) return;
    f = tui_fopen(tui_hist_file, "a");
    if (!f) return;
    for (; *line; line++) fio_putc(*line == '\n' ? 0x1e : *line, f);
    fio_putc('\n', f);
    fio_close(f);
}

/* Load the newest entries into st (at most the 16 it holds). */
static void tui_history_load(tui_state *st, const char *file) {
    static char ring[16][TUI_INPUT_MAX];
    char line[TUI_INPUT_MAX];
    int n = 0, i, start;
    fio_t *f;
    tx_snprintf(tui_hist_file, sizeof tui_hist_file, "%s", file);
    f = tui_fopen(file, "r");
    if (!f) return;
    while (fio_gets(line, sizeof line, f)) {
        char *p;
        line[zs_cspn(line, "\n")] = 0;
        if (!line[0]) continue;
        for (p = line; *p; p++) if (*p == 0x1e) *p = '\n';
        tx_snprintf(ring[n % 16], TUI_INPUT_MAX, "%s", line);
        n++;
    }
    fio_close(f);
    start = n > 16 ? n - 16 : 0;
    st->nhistory = 0;
    for (i = start; i < n; i++)
        tx_snprintf(st->history[st->nhistory++], sizeof st->history[0], "%s", ring[i % 16]);
    /* Keep the file bounded: past 1000 entries, rewrite it as the kept 16. */
    if (n > 1000 && (f = tui_fopen(file, "w"))) {
        fio_close(f);
        for (i = 0; i < st->nhistory; i++) tui_history_save(st->history[i]);
    }
}

static void tui_manual_submit(tui_state *st) {
    char captured[TUI_INPUT_MAX];
    tx_snprintf(captured, TUI_INPUT_MAX, "%s", st->input);
    int had = st->input[0] != '\0';
    tui_submit(st);
    if (had && st->input[0] == '\0' &&
        !(st->mode == 1 && tui_command_len(captured)) &&
        zs_cmp(captured, "/exit") && zs_cmp(captured, "/quit")) {
        const char *keep = st->mode == 1 && captured[0] == '/' && captured[1] == '/' ? captured + 1 : captured;
        tui_history_add(st, keep);
        tui_history_save(keep);
    }
}

static void tui_submit(tui_state *st) {
    st->ask_exit = 0;
    st->back = 0;
    if (!zs_cmp(st->input, "/exit") || !zs_cmp(st->input, "/quit")) {
        st->input[0] = '\0';
        st->ninput = 0;
        st->quit = 1;
        return;
    }
    /* In agent mode, Enter hands the prompt to the DeepSeek loop (which
     * drives the file/exec tools and, via exec, the live tmux windows). */
    if (st->mode == 1) {
        if (!st->input[0]) return;
        if (st->input[0] == '/' && st->input[1] == '/') {
            if (st->busy && st->npending >= 8) { st->notice = "待发送已满"; return; }
            zs_mmove(st->input, st->input + 1, (size_t)st->ninput);
            st->ninput--;
        } else if (tui_slash(st)) return;
        if (st->busy) { tui_enqueue(st); return; }
        tui_run_agent(st);
        return;
    }
    /* Enter runs a real turn: the line is recorded, the gate judges the
     * newest probability in the transcript, and the verdict is written
     * back. The verdict goes to `last` (shown in the frame) AND into the
     * transcript (so the next turn can see it) — a verdict only on screen
     * would not be a closed loop. */
    if (st->input[0]) {
        tool_result tr = tool_run(st->input);
        /* Show the first line of the result: the frame is a fixed number of
         * rows, and a long listing would push everything else off screen. */
        {
            size_t i = 0;
            while (tr.out[i] && tr.out[i] != '\n' && i < sizeof st->output - 1) i++;
            zs_mcpy(st->output, tr.out, i);
            st->output[i] = '\0';
            if (tr.out[i] == '\n') st->notice = "ran (output continues; see 'read')";
            else st->notice = tr.ok ? "ok" : "failed";
        }
    }
    if (st->transcript) {
        chat_turn t = chat_turn_run(st->transcript, st->input, 0.5);
        tx_snprintf(st->last, sizeof st->last, "%s", t.verdict);
    } else if (!st->input[0]) {
        st->notice = "empty";
    }
    st->ninput = 0;
    st->input[0] = '\0';
}

static void tui_apply_key(tui_state *st, int kind, char ch) {
    /* Any key but Ctrl-R (and the idle tick) ends a history search. */
    if (kind != -1 && !(kind == TERM_KEY_CHAR && ch == 0x12)) st->rsearch_at = 0;
    switch (kind) {
    case -1:
        st->ticks++;
        return;
    case TERM_KEY_CHAR:
        if (ch == '\t' && st->input[0] == '/' && !zs_chr(st->input, ' ') && !st->pasting) {
            tui_complete_command(st);
            return;
        }
        if (ch == '\t' && st->ninput == 0 && !st->pasting) {
            /* Tab on an empty line: open or close the newest tool row. */
            int i;
            for (i = st->nlog - 1; i >= 0; i--)
                if (st->ex_on[i]) { st->ex_open[i] = !st->ex_open[i]; break; }
            return;
        }
        if (ch == 0x15) {           /* Ctrl-U: drop the whole line */
            st->input[0] = '\0'; st->ninput = 0; st->back = 0; st->ask_exit = 0;
            return;
        }
        if (ch == 0x12) {
            /* Ctrl-R: newest history line containing what was typed; again goes older. */
            int i, from;
            if (!st->rsearch_at) tx_snprintf(st->rsearch, sizeof st->rsearch, "%s", st->input);
            from = st->rsearch_at ? st->rsearch_at - 2 : st->nhistory - 1;
            for (i = from; i >= 0; i--)
                if (zs_find(st->history[i], st->rsearch)) break;
            if (i < 0) { st->notice = st->rsearch_at ? "没有更早的匹配" : "历史里没有匹配"; return; }
            tx_snprintf(st->input, TUI_INPUT_MAX, "%s", st->history[i]);
            st->ninput = (int)(size_t)zs_len(st->input);
            st->back = 0;
            st->rsearch_at = i + 1;
            return;
        }
        if (ch == 0x01) { st->back = st->ninput; return; }   /* Ctrl-A: line start */
        if (ch == 0x05) { st->back = 0; return; }            /* Ctrl-E: line end */
        if (ch == 0x17) {           /* Ctrl-W: spaces, then one word, before the cursor */
            int at = tui_cursor(st), i = at;
            while (i > 0 && (st->input[i - 1] == ' ' || st->input[i - 1] == '\t')) i--;
            while (i > 0 && st->input[i - 1] != ' ' && st->input[i - 1] != '\t') i--;
            zs_mmove(st->input + i, st->input + at, (size_t)(st->ninput - at) + 1);
            st->ninput -= at - i; st->ask_exit = 0;
            return;
        }
        tui_input_byte(st, ch);
        return;
    case TERM_KEY_BACKSPACE:
        st->ask_exit = 0;
        /* One code point before the cursor. A continuation byte is not its own character. */
        {
            int at = tui_cursor(st);
            if (at > 0) {
                int i = at - 1;
                while (i > 0 && ((unsigned char)st->input[i] & 0xC0) == 0x80) i--;
                zs_mmove(st->input + i, st->input + at, (size_t)(st->ninput - at) + 1);
                st->ninput -= at - i;
            }
        }
        return;
    case TERM_KEY_LEFT:
    case TERM_KEY_RIGHT:
        if (st->pasting) return;
        {
            int at = tui_cursor(st);
            if (kind == TERM_KEY_LEFT && at > 0) {
                at--;
                while (at > 0 && ((unsigned char)st->input[at] & 0xC0) == 0x80) at--;
            } else if (kind == TERM_KEY_RIGHT && at < st->ninput) {
                at++;
                while (at < st->ninput && ((unsigned char)st->input[at] & 0xC0) == 0x80) at++;
            }
            st->back = st->ninput - at;
        }
        return;
    case TERM_KEY_PASTE_ON:
        st->pasting = 1;
        return;
    case TERM_KEY_PASTE_OFF:
        /* The whole paste is one message. Newlines inside it were not Enter. */
        st->pasting = 0;
        if (st->input[0]) tui_manual_submit(st);
        return;
    case TERM_KEY_ENTER:
        /* A newline that still has keys behind it is part of a paste or a
         * burst, not a send. A lone Enter sends whatever is in the box. */
        if (st->pasting || st->more_keys) {
            tui_input_byte(st, '\n');
            return;
        }
        tui_manual_submit(st);
        return;
    case TERM_KEY_CTRL_C:
        /* A typed line is cleared. An empty line does not quit: say so.
         * While a turn is in flight and the line is already empty, cancel
         * that turn. Exit is Ctrl-D on an empty line, or /exit, or /quit. */
        if (st->ninput > 0) {
            st->input[0] = '\0';
            st->ninput = 0;
            st->ask_exit = 0;
            return;
        }
        if (st->busy) { st->cancel = 1; net_cancel(); return; }
        /* Empty line: also drop the stale result row (failed/unknown). */
        st->errline[0] = 0; st->last[0] = 0; st->output[0] = 0;
        st->notice = NULL; st->phase[0] = 0; st->ended = 0;
        st->ask_exit = 1;
        return;
    case TERM_KEY_CTRL_D:
        if (st->ninput > 0) return;
        if (st->busy) { st->cancel = 1; net_cancel(); }
        st->quit = 1;
        return;
    case TERM_KEY_UP:
        if (st->pasting) return;
        tui_history_move(st, -1);
        return;
    case TERM_KEY_DOWN:
        if (st->pasting) return;
        tui_history_move(st, 1);
        return;
    case TERM_KEY_PGUP:
        if (st->mode != 1) { st->notice = "arrow keys not bound yet"; return; }
        tui_log_scroll(st, tui_log_room(st));
        return;
    case TERM_KEY_PGDN:
        if (st->mode != 1) { st->notice = "arrow keys not bound yet"; return; }
        tui_log_scroll(st, -tui_log_room(st));
        return;
    case TERM_KEY_HOME:
        if (st->mode != 1) { st->notice = "arrow keys not bound yet"; return; }
        tui_log_scroll(st, 40);
        return;
    case TERM_KEY_END:
        if (st->mode != 1) { st->notice = "arrow keys not bound yet"; return; }
        st->log_skip = 0;
        return;
    case TERM_KEY_ALT_ENTER:
        /* A newline inside the message; Enter alone still sends. */
        tui_input_byte(st, '\n');
        return;
    case TERM_KEY_ESC:
        /* Busy: cancel this turn (tools already run stay done). Idle: clear the line. */
        if (st->busy) {
            st->cancel = 1; net_cancel();
            st->notice = "Esc: 取消本轮，已执行的工具保留";
            return;
        }
        st->input[0] = '\0'; st->ninput = 0; st->ask_exit = 0;
        return;
    case TERM_KEY_UNKNOWN:
        /* Never swallowed: an ignored key reads as "the UI is broken". */
        st->notice = "unknown key (ignored)";
        return;
    default:
        st->notice = "arrow keys not bound yet";
        return;
    }
}

/* Rows under the mind rule when that drawer is open.
 * Fixed rows are title, goal, input, the status line, and the two rules.
 * System body, mind body, and pending lines are counted in tui_log_room. */
#define TUI_MIND_N 12
#define TUI_FIXED_ROWS 7

/* Mind pages are read whole and folded to the column width, one screen row
 * per folded piece. Continuation rows start with two spaces. */
/* Terminal columns, not bytes. The measure itself is csih_cols.h. */
static int tui_disp_width(const char *s) {
    int w = 0;
    if (!s) return 0;
    while (*s) {
        unsigned int cp = 0;
        int n = tui_next_cp(s, &cp);
        if (n <= 0) break;
        w += tui_cp_cols(cp);
        s += n;
    }
    return w;
}

/* Whole codepoints of S that fit COLS display columns, into OUT (CAP bytes,
 * NUL-terminated). The byte bound matters: zero-width codepoints take no
 * column, so the column count alone does not bound the bytes written. */
static int tui_utf8_fit(const char *s, int cols, char *out, int cap) {
    int i = 0, n = 0, w = 0;
    if (cap < 1) return 0;
    if (!s) s = "";
    if (cols < 0) cols = 0;
    while (s[i] && w < cols) {
        unsigned int cp = 0;
        int need = tui_next_cp(s + i, &cp);
        int cw;
        if (need <= 0) break;
        cw = tui_cp_cols(cp);
        if (w + cw > cols) break;
        if (n + need >= cap) break;
        mm_copy(out + n, (long)(cap - n), s + i, (long)need);
        n += need;
        i += need;
        w += cw;
    }
    out[n] = '\0';
    return n;
}

static void tui_pad_disp(char *s, int cols) {
    int n = (int)(size_t)zs_len(s);
    int w = tui_disp_width(s);
    while (w < cols && n < R_LINE_MAX) {
        s[n++] = ' ';
        w++;
    }
    s[n] = '\0';
}

/* Fences and a bare `flowchart LR` are mermaid wrappers, not the map. */
static int tui_mind_noise(const char *s) {
    const char *p = s ? s : "";
    char c;
    while (*p == ' ' || *p == '\t') p++;
    if (!zs_ncmp(p, "```", 3)) return 1;
    if (zs_ncmp(p, "flowchart", 9) != 0) return 0;
    c = p[9];
    return c == '\0' || c == ' ' || c == '\t';
}

static void tui_page_lines(const char *name, char got[][R_LINE_MAX + 1],
                           int maxlines, int *nlines, int *state) {
    char path[512], buf[512];
    fio_t *fp;
    const char *home = sy_env("HOME");
    *nlines = 0;
    *state = 1;
    if (!home || !home[0]) return;
    csih_home_bind(home);
    tx_snprintf(path, sizeof path, "%s/.csih/%s", home, name);
    fp = tui_fopen(path, "r");
    if (!fp) {
        tx_snprintf(path, sizeof path, "%s/.cdsh/%s", home, name);
        fp = tui_fopen(path, "r");
    }
    if (!fp) return;
    *state = 2;
    while (fio_gets(buf, sizeof buf, fp)) {
        size_t len = (size_t)zs_len(buf);
        while (len > 0 && (buf[len - 1] == '\n' || buf[len - 1] == '\r')) buf[--len] = '\0';
        if (!buf[0] || tui_mind_noise(buf)) continue;
        *state = 0;
        if (*nlines >= maxlines) break;
        (*nlines)++;
        tx_snprintf(got[*nlines - 1], R_LINE_MAX + 1, "%s", buf);
    }
    fio_close(fp);
}

static void tui_col_put(char *side, int width, const char *text) {
    int n = tui_utf8_fit(text ? text : "", width, side, R_LINE_MAX + 1);   /* callers pass R_LINE_MAX+1 buffers */
    int w = tui_disp_width(side);
    while (w < width && n < R_LINE_MAX) {
        side[n++] = ' ';
        w++;
    }
    side[n] = '\0';
}

/* Column of the vertical bar between 思维树 and 记忆宫殿. -1 if the row
 * is too narrow to spare one column. */
static int tui_mind_bar(int cols, int *left_w, int *right_w) {
    int left, right;
    if (cols < 3) {
        if (left_w) *left_w = cols > 0 ? cols : 1;
        if (right_w) *right_w = 0;
        return -1;
    }
    left = (cols - 1) / 2;
    right = cols - left - 1;
    if (left_w) *left_w = left;
    if (right_w) *right_w = right;
    return left;
}

/* `label` then '-' out to `width` columns. The label is the rule. */
static int tui_label_rule(char *dst, int dstmax, const char *label, int width) {
    int li = 0, o = 0, w = 0;
    if (!dst || dstmax < 1) return 0;
    dst[0] = '\0';
    if (width < 1) return 0;
    if (!label) label = "";
    while (label[li] && o + 4 < dstmax && w < width) {
        unsigned int cp = 0;
        int need = tui_next_cp(label + li, &cp);
        int cw;
        if (need <= 0) break;
        cw = tui_cp_cols(cp);
        if (w + cw > width) break;
        zs_mcpy(dst + o, label + li, (size_t)need);
        o += need;
        li += need;
        w += cw;
    }
    while (w < width && o + 1 < dstmax) {
        dst[o++] = '-';
        w++;
    }
    dst[o] = '\0';
    return o;
}

/* Screen row of the system rule, and the half-open body range under it.
 * Filled by the render that just ran. A click or a wheel looks here. */
#define TUI_SYS_N     10
#define TUI_SYS_WRAP  80
#define TUI_MIND_SRC  200
#define TUI_MIND_WRAP 80
static int tui_sys_rule_y;
static int tui_sys_y0;
static int tui_sys_y1;
static int tui_mind_y0;
static int tui_mind_y1;
static int tui_mind_rule_y;

static int tui_text_lines(const char *src) {
    int n = 0, any = 0;
    if (!src) return 0;
    for (; *src; src++) {
        if (*src == '\n') {
            if (any) n++;
            any = 0;
        } else if (*src != ' ' && *src != '\t' && *src != '\r')
            any = 1;
    }
    if (any) n++;
    return n;
}

/* Content lines in a mind page. -1 when the file is missing. */
static int tui_page_count(const char *name) {
    char path[512], buf[512];
    fio_t *fp;
    const char *home = sy_env("HOME");
    int n = 0, any = 0;
    if (!home || !home[0]) return -1;
    csih_home_bind(home);
    tx_snprintf(path, sizeof path, "%s/.csih/%s", home, name);
    fp = tui_fopen(path, "r");
    if (!fp) {
        tx_snprintf(path, sizeof path, "%s/.cdsh/%s", home, name);
        fp = tui_fopen(path, "r");
    }
    if (!fp) return -1;
    while (fio_gets(buf, sizeof buf, fp)) {
        size_t len = (size_t)zs_len(buf);
        while (len > 0 && (buf[len - 1] == '\n' || buf[len - 1] == '\r')) buf[--len] = '\0';
        if (!buf[0] || tui_mind_noise(buf)) continue;
        any = 1;
        if (n < 999) n++;
    }
    fio_close(fp);
    return any ? n : 0;
}

static void tui_rule_label(char *dst, int n, const char *name, int open, int count) {
    const char *mark = open ? "收缩" : "展开";
    /* Keep [展开] and [收缩] intact so a click can find the bracket. */
    if (count < 0)
        tx_snprintf(dst, (size_t)n, "-<%s>[%s]> 无", name, mark);
    else if (count > 99)
        tx_snprintf(dst, (size_t)n, "-<%s>[%s]> 99+", name, mark);
    else
        tx_snprintf(dst, (size_t)n, "-<%s>[%s]> %d", name, mark, count);
}

/* Top edge of the system block. Collapsed is [展开], open is [收缩].
 * The number is how many source lines sit behind the rule. */
static void tui_sys_rule(r_state *rs, char line[][R_LINE_MAX + 1], int *n,
                         int cols, const tui_state *st) {
    char label[80];
    if (*n >= 63 || cols < 1) return;
    tui_rule_label(label, (int)sizeof label, "系统提示词", st && st->sys_open,
                   tui_text_lines(agent_model_rules()));
    tui_sys_rule_y = *n + 2;
    tui_label_rule(line[*n], R_LINE_MAX + 1, label, cols);
    rs->body[*n] = line[*n];
    (*n)++;
}

/* Top edge of the mind block. Titles sit on the rule, split by ┬. */
static void tui_mind_rule(r_state *rs, char line[][R_LINE_MAX + 1], int *n, int cols, const tui_state *st) {
    char left[R_LINE_MAX + 1], right[R_LINE_MAX + 1];
    int half, rest, bar;
    if (*n >= 63 || cols < 1) return;
    tui_mind_rule_y = *n + 2;
    bar = tui_mind_bar(cols, &half, &rest);
    tui_rule_label(left, (int)sizeof left, "思维树", st && st->mind_open, tui_page_count("思维树.md"));
    tui_rule_label(right, (int)sizeof right, "记忆宫殿", st && st->mind_open, tui_page_count("记忆宫殿.md"));
    if (bar < 0) {
        tui_label_rule(line[*n], R_LINE_MAX + 1, left, cols);
    } else {
        char lfit[R_LINE_MAX + 1], rfit[R_LINE_MAX + 1];
        tui_label_rule(lfit, (int)sizeof lfit, left, half);
        tui_label_rule(rfit, (int)sizeof rfit, right, rest);
        tx_snprintf(line[*n], R_LINE_MAX + 1, "%s┬%s", lfit, rfit);
    }
    rs->body[*n] = line[*n];
    (*n)++;
}

/* Ten wrapped rows of the system prompt when open. Closed draws none.
 * The window starts at sys_top. A short prompt is padded to ten rows. */
static void tui_sys_block(r_state *rs, char line[][R_LINE_MAX + 1], int *n,
                          int cols, tui_state *st) {
    static char flat[4096];
    static char wrap[TUI_SYS_WRAP][R_LINE_MAX + 1];
    const char *src = agent_model_rules();
    const char *p;
    int i = 0, o = 0, row, width, used, nrows, top, maxtop;
    tui_sys_y0 = 0;
    tui_sys_y1 = 0;
    if (!st || !st->sys_open) return;
    if (!src) src = "";
    while (src[i] && o + 1 < (int)sizeof flat) {
        char c = src[i++];
        if (c == '\n' || c == '\r' || c == '\t') c = ' ';
        if (c == ' ' && (o == 0 || flat[o - 1] == ' ')) continue;
        flat[o++] = c;
    }
    flat[o] = '\0';
    p = flat;
    width = cols;
    if (width < 1) width = 1;
    nrows = 0;
    while (*p && nrows < TUI_SYS_WRAP) {
        used = tui_utf8_fit(p, width, wrap[nrows], (int)sizeof wrap[nrows]);
        if (used <= 0) {
            unsigned int cp = 0;
            int need = tui_next_cp(p, &cp);
            if (need <= 0) break;
            p += need;
            continue;
        }
        nrows++;
        p += used;
        while (*p == ' ') p++;
    }
    top = st->sys_top;
    maxtop = nrows > TUI_SYS_N ? nrows - TUI_SYS_N : 0;
    if (top < 0) top = 0;
    if (top > maxtop) top = maxtop;
    /* Wheel may run several times before the next draw. Remember the
     * clamped row so one wheel-up leaves the end instead of unwinding. */
    st->sys_top = top;
    tui_sys_y0 = *n + 2;
    for (row = 0; row < TUI_SYS_N && *n < 63; row++) {
        const char *piece = (top + row < nrows) ? wrap[top + row] : "";
        tx_snprintf(line[*n], R_LINE_MAX + 1, "%s", piece);
        rs->body[*n] = line[*n];
        (*n)++;
    }
    tui_sys_y1 = *n + 2;
}

/* Fold a page into rows fitted to `width`. Stops at maxrows.
 * Returns the number of source lines consumed. *rows is the fitted count. */
static int tui_mind_fold(char src[][R_LINE_MAX + 1], int n,
                         char dst[][R_LINE_MAX + 1], int maxrows,
                         int *rows, int width, int state) {
    int i, out = 0;
    if (n <= 0) {
        if (state == 1) tx_snprintf(dst[0], R_LINE_MAX + 1, "(无)");
        else if (state == 2) tx_snprintf(dst[0], R_LINE_MAX + 1, "(空)");
        else dst[0][0] = '\0';
        if (maxrows > 0) out = 1;
        if (rows) *rows = out;
        return n;
    }
    if (width < 1) width = 1;
    for (i = 0; i < n; i++) {
        const char *p = src[i];
        int used, first = 1;
        if (!p[0]) p = " ";
        while (*p && out < maxrows) {
            int w = width;
            if (!first) {
                /* Continuation of a wrapped note: indent four spaces so the
                 * next line reads as the same note, not a new one. */
                int k;
                for (k = 0; k < 4 && k < w - 1; k++) dst[out][k] = ' ';
                used = tui_utf8_fit(p, w - k, dst[out] + k, (int)sizeof dst[out] - k);
                if (used > 0 && p[used]) {
                    /* Prefer a break at space/punctuation over a cut mid-token. */
                    int b = 0, bo = 0;
                    while (b < used) {
                        unsigned int cp = 0;
                        int need = tui_next_cp(p + b, &cp);
                        if (need <= 0) break;
                        b += need;
                        if (cp == ' ' || cp == '-' || cp == '/' || cp == ',' || cp == '.' ||
                            (cp >= 0x3000 && cp <= 0x303F) || (cp >= 0xFF01 && cp <= 0xFF60))
                            bo = b;
                    }
                    if (bo > 0) used = bo;
                }
                if (used <= 0) {
                    unsigned int cp = 0;
                    int need = tui_next_cp(p, &cp);
                    if (need <= 0) break;
                    p += need;
                    continue;
                }
                dst[out][k + used] = '\0';
                p += used;
                out++;
                continue;
            }
            used = tui_utf8_fit(p, w, dst[out], (int)sizeof dst[out]);
            if (used > 0 && p[used]) {
                /* Prefer a break at space/punctuation over a cut mid-token. */
                int b = 0, bo = 0;
                while (b < used) {
                    unsigned int cp = 0;
                    int need = tui_next_cp(p + b, &cp);
                    if (need <= 0) break;
                    b += need;
                    if (cp == ' ' || cp == '-' || cp == '/' || cp == ',' || cp == '.' ||
                        (cp >= 0x3000 && cp <= 0x303F) || (cp >= 0xFF01 && cp <= 0xFF60))
                        bo = b;
                }
                if (bo > 0) used = bo;
            }
            if (used <= 0) {
                unsigned int cp = 0;
                int need = tui_next_cp(p, &cp);
                if (need <= 0) break;
                p += need;
                continue;
            }
            dst[out][used] = '\0';
            p += used;
            out++;
            first = 0;
        }
        if (out >= maxrows) break;
    }
    if (rows) *rows = out;
    return n;
}

static void tui_mind_block(r_state *rs, char line[][R_LINE_MAX + 1], int *n, int cols, tui_state *st) {
    static char tree[TUI_MIND_SRC][R_LINE_MAX + 1];
    static char palace[TUI_MIND_SRC][R_LINE_MAX + 1];
    static char lwrap[TUI_MIND_WRAP][R_LINE_MAX + 1];
    static char rwrap[TUI_MIND_WRAP][R_LINE_MAX + 1];
    char left[R_LINE_MAX + 1], right[R_LINE_MAX + 1];
    int tn = 0, pn = 0, ts = 1, ps = 1, half, rest, bar;
    int lrows = 0, rrows = 0, total, maxtop, top, row, i;
    tui_mind_y0 = 0;
    tui_mind_y1 = 0;
    if (!st || !st->mind_open) return;
    tui_page_lines("思维树.md", tree, TUI_MIND_SRC, &tn, &ts);
    tui_page_lines("记忆宫殿.md", palace, TUI_MIND_SRC, &pn, &ps);
    bar = tui_mind_bar(cols, &half, &rest);
    tn = tui_mind_fold(tree, tn, lwrap, TUI_MIND_WRAP, &lrows, half, ts);
    pn = tui_mind_fold(palace, pn, rwrap, TUI_MIND_WRAP, &rrows, rest, ps);
    (void)tn;
    (void)pn;
    total = lrows > rrows ? lrows : rrows;
    if (total < 1) total = 1;
    maxtop = total > TUI_MIND_N ? total - TUI_MIND_N : 0;
    top = st->mind_top;
    if (top < 0) top = 0;
    if (top > maxtop) top = maxtop;
    st->mind_top = top;
    if (*n >= 63) return;
    tui_mind_y0 = *n + 2;
    for (row = 0; row < TUI_MIND_N && *n < 63; row++) {
        int idx = top + row;
        const char *lt = (idx >= 0 && idx < lrows) ? lwrap[idx] : "";
        const char *rt = (idx >= 0 && idx < rrows) ? rwrap[idx] : "";
        tui_col_put(left, half, lt);
        tui_col_put(right, rest, rt);
        if (bar < 0)
            tx_snprintf(line[*n], R_LINE_MAX + 1, "%s%s", left, right);
        else
            tx_snprintf(line[*n], R_LINE_MAX + 1, "%s│%s", left, right);
        rs->body[*n] = line[*n];
        (*n)++;
    }
    tui_mind_y1 = *n + 2;
}

/* Build the frame for a state. The two mind lines also follow the files on
 * disk, so a later redraw can differ after mind writes a page. */
/* Screen row of each visible exec prefix or its one-line command.
 * Filled by the render that just ran. A click looks here, not at pixels. */
#define TUI_HIT_MAX 80
static int tui_hit_y[TUI_HIT_MAX];
static int tui_hit_i[TUI_HIT_MAX];
static int tui_hit_n;

static void tui_hit_add(int y, int logi) {
    if (tui_hit_n >= TUI_HIT_MAX) return;
    tui_hit_y[tui_hit_n] = y;
    tui_hit_i[tui_hit_n] = logi;
    tui_hit_n++;
}

static int tui_log_y0, tui_log_y1;   /* log rows on screen, set by the renderer */

/* The word under screen cell (x, y), if it names an existing regular file:
 * full path into out, "path:LINE" gives *line. Words split on space, quotes,
 * brackets, commas and any non-ASCII byte (so │ and → never join a path;
 * the cost is that non-ASCII paths are not found). Returns 1 on a file. */
static int tui_path_at(tui_state *st, int x, int y, char *out, size_t cap, int *line) {
    r_frame f = tui_render_state(st, st->cols > 0 ? st->cols : 80);
    const char *s;
    char word[1024], here[1024];
    static int off[R_LINE_MAX + 1], sep[R_LINE_MAX + 1];
    int i = 0, n = 0, col = 1, k = -1, a, b;
    sy_stat_t sb;
    *line = 1;
    if (y < 1 || y > f.n) return 0;
    s = f.lines[y - 1];
    /* One entry per code point: byte offset, first column, separator or not. */
    while (s[i] && n < R_LINE_MAX) {
        unsigned int cp = 0;
        int need = tui_next_cp(s + i, &cp);
        if (need <= 0) break;
        off[n] = i;
        sep[n] = cp >= 0x80 || zs_chr(" \t\"'()[],<>`", (int)cp) != NULL;
        if (x >= col && x < col + tui_cp_cols(cp)) k = n;
        col += tui_cp_cols(cp);
        i += need; n++;
    }
    off[n] = i;
    if (k < 0 || sep[k]) return 0;
    for (a = k; a > 0 && !sep[a - 1]; a--) ;
    for (b = k; b + 1 < n && !sep[b + 1]; b++) ;
    if (off[b + 1] - off[a] >= (int)sizeof word) return 0;
    tx_snprintf(word, sizeof word, "%.*s", off[b + 1] - off[a], s + off[a]);
    {
        /* path:LINE or path:LINE:COL */
        char *c = zs_chr(word, ':');
        if (c && c[1] >= '0' && c[1] <= '9') { *line = (int)tx_atol(c + 1); *c = 0; }
        else if (c && !c[1]) *c = 0;
    }
    while (word[0] && zs_chr(".;:", word[(size_t)zs_len(word) - 1])) word[(size_t)zs_len(word) - 1] = 0;
    if (!word[0]) return 0;
    if (word[0] == '~' && word[1] == '/' && sy_env("HOME")) tx_snprintf(out, cap, "%s%s", sy_env("HOME"), word + 1);
    else if (word[0] == '/') tx_snprintf(out, cap, "%s", word);
    else {
        const char *cwd = csih_env("CSIH_CWD", "CDSH_CWD");
        if (!cwd) { if (!tui_getcwd(here, (int)sizeof here)) zs_set(here, (long)sizeof here, "."); cwd = here; }
        tx_snprintf(out, cap, "%s/%s", cwd, word);
    }
    return sy_stat(out, &sb) == 0 && sb.kind == 'f';
}

static void tui_click(tui_state *st, int x, int y) {
    int h;
    if (y >= tui_log_y0 && y < tui_log_y1 && !st->busy) {
        /* A file path under the click opens in /view; anything else falls through. */
        char path[2048], saved[TUI_INPUT_MAX];
        int line, nsaved = st->ninput, back = st->back;
        if (tui_path_at(st, x, y, path, sizeof path, &line)) {
            tx_snprintf(saved, sizeof saved, "%s", st->input);
            tx_snprintf(st->input, TUI_INPUT_MAX, "/view %s %d", path, line);
            st->ninput = (int)(size_t)zs_len(st->input);
            tui_slash(st);
            tx_snprintf(st->input, TUI_INPUT_MAX, "%s", saved);
            st->ninput = nsaved; st->back = back;
            return;
        }
    }
    if (y == tui_sys_rule_y && tui_sys_rule_y > 0) {
        st->sys_open = !st->sys_open;
        st->sys_top = 0;
        return;
    }
    if (y == tui_mind_rule_y && tui_mind_rule_y > 0) {
        st->mind_open = !st->mind_open;
        st->mind_top = 0;
        return;
    }
    for (h = 0; h < tui_hit_n; h++) {
        int i;
        if (tui_hit_y[h] != y) continue;
        i = tui_hit_i[h];
        if (i < 0 || i >= st->nlog || !st->ex_on[i]) return;
        st->ex_open[i] = !st->ex_open[i];
        return;
    }
}

/* Log entries the viewport can hold before an open exec shrinks it. */
static int tui_log_room(const tui_state *st) {
    int rows = st->rows > 0 ? st->rows : 24;
    int sys_rows = st->sys_open ? TUI_SYS_N : 0;
    int mind_rows = st->mind_open ? TUI_MIND_N : 0;
    int room = rows - TUI_FIXED_ROWS - sys_rows - mind_rows - st->npending - st->nstatus;
    if (room < 1) room = 1;
    if (room > TUI_LOG_VIEW) room = TUI_LOG_VIEW;
    return room;
}

/* Visible log entries are [start, end). end hides log_skip newest rows. */
static void tui_log_range(tui_state *st, int *start_out, int *end_out, int *show_out) {
    int show = tui_log_room(st);
    int skip = st->log_skip;
    int end, start, extra, i;
    if (skip < 0) skip = 0;
    end = st->nlog - skip;
    if (end < 0) end = 0;
    start = end - show;
    if (start < 0) start = 0;
    extra = 0;
    for (i = start; i < end; i++)
        if (st->ex_on[i] && st->ex_open[i]) extra++;
    if (extra > 0 && show > extra) show -= extra;
    {
        /* Opening a row spends a slot. Keep that row on screen. */
        int old_start = start;
        int limit = end;
        start = limit - show;
        if (start < 0) start = 0;
        for (i = old_start; i < limit; i++) {
            if (i < start && st->ex_on[i] && st->ex_open[i]) {
                start = i;
                end = start + show;
                if (end > limit) end = limit;
                break;
            }
        }
    }
    if (start_out) *start_out = start;
    if (end_out) *end_out = end;
    if (show_out) *show_out = show;
}

static void tui_log_clamp(tui_state *st) {
    int show = tui_log_room(st);
    int end, start, extra, i, max;
    if (st->log_skip < 0) st->log_skip = 0;
    end = st->nlog - st->log_skip;
    if (end < 0) end = 0;
    start = end - show;
    if (start < 0) start = 0;
    extra = 0;
    for (i = start; i < end; i++)
        if (st->ex_on[i] && st->ex_open[i]) extra++;
    if (extra > 0 && show > extra) show -= extra;
    max = st->nlog - show;
    if (max < 0) max = 0;
    if (st->log_skip > max) st->log_skip = max;
}

/* A new line while reading history stays below the window. */
static void tui_log_hold(tui_state *st) {
    if (st->log_skip > 0) {
        st->log_skip++;
        tui_log_clamp(st);
    }
}

static void tui_log_scroll(tui_state *st, int delta) {
    if (!st || st->mode != 1) return;
    st->log_skip += delta;
    tui_log_clamp(st);
}

/* tui_log_y0/y1 (declared above tui_click): screen rows of the log viewport,
 * filled by the render that just ran. */

/* Wheel over the open system rows still moves that block.
 * dir 1 moves down, dir 2 moves up. A wheel on the log viewport
 * moves history: up shows older entries, down returns toward the tail.
 * Three entries per notch. Anywhere else is ignored. */
static void tui_wheel(tui_state *st, int y, int dir) {
    if (st->sys_open && tui_sys_y0 > 0 && y >= tui_sys_y0 && y < tui_sys_y1) {
        if (dir == 1) st->sys_top++;
        else if (dir == 2 && st->sys_top > 0) st->sys_top--;
        return;
    }
    if (tui_mind_y0 > 0 && y >= tui_mind_y0 && y < tui_mind_y1) {
        if (dir == 1) st->mind_top++;
        else if (dir == 2 && st->mind_top > 0) st->mind_top--;
        return;
    }
    if (tui_log_y0 > 0 && y >= tui_log_y0 && y < tui_log_y1) {
        if (dir == 2) tui_log_scroll(st, 3);
        else if (dir == 1) tui_log_scroll(st, -3);
    }
}

/* One frame row. A raw newline would split the redraw. Draw it as ⏎,
 * and stop on a code-point boundary so a long line is not cut in half.
 * dstmax is the byte budget of one row; the text is wrapped by display
 * columns, so a long event line becomes several rows instead of being
 * cut at the buffer edge. */
static int tui_put_folded_n(char *dst, int dstmax, const char *prefix,
                            const char *src, int cols, int cont) {
    int o = 0, i = 0, w = 0;
    int plen = 0;
    if (!dst || dstmax < 1) return i;
    if (!prefix) prefix = "";
    if (!src) src = "";
    /* Continuation rows keep the prefix column blank so the wrapped
     * body lines up under the first row. */
    while (prefix[o] && o + 1 < dstmax) {
        dst[o] = cont ? ' ' : prefix[o];
        o++;
        plen++;
    }
    if (prefix[o]) { dst[o] = '\0'; return i; }
    w = cont ? 0 : tui_disp_width(prefix);
    if (cols < 1) cols = R_LINE_MAX;
    while (src[i]) {
        unsigned int cp = 0;
        int need, cw;
        if (src[i] == '\n' || src[i] == '\r') {
            if (w + 1 > cols) break;
            if (o + 4 > dstmax) break;
            zs_mcpy(dst + o, "⏎", 3);
            o += 3;
            w += 1;
            if (src[i] == '\r' && src[i + 1] == '\n') i++;
            i++;
            continue;
        }
        need = tui_next_cp(src + i, &cp);
        if (need <= 0) break;
        cw = tui_cp_cols(cp);
        if (w + cw > cols) break;
        if (o + need >= dstmax) break;
        zs_mcpy(dst + o, src + i, (size_t)need);
        o += need;
        i += need;
        w += cw;
    }
    dst[o] = '\0';
    (void)plen;
    return i;
}

/* One folded row, wrapped to `cols` display columns. Kept as a thin
 * wrapper so existing callers keep working. */
static void tui_put_folded(char *dst, int dstmax, const char *prefix, const char *src) {
    int o = 0, i = 0;
    if (!dst || dstmax < 1) return;
    if (!prefix) prefix = "";
    if (!src) src = "";
    while (prefix[o] && o + 1 < dstmax) {
        dst[o] = prefix[o];
        o++;
    }
    if (prefix[o]) { dst[o] = '\0'; return; }
    while (src[i] && o + 1 < dstmax) {
        unsigned int cp = 0;
        int need;
        if (src[i] == '\n' || src[i] == '\r') {
            if (o + 4 > dstmax) break;
            zs_mcpy(dst + o, "⏎", 3);
            o += 3;
            if (src[i] == '\r' && src[i + 1] == '\n') i++;
            i++;
            continue;
        }
        need = tui_next_cp(src + i, &cp);
        if (need <= 0) break;
        if (o + need >= dstmax) break;
        zs_mcpy(dst + o, src + i, (size_t)need);
        o += need;
        i += need;
    }
    dst[o] = '\0';
}

/* One input row. A paste keeps its newlines, drawn as ⏎, and the row
 * stays within `cols` so a long paste cannot fail the width check. */
static long tui_tool_t0;      /* when the current exec started, for the busy clock */

/* The exit line. Returns 0 (print nothing) when the session made no request. */
static int tui_session_summary(char *out, size_t cap) {
    int calls = 0, steps = agent_undo_depth();
    long hit = 0, miss = 0, outk = 0;
    net_session_usage(&calls, &hit, &miss, &outk);
    if (!calls) return 0;
    tx_snprintf(out, cap, "csih 本次会话：请求 %d 次 · 输入 %ld 词元（缓存命中 %d%%）· 输出 %ld 词元 · 文件改动 %d 步%s",
             calls, hit + miss, hit + miss ? (int)(hit * 100 / (hit + miss)) : 0, outk, steps,
             steps ? "（退出后不能再 /undo）" : "");
    return 1;
}

/* Ring the terminal bell when a turn that took 10s or more ends, so tmux flags
 * the window while the user is elsewhere. Only on a tty; CSIH_BELL=0 disables. */
static int tui_should_bell(int tty, const char *env) {
    int sec = 0, tokens = 0, rsec = 0;
    long sent = 0;
    if (!tty || (env && env[0] == '0')) return 0;
    net_progress(&sec, &tokens, &sent, &rsec);
    return sec >= 10;
}

/* Project status rows. csih only shows them; the numbers belong to whatever
 * tool writes the file (progress, next cut, last refusal), so they are as
 * checkable as that tool. File: $CSIH_STATUS_FILE, else ./.csih-status.
 * Up to 3 non-empty lines; the first row says how old the file is, and
 * marks it 陈旧 past $CSIH_STATUS_STALE_SEC (default 600). */
static void tui_status_load(tui_state *st) {
    const char *path = sy_env("CSIH_STATUS_FILE");
    const char *stale_env = sy_env("CSIH_STATUS_STALE_SEC");
    char line[600];
    sy_stat_t sb;
    fio_t *f;
    long age, stale = 600;
    st->nstatus = 0;
    if (!path || !path[0]) path = ".csih-status";
    if (sy_stat(path, &sb) != 0 || sb.kind != 'f') return;
    f = tui_fopen(path, "r");
    if (!f) return;
    if (stale_env && tx_atol(stale_env) > 0) stale = tx_atol(stale_env);
    age = (long)net_now() - sb.mtime;
    if (age < 0) age = 0;
    while (st->nstatus < 3 && fio_gets(line, sizeof line, f)) {
        size_t n = zs_cspn(line, "\r\n");
        char ago[48];
        line[n] = 0;
        if (!line[0]) continue;
        if (st->nstatus == 0) {
            if (age < 60) tx_snprintf(ago, sizeof ago, "%ld秒前", age);
            else if (age < 3600) tx_snprintf(ago, sizeof ago, "%ld分钟前", age / 60);
            else tx_snprintf(ago, sizeof ago, "%ld小时前", age / 3600);
            tx_snprintf(st->status[0], sizeof st->status[0], "项目> %.150s · %s%s",
                     line, age > stale ? "陈旧 " : "", ago);
        } else tx_snprintf(st->status[st->nstatus], sizeof st->status[0], "项目> %.200s", line);
        st->nstatus++;
    }
    fio_close(f);
}

/* 574B, 32.1KB, 1.2MB: byte counts a person can read at a glance. */
static void tui_bytes(char *out, size_t cap, long n) {
    if (n < 1024) tx_snprintf(out, cap, "%ldB", n);
    else if (n < 1024L * 1024) tx_snprintf(out, cap, "%.1fKB", n / 1024.0);
    else tx_snprintf(out, cap, "%.1fMB", n / (1024.0 * 1024));
}

/* Display columns of the first n bytes of s (n < 0: all of it). */
static int tui_str_cols(const char *s, int n) {
    int i = 0, w = 0;
    while (s[i] && (n < 0 || i < n)) {
        unsigned int cp = 0;
        int need = tui_next_cp(s + i, &cp);
        if (need <= 0) break;
        w += tui_cp_cols(cp);
        i += need;
    }
    return w;
}

static void tui_input_row(char *dst, int dstmax, const char *input, int cols, int back) {
    /* ⏎ is 3 bytes for 1, so the folded copy can be three times the input. */
    static char shown[TUI_INPUT_MAX * 3 + 8];
    char piece[R_LINE_MAX + 1];
    char marked[TUI_INPUT_MAX + 4];
    const char *from, *caret;
    int width, len = input ? (int)(size_t)zs_len(input) : 0;
    /* Cursor away from the end: draw a thin bar where the next byte goes. */
    if (back > 0 && back <= len) {
        int at = len - back;
        tx_snprintf(marked, sizeof marked, "%.*s▏%s", at, input, input + at);
        input = marked;
    }
    tui_put_folded(shown, (int)sizeof shown, "", input ? input : "");
    width = cols - 2;
    if (width < 1) width = 1;
    /* Too wide: slide the window so the cursor stays on screen, with … for
     * what scrolled off the left. Without this, typing past the edge vanished. */
    caret = back > 0 ? zs_find(shown, "▏") : NULL;
    if (!caret) caret = shown + (size_t)zs_len(shown);
    from = shown;
    if (tui_str_cols(shown, -1) > width && width > 2) {
        while (*from && tui_str_cols(from, (int)(caret - from)) > width - 2) {
            unsigned int cp = 0;
            int need = tui_next_cp(from, &cp);
            if (need <= 0) break;
            from += need;
        }
    }
    if (from != shown) {
        char rest[R_LINE_MAX + 1];
        tui_utf8_fit(from, width - 1, rest, (int)sizeof rest);
        tx_snprintf(piece, sizeof piece, "…%s", rest);
    } else tui_utf8_fit(shown, width, piece, (int)sizeof piece);
    tx_snprintf(dst, (size_t)dstmax, "> %s", piece);
}

/* After a request finishes the busy line collapses to shortcuts; keep the
 * last phase and its whole-second cost so idle still shows what just ran. */
static const char *idle_last(tui_state *st) {
    static char buf[96];
    int sec = 0, tokens = 0, rsec = 0;
    long sent = 0;
    /* sec is this turn. rsec is only the last request, and must not replace it. */
    net_progress(&sec, &tokens, &sent, &rsec);
    if (!st->phase[0] || (sec <= 0 && !st->ended)) {
        buf[0] = '\0';
        return buf;
    }
    if (st->ended)
        tx_snprintf(buf, sizeof buf, "上一轮 %s", st->phase);
    else
        tx_snprintf(buf, sizeof buf, "上次 %s %d秒", st->phase, sec);
    return buf;
}

static const char *csih_env(const char *neu, const char *old);

/* A turn that did the work but could not be verified is not a failure.
 * ◐ for unverified/partial, ✗ only for a real failure. */
static void tui_result_row(char *out, size_t cap, const agent_result *r) {
    const char *why = r->reason;
    int soft = r->acceptance == AGENT_ACCEPT_UNVERIFIED || r->outcome == AGENT_OUTCOME_PARTIAL
        || r->outcome == AGENT_OUTCOME_UNVERIFIED || !zs_ncmp(why, "unfinished:", 11);
    /* The model itself said it failed: that is ✗, whatever the reason prefix. */
    if (r->outcome == AGENT_OUTCOME_FAILED) soft = 0;
    if (!zs_ncmp(why, "unfinished: ", 12)) why += 12;
    if (!zs_cmp(why, "answer outcome=failed")) why = "模型报告未能完成";
    else if (!zs_cmp(why, "answer outcome=partial")) why = "模型报告只完成了一部分";
    else if (!zs_cmp(why, "answer outcome=unverified")) why = "模型报告结果未经核实";
    tx_snprintf(out, cap, soft ? "◐ 做完未验证: %s" : "✗ 失败: %s", why);
}

/* Undo depth when the current turn started: the difference at the end is how
 * many file writes/edits this turn made. */
static int tui_turn_undo0 = -1;

static void tui_turn_changes(char *out, size_t cap) {
    int d = tui_turn_undo0 < 0 ? 0 : agent_undo_depth() - tui_turn_undo0;
    if (d > 0) tx_snprintf(out, cap, " · 改了 %d 处文件（/diff 查看）", d);
    else if (cap) out[0] = 0;
}

/* The success row: ✓ 已验收 when the judge accepted, else ✓ 已答.
 * Keeps "本轮结束" (probes wait for it) and drops the judge's English tag. */
static void tui_done_row(char *out, size_t cap, const agent_result *r) {
    const char *why = r->reason[0] ? r->reason : "";
    const char *tag = r->acceptance == AGENT_ACCEPT_ACCEPTED ? "✓ 已验收" : "✓ 已答";
    const char *colon = zs_find(why, "): ");
    if (!zs_ncmp(why, "semantic acceptance", 19) && colon) why += colon - why + 3;
    if (!r->answer[0]) tag = "✓ 已结束（未作答）";
    {
        /* How long the turn took, from the turn clock; left out when unknown. */
        int sec = 0, tokens = 0, rsec = 0;
        long sent = 0;
        char took[24] = "";
        net_progress(&sec, &tokens, &sent, &rsec);
        char ch[64];
        if (sec > 0) tx_snprintf(took, sizeof took, " · %d秒", sec);
        /* File changes go before the judge's reason, which may be cut at the row's end. */
        tui_turn_changes(ch, sizeof ch);
        tx_snprintf(out, cap, "%s · 本轮结束 %d 轮 %d 步%s%s%s%s", tag, r->rounds, r->actions, took, ch,
                 why[0] ? " · " : "", why);
    }
}

/* Model · cwd · key source, so a bad key or wrong place shows at a glance. */
static void tui_title_info(char *out, size_t cap, const char *model, const char *cwd) {
    int len = 0, src = net_deepseek_key_probe(&len);
    const char *home = sy_env("HOME");
    size_t hn = home ? (size_t)zs_len(home) : 0;
    /* cwd last: it is the longest, so a narrow window cuts it, not the key. */
    const char *ks = src == 1 ? "env" : src == 2 ? "file" : "missing";
    static const char *perm[] = { "read", "work", "any" };
    const char *pm = agent_get_perm() == 1 && !agent_get_net() ? "work·断网" : perm[agent_get_perm()];
    if (hn && cwd && !zs_ncmp(cwd, home, hn) && (cwd[hn] == '/' || !cwd[hn]))
        tx_snprintf(out, cap, "%s · key=%s · %s · ~%s", model, ks, pm, cwd + hn);
    else
        tx_snprintf(out, cap, "%s · key=%s · %s · %s", model, ks, pm, cwd ? cwd : "?");
}

static const char *tui_role_title(const tui_state *st) {
    static char buf[64];
    const char *role, *peer;
    if (st->owned) { role = st->owned->role; peer = st->owned->peer; }
    else { role = sy_env("CSIH_ROLE"); peer = sy_env("CSIH_PEER"); }
    if (!role || !role[0]) return "csih · agent";
    (void)peer;
    if (!zs_cmp(role, "write"))
        tx_snprintf(buf, sizeof buf, "csih · 写");
    else if (!zs_cmp(role, "watch"))
        tx_snprintf(buf, sizeof buf, "csih · 看");
    else
        return "csih · agent";
    return buf;
}

static r_frame tui_render_state(tui_state *st, int cols) {
    r_state rs;
    r_frame f;
    /* One buffer per body line: render() copies each into the frame, so the
     * pointers only need to outlive the render() call. A single shared buffer
     * here would mean every body line aliases the last one. */
    char line[64][R_LINE_MAX + 1];
    int n = 0, i;
    char hint[R_LINE_MAX + 1];

    zs_mset(&rs, 0, sizeof rs);
    tui_hit_n = 0;
    tui_sys_rule_y = 0;
    tui_sys_y0 = 0;
    tui_sys_y1 = 0;
    tui_log_y0 = 0;
    tui_log_y1 = 0;
    rs.title = (st->mode == 1) ? tui_role_title(st) : "csih";
    if (st->mode == 1) {
        static char title[R_LINE_MAX + 1];
        char info[1400], here[1024];
        const char *model = csih_env("CSIH_MODEL", "CDSH_MODEL");
        const char *cwd = csih_env("CSIH_CWD", "CDSH_CWD");
        if (!cwd) { if (!tui_getcwd(here, (int)sizeof here)) zs_set(here, (long)sizeof here, "."); cwd = here; }
        if (st->model[0]) model = st->model;
        tui_title_info(info, sizeof info, model ? model : "deepseek-chat", cwd);
        tx_snprintf(title, sizeof title, "%s · %s", rs.title, info);
        rs.title = title;
    }
    if (st->owned) {
        static char bound_title[160];
        tx_snprintf(bound_title, sizeof bound_title, "%s · %.64s", rs.title, st->owned->candidate_hash);
        rs.title = bound_title;
    }
    rs.width = cols;
    /* Idle agent hint stays fixed. While a call is in flight, show whole
     * seconds only. Cache hit/miss appear only after a real usage object.
     * This line sits under the input and above the mind block. */
    if (st->mode == 1) {
        int sec = 0, tokens = 0, hit = 0, miss = 0, seen = 0;
        long sent = 0, got = 0;
        if (st->busy) {
            char up[16], down[16];
            /* A finished tool leaves its phase behind; an open request means the model again. */
            const char *phase = (net_in_flight() && !zs_ncmp(st->phase, "跑命令", 9)) ? "等模型" : st->phase;
            net_progress(&sec, &tokens, &sent, &sec);
            /* While a command runs, show how long it has been running. */
            if (phase == st->phase && !zs_ncmp(phase, "跑命令", 9) && tui_tool_t0)
                sec = (int)((long)net_now() - tui_tool_t0);
            net_recv(&got);
            net_cache(&hit, &miss, &seen);
            tui_bytes(up, sizeof up, sent);
            tui_bytes(down, sizeof down, got);
            if (seen && hit + miss > 0)
                tx_snprintf(hint, sizeof hint,
                         "⏳ %s %d秒 · %d词元 · ↑%s 已收%s · 缓存命中%d%%",
                         phase, sec, tokens, up, down, hit * 100 / (hit + miss));
            else
                tx_snprintf(hint, sizeof hint,
                         "⏳ %s %d秒 · %d词元 · ↑%s 已收%s",
                         phase, sec, tokens, up, down);
        } else if (st->ask_exit)
            tx_snprintf(hint, sizeof hint, "要退出请按 Ctrl-D");
        else if (st->log_skip > 0)
            tx_snprintf(hint, sizeof hint, "更早%d · End回底", st->log_skip);
        else {
            const char *prev = idle_last(st);
            const char *sep = prev[0] ? " · " : "";
            char raw[R_LINE_MAX + 1];
            int fit = cols > 0 ? cols : 1;
            if (fit > R_MAX_COLS) fit = R_MAX_COLS;
            /* A fresh, empty screen says where to start; after that, stay short. */
            tx_snprintf(raw, sizeof raw, "%s%sEnter 发送%s", prev, sep,
                     st->nlog == 0 && !st->ninput ? " · /help 看命令 · / 加 Tab 补全 · Alt-Enter 换行" : "");
            tui_utf8_fit(raw, fit, hint, (int)sizeof hint);
        }
    } else if (st->ask_exit)
        tx_snprintf(hint, sizeof hint, "要退出请按 Ctrl-D · %d", st->ticks);
    else
        tx_snprintf(hint, sizeof hint, "Ctrl-C 清空输入/结果 · Ctrl-D 退出 · %d", st->ticks);
    if (st->errline[0]) {
        char with[R_LINE_MAX + 1];
        char fitted[R_LINE_MAX + 1];
        int fit = cols > 0 ? cols : 1;
        if (fit > R_MAX_COLS) fit = R_MAX_COLS;
        tx_snprintf(with, sizeof with, "%s · 错误> %s", hint, st->errline);
        tui_utf8_fit(with, fit, fitted, (int)sizeof fitted);
        tx_snprintf(hint, sizeof hint, "%s", fitted);
    }

    if (st->mode == 1) {
        /* Log viewport is TUI_LOG_VIEW when the terminal allows it.
         * Fewer log lines are padded so the block does not collapse.
         * Mind and system drawers add their rows only while open. */
        int show, starti = 0, endi = 0, view_at, filled;
        tui_status_load(st);
        for (i = 0; i < st->nstatus && n < 40; i++) {
            tui_utf8_fit(st->status[i], cols, line[n], R_LINE_MAX + 1);
            rs.body[n] = line[n]; n++;
        }
        tui_log_clamp(st);
        tui_log_range(st, &starti, &endi, &show);
        view_at = n;
        tui_log_y0 = view_at + 2;
        for (i = starti; i < endi && n < 40; i++) {
            if (st->ex_on[i]) {
                char tag[32];
                char head[220];
                char cond[40];
                const char *kind = st->ex_tag[i][0] ? st->ex_tag[i] : "exec";
                /* Title is frame row 1, so body index n is screen row n+2.
                 * Closed: the explanation and a short call. Open: that line,
                 * the full call when it was shortened, then the tool output. */
                tx_snprintf(tag, sizeof tag, "%s[%s]> ", kind,
                         st->ex_open[i] ? "收缩" : "展开");
                tui_condense(cond, (int)sizeof cond, st->ex_cmd[i], 28);
                if (cond[0])
                    tx_snprintf(head, sizeof head, "%s · %s", st->ex_why[i], cond);
                else
                    tx_snprintf(head, sizeof head, "%s", st->ex_why[i]);
                if (!st->ex_open[i]) {
                    /* Closed: one row, with the first status line of the body. */
                    const char *b = st->ex_body[i];
                    while (*b && !zs_ncmp(b, "evidence ", 9)) {
                        b = zs_chr(b, '\n');
                        b = b ? b + 1 : "";
                    }
                    if (*b) {
                        size_t hl = (size_t)zs_len(head);
                        int sl = (int)zs_cspn(b, "\n");
                        if (sl > 60) {
                            sl = 60;
                            while (sl > 0 && ((unsigned char)b[sl] & 0xC0) == 0x80) sl--;
                        }
                        tx_snprintf(head + hl, sizeof head - hl, " · %.*s", sl, b);
                    }
                }
                {
                    const char *p = head;
                    int cont = 0;
                    while (*p && n < 40) {
                        int used = tui_put_folded_n(line[n], (int)sizeof line[n],
                                                    tag, p, cols, cont);
                        rs.body[n] = line[n];
                        tui_hit_add(n + 2, i);
                        n++;
                        if (used <= 0) break;
                        p += used;
                        cont = 1;
                    }
                    if (n == 0) { line[0][0] = '\0'; }
                }
                if (st->ex_open[i] && n < 40 && st->ex_cmd[i][0]
                    && zs_cmp(st->ex_cmd[i], cond) != 0) {
                    const char *p = st->ex_cmd[i];
                    int cont = 0;
                    while (*p && n < 40) {
                        int used = tui_put_folded_n(line[n], (int)sizeof line[n],
                                                    "  ", p, cols, cont);
                        rs.body[n] = line[n];
                        tui_hit_add(n + 2, i);
                        n++;
                        if (used <= 0) break;
                        p += used;
                        cont = 1;
                    }
                }
                if (st->ex_open[i] && n < 40 && st->ex_body[i][0]) {
                    /* One body line per row, each under its own bar. */
                    const char *seg = st->ex_body[i];
                    int brows = 0;
                    while (*seg && n < 40 && brows < 8) {
                        char one[1024];
                        size_t sl = zs_cspn(seg, "\n");
                        const char *p = one;
                        int cont = 0;
                        if (sl >= sizeof one) sl = sizeof one - 1;
                        zs_mcpy(one, seg, sl); one[sl] = 0;
                        seg += sl; if (*seg == '\n') seg++;
                        if (!one[0]) continue;
                        while (*p && n < 40 && brows < 8) {
                            int used = tui_put_folded_n(line[n], (int)sizeof line[n],
                                                        "  │ ", p, cols, cont);
                            rs.body[n] = line[n];
                            tui_hit_add(n + 2, i);
                            n++;
                            brows++;
                            if (used <= 0) break;
                            p += used;
                            cont = 1;
                        }
                    }
                }
            } else {
                {
                    const char *p = st->log[i];
                    int cont = 0;
                    while (*p && n < 40) {
                        int used = tui_put_folded_n(line[n], (int)sizeof line[n],
                                                    "", p, cols, cont);
                        rs.body[n] = line[n]; n++;
                        if (used <= 0) break;
                        p += used;
                        cont = 1;
                    }
                }
            }
        }
        filled = n - view_at;
        (void)filled;
        (void)show;
        tui_log_y1 = n + 2;
        if (st->loop_on) {
            char gfold[R_LINE_MAX + 1];
            char suffix[32];
            int glen;
            tx_snprintf(suffix, sizeof suffix, " · loop> %s", st->loop_on ? "on" : "off");
            glen = (int)sizeof line[n] - (int)(size_t)zs_len("goal> ") - (int)(size_t)zs_len(suffix);
            if (glen < 1) glen = 1;
            tui_put_folded_n(gfold, glen, "", st->goal, glen, 0);
            tx_snprintf(line[n], sizeof line[n], "goal> %s%s", gfold, suffix);
            rs.body[n] = line[n]; n++;
        }
        for (i = 0; i < st->npending && n < 62; i++) {
            {
                const char *p = st->pending[i];
                int cont = 0;
                while (*p && n < 62) {
                    int used = tui_put_folded_n(line[n], (int)sizeof line[n],
                                                "待发送> ", p, cols, cont);
                    rs.body[n] = line[n]; n++;
                    if (used <= 0) break;
                    p += used;
                    cont = 1;
                }
            }
        }
        tui_input_row(line[n], (int)sizeof line[n], st->input, cols, st->ninput - tui_cursor(st));
        rs.body[n] = line[n]; n++;
        tx_snprintf(line[n], sizeof line[n], "%s", hint);
        rs.body[n] = line[n]; n++;
        tui_sys_rule(&rs, line, &n, cols, st);
        tui_sys_block(&rs, line, &n, cols, st);
        tui_mind_rule(&rs, line, &n, cols, st);
        tui_mind_block(&rs, line, &n, cols, st);
    } else {
        tui_input_row(line[n], (int)sizeof line[n], st->input, cols, st->ninput - tui_cursor(st));
        rs.body[n] = line[n]; n++;
        tx_snprintf(line[n], sizeof line[n], "%s", hint);
        rs.body[n] = line[n]; n++;
        tui_sys_rule(&rs, line, &n, cols, st);
        tui_sys_block(&rs, line, &n, cols, st);
        tui_mind_rule(&rs, line, &n, cols, st);
        tui_mind_block(&rs, line, &n, cols, st);
        tx_snprintf(line[n], sizeof line[n], "%s", st->notice ? st->notice : "");
        rs.body[n] = line[n]; n++;
        tx_snprintf(line[n], sizeof line[n], "ticks %d  cols %d", st->ticks, cols);
        rs.body[n] = line[n]; n++;
        tx_snprintf(line[n], sizeof line[n], "%s", st->last[0] ? st->last : "-");
        rs.body[n] = line[n]; n++;
        tx_snprintf(line[n], sizeof line[n], "%s", st->output[0] ? st->output : "");
        rs.body[n] = line[n]; n++;
    }

    for (i = 0; i < n; i++) tui_pad_disp(line[i], cols);
    rs.nbody = n;
    rs.status = 0;
    f = render(&rs);
    return f;
}

/*
 * Redraw against the module-level previous frame. Kept as ONE function used by
 * both the main loop and the agent event callback, so a live event and the next
 * idle tick stay consistent — they share `tui_prev`.
 */
static r_frame tui_prev;
static int tui_repaint;

/* Rewrite every row. frame_diff skips unchanged lines, so a kernel line
 * (nfs server localhost:/: not responding) stays painted on a rule until
 * that row's text changes. A tick repaint puts the frame back. */
/* Colour on the way out only: frames stay plain text, so widths, diffs and
 * every test that reads a frame are unchanged. ✓ green, ◐ yellow, ✗ and
 * blocked red, project rows cyan. NO_COLOR or CSIH_COLOR=0 turns it off. */
static const char *tui_line_color(const char *line) {
    static int off = -1;
    if (off < 0) {
        const char *nc = sy_env("NO_COLOR"), *cc = sy_env("CSIH_COLOR");
        off = (nc && nc[0]) || (cc && cc[0] == '0');
    }
    if (off || !line) return NULL;
    if (!zs_ncmp(line, "✓ ", 4)) return "\x1b[32m";
    if (!zs_ncmp(line, "◐ ", 4)) return "\x1b[33m";
    if (!zs_ncmp(line, "✗ ", 4) || !zs_ncmp(line, "  │ blocked:", 14)) return "\x1b[31m";
    if (!zs_ncmp(line, "项目> ", 8)) return "\x1b[36m";
    return NULL;
}

static size_t tui_put_line(char *out, size_t cap, int row, const char *line) {
    const char *c = tui_line_color(line);
    return (size_t)tx_snprintf(out, cap, c ? "\x1b[%d;1H%s%s\x1b[0m\x1b[K" : "\x1b[%d;1H%s%s\x1b[K",
                            row, c ? c : "", line);
}

static void tui_paint_all(const r_frame *f) {
    char out[R_FRAME_BYTES + R_MAX_LINES * 32];
    size_t used = 0;
    int i;
    used += (size_t)tx_snprintf(out + used, sizeof out - used, "\x1b[H");
    for (i = 0; i < f->n && used + 32 < sizeof out; i++)
        used += tui_put_line(out + used, sizeof out - used, i + 1, f->lines[i]);
    if (used + 16 < sizeof out)
        used += (size_t)tx_snprintf(out + used, sizeof out - used, "\x1b[J");
    if (used > 0) tui_write_all(out, used);
}

static void tui_redraw(tui_state *st) {
    r_frame next = tui_render_state(st, st->cols);
    char out[R_FRAME_BYTES + R_MAX_LINES * 32];   /* room for colour escapes on every row */
    /* A bad-width line would write a shorter frame over a longer one and leave
     * the previous frame's tail on screen — the classic redraw artifact. */
    if (tui_frame_bad_width(&next, st->cols)) return;
    if (tui_repaint) {
        tui_paint_all(&next);
        tui_repaint = 0;
    } else {
        /* frame_diff, plus colour: rewrite only changed rows. */
        size_t used = 0;
        int i, lines = next.n > tui_prev.n ? next.n : tui_prev.n;
        for (i = 0; i < lines && used + 32 < sizeof out; i++) {
            const char *a = i < tui_prev.n ? tui_prev.lines[i] : "";
            const char *b = i < next.n ? next.lines[i] : "";
            if (!zs_cmp(a, b)) continue;
            used += tui_put_line(out + used, sizeof out - used, i + 1, b);
        }
        if (used) tui_write_all(out, used < sizeof out ? used : sizeof out - 1);
    }
    tui_prev = next;
}

/*
 * The agent event callback: every step the model takes lands here, is appended
 * to the scrollback, and triggers an immediate redraw — so the screen updates
 * live while the (synchronous) agent loop is in flight. `ud` is the tui_state,
 * which is why this is a plain function pointer rather than a closure.
 */
static void tui_agent_event(const char *line, void *ud) {
    tui_state *st = (tui_state *)ud;
    /* A folded step carries the live tool and path, tab-separated:
     * fold<TAB><tool><TAB><sub><TAB><path>. Show it as the phase. Anything
     * else means the loop is back to waiting on the model. */
    if (!zs_ncmp(line, "fold\t", 5)) {
        const char *a = line + 5;
        const char *b = zs_chr(a, '\t');
        const char *c = b ? zs_chr(b + 1, '\t') : NULL;
        char tool[32], sub[32], path[96];
        tool[0] = sub[0] = path[0] = '\0';
        if (b) {
            tx_snprintf(tool, sizeof tool, "%.*s", (int)(b - a), a);
            if (c) {
                tx_snprintf(sub, sizeof sub, "%.*s", (int)(c - (b + 1)), b + 1);
                tx_snprintf(path, sizeof path, "%s", c + 1);
            }
        }
        if (path[0] && sub[0])
            tx_snprintf(st->phase, sizeof st->phase, "%s %s %s", tool, sub, path);
        else if (path[0])
            tx_snprintf(st->phase, sizeof st->phase, "%s %s", tool, path);
        else if (sub[0])
            tx_snprintf(st->phase, sizeof st->phase, "%s %s", tool[0] ? tool : "工具", sub);
        else
            tx_snprintf(st->phase, sizeof st->phase, "%s", tool[0] ? tool : "工具");
    } else if (!zs_ncmp(line, "exec\t", 5)) {
        /* The exec row arrives before the command runs; say so instead of 等模型. */
        const char *cmd = zs_rchr(line, '\t');
        char shortc[40];
        tui_condense(shortc, (int)sizeof shortc, cmd ? cmd + 1 : "", 24);
        tx_snprintf(st->phase, sizeof st->phase, "跑命令 %s", shortc);
        tui_tool_t0 = (long)net_now();
    } else if (!zs_ncmp(line, "  evidence ", 11) || !zs_ncmp(line, "  │ ", 6)) {
        /* Tool output rows: the tool is still the current step. */
    } else if (st->busy) {
        tx_snprintf(st->phase, sizeof st->phase, "等模型");
    }
    tui_log_event(st, line);
    tui_redraw(st);
}

/*
 * Run the agent on the typed prompt. Enumerates the live tmux windows so the
 * model may drive them for interactive development, then drives agent_run_cb
 * with tui_agent_event as the live hook. On return, the answer and a summary are
 * appended to the scrollback and one final redraw shows them.
 */
static tui_state *net_tick_st;

/* Runs between curl_multi_wait slices. Must not call back into the agent. */
static void tui_during_net(void) {
    tui_state *st = net_tick_st;
    term_key_t batch[16];
    int nk, j, room;
    if (!st) return;
    tui_mail_poll(st, 0);
    if (term_wait_readable(0) == 1) {
        room = tui_q_room(st);
        if (room > 16) room = 16;
        if (room <= 0) { st->ticks++; tui_redraw(st); return; }
        nk = term_read_keys(batch, room);
        for (j = 0; j < nk; j++) {
            /* Cancel this turn only. quit would leave the read loop and the
             * pane would sit on the prompt with nobody reading keys. */
            st->more_keys = (j + 1 < nk);
            if (batch[j].kind == TERM_KEY_CTRL_C || batch[j].kind == TERM_KEY_CTRL_D) {
                tui_apply_key(st, (int)batch[j].kind, batch[j].ch);
                continue;
            }
            if (batch[j].kind == TERM_KEY_MOUSE) {
                tui_click(st, batch[j].x, batch[j].y);
                tui_redraw(st);
                continue;
            }
            if (batch[j].kind == TERM_KEY_WHEEL) {
                tui_wheel(st, batch[j].y, (int)(unsigned char)batch[j].ch);
                tui_redraw(st);
                continue;
            }
            /* Apply now so Enter can park the line. Queueing it would run
             * only after this call, and the old code dropped Enter entirely. */
            tui_apply_key(st, (int)batch[j].kind, batch[j].ch);
        }
        st->more_keys = 0;
    }
    st->ticks++;
    tui_repaint = 1;
    tui_redraw(st);
}

/* exec runs synchronously; shell calls this every ~200ms meanwhile, so keys
 * (Esc/Ctrl-C cancel) and the clock keep working. Nonzero kills the command. */
static int tui_during_shell(void) {
    tui_state *st = net_tick_st;
    if (!st || !st->busy) return 0;
    tui_during_net();
    return st->cancel;
}

static const char *csih_env(const char *neu, const char *old) {
    const char *v = sy_env(neu);
    if (v && v[0]) return v;
    v = sy_env(old);
    if (v && v[0]) return v;
    return 0;
}

/* selftest fixtures: under the temp root, removed through the one deletion guard (include/unisa_safedel.h) */
static const char *tui_selftest_tmp(void) { const char *t = sy_env("TMPDIR"); return t && t[0] ? t : "/tmp"; }
static int tui_selftest_rm(const char *path, unsigned flags) {
    char why[600]; int rc;
    if (flags) rc = csih_safedel_purge(path, why, (int)sizeof why);
    else rc = csih_safedel_purge_file(path, why, (int)sizeof why);
    if (rc) sy_printf("FAIL selftest cleanup: %s\n", why);
    return rc;
}

static int tui_run_prompt(tui_state *st, const char *source_prompt, int clear_manual_input) {
    const char *endpoint = csih_env("CSIH_ENDPOINT", "CDSH_ENDPOINT");
    const char *model    = csih_env("CSIH_MODEL", "CDSH_MODEL");
    const char *cwd      = csih_env("CSIH_CWD", "CDSH_CWD");
    char journal[512];
    const char *transcript;
    char real_cwd[1024];
    char extra[1536];
    char prompt[TUI_INPUT_MAX];
    agent_result r;

    if (!endpoint) endpoint = "https://api.deepseek.com/v1/chat/completions";
    if (!model)    model = "deepseek-chat";
    if (st->model[0]) model = st->model;
    if (!cwd) { if (!tui_getcwd(real_cwd, (int)sizeof real_cwd)) zs_set(real_cwd, (long)sizeof real_cwd, "."); cwd = real_cwd; }
    /* Same file across turns and across the cache re-exec. Do not delete it. */
    if (st->owned) {
        cwd = st->owned->cwd;
        transcript = st->transcript;
    } else {
        if (agent_transcript_path(journal, sizeof journal) != 0)
            tx_snprintf(journal, sizeof journal, "/tmp/csih-agent-%d.jsonl", (int)sy_pid());
        transcript = journal;
    }

    /* A send follows the new line. History scroll stays put until then. */
    st->log_skip = 0;
    /* Capture the prompt before clearing the input line. */
    zs_mset(prompt, 0, sizeof prompt);
    zs_ncpy(prompt, source_prompt, sizeof prompt - 1);

    /* A window list only when the user named a window. Otherwise it becomes
     * the last user turn and the model answers tmux instead of the question. */
    extra[0] = '\0';
    if (agent_mentions_window(prompt)) {
        shell_result sr = shell_run_in(
            "tmux list-windows -F '#{window_index} #{window_name}' 2>/dev/null "
            "| grep -v \"^$(tmux display-message -p '#{window_index}') \"",
            NULL);
        if (sr.ok && sr.out[0]) {
            tx_snprintf(extra, sizeof extra,
                "下面是窗口清单，只有用户要求操作窗口时才用。\n%s",
                sr.out);
        }
    }

    /* Record the prompt, then clear the input line so the next frame shows it. */
    {
        char you[240];
        tx_snprintf(you, sizeof you, "you> %s", prompt);
        tui_log_plain(st, you);
    }
    if (clear_manual_input) { st->input[0] = '\0'; st->ninput = 0; }
    st->errline[0] = '\0';   /* new you>: drop last round's error */
    tui_redraw(st);

    st->cancel = 0;
    st->busy = 1;
    st->ended = 0;
    st->busy_tick = st->ticks;
    tx_snprintf(st->phase, sizeof st->phase, "等模型");
    tui_redraw(st);
    net_tick_st = st;
    tui_turn_undo0 = agent_undo_depth();
    shell_set_tick(tui_during_shell);
    {char *context=NULL;
        if(!context_index_packet(st->owned,st->owned_dir,&context) || agent_context_packet(context)!=0){
            mm_free(context);st->busy=0;tui_log_plain(st,"context-index unavailable: capture/encoding failed");tui_redraw(st);return 1;
        }
        mm_free(context);
    }
    if (agent_turn_begin(prompt, transcript, endpoint, model, cwd, extra, tui_agent_event, st) != 0) {
        r = agent_turn_take();
        st->busy = 0;
        {
            char fail[360];
            tx_snprintf(fail, sizeof fail, "✗ 失败: %s", r.reason);
            tui_log_plain(st, fail);
        }
        tui_redraw(st);
        return 1;
    }
    return 0;
}

static int tui_run_agent(tui_state *st) {
    return tui_run_prompt(st, st->input, 1);
}

/* Automatic prompts never borrow the manual editor. The real agent copies
 * the dedicated prompt before returning; later keys continue editing input. */
static int tui_run_pending(tui_state *st) {
    char prompt[TUI_INPUT_MAX];
    if (st->busy || st->npending <= 0) return 0;
    tx_snprintf(prompt, sizeof prompt, "%s", st->pending[0]);
    st->npending--;
    zs_mmove(st->pending[0], st->pending[1], (size_t)st->npending * TUI_INPUT_MAX);
    st->pending[st->npending][0] = 0;
    return tui_run_prompt(st, prompt, 0);
}

static void tui_turn_done(tui_state *st) {
    agent_result r = agent_turn_take();
    int cancelled = st->cancel || r.err == -5;
    int from_mail = st->mail_active;
    st->cancel = 0;
    st->busy = 0;
    /* Overwrite the in-flight phase with the stop cause so the idle bottom
     * bar writes how this turn ended, not a stale "等模型". */
    st->ended = 1;
    if (cancelled)
        tx_snprintf(st->phase, sizeof st->phase, "已取消");
    else if (!r.ok)
        tx_snprintf(st->phase, sizeof st->phase, "%s", r.outcome==AGENT_OUTCOME_PARTIAL ? "部分完成" : (r.outcome==AGENT_OUTCOME_UNVERIFIED || r.acceptance==AGENT_ACCEPT_UNVERIFIED) ? "未验证" : "出错");
    else if (r.answer[0])
        tx_snprintf(st->phase, sizeof st->phase, "%s",r.scope==AGENT_SCOPE_ANSWER_ONLY ? "咨询已答" : "语义接受");
    else if (r.stopped)
        tx_snprintf(st->phase, sizeof st->phase, "动作打满未答");
    else
        tx_snprintf(st->phase, sizeof st->phase, "未答");
    if (from_mail)
        tui_mail_complete(st, cancelled ? "cancelled" : r.ok ? (r.scope==AGENT_SCOPE_ANSWER_ONLY ? "answered" : "ok") : r.outcome==AGENT_OUTCOME_PARTIAL ? "partial" : (r.outcome==AGENT_OUTCOME_UNVERIFIED || r.acceptance==AGENT_ACCEPT_UNVERIFIED) ? "unverified" : "failed", r.reason);
    if (cancelled) {
        tui_log_plain(st, "已取消");
        tui_redraw(st);
        return;
    }
    if (!r.ok) {
        /* The answer already showed as its 完成声明/失败声明 row; do not print it twice. */
        if (r.answer[0])
            tx_snprintf(st->last_answer, sizeof st->last_answer, "%s", r.answer);
        {
            char fail[360], ch[64];
            size_t fl;
            tui_result_row(fail, sizeof fail, &r);
            tui_turn_changes(ch, sizeof ch);
            fl = (size_t)zs_len(fail);
            tx_snprintf(fail + fl, sizeof fail - fl, "%s", ch);
            tui_log_plain(st, fail);
        }
    } else {
        tx_snprintf(st->last_answer, sizeof st->last_answer, "%s",
                 r.answer[0] ? r.answer : "(no answer text)");
        {
            char sum[240];
            tui_done_row(sum, sizeof sum, &r);
            tui_log_plain(st, sum);
        }
    }
    tui_redraw(st);
    if (tui_should_bell(sy_isatty(1), sy_env("CSIH_BELL"))) sy_write_all(1, "\a", 1);   /* the screen is written to fd 1 directly too */
    if (!cancelled && r.ok && st->loop_on && !from_mail) tui_queue_goal(st);
}


/* One actor per process. The inherited private stream is a trusted host
 * capability, not an authentication protocol. No actor crosses exec. */
static struct {
    int fd, phase, raw, retired, used;
    char session[65], handoff[65], hash[65], dir[4096];
    char next_handoff[65], next_hash[65], frame[1024];
} tui_managed;

static int tui_managed_send(const char *op, int pending) {
    char line[512]; int n;
    n = tx_snprintf(line, sizeof line,
        "{\"op\":\"%s\",\"session\":\"%s\",\"handoff\":\"%s\",\"hash\":\"%s\"}\n",
        op, tui_managed.session, pending ? tui_managed.next_handoff : tui_managed.handoff,
        pending ? tui_managed.next_hash : tui_managed.hash);
    return n > 0 && n < (int)sizeof line && sy_write_all(tui_managed.fd, line, n) == 0 ? 0 : -1;
}

static int tui_managed_request(tui_state *st) {
    if (!tui_managed.phase || tui_managed.phase != 3 || st->busy ||
        !st->owned || st->owner_fd < 0) return -1;
    if (tui_managed_send("REQUEST", 0) != 0) { st->quit = 1; return -1; }
    st->input[0] = 0; st->ninput = 0;
    return 0;
}

static int tui_managed_init(const char *dir, const char *sid, const char *hid,
                            const char *hash, const char *fdtext, int standby) {
    sy_stat_t sb; int dfd, fd = 0, flags, i;
    if (!dir || dir[0] != '/' || (size_t)zs_len(dir) > 4000 || dir[(size_t)zs_len(dir)-1] == '/' ||
        !tui_owned_id(sid, 0) || (size_t)zs_len(sid) > 64 || !tui_owned_id(hid, 0) ||
        (size_t)zs_len(hid) > 64 || !hash || (size_t)zs_len(hash) != 64 || !fdtext || !*fdtext) return -1;
    for (i = 0; i < 64; i++) if (!zs_chr("0123456789abcdefABCDEF", hash[i])) return -1;
    for (i = 0; fdtext[i]; i++) {
        if (fdtext[i] < '0' || fdtext[i] > '9' || fd > 100000) return -1;
        fd = fd * 10 + fdtext[i] - '0';
    }
    if (fd < 3 || sy_fstat(fd, &sb) != 0 || sb.kind != 's') return -1;
    flags = 0;
    if (sy_fd_nonblock(fd, 1) != 0 || sy_fd_cloexec(fd, 1) != 0) return -1;
    dfd = sy_open(dir, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC, 0);
    if (dfd < 0) return -1;
    {
        sy_stat_t ds;
        i = sy_fstat(dfd, &ds) == 0 && ds.kind == 'd' && ds.uid == (long)sy_uid() && (ds.mode & 0777) == 0700;
    }
    if (sy_close(dfd) != 0 || !i) return -1;
    zs_mset(&tui_managed, 0, sizeof tui_managed);
    tui_managed.fd = fd; tui_managed.phase = standby ? 1 : 2;
    tx_snprintf(tui_managed.dir, sizeof tui_managed.dir, "%s", dir);
    tx_snprintf(tui_managed.session, sizeof tui_managed.session, "%s", sid);
    tx_snprintf(tui_managed.handoff, sizeof tui_managed.handoff, "%s", hid);
    tx_snprintf(tui_managed.hash, sizeof tui_managed.hash, "%s", hash);
    return 0;
}

static int tui_managed_message(tui_state *st) {
    jvalue *root, *o, *sid, *hid, *hash;
    const char *op; char why[256], path[4096], lock[4096];
    int match, pending, rc = -1; size_t i;
    reload_session_state *m = NULL;
    reload_io_token token;
    root = NULL;
    if (!tr_no_embedded_nul(tui_managed.frame, tui_managed.used, why, sizeof why)) goto done;
    root = json_parse(tui_managed.frame, tui_managed.used, why, sizeof why);
    if (!root || root->kind != J_OBJ || root->nkeys != 4) goto done;
    for (i = 0; i < root->nkeys; i++) {
        size_t j;
        if (zs_cmp(root->keys[i], "op") && zs_cmp(root->keys[i], "session") &&
            zs_cmp(root->keys[i], "handoff") && zs_cmp(root->keys[i], "hash")) goto done;
        for (j = 0; j < i; j++) if (!zs_cmp(root->keys[i], root->keys[j])) goto done;
    }
    o = jget(root, "op"); sid = jget(root, "session"); hid = jget(root, "handoff"); hash = jget(root, "hash");
    if (!o || !sid || !hid || !hash || o->kind != J_STR || sid->kind != J_STR ||
        hid->kind != J_STR || hash->kind != J_STR || zs_cmp(sid->s, tui_managed.session)) goto done;
    op = o->s;
    match = !zs_cmp(hid->s, tui_managed.handoff) && !zs_cmp(hash->s, tui_managed.hash);
    pending = tui_managed.next_handoff[0] && !zs_cmp(hid->s, tui_managed.next_handoff) && !zs_cmp(hash->s, tui_managed.next_hash);
    if (!zs_cmp(op, "ACTIVATE") && match && tui_managed.phase == 2) {
        tui_managed.phase = 3; tui_repaint = 1; rc = 0;
    } else if (!zs_cmp(op, "COMMIT") && match && tui_managed.phase == 1) {
        tx_snprintf(path, sizeof path, "%s/handoff-%s.json", tui_managed.dir, tui_managed.handoff);
        if (tui_owned_start(st, tui_managed.dir, tui_managed.session, tui_managed.hash,
            path, tui_managed.handoff, &token, why, sizeof why) != 0) goto fatal;
        if (term_raw_enter() != 0) goto fatal;
        tui_managed.raw = 1;
        if (tr_consume(path, &token, why, sizeof why) != 0) goto fatal;
        tui_managed.phase = 2; rc = tui_managed_send("ACK", 0);
    } else if (!zs_cmp(op, "FREEZE") && tui_managed.phase == 3 && !st->busy &&
               tui_owned_id(hid->s, 0) && (size_t)zs_len(hid->s) <= 64 && (size_t)zs_len(hash->s) == 64) {
        for (i = 0; i < 64; i++) if (!zs_chr("0123456789abcdefABCDEF", hash->s[i])) goto done;
        if (!zs_cmp(hid->s, tui_managed.handoff)) goto done;
        m = mm_alloc(sizeof *m); if (!m) goto done;
        zs_mcpy(m, st->owned, sizeof *m);
        tx_snprintf(m->handoff_id, sizeof m->handoff_id, "%s", hid->s);
        tx_snprintf(m->candidate_hash, sizeof m->candidate_hash, "%s", hash->s);
        tx_snprintf(path, sizeof path, "%s/handoff-%s.json", tui_managed.dir, hid->s);
        if (tui_reload_export(st, m, path, why, sizeof why) != 0) goto done;
        tx_snprintf(tui_managed.next_handoff, sizeof tui_managed.next_handoff, "%s", hid->s);
        tx_snprintf(tui_managed.next_hash, sizeof tui_managed.next_hash, "%s", hash->s);
        tui_managed.phase = 4; rc = tui_managed_send("FROZEN", 1);
    } else if (!zs_cmp(op, "RELEASE") && pending && tui_managed.phase == 4) {
        if (tr_owner_release(&st->owner_fd, why, sizeof why) != 0) {
            tui_managed.phase = 6; rc = tui_managed_send("BLOCKED", 1);
        } else { tui_managed.phase = 5; rc = tui_managed_send("RELEASED", 1); }
    } else if (!zs_cmp(op, "RETIRE") && pending && tui_managed.phase == 5) {
        tui_managed.retired = 1; st->quit = 1; rc = 0;
    } else if (!zs_cmp(op, "RESUME") && pending && (tui_managed.phase == 4 || tui_managed.phase == 5)) {
        /* Trusted host must terminate+wait candidate before sending RESUME. */
        if (st->owner_fd < 0) {
            tx_snprintf(lock, sizeof lock, "%s/owner.lock", tui_managed.dir);
            if (tr_owner_acquire(lock, &st->owner_fd, why, sizeof why) != 0) goto done;
        }
        if (term_raw_enter() != 0) goto fatal;
        tui_managed.raw = 1; rc = tui_managed_send("RESUMED", 1);
        if (!rc) { tui_managed.phase = 3; tui_managed.next_handoff[0] = 0; tui_managed.next_hash[0] = 0; tui_repaint = 1; }
    }
    goto done;
fatal:
    st->quit = 1;
done:
    mm_free(m); if (root) jfree(root);
    if (rc != 0 && !st->quit && tui_managed_send("REJECT", 0) != 0) st->quit = 1;
    return rc;
}

static void tui_managed_poll(tui_state *st) {
    char c; int n;
    while (!st->quit) {
        n = (int)sy_read(tui_managed.fd, &c, 1);   /* non-blocking; resumes after EINTR */
        if (n == 0) { st->quit = 1; break; }
        if (n < 0) {
            if (n != -EAGAIN && n != -EWOULDBLOCK) st->quit = 1;
            break;
        }
        if (!c || tui_managed.used >= (int)sizeof tui_managed.frame - 1) { st->quit = 1; break; }
        if (c == '\n') {
            tui_managed.frame[tui_managed.used] = 0;
            tui_managed_message(st); tui_managed.used = 0;
        } else tui_managed.frame[tui_managed.used++] = c;
    }
}

/* Write one audit line for a message lifecycle transition. Only does work when
 * the owned state, transcript and owner fd are all valid. The record carries
 * exactly the three keys the mailbox expects — never role/text, and never any
 * notice body. Returns 1 when the line was appended, 0 otherwise. */
static int tui_mail_meta(tui_state *st, const char *id, const char *result, const char *reason) {
    char record[4096];
    if (!st || !st->owned || !st->transcript[0] || st->owner_fd < 0) return 0;
    if (!id || !result || !reason) return 0;
    if (json_rec(record, sizeof record,
                 "mail_id", id,
                 "result", result,
                 "reason", reason) == 0) return 0;
    if (session_append(st->transcript, record) != 0) return 0;
    return 1;
}

/* Close out the in-flight message. The audit line is written first; if that
 * fails the started state is left in place and the message is marked blocked,
 * with no finish() attempted. When the audit line lands, finish() moves
 * started->done; a non-zero rc also blocks and keeps the id so nothing is
 * replayed automatically. Task success is never claimed here — that is decided
 * by the caller's result. Either way mail_active clears and the id is dropped;
 * a blocked flag persists. */
static void tui_mail_complete(tui_state *st, const char *result, const char *reason) {
    char why[256];
    int rc;
    if (!st || !st->mail_active || !st->mail_id[0]) return;
    why[0] = 0;
    if (!tui_mail_meta(st, st->mail_id, result, reason)) {
        st->mail_blocked = 1;
        tui_log_plain(st, "result not recorded, started kept");
        st->mail_active = 0;
        st->mail_id[0] = 0;
        return;
    }
    rc = csih_message_finish(st->owned_dir, st->owned->session_id,
                             st->mail_id, why, sizeof why);
    if (rc != 0) {
        char note[4200];
        st->mail_blocked = 1;
        tx_snprintf(note, sizeof note,
                 "finish rc=%d why=%s (not replayed automatically)", rc, why);
        tui_log_plain(st, note);
    } else {
        tui_log_plain(st, "message done");
    }
    st->mail_active = 0;
    st->mail_id[0] = 0;
}

/* Poll the private ACTIVE mailbox once. Only the unique ACTIVE owner (phase 3,
 * owned session, valid owner fd) may run this; it is a no-op otherwise. The job
 * of this helper is to hand a taken message into the normal prompt path — it
 * never invents a second execution path, and never ACKs a notice. Every return
 * frees the heap message. Throttled by mail_next_ms so a ready pole returns
 * soon without busy-spinning. */
static void tui_mail_poll(tui_state *st, int tasks_allowed) {
    char inbox[4096], why[256];
    sy_stat_t sb;
    csih_message *m;
    long now;
    int rc;
    if (!st || tui_managed.phase != 3) return;
    if (!st->owned || st->owner_fd < 0 || !st->owned_dir[0]) return;
    now = clock_now_ms();
    if (now < 0) return;
    if (st->mail_next_ms && now < st->mail_next_ms) return;
    st->mail_next_ms = now + 250;
    if (tx_snprintf(inbox, sizeof inbox, "%s/inbox", st->owned_dir) >= (int)sizeof inbox) return;
    {
        int lr = sy_lstat(inbox, &sb);
        if (lr != 0) {
        if (lr != -ENOENT) {
            const char *e = "mailbox unavailable";
            if (zs_cmp(st->mail_error, e)) { tx_snprintf(st->mail_error, sizeof st->mail_error, "%s", e); tui_log_plain(st, e); }
        }
        return;
        }
    }
    m = mm_alloc(sizeof *m);
    if (!m) return;
    if (st->busy || st->npending > 0 || st->mail_active || st->mail_blocked) tasks_allowed = 0;
    tasks_allowed = !!tasks_allowed;
    why[0] = 0;
    rc = csih_message_take(st->owned_dir, st->owned->session_id, tasks_allowed, m, why, sizeof why);
    if (rc == 0) { mm_free(m); return; }
    if (rc < 0) {
        char note[512];
        tx_snprintf(note, sizeof note, "take rc=%d why=%s", rc, why);
        if (zs_cmp(st->mail_error, note)) { tx_snprintf(st->mail_error, sizeof st->mail_error, "%s", note); tui_log_plain(st, note); }
        if (rc == -2) st->mail_blocked = 1;
        mm_free(m);
        return;
    }
    if (rc == 1) {
        /* A held task only runs when nothing else occupies the actor. */
        if (!tasks_allowed) {
            tui_log_plain(st, "task held: actor busy");
            st->mail_blocked = 1;
            mm_free(m);
            return;
        }
        tx_snprintf(st->mail_id, sizeof st->mail_id, "%s", m->id);
        st->mail_active = 1;
        if (!tui_mail_meta(st, st->mail_id, "started", "accepted")) {
            /* No audit line: leave started unconsumed and do not execute. */
            tui_log_plain(st, "task not run: audit line failed");
            st->mail_blocked = 1;
            st->mail_active = 0;
            st->mail_id[0] = 0;
            mm_free(m);
            return;
        }
        if (tui_run_prompt(st, m->body, 0) != 0)
            tui_mail_complete(st, "failed", "begin failed");
        mm_free(m);
        return;
    }
    if (rc == 2) {
        /* A notice is shown, never ACKed, never fed to the model. */
        tui_log_plain(st, m->body);
        why[0] = 0;
        if (csih_message_finish(st->owned_dir, st->owned->session_id, m->id, why, sizeof why) != 0) {
            char note[512];
            st->mail_blocked = 1;
            tx_snprintf(note, sizeof note, "notice finish failed: %s", why);
            tui_log_plain(st, note);
        }
        mm_free(m);
        return;
    }
    mm_free(m);
}

/* The product version: the one source; tools/csih-ape.cx reads it from here for csih.com. */
#define CSIH_VERSION "0.1.1"

/* 1 for -v, --version and version */
static int tui_version_flag(const char *s) {
    static const char *const names[3] = { "-v", "--version", "version" };
    int k, i;
    for (k = 0; k < 3; k++) {
        for (i = 0; names[k][i] && s[i] == names[k][i]; i++) {}
        if (!names[k][i] && !s[i]) return 1;
    }
    return 0;
}

int tui_entry(int argc, char **argv) {
    /* no argument starts the agent, as csih.sh does (so csih.com behaves the same) */
    const char *cmd = argc > 1 ? argv[1] : "agent";

    if (tui_version_flag(cmd)) {
        sy_printf("csih %s\n", CSIH_VERSION);
        return 0;
    }

    if (!zs_cmp(cmd, "keyprobe")) {
        int len = 0, src = net_deepseek_key_probe(&len);
        if (!src) { sy_printf("deepseek key: missing (DEEPSEEK_API_KEY or ~/env.jsonl deepseek.api_key|key)\n"); return 1; }
        sy_printf("deepseek key: found len=%d source=%s\n", len, src == 1 ? "env" : "file");
        return 0;
    }

    if (!zs_cmp(cmd, "selftest")) {
        /* Driven by an injected key sequence, so this runs with no terminal. */
        static tui_state st;
        r_frame prev, next;
        char out[4096];
        int failures = 0, cols = 40;
        {
            static tui_state h, before;
            static const char *help_names[10] = {
                "/help", "/status", "/clear", "/goal", "/loop", "/reload",
                "/reload-code", "/export-state", "/exit", "/quit"
            };
            char journal[4096], bytes[64];
            const char *audit = "audit unchanged\n";
            fio_t *f;
            int i, j, found, n, bad = 0;
            tx_snprintf(journal, sizeof journal, "%s/csih-command-selftest-%ld.jsonl", tui_selftest_tmp(), (long)sy_pid());
            f = tui_fopen(journal, "wb");
            if (!f) bad = 1;
            else {
                if (fio_write(audit, 1, (size_t)zs_len(audit), f) != (size_t)zs_len(audit)) bad = 1;
                if (fio_close(f) != 0) bad = 1;
            }
            tui_state_init(&h, journal); h.mode = 1;
            tui_history_add(&h, "old history");
            tx_snprintf(h.history_draft, sizeof h.history_draft, "old draft");
            h.history_browsing = 1; h.history_pos = 0;
            tx_snprintf(h.goal, sizeof h.goal, "keep goal"); h.loop_on = 1; h.loop_left = 3;
