            if (g.busy || g.goal[0] || tui_frame_has(&g, "goal>")) {
                sy_printf("FAIL bare /goal\n"); failures++;
            } else sy_printf("  ok   /goal omits the empty goal line\n");
            tui_type(&g, "/loop");
            if (g.busy || g.loop_on) {
                sy_printf("FAIL /loop without a goal\n"); failures++;
            } else sy_printf("  ok   /loop without goal stays off\n");
            tui_type(&g, "/goal keep-going");
            if (g.busy || zs_cmp(g.goal, "keep-going") != 0 || tui_frame_has(&g, "goal>")) {
                sy_printf("FAIL /goal text\n"); failures++;
            } else sy_printf("  ok   /goal sets keep-going\n");
            tui_type(&g, "/loop");
            if (g.busy || !g.loop_on || !tui_frame_has(&g, "loop> on")
                || g.npending != 1 || !zs_find(g.pending[0], "keep-going")) {
                sy_printf("FAIL /loop on\n"); failures++;
            } else sy_printf("  ok   /loop on queues the goal\n");
            tui_type(&g, "/loop extra");
            if (g.busy || g.loop_on || g.npending != 0) {
                sy_printf("FAIL /loop off\n"); failures++;
            } else sy_printf("  ok   /loop off drops the queue\n");
            before = g.npending;
            agent_turn_seal(1, 1, 1, 0, 0, "done");
            tui_turn_done(&g);
            if (g.npending != before) {
                sy_printf("FAIL loop off still submitted\n"); failures++;
            } else sy_printf("  ok   loop off does not submit\n");
            tui_type(&g, "/loop");
            if (!g.loop_on) { sy_printf("FAIL /loop did not rearm\n"); failures++; }
            for (;;) {
                before = g.npending;
                agent_turn_seal(1, 1, 1, 0, 0, "done");
                tui_turn_done(&g);
                if (g.npending == before + 1 && zs_find(g.pending[g.npending - 1], g.goal))
                    posts++;
                else break;
            }
            before = g.npending;
            agent_turn_seal(1, 1, 1, 0, 0, "done");
            tui_turn_done(&g);
            if (posts < 2 || g.npending != before) {
                sy_printf("FAIL loop posts %d pending %d\n", posts, g.npending); failures++;
            } else sy_printf("  ok   loop posts %d\n", posts);
            for (i = 0; i < g.nlog; i++)
                if (!zs_ncmp(g.log[i], "you>", 4)) you++;
            if (you != 0 || g.busy) {
                sy_printf("FAIL slash entered a model turn\n"); failures++;
            } else sy_printf("  ok   slash did not start a model turn\n");
            tui_type(&g, "/goal ");
            before = g.npending;
            agent_turn_seal(1, 1, 1, 0, 0, "done");
            tui_turn_done(&g);
            if (g.goal[0] || g.loop_on || g.npending != before) {
                sy_printf("FAIL empty /goal left the loop armed\n"); failures++;
            } else sy_printf("  ok   empty /goal disarms loop\n");
            tui_type(&g, "/goal keep-going");
            agent_turn_seal(1, 1, 1, 0, 0, "done");
            tui_turn_done(&g);
            if (g.loop_on || g.npending != before) {
                sy_printf("FAIL new goal resumed the loop\n"); failures++;
            } else sy_printf("  ok   new goal stays idle until /loop\n");
            {
                int nlog, fold, keep;
                tui_log_plain(&g, "keep-me");
                keep = g.nlog - 1;
                g.npending = 1;
                tx_snprintf(g.pending[0], TUI_INPUT_MAX, "%s", "queued");
                g.loop_on = 1;
                g.ex_open[keep] = 1;
                nlog = g.nlog;
                fold = g.ex_open[keep];
                g.busy = 1;
                tui_type(&g, "/reload");
                if (g.quit || !g.busy || g.input[0] || g.nlog != nlog + 1
                    || zs_cmp(g.log[keep], "keep-me")
                    || !tui_frame_has(&g, "reload: 请求中，没重载")
                    || g.npending != 1 || zs_cmp(g.pending[0], "queued")
                    || zs_cmp(g.goal, "keep-going") || !g.loop_on
                    || g.ex_open[keep] != fold) {
                    sy_printf("FAIL busy /reload\n"); failures++;
                } else sy_printf("  ok   busy /reload stays in process\n");
                g.busy = 0;
                nlog = g.nlog;
                tui_type(&g, "/reload");
                if (g.quit || g.busy || g.input[0] || g.nlog != nlog + 1
                    || zs_cmp(g.log[keep], "keep-me")
                    || !tui_frame_has(&g, "reload: 页每帧已重读，密钥缓存已清")
                    || zs_cmp(g.goal, "keep-going") || g.npending != 1) {
                    sy_printf("FAIL idle /reload\n"); failures++;
                } else sy_printf("  ok   idle /reload clears the key cache\n");
            }
            {
                static tui_state tall;
                r_frame fit;
                int k;
                tui_state_init(&tall, NULL);
                tall.mode = 1;
                tall.rows = 24;
                for (k = 0; k < 40; k++) tui_log_line(&tall, "log-line");
                fit = tui_render_state(&tall, 40);
                if (fit.n > tall.rows) {
                    sy_printf("FAIL agent frame %d rows over %d\n", fit.n, tall.rows); failures++;
                } else sy_printf("  ok   agent frame fits %d\n", fit.n);
            }
            {
                static tui_state wide;
                r_frame fr;
                int k, goal_at = -1;
                tui_state_init(&wide, NULL);
                wide.mode = 1;
                wide.rows = 27;
                tx_snprintf(wide.goal, sizeof wide.goal, "g");
                wide.loop_on = 1;
                tui_log_line(&wide, "only-one");
                fr = tui_render_state(&wide, 40);
                for (k = 0; k < fr.n; k++)
                    if (!zs_ncmp(fr.lines[k], "goal>", 5)) { goal_at = k; break; }
                if (goal_at != 2 || !zs_find(fr.lines[1], "only-one")
                    || zs_ncmp(fr.lines[0], "csih · agent", 13) != 0
                    || fr.n > wide.rows || tui_frame_bad_width(&fr, 40)) {
                    sy_printf("FAIL log view want %d got goal at %d\n",
                           1 + TUI_LOG_VIEW, goal_at);
                    failures++;
                } else sy_printf("  ok   log view is %d\n", TUI_LOG_VIEW);
                {
                    int h, saw = 0;
                    char hist[16];
                    for (h = 0; h < 40; h++) {
                        tx_snprintf(hist, sizeof hist, "hist-%02d", h);
                        tui_log_line(&wide, hist);
                    }
                    fr = tui_render_state(&wide, 40);
                    if (tui_log_y0 < 2 || tui_log_y1 <= tui_log_y0
                        || tui_frame_has(&wide, "hist-00")
                        || !tui_frame_has(&wide, "hist-39")
                        || tui_frame_bad_width(&fr, 40)) {
                        sy_printf("FAIL log tail hist y %d..%d\n", tui_log_y0, tui_log_y1);
                        failures++;
                    } else {
                        tui_wheel(&wide, tui_log_y0, 2);
                        fr = tui_render_state(&wide, 40);
                        if (wide.log_skip != 3 || !tui_frame_has(&wide, "hist-17")
                            || tui_frame_has(&wide, "hist-39")
                            || !tui_frame_has(&wide, "更早3")
                            || tui_frame_bad_width(&fr, 40)) {
                            sy_printf("FAIL log wheel skip %d\n", wide.log_skip);
                            failures++;
                        } else {
                            tui_log_line(&wide, "hist-new");
                            if (wide.log_skip != 4 || tui_frame_has(&wide, "hist-new")
                                || !tui_frame_has(&wide, "hist-17")) {
                                sy_printf("FAIL log hold skip %d\n", wide.log_skip);
                                failures++;
                            } else {
                                tui_wheel(&wide, 1, 2);
                                tui_apply_key(&wide, TERM_KEY_END, 0);
                                fr = tui_render_state(&wide, 80);
                                saw = 0;
                                for (k = 0; k < fr.n; k++)
                                    if (zs_find(fr.lines[k], "Enter 发送")
                                        && !zs_find(fr.lines[k], "PgUp")) saw = 1;
                                if (wide.log_skip != 0 || !saw || !tui_frame_has(&wide, "hist-new")
                                    || tui_frame_bad_width(&fr, 80)) {
                                    sy_printf("FAIL log end or wide hint\n");
                                    failures++;
                                } else {
                                    tui_apply_key(&wide, TERM_KEY_PGUP, 0);
                                    tui_apply_key(&wide, TERM_KEY_HOME, 0);
                                    if (wide.log_skip != 20 || !tui_frame_has(&wide, "hist-01")
                                        || tui_frame_has(&wide, "hist-new")) {
                                        sy_printf("FAIL log home skip %d\n", wide.log_skip);
                                        failures++;
                                    } else {
                                        tui_apply_key(&wide, TERM_KEY_PGDN, 0);
                                        if (wide.log_skip != 0) {
                                            sy_printf("FAIL log page down skip %d\n", wide.log_skip);
                                            failures++;
                                        } else sy_printf("  ok   log wheel and keys\n");
                                    }
                                }
                            }
                        }
                    }
                }
                tui_state_init(&wide, NULL);
                wide.mode = 1;
                wide.rows = 54;
                tx_snprintf(wide.goal, sizeof wide.goal, "g");
                wide.loop_on = 1;
                fr = tui_render_state(&wide, 40);
                goal_at = -1;
                for (k = 0; k < fr.n; k++)
                    if (!zs_ncmp(fr.lines[k], "goal>", 5)) { goal_at = k; break; }
                if (goal_at < 1 || (goal_at > 1 && !fr.lines[goal_at - 1][0])) {
                    /* No blank rows should pad the empty log view; goal sits
                     * right below the header. */
                    sy_printf("FAIL empty log view goal at %d\n", goal_at);
                    failures++;
                } else sy_printf("  ok   empty log view unpadded, goal at %d\n", goal_at);
            }
            {
                static tui_state ex;
                r_frame fr;
                int k, y = 0, why = 0, cmd = 0, closed = 0;
                tui_state_init(&ex, NULL);
                ex.mode = 1;
                ex.rows = 24;
                tui_log_event(&ex, "exec\t跑一下自测\tcmd-ok");
                tui_log_event(&ex, "  │ BODYMARK-hidden");
                tui_log_event(&ex, "fold\tfile\tread\tjson.c");
                tui_log_event(&ex, "  │ FILEBODY-hidden");
                fr = tui_render_state(&ex, 40);
                for (k = 0; k < fr.n; k++) {
                    if (zs_find(fr.lines[k], "exec[展开]>")) {
                        why = 1;
                        y = k + 1;
                    }
                    if (zs_find(fr.lines[k], "BODYMARK-hidden")) cmd = 1;
                    if (zs_find(fr.lines[k], "FILEBODY-hidden")) cmd = 1;
                }
                if (!why || cmd || y < 1 || !tui_frame_has(&ex, "跑一下自测")
                    || !tui_frame_has(&ex, "cmd-ok")
                    || !tui_frame_has(&ex, "file[展开]>")
                    || !tui_frame_has(&ex, "read · json.c")) {
                    sy_printf("FAIL tool row stays closed\n"); failures++;
                } else {
                    tui_click(&ex, 1, y);
                    fr = tui_render_state(&ex, 40);
                    cmd = 0;
                    for (k = 0; k < fr.n; k++) {
                        if (zs_find(fr.lines[k], "exec[收缩]>")) closed = 1;
                        if (zs_find(fr.lines[k], "BODYMARK-hidden")) cmd = 1;
                        if (zs_find(fr.lines[k], "FILEBODY-hidden")) cmd = 1;
                    }
                    if (!closed || !cmd || tui_frame_has(&ex, "FILEBODY-hidden")) {
                        sy_printf("FAIL tool click did not expand\n");
                        failures++;
                    } else sy_printf("  ok   tool row opens on click\n");
                }
            }
            {
                static tui_state er;
                tui_state_init(&er, NULL);
                er.mode = 1;
                er.rows = 24;
                if (tui_frame_has(&er, "错误>")) {
                    sy_printf("FAIL empty error status\n"); failures++;
                }
                tui_log_event(&er, "exit=1 nfs: not responding");
                if (!tui_frame_has(&er, "错误> ") || !tui_frame_has(&er, "not responding")) {
                    sy_printf("FAIL error status did not take the nfs line\n"); failures++;
                } else sy_printf("  ok   error status keeps the nfs line\n");
            }
            {
                static tui_state mind;
                r_frame mf;
                char oldhome[512], fh[4096], fp2[4200];
                const char *home = sy_env("HOME");
                int k, in_at = -1, hint_at = -1, sysn = 0, rules = 0, head = 0, paired = 0, tee = 0, labeled = 0, bars = 0, collapsed = 0;
                fio_t *fp;
                if (home) tx_snprintf(oldhome, sizeof oldhome, "%s", home);
                else oldhome[0] = '\0';
                tx_snprintf(fh, sizeof fh, "%s/cdsh-frame-home", tui_selftest_tmp());
                tui_mkdir(fh, 0750);
                tx_snprintf(fp2, sizeof fp2, "%s/.cdsh", fh); tui_mkdir(fp2, 0750);
                tx_snprintf(fp2, sizeof fp2, "%s/.cdsh/思维树.md", fh); fp = tui_fopen(fp2, "w");
                if (fp) { fio_puts("# 思维树\n甲\n乙\n丙\n", fp); fio_close(fp); }
                tx_snprintf(fp2, sizeof fp2, "%s/.cdsh/记忆宫殿.md", fh); fp = tui_fopen(fp2, "w");
                if (fp) { fio_puts("```mermaid\nflowchart LR\n# 记忆宫殿\n子\n丑\n```\n", fp); fio_close(fp); }
                sy_setenv("HOME", fh, 1);
                tui_state_init(&mind, NULL);
                mind.mode = 1;
                mind.rows = 24;
                tui_log_line(&mind, "above");
                mf = tui_render_state(&mind, 40);
                for (k = 0; k < mf.n; k++) {
                    if (in_at < 0 && !zs_ncmp(mf.lines[k], "> ", 2)) in_at = k;
                    if (in_at >= 0 && hint_at < 0 && k > in_at
                        && zs_find(mf.lines[k], "Enter 发送")) hint_at = k;
                    {
                        const char *rs = mf.lines[k];
                        while (*rs == ' ') rs++;
                        /* A rule starts with ─, or is the labeled system edge.
                         * A tree glyph ├── is not one. */
                        if (hint_at >= 0 && head == 0 && k > hint_at
                            && zs_find(mf.lines[k], "-<系统提示词>")) {
                            rules++;
                            labeled = 1;
                            if (zs_find(mf.lines[k], "[展开]")) collapsed = 1;
                        } else if (hint_at >= 0 && head == 0 && k > hint_at
                            && (!zs_ncmp(rs, "─", 3) || zs_find(mf.lines[k], "┬")))
                            rules++;
                    }
                    /* Collapsed: the label is the whole system block. */
                    if (labeled && rules == 1 && head == 0 && k > hint_at
                        && !zs_find(mf.lines[k], "-<系统提示词>"))
                        sysn++;
                    if (sysn == 0 && collapsed && rules >= 2 && k > hint_at
                        && zs_find(mf.lines[k], "-<思维树>")
                        && zs_find(mf.lines[k], "┬")
                        && zs_find(mf.lines[k], "-<记忆宫殿>")) head = 1;
                    if (zs_find(mf.lines[k], "乙") && zs_find(mf.lines[k], "│")
                        && zs_find(mf.lines[k], "丑")) paired = 1;
                    if (zs_find(mf.lines[k], "┬")) tee = 1;
                    if (zs_find(mf.lines[k], "│")) bars++;
                }
                if (in_at < 0 || hint_at < in_at || sysn != 0 || !collapsed || rules < 2 || !head
                    || paired || !tee || bars != 0 || mf.n > mind.rows
                    || tui_frame_bad_width(&mf, 40)
                    || tui_frame_has(&mind, "```") || tui_frame_has(&mind, "flowchart LR")) {
                    sy_printf("FAIL mind drawer stays closed\n"); failures++;
                } else sy_printf("  ok   rules between hint, system, and mind\n");
                {
                    int my = 0, opened = 0, obars = 0, opaired = 0;
                    for (k = 0; k < mf.n; k++) {
                        if (zs_find(mf.lines[k], "-<思维树>") && zs_find(mf.lines[k], "[展开]"))
                            my = k + 1;
                    }
                    if (my > 0) tui_click(&mind, 1, my);
                    mf = tui_render_state(&mind, 40);
                    for (k = 0; k < mf.n; k++) {
                        if (zs_find(mf.lines[k], "-<思维树>") && zs_find(mf.lines[k], "[收缩]"))
                            opened = 1;
                        if (zs_find(mf.lines[k], "乙") && zs_find(mf.lines[k], "│")
                            && zs_find(mf.lines[k], "丑")) opaired = 1;
                        if (zs_find(mf.lines[k], "│")) obars++;
                    }
                    if (!opened || !opaired || obars != TUI_MIND_N || mf.n > mind.rows
                        || tui_frame_bad_width(&mf, 40)) {
                        sy_printf("FAIL mind drawer did not open\n"); failures++;
                    } else sy_printf("  ok   mind drawer opens\n");
                }
                {
                    int sy = 0, body = 0, phase = 0, by = 0;
                    char first[R_LINE_MAX + 1], next[R_LINE_MAX + 1];
                    mind.rows = 54;
                    mf = tui_render_state(&mind, 40);
                    for (k = 0; k < mf.n; k++) {
                        if (zs_find(mf.lines[k], "-<系统提示词>") && zs_find(mf.lines[k], "[展开]"))
                            sy = k + 1;
                    }
                    if (sy < 1) {
                        sy_printf("FAIL system rule missing\n"); failures++;
                    } else {
                        tui_click(&mind, 1, sy);
                        mf = tui_render_state(&mind, 40);
                        first[0] = '\0';
                        for (k = 0; k < mf.n; k++) {
                            if (phase == 0 && zs_find(mf.lines[k], "[收缩]")) {
                                phase = 1;
                                by = k + 2;
                            } else if (phase == 1 && zs_find(mf.lines[k], "-<思维树>")) {
                                phase = 2;
                                break;
                            } else if (phase == 1) {
                                if (body == 0) tx_snprintf(first, sizeof first, "%s", mf.lines[k]);
                                body++;
                            }
                        }
                        if (phase != 2 || body != TUI_SYS_N || mf.n > mind.rows
                            || tui_frame_bad_width(&mf, 40) || !zs_find(first, "三件")) {
                            sy_printf("FAIL system open body %d\n", body); failures++;
                        } else {
                            tui_wheel(&mind, by, 1);
                            mf = tui_render_state(&mind, 40);
                            next[0] = '\0';
                            phase = 0;
                            for (k = 0; k < mf.n; k++) {
                                if (phase == 0 && zs_find(mf.lines[k], "[收缩]")) phase = 1;
                                else if (phase == 1) {
                                    tx_snprintf(next, sizeof next, "%s", mf.lines[k]);
                                    break;
                                }
                            }
                            if (!next[0] || !zs_cmp(first, next) || tui_frame_bad_width(&mf, 40)) {
                                sy_printf("FAIL system wheel did not scroll\n"); failures++;
                            } else {
                                char stuck[R_LINE_MAX + 1], back[R_LINE_MAX + 1];
                                int w;
                                for (w = 0; w < 40; w++) tui_wheel(&mind, by, 1);
                                mf = tui_render_state(&mind, 40);
                                stuck[0] = '\0';
                                phase = 0;
                                for (k = 0; k < mf.n; k++) {
                                    if (phase == 0 && zs_find(mf.lines[k], "[收缩]")) phase = 1;
                                    else if (phase == 1) {
                                        tx_snprintf(stuck, sizeof stuck, "%s", mf.lines[k]);
                                        break;
                                    }
                                }
                                tui_wheel(&mind, by, 2);
                                mf = tui_render_state(&mind, 40);
                                back[0] = '\0';
                                phase = 0;
                                for (k = 0; k < mf.n; k++) {
                                    if (phase == 0 && zs_find(mf.lines[k], "[收缩]")) phase = 1;
                                    else if (phase == 1) {
                                        tx_snprintf(back, sizeof back, "%s", mf.lines[k]);
                                        break;
                                    }
                                }
                                if (!stuck[0] || !back[0] || !zs_cmp(stuck, back)
                                    || tui_frame_bad_width(&mf, 40)) {
                                    sy_printf("FAIL system wheel stuck past the end\n");
                                    failures++;
                                } else sy_printf("  ok   system opens ten rows and scrolls\n");
                            }
                        }
                    }
                    mind.sys_open = 0;
                    mind.sys_top = 0;
                    mind.rows = 24;
                }
                fp = tui_fopen(fp2, "w");
                if (fp) fio_close(fp);
                if (!tui_frame_has(&mind, "(空)")) {
                    sy_printf("FAIL empty palace page\n"); failures++;
                } else sy_printf("  ok   empty palace shows (空)\n");
                /* the guard refuses everything while $HOME is the fixture under the temp root (the temp root is then an
                   ancestor of $HOME): the real HOME is back for the removal only */
                if (oldhome[0]) sy_setenv("HOME", oldhome, 1); else sy_unsetenv("HOME");
                if (tui_selftest_rm(fp2, 0)) failures++;
                sy_setenv("HOME", fh, 1);
                if (!tui_frame_has(&mind, "(无)")) {
                    sy_printf("FAIL missing palace page\n"); failures++;
                } else sy_printf("  ok   missing palace shows (无)\n");
                if (oldhome[0]) sy_setenv("HOME", oldhome, 1);
                else sy_unsetenv("HOME");
            }
        }

        /* Mode 0 Enter is the CLI hand. The same line through tool_run (what
         * tools_cli run prints) must be the line the frame shows. No socket. */
        {
            static tui_state hand;
            tool_result via_cli;
            char line[1024];
            size_t i;
            char path[4096], cmd[4200];
            tx_snprintf(path, sizeof path, "%s/cdsh-tui-cli.txt", tui_selftest_tmp());
            tui_state_init(&hand, NULL);
            tui_type(&hand, "sh echo cdsh-hand");
            via_cli = tool_run("sh echo cdsh-hand");
            i = 0;
            while (via_cli.out[i] && via_cli.out[i] != '\n' && i + 1 < sizeof line) {
                line[i] = via_cli.out[i];
                i++;
            }
            line[i] = '\0';
            if (hand.mode != 0 || hand.busy || hand.input[0] || !via_cli.ok
                || zs_cmp(hand.output, "cdsh-hand") != 0
                || zs_cmp(hand.output, line) != 0
                || !hand.notice
                || zs_cmp(hand.notice, "ran (output continues; see 'read')") != 0
                || !tui_frame_has(&hand, "cdsh-hand")
                || !tui_frame_has(&hand, "ran (output continues")) {
                sy_printf("FAIL cli echo did not land on the tui frame\n");
                failures++;
            } else sy_printf("  ok   cli echo matches tui frame\n");
            tx_snprintf(cmd, sizeof cmd, "write %s from-cli", path); tui_type(&hand, cmd);
            tx_snprintf(cmd, sizeof cmd, "read %s", path); tui_type(&hand, cmd);
            via_cli = tool_run(cmd);
            i = 0;
            while (via_cli.out[i] && via_cli.out[i] != '\n' && i + 1 < sizeof line) {
                line[i] = via_cli.out[i];
                i++;
            }
            line[i] = '\0';
            if (!via_cli.ok || zs_cmp(hand.output, "from-cli") != 0
                || zs_cmp(hand.output, line) != 0
                || !tui_frame_has(&hand, "from-cli")) {
                sy_printf("FAIL cli read did not land on the tui frame\n");
                failures++;
            } else sy_printf("  ok   cli read matches tui frame\n");
            if (tui_selftest_rm(path, 0)) failures++;
        }
        {
            agent_result rr;
            char row[360];
            zs_mset(&rr, 0, sizeof rr);
            rr.acceptance = AGENT_ACCEPT_UNVERIFIED;
            tx_snprintf(rr.reason, sizeof rr.reason, "unfinished: no claims");
            tui_result_row(row, sizeof row, &rr);
            if (zs_cmp(row, "◐ 做完未验证: no claims")) { sy_printf("FAIL unverified row: %s\n", row); failures++; }
            else sy_printf("  ok   unverified row uses ◐\n");
