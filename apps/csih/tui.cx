            for (s = "/re"; *s; s++) tui_apply_key(&th, TERM_KEY_CHAR, *s);
            tui_apply_key(&th, TERM_KEY_CHAR, '\t');
            ok = ok && !zs_cmp(th.input, "/re") && zs_find(th.log[th.nlog - 1], "/retry") && zs_find(th.log[th.nlog - 1], "/reload");
            tui_apply_key(&th, TERM_KEY_CHAR, 0x15);
