            ok = !zs_cmp(th.input, "git log -3");
            tui_apply_key(&th, TERM_KEY_CHAR, 0x12);
            ok = ok && !zs_cmp(th.input, "git status");
            tui_apply_key(&th, TERM_KEY_CHAR, 0x12);
            ok = ok && !zs_cmp(th.input, "git status") && th.notice && zs_find(th.notice, "没有更早");
            tui_apply_key(&th, TERM_KEY_CHAR, 'x');
            ok = ok && th.rsearch_at == 0 && !zs_cmp(th.input, "git statusx");
            tui_apply_key(&th, TERM_KEY_CHAR, 0x15);
            for (s = "zzz"; *s; s++) tui_apply_key(&th, TERM_KEY_CHAR, *s);
            tui_apply_key(&th, TERM_KEY_CHAR, 0x12);
            ok = ok && !zs_cmp(th.input, "zzz") && th.notice && zs_find(th.notice, "没有匹配");
            if (!ok) { sy_printf("FAIL ctrl-r [%s]\n", th.input); failures++; }
