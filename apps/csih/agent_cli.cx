#pragma unisa use fio
#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use sys.io
#pragma unisa use zstr
#pragma unisa use mem.heap
#pragma unisa use mem.bytes
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use agent
#pragma unisa use os_safedel
/*
 * agent_cli.cx — program root for agent (was agent_cli.c).
 */

/*
 * agent_cli.c — the `main` for agent.c.
 *
 * Same rule as every other module: unisacc runs a source as a program, a
 * program has one `main`, so agent.c (a library) cannot carry it. The CLI also
 * owns all stdio — agent.c never prints. After a run it reads the transcript
 * back and prints a compact trace, because the transcript is the single source
 * of truth for what the agent did.
 *
 * CLI takes SUBCOMMANDS, not dash-options (unisacc reserves the dashes).
 *
 * Usage:
 *   agent_cli selftest
 *   agent_cli agent <prompt...>        (runs the full loop against the endpoint)
 *
 * Env overrides (so the same binary drives a stub or the real proxy):
 *   CSIH_ENDPOINT   default https://api.deepseek.com/v1/chat/completions
 *   CSIH_MODEL      default deepseek-chat
 *   CSIH_CWD        working dir for tools + the two working files (default ".")
 *   CSIH_TRANSCRIPT transcript path (default $HOME/.cdsh/cwd/<cwd, / as %>/tui.jsonl)
 *   The old CDSH_* names still work when the CSIH_* one is unset.
 */


typedef enum {
    ACT_ERR = 0, ACT_EXEC, ACT_READ, ACT_WRITE, ACT_EDIT,
    ACT_ANSWER, ACT_GO_CONTINUE, ACT_GO_STOP, ACT_MIND
} agent_kind;

enum { AGENT_OUTCOME_NONE=0, AGENT_OUTCOME_COMPLETED, AGENT_OUTCOME_PARTIAL,
       AGENT_OUTCOME_FAILED, AGENT_OUTCOME_UNVERIFIED };
typedef struct {
    int   kind;
    int   outcome;
    int   claims_present;
    int   acceptance, scope, evidence_count;
    char  evidence[16][96];
    char  judgment_reason[320];
    char  cmd[4096];
    char  why[160];
    char  op[64];
    char  path[1024];
    char  text[4096];
    char  old[4096];
    char  nw[4096];
    int   line;
    int   nlines;
    int evidence_read;
    int offset_set, max_bytes;
    long byte_offset;
} agent_step;

typedef struct {
    int ok, stopped, rounds, actions, err, outcome, acceptance, scope;
    char answer[4096];
    char reason[320];
    char last[320];
} agent_result;

agent_step agent_parse(const char *content);
int agent_user_forbids_tools(const char *prompt);
int agent_take_prose(agent_step *s, const char *content, int no_tools);
int  agent_exec(const agent_step *s, const char *cwd, char *out, size_t outlen);
int  agent_note_cd(char *cwd, size_t cwdlen, const char *cmd, char *out, size_t outlen);
int  agent_object_count(const char *s);
int  agent_tool_record(char *rec, size_t recsz, const char *name, const char *text);
int  agent_event_pack(const char *prefix, const char *text, char rows[][200], int cap);
int  agent_chat_role(const char *role, char *out, size_t outlen, int *wrap);
const char *agent_model_rules(void);
void agent_set_spill(int on);
int agent_may_stop(int judge, int maxn);
int agent_may_stop_ans(int judge, int maxn, int answered);
int agent_mentions_window(const char *s);
void agent_role_test(const char *role, const char *peer);
int agent_peer_blocked(int kind, const char *op, const char *cmd, char *why, int n);
int agent_sandbox_available(void);
int agent_undo_depth(void);
size_t agent_project_notes(char *out, size_t cap);
int agent_transient_http(int ok, int err, int status);
int agent_undo_last(char *note, size_t cap);
void agent_undo_exec(const char *cmd, const char *cwd);
void agent_set_perm(int p);
void agent_set_net(int on);
typedef struct {
    int ok, err, exited, status, signal, timed_out;
    long bytes;
    char out[65536];
} shell_result;
void agent_watch_result(const char *cmd, const shell_result *r);
void agent_watch_note(const char *cmd);
int agent_watch_needs_mail(void);
int agent_delivery_require_next(int required);
int agent_transcript_path(char *out, size_t outlen);
int agent_ctx_start(int count, int max_recs, const int *costs, int budget);
int agent_journal_trim(const char *path, long max_bytes, int keep);
int agent_ctx_preview(const char *transcript, char *out, size_t outlen);
agent_result agent_run(const char *prompt, const char *transcript,
                       const char *endpoint, const char *model, const char *cwd);
agent_result agent_run_cb(const char *prompt, const char *transcript,
                          const char *endpoint, const char *model, const char *cwd,
                          const char *extra_system,
                          void (*on_event)(const char *line, void *ud), void *ud);

static void print_event(const char *line, void *ud) {
    (void)ud;
    sy_printf("%s\n", line ? line : "");
    fflush(stdout);
}

/* ── offline self-test (no network, no model) ───────────────────────────── */

static int a_failures = 0;
static void a_expect(int cond, const char *what) {
    if (!cond) { sy_printf("  FAIL %s\n", what); a_failures++; }
    else sy_printf("  ok   %s\n", what);
}

static int agent_run_selftest(void) {
    agent_step s;
    char out[8192];
    char path[256];
    int fd;

    a_failures = 0;
    sy_printf("agent selftest:\n");
    /* the envelope cases below are written with this entry point */
    sy_setenv("CSIH_ENVELOPE", "/Users/wjc/repos/moltbaby/bin/envelope", 1);

    /* parser: each shape resolves to the right kind */
    s = agent_parse("{\"act\":\"exec\",\"cmd\":\"echo hi\"}");
    a_expect(s.kind == ACT_EXEC, "parse exec");
    a_expect(!zs_cmp(s.cmd, "echo hi"), "  exec cmd");
    s = agent_parse("{\"act\":\"exec\",\"cmd\":\"echo hi\",\"why\":\"看输出\"}");
    a_expect(s.kind == ACT_EXEC && !zs_cmp(s.why, "看输出"), "parse exec why");

    /* observation_refs: optional sixth key quote (harness locates its bytes) */
    {
        static const char *head = "{\"act\":\"answer\",\"outcome\":\"completed\",\"text\":\"t\",\"evidence\":[\"1-1-1-1\"],"
            "\"claims\":[{\"id\":\"c1\",\"text\":\"x\",\"scope\":\"s\",\"state\":\"supported\",\"support\":[0],\"counter\":[],\"unknown\":\"\"}],"
            "\"observation_refs\":[";
        static const char *refs[][2] = {
            { "{\"id\":\"1-1-1-1\",\"start\":0,\"end\":0,\"layer\":\"tool_output\",\"json_pointer\":null}", "1" },
            { "{\"id\":\"1-1-1-1\",\"start\":0,\"end\":0,\"layer\":\"tool_output\",\"json_pointer\":null,\"quote\":\"exit=0\"}", "1" },
            { "{\"id\":\"1-1-1-1\",\"start\":0,\"end\":0,\"layer\":\"tool_output\",\"json_pointer\":null,\"quote\":\"\"}", "0" },
            { "{\"id\":\"1-1-1-1\",\"start\":0,\"end\":0,\"layer\":\"tool_output\",\"json_pointer\":null,\"extra\":1}", "0" },
            { "{\"id\":\"1-1-1-1\",\"start\":0,\"end\":0,\"layer\":\"tool_output\",\"quote\":\"x\"}", "0" },
            { "{\"id\":\"1-1-1-1\",\"start\":0,\"end\":0,\"layer\":\"tool_output\",\"json_pointer\":null,\"quote\":\"a\"},"
              "{\"id\":\"1-1-1-1\",\"start\":0,\"end\":0,\"layer\":\"tool_output\",\"json_pointer\":null,\"quote\":\"b\"}", "1" },
            { "{\"id\":\"1-1-1-1\",\"start\":0,\"end\":0,\"layer\":\"tool_output\",\"json_pointer\":null,\"quote\":\"a\"},"
              "{\"id\":\"1-1-1-1\",\"start\":0,\"end\":0,\"layer\":\"tool_output\",\"json_pointer\":null,\"quote\":\"a\"}", "0" },
            { "{\"id\":\"1-1-1-1\",\"start\":0,\"end\":0,\"layer\":\"tool_output\",\"json_pointer\":null},"
              "{\"id\":\"1-1-1-1\",\"start\":0,\"end\":0,\"layer\":\"tool_output\",\"json_pointer\":null}", "0" },
        };
        size_t k;
        int bad = -1;
        for (k = 0; k < sizeof refs / sizeof refs[0]; k++) {
            char doc[2048];
            tx_snprintf(doc, sizeof doc, "%s%s]}", head, refs[k][0]);
            s = agent_parse(doc);
            if (s.claims_present != (refs[k][1][0] == '1')) { bad = (int)k; break; }
        }
        if (bad >= 0) sy_printf("  case %d claims_present=%d\n", bad, s.claims_present);
        a_expect(bad < 0, "observation_refs accept optional quote; reject empty/unknown keys and duplicates");
    }

    s = agent_parse("{\"act\":\"file\",\"op\":\"read\",\"path\":\"/x\"}");
    a_expect(s.kind == ACT_READ, "parse file read");

    s = agent_parse("{\"act\":\"file\",\"op\":\"write\",\"path\":\"/x\",\"text\":\"hi\"}");
    a_expect(s.kind == ACT_WRITE, "parse file write");

    s = agent_parse("{\"act\":\"answer\",\"text\":\"done\"}");
    a_expect(s.kind == ACT_ANSWER && s.outcome == AGENT_OUTCOME_UNVERIFIED, "legacy answer unverified");
    s = agent_parse("{\"act\":\"answer\",\"outcome\":\"partial\",\"text\":\"artifact exists\"}");
    a_expect(s.kind == ACT_ANSWER && s.outcome == AGENT_OUTCOME_PARTIAL, "explicit partial answer");
    s = agent_parse("{\"act\":\"answer\",\"outcome\":\"failed\",\"outcome\":\"completed\",\"text\":\"x\"}");
    a_expect(s.kind == ACT_ERR, "duplicate outcome rejected");
    s = agent_parse("{\"act\":\"mind\",\"op\":\"add\",\"target\":\"palace\",\"text\":\"note\"}");
    a_expect(s.kind == ACT_MIND && !zs_cmp(s.path, "palace") && !zs_cmp(s.op, "add"), "parse mind target");
    s = agent_parse("{\"act\":\"mind\",\"op\":\"read\",\"which\":\"tree\"}");
    a_expect(s.kind == ACT_MIND && !zs_cmp(s.path, "tree"), "parse mind which");

    s = agent_parse("{\"go\":\"stop\"}");
    a_expect(s.kind == ACT_GO_STOP, "parse go:stop");

    s = agent_parse("{\"go\":\"continue\"}");
    a_expect(s.kind == ACT_GO_CONTINUE, "parse go:continue");

    s = agent_parse("total nonsense");
    a_expect(s.kind == ACT_ERR, "garbage is ACT_ERR");
    a_expect(!agent_user_forbids_tools("读 json.c") && agent_user_forbids_tools("不要用工具。只回答")
             && agent_user_forbids_tools("请不用工具"),
             "不用工具 is a property of the user line");
    a_expect(!agent_take_prose(&s, "out[0]=0 即可", 0), "prose stays an error when tools are allowed");
    s = agent_parse("not json");
    a_expect(agent_take_prose(&s, "out[0]=0 即可", 1) && s.kind == ACT_ANSWER
             && zs_find(s.text, "out[0]"),
             "不用工具: prose is the answer");
    s = agent_parse("Sure.\n{\"act\":\"exec\",\"cmd\":\"pwd\"}\n{\"act\":\"exec\",\"cmd\":\"ls\"}");
    a_expect(s.kind == ACT_ERR,
             "prose plus extra objects rejected before execution");
    a_expect(agent_object_count("Sure.\n{\"act\":\"exec\",\"cmd\":\"pwd\"}\n{\"act\":\"exec\",\"cmd\":\"ls\"}") == 2,
             "two objects are counted");
    s = agent_parse("{\"act\":\"answer\",\"text\":\"use } here\"}");
    a_expect(s.kind == ACT_ANSWER && zs_cmp(s.text, "use } here") == 0,
             "a brace inside a string stays in the first object");
    a_expect(agent_object_count("{\"a\":\" } { \"} {\"b\":1}") == 2,
             "a brace inside a string is not a second object");
    {
        char big[6001], rec[8256];
        size_t i, n;
        for (i = 0; i + 2 < sizeof big; i += 3) {
            big[i] = (char)0xe6; big[i + 1] = (char)0x8a; big[i + 2] = (char)0x80;
        }
        big[sizeof big - 1] = 0;
        a_expect(agent_tool_record(rec, sizeof rec, "file", big) == 1, "big tool record fits");
        n = zs_len(rec);
        a_expect(n + 1 < sizeof rec && rec[n - 1] == '}' && rec[n - 2] == '"',
                 "  record is closed JSON");
        a_expect(zs_find(rec, "中间略") != NULL, "  a long tool row keeps a middle mark");
    }
    {
        char raw[4100], rec[8256];
        zs_mset(raw, 'M', sizeof raw - 1);
        zs_mcpy(raw, "HEADMARK", 8);
        zs_mcpy(raw + sizeof raw - 9, "TAILMARK", 8);
        raw[sizeof raw - 1] = 0;
        a_expect(agent_tool_record(rec, sizeof rec, "file", raw) == 1
                 && zs_find(rec, "HEADMARK") && zs_find(rec, "TAILMARK")
                 && zs_find(rec, "中间略") && zs_len(rec) < 4000,
                 "a long tool row keeps its head and its tail");
    }
    {
        char rows[12][200];
        char big[900];
        int n, i, bad = 0;
        zs_mset(big, 'A', sizeof big - 1);
        zs_mcpy(big, "HEAD\n", 5);
        zs_mcpy(big + 860, "\nTAIL", 5);
        big[sizeof big - 1] = 0;
        n = agent_event_pack("✓ answer: ", big, rows, 12);
        for (i = 0; i < n; i++) if (zs_len(rows[i]) >= 200) bad = 1;
        a_expect(n >= 3 && !bad && zs_find(rows[0], "HEAD") && zs_find(rows[n - 1], "TAIL"),
                 "a long answer is several log rows");
    }

    s = agent_parse("```json\n{\"act\":\"exec\",\"cmd\":\"ls\"}\n```");
    a_expect(s.kind == ACT_EXEC, "fenced JSON is stripped");

    {
        char role[16];
        int wrap = 1;
        a_expect(agent_chat_role("assistant", role, sizeof role, &wrap) == 1
                 && !zs_cmp(role, "assistant") && wrap == 0,
                 "assistant role stays");
        wrap = 0;
        a_expect(agent_chat_role("tool", role, sizeof role, &wrap) == 1
                 && !zs_cmp(role, "user") && wrap == 1,
                 "tool role becomes a user turn");
        a_expect(agent_chat_role("decision", role, sizeof role, &wrap) == 1
                 && wrap == 1, "decision role is not sent raw");
    }

    {
        const char *rules = agent_model_rules();
        a_expect(rules
                 && zs_find(rules, "先理解当前请求与仍有效约束")
                 && zs_find(rules, "自主最小查证")
                 && zs_find(rules, "普通无需工具的咨询可直接单独 answer")
                 && zs_find(rules, "只有当前任务明确要求或明确授权通信")
                 && zs_find(rules, "禁止或不需要确认时，不得发送外部消息")
                 && !zs_find(rules, "0:grkwjcgmcsih")
                 && zs_find(rules, "新功能先讨论")
                 && zs_find(rules, "不得先写入")
                 && zs_find(rules, "why")
                 && zs_find(rules, "markdown-tree-dag")
                 && zs_find(rules, "mermaid-flowchart-memory-palace")
                 && zs_find(rules, "csih。")
                 && zs_find(rules, "answer之后独立验收")
                 && zs_find(rules, "stop立即停止但不自动通过")
                 && zs_find(rules, "本回合harness action_id")
                 && zs_find(rules, "不要 exec tmux"),
                 "rules: default answer, explicit communication authorization, no obsolete peer, and existing task/memory rules");
        a_expect(agent_may_stop_ans(1, 3, 1) && agent_may_stop_ans(2, 3, 1),
                 "answered: first stop ends the turn");
        a_expect(!agent_may_stop(1, 3) && !agent_may_stop(2, 3) && agent_may_stop(3, 3),
                 "stop waits for the third judgment");
        a_expect(!agent_mentions_window("c99 的 use/import 类包管理有没有人试过"),
                 "a package question is not a window");
        a_expect(agent_mentions_window("看看窗口 13") && agent_mentions_window("tmux capture-pane"),
                 "a window request keeps the list");
        a_expect(zs_find(rules, "下一窗") != NULL && zs_find(rules, "恰好一个 JSON 对象") != NULL &&
                 zs_find(rules, "等待真实结果") != NULL,
                 "rules keep one action, wait for its result, and name the next window");
    }

    {
        char *body = (char *)mm_alloc(65536);
        a_expect(body != NULL, "role communication policy preview buffer");
        if (body) {
            agent_role_test("write", "0:policy-peer");
            agent_ctx_preview("/tmp/csih-role-policy-missing.jsonl", body, 65536);
            a_expect(zs_find(body, "cwd 不是文件系统隔离") != NULL &&
                     zs_find(body, "所有测试临时输出都必须留在该目录内") != NULL &&
                     zs_find(body, "不要使用全局固定 /tmp 文件") != NULL &&
                     zs_find(body, "已有越界必须如实报告，不能因后续修复隐去") != NULL &&
                     zs_find(body, "不能把未核实的范围宣称已验证") != NULL,
                     "actual model request describes task-local temporary files and honest side effects without claiming isolation");
            a_expect(zs_find(body, "写手。同伴 0:policy-peer") != NULL &&
                     zs_find(body, "先最小查证、执行和验收") != NULL &&
                     zs_find(body, "禁止或不需要确认时不得发送") != NULL &&
                     zs_find(body, "做完执行") == NULL,
                     "writer has actual peer and no automatic external confirmation obligation");
            agent_role_test("watch", "0:policy-peer");
            agent_ctx_preview("/tmp/csih-role-policy-missing.jsonl", body, 65536);
            a_expect(zs_find(body, "看客。同伴 0:policy-peer") != NULL &&
                     zs_find(body, "可用 file read 与 mind read 查证") != NULL &&
                     zs_find(body, "只有当前任务明确要求或明确授权通信时才发送") != NULL &&
                     zs_find(body, "真实成功回执") != NULL && agent_watch_needs_mail() == 1,
                     "watch authorization guidance preserves the real delivery gate");
        }
        mm_free(body);
        agent_role_test(NULL, NULL);
    }

    {
        char why[160];
        agent_role_test("watch", "0:csih-tui");
        a_expect(agent_peer_blocked(ACT_EDIT, "edit", "", why, (int)sizeof why) == 1,
                 "watch does not edit");
        a_expect(agent_peer_blocked(ACT_READ, "read", "", why, (int)sizeof why) == 0,
                 "watch may read");
        a_expect(agent_peer_blocked(ACT_MIND, "add", "", why, (int)sizeof why) == 1
                 && agent_peer_blocked(ACT_MIND, "read", "", why, (int)sizeof why) == 0,
                 "watch mind is read only");
        a_expect(agent_peer_blocked(ACT_EXEC, "",
                 "tmux capture-pane -p -t 0:csih-tui", why, (int)sizeof why) == 0,
                 "watch may capture the peer");
        a_expect(agent_peer_blocked(ACT_EXEC, "",
                 "/Users/wjc/repos/moltbaby/bin/envelope 0:csih-tui 一件 看不懂",
                 why, (int)sizeof why) == 0,
                 "watch may envelope the peer");
        a_expect(agent_peer_blocked(ACT_EXEC, "",
                 "tmux respawn-pane -k -t 0:csih-tui", why, (int)sizeof why) == 1,
                 "watch does not respawn");
        agent_role_test("write", "0:csih-tui2");
        a_expect(agent_peer_blocked(ACT_EDIT, "edit", "", why, (int)sizeof why) == 0,
                 "write may edit");
        agent_role_test("watch", "0:csih-tui");
        a_expect(agent_watch_needs_mail() == 1, "watch receipt tracker is not a task obligation");
        agent_watch_note("/Users/wjc/repos/moltbaby/bin/envelope 0:csih-tui 一件 折叠没有计数");
        a_expect(agent_watch_needs_mail() == 1, "command text cannot clear mail gate");
        {
            static shell_result r;
            const char *cmd = "/Users/wjc/repos/moltbaby/bin/envelope 0:csih-tui '中文 标题' \"中文 正文\"";
            const char *bad[] = {
                "false # envelope 0:csih-tui",
                "echo 'envelope → 0:csih-tui.0: 80 chars' # envelope 0:csih-tui",
                "/Users/wjc/repos/moltbaby/bin/envelope 0:csih-tui 标题 正文; true",
                "/Users/wjc/repos/moltbaby/bin/envelope 0:csih-tui2 标题 正文",
                "/Users/wjc/repos/moltbaby/bin/envelope 0:csih-tui 标题 $(echo 正文)",
                "/Users/wjc/repos/moltbaby/bin/envelope 0:csih-tui 标题 正文 > /tmp/x"
            };
            int i;
            zs_mset(&r, 0, sizeof r); r.ok = 1; r.exited = 1;
            tx_snprintf(r.out, sizeof r.out, "envelope → 0:csih-tui.0: 80 chars [submitted✓:BUSY]\n");
            r.bytes = (long)zs_len(r.out);
            for (i = 0; i < 6; i++) {
                agent_watch_result(bad[i], &r);
                a_expect(agent_watch_needs_mail() == 1, "fake/composite/wrong-peer envelope rejected");
            }
            r.status = 3; agent_watch_result(cmd, &r);
            a_expect(agent_watch_needs_mail() == 1, "failure receipt does not clear mail gate");
            r.status = 0; r.timed_out = 1; agent_watch_result(cmd, &r);
            a_expect(agent_watch_needs_mail() == 1, "timeout does not clear mail gate");
            r.timed_out = 0; r.bytes = -1; agent_watch_result(cmd, &r);
            a_expect(agent_watch_needs_mail() == 1, "truncated receipt rejected");
            r.bytes = (long)zs_len(r.out); agent_watch_result(cmd, &r);
            a_expect(agent_watch_needs_mail() == 0, "structured success result clears mail gate (no delivery performed)");
        }
        agent_role_test("", "");
    }

    {
        s = agent_parse("{\"act\":\"file\",\"op\":\"read\",\"path\":\"a.c\",\"line\":40,\"n\":20}");
        a_expect(s.kind == ACT_READ && s.line == 40 && s.nlines == 20 && !zs_cmp(s.path, "a.c"),
                 "file read takes a line window");
    }

    {
        int costs[5] = {100, 100, 100, 100, 100};
        char jpath[512];
        a_expect(agent_ctx_start(5, 50, costs, 250) == 3,
                 "a full context drops the oldest records");
        a_expect(agent_ctx_start(5, 2, costs, 10000) == 3,
                 "context keeps at most the newest records");
        a_expect(agent_ctx_start(3, 50, costs, 50) == 3,
                 "an oversized newest record is not replaced by an older one");
        a_expect(agent_ctx_start(0, 50, costs, 100) == 0, "empty context starts at 0");
        a_expect(agent_transcript_path(jpath, sizeof jpath) == 0, "transcript path resolves");
        if (sy_env("CSIH_TRANSCRIPT") && sy_env("CSIH_TRANSCRIPT")[0])
            a_expect(zs_cmp(jpath, sy_env("CSIH_TRANSCRIPT")) == 0,
                     "transcript follows CSIH_TRANSCRIPT");
        else if (sy_env("CDSH_TRANSCRIPT") && sy_env("CDSH_TRANSCRIPT")[0])
            a_expect(zs_cmp(jpath, sy_env("CDSH_TRANSCRIPT")) == 0,
                     "transcript follows CDSH_TRANSCRIPT");
        else {
            char want[1200], here[1024];
            size_t i, n;
            /* Default: one journal per cwd, / encoded as %. */
            if (getcwd(here, sizeof here)) {
                n = (size_t)tx_snprintf(want, sizeof want, "/.cdsh/cwd/");
                for (i = 0; here[i] && n + 3 < sizeof want; i++) {
                    if (here[i] == '/') want[n++] = '%';
                    else if (here[i] == '%') { want[n++] = '%'; want[n++] = '%'; }
                    else want[n++] = here[i];
                }
                tx_snprintf(want + n, sizeof want - n, "/tui.jsonl");
                a_expect(zs_find(jpath, want) != NULL, "transcript defaults to this cwd's journal");
            }
        }
    }

    /* executor: exec really runs */
    s = agent_parse("{\"act\":\"exec\",\"cmd\":\"echo hi\"}");
    a_expect(agent_exec(&s, "/tmp", out, sizeof out) == 1, "exec runs");
    a_expect(zs_find(out, "hi") != NULL, "  exec output captured");

    /* which model-call failures are worth a retry */
    a_expect(agent_transient_http(0, -2, 0) && agent_transient_http(1, 0, 429) && agent_transient_http(1, 0, 503),
             "connection errors, 429 and 5xx are retried");
    a_expect(!agent_transient_http(0, -2004, 0) && !agent_transient_http(0, -2005, 0)
             && !agent_transient_http(1, 0, 401) && !agent_transient_http(1, 0, 400) && !agent_transient_http(1, 0, 200),
             "cancel, timeout, other 4xx and success are not");

    /* project notes: CSIH.md, else AGENTS.md, from the start directory */
    {
        char dir[128], old[1024], p[200], notes[9000];
        size_t got;
        int i, valid = 1;
        fio_t *f;
        tx_snprintf(dir, sizeof dir, "/tmp/csih-notes-%d", (int)sy_pid());
        mkdir(dir, 0700);
        if (getcwd(old, sizeof old) && chdir(dir) == 0) {
            a_expect(agent_project_notes(notes, sizeof notes) == 0, "no notes file: nothing added");
            tx_snprintf(p, sizeof p, "%s/AGENTS.md", dir);
            f = fio_open(p, "w"); if (f) { fio_puts("用 tab 缩进", f); fio_close(f); }
            got = agent_project_notes(notes, sizeof notes);
            a_expect(got > 0 && zs_find(notes, "AGENTS.md") && zs_find(notes, "用 tab 缩进") && zs_find(notes, "不是授权"),
                     "AGENTS.md is read when there is no CSIH.md");
            tx_snprintf(p, sizeof p, "%s/CSIH.md", dir);
            f = fio_open(p, "w");
            if (f) { for (i = 0; i < 3000; i++) fio_puts("中", f); fio_close(f); }   /* 9000 bytes */
            got = agent_project_notes(notes, sizeof notes);
            a_expect(got > 0 && zs_find(notes, "CSIH.md") && !zs_find(notes, "用 tab 缩进"), "CSIH.md wins over AGENTS.md");
            /* cut at 8KB on a code point: every 中 after the header is whole */
            {
                const char *b = zs_find(notes, "）：\n");
                size_t k, len;
                if (b) { b += zs_len("）：\n"); len = zs_len(b) - 1; /* trailing \n */
                    for (k = 0; k + 3 <= len; k += 3) if (mm_cmp(b + k, "中", 3)) valid = 0;
                    if (len % 3) valid = 0;
                    if (len > 8192) valid = 0;
                } else valid = 0;
            }
            a_expect(valid, "long notes are cut to 8KB on a code point boundary");
            remove(p);
            tx_snprintf(p, sizeof p, "%s/AGENTS.md", dir); remove(p);
            if (chdir(old) != 0) a_expect(0, "restore cwd");
        }
        rmdir(dir);
    }

    /* sandbox: the kernel, not a keyword list, refuses writes outside the tier */
    if (agent_sandbox_available()) {
        char dir[128], cmd[600];
        const char *home = sy_env("HOME");
        tx_snprintf(dir, sizeof dir, "/tmp/csih-sbx-%d", (int)sy_pid());
        mkdir(dir, 0700);
        agent_set_perm(0);
        zs_mset(&s, 0, sizeof s); s.kind = ACT_EXEC;
        tx_snprintf(s.cmd, sizeof s.cmd, "touch inside && echo wrote");
        agent_exec(&s, dir, out, sizeof out);
        a_expect(zs_find(out, "Read-only") != NULL && !zs_find(out, "wrote"), "read tier: kernel refuses a write in cwd");
        agent_set_perm(1);
        agent_exec(&s, dir, out, sizeof out);
        a_expect(zs_find(out, "wrote") != NULL, "work tier: cwd is writable");
        tx_snprintf(cmd, sizeof cmd, "touch '%s/.csih-sbx-probe' && echo wrote", home ? home : "/root");
        tx_snprintf(s.cmd, sizeof s.cmd, "%s", cmd);
        agent_exec(&s, dir, out, sizeof out);
        a_expect(zs_find(out, "Read-only") != NULL && !zs_find(out, "wrote"), "work tier: home outside cwd is read-only");
        /* secrets read empty, own PID space, and (read tier) no network */
        tx_snprintf(s.cmd, sizeof s.cmd, "echo env=$(cat \"$HOME/env.jsonl\" 2>/dev/null | wc -c) pids=$(ls /proc | grep -c '^[0-9]') net=$(wc -l < /proc/net/dev)");
        agent_exec(&s, dir, out, sizeof out);
        a_expect(zs_find(out, "env=0 ") != NULL, "work tier: ~/env.jsonl reads as empty");
        {
            const char *p = zs_find(out, "pids=");
            a_expect(p && (int)tx_atol(p + 5) > 0 && (int)tx_atol(p + 5) < 10, "sandbox has its own PID space");
        }
        tx_snprintf(s.cmd, sizeof s.cmd, "echo vm=$(ulimit -v) cpu=$(ulimit -t)");
        agent_exec(&s, dir, out, sizeof out);
        a_expect(zs_find(out, "vm=4194304 cpu=120") != NULL, "sandbox sets default memory and CPU quotas");
        tx_snprintf(s.cmd, sizeof s.cmd, "echo env=$(cat \"$HOME/env.jsonl\" 2>/dev/null | wc -c) pids=$(ls /proc | grep -c '^[0-9]') net=$(wc -l < /proc/net/dev)");
        agent_set_perm(0);
        agent_exec(&s, dir, out, sizeof out);
        /* /proc/net/dev: two header lines plus lo only. */
        a_expect(zs_find(out, "net=3") != NULL, "read tier: no network but loopback");
        agent_set_perm(1);
        agent_exec(&s, dir, out, sizeof out);
        a_expect(zs_find(out, "net=3") == NULL, "work tier keeps the network by default");
        agent_set_net(0);
        agent_exec(&s, dir, out, sizeof out);
        a_expect(zs_find(out, "net=3") != NULL, "/net off: work tier has loopback only");
        agent_set_net(1);
        /* user secret list: a file in cwd listed in ~/.csih/secrets reads empty */
        {
            char sec[300], list[300], had[4096];
            fio_t *lf;
            size_t hn = 0;
            tx_snprintf(sec, sizeof sec, "%s/token.txt", dir);
            lf = fio_open(sec, "w"); if (lf) { fio_puts("SECRET123", lf); fio_close(lf); }
            tx_snprintf(list, sizeof list, "%s/.csih/secrets", home ? home : "/tmp");
            lf = fio_open(list, "r");
            if (lf) { hn = fio_read(had, 1, sizeof had - 1, lf); fio_close(lf); }
            had[hn] = 0;
            lf = fio_open(list, "a");
            if (lf) {
                char tilde[300];
                fio_t *tf;
                tx_snprintf(tilde, sizeof tilde, "%s/.csih/csih-sbx-tilde-%d.txt", home ? home : "/tmp", (int)sy_pid());
                tf = fio_open(tilde, "w"); if (tf) { fio_puts("TILDE456", tf); fio_close(tf); }
                fio_printf(lf, "%s# csih selftest\n%s\n~/.csih/csih-sbx-tilde-%d.txt\n",
                        hn && had[hn - 1] != '\n' ? "\n" : "", sec, (int)sy_pid());
                fio_close(lf);
                tx_snprintf(s.cmd, sizeof s.cmd, "echo got=$(cat token.txt) tilde=$(cat \"$HOME/.csih/csih-sbx-tilde-%d.txt\")", (int)sy_pid());
                agent_exec(&s, dir, out, sizeof out);
                a_expect(zs_find(out, "got=") && !zs_find(out, "SECRET123"),
                         "a path listed in ~/.csih/secrets reads empty in the sandbox");
                a_expect(zs_find(out, "tilde=") && !zs_find(out, "TILDE456"), "  ~/ paths in the list are expanded");
                remove(tilde);
                /* put the user's list back exactly as it was */
                if (hn) { lf = fio_open(list, "w"); if (lf) { fio_write(had, 1, hn, lf); fio_close(lf); } }
                else remove(list);
            }
            remove(sec);
        }
        zs_mset(s.cmd, 'x', sizeof s.cmd - 1); s.cmd[sizeof s.cmd - 1] = 0;
        zs_mcpy(s.cmd, "echo ", 5);
        { int i; for (i = 5; i < (int)sizeof s.cmd - 1; i += 2) s.cmd[i] = '\''; }
        agent_exec(&s, dir, out, sizeof out);
        a_expect(zs_find(out, "放不进沙箱") != NULL, "a command too long for the box is refused, not run bare");
        agent_set_perm(1);
        tx_snprintf(cmd, sizeof cmd, "%s/inside", dir);
        unlink(cmd);
        rmdir(dir);
    } else sy_printf("  skip sandbox: unshare -Urm unavailable here\n");

    /* a long result stays in memory unless the CLI asked for spill */
    zs_mset(&s, 0, sizeof s); s.kind = ACT_EXEC;
    zs_ncpy(s.cmd, "dd if=/dev/zero bs=2500 count=1 2>/dev/null | tr '\\0' A", sizeof s.cmd - 1);
    agent_set_spill(0);
    a_expect(agent_exec(&s, "/tmp", out, sizeof out) == 1, "long exec runs");
    a_expect(zs_find(out, "full:") == NULL && zs_find(out, "AAAA") != NULL,
             "  long exec does not write a tool file");
    agent_set_spill(1);
    a_expect(agent_exec(&s, "/tmp", out, sizeof out) == 1, "long exec spill runs");
    a_expect(zs_find(out, "full: ") != NULL && zs_find(out, "/.csih/tool/") != NULL,
             "  long result names a tool file");
    {
        const char *p = zs_find(out, "full: ");
        char spath[640];
        fio_t *sf;
        size_t k = 0;
        if (p) p += 6;
        while (p && *p && *p != ' ' && *p != '\n' && k + 1 < sizeof spath) spath[k++] = *p++;
        spath[k] = 0;
        sf = k ? fio_open(spath, "r") : NULL;
        a_expect(sf != NULL, "  spill file exists");
        if (sf) {
            char blk[2600];
            size_t n = fio_read(blk, 1, sizeof blk, sf);
            fio_close(sf);
            a_expect(n == 2500 && blk[0] == 'A' && blk[2499] == 'A',
                     "  spill file keeps all 2500 bytes");
            remove(spath);
        }
    }
    agent_set_spill(0);

    /* executor: file write then read round-trips */
    tx_snprintf(path, sizeof path, "/tmp/csih-agent-test-%d.txt", (int)sy_pid());
    remove(path);
    s = agent_parse("{\"act\":\"file\",\"op\":\"write\",\"path\":\"PLACE\",\"text\":\"hello-world\"}");
    /* path is a fixed placeholder above; set it directly */
    zs_mset(&s, 0, sizeof s); s.kind = ACT_WRITE;
    zs_ncpy(s.path, path, sizeof s.path - 1);
    zs_ncpy(s.text, "hello-world", sizeof s.text - 1);
    a_expect(agent_exec(&s, "/tmp", out, sizeof out) == 1, "file write runs");
    a_expect(zs_find(out, "wrote") != NULL, "  write reported bytes");

    zs_mset(&s, 0, sizeof s); s.kind = ACT_READ;
    zs_ncpy(s.path, path, sizeof s.path - 1);
    a_expect(agent_exec(&s, "/tmp", out, sizeof out) == 1, "file read runs");
    a_expect(zs_find(out, "hello-world") != NULL, "  read returned the content");
    remove(path);

    {
        fio_t *lf;
        tx_snprintf(path, sizeof path, "/tmp/csih-lines-%d.txt", (int)sy_pid());
        lf = fio_open(path, "w");
        a_expect(lf != NULL, "line window fixture");
        if (lf) {
            int row;
            for (row = 1; row <= 10; row++) fio_printf(lf, "L%d\n", row);
            fio_close(lf);
        }
        zs_mset(&s, 0, sizeof s);
        s.kind = ACT_READ;
        zs_ncpy(s.path, path, sizeof s.path - 1);
        s.line = 3;
        s.nlines = 2;
        a_expect(agent_exec(&s, "/tmp", out, sizeof out) == 1, "line window reads");
        a_expect(zs_find(out, "L3") && zs_find(out, "L4") && !zs_find(out, "L2") && !zs_find(out, "L5"),
                 "  window is lines 3 and 4");
        a_expect(!zs_cmp(out, "L3\nL4\n"), "  window is exact raw text without invented coverage footer");
        remove(path);
    }

    remove(path);

    /* relative path lands in the agent cwd, not the process cwd */
    {
        char dir[64], rel[80], got[32];
        fio_t *f;
        tx_snprintf(dir, sizeof dir, "/tmp/cdsh-rel-%d", (int)sy_pid());
        tx_snprintf(rel, sizeof rel, "%s/rel.txt", dir);
        mkdir(dir, 0700);
        remove(rel);
        zs_mset(&s, 0, sizeof s); s.kind = ACT_WRITE;
        zs_ncpy(s.path, "rel.txt", sizeof s.path - 1);
        zs_ncpy(s.text, "hello", sizeof s.text - 1);
        a_expect(agent_exec(&s, dir, out, sizeof out) == 1, "relative write runs");
        f = fio_open(rel, "r");
        a_expect(f != NULL, "  relative file is under cwd");
        if (f) {
            size_t n = fio_read(got, 1, sizeof got - 1, f);
            fio_close(f);
            got[n] = 0;
            a_expect(zs_cmp(got, "hello") == 0, "  relative content");
        }
        /* undo: overwrite, then step back twice: old content, then gone */
        {
            char note[400], stale[600];
            int depth = agent_undo_depth();
            fio_t *sf;
            /* A backup from a dead process (pid 2^22-1 is never live here) is
             * swept the first time this process snapshots. */
            tx_snprintf(stale, sizeof stale, "%s/.csih/undo/4194303-1.bak", sy_env("HOME") ? sy_env("HOME") : "/tmp");
            sf = fio_open(stale, "w"); if (sf) { fio_puts("x", sf); fio_close(sf); }
            zs_ncpy(s.text, "changed", sizeof s.text - 1);
            agent_exec(&s, dir, out, sizeof out);
            a_expect(agent_undo_depth() == depth + 1, "a write records one undo step");
            a_expect(!sf || access(stale, F_OK) != 0, "a dead process's leftover backup is swept");
            a_expect(agent_undo_last(note, sizeof note) == 0, "undo restores the overwrite");
            f = fio_open(rel, "r"); got[0] = 0;
            if (f) { size_t n = fio_read(got, 1, sizeof got - 1, f); fio_close(f); got[n] = 0; }
            a_expect(zs_cmp(got, "hello") == 0, "  old content is back");
            a_expect(agent_undo_last(note, sizeof note) == 0 && access(rel, F_OK) != 0,
                     "undo of a created file removes it");
            while (agent_undo_depth() > 0) agent_undo_last(note, sizeof note);
            a_expect(agent_undo_last(note, sizeof note) == 1, "undo with nothing left says so");
        }
        /* undo after exec: the existing files the command names are snapshotted
           (quoted, once each); options, missing files and paths outside cwd are not */
        {
            char note[400], p2[300];
            fio_t *wf;
            int depth;
            tx_snprintf(p2, sizeof p2, "%s/ex.txt", dir);
            wf = fio_open(p2, "w"); if (wf) { fio_puts("before\n", wf); fio_close(wf); }
            depth = agent_undo_depth();
            agent_undo_exec("sed -i 's/before/after/' 'ex.txt' && cat ex.txt missing.txt /etc/hostname -n", dir);
            a_expect(agent_undo_depth() == depth + 1, "exec: one snapshot for the named file (not options, missing or outside)");
            wf = fio_open(p2, "w"); if (wf) { fio_puts("after\n", wf); fio_close(wf); }
            a_expect(agent_undo_last(note, sizeof note) == 0, "exec: undo restores the file the command changed");
            wf = fio_open(p2, "r"); got[0] = 0;
            if (wf) { size_t n = fio_read(got, 1, sizeof got - 1, wf); fio_close(wf); got[n] = 0; }
            a_expect(zs_cmp(got, "before\n") == 0, "  its content before the exec is back");
            remove(p2);
        }
        remove(rel);
        rmdir(dir);
    }

    /* dsh: a bare cd must stick, the next file step uses the new directory */
    {
        char base[64], inner[80], cwd[128], out2[256], got[16];
        fio_t *f;
        tx_snprintf(base, sizeof base, "/tmp/cdsh-acd-%d", (int)sy_pid());
        tx_snprintf(inner, sizeof inner, "%s/inner", base);
        mkdir(base, 0700);
        mkdir(inner, 0700);
        tx_snprintf(cwd, sizeof cwd, "%s", base);
        a_expect(agent_note_cd(cwd, sizeof cwd, "cd \"inner\"", out2, sizeof out2) == 1,
                 "cd is a persistent builtin");
        a_expect(zs_find(cwd, "/inner") != NULL, "  cwd moved into inner");
        zs_mset(&s, 0, sizeof s); s.kind = ACT_WRITE;
        zs_ncpy(s.path, "there.txt", sizeof s.path - 1);
        zs_ncpy(s.text, "in", sizeof s.text - 1);
        a_expect(agent_exec(&s, cwd, out, sizeof out) == 1, "write after cd");
        tx_snprintf(inner, sizeof inner, "%s/there.txt", cwd);
        f = fio_open(inner, "r");
        a_expect(f != NULL, "  file is in the new directory");
        if (f) { size_t n = fio_read(got, 1, sizeof got - 1, f); fio_close(f); got[n] = 0;
                 a_expect(zs_cmp(got, "in") == 0, "  content after cd"); }
        a_expect(agent_note_cd(cwd, sizeof cwd, "cd /tmp/cdsh-no-such-dir", out2, sizeof out2) == 1
                 && zs_find(cwd, "/inner") != NULL, "failed cd leaves cwd");
        zs_mset(&s, 0, sizeof s); s.kind = ACT_EXEC;
        zs_ncpy(s.cmd, "cat there.txt", sizeof s.cmd - 1);
        a_expect(agent_exec(&s, cwd, out, sizeof out) == 1, "exec reads the file just written");
        a_expect(zs_find(out, "exit=0") != NULL && zs_find(out, "in") != NULL,
                 "  exec output includes the file text");
        remove(inner);
        tx_snprintf(inner, sizeof inner, "%s", cwd);
        rmdir(inner);
        rmdir(base);
    }

    {
        const char *jp = "/tmp/csih-ctx-selftest.jsonl";
        fio_t *jf;
        char *body;
        int row, col, opened = 0;
        remove(jp);
        jf = fio_open(jp, "w");
        a_expect(jf != NULL, "context fixture opens");
        if (jf) {
            opened = 1;
            for (row = 0; row < 30; row++) {
                fio_printf(jf, "{\"role\":\"user\",\"text\":\"%s", row == 0 ? "OLDMARKER" : "pad");
                for (col = 0; col < 2500; col++) fio_putc('B', jf);
                fio_printf(jf, "%s\"}\n",
                        row == 29 ? "NEWMARKER" : (row == 1 ? "MIDONLY" : "mid"));
            }
            fio_printf(jf, "{\"role\":\"decision\",\"go\":\"stop\"}\n");
            fio_close(jf);
        }
        body = (char *)mm_alloc(65536);
        a_expect(body != NULL, "context preview buffer");
        if (body && opened) {
            agent_ctx_preview(jp, body, 65536);
            a_expect(zs_find(body, "NEWMARKER") != NULL, "context keeps the newest record");
            a_expect(zs_find(body, "OLDMARKER") != NULL, "context keeps the first user line");
            a_expect(zs_find(body, "MIDONLY") == NULL, "context drops a middle user line");
            a_expect(zs_find(body, "被省略的是较早的工具结果和助手行") != NULL,
                     "an omission is one short note");
            a_expect(zs_find(body, "decision") == NULL, "decision records stay off the wire");
        }
        mm_free(body);
        remove(jp);
    }

    {
        const char *jp = "/tmp/csih-ctx-keep-user.jsonl";
        fio_t *jf;
        char *body;
        int row, col, opened = 0;
        remove(jp);
        jf = fio_open(jp, "w");
        a_expect(jf != NULL, "user-keep fixture opens");
        if (jf) {
            opened = 1;
            fio_printf(jf, "{\"role\":\"user\",\"text\":\"OLDMARKER\"}\n");
            for (row = 0; row < 40; row++) {
                fio_printf(jf, "{\"role\":\"tool\",\"name\":\"file\",\"text\":\"%s",
                        row == 0 ? "TOOLGONE" : "toolpad");
                for (col = 0; col < 2000; col++) fio_putc('Q', jf);
                fio_printf(jf, "\"}\n");
            }
            fio_printf(jf, "{\"role\":\"user\",\"text\":\"NEWMARKER\"}\n");
            fio_close(jf);
        }
        body = (char *)mm_alloc(65536);
        if (body && opened) {
            agent_ctx_preview(jp, body, 65536);
            a_expect(zs_find(body, "OLDMARKER") != NULL, "a full context keeps the older user line");
            a_expect(zs_find(body, "NEWMARKER") != NULL, "a full context keeps the newest user line");
            a_expect(zs_find(body, "TOOLGONE") == NULL, "a full context drops an old tool row first");
            a_expect(zs_find(body, "被省略的是较早的工具结果和助手行") != NULL,
                     "a dropped tool row leaves one note");
        }
        mm_free(body);
        remove(jp);
    }

    {
        const char *jp = "/tmp/csih-journal-selftest.jsonl";
        fio_t *jf;
        char line[80];
        int row, n = 0;
        remove(jp);
        jf = fio_open(jp, "w");
        a_expect(jf != NULL, "journal fixture opens");
        if (jf) {
            for (row = 0; row < 10; row++)
                fio_printf(jf, "{\"role\":\"user\",\"text\":\"line-%d\"}\n", row);
            fio_close(jf);
        }
        a_expect(agent_journal_trim(jp, 80, 3) == 1, "a long journal keeps the newest lines");
        jf = fio_open(jp, "r");
        while (jf && fio_gets(line, sizeof line, jf)) n++;
        if (jf) fio_close(jf);
        a_expect(n == 3, "trimmed journal has the kept count");
        line[0] = 0;
        jf = fio_open(jp, "r");
        if (jf) { if (!fio_gets(line, sizeof line, jf)) line[0] = 0; fio_close(jf); }
        a_expect(zs_find(line, "line-7") != NULL, "trim starts at the oldest kept line");
        remove(jp);
    }

    if (a_failures) { sy_printf("agent: %d FAILED\n", a_failures); return 1; }
    sy_printf("agent: all cases pass\n");
    return 0;
}

/* ── the run command ────────────────────────────────────────────────────── */

static void print_trace(const char *transcript) {
    /* Read the transcript and print a compact, readable trace. Kept here (not in
     * agent.c) so the library stays stdio-free. */
    fio_t *f = fio_open(transcript, "r");
    char buf[8192];
    if (!f) return;
    sy_printf("\n--- trace (%s) ---\n", transcript);
    while (fio_gets(buf, sizeof buf, f)) {
        size_t n = zs_len(buf);
        while (n && (buf[n-1] == '\n' || buf[n-1] == '\r')) buf[--n] = '\0';
        sy_printf("%s\n", buf);
    }
    fio_close(f);
}

static const char *csih_env(const char *neu, const char *old) {
    const char *v = sy_env(neu);
    if (v && v[0]) return v;
    v = sy_env(old);
    if (v && v[0]) return v;
    return 0;
}

static int run_agent(int argc, char **argv) {
    const char *endpoint = csih_env("CSIH_ENDPOINT", "CDSH_ENDPOINT");
    const char *model    = csih_env("CSIH_MODEL", "CDSH_MODEL");
    const char *cwd      = csih_env("CSIH_CWD", "CDSH_CWD");
    char journal[512];
    const char *transcript;
    char prompt[4096];
    char real_cwd[1024];
    agent_result r;
    int i, n;
    size_t k;

    if (!endpoint) endpoint = "https://api.deepseek.com/v1/chat/completions";
    if (!model)    model = "deepseek-chat";
    if (!cwd) {
        if (!getcwd(real_cwd, sizeof real_cwd)) tx_snprintf(real_cwd, sizeof real_cwd, ".");
        cwd = real_cwd;
    }
    if (agent_transcript_path(journal, sizeof journal) != 0)
        tx_snprintf(journal, sizeof journal, "/tmp/csih-agent-%d.jsonl", (int)sy_pid());
    transcript = journal;

    /* join the rest of argv as the prompt. The word spill is a switch. */
    agent_set_spill(0);
    prompt[0] = '\0';
    for (i = 2, k = 0; i < argc && k < sizeof prompt - 2; i++) {
        if (!zs_cmp(argv[i], "spill")) { agent_set_spill(1); continue; }
        if (k > 0) prompt[k++] = ' ';
        n = tx_snprintf(prompt + k, sizeof prompt - k, "%s", argv[i]);
        if (n < 0) break;
        k += (size_t)n;
    }

    sy_printf("agent: endpoint=%s model=%s cwd=%s\n", endpoint, model, cwd);
    fflush(stdout);
    r = agent_run_cb(prompt, transcript, endpoint, model, cwd, NULL, print_event, NULL);

    sy_printf("acceptance=%d scope=%d (semantic assessment, not proof)\n",r.acceptance,r.scope);
    if (!r.ok) {
        sy_printf("agent FAILED: %s (err=%d)\n", r.reason, r.err);
        if (r.answer[0]) sy_printf("\n%s\n", r.answer);
        print_trace(transcript);
        return 1;
    }
    sy_printf("\n%s\n", r.answer[0] ? r.answer : "(no answer text)");
    sy_printf("rounds=%d actions=%d stopped=%s reason=%s\n",
           r.rounds, r.actions, r.stopped ? "yes" : "no", r.reason);
    print_trace(transcript);
    return 0;
}

int main(int argc, char **argv) {
    const char *cmd = argc > 1 ? argv[1] : "";
    if (!zs_cmp(cmd, "selftest")) return agent_run_selftest();
    if (!zs_cmp(cmd, "agent")) return run_agent(argc, argv);
    /* the caller's explicit delivery obligation for this one turn (watch role with
       CSIH_ROLE/CSIH_PEER): the turn must end with a real envelope receipt */
    if (!zs_cmp(cmd, "agent-required")) {
        if (agent_delivery_require_next(1) != 0) { sy_eprintf("agent-required: needs CSIH_ROLE=watch and a valid CSIH_PEER\n"); return 64; }
        return run_agent(argc, argv);
    }
    sy_printf("usage: agent_cli selftest | agent [spill] <prompt...> | agent-required <prompt...>\n");
    return 64;
}
