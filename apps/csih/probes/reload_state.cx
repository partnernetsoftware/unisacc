#pragma unisa use text.fmt
#pragma unisa use sys.io
#pragma unisa use mem.heap
#pragma unisa use sys.env
/* CX probe */
/* reload_state.cx -- CX port of probes/reload_state.py (v1 state validator matrix).
 *
 * Builds the real CLI once (reload_state_cli.cx, as the Python built it with -o),
 * then runs `CLI check FIXTURE` per case and asserts the exit code and the
 * PASS/FAIL line it prints. Raw text cases (duplicate keys, hand-built JSON) are
 * written exactly as the Python spliced them.
 *
 *   cwd apps/csih; compiler $UNISACC, else APP/../../unisacc.com
 *   processes through cx_runv_timeout (own process group, killed past the limit),
 *   strings through the plain loops below, no libc string calls (tests/cxraw.cx ratchet;
 *   the L0 text package is not reachable from probes/ without a link of its own)
 *
 * One build instead of -run per case: measured 2026-10-30, one `-run
 * reload_state_cli.cx` costs ~5.6 s (compile) and the binary ~2 ms, so 20 run-mode
 * cases (~112 s) cannot fit the contract's 40 s budget. The binary lives in the
 * probe's mkdtemp dir and is removed with it; nothing is cached across runs.
 *
 * Deviations from the Python original:
 *   - json.dumps spacing is reproduced by hand; the validator sees the same keys
 *     and values, which is what the cases test;
 *   - stdout and stderr are merged into one stream, as Python's (stdout+stderr);
 *   - per-case limit 4 s, as the Python's timeout=4; build limit 30 s.
 */

#define SHA_A "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

static char DIR[1024], APP[1024], UNI[1200], BIN[1100];

/* length of z-string S within CAP, or -1 */
static long tx_len(const char *s, long cap) {
    long i;
    for (i = 0; i < cap; i++) if (!s[i]) return i;
    return -1;
}
/* 1 when S[0..n) starts with P[0..pn) */
static int tx_prefix(const char *s, long n, const char *p, long pn) {
    long i;
    if (pn < 0 || pn > n) return 0;
    for (i = 0; i < pn; i++) if (s[i] != p[i]) return 0;
    return 1;
}
/* offset of P[0..pn) in S[0..n), or -1 */
static long tx_find(const char *s, long n, const char *p, long pn) {
    long i;
    if (pn < 0) return -1;
    for (i = 0; i + pn <= n; i++) if (tx_prefix(s + i, n - i, p, pn)) return i;
    return -1;
}
/* SRC[0..n) into DST (cap > n) and terminate */
static void tx_copy(char *dst, long cap, const char *src, long n) {
    long i;
    if (n >= cap) n = cap - 1;
    for (i = 0; i < n; i++) dst[i] = src[i];
    dst[n] = 0;
}

/* APP = cwd; UNI = $UNISACC or APP/../../unisacc.com; 0 when both exist */
static int locate(void) {
    const char *e = sy_env("UNISACC");
    char probe[1200];
    struct stat st;
    if (!getcwd(APP, sizeof APP)) { sy_printf("FAIL: getcwd: %s\n", sy_strerror(errno)); return -1; }
    if (e && e[0]) tx_snprintf(UNI, sizeof UNI, "%s", e);
    else tx_snprintf(UNI, sizeof UNI, "%s/../../unisacc.com", APP);
    tx_snprintf(probe, sizeof probe, "%s/reload_state_cli.cx", APP);
    if (stat(probe, &st) != 0) { sy_printf("FAIL: %s: %s\n", probe, sy_strerror(errno)); return -1; }
    if (stat(UNI, &st) != 0) { sy_printf("FAIL: %s: %s\n", UNI, sy_strerror(errno)); return -1; }
    return 0;
}

/* ARGS (NULL-terminated, at most 7) under /bin/sh with stderr merged into stdout, as the
 * Python's stdout+stderr; SECS limit. 0 with *rc and OUT (truncated to cap); -2 timeout; -1 error. */
static int run_merged(char **args, int secs, char *out, long cap, int *rc) {
    char *argv[12], *o = NULL;
    size_t n = 0;
    int i, r;
    argv[0] = (char *)"/bin/sh"; argv[1] = (char *)"-c"; argv[2] = (char *)"exec \"$@\" 2>&1"; argv[3] = (char *)"sh";
    for (i = 0; i < 7 && args[i]; i++) argv[4 + i] = args[i];
    argv[4 + i] = NULL;
    r = cx_runv_timeout(argv, secs, &o, &n);
    out[0] = 0;
    if (o) { if ((long)n >= cap) n = (size_t)(cap - 1); tx_copy(out, cap, o, (long)n); mm_free(o); }
    if (r == 124) return -2;
    if (r < 0) return -1;
    *rc = r;
    return 0;
}

static int build(void) {
    char *args[8];
    static char out[8192];
    int rc = 0, r;
    tx_snprintf(BIN, sizeof BIN, "%s/reload_state_cli", DIR);
    args[0] = (char *)"/bin/sh"; args[1] = UNI; args[2] = (char *)"reload_state_cli.cx";
    args[3] = (char *)"-o"; args[4] = BIN; args[5] = NULL;
    r = run_merged(args, 30, out, (long)sizeof out, &rc);
    if (r != 0 || rc != 0) {
        sy_printf("FAIL build: %s rc %d | %.400s\n", r == -2 ? "timeout" : "exit", rc, out);
        return -1;
    }
    return 0;
}

static int failed = 0, passed = 0;

/* Write raw_text to a fixture, run `CLI check FIXTURE`, check exit and text. */
static void run_check(const char *name, const char *raw, int expect_code, int expect_ok, const char *why) {
    char path[1100], buf[4096], *out = buf;
    char *args[4];
    int rc = 0, ok = 1, r;
    long k, rawn = tx_len(raw, 1L << 20);
    tx_snprintf(path, sizeof path, "%s/state.json", DIR);
    if (rawn < 0 || cx_write(path, raw, (size_t)rawn) != 0) { sy_printf("FAIL %s: cannot write fixture\n", name); failed++; return; }
    args[0] = BIN; args[1] = (char *)"check"; args[2] = path; args[3] = NULL;
    r = run_merged(args, 4, buf, (long)sizeof buf, &rc);
    if (r != 0) { sy_printf("FAIL %s: %s\n", name, r == -2 ? "timeout" : "run error"); failed++; return; }
    /* strip, as the Python's .strip() of newlines and spaces */
    k = tx_len(buf, (long)sizeof buf);
    while (k > 0 && (buf[k - 1] == '\n' || buf[k - 1] == ' ')) buf[--k] = 0;
    while (*out == '\n' || *out == ' ') { out++; k--; }
    if (rc != expect_code) {
        ok = 0;
        sy_printf("FAIL %s: exit %d, want %d | %s\n", name, rc, expect_code, out);
    } else if (expect_ok) {
        if (!tx_prefix(out, k, "PASS: ok", 8)) { ok = 0; sy_printf("FAIL %s: not PASS: ok | %s\n", name, out); }
    } else {
        if (!tx_prefix(out, k, "FAIL:", 5)) { ok = 0; sy_printf("FAIL %s: not FAIL | %s\n", name, out); }
        else if (why && tx_find(out, k, why, tx_len(why, 256)) < 0) { ok = 0; sy_printf("FAIL %s: want '%s' | %s\n", name, why, out); }
    }
    if (ok) { sy_printf("PASS %s: exit %d %s\n", name, rc, out); passed++; }
    else failed++;
}

/* Base state, as the Python base(): fields are pre-rendered by the caller.
 * extra is appended before the closing brace (duplicate/unknown keys). */
static void base_json(char *buf, size_t cap, const char *version, const char *session,
                      const char *hash, const char *goal, const char *input, const char *cwd,
                      const char *journal, const char *queue, const char *extra) {
    tx_snprintf(buf, cap,
             "{\"version\": %s, \"session_id\": \"%s\", \"handoff_id\": \"h1\", "
             "\"candidate_hash\": \"%s\", \"goal\": \"%s\", \"input\": \"%s\", "
             "\"cwd\": \"%s\", \"role\": \"agent\", \"peer\": \"\", "
             "\"journal\": %s, \"pending_queue\": %s%s}",
             version, session, hash, goal, input, cwd, journal, queue, extra);
}

#define J_OK "{\"path\": \"/tmp/journal.jsonl\", \"offset\": 0}"
#define Q_EMPTY "[]"

static void rep(char *dst, size_t cap, char c, size_t count) {
    size_t i;
    if (count + 1 > cap) count = cap - 1;
    for (i = 0; i < count; i++) dst[i] = c;
    dst[count] = 0;
}

int main(void) {
    char tmpl[1100];
    char *tmp;
    static char buf[8192], goal4095[4200], goal4096[4200], raw[8192];
    int rc = 1;
    const char *td = sy_env("TMPDIR");

    if (locate() != 0) { puts("RESULT FAIL reload_state"); return 1; }
    tx_snprintf(tmpl, sizeof tmpl, "%s/csih-state-XXXXXX", td && *td ? td : "/tmp");   /* the guard's temp root */
    tmp = mkdtemp(tmpl);
    if (!tmp) { sy_printf("FAIL: mkdtemp: %s\n", sy_strerror(errno)); return 1; }
    tx_snprintf(DIR, sizeof DIR, "%s", tmp);
    if (build() != 0) goto done;

    /* valid */
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "do the thing", "hello world", "/tmp", J_OK, Q_EMPTY, "");
    run_check("valid_ascii", buf, 0, 1, NULL);
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "目标 中文\\n第二行", "输入\\t含空格 中文", "/tmp", J_OK, Q_EMPTY, "");
    run_check("valid_unicode_ws_goal_input", buf, 0, 1, NULL);
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "do the thing", "hello world", "/tmp", J_OK,
              "[\"a0\", \"a1\", \"a2\", \"a3\", \"a4\", \"a5\", \"a6\", \"a7\"]", "");
    run_check("queue8_pass", buf, 0, 1, NULL);
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "do the thing", "hello world", "/tmp", J_OK,
              "[\"a0\", \"a1\", \"a2\", \"a3\", \"a4\", \"a5\", \"a6\", \"a7\", \"a8\"]", "");
    run_check("queue9_reject", buf, 1, 0, "pending_queue");
    rep(goal4095, sizeof goal4095, 'g', 4095);
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, goal4095, "hello world", "/tmp", J_OK, Q_EMPTY, "");
    run_check("goal4095_pass", buf, 0, 1, NULL);
    rep(goal4096, sizeof goal4096, 'g', 4096);
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, goal4096, "hello world", "/tmp", J_OK, Q_EMPTY, "");
    run_check("goal4096_reject", buf, 1, 0, "4095");

    /* offsets and paths */
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "do the thing", "hello world", "/tmp",
              "{\"path\": \"/tmp/j.jsonl\", \"offset\": 9007199254740991}", Q_EMPTY, "");
    run_check("offset_max_pass", buf, 0, 1, NULL);
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "do the thing", "hello world", "/tmp",
              "{\"path\": \"/tmp/j.jsonl\", \"offset\": 9007199254740992}", Q_EMPTY, "");
    run_check("offset_2p53_reject", buf, 1, 0, "offset");
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "do the thing", "hello world", "/tmp",
              "{\"path\": \"/tmp/j.jsonl\", \"offset\": -1}", Q_EMPTY, "");
    run_check("offset_neg_reject", buf, 1, 0, "offset");
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "do the thing", "hello world", "/tmp",
              "{\"path\": \"/tmp/j.jsonl\", \"offset\": 1.5}", Q_EMPTY, "");
    run_check("offset_frac_reject", buf, 1, 0, "offset");
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "do the thing", "hello world", "/tmp",
              "{\"path\": \"tmp/j.jsonl\", \"offset\": 0}", Q_EMPTY, "");
    run_check("journal_relpath_reject", buf, 1, 0, "absolute");
    base_json(buf, sizeof buf, "1", "会话", SHA_A, "do the thing", "hello world", "/tmp", J_OK, Q_EMPTY, "");
    run_check("sessionid_unicode_reject", buf, 1, 0, "session_id");
    base_json(buf, sizeof buf, "2", "sess-abc", SHA_A, "do the thing", "hello world", "/tmp", J_OK, Q_EMPTY, "");
    run_check("version2_reject", buf, 1, 0, "version");
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "do the thing", "hello world", "/tmp",
              "{\"path\": \"/tmp/j.jsonl\", \"offset\": 9007199254740993}", Q_EMPTY, "");
    run_check("offset_2p53p1_reject", buf, 1, 0, "offset");
    base_json(buf, sizeof buf, "1", "sess-abc", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "do the thing", "hello world", "/tmp", J_OK, Q_EMPTY, "");
    run_check("hash63_reject", buf, 1, 0, "candidate_hash");
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "do the thing", "hello world", "rel/path", J_OK, Q_EMPTY, "");
    run_check("cwd_rel_reject", buf, 1, 0, "cwd");

    /* cases2: unknown/missing fields and raw duplicate keys */
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "do the thing", "hello world", "/tmp", J_OK, Q_EMPTY,
              ", \"bogus\": 1");
    run_check("unknown_field_reject", buf, 1, 0, "unknown");
    tx_snprintf(raw, sizeof raw,
             "{\"version\": 1, \"session_id\": \"sess-abc\", \"handoff_id\": \"h1\", "
             "\"candidate_hash\": \"%s\", \"goal\": \"do the thing\", \"cwd\": \"/tmp\", "
             "\"role\": \"agent\", \"peer\": \"\", \"journal\": %s, \"pending_queue\": []}",
             SHA_A, J_OK);
    run_check("missing_input_reject", raw, 1, 0, "missing");
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "do the thing", "hello world", "/tmp", J_OK, Q_EMPTY,
              ", \"journal\": {\"path\": \"/tmp/j2.jsonl\", \"offset\": 0}");
    run_check("dup_journal_reject", buf, 1, 0, "duplicate");
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "do the thing", "hello world", "/tmp", J_OK, Q_EMPTY,
              ", \"pending_queue\": []");
    run_check("dup_queue_reject", buf, 1, 0, "duplicate");

    sy_printf("TOTAL: %d passed, %d failed, %d total\n", passed, failed, passed + failed);
    rc = (failed == 0 && passed == 20) ? 0 : 1;
done:
    cx_rmtree(DIR);   /* fixture and built CLI lie in DIR; a refusal is reported on stderr, the verdict stands */
    sy_printf("RESULT %s reload_state\n", rc == 0 ? "PASS" : "FAIL");
    return rc;
}
