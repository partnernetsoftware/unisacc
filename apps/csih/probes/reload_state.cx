/* CX probe */
/* reload_state.c -- C port of probes/reload_state.py (v1 state validator matrix).
 *
 * Runs the real CLI (unisacc run mode, per fixture) and asserts
 * the exit code and the PASS/FAIL line it prints. Raw text cases (duplicate
 * keys, hand-built JSON) are written exactly as the Python spliced them.
 *
 *   /bin/sh /Users/wjc/repos/unisacc/unisacc.com -include ABS/json.h json.cx reload_state.c reload_state_cli.c check FIX
 *
 * Deviations from the Python original:
 *   - run mode throughout (no -o); if run mode drops .cx definitions the failure is a unisacc defect;
 *   - json.dumps spacing is reproduced by hand; the validator sees the same keys
 *     and values, which is what the cases test;
 *   - stdout and stderr are merged into one stream, as Python's (stdout+stderr).
 */
#include "../../../include/unisa_safedel.h"   /* the one deletion guard (commissar ruling 2026-10-23); first: its feature macro */
#include <errno.h>
#include <fcntl.h>
#include <poll.h>
#include <signal.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <sys/wait.h>
#include <time.h>
#include <unistd.h>

#include "csih_flat.h"

#define SHA_A "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

static char DIR[1024];

/* combined stdout+stderr, 4 s limit */
static int run_merged(char *const argv[], char *out, size_t cap, int *rc) {
    int p[2], st;
    pid_t pid;
    size_t on = 0;
    time_t deadline = time(NULL) + 60;
    int open_fd = 1, timed_out = 0;
    out[0] = 0;
    *rc = 127;
    if (pipe(p) != 0) return -1;
    pid = fork();
    if (pid < 0) { close(p[0]); close(p[1]); return -1; }
    if (pid == 0) {
        if (chdir(CSIH_APP) != 0) _exit(126);
        dup2(p[1], 1); dup2(p[1], 2);
        close(p[0]); close(p[1]);
        execv(argv[0], argv);
        _exit(127);
    }
    close(p[1]);
    while (open_fd) {
        struct pollfd f;
        if (time(NULL) > deadline) { timed_out = 1; kill(pid, SIGKILL); break; }
        f.fd = p[0]; f.events = POLLIN;
        if (poll(&f, 1, 100) <= 0) continue;
        if (on + 1 >= cap) { open_fd = 0; break; }
        {
            ssize_t got = read(p[0], out + on, cap - 1 - on);
            if (got <= 0) open_fd = 0; else on += (size_t)got;
        }
    }
    out[on] = 0;
    close(p[0]);
    if (waitpid(pid, &st, 0) < 0) return -1;
    if (timed_out) return -1;
    *rc = WIFEXITED(st) ? WEXITSTATUS(st) : 128;
    return 0;
}

static int failed = 0, passed = 0;

/* Write raw_text to a fixture, run `unisacc run: check FIXTURE`, check exit and text. */
static void run_check(const char *name, const char *raw, int expect_code, int expect_ok, const char *why) {
    char path[1100], out[4096];
    char *argv[10];
    int rc = 0, ok = 1;
    FILE *f;
    size_t n;
    snprintf(path, sizeof path, "%s/state.json", DIR);
    f = fopen(path, "wb");
    if (!f) { printf("FAIL %s: cannot write fixture\n", name); failed++; return; }
    n = fwrite(raw, 1, strlen(raw), f);
    fclose(f);
    if (n != strlen(raw)) { printf("FAIL %s: short write\n", name); failed++; return; }
    argv[0] = (char *)"/bin/sh"; argv[1] = (char *)CSIH_ROOT "/unisacc.com";
    argv[2] = (char *)"-run"; argv[3] = (char *)"reload_state_cli.cx";
    argv[4] = (char *)"--"; argv[5] = (char *)"check"; argv[6] = path; argv[7] = NULL;
    if (run_merged(argv, out, sizeof out, &rc) != 0) {
        printf("FAIL %s: timeout\n", name); failed++; return;
    }
    {
        size_t k = strlen(out);
        while (k && (out[k - 1] == '\n' || out[k - 1] == ' ')) out[--k] = 0;
        while (out[0] == '\n' || out[0] == ' ') memmove(out, out + 1, strlen(out));
    }
    if (rc != expect_code) {
        ok = 0;
        printf("FAIL %s: exit %d, want %d | %s\n", name, rc, expect_code, out);
    } else if (expect_ok) {
        if (strncmp(out, "PASS: ok", 8) != 0) { ok = 0; printf("FAIL %s: not PASS: ok | %s\n", name, out); }
    } else {
        if (strncmp(out, "FAIL:", 5) != 0) { ok = 0; printf("FAIL %s: not FAIL | %s\n", name, out); }
        else if (why && !strstr(out, why)) { ok = 0; printf("FAIL %s: want '%s' | %s\n", name, why, out); }
    }
    if (ok) { printf("PASS %s: exit %d %s\n", name, rc, out); passed++; }
    else failed++;
}

/* Base state, as the Python base(): fields are pre-rendered by the caller.
 * extra is appended before the closing brace (duplicate/unknown keys). */
static void base_json(char *buf, size_t cap, const char *version, const char *session,
                      const char *hash, const char *goal, const char *input, const char *cwd,
                      const char *journal, const char *queue, const char *extra) {
    snprintf(buf, cap,
             "{\"version\": %s, \"session_id\": \"%s\", \"handoff_id\": \"h1\", "
             "\"candidate_hash\": \"%s\", \"goal\": \"%s\", \"input\": \"%s\", "
             "\"cwd\": \"%s\", \"role\": \"agent\", \"peer\": \"\", "
             "\"journal\": %s, \"pending_queue\": %s%s}",
             version, session, hash, goal, input, cwd, journal, queue, extra);
}

#define J_OK "{\"path\": \"/tmp/journal.jsonl\", \"offset\": 0}"
#define Q_EMPTY "[]"

static void rep(char *dst, size_t cap, char c, size_t count) {
    size_t i;
    if (count + 1 > cap) count = cap - 1;
    for (i = 0; i < count; i++) dst[i] = c;
    dst[count] = 0;
}

/* P (a tree) through the one guard, never a raw unlink/rmdir; a refusal is reported, the probe's verdict stands */
static void sd_gone(const char *p) {
    char why[600];
    if (unisa_safedel(p, SAFEDEL_PURGE | SAFEDEL_RECURSIVE, 0, why, (int)sizeof why)) fprintf(stderr, "probe: %s\n", why);
}
int main(void) {
    char tmpl[1100];
    char *tmp;
    char buf[8192], goal4095[4200], goal4096[4200], q8[512], q9[512], raw[8192];
    int rc = 0;

    snprintf(tmpl, sizeof tmpl, "%s/csih-state-XXXXXX", getenv("TMPDIR") && *getenv("TMPDIR") ? getenv("TMPDIR") : "/tmp");   /* the guard's temp root */
    tmp = mkdtemp(tmpl);
    if (!tmp) { puts("FAIL: mkdtemp"); return 1; }
    strcpy(DIR, tmp);

    /* valid */
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "do the thing", "hello world", "/tmp", J_OK, Q_EMPTY, "");
    run_check("valid_ascii", buf, 0, 1, NULL);
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "目标 中文\\n第二行", "输入\\t含空格 中文", "/tmp", J_OK, Q_EMPTY, "");
    run_check("valid_unicode_ws_goal_input", buf, 0, 1, NULL);
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "do the thing", "hello world", "/tmp", J_OK,
              "[\"a0\", \"a1\", \"a2\", \"a3\", \"a4\", \"a5\", \"a6\", \"a7\"]", "");
    run_check("queue8_pass", buf, 0, 1, NULL);
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "do the thing", "hello world", "/tmp", J_OK,
              "[\"a0\", \"a1\", \"a2\", \"a3\", \"a4\", \"a5\", \"a6\", \"a7\", \"a8\"]", "");
    run_check("queue9_reject", buf, 1, 0, "pending_queue");
    rep(goal4095, sizeof goal4095, 'g', 4095);
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, goal4095, "hello world", "/tmp", J_OK, Q_EMPTY, "");
    run_check("goal4095_pass", buf, 0, 1, NULL);
    rep(goal4096, sizeof goal4096, 'g', 4096);
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, goal4096, "hello world", "/tmp", J_OK, Q_EMPTY, "");
    run_check("goal4096_reject", buf, 1, 0, "4095");

    /* offsets and paths */
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "do the thing", "hello world", "/tmp",
              "{\"path\": \"/tmp/j.jsonl\", \"offset\": 9007199254740991}", Q_EMPTY, "");
    run_check("offset_max_pass", buf, 0, 1, NULL);
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "do the thing", "hello world", "/tmp",
              "{\"path\": \"/tmp/j.jsonl\", \"offset\": 9007199254740992}", Q_EMPTY, "");
    run_check("offset_2p53_reject", buf, 1, 0, "offset");
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "do the thing", "hello world", "/tmp",
              "{\"path\": \"/tmp/j.jsonl\", \"offset\": -1}", Q_EMPTY, "");
    run_check("offset_neg_reject", buf, 1, 0, "offset");
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "do the thing", "hello world", "/tmp",
              "{\"path\": \"/tmp/j.jsonl\", \"offset\": 1.5}", Q_EMPTY, "");
    run_check("offset_frac_reject", buf, 1, 0, "offset");
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "do the thing", "hello world", "/tmp",
              "{\"path\": \"tmp/j.jsonl\", \"offset\": 0}", Q_EMPTY, "");
    run_check("journal_relpath_reject", buf, 1, 0, "absolute");
    base_json(buf, sizeof buf, "1", "会话", SHA_A, "do the thing", "hello world", "/tmp", J_OK, Q_EMPTY, "");
    run_check("sessionid_unicode_reject", buf, 1, 0, "session_id");
    base_json(buf, sizeof buf, "2", "sess-abc", SHA_A, "do the thing", "hello world", "/tmp", J_OK, Q_EMPTY, "");
    run_check("version2_reject", buf, 1, 0, "version");
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "do the thing", "hello world", "/tmp",
              "{\"path\": \"/tmp/j.jsonl\", \"offset\": 9007199254740993}", Q_EMPTY, "");
    run_check("offset_2p53p1_reject", buf, 1, 0, "offset");
    base_json(buf, sizeof buf, "1", "sess-abc", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "do the thing", "hello world", "/tmp", J_OK, Q_EMPTY, "");
    run_check("hash63_reject", buf, 1, 0, "candidate_hash");
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "do the thing", "hello world", "rel/path", J_OK, Q_EMPTY, "");
    run_check("cwd_rel_reject", buf, 1, 0, "cwd");

    /* cases2: unknown/missing fields and raw duplicate keys */
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "do the thing", "hello world", "/tmp", J_OK, Q_EMPTY,
              ", \"bogus\": 1");
    run_check("unknown_field_reject", buf, 1, 0, "unknown");
    snprintf(raw, sizeof raw,
             "{\"version\": 1, \"session_id\": \"sess-abc\", \"handoff_id\": \"h1\", "
             "\"candidate_hash\": \"%s\", \"goal\": \"do the thing\", \"cwd\": \"/tmp\", "
             "\"role\": \"agent\", \"peer\": \"\", \"journal\": %s, \"pending_queue\": []}",
             SHA_A, J_OK);
    run_check("missing_input_reject", raw, 1, 0, "missing");
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "do the thing", "hello world", "/tmp", J_OK, Q_EMPTY,
              ", \"journal\": {\"path\": \"/tmp/j2.jsonl\", \"offset\": 0}");
    run_check("dup_journal_reject", buf, 1, 0, "duplicate");
    base_json(buf, sizeof buf, "1", "sess-abc", SHA_A, "do the thing", "hello world", "/tmp", J_OK, Q_EMPTY,
              ", \"pending_queue\": []");
    run_check("dup_queue_reject", buf, 1, 0, "duplicate");

    printf("TOTAL: %d passed, %d failed, %d total\n", passed, failed, passed + failed);
    rc = (failed == 0 && passed > 0) ? 0 : 1;
done:
    /* remove fixture and binary */
    {
        sd_gone(DIR);   /* state.json lies in DIR */
    }
    printf("RESULT %s reload_state\n", rc == 0 ? "PASS" : "FAIL");
    return rc;
}
