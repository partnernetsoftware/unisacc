#pragma unisa module netwit
#pragma unisa use sys.net
#pragma unisa use sys.proc
#pragma unisa use sys.fs
/*
 * netwit.cx — the loopback servers csih's probe roots need, so the roots stay
 * include-free (upper modules: pragma only). Lower (a csih probe adapter):
 * sockets and waiting are cx/sys net (probes/sys); no #include.
 *
 * nw_wait_port(port, ms)       0 once 127.0.0.1:PORT accepts, -1 after MS
 * nw_serve_file(port, path)    child process: answer every request with 200
 *                              and the file's bytes until killed or 60s idle;
 *                              its pid (stop it with sy_kill)
 */

int nw_wait_port(int port, int ms) {
    return sy_wait_port(port, ms) == 0 ? 0 : -1;
}

/* A port probe connects and closes without a request: it gets nothing.
 * sy_send_all uses MSG_NOSIGNAL: unisacc's signal() cannot ignore SIGPIPE. */
static void nw_serve(int s, const char *body, int n) {
    static char req[8192];
    char head[160];
    int idle_ms = 60000;   /* the server ends itself: a killed parent cannot leak it */
    while (idle_ms > 0) {
        int c, have = 0, hl;
        long k;
        c = sy_tcp_accept(s, 500);
        if (c == -ETIMEDOUT) { idle_ms -= 500; continue; }
        if (c < 0) continue;
        while (have < (int)sizeof req - 1 && (k = sy_recv(c, req + have, (long)sizeof req - 1 - have)) > 0) {
            int i;
            have += (int)k;
            req[have] = 0;
            for (i = 3; i < have; i++)
                if (req[i - 3] == '\r' && req[i - 2] == '\n' && req[i - 1] == '\r' && req[i] == '\n') break;
            if (i < have) break;
        }
        if (have > 0) {
            hl = snprintf(head, sizeof head,
                          "HTTP/1.0 200 OK\r\nContent-Type: text/plain\r\nContent-Length: %d\r\nConnection: close\r\n\r\n", n);
            if (sy_send_all(c, head, hl) == 0 && n > 0) sy_send_all(c, body, n);
        }
        sy_close(c);
    }
}

/* The socket listens before the fork, so there is no start race. -1 on failure. */
int nw_serve_file(int port, const char *path) {
    static char body[4096];
    size_t len = 0;
    char *b = cx_read(path, &len);
    int s, n = 0;
    pid_t pid;
    if (b) {
        n = len < sizeof body ? (int)len : (int)sizeof body;
        snprintf(body, sizeof body, "%.*s", n, b);
        free(b);
    }
    s = sy_tcp_listen(port, 4);
    if (s < 0) return -1;
    pid = fork();
    if (pid < 0) { sy_close(s); return -1; }
    if (pid == 0) { nw_serve(s, body, n); _exit(0); }
    sy_close(s);
    return (int)pid;
}
