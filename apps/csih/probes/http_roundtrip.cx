#pragma unisa use u_run
/* CX probe root; lower includes kept */
/* http_roundtrip.cx — csih net.c GET against a local file server.
 *   unisacc probes/http_roundtrip.cx
 * A forked child of this probe serves the one file (serve_file); the client
 * under test is unisacc's net_cli. No gcc, no python.
 */
#include "../../../include/unisa_safedel.h"   /* the one deletion guard (commissar ruling 2026-10-23); first: its feature macro */
#include <arpa/inet.h>
#include <netinet/in.h>
#include <signal.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/socket.h>
#include <sys/stat.h>
#include <sys/wait.h>
#include <unistd.h>


static int wait_port(int port) {
    int i;
    for (i = 0; i < 40; i++) {
        int s = socket(AF_INET, SOCK_STREAM, 0);
        struct sockaddr_in a;
        if (s < 0) return -1;
        memset(&a, 0, sizeof a);
        a.sin_family = AF_INET;
        a.sin_port = htons((unsigned short)port);
        a.sin_addr.s_addr = htonl(0x7f000001);
        if (connect(s, (struct sockaddr *)&a, sizeof a) == 0) { close(s); return 0; }
        close(s);
        usleep(100000);
    }
    return -1;
}

/* Child: answer every request on 127.0.0.1:PORT with 200 and the bytes of
 * PATH, until killed. The request is read up to the blank line and ignored:
 * there is one file, and the probe checks the client, not routing. */
static void serve_file(int port, const char *path) {
    static char body[4096], req[8192];
    char head[160];
    struct sockaddr_in a;
    int s, one = 1, n = 0;
    FILE *f = fopen(path, "rb");
    if (f) { n = (int)fread(body, 1, sizeof body, f); fclose(f); }
    s = socket(AF_INET, SOCK_STREAM, 0);
    if (s < 0) _exit(1);
    setsockopt(s, SOL_SOCKET, SO_REUSEADDR, &one, sizeof one);
    memset(&a, 0, sizeof a);
    a.sin_family = AF_INET;
    a.sin_port = htons((unsigned short)port);
    a.sin_addr.s_addr = htonl(0x7f000001);
    if (bind(s, (struct sockaddr *)&a, sizeof a) != 0 || listen(s, 4) != 0) _exit(1);
    for (;;) {
        int c = accept(s, NULL, NULL), have = 0, hl;
        ssize_t k;
        if (c < 0) continue;
        while (have < (int)sizeof req - 1 && (k = read(c, req + have, sizeof req - 1 - have)) > 0) {
            have += (int)k;
            req[have] = 0;
            if (strstr(req, "\r\n\r\n")) break;
        }
        /* wait_port connects and closes without a request: answer nothing.
         * send(MSG_NOSIGNAL), not write: unisacc's signal() cannot ignore
         * SIGPIPE, and a write to a closed peer would kill this server. */
        if (have > 0) {
            hl = snprintf(head, sizeof head,
                          "HTTP/1.0 200 OK\r\nContent-Type: text/plain\r\nContent-Length: %d\r\nConnection: close\r\n\r\n", n);
            if (send(c, head, (size_t)hl, MSG_NOSIGNAL) == hl && n > 0) send(c, body, (size_t)n, MSG_NOSIGNAL);
        }
        close(c);
    }
}

/* P (a tree) through the one guard, never a raw unlink/rmdir; a refusal is reported, the probe's verdict stands */
static void sd_gone(const char *p) {
    char why[600];
    if (unisa_safedel(p, SAFEDEL_PURGE | SAFEDEL_RECURSIVE, 0, why, (int)sizeof why)) fprintf(stderr, "probe: %s\n", why);
}
int main(void) {
    const char *u = getenv("UNISACC");
    char dir[1024], www[1100], idx[1200], port[16], url[80], out[2048];
    char *args[6];
    int rc, st;
    pid_t pid;
    FILE *f;
    if (!u || !u[0]) u = "/Users/wjc/repos/unisacc/unisacc.com";
    snprintf(dir, sizeof dir, "%s/cdsh-http-%d", getenv("TMPDIR") && *getenv("TMPDIR") ? getenv("TMPDIR") : "/tmp", (int)getpid());   /* the guard's temp root */
    snprintf(www, sizeof www, "%s/www", dir);
    snprintf(idx, sizeof idx, "%s/index.txt", www);
    if (mkdir(dir, 0700) || mkdir(www, 0700)) { printf("no temp\n"); return 2; }
    f = fopen(idx, "w"); if (!f) return 2;
    fputs("hello from cdsh\n", f); fclose(f);
    snprintf(port, sizeof port, "18937");
    pid = fork();
    if (pid == 0) serve_file(atoi(port), idx);
    if (wait_port(18937) != 0) { u_stop(pid); printf("  FAIL  server did not listen\n"); return 1; }
    snprintf(url, sizeof url, "http://127.0.0.1:18937/index.txt");
    args[0] = (char *)"-run"; args[1] = (char *)"net_cli.cx";
    args[2] = (char *)"--"; args[3] = (char *)"get"; args[4] = url;
    u_spawn(u, args, 5, NULL, out, (int)sizeof out, &rc);
    u_stop(pid); waitpid(pid, &st, 0);
    printf("  unisacc: %s\n", out);
    if (!strstr(out, "hello from cdsh")) { printf("  FAIL  body\n"); return 1; }
    printf("  ok    the response body is the served file\n");
    if (!strstr(out, "status 200")) { printf("  FAIL  status\n"); return 1; }
    printf("  ok    status 200\n");
    sd_gone(dir);   /* idx and www lie in DIR */
    return 0;
}
