#pragma unisa use text.fmt
#pragma unisa use sys.io
#pragma unisa use sys.proc
#pragma unisa use tmuxwit
#pragma unisa use text.text
#pragma unisa use sys.env
#pragma unisa use sys.fs
/*
 * owned_session.cx — owned export/resume on a real tty, ported from the
 * archived probes/owned_session.py (archive/reference-py/apps/csih/probes/).
 *   cd apps/csih && sh ../../unisacc.com probes/owned_session.cx
 *
 * The installed csih (CSIH_BIN, else out/csih-e2e-bin/csih) runs in private
 * tmux panes with a scratch HOME, CSIH_ENDPOINT 127.0.0.1:1 (refused: no
 * network) and no API keys. Same assertions as the Python original:
 *   1 a second agent-owned on the same DIR exits 1 "ownership lock
 *     unavailable", journal bytes and inode unchanged
 *   2 /goal, one plain line (seeds history; its turn is refused), a draft
 *     saved by Up, then /export-state h1: state-v2.json holds input "",
 *     history ["旧输入"] (no slash command), history_draft, goal, cwd, role,
 *     peer, journal {path, offset = journal size}, loop off; /exit exits 0
 *   3 resume-agent refuses a wrong session id, a moved offset and a foreign
 *     journal path (the last says "snapshot journal not bound"): exit 1,
 *     state and journal untouched
 *   4 resume-agent under a wrong CSIH_CWD/ROLE/PEER restores the snapshot's
 *     own, consumes state-v2.json once, Down brings the draft back, and a new
 *     /export-state h2 matches h1 on goal, history, history_draft,
 *     pending_queue, loop_on, loop_left, cwd, role, peer, journal
 *   5 the product inputs (csih.sh digest) are unchanged by the run
 * The Python version compiled its own candidate and ran its selftest first;
 * here that is the tui-selftest contract on the same installed binary.
 * One wait the original did not need: the seeded line's turn now retries a
 * refused connection twice (2s + 5s), and /export-state needs an idle TUI.
 * Upper root (L3): no #include, no direct libc calls (tmuxwit, text.text,
 * cx_read/cx_write/cx_rmtree).
 */

#define CAP 65536
#define HASH "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

static char pane[CAP];
static int fails;
static const char *bin;
static char dir[600], cwd[700], home[700], state[700], journal[700];
static char e_home[760], e_cwd[760];

/* 0 with PATH's size and inode (either may be NULL), -errno otherwise. */
static int st_of(const char *path, long *size, long *ino) {
    sy_stat_t s;
    int r = sy_stat(path, &s);
    if (r) return r;
    if (size) *size = s.size;
    if (ino) *ino = s.ino;
    return 0;
}

static long slen(const char *s) { return tx_len(s, CAP); }
static int has(const char *hay, const char *needle) { return tx_find(hay, slen(hay), needle, slen(needle)) >= 0; }
static void check(int ok, const char *what) {
    sy_printf("  %s  %s\n", ok ? "ok  " : "FAIL", what);
    if (!ok) fails++;
}

/* A pane running `csih ARGS...` under the session's env; wrong != 0 swaps in
 * a wrong CSIH_CWD/ROLE/PEER (the snapshot must win over them). */
static int start(const char *sess, const char *a1, const char *a2, const char *a3, const char *a4, const char *a5, const char *a6, int wrong) {
    static char wrong_cwd[760];
    char *cmd[26];
    int k = 0;
    tx_snprintf(wrong_cwd, sizeof wrong_cwd, "CSIH_CWD=%s", dir);
    cmd[k++] = "env"; cmd[k++] = "-u"; cmd[k++] = "DEEPSEEK_API_KEY"; cmd[k++] = "-u"; cmd[k++] = "OPENAI_API_KEY";
    cmd[k++] = e_home;
    cmd[k++] = wrong ? wrong_cwd : e_cwd;
    cmd[k++] = wrong ? "CSIH_ROLE=watch" : "CSIH_ROLE=write";
    cmd[k++] = wrong ? "CSIH_PEER=wrong" : "CSIH_PEER=0:owned-test";
    cmd[k++] = "CSIH_ENDPOINT=http://127.0.0.1:1/v1/chat/completions";
    cmd[k++] = "CSIH_MODEL=private-no-network";
    cmd[k++] = "sh"; cmd[k++] = "-c"; cmd[k++] = "\"$0\" \"$@\"; echo __RC=$?__; sleep 30";
    cmd[k++] = (char *)bin;
    cmd[k++] = (char *)a1; cmd[k++] = (char *)a2; cmd[k++] = (char *)a3; cmd[k++] = (char *)a4;
    if (a5) cmd[k++] = (char *)a5;
    if (a6) cmd[k++] = (char *)a6;
    return tw_new(sess, 120, 35, NULL, cmd, k);
}

static void type_line(const char *sess, const char *text) {
    tw_keys(sess, text, 1);
    tw_wait_text(sess, text, 1500, pane, sizeof pane);
    tw_sleep_ms(200);
    tw_keys(sess, "Enter", 0);
    tw_sleep_ms(250);
}

static void backspaces(const char *sess, int n) {
    int i;
    for (i = 0; i < n; i++) tw_keys(sess, "BSpace", 0);
    tw_sleep_ms(250);
}

/* The JSON value of top-level KEY in J (a compact object), as a span. */
static int jv(const char *j, const char *key, const char **v, long *vn) {
    char pat[96];
    long at, i, n = slen(j);
    int depth = 0, str = 0;
    tx_snprintf(pat, sizeof pat, "\"%s\":", key);
    at = tx_find(j, n, pat, slen(pat));
    if (at < 0) return 0;
    i = at + slen(pat);
    *v = j + i;
    for (; i < n; i++) {
        char c = j[i];
        if (str) { if (c == '\\') i++; else if (c == '"') str = 0; continue; }
        if (c == '"') str = 1;
        else if (c == '{' || c == '[') depth++;
        else if (c == '}' || c == ']') { if (!depth) break; depth--; }
        else if (c == ',' && !depth) break;
    }
    *vn = (j + i) - *v;
    return 1;
}
static int jv_is(const char *j, const char *key, const char *want) {
    const char *v; long vn;
    return jv(j, key, &v, &vn) && tx_same(v, vn, want, slen(want));
}
static int jv_same(const char *a, const char *b, const char *key) {
    const char *va, *vb; long an, bn;
    return jv(a, key, &va, &an) && jv(b, key, &vb, &bn) && tx_same(va, an, vb, bn);
}

/* J with the value of top-level KEY replaced by REPL, into OUT. */
static int jv_set(const char *j, const char *key, const char *repl, char *out, int cap) {
    const char *v; long vn;
    if (!jv(j, key, &v, &vn)) return 0;
    tx_snprintf(out, cap, "%.*s%s%s", (int)(v - j), j, repl, v + vn);
    return 1;
}

static char *read_all(const char *path) {
    size_t n;
    return cx_read(path, &n);
}

static char *digest(void) {
    static char out[2][4096];
    static int which;
    char *av[] = { "sh", "csih.sh", "digest", NULL };
    char *o = out[which++ & 1];
    const char *d;
    tw_run(av, o, 4096);
    d = o + tx_find(o, slen(o), "digest ", 7);
    return (char *)(d >= o ? d : o);
}

int main(void) {
    static char saved[CAP], again[CAP], bad[CAP], msg[400];
    const char *tmp = sy_env("TMPDIR");
    char absbin[700], here[600], *raw, *old, *d0, d0copy[200];
    long size0 = 0, ino0 = 0, size1 = 0, ino1 = 0, jsize = 0;
    int rc, i;

    bin = sy_env("CSIH_BIN");
    if (!getcwd(here, sizeof here)) return 2;
    if (!bin || !bin[0]) { tx_snprintf(absbin, sizeof absbin, "%s/../../out/csih-e2e-bin/csih", here); bin = absbin; }
    if (st_of(bin, NULL, NULL) != 0) { sy_printf("owned_session: no csih binary at %s (csih.sh prepare)\n", bin); return 2; }
    if (!tw_open("owned")) { sy_printf("owned_session: tmux is not on PATH\n"); return 2; }
    d0 = digest();
    tx_snprintf(d0copy, sizeof d0copy, "%.190s", d0);
    tx_snprintf(dir, sizeof dir, "%s/csih-owned-%d", tmp && tmp[0] ? tmp : "/tmp", (int)sy_pid());
    tx_snprintf(cwd, sizeof cwd, "%s/cwd", dir);
    tx_snprintf(home, sizeof home, "%s/home", dir);
    tx_snprintf(state, sizeof state, "%s/state-v2.json", dir);
    tx_snprintf(journal, sizeof journal, "%s/journal.jsonl", dir);
    tx_snprintf(e_home, sizeof e_home, "HOME=%s", home);
    tx_snprintf(e_cwd, sizeof e_cwd, "CSIH_CWD=%s", cwd);
    if (sy_mkdir(dir, 0700) || sy_mkdir(cwd, 0700) || sy_mkdir(home, 0700)) { sy_printf("owned_session: scratch %s\n", dir); return 2; }

    /* 1 the owner, then a second owner on the same DIR */
    start("own", "agent-owned", dir, "sess", HASH, NULL, NULL, 0);
    check(tw_wait_text("own", "owned session", 8000, pane, sizeof pane), "agent-owned draws its owned frame");
    old = read_all(journal);
    st_of(journal, &size0, &ino0);
    start("two", "agent-owned", dir, "sess", HASH, NULL, NULL, 0);
    rc = tw_rc("two", 8000);
    tw_capture("two", pane, sizeof pane);
    raw = read_all(journal);
    st_of(journal, &size1, &ino1);
    check(rc == 1 && has(pane, "ownership lock unavailable") && old && raw && size0 == size1 && ino0 == ino1 &&
          tx_same(old, size0, raw, size1), "second owner refused (exit 1), journal bytes and inode unchanged");
    tw_free(raw);
    tw_free(old);

    /* 2 controls, then export */
    type_line("own", "/goal OWNEDGOAL");
    type_line("own", "旧输入");
    /* the seeded turn goes to 127.0.0.1:1: refused, retried at 2s and 5s, then ✗ */
    check(tw_wait_text("own", "✗", 15000, pane, sizeof pane), "the seeded turn ends (refused endpoint, after its retries)");
    tw_keys("own", "中文草稿", 1);
    tw_wait_text("own", "中文草稿", 1500, pane, sizeof pane);
    tw_keys("own", "Up", 0);
    tw_sleep_ms(250);
    backspaces("own", 30);
    type_line("own", "/export-state h1");
    tw_wait_text("own", "state saved", 3000, pane, sizeof pane);
    raw = read_all(state);
    check(raw != NULL, "state-v2.json written");
    if (raw) { tx_snprintf(saved, sizeof saved, "%s", raw); tw_free(raw); }
    st_of(journal, &jsize, NULL);
    {
        char want_cwd[800], want_journal[900];
        tx_snprintf(want_cwd, sizeof want_cwd, "\"%s\"", cwd);
        tx_snprintf(want_journal, sizeof want_journal, "{\"path\":\"%s\",\"offset\":%ld}", journal, jsize);
        check(jv_is(saved, "input", "\"\"") && jv_is(saved, "history", "[\"旧输入\"]"), "input empty; history holds the plain line only (no /goal)");
        check(jv_is(saved, "history_draft", "\"中文草稿\"") && jv_is(saved, "goal", "\"OWNEDGOAL\""), "draft and goal saved");
        check(jv_is(saved, "cwd", want_cwd) && jv_is(saved, "role", "\"write\"") && jv_is(saved, "peer", "\"0:owned-test\""), "cwd, role, peer saved");
        check(jv_is(saved, "journal", want_journal), "journal bound to its path and size at export");
        check(jv_is(saved, "loop_left", "0") && jv_is(saved, "loop_on", "false"), "loop is off");
    }
    old = read_all(journal);
    type_line("own", "/exit");
    check(tw_rc("own", 5000) == 0, "/exit exits 0");

    /* 3 three bad snapshots are refused and touch nothing */
    {
        static const char *label[3] = { "identity", "offset", "binding" };
        char other[800];
        tx_snprintf(other, sizeof other, "\"%s/other.jsonl\"", dir);
        for (i = 0; i < 3; i++) {
            char sess[8], *now, *jnow, repl[900];
            const char *v; long vn;
            tx_snprintf(bad, sizeof bad, "%s", saved);
            if (i == 1 && jv(saved, "journal", &v, &vn)) {
                /* {"path":"…","offset":N} -> offset 1 */
                char sub[900];
                tx_snprintf(sub, sizeof sub, "%.*s", (int)vn, v);
                jv_set(sub, "offset", "1", repl, sizeof repl);
                jv_set(saved, "journal", repl, bad, sizeof bad);
            }
            if (i == 2 && jv(saved, "journal", &v, &vn)) {
                char sub[900];
                tx_snprintf(sub, sizeof sub, "%.*s", (int)vn, v);
                jv_set(sub, "path", other, repl, sizeof repl);
                jv_set(saved, "journal", repl, bad, sizeof bad);
            }
            cx_write(state, bad, (size_t)slen(bad));
            sy_chmod(state, 0600);
            tx_snprintf(sess, sizeof sess, "r%d", i);
            start(sess, "resume-agent", dir, state, i == 0 ? "wrong" : "sess", "h1", HASH, 0);
            rc = tw_rc(sess, 8000);
            tw_capture(sess, pane, sizeof pane);
            now = read_all(state);
            jnow = read_all(journal);
            tx_snprintf(msg, sizeof msg, "rejected %s: exit 1, state and journal unchanged%s", label[i],
                     i == 2 ? ", says snapshot journal not bound" : "");
            check(rc == 1 && now && tx_eq(now, bad, CAP) && jnow && old && tx_eq(jnow, old, CAP) &&
                  (i != 2 || has(pane, "snapshot journal not bound")), msg);
            tw_free(now); tw_free(jnow);
        }
    }

    /* 4 resume under wrong env, consume once, export again */
    cx_write(state, saved, (size_t)slen(saved));
    sy_chmod(state, 0600);
    start("res", "resume-agent", dir, state, "sess", "h1", HASH, 1);
    check(tw_wait_text("res", "owned session", 8000, pane, sizeof pane), "resume-agent draws its owned frame");
    tw_sleep_ms(300);
    check(st_of(state, NULL, NULL) != 0, "the snapshot was consumed once (state-v2.json gone)");
    tw_keys("res", "Down", 0);
    check(tw_wait_text("res", "中文草稿", 2000, pane, sizeof pane), "Down brings the saved draft back");
    backspaces("res", 30);
    type_line("res", "/export-state h2");
    tw_wait_text("res", "state saved", 3000, pane, sizeof pane);
    raw = read_all(state);
    if (raw) { tx_snprintf(again, sizeof again, "%s", raw); tw_free(raw); } else again[0] = 0;
    tw_free(old);
    {
        static const char *keys[10] = { "goal", "history", "history_draft", "pending_queue", "loop_on", "loop_left", "cwd", "role", "peer", "journal" };
        int same = again[0] != 0;
        for (i = 0; i < 10; i++)
            if (!jv_same(again, saved, keys[i])) { same = 0; sy_printf("        differs: %s\n", keys[i]); }
        check(same, "h2 matches h1 on goal, history, draft, queue, loop, cwd, role, peer, journal (the wrong env lost)");
        check(jv_is(again, "input", "\"\"") && jv_is(again, "handoff_id", "\"h2\""), "h2: input empty, handoff_id h2");
    }
    type_line("res", "/exit");
    check(tw_rc("res", 5000) == 0, "/exit exits 0 after resume");

    /* 5 */
    check(tx_eq(digest(), d0copy, 200), "product inputs (csih.sh digest) unchanged by the run");

    tw_close();
    if (cx_rmtree(dir) != 0) sy_printf("owned_session: scratch %s left behind\n", dir);
    sy_printf("owned_session: %s (%d failed)\n", fails ? "FAIL" : "PASS", fails);
    return fails ? 1 : 0;
}
