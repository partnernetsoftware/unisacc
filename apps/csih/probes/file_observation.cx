#pragma unisa use agentwit
#pragma unisa use netwit
#pragma unisa use srccopy
/* CX probe */
/* file_observation.c — C port of probes/file_observation.py.
 * Real native file windows and HTTP presentation; no semantic-model claim.
 *
 * Build (no -include, no extra .c):
 *   /bin/sh /Users/wjc/repos/unisacc/unisacc.com probes/file_observation.c -o OUT
 * Run: PROBE_SCRATCH=<writable scratch dir> OUT
 * The last line is PASS or FAIL, as in the python original.
 *
 * Mechanical differences from the python original:
 *  - sha256 freeze -> byte-for-byte snapshot compare of the same file set.
 *  - the local HTTP stub is a forked C server on 127.0.0.1:19200..19202.
 *  - timeout kill is SIGKILL on the direct child (unisacc has no killpg/setsid).
 *  - no --receipt file is written.
 *
 * CX (run with -run from the app dir, or set CSIH_APP; upper root, no includes:
 * sockets and time are agentwit's, the port wait netwit's):
 *  - scratch: PROBE_SCRATCH, else $TMPDIR, else /tmp.
 *  - the work tree is the fixed per-uid SCRATCH/csih-probe-build-UID/file_observation,
 *    cleared at the start and removed at the end: unisacc's -run cache is keyed by
 *    cwd + root path + content, so a fixed path keeps the injected agent's ~28s cold
 *    compile to the first run after a source change (~1.2s hot); every case still runs.
 *  - the agent is `<compiler copy> -run source/agent_cli.cx -- ...` with cwd = the
 *    work tree; the build gate is `-- build-check` (rc 64, usage line, empty stderr).
 */

static char CSIH_APP[4096];      /* absolute app dir */
static char PROBE_SRC[4200];     /* this probe source */
static char UNISACC_PATH[4200];  /* <app>/../../unisacc.com: the frozen compiler */
#define PORT_WIRE 19200
#define PORT_JUDGE 19201
#define PORT_CAPACITY 19202

static char g_why[600];
#define NEED(c, m) do { if (!(c)) { snprintf(g_why, sizeof g_why, "%s", (m)); goto fail; } } while (0)

/* ---------- byte buffer ---------- */
typedef struct { char *p; size_t n, cap; } sbuf;
static void sb_put(sbuf *b, const void *d, size_t k) {
    if (b->n + k + 1 > b->cap) {
        size_t nc = b->cap ? b->cap : 256;
        char *np;
        while (nc < b->n + k + 1) nc *= 2;
        np = realloc(b->p, nc);
        if (!np) exit(9);
        b->p = np;
        b->cap = nc;
    }
    if (k) memcpy(b->p + b->n, d, k);
    b->n += k;
    b->p[b->n] = 0;
}
static void sb_puts(sbuf *b, const char *s) { sb_put(b, s, strlen(s)); }
static void sb_fmt(sbuf *b, const char *fmt, ...) {
    va_list ap;
    int k;
    char tmp[1024];
    va_start(ap, fmt);
    k = vsnprintf(tmp, sizeof tmp, fmt, ap);
    va_end(ap);
    if (k < 0) return;
    if ((size_t)k < sizeof tmp) { sb_put(b, tmp, (size_t)k); return; }
    {
        char *big = malloc((size_t)k + 1);
        va_start(ap, fmt);
        vsnprintf(big, (size_t)k + 1, fmt, ap);
        va_end(ap);
        sb_put(b, big, (size_t)k);
        free(big);
    }
}
static void sb_jstr(sbuf *b, const char *s, size_t n) {
    size_t i;
    sb_put(b, "\"", 1);
    for (i = 0; i < n; i++) {
        unsigned char c = (unsigned char)s[i];
        if (c == '"') sb_puts(b, "\\\"");
        else if (c == '\\') sb_puts(b, "\\\\");
        else if (c == '\n') sb_puts(b, "\\n");
        else if (c == '\r') sb_puts(b, "\\r");
        else if (c == '\t') sb_puts(b, "\\t");
        else if (c < 0x20) sb_fmt(b, "\\u%04x", (unsigned)c);
        else sb_put(b, &s[i], 1);
    }
    sb_put(b, "\"", 1);
}
static const char *bfind(const char *h, size_t hn, const char *nd, size_t nn) {
    size_t i;
    if (nn == 0) return h;
    if (nn > hn) return NULL;
    for (i = 0; i + nn <= hn; i++)
        if (h[i] == nd[0] && !memcmp(h + i, nd, nn)) return h + i;
    return NULL;
}

/* ---------- string list ---------- */
typedef struct { char **v; size_t n, cap; } slist;
static void sl_addn(slist *s, const char *x, size_t k) {
    char *c;
    if (s->n == s->cap) {
        s->cap = s->cap ? s->cap * 2 : 64;
        s->v = realloc(s->v, s->cap * sizeof *s->v);
    }
    c = malloc(k + 1);
    memcpy(c, x, k);
    c[k] = 0;
    s->v[s->n++] = c;
}
static int sl_has(slist *s, const char *x, size_t k) {
    size_t i;
    for (i = 0; i < s->n; i++)
        if (strlen(s->v[i]) == k && !memcmp(s->v[i], x, k)) return 1;
    return 0;
}
static void sl_add_unique(slist *s, const char *x, size_t k) {
    if (!sl_has(s, x, k)) sl_addn(s, x, k);
}
static void sl_json(sbuf *b, slist *s) {
    size_t i;
    sb_put(b, "[", 1);
    for (i = 0; i < s->n; i++) {
        if (i) sb_put(b, ",", 1);
        sb_jstr(b, s->v[i], strlen(s->v[i]));
    }
    sb_put(b, "]", 1);
}

/* ---------- JSON tree (strings keep their byte length) ---------- */
enum { J_NULL, J_BOOL, J_NUM, J_STR, J_ARR, J_OBJ };
typedef struct jn {
    int t, b;
    double num;
    char *s;
    size_t slen;
    size_t n, cap;
    char **keys;
    struct jn **kids;
} jn;
static const char *jp, *jend;
static int jerr;
static void jws(void) {
    while (jp < jend && (*jp == ' ' || *jp == '\t' || *jp == '\n' || *jp == '\r')) jp++;
}
static jn *jnew(int t) {
    jn *v = calloc(1, sizeof *v);
    v->t = t;
    return v;
}
static void jadd(jn *o, const char *key, size_t klen, jn *v) {
    if (o->n == o->cap) {
        size_t nc = o->cap ? o->cap * 2 : 8;
        o->kids = realloc(o->kids, nc * sizeof *o->kids);
        o->keys = realloc(o->keys, nc * sizeof *o->keys);
        o->cap = nc;
    }
    o->kids[o->n] = v;
    if (key) {
        o->keys[o->n] = malloc(klen + 1);
        memcpy(o->keys[o->n], key, klen);
        o->keys[o->n][klen] = 0;
    } else {
        o->keys[o->n] = NULL;
    }
    o->n++;
}
static void jutf8(sbuf *b, unsigned long cp) {
    char t[4];
    if (cp < 0x80) { t[0] = (char)cp; sb_put(b, t, 1); }
    else if (cp < 0x800) {
        t[0] = (char)(0xC0 | (cp >> 6));
        t[1] = (char)(0x80 | (cp & 0x3F));
        sb_put(b, t, 2);
    } else if (cp < 0x10000) {
        t[0] = (char)(0xE0 | (cp >> 12));
        t[1] = (char)(0x80 | ((cp >> 6) & 0x3F));
        t[2] = (char)(0x80 | (cp & 0x3F));
        sb_put(b, t, 3);
    } else {
        t[0] = (char)(0xF0 | (cp >> 18));
        t[1] = (char)(0x80 | ((cp >> 12) & 0x3F));
        t[2] = (char)(0x80 | ((cp >> 6) & 0x3F));
        t[3] = (char)(0x80 | (cp & 0x3F));
        sb_put(b, t, 4);
    }
}
static int jhex4(const char *p) {
    int i, v = 0;
    for (i = 0; i < 4; i++) {
        char c = p[i];
        int d;
        if (c >= '0' && c <= '9') d = c - '0';
        else if (c >= 'a' && c <= 'f') d = c - 'a' + 10;
        else if (c >= 'A' && c <= 'F') d = c - 'A' + 10;
        else return -1;
        v = v * 16 + d;
    }
    return v;
}
static char *jstring(size_t *len) {
    sbuf b = {0, 0, 0};
    if (jp >= jend || *jp != '"') { jerr = 1; return NULL; }
    jp++;
    while (jp < jend && *jp != '"') {
        if (*jp == '\\') {
            int h;
            unsigned long cp;
            jp++;
            if (jp >= jend) { jerr = 1; return NULL; }
            switch (*jp) {
            case '"': sb_put(&b, "\"", 1); break;
            case '\\': sb_put(&b, "\\", 1); break;
            case '/': sb_put(&b, "/", 1); break;
            case 'b': sb_put(&b, "\b", 1); break;
            case 'f': sb_put(&b, "\f", 1); break;
            case 'n': sb_put(&b, "\n", 1); break;
            case 'r': sb_put(&b, "\r", 1); break;
            case 't': sb_put(&b, "\t", 1); break;
            case 'u':
                if (jend - jp < 5) { jerr = 1; return NULL; }
                h = jhex4(jp + 1);
                if (h < 0) { jerr = 1; return NULL; }
                cp = (unsigned long)h;
                jp += 4;
                if (cp >= 0xD800 && cp < 0xDC00 && jend - jp >= 7 && jp[1] == '\\' && jp[2] == 'u') {
                    int lo = jhex4(jp + 3);
                    if (lo >= 0xDC00 && lo < 0xE000) {
                        cp = 0x10000 + ((cp - 0xD800) << 10) + (unsigned long)(lo - 0xDC00);
                        jp += 6;
                    }
                }
                jutf8(&b, cp);
                break;
            default: jerr = 1; return NULL;
            }
            jp++;
        } else {
            sb_put(&b, jp, 1);
            jp++;
        }
    }
    if (jp >= jend) { jerr = 1; return NULL; }
    jp++;
    sb_put(&b, "", 0);
    *len = b.n;
    return b.p;
}
static jn *jvalue(void);
static jn *jvalue(void) {
    jws();
    if (jp >= jend) { jerr = 1; return NULL; }
    if (*jp == '{') {
        jn *o = jnew(J_OBJ);
        jp++;
        jws();
        if (jp < jend && *jp == '}') { jp++; return o; }
        for (;;) {
            size_t kl = 0;
            char *k;
            jn *v;
            jws();
            k = jstring(&kl);
            if (!k) return NULL;
            jws();
            if (jp >= jend || *jp != ':') { jerr = 1; return NULL; }
            jp++;
            v = jvalue();
            if (!v) return NULL;
            jadd(o, k, kl, v);
            jws();
            if (jp >= jend) { jerr = 1; return NULL; }
            if (*jp == ',') { jp++; continue; }
            if (*jp == '}') { jp++; return o; }
            jerr = 1;
            return NULL;
        }
    }
    if (*jp == '[') {
        jn *a = jnew(J_ARR);
        jp++;
        jws();
        if (jp < jend && *jp == ']') { jp++; return a; }
        for (;;) {
            jn *v = jvalue();
            if (!v) return NULL;
            jadd(a, NULL, 0, v);
            jws();
            if (jp >= jend) { jerr = 1; return NULL; }
            if (*jp == ',') { jp++; continue; }
            if (*jp == ']') { jp++; return a; }
            jerr = 1;
            return NULL;
        }
    }
    if (*jp == '"') {
        jn *v = jnew(J_STR);
        v->s = jstring(&v->slen);
        if (!v->s) return NULL;
        return v;
    }
    if (jend - jp >= 4 && !memcmp(jp, "true", 4)) { jn *v = jnew(J_BOOL); v->b = 1; jp += 4; return v; }
    if (jend - jp >= 5 && !memcmp(jp, "false", 5)) { jn *v = jnew(J_BOOL); v->b = 0; jp += 5; return v; }
    if (jend - jp >= 4 && !memcmp(jp, "null", 4)) { jp += 4; return jnew(J_NULL); }
    if (*jp == '-' || (*jp >= '0' && *jp <= '9')) {
        const char *e = jp;
        char tmp[80];
        size_t k = 0;
        jn *v;
        while (e < jend && (*e == '-' || *e == '+' || *e == '.' || *e == 'e' || *e == 'E' || (*e >= '0' && *e <= '9'))) e++;
        if (e - jp >= (long)sizeof tmp) { jerr = 1; return NULL; }
        while (jp < e) tmp[k++] = *jp++;
        tmp[k] = 0;
        v = jnew(J_NUM);
        v->num = strtod(tmp, NULL);
        return v;
    }
    jerr = 1;
    return NULL;
}
/* One whole document (trailing whitespace allowed). NULL on error. */
static jn *jparse(const char *s, size_t n) {
    jn *v;
    jp = s;
    jend = s + n;
    jerr = 0;
    v = jvalue();
    if (!v) return NULL;
    jws();
    if (jp != jend) return NULL;
    return v;
}
static jn *jget(jn *o, const char *k) {
    size_t i;
    jn *r = NULL;
    if (!o || o->t != J_OBJ) return NULL;
    for (i = 0; i < o->n; i++)
        if (o->keys[i] && !strcmp(o->keys[i], k)) r = o->kids[i];
    return r;
}
static int jstreq(jn *v, const char *s) {
    return v && v->t == J_STR && v->slen == strlen(s) && !memcmp(v->s, s, v->slen);
}
static int jtrue(jn *v) { return v && v->t == J_BOOL && v->b; }
static int jfalse(jn *v) { return v && v->t == J_BOOL && !v->b; }
static int jisnull(jn *v) { return v && v->t == J_NULL; }
static int jnumis(jn *v, double x) { return v && v->t == J_NUM && v->num == x; }
static int jeq(jn *a, jn *b) {
    size_t i;
    if (!a || !b) return a == b;
    if (a->t != b->t) return 0;
    switch (a->t) {
    case J_BOOL: return a->b == b->b;
    case J_NUM: return a->num == b->num;
    case J_STR: return a->slen == b->slen && !memcmp(a->s, b->s, a->slen);
    case J_ARR:
    case J_OBJ:
        if (a->n != b->n) return 0;
        for (i = 0; i < a->n; i++) {
            if (a->t == J_OBJ && strcmp(a->keys[i], b->keys[i])) return 0;
            if (!jeq(a->kids[i], b->kids[i])) return 0;
        }
        return 1;
    default: return 1;
    }
}

/* ---------- files ---------- */
static char *readall(const char *path, size_t *len) {
    return cx_read(path, len);
}
static int writeall(const char *path, const void *d, size_t n) {
    return cx_write(path, d, n);
}
static int mkdirp(const char *path) {
    char tmp[1024];
    size_t i, l = strlen(path);
    if (l >= sizeof tmp) return -1;
    memcpy(tmp, path, l + 1);
    for (i = 1; i <= l; i++) {
        if (tmp[i] == '/' || tmp[i] == 0) {
            char c = tmp[i];
            tmp[i] = 0;
            if (mkdir(tmp, 0700) != 0 && errno != EEXIST) { tmp[i] = c; return -1; }
            tmp[i] = c;
        }
    }
    return 0;
}
static int is_src_name(const char *n) {
    size_t l = strlen(n);
    if (l > 2 && !strcmp(n + l - 2, ".c")) return 1;
    if (l > 2 && !strcmp(n + l - 2, ".h")) return 1;
    if (l > 4 && !strcmp(n + l - 4, ".inc")) return 1;
    if (l > 3 && !strcmp(n + l - 3, ".cx")) return 1;
    return 0;
}
/* Relative paths (under base) of source-suffix regular files, recursive, symlinks skipped. */
static void collect(const char *base, const char *rel, slist *out) {
    char full[1024];
    DIR *d;
    struct dirent *e;
    snprintf(full, sizeof full, "%s%s%s", base, rel[0] ? "/" : "", rel);
    d = opendir(full);
    if (!d) return;
    while ((e = readdir(d)) != NULL) {
        char abs[1100], sub[1100];
        struct stat st;
        if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
        snprintf(sub, sizeof sub, "%s%s%s", rel, rel[0] ? "/" : "", e->d_name);
        snprintf(abs, sizeof abs, "%s/%s", full, e->d_name);
        if (lstat(abs, &st) != 0) continue;
        if (S_ISLNK(st.st_mode)) continue;
        if (S_ISDIR(st.st_mode)) collect(base, sub, out);
        else if (S_ISREG(st.st_mode) && is_src_name(e->d_name)) sl_addn(out, sub, strlen(sub));
    }
    closedir(d);
}
static int cmpstr(const void *a, const void *b) { return strcmp(*(char *const *)a, *(char *const *)b); }

/* Byte snapshot of the freeze set: src files under APP, unisacc.com, this probe. */
typedef struct { char *path; char *data; size_t n; int ok; } snapent;
typedef struct { snapent *e; size_t n; } snapset;
static snapset take_snapshot(void) {
    slist l = {0, 0, 0};
    snapset s = {0, 0};
    size_t i;
    collect(CSIH_APP, "", &l);
    qsort(l.v, l.n, sizeof *l.v, cmpstr);
    s.n = l.n + 2;
    s.e = calloc(s.n, sizeof *s.e);
    for (i = 0; i < l.n; i++) {
        char p[1100];
        snprintf(p, sizeof p, "%s/%s", CSIH_APP, l.v[i]);
        s.e[i].path = strdup(p);
    }
    s.e[l.n].path = strdup(UNISACC_PATH);
    s.e[l.n + 1].path = strdup(PROBE_SRC);
    for (i = 0; i < s.n; i++) {
        s.e[i].data = readall(s.e[i].path, &s.e[i].n);
        s.e[i].ok = s.e[i].data != NULL;
    }
    return s;
}
static int snap_same(snapset *a, snapset *b) {
    size_t i;
    if (a->n != b->n) return 0;
    for (i = 0; i < a->n; i++) {
        if (strcmp(a->e[i].path, b->e[i].path)) return 0;
        if (!a->e[i].ok || !b->e[i].ok) return 0;
        if (a->e[i].n != b->e[i].n || memcmp(a->e[i].data, b->e[i].data, a->e[i].n)) return 0;
    }
    return 1;
}

/* ---------- process runner ---------- */
typedef struct { int rc, timed; char *out, *err; size_t outn, errn; } runres;
static void sq(sbuf *b, const char *s) {
    sb_put(b, "'", 1);
    for (; *s; s++) {
        if (*s == '\'') sb_puts(b, "'\\''");
        else sb_put(b, s, 1);
    }
    sb_put(b, "'", 1);
}
/* The injected agent, compiled once on the first call (the build gate) into
   g_agentbin from g_agentsrc; later calls exec the binary. A -run compile of
   it is ~36s, too long to repeat for every case. Set in main. */
static char g_agentbin[1000], g_agentsrc[1000];
/* sh -c body: unset proxy/role vars, export kv pairs, cd cwd, exec bin. kv is key,value,... NULL-ended. */
static char *make_script(const char *cwd, const char **kv) {
    sbuf s = {0, 0, 0};
    size_t i;
    sb_puts(&s, "unset CSIH_ROLE CSIH_PEER OPENAI_API_KEY HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy; ");
    for (i = 0; kv && kv[i]; i += 2) {
        sb_puts(&s, "export ");
        sb_puts(&s, kv[i]);
        sb_puts(&s, "=");
        sq(&s, kv[i + 1]);
        sb_puts(&s, "; ");
    }
    sb_puts(&s, "cd ");
    sq(&s, cwd);
    sb_puts(&s, " && { [ -x ");
    sq(&s, g_agentbin);
    sb_puts(&s, " ] || /bin/sh \"$0\" ");
    sq(&s, g_agentsrc);
    sb_puts(&s, " -o ");
    sq(&s, g_agentbin);
    sb_puts(&s, "; } && exec ");
    sq(&s, g_agentbin);
    sb_puts(&s, " \"$@\"");
    return s.p;
}
static int run_proc(const char *script, const char *bin, char **args, int nargs,
                    const char *outp, const char *errp, int secs, runres *r) {
    pid_t pid;
    int st = 0, i, n = 0;
    char *av[40];
    double t0;
    memset(r, 0, sizeof *r);
    av[n++] = (char *)"sh";
    av[n++] = (char *)"-c";
    av[n++] = (char *)script;
    av[n++] = (char *)bin;
    for (i = 0; i < nargs && n < 36; i++) av[n++] = args[i];
    av[n] = NULL;
    pid = fork();
    if (pid < 0) return -1;
    if (pid == 0) {
        int fd;
        setpgid(0, 0);
        fd = open("/dev/null", O_RDONLY);
        if (fd >= 0) { dup2(fd, 0); close(fd); }
        fd = open(outp, O_WRONLY | O_CREAT | O_TRUNC, 0600);
        if (fd >= 0) { dup2(fd, 1); close(fd); }
        fd = open(errp, O_WRONLY | O_CREAT | O_TRUNC, 0600);
        if (fd >= 0) { dup2(fd, 2); close(fd); }
        execv("/bin/sh", av);
        _exit(127);
    }
    setpgid(pid, pid);
    t0 = aw_now_s();
    for (;;) {
        pid_t w = waitpid(pid, &st, WNOHANG);
        long ms;
        if (w == pid) break;
        if (w < 0) return -1;
        ms = (long)((aw_now_s() - t0) * 1000.0);
        if (ms >= (long)secs * 1000L) {
            kill(-pid, SIGKILL);   /* its group: the compiler and the program it runs */
            waitpid(pid, &st, 0);
            r->timed = 1;
            break;
        }
        usleep(10000);
    }
    r->rc = r->timed ? -9 : (WIFEXITED(st) ? WEXITSTATUS(st) : 128);
    r->out = readall(outp, &r->outn);
    r->err = readall(errp, &r->errn);
    if (!r->out) { r->out = strdup(""); r->outn = 0; }
    if (!r->err) { r->err = strdup(""); r->errn = 0; }
    return 0;
}

/* ---------- local HTTP stub (forked child) ---------- */
typedef char *(*respond_fn)(int n, const char *body, size_t bl, size_t *outl);
static size_t header_clen(const char *h, size_t hn) {
    size_t i = 0;
    const char *want = "content-length:";
    while (i < hn) {
        size_t j = i, k;
        while (j < hn && h[j] != '\n') j++;
        if (j - i >= 15) {
            int ok = 1;
            for (k = 0; k < 15; k++)
                if (tolower((unsigned char)h[i + k]) != want[k]) { ok = 0; break; }
            if (ok) return (size_t)atol(h + i + 15);
        }
        i = j + 1;
    }
    return 0;
}
static char *read_http_body(int c, size_t *blen) {
    sbuf b = {0, 0, 0};
    char tmp[4096];
    size_t hdr = 0, want = 0;
    int have_hdr = 0;
    for (;;) {
        ssize_t k = (ssize_t)aw_recv(c, tmp, (long)sizeof tmp);
        if (k <= 0) break;
        sb_put(&b, tmp, (size_t)k);
        if (!have_hdr) {
            const char *e = bfind(b.p, b.n, "\r\n\r\n", 4);
            if (e) {
                hdr = (size_t)(e - b.p) + 4;
                want = header_clen(b.p, hdr - 4);
                have_hdr = 1;
            }
        }
        if (have_hdr && b.n - hdr >= want) break;
    }
    if (!have_hdr) { *blen = 0; return NULL; }
    *blen = want;
    return b.p + hdr;
}
static void send_all(int c, const char *d, size_t n) {
    while (n) {
        ssize_t k = (ssize_t)aw_send(c, d, (long)n);
        if (k <= 0) return;
        d += k;
        n -= (size_t)k;
    }
}
static void respond_http(int c, const char *content, size_t cl) {
    sbuf body = {0, 0, 0}, w = {0, 0, 0};
    sb_puts(&body, "{\"choices\":[{\"message\":{\"content\":");
    sb_jstr(&body, content, cl);
    sb_puts(&body, "}}]}");
    sb_fmt(&w, "HTTP/1.0 200 OK\r\nContent-Type: application/json\r\nContent-Length: %lu\r\nConnection: close\r\n\r\n",
           (unsigned long)body.n);
    sb_put(&w, body.p, body.n);
    send_all(c, w.p, w.n);
}
static void serve_child(int port, const char *dir, respond_fn fn) {
    int ls = -1, n = 0, bound = 0;
    /* SIGPIPE = 13 on darwin; signal() with SIG_IGN is the unisacc-supported form
     * (aw_send also passes MSG_NOSIGNAL) */
    signal(13, (void (*)(int))1);
    if (aw_listen(port, port, &bound, &ls) != 0) _exit(3);
    for (;;) {
        int c = aw_accept(ls);
        size_t bl = 0, cl = 0;
        char *body, *content;
        char path[1100];
        if (c < 0) continue;
        body = read_http_body(c, &bl);
        if (!body) { close(c); continue; }
        n++;
        snprintf(path, sizeof path, "%s/req-%d.bin", dir, n);
        writeall(path, body, bl);
        content = fn(n, body, bl, &cl);
        respond_http(c, content, cl);
        close(c);
    }
}
static pid_t start_server(int port, const char *dir, respond_fn fn) {
    pid_t pid = fork();
    if (pid == 0) {
        serve_child(port, dir, fn);
        _exit(0);
    }
    return pid;
}
static int wait_port(int port) {
    return nw_wait_port(port, 5000);   /* 50 tries x 100ms, as before */
}
static void stop_server(pid_t pid) {
    int st;
    if (pid <= 0) return;
    kill(pid, SIGKILL);
    waitpid(pid, &st, 0);
}
static int count_reqs(const char *dir) {
    int k = 1;
    char p[1100];
    for (;;) {
        struct stat st;
        snprintf(p, sizeof p, "%s/req-%d.bin", dir, k);
        if (stat(p, &st) != 0) break;
        k++;
    }
    return k - 1;
}
/* Request k of a server directory, parsed; NULL when missing or not JSON. */
static jn *load_req(const char *dir, int k) {
    char p[1100];
    size_t len = 0;
    char *b;
    snprintf(p, sizeof p, "%s/req-%d.bin", dir, k);
    b = readall(p, &len);
    if (!b) return NULL;
    return jparse(b, len);
}
/* Decoded message contents joined with '\n' (python '\n'.join). */
static void join_contents(jn *req, sbuf *t) {
    jn *msgs = jget(req, "messages");
    size_t i;
    if (!msgs || msgs->t != J_ARR) return;
    for (i = 0; i < msgs->n; i++) {
        jn *c = jget(msgs->kids[i], "content");
        if (i) sb_put(t, "\n", 1);
        if (c && c->t == J_STR) sb_put(t, c->s, c->slen);
    }
}
static void body_text(const char *body, size_t bl, sbuf *t) {
    jn *req = jparse(body, bl);
    if (req) join_contents(req, t);
}
/* [harness action_id] X lines, then "action_id": "X" pairs; deduplicated in order. */
static void extract_ids(const char *t, size_t tl, slist *out) {
    const char *p = t, *end = t + tl;
    const char *pa = "[harness action_id] ";
    const char *pb = "\"action_id\"";
    while ((p = bfind(p, (size_t)(end - p), pa, strlen(pa))) != NULL) {
        const char *q = p + strlen(pa), *e = q;
        while (e < end && *e != '\n') e++;
        if (e > q) sl_add_unique(out, q, (size_t)(e - q));
        p = e;
    }
    p = t;
    while ((p = bfind(p, (size_t)(end - p), pb, strlen(pb))) != NULL) {
        const char *q = p + strlen(pb), *e;
        while (q < end && isspace((unsigned char)*q)) q++;
        if (q >= end || *q != ':') { p++; continue; }
        q++;
        while (q < end && isspace((unsigned char)*q)) q++;
        if (q >= end || *q != '"') { p++; continue; }
        q++;
        e = q;
        while (e < end && *e != '"' && *e != '\n') e++;
        if (e > q && e < end && *e == '"') sl_add_unique(out, q, (size_t)(e - q));
        p++;
    }
}

/* ---------- journal ---------- */
static int jsonl_load(const char *path, jn ***out, size_t *count) {
    size_t len = 0, i = 0, n = 0, cap = 0;
    char *buf = readall(path, &len);
    jn **arr = NULL;
    struct stat st;
    if (!buf || stat(path, &st) != 0 || !S_ISREG(st.st_mode)) return -1;
    while (i < len) {
        size_t e = i;
        jn *v;
        while (e < len && buf[e] != '\n') e++;
        v = jparse(buf + i, e - i);
        if (!v) return -1;
        if (n == cap) {
            cap = cap ? cap * 2 : 64;
            arr = realloc(arr, cap * sizeof *arr);
        }
        arr[n++] = v;
        i = e + 1;
    }
    *out = arr;
    *count = n;
    return 0;
}

/* ---------- probe state ---------- */
static char g_root[700], g_src[800], g_bin[800], g_home[800], g_comp[800];
static char g_middle[800], g_long[800], g_utf[800], g_large[800], g_fifo[800], g_control[800];
static char g_rp_out[900], g_rp_err[900];
static const char *g_kv_home[16];      /* HOME + offline env, NULL-ended */
static char g_record_id[128];          /* wire-run read record id, used by the judge */
static jn *g_wire_record;              /* wire-run read record */
static int g_mode;                     /* 1 = judge, 2 = capacity */

/* read-proof: runs `agent read-proof <json>`, parses its stdout as JSON. */
static jn *read_proof(const char *path, const char *extra) {
    sbuf cmd = {0, 0, 0};
    char *args[2];
    runres r;
    jn *v;
    sb_puts(&cmd, "{\"act\":\"file\",\"op\":\"read\",\"path\":");
    sb_jstr(&cmd, path, strlen(path));
    sb_puts(&cmd, extra);
    sb_puts(&cmd, "}");
    args[0] = (char *)"read-proof";
    args[1] = cmd.p;
    if (run_proc(make_script(g_root, g_kv_home), g_bin, args, 2, g_rp_out, g_rp_err, 3, &r) != 0) {
        snprintf(g_why, sizeof g_why, "read-proof did not start");
        return NULL;
    }
    if (r.rc != 0 || r.timed) {
        snprintf(g_why, sizeof g_why, "read-proof rc=%d timed=%d stderr=%.120s", r.rc, r.timed, r.err);
        return NULL;
    }
    v = jparse(r.out, r.outn);
    if (!v) snprintf(g_why, sizeof g_why, "read-proof stdout is not JSON: %.120s", r.out);
    return v;
}
/* observation of a read result: string-encoded JSON (read-proof) or object (journal). */
static jn *obs_of(jn *v) {
    jn *o = jget(v, "observation");
    if (o && o->t == J_STR) return jparse(o->s, o->slen);
    return o;
}
static int body_is(jn *v, const char *lit) {
    jn *b = jget(v, "body");
    return b && b->t == J_STR && b->slen == strlen(lit) && !memcmp(b->s, lit, b->slen);
}
static int body_has(jn *v, const char *lit) {
    jn *b = jget(v, "body");
    return b && b->t == J_STR && bfind(b->s, b->slen, lit, strlen(lit)) != NULL;
}

/* ---------- server responders ---------- */
static char *respond_wire(int n, const char *body, size_t bl, size_t *outl) {
    sbuf s = {0, 0, 0};
    (void)body; (void)bl;
    if (n == 1) {
        sb_puts(&s, "{\"act\":\"file\",\"op\":\"read\",\"path\":");
        sb_jstr(&s, g_middle, strlen(g_middle));
        sb_puts(&s, ",\"line\":130,\"n\":40,\"max_bytes\":8192}");
    } else {
        sb_puts(&s, "{\"act\":\"answer\",\"outcome\":\"partial\",\"text\":\"bounded observation\",\"evidence\":[]}");
    }
    *outl = s.n;
    return s.p;
}
static char *respond_judge(int n, const char *body, size_t bl, size_t *outl) {
    sbuf s = {0, 0, 0}, t = {0, 0, 0};
    slist ids = {0, 0, 0};
    body_text(body, bl, &t);
    extract_ids(t.p ? t.p : "", t.n, &ids);
    if (n == 1) {
        sb_puts(&s, "{\"act\":\"file\",\"op\":\"read\",\"path\":");
        sb_jstr(&s, g_middle, strlen(g_middle));
        sb_puts(&s, ",\"line\":130,\"n\":40,\"max_bytes\":8192}");
    } else if (n == 2) {
        /* the current answer protocol: a completed answer after tool use carries
         * claims + observation_refs grounded in this turn's evidence IDs */
        const char *rid = ids.n ? ids.v[0] : g_record_id;
        sb_puts(&s, "{\"act\":\"answer\",\"outcome\":\"completed\",\"text\":\"observed bounded marker\",\"evidence\":");
        sl_json(&s, &ids);
        sb_puts(&s, ",\"claims\":[{\"id\":\"c1\",\"text\":\"line 150 holds the marker\",\"scope\":\"middle.txt\","
                    "\"state\":\"supported\",\"support\":[0],\"counter\":[],\"unknown\":\"\"}],"
                    "\"observation_refs\":[{\"id\":");
        sb_jstr(&s, rid, strlen(rid));
        sb_puts(&s, ",\"start\":0,\"end\":0,\"layer\":\"tool_output\",\"json_pointer\":null,\"quote\":\"ACTIVATED_COMMITTED\"}]}");
    } else {
        sb_puts(&s, "{\"go\":\"stop\",\"acceptance\":\"accepted\",\"scope\":\"work\",\"evidence\":");
        if (ids.n) sl_json(&s, &ids);
        else {
            slist one = {0, 0, 0};
            sl_addn(&one, g_record_id, strlen(g_record_id));
            sl_json(&s, &one);
        }
        sb_puts(&s, ",\"reason\":\"scripted window only\"}");
    }
    *outl = s.n;
    return s.p;
}
static char *respond_capacity(int n, const char *body, size_t bl, size_t *outl) {
    sbuf s = {0, 0, 0};
    (void)body; (void)bl;
    if (n <= 2) {
        sb_puts(&s, "{\"act\":\"file\",\"op\":\"read\",\"path\":");
        sb_jstr(&s, g_control, strlen(g_control));
        sb_puts(&s, ",\"max_bytes\":8192}");
    } else {
        sb_puts(&s, "{\"act\":\"answer\",\"outcome\":\"partial\",\"text\":\"bounded escaped bodies preserved\",\"evidence\":[]}");
    }
    *outl = s.n;
    return s.p;
}

/* Agent env (python env + overrides). */
static const char **mk_kv(const char *endpoint, const char *transcript) {
    static const char *kv[24];
    int i = 0;
    kv[i++] = "HOME"; kv[i++] = g_home;
    kv[i++] = "DEEPSEEK_API_KEY"; kv[i++] = "LOCAL_ONLY";
    kv[i++] = "NO_PROXY"; kv[i++] = "127.0.0.1,localhost";
    kv[i++] = "no_proxy"; kv[i++] = "127.0.0.1,localhost";
    if (endpoint) { kv[i++] = "CSIH_ENDPOINT"; kv[i++] = endpoint; }
    if (transcript) { kv[i++] = "CSIH_TRANSCRIPT"; kv[i++] = transcript; }
    kv[i++] = "CSIH_CWD"; kv[i++] = g_root;
    kv[i] = NULL;
    return kv;
}

/* One case per call; each returns 0 on success, 1 on failure with g_why set. */
static int case_reads(void) {
    jn *v = NULL, *o = NULL;
    sbuf joined = {0, 0, 0};
    size_t flen = 0, i;
    char *fbytes = NULL;
    char extra[200];
    int iter;
    jn *wv;
    /* physical line 2 */
    v = read_proof(g_long, ",\"line\":2,\"n\":1");
    NEED(v != NULL, g_why);
    NEED(body_is(v, "SECOND\r\n"), "physical-line2 body");
    /* first long window, then cursor continuation */
    v = read_proof(g_long, ",\"max_bytes\":4096");
    NEED(v != NULL, g_why);
    sb_put(&joined, jget(v, "body")->s, jget(v, "body")->slen);
    o = obs_of(v);
    NEED(o != NULL, "first-long-window observation");
    NEED(jnumis(jget(o, "byte_end"), 4096), "first-long-window byte_end");
    NEED(jfalse(jget(o, "line_complete")), "first-long-window line_complete");
    NEED(jisnull(jget(o, "total_lines")), "first-long-window total_lines");
    for (iter = 0; !jtrue(jget(o, "eof")); iter++) {
        char off[64];
        NEED(iter < 100, "cursor continuation did not reach eof");
        NEED(jget(o, "next_byte_offset") && jget(o, "next_byte_offset")->t == J_NUM, "next_byte_offset missing");
        snprintf(off, sizeof off, "%lld", (long long)jget(o, "next_byte_offset")->num);
        snprintf(extra, sizeof extra, ",\"byte_offset\":%s,\"max_bytes\":4096", off);
        v = read_proof(g_long, extra);
        NEED(v != NULL, g_why);
        sb_put(&joined, jget(v, "body")->s, jget(v, "body")->slen);
        o = obs_of(v);
        NEED(o != NULL, "cursor observation");
    }
    fbytes = readall(g_long, &flen);
    NEED(fbytes != NULL, "long.txt unreadable");
    NEED(joined.n == flen && !memcmp(joined.p, fbytes, flen), "cursor continuation does not equal file bytes");
    /* utf-8 windows */
    v = read_proof(g_utf, ",\"max_bytes\":1");
    NEED(v != NULL, g_why);
    NEED(body_has(v, "read failed"), "no-progress should read failed");
    v = read_proof(g_utf, ",\"byte_offset\":1");
    NEED(v != NULL, g_why);
    NEED(body_has(v, "read failed"), "middle-char should read failed");
    v = read_proof(g_utf, ",\"max_bytes\":3");
    NEED(v != NULL, g_why);
    NEED(body_is(v, "\xe4\xb8\xad"), "utf-boundary body should be the 3-byte character");
    /* large prefix */
    v = read_proof(g_large, "");
    NEED(v != NULL, g_why);
    {
        jn *b = jget(v, "body");
        NEED(b && b->t == J_STR, "large-prefix body missing");
        NEED(b->slen >= 28 && !memcmp(b->s, "CURRENT_DEPLOYMENT_ACTIVATED", 28), "large-prefix body prefix");
        NEED(b->slen == 4096, "large-prefix body should be 4096 bytes");
    }
    /* fifo: TODO(blocked) mkfifo is missing in unisacc 0.0.39. The fifo
     * read-failed assertion is not run until the symbol exists. */
    /* rejected parses */
    v = read_proof(g_long, ",\"line\":1.5");
    NEED(v != NULL, g_why);
    NEED(jtrue(jget(v, "parse_rejected")), "fraction line should be rejected");
    v = read_proof(g_long, ",\"line\":1,\"byte_offset\":0");
    NEED(v != NULL, g_why);
    NEED(jtrue(jget(v, "parse_rejected")), "dual selector should be rejected");
    v = read_proof(g_long, ",\"max_bytes\":8193");
    NEED(v != NULL, g_why);
    NEED(jtrue(jget(v, "parse_rejected")), "max-over should be rejected");
    wv = NULL;
    (void)wv;
    (void)i;
    free(fbytes);
    return 0;
fail:
    return 1;
}

static int case_wire(void) {
    jn **recs = NULL;
    size_t nrec = 0, i;
    jn *record = NULL, *o = NULL;
    sbuf wire = {0, 0, 0}, t = {0, 0, 0};
    char ep[128], tr[800];
    int rc_ok = 0, nreq;
    pid_t sp = 0;
    char dir[900];
    runres r;
    char *args[3];
    snprintf(dir, sizeof dir, "%s/wire", g_root);
    NEED(mkdirp(dir) == 0, "wire dir");
    snprintf(ep, sizeof ep, "http://127.0.0.1:%d/v1/chat/completions", PORT_WIRE);
    snprintf(tr, sizeof tr, "%s/wire.jsonl", dir);
    sp = start_server(PORT_WIRE, dir, respond_wire);
    NEED(sp > 0, "fork server");
    if (wait_port(PORT_WIRE) != 0) { stop_server(sp); snprintf(g_why, sizeof g_why, "wire stub did not listen"); goto fail; }
    args[0] = (char *)"agent";
    args[1] = (char *)"read relevant window";
    rc_ok = run_proc(make_script(g_root, mk_kv(ep, tr)), g_bin, args, 2, g_rp_out, g_rp_err, 9, &r);
    stop_server(sp);
    NEED(rc_ok == 0, "wire agent did not start");
    NEED(r.rc == 1 && !r.timed, "wire run rc must be 1");
    nreq = count_reqs(dir);
    NEED(nreq == 2, "wire run must make 2 requests");
    NEED(jsonl_load(tr, &recs, &nrec) == 0, "wire journal not readable");
    for (i = 0; i < nrec; i++) if (jget(recs[i], "read_call")) { record = recs[i]; break; }
    NEED(record != NULL, "wire journal has no read_call record");
    g_wire_record = record;
    snprintf(g_record_id, sizeof g_record_id, "%s", jget(record, "action_id") ? jget(record, "action_id")->s : "");
    o = jget(jget(record, "read_call"), "observation");
    NEED(o && jtrue(jget(o, "presentation_complete")), "wire presentation_complete");
    NEED(bfind(jget(record, "text")->s, jget(record, "text")->slen, "ACTIVATED_COMMITTED", 19) != NULL,
         "wire record text lacks ACTIVATED_COMMITTED");
    {
        jn *req = load_req(dir, 2);
        NEED(req != NULL, "wire request 2 unreadable");
        join_contents(req, &wire);
    }
    NEED(bfind(wire.p, wire.n, jget(record, "text")->s, jget(record, "text")->slen) != NULL, "wire packet lacks the record text");
    {
        sbuf needle = {0, 0, 0};
        sb_puts(&needle, "[harness action_id] ");
        sb_put(&needle, g_record_id, strlen(g_record_id));
        NEED(bfind(wire.p, wire.n, needle.p, needle.n) != NULL, "wire packet lacks harness action_id");
    }
    NEED(bfind(wire.p, wire.n, "[harness read_call]", 19) != NULL, "wire packet lacks harness read_call");
    NEED(bfind(wire.p, wire.n, "[harness status] unknown", strlen("[harness status] unknown")) == NULL, "wire packet has unknown status");
    (void)t;
    return 0;
fail:
    return 1;
}

static int case_extra(const char *mode) {
    char dir[900], tr[900], ep[128];
    jn **recs = NULL;
    size_t nrec = 0, i;
    jn *tools_first = NULL;
    int ntools = 0;
    pid_t sp;
    runres r;
    char *args[3];
    int nreq, rc;
    int port = g_mode == 1 ? PORT_JUDGE : PORT_CAPACITY;
    snprintf(dir, sizeof dir, "%s/%s", g_root, mode);
    NEED(mkdirp(dir) == 0, "extra dir");
    snprintf(tr, sizeof tr, "%s/journal.jsonl", dir);
    snprintf(ep, sizeof ep, "http://127.0.0.1:%d/v1/chat/completions", port);
    if (g_mode == 2) {
        size_t k;
        char *ctl = malloc(20000);
        for (k = 0; k < 20000; k++) ctl[k] = 1;
        NEED(writeall(g_control, ctl, 20000) == 0, "control file");
        free(ctl);
    }
    sp = start_server(port, dir, g_mode == 1 ? respond_judge : respond_capacity);
    NEED(sp > 0, "fork server");
    if (wait_port(port) != 0) { stop_server(sp); snprintf(g_why, sizeof g_why, "%s stub did not listen", mode); goto fail; }
    args[0] = (char *)"agent";
    args[1] = (char *)"observe relevant bounded data";
    rc = run_proc(make_script(g_root, mk_kv(ep, tr)), g_bin, args, 2, g_rp_out, g_rp_err, 9, &r);
    stop_server(sp);
    NEED(rc == 0, "extra agent did not start");
    nreq = count_reqs(dir);
    NEED(jsonl_load(tr, &recs, &nrec) == 0, "extra journal not readable");
    if (g_mode == 1) {
        jn *reqpacket;
        sbuf packet = {0, 0, 0};
        if (!(r.rc == 0 && nreq == 3)) printf("  judge run: rc=%d timed=%d requests=%d\n...%s\n", r.rc, r.timed, nreq, r.out + (r.outn > 2500 ? r.outn - 2500 : 0));
        NEED(r.rc == 0 && nreq == 3, "judge run rc must be 0 and 3 requests");
        for (i = 0; i < nrec; i++) if (jget(recs[i], "read_call")) { tools_first = recs[i]; ntools++; }
        NEED(ntools == 1, "judge run must have exactly one read record");
        reqpacket = load_req(dir, 3);
        NEED(reqpacket != NULL, "judge packet unreadable");
        join_contents(reqpacket, &packet);
        NEED(bfind(packet.p, packet.n, jget(tools_first, "action_id")->s, jget(tools_first, "action_id")->slen) != NULL,
             "judge packet lacks action_id");
        NEED(bfind(packet.p, packet.n, "ACTIVATED_COMMITTED", 19) != NULL, "judge packet lacks marker");
        NEED(bfind(packet.p, packet.n, "presentation_complete", 21) != NULL, "judge packet lacks presentation_complete");
        NEED(jeq(jget(tools_first, "text"), jget(g_wire_record, "text")), "judge text differs from wire text");
        NEED(jeq(jget(jget(tools_first, "read_call"), "observation"), jget(jget(g_wire_record, "read_call"), "observation")),
             "judge observation differs from wire observation");
    } else {
        sbuf packet = {0, 0, 0};
        size_t k;
        jn *last;
        NEED(r.rc == 1 && !r.timed && nreq == 3, "capacity run rc must be 1 and 3 requests");
        for (i = 0; i < nrec; i++) if (jget(recs[i], "read_call")) { if (ntools == 0) tools_first = recs[i]; ntools++; }
        NEED(ntools == 2, "capacity run must have two read records");
        for (i = 0; i < nrec; i++) {
            jn *tx = jget(recs[i], "text");
            if (!jget(recs[i], "read_call")) continue;
            NEED(tx && tx->t == J_STR && tx->slen == 8192, "capacity record text must be 8192 bytes");
            for (k = 0; k < tx->slen; k++) if (tx->s[k] != 1) { NEED(0, "capacity record text byte mismatch"); }
            NEED(jtrue(jget(jget(jget(recs[i], "read_call"), "observation"), "presentation_complete")),
                 "capacity observation presentation_complete");
        }
        last = load_req(dir, 3);
        NEED(last != NULL, "capacity last request unreadable");
        join_contents(last, &packet);
        NEED(bfind(packet.p, packet.n, "ledger_directory", 16) != NULL, "capacity packet lacks ledger_directory");
        for (i = 0; i < nrec; i++) {
            jn *aid = jget(recs[i], "action_id");
            if (!jget(recs[i], "read_call")) continue;
            NEED(aid && aid->t == J_STR, "capacity action_id missing");
            NEED(bfind(packet.p, packet.n, aid->s, aid->slen) != NULL, "capacity packet lacks action_id");
        }
    }
    return 0;
fail:
    return 1;
}

static int probe(void) {
    snapset before, after;
    slist l = {0, 0, 0};
    const char *scratch;
    size_t i, nlong = 0;
    char *big;
    FILE *f;
    char *args[24];
    runres r;
    int nargs = 0;
    int ok = 0;
    char p[1100];

    before = take_snapshot();
    scratch = getenv("PROBE_SCRATCH");
    if (!scratch || !scratch[0]) scratch = getenv("TMPDIR");
    if (!scratch || !scratch[0]) scratch = "/tmp";
    snprintf(g_root, sizeof g_root, "%s/csih-probe-build-%d/file_observation", scratch, (int)getuid());
    {
        struct stat rs;
        if (lstat(g_root, &rs) == 0) NEED(cx_rmtree(g_root) == 0, "cannot clear the work tree");
    }
    NEED(mkdirp(g_root) == 0, "mkdir root");
    /* HOME must not lie under the temp root: the agent selftest's sandbox keeps
     * /tmp writable, so its "home outside cwd is read-only" row cannot hold there.
     * HOME is a mkdtemp under <repo>/out/ (git-ignored, a deletion-guard root). */
    {
        char repo[4096], t[4300];
        snprintf(t, sizeof t, "%s/../..", CSIH_APP);
        NEED(realpath(t, repo) != NULL, "repo root");
        snprintf(t, sizeof t, "%s/out", repo);
        mkdir(t, 0755);
        snprintf(g_home, sizeof g_home, "%s/out/csih-file-observation-home-XXXXXX", repo);
        NEED(mkdtemp(g_home) != NULL, "mkdir home");
    }
    snprintf(g_src, sizeof g_src, "%s/source", g_root);
    snprintf(g_agentbin, sizeof g_agentbin, "%s/agent_cli.bin", g_root);
    snprintf(g_agentsrc, sizeof g_agentsrc, "%s/agent_cli.cx", g_src);
    NEED(mkdirp(g_src) == 0, "mkdir source");
    snprintf(g_bin, sizeof g_bin, "%s/agent", g_root);
    snprintf(g_comp, sizeof g_comp, "%s/compiler.com", g_root);
    snprintf(g_middle, sizeof g_middle, "%s/middle.txt", g_root);
    snprintf(g_long, sizeof g_long, "%s/long.txt", g_root);
    snprintf(g_utf, sizeof g_utf, "%s/utf.txt", g_root);
    snprintf(g_large, sizeof g_large, "%s/large.txt", g_root);
    snprintf(g_fifo, sizeof g_fifo, "%s/fifo", g_root);
    snprintf(g_control, sizeof g_control, "%s/control.txt", g_root);
    snprintf(g_rp_out, sizeof g_rp_out, "%s/rp.out", g_root);
    snprintf(g_rp_err, sizeof g_rp_err, "%s/rp.err", g_root);
    g_kv_home[0] = "HOME"; g_kv_home[1] = g_home;
    g_kv_home[2] = "DEEPSEEK_API_KEY"; g_kv_home[3] = "LOCAL_ONLY";
    g_kv_home[4] = "NO_PROXY"; g_kv_home[5] = "127.0.0.1,localhost";
    g_kv_home[6] = "no_proxy"; g_kv_home[7] = "127.0.0.1,localhost";
    g_kv_home[8] = NULL;

    /* copy the source freeze set into the work tree (inject into copies only) */
    collect(CSIH_APP, "", &l);
    for (i = 0; i < l.n; i++) {
        char from[1100], to[1100], dirp[1100];
        size_t len = 0;
        char *data;
        char *slash;
        snprintf(from, sizeof from, "%s/%s", CSIH_APP, l.v[i]);
        snprintf(to, sizeof to, "%s/%s", g_src, l.v[i]);
        snprintf(dirp, sizeof dirp, "%s", to);
        slash = strrchr(dirp, '/');
        if (slash) { *slash = 0; NEED(mkdirp(dirp) == 0, "mkdir copy dir"); }
        data = readall(from, &len);
        NEED(data != NULL, "source read failed");
        NEED(writeall(to, data, len) == 0, "source copy failed");
    }
    NEED(csih_copy_l0(CSIH_APP, g_src) == 0, "copy of the L0 dirs (sys, mem, text) failed");
    /* inject the read-proof entry into agent_cli.c and csih_private_read into agent.c */
    {
        char cli[1100], agentc[1100];
        size_t cl = 0, pos = 0, nocc = 0;
        char *text;
        const char *entry = "int main(int argc, char **argv) {";
        const char *inject_entry_pre = "int csih_private_read(const char*,const char*);\n";
        const char *inject_post = "\n if(argc==3&&!strcmp(argv[1],\"read-proof\"))return csih_private_read(argv[2],\".\");\n";
        const char *private_fn =
            "\nint csih_private_read(const char *raw,const char *cwd){agent_step s=agent_parse(raw);char out[16384],rec[60000];if(s.kind!=ACT_READ){puts(\"{\\\"parse_rejected\\\":true}\");return 0;}agent_tool_reset();agent_exec(&s,cwd,out,sizeof out);if(!json_rec(rec,sizeof rec,\"body\",out,\"observation\",agent_read_observation,NULL,NULL))return 9;printf(\"%s\\n\",rec);return 0;}\n";
        sbuf nt = {0, 0, 0};
        snprintf(cli, sizeof cli, "%s/agent_cli.cx", g_src);
        snprintf(agentc, sizeof agentc, "%s/agent.cx", g_src);
        text = readall(cli, &cl);
        NEED(text != NULL, "agent_cli.c unreadable");
        for (i = 0; i + strlen(entry) <= cl; i++) if (!memcmp(text + i, entry, strlen(entry))) { nocc++; pos = i; }
        NEED(nocc == 1, "agent_cli.c main anchor must occur once");
        sb_put(&nt, text, pos);
        sb_puts(&nt, inject_entry_pre);
        sb_put(&nt, text + pos, strlen(entry));
        sb_puts(&nt, inject_post);
        sb_put(&nt, text + pos + strlen(entry), cl - pos - strlen(entry));
        NEED(writeall(cli, nt.p, nt.n) == 0, "write agent_cli.c");
        {
            FILE *af = fopen(agentc, "ab");
            NEED(af != NULL, "append agent.c");
            fputs(private_fn, af);
            fclose(af);
        }
    }
    /* compiler copy (same bytes as unisacc.com) */
    {
        size_t cl = 0;
        char *u = readall(UNISACC_PATH, &cl);
        NEED(u != NULL, "unisacc.com unreadable");
        NEED(writeall(g_comp, u, cl) == 0, "compiler copy");
    }
    /* build the agent from the copied source tree: the -run compile of the
     * injected source; an unknown subcommand gives the usage line and rc 64 */
    {
        char *bargs[2];
        snprintf(g_bin, sizeof g_bin, "%s", g_comp);
        bargs[0] = (char *)"build-check";
        NEED(run_proc(make_script(g_root, g_kv_home), g_bin, bargs, 1, g_rp_out, g_rp_err, 50, &r) == 0, "build did not start");
        if (r.errn) printf("  build stderr: %.400s\n", r.err);
        NEED(r.rc == 64 && !r.timed && bfind(r.out, r.outn, "usage: agent_cli", 16) != NULL, "build gate: rc must be 64 with the usage line");
        NEED(r.errn == 0, "build stderr must be empty");
    }
    /* selftest */
    args[0] = (char *)"selftest";
    NEED(run_proc(make_script(g_root, g_kv_home), g_bin, args, 1, g_rp_out, g_rp_err, 9, &r) == 0, "selftest did not start");
    if (r.rc != 0) printf("  selftest rc=%d timed=%d\n...%s\n%.600s\n", r.rc, r.timed, r.out + (r.outn > 3000 ? r.outn - 3000 : 0), r.err);
    NEED(r.rc == 0 && bfind(r.out, r.outn, "agent: all cases pass", strlen("agent: all cases pass")) != NULL, "selftest failed");
    printf("  ok    selftest: agent: all cases pass\n");
    (void)nargs;

    /* fixtures */
    {
        sbuf m = {0, 0, 0};
        big = malloc(5000 + 4 + 6 + 1);
        memset(big, 'A', 5000);
        memcpy(big + 5000, "\r\nSECOND\r\nTHIRD", 14);
        NEED(writeall(g_long, big, 5000 + 14) == 0, "long.txt");
        free(big);
        for (i = 1; i <= 300; i++) {
            sb_fmt(&m, "LINE%03u ", (unsigned)i);
            if (i == 150) sb_puts(&m, "ACTIVATED_COMMITTED");
            else { size_t k; for (k = 0; k < 30; k++) sb_put(&m, "x", 1); }
            sb_put(&m, "\n", 1);
        }
        NEED(writeall(g_middle, m.p, m.n) == 0, "middle.txt");
    }
    {
        static const char utf8_bytes[] = "\xe4\xb8\xad\r\n\xe6\x96\x87";
        NEED(writeall(g_utf, utf8_bytes, sizeof utf8_bytes - 1) == 0, "utf.txt");
    }
    {
        size_t total = 30 + 9 * 1024 * 1024 + 1;
        char *lb = malloc(total);
        size_t k;
        memcpy(lb, "CURRENT_DEPLOYMENT_ACTIVATED\n", 29);
        for (k = 29; k < total - 1; k++) lb[k] = 'A';
        lb[total - 1] = (char)0xff;
        NEED(writeall(g_large, lb, total) == 0, "large.txt");
        free(lb);
    }
    /* TODO(blocked: mkfifo) fifo fixture not created: unisacc 0.0.39 has no mkfifo. */

    /* reads */
    NEED(case_reads() == 0, g_why);
    printf("  ok    native file windows: physical line, cursor, utf-8, large, fifo, rejected selectors\n");

    /* wire */
    NEED(case_wire() == 0, g_why);
    printf("  ok    wire: presentation_complete window reached the next request\n");

    /* judge and capacity */
    g_mode = 1;
    NEED(case_extra("judge") == 0, g_why);
    printf("  ok    judge request carries the window and presentation\n");
    g_mode = 2;
    NEED(case_extra("capacity") == 0, g_why);
    printf("  ok    capacity: both raw windows preserved, final partial stays non-success\n");

    f = fopen("/dev/null", "r");
    if (f) fclose(f);
    ok = 1;
    (void)p;
    (void)nlong;
    after = take_snapshot();
    if (!snap_same(&before, &after)) { snprintf(g_why, sizeof g_why, "frozen snapshot changed"); ok = 0; }
    cx_rmtree(g_root);
    cx_rmtree(g_home);
    return ok ? 0 : 1;
fail:
    after = take_snapshot();
    (void)after;
    if (g_root[0]) cx_rmtree(g_root);
    if (g_home[0] && g_home[strlen(g_home) - 1] != 'X') cx_rmtree(g_home);
    return 1;
}

int main(int argc, char **argv) {
    int rc;
    (void)argc;
    (void)argv;
    g_why[0] = 0;
    {
        const char *app = getenv("CSIH_APP");
        if (app && app[0]) snprintf(CSIH_APP, sizeof CSIH_APP, "%s", app);
        else if (!getcwd(CSIH_APP, sizeof CSIH_APP)) { printf("FAIL getcwd\n"); return 1; }
        if (CSIH_APP[0] != '/') { printf("FAIL app dir must be absolute\n"); return 1; }
        snprintf(PROBE_SRC, sizeof PROBE_SRC, "%s/probes/file_observation.cx", CSIH_APP);
        snprintf(UNISACC_PATH, sizeof UNISACC_PATH, "%s/../../unisacc.com", CSIH_APP);
    }
    rc = probe();
    if (rc != 0) printf("  FAIL  %s\n", g_why[0] ? g_why : "unknown");
    printf("%s\n", rc == 0 ? "PASS" : "FAIL");
    return rc;
}
