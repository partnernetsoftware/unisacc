#pragma unisa use u_run
#pragma unisa use netwit
/* llm_roundtrip.cx — llm.c against probes/llm_stub.cx (run with -run, so the
 * stub needs ~4s to compile before it listens). No gcc, no python.
 *   unisacc probes/llm_roundtrip.cx
 * Upper root: no #include (sockets are netwit's).
 */

static int wait_port(int port) {
    return nw_wait_port(port, 20000);   /* 20s: the stub is compiled first */
}

static int contains(const char *path, const char *needle) {
    FILE *f = fopen(path, "r");
    char buf[4096];
    size_t n;
    if (!f) return 0;
    n = fread(buf, 1, sizeof buf - 1, f);
    fclose(f);
    buf[n] = 0;
    return strstr(buf, needle) != NULL;
}

int main(void) {
    const char *u = getenv("UNISACC");
    const char *stub = "probes/llm_stub.cx";
    char dir[64], tr[96], url[64], out[2048];
    char *pav[7], *args[12];
    int rc, st;
    pid_t pid;
    if (!u || !u[0]) u = "../../unisacc.com";   /* cwd is apps/csih */
    if (access(stub, 0) != 0) stub = "llm_stub.cx";
    snprintf(dir, sizeof dir, "/tmp/cdsh-llm-%d", (int)getpid());
    snprintf(tr, sizeof tr, "%s/session.jsonl", dir);
    if (mkdir(dir, 0700) != 0) { printf("no temp\n"); return 2; }
    pid = fork();
    if (pid == 0) {
        pav[0] = (char *)"sh"; pav[1] = (char *)u; pav[2] = (char *)"-run"; pav[3] = (char *)stub;
        pav[4] = (char *)"--"; pav[5] = (char *)"18938"; pav[6] = NULL;
        execv("/bin/sh", pav);   /* APE needs /bin/sh as its loader */
        _exit(127);
    }
    if (wait_port(18938) != 0) { u_stop(pid); printf("  FAIL  stub did not listen\n"); return 1; }
    snprintf(url, sizeof url, "http://127.0.0.1:18938/");
    args[0] = (char *)"-run"; args[1] = (char *)"llm_cli.cx";
    args[2] = (char *)"--"; args[3] = (char *)"run"; args[4] = url;
    args[5] = tr; args[6] = (char *)"hello from cdsh"; args[7] = (char *)"0.5";
    u_spawn(u, args, 8, NULL, out, (int)sizeof out, &rc);
    u_stop(pid); waitpid(pid, &st, 0);
    printf("  unisacc: %.200s (rc=%d)\n", out, rc);
    if (rc != 0) { printf("  FAIL  rc\n"); return 1; }
    if (!strstr(out, "decision=continue") || !strstr(out, "p=0.8300")) {
        printf("  FAIL  verdict\n"); return 1;
    }
    printf("  ok    the reply's p became a continue verdict\n");
    if (!strstr(out, "appended=1")) { printf("  FAIL  not appended\n"); return 1; }
    printf("  ok    the model record was written back\n");
    if (!contains(tr, "\"role\":\"model\"") || !contains(tr, "\"p\":0.8300")) {
        printf("  FAIL  transcript\n"); return 1;
    }
    printf("  ok    the transcript holds the model record\n");
    return 0;
}
