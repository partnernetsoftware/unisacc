#pragma unisa use u_run
/* run.cx — run leaf fixture probes under unisacc -run. No gcc, no -o.
 * Upper root: no #include (unistd is in the cx prelude). */

static const char *leaf[] = {
    "probes/fs-open.cx", "probes/fs-stat.cx", "probes/tty-raw.cx", "probes/tty-size.cx",
    "probes/poll-mux.cx", "probes/dns.cx", "probes/net-tcp.cx",
    "probes/tui-q5-signal.cx", "probes/tui-terms.cx", "probes/tui-q5-sigaction.cx",
    "probes/net/alone.cx", "probes/net/withwait.cx", "probes/net/roundtrip.cx", "probes/net/dns.cx",
};

int main(void) {
    const char *u = getenv("UNISACC");
    char out[400], line[120];
    int i, rc;
    if (!u || !u[0]) u = "../../unisacc.com";
    for (i = 0; i < (int)(sizeof leaf / sizeof leaf[0]); i++) {
        char *args[4];
        size_t k = 0;
        int narg;
        const char *name = strrchr(leaf[i], '/');
        name = name ? name + 1 : leaf[i];
        if (access(leaf[i], 0) != 0) { printf("%-24s missing\n", name); continue; }
        args[0] = (char *)"-run";
        args[1] = (char *)leaf[i];
        if (strstr(leaf[i], "tui-terms")) {
            args[2] = (char *)"--";
            args[3] = (char *)"q1-cfmakeraw";
            narg = 4;
        } else {
            narg = 2;
        }
        u_spawn(u, args, narg, NULL, out, (int)sizeof out, &rc);
        while (out[k] && out[k] != '\n' && k + 1 < sizeof line) { line[k] = out[k]; k++; }
        line[k] = 0;
        printf("%-24s rc=%-3d %s\n", name, rc, line[0] ? line : "<no output>");
    }
    return 0;
}
