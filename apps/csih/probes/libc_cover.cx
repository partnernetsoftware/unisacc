#pragma unisa use u_run
/*
 * libc_cover.cx — errno + libc name coverage in TWO unisacc compiles (not ~70).
 * Exit 1 if any errno name or function is missing.
 * Upper root: no #include; the generated sources under test carry the
 * includes being measured. Scratch goes through cx_rmtree (the guard).
 */

static const char *errnames[] = {
    "EPERM","ENOENT","ESRCH","EINTR","EIO","ENXIO","E2BIG","ENOEXEC","EBADF",
    "ECHILD","EAGAIN","ENOMEM","EACCES","EFAULT","EBUSY","EEXIST","EXDEV",
    "ENODEV","ENOTDIR","EISDIR","EINVAL","ENFILE","EMFILE","ENOTTY","ETXTBSY",
    "EFBIG","ENOSPC","ESPIPE","EROFS","EMLINK","EPIPE","EDOM","ERANGE",
    "EDEADLK","ENAMETOOLONG","ENOLCK","ENOSYS","ENOTEMPTY","ELOOP","ENOTSUP",
    "EOVERFLOW","ECANCELED","EILSEQ",
};

static const char *fn[] = {
    "fsync","rmdir","access","readlink","symlink","dup","fdopen","rename",
    "unlink","mkdir","lseek","ftruncate","chmod","fstat","isatty","getenv",
    "getpid","fork","waitpid","getcwd","strftime","localtime_r","telldir",
    "execl","execlp","execvp","pipe","dup2",
};

static int write_all(const char *path, const char *body) {
    FILE *f = fopen(path, "w");
    if (!f) return -1;
    if (fputs(body, f) < 0) { fclose(f); return -1; }
    return fclose(f) != 0 ? -1 : 0;
}

int main(void) {
    const char *u = getenv("UNISACC");
    const char *td = getenv("TMPDIR");
    char dir[512], src[600], out[4000], body[12000];
    int i, n, rc, miss = 0, fmiss = 0, off;
    char *args[1];
    if (!u || !u[0]) u = "../../unisacc.com";
    snprintf(dir, sizeof dir, "%s/cdsh-libc-%d", td && td[0] ? td : "/tmp", (int)getpid());
    if (mkdir(dir, 0700) != 0) { printf("no temp\n"); return 2; }
    snprintf(src, sizeof src, "%s/c.c", dir);
    args[0] = src;

    /* One compile: every errno prints its value. */
    off = snprintf(body, sizeof body,
        "#include <stdio.h>\n#include <errno.h>\nint main(void){\n");
    n = (int)(sizeof errnames / sizeof errnames[0]);
    for (i = 0; i < n && off + 80 < (int)sizeof body; i++)
        off += snprintf(body + off, sizeof body - (size_t)off,
            "  printf(\"%%s=%%d\\n\", \"%s\", (int)%s);\n", errnames[i], errnames[i]);
    off += snprintf(body + off, sizeof body - (size_t)off, "  return 0;\n}\n");
    (void)off;
    if (write_all(src, body) != 0) { printf("errno write fail\n"); return 2; }
    u_spawn(u, args, 1, NULL, out, (int)sizeof out, &rc);
    printf("── errno constants ──\n");
    printf("  MISSING:");
    for (i = 0; i < n; i++) {
        char key[64];
        snprintf(key, sizeof key, "%s=", errnames[i]);
        if (rc != 0 || !strstr(out, key)) { miss++; printf(" %s", errnames[i]); }
    }
    printf("\n  defined: %d / %d\n", n - miss, n);

    /* One compile: every function referenced in a never-taken branch. */
    off = snprintf(body, sizeof body,
        "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n"
        "#include <unistd.h>\n#include <time.h>\n#include <dirent.h>\n"
        "#include <errno.h>\n#include <fcntl.h>\n#include <signal.h>\n"
        "#include <sys/stat.h>\n#include <sys/types.h>\n#include <sys/wait.h>\n"
        "int main(void){\n"
        "  char *av[2]; int pfd[2]; av[0]=(char*)\"sh\"; av[1]=0;\n"
        "  if (0) {\n");
    n = (int)(sizeof fn / sizeof fn[0]);
    for (i = 0; i < n && off + 120 < (int)sizeof body; i++) {
        static const char *call[] = {
            "fsync(0)", "rmdir(\"/tmp/nope\")", "access(\"/tmp\",0)",
            "readlink(\"/tmp\",0,0)", "symlink(\"a\",\"b\")", "dup(0)",
            "fdopen(0,\"r\")", "rename(\"/tmp/a\",\"/tmp/b\")",
            "unlink(\"/tmp/nope\")", "mkdir(\"/tmp/nope\",0755)",
            "lseek(0,0,0)", "ftruncate(0,0)", "chmod(\"x\",0644)",
            "fstat(0,0)", "isatty(0)", "getenv(\"PATH\")", "getpid()",
            "fork()", "waitpid(0,0,0)", "getcwd(0,0)",
            "strftime(0,0,\"\",0)", "localtime_r(0,0)", "telldir(0)",
            "execl(\"/bin/sh\",\"sh\",\"-c\",\"true\",(char*)0)",
            "execlp(\"sh\",\"sh\",\"-c\",\"true\",(char*)0)",
            "execvp(\"sh\",av)", "pipe(pfd)", "dup2(0,0)",
        };
        off += snprintf(body + off, sizeof body - (size_t)off, "    (void)(%s);\n", call[i]);
    }
    off += snprintf(body + off, sizeof body - (size_t)off, "  }\n  return 0;\n}\n");
    (void)off;
    if (write_all(src, body) != 0) { printf("fn write fail\n"); return 2; }
    u_spawn(u, args, 1, NULL, out, (int)sizeof out, &rc);
    printf("── functions ──\n");
    if (rc != 0 || strstr(out, "undefined function") || strstr(out, "not covered") || strstr(out, "error")) {
        fmiss = n;
        printf("  BATCH FAIL: %s\n", out);
    } else {
        for (i = 0; i < n; i++) printf("  ok       %s\n", fn[i]);
    }
    printf("Functions listed: %d. Missing: %d. Errno missing: %d.\n", n, fmiss, miss);
    if (cx_rmtree(dir) != 0)
        fprintf(stderr, "libc_cover: scratch %s left behind\n", dir);
    return (miss || fmiss) ? 1 : 0;
}
