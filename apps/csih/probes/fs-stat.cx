#pragma unisa module fs-stat
/* Lower: a runtime-surface probe — the carried <sys/stat.h> is what it tests; the implicit prelude
   includes it, so this module writes no #include (only the bottom layer does). */
/* 读出文件大小与 mtime。 */
int main(int argc, char **argv) {
    const char *p = argc > 1 ? argv[1] : "/tmp";
    struct stat s;
    if (stat(p, &s) != 0) { printf("UNAVAILABLE stat\n"); return 1; }
    printf("ok size %ld\n", (long)s.st_size);
    return 0;
}
