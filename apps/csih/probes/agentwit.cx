#pragma unisa module agentwit
#pragma unisa use sys.net
#pragma unisa use sys.time
/*
 * agentwit.cx — what the csih agent/net probe roots need beyond the cx prelude,
 * so those roots stay include-free (upper modules: pragma only).
 * Lower (a csih probe adapter): sockets, clocks and file times are cx/sys
 * (probes/sys); no #include. No fd is closed here: the caller owns every
 * descriptor these return and closes it itself.
 *
 * aw_listen(lo, hi, &port, &fd)  a socket listening on the first free port of
 *                                127.0.0.1:[lo,hi]; 0 ok, -1 not (*fd is -1 then)
 * aw_accept(fd)                  the next connection (blocking), or < 0
 * aw_recv(fd, buf, n)            bytes read, 0 at end, < 0 on error
 * aw_send(fd, buf, n)            all N bytes with MSG_NOSIGNAL (a vanished peer
 *                                must not kill the stub: signal() cannot
 *                                ignore SIGPIPE under unisacc); N, or -1
 * aw_time()                      wall-clock seconds
 * aw_now_s()                     seconds on the monotonic clock (for durations
 *                                and deadlines, which is all the callers use it for)
 * aw_utime(path, t)              atime = mtime = t; 0, or < 0
 */

int aw_listen(int lo, int hi, int *port, int *fd) {
    int p;
    *fd = -1;
    for (p = lo; p <= hi; p++) {
        int s = sy_tcp_listen(p, 16);
        if (s >= 0) { *fd = s; *port = p; return 0; }
    }
    return -1;
}

int aw_accept(int fd) { return sy_tcp_accept(fd, -1); }

long aw_recv(int fd, void *buf, long n) { return sy_recv(fd, buf, n); }

long aw_send(int fd, const void *buf, long n) { return sy_send_all(fd, buf, n) == 0 ? n : -1; }

long aw_time(void) { return sy_wall_s(); }

double aw_now_s(void) { return (double)sy_now_ms() / 1000.0; }

int aw_utime(const char *path, long t) { return sy_set_mtime(path, t); }
