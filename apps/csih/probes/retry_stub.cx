#pragma unisa module retry_stub
#pragma unisa use sys.net
#pragma unisa use sys.time
#pragma unisa use sys.proc
#pragma unisa use sys.fs
/*
 * retry_stub.cx — scripted chat/completions stand-in for the retry probe.
 * Lower (a csih probe adapter): sockets, clocks and processes are cx/sys
 * (probes/sys); its own log files use the prelude's open/write. No #include.
 *
 * rs_stub_start(port, script, log): the Nth POST gets the Nth token of the
 * comma list SCRIPT ("503,200", "~P,R,S"; tokens at rs_status_at); past the
 * end every POST gets 200. A 200 body has the DeepSeek shape and an answer
 * (or {"go":"stop"} for the round-end question). Each served status is
 * appended to LOG, one per line, so the probe counts what csih really sent;
 * the Nth request body is saved as LOG.reqN. The child exits after 40s.
 */

#define RS_REQ 262144

long rs_now_ms(void);

/* The Nth token: a status, or a 200 with a scripted reply (returned negative):
 *   x  exec `echo stub-exec`        -200
 *   P  exec `pwd`                   -201
 *   R  answer RESUME_DONE           -202
 *   S  {"go":"stop"}                -203
 *   V  a completed answer RESUME_DONE in the current protocol: evidence,
 *      claims and observation_refs naming the first "[harness action_id]"
 *      of the request                  -204
 *   J  the judge's accepted stop citing that id   -205
 * A leading '~' delays that reply by 500ms (*DELAY set). */
static int rs_status_at(const char *script, int n, int *delay) {
    const char *p = script;
    int i = 0;
    *delay = 0;
    while (p && *p) {
        if (i == n) {
            if (*p == '~') { *delay = 1; p++; }
            switch (*p) {
            case 'x': return -200;
            case 'P': return -201;
            case 'R': return -202;
            case 'S': return -203;
            case 'V': return -204;
            case 'J': return -205;
            default: return atoi(p);
            }
        }
        p = strchr(p, ',');
        if (p) p++;
        i++;
    }
    return 200;
}

static void rs_write_all(int fd, const char *b, size_t n) {
    while (n) {
        ssize_t k = write(fd, b, n);
        if (k <= 0) return;
        b += k; n -= (size_t)k;
    }
}

static void rs_serve_one(int c, const char *script, int n, const char *log) {
    static char req[RS_REQ];
    char head[256], body[2048];
    size_t have = 0, want = 0, hdr_end = 0;
    int got_hdr = 0, status, fd, delay;
    ssize_t k;
    for (;;) {
        if (have + 1 >= RS_REQ) break;
        k = sy_recv(c, req + have, (long)(RS_REQ - 1 - have));
        if (k <= 0) break;
        have += (size_t)k;
        req[have] = 0;
        if (!got_hdr) {
            char *e = strstr(req, "\r\n\r\n"), *cl;
            if (e) {
                got_hdr = 1;
                hdr_end = (size_t)(e - req) + 4;
                cl = strstr(req, "Content-Length:");
                if (!cl) cl = strstr(req, "content-length:");
                if (cl) want = (size_t)strtoul(cl + 15, NULL, 10);
            }
        }
        if (got_hdr && have >= hdr_end + want) break;
    }
    status = rs_status_at(script, n, &delay);
    {
        /* the request body, for probes that check what csih sent: LOG.reqN */
        char rp[700];
        snprintf(rp, sizeof rp, "%s.req%d", log, n);
        fd = open(rp, O_WRONLY | O_CREAT | O_TRUNC, 0600);
        if (fd >= 0) { if (have > hdr_end) rs_write_all(fd, req + hdr_end, have - hdr_end); close(fd); }
    }
    if (delay) sy_sleep_ms(500);
    if (status == -204 || status == -205) {
        /* the first action id the harness put in the request (JSON-escaped: it ends at "\n") */
        /* V cites the action id the request names; J cites the same one (the
         * judge request also carries older ids, so it is remembered, not re-read). */
        static char cited[96] = "none";
        char id[96], content[1200];
        const char *a = status == -204 ? strstr(req + hdr_end, "[harness action_id] ") : NULL;
        if (a) {
            size_t i = 0;
            a += 20;
            while (a[i] && a[i] != '\\' && a[i] != '"' && i + 1 < sizeof cited) { cited[i] = a[i]; i++; }
            cited[i] = 0;
        }
        snprintf(id, sizeof id, "%s", cited);
        if (status == -204)
            snprintf(content, sizeof content,
                     "{\\\"act\\\":\\\"answer\\\",\\\"outcome\\\":\\\"completed\\\",\\\"text\\\":\\\"RESUME_DONE\\\",\\\"evidence\\\":[\\\"%s\\\"],"
                     "\\\"claims\\\":[{\\\"id\\\":\\\"c1\\\",\\\"text\\\":\\\"pwd ran in the restored cwd\\\",\\\"scope\\\":\\\"cwd\\\","
                     "\\\"state\\\":\\\"supported\\\",\\\"support\\\":[0],\\\"counter\\\":[],\\\"unknown\\\":\\\"\\\"}],"
                     "\\\"observation_refs\\\":[{\\\"id\\\":\\\"%s\\\",\\\"start\\\":0,\\\"end\\\":0,\\\"layer\\\":\\\"tool_output\\\",\\\"json_pointer\\\":null}]}",
                     id, id);
        else
            snprintf(content, sizeof content,
                     "{\\\"go\\\":\\\"stop\\\",\\\"acceptance\\\":\\\"accepted\\\",\\\"scope\\\":\\\"work\\\",\\\"evidence\\\":[\\\"%s\\\"],\\\"reason\\\":\\\"scripted\\\"}", id);
        status = 200;
        snprintf(body, sizeof body,
                 "{\"id\":\"stub\",\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"%s\"}}],"
                 "\"usage\":{\"prompt_tokens\":10,\"completion_tokens\":2,\"total_tokens\":12}}", content);
    } else if (status == 200 || status <= -200) {
        const char *content = status == -201 ? "{\\\"act\\\":\\\"exec\\\",\\\"cmd\\\":\\\"pwd\\\",\\\"why\\\":\\\"verify snapshot cwd\\\"}"
                            : status == -202 ? "{\\\"act\\\":\\\"answer\\\",\\\"text\\\":\\\"RESUME_DONE\\\"}"
                            : status == -203 || strstr(req, "Decide only: continue") ? "{\\\"go\\\":\\\"stop\\\"}"
                            : status == -200 ? "{\\\"act\\\":\\\"exec\\\",\\\"cmd\\\":\\\"echo stub-exec\\\",\\\"why\\\":\\\"探针\\\"}"
                                             : "{\\\"act\\\":\\\"answer\\\",\\\"text\\\":\\\"完成了\\\"}";
        status = 200;
        snprintf(body, sizeof body,
                 "{\"id\":\"stub\",\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"%s\"}}],"
                 "\"usage\":{\"prompt_tokens\":10,\"completion_tokens\":2,\"total_tokens\":12}}", content);
    } else {
        snprintf(body, sizeof body, "{\"error\":{\"message\":\"injected %d\"}}", status);
    }
    snprintf(head, sizeof head,
             "HTTP/1.1 %d X\r\nContent-Type: application/json\r\nContent-Length: %d\r\nConnection: close\r\n\r\n",
             status, (int)strlen(body));
    fd = open(log, O_WRONLY | O_CREAT | O_APPEND, 0600);
    if (fd >= 0) { char line[48]; snprintf(line, sizeof line, "%d %ld\n", status, rs_now_ms()); rs_write_all(fd, line, strlen(line)); close(fd); }
    sy_send_all(c, head, (long)strlen(head));   /* MSG_NOSIGNAL: a client that left cannot kill the stub */
    sy_send_all(c, body, (long)strlen(body));
}

/* Child pid, or -1. The socket listens before the fork, so no start race. */
int rs_stub_start(int port, const char *script, const char *log) {
    int s = sy_tcp_listen(port, 8);
    pid_t pid;
    if (s < 0) return -1;
    pid = fork();
    if (pid < 0) { sy_close(s); return -1; }
    if (pid == 0) {
        long end = sy_now_ms() + 40000;
        int n = 0;
        while (sy_now_ms() < end) {
            int c = sy_tcp_accept(s, 500);
            if (c < 0) continue;
            rs_serve_one(c, script, n++, log);
            sy_close(c);
        }
        _exit(0);
    }
    sy_close(s);
    return (int)pid;
}

void rs_stop(int pid) {
    if (pid > 0) sy_kill(pid);
}

void rs_sleep_ms(int ms) { sy_sleep_ms(ms); }

long rs_now_ms(void) { return sy_now_ms(); }

int rs_pid(void) { return sy_pid(); }

/* argv[0] via PATH; stdout+stderr into OUT (NUL-terminated, may be NULL).
 * Exit code, or -1 when it could not run or died by a signal. */
int rs_run(char **argv, char *out, int cap) {
    int cut, r = sy_run(argv, out, cap, &cut);
    return r >= 0 && r < 128 ? r : -1;
}

/* Served statuses in LOG, comma-joined into OUT; the count. AT[i] is when
 * the i-th request was served (monotonic ms), up to NAT of them. */
int rs_posts(const char *log, char *out, int cap, long *at, int nat) {
    char buf[1024], *p, *nl;
    int fd = open(log, O_RDONLY), n = 0, j = 0;
    ssize_t k;
    if (cap > 0) out[0] = 0;
    if (fd < 0) return 0;
    k = read(fd, buf, sizeof buf - 1);
    close(fd);
    if (k <= 0) return 0;
    buf[k] = 0;
    for (p = buf; (nl = strchr(p, '\n')) != NULL; p = nl + 1) {
        char *sp = strchr(p, ' ');
        if (!sp || sp > nl) break;
        if (n < nat) at[n] = atol(sp + 1);
        j += snprintf(out + j, j < cap ? (size_t)(cap - j) : 0, "%s%.*s", n ? "," : "", (int)(sp - p), p);
        if (j >= cap) j = cap - 1;
        n++;
    }
    return n;
}
