#pragma unisa use text.fmt
#pragma unisa use text.num
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use tmuxwit
#pragma unisa use retry_stub
/*
 * turn_latency.cx — how long one agent turn waits on the TUI loop itself.
 *   cd apps/csih && sh ../../unisacc.com probes/turn_latency.cx [MAX_FIRST_MS MAX_STEP_MS]
 *
 * Three installed-csih agent TUIs (private tmux, scratch HOME), each with a
 * retry_stub scripted "x,200,200,200": the 1st reply asks for
 * `echo stub-exec`, later replies answer 完成了 (or stop the round). The stub
 * stamps every request; the probe stamps Enter and the answer on screen.
 *   first  = Enter -> 1st request          (local work + loop wait)
 *   step   = 1st request -> 2nd request    (reply, a ~5ms exec, loop waits)
 *   answer = Enter -> 完成了 on screen
 * Each is the median of the three. With limits given, PASS needs
 * first <= MAX_FIRST_MS and step <= MAX_STEP_MS; without, it only reports.
 */

#define NCASE 3

static long median3(long a, long b, long c) {
    if (a > b) { long t = a; a = b; b = t; }
    if (b > c) { long t = b; b = c; c = t; }
    if (a > b) { long t = a; a = b; b = t; }
    return b;
}

int main(int argc, char **argv) {
    static char pane[65536];
    const char *bin = sy_env("CSIH_BIN"), *tmp = sy_env("TMPDIR");
    char cwd[512], absbin[700], root[600], home[NCASE][700], log[NCASE][700], sess[NCASE][8], served[256];
    long t_enter[NCASE], t_answer[NCASE], first[NCASE], step[NCASE], answer[NCASE], at[8];
    int stub[NCASE], i, pid = rs_pid(), ok = 1, port0 = 33000 + (rs_pid() % 3000) * 3;
    long max_first = argc > 2 ? tx_atol(argv[1]) : 0, max_step = argc > 2 ? tx_atol(argv[2]) : 0;

    if (!getcwd(cwd, sizeof cwd)) return 2;
    if (!bin || !bin[0]) { tx_snprintf(absbin, sizeof absbin, "%s/../../out/csih-e2e-bin/csih", cwd); bin = absbin; }
    if (access(bin, X_OK) != 0) { sy_printf("turn_latency: no csih binary at %s (csih.sh prepare)\n", bin); return 2; }
    if (!tw_open("lat")) { sy_printf("turn_latency: tmux is not on PATH\n"); return 2; }
    tx_snprintf(root, sizeof root, "%s/csih-lat-%d", tmp && tmp[0] ? tmp : "/tmp", pid);
    if (mkdir(root, 0700) != 0) { sy_printf("turn_latency: mkdir %s failed\n", root); return 2; }

    for (i = 0; i < NCASE; i++) {
        char e_home[760], e_ep[160], e_cwd[760];
        tx_snprintf(home[i], sizeof home[i], "%s/h%d", root, i);
        tx_snprintf(log[i], sizeof log[i], "%s/posts%d.txt", root, i);
        tx_snprintf(sess[i], sizeof sess[i], "l%d", i);
        mkdir(home[i], 0700);
        stub[i] = rs_stub_start(port0 + i, "x,200,200,200", log[i]);
        tx_snprintf(e_home, sizeof e_home, "HOME=%s", home[i]);
        tx_snprintf(e_ep, sizeof e_ep, "CSIH_ENDPOINT=http://127.0.0.1:%d/v1/chat/completions", port0 + i);
        tx_snprintf(e_cwd, sizeof e_cwd, "CSIH_CWD=%s", home[i]);
        {
            char *cmd[] = { "env", e_home, e_ep, e_cwd, "CSIH_MODEL=stub", "CSIH_BELL=0", (char *)bin, "agent" };
            if (stub[i] < 0 || tw_new(sess[i], 140, 45, home[i], cmd, 8) != 0) { sy_printf("FAIL case %d: setup\n", i); ok = 0; stub[i] = -1; }
        }
    }
    for (i = 0; i < NCASE; i++) {
        int k;
        if (stub[i] < 0) continue;
        if (!tw_wait_text(sess[i], "Enter 发送", 8000, pane, sizeof pane)) { sy_printf("FAIL case %d: TUI not ready\n", i); ok = 0; stub[i] = -1; continue; }
        for (k = 0; k < 3; k++) {
            tw_keys(sess[i], "hi", 1);
            if (tw_wait_text(sess[i], "> hi", 1500, pane, sizeof pane)) break;
            tw_keys(sess[i], "C-u", 0);
        }
    }
    tw_sleep_ms(300);   /* no key may follow Enter: a key would wake the loop and hide its wait */
    for (i = 0; i < NCASE; i++) {
        if (stub[i] < 0) continue;
        tw_keys(sess[i], "Enter", 0);
        t_enter[i] = tw_now_ms();
        t_answer[i] = 0;
    }
    {
        long until = tw_now_ms() + 10000;
        int open = 1;
        while (open && tw_now_ms() < until) {
            open = 0;
            for (i = 0; i < NCASE; i++) {
                if (stub[i] < 0 || t_answer[i]) continue;
                tw_capture(sess[i], pane, sizeof pane);
                if (strstr(pane, "完成了")) t_answer[i] = tw_now_ms();
                else open = 1;
            }
            tw_sleep_ms(20);
        }
    }
    tw_sleep_ms(500);   /* let a trailing round-end request land */
    for (i = 0; i < NCASE; i++) {
        int n;
        first[i] = step[i] = answer[i] = 99999;
        if (stub[i] < 0) continue;
        n = rs_posts(log[i], served, sizeof served, at, 8);
        if (n >= 1) first[i] = at[0] - t_enter[i];
        if (n >= 2) step[i] = at[1] - at[0];
        if (t_answer[i]) answer[i] = t_answer[i] - t_enter[i];
        sy_printf("case %d: requests=%d first_ms=%ld step_ms=%ld answer_ms=%ld\n", i, n, first[i], step[i], answer[i]);
        if (n < 2 || !t_answer[i]) ok = 0;
    }
    {
        long f = median3(first[0], first[1], first[2]);
        long s = median3(step[0], step[1], step[2]);
        long a = median3(answer[0], answer[1], answer[2]);
        if (max_first && f > max_first) ok = 0;
        if (max_step && s > max_step) ok = 0;
        sy_printf("%s turn_latency median first_ms=%ld step_ms=%ld answer_ms=%ld%s\n", ok ? "PASS" : "FAIL", f, s, a,
               max_first ? "" : " (report only)");
    }
    tw_close();
    for (i = 0; i < NCASE; i++) rs_stop(stub[i]);
    if (cx_rmtree(root) != 0) sy_printf("turn_latency: scratch %s left behind\n", root);
    return ok ? 0 : 1;
}
