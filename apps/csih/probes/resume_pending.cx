#pragma unisa use tmuxwit
#pragma unisa use retry_stub
#pragma unisa use text.text
/*
 * resume_pending.cx — a resumed owned session with a pending prompt and an
 * unsent draft, against a local scripted model; ported from the archived
 * probes/resume_pending.py (archive/reference-py/apps/csih/probes/).
 *   cd apps/csih && sh ../../unisacc.com probes/resume_pending.cx
 *
 * A v2 snapshot names a restored cwd/role/peer/journal, the draft
 * "未发送中文稿", one queued prompt QUEUED_RESUME, history and a goal. The
 * installed csih resumes it (resume-agent) under a WRONG CSIH_CWD/ROLE/PEER/
 * TRANSCRIPT; retry_stub answers "~P,V,J" (500ms, then exec pwd, answer
 * RESUME_DONE with evidence, the judge's accepted stop). Same assertions as
 * the Python original:
 *   - the queued prompt runs while the draft stays: "-EDIT" typed during the
 *     turn lands after it ("未发送中文稿-EDIT" on screen)
 *   - the owned title shows the restored role (csih · 写)
 *   - exactly 3 requests (the loop budget is not reset)
 *   - the journal has one user record, text QUEUED_RESUME
 *   - request 1's system message names the restored role and peer
 *     ("写手。同伴 0:restored-peer")
 *   - the pwd tool record is exactly "cwd=<restored>\nexit=0\n<restored>\n"
 *   - the unrelated transcript is untouched and the snapshot was consumed
 *   - /export-state after keeps goal, history, history_draft, cwd, role,
 *     peer; pending_queue [], loop_left 0, loop_on false, input ""
 *   - /exit: still 3 requests; product inputs (csih.sh digest) unchanged
 * Upper root (L3): no #include, no direct libc calls.
 */

#define CAP 65536
#define HASH "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

static char pane[CAP], seen[CAP * 4];
static int fails;

static long slen(const char *s) { return tx_len(s, CAP * 4); }
static int has(const char *hay, const char *needle) { return hay && tx_find(hay, slen(hay), needle, slen(needle)) >= 0; }
static void check(int ok, const char *what) {
    printf("  %s  %s\n", ok ? "ok  " : "FAIL", what);
    if (!ok) fails++;
}
static void note(void) {
    long n = slen(seen), m = slen(pane);
    if (n + m + 2 < (long)sizeof seen) { tx_copy(seen + n, (long)sizeof seen - n, pane, m); seen[n + m] = '\n'; seen[n + m + 1] = 0; }
}

static int jv(const char *j, const char *key, const char **v, long *vn) {
    char pat[96];
    long at, i, n = slen(j);
    int depth = 0, str = 0;
    snprintf(pat, sizeof pat, "\"%s\":", key);
    at = tx_find(j, n, pat, slen(pat));
    if (at < 0) return 0;
    i = at + slen(pat);
    *v = j + i;
    for (; i < n; i++) {
        char c = j[i];
        if (str) { if (c == '\\') i++; else if (c == '"') str = 0; continue; }
        if (c == '"') str = 1;
        else if (c == '{' || c == '[') depth++;
        else if (c == '}' || c == ']') { if (!depth) break; depth--; }
        else if (c == ',' && !depth) break;
    }
    *vn = (j + i) - *v;
    return 1;
}
static int jv_same(const char *a, const char *b, const char *key) {
    const char *va, *vb; long an, bn;
    return jv(a, key, &va, &an) && jv(b, key, &vb, &bn) && tx_same(va, an, vb, bn);
}
static int jv_is(const char *j, const char *key, const char *want) {
    const char *v; long vn;
    return jv(j, key, &v, &vn) && tx_same(v, vn, want, slen(want));
}

static char *digest(char *o, int cap) {
    char *av[] = { "sh", "csih.sh", "digest", NULL };
    long at;
    tw_run(av, o, cap);
    at = tx_find(o, slen(o), "digest ", 7);
    return at >= 0 ? o + at : o;
}

static int count_lines_with(const char *text, const char *needle, char *last, int cap) {
    long n = slen(text), i = 0;
    int c = 0;
    while (i < n) {
        long e = tx_chr(text + i, n - i, '\n');
        long len = e < 0 ? n - i : e;
        if (tx_find(text + i, len, needle, slen(needle)) >= 0) {
            c++;
            if (last) snprintf(last, cap, "%.*s", (int)len, text + i);
        }
        i += len + 1;
    }
    return c;
}

int main(void) {
    static char snapshot[8192], saved[CAP], d0[4096], d1[4096];
    const char *bin = tw_env("CSIH_BIN"), *tmp = tw_env("TMPDIR");
    char here[600], absbin[700], dir[600], cwd[700], wrong[700], home[700], journal[700], other[700], state[700], log[700];
    char e_home[760], e_cwd[760], e_tr[760], e_ep[160], user[2048], want[2400], req0[760];
    char *raw, *jtext, *otext, *body0, *d0p;
    long at[8];
    char served[256];
    int stub, port, n, rc;

    if (!getcwd(here, sizeof here)) return 2;
    if (!bin || !bin[0]) { snprintf(absbin, sizeof absbin, "%s/../../out/csih-e2e-bin/csih", here); bin = absbin; }
    if (tw_stat(bin, NULL, NULL) != 0) { printf("resume_pending: no csih binary at %s (csih.sh prepare)\n", bin); return 2; }
    if (!tw_open("resume")) { printf("resume_pending: tmux is not on PATH\n"); return 2; }
    d0p = digest(d0, sizeof d0);
    snprintf(d1, sizeof d1, "%.200s", d0p);

    snprintf(dir, sizeof dir, "%s/csih-resume-%d", tmp && tmp[0] ? tmp : "/tmp", (int)getpid());
    snprintf(cwd, sizeof cwd, "%s/restored-cwd", dir);
    snprintf(wrong, sizeof wrong, "%s/wrong-cwd", dir);
    snprintf(home, sizeof home, "%s/private-home", dir);
    snprintf(journal, sizeof journal, "%s/journal.jsonl", dir);
    snprintf(other, sizeof other, "%s/unrelated.jsonl", dir);
    snprintf(state, sizeof state, "%s/state-v2.json", dir);
    snprintf(log, sizeof log, "%s/posts.txt", dir);
    if (tw_mkdir(dir) || tw_mkdir(cwd) || tw_mkdir(wrong) || tw_mkdir(home)) { printf("resume_pending: scratch %s\n", dir); return 2; }
    cx_write(journal, "", 0); tw_chmod(journal, 0600);
    cx_write(other, "UNCHANGED", 9);
    snprintf(snapshot, sizeof snapshot,
        "{\"version\":2,\"session_id\":\"sess\",\"handoff_id\":\"pending\",\"candidate_hash\":\"%s\","
        "\"goal\":\"RESTORED_GOAL\",\"loop_on\":true,\"loop_left\":0,\"cwd\":\"%s\",\"role\":\"write\",\"peer\":\"0:restored-peer\","
        "\"journal\":{\"path\":\"%s\",\"offset\":0},\"input\":\"未发送中文稿\",\"pending_queue\":[\"QUEUED_RESUME\"],"
        "\"history\":[\"HISTORIC\"],\"history_pos\":1,\"history_browsing\":false,\"history_draft\":\"历史草稿\"}",
        HASH, cwd, journal);
    cx_write(state, snapshot, (size_t)slen(snapshot)); tw_chmod(state, 0600);

    port = 24000 + (int)getpid() % 20000;
    /* the original stub answered with bare text; today an answer after tool
     * use must carry evidence, claims and observation_refs, or it ends the
     * turn as unverified with no judge round (2 requests, not 3). V and J
     * are that answer and the judge's accepted stop: same 3-request turn. */
    stub = rs_stub_start(port, "~P,V,J", log);
    if (stub < 0) { printf("resume_pending: stub cannot listen on %d\n", port); return 2; }
    snprintf(e_home, sizeof e_home, "HOME=%s", home);
    snprintf(e_cwd, sizeof e_cwd, "CSIH_CWD=%s", wrong);
    snprintf(e_tr, sizeof e_tr, "CSIH_TRANSCRIPT=%s", other);
    snprintf(e_ep, sizeof e_ep, "CSIH_ENDPOINT=http://127.0.0.1:%d/v1/chat/completions", port);
    {
        char *cmd[] = { "env", "-u", "http_proxy", "-u", "https_proxy", "-u", "HTTP_PROXY", "-u", "HTTPS_PROXY",
                        "-u", "all_proxy", "-u", "ALL_PROXY", "-u", "OPENAI_API_KEY",
                        e_home, e_cwd, e_tr, e_ep, "CSIH_ROLE=watch", "CSIH_PEER=wrong-peer", "CSIH_MODEL=local-stub",
                        "NO_PROXY=127.0.0.1,localhost", "no_proxy=127.0.0.1,localhost", "DEEPSEEK_API_KEY=LOCAL_STUB_ONLY",
                        "sh", "-c", "\"$0\" \"$@\"; echo __RC=$?__; sleep 30",
                        (char *)bin, "resume-agent", dir, state, "sess", "pending", HASH };
        if (tw_new("r", 120, 35, NULL, cmd, (int)(sizeof cmd / sizeof cmd[0])) != 0) { printf("resume_pending: tmux new-session\n"); return 2; }
    }
    /* first request in flight (the stub holds it 500ms): type into the draft */
    {
        long until = tw_now_ms() + 10000;
        while (rs_posts(log, served, sizeof served, at, 8) < 1 && tw_now_ms() < until) tw_sleep_ms(20);
    }
    tw_keys("r", "-EDIT", 1);
    {
        long until = tw_now_ms() + 15000;
        while (tw_now_ms() < until) {
            tw_capture("r", pane, sizeof pane);
            note();
            if (rs_posts(log, served, sizeof served, at, 8) >= 3 && has(pane, "RESUME_DONE")) break;
            tw_sleep_ms(100);
        }
        tw_sleep_ms(500);
        tw_capture("r", pane, sizeof pane);
        note();
    }
    n = rs_posts(log, served, sizeof served, at, 8);
    if (n != 3) printf("  (requests served: %s)\n  (last screen)\n%s\n", served[0] ? served : "none", pane);
    check(has(seen, "未发送中文稿-EDIT"), "the pending prompt ran without overwriting the unsent draft or the later edit");
    check(has(seen, "csih · 写"), "the owned title shows the restored role");
    check(n == 3, "exactly 3 requests (the budget was not reset)");
    jtext = cx_read(journal, (size_t *)&at[7]);
    {
        int users = jtext ? count_lines_with(jtext, "\"role\":\"user\"", user, sizeof user) : 0;
        check(users == 1 && has(user, "\"text\":\"QUEUED_RESUME\""), "one user record in the journal: QUEUED_RESUME");
    }
    snprintf(req0, sizeof req0, "%s.req0", log);
    body0 = cx_read(req0, (size_t *)&at[6]);
    check(has(body0, "写手。同伴 0:restored-peer"), "request 1's system message names the restored role and peer");
    snprintf(want, sizeof want, "\"text\":\"cwd=%s\\nexit=0\\n%s\\n\"", cwd, cwd);
    check(has(jtext, want), "the pwd tool record ran in the restored cwd (cwd=…\\nexit=0\\n…)");
    otext = cx_read(other, (size_t *)&at[5]);
    check(otext && tx_eq(otext, "UNCHANGED", 16) && tw_stat(state, NULL, NULL) != 0,
          "the unrelated transcript is untouched and the snapshot was consumed");

    { int i; for (i = 0; i < 30; i++) tw_keys("r", "BSpace", 0); }
    tw_sleep_ms(250);
    tw_keys("r", "/export-state after", 1);
    tw_wait_text("r", "/export-state after", 1500, pane, sizeof pane);
    tw_sleep_ms(200);
    tw_keys("r", "Enter", 0);
    tw_wait_text("r", "state saved", 3000, pane, sizeof pane);
    raw = cx_read(state, (size_t *)&at[4]);
    if (raw) { snprintf(saved, sizeof saved, "%s", raw); tw_free(raw); } else saved[0] = 0;
    {
        static const char *keys[6] = { "goal", "history", "history_draft", "cwd", "role", "peer" };
        int i, same = saved[0] != 0;
        for (i = 0; i < 6; i++) if (!jv_same(saved, snapshot, keys[i])) { same = 0; printf("        differs: %s\n", keys[i]); }
        check(same, "export after: goal, history, history_draft, cwd, role, peer as restored");
        check(jv_is(saved, "pending_queue", "[]") && jv_is(saved, "loop_left", "0") && jv_is(saved, "loop_on", "false") &&
              jv_is(saved, "input", "\"\""), "export after: queue drained, loop disarmed, input empty");
    }
    tw_keys("r", "/exit", 1);
    tw_sleep_ms(200);
    tw_keys("r", "Enter", 0);
    rc = tw_rc("r", 5000);
    check(rc == 0 && rs_posts(log, served, sizeof served, at, 8) == 3, "/exit exits 0 and no request followed");
    check(tx_eq(digest(d0, sizeof d0), d1, 200), "product inputs (csih.sh digest) unchanged by the run");

    tw_free(jtext); tw_free(body0); tw_free(otext);
    tw_close();
    rs_stop(stub);
    if (cx_rmtree(dir) != 0) printf("resume_pending: scratch %s left behind\n", dir);
    printf("resume_pending: %s (%d failed)\n", fails ? "FAIL" : "PASS", fails);
    return fails ? 1 : 0;
}
