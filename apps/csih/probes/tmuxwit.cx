#pragma unisa module tmuxwit
#pragma unisa use sys.time
#pragma unisa use sys.proc
/*
 * tmuxwit.cx — a terminal witness over a private tmux server, for probes
 * that need a real tty without a pty library. Lower (a csih probe adapter):
 * clocks, sleeping and processes are cx/sys (probes/sys); no #include.
 *
 * The server is private (-L csih-TAG-PID) and reads no config (-f /dev/null):
 * a user config that errors puts the first session in view mode, which then
 * swallows every key sent to it. tw_close() kills the whole server.
 */

static char tw_sock[96];

void tw_sleep_ms(int ms) { sy_sleep_ms(ms); }

long tw_now_ms(void) { return sy_now_ms(); }

/* argv[0] via PATH; stdout+stderr into OUT (NUL-terminated, may be NULL).
 * Exit code, or -1 when it could not run or died by a signal. */
int tw_run(char **argv, char *out, int cap) {
    int cut, r = sy_run(argv, out, cap, &cut);
    return r >= 0 && r < 128 ? r : -1;
}

/* env, mkdir, chmod, stat and processes for upper probe roots are cx/sys
 * (probes/sys). This one stays until cx/mem owns what cx_read returns:
 * release what cx_read returned. */
void tw_free(void *p) { free(p); }

/* 1 when tmux is on PATH. */
int tw_open(const char *tag) {
    char *av[] = { "tmux", "-V", NULL };
    snprintf(tw_sock, sizeof tw_sock, "csih-%s-%d", tag, (int)getpid());
    return tw_run(av, NULL, 0) == 0;
}

static int tw_tmux(char **args, int n, char *out, int cap) {
    char *av[96];
    int i, k = 0;
    if (n + 6 > 96) return -1;   /* refuse, never truncate: a cut argv runs the wrong command */
    av[k++] = "tmux";
    av[k++] = "-L";
    av[k++] = tw_sock;
    av[k++] = "-f";
    av[k++] = "/dev/null";
    for (i = 0; i < n; i++) av[k++] = args[i];
    av[k] = NULL;
    return tw_run(av, out, cap);
}

/* A detached COLSxROWS session running CMD (argv form, NCMD words) in CWD. 0 on success.
 * CMD runs under timeout(1), 120s then KILL: a probe killed from outside never
 * reaches tw_close, and its csih kept running for an hour. With the command
 * gone the session ends, and an empty server exits by itself. */
int tw_new(const char *sess, int cols, int rows, const char *cwd, char **cmd, int ncmd) {
    char *a[88], cs[16], rs[16];
    int i, k = 0;
    if (ncmd + 15 > 88) return -1;   /* refuse, never truncate */
    snprintf(cs, sizeof cs, "%d", cols);
    snprintf(rs, sizeof rs, "%d", rows);
    a[k++] = "new-session"; a[k++] = "-d"; a[k++] = "-s"; a[k++] = (char *)sess;
    a[k++] = "-x"; a[k++] = cs; a[k++] = "-y"; a[k++] = rs;
    if (cwd && cwd[0]) { a[k++] = "-c"; a[k++] = (char *)cwd; }
    /* --foreground: in its own process group the TUI could not read the tty */
    a[k++] = "timeout"; a[k++] = "--foreground"; a[k++] = "-k"; a[k++] = "2"; a[k++] = "120";
    for (i = 0; i < ncmd; i++) a[k++] = cmd[i];
    return tw_tmux(a, k, NULL, 0);
}

/* Send K: literal text when LITERAL, else a key name (Enter, Escape, C-c). */
void tw_keys(const char *sess, const char *k, int literal) {
    /* "--" before the text: a literal like "-EDIT" was parsed as send-keys flags */
    char *lit[] = { "send-keys", "-t", (char *)sess, "-l", "--", (char *)k };
    char *key[] = { "send-keys", "-t", (char *)sess, "--", (char *)k };
    if (literal) tw_tmux(lit, 6, NULL, 0);
    else tw_tmux(key, 5, NULL, 0);
}

/* The pane with its history, wrapped lines joined. 0 on success. */
int tw_capture(const char *sess, char *out, int cap) {
    char *a[] = { "capture-pane", "-p", "-J", "-S", "-500", "-t", (char *)sess };
    int rc = tw_tmux(a, 7, out, cap);
    if (rc != 0 && cap > 0) out[0] = 0;
    return rc;
}

/* 1 once NEEDLE is on the pane within MS; OUT holds the last capture. */
int tw_wait_text(const char *sess, const char *needle, int ms, char *out, int cap) {
    long until = tw_now_ms() + ms;
    for (;;) {
        tw_capture(sess, out, cap);
        if (strstr(out, needle)) return 1;
        if (tw_now_ms() > until) return 0;
        tw_sleep_ms(50);
    }
}

/* Append CAP's text to SEEN unless SEEN already ends with it: a log of every
 * distinct frame, so a line that later scrolls away still counts. */
static void tw_note(char *seen, int seen_cap, const char *cap) {
    size_t have = strlen(seen), n = strlen(cap);
    if (have >= n && !strcmp(seen + have - n, cap)) return;
    if (have + n + 2 > (size_t)seen_cap) return;
    memcpy(seen + have, cap, n);
    seen[have + n] = '\n';
    seen[have + n + 1] = 0;
}

/* Type TEXT (one write, or one key per 30ms when PER_CHAR) and send it.
 * Keys before the TUI's raw mode are flushed, so the text is retyped until it
 * shows; Enter goes alone 200ms later (in the same tick it would be a pasted
 * newline). 1 when the text was on the input line before Enter. */
int tw_submit(const char *sess, const char *text, int per_char, char *seen, int seen_cap) {
    static char cap[65536];
    int attempt;
    for (attempt = 0; attempt < 3; attempt++) {
        if (per_char) {
            char one[8];
            const char *p = text;
            while (*p) {
                int n = 1;
                while (((unsigned char)p[n] & 0xc0) == 0x80) n++;   /* whole UTF-8 sequences */
                snprintf(one, sizeof one, "%.*s", n, p);
                tw_keys(sess, one, 1);
                tw_sleep_ms(30);
                p += n;
            }
        } else tw_keys(sess, text, 1);
        if (tw_wait_text(sess, text, 1500, cap, sizeof cap)) {
            tw_note(seen, seen_cap, cap);
            tw_sleep_ms(200);
            tw_keys(sess, "Enter", 0);
            return 1;
        }
        tw_keys(sess, "C-u", 0);   /* a partial line would be doubled by the retype */
    }
    return 0;
}

/* Watch the pane at most MS; every distinct frame goes into SEEN. With
 * NEEDLE, stop one capture after it shows. Without, stop when two captures
 * 250ms apart are equal after at least one change (a pane with a running
 * tick counter never settles, so give it a needle). 1 if NEEDLE showed. */
int tw_settle(const char *sess, int ms, const char *needle, char *seen, int seen_cap) {
    static char a[65536], b[65536];
    long until = tw_now_ms() + ms;
    int changed = 0, hit = 0;
    tw_capture(sess, a, sizeof a);
    tw_note(seen, seen_cap, a);
    while (tw_now_ms() < until) {
        tw_sleep_ms(needle ? 100 : 250);
        tw_capture(sess, b, sizeof b);
        if (strcmp(a, b)) { changed = 1; tw_note(seen, seen_cap, b); memcpy(a, b, sizeof a); }
        else if (!needle && changed) break;
        if (needle && strstr(b, needle)) {
            if (hit) break;
            hit = 1;
        }
    }
    return hit;
}

/* Exit code the pane's wrapper printed as __RC=N__ within MS, or -1. */
int tw_rc(const char *sess, int ms) {
    static char cap[65536];
    const char *p;
    if (!tw_wait_text(sess, "__RC=", ms, cap, sizeof cap)) return -1;
    p = strstr(cap, "__RC=");
    return atoi(p + 5);
}

void tw_close(void) {
    char *a[] = { "kill-server" };
    tw_tmux(a, 1, NULL, 0);
}
