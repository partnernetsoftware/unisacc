/* CX probe */
/* reload_owner.c -- C port of probes/reload_owner.py.
 * POSIX real-process ownership regression, using the shipped compiler.
 *
 * Run mode, from apps/csih (no -o build; each case runs unisacc in run mode):
 *   /bin/sh /Users/wjc/repos/unisacc/unisacc.com reload_owner.c reload_owner_cli.c MODE PATH
 *   OUT
 *
 * Deviations from the Python original:
 *   - the file hash is FNV-1a 64 (sha256 is not in the libc). The before/after
 *     comparison keeps the same meaning: any byte change in a watched file fails;
 *   - the probe runs unisacc in run mode per case, as the Python did (the Python
 *     ran the run-mode compiler directly);
 *   - a failed case prints "FAIL: <step>" and exits 1 instead of a traceback.
 */
#include <dirent.h>
#include <errno.h>
#include <fcntl.h>
#include <poll.h>
#include <signal.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <sys/wait.h>
#include <time.h>
#include <unistd.h>

#include "csih_flat.h"
#include "unisa_safedel.h"   /* the one deletion guard */

#define ROOT_BIN CSIH_ROOT "/unisacc.com"
#define OWN_CLI  "reload_owner_cli.c"

typedef struct { int rc; char out[1024]; char err[1024]; } Run;

static int failures = 0;
#define CHECK(cond, msg) do { if (!(cond)) { printf("FAIL: %s\n", msg); return 1; } } while (0)

/* Run argv with cwd=CSIH_APP, capture stdout and stderr separately. */
static int run_capture(char *const argv[], Run *r) {
    int po[2], pe[2], st;
    pid_t pid;
    size_t on = 0, en = 0;
    time_t deadline = time(NULL) + 5;
    int open_out = 1, open_err = 1, timed_out = 0;

    r->rc = 127; r->out[0] = 0; r->err[0] = 0;
    if (pipe(po) != 0) return -1;
    if (pipe(pe) != 0) { close(po[0]); close(po[1]); return -1; }
    pid = fork();
    if (pid < 0) return -1;
    if (pid == 0) {
        if (chdir(CSIH_APP) != 0) _exit(126);
        dup2(po[1], 1); dup2(pe[1], 2);
        close(po[0]); close(po[1]); close(pe[0]); close(pe[1]);
        execv(argv[0], argv);
        _exit(127);
    }
    close(po[1]); close(pe[1]);
    while (open_out || open_err) {
        struct pollfd fds[2];
        int n = 0, k;
        if (time(NULL) > deadline) { timed_out = 1; kill(pid, SIGKILL); break; }
        if (open_out) { fds[n].fd = po[0]; fds[n].events = POLLIN; n++; }
        if (open_err) { fds[n].fd = pe[0]; fds[n].events = POLLIN; n++; }
        if (poll(fds, (nfds_t)n, 100) <= 0) continue;
        for (k = 0; k < n; k++) {
            if (!(fds[k].revents & (POLLIN | POLLHUP))) continue;
            if (fds[k].fd == po[0]) {
                ssize_t got = read(po[0], r->out + on, sizeof r->out - 1 - on);
                if (got <= 0) open_out = 0; else on += (size_t)got;
            } else {
                ssize_t got = read(pe[0], r->err + en, sizeof r->err - 1 - en);
                if (got <= 0) open_err = 0; else en += (size_t)got;
            }
        }
        if (on >= sizeof r->out - 1) open_out = 0;
        if (en >= sizeof r->err - 1) open_err = 0;
    }
    r->out[on] = 0; r->err[en] = 0;
    close(po[0]); close(pe[0]);
    if (waitpid(pid, &st, 0) < 0) return -1;
    if (timed_out) return -1;
    r->rc = WIFEXITED(st) ? WEXITSTATUS(st) : 128;
    return 0;
}

/* FNV-1a 64 over a file's bytes; 0 with *ok=0 on failure. */
static unsigned long long fnv_file(const char *path, int *ok) {
    unsigned long long h = 1469598103934665603ULL;
    unsigned char buf[4096];
    ssize_t n;
    int fd = open(path, O_RDONLY);
    *ok = fd >= 0;
    if (fd < 0) return 0;
    while ((n = read(fd, buf, sizeof buf)) > 0) {
        ssize_t i;
        for (i = 0; i < n; i++) { h ^= buf[i]; h *= 1099511628211ULL; }
    }
    close(fd);
    return h;
}

static const char *WATCH[] = {
    CSIH_APP "/reload_owner.c", CSIH_APP "/reload_owner.h",
    CSIH_APP "/" OWN_CLI, ROOT_BIN, NULL
};

static int hashes_same(const unsigned long long *before) {
    int i, ok;
    for (i = 0; WATCH[i]; i++) {
        unsigned long long h = fnv_file(WATCH[i], &ok);
        if (!ok || h != before[i]) return 0;
    }
    return 1;
}

static void hashes_take(unsigned long long *out) {
    int i, ok;
    for (i = 0; WATCH[i]; i++) out[i] = fnv_file(WATCH[i], &ok);
}

static int write_file(const char *path, const char *data, size_t len, mode_t mode) {
    int fd = open(path, O_CREAT | O_TRUNC | O_WRONLY, mode);
    if (fd < 0) return -1;
    if (len && write(fd, data, len) != (ssize_t)len) { close(fd); return -1; }
    close(fd);
    return chmod(path, mode);
}

static int read_file(const char *path, char *buf, size_t cap, size_t *len) {
    int fd = open(path, O_RDONLY);
    ssize_t n;
    if (fd < 0) return -1;
    n = read(fd, buf, cap - 1);
    close(fd);
    if (n < 0) return -1;
    buf[n] = 0; *len = (size_t)n;
    return 0;
}

static int file_mode(const char *path, mode_t *m, ino_t *ino) {
    struct stat st;
    if (lstat(path, &st) != 0) return -1;
    *m = st.st_mode & 0777; *ino = st.st_ino;
    return 0;
}

static int exists_nofollow(const char *path) {
    struct stat st;
    return lstat(path, &st) == 0;
}

static int is_symlink(const char *path) {
    struct stat st;
    return lstat(path, &st) == 0 && S_ISLNK(st.st_mode);
}

static int is_dir(const char *path) {
    struct stat st;
    return lstat(path, &st) == 0 && S_ISDIR(st.st_mode);
}

/* Remove a private tree without following symlinks. */
/* through the one deletion guard (include/unisa_safedel.h): this probe's own mkdtemp tree (a site ceiling) or one
   file in it; a refusal is reported and nothing is deleted */
static void rm_rf(const char *path) {
    char why[1400];
    if (unisa_safedel(path, SAFEDEL_PURGE | SAFEDEL_RECURSIVE, 20000L, why, (int)sizeof why)) fprintf(stderr, "rm_rf: %s\n", why);
}

/* One CLI case. reason==NULL: expect rc 0 and exact expected text. */
static int cli(const char *mode, const char *path, const char *reason,
               const char *expect_ok, const char *step) {
    char *argv[7];
    Run r;
    char expect[256];
    argv[0] = (char *)"/bin/sh"; argv[1] = (char *)ROOT_BIN; argv[2] = (char *)"reload_owner.c";
    argv[3] = (char *)OWN_CLI; argv[4] = (char *)mode; argv[5] = (char *)path; argv[6] = NULL;
    if (run_capture(argv, &r) != 0) { printf("FAIL: %s run error\n", step); return 1; }
    if (r.err[0]) { printf("FAIL: %s stderr: %s\n", step, r.err); return 1; }
    if (reason) {
        size_t n = strlen(r.out);
        while (n && (r.out[n - 1] == '\n' || r.out[n - 1] == ' ')) r.out[--n] = 0;
        snprintf(expect, sizeof expect, "FAIL: %s", reason);
        CHECK(r.rc == 1 && !strcmp(r.out, expect), step);
    } else {
        CHECK(r.rc == 0 && !strcmp(r.out, expect_ok), step);
    }
    printf("PASS %s %s\n", mode, path);
    return 0;
}

#define SELFTEST_OK "PASS: parent holds, fork child refused\n" \
                    "PASS: child acquired after parent release\n" \
                    "PASS: process exit released ownership\n"
#define CHECK_OK "PASS: acquire/release\n"

#undef CHECK
#define CHECK(cond, msg) do { if (!(cond)) { printf("FAIL: %s\n", msg); goto done; } } while (0)

int main(void) {
    unsigned long long before[8];
    char tmpl[1024];   /* under the temp root: the one deletion guard deletes only there */
    char *tmp;
    char lock[1024], bad[1024], link_p[1024], dirp[1024], unsafe[1024];
    char unsafe_lock[1024], parent_link[1024], parent_lock[1024], rel[64];
    int rc = 1;
    char data[64];
    size_t dlen;
    mode_t m;
    ino_t ino, ino2, ino3;
    int ncases = 0;

    hashes_take(before);
    snprintf(tmpl, sizeof tmpl, "%s/csih-owner-XXXXXX", getenv("TMPDIR") && getenv("TMPDIR")[0] ? getenv("TMPDIR") : "/tmp");
    tmp = mkdtemp(tmpl);
    if (!tmp) { puts("FAIL: mkdtemp"); return 1; }
    snprintf(lock, sizeof lock, "%s/owner.lock", tmp);
    snprintf(bad, sizeof bad, "%s/bad.lock", tmp);
    snprintf(link_p, sizeof link_p, "%s/link.lock", tmp);
    snprintf(dirp, sizeof dirp, "%s/directory.lock", tmp);
    snprintf(unsafe, sizeof unsafe, "%s/unsafe", tmp);
    snprintf(unsafe_lock, sizeof unsafe_lock, "%s/unsafe/owner.lock", tmp);
    snprintf(parent_link, sizeof parent_link, "%s/parent-link", tmp);
    snprintf(parent_lock, sizeof parent_lock, "%s/parent-link/owner.lock", tmp);
    strcpy(rel, "relative.lock");


    /* 1: selftest creates the lock, 0600, empty. */
    if (cli("selftest", lock, NULL, SELFTEST_OK, "selftest")) goto done;
    ncases++;
    CHECK(file_mode(lock, &m, &ino) == 0 && m == 0600, "lock mode 0600");
    CHECK(read_file(lock, data, sizeof data, &dlen) == 0 && dlen == 0, "lock empty after selftest");
    /* 2: check keeps the same inode. */
    if (cli("check", lock, NULL, CHECK_OK, "check")) goto done;
    ncases++;
    CHECK(file_mode(lock, &m, &ino2) == 0 && ino2 == ino, "release must retain lock file");

    /* 3: bad permission refused, content untouched. */
    CHECK(write_file(bad, "keep", 4, 0644) == 0, "setup bad.lock");
    if (cli("check", bad, "lock not owned 0600 regular file", NULL, "bad perm")) goto done;
    ncases++;
    CHECK(read_file(bad, data, sizeof data, &dlen) == 0 && !strcmp(data, "keep") && file_mode(bad, &m, &ino3) == 0 && m == 0644,
          "bad.lock content/mode preserved");

    /* 4: symlink refused, target untouched. */
    CHECK(symlink(bad, link_p) == 0, "setup link.lock");
    if (cli("check", link_p, "open lock failed", NULL, "symlink")) goto done;
    ncases++;
    CHECK(is_symlink(link_p) && read_file(bad, data, sizeof data, &dlen) == 0 && !strcmp(data, "keep"), "symlink target preserved");

    /* 5: directory refused. */
    CHECK(mkdir(dirp, 0700) == 0, "setup directory.lock");
    if (cli("check", dirp, "open lock failed", NULL, "directory")) goto done;
    ncases++;
    CHECK(is_dir(dirp), "directory.lock still a directory");

    /* 6: unsafe parent (0755) refused, no lock created. */
    CHECK(mkdir(unsafe, 0755) == 0 && chmod(unsafe, 0755) == 0, "setup unsafe parent");
    if (cli("check", unsafe_lock, "parent not owned 0700 directory", NULL, "unsafe parent")) goto done;
    ncases++;
    CHECK(!exists_nofollow(unsafe_lock), "bad parent must not create lock");

    /* 7: symlinked parent refused. */
    CHECK(symlink(tmp, parent_link) == 0, "setup parent-link");
    if (cli("check", parent_lock, "open parent failed", NULL, "parent link")) goto done;
    ncases++;
    CHECK(is_symlink(parent_link) && file_mode(lock, &m, &ino2) == 0 && ino2 == ino, "parent link preserved lock inode");

    /* 8: relative path refused. */
    if (cli("check", rel, "lock path not absolute or invalid length", NULL, "relative")) goto done;
    ncases++;

    rc = 0;
done:
    rm_rf(tmp);
    if (rc == 0 && ncases == 8) printf("TOTAL: %d CLI cases passed; 3 real fork phases\n", ncases);
    if (!hashes_same(before)) { printf("FAIL: source/compiler changed during test\n"); rc = 1; }
    if (rc == 0 && ncases == 8) printf("hashes unchanged\nRESULT PASS reload_owner\n");
    else printf("RESULT FAIL reload_owner\n");
    return rc;
}
