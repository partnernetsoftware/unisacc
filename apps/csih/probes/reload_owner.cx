#pragma unisa use text.fmt
#pragma unisa use sys.io
#pragma unisa use mem.heap
#pragma unisa use sys.env
/* CX probe */
/* reload_owner.cx -- CX port of probes/reload_owner.py.
 * POSIX real-process ownership regression, using the shipped compiler.
 *
 * Builds reload_owner_cli.cx once, then runs `CLI MODE PATH` per case from
 * apps/csih; compiler $UNISACC, else APP/../../unisacc.com. Processes through
 * cx_runv_timeout (own process group, killed past the limit); no libc string
 * calls (tests/cxraw.cx ratchet).
 * One build instead of -run per case: measured 2026-10-30, one -run costs ~4 s
 * of compile, so 8 run-mode cases leave no margin in the contract's 40 s budget
 * on a loaded machine. The binary lives in the probe's mkdtemp dir and is removed
 * with it; nothing is cached across runs.
 *
 * As the Python: per case limit 5 s, stdout must match exactly, stderr must be
 * empty, and the watched sources plus the compiler must hash (sha256) the same
 * before and after. A failed case prints "FAIL: <step>" and exits 1.
 */

#define OWN_CLI "reload_owner_cli.cx"

static char APP[1024], UNI[1200], BIN[1100];

#define NWATCH 4
static char WATCH[NWATCH][1200];

static char ERRF[1100];   /* the CLI's stderr, a file in the probe's mkdtemp dir */

/* z-string equality without libc string calls (tests/cxraw.cx ratchet) */
static int same(const char *a, const char *b) {
    while (*a && *a == *b) { a++; b++; }
    return *a == *b;
}

/* APP = cwd; UNI = $UNISACC or APP/../../unisacc.com; 0 when all watched files exist */
static int locate(void) {
    const char *e = sy_env("UNISACC");
    struct stat st;
    int i;
    if (!getcwd(APP, sizeof APP)) { sy_printf("FAIL: getcwd: %s\n", sy_strerror(errno)); return -1; }
    if (e && e[0]) tx_snprintf(UNI, sizeof UNI, "%s", e);
    else tx_snprintf(UNI, sizeof UNI, "%s/../../unisacc.com", APP);
    tx_snprintf(WATCH[0], sizeof WATCH[0], "%s/reload_owner.cx", APP);
    tx_snprintf(WATCH[1], sizeof WATCH[1], "%s/reload_owner.h", APP);
    tx_snprintf(WATCH[2], sizeof WATCH[2], "%s/%s", APP, OWN_CLI);
    tx_snprintf(WATCH[3], sizeof WATCH[3], "%s", UNI);
    for (i = 0; i < NWATCH; i++)
        if (stat(WATCH[i], &st) != 0) { sy_printf("FAIL: %s: %s\n", WATCH[i], sy_strerror(errno)); return -1; }
    return 0;
}

/* sha256 hex of a file; 0 when it cannot be read */
static int sha_file(const char *path, char hex[65]) {
    size_t n = 0;
    char *b = cx_read(path, &n);
    if (!b) { hex[0] = 0; return 0; }
    cx_sha256_hex(b, n, hex);
    mm_free(b);
    return 1;
}

static void hashes_take(char out[][65]) {
    int i;
    for (i = 0; i < NWATCH; i++) sha_file(WATCH[i], out[i]);
}

static int hashes_same(char before[][65]) {
    int i;
    char h[65];
    for (i = 0; i < NWATCH; i++)
        if (!sha_file(WATCH[i], h) || !same(h, before[i])) return 0;
    return 1;
}

/* the whole file into BUF (cap > its size), terminated; 0, or -1 when unreadable or too big */
static int read_file(const char *path, char *buf, size_t cap, size_t *len) {
    size_t n = 0, i;
    char *b = cx_read(path, &n);
    if (!b) return -1;
    if (n + 1 > cap) { mm_free(b); return -1; }
    for (i = 0; i < n; i++) buf[i] = b[i];
    buf[n] = 0; *len = n;
    mm_free(b);
    return 0;
}

/* ARGS (NULL-terminated, at most 6) under /bin/sh, stdout into OUT and stderr into ERR
 * (via the file ERRF), SECS limit (process group killed past it). 0 with *rc; -2 timeout; -1 error. */
static int run_split(char **args, int secs, char *out, size_t cap, char *err, size_t errcap, int *rc) {
    char *argv[12], *o = NULL;
    size_t n = 0, i;
    int k, r;
    argv[0] = (char *)"/bin/sh"; argv[1] = (char *)"-c";
    argv[2] = (char *)"f=$1; shift; exec \"$@\" 2>\"$f\""; argv[3] = (char *)"sh"; argv[4] = ERRF;
    for (k = 0; k < 6 && args[k]; k++) argv[5 + k] = args[k];
    argv[5 + k] = NULL;
    r = cx_runv_timeout(argv, secs, &o, &n);
    out[0] = 0; err[0] = 0;
    if (o) {
        if (n + 1 > cap) n = cap - 1;
        for (i = 0; i < n; i++) out[i] = o[i];
        out[n] = 0;
        mm_free(o);
    }
    if (r == 124) return -2;
    if (r < 0) return -1;
    {   /* a missing stderr file means sh could not redirect: an error, not empty stderr */
        char *e = cx_read(ERRF, &n);
        if (!e) return -1;
        if (n + 1 > errcap) n = errcap - 1;
        for (i = 0; i < n; i++) err[i] = e[i];
        err[n] = 0;
        mm_free(e);
    }
    *rc = r;
    return 0;
}

static int build(const char *dir) {
    char *args[8];
    static char out[8192], err[8192];
    int rc = 0, r;
    tx_snprintf(BIN, sizeof BIN, "%s/reload_owner_cli", dir);
    args[0] = (char *)"/bin/sh"; args[1] = UNI; args[2] = (char *)OWN_CLI;
    args[3] = (char *)"-o"; args[4] = BIN; args[5] = NULL;
    r = run_split(args, 30, out, sizeof out, err, sizeof err, &rc);
    if (r != 0 || rc != 0) {
        sy_printf("FAIL: build %s rc %d | %.300s | %.300s\n", r == -2 ? "timeout" : "exit", rc, out, err);
        return -1;
    }
    return 0;
}

/* DATA into a fresh file, then MODE (as the Python's write_bytes + chmod) */
static int write_file(const char *path, const char *data, size_t len, mode_t mode) {
    if (cx_write(path, data, len) != 0) return -1;
    return chmod(path, mode);
}

static int file_mode(const char *path, mode_t *m, ino_t *ino) {
    struct stat st;
    if (lstat(path, &st) != 0) return -1;
    *m = st.st_mode & 0777; *ino = st.st_ino;
    return 0;
}

static int exists_nofollow(const char *path) {
    struct stat st;
    return lstat(path, &st) == 0;
}

static int is_symlink(const char *path) {
    struct stat st;
    return lstat(path, &st) == 0 && S_ISLNK(st.st_mode);
}

static int is_dir(const char *path) {
    struct stat st;
    return lstat(path, &st) == 0 && S_ISDIR(st.st_mode);
}

#define CHECK(cond, msg) do { if (!(cond)) { sy_printf("FAIL: %s\n", msg); return 1; } } while (0)

/* One CLI case. reason==NULL: expect rc 0 and exact expected text. */
static int cli(const char *mode, const char *path, const char *reason,
               const char *expect_ok, const char *step) {
    char *args[4];
    static char out[1024], err[1024];
    char expect[256];
    int rc = 0, r;
    args[0] = BIN; args[1] = (char *)mode; args[2] = (char *)path; args[3] = NULL;
    r = run_split(args, 5, out, sizeof out, err, sizeof err, &rc);
    if (r != 0) { sy_printf("FAIL: %s %s\n", step, r == -2 ? "timeout" : "run error"); return 1; }
    if (err[0]) { sy_printf("FAIL: %s stderr: %s\n", step, err); return 1; }
    if (reason) {
        size_t n = 0;
        while (out[n]) n++;
        while (n && (out[n - 1] == '\n' || out[n - 1] == ' ')) out[--n] = 0;
        tx_snprintf(expect, sizeof expect, "FAIL: %s", reason);
        if (!(rc == 1 && same(out, expect))) { sy_printf("FAIL: %s: rc %d out=%s\n", step, rc, out); return 1; }
    } else {
        if (!(rc == 0 && same(out, expect_ok))) { sy_printf("FAIL: %s: rc %d out=%s\n", step, rc, out); return 1; }
    }
    sy_printf("PASS %s %s\n", mode, path);
    return 0;
}

#define SELFTEST_OK "PASS: parent holds, fork child refused\n" \
                    "PASS: child acquired after parent release\n" \
                    "PASS: process exit released ownership\n"
#define CHECK_OK "PASS: acquire/release\n"

#undef CHECK
#define CHECK(cond, msg) do { if (!(cond)) { sy_printf("FAIL: %s\n", msg); goto done; } } while (0)

int main(void) {
    char before[NWATCH][65];
    char tmpl[1024];   /* under the temp root: the one deletion guard deletes only there */
    char *tmp;
    char lock[1024], bad[1024], link_p[1024], dirp[1024], unsafe[1024];
    char unsafe_lock[1024], parent_link[1024], parent_lock[1024], rel[64];
    int rc = 1;
    char data[64];
    size_t dlen;
    mode_t m;
    ino_t ino, ino2, ino3;
    int ncases = 0;
    const char *td = sy_env("TMPDIR");

    if (locate() != 0) { puts("RESULT FAIL reload_owner"); return 1; }
    hashes_take(before);
    tx_snprintf(tmpl, sizeof tmpl, "%s/csih-owner-XXXXXX", td && td[0] ? td : "/tmp");
    tmp = mkdtemp(tmpl);
    if (!tmp) { sy_printf("FAIL: mkdtemp: %s\n", sy_strerror(errno)); return 1; }
    tx_snprintf(lock, sizeof lock, "%s/owner.lock", tmp);
    tx_snprintf(bad, sizeof bad, "%s/bad.lock", tmp);
    tx_snprintf(link_p, sizeof link_p, "%s/link.lock", tmp);
    tx_snprintf(dirp, sizeof dirp, "%s/directory.lock", tmp);
    tx_snprintf(unsafe, sizeof unsafe, "%s/unsafe", tmp);
    tx_snprintf(unsafe_lock, sizeof unsafe_lock, "%s/unsafe/owner.lock", tmp);
    tx_snprintf(parent_link, sizeof parent_link, "%s/parent-link", tmp);
    tx_snprintf(parent_lock, sizeof parent_lock, "%s/parent-link/owner.lock", tmp);
    tx_snprintf(rel, sizeof rel, "relative.lock");
    tx_snprintf(ERRF, sizeof ERRF, "%s/cli.stderr", tmp);
    if (build(tmp) != 0) goto done;

    /* 1: selftest creates the lock, 0600, empty. */
    if (cli("selftest", lock, NULL, SELFTEST_OK, "selftest")) goto done;
    ncases++;
    CHECK(file_mode(lock, &m, &ino) == 0 && m == 0600, "lock mode 0600");
    CHECK(read_file(lock, data, sizeof data, &dlen) == 0 && dlen == 0, "lock empty after selftest");
    /* 2: check keeps the same inode. */
    if (cli("check", lock, NULL, CHECK_OK, "check")) goto done;
    ncases++;
    CHECK(file_mode(lock, &m, &ino2) == 0 && ino2 == ino, "release must retain lock file");

    /* 3: bad permission refused, content untouched. */
    CHECK(write_file(bad, "keep", 4, 0644) == 0, "setup bad.lock");
    if (cli("check", bad, "lock not owned 0600 regular file", NULL, "bad perm")) goto done;
    ncases++;
    CHECK(read_file(bad, data, sizeof data, &dlen) == 0 && same(data, "keep") && file_mode(bad, &m, &ino3) == 0 && m == 0644,
          "bad.lock content/mode preserved");

    /* 4: symlink refused, target untouched. */
    CHECK(symlink(bad, link_p) == 0, "setup link.lock");
    if (cli("check", link_p, "open lock failed", NULL, "symlink")) goto done;
    ncases++;
    CHECK(is_symlink(link_p) && read_file(bad, data, sizeof data, &dlen) == 0 && same(data, "keep"), "symlink target preserved");

    /* 5: directory refused. */
    CHECK(mkdir(dirp, 0700) == 0, "setup directory.lock");
    if (cli("check", dirp, "open lock failed", NULL, "directory")) goto done;
    ncases++;
    CHECK(is_dir(dirp), "directory.lock still a directory");

    /* 6: unsafe parent (0755) refused, no lock created. */
    CHECK(mkdir(unsafe, 0755) == 0 && chmod(unsafe, 0755) == 0, "setup unsafe parent");
    if (cli("check", unsafe_lock, "parent not owned 0700 directory", NULL, "unsafe parent")) goto done;
    ncases++;
    CHECK(!exists_nofollow(unsafe_lock), "bad parent must not create lock");

    /* 7: symlinked parent refused. */
    CHECK(symlink(tmp, parent_link) == 0, "setup parent-link");
    if (cli("check", parent_lock, "open parent failed", NULL, "parent link")) goto done;
    ncases++;
    CHECK(is_symlink(parent_link) && file_mode(lock, &m, &ino2) == 0 && ino2 == ino, "parent link preserved lock inode");

    /* 8: relative path refused. */
    if (cli("check", rel, "lock path not absolute or invalid length", NULL, "relative")) goto done;
    ncases++;

    rc = 0;
done:
    cx_rmtree(tmp);   /* through the one deletion guard; a refusal is reported on stderr */
    if (rc == 0 && ncases == 8) sy_printf("TOTAL: %d CLI cases passed; 3 real fork phases\n", ncases);
    if (!hashes_same(before)) { sy_printf("FAIL: source/compiler changed during test\n"); rc = 1; }
    if (rc == 0 && ncases == 8) sy_printf("hashes unchanged\nRESULT PASS reload_owner\n");
    else { rc = 1; sy_printf("RESULT FAIL reload_owner\n"); }
    return rc;
}
