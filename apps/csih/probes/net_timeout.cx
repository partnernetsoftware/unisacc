#pragma unisa use agentwit
#pragma unisa use srccopy
/* CX probe */
/* net_timeout.cx — port of net_timeout.py (run with -run; upper root, no includes:
 * sockets and time are agentwit's).
 *
 * A private copy of the app tree gets NET_TOTAL_SEC 60 -> 1 (net.cx enum). The
 * private agent (agent_cli.cx compiled once to agent_cli.bin, `agent`) must hit the timeout branch
 * (err=-6) against a localhost stub that sleeps 3s, with exactly one request.
 * The production 60s TUI selftest also runs, against an unchanged private
 * snapshot: the installed product binary CSIH_BIN (else
 * ../../out/csih-e2e-bin/csih), only after its stamp CSIH_BIN.src equals the
 * current `csih.sh digest` of the product inputs (a stale binary is a FAIL,
 * never a pass). A private csih.cx -run is ~50s cold, over the contract budget.
 *
 * Build cache: unisacc's -run cache is keyed by cwd + root path + content, so a
 * fresh mkdtemp tree recompiles the agent every run (~28s measured, against
 * ~1.2s hot). The modified tree therefore lives at a fixed per-uid path
 * TMP/csih-probe-build-UID/net_timeout/app, rebuilt from the snapshot every run
 * (content-identical rewrites keep the cache hit; the agent still runs every time).
 *
 * Freeze: a byte-for-byte snapshot compare of every .c/.h/.inc/.cx under the
 * app dir, plus unisacc.com, taken before and after.
 *
 * Run from the app dir (apps/csih), or set CSIH_APP to it.
 * Temp base: CSIH_PROBE_TMP, else TMPDIR, else /tmp.
 * Server: 127.0.0.1:19002 (forked child).
 */

#define PORT 19002
#define NET_NEEDLE "    NET_TOTAL_SEC = 60\n"
#define NET_REPL   "    NET_TOTAL_SEC = 1\n"
#define AGENT_MSG  "agent FAILED: model call timed out (60s) (err=-6)"
#define PASS_LINE  "PASS private timeout branch (err=-6), one localhost request; production60s TUI selftest"
#define RUN_TIMEOUT 14.0
#define BUILD_TIMEOUT 38.0   /* the -o compile of the private agent, cold */

static char APP[4096];   /* absolute app dir (apps/csih) */
static char PRIV[4096];  /* private temp dir */
static char BUILD[4096]; /* fixed private agent tree (the -run cache key) */
static char HOMEDIR[4096]; /* private HOME, see make_home */

/* ---------- snapshot ---------- */
typedef struct {
    char **path;
    unsigned char **data;
    size_t *len;
    size_t n, cap;
    int bad;
} Snap;

static void snap_add(Snap *s, const char *path, unsigned char *data, size_t len) {
    if (s->n == s->cap) {
        s->cap = s->cap ? s->cap * 2 : 64;
        s->path = realloc(s->path, s->cap * sizeof *s->path);
        s->data = realloc(s->data, s->cap * sizeof *s->data);
        s->len = realloc(s->len, s->cap * sizeof *s->len);
        if (!s->path || !s->data || !s->len) exit(1);
    }
    /* not strdup: unisacc's strdup result cannot be free()d (crashes) */
    {
        size_t pl = strlen(path);
        char *cp = malloc(pl + 1);
        if (!cp) exit(1);
        memcpy(cp, path, pl + 1);
        s->path[s->n] = cp;
    }
    s->data[s->n] = data;
    s->len[s->n] = len;
    s->n++;
}

static void snap_free(Snap *s) {
    size_t i;
    for (i = 0; i < s->n; i++) { free(s->path[i]); free(s->data[i]); }
    free(s->path); free(s->data); free(s->len);
    memset(s, 0, sizeof *s);
}

/* Whole file, NUL-terminated (length excludes the NUL). NULL on error. */
static unsigned char *read_file(const char *path, size_t *len) {
    return (unsigned char *)cx_read(path, len);
}

static int write_file(const char *path, const unsigned char *data, size_t len) {
    return cx_write(path, data, len);
}

static int is_src(const char *name) {
    size_t n = strlen(name);
    return (n > 2 && strcmp(name + n - 2, ".c") == 0) ||
           (n > 2 && strcmp(name + n - 2, ".h") == 0) ||
           (n > 4 && strcmp(name + n - 4, ".inc") == 0) ||
           (n > 3 && strcmp(name + n - 3, ".cx") == 0);
}

static void walk(const char *dir, Snap *s) {
    DIR *d = opendir(dir);
    struct dirent *e;
    if (!d) { s->bad = 1; return; }
    while ((e = readdir(d)) != NULL) {
        char full[4200];
        struct stat st;
        if (strcmp(e->d_name, ".") == 0 || strcmp(e->d_name, "..") == 0) continue;
        snprintf(full, sizeof full, "%s/%s", dir, e->d_name);
        if (lstat(full, &st) != 0) { s->bad = 1; continue; }
        if (S_ISLNK(st.st_mode)) { if (is_src(e->d_name)) s->bad = 1; continue; }
        if (S_ISDIR(st.st_mode)) { walk(full, s); continue; }
        if (S_ISREG(st.st_mode) && is_src(e->d_name)) {
            size_t len = 0;
            unsigned char *data = read_file(full, &len);
            if (!data) { s->bad = 1; continue; }
            snap_add(s, full, data, len);
        }
    }
    closedir(d);
}

/* App sources + unisacc.com, sorted by path. Returns 0 ok, -1 unreadable. */
static int snapshot(Snap *s) {
    size_t len = 0, i, j;
    unsigned char *root;
    char rootpath[4200];
    memset(s, 0, sizeof *s);
    walk(APP, s);
    snprintf(rootpath, sizeof rootpath, "%s/../../unisacc.com", APP);
    root = read_file(rootpath, &len);
    if (!root) s->bad = 1; else snap_add(s, rootpath, root, len);
    for (i = 1; i < s->n; i++)
        for (j = i; j > 0 && strcmp(s->path[j - 1], s->path[j]) > 0; j--) {
            char *p = s->path[j]; s->path[j] = s->path[j - 1]; s->path[j - 1] = p;
            unsigned char *d = s->data[j]; s->data[j] = s->data[j - 1]; s->data[j - 1] = d;
            size_t l = s->len[j]; s->len[j] = s->len[j - 1]; s->len[j - 1] = l;
        }
    return s->bad ? -1 : 0;
}

static int snap_equal(const Snap *a, const Snap *b) {
    size_t i;
    if (a->n != b->n) return 0;
    for (i = 0; i < a->n; i++) {
        if (strcmp(a->path[i], b->path[i]) != 0) return 0;
        if (a->len[i] != b->len[i]) return 0;
        if (memcmp(a->data[i], b->data[i], a->len[i]) != 0) return 0;
    }
    return 1;
}

/* ---------- filesystem helpers ---------- */
static void mkdir_p(const char *path) {
    char tmp[4200];
    char *p;
    snprintf(tmp, sizeof tmp, "%s", path);
    for (p = tmp + 1; *p; p++) {
        if (*p == '/') { *p = 0; mkdir(tmp, 0755); *p = '/'; }
    }
    mkdir(tmp, 0755);
}

/* P (a tree) through the one guard (cx_rmtree), never a raw unlink/rmdir; a refusal is reported, the probe's verdict stands */
static void sd_gone(const char *p) {
    if (cx_rmtree(p) != 0) fprintf(stderr, "probe: cx_rmtree refused %s\n", p);
}

/* Whole seconds. unisacc's gettimeofday tv_usec is not usable, so sub-second
 * timing is not available; time() is 1s resolution. */
static double now_sec(void) {
    return (double)aw_time();
}

/* Runs `sh -c 'cd DIR && ENVS exec "$0" "$@"' BIN ARGS...` in its own session.
 * stdout/stderr go to files. Returns 0 ok (*rc set), -1 spawn error,
 * -2 timed out after LIMIT seconds (child killed). */
static int run_timed_for(double limit, const char *dir, const char *envs, const char *bin,
                         char **args, int nargs, const char *out, const char *err, int *rc) {
    char script[8192];
    char *argv[96];
    int i, n = 0, st;
    pid_t pid;
    double start;
    if (nargs + 6 > 96) return -1;
    snprintf(script, sizeof script, "cd '%s' && %s exec \"$0\" \"$@\"", dir, envs);
    argv[n++] = (char *)"sh";
    argv[n++] = (char *)"-c";
    argv[n++] = script;
    argv[n++] = (char *)bin;
    for (i = 0; i < nargs; i++) argv[n++] = args[i];
    argv[n] = NULL;
    pid = fork();
    if (pid < 0) return -1;
    if (pid == 0) {
        int fi;
        setpgid(0, 0);
        fi = open("/dev/null", O_RDONLY);
        int fo = open(out, O_WRONLY | O_CREAT | O_TRUNC, 0600);
        int fe = open(err, O_WRONLY | O_CREAT | O_TRUNC, 0600);
        if (fi >= 0) dup2(fi, 0);
        if (fo >= 0) dup2(fo, 1);
        if (fe >= 0) dup2(fe, 2);
        execv("/bin/sh", argv);
        _exit(127);
    }
    setpgid(pid, pid);
    start = now_sec();
    for (;;) {
        pid_t w = waitpid(pid, &st, WNOHANG);
        if (w == pid) { *rc = WIFEXITED(st) ? WEXITSTATUS(st) : 128; return 0; }
        if (w < 0) return -1;
        if (now_sec() - start > limit) {
            kill(-pid, SIGKILL); /* its own process group: the program and any compiler children */
            waitpid(pid, &st, 0);
            return -2;
        }
        usleep(20000);
    }
}

static int run_timed(const char *dir, const char *envs, const char *bin,
                     char **args, int nargs, const char *out, const char *err, int *rc) {
    return run_timed_for(RUN_TIMEOUT, dir, envs, bin, args, nargs, out, err, rc);
}

/* env for every private run; `extra` is appended (e.g. CSIH_ENDPOINT). */
static void build_env(char *envs, size_t cap, const char *extra) {
    snprintf(envs, cap,
             "export HOME='%s'; export DEEPSEEK_API_KEY=LOCAL_STUB_ONLY; "
             "export CSIH_ROLE=; export CSIH_PEER=; export CSIH_CWD='%s'; "
             "export CSIH_TRANSCRIPT='%s/journal.jsonl'; export CSIH_MODEL=local-stub; "
             "export NO_PROXY=127.0.0.1,localhost; export no_proxy=127.0.0.1,localhost; "
             "unset OPENAI_API_KEY http_proxy https_proxy HTTP_PROXY HTTPS_PROXY all_proxy "
             "ALL_PROXY CDSH_ROLE CDSH_PEER CDSH_ENDPOINT CDSH_MODEL CDSH_CWD; %s",
             HOMEDIR, PRIV, PRIV, extra ? extra : "");
}

/* The private HOME must not lie under a temp root: the deletion guard drops a temp
 * root that is $HOME or an ancestor of it, and the TUI selftest then cannot clean
 * up its /tmp fixtures. So HOME is a mkdtemp under <repo>/out/ (the guard's other
 * root, ignored by git), removed at the end. */
static int make_home(void) {
    char repo[4096], tmpl[4300];
    snprintf(tmpl, sizeof tmpl, "%s/../..", APP);
    if (!realpath(tmpl, repo)) return -1;
    snprintf(tmpl, sizeof tmpl, "%s/out", repo);
    mkdir(tmpl, 0755);
    snprintf(tmpl, sizeof tmpl, "%s/out/csih-net-timeout-home-XXXXXX", repo);
    if (!mkdtemp(tmpl)) return -1;
    snprintf(HOMEDIR, sizeof HOMEDIR, "%s", tmpl);
    return 0;
}

/* Build of the private agent, cwd = BUILD: sh <PRIV>/unisacc.com agent_cli.cx -o
 * BUILD/agent_cli.bin (rc 0, empty stderr), then the gate: agent_cli.bin build-check.
 * An unknown subcommand prints the usage line and exits 64, so rc 64, that line on
 * stdout and an empty stderr mean the module graph compiled clean. Compiled once
 * (2026-10-30): a second -run for the agent case did not fit RUN_TIMEOUT.
 * Returns 0 on pass. */
static int build_agent(const char *envs, const char **why) {
    char *args[8];
    char compiler[4200], bin[4200], out_f[4200], err_f[4200];
    int rc = 0, st;
    unsigned char *so, *se;
    snprintf(compiler, sizeof compiler, "%s/unisacc.com", PRIV);
    snprintf(bin, sizeof bin, "%s/agent_cli.bin", BUILD);
    snprintf(out_f, sizeof out_f, "%s/agent_build.out", PRIV);
    snprintf(err_f, sizeof err_f, "%s/agent_build.err", PRIV);
    args[0] = compiler;
    args[1] = (char *)"agent_cli.cx";
    args[2] = (char *)"-o";
    args[3] = bin;
    st = run_timed_for(BUILD_TIMEOUT, BUILD, envs, "/bin/sh", args, 4, out_f, err_f, &rc);
    if (st != 0) { *why = "agent build timed out or spawn failed"; return -1; }
    se = read_file(err_f, NULL);
    st = rc == 0 && se && se[0] == 0;
    if (!st) fprintf(stderr, "agent compile rc=%d stderr=%.400s\n", rc, se ? (const char *)se : "");
    free(se);
    if (!st) { *why = "agent compile failed (need rc 0, empty stderr)"; return -1; }
    args[0] = (char *)"build-check";
    st = run_timed(BUILD, envs, bin, args, 1, out_f, err_f, &rc);
    if (st != 0) { *why = "agent build gate timed out or spawn failed"; return -1; }
    so = read_file(out_f, NULL);
    se = read_file(err_f, NULL);
    st = rc == 64 && so && !strncmp((const char *)so, "usage: agent_cli", 16) && se && se[0] == 0;
    if (!st) {
        fprintf(stderr, "agent build rc=%d stdout=%.200s stderr=%.400s\n", rc,
                so ? (const char *)so : "", se ? (const char *)se : "");
        *why = "agent build gate failed (need rc 64 usage line, empty stderr)";
    }
    free(so); free(se);
    return st ? 0 : -1;
}

/* Last non-empty line of BUF into DST. */
static void last_line(const char *buf, char *dst, size_t cap) {
    const char *end = buf + strlen(buf), *q;
    while (end > buf && (end[-1] == '\n' || end[-1] == '\r')) end--;
    q = end;
    while (q > buf && q[-1] != '\n') q--;
    snprintf(dst, cap, "%.*s", (int)(end - q), q);
}

/* The installed product binary, copied to OUT_BIN once its stamp matches the
 * current product-input digest (csih.sh digest). Returns 0 ok. */
static int install_tui(const char *out_bin, const char **why) {
    static char msg[700];
    char bin[4200], stamp_p[4300], script_p[4300], dig[200], want[200];
    const char *b = getenv("CSIH_BIN");
    char *av[4], *o = NULL;
    size_t ol = 0, bl = 0;
    unsigned char *stamp, *bytes;
    int rc;
    if (b && b[0]) snprintf(bin, sizeof bin, "%s", b);
    else snprintf(bin, sizeof bin, "%s/../../out/csih-e2e-bin/csih", APP);
    snprintf(stamp_p, sizeof stamp_p, "%s.src", bin);
    snprintf(script_p, sizeof script_p, "%s/csih.sh", APP);
    av[0] = (char *)"sh"; av[1] = script_p; av[2] = (char *)"digest"; av[3] = NULL;
    rc = cx_runv_timeout(av, 20, &o, &ol);
    if (rc != 0 || !o) { free(o); *why = "csih.sh digest failed"; return -1; }
    last_line(o, dig, sizeof dig);
    free(o);
    stamp = read_file(stamp_p, NULL);
    if (!stamp) { snprintf(msg, sizeof msg, "no stamp %s (run csih.sh prepare)", stamp_p); *why = msg; return -1; }
    last_line((const char *)stamp, want, sizeof want);
    free(stamp);
    if (strncmp(dig, "digest ", 7) != 0 || strcmp(dig + 7, want) != 0) {
        snprintf(msg, sizeof msg, "%s is stale: stamp %s, sources %s (run csih.sh prepare)", bin, want, dig);
        *why = msg;
        return -1;
    }
    bytes = read_file(bin, &bl);
    if (!bytes) { *why = "cannot read CSIH_BIN"; return -1; }
    if (write_file(out_bin, bytes, bl) != 0 || chmod(out_bin, 0755) != 0) { free(bytes); *why = "tui copy failed"; return -1; }
    free(bytes);
    return 0;
}

/* Replace the single NET needle in buf (length len). Caller frees result. */
static unsigned char *replace_net(const unsigned char *buf, size_t len, size_t *outlen) {
    const char *hit = strstr((const char *)buf, NET_NEEDLE);
    size_t pre = (size_t)(hit - (const char *)buf);
    size_t nl = strlen(NET_REPL), ol = strlen(NET_NEEDLE);
    unsigned char *o = malloc(len - ol + nl + 1);
    if (!o) exit(1);
    memcpy(o, buf, pre);
    memcpy(o + pre, NET_REPL, nl);
    memcpy(o + pre + nl, buf + pre + ol, len - pre - ol);
    *outlen = len - ol + nl;
    return o;
}

static int count_sub(const char *hay, const char *needle) {
    int n = 0;
    const char *p = hay;
    size_t l = strlen(needle);
    while ((p = strstr(p, needle)) != NULL) { n++; p += l; }
    return n;
}

/* Stub server child: same reply as the python handler. Requests are logged
 * to <PRIV>/requests.log after being read, then sleep 3s before answering. */
static void serve_child(int lfd) {
    static char req[65536];
    static char logbuf[8 * 64];
    static const char body[] = "{\"choices\":[{\"message\":{\"content\":\"unused\"}}]}";
    int nlog = 0, rl, bl = (int)sizeof body - 1;
    char resp[256];
    for (;;) {
        int c = aw_accept(lfd);
        size_t have = 0, hdr = 0, want = 0;
        int got = 0;
        char *e;
        if (c < 0) continue;
        for (;;) {
            ssize_t k;
            if (have >= sizeof req - 1) break;
            k = (ssize_t)aw_recv(c, req + have, (long)(sizeof req - 1 - have));
            if (k <= 0) break;
            have += (size_t)k;
            req[have] = 0;
            if (!got && (e = strstr(req, "\r\n\r\n")) != NULL) {
                char *cl;
                got = 1;
                hdr = (size_t)(e - req) + 4;
                cl = strstr(req, "Content-Length:");
                if (!cl) cl = strstr(req, "content-length:");
                if (cl) want = (size_t)strtoul(cl + 15, NULL, 10);
            }
            if (got && have >= hdr + want) break;
        }
        if (got) {
            /* this child is the only writer: the log is rewritten whole, one line per request */
            char lp[4200];
            int j;
            snprintf(lp, sizeof lp, "%s/requests.log", PRIV);
            for (j = 0; j < 8; j++) logbuf[nlog * 8 + j] = "request\n"[j];
            if (nlog + 1 < (int)(sizeof logbuf / 8)) nlog++;
            cx_write(lp, logbuf, (size_t)nlog * 8);
        }
        sleep(3);
        rl = snprintf(resp, sizeof resp,
                      "HTTP/1.1 200 OK\r\nContent-Length: %d\r\nConnection: close\r\n\r\n", bl);
        aw_send(c, resp, rl);   /* a gone client is fine: MSG_NOSIGNAL */
        aw_send(c, body, bl);
        close(c);
    }
}

/* Returns NULL on pass, else the failure reason (static text). */
static const char *probe(void) {
    static char msg[512];
    Snap before;
    char envs[8192], agent_envs[8192], tbase_buf[4200];
    char tmpl[4200], tui_bin[4200], agent_bin[4200], out_f[4200], err_f[4200];
    char netc[4200], app_copy[4200], log_p[4200];
    const char *tbase;
    const char *err = NULL;
    unsigned char *netdata = NULL;
    size_t len = 0, i;
    int rc = 0, lfd = -1, srv = -1, st, port = 0;
    double t0, t1;
    char *args[8];
    unsigned char *o; size_t ol = 0;

    memset(&before, 0, sizeof before);
    if (snapshot(&before) != 0) { snap_free(&before); return "snapshot before failed"; }

    snprintf(netc, sizeof netc, "%s/net.cx", APP);
    netdata = read_file(netc, &len);
    if (!netdata) { err = "cannot read app net.cx"; goto out; }
    if (count_sub((const char *)netdata, NET_NEEDLE) != 1) { err = "app net.cx: NET_TOTAL_SEC = 60 count != 1"; goto out; }

    tbase = getenv("CSIH_PROBE_TMP");
    if (!tbase || !tbase[0]) tbase = getenv("TMPDIR");
    if (!tbase || !tbase[0]) tbase = "/tmp";
    snprintf(tbase_buf, sizeof tbase_buf, "%s", tbase);
    snprintf(tmpl, sizeof tmpl, "%s/csih-net-timeout-XXXXXX", tbase_buf);
    if (!mkdtemp(tmpl)) { err = "mkdtemp failed"; goto out; }
    snprintf(PRIV, sizeof PRIV, "%s", tmpl);
    snprintf(app_copy, sizeof app_copy, "%s/app", PRIV);
    snprintf(tui_bin, sizeof tui_bin, "%s/tui", PRIV);
    snprintf(log_p, sizeof log_p, "%s/requests.log", PRIV);
    snprintf(BUILD, sizeof BUILD, "%s/csih-probe-build-%d/net_timeout/app", tbase_buf, (int)getuid());
    {
        struct stat bs;
        if (lstat(BUILD, &bs) == 0 && cx_rmtree(BUILD) != 0) { err = "cannot clear the private agent tree"; goto out; }
    }

    /* private app copies (all sources): app_copy stays the unchanged snapshot,
     * BUILD gets the private threshold below; + private compiler + private home */
    mkdir(app_copy, 0755);
    mkdir_p(BUILD);
    for (i = 0; i < before.n; i++) {
        const char *p = before.path[i];
        size_t al = strlen(APP);
        char dst[4400], dir[4400];
        const char *roots[2];
        int r;
        roots[0] = app_copy;
        roots[1] = BUILD;
        if (strncmp(p, APP, al) != 0 || p[al] != '/' || !is_src(p)) continue;
        for (r = 0; r < 2; r++) {
            snprintf(dst, sizeof dst, "%s/%s", roots[r], p + al + 1);
            snprintf(dir, sizeof dir, "%s", dst);
            *strrchr(dir, '/') = 0;
            mkdir_p(dir);
            if (write_file(dst, before.data[i], before.len[i]) != 0) { err = "copy failed"; goto out; }
        }
    }
    /* sys, mem, text are links the snapshot walk skips: the agent build needs them */
    if (csih_copy_l0(APP, BUILD) != 0) { err = "copy of the L0 dirs (sys, mem, text) failed"; goto out; }
    for (i = 0; i < before.n; i++) {
        const char *p = before.path[i];
        size_t pl = strlen(p);
        if (pl > 12 && strcmp(p + pl - 12, "/unisacc.com") == 0) {
            char cp[4300];
            snprintf(cp, sizeof cp, "%s/unisacc.com", PRIV);
            if (write_file(cp, before.data[i], before.len[i]) != 0) { err = "compiler copy failed"; goto out; }
        }
    }
    {
        char hd[4300];
        if (make_home() != 0) { err = "private home under <repo>/out failed"; goto out; }
        snprintf(hd, sizeof hd, "%s/env.jsonl", HOMEDIR);
        if (write_file(hd, (const unsigned char *)"{\"DEEPSEEK_API_KEY\":\"LOCAL_STUB_ONLY\"}\n", 39) != 0) { err = "env write failed"; goto out; }
    }

    build_env(envs, sizeof envs, NULL);

    /* production TUI: the installed product binary, stamp == current source digest */
    if (install_tui(tui_bin, &err) != 0) goto out;

    /* selftest: unchanged private snapshot, 60s threshold */
    snprintf(out_f, sizeof out_f, "%s/tui_self.out", PRIV);
    snprintf(err_f, sizeof err_f, "%s/tui_self.err", PRIV);
    args[0] = (char *)"selftest";
    st = run_timed(app_copy, envs, tui_bin, args, 1, out_f, err_f, &rc);
    if (st != 0) { err = "tui selftest timed out or spawn failed"; goto out; }
    {
        unsigned char *so = read_file(out_f, NULL), *se = read_file(err_f, NULL);
        const char *s = so ? (const char *)so : "";
        const char *e2 = se ? (const char *)se : "";
        size_t sl = strlen(s);
        const char *end = s + sl;
        int ok;
        while (end > s && (end[-1] == '\n' || end[-1] == '\r')) end--;
        {
            const char *q = end;
            while (q > s && q[-1] != '\n') q--;
            ok = rc == 0 && end - q == 11 && memcmp(q, "selftest ok", 11) == 0 &&
                 strstr(s, "FAIL") == NULL && e2[0] == 0 && end > s;
        }
        free(so); free(se);
        if (!ok) { err = "tui selftest gate failed (need rc 0, last line 'selftest ok', no FAIL, empty stderr)"; goto out; }
    }

    /* private threshold: NET_TOTAL_SEC 60 -> 1 in the private agent tree only */
    {
        char netp[4300];
        size_t nl = 0;
        unsigned char *nb;
        snprintf(netp, sizeof netp, "%s/net.cx", BUILD);
        nb = read_file(netp, &nl);
        if (!nb || count_sub((const char *)nb, NET_NEEDLE) != 1) { free(nb); err = "private net.cx count != 1"; goto out; }
        o = replace_net(nb, nl, &ol);
        free(nb);
        if (write_file(netp, o, ol) != 0) { free(o); err = "private net.cx write failed"; goto out; }
        free(o);
    }

    /* private agent build (the -run compile), clean rc/stderr */
    if (build_agent(envs, &err) != 0) goto out;

    /* localhost stub on 127.0.0.1:PORT, forked child */
    if (aw_listen(PORT, PORT, &port, &lfd) != 0) { err = "stub bind/listen failed"; goto out; }
    srv = fork();
    if (srv < 0) { err = "stub fork failed"; goto out; }
    if (srv == 0) {
        serve_child(lfd);
        _exit(0);
    }
    close(lfd);
    lfd = -1;

    /* agent run against the stub */
    snprintf(out_f, sizeof out_f, "%s/agent.out", PRIV);
    snprintf(err_f, sizeof err_f, "%s/agent.err", PRIV);
    {
        char extra[256];
        snprintf(extra, sizeof extra, "export CSIH_ENDPOINT=http://127.0.0.1:%d/v1/chat/completions;", PORT);
        build_env(agent_envs, sizeof agent_envs, extra);
    }
    snprintf(agent_bin, sizeof agent_bin, "%s/agent_cli.bin", BUILD);
    args[0] = (char *)"agent";
    args[1] = (char *)"TIMEOUT_PROBE";
    t0 = now_sec();
    st = run_timed(BUILD, agent_envs, agent_bin, args, 2, out_f, err_f, &rc);
    t1 = now_sec();
    if (st != 0) { err = "agent run timed out or spawn failed"; goto out; }
    {
        unsigned char *lg = read_file(log_p, NULL);
        int requests = lg ? count_sub((const char *)lg, "request\n") : 0;
        unsigned char *ao = read_file(out_f, NULL);
        free(lg);
        if (rc != 1 || requests != 1) {
            snprintf(msg, sizeof msg, "agent rc=%d requests=%d (want rc 1, 1 request)", rc, requests);
            free(ao);
            err = msg;
            goto out;
        }
        if (!ao || !strstr((const char *)ao, AGENT_MSG)) {
            free(ao);
            err = "agent stdout missing timeout message (err=-6)";
            goto out;
        }
        free(ao);
    }
    if (t1 - t0 >= 5.0) { err = "agent run took 5s or more"; goto out; }

out:
    if (srv > 0) { kill(srv, SIGKILL); waitpid(srv, &st, 0); }
    if (lfd >= 0) close(lfd);
    if (PRIV[0]) sd_gone(PRIV);
    if (HOMEDIR[0]) sd_gone(HOMEDIR);
    free(netdata);
    {
        Snap after;
        memset(&after, 0, sizeof after);
        if (snapshot(&after) != 0 || !snap_equal(&before, &after)) {
            snap_free(&after);
            snap_free(&before);
            return err ? err : "production source/compiler changed";
        }
        snap_free(&after);
    }
    snap_free(&before);
    return err;
}

int main(void) {
    const char *cwd_env = getenv("CSIH_APP");
    const char *reason;
    if (cwd_env && cwd_env[0]) snprintf(APP, sizeof APP, "%s", cwd_env);
    else if (!getcwd(APP, sizeof APP)) { printf("FAIL getcwd\n"); return 1; }
    if (APP[0] != '/') { printf("FAIL app dir must be absolute\n"); return 1; }
    reason = probe();
    if (reason) { printf("FAIL %s\n", reason); return 1; }
    printf("%s\n", PASS_LINE);
    return 0;
}
