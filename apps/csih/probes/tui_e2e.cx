#pragma unisa use text.fmt
#pragma unisa use sys.io
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use tmuxwit
/* tui_e2e.cx — the csih `run` TUI on a real tty (a private tmux pane), with
 * the same assertions the old pty witness (tui_e2e.py) made:
 *   bulk and per-character typing: the whole line reaches the transcript
 *   (role user, text, ts), a gate verdict is on screen, and the CLI dispatch
 *   ("unknown command") shows; one TUI driving three CLI lines (sh, write,
 *   read) shows the shell output and the file; every transcript line is JSON.
 *   cd apps/csih && unisacc -run probes/tui_e2e.cx
 * Needs CSIH_BIN (else ../../out/csih-e2e-bin/csih); HOME is a scratch dir, so
 * the user's ~/.csih history is not touched. No python.
 */

#define TEXT "hello from tui"

static char seen[1 << 18];
static int fail;

static void okf(const char *m) { sy_printf("  ok    %s\n", m); }
static void bad(const char *m) { sy_printf("  FAIL  %s\n", m); fail++; }

/* ── a JSON value, strictly enough to catch a torn or doubled record ───── */
static const char *js_ws(const char *p) { while (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n') p++; return p; }
static const char *js_value(const char *p, int depth);
static const char *js_string(const char *p) {
    if (*p++ != '"') return NULL;
    while (*p && *p != '"') {
        if ((unsigned char)*p < 0x20) return NULL;
        if (*p == '\\') {
            p++;
            if (*p == 'u') { int i; for (i = 1; i <= 4; i++) if (!isxdigit((unsigned char)p[i])) return NULL; p += 4; }
            else if (!strchr("\"\\/bfnrt", *p) || !*p) return NULL;
        }
        p++;
    }
    return *p == '"' ? p + 1 : NULL;
}
static const char *js_number(const char *p) {
    const char *s = p;
    if (*p == '-') p++;
    if (!isdigit((unsigned char)*p)) return NULL;
    while (isdigit((unsigned char)*p)) p++;
    if (*p == '.') { p++; if (!isdigit((unsigned char)*p)) return NULL; while (isdigit((unsigned char)*p)) p++; }
    if (*p == 'e' || *p == 'E') { p++; if (*p == '+' || *p == '-') p++; if (!isdigit((unsigned char)*p)) return NULL; while (isdigit((unsigned char)*p)) p++; }
    return p > s ? p : NULL;
}
static const char *js_value(const char *p, int depth) {
    if (depth > 64) return NULL;
    p = js_ws(p);
    if (*p == '"') return js_string(p);
    if (*p == '{' || *p == '[') {
        char close = *p == '{' ? '}' : ']';
        int obj = *p == '{';
        p = js_ws(p + 1);
        if (*p == close) return p + 1;
        for (;;) {
            if (obj) { p = js_string(js_ws(p)); if (!p) return NULL; p = js_ws(p); if (*p++ != ':') return NULL; }
            p = js_value(p, depth + 1);
            if (!p) return NULL;
            p = js_ws(p);
            if (*p == ',') { p++; continue; }
            return *p == close ? p + 1 : NULL;
        }
    }
    if (!strncmp(p, "true", 4)) return p + 4;
    if (!strncmp(p, "false", 5)) return p + 5;
    if (!strncmp(p, "null", 4)) return p + 4;
    return js_number(p);
}
static int js_line_ok(const char *line) {
    const char *e = js_value(line, 0);
    return e && !*js_ws(e);
}

/* ── one TUI run ──────────────────────────────────────────────────────── */
static const char *bin;
static char root[600], home[700], tr[700];

static void seed_transcript(void) {
    FILE *f = fopen(tr, "w");
    if (f) { fputs("{\"role\":\"model\",\"p\":0.830000}\n", f); fclose(f); }
}

/* Run `csih run TR` in a 70x24 pane, send each line, quit. After line i the
 * pane is watched until NEEDLES[i] shows (NULL: 1.5s). 1 when it drew a frame. */
static int run_tui(const char *sess, const char **lines, const char **needles, int n, int per_char, int *rc) {
    char env_home[760];
    char *cmd[] = { "env", env_home, "sh", "-c", "\"$0\" run \"$1\"; echo __RC=$?__; sleep 30", (char *)bin, tr };
    int i;
    seen[0] = 0;
    *rc = -1;
    tx_snprintf(env_home, sizeof env_home, "HOME=%s", home);
    if (tw_new(sess, 70, 24, root, cmd, 7) != 0) return 0;
    /* the first frame is the signal that a keystroke will be seen */
    if (!tw_wait_text(sess, "Ctrl-D", 8000, seen, sizeof seen)) return 0;
    for (i = 0; i < n; i++) {
        if (!tw_submit(sess, lines[i], per_char, seen + strlen(seen), (int)(sizeof seen - strlen(seen))))
            sy_printf("  note  %s: line %d never showed on the input line\n", sess, i + 1);
        tw_settle(sess, needles[i] ? 4000 : 1500, needles[i], seen + strlen(seen), (int)(sizeof seen - strlen(seen)));
    }
    tw_keys(sess, "C-c", 0);
    tw_sleep_ms(200);
    tw_keys(sess, "C-d", 0);
    *rc = tw_rc(sess, 3000);
    return 1;
}

/* The last user record in TR, or "". */
static void last_user(char *out, int cap) {
    char line[4096];
    FILE *f = fopen(tr, "r");
    out[0] = 0;
    if (!f) return;
    while (fgets(line, sizeof line, f))
        if (strstr(line, "\"user\"")) tx_snprintf(out, cap, "%s", line);
    fclose(f);
}

int main(void) {
    static const char *modes[2] = { "bulk (whole line in one write)", "per-character" };
    char cwd[512], absbin[700], hand[760], w[800], r[800], msg[600], last[4096];
    const char *tmp = sy_env("TMPDIR");
    const char *text[1] = { TEXT };
    const char *text_needle[1] = { "unknown command" };
    const char *hand_lines[3];
    const char *hand_needles[3] = { "csih-hand", NULL, "from-cli" };
    int m, rc, up;
    FILE *f;

    if (!getcwd(cwd, sizeof cwd)) return 2;
    bin = sy_env("CSIH_BIN");
    if (!bin || !bin[0]) { tx_snprintf(absbin, sizeof absbin, "%s/../../out/csih-e2e-bin/csih", cwd); bin = absbin; }
    if (access(bin, X_OK) != 0) { sy_printf("  FAIL  no csih binary at %s (csih.sh prepare)\n", bin); return 1; }
    if (!tw_open("e2e")) { sy_printf("  FAIL  tmux is not on PATH\n"); return 1; }
    tx_snprintf(root, sizeof root, "%s/csih-tuie-%d", tmp && tmp[0] ? tmp : "/tmp", (int)sy_pid());
    tx_snprintf(home, sizeof home, "%s/home", root);
    tx_snprintf(tr, sizeof tr, "%s/tui-e2e.jsonl", root);
    if (mkdir(root, 0700) != 0 || mkdir(home, 0700) != 0) { sy_printf("  FAIL  scratch %s\n", root); return 1; }

    for (m = 0; m < 2; m++) {
        char sess[8];
        tx_snprintf(sess, sizeof sess, "m%d", m);
        seed_transcript();
        up = run_tui(sess, text, text_needle, 1, m == 1, &rc);
        if (!up) {
            tx_snprintf(msg, sizeof msg, "%s: the program never drew a frame: %.200s", modes[m], seen);
            bad(msg);
            continue;
        }
        last_user(last, sizeof last);
        tx_snprintf(msg, sizeof msg, "%s: the full line reached the transcript (with ts)", modes[m]);
        if (strstr(last, "\"role\":\"user\"") && strstr(last, "\"text\":\"" TEXT "\"") && strstr(last, "\"ts\":")) okf(msg);
        else { tx_snprintf(msg, sizeof msg, "%s: transcript got %.300s", modes[m], last[0] ? last : "<nothing>"); bad(msg); }
        tx_snprintf(msg, sizeof msg, "%s: a verdict was rendered", modes[m]);
        if (strstr(seen, "CONTINUE") || strstr(seen, "STOP")) okf(msg);
        else { tx_snprintf(msg, sizeof msg, "%s: no verdict on screen", modes[m]); bad(msg); }
        tx_snprintf(msg, sizeof msg, "%s: cli dispatch showed on the tui", modes[m]);
        if (strstr(seen, "unknown command")) okf(msg);
        else { tx_snprintf(msg, sizeof msg, "%s: cli dispatch missing on screen", modes[m]); bad(msg); }
        tx_snprintf(msg, sizeof msg, "%s: Ctrl-C then Ctrl-D exits 0", modes[m]);
        if (rc == 0) okf(msg);
        else { tx_snprintf(msg, sizeof msg, "%s: exit after Ctrl-C, Ctrl-D was %d", modes[m], rc); bad(msg); }
    }

    /* One TUI process, three CLI lines: the shell line and the file the later read printed. */
    tx_snprintf(hand, sizeof hand, "%s/csih-e2e-hand.txt", root);
    tx_snprintf(w, sizeof w, "write %s from-cli", hand);
    tx_snprintf(r, sizeof r, "read %s", hand);
    hand_lines[0] = "sh echo csih-hand";
    hand_lines[1] = w;
    hand_lines[2] = r;
    seed_transcript();
    up = run_tui("hand", hand_lines, hand_needles, 3, 0, &rc);
    if (!up) bad("cli hand: the program never drew a frame");
    else if (strstr(seen, "csih-hand") && strstr(seen, "from-cli")) okf("cli hand: echo and read landed on the tui");
    else { tx_snprintf(msg, sizeof msg, "cli hand: screen missing tool output: %.240s", seen); bad(msg); }

    /* Every line must still be valid JSON. */
    f = fopen(tr, "r");
    if (!f) bad("no transcript was written at all");
    else {
        char line[8192];
        int n = 0, torn = 0;
        while (fgets(line, sizeof line, f)) {
            n++;
            if (!js_line_ok(line)) { tx_snprintf(msg, sizeof msg, "line %d is not JSON: %.200s", n, line); bad(msg); torn++; }
        }
        fclose(f);
        if (!torn && n >= 3) okf("every transcript line is valid JSON");
        else if (!torn) { tx_snprintf(msg, sizeof msg, "transcript has only %d lines", n); bad(msg); }
    }

    tw_close();
    if (cx_rmtree(root) != 0) sy_printf("  note  scratch %s left behind\n", root);
    return fail ? 1 : 0;
}
