#pragma unisa use u_run
/* errno_cover.cx — which errno names compile and print a number.
 *   unisacc probes/errno_cover.cx
 * Exit 0 only when every name below prints a number. No gcc. Upper root: no
 * #include; the generated c.c under test includes <errno.h>, which is the
 * thing measured. Its scratch goes through cx_rmtree (the deletion guard).
 */

static const char *names[] = {
    "EPERM","ENOENT","ESRCH","EINTR","EIO","ENXIO","E2BIG","ENOEXEC","EBADF",
    "ECHILD","EAGAIN","ENOMEM","EACCES","EFAULT","EBUSY","EEXIST","EXDEV",
    "ENODEV","ENOTDIR","EISDIR","EINVAL","ENFILE","EMFILE","ENOTTY","ETXTBSY",
    "EFBIG","ENOSPC","ESPIPE","EROFS","EMLINK","EPIPE","EDOM","ERANGE",
    "EDEADLK","ENAMETOOLONG","ENOLCK","ENOSYS","ENOTEMPTY","ELOOP","ENOTSUP",
    "EOVERFLOW","ECANCELED","EILSEQ",
};

static int is_num(const char *s) {
    if (!s || !*s) return 0;
    while (*s && *s != '\n') { if (*s < '0' || *s > '9') return 0; s++; }
    return 1;
}

/* 1 when OUT has a line "NAME=<digits>". */
static int printed(const char *out, const char *name) {
    const char *p = out;
    while (*p) {
        const char *a = p, *b = name;
        while (*b && *a == *b) { a++; b++; }
        if (!*b && *a == '=' && a[1] >= '0' && a[1] <= '9') return 1;
        while (*p && *p != '\n') p++;
        if (*p) p++;
    }
    return 0;
}

int main(void) {
    const char *u = getenv("UNISACC");
    char dir[4096], src[4200], body[160], out[512]; const char *td = getenv("TMPDIR");
    static char all[8192], allout[4096];
    int i, n, rc, have = 0, miss = 0, used;
    FILE *f;
    if (!u || !u[0]) u = "../../unisacc.com";
    n = (int)(sizeof names / sizeof names[0]);
    snprintf(dir, sizeof dir, "%s/cdsh-errno-%d", td && td[0] ? td : "/tmp", (int)getpid());   /* the guard's temp root */
    if (mkdir(dir, 0700) != 0) { printf("no temp\n"); return 2; }
    snprintf(src, sizeof src, "%s/c.c", dir);
    printf("MISSING:");
    /* One compile for all names first: 43 compiles took ~25s. Only when that
     * program fails does each name get its own compile, to name the missing. */
    used = snprintf(all, sizeof all, "#include <stdio.h>\n#include <errno.h>\nint main(void){\n");
    for (i = 0; i < n; i++)
        used += snprintf(all + used, sizeof all - (size_t)used, " printf(\"%s=%%d\\n\",(int)%s);\n", names[i], names[i]);
    used += snprintf(all + used, sizeof all - (size_t)used, " return 0; }\n");
    if (cx_write(src, all, (size_t)used) == 0) {
        char *args[1];
        args[0] = src;
        u_spawn(u, args, 1, NULL, allout, (int)sizeof allout, &rc);
        if (rc == 0) for (i = 0; i < n; i++) have += printed(allout, names[i]);
    }
    if (have == n) i = n;   /* every name printed a number: no per-name pass */
    else { have = 0; i = 0; }
    for (; i < n; i++) {
        char *args[1];
        snprintf(body, sizeof body,
            "#include <stdio.h>\n#include <errno.h>\nint main(void){ printf(\"%%d\\n\",(int)%s); return 0; }\n",
            names[i]);
        f = fopen(src, "w");
        if (!f) { miss++; printf(" %s", names[i]); continue; }
        fputs(body, f); fclose(f);
        args[0] = src;
        u_spawn(u, args, 1, NULL, out, (int)sizeof out, &rc);
        if (rc == 0 && is_num(out)) have++;
        else { miss++; printf(" %s", names[i]); }
    }
    if (cx_rmtree(dir) != 0) fprintf(stderr, "errno_cover: scratch %s left behind\n", dir);
    printf("\nunisacc errno coverage: %d defined, %d missing (of %d)\n", have, miss, n);
    return miss ? 1 : 0;
}
