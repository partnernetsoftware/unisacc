#pragma unisa use tmuxwit
/* CX probe root; lower includes kept (the port wait needs sockets) */
/* tui_agent_e2e.cx — the csih agent TUI end to end on a real tty (a private
 * tmux pane) against probes/agent-stub.cx: one prompt makes the stub ask for
 * `echo hello-from-agent`, the TUI runs it, the stub answers 完成了.
 *   cd apps/csih && unisacc -run probes/tui_agent_e2e.cx
 * Asserts, as the old pty witness (tui_agent_e2e.py) did, on the screen and
 * the transcript, and that the TUI exits 0 (now via Ctrl-C then Ctrl-D: an
 * idle Ctrl-C no longer quits). HOME is a scratch dir. No python.
 */
#include <arpa/inet.h>
#include <netinet/in.h>
#include <sys/socket.h>

#define TEXT "build the feature, then report"

static char seen[1 << 18];
static int fail;

static void okf(const char *m) { printf("  ok    %s\n", m); }
static void bad(const char *m) { printf("  FAIL  %s\n", m); fail++; }

static int wait_port(int port, int ms) {
    long until = tw_now_ms() + ms;
    while (tw_now_ms() < until) {
        int s = socket(AF_INET, SOCK_STREAM, 0);
        struct sockaddr_in a;
        if (s < 0) return -1;
        memset(&a, 0, sizeof a);
        a.sin_family = AF_INET;
        a.sin_port = htons((unsigned short)port);
        a.sin_addr.s_addr = htonl(0x7f000001);
        if (connect(s, (struct sockaddr *)&a, sizeof a) == 0) { close(s); return 0; }
        close(s);
        tw_sleep_ms(100);
    }
    return -1;
}

static int contains(const char *path, const char *needle) {
    static char buf[1 << 18];
    FILE *f = fopen(path, "r");
    size_t n;
    if (!f) return 0;
    n = fread(buf, 1, sizeof buf - 1, f);
    fclose(f);
    buf[n] = 0;
    return strstr(buf, needle) != NULL;
}

int main(void) {
    const char *u = getenv("UNISACC"), *bin = getenv("CSIH_BIN"), *tmp = getenv("TMPDIR");
    char cwd[512], absbin[700], root[600], home[700], work[700], tr[700], ep[128], portbuf[16], msg[600];
    char e_home[760], e_ep[200], e_cwd[760], e_tr[760];
    int port, rc, st;
    pid_t stub;

    if (!getcwd(cwd, sizeof cwd)) return 2;
    if (!u || !u[0]) u = "../../unisacc.com";
    if (!bin || !bin[0]) { snprintf(absbin, sizeof absbin, "%s/../../out/csih-e2e-bin/csih", cwd); bin = absbin; }
    if (access(bin, X_OK) != 0) { printf("  FAIL  no csih binary at %s (csih.sh prepare)\n", bin); return 1; }
    if (!tw_open("agente2e")) { printf("  FAIL  tmux is not on PATH\n"); return 1; }
    snprintf(root, sizeof root, "%s/csih-tuia-%d", tmp && tmp[0] ? tmp : "/tmp", (int)getpid());
    snprintf(home, sizeof home, "%s/home", root);
    snprintf(work, sizeof work, "%s/work", root);
    snprintf(tr, sizeof tr, "%s/tr.jsonl", root);
    if (mkdir(root, 0700) || mkdir(home, 0700) || mkdir(work, 0700)) { printf("  FAIL  scratch %s\n", root); return 1; }

    port = 21000 + (int)getpid() % 20000;
    snprintf(portbuf, sizeof portbuf, "%d", port);
    stub = fork();
    if (stub == 0) {
        char *av[] = { "sh", (char *)u, "-run", "probes/agent-stub.cx", "--", portbuf, NULL };
        execv("/bin/sh", av);   /* APE needs /bin/sh as its loader */
        _exit(127);
    }
    if (wait_port(port, 20000) != 0) {   /* the stub is compiled first (~4s) */
        bad("agent-stub.cx did not listen");
        kill(stub, SIGKILL); waitpid(stub, &st, 0);
        tw_close(); cx_rmtree(root);
        return 1;
    }

    snprintf(ep, sizeof ep, "http://127.0.0.1:%d/v1/chat/completions", port);
    snprintf(e_home, sizeof e_home, "HOME=%s", home);
    snprintf(e_ep, sizeof e_ep, "CSIH_ENDPOINT=%s", ep);
    snprintf(e_cwd, sizeof e_cwd, "CSIH_CWD=%s", work);
    snprintf(e_tr, sizeof e_tr, "CSIH_TRANSCRIPT=%s", tr);
    {
        char *cmd[] = { "env", e_home, e_ep, "CSIH_MODEL=stub", e_cwd, e_tr, "CSIH_BELL=0",
                        "sh", "-c", "\"$0\" agent; echo __RC=$?__; sleep 30", (char *)bin };
        if (tw_new("a", 100, 30, work, cmd, 11) != 0) bad("tmux new-session");
    }
    if (!fail && !tw_wait_text("a", "Enter 发送", 8000, seen, sizeof seen)) {
        snprintf(msg, sizeof msg, "the program never drew a frame: %.200s", seen);
        bad(msg);
    }
    if (!fail) {
        if (!tw_submit("a", TEXT, 0, seen + strlen(seen), (int)(sizeof seen - strlen(seen))))
            printf("  note  the prompt never showed on the input line\n");
        if (!tw_settle("a", 15000, "完成了", seen + strlen(seen), (int)(sizeof seen - strlen(seen))))
            printf("  note  no answer on screen within 15s\n");
        tw_keys("a", "C-c", 0);
        tw_sleep_ms(200);
        tw_keys("a", "C-d", 0);
        rc = tw_rc("a", 3000);

        {
            static const char *on_screen[3] = { "hello-from-agent", "完成了", TEXT };
            int i, ok = 1;
            for (i = 0; i < 3; i++)
                if (!strstr(seen, on_screen[i])) { snprintf(msg, sizeof msg, "screen missing '%s'", on_screen[i]); bad(msg); ok = 0; }
            if (!contains(tr, "hello-from-agent")) { bad("transcript missing the exec output 'hello-from-agent'"); ok = 0; }
            /* the judge path writes role=decision go=stop; a stub answer may end it too (as agent_roundtrip) */
            if (!contains(tr, "\"role\":\"decision\",\"go\":\"stop\"") && !contains(tr, "\\\"act\\\":\\\"answer\\\"")) { bad("transcript has no terminal act"); ok = 0; }
            if (!contains(tr, "完成了")) { bad("transcript missing the answer '完成了'"); ok = 0; }
            if (rc != 0) { snprintf(msg, sizeof msg, "tui exit after Ctrl-C, Ctrl-D was %d", rc); bad(msg); ok = 0; }
            if (ok) okf("agent ran in the TUI (exec -> answer), screen and transcript agree, exit 0");
        }
    }

    tw_close();
    kill(stub, SIGTERM);
    waitpid(stub, &st, 0);
    if (cx_rmtree(root) != 0) printf("  note  scratch %s left behind\n", root);
    return fail ? 1 : 0;
}
