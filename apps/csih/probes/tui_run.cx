#pragma unisa use u_run
/* CX probe root; lower includes kept */
/* tui_run.cx — run each TUI question probe under unisacc only.
 *   unisacc.com -run probes/tui_run.cx
 * All six questions are expected green under current unisacc (sigaction covered).
 * Upper root: no #include (stdio, stdlib, string and unistd are in the cx prelude).
 */


static const char *src[] = {
    "probes/tui-terms.cx", "probes/tui-terms.cx", "probes/tui-terms.cx",
    "probes/tui-terms.cx", "probes/tui-q5-signal.cx", "probes/tui-q5-sigaction.cx",
};
static const char *sub[] = {
    "q1-cfmakeraw", "q2-layout", "q3-winsize", "q4-poll", "run", "run",
};
int main(void) {
    const char *u = getenv("UNISACC");
    char out[1024], line[200];
    int i, rc, bad = 0;
    if (!u || !u[0]) u = "../../unisacc.com";
    printf("%-28s %-40s %s\n", "question", "unisacc", "note");
    for (i = 0; i < 6; i++) {
        char *args[4];
        size_t k = 0;
        const char *path = src[i];
        if (access(path, 0) != 0) path = src[i] + 7; /* probes/ stripped */
        args[0] = (char *)"-run";
        args[1] = (char *)path;
        args[2] = (char *)"--";
        args[3] = (char *)sub[i];
        u_spawn(u, args, 4, NULL, out, (int)sizeof out, &rc);
        while (out[k] && out[k] != '\n' && k + 1 < sizeof line) { line[k] = out[k]; k++; }
        line[k] = 0;
        if (rc == 0) {
            printf("%-28s %-40s %s\n", sub[i], line, "unisacc-ok");
        } else {
            printf("%-28s %-40s %s\n", sub[i], line, "UNISACC RED");
            bad++;
        }
    }
    printf("\nall six TUI questions green\n");
    return bad ? 1 : 0;
}
