/* CX probe */
/* reload_session.cx -- CX port of probes/reload_session.py.
 * Strict undeployed v2 automatic-execution state through the real session CLI
 * (roundtrip mode of reload_session_cli.cx).
 *
 * Builds reload_session_cli.cx once, then runs `CLI roundtrip FIXTURE` per case
 * from apps/csih; compiler $UNISACC, else APP/../../unisacc.com. One build instead
 * of -run per case: measured 2026-10-30, one -run costs ~6.6 s of compile, so 12
 * run-mode cases (~80 s) cannot fit the contract's 40 s budget. The binary lives in
 * the probe's mkdtemp dir and is removed with it; nothing is cached across runs.
 * Processes through cx_runv_timeout (own process group, killed past the limit);
 * no libc string calls (tests/cxraw.cx ratchet).
 *
 * As the Python: per case limit 4 s, stderr must be empty, and the sources plus
 * the compiler must hash (sha256) the same before and after.
 *
 * Deviations from the Python original:
 *   - the sources are the .cx modules the CLI builds from (json.cx, reload_state.cx,
 *     reload_session.cx and its decode/encode units);
 *   - the Python compared json.loads(restored) == json.loads(raw). Without a JSON
 *     parser in the probe, valid cases check the restored output (whitespace
 *     removed) for each field as a `"key":value` token, so key order and spacing
 *     are not part of the verdict. Failure cases compare the FAIL line exactly.
 */

#define SHA_A "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
#define CLI_SRC "reload_session_cli.cx"

static char APP[1024], UNI[1200], BIN[1100], FIX[1100], ERRF[1100];

static const char *const WATCH_NAMES[] = {
    "json.cx", "reload_state.cx", "reload_session.cx", "reload_session_decode.cx",
    "reload_session_encode.cx", CLI_SRC, "reload_session.h", NULL
};
#define NWATCH 8
static char WATCH[NWATCH][1200];

/* z-string helpers without libc string calls */
static long slen(const char *s) { long n = 0; while (s[n]) n++; return n; }
static int same(const char *a, const char *b) {
    while (*a && *a == *b) { a++; b++; }
    return *a == *b;
}
static int has(const char *s, const char *p) {
    long n = slen(s), pn = slen(p), i, j;
    for (i = 0; i + pn <= n; i++) {
        for (j = 0; j < pn && s[i + j] == p[j]; j++) {}
        if (j == pn) return 1;
    }
    return 0;
}

/* APP = cwd; UNI = $UNISACC or APP/../../unisacc.com; 0 when all watched files exist */
static int locate(void) {
    const char *e = getenv("UNISACC");
    struct stat st;
    int i;
    if (!getcwd(APP, sizeof APP)) { printf("FAIL: getcwd: %s\n", strerror(errno)); return -1; }
    if (e && e[0]) snprintf(UNI, sizeof UNI, "%s", e);
    else snprintf(UNI, sizeof UNI, "%s/../../unisacc.com", APP);
    for (i = 0; WATCH_NAMES[i]; i++) snprintf(WATCH[i], sizeof WATCH[i], "%s/%s", APP, WATCH_NAMES[i]);
    snprintf(WATCH[i], sizeof WATCH[i], "%s", UNI);
    for (i = 0; i < NWATCH; i++)
        if (stat(WATCH[i], &st) != 0) { printf("FAIL: %s: %s\n", WATCH[i], strerror(errno)); return -1; }
    return 0;
}

static int sha_file(const char *path, char hex[65]) {
    size_t n = 0;
    char *b = cx_read(path, &n);
    if (!b) { hex[0] = 0; return 0; }
    cx_sha256_hex(b, n, hex);
    free(b);
    return 1;
}

static void hashes_take(char out[][65]) {
    int i;
    for (i = 0; i < NWATCH; i++) sha_file(WATCH[i], out[i]);
}

static int hashes_same(char before[][65]) {
    int i;
    char h[65];
    for (i = 0; i < NWATCH; i++)
        if (!sha_file(WATCH[i], h) || !same(h, before[i])) return 0;
    return 1;
}

/* ARGS (NULL-terminated, at most 6) under /bin/sh, stdout into OUT and stderr into ERR
 * (via the file ERRF), SECS limit (process group killed past it). 0 with *rc; -2 timeout; -1 error. */
static int run_split(char **args, int secs, char *out, size_t cap, char *err, size_t errcap, int *rc) {
    char *argv[12], *o = NULL;
    size_t n = 0, i;
    int k, r;
    argv[0] = (char *)"/bin/sh"; argv[1] = (char *)"-c";
    argv[2] = (char *)"f=$1; shift; exec \"$@\" 2>\"$f\""; argv[3] = (char *)"sh"; argv[4] = ERRF;
    for (k = 0; k < 6 && args[k]; k++) argv[5 + k] = args[k];
    argv[5 + k] = NULL;
    r = cx_runv_timeout(argv, secs, &o, &n);
    out[0] = 0; err[0] = 0;
    if (o) {
        if (n + 1 > cap) n = cap - 1;
        for (i = 0; i < n; i++) out[i] = o[i];
        out[n] = 0;
        free(o);
    }
    if (r == 124) return -2;
    if (r < 0) return -1;
    {   /* a missing stderr file means sh could not redirect: an error, not empty stderr */
        char *e = cx_read(ERRF, &n);
        if (!e) return -1;
        if (n + 1 > errcap) n = errcap - 1;
        for (i = 0; i < n; i++) err[i] = e[i];
        err[n] = 0;
        free(e);
    }
    *rc = r;
    return 0;
}

static int build(const char *dir) {
    char *args[8];
    static char out[8192], err[8192];
    int rc = 0, r;
    snprintf(BIN, sizeof BIN, "%s/reload_session_cli", dir);
    args[0] = (char *)"/bin/sh"; args[1] = UNI; args[2] = (char *)CLI_SRC;
    args[3] = (char *)"-o"; args[4] = BIN; args[5] = NULL;
    r = run_split(args, 30, out, sizeof out, err, sizeof err, &rc);
    if (r != 0 || rc != 0) {
        printf("FAIL build: %s rc %d | %.300s | %.300s\n", r == -2 ? "timeout" : "exit", rc, out, err);
        return -1;
    }
    return 0;
}

/* Remove all whitespace in place. */
static void squeeze(char *s) {
    char *w = s, *r = s;
    while (*r) { if (*r != ' ' && *r != '\n' && *r != '\t' && *r != '\r') *w++ = *r; r++; }
    *w = 0;
}

/* state fixture as json.dumps(state) renders it. loop_on/loop_left NULL = omit;
 * extra is appended before the closing brace (duplicate/unknown key cases). */
static void state_json(char *buf, size_t cap, const char *loop_on, const char *loop_left, const char *extra) {
    char on[64], left[64];
    if (loop_on) snprintf(on, sizeof on, "\"loop_on\": %s, ", loop_on); else on[0] = 0;
    if (loop_left) snprintf(left, sizeof left, "\"loop_left\": %s, ", loop_left); else left[0] = 0;
    snprintf(buf, cap,
             "{\"version\": 2, \"session_id\": \"sess\", \"handoff_id\": \"h1\", "
             "\"candidate_hash\": \"%s\", \"goal\": \"目标\", %s%s"
             "\"cwd\": \"/tmp\", \"role\": \"agent\", \"peer\": \"\", \"input\": \"输入\", "
             "\"journal\": {\"path\": \"/tmp/session.jsonl\", \"offset\": 0}, "
             "\"pending_queue\": [\"待办\"], \"history\": [\"历史\"], \"history_pos\": 1, "
             "\"history_browsing\": false, \"history_draft\": \"草稿\"%s}",
             SHA_A, on, left, extra ? extra : "");
}

static int failed = 0, passed = 0;

/* Run one fixture. reason NULL: must PASS and restored output must contain every
 * whitespace-free token in tokens[] (NULL-terminated). */
static void run_case(const char *name, const char *raw, const char *reason,
                     const char *const *tokens) {
    char *args[4];
    static char out[8192], err[2048], norm[8192];
    int rc = 0, ok = 1, i, r;
    if (cx_write(FIX, raw, (size_t)slen(raw)) != 0) { printf("FAIL %s: fixture write\n", name); failed++; return; }
    args[0] = BIN; args[1] = (char *)"roundtrip"; args[2] = FIX; args[3] = NULL;
    r = run_split(args, 4, out, sizeof out, err, sizeof err, &rc);
    if (r != 0) { printf("FAIL %s: %s\n", name, r == -2 ? "timeout" : "run error"); failed++; return; }
    if (err[0]) { printf("FAIL %s: stderr: %.200s\n", name, err); failed++; return; }
    if (reason) {
        long k = slen(out);
        char want[300];
        while (k && (out[k - 1] == '\n' || out[k - 1] == ' ')) out[--k] = 0;
        snprintf(want, sizeof want, "FAIL decode_v2 input: %s", reason);
        if (rc != 1 || !same(out, want)) { ok = 0; printf("FAIL %s: rc %d out=%s\n", name, rc, out); }
    } else {
        if (rc != 0 || !(out[0] == 'P' && out[1] == 'A' && out[2] == 'S' && out[3] == 'S' && out[4] == '\n')) {
            ok = 0; printf("FAIL %s: rc %d out=%.200s\n", name, rc, out);
        } else {
            snprintf(norm, sizeof norm, "%s", out + 5);
            squeeze(norm);
            if (tokens) {
                for (i = 0; tokens[i]; i++) {
                    if (!has(norm, tokens[i])) { ok = 0; printf("FAIL %s: missing %s\n", name, tokens[i]); break; }
                }
            }
        }
    }
    if (ok) { printf("PASS %s\n", name); passed++; } else failed++;
}

/* Field tokens of the valid state, whitespace-free. Static lists: no local pointer arrays. */
#define BASE_TOKENS \
    "\"version\":2", "\"session_id\":\"sess\"", "\"handoff_id\":\"h1\"", \
    "\"candidate_hash\":\"" SHA_A "\"", "\"goal\":\"目标\"", "\"cwd\":\"/tmp\"", \
    "\"role\":\"agent\"", "\"peer\":\"\"", "\"input\":\"输入\"", \
    "\"journal\":{\"path\":\"/tmp/session.jsonl\",\"offset\":0}", "\"pending_queue\":[\"待办\"]", \
    "\"history\":[\"历史\"]", "\"history_pos\":1", "\"history_browsing\":false", \
    "\"history_draft\":\"草稿\""

static const char *const TOK_TRUE[] = { BASE_TOKENS, "\"loop_on\":true", "\"loop_left\":8", NULL };
static const char *const TOK_FALSE[] = { BASE_TOKENS, "\"loop_on\":false", "\"loop_left\":8", NULL };
static const char *const TOK_ZERO[] = { BASE_TOKENS, "\"loop_on\":true", "\"loop_left\":0", NULL };

int main(void) {
    char tmpl[1024];   /* under the temp root: the deletion guard's whitelist */
    char *tmp;
    static char raw[4096], buf[4096];
    char before[NWATCH][65];
    int rc = 1;
    const char *td = getenv("TMPDIR");

    if (locate() != 0) { puts("RESULT FAIL reload_session"); return 1; }
    snprintf(tmpl, sizeof tmpl, "%s/csih-session-loop-XXXXXX", td && td[0] ? td : "/tmp");
    hashes_take(before);
    tmp = mkdtemp(tmpl);
    if (!tmp) { printf("FAIL mkdtemp: %s\n", strerror(errno)); return 1; }
    snprintf(FIX, sizeof FIX, "%s/state.json", tmp);
    snprintf(ERRF, sizeof ERRF, "%s/cli.stderr", tmp);
    if (build(tmp) != 0) goto done;

    state_json(raw, sizeof raw, "true", "8", NULL);
    run_case("True", raw, NULL, TOK_TRUE);
    state_json(raw, sizeof raw, "false", "8", NULL);
    run_case("False", raw, NULL, TOK_FALSE);
    state_json(raw, sizeof raw, NULL, "8", NULL);
    run_case("missing", raw, "missing: loop_on", NULL);
    state_json(raw, sizeof raw, "0", "8", NULL);
    run_case("number0", raw, "loop_on: not bool", NULL);
    state_json(raw, sizeof raw, "1", "8", NULL);
    run_case("number1", raw, "loop_on: not bool", NULL);
    state_json(raw, sizeof raw, "true", "8", ", \"loop_on\": false");
    run_case("duplicate", raw, "loop_on: duplicate", NULL);
    state_json(buf, sizeof buf, "true", "8", ", \"bogus\": 1");
    run_case("unknown", buf, "unknown key: bogus", NULL);
    state_json(raw, sizeof raw, "true", "0", NULL);
    run_case("true_zero", raw, NULL, TOK_ZERO);
    state_json(raw, sizeof raw, "true", NULL, NULL);
    run_case("missing_left", raw, "missing: loop_left", NULL);
    state_json(raw, sizeof raw, "true", "1.5", NULL);
    run_case("fraction_left", raw, "loop_left: not integer", NULL);
    state_json(raw, sizeof raw, "true", "9", NULL);
    run_case("range_left9", raw, "loop_left: not number in 0..8", NULL);
    state_json(raw, sizeof raw, "true", "1e+300", NULL);
    run_case("range_left1e300", raw, "loop_left: not number in 0..8", NULL);

    printf("TOTAL: %d passed, %d failed\n", passed, failed);
    rc = (failed == 0 && passed == 12) ? 0 : 1;
done:
    cx_rmtree(tmp);   /* through the one deletion guard; a refusal is reported on stderr */
    if (!hashes_same(before)) { printf("FAIL: source/compiler changed during probe\n"); rc = 1; }
    else if (rc == 0) printf("source/compiler hashes unchanged\n");
    printf("RESULT %s reload_session\n", rc == 0 ? "PASS" : "FAIL");
    return rc;
}
