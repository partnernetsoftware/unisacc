#pragma unisa use fswit
/* context_index_fixture.cx -- C port of context_index_fixture.py (dev only, same output tree).
 * Usage: context_index_fixture DIR
 * Builds an owned mailbox under DIR with two notices in inbox/done, private modes,
 * fixed mtimes. Notice A is short and multibyte; notice B exceeds the 256-byte preview.
 *   sh unisacc.com fixtures/context_index_fixture.cx -- DIR
 * Upper root: no #include; file times are fswit's (<sys/time.h>).
 */

#define SESSION "csih2"

struct notice {
    const char *id;
    long mtime;
    const char *body;   /* raw UTF-8 (ensure_ascii=False) */
};

static char body_b[301];

static const struct notice NOTICES_T[] = {
    {"0123456789abcdef0123456789abcdef", 1700000100, "hello 中文"},
    {"fedcba9876543210fedcba9876543210", 1700000200, body_b},
};

static void die(const char *msg) {
    fprintf(stderr, "%s\n", msg);
    exit(1);
}

/* os.makedirs(path, mode=0o700, exist_ok=True) followed by os.chmod(path, 0o700) */
static void make_dirs(const char *path) {
    char buf[4096];
    size_t i, n = strlen(path);
    if (n >= sizeof buf) die("path too long");
    memcpy(buf, path, n + 1);
    for (i = 1; i <= n; i++) {
        if (buf[i] == '/' || buf[i] == '\0') {
            char saved = buf[i];
            buf[i] = '\0';
            if (mkdir(buf, 0700) != 0 && errno != EEXIST) die("mkdir failed");
            buf[i] = saved;
        }
    }
    if (chmod(path, 0700) != 0) die("chmod failed");
}

/* JSON for {"body","id","kind","session","version"} with sort_keys, compact separators, ensure_ascii=False */
static size_t envelope(char *out, size_t cap, const char *mid, const char *body) {
    size_t n = 0;
    const unsigned char *p;
    int w;
    w = snprintf(out + n, cap - n, "{\"body\":\"");
    n += (size_t)w;
    for (p = (const unsigned char *)body; *p; p++) {
        char esc[8];
        if (*p == '"') snprintf(esc, sizeof esc, "\\\"");
        else if (*p == '\\') snprintf(esc, sizeof esc, "\\\\");
        else if (*p == '\n') snprintf(esc, sizeof esc, "\\n");
        else if (*p == '\r') snprintf(esc, sizeof esc, "\\r");
        else if (*p == '\t') snprintf(esc, sizeof esc, "\\t");
        else if (*p < 0x20) snprintf(esc, sizeof esc, "\\u%04x", *p);
        else { esc[0] = (char)*p; esc[1] = '\0'; }
        if (n + strlen(esc) + 1 >= cap) die("envelope overflow");
        snprintf(out + n, cap - n, "%s", esc);   /* fits: checked above */
        n += strlen(esc);
    }
    w = snprintf(out + n, cap - n, "\",\"id\":\"%s\",\"kind\":\"notice\",\"session\":\"%s\",\"version\":1}", mid, SESSION);
    n += (size_t)w;
    if (n >= cap) die("envelope overflow");
    return n;
}

int main(int argc, char **argv) {
    char path[4096], envbuf[8192];
    size_t i;
    int fd;
    const char *root;

    if (argc != 2) die("usage: context_index_fixture DIR");
    root = argv[1];
    if (root[0] != '/') die("DIR must be absolute");

    /* body B: 300 bytes of 'x' (exceeds the 256-byte preview) */
    memset(body_b, 'x', 300);
    body_b[300] = '\0';

    make_dirs(root);
    {
        static const char *const dirs[] = {"inbox", "inbox/ready", "inbox/started", "inbox/done"};
        for (i = 0; i < sizeof dirs / sizeof *dirs; i++) {
            snprintf(path, sizeof path, "%s/%s", root, dirs[i]);
            make_dirs(path);
        }
    }

    /* open(lock, 'a').close(); chmod 0600 */
    snprintf(path, sizeof path, "%s/inbox/mailbox.lock", root);
    fd = open(path, O_WRONLY | O_CREAT | O_APPEND, 0666);
    if (fd < 0) die("lock open failed");
    close(fd);
    if (chmod(path, 0600) != 0) die("lock chmod failed");

    for (i = 0; i < sizeof NOTICES_T / sizeof *NOTICES_T; i++) {
        size_t len = envelope(envbuf, sizeof envbuf, NOTICES_T[i].id, NOTICES_T[i].body);
        ssize_t w;
        snprintf(path, sizeof path, "%s/inbox/done/%s.json", root, NOTICES_T[i].id);
        fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0666);
        if (fd < 0) die("notice open failed");
        w = write(fd, envbuf, len);
        close(fd);
        if (w != (ssize_t)len) die("notice write failed");
        if (chmod(path, 0600) != 0) die("notice chmod failed");
        if (fw_set_mtime(path, NOTICES_T[i].mtime) != 0) die("notice utimes failed");
    }
    return 0;
}
