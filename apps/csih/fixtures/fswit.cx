#pragma unisa module fswit
/*
 * fswit.cx — file-time setting for the fixture builder, so its root stays
 * include-free. Lower: utimes and struct timeval live in <sys/time.h>,
 * which the cx prelude does not carry.
 */
#include <sys/time.h>

/* Set PATH's access and modification time to SEC (whole seconds). 0 on success. */
int fw_set_mtime(const char *path, long sec) {
    struct timeval tv[2];
    tv[0].tv_sec = tv[1].tv_sec = (time_t)sec;
    tv[0].tv_usec = tv[1].tv_usec = 0;
    return utimes(path, tv);
}
