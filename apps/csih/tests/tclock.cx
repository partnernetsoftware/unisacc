#pragma unisa module tclock
/*
 * tclock.cx — the one thing the test runner needs that the implicit runtime
 * lacks: a monotonic clock. Lower: the include is that clock.
 */
#include <time.h>

long tc_now_ms(void) {
    struct timespec t;
    clock_gettime(CLOCK_MONOTONIC, &t);
    return (long)t.tv_sec * 1000 + t.tv_nsec / 1000000;
}
