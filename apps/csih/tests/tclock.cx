#pragma unisa module tclock
#pragma unisa use sys.time
#pragma unisa use sys.env
/*
 * tclock.cx — the monotonic clock and getenv the test runner needs, through
 * cx/sys (sy_now_ms, sy_env); no #include.
 */

long tc_now_ms(void) { return sy_now_ms(); }

/* Same as getenv; kept here so the upper runner never calls it directly. */
const char *tc_getenv(const char *name) { return sy_env(name); }
