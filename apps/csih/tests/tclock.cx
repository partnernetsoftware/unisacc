#pragma unisa module tclock
/*
 * tclock.cx — host bits the test runner needs that the implicit runtime
 * lacks: a monotonic clock and getenv. Lower: the includes below.
 */
#include <stdlib.h>
#include <time.h>

long tc_now_ms(void) {
    struct timespec t;
    clock_gettime(CLOCK_MONOTONIC, &t);
    return (long)t.tv_sec * 1000 + t.tv_nsec / 1000000;
}

/* Same as getenv; kept here so the upper runner never calls it directly. */
const char *tc_getenv(const char *name) {
    return getenv(name);
}
