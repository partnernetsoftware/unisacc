#pragma unisa use tclock
#pragma unisa use text.text
/*
 * tests/run.cx — csih's own test entry (csih is a small product of its own;
 * the repository's tests/run.cx is unisacc's).
 *   sh unisacc.com apps/csih/tests/run.cx -- --list | --smoke | --all | --layer L | --run ID... | --selftest
 *
 * Contracts live in tests/contracts.tsv, one per row, tab separated:
 *   id  layer  status  smoke  budget_s  argv  expect  source
 * status: IMPLEMENTED (run it), GAP (no test exists for a known contract),
 * BLOCKED (the feature cannot be built yet), ENV (a test exists but needs an
 * environment this runner does not provide). Only IMPLEMENTED rows run;
 * the others are reported, never counted as PASS.
 * argv: space separated, cwd apps/csih; "U" is the repository's unisacc.com
 * (an APE, so it is run through sh). expect: "rc0", or "rc0+text:S" (S must
 * also be in the output). Rows with the same argv share one execution.
 *
 * Verdicts: --smoke rc 0 iff every smoke row passes. --all rc 0 iff every
 * IMPLEMENTED row passes AND there is no GAP/BLOCKED/ENV row (coverage is
 * then complete); otherwise 1 on a failure, 3 when only coverage is missing.
 * Each run is bounded by its row's budget (<= 55s); every result carries its
 * seconds. Nothing is cached across runs.
 *
 * L3 on L0 only (plans/cx-layers.md): strings via text.text; clock/env via
 * tclock; cx_read / cx_runv_timeout from the cx.h prelude.
 */

#define MAXC 160
#define CAP 4200

typedef struct {
    char *id, *layer, *status, *smoke, *argv, *expect, *source;
    int budget;
    int verdict;          /* 0 not run, 1 pass, 2 fail, 3 timeout */
    long ms;
    int rc;
    int shared;           /* index of the row whose run this one reuses, or -1 */
} contract;

static contract cs[MAXC];
static int nc;
static char unisacc[4096], env_unisacc[4200], env_bin[4200];
static const contract zc;

typedef struct { int pass, fail, timeout, gap, blocked, env, run; long ms; } tally;
static const tally zt;

static int eq(const char *a, const char *b) { return tx_eq(a, b, CAP); }

static char *field(char **p) {
    char *s = *p;
    long n, off;
    if (!s) return NULL;
    n = tx_len(s, CAP);                 /* stops at the NUL we put on the line */
    if (n < 0) return NULL;
    off = tx_chr(s, n, '\t');
    if (off >= 0) { s[off] = 0; *p = s + off + 1; } else *p = NULL;
    return s;
}

/* 0, or a reason in WHY. TEXT is modified in place and must outlive cs[]. */
static int parse_registry(char *text, char *why, int whyn) {
    char *line = text;
    int lineno = 0;
    long tn = tx_len(text, 1L << 30);
    char *end = tn < 0 ? text : text + tn;
    nc = 0;
    while (line < end) {
        long off = tx_chr(line, (long)(end - line), '\n');
        char *nl = off < 0 ? 0 : line + off;
        contract *c;
        char *p;
        lineno++;
        if (nl) *nl = 0;
        if (line[0] == '#' || !line[0]) { line = nl ? nl + 1 : end; continue; }
        if (nc >= MAXC) { snprintf(why, whyn, "more than %d contracts", MAXC); return 1; }
        c = &cs[nc];
        *c = zc;
        p = line;
        c->id = field(&p); c->layer = field(&p); c->status = field(&p); c->smoke = field(&p);
        { char *b = field(&p); c->budget = b ? atoi(b) : 0; }
        c->argv = field(&p); c->expect = field(&p); c->source = field(&p);
        if (!c->source || p) { snprintf(why, whyn, "line %d: want 8 tab-separated fields", lineno); return 1; }
        if (!eq(c->status, "IMPLEMENTED") && !eq(c->status, "GAP") && !eq(c->status, "BLOCKED") && !eq(c->status, "ENV")) {
            snprintf(why, whyn, "line %d: status %s", lineno, c->status); return 1;
        }
        if (!eq(c->smoke, "smoke") && !eq(c->smoke, "-")) { snprintf(why, whyn, "line %d: smoke column %s", lineno, c->smoke); return 1; }
        if (eq(c->status, "IMPLEMENTED")) {
            if (c->budget < 1 || c->budget > 55) { snprintf(why, whyn, "line %d: budget %d not in 1..55", lineno, c->budget); return 1; }
            if (eq(c->argv, "-")) { snprintf(why, whyn, "line %d: IMPLEMENTED without argv", lineno); return 1; }
            if (!eq(c->expect, "rc0") && !tx_prefix(c->expect, tx_len(c->expect, CAP), "rc0+text:", 9)) {
                snprintf(why, whyn, "line %d: expect %s", lineno, c->expect); return 1;
            }
        } else if (eq(c->smoke, "smoke")) { snprintf(why, whyn, "line %d: a %s row cannot be smoke", lineno, c->status); return 1; }
        {
            int j;
            for (j = 0; j < nc; j++) if (eq(cs[j].id, c->id)) { snprintf(why, whyn, "line %d: duplicate id %s", lineno, c->id); return 1; }
        }
        c->shared = -1;
        nc++;
        line = nl ? nl + 1 : end;
    }
    if (!nc) { snprintf(why, whyn, "no contracts"); return 1; }
    return 0;
}

/* The last non-empty line of OUT, into LINE. */
static void tail_line(const char *out, size_t n, char *line, int cap) {
    size_t e = n, b;
    while (e > 0 && (out[e - 1] == '\n' || out[e - 1] == '\r' || out[e - 1] == ' ')) e--;
    b = e;
    while (b > 0 && out[b - 1] != '\n') b--;
    snprintf(line, cap, "%.*s", (int)(e - b), out + b);
    { char *t; for (t = line; *t; t++) if (*t == '\t') *t = ' '; }
}

static int has_text(const char *hay, const char *needle) {
    long hn, nn;
    if (!hay || !needle) return 0;
    hn = tx_len(hay, 1L << 30);
    nn = tx_len(needle, CAP);
    if (hn < 0 || nn < 0) return 0;
    return tx_find(hay, hn, needle, nn) >= 0;
}

static int judge(const contract *c, int rc, const char *out) {
    if (rc != 0) return 2;
    if (tx_prefix(c->expect, tx_len(c->expect, CAP), "rc0+text:", 9) && !has_text(out, c->expect + 9)) return 2;
    return 1;
}

static void run_one(int i) {
    static char buf[4096];
    contract *c = &cs[i];
    char *av[40], line[200], *out = NULL, *t;
    size_t on = 0;
    int n = 0, j;
    long t0;
    snprintf(buf, sizeof buf, "%s", c->argv);
    /* Every contract sees the same UNISACC and CSIH_BIN. Probes fall back to
     * a path from another machine without UNISACC; unisacc's setenv() does
     * not reach a child, so they go in through env(1). */
    av[n++] = "env";
    av[n++] = env_unisacc;
    av[n++] = env_bin;
    av[n++] = "sh";
    for (t = strtok(buf, " "); t && n < 39; t = strtok(NULL, " ")) {
        if (eq(t, "U")) av[n++] = unisacc;
        else if (n == 4 && eq(t, "sh")) continue;   /* "sh x.sh": sh is already there */
        else av[n++] = t;
    }
    av[n] = NULL;
    t0 = tc_now_ms();
    c->rc = cx_runv_timeout(av, c->budget, &out, &on);
    c->ms = tc_now_ms() - t0;
    if (c->rc == 124) c->verdict = 3;
    else c->verdict = judge(c, c->rc, out);
    tail_line(out ? out : "", on, line, sizeof line);
    printf("RESULT\t%s\t%s\tseconds=%ld.%02ld\trc=%d\tlayer=%s\t%s\n", c->id,
           c->verdict == 1 ? "PASS" : c->verdict == 3 ? "TIMEOUT" : "FAIL",
           c->ms / 1000, (c->ms % 1000) / 10, c->rc, c->layer, line);
    /* rows sharing this argv are judged on the same output, now.
     * out is a process-lifetime buffer from the cx.h prelude (no free). */
    for (j = i + 1; j < nc; j++) {
        contract *d = &cs[j];
        if (d->verdict || !eq(d->status, "IMPLEMENTED") || !eq(d->argv, c->argv)) continue;
        d->shared = i;
        d->rc = c->rc;
        d->ms = 0;
        d->verdict = c->verdict == 3 ? 3 : judge(d, c->rc, out);
    }
}

static void report_shared(int i) {
    contract *c = &cs[i];
    printf("RESULT\t%s\t%s\tseconds=0.00\trc=%d\tlayer=%s\tshared-run=%s (seconds counted there)\n", c->id,
           c->verdict == 1 ? "PASS" : c->verdict == 3 ? "TIMEOUT" : "FAIL", c->rc, c->layer, cs[c->shared].id);
}

static void count(tally *t, const contract *c) {
    if (eq(c->status, "GAP")) t->gap++;
    else if (eq(c->status, "BLOCKED")) t->blocked++;
    else if (eq(c->status, "ENV")) t->env++;
    else if (c->verdict == 1) t->pass++;
    else if (c->verdict == 3) t->timeout++;
    else if (c->verdict == 2) t->fail++;
    if (c->verdict) { t->run++; t->ms += c->ms; }
}

/* Run every IMPLEMENTED row WANT() selects; report the rest it selects. */
static tally run_selected(int (*want)(const contract *, void *), void *ctx) {
    tally t = zt;
    int i;
    for (i = 0; i < nc; i++) {
        contract *c = &cs[i];
        if (!want(c, ctx)) continue;
        if (!eq(c->status, "IMPLEMENTED")) {
            printf("NOT_RUN\t%s\t%s\tlayer=%s\t%s\n", c->id, c->status, c->layer, c->source);
        } else if (c->verdict) {
            report_shared(i);
        } else run_one(i);
        count(&t, c);
    }
    return t;
}

static int want_all(const contract *c, void *ctx) { (void)c; (void)ctx; return 1; }
static int want_smoke(const contract *c, void *ctx) { (void)ctx; return eq(c->smoke, "smoke"); }
static int want_layer(const contract *c, void *ctx) { return eq(c->layer, (const char *)ctx); }
typedef struct { int argc; char **argv; } idlist;
static int want_ids(const contract *c, void *ctx) {
    idlist *l = ctx;
    int i;
    for (i = 0; i < l->argc; i++) if (eq(l->argv[i], c->id)) return 1;
    return 0;
}

static void print_tally(const char *what, const char *verdict, const tally *t) {
    printf("%s\t%s\tpass=%d\tfail=%d\ttimeout=%d\tgap=%d\tblocked=%d\tenv=%d\trun=%d\tseconds=%ld.%02ld\n", what, verdict,
           t->pass, t->fail, t->timeout, t->gap, t->blocked, t->env, t->run, t->ms / 1000, (t->ms % 1000) / 10);
}

/* --all: 0 only with complete coverage and no failure; 1 a failure; 3 coverage missing. */
static int all_verdict(const tally *t) {
    if (t->fail || t->timeout) return 1;
    if (t->gap || t->blocked || t->env) return 3;
    return 0;
}

static int runner_selftest(void) {
    static char fixture[] =
        "# fixture\n"
        "a\tm\tIMPLEMENTED\tsmoke\t5\tU -run x.cx\trc0\ts\n"
        "b\tm\tGAP\t-\t0\t-\t-\tnone yet\n";
    static char bad1[] = "a\tm\tIMPLEMENTED\t-\t99\tU x\trc0\ts\n";
    static char bad2[] = "a\tm\tGAP\tsmoke\t0\t-\t-\ts\n";
    static char bad3[] = "a\tm\tIMPLEMENTED\t-\t5\tU x\trc0\ts\na\tm\tGAP\t-\t0\t-\t-\ts\n";
    static char bad4[] = "a\tm\tIMPLEMENTED\t-\t5\tU x\trc0\n";
    char why[200];
    int fails = 0;
    tally t;
    contract c;
#define RS_EXPECT(cond, what) do { if (cond) printf("  ok    %s\n", what); else { printf("  FAIL  %s\n", what); fails++; } } while (0)
    RS_EXPECT(parse_registry(fixture, why, sizeof why) == 0 && nc == 2, "a valid registry parses (comment skipped)");
    RS_EXPECT(parse_registry(bad1, why, sizeof why) != 0 && has_text(why, "budget"), "a budget over 55s is refused");
    RS_EXPECT(parse_registry(bad2, why, sizeof why) != 0 && has_text(why, "smoke"), "a GAP row cannot be smoke");
    RS_EXPECT(parse_registry(bad3, why, sizeof why) != 0 && has_text(why, "duplicate"), "duplicate ids are refused");
    RS_EXPECT(parse_registry(bad4, why, sizeof why) != 0 && has_text(why, "8 tab"), "a short row is refused");
    t = zt; t.pass = 3;
    RS_EXPECT(all_verdict(&t) == 0, "all pass, nothing missing: --all rc 0");
    t.gap = 1;
    RS_EXPECT(all_verdict(&t) == 3, "a GAP row keeps --all non-zero (3)");
    t.gap = 0; t.env = 1;
    RS_EXPECT(all_verdict(&t) == 3, "an ENV row keeps --all non-zero (3)");
    t.fail = 1;
    RS_EXPECT(all_verdict(&t) == 1, "a failure is 1 even with coverage missing");
    t.fail = 0; t.env = 0; t.timeout = 1;
    RS_EXPECT(all_verdict(&t) == 1, "a timeout counts as a failure");
    c = zc; c.expect = "rc0+text:selftest ok";
    RS_EXPECT(judge(&c, 0, "x\nselftest ok\n") == 1 && judge(&c, 0, "x\n") == 2 && judge(&c, 1, "selftest ok") == 2,
              "rc0+text needs both the exit code and the text");
    printf("RUNNER-SELFTEST\t%s\tfailed=%d\n", fails ? "FAIL" : "PASS", fails);
    return fails ? 1 : 0;
}

int main(int argc, char **argv) {
    char self[4096], root[4096], reg[4400], why[300];
    const char *suffix = "/tests/run.cx";
    char *text;
    size_t n;
    long z, sn = tx_len(suffix, CAP);
    const char *mode = argc > 1 ? argv[1] : "";
    if (eq(mode, "--selftest")) return runner_selftest();
    if (!eq(mode, "--list") && !eq(mode, "--smoke") && !eq(mode, "--all") &&
        !(argc > 2 && (eq(mode, "--layer") || eq(mode, "--run")))) {
        fprintf(stderr, "usage: --list | --smoke | --all | --layer L | --run ID... | --selftest\n");
        return 2;
    }
    if (!realpath(argv[0], self)) { fprintf(stderr, "REFUSE\trunner-path\terrno=%d\n", errno); return 2; }
    z = tx_len(self, CAP);
    if (z < 0 || z <= sn || !tx_same(self + z - sn, sn, suffix, sn)) {
        fprintf(stderr, "REFUSE\trunner-layout\twant=apps/csih/tests/run.cx\n"); return 2;
    }
    snprintf(root, sizeof root, "%.*s", (int)(z - sn), self);
    {
        char u[4200];
        snprintf(u, sizeof u, "%s/../../unisacc.com", root);
        if (!realpath(u, unisacc)) { fprintf(stderr, "REFUSE\tno-unisacc\t%s\n", u); return 2; }
    }
    snprintf(env_unisacc, sizeof env_unisacc, "UNISACC=%s", unisacc);
    {
        /* the installed product: tty/net probes drive it, csih.sh selftest checks its stamp */
        const char *b = tc_getenv("CSIH_BIN");
        char d[4200], r[4096];
        snprintf(d, sizeof d, "%s/../../out/csih-e2e-bin/csih", root);
        if (b && b[0]) snprintf(env_bin, sizeof env_bin, "CSIH_BIN=%s", b);
        else if (realpath(d, r)) snprintf(env_bin, sizeof env_bin, "CSIH_BIN=%s", r);
        else snprintf(env_bin, sizeof env_bin, "CSIH_BIN=");
    }
    if (chdir(root) != 0) { fprintf(stderr, "REFUSE\tchdir\t%s\n", root); return 2; }
    snprintf(reg, sizeof reg, "%s/tests/contracts.tsv", root);
    text = cx_read(reg, &n);
    if (!text) { fprintf(stderr, "REFUSE\tregistry-read\t%s\n", reg); return 2; }
    if (parse_registry(text, why, sizeof why)) { fprintf(stderr, "REFUSE\tregistry\t%s\n", why); return 2; }

    if (eq(mode, "--list")) {
        tally t = zt;
        int i;
        for (i = 0; i < nc; i++) {
            printf("CONTRACT\t%s\t%s\t%s\t%s\tbudget=%d\t%s\n", cs[i].id, cs[i].layer, cs[i].status, cs[i].smoke, cs[i].budget, cs[i].source);
            count(&t, &cs[i]);
        }
        printf("PLAN\tcontracts=%d\timplemented=%d\tgap=%d\tblocked=%d\tenv=%d\texecuted=0\n",
               nc, nc - t.gap - t.blocked - t.env, t.gap, t.blocked, t.env);
        return 0;
    }
    if (eq(mode, "--smoke")) {
        tally t = run_selected(want_smoke, NULL);
        int ok = !t.fail && !t.timeout && t.run > 0;
        print_tally("SMOKE", ok ? "PASS" : "FAIL", &t);
        return ok ? 0 : 1;
    }
    if (eq(mode, "--layer")) {
        tally t = run_selected(want_layer, argv[2]);
        int ok = !t.fail && !t.timeout;
        print_tally("LAYER", ok ? "PASS" : "FAIL", &t);
        return ok ? 0 : 1;
    }
    if (eq(mode, "--run")) {
        idlist l;
        tally t;
        int ok;
        l.argc = argc - 2; l.argv = argv + 2;
        t = run_selected(want_ids, &l);
        ok = !t.fail && !t.timeout && t.run + t.gap + t.blocked + t.env == l.argc;
        print_tally("RUN", ok ? "PASS" : "FAIL", &t);
        return ok ? 0 : 1;
    }
    {
        tally t = run_selected(want_all, NULL);
        int rc = all_verdict(&t);
        print_tally("ALL", rc == 0 ? "PASS" : rc == 1 ? "FAIL" : "NOT_QUALIFIED", &t);
        return rc;
    }
}
