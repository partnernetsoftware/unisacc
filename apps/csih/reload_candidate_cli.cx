#pragma unisa use reload_candidate
/* reload_candidate CLI: build | verify (same stdout JSON and exit codes as reload_candidate.py). */

int rc_setjmp(void *jb);
void rc_fail_push(void *jb);
char *rc_err_buf(void);

int main(int argc, char **argv) {
    __u_word jb[8];
    Result res;
    Buf o = {0, 0, 0};
    rc_fail_push(jb);
    if (rc_setjmp(jb)) {
        Buf e = {0, 0, 0};
        bs(&e, "{\"error\": ");
        bjs(&e, rc_err_buf());
        bs(&e, "}\n");
        fputs(e.p, stdout);
        return 1;
    }
    if (argc == 5 && !strcmp(argv[1], "build")) res = build(argv[2], argv[3], argv[4]);
    else if (argc == 3 && !strcmp(argv[1], "verify")) res = verify(argv[2]);
    else fail("usage: build SOURCE_APP COMPILER PRIVATE_ROOT | verify CANDIDATE_DIR");
    bs(&o, "{\"binary\": ");
    bjs(&o, res.binary);
    bs(&o, ", \"candidate_dir\": ");
    bjs(&o, res.candidate_dir);
    bs(&o, ", \"hash\": ");
    bjs(&o, res.hash);
    bs(&o, ", \"receipt\": ");
    bjs(&o, res.receipt);
    bs(&o, "}\n");
    fputs(o.p, stdout);
    return 0;
}
