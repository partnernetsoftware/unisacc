#pragma unisa use zstr
#pragma unisa use reload_candidate
#pragma unisa use reload_io
/* reload_candidate CLI: build | verify (same stdout JSON and exit codes as reload_candidate.py). */

static Result g_res;
static int g_argc;
static char **g_argv;

static void rc_cli_body(void *ud) {
    (void)ud;
    if (g_argc == 5 && !zs_cmp(g_argv[1], "build"))
        g_res = build(g_argv[2], g_argv[3], g_argv[4]);
    else if (g_argc == 3 && !zs_cmp(g_argv[1], "verify"))
        g_res = verify(g_argv[2]);
    else
        fail("usage: build SOURCE_APP COMPILER PRIVATE_ROOT | verify CANDIDATE_DIR");
}

int main(int argc, char **argv) {
    Buf o = {0, 0, 0};
    g_argc = argc;
    g_argv = argv;
    zs_mset(&g_res, 0, sizeof g_res);
    if (rc_guard(rc_cli_body, 0)) {
        Buf e = {0, 0, 0};
        bs(&e, "{\"error\": ");
        bjs(&e, rc_err_buf());
        bs(&e, "}\n");
        fputs(e.p, stdout);
        return 1;
    }
    bs(&o, "{\"binary\": ");
    bjs(&o, g_res.binary);
    bs(&o, ", \"candidate_dir\": ");
    bjs(&o, g_res.candidate_dir);
    bs(&o, ", \"hash\": ");
    bjs(&o, g_res.hash);
    bs(&o, ", \"receipt\": ");
    bjs(&o, g_res.receipt);
    bs(&o, "}\n");
    fputs(o.p, stdout);
    return 0;
}
