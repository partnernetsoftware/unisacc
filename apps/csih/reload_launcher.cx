#pragma unisa use reload_candidate
#pragma unisa use json

enum { RC_ERR_CAP = 1024 };
int rc_setjmp(void *jb);
void rc_fail_push(void *jb);
char *rc_err_buf(void);
int reload_io_flock_exnb(int fd);
/* reload_launcher.cx -- C port of reload_launcher.py (same CLI and exit codes).
 * Stable CTTY supervisor; trusted private candidates, native actors own user input.
 *
 * CLI:
 *   reload_launcher run SOURCE_APP COMPILER PRIVATE_CANDIDATE_ROOT PRIVATE_SESSION_DIR SESSION [VERIFIED_INITIAL_DIR]
 *   errors: stderr "reload launcher: CAUSE", rc 1.
 *
 *
 * STATUS
 *   ported : CLI, Launcher constructor (absolute paths, trusted root/session dir,
 *            session regex, supervisor flock, launcher-events.jsonl O_APPEND 0600),
 *            run() preamble (lock ownership, isatty(0)/isatty(1) foreground TTY refusal).
 *   BLOCKED: foreground pgid check needs tcgetpgrp (missing in unisacc 0.0.39).
 *            Actor control channel needs socketpair (missing); actor spawn needs
 *            Popen pass_fds; build/kill needs killpg, setsid (missing); select on the
 *            actor socket and the handoff state machine depend on those.
 *            Run path with a TTY therefore stops with a BLOCKED error (rc 1).
 *   TODO   : event() JSON writer and the event callers (spawn, build, handoff) are
 *            unported: they are only reached after the blocked symbols above.
 *   DEVIATION: a missing root/session directory reports "cannot stat: PATH" (Python
 *            prints the OSError text).
 */

#define MODEBITS(m) ((m) & 07777)

static int lr_lock_fd = -1;
static int lr_event_fd = -1;

static char *lr_source, *lr_compiler, *lr_root, *lr_directory, *lr_sid;

/* OSError-style text: "[Errno N] strerror: 'PATH'" */
static void lr_oserr(const char *path) {
    snprintf(rc_err_buf(), RC_ERR_CAP, "[Errno %d] %s: '%s'", errno, strerror(errno), path);
    rc_fail_jump();
}

static void lr_close_host(void) {
    if (lr_event_fd >= 0) { close(lr_event_fd); lr_event_fd = -1; }
    if (lr_lock_fd >= 0) { close(lr_lock_fd); lr_lock_fd = -1; }
}

static int lr_valid_sid(const char *s) {
    size_t i, n = strlen(s);
    if (n < 1 || n > 64) return 0;
    for (i = 0; i < n; i++) {
        unsigned char c = (unsigned char)s[i];
        if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') ||
              c == ':' || c == '_' || c == '-'))
            return 0;
    }
    return 1;
}

/* acquire_supervisor_lock(directory): owned regular 0600 lock file, exclusive flock */
static int lr_acquire_lock(const char *directory) {
    char *lockp = pjoin(directory, "supervisor.lock");
    struct stat sb;
    int fd, e;
    trusted(directory, 1, 1);
    fd = open(lockp, O_RDWR | O_CREAT | O_NOFOLLOW | O_CLOEXEC, 0600);
    if (fd < 0) lr_oserr(lockp);
    if (fstat(fd, &sb) != 0 || !S_ISREG(sb.st_mode) || sb.st_uid != getuid() || MODEBITS(sb.st_mode) != 0600) {
        close(fd);
        fail("supervisor lock not owned regular0600");
    }
    if (reload_io_flock_exnb(fd) != 0) {
        e = errno;
        close(fd);
        snprintf(rc_err_buf(), RC_ERR_CAP, "[Errno %d] %s", e, strerror(e));
        rc_fail_jump();
    }
    return fd;
}

/* Launcher.__init__ */
static void lr_init(const char *source, const char *compiler, const char *root, const char *directory, const char *sid) {
    char *evp;
    lr_source = absolute(source);
    lr_compiler = absolute(compiler);
    lr_root = absolute(root);
    lr_directory = absolute(directory);
    lr_sid = xdup(sid);
    trusted(lr_root, 1, 1);
    trusted(lr_directory, 1, 1);
    if (!lr_valid_sid(sid)) fail("invalid session");
    lr_lock_fd = lr_acquire_lock(lr_directory);
    evp = pjoin(lr_directory, "launcher-events.jsonl");
    lr_event_fd = open(evp, O_WRONLY | O_APPEND | O_CREAT | O_NOFOLLOW | O_CLOEXEC, 0600);
    if (lr_event_fd < 0) lr_oserr(evp);
    trusted(evp, 0, 1);
}

/* Launcher.run(): only the preamble is portable today (see STATUS). */
static int lr_run(void) {
    if (lr_lock_fd < 0) fail("supervisor ownership absent");
    if (!isatty(0) || !isatty(1)) fail("launcher requires foreground controlling TTY");
    /* BLOCKED: Python also requires os.tcgetpgrp(0) == os.getpgrp(); tcgetpgrp is missing in
     * unisacc 0.0.39. The rest of run() (baseline tcgetattr, actor spawn over socketpair with
     * pass_fds, build child with setsid/killpg, handoff) is unported for the same reason. */
    fail("BLOCKED: tcgetpgrp/socketpair/killpg/setsid missing in unisacc 0.0.39 (TODO port run loop)");
    return 1;
}

int main(int argc, char **argv) {
    __u_word jb[8];
    int rc;
    rc_fail_push(jb);
    if (rc_setjmp(jb)) {
        lr_close_host();
        fprintf(stderr, "reload launcher: %s\n", rc_err_buf());
        return 1;
    }
    if ((argc != 7 && argc != 8) || strcmp(argv[1], "run") != 0)
        fail("usage: run SOURCE_APP COMPILER PRIVATE_CANDIDATE_ROOT PRIVATE_SESSION_DIR SESSION [VERIFIED_INITIAL_DIR]");
    lr_init(argv[2], argv[3], argv[4], argv[5], argv[6]);
    rc = lr_run();
    lr_close_host();
    return rc;
}
