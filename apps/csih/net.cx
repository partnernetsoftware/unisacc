#pragma unisa module net
#pragma unisa use sys.net
#pragma unisa use sys.fs
#pragma unisa use sys.time
#pragma unisa use sys.ffi
#pragma unisa use sys.env
#pragma unisa use sys.proc
#pragma unisa use text.text
#pragma unisa use mem.bytes
/* Sockets, stat, the clock and the libcurl calls (sys.ffi) are cx/sys; no #include. */
/*
 * net.cx — talk HTTP/1.1 over a TCP socket. This is the layer csih needs to
 * reach a model, and it is deliberately the smallest thing that can do it.
 *
 * http:// is hand-written sockets. The host is resolved with getaddrinfo
 * (unisacc 0.0.25 forwards that to the system resolver, including from a
 * second source file as of 0.0.26). https:// calls libcurl in this file:
 * dlopen RTLD_GLOBAL, then the forwarded curl_* names. libcurl's body is
 * flushed from the host libc stdout into a pipe — unisacc fflush is a no-op,
 * and a unisacc FILE* or function must not be handed to curl. Redirects,
 * pooling, and chunked decoding are still not implemented.
 *
 * WHAT THIS DOES NOT DO, explicitly, because each is a silent wrong answer if
 * assumed away:
 *   - https:// is not rewritten as http://. Certificate checks are libcurl's.
 *   - NO REDIRECTS. A 3xx is returned to the caller as a 3xx.
 *   - NO CHUNKED TRANSFER DECODING. Content-Length is honoured; a chunked
 *     response is returned raw and flagged.
 *   - NO CONNECTION REUSE. One request, one socket, closed after.
 *
 * http:// stays a hand-written socket. That is what the loopback probes use.
 *
 * THE sys/wait.h TRAP — FIXED (unisacc, 2026-10-02). Until recently `socket()`
 * failed to build with `undefined function '_unisa_ret'` unless <sys/wait.h> was
 * also included, even though nothing here uses wait(). An unexplained include is
 * indistinguishable from cargo cult, so it was carried with a note and pinned by
 * probes/net-cover.sh. The probe flipped to FIXED, so the include and its note
 * are gone — verified by building net.c without it (probe reports ok, and
 * check.sh asserts this file no longer mentions the header). If the trap ever
 * returns, check.sh goes red and names it; do not re-add the include blind.
 *
 * unisacc limits honoured (SKILL.md §2): structs restated so each module builds
 * alone; no `return f()` of a struct from a non-main function; stdio owned by
 * the CLI file.
 *
 * CLI takes SUBCOMMANDS, not dash-options.
 */

/* ── text helpers over text.text (no libc string calls in this module) ──── */

#define NET_SCAN (1L << 30)   /* scan bound for NUL-terminated text */

static long net_len(const char *s) { long n = tx_len(s, NET_SCAN); return n < 0 ? 0 : n; }
/* first W in S, or 0 (strstr) */
static char *net_str(const char *s, const char *w) {
    long at = tx_find(s, net_len(s), w, net_len(w));
    return at < 0 ? 0 : (char *)s + at;
}
/* first C in S, or 0 (strchr; C 0 is the terminator) */
static char *net_chr(const char *s, int c) {
    long n = net_len(s), at;
    if (c == 0) return (char *)s + n;
    at = tx_chr(s, n, c);
    return at < 0 ? 0 : (char *)s + at;
}
static int net_eq(const char *a, const char *b) { return tx_eq(a, b, NET_SCAN); }
static int net_starts(const char *s, const char *p) { return tx_prefix(s, net_len(s), p, net_len(p)); }
/* copy z-string SRC into DST[CAP]; 0, or 1 (DST untouched) when it does not fit */
static int net_set(char *dst, long cap, const char *src) { return tx_copy(dst, cap, src, net_len(src)); }

/* curl prototypes live inside the helpers that call them (CX module export rule). */
enum {
    CURLOPT_NOSIGNAL = 99,
    CURLOPT_TIMEOUT = 13,
    CURLOPT_CONNECTTIMEOUT = 78,
    CURLOPT_WRITEDATA = 10001,
    CURLOPT_URL = 10002,
    CURLOPT_POSTFIELDS = 10015,
    CURLOPT_HTTPHEADER = 10023,
    CURLINFO_RESPONSE_CODE = 0x200002,
    NET_BODY_MAX = 65536,
    NET_HDR_MAX = 16384,
    NET_REFUSED_HTTPS = -2001,
    NET_REFUSED_URL = -2002,
    NET_NO_CURL = -2003,
    NET_CANCELLED = -2004,
    NET_TIMEOUT = -2005,
    NET_TOTAL_SEC = 60
};

/* ── results ────────────────────────────────────────────────────────────── */

typedef struct {
    int  ok;
    int  err;
    int  status;
    long body_bytes;
    int  chunked;
    char header[NET_HDR_MAX];
    char body[NET_BODY_MAX];
} net_response;

/*
 * A tiny local case-insensitive compare.
 *
 * Declared and defined HERE, above its use, rather than after it: the first
 * version defined it at the bottom of the file with no prototype, which is a
 * call to an undeclared function — a constraint violation in C99 that gcc only
 * warns about and unisacc reports as a confusing "undefined function". Header
 * folding is not something this file should depend on either; five lines is
 * cheaper than the question.
 */
static int strncasecmp_local(const char *a, const char *b, size_t n) {
    size_t i;
    for (i = 0; i < n; i++) {
        char ca = a[i], cb = b[i];
        if (ca >= 'A' && ca <= 'Z') ca = (char)(ca - 'A' + 'a');
        if (cb >= 'A' && cb <= 'Z') cb = (char)(cb - 'A' + 'a');
        if (ca != cb) return (int)(unsigned char)ca - (int)(unsigned char)cb;
        if (ca == '\0') return 0;
    }
    return 0;
}

/* ── URL splitting ──────────────────────────────────────────────────────── */

typedef struct {
    char host[256];
    char port[16];
    char path[1024];
    int  https;
} net_url;

/*
 * Split `http://host[:port]/path` into its parts.
 *
 * https:// is parsed and later handed to libcurl. It is not rewritten as http://.
 */
int net_parse_url(const char *url, net_url *u) {
    const char *p, *slash;
    mm_fill(u, (long)sizeof *u, 0, (long)sizeof *u);

    if (net_starts(url, "https://")) { u->https = 1; p = url + 8; }
    else if (net_starts(url, "http://")) p = url + 7;
    else return NET_REFUSED_URL;

    slash = net_chr(p, '/');
    {
        const char *colon = net_chr(p, ':');
        const char *hostend = slash ? slash : p + net_len(p);
        if (colon && colon < hostend) {
            long hl = (long)(colon - p), pl;
            if (tx_copy(u->host, (long)sizeof u->host, p, hl)) return NET_REFUSED_URL;
            pl = (long)(hostend - colon - 1);
            if (tx_copy(u->port, (long)sizeof u->port, colon + 1, pl)) return NET_REFUSED_URL;
        } else {
            long hl = (long)(hostend - p);
            if (tx_copy(u->host, (long)sizeof u->host, p, hl)) return NET_REFUSED_URL;
            net_set(u->port, (long)sizeof u->port, u->https ? "443" : "80");
        }
    }
    if (slash) {
        if (net_set(u->path, (long)sizeof u->path, slash)) return NET_REFUSED_URL;
    } else {
        net_set(u->path, (long)sizeof u->path, "/");
    }
    if (u->host[0] == '\0') return NET_REFUSED_URL;
    return 0;
}

/* ── connect ────────────────────────────────────────────────────────────── */

/* Sockets are cx/sys (sys.net): fds, -errno results turned back into -1 + errno
 * for the callers below. Windows has no Winsock path in sys.net (sy_tcp_dial is
 * -ENOSYS there); csih's Windows slice is the unsupported stub, so none is kept. */
#define NET_INVALID_SOCKET (~0UL)
static void net_socket_close(unsigned long fd) { sy_close((int)fd); }
static long net_socket_send(unsigned long fd, const void *buf, size_t len) {
    long r = sy_send((int)fd, buf, (long)len);   /* MSG_NOSIGNAL: a gone peer is EPIPE, not a signal */
    if (r < 0) { errno = (int)-r; return -1; }
    return r;
}
static long net_socket_recv(unsigned long fd, void *buf, size_t len) {
    long r = sy_recv((int)fd, buf, (long)len);
    if (r < 0) { errno = (int)-r; return -1; }
    return r;
}
/* Any name the system resolver knows, IPv4, each address in turn (sy_tcp_dial).
 * NET_INVALID_SOCKET on failure, errno set for a socket error (0 for a name). */
static unsigned long net_connect(const char *host, const char *port) {
    int r = sy_tcp_dial(host, atoi(port));
    if (r < 0) { errno = r > SY_EAI_BASE ? -r : 0; return NET_INVALID_SOCKET; }
    return (unsigned long)r;
}

/* Uniform UFFI curl path (no file-scope #if): CXIF rejects exports after #if. */
static int curl_setopt(void *h, int opt, void *val) {
    static void *fn; int kinds[3]; void *vals[3]; int r = 0;
    if (!fn) fn = sy_ffi_dlsym(sy_ffi_default(), "curl_easy_setopt");
    kinds[0] = SY_FFI_POINTER; kinds[1] = SY_FFI_INT; kinds[2] = SY_FFI_POINTER;
    vals[0] = &h; vals[1] = &opt; vals[2] = &val;
    sy_ffi_call(fn, SY_FFI_INT, kinds, vals, 3, 2, &r);
    return r;
}
static int curl_setopt_long(void *h, int opt, long val) {
    static void *fn; int kinds[3]; void *vals[3]; int r = 0;
    if (!fn) fn = sy_ffi_dlsym(sy_ffi_default(), "curl_easy_setopt");
    kinds[0] = SY_FFI_POINTER; kinds[1] = SY_FFI_INT; kinds[2] = SY_FFI_LONG;
    vals[0] = &h; vals[1] = &opt; vals[2] = &val;
    sy_ffi_call(fn, SY_FFI_INT, kinds, vals, 3, 2, &r);
    return r;
}
static int curl_getinfo(void *h, int info, long *out) {
    static void *fn; int kinds[3]; void *vals[3]; int r = 0;
    if (!fn) fn = sy_ffi_dlsym(sy_ffi_default(), "curl_easy_getinfo");
    kinds[0] = SY_FFI_POINTER; kinds[1] = SY_FFI_INT; kinds[2] = SY_FFI_POINTER;
    vals[0] = &h; vals[1] = &info; vals[2] = &out;
    sy_ffi_call(fn, SY_FFI_INT, kinds, vals, 3, 2, &r);
    return r;
}
static void flush_host_stdout(void) {
    void *ff, *slot, *file;
    int kinds[1]; void *vals[1]; int r = 0;
    ff = sy_ffi_dlsym(sy_ffi_default(), "fflush");
    slot = sy_ffi_dlsym(sy_ffi_default(), "stdout");
    if (!slot) slot = sy_ffi_dlsym(sy_ffi_default(), "__stdoutp");
    if (!ff || !slot) return;
    file = *(void **)slot;
    kinds[0] = SY_FFI_POINTER; vals[0] = &file;
    sy_ffi_call(ff, SY_FFI_INT, kinds, vals, 1, 1, &r);
}

/* Called from our own poll loop, never from libcurl. A host callback into
 * unisacc still segfaults. NULL means the request stays quiet. */
typedef void (*net_tick_fn)(void);
static net_tick_fn net_tick_cb;
static int net_stop;
static int net_elapsed;
static time_t net_turn0;
static time_t net_req0;      /* this request's start; reset per net_async_begin */
static int net_req_elapsed;  /* whole seconds for this request only */
static int net_tokens;
static long net_sent;
static long net_got;
static int net_hit, net_miss, net_usage_seen;
static int net_req_counted, net_sess_calls;
static long net_sess_hit, net_sess_miss, net_sess_out;
void net_set_tick(net_tick_fn fn) { net_tick_cb = fn; }
void net_cancel(void) { net_stop = 1; }
int net_stopped(void) { return net_stop; }   /* Esc/Ctrl-C asked to stop this turn */
void net_reset(void) { net_stop = 0; }
/* Wall-clock seconds (sys.time). */
static time_t net_wall(void) { return (time_t)sy_wall_s(); }

/* One clock for the user turn. net_async_begin must not touch it. */
void net_turn_clock(void) {
    net_turn0 = net_wall();
    net_elapsed = 0;
    net_got = 0;
    net_hit = net_miss = net_usage_seen = 0;
}
void net_progress(int *sec, int *tokens, long *sent, int *rsec) {
    if (sec) *sec = net_elapsed;
    if (tokens) *tokens = net_tokens;
    if (sent) *sent = net_sent;
    if (rsec) *rsec = net_req_elapsed;
}
void net_recv(long *n) {
    if (n) *n = net_got;
}
void net_cache(int *hit, int *miss, int *seen) {
    if (hit) *hit = net_hit;
    if (miss) *miss = net_miss;
    if (seen) *seen = net_usage_seen;
}
void net_cache_set(int hit, int miss, int seen) {
    net_hit = hit;
    net_miss = miss;
    net_usage_seen = seen;
}
/* Upper modules must not #include <time.h>; expose clock through this lower API. */
time_t net_now(void) { return net_wall(); }

/* Last closed usage object in the tail. Absent cache fields become 0.
 * No usage object in this body: drop any previous hit/miss. */
static void net_note_usage(const char *tail) {
    const char *u = 0, *p, *brace, *end, *k;
    int hit = 0, miss = 0;
    for (p = tail; (p = net_str(p, "\"usage\"")); p++) u = p;
    if (!u) { net_hit = net_miss = net_usage_seen = 0; return; }
    brace = net_chr(u, '{');
    if (!brace) { net_hit = net_miss = net_usage_seen = 0; return; }
    /* usage nests prompt_tokens_details{...}; the first '}' is not its end. */
    {
        int depth = 0;
        for (end = brace; *end; end++) {
            if (*end == '{') depth++;
            else if (*end == '}' && --depth == 0) break;
        }
        if (!*end) end = 0;
    }
    if (!end) { net_hit = net_miss = net_usage_seen = 0; return; }
    k = net_str(brace, "\"prompt_cache_hit_tokens\"");
    if (k && k < end) {
        k = net_chr(k, ':');
        if (k && k < end) hit = atoi(k + 1);
    }
    k = net_str(brace, "\"prompt_cache_miss_tokens\"");
    if (k && k < end) {
        k = net_chr(k, ':');
        if (k && k < end) miss = atoi(k + 1);
    }
    net_hit = hit;
    net_miss = miss;
    net_usage_seen = 1;
    /* Progress polls re-read the same tail; count each response once. */
    if (!net_req_counted) {
        int out = 0;
        k = net_str(brace, "\"completion_tokens\"");
        if (k && k < end) {
            k = net_chr(k, ':');
            if (k && k < end) out = atoi(k + 1);
        }
        net_req_counted = 1;
        net_sess_calls++;
        net_sess_hit += hit;
        net_sess_miss += miss;
        net_sess_out += out;
    }
}

/* Whole-process totals for /cost. */
void net_session_usage(int *calls, long *hit, long *miss, long *out) {
    if (calls) *calls = net_sess_calls;
    if (hit) *hit = net_sess_hit;
    if (miss) *miss = net_sess_miss;
    if (out) *out = net_sess_out;
}

/* Self-test hook: feed one response tail as a fresh request. */
void net_test_usage(const char *tail) {
    net_req_counted = 0;
    net_note_usage(tail);
}

/* Prefer the API's total_tokens once it is on disk. Until then, bytes/4. */
void net_note_progress(const char *path, time_t t0) {
    sy_stat_t st;
    char tail[4096];
    int fd, n;
    char *p;
    net_elapsed = (int)(net_wall() - (net_turn0 ? net_turn0 : t0));
    if (net_elapsed < 0) net_elapsed = 0;
    net_req_elapsed = (int)(net_wall() - (net_req0 ? net_req0 : t0));
    if (net_req_elapsed < 0) net_req_elapsed = 0;
    if (sy_stat(path, &st) != 0 || st.size <= 0) {
        net_tokens = 0;
        net_got = 0;
        return;
    }
    net_got = (long)st.size;
    net_tokens = (int)(st.size / 4);
    fd = sy_open(path, O_RDONLY, 0);
    if (fd < 0) return;
    if (st.size > (long)sizeof tail) sy_lseek(fd, st.size - (long)sizeof tail, SEEK_SET);
    n = (int)sy_read(fd, tail, (long)sizeof tail - 1);
    sy_close(fd);
    if (n < 0) return;
    tail[n] = 0;
    p = net_str(tail, "\"total_tokens\":");
    if (p) net_tokens = atoi(p + 15);
    net_note_usage(tail);
}

static void net_take_body(int fd, char *buf, size_t cap, size_t *off) {
    for (;;) {
        long k;
        if (*off + 1 >= cap) return;
        k = sy_read(fd, buf + *off, (long)(cap - 1 - *off));   /* resumes after EINTR */
        if (k <= 0) return;
        *off += (size_t)k;
        buf[*off] = 0;
    }
}

/* Key read from ~/env.jsonl. DEEPSEEK_API_KEY, when set, is used first and
 * is not stored here. /reload clears only this buffer. */
static char net_key[200];

/* unisacc re-execs into its cache and drops DEEPSEEK_API_KEY. Read the
 * deepseek object in ~/env.jsonl. The first api_key in that file is not this one. */
/* One env.jsonl line: 1 when it is the deepseek object and its key was copied
 * into net_key. */
static int net_key_line(const char *line) {
    char *p, *q;
    int i = 0;
    if (!net_str(line, "\"deepseek\"")) return 0;
    p = net_str(line, "\"api_key\"");
    if (!p) p = net_str(line, "\"key\"");
    if (!p) return 0;
    p = net_chr(p, ':');
    if (!p) return 0;
    q = net_chr(p, '"');
    if (!q) return 0;
    q++;
    while (*q && *q != '"' && i < (int)sizeof net_key - 1) net_key[i++] = *q++;
    net_key[i] = 0;
    return 1;
}

static const char *net_deepseek_key(void) {
    const char *env = sy_env("DEEPSEEK_API_KEY");
    const char *home;
    char path[512], line[4096], chunk[4096];
    int fd, used = 0, done = 0;
    if (env && env[0]) return env;
    if (net_key[0]) return net_key;
    home = sy_env("HOME");
    if (!home) return 0;
    if (cx_fmt(path, sizeof path, "%s/env.jsonl", home)) return 0;
    fd = sy_open(path, O_RDONLY, 0);
    if (fd < 0) return 0;
    /* Lines as fgets(line, 4096) cut them: at a newline, or after 4095 bytes. */
    while (!done) {
        long k = sy_read(fd, chunk, (long)sizeof chunk), i;
        if (k <= 0) break;
        for (i = 0; i < k && !done; i++) {
            line[used++] = chunk[i];
            if (chunk[i] == '\n' || used == (int)sizeof line - 1) {
                line[used] = 0;
                done = net_key_line(line);
                used = 0;
            }
        }
    }
    if (!done && used > 0) { line[used] = 0; net_key_line(line); }
    sy_close(fd);
    return net_key[0] ? net_key : 0;
}

/* unisacc setenv() stays in the file that called it. net_cli.c cannot
 * change this file's getenv, so the self-test asks this function to do it. */
void net_test_home(const char *home) {
    if (home && home[0]) sy_setenv("HOME", home, 1);
}

/* Drop the cached env.jsonl key when that file can be opened. Returns 1
 * then. A missing file leaves the cache, so the next call still has it.
 * Does not unset DEEPSEEK_API_KEY and does not rewrite env.jsonl. */
/* Report where the key comes from without printing it: 0 none, 1 env, 2 file. */
int net_deepseek_key_probe(int *len) {
    const char *env = sy_env("DEEPSEEK_API_KEY");
    const char *k = net_deepseek_key();
    *len = k ? (int)net_len(k) : 0;
    if (!k) return 0;
    return env && env[0] ? 1 : 2;
}

int net_deepseek_forget(void) {
    const char *home = sy_env("HOME");
    char path[512];
    int fd;
    if (!home || !home[0]) return 0;
    if (cx_fmt(path, sizeof path, "%s/env.jsonl", home)) return 0;
    fd = sy_open(path, O_RDONLY, 0);
    if (fd < 0) return 0;
    sy_close(fd);
    net_key[0] = 0;
    return 1;
}

/* Host libc FILE*. curl's default writer is fwrite; a unisacc FILE* or
 * callback must not be passed in. */
static void *host_fopen(const char *path, const char *mode) {
    static void *fn;
    int kinds[2];
    void *vals[2];
    void *r = 0;
    if (!fn) fn = sy_ffi_dlsym(sy_ffi_default(), "fopen");
    if (!fn) return 0;
    kinds[0] = SY_FFI_POINTER; kinds[1] = SY_FFI_POINTER;
    vals[0] = &path; vals[1] = &mode;
    if (sy_ffi_call(fn, SY_FFI_POINTER, kinds, vals, 2, 2, &r) != 0) return 0;
    return r;
}
static void host_fflush_file(void *file) {
    static void *fn;
    int kinds[1]; void *vals[1]; int r = 0;
    if (!file) return;
    if (!fn) fn = sy_ffi_dlsym(sy_ffi_default(), "fflush");
    if (!fn) return;
    kinds[0] = SY_FFI_POINTER; vals[0] = &file;
    sy_ffi_call(fn, SY_FFI_INT, kinds, vals, 1, 1, &r);
}
static void host_fclose(void *file) {
    static void *fn;
    int kinds[1]; void *vals[1]; int r = 0;
    if (!file) return;
    if (!fn) fn = sy_ffi_dlsym(sy_ffi_default(), "fclose");
    if (!fn) return;
    kinds[0] = SY_FFI_POINTER; vals[0] = &file;
    sy_ffi_call(fn, SY_FFI_INT, kinds, vals, 1, 1, &r);
}

/* One HTTPS transfer, driven one slice at a time.
 * The caller keeps `body` alive until net_async_pump returns 0.
 * That is the whole async story: no thread, no stack switch. */
static int net_on, net_running, net_rc;
static void *net_easy, *net_multi, *net_hdr, *net_outf;
/* 1 while an async request is open, so the UI can tell model wait from a tool. */
int net_in_flight(void) { return net_on; }
static char net_capture[64];
static time_t net_t0;
static net_response net_res;

int net_async_begin(const char *method, const char *url,
                    const char *content_type, const char *body) {
    extern void *curl_easy_init(void);
    extern void curl_easy_cleanup(void *h);
    extern void *curl_multi_init(void);
    extern int curl_multi_add_handle(void *m, void *e);
    extern void *curl_slist_append(void *list, const char *s);
    void *h, *hdr = 0;
    char chead[180], auth[600];
    const char *key;
    if (net_on) return -1;
    net_on = net_running = net_rc = 0;
    net_easy = net_multi = net_hdr = net_outf = 0;
    net_hdr = 0;
    net_capture[0] = 0;
    net_t0 = 0;
    net_req0 = net_wall();
    net_req_elapsed = 0;
    mm_fill(&net_res, (long)sizeof net_res, 0, (long)sizeof net_res);
    if (net_stop) { net_res.err = NET_CANCELLED; return -1; }
    net_sent = body ? (long)net_len(body) : 0;
    {
        static int curl_loaded;
        if (!curl_loaded) {
            if (!sy_ffi_dlopen("libcurl.so.4", 2 | 0x100) &&
                !sy_ffi_dlopen("/usr/lib/libcurl.4.dylib", 2 | 8)) {
                net_res.err = NET_NO_CURL; return -1;
            }
            curl_loaded = 1;
        }
    }
    h = curl_easy_init();
    if (!h) { net_res.err = NET_NO_CURL; return -1; }
    hdr = curl_slist_append(0, "Accept: application/json");
    if (content_type && content_type[0]) {
        snprintf(chead, sizeof chead, "Content-Type: %s", content_type);
        hdr = curl_slist_append(hdr, chead);
    }
    key = net_deepseek_key();
    if (key && key[0] && net_str(url, "api.deepseek.com") && net_len(key) < 500) {
        snprintf(auth, sizeof auth, "Authorization: Bearer %s", key);
        hdr = curl_slist_append(hdr, auth);
    }
    curl_setopt_long(h, CURLOPT_NOSIGNAL, 1);
    curl_setopt_long(h, CURLOPT_CONNECTTIMEOUT, 20);
    curl_setopt_long(h, CURLOPT_TIMEOUT, NET_TOTAL_SEC);
    curl_setopt(h, CURLOPT_URL, (void *)url);
    curl_setopt(h, CURLOPT_HTTPHEADER, hdr);
    if (net_eq(method, "POST")) curl_setopt(h, CURLOPT_POSTFIELDS, (void *)(body ? body : ""));
    snprintf(net_capture, sizeof net_capture, "/tmp/cdsh-net-%d", (int)sy_pid());
    net_outf = host_fopen(net_capture, "w+");
    if (!net_outf) { curl_easy_cleanup(h); net_res.err = NET_NO_CURL; return -1; }
    curl_setopt(h, CURLOPT_WRITEDATA, net_outf);
    net_multi = curl_multi_init();
    if (!net_multi) {
        host_fclose(net_outf);
        sy_unlink(net_capture);
        curl_easy_cleanup(h);
        net_res.err = NET_NO_CURL;
        return -1;
    }
    curl_multi_add_handle(net_multi, h);
    net_easy = h;
    net_hdr = hdr;
    net_running = 1;
    net_t0 = net_wall();
    net_on = 1;
    net_tokens = 0;
    net_got = 0;
    /* This call has no usage yet. Do not keep the previous hit/miss on screen. */
    net_hit = net_miss = net_usage_seen = 0;
    net_req_counted = 0;
    return 0;
}

/* 1 = still waiting. 0 = finished; call net_async_end. wait_ms 0 does not block. */
int net_async_pump(int wait_ms) {
    extern int curl_multi_perform(void *m, int *running);
    extern int curl_multi_wait(void *m, void *extra, unsigned extra_nfds, int timeout_ms, int *numfds);
    int nfds = 0;
    if (!net_on) return 0;
    curl_multi_perform(net_multi, &net_running);
    host_fflush_file(net_outf);
    net_note_progress(net_capture, net_t0);
    if (!net_running) return 0;
    if ((int)(net_wall() - net_t0) >= NET_TOTAL_SEC) { net_rc = NET_TIMEOUT; return 0; }
    if (wait_ms > 0) curl_multi_wait(net_multi, 0, 0, wait_ms, &nfds);
    if (net_tick_cb) net_tick_cb();
    if (net_stop) { net_rc = NET_CANCELLED; return 0; }
    if ((int)(net_wall() - net_t0) >= NET_TOTAL_SEC) { net_rc = NET_TIMEOUT; return 0; }
    return 1;
}

net_response net_async_end(void) {
    extern int curl_multi_remove_handle(void *m, void *e);
    extern void curl_multi_cleanup(void *m);
    extern void curl_easy_cleanup(void *h);
    extern void curl_slist_free_all(void *list);
    int fd;
    ssize_t nread;
    long code = 0;
    net_response r;
    if (!net_on && net_res.err) { net_response early = net_res; return early; }
    if (net_multi && net_easy) {
        curl_multi_remove_handle(net_multi, net_easy);
        curl_multi_cleanup(net_multi);
        net_multi = 0;
    }
    if (net_outf) {
        host_fflush_file(net_outf);
        host_fclose(net_outf);
        net_outf = 0;
        fd = sy_open(net_capture, O_RDONLY, 0);
        if (fd >= 0) {
            nread = sy_read(fd, net_res.body, (long)sizeof net_res.body - 1);
            if (nread < 0) nread = 0;
            net_res.body[nread] = 0;
            net_res.body_bytes = (long)nread;
            sy_close(fd);
        }
        sy_unlink(net_capture);
    }
    if (net_easy) {
        curl_getinfo(net_easy, CURLINFO_RESPONSE_CODE, &code);
        curl_easy_cleanup(net_easy);
        net_easy = 0;
    }
    if (net_hdr) { curl_slist_free_all(net_hdr); net_hdr = 0; }
    r = net_res;
    if (net_rc == NET_CANCELLED) r.err = NET_CANCELLED;
    else if (net_rc == NET_TIMEOUT) r.err = NET_TIMEOUT;
    else if (net_rc != 0) r.err = NET_NO_CURL;
    else {
        r.status = (int)code;
        if (r.status <= 0) r.err = EPROTO;
        else r.ok = 1;
    }
    net_on = net_running = net_rc = 0;
    net_easy = net_multi = net_hdr = net_outf = 0;
    net_capture[0] = 0;
    net_t0 = 0;
    mm_fill(&net_res, (long)sizeof net_res, 0, (long)sizeof net_res);
    return r;
}

/* In-process libcurl. The body goes to a host FILE*, not a pipe. */
static net_response net_https(const char *method, const char *url,
                              const char *content_type, const char *body) {
    net_response r;
    if (net_async_begin(method, url, content_type, body) != 0) {
        r = net_async_end();
        return r;
    }
    while (net_async_pump(200)) ;
    r = net_async_end();
    return r;
}

/* ── the request ────────────────────────────────────────────────────────── */

/*
 * Send one request and read the response.
 *
 * `body` may be NULL for a GET. Content-Length is always sent, including 0,
 * because a server that guesses the body length from the connection close is a
 * server that will wait for a body that is not coming.
 */
net_response net_http(const char *method, const char *url,
                      const char *content_type, const char *body) {
    net_response r;
    net_url u;
    unsigned long fd;
    int prc;
    char req[8192];
    size_t reqlen;
    size_t blen = body ? net_len(body) : 0;

    mm_fill(&r, (long)sizeof r, 0, (long)sizeof r);
    r.ok = 0;
    r.body_bytes = 0;

    prc = net_parse_url(url, &u);
    if (prc != 0) { r.err = prc; return r; }
    if (!net_eq(method, "GET") && !net_eq(method, "POST")) { r.err = NET_REFUSED_URL; return r; }
    if (u.https) { r = net_https(method, url, content_type, body); return r; }

    fd = net_connect(u.host, u.port);
    if (fd == NET_INVALID_SOCKET) { r.err = errno ? errno : ECONNREFUSED; return r; }

    reqlen = (size_t)snprintf(req, sizeof req,
        "%s %s HTTP/1.1\r\n"
        "Host: %s\r\n"
        "User-Agent: csih/0.1\r\n"
        "Accept: */*\r\n"
        "Connection: close\r\n"
        "Content-Length: %lu\r\n"
        "%s%s\r\n"
        "\r\n",
        method, u.path, u.host,
        (unsigned long)blen,
        blen ? "Content-Type: " : "",
        blen ? (content_type ? content_type : "application/octet-stream") : "");

    if (reqlen >= sizeof req) { net_socket_close(fd); r.err = NET_REFUSED_URL; return r; }

    /* the header from req, then the body from the caller's buffer: the body is
     * not copied into req, so a plaintext request is not capped at its size */
    {
        int part;
        for (part = 0; part < 2; part++) {
            const char *p = part ? body : req;
            size_t n = part ? blen : reqlen, off = 0;
            while (off < n) {
                long w = net_socket_send(fd, p + off, n - off);
                if (w < 0) { if (errno == EINTR) continue; r.err = errno; net_socket_close(fd); return r; }
                off += (size_t)w;
            }
        }
    }

    /* Read everything until the peer closes. "Connection: close" means the end
     * of the body IS the end of the stream, so no length arithmetic is needed
     * for the read loop — which is exactly why that header is sent. */
    {
        /* one response at a time: a static buffer, no allocation */
        static char all[NET_HDR_MAX + NET_BODY_MAX];
        size_t off = 0, cap = sizeof all;
        int truncated = 0;
        for (;;) {
            long n;
            if (off >= cap) { truncated = 1; break; }
            n = net_socket_recv(fd, all + off, cap - off);
            if (n < 0) { if (errno == EINTR) continue; break; }
            if (n == 0) break;
            off += (size_t)n;
        }
        net_socket_close(fd);
        all[off < cap ? off : cap - 1] = '\0';

        /* Split headers from body on the first blank line. A response with no
         * blank line is malformed and is reported as such rather than guessed
         * at — returning the whole thing as "body" would hide the problem. */
        {
            char *sep = net_str(all, "\r\n\r\n");
            size_t hlen;
            if (!sep) { r.err = EPROTO; return r; }
            hlen = (size_t)(sep - all) + 2;             /* keep the final CRLF */
            if (hlen >= sizeof r.header) hlen = sizeof r.header - 1;
            mm_copy(r.header, (long)sizeof r.header, all, (long)hlen);
            r.header[hlen] = '\0';

            {
                const char *bodyp = sep + 4;
                size_t bodylen = off > (size_t)(bodyp - all) ? off - (size_t)(bodyp - all) : 0;
                if (bodylen >= sizeof r.body) { bodylen = sizeof r.body - 1; truncated = 1; }
                mm_copy(r.body, (long)sizeof r.body, bodyp, (long)bodylen);
                r.body[bodylen] = '\0';
                r.body_bytes = truncated ? -1 : (long)bodylen;
            }
        }
    }

    /* Parse the status line: "HTTP/1.1 200 OK" */
    {
        const char *sp = net_chr(r.header, ' ');
        if (!sp) { r.err = EPROTO; return r; }
        r.status = atoi(sp + 1);
        if (r.status <= 0) { r.err = EPROTO; return r; }
    }

    /* Chunked responses are NOT decoded. Detect and say so, because a caller
     * handed raw chunk frames and told they are the body would send chunk
     * sizes to a model as if they were content. */
    {
        const char *cl = r.header;
        int i;
        for (i = 0; cl[i]; i++) {
            if ((cl[i] == 'T' || cl[i] == 't') &&
                !strncasecmp_local(cl + i, "transfer-encoding:", 18)) {
                const char *v = cl + i + 18;
                while (*v == ' ') v++;
                if (!strncasecmp_local(v, "chunked", 7)) r.chunked = 1;
            }
        }
    }
    r.ok = 1;
    return r;
}

/* net_cli.c owns the self-test. */
