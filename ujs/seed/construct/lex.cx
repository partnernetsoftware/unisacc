#!/usr/bin/env -S unisacc.com -run
/* method_construct scanner slice. Inlines lex_label. Not an IntNet.
   Not parse/type/scope/shape/isel/enc/reloc.
   ./unisacc.com -run ujs/seed/construct/lex.cx -- FILE.ujs [FILE.ujs...]
   One file: line <TAB> kind <TAB> text, then an eof line.
   Several files: a "# name" line before each file's tokens.
   text is source spelling. \\ \t \n \r and other bytes < 32 or 127 are escaped.
*/
enum { SRC_MAX = 65536, TEXT_MAX = 4096 };

static const char *PUNCT[] = {
    "...", "===", "!==", "=>", "??", "+=", "-=", "*=", "/=", "%=",
    "==", "!=", "<=", ">=", "&&", "||",
    "{", "}", "(", ")", "[", "]", ";", ",", ":", ".", "?",
    "=", "<", ">", "+", "-", "*", "/", "%", "!",
    0
};

static int is_ws(unsigned char c) {
    return c == ' ' || c == '\t' || c == '\r' || c == '\f' || c == '\v';
}

static int is_alpha(unsigned char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
}

static int is_digit(unsigned char c) {
    return c >= '0' && c <= '9';
}

/* 0 eof, 1 nl, 2 ws, 3 A, 4 D, 5 Q, 6 S, 7 P, 8 O, 9 other */
static int charclass(int past, unsigned char c) {
    if (past) return 0;
    if (c == '\n') return 1;
    if (is_ws(c)) return 2;
    if (is_alpha(c)) return 3;
    if (is_digit(c)) return 4;
    if (c == '"') return 5;
    if (c == '\'') return 6;
    if (c == '{' || c == '}' || c == '(' || c == ')' || c == '[' || c == ']' ||
        c == ';' || c == ',' || c == ':' || c == '.' || c == '?')
        return 7;
    if (c == '=' || c == '<' || c == '>' || c == '!' || c == '+' || c == '-' ||
        c == '*' || c == '/' || c == '%' || c == '&' || c == '|' || c == '.')
        return 8;
    return 9;
}

/* lex_label. Operator class is always op; peek does not change it. */
static const char *lex_label(int cc) {
    if (cc == 0) return "eof";
    if (cc == 2) return "ws";
    if (cc == 1) return "nl";
    if (cc == 3) return "id";
    if (cc == 4) return "num";
    if (cc == 5 || cc == 6) return "str";
    if (cc == 7) return "punct";
    if (cc == 8) return "op";
    return "bad";
}

static int kw_kind(const unsigned char *s, size_t n, const char **out) {
    static const struct { const char *s; const char *k; } T[] = {
        {"let", "let"}, {"const", "let"}, {"var", "let"},
        {"function", "function"}, {"if", "if"}, {"else", "else"},
        {"while", "while"}, {"for", "for"}, {"return", "return"},
        {"break", "break"}, {"continue", "continue"},
        {"switch", "switch"}, {"case", "case"}, {"default", "default"},
        {"null", "null"}, {"true", "true"}, {"false", "false"},
        {"typeof", "typeof"}, {"of", "of"}, {"in", "in"},
    };
    size_t i;
    for (i = 0; i < sizeof T / sizeof T[0]; i++) {
        size_t m = strlen(T[i].s);
        if (m == n && memcmp(s, T[i].s, n) == 0) {
            *out = T[i].k;
            return 1;
        }
    }
    return 0;
}

static int emit(int line, const char *kind, const unsigned char *text, size_t n) {
    size_t i;
    if (printf("%d\t%s\t", line, kind) < 0) return -1;
    for (i = 0; i < n; i++) {
        unsigned char c = text[i];
        if (c == '\\') {
            if (fputs("\\\\", stdout) < 0) return -1;
        } else if (c == '\t') {
            if (fputs("\\t", stdout) < 0) return -1;
        } else if (c == '\n') {
            if (fputs("\\n", stdout) < 0) return -1;
        } else if (c == '\r') {
            if (fputs("\\r", stdout) < 0) return -1;
        } else if (c < 32 || c == 127) {
            if (printf("\\x%02x", c) < 0) return -1;
        } else {
            if (fputc(c, stdout) == EOF) return -1;
        }
    }
    if (fputc('\n', stdout) == EOF) return -1;
    return 0;
}

static int starts(const unsigned char *s, size_t n, size_t i, const char *p) {
    size_t m = strlen(p);
    if (m > n - i) return 0;
    return memcmp(s + i, p, m) == 0;
}

static int lex_scan(const unsigned char *s, size_t n) {
    size_t i = 0;
    int line = 1;
    while (1) {
        int past = i >= n;
        unsigned char c = past ? 0 : s[i];
        int past1, cc, cc1;
        unsigned char n1;
        const char *act;
        past1 = (i + 1 >= n);
        n1 = past1 ? 0 : s[i + 1];
        cc = charclass(past, c);
        cc1 = charclass(past1, n1);
        (void)cc1;
        act = lex_label(cc);
        if (!strcmp(act, "eof")) return emit(line, "eof", (const unsigned char *)"", 0);
        if (!strcmp(act, "ws")) {
            while (i < n && charclass(0, s[i]) == 2) i++;
            continue;
        }
        if (!strcmp(act, "nl")) {
            i++;
            line++;
            continue;
        }
        if (!strcmp(act, "id")) {
            size_t j = i;
            const char *kind = 0;
            while (i < n && (charclass(0, s[i]) == 3 || charclass(0, s[i]) == 4)) i++;
            if (i - j > TEXT_MAX) {
                fprintf(stderr, "lex.cx: token too long\n");
                return 1;
            }
            if (!kw_kind(s + j, i - j, &kind)) kind = "id";
            if (emit(line, kind, s + j, i - j) != 0) return 1;
            continue;
        }
        if (!strcmp(act, "num")) {
            size_t j = i;
            while (i < n && is_digit(s[i])) i++;
            if (i < n && s[i] == '.' && i + 1 < n && is_digit(s[i + 1])) {
                i++;
                while (i < n && is_digit(s[i])) i++;
            }
            if (i - j > TEXT_MAX) {
                fprintf(stderr, "lex.cx: token too long\n");
                return 1;
            }
            if (emit(line, "num", s + j, i - j) != 0) return 1;
            continue;
        }
        if (!strcmp(act, "str")) {
            unsigned char quote = c;
            unsigned char buf[TEXT_MAX];
            size_t bn = 0;
            i++;
            while (i < n && s[i] != quote) {
                unsigned char ch;
                if (s[i] == '\\' && i + 1 < n) {
                    unsigned char e = s[i + 1];
                    if (e == 'n') ch = '\n';
                    else if (e == 't') ch = '\t';
                    else if (e == 'r') ch = '\r';
                    else if (e == '\\' || e == '"' || e == '\'') ch = e;
                    else ch = e;
                    i += 2;
                } else {
                    if (s[i] == '\n') line++;
                    ch = s[i];
                    i++;
                }
                if (bn >= TEXT_MAX) {
                    fprintf(stderr, "lex.cx: token too long\n");
                    return 1;
                }
                buf[bn++] = ch;
            }
            if (i >= n || s[i] != quote) {
                fprintf(stderr, "lex.cx: unterminated string at line %d\n", line);
                return 1;
            }
            i++;
            if (emit(line, "str", buf, bn) != 0) return 1;
            continue;
        }
        if (!strcmp(act, "punct") || !strcmp(act, "op")) {
            const char *matched = 0;
            const char *kind;
            size_t mlen, k;
            if (i < n && s[i] == '/' && i + 1 < n && s[i + 1] == '/') {
                while (i < n && s[i] != '\n') i++;
                continue;
            }
            for (k = 0; PUNCT[k]; k++) {
                if (starts(s, n, i, PUNCT[k])) {
                    matched = PUNCT[k];
                    break;
                }
            }
            if (!matched) {
                fprintf(stderr, "lex.cx: bad punct at %u\n", (unsigned)i);
                return 1;
            }
            mlen = strlen(matched);
            if (!strcmp(matched, "===")) kind = "==";
            else if (!strcmp(matched, "!==")) kind = "!=";
            else kind = matched;
            if (emit(line, kind, s + i, mlen) != 0) return 1;
            i += mlen;
            continue;
        }
        fprintf(stderr, "lex.cx: lex bad at %u\n", (unsigned)i);
        return 1;
    }
}

static int read_all(const char *path, unsigned char **out, size_t *out_n) {
    FILE *f;
    long sz;
    unsigned char *buf;
    size_t n;
    f = fopen(path, "rb");
    if (!f) {
        fprintf(stderr, "lex.cx: cannot read %s\n", path);
        return 1;
    }
    if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return 1; }
    sz = ftell(f);
    if (sz < 0 || sz > SRC_MAX) {
        fprintf(stderr, "lex.cx: source too long\n");
        fclose(f);
        return 1;
    }
    if (fseek(f, 0, SEEK_SET) != 0) { fclose(f); return 1; }
    buf = (unsigned char *)malloc((size_t)sz + 1);
    if (!buf) { fclose(f); return 1; }
    n = fread(buf, 1, (size_t)sz, f);
    fclose(f);
    if (n != (size_t)sz) { free(buf); return 1; }
    buf[n] = 0;
    *out = buf;
    *out_n = n;
    return 0;
}

static const char *base_name(const char *path) {
    const char *s = path;
    const char *sl = path;
    while (*s) {
        if (*s == '/') sl = s + 1;
        s++;
    }
    return sl;
}

int main(int argc, char **argv) {
    int i;
    if (argc < 2) {
        fprintf(stderr, "usage: lex.cx FILE.ujs [FILE.ujs...]\n");
        return 2;
    }
    for (i = 1; i < argc; i++) {
        unsigned char *src = 0;
        size_t n = 0;
        int rc;
        if (argc > 2) {
            if (printf("# %s\n", base_name(argv[i])) < 0) return 1;
        }
        if (read_all(argv[i], &src, &n) != 0) return 1;
        rc = lex_scan(src, n);
        free(src);
        if (rc != 0) return rc;
    }
    return 0;
}
